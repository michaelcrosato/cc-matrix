{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '1090,1338p' PLAN.md\"","aggregated_output":"## Appendix A: tissue painter\n\nRan on this computer at 480x270, 3 to 5 ms a frame under software rendering. It also runs headless. One instance per site. Each frame: stamp pools, wounds and so on from `S`, then `shade(fx)`, then draw `F.cv`.\n\n- `stampDisc(x, y, r, height, mat)`, `stampLine(points, r, height, mat)`: per-frame height and material. Height alone (no `mat`) makes a ridge, for Legato.\n- `shade({ beat, breath, slow, lens, light, dim, spot })`: see its comment. `dyn` and `over` clear after each shade.\n- `slow: true` is Long Breath's palette. `lens` is Sonar's. `dim` and `spot` are the blackout. A moving `light` is the swaying lamp.\n\n```js\n// Bake once per site, stamp from the sim's state each frame, then shade(). Cosmetic only: the sim never reads it. Needs E = My3D2dge in scope.\nconst BAYER = [0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5].map(v => (v + .5) / 16 - .5);\nconst hex3 = h => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];\nfunction makeRamp(keys, n, slow) { // dark to light through hand-picked, hue-shifted keys. slow: the same ramp seen through Long Breath\n  const c = keys.map(hex3), out = new Uint32Array(n);\n  for (let i = 0; i < n; i++) { const t = i / (n - 1) * (c.length - 1), j = Math.min(c.length - 2, t | 0), f = t - j; let r = c[j][0] + (c[j + 1][0] - c[j][0]) * f, g = c[j][1] + (c[j + 1][1] - c[j][1]) * f, b = c[j][2] + (c[j + 1][2] - c[j][2]) * f;\n    if (slow) { const y = r * .3 + g * .59 + b * .11; r = y * .55 + 8; g = y * .95 + 14; b = y * 1.05 + 22; } out[i] = 0xff000000 | (Math.min(255, b) << 16) | (Math.min(255, g) << 8) | Math.min(255, r); }\n  return out;\n}\nconst MAT_KEYS = { // name: [ramp keys, specular strength]\n  wall: [['#1c060c', '#4a0f18', '#7d1f26', '#a93a38'], .35], bowel: [['#3a0e1c', '#8a2f3e', '#c75f62', '#eb9486', '#ffc9b0'], 1], liver: [['#1e0610', '#4e1022', '#7c1e30', '#a83a42', '#d0645c'], .55],\n  fat: [['#5a3a10', '#a8782a', '#dcb34c', '#f4d97e', '#fff2b8'], .7], vessel: [['#14103a', '#2c2a70', '#4a4aa0', '#7c78c8'], .8], artery: [['#3a0408', '#8c0f14', '#cf2a22', '#f4604a'], 1],\n  skin: [['#6a3a22', '#a8683f', '#d39a68', '#eebf92'], .12], drape: [['#0c2c2a', '#14504a', '#1f7468', '#2f9a88'], 0], steel: [['#28303a', '#5a6a78', '#9aaab8', '#e8f0f8'], 1.6],\n  blood: [['#180204', '#3c060a', '#680c10', '#8e1414'], 1.4], wound: [['#0c0104', '#2a0408', '#55090e', '#7a1216'], .5], char: [['#08070a', '#1c181a', '#332a28', '#4a3c34'], 0], gel: [['#0c4a38', '#1c8a64', '#54d0a0', '#b0ffe0'], 1.4] };\nconst MAT_IDS = Object.keys(MAT_KEYS), MATS = MAT_IDS.map(k => ({ ramp: makeRamp(MAT_KEYS[k][0], 20), slow: makeRamp(MAT_KEYS[k][0], 20, true), spec: MAT_KEYS[k][1] }));\nconst matId = n => MAT_IDS.indexOf(n);\nfunction makeNoise(seed) { let a = seed >>> 0; const R = () => { a = (a + 0x6d2b79f5) >>> 0; let t = Math.imul(a ^ (a >>> 15), a | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n  const L = new Float32Array(65536); for (let i = 0; i < L.length; i++) L[i] = R();\n  const v = (x, y) => { const xi = Math.floor(x), yi = Math.floor(y), fx = x - xi, fy = y - yi, u = fx * fx * (3 - 2 * fx), w = fy * fy * (3 - 2 * fy), s = (p, q) => L[(p & 255) | ((q & 255) << 8)]; return (s(xi, yi) * (1 - u) + s(xi + 1, yi) * u) * (1 - w) + (s(xi, yi + 1) * (1 - u) + s(xi + 1, yi + 1) * u) * w; };\n  return { R, fbm: (x, y, o = 4) => { let k = .5, f = 1, n = 0; for (let i = 0; i < o; i++) { n += k * v(x * f, y * f); k *= .5; f *= 2.03; } return n; } }; }\nclass TissueField {\n  constructor(W, H, seed = 7) { this.W = W; this.H = H; const N = W * H; this.h = new Float32Array(N); this.m = new Uint8Array(N); this.pulse = new Float32Array(N); this.ao = new Float32Array(N).fill(1); this.dyn = new Float32Array(N); this.over = new Uint8Array(N); this.noise = makeNoise(seed);\n    this.cv = E.mkCanvas(W, H); this.g = this.cv.getContext('2d'); this.img = this.g.createImageData(W, H); this.u = new Uint32Array(this.img.data.buffer); }\n  blob(x, y, rx, ry, rot, hgt, mat, o = {}) { const { W, H, h, m, pulse, noise } = this, c = Math.cos(rot), s = Math.sin(rot), R = Math.max(rx, ry) + (o.warp || 0) + 2, id = matId(mat), warp = o.warp || 0, base = o.base || 0, add = !!o.add;\n    for (let py = Math.max(0, y - R | 0); py < Math.min(H, y + R + 1); py++) for (let px = Math.max(0, x - R | 0); px < Math.min(W, x + R + 1); px++) {\n      const wx = warp ? (noise.fbm(px * .03, py * .03, 2) - .5) * warp : 0, wy = warp ? (noise.fbm(px * .03 + 40, py * .03, 2) - .5) * warp : 0, dx = px - x + wx, dy = py - y + wy, u = (dx * c + dy * s) / rx, v = (-dx * s + dy * c) / ry, d = u * u + v * v; if (d >= 1) continue;\n      const i = py * W + px, top = base + hgt * Math.sqrt(1 - d); if (add) { h[i] += hgt * (1 - d); m[i] = id; if (o.pulse) pulse[i] = Math.max(pulse[i], o.pulse * (1 - d)); } else if (top > h[i]) { h[i] = top; m[i] = id; if (o.pulse) pulse[i] = o.pulse * (1 - d); } } }\n  tube(pts, r, hgt, mat, o = {}) { const step = Math.max(1, r * .35); for (let k = 0; k < pts.length - 1; k++) { const [x0, y0] = pts[k], [x1, y1] = pts[k + 1], n = Math.max(1, Math.hypot(x1 - x0, y1 - y0) / step | 0); for (let i = 0; i <= n; i++) this.blob(x0 + (x1 - x0) * i / n, y0 + (y1 - y0) * i / n, r, r, 0, hgt, mat, o); } }\n  finish(detail = 1.1) { const { W, H, h, ao, noise } = this, N = W * H, blur = new Float32Array(N), tmp = new Float32Array(N), R = 7;\n    for (let i = 0, y = 0; y < H; y++) for (let x = 0; x < W; x++, i++) h[i] += (noise.fbm(x * .11, y * .11, 3) - .5) * detail;\n    for (let y = 0; y < H; y++) { let s = 0; for (let x = -R; x <= R; x++) s += h[y * W + Math.max(0, x)]; for (let x = 0; x < W; x++) { tmp[y * W + x] = s / (2 * R + 1); s += h[y * W + Math.min(W - 1, x + R + 1)] - h[y * W + Math.max(0, x - R)]; } }\n    for (let x = 0; x < W; x++) { let s = 0; for (let y = -R; y <= R; y++) s += tmp[Math.max(0, y) * W + x]; for (let y = 0; y < H; y++) { blur[y * W + x] = s / (2 * R + 1); s += tmp[Math.min(H - 1, y + R + 1) * W + x] - tmp[Math.max(0, y - R) * W + x]; } }\n    for (let i = 0; i < N; i++) ao[i] = Math.max(.42, Math.min(1.08, 1 - (blur[i] - h[i]) * .055)); }\n  // what the sim's objects stamp each frame, before shade(): dynamic height, and an override material\n  stampDisc(x, y, r, hgt, mat) { const { W, H, dyn, over } = this, id = mat ? matId(mat) + 1 : 0; for (let py = Math.max(1, y - r | 0); py < Math.min(H - 1, y + r + 1); py++) for (let px = Math.max(1, x - r | 0); px < Math.min(W - 1, x + r + 1); px++) { const d = ((px - x) ** 2 + (py - y) ** 2) / (r * r); if (d < 1) { const i = py * W + px; dyn[i] = hgt < 0 ? Math.min(dyn[i], hgt * (1 - d)) : Math.max(dyn[i], hgt * (1 - d)); if (id) over[i] = id; } } }\n  stampLine(pts, r, hgt, mat) { for (let k = 0; k < pts.length - 1; k++) { const [x0, y0] = pts[k], [x1, y1] = pts[k + 1], n = Math.max(1, Math.hypot(x1 - x0, y1 - y0) / Math.max(1, r * .5) | 0); for (let i = 0; i <= n; i++) this.stampDisc(x0 + (x1 - x0) * i / n, y0 + (y1 - y0) * i / n, r, hgt, mat); } }\n  // fx: { beat 0..1, breath px, slow: Long Breath palette, lens: {x, y, r} shows the cold palette inside (Sonar), light: [lx, ly], dim: 0..1 darkness, spot: {x, y, r} stays lit while dim }\n  shade(fx = {}) { const { W, H, h, m, ao, pulse, dyn, over, u } = this, beat = fx.beat || 0, off = Math.round(fx.breath || 0) * W, slow = !!fx.slow, lens = fx.lens, lr2 = lens ? lens.r * lens.r : 0, dim = fx.dim || 0, spot = fx.spot, sr2 = spot ? spot.r * spot.r : 0, lx = fx.light ? fx.light[0] : -.42, ly = fx.light ? fx.light[1] : -.52, lz = Math.sqrt(Math.max(.1, 1 - lx * lx - ly * ly)), hl = Math.hypot(lx, ly, lz + 1), hx = lx / hl, hy = ly / hl, hz = (lz + 1) / hl;\n    for (let y = 1; y < H - 1; y++) for (let x = 1, i = y * W + 1; x < W - 1; x++, i++) {\n      const j = Math.max(W + 1, Math.min(W * H - W - 2, i + off)), k = 1 + beat * pulse[j], dx = (h[j - 1] - h[j + 1]) * k * .5 + (dyn[i - 1] - dyn[i + 1]) * .5, dy = (h[j - W] - h[j + W]) * k * .5 + (dyn[i - W] - dyn[i + W]) * .5, nl = 1 / Math.sqrt(dx * dx + dy * dy + 1), nx = dx * nl, ny = dy * nl, nz = nl;\n      const diff = Math.max(0, nx * lx + ny * ly + nz * lz), sh = Math.max(0, nx * hx + ny * hy + nz * hz), ov = over[i], M = MATS[ov ? ov - 1 : m[j]], cold = slow || (lens && (x - lens.x) ** 2 + (y - lens.y) ** 2 < lr2), r = cold ? M.slow : M.ramp, n = r.length, s2 = sh * sh, s4 = s2 * s2, s8 = s4 * s4, s16 = s8 * s8, s32 = s16 * s16;\n      const lit = dim && !(spot && (x - spot.x) ** 2 + (y - spot.y) ** 2 < sr2) ? 1 - dim : 1, lum = (diff * .92 + s8 * .16 * M.spec + beat * pulse[j] * .6) * (ov ? 1 : ao[j]) * lit, c = Math.max(0, Math.min(n - 1, (lum * (n - 1) + BAYER[(x & 3) | ((y & 3) << 2)] * 1.15 + .5) | 0));\n      u[i] = s32 * s8 * M.spec * lit > .42 ? (cold ? 0xffffffe0 : 0xfff4f0ff) : r[c]; }\n    this.g.putImageData(this.img, 0, 0); dyn.fill(0); over.fill(0); }\n}\n```\n\n## Appendix B: a site recipe\n\n`F.stampDisc` coordinates here use screen pixels. To place sim objects, add `OX, OY`.\n\n```js\n// A site recipe: the abdomen. Design space is 426 x 240 about the screen's centre; a bigger screen only shows more drape.\nfunction bakeAbdomen(W, H, seed = 11) { const F = new TissueField(W, H, seed), cx = W / 2, cy = H / 2 - 4, n = F.noise, rx = 171, ry = 91;\n  for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) { const i = y * W + x, d = ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2, fold = Math.sin(x * .09 + 1.6 * Math.sin(y * .05)) * 1.6 + Math.sin(y * .17 + x * .03) * .8;\n    if (d < 1) { F.h[i] = -16 + 12 * d * d + Math.sin(x * .05 + y * .03) * 1.4; F.m[i] = matId('wall'); }            // the cavity\n    else if (d < 1.28) { const e = (d - 1) / .28; F.h[i] = 4 + 7 * Math.sin(e * Math.PI); F.m[i] = matId('skin'); }  // lips of skin\n    else { F.h[i] = 6 + fold; F.m[i] = matId('drape'); } }                                                            // drapes to any screen's edge\n  F.blob(cx - rx * .55, cy - ry * .5, rx * .55, ry * .55, -.3, 17, 'liver', { base: -11, warp: 12 });\n  for (let i = 0; i < 9; i++) { const a = n.R() * 6.28, r = .55 + n.R() * .32; F.blob(cx + Math.cos(a) * rx * r, cy + Math.sin(a) * ry * r, 9 + n.R() * 14, 7 + n.R() * 9, n.R() * 3, 8, 'fat', { base: -10, warp: 8 }); }\n  const coil = (x0, y0, len, dir, r) => { const pts = [[x0, y0]]; let a = dir, x = x0, y = y0; for (let i = 0; i < len; i++) { a += (n.R() - .5) * 1.5 + Math.sin(i * .9) * .5; x += Math.cos(a) * r * 1.3; y += Math.sin(a) * r * 1.3; if (((x - cx) / (rx * .92)) ** 2 + ((y - cy) / (ry * .92)) ** 2 > 1) { a += 2.4; x += Math.cos(a) * r; y += Math.sin(a) * r; } pts.push([x, y]); } return pts; };\n  F.tube(coil(cx + rx * .05, cy - ry * .25, 34, .2, 9), 11, 14, 'bowel', { base: -8 }); F.tube(coil(cx + rx * .45, cy + ry * .25, 26, 2.6, 9), 10, 15, 'bowel', { base: -7 }); F.tube(coil(cx - rx * .35, cy + ry * .45, 22, -.3, 9), 10, 15, 'bowel', { base: -6 });\n  const veins = (x, y, a, len, r, mat) => { const pts = [[x, y]]; for (let i = 0; i < len; i++) { a += (n.R() - .5) * .8; x += Math.cos(a) * 7; y += Math.sin(a) * 7; if (((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2 > .96) break; pts.push([x, y]); if (r > 1.2 && n.R() < .22) veins(x, y, a + (n.R() < .5 ? .9 : -.9), len * .5 | 0, r * .7, mat); } F.tube(pts, r, 1.6, mat, { add: true, pulse: mat === 'artery' ? .35 : 0 }); };\n  veins(cx - rx * .7, cy - ry * .05, -.2, 16, 2.2, 'vessel'); veins(cx + rx * .7, cy - ry * .6, 2.4, 14, 2, 'artery'); veins(cx + rx * .1, cy + ry * .75, -1.5, 12, 1.8, 'vessel');\n  for (const a of [-.45, .5, 2.7, 3.6]) { const ex = cx + Math.cos(a) * rx * 1.02, ey = cy + Math.sin(a) * ry * 1.02, ox = cx + Math.cos(a) * rx * 1.5, oy = cy + Math.sin(a) * ry * 1.5; F.tube([[ex, ey], [ox, oy]], 4, 5, 'steel', { base: 10 }); F.tube([[ex - Math.sin(a) * 9, ey + Math.cos(a) * 9], [ex + Math.sin(a) * 9, ey - Math.cos(a) * 9]], 3, 5, 'steel', { base: 10 }); } // retractors\n  F.finish(1.1); return F; }\n```\n\n## Appendix C: portrait painter\n\nBusts for the four leads. The other four follow the same shape: `frontHair`, `backHair` (polygons in face space, x from the center, y down), `glasses`, `moustache`, `scar`, `cap`, `mask` (`maskUp: true` covers the mouth, for theatre), `lines`, `blush`, `jaw`, `wide`. Cache each expression to a canvas with `E.mkCanvas(112, 128)`; call `E.px.reset` on the target after drawing on it with the canvas API.\n\n```js\n// A bust from data in hard-edged tones, 112 x 128 buffer pixels. Cache each expression in a canvas; the sim never reads it. Needs E = My3D2dge in scope.\n// o: { expr: neutral | smile | angry | sad | shock | shout, blink: 0..1, talk: 0..1, look: -1..1 }\nfunction drawBust(g, c, o = {}) { const px = E.px, P = (pts, col) => px.poly(g, pts, col), T = E.tones;\n  const skin = T(c.skin), hair = T(c.hair), cloth = T(c.cloth), expr = o.expr || 'neutral', blink = o.blink || 0, talk = o.talk || 0, cx = 56, top = 20;\n  const jaw = c.jaw || 1, wide = c.wide || 1, f = (x, y) => [cx + x * wide, top + y]; // face space: x from centre, y down\n  // back hair\n  if (c.backHair) for (const s of c.backHair) P(s.map(([x, y]) => f(x, y)), hair.sh);\n  // shoulders and collar\n  P([[6, 128], [10, 104], [30, 92], [46, 88], [66, 88], [82, 92], [102, 104], [106, 128]], cloth.base);\n  P([[6, 128], [10, 104], [30, 92], [34, 128]], cloth.sh); P([[78, 128], [82, 92], [102, 104], [106, 128]], cloth.lt);\n  // neck\n  P([[46, 66], [66, 66], [68, 92], [56, 104], [44, 92]], skin.sh);\n  // V-neck and inner shirt\n  P([[42, 88], [56, 110], [70, 88], [66, 86], [56, 100], [46, 86]], cloth.deep); P([[46, 86], [56, 100], [66, 86], [64, 92], [56, 104], [48, 92]], c.undershirt || skin.sh);\n  if (c.coat) { P([[6, 128], [10, 104], [30, 92], [42, 88], [52, 128]], c.coat); P([[106, 128], [102, 104], [82, 92], [70, 88], [60, 128]], c.coat); P([[42, 88], [52, 128], [47, 128], [36, 92]], E.tones(c.coat).sh); P([[70, 88], [60, 128], [65, 128], [76, 92]], E.tones(c.coat).sh); }\n  // ears\n  P([f(-27, 30), f(-31, 34), f(-30, 42), f(-26, 45)], skin.sh); P([f(27, 30), f(31, 34), f(30, 42), f(26, 45)], skin.base);\n  // head: wide cranium, cheek, chin\n  const J = jaw; P([f(-26, 12), f(-27, 34), f(-22, 48 * J), f(-11, 60 * J), f(0, 64 * J), f(11, 60 * J), f(22, 48 * J), f(27, 34), f(26, 12), f(14, 2), f(-14, 2)], skin.base);\n  P([f(-27, 30), f(-22, 48 * J), f(-11, 60 * J), f(0, 64 * J), f(-6, 54 * J), f(-16, 44), f(-22, 30)], skin.sh); // cheek shadow, viewer's left\n  if (c.blush) { px.ell(g, ...f(-15, 41), 4, 2, c.blush); px.ell(g, ...f(16, 41), 4, 2, c.blush); }\n  if (c.lines) { px.line(g, ...f(-11, 45), ...f(-6, 50), skin.sh, 1); px.line(g, ...f(11, 45), ...f(6, 50), skin.sh, 1); px.line(g, ...f(-23, 26), ...f(-20, 28), skin.sh, 1); px.line(g, ...f(23, 26), ...f(20, 28), skin.sh, 1); }\n  // eyes\n  const eye = (sx) => { const x = sx * 13, y = 30 + (expr === 'shock' ? -1 : 0), w = 7, hh = expr === 'shock' ? 8 : expr === 'angry' ? 5 : 7;\n    if (blink > .5 || expr === 'sad-closed') { px.line(g, ...f(x - w, y + 1), ...f(x + w, y + 1), c.lash || '#1a1016', 2); return; }\n    P([f(x - w, y), f(x - w + 3, y - hh + 2), f(x + w - 3, y - hh + 2), f(x + w, y), f(x + w - 2, y + 4), f(x - w + 2, y + 4)], '#f8f4ee');\n    const ix = x + (o.look || 0) * 2 + (expr === 'shock' ? 0 : 0); px.ell(g, ...f(ix, y - 1), 4, expr === 'shock' ? 4 : 5, c.iris || '#3a5a7a'); px.ell(g, ...f(ix, y), 2, 3, c.pupil || '#120c14'); px.rect(g, ...f(ix - 3, y - 4), 3, 2, '#ffffff'); px.dot(g, ...f(ix + 2, y + 2), '#ffffff');\n    px.line(g, ...f(x - w - 1, y + (sx < 0 ? 1 : -1)), ...f(x - w + 4, y - hh + 2), c.lash || '#1a1016', 2); px.line(g, ...f(x - w + 4, y - hh + 2), ...f(x + w - 4, y - hh + 2), c.lash || '#1a1016', 2); px.line(g, ...f(x + w - 4, y - hh + 2), ...f(x + w + 1, y + (sx < 0 ? -1 : 1)), c.lash || '#1a1016', 2); };\n  eye(-1); eye(1);\n  // brows\n  const by = 17 + (c.browDrop || 0), br = expr === 'angry' ? 3 : expr === 'sad' ? -3 : expr === 'shock' ? -1 : 0, bc = c.brow || hair.deep, bw = c.browW || 2; px.line(g, ...f(-20, by + (expr === 'shock' ? -3 : 0) - br), ...f(-7, by + (expr === 'shock' ? -3 : 0) + br), bc, bw); px.line(g, ...f(7, by + (expr === 'shock' ? -3 : 0) + br), ...f(20, by + (expr === 'shock' ? -3 : 0) - br), bc, bw);\n  // nose\n  px.line(g, ...f(1, 40), ...f(-1, 45), skin.sh, 1); px.dot(g, ...f(0, 46), skin.deep);\n  // mouth\n  const my = 53, mo = talk > .5 || expr === 'shout' || expr === 'shock'; if (mo) { const a = expr === 'shout' || expr === 'shock' ? 7 : 4, w = expr === 'shout' ? 7 : 5; P([f(-w, my - 1), f(w, my - 1), f(w - 2, my + a), f(-w + 2, my + a)], '#5a1a24'); P([f(-w + 2, my + a - 2), f(w - 2, my + a - 2), f(w - 3, my + a), f(-w + 3, my + a)], '#c8505a'); if (a > 4) px.rect(g, ...f(-w + 1, my - 1), (w - 1) * 2, 2, '#f4f0e8'); }\n  else if (expr === 'smile') { px.line(g, ...f(-7, my - 1), ...f(-3, my + 2), skin.deep, 1); px.line(g, ...f(-3, my + 2), ...f(3, my + 2), skin.deep, 1); px.line(g, ...f(3, my + 2), ...f(7, my - 1), skin.deep, 1); }\n  else if (expr === 'sad' || expr === 'angry') { px.line(g, ...f(-5, my + 2), ...f(0, my), skin.deep, 1); px.line(g, ...f(0, my), ...f(5, my + 2), skin.deep, 1); }\n  else px.line(g, ...f(-4, my), ...f(4, my), skin.deep, 1);\n  if (c.moustache) { P([f(-13, 50), f(-6, 46), f(0, 48), f(6, 46), f(13, 50), f(8, 52), f(0, 50), f(-8, 52)], c.moustache); px.line(g, ...f(-6, 47), ...f(6, 47), E.tones(c.moustache).lt, 1); }\n  // front hair\n  if (c.frontHair) for (const [s, tone] of c.frontHair) P(s.map(([x, y]) => f(x, y)), hair[tone || 'base']);\n  if (c.hairGlint) for (const s of c.hairGlint) P(s.map(([x, y]) => f(x, y)), hair.hi);\n  // cap\n  if (c.cap) { const k = T(c.cap); P([f(-29, 16), f(-27, 2), f(-14, -9), f(14, -9), f(27, 2), f(29, 16), f(16, 11), f(-16, 11)], k.base); P([f(-29, 16), f(-27, 2), f(-14, -9), f(-6, -9), f(-14, 11), f(-16, 11)], k.sh); P([f(6, -8), f(14, -9), f(22, -3), f(14, -3)], k.lt); P([f(-29, 16), f(-16, 11), f(16, 11), f(29, 16), f(27, 18), f(16, 14), f(-16, 14), f(-27, 18)], k.deep); }\n  // lowered mask, glasses\n  if (c.mask && !o.maskUp) { const k = T(c.mask); P([f(-20, 62), f(20, 62), f(25, 76), f(0, 84), f(-25, 76)], k.base); P([f(-20, 62), f(-25, 76), f(0, 84), f(-6, 74)], k.sh); px.line(g, ...f(-20, 62), ...f(-28, 50), k.lt, 1); px.line(g, ...f(20, 62), ...f(28, 50), k.lt, 1); }\n  if (c.glasses) { const m = c.glasses; for (const sx of [-1, 1]) { const x = sx * 13; px.line(g, ...f(x - 9, 25), ...f(x + 9, 25), m, 1); px.line(g, ...f(x - 9, 25), ...f(x - 8, 33), m, 1); px.line(g, ...f(x + 9, 25), ...f(x + 8, 33), m, 1); px.line(g, ...f(x - 8, 34), ...f(x + 8, 34), m, 1); } px.line(g, ...f(-4, 27), ...f(4, 27), m, 1); }\n  if (o.maskUp && c.mask) { const k = T(c.mask); P([f(-27, 36), f(-8, 34), f(0, 36), f(8, 34), f(27, 36), f(25, 54), f(11, 66), f(0, 68), f(-11, 66), f(-25, 54)], k.base); P([f(-27, 36), f(-8, 34), f(-3, 50), f(-11, 66), f(-25, 54)], k.sh); for (const yy of [44, 52]) px.line(g, ...f(-18, yy), ...f(18, yy), k.lt, 1); px.line(g, ...f(-27, 38), ...f(-31, 32), k.lt, 1); px.line(g, ...f(27, 38), ...f(31, 32), k.lt, 1); }\n  if (c.scar) px.line(g, ...f(c.scar[0], c.scar[1]), ...f(c.scar[2], c.scar[3]), skin.deep, 1);\n  if (c.tag) { px.rect(g, 72, 108, 16, 10, '#f0ece2'); px.rect(g, 74, 110, 12, 2, c.tag); px.rect(g, 74, 114, 8, 1, '#7a7468'); }\n}\nconst CAST = {\n  vale: { name: 'DR. VALE', skin: '#f6d0b2', hair: '#c9562a', iris: '#3f8a58', cloth: '#2f9c8e', cap: '#2bb0a2', mask: '#bfe6dc', undershirt: '#e9fff6', blush: '#f0a48c', wide: .95,\n    backHair: [[[-27, 14], [-30, 40], [-24, 52], [-16, 40], [-16, 14]], [[27, 14], [30, 40], [24, 52], [16, 40], [16, 14]]],\n    frontHair: [[[[-27, 12], [-24, 24], [-16, 16], [-10, 22], [-3, 14], [3, 21], [10, 14], [18, 22], [27, 12], [14, 8], [-14, 8]], 'base'], [[[-27, 12], [-24, 24], [-16, 16], [-14, 10]], 'sh']],\n    tag: '#c8452f' },\n  quill: { name: 'NURSE QUILL', skin: '#dcae8e', hair: '#8d8a88', iris: '#4a4a55', cloth: '#3d62a6', cap: '#35558f', undershirt: '#dfe6f2', moustache: '#a7a3a0', lines: true, wide: 1.08, jaw: 1.04, browW: 3, brow: '#7c7875', browDrop: 2, mask: '#a9cfe0', frontHair: [] },\n  oyelaran: { name: 'CHIEF OYELARAN', skin: '#7c4a2e', hair: '#c9c5bb', iris: '#2a1a12', cloth: '#2e2c36', coat: '#ece7da', undershirt: '#3a3644', lines: true, jaw: .98, glasses: '#d8c070',\n    backHair: [], frontHair: [[[[-27, 18], [-27, 2], [-14, -8], [14, -8], [27, 2], [27, 18], [20, 10], [8, 6], [-8, 6], [-20, 10]], 'base'], [[[-27, 18], [-27, 2], [-14, -8], [-8, 6], [-20, 10]], 'sh'], [[[6, -7], [16, -6], [22, 0], [12, 0]], 'lt']] },\n  sokolova: { name: 'DR. SOKOLOVA', skin: '#e8c6aa', hair: '#dedad2', iris: '#6a8aa8', cloth: '#6b7a48', undershirt: '#f0ece0', lines: true, wide: 1.02, jaw: 1.02, scar: [10, 14, 17, 40], browW: 3, brow: '#b8b4ac',\n    backHair: [[[-28, 6], [-34, 34], [-30, 58], [-20, 50], [-20, 10]], [[28, 6], [36, 26], [46, 52], [38, 64], [28, 44], [22, 10]]], frontHair: [[[[-27, 16], [-26, 2], [-12, -8], [14, -8], [27, 2], [27, 16], [16, 6], [-2, 12], [-16, 8]], 'base'], [[[-27, 16], [-26, 2], [-12, -8], [-6, 8], [-16, 8]], 'sh']] },\n};\n```\n\n## Appendix D: Hub skeleton, page head and harness runner\n\n**Page head.** Order matters.\n\n```html\n<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>/* vendor/hub/session.js, pasted unmodified */</script>\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"shared-world\"><meta name=\"hub:session-minutes\" content=\"5\">\n<meta name=\"hub:session-goal\" content=\"Save the patient together; best hands top the board\">\n<meta name=\"hub:session-howto\" content=\"Aim: right stick or mouse. Use tool: R2 or click. Tools: left stick or 1-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\"><title>…</title>\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#screen{width:100%;height:100%;display:block;image-rendering:pixelated;touch-action:none}html .esh-row small{display:none}html .esh-row:focus-within small{display:block}</style></head>\n<body><!-- E.bootSplash's markup here --><canvas id=\"screen\"></canvas><script>/* engine */</script><script>/* game */</script></body></html>\n```\n\n**Skeleton.** A complete shared-world game on the engine. It passed all four harness runs and runs standalone. Replace the dots with the real sim, keeping its structure: connect, the event handlers, the host's step, the 12/s snapshot and the mirror. `HUB.send` for a real event batch is reliable by default.\n\n```js\n// Hub skeleton: shared world on my-3D2dge. The host's copy runs the world; other copies mirror it and send their own hands.\n(() => {\nconst E = My3D2dge, HUB = window.AIHub, inSession = !!(HUB && HUB.active), { px } = E;\nconst { attack, dash, skill, jump, ...base } = E.Input.DEFAULT;\nconst game = window.G = new E.Game({ canvas: 'screen', res: [426, 240], expand: true, view: 'overhead', touch: 'never', live: inSession, autoPause: !inSession, corner: !inSession,\n  input: { ...base, useTool: ['Pad7', 'Pad0', 'Mouse0', 'Space'], more: ['Pad3', 'KeyM'] }, menu: { quit: inSession ? false : 'title', settings: [{ key: 'music', value: .1 }, { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] }] } });\nconst NAME = 'SKELETON', W0 = 426, H0 = 240, DOTS = 12;\nlet info = null, phase = 'wait', card = null, over = false, sent = 0, heardSeq = 0, S = { v: 70, dots: [], p: {} }, mine = { x: 200, y: 120, t: 0 }, rng = null;\nconst place = () => ({ x: 40 + rng() * 340, y: 40 + rng() * 160 });\nfunction hostInit() { rng = HUB.rng('deal'); S.dots = Array.from({ length: DOTS }, (_, id) => ({ id, ...place(), alive: 1 })); for (const q of info.players) S.p[q.id] = { x: 200, y: 120, t: 0, score: 0, gone: false }; }\nfunction finish(won) { if (over) return; over = true; if (HUB.server !== true && info.me != null && S.p[info.me]) Object.assign(S.p[info.me], mine, { score: S.p[info.me].score });\n  const live = info.players.filter(q => !S.p[q.id].gone).sort((a, b) => S.p[b.id].score - S.p[a.id].score), standings = [];\n  for (const q of live) { const last = standings[standings.length - 1]; if (last && S.p[last[0]].score === S.p[q.id].score) last.push(q.id); else standings.push([q.id]); }\n  const scores = Object.fromEntries(info.players.map(q => [q.id, S.p[q.id].score]));\n  HUB.send({ t: 'over', v: S.v }); HUB.finish({ standings, scores, won, awards: live.length ? [{ id: live[0].id, title: 'Steadiest Hand', detail: scores[live[0].id] + ' clean actions' }] : [] }); }\nasync function connect() { info = await HUB.connect({ mode: 'shared-world', seats: [1, 4], card: true });\n  if (!info) { phase = 'solo'; return; }\n  HUB.on('card', c => { card = c; });\n  HUB.on('start', () => { phase = 'count'; });\n  HUB.on('message', (d, from) => { if (info.isHost) { const p = S.p[from]; if (d.t === 'i' && p && d.n > (p.n || 0)) { p.n = d.n; p.x = d.x; p.y = d.y; p.t = d.t2; } } else if (from === info.host) { if (d.t === 's' && d.n > heardSeq) { heardSeq = d.n; S.v = d.v; S.dots = d.o.map(([id, x, y]) => ({ id, x, y, alive: 1 })); for (const [id, x, y, t, sc] of d.p) { const q = S.p[id] || (S.p[id] = {}); if (id !== info.me) { q.x = x; q.y = y; q.t = t; } q.score = sc; } } if (d.t === 'over') over = true; } });\n  HUB.on('leave', ({ id }) => { if (S.p[id]) S.p[id].gone = true; });\n  HUB.on('time-up', () => { if (info.isHost) finish(false); });\n  HUB.on('end', () => { phase = 'over'; game.audio.music(null); game.audio.mute(true); });\n  if (info.isHost) hostInit();\n  HUB.ready(); }\nfunction step(dt) { const I = game.input, m = I.move(), a = I.padAim, ptr = I.pointer(); let dx = (a ? a[0] : 0) + m[0], dy = (a ? a[1] : 0) + m[1]; mine.x = E.clamp(mine.x + dx * 300 * dt, 0, W0); mine.y = E.clamp(mine.y + dy * 300 * dt, 0, H0); if (ptr && I.lastDevice === 'mouse') { mine.x = ptr[0]; mine.y = ptr[1]; } mine.t = I.value('useTool'); }\nlet snapN = 0, inN = 0, acc = 0;\nfunction hostStep(dt) { S.v = Math.max(0, S.v - .05 * dt); if (info.me != null && S.p[info.me] && !info.server) Object.assign(S.p[info.me], mine, { score: S.p[info.me].score });\n  for (const id in S.p) { const p = S.p[id]; if (p.gone || !p.t) continue; for (const d of S.dots) if (d.alive && Math.hypot(d.x - p.x, d.y - p.y) < 12) { d.alive = 0; p.score++; } } S.dots = S.dots.filter(d => d.alive); if (!S.dots.length) finish(true); }\ngame.start({ scene: 'hub', scenes: { hub: { pausable: true, camera: { zoom: false, wheel: false },\n  update(dt) { const I = game.input; game.focus(game.W / 2, game.H / 2, 0);\n    if (!info && !inSession) return;\n    if (phase === 'wait' && info) { if (I.pressed('confirm')) HUB.answer('ready'); if (I.pressed('more')) HUB.answer('more'); const c = I.clicked(); if (c) HUB.answer(c[1] > game.H * .7 ? 'more' : 'ready'); }\n    if (phase === 'count' && HUB.time() >= 0) phase = 'play';\n    if (phase === 'play' && !over) { step(dt); if (info.isHost) hostStep(dt); acc += dt; if (acc >= 1 / 12) { acc = 0; if (info.isHost) HUB.send({ t: 's', n: ++snapN, v: Math.round(S.v), o: S.dots.map(d => [d.id, d.x | 0, d.y | 0]), p: info.players.filter(q => !S.p[q.id].gone).map(q => { const p = S.p[q.id]; return [q.id, p.x | 0, p.y | 0, p.t > .25 ? 1 : 0, p.score | 0]; }) }, { reliable: false }); else HUB.send({ t: 'i', n: ++inN, x: mine.x | 0, y: mine.y | 0, t2: mine.t > .25 ? 1 : 0 }, { to: info.host, reliable: false }); } } },\n  draw(r) { if (info && info.server) return; r.sky(['#143a36', '#14504a']); r.overlay(g => { E.font.text(g, NAME + ' ' + phase + (card && card.left != null ? ' ' + Math.ceil(card.left / 1000) : ''), 8, 8, '#fff', { outline: false }); for (const d of S.dots) px.disc(g, d.x, d.y, 4, '#5ff0e0'); if (info) for (const q of info.players) { const p = q.id === info.me ? mine : S.p[q.id]; if (p && !(S.p[q.id] || {}).gone) { px.disc(g, p.x, p.y, 5, q.color); E.font.text(g, q.name.slice(0, 12), p.x + 7, p.y - 4, q.color, { outline: false }); } } }); } } } });\nwindow.__hubProbe = () => ({ phase, over, dots: S.dots.length, v: S.v, t: HUB.active ? HUB.time() : 0 });\nconnect();\n})();\n```\n\n**Harness runner.** The folder needs the game (as `game.html`) and copies of `harness.html`, `bridge.js`, `round.js`. It uses an OS-picked port, checks the frame's title is your game (replace the print with a test), and stops only its own server, by handle.\n\n```python\nimport json, os, re, subprocess, sys, time\nfrom playwright.sync_api import sync_playwright\nfolder = os.path.abspath(sys.argv[1])\nsrv = subprocess.Popen([sys.executable, '-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], cwd=folder, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\ntry:\n    line = srv.stdout.readline(); port = int(re.search(r'port (\\d+)', line).group(1))\n    base = f'http://127.0.0.1:{port}/'\n    RUNS = ['players=2&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave&auto=1', 'players=2&scenario=server&auto=1']\n    with sync_playwright() as p:\n        b = p.chromium.launch(args=['--autoplay-policy=no-user-gesture-required'])\n        for q in RUNS:\n            pg = b.new_page(viewport={'width': 1280, 'height': 720}); pg.goto(base + 'harness.html?game=game.html&' + q)\n            try: pg.wait_for_function(\"() => document.body.dataset.complete === 'true'\", timeout=90000)\n            except Exception as e: print('TIMEOUT', q)\n            r = pg.evaluate(\"() => { const h = window.__hubCheck; return h ? { pass: h.pass, failed: h.checks.filter(c => !c.pass).map(c => c.name + ': ' + c.detail), n: h.checks.length } : null }\")\n            title = pg.evaluate(\"() => { const f = document.querySelector('iframe'); try { return f && f.contentDocument && f.contentDocument.title } catch (e) { return 'x' } }\")\n            print(q, json.dumps(r)[:700], 'title:', title); pg.close()\n        pg = b.new_page(viewport={'width': 1280, 'height': 720}); errs = []; pg.on('pageerror', lambda e: errs.append(str(e))); pg.goto(base + 'game.html'); pg.wait_for_timeout(1200); print('standalone', pg.evaluate(\"() => ({ active: AIHub.active, probe: window.__hubProbe() })\"), errs[:3]); pg.close()\n        b.close()\nfinally:\n    srv.terminate(); srv.wait(timeout=5)\n```\n\n## Appendix E: gamepad stub and touch-notice patch\n\n**A DualSense in the standard mapping, for Playwright's `add_init_script`.** Set `__pad.axes[0..3]` (left x, left y, right x, right y), `__pad.buttons[i].value` and `.pressed`: 0 ✕, 1 ○, 2 □, 3 △, 4 L1, 5 R1, 6 L2, 7 R2, 8 Create, 9 Options, 12 to 15 D-pad, and bump `__pad.timestamp`.\n\n```js\n(() => { const axes = [0, 0, 0, 0], buttons = Array.from({ length: 18 }, () => ({ pressed: false, touched: false, value: 0 }));\n  const pad = { id: 'DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c Product: 0ce6)', index: 0, connected: true, mapping: 'standard', timestamp: 0, axes, buttons,\n    vibrationActuator: { playEffect() { return Promise.resolve('complete'); }, reset() { return Promise.resolve('complete'); } } };\n  window.__pad = pad; navigator.getGamepads = () => [pad, null, null, null]; })();\n```\n\n**Touch notice.** In your copy of the engine, `Game.prototype._needSync` sets the notice's `style.cssText` to a full-screen dark layer. Change that one string, so the reel shows above and the notice sits at the bottom. *Verified* on an iPhone profile: the notice sits in the lower half, the canvas above it is clear, and a tap on Settings opens the settings:\n\n```js\nd.style.cssText = 'position:absolute;left:0;right:0;bottom:0;z-index:20;display:flex;align-items:flex-end;justify-content:center;padding:48px 24px 24px;text-align:center;pointer-events:none;background:linear-gradient(transparent,rgba(5,3,12,.92) 45%);color:#f4f0ff;font:600 17px/1.45 system-ui,sans-serif';\n// and on the button, add pointer-events:auto to its inline style\n```\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/README.md' && wc -l 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/docs/ASSETS.md' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/hub/README.md'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/README.md' && wc -l 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/docs/ASSETS.md' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/hub/README.md'\"","aggregated_output":"# my-3D2dge handoff package (v0.89.1)\n\nEverything a coding agent needs to build, run, test and check a game on the full my-3D2dge engine, in one folder of text\nfiles. You don't need the engine's repository, and you don't need to read the engine's source below its header.\n\n**The engine is yours to change.** This copy is yours to fix, extend or rewrite in any way you see fit: `my-3d2dge.js`\nis the engine, readable, with every module, and every page and test here loads it (`modules/` and `my-3d2dge-agent.js`\nare separate copies). If you hand the game back, a line on what you changed and why helps: it shows what the engine\nlacks.\n\n## Start here\n\n1. **Read `API.md`**, the API card: a complete game to start from, what x, y and z mean in each view, the rules, the\n   common mistakes and the API by area. It is the one page to read whole.\n2. **Start from a game, not an empty file.** The kit for your genre (`kits/`): the card's Genre playbook names one for\n   each genre, and `kits/README.md` says which file is which. `kits/<id>.js` is a complete game in that genre, readable\n   (its title, play and end, the modules it rests on, sound, touch controls), `kits/<id>.html` plays it, and\n   `node kits/test.mjs <id>` runs it headless. Or the template, `game/`: a small complete game (climbing, a guard with\n   sight, an HTML HUD, scenes) that `game/index.html` plays and `game/test.mjs` tests without a browser. Copy one into\n   `game/` and make it yours.\n3. **Search `API-INDEX.md`** when you need a name: every public name in the engine, one line each, with its signature,\n   units and defaults, and the height rules at the top. `grep -n \"ledge\\|landing\" API-INDEX.md`. Don't read it whole.\n4. **`AI_GUIDE.md`** has the recipes: genre by genre, the look to aim for, the frame order, heights, recorded sessions.\n5. **Don't build a pause menu, settings, key rebinding, full screen or a loading screen**: every game has them (`API.md`,\n   \"Standard features\"). Adjust them with `new E.Game({ menu: { items, settings, controls, quit } })`; heavy setup goes in\n   `game.start({ boot: { steps } })`.\n6. **Objects without drawing code:** read `docs/ASSETS.md` whole before you draw a barrel, a table or a tree.\n   `r.shape('barrel', x, y, 0, { facing })` draws one of the core library's in every view; `node tools/asset-find.mjs\n   \"market stall\"` searches it and the store (`src/assets/sets/`: about a thousand objects, materials and sprites,\n   each with where it came from), and `node tools/asset-sheet.mjs mine.js#stool` draws one you wrote, to look at\n   before you use it.\n7. **A game in real 3D** (first person, a light gun, a racer on banked roads, flight, a dungeon crawled in 3D, fixed\n   cameras): the 2D views have no perspective camera, but the engine has a 3D add-on, `World3D` (three.js r182 and\n   Rapier 0.19.3 under the 2D engine, which keeps the HUD, menus and sound). It is not in this folder: take\n   `engine/my-3d2dge-3d.js` (its header is its manual), `vendor/` and the 3D kit closest to your game\n   (`src/starter3d/`) from the repository, github.com/michaelcrosato/my-3d2dge, and see them play at\n   my-3d2dge.vercel.app/3d.\n\n## What is here\n\n| File | What it is |\n| --- | --- |\n| `my-3d2dge.js` | the full engine, readable (one file, no dependencies): the core, then every module |\n| `modules/` | each engine module on its own, when there are any (one general system; its header is its manual), to load after the agent edition |\n| `my-3d2dge-agent.js` | the agent edition: the essential engine, whose header is a shorter manual (a game written for it runs on the full engine) |\n| `API.md`, `API-INDEX.md`, `AI_GUIDE.md` | the card, the index, the guide |\n| `kits/` | the 2D genre kits, readable: each kit's game (`<id>.js`) and the page that plays it (`<id>.html`), the table of them (`README.md`) and their headless test (`test.mjs`) |\n| `game/` | the template game: `index.html`, `game.js`, `test.mjs` |\n| `tools/check.mjs` | plays a game in headless Chromium, switches its views, and reports errors, what is on screen, and `game.debug.snapshot()` |\n| `tools/filmstrip.mjs` | records frames into one picture, to judge motion (`--seed 1` makes it repeatable, `--compare` marks what changed) |\n| `tools/replay.mjs` | replays a recorded play session exactly (`E.session`, a bug seen on a phone) |\n| `docs/ASSETS.md` | the asset card: still objects and materials as data (`r.shape`, `map.solid`, `E.MATERIALS`), the core library, writing one |\n| `tools/asset-find.mjs`, `asset-sheet.mjs`, `asset-set.mjs` | search the core library and the store; draw an object in every view and lint it; cut the few entries a game uses into a set of its own (`asset-lib.mjs` is theirs) |\n| `src/assets/` | the asset store: sets of objects and materials converted from CC0 libraries (Kenney, KayKit, ambientCG), with their catalogs. A game loads one with its script and `E.addAssets(window.ASSETS['kenney-furniture'])`; the Asset Lab shows them all at my-3d2dge.vercel.app/asset-lab |\n| `package.json` | pins Playwright for the tools |\n\nNot here: the 3D engine (three.js and Rapier) and its kits, the playbook's 3D rows. They are on the site\n(my-3d2dge.vercel.app/3d) and in the repository (github.com/michaelcrosato/my-3d2dge); here a 3D game is built on the 2D\nengine's views (`kits/README.md`, 3D).\n\n## Run, test, check\n\n```sh\nnpm install                          # Playwright, for the tools (once)\nnpx playwright install chromium      # its browser (once)\nnode game/test.mjs                   # the game's headless test: no browser, a second\nnode tools/check.mjs game/index.html # play it in a browser: errors, screenshots, its snapshot\nnode kits/test.mjs arcade            # a kit, headless: it plays, and its proof gives the same hash twice\nnode tools/check.mjs kits/arcade.html#arcade/maze   # a kit in a browser, at a part (its deep link)\nnode tools/filmstrip.mjs game/index.html --steps \"wait:800 press:Enter wait:500 rec:16:2 down:KeyD wait:600\" --seed 1\n```\n\nOpen `game/index.html` in a browser to play (or serve the folder: `npx serve`). To hand a single file to a person, inline\nthe two scripts into the page, writing every `</script` inside them as `<\\/script` (the agent edition's header has one,\nand the page would end there).\n\n## Testing a game without a browser\n\n`new E.Game()` is headless in Node (or with `{ headless: true }`): no screen, sound or DOM, and `draw` is skipped unless\nthe game is made with `draw: true` (the template is): then each `advance` draws a frame on a stand-in, and a draw error\nlands in `game.errors`, as it would on a player's screen.\n\n- `game.advance(seconds)` runs exact fixed steps of 1/120 s at once: `advance(1)` is 120 updates.\n- `game.input.tap('jump')` presses an action for one step, `hold('right')` holds one down, `hold('right', false)` lets go.\n- `game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }` is your game's handle: tests read it, and\n  `tools/check.mjs` and `tools/replay.mjs` print it.\n- `game.stop()`, `game.start()` and `game.dispose()` stop, resume and end a game.\n- `game.go('play')` fades for `game.fadeTime` (.22 s) before the new scene enters: advance past it, or set\n  `game.fadeTime = 0` in a test.\n- A scene change clears `game.after` and `game.every` timers (`{ keep: true }` outlives it); those made before the first\n  scene live into it. It ends a hit-stop; `game.timeScale` stays (restore a slow motion with a kept timer). A boot step's `game.go(name)` enters that scene when the boot ends.\n- Draw changes nothing, and nothing your update or input relies on (a click target, what is on screen) may be made only\n  in `draw`: `E.Menu`'s rows come from its update (`menu.rowAt(i)` is entry i's box, for a test's click), and the camera\n  (`game.cam`) says where the screen is in update.\n- `E.store` keeps values for the visit in Node, which has no `localStorage` (`E.store.clear()` between games in one test).\n- A script's `tap` and `hold` are no device: `input.label()` keeps showing the keys or buttons the player used last.\n\nThe same inputs give the same game on every machine and at every refresh rate: the clock is an exact fixed step.\n  297 Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md\n  160 Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/docs/ASSETS.md\n  410 Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/hub/README.md\n  867 total\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/hub/README.md'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/hub/README.md'\"","aggregated_output":"# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card: what the game is, how to win, the\n   controls. The card is the hub's, from the game's tags, or the game's own\n   (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. By default the hub shows its own card over\nthe game. A game can make the card its own, as part of the game:\n\n```js\nAIHub.connect({ mode, seats, card: true });\n```\n\nThe hub's card then steps aside when the game calls `ready()`, and the game's\nscreen is the card until `start`. How it looks and sounds is the game's: its\ntitle, its music, its world, the players lining up. Introduce the game the way\nit deserves.\n\nWhile it is on, the card shows:\n\n- the game's name;\n- the players, each in their colour, and which of them are ready;\n- how to win the round;\n- the controls this player will use;\n- the time left, from the `card` event.\n\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\non the card:\n\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n\nIn the AI Hub repository, `node scripts/hub-check.mjs <game>` runs the same\nchecks with Playwright, then opens the game outside a session to see it still\nruns there.\n\n---\n\n## Reference\n\n### Tags\n\n| Tag | |\n|---|---|\n| `hub:session` | `1`: this protocol |\n| `hub:session-players` | `MIN-MAX`: the number of players the game takes in a session |\n| `hub:session-mode` | `parallel`, `ghost` or `shared-world` |\n| `hub:session-goal` | how to win, shown on the hub's card |\n| `hub:session-howto` | the controls, shown on the hub's card |\n| `hub:session-minutes` | optional: how many minutes a round takes |\n| `hub:webgpu` | optional: `required` when the game cannot run without WebGPU |\n\n### API\n\n| | |\n|---|---|\n| `AIHub.active` | `true` in a session, from the first line |\n| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\| null>`; `null`: no hub. `card: true`: the game shows its own card |\n| `AIHub.ready()` | once, when the round can start |\n| `AIHub.answer('ready' \\| 'more')` | on the game's own card, before `start` |\n| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n| `AIHub.on(event, fn)` | returns a function that removes the handler |\n| `AIHub.progress({ score, label })` | parallel and ghost |\n| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n| `AIHub.finish({ standings, scores?, won?, stats?, awards? })` | shared world, the host, once |\n| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n| `AIHub.fail(message)` | the game cannot run in this browser |\n\n`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\nread them.\n\n| Event | Arguments |\n|---|---|\n| `card` | `{ left, paused, starting, ready, asking, asked }`, with the game's own card |\n| `start` | `{ in }`: milliseconds until play begins |\n| `message` | `data, from` |\n| `leave` | `{ id, reason }` |\n| `time-up` | `{ graceMs }` |\n| `end` | `{ reason, standings }` |\n\nEvents that arrive before a handler is attached are kept, and delivered in\norder when the first handler is attached. Fields and events a newer hub adds\nreach the game through the client unchanged.\n\n### Versions\n\nThis is protocol **1**, client **1.4.0**. Changes within version 1 only add:\ngames on older clients keep working. A change that would break a game becomes\nprotocol 2, with its own `hub:session` value.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/README.md' && sed -n '1,160p' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/README.md' && sed -n '1,160p' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md'\"","aggregated_output":"# my-3D2dge handoff package (v0.89.1)\n\nEverything a coding agent needs to build, run, test and check a game on the full my-3D2dge engine, in one folder of text\nfiles. You don't need the engine's repository, and you don't need to read the engine's source below its header.\n\n**The engine is yours to change.** This copy is yours to fix, extend or rewrite in any way you see fit: `my-3d2dge.js`\nis the engine, readable, with every module, and every page and test here loads it (`modules/` and `my-3d2dge-agent.js`\nare separate copies). If you hand the game back, a line on what you changed and why helps: it shows what the engine\nlacks.\n\n## Start here\n\n1. **Read `API.md`**, the API card: a complete game to start from, what x, y and z mean in each view, the rules, the\n   common mistakes and the API by area. It is the one page to read whole.\n2. **Start from a game, not an empty file.** The kit for your genre (`kits/`): the card's Genre playbook names one for\n   each genre, and `kits/README.md` says which file is which. `kits/<id>.js` is a complete game in that genre, readable\n   (its title, play and end, the modules it rests on, sound, touch controls), `kits/<id>.html` plays it, and\n   `node kits/test.mjs <id>` runs it headless. Or the template, `game/`: a small complete game (climbing, a guard with\n   sight, an HTML HUD, scenes) that `game/index.html` plays and `game/test.mjs` tests without a browser. Copy one into\n   `game/` and make it yours.\n3. **Search `API-INDEX.md`** when you need a name: every public name in the engine, one line each, with its signature,\n   units and defaults, and the height rules at the top. `grep -n \"ledge\\|landing\" API-INDEX.md`. Don't read it whole.\n4. **`AI_GUIDE.md`** has the recipes: genre by genre, the look to aim for, the frame order, heights, recorded sessions.\n5. **Don't build a pause menu, settings, key rebinding, full screen or a loading screen**: every game has them (`API.md`,\n   \"Standard features\"). Adjust them with `new E.Game({ menu: { items, settings, controls, quit } })`; heavy setup goes in\n   `game.start({ boot: { steps } })`.\n6. **Objects without drawing code:** read `docs/ASSETS.md` whole before you draw a barrel, a table or a tree.\n   `r.shape('barrel', x, y, 0, { facing })` draws one of the core library's in every view; `node tools/asset-find.mjs\n   \"market stall\"` searches it and the store (`src/assets/sets/`: about a thousand objects, materials and sprites,\n   each with where it came from), and `node tools/asset-sheet.mjs mine.js#stool` draws one you wrote, to look at\n   before you use it.\n7. **A game in real 3D** (first person, a light gun, a racer on banked roads, flight, a dungeon crawled in 3D, fixed\n   cameras): the 2D views have no perspective camera, but the engine has a 3D add-on, `World3D` (three.js r182 and\n   Rapier 0.19.3 under the 2D engine, which keeps the HUD, menus and sound). It is not in this folder: take\n   `engine/my-3d2dge-3d.js` (its header is its manual), `vendor/` and the 3D kit closest to your game\n   (`src/starter3d/`) from the repository, github.com/michaelcrosato/my-3d2dge, and see them play at\n   my-3d2dge.vercel.app/3d.\n\n## What is here\n\n| File | What it is |\n| --- | --- |\n| `my-3d2dge.js` | the full engine, readable (one file, no dependencies): the core, then every module |\n| `modules/` | each engine module on its own, when there are any (one general system; its header is its manual), to load after the agent edition |\n| `my-3d2dge-agent.js` | the agent edition: the essential engine, whose header is a shorter manual (a game written for it runs on the full engine) |\n| `API.md`, `API-INDEX.md`, `AI_GUIDE.md` | the card, the index, the guide |\n| `kits/` | the 2D genre kits, readable: each kit's game (`<id>.js`) and the page that plays it (`<id>.html`), the table of them (`README.md`) and their headless test (`test.mjs`) |\n| `game/` | the template game: `index.html`, `game.js`, `test.mjs` |\n| `tools/check.mjs` | plays a game in headless Chromium, switches its views, and reports errors, what is on screen, and `game.debug.snapshot()` |\n| `tools/filmstrip.mjs` | records frames into one picture, to judge motion (`--seed 1` makes it repeatable, `--compare` marks what changed) |\n| `tools/replay.mjs` | replays a recorded play session exactly (`E.session`, a bug seen on a phone) |\n| `docs/ASSETS.md` | the asset card: still objects and materials as data (`r.shape`, `map.solid`, `E.MATERIALS`), the core library, writing one |\n| `tools/asset-find.mjs`, `asset-sheet.mjs`, `asset-set.mjs` | search the core library and the store; draw an object in every view and lint it; cut the few entries a game uses into a set of its own (`asset-lib.mjs` is theirs) |\n| `src/assets/` | the asset store: sets of objects and materials converted from CC0 libraries (Kenney, KayKit, ambientCG), with their catalogs. A game loads one with its script and `E.addAssets(window.ASSETS['kenney-furniture'])`; the Asset Lab shows them all at my-3d2dge.vercel.app/asset-lab |\n| `package.json` | pins Playwright for the tools |\n\nNot here: the 3D engine (three.js and Rapier) and its kits, the playbook's 3D rows. They are on the site\n(my-3d2dge.vercel.app/3d) and in the repository (github.com/michaelcrosato/my-3d2dge); here a 3D game is built on the 2D\nengine's views (`kits/README.md`, 3D).\n\n## Run, test, check\n\n```sh\nnpm install                          # Playwright, for the tools (once)\nnpx playwright install chromium      # its browser (once)\nnode game/test.mjs                   # the game's headless test: no browser, a second\nnode tools/check.mjs game/index.html # play it in a browser: errors, screenshots, its snapshot\nnode kits/test.mjs arcade            # a kit, headless: it plays, and its proof gives the same hash twice\nnode tools/check.mjs kits/arcade.html#arcade/maze   # a kit in a browser, at a part (its deep link)\nnode tools/filmstrip.mjs game/index.html --steps \"wait:800 press:Enter wait:500 rec:16:2 down:KeyD wait:600\" --seed 1\n```\n\nOpen `game/index.html` in a browser to play (or serve the folder: `npx serve`). To hand a single file to a person, inline\nthe two scripts into the page, writing every `</script` inside them as `<\\/script` (the agent edition's header has one,\nand the page would end there).\n\n## Testing a game without a browser\n\n`new E.Game()` is headless in Node (or with `{ headless: true }`): no screen, sound or DOM, and `draw` is skipped unless\nthe game is made with `draw: true` (the template is): then each `advance` draws a frame on a stand-in, and a draw error\nlands in `game.errors`, as it would on a player's screen.\n\n- `game.advance(seconds)` runs exact fixed steps of 1/120 s at once: `advance(1)` is 120 updates.\n- `game.input.tap('jump')` presses an action for one step, `hold('right')` holds one down, `hold('right', false)` lets go.\n- `game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }` is your game's handle: tests read it, and\n  `tools/check.mjs` and `tools/replay.mjs` print it.\n- `game.stop()`, `game.start()` and `game.dispose()` stop, resume and end a game.\n- `game.go('play')` fades for `game.fadeTime` (.22 s) before the new scene enters: advance past it, or set\n  `game.fadeTime = 0` in a test.\n- A scene change clears `game.after` and `game.every` timers (`{ keep: true }` outlives it); those made before the first\n  scene live into it. It ends a hit-stop; `game.timeScale` stays (restore a slow motion with a kept timer). A boot step's `game.go(name)` enters that scene when the boot ends.\n- Draw changes nothing, and nothing your update or input relies on (a click target, what is on screen) may be made only\n  in `draw`: `E.Menu`'s rows come from its update (`menu.rowAt(i)` is entry i's box, for a test's click), and the camera\n  (`game.cam`) says where the screen is in update.\n- `E.store` keeps values for the visit in Node, which has no `localStorage` (`E.store.clear()` between games in one test).\n- A script's `tap` and `hold` are no device: `input.label()` keeps showing the keys or buttons the player used last.\n\nThe same inputs give the same game on every machine and at every refresh rate: the clock is an exact fixed step.\n# my-3D2dge API card (v0.89.1)\n\nmy-3D2dge (\"My 3D 2D Game Engine\") is a general-purpose retro-modern 2D game engine built for AI models. Use it to port, remaster, reimagine and remix games from the 8-bit to 64-bit eras (NES, SNES, Genesis, N64, PS1), or to make spiritual successors to them. Everything is drawn by code: no image or sound files. Characters are 3D skeletons drawn as pixel art, and the camera can be any classic 2D view.\n\n**Start from a kit:** each genre has one, a complete small game written to be copied (the Genre playbook below names it). In a single file it sits between `GAME START` and `GAME END`: the starter's shell (the game, its title menu, the proof), the slice and the start; a genre kit holds one slice, `dist/my-3d2dge.html` every one and the ANIMATION LAB (how each animation is driven). In the handoff package each kit's game is `kits/<id>.js`, readable. **To make a game, change the slice into yours, with its own title, play and game-over scenes, and delete the starter's menu and the slices you do not use. The engine is yours to change too:** fix, extend or rewrite any of it as you see fit.\n\n**Looking a name up:** grep `API-INDEX.md` (every public name, one line; members are filed under instance names: `rig.`, `talk.`, `mover.`, `flow.`, `map.`), not the engine's source. It, the guide (`AI_GUIDE.md`) and the tools are in the handoff package (my-3d2dge.vercel.app/handoff/) and the repository.\n\n## Quick start (a complete game)\n```js\n(() => {\nconst E = My3D2dge, { px, clamp } = E;            // always start like this\nconst game = new E.Game({ canvas: 'screen', res: 'snes', view: 'threequarter' });\nconst map = new E.TileMap({\n  rows: ['##########', '#@...s...#', '#..##....#', '#........#', '##########'],\n  legend: { '#': 1, '@': 'hero', 's': 'slime' },  // number = wall type, string = spawn tag\n  types: { 1: { h: 30, top: '#57506a', side: '#3d3750' } },\n  floorTex: (x, y) => E.tex.flagstone(x, y, { stones: ['#4b4559', '#554f64'].map(E.hex), mortar: E.hex('#221e2b'), hi: E.hex('#6f6782'), lo: E.hex('#322d3e'), speck: E.hex('#2a2634') })\n});\ngame.cam.bounds = v => map.bounds(v);\nconst s = map.find('hero'), hero = new E.Body({ x: s.x, y: s.y, r: 5 });\nconst rig = new E.Humanoid({ hat: 'pointed' });\ngame.start({\n  update(dt) {\n    const m = game.input.move(), d = game.view.screenDirToGround(m[0], m[1]);\n    hero.vx = d[0] * 80; hero.vy = d[1] * 80; hero.update(dt, map);\n    if (Math.hypot(d[0], d[1]) > .1) hero.facing = Math.atan2(d[1], d[0]);\n    rig.update(dt, { x: hero.x, y: hero.y, z: hero.z, vx: hero.vx, vy: hero.vy, facing: hero.facing || 0 });\n    game.focus(hero.x, hero.y, 10);                // the camera looks here: call every update\n  },\n  draw(r) {\n    map.drawFloor(r); r.shadow(hero.x, hero.y, 5); map.queueWalls(r);\n    r.actor(hero.x, hero.y, hero.z, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n    r.text('HELLO', 4, 4, '#ffffff');              // HUD text in screen pixels\n  }\n});\n})();\n```\n\n## Look target (read this before drawing anything)\nAim above SNES, level with the best PS1 / N64 2D games (Symphony of the Night, Metal Slug, Legend of Mana, Klonoa). Games that skip these steps look like Atari games. **Every game should use all of them:**\n1. **Resolution** `res: 'ps1'` (320x240) or `'snes'`, with `expand: true` so it fills any screen (anchor the HUD to `r.W` / `r.H`), and characters 40-60 px tall: `new E.Humanoid({ size: 1.3 })` (HD style is the default: shaded volumetric limbs, outfits, hair).\n2. **Dress the character**: an `outfit`, `hair`, a `hat`, `armor`, a `cape`, `sleeves` (Characters), and a real palette in `colors` (never leave the defaults on everyone).\n3. **Backdrop behind every side-view level**: `const bg = new E.Backdrop('castle-night')` then `bg.draw(r)` first in `draw` (a ground view's floor runs on to the screen's edges: `map.outside`). Presets: `day dusk night castle-night city-night desert forest ocean cave space`, or your own `{ sky, sun | moon, stars, starsY: .7, layers: [{ kind: 'mountains' | 'hills' | 'forest' | 'city' | 'castle' | 'clouds' | 'sea' | 'fog' | 'stalactites', color, y, height, parallax, fill }] }` (`starsY` = how far down the stars reach; a layer but clouds, fog and stalactites fills the screen below its skyline unless `fill: false`).\n4. **Textured tiles**: PlatformMap styles `stone` (with `moss`), `brick`, `wood`, `metal`, `ground` (with `flower`), `block`, `pipe`, `bonus`; TileMap floors from `E.tex.*`, TileMap walls with `face: 'brick' | 'stone' | 'rock' | 'plank' | 'timber' | 'plaster' | 'hedge'` and tops with `roof: 'tiles' | 'slab' | 'leaves' | 'grass'` (a village = timber and plaster houses with tile roofs, hedges, rock cliffs).\n5. **Props in every room** (3-8 per screen): `r.prop(name, x, y, z, { size, color, light: true })` with `torch candle candelabra chandelier brazier window banner pillar statue crate barrel chest pot sign fence lamp door tree pine bush flowers grass rock crystal bones skull vines cobweb lantern streetlamp awning hydrant trashcan firedrum sandbags cactus palm mushroom`. Flames animate, glow and can light the scene. `chest` / `door` take `{ open: true }`, `pillar` takes `{ broken: true }`, `window` is a gothic rose window with lead cames (`colors: [...]` for the glass, `size: 2-3` for a cathedral); hang `vines`, `cobweb`, `lantern` with `{ anchor: 'top' }`. With heroes at size 1.2+, give the scene `propSize: 1.4` (or set `E.style.propSize`) so props match them.\n6. **Effects on every hit**: `particles.explosion(x, y, z, size)`, `smoke`, `fire`, `glints`, `sparks`, `game.flash(color, s)`, `game.freeze`, `game.shake`.\n7. **Color**: `E.tones(hex)` gives `{ deep, sh, base, lt, hi }` hue-shifted shades and `E.ramp(hex, n)` a palette ramp. Shade everything you draw yourself with them (shadow side `sh`, lit edge `lt`, a `hi` sparkle).\n8. **Typography**: the default font is a 5x7 proportional font with lower case. Titles: `E.font.title(g, 'NAME', x, y, { scale: 3, colors: [...], align: 'center' })`. HUD text: `{ shadow: '#000', outline: false }` or `gradient: [top, bottom]`. `font: 'tiny'` is the old 3x5 font.\n9. **Light every scene**: `game.lights.enabled = true; game.lights.ambient = .5` in a scene's `enter`, then each draw a few lights where light comes from (`r.prop('lamp', x, y, 0, { light: true })`, `game.lights.add(x, y, z, 60, .9, { color })`): dusk, torchlight and glows give depth. It looks the same in every browser and check; `game.enableGPU({ map })` adds shadows in ground views, and falls back to it.\n10. **Faces in dialog**: `talk.say(lines, { name: 'MIRA', portrait: miraRig })` puts a live close-up of that Humanoid (blinking, hair, hat) beside every line. `rig.drawPortrait(g, x, y, 40)` draws one anywhere (HUD, RPG party windows).\n\n## Coordinates: what x, y, z mean in each view\nWorld units: one tile = 16. **z is always up.** Game logic never stores screen pixels.\n\n| View | Looks like | Ground plane | Use for levels | Move with |\n|---|---|---|---|---|\n| `'iso'` (yaw 45, pitch 30) | Diablo, Landstalker | x/y ground, z up | `E.TileMap` | `E.Body` |\n| `'threequarter'` (pitch 55) | Zelda LttP, Stardew | x right, y down the screen | `E.TileMap` | `E.Body` |\n| `'topdown'` (pitch 80) | GTA 1, Hotline Miami | x right, y down | `E.TileMap` | `E.Body` |\n| `'brawler'` (pitch 25) | Final Fight, 2.5D | x right, y into the screen | `E.TileMap` or `E.PlatformMap` | `E.Body` or `E.Platformer` |\n| `'side'` (pitch 0) | Mario, Mega Man | **x right, z up, y = 0 (depth)** | `E.PlatformMap` | `E.Platformer` |\n| `'overhead'` (pitch 90, scale 1) | 1942, Galaga, Pac-Man | x = screen x px, y = screen y px | none, or a TileMap | your own x/y, or `E.Body` |\n\n- A unit is `r.ppu` pixels: at zoom 1 iso 1.41, overhead 1, the others 1.5 (a tile about 24). A sprite's pixel is a screen pixel (`{ world: true }`: it grows with the view, as rigs and maps do).\n- In `'side'` the screen shows x (right) and z (up). **y is depth and is normally 0.** Focus the camera with `game.focus(hero.x, 0, hero.z + 24)`.\n- In ground views, the screen direction the player pushes becomes a world direction through `game.view.screenDirToGround(mx, my)`.\n- `r.actor(x, y, z, (g, ox, oy) => ...)` calls your function with `(ox, oy)` = the buffer pixel where world point (x, y, z) lands. Draw the character around that point.\n\n## Rules\n1. Keep game logic in world units, and use `dt` everywhere. `update(dt)` runs in exact fixed steps: every 1/120 s of real time is one step of `dt = 1/120 * game.timeScale`, the same at any refresh rate (`game.alpha` = the part of a step left over).\n2. Draw only with `E.px.*`, `E.font`, `E.ui`, sprites, props and the `r.*` helpers. Never use `ctx.arc`, `ctx.stroke`, `ctx.fillText` or canvas gradients on the game buffer (they blur pixels). For translucency and glow use `px.blend(g, alpha, 'add' | 'multiply' | 'screen' | 'normal', () => {...})`, `px.polyDither`, `px.ddisc`, `r.glowDisc` and `r.shadow`: they use stepped alpha and blend modes like PS1 / SNES hardware (or dithering with `E.style.trans = 'dither'` for an NES / Genesis look).\n3. Anything that can overlap anything else goes through `r.actor`, `r.sprite` or `r.queue` (depth sorted). Backgrounds (`r.sky`, `map.drawFloor`, `level.draw`) come first in `draw`.\n4. Read input only in `update`. Use `pressed(a)` for one-shot actions (menus, jumps, shots), `down(a)` for held actions, and `buffered(a)` + `consume(a)` for forgiving combat input.\n5. Animate characters from continuous values (velocity, timers, easing): the rigs, not frame lists.\n6. Colors are `'#rrggbb'` (or `'#rgb'`) strings.\n7. Put the whole game in one IIFE `(() => { ... })();` between the markers, and start it with `game.start(...)`.\n\n## Common mistakes (check these first)\n- Nothing on screen: the camera looks at the wrong place. Use `game.follow(hero)` once (in the scene's `enter`), or call `game.focus(...)` every update. In side view the hero has y = 0.\n- Walls or level missing: you forgot `map.drawFloor(r)` + `map.queueWalls(r)` (TileMap) or `level.draw(r)` (PlatformMap).\n- Using a TileMap for a side-scroller. Side-scrollers use `E.PlatformMap` + `E.Platformer`.\n- HUD drawn in world coordinates. Use `r.text(...)` or `r.overlay(g => ...)` with screen pixels (`r.W`, `r.H`).\n- An old key layout: platformers want `input: 'PLATFORMER'` (Space jumps), shooters `input: 'SHMUP'` (Space fires).\n- Errors show in a red box on screen and in the console. Fix the first one first.\n- Colours are `'#rrggbb'`, `rgb()`, `hsl()` or a basic name ('orange'); any other draws magenta.\n- `mouseGround()` is `[x, y]`; `settings.reset(group)` resets a group ('Sound'; none: all), not a key; `particles.explosion()` adds a hit-stop and a shake (`{ freeze: false, shake: 0 }`); `E.font.text` outlines unless `outline: false`.\n- A frame past 50 ms gives up its time (no catch-up): a test in a slow browser waits on the game's state, not the clock.\n\n## Game\n`new E.Game({ canvas: 'screen', view, views, res, expand, input, bg })`\n- `res`: `'nes'` 256x240, `'snes'` 256x224, `'genesis'` 320x224, `'gb'` 160x144, `'gba'` 240x160, `'ps1'` / `'n64'` 320x240, `'wide'` 400x225, or `[w, h]`. Fixed pixels: whole-number scaling on a desktop screen, the largest fit on a phone (Settings, Pixel scaling). Leave it out for an adaptive size.\n- `expand: true`: full screen at any shape, no bars. `res` becomes the least the screen shows and `r.W` x `r.H` grows to fill the window (a 16:9 monitor shows about 427x240 of `'ps1'`, a phone held upright about 320x690). Anchor the HUD to `r.W` and `r.H`, and give the level something to show in the extra space (more of it, a backdrop, a HUD deck under it on a tall screen). `expand: { maxW, maxH }` caps the growth. A scene may set it too.\n- Adaptive size: `minW` / `minH` set the scale (the screen shows at least that many pixels), `maxW` / `maxH` cap the view (the rest is letterboxed). `portrait: { maxH: 1000 }` overrides them while the screen is taller than wide, so a phone held upright (9:16) is filled instead of showing a band across its middle. `game.screen.portrait` says which way it is.\n- `input`: `'DEFAULT'` (top-down action), `'PLATFORMER'`, `'SHMUP'`, `'THIRDPERSON'`, or your own `{ action: ['KeyQ', 'Pad0'] }`.\n- `views`: the views your game supports; `game.nextView()` cycles them (bind it to a key).\n- Start: `game.start({ update(dt), draw(r) })`, or with scenes (below).\n- Methods: `follow(obj, { z: 16, lead: 20 })` (camera tracks it automatically), `focus(x, y, z)` (or aim it yourself every update), `setView(id)`, `nextView()`, `freeze(s)` (hit-stop: `update` waits; `game.hitstop` is the time left), `shake(n)`, `after(s, fn)`, `every(s, fn)` (timers in game time, return `{ cancel() }`), `hook('input' | 'step' | 'enter', fn)` (your own each step, paused too for input; returns its removal), `mouseGround()`, `go(scene, data)`, `enableGPU({ map })`.\n- Fields: `W`, `H` (screen pixels), `time`, `real`, `timeScale` (0.25 = slow motion), `paused`, `input`, `audio`, `particles`, `lights`, `view`, `errors`, `cam`. `game.fail('my power', err)` reports an error in your code (logged, in `errors`, on the error panel) and plays on.\n- Camera zoom and turn: `game.setZoom(1.5)` (.5 .. 3; everything drawn by the engine re-rasterizes crisply, the HUD stays), `game.rotateView(45)` (ground views only), `game.resetCamera()` (to the scene's zoom), `game.zoom`, `game.yaw`, `game.note('ZOOM 2x')` (a short notice at the top of the screen; `game.shownNote` is the one showing). Custom painters can read `r.view.zoom` (undefined at 1x) to scale their own art.\n- The player's zoom: a scene's `camera: { zoom: [.75, 2], start: 1, tall: 1.5 }` lets the player zoom within `zoom` from `start` (wheel, `-` `=`, pinch, Settings; `false`: none; `AI_GUIDE.md`, Camera).\n- Tests and tools: `new E.Game({ headless: true })` (the default in Node: no screen, sound or DOM; `draw` is skipped, or with `draw: true` run on a stand-in, its errors in `game.errors`) or `{ loop: false }` runs only by `game.advance(seconds, { draw })` (exact fixed steps at once); `input.tap(action)` presses for one step, `input.hold(action, on)`; `game.debug = { snapshot() {...} }` is your game's handle (`tools/check.mjs` prints it); `game.stop()`, `start()`, `dispose()`.\n- Sessions: `?record=1`, then the pause menu's Save session; `node tools/replay.mjs session.json` replays it exactly, headless (`AI_GUIDE.md`, Sessions).\n- Camera: `cam.offset = [dx, dy]` sits the focus that many screen pixels from the centre (above a phone's touch buttons: `[0, -60]`); `cam.bounds = v => map.bounds(v)` keeps it inside the level (in side views a level shorter than the screen sits on the bottom edge; `cam.align = 'center'` to change); `cam.room = [160, 128]` moves screen by screen (Zelda, Metroid) and `cam.moving` is true while it slides; `cam.smooth` = lag in seconds (0: locked to the target); `cam.window = [48, 24]` a dead zone the focus moves in before the camera follows; `cam.snapY = true` follows a followed body's height only when it lands (side-scrollers); `cam.frame([p1, p2], { margin, zoom: [.5, 1] })` keeps them all in view, zooming out as they part (`frame(null)` stops); `cam.free = { keys, edge: 10, drag, speed: 300, bounds: [x0, y0, x1, y1] }` a free camera (strategy, sims): keys, a stick, the screen's edge or a drag pan it, a zoom goes toward the pointer or the pinch.\n\n## Scenes (title, play, game over)\n```js\ngame.start({ scene: 'title', scenes: {\n  title: { update(dt) { if (game.input.pressed('start')) game.go('play', { level: 1 }); },\n           draw(r) { r.sky(['#101848', '#402a70']); r.text('PRESS START', r.W / 2, 100, '#fff', { align: 'center', scale: 2 }); } },\n  play: { pausable: true, view: 'side', input: 'PLATFORMER', res: 'snes', views: ['side', 'brawler'], touch: ['jump', 'attack'],\n          enter(data) { /* build the level */ }, exit() {}, update(dt) {}, draw(r) {} }\n} });\n```\n`game.go(name, data)` switches after a short dithered fade (`game.fadeTime`: a test advances past it; `{ fade: 0 }` cuts; `{ fade: 'wipe' | 'iris' | 'mosaic' | 'swirl' | 'dissolve' | 'white', seconds: .4, at: hero }` a transition, a plain fade under reduce motion); timers (but `after(s, fn, { keep: true })`) and particles are cleared, a hit-stop ends (`timeScale` stays). `pausable: true`: Escape / P / Start pauses it, with the pause menu (below). `view`, `views`, `input`, `res`, `expand`, `touch`, `camera`, `propSize` are options applied on entry (a method so named warns). A scene is one object every visit: reset its state in `enter`. `back()` takes a phone's back gesture first (true if it went back: a sub-menu closed).\n\n## Motion and timing: tweens, scripts, paths, weather\n- Tweens (Phaser's): `game.tween(door, { y: 40 }, .5, { ease: 'outBack', delay, repeat, yoyo, onDone, keep })` eases numbers on game time: paused with the game, slowed by `timeScale`, ended by a scene change unless `keep`. Returns `{ done, cancel() }`. `E.ease` has Penner's set: `linear`, `inSine` `outSine` `inOutSine`, `inQuad` `outQuad` `inOutQuad`, the same for `Cubic`, `Back`, `Elastic`, `Bounce`.\n- Scripts (Unity's coroutines) for cutscenes, boss patterns, wave timelines, tutorials:\n```js full-script\ngame.script(function* () {\n  yield 1;                                   // seconds of game time\n  yield E.until(() => door.open);            // a condition\n  yield game.tween(boss, { y: 80 }, 1.5);    // a tween (or another script, or a generator) finishing\n  for (let w = 0; w < 3; w++) { spawnWave(w); yield E.any([8, () => enemies.length === 0]); }\n});\n```\n  `E.all([...])` waits for all; a bare `yield` waits one step. It runs at once to its first `yield`, the same at any refresh rate; `{ keep: true }` outlives the scene; `.cancel()`, `.done`, `.value`.\n- Paths: `const p = new E.Path([[x, y, z], ...], { closed, smooth: 'catmull' })`: `p.length`, `p.at(d)` (`{ x, y, z, angle }` by distance along: moving platforms, dives, rails), `p.nearest(x, y)` (a racer's progress), `p.draw(r)` to see it.\n- Weather: `game.weather = { kind: 'rain' | 'snow' | 'ash' | 'leaves' | 'sand', amount: .8, wind: .3, lightning: .2 }` (null: clear) falls through the world in every view, settles or splashes, flashes and thunders; cosmetic only (its own random stream), and it ends with the scene: set it in `enter`.\n- Wrap-around (Asteroids): `x = E.wrap(x, 0, W)`, `E.wrapDiff(a, b, W)` (the short way across the seam), and `wrap: [W, H]` on `r.sprite` or `r.actor` draws a copy across each edge.\n\n## Standard features (every game has them: don't build your own)\nWith no code: a **pause menu** on pausable scenes (Resume, Settings, Controls, Full screen, Quit to title; keys, mouse, gamepad and touch), **settings** saved per game (`game.settings`: volume, music, effects, mute, reduce motion, shake and flashes, pixel scaling, a screen filter, the frame rate and its readout), **controls** the player rebinds (conflicts said first; dead zone, invert aim and move, button symbols, vibration; touch button side, size, opacity), **full screen** (a phone's first tap, a top-right button, the menu; turning it off is remembered), a **menu button** at the top right (on a touch screen it stays in play: it is the touch START), a **way out** of every menu screen, the **back gesture** stepping back in the game (`game.back()`) before it leaves the page, **pausing** when the page is hidden or the controller unplugs, and a page set up for phones (safe areas, no scrolling, zooming or pull to refresh on the canvas).\n- Adjust: `new E.Game({ menu: { items: [['Restart', fn]], settings: [{ key: 'hints', label: 'Hints', value: true }, { key: 'difficulty', options: ['Easy', 'Normal', 'Hard'], value: 'Normal' }], controls: { attack: 'Sword', skill: false }, quit: 'title' } })`, then read `game.settings.hints`. Leave parts out: `menu: false` (your own pause), `fullscreen: 'button' | false`, `corner: false`, `backGesture: false`, `autoPause: false`, `touch: 'never'` (a phone is told a controller or keyboard is needed). `game.cornerArea()`: where the corner's buttons cover the screen (or null): keep a HUD clear of it.\n- Save slots (`game.saves`): three slots and an autosave, each with its place, level and time played. `game.saves.write = () => ({ data, place, level })` and `read = save => {...}`; then `save(slot)` (0, 1, 2 or `'auto'`), `load(slot)`, `copy(a, b)`, `erase(slot)`, `autosave()`, `list()`, `latest()` (a title's Continue). `menu: { saves: true }` (or `{ slots, version, migrate(data, from) }`) puts Save (while `saves.canSave`: a save point) and Load in the pause menu, and `saves.show('save' | 'load')` opens the screen from your own menu. Blocked storage keeps them for the visit.\n- Prompts: `game.input.label('jump')` is that action's key or button on the player's device, after rebinding ('Space', 'A', '✕'). PlayStation symbols by default: `settings: [{ key: 'glyphs', value: 'playstation' }]` (a standard key without a label sets its default). A canvas title's OPTIONS: `game.menu('settings')`. From code: `game.settings.set(key, v)`, `game.fullscreen.toggle()` (from a key, click or tap), `game.pause(reason)`, `game.resume()`. `live: true` (or `game.menu(name, { pause: false })`): menus over a world that keeps stepping (online play).\n- **Boot**: heavy setup in steps behind a boot screen, and a report for any error before play: `game.start({ scenes, scene, boot: { title, steps: [['Building the city', () => { map = build(); }]] } })` (`AI_GUIDE.md`, Boot).\n\n## Input: `game.input`\n- Actions in every preset: `up down left right` (WASD, arrows, d-pad), `start` (Enter, Start), `pause` (Escape, P, Start), `confirm` (Enter, Space, J, Z, pad A), `cancel` (Escape, Backspace, X, K, pad B).\n- DEFAULT adds `attack` (J, X, click), `dash` (Space, Shift, K), `skill` (L, E, right click), `jump` (Z). PLATFORMER: `jump` (Space, Z, K, pad A), `attack` (X, J, click), `dash` (Shift, C, L), `skill`. SHMUP: `fire` (Space, Z, J, click), `bomb` (X, K). THIRDPERSON: `sprint` (Shift), `jump` (Space), `crouch` (C, Ctrl), `interact` (E, F), `attack` (J), `block` (K), `dodge` (L), `use` (Q), `map` (M, Tab).\n- `down(a)`, `pressed(a)`, `released(a)`, `repeat(a, delay, rate)` (menus), `buffered(a, win)` + `consume(a)`, `consumeAll()`, `anyPressed()`, `move()` (screen direction `[x, y]`, length up to 1), `use(preset)`, `touchButtons(['jump', 'attack'])`, `touchSet('confirm', 'TALK', near)` (a context button: relabel it, or hide it while it has nothing to do).\n- Moves: `input.motion('236', 'attack', { facing })` is true on the step a quarter circle forward and punch ends (numpad notation, mirrored when `facing` is -1: `'623'`, `'41236'`); `input.sequence(['up', 'up', 'down', 'down+right', 'attack'], { window: .5 })` any run of inputs (a cheat code); `input.history` the last second of them (`{ t, dir, pressed }`, for an input display).\n- Players (two to four on one machine): `game.players` is `[game.input, ...]`, each an input with this API, its `player` number, `name` (`'P2'`), `color` (`E.PLAYER_COLORS`) and device. `game.allowJoin({ max: 2, onJoin: (input, n) => {} })` lets them in: Start on a free gamepad, or 2 on the keyboard (player 2 takes its right half: arrows, `.` `/` `,` and the numpad; player 1 keeps WASD with F G H; a preset's `halves: { left: { pass: ['KeyR'] }, right: {...} }` its own); `game.addPlayer({ pad: 0 })` or `({ keys: 'right' })`, `game.removePlayer(p)`. Prompts, the pause (P2 PAUSED), a lost controller and the Controls screen are per player. One screen: `cam.frame(heroes)`. Split: `game.splitScreen(2, { follow: [h1, h2], layout: 'auto' })` (`'columns'`, `'rows'`, `'grid'`; up to 4) draws the scene once per viewport (`r.viewport` is `{ i, x, y, w, h }`), then `scene.hud(r)` once over the whole screen; `game.viewports[i].follow(t)` or `.focus(x, y)`.\n- `clear()` releases held inputs, pending presses, virtual sticks and touch buttons; focus loss does this automatically. `suppress(a)` blocks an action for the current tick; `suppressCode('Mouse0')` lets a HUD widget consume that mouse button while other devices bound to the action still work.\n- Controller settings: `deadzone` (default `.18`, radial and rescaled), `invertAimY`, `lastDevice` (the index has the rest). The left stick and the touch stick, pushed past halfway, press `up` / `down` / `left` / `right` as the d-pad does (menus, dialog choices, ladders); bind `PadAxisUp/Down/Left/Right` to your own menu actions for the same; the right stick is `PadRAxisUp/Down/Left/Right`, the wheel `WheelUp`/`WheelDown`; `value(a)`: 0 to 1 (a trigger's travel, a stick's push). Options while Create is held is no press (the AI Hub's chord).\n- Touch settings: `touchEnabled`, `stickSide` (`'left'` or `'right'`), `stickRadius` (CSS pixels), `touchFilter(event)` (return false to reserve a canvas tap for UI). `touchArea()`: where the touch buttons cover the screen (`{ x0, y0, x1, y1 }`, or null): keep a prompt clear of it. `clicked()`: where a click or tap on the canvas landed (`[x, y]` in screen pixels) the step after it, else null; `pointer()`: the mouse in screen pixels; `drag()`: how far the stick's finger moved this step (`[dx, dy]`, or null), to steer one to one; `steer = 'drag'`: a finger anywhere steers, no stick drawn (`stickOn`: a finger is on it). `zones = [{ x0, y0, x1, y1, act }]` (fractions of the canvas): a finger in one holds its act until it lifts (a pinball's halves). Gestures (a mouse or one finger, screen pixels): `box()` → `{ x0, y0, x1, y1, done }` (a left drag; on touch a long press, then a drag), `longPress()`, `doubleTap()`, `pan()` → `[dx, dy]` (a finger's drag on open ground, a middle or right drag), `zoomPoint()`; `feed('down' | 'move' | 'up', x, y, { touch, button, id })` plays a pointer in a test. `bindButtons(root)` wires `[data-act]` elements.\n\n## Drawing: `r` in `draw(r)`\n- Background: `r.sky(['#top', '#mid', '#bottom'])`, `r.starfield({ count, speed, dir: 'down' | 'left' })`.\n- Depth sorted: `r.actor(x, y, z, (g, ox, oy) => rig.draw(g, ox, oy, r.view), { flash: '#ffffff', flashMix: .75, alpha, xray, outline, ghost, emissive, every, key })` (the flash tints over the sprite so shading shows: `flashMix` .5 by default, 1 solid; `every: 2, key: npc` redraws a background character every other frame; actors up to about 250 px tall), `r.sprite(x, y, z, sprite, { flip, anchor: 'bottom' | 'center', glow, flash })`, `r.queue(x, y, z, g => {...}, { bias })` (sorted by that one point: a long wall by `r.queueSpan(a, b, z, h, fn)`), `r.actorNow(...)` (as `r.actor`, drawn at once over what is drawn so far), `r.box(g, x0, y0, z0, x1, y1, z1, top, side)` (inside a queue function). `{ pick: unit }` on any of them (and `r.shape`), then `r.pick(sx, sy)` → what the last frame drew under a screen point, front to back.\n- Floor marks: `r.shadow(x, y, radius, alpha, color, surfaceZ)`, `r.decal(g => r.groundArc(...))`, `r.groundDisc`, `r.groundRing`, `r.groundPts(x, y, rad, n, z)`.\n- On top, unlit, screen pixels: `r.text(str, x, y, color, { align, scale, outline })`, `r.textAt(x, y, z, str, color)`, `r.overlay(g => {...})`.\n- `r.w(x, y, z)` = buffer pixel of a world point. `r.W`, `r.H`, `r.ix`, `r.iy` (pass to dither functions), `r.view`, `r.visible(x, y, z)`.\n- X-ray: `r.actor(..., { xray: true })` shows the actor's hidden part, a translucent tint with a 1-px outline (a checker in `E.style.trans = 'dither'`), wherever a wall, a prop or shape at least chest high (22; `hides: true | false` says otherwise) or anything queued with `{ hides: true }` is drawn in front of it; not by one rising less than 8 above its feet (the roof it stands on, a cut-down wall). `xray: { color, outline (false: none), actors: true }`: with `actors` other bodies in front hide it too (a hero stays findable in a crowd). Afterimages: `ghost: { color, life, alpha, owner }`; `owner` (the actor's `{x, y, z}`) keeps a trail left nearer the camera sorted behind the live body.\n- Glowing things you draw yourself: `r.queue(x, y, z, fn, { emissive: true })` is drawn again after lighting so darkness never dims it (flames, lasers, magic, neon). It still hides behind whatever stands in front of it: walls and `r.actor` bodies do this on their own, and any other queued draw can join them with `{ solid: true }`. (Canvas lighting builds a depth-ordered mask for this; `game.r.glowMask = false` skips it on slow machines.)\n\n## Pixels, sprites, text, UI\n- `px.rect(g, x, y, w, h, c)`, `dot`, `line(g, x0, y0, x1, y1, c, width)`, `disc(g, x, y, r, c)`, `ell`, `poly(g, pts, c)`, `polyDither(g, pts, c, 0..1, r.ix, r.iy)`, `ddisc`, `sprite(g, spr, x, y, flip)` (or `{ flip, rot, scale }`), `glow(g, 0..1)` (GPU glow for what follows).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '161,320p' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md' && cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/docs/ASSETS.md'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '161,320p' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md' && cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/docs/ASSETS.md'\"","aggregated_output":"- Sprites from strings (for coins, bullets, ships, icons, NES-style enemies): `const COIN = E.sprite(['.yy.', 'yYYy', '.yy.'], { y: '#f0b020', Y: '#fff0a0' }, scale)`. `.` and space are transparent. Frames: `const walk = E.anim([f1, f2, f3], 8, { pingpong })` (or one sheet: `E.anim(sheet, 8, { frames: 4 })`), drawn with `r.sprite(x, y, z, walk, { t })`. `r.sprite(..., { rot: angle, scale })` turns and scales in whole pixels (cached in 16 steps a turn; `steps: 32`); `E.recolor(spr, { '#3a8a4a': '#8a3a4a' })` swaps a palette.\n- Font (5x7 proportional with lower case: ASCII, the face buttons, arrows, ★ ♥ ♪ ✓ … ° € £, the accented Latin letters; any other is `?`; `font: 'tiny'` for 3x5): `E.font.text(g, str, x, y, color, { outline, shadow, gradient, scale, align, wrap, font })`, `E.font.title(g, str, x, y, { scale, colors, outline, depth, depthColor, align })`, `E.font.width(str, opts)`, `E.font.lineHeight(opts)`, `E.font.wrap(str, maxW, opts)`. Glyphs: ASCII plus `♥ ★ ← → ↑ ↓ • × ♪ ▸ ©`.\n- UI (inside `r.overlay(g => ...)`): `E.ui.box(g, x, y, w, h, { bg, border, gradient, alpha })` (a gradient window like Final Fantasy; `bg` can be `[top, bottom]`, `gradient: false` for flat, `alpha: .6` for a see-through HUD panel), `E.ui.bar(g, x, y, w, h, 0..1, color)`, `E.ui.hearts(g, x, y, hp, max)` (half hearts allowed), `rig.drawPortrait(g, x, y, size, { zoom: 3, turn: .6, bg, frame, cape: false, weapon: false, tint: '#808080' })` (character close-up; it stays upright while the rig kneels or lies down; `tint` greys out a KO'd hero).\n- Dialog: `const talk = new E.Dialog(game)`; `talk.say(['Line one.', 'Page two.'], { name: 'ELDER', portrait: elderRig, onDone, choices: ['YES', 'NO'], onChoice(i) })` (choices show on the last page: the keys, or a tap or click on one, pick); in update `if (talk.update(dt)) return;` (true while a modal box is open: play waits); in draw `talk.draw(r)`. `portrait` takes a Humanoid (live close-up; `portraitSize: 40`, `portraitOpts: { zoom, turn }`) or a function `(g, x, y, size) => {...}`. Radio chatter during play: `talk.say('Enemy fighters ahead!', { name, portrait, auto: 2.5, modal: false })` turns its pages and closes by itself while the game keeps running. Per line: `place: 'top' | 'middle' | 'bottom'`, `y` (pixels) and `alpha` (see-through box). `new E.Dialog(game, { speed, lines, color, nameColor, voice, width, bg, border, vars })` (`voice`: a sound, or `(ch, i, talk) => {}` per letter); `talk.close()`, `talk.open`. Markup in the text: `{c=#ffd36a}gold{/c}` a color, `{w=.5}` a pause, `{s=12}slowly{/s}` letters a second, `{shake}..{/shake}`, `{wave}..{/wave}`, `{$name}` a value from `say(text, { vars })` or `talk.vars`.\n- Menu: `const menu = new E.Menu(game, ['START', { label: 'LOAD', disabled: true }], { x: 'center', y: 100, title, onPick(i, item), onCancel, scale: 2, rows: 6 })` (rows: it scrolls); `menu.update(dt)`; `menu.draw(r)`. Keys, d-pad and sticks move it; a click or tap on an entry picks it (so a phone can leave a title), and the mouse over one moves the cursor. A tap on a dialog box turns its page as confirm does.\n- HTML screens and HUD: `const ui = new E.Shell(game, { theme: { scale: 2 } (a TV; or `tv: true`), settings, screens: { pause, help, dev: { rows: ['glyphs'] } } })`; `ui.show('title' | 'results' | 'map' | ..., spec)`; each step `ui.hud({ objective, status, bars, prompt, minimap })` (`minimap: { map, fog, camera: true, markers, onClick(x, y) }`); `ui.toast(title, text)`.\n\n## Sound: `game.audio` (chip synth, no files, starts after the first key press)\n- `sfx(name, { vol, pitch, pan, loop })` → `{ stop(), set({ pan, vol }) }` (a loop sounds on: an engine, rain). Presets: `jump jump2 land step coin pickup key powerup oneup heal hit hurt stomp bump swing whoosh punch kick shoot laser charge explode boom door secret warp die select confirm cancel pause text blip`.\n- Custom: `sfx({ wave: 'square' | 'pulse' | 'pulse12' | 'triangle' | 'saw' | 'sine' | 'noise', freq: 440 or 'A4', to: 880, dur: .2, vol: .3, arp: [0, 4, 7], step: .05, vib: [8, .03] })`, or `audio.define('zap', voice)`; `audio.instrument('pluck', (ctx, bus, time, freq, dur, vol) => ...)` is a `wave` too.\n- Music: `music('title' | 'adventure' | 'dungeon' | 'boss' | 'victory')` (built in; any other name warns and plays nothing), or your own `{ bpm: 120, steps: 4, tracks: [{ wave: 'square', vol: .15, notes: 'C5 - E5 - G5 . . . | ...' }, { wave: 'triangle', notes: '...' }, { wave: 'drums', notes: 'k . h . s . h .' }] }`. Tokens: a note (`C4`, `F#3`, `Bb2`), `-` holds, `.` rests, `|` is ignored; drums `k s h o c t`. `music(null)` stops. `mute()`, `setVolume(0..1)` (or set `audio.musicVolume`, `sfxVolume`, then `audio.applyVolume()`), `duck(on)` (quieter music under your own pause or map screen). Your own Web Audio connects to `audio.bus('sfx' | 'music' | 'voice')`, under the volume and mute.\n- The music clock (the full engine): a song's place is game time, headless too, and the sound follows it. `music(song, { sync: true })` pauses with the game (else it plays on); `audio.pos` → `{ t, step, beat, bar, at, loop, bpm, layers, playing }`; `at(step, fn)`, `onBeat(fn)` (on the update step); `tempo(bpm)`; `layer(name or index, vol, fade)` (a track's `name`, `on: false` starts it silent: the chase's drums in by layers); `music(song, { fade: 1 })` crossfades; `sting(song, { at: 'bar' })` over the music; `sfx(voice, { step })` on a step of the music. `settings.audioOffset` (ms, Settings, Sound: Calibrate) sets `audio.offset`; `audio.calibrate()` → `{ tap(), result, done, stop() }`.\n\n## Levels\n**TileMap** (top-down, isometric, brawler): walls stand on the ground plane.\n- `new E.TileMap({ rows, legend, types, floorTex, block: ['water', 'lava'], ao: 5, outside })` (`ao` = width of the contact shadow along wall bases, 0 = none; `outside`: the ground past the map, a color, or `false` for none). `types[id] = { h, top, side, line, course, cut: true, cutH, face, roof, beam }` (`cut` lowers walls that block the camera, those `map.isFront(cx, cy, view)` says; a map may replace it; `face`: `'brick'` (default) `'stone' 'rock' 'plank' 'timber' 'plaster' 'hedge' 'none'`; `roof`: `'speckle'` (default) `'plain' 'tiles' 'slab' 'leaves' 'grass'`; `beam` = timber color). `floorTex(x, y, floorTag, view)` returns `[r, g, b]` (or `[r, g, b, glow]`); ready-made: `E.tex.flagstone`, `grass`, `dirt`, `water`, `planks`, `checker`, `plain`. A map of more than 128 x 128 cells bakes its floor in squares as the camera comes to them and lets the far ones go (`chunks: true | false` to choose; `map.floorBytes()` what it holds), so a 256 x 256 world map costs what the screen shows.\n- Legend values: a number = wall type, a string = spawn tag, `{ tile, floor, spawn, block }` for both. `block: true` (or the map's `block` list of floor tags) makes deep water, lava or pits stop walkers (jumping bodies pass over); `walkable(cx, cy)`, `block(cx, cy, on)` (a bridge appears). FlowField paths go around blocked cells and follow `block` and `set` at their next `update`.\n- `find(tag)` / `findAll(tag)` give `{ x, y, z, cx, cy }`. Also `cell(cx, cy)`, `set(cx, cy, id)` (open doors), `toCell(x, y)`, `center(cx, cy)`, `heightAt(x, y)`, `floorAt(x, y)`, `groundAt(x, y, r, z)`, `collide(body)`, `los(x0, y0, x1, y1)` (ground only), `bounds(view)` (`{ x0, y0, x1, y1 }`, buffer pixels), `drawFloor(r)`, `queueWalls(r)`.\n\n**Heights** (collision, standing, sight, reach and navigation share one rule): a body's `z` is its feet; a cell's top is `map.height(cx, cy)` (0 = floor); a body stands on the highest top within `z + 2`. Eyes at `z + E.HEIGHTS.eye` (30) see a target at `z + E.HEIGHTS.chest` (22); a body's own `eye` / `chest` override them (crouching). Same level: `|dz| <= 8`. On a TileMap (`dir` = an angle or `[dx, dy]`): `ray(a, b, { eye, target })` → `{ clear, t, x, y, z }`, `sight(a, b)`, `standable(x, y, z, r)`, `ledge(from, dir)` → `{ x, y, z, rise, facing, edge }` (climb), `landing(from, dir)` → `{ x, y, z, d }` (a jump across a gap), `drop(from, dir)` → `{ x, y, z, fall }`, `arcClear(a, b, apex, r)`, `pick(sx, sy)` → `{ cx, cy, z, face }` (the cell under a screen point: `input.clicked()`, any view and turn). Helpers: `E.sameLevel(a, b)`, `E.targets(from, list, { range, arc, dz, sight: map })` → `[{ target, d, dz, angle }]` nearest first, `E.inArc(..., dz)`. `new E.FlowField(map, { climb, drop, jump })` paths over roofs, between levels and across gaps.\n\n**PlatformMap** (side-scrollers; 2.5D in tilted views): tiles on the x/z plane, top row first.\n- `new E.PlatformMap({ rows, legend, types })`. `types[id] = { kind, style, side, top, line, mat }` (`mat`: any material for a solid tile's face). Example: `rows: ['      ?    ', '   ===     ', '@  g   ^^  ', '###########']`, `legend: { '#': 1, '=': 2, '?': 3, '^': 4, '@': 'hero', 'g': 'walker' }`, `types: { 1: { style: 'ground', side: '#8a5a32' }, 2: { kind: 'oneway' }, 3: { style: 'bonus', side: '#e8a830' }, 4: { kind: 'hazard' } }`. Kinds: `'solid'` (default), `'oneway'` (jump up through), `'ladder'`, `'slope'` (`dir: 1` rises to the right, `-1` to the left; `from` / `to` heights 0..1 for gentle slopes), `'hazard'` (spikes, lava), `'deco'`, `'back'` (background wall). Styles: `'stone'` (`moss`) `'brick' 'wood' 'metal' 'ground'` (`flower`) `'block' 'pipe' 'bonus' 'plank' 'spikes' 'ladder' 'liquid' 'plain'`.\n- Spawns: `find(tag)` gives `{ x, z }` with z = the bottom of that cell (feet). Standing on the ground means z = the top of the floor tiles (`level.groundBelow(x, z)`, which returns `null` over a pit), not z = 0. `cell(cx, cz)` / `set(cx, cz, id)` count cz from the bottom row. `slopeZ(cx, cz, x)`, `touching(body, 'hazard')`, `cellsTouching(body, kind)`, `groundBelow(x, z)`, `solidAt(x, z)`, `move(body, dt, solids)`, `bounds(view)`, `draw(r)` (call first, after `r.sky`), `width`, `height`.\n\n## Movement and physics\n**Platformer** (side-scroller character): `const hero = new E.Platformer({ x, z, w: 8, h: 22, run: 95, jump: 285, gravity: 800, airJumps: 0, wallJump: false, dash: 0 })`.\n- Each update: `hero.update(dt, level, game.input, movingPlatforms)`. For enemies pass `{ x: -1..1, jump, jumpPressed, up, down, dash }` instead of the input.\n- Read: `onGround`, `jumped`, `landed`, `facing` (1 or -1), `air`, `climbing`, `hitWall`, `hitCeiling`, `bumped` (`{ cx, cz, id }` of a block hit from below). Methods: `knock(dir)`, `rigState(extra)` (feed it to `rig.update`).\n- Built in: coyote time, jump buffering, variable jump height (let go early for a short hop), slopes and small steps (sticks to the ground going down), ladders (up / down), drop through one-way tiles (down + jump), optional double jump, wall jump and dash.\n- Further moves, each on request: `crouch` (down: half as tall, it crawls), `ledge` (catches a ledge falling past it; up climbs), `wallCling`, `momentum` (slopes, a roll, a charged dash); tile kinds `'water'` (it swims), `'rope'` (up grabs it), `'bars'` (it hangs and travels), grip `friction` (ice .15), `carry` (a conveyor), `bounce` (a spring), `crumble` and `respawn` (`level.update(dt)` each step); `hero.swingFrom(x, z)` (a grapple: a pendulum, jump lets go); draw `level.drawWater(r)` after the actors. State: `crouching`, `hanging`, `clinging`, `swimming`, `onRope`, `onBars`, `swinging`, `rolling`; `rigState()` poses them.\n- Moving platforms: `{ x, z, w, h, vx, vz }` boxes you move yourself and pass as `solids`; riders are carried.\n\n**Body** (top-down / isometric / brawler): `new E.Body({ x, y, r: 5, friction: 0, bounce: 0, gravity: 700 })`. Set `vx`, `vy`, then `body.update(dt, map)`. Also `push(ix, iy, iz)` (knockback), `jump(v)`, and `onGround`, `z`, `groundZ`, `hitWall`, `landed`, `bounced` (hit the ground and bounced: dust, a thud). Walls lower than your feet are walkable, so bodies can jump onto blocks.\n\n**Mover** (third person): `const mover = new E.Mover({ x, y })`; `mover.update(dt, map, game.input)` (input `'THIRDPERSON'`) or an AI's `{ move: [dx, dy], sprint, crouch, jumpPressed }`: it sprints, sneaks, climbs, vaults, leaps gaps, hops down and rolls; `climbAny: true` climbs any wall (jump at it; up the screen is up the wall; jump leaps up, crouch lets go; `mover.wall`, `map.wall(from, dir)`), `glide: true` glides (jump again in the air; `lift`: an updraft), `staminaMax: 100` (climbing, gliding and sprinting spend `mover.stamina`); `rig.update(dt, mover.rigState())`; `mover.play('takedown', { other })`, your own `E.ACTIONS`. Stealth: `E.sees(guard, hero, { map })` → `{ seen, exposure }`, `E.hears`, `new E.Suspicion()` (`update(dt, seen, hero)` → `'calm' | 'notice' | 'search' | 'alert'`), `r.sightCone(guard, { map })`, `r.marker(x, y, z, { label })`.\n\n**Attack** (melee timing for swords, punches, kicks): `const slash = new E.Attack('slash')` (a move from `E.MOVES`, optionally with overrides: `new E.Attack('thrust', { reach: 10 })`) or a spec `{ a0, a1, z0, z1, reach, wind, active, recover }`. `if (input.buffered('attack') && slash.start()) input.consume('attack')`; `slash.update(dt)` (returns the phase that just began); `slash.hits(enemies, e => E.inArc(hero, facing, e, 22, 1.4), e => {...})` hits each target once per swing during `'active'` (moves wait until `hitAt: .35` of the swing, so hit-stop freezes the strike, not the wind-up); `rig.update(dt, { ..., attack: slash.state })`. Also `busy`, `active`, `cancel()`. **Combo**: `const combo = new E.Combo(['jab', 'cross', 'hook', 'uppercut'], { window: .3 })` (names, specs or Attacks); `combo.press()` starts or chains the next hit; `update`, `hits`, `state`, `step` work the same. **Knockback**: `E.knockback(attacker, target, 160, up)` pushes a Body (or anything with vx / vy) away.\n\n**Bullets**: `const shots = new E.Bullets(game, { plane: 'ground' | 'side' })`; `shots.fire({ x, y, z, vx, vy, vz, r: 2, team: 'player', color, life, dmg, pierce, sprite })`; `shots.burst(base, E.pattern.spread(angle, n, arc, speed))`; `shots.update(dt, map)`; `shots.hit(targets, (b, t) => {...}, 'player')`; `shots.draw(r)`; `shots.clear(team)`. Patterns: `E.pattern.dir(angle, speed)`, `aim(a, b, speed)`, `aimSide(a, b, speed)`, `spread(angle, n, arc, speed)`, `ring(n, speed, offset)`. In side view the second number of a pattern velocity is vz.\n\n**Helpers**: `E.dist(a, b)`, `E.angleTo(a, b)`, `E.arc(a, b, gravity, { apex | time | speed })` → `{ vx, vy, vz, t }` (a throw that lands at b: a lob, a grenade), `E.overlap(a, b)` (circles x, y, r), `E.overlapBox(a, b)` (side boxes x center, z feet, w, h), `E.inArc(a, facing, b, range, halfAngle, dz)` (melee cone; `dz` limits the height difference), `E.rand(a, b)`, `E.randInt(a, b)`, `E.pick(list)`, `E.chance(p)`, `E.prune(list, fn)`, `E.store.get(key, fallback)` / `set(key, value)` (save data; slots: `game.saves`), `new E.SpatialHash(32)` (`build(list)`, `near(x, y, r, fn)`), `new E.FlowField(map)` (`update(tx, ty)` or `update([[x, y], ...])`: the nearest; `dir(x, y, tx, ty)` walks around walls and `map.solid` shapes), math `clamp lerp approach ease.* angDiff approachAng smoothDamp rng(seed) noise2 hex shade mix`; `E.version` (the release) and `E.versionLabel()` ('v0.7.0 · a1b2c3d 2026-10-07': show it on a title or a debug screen).\n\n## Characters\n**Humanoid** (knights, heroes, soldiers, zombies): `new E.Humanoid({ size: 1.3, build: 'chibi' (default) | 'heroic' (tall) | 'bulky' (brawlers, bosses) | 'skeleton' (tint with colors.bone), weapon: 'sword' (the default) | 'gun' | 'staff' | null (fists) | a game's own (`E.Humanoid.weapon(id, { length, rest, draw(w) })`; `.hat(id, draw)`, `.pose(id, (J, w) => ...)`; `draw: { under, over }`; state `tilt`, `roll`), outfit: 'shirt' | 'tunic' | 'robe' | 'coat', hair: 'short' | 'spiky' | 'long' | 'ponytail' | 'bald', hat: 'cap' | 'pointed' | 'helmet' | 'band' | 'crown' (or { style, color }), sleeves: 'short' | 'long' | 'none', armor, hood (in colors.hair), cape: { len: 6, width: 5, seg: 2.5 }, eyeGlow, hunch, lean, style: 'hd' (default) | 'classic' (stick figures for huge crowds), colors: { skin, hair, cloth, coat, pants, boot, belt, trim, glove, cape, capeIn, metal, plate, hilt, eye, iris } })` (`metal` colors the weapon, `plate` the armor, defaulting to `metal`).\n- `rig.update(dt, { x, y, z, vx, vy, facing, dash, hurt, air, point, aim, attack })`. `facing` is an angle (side view: 0 = right, `Math.PI` = left). `air: true` tucks the legs for jumps; `point: true` holds a gun forward; `aim` tilts it (radians, + = up: `aim: .8` shoots diagonally up, `Math.PI / 2` straight up).\n- **Moves** (`E.MOVES`, use them instead of hand-made specs; every one has anticipation, a committed strike with lunge / step / lean / twist, follow-through and a clean return to the stance, on every build and in every view):\n  - blades and clubs: `slash backslash overhead rising thrust spin plunge twohand`;\n  - fists: `jab` (left hand) `cross hook uppercut haymaker elbow`;\n  - kicks: `kick roundhouse sweep flyingkick knee axekick`;\n  - other: `cast` (both hands) `throw bash claw`.\n  Give each character its own set (a knight: `overhead`, `thrust`, `spin`; a mage: `cast`; a monk: `jab`, `cross`, `roundhouse`; a boss: `haymaker`, `sweep`). `E.move('uppercut', .5)` is the attack state of any move at any moment (previews, cutscenes).\n- `attack: { spec, phase: 'wind' | 'active' | 'recover', u: 0..1 }`, spec `{ a0, a1, z0, z1, reach, r0, r1, hand, rel, blade, spin, kick, plane, lunge, hop, crouch, lean, twist, hold }`. Angles are relative to facing (+ = right hand side). `rel: true`: heights relative to the shoulder and reach scaled by arm length (kick heights as a share of hip height). `r0`/`r1`: reach that extends (thrusts, jabs). `hand: 'L' | 'both'`. In side views horizontal swings turn into the screen plane (a Castlevania chop) by themselves; `plane: 'side' | 'ground'` (or the rig option `swingPlane`) chooses. `lunge` steps into the strike (body motion in local units, clamped to -4..5; to move the character itself, add speed to your body), `hop` lifts the body, `crouch` dips in the wind-up, `hold` is how long the end pose holds (share of recover). You time the phases.\n- In steep ground views (threequarter) rigs and Blobs are drawn from a lower, sprite-like angle so faces show, like SNES RPG sprites (`charView: false` turns it off for one rig, `E.style.charPitch = false` for all).\n- Faces (eyes with catch-lights, brows, mouth), a cheated 3/4 turn toward the camera in side views (`cheat: .5`, 0 turns it off) and hair layers are automatic. `face: { eyes: 'big' (anime / Mana style), bangs: 0..1 }`.\n- Poses: `rig.update(dt, { ..., pose: 'cheer' | 'cast' | 'guard' | 'kneel' | 'crouch' | 'wave' | 'hips' | 'down' })` (they blend in and out), `'block'` (weapon upright across the body), `'die'` (a stagger, then the body topples), `expr: 'smile' | 'shout' | 'angry' | 'wince'` (faces and portraits), `run: 0..1` (run in place), or `down: 0..1` to lie a defeated body flat. `stance: 'guard'` keeps fists up while walking (brawlers; the free hand guards the chin during punches), `stance: 'ready'` holds the weapon forward. `climb: true` with `vz` climbs a ladder hand over hand (`Platformer.rigState()` passes both). Traversal: `crouch` (a sneaking gait), `sprint` (a lean), `hang` with `hangZ` (hands on an edge that high above the feet), `flip: 0..1` (a roll), `land: k` (a heavy landing); `mover.rigState()` sets them. Every wind-up starts from the rig's current pose, so chained hits and hand changes never snap. Idle rigs breathe and shift their weight by themselves.\n- `rig.draw(g, ox, oy, view)` inside `r.actor`, `rig.drawSmear(r)` (a glowing trail along the real blade, fist or foot path, in every view), `rig.debug(r)` (skeleton), `rig.kick(v)` (squash and stretch), `rig.hand()` and `rig.tip()` (world points to spawn bullets from), `rig.worldOffset(p)` (where a point in the rig's own frame, such as a joint in `rig.J`, sits from its feet: to draw or spawn at any joint), `rig.lastView` (the view it last drew with), `rig.solvePose()` (sets `rig.J` from its state each step: wrap it on one rig to move joints).\n**Blob** (slimes, rabbites, bats, imps, round monsters): `new E.Blob({ R: 6, colors: { dk, base, lt, spec, eye, pupil }, ears: 'rabbit' | 'cat', horns: true, wings: true, feet: true, tail: true, mouth: true | 'fangs', face: 'front' })`, `update(dt, { squash: -0.4..0.4, look: [dx, dy], squint, walk: 0..1, flap: 0..1 (wing speed; 0 folds them), hang: true (roost upside down) })`, `kick(v)`, `draw(g, ox, oy, view)`. Mix the parts for a bestiary: `wings` + `mouth: 'fangs'` is a bat, `ears: 'rabbit'` + `feet` a Mana rabbite, `horns` + `tail` an imp.\n\n## Effects and lighting\n- Particles: `game.particles.explosion(x, y, z, size)` (fireball, smoke, sparks, debris, ring, shake, sound), `fire(x, y, z, n, { size })`, `smoke(x, y, z, n, { size, color })`, `glints(x, y, z, n, color)`, `dust(x, y, z, n)`, `sparks(x, y, z, n, angle)`, `bits(x, y, z, n, colors)`, `ring(x, y, r0, r1, color, dur)`, `text(x, y, z, '12', color, { scale: 2, bounce: true })` (bouncing damage numbers), `add({ kind: 'dust' | 'spark' | 'bit' | 'ember' | 'fire' | 'smoke' | 'glint', ... })`. `explosion(x, y, z, size, { debris, freeze: false, shake: 0 })` for chains of small blasts. Side-scrollers: `particles.ground = (x, y, z) => level.groundBelow(x, z)` so sparks and debris bounce on platforms. Screen flash: `game.flash('#ffffff', .12, strength 0..1)`.\n- Lighting (step 9; every view, side-scrollers included, no WebGPU needed): `game.lights.add(x, y, z, radius, intensity, { color: '#ffa050' })` every draw. Dark areas get a smooth cool tint, lights add their own color, and emissive items (flames, sparks, bullets, `emissive: true`) stay bright. `lights.darkness` (0..1) and `lights.tint` tune it; after setting `lights.dark = [r, g, b]`, `levels` or `glow`, call `lights.refresh()`. Props with flames can light the scene: `r.prop('torch', x, y, z, { light: true })`. Lamps, street lamps, lanterns and crystals glow on their own (`haloR`, `haloColor`, `halo: false`); `cone: true` adds a light cone under a street lamp.\n- Hits: `game.hitFx(x, y, z, { power: 1, angle, damage: 12, textScale: 2, textZ: 22 })` does hit-stop, shake, an impact star, sparks, a bouncing damage number (`bounce: false` floats it) and a sound in one call; `particles.impact(x, y, z, size, color)` for the star alone.\n- GPU lighting (optional, ground views with a TileMap): `const gpu = game.enableGPU({ map })`; mark glowing things with `px.glow(g, 1)`; add `lights.caster(x, y, r, top)` and `lights.heat(x, y, z, w)`. Where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with `game.lights.ambient` (`gpu.fallback = false`: unlit).\n\n## Genre playbook (NES, SNES, Genesis, N64, PS1)\n| Genre (examples) | View | Build it with | Copy slice |\n|---|---|---|---|\n| Platformer (Mario, Mega Man, Sonic, Castlevania) | `side` (+ `brawler` for 2.5D) | PlatformMap, Platformer, Humanoid, sprites, Bullets `'side'` | PLATFORMER |\n| Metroidvania (Metroid, Symphony of the Night) | `side` | an `E.World` of PlatformMaps (the rooms module: doors at open edges, a slide, the explored map, gates opened by abilities, saves), a Platformer given `airJumps` and `dash` as they are found, its further moves, an arm cannon aimed eight ways (`point`, `aim`, `rig.tip()`, Bullets) | METROIDVANIA |\n| Action adventure (Zelda, Secret of Mana) | `threequarter` or `topdown` | TileMap rows, `cam.room`, Body, Humanoid + `E.Attack` sword, Dialog, `E.ui.hearts` | ADVENTURE |\n| Point-and-click adventure (Monkey Island, Day of the Tentacle, Broken Sword) | none: rooms painted in screen pixels (`r.overlay`) | `E.Click` (the click module): rooms with walk areas and holes (`E.Walkbox`), depth scale, hotspots, the nine verbs, Sierra's icons or a verb coin, an inventory, puzzles as rules; talk through `E.Story` | POINT-AND-CLICK |\n| Visual novel (Phoenix Wright, Snatcher, Clannad) | none | `E.Story` nodes and choices over a painted backdrop, `rig.drawPortrait` at size, `story.log` (the backlog), `story.auto`, `story.skip`; `game.saves` | POINT-AND-CLICK |\n| Action RPG / dungeon (Diablo, Landstalker) | `iso` | TileMap, FlowField, Body (jump onto blocks), GPU lighting | ADVENTURE |\n| Beat-'em-up (Final Fight, Streets of Rage, TMNT) | `brawler` | TileMap street strip, Body, Humanoid (`weapon: null`) + `E.Combo` punches and `kick: true` kicks, `E.knockback`, waves that lock the screen; a second player drops in (`game.allowJoin`, `cam.frame` on both) | BRAWLER |\n| Fighting (Street Fighter II, Darkstalkers) | `side` | two `E.Fighter`s in an `E.Match` (the fight module): moves with frame data, guards, throws, specials by motion (`'236'`) or charge, a meter, projectiles; `E.FightAI`, `E.FightSelect`, training | FIGHTING |\n| Shoot-'em-up (1942, Gradius, R-Type) | `overhead` (vertical, and horizontal: world x scrolls) | sprites, Bullets, `E.pattern`, a timeline of waves; horizontal: rock edges as functions of x, a power bar, options on the ship's past path, `E.Path` loops; `E.Arcade` for the continue and the table | SHOOTER (both stages) |\n| Pinball (Pinball Fantasies, Space Cadet, Devil's Crush) | a steep table view of its own (`new E.View('pinball', 'Table', 0, 62, 1, 1)`) | `E.Physics`: chains for the walls, `flipper`, `bumper`, `slingshot`, `kicker`, a ramp on a layer of its own, the ball a `bullet`; `input.zones` flip on a phone; `E.Arcade` for the score and table. Breakout and Asteroids with real collisions are its recipes | PINBALL |\n| Artillery (Worms, Scorched Earth) | `side` at a whole scale (`new E.View(id, label, 0, 0, 1, 1)`) | `E.Terrain` (`carve` the blasts, `walk` the soldiers, `ray` the shots), grenades as `E.Physics` bodies on `land.collider()`, `E.Turns`; a drag aims (`steer = 'drag'`, `drag()`, `stickOn`); a CPU tries its shots in simulation | ARTILLERY |\n| Golden-age arcade (Pac-Man, Galaga, Asteroids) | `overhead` (one fixed screen, cabinet art on the sides) | `E.Arcade` (score, lives, extra lives, turns, initials, tables, attract mode); a maze of `E.GridMover`s; moths on `E.Path`s turned by `rot`; `E.wrap` and `wrap: [w, h]` | ARCADE |\n| Twin-stick / run-and-gun (Smash TV, Contra) | `topdown` / `side` | Body or Platformer, Bullets, `weapon: 'gun'`, `point: true` | SHOOTER + ADVENTURE |\n| JRPG (Dragon Quest, Final Fantasy, EarthBound) | `threequarter` town, `brawler` battles | TileMap towns and a big world map, the story and rpg modules, Dialog with markup, `game.saves` slots | RPG |\n| Puzzle (Tetris, Dr. Mario, Puyo, Columns) | `side` (a field in screen pixels) | a cell array, a bag from `E.rng`, `input.repeat` (auto-shift), `grid.groups` (chains), `input.drag()` and `clicked()` for touch; versus: two fields, rows sent across (`game.players`) | PUZZLE |\n| Roguelike (Rogue, Mystery Dungeon, Shiren) | `threequarter` / `iso` | `E.gen` floors, a TileMap of its rows, `E.Grid.from(map)` paths and `fov`, `E.Fog`, `E.Turns` by speed, `game.tween` steps | ROGUELIKE |\n| Tactics (Final Fantasy Tactics, Tactics Ogre, Fire Emblem) | `iso`, turned a quarter | TileMap of block heights, `map.pick` under the cursor, `E.Grid.from(map, { tops: true })` reach over heights, `grid.shape`, `grid.side`, `grid.threat`, `E.Turns` charge time, `E.Story` | TACTICS |\n| Real-time strategy (Warcraft II, StarCraft, Dune II) | `iso` | `E.Strategy` (the strategy module): kinds as data, selection by click, box and group, orders, gold, building, training, fog, an AI's build order and waves; `cam.free`, `{ pick: unit }` and `r.pick`, buildings as `E.SHAPES`, E.Shell's minimap; bodies drawn `every: 3` | RTS |\n| Theme park or city sim (Theme Park, RollerCoaster Tycoon, SimCity) | `iso` | paths as floor tags walked on an `E.Grid`, agents with `E.needs` picking by `E.choose`, `E.Clock` days and light, `game.timeScale` 0 to 4, `E.overlay`, `E.tooltip`; rides as shapes stepped through angles (`params`, `facing`) | SIM |\n| 3D platformer or adventure remake (Mario 64, Ocarina, Crash) | `iso` / `threequarter` / `brawler` | TileMap blocks of different heights + Body `jump()` (z is real height); in real 3D: `E.World3D` (the 3D engine's manual), `camera.lock` | ADVENTURE; 3D ACTION, 3D PLATFORMER |\n| Survival horror (Resident Evil, Alone in the Dark) | the 3D engine's `'zones'` camera | `camera.zones` (fixed cameras by room), `camera.steer` (tank controls), `camera.lock` to aim, `world.through` doors, `world.flashlight`, fog; `E.RPG` inventory, `game.saves` | 3D HORROR |\n| First-person dungeon (Wizardry, Dungeon Master, Eye of the Beholder) | the 3D engine's `'fixed'` camera at the party's eyes | cells of 2 x 2 tiles stepped and turned a quarter at a time (tweened), `E.Grid` paths for the monsters, `E.Turns` `'atb'` (real time) or `'speed'` (turns), `E.Fog` for the automap, `world.thing('door')` gates and `world.unlock`, `rig.drawPortrait` for the party | 3D CRAWLER |\n| Rhythm (Dance Dance Revolution, PaRappa, Beatmania, Space Channel 5) | any (a highway on the overlay) | `E.Rhythm` (the rhythm module): a chart of lane strings in parts on a song's steps, judged in ms of the music clock, combo, life, grade, holds, calls a teacher plays and you answer, `rh.draw` (`arrows: true`); the songbook's songs (`E.Songbook`); lanes as `input.zones` on a phone; `audio.onBeat` moves the dancer | RHYTHM |\n| Sports (Sensible Soccer, NBA Jam) | `threequarter` / `topdown` | the ball an `E.Body` (`bounce`; curl: turn its velocity across its path), passes led to the teammate, `E.arc` for a lob, a shot's meter, formations by where the ball is, `game.allowJoin({ max: 4 })` | SPORTS |\n| Third-person stealth (Assassin's Creed, Metal Gear, Tenchu) | `iso` / `threequarter` | TileMap roofs, Mover, `E.sees`, `E.Suspicion`, FlowField `jump` | STEALTH |\n| Kart racing (Super Mario Kart, F-Zero) | Mode 7 (the mode7 module, over any view) | `E.Mode7` over a TileMap track (floor tags: grass, sand, boost), `E.Car` karts (`kart: true`: hop, drift, boost) in an `E.Race` round an `E.Path` (laps, checkpoints, drivers, items), rigs in karts as billboards, `game.splitScreen(2)` for two | KART |\n| 3D kart racing (Mario Kart 64, Crash Team Racing) | the 3D engine's `'behind'` camera | `world.track` (banked, walls, pads, `gaps` for a shortcut), `world.vehicle` karts raced by `E.Race`, split screen through `world.cameras` | 3D RACING |\n| Rail shooters (Star Fox 64, Panzer Dragoon) | the 3D engine's `'behind'` camera | `world.flyer` on rails or free in bounds, rolls (`f.rolling`) turn shots aside, `f.seek` for a charged lock, `Dialog`'s radio | 3D FLIGHT |\n| Road racing (OutRun, Pole Position, Road Rash) | the pseudo-3D road (the road module) | `E.Road` segments (curves, hills, tunnels), scenery and traffic placed on it, `curveAt` throwing the car outward, a clock and checkpoints | ROAD |\n| Top-down racing and driving (Micro Machines, RC Pro-Am, GTA) | `topdown` / `iso` | `E.Car` on a TileMap (its floor tags slow it, its walls bounce it), `E.Race` for laps and drivers, cars drawn with `px.poly` on `r.w()` corner points | KART |\n| First-person shooter (Doom, GoldenEye 007, Apex Legends) | the 3D engine's first person (or third) | a level of text rows or a terrain, `world.ray` hitscan, recoil and reloads, doors (`world.thing('door')`), raiders on `world.flow()` | 3D SHOOTER |\n| Bomberman, Frogger, Sokoban, Gauntlet, Robotron; Sonic, Prince of Persia; light guns | as the recipe says | `AI_GUIDE.md`'s Genre recipes: each on the kit closest to it | (a recipe) |\n\n**Sizes:** heroes 40-60 px tall at 320x240 (`size: 1.2-1.4`), bosses 1.8-2.4. Small things (coins, bullets, ships, pickups) are string sprites designed at 8-16 px, drawn at scale 2 if they are the player's ship. Keep hitboxes smaller than the art.\n\n**Feel numbers** (world units per second, tile = 16): walk 70-90, run 95-140, jump 250-320 with gravity 800, fall cap 330, dash 200-260, bullets 250-320 (player) and 70-120 (enemy), enemy walk 25-45. Hit feedback: `game.hitFx` (Effects).\n\n## More: animation and examples outside this card\nThe repo (github.com/michaelcrosato/my-3d2dge; any file at `https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/main/<path>`) holds more to take from. Its files are large: search them and take only what the game needs. Real 3D (`E.World3D`: first person, racing, flight) is there: `engine/my-3d2dge-3d.js`.\n- **Motion clips**: 325 curated and 2,548 motion-capture takes that play on any Humanoid: find one in `src/mocap/catalogs/`, cut a small set with `tools/anim-set.mjs`, then `Mocap.drive(rig, lib)` (`AI_GUIDE.md`, Where to find more; `docs/MOCAP.md`).\n- **Objects and materials** (full engine): `r.shape('barrel', x, y, 0, { facing })` draws a still object from any view and facing, `map.solid(...)` makes it solid; `E.MATERIALS` dresses floors (`floorMat`), walls (`face`, `roof`) and platform tiles (`mat`). `docs/ASSETS.md` is the card: the format, the library, writing one and checking it with `node tools/asset-sheet.mjs`.\n- **Worked examples**: Emberdeep (`src/emberdeep/`), a whole game on this engine: 29 monster, boss and dummy bodies, 3 heroes and 30 skills, registered with `def(kind, id, spec)` (one search lists them); adapt them, they lean on the game's own helpers. `docs/CHARACTERS.md` is the recipe for a new body.\n- **Modules** (`engine/modules/<name>.js`; `modules/` in the handoff package): general systems in files of their own, each a `<script>` after the engine, its header its manual (read it there, or its section of the index). A kit carries the modules its slice names (`@modules` in its header); the full engine (`dist/my-3d2dge.js`; `my-3d2dge.js` in the handoff package) carries them all.\n  - `grid`: square and hex grids: A* paths, move ranges over heights and past allies, fields of view, `E.Fog`, groups, shapes of effect, threat maps, `E.GridMover`, `E.Turns` (speed, charge time, phases, ATB). ROGUELIKE, PUZZLE, TACTICS, ARCADE, ARTILLERY, RTS, SIM, 3D CRAWLER.\n  - `gen`: generated maps from a seed: rooms and corridors, BSP, caves, mazes, Poisson scatter, as ASCII rows a TileMap reads. ROGUELIKE, ARCADE.\n  - `fight` (the full engine only): one-on-one fighting: `E.Fighter` (frame data, hurt boxes from the rig's joints, guards, throws, cancels, juggles, specials by motion or charge, a meter, projectiles), `E.Match` (rounds, KO, the HUD, training), `E.FightAI`, `E.FightSelect`. FIGHTING.\n  - `rooms`: a world of rooms on a grid of screens (`E.World`): walking between them at open edges, the explored map (`drawMap`, or `shellMap()` for `E.Shell`), gates that abilities or keys open, saves in `E.store`. METROIDVANIA.\n  - `mode7`: the SNES's Mode 7 (`E.Mode7`): a camera over a flat floor (a TileMap's, a function's or a canvas), a turning sky, billboards far to near (rigs, sprites, shapes, your drawing), fog, `project` and `toFloor`, split screens. KART.\n  - `road`: the pseudo-3D road (`E.Road`): segments with curves and hills, lanes, rumble strips, tunnels, scenery and cars scaled by distance and hidden past a crest, the sky's parallax on curves. ROAD.\n  - `drive`: cars on the ground plane (`E.Car`: grip and slide, a kart's hop and drift boost, floor tags, walls and cars it bounces off) and races (`E.Race`: checkpoints along an `E.Path`, laps, places, drivers that pass and rubber-band, items, the HUD; the 3D engine's `world.vehicle` too). KART.\n  - `story`: dialogue as data (`E.Story`): lines with speakers and portraits, choices with conditions, flags and values, gotos, the game's events, a quest log, balloons over heads, a backlog, auto and skip; its state for a save. RPG, POINT-AND-CLICK, TACTICS.\n  - `rpg`: a role-playing game's rules (`E.RPG`): items, bags (slots or a grid of sizes), members with stats, levels and gear, status effects, a party (items used, rewards shared), shops, damage, random encounters by zone, list and card windows. RPG, 3D HORROR.\n  - `strategy` (the full engine only; needs `grid`): `E.Strategy` for real-time strategy (selection by click, box and group; queued orders; formations; production, resources, placement; fog, the minimap; an AI's build order and waves) and for sims `E.Clock` (days, the light), `E.needs` and `E.choose`, `E.overlay`, `E.tooltip`. RTS, SIM.\n  - `click` (the full engine only): point-and-click adventures (`E.Click`): painted rooms, walk areas with holes (`E.Walkbox`), depth scale, hotspots with verbs, SCUMM's nine verbs, Sierra's icons, a verb coin or two buttons, an inventory, rules as data, exits, `story`'s talk; taps on a phone. POINT-AND-CLICK.\n  - `physics`: 2D rigid bodies (`E.Physics`): circles, boxes, polygons, segments, chains and arcs; bounce, friction, sensors, layers, sleep; fast balls swept, never passing through; the same world at any refresh rate; flippers, bumpers, slingshots, kickers. PINBALL, ARTILLERY.\n  - `terrain`: destructible ground in the side plane (`E.Terrain`): carved and added by circles and polygons, the ground below a point and its normal, rays for shots, walkers on slopes, a collider for `physics`. ARTILLERY.\n  - `songs`: the songbook (`E.Songbook`): songs by mood (field, town, battle, race, horror, chase, dance ...) and jingles (stage clear, game over, level up); `get(id)`, `find(mood)`. RHYTHM.\n  - `rhythm` (the full engine only): `E.Rhythm`: charts on a song's steps, judgments in ms of the music clock, combo, score, a life gauge, grades, holds, call and response, a note highway in any direction. RHYTHM.\n  - `arcade`: the coin-op's frame: scores that float up, extra lives, two players taking turns, credits and a continue, high-score tables with initials on a letter wheel, stage cards, the attract mode (a demo, the table, the title). ARCADE, SHOOTER, PINBALL.\n- **Everything running**: https://my-3d2dge.vercel.app/labs\n\n## Before you hand the game back\n- One IIFE starting with `const E = My3D2dge` (between the markers in a single file; `game/game.js` in the handoff package). Only your game: no leftover starter menu or unused slices. No network, no libraries.\n- Title screen and game-over screen as scenes; `pausable: true` on gameplay scenes. No pause, settings, rebinding or full-screen code of your own (they're standard); prompts from `game.input.label(action)`.\n- The camera follows the player (`game.focus` every update) and shows the level; the HUD uses screen pixels, or `E.Shell`'s HTML for a modern game (the STEALTH kit; the handoff package's template).\n- Sound effects on jump, hit, pickup and death; music per scene.\n- The look target list above: backdrop, textured tiles, props, sized and dressed HD characters, effects, title font, lights. Compare your screenshots with Symphony of the Night or Metal Slug, not with NES games.\n- If you can run commands: `node tools/check.mjs game/index.html` (your page; add `#scene` to jump to a scene). It presses start, plays, cycles the views, prints how much of the screen is filled and how many colors it uses, adds look notes (flat areas, checkerboard dithering, low contrast, a thin palette), and fails on any error. Act on every look note. `node tools/filmstrip.mjs game/index.html#scene --steps \"wait:1500 press:Enter wait:800 rec:16:2 press:KeyJ\" --crop x,y,w,h` records an animation frame by frame into one contact sheet: check every attack with it (a swing must wind up, strike, and settle back without jerks or backward sweeps).\n- Animation variety: every character has its own moves from `E.MOVES` (not one shared swing), enemies telegraph with a visible wind-up, and reactions play out (hurt, knockback, `down`, victory `cheer`).\n# Objects and materials as data\n\nThe full engine draws still objects (barrels, tables, trees, wells) from a few lines of data, in every view and facing,\nwith the house shading and outline, and gives every surface (floors, wall faces, wall tops, platform tiles, the objects'\nown faces) a material from one open registry. An object costs one to a few hundred tokens of data (the core's median is\n125); you check it headless with one command. Read this card whole before you write one. (The agent edition keeps the\nregistries and ignores the calls: `E.addAssets` returns empty lists, the others null.)\n\n## Use one\n\n```js\n// in draw(r): feet on the point, depth sorted like an actor; its front toward facing\nr.shape('barrel', x, y, 0, { facing: Math.PI / 2 });\n// once, before the updates: bodies stop at it, a body coming down lands on it, one wholly below passes under\nmap.solid('table', 120, 80, 0, { facing: 0 });\n// a sprite of it, for an inventory or a HUD (r.sprite, px.sprite)\nconst icon = E.shapeSprite('chest', { view: 'iso' });\n```\n\n- **r.shape options:** facing (radians, where the front points: 0 east, π/2 south, as written), scale, mats ({ slot:\n  material }), flip (mirrors it x to -x, collision too), params (a generator's: { h: 30 }), bias, hides (default true),\n  light (adds its lights to game.lights), shadow (default true).\n- **map.solid** takes the same id and placement, so one object can feed both calls. Bodies span z to z + h (E.Body's h, 32).\n- **In 3D** the 3D engine draws the same entries, materials and boxes: `world.shape(id, x, y, z, o)` (its header).\n- **Steep views** (top-down) draw shapes from the characters' lower angle, as rigs are drawn. The light comes from the\n  viewer's upper left in every view.\n- **Glow and fire:** a material with glow: 1 ignores the light and stays bright in the dark; an entry's flames ([[x, y, z,\n  w, h]]) draw the engine's animated flame (r.shape only: a sprite has none). Anything else that moves stays a prop\n  (r.prop) or your own code.\n- **Dressing a generated level:** a scene is a few entries as [id, across, forward] from an anchor (a wall spot, forward\n  into the room); place it whole or not at all, each part on free floor, after the level's own random picks and from a\n  seeded stream of its own, so the level stays as its seed builds it (Emberdeep's `src/emberdeep/53-scenes.js`).\n\n## The core library\n\n**Shapes** (sized for a 26-unit hero; generators take params): barrel, crate, chest, table, chair, stool, bench, bed,\nbookcase, shelf, pot, jar, sack, cart, well, sign, lamppost, anvil; fence { len: 16 }, pine { h: 41, tiers: 4 },\ntree { h: 40, seed: 1 }, bush { r: 7 }, grass { h: 6, n: 6 }, rock { r: 7.5, seed: 2 }, crystal { h: 18, seed: 1 }.\n`r.shape('pine', x, y, 0, { params: { h: 30 } })`; `E.SHAPES.barrel.about` says what each is.\n\n**Materials:** woods oak walnut birch crate plank planks wood; stones stone cobble marble granite sandstone slate rock\nbrick flagstone ruin; metals iron steel gold copper bronze metal rusted; clay glazed porcelain; cloth linen burlap wool velvet leather;\nplants bark needles leaves shrub moss straw hedge grass; ground dirt sand snow mud; water ice crystal flame bone shingle;\nwalls timber plaster; tops speckle plain tiles slab; tiles block bonus ground pipe checker.\n\n## Materials on surfaces\n\n```js\nE.MATERIALS.mossy = { color: '#6a7a5a', pattern: 'stones', size: 6 };   // or the shorthand '#6a7a5a stones size=6'\nconst types = { 1: { h: 32, top: '#6a6280', side: '#4a4360', face: 'cobble', roof: 'slate' } };   // TileMap walls\nconst map = new E.TileMap({ rows, legend, types, floorMat: 'flagstone', floorMats: { water: 'water' } });   // floors\nconst level = new E.PlatformMap({ rows, legend, types: { 1: { kind: 'solid', style: 'block', mat: 'mossy' } } });\n```\n\nfloorMats is keyed by the floor tags of the legend ('~': { floor: 'water' }); either stands in for floorTex.\n\nA material is `{ color, pattern, ...the pattern's numbers, ramp, glow, over }`. Its five tones come from `E.tones(color)`\n(or its own `ramp` of five, dark to light); the light picks a band, the pattern moves it a step, so a material works on\nevery surface and in every palette and recolors with one hex. An unknown name warns with the list of names.\nOverlays, the last on top, each in its own color's tones: `over: [['moss', '#5f7a3a', { up: .6 }], ['cracks']]`; moss on\nwhat looks up, cracks (the material a step darker), dirt near the ground (h 6), rust; each takes amount and size.\n\n| Pattern | Numbers | What |\n| --- | --- | --- |\n| none | | the light alone |\n| planks | bw 3, len 14, dir | boards with joints; staves on round parts; dir: 'v' turns them |\n| crate | frame 2, bw 3 | a framed, braced side; planks on its lid |\n| bricks | bw 6, bh 3, mortar | running bond |\n| stones | size 5 | irregular stones (Voronoi), dark joints, a lit rim |\n| tiles | size 4 | square tiles, grout |\n| speck, noise | amount .08; scale 4 | specks; soft patches |\n| foliage | size 3.5 | leaf clumps lit on top |\n| bark | | fissures; rings on a cut end |\n| metal | rivet | a shine where lit; rivets |\n| cloth | fold .9 | weave and folds |\n| glaze | | a glossy shine |\n| thatch, shingles | course; bw | straw courses; roof tiles |\n\nYour own pattern: `E.PATTERNS.waves = (s, m) => Math.sin(s.u / (m.size || 3)) > .8 ? 1 : 0` (s.u, s.v: world units\nacross and up the surface; s.lid, s.curved, s.lit, s.W, s.H; return a step, -1 to +2). A material may also paint one kind\nof surface its own way, per pixel: `face(wx, z, tones, type, cx, cy, fi, nh, h)` or `roof(wx, wy, tones, type)` returning\na color or null, `floor(x, y, tag, view)` returning [r, g, b].\n\n## Write one\n\nUnits: 16 = 1 m = one tile; x east, y south, z up. The origin is the middle of the footprint on the ground; write it\nfacing south (+y). Use whole or half units: a pixel at game size is about 0.7 units.\n\n```js\nE.SHAPES.stool = { about: 'round three-legged stool', tags: 'furniture tavern', mats: { w: 'oak', l: 'walnut' },\n  parts: [['cyl','w',[0,0,8],5,1.5], ['ring',3,3,['box','l',[0,0,0],[1.5,1.5,8],{rot:[0,-8,0]}]]] };\n```\n\nAn entry: `about`, `tags`, `mats` (slot to material; a slot name that is not in mats is a material itself), and `parts`, or\n`make(params)` returning parts with `params` its defaults. Optional: `scale` (times the placement's), `foot: [x0, y0,\nx1, y1]` (the footprint for collision, and for sorting when it stands raised; the bounds by default), `lights: [[x, y,\nz, color, radius]]`, `flames: [[x, y, z, w, h]]`.\n\n| Part | Form | Notes |\n| --- | --- | --- |\n| box | `['box', m, at, [w, d, h], { rot }]` | at: the bottom middle |\n| cyl | `['cyl', m, at, r, h, { r2, seg, sq }]` | r2: top radius (0: a cone); sq squashes y; seg: 6 for a hexagon |\n| lathe | `['lathe', m, at, [[r, z], ...], { seg }]` | a profile turned about z, bottom to top; [0, z] closes an end |\n| ball | `['ball', m, at, r, { sz }]` | at: its centre; sz below 1 flattens it |\n| prism | `['prism', m, at, [[a, b], ...], h, { axis }]` | an outline pushed h: up z (outline x, y), or centred along y (outline x, z) or x (outline y, z) |\n| wedge | `['wedge', m, at, [w, d, h]]` | h tall at the back, down to the floor at the front |\n| rock | `['rock', m, at, r, { sz, seed, rough }]` | a lumpy, faceted ball; below the floor is not drawn |\n| use | `['use', id, at, { rot, scale, mats, ...params }]` | another shape inside this one |\n| mirror | `['mirror', 'x' \\| 'y' \\| 'xy', part]` | the part and its mirror copies |\n| ring, row | `['ring', n, radius, part]`, `['row', n, [dx, dy, dz], part]` | n copies round z (the part moved out to radius); n copies in a line, centred |\n| group | `['group', at, rot, [parts]]` | parts moved and turned together |\n\nEvery part takes `{ rot }`: a yaw in degrees, or [x, y, z] degrees. Write arrays densely (`[0,0,8]`, not `[0, 0, 8]`):\nspaces cost a third more tokens.\n\n### Worked entries\n\n```js\nbarrel: { about: 'oak barrel, two iron hoops', tags: 'container wood', mats: { w: 'oak', h: 'iron' },\n  parts: [['lathe','w',[0,0,0],[[0,0],[5,0],[6,3],[6.5,8],[6,13],[5,16],[0,16]]], ['row',2,[0,0,9],['cyl','h',[0,0,7.5],6.5,1.5]]] },\ncrate: { about: 'wooden crate, framed and braced', tags: 'container wood', mats: { c: 'crate' }, parts: [['box','c',[0,0,0],[15,15,14]]] },\ntable: { about: 'plank table, four legs', tags: 'furniture tavern', mats: { t: 'oak', l: 'walnut' },\n  parts: [['box','t',[0,0,10],[24,14,2]], ['mirror','xy',['box','l',[10,5,0],[2,2,10]]]] },\nchest: { about: 'oak chest, round lid, iron bands', tags: 'container treasure', mats: { w: 'oak', b: 'iron', l: 'gold' },\n  parts: [['box','w',[0,0,0],[16,10,8]], ['prism','w',[0,0,8],[[-5,0],[5,0],[4,3],[0,5],[-4,3]],16,{axis:'x'}],\n    ['mirror','x',['box','b',[5.5,0,0],[1.5,11,8.5]]], ['box','l',[0,5,5],[3,1,3]]] },\nlamppost: { about: 'iron street lamp, glowing head', tags: 'town light', mats: { m: 'iron', g: 'flame' }, lights: [[0,0,40,'#ffd070',70]],\n  parts: [['cyl','m',[0,0,0],2.5,3], ['cyl','m',[0,0,3],1,34], ['box','g',[0,0,37],[4,4,5]], ['cyl','m',[0,0,42],3.5,3,{r2:0,seg:4}]] },\nfence: { about: 'rail fence, len long (16)', tags: 'village farm', mats: { w: 'oak' }, params: { len: 16 },\n  make: p => [['mirror','x',['box','w',[p.len / 2 - 1,0,0],[2,2,12]]], ['row',2,[0,0,5],['box','w',[0,0,6],[p.len - 2,1,1.5]]]] },\n```\n\nA generator seeds its noise from its params (`E.rng(seed)`), never `Math.random`, so it draws the same pixels everywhere.\n\n## Make one: the recipe\n\n1. **Read this card whole.**\n2. **Find** the nearest entry: `node tools/asset-find.mjs \"tavern table\"` searches the core library and the store's sets\n   (`src/assets/sets/`, about a thousand objects, materials and sprites converted from CC0 libraries, each with where it\n   came from) and `--show set:id` prints one; the Asset Lab (`/asset-lab`) shows them all.\n3. **Copy** it and change its names, parts and materials, or write a new one from the parts above. Give the cue a player\n   knows it by parts of its own (a skep's coils as stacked rings, an anvil's horn, a barrow's open tub dark inside), and\n   keep small parts plain ('none', 'glaze'): a busy pattern on a part a few pixels wide reads as speckle.\n4. **Look:** `node tools/asset-sheet.mjs mine.js#stool` (a file that sets `E.SHAPES.stool`, or a store set; a core id\n   alone works too: `node tools/asset-sheet.mjs barrel`). It draws `check-output/asset-sheet/stool.png`: every view and\n   four facings, beside the hero, on a light and a dark floor. It lints what reads badly: too small from above, a part\n   under a pixel, too few tones, low contrast with the floor, its tokens. Read the picture, fix, repeat.\n5. **Use** it: `E.SHAPES.stool = {...}` and `r.shape('stool', ...)`; or a set file\n   (`(window.ASSETS = window.ASSETS || {}).MINE = { set: 'MINE', format: 1, materials, shapes }`) and\n   `E.addAssets(window.ASSETS.MINE)`, which names its entries 'MINE:stool' so they never collide, and returns the names.\n   A store set loads the same way (its script, then `E.addAssets(window.ASSETS['kenney-furniture'])`);\n   `node tools/asset-set.mjs <sets> --ids a,b --name mine --out mine.js` cuts the few a game uses, with what they need\n   (Emberdeep's set dressing loads `src/assets/sets/emberdeep.js`, cut so).\n\n## Limits\n\n- Still objects. Lids that open, swinging signs and held weapons are code (or props) for now.\n- A shape sorts by one point, as props do; a long one (a bed, a cart) may cross a body walking right beside it.\n- Collision is the footprint's box, turned with the shape, and the bounds' height: a table is solid under its top too.\n- Bigger than about 240 pixels on screen, a shape skips the actors' effects (flash, x-ray).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '218,277p' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md' && cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/kits/adventure.js'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '218,277p' 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/API.md' && cat 'Trauma-Sector-Second-Signal-Trauma-Center-Second-Opinion-gpt-6.1-sol-max-20261105-011709/vendor/my-3d2dge/dist/handoff/kits/adventure.js'\"","aggregated_output":"**Blob** (slimes, rabbites, bats, imps, round monsters): `new E.Blob({ R: 6, colors: { dk, base, lt, spec, eye, pupil }, ears: 'rabbit' | 'cat', horns: true, wings: true, feet: true, tail: true, mouth: true | 'fangs', face: 'front' })`, `update(dt, { squash: -0.4..0.4, look: [dx, dy], squint, walk: 0..1, flap: 0..1 (wing speed; 0 folds them), hang: true (roost upside down) })`, `kick(v)`, `draw(g, ox, oy, view)`. Mix the parts for a bestiary: `wings` + `mouth: 'fangs'` is a bat, `ears: 'rabbit'` + `feet` a Mana rabbite, `horns` + `tail` an imp.\n\n## Effects and lighting\n- Particles: `game.particles.explosion(x, y, z, size)` (fireball, smoke, sparks, debris, ring, shake, sound), `fire(x, y, z, n, { size })`, `smoke(x, y, z, n, { size, color })`, `glints(x, y, z, n, color)`, `dust(x, y, z, n)`, `sparks(x, y, z, n, angle)`, `bits(x, y, z, n, colors)`, `ring(x, y, r0, r1, color, dur)`, `text(x, y, z, '12', color, { scale: 2, bounce: true })` (bouncing damage numbers), `add({ kind: 'dust' | 'spark' | 'bit' | 'ember' | 'fire' | 'smoke' | 'glint', ... })`. `explosion(x, y, z, size, { debris, freeze: false, shake: 0 })` for chains of small blasts. Side-scrollers: `particles.ground = (x, y, z) => level.groundBelow(x, z)` so sparks and debris bounce on platforms. Screen flash: `game.flash('#ffffff', .12, strength 0..1)`.\n- Lighting (step 9; every view, side-scrollers included, no WebGPU needed): `game.lights.add(x, y, z, radius, intensity, { color: '#ffa050' })` every draw. Dark areas get a smooth cool tint, lights add their own color, and emissive items (flames, sparks, bullets, `emissive: true`) stay bright. `lights.darkness` (0..1) and `lights.tint` tune it; after setting `lights.dark = [r, g, b]`, `levels` or `glow`, call `lights.refresh()`. Props with flames can light the scene: `r.prop('torch', x, y, z, { light: true })`. Lamps, street lamps, lanterns and crystals glow on their own (`haloR`, `haloColor`, `halo: false`); `cone: true` adds a light cone under a street lamp.\n- Hits: `game.hitFx(x, y, z, { power: 1, angle, damage: 12, textScale: 2, textZ: 22 })` does hit-stop, shake, an impact star, sparks, a bouncing damage number (`bounce: false` floats it) and a sound in one call; `particles.impact(x, y, z, size, color)` for the star alone.\n- GPU lighting (optional, ground views with a TileMap): `const gpu = game.enableGPU({ map })`; mark glowing things with `px.glow(g, 1)`; add `lights.caster(x, y, r, top)` and `lights.heat(x, y, z, w)`. Where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with `game.lights.ambient` (`gpu.fallback = false`: unlit).\n\n## Genre playbook (NES, SNES, Genesis, N64, PS1)\n| Genre (examples) | View | Build it with | Copy slice |\n|---|---|---|---|\n| Platformer (Mario, Mega Man, Sonic, Castlevania) | `side` (+ `brawler` for 2.5D) | PlatformMap, Platformer, Humanoid, sprites, Bullets `'side'` | PLATFORMER |\n| Metroidvania (Metroid, Symphony of the Night) | `side` | an `E.World` of PlatformMaps (the rooms module: doors at open edges, a slide, the explored map, gates opened by abilities, saves), a Platformer given `airJumps` and `dash` as they are found, its further moves, an arm cannon aimed eight ways (`point`, `aim`, `rig.tip()`, Bullets) | METROIDVANIA |\n| Action adventure (Zelda, Secret of Mana) | `threequarter` or `topdown` | TileMap rows, `cam.room`, Body, Humanoid + `E.Attack` sword, Dialog, `E.ui.hearts` | ADVENTURE |\n| Point-and-click adventure (Monkey Island, Day of the Tentacle, Broken Sword) | none: rooms painted in screen pixels (`r.overlay`) | `E.Click` (the click module): rooms with walk areas and holes (`E.Walkbox`), depth scale, hotspots, the nine verbs, Sierra's icons or a verb coin, an inventory, puzzles as rules; talk through `E.Story` | POINT-AND-CLICK |\n| Visual novel (Phoenix Wright, Snatcher, Clannad) | none | `E.Story` nodes and choices over a painted backdrop, `rig.drawPortrait` at size, `story.log` (the backlog), `story.auto`, `story.skip`; `game.saves` | POINT-AND-CLICK |\n| Action RPG / dungeon (Diablo, Landstalker) | `iso` | TileMap, FlowField, Body (jump onto blocks), GPU lighting | ADVENTURE |\n| Beat-'em-up (Final Fight, Streets of Rage, TMNT) | `brawler` | TileMap street strip, Body, Humanoid (`weapon: null`) + `E.Combo` punches and `kick: true` kicks, `E.knockback`, waves that lock the screen; a second player drops in (`game.allowJoin`, `cam.frame` on both) | BRAWLER |\n| Fighting (Street Fighter II, Darkstalkers) | `side` | two `E.Fighter`s in an `E.Match` (the fight module): moves with frame data, guards, throws, specials by motion (`'236'`) or charge, a meter, projectiles; `E.FightAI`, `E.FightSelect`, training | FIGHTING |\n| Shoot-'em-up (1942, Gradius, R-Type) | `overhead` (vertical, and horizontal: world x scrolls) | sprites, Bullets, `E.pattern`, a timeline of waves; horizontal: rock edges as functions of x, a power bar, options on the ship's past path, `E.Path` loops; `E.Arcade` for the continue and the table | SHOOTER (both stages) |\n| Pinball (Pinball Fantasies, Space Cadet, Devil's Crush) | a steep table view of its own (`new E.View('pinball', 'Table', 0, 62, 1, 1)`) | `E.Physics`: chains for the walls, `flipper`, `bumper`, `slingshot`, `kicker`, a ramp on a layer of its own, the ball a `bullet`; `input.zones` flip on a phone; `E.Arcade` for the score and table. Breakout and Asteroids with real collisions are its recipes | PINBALL |\n| Artillery (Worms, Scorched Earth) | `side` at a whole scale (`new E.View(id, label, 0, 0, 1, 1)`) | `E.Terrain` (`carve` the blasts, `walk` the soldiers, `ray` the shots), grenades as `E.Physics` bodies on `land.collider()`, `E.Turns`; a drag aims (`steer = 'drag'`, `drag()`, `stickOn`); a CPU tries its shots in simulation | ARTILLERY |\n| Golden-age arcade (Pac-Man, Galaga, Asteroids) | `overhead` (one fixed screen, cabinet art on the sides) | `E.Arcade` (score, lives, extra lives, turns, initials, tables, attract mode); a maze of `E.GridMover`s; moths on `E.Path`s turned by `rot`; `E.wrap` and `wrap: [w, h]` | ARCADE |\n| Twin-stick / run-and-gun (Smash TV, Contra) | `topdown` / `side` | Body or Platformer, Bullets, `weapon: 'gun'`, `point: true` | SHOOTER + ADVENTURE |\n| JRPG (Dragon Quest, Final Fantasy, EarthBound) | `threequarter` town, `brawler` battles | TileMap towns and a big world map, the story and rpg modules, Dialog with markup, `game.saves` slots | RPG |\n| Puzzle (Tetris, Dr. Mario, Puyo, Columns) | `side` (a field in screen pixels) | a cell array, a bag from `E.rng`, `input.repeat` (auto-shift), `grid.groups` (chains), `input.drag()` and `clicked()` for touch; versus: two fields, rows sent across (`game.players`) | PUZZLE |\n| Roguelike (Rogue, Mystery Dungeon, Shiren) | `threequarter` / `iso` | `E.gen` floors, a TileMap of its rows, `E.Grid.from(map)` paths and `fov`, `E.Fog`, `E.Turns` by speed, `game.tween` steps | ROGUELIKE |\n| Tactics (Final Fantasy Tactics, Tactics Ogre, Fire Emblem) | `iso`, turned a quarter | TileMap of block heights, `map.pick` under the cursor, `E.Grid.from(map, { tops: true })` reach over heights, `grid.shape`, `grid.side`, `grid.threat`, `E.Turns` charge time, `E.Story` | TACTICS |\n| Real-time strategy (Warcraft II, StarCraft, Dune II) | `iso` | `E.Strategy` (the strategy module): kinds as data, selection by click, box and group, orders, gold, building, training, fog, an AI's build order and waves; `cam.free`, `{ pick: unit }` and `r.pick`, buildings as `E.SHAPES`, E.Shell's minimap; bodies drawn `every: 3` | RTS |\n| Theme park or city sim (Theme Park, RollerCoaster Tycoon, SimCity) | `iso` | paths as floor tags walked on an `E.Grid`, agents with `E.needs` picking by `E.choose`, `E.Clock` days and light, `game.timeScale` 0 to 4, `E.overlay`, `E.tooltip`; rides as shapes stepped through angles (`params`, `facing`) | SIM |\n| 3D platformer or adventure remake (Mario 64, Ocarina, Crash) | `iso` / `threequarter` / `brawler` | TileMap blocks of different heights + Body `jump()` (z is real height); in real 3D: `E.World3D` (the 3D engine's manual), `camera.lock` | ADVENTURE; 3D ACTION, 3D PLATFORMER |\n| Survival horror (Resident Evil, Alone in the Dark) | the 3D engine's `'zones'` camera | `camera.zones` (fixed cameras by room), `camera.steer` (tank controls), `camera.lock` to aim, `world.through` doors, `world.flashlight`, fog; `E.RPG` inventory, `game.saves` | 3D HORROR |\n| First-person dungeon (Wizardry, Dungeon Master, Eye of the Beholder) | the 3D engine's `'fixed'` camera at the party's eyes | cells of 2 x 2 tiles stepped and turned a quarter at a time (tweened), `E.Grid` paths for the monsters, `E.Turns` `'atb'` (real time) or `'speed'` (turns), `E.Fog` for the automap, `world.thing('door')` gates and `world.unlock`, `rig.drawPortrait` for the party | 3D CRAWLER |\n| Rhythm (Dance Dance Revolution, PaRappa, Beatmania, Space Channel 5) | any (a highway on the overlay) | `E.Rhythm` (the rhythm module): a chart of lane strings in parts on a song's steps, judged in ms of the music clock, combo, life, grade, holds, calls a teacher plays and you answer, `rh.draw` (`arrows: true`); the songbook's songs (`E.Songbook`); lanes as `input.zones` on a phone; `audio.onBeat` moves the dancer | RHYTHM |\n| Sports (Sensible Soccer, NBA Jam) | `threequarter` / `topdown` | the ball an `E.Body` (`bounce`; curl: turn its velocity across its path), passes led to the teammate, `E.arc` for a lob, a shot's meter, formations by where the ball is, `game.allowJoin({ max: 4 })` | SPORTS |\n| Third-person stealth (Assassin's Creed, Metal Gear, Tenchu) | `iso` / `threequarter` | TileMap roofs, Mover, `E.sees`, `E.Suspicion`, FlowField `jump` | STEALTH |\n| Kart racing (Super Mario Kart, F-Zero) | Mode 7 (the mode7 module, over any view) | `E.Mode7` over a TileMap track (floor tags: grass, sand, boost), `E.Car` karts (`kart: true`: hop, drift, boost) in an `E.Race` round an `E.Path` (laps, checkpoints, drivers, items), rigs in karts as billboards, `game.splitScreen(2)` for two | KART |\n| 3D kart racing (Mario Kart 64, Crash Team Racing) | the 3D engine's `'behind'` camera | `world.track` (banked, walls, pads, `gaps` for a shortcut), `world.vehicle` karts raced by `E.Race`, split screen through `world.cameras` | 3D RACING |\n| Rail shooters (Star Fox 64, Panzer Dragoon) | the 3D engine's `'behind'` camera | `world.flyer` on rails or free in bounds, rolls (`f.rolling`) turn shots aside, `f.seek` for a charged lock, `Dialog`'s radio | 3D FLIGHT |\n| Road racing (OutRun, Pole Position, Road Rash) | the pseudo-3D road (the road module) | `E.Road` segments (curves, hills, tunnels), scenery and traffic placed on it, `curveAt` throwing the car outward, a clock and checkpoints | ROAD |\n| Top-down racing and driving (Micro Machines, RC Pro-Am, GTA) | `topdown` / `iso` | `E.Car` on a TileMap (its floor tags slow it, its walls bounce it), `E.Race` for laps and drivers, cars drawn with `px.poly` on `r.w()` corner points | KART |\n| First-person shooter (Doom, GoldenEye 007, Apex Legends) | the 3D engine's first person (or third) | a level of text rows or a terrain, `world.ray` hitscan, recoil and reloads, doors (`world.thing('door')`), raiders on `world.flow()` | 3D SHOOTER |\n| Bomberman, Frogger, Sokoban, Gauntlet, Robotron; Sonic, Prince of Persia; light guns | as the recipe says | `AI_GUIDE.md`'s Genre recipes: each on the kit closest to it | (a recipe) |\n\n**Sizes:** heroes 40-60 px tall at 320x240 (`size: 1.2-1.4`), bosses 1.8-2.4. Small things (coins, bullets, ships, pickups) are string sprites designed at 8-16 px, drawn at scale 2 if they are the player's ship. Keep hitboxes smaller than the art.\n\n**Feel numbers** (world units per second, tile = 16): walk 70-90, run 95-140, jump 250-320 with gravity 800, fall cap 330, dash 200-260, bullets 250-320 (player) and 70-120 (enemy), enemy walk 25-45. Hit feedback: `game.hitFx` (Effects).\n\n## More: animation and examples outside this card\nThe repo (github.com/michaelcrosato/my-3d2dge; any file at `https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/main/<path>`) holds more to take from. Its files are large: search them and take only what the game needs. Real 3D (`E.World3D`: first person, racing, flight) is there: `engine/my-3d2dge-3d.js`.\n- **Motion clips**: 325 curated and 2,548 motion-capture takes that play on any Humanoid: find one in `src/mocap/catalogs/`, cut a small set with `tools/anim-set.mjs`, then `Mocap.drive(rig, lib)` (`AI_GUIDE.md`, Where to find more; `docs/MOCAP.md`).\n- **Objects and materials** (full engine): `r.shape('barrel', x, y, 0, { facing })` draws a still object from any view and facing, `map.solid(...)` makes it solid; `E.MATERIALS` dresses floors (`floorMat`), walls (`face`, `roof`) and platform tiles (`mat`). `docs/ASSETS.md` is the card: the format, the library, writing one and checking it with `node tools/asset-sheet.mjs`.\n- **Worked examples**: Emberdeep (`src/emberdeep/`), a whole game on this engine: 29 monster, boss and dummy bodies, 3 heroes and 30 skills, registered with `def(kind, id, spec)` (one search lists them); adapt them, they lean on the game's own helpers. `docs/CHARACTERS.md` is the recipe for a new body.\n- **Modules** (`engine/modules/<name>.js`; `modules/` in the handoff package): general systems in files of their own, each a `<script>` after the engine, its header its manual (read it there, or its section of the index). A kit carries the modules its slice names (`@modules` in its header); the full engine (`dist/my-3d2dge.js`; `my-3d2dge.js` in the handoff package) carries them all.\n  - `grid`: square and hex grids: A* paths, move ranges over heights and past allies, fields of view, `E.Fog`, groups, shapes of effect, threat maps, `E.GridMover`, `E.Turns` (speed, charge time, phases, ATB). ROGUELIKE, PUZZLE, TACTICS, ARCADE, ARTILLERY, RTS, SIM, 3D CRAWLER.\n  - `gen`: generated maps from a seed: rooms and corridors, BSP, caves, mazes, Poisson scatter, as ASCII rows a TileMap reads. ROGUELIKE, ARCADE.\n  - `fight` (the full engine only): one-on-one fighting: `E.Fighter` (frame data, hurt boxes from the rig's joints, guards, throws, cancels, juggles, specials by motion or charge, a meter, projectiles), `E.Match` (rounds, KO, the HUD, training), `E.FightAI`, `E.FightSelect`. FIGHTING.\n  - `rooms`: a world of rooms on a grid of screens (`E.World`): walking between them at open edges, the explored map (`drawMap`, or `shellMap()` for `E.Shell`), gates that abilities or keys open, saves in `E.store`. METROIDVANIA.\n  - `mode7`: the SNES's Mode 7 (`E.Mode7`): a camera over a flat floor (a TileMap's, a function's or a canvas), a turning sky, billboards far to near (rigs, sprites, shapes, your drawing), fog, `project` and `toFloor`, split screens. KART.\n  - `road`: the pseudo-3D road (`E.Road`): segments with curves and hills, lanes, rumble strips, tunnels, scenery and cars scaled by distance and hidden past a crest, the sky's parallax on curves. ROAD.\n// The ADVENTURE kit's game (a top-down action adventure: a village, ruins and a shrine, a sword, a key and a great door, talk with portraits; Zelda and Secret of Mana), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/10-adventure.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. adventure.html plays it; node kits/test.mjs adventure runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 1  ADVENTURE  (Secret of Mana, Zelda: ALttP). Three rooms: village, ruins, shrine. Talk, clear the ruins for\n * the key, open the great door, claim the crystal. THE LOOK: wall MATERIALS, ONE floorTex with PAINTED LIGHT, pitched\n * roofs, leaf-clump bushes, light shafts, dialog PORTRAITS.\n * KEYS: WASD or arrows move, J or X swings the sword, Enter or Space talks. TOUCH: the stick, ATTACK, CONFIRM.\n * ANY SCREEN: rooms are 4:3 in a world that goes on past them (forest above and below, the next rooms beside), so a\n * screen of any shape is filled. CAMERA (Settings, or C): ROOMS slides screen by screen as Zelda's does, the rooms beside\n * this one under a dim CURTAIN (they wait, as their monsters do); SCROLL follows the hero. The HUD sits in the corners.\n * ===================================================================================== */\nconst ADV = (() => {\n  const T = 16, ROOM = [14 * T, 12 * T], AREAS = ['Mana Village', 'Mossy Ruins', 'Shrine of Mana'];\n  const ROWS = [\n    // village          ruins             shrine\n    ['^^^^^^^^^^^^^^', 'RRRRRRRRRRRRRR', 'XXXXXXXXXXXXXX'],\n    ['^^#^^^^^^^^#^^', 'RHhJKFYDYFKhHR', 'XwjiXnWXnXijwX'],\n    ['#UUUU.ZZZZ.~~#', 'R.u..qv.vq.S.R', 'X.S*.B..B.*S.X'],\n    ['#GQOQbzNzZu~~#', 'H.KK....x....H', 'X.....rA.....X'],\n    ['#ccccV~ccLe~~#', 'K..s.q::::.s.H', 'X..I..++..I..X'],\n    ['#cM@cPccac=~~#', 'H.....::::k..K', 'X....m++m....X'],\n    ['#,,,,,,,,,,__,', ',,....::C:...H', 'X4.I..++..I.4X'],\n    ['#.b...b.g,d__,', ',,..o.::::.s.H', 'X.....++.....X'],\n    ['#...%%%f..s~~#', 'Hb.K..::::q.KH', 'X..I..++..I..X'],\n    ['#T..%%%.u..~~#', 'H.u..s....y.RH', 'X.p...++...p.X'],\n    ['#.3........~~#', 'H...bK...b.xRH', 'X.....E+.....X'],\n    ['##############', 'RRRRRRRRRRRRRR', 'XXXXXX++XXXXXX']\n  ].map(r => r.join(''));\n  // the world AROUND the rooms: PAD rows of forest canopy above and below (a meadow's edge first, the shrine's stone under\n  // the shrine), so a screen of any shape is filled. The rooms' rows start at OY\n  const PAD = 12, OY = PAD * T, wood = (cx, cy) => cx >= 28 ? 'X' : E.hash2(cx * 7, cy * 5) < .18 ? '2' : '1';\n  const AROUND = (cy0, meadow) => Array.from({ length: PAD }, (_, i) => Array.from({ length: 42 }, (_, cx) => meadow && i < 2 && cx < 28 ? '.' : wood(cx, cy0 + i)).join(''));\n  ROWS.unshift(...AROUND(0)); ROWS.push(...AROUND(PAD + 12, true));\n  const LEGEND = {\n    // walls: a wall type (TYPES), or { tile, spawn } = a wall with a prop on its face (THINGS)\n    '#': 1, 'U': 5, 'Z': 8, 'R': 9, 'H': 3, 'K': 4, 'F': 6, 'X': 2, 'A': 7, '1': 10, '2': { tile: 10, spawn: 'tree' },\n    '^': { tile: 1, spawn: 'tree' }, 'G': { tile: 5, spawn: 'ivy' }, 'Q': { tile: 5, spawn: 'pane' }, 'O': { tile: 5, spawn: 'door' },\n    'z': { tile: 8, spawn: 'pane' }, 'N': { tile: 8, spawn: 'shop' }, 'h': { tile: 3, spawn: 'vines' }, 'J': { tile: 3, spawn: 'cobweb' }, 'Y': { tile: 6, spawn: 'moss' }, 'D': { tile: 6, spawn: 'gate' },\n    'w': { tile: 2, spawn: 'window' }, 'W': { tile: 2, spawn: 'rose' }, 'i': { tile: 2, spawn: 'torch' }, 'n': { tile: 2, spawn: 'banner' }, 'j': { tile: 2, spawn: 'cobweb' }, 'r': { tile: 7, spawn: 'relic' },\n    // floors: a tag for floorTex; block = not walkable\n    ',': { floor: 'path' }, 'c': { floor: 'plaza' }, '~': { floor: 'water', block: true }, '_': { floor: 'bridge' }, ':': { floor: 'pave' }, '+': { floor: 'carpet' }, '%': { floor: 'bed' },\n    '@': { floor: 'plaza', spawn: 'hero' }, 'M': { floor: 'plaza', spawn: 'elder' }, 'P': { floor: 'plaza', spawn: 'pot' }, 'L': { floor: 'plaza', spawn: 'lamp' },\n    'V': { floor: 'water', block: true, spawn: 'fountain' }, 'C': { floor: 'pave', spawn: 'chest' }, 'E': { floor: 'carpet', spawn: 'entry' }, 'd': { floor: 'path', spawn: 'villager' },\n    // people, creatures and props\n    'f': 'florist', 'a': { floor: 'plaza', spawn: 'cat' }, 's': 'rabite', 'v': 'bat', 'k': 'goblin', 'm': 'mage', 'b': 'bush', 'p': 'pot', 'T': 'oak', 'g': 'sign', 'u': 'mushroom',\n    'e': 'barrel', '=': 'crate', '3': 'stump', '4': 'obelisk', 'q': 'ruin', 'I': 'pillar', 'S': 'statue', 'o': 'rock', 'x': 'crystal', 'y': 'skull', 'B': 'brazier', '*': 'candelabra'\n  };\n  // wall MATERIALS: face = side, roof = top pattern (beam = timber); cut = lowered to cutH in front of the camera\n  const SLAB = { face: 'stone', roof: 'slab' }, TYPES = {\n    1: { h: 16, cut: true, cutH: 7, face: 'hedge', roof: 'leaves', top: '#3f8c3c', side: '#2e6a34' },   // hedge\n    2: { h: 34, cut: true, cutH: 8, ...SLAB, top: '#4e4670', side: '#6a6294', course: 9 },   // shrine stone\n    3: { h: 26, cut: true, cutH: 8, face: 'ruin', roof: 'slab', top: '#7a8a66', side: '#8e8a98' },   // ruin wall, mossy top: the 'ruin' MATERIAL (stones, cracks, moss, dirt; docs/ASSETS.md)\n    4: { h: 12, cut: true, ...SLAB, top: '#72845e', side: '#8e8a98', course: 6 },   // crumbled ruin\n    5: { h: 36, face: 'timber', roof: 'tiles', top: '#c4583a', side: '#f0e0c0', beam: '#6a4228' },   // cottage\n    6: { h: 36, ...SLAB, top: '#5a5480', side: '#7a7298', course: 9 },   // shrine facade\n    7: { h: 9, ...SLAB, top: '#8a84b4', side: '#5a5484', course: 4 },   // altar\n    8: { h: 36, face: 'plaster', roof: 'tiles', top: '#3a7ab4', side: '#f4e6c8' },   // shop\n    9: { h: 30, cut: true, cutH: 8, face: 'rock', roof: 'grass', top: '#5a9a44', side: '#8a7462' },   // cliff\n    10: { h: 22, face: 'hedge', roof: 'leaves', top: '#2c6a36', side: '#1f4a2a' }   // the forest round the rooms\n  };\n  // set dressing: tag -> prop(s). r = solid, cut = breakable (debris), drop = loot, face = on the wall at z (anchor\n  // 'top' hangs it), light = GPU light, dx = nudge, hidden = appears later; shape = a SHAPE (E.SHAPES, docs/ASSETS.md:\n  // right in every view and turn, no drawing code) in place of a prop, size its scale\n  const THINGS = {\n    // village\n    door: [{ face: true, size: 1.1, color: '#7a4222' }, { prop: 'lantern', face: true, z: 33, dx: 14, anchor: 'top', light: '#ffb060' }],\n    shop: [{ prop: 'door', face: true, size: 1.1, color: '#2a4a7a' }, { prop: 'awning', face: true, z: 23, size: .95, color: '#d8483a' }],\n    pane: { prop: 'window', face: true, z: 12, size: .65, color: '#6a4424', colors: ['#fff0b0', '#ffd070'] }, ivy: { prop: 'vines', face: true, z: 35, anchor: 'top', color: '#3a8a3a', blossom: '#f890b0' },\n    fountain: { prop: 'statue', size: .8, color: '#a8a6c0', dx: 8 }, lamp: { prop: 'streetlamp', r: 3, size: .8, halo: false }, oak: { prop: 'tree', size: 1.45, r: 8 },   // lamp: unlit by day\n    bush: { r: 6, cut: ['#2f7a34', '#5ab04a', '#9ad86a'] }, pot: { size: .95, r: 5, cut: ['#7a3a22', '#c07040', '#e8a878'], drop: 'gem' }, sign: { r: 4 },\n    mushroom: { size: .75, color: '#e0503a' }, barrel: { shape: 'barrel', r: 5, size: .75 }, crate: { shape: 'crate', r: 6, size: .65 },\n    // from the asset store, cut into the page's 'adventure' set (src/assets/sets/adventure.js); without it, props\n    ...(E.addAssets((window.ASSETS || {}).adventure || { set: 'adventure' }).shapes.length ? { stump: { shape: 'adventure:stump-round', r: 5, size: .7 },\n      obelisk: { shape: 'adventure:pillar-obelisk', r: 6, size: .8 } } : { stump: { prop: 'rock', r: 5, color: '#8a5a3a' }, obelisk: { prop: 'pillar', r: 6 } }),\n    // ruins\n    vines: { face: true, z: 25, anchor: 'top', color: '#4a8a3a', blossom: '#f890b0' }, moss: { prop: 'vines', face: true, z: 35, anchor: 'top', size: .8, color: '#5a8a3a', blossom: '#f890b0' },\n    gate: { prop: 'door', face: true, size: 1.1, color: '#5a3a6a' }, ruin: { prop: 'pillar', broken: true, r: 7 }, rock: { r: 5, color: '#8a8698' }, skull: { prop: 'bones' },\n    crystal: { r: 4, light: '#5ad8f0' }, chest: { r: 6, hidden: true },\n    // shrine\n    window: { face: true, z: 7, size: .8, colors: ['#e05a6a', '#5a8ae8', '#f0c85a', '#6ad08a'], light: '#8ab0ff' }, torch: { face: true, z: 14, light: '#ff9a4a' },\n    rose: { prop: 'window', face: true, z: 2, size: 1, dx: 8, colors: ['#e8c85a', '#c04aa0', '#5a8ae8'], light: '#c8a0ff' }, banner: { face: true, z: 8, size: .8, color: '#8a1a3a', emblem: '#e8c04a' },\n    cobweb: { face: true, z: 34, anchor: 'top', size: .9 }, pillar: { r: 7 }, statue: { r: 6, color: '#9a98b0' }, brazier: { r: 5, size: .9, light: '#ff9a4a' }, candelabra: { r: 3, size: .8, light: '#ffc060' }\n  };\n  // palettes: E.ramp(hex, n, strength) = n hue-shifted shades, dark to light\n  const rgb = hexes => hexes.map(E.hex), R5 = (c, s = .6) => rgb(E.ramp(c, 5, s)), FLAG = (s, mortar) => ({ stones: s.slice(1, 4), mortar, hi: s[4], lo: s[0], speck: s[1] });\n  const GRASS = [['#4c9a3e', '#5aa640', '#6cb44c'], ['#42804a', '#4a8a48', '#5a9a4e']].map(room => room.map(c => R5(c))), DIRT = R5('#b08652', .7), WATER = R5('#2a7ac4', .9), STONE = R5('#a49a8a', .7), SOIL = R5('#6e4a34');\n  const PLAZA = FLAG(R5('#b4a894'), E.hex('#6a5e52')), PAVE = FLAG(R5('#8a8a96'), E.hex('#3a3a3e')), TILE = [R5('#5a5688'), R5('#403c68')], PETAL = rgb(['#ffffff', '#ffe070', '#f890b0']);\n  const CARPET = rgb(E.ramp('#9a2438', 4)), GOLD = rgb(E.ramp('#d8a840', 3)), RUNE = [...E.hex('#6ae8e0'), .35], LILY = R5('#4aa050');   // 4th value = GPU glow\n  const SKY = rgb(['#a8dcf4', '#e8f8ff']), REFLECT = E.hex('#1e5a5a');   // sky glints, the hedge's reflection\n  const TUFT = ['.l.l.', '.dld.', '..d..'], BLOOM = ['.w.', 'wyw', '.w.'];   // grass stamps\n  const MOOD = [[.92, .9, .84], [.8, .88, .8], [.34, .3, .46]];   // GPU ambient light per room\n  const mood = m => { if (gpu) gpu.ambient = m; L.ambient = (m[0] + m[1] + m[2]) / 3; };   // (and the canvas lighting's, where WebGPU is missing and it stands in)\n  // light shafts per room: beam x, tint (a dark tint = a faint beam), lean\n  const BEAMS = [[[34, 128, 196], '#7a5a26', 60], [[50, 150], '#566a22', 60], [[24, 120, 200], '#4a3a8a', 12]];\n  const WIN = { bg: ['#3a4a9e', '#12163e'], border: '#f0e0a8' }, FACE_BG = ['#7aa4e8', '#1e2a66'];\n  // pixel sprites ('.' = transparent)\n  const GEM = E.sprite(['..g..', '.gGg.', 'gGWGg', 'gGGGg', 'dgGgd', '.dgd.', '..d..'], { g: '#1e9a3a', G: '#56e070', W: '#e8fff0', d: '#0e5a24' });\n  const HEART = E.sprite(['.R.R.', 'RWRRR', 'RRRRR', '.RRR.', '..R..'], { R: '#e8384a', W: '#ffd0d6' });\n  const KEYS = [1, 2].map(s => E.sprite(['.yy....', 'y..y...', 'Y..Yyyy', '.YY..y.', '.....yY'], { y: '#f8d048', Y: '#b07818' }, s));   // scale 2: held up high\n  const CRYSTALS = [1, 2].map(s => E.sprite(['....w....', '...wWc...', '..wWWcc..', '.wWWWccC.', 'wWWWccccC', '.wWWcccC.', '.cWWccCC.', '..cWcCC..', '..ccCC...', '...cC....'], { w: '#f0ffff', W: '#a8f0ff', c: '#4ac8e8', C: '#2a5ab0' }, s));\n\n  // THE CAST: chibi rigs, anime eyes, own outfits and palettes; the hero's cape is SECONDARY MOTION\n  const RIGS = {\n    hero: () => new E.Humanoid({ size: 1.3, outfit: 'tunic', hair: 'spiky', face: { eyes: 'big', bangs: .8 }, cape: { len: 4, width: 3.2, seg: 2.2 },\n      colors: { skin: '#f8cca4', hair: '#e8902c', cloth: '#3a8a4a', trim: '#f0d070', pants: '#4a3a5a', boot: '#8a4a26', belt: '#6a3a1a', glove: '#7a5238', eye: '#3a2a6a', cape: '#d0483a', capeIn: '#7a1e2e' } }),\n    elder: () => new E.Humanoid({ size: 1.2, weapon: 'staff', outfit: 'robe', hair: 'short', sleeves: 'long', hunch: .45, hat: { style: 'pointed', color: '#3e3278' }, face: { eyes: 'big', bangs: .35 },\n      colors: { skin: '#f0c4a8', hair: '#b8b2c4', cloth: '#5a4a9a', trim: '#f0cc60', belt: '#f0cc60', boot: '#4a3a2a', eye: '#2a2a4a' } }),\n    florist: () => new E.Humanoid({ size: 1.15, weapon: null, outfit: 'robe', sleeves: 'long', hair: 'ponytail', face: { eyes: 'big', bangs: 1 },\n      colors: { skin: '#f8cca4', hair: '#b0482a', cloth: '#d86a8a', trim: '#f4a8c0', belt: '#fff0d0', pants: '#d86a8a', boot: '#6a3a2a', eye: '#2a5a3a' } }),\n    villager: () => new E.Humanoid({ size: 1.1, weapon: null, hair: 'short', hat: { style: 'band', color: '#d8483a' }, face: { eyes: 'big', bangs: .7 }, shoulderHalf: 4.6, armUpper: 5.2, armLower: 5,   // the wave clears his face\n      colors: { skin: '#f0c090', hair: '#6a3a1e', cloth: '#e8a83a', trim: '#fff0d0', pants: '#4a5a8a', boot: '#6a4a2a', belt: '#6a4a2a', eye: '#2a3a5a' } }),\n    goblin: () => new E.Humanoid({ size: 1.1, build: 'bulky', weapon: null, outfit: 'tunic', hair: 'bald', eyeGlow: '#ffd84a',\n      colors: { skin: '#8ab84a', cloth: '#8a5a32', trim: '#c8a040', pants: '#4a3a2a', boot: '#3a2a1a', belt: '#3a2a1a' } }),\n    mage: () => new E.Humanoid({ size: 1.3, build: 'heroic', weapon: 'staff', outfit: 'robe', hood: true, sleeves: 'long', eyeGlow: '#ff6ab0',\n      colors: { skin: '#c8b8e0', hair: '#2e2450', cloth: '#4a3a86', trim: '#d070f0', belt: '#d070f0', boot: '#1a1628', orb: '#ff80e0' } })\n  };\n  // BLOB CREATURES: a round body plus parts\n  const RABITE = { dk: '#b0703a', base: '#f4d49a', lt: '#fff4dc', pupil: '#5a1a2a', inner: '#f09aa8', ext: '#d8a060' };\n  const BAT = { dk: '#2e1a44', base: '#6a4a9a', lt: '#a890d0', eye: '#fff0a0', pupil: '#c02020', wing: '#4a2a6a', inner: '#e08aa0' };\n  const CAT = { dk: '#9a5028', base: '#f0a050', lt: '#ffd8a0', pupil: '#2a4a1a', inner: '#f8b0b0', ext: '#fff0e0' };\n  const FOES = {   // hp (a hit does 8-12), look, moves (E.MOVES with a long, deep wind-up: the TELL)\n    rabite: { hp: 18, look: () => new E.Blob({ R: 5.5, colors: RABITE, ears: 'rabbit', feet: true, tail: true, mouth: true, face: 'front' }) },\n    bat: { hp: 12, fly: 17, look: () => new E.Blob({ R: 4.5, colors: BAT, wings: true, ears: 'cat', mouth: 'fangs', face: 'front' }) },\n    goblin: { hp: 40, look: RIGS.goblin, moves: ['claw', 'twohand'], tune: { wind: .34, crouch: 1, lean: .9 } },   // a raking claw, a two-fist SLAM\n    mage: { hp: 30, look: RIGS.mage, moves: ['cast'], tune: { wind: .6, lean: .6 } }   // leans back to raise, recoils forward to release\n  };\n  // spins at the waist; CHARGE: the spin's wind-up, deeper\n  const WAIST = { z0: -10, z1: -10 }, CHARGE = { ...E.MOVES.spin, ...WAIST, a0: 2.4, crouch: .6, lean: .6 };\n  // idle: poses in turn; near: turn to the hero (wave: say hello); talk: gestures; chore: a move while kneeling\n  const NPCS = {\n    elder: { name: 'ELDER', idle: [null, null, 'hips'], near: 56, talk: ['block', null, 'hips', null], lines: [() => 'Rabites overran the Mossy Ruins across the river. Press ' + game.input.label('attack') + ' to swing your sword and clear them out!',\n      'Clear the ruins and the old chest opens. The Mana crystal sleeps in the shrine behind the great door.'] },\n    florist: { name: 'LISE', face: Math.PI, idle: ['kneel', 'kneel', null], near: 36, talk: ['hips', 'cast'],   // tends the flower bed\n      chore: () => new E.Attack('plunge', { hand: 'both', a0: -.5, a1: -.9, r0: 4, r1: 9, wind: .3, active: .16, recover: .45 }),\n      lines: ['A rabite got into my garden again! Could you shoo it away?', 'Mind the bats in the ruins. They swoop when you get close!'] },\n    villager: { name: 'PIP', idle: [null, 'hips'], near: 50, wave: true, talk: ['hips', null], lines: ['Hi! The bridge leads to the Mossy Ruins.', () => 'Keep ' + game.input.label('attack') + ' held after a swing, then let go: a SPIN ATTACK!'] }   // a function: the player's own key\n  };\n  // BACKDROP (iso view): a sea of clouds\n  const bg = new E.Backdrop({ sky: ['#3a74c8', '#8ac2ea', '#e4f2f4', '#9ccae6', '#5a90c8'], layers: [{ kind: 'clouds', color: '#ffffff', y: .3, height: .16, parallax: .04, drift: 3 },\n    { kind: 'clouds', color: '#ffffff', y: .98, height: .4, parallax: .1, drift: 3, seed: 9 }] });\n  let map, relic, entry, hero, npcs, foes, pets, items, things, roofs, shots, talk, speaker, won, keys, gems, area, held, fx;\n  // CAMERA, the player's choice: 'rooms' slides screen by screen (Zelda), 'scroll' follows the hero (Settings, or C)\n  game.settings.define({ key: 'advCamera', group: 'Adventure', label: 'Camera', options: [['rooms', 'Rooms'], ['scroll', 'Scroll']], value: 'rooms', help: 'Rooms: screen by screen, as Zelda. Scroll: it follows the hero' });\n  // LIGHTING: GPU lights (pools of light and shadows, WebGPU) draw every frame twice and light each pixel: a phone's frame\n  // rate pays for them, so Auto keeps them for a computer (its main pointer a mouse or touchpad) and a phone gets Fast (the\n  // floor is lit already): the main pointer, as a phone with a stylus has a fine one too\n  const gpuWanted = () => game.settings.advLight === 'gpu' || (game.settings.advLight === 'auto' && !!(window.matchMedia && matchMedia('(pointer: fine)').matches));\n  const lighting = () => { if (!map) return; if (gpuWanted() && !gpu) gpu = game.enableGPU({ map }); if (gpu) Object.assign(gpu, { map, enabled: gpuWanted(), bands: 24, wrap: .5 }); };\n  game.settings.define({ key: 'advLight', group: 'Adventure', label: 'Lighting', options: [['auto', 'Auto'], ['gpu', 'GPU'], ['fast', 'Fast']], value: 'auto', help: 'GPU: pools of light and shadows (slow on a phone). Fast: smooth on a phone. Auto: GPU on a computer, Fast on a phone', apply: () => { if (game.sceneName === 'adventure') lighting(); } });\n  addEventListener('keydown', e => { if (e.code !== 'KeyC' || e.repeat || game.sceneName !== 'adventure' || game.paused) return; const v = game.settings.advCamera === 'rooms' ? 'scroll' : 'rooms'; game.settings.set('advCamera', v); game.note('CAMERA: ' + v.toUpperCase()); });\n  const sliding = () => !!game.cam.room && game.cam.moving;   // a room slide holds the world still\n  const roomOf = x => Math.floor(x / ROOM[0]), mod = (a, n) => ((a % n) + n) % n, near = (cx, cy, tag) => map.floorAt((cx + .5) * T, (cy + .5) * T) === tag;\n  const txt = (g, s, x, y, c, o) => E.font.text(g, s, x, y, c, { shadow: '#07040c', outline: false, ...o });\n  const talkable = () => npcs.find(n => E.dist(hero, n) < 34);\n  // CONTACT SHADOWS: a darker core in a soft ellipse, cool purple\n  const shadow = (r, x, y, rad) => { r.shadow(x, y, rad, .28, '#2a2048'); r.shadow(x, y, rad * .6, .22, '#2a2048'); };\n\n  /* ---- FLOORS: floorTex(x, y, tag) = [r, g, b(, glow)], baked once per view ---- */\n  // AUTOTILING: distance to the nearest side bordering another floor, corners rounded by K\n  function edge(cx, cy, lx, ly, tag, K) {\n    const o = (dx, dy) => { const t = map.floorAt((cx + dx + .5) * T, (cy + dy + .5) * T), c = map.cell(cx + dx, cy + dy); return tag === 'water' ? t !== tag && t !== 'bridge' && !c : t !== tag || c !== 0; };\n    const a = Math.min(o(-1, 0) ? lx : 99, o(1, 0) ? T - lx : 99), b = Math.min(o(0, -1) ? ly : 99, o(0, 1) ? T - ly : 99);\n    return a < K && b < K ? K - Math.hypot(K - a, K - b) : Math.min(a, b);\n  }\n  // GRASS: TUFT and BLOOM stamps on a staggered lattice in SCREEN pixels\n  function grass(sx, sy, G) {\n    const row = Math.floor(sy / 7), X = sx + (row & 1) * 6, k = E.hash2(Math.floor(X / 12), row), pat = k < .07 ? BLOOM : k < .62 ? TUFT : null;\n    const ch = pat && (pat[mod(Math.floor(sy), 7) - 2] || '')[mod(Math.floor(X), 12) - (pat === BLOOM ? 5 : 4)];\n    return ch === 'l' ? G[3] : ch === 'd' ? G[1] : ch === 'y' ? PETAL[1] : ch === 'w' ? PETAL[k < .035 ? 0 : 2] : G[2];\n  }\n  function ground(x, y, tag) {\n    const cx = Math.floor(x / T), cy = Math.floor(y / T), lx = x - cx * T, ly = y - cy * T, room = roomOf(x), [sx, sy] = game.view.p(x, y), h = E.hash2(cx, cy);\n    const e = tag && tag !== 'carpet' ? edge(cx, cy, lx, ly, tag, tag === 'water' ? 7 : tag === 'pave' ? 1 : 4) : 99;\n    if (e < 0) tag = null;   // outside a rounded corner\n    // WATER: bank, lip, shadow, reflection, foam, then depth BANDS bent by value noise\n    if (tag === 'water') {\n      if (e < 2.6) return e < 1 ? STONE[0] : E.hash2(Math.floor(y / 3), cx) < .2 ? STONE[1] : STONE[e < 1.8 ? 4 : 3];\n      const w = (E.noise2(x / 6, y / 9) - .5) * 5, foam = near(cx, cy - 1, 'bridge') ? ly : near(cx, cy + 1, 'bridge') ? T - ly : 99;\n      if (e < 3.3 || foam < 3 + w + E.hash2(Math.floor(sx / 2), 1) * 2) return foam < 1.5 + w ? SKY[1] : WATER[4];\n      if (!near(cx - 1, cy, 'water') && lx < 6 + w) return WATER[0];\n      if (map.cell(cx + 1, cy) > 0 && lx > 11 + w) return REFLECT;\n      const px_ = lx - 4 - h * 8, py_ = ly - 4 - h * 7, pad = Math.hypot(px_, py_);\n      if (h < .3 && pad < 3) return LILY[pad < 1 ? 4 : px_ > .5 && Math.abs(py_) < .5 ? 1 : 2];\n      const k = mod(Math.floor(sx) + Math.floor(sy / 6) * 7, 23);   // sky glints on every 6th row\n      return mod(Math.floor(sy), 6) === 0 && k < 4 ? SKY[k ? 0 : 1] : WATER[e + w < 8 ? 3 : e + w < 12 ? 2 : 1];\n    }\n    if (tag === 'bridge') return (ly < 2 && !near(cx, cy - 1, tag)) || (ly > T - 2 && !near(cx, cy + 1, tag)) ? DIRT[0] : E.tex.planks(y, x, { base: '#b07c44', dark: '#8a5c32', line: '#4a2e1a' });\n    // path and paving: grass erodes the edge by a hash; dirt, pebbles\n    const q = E.hash2(Math.floor(sx / 6), Math.floor(sy / 5)), b = E.hash2(Math.floor(x / 4), Math.floor(y / 4)) * 3;\n    if (tag === 'path') return e < b ? grass(sx, sy, GRASS[room][1]) : e < b + .9 ? DIRT[0] : q < .16 && mod(Math.floor(sx), 6) < 2 && mod(Math.floor(sy), 5) === 0 ? DIRT[q < .07 ? 4 : 1] : DIRT[e < b + 1.8 ? 1 : 2];\n    if (tag === 'plaza') return e < .9 ? PLAZA.mortar : E.tex.flagstone(x, y, PLAZA, 8);\n    if (tag === 'bed') return e < 1 ? STONE[0] : e < 2.4 ? STONE[3] : SOIL[mod(ly, 4) < 1 ? 0 : 2];\n    const c = Math.min(near(cx - 1, cy, tag) ? 99 : lx, near(cx + 1, cy, tag) ? 99 : T - lx), m = Math.abs(mod(x, 32) - 16) + Math.abs(ly - 8);   // carpet\n    if (tag === 'carpet') return c < 1 ? CARPET[0] : c >= 2 && c < 3 ? GOLD[1] : m > 5 && m < 6.5 ? GOLD[0] : m < 2.5 ? GOLD[2] : CARPET[1];\n    const f = E.tex.flagstone(x, y, PAVE);   // paving: moss in the seams\n    if (tag === 'pave') return e < b ? grass(sx, sy, GRASS[1][1]) : e < b + .9 ? PAVE.mortar : f === PAVE.mortar && E.hash2(Math.floor(x / 6), Math.floor(y / 6)) < .45 ? GRASS[1][1][1] : f;\n    const n = E.noise2(x / 40 + room * 9, y / 40);   // lawn: three shades in slow patches\n    if (room < 2) return grass(sx, sy, GRASS[room][n < .36 ? 0 : n > .64 ? 2 : 1]);\n    const dr = Math.hypot(x - relic.x, y - relic.y), a = Math.atan2(y - relic.y, x - relic.x), P = TILE[(cx + cy) & 1];\n    if (Math.abs(dr - 15) < .7 || Math.abs(dr - 10.5) < .6 || (dr > 11 && dr < 14.5 && Math.abs(mod(a / Math.PI * 4, 1) - .5) < .06)) return RUNE;   // shrine: a rune circle...\n    if (dr < 26) return dr > 24.8 ? TILE[1][0] : dr > 23.2 ? TILE[0][4] : TILE[dr < 20 ? 1 : 0][2];   // ...on a round dais with a lit rim...\n    if (Math.min(lx, ly) < 1.2) return P[lx < .8 || ly < .8 ? 0 : 4];   // ...on marble tiles\n    return lx > T - 1.2 || ly > T - 1.2 ? P[1] : mod(lx + ly, 13) < 1 ? P[3] : P[2];\n  }\n  // PAINTED LIGHT (Legend of Mana): a wall taller than its distance toward the low sun shades a point cool purple\n  const SHADE = [.64, .68, .86];\n  function floorTex(x, y, tag) {\n    const c = ground(x, y, tag);\n    for (let d = 2; d < 18; d += 2) if (map.heightAt(x - d, y - d * .3) > d * 1.8) return c.map((v, i) => i < 3 ? v * SHADE[i] : v);\n    return c;\n  }\n\n  // trees and pines varied by hashes\n  const tree = (cx, cy, pine) => { const v = E.hash2(cx * 5, cy * 3); return { prop: pine || v > .72 ? 'pine' : 'tree', size: 1 + v * .45, color: ['#2f7a3c', '#3f8a45', '#2a6a44', '#4a8a3a'][Math.floor(v * 4)], x: (cx + .3 + E.hash2(cy, cx) * .4) * T }; };\n  function start() {\n    map = new E.TileMap({ rows: ROWS, legend: LEGEND, types: TYPES, floorTex, ao: 8 });\n    relic = map.find('relic'); entry = map.find('entry'); relic.x += T / 2; entry.x += T / 2;   // on the room's center line\n    // the camera stays inside the map (the forest round the rooms fills a tall screen); update() sets rooms or scroll\n    game.cam.bounds = v => { const b = map.bounds(v); return { x0: b.x0 + 9, y0: b.y0 + 9, x1: b.x1 - 9, y1: b.y1 - 9 }; }; game.cam.room = game.settings.advCamera === 'scroll' ? null : ROOM;\n    const at = map.find('hero');\n    // SWORD (Secret of Mana): J chains slash, backslash, spin, kept low (a raised blade crosses his face); short holds (hold)\n    // let the follow-through settle instead of freezing; hold J to CHARGE\n    hero = Object.assign(new E.Body({ ...at, r: 4.5 }), { hp: 3, max: 3, facing: Math.PI / 2, inv: 0, hurt: 0, charge: 0, rig: RIGS.hero(),\n      combo: new E.Combo([new E.Attack('slash', { z0: -8, z1: -11, a1: -1.2, wind: .12, hold: .1 }), new E.Attack('backslash', { z0: -11, z1: -9, a1: 1.2, hold: .1 }), new E.Attack('spin', { ...WAIST, hold: .15 })], { window: .3 }),\n      spin: new E.Attack('spin', { ...WAIST, active: .36, reach: 10, lean: .3, hold: .12 }) });\n    hero.sw = hero.combo;   // the attack running now\n    npcs = Object.keys(NPCS).map(k => { const n = Object.assign({ said: 0, t: 0, k: 0, hi: 0, nod: 0, face: Math.PI / 2, rig: RIGS[k]() }, map.find(k), NPCS[k]); n.dir = n.look = n.face; n.job = n.chore && n.chore(); return n; });\n    things = [];\n    for (const s of map.spawns) for (const d of [].concat(s.tag === 'tree' ? tree(s.cx, s.cy) : THINGS[s.tag] || []))\n      things.push(Object.assign({ tag: s.tag, prop: s.tag, x: s.x + (d.dx || 0), y: s.y, room: roomOf(s.x) }, d));\n    // one pass over the cells: roofs, pines, weeds, flower beds, bridge rails, tufts\n    const box = {};\n    for (let cy = 0; cy < map.h - 1; cy++) for (let cx = 0; cx < map.w; cx++) {\n      const c = map.cell(cx, cy), v = E.hash2(cx * 3, cy * 7 + 1), X = (cx + .5) * T, Y = (cy + .5) * T, tag = map.floorAt(X, Y), add = o => things.push(Object.assign({ x: X, y: Y }, o));\n      if (c === 5 || c === 8) { const b = box[c] || (box[c] = [cx, cy, cx, cy]); b[2] = cx; b[3] = cy; }\n      if (map.spawns.some(s => s.cx === cx && s.cy === cy)) continue;\n      if (c === 9 && cy === PAD && v < .5) add(tree(cx, cy, true));\n      else if ((c === 3 || c === 4) && v < .45) add({ prop: 'bush', size: .7 + v * .6, color: '#5a8a44' });\n      else if (tag === 'bed') {\n        for (const k of [-3, 3]) add({ prop: 'flowers', size: 1.1, x: X + k, y: Y + k, color: k < 0 ? ['#f06a9a', '#f0a040', '#ffffff'][cx % 3] : '#8ab0ff', color2: '#fff4a0' });\n        if (!near(cx, cy + 1, 'bed')) add({ prop: 'fence', size: 1.2, y: Y + 8, color: '#b08050' });\n      }\n      else if (tag === 'bridge') for (const s of [-1, 1]) { if (!near(cx, cy + s, 'bridge')) add({ prop: 'fence', size: 1.2, y: Y + s * 7, color: '#8a5a32' }); }\n      else if (!c && !tag && X < 2 * ROOM[0] && v < .16) add({ prop: v < .06 ? 'flowers' : 'grass', x: X + (E.hash2(cx, cy) - .5) * 10, y: Y + (E.hash2(cy, cx) - .5) * 8,\n        color: v < .06 ? '#f06a9a' : X > ROOM[0] ? '#5a9a4a' : '#6ab850', color2: '#fff4a0' });\n    }\n    roofs = Object.keys(box).map(id => { const [a, b, c, d] = box[id]; return { x0: a * T, y0: b * T, x1: (c + 1) * T, y1: (d + 1) * T, h: TYPES[id].h, C: E.ramp(TYPES[id].top, 5) }; });\n    items = [{ kind: 'relic', x: relic.x, y: relic.y }];\n    // bats roost (hang; wake = time since); stun = flinch; dying = death; streak = claw marks; hold = an impact frame\n    foes = Object.keys(FOES).flatMap(k => map.findAll(k)).map(s => { const F = FOES[s.tag], moves = (F.moves || []).map(m => new E.Attack(m, { recover: .45, hold: .5, ...F.tune }));\n      return Object.assign(new E.Body({ ...s, r: 5.5, friction: 6, ...(F.fly && { z: F.fly + 8, gravity: 0, onGround: false }) }), { kind: s.tag, hp: F.hp, fly: F.fly, hang: !!F.fly, home: { ...s },\n        t: 1 + Math.random(), flash: 0, stun: 0, swoop: 0, wake: 9, streak: [], face: Math.PI / 2, room: roomOf(s.x), look: F.look(), moves, atk: moves[0] }); });\n    pets = map.findAll('cat').map(s => Object.assign(new E.Body({ ...s, r: 4 }), { t: 1, home: { ...s }, look: new E.Blob({ R: 4, colors: CAT, ears: 'cat', tail: true, feet: true, mouth: true, face: 'front' }) }));\n    shots = new E.Bullets(game, { plane: 'ground' }); talk = new E.Dialog(game, WIN);\n    fx = []; won = false; keys = 0; gems = 0; area = { room: 0, t: 2.6 }; held = null;\n    // the floor is lit already; GPU lighting (if any) adds light pools and shadows\n    L.enabled = false; lighting(); mood(MOOD[0]); A.music('adventure');\n    game.input.touchSet('attack', 'SWORD');\n  }\n  // DIALOG: E.Dialog types and pages; portrait: a live close-up of the speaker\n  const say = (who, name, text) => { speaker = who; talk.say(typeof text === 'function' ? text() : text, { name, portrait: who.rig, portraitSize: 50, portraitOpts: { zoom: 2.6, turn: -.25, cape: false, bg: FACE_BG } }); };   // (at the bottom, clear of the touch buttons)\n  function hurtHero(ang) {   // flinch, knockback, blink; true if it hurt\n    if (hero.inv > 0 || won || hero.hp <= 0) return false; hero.hp -= .5; hero.inv = 1; hero.hurt = .25; hero.charge = 0; hero.combo.cancel(); hero.spin.cancel(); hero.push(Math.cos(ang) * 160, Math.sin(ang) * 160);\n    game.hitFx(hero.x + Math.cos(ang) * 3, hero.y + Math.sin(ang) * 3, 12, { power: .9, angle: ang + Math.PI, color: '#ff8a6a', sound: 'hurt' }); game.flash('#ff4a3a', .06, .4);\n    if (hero.hp <= 0) { poof(hero.x, hero.y, 0, 1.2); game.after(.8, () => game.go('over', { from: 'adventure' })); }\n    return true;\n  }\n  const shiver = k => Math.sin(game.time * 90) * k;   // a tremble (tells, charging)\n  // a sword hit (k = power): game.hitFx, a FLINCH (stun, squash, hurt pose), knockback; the last starts the death\n  function strike(f, k = 1) {\n    const h = hero, an = E.angleTo(h, f), dmg = Math.round(E.randInt(8, 12) * k);\n    f.hp -= dmg; f.dmg = dmg; f.hitT = game.time; f.flash = .06; f.stun = .3; f.swoop = 0; f.aim = null; if (f.atk) f.atk.cancel(); f.look.kick(-6);\n    E.knockback(h, f, (f.hp > 0 ? 220 : 100) * k, f.fly ? 0 : f.hp > 0 || f.moves.length ? 60 : 140);   // a dead rabite pops up\n    game.hitFx(lerp(h.x, f.x, .6), lerp(h.y, f.y, .6), 10 + f.z * .5, { angle: an, power: k });\n    if (f.hp <= 0) { f.dying = f.fly ? .6 : f.moves.length ? 1.2 : .7; f.gravity = 700; f.hang = false; game.freeze(.1); A.sfx('stomp'); }\n  }\n  function vanish(f) {   // after the death animation: a poof, bits and a drop\n    f.dead = true; poof(f.x, f.y, f.z, f.kind === 'mage' ? 1.4 : 1);\n    if (f.kind === 'mage') { P.glints(f.x, f.y, 14, 8, '#f0b0ff', 18); game.flash('#f0d0ff', .08, .5); A.sfx('explode', { pitch: 1.3 }); }\n    else P.bits(f.x, f.y, 6 + f.z, 14, f.look instanceof E.Blob ? [f.look.C.dk, f.look.C.base, f.look.C.lt] : ['#8ab84a', '#8a5a32', '#c8d0d8']);\n    items.push({ kind: hero.hp < hero.max && E.chance(.5) ? 'heart' : 'gem', x: f.x, y: f.y });\n  }\n  // push bodies out of solid props\n  const settle = b => { for (const t of things) if (t.r && !t.dead && !t.hidden) { const dx = b.x - t.x, dy = b.y - t.y, dd = Math.hypot(dx, dy) || 1, m = b.r + t.r; if (dd < m) { b.x = t.x + dx / dd * m; b.y = t.y + dy / dd * m; } } };\n  // prize: face the camera and CHEER. Charging holds CHARGE's wind-up, deeper as it builds\n  function poseHero(dt) {\n    const h = hero, cheer = held && held.t > 0, still = talk.open || sliding() || cheer, v = game.view;\n    h.rig.update(dt, { x: h.x, y: h.y, z: h.z, vx: still ? 0 : h.vx, vy: still ? 0 : h.vy, facing: cheer ? Math.atan2(v.fy, v.fx) : h.facing, hurt: h.hurt > 0, pose: cheer ? 'cheer' : null,\n      attack: cheer ? null : h.charge > .15 ? { spec: CHARGE, phase: 'wind', u: Math.min(1, (h.charge - .15) / .45) } : h.sw.state });\n  }\n  // NPCS LIVE: idle poses, glances, chores; turn to the hero when near (a hello per visit); gesture and nod when speaking\n  function npcLife(n, dt) {\n    const d = E.dist(hero, n), near = d < n.near, says = talk.open && speaker === n, g = says && n.talk[Math.floor(game.real / .9) % n.talk.length];\n    if ((n.t -= dt) <= 0) { n.t = E.rand(2, 4.5); n.pose = n.idle[n.k++ % n.idle.length]; n.look = n.face + E.rand(-.7, .7) * (n.job && n.pose ? .3 : 1); }   // at work: eyes on the work\n    if (n.wave && near && !n.met) n.hi = 2;\n    n.met = near || n.met && d < n.near + 24; n.hi -= dt;   // waves again after he left\n    if ((n.hi > 0 || says && talk.typing) && (n.nod -= dt) <= 0) { n.nod = n.hi > 0 ? .57 : E.rand(.25, .45); n.rig.kick(-2.5); }   // a nod every few words, a bob per wave\n    const job = n.job && n.pose && !near && n.job;   // pats the soil, pauses, pats\n    if (job) { if (!job.busy && Math.random() < dt * 1.5) job.start(); job.update(dt); }\n    // a hello faces the camera, a speaker mostly (a stage actor): gestures clear the face\n    const cam = Math.atan2(game.view.fy, game.view.fx), to = E.angleTo(n, hero);\n    n.dir = E.approachAng(n.dir, n.hi > 0 ? cam : says ? to + E.angDiff(to, cam) * .6 : near ? to : n.look, dt * 6);\n    n.rig.update(dt, { x: n.x, y: n.y, facing: n.dir, pose: g || (n.hi > 0 ? 'wave' : near ? null : n.pose), expr: (n.hi > 0 || says) && 'smile', attack: job ? job.state : null });\n  }\n  function update(dt) {\n    const h = hero, room = roomOf(h.x), inp = game.input, npc = talkable();\n    inp.touchSet('confirm', talk.open ? 'NEXT' : 'TALK', talk.open || !!npc);   // a CONTEXT button: there only when there is someone to talk to\n    if (held) held.t -= dt;\n    for (const n of npcs) npcLife(n, dt);\n    if (talk.update(dt)) { poseHero(dt); return; }   // dialog pauses the world\n    mood(MOOD[room]);\n    if (room !== area.room) area = { room, t: 2.6 }; else area.t -= dt;\n    if (sliding() || won || held && held.t > 0) { poseHero(dt); return; }   // the room slides or the hero cheers\n    h.inv -= dt; h.hurt -= dt; if (h.hp <= 0) return;\n    if (npc && inp.pressed('confirm')) return void say(npc, npc.name, npc.lines[npc.said++ % npc.lines.length]);\n    // screen-relative keys become a ground direction; swings root the hero\n    const mv = inp.move(), md = game.view.screenDirToGround(mv[0], mv[1]), sp = h.sw.busy ? 20 : h.charge > .15 ? 45 : 80;\n    if (Math.hypot(md[0], md[1]) > .1 && !h.sw.busy) h.facing = Math.atan2(md[1], md[0]);\n    const hurt = h.hurt > 0, acc = (hurt ? 400 : 900) * dt; h.vx = approach(h.vx, hurt ? 0 : md[0] * sp, acc); h.vy = approach(h.vy, hurt ? 0 : md[1] * sp, acc);\n    // sword: one hit per target per swing; a press chains the combo; holding J charges, letting go spins\n    if (inp.buffered('attack') && !h.spin.busy && h.combo.press()) { inp.consume('attack'); h.charge = 0; }\n    if (inp.down('attack') && !h.sw.busy) { if (h.charge < .6 && (h.charge += dt) >= .6) { A.sfx('charge'); P.glints(...h.rig.tip(), 6); game.flash('#fff4c0', .1, .35); h.rig.kick(5); } }\n    else { if (h.charge >= .6 && h.spin.start()) game.shake(2); h.charge = 0; }\n    if (h.charge >= .6 && Math.random() < dt * 12) P.glints(...h.rig.tip(), 1, '#fff4a0', 4);\n    for (const a of [h.combo, h.spin]) if (a.update(dt) === 'active') A.sfx(a === h.combo && h.combo.step < 2 ? 'swing' : 'whoosh');\n    const sw = h.sw = h.spin.busy ? h.spin : h.combo, round = sw === h.spin || h.combo.step === 2;   // spins hit all around\n    const reach = t => E.inArc(h, h.facing, t, round ? 26 : 22, round ? Math.PI : 1.4);\n    sw.hits(foes, f => f.hp > 0 && reach(f), f => strike(f, sw === h.spin ? 1.5 : 1));\n    // bushes and pots break (pots hide a gem)\n    sw.hits(things, t => t.cut && reach(t), t => {\n      t.dead = true; P.bits(t.x, t.y, 6, 14, t.cut); poof(t.x, t.y, 0, .6); A.sfx(t.prop === 'pot' ? 'bump' : 'whoosh');\n      const kind = t.drop || E.chance(.5) && (E.chance(.7) ? 'gem' : 'heart'); if (kind) items.push({ kind, x: t.x, y: t.y });\n    });\n    h.update(dt, map); settle(h);\n    // a cleared ruin reveals the key chest\n    const chest = things.find(t => t.tag === 'chest'), gate = things.find(t => t.tag === 'gate');\n    if (chest.hidden && foes.every(f => f.room !== 1 || f.dead)) { chest.hidden = false; poof(chest.x, chest.y, 0, 1.3); P.glints(chest.x, chest.y, 10, 8); A.sfx('secret'); }\n    if (!chest.hidden && !chest.open && E.dist(h, chest) < 15) {\n      chest.open = true; keys++; held = { spr: KEYS[1], t: 1.6 }; A.sfx('key'); P.glints(h.x, h.y, 40, 10); game.flash('#fff4c0', .15, .5);\n      game.after(1.6, () => say(h, 'HERO', 'I got the SHRINE KEY! Now the great door in the ruins will open.'));\n    }\n    // the key opens the door and warps the hero inside\n    if (keys > 0 && !gate.open && E.dist(h, gate) < 22) {\n      gate.open = true; keys--; A.sfx('door'); game.shake(3); P.dust(gate.x, gate.y + 10, 2, 14, { color: '#8a7a6a', speed: 50 });\n      game.after(.5, () => { Object.assign(h, { x: entry.x, y: entry.y, vx: 0, vy: 0, facing: -Math.PI / 2 }); game.cam.snap = true; game.flash('#07040c', .5); A.sfx('warp'); });\n    }\n    for (const it of items) if (!it.got && it.kind === 'relic' && Math.random() < dt * 5) P.glints(it.x, it.y, 22, 1, '#bff8ff', 14);   // the relic sparkles\n    for (const it of items) if (!it.got && E.dist(it, h) < (it.kind === 'relic' ? 15 : 10)) {\n      it.got = true; P.glints(it.x, it.y, 6, 4); if (it.kind === 'gem') { gems++; A.sfx('coin'); } else if (it.kind === 'heart') { h.hp = Math.min(h.max, h.hp + 1); A.sfx('heal'); }\n      else { won = true; held = { spr: CRYSTALS[1], t: 99 }; game.flash('#ffffff', .2); P.glints(it.x, it.y, 20, 24, '#bff8ff', 30); A.music('victory'); game.after(6, () => game.go('title')); }\n    }\n    // enemies act only in the hero's room. A hit stuns (no AI); the last plays the death, then vanish()\n    for (const f of foes) {\n      if (f.dead) continue; f.flash -= dt; f.t -= dt; f.stun -= dt; f.wake += dt;\n      const on = f.room === room, dx = h.x - f.x, dy = h.y - f.y, dd = Math.hypot(dx, dy) || 1;\n      if (f.dying > 0) { if ((f.dying -= dt) <= 0) vanish(f); }\n      else if (f.stun > 0) { /* flinch: knocked back */ }\n      else if (f.kind === 'rabite') {   // hops about; near the hero it crouches and shivers (the tell), POUNCES\n        if (on && f.onGround && f.t <= 0) {\n          const chase = dd < 72 || f.tell, a = chase ? Math.atan2(dy, dx) : E.dist(f, f.home) > 20 ? E.angleTo(f, f.home) : Math.random() * TAU;\n          if (dd < 34 && !f.tell) { f.tell = true; f.t = .5; }\n          else { const v = f.tell ? 210 : chase ? 75 : 35; f.push(Math.cos(a) * v, Math.sin(a) * v, 0); f.jump(chase ? 150 : 110); f.look.kick(f.tell ? 7 : 4);\n            f.t = f.tell ? 1.2 : chase ? .6 + Math.random() * .6 : .8 + Math.random(); f.tell = false; }\n        }\n      } else if (f.kind === 'bat') {   // roosts, weaves overhead, rears up (the tell), SWOOPS\n        if (f.hang) { if (on && dd < 64) { f.hang = false; f.wake = 0; f.look.kick(8); A.sfx('whoosh', { pitch: 1.8 }); } }   // woken\n        else {\n          if (on && f.swoop <= 0 && f.t <= 0 && dd < 48) { f.swoop = 1.1; f.t = 2.6; A.sfx('whoosh', { pitch: 1.6 }); }\n          f.swoop -= dt; const rear = f.swoop > .75, dive = f.swoop > 0 && !rear, acc = (dive ? 500 : 260) * dt;\n          const a = Math.atan2(dy, dx) + (f.swoop > 0 ? 0 : Math.sin(game.time * 4 + f.y) * 1.1), s = !on || rear ? 0 : dive ? 90 : 30;\n          f.vx = approach(f.vx, Math.cos(a) * s, acc); f.vy = approach(f.vy, Math.sin(a) * s, acc);\n          f.onGround = false; f.vz = ((rear ? f.fly + 14 : dive ? 5 : f.fly + Math.sin(game.time * 3 + f.x) * 3) - f.z) * (rear ? 8 : 5);\n        }\n      } else if (f.kind === 'goblin') {   // winds up (crouch, lean back, shiver, glint: the TELL), CLAWS or SLAMS\n        const busy = f.atk.busy, go = on && !busy && dd > 17 ? 32 : 0; if (!busy) f.face = Math.atan2(dy, dx);\n        f.vx = approach(f.vx, dx / dd * go, 300 * dt); f.vy = approach(f.vy, dy / dd * go, 300 * dt);\n        if (on && !busy && dd < 21 && f.t <= 0) { f.atk = E.pick(f.moves); f.atk.start(); f.look.kick(-4); f.t = 1.4; P.glints(...f.look.head(), 2, '#ffe070', 3); }\n        const ph = f.atk.update(dt); if (ph === 'active') A.sfx('swing', { pitch: .75 });\n        if (ph === 'recover' && f.atk.spec.name === 'twohand') { const [x, y] = f.look.hand(); P.dust(x, y, 0, 10); game.shake(2); A.sfx('stomp'); }   // the slam lands\n        f.atk.hits([h], t => E.inArc(f, f.face, t, 21, 1.3), () => hurtHero(f.face));\n      } else if (on) {   // mage: sidesteps, AIMS (the cast's end pose backwards), CASTS (a ring grows), fires as the staff points\n        const c = f.atk; f.face = Math.atan2(dy, dx);\n        if (c.update(dt) === 'recover') { const [x, y, z] = f.look.hand(), [vx, vy] = E.pattern.aim({ x, y }, h, 100); shots.fire({ x, y, z, vx, vy, r: 3, team: 'foe', color: '#e060ff', core: '#ffe8ff' }); P.glints(x, y, z, 5, '#ff80e0', 8); P.glints(f.x, f.y, 2, 10, '#ff80e0', 14); A.sfx('laser', { pitch: .8 }); }\n        f.aim = !c.busy && f.t < .6 && E.move('cast', Math.max(0, f.t / .6), 'recover');\n        if (!c.busy && f.t <= 0) { c.start(); f.t = 2.4; A.sfx('charge', { pitch: 1.5, vol: .06 }); }\n        if (c.busy || f.aim) f.vx = f.vy = 0;   // planted\n        else { const s = Math.sin(game.time * .9 + f.x) > 0 ? 22 : -22; f.vx = -dy / dd * s; f.vy = dx / dd * s; }\n      }\n      if (!f.hang) f.update(dt, map); if (!f.fly) settle(f);\n      const dead = f.dying > 0, air = !f.onGround && !f.fly;\n      // Blob: squash, stretch, squash on landing; a woken bat drops, flips, unfurls; wings beat fast to rear, fold to dive; the dead flip belly-up\n      if (f.look instanceof E.Blob) { if (f.landed) f.look.kick(dead ? -9 : -4);\n        f.look.update(dt, { squash: dead ? -.4 : f.tell ? -.42 + shiver(.05) : air ? clamp(f.vz / 600, -.2, .25) : f.fly ? Math.sin(game.time * 14) * .06 : f.t < .12 ? -.18 : 0,\n          look: [dx, dy], walk: air ? 1 : 0, squint: dead || f.stun > 0, hang: f.hang || f.wake < .15 || dead && f.dying < .55, flap: f.hang || dead ? 0 : clamp((f.wake - .15) * 2.5, 0, 1) * (f.swoop > .75 ? 1.6 : f.swoop > 0 ? 0 : 1) }); }\n      else f.look.update(dt, { x: f.x, y: f.y, z: f.z, vx: f.vx, vy: f.vy, facing: f.face, hurt: f.stun > 0, attack: f.atk.state || f.aim || null,\n        pose: dead ? 'die' : null, expr: f.kind === 'goblin' && 'angry' });   // death: stagger, the knees give, topple\n      // contact on first touch (mid-pounce too; a diving bat where it meets him ON SCREEN, sooner from behind), then bounce off\n      const behind = Math.max(0, dx * game.view.fx + dy * game.view.fy), reach = f.fly ? (f.swoop > 0 && f.swoop < .75 ? 10 + behind * .65 : f.z < 9 ? 10 : 0) : f.r + h.r;\n      if (on && !dead && f.kind !== 'goblin' && dd < reach && hurtHero(Math.atan2(dy, dx))) { f.vx = f.vy = f.swoop = 0; E.knockback(h, f, 90); }\n    }\n    shots.update(dt, map); shots.hit([h], b => hurtHero(Math.atan2(b.vy, b.vx)), 'foe');\n    for (const c of pets) {   // the cat strolls and dozes\n      if ((c.t -= dt) <= 0) { const a = E.dist(c, c.home) > 18 ? E.angleTo(c, c.home) : E.rand(0, TAU), go = E.chance(.6); c.t = go ? 1.2 : E.rand(2, 4); const v = go ? 22 : 0; c.vx = Math.cos(a) * v; c.vy = Math.sin(a) * v; }\n      c.update(dt, map); settle(c); const walk = Math.min(1, Math.hypot(c.vx, c.vy) / 20);\n      c.look.update(dt, { look: walk ? [c.vx, c.vy] : [h.x - c.x, h.y - c.y], walk, squint: !walk && E.dist(c, h) > 50, squash: walk ? 0 : .12 });\n    }\n    // ambient life: petals, fireflies, embers, smoke, fountain spray, river foam\n    const rx = (room + Math.random()) * ROOM[0], ry = OY + E.rand(T, ROOM[1] - T);\n    if (Math.random() < dt * 4) P.add(room === 0 ? { kind: 'bit', x: rx, y: ry, z: 50, vx: 14, vy: 5, vz: -9, g: 3, max: 5, color: E.pick(['#ffb0c8', '#fff0f4']) }\n      : room === 1 ? { kind: 'ember', x: rx, y: ry, z: E.rand(6, 26), vx: E.rand(-5, 5), vy: E.rand(-5, 5), vz: 3, max: 2.5, color: '#d8ff6a' }\n      : { kind: 'ember', x: rx, y: ry, z: 2, vz: 16, vx: E.rand(-4, 4), max: 2, color: '#ff8a3a' });\n    for (const f of roofs) if (roomOf(f.x1) === room && Math.random() < dt * 2.5) P.smoke(f.x1 - 12, f.y0 + 14, f.h + 16, 1, { size: 2.2, color: '#e4e2ee', dark: '#b0acc0', light: '#ffffff' });\n    for (const t of things) if (t.tag === 'fountain' && t.room === room && Math.random() < dt * 14) P.add({ kind: 'bit', x: t.x, y: t.y, z: 22, vx: E.rand(-15, 15), vy: E.rand(-6, 6), vz: 40, g: 260, max: .5, color: E.pick(['#ffffff', '#a8e0ff']) });\n    if (room === 0 && Math.random() < dt * 6) P.add({ kind: 'bit', x: E.rand(11.3, 12.7) * T, y: OY + E.pick([2, 8]) * T + E.rand(0, 46), z: 0, vy: 26, max: 1.2, color: '#d8f0ff' });\n    poseHero(dt); game.focus(h.x, h.y, 10);\n    const rooms = game.settings.advCamera !== 'scroll' && game.zoom <= 1 && !game.yaw;   // zoomed or turned: it follows the hero\n    game.cam.room = rooms ? ROOM : null; game.cam.smooth = rooms ? .18 : .12;\n  }\n\n  /* ---- DRAWING ---- */\n  // POOF: five crisp puffs, aged by game.time (hit-stop holds it)\n  const poof = (x, y, z, s) => fx.push({ x, y, z: z + 4 * s, s, t: game.time, life: .5 });\n  function drawFx(r) {\n    E.prune(fx, f => game.time - f.t > f.life);\n    for (const f of fx) r.queue(f.x, f.y, f.z, g => {\n      const u = (game.time - f.t) / f.life, [x, y] = r.w(f.x, f.y, f.z), R = f.s * (u < .25 ? 3 + u * 16 : 7 - (u - .25) * 6);\n      for (const [c, k, o, d] of [['#4a3a5a', .62, 1, 0], ['#ffffff', .62, 0, 0], ['#d8d0ec', .32, 0, 1.5]])\n        for (const [dx, dy] of [[0, 0], [-1, -.6], [1, -.6], [-.7, .5], [.7, .5]]) px.disc(g, x + dx * R * .8 + d, y + dy * R * .6 - u * 6 + d, R * k + o, c);\n    }, { bias: .6 });\n  }\n  // BUSHES of LEAF CLUMPS, no two alike: one outline around the mass, a body and lit top per clump, leaf dots, blossoms\n  function bush(g, x, y, s, C, k) {\n    const H = i => E.hash2(k, i), n = 4 + Math.floor(H(0) * 4), cl = [];\n    for (let i = 0; i < n; i++) { const a = H(i + 9) - .5, b = H(i + 19); cl.push([x + a * (8 + H(1) * 12) * s, y - (3 + b * 4 + (.5 - Math.abs(a)) * 8) * s, (3 + b * 2) * s]); }\n    for (const [X, Y, R] of cl) px.disc(g, X, Y, R + 1, C[0]);\n    for (const [X, Y, R] of cl) { px.disc(g, X, Y, R, C[1]); px.disc(g, X - R * .3, Y - R * .35, R * .6, C[2]); }\n    for (let i = 0; i < n * 3; i++) { const [X, Y, R] = cl[i % n]; px.dot(g, X + (H(i + 29) - .6) * R * 1.5, Y + (H(i + 59) - .7) * R * 1.4, H(2) < .3 && i % 3 < 1 ? '#ffc8dc' : C[3 + i % 2]); }\n  }\n  // PITCHED ROOF: a shaded back half and a ridge cap read as two slopes; an eave lip and shadow; a chimney of r.box\n  function roof(r, f) {\n    const P = r.w.bind(r), m = (f.y0 + f.y1) / 2 - 1, z = f.h + .3, C = f.C, band = (x0, x1, y0, y1, z0, z1) => [P(x0, y0, z0), P(x1, y0, z0), P(x1, y1, z1), P(x0, y1, z1)];\n    r.queue(f.x1 - 1, f.y1 - 1, f.h, g => {\n      px.blend(g, .32, 'multiply', () => px.poly(g, band(f.x0, f.x1, f.y0, m, z, z), '#4a3a7a'));\n      px.blend(g, .4, 'multiply', () => px.poly(g, band(f.x0, f.x1, f.y1 + .1, f.y1 + .1, f.h - 2, f.h - 7), '#3a2a5a'));\n      px.poly(g, band(f.x0 - 1.5, f.x1 + 1.5, f.y1 - 1, f.y1 + 1.5, z, f.h - 1.5), C[0]);   // eave lip\n      px.poly(g, band(f.x0 - 1, f.x1 + 1, m - 1.5, m + 1.5, z + .8, z + .8), C[1]);   // ridge cap\n      px.line(g, ...P(f.x0 - 1, m - 1.5, z + .8), ...P(f.x1 + 1, m - 1.5, z + .8), C[4]);\n      const cx = f.x1 - 12, cy = f.y0 + 14;\n      r.box(g, cx - 3, cy - 3, f.h - 4, cx + 3, cy + 3, f.h + 11, '#6a3430', '#b05a48');\n      r.box(g, cx - 4, cy - 4, f.h + 10, cx + 4, cy + 4, f.h + 12, '#b8a8a0', '#6a5a60');\n      r.box(g, cx - 1.5, cy - 2, f.h + 12, cx + 1.5, cy + 1, f.h + 12.3, '#2a1c20', '#2a1c20');\n    }, { bias: .01 });\n  }\n  // LIGHT SHAFTS: tinted beams, a stepped FALLOFF (three additive layers), drifting motes; none in topdown\n  function shafts(r, room) {\n    const [xs, c, lean] = BEAMS[room], t = game.real;\n    if (r.view.pitchDeg < 70) r.overlay(g => { for (const bx of xs) {\n      const [x, y] = r.w(room * ROOM[0] + bx, OY + 12, 40), w = 5 + Math.sin(t * .5 + bx) * 1.5, L = 120;\n      px.blend(g, 1 / 8, 'add', () => { for (const k of [1, .6, .3]) { const X = x + lean * k, Y = y + L * k, s = w * (1 + k); px.poly(g, [[x - w, y], [x + w, y], [X + s, Y], [X - s, Y]], c); } });\n      px.blend(g, 1, 'add', () => { for (let i = 0; i < 6; i++) { const u = (i * .17 + t * .025 + bx * .01) % 1; px.dot(g, x + lean * u + Math.sin(t * .7 + i * 2) * w, y + L * u, c); } });\n    } });\n  }\n  function draw(r) {\n    const view = E.charView(r.view), h = hero, room = roomOf(h.x), bob = Math.sin(game.time * 4) * 1.5;   // view: rigs get a sprite-like angle\n    bg.draw(r); map.drawFloor(r); map.queueWalls(r);\n    for (const b of [h, ...npcs, ...foes, ...pets]) if (!b.dead) shadow(r, b.x, b.y, (b.look instanceof E.Blob ? 5 : 6) - Math.min(2.5, (b.z || 0) * .12));\n    for (const f of roofs) roof(r, f);\n    for (const t of things) {\n      if (t.dead || t.hidden) continue; const y = t.face ? t.y + T / 2 + 1 : t.y, z = t.face ? t.z || 0 : map.heightAt(t.x, t.y);\n      if (t.r && !t.shape) shadow(r, t.x, t.y + 1, t.r);   // (a shape casts its own)\n      if (t.prop === 'bush') r.queue(t.x, t.y, z, g => { const [X, Y] = r.w(t.x, t.y, z), k = Math.floor(t.x * 3 + t.y);\n        bush(g, Math.round(X), Math.round(Y), t.size || 1, t.C || (t.C = E.ramp(t.color || ['#4a9a4a', '#3a8a52', '#5a9a3a'][k % 3], 5, 1.2)), k); });\n      else if (t.shape) r.shape(t.shape, t.x, y, z, { scale: t.size, facing: E.hash2(t.x, t.y) * E.TAU });   // each turned its own way\n      else r.prop(t.prop, t.x, y, z, { ...t, light: false });   // its fields style the prop\n      // GPU lights in the hero's room only; wall lights cast shadows\n      if (t.light && t.room === room) L.add(t.x, y + (t.prop === 'window' ? 30 : 0), z + 14, t.face ? 90 : 60, .9, { color: t.light, shadow: t.face });\n    }\n    for (const it of items) if (!it.got) {\n      if (it.kind === 'relic') r.sprite(it.x, it.y, 18 + bob, CRYSTALS[0], { glow: .5 });   // (its sparkle comes from update: draw changes nothing)\n      else { shadow(r, it.x, it.y, 3); r.sprite(it.x, it.y, 3 + bob, it.kind === 'gem' ? GEM : HEART, { glow: .5 }); }\n    }\n    for (const b of [...npcs, ...pets]) r.actor(b.x, b.y, b.z || 0, (g, ox, oy) => (b.rig || b.look).draw(g, ox, oy, view), { every: 2, key: b });   // townsfolk animate every other frame (a phone's frame time goes to the hero and foes)\n    for (const f of foes) if (!f.dead) {   // tells shiver (a goblin's builds); dying foes blink before the poof\n      const c = f.atk, tell = f.tell ? .7 : f.kind === 'goblin' && c.phase === 'wind' ? .3 + c.u * 1.5 : 0;\n      r.actor(f.x + shiver(tell), f.y, f.z, (g, ox, oy) => f.look.draw(g, ox, oy, view), { flash: f.flash > 0 || f.dying > 0 && f.dying < .4 && Math.floor(game.time * 16) % 2 });\n      if (f.kind === 'goblin') f.look.drawSmear(r, ['#ffffff', '#fff0d0', '#ffc890', '#e08048']);\n      // the mage's rune ring grows through the wind-up and BURSTS outward as the bolt leaves\n      const R = f.kind !== 'mage' ? 0 : c.phase === 'wind' ? 4 + c.u * 8 : c.phase === 'active' ? 12 : c.phase && c.u < .3 ? 12 + c.u * 40 : 0;\n      if (R) r.decal(() => r.groundRing(f.x, f.y, R, R > 12 ? '#ffe8ff' : '#ff70d8'), { emissive: 1 });\n      const age = game.time - f.hitT, top = (f.look.head ? f.look.head()[2] + 8 : f.z + 20) + 8 * Math.sqrt(age);   // the damage number rides its foe\n      if (age < .8) r.queue(f.x, f.y, top, g => { const [x, y] = r.w(f.x, f.y, top); txt(g, String(f.dmg), x, y, '#fff2c4', { align: 'center' }); }, { bias: 2 });\n    }\n    // the HERO: the sword trail sorts in front, so while the blade is behind him (or spinning) bias draws him over it\n    const st = h.sw.state, [tx, ty] = h.rig.tip(), over = st && (st.spec.spin || (tx - h.x) * r.view.fx + (ty - h.y) * r.view.fy < 0);\n    if (h.hp > 0 && !(h.inv > 0 && h.hurt <= 0 && Math.floor(game.real * 15) % 2)) {\n      r.actor(h.x + shiver(h.charge * .6), h.y, h.z, (g, ox, oy) => {\n        h.rig.draw(g, ox, oy, view);\n        if (held && held.t > 0) {   // the prize, placed through the character view\n          const s = held.spr, q = view.p(0, 0, h.rig.head()[2] - h.z + 9 + bob * .5);\n          px.glow(g, .35); px.sprite(g, s, Math.round(ox + q[0] - s.w / 2), Math.round(oy + q[1] - s.h));\n        }\n      }, { xray: true, flash: h.hurt > .15 || h.charge >= .6 && game.time % .3 < .05, bias: over ? 2 : 0 });\n      h.rig.drawSmear(r);\n    }\n    shots.draw(r); drawFx(r); shafts(r, room); if (game.cam.room) curtain(r, room); hud(r); talk.draw(r);\n  }\n  // the CURTAIN: what the screen shows beyond the hero's room, dimmed a little (the room's box: its floor, its walls' height)\n  function curtain(r, room) {\n    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\n    for (const x of [room * ROOM[0], (room + 1) * ROOM[0]]) for (const y of [OY, OY + ROOM[1]]) for (const z of [0, 48]) { const [sx, sy] = r.w(x, y, z); x0 = Math.min(x0, sx); x1 = Math.max(x1, sx); y0 = Math.min(y0, sy); y1 = Math.max(y1, sy); }\n    [x0, y0, x1, y1] = [x0, y0, x1, y1].map(Math.round);\n    if (x0 <= 0 && y0 <= 0 && x1 >= r.W && y1 >= r.H) return;\n    r.overlay(g => px.blend(g, .4, 'normal', () => { const D = '#0a0818'; px.rect(g, 0, 0, r.W, y0, D); px.rect(g, 0, y1, r.W, r.H - y1, D); px.rect(g, 0, y0, x0, y1 - y0, D); px.rect(g, x1, y0, r.W - x1, y1 - y0, D); }));\n  }\n  // HUD in the corners, over the world: the hero and his hearts top left; gems, keys and a map of the rooms top right\n  // (clear of the corner's buttons); the CONTROLS (the player's own keys) bottom right, not on a touch screen (its buttons\n  // say it); the area's name drops in under them as he enters\n  function hud(r) {\n    const npc = talkable(), R = Math.min(r.W, cornerX()) - 4;\n    r.overlay(g => {\n      E.ui.box(g, 4, 4, 84, 30, WIN); hero.rig.drawPortrait(g, 9, 9, 20, { zoom: 1.5, cape: false, bg: FACE_BG });\n      txt(g, 'HERO', 36, 8, '#ffe08a', { gradient: ['#fff4c0', '#e8a040'] }); E.ui.hearts(g, 36, 19, hero.hp, hero.max);\n      const GX = R - 70; E.ui.box(g, GX, 4, 70, 17, WIN); px.sprite(g, GEM, GX + 6, 9); px.sprite(g, KEYS[0], GX + 41, 10);\n      txt(g, String(gems).padStart(3, '0'), GX + 14, 9, '#ffffff'); txt(g, 'x' + keys, GX + 50, 9, '#ffffff');\n      minimap(g, GX, 24);\n      if (won) {\n        const wy = Math.round(r.H / 2) - 24;\n        E.ui.box(g, r.W / 2 - 90, wy, 180, 48, WIN); E.font.title(g, 'MANA CRYSTAL!', r.W / 2, wy + 7, { align: 'center', scale: 2, colors: ['#ffffff', '#bff8ff', '#4ac8e8'], depth: 1 });\n        return txt(g, 'Gems ' + gems + '    Best ' + best('adventure', gems), r.W / 2, wy + 34, '#ffe08a', { align: 'center' });\n      }\n      if (talk.open) return;\n      if (!touch()) {\n        const a = prompt('attack', 'Sword'), b = prompt('confirm', 'Talk'), w = E.font.width(a) + E.font.width(b) + 26, cx = r.W - w - 4, cy = r.H - 22;\n        E.ui.box(g, cx, cy, w, 18, WIN); txt(g, a, cx + 8, cy + 5, '#d8d0f0');\n        txt(g, b, cx + w - 8 - E.font.width(b), cy + 5, npc && Math.floor(game.real * 3) % 2 ? '#ffe08a' : '#d8d0f0');   // 'Talk' blinks near a villager\n      }\n      if (npc) {   // a speech bubble: you can talk\n        const [fx, fy] = r.w(npc.x, npc.y, 0), q = E.charView(r.view).p(0, 0, 44), x = Math.round(fx + q[0]), y = Math.round(fy + q[1]);\n        E.ui.box(g, x - 11, y - 14, 22, 12, WIN); px.poly(g, [[x - 4, y - 3], [x + 2, y - 3], [x - 3, y + 1]], WIN.border);\n        for (let k = 0; k < 3; k++) px.rect(g, x - 6 + k * 5, y - 9 - (Math.floor(game.real * 3) % 3 === k ? 1 : 0), 2, 2, '#ffe08a');\n      }\n      if (area.t > 0) {   // the area's name drops in, then goes\n        const w = E.font.width(AREAS[area.room]) + 20, y = Math.round(42 - (Math.max(0, area.t - 2.3) + Math.max(0, .3 - area.t)) * 120);\n        E.ui.box(g, (r.W - w) / 2, y, w, 18, WIN); txt(g, AREAS[area.room], r.W / 2, y + 5, '#ffffff', { align: 'center' });\n      }\n    });\n  }\n  // a map of the three rooms, 70 x 12: the hero's lit, where he stands blinking\n  function minimap(g, x, y) {\n    const room = roomOf(hero.x), C = ['#4a9a4a', '#7a8a56', '#5a5486'], w = 22, h = 12;\n    for (let i = 0; i < 3; i++) { px.rect(g, x + i * (w + 2), y, w, h, i === room ? '#fff4c0' : '#1a1838'); px.rect(g, x + i * (w + 2) + 1, y + 1, w - 2, h - 2, i === room ? C[i] : E.shade(C[i], -.45)); }\n    if (Math.floor(game.real * 3) % 2) px.rect(g, x + Math.round(hero.x / ROOM[0] * (w + 2)) - 1, y + 1 + Math.round(clamp((hero.y - OY) / ROOM[1], 0, 1) * (h - 4)), 2, 2, '#ffffff');\n  }\n  return { view: 'threequarter', views: ['threequarter', 'topdown', 'iso'], input: 'DEFAULT', res: 'ps1', propSize: 1.25, pausable: true, touch: ['attack', 'confirm'], enter: start, update, draw,\n    // the player zooms in to 2x, and out as far as the world round the rooms fills the screen: to .85x on a wide one, not\n    // at all held upright (its forest is sized for 1x there). A TileMap scene rotates cleanly\n    camera: { zoom: g => [g.upright ? 1 : .85, 2], rotate: true },\n    state: () => ({ hero, foes, things, items, map, npcs, pets, talk }),   // for tests\n    /** the proof: a walk round the village and into the ruins, the sword swinging and every word read; a hash of the run */\n    run: (n = 600) => proof('adventure', n, (i, k) => { walk(i, k, ['right', 'down', 'left', 'up'], 90); if (i % 40 === 20) k.tap('attack'); if (i % 120 === 60) k.tap('confirm'); },\n      () => [hero.x, hero.y, hero.hp, gems, keys, area, won, foes.map(f => [f.x, f.y, f.hp])]),\n    exit() { game.cam.room = null; game.cam.smooth = .18; if (gpu) gpu.enabled = false; L.enabled = false; } };\n})();\nscenes.adventure = ADV;\n\n/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n// a genre kit file holds one slice: the menu lists only the slices in this file\nfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\ntitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\nconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\ngame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\nwindow.__game = { game, scenes, titleMenu };   // for tests\n})();\n/* =============================== GAME END =============================== */\n","exit_code":0,"status":"completed"}}
