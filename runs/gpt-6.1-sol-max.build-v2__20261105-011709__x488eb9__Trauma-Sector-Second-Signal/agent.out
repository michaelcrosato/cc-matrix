{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'JS'\nimport {chromium} from 'playwright';import fs from 'node:fs';import path from 'node:path';import {pathToFileURL} from 'node:url';const meta=JSON.parse(fs.readFileSync('build-meta.json'));fs.mkdirSync('tests/screens',{recursive:true});const browser=await chromium.launch({args:['--autoplay-policy=no-user-gesture-required']});const page=await browser.newPage({viewport:{width:1920,height:1080}});const errors=[];page.on('pageerror',e=>errors.push(e.stack));page.on('console',m=>{if(m.type()==='error')errors.push(m.text());});await page.goto(pathToFileURL(path.resolve('..',meta.html)).href);await page.waitForTimeout(1500);console.log(await page.evaluate(()=>({title:document.title,snapshot:GAME.game.debug.snapshot()})));await page.screenshot({path:'tests/screens/title.png'});for(const [name,data] of [['menu',null],['op',{id:1}],['story',null],['ward',null]]){await page.evaluate(({name,data})=>{if(name==='op')GAME.startCase(data.id,'replay');else GAME.game.go(name);},{name,data});await page.waitForTimeout(700);await page.screenshot({path:'tests/screens/'+name+'.png'});}console.log({errors});await browser.close();\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
