\n    lock.position.set(Math.cos(a) * 0.92, 0.15 - (i % 3) * 0.08, Math.sin(a) * 0.82);\\n    lock.lookAt(lock.position.x * 2, -1.2, lock.position.z * 2);\\n    group.add(lock);\\n  }\\n  const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.36, 0.44, 0.7, 20), toon({ color: look.skin }));\\n  neck.position.y = -1.18;\\n  group.add(neck);\",\"content_concise\":\"90→      const t = -y;\\n      const jaw = t > 0.25 ? ((t - 0.25) / 0.75) ** 1.4 : 0;\\n      x *= 1 - 0.1 * t - 0.42 * jaw;\\n      z *= 1 - 0.12 * t;\\n      z += 0.05 * t * t;\\n      y *= 1 + 0.16 * t;\\n    }\\n    z *= 0.94;\\n    pos.setXYZ(i, x, y, z);\\n  }\\n100→  pos.needsUpdate = true;\\n  geo.computeVertexNormals();\\n}\\n\\nexport function makeBust(who, expr = {}) {\\n  const cast = castOf(who);\\n  const look = {\\n    skin: cast.skin || '#f0c2a0',\\n    hair: cast.hair || '#2a2118',\\n    iris: cast.iris || '#3a6ea5',\\n110→    cloth: cast.cloth || '#17707A',\\n  };\\n  const group = new THREE.Group();\\n  group.name = `bust-${who}`;\\n  const headGeo = new THREE.SphereGeometry(1, 48, 36);\\n  reshapeHead(headGeo);\\n  const canvas = document.createElement('canvas');\\n  canvas.width = 1024;\\n  canvas.height = 512;\\n  paintFace(canvas, look, expr);\\n120→  const map = new THREE.CanvasTexture(canvas);\\n  map.colorSpace = THREE.SRGBColorSpace;\\n  map.wrapS = THREE.RepeatWrapping;\\n  const head = new THREE.Mesh(headGeo, toon({ map }));\\n  head.castShadow = true;\\n  group.add(head);\\n  // Stop above the eyes. 0.55π buried the irises under the cap.\\n  const cap = new THREE.Mesh(new THREE.SphereGeometry(1.06, 32, 16, 0, Math.PI * 2, 0, Math.PI * 0.34), toon({ color: look.hair }));\\n  cap.position.y = 0.15;\\n  group.add(cap);\\n130→  for (let i = 0; i < 18; i++) {\\n    const lock = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.55 + (i % 5) * 0.08, 6), toon({ color: look.hair }));\\n    const a = (i / 18) * Math.PI * 2;\\n    lock.position.set(Math.cos(a) * 0.92, 0.15 - (i % 3) * 0.08, Math.sin(a) * 0.82);\\n    lock.lookAt(lock.position.x * 2, -1.2, lock.position.z * 2);\\n    group.add(lock);\\n  }\\n  const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.36, 0.44, 0.7, 20), toon({ color: look.skin }));\\n  neck.position.y = -1.18;\\n  group.add(neck);\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/view/bust.js\",\"offset\":90,\"limit\":50,\"raw_output\":\"      const t = -y;\\n      const jaw = t > 0.25 ? ((t - 0.25) / 0.75) ** 1.4 : 0;\\n      x *= 1 - 0.1 * t - 0.42 * jaw;\\n      z *= 1 - 0.12 * t;\\n      z += 0.05 * t * t;\\n      y *= 1 + 0.16 * t;\\n    }\\n    z *= 0.94;\\n    pos.setXYZ(i, x, y, z);\\n  }\\n  pos.needsUpdate = true;\\n  geo.computeVertexNormals();\\n}\\n\\nexport function makeBust(who, expr = {}) {\\n  const cast = castOf(who);\\n  const look = {\\n    skin: cast.skin || '#f0c2a0',\\n    hair: cast.hair || '#2a2118',\\n    iris: cast.iris || '#3a6ea5',\\n    cloth: cast.cloth || '#17707A',\\n  };\\n  const group = new THREE.Group();\\n  group.name = `bust-${who}`;\\n  const headGeo = new THREE.SphereGeometry(1, 48, 36);\\n  reshapeHead(headGeo);\\n  const canvas = document.createElement('canvas');\\n  canvas.width = 1024;\\n  canvas.height = 512;\\n  paintFace(canvas, look, expr);\\n  const map = new THREE.CanvasTexture(canvas);\\n  map.colorSpace = THREE.SRGBColorSpace;\\n  map.wrapS = THREE.RepeatWrapping;\\n  const head = new THREE.Mesh(headGeo, toon({ map }));\\n  head.castShadow = true;\\n  group.add(head);\\n  // Stop above the eyes. 0.55π buried the irises under the cap.\\n  const cap = new THREE.Mesh(new THREE.SphereGeometry(1.06, 32, 16, 0, Math.PI * 2, 0, Math.PI * 0.34), toon({ color: look.hair }));\\n  cap.position.y = 0.15;\\n  group.add(cap);\\n  for (let i = 0; i < 18; i++) {\\n    const lock = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.55 + (i % 5) * 0.08,