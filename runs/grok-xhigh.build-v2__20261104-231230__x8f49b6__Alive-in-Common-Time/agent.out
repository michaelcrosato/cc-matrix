ion-grok-4.7-xhigh-20261104-231230/src/app/director.js\",\"matches\":[{\"line_number\":159,\"content\":\"    if (model.mode === 'session' && (model.screen === 'Card' || AIHub.time?.() === -Infinity)) {\"},{\"line_number\":165,\"content\":\"    if (model.screen === 'Touch notice') {\"},{\"line_number\":171,\"content\":\"    if (model.screen === 'Title') {\"},{\"line_number\":175,\"content\":\"    const inPlay = model.screen === 'Operation' && !model.overlay && !model.sessionPause;\"},{\"line_number\":181,\"content\":\"      model.pending[inPlay || model.screen === 'Story' ? 'pause' : 'back'] = true;\"},{\"line_number\":205,\"content\":\"      if (model.screen === 'About') model.page = i;\"},{\"line_number\":264,\"content\":\"      && (model.screen === 'Operation' || model.screen === 'Story')) {\"},{\"line_number\":308,\"content\":\"    if (model.screen === 'Title') return [{ id: 'start', label: 'Press any button' }];\"},{\"line_number\":309,\"content\":\"    if (model.screen === 'Touch notice') return [{ id: 'settings', label: 'Settings' }];\"},{\"line_number\":310,\"content\":\"    if (model.screen === 'Main Menu') {\"},{\"line_number\":320,\"content\":\"    if (model.screen === 'Story' && model.storyMode === 'ask') {\"},{\"line_number\":327,\"content\":\"    if (model.screen === 'Story' && model.storyMode === 'lines') return [{ id: 'advance', label: 'Continue' }];\"},{\"line_number\":328,\"content\":\"    if (model.screen === 'Chart') return chartItems();\"},{\"line_number\":329,\"content\":\"    if (model.screen === 'Report') return [{ id: 'report-next', label: 'Continue' }];\"},{\"line_number\":330,\"content\":\"    if (model.screen === 'Fail') return failItems();\"},{\"line_number\":331,\"content\":\"    if (model.screen === 'Free Play') return freeItems();\"},{\"line_number\":332,\"content\":\"    if (model.screen === 'Lobby') return lobbyItems();\"},{\"line_number\":333,\"content\":\"    if (model.screen === 'Settings') return settingsItems();\"},{\"line_number\":334,\"content\":\"    if (model.screen === 'About') return aboutItems();\"},{\"line_number\":335,\"content\":\"    if (model.screen === 'Credits roll') return [{ id: 'credits-skip', label: 'Skip' }];\"},{\"line_number\":336,\"content\":\"    if (model.mode === 'session' && model.screen === 'Card') return [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More Time' }];\"},{\"line_number\":353,\"content\":\"    if (model.screen === 'Story') {\"},{\"line_number\":445,\"content\":\"    if (model.screen === 'Settings' || model.sessionPause) return SETTINGS_PAGES.length;\"},{\"line_number\":446,\"content\":\"    if (model.screen === 'About') return ABOUT_HEADS.length;\"},{\"line_number\":447,\"content\":\"    if (model.screen === 'Free Play') return Math.max(1, Math.ceil(storyOrder().filter(unlocked).length / 4));\"},{\"line_number\":463,\"content\":\"    if (model.screen === 'Story' && model.storyMode === 'ask') return 1;\"},{\"line_number\":464,\"content\":\"    if (model.screen === 'Chart') return Math.max(0, chartItems().length - 1);\"},{\"line_number\":465,\"content\":\"    if (model.screen === 'Lobby') return 4;\"},{\"line_number\":466,\"content\":\"    if (model.screen === 'About') return model.page || 0;\"},{\"line_number\":471,\"content\":\"    model.screen = name;\"},{\"line_number\":524,\"content\":\"      id = (model.screen === 'Card' || model.screen === 'Countdown') ? 'title' : 'rounds';\"},{\"line_number\":528,\"content\":\"    } else if (model.screen === 'Story' && model.scene?.music) {\"},{\"line_number\":530,\"content\":\"    } else if ((model.screen === 'Operation' || model.screen === 'Chart' || model.screen === 'Report' || model.screen === 'Fail') && model.opId) {\"},{\"line_number\":532,\"content\":\"      id = model.screen === 'Operation' ? (op?.music || 'or-calm') : 'or-tense';\"},{\"line_number\":534,\"content\":\"    } else if (model.screen === 'Credits roll') id = 'credits';\"},{\"line_number\":535,\"content\":\"    else if (model.screen === 'Lobby') id = 'rounds';\"},{\"line_number\":546,\"content\":\"    if (model.screen === 'Story' && model.scene) {\"},{\"line_number\":551,\"content\":\"    } else if (model.screen === 'Operation' || model.attract.on || model.screen === 'Chart') {\"},{\"line_number\":833,\"content\":\"    const idle = model.screen === 'Title' || model.screen === 'Main Menu' || model.screen === 'Free Play' || model.screen === 'Touch notice';\"},{\"line_number\":920,\"content\":\"    if (id === 'begin' && model.screen === 'Chart') {\"},{\"line_number\":925,\"content\":\"    if (id === 'begin' && model.screen === 'Lobby') {\"},{\"line_number\":948,\"content\":\"      if (model.screen === 'Credits roll' || id === 'credits-skip') setScreen('Main Menu');\"},{\"line_number\":1086,\"content\":\"    if (model.screen === 'About' && !model.overlay) model.page = model.focus;\"},{\"line_number\":1094,\"content\":\"    model.focus = model.screen === 'About' ? model.page : 0;\"},{\"line_number\":1100,\"content\":\"    if (model.screen === 'Chart' && !model.overlay) {\"},{\"line_number\":1141,\"content\":\"    const playing = model.attract.on || (model.screen === 'Operation' && !model.overlay && !model.sessionPause);\"},{\"line_number\":1204,\"content\":\"      if (model.screen === 'Touch notice' && (pend.leaveTouch || sample.seenPad || model.input.seenPad)) {\"},{\"line_number\":1211,\"content\":\"      const inPlay = model.screen === 'Operation' && !model.overlay;\"},{\"line_number\":1212,\"content\":\"      if ((pend.pause || padPause || (menu.back && model.screen === 'Story' && !model.overlay)) && model.mode !== 'session') {\"},{\"line_number\":1213,\"content\":\"        if (inPlay || model.screen === 'Story' || pend.pause || padPause) {\"},{\"line_number\":1220,\"content\":\"        else if (model.screen === 'Settings') closeSettings();\"},{\"line_number\":1230,\"content\":\"      if (model.screen === 'Lobby' && !model.overlay) {\"},{\"line_number\":1240,\"content\":\"      if (model.screen === 'Story' && model.storyMode === 'lines' && !model.overlay) {\"},{\"line_number\":1280,\"content\":\"        if (model.screen === 'Settings') closeSettings();\"},{\"line_number\":1326,\"content\":\"    if (app) app.hidden = model.screen === 'Boot';\"},{\"line_number\":1331,\"content\":\"    if (model.mode === 'session' && model.screen === 'Card') {\"},{\"line_number\":1335,\"content\":\"    if (model.mode === 'session' && model.screen === 'Countdown') {\"},{\"line_number\":1339,\"content\":\"    if (model.screen === 'Round over') {\"},{\"line_number\":1363,\"content\":\"    if (model.screen === 'Title') {\"},{\"line_number\":1369,\"content\":\"    if (model.screen === 'Touch notice') {\"},{\"line_number\":1373,\"content\":\"    if (model.screen === 'Main Menu') {\"},{\"line_number\":1379,\"content\":\"    if (model.screen === 'Story' && model.storyMode === 'ask') {\"},{\"line_number\":1383,\"content\":\"    if (model.screen === 'Story' && model.storyMode === 'lines') {\"},{\"line_number\":1389,\"content\":\"    if (model.screen === 'Chart') ui.innerHTML = chartHtml();\"},{\"line_number\":1390,\"content\":\"    else if (model.screen === 'Operation') ui.innerHTML = hudHtml();\"},{\"line_number\":1391,\"content\":\"    else if (model.screen === 'Report') ui.innerHTML = reportHtml();\"},{\"line_number\":1392,\"content\":\"    else if (model.screen === 'Fail') ui.innerHTML = failHtml();\"},{\"line_number\":1393,\"content\":\"    else if (model.screen === 'Free Play') ui.innerHTML = menuBlock('Chart Board', freeItems(), `<p class=\\\"note\\\">${esc(DIFFICULTY[model.settings.difficulty]?.label || 'Resident')}</p>${pageDots()}`);\"},{\"line_number\":1394,\"content\":\"    else if (model.screen === 'Lobby') ui.innerHTML = lobbyHtml();\"},{\"line_number\":1395,\"content\":\"    else if (model.screen === 'Settings') ui.innerHTML = menuBlock('Settings', settingsItems(), pageDots());\"},{\"line_number\":1396,\"content\":\"    else if (model.screen === 'About') ui.innerHTML = aboutHtml();\"},{\"line_number\":1397,\"content\":\"    else if (model.screen === 'Credits roll') ui.innerHTML = `<section class=\\\"screen\\\"><h1 class=\\\"big\\\">Credits</h1><p class=\\\"note\\\">The lamp stays on.</p><div class=\\\"menu\\\">${btn({ id: 'credits-skip', label: 'Skip' }, 0)}</div></section>`;\"},{\"line_number\":1620,\"content\":\"      if (model.sim && (model.attract.on || model.screen === 'Operation')) {\"},{\"line_number\":1623,\"content\":\"      } else if (model.screen === 'Story') present();\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"e370c5af-7667-4ee7-9dd1-5ea6e8469ae2"}
