l.painting) {\\n      if (info.isHost && model.sim) model.syncFromSim?.();\\n      else if (model.netState) {\\n\",\"context_after\":\"        try { model.view.sync(st, dt); } catch { /* view catches up next frame */ }\\n        const drawn = model.view.render?.();\\n        if (drawn?.then) drawn.then(() => { model.painting = false; }, () => { model.painting = false; });\\n\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-31a7096e-0f67-4973-b848-e5c15774b108-51","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\".who { font-size: 1.6rem; letter-spacing: 0.08em; text-transform: uppercase; }\",\"new_string\":\".who { font-size: 2.2rem; letter-spacing: 0.08em; text-transform: uppercase; }\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css\",\"edits\":{\"details\":[{\"old_string\":\".who { font-size: 1.6rem; letter-spacing: 0.08em; text-transform: uppercase; }\",\"old_line\":34,\"new_string\":\".who { font-size: 2.2rem; letter-spacing: 0.08em; text-transform: uppercase; }\",\"new_line\":34,\"context_before\":\".wheel button { width: 4.4rem; height: 3rem; font-size: 1.1rem; background: #10282c; border: 0.15rem solid #f4efe4; border-radius: 0.4rem; }\\n.wheel button.on { background: #17707A; }\\n.bark { font-size: 2.2rem; background: #f4efe4; color: #1a120c; padding: 0.6rem 0.9rem; border-radius: 0.8rem; max-width: 32rem; }\\n\",\"context_after\":\".overlay { position: absolute; inset: 0; background: rgba(11, 37, 41, 0.82); display: flex; flex-direction: column; justify-content: center; gap: 0.8rem; padding: 4vh 4vw; pointer-events: auto; }\\n.big { font-family: 'Bangers', sans-serif; font-size: 5rem; margin: 0; }\\n.dialogue { margin-top: auto; background: #f4efe4; color: #1a120c; padding: 1rem 1.2rem; border-radius: 0.8rem; min-height: 8rem; }\\n\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-31a7096e-0f67-4973-b848-e5c15774b108-52","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\".pages { display: flex; gap: 1rem; font-size: 1.8rem; }\\n.page { display: none; font-size: 2rem; line-height: 1.25; }\\n.page.on { display: block; }\",\"new_string\":\".pages, .tabs { display: flex; flex-wrap: wrap; gap: 0.8rem; font-size: 2.2rem; }\\n.page { display: none; font-size: 2.2rem; line-height: 1.25; }\\n.page.on { display: block; }\\n.tabs button { font-size: 2.2rem; background: transparent; border: 0; border-bottom: 0.2rem solid transparent; padding: 0.3rem 0.4rem; cursor: pointer; }\\n.tabs button.on { border-color: #f4efe4; }\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css\",\"edits\":{\"details\":[{\"old_string\":\".pages { display: flex; gap: 1rem; font-size: 1.8rem; }\\n.page { display: none; font-size: 2rem; line-height: 1.25; }\\n.page.on { display: block; }\",\"old_line\":39,\"new_string\":\".pages, .tabs { display: flex; flex-wrap: wrap; gap: 0.8rem; font-size: 2.2rem; }\\n.page { display: none; font-size: 2.2rem; line-height: 1.25; }\\n.page.on { display: block; }\\n.tabs button { font-size: 2.2rem; background: transparent; border: 0; border-bottom: 0.2rem solid transparent; padding: 0.3rem 0.4rem; cursor: pointer; }\\n.tabs button.on { border-color: #f4efe4; }\",\"new_line\":39,\"context_before\":\".big { font-family: 'Bangers', sans-serif; font-size: 5rem; margin: 0; }\\n.dialogue { margin-top: auto; background: #f4efe4; color: #1a120c; padding: 1rem 1.2rem; border-radius: 0.8rem; min-height: 8rem; }\\n.dialogue p { font-size: 2.75rem; margin: 0.2rem 0; }\\n\",\"context_after\":\".demo { position: absolute; top: 0; right: 0; font-family: 'Bangers', sans-serif; font-size: 3rem; }\\n.note { font-size: 2rem; }\\ninput[type=range] { width: 16rem; accent-color: #17707A; }\\n\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-31a7096e-0f67-4973-b848-e5c15774b108-53","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\".wheel button { width: 4.4rem; height: 3rem; font-size: 1.1rem; background: #10282c; border: 0.15rem solid #f4efe4; border-radius: 0.4rem; }\",\"new_string\":\".wheel button { width: 7rem; height: 3.4rem; font-size: 2.2rem; background: #10282c; border: 0.15rem solid #f4efe4; border-radius: 0.4rem; }\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css\",\"edits\":{\"details\":[{\"old_string\":\".wheel button { width: 4.4rem; height: 3rem; font-size: 1.1rem; background: #10282c; border: 0.15rem solid #f4efe4; border-radius: 0.4rem; }\",\"old_line\":31,\"new_string\":\".wheel button { width: 7rem; height: 3.4rem; font-size: 2.2rem; background: #10282c; border: 0.15rem solid #f4efe4; border-radius: 0.4rem; }\",\"new_line\":31,\"context_before\":\".timer, .score { font-size: 2.4rem; text-align: right; }\\n#ecg { width: 16rem; height: 3.2rem; background: transparent; }\\n.wheel { display: flex; flex-wrap: wrap; gap: 0.35rem; max-width: 22rem; pointer-events: auto; }\\n\",\"context_after\":\".wheel button.on { background: #17707A; }\\n.bark { font-size: 2.2rem; background: #f4efe4; color: #1a120c; padding: 0.6rem 0.9rem; border-radius: 0.8rem; max-width: 32rem; }\\n.who { font-size: 2.2rem; letter-spacing: 0.08em; text-transform: uppercase; }\\n\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-31a7096e-0f67-4973-b848-e5c15774b108-54","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\".sound { position: absolute; bottom: 0; left: 0; font-size: 1.6rem; }\",\"new_string\":\".sound { position: absolute; bottom: 0; left: 0; font-size: 2.2rem; }\\n.card { gap: 0.8rem; }\\n.touch-copy { font-size: 3.2rem; max-width: 40rem; }\\n.row { display: flex; justify-content: space-between; gap: 1rem; font-size: 2.4rem; }\\n.pick { outline: 0.2rem solid #f5b700; }\\n.nogfx p, .about-line { font-size: 2.2rem; margin: 0.2rem 0; }\\nbody[data-screen=\\\"Title\\\"], body[data-screen=\\\"Boot\\\"] { background: #17707A; }\\n.hud .obj, .hud .vitals, .hud .timer { text-shadow: 0 0.08rem 0 #0B2529; }\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/ui/ui.css\",\"edits\":{\"details\":[{\"old_string\":\".sound { position: absolute; bottom: 0; left: 0; font-size: 1.6rem; }\",\"old_line\":53,\"new_string\":\".sound { position: absolute; bottom: 0; left: 0; font-size: 2.2rem; }\\n.card { gap: 0.8rem; }\\n.touch-copy { font-size: 3.2rem; max-width: 40rem; }\\n.row { display: flex; justify-content: space-between; gap: 1rem; font-size: 2.4rem; }\\n.pick { outline: 0.2rem solid #f5b700; }\\n.nogfx p, .about-line { font-size: 2.2rem; margin: 0.2rem 0; }\\nbody[data-screen=\\\"Title\\\"], body[data-screen=\\\"Boot\\\"] { background: #17707A; }\\n.hud .obj, .hud .vitals, .hud .timer { text-shadow: 0 0.08rem 0 #0B2529; }\",\"new_line\":53,\"context_before\":\".ecg-line { height: 0.4rem; width: 14rem; background: linear-gradient(90deg, transparent, #f4efe4 40%, transparent 40%, transparent 55%, #f4efe4 55%, #f4efe4 70%, transparent 70%); background-size: 200% 100%; animation: sweep 1.2s linear infinite; }\\n@keyframes sweep { to { background-position: -200% 0; } }\\n.nogfx { position: absolute; inset: 0; display: grid; place-items: center; background: #17707A; font-size: 2.4rem; text-align: center; padding: 8vh; }\\n\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"fb94c1f1-63e8-4ddf-8ac8-fb3f46bf1cb2"}
{"type":"assistant","message":{"id":"msg_573","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"Writing director.js and main.js.\n\nReviewed director.js logic for focus and screen transitions. Confirmed wheel button font size won't overflow on small screens.\n\nLobby focus defaults to the last item. Pause menus have 5 or 6 items. Fail screen includes Retry Phase, Restart, Quit, and Notes.\n\nSession pause uses settings items even when the screen is Operation. stepOnce is skipped but focus and applySettings still work. During normal Operation without pause, currentItems returns an empty array so focusId stays null. The HUD is separate from these items. Dev overlay returns dev page items.\n\nfeedSim skips stepping when the dev overlay is active. The chooser overlay returns continue or new options while the Main Menu is shown. The nogfx notice will paint a text message and Continue button on top of the current screen without blocking input, clearing the notice when Continue is selected.\n\nThe nogfx notice will return only a Continue button so Enter dismisses it instead of starting the game. activate clears the notice. readSetting needs to handle sliders from both tuning and settings. FX playback must not throw. The director will import bot from sim/bot.js and physicsReady from physics.js.\n\nVerified no circular imports exist between director, session, and renderer. Duplicate physics initialization is safely guarded by a ready flag. The director will import createPointerCamera from the renderer. Also checking the runDev openScene signature and setScreen.\n\nDecided to use a single createApp function with inner functions that close over model, rather than module-level helpers. Also started writing a clock helper to format elapsed time into minutes and seconds.\n\nThe clock helper formats elapsed time as minutes and seconds. The report screen will show four stats: rank letter, precision, formatted time, and vitals. Patient follow-up uses the Escape key. Difficulty labels are Intern, Resident, and Attending. The exact prompt text is preserved. A data-prompt-set attribute will be mirrored on the #ui element so tests can read it from the documentElement.\n\nWriting director.js now. Checking for stubs and placeholders. Math.random is unused. GAME_TITLE and TAGLINE are imported instead of literals. fillPrompt returns HTML for our tokens only. Wheel labels will be short tool names like Scalpel and Forceps. Site tabs use data-item site:${id} and activate via sim.setSite(seat, index).\n\nSite tabs will not appear in currentItems during Operation. This prevents them from stealing menu confirmations. Hover will ignore empty currentItems, but clicks still trigger activation. The handleMenu function will check for a valid focus item before calling activate.\n\nThe confirm logic will treat pad confirm as a menu action only when an overlay is active or the playing field is absent. During normal operation, pad confirm will not trigger menu activation.\n\nDuring the Lobby screen, pad confirm joins a seat and is not treated as a menu action. If pad and keyboard confirm arrive in the same frame, the pad input swallows the keyboard one to avoid double-starting. Pad up and down will move lobby focus.\n\nThe join function adds a pad index to the joined set. If no pads have joined yet, the first pad joins automatically and the lobby stays on screen. Once pads are present, the flow becomes couch and the operation begins with those players. Player IDs match pad indices, but they are sorted for stable seat order. giftFor uses the seat index within the players array rather than the raw pad index.\n\nConfirmed the giftFor logic is correct. seat.index refers to the seat's position in the players array, not the raw pad ID. This produces the intended alternating hush and sforzando pattern across seats.\n\nRealized that sorting joined pads into a players array by pad index would break the giftFor logic. The plan assigns Hush to seats 1 and 3 and Sforzando to seats 2 and 4 based on seat number, but if the array order matches pad index, those assignments would be wrong. Need to ensure giftFor uses the correct seat numbering.\n\nThe fix is to always create four players in pad order and call leave on unjoined seats. This keeps seat indices stable for giftFor, giving Hush to even-numbered seats and Sforzando to odd-numbered ones. feedSim will only step joined seats that are not out, and the renderer hides tips for out seats.\n\nScores only count joined seats. Unjoined seats score zero. The report lists non-out seats.\n\nKeyboard input is reserved for seat zero when that seat is joined. If only pad one joins, the keyboard does not drive seat zero.\n\nStarting with only seat zero works: the first confirm joins it, and the second begins the couch with the remaining three pads left out.\n\nTwo pads joining together works correctly. Both get input and both score.\n\nThe couch bot drives all non-out seats. Unjoined seats are out so they are skipped.\n\nThe report will show each non-out seat's stats and award the highest scorer \"Steadiest Hands\". The director and main.js files are being written now, with build.mjs compiling director after it. A potential issue was noted: createApp calls createInput, which attaches window listeners.\n\ncreateApp is safe to call once only. localStorage is wrapped in a try-catch so iframe sandboxes do not crash. The director will be written as one file, targeting roughly 700–1000 lines. setScreen paints and resets focus during openScene, which is fine because paint already includes the line. The finishScene callback opens the chart screen via setScreen. startOperation sets the Operation screen inside mount when triggered by chart confirm.\n\nThe mount function will free any existing physics, create a new Sim, leave unjoined couch seats, clear the result and overlay, then call setScreen('Operation') to sync music and focus. A question remains about whether setScreen should be used during the attract screen.\n\nmountAttract will not call setScreen. The screen must remain Title during attract so the idle check stays valid and the test expectations hold.\n\nExit preserves the Title screen. When attract is active, the Main Menu remains on screen but paint renders the demo instead of the menu; exit restores the menu. The paint function follows a strict priority order: nogfx notice, then Card and Countdown sessions, then Round over, then attract.\n\nThe paint function now checks sessionPause, pause overlay, dev overlay, and chooser overlay before switching screens. During touch attract, the demo renders behind the notice text and settings button so the notice stays on top. A bug was found: clicking the settings button while attract is active exits attract without activating settings.\n\nThe fix for the attract settings bug is to make the first tap exit attract while leaving the notice screen in place, so a second tap can open settings. Key presses during attract also exit without navigating. If the user taps during the touch notice but not during active attract, it simply dismisses the notice and returns to Title.\n\nSettings is click-only. The notice settings button is a data-item, but onActivate exits attract before checking the click target, so the tap dismisses the demo and returns to the notice without opening settings. Both pointerdown and pointerup exit attract idempotently.\n\nThe fix is to set a `swallowPointer` flag during `onPointer` when exiting attract. `onActivate` will clear that flag and return early, so the same tap only dismisses the demo and never opens settings.\n\nThe swallowPointer flag is also set during mouse movement while attract is active. This prevents the exit input from accidentally triggering a menu navigation, and the next click works normally. Movement while attract is off does not set the flag.\n\nKeyboard exit does not set the swallow flag, so a later click still works. stepOnce exits attract on input and returns early, preventing any pending confirm from navigating. The swallow flag is only set during pointer events that actually dismiss attract; if a mouse move sets it but no click follows, the next click is swallowed once and never reaches the menu.\n\nThe swallow flag should not persist across steps. It should only consume the input that triggered the exit, so a later click is not swallowed. A sticky flag would be slightly annoying if a mouse move sets it but no click follows.\n\nA sticky `ignoreActivate` flag is being considered to swallow the activation that follows an attract exit. The concern is that if the exit came from a mouse move with no subsequent pointerup, the flag would persist and swallow the next click. Clearing it on the next stepOnce after a frame is risky because the click's pointerup might arrive before that frame.\n\nThe sticky `ignoreActivate` flag is being refined. It will be set during `onPointer` only when attract is active, and cleared on the next `pointerdown` if attract is already off. This prevents a lost click after an exit from mouse movement.\n\nThe `ignoreActivate` flag is now reset at the start of every `onPointer` call. It is only set when exiting attract. This prevents a stale flag from swallowing clicks in later gestures.\n\nThe `ignoreActivate` flag now resets at the start of every `onPointer` call. It is only set when exiting attract. A mouse move exit sets the flag but leaves no pointerup to clear it, so the next gesture's pointerdown resets it before that gesture's pointerup. The next click therefore activates normally. One edge case remains: if the exit move and the following click are the same gesture.\n\nA move-then-click gesture navigates correctly because the exit move sets the ignore flag, but the subsequent click sees attract already off and clears it before activation. For a same-tap exit, if pointermove fires after pointerdown during the same gesture, it resets the ignore flag so the pointerup activates normally.\n\nThe ignoreActivate flag will be cleared only inside onActivate. Pointermove will no longer reset it, and stepOnce will clear it if a step occurs without activation. This prevents a same-tap gesture from both exiting attract and activating the menu.\n\nA stepOnce clear between pointerdown and pointerup could swallow a later activation on slow frames. The flag should instead persist until pointerup or 300 ms, and only onActivate consumes it.\n\nA 350 ms timestamp will replace the boolean flag. When attract exits, `ignoreUntil` is set to `performance.now() + 350`. `onActivate` returns early if the current time is still before that deadline. This prevents a same-tap gesture from both exiting attract and activating the menu. Menu edge navigation inside that window will also be suppressed.","signature":""},{"type":"text","text":"The director has to own menus, attract mode, and the session card without fighting the sim loop. I’m writing that next."},{"type":"tool_use","id":"call-39c49215-f958-491f-8d96-f7a4ee8ea97e-55","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/main.js","new_string":"import { createApp } from './app/director.js';\n\nconst params = new URLSearchParams(location.search);\nconst app = createApp({ params });\nwindow.__game = app.api;\nconst info = await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true });\nif (info) app.startSession(info);\nelse await app.startStandalone();\n","old_string":""}},{"type":"tool_use","id":"call-39c49215-f958-491f-8d96-f7a4ee8ea97e-56","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/director.js","new_string":"import { GAME_TITLE, TAGLINE } from '../config/identity.js';\nimport { createTuning, DIFFICULTY, TUNING_DEFAULTS, TUNING_PAGES, TUNING_RANGES } from '../config/tuning.js';\nimport { getOp, storyOrder } from '../data/ops/index.js';\nimport { SCENES } from '../data/story/scenes.js';\nimport { castOf } from '../data/cast.js';\nimport { barkText } from '../data/barks.js';\nimport { fillPrompt } from '../input/glyphs.js';\nimport { createInput } from '../input/input.js';\nimport { createAudio } from '../audio/engine.js';\nimport { Sim } from '../sim/sim.js';\nimport { botInput } from '../sim/bot.js';\nimport { physicsReady } from '../sim/physics.js';\nimport { createPointerCamera, createView } from '../view/renderer.js';\nimport { loadSave, writeSave } from './save.js';\nimport { DEV_IDS, runDev } from './dev.js';\nimport { runSession } from './session.js';\n\nconst COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nconst WHEEL = ['scalpel', 'forceps', 'suction', 'gel', 'suture', 'laser', 'scanner', 'clamp'];\nconst ABOUT_HEADS = [\n  ['sourceInformation', 'Source Information'],\n  ['testingFeedback', 'Testing Feedback'],\n  ['engineFeedback', 'Engine Feedback'],\n  ['promptFeedback', 'Prompt Feedback'],\n  ['credits', 'Credits'],\n];\nconst FAIL_TITLE = { vitals: 'FLATLINE', time: 'TIME', miss: 'MALPRACTICE' };\nconst FX = {\n  pop: 'pop', cut: 'scalpel', clamp: 'clamp', unclamp: 'clamp', shock: 'defib',\n  inject: 'syringe', stabilize: 'syringe', gelled: 'gel', sealed: 'gel', tied: 'stitch',\n  gate: 'thread', lasered: 'laser', scorch: 'laser', vent: 'laser', mark: 'scanner',\n  nick: 'alarm', tear: 'alarm', fail: 'flatline', success: 'stamp', hush: 'murmur',\n  sforzando: 'phone', arrest: 'alarm', drained: 'suction', tray: 'forceps', grip: 'forceps',\n  drop: 'forceps', note: 'ui-move', pin: 'clamp', downed: 'pop', burst: 'pop', wake: 'chitter',\n  fortissimo: 'screech', reattach: 'scratch', jerk: 'scratch', cue: 'ui-move',\n};\n\nconst SETTINGS_PAGES = [\n  [\n    { id: 'music', label: 'Music', kind: 'slider', min: 0, max: 1, step: 0.01 },\n    { id: 'effects', label: 'Effects', kind: 'slider', min: 0, max: 1, step: 0.01 },\n    { id: 'voices', label: 'Voices', kind: 'slider', min: 0, max: 1, step: 0.01 },\n  ],\n  [\n    { id: 'glyphs', label: 'Glyphs', kind: 'toggle' },\n    { id: 'rumble', label: 'Rumble', kind: 'toggle' },\n    { id: 'aimAssist', label: 'Aim Assist', kind: 'slider', min: 0, max: 1, step: 0.01 },\n    { id: 'swapSticks', label: 'Swap Sticks', kind: 'toggle' },\n    { id: 'tipSpeed', label: 'Tip Speed', kind: 'slider', min: 0.8, max: 3.5, step: 0.05 },\n  ],\n  [\n    { id: 'fullscreen', label: 'Fullscreen', kind: 'toggle' },\n    { id: 'shake', label: 'Screen Shake', kind: 'toggle' },\n    { id: 'boil', label: 'Line Boil', kind: 'toggle' },\n    { id: 'textSpeed', label: 'Text Speed', kind: 'cycle' },\n  ],\n];\n\nfunction esc(s) {\n  return String(s ?? '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\n}\n\nfunction clock(t) {\n  const s = Math.max(0, Math.ceil(Number(t) || 0));\n  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;\n}\n\nexport function createApp({ params }) {\n  const save = loadSave();\n  const tuning = createTuning();\n  const settings = {\n    glyphs: 'playstation',\n    music: 0.1,\n    effects: 0.8,\n    voices: 0.8,\n    rumble: true,\n    shake: true,\n    boil: true,\n    textSpeed: 1,\n    difficulty: save.difficulty || 'resident',\n    aimAssist: tuning.aimAssist,\n    tipSpeed: tuning.tipSpeed,\n    swapSticks: false,\n    fullscreen: false,\n    ...(save.settings || {}),\n  };\n  tuning.aimAssist = settings.aimAssist;\n  tuning.tipSpeed = settings.tipSpeed;\n\n  const model = {\n    screen: 'Boot',\n    overlay: null,\n    mode: 'standalone',\n    params,\n    tuning,\n    settings,\n    save,\n    reached: new Set(),\n    overlays: {},\n    botOn: false,\n    botOpts: {},\n    warp: 0,\n    test: params.get('test') === '1',\n    norender: params.get('norender') === '1',\n    pending: {},\n    lastInput: performance.now(),\n    attract: { on: false, from: null, opIndex: 0, opT: 0 },\n    resultShown: false,\n    sessionPause: false,\n    focus: 0,\n    page: 0,\n    stack: [],\n    joined: new Set(),\n    siteHold: new Map(),\n    storyMode: null,\n    line: 0,\n    consultChoice: 'careful',\n    flow: 'story',\n    storyIndex: 0,\n    hold: 0,\n    track: null,\n    bark: null,\n    ignoreUntil: 0,\n    paintSig: '',\n    painting: false,\n    countN: 0,\n    card: null,\n    nogfxNotice: false,\n  };\n\n  function persist() {\n    if (model.attract.on || model.mode === 'session') return;\n    model.save.difficulty = model.settings.difficulty;\n    model.save.settings = { ...model.settings };\n    writeSave(model.save);\n  }\n\n  function audioOk() {\n    return !model.sessionInfo?.server;\n  }\n\n  const audio = createAudio();\n  audio.setMusicGain(settings.music ?? 0.1);\n  audio.sfx.gain.value = settings.effects ?? 0.8;\n  audio.voice.gain.value = settings.voices ?? 0.8;\n  model.audio = audio;\n\n  function onKey(e) {\n    if (e.repeat) return;\n    if (e.key === 'Tab') e.preventDefault();\n    audio.resume();\n    model.lastInput = performance.now();\n    if (model.attract.on) {\n      model.pending = {};\n      model.ignoreUntil = performance.now() + 350;\n      exitAttract();\n      return;\n    }\n    if (model.mode === 'session' && (model.screen === 'Card' || AIHub.time?.() === -Infinity)) {\n      const k = String(e.key || e.code || '').toLowerCase();\n      if (k === 'enter' || k === ' ' || k === 'space') AIHub.answer('ready');\n      else if (k === 'm') AIHub.answer('more');\n      return;\n    }\n    if (model.screen === 'Touch notice') {\n      model.pending.leaveTouch = true;\n      return;\n    }\n    const key = String(e.key || '');\n    const code = String(e.code || e.key || '');\n    if (model.screen === 'Title') {\n      model.pending.confirm = true;\n      return;\n    }\n    const inPlay = model.screen === 'Operation' && !model.overlay && !model.sessionPause;\n    if (inPlay && (key === 'h' || key === 'H' || code === 'KeyH')) {\n      askBea();\n      return;\n    }\n    if (key === 'Escape' || key === 'Backspace' || code === 'Escape' || code === 'Backspace') {\n      model.pending[inPlay || model.screen === 'Story' ? 'pause' : 'back'] = true;\n      return;\n    }\n    if (inPlay) return;\n    if (key === 'Enter' || key === ' ' || code === 'Enter' || code === 'Space') model.pending.confirm = true;\n    else if (key === 'Tab' || code === 'Tab') model.pending.skip = true;\n    else if (key === 'ArrowUp' || key === 'w' || key === 'W' || code === 'ArrowUp' || code === 'KeyW') model.pending.up = true;\n    else if (key === 'ArrowDown' || key === 's' || key === 'S' || code === 'ArrowDown' || code === 'KeyS') model.pending.down = true;\n    else if (key === 'ArrowLeft' || key === 'a' || key === 'A' || code === 'ArrowLeft' || code === 'KeyA') model.pending.left = true;\n    else if (key === 'ArrowRight' || key === 'd' || key === 'D' || code === 'ArrowRight' || code === 'KeyD') model.pending.right = true;\n    else if (key === 'q' || key === 'Q' || code === 'KeyQ') model.pending.pageLeft = true;\n    else if (key === 'e' || key === 'E' || code === 'KeyE') model.pending.pageRight = true;\n  }\n\n  function onHover(id) {\n    if (model.attract.on) {\n      model.ignoreUntil = performance.now() + 350;\n      exitAttract();\n      return;\n    }\n    const items = currentItems();\n    const i = items.findIndex((it) => it.id === id);\n    if (i >= 0 && i !== model.focus) {\n      model.focus = i;\n      if (model.screen === 'About') model.page = i;\n      paint(true);\n    }\n  }\n\n  function onActivate(id) {\n    model.lastInput = performance.now();\n    audio.resume();\n    if (model.attract.on) {\n      model.ignoreUntil = performance.now() + 350;\n      exitAttract();\n      return;\n    }\n    if (performance.now() < model.ignoreUntil) {\n      model.ignoreUntil = 0;\n      return;\n    }\n    if (model.mode === 'session' && (id === 'ready' || id === 'more')) {\n      AIHub.answer(id === 'more' ? 'more' : 'ready');\n      return;\n    }\n    activate(id);\n  }\n\n  function onTool(tool) {\n    model.pendingTool = tool;\n    model.lastInput = performance.now();\n  }\n\n  function onPointer() {\n    model.lastInput = performance.now();\n    if (model.attract.on) {\n      model.ignoreUntil = performance.now() + 350;\n      exitAttract();\n    }\n  }\n\n  model.onKey = onKey;\n  model.onHover = onHover;\n  model.onActivate = onActivate;\n  model.onTool = onTool;\n  model.onPointer = onPointer;\n  model.persist = persist;\n  model.reached = model.reached;\n  model.openScene = openScene;\n  model.setScreen = (name, overlay = null) => setScreen(name, overlay);\n\n  ensureDom();\n  model.input = createInput(model);\n  document.documentElement.dataset.promptSet = 'keyboard';\n  if (model.ui) {\n    model.ui.addEventListener('input', (e) => {\n      const id = e.target?.dataset?.slider;\n      if (!id) return;\n      writeSetting(id, Number(e.target.value));\n    });\n  }\n  document.addEventListener('visibilitychange', () => {\n    if (document.hidden && model.mode !== 'session' && !model.attract.on && !model.overlay\n      && (model.screen === 'Operation' || model.screen === 'Story')) {\n      setOverlay('pause');\n    }\n  });\n  window.addEventListener('resize', () => model.view?.resize?.());\n\n  function ensureDom() {\n    if (!document.body) return;\n    if (!document.getElementById('boot')) {\n      const boot = document.createElement('div');\n      boot.id = 'boot';\n      boot.textContent = 'Scrubbing in…';\n      document.body.prepend(boot);\n    }\n    let app = document.getElementById('app');\n    if (!app) {\n      app = document.createElement('div');\n      app.id = 'app';\n      app.hidden = true;\n      const canvas = document.createElement('canvas');\n      canvas.id = 'view';\n      const ui = document.createElement('div');\n      ui.id = 'ui';\n      app.append(canvas, ui);\n      document.body.append(app);\n    }\n    model.canvas = document.getElementById('view');\n    model.ui = document.getElementById('ui');\n    document.body.tabIndex = 0;\n  }\n\n  function aboutData() {\n    if (model.aboutDoc) return model.aboutDoc;\n    const el = document.getElementById('about-data');\n    try { model.aboutDoc = JSON.parse(el?.textContent || '{}'); } catch { model.aboutDoc = {}; }\n    return model.aboutDoc;\n  }\n\n  function currentItems() {\n    if (model.nogfxNotice) return [{ id: 'nogfx-ok', label: 'Continue' }];\n    if (model.mode === 'session' && model.sessionPause) return settingsItems();\n    if (model.overlay === 'chooser') return [{ id: 'continue', label: 'Continue' }, { id: 'new', label: 'New Game' }];\n    if (model.overlay === 'pause') return pauseItems();\n    if (model.overlay === 'dev') return devItems();\n    if (model.screen === 'Title') return [{ id: 'start', label: 'Press any button' }];\n    if (model.screen === 'Touch notice') return [{ id: 'settings', label: 'Settings' }];\n    if (model.screen === 'Main Menu') {\n      const story = (model.save.intro || model.save.storyPos > 0 || model.save.cleared?.length) ? 'Story' : 'Story';\n      return [\n        { id: 'story', label: story },\n        { id: 'free', label: 'Free Play' },\n        { id: 'rounds', label: 'Grand Rounds' },\n        { id: 'settings', label: 'Settings' },\n        { id: 'about', label: 'About & Credits' },\n      ];\n    }\n    if (model.screen === 'Story' && model.storyMode === 'ask') {\n      return [\n        { id: 'intern', label: 'Intern' },\n        { id: 'resident', label: 'Resident' },\n        { id: 'attending', label: 'Attending' },\n      ];\n    }\n    if (model.screen === 'Story' && model.storyMode === 'lines') return [{ id: 'advance', label: 'Continue' }];\n    if (model.screen === 'Chart') return chartItems();\n    if (model.screen === 'Report') return [{ id: 'report-next', label: 'Continue' }];\n    if (model.screen === 'Fail') return failItems();\n    if (model.screen === 'Free Play') return freeItems();\n    if (model.screen === 'Lobby') return lobbyItems();\n    if (model.screen === 'Settings') return settingsItems();\n    if (model.screen === 'About') return aboutItems();\n    if (model.screen === 'Credits roll') return [{ id: 'credits-skip', label: 'Skip' }];\n    if (model.mode === 'session' && model.screen === 'Card') return [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More Time' }];\n    return [];\n  }\n\n  function chartItems() {\n    const op = safeOp(model.opId);\n    if (op?.consult) {\n      return [\n        { id: 'careful', label: 'Careful' },\n        { id: 'aggressive', label: 'Aggressive' },\n        { id: 'begin', label: 'Begin' },\n      ];\n    }\n    return [{ id: 'begin', label: 'Begin' }];\n  }\n\n  function pauseItems() {\n    if (model.screen === 'Story') {\n      return [\n        { id: 'resume', label: 'Resume' },\n        { id: 'skip-scene', label: 'Skip Scene' },\n        { id: 'settings', label: 'Settings' },\n        { id: 'dev', label: 'Dev Mode' },\n        { id: 'quit', label: 'Quit to Menu' },\n      ];\n    }\n    return [\n      { id: 'resume', label: 'Resume' },\n      { id: 'retry', label: 'Retry Phase' },\n      { id: 'restart', label: 'Restart Operation' },\n      { id: 'settings', label: 'Settings' },\n      { id: 'dev', label: 'Dev Mode' },\n      { id: 'quit', label: 'Quit to Menu' },\n    ];\n  }\n\n  function failItems() {\n    const items = [\n      { id: 'retry', label: 'Retry Phase' },\n      { id: 'restart', label: 'Restart Operation' },\n      { id: 'quit', label: 'Quit to Menu' },\n    ];\n    if (model.sim?.notesOffer) items.push({ id: 'notes', label: \"Bea's Notes\" });\n    return items;\n  }\n\n  function freeItems() {\n    const ids = storyOrder().filter(unlocked);\n    const slice = ids.slice(model.page * 4, model.page * 4 + 4);\n    const items = slice.map((id) => {\n      const rank = model.save.ranks?.[id];\n      return { id: `play:${id}`, label: `${getOp(id).title}${rank ? ` ${rank}` : ''}` };\n    });\n    items.push({ id: 'doctor', label: `Doctor: ${model.doctor === 'ines' ? 'Ines' : 'Ren'}` });\n    return items;\n  }\n\n  function lobbyItems() {\n    return [0, 1, 2, 3].map((i) => ({\n      id: `seat:${i}`,\n      label: model.joined.has(i) ? `Seat ${i + 1} in` : `Seat ${i + 1}`,\n    })).concat([{ id: 'begin', label: 'Begin' }]);\n  }\n\n  function settingsItems() {\n    const page = SETTINGS_PAGES[model.page] || SETTINGS_PAGES[0];\n    return page.map((item) => ({ ...item, label: `${item.label}: ${readout(item.id)}` }));\n  }\n\n  function aboutItems() {\n    return ABOUT_HEADS.map(([, label], i) => ({ id: `about:${i}`, label }));\n  }\n\n  function devItems() {\n    const pages = devPages();\n    const page = pages[Math.min(model.page, pages.length - 1)] || [];\n    return page;\n  }\n\n  function devPages() {\n    const buttons = DEV_IDS.map((id) => ({\n      id,\n      kind: 'dev',\n      label: id.startsWith('op:') ? safeOp(id.slice(3))?.title || id : id,\n    }));\n    const pages = [];\n    for (let i = 0; i < buttons.length; i += 6) pages.push(buttons.slice(i, i + 6));\n    for (const page of TUNING_PAGES) {\n      pages.push(page.keys.map((key) => ({\n        id: key,\n        kind: 'slider',\n        label: key,\n        min: TUNING_RANGES[key][0],\n        max: TUNING_RANGES[key][1],\n        step: stepOf(TUNING_RANGES[key]),\n      })).concat([{ id: 'reset-page', kind: 'dev', label: 'Reset page', keys: page.keys }]));\n    }\n    pages.push([{ id: 'reset-all', kind: 'dev', label: 'Reset all' }]);\n    return pages;\n  }\n\n  function stepOf(range) {\n    const span = range[1] - range[0];\n    if (span <= 20 && Number.isInteger(range[0]) && Number.isInteger(range[1])) return 1;\n    return Math.round((span / 20) * 1000) / 1000;\n  }\n\n  function pageCount() {\n    if (model.overlay === 'dev') return devPages().length;\n    if (model.screen === 'Settings' || model.sessionPause) return SETTINGS_PAGES.length;\n    if (model.screen === 'About') return ABOUT_HEADS.length;\n    if (model.screen === 'Free Play') return Math.max(1, Math.ceil(storyOrder().filter(unlocked).length / 4));\n    return 1;\n  }\n\n  function unlocked(id) {\n    if (model.save.unlocked) return true;\n    if (model.save.cleared?.includes(id)) return true;\n    const i = storyOrder().indexOf(id);\n    return i >= 0 && i <= (model.save.storyPos || 0);\n  }\n\n  function safeOp(id) {\n    try { return getOp(id); } catch { return null; }\n  }\n\n  function defaultFocus() {\n    if (model.screen === 'Story' && model.storyMode === 'ask') return 1;\n    if (model.screen === 'Chart') return Math.max(0, chartItems().length - 1);\n    if (model.screen === 'Lobby') return 4;\n    if (model.screen === 'About') return model.page || 0;\n    return 0;\n  }\n\n  function setScreen(name, overlay = null) {\n    model.screen = name;\n    model.overlay = overlay;\n    model.page = name === 'About' ? model.page : 0;\n    if (name !== 'About') model.page = 0;\n    model.reached.add(name);\n    if (name === 'Credits roll') model.reached.add('Credits');\n    model.focus = defaultFocus();\n    document.body.dataset.screen = name;\n    syncMusic();\n    present();\n    paint(true);\n  }\n\n  function setOverlay(name) {\n    model.overlay = name;\n    model.focus = 0;\n    model.page = 0;\n    paint(true);\n  }\n\n  function readout(id) {\n    if (id === 'glyphs') return model.settings.glyphs === 'xbox' ? 'Xbox' : 'PlayStation';\n    if (id === 'rumble' || id === 'swapSticks' || id === 'fullscreen' || id === 'shake' || id === 'boil') {\n      return model.settings[id] ? 'On' : 'Off';\n    }\n    if (id === 'textSpeed') return `${model.settings.textSpeed}x`;\n    if (id === 'music' || id === 'effects' || id === 'voices') return `${Math.round((model.settings[id] ?? 0) * 100)}%`;\n    const n = id in TUNING_DEFAULTS ? model.tuning[id] : model.settings[id];\n    return `${Number(n).toFixed(2)} (default ${Number(TUNING_DEFAULTS[id] ?? n).toFixed(2)})`;\n  }\n\n  function writeSetting(id, value) {\n    if (id === 'music' || id === 'effects' || id === 'voices' || id === 'aimAssist' || id === 'tipSpeed') {\n      model.settings[id] = value;\n      if (id === 'music') audio.setMusicGain(value);\n      if (id === 'effects') audio.sfx.gain.value = value;\n      if (id === 'voices') audio.voice.gain.value = value;\n      if (id === 'aimAssist' || id === 'tipSpeed') model.tuning[id] = value;\n    } else if (id in TUNING_DEFAULTS) {\n      model.tuning[id] = value;\n    } else {\n      model.settings[id] = value;\n    }\n    const node = model.ui?.querySelector(`[data-readout=\"${id}\"]`);\n    if (node) node.textContent = readout(id);\n    persist();\n  }\n\n  function syncMusic() {\n    if (!audioOk()) return;\n    let id = 'title';\n    let bpm = 80;\n    if (model.mode === 'session') {\n      id = (model.screen === 'Card' || model.screen === 'Countdown') ? 'title' : 'rounds';\n    } else if (model.attract.on && model.sim) {\n      id = model.sim.op.music || 'rounds';\n      bpm = model.sim.op.bpm || 80;\n    } else if (model.screen === 'Story' && model.scene?.music) {\n      id = model.scene.music;\n    } else if ((model.screen === 'Operation' || model.screen === 'Chart' || model.screen === 'Report' || model.screen === 'Fail') && model.opId) {\n      const op = safeOp(model.opId);\n      id = model.screen === 'Operation' ? (op?.music || 'or-calm') : 'or-tense';\n      bpm = op?.bpm || 80;\n    } else if (model.screen === 'Credits roll') id = 'credits';\n    else if (model.screen === 'Lobby') id = 'rounds';\n    if (id !== model.track) {\n      model.track = id;\n      audio.playTrack(id, bpm);\n    }\n    audio.setHush(!!(model.sim && model.sim.hushPhase));\n  }\n\n  function present() {\n    const view = model.view;\n    if (!view) return;\n    if (model.screen === 'Story' && model.scene) {\n      const line = model.scene.lines[model.line];\n      view.showStory?.(model.scene.set, line?.who);\n      view.setSpeaker?.(line?.who, { mouth: 'open' });\n      view.shout?.(!!line?.shout);\n    } else if (model.screen === 'Operation' || model.attract.on || model.screen === 'Chart') {\n      view.showOr?.();\n      view.shout?.(false);\n    }\n  }\n\n  function decorateState(st) {\n    if (!st) return st;\n    if (!st.organ) {\n      const op = safeOp(st.op);\n      const site = op?.sites?.find((s) => s.id === st.site) || op?.sites?.[0];\n      st.organ = site?.organ || 'forearm';\n    }\n    return st;\n  }\n  model.decorateState = decorateState;\n\n  function playEvent(ev) {\n    if (!ev || !audioOk()) return;\n    if (ev.type === 'say' && ev.text) {\n      audio.say(ev.who || 'bea', ev.text);\n      model.bark = { who: ev.who || 'bea', text: ev.text };\n    } else if (ev.type === 'bark') {\n      const text = barkText(ev.key, ev.arg, ev.n || 0);\n      audio.say(ev.who || 'bea', text);\n      model.bark = { who: ev.who || 'bea', text };\n    } else if (FX[ev.type]) audio.effect(FX[ev.type]);\n    if (ev.type === 'hush' || ev.type === 'success' || ev.type === 'fail') syncMusic();\n  }\n  model.playEvent = playEvent;\n\n  function tickAudio() {\n    if (!audioOk()) return;\n    audio.scheduleAhead();\n    if (model.remoteEvents?.length) {\n      for (const ev of model.remoteEvents) playEvent(ev);\n      model.remoteEvents = [];\n    }\n  }\n  model.tickAudio = tickAudio;\n\n  function syncFromSim() {\n    if (!model.view || !model.sim || model.norender) return;\n    model.painting = true;\n    try {\n      model.view.showOr?.();\n      model.view.sync(decorateState(model.sim.state), 1 / 60);\n    } catch { /* the next pump draws */ }\n    const drawn = model.view.render?.();\n    if (drawn?.then) drawn.then(() => { model.painting = false; }, () => { model.painting = false; });\n    else model.painting = false;\n  }\n  model.syncFromSim = syncFromSim;\n\n  function askBea() {\n    const text = barkText('idle', null, (model.sim?.tick || 0) % 3);\n    audio.say('bea', text);\n    model.bark = { who: 'bea', text };\n    paint(true);\n  }\n\n  function openScene(id, onDone) {\n    const scene = SCENES.find((s) => s.id === id);\n    if (!scene) {\n      onDone?.();\n      return;\n    }\n    model.scene = scene;\n    model.sceneId = id;\n    model.line = 0;\n    model.storyMode = 'lines';\n    model.sceneDone = onDone || null;\n    setScreen('Story');\n    const line = scene.lines[0];\n    if (line && audioOk()) audio.say(line.who, line.text);\n  }\n\n  function advanceLine() {\n    const lines = model.scene?.lines || [];\n    if (model.line >= lines.length - 1) {\n      finishScene();\n      return;\n    }\n    model.line += 1;\n    const line = lines[model.line];\n    model.view?.setSpeaker?.(line.who, { mouth: 'open' });\n    model.view?.shout?.(!!line.shout);\n    if (audioOk()) audio.say(line.who, line.text);\n    paint(true);\n  }\n\n  function finishScene() {\n    const done = model.sceneDone;\n    model.sceneDone = null;\n    model.view?.shout?.(false);\n    if (done) done();\n    else setScreen('Main Menu');\n  }\n\n  function openAsk() {\n    model.storyMode = 'ask';\n    model.flow = 'story';\n    setScreen('Story');\n  }\n\n  function beginNew() {\n    model.save.storyPos = 0;\n    model.save.intro = false;\n    model.save.cleared = [];\n    model.flow = 'story';\n    model.overlay = null;\n    persist();\n    openAsk();\n  }\n\n  function confirmDifficulty(id) {\n    model.settings.difficulty = id;\n    model.save.difficulty = id;\n    persist();\n    if (!model.save.intro) openScene('S0', afterIntro);\n    else openOpStory(model.save.storyPos || 0);\n  }\n\n  function afterIntro() {\n    model.save.intro = true;\n    persist();\n    openOpStory(0);\n  }\n\n  function openOpStory(index) {\n    const order = storyOrder();\n    if (index >= order.length) {\n      openCredits();\n      return;\n    }\n    model.storyIndex = index;\n    model.flow = 'story';\n    model.save.storyPos = index;\n    model.save.intro = true;\n    persist();\n    const op = getOp(order[index]);\n    model.opId = op.id;\n    if (op.scene?.before) openScene(op.scene.before, () => openChart(op.id));\n    else openChart(op.id);\n  }\n\n  function openChart(opId) {\n    model.opId = opId;\n    model.consultChoice = 'careful';\n    model.flow = model.flow || 'story';\n    setScreen('Chart');\n  }\n\n  function openCredits() {\n    setScreen('Credits roll');\n  }\n\n  function continueReport() {\n    recordResult();\n    if (model.flow === 'couch') {\n      setScreen('Lobby');\n      return;\n    }\n    if (model.flow === 'free') {\n      setScreen('Free Play');\n      return;\n    }\n    const op = safeOp(model.opId);\n    if (op?.scene?.after) openScene(op.scene.after, afterScene);\n    else afterScene();\n  }\n\n  function afterScene() {\n    const order = storyOrder();\n    const i = order.indexOf(model.opId);\n    if (model.flow === 'story' && i >= 0 && i < order.length - 1) openOpStory(i + 1);\n    else if (model.flow === 'story') openCredits();\n    else setScreen('Main Menu');\n  }\n\n  function recordResult() {\n    if (model.attract.on || model.mode === 'session' || !model.sim || !model.opId) return;\n    if (model.sim.rank?.id) model.save.ranks[model.opId] = model.sim.rank.id;\n    if (model.flow === 'story' && model.sim.complete) {\n      if (!model.save.cleared.includes(model.opId)) model.save.cleared.push(model.opId);\n      const i = storyOrder().indexOf(model.opId);\n      if (i >= 0) model.save.storyPos = Math.max(model.save.storyPos || 0, i + 1);\n    }\n    persist();\n  }\n\n  function freeSim() {\n    try { model.sim?.physics?.free?.(); } catch { /* world already freed */ }\n    model.sim = null;\n  }\n\n  function startOperation(opId, extra = {}) {\n    model.opId = opId;\n    model.resultShown = false;\n    const op = getOp(opId);\n    const players = extra.players || 1;\n    const build = (physics) => {\n      freeSim();\n      model.sim = new Sim({\n        op: opId,\n        seed: extra.seed ?? 1,\n        physics,\n        tuning: model.tuning,\n        difficulty: model.settings.difficulty || 'resident',\n        consult: op.consult ? (model.consultChoice || 'careful') : null,\n        players,\n        couch: !!extra.couch,\n        notes: !!extra.notes,\n      });\n      if (extra.couch) {\n        for (let i = 0; i < model.sim.seats.length; i++) {\n          if (!model.joined.has(model.sim.seats[i].id)) model.sim.leave(model.sim.seats[i].id);\n        }\n      }\n      model.overlay = null;\n      setScreen('Operation');\n    };\n    if (model.test || extra.physics === false) {\n      build(false);\n      return;\n    }\n    void (async () => {\n      let physics = false;\n      try { await physicsReady(); physics = true; } catch { physics = false; }\n      if (model.mode === 'session') return;\n      build(physics);\n    })();\n  }\n\n  function mountAttract(opId) {\n    freeSim();\n    model.sim = new Sim({\n      op: opId,\n      seed: 1,\n      physics: false,\n      tuning: model.tuning,\n      difficulty: 'resident',\n      players: 1,\n      cheats: { lockVitals: true, freezeTimer: true, infiniteComposure: true, infiniteClamps: true },\n    });\n    model.opId = opId;\n    model.botOn = true;\n    model.botOpts = {};\n    model.view?.showOr?.();\n    syncMusic();\n  }\n\n  function startAttract() {\n    const order = storyOrder();\n    model.attract = { on: true, from: model.screen, opIndex: 0, opT: performance.now() };\n    mountAttract(order[0]);\n    paint(true);\n  }\n\n  function exitAttract() {\n    if (!model.attract.on) return;\n    model.attract.on = false;\n    model.botOn = false;\n    model.botOpts = {};\n    freeSim();\n    model.opId = null;\n    model.pending = {};\n    model.lastInput = performance.now();\n    syncMusic();\n    paint(true);\n  }\n\n  function nextAttractOp() {\n    const order = storyOrder();\n    model.attract.opIndex = (model.attract.opIndex + 1) % order.length;\n    model.attract.opT = performance.now();\n    mountAttract(order[model.attract.opIndex]);\n    paint(true);\n  }\n\n  function checkAttract() {\n    if (model.mode === 'session') return;\n    const idle = model.screen === 'Title' || model.screen === 'Main Menu' || model.screen === 'Free Play' || model.screen === 'Touch notice';\n    if (!model.attract.on) {\n      if (model.overlay || !idle) return;\n      if (performance.now() - model.lastInput >= 10000) startAttract();\n      return;\n    }\n    if (performance.now() - model.attract.opT >= 2000) nextAttractOp();\n  }\n\n  function joinSeat(index) {\n    model.joined.add(index);\n    paint(true);\n  }\n\n  function startCouch() {\n    if (model.joined.size === 0) {\n      joinSeat(0);\n      return;\n    }\n    model.flow = 'couch';\n    const players = [0, 1, 2, 3].map((i) => ({ id: i, name: `Seat ${i + 1}`, color: COLORS[i] }));\n    startOperation('grand-rounds', { couch: true, players });\n  }\n\n  function activate(id) {\n    if (!id) return;\n    if (id === 'nogfx-ok') {\n      model.nogfxNotice = false;\n      paint(true);\n      return;\n    }\n    if (id === 'start') {\n      setScreen('Main Menu');\n      return;\n    }\n    if (id === 'story') {\n      if (model.save.intro || (model.save.storyPos || 0) > 0 || model.save.cleared?.length) {\n        model.overlay = 'chooser';\n        model.focus = 0;\n        paint(true);\n      } else openAsk();\n      return;\n    }\n    if (id === 'continue') {\n      model.overlay = null;\n      model.flow = 'story';\n      if (!model.save.intro) openScene('S0', afterIntro);\n      else openOpStory(model.save.storyPos || 0);\n      return;\n    }\n    if (id === 'new') {\n      beginNew();\n      return;\n    }\n    if (id === 'free') {\n      model.flow = 'free';\n      setScreen('Free Play');\n      return;\n    }\n    if (id === 'rounds') {\n      model.joined = new Set();\n      setScreen('Lobby');\n      return;\n    }\n    if (id === 'settings') {\n      openSettings();\n      return;\n    }\n    if (id === 'about') {\n      model.page = 0;\n      setScreen('About');\n      return;\n    }\n    if (id === 'intern' || id === 'resident' || id === 'attending') {\n      confirmDifficulty(id);\n      return;\n    }\n    if (id === 'advance') {\n      advanceLine();\n      return;\n    }\n    if (id === 'careful' || id === 'aggressive') {\n      model.consultChoice = id;\n      model.focus = chartItems().length - 1;\n      paint(true);\n      return;\n    }\n    if (id === 'begin' && model.screen === 'Chart') {\n      model.flow = model.flow === 'free' ? 'free' : 'story';\n      startOperation(model.opId);\n      return;\n    }\n    if (id === 'begin' && model.screen === 'Lobby') {\n      startCouch();\n      return;\n    }\n    if (id.startsWith('seat:')) {\n      joinSeat(Number(id.slice(5)));\n      return;\n    }\n    if (id.startsWith('play:')) {\n      model.flow = 'free';\n      openChart(id.slice(5));\n      return;\n    }\n    if (id === 'doctor') {\n      model.doctor = model.doctor === 'ines' ? 'ren' : 'ines';\n      paint(true);\n      return;\n    }\n    if (id === 'report-next') {\n      continueReport();\n      return;\n    }\n    if (id === 'credits-skip' || id === 'skip-scene') {\n      if (model.screen === 'Credits roll' || id === 'credits-skip') setScreen('Main Menu');\n      else finishScene();\n      return;\n    }\n    if (id === 'resume') {\n      model.overlay = null;\n      paint(true);\n      return;\n    }\n    if (id === 'retry') {\n      if (model.sim && !model.sim.over) model.sim.retryPhase();\n      else model.sim?.retryPhase?.();\n      model.resultShown = false;\n      model.overlay = null;\n      setScreen('Operation');\n      return;\n    }\n    if (id === 'restart') {\n      const flow = model.flow;\n      startOperation(model.opId, { couch: flow === 'couch', players: flow === 'couch' ? [0, 1, 2, 3].map((i) => ({ id: i, name: `Seat ${i + 1}`, color: COLORS[i] })) : 1 });\n      return;\n    }\n    if (id === 'notes') {\n      try { model.sim?.acceptNotes?.(); } catch { /* notes stay offered */ }\n      model.resultShown = false;\n      model.overlay = null;\n      setScreen('Operation');\n      return;\n    }\n    if (id === 'quit') {\n      model.overlay = null;\n      freeSim();\n      setScreen('Main Menu');\n      return;\n    }\n    if (id === 'dev') {\n      if (model.mode === 'session') return;\n      setOverlay('dev');\n      return;\n    }\n    if (id === 'back-settings' || id === 'back') {\n      closeSettings();\n      return;\n    }\n    if (id.startsWith('about:')) {\n      model.page = Number(id.slice(6)) || 0;\n      model.focus = model.page;\n      paint(true);\n      return;\n    }\n    if (id.startsWith('site:')) {\n      const sim = model.sim;\n      if (!sim) return;\n      const idx = sim.op.sites.findIndex((s) => s.id === id.slice(5));\n      if (idx >= 0) sim.setSite(sim.seats[0], idx);\n      paint(true);\n      return;\n    }\n    if (id === 'glyphs') {\n      model.settings.glyphs = model.settings.glyphs === 'xbox' ? 'playstation' : 'xbox';\n      persist();\n      paint(true);\n      return;\n    }\n    if (id === 'rumble' || id === 'swapSticks' || id === 'shake' || id === 'boil') {\n      model.settings[id] = !model.settings[id];\n      if (id === 'boil') model.view?.setBoil?.(!!model.settings.boil);\n      persist();\n      paint(true);\n      return;\n    }\n    if (id === 'fullscreen') {\n      model.settings.fullscreen = !model.settings.fullscreen;\n      const node = document.documentElement;\n      if (model.settings.fullscreen) node.requestFullscreen?.().catch(() => {});\n      else document.exitFullscreen?.().catch(() => {});\n      persist();\n      paint(true);\n      return;\n    }\n    if (id === 'textSpeed') {\n      model.settings.textSpeed = model.settings.textSpeed >= 4 ? 1 : model.settings.textSpeed * 2;\n      persist();\n      paint(true);\n      return;\n    }\n    if (DEV_IDS.includes(id) || id === 'reset-page' || id === 'reset-all' || id === 'jump') {\n      const page = devPages()[model.page] || [];\n      const found = page.find((item) => item.id === id);\n      runDev(model, id, found?.keys);\n      return;\n    }\n  }\n\n  function openSettings() {\n    if (model.mode === 'session') {\n      model.sessionPause = true;\n      paint(true);\n      return;\n    }\n    model.returnTo = { screen: model.screen, overlay: model.overlay };\n    model.page = 0;\n    setScreen('Settings');\n  }\n\n  function closeSettings() {\n    if (model.mode === 'session') {\n      model.sessionPause = false;\n      paint(true);\n      return;\n    }\n    const ret = model.returnTo;\n    model.returnTo = null;\n    if (!ret) {\n      setScreen('Main Menu');\n      return;\n    }\n    setScreen(ret.screen);\n    if (ret.overlay) setOverlay(ret.overlay);\n  }\n  model.applySettings = (sample) => {\n    const menu = sample?.menu || {};\n    if (menu.pageLeft) turnPage(-1);\n    else if (menu.pageRight) turnPage(1);\n    else if (menu.up) moveFocus(-1);\n    else if (menu.down) moveFocus(1);\n    else if (menu.left) nudge(-1);\n    else if (menu.right) nudge(1);\n    else if (menu.confirm) {\n      const item = currentItems()[model.focus];\n      if (item) activate(item.id);\n    }\n  };\n\n  function moveFocus(dir) {\n    const items = currentItems();\n    if (!items.length) return;\n    model.focus = (model.focus + dir + items.length) % items.length;\n    if (model.screen === 'About' && !model.overlay) model.page = model.focus;\n    paint(true);\n  }\n\n  function turnPage(dir) {\n    const n = pageCount();\n    if (n <= 1) return false;\n    model.page = (model.page + dir + n) % n;\n    model.focus = model.screen === 'About' ? model.page : 0;\n    paint(true);\n    return true;\n  }\n\n  function nudge(dir) {\n    if (model.screen === 'Chart' && !model.overlay) {\n      const order = ['intern', 'resident', 'attending'];\n      const i = Math.max(0, order.indexOf(model.settings.difficulty || 'resident'));\n      model.settings.difficulty = order[(i + (dir < 0 ? 2 : 1)) % 3];\n      model.save.difficulty = model.settings.difficulty;\n      persist();\n      paint(true);\n      return true;\n    }\n    const item = currentItems()[model.focus];\n    if (!item) return false;\n    if (item.kind === 'slider') {\n      const cur = item.id in TUNING_DEFAULTS ? model.tuning[item.id] : (model.settings[item.id] ?? item.min);\n      const step = item.step || 0.05;\n      const v = Math.max(item.min, Math.min(item.max, Math.round((cur + dir * step) * 1000) / 1000));\n      writeSetting(item.id, v);\n      paint(true);\n      return true;\n    }\n    if (item.kind === 'toggle' || item.kind === 'cycle' || item.id === 'glyphs' || item.id === 'textSpeed') {\n      activate(item.id);\n      return true;\n    }\n    return false;\n  }\n\n  function prepFrame(id, frame) {\n    const next = { ...(frame || {}) };\n    if (model.pendingTool && (id === 0 || id === model.sim?.seats?.[0]?.id)) {\n      next.tool = model.pendingTool;\n      model.pendingTool = null;\n    }\n    const prev = model.siteHold.get(id) || 0;\n    if (next.siteDelta && next.siteDelta === prev) next.siteDelta = 0;\n    model.siteHold.set(id, frame?.siteDelta || 0);\n    return next;\n  }\n\n  function feedSim(sample) {\n    const sim = model.sim;\n    if (!sim || sim.over) return;\n    const playing = model.attract.on || (model.screen === 'Operation' && !model.overlay && !model.sessionPause);\n    if (!playing) return;\n    if (model.botOn) {\n      for (const seat of sim.seats) {\n        if (seat.out) continue;\n        sim.input(seat.id, prepFrame(seat.id, botInput(sim, seat, model.botOpts || {})));\n      }\n    } else if (model.flow === 'couch') {\n      for (const s of sample.seats) {\n        if (!model.joined.has(s.index)) continue;\n        const seat = sim.seats.find((x) => x.id === s.index);\n        if (seat && !seat.out) sim.input(seat.id, prepFrame(seat.id, s.frame));\n      }\n    } else {\n      const s0 = sample.seats.find((s) => s.index === 0);\n      const seat = sim.seats[0];\n      if (s0 && seat) sim.input(seat.id, prepFrame(seat.id, s0.frame));\n    }\n    if (model.override && sim.seats[0]) {\n      sim.input(sim.seats[0].id, prepFrame(sim.seats[0].id, model.override));\n    }\n    sim.step();\n    for (const ev of sim.events || []) playEvent(ev);\n    if (model.attract.on && sim.over) nextAttractOp();\n    else if (!model.attract.on && sim.over && !model.resultShown) {\n      model.resultShown = true;\n      if (sim.complete) setScreen('Report');\n      else setScreen('Fail');\n    }\n  }\n\n  function realInput(sample, menu, pend) {\n    if (Object.values(menu).some(Boolean) || Object.values(pend).some(Boolean)) return true;\n    return sample.seats.some((s) => {\n      if (s.edges && Object.values(s.edges).some(Boolean)) return true;\n      const f = s.frame;\n      return f && (Math.hypot(f.x || 0, f.y || 0) > 0.2 || (f.use || 0) > 0.2);\n    });\n  }\n\n  let busy = false;\n  function stepOnce() {\n    if (busy || model.mode === 'session') return;\n    busy = true;\n    try {\n      const sample = model.input.poll();\n      const pend = model.pending;\n      model.pending = {};\n      const menu = { ...sample.menu };\n      for (const k of Object.keys(pend)) if (pend[k]) menu[k] = true;\n      model.input.takeClick();\n      if (realInput(sample, menu, pend)) model.lastInput = performance.now();\n      if (model.attract.on && (realInput(sample, menu, pend) || sample.hover)) {\n        model.ignoreUntil = performance.now() + 350;\n        exitAttract();\n        return;\n      }\n      if (performance.now() < model.ignoreUntil && (menu.confirm || menu.back || pend.confirm)) return;\n      if (model.screen === 'Touch notice' && (pend.leaveTouch || sample.seenPad || model.input.seenPad)) {\n        if (pend.leaveTouch || sample.seats.some((s) => s.edges && Object.values(s.edges).some(Boolean))) {\n          setScreen('Title');\n          return;\n        }\n      }\n      const padPause = sample.seats.some((s) => s.edges?.pause);\n      const inPlay = model.screen === 'Operation' && !model.overlay;\n      if ((pend.pause || padPause || (menu.back && model.screen === 'Story' && !model.overlay)) && model.mode !== 'session') {\n        if (inPlay || model.screen === 'Story' || pend.pause || padPause) {\n          setOverlay('pause');\n          return;\n        }\n      }\n      if (menu.back && model.overlay) {\n        if (model.overlay === 'dev') setOverlay('pause');\n        else if (model.screen === 'Settings') closeSettings();\n        else {\n          model.overlay = null;\n          paint(true);\n        }\n        return;\n      }\n      feedSim(sample);\n      if (model.screen === 'Lobby' && !model.overlay) {\n        let joinedNow = false;\n        for (const s of sample.seats) {\n          if (s.edges?.confirm) {\n            joinSeat(s.index);\n            joinedNow = true;\n          }\n        }\n        if (joinedNow && !menu.confirm && !pend.confirm) return;\n      }\n      if (model.screen === 'Story' && model.storyMode === 'lines' && !model.overlay) {\n        if (menu.skip || pend.skip) {\n          finishScene();\n          return;\n        }\n        if (menu.confirm || pend.confirm) {\n          model.hold = 0;\n          advanceLine();\n          return;\n        }\n        const speed = model.settings.textSpeed || 1;\n        if (sample.held?.confirm) {\n          model.hold += speed;\n          if (model.hold >= 3) {\n            model.hold = 0;\n            advanceLine();\n          }\n        }\n        return;\n      }\n      if (menu.pageLeft || pend.pageLeft) {\n        if (turnPage(-1)) return;\n      }\n      if (menu.pageRight || pend.pageRight) {\n        if (turnPage(1)) return;\n      }\n      if ((menu.left || pend.left) && nudge(-1)) return;\n      if ((menu.right || pend.right) && nudge(1)) return;\n      const padUp = sample.seats.some((s) => s.edges?.up);\n      const padDown = sample.seats.some((s) => s.edges?.down);\n      if (menu.up || pend.up || (padUp && !inPlay)) moveFocus(-1);\n      else if (menu.down || pend.down || (padDown && !inPlay)) moveFocus(1);\n      else if (inPlay && padDown) askBea();\n      const padConfirm = sample.seats.some((s) => s.edges?.confirm);\n      const confirm = menu.confirm || pend.confirm || (padConfirm && model.screen !== 'Operation');\n      if (confirm && model.screen !== 'Operation') {\n        const item = currentItems()[model.focus];\n        if (item) activate(item.id);\n      } else if ((menu.back || pend.back) && !inPlay) {\n        if (model.screen === 'Settings') closeSettings();\n        else if (model.screen !== 'Title' && model.screen !== 'Main Menu' && model.screen !== 'Touch notice') {\n          const prev = model.stack.pop();\n          setScreen(prev || 'Main Menu');\n        }\n      }\n      tickAudio();\n    } finally {\n      busy = false;\n    }\n  }\n\n  function btn(item, index) {\n    const on = index === model.focus ? ' on' : '';\n    const pick = item.id === model.consultChoice ? ' pick' : '';\n    const slider = item.kind === 'slider'\n      ? `<input type=\"range\" data-slider=\"${esc(item.id)}\" min=\"${item.min}\" max=\"${item.max}\" step=\"${item.step || 0.01}\" value=\"${item.id in TUNING_DEFAULTS ? model.tuning[item.id] : (model.settings[item.id] ?? item.min)}\">`\n      : '';\n    return `<button class=\"item${on}${pick}\" data-item=\"${esc(item.id)}\" type=\"button\"><span data-readout=\"${esc(item.id)}\">${esc(item.label)}</span>${slider}</button>`;\n  }\n\n  function menuBlock(title, items, extra = '') {\n    model.focus = Math.max(0, Math.min(model.focus, Math.max(0, items.length - 1)));\n    return `<section class=\"screen\"><h1 class=\"logo\">${esc(title)}</h1>${extra}<div class=\"menu\">${items.map(btn).join('')}</div></section>`;\n  }\n\n  function paint(force) {\n    const ui = model.ui;\n    if (!ui) return;\n    const sig = [\n      model.screen, model.overlay, model.storyMode, model.line, model.focus, model.page,\n      model.attract.on ? model.attract.opIndex : '', model.sessionPause, model.countN,\n      model.card ? `${model.card.left}:${(model.card.ready || []).join(',')}` : '',\n      model.opId, model.sceneId, model.nogfxNotice, model.consultChoice, model.settings.difficulty,\n      model.settings.glyphs, [...model.joined].join(','), model.sim?.phase?.id || '', model.sim?.over || '',\n      model.bark?.text || '', model.flow, model.doctor || '',\n    ].join('|');\n    document.body.dataset.screen = model.attract.on ? (model.attract.from || model.screen) : model.screen;\n    if (!force && sig === model.paintSig) {\n      patchLive();\n      return;\n    }\n    model.paintSig = sig;\n    const boot = document.getElementById('boot');\n    const app = document.getElementById('app');\n    if (boot) boot.hidden = model.screen !== 'Boot';\n    if (app) app.hidden = model.screen === 'Boot';\n    if (model.nogfxNotice) {\n      ui.innerHTML = `<section class=\"screen nogfx\"><p>This room cannot draw. A browser with graphics can open the chart. Your progress is still here.</p>${btn({ id: 'nogfx-ok', label: 'Continue' }, 0)}</section>`;\n      return;\n    }\n    if (model.mode === 'session' && model.screen === 'Card') {\n      paintCard(ui);\n      return;\n    }\n    if (model.mode === 'session' && model.screen === 'Countdown') {\n      ui.innerHTML = `<section class=\"screen\"><p class=\"big\">${esc(model.countN || '')}</p></section>`;\n      return;\n    }\n    if (model.screen === 'Round over') {\n      ui.innerHTML = '<section class=\"screen\"><h1 class=\"big\">Round over</h1><p class=\"note\">The table is clear.</p></section>';\n      return;\n    }\n    if (model.attract.on) {\n      ui.innerHTML = `${hudHtml()}<p class=\"demo\">DEMO</p><p class=\"press\">Press any button</p>${model.attract.from === 'Touch notice' ? touchHtml() : ''}`;\n      return;\n    }\n    if (model.sessionPause) {\n      ui.innerHTML = `${hudHtml()}<div class=\"overlay\">${menuBlock('Settings', settingsItems(), pageDots())}</div>`;\n      return;\n    }\n    if (model.overlay === 'pause') {\n      ui.innerHTML = `<div class=\"overlay\">${menuBlock('Paused', pauseItems())}</div>`;\n      return;\n    }\n    if (model.overlay === 'dev') {\n      ui.innerHTML = `<div class=\"overlay\">${menuBlock('Dev', devItems(), pageDots())}</div>`;\n      return;\n    }\n    if (model.overlay === 'chooser') {\n      ui.innerHTML = menuBlock(GAME_TITLE, currentItems(), '<p class=\"tag\">The chart is already open.</p>');\n      return;\n    }\n    if (model.screen === 'Title') {\n      ui.innerHTML = `<section class=\"screen\"><h1 class=\"logo\" id=\"title\"></h1><p class=\"tag\" id=\"tagline\"></p><div class=\"ecg-line\"></div><div class=\"menu\">${btn({ id: 'start', label: 'Press any button' }, 0)}</div></section>`;\n      ui.querySelector('#title').textContent = GAME_TITLE;\n      ui.querySelector('#tagline').textContent = TAGLINE;\n      return;\n    }\n    if (model.screen === 'Touch notice') {\n      ui.innerHTML = touchHtml();\n      return;\n    }\n    if (model.screen === 'Main Menu') {\n      ui.innerHTML = menuBlock(GAME_TITLE, currentItems());\n      const h = ui.querySelector('.logo');\n      if (h) h.textContent = GAME_TITLE;\n      return;\n    }\n    if (model.screen === 'Story' && model.storyMode === 'ask') {\n      ui.innerHTML = `<section class=\"screen\"><p class=\"obj\">How much do you hate yourself, child?</p><div class=\"menu\">${currentItems().map(btn).join('')}</div></section>`;\n      return;\n    }\n    if (model.screen === 'Story' && model.storyMode === 'lines') {\n      const line = model.scene?.lines?.[model.line];\n      const who = castOf(line?.who || 'narration');\n      ui.innerHTML = `<section class=\"screen\"><p class=\"where\">${esc(model.scene?.where || '')}</p><div class=\"dialogue${line?.shout ? ' shout' : ''}\" data-item=\"advance\"><p class=\"who\">${esc(who.name)}</p><p>${esc(line?.text || '')}</p></div><div class=\"menu\">${btn({ id: 'advance', label: 'Continue' }, 0)}</div></section>`;\n      return;\n    }\n    if (model.screen === 'Chart') ui.innerHTML = chartHtml();\n    else if (model.screen === 'Operation') ui.innerHTML = hudHtml();\n    else if (model.screen === 'Report') ui.innerHTML = reportHtml();\n    else if (model.screen === 'Fail') ui.innerHTML = failHtml();\n    else if (model.screen === 'Free Play') ui.innerHTML = menuBlock('Chart Board', freeItems(), `<p class=\"note\">${esc(DIFFICULTY[model.settings.difficulty]?.label || 'Resident')}</p>${pageDots()}`);\n    else if (model.screen === 'Lobby') ui.innerHTML = lobbyHtml();\n    else if (model.screen === 'Settings') ui.innerHTML = menuBlock('Settings', settingsItems(), pageDots());\n    else if (model.screen === 'About') ui.innerHTML = aboutHtml();\n    else if (model.screen === 'Credits roll') ui.innerHTML = `<section class=\"screen\"><h1 class=\"big\">Credits</h1><p class=\"note\">The lamp stays on.</p><div class=\"menu\">${btn({ id: 'credits-skip', label: 'Skip' }, 0)}</div></section>`;\n    else ui.innerHTML = '<section class=\"screen\"><p class=\"note\">Scrubbing in…</p></section>';\n  }\n  model.paint = () => paint(false);\n\n  function patchLive() {\n    const st = liveState();\n    const set = (sel, text) => {\n      const node = model.ui.querySelector(sel);\n      if (node) node.textContent = text;\n    };\n    if (st) {\n      set('[data-live=\"vitals\"]', st.vitals == null ? '' : String(Math.round(st.vitals)));\n      set('[data-live=\"timer\"]', st.timer == null ? '' : clock(st.timer));\n      set('[data-live=\"score\"]', st.score == null ? '' : String(st.score));\n      set('[data-live=\"bpm\"]', st.bpm == null ? '' : String(Math.round(st.bpm)));\n      const tool = st.tool;\n      model.ui.querySelectorAll('[data-tool]').forEach((b) => b.classList.toggle('on', b.dataset.tool === tool));\n    }\n  }\n\n  function liveState() {\n    if (model.sim) {\n      return {\n        vitals: model.sim.vitals,\n        timer: model.sim.noTimer ? null : model.sim.timer,\n        score: model.sim.score,\n        bpm: model.sim.beat?.bpm,\n        tool: model.sim.seats[0]?.tool,\n      };\n    }\n    return null;\n  }\n\n  function touchHtml() {\n    return `<section class=\"screen\"><p class=\"touch-copy\">Controller or keyboard required</p><div class=\"menu\">${btn({ id: 'settings', label: 'Settings' }, model.focus)}</div></section>`;\n  }\n\n  function pageDots() {\n    const n = pageCount();\n    if (n <= 1) return '';\n    return `<p class=\"pages\">Page ${model.page + 1} / ${n}</p>`;\n  }\n\n  function hudHtml() {\n    const sim = model.sim;\n    const op = sim?.op || safeOp(model.opId);\n    const objective = sim?.objective || sim?.phase?.objective || '';\n    const seats = sim?.seats || [];\n    const seat = seats[0];\n    const tools = (sim?.phase?.tools || []).join(' ');\n    const sites = op?.sites || [];\n    const siteBits = sites.length > 1 ? sites.map((s) => `<button type=\"button\" data-item=\"site:${esc(s.id)}\" class=\"item${s.id === sim?.activeSite ? ' on' : ''}\">${esc(s.organ || s.id)}</button>`).join('') : '';\n    const wheel = WHEEL.map((tool) => `<button type=\"button\" data-tool=\"${tool}\" class=\"${seat?.tool === tool ? 'on' : ''}\">${esc(tool)}</button>`).join('');\n    const prompt = fillPrompt('{special} gift   {syringe} stabilizer   {pause} pause', model.input?.promptSet || 'keyboard');\n    const bark = model.bark ? `<div class=\"bark\"><p class=\"who\">${esc(castOf(model.bark.who).name)}</p><p>${esc(model.bark.text)}</p></div>` : '';\n    return `<div class=\"hud\"><div class=\"hud-top\"><p class=\"obj\">${esc(objective)}</p><div><p class=\"vitals\" data-live=\"vitals\">${sim ? Math.round(sim.vitals) : ''}</p><div class=\"ecg-line\" id=\"ecg\"></div><p class=\"timer\" data-live=\"bpm\">${sim ? Math.round(sim.beat.bpm) : ''}</p></div><div><p class=\"timer\" data-live=\"timer\">${sim && !sim.noTimer ? clock(sim.timer) : ''}</p><p class=\"score\" data-live=\"score\">${sim ? sim.score : ''}</p></div></div><div></div><div class=\"hud-bot\"><div class=\"wheel\">${wheel}</div><div>${bark}<p class=\"note\">${esc(tools)}</p><div class=\"pages\">${siteBits}</div></div><div class=\"note\">${prompt}</div></div></div>`;\n  }\n\n  function chartHtml() {\n    const op = safeOp(model.opId);\n    const p = op?.patient || {};\n    const diff = DIFFICULTY[model.settings.difficulty]?.label || 'Resident';\n    const items = chartItems();\n    return `<section class=\"screen\"><p class=\"who\">${esc(op?.title || '')}</p><h1 class=\"big\">${esc(p.name || '')}</h1><p class=\"note\">${esc(p.age || '')} · ${esc(p.job || '')}</p><p class=\"obj\">${esc(p.note || '')}</p><p class=\"note\">Difficulty ${esc(diff)}. Left and right change it.</p><div class=\"menu\">${items.map(btn).join('')}</div></section>`;\n  }\n\n  function reportHtml() {\n    const sim = model.sim;\n    const op = safeOp(model.opId);\n    const rank = sim?.rank;\n    const accuracy = sim?.seats?.[0]?.stats?.Accuracy ?? 100;\n    const seats = (sim?.seats || []).filter((s) => !s.out).map((s) => `<p class=\"note\">${esc(s.name)} ${s.score}</p>`).join('');\n    return `<section class=\"screen\"><p class=\"big\">${esc(rank?.id || '')}</p><p class=\"obj\">${esc(rank?.title || sim?.report?.text || '')}</p><div class=\"row\"><span>Time</span><span>${esc(clock(sim?.time || 0))}</span></div><div class=\"row\"><span>Vitals</span><span>${esc(Math.round(sim?.vitalsMin ?? sim?.vitals ?? 0))}</span></div><div class=\"row\"><span>Precision</span><span>${esc(accuracy)}</span></div><div class=\"row\"><span>Best Combo</span><span>${esc(sim?.bestCombo || 0)}</span></div><p class=\"note\">${esc(op?.patient?.followUp || '')}</p>${seats}<div class=\"menu\">${btn({ id: 'report-next', label: 'Continue' }, 0)}</div></section>`;\n  }\n\n  function failHtml() {\n    const reason = FAIL_TITLE[model.sim?.failed] || 'FLATLINE';\n    const line = barkText('fail', null, 0);\n    return `<section class=\"screen\"><h1 class=\"fail-title\">${esc(reason)}</h1><div class=\"bark\"><p class=\"who\">Bea</p><p>${esc(line)}</p></div><div class=\"menu\">${failItems().map(btn).join('')}</div></section>`;\n  }\n\n  function lobbyHtml() {\n    const items = lobbyItems();\n    const prompt = fillPrompt('Press {confirm} to join', model.input?.promptSet || 'keyboard');\n    return `<section class=\"screen\"><h1 class=\"big\">Grand Rounds</h1><p class=\"note\">${prompt}</p><div class=\"seats\">${[0, 1, 2, 3].map((i) => `<div class=\"seat\" style=\"color:${COLORS[i]}\">${model.joined.has(i) ? 'In' : 'Open'}</div>`).join('')}</div><div class=\"menu\">${items.map(btn).join('')}</div></section>`;\n  }\n\n  function aboutHtml() {\n    const data = aboutData();\n    const page = Math.min(model.page, ABOUT_HEADS.length - 1);\n    const [key, label] = ABOUT_HEADS[page];\n    const tabs = ABOUT_HEADS.map(([, name], i) => btn({ id: `about:${i}`, label: name }, i)).join('');\n    let body = '';\n    const block = data[key];\n    if (block && !Array.isArray(block) && typeof block === 'object') {\n      body = Object.entries(block).map(([k, v]) => `<p class=\"about-line\">${esc(k)}: ${esc(v)}</p>`).join('');\n    } else if (Array.isArray(block)) {\n      body = block.map((line) => `<p class=\"about-line\">${esc(line)}</p>`).join('');\n    }\n    if (key === 'credits') {\n      const lines = Array.isArray(data.credits) ? data.credits : [];\n      body = lines.map((line) => `<p class=\"about-line\">${esc(line)}</p>`).join('');\n      body += `<p class=\"about-line\">Renderer: ${esc(model.view?.backend || 'none')}</p>`;\n    }\n    return `<section class=\"screen\"><div class=\"tabs\">${tabs}</div><h1 class=\"obj\">${esc(label)}</h1><div class=\"page on\">${body}</div></section>`;\n  }\n\n  function paintCard(ui) {\n    ui.replaceChildren();\n    const wrap = document.createElement('section');\n    wrap.className = 'screen card';\n    const h = document.createElement('h1');\n    h.className = 'logo';\n    h.textContent = GAME_TITLE;\n    const tag = document.createElement('p');\n    tag.className = 'tag';\n    tag.textContent = TAGLINE;\n    const goal = document.createElement('p');\n    goal.className = 'obj';\n    goal.textContent = 'Keep the patient alive and finish the operation together';\n    const list = document.createElement('div');\n    list.className = 'seats';\n    const ready = new Set(model.card?.ready || []);\n    for (const p of model.sessionInfo?.players || []) {\n      const seat = document.createElement('div');\n      seat.className = 'seat';\n      if (/^#[0-9a-fA-F]{3,8}$/.test(p.color || '')) seat.style.color = p.color;\n      seat.textContent = `${p.name || 'Surgeon'}${ready.has(p.id) ? ' ready' : ''}`;\n      list.append(seat);\n    }\n    const secs = document.createElement('p');\n    secs.className = 'vitals';\n    if (model.card?.left != null) secs.textContent = String(Math.max(0, Math.ceil(model.card.left)));\n    const how = document.createElement('p');\n    how.className = 'note';\n    how.textContent = 'Aim with the right stick or the mouse. Use with R2 or click. Tools are the left stick or the number keys.';\n    const menu = document.createElement('div');\n    menu.className = 'menu';\n    for (const item of [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More Time' }]) {\n      const b = document.createElement('button');\n      b.type = 'button';\n      b.className = 'item';\n      b.dataset.item = item.id;\n      b.textContent = item.label;\n      menu.append(b);\n    }\n    wrap.append(h, tag, goal, list, secs, how, menu);\n    ui.append(wrap);\n  }\n\n  function state() {\n    const sim = model.sim;\n    const net = !sim ? model.netState : null;\n    const seats = sim?.seats || net?.seats || [];\n    const seat = seats.find((s) => !s.out) || seats[0];\n    const items = currentItems();\n    const rank = sim?.rank?.id || (typeof net?.rank === 'string' ? net.rank : net?.rank?.id) || null;\n    return {\n      screen: model.screen,\n      op: sim?.op?.id || net?.op || null,\n      phase: sim?.phase?.id || net?.phase || null,\n      vitals: sim ? sim.vitals : (net?.vitals ?? null),\n      timer: sim ? sim.timer : (net?.timer ?? null),\n      score: sim ? sim.score : (net?.score ?? 0),\n      rank,\n      bpm: sim ? sim.beat.bpm : (net?.bpm ?? null),\n      beat: sim ? sim.beat.count : (net?.beat ?? 0),\n      site: sim ? sim.activeSite : (net?.site ?? null),\n      tool: seat?.tool || null,\n      tips: seats.map((s) => ({ id: s.id, x: s.x, y: s.y, tool: s.tool, score: s.score || 0 })),\n      focusId: items[model.focus]?.id || null,\n      promptSet: model.input?.promptSet || document.documentElement.dataset.promptSet || 'keyboard',\n      glyphSet: model.settings.glyphs || 'playstation',\n      attract: !!model.attract.on,\n      devOpen: model.overlay === 'dev',\n      renderBackend: model.view?.backend || 'none',\n      musicGain: model.audio?.music?.gain?.value ?? 0.1,\n      tuning: model.tuning,\n      reached: [...model.reached],\n    };\n  }\n\n  const api = {\n    state,\n    audio,\n    devRun(id, arg) { return runDev(model, id, arg); },\n  };\n  if (model.test) {\n    api.test = {\n      step(n) {\n        const count = Math.max(0, n | 0);\n        for (let i = 0; i < count; i++) stepOnce();\n      },\n      warp(n) { model.warp = n | 0; },\n      input(frame) { model.override = frame || null; },\n      bot(on, opts) {\n        model.botOn = !!on;\n        if (opts) model.botOpts = opts;\n      },\n      skipTo(op, phase) {\n        model.flow = model.flow || 'free';\n        model.opId = op;\n        freeSim();\n        model.sim = new Sim({\n          op, seed: 1, physics: false, tuning: model.tuning,\n          difficulty: model.settings.difficulty || 'resident', players: 1,\n        });\n        if (phase) model.sim.skipTo(phase);\n        model.resultShown = false;\n        model.overlay = null;\n        setScreen('Operation');\n      },\n      hash() { return model.sim ? model.sim.hash() : ''; },\n    };\n  }\n\n  let raf = 0;\n  let timer = 0;\n  function draw() {\n    if (model.mode === 'session' || !model.view || model.norender || model.painting) return;\n    model.painting = true;\n    try {\n      if (model.sim && (model.attract.on || model.screen === 'Operation')) {\n        model.view.showOr?.();\n        model.view.sync(decorateState(model.sim.state), 1 / 60);\n      } else if (model.screen === 'Story') present();\n    } catch { /* draw again next frame */ }\n    const drawn = model.view.render?.();\n    if (drawn?.then) drawn.then(() => { model.painting = false; }, () => { model.painting = false; });\n    else model.painting = false;\n  }\n\n  function loop() {\n    raf = requestAnimationFrame(loop);\n    if (model.mode === 'session') return;\n    checkAttract();\n    if (model.test && !(model.warp > 0)) {\n      /* scripted steps own the sim */\n    } else {\n      const n = model.warp > 0 ? model.warp : 1;\n      for (let i = 0; i < n; i++) stepOnce();\n    }\n    draw();\n  }\n\n  function wantsTouch() {\n    const mq = window.matchMedia?.('(any-pointer: fine)');\n    if (!mq) return false;\n    return mq.matches === false && !model.input.seenPad;\n  }\n\n  async function bootView() {\n    if (!model.canvas) return;\n    if (model.norender) {\n      model.view = createPointerCamera(model.canvas);\n      return;\n    }\n    const webgl = model.params.get('webgl') === '1';\n    try {\n      model.view = await createView(model.canvas, { webgl });\n    } catch {\n      try {\n        model.view = await createView(model.canvas, { webgl: true });\n      } catch {\n        model.view = createPointerCamera(model.canvas);\n        model.nogfxNotice = true;\n        paint(true);\n      }\n    }\n    if (model.settings.boil === false) model.view?.setBoil?.(false);\n  }\n\n  return {\n    api,\n    startSession(info) {\n      model.mode = 'session';\n      model.sessionInfo = info;\n      model.paint = () => paint(false);\n      model.syncFromSim = syncFromSim;\n      model.applySettings = model.applySettings;\n      model.tickAudio = tickAudio;\n      model.playEvent = playEvent;\n      model.decorateState = decorateState;\n      if (raf) cancelAnimationFrame(raf);\n      if (timer) clearInterval(timer);\n      runSession(model, info);\n    },\n    async startStandalone() {\n      model.mode = 'standalone';\n      model.lastInput = performance.now();\n      if (wantsTouch()) setScreen('Touch notice');\n      else setScreen('Title');\n      try { document.body.focus(); } catch { /* focus is a courtesy */ }\n      raf = requestAnimationFrame(loop);\n      timer = setInterval(() => {\n        if (model.mode === 'session') return;\n        checkAttract();\n        if (model.attract.on && model.test) {\n          for (let i = 0; i < 4; i++) stepOnce();\n        }\n      }, 250);\n      await bootView();\n      present();\n      draw();\n    },\n  };\n}\n","old_string":""}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":14949,"output_tokens":24106,"cache_read_input_tokens":132608,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"1cb279de-37a1-4bd5-a9c7-7c0227d5642e"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-39c49215-f958-491f-8d96-f7a4ee8ea97e-55","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"import { createApp } from './app/director.js';\\n\\nconst params = new URLSearchParams(location.search);\\nconst app = createApp({ params });\\nwindow.__game = app.api;\\nconst info = await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true });\\nif (info) app.startSession(info);\\nelse await app.startStandalone();\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/main.js has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/main.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/main.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"import { createApp } from './app/director.js';\\n\\nconst params = new URLSearchParams(location.search);\\nconst app = createApp({ params });\\nwindow.__game = app.api;\\nconst info = await AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true });\\nif (info) app.startSession(info);\\nelse await app.startStandalone();\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false},{"type":"tool_result","tool_use_id":"call-39c49215-f958-491f-8d96-f7a4ee8ea97e-56","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"import { GAME_TITLE, TAGLINE } from '../config/identity.js';\\nimport { createTuning, DIFFICULTY, TUNING_DEFAULTS, TUNING_PAGES, TUNING_RANGES } from '../config/tuning.js';\\nimport { getOp, storyOrder } from '../data/ops/index.js';\\nimport { SCENES } from '../data/story/scenes.js';\\nimport { castOf } from '../data/cast.js';\\nimport { barkText } from '../data/barks.js';\\nimport { fillPrompt } from '../input/glyphs.js';\\nimport { createInput } from '../input/input.js';\\nimport { createAudio } from '../audio/engine.js';\\nimport { Sim } from '../sim/sim.js';\\nimport { botInput } from '../sim/bot.js';\\nimport { physicsReady } from '../sim/physics.js';\\nimport { createPointerCamera, createView } from '../view/renderer.js';\\nimport { loadSave, writeSave } from './save.js';\\nimport { DEV_IDS, runDev } from './dev.js';\\nimport { runSession } from './session.js';\\n\\nconst COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\\nconst WHEEL = ['scalpel', 'forceps', 'suction', 'gel', 'suture', 'laser', 'scanner', 'clamp'];\\nconst ABOUT_HEADS = [\\n  ['sourceInformation', 'Source Information'],\\n  ['testingFeedback', 'Testing Feedback'],\\n  ['engineFeedback', 'Engine Feedback'],\\n  ['promptFeedback', 'Prompt Feedback'],\\n  ['credits', 'Credits'],\\n];\\nconst FAIL_TITLE = { vitals: 'FLATLINE', time: 'TIME', miss: 'MALPRACTICE' };\\nconst FX = {\\n  pop: 'pop', cut: 'scalpel', clamp: 'clamp', unclamp: 'clamp', shock: 'defib',\\n  inject: 'syringe', stabilize: 'syringe', gelled: 'gel', sealed: 'gel', tied: 'stitch',\\n  gate: 'thread', lasered: 'laser', scorch: 'laser', vent: 'laser', mark: 'scanner',\\n  nick: 'alarm', tear: 'alarm', fail: 'flatline', success: 'stamp', hush: 'murmur',\\n  sforzando: 'phone', arrest: 'alarm', drained: 'suction', tray: 'forceps', grip: 'forceps',\\n  drop: 'forceps', note: 'ui-move', pin: 'clamp', downed: 'pop', burst: 'pop', wake: 'chitter',\\n  fortissimo: 'screech', reattach: 'scratch', jerk: 'scratch', cue: 'ui-move',\\n};\\n\\nconst SETTINGS_PAGES = [\\n  [\\n    { id: 'music', label: 'Music', kind: 'slider', min: 0, max: 1, step: 0.01 },\\n    { id: 'effects', label: 'Effects', kind: 'slider', min: 0, max: 1, step: 0.01 },\\n    { id: 'voices', label: 'Voices', kind: 'slider', min: 0, max: 1, step: 0.01 },\\n  ],\\n  [\\n    { id: 'glyphs', label: 'Glyphs', kind: 'toggle' },\\n    { id: 'rumble', label: 'Rumble', kind: 'toggle' },\\n    { id: 'aimAssist', label: 'Aim Assist', kind: 'slider', min: 0, max: 1, step: 0.01 },\\n    { id: 'swapSticks', label: 'Swap Sticks', kind: 'toggle' },\\n    { id: 'tipSpeed', label: 'Tip Speed', kind: 'slider', min: 0.8, max: 3.5, step: 0.05 },\\n  ],\\n  [\\n    { id: 'fullscreen', label: 'Fullscreen', kind: 'toggle' },\\n    { id: 'shake', label: 'Screen Shake', kind: 'toggle' },\\n    { id: 'boil', label: 'Line Boil', kind: 'toggle' },\\n    { id: 'textSpeed', label: 'Text Speed', kind: 'cycle' },\\n  ],\\n];\\n\\nfunction esc(s) {\\n  return String(s ?? '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\\n}\\n\\nfunction clock(t) {\\n  const s = Math.max(0, Math.ceil(Number(t) || 0));\\n  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;\\n}\\n\\nexport function createApp({ params }) {\\n  const save = loadSave();\\n  const tuning = createTuning();\\n  const settings = {\\n    glyphs: 'playstation',\\n    music: 0.1,\\n    effects: 0.8,\\n    voices: 0.8,\\n    rumble: true,\\n    shake: true,\\n    boil: true,\\n    textSpeed: 1,\\n    difficulty: save.difficulty || 'resident',\\n    aimAssist: tuning.aimAssist,\\n    tipSpeed: tuning.tipSpeed,\\n    swapSticks: false,\\n    fullscreen: false,\\n    ...(save.settings || {}),\\n  };\\n  tuning.aimAssist = settings.aimAssist;\\n  tuning.tipSpeed = settings.tipSpeed;\\n\\n  const model = {\\n    screen: 'Boot',\\n    overlay: null,\\n    mode: 'standalone',\\n    params,\\n    tuning,\\n    settings,\\n    save,\\n    reached: new Set(),\\n    overlays: {},\\n    botOn: false,\\n    botOpts: {},\\n    warp: 0,\\n    test: params.get('test') === '1',\\n    norender: params.get('norender') === '1',\\n    pending: {},\\n    lastInput: performance.now(),\\n    attract: { on: false, from: null, opIndex: 0, opT: 0 },\\n    resultShown: false,\\n    sessionPause: false,\\n    focus: 0,\\n    page: 0,\\n    stack: [],\\n    joined: new Set(),\\n    siteHold: new Map(),\\n    storyMode: null,\\n    line: 0,\\n    consultChoice: 'careful',\\n    flow: 'story',\\n    storyIndex: 0,\\n    hold: 0,\\n    track: null,\\n    bark: null,\\n    ignoreUntil: 0,\\n    paintSig: '',\\n    painting: false,\\n    countN: 0,\\n    card: null,\\n    nogfxNotice: false,\\n  };\\n\\n  function persist() {\\n    if (model.attract.on || model.mode === 'session') return;\\n    model.save.difficulty = model.settings.difficulty;\\n    model.save.settings = { ...model.settings };\\n    writeSave(model.save);\\n  }\\n\\n  function audioOk() {\\n    return !model.sessionInfo?.server;\\n  }\\n\\n  const audio = createAudio();\\n  audio.setMusicGain(settings.music ?? 0.1);\\n  audio.sfx.gain.value = settings.effects ?? 0.8;\\n  audio.voice.gain.value = settings.voices ?? 0.8;\\n  model.audio = audio;\\n\\n  function onKey(e) {\\n    if (e.repeat) return;\\n    if (e.key === 'Tab') e.preventDefault();\\n    audio.resume();\\n    model.lastInput = performance.now();\\n    if (model.attract.on) {\\n      model.pending = {};\\n      model.ignoreUntil = performance.now() + 350;\\n      exitAttract();\\n      return;\\n    }\\n    if (model.mode === 'session' && (model.screen === 'Card' || AIHub.time?.() === -Infinity)) {\\n      const k = String(e.key || e.code || '').toLowerCase();\\n      if (k === 'enter' || k === ' ' || k === 'space') AIHub.answer('ready');\\n      else if (k === 'm') AIHub.answer('more');\\n      return;\\n    }\\n    if (model.screen === 'Touch notice') {\\n      model.pending.leaveTouch = true;\\n      return;\\n    }\\n    const key = String(e.key || '');\\n    const code = String(e.code || e.key || '');\\n    if (model.screen === 'Title') {\\n      model.pending.confirm = true;\\n      return;\\n    }\\n    const inPlay = model.screen === 'Operation' && !model.overlay && !model.sessionPause;\\n    if (inPlay && (key === 'h' || key === 'H' || code === 'KeyH')) {\\n      askBea();\\n      return;\\n    }\\n    if (key === 'Escape' || key === 'Backspace' || code === 'Escape' || code === 'Backspace') {\\n      model.pending[inPlay || model.screen === 'Story' ? 'pause' : 'back'] = true;\\n      return;\\n    }\\n    if (inPlay) return;\\n    if (key === 'Enter' || key === ' ' || code === 'Enter' || code === 'Space') model.pending.confirm = true;\\n    else if (key === 'Tab' || code === 'Tab') model.pending.skip = true;\\n    else if (key === 'ArrowUp' || key === 'w' || key === 'W' || code === 'ArrowUp' || code === 'KeyW') model.pending.up = true;\\n    else if (key === 'ArrowDown' || key === 's' || key === 'S' || code === 'ArrowDown' || code === 'KeyS') model.pending.down = true;\\n    else if (key === 'ArrowLeft' || key === 'a' || key === 'A' || code === 'ArrowLeft' || code === 'KeyA') model.pending.left = true;\\n    else if (key === 'ArrowRight' || key === 'd' || key === 'D' || code === 'ArrowRight' || code === 'KeyD') model.pending.right = true;\\n    else if (key === 'q' || key === 'Q' || code === 'KeyQ') model.pending.pageLeft = true;\\n    else if (key === 'e' || key === 'E' || code === 'KeyE') model.pending.pageRight = true;\\n  }\\n\\n  function onHover(id) {\\n    if (model.attract.on) {\\n      model.ignoreUntil = performance.now() + 350;\\n      exitAttract();\\n      return;\\n    }\\n    const items = currentItems();\\n    const i = items.findIndex((it) => it.id === id);\\n    if (i >= 0 && i !== model.focus) {\\n      model.focus = i;\\n      if (model.screen === 'About') model.page = i;\\n      paint(true);\\n    }\\n  }\\n\\n  function onActivate(id) {\\n    model.lastInput = performance.now();\\n    audio.resume();\\n    if (model.attract.on) {\\n      model.ignoreUntil = performance.now() + 350;\\n      exitAttract();\\n      return;\\n    }\\n    if (performance.now() < model.ignoreUntil) {\\n      model.ignoreUntil = 0;\\n      return;\\n    }\\n    if (model.mode === 'session' && (id === 'ready' || id === 'more')) {\\n      AIHub.answer(id === 'more' ? 'more' : 'ready');\\n      return;\\n    }\\n    activate(id);\\n  }\\n\\n  function onTool(tool) {\\n    model.pendingTool = tool;\\n    model.lastInput = performance.now();\\n  }\\n\\n  function onPointer() {\\n    model.lastInput = performance.now();\\n    if (model.attract.on) {\\n      model.ignoreUntil = performance.now() + 350;\\n      exitAttract();\\n    }\\n  }\\n\\n  model.onKey = onKey;\\n  model.onHover = onHover;\\n  model.onActivate = onActivate;\\n  model.onTool = onTool;\\n  model.onPointer = onPointer;\\n  model.persist = persist;\\n  model.reached = model.reached;\\n  model.openScene = openScene;\\n  model.setScreen = (name, overlay = null) => setScreen(name, overlay);\\n\\n  ensureDom();\\n  model.input = createInput(model);\\n  document.documentElement.dataset.promptSet = 'keyboard';\\n  if (model.ui) {\\n    model.ui.addEventListener('input', (e) => {\\n      const id = e.target?.dataset?.slider;\\n      if (!id) return;\\n      writeSetting(id, Number(e.target.value));\\n    });\\n  }\\n  document.addEventListener('visibilitychange', () => {\\n    if (document.hidden && model.mode !== 'session' && !model.attract.on && !model.overlay\\n      && (model.screen === 'Operation' || model.screen === 'Story')) {\\n      setOverlay('pause');\\n    }\\n  });\\n  window.addEventListener('resize', () => model.view?.resize?.());\\n\\n  function ensureDom() {\\n    if (!document.body) return;\\n    if (!document.getElementById('boot')) {\\n      const boot = document.createElement('div');\\n      boot.id = 'boot';\\n      boot.textContent = 'Scrubbing in…';\\n      document.body.prepend(boot);\\n    }\\n    let app = document.getElementById('app');\\n    if (!app) {\\n      app = document.createElement('div');\\n      app.id = 'app';\\n      app.hidden = true;\\n      const canvas = document.createElement('canvas');\\n      canvas.id = 'view';\\n      const ui = document.createElement('div');\\n      ui.id = 'ui';\\n      app.append(canvas, ui);\\n      document.body.append(app);\\n    }\\n    model.canvas = document.getElementById('view');\\n    model.ui = document.getElementById('ui');\\n    document.body.tabIndex = 0;\\n  }\\n\\n  function aboutData() {\\n    if (model.aboutDoc) return model.aboutDoc;\\n    const el = document.getElementById('about-data');\\n    try { model.aboutDoc = JSON.parse(el?.textContent || '{}'); } catch { model.aboutDoc = {}; }\\n    return model.aboutDoc;\\n  }\\n\\n  function currentItems() {\\n    if (model.nogfxNotice) return [{ id: 'nogfx-ok', label: 'Continue' }];\\n    if (model.mode === 'session' && model.sessionPause) return settingsItems();\\n    if (model.overlay === 'chooser') return [{ id: 'continue', label: 'Continue' }, { id: 'new', label: 'New Game' }];\\n    if (model.overlay === 'pause') return pauseItems();\\n    if (model.overlay === 'dev') return devItems();\\n    if (model.screen === 'Title') return [{ id: 'start', label: 'Press any button' }];\\n    if (model.screen === 'Touch notice') return [{ id: 'settings', label: 'Settings' }];\\n    if (model.screen === 'Main Menu') {\\n      const story = (model.save.intro || model.save.storyPos > 0 || model.save.cleared?.length) ? 'Story' : 'Story';\\n      return [\\n        { id: 'story', label: story },\\n        { id: 'free', label: 'Free Play' },\\n        { id: 'rounds', label: 'Grand Rounds' },\\n        { id: 'settings', label: 'Settings' },\\n        { id: 'about', label: 'About & Credits' },\\n      ];\\n    }\\n    if (model.screen === 'Story' && model.storyMode === 'ask') {\\n      return [\\n        { id: 'intern', label: 'Intern' },\\n        { id: 'resident', label: 'Resident' },\\n        { id: 'attending', label: 'Attending' },\\n      ];\\n    }\\n    if (model.screen === 'Story' && model.storyMode === 'lines') return [{ id: 'advance', label: 'Continue' }];\\n    if (model.screen === 'Chart') return chartItems();\\n    if (model.screen === 'Report') return [{ id: 'report-next', label: 'Continue' }];\\n    if (model.screen === 'Fail') return failItems();\\n    if (model.screen === 'Free Play') return freeItems();\\n    if (model.screen === 'Lobby') return lobbyItems();\\n    if (model.screen === 'Settings') return settingsItems();\\n    if (model.screen === 'About') return aboutItems();\\n    if (model.screen === 'Credits roll') return [{ id: 'credits-skip', label: 'Skip' }];\\n    if (model.mode === 'session' && model.screen === 'Card') return [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More Time' }];\\n    return [];\\n  }\\n\\n  function chartItems() {\\n    const op = safeOp(model.opId);\\n    if (op?.consult) {\\n      return [\\n        { id: 'careful', label: 'Careful' },\\n        { id: 'aggressive', label: 'Aggressive' },\\n        { id: 'begin', label: 'Begin' },\\n      ];\\n    }\\n    return [{ id: 'begin', label: 'Begin' }];\\n  }\\n\\n  function pauseItems() {\\n    if (model.screen === 'Story') {\\n      return [\\n        { id: 'resume', label: 'Resume' },\\n        { id: 'skip-scene', label: 'Skip Scene' },\\n        { id: 'settings', label: 'Settings' },\\n        { id: 'dev', label: 'Dev Mode' },\\n        { id: 'quit', label: 'Quit to Menu' },\\n      ];\\n    }\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'retry', label: 'Retry Phase' },\\n      { id: 'restart', label: 'Restart Operation' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'quit', label: 'Quit to Menu' },\\n    ];\\n  }\\n\\n  function failItems() {\\n    const items = [\\n      { id: 'retry', label: 'Retry Phase' },\\n      { id: 'restart', label: 'Restart Operation' },\\n      { id: 'quit', label: 'Quit to Menu' },\\n    ];\\n    if (model.sim?.notesOffer) items.push({ id: 'notes', label: \\\"Bea's Notes\\\" });\\n    return items;\\n  }\\n\\n  function freeItems() {\\n    const ids = storyOrder().filter(unlocked);\\n    const slice = ids.slice(model.page * 4, model.page * 4 + 4);\\n    const items = slice.map((id) => {\\n      const rank = model.save.ranks?.[id];\\n      return { id: `play:${id}`, label: `${getOp(id).title}${rank ? ` ${rank}` : ''}` };\\n    });\\n    items.push({ id: 'doctor', label: `Doctor: ${model.doctor === 'ines' ? 'Ines' : 'Ren'}` });\\n    return items;\\n  }\\n\\n  function lobbyItems() {\\n    return [0, 1, 2, 3].map((i) => ({\\n      id: `seat:${i}`,\\n      label: model.joined.has(i) ? `Seat ${i + 1} in` : `Seat ${i + 1}`,\\n    })).concat([{ id: 'begin', label: 'Begin' }]);\\n  }\\n\\n  function settingsItems() {\\n    const page = SETTINGS_PAGES[model.page] || SETTINGS_PAGES[0];\\n    return page.map((item) => ({ ...item, label: `${item.label}: ${readout(item.id)}` }));\\n  }\\n\\n  function aboutItems() {\\n    return ABOUT_HEADS.map(([, label], i) => ({ id: `about:${i}`, label }));\\n  }\\n\\n  function devItems() {\\n    const pages = devPages();\\n    const page = pages[Math.min(model.page, pages.length - 1)] || [];\\n    return page;\\n  }\\n\\n  function devPages() {\\n    const buttons = DEV_IDS.map((id) => ({\\n      id,\\n      kind: 'dev',\\n      label: id.startsWith('op:') ? safeOp(id.slice(3))?.title || id : id,\\n    }));\\n    const pages = [];\\n    for (let i = 0; i < buttons.length; i += 6) pages.push(buttons.slice(i, i + 6));\\n    for (const page of TUNING_PAGES) {\\n      pages.push(page.keys.map((key) => ({\\n        id: key,\\n        kind: 'slider',\\n        label: key,\\n        min: TUNING_RANGES[key][0],\\n        max: TUNING_RANGES[key][1],\\n        step: stepOf(TUNING_RANGES[key]),\\n      })).concat([{ id: 'reset-page', kind: 'dev', label: 'Reset page', keys: page.keys }]));\\n    }\\n    pages.push([{ id: 'reset-all', kind: 'dev', label: 'Reset all' }]);\\n    return pages;\\n  }\\n\\n  function stepOf(range) {\\n    const span = range[1] - range[0];\\n    if (span <= 20 && Number.isInteger(range[0]) && Number.isInteger(range[1])) return 1;\\n    return Math.round((span / 20) * 1000) / 1000;\\n  }\\n\\n  function pageCount() {\\n    if (model.overlay === 'dev') return devPages().length;\\n    if (model.screen === 'Settings' || model.sessionPause) return SETTINGS_PAGES.length;\\n    if (model.screen === 'About') return ABOUT_HEADS.length;\\n    if (model.screen === 'Free Play') return Math.max(1, Math.ceil(storyOrder().filter(unlocked).length / 4));\\n    return 1;\\n  }\\n\\n  function unlocked(id) {\\n    if (model.save.unlocked) return true;\\n    if (model.save.cleared?.includes(id)) return true;\\n    const i = storyOrder().indexOf(id);\\n    return i >= 0 && i <= (model.save.storyPos || 0);\\n  }\\n\\n  function safeOp(id) {\\n    try { return getOp(id); } catch { return null; }\\n  }\\n\\n  function defaultFocus() {\\n    if (model.screen === 'Story' && model.storyMode === 'ask') return 1;\\n    if (model.screen === 'Chart') return Math.max(0, chartItems().length - 1);\\n    if (model.screen === 'Lobby') return 4;\\n    if (model.screen === 'About') return model.page || 0;\\n    return 0;\\n  }\\n\\n  function setScreen(name, overlay = null) {\\n    model.screen = name;\\n    model.overlay = overlay;\\n    model.page = name === 'About' ? model.page : 0;\\n    if (name !== 'About') model.page = 0;\\n    model.reached.add(name);\\n    if (name === 'Credits roll') model.reached.add('Credits');\\n    model.focus = defaultFocus();\\n    document.body.dataset.screen = name;\\n    syncMusic();\\n    present();\\n    paint(true);\\n  }\\n\\n  function setOverlay(name) {\\n    model.overlay = name;\\n    model.focus = 0;\\n    model.page = 0;\\n    paint(true);\\n  }\\n\\n  function readout(id) {\\n    if (id === 'glyphs') return model.settings.glyphs === 'xbox' ? 'Xbox' : 'PlayStation';\\n    if (id === 'rumble' || id === 'swapSticks' || id === 'fullscreen' || id === 'shake' || id === 'boil') {\\n      return model.settings[id] ? 'On' : 'Off';\\n    }\\n    if (id === 'textSpeed') return `${model.settings.textSpeed}x`;\\n    if (id === 'music' || id === 'effects' || id === 'voices') return `${Math.round((model.settings[id] ?? 0) * 100)}%`;\\n    const n = id in TUNING_DEFAULTS ? model.tuning[id] : model.settings[id];\\n    return `${Number(n).toFixed(2)} (default ${Number(TUNING_DEFAULTS[id] ?? n).toFixed(2)})`;\\n  }\\n\\n  function writeSetting(id, value) {\\n    if (id === 'music' || id === 'effects' || id === 'voices' || id === 'aimAssist' || id === 'tipSpeed') {\\n      model.settings[id] = value;\\n      if (id === 'music') audio.setMusicGain(value);\\n      if (id === 'effects') audio.sfx.gain.value = value;\\n      if (id === 'voices') audio.voice.gain.value = value;\\n      if (id === 'aimAssist' || id === 'tipSpeed') model.tuning[id] = value;\\n    } else if (id in TUNING_DEFAULTS) {\\n      model.tuning[id] = value;\\n    } else {\\n      model.settings[id] = value;\\n    }\\n    const node = model.ui?.querySelector(`[data-readout=\\\"${id}\\\"]`);\\n    if (node) node.textContent = readout(id);\\n    persist();\\n  }\\n\\n  function syncMusic() {\\n    if (!audioOk()) return;\\n    let id = 'title';\\n    let bpm = 80;\\n    if (model.mode === 'session') {\\n      id = (model.screen === 'Card' || model.screen === 'Countdown') ? 'title' : 'rounds';\\n    } else if (model.attract.on && model.sim) {\\n      id = model.sim.op.music || 'rounds';\\n      bpm = model.sim.op.bpm || 80;\\n    } else if (model.screen === 'Story' && model.scene?.music) {\\n      id = model.scene.music;\\n    } else if ((model.screen === 'Operation' || model.screen === 'Chart' || model.screen === 'Report' || model.screen === 'Fail') && model.opId) {\\n      const op = safeOp(model.opId);\\n      id = model.screen === 'Operation' ? (op?.music || 'or-calm') : 'or-tense';\\n      bpm = op?.bpm || 80;\\n    } else if (model.screen === 'Credits roll') id = 'credits';\\n    else if (model.screen === 'Lobby') id = 'rounds';\\n    if (id !== model.track) {\\n      model.track = id;\\n      audio.playTrack(id, bpm);\\n    }\\n    audio.setHush(!!(model.sim && model.sim.hushPhase));\\n  }\\n\\n  function present() {\\n    const view = model.view;\\n    if (!view) return;\\n    if (model.screen === 'Story' && model.scene) {\\n      const line = model.scene.lines[model.line];\\n      view.showStory?.(model.scene.set, line?.who);\\n      view.setSpeaker?.(line?.who, { mouth: 'open' });\\n      view.shout?.(!!line?.shout);\\n    } else if (model.screen === 'Operation' || model.attract.on || model.screen === 'Chart') {\\n      view.showOr?.();\\n      view.shout?.(false);\\n    }\\n  }\\n\\n  function decorateState(st) {\\n    if (!st) return st;\\n    if (!st.organ) {\\n      const op = safeOp(st.op);\\n      const site = op?.sites?.find((s) => s.id === st.site) || op?.sites?.[0];\\n      st.organ = site?.organ || 'forearm';\\n    }\\n    return st;\\n  }\\n  model.decorateState = decorateState;\\n\\n  function playEvent(ev) {\\n    if (!ev || !audioOk()) return;\\n    if (ev.type === 'say' && ev.text) {\\n      audio.say(ev.who || 'bea', ev.text);\\n      model.bark = { who: ev.who || 'bea', text: ev.text };\\n    } else if (ev.type === 'bark') {\\n      const text = barkText(ev.key, ev.arg, ev.n || 0);\\n      audio.say(ev.who || 'bea', text);\\n      model.bark = { who: ev.who || 'bea', text };\\n    } else if (FX[ev.type]) audio.effect(FX[ev.type]);\\n    if (ev.type === 'hush' || ev.type === 'success' || ev.type === 'fail') syncMusic();\\n  }\\n  model.playEvent = playEvent;\\n\\n  function tickAudio() {\\n    if (!audioOk()) return;\\n    audio.scheduleAhead();\\n    if (model.remoteEvents?.length) {\\n      for (const ev of model.remoteEvents) playEvent(ev);\\n      model.remoteEvents = [];\\n    }\\n  }\\n  model.tickAudio = tickAudio;\\n\\n  function syncFromSim() {\\n    if (!model.view || !model.sim || model.norender) return;\\n    model.painting = true;\\n    try {\\n      model.view.showOr?.();\\n      model.view.sync(decorateState(model.sim.state), 1 / 60);\\n    } catch { /* the next pump draws */ }\\n    const drawn = model.view.render?.();\\n    if (drawn?.then) drawn.then(() => { model.painting = false; }, () => { model.painting = false; });\\n    else model.painting = false;\\n  }\\n  model.syncFromSim = syncFromSim;\\n\\n  function askBea() {\\n    const text = barkText('idle', null, (model.sim?.tick || 0) % 3);\\n    audio.say('bea', text);\\n    model.bark = { who: 'bea', text };\\n    paint(true);\\n  }\\n\\n  function openScene(id, onDone) {\\n    const scene = SCENES.find((s) => s.id === id);\\n    if (!scene) {\\n      onDone?.();\\n      return;\\n    }\\n    model.scene = scene;\\n    model.sceneId = id;\\n    model.line = 0;\\n    model.storyMode = 'lines';\\n    model.sceneDone = onDone || null;\\n    setScreen('Story');\\n    const line = scene.lines[0];\\n    if (line && audioOk()) audio.say(line.who, line.text);\\n  }\\n\\n  function advanceLine() {\\n    const lines = model.scene?.lines || [];\\n    if (model.line >= lines.length - 1) {\\n      finishScene();\\n      return;\\n    }\\n    model.line += 1;\\n    const line = lines[model.line];\\n    model.view?.setSpeaker?.(line.who, { mouth: 'open' });\\n    model.view?.shout?.(!!line.shout);\\n    if (audioOk()) audio.say(line.who, line.text);\\n    paint(true);\\n  }\\n\\n  function finishScene() {\\n    const done = model.sceneDone;\\n    model.sceneDone = null;\\n    model.view?.shout?.(false);\\n    if (done) done();\\n    else setScreen('Main Menu');\\n  }\\n\\n  function openAsk() {\\n    model.storyMode = 'ask';\\n    model.flow = 'story';\\n    setScreen('Story');\\n  }\\n\\n  function beginNew() {\\n    model.save.storyPos = 0;\\n    model.save.intro = false;\\n    model.save.cleared = [];\\n    model.flow = 'story';\\n    model.overlay = null;\\n    persist();\\n    openAsk();\\n  }\\n\\n  function confirmDifficulty(id) {\\n    model.settings.difficulty = id;\\n    model.save.difficulty = id;\\n    persist();\\n    if (!model.save.intro) openScene('S0', afterIntro);\\n    else openOpStory(model.save.storyPos || 0);\\n  }\\n\\n  function afterIntro() {\\n    model.save.intro = true;\\n    persist();\\n    openOpStory(0);\\n  }\\n\\n  function openOpStory(index) {\\n    const order = storyOrder();\\n    if (index >= order.length) {\\n      openCredits();\\n      return;\\n    }\\n    model.storyIndex = index;\\n    model.flow = 'story';\\n    model.save.storyPos = index;\\n    model.save.intro = true;\\n    persist();\\n    const op = getOp(order[index]);\\n    model.opId = op.id;\\n    if (op.scene?.before) openScene(op.scene.before, () => openChart(op.id));\\n    else openChart(op.id);\\n  }\\n\\n  function openChart(opId) {\\n    model.opId = opId;\\n    model.consultChoice = 'careful';\\n    model.flow = model.flow || 'story';\\n    setScreen('Chart');\\n  }\\n\\n  function openCredits() {\\n    setScreen('Credits roll');\\n  }\\n\\n  function continueReport() {\\n    recordResult();\\n    if (model.flow === 'couch') {\\n      setScreen('Lobby');\\n      return;\\n    }\\n    if (model.flow === 'free') {\\n      setScreen('Free Play');\\n      return;\\n    }\\n    const op = safeOp(model.opId);\\n    if (op?.scene?.after) openScene(op.scene.after, afterScene);\\n    else afterScene();\\n  }\\n\\n  function afterScene() {\\n    const order = storyOrder();\\n    const i = order.indexOf(model.opId);\\n    if (model.flow === 'story' && i >= 0 && i < order.length - 1) openOpStory(i + 1);\\n    else if (model.flow === 'story') openCredits();\\n    else setScreen('Main Menu');\\n  }\\n\\n  function recordResult() {\\n    if (model.attract.on || model.mode === 'session' || !model.sim || !model.opId) return;\\n    if (model.sim.rank?.id) model.save.ranks[model.opId] = model.sim.rank.id;\\n    if (model.flow === 'story' && model.sim.complete) {\\n      if (!model.save.cleared.includes(model.opId)) model.save.cleared.push(model.opId);\\n      const i = storyOrder().indexOf(model.opId);\\n      if (i >= 0) model.save.storyPos = Math.max(model.save.storyPos || 0, i + 1);\\n    }\\n    persist();\\n  }\\n\\n  function freeSim() {\\n    try { model.sim?.physics?.free?.(); } catch { /* world already freed */ }\\n    model.sim = null;\\n  }\\n\\n  function startOperation(opId, extra = {}) {\\n    model.opId = opId;\\n    model.resultShown = false;\\n    const op = getOp(opId);\\n    const players = extra.players || 1;\\n    const build = (physics) => {\\n      freeSim();\\n      model.sim = new Sim({\\n        op: opId,\\n        seed: extra.seed ?? 1,\\n        physics,\\n        tuning: model.tuning,\\n        difficulty: model.settings.difficulty || 'resident',\\n        consult: op.consult ? (model.consultChoice || 'careful') : null,\\n        players,\\n        couch: !!extra.couch,\\n        notes: !!extra.notes,\\n      });\\n      if (extra.couch) {\\n        for (let i = 0; i < model.sim.seats.length; i++) {\\n          if (!model.joined.has(model.sim.seats[i].id)) model.sim.leave(model.sim.seats[i].id);\\n        }\\n      }\\n      model.overlay = null;\\n      setScreen('Operation');\\n    };\\n    if (model.test || extra.physics === false) {\\n      build(false);\\n      return;\\n    }\\n    void (async () => {\\n      let physics = false;\\n      try { await physicsReady(); physics = true; } catch { physics = false; }\\n      if (model.mode === 'session') return;\\n      build(physics);\\n    })();\\n  }\\n\\n  function mountAttract(opId) {\\n    freeSim();\\n    model.sim = new Sim({\\n      op: opId,\\n      seed: 1,\\n      physics: false,\\n      tuning: model.tuning,\\n      difficulty: 'resident',\\n      players: 1,\\n      cheats: { lockVitals: true, freezeTimer: true, infiniteComposure: true, infiniteClamps: true },\\n    });\\n    model.opId = opId;\\n    model.botOn = true;\\n    model.botOpts = {};\\n    model.view?.showOr?.();\\n    syncMusic();\\n  }\\n\\n  function startAttract() {\\n    const order = storyOrder();\\n    model.attract = { on: true, from: model.screen, opIndex: 0, opT: performance.now() };\\n    mountAttract(order[0]);\\n    paint(true);\\n  }\\n\\n  function exitAttract() {\\n    if (!model.attract.on) return;\\n    model.attract.on = false;\\n    model.botOn = false;\\n    model.botOpts = {};\\n    freeSim();\\n    model.opId = null;\\n    model.pending = {};\\n    model.lastInput = performance.now();\\n    syncMusic();\\n    paint(true);\\n  }\\n\\n  function nextAttractOp() {\\n    const order = storyOrder();\\n    model.attract.opIndex = (model.attract.opIndex + 1) % order.length;\\n    model.attract.opT = performance.now();\\n    mountAttract(order[model.attract.opIndex]);\\n    paint(true);\\n  }\\n\\n  function checkAttract() {\\n    if (model.mode === 'session') return;\\n    const idle = model.screen === 'Title' || model.screen === 'Main Menu' || model.screen === 'Free Play' || model.screen === 'Touch notice';\\n    if (!model.attract.on) {\\n      if (model.overlay || !idle) return;\\n      if (performance.now() - model.lastInput >= 10000) startAttract();\\n      return;\\n    }\\n    if (performance.now() - model.attract.opT >= 2000) nextAttractOp();\\n  }\\n\\n  function joinSeat(index) {\\n    model.joined.add(index);\\n    paint(true);\\n  }\\n\\n  function startCouch() {\\n    if (model.joined.size === 0) {\\n      joinSeat(0);\\n      return;\\n    }\\n    model.flow = 'couch';\\n    const players = [0, 1, 2, 3].map((i) => ({ id: i, name: `Seat ${i + 1}`, color: COLORS[i] }));\\n    startOperation('grand-rounds', { couch: true, players });\\n  }\\n\\n  function activate(id) {\\n    if (!id) return;\\n    if (id === 'nogfx-ok') {\\n      model.nogfxNotice = false;\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'start') {\\n      setScreen('Main Menu');\\n      return;\\n    }\\n    if (id === 'story') {\\n      if (model.save.intro || (model.save.storyPos || 0) > 0 || model.save.cleared?.length) {\\n        model.overlay = 'chooser';\\n        model.focus = 0;\\n        paint(true);\\n      } else openAsk();\\n      return;\\n    }\\n    if (id === 'continue') {\\n      model.overlay = null;\\n      model.flow = 'story';\\n      if (!model.save.intro) openScene('S0', afterIntro);\\n      else openOpStory(model.save.storyPos || 0);\\n      return;\\n    }\\n    if (id === 'new') {\\n      beginNew();\\n      return;\\n    }\\n    if (id === 'free') {\\n      model.flow = 'free';\\n      setScreen('Free Play');\\n      return;\\n    }\\n    if (id === 'rounds') {\\n      model.joined = new Set();\\n      setScreen('Lobby');\\n      return;\\n    }\\n    if (id === 'settings') {\\n      openSettings();\\n      return;\\n    }\\n    if (id === 'about') {\\n      model.page = 0;\\n      setScreen('About');\\n      return;\\n    }\\n    if (id === 'intern' || id === 'resident' || id === 'attending') {\\n      confirmDifficulty(id);\\n      return;\\n    }\\n    if (id === 'advance') {\\n      advanceLine();\\n      return;\\n    }\\n    if (id === 'careful' || id === 'aggressive') {\\n      model.consultChoice = id;\\n      model.focus = chartItems().length - 1;\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'begin' && model.screen === 'Chart') {\\n      model.flow = model.flow === 'free' ? 'free' : 'story';\\n      startOperation(model.opId);\\n      return;\\n    }\\n    if (id === 'begin' && model.screen === 'Lobby') {\\n      startCouch();\\n      return;\\n    }\\n    if (id.startsWith('seat:')) {\\n      joinSeat(Number(id.slice(5)));\\n      return;\\n    }\\n    if (id.startsWith('play:')) {\\n      model.flow = 'free';\\n      openChart(id.slice(5));\\n      return;\\n    }\\n    if (id === 'doctor') {\\n      model.doctor = model.doctor === 'ines' ? 'ren' : 'ines';\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'report-next') {\\n      continueReport();\\n      return;\\n    }\\n    if (id === 'credits-skip' || id === 'skip-scene') {\\n      if (model.screen === 'Credits roll' || id === 'credits-skip') setScreen('Main Menu');\\n      else finishScene();\\n      return;\\n    }\\n    if (id === 'resume') {\\n      model.overlay = null;\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'retry') {\\n      if (model.sim && !model.sim.over) model.sim.retryPhase();\\n      else model.sim?.retryPhase?.();\\n      model.resultShown = false;\\n      model.overlay = null;\\n      setScreen('Operation');\\n      return;\\n    }\\n    if (id === 'restart') {\\n      const flow = model.flow;\\n      startOperation(model.opId, { couch: flow === 'couch', players: flow === 'couch' ? [0, 1, 2, 3].map((i) => ({ id: i, name: `Seat ${i + 1}`, color: COLORS[i] })) : 1 });\\n      return;\\n    }\\n    if (id === 'notes') {\\n      try { model.sim?.acceptNotes?.(); } catch { /* notes stay offered */ }\\n      model.resultShown = false;\\n      model.overlay = null;\\n      setScreen('Operation');\\n      return;\\n    }\\n    if (id === 'quit') {\\n      model.overlay = null;\\n      freeSim();\\n      setScreen('Main Menu');\\n      return;\\n    }\\n    if (id === 'dev') {\\n      if (model.mode === 'session') return;\\n      setOverlay('dev');\\n      return;\\n    }\\n    if (id === 'back-settings' || id === 'back') {\\n      closeSettings();\\n      return;\\n    }\\n    if (id.startsWith('about:')) {\\n      model.page = Number(id.slice(6)) || 0;\\n      model.focus = model.page;\\n      paint(true);\\n      return;\\n    }\\n    if (id.startsWith('site:')) {\\n      const sim = model.sim;\\n      if (!sim) return;\\n      const idx = sim.op.sites.findIndex((s) => s.id === id.slice(5));\\n      if (idx >= 0) sim.setSite(sim.seats[0], idx);\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'glyphs') {\\n      model.settings.glyphs = model.settings.glyphs === 'xbox' ? 'playstation' : 'xbox';\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'rumble' || id === 'swapSticks' || id === 'shake' || id === 'boil') {\\n      model.settings[id] = !model.settings[id];\\n      if (id === 'boil') model.view?.setBoil?.(!!model.settings.boil);\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'fullscreen') {\\n      model.settings.fullscreen = !model.settings.fullscreen;\\n      const node = document.documentElement;\\n      if (model.settings.fullscreen) node.requestFullscreen?.().catch(() => {});\\n      else document.exitFullscreen?.().catch(() => {});\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'textSpeed') {\\n      model.settings.textSpeed = model.settings.textSpeed >= 4 ? 1 : model.settings.textSpeed * 2;\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (DEV_IDS.includes(id) || id === 'reset-page' || id === 'reset-all' || id === 'jump') {\\n      const page = devPages()[model.page] || [];\\n      const found = page.find((item) => item.id === id);\\n      runDev(model, id, found?.keys);\\n      return;\\n    }\\n  }\\n\\n  function openSettings() {\\n    if (model.mode === 'session') {\\n      model.sessionPause = true;\\n      paint(true);\\n      return;\\n    }\\n    model.returnTo = { screen: model.screen, overlay: model.overlay };\\n    model.page = 0;\\n    setScreen('Settings');\\n  }\\n\\n  function closeSettings() {\\n    if (model.mode === 'session') {\\n      model.sessionPause = false;\\n      paint(true);\\n      return;\\n    }\\n    const ret = model.returnTo;\\n    model.returnTo = null;\\n    if (!ret) {\\n      setScreen('Main Menu');\\n      return;\\n    }\\n    setScreen(ret.screen);\\n    if (ret.overlay) setOverlay(ret.overlay);\\n  }\\n  model.applySettings = (sample) => {\\n    const menu = sample?.menu || {};\\n    if (menu.pageLeft) turnPage(-1);\\n    else if (menu.pageRight) turnPage(1);\\n    else if (menu.up) moveFocus(-1);\\n    else if (menu.down) moveFocus(1);\\n    else if (menu.left) nudge(-1);\\n    else if (menu.right) nudge(1);\\n    else if (menu.confirm) {\\n      const item = currentItems()[model.focus];\\n      if (item) activate(item.id);\\n    }\\n  };\\n\\n  function moveFocus(dir) {\\n    const items = currentItems();\\n    if (!items.length) return;\\n    model.focus = (model.focus + dir + items.length) % items.length;\\n    if (model.screen === 'About' && !model.overlay) model.page = model.focus;\\n    paint(true);\\n  }\\n\\n  function turnPage(dir) {\\n    const n = pageCount();\\n    if (n <= 1) return false;\\n    model.page = (model.page + dir + n) % n;\\n    model.focus = model.screen === 'About' ? model.page : 0;\\n    paint(true);\\n    return true;\\n  }\\n\\n  function nudge(dir) {\\n    if (model.screen === 'Chart' && !model.overlay) {\\n      const order = ['intern', 'resident', 'attending'];\\n      const i = Math.max(0, order.indexOf(model.settings.difficulty || 'resident'));\\n      model.settings.difficulty = order[(i + (dir < 0 ? 2 : 1)) % 3];\\n      model.save.difficulty = model.settings.difficulty;\\n      persist();\\n      paint(true);\\n      return true;\\n    }\\n    const item = currentItems()[model.focus];\\n    if (!item) return false;\\n    if (item.kind === 'slider') {\\n      const cur = item.id in TUNING_DEFAULTS ? model.tuning[item.id] : (model.settings[item.id] ?? item.min);\\n      const step = item.step || 0.05;\\n      const v = Math.max(item.min, Math.min(item.max, Math.round((cur + dir * step) * 1000) / 1000));\\n      writeSetting(item.id, v);\\n      paint(true);\\n      return true;\\n    }\\n    if (item.kind === 'toggle' || item.kind === 'cycle' || item.id === 'glyphs' || item.id === 'textSpeed') {\\n      activate(item.id);\\n      return true;\\n    }\\n    return false;\\n  }\\n\\n  function prepFrame(id, frame) {\\n    const next = { ...(frame || {}) };\\n    if (model.pendingTool && (id === 0 || id === model.sim?.seats?.[0]?.id)) {\\n      next.tool = model.pendingTool;\\n      model.pendingTool = null;\\n    }\\n    const prev = model.siteHold.get(id) || 0;\\n    if (next.siteDelta && next.siteDelta === prev) next.siteDelta = 0;\\n    model.siteHold.set(id, frame?.siteDelta || 0);\\n    return next;\\n  }\\n\\n  function feedSim(sample) {\\n    const sim = model.sim;\\n    if (!sim || sim.over) return;\\n    const playing = model.attract.on || (model.screen === 'Operation' && !model.overlay && !model.sessionPause);\\n    if (!playing) return;\\n    if (model.botOn) {\\n      for (const seat of sim.seats) {\\n        if (seat.out) continue;\\n        sim.input(seat.id, prepFrame(seat.id, botInput(sim, seat, model.botOpts || {})));\\n      }\\n    } else if (model.flow === 'couch') {\\n      for (const s of sample.seats) {\\n        if (!model.joined.has(s.index)) continue;\\n        const seat = sim.seats.find((x) => x.id === s.index);\\n        if (seat && !seat.out) sim.input(seat.id, prepFrame(seat.id, s.frame));\\n      }\\n    } else {\\n      const s0 = sample.seats.find((s) => s.index === 0);\\n      const seat = sim.seats[0];\\n      if (s0 && seat) sim.input(seat.id, prepFrame(seat.id, s0.frame));\\n    }\\n    if (model.override && sim.seats[0]) {\\n      sim.input(sim.seats[0].id, prepFrame(sim.seats[0].id, model.override));\\n    }\\n    sim.step();\\n    for (const ev of sim.events || []) playEvent(ev);\\n    if (model.attract.on && sim.over) nextAttractOp();\\n    else if (!model.attract.on && sim.over && !model.resultShown) {\\n      model.resultShown = true;\\n      if (sim.complete) setScreen('Report');\\n      else setScreen('Fail');\\n    }\\n  }\\n\\n  function realInput(sample, menu, pend) {\\n    if (Object.values(menu).some(Boolean) || Object.values(pend).some(Boolean)) return true;\\n    return sample.seats.some((s) => {\\n      if (s.edges && Object.values(s.edges).some(Boolean)) return true;\\n      const f = s.frame;\\n      return f && (Math.hypot(f.x || 0, f.y || 0) > 0.2 || (f.use || 0) > 0.2);\\n    });\\n  }\\n\\n  let busy = false;\\n  function stepOnce() {\\n    if (busy || model.mode === 'session') return;\\n    busy = true;\\n    try {\\n      const sample = model.input.poll();\\n      const pend = model.pending;\\n      model.pending = {};\\n      const menu = { ...sample.menu };\\n      for (const k of Object.keys(pend)) if (pend[k]) menu[k] = true;\\n      model.input.takeClick();\\n      if (realInput(sample, menu, pend)) model.lastInput = performance.now();\\n      if (model.attract.on && (realInput(sample, menu, pend) || sample.hover)) {\\n        model.ignoreUntil = performance.now() + 350;\\n        exitAttract();\\n        return;\\n      }\\n      if (performance.now() < model.ignoreUntil && (menu.confirm || menu.back || pend.confirm)) return;\\n      if (model.screen === 'Touch notice' && (pend.leaveTouch || sample.seenPad || model.input.seenPad)) {\\n        if (pend.leaveTouch || sample.seats.some((s) => s.edges && Object.values(s.edges).some(Boolean))) {\\n          setScreen('Title');\\n          return;\\n        }\\n      }\\n      const padPause = sample.seats.some((s) => s.edges?.pause);\\n      const inPlay = model.screen === 'Operation' && !model.overlay;\\n      if ((pend.pause || padPause || (menu.back && model.screen === 'Story' && !model.overlay)) && model.mode !== 'session') {\\n        if (inPlay || model.screen === 'Story' || pend.pause || padPause) {\\n          setOverlay('pause');\\n          return;\\n        }\\n      }\\n      if (menu.back && model.overlay) {\\n        if (model.overlay === 'dev') setOverlay('pause');\\n        else if (model.screen === 'Settings') closeSettings();\\n        else {\\n          model.overlay = null;\\n          paint(true);\\n        }\\n        return;\\n      }\\n      feedSim(sample);\\n      if (model.screen === 'Lobby' && !model.overlay) {\\n        let joinedNow = false;\\n        for (const s of sample.seats) {\\n          if (s.edges?.confirm) {\\n            joinSeat(s.index);\\n            joinedNow = true;\\n          }\\n        }\\n        if (joinedNow && !menu.confirm && !pend.confirm) return;\\n      }\\n      if (model.screen === 'Story' && model.storyMode === 'lines' && !model.overlay) {\\n        if (menu.skip || pend.skip) {\\n          finishScene();\\n          return;\\n        }\\n        if (menu.confirm || pend.confirm) {\\n          model.hold = 0;\\n          advanceLine();\\n          return;\\n        }\\n        const speed = model.settings.textSpeed || 1;\\n        if (sample.held?.confirm) {\\n          model.hold += speed;\\n          if (model.hold >= 3) {\\n            model.hold = 0;\\n            advanceLine();\\n          }\\n        }\\n        return;\\n      }\\n      if (menu.pageLeft || pend.pageLeft) {\\n        if (turnPage(-1)) return;\\n      }\\n      if (menu.pageRight || pend.pageRight) {\\n        if (turnPage(1)) return;\\n      }\\n      if ((menu.left || pend.left) && nudge(-1)) return;\\n      if ((menu.right || pend.right) && nudge(1)) return;\\n      const padUp = sample.seats.some((s) => s.edges?.up);\\n      const padDown = sample.seats.some((s) => s.edges?.down);\\n      if (menu.up || pend.up || (padUp && !inPlay)) moveFocus(-1);\\n      else if (menu.down || pend.down || (padDown && !inPlay)) moveFocus(1);\\n      else if (inPlay && padDown) askBea();\\n      const padConfirm = sample.seats.some((s) => s.edges?.confirm);\\n      const confirm = menu.confirm || pend.confirm || (padConfirm && model.screen !== 'Operation');\\n      if (confirm && model.screen !== 'Operation') {\\n        const item = currentItems()[model.focus];\\n        if (item) activate(item.id);\\n      } else if ((menu.back || pend.back) && !inPlay) {\\n        if (model.screen === 'Settings') closeSettings();\\n        else if (model.screen !== 'Title' && model.screen !== 'Main Menu' && model.screen !== 'Touch notice') {\\n          const prev = model.stack.pop();\\n          setScreen(prev || 'Main Menu');\\n        }\\n      }\\n      tickAudio();\\n    } finally {\\n      busy = false;\\n    }\\n  }\\n\\n  function btn(item, index) {\\n    const on = index === model.focus ? ' on' : '';\\n    const pick = item.id === model.consultChoice ? ' pick' : '';\\n    const slider = item.kind === 'slider'\\n      ? `<input type=\\\"range\\\" data-slider=\\\"${esc(item.id)}\\\" min=\\\"${item.min}\\\" max=\\\"${item.max}\\\" step=\\\"${item.step || 0.01}\\\" value=\\\"${item.id in TUNING_DEFAULTS ? model.tuning[item.id] : (model.settings[item.id] ?? item.min)}\\\">`\\n      : '';\\n    return `<button class=\\\"item${on}${pick}\\\" data-item=\\\"${esc(item.id)}\\\" type=\\\"button\\\"><span data-readout=\\\"${esc(item.id)}\\\">${esc(item.label)}</span>${slider}</button>`;\\n  }\\n\\n  function menuBlock(title, items, extra = '') {\\n    model.focus = Math.max(0, Math.min(model.focus, Math.max(0, items.length - 1)));\\n    return `<section class=\\\"screen\\\"><h1 class=\\\"logo\\\">${esc(title)}</h1>${extra}<div class=\\\"menu\\\">${items.map(btn).join('')}</div></section>`;\\n  }\\n\\n  function paint(force) {\\n    const ui = model.ui;\\n    if (!ui) return;\\n    const sig = [\\n      model.screen, model.overlay, model.storyMode, model.line, model.focus, model.page,\\n      model.attract.on ? model.attract.opIndex : '', model.sessionPause, model.countN,\\n      model.card ? `${model.card.left}:${(model.card.ready || []).join(',')}` : '',\\n      model.opId, model.sceneId, model.nogfxNotice, model.consultChoice, model.settings.difficulty,\\n      model.settings.glyphs, [...model.joined].join(','), model.sim?.phase?.id || '', model.sim?.over || '',\\n      model.bark?.text || '', model.flow, model.doctor || '',\\n    ].join('|');\\n    document.body.dataset.screen = model.attract.on ? (model.attract.from || model.screen) : model.screen;\\n    if (!force && sig === model.paintSig) {\\n      patchLive();\\n      return;\\n    }\\n    model.paintSig = sig;\\n    const boot = document.getElementById('boot');\\n    const app = document.getElementById('app');\\n    if (boot) boot.hidden = model.screen !== 'Boot';\\n    if (app) app.hidden = model.screen === 'Boot';\\n    if (model.nogfxNotice) {\\n      ui.innerHTML = `<section class=\\\"screen nogfx\\\"><p>This room cannot draw. A browser with graphics can open the chart. Your progress is still here.</p>${btn({ id: 'nogfx-ok', label: 'Continue' }, 0)}</section>`;\\n      return;\\n    }\\n    if (model.mode === 'session' && model.screen === 'Card') {\\n      paintCard(ui);\\n      return;\\n    }\\n    if (model.mode === 'session' && model.screen === 'Countdown') {\\n      ui.innerHTML = `<section class=\\\"screen\\\"><p class=\\\"big\\\">${esc(model.countN || '')}</p></section>`;\\n      return;\\n    }\\n    if (model.screen === 'Round over') {\\n      ui.innerHTML = '<section class=\\\"screen\\\"><h1 class=\\\"big\\\">Round over</h1><p class=\\\"note\\\">The table is clear.</p></section>';\\n      return;\\n    }\\n    if (model.attract.on) {\\n      ui.innerHTML = `${hudHtml()}<p class=\\\"demo\\\">DEMO</p><p class=\\\"press\\\">Press any button</p>${model.attract.from === 'Touch notice' ? touchHtml() : ''}`;\\n      return;\\n    }\\n    if (model.sessionPause) {\\n      ui.innerHTML = `${hudHtml()}<div class=\\\"overlay\\\">${menuBlock('Settings', settingsItems(), pageDots())}</div>`;\\n      return;\\n    }\\n    if (model.overlay === 'pause') {\\n      ui.innerHTML = `<div class=\\\"overlay\\\">${menuBlock('Paused', pauseItems())}</div>`;\\n      return;\\n    }\\n    if (model.overlay === 'dev') {\\n      ui.innerHTML = `<div class=\\\"overlay\\\">${menuBlock('Dev', devItems(), pageDots())}</div>`;\\n      return;\\n    }\\n    if (model.overlay === 'chooser') {\\n      ui.innerHTML = menuBlock(GAME_TITLE, currentItems(), '<p class=\\\"tag\\\">The chart is already open.</p>');\\n      return;\\n    }\\n    if (model.screen === 'Title') {\\n      ui.innerHTML = `<section class=\\\"screen\\\"><h1 class=\\\"logo\\\" id=\\\"title\\\"></h1><p class=\\\"tag\\\" id=\\\"tagline\\\"></p><div class=\\\"ecg-line\\\"></div><div class=\\\"menu\\\">${btn({ id: 'start', label: 'Press any button' }, 0)}</div></section>`;\\n      ui.querySelector('#title').textContent = GAME_TITLE;\\n      ui.querySelector('#tagline').textContent = TAGLINE;\\n      return;\\n    }\\n    if (model.screen === 'Touch notice') {\\n      ui.innerHTML = touchHtml();\\n      return;\\n    }\\n    if (model.screen === 'Main Menu') {\\n      ui.innerHTML = menuBlock(GAME_TITLE, currentItems());\\n      const h = ui.querySelector('.logo');\\n      if (h) h.textContent = GAME_TITLE;\\n      return;\\n    }\\n    if (model.screen === 'Story' && model.storyMode === 'ask') {\\n      ui.innerHTML = `<section class=\\\"screen\\\"><p class=\\\"obj\\\">How much do you hate yourself, child?</p><div class=\\\"menu\\\">${currentItems().map(btn).join('')}</div></section>`;\\n      return;\\n    }\\n    if (model.screen === 'Story' && model.storyMode === 'lines') {\\n      const line = model.scene?.lines?.[model.line];\\n      const who = castOf(line?.who || 'narration');\\n      ui.innerHTML = `<section class=\\\"screen\\\"><p class=\\\"where\\\">${esc(model.scene?.where || '')}</p><div class=\\\"dialogue${line?.shout ? ' shout' : ''}\\\" data-item=\\\"advance\\\"><p class=\\\"who\\\">${esc(who.name)}</p><p>${esc(line?.text || '')}</p></div><div class=\\\"menu\\\">${btn({ id: 'advance', label: 'Continue' }, 0)}</div></section>`;\\n      return;\\n    }\\n    if (model.screen === 'Chart') ui.innerHTML = chartHtml();\\n    else if (model.screen === 'Operation') ui.innerHTML = hudHtml();\\n    else if (model.screen === 'Report') ui.innerHTML = reportHtml();\\n    else if (model.screen === 'Fail') ui.innerHTML = failHtml();\\n    else if (model.screen === 'Free Play') ui.innerHTML = menuBlock('Chart Board', freeItems(), `<p class=\\\"note\\\">${esc(DIFFICULTY[model.settings.difficulty]?.label || 'Resident')}</p>${pageDots()}`);\\n    else if (model.screen === 'Lobby') ui.innerHTML = lobbyHtml();\\n    else if (model.screen === 'Settings') ui.innerHTML = menuBlock('Settings', settingsItems(), pageDots());\\n    else if (model.screen === 'About') ui.innerHTML = aboutHtml();\\n    else if (model.screen === 'Credits roll') ui.innerHTML = `<section class=\\\"screen\\\"><h1 class=\\\"big\\\">Credits</h1><p class=\\\"note\\\">The lamp stays on.</p><div class=\\\"menu\\\">${btn({ id: 'credits-skip', label: 'Skip' }, 0)}</div></section>`;\\n    else ui.innerHTML = '<section class=\\\"screen\\\"><p class=\\\"note\\\">Scrubbing in…</p></section>';\\n  }\\n  model.paint = () => paint(false);\\n\\n  function patchLive() {\\n    const st = liveState();\\n    const set = (sel, text) => {\\n      const node = model.ui.querySelector(sel);\\n      if (node) node.textContent = text;\\n    };\\n    if (st) {\\n      set('[data-live=\\\"vitals\\\"]', st.vitals == null ? '' : String(Math.round(st.vitals)));\\n      set('[data-live=\\\"timer\\\"]', st.timer == null ? '' : clock(st.timer));\\n      set('[data-live=\\\"score\\\"]', st.score == null ? '' : String(st.score));\\n      set('[data-live=\\\"bpm\\\"]', st.bpm == null ? '' : String(Math.round(st.bpm)));\\n      const tool = st.tool;\\n      model.ui.querySelectorAll('[data-tool]').forEach((b) => b.classList.toggle('on', b.dataset.tool === tool));\\n    }\\n  }\\n\\n  function liveState() {\\n    if (model.sim) {\\n      return {\\n        vitals: model.sim.vitals,\\n        timer: model.sim.noTimer ? null : model.sim.timer,\\n        score: model.sim.score,\\n        bpm: model.sim.beat?.bpm,\\n        tool: model.sim.seats[0]?.tool,\\n      };\\n    }\\n    return null;\\n  }\\n\\n  function touchHtml() {\\n    return `<section class=\\\"screen\\\"><p class=\\\"touch-copy\\\">Controller or keyboard required</p><div class=\\\"menu\\\">${btn({ id: 'settings', label: 'Settings' }, model.focus)}</div></section>`;\\n  }\\n\\n  function pageDots() {\\n    const n = pageCount();\\n    if (n <= 1) return '';\\n    return `<p class=\\\"pages\\\">Page ${model.page + 1} / ${n}</p>`;\\n  }\\n\\n  function hudHtml() {\\n    const sim = model.sim;\\n    const op = sim?.op || safeOp(model.opId);\\n    const objective = sim?.objective || sim?.phase?.objective || '';\\n    const seats = sim?.seats || [];\\n    const seat = seats[0];\\n    const tools = (sim?.phase?.tools || []).join(' ');\\n    const sites = op?.sites || [];\\n    const siteBits = sites.length > 1 ? sites.map((s) => `<button type=\\\"button\\\" data-item=\\\"site:${esc(s.id)}\\\" class=\\\"item${s.id === sim?.activeSite ? ' on' : ''}\\\">${esc(s.organ || s.id)}</button>`).join('') : '';\\n    const wheel = WHEEL.map((tool) => `<button type=\\\"button\\\" data-tool=\\\"${tool}\\\" class=\\\"${seat?.tool === tool ? 'on' : ''}\\\">${esc(tool)}</button>`).join('');\\n    const prompt = fillPrompt('{special} gift   {syringe} stabilizer   {pause} pause', model.input?.promptSet || 'keyboard');\\n    const bark = model.bark ? `<div class=\\\"bark\\\"><p class=\\\"who\\\">${esc(castOf(model.bark.who).name)}</p><p>${esc(model.bark.text)}</p></div>` : '';\\n    return `<div class=\\\"hud\\\"><div class=\\\"hud-top\\\"><p class=\\\"obj\\\">${esc(objective)}</p><div><p class=\\\"vitals\\\" data-live=\\\"vitals\\\">${sim ? Math.round(sim.vitals) : ''}</p><div class=\\\"ecg-line\\\" id=\\\"ecg\\\"></div><p class=\\\"timer\\\" data-live=\\\"bpm\\\">${sim ? Math.round(sim.beat.bpm) : ''}</p></div><div><p class=\\\"timer\\\" data-live=\\\"timer\\\">${sim && !sim.noTimer ? clock(sim.timer) : ''}</p><p class=\\\"score\\\" data-live=\\\"score\\\">${sim ? sim.score : ''}</p></div></div><div></div><div class=\\\"hud-bot\\\"><div class=\\\"wheel\\\">${wheel}</div><div>${bark}<p class=\\\"note\\\">${esc(tools)}</p><div class=\\\"pages\\\">${siteBits}</div></div><div class=\\\"note\\\">${prompt}</div></div></div>`;\\n  }\\n\\n  function chartHtml() {\\n    const op = safeOp(model.opId);\\n    const p = op?.patient || {};\\n    const diff = DIFFICULTY[model.settings.difficulty]?.label || 'Resident';\\n    const items = chartItems();\\n    return `<section class=\\\"screen\\\"><p class=\\\"who\\\">${esc(op?.title || '')}</p><h1 class=\\\"big\\\">${esc(p.name || '')}</h1><p class=\\\"note\\\">${esc(p.age || '')} · ${esc(p.job || '')}</p><p class=\\\"obj\\\">${esc(p.note || '')}</p><p class=\\\"note\\\">Difficulty ${esc(diff)}. Left and right change it.</p><div class=\\\"menu\\\">${items.map(btn).join('')}</div></section>`;\\n  }\\n\\n  function reportHtml() {\\n    const sim = model.sim;\\n    const op = safeOp(model.opId);\\n    const rank = sim?.rank;\\n    const accuracy = sim?.seats?.[0]?.stats?.Accuracy ?? 100;\\n    const seats = (sim?.seats || []).filter((s) => !s.out).map((s) => `<p class=\\\"note\\\">${esc(s.name)} ${s.score}</p>`).join('');\\n    return `<section class=\\\"screen\\\"><p class=\\\"big\\\">${esc(rank?.id || '')}</p><p class=\\\"obj\\\">${esc(rank?.title || sim?.report?.text || '')}</p><div class=\\\"row\\\"><span>Time</span><span>${esc(clock(sim?.time || 0))}</span></div><div class=\\\"row\\\"><span>Vitals</span><span>${esc(Math.round(sim?.vitalsMin ?? sim?.vitals ?? 0))}</span></div><div class=\\\"row\\\"><span>Precision</span><span>${esc(accuracy)}</span></div><div class=\\\"row\\\"><span>Best Combo</span><span>${esc(sim?.bestCombo || 0)}</span></div><p class=\\\"note\\\">${esc(op?.patient?.followUp || '')}</p>${seats}<div class=\\\"menu\\\">${btn({ id: 'report-next', label: 'Continue' }, 0)}</div></section>`;\\n  }\\n\\n  function failHtml() {\\n    const reason = FAIL_TITLE[model.sim?.failed] || 'FLATLINE';\\n    const line = barkText('fail', null, 0);\\n    return `<section class=\\\"screen\\\"><h1 class=\\\"fail-title\\\">${esc(reason)}</h1><div class=\\\"bark\\\"><p class=\\\"who\\\">Bea</p><p>${esc(line)}</p></div><div class=\\\"menu\\\">${failItems().map(btn).join('')}</div></section>`;\\n  }\\n\\n  function lobbyHtml() {\\n    const items = lobbyItems();\\n    const prompt = fillPrompt('Press {confirm} to join', model.input?.promptSet || 'keyboard');\\n    return `<section class=\\\"screen\\\"><h1 class=\\\"big\\\">Grand Rounds</h1><p class=\\\"note\\\">${prompt}</p><div class=\\\"seats\\\">${[0, 1, 2, 3].map((i) => `<div class=\\\"seat\\\" style=\\\"color:${COLORS[i]}\\\">${model.joined.has(i) ? 'In' : 'Open'}</div>`).join('')}</div><div class=\\\"menu\\\">${items.map(btn).join('')}</div></section>`;\\n  }\\n\\n  function aboutHtml() {\\n    const data = aboutData();\\n    const page = Math.min(model.page, ABOUT_HEADS.length - 1);\\n    const [key, label] = ABOUT_HEADS[page];\\n    const tabs = ABOUT_HEADS.map(([, name], i) => btn({ id: `about:${i}`, label: name }, i)).join('');\\n    let body = '';\\n    const block = data[key];\\n    if (block && !Array.isArray(block) && typeof block === 'object') {\\n      body = Object.entries(block).map(([k, v]) => `<p class=\\\"about-line\\\">${esc(k)}: ${esc(v)}</p>`).join('');\\n    } else if (Array.isArray(block)) {\\n      body = block.map((line) => `<p class=\\\"about-line\\\">${esc(line)}</p>`).join('');\\n    }\\n    if (key === 'credits') {\\n      const lines = Array.isArray(data.credits) ? data.credits : [];\\n      body = lines.map((line) => `<p class=\\\"about-line\\\">${esc(line)}</p>`).join('');\\n      body += `<p class=\\\"about-line\\\">Renderer: ${esc(model.view?.backend || 'none')}</p>`;\\n    }\\n    return `<section class=\\\"screen\\\"><div class=\\\"tabs\\\">${tabs}</div><h1 class=\\\"obj\\\">${esc(label)}</h1><div class=\\\"page on\\\">${body}</div></section>`;\\n  }\\n\\n  function paintCard(ui) {\\n    ui.replaceChildren();\\n    const wrap = document.createElement('section');\\n    wrap.className = 'screen card';\\n    const h = document.createElement('h1');\\n    h.className = 'logo';\\n    h.textContent = GAME_TITLE;\\n    const tag = document.createElement('p');\\n    tag.className = 'tag';\\n    tag.textContent = TAGLINE;\\n    const goal = document.createElement('p');\\n    goal.className = 'obj';\\n    goal.textContent = 'Keep the patient alive and finish the operation together';\\n    const list = document.createElement('div');\\n    list.className = 'seats';\\n    const ready = new Set(model.card?.ready || []);\\n    for (const p of model.sessionInfo?.players || []) {\\n      const seat = document.createElement('div');\\n      seat.className = 'seat';\\n      if (/^#[0-9a-fA-F]{3,8}$/.test(p.color || '')) seat.style.color = p.color;\\n      seat.textContent = `${p.name || 'Surgeon'}${ready.has(p.id) ? ' ready' : ''}`;\\n      list.append(seat);\\n    }\\n    const secs = document.createElement('p');\\n    secs.className = 'vitals';\\n    if (model.card?.left != null) secs.textContent = String(Math.max(0, Math.ceil(model.card.left)));\\n    const how = document.createElement('p');\\n    how.className = 'note';\\n    how.textContent = 'Aim with the right stick or the mouse. Use with R2 or click. Tools are the left stick or the number keys.';\\n    const menu = document.createElement('div');\\n    menu.className = 'menu';\\n    for (const item of [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More Time' }]) {\\n      const b = document.createElement('button');\\n      b.type = 'button';\\n      b.className = 'item';\\n      b.dataset.item = item.id;\\n      b.textContent = item.label;\\n      menu.append(b);\\n    }\\n    wrap.append(h, tag, goal, list, secs, how, menu);\\n    ui.append(wrap);\\n  }\\n\\n  function state() {\\n    const sim = model.sim;\\n    const net = !sim ? model.netState : null;\\n    const seats = sim?.seats || net?.seats || [];\\n    const seat = seats.find((s) => !s.out) || seats[0];\\n    const items = currentItems();\\n    const rank = sim?.rank?.id || (typeof net?.rank === 'string' ? net.rank : net?.rank?.id) || null;\\n    return {\\n      screen: model.screen,\\n      op: sim?.op?.id || net?.op || null,\\n      phase: sim?.phase?.id || net?.phase || null,\\n      vitals: sim ? sim.vitals : (net?.vitals ?? null),\\n      timer: sim ? sim.timer : (net?.timer ?? null),\\n      score: sim ? sim.score : (net?.score ?? 0),\\n      rank,\\n      bpm: sim ? sim.beat.bpm : (net?.bpm ?? null),\\n      beat: sim ? sim.beat.count : (net?.beat ?? 0),\\n      site: sim ? sim.activeSite : (net?.site ?? null),\\n      tool: seat?.tool || null,\\n      tips: seats.map((s) => ({ id: s.id, x: s.x, y: s.y, tool: s.tool, score: s.score || 0 })),\\n      focusId: items[model.focus]?.id || null,\\n      promptSet: model.input?.promptSet || document.documentElement.dataset.promptSet || 'keyboard',\\n      glyphSet: model.settings.glyphs || 'playstation',\\n      attract: !!model.attract.on,\\n      devOpen: model.overlay === 'dev',\\n      renderBackend: model.view?.backend || 'none',\\n      musicGain: model.audio?.music?.gain?.value ?? 0.1,\\n      tuning: model.tuning,\\n      reached: [...model.reached],\\n    };\\n  }\\n\\n  const api = {\\n    state,\\n    audio,\\n    devRun(id, arg) { return runDev(model, id, arg); },\\n  };\\n  if (model.test) {\\n    api.test = {\\n      step(n) {\\n        const count = Math.max(0, n | 0);\\n        for (let i = 0; i < count; i++) stepOnce();\\n      },\\n      warp(n) { model.warp = n | 0; },\\n      input(frame) { model.override = frame || null; },\\n      bot(on, opts) {\\n        model.botOn = !!on;\\n        if (opts) model.botOpts = opts;\\n      },\\n      skipTo(op, phase) {\\n        model.flow = model.flow || 'free';\\n        model.opId = op;\\n        freeSim();\\n        model.sim = new Sim({\\n          op, seed: 1, physics: false, tuning: model.tuning,\\n          difficulty: model.settings.difficulty || 'resident', players: 1,\\n        });\\n        if (phase) model.sim.skipTo(phase);\\n        model.resultShown = false;\\n        model.overlay = null;\\n        setScreen('Operation');\\n      },\\n      hash() { return model.sim ? model.sim.hash() : ''; },\\n    };\\n  }\\n\\n  let raf = 0;\\n  let timer = 0;\\n  function draw() {\\n    if (model.mode === 'session' || !model.view || model.norender || model.painting) return;\\n    model.painting = true;\\n    try {\\n      if (model.sim && (model.attract.on || model.screen === 'Operation')) {\\n        model.view.showOr?.();\\n        model.view.sync(decorateState(model.sim.state), 1 / 60);\\n      } else if (model.screen === 'Story') present();\\n    } catch { /* draw again next frame */ }\\n    const drawn = model.view.render?.();\\n    if (drawn?.then) drawn.then(() => { model.painting = false; }, () => { model.painting = false; });\\n    else model.painting = false;\\n  }\\n\\n  function loop() {\\n    raf = requestAnimationFrame(loop);\\n    if (model.mode === 'session') return;\\n    checkAttract();\\n    if (model.test && !(model.warp > 0)) {\\n      /* scripted steps own the sim */\\n    } else {\\n      const n = model.warp > 0 ? model.warp : 1;\\n      for (let i = 0; i < n; i++) stepOnce();\\n    }\\n    draw();\\n  }\\n\\n  function wantsTouch() {\\n    const mq = window.matchMedia?.('(any-pointer: fine)');\\n    if (!mq) return false;\\n    return mq.matches === false && !model.input.seenPad;\\n  }\\n\\n  async function bootView() {\\n    if (!model.canvas) return;\\n    if (model.norender) {\\n      model.view = createPointerCamera(model.canvas);\\n      return;\\n    }\\n    const webgl = model.params.get('webgl') === '1';\\n    try {\\n      model.view = await createView(model.canvas, { webgl });\\n    } catch {\\n      try {\\n        model.view = await createView(model.canvas, { webgl: true });\\n      } catch {\\n        model.view = createPointerCamera(model.canvas);\\n        model.nogfxNotice = true;\\n        paint(true);\\n      }\\n    }\\n    if (model.settings.boil === false) model.view?.setBoil?.(false);\\n  }\\n\\n  return {\\n    api,\\n    startSession(info) {\\n      model.mode = 'session';\\n      model.sessionInfo = info;\\n      model.paint = () => paint(false);\\n      model.syncFromSim = syncFromSim;\\n      model.applySettings = model.applySettings;\\n      model.tickAudio = tickAudio;\\n      model.playEvent = playEvent;\\n      model.decorateState = decorateState;\\n      if (raf) cancelAnimationFrame(raf);\\n      if (timer) clearInterval(timer);\\n      runSession(model, info);\\n    },\\n    async startStandalone() {\\n      model.mode = 'standalone';\\n      model.lastInput = performance.now();\\n      if (wantsTouch()) setScreen('Touch notice');\\n      else setScreen('Title');\\n      try { document.body.focus(); } catch { /* focus is a courtesy */ }\\n      raf = requestAnimationFrame(loop);\\n      timer = setInterval(() => {\\n        if (model.mode === 'session') return;\\n        checkAttract();\\n        if (model.attract.on && model.test) {\\n          for (let i = 0; i < 4; i++) stepOnce();\\n        }\\n      }, 250);\\n      await bootView();\\n      present();\\n      draw();\\n    },\\n  };\\n}\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/director.js has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/director.js has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/director.js\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"import { GAME_TITLE, TAGLINE } from '../config/identity.js';\\nimport { createTuning, DIFFICULTY, TUNING_DEFAULTS, TUNING_PAGES, TUNING_RANGES } from '../config/tuning.js';\\nimport { getOp, storyOrder } from '../data/ops/index.js';\\nimport { SCENES } from '../data/story/scenes.js';\\nimport { castOf } from '../data/cast.js';\\nimport { barkText } from '../data/barks.js';\\nimport { fillPrompt } from '../input/glyphs.js';\\nimport { createInput } from '../input/input.js';\\nimport { createAudio } from '../audio/engine.js';\\nimport { Sim } from '../sim/sim.js';\\nimport { botInput } from '../sim/bot.js';\\nimport { physicsReady } from '../sim/physics.js';\\nimport { createPointerCamera, createView } from '../view/renderer.js';\\nimport { loadSave, writeSave } from './save.js';\\nimport { DEV_IDS, runDev } from './dev.js';\\nimport { runSession } from './session.js';\\n\\nconst COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\\nconst WHEEL = ['scalpel', 'forceps', 'suction', 'gel', 'suture', 'laser', 'scanner', 'clamp'];\\nconst ABOUT_HEADS = [\\n  ['sourceInformation', 'Source Information'],\\n  ['testingFeedback', 'Testing Feedback'],\\n  ['engineFeedback', 'Engine Feedback'],\\n  ['promptFeedback', 'Prompt Feedback'],\\n  ['credits', 'Credits'],\\n];\\nconst FAIL_TITLE = { vitals: 'FLATLINE', time: 'TIME', miss: 'MALPRACTICE' };\\nconst FX = {\\n  pop: 'pop', cut: 'scalpel', clamp: 'clamp', unclamp: 'clamp', shock: 'defib',\\n  inject: 'syringe', stabilize: 'syringe', gelled: 'gel', sealed: 'gel', tied: 'stitch',\\n  gate: 'thread', lasered: 'laser', scorch: 'laser', vent: 'laser', mark: 'scanner',\\n  nick: 'alarm', tear: 'alarm', fail: 'flatline', success: 'stamp', hush: 'murmur',\\n  sforzando: 'phone', arrest: 'alarm', drained: 'suction', tray: 'forceps', grip: 'forceps',\\n  drop: 'forceps', note: 'ui-move', pin: 'clamp', downed: 'pop', burst: 'pop', wake: 'chitter',\\n  fortissimo: 'screech', reattach: 'scratch', jerk: 'scratch', cue: 'ui-move',\\n};\\n\\nconst SETTINGS_PAGES = [\\n  [\\n    { id: 'music', label: 'Music', kind: 'slider', min: 0, max: 1, step: 0.01 },\\n    { id: 'effects', label: 'Effects', kind: 'slider', min: 0, max: 1, step: 0.01 },\\n    { id: 'voices', label: 'Voices', kind: 'slider', min: 0, max: 1, step: 0.01 },\\n  ],\\n  [\\n    { id: 'glyphs', label: 'Glyphs', kind: 'toggle' },\\n    { id: 'rumble', label: 'Rumble', kind: 'toggle' },\\n    { id: 'aimAssist', label: 'Aim Assist', kind: 'slider', min: 0, max: 1, step: 0.01 },\\n    { id: 'swapSticks', label: 'Swap Sticks', kind: 'toggle' },\\n    { id: 'tipSpeed', label: 'Tip Speed', kind: 'slider', min: 0.8, max: 3.5, step: 0.05 },\\n  ],\\n  [\\n    { id: 'fullscreen', label: 'Fullscreen', kind: 'toggle' },\\n    { id: 'shake', label: 'Screen Shake', kind: 'toggle' },\\n    { id: 'boil', label: 'Line Boil', kind: 'toggle' },\\n    { id: 'textSpeed', label: 'Text Speed', kind: 'cycle' },\\n  ],\\n];\\n\\nfunction esc(s) {\\n  return String(s ?? '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));\\n}\\n\\nfunction clock(t) {\\n  const s = Math.max(0, Math.ceil(Number(t) || 0));\\n  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;\\n}\\n\\nexport function createApp({ params }) {\\n  const save = loadSave();\\n  const tuning = createTuning();\\n  const settings = {\\n    glyphs: 'playstation',\\n    music: 0.1,\\n    effects: 0.8,\\n    voices: 0.8,\\n    rumble: true,\\n    shake: true,\\n    boil: true,\\n    textSpeed: 1,\\n    difficulty: save.difficulty || 'resident',\\n    aimAssist: tuning.aimAssist,\\n    tipSpeed: tuning.tipSpeed,\\n    swapSticks: false,\\n    fullscreen: false,\\n    ...(save.settings || {}),\\n  };\\n  tuning.aimAssist = settings.aimAssist;\\n  tuning.tipSpeed = settings.tipSpeed;\\n\\n  const model = {\\n    screen: 'Boot',\\n    overlay: null,\\n    mode: 'standalone',\\n    params,\\n    tuning,\\n    settings,\\n    save,\\n    reached: new Set(),\\n    overlays: {},\\n    botOn: false,\\n    botOpts: {},\\n    warp: 0,\\n    test: params.get('test') === '1',\\n    norender: params.get('norender') === '1',\\n    pending: {},\\n    lastInput: performance.now(),\\n    attract: { on: false, from: null, opIndex: 0, opT: 0 },\\n    resultShown: false,\\n    sessionPause: false,\\n    focus: 0,\\n    page: 0,\\n    stack: [],\\n    joined: new Set(),\\n    siteHold: new Map(),\\n    storyMode: null,\\n    line: 0,\\n    consultChoice: 'careful',\\n    flow: 'story',\\n    storyIndex: 0,\\n    hold: 0,\\n    track: null,\\n    bark: null,\\n    ignoreUntil: 0,\\n    paintSig: '',\\n    painting: false,\\n    countN: 0,\\n    card: null,\\n    nogfxNotice: false,\\n  };\\n\\n  function persist() {\\n    if (model.attract.on || model.mode === 'session') return;\\n    model.save.difficulty = model.settings.difficulty;\\n    model.save.settings = { ...model.settings };\\n    writeSave(model.save);\\n  }\\n\\n  function audioOk() {\\n    return !model.sessionInfo?.server;\\n  }\\n\\n  const audio = createAudio();\\n  audio.setMusicGain(settings.music ?? 0.1);\\n  audio.sfx.gain.value = settings.effects ?? 0.8;\\n  audio.voice.gain.value = settings.voices ?? 0.8;\\n  model.audio = audio;\\n\\n  function onKey(e) {\\n    if (e.repeat) return;\\n    if (e.key === 'Tab') e.preventDefault();\\n    audio.resume();\\n    model.lastInput = performance.now();\\n    if (model.attract.on) {\\n      model.pending = {};\\n      model.ignoreUntil = performance.now() + 350;\\n      exitAttract();\\n      return;\\n    }\\n    if (model.mode === 'session' && (model.screen === 'Card' || AIHub.time?.() === -Infinity)) {\\n      const k = String(e.key || e.code || '').toLowerCase();\\n      if (k === 'enter' || k === ' ' || k === 'space') AIHub.answer('ready');\\n      else if (k === 'm') AIHub.answer('more');\\n      return;\\n    }\\n    if (model.screen === 'Touch notice') {\\n      model.pending.leaveTouch = true;\\n      return;\\n    }\\n    const key = String(e.key || '');\\n    const code = String(e.code || e.key || '');\\n    if (model.screen === 'Title') {\\n      model.pending.confirm = true;\\n      return;\\n    }\\n    const inPlay = model.screen === 'Operation' && !model.overlay && !model.sessionPause;\\n    if (inPlay && (key === 'h' || key === 'H' || code === 'KeyH')) {\\n      askBea();\\n      return;\\n    }\\n    if (key === 'Escape' || key === 'Backspace' || code === 'Escape' || code === 'Backspace') {\\n      model.pending[inPlay || model.screen === 'Story' ? 'pause' : 'back'] = true;\\n      return;\\n    }\\n    if (inPlay) return;\\n    if (key === 'Enter' || key === ' ' || code === 'Enter' || code === 'Space') model.pending.confirm = true;\\n    else if (key === 'Tab' || code === 'Tab') model.pending.skip = true;\\n    else if (key === 'ArrowUp' || key === 'w' || key === 'W' || code === 'ArrowUp' || code === 'KeyW') model.pending.up = true;\\n    else if (key === 'ArrowDown' || key === 's' || key === 'S' || code === 'ArrowDown' || code === 'KeyS') model.pending.down = true;\\n    else if (key === 'ArrowLeft' || key === 'a' || key === 'A' || code === 'ArrowLeft' || code === 'KeyA') model.pending.left = true;\\n    else if (key === 'ArrowRight' || key === 'd' || key === 'D' || code === 'ArrowRight' || code === 'KeyD') model.pending.right = true;\\n    else if (key === 'q' || key === 'Q' || code === 'KeyQ') model.pending.pageLeft = true;\\n    else if (key === 'e' || key === 'E' || code === 'KeyE') model.pending.pageRight = true;\\n  }\\n\\n  function onHover(id) {\\n    if (model.attract.on) {\\n      model.ignoreUntil = performance.now() + 350;\\n      exitAttract();\\n      return;\\n    }\\n    const items = currentItems();\\n    const i = items.findIndex((it) => it.id === id);\\n    if (i >= 0 && i !== model.focus) {\\n      model.focus = i;\\n      if (model.screen === 'About') model.page = i;\\n      paint(true);\\n    }\\n  }\\n\\n  function onActivate(id) {\\n    model.lastInput = performance.now();\\n    audio.resume();\\n    if (model.attract.on) {\\n      model.ignoreUntil = performance.now() + 350;\\n      exitAttract();\\n      return;\\n    }\\n    if (performance.now() < model.ignoreUntil) {\\n      model.ignoreUntil = 0;\\n      return;\\n    }\\n    if (model.mode === 'session' && (id === 'ready' || id === 'more')) {\\n      AIHub.answer(id === 'more' ? 'more' : 'ready');\\n      return;\\n    }\\n    activate(id);\\n  }\\n\\n  function onTool(tool) {\\n    model.pendingTool = tool;\\n    model.lastInput = performance.now();\\n  }\\n\\n  function onPointer() {\\n    model.lastInput = performance.now();\\n    if (model.attract.on) {\\n      model.ignoreUntil = performance.now() + 350;\\n      exitAttract();\\n    }\\n  }\\n\\n  model.onKey = onKey;\\n  model.onHover = onHover;\\n  model.onActivate = onActivate;\\n  model.onTool = onTool;\\n  model.onPointer = onPointer;\\n  model.persist = persist;\\n  model.reached = model.reached;\\n  model.openScene = openScene;\\n  model.setScreen = (name, overlay = null) => setScreen(name, overlay);\\n\\n  ensureDom();\\n  model.input = createInput(model);\\n  document.documentElement.dataset.promptSet = 'keyboard';\\n  if (model.ui) {\\n    model.ui.addEventListener('input', (e) => {\\n      const id = e.target?.dataset?.slider;\\n      if (!id) return;\\n      writeSetting(id, Number(e.target.value));\\n    });\\n  }\\n  document.addEventListener('visibilitychange', () => {\\n    if (document.hidden && model.mode !== 'session' && !model.attract.on && !model.overlay\\n      && (model.screen === 'Operation' || model.screen === 'Story')) {\\n      setOverlay('pause');\\n    }\\n  });\\n  window.addEventListener('resize', () => model.view?.resize?.());\\n\\n  function ensureDom() {\\n    if (!document.body) return;\\n    if (!document.getElementById('boot')) {\\n      const boot = document.createElement('div');\\n      boot.id = 'boot';\\n      boot.textContent = 'Scrubbing in…';\\n      document.body.prepend(boot);\\n    }\\n    let app = document.getElementById('app');\\n    if (!app) {\\n      app = document.createElement('div');\\n      app.id = 'app';\\n      app.hidden = true;\\n      const canvas = document.createElement('canvas');\\n      canvas.id = 'view';\\n      const ui = document.createElement('div');\\n      ui.id = 'ui';\\n      app.append(canvas, ui);\\n      document.body.append(app);\\n    }\\n    model.canvas = document.getElementById('view');\\n    model.ui = document.getElementById('ui');\\n    document.body.tabIndex = 0;\\n  }\\n\\n  function aboutData() {\\n    if (model.aboutDoc) return model.aboutDoc;\\n    const el = document.getElementById('about-data');\\n    try { model.aboutDoc = JSON.parse(el?.textContent || '{}'); } catch { model.aboutDoc = {}; }\\n    return model.aboutDoc;\\n  }\\n\\n  function currentItems() {\\n    if (model.nogfxNotice) return [{ id: 'nogfx-ok', label: 'Continue' }];\\n    if (model.mode === 'session' && model.sessionPause) return settingsItems();\\n    if (model.overlay === 'chooser') return [{ id: 'continue', label: 'Continue' }, { id: 'new', label: 'New Game' }];\\n    if (model.overlay === 'pause') return pauseItems();\\n    if (model.overlay === 'dev') return devItems();\\n    if (model.screen === 'Title') return [{ id: 'start', label: 'Press any button' }];\\n    if (model.screen === 'Touch notice') return [{ id: 'settings', label: 'Settings' }];\\n    if (model.screen === 'Main Menu') {\\n      const story = (model.save.intro || model.save.storyPos > 0 || model.save.cleared?.length) ? 'Story' : 'Story';\\n      return [\\n        { id: 'story', label: story },\\n        { id: 'free', label: 'Free Play' },\\n        { id: 'rounds', label: 'Grand Rounds' },\\n        { id: 'settings', label: 'Settings' },\\n        { id: 'about', label: 'About & Credits' },\\n      ];\\n    }\\n    if (model.screen === 'Story' && model.storyMode === 'ask') {\\n      return [\\n        { id: 'intern', label: 'Intern' },\\n        { id: 'resident', label: 'Resident' },\\n        { id: 'attending', label: 'Attending' },\\n      ];\\n    }\\n    if (model.screen === 'Story' && model.storyMode === 'lines') return [{ id: 'advance', label: 'Continue' }];\\n    if (model.screen === 'Chart') return chartItems();\\n    if (model.screen === 'Report') return [{ id: 'report-next', label: 'Continue' }];\\n    if (model.screen === 'Fail') return failItems();\\n    if (model.screen === 'Free Play') return freeItems();\\n    if (model.screen === 'Lobby') return lobbyItems();\\n    if (model.screen === 'Settings') return settingsItems();\\n    if (model.screen === 'About') return aboutItems();\\n    if (model.screen === 'Credits roll') return [{ id: 'credits-skip', label: 'Skip' }];\\n    if (model.mode === 'session' && model.screen === 'Card') return [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More Time' }];\\n    return [];\\n  }\\n\\n  function chartItems() {\\n    const op = safeOp(model.opId);\\n    if (op?.consult) {\\n      return [\\n        { id: 'careful', label: 'Careful' },\\n        { id: 'aggressive', label: 'Aggressive' },\\n        { id: 'begin', label: 'Begin' },\\n      ];\\n    }\\n    return [{ id: 'begin', label: 'Begin' }];\\n  }\\n\\n  function pauseItems() {\\n    if (model.screen === 'Story') {\\n      return [\\n        { id: 'resume', label: 'Resume' },\\n        { id: 'skip-scene', label: 'Skip Scene' },\\n        { id: 'settings', label: 'Settings' },\\n        { id: 'dev', label: 'Dev Mode' },\\n        { id: 'quit', label: 'Quit to Menu' },\\n      ];\\n    }\\n    return [\\n      { id: 'resume', label: 'Resume' },\\n      { id: 'retry', label: 'Retry Phase' },\\n      { id: 'restart', label: 'Restart Operation' },\\n      { id: 'settings', label: 'Settings' },\\n      { id: 'dev', label: 'Dev Mode' },\\n      { id: 'quit', label: 'Quit to Menu' },\\n    ];\\n  }\\n\\n  function failItems() {\\n    const items = [\\n      { id: 'retry', label: 'Retry Phase' },\\n      { id: 'restart', label: 'Restart Operation' },\\n      { id: 'quit', label: 'Quit to Menu' },\\n    ];\\n    if (model.sim?.notesOffer) items.push({ id: 'notes', label: \\\"Bea's Notes\\\" });\\n    return items;\\n  }\\n\\n  function freeItems() {\\n    const ids = storyOrder().filter(unlocked);\\n    const slice = ids.slice(model.page * 4, model.page * 4 + 4);\\n    const items = slice.map((id) => {\\n      const rank = model.save.ranks?.[id];\\n      return { id: `play:${id}`, label: `${getOp(id).title}${rank ? ` ${rank}` : ''}` };\\n    });\\n    items.push({ id: 'doctor', label: `Doctor: ${model.doctor === 'ines' ? 'Ines' : 'Ren'}` });\\n    return items;\\n  }\\n\\n  function lobbyItems() {\\n    return [0, 1, 2, 3].map((i) => ({\\n      id: `seat:${i}`,\\n      label: model.joined.has(i) ? `Seat ${i + 1} in` : `Seat ${i + 1}`,\\n    })).concat([{ id: 'begin', label: 'Begin' }]);\\n  }\\n\\n  function settingsItems() {\\n    const page = SETTINGS_PAGES[model.page] || SETTINGS_PAGES[0];\\n    return page.map((item) => ({ ...item, label: `${item.label}: ${readout(item.id)}` }));\\n  }\\n\\n  function aboutItems() {\\n    return ABOUT_HEADS.map(([, label], i) => ({ id: `about:${i}`, label }));\\n  }\\n\\n  function devItems() {\\n    const pages = devPages();\\n    const page = pages[Math.min(model.page, pages.length - 1)] || [];\\n    return page;\\n  }\\n\\n  function devPages() {\\n    const buttons = DEV_IDS.map((id) => ({\\n      id,\\n      kind: 'dev',\\n      label: id.startsWith('op:') ? safeOp(id.slice(3))?.title || id : id,\\n    }));\\n    const pages = [];\\n    for (let i = 0; i < buttons.length; i += 6) pages.push(buttons.slice(i, i + 6));\\n    for (const page of TUNING_PAGES) {\\n      pages.push(page.keys.map((key) => ({\\n        id: key,\\n        kind: 'slider',\\n        label: key,\\n        min: TUNING_RANGES[key][0],\\n        max: TUNING_RANGES[key][1],\\n        step: stepOf(TUNING_RANGES[key]),\\n      })).concat([{ id: 'reset-page', kind: 'dev', label: 'Reset page', keys: page.keys }]));\\n    }\\n    pages.push([{ id: 'reset-all', kind: 'dev', label: 'Reset all' }]);\\n    return pages;\\n  }\\n\\n  function stepOf(range) {\\n    const span = range[1] - range[0];\\n    if (span <= 20 && Number.isInteger(range[0]) && Number.isInteger(range[1])) return 1;\\n    return Math.round((span / 20) * 1000) / 1000;\\n  }\\n\\n  function pageCount() {\\n    if (model.overlay === 'dev') return devPages().length;\\n    if (model.screen === 'Settings' || model.sessionPause) return SETTINGS_PAGES.length;\\n    if (model.screen === 'About') return ABOUT_HEADS.length;\\n    if (model.screen === 'Free Play') return Math.max(1, Math.ceil(storyOrder().filter(unlocked).length / 4));\\n    return 1;\\n  }\\n\\n  function unlocked(id) {\\n    if (model.save.unlocked) return true;\\n    if (model.save.cleared?.includes(id)) return true;\\n    const i = storyOrder().indexOf(id);\\n    return i >= 0 && i <= (model.save.storyPos || 0);\\n  }\\n\\n  function safeOp(id) {\\n    try { return getOp(id); } catch { return null; }\\n  }\\n\\n  function defaultFocus() {\\n    if (model.screen === 'Story' && model.storyMode === 'ask') return 1;\\n    if (model.screen === 'Chart') return Math.max(0, chartItems().length - 1);\\n    if (model.screen === 'Lobby') return 4;\\n    if (model.screen === 'About') return model.page || 0;\\n    return 0;\\n  }\\n\\n  function setScreen(name, overlay = null) {\\n    model.screen = name;\\n    model.overlay = overlay;\\n    model.page = name === 'About' ? model.page : 0;\\n    if (name !== 'About') model.page = 0;\\n    model.reached.add(name);\\n    if (name === 'Credits roll') model.reached.add('Credits');\\n    model.focus = defaultFocus();\\n    document.body.dataset.screen = name;\\n    syncMusic();\\n    present();\\n    paint(true);\\n  }\\n\\n  function setOverlay(name) {\\n    model.overlay = name;\\n    model.focus = 0;\\n    model.page = 0;\\n    paint(true);\\n  }\\n\\n  function readout(id) {\\n    if (id === 'glyphs') return model.settings.glyphs === 'xbox' ? 'Xbox' : 'PlayStation';\\n    if (id === 'rumble' || id === 'swapSticks' || id === 'fullscreen' || id === 'shake' || id === 'boil') {\\n      return model.settings[id] ? 'On' : 'Off';\\n    }\\n    if (id === 'textSpeed') return `${model.settings.textSpeed}x`;\\n    if (id === 'music' || id === 'effects' || id === 'voices') return `${Math.round((model.settings[id] ?? 0) * 100)}%`;\\n    const n = id in TUNING_DEFAULTS ? model.tuning[id] : model.settings[id];\\n    return `${Number(n).toFixed(2)} (default ${Number(TUNING_DEFAULTS[id] ?? n).toFixed(2)})`;\\n  }\\n\\n  function writeSetting(id, value) {\\n    if (id === 'music' || id === 'effects' || id === 'voices' || id === 'aimAssist' || id === 'tipSpeed') {\\n      model.settings[id] = value;\\n      if (id === 'music') audio.setMusicGain(value);\\n      if (id === 'effects') audio.sfx.gain.value = value;\\n      if (id === 'voices') audio.voice.gain.value = value;\\n      if (id === 'aimAssist' || id === 'tipSpeed') model.tuning[id] = value;\\n    } else if (id in TUNING_DEFAULTS) {\\n      model.tuning[id] = value;\\n    } else {\\n      model.settings[id] = value;\\n    }\\n    const node = model.ui?.querySelector(`[data-readout=\\\"${id}\\\"]`);\\n    if (node) node.textContent = readout(id);\\n    persist();\\n  }\\n\\n  function syncMusic() {\\n    if (!audioOk()) return;\\n    let id = 'title';\\n    let bpm = 80;\\n    if (model.mode === 'session') {\\n      id = (model.screen === 'Card' || model.screen === 'Countdown') ? 'title' : 'rounds';\\n    } else if (model.attract.on && model.sim) {\\n      id = model.sim.op.music || 'rounds';\\n      bpm = model.sim.op.bpm || 80;\\n    } else if (model.screen === 'Story' && model.scene?.music) {\\n      id = model.scene.music;\\n    } else if ((model.screen === 'Operation' || model.screen === 'Chart' || model.screen === 'Report' || model.screen === 'Fail') && model.opId) {\\n      const op = safeOp(model.opId);\\n      id = model.screen === 'Operation' ? (op?.music || 'or-calm') : 'or-tense';\\n      bpm = op?.bpm || 80;\\n    } else if (model.screen === 'Credits roll') id = 'credits';\\n    else if (model.screen === 'Lobby') id = 'rounds';\\n    if (id !== model.track) {\\n      model.track = id;\\n      audio.playTrack(id, bpm);\\n    }\\n    audio.setHush(!!(model.sim && model.sim.hushPhase));\\n  }\\n\\n  function present() {\\n    const view = model.view;\\n    if (!view) return;\\n    if (model.screen === 'Story' && model.scene) {\\n      const line = model.scene.lines[model.line];\\n      view.showStory?.(model.scene.set, line?.who);\\n      view.setSpeaker?.(line?.who, { mouth: 'open' });\\n      view.shout?.(!!line?.shout);\\n    } else if (model.screen === 'Operation' || model.attract.on || model.screen === 'Chart') {\\n      view.showOr?.();\\n      view.shout?.(false);\\n    }\\n  }\\n\\n  function decorateState(st) {\\n    if (!st) return st;\\n    if (!st.organ) {\\n      const op = safeOp(st.op);\\n      const site = op?.sites?.find((s) => s.id === st.site) || op?.sites?.[0];\\n      st.organ = site?.organ || 'forearm';\\n    }\\n    return st;\\n  }\\n  model.decorateState = decorateState;\\n\\n  function playEvent(ev) {\\n    if (!ev || !audioOk()) return;\\n    if (ev.type === 'say' && ev.text) {\\n      audio.say(ev.who || 'bea', ev.text);\\n      model.bark = { who: ev.who || 'bea', text: ev.text };\\n    } else if (ev.type === 'bark') {\\n      const text = barkText(ev.key, ev.arg, ev.n || 0);\\n      audio.say(ev.who || 'bea', text);\\n      model.bark = { who: ev.who || 'bea', text };\\n    } else if (FX[ev.type]) audio.effect(FX[ev.type]);\\n    if (ev.type === 'hush' || ev.type === 'success' || ev.type === 'fail') syncMusic();\\n  }\\n  model.playEvent = playEvent;\\n\\n  function tickAudio() {\\n    if (!audioOk()) return;\\n    audio.scheduleAhead();\\n    if (model.remoteEvents?.length) {\\n      for (const ev of model.remoteEvents) playEvent(ev);\\n      model.remoteEvents = [];\\n    }\\n  }\\n  model.tickAudio = tickAudio;\\n\\n  function syncFromSim() {\\n    if (!model.view || !model.sim || model.norender) return;\\n    model.painting = true;\\n    try {\\n      model.view.showOr?.();\\n      model.view.sync(decorateState(model.sim.state), 1 / 60);\\n    } catch { /* the next pump draws */ }\\n    const drawn = model.view.render?.();\\n    if (drawn?.then) drawn.then(() => { model.painting = false; }, () => { model.painting = false; });\\n    else model.painting = false;\\n  }\\n  model.syncFromSim = syncFromSim;\\n\\n  function askBea() {\\n    const text = barkText('idle', null, (model.sim?.tick || 0) % 3);\\n    audio.say('bea', text);\\n    model.bark = { who: 'bea', text };\\n    paint(true);\\n  }\\n\\n  function openScene(id, onDone) {\\n    const scene = SCENES.find((s) => s.id === id);\\n    if (!scene) {\\n      onDone?.();\\n      return;\\n    }\\n    model.scene = scene;\\n    model.sceneId = id;\\n    model.line = 0;\\n    model.storyMode = 'lines';\\n    model.sceneDone = onDone || null;\\n    setScreen('Story');\\n    const line = scene.lines[0];\\n    if (line && audioOk()) audio.say(line.who, line.text);\\n  }\\n\\n  function advanceLine() {\\n    const lines = model.scene?.lines || [];\\n    if (model.line >= lines.length - 1) {\\n      finishScene();\\n      return;\\n    }\\n    model.line += 1;\\n    const line = lines[model.line];\\n    model.view?.setSpeaker?.(line.who, { mouth: 'open' });\\n    model.view?.shout?.(!!line.shout);\\n    if (audioOk()) audio.say(line.who, line.text);\\n    paint(true);\\n  }\\n\\n  function finishScene() {\\n    const done = model.sceneDone;\\n    model.sceneDone = null;\\n    model.view?.shout?.(false);\\n    if (done) done();\\n    else setScreen('Main Menu');\\n  }\\n\\n  function openAsk() {\\n    model.storyMode = 'ask';\\n    model.flow = 'story';\\n    setScreen('Story');\\n  }\\n\\n  function beginNew() {\\n    model.save.storyPos = 0;\\n    model.save.intro = false;\\n    model.save.cleared = [];\\n    model.flow = 'story';\\n    model.overlay = null;\\n    persist();\\n    openAsk();\\n  }\\n\\n  function confirmDifficulty(id) {\\n    model.settings.difficulty = id;\\n    model.save.difficulty = id;\\n    persist();\\n    if (!model.save.intro) openScene('S0', afterIntro);\\n    else openOpStory(model.save.storyPos || 0);\\n  }\\n\\n  function afterIntro() {\\n    model.save.intro = true;\\n    persist();\\n    openOpStory(0);\\n  }\\n\\n  function openOpStory(index) {\\n    const order = storyOrder();\\n    if (index >= order.length) {\\n      openCredits();\\n      return;\\n    }\\n    model.storyIndex = index;\\n    model.flow = 'story';\\n    model.save.storyPos = index;\\n    model.save.intro = true;\\n    persist();\\n    const op = getOp(order[index]);\\n    model.opId = op.id;\\n    if (op.scene?.before) openScene(op.scene.before, () => openChart(op.id));\\n    else openChart(op.id);\\n  }\\n\\n  function openChart(opId) {\\n    model.opId = opId;\\n    model.consultChoice = 'careful';\\n    model.flow = model.flow || 'story';\\n    setScreen('Chart');\\n  }\\n\\n  function openCredits() {\\n    setScreen('Credits roll');\\n  }\\n\\n  function continueReport() {\\n    recordResult();\\n    if (model.flow === 'couch') {\\n      setScreen('Lobby');\\n      return;\\n    }\\n    if (model.flow === 'free') {\\n      setScreen('Free Play');\\n      return;\\n    }\\n    const op = safeOp(model.opId);\\n    if (op?.scene?.after) openScene(op.scene.after, afterScene);\\n    else afterScene();\\n  }\\n\\n  function afterScene() {\\n    const order = storyOrder();\\n    const i = order.indexOf(model.opId);\\n    if (model.flow === 'story' && i >= 0 && i < order.length - 1) openOpStory(i + 1);\\n    else if (model.flow === 'story') openCredits();\\n    else setScreen('Main Menu');\\n  }\\n\\n  function recordResult() {\\n    if (model.attract.on || model.mode === 'session' || !model.sim || !model.opId) return;\\n    if (model.sim.rank?.id) model.save.ranks[model.opId] = model.sim.rank.id;\\n    if (model.flow === 'story' && model.sim.complete) {\\n      if (!model.save.cleared.includes(model.opId)) model.save.cleared.push(model.opId);\\n      const i = storyOrder().indexOf(model.opId);\\n      if (i >= 0) model.save.storyPos = Math.max(model.save.storyPos || 0, i + 1);\\n    }\\n    persist();\\n  }\\n\\n  function freeSim() {\\n    try { model.sim?.physics?.free?.(); } catch { /* world already freed */ }\\n    model.sim = null;\\n  }\\n\\n  function startOperation(opId, extra = {}) {\\n    model.opId = opId;\\n    model.resultShown = false;\\n    const op = getOp(opId);\\n    const players = extra.players || 1;\\n    const build = (physics) => {\\n      freeSim();\\n      model.sim = new Sim({\\n        op: opId,\\n        seed: extra.seed ?? 1,\\n        physics,\\n        tuning: model.tuning,\\n        difficulty: model.settings.difficulty || 'resident',\\n        consult: op.consult ? (model.consultChoice || 'careful') : null,\\n        players,\\n        couch: !!extra.couch,\\n        notes: !!extra.notes,\\n      });\\n      if (extra.couch) {\\n        for (let i = 0; i < model.sim.seats.length; i++) {\\n          if (!model.joined.has(model.sim.seats[i].id)) model.sim.leave(model.sim.seats[i].id);\\n        }\\n      }\\n      model.overlay = null;\\n      setScreen('Operation');\\n    };\\n    if (model.test || extra.physics === false) {\\n      build(false);\\n      return;\\n    }\\n    void (async () => {\\n      let physics = false;\\n      try { await physicsReady(); physics = true; } catch { physics = false; }\\n      if (model.mode === 'session') return;\\n      build(physics);\\n    })();\\n  }\\n\\n  function mountAttract(opId) {\\n    freeSim();\\n    model.sim = new Sim({\\n      op: opId,\\n      seed: 1,\\n      physics: false,\\n      tuning: model.tuning,\\n      difficulty: 'resident',\\n      players: 1,\\n      cheats: { lockVitals: true, freezeTimer: true, infiniteComposure: true, infiniteClamps: true },\\n    });\\n    model.opId = opId;\\n    model.botOn = true;\\n    model.botOpts = {};\\n    model.view?.showOr?.();\\n    syncMusic();\\n  }\\n\\n  function startAttract() {\\n    const order = storyOrder();\\n    model.attract = { on: true, from: model.screen, opIndex: 0, opT: performance.now() };\\n    mountAttract(order[0]);\\n    paint(true);\\n  }\\n\\n  function exitAttract() {\\n    if (!model.attract.on) return;\\n    model.attract.on = false;\\n    model.botOn = false;\\n    model.botOpts = {};\\n    freeSim();\\n    model.opId = null;\\n    model.pending = {};\\n    model.lastInput = performance.now();\\n    syncMusic();\\n    paint(true);\\n  }\\n\\n  function nextAttractOp() {\\n    const order = storyOrder();\\n    model.attract.opIndex = (model.attract.opIndex + 1) % order.length;\\n    model.attract.opT = performance.now();\\n    mountAttract(order[model.attract.opIndex]);\\n    paint(true);\\n  }\\n\\n  function checkAttract() {\\n    if (model.mode === 'session') return;\\n    const idle = model.screen === 'Title' || model.screen === 'Main Menu' || model.screen === 'Free Play' || model.screen === 'Touch notice';\\n    if (!model.attract.on) {\\n      if (model.overlay || !idle) return;\\n      if (performance.now() - model.lastInput >= 10000) startAttract();\\n      return;\\n    }\\n    if (performance.now() - model.attract.opT >= 2000) nextAttractOp();\\n  }\\n\\n  function joinSeat(index) {\\n    model.joined.add(index);\\n    paint(true);\\n  }\\n\\n  function startCouch() {\\n    if (model.joined.size === 0) {\\n      joinSeat(0);\\n      return;\\n    }\\n    model.flow = 'couch';\\n    const players = [0, 1, 2, 3].map((i) => ({ id: i, name: `Seat ${i + 1}`, color: COLORS[i] }));\\n    startOperation('grand-rounds', { couch: true, players });\\n  }\\n\\n  function activate(id) {\\n    if (!id) return;\\n    if (id === 'nogfx-ok') {\\n      model.nogfxNotice = false;\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'start') {\\n      setScreen('Main Menu');\\n      return;\\n    }\\n    if (id === 'story') {\\n      if (model.save.intro || (model.save.storyPos || 0) > 0 || model.save.cleared?.length) {\\n        model.overlay = 'chooser';\\n        model.focus = 0;\\n        paint(true);\\n      } else openAsk();\\n      return;\\n    }\\n    if (id === 'continue') {\\n      model.overlay = null;\\n      model.flow = 'story';\\n      if (!model.save.intro) openScene('S0', afterIntro);\\n      else openOpStory(model.save.storyPos || 0);\\n      return;\\n    }\\n    if (id === 'new') {\\n      beginNew();\\n      return;\\n    }\\n    if (id === 'free') {\\n      model.flow = 'free';\\n      setScreen('Free Play');\\n      return;\\n    }\\n    if (id === 'rounds') {\\n      model.joined = new Set();\\n      setScreen('Lobby');\\n      return;\\n    }\\n    if (id === 'settings') {\\n      openSettings();\\n      return;\\n    }\\n    if (id === 'about') {\\n      model.page = 0;\\n      setScreen('About');\\n      return;\\n    }\\n    if (id === 'intern' || id === 'resident' || id === 'attending') {\\n      confirmDifficulty(id);\\n      return;\\n    }\\n    if (id === 'advance') {\\n      advanceLine();\\n      return;\\n    }\\n    if (id === 'careful' || id === 'aggressive') {\\n      model.consultChoice = id;\\n      model.focus = chartItems().length - 1;\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'begin' && model.screen === 'Chart') {\\n      model.flow = model.flow === 'free' ? 'free' : 'story';\\n      startOperation(model.opId);\\n      return;\\n    }\\n    if (id === 'begin' && model.screen === 'Lobby') {\\n      startCouch();\\n      return;\\n    }\\n    if (id.startsWith('seat:')) {\\n      joinSeat(Number(id.slice(5)));\\n      return;\\n    }\\n    if (id.startsWith('play:')) {\\n      model.flow = 'free';\\n      openChart(id.slice(5));\\n      return;\\n    }\\n    if (id === 'doctor') {\\n      model.doctor = model.doctor === 'ines' ? 'ren' : 'ines';\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'report-next') {\\n      continueReport();\\n      return;\\n    }\\n    if (id === 'credits-skip' || id === 'skip-scene') {\\n      if (model.screen === 'Credits roll' || id === 'credits-skip') setScreen('Main Menu');\\n      else finishScene();\\n      return;\\n    }\\n    if (id === 'resume') {\\n      model.overlay = null;\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'retry') {\\n      if (model.sim && !model.sim.over) model.sim.retryPhase();\\n      else model.sim?.retryPhase?.();\\n      model.resultShown = false;\\n      model.overlay = null;\\n      setScreen('Operation');\\n      return;\\n    }\\n    if (id === 'restart') {\\n      const flow = model.flow;\\n      startOperation(model.opId, { couch: flow === 'couch', players: flow === 'couch' ? [0, 1, 2, 3].map((i) => ({ id: i, name: `Seat ${i + 1}`, color: COLORS[i] })) : 1 });\\n      return;\\n    }\\n    if (id === 'notes') {\\n      try { model.sim?.acceptNotes?.(); } catch { /* notes stay offered */ }\\n      model.resultShown = false;\\n      model.overlay = null;\\n      setScreen('Operation');\\n      return;\\n    }\\n    if (id === 'quit') {\\n      model.overlay = null;\\n      freeSim();\\n      setScreen('Main Menu');\\n      return;\\n    }\\n    if (id === 'dev') {\\n      if (model.mode === 'session') return;\\n      setOverlay('dev');\\n      return;\\n    }\\n    if (id === 'back-settings' || id === 'back') {\\n      closeSettings();\\n      return;\\n    }\\n    if (id.startsWith('about:')) {\\n      model.page = Number(id.slice(6)) || 0;\\n      model.focus = model.page;\\n      paint(true);\\n      return;\\n    }\\n    if (id.startsWith('site:')) {\\n      const sim = model.sim;\\n      if (!sim) return;\\n      const idx = sim.op.sites.findIndex((s) => s.id === id.slice(5));\\n      if (idx >= 0) sim.setSite(sim.seats[0], idx);\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'glyphs') {\\n      model.settings.glyphs = model.settings.glyphs === 'xbox' ? 'playstation' : 'xbox';\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'rumble' || id === 'swapSticks' || id === 'shake' || id === 'boil') {\\n      model.settings[id] = !model.settings[id];\\n      if (id === 'boil') model.view?.setBoil?.(!!model.settings.boil);\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'fullscreen') {\\n      model.settings.fullscreen = !model.settings.fullscreen;\\n      const node = document.documentElement;\\n      if (model.settings.fullscreen) node.requestFullscreen?.().catch(() => {});\\n      else document.exitFullscreen?.().catch(() => {});\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'textSpeed') {\\n      model.settings.textSpeed = model.settings.textSpeed >= 4 ? 1 : model.settings.textSpeed * 2;\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (DEV_IDS.includes(id) || id === 'reset-page' || id === 'reset-all' || id === 'jump') {\\n      const page = devPages()[model.page] || [];\\n      const found = page.find((item) => item.id === id);\\n      runDev(model, id, found?.keys);\\n      return;\\n    }\\n  }\\n\\n  function openSettings() {\\n    if (model.mode === 'session') {\\n      model.sessionPause = true;\\n      paint(true);\\n      return;\\n    }\\n    model.returnTo = { screen: model.screen, overlay: model.overlay };\\n    model.page = 0;\\n    setScreen('Settings');\\n  }\\n\\n  function closeSettings() {\\n    if (model.mode === 'session') {\\n      model.sessionPause = false;\\n      paint(true);\\n      return;\\n    }\\n    const ret = model.returnTo;\\n    model.returnTo = null;\\n    if (!ret) {\\n      setScreen('Main Menu');\\n      return;\\n    }\\n    setScreen(ret.screen);\\n    if (ret.overlay) setOverlay(ret.overlay);\\n  }\\n  model.applySettings = (sample) => {\\n    const menu = sample?.menu || {};\\n    if (menu.pageLeft) turnPage(-1);\\n    else if (menu.pageRight) turnPage(1);\\n    else if (menu.up) moveFocus(-1);\\n    else if (menu.down) moveFocus(1);\\n    else if (menu.left) nudge(-1);\\n    else if (menu.right) nudge(1);\\n    else if (menu.confirm) {\\n      const item = currentItems()[model.focus];\\n      if (item) activate(item.id);\\n    }\\n  };\\n\\n  function moveFocus(dir) {\\n    const items = currentItems();\\n    if (!items.length) return;\\n    model.focus = (model.focus + dir + items.length) % items.length;\\n    if (model.screen === 'About' && !model.overlay) model.page = model.focus;\\n    paint(true);\\n  }\\n\\n  function turnPage(dir) {\\n    const n = pageCount();\\n    if (n <= 1) return false;\\n    model.page = (model.page + dir + n) % n;\\n    model.focus = model.screen === 'About' ? model.page : 0;\\n    paint(true);\\n    return true;\\n  }\\n\\n  function nudge(dir) {\\n    if (model.screen === 'Chart' && !model.overlay) {\\n      const order = ['intern', 'resident', 'attending'];\\n      const i = Math.max(0, order.indexOf(model.settings.difficulty || 'resident'));\\n      model.settings.difficulty = order[(i + (dir < 0 ? 2 : 1)) % 3];\\n      model.save.difficulty = model.settings.difficulty;\\n      persist();\\n      paint(true);\\n      return true;\\n    }\\n    const item = currentItems()[model.focus];\\n    if (!item) return false;\\n    if (item.kind === 'slider') {\\n      const cur = item.id in TUNING_DEFAULTS ? model.tuning[item.id] : (model.settings[item.id] ?? item.min);\\n      const step = item.step || 0.05;\\n      const v = Math.max(item.min, Math.min(item.max, Math.round((cur + dir * step) * 1000) / 1000));\\n      writeSetting(item.id, v);\\n      paint(true);\\n      return true;\\n    }\\n    if (item.kind === 'toggle' || item.kind === 'cycle' || item.id === 'glyphs' || item.id === 'textSpeed') {\\n      activate(item.id);\\n      return true;\\n    }\\n    return false;\\n  }\\n\\n  function prepFrame(id, frame) {\\n    const next = { ...(frame || {}) };\\n    if (model.pendingTool && (id === 0 || id === model.sim?.seats?.[0]?.id)) {\\n      next.tool = model.pendingTool;\\n      model.pendingTool = null;\\n    }\\n    const prev = model.siteHold.get(id) || 0;\\n    if (next.siteDelta && next.siteDelta === prev) next.siteDelta = 0;\\n    model.siteHold.set(id, frame?.siteDelta || 0);\\n    return next;\\n  }\\n\\n  function feedSim(sample) {\\n    const sim = model.sim;\\n    if (!sim || sim.over) return;\\n    const playing = model.attract.on || (model.screen === 'Operation' && !model.overlay && !model.sessionPause);\\n    if (!playing) return;\\n    if (model.botOn) {\\n      for (const seat of sim.seats) {\\n        if (seat.out) continue;\\n        sim.input(seat.id, prepFrame(seat.id, botInput(sim, seat, model.botOpts || {})));\\n      }\\n    } else if (model.flow === 'couch') {\\n      for (const s of sample.seats) {\\n        if (!model.joined.has(s.index)) continue;\\n        const seat = sim.seats.find((x) => x.id === s.index);\\n        if (seat && !seat.out) sim.input(seat.id, prepFrame(seat.id, s.frame));\\n      }\\n    } else {\\n      const s0 = sample.seats.find((s) => s.index === 0);\\n      const seat = sim.seats[0];\\n      if (s0 && seat) sim.input(seat.id, prepFrame(seat.id, s0.frame));\\n    }\\n    if (model.override && sim.seats[0]) {\\n      sim.input(sim.seats[0].id, prepFrame(sim.seats[0].id, model.override));\\n    }\\n    sim.step();\\n    for (const ev of sim.events || []) playEvent(ev);\\n    if (model.attract.on && sim.over) nextAttractOp();\\n    else if (!model.attract.on && sim.over && !model.resultShown) {\\n      model.resultShown = true;\\n      if (sim.complete) setScreen('Report');\\n      else setScreen('Fail');\\n    }\\n  }\\n\\n  function realInput(sample, menu, pend) {\\n    if (Object.values(menu).some(Boolean) || Object.values(pend).some(Boolean)) return true;\\n    return sample.seats.some((s) => {\\n      if (s.edges && Object.values(s.edges).some(Boolean)) return true;\\n      const f = s.frame;\\n      return f && (Math.hypot(f.x || 0, f.y || 0) > 0.2 || (f.use || 0) > 0.2);\\n    });\\n  }\\n\\n  let busy = false;\\n  function stepOnce() {\\n    if (busy || model.mode === 'session') return;\\n    busy = true;\\n    try {\\n      const sample = model.input.poll();\\n      const pend = model.pending;\\n      model.pending = {};\\n      const menu = { ...sample.menu };\\n      for (const k of Object.keys(pend)) if (pend[k]) menu[k] = true;\\n      model.input.takeClick();\\n      if (realInput(sample, menu, pend)) model.lastInput = performance.now();\\n      if (model.attract.on && (realInput(sample, menu, pend) || sample.hover)) {\\n        model.ignoreUntil = performance.now() + 350;\\n        exitAttract();\\n        return;\\n      }\\n      if (performance.now() < model.ignoreUntil && (menu.confirm || menu.back || pend.confirm)) return;\\n      if (model.screen === 'Touch notice' && (pend.leaveTouch || sample.seenPad || model.input.seenPad)) {\\n        if (pend.leaveTouch || sample.seats.some((s) => s.edges && Object.values(s.edges).some(Boolean))) {\\n          setScreen('Title');\\n          return;\\n        }\\n      }\\n      const padPause = sample.seats.some((s) => s.edges?.pause);\\n      const inPlay = model.screen === 'Operation' && !model.overlay;\\n      if ((pend.pause || padPause || (menu.back && model.screen === 'Story' && !model.overlay)) && model.mode !== 'session') {\\n        if (inPlay || model.screen === 'Story' || pend.pause || padPause) {\\n          setOverlay('pause');\\n          return;\\n        }\\n      }\\n      if (menu.back && model.overlay) {\\n        if (model.overlay === 'dev') setOverlay('pause');\\n        else if (model.screen === 'Settings') closeSettings();\\n        else {\\n          model.overlay = null;\\n          paint(true);\\n        }\\n        return;\\n      }\\n      feedSim(sample);\\n      if (model.screen === 'Lobby' && !model.overlay) {\\n        let joinedNow = false;\\n        for (const s of sample.seats) {\\n          if (s.edges?.confirm) {\\n            joinSeat(s.index);\\n            joinedNow = true;\\n          }\\n        }\\n        if (joinedNow && !menu.confirm && !pend.confirm) return;\\n      }\\n      if (model.screen === 'Story' && model.storyMode === 'lines' && !model.overlay) {\\n        if (menu.skip || pend.skip) {\\n          finishScene();\\n          return;\\n        }\\n        if (menu.confirm || pend.confirm) {\\n          model.hold = 0;\\n          advanceLine();\\n          return;\\n        }\\n        const speed = model.settings.textSpeed || 1;\\n        if (sample.held?.confirm) {\\n          model.hold += speed;\\n          if (model.hold >= 3) {\\n            model.hold = 0;\\n            advanceLine();\\n          }\\n        }\\n        return;\\n      }\\n      if (menu.pageLeft || pend.pageLeft) {\\n        if (turnPage(-1)) return;\\n      }\\n      if (menu.pageRight || pend.pageRight) {\\n        if (turnPage(1)) return;\\n      }\\n      if ((menu.left || pend.left) && nudge(-1)) return;\\n      if ((menu.right || pend.right) && nudge(1)) return;\\n      const padUp = sample.seats.some((s) => s.edges?.up);\\n      const padDown = sample.seats.some((s) => s.edges?.down);\\n      if (menu.up || pend.up || (padUp && !inPlay)) moveFocus(-1);\\n      else if (menu.down || pend.down || (padDown && !inPlay)) moveFocus(1);\\n      else if (inPlay && padDown) askBea();\\n      const padConfirm = sample.seats.some((s) => s.edges?.confirm);\\n      const confirm = menu.confirm || pend.confirm || (padConfirm && model.screen !== 'Operation');\\n      if (confirm && model.screen !== 'Operation') {\\n        const item = currentItems()[model.focus];\\n        if (item) activate(item.id);\\n      } else if ((menu.back || pend.back) && !inPlay) {\\n        if (model.screen === 'Settings') closeSettings();\\n        else if (model.screen !== 'Title' && model.screen !== 'Main Menu' && model.screen !== 'Touch notice') {\\n          const prev = model.stack.pop();\\n          setScreen(prev || 'Main Menu');\\n        }\\n      }\\n      tickAudio();\\n    } finally {\\n      busy = false;\\n    }\\n  }\\n\\n  function btn(item, index) {\\n    const on = index === model.focus ? ' on' : '';\\n    const pick = item.id === model.consultChoice ? ' pick' : '';\\n    const slider = item.kind === 'slider'\\n      ? `<input type=\\\"range\\\" data-slider=\\\"${esc(item.id)}\\\" min=\\\"${item.min}\\\" max=\\\"${item.max}\\\" step=\\\"${item.step || 0.01}\\\" value=\\\"${item.id in TUNING_DEFAULTS ? model.tuning[item.id] : (model.settings[item.id] ?? item.min)}\\\">`\\n      : '';\\n    return `<button class=\\\"item${on}${pick}\\\" data-item=\\\"${esc(item.id)}\\\" type=\\\"button\\\"><span data-readout=\\\"${esc(item.id)}\\\">${esc(item.label)}</span>${slider}</button>`;\\n  }\\n\\n  function menuBlock(title, items, extra = '') {\\n    model.focus = Math.max(0, Math.min(model.focus, Math.max(0, items.length - 1)));\\n    return `<section class=\\\"screen\\\"><h1 class=\\\"logo\\\">${esc(title)}</h1>${extra}<div class=\\\"menu\\\">${items.map(btn).join('')}</div></section>`;\\n  }\\n\\n  function paint(force) {\\n    const ui = model.ui;\\n    if (!ui) return;\\n    const sig = [\\n      model.screen, model.overlay, model.storyMode, model.line, model.focus, model.page,\\n      model.attract.on ? model.attract.opIndex : '', model.sessionPause, model.countN,\\n      model.card ? `${model.card.left}:${(model.card.ready || []).join(',')}` : '',\\n      model.opId, model.sceneId, model.nogfxNotice, model.consultChoice, model.settings.difficulty,\\n      model.settings.glyphs, [...model.joined].join(','), model.sim?.phase?.id || '', model.sim?.over || '',\\n      model.bark?.text || '', model.flow, model.doctor || '',\\n    ].join('|');\\n    document.body.dataset.screen = model.attract.on ? (model.attract.from || model.screen) : model.screen;\\n    if (!force && sig === model.paintSig) {\\n      patchLive();\\n      return;\\n    }\\n    model.paintSig = sig;\\n    const boot = document.getElementById('boot');\\n    const app = document.getElementById('app');\\n    if (boot) boot.hidden = model.screen !== 'Boot';\\n    if (app) app.hidden = model.screen === 'Boot';\\n    if (model.nogfxNotice) {\\n      ui.innerHTML = `<section class=\\\"screen nogfx\\\"><p>This room cannot draw. A browser with graphics can open the chart. Your progress is still here.</p>${btn({ id: 'nogfx-ok', label: 'Continue' }, 0)}</section>`;\\n      return;\\n    }\\n    if (model.mode === 'session' && model.screen === 'Card') {\\n      paintCard(ui);\\n      return;\\n    }\\n    if (model.mode === 'session' && model.screen === 'Countdown') {\\n      ui.innerHTML = `<section class=\\\"screen\\\"><p class=\\\"big\\\">${esc(model.countN || '')}</p></section>`;\\n      return;\\n    }\\n    if (model.screen === 'Round over') {\\n      ui.innerHTML = '<section class=\\\"screen\\\"><h1 class=\\\"big\\\">Round over</h1><p class=\\\"note\\\">The table is clear.</p></section>';\\n      return;\\n    }\\n    if (model.attract.on) {\\n      ui.innerHTML = `${hudHtml()}<p class=\\\"demo\\\">DEMO</p><p class=\\\"press\\\">Press any button</p>${model.attract.from === 'Touch notice' ? touchHtml() : ''}`;\\n      return;\\n    }\\n    if (model.sessionPause) {\\n      ui.innerHTML = `${hudHtml()}<div class=\\\"overlay\\\">${menuBlock('Settings', settingsItems(), pageDots())}</div>`;\\n      return;\\n    }\\n    if (model.overlay === 'pause') {\\n      ui.innerHTML = `<div class=\\\"overlay\\\">${menuBlock('Paused', pauseItems())}</div>`;\\n      return;\\n    }\\n    if (model.overlay === 'dev') {\\n      ui.innerHTML = `<div class=\\\"overlay\\\">${menuBlock('Dev', devItems(), pageDots())}</div>`;\\n      return;\\n    }\\n    if (model.overlay === 'chooser') {\\n      ui.innerHTML = menuBlock(GAME_TITLE, currentItems(), '<p class=\\\"tag\\\">The chart is already open.</p>');\\n      return;\\n    }\\n    if (model.screen === 'Title') {\\n      ui.innerHTML = `<section class=\\\"screen\\\"><h1 class=\\\"logo\\\" id=\\\"title\\\"></h1><p class=\\\"tag\\\" id=\\\"tagline\\\"></p><div class=\\\"ecg-line\\\"></div><div class=\\\"menu\\\">${btn({ id: 'start', label: 'Press any button' }, 0)}</div></section>`;\\n      ui.querySelector('#title').textContent = GAME_TITLE;\\n      ui.querySelector('#tagline').textContent = TAGLINE;\\n      return;\\n    }\\n    if (model.screen === 'Touch notice') {\\n      ui.innerHTML = touchHtml();\\n      return;\\n    }\\n    if (model.screen === 'Main Menu') {\\n      ui.innerHTML = menuBlock(GAME_TITLE, currentItems());\\n      const h = ui.querySelector('.logo');\\n      if (h) h.textContent = GAME_TITLE;\\n      return;\\n    }\\n    if (model.screen === 'Story' && model.storyMode === 'ask') {\\n      ui.innerHTML = `<section class=\\\"screen\\\"><p class=\\\"obj\\\">How much do you hate yourself, child?</p><div class=\\\"menu\\\">${currentItems().map(btn).join('')}</div></section>`;\\n      return;\\n    }\\n    if (model.screen === 'Story' && model.storyMode === 'lines') {\\n      const line = model.scene?.lines?.[model.line];\\n      const who = castOf(line?.who || 'narration');\\n      ui.innerHTML = `<section class=\\\"screen\\\"><p class=\\\"where\\\">${esc(model.scene?.where || '')}</p><div class=\\\"dialogue${line?.shout ? ' shout' : ''}\\\" data-item=\\\"advance\\\"><p class=\\\"who\\\">${esc(who.name)}</p><p>${esc(line?.text || '')}</p></div><div class=\\\"menu\\\">${btn({ id: 'advance', label: 'Continue' }, 0)}</div></section>`;\\n      return;\\n    }\\n    if (model.screen === 'Chart') ui.innerHTML = chartHtml();\\n    else if (model.screen === 'Operation') ui.innerHTML = hudHtml();\\n    else if (model.screen === 'Report') ui.innerHTML = reportHtml();\\n    else if (model.screen === 'Fail') ui.innerHTML = failHtml();\\n    else if (model.screen === 'Free Play') ui.innerHTML = menuBlock('Chart Board', freeItems(), `<p class=\\\"note\\\">${esc(DIFFICULTY[model.settings.difficulty]?.label || 'Resident')}</p>${pageDots()}`);\\n    else if (model.screen === 'Lobby') ui.innerHTML = lobbyHtml();\\n    else if (model.screen === 'Settings') ui.innerHTML = menuBlock('Settings', settingsItems(), pageDots());\\n    else if (model.screen === 'About') ui.innerHTML = aboutHtml();\\n    else if (model.screen === 'Credits roll') ui.innerHTML = `<section class=\\\"screen\\\"><h1 class=\\\"big\\\">Credits</h1><p class=\\\"note\\\">The lamp stays on.</p><div class=\\\"menu\\\">${btn({ id: 'credits-skip', label: 'Skip' }, 0)}</div></section>`;\\n    else ui.innerHTML = '<section class=\\\"screen\\\"><p class=\\\"note\\\">Scrubbing in…</p></section>';\\n  }\\n  model.paint = () => paint(false);\\n\\n  function patchLive() {\\n    const st = liveState();\\n    const set = (sel, text) => {\\n      const node = model.ui.querySelector(sel);\\n      if (node) node.textContent = text;\\n    };\\n    if (st) {\\n      set('[data-live=\\\"vitals\\\"]', st.vitals == null ? '' : String(Math.round(st.vitals)));\\n      set('[data-live=\\\"timer\\\"]', st.timer == null ? '' : clock(st.timer));\\n      set('[data-live=\\\"score\\\"]', st.score == null ? '' : String(st.score));\\n      set('[data-live=\\\"bpm\\\"]', st.bpm == null ? '' : String(Math.round(st.bpm)));\\n      const tool = st.tool;\\n      model.ui.querySelectorAll('[data-tool]').forEach((b) => b.classList.toggle('on', b.dataset.tool === tool));\\n    }\\n  }\\n\\n  function liveState() {\\n    if (model.sim) {\\n      return {\\n        vitals: model.sim.vitals,\\n        timer: model.sim.noTimer ? null : model.sim.timer,\\n        score: model.sim.score,\\n        bpm: model.sim.beat?.bpm,\\n        tool: model.sim.seats[0]?.tool,\\n      };\\n    }\\n    return null;\\n  }\\n\\n  function touchHtml() {\\n    return `<section class=\\\"screen\\\"><p class=\\\"touch-copy\\\">Controller or keyboard required</p><div class=\\\"menu\\\">${btn({ id: 'settings', label: 'Settings' }, model.focus)}</div></section>`;\\n  }\\n\\n  function pageDots() {\\n    const n = pageCount();\\n    if (n <= 1) return '';\\n    return `<p class=\\\"pages\\\">Page ${model.page + 1} / ${n}</p>`;\\n  }\\n\\n  function hudHtml() {\\n    const sim = model.sim;\\n    const op = sim?.op || safeOp(model.opId);\\n    const objective = sim?.objective || sim?.phase?.objective || '';\\n    const seats = sim?.seats || [];\\n    const seat = seats[0];\\n    const tools = (sim?.phase?.tools || []).join(' ');\\n    const sites = op?.sites || [];\\n    const siteBits = sites.length > 1 ? sites.map((s) => `<button type=\\\"button\\\" data-item=\\\"site:${esc(s.id)}\\\" class=\\\"item${s.id === sim?.activeSite ? ' on' : ''}\\\">${esc(s.organ || s.id)}</button>`).join('') : '';\\n    const wheel = WHEEL.map((tool) => `<button type=\\\"button\\\" data-tool=\\\"${tool}\\\" class=\\\"${seat?.tool === tool ? 'on' : ''}\\\">${esc(tool)}</button>`).join('');\\n    const prompt = fillPrompt('{special} gift   {syringe} stabilizer   {pause} pause', model.input?.promptSet || 'keyboard');\\n    const bark = model.bark ? `<div class=\\\"bark\\\"><p class=\\\"who\\\">${esc(castOf(model.bark.who).name)}</p><p>${esc(model.bark.text)}</p></div>` : '';\\n    return `<div class=\\\"hud\\\"><div class=\\\"hud-top\\\"><p class=\\\"obj\\\">${esc(objective)}</p><div><p class=\\\"vitals\\\" data-live=\\\"vitals\\\">${sim ? Math.round(sim.vitals) : ''}</p><div class=\\\"ecg-line\\\" id=\\\"ecg\\\"></div><p class=\\\"timer\\\" data-live=\\\"bpm\\\">${sim ? Math.round(sim.beat.bpm) : ''}</p></div><div><p class=\\\"timer\\\" data-live=\\\"timer\\\">${sim && !sim.noTimer ? clock(sim.timer) : ''}</p><p class=\\\"score\\\" data-live=\\\"score\\\">${sim ? sim.score : ''}</p></div></div><div></div><div class=\\\"hud-bot\\\"><div class=\\\"wheel\\\">${wheel}</div><div>${bark}<p class=\\\"note\\\">${esc(tools)}</p><div class=\\\"pages\\\">${siteBits}</div></div><div class=\\\"note\\\">${prompt}</div></div></div>`;\\n  }\\n\\n  function chartHtml() {\\n    const op = safeOp(model.opId);\\n    const p = op?.patient || {};\\n    const diff = DIFFICULTY[model.settings.difficulty]?.label || 'Resident';\\n    const items = chartItems();\\n    return `<section class=\\\"screen\\\"><p class=\\\"who\\\">${esc(op?.title || '')}</p><h1 class=\\\"big\\\">${esc(p.name || '')}</h1><p class=\\\"note\\\">${esc(p.age || '')} · ${esc(p.job || '')}</p><p class=\\\"obj\\\">${esc(p.note || '')}</p><p class=\\\"note\\\">Difficulty ${esc(diff)}. Left and right change it.</p><div class=\\\"menu\\\">${items.map(btn).join('')}</div></section>`;\\n  }\\n\\n  function reportHtml() {\\n    const sim = model.sim;\\n    const op = safeOp(model.opId);\\n    const rank = sim?.rank;\\n    const accuracy = sim?.seats?.[0]?.stats?.Accuracy ?? 100;\\n    const seats = (sim?.seats || []).filter((s) => !s.out).map((s) => `<p class=\\\"note\\\">${esc(s.name)} ${s.score}</p>`).join('');\\n    return `<section class=\\\"screen\\\"><p class=\\\"big\\\">${esc(rank?.id || '')}</p><p class=\\\"obj\\\">${esc(rank?.title || sim?.report?.text || '')}</p><div class=\\\"row\\\"><span>Time</span><span>${esc(clock(sim?.time || 0))}</span></div><div class=\\\"row\\\"><span>Vitals</span><span>${esc(Math.round(sim?.vitalsMin ?? sim?.vitals ?? 0))}</span></div><div class=\\\"row\\\"><span>Precision</span><span>${esc(accuracy)}</span></div><div class=\\\"row\\\"><span>Best Combo</span><span>${esc(sim?.bestCombo || 0)}</span></div><p class=\\\"note\\\">${esc(op?.patient?.followUp || '')}</p>${seats}<div class=\\\"menu\\\">${btn({ id: 'report-next', label: 'Continue' }, 0)}</div></section>`;\\n  }\\n\\n  function failHtml() {\\n    const reason = FAIL_TITLE[model.sim?.failed] || 'FLATLINE';\\n    const line = barkText('fail', null, 0);\\n    return `<section class=\\\"screen\\\"><h1 class=\\\"fail-title\\\">${esc(reason)}</h1><div class=\\\"bark\\\"><p class=\\\"who\\\">Bea</p><p>${esc(line)}</p></div><div class=\\\"menu\\\">${failItems().map(btn).join('')}</div></section>`;\\n  }\\n\\n  function lobbyHtml() {\\n    const items = lobbyItems();\\n    const prompt = fillPrompt('Press {confirm} to join', model.input?.promptSet || 'keyboard');\\n    return `<section class=\\\"screen\\\"><h1 class=\\\"big\\\">Grand Rounds</h1><p class=\\\"note\\\">${prompt}</p><div class=\\\"seats\\\">${[0, 1, 2, 3].map((i) => `<div class=\\\"seat\\\" style=\\\"color:${COLORS[i]}\\\">${model.joined.has(i) ? 'In' : 'Open'}</div>`).join('')}</div><div class=\\\"menu\\\">${items.map(btn).join('')}</div></section>`;\\n  }\\n\\n  function aboutHtml() {\\n    const data = aboutData();\\n    const page = Math.min(model.page, ABOUT_HEADS.length - 1);\\n    const [key, label] = ABOUT_HEADS[page];\\n    const tabs = ABOUT_HEADS.map(([, name], i) => btn({ id: `about:${i}`, label: name }, i)).join('');\\n    let body = '';\\n    const block = data[key];\\n    if (block && !Array.isArray(block) && typeof block === 'object') {\\n      body = Object.entries(block).map(([k, v]) => `<p class=\\\"about-line\\\">${esc(k)}: ${esc(v)}</p>`).join('');\\n    } else if (Array.isArray(block)) {\\n      body = block.map((line) => `<p class=\\\"about-line\\\">${esc(line)}</p>`).join('');\\n    }\\n    if (key === 'credits') {\\n      const lines = Array.isArray(data.credits) ? data.credits : [];\\n      body = lines.map((line) => `<p class=\\\"about-line\\\">${esc(line)}</p>`).join('');\\n      body += `<p class=\\\"about-line\\\">Renderer: ${esc(model.view?.backend || 'none')}</p>`;\\n    }\\n    return `<section class=\\\"screen\\\"><div class=\\\"tabs\\\">${tabs}</div><h1 class=\\\"obj\\\">${esc(label)}</h1><div class=\\\"page on\\\">${body}</div></section>`;\\n  }\\n\\n  function paintCard(ui) {\\n    ui.replaceChildren();\\n    const wrap = document.createElement('section');\\n    wrap.className = 'screen card';\\n    const h = document.createElement('h1');\\n    h.className = 'logo';\\n    h.textContent = GAME_TITLE;\\n    const tag = document.createElement('p');\\n    tag.className = 'tag';\\n    tag.textContent = TAGLINE;\\n    const goal = document.createElement('p');\\n    goal.className = 'obj';\\n    goal.textContent = 'Keep the patient alive and finish the operation together';\\n    const list = document.createElement('div');\\n    list.className = 'seats';\\n    const ready = new Set(model.card?.ready || []);\\n    for (const p of model.sessionInfo?.players || []) {\\n      const seat = document.createElement('div');\\n      seat.className = 'seat';\\n      if (/^#[0-9a-fA-F]{3,8}$/.test(p.color || '')) seat.style.color = p.color;\\n      seat.textContent = `${p.name || 'Surgeon'}${ready.has(p.id) ? ' ready' : ''}`;\\n      list.append(seat);\\n    }\\n    const secs = document.createElement('p');\\n    secs.className = 'vitals';\\n    if (model.card?.left != null) secs.textContent = String(Math.max(0, Math.ceil(model.card.left)));\\n    const how = document.createElement('p');\\n    how.className = 'note';\\n    how.textContent = 'Aim with the right stick or the mouse. Use with R2 or click. Tools are the left stick or the number keys.';\\n    const menu = document.createElement('div');\\n    menu.className = 'menu';\\n    for (const item of [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More Time' }]) {\\n      const b = document.createElement('button');\\n      b.type = 'button';\\n      b.className = 'item';\\n      b.dataset.item = item.id;\\n      b.textContent = item.label;\\n      menu.append(b);\\n    }\\n    wrap.append(h, tag, goal, list, secs, how, menu);\\n    ui.append(wrap);\\n  }\\n\\n  function state() {\\n    const sim = model.sim;\\n    const net = !sim ? model.netState : null;\\n    const seats = sim?.seats || net?.seats || [];\\n    const seat = seats.find((s) => !s.out) || seats[0];\\n    const items = currentItems();\\n    const rank = sim?.rank?.id || (typeof net?.rank === 'string' ? net.rank : net?.rank?.id) || null;\\n    return {\\n      screen: model.screen,\\n      op: sim?.op?.id || net?.op || null,\\n      phase: sim?.phase?.id || net?.phase || null,\\n      vitals: sim ? sim.vitals : (net?.vitals ?? null),\\n      timer: sim ? sim.timer : (net?.timer ?? null),\\n      score: sim ? sim.score : (net?.score ?? 0),\\n      rank,\\n      bpm: sim ? sim.beat.bpm : (net?.bpm ?? null),\\n      beat: sim ? sim.beat.count : (net?.beat ?? 0),\\n      site: sim ? sim.activeSite : (net?.site ?? null),\\n      tool: seat?.tool || null,\\n      tips: seats.map((s) => ({ id: s.id, x: s.x, y: s.y, tool: s.tool, score: s.score || 0 })),\\n      focusId: items[model.focus]?.id || null,\\n      promptSet: model.input?.promptSet || document.documentElement.dataset.promptSet || 'keyboard',\\n      glyphSet: model.settings.glyphs || 'playstation',\\n      attract: !!model.attract.on,\\n      devOpen: model.overlay === 'dev',\\n      renderBackend: model.view?.backend || 'none',\\n      musicGain: model.audio?.music?.gain?.value ?? 0.1,\\n      tuning: model.tuning,\\n      reached: [...model.reached],\\n    };\\n  }\\n\\n  const api = {\\n    state,\\n    audio,\\n    devRun(id, arg) { return runDev(model, id, arg); },\\n  };\\n  if (model.test) {\\n    api.test = {\\n      step(n) {\\n        const count = Math.max(0, n | 0);\\n        for (let i = 0; i < count; i++) stepOnce();\\n      },\\n      warp(n) { model.warp = n | 0; },\\n      input(frame) { model.override = frame || null; },\\n      bot(on, opts) {\\n        model.botOn = !!on;\\n        if (opts) model.botOpts = opts;\\n      },\\n      skipTo(op, phase) {\\n        model.flow = model.flow || 'free';\\n        model.opId = op;\\n        freeSim();\\n        model.sim = new Sim({\\n          op, seed: 1, physics: false, tuning: model.tuning,\\n          difficulty: model.settings.difficulty || 'resident', players: 1,\\n        });\\n        if (phase) model.sim.skipTo(phase);\\n        model.resultShown = false;\\n        model.overlay = null;\\n        setScreen('Operation');\\n      },\\n      hash() { return model.sim ? model.sim.hash() : ''; },\\n    };\\n  }\\n\\n  let raf = 0;\\n  let timer = 0;\\n  function draw() {\\n    if (model.mode === 'session' || !model.view || model.norender || model.painting) return;\\n    model.painting = true;\\n    try {\\n      if (model.sim && (model.attract.on || model.screen === 'Operation')) {\\n        model.view.showOr?.();\\n        model.view.sync(decorateState(model.sim.state), 1 / 60);\\n      } else if (model.screen === 'Story') present();\\n    } catch { /* draw again next frame */ }\\n    const drawn = model.view.render?.();\\n    if (drawn?.then) drawn.then(() => { model.painting = false; }, () => { model.painting = false; });\\n    else model.painting = false;\\n  }\\n\\n  function loop() {\\n    raf = requestAnimationFrame(loop);\\n    if (model.mode === 'session') return;\\n    checkAttract();\\n    if (model.test && !(model.warp > 0)) {\\n      /* scripted steps own the sim */\\n    } else {\\n      const n = model.warp > 0 ? model.warp : 1;\\n      for (let i = 0; i < n; i++) stepOnce();\\n    }\\n    draw();\\n  }\\n\\n  function wantsTouch() {\\n    const mq = window.matchMedia?.('(any-pointer: fine)');\\n    if (!mq) return false;\\n    return mq.matches === false && !model.input.seenPad;\\n  }\\n\\n  async function bootView() {\\n    if (!model.canvas) return;\\n    if (model.norender) {\\n      model.view = createPointerCamera(model.canvas);\\n      return;\\n    }\\n    const webgl = model.params.get('webgl') === '1';\\n    try {\\n      model.view = await createView(model.canvas, { webgl });\\n    } catch {\\n      try {\\n        model.view = await createView(model.canvas, { webgl: true });\\n      } catch {\\n        model.view = createPointerCamera(model.canvas);\\n        model.nogfxNotice = true;\\n        paint(true);\\n      }\\n    }\\n    if (model.settings.boil === false) model.view?.setBoil?.(false);\\n  }\\n\\n  return {\\n    api,\\n    startSession(info) {\\n      model.mode = 'session';\\n      model.sessionInfo = info;\\n      model.paint = () => paint(false);\\n      model.syncFromSim = syncFromSim;\\n      model.applySettings = model.applySettings;\\n      model.tickAudio = tickAudio;\\n      model.playEvent = playEvent;\\n      model.decorateState = decorateState;\\n      if (raf) cancelAnimationFrame(raf);\\n      if (timer) clearInterval(timer);\\n      runSession(model, info);\\n    },\\n    async startStandalone() {\\n      model.mode = 'standalone';\\n      model.lastInput = performance.now();\\n      if (wantsTouch()) setScreen('Touch notice');\\n      else setScreen('Title');\\n      try { document.body.focus(); } catch { /* focus is a courtesy */ }\\n      raf = requestAnimationFrame(loop);\\n      timer = setInterval(() => {\\n        if (model.mode === 'session') return;\\n        checkAttract();\\n        if (model.attract.on && model.test) {\\n          for (let i = 0; i < 4; i++) stepOnce();\\n        }\\n      }, 250);\\n      await bootView();\\n      present();\\n      draw();\\n    },\\n  };\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"f9e35a07-2831-42f2-9539-6ee4f59a2736"}
{"type":"assistant","message":{"id":"msg_574","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"A bug was found: `openScene` is assigned to `model.openScene` before the function is declared.\n\nFunction declarations are hoisted to the top of their scope. The assignment before the declaration is valid JavaScript.\n\n`startSession` contains a redundant `model.applySettings = model.applySettings` assignment. `setScreen` has a redundant page reset for the About screen. `menuBlock(GAME_TITLE)` injects the title into innerHTML via `esc(title)`.\n\nThe Main Menu title is set twice: once via innerHTML and again via textContent. This is harmless.\n\nA potential race condition exists where the lobby pad and keyboard could both confirm simultaneously to join and start the game in one step. The tests avoid this by triggering them separately.\n\n`stepOnce` correctly routes `menu.back` on the Story screen to the pause menu. Title confirm activates start without triggering pause or other conflicting logic. The first step on Title also correctly skips back navigation.\n\n`retryPhase` is called redundantly in the retry logic, but it is harmless. Restarting from pause correctly leaves couch players unjoined. The Chart screen sets flow to story, though this is not a concern for couch play.\n\n`recordResult` and `openOpStory` both update `storyPos`, but the final value is correct. If a player quits during an operation, the continue logic uses the chart index stored at the start of that operation.\n\nThe attract check inside `stepOnce` does not call `checkAttract`. The animation loop and requestAnimationFrame interval do.\n\nThe animation loop calls `checkAttract` even in test mode. The interval handles attract simulation steps, while `requestAnimationFrame` does not step the simulation during tests. Tests use `norender`, so the attract simulation will not render.\n\nThe interval and requestAnimationFrame attract checks will not collide. The first rotation resets the operation timer, so the second check sees the updated timestamp and skips.\n\nReal input during attract interval steps correctly does not exit the mode.\n\n`startStandalone` sets `lastInput` twice: once in `setScreen('Title')` and again before `setScreen`.\n\n`setScreen` does not reset `lastInput`, so the ten-second input timeout remains valid. The Title screen uses a custom paint routine that sets `textContent` directly, bypassing `menuBlock`. The Main Menu logo text is correctly targeted by `querySelector` on the `h1` element.\n\nHost sync correctly prevents double painting. `syncFromSim` sets `painting` to true and renders, so the next pump skips while the render promise is pending.\n\n`feedSim` calls `setScreen` when a simulation ends, which triggers a paint. During the same step, `stepOnce` continues to menu handling on the newly painted screen. If the user is holding confirm, this could accidentally activate the new screen's Continue button. Bot playthroughs avoid this because they use `test.step` instead of held input. The fix is to return immediately after `feedSim` if `resultShown` just flipped.\n\nThe `activate()` call inside `stepOnce` must be followed by an immediate return. Otherwise the same confirm press could advance past the Story screen and trigger another menu action in the same step.\n\nThe generic confirm handler does not return after `activate`, but it only calls `activate` once per step. Story line checks run before the generic confirm logic, so a simulation that switches to Report will not trigger the new screen's Continue button in the same step.\n\nChart focus correctly defaults to the last item. Ask mode focus defaults to index 1. The About screen keeps its current page during setScreen.\n\nThe About screen handles page turns and focus changes without calling setScreen. The five about items are correctly mapped to the button array. Credits key duplication is harmless. Source fields contain apostrophes, but HTML text content does not require escaping them. The HUD prompt inserts SVG via innerHTML, which is safe because the markup is generated internally. The touch notice HTML is appended during attract mode in addition to the HUD.\n\nThe dev overlay contains the notice text and settings button. The controller-or-keyboard requirement is exact. Clicking the dev run button triggers runDev, which may set the Operation screen and clear the overlay. The reset-page command passes found.keys correctly. The dev slider uses kind slider items, and nudge checks item.kind before writing the setting.\n\nClicking a slider button directly does nothing, since those IDs are not in DEV_IDS. Clicking the range input activates the button ID but also fires the input event, which is safe. The input uses type button to prevent accidental form submission.\n\nThe card screen paints correctly because the pump runs synchronously at the end of startSession. Input listeners are already attached before runSession begins. The AIHub global guard prevents premature key presses from triggering answers, though a missing AIHub in unit tests would throw.\n\nThe director key handler references AIHub without a typeof guard, but the browser client script ensures it exists. Story activation from the menu does not re-enter the story handler. Hash navigation and skipTo work correctly. In test mode, requestAnimationFrame does not call stepOnce, so only test.step and the attract interval poll for input.","signature":""},{"type":"tool_use","id":"call-5965b7b4-184f-4862-8cbe-a9eab4f55684-57","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/sim.js","offset":630,"limit":40}},{"type":"tool_use","id":"call-5965b7b4-184f-4862-8cbe-a9eab4f55684-58","name":"grep","input":{"pattern":"TODO|FIXME|placeholder|stub|common time|Alive in Common","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":24382,"output_tokens":3057,"cache_read_input_tokens":147456,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"0965e858-2b3b-49f0-a608-13c514e60141"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-5965b7b4-184f-4862-8cbe-a9eab4f55684-57","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"630→    this.failed = null;\\n    if (!this.noRank) this.rank = rankFor(this.score, this.op.parScore || 1, this.rankCap);\\n    this.report = this.noRank ? { text: \\\"Tonight's patient survived.\\\" } : { rank: this.rank, followUp: this.op.patient?.followUp || '' };\\n    this.bark('success');\\n    this.events.push({ type: 'success', rank: this.rank, score: this.score });\\n    for (const s of this.seats) {\\n      s.stats.Accuracy = s.graded ? Math.round((100 * s.clean) / s.graded) : 100;\\n    }\\n  }\\n\\n640→  retryPhase() {\\n    if (!this.checkpoint) return;\\n    const c = this.checkpoint;\\n    this.over = false;\\n    this.failed = null;\\n    this.complete = false;\\n    this.vitals = Math.max(c.vitals, 60);\\n    this.timer = Math.max(c.timer, 90);\\n    this.score = c.score;\\n    this.phaseIndex = c.index;\\n650→    this.entities = this.entities.filter(() => false);\\n    this.arrest = null;\\n    this.lockFail = false;\\n    for (const s of this.seats) s.combo = 0;\\n    this.enterPhase();\\n    if (this.notes) this.timer *= 1.3;\\n  }\\n\\n  acceptNotes() {\\n    this.notes = true;\\n660→    this.rankCap = 'B';\\n    this.mods.drain *= 0.7;\\n    this.notesOffer = false;\\n    this.retryPhase();\\n  }\\n\\n  restart() {\\n    const tuning = this.tuning;\\n    const fresh = new Sim({\\n      op: this.op, tuning, difficulty: this.diff.id, rng: makeRng(this.rng.seed || 1),\",\"content_concise\":\"630→    this.failed = null;\\n    if (!this.noRank) this.rank = rankFor(this.score, this.op.parScore || 1, this.rankCap);\\n    this.report = this.noRank ? { text: \\\"Tonight's patient survived.\\\" } : { rank: this.rank, followUp: this.op.patient?.followUp || '' };\\n    this.bark('success');\\n    this.events.push({ type: 'success', rank: this.rank, score: this.score });\\n    for (const s of this.seats) {\\n      s.stats.Accuracy = s.graded ? Math.round((100 * s.clean) / s.graded) : 100;\\n    }\\n  }\\n\\n640→  retryPhase() {\\n    if (!this.checkpoint) return;\\n    const c = this.checkpoint;\\n    this.over = false;\\n    this.failed = null;\\n    this.complete = false;\\n    this.vitals = Math.max(c.vitals, 60);\\n    this.timer = Math.max(c.timer, 90);\\n    this.score = c.score;\\n    this.phaseIndex = c.index;\\n650→    this.entities = this.entities.filter(() => false);\\n    this.arrest = null;\\n    this.lockFail = false;\\n    for (const s of this.seats) s.combo = 0;\\n    this.enterPhase();\\n    if (this.notes) this.timer *= 1.3;\\n  }\\n\\n  acceptNotes() {\\n    this.notes = true;\\n660→    this.rankCap = 'B';\\n    this.mods.drain *= 0.7;\\n    this.notesOffer = false;\\n    this.retryPhase();\\n  }\\n\\n  restart() {\\n    const tuning = this.tuning;\\n    const fresh = new Sim({\\n      op: this.op, tuning, difficulty: this.diff.id, rng: makeRng(this.rng.seed || 1),\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/sim.js\",\"offset\":630,\"limit\":40,\"raw_output\":\"    this.failed = null;\\n    if (!this.noRank) this.rank = rankFor(this.score, this.op.parScore || 1, this.rankCap);\\n    this.report = this.noRank ? { text: \\\"Tonight's patient survived.\\\" } : { rank: this.rank, followUp: this.op.patient?.followUp || '' };\\n    this.bark('success');\\n    this.events.push({ type: 'success', rank: this.rank, score: this.score });\\n    for (const s of this.seats) {\\n      s.stats.Accuracy = s.graded ? Math.round((100 * s.clean) / s.graded) : 100;\\n    }\\n  }\\n\\n  retryPhase() {\\n    if (!this.checkpoint) return;\\n    const c = this.checkpoint;\\n    this.over = false;\\n    this.failed = null;\\n    this.complete = false;\\n    this.vitals = Math.max(c.vitals, 60);\\n    this.timer = Math.max(c.timer, 90);\\n    this.score = c.score;\\n    this.phaseIndex = c.index;\\n    this.entities = this.entities.filter(() => false);\\n    this.arrest = null;\\n    this.lockFail = false;\\n    for (const s of this.seats) s.combo = 0;\\n    this.enterPhase();\\n    if (this.notes) this.timer *= 1.3;\\n  }\\n\\n  acceptNotes() {\\n    this.notes = true;\\n    this.rankCap = 'B';\\n    this.mods.drain *= 0.7;\\n    this.notesOffer = false;\\n    this.retryPhase();\\n  }\\n\\n  restart() {\\n    const tuning = this.tuning;\\n    const fresh = new Sim({\\n      op: this.op, tuning, difficulty: this.diff.id, rng: makeRng(this.rng.seed || 1),\\n\",\"total_lines\":863}}","is_error":false},{"type":"tool_result","tool_use_id":"call-5965b7b4-184f-4862-8cbe-a9eab4f55684-58","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,51,49,50,51,48,95,95,120,56,102,52,57,98,54,47,119,111,114,107,34,62,10,78,111,32,109,97,116,99,104,101,115,32,102,111,117,110,100,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":1,\"match_count\":0,\"file_matches\":[]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"37292e5c-5b18-4d6a-bf4c-0cca7c1496b5"}
