er.on('message', (message) => {\\n      const item = worker.current;\\n      worker.current = null;\\n      busy = false;\\n      item.resolve(message);\\n      pump();\\n    });\\n    worker.on('error', (err) => {\\n      const item = worker.current;\\n      busy = false;\\n      worker.current = null;\\n      if (item) item.reject(err);\\n    });\\n    return {\\n      run(job) {\\n        return new Promise((resolve, reject) => {\\n          queue.push({ job, resolve, reject });\\n          pump();\\n        });\\n      },\\n      close() {\\n        return worker.terminate();\\n      },\\n    };\\n  });\\n  let cursor = 0;\\n  return {\\n    async run(jobs) {\\n      const out = new Array(jobs.length);\\n      async function take(slot) {\\n        while (cursor < jobs.length) {\\n          const index = cursor;\\n          cursor += 1;\\n          out[index] = { job: jobs[index], result: await slot.run(jobs[index]) };\\n        }\\n      }\\n      await Promise.all(workers.map((slot) => take(slot)));\\n      return out;\\n    },\\n    async close() {\\n      await Promise.all(workers.map((slot) => slot.close()));\\n    },\\n  };\\n}\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/run-all.mjs has been updated successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/run-all.mjs has been updated.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/run-all.mjs\",\"edits\":{\"details\":[{\"old_string\":\"function runJob(job) {\\n  return new Promise((resolve, reject) => {\\n    const worker = new Wo