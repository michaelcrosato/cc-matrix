12,101,100,41,32,123,10,60,47,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,62],\"stderr\":[],\"exit_code\":0,\"match_count\":21,\"file_matches\":[{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/tools.js\",\"matches\":[{\"line_number\":208,\"content\":\"  const clamp = nearestKind(sim, seat, 'bleeder', 0.12, (e) => e.clamped);\"},{\"line_number\":210,\"content\":\"    clamp.clamped = false;\"},{\"line_number\":679,\"content\":\"  const clamped = Math.max(0.3, Math.min(1, use));\"},{\"line_number\":696,\"content\":\"      sim.hurt(sim.tuning.laserBurn * clamped * dt, 'burn');\"},{\"line_number\":708,\"content\":\"  let dps = sim.tuning.laserDps * clamped * power;\"},{\"line_number\":776,\"content\":\"  const b = nearestKind(sim, seat, 'bleeder', 0.1, (e) => !e.clamped);\"},{\"line_number\":782,\"content\":\"  b.clamped = true;\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/bot.js\",\"matches\":[{\"line_number\":103,\"content\":\"    if (e.kind === 'bleeder' && !e.clamped) {\"},{\"line_number\":352,\"content\":\"  const bleeding = state.entities.some((e) => e.kind === 'bleeder' && !e.clamped);\"},{\"line_number\":373,\"content\":\"    const clamped = state.entities.find((e) => e.kind === 'bleeder' && e.clamped && !claims.has(e.id));\"},{\"line_number\":374,\"content\":\"    if (clamped) {\"},{\"line_number\":375,\"content\":\"      claims.add(clamped.id);\"},{\"line_number\":376,\"content\":\"      return unclamp(me, clamped, mem, tuning, opts, state);\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/sim.js\",\"matches\":[{\"line_number\":275,