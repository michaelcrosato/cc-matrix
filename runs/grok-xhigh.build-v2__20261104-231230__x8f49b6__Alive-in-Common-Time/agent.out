0-normal.woff2') format('woff2'); font-weight: 700; font-display: swap; }\\n\\nhtml { font-size: calc(100vh / 1080 * 16); }\\n* { box-sizing: border-box; }\\nhtml, body { margin: 0; height: 100%; overflow: hidden; background: #0B2529; color: #f4efe4; font-family: 'Barlow Condensed', sans-serif; }\\nbutton, input { font: inherit; color: inherit; }\\n#boot, #app { min-height: 100%; }\\n#boot { display: grid; place-items: center; background: #17707A; color: #f4efe4; font-size: 3rem; letter-spacing: 0.04em; }\\n#boot[hidden], #app[hidden] { display: none; }\\n#view { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\\n#ui { position: absolute; inset: 5vh 5vw; pointer-events: none; }\\n#ui button, #ui input, #ui [data-item] { pointer-events: auto; }\\n.screen { height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 1.2rem; }\\n.logo { font-family: 'Bangers', sans-serif; font-size: 6rem; line-height: 0.9; margin: 0; text-shadow: 0 0.08em #0B2529; }\\n.tag { font-size: 2.4rem; margin: 0; }\\n.press { font-size: 2.2rem; animation: pulse 1.2s ease-in-out infinite; }\\n@keyframes pulse { 50% { opacity: 0.45; } }\\n.menu { display: flex; flex-direction: column; gap: 0.6rem; max-width: 36rem; }\\n.item, button.item { background: transparent; border: 0.2rem solid transparent; border-radius: 0.6rem; text-align: left; padding: 0.55rem 1rem; font-size: 2.6rem; font-weight: 600; cursor: pointer; }\\n.item.on, button.item.on { border-color: #f4efe4; background: rgba(23, 112, 122, 0.55); }\\n.hud { position: absolute; inset: 0; display: grid; grid-template-rows: auto 1fr auto; pointer-events: none; }\\n.hud-top, .hud-bot { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }\\n.hud-bot { align-items: flex-end; }\\n.hud-bot > .note { max-width: 24rem; text-align: right; line-height: 1.35; }\\n.glyph { width: 2.2rem; height: 2.2rem; vertical-align: -0.55rem; }\\n.obj { font-size: 2.5rem; font-weight: 700; max-width: 36rem; }\\n.hud-mid { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }\\n.vitals, .timer, .score, .bpm { font-size: 3.5rem; font-weight: 700; line-height: 1; text-align: center; }\\n#ecg { width: 14rem; height: 2.2rem; background: transparent; }\\n.wheel { display: flex; flex-wrap: wrap; gap: 0.35rem; max-width: 22rem; pointer-events: auto; }\\n.wheel button { width: 7rem; height: 3.4rem; font-size: 2.2rem; background: #10282c; border: 0.15rem solid #f4efe4; border-radius: 0.4rem; }\\n.wheel button.on { background: #17707A; }\\n.bark { font-size: 2.2rem; background: #f4efe4; color: #1a120c; padding: 0.6rem 0.9rem; border-radius: 0.8rem; max-width: 32rem; }\\n.who { font-size: 2.2rem; letter-spacing: 0.08em; text-transform: uppercase; }\\n.overlay { position: absolute; inset: 0; background: rgba(11, 37, 41, 0.82); display: flex; flex-direction: column; justify-content: center; gap: 0.8rem; padding: 4vh 4vw; pointer-events: auto; }\\n.big { font-family: 'Bangers', sans-serif; font-size: 5rem; margin: 0; }\\n.dialogue { margin-top: auto; background: #f4efe4; color: #1a120c; padding: 1rem 1.2rem; border-radius: 0.8rem; min-height: 8rem; }\\n.dialogue p { font-size: 2.75rem; margin: 0.2rem 0; }\\n.pages, .tabs { display: flex; flex-wrap: wrap; gap: 0.8rem; font-size: 2.2rem; }\\n.page { display: none; font-size: 2.2rem; line-height: 1.25; }\\n.page.on { display: block; }\\n.tabs button { font-size: 2.2rem; background: transparent; border: 0; border-bottom: 0.2rem solid transparent; padding: 0.3rem 0.4rem; cursor: pointer; }\\n.tabs button.on { border-color: #f4efe4; }\\n.demo { position: absolute; top: 0; right: 0; font-family: 'Bangers', sans-serif; font-size: 3rem; }\\n.where { font-size: 2.2rem; letter-spacing: 0.06em; text-transform: uppercase; margin: 0; }\\n.note { font-size: 2.15rem; }\\n.about-fit { justify-content: flex-start; gap: 0.45rem; }\\n.about-fit .about-line { line-height: 1.15; }\\ninput[type=range] { width: 16rem; accent-color: #17707A; }\\n.seats { display: flex; gap: 1rem; }\\n.seat { border: 0.2rem solid #f4efe4; padding: 0.8rem; min-width: 8rem; font-size: 2.15rem; }\\n.fail-title { font-family: 'Bangers', sans-serif; font-size: 6rem; margin: 0; }\\n.ecg-line { height: 0.4rem; width: 14rem; background: linear-gradient(90deg, transparent, #f4efe4 40%, transparent 40%, transparent 55%, #f4efe4 55%, #f4efe4 70%, transparent 70%); background-size: 200% 100%; animation: sweep 1.2s linear infinite; }\\n@keyframes sweep { to { background-position: -200% 0; } }\\n.nogfx { position: absolute; inset: 0; display: grid; place-items: center; background: #17707A; font-size: 2.4rem; text-align: center; padding: 8vh; }\\n.sound { position: absolute; bottom: 0; left: 0; font-size: 2.2rem; }\\n.card { gap: 0.8rem; }\\n.touch-copy { font-size: 3.2rem; max-width: 40rem; }\\n.row { display: flex; justify-content: space-between; gap: 1rem; font-size: 2.4rem; }\\n.pick { outline: 0.2rem solid #f5b700; }\\n.nogfx p, .about-line { font-size: 2.2rem; margin: 0.2rem 0; }\\nbody[data-screen=\\\"Title\\\"], body[data-screen=\\\"Boot\\\"] { background: #17707A; }\\n.hud .obj, .hud .vitals, .hud .timer { text-shadow: 0 0.08rem 0 #0B2529; }\\n\",\"total_lines\":66}}","is_error":false},{"type":"tool_result","tool_use_id":"call-f8e1c3e6-afa7-4c08-9ad4-37ad5a2e34b3-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { createRequire } from 'node:module';\\nimport { createServer } from 'node:http';\\nimport { readFileSync, mkdirSync, writeFileSync, statSync } from 'node:fs';\\nimport { pathToFileURL } from 'node:url';\\nimport path from 'node:path';\\n\\nconst require = createRequire('/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/package.json');\\nconst { chromium } = require('playwright');\\n\\n10→const DEV = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230';\\nconst HTML = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230.html';\\nconst OUT = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/tmp/grok-goal-c4cb33e83374/implementer/shots';\\nconst FLAGS = [\\n  '--enable-unsafe-webgpu',\\n  '--enable-features=Vulkan',\\n  '--use-vulkan=swiftshader',\\n  '--use-webgpu-adapter=swiftshader',\\n  '--use-angle=swiftshader',\\n];\\n20→\\nmkdirSync(OUT, { recursive: true });\\nconst log = [];\\nconst say = (line) => { log.push(line); console.log(line); };\\n\\nfunction serve(root) {\\n  const server = createServer((req, res) => {\\n    const url = new URL(req.url, 'http://127.0.0.1');\\n    const rel = decodeURIComponent(url.pathname);\\n    if (rel.includes('..')) { res.writeHead(403); res.end(); return; }\\n30→    const file = path.join(root, rel === '/' ? 'harness.html' : rel);\\n    if (!file.startsWith(root)) { res.writeHead(403); res.end(); return; }\\n    try {\\n      const body = readFileSync(file);\\n      const ext = path.extname(file);\\n      const type = ext === '.html' ? 'text/html' : ext === '.js' ? 'text/javascript' : 'application/octet-stream';\\n      res.writeHead(200, { 'content-type': type });\\n      res.end(body);\\n    } catch {\\n      res.writeHead(404); res.end();\\n40→    }\\n  });\\n  return new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(server)));\\n}\\n\\nasync function main() {\\n  const browser = await chromium.launch({ headless: true, args: FLAGS });\\n  const page = await browser.newPage({ viewport: { width: 1920, height: 1080 }, deviceScaleFactor: 1 });\\n  page.setDefaultTimeout(180000);\\n  const errors = [];\\n50→  page.on('pageerror', (e) => errors.push(String(e)));\\n  page.on('console', (msg) => {\\n    if (msg.type() === 'error') errors.push(msg.text());\\n  });\\n\\n  const url = pathToFileURL(HTML).href + '?test=1';\\n  say('goto ' + url);\\n  await page.goto(url, { waitUntil: 'domcontentloaded' });\\n  await page.waitForFunction(() => window.__game && window.__game.state && window.__game.state().renderBackend === 'webgpu', null, { timeout: 180000 });\\n  say('booted ' + JSON.stringify(await page.evaluate(() => window.__game.state())));\\n60→\\n  async function press(key) {\\n    await page.keyboard.press(key);\\n    await page.evaluate(() => window.__game.test.step(1));\\n  }\\n  async function state() {\\n    return page.evaluate(() => window.__game.state());\\n  }\\n  async function audit() {\\n    return page.evaluate(() => {\\n70→      const vh = innerHeight;\\n      const vw = innerWidth;\\n      const min = 34 * (vh / 1080);\\n      const keyMin = 56 * (vh / 1080);\\n      const safe = { l: vw * 0.05, t: vh * 0.05, r: vw * 0.95, b: vh * 0.95 };\\n      const rows = [];\\n      for (const el of document.querySelectorAll('#ui *')) {\\n        const hasText = [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());\\n        if (!hasText) continue;\\n        const r = el.getBoundingClientRect();\\n80→        if (r.width < 2 || r.height < 2) continue;\\n        const fs = parseFloat(getComputedStyle(el).fontSize);\\n        const key = el.classList.contains('vitals') || el.classList.contains('timer') || el.classList.contains('score');\\n        const small = fs + 0.6 < (key ? keyMin : min);\\n        const clip = r.left < -1 || r.top < -1 || r.right > vw + 1 || r.bottom > vh + 1;\\n        const unsafe = r.left < safe.l - 2 || r.top < safe.t - 2 || r.right > safe.r + 2 || r.bottom > safe.b + 2;\\n        if (small || clip || unsafe) {\\n          rows.push({\\n            text: el.textContent.trim().replace(/\\\\s+/g, ' ').slice(0, 60),\\n            fs: Math.round(fs),\\n90→            small, clip, unsafe, key,\\n            x: Math.round(r.left), y: Math.round(r.top), w: Math.round(r.width), h: Math.round(r.height),\\n          });\\n        }\\n      }\\n      return rows;\\n    });\\n  }\\n  async function shot(name) {\\n    await page.evaluate(() => new Promise((resolve) => {\\n100→      let n = 0;\\n      const tick = () => { if (++n >= 3) resolve(); else requestAnimationFrame(tick); };\\n      requestAnimationFrame(tick);\\n    }));\\n    await page.waitForTimeout(1800);\\n    const st = await state();\\n    const issues = await audit();\\n    await page.screenshot({ path: path.join(OUT, name), animations: 'disabled' });\\n    const bytes = statSync(path.join(OUT, name)).size;\\n    say(`${name} screen=${st.screen} phase=${st.phase} vitals=${st.vitals == null ? '' : Math.round(st.vitals)} attract=${st.attract} bytes=${bytes} issues=${issues.length}`);\\n110→    for (const row of issues) say('  ' + JSON.stringify(row));\\n    return st;\\n  }\\n\\n  let st = await state();\\n  if (st.attract) {\\n    say('attract already on, exiting');\\n    await press('Enter');\\n    await page.evaluate(() => window.__game.test.step(2));\\n  }\\n120→  await shot('title.png');\\n  await press('Enter');\\n  st = await state();\\n  if (st.screen === 'Title') await press('Enter');\\n  await shot('main-menu.png');\\n\\n  await press('ArrowDown');\\n  await press('ArrowDown');\\n  await press('ArrowDown');\\n  await press('Enter');\\n130→  await shot('settings.png');\\n  await press('Escape');\\n  st = await state();\\n  say('after settings back ' + st.screen + ' focus ' + st.focusId);\\n\\n  if (st.screen !== 'Main Menu') {\\n    await page.keyboard.press('Escape');\\n    await page.evaluate(() => window.__game.test.step(2));\\n  }\\n  for (let i = 0; i < 4; i++) await press('ArrowDown');\\n140→  await press('Enter');\\n  await shot('about.png');\\n\\n  await page.evaluate(() => window.__game.devRun('scene', 'S0'));\\n  for (let i = 0; i < 16; i++) {\\n    const shout = await page.evaluate(() => !!document.querySelector('.dialogue.shout'));\\n    if (shout) break;\\n    await press('Enter');\\n  }\\n  const line = await page.evaluate(() => document.querySelector('.dialogue')?.innerText || '');\\n150→  say('story line ' + line.replace(/\\\\s+/g, ' ').slice(0, 120));\\n  await shot('story-shout.png');\\n  await shot('cut-in.png');\\n\\n  async function go(op, phase) {\\n    const ok = await page.evaluate(({ op, phase }) => {\\n      window.__game.test.skipTo(op, phase);\\n      window.__game.test.step(12);\\n      return window.__game.state();\\n    }, { op, phase });\\n160→    say(`go ${op} ${phase} -> ${ok.screen} ${ok.phase} vitals=${ok.vitals == null ? '' : Math.round(ok.vitals)}`);\\n  }\\n\\n  await go('broken-glass', 'glass');\\n  await shot('op-calm.png');\\n  await shot('hud-portrait.png');\\n\\n  await page.evaluate(() => { window.__game.devRun('hush'); window.__game.test.step(8); });\\n  await shot('hush.png');\\n\\n170→  await go('broken-glass', 'glass');\\n  const danger = await page.evaluate(() => {\\n    const g = window.__game;\\n    g.devRun('freeze');\\n    for (let i = 0; i < 4; i++) g.devRun('bleeder');\\n    let last = g.state();\\n    for (let n = 0; n < 50; n++) {\\n      g.test.step(20);\\n      last = g.state();\\n      if (last.vitals < 22 || last.screen !== 'Operation') break;\\n180→    }\\n    return { screen: last.screen, vitals: last.vitals, phase: last.phase };\\n  });\\n  say('danger ' + JSON.stringify(danger));\\n  await shot('op-danger.png');\\n\\n  const strains = [\\n    ['strain-adagio.png', 'adagio', 'creature'],\\n    ['strain-staccato.png', 'staccato', 'wave1'],\\n    ['strain-tremolo.png', 'staccato', 'moths'],\\n190→    ['strain-legato.png', 'legato', 'chain'],\\n    ['strain-crescendo.png', 'fermata', 'ring'],\\n    ['strain-fermata.png', 'fermata', 'arrest2'],\\n    ['strain-coda.png', 'coda', 'conductor'],\\n  ];\\n  for (const [name, op, phase] of strains) {\\n    await go(op, phase);\\n    await shot(name);\\n  }\\n\\n200→  await page.evaluate(() => { window.__game.devRun('win'); window.__game.test.step(2); });\\n  await shot('report.png');\\n  say('errors ' + errors.length);\\n  for (const e of errors.slice(0, 12)) say('ERR ' + e.slice(0, 240));\\n\\n  await page.close();\\n\\n  const site = path.join(DEV, 'tests/hub/site');\\n  const server = await serve(site);\\n  const port = server.address().port;\\n210→  const cardUrl = `http://127.0.0.1:${port}/harness.html?game=${encodeURIComponent('game.html?webgl=1')}&players=1`;\\n  say('card ' + cardUrl);\\n  const page2 = await browser.newPage({ viewport: { width: 1920, height: 1080 }, deviceScaleFactor: 1 });\\n  page2.setDefaultTimeout(120000);\\n  const cardErrors = [];\\n  page2.on('pageerror', (e) => cardErrors.push(String(e)));\\n  await page2.addInitScript(() => {\\n    const style = document.createElement('style');\\n    style.textContent = 'header,aside{display:none!important}main{grid-template-columns:1fr!important}#grid{padding:0!important}.cell__bar{display:none!important}';\\n    document.addEventListener('DOMContentLoaded', () => document.documentElement.append(style));\\n220→  });\\n  await page2.goto(cardUrl, { waitUntil: 'domcontentloaded' });\\n  const found = await page2.waitForFunction(() => {\\n    const frame = document.querySelector('iframe');\\n    const game = frame && frame.contentWindow && frame.contentWindow.__game;\\n    if (!game || !game.state) return false;\\n    return game.state().screen;\\n  }, null, { timeout: 90000 }).then(async () => page2.evaluate(() => {\\n    const game = document.querySelector('iframe').contentWindow.__game;\\n    return game.state().screen;\\n230→  })).catch((err) => 'timeout ' + err.message);\\n  say('card screen ' + found);\\n  await page2.waitForTimeout(1500);\\n  const frame = page2.frames().find((f) => f.url().includes('game.html'));\\n  if (frame) {\\n    const issues = await frame.evaluate(() => {\\n      const vh = innerHeight;\\n      const vw = innerWidth;\\n      const min = 34 * (vh / 1080);\\n      const rows = [];\\n240→      for (const el of document.querySelectorAll('#ui *')) {\\n        const hasText = [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());\\n        if (!hasText) continue;\\n        const r = el.getBoundingClientRect();\\n        if (r.width < 2 || r.height < 2) continue;\\n        const fs = parseFloat(getComputedStyle(el).fontSize);\\n        if (fs + 0.6 < min || r.bottom > vh + 1 || r.right > vw + 1) {\\n          rows.push({ text: el.textContent.trim().slice(0, 50), fs: Math.round(fs), bottom: Math.round(r.bottom), right: Math.round(r.right), vh, vw });\\n        }\\n      }\\n250→      return { rows, screen: window.__game.state().screen, box: { w: innerWidth, h: innerHeight } };\\n    });\\n    say('card audit ' + JSON.stringify(issues));\\n  }\\n  await page2.screenshot({ path: path.join(OUT, 'session-card.png'), animations: 'disabled' });\\n  say('session-card bytes ' + statSync(path.join(OUT, 'session-card.png')).size + ' cardErrors ' + cardErrors.length);\\n  for (const e of cardErrors.slice(0, 8)) say('CARDERR ' + e.slice(0, 200));\\n\\n  await browser.close();\\n  server.close();\\n260→  writeFileSync(path.join(OUT, 'shots.log'), log.join('\\\\n') + '\\\\n');\\n  say('done');\\n}\\n\\nmain().catch((err) => {\\n  console.error(err);\\n  writeFileSync(path.join(OUT, 'shots.log'), log.join('\\\\n') + '\\\\n' + err.stack + '\\\\n');\\n  process.exit(1);\\n});\\n\",\"content_concise\":\"1→import { createRequire } from 'node:module';\\nimport { createServer } from 'node:http';\\nimport { readFileSync, mkdirSync, writeFileSync, statSync } from 'node:fs';\\nimport { pathToFileURL } from 'node:url';\\nimport path from 'node:path';\\n\\nconst require = createRequire('/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/package.json');\\nconst { chromium } = require('playwright');\\n\\n10→const DEV = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230';\\nconst HTML = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230.html';\\nconst OUT = '/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/tmp/grok-goal-c4cb33e83374/implementer/shots';\\nconst FLAGS = [\\n  '--enable-unsafe-webgpu',\\n  '--enable-features=Vulkan',\\n  '--use-vulkan=swiftshader',\\n  '--use-webgpu-adapter=swiftshader',\\n  '--use-angle=swiftshader',\\n];\\n20→\\nmkdirSync(OUT, { recursive: true });\\nconst log = [];\\nconst say = (line) => { log.push(line); console.log(line); };\\n\\nfunction serve(root) {\\n  const server = createServer((req, res) => {\\n    const url = new URL(req.url, 'http://127.0.0.1');\\n    const rel = decodeURIComponent(url.pathname);\\n    if (rel.includes('..')) { res.writeHead(403); res.end(); return; }\\n30→    const file = path.join(root, rel === '/' ? 'harness.html' : rel);\\n    if (!file.startsWith(root)) { res.writeHead(403); res.end(); return; }\\n    try {\\n      const body = readFileSync(file);\\n      const ext = path.extname(file);\\n      const type = ext === '.html' ? 'text/html' : ext === '.js' ? 'text/javascript' : 'application/octet-stream';\\n      res.writeHead(200, { 'content-type': type });\\n      res.end(body);\\n    } catch {\\n      res.writeHead(404); res.end();\\n40→    }\\n  });\\n  return new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(server)));\\n}\\n\\nasync function main() {\\n  const browser = await chromium.launch({ headless: true, args: FLAGS });\\n  const page = await browser.newPage({ viewport: { width: 1920, height: 1080 }, deviceScaleFactor: 1 });\\n  page.setDefaultTimeout(180000);\\n  const errors = [];\\n50→  page.on('pageerror', (e) => errors.push(String(e)));\\n  page.on('console', (msg) => {\\n    if (msg.type() === 'error') errors.push(msg.text());\\n  });\\n\\n  const url = pathToFileURL(HTML).href + '?test=1';\\n  say('goto ' + url);\\n  await page.goto(url, { waitUntil: 'domcontentloaded' });\\n  await page.waitForFunction(() => window.__game && window.__game.state && window.__game.state().renderBackend === 'webgpu', null, { timeout: 180000 });\\n  say('booted ' + JSON.stringify(await page.evaluate(() => window.__game.state())));\\n60→\\n  async function press(key) {\\n    await page.keyboard.press(key);\\n    await page.evaluate(() => window.__game.test.step(1));\\n  }\\n  async function state() {\\n    return page.evaluate(() => window.__game.state());\\n  }\\n  async function audit() {\\n    return page.evaluate(() => {\\n70→      const vh = innerHeight;\\n      const vw = innerWidth;\\n      const min = 34 * (vh / 1080);\\n      const keyMin = 56 * (vh / 1080);\\n      const safe = { l: vw * 0.05, t: vh * 0.05, r: vw * 0.95, b: vh * 0.95 };\\n      const rows = [];\\n      for (const el of document.querySelectorAll('#ui *')) {\\n        const hasText = [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());\\n        if (!hasText) continue;\\n        const r = el.getBoundingClientRect();\\n80→        if (r.width < 2 || r.height < 2) continue;\\n        const fs = parseFloat(getComputedStyle(el).fontSize);\\n        const key = el.classList.contains('vitals') || el.classList.contains('timer') || el.classList.contains('score');\\n        const small = fs + 0.6 < (key ? keyMin : min);\\n        const clip = r.left < -1 || r.top < -1 || r.right > vw + 1 || r.bottom > vh + 1;\\n        const unsafe = r.left < safe.l - 2 || r.top < safe.t - 2 || r.right > safe.r + 2 || r.bottom > safe.b + 2;\\n        if (small || clip || unsafe) {\\n          rows.push({\\n            text: el.textContent.trim().replace(/\\\\s+/g, ' ').slice(0, 60),\\n            fs: Math.round(fs),\\n90→            small, clip, unsafe, key,\\n            x: Math.round(r.left), y: Math.round(r.top), w: Math.round(r.width), h: Math.round(r.height),\\n          });\\n        }\\n      }\\n      return rows;\\n    });\\n  }\\n  async function shot(name) {\\n    await page.evaluate(() => new Promise((resolve) => {\\n100→      let n = 0;\\n      const tick = () => { if (++n >= 3) resolve(); else requestAnimationFrame(tick); };\\n      requestAnimationFrame(tick);\\n    }));\\n    await page.waitForTimeout(1800);\\n    const st = await state();\\n    const issues = await audit();\\n    await page.screenshot({ path: path.join(OUT, name), animations: 'disabled' });\\n    const bytes = statSync(path.join(OUT, name)).size;\\n    say(`${name} screen=${st.screen} phase=${st.phase} vitals=${st.vitals == null ? '' : Math.round(st.vitals)} attract=${st.attract} bytes=${bytes} issues=${issues.length}`);\\n110→    for (const row of issues) say('  ' + JSON.stringify(row));\\n    return st;\\n  }\\n\\n  let st = await state();\\n  if (st.attract) {\\n    say('attract already on, exiting');\\n    await press('Enter');\\n    await page.evaluate(() => window.__game.test.step(2));\\n  }\\n120→  await shot('title.png');\\n  await press('Enter');\\n  st = await state();\\n  if (st.screen === 'Title') await press('Enter');\\n  await shot('main-menu.png');\\n\\n  await press('ArrowDown');\\n  await press('ArrowDown');\\n  await press('ArrowDown');\\n  await press('Enter');\\n130→  await shot('settings.png');\\n  await press('Escape');\\n  st = await state();\\n  say('after settings back ' + st.screen + ' focus ' + st.focusId);\\n\\n  if (st.screen !== 'Main Menu') {\\n    await page.keyboard.press('Escape');\\n    await page.evaluate(() => window.__game.test.step(2));\\n  }\\n  for (let i = 0; i < 4; i++) await press('ArrowDown');\\n140→  await press('Enter');\\n  await shot('about.png');\\n\\n  await page.evaluate(() => window.__game.devRun('scene', 'S0'));\\n  for (let i = 0; i < 16; i++) {\\n    const shout = await page.evaluate(() => !!document.querySelector('.dialogue.shout'));\\n    if (shout) break;\\n    await press('Enter');\\n  }\\n  const line = await page.evaluate(() => document.querySelector('.dialogue')?.innerText || '');\\n150→  say('story line ' + line.replace(/\\\\s+/g, ' ').slice(0, 120));\\n  await shot('story-shout.png');\\n  await shot('cut-in.png');\\n\\n  async function go(op, phase) {\\n    const ok = await page.evaluate(({ op, phase }) => {\\n      window.__game.test.skipTo(op, phase);\\n      window.__game.test.step(12);\\n      return window.__game.state();\\n    }, { op, phase });\\n160→    say(`go ${op} ${phase} -> ${ok.screen} ${ok.phase} vitals=${ok.vitals == null ? '' : Math.round(ok.vitals)}`);\\n  }\\n\\n  await go('broken-glass', 'glass');\\n  await shot('op-calm.png');\\n  await shot('hud-portrait.png');\\n\\n  await page.evaluate(() => { window.__game.devRun('hush'); window.__game.test.step(8); });\\n  await shot('hush.png');\\n\\n170→  await go('broken-glass', 'glass');\\n  const danger = await page.evaluate(() => {\\n    const g = window.__game;\\n    g.devRun('freeze');\\n    for (let i = 0; i < 4; i++) g.devRun('bleeder');\\n    let last = g.state();\\n    for (let n = 0; n < 50; n++) {\\n      g.test.step(20);\\n      last = g.state();\\n      if (last.vitals < 22 || last.screen !== 'Operation') break;\\n180→    }\\n    return { screen: last.screen, vitals: last.vitals, phase: last.phase };\\n  });\\n  say('danger ' + JSON.stringify(danger));\\n  await shot('op-danger.png');\\n\\n  const strains = [\\n    ['strain-adagio.png', 'adagio', 'creature'],\\n    ['strain-staccato.png', 'staccato', 'wave1'],\\n    ['strain-tremolo.png', 'staccato', 'moths'],\\n190→    ['strain-legato.png', 'legato', 'chain'],\\n    ['strain-crescendo.png', 'fermata', 'ring'],\\n    ['strain-fermata.png', 'fermata', 'arrest2'],\\n    ['strain-coda.png', 'coda', 'conductor'],\\n  ];\\n  for (const [name, op, phase] of strains) {\\n    await go(op, phase);\\n    await shot(name);\\n  }\\n\\n200→  await page.evaluate(() => { window.__game.devRun('win'); window.__game.test.step(2); });\\n  await shot('report.png');\\n  say('errors ' + errors.length);\\n  for (const e of errors.slice(0, 12)) say('ERR ' + e.slice(0, 240));\\n\\n  await page.close();\\n\\n  const site = path.join(DEV, 'tests/hub/site');\\n  const server = await serve(site);\\n  const port = server.address().port;\\n210→  const cardUrl = `http://127.0.0.1:${port}/harness.html?game=${encodeURIComponent('game.html?webgl=1')}&players=1`;\\n  say('card ' + cardUrl);\\n  const page2 = await browser.newPage({ viewport: { width: 1920, height: 1080 }, deviceScaleFactor: 1 });\\n  page2.setDefaultTimeout(120000);\\n  const cardErrors = [];\\n  page2.on('pageerror', (e) => cardErrors.push(String(e)));\\n  await page2.addInitScript(() => {\\n    const style = document.createElement('style');\\n    style.textContent = 'header,aside{display:none!important}main{grid-template-columns:1fr!important}#grid{padding:0!important}.cell__bar{display:none!important}';\\n    document.addEventListener('DOMContentLoaded', () => document.documentElement.append(style));\\n220→  });\\n  await page2.goto(cardUrl, { waitUntil: 'domcontentloaded' });\\n  const found = await page2.waitForFunction(() => {\\n    const frame = document.querySelector('iframe');\\n    const game = frame && frame.contentWindow && frame.contentWindow.__game;\\n    if (!game || !game.state) return false;\\n    return game.state().screen;\\n  }, null, { timeout: 90000 }).then(async () => page2.evaluate(() => {\\n    const game = document.querySelector('iframe').contentWindow.__game;\\n    return game.state().screen;\\n230→  })).catch((err) => 'timeout ' + err.message);\\n  say('card screen ' + found);\\n  await page2.waitForTimeout(1500);\\n  const frame = page2.frames().find((f) => f.url().includes('game.html'));\\n  if (frame) {\\n    const issues = await frame.evaluate(() => {\\n      const vh = innerHeight;\\n     