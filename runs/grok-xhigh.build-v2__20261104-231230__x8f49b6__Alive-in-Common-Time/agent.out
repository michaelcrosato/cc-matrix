tent\":\"    get showsCard() {\"},{\"line_number\":276,\"content\":\"export const postTo = (frame) => (msg) => frame.contentWindow?.postMessage(msg, '*');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/hub/site/game.html\",\"matches\":[{\"line_number\":209,\"content\":\"      root.parent.postMessage(msg, origin);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"3d7bb799-7b33-41f3-9e66-ae114794e3f1"}
