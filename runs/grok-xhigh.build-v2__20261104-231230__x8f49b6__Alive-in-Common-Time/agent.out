op = byId.get(id);\\n  if (!op) throw new Error(`unknown operation ${id}`);\\n  return op;\\n}\\n\\nexport function storyOrder() {\\n  return OPS.map((op) => op.id);\\n}\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"4de2e165-a307-4894-b9c7-d1e892b4cc81"}
