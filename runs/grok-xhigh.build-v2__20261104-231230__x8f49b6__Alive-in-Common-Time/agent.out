 Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/strains.js\",\"matches\":[{\"line_number\":13,\"content\":\"      if (e.kind === 'adagio' && e.stunned <= 0 && e.hp <= 0 && !e.tray && !e.holder) {\"},{\"line_number\":21,\"content\":\"      case 'adagio': stepAdagio(sim, e, dt, beats); break;\"},{\"line_number\":22,\"content\":\"      case 'hole':\"},{\"line_number\":23,\"content\":\"      case 'nest': stepHole(sim, e, beats); break;\"},{\"line_number\":24,\"content\":\"      case 'note': stepNote(sim, e, beats); break;\"},{\"line_number\":25,\"content\":\"      case 'spore': sim.hurt(0.3 * dt, 'spore'); break;\"},{\"line_number\":26,\"content\":\"      case 'scratch': sim.hurt((e.rate || 0.5) * dt, 'scratch'); break;\"},{\"line_number\":27,\"content\":\"      case 'tremolo': stepTremolo(sim, e, dt); break;\"},{\"line_number\":28,\"content\":\"      case 'legato': stepLegato(sim, e, beats); break;\"},{\"line_number\":29,\"content\":\"      case 'crescendo': stepCrescendo(sim, e, dt, beats); break;\"},{\"line_number\":30,\"content\":\"      case 'fermata': stepFermata(sim, e, dt); break;\"},{\"line_number\":31,\"content\":\"      case 'coda': stepCoda(sim, e, dt, beats); break;\"},{\"line_number\":32,\"content\":\"      case 'bleeder': stepBleeder(sim, e, dt); break;\"},{\"line_number\":33,\"content\":\"      case 'pool': stepPool(sim, e, dt); break;\"},{\"line_number\":59,\"content\":\"      const open = sim.entities.filter((x) => x.alive && x.kind === 'bleeder').length;\"},{\"line_number\":155,\"content\":\"      const open = sim.entities.filter((x) => x.alive && x.kind === 'bleeder').length;\"},{\"line_number\":181,\"content\":\"  const live = sim.entities.filter((f) => f.alive && f.kind === 'feeder' && f.parent === e.id);\"},{\"line_number\":220,\"content\":\"    const cut = sim.entities.find((c) => c.kind === 'circleCut' && c.site === e.site && !c.alive);\"},{\"line_number\":288,\"content\":\"      const armsNow = sim.entities.filter((a) => a.kind === 'baton' && a.parent === e.id);\"},{\"line_number\":310,\"content\":\"  const arms = sim.entities.filter((a) => a.alive && a.kind === 'baton' && a.parent === e.id);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"cc3d85ab-f783-4107-904f-9ed522f28485"}
{"type":"assistant","message":{"id":"msg_660","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The output looks like a close copy. I will skip character-by-character diffs unless the screenshots look wrong.\n\nI will draft AUTHORING.md now. It will cover adding operations, registering them in the ops index, and setting parScore by running the sim suite.\n\nThe authoring guide will detail operation fields, phase mechanics, strain spawning, story scene structure, and tuning configuration.\n\nI will check the browser test status and CPU usage before finishing. The about page tab buttons are correctly placed in the DOM. A potential story tickAudio issue is not blocking.","signature":""},{"type":"tool_use","id":"call-db549b59-a8f5-4ea0-bb4a-7f563eb335d3-130","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/data/ops/index.js"}},{"type":"tool_use","id":"call-db549b59-a8f5-4ea0-bb4a-7f563eb335d3-131","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/field.js","limit":25}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":4635,"output_tokens":701,"cache_read_input_tokens":185856,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"fc7f5d6c-51ce-4684-9630-b4f66194aa2d"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-db549b59-a8f5-4ea0-bb4a-7f563eb335d3-130","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import brokenGlass from './broken-glass.js';\\nimport growthSpurt from './growth-spurt.js';\\nimport adagio from './adagio.js';\\nimport staccato from './staccato.js';\\nimport legato from './legato.js';\\nimport fermata from './fermata.js';\\nimport coda from './coda.js';\\nimport lastPatient from './last-patient.js';\\nimport grandRounds from './grand-rounds.js';\\n10→\\nexport const OPS = [brokenGlass, growthSpurt, adagio, staccato, legato, fermata, coda, lastPatient];\\nexport const ALL_OPS = [...OPS, grandRounds];\\n\\nconst byId = new Map(ALL_OPS.map((op) => [op.id, op]));\\n\\nexport function getOp(id) {\\n  const op = byId.get(id);\\n  if (!op) throw new Error(`unknown operation ${id}`);\\n  return op;\\n20→}\\n\\nexport function storyOrder() {\\n  return OPS.map((op) => op.id);\\n}\\n\",\"content_concise\":\"1→import brokenGlass from './broken-glass.js';\\nimport growthSpurt from './growth-spurt.js';\\nimport adagio from './adagio.js';\\nimport staccato from './staccato.js';\\nimport legato from './legato.js';\\nimport fermata from './fermata.js';\\nimport coda from './coda.js';\\nimport lastPatient from './last-patient.js';\\nimport grandRounds from './grand-rounds.js';\\n10→\\nexport const OPS = [brokenGlass, growthSpurt, adagio, staccato, legato, fermata, coda, lastPatient];\\nexport const ALL_OPS = [...OPS, grandRounds];\\n\\nconst byId = new Map(ALL_OPS.map((op) => [op.id, op]));\\n\\nexport function getOp(id) {\\n  const op = byId.get(id);\\n  if (!op) throw new Error(`unknown operation ${id}`);\\n  return op;\\n20→}\\n\\nexport function storyOrder() {\\n  return OPS.map((op) => op.id);\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/data/ops/index.js\",\"offset\":null,\"raw_output\":\"import brokenGlass from './broken-glass.js';\\nimport growthSpurt from './growth-spurt.js';\\nimport adagio from './adagio.js';\\nimport staccato from './staccato.js';\\nimport legato from './legato.js';\\nimport fermata from './fermata.js';\\nimport coda from './coda.js';\\nimport lastPatient from './last-patient.js';\\nimport grandRounds from './grand-rounds.js';\\n\\nexport const OPS = [brokenGlass, growthSpurt, adagio, staccato, legato, fermata, coda, lastPatient];\\nexport const ALL_OPS = [...OPS, grandRounds];\\n\\nconst byId = new Map(ALL_OPS.map((op) => [op.id, op]));\\n\\nexport function getOp(id) {\\n  const op = byId.get(id);\\n  if (!op) throw new Error(`unknown operation ${id}`);\\n  return op;\\n}\\n\\nexport function storyOrder() {\\n  return OPS.map((op) => op.id);\\n}\\n\",\"total_lines\":24}}","is_error":false},{"type":"tool_result","tool_use_id":"call-db549b59-a8f5-4ea0-bb4a-7f563eb335d3-131","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→export const DT = 1 / 60;\\nexport const TRAY = { x: 1.62, y: 0.2, hw: 0.28, hh: 0.42 };\\nexport const IV = { x: 1.02, y: 0.22 };\\n\\nexport const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\nexport const hypot = (x, y) => Math.hypot(x, y);\\n\\nexport function inDrape(x, y) {\\n  return (x / 1.4) ** 2 + (y / 0.85) ** 2 <= 1 + 1e-6;\\n10→}\\n\\nexport function clampTip(x, y) {\\n  return [clamp(x, -1.55, 1.9), clamp(y, -0.95, 0.95)];\\n}\\n\\nexport function overTray(x, y) {\\n  return Math.abs(x - TRAY.x) <= TRAY.hw && Math.abs(y - TRAY.y) <= TRAY.hh;\\n}\\n\\n20→export function dist(ax, ay, bx, by) {\\n  return hypot(ax - bx, ay - by);\\n}\\n\\nexport function distPointSeg(px, py, ax, ay, bx, by) {\\n  const abx = bx - ax;\",\"content_concise\":\"1→export const DT = 1 / 60;\\nexport const TRAY = { x: 1.62, y: 0.2, hw: 0.28, hh: 0.42 };\\nexport const IV = { x: 1.02, y: 0.22 };\\n\\nexport const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\nexport const hypot = (x, y) => Math.hypot(x, y);\\n\\nexport function inDrape(x, y) {\\n  return (x / 1.4) ** 2 + (y / 0.85) ** 2 <= 1 + 1e-6;\\n10→}\\n\\nexport function clampTip(x, y) {\\n  return [clamp(x, -1.55, 1.9), clamp(y, -0.95, 0.95)];\\n}\\n\\nexport function overTray(x, y) {\\n  return Math.abs(x - TRAY.x) <= TRAY.hw && Math.abs(y - TRAY.y) <= TRAY.hh;\\n}\\n\\n20→export function dist(ax, ay, bx, by) {\\n  return hypot(ax - bx, ay - by);\\n}\\n\\nexport function distPointSeg(px, py, ax, ay, bx, by) {\\n  const abx = bx - ax;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/field.js\",\"offset\":null,\"limit\":25,\"raw_output\":\"export const DT = 1 / 60;\\nexport const TRAY = { x: 1.62, y: 0.2, hw: 0.28, hh: 0.42 };\\nexport const IV = { x: 1.02, y: 0.22 };\\n\\nexport const clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\nexport const hypot = (x, y) => Math.hypot(x, y);\\n\\nexport function inDrape(x, y) {\\n  return (x / 1.4) ** 2 + (y / 0.85) ** 2 <= 1 + 1e-6;\\n}\\n\\nexport function clampTip(x, y) {\\n  return [clamp(x, -1.55, 1.9), clamp(y, -0.95, 0.95)];\\n}\\n\\nexport function overTray(x, y) {\\n  return Math.abs(x - TRAY.x) <= TRAY.hw && Math.abs(y - TRAY.y) <= TRAY.hh;\\n}\\n\\nexport function dist(ax, ay, bx, by) {\\n  return hypot(ax - bx, ay - by);\\n}\\n\\nexport function distPointSeg(px, py, ax, ay, bx, by) {\\n  const abx = bx - ax;\\n\",\"total_lines\":71}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"1d4d9877-4d9e-4f6f-a0b3-dbab9b04c7dd"}
{"type":"assistant","message":{"id":"msg_661","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"tool_use","id":"call-5d740b6b-3935-4677-9bf5-eaf4dd517966-132","name":"search_replace","input":{"file_path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/docs/AUTHORING.md","old_string":"","new_string":"# Authoring\n\nOperations, strains, scenes, and tuning are data plus one small piece of behavior. The sim reads them. The view and the shell do not need a new screen for each addition.\n\nRun `node tests/run-all.mjs sim` after a data change. It plays the shipped sim. A new operation is not done until that bot finishes it inside the same rules as the others.\n\n## Add an operation\n\n1. Add `src/data/ops/<id>.js` that default-exports one object.\n2. Import it in `src/data/ops/index.js`. Story operations go in `OPS`, in play order. A free-play or versus operation that is not in the story goes only in `ALL_OPS`.\n3. Give it a patient, a timer, a bpm, a music id, a `teaches` list, one or more sites, and phases.\n4. Point `scene.before` and `scene.after` at scene ids. Use `consult: true` when the chart should offer Careful and Aggressive.\n5. Set `parScore` from a Normal resident bot run with `physics: false` and seed 1. Do not change a locked par unless that bot's score actually moved.\n\n```js\nexport default {\n  id: 'night-shift',\n  title: 'Night Shift',\n  doctor: 'ren',\n  scene: { before: 'S17', after: 'S18' },\n  patient: { name: 'Ada Quill', age: 40, job: 'Ferry pilot', note: 'Keeps time with the engine.', followUp: 'Home on Thursday.' },\n  timer: 180,\n  bpm: 84,\n  parScore: 1,\n  music: 'or-tense',\n  teaches: ['gel'],\n  sites: [{ id: 'arm', organ: 'forearm' }],\n  phases: [/* see below */],\n};\n```\n\n`doctor` is `ren`, `ines`, or `both`. `noTimer`, `noFail`, and `noRank` mark an operation that cannot be lost and is not graded.\n\nA phase needs an id, an `objective` string, the `tools` the wheel may use, a `spawn` list, and `done`. `say` lines are optional. Completion keys the sim already understands include `cleared`, `vitalsAbove`, `allClampsOff`, `strainDead`, and `arrestsSurvived`.\n\n```js\n{\n  id: 'clean',\n  objective: 'Disinfect the wound',\n  tools: ['gel'],\n  spawn: [{ kind: 'gelZone', site: 'arm', rect: [-0.4, -0.2, 0.8, 0.4], parTime: 14 }],\n  done: { cleared: ['gelZone'] },\n  say: [{ at: 0, who: 'bea', mood: 'stern', text: 'Gel first.' }],\n}\n```\n\nEvery touchable `at: [x, y]` must sit inside the drape ellipse `(x / 1.4)² + (y / 0.85)² ≤ 1`. The tray and the IV are fixed in `src/sim/field.js`. They are not spawn points.\n\n`skipTo(phaseId)` jumps to a phase. The dev menu's operation entries call the same loader.\n\n## Add a strain\n\n1. Spawn it from a phase: `{ kind: 'tremolo', strain: 'tremolo', site: 'arm', at: [0.1, 0.2], hp: 40 }`.\n2. Handle that `kind` in `src/sim/strains.js`, inside `stepStrains`. Read `sim.tuning` for hit points, speed, and damage. Do not call `Math.random`.\n3. If the player must meet it in the story, add the kind to some operation's `teaches` list. The union of `teaches` has to cover every strain.\n4. Give it a mesh in the view if the snapshot already carries the kind and the field still has no body for it. The sim does not import the renderer.\n\nKinds the step function already branches on: `adagio`, `hole`, `nest`, `note`, `spore`, `scratch`, `tremolo`, `legato`, `crescendo`, `fermata`, `coda`, `bleeder`, `pool`. A new kind falls through until you add the branch.\n\n## Add a story scene\n\nScenes live in `src/data/story/scenes.js` as `SCENES`. A scene has an id, a chapter, a `where`, a `set`, a `music` id, and `lines`. Each line is `{ who, mood, text }` and may set `shout: true`. One shout per scene.\n\n`who` must be a speaker in `src/data/cast.js`. Wire the scene with `scene.before` or `scene.after` on an operation. `S0` plays only at the start of a new game.\n\nKeep the whole script between 250 and 350 lines. Bea does not say \"good\" except in `S16`. Barks in `src/data/barks.js` follow the same rule. Do not put the game's title string in a line.\n\nThe shell skips a scene on Tab and advances a line on confirm. `openScene(id, onDone)` is the call.\n\n## Add a tuning value\n\n1. Add the key to `TUNING_DEFAULTS` and `TUNING_RANGES` in `src/config/tuning.js`.\n2. Put the key on a `TUNING_PAGES` group so the dev menu grows a slider.\n3. Read `sim.tuning.<key>` from the sim, the bot, or the shell on the live object. A key that never appears under `src/` fails the suite.\n4. Sliders write that same object. `resetTuning` copies the defaults back onto it, so holders of the reference see the reset. Do not replace the object.\n\nRanges are `[min, max]`. The dev menu derives the step from the span.\n\nDifficulty multipliers live in `DIFFICULTY` in the same file: `drains`, `timers`, `tol`, `miss`, and `hp`. Intern is what the menu calls Easy. The 45 to 75 percent clear check uses `sim.time / op.timer`, the data timer, not the scaled one.\n"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":1265,"output_tokens":1489,"cache_read_input_tokens":190464,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"5b66fd2b-5c70-4a71-8023-4a21e5836f3b"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-5d740b6b-3935-4677-9bf5-eaf4dd517966-132","content":"{\"type\":\"SearchReplace\",\"EditsApplied\":{\"old_string\":\"\",\"new_string\":\"# Authoring\\n\\nOperations, strains, scenes, and tuning are data plus one small piece of behavior. The sim reads them. The view and the shell do not need a new screen for each addition.\\n\\nRun `node tests/run-all.mjs sim` after a data change. It plays the shipped sim. A new operation is not done until that bot finishes it inside the same rules as the others.\\n\\n## Add an operation\\n\\n1. Add `src/data/ops/<id>.js` that default-exports one object.\\n2. Import it in `src/data/ops/index.js`. Story operations go in `OPS`, in play order. A free-play or versus operation that is not in the story goes only in `ALL_OPS`.\\n3. Give it a patient, a timer, a bpm, a music id, a `teaches` list, one or more sites, and phases.\\n4. Point `scene.before` and `scene.after` at scene ids. Use `consult: true` when the chart should offer Careful and Aggressive.\\n5. Set `parScore` from a Normal resident bot run with `physics: false` and seed 1. Do not change a locked par unless that bot's score actually moved.\\n\\n```js\\nexport default {\\n  id: 'night-shift',\\n  title: 'Night Shift',\\n  doctor: 'ren',\\n  scene: { before: 'S17', after: 'S18' },\\n  patient: { name: 'Ada Quill', age: 40, job: 'Ferry pilot', note: 'Keeps time with the engine.', followUp: 'Home on Thursday.' },\\n  timer: 180,\\n  bpm: 84,\\n  parScore: 1,\\n  music: 'or-tense',\\n  teaches: ['gel'],\\n  sites: [{ id: 'arm', organ: 'forearm' }],\\n  phases: [/* see below */],\\n};\\n```\\n\\n`doctor` is `ren`, `ines`, or `both`. `noTimer`, `noFail`, and `noRank` mark an operation that cannot be lost and is not graded.\\n\\nA phase needs an id, an `objective` string, the `tools` the wheel may use, a `spawn` list, and `done`. `say` lines are optional. Completion keys the sim already understands include `cleared`, `vitalsAbove`, `allClampsOff`, `strainDead`, and `arrestsSurvived`.\\n\\n```js\\n{\\n  id: 'clean',\\n  objective: 'Disinfect the wound',\\n  tools: ['gel'],\\n  spawn: [{ kind: 'gelZone', site: 'arm', rect: [-0.4, -0.2, 0.8, 0.4], parTime: 14 }],\\n  done: { cleared: ['gelZone'] },\\n  say: [{ at: 0, who: 'bea', mood: 'stern', text: 'Gel first.' }],\\n}\\n```\\n\\nEvery touchable `at: [x, y]` must sit inside the drape ellipse `(x / 1.4)² + (y / 0.85)² ≤ 1`. The tray and the IV are fixed in `src/sim/field.js`. They are not spawn points.\\n\\n`skipTo(phaseId)` jumps to a phase. The dev menu's operation entries call the same loader.\\n\\n## Add a strain\\n\\n1. Spawn it from a phase: `{ kind: 'tremolo', strain: 'tremolo', site: 'arm', at: [0.1, 0.2], hp: 40 }`.\\n2. Handle that `kind` in `src/sim/strains.js`, inside `stepStrains`. Read `sim.tuning` for hit points, speed, and damage. Do not call `Math.random`.\\n3. If the player must meet it in the story, add the kind to some operation's `teaches` list. The union of `teaches` has to cover every strain.\\n4. Give it a mesh in the view if the snapshot already carries the kind and the field still has no body for it. The sim does not import the renderer.\\n\\nKinds the step function already branches on: `adagio`, `hole`, `nest`, `note`, `spore`, `scratch`, `tremolo`, `legato`, `crescendo`, `fermata`, `coda`, `bleeder`, `pool`. A new kind falls through until you add the branch.\\n\\n## Add a story scene\\n\\nScenes live in `src/data/story/scenes.js` as `SCENES`. A scene has an id, a chapter, a `where`, a `set`, a `music` id, and `lines`. Each line is `{ who, mood, text }` and may set `shout: true`. One shout per scene.\\n\\n`who` must be a speaker in `src/data/cast.js`. Wire the scene with `scene.before` or `scene.after` on an operation. `S0` plays only at the start of a new game.\\n\\nKeep the whole script between 250 and 350 lines. Bea does not say \\\"good\\\" except in `S16`. Barks in `src/data/barks.js` follow the same rule. Do not put the game's title string in a line.\\n\\nThe shell skips a scene on Tab and advances a line on confirm. `openScene(id, onDone)` is the call.\\n\\n## Add a tuning value\\n\\n1. Add the key to `TUNING_DEFAULTS` and `TUNING_RANGES` in `src/config/tuning.js`.\\n2. Put the key on a `TUNING_PAGES` group so the dev menu grows a slider.\\n3. Read `sim.tuning.<key>` from the sim, the bot, or the shell on the live object. A key that never appears under `src/` fails the suite.\\n4. Sliders write that same object. `resetTuning` copies the defaults back onto it, so holders of the reference see the reset. Do not replace the object.\\n\\nRanges are `[min, max]`. The dev menu derives the step from the span.\\n\\nDifficulty multipliers live in `DIFFICULTY` in the same file: `drains`, `timers`, `tol`, `miss`, and `hp`. Intern is what the menu calls Easy. The 45 to 75 percent clear check uses `sim.time / op.timer`, the data timer, not the scaled one.\\n\",\"tool_output_for_prompt\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/docs/AUTHORING.md has been created successfully.\",\"tool_output_for_prompt_concise\":\"The file /home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/docs/AUTHORING.md has been created.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/docs/AUTHORING.md\",\"edits\":{\"details\":[{\"old_string\":\"\",\"old_line\":1,\"new_string\":\"# Authoring\\n\\nOperations, strains, scenes, and tuning are data plus one small piece of behavior. The sim reads them. The view and the shell do not need a new screen for each addition.\\n\\nRun `node tests/run-all.mjs sim` after a data change. It plays the shipped sim. A new operation is not done until that bot finishes it inside the same rules as the others.\\n\\n## Add an operation\\n\\n1. Add `src/data/ops/<id>.js` that default-exports one object.\\n2. Import it in `src/data/ops/index.js`. Story operations go in `OPS`, in play order. A free-play or versus operation that is not in the story goes only in `ALL_OPS`.\\n3. Give it a patient, a timer, a bpm, a music id, a `teaches` list, one or more sites, and phases.\\n4. Point `scene.before` and `scene.after` at scene ids. Use `consult: true` when the chart should offer Careful and Aggressive.\\n5. Set `parScore` from a Normal resident bot run with `physics: false` and seed 1. Do not change a locked par unless that bot's score actually moved.\\n\\n```js\\nexport default {\\n  id: 'night-shift',\\n  title: 'Night Shift',\\n  doctor: 'ren',\\n  scene: { before: 'S17', after: 'S18' },\\n  patient: { name: 'Ada Quill', age: 40, job: 'Ferry pilot', note: 'Keeps time with the engine.', followUp: 'Home on Thursday.' },\\n  timer: 180,\\n  bpm: 84,\\n  parScore: 1,\\n  music: 'or-tense',\\n  teaches: ['gel'],\\n  sites: [{ id: 'arm', organ: 'forearm' }],\\n  phases: [/* see below */],\\n};\\n```\\n\\n`doctor` is `ren`, `ines`, or `both`. `noTimer`, `noFail`, and `noRank` mark an operation that cannot be lost and is not graded.\\n\\nA phase needs an id, an `objective` string, the `tools` the wheel may use, a `spawn` list, and `done`. `say` lines are optional. Completion keys the sim already understands include `cleared`, `vitalsAbove`, `allClampsOff`, `strainDead`, and `arrestsSurvived`.\\n\\n```js\\n{\\n  id: 'clean',\\n  objective: 'Disinfect the wound',\\n  tools: ['gel'],\\n  spawn: [{ kind: 'gelZone', site: 'arm', rect: [-0.4, -0.2, 0.8, 0.4], parTime: 14 }],\\n  done: { cleared: ['gelZone'] },\\n  say: [{ at: 0, who: 'bea', mood: 'stern', text: 'Gel first.' }],\\n}\\n```\\n\\nEvery touchable `at: [x, y]` must sit inside the drape ellipse `(x / 1.4)² + (y / 0.85)² ≤ 1`. The tray and the IV are fixed in `src/sim/field.js`. They are not spawn points.\\n\\n`skipTo(phaseId)` jumps to a phase. The dev menu's operation entries call the same loader.\\n\\n## Add a strain\\n\\n1. Spawn it from a phase: `{ kind: 'tremolo', strain: 'tremolo', site: 'arm', at: [0.1, 0.2], hp: 40 }`.\\n2. Handle that `kind` in `src/sim/strains.js`, inside `stepStrains`. Read `sim.tuning` for hit points, speed, and damage. Do not call `Math.random`.\\n3. If the player must meet it in the story, add the kind to some operation's `teaches` list. The union of `teaches` has to cover every strain.\\n4. Give it a mesh in the view if the snapshot already carries the kind and the field still has no body for it. The sim does not import the renderer.\\n\\nKinds the step function already branches on: `adagio`, `hole`, `nest`, `note`, `spore`, `scratch`, `tremolo`, `legato`, `crescendo`, `fermata`, `coda`, `bleeder`, `pool`. A new kind falls through until you add the branch.\\n\\n## Add a story scene\\n\\nScenes live in `src/data/story/scenes.js` as `SCENES`. A scene has an id, a chapter, a `where`, a `set`, a `music` id, and `lines`. Each line is `{ who, mood, text }` and may set `shout: true`. One shout per scene.\\n\\n`who` must be a speaker in `src/data/cast.js`. Wire the scene with `scene.before` or `scene.after` on an operation. `S0` plays only at the start of a new game.\\n\\nKeep the whole script between 250 and 350 lines. Bea does not say \\\"good\\\" except in `S16`. Barks in `src/data/barks.js` follow the same rule. Do not put the game's title string in a line.\\n\\nThe shell skips a scene on Tab and advances a line on confirm. `openScene(id, onDone)` is the call.\\n\\n## Add a tuning value\\n\\n1. Add the key to `TUNING_DEFAULTS` and `TUNING_RANGES` in `src/config/tuning.js`.\\n2. Put the key on a `TUNING_PAGES` group so the dev menu grows a slider.\\n3. Read `sim.tuning.<key>` from the sim, the bot, or the shell on the live object. A key that never appears under `src/` fails the suite.\\n4. Sliders write that same object. `resetTuning` copies the defaults back onto it, so holders of the reference see the reset. Do not replace the object.\\n\\nRanges are `[min, max]`. The dev menu derives the step from the span.\\n\\nDifficulty multipliers live in `DIFFICULTY` in the same file: `drains`, `timers`, `tol`, `miss`, and `hp`. Intern is what the menu calls Easy. The 45 to 75 percent clear check uses `sim.time / op.timer`, the data timer, not the scaled one.\\n\",\"new_line\":1,\"context_before\":\"\",\"context_after\":\"\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"2dea6408-aa2a-42ed-8522-17e46fb52835"}
