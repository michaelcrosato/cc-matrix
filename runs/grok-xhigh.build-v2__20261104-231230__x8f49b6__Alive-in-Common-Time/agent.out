ll(); },\\n  ee: (g, x, y) => { g.fillStyle = '#6a2030'; g.fillRect(x - 22, y, 44, 6); },\\n  oh: (g, x, y) => { g.strokeStyle = '#6a2030'; g.lineWidth = 4; g.beginPath(); g.ellipse(x, y + 4, 12, 10, 0, 0, Math.PI * 2); g.stroke(); },\\n10→  smile: (g, x, y) => { g.strokeStyle = '#6a2030'; g.lineWidth = 4; g.beginPath(); g.arc(x, y - 6, 18, 0.2, Math.PI - 0.2); g.stroke(); },\\n  frown: (g, x, y) => { g.strokeStyle = '#6a2030'; g.lineWidth = 4; g.beginPath(); g.arc(x, y + 16, 18, Math.PI + 0.3, -0.3); g.stroke(); },\\n};\\n\\nfunction paintFace(canvas, look, expr) {\\n  const g = canvas.getContext('2d');\\n  g.clearRect(0, 0, canvas.width, canvas.height);\\n  g.fillStyle = look.skin;\\n  g.fillRect(0, 0, canvas.width, canvas.height);\\n  const cx = 256;\\n20→  const eye = expr.eyes || 'neutral';\\n  const drawEye = (x) => {\\n    g.fillStyle = '#fff';\\n    const h = eye === 'closed' ? 3 : eye === 'narrow' ? 10 : eye === 'wide' ? 22 : 16;\\n    g.beginPath();\\n    g.ellipse(x, 232, 18, h, 0, 0, Math.PI * 2);\\n    g.fill();\\n    if (eye !== 'closed') {\\n      g.fillStyle = look.iris;\\n      g.beginPath();\\n30→      g.ellipse(x, 234, 8, eye === 'narrow' ? 6 : 9, 0, 0, Math.PI * 2);\\n      g.fill();\\n      g.fillStyle = '#1a1020';\\n      g.beginPath();\\n      g.arc(x, 234, 4, 0, Math.PI * 2);\\n      g.fill();\\n      g.fillStyle = '#fff';\\n      g.fillRect(x - 6, 228, 4, 4);\\n    }\\n    g.strokeStyle = '#1a1020';\\n40→    g.lineWidth = 4;\\n    g.beginPath();\\n    g.moveTo(x - 20, 214);\\n    g.lineTo(x + 18, 210);\\n    g.stroke();\\n  };\\n  drawEye(cx - 62);\\n  drawEye(cx + 62);\\n  const brow = expr.brows || 0;\\n  g.strokeStyle = look.hair;\\n50→  g.lineWidth = 6;\\n  g.beginPath();\\n  g.moveTo(cx - 86, 196 + brow);\\n  g.lineTo(cx - 40, 190 - brow);\\n  g.moveTo(cx + 40, 190 - brow);\\n  g.lineTo(cx + 86, 196 + brow);\\n  g.stroke();\\n  g.fillStyle = 'rgba(180, 70, 80, 0.35)';\\n  g.beginPath();\\n  g.ellipse(cx - 90, 270, 16, 8, 0, 0, Math.PI * 2);\\n60→  g.ellipse(cx + 90, 270, 16, 8, 0, 0, Math.PI * 2);\\n  g.fill();\\n  g.strokeStyle = '#8a5048';\\n  g.lineWidth = 3;\\n  g.beginPath();\\n  g.moveTo(cx, 250);\\n  g.lineTo(cx - 4, 278);\\n  g.stroke();\\n  const mouth = MOUTHS[expr.mouth] || MOUTHS.shut;\\n  mouth(g, cx, 340);\\n70→  if (expr.sweat) {\\n    g.fillStyle = '#d8f4ff';\\n    g.beginPath();\\n    g.ellipse(cx + 120, 180, 6, 10, 0.4, 0, Math.PI * 2);\\n    g.fill();\\n  }\\n  if (expr.tears) {\\n    g.fillStyle = 'rgba(180, 220, 255, 0.8)';\\n    g.fillRect(cx - 70, 246, 4, 18);\\n    g.fillRect(cx + 66, 246, 4, 18);\\n80→  }\",\"content_concise\":\"1→import * as THREE from 'three/webgpu';\\nimport { toon } from './materials.js';\\nimport { castOf } from '../data/cast.js';\\n\\nconst MOUTHS = {\\n  shut: (g, x, y) => { g.fillStyle = '#6a2030'; g.fillRect(x - 18, y, 36, 4); },\\n  ah: (g, x, y) => { g.fillStyle = '#4a1020'; g.beginPath(); g.ellipse(x, y + 6, 16, 12, 0, 0, Math.PI * 2); g.fill(); },\\n  ee: (g, x, y) => { g.fillStyle = '#6a2030'; g.fillRect(x - 22, y, 44, 6); },\\n  oh: (g, x, y) => { g.strokeStyle = '#6a2030'; g.lineWidth = 4; g.beginPath(); g.ellipse(x, y + 4, 12, 10, 0, 0, Math.PI * 2); g.stroke(); },\\n10→  smile: (g, x, y) => { g.strokeStyle = '#6a2030'; g.lineWidth = 4; g.beginPath(); g.arc(x, y - 6, 18, 0.2, Math.PI - 0.2); g.stroke(); },\\n  frown: (g, x, y) => { g.strokeStyle = '#6a2030'; g.lineWidth = 4; g.beginPath(); g.arc(x, y + 16, 18, Math.PI + 0.3, -0.3); g.stroke(); },\\n};\\n\\nfunction paintFace(canvas, look, expr) {\\n  const g = canvas.getContext('2d');\\n  g.clearRect(0, 0, canvas.width, canvas.height);\\n  g.fillStyle = look.skin;\\n  g.fillRect(0, 0, canvas.width, canvas.height);\\n  const cx = 256;\\n20→  const eye = expr.eyes || 'neutral';\\n  const drawEye = (x) => {\\n    g.fillStyle = '#fff';\\n    const h = eye === 'closed' ? 3 : eye === 'narrow' ? 10 : eye === 'wide' ? 22 : 16;\\n    g.beginPath();\\n    g.ellipse(x, 232, 18, h, 0, 0, Math.PI * 2);\\n    g.fill();\\n    if (eye !== 'closed') {\\n      g.fillStyle = look.iris;\\n      g.beginPath();\\n30→      g.ellipse(x, 234, 8, eye === 'narrow' ? 6 : 9, 0, 0, Math.PI * 2);\\n      g.fill();\\n      g.fillStyle = '#1a1020';\\n      g.beginPath();\\n      g.arc(x, 234, 4, 0, Math.PI * 2);\\n      g.fill();\\n      g.fillStyle = '#fff';\\n      g.fillRect(x - 6, 228, 4, 4);\\n    }\\n    g.strokeStyle = '#1a1020';\\n40→    g.lineWidth = 4;\\n    g.beginPath();\\n    g.moveTo(x - 20, 214);\\n    g.lineTo(x + 18, 210);\\n    g.stroke();\\n  };\\n  drawEye(cx - 62);\\n  drawEye(cx + 62);\\n  const brow = expr.brows || 0;\\n  g.strokeStyle = look.hair;\\n50→  g.lineWidth = 6;\\n  g.beginPath();\\n  g.moveTo(cx - 86, 196 + brow);\\n  g.lineTo(cx - 40, 190 - brow);\\n  g.moveTo(cx + 40, 190 - brow);\\n  g.lineTo(cx + 86, 196 + brow);\\n  g.stroke();\\n  g.fillStyle = 'rgba(180, 70, 80, 0.35)';\\n  g.beginPath();\\n  g.ellipse(cx - 90, 270, 16, 8, 0, 0, Math.PI * 2);\\n60→  g.ellipse(cx + 90, 270, 16, 8, 0, 0, Math.PI * 2);\\n  g.fill();\\n  g.strokeStyle = '#8a5048';\\n  g.lineWidth = 3;\\n  g.beginPath();\\n  g.moveTo(cx, 250);\\n  g.lineTo(cx - 4, 278);\\n  g.stroke();\\n  const mouth = MOUTHS[expr.mouth] || MOUTHS.shut;\\n  mouth(g, cx, 340);\\n70→  if (expr.sweat) {\\n    g.fillStyle = '#d8f4ff';\\n    g.beginPath();\\n    g.ellipse(cx + 120, 180, 6, 10, 0.4, 0, Math.PI * 2);\\n    g.fill();\\n  }\\n  if (expr.tears) {\\n    g.fillStyle = 'rgba(180, 220, 255, 0.8)';\\n    g.fillRect(cx - 70, 246, 4, 18);\\n    g.fillRect(cx + 66, 246, 4, 18);\\n80→  }\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/view/bust.js\",\"offset\":null,\"limit\":80,\"raw_output\":\"import * as THREE from 'three/webgpu';\\nimport { toon } from './materials.js';\\nimport { castOf } from '../data/cast.js';\\n\\nconst MOUTHS = {\\n  shut: (g, x, y) =