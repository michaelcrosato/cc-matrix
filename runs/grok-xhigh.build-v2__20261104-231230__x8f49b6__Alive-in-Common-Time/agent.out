_x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/hub/site/bridge.js\",\"matches\":[{\"line_number\":238,\"content\":\"    /** The game's own card, while it is on: { left, paused, starting, ready, asking, asked } (lib/hub/README.md, \\\"The card\\\"). */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/hub/site/harness.html\",\"matches\":[{\"line_number\":26,\"content\":\"  .cell__state { margin-left: auto; color: var(--dim); }\"},{\"line_number\":29,\"content\":\"  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\"},{\"line_number\":51,\"content\":\"  <button id=\\\"release\\\" type=\\\"button\\\" title=\\\"End the splash now: the round starts once every game has loaded\\\">Start now</button>\"},{\"line_number\":181,\"content\":\"  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\"},{\"line_number\":258,\"content\":\"    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\"},{\"line_number\":266,\"content\":\"  state.splashUntil = null;\"},{\"line_number\":268,\"content\":\"  log('splash over: the round starts once every game has loaded');\"},{\"line_number\":274,\"content\":\"  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\"},{\"line_number\":278,\"content\":\"    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\"},{\"line_number\":279,\"content\":\"    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\"},{\"line_number\":298,\"content\":\"    state.splashUntil += 10_000;\"},{\"line_number\":322,\"content\":\"    log(`${cell.key} left`);\"},{\"line_number\":323,\"content\":\"    current?.coordinator.leave(cell.key, 'left');\"},{\"line_number\":350,\"content\":\"  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\"},{\"line_number\":506,\"content\":\"      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/hub/site/round.js\",\"matches\":[{\"line_number\":135,\"content\":\" * exactly once. Players already gone may be placed or left out; whoever is\"},{\"line_number\":136,\"content\":\" * left out lands in a last group of their own.\"},{\"line_number\":176,\"content\":\" * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\"},{\"line_number\":295,\"content\":\"      ...(gate ? { splash: true } : {}),\"},{\"line_number\":313,\"content\":\"    const left = present();\"},{\"line_number\":314,\"content\":\"    if (!left.length) return finishVoid('no-players');\"},{\"line_number\":316,\"content\":\"      return finishVoid(host.out === 'not-ready' ? 'host-not-ready' : 'host-left', phase === 'loading' ? 'void' : 'host-left');\"},{\"line_number\":322,\"content\":\"    if (selfReported() && left.every((s) => s.result)) finishResults();\"},{\"line_number\":356,\"content\":\"    // Whoever reported and then left keeps their place: only those who left with nothing count as beaten.\"},{\"line_number\":466,\"content\":\"  function leave(key, reason = 'left') {\"},{\"line_number\":482,\"content\":\"    // A gated round waits on the hub's splash, however long it holds: only\"},{\"line_number\":491,\"content\":\"  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/hub/site/game.html\",\"matches\":[{\"line_number\":41,\"content\":\"    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\"},{\"line_number\":42,\"content\":\"    splash: false,\"},{\"line_number\":248,\"content\":\"      hub.splash = m.splash === true;\"},{\"line_number\":325,\"content\":\"  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\"},{\"line_number\":410,\"content\":\"   * (a cycle, a BigInt) is left out, not the whole outcome.\"},{\"line_number\":422,\"content\":\"      else if (outcome[key] !== undefined) warn('the outcome\\\\'s ' + key + ' is not JSON: left out');\"},{\"line_number\":508,\"content\":\"<meta name=\\\"hub:session-howto\\\" content=\\\"Aim: right stick or mouse · use: R2 or click · tools: left stick or 1-8\\\">\"},{\"line_number\":510,\"content\":\"@font-face{font-family:Bangers;src:url(data:font/woff2;base64, [... truncated (1031 chars total)]\"},{\"line_number\":569,\"content\":\"var ye=\\\"Alive in Common Time\\\",tD=\\\"A heart is a metronome\\\";var _C=Object.freeze({tipSpeed:1.9,stickCurve:1.7,aimAssist:.35,steadyFactor:.4,scalpelTol:.055,pullTol:1.6,suctionRate:1,gelRadius:.16,stitchGateR:.07,laserDps:30,laserBurn:2,scannerRadius:.3,clampWindow:.18,defibWindow:.3,drainMult:1,timerMult:1,tempoPressure:60,stabilizerHeal:15,stabilizerCooldown:3,missLimit:8,strainHpMult:1,strainSpeedMult:1,spawnRateMult:1,composureGain:1,hushDuration:7,hushTi