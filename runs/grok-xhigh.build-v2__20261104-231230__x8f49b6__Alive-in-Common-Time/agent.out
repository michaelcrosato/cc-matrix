=> window.__game.state().glyphSet)) === 'xbox', 'glyphs');\"},{\"line_number\":283,\"content\":\"    check('xbox prompt set', (await page.evaluate(() => document.documentElement.dataset.promptSet)) === 'xbox', 'set');\"},{\"line_number\":288,\"content\":\"    check('save survives reload', saved && (await page.evaluate(() => localStorage.getItem('st-alder-chart'))) === saved, 'storage');\"},{\"line_number\":294,\"content\":\"    check('lobby opens', (await page.evaluate(() => window.__game.state().screen)) === 'Lobby', 'screen');\"},{\"line_number\":321,\"content\":\"    check('two tips move', couch.dx[0] > couch.dx[1] + 0.4, JSON.stringify(couch.dx));\"},{\"line_number\":322,\"content\":\"    check('both seats score', couch.scores.length === 2 && couch.scores.every((n) => n > 0), JSON.stringify(couch.scores));\"},{\"line_number\":328,\"content\":\"    check('fail screen', (await page.evaluate(() => window.__game.state().screen)) === 'Fail', 'screen');\"},{\"line_number\":346,\"content\":\"    check('audio is not silent', quiet.length === 0, quiet.join(', '));\"},{\"line_number\":363,\"content\":\"        check('playthrough stays up', false, `${info.op} ${info.phase} vitals ${info.vitals}`);\"},{\"line_number\":378,\"content\":\"      check(`reached ${name}`, reached.includes(name), reached.join(','));\"},{\"line_number\":380,\"content\":\"    check('page errors', errors.length === 0, errors.slice(0, 4).join(' | '));\"},{\"line_number\":397,\"content\":\"    check(`${kind} touch notice`, screen === 'Touch notice' && text.includes('Controller or keyboard required'), `${screen} ${text.slice(0, 80)}`);\"},{\"line_number\":399,\"content\":\"    check(`${kind} settings tap`, (await page.evaluate(() => window.__game.state().screen)) === 'Settings', 'screen');\"},{\"line_number\":403,\"content\":\"    check(`${kind} attract`, Date.now() - t0 >= 9000 && Date.now() - t0 <= 11000, 'timing');\"},{\"line_number\":404,\"content\":\"    check(`${kind} attract keeps the notice`, (await page.evaluate(() => document.body.innerText.includes('Controller or keyboard required'))), 'copy');\"},{\"line_number\":415,\"content\":\"    check(`${kind} pad leaves notice`, (await page.evaluate(() => window.__game.state().screen)) === 'Title', 'screen');\"},{\"line_number\":416,\"content\":\"    check(`${kind} page errors`, errors.length === 0, errors.slice(0, 3).join(' | '));\"},{\"line_number\":434,\"content\":\"    check(`${name} boots`, state.screen === 'Title' || documentTitle(state), state.screen);\"},{\"line_number\":435,\"content\":\"    if (want) check(`${name} backend`, state.renderBackend === want, state.renderBackend);\"},{\"line_number\":436,\"content\":\"    check(`${name} shot`, shot.length > 12000, `${shot.length} bytes`);\"},{\"line_number\":437,\"content\":\"    check(`${name} errors`, errors.length === 0, errors.slice(0, 3).join(' | '));\"}]}]}","is_error":false},{"type":"tool_result","tool_use_id":"call-175f5617-c5c6-489f-b3e0-eeb46f98d590-21","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { Worker } from 'node:worker_threads';\\nimport { ALL_OPS, storyOrder } from '../src/data/ops/index.js';\\nimport { ruleTests } from './sim/rules.mjs';\\n\\nconst which = process.argv[2] || 'all';\\nconst suites = which === 'all' ? ['sim', 'browser', 'hub'] : [which];\\nconst fails = [];\\nlet passed = 0;\\n\\n10→function fail(name, message) {\\n  fails.push({ name, message });\\n  console.log(`FAIL ${name}: ${message}`);\\n}\\n\\nfunction openPool(width) {\\n  const url = new URL('./sim/worker.mjs', import.meta.url);\\n  const workers = Array.from({ length: width }, () => {\\n    const worker = new Worker(url);\\n    const queue = [];\\n20→    let busy = false;\\n    const pump = () => {\\n      if (busy || !queue.length) return;\\n      busy = true;\\n      const item = queue.shift();\\n      worker.current = item;\\n      worker.postMessage(item.job);\\n    };\\n    worker.on('message', (message) => {\\n      const item = worker.current;\\n30→      worker.current = null;\\n      busy = false;\\n      item.resolve(message);\\n      pump();\\n    });\\n    worker.on('error', (err) => {\\n      const item = worker.current;\\n      busy = false;\\n      worker.current = null;\\n      if (item) item.reject(err);\\n40→      pump();\\n    });\\n    return {\\n      run(job) {\\n        return new Promise((resolve, reject) => {\\n          queue.push({ job, resolve, reject });\\n          pump();\\n        });\\n      },\\n      close() {\\n50→        return worker.terminate();\\n      },\\n    };\\n  });\\n  let cursor = 0;\\n  return {\\n    async run(jobs) {\\n      const out = new Array(jobs.length);\\n      async function take(slot) {\\n        while (cursor < jobs.length) {\\n60→          const index = cursor;\\n          cursor += 1;\\n          out[index] = { job: jobs[index], result: await slot.run(jobs[index]) };\\n        }\\n      }\\n      await Promise.all(workers.map((slot) => take(slot)));\\n      return out;\\n    },\\n    async close() {\\n      await Promise.all(workers.map((slot) => slot.close()));\\n70→    },\\n  };\\n}\\n\\nfunction simJobs() {\\n  const jobs = [];\\n  for (const id of storyOrder()) jobs.push({ id, mode: 'normal', players: 1, name: `normal ${id}` });\\n  for (const players of [1, 2, 3, 4]) {\\n    jobs.push({\\n      id: 'grand-rounds',\\n80→      mode: 'normal',\\n      players,\\n      measure: players === 4,\\n      name: `normal grand-rounds ${players}`,\\n    });\\n  }\\n  for (const id of storyOrder()) jobs.push({ id, mode: 'sloppy', players: 1, name: `sloppy ${id}` });\\n  jobs.push({ id: 'grand-rounds', mode: 'sloppy', players: 1, name: 'sloppy grand-rounds 1' });\\n  for (const op of ALL_OPS) jobs.push({ id: op.id, mode: 'idle', players: 1, name: `idle ${op.id}` });\\n  return jobs;\\n90→}\\n\\nasync function runSim() {\\n  const rules = ruleTests();\\n  for (const message of rules.fails) fail('rules', message);\\n  passed += rules.passed;\\n  const jobs = simJobs();\\n  const pool = openPool(4);\\n  const results = await pool.run(jobs);\\n  await pool.close();\\n100→  for (const { job, result } of results) {\\n    if (result.fail) fail(job.name, result.fail);\\n    else passed += 1;\\n    if (job.measure) {\\n      if (result.maxS > 1100) fail(job.name, `snapshot ${result.maxS} bytes`);\\n      else passed += 1;\\n      if (result.maxK > 16384) fail(job.name, `keyframe ${result.maxK} bytes`);\\n      else passed += 1;\\n    }\\n  }\\n110→}\\n\\nasync function runBrowser() {\\n  const { browserTests } = await import('./browser/suite.mjs');\\n  const result = await browserTests();\\n  for (const message of result.fails) fail('browser', message);\\n  passed += result.passed;\\n}\\n\\nasync function runHub() {\\n120→  const { hubTests } = await import('./hub/suite.mjs');\",\"content_concise\":\"1→import { Worker } from 'node:worker_threads';\\nimport { ALL_OPS, storyOrder } from '../src/data/ops/index.js';\\nimport { ruleTests } from './sim/rules.mjs';\\n\\nconst which = process.argv[2] || 'all';\\nconst suites = which === 'all' ? ['sim', 'browser', 'hub'] : [which];\\nconst fails = [];\\nlet passed = 0;\\n\\n10→function fail(name, message) {\\n  fails.push({ name, message });\\n  console.log(`FAIL ${name}: ${message}`);\\n}\\n\\nfunction openPool(width) {\\n  const url = new URL('./sim/worker.mjs', import.meta.url);\\n  const workers = Array.from({ length: width }, () => {\\n    const worker = new Worker(url);\\n    const queue = [];\\n20→    let busy = false;\\n    const pump = () => {\\n      if (busy || !queue.length) return;\\n      busy = true;\\n      const item = queue.shift();\\n      worker.current = item;\\n      worker.postMessage(item.job);\\n    };\\n    worker.on('message', (message) => {\\n      const item = worker.current;\\n30→      worker.current = null;\\n      busy = false;\\n      item.resolve(message);\\n      pump();\\n    });\\n    worker.on('error', (err) => {\\n      const item = worker.current;\\n      busy = false;\\n      worker.current = null;\\n      if (item) item.reject(err);\\n40→      pump();\\n    });\\n    return {\\n      run(job) {\\n        return new Promise((resolve, reject) => {\\n          queue.push({ job, resolve, reject });\\n          pump();\\n        });\\n      },\\n      close() {\\n50→        return worker.terminate();\\n      },\\n    };\\n  });\\n  let cursor = 0;\\n  return {\\n    async run(jobs) {\\n      const out = new Array(jobs.length);\\n      async function take(slot) {\\n        while (cursor < jobs.length) {\\n60→          const index = cursor;\\n          cursor += 1;\\n          out[index] = { job: jobs[index], result: await slot.run(jobs[index]) };\\n        }\\n      }\\n      await Promise.all(workers.map((slot) => take(slot)));\\n      return out;\\n    },\\n    async close() {\\n      await Promise.all(workers.map((slot) => slot.close()));\\n70→    },\\n  };\\n}\\n\\nfunction simJobs() {\\n  const jobs = [];\\n  for (const id of storyOrder()) jobs.push({ id, mode: 'normal', players: 1, name: `normal ${id}` });\\n  for (const players of [1, 2, 3, 4]) {\\n    jobs.push({\\n      id: 'grand-rounds',\\n80→      mode: 'normal',\\n      players,\\n      measure: players === 4,\\n      name: `normal grand-rounds ${players}`,\\n    });\\n  }\\n  for (const id of storyOrder()) jobs.push({ id, mode: 'sloppy', players: 1, name: `sloppy ${id}` });\\n  jobs.push({ id: 'grand-rounds', mode: 'sloppy', players: 1, name: 'sloppy grand-rounds 1' });\\n  for (const op of ALL_OPS) jobs.push({ id: op.id, mode: 'idle', players: 1, name: `idle ${op.id}` });\\n  return jobs;\\n90→}\\n\\nasync function runSim() {\\n  const rules = ruleTests();\\n  for (const message of rules.fails) fail('rules', message);\\n  passed += rules.passed;\\n  const jobs = simJobs();\\n  const pool = openPool(4);\\n  const results = await pool.run(jobs);\\n  await pool.close();\\n100→  for (const { job, result } of results) {\\n    if (result.fail) fail(job.name, result.fail);\\n    else passed += 1;\\n    if (job.measure) {\\n      if (result.maxS > 1100) fail(job.name, `snapshot ${result.maxS} bytes`);\\n      else passed += 1;\\n      if (result.maxK > 16384) fail(job.name, `keyframe ${result.maxK} bytes`);\\n      else passed += 1;\\n    }\\n  }\\n110→}\\n\\nasync function runBrowser() {\\n  const { browserTests } = await import('./browser/suite.mjs');\\n  const result = await browserTests();\\n  for (const message of result.fails) fail('browser', message);\\n  passed += result.passed;\\n}\\n\\nasync function runHub() {\\n120→  const { hubTests } = await import('./hub/suite.mjs');\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/run-all.mjs\",\"offset\":null,\"limit\":120,\"raw_output\":\"import { Worker } from 'node:worker_threads';\\nimport { ALL_OPS, storyOrder } from '../src/data/ops/index.js';\\nimport { ruleTests } from './sim/rules.mjs';\\n\\nconst which = process.argv[2] || 'all';\\nconst suites = which === 'all' ? ['sim', 'browser', 'hub'] : [which];\\nconst fails = [];\\nlet passed = 0;\\n\\nfunction fail(name, message) {\\n  fails.push({ name, message });\\n  console.log(`FAIL ${name}: ${message}`);\\n}\\n\\nfunction openPool(width) {\\n  const url = new URL('./sim/worker.mjs', import.meta.url);\\n  const workers = Array.from({ length: width }, () => {\\n    const worker = new Worker(url);\\n    const queue = [];\\n    let busy = false;\\n    const pump = () => {\\n      if (busy || !queue.length) return;\\n      busy = true;\\n      const item = queue.shift();\\n      worker.current = item;\\n      worker.postMessage(item.job);\\n    };\\n    worker.on('message', (message) => {\\n      const item = worker.current;\\n      worker.current = null;\\n      busy = false;\\n      item.resolve(message);\\n      pump();\\n    });\\n    worker.on('error', (err) => {\\n      const item = worker.current;\\n      busy = false;\\n      worker.current = null;\\n      if (item) item.reject(err);\\n      pump();\\n    });\\n    return {\\n      run(job) {\\n        return new Promise((resolve, reject) => {\\n          queue.push({ job, resolve, reject });\\n          pump();\\n        });\\n      },\\n      close() {\\n        return worker.terminate();\\n      },\\n    };\\n  });\\n  let cursor = 0;\\n  return {\\n    async run(jobs) {\\n      const out = new Array(jobs.length);\\n      async function take(slot) {\\n        while (cursor < jobs.length) {\\n          const index = cursor;\\n          cursor += 1;\\n          out[index] = { job: jobs[index], result: await slot.run(jobs[index]) };\\n        }\\n      }\\n      await Promise.all(workers.map((slot) => take(slot)));\\n      return out;\\n    },\\n    async close() {\\n      await Promise.all(workers.map((slot) => slot.close()));\\n    },\\n  };\\n}\\n\\nfunction simJobs() {\\n  const jobs = [];\\n  for (const id of storyOrder()) jobs.push({ id, mode: 'normal', players: 1, name: `normal ${id}` });\\n  for (const players of [1, 2, 3, 4]) {\\n    jobs.push({\\n      id: 'grand-rounds',\\n      mode: 'normal',\\n      players,\\n      measure: players === 4,\\n      name: `normal grand-rounds ${players}`,\\n    });\\n  }\\n  for (const id of storyOrder()) jobs.push({ id, mode: 'sloppy', players: 1, name: `sloppy ${id}` });\\n  jobs.push({ id: 'grand-rounds', mode: 'sloppy', players: 1, name: 'sloppy grand-rounds 1' });\\n  for (const op of ALL_OPS) jobs.push({ id: op.id, mode: 'idle', players: 1, name: `idle ${op.id}` });\\n  return jobs;\\n}\\n\\nasync function runSim() {\\n  const rules = ruleTests();\\n  for (const message of rules.fails) fail('rules', message);\\n  passed += rules.passed;\\n  const jobs = simJobs();\\n  const pool = openPool(4);\\n  const results = await pool.run(jobs);\\n  await pool.close();\\n  for (const { job, result } of results) {\\n    if (result.fail) fail(job.name, result.fail);\\n    else passed += 1;\\n    if (job.measure) {\\n      if (result.maxS > 1100) fail(job.name, `snapshot ${result.maxS} bytes`);\\n      else passed += 1;\\n      if (result.maxK > 16384) fail(job.name, `keyframe ${result.maxK} bytes`);\\n      else passed += 1;\\n    }\\n  }\\n}\\n\\nasync function runBrowser() {\\n  const { browserTests } = await import('./browser/suite.mjs');\\n  const result = await browserTests();\\n  for (const message of result.fails) fail('browser', message);\\n  passed += result.passed;\\n}\\n\\nasync function runHub() {\\n  const { hubTests } = await import('./hub/suite.mjs');\\n\",\"total_lines\":136}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"657a089a-bddd-42d0-aefa-2187805f2d93"}
