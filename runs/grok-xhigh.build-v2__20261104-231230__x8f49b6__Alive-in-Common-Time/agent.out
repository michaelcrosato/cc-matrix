000) / 1000;\\n\\nexport function line(x0, y0, x1, y1, n = 16) {\\n  const pts = [];\\n  for (let i = 0; i < n; i++) {\\n    const t = n === 1 ? 0 : i / (n - 1);\\n    pts.push([r(x0 + (x1 - x0) * t), r(y0 + (y1 - y0) * t)]);\\n10→  }\\n  return pts;\\n}\\n\\n/** Gates spaced about 0.2 apart so a late release still sits inside the tear radius. */\\nexport function gates(x0, y0, x1, y1, n) {\\n  const g = [];\\n  for (let i = 0; i < n; i++) {\\n    const t = n === 1 ? 0 : i / (n - 1);\\n    const x = x0 + (x1 - x0) * t;\\n20→    const y = y0 + (y1 - y0) * t + Math.sin(t * Math.PI) * 0.06;\\n    g.push([r(x), r(y)]);\\n  }\\n  return g;\\n}\\n\\nexport function gel(x0 = -1.02, y0 = -0.46, x1 = 0.78, y1 = 0.46) {\\n  return [x0, y0, x1, y1];\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/data/ops/shape.js\",\"offset\":null,\"limit\":80,\"raw_output\":\"/** Plain coordinate helpers. Operations call these once at load and store the arrays. */\\n\\nconst r = (n) => Math.round(n * 1000) / 1000;\\n\\nexport function line(x0, y0, x1, y1, n = 16) {\\n  const pts = [];\\n  for (let i = 0; i < n; i++) {\\n    const t = n === 1 ? 0 : i / (n - 1);\\n    pts.push([r(x0 + (x1 - x0) * t), r(y0 + (y1 - y0) * t)]);\\n  }\\n  return pts;\\n}\\n\\n/** Gates spaced about 0.2 apart so a late release still sits inside the tear radius. */\\nexport function gates(x0, y0, x1, y1, n) {\\n  const g = [];\\n  for (let i = 0; i < n; i++) {\\n    const t = n === 1 ? 0 : i / (n - 1);\\n    const x = x0 + (x1 - x0) * t;\\n    const y = y0 + (y1 - y0) * t + Math.sin(t * Math.PI) * 0.06;\\n    g.push([r(x), r(y)]);\\n  }\\n  return g;\\n}\\n\\nexport function gel(x0 = -1.02, y0 = -0.46, x1 = 0.78, y1 = 0.46) {\\n  return [x0, y0, x1, y1];\\n}\\n\",\"total_lines\":28}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df