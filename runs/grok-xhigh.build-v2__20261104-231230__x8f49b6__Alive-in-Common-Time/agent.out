.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\"},{\"line_number\":224,\"content\":\"    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\"},{\"line_number\":254,\"content\":\"  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\"},{\"line_number\":258,\"content\":\"    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\"},{\"line_number\":259,\"content\":\"    tickCard(state);\"},{\"line_number\":266,\"content\":\"  state.splashUntil = null;\"},{\"line_number\":267,\"content\":\"  tickCard(state);\"},{\"line_number\":272,\"content\":\"/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\"},{\"line_number\":273,\"content\":\"function tickCard(state) {\"},{\"line_number\":274,\"content\":\"  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\"},{\"line_number\":278,\"content\":\"    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\"},{\"line_number\":279,\"content\":\"    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\"},{\"line_number\":280,\"content\":\"    if (cell.cardSent === id) continue;\"},{\"line_number\":281,\"content\":\"    cell.cardSent = id;\"},{\"line_number\":282,\"content\":\"    cell.bridge.card(card);\"},{\"line_number\":286,\"content\":\"/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\"},{\"line_number\":298,\"content\":\"    state.splashUntil += 10_000;\"},{\"line_number\":300,\"content\":\"  log(`${cell.key} answers ${what} on the game's card`);\"},{\"line_number\":303,\"content\":\"  tickCard(state);\"},{\"line_number\":350,\"content\":\"  if (s.gate && !s.released) lines.push(`Card: ${state.cells.some((c) => c.bridge.showsCard) ? 'the game’s own, ' : ''}${state.splashUntil ? `${Math.max(0, Math.ceil((state.splashUntil - performance.now()) / 1000))} s left` : 'held'} (Start now ends it)`);\"},{\"line_number\":440,\"content\":\"    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\"},{\"line_number\":442,\"content\":\"    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\"},{\"line_number\":443,\"content\":\"    // A game that shows its own card takes the players' answers on it: Enter is Ready.\"},{\"line_number\":444,\"content\":\"    if (caps.some((c) => c?.card)) {\"},{\"line_number\":446,\"content\":\"      const sent = await until(() => players.every((c) => c.cardSent), 2000);\"},{\"line_number\":449,\"content\":\"      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\"},{\"line_number\":453,\"content\":\"    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\"},{\"line_number\":456,\"content\":\"    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"cb68a64e-e30d-4418-8568-b92917d62239"}
