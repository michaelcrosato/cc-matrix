ning, opts);\\n    }\\n  }\\n\\n  if (slow && codaUp && !coreNow) {\",\"new_line\":433,\"context_before\":\"    return { source: 'stick', x: 0, y: 0, use: 0, special: true, tool: me.tool };\\n  }\\n\\n\",\"context_after\":\"    const bats = state.entities.filter((e) => e.kind === 'baton' && e.hp > 0);\\n    if (bats.length) {\\n      let bat = bats.find((b) => b.id === mem.batonId);\\n\",\"line_prefix\":\"\"}]}}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"a0005c0e-db74-47d9-b2d5-a4b568073cea"}
