, String(Math.max(0, Math.ceil(model.card.left / 1000))));\\n    }\\n    if (st) {\\n      set('[data-live=\\\"vitals\\\"]', st.vitals == null ? '' : String(Math.round(st.vitals)));\\n      set('[data-live=\\\"timer\\\"]', st.timer == null ? '' : clock(st.timer));\\n      set('[data-live=\\\"score\\\"]', st.score == null ? '' : String(st.score));\\n      set('[data-live=\\\"bpm\\\"]', st.bpm == null ? '' : String(Math.round(st.bpm)));\\n      const tool = st.tool;\\n      model.ui.querySelectorAll('[data-tool]').forEach((b) => b.classList.toggle('on', b.dataset.tool === tool));\\n    }\\n  }\\n\\n  function liveState() {\\n    if (model.sim) {\\n      return {\\n        vitals: model.sim.vitals,\\n        timer: model.sim.noTimer ? null : model.sim.timer,\\n        score: model.sim.score,\\n        bpm: model.sim.beat?.bpm,\\n        tool: model.sim.seats[0]?.tool,\\n      };\\n    }\\n    return null;\\n  }\\n\\n  function touchHtml() {\\n    return `<section class=\\\"screen\\\"><p class=\\\"touch-copy\\\">Controller or keyboard required</p><div class=\\\"menu\\\">${btn({ id: 'settings', label: 'Settings' }, model.focus)}</div></section>`;\\n  }\\n\\n  function pageDots() {\\n    const n = pageCount();\\n    if (n <= 1) return '';\\n    return `<p class=\\\"pages\\\">Page ${model.page + 1} / ${n}</p>`;\\n  }\\n\\n  function hudHtml() {\\n    const sim = model.sim;\\n    const op = sim?.op || safeOp(model.opId);\\n    const objective = sim?.objective || sim?.phase?.objective || '';\\n    const seats = sim?.seats || [];\\n    const seat = seats[0];\\n    const tools = (sim?.phase?.tools || []).join(' ');\\n    const sites = op?.sites || [];\\n    const siteBits = sites.length > 1 ? sites.map((s) => `<button type=\\\"button\\\" data-item=\\\"site:${esc(s.id)}\\\" class=\\\"item${s.id === sim?.activeSite ? ' on' : ''}\\\">${esc(s.organ || s.id)}</button>`).join('') : '';\\n    const wheel = WHEEL.map((tool) => `<button type=\\\"button\\\" data-tool=\\\"${tool}\\\" class=\\\"${seat?.tool === tool ? 'on' : ''}\\\">${esc(tool)}</button>`).join('');\\n    const prompt = fillPrompt('{special} gift   {syringe} stabilizer   {pause} pause', model.input?.promptSet || 'keyboard');\\n    const bark = model.bark ? `<div class=\\\"bark\\\"><p class=\\\"who\\\">${esc(castOf(model.bark.who).name)}</p><p>${esc(model.bark.text)}</p></div>` : '';\\n    return `<div class=\\\"hud\\\"><div class=\\\"hud-top\\\"><p class=\\\"obj\\\">${esc(objective)}</p><div class=\\\"hud-mid\\\"><p class=\\\"vitals\\\" data-live=\\\"vitals\\\">${sim ? Math.round(sim.vitals) : ''}</p><div class=\\\"ecg-line\\\" id=\\\"ecg\\\"></div><p class=\\\"timer bpm\\\" data-live=\\\"bpm\\\">${sim ? Math.round(sim.beat.bpm) : ''}</p></div><div class=\\\"hud-mid\\\"><p class=\\\"timer\\\" data-live=\\\"timer\\\">${sim && !sim.noTimer ? clock(sim.timer) : ''}</p><p class=\\\"score\\\" data-live=\\\"score\\\">${sim ? sim.score : ''}</p></div></div><div></div><div class=\\\"hud-bot\\\"><div class=\\\"wheel\\\">${wheel}</div><div>${bark}<p class=\\\"note\\\">${esc(tools)}</p><div class=\\\"pages\\\">${siteBits}</div></div><div class=\\\"note\\\">${prompt}</div></div></div>`;\\n  }\\n\\n  function chartHtml() {\\n    const op = safeOp(model.opId);\\n    const p = op?.patient || {};\\n    const diff = DIFFICULTY[model.settings.difficulty]?.label || 'Resident';\\n    const items = chartItems();\\n    return `<section class=\\\"screen\\\"><p class=\\\"who\\\">${esc(op?.title || '')}</p><h1 class=\\\"big\\\">${esc(p.name || '')}</h1><p class=\\\"note\\\">${esc(p.age || '')} · ${esc(p.job || '')}</p><p class=\\\"obj\\\">${esc(p.note || '')}</p><p class=\\\"note\\\">Difficulty ${esc(diff)}. Left and right change it.</p><div class=\\\"menu\\\">${items.map(btn).join('')}</div></section>`;\\n  }\\n\\n  function reportHtml() {\\n    const sim = model.sim;\\n    const op = safeOp(model.opId);\\n    const rank = sim?.rank;\\n    const accuracy = sim?.seats?.[0]?.stats?.Accuracy ?? 100;\\n    const seats = (sim?.seats || []).filter((s) => !s.out).map((s) => `<p class=\\\"note\\\">${esc(s.name)} ${s.score}</p>`).join('');\\n    return `<section class=\\\"screen\\\"><p class=\\\"big\\\">${esc(rank?.id || '')}</p><p class=\\\"obj\\\">${esc(rank?.title || sim?.report?.text || '')}</p><div class=\\\"row\\\"><span>Time</span><span>${esc(clock(sim?.time || 0))}</span></div><div class=\\\"row\\\"><span>Vitals</span><span>${esc(Math.round(sim?.vitalsMin ?? sim?.vitals ?? 0))}</span></div><div class=\\\"row\\\"><span>Precision</span><span>${esc(accuracy)}</span></div><div class=\\\"row\\\"><span>Best Combo</span><span>${esc(sim?.bestCombo || 0)}</span></div><p class=\\\"note\\\">${esc(op?.patient?.followUp || '')}</p>${seats}<div class=\\\"menu\\\">${btn({ id: 'report-next', label: 'Continue' }, 0)}</div></section>`;\\n  }\\n\\n  function failHtml() {\\n    const reason = FAIL_TITLE[model.sim?.failed] || 'FLATLINE';\\n    const line = barkText('fail', null, 0);\\n    return `<section class=\\\"screen\\\"><h1 class=\\\"fail-title\\\">${esc(reason)}</h1><div class=\\\"bark\\\"><p class=\\\"who\\\">Bea</p><p>${esc(line)}</p></div><div class=\\\"menu\\\">${failItems().map(btn).join('')}</div></section>`;\\n  }\\n\\n  function lobbyHtml() {\\n    const items = lobbyItems();\\n    const prompt = fillPrompt('Press {confirm} to join', model.input?.promptSet || 'keyboard');\\n    return `<section class=\\\"screen\\\"><h1 class=\\\"big\\\">Grand Rounds</h1><p class=\\\"note\\\">${prompt}</p><div class=\\\"seats\\\">${[0, 1, 2, 3].map((i) => `<div class=\\\"seat\\\" style=\\\"color:${COLORS[i]}\\\">${model.joined.has(i) ? 'In' : 'Open'}</div>`).join('')}</div><div class=\\\"menu\\\">${items.map(btn).join('')}</div></section>`;\\n  }\\n\\n  function aboutHtml() {\\n    const slides = aboutSlides();\\n    const page = ((model.page % slides.length) + slides.length) % slides.length;\\n    const slide = slides[page];\\n    const tabs = aboutItems().map((item) => {\\n      const on = item.head === slide.head ? ' on' : '';\\n      return `<button class=\\\"item${on}\\\" data-item=\\\"${esc(item.id)}\\\" type=\\\"button\\\">${esc(item.label)}</button>`;\\n    }).join('');\\n    const body = slide.lines.map((line) => `<p class=\\\"about-line\\\">${esc(line)}</p>`).join('');\\n    const part = slide.parts > 1 ? `<p class=\\\"note\\\">${slide.part} / ${slide.parts}</p>` : '';\\n    return `<section class=\\\"screen about-fit\\\"><div class=\\\"tabs\\\">${tabs}</div><h1 class=\\\"obj\\\">${esc(slide.label)}</h1><div class=\\\"page on\\\">${body}</div>${part}</section>`;\\n  }\\n\\n  function paintCard(ui) {\\n    ui.replaceChildren();\\n    const wrap = document.createElement('section');\\n    wrap.className = 'screen card';\\n    const h = document.createElement('h1');\\n    h.className = 'logo';\\n    h.textContent = GAME_TITLE;\\n    const tag = document.createElement('p');\\n    tag.className = 'tag';\\n    tag.textContent = TAGLINE;\\n    const goal = document.createElement('p');\\n    goal.className = 'obj';\\n    goal.textContent = 'Keep the patient alive and finish the operation together';\\n    const list = document.createElement('div');\\n    list.className = 'seats';\\n    const ready = new Set(model.card?.ready || []);\\n    for (const p of model.sessionInfo?.players || []) {\\n      const seat = document.createElement('div');\\n      seat.className = 'seat';\\n      if (/^#[0-9a-fA-F]{3,8}$/.test(p.color || '')) seat.style.color = p.color;\\n      seat.textContent = `${p.name || 'Surgeon'}${ready.has(p.id) ? ' ready' : ''}`;\\n      list.append(seat);\\n    }\\n    const secs = document.createElement('p');\\n    secs.className = 'vitals';\\n    secs.dataset.live = 'card';\\n    if (model.card?.left != null) secs.textContent = String(Math.max(0, Math.ceil(model.card.left / 1000)));\\n    const how = document.createElement('p');\\n    how.className = 'note';\\n    how.textContent = 'Aim with the right stick or the mouse. Use with R2 or click. Tools are the left stick or the number keys.';\\n    const menu = document.createElement('div');\\n    menu.className = 'menu';\\n    for (const item of [{ id: 'ready', label: 'Ready' }, { id: 'more', label: 'More Time' }]) {\\n      const b = document.createElement('button');\\n      b.type = 'button';\\n      b.className = 'item';\\n      b.dataset.item = item.id;\\n      b.textContent = item.label;\\n      menu.append(b);\\n    }\\n    wrap.append(h, tag, goal, list, secs, how, menu);\\n    ui.append(wrap);\\n  }\\n\\n  function state() {\\n    const sim = model.sim;\\n    const net = !sim ? model.netState : null;\\n    const seats = sim?.seats || net?.seats || [];\\n    const seat = seats.find((s) => !s.out) || seats[0];\\n    const items = currentItems();\\n    const rank = sim?.rank?.id || (typeof net?.rank === 'string' ? net.rank : net?.rank?.id) || null;\\n    return {\\n      screen: model.screen,\\n      op: sim?.op?.id || net?.op || null,\\n      phase: sim?.phase?.id || net?.phase || null,\\n      vitals: sim ? sim.vitals : (net?.vitals ?? null),\\n      timer: sim ? sim.timer : (net?.timer ?? null),\\n      score: sim ? sim.score : (net?.score ?? 0),\\n      rank,\\n      bpm: sim ? sim.beat.bpm : (net?.bpm ?? null),\\n      beat: sim ? sim.beat.count : (net?.beat ?? 0),\\n      site: sim ? sim.activeSite : (net?.site ?? null),\\n      tool: seat?.tool || null,\\n      tips: seats.map((s) => ({ id: s.id, x: s.x, y: s.y, tool: s.tool, score: s.score || 0, use: s.use || 0 })),\\n      focusId: items[model.focus]?.id || null,\\n      promptSet: model.input?.promptSet || document.documentElement.dataset.promptSet || 'keyboard',\\n      glyphSet: model.settings.glyphs || 'playstation',\\n      attract: !!model.attract.on,\\n      devOpen: model.overlay === 'dev',\\n      renderBackend: model.view?.backend || 'none',\\n      musicGain: model.audio?.music?.gain?.value ?? 0.1,\\n      tuning: model.tuning,\\n      reached: [...model.reached],\\n      cardLeft: model.card?.left ?? null,\\n      countN: model.countN || 0,\\n    };\\n  }\\n\\n  const api = {\\n    state,\\n    audio,\\n    devRun(id, arg) { return runDev(model, id, arg); },\\n  };\\n  if (model.test) {\\n    api.test = {\\n      step(n) {\\n        const count = Math.max(0, n | 0);\\n        for (let i = 0; i < count; i++) stepOnce();\\n      },\\n      warp(n) { model.warp = n | 0; },\\n      input(frame) { model.override = frame || null; },\\n      bot(on, opts) {\\n        model.botOn = !!on;\\n        if (opts) model.botOpts = opts;\\n\",\"total_lines\":1760}}","is_error":false},{"type":"tool_result","tool_use_id":"call-19b27757-b31b-4292-b3ce-48375b8e21f8-5","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import http from 'node:http';\\nimport { existsSync, readFileSync, readdirSync } from 'node:fs';\\nimport path from 'node:path';\\nimport { fileURLToPath, pathToFileURL } from 'node:url';\\nimport { chromium } from 'playwright';\\n\\nconst devRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');\\nconst site = path.join(devRoot, 'tests/hub/site');\\nconst workRoot = path.resolve(devRoot, '..');\\n10→const GPU = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader', '--use-angle=swiftshader'];\\n\\nconst TYPES = {\\n  '.html': 'text/html; charset=utf-8',\\n  '.js': 'text/javascript; charset=utf-8',\\n  '.mjs': 'text/javascript; charset=utf-8',\\n  '.css': 'text/css; charset=utf-8',\\n  '.json': 'application/json',\\n  '.svg': 'image/svg+xml',\\n  '.png': 'image/png',\\n20→};\\n\\nfunction serve(root) {\\n  const server = http.createServer((req, res) => {\\n    const url = new URL(req.url, 'http://127.0.0.1');\\n    let name = decodeURIComponent(url.pathname);\\n    if (name.endsWith('/')) name += 'index.html';\\n    const file = path.join(root, name);\\n    if (!file.startsWith(root) || !existsSync(file)) {\\n      res.writeHead(404);\\n30→      res.end('missing');\\n      return;\\n    }\\n    res.writeHead(200, { 'content-type': TYPES[path.extname(file)] || 'application/octet-stream' });\\n    res.end(readFileSync(file));\\n  });\\n  return new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(server)));\\n}\\n\\nfunction findHtml() {\\n40→  const name = readdirSync(workRoot).find((file) => file.endsWith('-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230.html'));\\n  if (!name) return null;\\n  return path.join(workRoot, name);\\n}\\n\\nasync function hubRun(origin, check, spec) {\\n  const browser = await chromium.launch({ headless: true, args: spec.gpu ? GPU : [] });\\n  const lines = [];\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1280, height: 860 } });\\n50→    page.on('console', (msg) => {\\n      const text = msg.text();\\n      if (text.startsWith('[AIHub]')) lines.push(text);\\n    });\\n    page.on('pageerror', (err) => lines.push(String(err)));\\n    const game = encodeURIComponent(spec.game);\\n    await page.goto(`${origin}/harness.html?game=${game}&auto=1&play=8000&${spec.query}`, { waitUntil: 'domcontentloaded' });\\n    await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 300000 });\\n    const report = await page.evaluate(() => window.__hubCheck);\\n    const ours = await page.evaluate(() => {\\n60→      const frame = document.querySelector('iframe');\\n      return !!(frame && frame.contentWindow && frame.contentWindow.__game);\\n    });\\n    check(`${spec.name} is this game`, ours, 'missing __game');\\n    check(`${spec.name} pass`, report?.pass === true, JSON.stringify((report?.checks || []).filter((c) => !c.pass).map((c) => `${c.name}: ${c.detail}`)));\\n    check(`${spec.name} quiet`, lines.length === 0, lines.slice(0, 4).join(' | '));\\n  } finally {\\n    await browser.close();\\n  }\\n}\\n70→\\nasync function alone(check) {\\n  const html = findHtml();\\n  const browser = await chromium.launch({ headless: true });\\n  const errors = [];\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\\n    page.on('pageerror', (err) => errors.push(String(err)));\\n    await page.goto(pathToFileURL(html).href, { waitUntil: 'domcontentloaded' });\\n    await page.waitForFunction(() => window.__game && window.__game.state().screen === 'Title', null, { timeout: 30000 });\\n80→    await page.waitForTimeout(2500);\\n    for (const key of ['Enter', 'Space', 'Enter', 'Space']) {\\n      await page.keyboard.press(key);\\n      await page.waitForTimeout(500);\\n    }\\n    await page.waitForTimeout(2000);\\n    const shot = await page.screenshot();\\n    const flags = await page.evaluate(() => ({\\n      active: window.AIHub.active,\\n      seeded: window.AIHub.seeded,\\n90→      screen: window.__game.state().screen,\\n    }));\\n    check('alone active', flags.active === false, String(flags.active));\\n    check('alone seeded', flags.seeded !== true, String(flags.seeded));\\n    check('alone shot', shot.length > 12000, `${shot.length}`);\\n    check('alone errors', errors.length === 0, errors.slice(0, 3).join(' | '));\\n    check('alone advanced', flags.screen === 'Story' || flags.screen === 'Main Menu', flags.screen);\\n  } finally {\\n    await browser.close();\\n  }\\n100→}\\n\\nexport async function cardCountdown(origin, check) {\\n  const browser = await chromium.launch({ headless: true });\\n  const errors = [];\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1280, height: 860 }, deviceScaleFactor: 1 });\\n    page.on('pageerror', (err) => errors.push(String(err)));\\n    const game = encodeURIComponent('game.html?webgl=1');\\n    await page.goto(`${origin}/harness.html?game=${game}&players=1`, { waitUntil: 'domcontentloaded' });\\n110→    await page.waitForFunction(() => {\\n      const frame = document.querySelector('iframe');\\n      let g = null;\\n      try { g = frame && frame.contentWindow && frame.contentWindow.__game; } catch { g = null; }\\n      if (!g || !g.state) return false;\\n      const st = g.state();\\n      const text = frame.contentDocument?.querySelector('[data-live=\\\"card\\\"]')?.textContent?.trim() || '';\\n      return st.screen === 'Card' && text !== '' && st.cardLeft != null;\\n    }, null, { timeout: 20000 });\\n    const card = await page.evaluate(() => {\\n120→      const frame = document.querySelector('iframe');\\n      const text = frame.contentDocument.querySelector('[data-live=\\\"card\\\"]').textContent.trim();\\n      const left = frame.contentWindow.__game.state().cardLeft;\\n      return { text, left, screen: frame.contentWindow.__game.state().screen };\\n    });\\n    const shown = Number(card.text);\\n    const expect = Math.max(0, Math.ceil(Number(card.left) / 1000));\\n    check(\\n      'card seconds',\\n      card.screen === 'Card' && Number.isInteger(shown) && shown >= 0 && shown <= 30 && shown === expect,\\n130→      `shown ${card.text} left ${card.left} expect ${expect}`,\\n    );\\n    await page.evaluate(async () => {\\n      const deadline = performance.now() + 4000;\\n      while (performance.now() < deadline) {\\n        const frame = document.querySelector('iframe');\\n        const screen = frame.contentWindow.__game.state().screen;\\n        if (screen === 'Countdown' || screen === 'Operation') return;\\n        const btn = frame.contentDocument.querySelector('[data-item=\\\"ready\\\"]');\\n        if (btn) btn.dispatchEvent(new PointerEvent('pointerup', { bubbles: true }));\\n140→        frame.contentWindow.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', bubbles: true }));\\n        await new Promise((r) => setTimeout(r, 50));\\n      }\\n    });\\n    const seen = await page.evaluate(async () => {\\n      const deadline = performance.now() + 8000;\\n      let digit = '';\\n      while (performance.now() < deadline) {\\n        const frame = document.querySelector('iframe');\\n        const screen = frame.contentWindow.__game.state().screen;\\n150→        const text = frame.contentDocument.querySelector('[data-live=\\\"count\\\"]')?.textContent?.trim() || '';\\n        if (screen === 'Countdown' && (text === '1' || text === '2' || text === '3')) {\\n          digit = text;\\n          break;\\n        }\\n        if (screen === 'Operation') break;\\n        await new Promise((r) => setTimeout(r, 40));\\n      }\\n      const opDeadline = performance.now() + 6000;\\n      let op = false;\\n160→      while (performance.now() < opDeadline) {\\n        const frame = document.querySelector('iframe');\\n        if (frame.contentWindow.__game.state().screen === 'Operation') { op = true; break; }\\n        await new Promise((r) => setTimeout(r, 40));\\n      }\\n      return { digit, op };\\n    });\\n    check('countdown digit', (seen.digit === '1' || seen.digit === '2' || seen.digit === '3') && seen.op, JSON.stringify(seen));\\n    check('card page errors', errors.length === 0, errors.slice(0, 3).join(' | '));\\n  } finally {\\n170→    await browser.close();\\n  }\\n}\\n\\nexport async function hubTests() {\\n  const fails = [];\\n  let passed = 0;\\n  const check = (name, ok, detail) => {\\n    if (ok) passed += 1;\\n    else fails.push(`${name}: ${detail || 'failed'}`);\\n180→  };\\n  if (!existsSync(path.join(site, 'game.html'))) {\\n    fails.push('hub: game.html was not copied into the harness');\\n    return { fails, passed };\\n  }\\n  const server = await serve(site);\\n  const { port } = server.address();\\n  const origin = `http://127.0.0.1:${port}`;\\n  const runs = [\\n    { name: '2 players', query: 'players=2', game: 'game.html', gpu: true },\\n190→    { name: '3 players', query: 'players=3&latency=150&jitter=50&loss=5', game: 'game.html', gpu: true },\\n    { name: '4 players', query: 'players=4&latency=150&jitter=50&loss=5', game: 'game.html', gpu: true },\\n    { name: 'host leave', query: 'players=3&latency=150&jitter=50&loss=5&scenario=host-leave', game: 'game.html', gpu: true },\\n    { name: 'server', query: 'players=2&latency=150&jitter=50&loss=5&scenario=server', game: 'game.html', gpu: true },\\n    { name: '4 players webgl', query: 'players=4&latency=150&jitter=50&loss=5', game: 'game.html?webgl=1', gpu: false },\\n  ];\\n  try {\\n    try { await cardCountdown(origin, check); }\\n    catch (err) { fails.push(`card countdown: ${err.stack || err.message}`); }\\n    for (const spec of runs) {\\n200→      try { await hubRun(origin, check, spec); }\\n      catch (err) { fails.push(`${spec.name}: ${err.stack || err.message}`); }\\n    }\\n    try { await alone(check); }\\n    catch (err) { fails.push(`alone: ${err.stack || err.message}`); }\\n  } finally {\\n    await new Promise((resolve) => server.close(resolve));\\n  }\\n  return { fails, passed };\\n}\\n210→\\nif (process.argv[2] === 'card') {\\n  const server = await serve(site);\\n  const origin = `http://127.0.0.1:${server.address().port}`;\\n  const fails = [];\\n  let passed = 0;\\n  const check = (name, ok, detail) => {\\n    if (ok) passed += 1;\\n    else fails.push(`${name}: ${detail || 'failed'}`);\\n  };\\n220→  try {\\n    await cardCountdown(origin, check);\\n  } catch (err) {\\n    fails.push(String(err.stack || err));\\n  } finally {\\n    await new Promise((resolve) => server.close(resolve));\\n  }\\n  for (const line of fails) console.log(`FAIL ${line}`);\\n  console.log(`${fails.length} failed, ${passed} passed`);\\n  if (fails.length) process.exit(1);\\n230→}\\n\",\"content_concise\":\"1→import http from 'node:http';\\nimport { existsSync, readFileSync, readdirSync } from 'node:fs';\\nimport path from 'node:path';\\nimport { fileURLToPath, pathToFileURL } from 'node:url';\\nimport { chromium } from 'playwright';\\n\\nconst devRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');\\nconst site = path.join(devRoot, 'tests/hub/site');\\nconst workRoot = path.resolve(devRoot, '..');\\n10→const GPU = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader', '--use-angle=swiftshader'];\\n\\nconst TYPES = {\\n  '.html': 'text/html; charset=utf-8',\\n  '.js': 'text/javascript; charset=utf-8',\\n  '.mjs': 'text/javascript; charset=utf-8',\\n  '.css': 'text/css; charset=utf-8',\\n  '.json': 'application/json',\\n  '.svg': 'image/svg+xml',\\n  '.png': 'image/png',\\n20→};\\n\\nfunction serve(root) {\\n  const server = http.createServer((req, res) => {\\n    const url = new URL(req.url, 'http://127.0.0.1');\\n    let name = decodeURIComponent(url.pathname);\\n    if (name.endsWith('/')) name += 'index.html';\\n    const file = path.join(root, name);\\n    if (!file.startsWith(root) || !existsSync(file)) {\\n      res.writeHead(404);\\n30→      res.end('missing');\\n      return;\\n    }\\n    res.writeHead(200, { 'content-type': TYPES[path.extname(file)] || 'application/octet-stream' });\\n    res.end(readFileSync(file));\\n  });\\n  return new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(server)));\\n}\\n\\nfunction findHtml() {\\n40→  const name = readdirSync(workRoot).find((file) => file.endsWith('-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230.html'));\\n  if (!name) return null;\\n  return path.join(workRoot, name);\\n}\\n\\nasync function hubRun(origin, check, spec) {\\n  const browser = await chromium.launch({ headless: true, args: spec.gpu ? GPU : [] });\\n  const lines = [];\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1280, height: 860 } });\\n50→    page.on('console', (msg) => {\\n      const text = msg.text();\\n      if (text.startsWith('[AIHub]')) lines.push(text);\\n    });\\n    page.on('pageerror', (err) => lines.push(String(err)));\\n    const game = encodeURIComponent(spec.game);\\n    await page.goto(`${origin}/harness.html?game=${game}&auto=1&play=8000&${spec.query}`, { waitUntil: 'domcontentloaded' });\\n    await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 300000 });\\n    const report = await page.evaluate(() => window.__hubCheck);\\n    const ours = await page.evaluate(() => {\\n60→      const frame = document.querySelector('iframe');\\n      return !!(frame && frame.contentWindow && frame.contentWindow.__game);\\n    });\\n    check(`${spec.name} is this game`, ours, 'missing __game');\\n    check(`${spec.name} pass`, report?.pass === true, JSON.stringify((report?.checks || []).filter((c) => !c.pass).map((c) => `${c.name}: ${c.detail}`)));\\n    check(`${spec.name} quiet`, lines.length === 0, lines.slice(0, 4).join(' | '));\\n  } finally {\\n    await browser.close();\\n  }\\n}\\n70→\\nasync function alone(check) {\\n  const html = findHtml();\\n  const browser = await chromium.launch({ headless: true });\\n  const errors = [];\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\\n    page.on('pageerror', (err) => errors.push(String(err)));\\n    await page.goto(pathToFileURL(html).href, { waitUntil: 'domcontentloaded' });\\n    await page.waitForFunction(() => window.__game && window.__game.state().screen === 'Title', null, { timeout: 30000 });\\n80→    await page.waitForTimeout(2500);\\n    for (const key of ['Enter', 'Space', 'Enter', 'Space']) {\\n      await page.keyboard.press(key);\\n      await page.waitForTimeout(500);\\n    }\\n    await page.waitForTimeout(2000);\\n    const shot = await page.screenshot();\\n    const flags = await page.evaluate(() => ({\\n      active: window.AIHub.active,\\n      seeded: window.AIHub.seeded,\\n90→      screen: window.__game.state().screen,\\n    }));\\n    check('alone active', flags.active === false, String(flags.active));\\n    check('alone seeded', flags.seeded !== true, String(flags.seeded));\\n    check('alone shot', shot.length > 12000, `${shot.length}`);\\n    check('alone errors', errors.length === 0, errors.slice(0, 3).join(' | '));\\n    check('alone advanced', flags.screen === 'Story' || flags.screen === 'Main Menu', flags.screen);\\n  } finally {\\n    await browser.close();\\n  }\\n100→}\\n\\nexport async function cardCountdown(origin, check) {\\n  const browser = await chromium.launch({ headless: true });\\n  const errors = [];\\n  try {\\n    const page = await browser.newPage({ viewport: { width: 1280, height: 860 }, deviceScaleFactor: 1 });\\n    page.on('pageerror', (err) => errors.push(String(err)));\\n    const game = encodeURIComponent('game.html?webgl=1');\\n    await page.goto(`${origin}/harness.html?game=${game}&players=1`, { waitUntil: 'domcontentloaded' });\\n110→    await page.waitForFunction(() => {\\n      const frame = document.querySelector('iframe');\\n      let g = null;\\n      try { g = frame && frame.contentWindow && frame.contentWindow.__game; } catch { g = null; }\\n      if (!g || !g.state) return false;\\n      const st = g.state();\\n      const text = frame.contentDocument?.querySelector('[data-live=\\\"card\\\"]')?.textContent?.trim() || '';\\n      return st.screen === 'Card' && text !== '' && st.cardLeft != null;\\n    }, null, { timeout: 20000 });\\n    const card = await page.evaluate(() => {\\n120→      const frame = document.querySelector('iframe');\\n      const text = frame.contentDocument.querySelector('[data-live=\\\"card\\\"]').textContent.trim();\\n      const left = frame.contentWindow.__game.state().cardLeft;\\n      return { text, left, screen: frame.contentWindow.__game.state().screen };\\n    });\\n    const shown = Number(card.text);\\n    const expect = Math.max(0, Math.ceil(Number(card.left) / 1000));\\n    check(\\n      'card seconds',\\n      card.screen === 'Card' && Number.isInteger(shown) && shown >= 0 && shown <= 30 && shown === expect,\\n130→      `shown ${card.text} left ${card.left} expect ${expect}`,\\n    );\\n    await page.evaluate(async () => {\\n      const deadline = performance.now() + 4000;\\n      while (performance.now() < deadline) {\\n        const frame = document.querySelector('iframe');\\n        const screen = frame.contentWindow.__game.state().screen;\\n        if (screen === 'Countdown' || screen === 'Operation') return;\\n        const btn = frame.contentDocument.querySelector('[data-item=\\\"ready\\\"]');\\n        if (btn) btn.dispatchEvent(new PointerEvent('pointerup', { bubbles: true }));\\n140→        frame.contentWindow.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', bubbles: true }));\\n        await new Promise((r) => setTimeout(r, 50));\\n      }\\n    });\\n    const seen = await page.evaluate(async () => {\\n      const deadline = performance.now() + 8000;\\n      let digit = '';\\n      while (performance.now() < deadline) {\\n        const frame = document.querySelector('iframe');\\n        const screen = frame.contentWindow.__game.state().screen;\\n150→        const text = frame.contentDocument.querySelector('[data-live=\\\"count\\\"]')?.textContent?.trim() || '';\\n        if (screen === 'Countdown' && (text === '1' || text === '2' || text === '3')) {\\n          digit = text;\\n          break;\\n        }\\n        if (screen === 'Operation') break;\\n        await new Promise((r) => setTimeout(r, 40));\\n      }\\n      const opDeadline = performance.now() + 6000;\\n      let op = false;\\n160→      while (performance.now() < opDeadline) {\\n        const frame = document.querySelector('iframe');\\n        if (frame.contentWindow.__game.state().screen === 'Operation') { op = true; break; }\\n        await new Promise((r) => setTimeout(r, 40));\\n      }\\n      return { digit, op };\\n    });\\n    check('countdown digit', (seen.digit === '1' || seen.digit === '2' || seen.digit === '3') && seen.op, JSON.stringify(seen));\\n    check('card page errors', errors.length === 0, errors.slice(0, 3).join(' | '));\\n  } finally {\\n170→    await browser.close();\\n  }\\n}\\n\\nexport async function hubTests() {\\n  const fails = [];\\n  let passed = 0;\\n  const check = (name, ok, detail) => {\\n    if (ok) passed += 1;\\n    else fails.push(`${name}: ${detail || 'failed'}`);\\n180→  };\\n  if (!existsSync(path.join(site, 'game.html'))) {\\n    fails.push('hub: game.html was not copied into the harness');\\n    return { fails, passed };\\n  }\\n  const server = await serve(site);\\n  const { port } = server.address();\\n  const origin = `http://127.0.0.1:${port}`;\\n  const runs = [\\n    { name: '2 players', query: 'players=2', game: 'game.html', gpu: true },\\n190→    { name: '3 players', query: 'players=3&latency=150&jitter=50&loss=5', game: 'game.html', gpu: true },\\n    { name: '4 players', query: 'players=4&latency=150&jitter=50&loss=5', game: 'game.html', gpu: true },\\n    { name: 'host leave', query: 'players=3&latency=150&jitter=50&loss=5&scenario=host-leave', game: 'game.html', gpu: true },\\n    { name: 'server', query: 'players=2&latency=150&jitter=50&loss=5&scenario=server', game: 'game.html', gpu: true },\\n    { name: '4 players webgl', query: 'players=4&latency=150&jitter=50&loss=5', game: 'game.html?webgl=1', gpu: false },\\n  ];\\n  try {\\n    try { await cardCountdown(origin, check); }\\n    catch (err) { fails.push(`card countdown: ${err.stack || err.message}`); }\\n    for (const spec of runs) {\\n200→      try { await hubRun(origin, check, spec); }\\n      catch (err) { fails.push(`${spec.name}: ${err.stack || err.message}`); }\\n    }\\n    try { await alone(check); }\\n    catch (err) { fails.push(`alone: ${err.stack || err.message}`); }\\n  } finally {\\n    await new Promise((resolve) => server.close(resolve));\\n  }\\n  return { fails, passed };\\n}\\n210→\\nif (process.argv[2] === 'card') {\\n  const server = await serve(site);\\n  const origin = `http://127.0.0.1:${server.address().port}`;\\n  const fails = [];\\n  let passed = 0;\\n  const check = (name, ok, detail) => {\\n    if (ok) passed += 1;\\n    else fails.push(`${name}: ${detail || 'failed'}`);\\n  };\\n220→  try {\\n    await cardCountdown(origin, check);\\n  } catch (err) {\\n    fails.push(String(err.stack || err));\\n  } finally {\\n    await new Promise((resolve) => server.close(resolve));\\n  }\\n  for (const line of fails) console.log(`FAIL ${line}`);\\n  console.log(`${fails.length} failed, ${passed} passed`);\\n  if (fails.length) process.exit(1);\\n230→}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/hub/suite.mjs\",\"offset\":1,\"limit\":250,\"raw_output\":\"import http from 'node:http';\\nimport { existsSync, readFileSync, readdirSync } from 'node:fs';\\nimport path from 'node:path';\\nimport { fileURLToPath, pathToFileURL } from 'node:url';\\nimport { chromium } from 'playwright';\\n\\nconst devRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');\\nconst site = path.join(devRoot, 'tests/hub/site');\\nconst workRoot = path.resolve(devRoot, '..');\\nconst GPU = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader', '--use-angle=swiftshader'];\\n\\nconst TYPES = {\\n  '.html': 'text/html; charset=utf-8',\\n  '.js': 'text/javascript; charset=utf-8',\\n  '.mjs': 'text/javascript; charset=utf-8',\\n  '.css': 'text/css; charset=utf-8',\\n  '.json': 'application/json',\\n  '.svg': 'image/svg+xml',\\n  '.png': 'image/png',\\n};\\n\\nfunction serve(root) {\\n  const server = http.createServer((req, res) => {\\n    const url = new URL(req.url, 'http://127.0.0.1');\\n    let name = decodeURIComponent(url.pathname);\\n    if (name.endsWith('/')) name += 'index.html';\\n    const file = path.join(root, name);\\n    if (!file.startsWith(root) || !existsSync(file)) {\\n      res.writeHead(404);\\n      res.end('missing');\\n      return;\\n    }\\n    res.writeHead(200, { 'content-type': TYPES[path.extname(file)] || 'application/octet-stream' })