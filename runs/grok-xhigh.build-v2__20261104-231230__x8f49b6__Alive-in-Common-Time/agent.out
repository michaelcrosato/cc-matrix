enter: Second Opinion-grok-4.7-xhigh-20261104-231230/tests/hub/site/round.js\",\"matches\":[{\"line_number\":99,\"content\":\"export const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\"},{\"line_number\":101,\"content\":\"/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\"},{\"line_number\":102,\"content\":\"export function cleanStats(stats) {\"},{\"line_number\":103,\"content\":\"  if (!stats || typeof stats !== 'object' || Array.isArray(stats)) return null;\"},{\"line_number\":105,\"content\":\"  for (const [name, value] of Object.entries(stats).slice(0, HIGHLIGHTS.stats)) {\"},{\"line_number\":116,\"content\":\" * players of this round. A result's awards are about its own player: `self` is its id.\"},{\"line_number\":118,\"content\":\"export function cleanAwards(awards, ids, self = null) {\"},{\"line_number\":119,\"content\":\"  if (!Array.isArray(awards)) return [];\"},{\"line_number\":122,\"content\":\"  for (const a of awards) {\"},{\"line_number\":125,\"content\":\"    if (!title || !ids.includes(id) || (given.get(id) || 0) >= HIGHLIGHTS.awards) continue;\"},{\"line_number\":134,\"content\":\" * Check a host's standings: groups of ids, best first, every present player\"},{\"line_number\":138,\"content\":\"export function checkStandings(standings, presentIds, allIds) {\"},{\"line_number\":139,\"content\":\"  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\"},{\"line_number\":143,\"content\":\"  for (const group of standings) {\"},{\"line_number\":155,\"content\":\"  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\"},{\"line_number\":158,\"content\":\"  return { ok: true, standings: groups };\"},{\"line_number\":210,\"content\":\"      stats: null,\"},{\"line_number\":211,\"content\":\"      awards: [],\"},{\"line_number\":216,\"content\":\"    ? { id: seats.length, key: serverKey, slot: null, name: 'Server', color: null, hello: false, ready: false, out: null, result: null, progress: null, stats: null, awards: [], caps: null, hidden: null }\"},{\"line_number\":361,\"content\":\"    const stats = Object.fromEntries(seats.filter((s) => s.stats).map((s) => [s.id, s.stats]));\"},{\"line_number\":362,\"content\":\"    const awards = seats.flatMap((s) => s.awards);\"},{\"line_number\":363,\"content\":\"    finishPlayed(gone.length ? [...ranked, gone] : ranked, { scores, results: Object.fromEntries(results), stats, awards });\"},{\"line_number\":366,\"content\":\"  function finishPlayed(standings, extra = {}) {\"},{\"line_number\":367,\"content\":\"    end({ status: 'played', reason: 'finished', endReason: 'finished', standings, ...extra });\"},{\"line_number\":371,\"content\":\"    end({ status: 'void', reason, endReason, standings: null });\"},{\"line_number\":380,\"content\":\"    if (outcome.standings) msg.standings = outcome.standings;\"},{\"line_number\":424,\"content\":\"        seat.stats = cleanStats(msg.stats);\"},{\"line_number\":425,\"content\":\"        seat.awards = cleanAwards(msg.awards, ids, seat.id);\"},{\"line_number\":433,\"content\":\"        const checked = checkStandings(msg.standings, present().map((s) => s.id), ids);\"},{\"line_number\":436,\"content\":\"        const given = msg.stats && typeof msg.stats === 'object' ? msg.stats : {};\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"f076db80-fdef-4d98-a66d-1526355f26d3"}
