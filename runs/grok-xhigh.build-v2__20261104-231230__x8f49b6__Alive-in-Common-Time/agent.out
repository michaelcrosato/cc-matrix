":\"      const sent = await until(() => players.every((c) => c.cardSent), 2000);\"},{\"line_number\":449,\"content\":\"      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\"},{\"line_number\":514,\"content\":\"    const violations = state.cells.flatMap((c) => {\"},{\"line_number\":519,\"content\":\"      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\"},{\"line_number\":521,\"content\":\"    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"a89d7e06-8358-411a-84d7-0878024f6980"}
