interToField } from './camera.js';\"},{\"line_number\":170,\"content\":\"  const backend = renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\"},{\"line_number\":419,\"content\":\"    return pointerToField(camera, clientX, clientY, rect);\"},{\"line_number\":424,\"content\":\"    backend, renderer, scene, camera, ink, resize, sync, render, pointerToField: pointer,\"},{\"line_number\":428,\"content\":\"    setBoil(v) { boil = v ? 1 : 0; },\"},{\"line_number\":443,\"content\":\"    backend: 'none',\"},{\"line_number\":448,\"content\":\"    pointerToField(clientX, clientY) {\"},{\"line_number\":450,\"content\":\"      return pointerToField(camera, clientX, clientY, rect);\"},{\"line_number\":461,\"content\":\"    setBoil() {},\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/view/camera.js\",\"matches\":[{\"line_number\":40,\"content\":\"export function pointerToField(camera, clientX, clientY, rect) {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/physics.js\",\"matches\":[{\"line_number\":5,\"content\":\"export function physicsReady() {\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/dev.js\",\"matches\":[{\"line_number\":158,\"content\":\"    model.view?.setBoil?.(!(model.boilOn === false));\"}]},{\"path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/session.js\",\"matches\":[{\"line_number\":196,\"content\":\"      model.backend = model.view?.backend || 'none';\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_