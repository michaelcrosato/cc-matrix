t === 2 && state.vitals < 50 && (me.syringeCd || 0) <= 0.4;\n  if (codaUp && !coreNow && (mem.healCommit || canStart) && (!bleeding || state.vitals < 22)) {\n    mem.healCommit = true;\n    return syringeAt(me, IV.x, IV.y, tuning, opts);\n  }\n  if (!codaUp && !coreNow && !windup && state.vitals < 40 && (me.syringeCd || 0) <= 0 && (!bleeding || state.vitals < 22)) {\n    return syringeAt(me, IV.x, IV.y, tuning, opts);\n  }","new_string":"  const bleeding = state.entities.some((e) => e.kind === 'bleeder' && !e.clamped);\n  const coreNow = state.entities.some((e) => (e.kind === 'coda' && e.coreOpen) || (e.kind === 'adagio' && e.hp > 0 && e.core));\n  const codaUp = state.entities.some((e) => e.kind === 'coda' && e.hp > 0);\n  const messy = state.entities.some((e) => e.kind === 'scratch' || e.kind === 'spore');\n  const healAt = codaUp ? 64 : 40;\n  // Gel a scratch before walking to the IV. The walk is where a downbeat used to land under 35.\n  if (!coreNow && state.vitals < healAt && (me.syringeCd || 0) <= 0 && (!bleeding || state.vitals < 22) && (!messy || state.vitals < 38)) {\n    return syringeAt(me, IV.x, IV.y, tuning, opts);\n  }"}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":3991,"output_tokens":1190,"cache_read_input_tokens":133376,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"1232640f-d593-4f20-b86f-1cc1192a5644"}
