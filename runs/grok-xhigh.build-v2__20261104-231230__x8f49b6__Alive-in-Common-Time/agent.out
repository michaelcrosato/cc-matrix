story/scenes.js\",\"matches\":[{\"line_number\":12,\"content\":\"      line('narration', 'quiet', 'An envelope slides under the door. No footsteps follow it.'),\"},{\"line_number\":20,\"content\":\"      line('narration', 'quiet', 'The envelope is sheet music. The clef is a heart.'),\"},{\"line_number\":68,\"content\":\"      line('narration', 'sting', 'On the desk, under a paperweight, a corner of sheet music.', true),\"},{\"line_number\":88,\"content\":\"      line('bea', 'dry', 'The gallery can hear the radio, Pip.'),\"},{\"line_number\":117,\"content\":\"    id: 'S5', chapter: 'First Movement', where: \\\"Pip's pathology lab\\\", set: 'lab', music: 'story-comic',\"},{\"line_number\":119,\"content\":\"      line('pip', 'bright', 'New envelope. Sheet music. Addressed to the Surgeon on Call, which is rude and specific.'),\"},{\"line_number\":249,\"content\":\"      line('bell', 'formal', 'The envelope\\\\'s dedication is in my handwriting. I had hoped the rain would blur it.'),\"},{\"line_number\":281,\"content\":\"      line('pip', 'door', 'There is another envelope. I did not play it. I am very brave and very scared.'),\"},{\"line_number\":291,\"content\":\"      line('pip', 'reading', 'Final envelope. I will play it slowly, like a person with sense.'),\"},{\"line_number\":318,\"content\":\"      line('ren', 'quiet', 'Ines closed the lung. Pip read every line. I did the heart.'),\"},{\"line_number\":367,\"content\":\"      line('pip', 'small', 'There is one more envelope. It was under the door at dawn.'),\"},{\"line_number\":369,\"content\":\"      line('narration', 'quiet', 'The envelope waits on the bench, marked Opus 2, unopened.'),\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"f2d4d8e8-164a-4445-b138-6a6212881d06"}
