  if (!info.server && model.view) {\\n      if (info.isHost && model.sim) model.syncFromSim?.();\\n290→      else if (model.netState) {\\n        const st = model.netState;\\n        const me = st.seats?.find((s) => s.id === AIHub.me);\\n        if (me) { me.x = local.x; me.y = local.y; me.tool = local.tool; }\\n        try { model.view.sync(st, dt); } catch { /* view catches up next frame */ }\\n        model.view.render?.()?.catch?.(() => {});\\n      }\\n    }\\n    model.paint?.();\\n    setTimeout(pump, 16);\\n300→  })();\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/session.js\",\"offset\":null,\"raw_output\":\"import { Sim } from '../sim/sim.js';\\nimport { physicsReady } from '../sim/physics.js';\\nimport { applyUnreliable, decodeKeyframe, keyframeOf, unreliableOf } from '../sim/snapshot.js';\\nimport { createView } from '../view/renderer.js';\\n\\nconst clamp = (v, a, b) => Math.max(a, Math.min(b, v));\\n\\nfunction ship(bucket, data, reliable) {\\n  let text;\\n  try { text = JSON.stringify(data); } catch { return false; }\\n  const cap = data.t === 's' ? 1100 : 16000;\\n  if (text.length > cap) return false;\\n  const now = performance.now();\\n  bucket.tokens = Math.min(bucket.burst, bucket.tokens + ((now - bucket.t) / 1000) * bucket.rate);\\n  bucket.t = now;\\n  if (bucket.tokens < 1) return false;\\n  bucket.tokens -= 1;\\n  return AIHub.send(data, { reliable: !!reliable });\\n}\\n\\nfunction integrate(local, frame, tuning, dt) {\\n  if (frame.source === 'abs' && Number.isFinite(frame.x) && Number.isFinite(frame.y)) {\\n    local.x = frame.x;\\n    local.y = frame.y;\\n  } else {\\n    const sx = frame.x || 0;\\n    const sy = frame.y || 0;\\n    const mag = Math.hypot(sx, sy);\\n    if (mag > 0.12) {\\n      const sm = Math.min(1, mag);\\n      const speed = tuning.tipSpeed * sm ** tuning.stickCurve * (frame.steady ? tuning.steadyFactor : 1);\\n      local.x += (sx / mag) * speed * dt;\\n      local.y += (sy / mag) * speed * dt;\\n    }\\n  }\\n  local.x = clamp(local.x, -1.55, 1.9);\\n  local.y = clamp(local.y, -0.95, 0.95);\\n  if (frame.tool) local.tool = frame.tool;\\n  local.use = frame.use || 0;\\n  local.steady = !!frame.steady;\\n}\\n\\nfunction outcome(model, info, left) {\\n  const sim = model.sim;\\n  const present = (info.players || []).filter((p) => !left.has(p.id));\\n  const scoreOf = (id) => {\\n    const seat = sim?.seats?.find((s) => s.id === id);\\n    return seat ? seat.score || 0 : 0;\\n  };\\n  const ranked = present.slice().sort((a, b) => scoreOf(b.id) - scoreOf(a.id) || a.id - b.id);\\n  const standings = [];\\n  for (const p of ranked) {\\n    const score = scoreOf(p.id);\\n    const last = standings[standings.length - 1];\\n    if (last && scoreOf(last[0]) === score) last.push(p.id);\\n    else standings.push([p.id]);\\n  }\\n  const scores = {};\\n  const stats = {};\\n  const awards = [];\\n  for (const p of present) {\\n    scores[p.id] = scoreOf(p.id);\\n    const seat = sim?.seats?.find((s) => s.id === p.id);\\n    const raw = seat?.stats || { Cuts: 0, Stitches: 0, Burns: 0, Saves: 0, Accuracy: 100 };\\n    stats[p.id] = {\\n      Cuts: raw.Cuts || 0,\\n      Stitches: raw.Stitches || 0,\\n      Burns: raw.Burns || 0,\\n      Saves: raw.Saves || 0,\\n      Accuracy: raw.Accuracy ?? 100,\\n    };\\n  }\\n  if (ranked[0]) awards.push({ id: ranked[0].id, title: 'Steadiest Hands', detail: 'Led the table this round' });\\n  const won = !!(sim && sim.complete && !sim.failed && sim.vitals > 0);\\n  return { standings, scores, won, stats, awards };\\n}\\n\\nexport function runSession(model, info) {\\n  const left = new Set();\\n  const cmds = new Map();\\n  const bucket = { tokens: 8, burst: 8, rate: 16, t: performance.now() };\\n  const local = { x: -1.05, y: 0.62, tool: 'gel', use: 0, steady: false };\\n  let ended = false;\\n  let finished = false;\\n  let base = null;\\n  let seq = 0;\\n  let acc = 0;\\n  let accI = 0;\\n  let accS = 100;\\n  let accK = 1000;\\n  let accE = 0;\\n  let failedGfx = false;\\n  let last = performance.now();\\n  const evQueue = [];\\n  model.sessionInfo = info;\\n  model.mode = 'session';\\n  model.screen = 'Card';\\n  model.card = { left: null, ready: [], asking: 0 };\\n  model.sessionPause = false;\\n\\n  function finish(forceWon) {\\n    if (!info.isHost || finished || ended) return;\\n    finished = true;\\n    const out = outcome(model, info, left);\\n    if (typeof forceWon === 'boolean') out.won = forceWon && out.won;\\n    try { AIHub.finish(out); } catch { /* host only; the client warns if misused */ }\\n  }\\n\\n  AIHub.on('card', (card) => {\\n    model.card = card || model.card;\\n    if (AIHub.time() === -Infinity) model.screen = 'Card';\\n    model.paint?.();\\n  });\\n  AIHub.on('start', () => {\\n    model.started = true;\\n  });\\n  AIHub.on('message', (data, from) => {\\n    if (!data || ended) return;\\n    if (data.t === 'i' || data.t === 'a') {\\n      if (!model.sim || from === AIHub.me) return;\\n      const cur = cmds.get(from) || { source: 'abs', x: 0, y: 0, use: 0, tool: 'gel' };\\n      if (data.t === 'i') {\\n        cur.source = 'abs';\\n        cur.x = data.x;\\n        cur.y = data.y;\\n        if (data.tool) cur.tool = data.tool;\\n        cur.use = data.use || 0;\\n        cur.steady = !!data.steady;\\n      } else {\\n        if (data.syringe) cur.syringe = true;\\n        if (data.special) cur.special = true;\\n        if (data.alt) cur.alt = true;\\n        if (data.swap) cur.swap = true;\\n        if (data.siteDelta) cur.siteDelta = data.siteDelta;\\n        if (Number.isInteger(data.site)) cur.site = data.site;\\n      }\\n      cmds.set(from, cur);\\n      return;\\n    }\\n    if (from !== info.host) return;\\n    if (data.t === 'k') {\\n      const dec = decodeKeyframe(data);\\n      if (!base || dec.tick == null || base.tick == null || dec.tick >= base.tick) base = dec;\\n    } else if (data.t === 's' && base) {\\n      base = applyUnreliable(base, data);\\n    } else if (data.t === 'e' && data.ev) {\\n      model.remoteEvents = data.ev;\\n    }\\n    model.netState = base;\\n  });\\n  AIHub.on('leave', ({ id }) => {\\n    left.add(id);\\n    try { model.sim?.leave(id); } catch { /* already gone */ }\\n  });\\n  AIHub.on('time-up', () => {\\n    if (model.sim?.complete) finish(true);\\n    else finish(false);\\n  });\\n  AIHub.on('end', () => {\\n    ended = true;\\n    model.screen = 'Round over';\\n    try { model.audio?.ctx?.suspend?.(); } catch { /* already suspended */ }\\n    model.paint?.();\\n  });\\n\\n  AIHub.ready();\\n\\n  const boot = (async () => {\\n    if (info.isHost) {\\n      await physicsReady();\\n      const rng = AIHub.rng('world');\\n      rng.int = (n) => Math.floor(rng() * n);\\n      rng.seed = AIHub.seed || 1;\\n      model.sim = new Sim({\\n        op: 'grand-rounds',\\n        players: info.players,\\n        rng,\\n        network: true,\\n        physics: true,\\n        tuning: model.tuning,\\n        difficulty: 'resident',\\n      });\\n      model.opId = 'grand-rounds';\\n    }\\n    if (!info.server) {\\n      const webgl = model.params.get('webgl') === '1';\\n      try {\\n        model.view = await createView(model.canvas, { webgl });\\n      } catch {\\n        try {\\n          model.view = await createView(model.canvas, { webgl: true });\\n        } catch {\\n          if (!failedGfx) { failedGfx = true; AIHub.fail('graphics unavailable'); }\\n        }\\n      }\\n      model.backend = model.view?.backend || 'none';\\n    }\\n  })();\\n  boot.catch(() => { if (!ended && !failedGfx) { failedGfx = true; AIHub.fail('graphics unavailable'); } });\\n\\n  (function pump() {\\n    if (ended) return;\\n    const now = performance.now();\\n    const dt = Math.min(0.05, (now - last) / 1000);\\n    last = now;\\n    const sample = model.input.poll();\\n    const clock = AIHub.time();\\n    if (model.screen === 'Card' || clock === -Infinity) {\\n      if (sample.seats.some((s) => s.edges?.confirm)) AIHub.answer('ready');\\n      if (sample.seats.some((s) => s.edges?.more || s.edges?.special)) AIHub.answer('more');\\n    }\\n    if (clock >= 0 && model.sim && info.isHost) {\\n      if (!info.server && !model.sessionPause) {\\n        const mine = sample.seats.find((s) => s.index === 0);\\n        if (mine) model.sim.input(AIHub.me, mine.frame);\\n      }\\n      for (const [id, cmd] of cmds) model.sim.input(id, cmd);\\n      acc += dt;\\n      let guard = 0;\\n      while (acc >= 1 / 60 && guard < 5) {\\n        model.sim.step();\\n        acc -= 1 / 60;\\n        guard += 1;\\n        for (const ev of model.sim.events || []) evQueue.push(ev);\\n      }\\n      for (const cmd of cmds.values()) {\\n        cmd.syringe = false;\\n        cmd.special = false;\\n        cmd.alt = false;\\n        cmd.swap = false;\\n        cmd.siteDelta = 0;\\n      }\\n      if (model.sim.over) finish(!!model.sim.complete);\\n      accS += dt * 1000;\\n      accK += dt * 1000;\\n      accE += dt * 1000;\\n      if (accS >= 100) {\\n        accS = 0;\\n        ship(bucket, unreliableOf(model.sim), false);\\n      }\\n      if (accK >= 1000) {\\n        accK = 0;\\n        ship(bucket, keyframeOf(model.sim), true);\\n      }\\n      if (accE >= 200 && evQueue.length) {\\n        accE = 0;\\n        const ev = evQueue.splice(0, 8).map((e) => ({ type: e.type, who: e.who, key: e.key, id: e.id }));\\n        ship(bucket, { t: 'e', ev }, true);\\n      }\\n    } else if (clock >= 0 && !info.isHost && !info.server) {\\n      const mine = sample.seats.find((s) => s.index === 0);\\n      const frame = mine?.frame || { source: 'stick', x: 0, y: 0, use: 0 };\\n      integrate(local, frame, model.tuning, dt);\\n      accI += dt * 1000;\\n      if (accI >= 1000 / 12) {\\n        accI = 0;\\n        seq += 1;\\n        ship(bucket, {\\n          t: 'i', x: local.x, y: local.y, tool: local.tool, use: local.use, steady: local.steady, seq,\\n        }, false);\\n      }\\n      if (frame.syringe || frame.special || frame.alt || frame.swap || frame.siteDelta) {\\n        accE += dt * 1000;\\n        if (accE >= 340) {\\n          accE = 0;\\n          ship(bucket, {\\n            t: 'a',\\n            syringe: !!frame.syringe, special: !!frame.special, alt: !!frame.alt,\\n            swap: !!frame.swap, siteDelta: frame.siteDelta || 0,\\n          }, true);\\n        }\\n      }\\n    }\\n    if (clock >= 0 && clock < 1e12) {\\n      if (model.screen === 'Card' || model.screen === 'Countdown') {\\n        model.screen = clock < 0 ? 'Countdown' : 'Operation';\\n        if (model.screen === 'Operation') model.reached.add('Operation');\\n      }\\n      model.countN = clock < 0 ? Math.max(1, Math.ceil(-clock / 1000)) : 0;\\n    }\\n    if ((sample.menu.back || sample.seats.some((s) => s.edges?.pause)) && clock >= 0 && model.screen === 'Operation') {\\n      model.sessionPause = !model.sessionPause;\\n    } else if (model.sessionPause && (sample.menu.back || sample.seats.some((s) => s.edges?.back))) {\\n      model.sessionPause = false;\\n    } else if (model.sessionPause) {\\n      model.applySettings?.(sample);\\n    }\\n    if (!info.server && model.view) {\\n      if (info.isHost && model.sim) model.syncFromSim?.();\\n      else if (model.netState) {\\n        const st = model.netState;\\n        const me = st.seats?.find((s) => s.id === AIHub.me);\\n        if (me) { me.x = local.x; me.y = local.y; me.tool = local.tool; }\\n        try { model.view.sync(st, dt); } catch { /* view catches up next frame */ }\\n        model.view.render?.()?.catch?.(() => {});\\n      }\\n    }\\n    model.paint?.();\\n    setTimeout(pump, 16);\\n  })();\\n}\\n\",\"total_lines\":301}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3e4a808e-d962-405d-aa41-d4c04bc5d2bf-6","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { ALL_OPS } from '../data/ops/index.js';\\nimport { SCENES } from '../data/story/scenes.js';\\nimport { rankFor } from '../sim/scoring.js';\\nimport { Sim } from '../sim/sim.js';\\nimport { resetTuning, TUNING_DEFAULTS } from '../config/tuning.js';\\n\\nconst STRAINS = ['adagio', 'staccato', 'tremolo', 'legato', 'crescendo', 'fermata', 'coda'];\\n\\nexport const DEV_IDS = [\\n10→  ...ALL_OPS.map((op) => `op:${op.id}`),\\n  'phase-next', 'unlock', 'scene-next',\\n  'complete-objective', 'complete-phase', 'win', 'fail',\\n  'rank:S', 'rank:A', 'rank:B', 'rank:C', 'rank:D',\\n  'god', 'freeze', 'composure', 'clamps',\\n  'bleeder', ...STRAINS.map((k) => `strain:${k}`),\\n  'arrest', 'fortissimo', 'hush', 'sforzando',\\n  'speed', 'step', 'auto',\\n  'overlay:grid', 'overlay:targets', 'overlay:beat', 'overlay:input',\\n  'ink:lines', 'ink:tone', 'ink:boil', 'ink:shadows',\\n20→  'reset-page', 'reset-all',\\n];\\n\\nfunction fresh(model, opId) {\\n  const prev = model.sim;\\n  try { prev?.physics?.free?.(); } catch { /* world already freed */ }\\n  const sim = new Sim({\\n    op: opId,\\n    seed: 1,\\n    physics: false,\\n30→    tuning: model.tuning,\\n    difficulty: model.settings.difficulty || 'resident',\\n    players: 1,\\n  });\\n  model.sim = sim;\\n  model.screen = 'Operation';\\n  model.overlay = null;\\n  model.opId = opId;\\n  model.reached?.add('Operation');\\n  model.resultShown = false;\\n40→  return sim;\\n}\\n\\nexport function runDev(model, id, arg) {\\n  const name = String(id || '');\\n  const sim = () => model.sim;\\n  const go = (fn) => {\\n    try { fn(); } catch { /* a tool on a finished op stays quiet */ }\\n  };\\n  if (name.startsWith('op:')) {\\n50→    const opId = name.slice(3);\\n    go(() => {\\n      const simx = fresh(model, opId);\\n      if (arg) simx.skipTo(arg);\\n    });\\n    return true;\\n  }\\n  if (name === 'jump') {\\n    go(() => {\\n      const simx = fresh(model, arg?.op || 'broken-glass');\\n60→      if (arg?.phase) simx.skipTo(arg.phase);\\n    });\\n    return true;\\n  }\\n  if (name === 'unlock') {\\n    model.save.unlocked = true;\\n    model.persist?.();\\n    return true;\\n  }\\n  if (name === 'scene-next' || name === 'scene') {\\n70→    const cur = SCENES.findIndex((s) => s.id === (arg || model.sceneId));\\n    const next = SCENES[(cur + 1 + SCENES.length) % SCENES.length];\\n    model.openScene?.(arg && name === 'scene' ? arg : next.id, () => model.setScreen?.('Main Menu', null));\\n    return true;\\n  }\\n  const live = sim();\\n  if (!live) return true;\\n  if (name === 'phase-next') {\\n    go(() => {\\n      const phases = live.op.phases;\\n80→      const i = Math.min(phases.length - 1, live.phaseIndex + 1);\\n      live.skipTo(phases[i].id);\\n    });\\n  } else if (name === 'complete-objective') {\\n    go(() => {\\n      for (const e of live.entities) e.alive = false;\\n      live.vitals = 100;\\n      live.flags.stabilized = true;\\n      live.arrestsSurvived = 99;\\n      if (!live.over) live.completePhase();\\n90→    });\\n  } else if (name === 'complete-phase') {\\n    go(() => { if (!live.over) live.completePhase(); });\\n  } else if (name === 'win') {\\n    go(() => { if (!live.over) live.succeed(); });\\n  } else if (name === 'fail') {\\n    go(() => { if (!live.over) live.fail('vitals'); });\\n  } else if (name.startsWith('rank:')) {\\n    go(() => {\\n      const letter = name.slice(5);\\n100→      const par = live.op.parScore || 1;\\n      const ratio = { S: 1, A: 0.8, B: 0.6, C: 0.4, D: 0.1 }[letter] ?? 0.8;\\n      live.score = Math.round(par * ratio);\\n      live.rank = rankFor(live.score, par, null);\\n      live.over = true;\\n      live.complete = true;\\n      live.failed = null;\\n      model.screen = 'Report';\\n      model.reached?.add('Report');\\n    });\\n110→  } else if (name === 'god') {\\n    live.cheats.lockVitals = !live.cheats.lockVitals;\\n  } else if (name === 'freeze') {\\n    live.cheats.freezeTimer = !live.cheats.freezeTimer;\\n  } else if (name === 'composure') {\\n    live.cheats.infiniteComposure = !live.cheats.infiniteComposure;\\n  } else if (name === 'clamps') {\\n    live.cheats.infiniteClamps = !live.cheats.infiniteClamps;\\n  } else if (name === 'bleeder') {\\n    go(() => {\\n120→      const seat = live.seats[0];\\n      live.spawn({ kind: 'bleeder', site: live.activeSite, at: [seat.x, seat.y] });\\n    });\\n  } else if (name.startsWith('strain:')) {\\n    go(() => {\\n      const kind = name.slice(7);\\n      const seat = live.seats[0];\\n      live.spawn({ kind, strain: kind, site: live.activeSite, at: [seat.x, seat.y], hp: 40 });\\n    });\\n  } else if (name === 'arrest') {\\n130→    go(() => { if (!live.arrest) live.beginArrest({ clock: 8 }); });\\n  } else if (name === 'fortissimo') {\\n    go(() => live.act({ event: 'fortissimo' }));\\n  } else if (name === 'hush') {\\n    go(() => {\\n      live.hushPhase = 'wash';\\n      live.hushT = live.tuning.hushDuration;\\n      live.events.push({ type: 'hush', phase: 'wash' });\\n    });\\n  } else if (name === 'sforzando') {\\n140→    go(() => { live.sforzandoT = live.tuning.sforzandoDuration; });\\n  } else if (name === 'speed') {\\n    const cur = live.cheats.timeScale || 1;\\n    live.cheats.timeScale = cur >= 4 ? 0.1 : Math.round(Math.min(4, cur * 2) * 10) / 10;\\n  } else if (name === 'step') {\\n    go(() => { if (!live.over) live.step(); });\\n  } else if (name === 'auto') {\\n    model.botOn = !model.botOn;\\n  } else if (name.startsWith('overlay:')) {\\n    const key = name.slice(8);\\n150→    model.overlays[key] = !model.overlays[key];\\n  } else if (name === 'ink:lines') {\\n    const u = model.view?.ink?.u;\\n    if (u) u.lineOn.value = u.lineOn.value ? 0 : 1;\\n  } else if (name === 'ink:tone') {\\n    const u = model.view?.ink?.u;\\n    if (u) u.toneOn.value = u.toneOn.value ? 0 : 1;\\n  } else if (name === 'ink:boil') {\\n    model.view?.setBoil?.(!(model.boilOn === false));\\n    model.boilOn = model.boilOn === false;\\n160→  } else if (name === 'ink:shadows') {\\n    const map = model.view?.renderer?.shadowMap;\\n    if (map) map.enabled = !map.enabled;\\n  } else if (name === 'reset-all') {\\n    resetTuning(model.tuning);\\n  } else if (name === 'reset-page') {\\n    const keys = arg || Object.keys(TUNING_DEFAULTS);\\n    resetTuning(model.tuning, keys);\\n  }\\n  if (live.over && live.complete && model.screen === 'Operation') {\\n170→    model.screen = 'Report';\\n    model.reached?.add('Report');\\n  } else if (live.over && live.failed && model.screen === 'Operation') {\\n    model.screen = 'Fail';\\n    model.reached?.add('Fail');\\n  }\\n  model.paint?.();\\n  return true;\\n}\\n\",\"content_concise\":\"1→import { ALL_OPS } from '../data/ops/index.js';\\nimport { SCENES } from '../data/story/scenes.js';\\nimport { rankFor } from '../sim/scoring.js';\\nimport { Sim } from '../sim/sim.js';\\nimport { resetTuning, TUNING_DEFAULTS } from '../config/tuning.js';\\n\\nconst STRAINS = ['adagio', 'staccato', 'tremolo', 'legato', 'crescendo', 'fermata', 'coda'];\\n\\nexport const DEV_IDS = [\\n10→  ...ALL_OPS.map((op) => `op:${op.id}`),\\n  'phase-next', 'unlock', 'scene-next',\\n  'complete-objective', 'complete-phase', 'win', 'fail',\\n  'rank:S', 'rank:A', 'rank:B', 'rank:C', 'rank:D',\\n  'god', 'freeze', 'composure', 'clamps',\\n  'bleeder', ...STRAINS.map((k) => `strain:${k}`),\\n  'arrest', 'fortissimo', 'hush', 'sforzando',\\n  'speed', 'step', 'auto',\\n  'overlay:grid', 'overlay:targets', 'overlay:beat', 'overlay:input',\\n  'ink:lines', 'ink:tone', 'ink:boil', 'ink:shadows',\\n20→  'reset-page', 'reset-all',\\n];\\n\\nfunction fresh(model, opId) {\\n  const prev = model.sim;\\n  try { prev?.physics?.free?.(); } catch { /* world already freed */ }\\n  const sim = new Sim({\\n    op: opId,\\n    seed: 1,\\n    physics: false,\\n30→    tuning: model.tuning,\\n    difficulty: model.settings.difficulty || 'resident',\\n    players: 1,\\n  });\\n  model.sim = sim;\\n  model.screen = 'Operation';\\n  model.overlay = null;\\n  model.opId = opId;\\n  model.reached?.add('Operation');\\n  model.resultShown = false;\\n40→  return sim;\\n}\\n\\nexport function runDev(model, id, arg) {\\n  const name = String(id || '');\\n  const sim = () => model.sim;\\n  const go = (fn) => {\\n    try { fn(); } catch { /* a tool on a finished op stays quiet */ }\\n  };\\n  if (name.startsWith('op:')) {\\n50→    const opId = name.slice(3);\\n    go(() => {\\n      const simx = fresh(model, opId);\\n      if (arg) simx.skipTo(arg);\\n    });\\n    return true;\\n  }\\n  if (name === 'jump') {\\n    go(() => {\\n      const simx = fresh(model, arg?.op || 'broken-glass');\\n60→      if (arg?.phase) simx.skipTo(arg.phase);\\n    });\\n    return true;\\n  }\\n  if (name === 'unlock') {\\n    model.save.unlocked = true;\\n    model.persist?.();\\n    return true;\\n  }\\n  if (name === 'scene-next' || name === 'scene') {\\n70→    const cur = SCENES.findIndex((s) => s.id === (arg || model.sceneId));\\n    const next = SCENES[(cur + 1 + SCENES.length) % SCENES.length];\\n    model.openScene?.(arg && name === 'scene' ? arg : next.id, () => model.setScreen?.('Main Menu', null));\\n    return true;\\n  }\\n  const live = sim();\\n  if (!live) return true;\\n  if (name === 'phase-next') {\\n    go(() => {\\n      const phases = live.op.phases;\\n80→      const i = Math.min(phases.length - 1, live.phaseIndex + 1);\\n      live.skipTo(phases[i].id);\\n    });\\n  } else if (name === 'complete-objective') {\\n    go(() => {\\n      for (const e of live.entities) e.alive = false;\\n      live.vitals = 100;\\n      live.flags.stabilized = true;\\n      live.arrestsSurvived = 99;\\n      if (!live.over) live.completePhase();\\n90→    });\\n  } else if (name === 'complete-phase') {\\n    go(() => { if (!live.over) live.completePhase(); });\\n  } else if (name === 'win') {\\n    go(() => { if (!live.over) live.succeed(); });\\n  } else if (name === 'fail') {\\n    go(() => { if (!live.over) live.fail('vitals'); });\\n  } else if (name.startsWith('rank:')) {\\n    go(() => {\\n      const letter = name.slice(5);\\n100→      const par = live.op.parScore || 1;\\n      const ratio = { S: 1, A: 0.8, B: 0.6, C: 0.4, D: 0.1 }[letter] ?? 0.8;\\n      live.score = Math.round(par * ratio);\\n      live.rank = rankFor(live.score, par, null);\\n      live.over = true;\\n      live.complete = true;\\n      live.failed = null;\\n      model.screen = 'Report';\\n      model.reached?.add('Report');\\n    });\\n110→  } else if (name === 'god') {\\n    live.cheats.lockVitals = !live.cheats.lockVitals;\\n  } else if (name === 'freeze') {\\n    live.cheats.freezeTimer = !live.cheats.freezeTimer;\\n  } else if (name === 'composure') {\\n    live.cheats.infiniteComposure = !live.cheats.infiniteComposure;\\n  } else if (name === 'clamps') {\\n    live.cheats.infiniteClamps = !live.cheats.infiniteClamps;\\n  } else if (name === 'bleeder') {\\n    go(() => {\\n120→      const seat = live.seats[0];\\n      live.spawn({ kind: 'bleeder', site: live.activeSite, at: [seat.x, seat.y] });\\n    });\\n  } else if (name.startsWith('strain:')) {\\n    go(() => {\\n      const kind = name.slice(7);\\n      const seat = live.seats[0];\\n      live.spawn({ kind, strain: kind, site: live.activeSite, at: [seat.x, seat.y], hp: 40 });\\n    });\\n  } else if (name === 'arrest') {\\n130→    go(() => { if (!live.arrest) live.beginArrest({ clock: 8 }); });\\n  } else if (name === 'fortissimo') {\\n    go(() => live.act({ event: 'fortissimo' }));\\n  } else if (name === 'hush') {\\n    go(() => {\\n      live.hushPhase = 'wash';\\n      live.hushT = live.tuning.hushDuration;\\n      live.events.push({ type: 'hush', phase: 'wash' });\\n    });\\n  } else if (name === 'sforzando') {\\n140→    go(() => { live.sforzandoT = live.tuning.sforzandoDuration; });\\n  } else if (name === 'speed') {\\n    const cur = live.cheats.timeScale || 1;\\n    live.cheats.timeScale = cur >= 4 ? 0.1 : Math.round(Math.min(4, cur * 2) * 10) / 10;\\n  } else if (name === 'step') {\\n    go(() => { if (!live.over) live.step(); });\\n  } else if (name === 'auto') {\\n    model.botOn = !model.botOn;\\n  } else if (name.startsWith('overlay:')) {\\n    const key = name.slice(8);\\n150→    model.overlays[key] = !model.overlays[key];\\n  } else if (name === 'ink:lines') {\\n    const u = model.view?.ink?.u;\\n    if (u) u.lineOn.value = u.lineOn.value ? 0 : 1;\\n  } else if (name === 'ink:tone') {\\n    const u = model.view?.ink?.u;\\n    if (u) u.toneOn.value = u.toneOn.value ? 0 : 1;\\n  } else if (name === 'ink:boil') {\\n    model.view?.setBoil?.(!(model.boilOn === false));\\n    model.boilOn = model.boilOn === false;\\n160→  } else if (name === 'ink:shadows') {\\n    const map = model.view?.renderer?.shadowMap;\\n    if (map) map.enabled = !map.enabled;\\n  } else if (name === 'reset-all') {\\n    resetTuning(model.tuning);\\n  } else if (name === 'reset-page') {\\n    const keys = arg || Object.keys(TUNING_DEFAULTS);\\n    resetTuning(model.tuning, keys);\\n  }\\n  if (live.over && live.complete && model.screen === 'Operation') {\\n170→    model.screen = 'Report';\\n    model.reached?.add('Report');\\n  } else if (live.over && live.failed && model.screen === 'Operation') {\\n    model.screen = 'Fail';\\n    model.reached?.add('Fail');\\n  }\\n  model.paint?.();\\n  return true;\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/dev.js\",\"offset\":null,\"raw_output\":\"import { ALL_OPS } from '../data/ops/index.js';\\nimport { SCENES } from '../data/story/scenes.js';\\nimport { rankFor } from '../sim/scoring.js';\\nimport { Sim } from '../sim/sim.js';\\nimport { resetTuning, TUNING_DEFAULTS } from '../config/tuning.js';\\n\\nconst STRAINS = ['adagio', 'staccato', 'tremolo', 'legato', 'crescendo', 'fermata', 'coda'];\\n\\nexport const DEV_IDS = [\\n  ...ALL_OPS.map((op) => `op:${op.id}`),\\n  'phase-next', 'unlock', 'scene-next',\\n  'complete-objective', 'complete-phase', 'win', 'fail',\\n  'rank:S', 'rank:A', 'rank:B', 'rank:C', 'rank:D',\\n  'god', 'freeze', 'composure', 'clamps',\\n  'bleeder', ...STRAINS.map((k) => `strain:${k}`),\\n  'arrest', 'fortissimo', 'hush', 'sforzando',\\n  'speed', 'step', 'auto',\\n  'overlay:grid', 'overlay:targets', 'overlay:beat', 'overlay:input',\\n  'ink:lines', 'ink:tone', 'ink:boil', 'ink:shadows',\\n  'reset-page', 'reset-all',\\n];\\n\\nfunction fresh(model, opId) {\\n  const prev = model.sim;\\n  try { prev?.physics?.free?.(); } catch { /* world already freed */ }\\n  const sim = new Sim({\\n    op: opId,\\n    seed: 1,\\n    physics: false,\\n    tuning: model.tuning,\\n    difficulty: model.settings.difficulty || 'resident',\\n    players: 1,\\n  });\\n  model.sim = sim;\\n  model.screen = 'Operation';\\n  model.overlay = null;\\n  model.opId = opId;\\n  model.reached?.add('Operation');\\n  model.resultShown = false;\\n  return sim;\\n}\\n\\nexport function runDev(model, id, arg) {\\n  const name = String(id || '');\\n  const sim = () => model.sim;\\n  const go = (fn) => {\\n    try { fn(); } catch { /* a tool on a finished op stays quiet */ }\\n  };\\n  if (name.startsWith('op:')) {\\n    const opId = name.slice(3);\\n    go(() => {\\n      const simx = fresh(model, opId);\\n      if (arg) simx.skipTo(arg);\\n    });\\n    return true;\\n  }\\n  if (name === 'jump') {\\n    go(() => {\\n      const simx = fresh(model, arg?.op || 'broken-glass');\\n      if (arg?.phase) simx.skipTo(arg.phase);\\n    });\\n    return true;\\n  }\\n  if (name === 'unlock') {\\n    model.save.unlocked = true;\\n    model.persist?.();\\n    return true;\\n  }\\n  if (name === 'scene-next' || name === 'scene') {\\n    const cur = SCENES.findIndex((s) => s.id === (arg || model.sceneId));\\n    const next = SCENES[(cur + 1 + SCENES.length) % SCENES.length];\\n    model.openScene?.(arg && name === 'scene' ? arg : next.id, () => model.setScreen?.('Main Menu', null));\\n    return true;\\n  }\\n  const live = sim();\\n  if (!live) return true;\\n  if (name === 'phase-next') {\\n    go(() => {\\n      const phases = live.op.phases;\\n      const i = Math.min(phases.length - 1, live.phaseIndex + 1);\\n      live.skipTo(phases[i].id);\\n    });\\n  } else if (name === 'complete-objective') {\\n    go(() => {\\n      for (const e of live.entities) e.alive = false;\\n      live.vitals = 100;\\n      live.flags.stabilized = true;\\n      live.arrestsSurvived = 99;\\n      if (!live.over) live.completePhase();\\n    });\\n  } else if (name === 'complete-phase') {\\n    go(() => { if (!live.over) live.completePhase(); });\\n  } else if (name === 'win') {\\n    go(() => { if (!live.over) live.succeed(); });\\n  } else if (name === 'fail') {\\n    go(() => { if (!live.over) live.fail('vitals'); });\\n  } else if (name.startsWith('rank:')) {\\n    go(() => {\\n      const letter = name.slice(5);\\n      const par = live.op.parScore || 1;\\n      const ratio = { S: 1, A: 0.8, B: 0.6, C: 0.4, D: 0.1 }[letter] ?? 0.8;\\n      live.score = Math.round(par * ratio);\\n      live.rank = rankFor(live.score, par, null);\\n      live.over = true;\\n      live.complete = true;\\n      live.failed = null;\\n      model.screen = 'Report';\\n      model.reached?.add('Report');\\n    });\\n  } else if (name === 'god') {\\n    live.cheats.lockVitals = !live.cheats.lockVitals;\\n  } else if (name === 'freeze') {\\n    live.cheats.freezeTimer = !live.cheats.freezeTimer;\\n  } else if (name === 'composure') {\\n    live.cheats.infiniteComposure = !live.cheats.infiniteComposure;\\n  } else if (name === 'clamps') {\\n    live.cheats.infiniteClamps = !live.cheats.infiniteClamps;\\n  } else if (name === 'bleeder') {\\n    go(() => {\\n      const seat = live.seats[0];\\n      live.spawn({ kind: 'bleeder', site: live.activeSite, at: [seat.x, seat.y] });\\n    });\\n  } else if (name.startsWith('strain:')) {\\n    go(() => {\\n      const kind = name.slice(7);\\n      const seat = live.seats[0];\\n      live.spawn({ kind, strain: kind, site: live.activeSite, at: [seat.x, seat.y], hp: 40 });\\n    });\\n  } else if (name === 'arrest') {\\n    go(() => { if (!live.arrest) live.beginArrest({ clock: 8 }); });\\n  } else if (name === 'fortissimo') {\\n    go(() => live.act({ event: 'fortissimo' }));\\n  } else if (name === 'hush') {\\n    go(() => {\\n      live.hushPhase = 'wash';\\n      live.hushT = live.tuning.hushDuration;\\n      live.events.push({ type: 'hush', phase: 'wash' });\\n    });\\n  } else if (name === 'sforzando') {\\n    go(() => { live.sforzandoT = live.tuning.sforzandoDuration; });\\n  } else if (name === 'speed') {\\n    const cur = live.cheats.timeScale || 1;\\n    live.cheats.timeScale = cur >= 4 ? 0.1 : Math.round(Math.min(4, cur * 2) * 10) / 10;\\n  } else if (name === 'step') {\\n    go(() => { if (!live.over) live.step(); });\\n  } else if (name === 'auto') {\\n    model.botOn = !model.botOn;\\n  } else if (name.startsWith('overlay:')) {\\n    const key = name.slice(8);\\n    model.overlays[key] = !model.overlays[key];\\n  } else if (name === 'ink:lines') {\\n    const u = model.view?.ink?.u;\\n    if (u) u.lineOn.value = u.lineOn.value ? 0 : 1;\\n  } else if (name === 'ink:tone') {\\n    const u = model.view?.ink?.u;\\n    if (u) u.toneOn.value = u.toneOn.value ? 0 : 1;\\n  } else if (name === 'ink:boil') {\\n    model.view?.setBoil?.(!(model.boilOn === false));\\n    model.boilOn = model.boilOn === false;\\n  } else if (name === 'ink:shadows') {\\n    const map = model.view?.renderer?.shadowMap;\\n    if (map) map.enabled = !map.enabled;\\n  } else if (name === 'reset-all') {\\n    resetTuning(model.tuning);\\n  } else if (name === 'reset-page') {\\n    const keys = arg || Object.keys(TUNING_DEFAULTS);\\n    resetTuning(model.tuning, keys);\\n  }\\n  if (live.over && live.complete && model.screen === 'Operation') {\\n    model.screen = 'Report';\\n    model.reached?.add('Report');\\n  } else if (live.over && live.failed && model.screen === 'Operation') {\\n    model.screen = 'Fail';\\n    model.reached?.add('Fail');\\n  }\\n  model.paint?.();\\n  return true;\\n}\\n\",\"total_lines\":178}}","is_error":false},{"type":"tool_result","tool_use_id":"call-3e4a808e-d962-405d-aa41-d4c04bc5d2bf-7","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { toolFromStick, WHEEL } from './glyphs.js';\\n\\nconst DEAD = 0.12;\\n\\nfunction emptyFrame() {\\n  return { source: 'stick', x: 0, y: 0, use: 0, tool: null, steady: false, alt: false, syringe: false, special: false, siteDelta: 0, swap: false };\\n}\\n\\nexport function createInput(game) {\\n10→  const keys = new Set();\\n  const pointer = { x: 0, y: 0, dx: 0, dy: 0, down: false, button: 0, clicked: null, hover: null, moved: 0 };\\n  let device = 'keyboard';\\n  let seenPad = false;\\n  const prevPad = [null, null, null, null];\\n  let wheelPick = 'gel';\\n\\n  const codeOf = (e) => (e.code || e.key || '').toString();\\n  const keyOf = (e) => (e.key || '').toString();\\n\\n20→  function markKey(e) {\\n    device = 'keyboard';\\n    const names = [codeOf(e), keyOf(e), keyOf(e).toLowerCase()];\\n    if (e.type === 'keydown') names.forEach((n) => n && keys.add(n));\\n    else names.forEach((n) => keys.delete(n));\\n  }\\n\\n  window.addEventListener('keydown', (e) => {\\n    markKey(e);\\n    if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key) || e.code === 'Space') e.preventDefault();\\n30→    game.onKey?.(e);\\n  });\\n  window.addEventListener('keyup', markKey);\\n\\n  window.addEventListener('pointermove', (e) => {\\n    const dx = e.clientX - pointer.x;\\n    const dy = e.clientY - pointer.y;\\n    pointer.x = e.clientX;\\n    pointer.y = e.clientY;\\n    pointer.moved += Math.hypot(dx, dy);\\n40→    if (pointer.moved > 4) {\\n      device = 'mouse';\\n      pointer.moved = 4;\\n    }\\n    const item = e.target?.closest?.('[data-item]');\\n    pointer.hover = item ? item.dataset.item : null;\\n    if (pointer.hover) game.onHover?.(pointer.hover);\\n  });\\n  window.addEventListener('pointerdown', (e) => {\\n    device = 'mouse';\\n50→    pointer.down = true;\\n    pointer.button = e.button;\\n    pointer.x = e.clientX;\\n    pointer.y = e.clientY;\\n    game.audio?.resume?.();\\n  });\\n  window.addEventListener('pointerup', (e) => {\\n    pointer.down = false;\\n    const item = e.target?.closest?.('[data-item]');\\n    if (item) {\\n60→      pointer.clicked = item.dataset.item;\\n      game.onActivate?.(item.dataset.item);\\n    }\\n    const tool = e.target?.closest?.('[data-tool]');\\n    if (tool) game.onTool?.(tool.dataset.tool);\\n  });\\n  window.addEventListener('contextmenu', (e) => e.preventDefault());\\n  window.addEventListener('wheel', (e) => {\\n    if (game.screen === 'Operation') {\\n      const dir = e.deltaY > 0 ? 1 : -1;\\n70→      const i = WHEEL.indexOf(wheelPick);\\n      wheelPick = WHEEL[(i + dir + WHEEL.length) % WHEEL.length];\\n      game.onTool?.(wheelPick);\\n    }\\n  }, { passive: true });\\n\\n  function down(...names) {\\n    return names.some((n) => keys.has(n));\\n  }\\n\\n80→  function readPad(index) {\\n    const pads = navigator.getGamepads ? navigator.getGamepads() : [];\\n    const pad = pads[index];\\n    if (!pad || pad.mapping !== 'standard') return null;\\n    const b = (i) => pad.buttons[i] || { pressed: false, value: 0 };\\n    const axes = pad.axes || [0, 0, 0, 0];\\n    const active = b(0).pressed || b(1).pressed || b(7).value > 0.1 || Math.hypot(axes[2] || 0, axes[3] || 0) > DEAD || Math.hypot(axes[0] || 0, axes[1] || 0) > DEAD;\\n    if (active) {\\n      device = 'pad';\\n      seenPad = true;\\n90→    }\\n    return { pad, b, axes };\\n  }\\n\\n  function frameFromPad(index, settings) {\\n    const got = readPad(index);\\n    if (!got) return null;\\n    const { b, axes } = got;\\n    const swap = !!settings.swapSticks;\\n    const aimX = swap ? axes[0] : axes[2];\\n100→    const aimY = swap ? axes[1] : axes[3];\\n    const toolX = swap ? axes[2] : axes[0];\\n    const toolY = swap ? axes[3] : axes[1];\\n    const frame = emptyFrame();\\n    frame.source = 'stick';\\n    frame.x = aimX || 0;\\n    frame.y = -(aimY || 0);\\n    frame.use = Math.max(b(7).value || 0, b(0).pressed ? 1 : 0);\\n    frame.steady = b(6).pressed || b(6).value > 0.4;\\n    frame.alt = b(1).pressed;\\n110→    frame.syringe = b(2).pressed || b(14).pressed;\\n    frame.special = b(3).pressed || b(12).pressed;\\n    frame.swap = b(15).pressed;\\n    if (b(4).pressed) frame.siteDelta = -1;\\n    if (b(5).pressed) frame.siteDelta = 1;\\n    const picked = toolFromStick(toolX || 0, -(toolY || 0), wheelPick);\\n    if (Math.hypot(toolX || 0, toolY || 0) > 0.6) {\\n      wheelPick = picked;\\n      frame.tool = picked;\\n    }\\n120→    const prev = prevPad[index] || {};\\n    const up = b(12).pressed || (axes[1] || 0) < -0.55;\\n    const down = b(13).pressed || (axes[1] || 0) > 0.55;\\n    const edges = {\\n      confirm: b(0).pressed && !prev.confirm,\\n      back: b(1).pressed && !prev.back,\\n      pause: b(9).pressed && !prev.pause && !b(8).pressed,\\n      special: b(3).pressed && !prev.special,\\n      pageLeft: b(4).pressed && !prev.l1,\\n      pageRight: b(5).pressed && !prev.r1,\\n130→      up: up && !prev.up,\\n      down: down && !prev.down,\\n      create: b(8).pressed,\\n      more: (b(3).pressed && !prev.special),\\n    };\\n    prevPad[index] = {\\n      confirm: b(0).pressed, back: b(1).pressed, pause: b(9).pressed, special: b(3).pressed,\\n      l1: b(4).pressed, r1: b(5).pressed, up, down,\\n    };\\n    if (settings.rumble && got.pad.vibrationActuator && b(7).value > 0.8) {\\n140→      try { got.pad.vibrationActuator.playEffect('dual-rumble', { duration: 40, strongMagnitude: 0.2, weakMagnitude: 0.3 }); } catch { /* actuator missing */ }\\n    }\\n    return { frame, edges };\\n  }\\n\\n  function keyboardFrame(settings) {\\n    const frame = emptyFrame();\\n    const mouseAim = device === 'mouse' && game.view?.pointerToField;\\n    if (mouseAim && game.screen === 'Operation') {\\n      const p = game.view.pointerToField(pointer.x, pointer.y);\\n150→      frame.source = 'abs';\\n      frame.x = p.x;\\n      frame.y = p.y;\\n      frame.use = pointer.down && pointer.button === 0 ? 1 : 0;\\n      frame.alt = pointer.button === 2 && pointer.down;\\n    } else {\\n      let x = 0;\\n      let y = 0;\\n      if (down('KeyA', 'a', 'ArrowLeft')) x -= 1;\\n      if (down('KeyD', 'd', 'ArrowRight')) x += 1;\\n160→      if (down('KeyW', 'w', 'ArrowUp')) y += 1;\\n      if (down('KeyS', 's', 'ArrowDown')) y -= 1;\\n      frame.source = 'stick';\\n      frame.x = x;\\n      frame.y = y;\\n      frame.use = down('KeyJ', 'j', 'Enter') ? 1 : 0;\\n    }\\n    frame.steady = down('ShiftLeft', 'ShiftRight', 'Shift');\\n    frame.syringe = down('KeyF', 'f');\\n    frame.special = down('Space', ' ');\\n170→    frame.swap = down('KeyR', 'r');\\n    if (down('KeyQ', 'q')) frame.siteDelta = -1;\\n    if (down('KeyE', 'e')) frame.siteDelta = 1;\\n    for (let i = 0; i < 8; i++) {\\n      if (down(`Digit${i + 1}`, String(i + 1))) {\\n        wheelPick = WHEEL[i];\\n        frame.tool = WHEEL[i];\\n      }\\n    }\\n    if (down('KeyC', 'c')) {\\n180→      frame.source = 'abs';\\n      frame.x = -1.05;\\n      frame.y = 0.62;\\n    }\\n    void settings;\\n    return frame;\\n  }\\n\\n  function menuEdges() {\\n    return {\\n190→      up: down('ArrowUp', 'KeyW', 'w'),\\n      down: down('ArrowDown', 'KeyS', 's'),\\n      left: down('ArrowLeft', 'KeyA', 'a'),\\n      right: down('ArrowRight', 'KeyD', 'd'),\\n      confirm: down('Enter', 'Space', ' '),\\n      back: down('Escape', 'Backspace'),\\n      skip: down('Tab'),\\n      pageLeft: down('KeyQ', 'q'),\\n      pageRight: down('KeyE', 'e'),\\n    };\\n200→  }\",\"content_concise\":\"1→import { toolFromStick, WHEEL } from './glyphs.js';\\n\\nconst DEAD = 0.12;\\n\\nfunction emptyFrame() {\\n  return { source: 'stick', x: 0, y: 0, use: 0, tool: null, steady: false, alt: false, syringe: false, special: false, siteDelta: 0, swap: false };\\n}\\n\\nexport function createInput(game) {\\n10→  const keys = new Set();\\n  const pointer = { x: 0, y: 0, dx: 0, dy: 0, down: false, button: 0, clicked: null, hover: null, moved: 0 };\\n  let device = 'keyboard';\\n  let seenPad = false;\\n  const prevPad = [null, null, null, null];\\n  let wheelPick = 'gel';\\n\\n  const codeOf = (e) => (e.code || e.key || '').toString();\\n  const keyOf = (e) => (e.key || '').toString();\\n\\n20→  function markKey(e) {\\n    device = 'keyboard';\\n    const names = [codeOf(e), keyOf(e), keyOf(e).toLowerCase()];\\n    if (e.type === 'keydown') names.forEach((n) => n && keys.add(n));\\n    else names.forEach((n) => keys.delete(n));\\n  }\\n\\n  window.addEventListener('keydown', (e) => {\\n    markKey(e);\\n    if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', ' '].includes(e.key) || e.code === 'Space') e.preventDefault();\\n30→    game.onKey?.(e);\\n  });\\n  window.addEventListener('keyup', markKey);\\n\\n  window.addEventListener('pointermove', (e) => {\\n    const dx = e.clientX - pointer.x;\\n    const dy = e.clientY - pointer.y;\\n    pointer.x = e.clientX;\\n    pointer.y = e.clientY;\\n    pointer.moved += Math.hypot(dx, dy);\\n40→    if (pointer.moved > 4) {\\n      device = 'mouse';\\n      pointer.moved = 4;\\n    }\\n    const item = e.target?.closest?.('[data-item]');\\n    pointer.hover = item ? item.dataset.item : null;\\n    if (pointer.hover) game.onHover?.(pointer.hover);\\n  });\\n  window.addEventListener('pointerdown', (e) => {\\n    device = 'mouse';\\n50→    pointer.down = true;\\n    pointer.button = e.button;\\n    pointer.x = e.clientX;\\n    pointer.y = e.clientY;\\n    game.audio?.resume?.();\\n  });\\n  window.addEventListener('pointerup', (e) => {\\n    pointer.down = false;\\n    const item = e.target?.closest?.('[data-item]');\\n    if (item) {\\n60→      pointer.clicked = item.dataset.item;\\n      game.onActivate?.(item.dataset.item);\\n    }\\n    const tool = e.target?.closest?.('[data-tool]');\\n    if (tool) game.onTool?.(tool.dataset.tool);\\n  });\\n  window.addEventListener('contextmenu', (e) => e.preventDefault());\\n  window.addEventListener('wheel', (e) => {\\n    if (game.screen === 'Operation') {\\n      const dir = e.deltaY > 0 ? 1 : -1;\\n70→      const i = WHEEL.indexOf(wheelPick);\\n      wheelPick = WHEEL[(i + dir + WHEEL.length) % WHEEL.length];\\n      game.onTool?.(wheelPick);\\n    }\\n  }, { passive: true });\\n\\n  function down(...names) {\\n    return names.some((n) => keys.has(n));\\n  }\\n\\n80→  function readPad(index) {\\n    const pads = navigator.getGamepads ? navigator.getGamepads() : [];\\n    const pad = pads[index];\\n    if (!pad || pad.mapping !== 'standard') return null;\\n    const b = (i) => pad.buttons[i] || { pressed: false, value: 0 };\\n    const axes = pad.axes || [0, 0, 0, 0];\\n    const active = b(0).pressed || b(1).pressed || b(7).value > 0.1 || Math.hypot(axes[2] || 0, axes[3] || 0) > DEAD || Math.hypot(axes[0] || 0, axes[1] || 0) > DEAD;\\n    if (active) {\\n      device = 'pad';\\n      seenPad = true;\\n90→    }\\n    return { pad, b, axes };\\n  }\\n\\n  function frameFromPad(index, settings) {\\n    const got = readPad(index);\\n    if (!got) return null;\\n    const { b, axes } = got;\\n    const swap = !!settings.swapSticks;\\n    const aimX = swap ? axes[0] : axes[2];\\n100→    const aimY = swap ? axes[1] : axes[3];\\n    const toolX = swap ? axes[2] : axes[0];\\n    const toolY = swap ? axes[3] : axes[1];\\n    const frame = emptyFrame();\\n    frame.source = 'stick';\\n    frame.x = aimX || 0;\\n    frame.y = -(aimY || 0);\\n    frame.use = Math.max(b(7).value || 0, b(0).pressed ? 1 : 0);\\n    frame.steady = b(6).pressed || b(6).value > 0.4;\\n    frame.alt = b(1).pressed;\\n110→    frame.syringe = b(2).pressed || b(14).pressed;\\n    frame.special = b(3).pressed || b(12).pressed;\\n    frame.swap = b(15).pressed;\\n    if (b(4).pressed) frame.siteDelta = -1;\\n    if (b(5).pressed) frame.siteDelta = 1;\\n    const picked = toolFromStick(toolX || 0, -(toolY || 0), wheelPick);\\n    if (Math.hypot(toolX || 0, toolY || 0) > 0.6) {\\n      wheelPick = picked;\\n      frame.tool = picked;\\n    }\\n120→    const prev = prevPad[index] || {};\\n    const up = b(12).pressed || (axes[1] || 0) < -0.55;\\n    const down = b(13).pressed || (axes[1] || 0) > 0.55;\\n    const edges = {\\n      confirm: b(0).pressed && !prev.confirm,\\n      back: b(1).pressed && !prev.back,\\n      pause: b(9).pressed && !prev.pause && !b(8).pressed,\\n      special: b(3).pressed && !prev.special,\\n      pageLeft: b(4).pressed && !prev.l1,\\n      pageRight: b(5).pressed && !prev.r1,\\n130→      up: up && !prev.up,\\n      down: down && !prev.down,\\n      create: b(8).pressed,\\n      more: (b(3).pressed && !prev.special),\\n    };\\n    prevPad[index] = {\\n      confirm: b(0).pressed, back: b(1).pressed, pause: b(9).pressed, special: b(3).pressed,\\n      l1: b(4).pressed, r1: b(5).pressed, up, down,\\n    };\\n    if (settings.rumble && got.pad.vibrationActuator && b(7).value > 0.8) {\\n140→      try { got.pad.vibrationActuator.playEffect('dual-rumble', { duration: 40, strongMagnitude: 0.2, weakMagnitude: 0.3 }); } catch { /* actuator missing */ }\\n    }\\n    return { frame, edges };\\n  }\\n\\n  function keyboardFrame(settings) {\\n    const frame = emptyFrame();\\n    const mouseAim = device === 'mouse' && game.view?.pointerToField;\\n    if (mouseAim && game.screen === 'Operation') {\\n      const p = game.view.pointerToField(pointer.x, pointer.y);\\n150→      frame.source = 'abs';\\n      frame.x = p.x;\\n      frame.y = p.y;\\n      frame.use = pointer.down && pointer.button === 0 ? 