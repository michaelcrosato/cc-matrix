gin: [{ wipe: 'fermata' }],\\n      spawn: [{ kind: 'fermata', site: 'heart', at: [0, 0.05], tutorial: true, needed: 9, hp: 1 }],\\n      done: { arrests: 1 },\\n      say: [{ at: 0, who: 'bea', mood: 'calm', text: 'Flat line. Charge, and let it go inside the gold. No heroics, just the window.' }],\\n    },\\n    {\\n      id: 'antidote',\\n      objective: 'Inject the three sites',\\n      tools: ['syringe', 'clamp', 'suction'],\\n      spawn: [\\n        { kind: 'injection', site: 'heart', at: [-0.35, 0.16] },\\n        { kind: 'injection', site: 'heart', at: [0.15, 0.2] },\\n        { kind: 'injection', site: 'heart', at: [0.05, -0.2] },\\n        { kind: 'bleeder', site: 'heart', at: [-0.15, -0.05] },\\n      ],\\n      done: { cleared: ['injection'], clamped: true, poolsClear: true },\\n      say: [{ at: 0, who: 'ines', mood: 'cool', text: 'Three doses, on the tissue, not in the air. I can hear you hesitating.' }],\\n    },\\n    {\\n      id: 'arrest2',\\n      objective: 'Burn the eye, then shock',\\n      tools: ['laser', 'defib'],\\n      begin: [{ wipe: 'fermata' }],\\n      spawn: [{ kind: 'fermata', site: 'heart', at: [0.02, 0.06], hp: 60, needed: 9 }],\\n      done: { arrests: 2 },\\n      say: [{ at: 0, who: 'bea', mood: 'focus', text: 'The eye is open because the heart is not. Burn it, then the paddles.' }],\\n    },\\n    {\\n      id: 'arrest3',\\n      objective: 'Take the eye',\\n      tools: ['laser', 'defib', 'forceps'],\\n      begin: [{ wipe: 'fermata' }],\\n      spawn: [{ kind: 'fermata', site: 'heart', at: [0, 0.04], hp: 80, needed: 1 }],\\n      done: { arrests: 3, cleared: ['fermata'] },\\n      say: [{ at: 0, who: 'bea', mood: 'stern', text: 'Once more. Then pull the eye out like a bad note.' }],\\n    },\\n    {\\n      id: 'close',\\n      objective: 'Close the chest',\\n      tools: ['suture', 'gel', 'forceps'],\\n      spawn: [\\n        { kind: 'wound', site: 'heart', at: [-0.4, 0], gates: gates(-0.55, 0.06, 0.5, -0.04, 10) },\\n   