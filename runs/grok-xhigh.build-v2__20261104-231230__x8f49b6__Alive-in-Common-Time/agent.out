een === 'Report' || model.screen === 'Fail') && model.opId) {\\n      const op = safeOp(model.opId);\\n      id = model.screen === 'Operation' ? (op?.music || 'or-calm') : 'or-tense';\\n      bpm = op?.bpm || 80;\\n560→    } else if (model.screen === 'Credits roll') id = 'credits';\\n    else if (model.screen === 'Lobby') id = 'rounds';\\n    if (id !== model.track) {\\n      model.track = id;\\n      audio.playTrack(id, bpm);\\n    }\\n    audio.setHush(!!(model.sim && model.sim.hushPhase));\\n  }\\n\\n  function present() {\\n570→    const view = model.view;\\n    if (!view) return;\\n    if (model.screen === 'Story' && model.scene) {\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/app/director.js\",\"offset\":543,\"limit\":30,\"raw_output\":\"  }\\n\\n  function syncMusic() {\\n    if (!audioOk()) return;\\n    let id = 'title';\\n    let bpm = 80;\\n    if (model.mode === 'session') {\\n      id = (model.screen === 'Card' || model.screen === 'Countdown') ? 'title' : 'rounds';\\n    } else if (model.attract.on && model.sim) {\\n      id = model.sim.op.music || 'rounds';\\n      bpm = model.sim.op.bpm || 80;\\n    } else if (model.screen === 'Story' && model.scene?.music) {\\n      id = model.scene.music;\\n    } else if ((model.screen === 'Operation' || model.screen === 'Chart' || model.screen === 'Report' || model.screen === 'Fail') && model.opId) {\\n      const op = safeOp(model.opId);\\n      id = model.screen === 'Operation' ? (op?.music || 'or-calm') : 'or-tense';\\n      bpm = op?.bpm || 80;\\n    } else if (model.screen === 'Credits roll') id = 'credits';\\n    else if (model.screen === 'Lobby') id = 'rounds';\\n    if (id !== model.track) {\\n      model.track = id;\\n      audio.playTrack(id, bpm);\\n    }\\n    audio.setHush(!!(model.sim && model.sim.hushPhase));\\n  }\\n\\n  function present() {\\n    const view