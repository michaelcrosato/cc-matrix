0,\\n      Accuracy: raw.Accuracy ?? 100,\\n    };\\n  }\\n  if (ranked[0]) awards.push({ id: ranked[0].id, title: 'Steadiest Hands', detail: 'Led the table this round' });\\n  const won = !!(sim && sim.complete && !sim.failed && sim.vitals > 0);\\n  return { standings, scores, won, stats, awards };\\n}\\n\\nexport function runSession(model, info) {\\n  const left = new Set();\\n  const cmds = new Map();\\n  const bucket = { tokens: 8, burst: 8, rate: 16, t: performance.now() };\\n  const local = { x: -1.05, y: 0.62, tool: 'gel', use: 0, steady: false };\\n  let ended = false;\\n  let finished = false;\\n  let base = null;\\n  let seq = 0;\\n  let acc = 0;\\n  let accI = 0;\\n  let accS = 100;\\n  let accK = 1000;\\n  let accE = 0;\\n  let failedGfx = false;\\n  let last = performance.now();\\n  const evQueue = [];\\n  model.sessionInfo = info;\\n  model.mode = 'session';\\n  model.screen = 'Card';\\n  model.card = { left: null, ready: [], asking: 0 };\\n  model.sessionPause = false;\\n\\n  function finish(forceWon) {\\n    if (!info.isHost || finished || ended) return;\\n    finished = true;\\n    const out = outcome(model, info, left);\\n    if (typeof forceWon === 'boolean') out.won = forceWon && out.won;\\n    try { AIHub.finish(out); } catch { /* host only; the client warns if misused */ }\\n  }\\n\\n  AIHub.on('card', (card) => {\\n    model.card = card || model.card;\\n    if (AIHub.time() === -Infinity) model.screen = 'Card';\\n    model.paint?.();\\n  });\\n  AIHub.on('start', () => {\\n    model.started = true;\\n  });\\n  AIHub.on('message', (data, from) => {\\n    if (!data || ended) return;\\n    if (data.t === 'i' || data.t === 'a') {\\n      if (!model.sim || from === AIHub.me) return;\\n      const cur = cmds.get(from) || { source: 'abs', x: 0, y: 0, use: 0, tool: 'gel' };\\n      if (data.t === 'i') {\\n        cur.source = 'abs';\\n        cur.x = data.x;\\n        cur.y = data.y;\\n        if (data.tool) cur.tool = data.tool;\\n        cur.use = data.use || 0;\\n        cur.steady = !!data.steady;\\n      } else {\\n        if (data.syringe) cur.syringe = true;\\n        if (data.special) cur.special = true;\\n        if (data.alt) cur.alt = true;\\n        if (data.swap) cur.swap = true;\\n        if (data.siteDelta) cur.siteDelta = data.siteDelta;\\n        if (Number.isInteger(data.site)) cur.site = data.site;\\n      }\\n      cmds.set(from, cur);\\n      return;\\n    }\\n    if (from !== info.host) return;\\n    if (data.t === 'k') {\\n      const dec = decodeKeyframe(data);\\n      if (!base || dec.tick == null || base.tick == null || dec.tick >= base.tick) base = dec;\\n    } else if (data.t === 's' && base) {\\n      base = applyUnreliable(base, data);\\n    } else if (data.t === 'e' && data.ev) {\\n      model.remoteEvents = data.ev;\\n    }\\n    model.netState = base;\\n  });\\n  AIHub.on('leave', ({ id }) => {\\n    left.add(id);\\n    try { model.sim?.leave(id); } catch { /* already gone */ }\\n  });\\n  AIHub.on('time-up', () => {\\n    if (model.sim?.complete) finish(true);\\n    else finish(false);\\n  });\\n  AIHub.on('end', () => {\\n    ended = true;\\n    model.screen = 'Round over';\\n    try { model.audio?.ctx?.suspend?.(); } catch { /* already suspended */ }\\n    model.paint?.();\\n  });\\n\\n  AIHub.ready();\\n\\n  const boot = (async () => {\\n    if (info.isHost) {\\n      let physics = false;\\n      try { await physicsReady(); physics = true; } catch { physics = false; }\\n      const rng = AIHub.rng('world');\\n      rng.int = (n) => Math.floor(rng() * n);\\n      rng.seed = AIHub.seed || 1;\\n      model.sim = new Sim({\\n        op: 'grand-rounds',\\n        players: info.players,\\n        rng,\\n        network: true,\\n        physics,\\n\",\"total_lines\":314}}","is_error":false},{"type":"tool_result","tool_use_id":"call-63287d18-2611-40c2-9e65-3d64965611cc-12","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1050→    }\\n    if (id === 'glyphs') {\\n      model.settings.glyphs = model.settings.glyphs === 'xbox' ? 'playstation' : 'xbox';\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'rumble' || id === 'swapSticks' || id === 'shake' || id === 'boil') {\\n      model.settings[id] = !model.settings[id];\\n      if (id === 'boil') model.view?.setBoil?.(!!model.settings.boil);\\n1060→      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (id === 'fullscreen') {\\n      model.settings.fullscreen = !model.settings.fullscreen;\\n      const node = document.documentElement;\\n      if (model.settings.fullscreen) node.requestFullscreen?.().catch(() => {});\\n      else document.exitFullscreen?.().catch(() => {});\\n      persist();\\n1070→      paint(true);\\n      return;\\n    }\\n    if (id === 'textSpeed') {\\n      model.settings.textSpeed = model.settings.textSpeed >= 4 ? 1 : model.settings.textSpeed * 2;\\n      persist();\\n      paint(true);\\n      return;\\n    }\\n    if (DEV_IDS.includes(id) || id === 'reset-page' || id === 'reset-all' || id === 'jump') {\\n1080→      const page = devPages()[model.page] || [];\\n      const found = page.find((item) => item.id === id);\\n      runDev(model, id, found?.keys);\\n      return;\\n    }\\n  }\\n\\n  function openSettings() {\\n    if (model.mode === 'session') {\\n      model.sessionPause = true;\\n1090→      paint(true);\\n      return;\\n    }\\n    model.returnTo = { screen: model.screen, overlay: model.overlay };\\n    model.page = 0;\\n    setScreen('Settings');\\n  }\\n\\n  function closeSettings() {\\n    if (model.mode === 'session') {\\n1100→      model.sessionPause = false;\\n      paint(true);\\n      return;\\n    }\\n    const ret = model.returnTo;\\n    model.returnTo = null;\\n    if (!ret) {\\n      setScreen('Main Menu');\\n      return;\\n    }\\n1110→    setScreen(ret.screen);\\n    if (ret.overlay) setOverlay(ret.overlay);\\n  }\\n  model.applySettings = (sample) => {\\n    const menu = sample?.menu || {};\\n    if (menu.pageLeft) turnPage(-1);\\n    else if (menu.pageRight) turnPage(1);\\n    else if (menu.up) moveFocus(-1);\\n    else if (menu.down) moveFocus(1);\\n    else if (menu.left) nudge(-1);\\n1120→    else if (menu.right) nudge(1);\\n    else if (menu.confirm) {\\n      const item = currentItems()[model.focus];\\n      if (item) activate(item.id);\\n    }\\n  };\\n\\n  function moveFocus(dir) {\\n    const items = currentItems();\\n    if (!items.length) return;\\n1130→    model.focus = (model.focus + dir + items.length) % items.length;\\n    if (model.screen === 'About' && !model.overlay) {\\n      const item = items[model.focus];\\n      if (item?.id?.startsWith('about:')) model.page = Number(item.id.slice(6)) || 0;\\n    }\\n    paint(true);\\n  }\\n\\n  function turnPage(dir) {\\n    const n = pageCount();\\n1140→    if (n <= 1) return false;\\n    model.page = (model.page + dir + n) % n;\\n    if (model.screen === 'About') {\\n      const head = aboutSlides()[model.page]?.head;\\n      const i = aboutItems().findIndex((item) => item.head === head);\\n      model.focus = i >= 0 ? i : 0;\\n    } else model.focus = 0;\\n    paint(true);\\n    return true;\\n  }\\n1150→\\n  function nudge(dir) {\\n    if (model.screen === 'Chart' && !model.overlay) {\\n      const order = ['intern', 'resident', 'attending'];\\n      const i = Math.max(0, order.indexOf(model.settings.difficulty || 'resident'));\\n      model.settings.difficulty = order[(i + (dir < 0 ? 2 : 1)) % 3];\\n      model.save.difficulty = model.settings.difficulty;\\n      persist();\\n      paint(true);\\n      return true;\\n1160→    }\\n    const item = currentItems()[model.focus];\\n    if (!item) return false;\\n    if (item.kind === 'slider') {\\n      const cur = item.id in TUNING_DEFAULTS ? model.tuning[item.id] : (model.settings[item.id] ?? item.min);\\n      const step = item.step || 0.05;\\n      const v = Math.max(item.min, Math.min(item.max, Math.round((cur + dir * step) * 1000) / 1000));\\n      writeSetting(item.id, v);\\n      paint(true);\\n      return true;\\n1170→    }\\n    if (item.kind === 'toggle' || item.kind === 'cycle' || item.id === 'glyphs' || item.id === 'textSpeed') {\\n      activate(item.id);\\n      return true;\\n    }\\n    return false;\\n  }\\n\\n  function prepFrame(id, frame) {\\n    const next = { ...(frame || {}) };\\n1180→    if (model.pendingTool && (id === 0 || id === model.sim?.seats?.[0]?.id)) {\\n      next.tool = model.pendingTool;\\n      model.pendingTool = null;\\n    }\\n    const prev = model.siteHold.get(id) || 0;\\n    if (next.siteDelta && next.siteDelta === prev) next.siteDelta = 0;\\n    model.siteHold.set(id, frame?.siteDelta || 0);\\n    return next;\\n  }\\n\\n1190→  function feedSim(sample) {\\n    const sim = model.sim;\\n    if (!sim || sim.over) return;\\n    const playing = model.attract.on || (model.screen === 'Operation' && !model.overlay && !model.sessionPause);\\n    if (!playing) return;\\n    if (model.botOn) {\\n      for (const seat of sim.seats) {\\n        if (seat.out) continue;\\n        sim.input(seat.id, prepFrame(seat.id, botInput(sim, seat, model.botOpts || {})));\\n      }\\n1200→    } else if (model.flow === 'couch') {\\n      for (const s of sample.seats) {\\n        if (!model.joined.has(s.index)) continue;\\n        const seat = sim.seats.find((x) => x.id === s.index);\\n        if (seat && !seat.out) sim.input(seat.id, prepFrame(seat.id, s.frame));\\n      }\\n    } else {\\n      const s0 = sample.seats.find((s) => s.index === 0);\\n      const seat = sim.seats[0];\\n      if (s0 && seat) sim.input(seat.id, prepFrame(seat.id, s0.frame));\\n1210→    }\\n    if (model.override && sim.seats[0]) {\\n      sim.input(sim.seats[0].id, prepFrame(sim.seats[0].id, model.override));\\n    }\\n    sim.step();\\n    for (const ev of sim.events || []) playEvent(ev);\\n    if (model.attract.on && sim.over) nextAttractOp();\\n    else if (!model.attract.on && sim.over && !model.re