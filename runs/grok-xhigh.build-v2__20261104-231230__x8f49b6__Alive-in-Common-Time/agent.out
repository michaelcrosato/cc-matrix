6,\"content\":\"      else finishVoid('no-result');\"},{\"line_number\":351,\"content\":\"  function finishResults() {\"},{\"line_number\":363,\"content\":\"    finishPlayed(gone.length ? [...ranked, gone] : ranked, { scores, results: Object.fromEntries(results), stats, awards });\"},{\"line_number\":366,\"content\":\"  function finishPlayed(standings, extra = {}) {\"},{\"line_number\":367,\"content\":\"    end({ status: 'played', reason: 'finished', endReason: 'finished', standings, ...extra });\"},{\"line_number\":370,\"content\":\"  function finishVoid(reason, endReason = 'void') {\"},{\"line_number\":429,\"content\":\"      case 'finish': {\"},{\"line_number\":430,\"content\":\"        if (selfReported()) return issue(seat, `finish is for a shared world; ${mode} games report result`);\"},{\"line_number\":431,\"content\":\"        if (seat !== host) return issue(seat, 'finish from a player who is not the host');\"},{\"line_number\":432,\"content\":\"        if (phase === 'loading') return issue(seat, 'finish before start');\"},{\"line_number\":434,\"content\":\"        if (!checked.ok) return issue(seat, `finish ignored: ${checked.problem}`);\"},{\"line_number\":441,\"content\":\"        return finishPlayed(checked.standings, { scores, won, stats, awards });\"},{\"line_number\":446,\"content\":\"          if (needsHost() && seat === host) return finishVoid('host-error');\"},{\"line_number\":455,\"content\":\"          seat.hidden = later(t.hiddenMs, () => finishVoid('host-hidden'));\"},{\"line_number\":517,\"content\":\"      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\"}]}]}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"94f846e9-cedc-466c-87ca-d6b7eeb165c3"}
