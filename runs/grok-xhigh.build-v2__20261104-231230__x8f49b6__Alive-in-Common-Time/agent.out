inMult: [0, 3],\\n  timerMult: [0.5, 2],\\n  tempoPressure: [0, 120],\\n  stabilizerHeal: [5, 30],\\n  stabilizerCooldown: [0.5, 8],\\n  missLimit: [3, 20],\\n  strainHpMult: [0.3, 3],\\n  strainSpeedMult: [0.3, 2.5],\\n  spawnRateMult: [0.3, 2.5],\\n  composureGain: [0.2, 3],\\n  hushDuration: [2, 15],\\n  hushTimeScale: [0.05, 0.7],\\n  sforzandoStun: [1, 6],\\n  sforzandoDamage: [0.05, 0.6],\\n  sforzandoToolMult: [1.2, 4],\\n  sforzandoDuration: [2, 12],\\n});\\n\\nexport const TUNING_PAGES = Object.freeze([\\n  { id: 'hands', label: 'Hands', keys: ['tipSpeed', 'stickCurve', 'aimAssist', 'steadyFactor'] },\\n  { id: 'tools', label: 'Tools', keys: ['scalpelTol', 'pullTol', 'suctionRate', 'gelRadius', 'stitchGateR', 'laserDps', 'laserBurn', 'scannerRadius', 'clampWindow', 'defibWindow'] },\\n  { id: 'patient', label: 'Patient', keys: ['drainMult', 'timerMult', 'tempoPressure', 'stabilizerHeal', 'stabilizerCooldown', 'missLimit'] },\\n  { id: 'strains', label: 'Strains', keys: ['strainHpMult', 'strainSpeedMult', 'spawnRateMult'] },\\n  { id: 'gifts', label: 'Gifts', keys: ['composureGain', 'hushDuration', 'hushTimeScale', 'sforzandoStun', 'sforzandoDamage', 'sforzandoToolMult', 'sforzandoDuration'] },\\n]);\\n\\nexport function createTuning(over) {\\n  return { ...TUNING_DEFAULTS, ...over };\\n}\\n\\n/** Copy defaults back onto a live object so holders of the reference see the reset. */\\n\",\"total_lines\":98}}","is_error":false},{"type":"tool_result","tool_use_id":"call-c4f6e396-baef-42fd-bdcb-223fa63ca792-17","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import brokenGlass from './broken-glass.js';\\nimport growthSpurt from './growth-spurt.js';\\nimport adagio from './adagio.js';\\nimport staccato from './staccato.js';\\nimport legato from './legato.js';\\nimport fermata from './fermata.js';\\nimport coda from './coda.js';\\nimport lastPatient from './last-patient.js';\\nimport grandRounds from './grand-rounds.js';\\n10→\\nexport const OPS = [brokenGlass, growthSpurt, adagio, staccato, legato, fermata, coda, lastPatient];\\nexport const ALL_OPS = [...OPS, grandRounds];\\n\\nconst byId = new Map(ALL_OPS.map((op) => [op.id, op]));\\n\\nexport function getOp(id) {\\n  const op = byId.get(id);\\n  if (!op) throw new Error(`unknown operation ${id}`);\\n  return op;\\n20→}\\n\\nexport function storyOrder() {\\n  return OPS.map((op) => op.id);\\n}\\n\",\"content_concise\":\"1→import brokenGlass from './broken-glass.js';\\nimport growthSpurt from './growth-spurt.js';\\nimport adagio from './adagio.js';\\nimport staccato from './staccato.js';\\nimport legato from './legato.js';\\nimport fermata from './fermata.js';\\nimport coda from './coda.js';\\nimport lastPatient from './last-patient.js';\\nimport grandRounds from './grand-rounds.js';\\n10→\\nexport const OPS = [brokenGlass, growthSpurt, adagio, staccato, legato, fermata, coda, lastPatient];\\nexport const ALL_OPS = [...OPS, grandRounds];\\n\\nconst byId = new Map(ALL_OPS.map((op) => [op.id, op]));\\n\\nexport function getOp(id) {\\n  const op = byId.get(id);\\n  if (!op) throw new Error(`unknown operation ${id}`);\\n  return op;\\n20→}\\n\\nexport function storyOrder() {\\n  return OPS.map((op) => op.id);\\n}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/data/ops/index.js\",\"offset\":null,\"raw_output\":\"import brokenGlass from './broken-glass.js';\\nimport growthSpurt from './growth-spurt.js';\\nimport adagio from './adagio.js';\\nimport staccato from './staccato.js';\\nimport legato from './legato.js';\\nimport fermata from './fermata.js';\\nimport coda from './coda.js';\\nimport lastPatient from './last-patient.js';\\nimport grandRounds from './grand-rounds.js';\\n\\nexport const OPS = [brokenGlass, growthSpurt, adagio, staccato, legato, fermata, coda, lastPatient];\\nexport const ALL_OPS = [...OPS, grandRounds];\\n\\nconst byId = new Map(ALL_OPS.map((op) => [op.id, op]));\\n\\nexport function getOp(id) {\\n  const op = byId.get(id);\\n  if (!op) throw new Error(`unknown operation ${id}`);\\n  return op;\\n}\\n\\nexport function storyOrder() {\\n  return OPS.map((op) => op.id);\\n}\\n\",\"total_lines\":24}}","is_error":false},{"type":"tool_result","tool_use_id":"call-c4f6e396-baef-42fd-bdcb-223fa63ca792-18","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→{\\n  \\\"name\\\": \\\"alive-in-common-time\\\",\\n  \\\"private\\\": true,\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"node tools/build.mjs\\\",\\n    \\\"test\\\": \\\"node tests/run-all.mjs\\\",\\n    \\\"test:sim\\\": \\\"node tests/run-all.mjs sim\\\",\\n    \\\"test:browser\\\": \\\"node tests/run-all.mjs browser\\\",\\n10→    \\\"test:hub\\\": \\\"node tests/run-all.mjs hub\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@dimforge/rapier3d-compat\\\": \\\"^0.19.3\\\",\\n    \\\"@fontsource/bangers\\\": \\\"^5.3.0\\\",\\n    \\\"@fontsource/barlow-condensed\\\": \\\"^5.3.0\\\",\\n    \\\"esbuild\\\": \\\"^0.28.2\\\",\\n    \\\"playwright\\\": \\\"^1.63.0\\\",\\n    \\\"three\\\": \\\"^0.180.0\\\"\\n  }\\n20→}\\n\",\"content_concise\":\"1→{\\n  \\\"name\\\": \\\"alive-in-common-time\\\",\\n  \\\"private\\\": true,\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"node tools/build.mjs\\\",\\n    \\\"test\\\": \\\"node tests/run-all.mjs\\\",\\n    \\\"test:sim\\\": \\\"node tests/run-all.mjs sim\\\",\\n    \\\"test:browser\\\": \\\"node tests/run-all.mjs browser\\\",\\n10→    \\\"test:hub\\\": \\\"node tests/run-all.mjs hub\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@dimforge/rapier3d-compat\\\": \\\"^0.19.3\\\",\\n    \\\"@fontsource/bangers\\\": \\\"^5.3.0\\\",\\n    \\\"@fontsource/barlow-condensed\\\": \\\"^5.3.0\\\",\\n    \\\"esbuild\\\": \\\"^0.28.2\\\",\\n    \\\"playwright\\\": \\\"^1.63.0\\\",\\n    \\\"three\\\": \\\"^0.180.0\\\"\\n  }\\n20→}\\n\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/package.json\",\"offset\":null,\"raw_output\":\"{\\n  \\\"name\\\": \\\"alive-in-common-time\\\",\\n  \\\"private\\\": true,\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"node tools/build.mjs\\\",\\n    \\\"test\\\": \\\"node tests/run-all.mjs\\\",\\n    \\\"test:sim\\\": \\\"node tests/run-all.mjs sim\\\",\\n    \\\"test:browser\\\": \\\"node tests/run-all.mjs browser\\\",\\n    \\\"test:hub\\\": \\\"node tests/run-all.mjs hub\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@dimforge/rapier3d-compat\\\": \\\"^0.19.3\\\",\\n    \\\"@fontsource/bangers\\\": \\\"^5.3.0\\\",\\n    \\\"@fontsource/barlow-condensed\\\": \\\"^5.3.0\\\",\\n    \\\"esbuild\\\": \\\"^0.28.2\\\",\\n    \\\"playwright\\\": \\\"^1.63.0\\\",\\n    \\\"three\\\": \\\"^0.180.0\\\"\\n  }\\n}\\n\",\"total_lines\":20}}","is_error":false},{"type":"tool_result","tool_use_id":"call-c4f6e396-baef-42fd-bdcb-223fa63ca792-19","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→---\\nname: threejs-frame-conventions\\ndescription: >\\n  Rules and a self-test for writing Three.js (and other y-up, right-handed)\\n  game code whose controls, camera, character facing and rendered-vs-collision\\n  geometry agree — derive every spatial frame from one source, pin every sign\\n  choice with a concrete check, verify against evidence the code did not\\n  produce. Use whenever writing or editing movement, camera, input mapping,\\n  character orientation, asset mounting, or level/collision geometry code in\\n10→  a 3D game.\\nmetadata:\\n  short-description: \\\"One frame for Three.js controls, camera, and facing\\\"\\n---\\n\\n# Three.js frame conventions: derive once, verify by running\\n\\nAlmost every \\\"the right arrow moves the character left\\\", \\\"W walks toward the camera\\\",\\n\\\"the character faces sideways while walking\\\" or \\\"the character walks backward, feet pointing away from\\ntravel\\\" bug is the same defect: two pieces of code compute the same spatial frame independently and\\n20→disagree on a sign. Each piece looks right on its own. The fix is structural, not careful recall.\\n\\nEvery such decision — operand order of a cross product, the sign of a rotation, triangle winding, which\\nside of a left/right pair sits at +x — is a two-way choice, and recall picks the wrong branch often\\nenough that no unchecked instance is trustworthy. Pin each one the same way: substitute a canonical\\nbasis (`forward = (0,0,-1)`, `up = (0,1,0)`), write the concrete result you expect next to the code, and\\ncheck it against evidence the code under test did not produce (Rule 4).\\n\\n## Rule 1 — one source of truth for every frame\\n\\n30→- A camera-relative movement frame is **read from the camera object, every frame**. Never rebuild it\\n  with `sin`/`cos` of a yaw variable in a second place.\\n  ```js\\n  const fwd = new THREE.Vector3(); camera.getWorldDirection(fwd); fwd.y = 0; fwd.normalize();\\n  const right = new THREE.Vector3().crossVectors(fwd, UP);   // forward × up = right  (y-up, right-handed)\\n  move.addScaledVector(fwd, input.forward).addScaledVector(right, input.strafe);\\n  ```\\n  `crossVectors(UP, fwd)` is **left**. If you write the cross product by hand, write it as\\n  `right = (-fwd.z, 0, fwd.x)` and nothing else (check: camera behind the player, fwd = (0,0,-1) → right = (1,0,0)).\\n- If the camera is *placed* from a yaw, place it from the **same** forward vector you move with:\\n40→  `camera.position.copy(target).addScaledVector(fwd, -dist).addScaledVector(UP, height); camera.lookAt(target)`.\\n  Then \\\"forward\\\" for movement and \\\"the direction the camera looks\\\" cannot diverge.\\n- Character heading, camera yaw and movement direction must not each own a formula. Pick one\\n  (`player.rotation.y`), derive the others from it (`new Vector3(0,0,-1).applyQuaternion(player.quaternion)`).\\n- Prefer fewer frames. A fixed-angle follow camera behind the player plus world-axis WASD has one\\n  convention and zero reconciliation; an orbit camera plus camera-relative WASD has two frames and\\n  must use Rule 1 above.\\n- Name every vector with its frame (`fwdWorld`, `dirCam`, `hitLocal`) and never hand a module-level\\n  scratch vector (`_v`, `_tmp`) to another function as an argument: if the callee `.set()`s it, the\\n  caller's direction silently becomes whatever the callee last computed.\\n50→- A ray has one origin frame. A third-person shot or probe that starts at the *camera* hits whatever is\\n  between the camera and the character, and a second probe started at the character's eye along the\\n  camera direction lands beside the crosshair. Use one pattern everywhere: camera ray → aim point,\\n  then character ray from the muzzle/eye to that point.\\n- The same convention must hold across the pipeline boundary. A level compiler (Python, JSON) that\\n  emits an angle and the runtime that consumes it are two computations of one frame; give them one\\n  documented convention (Rule 2, top-down row) and one conversion helper per side, round-trip tested.\\n\\n## Rule 2 — Three.js conventions that are easy to get wrong\\n\\n60→| fact | consequence |\\n|---|---|\\n| Local **forward is −z** for Object3D; `rotation.y > 0` turns **counter-clockwise seen from above** (+z toward +x) | to face direction `d` with a −z front: `rotation.y = Math.atan2(-d.x, -d.z)`; with a +z front: `Math.atan2(d.x, d.z)` |\\n| `Object3D.lookAt(p)` points the object's **+z** at `p` (only cameras and lights point −z) | on a −z-fronted character `lookAt` faces it **away**; use `atan2` above, or `lookAt` then `rotateY(Math.PI)` |\\n| `camera.up` is a hint, not the view's up; the true screen basis is the camera's world matrix columns | screen-right = `setFromMatrixColumn(camera.matrixWorld, 0)`, screen-up = column 1, view dir = `getWorldDirection` |\\n| World axes ≠ screen axes unless the camera sits on +z looking at −z | \\\"right on screen\\\" is world +x only for that camera; in front of the scene it is −x, from the +x side it is −z |\\n| Top-down cameras with `lookAt` straight down need an explicit `camera.up` (e.g. `(0,0,-1)`) | otherwise the screen orientation is undefined and `Right` may map to any axis |\\n| The ground plane (x, z) seen from above is the **mirror** of textbook (x, y): `rotation.y = θ` sends local +x to `(cos θ, 0, −sin θ)`, so a 2D angle `φ = atan2(z, x)` or matrix `[[c,−s],[s,c]]` applied to (x, z) equals `rotation.y = −φ` | `mesh.rotation.y = data.rot` is wrong whenever `rot` came from `atan2(dz, dx)` or a 2D rotation in a level compiler — the mesh sits at `2·rot` from its collider; convert through one helper (`yawFromPlanarAngle = (φ) => -φ`) and round-trip it through an `Object3D` once |\\n| Cross products are cyclic: `forward × up = right`, so a front derived from a left/right pair is `up × right` | `right × up` is the **back**; a mount built from it turns the model 180° so it walks feet-first away from travel, and a self-test that reuses the same vector passes anyway (Rule 4) |\\n| glTF humanoid rigs (Mixamo and similar) face +z with the character's own **left** at +x — the `Right*` bones sit at −x | \\\"right bone minus left bone\\\" points −x; feed it to `up × right`, not to intuition about which side is +x |\\n70→| glTF assets are *supposed* to face +z; generated / converted assets often face **+x** or −z | never hard-code `model.rotation.y = Math.PI`; measure the front (Rule 3) and derive the mount rotation from it |\\n| Hand-built `BufferGeometry` front faces are wound **counter-clockwise seen from the visible side**; `FrontSide` culls the rest | a ground quad whose `computeVertexNormals()` normal has `y < 0` is invisible from above; assert the normal sign for every custom quad, or set `DoubleSide` deliberately |\\n| A closed `FrontSide` mesh (`ExtrudeGeometry`, box) is opaque from outside and **invisible from inside** | rooms need inward-facing walls or `DoubleSide`; otherwise interiors look out through their own walls while collision still stops the player |\\n\\n## Rule 3 — never assume an asset's orientation; measure it\\n\\n1. After loading, find the front from **two independent cues** and require them to agree: a named\\n   marker node (`nose`, `head`, `eye`), the foot→toe bone direction, the longest asymmetric\\n   bounding-box axis, `up × (right − left)` from a bone pair, the format's documented convention\\n   (Rule 2), or render the asset from +x/−x/+z/−z and look. Prefer cues that do not depend on pose:\\n80→   arms and hands are posed differently per asset and can be tens of degrees off; feet, head markers\\n   and the hips→head axis are stable. If the cues disagree, stop and render — do not pick one.\\n   Record the result once, with the cue it came from: `const ASSET_FRONT = new THREE.Vector3(0, 0, 1); // toe bones`.\\n2. Mount it so that front becomes the parent's −z: `model.quaternion.setFromUnitVectors(ASSET_FRONT, new THREE.Vector3(0, 0, -1))`.\\n   Now the parent's yaw logic (Rule 2) is the only heading code.\\n3. Verify by moving the character and checking, in code, that the asset's front axis in world space\\n   aligns with velocity — measured through a cue **other than** `ASSET_FRONT` (see the self-test).\\n   If you cannot measure, say so in a comment and test visually.\\n\\n## Rule 4 — verify by executing, not by reading\\n90→\\nReading code does not catch sign errors; running it does. **If you can run code in this environment**\\n(a browser tool, a test runner, a sandbox), run a control self-test in the actual game loop before\\ndeclaring movement / camera / facing done. **If you cannot** — e.g. you are answering in a single\\nresponse with no tools — do not announce that you will verify and stop: apply the Rule 6 checklist\\nmentally, then write the complete code in this same response. Never end a response without the code\\nthat was asked for. Self-test to run when execution is available:\\n\\n```js\\n// dev-only: window.__selfTestControls()\\n100→async function selfTestControls() {\\n  const UP = new THREE.Vector3(0, 1, 0), V = THREE.Vector3;\\n  const basis = () => { const f = new V(); camera.getWorldDirection(f); f.y = 0; f.normalize(); return { f, r: new V().crossVectors(f, UP) }; };\\n  const press = async (code, ms) => { window.dispatchEvent(new KeyboardEvent('keydown', { code, key: code.replace('Key', '').toLowerCase() })); await run(ms); window.dispatchEvent(new KeyboardEvent('keyup', { code })); };\\n  const facing = () => new V(0, 0, -1).applyQuaternion(player.quaternion);   // parent heading\\n  // Independent oracle for the mounted asset: a cue the mount was NOT built from (toe bones, nose marker).\\n  const modelFront = () => { const a = new V(), b = new V(); footBone.getWorldPosition(a); toeBone.getWorldPosition(b); return b.sub(a).setY(0).normalize(); };\\n  for (const [code, axis, sign] of [['KeyD', 'r', +1], ['KeyA', 'r', -1], ['KeyW', 'f', +1], ['KeyS', 'f', -1], ['ArrowRight', 'r', +1], ['ArrowUp', 'f', +1]]) {\\n    const b = basis(), p0 = player.position.clone();\\n    await press(code, 500);\\n110→    const d = player.position.clone().sub(p0); d.y = 0;\\n    if (d.length() < 0.05) continue;                                        // key not bound\\n    const along = d.clone().normalize().dot(b[axis]) * sign;\\n    console.assert(along > 0.9, `${code}: moved ${along < -0.5 ? 'the OPPOSITE way' : 'sideways'} (cos=${along.toFixed(2)})`);\\n    console.assert(facing().dot(d.clone().normalize()) > 0.9, `${code}: character faces ${facing().dot(d.normalize()).toFixed(2)} off its movement`);\\n    console.assert(modelFront().dot(facing()) > 0.9, `${code}: mounted asset faces ${modelFront().dot(facing()).toFixed(2)} off the parent heading`);\\n  }\\n}\\n```\\nWire `run(ms)` to step your update loop deterministically (fixed dt). If any assertion fails, fix\\n120→the *frame derivation* (Rule 1), not the symptom — flipping a sign where the error surfaced usually\\nmoves the bug somewhere else.\\n\\n**The oracle must be independent of the code under test.** Transforming `ASSET_FRONT` by the model's\\nworld quaternion and comparing it with the parent's −z is a tautology: it passes with the mount 180°\\nwrong, because both sides were derived from the same vector. Compare against a cue the mount was not\\nbuilt from. A check that cannot fail is documentation, not verification.\\n\\nExtend the same run with the checks that dot products cannot make:\\n- **Render one frame and look at it** (screenshot tool, headless browser). Culled faces, colliders\\n130→  without meshes, meshes rotated away from their colliders, and slabs sitting between the camera and the\\n  character are invisible to numeric probes and obvious in one image.\\n- **Anything on a path must move**: step a few seconds and assert displacement > 0. A path parameter\\n  that is a constant fixed at spawn shows up here and nowhere else.\\n- **Camera occlusion**: sweep pitch through its full range in the tightest interior and assert the\\n  character stays visible. Raycast from the camera's actual position, not the rig pivot, against every\\n  occluder class — floors, ceilings and roofs as well as walls.\\n\\n## Rule 5 — one geometry, two consumers: rendering and collision must agree\\n\\n140→Rendered meshes and collision volumes are two computations of the same frame, and every sign error\\nbetween them is silent: the player is stopped by nothing visible, or walks through what is drawn.\\n- Derive both from **one record through one conversion**. `mesh.rotation.y = solid.rot` beside a\\n  collision routine that interprets `rot` with hand-written `cos`/`sin` is two conventions (Rule 2,\\n  top-down row); route both through the same helper so a wrong sign is wrong — and visible — in both.\\n- **Every collider has a mesh, every touchable mesh has a collider.** Keep an explicit list for the\\n  exceptions (decorative, invisible trigger). Provide a debug overlay that draws every collider as a\\n  wireframe and turn it on once before finishing; invisible colliders accumulate silently without it.\\n- Generated levels get **invariant checks in the generator**, not in play-testing: placed primitives do\\n  not intersect each other, every passage admits the player's radius, the camera clears every ceiling\\n150→  at every pitch, and no obstacle class lacks a collider. One failing check here is cheaper than one\\n  bug report each.\\n\\n## Rule 6 — review checklist before finishing\\n\\nGrep your own code and justify every hit:\\n- `Math.sin(` / `Math.cos(` of a yaw, heading or camera angle → is this the *only* place that frame is built? If not, delete it and import the vector.\\n- `new THREE.Vector3(1, 0, 0)` / `(0, 0, 1)` / `(0, 0, -1)` used as \\\"right\\\"/\\\"forward\\\" → is the camera guaranteed to be behind the player looking −z? If not, derive it.\\n- `.lookAt(` on a non-camera → does that object have a +z front?\\n- `rotation.y = Math.PI` / `Math.PI / 2` on a loaded model → where was the front measured?\\n160→- `atan2(` → argument order matches the front axis (Rule 2)? If it reads an `(x, z)` pair from level data, is the result negated before it becomes `rotation.y`?\\n- `cross(` / `crossVectors(` → `(forward, up)` order for right; `(up, right)` order for a front derived from a left/right pair?\\n- `rotation.y = <field from data>` → does the collision code interpret the same field through the same helper (Rule 5)?\\n- `setIndex(` / hand-built triangle lists → is the normal's sign asserted, or is `DoubleSide` deliberate?\\n- Module-level `_v` / `_tmp` vectors passed as arguments → does any callee `.set()` them?\\n- The self-test's facing oracle → does it use a cue other than the one the mount was built from (Rule 4)?\\n\\nIf the game has more than one of these, run the self-test (Rule 4) and look at one rendered frame.\\nIt takes seconds and catches what review misses.\\n\",\"content_concise\":\"1→---\\nname: threejs-frame-conventions\\ndescription: >\\n  Rules and a self-test for writing Three.js (and other y-up, right-handed)\\n  game code whose controls, camera, character facing and rendered-vs-collision\\n  geometry agree — derive every spatial frame from one source, pin every sign\\n  choice with a concrete check, verify against evidence the code did not\\n  produce. Use whenever writing or editing movement, camera, input mapping,\\n  character orientation, asset mounting, or level/collision geometry code in\\n10→  a 3D game.\\nmetadata:\\n  short-description: \\\"One frame for Three.js controls, camera, and facing\\\"\\n---\\n\\n# Three.js frame conventions: derive once, verify by running\\n\\nAlmost every \\\"the right arrow moves the character left\\\", \\\"W walks toward the camera\\\",\\n\\\"the character faces sideways while walking\\\" or \\\"the character walks backward, feet pointing away from\\ntravel\\\" bug is the same defect: two pieces of code compute the same spatial frame independently and\\n20→disagree on a sign. Each piece looks right on its own. The fix is structural, not careful recall.\\n\\nEvery such decision — operand order of a cross product, the sign of a rotation, triangle winding, which\\nside of a left/right pair sits at +x — is a two-way choice, and recall picks the wrong branch often\\nenough that no unchecked instance is trustworthy. Pin each one the same way: substitute a canonical\\nbasis (`forward = (0,0,-1)`, `up = (0,1,0)`), write the concrete result you expect next to the code, and\\ncheck it against evidence the code under test did not produce (Rule 4).\\n\\n## Rule 1 — one source of truth for every frame\\n\\n30→- A camera-relative movement frame is **read from the camera object, every frame**. Never rebuild it\\n  with `sin`/`cos` of a yaw variable in a second place.\\n  ```js\\n  const fwd = new THREE.Vector3(); camera.getWorldDirection(fwd); fwd.y = 0; fwd.normalize();\\n  const right = new THREE.Vector3().crossVectors(fwd, UP);   // forward × up = right  (y-up, right-handed)\\n  move.addScaledVector(fwd, input.forward).addScaledVector(right, input.strafe);\\n  ```\\n  `crossVectors(UP, fwd)` is **left**. If you write the cross product by hand, write it as\\n  `right = (-fwd.z, 0, fwd.x)` and nothing else (check: camera behind the player, fwd = (0,0,-1) → right = (1,0,0)).\\n- If the camera is *placed* from a yaw, place it from the **same** forward vector you move with:\\n40→  `camera.position.copy(target).addScaledVector(fwd, -dist).addScaledVector(UP, height); camera.lookAt(target)`.\\n  Then \\\"forward\\\" for movement and \\\"the direction the camera looks\\\" cannot diverge.\\n- Character heading, camera yaw and movement direction must not each own a formula. Pick one\\n  (`player.rotation.y`), derive the others from it (`new Vector3(0,0,-1).applyQuaternion(player.quaternion)`).\\n- Prefer fewer frames. A fixed-angle follow camera behind the player plus world-axis WASD has one\\n  convention and zero reconciliation; an orbit camera plus camera-relative WASD has two frames and\\n  must use Rule 1 above.\\n- Name every vector with its frame (`fwdWorld`, `dirCam`, `hitLocal`) and never hand a module-level\\n  scratch vector (`_v`, `_tmp`) to another function as an argument: if the callee `.set()`s it, the\\n  caller's direction silently becomes whatever the callee last computed.\\n50→- A ray has one origin frame. A third-person shot or probe that starts at the *camera* hits whatever is\\n  between the camera and the character, and a second probe started at the character's eye along the\\n  camera direction lands beside the crosshair. Use one pattern everywhere: camera ray → aim point,\\n  then character ray from the muzzle/eye to that point.\\n- The same convention must hold across the pipeline boundary. A level compiler (Python, JSON) that\\n  emits an angle and the runtime that consumes it are two computations of one frame; give them one\\n  documented convention (Rule 2, top-down row) and one conversion helper per side, round-trip tested.\\n\\n## Rule 2 — Three.js conventions that are easy to get wrong\\n\\n60→| fact | consequence |\\n|---|---|\\n| Local **forward is −z** for Object3D; `rotation.y > 0` turns **counter-clockwise seen from above** (+z toward +x) | to face direction `d` with a −z front: `rotation.y = Math.atan2(-d.x, -d.z)`; with a +z front: `Math.atan2(d.x, d.z)` |\\n| `Object3D.lookAt(p)` points the object's **+z** at `p` (only cameras and lights point −z) | on a −z-fronted character `lookAt` faces it **away**; use `atan2` above, or `lookAt` then `rotateY(Math.PI)` |\\n| `camera.up` is a hint, not the view's up; the true screen basis is the camera's world matrix columns | screen-right = `setFromMatrixColumn(camera.matrixWorld, 0)`, screen-up = column 1, view dir = `getWorldDirection` |\\n| World axes ≠ screen axes unless the camera sits on +z looking at −z | \\\"right on screen\\\" is world +x only for that camera; in front of the scene it is −x, from the +x side it is −z |\\n| Top-down cameras with `lookAt` straight down need an explicit `camera.up` (e.g. `(0,0,-1)`) | otherwise the screen orientation is undefined and `Right` may map to any axis |\\n| The ground plane (x, z) seen from above is the **mirror** of textbook (x, y): `rotation.y = θ` sends local +x to `(cos θ, 0, −sin θ)`, so a 2D angle `φ = atan2(z, x)` or matrix `[[c,−s],[s,c]]` applied to (x, z) equals `rotation.y = −φ` | `mesh.rotation.y = data.rot` is wrong whenever `rot` came from `atan2(dz, dx)` or a 2D rotation in a level compiler — the mesh sits at `2·rot` from its collider; convert through one helper (`yawFromPlanarAngle = (φ) => -φ`) and round-trip it through an `Object3D` once |\\n| Cross products are cyclic: `forward × up = right`, so a front derived from a left/right pair is `up × right` | `right × up` is the **back**; a mount built from it turns the model 180° so it walks feet-first away from travel, and a self-test that reuses the same vector passes anyway (Rule 4) |\\n| glTF humanoid rigs (Mixamo and similar) face +z with the character's own **left** at +x — the `Right*` bones sit at −x | \\\"right bone minus left bone\\\" points −x; feed it to `up × right`, not to intuition about which side is +x |\\n70→| glTF assets are *supposed* to face +z; generated / converted assets often face **+x** or −z | never hard-code `model.rotation.y = Math.PI`; measure the front (Rule 3) and derive the mount rotation from it |\\n| Hand-built `BufferGeometry` front faces are wound **counter-clockwise seen from the visible side**; `FrontSide` culls the rest | a ground quad whose `computeVertexNormals()` normal has `y < 0` is invisible from above; assert the normal sign for every custom quad, or set `DoubleSide` deliberately |\\n| A closed `FrontSide` mesh (`ExtrudeGeometry`, box) is opaque from outside and **invisible from inside** | rooms need inward-facing walls or `DoubleSide`; otherwise interiors look out through their own walls while collision still stops the player |\\n\\n## Rule 3 — never assume an asset's orientation; measure it\\n\\n1. After loading, find the front from **two independent cues** and require them to agree: a named\\n   marker node (`nose`, `head`, `eye`), the foot→toe bone direction, the longest asymmetric\\n   bounding-box axis, `up × (right − left)` from a bone pair, the format's documented convention\\n   (Rule 2), or render the asset from +x/−x/+z/−z and look. Prefer cues that do not depend on pose:\\n80→   arms and hands are posed differently per asset and can be tens of degrees off; feet, head markers\\n   and the hips→head axis are stable. If the cues disagree, stop and render — do not pick one.\\n   Record the result once, with the cue it came from: `const ASSET_FRONT = new THREE.Vector3(0, 0, 1); // toe bones`.\\n2. Mount it so that front becomes the parent's −z: `model.quaternion.setFromUnitVectors(ASSET_FRONT, new THREE.Vector3(0, 0, -1))`.\\n   Now the parent's yaw logic (Rule 2) is the only heading code.\\n3. Verify by moving the character and checking, in code, that the asset's front axis in world space\\n   aligns with velocity — measured through a cue **other than** `ASSET_FRONT` (see the self-test).\\n   If you cannot measure, say so in a comment and test visually.\\n\\n## Rule 4 — verify by executing, not by reading\\n90→\\nReading code does not catch sign errors; running it does. **If you can run code in this environment**\\n(a browser tool, a test runner, a sandbox), run a control self-test in the actual game loop before\\ndeclaring movement / camera / facing done. **If you cannot** — e.g. you are answering in a single\\nresponse with no tools — do not announce that you will verify and stop: apply the Rule 6 checklist\\nmentally, then write the complete code in this same response. Never end a response without the code\\nthat was asked for. Self-test to run when execution is available:\\n\\n```js\\n// dev-only: window.__selfTestControls()\\n100→async function selfTestControls() {\\n  const UP = new THREE.Vector3(0, 1, 0), V = THREE.Vector3;\\n  const basis = () => { const f = new V(); camera.getWorldDirection(f); f.y = 0; f.normalize(); return { f, r: new V().crossVectors(f, UP) }; };\\n  const press = async (code, ms) => { window.dispatchEvent(new KeyboardEvent('keydown', { code, key: code.replace('Key', '').toLowerCase() })); await run(ms); window.dispatchEvent(new KeyboardEvent('keyup', { code })); };\\n  const facing = () => new V(0, 0, -1).applyQuaternion(player.quaternion);   // parent heading\\n  // Independent oracle for the mounted asset: a cue the mount was NOT built from (toe bones, nose marker).\\n  const modelFront = () => { const a = new V(), b = new V(); footBone.getWorldPosition(a); toeBone.getWorldPosition(b); return b.sub(a).setY(0).normalize(); };\\n  for (const [code, axis, sign] of [['KeyD', 'r', +1], ['KeyA', 'r', -1], ['KeyW', 'f', +1], ['KeyS', 'f', -1], ['ArrowRight', 'r', +1], ['ArrowUp', 'f', +1]]) {\\n    const b = basis(), p0 = player.position.clone();\\n    await press(code, 500);\\n110→    const d = player.position.clone().sub(p0); d.y = 0;\\n    if (d.length() < 0.05) continue;                                        // key not bound\\n    const along = d.clone().normalize().dot(b[axis]) * sign;\\n    console.assert(along > 0.9, `${code}: moved ${along < -0.5 ? 'the OPPOSITE way' : 'sideways'} (cos=${along.toFixed(2)})`);\\n    console.assert(facing().dot(d.clone().normalize()) > 0.9, `${code}: character faces ${facing().dot(d.normalize()).toFixed(2)} off its movement`);\\n    console.assert(modelFront().dot(facing()) > 0.9, `${code}: mounted asset faces ${modelFront().dot(facing()).toFixed(2)} off the parent heading`);\\n  }\\n}\\n```\\nWire `run(ms)` to step your update loop deterministically (fixed dt). If any assertion fails, fix\\n120→the *frame derivation* (Rule 1), not the symptom — flipping a sign where the error surfaced usually\\nmoves the bug somewhere else.\\n\\n**The oracle must be independent of the code under test.** Transforming `ASSET_FRONT` by the model's\\nworld quaternion and comparing it with the parent's −z is a tautology: it passes with the mount 180°\\nwrong, because both sides were derived from the same vector. Compare against a cue the mount was not\\nbuilt from. A check that cannot fail is documentation, not verification.\\n\\nExtend the same run with the checks that dot products cannot make:\\n- **Render one frame and look at it** (screenshot tool, headless browser). Culled faces, colliders\\n130→  without meshes, meshes rotated away from their colliders, and slabs sitting between the camera and the\\n  character are invisible to numeric probes and obvious in one image.\\n- **Anything on a path must move**: step a few seconds and assert displacement > 0. A path parameter\\n  that is a constant fixed at spawn shows up here and nowhere else.\\n- **Camera occlusion**: sweep pitch through its full range in the tightest interior and assert the\\n  character stays visible. Raycast from the camera's actual position, not the rig pivot, against every\\n  occluder class — floors, ceilings and roofs as well as walls.\\n\\n## Rule 5 — one geometry, two consumers: rendering and collision must agree\\n\\n140→Rendered meshes and collision volumes are two computations of the same frame, and every sign error\\nbetween them is silent: the player is stopped by nothing visible, or walks through what is drawn.\\n- Derive both from **one record through one conversion**. `mesh.rotation.y = solid.rot` beside a\\n  collision routine that interprets `rot` with hand-written `cos`/`sin` is two conventions (Rule 2,\\n  top-down row); route both through the same helper so a wrong sign is wrong — and visible — in both.\\n- **Every collider has a mesh, every touchable mesh has a collider.** Keep an explicit list for the\\n  exceptions (decorative, invisible trigger). Provide a debug overlay that draws every collider as a\\n  wireframe and turn it on once before finishing; invisible colliders accumulate silently without it.\\n- Generated levels get **invariant checks in the generator**, not in play-testing: placed primitives do\\n  not intersect each other, every passage admits the player's radius, the camera clears every ceiling\\n150→  at every pitch, and no obstacle class lacks a collider. One failing check here is cheaper than one\\n  bug report each.\\n\\n## Rule 6 — review checklist before finishing\\n\\nGrep your own code and justify every hit:\\n- `Math.sin(` / `Math.cos(` of a yaw, heading or camera angle → is this the *only* place that frame is built? If not, delete it and import the vector.\\n- `new THREE.Vector3(1, 0, 0)` / `(0, 0, 1)` / `(0, 0, -1)` used as \\\"right\\\"/\\\"forward\\\" → is the camera guaranteed to be behind the player looking −z? If not, derive it.\\n- `.lookAt(` on a non-camera → does that object have a +z front?\\n- `rotation.y = Math.PI` / `Math.PI / 2` on a loaded model → where was the front measured?\\n160→- `atan2(` → argument order matches the front axis (Rule 2)? If it reads an `(x, z)` pair from level data, is the result negated before it becomes `rotation.y`?\\n- `cross(` / `crossVectors(` → `(forward, up)` order for right; `(up, right)` order for a front derived from a left/right pair?\\n- `rotation.y = <field from data>` → does the collision code interpret the same field through the same helper (Rule 5)?\\n- `setIndex(` / hand-built triangle lists → is the normal's sign asserted, or is `DoubleSide` deliberate?\\n- Module-level `_v` / `_tmp` vectors passed as arguments → does any callee `.set()` them?\\n- The self-test's facing oracle → does it use a cue other than the one the mount was built from (Rule 4)?\\n\\nIf the game has more than one of these, run the self-test (Rule 4) and look at one rendered frame.\\nIt takes seconds and catches what review misses.\\n\",\"absolute_path\":\"/home/micha/.grok/bundled/skills/threejs-frame-conventions/SKILL.md\",\"offset\":null,\"raw_output\":\"---\\nname: threejs-frame-conventions\\ndescription: >\\n  Rules and a self-test for writing Three.js (and other y-up, right-handed)\\n  game code whose controls, camera, character facing and rendered-vs-collision\\n  geometry agree — derive every spatial frame from one source, pin every sign\\n  choice with a concrete check, verify against evidence the code did not\\n  produce. Use whenever writing or editing movement, camera, input mapping,\\n  character orientation, asset mounting, or level/collision geometry code in\\n  a 3D game.\\nmetadata:\\n  short-description: \\\"One frame for Three.js controls, camera, and facing\\\"\\n---\\n\\n# Three.js frame conventions: derive once, verify by running\\n\\nAlmost every \\\"the right arrow moves the character left\\\", \\\"W walks toward the camera\\\",\\n\\\"the character faces sideways while walking\\\" or \\\"the character walks backward, feet pointing away from\\ntravel\\\" bug is the same defect: two pieces of code compute the same spatial frame independently and\\ndisagree on a sign. Each piece looks right on its own. The fix is structural, not careful recall.\\n\\nEvery such decision — operand order of a cross product, the sign of a rotation, triangle winding, which\\nside of a left/right pair sits at +x — is a two-way choice, and recall picks the wrong branch often\\nenough that no unchecked instance is trustworthy. Pin each one the same way: substitute a canonical\\nbasis (`forward = (0,0,-1)`, `up = (0,1,0)`), write the concrete result you expect next to the code, and\\ncheck it against evidence the code under test did not produce (Rule 4).\\n\\n## Rule 1 — one source of truth for every frame\\n\\n- A camera-relative movement frame is **read from the camera object, every frame**. Never rebuild it\\n  with `sin`/`cos` of a yaw variable in a second place.\\n  ```js\\n  const fwd = new THREE.Vector3(); camera.getWorldDirection(fwd); fwd.y = 0; fwd.normalize();\\n  const right = new THREE.Vector3().crossVectors(fwd, UP);   // forward × up = right  (y-up, right-handed)\\n  move.addScaledVector(fwd, input.forward).addScaledVector(right, input.strafe);\\n  ```\\n  `crossVectors(UP, fwd)` is **left**. If you write the cross product by hand, write it as\\n  `right = (-fwd.z, 0, fwd.x)` and nothing else (check: camera behind the player, fwd = (0,0,-1) → right = (1,0,0)).\\n- If the camera is *placed* from a yaw, place it from the **same** forward vector you move with:\\n  `camera.position.copy(target).addScaledVector(fwd, -dist).addScaledVector(UP, height); camera.lookAt(target)`.\\n  Then \\\"forward\\\" for movement and \\\"the direction the camera looks\\\" cannot diverge.\\n- Character heading, camera yaw and movement direction must not each own a formula. Pick one\\n  (`player.rotation.y`), derive the others from it (`new Vector3(0,0,-1).applyQuaternion(player.quaternion)`).\\n- Prefer fewer frames. A fixed-angle follow camera behind the player plus world-axis WASD has one\\n  convention and zero reconciliation; an orbit camera plus camera-relative WASD has two frames and\\n  must use Rule 1 above.\\n- Name every vector with its frame (`fwdWorld`, `dirCam`, `hitLocal`) and never hand a module-level\\n  scratch vector (`_v`, `_tmp`) to another function as an argument: if the callee `.set()`s it, the\\n  caller's direction silently becomes whatever the callee last computed.\\n- A ray has one origin frame. A third-person shot or probe that starts at the *camera* hits whatever is\\n  between the camera and the character, and a second probe started at the character's eye along the\\n  camera direction lands beside the crosshair. Use one pattern everywhere: camera ray → aim point,\\n  then character ray from the muzzle/eye to that point.\\n- The same convention must hold across the pipeline boundary. A level compiler (Python, JSON) that\\n  emits an angle and the runtime that consumes it are two computations of one frame; give them one\\n  documented convention (Rule 2, top-down row) and one conversion helper per side, round-trip tested.\\n\\n## Rule 2 — Three.js conventions that are easy to get wrong\\n\\n| fact | consequence |\\n|---|---|\\n| Local **forward is −z** for Object3D; `rotation.y > 0` turns **counter-clockwise seen from above** (+z toward +x) | to face direction `d` with a −z front: `rotation.y = Math.atan2(-d.x, -d.z)`; with a +z front: `Math.atan2(d.x, d.z)` |\\n| `Object3D.lookAt(p)` points the object's **+z** at `p` (only cameras and lights point −z) | on a −z-fronted character `lookAt` faces it **away**; use `atan2` above, or `lookAt` then `rotateY(Math.PI)` |\\n| `camera.up` is a hint, not the view's up; the true screen basis is the camera's world matrix columns | screen-right = `setFromMatrixColumn(camera.matrixWorld, 0)`, screen-up = column 1, view dir = `getWorldDirection` |\\n| World axes ≠ screen axes unless the camera sits on +z looking at −z | \\\"right on screen\\\" is world +x only for that camera; in front of the scene it is −x, from the +x side it is −z |\\n| Top-down cameras with `lookAt` straight down need an explicit `camera.up` (e.g. `(0,0,-1)`) | otherwise the screen orientation is undefined and `Right` may map to any axis |\\n| The ground plane (x, z) seen from above is the **mirror** of textbook (x, y): `rotation.y = θ` sends local +x to `(cos θ, 0, −sin θ)`, so a 2D angle `φ = atan2(z, x)` or matrix `[[c,−s],[s,c]]` applied to (x, z) equals `rotation.y = −φ` | `mesh.rotation.y = data.rot` is wrong whenever `rot` came from `atan2(dz, dx)` or a 2D rotation in a level compiler — the mesh sits at `2·rot` from its collider; convert through one helper (`yawFromPlanarAngle = (φ) => -φ`) and round-trip it through an `Object3D` once |\\n| Cross products are cyclic: `forward × up = right`, so a front derived from a left/right pair is `up × right` | `right × up` is the **back**; a mount built from it turns the model 180° so it walks feet-first away from travel, and a self-test that reuses the same vector passes anyway (Rule 4) |\\n| glTF humanoid rigs (Mixamo and similar) face +z with the character's own **left** at +x — the `Right*` bones sit at −x | \\\"right bone minus left bone\\\" points −x; feed it to `up × right`, not to intuition about which side is +x |\\n| glTF assets are *supposed* to face +z; generated / converted assets often face **+x** or −z | never hard-code `model.rotation.y = Math.PI`; measure the front (Rule 3) and derive the mount rotation from it |\\n| Hand-built `BufferGeometry` front faces are wound **counter-clockwise seen from the visible side**; `FrontSide` culls the rest | a ground quad whose `computeVertexNormals()` normal has `y < 0` is invisible from above; assert the normal sign for every custom quad, or set `DoubleSide` deliberately |\\n| A closed `FrontSide` mesh (`ExtrudeGeometry`, box) is opaque from outside and **invisible from inside** | rooms need inward-facing walls or `DoubleSide`; otherwise interiors look out through their own walls while collision still stops the player |\\n\\n## Rule 3 — never assume an asset's orientation; measure it\\n\\n1. After loading, find the front from **two independent cues** and require them to agree: a named\\n   marker node (`nose`, `head`, `eye`), the foot→toe bone direction, the longest asymmetric\\n   bounding-box axis, `up × (right − left)` from a bone pair, the format's documented convention\\n   (Rule 2), or render the asset from +x/−x/+z/−z and look. Prefer cues that do not depend on pose:\\n   arms and hands are posed differently per asset and can be tens of degrees off; feet, head markers\\n   and the hips→head axis are stable. If the cues disagree, stop and render — do not pick one.\\n   Record the result once, with the cue it came from: `const ASSET_FRONT = new THREE.Vector3(0, 0, 1); // toe bones`.\\n2. Mount it so that front becomes the parent's −z: `model.quaternion.setFromUnitVectors(ASSET_FRONT, new THREE.Vector3(0, 0, -1))`.\\n   Now the parent's yaw logic (Rule 2) is the only heading code.\\n3. Verify by moving the character and checking, in code, that the asset's front axis in world space\\n   aligns with velocity — measured through a cue **other than** `ASSET_FRONT` (see the self-test).\\n   If you cannot measure, say so in a comment and test visually.\\n\\n## Rule 4 — verify by executing, not by reading\\n\\nReading code does not catch sign errors; running it does. **If you can run code in this environment**\\n(a browser tool, a test runner, a sandbox), run a control self-test in the actual game loop before\\ndeclaring movement / camera / facing done. **If you cannot** — e.g. you are answering in a single\\nresponse with no tools — do not announce that you will verify and stop: apply the Rule 6 checklist\\nmentally, then write the complete code in this same response. Never end a response without the code\\nthat was asked for. Self-test to run when execution is available:\\n\\n```js\\n// dev-only: window.__selfTestControls()\\nasync function selfTestControls() {\\n  const UP = new THREE.Vector3(0, 1, 0), V = THREE.Vector3;\\n  const basis = () => { const f = new V(); camera.getWorldDirection(f); f.y = 0; f.normalize(); return { f, r: new V().crossVectors(f, UP) }; };\\n  const press = async (code, ms) => { window.dispatchEvent(new KeyboardEvent('keydown', { code, key: code.replace('Key', '').toLowerCase() })); await run(ms); window.dispatchEvent(new KeyboardEvent('keyup', { code })); };\\n  const facing = () => new V(0, 0, -1).applyQuaternion(player.quaternion);   // parent heading\\n  // Independent oracle for the mounted asset: a cue the mount was NOT built from (toe bones, nose marker).\\n  const modelFront = () => { const a = new V(), b = new V(); footBone.getWorldPosition(a); toeBone.getWorldPosition(b); return b.sub(a).setY(0).normalize(); };\\n  for (const [code, axis, sign] of [['KeyD', 'r', +1], ['KeyA', 'r', -1], ['KeyW', 'f', +1], ['KeyS', 'f', -1], ['ArrowRight', 'r', +1], ['ArrowUp', 'f', +1]]) {\\n    const b = basis(), p0 = player.position.clone();\\n    await press(code, 500);\\n    const d = player.position.clone().sub(p0); d.y = 0;\\n    if (d.length() < 0.05) continue;                                        // key not bound\\n    const along = d.clone().normalize().dot(b[axis]) * sign;\\n    console.assert(along > 0.9, `${code}: moved ${along < -0.5 ? 'the OPPOSITE way' : 'sideways'} (cos=${along.toFixed(2)})`);\\n    console.assert(facing().dot(d.clone().normalize()) > 0.9, `${code}: character faces ${facing().dot(d.normalize()).toFixed(2)} off its movement`);\\n    console.assert(modelFront().dot(facing()) > 0.9, `${code}: mounted asset faces ${modelFront().dot(facing()).toFixed(2)} off the parent heading`);\\n  }\\n}\\n```\\nWire `run(ms)` to step your update loop deterministically (fixed dt). If any assertion fails, fix\\nthe *frame derivation* (Rule 1), not the symptom — flipping a sign where the error surfaced usually\\nmoves the bug somewhere else.\\n\\n**The oracle must be independent of the code under test.** Transforming `ASSET_FRONT` by the model's\\nworld quaternion and comparing it with the parent's −z is a tautology: it passes with the mount 180°\\nwrong, because both sides were derived from the same vector. Compare against a cue the mount was not\\nbuilt from. A check that cannot fail is documentation, not verification.\\n\\nExtend the same run with the checks that dot products cannot make:\\n- **Render one frame and look at it** (screenshot tool, headless browser). Culled faces, colliders\\n  without meshes, meshes rotated away from their colliders, and slabs sitting between the camera and the\\n  character are invisible to numeric probes and obvious in one image.\\n- **Anything on a path must move**: step a few seconds and assert displacement > 0. A path parameter\\n  that is a constant fixed at spawn shows up here and nowhere else.\\n- **Camera occlusion**: sweep pitch through its full range in the tightest interior and assert the\\n  character stays visible. Raycast from the camera's actual position, not the rig pivot, against every\\n  occluder class — floors, ceilings and roofs as well as walls.\\n\\n## Rule 5 — one geometry, two consumers: rendering and collision must agree\\n\\nRendered meshes and collision volumes are two computations of the same frame, and every sign error\\nbetween them is silent: the player is stopped by nothing visible, or walks through what is drawn.\\n- Derive both from **one record through one conversion**. `mesh.rotation.y = solid.rot` beside a\\n  collision routine that interprets `rot` with hand-written `cos`/`sin` is two conventions (Rule 2,\\n  top-down row); route both through the same helper so a wrong sign is wrong — and visible — in both.\\n- **Every collider has a mesh, every touchable mesh has a collider.** Keep an explicit list for the\\n  exceptions (decorative, invisible trigger). Provide a debug overlay that draws every collider as a\\n  wireframe and turn it on once before finishing; invisible colliders accumulate silently without it.\\n- Generated levels get **invariant checks in the generator**, not in play-testing: placed primitives do\\n  not intersect each other, every passage admits the player's radius, the camera clears every ceiling\\n  at every pitch, and no obstacle class lacks a collider. One failing check here is cheaper than one\\n  bug report each.\\n\\n## Rule 6 — review checklist before finishing\\n\\nGrep your own code and justify every hit:\\n- `Math.sin(` / `Math.cos(` of a yaw, heading or camera angle → is this the *only* place that frame is built? If not, delete it and import the vector.\\n- `new THREE.Vector3(1, 0, 0)` / `(0, 0, 1)` / `(0, 0, -1)` used as \\\"right\\\"/\\\"forward\\\" → is the camera guaranteed to be behind the player looking −z? If not, derive it.\\n- `.lookAt(` on a non-camera → does that object have a +z front?\\n- `rotation.y = Math.PI` / `Math.PI / 2` on a loaded model → where was the front measured?\\n- `atan2(` → argument order matches the front axis (Rule 2)? If it reads an `(x, z)` pair from level data, is the result negated before it becomes `rotation.y`?\\n- `cross(` / `crossVectors(` → `(forward, up)` order for right; `(up, right)` order for a front derived from a left/right pair?\\n- `rotation.y = <field from data>` → does the collision code interpret the same field through the same helper (Rule 5)?\\n- `setIndex(` / hand-built triangle lists → is the normal's sign asserted, or is `DoubleSide` deliberate?\\n- Module-level `_v` / `_tmp` vectors passed as arguments → does any callee `.set()` them?\\n- The self-test's facing oracle → does it use a cue other than the one the mount was built from (Rule 4)?\\n\\nIf the game has more than one of these, run the self-test (Rule 4) and look at one rendered frame.\\nIt takes seconds and catches what review misses.\\n\",\"total_lines\":168}}","is_error":false}]},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"6f8990bf-2b5d-49d4-b5bd-e40d2994f503"}
{"type":"assistant","message":{"id":"msg_446","type":"message","role":"assistant","model":"grok-4.7","content":[{"type":"thinking","thinking":"The amount of code to write is substantial.\n\nMapping the 2D field to Three.js requires resolving coordinate conventions. The camera will look down at a flat XY plane from above. I need to check §9.2 for prototype values.\n\nI will read sections 8.1, 9.2, and 9.6 for stick mapping and geometry values. The start pose is x=-1.05 y=0.62. Aim assist must pull within 0.12 of a guide. Full right stick input maps to x=1, y=0. Tests require webgpu or webgl2 backend, filled canvas, non-blank screenshot, tip movement, reached screens, music gain 0.10, and non-silent audio.\n\nI will generate 1920x1080 screenshots and visually inspect them. I need to check the story scene structure for line counts and must-have lines. I will also verify how sim.input handles stick versus absolute values and site changes. Then I will write the files in large chunks.\n\nThe app entry point in src/main.js connects to AIHub as a shared-world session with seats 1 and 4, then starts either a session or a standalone mode. The director.js module holds the game object exposed as window.__game. Screens render as DOM overlays behind the 3D canvas. Test hooks include step, warp, input, bot, skipTo, and hash.\n\nAttract mode runs for ten seconds on the title, menu, free play, and touch notice screens. The touch notice requires a fine-pointer device without a pad. Math.random is banned inside src/sim but allowed outside it; audio will use a seeded counter for deterministic tests. Session messages must be mapped to InputFrame objects.\n\nThe network `i` message carries tip x, y, tool, use, steady, site, and sequence. I need to verify whether sim.input should translate these into InputFrame objects or accept the raw message directly. The plan passes the entire object to sim.input, which spreads into seat.cmd, but extra fields like t and seq might be ignored by moveSeat. I also need to determine if those tip coordinates are absolute positions rather than stick values.","signature":""},{"type":"tool_use","id":"call-bdaf3972-4a99-4d3e-bbc8-86334431ac8d-20","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/tools.js","offset":1,"limit":140}},{"type":"tool_use","id":"call-bdaf3972-4a99-4d3e-bbc8-86334431ac8d-21","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/PLAN.md","offset":488,"limit":80}},{"type":"tool_use","id":"call-bdaf3972-4a99-4d3e-bbc8-86334431ac8d-22","name":"grep","input":{"pattern":"storyLineCount|must-have|S16","path":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/PLAN.md"}},{"type":"tool_use","id":"call-bdaf3972-4a99-4d3e-bbc8-86334431ac8d-23","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/data/story/scenes.js","offset":1,"limit":40}},{"type":"tool_use","id":"call-bdaf3972-4a99-4d3e-bbc8-86334431ac8d-24","name":"read_file","input":{"target_file":"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/config/tuning.js","offset":76,"limit":30}}],"stop_reason":"tool_use","stop_sequence":null,"usage":{"input_tokens":8544,"output_tokens":1423,"cache_read_input_tokens":70400,"cache_creation_input_tokens":0}},"parent_tool_use_id":null,"session_id":"01a1aa56-6231-7cf0-a666-df5fbb090710","uuid":"21ff541e-3143-4414-865c-3bff7c14f639"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-bdaf3972-4a99-4d3e-bbc8-86334431ac8d-20","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"1→import { award } from './scoring.js';\\nimport { DT, IV, angDiff, dist, distPointSeg, overTray, polyLen, projectPoly, segHit } from './field.js';\\n\\nconst CELL = 0.04;\\n\\nfunction rising(seat, key) {\\n  return !!seat.cmd[key] && !seat.prev[key];\\n}\\n\\n10→function toolPower(sim) {\\n  let m = sim.mods.tool;\\n  if (sim.sforzandoT > 0) m *= sim.tuning.sforzandoToolMult;\\n  return m;\\n}\\n\\nfunction onBeat(sim, window) {\\n  const bpm = Math.max(20, sim.beat.bpm);\\n  const beatDur = 60 / bpm;\\n  const since = sim.beat.phase * beatDur;\\n20→  const until = (1 - sim.beat.phase) * beatDur;\\n  return Math.min(since, until) <= window;\\n}\\n\\nfunction gradeBand(mean, tol) {\\n  if (mean <= 0.35 * tol) return 'FLAWLESS';\\n  if (mean <= 0.7 * tol) return 'CLEAN';\\n  return 'ROUGH';\\n}\\n\\n30→export function moveSeat(sim, seat, dt) {\\n  const f = seat.cmd;\\n  const tun = sim.tuning;\\n  const prevX = seat.x;\\n  const prevY = seat.y;\\n  let x = seat.x;\\n  let y = seat.y;\\n  const steady = !!f.steady;\\n  const held = sim.entities.find((e) => e.alive && e.holder === seat.id && e.embedded);\\n  if (f.source === 'abs') {\\n40→    const tx = Number.isFinite(f.x) ? f.x : x;\\n    const ty = Number.isFinite(f.y) ? f.y : y;\\n    if (held) {\\n      const dx = tx - x;\\n      const dy = ty - y;\\n      const mag = Math.hypot(dx, dy);\\n      const max = 4 * dt;\\n      if (mag > max && mag > 0) {\\n        x += (dx / mag) * max;\\n        y += (dy / mag) * max;\\n50→      } else {\\n        x = tx;\\n        y = ty;\\n      }\\n    } else {\\n      x = tx;\\n      y = ty;\\n      const gate = nearestGate(sim, seat, x, y);\\n      if (gate && dist(x, y, gate.x, gate.y) < 0.12) {\\n        x += (gate.x - x) * 0.1 * dt * 12;\\n60→        y += (gate.y - y) * 0.1 * dt * 12;\\n      }\\n    }\\n  } else {\\n    const sx = f.x || 0;\\n    const sy = f.y || 0;\\n    const mag = Math.hypot(sx, sy);\\n    if (mag > 0.12) {\\n      const sm = Math.min(1, mag);\\n      const speed = tun.tipSpeed * sm ** tun.stickCurve * (steady ? tun.steadyFactor : 1);\\n70→      x += (sx / mag) * speed * dt;\\n      y += (sy / mag) * speed * dt;\\n    }\\n    if (tun.aimAssist > 0) {\\n      const g = nearestGuide(sim, x, y, seat);\\n      if (g && dist(x, y, g.x, g.y) < 0.12) {\\n        const pull = tun.aimAssist * dt * 12;\\n        x += (g.x - x) * pull;\\n        y += (g.y - y) * pull;\\n      }\\n80→    }\\n  }\\n  [seat.x, seat.y] = sim.clampTip(x, y);\\n  seat.vx = (seat.x - prevX) / dt;\\n  seat.vy = (seat.y - prevY) / dt;\\n  seat.speed = Math.hypot(seat.vx, seat.vy);\\n  seat.prevX = prevX;\\n  seat.prevY = prevY;\\n}\\n\\n90→function nearestGuide(sim, x, y, seat) {\\n  let best = null;\\n  let bestD = 0.12;\\n  for (const e of sim.entities) {\\n    if (!e.alive || e.site !== seat.site || e.covered) continue;\\n    let p = null;\\n    if (e.kind === 'incision' && !e.done) p = pointAt(e, e.along || 0);\\n    else if (e.kind === 'wound' && !e.done) p = e.gates[e.gate] || null;\\n    else if (e.kind === 'circleCut' && !e.done && e.points) p = pointAt(e, e.along || 0);\\n    if (!p) continue;\\n100→    const d = dist(x, y, p.x, p.y);\\n    if (d < bestD) {\\n      bestD = d;\\n      best = p;\\n    }\\n  }\\n  return best;\\n}\\n\\nfunction nearestGate(sim, seat, x, y) {\\n110→  let best = null;\\n  let bestD = 1e9;\\n  for (const e of sim.entities) {\\n    if (!e.alive || e.kind !== 'wound' || e.done || e.site !== seat.site) continue;\\n    const g = e.gates[e.gate];\\n    if (!g) continue;\\n    const d = dist(x, y, g.x, g.y);\\n    if (d < bestD) {\\n      bestD = d;\\n      best = g;\\n120→    }\\n  }\\n  return bestD < 0.2 ? best : null;\\n}\\n\\nfunction pointAt(e, along) {\\n  const pts = e.points;\\n  let left = along;\\n  for (let i = 1; i < pts.length; i++) {\\n    const dx = pts[i][0] - pts[i - 1][0];\\n130→    const dy = pts[i][1] - pts[i - 1][1];\\n    const len = Math.hypot(dx, dy) || 1e-9;\\n    if (left <= len) return { x: pts[i - 1][0] + dx * (left / len), y: pts[i - 1][1] + dy * (left / len) };\\n    left -= len;\\n  }\\n  const last = pts[pts.length - 1];\\n  return { x: last[0], y: last[1] };\\n}\\n\\nfunction blocked(e) {\\n140→  return e.hidden && !e.marked;\",\"content_concise\":\"1→import { award } from './scoring.js';\\nimport { DT, IV, angDiff, dist, distPointSeg, overTray, polyLen, projectPoly, segHit } from './field.js';\\n\\nconst CELL = 0.04;\\n\\nfunction rising(seat, key) {\\n  return !!seat.cmd[key] && !seat.prev[key];\\n}\\n\\n10→function toolPower(sim) {\\n  let m = sim.mods.tool;\\n  if (sim.sforzandoT > 0) m *= sim.tuning.sforzandoToolMult;\\n  return m;\\n}\\n\\nfunction onBeat(sim, window) {\\n  const bpm = Math.max(20, sim.beat.bpm);\\n  const beatDur = 60 / bpm;\\n  const since = sim.beat.phase * beatDur;\\n20→  const until = (1 - sim.beat.phase) * beatDur;\\n  return Math.min(since, until) <= window;\\n}\\n\\nfunction gradeBand(mean, tol) {\\n  if (mean <= 0.35 * tol) return 'FLAWLESS';\\n  if (mean <= 0.7 * tol) return 'CLEAN';\\n  return 'ROUGH';\\n}\\n\\n30→export function moveSeat(sim, seat, dt) {\\n  const f = seat.cmd;\\n  const tun = sim.tuning;\\n  const prevX = seat.x;\\n  const prevY = seat.y;\\n  let x = seat.x;\\n  let y = seat.y;\\n  const steady = !!f.steady;\\n  const held = sim.entities.find((e) => e.alive && e.holder === seat.id && e.embedded);\\n  if (f.source === 'abs') {\\n40→    const tx = Number.isFinite(f.x) ? f.x : x;\\n    const ty = Number.isFinite(f.y) ? f.y : y;\\n    if (held) {\\n      const dx = tx - x;\\n      const dy = ty - y;\\n      const mag = Math.hypot(dx, dy);\\n      const max = 4 * dt;\\n      if (mag > max && mag > 0) {\\n        x += (dx / mag) * max;\\n        y += (dy / mag) * max;\\n50→      } else {\\n        x = tx;\\n        y = ty;\\n      }\\n    } else {\\n      x = tx;\\n      y = ty;\\n      const gate = nearestGate(sim, seat, x, y);\\n      if (gate && dist(x, y, gate.x, gate.y) < 0.12) {\\n        x += (gate.x - x) * 0.1 * dt * 12;\\n60→        y += (gate.y - y) * 0.1 * dt * 12;\\n      }\\n    }\\n  } else {\\n    const sx = f.x || 0;\\n    const sy = f.y || 0;\\n    const mag = Math.hypot(sx, sy);\\n    if (mag > 0.12) {\\n      const sm = Math.min(1, mag);\\n      const speed = tun.tipSpeed * sm ** tun.stickCurve * (steady ? tun.steadyFactor : 1);\\n70→      x += (sx / mag) * speed * dt;\\n      y += (sy / mag) * speed * dt;\\n    }\\n    if (tun.aimAssist > 0) {\\n      const g = nearestGuide(sim, x, y, seat);\\n      if (g && dist(x, y, g.x, g.y) < 0.12) {\\n        const pull = tun.aimAssist * dt * 12;\\n        x += (g.x - x) * pull;\\n        y += (g.y - y) * pull;\\n      }\\n80→    }\\n  }\\n  [seat.x, seat.y] = sim.clampTip(x, y);\\n  seat.vx = (seat.x - prevX) / dt;\\n  seat.vy = (seat.y - prevY) / dt;\\n  seat.speed = Math.hypot(seat.vx, seat.vy);\\n  seat.prevX = prevX;\\n  seat.prevY = prevY;\\n}\\n\\n90→function nearestGuide(sim, x, y, seat) {\\n  let best = null;\\n  let bestD = 0.12;\\n  for (const e of sim.entities) {\\n    if (!e.alive || e.site !== seat.site || e.covered) continue;\\n    let p = null;\\n    if (e.kind === 'incision' && !e.done) p = pointAt(e, e.along || 0);\\n    else if (e.kind === 'wound' && !e.done) p = e.gates[e.gate] || null;\\n    else if (e.kind === 'circleCut' && !e.done && e.points) p = pointAt(e, e.along || 0);\\n    if (!p) continue;\\n100→    const d = dist(x, y, p.x, p.y);\\n    if (d < bestD) {\\n      bestD = d;\\n      best = p;\\n    }\\n  }\\n  return best;\\n}\\n\\nfunction nearestGate(sim, seat, x, y) {\\n110→  let best = null;\\n  let bestD = 1e9;\\n  for (const e of sim.entities) {\\n    if (!e.alive || e.kind !== 'wound' || e.done || e.site !== seat.site) continue;\\n    const g = e.gates[e.gate];\\n    if (!g) continue;\\n    const d = dist(x, y, g.x, g.y);\\n    if (d < bestD) {\\n      bestD = d;\\n      best = g;\\n120→    }\\n  }\\n  return bestD < 0.2 ? best : null;\\n}\\n\\nfunction pointAt(e, along) {\\n  const pts = e.points;\\n  let left = along;\\n  for (let i = 1; i < pts.length; i++) {\\n    const dx = pts[i][0] - pts[i - 1][0];\\n130→    const dy = pts[i][1] - pts[i - 1][1];\\n    const len = Math.hypot(dx, dy) || 1e-9;\\n    if (left <= len) return { x: pts[i - 1][0] + dx * (left / len), y: pts[i - 1][1] + dy * (left / len) };\\n    left -= len;\\n  }\\n  const last = pts[pts.length - 1];\\n  return { x: last[0], y: last[1] };\\n}\\n\\nfunction blocked(e) {\\n140→  return e.hidden && !e.marked;\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/Alive in Common Time-Trauma Center: Second Opinion-grok-4.7-xhigh-20261104-231230/src/sim/tools.js\",\"offset\":1,\"limit\":140,\"raw_output\":\"import { award } from './scoring.js';\\nimport { DT, IV, angDiff, dist, distPointSeg, overTray, polyLen, projectPoly, segHit } from './field.js';\\n\\nconst CELL = 0.04;\\n\\nfunction rising(seat, key) {\\n  return !!seat.cmd[key] && !seat.prev[key];\\n}\\n\\nfunction toolPower(sim) {\\n  let m = sim.mods.tool;\\n  if (sim.sforzandoT > 0) m *= sim.tuning.sforzandoToolMult;\\n  return m;\\n}\\n\\nfunction onBeat(sim, window) {\\n  const bpm = Math.max(20, sim.beat.bpm);\\n  const beatDur = 60 / bpm;\\n  const since = sim.beat.phase * beatDur;\\n  const until = (1 - sim.beat.phase) * beatDur;\\n  return Math.min(since, until) <= window;\\n}\\n\\nfunction gradeBand(mean, tol) {\\n  if (mean <= 0.35 * tol) return 'FLAWLESS';\\n  if (mean <= 0.7 * tol) return 'CLEAN';\\n  return 'ROUGH';\\n}\\n\\nexport function moveSeat(sim, seat, dt) {\\n  const f = seat.cmd;\\n  const tun = sim.tuning;\\n  const prevX = seat.x;\\n  const prevY = seat.y;\\n  let x = seat.x;\\n  let y = seat.y;\\n  const steady = !!f.steady;\\n  const held = sim.entities.find((e) => e.alive && e.holder === seat.id && e.embedded);\\n  if (f.source === 'abs') {\\n    const tx = Number.isFinite(f.x) ? f.x : x;\\n    const ty = Number.isFinite(f.y) ? f.y : y;\\n    if (held) {\\n      const dx = tx - x;\\n      const dy = ty - y;\\n      const mag = Math.hypot(dx, dy);\\n      const max = 4 * dt;\\n      if (mag > max && mag > 0) {\\n        x += (dx / mag) * max;\\n        y += (dy / mag) * max;\\n      } else {\\n        x = tx;\\n        y = ty;\\n      }\\n    } else {\\n      x = tx;\\n      y = ty;\\n      const gate = nearestGate(sim, seat, x, y);\\n      if (gate && dist(x, y, gate.x, gate.y) < 0.12) {\\n        x += (gate.x - x) * 0.1 * dt * 12;\\n        y += (gate.y - y) * 0.1 * dt * 12;\\n      }\\n    }\\n  } else {\\n    const sx = f.x || 0;\\n    const sy = f.y || 0;\\n    const mag = Math.hypot(sx, sy);\\n    if (mag > 0.12) {\\n      const sm = Math.min(1, mag);\\n      const speed = tun.tipSpeed * sm ** tun.stickCurve * (steady ? tun.steadyFactor : 1);\\n      x += (sx / mag) * speed * dt;\\n      y += (sy / mag) * speed * dt;\\n    }\\n    if (tun.aimAssist > 0) {\\n      const g = nearestGuide(sim, x, y, seat);\\n      if (g && dist(x, y, g.x, g.y) < 0.12) {\\n        const pull = tun.aimAssist * dt * 12;\\n        x += (g.x - x) * pull;\\n        y += (g.y - y) * pull;\\n      }\\n    }\\n  }\\n  [seat.x, seat.y] = sim.clampTip(x, y);\\n  seat.vx = (seat.x - prevX) / dt;\\n  seat.vy = (seat.y - prevY) / dt;\\n  seat.speed = Math.hypot(seat.vx, seat.vy);\\n  seat.prevX = prevX;\\n  seat.prevY = prevY;\\n}\\n\\nfunction nearestGuide(sim, x, y, seat) {\\n  let best = null;\\n  let bestD = 0.12;\\n  for (const e of sim.entities) {\\n    if (!e.alive || e.site !== seat.site || e.covered) continue;\\n    let p = null;\\n    if (e.kind === 'incision' && !e.done) p = pointAt(e, e.along || 0);\\n    else if (e.kind === 'wound' && !e.done) p = e.gates[e.gate] || null;\\n    else if (e.kind === 'circleCut' && !e.done && e.points) p = pointAt(e, e.along || 0);\\n    if (!p) continue;\\n    const d = dist(x, y, p.x, p.y);\\n    if (d < bestD) {\\n      bestD = d;\\n      best = p;\\n    }\\n  }\\n  return best;\\n}\\n\\nfunction nearestGate(sim, seat, x, y) {\\n  let best = null;\\n  let bestD = 1e9;\\n  for (const e of sim.entities) {\\n    if (!e.alive || e.kind !== 'wound' || e.done || e.site !== seat.site) continue;\\n    const g = e.gates[e.gate];\\n    if (!g) continue;\\n    const d = dist(x, y, g.x, g.y);\\n    if (d < bestD) {\\n      bestD = d;\\n      best = g;\\n    }\\n  }\\n  return bestD < 0.2 ? best : null;\\n}\\n\\nfunction pointAt(e, along) {\\n  const pts = e.points;\\n  let left = along;\\n  for (let i = 1; i < pts.length; i++) {\\n    const dx = pts[i][0] - pts[i - 1][0];\\n    const dy = pts[i][1] - pts[i - 1][1];\\n    const len = Math.hypot(dx, dy) || 1e-9;\\n    if (left <= len) return { x: pts[i - 1][0] + dx * (left / len), y: pts[i - 1][1] + dy * (left / len) };\\n    left -= len;\\n  }\\n  const last = pts[pts.length - 1];\\n  return { x: last[0], y: last[1] };\\n}\\n\\nfunction blocked(e) {\\n  return e.hidden && !e.marked;\\n\",\"total_lines\":826}}","is_error":false},{"type":"tool_result","tool_use_id":"call-bdaf3972-4a99-4d3e-bbc8-86334431ac8d-21","content":"{\"type\":\"ReadFile\",\"FileContent\":{\"content\":\"488→### 9.2 The operating view (values verified in the prototype)\\n\\n490→- Camera: `PerspectiveCamera(34, aspect, 0.1, 60)` at `(0, 3.55, 1.65)`, looking at `(0, 0.1, 0.06)`. For aspect under 16:9, scale the distance by `(16/9)/aspect`.\\n- Subtle life: parallax toward the tip, a 0.2% dolly on each beat, shake on slams, punch-in on Hush, 0.35 s whip between sites.\\n- **Drape:** an extruded teal shape at `y = 0.34` with an irregular elliptical window (radii about 1.5 × 0.95, wavy edge). It hides the field's rectangular edge and instantly reads as surgery.\\n- **Lamp:** visible in title and story. In the OR it's just warm light.\\n- **Lighting:** `HemisphereLight(0xffffff, 0x9aa6b0, 1.5)` and `DirectionalLight(0xfff2de, 1.9)` from upper right, shadow map 2048, `bias -0.0006`, `normalBias 0.03`. Tissue meshes: `receiveShadow` yes, `castShadow` no; otherwise you get wavy acne.\\n- Add a low-vitals lamp flicker, and red `danger` from the ink module.\\n\\n### 9.3 Sites\\n\\nEach site is a `heightAt(x, y)` sum of Gaussian lobes minus creases, plus two layers of fine sine relief (the relief is what breaks highlights into wet glints), a 1024² painted `CanvasTexture`, and an optional vertex motion. Use `PlaneGeometry(3.6, 2.5, 280, 200)` with `rotateX(-Math.PI / 2)`, `computeVertexNormals()` after displacement, and `positionNode = positionLocal.add(normalLocal.mul(uBeat.mul(0.03)))` for the squeeze.\\n500→\\n| Site | Height idea | Base colors | Motion and detail |\\n|---|---|---|---|\\n| Forearm | One long ridge | `#E8B48F` skin, gash mesh | Slight tremor |\\n| Abdomen skin | Gentle dome | Skin, iodine-orange swab paint | Breathing |\\n| Bowel | Many tube-like folds | `#E87A8B` | Slow peristalsis |\\n| Liver | Two broad lobes, one crease | `#8E2A3A` | Slight squeeze |\\n| Stomach | One big dome with rugae lines | `#E9967A` | Churn |\\n| Brain | Gyri: sine folds warped by noise | `#E8A9B8`, blue vessels | Nearly still, makes the cuts scary |\\n| Heart | Big muscular dome, coronary ridges | `#C4364F`, branching veins | Strong beat |\\n510→| Lung | Two inflating lobes | `#F0A3A8` | Breath every 4 beats moves targets 0.05 fu |\\n| Aorta | One thick tube across the field | `#B52A3E` | Pulse wave down its length |\\n\\n**Veins:** draw on the canvas with a recursive branching stroke, tapering width (5 lines of code; it looks great in the prototype).\\n**Wet glints** (verified): `emissiveNode` with hard `smoothstep` thresholds on `dot(normalView, H)` for two fixed view-space half-vectors (§16.6). Keep glints under about 8% of the area.\\n**Paint layer:** cuts, scorch marks, gel sheen, smears and stitches paint onto the same canvas, with `texture.needsUpdate = true` when changed (verified on both backends). For a 1024² canvas on that plane, field to canvas is `cx = (x + 1.8) / 3.6 × 1024`, `cy = (1.25 - y) / 2.5 × 1024`.\\n**Scanner:** a world-space circle in the site material's `colorNode`, replacing the surface with cyan-on-navy hatching inside `scannerRadius` (verified).\\n**Stave lines:** when a strain is present, five dark lines ink themselves across the organ, drawn on the paint layer, with little note-marks riding them.\\n\\n### 9.4 Instruments\\n520→\\nEach is a small hierarchy of named meshes with `use` animation clips, tilted toward the lower right so it never hides the target, with a springy swing as it moves and a contact shadow. No hands.\\n\\nScalpel, Forceps (two jaws), Suction wand (hose as a tube), Gel nozzle (foam blobs), Needle driver with curved needle and thread, Laser pen (additive beam, ember at the tip), Scanner puck (with a sweeping ring), Clamp (ratcheting jaws, stays on the bleeder), Syringe (plunger moves), Defib paddles (a pair, sliding in from each side).\\n\\nCo-op: each seat's tip has a ring in the seat color and a floating name (DOM, `textContent`).\\n\\n### 9.5 Story staging\\n\\n- 16:9 stage with a bottom dialogue box and name tag in the character's color.\\n530→- Camera: `PerspectiveCamera(30, aspect, 0.1, 60)` at about `(0, 0.2, 12.5)`, busts at about x = ±2.1. Slow dolly. Punch-in plus `speedLines` for shouts (§16.5; it looks exactly like manga).\\n- **Five sets** built from boxes and props, inked by the filter: OR 3 and gallery; corridor with rain on the windows; Ward Zero (green tile, pipes); Pip's lab; hospital roof in rain. Bell's office and the boardroom can reuse the corridor shell with new props.\\n- Text types out in sync with gibberish voice (§11). Transitions are an ink-wipe across the screen.\\n- **Cut-ins:** at big moments, a tilted panel with thick white border shows a close-up of a bust and a comic SFX word (\\\"KA-THUMP!\\\", \\\"FLATLINE!\\\"). Panels are 3D planes parented to the camera, textured from a `RenderTarget` of the bust (verified per-frame on both backends), so the ink pass lines them like everything else. **A render target shows upside down on a plain plane unless you flip the plane's UVs** (§16.6).\\n\\n### 9.6 Character busts (these numbers were rendered at 1080p)\\n\\nBuild each from one parametric function in `src/view/bust.js`. This reads as a cartoon anime face in the ink filter. It's a good base, not a finish, so spend time on hair and clothes. In the prototype, narrower shoulders looked like a bobblehead, and simple chin tapers gave either a ball or a point.\\n\\n- **Head:** `SphereGeometry(1, 64, 48)`, then reshape vertices. For `y < 0`, with `t = -y` and `jaw = t > 0.25 ? ((t - 0.25) / 0.75) ** 1.4 : 0`: `x *= 1 - 0.1 * t - 0.42 * jaw`, `z *= 1 - 0.12 * t`, `z += 0.05 * t * t`, `y *= 1 + 0.16 * t`. Then `z *= 0.94` everywhere. `computeVertexNormals()`.\\n540→- **Face:** a 1024×512 canvas as the head's `map`. On the default sphere UV, the face is centered at x = 256 (u = 0.25 faces +z). Eyes at y about 232, ±62 from center: white ellipse, gradient iris, pupil, two white highlights, a thick upper lash line. Brows above, a tick of a nose, cheek blush, then the mouth at y about 340. **Expressions redraw the canvas:** states for eyes (neutral, wide, narrow, closed, sad), brows (y and tilt), mouth (6 shapes for talk flaps), plus sweat and tears.\\n- **Hair:** a cap (`SphereGeometry(1.06…)` top, forehead edge clamped to a jagged line), a back mass, then 15 to 30 tapered cone locks. This is what makes silhouettes distinct. Use plenty of locks.\\n- **Body:** neck `CylinderGeometry(0.36, 0.44, 0.7, 20)` at `y = -1.18`. Torso `LatheGeometry` through the (radius, height) points (0.34, 0.9), (0.55, 0.82), (1.5, 0.52), (1.95, 0.05), (2.08, -0.8), (2.1, -2.2), placed at `y = -2.08` with z scale 0.62. V-neck, lapels, stethoscope, bow tie and cardigan as simple add-ons. Crop at the chest with the camera.\\n- **Portrait inset:** render the speaker's bust to a 256² `RenderTarget`, shown on a camera-parented plane with flipped UVs (§16.6).\\n\\nPatients use the same function with varied hair, skin, age lines and clothes.\\n\\n### 9.7 Effects, and the juice list\\n\\nUse `InstancedMesh` for particles (per-instance color verified). Particles and thread live in a small cosmetic Rapier world on the view side.\\n550→\\nThese are not optional; they are what makes it feel great:\\n\\n- Hit-stop of 60 to 90 ms on FLAWLESS.\\n- Forceps: tissue stretches, then a pop, the item arcs, lands and clinks onto the growing tray pile.\\n- Grade lettering stamps in at the tip with an ink splat.\\n- Hush: 0.4 s freeze, inhale sound, wash expanding from the tip via `hushRadius`; on exit, color floods back with a cymbal swell.\\n- Fermata: real silence. On Defib: white `flash`, and music slams back on the downbeat.\\n- Strain entrance: stave lines ink in, then the dictionary card.\\n- Scrub-in at op start: glove snap, lamp clunk, Bea's line. Rank stamp: a physical 3D stamp, thud, ink, camera kick.\\n560→- Danger: lamp flicker, line boil rising with `danger`, ECG beeps climbing in pitch.\\n- Suture thread (Rapier rope) whips and pulls tight. Clamp ratchet. Laser ember and smoke. Gel foam fizz. Blood droplets arc into the suction nozzle.\\n\\n---\\n\\n## 10. Animation\\n\\nUse the native system as the base: `AnimationMixer`, `AnimationClip`, keyframe tracks built in code, and `SkinnedMesh` with `Bone` where bodies bend (toon skinning with a mixer is verified on both backends). Don't hand-roll transform tweens where a clip will do; use code only for continuous motion that follows sim values.\",\"content_concise\":\"488→### 9.2 The operating view (values verified in the prototype)\\n\\n490→- Camera: `PerspectiveCamera(34, aspect, 0.1, 60)` at `(0, 3.55, 1.65)`, looking at `(0, 0.1, 0.06)`. For aspect under 16:9, scale the distance by `(16/9)/aspect`.\\n- Subtle life: parallax toward the tip, a 0.2% dolly on each beat, shake on slams, punch-in on Hush, 0.35 s whip between sites.\\n- **Drape:** an extruded teal shape at `y = 0.34` with an irregular elliptical window (radii about 1.5 × 0.95, wavy edge). It hides the field's rectangular edge and instantly reads as surgery.\\n- **Lamp:** visible in title and story. In the OR it's just warm light.\\n- **Lighting:** `HemisphereLight(0xffffff, 0x9aa6b0, 1.5)` and `DirectionalLight(0xfff2de, 1.9)` from upper right, shadow map 2048, `bias -0.0006`, `normalBias 0.03`. Tissue meshes: `receiveShadow` yes, `castShadow` no; otherwise you get wavy acne.\\n- Add a low-vitals lamp flicker, and red `danger` from the ink module.\\n\\n### 9.3 Sites\\n\\nEach site is a `heightAt(x, y)` sum of Gaussian lobes minus creases, plus two layers of fine sine relief (the relief is what breaks highlights into wet glints), a 1024² painted `CanvasTexture`, and an optional vertex motion. Use `PlaneGeometry(3.6, 2.5, 280, 200)` with `rotateX(-Math.PI / 2)`, `computeVertexNormals()` after displacement, and `positionNode = positionLocal.add(normalLocal.mul(uBeat.mul(0.03)))` for the squeeze.\\n500→\\n| Site | Height idea | Base colors | Motion and detail |\\n|---|---|---|---|\\n| Forearm | One long ridge | `#E8B48F` skin, gash mesh | Slight tremor |\\n| Abdomen skin | Gentle dome | Skin, iodine-orange swab paint | Breathing |\\n| Bowel | Many tube-like folds | `#E87A8B` | Slow peristalsis |\\n| Liver | Two broad lobes, one crease | `#8E2A3A` | Slight squeeze |\\n| Stomach | One big dome with rugae lines | `#E9967A` | Churn |\\n| Brain | Gyri: sine folds warped by noise | `#E8A9B8`, blue vessels | Nearly still, makes the cuts scary |\\n| Heart | Big muscular dome, coronary ridges | `#C4364F`, branching veins | Strong beat |\\n510→| Lung | Two inflating lobes | `#F0A3A8` | Breath every 4 beats moves targets 0.05 fu |\\n| Aorta | One thick tube across the field | `#B52A3E` | Pulse wave down its length |\\n\\n**Veins:** draw on the canvas with a recursive branching stroke, tapering width (5 lines of code; it looks great in the prototype).\\n**Wet glints** (verified): `emissiveNode` with hard `smoothstep` thresholds on `dot(normalView, H)` for two fixed view-space half-vectors (§16.6). Keep glints under about 8% of the area.\\n**Paint layer:** cuts, scorch marks, gel sheen, smears and stitches paint onto the same canvas, with `texture.needsUpdate = true` when changed (verified on both backends). For a 1024² canvas on that plane, field to canvas is `cx = (x + 1.8) / 3.6 × 1024`, `cy = (1.25 - y) / 2.5 × 1024`.\\n**Scanner:** a world-space circle in the site material's `colorNode`, replacing the surface with cyan-on-navy hatching inside `scannerRadius` (verified).\\n**Stave lines:** when a strain is present, five dark lines ink themselves across the organ, drawn on the paint layer, with little note-marks riding them.\\n\\n### 9.4 Instruments\\n520→\\nEach is a small hierarchy of named meshes with `use` animation clips, tilted toward the lower right so it never hides the target, with a springy swing as it moves and a contact shadow. No hands.\\n\\nScalpel, Forceps (two jaws), Suction wand (hose as a tube), Gel nozzle (foam blobs), Needle driver with curved needle and thread, Laser pen (additive beam, ember at the tip), Scanner puck (with a sweeping ring), Clamp (ratcheting jaws, stays on the bleeder), Syringe (plunger moves), Defib paddles (a pair, sliding in from each side).\\n\\nCo-op: each seat's tip has a ring in the seat color and a floating name (DOM, `textContent`).\\n\\n### 9.5 Story staging\\n\\n- 16:9 stage with a bottom dialogue box and name tag in the character's color.\\n530→- Camera: `PerspectiveCamera(30, aspect, 0.1, 60)` at about `(0, 0.2, 12.5)`, busts at about x = ±2.1. Slow dolly. Punch-in plus `speedLines` for shouts (§16.5; it looks exactly like manga).\\n- **Five sets** built from boxes and props, inked by the filter: OR 3 and gallery; corridor with rain on the windows; Ward Zero (green tile, pipes); Pip's lab; hospital roof in rain. Bell's office and the boardroom can reuse the corridor shell with new props.\\n- Text types out in sync with gibberish voice (§11). Transitions are an ink-wipe across the screen.\\n- **Cut-ins:** at big moments, a tilted panel with thick white border shows a close-up of a bust and a comic SFX word (\\\"KA-THUMP!\\\", \\\"FLATLINE!\\\"). Panels are 3D planes parented to the camera, textured from a `RenderTarget` of the bust (verified per-frame on both backends), so the ink pass lines them like everything else. **A render target shows upside down on a plain plane unless you flip the plane's UVs** (§16.6).\\n\\n### 9.6 Character busts (these numbers were rendered at 1080p)\\n\\nBuild each from one parametric function in `src/view/bust.js`. This reads as a cartoon anime face in the ink filter. It's a good base, not a finish, so spend time on hair and clothes. In the prototype, narrower shoulders looked like a bobblehead, and simple chin tapers gave either a ball or a point.\\n\\n- **Head:** `SphereGeometry(1, 64, 48)`, then reshape vertices. For `y < 0`, with `t = -y` and `jaw = t > 0.25 ? ((t - 0.25) / 0.75) ** 1.4 : 0`: `x *= 1 - 0.1 * t - 0.42 * jaw`, `z *= 1 - 0.12 * t`, `z += 0.05 * t * t`, `y *= 1 + 0.16 * t`. Then `z *= 0.94` everywhere. `computeVertexNormals()`.\\n540→- **Face:** a 1024×512 canvas as the head's `map`. On the default sphere UV, the face is centered at x = 256 (u = 0.25 faces +z). Eyes at y about 232, ±62 from center: white ellipse, gradient iris, pupil, two white highlights, a thick upper lash line. Brows above, a tick of a nose, cheek blush, then the mouth at y about 340. **Expressions redraw the canvas:** states for eyes (neutral, wide, narrow, closed, sad), brows (y and tilt), mouth (6 shapes for talk flaps), plus sweat and tears.\\n- **Hair:** a cap (`SphereGeometry(1.06…)` top, forehead edge clamped to a jagged line), a back mass, then 15 to 30 tapered cone locks. This is what makes silhouettes distinct. Use plenty of locks.\\n- **Body:** neck `CylinderGeometry(0.36, 0.44, 0.7, 20)` at `y = -1.18`. Torso `LatheGeometry` through the (radius, height) points (0.34, 0.9), (0.55, 0.82), (1.5, 0.52), (1.95, 0.05), (2.08, -0.8), (2.1, -2.2), placed at `y = -2.08` with z scale 0.62. V-neck, lapels, stethoscope, bow tie and cardigan as simple add-ons. Crop at the chest with the camera.\\n- **Portrait inset:** render the speaker's bust to a 256² `RenderTarget`, shown on a camera-parented plane with flipped UVs (§16.6).\\n\\nPatients use the same function with varied hair, skin, age lines and clothes.\\n\\n### 9.7 Effects, and the juice list\\n\\nUse `InstancedMesh` for particles (per-instance color verified). Particles and thread live in a small cosmetic Rapier world on the view side.\\n550→\\nThese are not optional; they are what makes it feel great:\\n\\n- Hit-stop of 60 to 90 ms on FLAWLESS.\\n- Forceps: tissue stretches, then a pop, the item arcs, lands and clinks onto the growing tray pile.\\n- Grade lettering stamps in at the tip with an ink splat.\\n- Hush: 0.4 s freeze, inhale sound, wash expanding from the tip via `hushRadius`; on exit, color floods back with a cymbal swell.\\n- Fermata: real silence. On Defib: white `flash`, and music slams back on the downbeat.\\n- Strain entrance: stave lines ink in, then the dictionary card.\\n- Scrub-in at op start: glove snap, lamp clunk, Bea's line. Rank stamp: a physical 3D stamp, thud, ink, camera kick.\\n560→- Danger: lamp flicker, line boil rising with `danger`, ECG beeps climbing in pitch.\\n- Suture thread (Rapier rope) whips and pulls tight. Clamp ratchet. Laser ember and smoke. Gel foam fizz. Blood droplets arc into the suction nozzle.\\n\\n---\\n\\n## 10. Animation\\n\\nUse the native system as the base: `AnimationMixer`, `AnimationClip`, keyframe tracks built in code, and `SkinnedMesh` with `Bone` where bodies bend (toon skinning with a mixer is verified on both backends). Don't hand-roll transform tweens where a clip will do; use code only for continuous motion that follows sim values.\",\"absolute_path\":\"/home/micha/dev/cc-matrix/runs/grok-xhigh.build-v2__20261104-231230__x8f49b6/work/PLAN.md\",\"offset\":488,\"limit\":80,\"raw_output\":\"### 9.2 The operating view (values verified in the prototype)\\n\\n- Camera: `PerspectiveCamera(34, aspect, 0.1, 60)` at `(0, 3.55, 1.65)`, looking at `(0, 0.1, 0.06)`. For aspect under 16:9, scale the distance by `(16/9)/aspect`.\\n- Subtle life: parallax toward the tip, a 0.2% dolly on each beat, shake on slams, punch-in on Hush, 0.35 s whip between sites.\\n- **Drape:** an extruded teal shape at `y = 0.34` with an irregular elliptical window (radii about 1.5 × 0.95, wavy edge). It hides the field's rectangular edge and instantly reads as surgery.\\n- **Lamp:** visible in title and story. In the OR it's just warm light.\\n- **Lighting:** `HemisphereLight(0xffffff, 0x9aa6b0, 1.5)` and `DirectionalLight(0xfff2de, 1.9)` from upper right, shadow map 2048, `bias -0.0006`, `normalBias 0.03`. Tissue meshes: `receiveShadow` yes, `castShadow` no; otherwise you get wavy acne.\\n- Add a low-vitals lamp flicker, and red `danger` from the ink module.\\n\\n### 9.3 Sites\\n\\nEach site is a `heightAt(x, y)` sum of Gaussian lobes minus creases, plus two layers of fine sine relief (the relief is what breaks highlights into wet glints), a 1024² painted `CanvasTexture`, and an optional vertex motion. Use `PlaneGeometry(3.6, 2.5, 280, 200)` with `rotateX(-Math.PI / 2)`, `computeVertexNormals()` after displacement, and `positionNode = positionLocal.add(normalLocal.mul(uBeat.mul(0.03)))` for the squeeze.\\n\\n| Site | Height idea | Base colors | Motion and detail |\\n|---|---|---|---|\\n| Forearm | One long ridge | `#E8B48F` skin, gash mesh | Slight tremor |\\n| Abdomen skin | Gentle dome | Skin, iodine-orange swab paint | Breathing |\\n| Bowel | Many tube-like folds | `#E87A8B` | Slow peristalsis |\\n| Liver | Two broad lobes, one crease | `#8E2A3A` | Slight squeeze |\\n| Stomach | One big dome with rugae lines | `#E9967A` | Churn |\\n| Brain | Gyri: sine folds warped by noise | `#E8A9B8`, blue vessels | Nearly still, makes the cuts scary |\\n| Heart | Big muscular dome, coronary ridges | `#C4364F`, branching veins | Strong beat |\\n| Lung | Two inflating lobes | `#F0A3A8` | Breath every 4 beats moves targets 0.05 fu |\\n| Aorta | One thick tube across the field | `#B52A3E` | Pulse wave down its length |\\n\\n**Veins:** draw on the canvas with a recursive branching stroke, tapering width (5 lines of code; it looks great in the prototype).\\n**Wet glints** (verified): `emissiveNode` with hard `smoothstep` thresholds on `dot(normalView, H)` for two fixed view-space half-vectors (§16.6). Keep glints under about 8% of the area.\\n**Paint layer:** cuts, scorch marks, gel sheen, smears and stitches paint onto the same canvas, with `texture.needsUpdate = true` when changed (verified on both backends). For a 1024² canvas on that plane, field to canvas is `cx = (x + 1.8) / 3.6 × 1024`, `cy = (1.25 - y) / 2.5 × 1024`.\\n**Scanner:** a world-space circle in the site material's `colorNode`, replacing the surface with cyan-on-navy hatching inside `scannerRadius` (verified).\\n**Stave lines:** when a strain is present, five dark lines ink themselves across the organ, drawn on the paint layer, with little note-marks riding them.\\n\\n### 9.4 Instruments\\n\\nEach is a small hierarchy of named meshes with `use` animation clips, tilted toward the lower right so it never hides the target, with a springy swing as it moves and a contact shadow. No hands.\\n\\nScalpel, Forceps (two jaws), Suction wand (hose as a tube), Gel nozzle (foam blobs), Needle driver with curved needle and thread, Laser pen (additive beam, ember at the tip), Scanner puck (with a sweeping ring), Clamp (ratcheting jaws, stays on the bleeder), Syringe (plunger moves), Defib paddles (a pair, sliding in from each side).\\n\\nCo-op: each seat's tip has a ring in the seat color and a floating name (DOM, `textContent`).\\n\\n### 9.5 Story staging\\n\\n- 16:9 stage with a bottom dialogue box and name tag in the character's color.\\n- Camera: `PerspectiveCamera(30, aspect, 0.1, 60)` at about `(0, 0.2, 12.5)`, busts at about x = ±2.1. Slow dolly. Punch-in plus `speedLines` for shouts (§16.5; it looks exactly like manga).\\n- **Five sets** built from boxes and props, inked by the filter: OR 3 and gallery; corridor with rain on the windows; Ward Zero (green tile, pipes); Pip's lab; hospital roof in rain. Bell's office and the boardroom can reuse the corridor shell with new props.\\n- Text types out in sync with gibberish voice (§11). Transitions are an ink-wipe across the screen.\\n- **Cut-ins:** at big moments, a tilted panel with thick white border shows a close-up of a bust and a comic SFX word (\\\"KA-THUMP!\\\", \\\"FLATLINE!\\\"). Panels are 3D planes parented to the camera, textured from a `RenderTarget` of the bust (verified per-frame on both backends), so the ink pass lines them like everything else. **A render target shows upside down on a plain plane unless you flip the plane's UVs** (§16.6).\\n\\n### 9.6 Character busts (these numbers were rendered at 1080p)\\n\\nBuild each from one parametric function in `src/view/bust.js`. This reads as a cartoon anime face in the ink filter. It's a good base, not a finish, so spend time on hair and clothes. In the prototype, narrower shoulders looked like a bobblehead, and simple chin tapers gave either a ball or a point.\\n\\n- **Head:** `SphereGeometry(1, 64, 48)`, then reshape vertices. For `y < 0`, with `t = -y` and `jaw = t > 0.25 ? ((t - 0.25) / 0.75) ** 1.4 : 0`: `x *= 1 - 0.1 * t - 0.42 * jaw`, `z *= 1 - 0.12 * t`, `z += 0.05 * t * t`, `y *= 1 + 0.16 * t`. Then `z *= 0.94` everywhere. `computeVertexNormals()`.\\n- **Face:** a 1024×512 canvas as the head's `map`. On the default sphere UV, the face is centered at x = 256 (u = 0.25 faces +z). Eyes at y about 232, ±62 from center: white ellipse, gradient iris, pupil, two white highlights, a thick upper lash line. Brows above, a tick of a nose, cheek blush, then the mouth at y about 340. **Expressions redraw the canvas:** states for eyes (neutral, wide, narrow, closed, sad), brows (y and tilt), mouth (6 shapes for talk flaps), plus sweat and tears.\\n- **Hair:** a cap (`SphereGeometry(1.06…)` top, forehead edge clamped to a jagged line), a back mass, then 15 to 30 tapered cone locks. This is what makes silhouettes distinct. Use plenty of locks.\\n- **Body:** neck `CylinderGeometry(0.36, 0.44, 0.7, 20)` at `y = -1.18`. Torso `LatheGeometry` through the (radius, height) points (0.34, 0.9), (0.55, 0.82), (1.5, 0.52), (1.95, 0.05), (2.08, -0.8), (2.1, -2.2), placed at `y = -2.08` with z scale 0.62. V-neck, lapels, stethoscope, bow tie and cardigan as simple add-ons. Crop at the chest with the camera.\\n- **Portrait inset:** render the speaker's bust to a 256² `RenderTarget`, shown on a camera-parented plane with flipped UVs (§16.6).\\n\\nPatients use the same function with varied hair, skin, age lines and clothes.\\n\\n### 9.7 Effects, and the juice list\\n\\nUse `InstancedMesh` for particles (per-instance color verified). Particles and thread live in a small cosmetic Rapier world on the view side.\\n\\nThese are not optional; they are what makes it feel great:\\n\\n- Hit-stop of 60 to 90 ms on FLAWLESS.\\n- Forceps: tissue stretches, then a pop, the item arcs, lands and clinks onto the growing tray pile.\\n- Grade lettering stamps in at the tip with an ink splat.\\n- Hush: 0.4 s freeze, inhale sound, wash expanding from the tip via `hushRadius`; on exit, color floods back with a cymbal swell.\\n- Fermata: real silence. On Defib: white `flash`, and music slams back on the downbeat.\\n- Strain entrance: stave lines ink in, then the dictionary card.\\n- Scrub-in at op start: glove snap, lamp clunk, Bea's line. Rank stamp: a physical 3D stamp, thud, ink, camera kick.\\n- Danger: lamp flicker, line boil rising with `danger`, ECG beeps climbing in pitch.\\n- Suture thread (Rapier rope) whips and pulls tight. Clamp ratchet. Laser ember and smoke. Gel foam fizz. Blood droplets arc into the suction nozzle.\\n\\n---\\n\\n## 10. Animation\\n\\nUse the native system as the base: `AnimationMixer`, `AnimationClip`, keyframe tracks built in code, and `SkinnedMesh` with `Bone` where bodies bend (toon skinning with a mixer is verified on both backends). Don't hand-roll transform tweens where a clip will do; use code only for continuous motion that follows sim values.\\n\",\"total_lines\":1218}}","is_error":false},{"type":"tool_result","tool_use_id":"call-bdaf3972-4a99-4d3e-bbc8-86334431ac8d-22","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,51,49,50,51,48,95,95,120,56,102,52,57,98,54,47,119,111,114,107,34,62,10,70,111,117,110,100,32,54,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,51,49,50,51,48,95,95,120,56,102,52,57,98,54,47,119,111,114,107,47,80,76,65,78,46,109,100,10,51,52,54,58,68,101,108,105,118,101,114,101,100,32,97,115,32,115,104,111,114,116,32,115,99,101,110,101,115,32,111,110,32,97,32,51,68,32,115,116,97,103,101,32,40,194,167,57,46,53,41,46,32,67,114,111,115,115,44,32,69,110,116,101,114,44,32,83,112,97,99,101,32,111,114,32,97,32,99,108,105,99,107,32,97,100,118,97,110,99,101,115,59,32,104,111,108,100,32,116,111,32,102,97,115,116,45,102,111,114,119,97,114,100,59,32,84,1