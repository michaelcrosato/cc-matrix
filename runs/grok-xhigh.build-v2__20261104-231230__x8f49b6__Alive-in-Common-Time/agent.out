tick);\\n    }));\\n    await page.waitForTimeout(1800);\\n    const st = await state();\\n    const issues = await audit();\\n    await page.screenshot({ path: path.join(OUT, name), animations: 'disabled' });\\n    const bytes = statSync(path.join(OUT, name)).size;\\n    say(`${name} screen=${st.screen} phase=${st.phase} vitals=${st.vitals == null ? '' : Math.round(st.vitals)} attract=${st.attract} bytes=${bytes} issues=${issues.length}`);\\n    for (const row of issues) say('  ' + JSON.stringify(row));\\n    return st;\\n  }\\n\\n  let st = await state();\\n  if (st.attract) {\\n    say('attract already on, exiting');\\n    await press('Enter');\\n    await page.evaluate(() => window.__game.test.step(2));\\n  }\\n  await shot('title.png');\\n  await press('Enter');\\n  st = await state();\\n  if (st.screen === 'Title') await press('Enter');\\n  await shot('main-menu.png');\\n\\n  await press('ArrowDown');\\n  await press('ArrowDown');\\n  await press('ArrowDown');\\n  await press('Enter');\\n  await shot('settings.png');\\n  await press('Escape');\\n  st = await state();\\n  say('after settings back ' + st.screen + ' focus ' + st.focusId);\\n\\n  if (st.screen !== 'Main Menu') {\\n    await page.keyboard.press('Escape');\\n    await page.evaluate(() => window.__game.test.step(2));\\n  }\\n  for (let i = 0; i < 4; i++) await press('ArrowDown');\\n  await press('Enter');\\n  await shot('about.png');\",\"new_string\":\"  async function poke() {\\n    await page.evaluate(() => {\\n      window.dispatchEvent(new PointerEvent('pointerdown', { bubbles: true, clientX: 4, clientY: 4, button: 0 }));\\n      window.dispatchEvent(new PointerEvent('pointerup', { bubbles: true, clientX: 4, clientY: 4, button: 0 }));\\n    });\\n  }\\n  async function keepAwake(on) {\\n    await page.evaluate((on) => {\\n      clearInterval(window.__keep);\\n      window.__keep = 0;\\n      if (!on) return;\\n      const poke = () => {\\n        window.dispatchEvent(new PointerEvent('pointerdown