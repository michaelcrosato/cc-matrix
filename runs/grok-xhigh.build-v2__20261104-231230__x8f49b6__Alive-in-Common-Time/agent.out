it: the countdown and who is ready, to every copy that shows one. */\\nfunction tickCard(state) {\\n  const left = state.splashUntil === null ? null : Math.max(0, state.splashUntil - performance.now());\\n  const ready = state.cells.filter((c) => state.answers.ready.has(c.key)).map((c) => c.bridge.me);\\n  for (const cell of state.cells) {\\n    if (cell.gone || !cell.bridge.showsCard) continue;\\n    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\\n    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\\n    if (cell.cardSent === id) continue;\\n    cell.cardSent = id;\\n    cell.bridge.card(card);\\n  }\\n}\\n\\n/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\\nfunction answerCard(state, cell, what) {\\n  if (state !== current || state.coordinator.released || cell.server) return;\\n  const { ready, more } = state.answers;\\n  if (what === 'ready') {\\n    ready.add(cell.key);\\n    more.delete(cell.key);\\n  } else if (more.has(cell.key)) {\\n    more.delete(cell.key);\\n  } else {\\n    more.add(cell.key);\\n    ready.delete(cell.key);\\n    state.splashUntil += 10_000;\\n  }\\n  log(`${cell.key} answers ${what} on the game's card`);\\n  const players = state.cells.filter((c) => !c.server && !c.gone);\\n  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\\n  tickCard(state);\\n}\\n\\nfunction endCurrent() {\\n  if (!current) return;\\n  current.coordinator.abort('session-ended');\\n  for (const cell of current.cells) removeCell(cell, false);\\n  current.hubEnd.close();\\n  current = null;\\n}\\n\\nfunction removeCell(cell, tellRound = true) {\\n  if (cell.gone) return;\\n  cell.gone = true;\\n  cell.detach();\\n  cell.endpoint.close();\\n  cell.frame.remove();\\n\",\"total_lines\":548}}","is_error":false}]},"parent_tool_use_id":null,"session_id":