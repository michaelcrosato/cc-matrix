 }\\n\\n  return {\\n    poll, takeClick, WHEEL,\\n    get device() { return device; },\\n    get seenPad() { return seenPad; },\\n    get promptSet() {\\n      return device === 'pad' ? ((game.settings?.glyphs === 'xbox') ? 'xbox' : 'playstation') : (device === 'mouse' ? 'mouse' : 'keyboard');\\n    },\\n    notePad() { seenPad = true; device = 'pad'; },\\n  };\\n}\\n\",\"total_lines\":250}}","is_error":false},{"type":"tool_result","tool_use_id":"call-e2c7b817-c5ec-48ca-ad09-9b682fc5930c-48","content":"{\"type\":\"GrepSearch\",\"stdout\":[60,119,111,114,107,115,112,97,99,101,95,114,101,115,117,108,116,32,119,111,114,107,115,112,97,99,101,95,112,97,116,104,61,34,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,51,49,50,51,48,95,95,120,56,102,52,57,98,54,47,119,111,114,107,34,62,10,70,111,117,110,100,32,49,48,32,109,97,116,99,104,105,110,103,32,108,105,110,101,115,10,47,104,111,109,101,47,109,105,99,104,97,47,100,101,118,47,99,99,45,109,97,116,114,105,120,47,114,117,110,115,47,103,114,111,107,45,120,104,105,103,104,46,98,117,105,108,100,45,118,50,95,95,50,48,50,54,49,49,48,52,45,50,51,49,50,51,48,95,95,120,56,102,52,57,98,54,47,119,111,114,107,47,65,108,105,118,101,32,105,110,32,67,111,109,109,111,110,32,84,105,109,101,45,84,114,97,117,109,97,32,67,101,110,116,101,114,58,32,83,101,99,111,110,100,32,79,112,105,110,105,111,110,45,103,114,111,107,45,52,46,55,45,120,104,105,103,104,45,50,48,50,54,49,49,48,52,45,50,51,49,50,51,48,47,115,114,99,47,97,112,112,47,100,105,114,101,99,116,111,114,46,106,115,10,50,48,58,99,111,110,115,116,32,65,66,79,85,84,95,72,69,65,68,83,32,61,32,91,10,51,56,58,99,111,110,115,116,32,83,69,84,84,73,78,71,83,95,80,65,71,69,83,32,61,32,91,10,52,48,49,58,32,32,32,32,99,111,110,115,116,32,112,97,103,101,32,61,32,83,69,84,84,73,78,71,83,95,80,65,71,69,83,91,109,111,100,101,108,46,1