{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat > tools/smoke.py <<'PY'\nimport json,pathlib\nfrom playwright.sync_api import sync_playwright\np=pathlib.Path(__file__).resolve().parents[1]\nwith sync_playwright() as x:\n b=x.chromium.launch(headless=True)\n page=b.new_page(viewport={'width':1920,'height':1080})\n errors=[]\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.goto((p/'build/game.html').as_uri())\n page.wait_for_selector('body[data-ready=\\\"true\\\"]')\n print(json.dumps(page.evaluate('({state:__game.debug.snapshot(), settings:{music:__game.settings.music,glyphs:__game.settings.glyphs}, title:document.title})'),default=str)[:1500])\n page.screenshot(path=str(p/'build/title.png'))\n page.get_by_role('button',name='Check in · Solo',exact=True).click()\n page.wait_for_timeout(300)\n print(json.dumps({'errors':errors,'runtime':page.evaluate('__game.errors'),'phase':page.evaluate('__TSS.sim.state.phase')}))\n page.screenshot(path=str(p/'build/intro.png'))\n page.keyboard.press('Enter')\n page.wait_for_timeout(300)\n page.screenshot(path=str(p/'build/play.png'))\n print(json.dumps({'errors':errors,'runtime':page.evaluate('__game.errors'),'phase':page.evaluate('__TSS.sim.state.phase'),'practice':page.evaluate('__TSS.sim.state.practice')}))\n b.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tools/smoke.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
