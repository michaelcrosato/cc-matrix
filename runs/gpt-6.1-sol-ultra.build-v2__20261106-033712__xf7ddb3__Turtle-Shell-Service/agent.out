=> q.pad));\n  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\n  if (!I.keysTo.length) I.keysTo = null;\n}\n/** let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin\n *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\nGame.prototype.allowJoin = function (o = {}) {\n  if (o === false) { this._join = null; this._lobby = null; _pClaim(this); return this; }\n  this._join = { max: clamp(o.max || 2, 2, 4), onJoin: o.onJoin || null, keys: o.keys !== false };\n  this._lobby = this._join.keys && this.screen.canvas ? new Input(_pStub(this), { join: ['Digit2'] }) : null;   // (listens for 2 while player 1 has the whole keyboard)\n  _pClaim(this); return this;\n};\n/** a player in now: { pad: index } (a gamepad) or { keys: 'right' } (the keyboard's right half; player 1 takes the\n *  left). Returns its input (null when four play already) */\nGame.prototype.addPlayer = function (o = {}) {\n575:- `settings.define(sp)`: add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value, label]] or [value], help, group: 'Game', apply(game, value) }. Its  [... omitted end of long line]\n1072:- `game.audio.define(name, voice)`: add or replace a named sound: audio.define('zap', { wave: 'saw', freq: 1200, to: 200, dur: .2 })\n1074:- `game.audio.instrument(name, fn)` †: an instrument of the game's own: fn(ctx, bus, time, freq, dur, vol) makes a note's sound (Web Audio, into bus, from time); its name is a wave a music track (wave [... omitted end of long line]\n1094:- `game.audio.presets`: the named sound effects, sfx(name) plays one and define(name, voice) adds one\n        poly(g,hex,shell.sh);\n        poly(g,[[-1.3,-.9],[0,-1.8],[1.3,-.9],[1.3,.8],[0,1.7],[-1.3,.8]].map(([u,v])=>point(u,v)),shell.lt);\n        for(const [u,v,du,dv]of [[-2,-1.4,-4,-2.8],[2,-1.4,4,-2.8],[-2,1.2,-4.2,2.5],[2,1.2,4.2,2.5],[0,-2.6,0,-5],[0,2.5,0,5]]){const p=point(u,v),q=point(du,dv);px.line(g,...p,...q,shell.sh,Math.max(1,s));}\n      }else{\n        for(const f of [-2.5,0,2.5])poly(g,[point(-3.7,f-1),point(0,f+.7),point(3.7,f-1),point(3.5,f+.4),point(0,f+2),point(-3.5,f+.4)],shell.sh);\n        const tag=point(4.1,-3.9);px.rect(g,tag[0]-1.3*s,tag[1]-1.6*s,2.6*s,3.2*s,'#70ced1');px.dot(g,tag[0],tag[1]-s,CREAM);\n        // Blue scarf belongs to P2 in every palette, so seats are readable without color alone.\n        const q=point(0,4.6);px.line(g,q[0]-sx*3*s,q[1]-sy*3*s,q[0]+sx*3*s,q[1]+sy*3*s,'#7be0da',1.4*s);\n      }\n      const shine=point(-2.1,3.4);px.rect(g,shine[0],shine[1],1.5*s,s,CREAM);\n      if(hurt){const q=point(0,0);text(g,'!',q[0],q[1]-3*s,CREAM,{align:'center',scale:Math.max(1,s)});}\n      if(st.carry&&room){\n        const t=st.action==='pickup'?clamp((.55-(st.actionTimer||0))/.55,0,1):1;\n        const climb=E.ease.outBack(t),forward=-4*(1-climb),q=point(0,forward,-2.5*climb);\n        baby(g,q[0],q[1],s*.63,this.spring.t,room.color||'#d6e89a',this.turn,reduce);\n        if(st.action!=='pickup'){\n          const b=point(0,-1.5,10);px.ell(g,b[0],b[1],3.3*s,3.2*s,INK);symbol(g,room.symbol,b[0],b[1],.7*s,room.color||GOLD);\n        }\n      }\n    }\n  }\n\n  function baby(g,x,y,s,t,color='#d7ed9b',angle=-Math.PI/2,reduce=false){\n    const f=[Math.cos(angle),Math.sin(angle)],v=[-f[1],f[0]],b=reduce?0:Math.sin(t*5)*.3*s;\n    y+=b;\n    for(const sd of [-1,1])for(const z of [-1,1])px.disc(g,x+(v[0]*sd*3.1+f[0]*z*1.8)*s,y+(v[1]*sd*3.1+f[1]*z*1.8)*s,1.1*s,'#a9d68d');\n    px.disc(g,x+f[0]*4*s,y+f[1]*4*s,2.5*s,INK);\n    px.disc(g,x+f[0]*4*s-.3*s,y+f[1]*4*s-.5*s,2*s,'#c5e7a1');\n    for(const sd of [-1,1]){const ex=x+(f[0]*4.5+v[0]*sd*.9)*s,ey=y+(f[1]*4.5+v[1]*sd*.9)*s;px.disc(g,ex,ey,.85*s,CREAM);px.dot(g,ex+f[0]*.3*s,ey+f[1]*.3*s,INK);}\n    px.ell(g,x,y,3.6*s,3.8*s,INK);px.ell(g,x-.2*s,y-.5*s,3*s,3.1*s,shade(color,-.15));px.ell(g,x-.8*s,y-1.2*s,2*s,1.9*s,color);\n    px.line(g,x-1.5*s,y,x+1.5*s,y,shade(color,-.4),Math.max(1,s));px.line(g,x,y-1.5*s,x,y+1.8*s,shade(color,-.4),Math.max(1,s));px.dot(g,x-s,y-2*s,CREAM);\n  }\n\n  class BeetleRig {\n    constructor(){this.spring=new E.Blob({R:4});this.state={dir:2,state:'blue'};this.phase=0;this.angle=0;}\n    update(dt,st,reduce=false){\n      this.state=st;this.phase+=dt*(st.state==='red'?19:st.state==='yellow'?15:11);\n      const d=DIR[st.dir]||DIR[2],target=Math.atan2(d[1],d[0]);this.angle+=Math.atan2(Math.sin(target-this.angle),Math.cos(target-this.angle))*Math.min(1,dt*16);\n      this.spring.update(dt,{look:d,walk:st.state==='stunned'?0:1,squash:reduce?0:Math.sin(this.phase)*.04});\n    }\n    draw(g,x,y,s,reduce=false){\n      const st=this.state,stun=st.state==='stunned',warn=st.warn>0,red=st.state==='red',yellow=st.state==='yellow';\n      const c=E.tones(stun?'#91a8b8':red?'#e56769':yellow?'#f2c65c':'#68a8d2');\n      const f=[Math.cos(this.angle),Math.sin(this.angle)],v=[-f[1],f[0]],q=(side,forward)=>[x+(v[0]*side+f[0]*forward)*s,y+(v[1]*side+f[1]*forward)*s];\n      const wobble=stun&&!reduce?Math.sin(this.phase*1.3)*.6:0;\n      y+=wobble*s;\n      for(const sd of [-1,1])for(const fr of [-1,0,1]){\n        const swing=stun?0:Math.sin(this.phase+fr*1.1+sd)*1.1,a=q(sd*3,fr*2),b=q(sd*5.3,fr*2+swing),tip=q(sd*5.8,fr*2+1.3+swing);\n        px.line(g,...a,...b,INK,Math.max(1,1.3*s));px.line(g,...b,...tip,stun?c.sh:c.lt,Math.max(1,s));\n      }\n      const head=q(0,4);px.disc(g,...head,2.7*s,INK);px.disc(g,head[0]-.2*s,head[1]-.3*s,2.2*s,c.sh);\n264:      if(room.revealed&&room.outcome==='beetle'){\n268:        if(room.revealed){\n","exit_code":0,"status":"completed"}}
