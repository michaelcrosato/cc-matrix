": {\"cx\": 19, \"cy\": 11, \"x\": 19, \"y\": 11, \"speed\": 3.5, \"dir\": [0, 0], \"moving\": false, \"arrived\": false, \"_want\": null, \"_to\": null, \"_u\": 0}, \"buffer\": -1, \"bufferTimer\": 0, \"carry\": null, \"home\": null, \"invulnerable\": 2, \"hurt\": 0, \"active\": true, \"bombHeld\": false, \"insideSupply\": false, \"action\": \"idle\", \"actionTimer\": 0}], \"rooms\": [{\"id\": \"f0r0\", \"cell\": [15, 11], \"x\": 248, \"y\": 184, \"outcome\": \"baby\", \"revealed\": false, \"discovered\": false, \"delivered\": false, \"carrier\": null, \"symbol\": \"\\u2605\", \"color\": \"#f3ca72\", \"home\": null}, {\"id\": \"f0r1\", \"cell\": [5, 3], \"x\": 88, \"y\": 56, \"outcome\": \"baby\", \"revealed\": false, \"discovered\": false, \"delivered\": false, \"carrier\": null, \"symbol\": \"\\u2665\", \"color\": \"#f19cba\", \"home\": null}, {\"id\": \"f0r2\", \"cell\": [17, 5], \"x\": 280, \"y\": 88, \"outcome\": \"baby\", \"revealed\": false, \"discovered\": false, \"delivered\": false, \"carrier\": null, \"symbol\": \"\\u25c6\", \"color\": \"#82d9d0\", \"home\": null}, {\"id\": \"f0r3\", \"cell\": [3, 1], \"x\": 56, \"y\": 24, \"outcome\": \"baby\", \"revealed\": fa\n{\"errors\": [], \"runtime\": [], \"phase\": \"intro\"}\n{\"errors\": [], \"runtime\": [], \"phase\": \"play\", \"practice\": false}\n","exit_code":0,"status":"completed"}}
