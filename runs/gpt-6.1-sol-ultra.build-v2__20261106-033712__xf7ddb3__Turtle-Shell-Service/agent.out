{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"tail -22 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests/sim.test.mjs'\nhead -25 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests/net.test.mjs'\nhead -20 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests/hub-campaign.test.mjs'\ncat 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests/hub.py' | head -55\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"tail -22 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests/sim.test.mjs'\nhead -25 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests/net.test.mjs'\nhead -20 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests/hub-campaign.test.mjs'\ncat 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests/hub.py' | head -55\"","aggregated_output":"test('central supply grants two stock and needs a fresh entry after recharge',()=>{const s=play();clearThreats(s);const p=s.state.players[0];s.state.stock=0;place(p,s.state.supply.cell);s.step(DT);assert.equal(s.state.stock,2);steps(s,800);assert.equal(s.state.stock,2);assert.equal(s.state.supply.ready,true);place(p,[10,8]);s.step(DT);place(p,s.state.supply.cell);s.step(DT);assert.equal(s.state.stock,4);assert.equal(s.state.metrics.supplies,2);});\ntest('supply caps inventory at five and has only one accepted simultaneous pickup',()=>{const s=play({seats:[1,2]});clearThreats(s);s.state.stock=4;for(const p of s.state.players)place(p,s.state.supply.cell);s.step(DT);assert.equal(s.state.stock,5);assert.equal(s.state.metrics.supplies,1);});\ntest('blue wanderer does not acquire a player target',()=>{const s=play(),e=s.state.enemies[0],p=s.state.players[0];place(e,[5,5]);place(p,[10,5]);e.state='blue';s._chooseEnemy(e);assert.equal(e.target,null);});\ntest('yellow lookout acquires only an unobstructed straight corridor',()=>{const s=play(),e=s.state.enemies[0],p=s.state.players[0];place(e,[5,5]);place(p,[10,5]);e.state='yellow';assert.equal(s._chooseEnemy(e),1);assert.equal(e.target,1);e.target=null;e.lastSeen=null;place(p,[10,7]);s._chooseEnemy(e);assert.equal(e.target,null);});\ntest('red tracker follows the authoritative graph around corners',()=>{const s=play(),e=s.state.enemies[0],p=s.state.players[0];place(e,[5,5]);place(p,[10,7]);e.state='red';const d=s._chooseEnemy(e);assert.ok(d>=0);assert.equal(e.target,1);assert.equal(d,s._dirCells([5,5],s.path(e,p)[1]));});\ntest('trackers reconsider routes at junctions rather than skipping them in flight',()=>{const s=play(),e=s.state.enemies[0],p=s.state.players[0];place(e,[5,1]);place(p,[5,5]);e.state='red';e.age=50;steps(s,100);assert.ok(e.y>24);assert.equal(e.x,88);});\ntest('enemy targeting uses seat order with distance hysteresis',()=>{const s=play({seats:[1,2]}),e=s.state.enemies[0],[p,q]=s.state.players;place(e,[5,5]);place(p,[3,5]);place(q,[7,5]);e.state='red';e.target=2;s._chooseEnemy(e);assert.equal(e.target,2);});\ntest('room beetles have an emergence grace period that prevents unavoidable reveal hits',()=>{const s=play({floor:2}),p=s.state.players[0];clearThreats(s);const r=s.state.rooms.find(r=>r.outcome==='beetle');place(p,r.cell);s.step(DT);assert.equal(s.state.enemies.length,1);assert.ok(s.state.enemies[0].emerge>1);assert.equal(s.state.lives,3);});\ntest('player leave returns a passenger and releases its sanctuary',()=>{const s=play({seats:[1,2]});clearThreats(s);const {p,r,h}=pickup(s,0,2);s.removeSeat(2);assert.equal(p.active,false);assert.equal(p.carry,null);assert.equal(r.carrier,null);assert.equal(h.reservedBy,null);assert.deepEqual(s.state.seats,[1]);});\ntest('cooperative same-tick final deliveries resolve once before a shared transition',()=>{const s=play({seats:[1,2]});clearThreats(s);for(let i=0;i<2;i++){const {p}=pickup(s,i,1);deliver(s,p);}pickup(s,2,1);pickup(s,3,2);for(const p of s.state.players)place(p,s.state.homes.find(h=>h.id===p.home).cell);s.step(DT);assert.equal(s.state.rescued,4);assert.equal(s.state.phase,'transition');assert.equal(s.state.totalRescued,4);assert.equal(s.events.filter(e=>e.kind==='deliver').length,2);assert.equal(s.events.filter(e=>e.kind==='clear').length,1);});\ntest('all passengers must be delivered and fresh floors have no leaked reservations',()=>{const s=play();clearThreats(s);for(let i=0;i<3;i++){const {p}=pickup(s,i);deliver(s,p);}const {p}=pickup(s,3);assert.equal(s.state.phase,'play');deliver(s,p);s.step(DT,{1:{confirm:true}});assert.equal(s.state.floor,1);assert.equal(s.state.rescued,0);assert.equal(s.state.totalRescued,4);assert.equal(s.state.bomb,null);assert.ok(s.state.homes.every(h=>h.reservedBy===null));assert.ok(s.state.players.every(p=>!p.carry));});\ntest('balance sliders update real movement and enforce escalation order',()=>{const s=play();clearThreats(s);s.setBalance('playerSpeed',5);assert.equal(s.state.balance.playerSpeed,5);s.setBalance('yellowAge',40);assert.ok(s.state.balance.redAge>=42);s.setBalance('redAge',20);assert.ok(s.state.balance.yellowAge<=18);assert.equal(s.state.practice,true);const p=s.state.players[0];place(p,[5,1]);steps(s,60,{1:{dir:1}});assert.ok(Math.abs(p.x-128)<.1);});\ntest('balance reset preserves accessibility flags and the practice record separation',()=>{const s=play({assisted:true});s.setBalance('playerSpeed',5);s.resetBalance();assert.deepEqual(s.state.balance,T.DEFAULT_BALANCE);assert.equal(s.state.assisted,true);assert.equal(s.state.practice,true);});\ntest('developer controls are observable, bounded and unranked',()=>{const s=play();s.dev('refill');assert.equal(s.state.stock,5);s.dev('invulnerable');assert.equal(s.state.dev.invulnerable,true);s.dev('spawn');assert.equal(s.state.enemies.length,2);s.dev('clear');assert.equal(s.state.enemies.length,0);s.dev('timeScale',99);assert.equal(s.state.dev.timeScale,3);assert.equal(s.state.practice,true);});\ntest('terminal snapshot restoration is stable and cannot score again',()=>{const s=play();s.state.phase='won';s.state.terminal='won';const b=new T.Simulation();b.loadSnapshot(s.snapshot());steps(b,50,{1:{bomb:true,dir:1}});assert.equal(b.state.phase,'won');assert.equal(b.state.score,0);});\nfunction campaign(seats){const sim=new T.Simulation({seed:47,seats}),bot=new T.Bot(sim);const floors=new Set(),types=new Set();for(let i=0;i<120*1000&&!sim.state.terminal;i++){sim.step(DT,bot.intents());floors.add(sim.state.floor);for(const e of sim.events)types.add(e.kind);}assert.equal(sim.state.phase,'won',JSON.stringify({phase:sim.state.phase,floor:sim.state.floor,total:sim.state.totalRescued,metrics:sim.state.metrics}));assert.equal(sim.state.totalRescued,26);assert.equal(floors.size,5);assert.equal(sim.state.practice,false);assert.equal(sim.state.demo,false);assert.ok(sim.state.lives>0&&sim.state.lives<=3);for(const k of ['reveal','pickup','deliver','bomb','trigger','stun','recover','supply','detect','escalate','clear','win'])assert.ok(types.has(k),'missing mechanic '+k);assert.ok(sim.state.metrics.redTicks>0);assert.ok(sim.state.metrics.decoys>0);return sim;}\ntest('ordinary uncheated solo campaign plays all five floors through legal input',()=>{const s=campaign([1]);assert.ok(s.state.metrics.hits>0);});\ntest('ordinary simultaneous cooperative campaign shares all objectives and resources',()=>{const s=campaign([1,2]);assert.equal(s.state.players.length,2);assert.equal(s.state.metrics.discoveries,26);assert.equal(s.state.metrics.deliveries,26);});\ntest('the same deterministic action trace produces byte-identical states',()=>{const a=play(),b=play();for(let i=0;i<3000;i++){const intents={1:{dir:Math.floor(i/72)%4,bomb:i%250===0}};a.step(DT,intents);b.step(DT,intents);}assert.deepEqual(a.snapshot(),b.snapshot());});\n\nexport async function runSimulationTests(){let passed=0;const failures=[];for(const {name,fn} of tests){try{await fn();passed++;}catch(e){failures.push(name+': '+e.message);}}return {passed,failed:failures.length,failures,total:tests.length};}\nif(process.argv[1]&&fileURLToPath(import.meta.url)===process.argv[1]){const r=await runSimulationTests();for(const f of r.failures)console.error(f);console.log(`${r.passed}/${r.total} simulation checks passed`);if(r.failed)process.exitCode=1;}\nimport assert from 'node:assert/strict';\nimport { fileURLToPath } from 'node:url';\nimport { pathToFileURL } from 'node:url';\nimport '../src/net.js';\n\nconst copy = (x) => JSON.parse(JSON.stringify(x));\n\nclass StubSimulation {\n  constructor({ seed, seats, runId }) {\n    this.state = {\n      seed, runId, floor: 0, tick: 0, time: 0, phase: 'play', terminal: null,\n      stock: 3, score: 0, totalRescued: 0, recentEvents: [], balance: { playerSpeed: 3.5 },\n      players: seats.map((seat) => ({ id: `p${seat}`, seat, x: seat * 16, y: 16, active: true, carry: null, home: null, hurt: 0 })),\n    };\n    this.events = [];\n    this.held = {};\n  }\n  snapshot() { return copy(this.state); }\n  loadSnapshot(state) { this.state = copy(state); }\n  step(dt, intents) {\n    this.state.tick++;\n    this.state.time += dt;\n    this.events = [];\n    for (const p of this.state.players) {\n      if (!p.active) continue;\nimport assert from 'node:assert/strict';\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\nimport { pathToFileURL } from 'node:url';\nimport { resolve } from 'node:path';\nimport { createBridge, createLocalNetwork } from '../vendor/hub/bridge.js';\nimport { createRound } from '../vendor/hub/round.js';\nimport '../vendor/engine/my-3d2dge.js';\nimport '../src/content.js';\nimport '../src/sim.js';\nimport '../src/bot.js';\nimport '../src/net.js';\n\nconst sessionSource = readFileSync(new URL('../vendor/hub/session.js', import.meta.url), 'utf8');\nconst clone = (x) => JSON.parse(JSON.stringify(x));\n\nfunction virtualClock() {\n  let now = 0, serial = 0;\n  const timers = new Map();\n  const clock = {\n\"\"\"Run the supplied AI Hub browser harness against the packaged delivery.\"\"\"\n\nimport argparse\nimport functools\nimport http.server\nimport json\nfrom pathlib import Path\nimport threading\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef run():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--scenario\", action=\"append\")\n    args = parser.parse_args()\n    dev = Path(__file__).resolve().parent.parent\n    root = dev.parent\n    identity = json.loads((dev / \"identity.json\").read_text())\n    handler = functools.partial(QuietHandler, directory=str(root))\n    server = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    worker = threading.Thread(target=server.serve_forever, daemon=True)\n    worker.start()\n    base = f\"http://127.0.0.1:{server.server_port}\"\n    game = f\"/{identity['slug']}.html\"\n    scenarios = args.scenario or [\"standard\", \"loss\", \"server\", \"host-leave\"]\n    failures, reports = [], []\n    try:\n        with sync_playwright() as pw:\n            browser = pw.chromium.launch(headless=True)\n            for scenario in scenarios:\n                page = browser.new_page(viewport={\"width\": 1600, \"height\": 1000})\n                errors = []\n                page.on(\"pageerror\", lambda error: errors.append(str(error)))\n                params = {\"game\": game, \"players\": \"2\", \"auto\": \"1\", \"seed\": \"47\"}\n                if scenario == \"loss\":\n                    params.update(latency=\"150\", jitter=\"50\", loss=\"5\")\n                else:\n                    params.update(latency=\"60\", jitter=\"20\", loss=\"0\")\n                if scenario in (\"server\", \"host-leave\"):\n                    params[\"scenario\"] = scenario\n                url = f\"{base}/{identity['slug']}/vendor/hub/harness.html?{urlencode(params)}\"\n                try:\n                    page.goto(url)\n                    page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=55000)\n                    report = page.evaluate(\"window.__hubCheck\")\n                    frames = [frame for frame in page.frames if frame != page.main_frame]\n                    identities = [frame.evaluate(\"document.body.dataset.game || ''\") for frame in frames]\n                    snapshots = [frame.evaluate(\"window.__game?.debug?.snapshot?.()\") for frame in frames]\n","exit_code":0,"status":"completed"}}
