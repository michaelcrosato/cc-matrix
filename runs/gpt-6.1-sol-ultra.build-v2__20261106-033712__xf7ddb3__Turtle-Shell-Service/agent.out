{ actions, o } = this._touchArgs, S = this._settings || {}, mode = S.touch || 'auto', left = S.hand === 'left', size = clamp(+S.touchSize || 62, 40, 96);\n    const coarse = this._touched || (window.matchMedia && matchMedia('(pointer: coarse)').matches);   // (a laptop with a touch screen: once touched)\n    for (const el of [this._touchEl, this._startEl]) if (el) { for (const b of el.querySelectorAll('[data-act]')) this.release('Act:' + b.dataset.act); el.remove(); }\n    this._touchEl = this._startEl = null;\n    const show = mode === 'on' || (mode === 'auto' && (coarse || !!o.force));\n    this.touchEnabled = mode !== 'off'; this.stickSide = left ? 'right' : 'left';\n    if (!show) { if (this.stickOn) this._stickEnd({ pointerId: this.stickId }); return null; }\n    const host = this.screen.canvas.parentElement || document.body, box = document.createElement('div'), side = left ? 'left' : 'right';\n    box.dataset.sys = 'touch';\n    box.style.cssText = 'position:absolute;' + side + ':calc(14px + env(safe-area-inset-' + side + ',0px));bottom:calc(14px + env(safe-area-inset-bottom,0px));display:flex;gap:10px;z-index:4;touch-action:none;opacity:' + clamp(+S.touchOpacity || .8, .2, 1) + (left ? ';flex-direction:row-reverse' : '');\n    this._touchBtns = {};\n    for (const a of actions) {\n      const b = this._touchBtns[a] = document.createElement('button'); b.dataset.act = a; b.setAttribute('aria-label', a);\n      b.style.cssText = 'width:' + size + 'px;height:' + size + 'px;border-radius:50%;border:2px solid rgba(255,255,255,.45);background:rgba(20,16,40,.55);color:#fff;font:600 ' + Math.round(size / 5) + 'px system-ui,sans-serif;touch-action:none;user-select:none;-webkit-user-select:none;overflow:hidden;padding:0';\n      this._touchLook(b, a); box.appendChild(b);\n    }\n    if (getComputedStyle(host).position === 'static') host.style.position = 'relative';\n    host.appendChild(box); this.bindButtons(box); this._touchEl = box;\n    if (!this._cornerMenu) {   // START: the corner's menu button is it; without the corner, a button of its own in the same place\n      const st = this._startEl = document.createElement('div'), b = document.createElement('button'); st.dataset.sys = 'touch';\n      st.style.cssText = 'position:fixed;top:calc(8px + env(safe-area-inset-top,0px));right:calc(8px + env(safe-area-inset-right,0px));z-index:4;touch-action:none;opacity:' + clamp(+S.touchOpacity || .8, .2, 1);\n      b.dataset.act = 'menu'; b.textContent = 'START'; b.setAttribute('aria-label', 'Start or menu');\n      b.style.cssText = 'min-width:44px;height:44px;padding:0 10px;border-radius:10px;border:1px solid rgba(255,255,255,.4);background:rgba(20,16,40,.55);color:#fff;font:600 11px system-ui,sans-serif;touch-action:none';\n      st.appendChild(b); document.body.appendChild(st); this.bindButtons(st);\n    }\n    return box;\n  }\n  /** press a key or button code ('KeyJ', 'Mouse0', 'Pad0', 'Act:attack') as if the person did: scripted input,\n   *  tests, bots */\n  press(code) {\n    if (this.held.has(code) || (code === 'Pad9' && this.held.has('Pad8'))) return;   // (Create + Options is the host's: the AI Hub opens its bar on it, so Options while Create is held is no press)\n    this.held.add(code); this._freshCodes.add(code);\n    if (code.startsWith('Pad')) { this.lastDevice = 'gamepad'; this.aimSource = 'pad'; }\n    else if (code.startsWith('Act:')) this.lastDevice = 'touch';\n    else this.lastDevice = code.startsWith('Mouse') ? 'mouse' : 'keyboard';\n    for (const a of this._codes[code] || []) { this._pt[a] = this.clock; this._used[a] = false; this._rk[a] = -1; this._fresh.add(a); }\n  }\n  while (H.length > 2 && H[1].t < I.clock - 1) H.shift();\n} });\n// one step of a sequence, 'down+right' or 'attack' or 'down+attack': the directions it holds (bits) and the buttons pressed\nconst _seqStep = s => { let b = 0, dirs = false; const btn = []; for (const p of String(s).split('+')) { const i = _DIRS.indexOf(p); if (i >= 0) { b |= 1 << i; dirs = true; } else if (p === 'neutral') dirs = true; else if (p) btn.push(p); } return { b, dirs, btn }; };\n/**\n * true on the step a sequence of inputs ends, each one after the last within window seconds (.5) of the first:\n * input.sequence(['down', 'down+right', 'right', 'attack']). A step names actions joined by +: its directions are held\n * exactly as it says (up, down, left, right; 'neutral' for none) as they change to that, its buttons pressed. A cheat\n * code: input.sequence(['up', 'up', 'down', 'down', 'left', 'right', 'left', 'right', 'kick', 'attack'], { window: 3 })\n */\nInput.prototype.sequence = function (steps, o = {}) {\n  const H = this._hist, n = steps.length; if (!H || !H.length || !n) return false;\n  const win = o.window === undefined ? .5 : o.window, last = H[H.length - 1], now = this.clock;\n  if (last.t !== now) return false;\n  const ok = (st, k) => { const h = H[k]; if (st.dirs && h._b !== st.b) return false; if (st.btn.length) return st.btn.every(a => h.pressed.includes(a)); return k === 0 || H[k - 1]._b !== h._b; };\n  const S = steps.map(_seqStep); let i = n - 1, k = H.length - 1; if (!ok(S[i], k)) return false;\n  if (S[i].dirs || !S[i - 1] || S[i - 1].btn.length) k--;   // (a button may land on the step its motion ends)\n  for (i--; i >= 0 && k >= 0; k--) { if (now - H[k].t > win) return false; if (ok(S[i], k)) i--; }\n  return i < 0;\n};\n/**\n * a fighter's move in numpad notation, mirrored by facing: input.motion('236', 'attack', { facing: hero.facing, window })\n * is a quarter circle forward and punch (down, down-forward, forward, attack: a fireball); '623' a dragon punch, '41236'\n * a half circle. facing: 1 (right, the default) or -1. button: an action, 'attack+kick', or none (the motion alone)\n */\nInput.prototype.motion = function (digits, button, o = {}) {\n  const fw = (o.facing || 1) < 0 ? 'left' : 'right', bk = fw === 'left' ? 'right' : 'left';\n  const D = { 1: 'down+' + bk, 2: 'down', 3: 'down+' + fw, 4: bk, 5: 'neutral', 6: fw, 7: 'up+' + bk, 8: 'up', 9: 'up+' + fw };\n  const steps = String(digits).split('').map(c => D[c]).filter(Boolean);\n  if (button) steps.push(button);\n  return this.sequence(steps, Object.assign({ window: .45 }, o));\n};\n\n/* =============================================================================\n * 10i. CAMERA WINDOW AND FRAMING  game.cam.window (a dead zone), cam.snapY (height on landing), cam.frame(targets)\n *    (several things kept in view): where the camera aims, from where it would aim (tx, ty: its top-left corner, in\n *    projected pixels). Game's _camStep asks it while one of them is set\n * ============================================================================= */\n// where the camera aims: framed between its targets (zooming to fit), its height held until a landing, kept still while\n// the focus stays in the window\nGame.prototype._camAim = function (tx, ty) {\n  const c = this.cam, W = this.screen.W, H = this.screen.H, fr = this._framed;\n  if (fr) {\n    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\n    for (const t of fr.list) { if (!t) continue; const [px2, py2] = this.view.p(t.x || 0, t.y || 0, t.z || 0); x0 = Math.min(x0, px2); x1 = Math.max(x1, px2); y0 = Math.min(y0, py2 - 16); y1 = Math.max(y1, py2); }\n    if (x1 >= x0) {\n      tx = (x0 + x1 - W) / 2; ty = (y0 + y1 - H) / 2;\n      const Z = fr.zoom; if (Z) {   // out at once when they don't fit, back in once they would fit well\n        const k = Math.min((W - 2 * fr.margin) / Math.max(1, x1 - x0), (H - 2 * fr.margin) / Math.max(1, y1 - y0)), z = this._zoomBase;\n        const want = clamp(Math.floor(z * Math.min(k, 1.25) * 20) / 20, Z[0], Z[1]);\n        if (want < z - 1e-9 || (k > 1.2 && want > z + 1e-9)) this.setZoom(want);\n- `find(tag)` / `findAll(tag)` give `{ x, y, z, cx, cy }`. Also `cell(cx, cy)`, `set(cx, cy, id)` (open doors), `toCell(x, y)`, `center(cx, cy)`, `heightAt(x, y)`, `floorAt(x, y)`, `groundAt(x, y, r, z)`, `collide(body)`, `los(x0, y0, x1, y1)` (ground only), `bounds(view)` (`{ x0, y0, x1, y1 }`, buffer pixels), `drawFloor(r)`, `queueWalls(r)`.\n\n**Heights** (collision, standing, sight, reach and navigation share one rule): a body's `z` is its feet; a cell's top is `map.height(cx, cy)` (0 = floor); a body stands on the highest top within `z + 2`. Eyes at `z + E.HEIGHTS.eye` (30) see a target at `z + E.HEIGHTS.chest` (22); a body's own `eye` / `chest` override them (crouching). Same level: `|dz| <= 8`. On a TileMap (`dir` = an angle or `[dx, dy]`): `ray(a, b, { eye, target })` → `{ clear, t, x, y, z }`, `sight(a, b)`, `standable(x, y, z, r)`, `ledge(from, dir)` → `{ x, y, z, rise, facing, edge }` (climb), `landing(from, dir)` → `{ x, y, z, d }` (a jump across a gap), `drop(from, dir)` → `{ x, y, z, fall }`, `arcClear(a, b, apex, r)`, `pick(sx, sy)` → `{ cx, cy, z, face }` (the cell under a screen point: `input.clicked()`, any view and turn). Helpers: `E.sameLevel(a, b)`, `E.targets(from, list, { range, arc, dz, sight: map })` → `[{ target, d, dz, angle }]` nearest first, `E.inArc(..., dz)`. `new E.FlowField(map, { climb, drop, jump })` paths over roofs, between levels and across gaps.\n\n**PlatformMap** (side-scrollers; 2.5D in tilted views): tiles on the x/z plane, top row first.\n- `new E.PlatformMap({ rows, legend, types })`. `types[id] = { kind, style, side, top, line, mat }` (`mat`: any material for a solid tile's face). Example: `rows: ['      ?    ', '   ===     ', '@  g   ^^  ', '###########']`, `legend: { '#': 1, '=': 2, '?': 3, '^': 4, '@': 'hero', 'g': 'walker' }`, `types: { 1: { style: 'ground', side: '#8a5a32' }, 2: { kind: 'oneway' }, 3: { style: 'bonus', side: '#e8a830' }, 4: { kind: 'hazard' } }`. Kinds: `'solid'` (default), `'oneway'` (jump up through), `'ladder'`, `'slope'` (`dir: 1` rises to the right, `-1` to the left; `from` / `to` heights 0..1 for gentle slopes), `'hazard'` (spikes, lava), `'deco'`, `'back'` (background wall). Styles: `'stone'` (`moss`) `'brick' 'wood' 'metal' 'ground'` (`flower`) `'block' 'pipe' 'bonus' 'plank' 'spikes' 'ladder' 'liquid' 'plain'`.\n- Spawns: `find(tag)` gives `{ x, z }` with z = the bottom of that cell (feet). Standing on the ground means z = the top of the floor tiles (`level.groundBelow(x, z)`, which returns `null` over a pit), not z = 0. `cell(cx, cz)` / `set(cx, cz, id)` count cz from the bottom row. `slopeZ(cx, cz, x)`, `touching(body, 'hazard')`, `cellsTouching(body, kind)`, `groundBelow(x, z)`, `solidAt(x, z)`, `move(body, dt, solids)`, `bounds(view)`, `draw(r)` (call first, after `r.sky`), `width`, `height`.\n\n## Movement and physics\n**Platformer** (side-scroller character): `const hero = new E.Platformer({ x, z, w: 8, h: 22, run: 95, jump: 285, gravity: 800, airJumps: 0, wallJump: false, dash: 0 })`.\n- Each update: `hero.update(dt, level, game.input, movingPlatforms)`. For enemies pass `{ x: -1..1, jump, jumpPressed, up, down, dash }` instead of the input.\n- Read: `onGround`, `jumped`, `landed`, `facing` (1 or -1), `air`, `climbing`, `hitWall`, `hitCeiling`, `bumped` (`{ cx, cz, id }` of a block hit from below). Methods: `knock(dir)`, `rigState(extra)` (feed it to `rig.update`).\n- Built in: coyote time, jump buffering, variable jump height (let go early for a short hop), slopes and small steps (sticks to the ground going down), ladders (up / down), drop through one-way tiles (down + jump), optional double jump, wall jump and dash.\n- Further moves, each on request: `crouch` (down: half as tall, it crawls), `ledge` (catches a ledge falling past it; up climbs), `wallCling`, `momentum` (slopes, a roll, a charged dash); tile kinds `'water'` (it swims), `'rope'` (up grabs it), `'bars'` (it hangs and travels), grip `friction` (ice .15), `carry` (a conveyor), `bounce` (a spring), `crumble` and `respawn` (`level.update(dt)` each step); `hero.swingFrom(x, z)` (a grapple: a pendulum, jump lets go); draw `level.drawWater(r)` after the actors. State: `crouching`, `hanging`, `clinging`, `swimming`, `onRope`, `onBars`, `swinging`, `rolling`; `rigState()` poses them.\n- Moving platforms: `{ x, z, w, h, vx, vz }` boxes you move yourself and pass as `solids`; riders are carried.\n\n**Body** (top-down / isometric / brawler): `new E.Body({ x, y, r: 5, friction: 0, bounce: 0, gravity: 700 })`. Set `vx`, `vy`, then `body.update(dt, map)`. Also `push(ix, iy, iz)` (knockback), `jump(v)`, and `onGround`, `z`, `groundZ`, `hitWall`, `landed`, `bounced` (hit the ground and bounced: dust, a thud). Walls lower than your feet are walkable, so bodies can jump onto blocks.\n\n**Mover** (third person): `const mover = new E.Mover({ x, y })`; `mover.update(dt, map, game.input)` (input `'THIRDPERSON'`) or an AI's `{ move: [dx, dy], sprint, crouch, jumpPressed }`: it sprints, sneaks, climbs, vaults, leaps gaps, hops down and rolls; `climbAny: true` climbs any wall (jump at it; up the screen is up the wall; jump leaps up, crouch lets go; `mover.wall`, `map.wall(from, dir)`), `glide: true` glides (jump again in the air; `lift`: an updraft), `staminaMax: 100` (climbing, gliding and sprinting spend `mover.stamina`); `rig.update(dt, mover.rigState())`; `mover.play('takedown', { other })`, your own `E.ACTIONS`. Stealth: `E.sees(guard, hero, { map })` → `{ seen, exposure }`, `E.hears`, `new E.Suspicion()` (`update(dt, seen, hero)` → `'calm' | 'notice' | 'search' | 'alert'`), `r.sightCone(guard, { map })`, `r.marker(x, y, z, { label })`.\n\n**Attack** (melee timing for swords, punches, kicks): `const slash = new E.Attack('slash')` (a move from `E.MOVES`, optionally with overrides: `new E.Attack('thrust', { reach: 10 })`) or a spec `{ a0, a1, z0, z1, reach, wind, active, recover }`. `if (input.buffered('attack') && slash.start()) input.consume('attack')`; `slash.update(dt)` (returns the phase that just began); `slash.hits(enemies, e => E.inArc(hero, facing, e, 22, 1.4), e => {...})` hits each target once per swing during `'active'` (moves wait until `hitAt: .35` of the swing, so hit-stop freezes the strike, not the wind-up); `rig.update(dt, { ..., attack: slash.state })`. Also `busy`, `active`, `cancel()`. **Combo**: `const combo = new E.Combo(['jab', 'cross', 'hook', 'uppercut'], { window: .3 })` (names, specs or Attacks); `combo.press()` starts or chains the next hit; `update`, `hits`, `state`, `step` work the same. **Knockback**: `E.knockback(attacker, target, 160, up)` pushes a Body (or anything with vx / vy) away.\n\n**Bullets**: `const shots = new E.Bullets(game, { plane: 'ground' | 'side' })`; `shots.fire({ x, y, z, vx, vy, vz, r: 2, team: 'player', color, life, dmg, pierce, sprite })`; `shots.burst(base, E.pattern.spread(angle, n, arc, speed))`; `shots.update(dt, map)`; `shots.hit(targets, (b, t) => {...}, 'player')`; `shots.draw(r)`; `shots.clear(team)`. Patterns: `E.pattern.dir(angle, speed)`, `aim(a, b, speed)`, `aimSide(a, b, speed)`, `spread(angle, n, arc, speed)`, `ring(n, speed, offset)`. In side view the second number of a pattern velocity is vz.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '1235,1278p' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/vendor/engine/my-3d2dge.js'\nsed -n '864,888p' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/vendor/engine/my-3d2dge.js'\nsed -n '1044,1072p' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/vendor/engine/my-3d2dge.js'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '1235,1278p' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/vendor/engine/my-3d2dge.js'\nsed -n '864,888p' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/vendor/engine/my-3d2dge.js'\nsed -n '1044,1072p' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/vendor/engine/my-3d2dge.js'\"","aggregated_output":"      const ux = (b.x - a.x) / d, uy = (b.y - a.y) / d, pa = (a.x - a.x0) * ux + (a.y - a.y0) * uy, pb = (b.x - b.x0) * ux + (b.y - b.y0) * uy;\n      if (Math.abs(pa) < 4 || Math.abs(pb) < 4 || pa * pb >= 0 || Math.abs(d - Math.hypot(b.x0 - a.x0, b.y0 - a.y0)) < 16) return;\n      this._pinching = true; this._pinchD = d; this._down = null; this._g = this._gBox = null;\n      if (this.stickOn && this._fingers.has(this.stickId)) this._stickEnd({ pointerId: this.stickId });\n      return;\n    }\n    this._zoomAcc *= d / this._pinchD; this._pinchD = d; this._zoomPt = this.screenPoint((a.x + b.x) / 2, (a.y + b.y) / 2);\n  }\n  _stickStart(e) {\n    if (!this.touchEnabled || this.stickOn) return;\n    const rc = this.screen.canvas.getBoundingClientRect();\n    if (this.steer !== 'drag' && (this.stickSide === 'right' ? e.clientX - rc.left < rc.width * .5 : e.clientX - rc.left > rc.width * .5)) return;   // dragging: anywhere\n    this.screen.canvas.setPointerCapture(e.pointerId); this.aimSource = 'move'; this.lastDevice = 'touch';\n    /** stickId: the pointer (finger) holding the touch stick */\n    this.stickId = e.pointerId; this.stickOn = true; this._stickO = [e.clientX, e.clientY]; this.stick = [0, 0]; this._dragAt = [e.clientX, e.clientY];\n    if (!this._stickEl) {\n      const mkEl = (s, css) => { const d = document.createElement('div'); d.style.cssText = 'position:absolute;pointer-events:none;border-radius:50%;z-index:3;' + css; d.style.width = d.style.height = s + 'px'; this.screen.canvas.parentElement.appendChild(d); return d; };\n      this._stickEl = mkEl(96, 'border:2px solid rgba(255,255,255,.35);background:rgba(255,255,255,.06)');\n      this._knobEl = mkEl(40, 'background:rgba(255,255,255,.4)');\n    }\n    this._stickDraw();\n  }\n  _stickMove(e) {\n    if (!this.stickOn || e.pointerId !== this.stickId) return;\n    const da = this._dragAcc || (this._dragAcc = [0, 0]); da[0] += e.clientX - this._dragAt[0]; da[1] += e.clientY - this._dragAt[1]; this._dragAt = [e.clientX, e.clientY];\n    let dx = (e.clientX - this._stickO[0]) / this.stickRadius, dy = (e.clientY - this._stickO[1]) / this.stickRadius;\n    const l = Math.hypot(dx, dy), d = clamp(this.stickDeadzone, 0, .5), k = l <= d ? 0 : Math.min(1, (l - d) / (1 - d)) / l;   // a thumb resting on the glass doesn't creep\n    this.stick = [dx * k, dy * k]; this._stickDirs(); this._stickDraw();\n  }\n  _stickEnd(e) { if (e.pointerId !== this.stickId) return; this.stickOn = false; this.stick = [0, 0]; this._stickDirs(); if (this._stickEl) this._stickEl.style.display = this._knobEl.style.display = 'none'; }\n  // past halfway the stick presses the direction actions, as a d-pad would (and lets go of them)\n  _stickDirs() {\n    const [x, y] = this.stick, on = [y < -.5, y > .5, x < -.5, x > .5], was = this._sd || (this._sd = [false, false, false, false]);\n    ['up', 'down', 'left', 'right'].forEach((d, i) => { if (on[i] !== was[i]) { was[i] = on[i]; if (on[i]) this.press('Act:' + d); else this.release('Act:' + d); } });\n  }\n  _stickDraw() {\n    if (this.steer === 'drag') { this._stickEl.style.display = this._knobEl.style.display = 'none'; return; }   // a drag steers what it moves: no stick to show\n    const rc = this.screen.canvas.getBoundingClientRect(), pr = this.screen.canvas.parentElement.getBoundingClientRect();\n    const ox = this._stickO[0] - pr.left, oy = this._stickO[1] - pr.top;\n    Object.assign(this._stickEl.style, { display: 'block', left: ox - 48 + 'px', top: oy - 48 + 'px' });\n    Object.assign(this._knobEl.style, { display: 'block', left: ox - 20 + this.stick[0] * 36 + 'px', top: oy - 20 + this.stick[1] * 36 + 'px' });\n    void rc;\n  }\n}\n   *  (bindings, set by rebind() and the Controls screen) are laid over it. Every preset (E.Input.DEFAULT, PLATFORMER,\n   *  THIRDPERSON, SHMUP) has the moves (up, down, left, right) and the menu's actions (start, pause, confirm, cancel).\n   *  The keys held stay held (down() in the new layout, not pressed() again), and a press no step has seen counts in it */\n  use(map) {\n    if (typeof map === 'string') map = Input[map.toUpperCase()] || Input.DEFAULT;\n    const B = this.bindings || {};\n    /** map: each action's codes ({ jump: ['Space', 'Pad0', 'Act:jump'] }); every action also answers to 'Act:<name>'\n     *  (DOM buttons with data-act, tap, hold) */\n    this.map = {};\n    for (const a in map) {\n      if (!Array.isArray(map[a])) continue;   // (a preset's halves: Input.halfKeys)\n      let codes = map[a].slice(); const b = B[a];\n      if (b && this.rebindable(a, map)) for (const k of ['keys', 'pad']) if (Array.isArray(b[k])) codes = codes.filter(c => padCode(c) !== (k === 'pad') || FIXED_CODES.has(c)).concat(b[k]);\n      if (a === 'start' || a === 'pause') codes.push('Act:menu');   // (the touch START)\n      if (STICK_CODES[a]) codes.push(STICK_CODES[a]);   // (the gamepad's left stick; the touch stick presses 'Act:' + a)\n      this.map[a] = [...new Set(codes), 'Act:' + a];\n    }\n    this._codes = {}; for (const a in this.map) for (const c of this.map[a]) (this._codes[c] = this._codes[c] || []).push(a);\n    /** preset: the layout last given to use() (E.Input.DEFAULT, PLATFORMER, SHMUP or your own) */\n    this.preset = map;\n    if (this.held) {   // in play: a key held stays held (down in the new layout, not pressed again); a press no step has seen yet counts in it\n      for (const a in this.map) this._used[a] = true;\n      this._now.clear(); this._fresh.clear(); this._nowUp.clear(); this._freshUp.clear(); this._pt = {}; this._rk = {};\n      for (const c of this._freshCodes) for (const a of this._codes[c] || []) { this._pt[a] = this.clock; this._used[a] = false; this._rk[a] = -1; this._fresh.add(a); }\n    }\n  /** true only during the first update step after the press (menus, jumps, one-shot actions) */\n  pressed(a) { if (!this.map[a]) this._check(a); return !this._suppressed.has(a) && this._now.has(a); }\n  /** true only during the first update step after the action was let go */\n  released(a) { return this._nowUp.has(a); }\n  /** pressed, then repeats while held (after `delay` s, every `rate` s): menu cursors, puzzle pieces */\n  repeat(a, delay = .3, rate = .08) {\n    if (this.pressed(a)) return true;\n    if (!this.down(a) || this._pt[a] === undefined) return false;\n    const t = this.clock - this._pt[a]; if (t < delay) return false;\n    const k = Math.floor((t - delay) / rate); if (k !== this._rk[a]) { this._rk[a] = k; return true; }\n    return false;\n  }\n  /** was it pressed within the last `win` seconds and not yet consumed? (input buffering) */\n  buffered(a, win = .15) { if (!this.map[a]) this._check(a); const t = this._pt[a]; return !this._suppressed.has(a) && t !== undefined && !this._used[a] && this.clock - t <= win; }\n  /** mark a buffered press of action a as used, so buffered(a) is false until the next press */\n  consume(a) { this._used[a] = true; }\n  /** Suppress a held action until the next tick (a HUD widget owns the pointer this step). */\n  suppress(a) { this.consume(a); this._suppressed.add(a); }\n  /** A widget owns this button; other devices bound to the same action still work. */\n  suppressCode(code) {\n    for (const a of this._codes[code] || []) if (!this.map[a].some(c => c !== code && this.held.has(c))) this.suppress(a);\n  }\n  /** forget every pending press (after closing a menu or dialog, so the same press does not also attack) */\n  consumeAll() { for (const a in this.map) this._used[a] = true; this._now.clear(); this._fresh.clear(); this._freshCodes.clear(); this._clickAt = this._click = null; }\n  /** the page went full screen or back: the keys and mouse buttons let go (one held through the change may never come up),\n   *  but a finger on the glass goes on (the stick, a drag, a touch button) and a press that has landed counts: a phone's\n   *  first tap, the one that went full screen, is a JUMP */\n  _refit() { for (const c of [...this.held]) if (!c.startsWith('Act:') && !c.startsWith('Pad')) this.release(c); this._down = null; }\n  /** Release all devices and discard buffered input on focus loss or a modal transition. */\n","exit_code":0,"status":"completed"}}
