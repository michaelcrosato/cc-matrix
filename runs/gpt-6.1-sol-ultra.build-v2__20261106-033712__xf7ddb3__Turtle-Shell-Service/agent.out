r.x, e.y - player.y) < 20 && sim.map.los(e.x, e.y, player.x, player.y));\n        if (touch && g.settings.touchAssist && state.phase === 'play' && !blocked) {\n          this.touchAssisted = true;\n          if (!g.live && !state.assisted) state.assisted = true;\n          if (danger && state.stock > 0 && !state.bomb && !this.autoLast) bomb = true;\n          this.autoLast = bomb;\n        } else this.autoLast = false;\n        if (k === 0) I.touchSet('bomb', state.stock ? 'POP' : 'EMPTY', !blocked && state.phase === 'play' && touch && threat);\n        out[seat] = blocked || (k === 0 && this.menuPad) ? { dir: -1, bomb: false, confirm: false } : { dir: d, bomb, confirm: I.pressed('confirm') || I.pressed('start') };\n        if (controlledSeat !== null) break;\n      }\n      return out;\n    }\n    prompt() {\n      const I = this.game.input;\n      if (I.lastDevice === 'touch') return 'Drag anywhere to move · POP near a beetle';\n      if (this.style === 'shared') return 'P1 WASD + Space    P2 Arrows + Right Shift';\n      if (I.lastDevice === 'gamepad') return 'Left stick / D-pad move    ' + I.label('bomb') + ' bug bomb    ' + I.label('pause') + ' menu';\n      if (I.lastDevice === 'mouse') return 'Click a corridor to walk · Right-click bug bomb · Esc menu';\n      return 'WASD / Arrows move · Space bug bomb · Esc menu';\n    }\n  }\n  T.Controls = Controls; T.INPUT = base;\n})();\nimport assert from 'node:assert/strict';\nimport { createRequire } from 'node:module';\nconst require = createRequire(import.meta.url);\nrequire('../vendor/engine/my-3d2dge.js');\nfor (const file of ['content', 'sim', 'input']) require('../src/' + file + '.js');\n\nexport function runInputTests() {\n  const E = globalThis.My3D2dge, T = globalThis.TSS, originalNavigator = Object.getOwnPropertyDescriptor(globalThis, 'navigator');\n  let pads = [], count = 0;\n  const failures = [];\n  Object.defineProperty(globalThis, 'navigator', { configurable: true, value: { getGamepads: () => pads } }