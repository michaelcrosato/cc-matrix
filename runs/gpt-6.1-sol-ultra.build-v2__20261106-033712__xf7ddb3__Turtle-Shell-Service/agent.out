(Object.entries(base).map(([k, v]) => [k, v.filter(c => c.startsWith('Pad'))])));\n      } else if (style === 'pads') {\n        I.pad = 0; const q = g.addPlayer({ pad: 1 }); q.pad = 1;\n        q.use(Object.fromEntries(Object.entries(base).map(([k, v]) => [k, v.filter(c => c.startsWith('Pad'))])));\n      }\n      for (const q of g.players) { q.glyphs = g.settings.glyphs; q.names = { bomb: 'Bug bomb', route: 'Click to walk', up: 'Up', right: 'Right', down: 'Down', left: 'Left' }; q.clear(); }\n      this.style = style; this.routes = {}; this.last = {}; this.floor = -1;\n      this.padSeats = {}; this.menuPad = false; this.suppressedBombs = new WeakSet();\n      this.refreshAssignments(true);\n    }\n    heldBomb(input) { return (input.map.bomb || []).some(code => input.held.has(code)); }\n    suppressGameplay() {\n      for (const input of this.game.players) if (this.heldBomb(input)) this.suppressedBombs.add(input);\n    }\n    refreshAssignments(initial = false) {\n      const g = this.game, players = g.players, menu = !!g.shell?.screen || g.paused;\n      if (menu) this.suppressGameplay();\n      let connected = [];\n      try { connected = Array.from(globalThis.navigator?.getGamepads?.() || []).filter(p => p && p.connected !== false && p.mapping === 'standard' && Number.isInteger(p.index) && p.index >= 0).sort((a, b) => a.index - b.index); } catch (_) { /* Keyboard/touch remain available when gamepads are denied. */ }\n      let changed = false;\n      if (this.style === 'pads' || this.style === 'keyboard-pad') {\n        const seats = this.style === 'pads' ? [1, 2] : [2], used = new Set();\n        // Keep every connected seat. A replacement may appear at an entirely new browser index.\n        for (const seat of seats) {\n          const index = this.padSeats[seat];\n          if (connected.some(p => p.index === index) && !used.has(index)) used.add(index);\n          else this.padSeats[seat] = null;\n        }\n        for (const seat of seats) if (this.padSea