cks:0}};\n      if(this.state.floor)this.state.practice=true;\n      this._build(this.state.floor,false);\n    }\n    emit(kind,extra={}){const s=this.state,ev={id:`${s.runId}:${++s.eventSeq}`,kind,floor:s.floor,tick:s.tick,...extra};this.events.push(ev);s.recentEvents.push(ev);if(s.recentEvents.length>48)s.recentEvents.shift();return ev;}\n    _build(index,emit=true){\n      const s=this.state,f=FLOORS[index];this.content=f;this.map=mapFor(f);this.grid=E.Grid.from(this.map);s.floor=index;s.floorTime=0;s.phase='intro';s.phaseTimer=2.4;s.rescued=0;s.bomb=null;s.teamGrace=0;\n      s.homes=f.homes.map((c,i)=>({id:`f${index}h${i}`,cell:c.slice(),...center(c),symbol:SYMBOLS[i],color:HOME_COLORS[i],reservedBy:null,welcoming:0}));\n      const outcomes=Array.from({length:f.rooms.length-1},(_,i)=>i<f.quota-1?'baby':'beetle');\n      for(let i=outcomes.length-1;i>0;i--){const j=Math.floor(nextStream(s.streams,'rooms')*(i+1));[outcomes[i],outcomes[j]]=[outcomes[j],outcomes[i]];}\n      outcomes.unshift('baby');\n      s.rooms=f.rooms.map((c,i)=>({id:`f${index}r${i}`,cell:c.slice(),...center(c),outcome:outcomes[i],revealed:false,discovered:false,delivered:false,carrier:null,symbol:SYMBOLS[i%4],color:HOME_COLORS[i%4],home:null}));\n      s.players=s.seats.map((seat,i)=>this._player(seat,f.spawns[i%f.spawns.length]));\n      s.enemies=f.beetles.map((b,i)=>this._enemy(`f${index}e${i}`,b.cell,b.age||0));\n      s.supply={cell:f.supply.slice(),...center(f.supply),ready:true,cooldown:0};\n      if(emit)this.emit('floor',{index,name:f.name});\n    }\n    _player(seat,c){return{id:`p${seat}`,seat,...center(c),z:0,dir:3,vx:0,vy:0,mover:createMover(c),buffer:-1,bufferTimer:0,carry:null,home:null,invulnerable:2,hurt:0,active:true,bombHeld:false,insideSupply:false,action:'idle',actionTimer:0};}\n    _enemy(id,c,age=0,emerge=0){return{id,...center(c),z:0,dir:1,vx:0,vy:0,mover:createMover(c),age,state:age>=this.state.balance.redAge?'red':age>=this.state.balance.yellowAge?'yellow':'blue',stun:0,emerge,warn:0,alert:0,target:null,lastSeen:null,stunScored:false};}\n    snapshot(){return clone(this.state);}\n    loadSnapshot(s){\n      if(!s||s.version!==1||!FLOORS[s.floor])throw Error('Invalid simulation snapshot');\n      const rebuild=!this.content||this.state?.floor!==s.floor;\n      this.state=clone(s);this.events=[];\n      if(rebuild){this.content=FLOORS[s.floor];this.map=mapFor(this.content);this.grid=E.Grid.from(this.map);}\n      for(const e of [...this.state.players,...this.state.enemies])Object.setPrototypeOf(e.mover,E.GridMover.prototype);\n      return this;\n    }\n    path(from,to){const a=Array.isArray(from)?from:cell(from),b=Array.isArray(to)?to:cell(to);return this.grid.path(a,b);}\n    directionTo(entity,nextCell){const m=entity.mover,a=m.moving?m._to:[m.cx,m.cy],dx=nextCell[0]-a[0],dy=nextCell[1]-a[1];return DIRS.findIndex(d=>d[0]===Math.sign(dx)&&d[1]===Math.sign(dy));}\n    _move(e,dir,dt,speed,keep=true){\n      const m=e.mover;if(!(m instanceof E.GridMover))Object.setPrototypeOf(m,E.GridMover.prototype);\n      const x=e.x,y=e.y;m.speed=speed;\n      // GridMover's centre-to-centre travel is retained. Reverse its current edge in place for immediate reversal.\n      if(dir>=0&&m.moving){const d=DIRS[dir];if(d[0]===-m.dir[0]&&d[1]===-m.dir[1]){const old=[m.cx,m.cy];[m.cx,m.cy]=m._to;m._to=old;m._u=1-m._u;m.dir=d.slice();m._want=null;}}\n      if(dir<0)m._want=null;\n      m.update(dt,this.grid,dir>=0?DIRS[dir]:null,{keep:keep&&dir>=0});\n      e.x=(m.x+.5)*TILE;e.y=(m.y+.5)*TILE;e.vx=(e.x-x)/Math.max(dt,1e-8);e.vy=(e.y-y)/Math.max(dt,1e-8);\n    _dirCells(a,b){return DIRS.findIndex(d=>d[0]===b[0]-a[0]&&d[1]===b[1]-a[1]);}\n    _bomb(p){const s=this.state;if(s.phase!=='play'||p.hurt>0||!p.active)return false;if(s.bomb){this.emit('active',{seat:p.seat,x:p.x,y:p.y});return false;}if(s.stock<=0){this.emit('empty',{seat:p.seat,x:p.x,y:p.y});return false;}if(!this.grid.walk(cell(p)))return false;s.stock--;s.metrics.bombs++;s.bomb={id:`f${s.floor}b${s.metrics.bombs}`,x:p.x,y:p.y,seat:p.seat,life:s.balance.bombLifetime,radius:25};p.action='plant';p.actionTimer=.35;this.emit('bomb',{...s.bomb});return true;}\n    _stun(e){const s=this.state;e.stun=s.balance.stunDuration;e.state='stunned';e.age=0;e.warn=0;e.target=null;e.lastSeen=null;e.vx=e.vy=0;if(!e.stunScored){e.stunScored=true;s.score+=50;this.emit('points',{x:e.x,y:e.y,points:50});}s.metrics.stuns++;this.emit('stun',{enemy:e.id,x:e.x,y:e.y});}\n    _drop(p){const s=this.state;if(p.carry){const r=s.rooms.find(r=>r.id===p.carry);if(r){r.carrier=null;r.home=null;r.revealed=true;}const h=s.homes.find(h=>h.id===p.home);if(h)h.reservedBy=null;p.carry=null;p.home=null;}}\n    _hit(p,e){const s=this.state;if(s.teamGrace>0||p.invulnerable>0||p.hurt>0||s.demo||s.dev.invulnerable||!p.active)return false;this._drop(p);s.lives--;s.metrics.hits++;s.teamGrace=1.25;s.bomb=null;p.hurt=.7;p.action='hurt';p.actionTimer=.7;p.vx=p.vy=0;this.emit('hit',{seat:p.seat,enemy:e.id,x:p.x,y:p.y,lives:s.lives});if(s.lives<=0){s.lives=0;s.phase='lost';s.terminal='lost';s.phaseTimer=0;this.emit('loss',{score:s.score,rescues:s.totalRescued});}return true;}\n    _respawn(p){const s=this.state,auth=this.content.spawns.concat(this.content.homes),live=s.enemies.filter(e=>e.stun<=0&&e.emerge<=0);const safety=c=>live.length?Math.min(...live.map(e=>Math.hypot(center(c).x-e.x,center(c).y-e.y))):1000;let choices=auth.filter(c=>safety(c)>32);if(!choices.length){choices=[];for(let y=0;y<this.grid.h;y++)for(let x=0;x<this.grid.w;x++)if(this.grid.walk([x,y]))choices.push([x,y]);}choices.sort((a,b)=>safety(b)-safety(a)||a[1]-b[1]||a[0]-b[0]);const c=choices[0];Object.assign(p,center(c));p.mover.place(...c);p.buffer=-1;p.bufferTimer=0;p.invulnerable=2.5;p.hurt=0;p.insideSupply=false;p.action='recover';p.actionTimer=.6;this.emit('respawn',{seat:p.seat,x:p.x,y:p.y});}\n    _room(p){\n      if(p.carry||p.hurt>0||!p.active)return;\n      const s=this.state,r=s.rooms.find(r=>!r.delivered&&!r.carrier&&dist(p,r)<5.5&&(!r.revealed||r.outcome==='baby'));\n      if(!r)return;\n      if(r.outcome==='beetle'){\n        r.revealed=true;s.metrics.decoys++;const enemy=this._enemy(`f${s.floor}room${r.id}`,r.cell,0,1.15);s.enemies.push(enemy);this.emit('reveal',{room:r.id,outcome:'beetle',x:r.x,y:r.y,seat:p.seat});return;\n      }\n      const homes=s.homes.filter(h=>h.reservedBy===null&&this.path(r,h).length);\n      homes.sort((a,b)=>this.path(r,b).length-this.path(r,a).length||a.id.localeCompare(b.id));\n      if(!homes.length){this.emit('reservation-failed',{room:r.id,seat:p.seat,x:p.x,y:p.y});return;}\n      const h=homes[0];r.revealed=true;r.carrier=p.seat;r.home=h.id;r.symbol=h.symbol;r.color=h.color;h.reservedBy=p.seat;p.carry=r.id;p.home=h.id;p.action='pickup';p.actionTimer=.65;\n      if(!r.discovered){r.discovered=true;s.score+=100;s.metrics.discoveries++;this.emit('reveal',{room:r.id,outcome:'baby',x:r.x,y:r.y,seat:p.seat,points:100});}\n      this.emit('pickup',{room:r.id,home:h.id,seat:p.seat,x:p.x,y:p.y,symbol:h.symbol,color:h.color});\n    }\n    _delivery(p){\n      if(!p.carry||p.hurt>0||!p.active)return;const s=this.state,h=s.homes.find(h=>h.id===p.home),r=s.rooms.find(r=>r.id===p.carry);\n      if(!h||!r||h.reservedBy!==p.seat||r.carrier!==p.seat||dist(p,h)>5.5)return;\n      r.delivered=true;r.carrier=null;r.home=null;h.reservedBy=null;h.welcoming=1.2;p.carry=null;p.home=null;p.action='deliver';p.actionTimer=.8;s.rescued++;s.totalRescued++;s.metrics.deliveries++;s.score+=400;this.emit('deliver',{seat:p.seat,room:r.id,home:h.id,x:h.x,y:h.y,points:400,rescued:s.rescued,total:s.totalRescued});\n    }\n    _clear(){const s=this.state;s.score+=250+s.floor*50;s.bomb=null;s.phase=s.floor===FLOORS.length-1?'celebrate':'transition';s.phaseTimer=s.phase==='celebrate'?5:2.6;this.emit('clear',{x:s.supply.x,y:s.supply.y,points:250+s.floor*50});if(s.phase==='celebrate')this.emit('evacuate',{rescues:s.totalRescued});}\n    step(dt,intents={}){\n      if(!Number.isFinite(dt)||dt<=0)return;dt=Math.min(dt,.1);const s=this.state;this.events=[];s.tick++;\n      if(s.terminal)return;\n      if(s.phase!=='play'){\n        s.phaseTimer-=dt;const confirm=s.players.some(p=>intents[p.seat]?.confirm);\n        if(s.phase==='intro'&&(s.phaseTimer<=0||confirm)){s.phase='play';s.phaseTimer=0;this.emit('go',{floor:s.floor});}\n        else if(s.phase==='transition'&&(s.phaseTimer<=0||confirm)){this._build(s.floor+1);}\n        else if(s.phase==='celebrate'&&(s.phaseTimer<=0||confirm&&s.phaseTimer<3)){s.phase='won';s.terminal='won';s.phaseTimer=0;this.emit('win',{score:s.score,rescues:s.totalRescued,time:s.time});}\n        return;\n      }\n      s.time+=dt;s.floorTime+=dt;s.teamGrace=Math.max(0,s.teamGrace-dt);\n      for(const h of s.homes)h.welcoming=Math.max(0,h.welcoming-dt);\n    removeSeat(seat){const s=this.state,p=s.players.find(p=>p.seat===seat);if(!p||!p.active)return;this._drop(p);p.active=false;p.vx=p.vy=0;p.bombHeld=false;s.seats=s.seats.filter(v=>v!==seat);this.emit('leave',{seat});}\n    setBalance(k,v){const bounds=BALANCE_LIMITS[k];if(!bounds||!Number.isFinite(+v))return;this.state.balance[k]=clamp(+v,bounds[0],bounds[1]);if(k==='yellowAge')this.state.balance.redAge=Math.max(this.state.balance.redAge,+v+2);if(k==='redAge')this.state.balance.yellowAge=Math.min(this.state.balance.yellowAge,+v-2);this.state.practice=true;return this.state.balance[k];}\n    resetBalance(){this.state.balance={...DEFAULT_BALANCE};return this.state.balance;}\n    dev(action,value){const s=this.state;s.practice=true;switch(action){case'invulnerable':s.dev.invulnerable=value===undefined?!s.dev.invulnerable:!!value;break;case'refill':s.stock=5;break;case'reveal':s.dev.reveal=!s.dev.reveal;break;case'overlays':s.dev.overlays=!s.dev.overlays;break;case'spawn':{const c=this.content.beetles[0].cell;s.enemies.push(this._enemy(`f${s.floor}dev${s.eventSeq}`,c,0,1.2));break;}case'clear':s.enemies=[];break;case'floor':this._build(clamp(Math.round(+value||0),0,FLOORS.length-1));break;case'restart':this._build(s.floor);break;case'timeScale':s.dev.timeScale=clamp(+value||1,.1,3);break;default:return false;}return true;}\n  }\n  Object.assign(T,{Simulation,validateFloor,validateContent:()=>FLOORS.forEach(validateFloor),mapFor,cell,center,sweptDistance});\n})();\n","exit_code":0,"status":"completed"}}
