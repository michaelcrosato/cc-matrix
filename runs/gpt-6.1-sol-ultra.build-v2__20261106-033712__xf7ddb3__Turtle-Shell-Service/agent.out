{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/src/bot.js'\nls 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests'\nhead -30 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/src/art.js'\nrg -n 'f\\\\.tutorial|f\\\\.cue|title|body|lesson|tagline' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/src/content.js' | head -25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/src/bot.js'\nls 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/tests'\nhead -30 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/src/art.js'\nrg -n 'f\\\\.tutorial|f\\\\.cue|title|body|lesson|tagline' 'Turtle-Shell-Service-Turtles-1983-gpt-6.1-sol-ultra-20261106-033712/src/content.js' | head -25\"","aggregated_output":"/* Legal-input caretaker: attract play and deterministic campaign verification. No simulation edits. */\n(() => {\n  'use strict';\n  const T=globalThis.TSS=globalThis.TSS||{},E=globalThis.My3D2dge;\n  class Bot {\n    constructor(sim,o={}){this.sim=sim;this.seats=o.seats||null;this.memory={};this.trace=[];this.visited=new Set();this.confirm=o.confirm!==false;}\n    intents(){\n      const sim=this.sim,s=sim.state,out={},used=new Set();\n      for(const p of s.players){if(this.seats&&!this.seats.includes(p.seat)||!p.active)continue;\n        const m=this.memory[p.seat]||(this.memory[p.seat]={floor:-1,target:null,lastBomb:-100,waiting:0});\n        if(s.floor!==m.floor){m.floor=s.floor;m.target=null;m.waiting=0;}\n        const i={dir:-1,bomb:false,confirm:this.confirm&&s.phase!=='play'};out[p.seat]=i;\n        if(s.phase!=='play'||p.hurt>0)continue;\n        const cur=p.mover.moving?p.mover._to:[p.mover.cx,p.mover.cy];\n        const live=s.enemies.filter(e=>e.stun<=.1&&e.emerge<=.2);\n        const near=live.map(e=>({e,d:Math.hypot(e.x-p.x,e.y-p.y)})).sort((a,b)=>a.d-b.d);\n        const threat=near.find(a=>a.d<31&&sim.map.los(p.x,p.y,a.e.x,a.e.y));\n        const bombNearby=s.bomb&&Math.hypot(s.bomb.x-p.x,s.bomb.y-p.y)<8;\n        if(threat&&!s.bomb&&s.stock>0&&s.tick-m.lastBomb>2){i.bomb=true;m.lastBomb=s.tick;m.retreatUntil=s.time+.65;}\n        // The bomb is a defensive trap. Let an approaching beetle reach it, rather than walking into the beetle.\n        if(threat&&(i.bomb||s.time<(m.retreatUntil||0))){\n          if(p.mover.moving){const d=T.DIRS[p.dir],ahead=(threat.e.x-p.x)*d[0]+(threat.e.y-p.y)*d[1];i.dir=ahead>0?(p.dir+2)%4:p.dir;}\n          else {const ways=sim.grid.neighbours(cur).filter(c=>sim.grid.walk(c));ways.sort((a,b)=>Math.hypot((b[0]+.5)*16-threat.e.x,(b[1]+.5)*16-threat.e.y)-Math.hypot((a[0]+.5)*16-threat.e.x,(a[1]+.5)*16-threat.e.y));if(ways.length)i.dir=sim.directionTo(p,ways[0]);}\n          continue;\n        }\n        let target;\n        if(p.carry)target=s.homes.find(h=>h.id===p.home);\n        else {\n          const rooms=s.rooms.filter(r=>!r.delivered&&!r.carrier&&(!r.revealed||r.outcome==='baby')&&!used.has(r.id));\n          const prev=rooms.find(r=>r.id===m.target);\n          rooms.sort((a,b)=>sim.path(cur,a.cell).length-sim.path(cur,b.cell).length||a.id.localeCompare(b.id));\n          target=prev||rooms[0];\n        }\n        if(s.stock<=1&&s.supply.ready){\n          const homeD=target?sim.path(cur,target.cell).length:1000,supplyD=sim.path(cur,s.supply.cell).length;\n          if(!p.carry||s.stock===0||supplyD<homeD*.75)target={...s.supply,id:'supply'};\n        }\n        if(target?.id==='supply'&&p.insideSupply){\n          const alternatives=sim.grid.neighbours(cur).filter(c=>sim.grid.walk(c));\n          if(alternatives.length)target={cell:alternatives[0],id:'supply-exit'};\n        }\n        if(!target)continue;m.target=target.id;used.add(target.id);\n        const danger=(x,y)=>{\n          let cost=1;\n          for(const e of live){const d=Math.abs((x+.5)*16-e.x)+Math.abs((y+.5)*16-e.y);if(d<18)cost+=24;else if(d<34)cost+=9;else if(d<50)cost+=2;}\n          return cost;\n        };\n        const nav=new E.Grid(sim.grid.w,sim.grid.h,{walkable:(x,y)=>sim.grid.walk([x,y]),cost:danger});\n        let path=nav.path(cur,target.cell);\n        if(path.length>1){i.dir=sim.directionTo(p,path[1]);}\n        else if(path.length===1){\n          // At the goal cell but still in flight: finish the edge. Stops on its centre next step.\n          i.dir=-1;m.target=null;\n        }\n        // If a threat blocks the next corridor and our one team trap is elsewhere, take an open escape edge.\n        if(threat&&!i.bomb&&!bombNearby&&threat.d<22&&(!s.stock||s.bomb)){\n          const ways=sim.grid.neighbours(cur).filter(c=>sim.grid.walk(c));\n          ways.sort((a,b)=>danger(a[0],a[1])-danger(b[0],b[1])||sim.path(a,target.cell).length-sim.path(b,target.cell).length);\n          if(ways.length)i.dir=sim.directionTo(p,ways[0]);\n        }\n      }\n      return out;\n    }\n  }\n  Object.assign(T,{Bot});\n})();\nhub-campaign.test.mjs\nnet.test.mjs\nsim.test.mjs\n/* Turtle Shell Service: original native pixel bodies and miniature hotel scenery. */\n(() => {\n  'use strict';\n  const T = globalThis.TSS ||= {};\n  const E = globalThis.My3D2dge;\n  const { px, clamp } = E;\n  const INK = '#10252a', CREAM = '#fff0cb', GOLD = '#ecc17a';\n  const DIR = [[0,-1],[1,0],[0,1],[-1,0]];\n  const shade = (c, n) => E.shade(c || '#43816b', n);\n  const poly = (g, pts, c) => px.poly(g, pts, c);\n  const text = (g, s, x, y, c, o={}) => E.font.text(g, s, x, y, c, { outline:false, ...o });\n  const P = (x,y,s) => [x*s,y*s];\n\n  function symbol(g, value, x, y, s, color=CREAM) {\n    const name = String(value || 'star').toLowerCase();\n    if (name.includes('heart') || name === '♥') {\n      poly(g, [[-3,-2],[-1,-3],[0,-1],[1,-3],[3,-2],[3,0],[0,3],[-3,0]].map(([a,b])=>[x+a*s,y+b*s]), color);\n    } else if (name.includes('diamond') || name === '◆' || name === '♦') {\n      poly(g, [[x,y-3*s],[x+3*s,y],[x,y+3*s],[x-3*s,y]],color);\n      px.dot(g,x-s,y-s,CREAM);\n    } else if (name === '●' || name === 'circle') {\n      px.disc(g,x,y,2.8*s,color);px.dot(g,x-s,y-s,CREAM);\n    } else if (name.includes('flower') || name.includes('clover') || name === '✿') {\n      for (const [a,b] of [[-1.5,0],[1.5,0],[0,-1.5],[0,1.5]]) px.disc(g,x+a*s,y+b*s,1.7*s,color);\n      px.dot(g,x,y,CREAM);\n    } else if (name.includes('moon') || name === '☾') {\n      px.disc(g,x,y,3*s,color); px.disc(g,x+1.8*s,y-s,2.6*s,INK);\n    } else if (name.includes('sun') || name === '☀' || name === 'circle') {\n      px.disc(g,x,y,2.6*s,color);\n      for(let i=0;i<8;i++) {const a=i*Math.PI/4;px.dot(g,x+Math.cos(a)*4*s,y+Math.sin(a)*4*s,color);}\n25:  function floor(id,name,subtitle,layout,quota,rooms,beetles,supply,palette,decorations,tutorial) {\n26:    return Object.freeze({id,name,subtitle,rows:layouts[layout],quota,rooms,beetles,supply,homes,spawns:[[19,11],[19,10]],palette,decorations,tutorial,layout});\n49:    floor('roof','Rooftop Rendezvous','One last round. Everybody gets home.',2,6,\n","exit_code":0,"status":"completed"}}
