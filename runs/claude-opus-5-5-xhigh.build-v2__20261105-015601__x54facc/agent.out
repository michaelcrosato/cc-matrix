"],\n  [\"const STONE = 60;\\n\", \"const STONE = 60;\\n/** How far a topple on the Centre Stone throws the island, in degrees, and what is left of it each step. */\\nconst LURCH = 3;\\nconst LURCH_SETTLE = 0.98;\\n\"],\n]);\n\n// 3. Step Class: a jump on both feet and a side step on the side notes (sections 3, 6, 11).\nedit('labs/game/scenes/events/step.ts', [\n  [\"  foot: 'L' | 'R';\\n  poseT: number;\", \"  pose: string;\\n  poseT: number;\"],\n  [\"        foot: 'L',\\n\", \"        pose: 'StepUpL',\\n\"],\n  [\"      s.foot = note.kind === 'R' || note.kind === '>' ? 'R' : 'L';\\n\", \"      s.pose = POSE_OF[note.kind];\\n\"],\n  [\"    const kind = s.foot === 'R' ? 'StepUpR' : 'StepUpL';\\n    cast.pose = kind;\\n\", \"    cast.pose = s.pose;\\n\"],\n  [\"const CLASS = ['gerald', 'bex', 'nan'] as const;\\n\", \"const CLASS = ['gerald', 'bex', 'nan'] as const;\\n/** The strip each kind of note scrubs. */\\nconst POSE_OF: Readonly<Record<string, string>> = { L: 'StepUpL', R: 'StepUpR', B: 'Jump', '<': 'SideStepL', '>': 'SideStepR' };\\n\"],\n]);\n\n// 4. Cliff Plunge: lean x twists, scrubbing the Twist strip (sections 6, 11); no foot pills in the air.\nedit('labs/game/scenes/events/plunge.ts', [\n  [\"        cast.yaw = Math.PI + d.twist;\\n        cast.pose = 'Somersault';\\n        cast.poseT = Math.max(0, Math.min(1, d.angle / (4 * Math.PI)));\\n\",\n   \"        // Whichever you lean into more is the strip your thumb scrubs.\\n        const twisting = Math.abs(d.twist) > Math.abs(d.angle);\\n        cast.yaw = Math.PI + (twisting ? 0 : d.twist);\\n        cast.pose = twisting ? 'Twist' : 'Somersault';\\n        cast.poseT = Math.max(0, Math.min(1, Math.abs(twisting ? d.twist : d.angle) / (4 * Math.PI)));\\n\"],\n  [\"      c.hud.disc = false;\\n\", \"      c.hud.disc = false;\\n      c.hud.feet = false;\\n\"],\n]);\nedit('labs/game/ui/hud/widgets.ts', [[\"          'left:50%;bottom:var(--safe);transform:translateX(-50%)',\\n          `${host.glyph('lean')} up and down spins\", \"          'left:50%;top:24vh;transform:translateX(-50%)',\\n          `${host.glyph('lean')} up and down spins\"]]);\n\n// 5. The sea: ripples stay near; a map at a grazing angle goes dark (section 10's brochure horizon).\nedit('labs/game/props/core.ts', [\n  [\"free('prop:sea', 'The sea: one huge flat prop that drifts, so the baked ripples live.', [\\n  box('water', 16000, 0.1, 16000, 'material:seawater'),\\n]);\", \"free('prop:sea', 'The near sea: a flat prop that drifts, so the baked ripples live. Past it the water is plain.', [\\n  box('water', 360, 0.1, 360, 'material:seawater'),\\n]);\"],\n  // 8. Props nothing spawns: the engine warms every registered prop, so they cost boot time for nothing.\n  [\"free('prop:roundGround', 'The lawn round the pavilion, in a session: a big green square, and sand beyond it.', [\\n  box('lawn', 80, 0.1, 80, 'material:lawn', [0, -0.1, 0]),\\n  box('sand', 200, 0.1, 200, 'material:sand', [0, -1, 0]),\\n]);\\n\\n\", \"\"],\n  [\"free('prop:hoop', 'A hoop, flat on its side.', [ring('hoop', 0.46, 0.52, 0.04, 'material:hoop', [0, -0.02, 0])]);\\nfree('prop:hoopAlt', 'A hoop in the other colour.', [ring('hoop', 0.48, 0.54, 0.04, 'material:hoop2', [0, -0.02, 0])]);\\nfree('prop:tileL', 'A floor tile that lights for the left foot.', [box('tile', 0.8, 0.02, 0.8, 'material:tileLit')]);\\nfree('prop:tileR', 'A floor tile that lights for the right foot.', [box('tile', 0.8, 0.02, 0.8, 'material:ringGlow')]);\\nfree('prop:tile', 'A floor tile, unlit.', [box('tile', 0.8, 0.02, 0.8, 'material:mintDeep')]);\\n\", \"\"],\n]);\nlet activities = readFileSync('labs/game/props/activities.ts', 'utf8');\nconst short = activities.split('\\n').filter((l) => l.startsWith(\"free('prop:ridgeShort'\"));\nif (short.length !== 1 || !short[0].endsWith(');')) throw new Error('ridgeShort is not one whole line: ' + short[0]);\nwriteFileSync('labs/game/props/activities.ts', activities.replace(short[0] + '\\n', ''));\nconsole.log('ok ridgeShort');\nedit('labs/game/sounds/effects.ts', [[\"fx('rankUp', [{ wave: 'triangle', freq: 'C5', dur: 0.1, vol: 0.2, arp: [0, 4, 7, 12], step: 0.07 }]);\\n\", \"\"]]);\nlet at = readFileSync('labs/game/scenes/audio.test.ts', 'utf8');\nif ((at.match(/^\\s*'rankUp',\\n/gm) || []).length !== 1) throw new Error('rankUp in test');\nwriteFileSync('labs/game/scenes/audio.test.ts', at.replace(/^\\s*'rankUp',\\n/m, ''));\nconsole.log('ok audio.test');\n\n// 9. Calm softens the sound and warms the picture (section 3).\nedit('labs/game/audio/sound.ts', [\n  [\"  volumes: Volumes = { music: 0.1, effects: 1, voices: 1 };\\n\", \"  volumes: Volumes = { music: 0.1, effects: 1, voices: 1 };\\n  private calm = 0;\\n\"],\n  [\"    this.volumes = v;\\n    this.audio.volume('music', v.music);\\n    this.audio.volume('effects', v.effects);\\n    this.audio.volume('ambience', v.effects);\\n\",\n   \"    this.volumes = v;\\n    this.audio.volume('music', v.music);\\n    // Calm softens the world's sound, never the music or the voices you need.\\n    const soft = 1 - 0.3 * this.calm;\\n    this.audio.volume('effects', v.effects * soft);\\n    this.audio.volume('ambience', v.effects * soft);\\n\"],\n  [\"  /** Plays an effect. */\\n\", \"  /** How calm the player is, 0 to 1: it softens the sound. */\\n  setCalm(calm: number): void {\\n    this.calm = calm;\\n    this.setVolumes(this.volumes);\\n  }\\n\\n  /** Plays an effect. */\\n\"],\n]);\nedit('labs/game/ui/frame.ts', [\n  [\"/** The song and ambience. */\\n\", \"/** Good breathing warms the picture slightly and softens the sound (PLAN.md section 3): in steps, so settings change rarely. */\\nexport function updateCalm(app: App, flow: Flow, seat: { wobble: Wobble } | undefined): void {\\n  const calm = flow.mode === 'event' && seat ? Math.round(seat.wobble.calm * 4) / 4 : 0;\\n  if (calm === app.calmStep) return;\\n  app.calmStep = calm;\\n  app.engine.inspector?.set('post.filters', calm > 0 ? { grade: { temperature: calm * 0.12 } } : {});\\n  app.sound.setCalm(calm);\\n}\\n\\n/** The song and ambience. */\\n\"],\n]);\nEOF\nnode out/patch1.mjs; echo \"--- what may now be dead\"; grep -n \"material:hoop\\b\\|material:hoop2\\|material:tileLit\\|material:mintDeep\\|material:ringGlow\" -r labs/game --include=*.ts | grep -v \"materials/retreat\" | cut -c1-110 | head; echo \"--- temperature\"; grep -n \"temperature\" engine/gfx/post/filterFields*.ts engine/gfx/post/filters.ts | cut -c1-170 | head -4; echo \"--- whole test ringTest\"; grep -n \"ringTest\" labs/game/scenes/whole.test.ts | head -2; sed -n \"$(grep -n 'const ringTest\\|function ringTest\\|ringTest = ' labs/game/scenes/whole.test.ts | head -1 | cut -d: -f1),+18p\" labs/game/scenes/whole.test.ts | cut -c1-120; sed -n 22,50p labs/game/scenes/whole.test.ts | cut -c1-110; grep -n \"Wobble\\b\" labs/game/ui/frame.ts | head -2; sed -n 44,56p labs/game/ui/app.ts | cut -c1-70; sed -n 72,86p labs/game/ui/appInput.ts | cut -c1-90","description":"Apply fixes with asserted matches; read test helpers","timeout":30000}}}
