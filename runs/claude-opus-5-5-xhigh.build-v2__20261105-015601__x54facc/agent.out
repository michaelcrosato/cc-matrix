c1-140; awk '/function change/,/^}/' engine/sim/actorClips.ts | cut -c1-140; sed -n 1,30p engine/gfx/puppets/grammar.ts | cut -c1-170; grep -n \"ACTOR_BODY\" engine/gfx/puppets/*.ts | head -4; f=$(grep -ln \"defineBody('body:mannequin\\|export const NEUTRAL\\|body:humanoid\" -r engine/gfx/puppets | head -1); echo $f; grep -n \"defineBody(\" -r engine/gfx/puppets/*.ts | head; node x describe body 2>&1 | cut -c1-140 | head -12; node x describe build 2>&1 | cut -c1-140 | head -30; node x describe look 2>&1 | head -6 | cut -c1-300;","description":"Read clips spec, body grammar and registries"}}}
