terface ActorSpec/,/^}/' $(grep -ln \"export interface ActorSpec\" -r engine --include=*.ts); awk '/export function spawnProp/,/^}/' $(grep -ln \"export function spawnProp\" -r engine --include=*.ts) | head -80; grep -n \"SpawnPropOptions\" -r engine --include=*.ts | head -5; awk '/export interface SpawnPropOptions/,/^}/' $(grep -ln \"export interface SpawnPropOptions\" -r engine --include=*.ts); awk '/export interface EngineOptions/,/^}/' $(grep -ln \"export interface EngineOptions\" -r engine --include=*.ts); awk '/export interface EngineFrame/,/^}/' $(grep -ln \"export interface EngineFrame\" -r engine --include=*.ts); awk '/export interface Engine /,/^}/' $(grep -ln \"export interface Engine \" -r engine --include=*.ts)","description":"Read actor, prop and engine option types"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019zGs7edMBaZXCDUAN3gfuq","type":"tool_result","content":"engine/sim/actors.ts:195:export interface ActorSpec {\nactorActions.ts\nactorAnim.ts\nactorClips.ts\nactorInput.ts\nactors.ts\nbreakables.ts\ncapture.ts\ncombatApi.ts\ncrowdBodies.ts\ndamage.ts\ndevActions.ts\ndoors.ts\nentities.ts\nentityTable.ts\nfeelCourse.ts\nhits.ts\nhouseApi.ts\ninteract.ts\nkitsApi.ts\nlevelBodies.ts\nlights.ts\nmelee.ts\nmovementApi.ts\npropBlocks.ts\nprops.ts\nqueryView.ts\nragdolls.ts\nreactions.ts\nreplay.ts\nrides.ts\nscene.ts\nsession.ts\nsiteApi.ts\nstate.ts\nswitches.ts\nsystems.ts\nthings.ts\nweapons.ts\nworld.ts\nexport interface ActorSpec {\n  /** Where its feet go: on the ground below them (it starts just above, outside the skin). */\n  at: Vec3Like;\n  /** Its settings (createCharacter). */\n  character: Character;\n  /** Whether it reads the step's intents (true); false: its AI writes `actor.intents`. */\n  player?: boolean;\n  /** Where it faces (rad; forward = (sin yaw, 0, cos yaw)). */\n  yaw?: number;\n  /** Its character animator's make (engine/anim/character.ts); none when absent. */\n  anim?: Pick<AnimatorOptions, 'build' | 'weapon' | 'preciseHits'>;\n  /** The body it is drawn as (`body:mannequin`), with `anim`; the neutral humanoid when absent. */\n  body?: string;\n  /** With `anim`, the clip layer in its animator, playing from these sets (engine/sim/actorClips.ts); none when absent. */\n  clips?: ClipsSpec;\n  /** With a movement model, whether it starts with no weapon out (true: the model's holstered speeds). */\n  holstered?: boolean;\n  /**\n   * Further components it spawns with, by name (its `reactions`, its `secondary`: engine/sim/reactions.ts), so they\n   * are there from its first step, and a page's first warm-up builds what they draw.\n   */\n  components?: Readonly<Record<string, object>>;\n}\nexport function spawnProp<C extends object, E extends EventMap>(\n  world: World<C, E>,\n  placement: PropPlacement,\n  options: SpawnPropOptions = {},\n): number {\n  const w = world as unknown as World;\n  const entry = getProp(placement.prop);\n  const prop = entry.id;\n  const spec = propBody({ ...placement, prop }, undefined, options.as);\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\n  const [x, y, z] = position;\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\n  const switchable = options.on !== undefined || options.group !== undefined;\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\n}\nengine/sim/props.ts:10: * Its `options` (WP 13.16, `SpawnPropOptions`): its body's type, its light (the component `propLight`, which the view\nengine/sim/props.ts:97:export interface SpawnPropOptions {\nengine/sim/props.ts:155:  options: SpawnPropOptions = {},\nengine/sim/houseApi.ts:32:export type { SpawnPropOptions } from './props';\nexport interface SpawnPropOptions {\n  /** Its body's type instead of its prop's: a broken door's leaf falls (`'dynamic'`). */\n  as?: 'dynamic' | 'fixed' | 'kinematic';\n  /** Whether it is on at first, and its light group: either makes it switchable (`propLight`). */\n  on?: boolean;\n  group?: string;\n  /** More components its entity holds from the start (a door's `door`, a switch's `switch`). */\n  components?: Readonly<Record<string, object>>;\n  /** Its body knocked away from `from` as it is made (a broken prop's pieces: engine/physics/bodies.ts's `knock`). */\n  knock?: PropKnock & { from: readonly [number, number, number] };\n}\nexport interface EngineOptions {\n  /** The canvas it draws into; the page sizes it with CSS. */\n  canvas: HTMLCanvasElement;\n  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\n  scenes: readonly string[];\n  /**\n   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n   * entry's `materials`); registered unless already.\n   */\n  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\n  replays?: Readonly<Record<string, () => Promise<string>>>;\n  /** The query to read (`location.search`). */\n  search?: string;\n  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\n  hash?: string;\n  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n  registry?: Registry;\n  /** Where errors and advice go (the shared log). */\n  log?: Log;\n  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\n  touchLayout?: string;\n  /**\n   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\n   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\n   */\n  actionMap?: string | ((camera: string) => string);\n  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\n  onView?: (action: string) => void;\n  /** Opens the page's menu, called after the touch menu button has paused the game. */\n  onMenu?: () => void;\n  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\n  onFrame?: (frame: EngineFrame) => void;\n  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\n  store?: Store;\n  /** True while the page's front end holds the devices (a menu, a photo mode): no intent reaches the run. */\n  modal?: () => boolean;\n  /** Camera input laid over the devices' each drawn frame, field by field (a photo mode's fly keys and drag look). */\n  cameraInput?: () => CameraInput | undefined;\n}\nexport interface EngineFrame {\n  /** The run's world: the same object until the run starts again (a new seed, a replay), so a reader compares it. */\n  readonly world: FrameWorld;\n  /** The running scene: its id, its level and whether it has physics. */\n  readonly scene: Scene;\n  /** The camera's pose this frame: where a listener goes. */\n  readonly camera: CameraPose;\n  /** The sim's physics queries, read-only, in a physics scene; null without physics. */\n  readonly queries: QueryView | null;\n  /** Real seconds since the last frame. */\n  readonly dt: number;\n  /** The value setting `key` has now, view settings among them (`x set`, `__engine.set`, the URL). */\n  setting(key: string): unknown;\n  /**\n   * Runs emitter `id` at its rate times `scale` (1) at `at` (m) for the next frame, `key` naming it so its fractions\n   * and light carry over: rain over the player, a fire in a hearth (engine/gfx/fx/effects.ts `emit`). An emitter that\n   * says `gpu` has its particles on the GPU's ring where `feature:gpuParticles` is on (WP 11.3). Presentation only.\n   */\n  emit(id: string, at: readonly [number, number, number], key: string, scale?: number): void;\n}\nexport interface Engine {\n  /** The inspector, also `window.__engine`; null when the scene could not start. */\n  readonly inspector: Inspector | null;\n  /** True once the first frame is drawn; never after a startup error. */\n  readonly ready: boolean;\n  /** What the query asked for; null when it could not be read. */\n  readonly routes: Routes | null;\n  /** The game's HTML/CSS overlay over the canvas (engine/ui/overlay.ts); null until the renderer started. */\n  readonly ui: Overlay | null;\n  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\n  readonly input: Input | null;\n  /** Stops the frame loop. */\n  stop(): void;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"9f6ec6c5-f4c9-4e29-8c25-cdd4a2b767f2","timestamp":"2026-11-05T08:57:39.466Z","tool_use_result":{"stdout":"engine/sim/actors.ts:195:export interface ActorSpec {\nactorActions.ts\nactorAnim.ts\nactorClips.ts\nactorInput.ts\nactors.ts\nbreakables.ts\ncapture.ts\ncombatApi.ts\ncrowdBodies.ts\ndamage.ts\ndevActions.ts\ndoors.ts\nentities.ts\nentityTable.ts\nfeelCourse.ts\nhits.ts\nhouseApi.ts\ninteract.ts\nkitsApi.ts\nlevelBodies.ts\nlights.ts\nmelee.ts\nmovementApi.ts\npropBlocks.ts\nprops.ts\nqueryView.ts\nragdolls.ts\nreactions.ts\nreplay.ts\nrides.ts\nscene.ts\nsession.ts\nsiteApi.ts\nstate.ts\nswitches.ts\nsystems.ts\nthings.ts\nweapons.ts\nworld.ts\nexport interface ActorSpec {\n  /** Where its feet go: on the ground below them (it starts just above, outside the skin). */\n  at: Vec3Like;\n  /** Its settings (createCharacter). */\n  character: Character;\n  /** Whether it reads the step's intents (true); false: its AI writes `actor.intents`. */\n  player?: boolean;\n  /** Where it faces (rad; forward = (sin yaw, 0, cos yaw)). */\n  yaw?: number;\n  /** Its character animator's make (engine/anim/character.ts); none when absent. */\n  anim?: Pick<AnimatorOptions, 'build' | 'weapon' | 'preciseHits'>;\n  /** The body it is drawn as (`body:mannequin`), with `anim`; the neutral humanoid when absent. */\n  body?: string;\n  /** With `anim`, the clip layer in its animator, playing from these sets (engine/sim/actorClips.ts); none when absent. */\n  clips?: ClipsSpec;\n  /** With a movement model, whether it starts with no weapon out (true: the model's holstered speeds). */\n  holstered?: boolean;\n  /**\n   * Further components it spawns with, by name (its `reactions`, its `secondary`: engine/sim/reactions.ts), so they\n   * are there from its first step, and a page's first warm-up builds what they draw.\n   */\n  components?: Readonly<Record<string, object>>;\n}\nexport function spawnProp<C extends object, E extends EventMap>(\n  world: World<C, E>,\n  placement: PropPlacement,\n  options: SpawnPropOptions = {},\n): number {\n  const w = world as unknown as World;\n  const entry = getProp(placement.prop);\n  const prop = entry.id;\n  const spec = propBody({ ...placement, prop }, undefined, options.as);\n  const { position, rotation } = spec ?? propPose({ ...placement, prop });\n  const body = spec ? physicsOf(w).addBody(spec) : -1;\n  if (options.knock && body >= 0) knock(physicsOf(w), body, [...options.knock.from], options.knock);\n  if (spec && !w.systems.has('props.readback')) w.systems.add('props.readback', readProps, { phase: 'readback' });\n  const [x, y, z] = position;\n  const health = entry.health > 0 ? { propHealth: { hp: entry.health } } : {};\n  const switchable = options.on !== undefined || options.group !== undefined;\n  const light = switchable ? { propLight: { on: options.on ?? true, group: options.group ?? '' } } : {};\n  return w.spawn({ ...options.components, sceneProp: { prop, body, x, y, z, q: rotation }, ...health, ...light });\n}\nengine/sim/props.ts:10: * Its `options` (WP 13.16, `SpawnPropOptions`): its body's type, its light (the component `propLight`, which the view\nengine/sim/props.ts:97:export interface SpawnPropOptions {\nengine/sim/props.ts:155:  options: SpawnPropOptions = {},\nengine/sim/houseApi.ts:32:export type { SpawnPropOptions } from './props';\nexport interface SpawnPropOptions {\n  /** Its body's type instead of its prop's: a broken door's leaf falls (`'dynamic'`). */\n  as?: 'dynamic' | 'fixed' | 'kinematic';\n  /** Whether it is on at first, and its light group: either makes it switchable (`propLight`). */\n  on?: boolean;\n  group?: string;\n  /** More components its entity holds from the start (a door's `door`, a switch's `switch`). */\n  components?: Readonly<Record<string, object>>;\n  /** Its body knocked away from `from` as it is made (a broken prop's pieces: engine/physics/bodies.ts's `knock`). */\n  knock?: PropKnock & { from: readonly [number, number, number] };\n}\nexport interface EngineOptions {\n  /** The canvas it draws into; the page sizes it with CSS. */\n  canvas: HTMLCanvasElement;\n  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\n  scenes: readonly string[];\n  /**\n   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n   * entry's `materials`); registered unless already.\n   */\n  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\n  replays?: Readonly<Record<string, () => Promise<string>>>;\n  /** The query to read (`location.search`). */\n  search?: string;\n  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\n  hash?: string;\n  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n  registry?: Registry;\n  /** Where errors and advice go (the shared log). */\n  log?: Log;\n  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\n  touchLayout?: string;\n  /**\n   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\n   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\n   */\n  actionMap?: string | ((camera: string) => string);\n  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\n  onView?: (action: string) => void;\n  /** Opens the page's menu, called after the touch menu button has paused the game. */\n  onMenu?: () => void;\n  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\n  onFrame?: (frame: EngineFrame) => void;\n  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\n  store?: Store;\n  /** True while the page's front end holds the devices (a menu, a photo mode): no intent reaches the run. */\n  modal?: () => boolean;\n  /** Camera input laid over the devices' each drawn frame, field by field (a photo mode's fly keys and drag look). */\n  cameraInput?: () => CameraInput | undefined;\n}\nexport interface EngineFrame {\n  /** The run's world: the same object until the run starts again (a new seed, a replay), so a reader compares it. */\n  readonly world: FrameWorld;\n  /** The running scene: its id, its level and whether it has physics. */\n  readonly scene: Scene;\n  /** The camera's pose this frame: where a listener goes. */\n  readonly camera: CameraPose;\n  /** The sim's physics queries, read-only, in a physics scene; null without physics. */\n  readonly queries: QueryView | null;\n  /** Real seconds since the last frame. */\n  readonly dt: number;\n  /** The value setting `key` has now, view settings among them (`x set`, `__engine.set`, the URL). */\n  setting(key: string): unknown;\n  /**\n   * Runs emitter `id` at its rate times `scale` (1) at `at` (m) for the next frame, `key` naming it so its fractions\n   * and light carry over: rain over the player, a fire in a hearth (engine/gfx/fx/effects.ts `emit`). An emitter that\n   * says `gpu` has its particles on the GPU's ring where `feature:gpuParticles` is on (WP 11.3). Presentation only.\n   */\n  emit(id: string, at: readonly [number, number, number], key: string, scale?: number): void;\n}\nexport interface Engine {\n  /** The inspector, also `window.__engine`; null when the scene could not start. */\n  readonly inspector: Inspector | null;\n  /** True once the first frame is drawn; never after a startup error. */\n  readonly ready: boolean;\n  /** What the query asked for; null when it could not be read. */\n  readonly routes: Routes | null;\n  /** The game's HTML/CSS overlay over the canvas (engine/ui/overlay.ts); null until the renderer started. */\n  readonly ui: Overlay | null;\n  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\n  readonly input: Input | null;\n  /** Stops the frame loop. */\n  stop(): void;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019zGs7edMBaZXCDUAN3gfuq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjWBepkS69TWSiaKe5U9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019NEgHFyRjYVepaJKc1gKj6","name":"Bash","input":{"command":"cat labs/box/scenes/clips.ts | sed -n 1,140p; f=$(grep -ln \"export interface Inspector\" -r engine --include=*.ts); echo $f; awk '/export interface Inspector/,/^}/' $f | cut -c1-170 | grep -v \"^\\s*\\*\\|/\\*\\*.*\\*/$\" | head -100","description":"Read the clip scene example and the Inspector API"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8801,"cache_read_input_tokens":129245,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8801},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"f584b4e7-7414-498f-ae8f-e32b662c9edf","timestamp":"2026-11-05T08:57:40.611Z","request_id":"req_011CgjWBeZsVqZVfp2MYMFqx","wire_tool_inputs":{"toolu_019NEgHFyRjYVepaJKc1gKj6":{"command":"cat labs/box/scenes/clips.ts | sed -n 1,140p; f=$(grep -ln \"export interface Inspector\" -r engine --include=*.ts); echo $f; awk '/export interface Inspector/,/^}/' $f | cut -c1-170 | grep -v \"^\\s*\\*\\|/\\*\\*.*\\*/$\" | head -100","description":"Read the clip scene example and the Inspector API"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019NEgHFyRjYVepaJKc1gKj6","type":"tool_result","content":"/**\n * @file Clip mode, the animation library in the box (PLAN.md §10, WP 8.9; the Mocap Lab's clip mode,\n * `my-3d2dge:src/mocap.game.js`): the room (labs/box/levels/room.txt) as a physics level, the hero at its spawn and the\n * mannequin beside him, both playing a clip of the library through the clip layer in their animators (engine/sim\n * actorClips.ts), over the procedural rig. The mannequin is the figure the Quaternius clips were measured on\n * (`body:mannequin` on `build:mannequin`); the hero plays the clip retargeted to his build, and stays the player: he\n * walks under it (`box.clips.mask=upper` keeps his legs' own walk).\n *\n * Settings (`box.clips.*`, read every step, so a change plays at once and goes in replays): the clip, named\n * `<set>/<clip>` as `node x anim show` and `node x anim find` name it (a change crossfades to it from the pose on\n * screen); its rate; frame stepping (`box.clips.frame`, a frame of its bake at 30 a second, as `x anim bake` counts\n * them, held; -1 plays); the mirror and the mask. A one-shot holds its end 0.8 s, then plays again, as the Lab's did.\n * When the scene starts: who plays (`box.clips.cast`) and contact IK (`box.clips.ik`).\n *\n * The library's sets come from the registry (`defineClipSet`, the kind `clipset`): the box page registers every set\n * under data/anim/sets/ before it opens this scene (labs/box/main.ts), and so do tests/pages/replay.ts and the Node\n * hosts, `x sim`, `x replay` and tests (tools/anim/library.ts `defineLibrary`). Without them the setup fails with\n * `CORE_NO_ENTRY`, naming `defineClipSet`. Clips that travel play in place (their root motion is the layer's `root`,\n * which a game moves the body by). Its machine interface: `node x anim show <set>/<clip>` prints the clip this plays,\n * `__engine.describe('clipset')` and `node x describe clipset` list the sets, and the inspector shows each figure's\n * component `clips` (what plays, its time and weight) and its animator's layers (`__engine.anim(id)`).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts and the box's own files.\n *\n * Tests: labs/box/scenes/clips.test.ts (every clip on the mannequin headless; `x anim show` and the setting select the\n * same clip, frame for frame; tests/replays/box-8-clips.replay.json's goldens), tests/e2e/box-clips.spec.ts (one clip\n * of each set in the page; `BOX_CLIPS=all` plays them all, a long run), tests/e2e/parity.spec.ts (the replay's\n * goldens while the page renders; live play replayed in Node).\n *\n * @example\n * // labs/box/?scene=clips&box.clips.clip=cmu/Cartwheel&cam=threequarter\n * // __engine.set('box.clips.clip', 'style100/Old_Walk'); __engine.set('box.clips.frame', 12)\n * // node x set box.clips.clip quaternius/Sword_Attack (in an x inspect session)\n * CLIPS_START; // [3.5, 0, 2.5]: the hero's spawn in the room; the mannequin stands 1.5 m east of him\n */\nimport {\n  addLevelBodies,\n  BAKE_FPS,\n  clipLayerOf,\n  clipSetIds,\n  createCharacter,\n  defineComponent,\n  defineScene,\n  defineSetBuild,\n  defineSettings,\n  getClipSet,\n  physicsOf,\n  playClip,\n  seekClip,\n  spawnActor,\n  type ClipPlay,\n  type World,\n} from '../../../engine/sim-api';\nimport { HERO_BODY, heroCharacter } from '../cast/hero';\nimport { ROOM_HERO_LEVEL } from './room-hero';\nimport { boxSounds } from '../sounds/events';\n\n/** The scene's settings (see the file comment). */\nexport const CLIPS_SETTINGS = defineSettings({\n  'box.clips.clip': {\n    type: 'string',\n    default: 'quaternius/Dance_Loop',\n    description:\n      'The clip the figures play, <set>/<clip> as node x anim show names it (node x anim find lists them): a change crossfades to it.',\n  },\n  'box.clips.speed': {\n    type: 'number',\n    default: 1,\n    minimum: 0,\n    maximum: 2,\n    description: 'The rate it plays at: 1 as captured, 0.5 at half speed, 0 holds it.',\n  },\n  'box.clips.frame': {\n    type: 'integer',\n    default: -1,\n    minimum: -1,\n    maximum: 100_000,\n    description:\n      'Frame stepping: the frame of its bake held (from 0, 30 a second, as x anim bake counts them); -1 plays.',\n  },\n  'box.clips.mirror': {\n    type: 'boolean',\n    default: false,\n    description: 'Whether it plays mirrored, left and right swapped.',\n  },\n  'box.clips.mask': {\n    type: 'string',\n    enum: ['full', 'upper'],\n    default: 'full',\n    description: 'The joints it plays: the whole body, or the upper body over the legs’ own walk.',\n  },\n  'box.clips.cast': {\n    type: 'string',\n    enum: ['both', 'mannequin', 'hero'],\n    default: 'both',\n    when: 'scene',\n    description: 'Who plays it: the mannequin (the figure the Quaternius clips were measured on), the hero, or both.',\n  },\n  'box.clips.ik': {\n    type: 'boolean',\n    default: true,\n    when: 'scene',\n    description: 'Whether the figures plant their feet and lift their bodies over the floor (contact IK).',\n  },\n});\n\n/** Clip mode's own state: how long the one-shot playing has held its end, in steps. */\nexport const CLIPS_MODE = defineComponent('clipsMode', {\n  description: 'The box’s clip mode (labs/box/scenes/clips.ts): how long the one-shot playing has held its end.',\n  fields: { held: { type: 'integer', default: 0, minimum: 0, description: 'Steps the one-shot has held its end.' } },\n});\n\n/** Where the hero starts: the room's spawn `@`, as in the room with a hero. */\nexport const CLIPS_START = ROOM_HERO_LEVEL.spawns.find((spawn) => spawn.name === 'hero')!.position;\n/** How far east of him the mannequin stands, m. */\nconst BESIDE = 1.5;\n/** How long a one-shot holds its end before it plays again, s (the Lab's). */\nconst HOLD = 0.8;\n/** The crossfade to a new clip, s (the Lab's). */\nconst FADE = 0.18;\n\n/** The play the settings ask of a clip that loops (`loop`) or not. */\nfunction wantedPlay(w: World, loop: boolean): ClipPlay {\n  const frame = w.settings.get<number>('box.clips.frame');\n  const mask = w.settings.get<'full' | 'upper'>('box.clips.mask');\n  return {\n    speed: frame >= 0 ? 0 : w.settings.get<number>('box.clips.speed'),\n    mirror: w.settings.get<boolean>('box.clips.mirror'),\n    mask,\n    walk: true,\n    hold: !loop,\n    fade: FADE,\n  };\n}\n\n/** Whether two plays differ in what the settings set. */\nconst differs = (a: ClipPlay, b: ClipPlay) =>\n  a.speed !== b.speed || a.mirror !== b.mirror || a.mask !== b.mask || a.hold !== b.hold;\n\n/** The clip the figures start with, as the settings ask, faded in and at its frame: `SET/Clip` resolved at the step. */\nengine/dev/members.ts engine/dev/inspector.ts\nexport interface InspectorHost {\n  readonly registry: Registry;\n  readonly members: Registry;\n  readonly log: Log;\n  readonly clock: Clock;\n  readonly session: RecordedRun;\n  readonly runtime: string;\n  readonly renderer: boolean;\n  readonly adapter: Readonly<Record<string, unknown>> | null;\n  readonly features: readonly string[];\n  readonly downgrades: readonly string[];\n  step(n: number, intents: unknown): void;\n  restart(seed: number): void;\n}\nexport interface Inspector {\n  info(): EngineInfo;\n  pause(): void;\n  resume(): void;\n  step(n?: number, intents?: Intents | readonly Intents[]): number;\n  timeScale(k?: number): number;\n  seed(n?: number): number;\n  state(query?: string | readonly string[]): WorldState;\n  hash(): string;\n  trace(): WorldTrace;\n  entities(query?: string | readonly string[]): EntitySummary[];\n  get(id: number): EntityData | null;\n  set(path: string, value: unknown): SettingChange;\n  capture(): WorldCapture;\n  restore(capture: WorldCapture): void;\n  describe(kind?: string, id?: string): unknown;\n  help(member?: string): string;\n  readonly errors: readonly ErrorRecord[];\n  readonly advice: readonly AdviceRecord[];\n  [member: string]: unknown;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"fa817fa0-8e40-4fca-bab2-d5ca349d3397","timestamp":"2026-11-05T08:57:40.691Z","tool_use_result":{"stdout":"/**\n * @file Clip mode, the animation library in the box (PLAN.md §10, WP 8.9; the Mocap Lab's clip mode,\n * `my-3d2dge:src/mocap.game.js`): the room (labs/box/levels/room.txt) as a physics level, the hero at its spawn and the\n * mannequin beside him, both playing a clip of the library through the clip layer in their animators (engine/sim\n * actorClips.ts), over the procedural rig. The mannequin is the figure the Quaternius clips were measured on\n * (`body:mannequin` on `build:mannequin`); the hero plays the clip retargeted to his build, and stays the player: he\n * walks under it (`box.clips.mask=upper` keeps his legs' own walk).\n *\n * Settings (`box.clips.*`, read every step, so a change plays at once and goes in replays): the clip, named\n * `<set>/<clip>` as `node x anim show` and `node x anim find` name it (a change crossfades to it from the pose on\n * screen); its rate; frame stepping (`box.clips.frame`, a frame of its bake at 30 a second, as `x anim bake` counts\n * them, held; -1 plays); the mirror and the mask. A one-shot holds its end 0.8 s, then plays again, as the Lab's did.\n * When the scene starts: who plays (`box.clips.cast`) and contact IK (`box.clips.ik`).\n *\n * The library's sets come from the registry (`defineClipSet`, the kind `clipset`): the box page registers every set\n * under data/anim/sets/ before it opens this scene (labs/box/main.ts), and so do tests/pages/replay.ts and the Node\n * hosts, `x sim`, `x replay` and tests (tools/anim/library.ts `defineLibrary`). Without them the setup fails with\n * `CORE_NO_ENTRY`, naming `defineClipSet`. Clips that travel play in place (their root motion is the layer's `root`,\n * which a game moves the body by). Its machine interface: `node x anim show <set>/<clip>` prints the clip this plays,\n * `__engine.describe('clipset')` and `node x describe clipset` list the sets, and the inspector shows each figure's\n * component `clips` (what plays, its time and weight) and its animator's layers (`__engine.anim(id)`).\n *\n * Game code, sim-side: it imports only engine/sim-api.ts and the box's own files.\n *\n * Tests: labs/box/scenes/clips.test.ts (every clip on the mannequin headless; `x anim show` and the setting select the\n * same clip, frame for frame; tests/replays/box-8-clips.replay.json's goldens), tests/e2e/box-clips.spec.ts (one clip\n * of each set in the page; `BOX_CLIPS=all` plays them all, a long run), tests/e2e/parity.spec.ts (the replay's\n * goldens while the page renders; live play replayed in Node).\n *\n * @example\n * // labs/box/?scene=clips&box.clips.clip=cmu/Cartwheel&cam=threequarter\n * // __engine.set('box.clips.clip', 'style100/Old_Walk'); __engine.set('box.clips.frame', 12)\n * // node x set box.clips.clip quaternius/Sword_Attack (in an x inspect session)\n * CLIPS_START; // [3.5, 0, 2.5]: the hero's spawn in the room; the mannequin stands 1.5 m east of him\n */\nimport {\n  addLevelBodies,\n  BAKE_FPS,\n  clipLayerOf,\n  clipSetIds,\n  createCharacter,\n  defineComponent,\n  defineScene,\n  defineSetBuild,\n  defineSettings,\n  getClipSet,\n  physicsOf,\n  playClip,\n  seekClip,\n  spawnActor,\n  type ClipPlay,\n  type World,\n} from '../../../engine/sim-api';\nimport { HERO_BODY, heroCharacter } from '../cast/hero';\nimport { ROOM_HERO_LEVEL } from './room-hero';\nimport { boxSounds } from '../sounds/events';\n\n/** The scene's settings (see the file comment). */\nexport const CLIPS_SETTINGS = defineSettings({\n  'box.clips.clip': {\n    type: 'string',\n    default: 'quaternius/Dance_Loop',\n    description:\n      'The clip the figures play, <set>/<clip> as node x anim show names it (node x anim find lists them): a change crossfades to it.',\n  },\n  'box.clips.speed': {\n    type: 'number',\n    default: 1,\n    minimum: 0,\n    maximum: 2,\n    description: 'The rate it plays at: 1 as captured, 0.5 at half speed, 0 holds it.',\n  },\n  'box.clips.frame': {\n    type: 'integer',\n    default: -1,\n    minimum: -1,\n    maximum: 100_000,\n    description:\n      'Frame stepping: the frame of its bake held (from 0, 30 a second, as x anim bake counts them); -1 plays.',\n  },\n  'box.clips.mirror': {\n    type: 'boolean',\n    default: false,\n    description: 'Whether it plays mirrored, left and right swapped.',\n  },\n  'box.clips.mask': {\n    type: 'string',\n    enum: ['full', 'upper'],\n    default: 'full',\n    description: 'The joints it plays: the whole body, or the upper body over the legs’ own walk.',\n  },\n  'box.clips.cast': {\n    type: 'string',\n    enum: ['both', 'mannequin', 'hero'],\n    default: 'both',\n    when: 'scene',\n    description: 'Who plays it: the mannequin (the figure the Quaternius clips were measured on), the hero, or both.',\n  },\n  'box.clips.ik': {\n    type: 'boolean',\n    default: true,\n    when: 'scene',\n    description: 'Whether the figures plant their feet and lift their bodies over the floor (contact IK).',\n  },\n});\n\n/** Clip mode's own state: how long the one-shot playing has held its end, in steps. */\nexport const CLIPS_MODE = defineComponent('clipsMode', {\n  description: 'The box’s clip mode (labs/box/scenes/clips.ts): how long the one-shot playing has held its end.',\n  fields: { held: { type: 'integer', default: 0, minimum: 0, description: 'Steps the one-shot has held its end.' } },\n});\n\n/** Where the hero starts: the room's spawn `@`, as in the room with a hero. */\nexport const CLIPS_START = ROOM_HERO_LEVEL.spawns.find((spawn) => spawn.name === 'hero')!.position;\n/** How far east of him the mannequin stands, m. */\nconst BESIDE = 1.5;\n/** How long a one-shot holds its end before it plays again, s (the Lab's). */\nconst HOLD = 0.8;\n/** The crossfade to a new clip, s (the Lab's). */\nconst FADE = 0.18;\n\n/** The play the settings ask of a clip that loops (`loop`) or not. */\nfunction wantedPlay(w: World, loop: boolean): ClipPlay {\n  const frame = w.settings.get<number>('box.clips.frame');\n  const mask = w.settings.get<'full' | 'upper'>('box.clips.mask');\n  return {\n    speed: frame >= 0 ? 0 : w.settings.get<number>('box.clips.speed'),\n    mirror: w.settings.get<boolean>('box.clips.mirror'),\n    mask,\n    walk: true,\n    hold: !loop,\n    fade: FADE,\n  };\n}\n\n/** Whether two plays differ in what the settings set. */\nconst differs = (a: ClipPlay, b: ClipPlay) =>\n  a.speed !== b.speed || a.mirror !== b.mirror || a.mask !== b.mask || a.hold !== b.hold;\n\n/** The clip the figures start with, as the settings ask, faded in and at its frame: `SET/Clip` resolved at the step. */\nengine/dev/members.ts engine/dev/inspector.ts\nexport interface InspectorHost {\n  readonly registry: Registry;\n  readonly members: Registry;\n  readonly log: Log;\n  readonly clock: Clock;\n  readonly session: RecordedRun;\n  readonly runtime: string;\n  readonly renderer: boolean;\n  readonly adapter: Readonly<Record<string, unknown>> | null;\n  readonly features: readonly string[];\n  readonly downgrades: readonly string[];\n  step(n: number, intents: unknown): void;\n  restart(seed: number): void;\n}\nexport interface Inspector {\n  info(): EngineInfo;\n  pause(): void;\n  resume(): void;\n  step(n?: number, intents?: Intents | readonly Intents[]): number;\n  timeScale(k?: number): number;\n  seed(n?: number): number;\n  state(query?: string | readonly string[]): WorldState;\n  hash(): string;\n  trace(): WorldTrace;\n  entities(query?: string | readonly string[]): EntitySummary[];\n  get(id: number): EntityData | null;\n  set(path: string, value: unknown): SettingChange;\n  capture(): WorldCapture;\n  restore(capture: WorldCapture): void;\n  describe(kind?: string, id?: string): unknown;\n  help(member?: string): string;\n  readonly errors: readonly ErrorRecord[];\n  readonly advice: readonly AdviceRecord[];\n  [member: string]: unknown;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019NEgHFyRjYVepaJKc1gKj6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
