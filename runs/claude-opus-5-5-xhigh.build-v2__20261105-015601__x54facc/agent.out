{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjbtTQ8Ez7ZL4LwYkHzj","type":"message","role":"assistant","content":[{"type":"text","text":"Writing the UI layer now: theme, glyphs, the focus-driven panel and the save data."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6988,"cache_read_input_tokens":532198,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6988},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"9002a706-056f-4658-8a07-25fcafa4d3d1","timestamp":"2026-11-05T10:12:22.627Z","request_id":"req_011CgjbtT43eq7aca6nbTw8R"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjbtTQ8Ez7ZL4LwYkHzj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014wGrrb2ocHxMpKDMy2H18H","name":"Bash","input":{"command":"cat > labs/game/ui/theme.css <<'EOF'\n/*\n * Teeter Fit's look on screen: pebble-shaped rounded panels in warm off-white with soft shadows, a rounded system font,\n * coral focus. Built for a sofa: body text 2.6vh (28 px at 1080p) or more, menus and prompts 3.2vh or more, 5% safe margins.\n */\n:root {\n  --ink: #3a4a55;\n  --ink-soft: #5d6e7a;\n  --paper: #fffaf1;\n  --paper-2: #f6efe0;\n  --coral: #ff8a70;\n  --mint: #bfead6;\n  --sky: #bfe9ff;\n  --sand: #f4e8c8;\n  --t-body: 2.7vh;\n  --t-menu: 3.4vh;\n  --t-title: 5.4vh;\n  --safe: 5vh;\n  --shadow: 0 1.2vh 3.2vh rgba(58, 74, 85, 0.22), 0 0.3vh 0.7vh rgba(58, 74, 85, 0.14);\n}\n.tf-root {\n  position: absolute;\n  inset: 0;\n  font-family: ui-rounded, 'SF Pro Rounded', 'Segoe UI Rounded', system-ui, sans-serif;\n  color: var(--ink);\n  font-size: var(--t-body);\n  line-height: 1.3;\n  pointer-events: none;\n  user-select: none;\n  overflow: hidden;\n}\n.tf-root * {\n  box-sizing: border-box;\n}\n.tf-layer {\n  position: absolute;\n  inset: 0;\n  padding: var(--safe);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.tf-scrim {\n  background: rgba(247, 250, 252, 0.55);\n  pointer-events: auto;\n}\n.tf-panel {\n  background: var(--paper);\n  border-radius: 5vh;\n  box-shadow: var(--shadow);\n  padding: 3.4vh 4.4vh;\n  pointer-events: auto;\n  max-width: 90vw;\n  max-height: 90vh;\n}\n.tf-h1 {\n  font-size: var(--t-title);\n  font-weight: 800;\n  margin: 0 0 1.6vh;\n  letter-spacing: 0.01em;\n}\n.tf-sub {\n  font-size: var(--t-body);\n  color: var(--ink-soft);\n  margin: 0 0 1.6vh;\n}\n.tf-rows {\n  display: flex;\n  flex-direction: column;\n  gap: 1vh;\n  min-width: 46vh;\n}\n.tf-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 3vh;\n  padding: 1.1vh 2.4vh;\n  border-radius: 3.2vh;\n  font-size: var(--t-menu);\n  font-weight: 650;\n  background: var(--paper-2);\n  border: 0.45vh solid transparent;\n  cursor: pointer;\n  pointer-events: auto;\n  transition: transform 80ms ease-out;\n}\n.tf-row[data-focus='true'] {\n  border-color: var(--coral);\n  background: #fff;\n  transform: scale(1.03);\n  box-shadow: 0 0.4vh 1.2vh rgba(255, 138, 112, 0.35);\n}\n.tf-row[data-disabled='true'] {\n  opacity: 0.45;\n  cursor: default;\n}\n.tf-value {\n  font-size: var(--t-menu);\n  color: var(--ink-soft);\n  font-weight: 700;\n  white-space: nowrap;\n  display: flex;\n  align-items: center;\n  gap: 1.2vh;\n}\n.tf-bar {\n  width: 26vh;\n  height: 1.8vh;\n  border-radius: 1vh;\n  background: var(--mint);\n  overflow: hidden;\n}\n.tf-bar > i {\n  display: block;\n  height: 100%;\n  background: var(--coral);\n}\n.tf-prompts {\n  display: flex;\n  gap: 3.4vh;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  font-size: var(--t-menu);\n  font-weight: 650;\n}\n.tf-prompt {\n  display: inline-flex;\n  align-items: center;\n  gap: 1vh;\n}\n.tf-glyph {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 4.4vh;\n  height: 4.4vh;\n  padding: 0 0.9vh;\n  border-radius: 2.2vh;\n  background: var(--ink);\n  color: #fff;\n  font-size: 2.8vh;\n  font-weight: 800;\n  line-height: 1;\n}\n.tf-glyph[data-kind='key'] {\n  border-radius: 1vh;\n  background: #fff;\n  color: var(--ink);\n  border: 0.3vh solid var(--ink);\n  border-bottom-width: 0.7vh;\n}\n.tf-glyph svg {\n  width: 3.2vh;\n  height: 3.2vh;\n}\n.tf-glyph[data-kind='mouse'] {\n  background: #fff;\n  padding: 0;\n  border: 0.3vh solid var(--ink);\n  border-radius: 1.6vh;\n  min-width: 3.6vh;\n  height: 4.6vh;\n}\n/* The title. */\n.tf-title {\n  position: absolute;\n  left: var(--safe);\n  top: var(--safe);\n  right: var(--safe);\n  bottom: var(--safe);\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  align-items: flex-start;\n}\n.tf-logo {\n  font-size: 13vh;\n  font-weight: 900;\n  line-height: 1;\n  color: #fff;\n  text-shadow: 0 0.6vh 0 var(--coral), 0 1.4vh 3vh rgba(58, 74, 85, 0.35);\n  letter-spacing: 0.01em;\n  transform: rotate(-1.5deg);\n  transform-origin: left bottom;\n}\n.tf-tagline {\n  font-size: 3.4vh;\n  font-weight: 700;\n  color: var(--ink);\n  background: rgba(255, 250, 241, 0.85);\n  padding: 0.6vh 2.4vh;\n  border-radius: 3vh;\n  margin-top: 2vh;\n}\n.tf-banner {\n  position: absolute;\n  left: 50%;\n  bottom: var(--safe);\n  transform: translateX(-50%);\n  display: flex;\n  align-items: center;\n  gap: 4vh;\n  background: rgba(58, 74, 85, 0.86);\n  color: #fff;\n  padding: 1.6vh 4vh;\n  border-radius: 4vh;\n  font-size: var(--t-menu);\n  font-weight: 800;\n}\n.tf-banner b {\n  color: var(--coral);\n  font-size: 4.2vh;\n}\n.tf-touch {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  text-align: center;\n}\n/* The HUD. */\n.tf-disc {\n  position: absolute;\n  left: 50%;\n  bottom: var(--safe);\n  width: 30vh;\n  height: 30vh;\n  transform: translateX(-50%);\n}\n.tf-disc svg {\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n}\n.tf-foot {\n  position: absolute;\n  bottom: calc(var(--safe) + 4vh);\n  width: 7vh;\n  height: 22vh;\n  border-radius: 4vh;\n  background: rgba(255, 250, 241, 0.85);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n.tf-foot > i {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: var(--coral);\n}\n.tf-foot > span {\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 1vh;\n  text-align: center;\n  font-size: 2.7vh;\n  font-weight: 800;\n}\n.tf-chip {\n  position: absolute;\n  background: rgba(255, 250, 241, 0.92);\n  border-radius: 3vh;\n  padding: 1vh 2.4vh;\n  box-shadow: var(--shadow);\n  font-size: var(--t-menu);\n  font-weight: 750;\n}\n.tf-chip small {\n  display: block;\n  font-size: var(--t-body);\n  font-weight: 600;\n  color: var(--ink-soft);\n}\n.tf-meter {\n  height: 1.6vh;\n  border-radius: 1vh;\n  background: var(--mint);\n  overflow: hidden;\n  min-width: 34vh;\n  margin-top: 0.8vh;\n}\n.tf-meter > i {\n  display: block;\n  height: 100%;\n  background: var(--coral);\n}\n.tf-big {\n  position: absolute;\n  left: 50%;\n  top: 28%;\n  transform: translate(-50%, -50%);\n  font-size: 14vh;\n  font-weight: 900;\n  color: #fff;\n  text-shadow: 0 0.6vh 0 var(--coral), 0 1.2vh 3vh rgba(58, 74, 85, 0.35);\n}\n.tf-speech {\n  position: absolute;\n  left: 50%;\n  top: var(--safe);\n  transform: translateX(-50%);\n  max-width: 78vw;\n  background: var(--paper);\n  border-radius: 4vh;\n  padding: 1.5vh 3.4vh;\n  box-shadow: var(--shadow);\n  font-size: 3vh;\n  font-weight: 600;\n}\n.tf-speech b {\n  color: var(--coral);\n  margin-right: 1.2vh;\n}\n.tf-lane {\n  position: absolute;\n  left: 50%;\n  bottom: calc(var(--safe) + 7vh);\n  transform: translateX(-50%);\n  width: 62vh;\n  height: 40vh;\n  border-radius: 4vh;\n  background: rgba(255, 250, 241, 0.78);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n.tf-lane .line {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 5.2vh;\n  height: 0.8vh;\n  background: var(--coral);\n}\n.tf-note {\n  position: absolute;\n  width: 7vh;\n  height: 7vh;\n  margin-left: -3.5vh;\n  margin-bottom: -3.5vh;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 900;\n  font-size: 3.2vh;\n  background: var(--ink);\n  color: #fff;\n}\n.tf-note[data-kind='R'],\n.tf-note[data-kind='>'] {\n  background: var(--coral);\n}\n.tf-note[data-kind='B'] {\n  width: 30vh;\n  margin-left: -15vh;\n  border-radius: 3.5vh;\n  background: #5db6e8;\n}\n.tf-note[data-hit='1'] {\n  opacity: 0.25;\n}\n.tf-gauge {\n  position: absolute;\n  right: calc(var(--safe) + 3vh);\n  bottom: calc(var(--safe) + 6vh);\n  width: 11vh;\n  height: 58vh;\n  border-radius: 5vh;\n  background: rgba(255, 250, 241, 0.9);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n.tf-gauge .band {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 24%;\n  background: var(--mint);\n}\n.tf-gauge .mark {\n  position: absolute;\n  left: 15%;\n  right: 15%;\n  height: 2vh;\n  border-radius: 1vh;\n  background: var(--coral);\n}\n.tf-spin {\n  position: absolute;\n  left: 50%;\n  bottom: calc(var(--safe) + 3vh);\n  transform: translateX(-50%);\n  width: 72vh;\n  height: 5vh;\n  border-radius: 3vh;\n  background: rgba(255, 250, 241, 0.9);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n.tf-spin .band {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  background: var(--mint);\n}\n.tf-spin .mark {\n  position: absolute;\n  top: 10%;\n  bottom: 10%;\n  width: 1.2vh;\n  margin-left: -0.6vh;\n  border-radius: 1vh;\n  background: var(--coral);\n}\n/* Still Pond's lures: big fake interface, in the real one's clothes. */\n.tf-lure {\n  position: absolute;\n  left: 50%;\n  top: 34%;\n  transform: translate(-50%, -50%);\n  background: var(--paper);\n  border-radius: 5vh;\n  box-shadow: var(--shadow);\n  padding: 2.8vh 5vh;\n  font-size: 4.4vh;\n  font-weight: 850;\n  text-align: center;\n  display: flex;\n  align-items: center;\n  gap: 2vh;\n}\n/* Cards, for the Programme and the Noticeboard. */\n.tf-cards {\n  display: grid;\n  gap: 2vh;\n}\n.tf-card {\n  position: relative;\n  background: var(--paper-2);\n  border-radius: 3.2vh;\n  padding: 2vh 2.4vh;\n  min-width: 33vh;\n  min-height: 15vh;\n  border: 0.45vh solid transparent;\n  cursor: pointer;\n  pointer-events: auto;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  font-size: var(--t-menu);\n  font-weight: 750;\n}\n.tf-card small {\n  font-size: var(--t-body);\n  font-weight: 600;\n  color: var(--ink-soft);\n}\n.tf-card[data-focus='true'] {\n  border-color: var(--coral);\n  background: #fff;\n  box-shadow: 0 0.4vh 1.2vh rgba(255, 138, 112, 0.35);\n}\n.tf-card[data-disabled='true'] {\n  opacity: 0.4;\n}\n.tf-stamp {\n  position: absolute;\n  right: 1.6vh;\n  top: 1.2vh;\n  color: var(--coral);\n  border: 0.4vh solid var(--coral);\n  border-radius: 1.4vh;\n  padding: 0 1vh;\n  font-size: 2.7vh;\n  font-weight: 900;\n  transform: rotate(-9deg);\n}\n/* Results. */\n.tf-rank {\n  font-size: 11vh;\n  font-weight: 900;\n  line-height: 1.02;\n  color: var(--coral);\n}\n.tf-score {\n  font-size: 6.4vh;\n  font-weight: 800;\n}\n.tf-dial {\n  position: relative;\n  width: 34vh;\n  height: 34vh;\n  border-radius: 50%;\n  background: #fff;\n  border: 1.2vh solid var(--ink);\n  box-shadow: var(--shadow);\n  margin: 0 auto;\n}\n.tf-dial .needle {\n  position: absolute;\n  left: 50%;\n  bottom: 50%;\n  width: 0.9vh;\n  height: 44%;\n  margin-left: -0.45vh;\n  background: var(--coral);\n  border-radius: 0.5vh;\n  transform-origin: 50% 100%;\n}\n.tf-dial .value {\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 58%;\n  text-align: center;\n  font-size: 7vh;\n  font-weight: 900;\n}\n.tf-dial .note {\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 22%;\n  text-align: center;\n  font-size: 2.7vh;\n  font-weight: 700;\n  color: var(--ink-soft);\n}\n.tf-pebbles {\n  position: relative;\n  height: 12vh;\n  width: 30vh;\n  margin: 0 auto;\n}\n.tf-pebble {\n  position: absolute;\n  width: 6vh;\n  height: 2.8vh;\n  border-radius: 50%;\n  background: #c9ced1;\n  box-shadow: inset 0 -0.5vh 0 rgba(58, 74, 85, 0.18);\n  animation: tf-drop 460ms cubic-bezier(0.5, 0, 0.8, 1) both;\n}\n@keyframes tf-drop {\n  from {\n    transform: translateY(-16vh);\n    opacity: 0;\n  }\n  to {\n    transform: translateY(0);\n    opacity: 1;\n  }\n}\n.tf-graph {\n  width: 54vh;\n  height: 18vh;\n}\n.tf-focusprompt {\n  position: absolute;\n  left: 50%;\n  top: 62%;\n  transform: translateX(-50%);\n  background: rgba(255, 250, 241, 0.92);\n  border-radius: 3vh;\n  padding: 1vh 2.4vh;\n  box-shadow: var(--shadow);\n  font-size: var(--t-menu);\n  font-weight: 750;\n  display: inline-flex;\n  align-items: center;\n  gap: 1.2vh;\n}\n.tf-reticle {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 1.2vh;\n  height: 1.2vh;\n  margin: -0.6vh;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.85);\n  box-shadow: 0 0 0 0.25vh rgba(58, 74, 85, 0.4);\n}\n.tf-about {\n  width: 100vh;\n  max-width: 86vw;\n  white-space: pre-wrap;\n  font-size: 2.8vh;\n  min-height: 56vh;\n}\n.tf-about b {\n  color: var(--coral);\n}\n.tf-fade {\n  position: absolute;\n  inset: 0;\n  background: #fff;\n  opacity: 0;\n  transition: opacity 500ms ease;\n  pointer-events: none;\n}\n.tf-card-hub {\n  width: 110vh;\n  max-width: 88vw;\n}\n.tf-mats {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 1.6vh;\n  margin: 2vh 0;\n}\n.tf-mat {\n  border-radius: 3vh;\n  padding: 2.2vh 1.2vh;\n  text-align: center;\n  font-size: var(--t-body);\n  font-weight: 800;\n  background: var(--paper-2);\n  border: 0.5vh solid transparent;\n  min-height: 15vh;\n}\n.tf-mat[data-on='true'] {\n  color: #fff;\n}\nEOF\ncat > labs/game/ui/glyphs.ts <<'EOF'\n/**\n * @file Prompts that follow the input used last (PLAN.md section 4). Pads: PlayStation glyphs drawn as inline SVG, or Xbox\n * letters when Settings says so; keyboard and mouse: key caps and a mouse icon with the button lit. Never the engine's\n * `input.prompt()` text for pads: it guesses the family from the pad's id.\n *\n * Game code, a page's.\n *\n * @example\n * // glyph('confirm', 'gamepad', 'playstation'); // inline SVG of a cross\n */\n\n/** What is being used. */\nexport type Device = 'gamepad' | 'keyboard' | 'mouse';\n/** The button icon setting. */\nexport type GlyphSet = 'playstation' | 'xbox';\n\n/** A verb the game asks of you. */\nexport type Verb =\n  | 'confirm' | 'cancel' | 'lean' | 'footL' | 'footR' | 'both' | 'pause' | 'plan' | 'wave' | 'hop' | 'use' | 'look' | 'walk' | 'pageL' | 'pageR' | 'more' | 'any'; // prettier-ignore\n\n/** The four face shapes, as SVG. */\nconst FACE: Readonly<Record<string, string>> = {\n  cross: '<svg viewBox=\"0 0 24 24\"><path d=\"M5 5 19 19M19 5 5 19\" stroke=\"#7fc4f0\" stroke-width=\"3.4\" stroke-linecap=\"round\" fill=\"none\"/></svg>',\n  circle: '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"7.6\" stroke=\"#ff8a70\" stroke-width=\"3.2\" fill=\"none\"/></svg>',\n  square: '<svg viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"5\" width=\"14\" height=\"14\" rx=\"1.6\" stroke=\"#e3a3d6\" stroke-width=\"3.2\" fill=\"none\"/></svg>',\n  triangle: '<svg viewBox=\"0 0 24 24\"><path d=\"M12 4.5 20 19H4Z\" stroke=\"#8fd6b8\" stroke-width=\"3\" fill=\"none\" stroke-linejoin=\"round\"/></svg>',\n};\n\n/** The stick, as SVG. */\nconst STICK = '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\" stroke=\"#fff\" stroke-width=\"2.6\" fill=\"none\"/><circle cx=\"12\" cy=\"12\" r=\"3.4\" fill=\"#fff\"/></svg>';\n\n/** A pad glyph: an SVG or letters. */\nconst padGlyph = (text: string, kind = 'pad'): string => `<span class=\"tf-glyph\" data-kind=\"${kind}\" data-glyph=\"${text.length > 8 ? 'svg' : text}\">${text}</span>`;\n\n/** A key cap. */\nconst key = (text: string): string => `<span class=\"tf-glyph\" data-kind=\"key\" data-glyph=\"${text}\">${text}</span>`;\n\n/** A mouse with `button` lit. */\nfunction mouse(button: 'left' | 'right' | 'both' | 'none'): string {\n  const left = button === 'left' || button === 'both' ? '#ff8a70' : 'none';\n  const right = button === 'right' || button === 'both' ? '#ff8a70' : 'none';\n  return `<span class=\"tf-glyph\" data-kind=\"mouse\" data-glyph=\"mouse-${button}\"><svg viewBox=\"0 0 16 22\"><path d=\"M8 1v8H1.2V8A6.8 7 0 0 1 8 1Z\" fill=\"${left}\"/><path d=\"M8 1v8h6.8V8A6.8 7 0 0 0 8 1Z\" fill=\"${right}\"/><path d=\"M8 1v8M1.2 9h13.6\" stroke=\"#3a4a55\" stroke-width=\"1.2\" fill=\"none\"/></svg></span>`;\n}\n\n/** Each verb on a pad, PlayStation then Xbox. */\nconst PAD: Readonly<Record<Verb, readonly [string, string]>> = {\n  confirm: [FACE.cross, 'A'],\n  cancel: [FACE.circle, 'B'],\n  lean: [STICK, STICK],\n  footL: ['L2', 'LT'],\n  footR: ['R2', 'RT'],\n  both: ['L2+R2', 'LT+RT'],\n  pause: ['Options', 'Menu'],\n  plan: [FACE.triangle, 'Y'],\n  wave: [FACE.circle, 'B'],\n  hop: [FACE.square, 'X'],\n  use: [FACE.cross, 'A'],\n  look: ['R', 'R'],\n  walk: [STICK, STICK],\n  pageL: ['L1', 'LB'],\n  pageR: ['R1', 'RB'],\n  more: [FACE.triangle, 'Y'],\n  any: [FACE.cross, 'A'],\n};\n\n/** Each verb on keys, and with the mouse. */\nconst KEYS: Readonly<Record<Verb, () => string>> = {\n  confirm: () => key('Enter'),\n  cancel: () => key('Esc'),\n  lean: () => key('WASD'),\n  footL: () => key('Q'),\n  footR: () => key('E'),\n  both: () => key('Space'),\n  pause: () => key('Esc'),\n  plan: () => key('Tab'),\n  wave: () => key('C'),\n  hop: () => key('Space'),\n  use: () => key('E'),\n  look: () => mouse('none'),\n  walk: () => key('WASD'),\n  pageL: () => key('Q'),\n  pageR: () => key('E'),\n  more: () => key('T'),\n  any: () => key('Any key'),\n};\n\n/** Each verb with a mouse, where it has its own. */\nconst MOUSE: Partial<Readonly<Record<Verb, () => string>>> = {\n  confirm: () => mouse('left'),\n  lean: () => mouse('none'),\n  footL: () => mouse('left'),\n  footR: () => mouse('right'),\n  both: () => mouse('both'),\n  use: () => mouse('left'),\n  look: () => mouse('none'),\n};\n\n/** The HTML of `verb`'s glyph for a device and a set. */\nexport function glyph(verb: Verb, device: Device, set: GlyphSet): string {\n  if (device === 'gamepad') return padGlyph(PAD[verb][set === 'xbox' ? 1 : 0]);\n  if (device === 'mouse') return (MOUSE[verb] ?? KEYS[verb])();\n  return KEYS[verb]();\n}\n\n/** A prompt: a glyph and a word. */\nexport const promptHtml = (verb: Verb, word: string, device: Device, set: GlyphSet): string =>\n  `<span class=\"tf-prompt\">${glyph(verb, device, set)}<span>${word}</span></span>`;\nEOF\ncat > labs/game/ui/panel.ts <<'EOF'\n/**\n * @file The one list widget of the front end: at most six rows on a page at 10 feet, focus unmistakable from a sofa. D-pad,\n * stick, arrows or hover move the focus; Cross, Enter or a click picks; left and right adjust a value row; Circle or Esc\n * cancels. It reads the engine's system layer, which no map can rebind. Plan: `createMenu` does the lists, but Settings\n * needs value rows and paging, so one widget does all of them (called out in labs/game/README.md).\n *\n * Game code, a page's.\n *\n * @example\n * // new Panel(root, { title: 'Paused', rows: [{ id: 'resume', label: 'Resume' }], onPick: (id) => close() });\n */\nimport type { Input } from '../../../engine';\n\n/** Rows at most, per page. */\nexport const MAX_ROWS = 6;\n\n/** A row. */\nexport interface Row {\n  id: string;\n  label: string;\n  /** Shown at the right, or a 0-1 bar when `bar` is set. */\n  value?: () => string;\n  bar?: () => number;\n  /** Left and right change it. */\n  adjust?: (dir: -1 | 1, big: boolean) => void;\n  /** Dragging the bar sets it, 0 to 1. */\n  setBar?: (u: number) => void;\n  disabled?: boolean;\n}\n\n/** What a panel takes. */\nexport interface PanelOptions {\n  id: string;\n  title?: string;\n  sub?: string;\n  rows: Row[];\n  onPick?: (id: string) => void;\n  onCancel?: () => void;\n  sound?: (cue: 'move' | 'pick' | 'cancel') => void;\n  /** A class for where it sits. */\n  className?: string;\n  /** Rows on a page, if fewer than the most. */\n  perPage?: number;\n}\n\n/** A repeating direction: fires at once, again after 0.35 s, then every 0.11 s. */\nexport class Repeat {\n  private held = new Map<string, number>();\n  fire(input: Input, action: string, dt: number): boolean {\n    if (input.pressed(action)) {\n      this.held.set(action, 0);\n      return true;\n    }\n    if (!input.held(action)) {\n      this.held.delete(action);\n      return false;\n    }\n    const before = this.held.get(action) ?? 0;\n    const now = before + dt;\n    this.held.set(action, now);\n    const count = (t: number) => (t < 0.35 ? 0 : 1 + Math.floor((t - 0.35) / 0.11));\n    return count(now) > count(before);\n  }\n}\n\n/** A list of rows, paged. */\nexport class Panel {\n  readonly el: HTMLElement;\n  private rows: Row[];\n  private index = 0;\n  private page = 0;\n  private list: HTMLElement;\n  private rowEls: HTMLElement[] = [];\n  private repeat = new Repeat();\n  active = true;\n\n  constructor(\n    parent: HTMLElement,\n    readonly options: PanelOptions,\n  ) {\n    this.rows = options.rows;\n    const el = document.createElement('div');\n    el.className = `tf-panel ${options.className ?? ''}`;\n    el.dataset.panel = options.id;\n    if (options.title) {\n      const h = document.createElement('div');\n      h.className = 'tf-h1';\n      h.textContent = options.title;\n      el.append(h);\n    }\n    if (options.sub) {\n      const s = document.createElement('div');\n      s.className = 'tf-sub';\n      s.textContent = options.sub;\n      el.append(s);\n    }\n    this.list = document.createElement('div');\n    this.list.className = 'tf-rows';\n    el.append(this.list);\n    parent.append(el);\n    this.el = el;\n    this.draw();\n    this.index = this.firstEnabled();\n    this.mark();\n  }\n\n  /** Rows on a page, the \"More\" row counting. */\n  private get perPage(): number {\n    return Math.min(MAX_ROWS, this.options.perPage ?? MAX_ROWS);\n  }\n\n  /** The rows on this page, with paging rows laid in. */\n  private pageRows(): Row[] {\n    const n = this.perPage;\n    if (this.rows.length <= n) return this.rows;\n    const size = n - 1;\n    const pages = Math.ceil(this.rows.length / size);\n    const start = this.page * size;\n    const out = this.rows.slice(start, start + size);\n    out.push({ id: '__more', label: this.page + 1 < pages ? 'More…' : 'Back to the top' });\n    return out;\n  }\n\n  private firstEnabled(): number {\n    const rows = this.pageRows();\n    const i = rows.findIndex((r) => !r.disabled);\n    return i < 0 ? 0 : i;\n  }\n\n  /** Builds this page's elements. */\n  private draw(): void {\n    this.list.textContent = '';\n    this.rowEls = this.pageRows().map((row, i) => {\n      const el = document.createElement('div');\n      el.className = 'tf-row';\n      el.dataset.ui = 'item';\n      el.dataset.id = row.id;\n      if (row.disabled) el.dataset.disabled = 'true';\n      const label = document.createElement('span');\n      label.textContent = row.label;\n      el.append(label);\n      if (row.value || row.bar) {\n        const value = document.createElement('span');\n        value.className = 'tf-value';\n        if (row.bar) {\n          const bar = document.createElement('span');\n          bar.className = 'tf-bar';\n          bar.append(document.createElement('i'));\n          value.append(bar);\n          const set = (event: PointerEvent) => {\n            const box = bar.getBoundingClientRect();\n            row.setBar?.(Math.max(0, Math.min(1, (event.clientX - box.left) / box.width)));\n          };\n          bar.addEventListener('pointerdown', (event) => {\n            event.stopPropagation();\n            set(event);\n            bar.setPointerCapture(event.pointerId);\n          });\n          bar.addEventListener('pointermove', (event) => {\n            if (event.buttons) set(event);\n          });\n        }\n        const text = document.createElement('span');\n        text.dataset.value = '1';\n        value.append(text);\n        el.append(value);\n      }\n      el.addEventListener('pointermove', (event) => {\n        if ((event.movementX !== 0 || event.movementY !== 0) && this.active && !row.disabled && this.index !== i) {\n          this.index = i;\n          this.options.sound?.('move');\n          this.mark();\n        }\n      });\n      el.addEventListener('click', () => {\n        if (!this.active || row.disabled) return;\n        this.index = i;\n        this.mark();\n        if (row.adjust && !row.bar) {\n          row.adjust(1, false);\n          this.refresh();\n        } else this.pick();\n      });\n      this.list.append(el);\n      return el;\n    });\n    this.refresh();\n  }\n\n  /** Marks the focused row. */\n  private mark(): void {\n    this.rowEls.forEach((el, i) => {\n      el.dataset.focus = i === this.index ? 'true' : 'false';\n    });\n    this.el.dataset.focus = this.pageRows()[this.index]?.id ?? '';\n  }\n\n  /** Redraws the values. */\n  refresh(): void {\n    this.pageRows().forEach((row, i) => {\n      const el = this.rowEls[i];\n      if (!el) return;\n      const text = el.querySelector<HTMLElement>('[data-value]');\n      if (text && row.value) text.textContent = row.value();\n      const fill = el.querySelector<HTMLElement>('.tf-bar > i');\n      if (fill && row.bar) fill.style.width = `${Math.round(row.bar() * 100)}%`;\n    });\n  }\n\n  /** Replaces the rows, keeping the focus where it can. */\n  setRows(rows: Row[]): void {\n    this.rows = rows;\n    this.draw();\n    this.index = Math.min(this.index, this.pageRows().length - 1);\n    this.mark();\n  }\n\n  /** The focused row's id. */\n  get focused(): string {\n    return this.pageRows()[this.index]?.id ?? '';\n  }\n\n  /** Moves the focus. */\n  private move(dir: -1 | 1): void {\n    const rows = this.pageRows();\n    let at = this.index;\n    for (let k = 0; k < rows.length; k++) {\n      at = (at + dir + rows.length) % rows.length;\n      if (!rows[at].disabled) break;\n    }\n    if (at !== this.index) {\n      this.index = at;\n      this.options.sound?.('move');\n      this.mark();\n    }\n  }\n\n  /** Picks the focused row. */\n  pick(): void {\n    const row = this.pageRows()[this.index];\n    if (!row || row.disabled) return;\n    if (row.id === '__more') {\n      const size = this.perPage - 1;\n      const pages = Math.ceil(this.rows.length / size);\n      this.page = (this.page + 1) % pages;\n      this.index = 0;\n      this.draw();\n      this.index = this.firstEnabled();\n      this.mark();\n      this.options.sound?.('move');\n      return;\n    }\n    this.options.sound?.('pick');\n    this.options.onPick?.(row.id);\n  }\n\n  /** One frame: reads the system layer. */\n  update(input: Input, dt: number): void {\n    if (!this.active) return;\n    if (this.repeat.fire(input, 'uiUp', dt)) this.move(-1);\n    if (this.repeat.fire(input, 'uiDown', dt)) this.move(1);\n    const row = this.pageRows()[this.index];\n    if (row?.adjust) {\n      if (this.repeat.fire(input, 'uiLeft', dt)) {\n        row.adjust(-1, false);\n        this.options.sound?.('move');\n        this.refresh();\n      }\n      if (this.repeat.fire(input, 'uiRight', dt)) {\n        row.adjust(1, false);\n        this.options.sound?.('move');\n        this.refresh();\n      }\n    }\n    if (input.pressed('uiAccept')) {\n      if (row?.adjust && !row.bar) {\n        row.adjust(1, false);\n        this.refresh();\n      } else this.pick();\n    } else if (input.pressed('uiCancel') && this.options.onCancel) {\n      this.options.sound?.('cancel');\n      this.options.onCancel();\n    }\n    this.refresh();\n  }\n\n  /** Takes it away. */\n  remove(): void {\n    this.el.remove();\n    this.active = false;\n  }\n}\nEOF\ncat > labs/game/ui/save.ts <<'EOF'\n/**\n * @file The save and the settings, in the page's store (PLAN.md section 5): the sim never reads them; the page hands the sim\n * its starting state through `game.begin`.\n *\n * Game code, a page's.\n *\n * @example\n * // const save = loadSave(store);\n */\nimport type { Store } from '../../../engine';\nimport type { Flow } from '../scenes/components';\n\n/** What is kept between sittings. */\nexport interface SaveData {\n  started: boolean;\n  day: number;\n  done: string[];\n  seen: string[];\n  pebbles: number;\n  found: number[];\n  ages: number[];\n  bests: Record<string, number>;\n  look: number;\n  color: string;\n  finished: boolean;\n}\n\n/** What the player has set. */\nexport interface SettingsData {\n  music: number;\n  effects: number;\n  voices: number;\n  glyphs: 'playstation' | 'xbox';\n  mouse: number;\n  invert: boolean;\n  rumble: boolean;\n  steadier: boolean;\n  reduced: boolean;\n  cpuGuests: boolean;\n}\n\n/** A fresh save. */\nexport const NEW_SAVE: SaveData = { started: false, day: 1, done: [], seen: [], pebbles: 0, found: [], ages: [], bests: {}, look: 0, color: 'coral', finished: false }; // prettier-ignore\n\n/** Fresh settings: music at 10%. */\nexport const NEW_SETTINGS: SettingsData = { music: 0.1, effects: 1, voices: 1, glyphs: 'playstation', mouse: 1, invert: false, rumble: true, steadier: false, reduced: false, cpuGuests: true }; // prettier-ignore\n\n/** Reads the save. */\nexport const loadSave = (store: Store): SaveData => ({ ...NEW_SAVE, ...store.get<Partial<SaveData>>('save', {}) });\n/** Reads the settings. */\nexport const loadSettings = (store: Store): SettingsData => ({ ...NEW_SETTINGS, ...store.get<Partial<SettingsData>>('settings', {}) });\n\n/** A save made from the sim's flow. */\nexport function saveFromFlow(flow: Flow, was: SaveData): SaveData {\n  return {\n    started: true,\n    day: flow.day,\n    done: [...flow.done],\n    seen: [...flow.seen],\n    pebbles: flow.pebbles,\n    found: [...flow.found],\n    ages: [...flow.ages],\n    bests: { ...flow.bests },\n    look: flow.look,\n    color: flow.color,\n    finished: was.finished || flow.day > 5,\n  };\n}\nEOF\ncat > labs/game/ui/shots.ts <<'EOF'\n/**\n * @file The purpose-built camera for each activity, as a table of functions from what is happening to where the camera\n * stands (PLAN.md section 6's table). The page calls `shotFor` each frame and `cam3=shot` eases towards the answer. Reduced\n * Motion takes out roll and shake.\n *\n * Game code, a page's.\n *\n * @example\n * // setShot(shotFor('line', view));\n */\nimport type { Shot } from '../cameras/shot';\nimport { STATIONS } from '../scenes/data/stations';\n\n/** What a shot may look at. */\nexport interface ShotView {\n  t: number;\n  phase: string;\n  guest: { x: number; y: number; z: number; yaw: number };\n  tiltX: number;\n  tiltZ: number;\n  reduced: boolean;\n  data: Record<string, unknown>;\n  seat?: number;\n  round: boolean;\n}\n\n/** A shot that frames a mat from the front, with a slow drift. */\nfunction matShot(v: ShotView): Shot {\n  const { x, z } = STATIONS.pavilion;\n  const drift = Math.sin(v.t * 0.12) * 2.4;\n  const { y } = v.guest;\n  return { at: [v.guest.x + 3.2 + drift, y + 2.4, v.guest.z - 5.6], look: [v.guest.x + 0.2, y + 1, v.guest.z], fov: 40, ease: 0.8, ...(x + z > 1e9 ? {} : {}) };\n}\n\n/** The table. */\nconst SHOTS: Readonly<Record<string, (v: ShotView) => Shot>> = {\n  mat: matShot,\n  platform: (v) => {\n    const push = Math.min(1, v.t / 12);\n    return { at: [v.guest.x + 0.6, v.guest.y + 1.5, v.guest.z - (6.4 - push * 1.8)], look: [v.guest.x, v.guest.y + 1.05, v.guest.z], fov: 38, ease: 1 };\n  },\n  reps: (v) => ({ at: [v.guest.x + 5.2, v.guest.y + 2, v.guest.z + 3.6], look: [v.guest.x - 0.5, v.guest.y + 0.9, v.guest.z - 0.4], fov: 42, ease: 0.9 }),\n  step: (v) => ({ at: [v.guest.x + 0.5, v.guest.y + 4, v.guest.z + 5.6], look: [v.guest.x, v.guest.y + 0.8, v.guest.z - 1], fov: 46, ease: 0.9 }),\n  pond: (v) => ({ at: [v.guest.x, v.guest.y + 1, v.guest.z - 5.2], look: [v.guest.x, v.guest.y + 0.75, v.guest.z], fov: 32, ease: 1.2 }),\n  line: (v) => ({ at: [v.guest.x + 4.4, v.guest.y + 3.6, v.guest.z - 7.5], look: [v.guest.x, v.guest.y + 0.8, v.guest.z + 3], fov: 46, ease: 0.45 }),\n  paddle: (v) => {\n    const [fx, fz] = [Math.sin(v.guest.yaw), Math.cos(v.guest.yaw)];\n    return { at: [v.guest.x - fx * 8.6, v.guest.y + 3.1, v.guest.z - fz * 8.6], look: [v.guest.x + fx * 3, v.guest.y + 0.9, v.guest.z + fz * 3], fov: 50, ease: 0.5 };\n  },\n  garden: (v) => {\n    const { x, z } = STATIONS.terrace;\n    const y = v.guest.y;\n    return { at: [x, y + 5, z + 1.8], look: [x, y + 0.92, z], fov: 34, ease: 0.8 };\n  },\n  plunge: (v) => {\n    const { x } = STATIONS.cliff;\n    if (v.phase === 'cards') return { at: [x + 10.5, 2.5, v.guest.z + 6.5], look: [x - 3, 3.3, v.guest.z - 3], fov: 44, ease: 0.25 };\n    if (v.phase === 'air') return { at: [x + 13, Math.max(3.2, v.guest.y + 1), v.guest.z + 3], look: [x, v.guest.y, v.guest.z - 2], fov: 50, ease: 0.25 };\n    return { at: [x + 7, v.guest.y + 1.7, v.guest.z + 1.2], look: [x, v.guest.y + 1, v.guest.z - 1.5], fov: 44, ease: 0.8 };\n  },\n  hoop: (v) => ({ at: [v.guest.x + 1.6, v.guest.y + 2.1, v.guest.z - 6], look: [v.guest.x, v.guest.y + 1, v.guest.z], fov: 42, ease: 0.8 }),\n  jog: (v) => {\n    const [fx, fz] = [Math.sin(v.guest.yaw), Math.cos(v.guest.yaw)];\n    return { at: [v.guest.x - fx * 7, v.guest.y + 3.6, v.guest.z - fz * 7], look: [v.guest.x + fx * 4, v.guest.y + 1.1, v.guest.z + fz * 4], fov: 54, ease: 0.6 };\n  },\n  tilt: (v) => {\n    const roll = v.reduced ? 0 : (v.tiltX * Math.PI) / 180;\n    if (v.phase === 'storm') {\n      const plumbClose = v.t > 3 && v.t < 11;\n      const at: [number, number, number] = plumbClose ? [3.4, 10.2, 22.2] : [14, 18, 56];\n      const look: [number, number, number] = plumbClose ? [2, 9.3, 26] : [0, 8, 26];\n      return { at, look, fov: plumbClose ? 30 : 46, roll: roll * 0.5, ease: 0.9 };\n    }\n    if (v.phase === 'stone') {\n      const a = v.t * 0.045;\n      return { at: [Math.sin(a) * 92, 54, Math.cos(a) * 92], look: [0, 8, 0], fov: 46, roll, ease: 1.1 };\n    }\n    if (v.phase === 'dawn') return { at: [v.guest.x + 3.6, v.guest.y + 1.7, v.guest.z - 5], look: [v.guest.x + 1, v.guest.y + 1, v.guest.z + 1], fov: 38, ease: 1.2 };\n    if (v.phase === 'weights') return { at: [v.guest.x - 2, v.guest.y + 4.2, v.guest.z - 9], look: [v.guest.x + 2, v.guest.y + 0.8, v.guest.z + 1], fov: 48, roll: roll * 0.4, ease: 0.8 };\n    return { at: [v.guest.x - 9, v.guest.y + 8, v.guest.z - 3], look: [v.guest.x + 8, v.guest.y, v.guest.z], fov: 50, roll: roll * 0.7, ease: 0.6 };\n  },\n  title: (v) => {\n    const a = v.t * 0.05;\n    return { at: [Math.sin(a) * 130, 42, Math.cos(a) * 130], look: [0, 10, 0], fov: 42, ease: 0 };\n  },\n  card: (v) => {\n    const { x, z } = STATIONS.pavilion;\n    const a = Math.sin(v.t * 0.12) * 2;\n    return { at: [x + a, 11.6, z + 18], look: [x, 9, z + 2], fov: 42, ease: 0.8 };\n  },\n  credits: (v) => {\n    const a = v.t * 0.05;\n    return { at: [Math.sin(a) * 28 + 2, 13, Math.cos(a) * 28 + 26], look: [2, 8.8, 28], fov: 40, ease: 1.2 };\n  },\n};\n\n/** The shot for a name. */\nexport function shotFor(name: string, view: ShotView): Shot {\n  return (SHOTS[name] ?? SHOTS.title)(view);\n}\n\n/** Every shot's name, for tests. */\nexport const SHOT_NAMES = Object.keys(SHOTS);\nEOF\n","description":"Write theme, glyphs, panel widget, save and camera shots"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6988,"cache_read_input_tokens":532198,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6988},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"27643664-c42d-4372-a539-5da3a8aa15ec","timestamp":"2026-11-05T10:14:23.524Z","request_id":"req_011CgjbtT43eq7aca6nbTw8R","wire_tool_inputs":{"toolu_014wGrrb2ocHxMpKDMy2H18H":{"command":"cat > labs/game/ui/theme.css <<'EOF'\n/*\n * Teeter Fit's look on screen: pebble-shaped rounded panels in warm off-white with soft shadows, a rounded system font,\n * coral focus. Built for a sofa: body text 2.6vh (28 px at 1080p) or more, menus and prompts 3.2vh or more, 5% safe margins.\n */\n:root {\n  --ink: #3a4a55;\n  --ink-soft: #5d6e7a;\n  --paper: #fffaf1;\n  --paper-2: #f6efe0;\n  --coral: #ff8a70;\n  --mint: #bfead6;\n  --sky: #bfe9ff;\n  --sand: #f4e8c8;\n  --t-body: 2.7vh;\n  --t-menu: 3.4vh;\n  --t-title: 5.4vh;\n  --safe: 5vh;\n  --shadow: 0 1.2vh 3.2vh rgba(58, 74, 85, 0.22), 0 0.3vh 0.7vh rgba(58, 74, 85, 0.14);\n}\n.tf-root {\n  position: absolute;\n  inset: 0;\n  font-family: ui-rounded, 'SF Pro Rounded', 'Segoe UI Rounded', system-ui, sans-serif;\n  color: var(--ink);\n  font-size: var(--t-body);\n  line-height: 1.3;\n  pointer-events: none;\n  user-select: none;\n  overflow: hidden;\n}\n.tf-root * {\n  box-sizing: border-box;\n}\n.tf-layer {\n  position: absolute;\n  inset: 0;\n  padding: var(--safe);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.tf-scrim {\n  background: rgba(247, 250, 252, 0.55);\n  pointer-events: auto;\n}\n.tf-panel {\n  background: var(--paper);\n  border-radius: 5vh;\n  box-shadow: var(--shadow);\n  padding: 3.4vh 4.4vh;\n  pointer-events: auto;\n  max-width: 90vw;\n  max-height: 90vh;\n}\n.tf-h1 {\n  font-size: var(--t-title);\n  font-weight: 800;\n  margin: 0 0 1.6vh;\n  letter-spacing: 0.01em;\n}\n.tf-sub {\n  font-size: var(--t-body);\n  color: var(--ink-soft);\n  margin: 0 0 1.6vh;\n}\n.tf-rows {\n  display: flex;\n  flex-direction: column;\n  gap: 1vh;\n  min-width: 46vh;\n}\n.tf-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 3vh;\n  padding: 1.1vh 2.4vh;\n  border-radius: 3.2vh;\n  font-size: var(--t-menu);\n  font-weight: 650;\n  background: var(--paper-2);\n  border: 0.45vh solid transparent;\n  cursor: pointer;\n  pointer-events: auto;\n  transition: transform 80ms ease-out;\n}\n.tf-row[data-focus='true'] {\n  border-color: var(--coral);\n  background: #fff;\n  transform: scale(1.03);\n  box-shadow: 0 0.4vh 1.2vh rgba(255, 138, 112, 0.35);\n}\n.tf-row[data-disabled='true'] {\n  opacity: 0.45;\n  cursor: default;\n}\n.tf-value {\n  font-size: var(--t-menu);\n  color: var(--ink-soft);\n  font-weight: 700;\n  white-space: nowrap;\n  display: flex;\n  align-items: center;\n  gap: 1.2vh;\n}\n.tf-bar {\n  width: 26vh;\n  height: 1.8vh;\n  border-radius: 1vh;\n  background: var(--mint);\n  overflow: hidden;\n}\n.tf-bar > i {\n  display: block;\n  height: 100%;\n  background: var(--coral);\n}\n.tf-prompts {\n  display: flex;\n  gap: 3.4vh;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  font-size: var(--t-menu);\n  font-weight: 650;\n}\n.tf-prompt {\n  display: inline-flex;\n  align-items: center;\n  gap: 1vh;\n}\n.tf-glyph {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 4.4vh;\n  height: 4.4vh;\n  padding: 0 0.9vh;\n  border-radius: 2.2vh;\n  background: var(--ink);\n  color: #fff;\n  font-size: 2.8vh;\n  font-weight: 800;\n  line-height: 1;\n}\n.tf-glyph[data-kind='key'] {\n  border-radius: 1vh;\n  background: #fff;\n  color: var(--ink);\n  border: 0.3vh solid var(--ink);\n  border-bottom-width: 0.7vh;\n}\n.tf-glyph svg {\n  width: 3.2vh;\n  height: 3.2vh;\n}\n.tf-glyph[data-kind='mouse'] {\n  background: #fff;\n  padding: 0;\n  border: 0.3vh solid var(--ink);\n  border-radius: 1.6vh;\n  min-width: 3.6vh;\n  height: 4.6vh;\n}\n/* The title. */\n.tf-title {\n  position: absolute;\n  left: var(--safe);\n  top: var(--safe);\n  right: var(--safe);\n  bottom: var(--safe);\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  align-items: flex-start;\n}\n.tf-logo {\n  font-size: 13vh;\n  font-weight: 900;\n  line-height: 1;\n  color: #fff;\n  text-shadow: 0 0.6vh 0 var(--coral), 0 1.4vh 3vh rgba(58, 74, 85, 0.35);\n  letter-spacing: 0.01em;\n  transform: rotate(-1.5deg);\n  transform-origin: left bottom;\n}\n.tf-tagline {\n  font-size: 3.4vh;\n  font-weight: 700;\n  color: var(--ink);\n  background: rgba(255, 250, 241, 0.85);\n  padding: 0.6vh 2.4vh;\n  border-radius: 3vh;\n  margin-top: 2vh;\n}\n.tf-banner {\n  position: absolute;\n  left: 50%;\n  bottom: var(--safe);\n  transform: translateX(-50%);\n  display: flex;\n  align-items: center;\n  gap: 4vh;\n  background: rgba(58, 74, 85, 0.86);\n  color: #fff;\n  padding: 1.6vh 4vh;\n  border-radius: 4vh;\n  font-size: var(--t-menu);\n  font-weight: 800;\n}\n.tf-banner b {\n  color: var(--coral);\n  font-size: 4.2vh;\n}\n.tf-touch {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  text-align: center;\n}\n/* The HUD. */\n.tf-disc {\n  position: absolute;\n  left: 50%;\n  bottom: var(--safe);\n  width: 30vh;\n  height: 30vh;\n  transform: translateX(-50%);\n}\n.tf-disc svg {\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n}\n.tf-foot {\n  position: absolute;\n  bottom: calc(var(--safe) + 4vh);\n  width: 7vh;\n  height: 22vh;\n  border-radius: 4vh;\n  background: rgba(255, 250, 241, 0.85);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n.tf-foot > i {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: var(--coral);\n}\n.tf-foot > span {\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 1vh;\n  text-align: center;\n  font-size: 2.7vh;\n  font-weight: 800;\n}\n.tf-chip {\n  position: absolute;\n  background: rgba(255, 250, 241, 0.92);\n  border-radius: 3vh;\n  padding: 1vh 2.4vh;\n  box-shadow: var(--shadow);\n  font-size: var(--t-menu);\n  font-weight: 750;\n}\n.tf-chip small {\n  display: block;\n  font-size: var(--t-body);\n  font-weight: 600;\n  color: var(--ink-soft);\n}\n.tf-meter {\n  height: 1.6vh;\n  border-radius: 1vh;\n  background: var(--mint);\n  overflow: hidden;\n  min-width: 34vh;\n  margin-top: 0.8vh;\n}\n.tf-meter > i {\n  display: block;\n  height: 100%;\n  background: var(--coral);\n}\n.tf-big {\n  position: absolute;\n  left: 50%;\n  top: 28%;\n  transform: translate(-50%, -50%);\n  font-size: 14vh;\n  font-weight: 900;\n  color: #fff;\n  text-shadow: 0 0.6vh 0 var(--coral), 0 1.2vh 3vh rgba(58, 74, 85, 0.35);\n}\n.tf-speech {\n  position: absolute;\n  left: 50%;\n  top: var(--safe);\n  transform: translateX(-50%);\n  max-width: 78vw;\n  background: var(--paper);\n  border-radius: 4vh;\n  padding: 1.5vh 3.4vh;\n  box-shadow: var(--shadow);\n  font-size: 3vh;\n  font-weight: 600;\n}\n.tf-speech b {\n  color: var(--coral);\n  margin-right: 1.2vh;\n}\n.tf-lane {\n  position: absolute;\n  left: 50%;\n  bottom: calc(var(--safe) + 7vh);\n  transform: translateX(-50%);\n  width: 62vh;\n  height: 40vh;\n  border-radius: 4vh;\n  background: rgba(255, 250, 241, 0.78);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n.tf-lane .line {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 5.2vh;\n  height: 0.8vh;\n  background: var(--coral);\n}\n.tf-note {\n  position: absolute;\n  width: 7vh;\n  height: 7vh;\n  margin-left: -3.5vh;\n  margin-bottom: -3.5vh;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 900;\n  font-size: 3.2vh;\n  background: var(--ink);\n  color: #fff;\n}\n.tf-note[data-kind='R'],\n.tf-note[data-kind='>'] {\n  background: var(--coral);\n}\n.tf-note[data-kind='B'] {\n  width: 30vh;\n  margin-left: -15vh;\n  border-radius: 3.5vh;\n  background: #5db6e8;\n}\n.tf-note[data-hit='1'] {\n  opacity: 0.25;\n}\n.tf-gauge {\n  position: absolute;\n  right: calc(var(--safe) + 3vh);\n  bottom: calc(var(--safe) + 6vh);\n  width: 11vh;\n  height: 58vh;\n  border-radius: 5vh;\n  background: rgba(255, 250, 241, 0.9);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n.tf-gauge .band {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 24%;\n  background: var(--mint);\n}\n.tf-gauge .mark {\n  position: absolute;\n  left: 15%;\n  right: 15%;\n  height: 2vh;\n  border-radius: 1vh;\n  background: var(--coral);\n}\n.tf-spin {\n  position: absolute;\n  left: 50%;\n  bottom: calc(var(--safe) + 3vh);\n  transform: translateX(-50%);\n  width: 72vh;\n  height: 5vh;\n  border-radius: 3vh;\n  background: rgba(255, 250, 241, 0.9);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n.tf-spin .band {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  background: var(--mint);\n}\n.tf-spin .mark {\n  position: absolute;\n  top: 10%;\n  bottom: 10%;\n  width: 1.2vh;\n  margin-left: -0.6vh;\n  border-radius: 1vh;\n  background: var(--coral);\n}\n/* Still Pond's lures: big fake interface, in the real one's clothes. */\n.tf-lure {\n  position: absolute;\n  left: 50%;\n  top: 34%;\n  transform: translate(-50%, -50%);\n  background: var(--paper);\n  border-radius: 5vh;\n  box-shadow: var(--shadow);\n  padding: 2.8vh 5vh;\n  font-size: 4.4vh;\n  font-weight: 850;\n  text-align: center;\n  display: flex;\n  align-items: center;\n  gap: 2vh;\n}\n/* Cards, for the Programme and the Noticeboard. */\n.tf-cards {\n  display: grid;\n  gap: 2vh;\n}\n.tf-card {\n  position: relative;\n  background: var(--paper-2);\n  border-radius: 3.2vh;\n  padding: 2vh 2.4vh;\n  min-width: 33vh;\n  min-height: 15vh;\n  border: 0.45vh solid transparent;\n  cursor: pointer;\n  pointer-events: auto;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  font-size: var(--t-menu);\n  font-weight: 750;\n}\n.tf-card small {\n  font-size: var(--t-body);\n  font-weight: 600;\n  color: var(--ink-soft);\n}\n.tf-card[data-focus='true'] {\n  border-color: var(--coral);\n  background: #fff;\n  box-shadow: 0 0.4vh 1.2vh rgba(255, 138, 112, 0.35);\n}\n.tf-card[data-disabled='true'] {\n  opacity: 0.4;\n}\n.tf-stamp {\n  position: absolute;\n  right: 1.6vh;\n  top: 1.2vh;\n  color: var(--coral);\n  border: 0.4vh solid var(--coral);\n  border-radius: 1.4vh;\n  padding: 0 1vh;\n  font-size: 2.7vh;\n  font-weight: 900;\n  transform: rotate(-9deg);\n}\n/* Results. */\n.tf-rank {\n  font-size: 11vh;\n  font-weight: 900;\n  line-height: 1.02;\n  color: var(--coral);\n}\n.tf-score {\n  font-size: 6.4vh;\n  font-weight: 800;\n}\n.tf-dial {\n  position: relative;\n  width: 34vh;\n  height: 34vh;\n  border-radius: 50%;\n  background: #fff;\n  border: 1.2vh solid var(--ink);\n  box-shadow: var(--shadow);\n  margin: 0 auto;\n}\n.tf-dial .needle {\n  position: absolute;\n  left: 50%;\n  bottom: 50%;\n  width: 0.9vh;\n  height: 44%;\n  margin-left: -0.45vh;\n  background: var(--coral);\n  border-radius: 0.5vh;\n  transform-origin: 50% 100%;\n}\n.tf-dial .value {\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 58%;\n  text-align: center;\n  font-size: 7vh;\n  font-weight: 900;\n}\n.tf-dial .note {\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 22%;\n  text-align: center;\n  font-size: 2.7vh;\n  font-weight: 700;\n  color: var(--ink-soft);\n}\n.tf-pebbles {\n  position: relative;\n  height: 12vh;\n  width: 30vh;\n  margin: 0 auto;\n}\n.tf-pebble {\n  position: absolute;\n  width: 6vh;\n  height: 2.8vh;\n  border-radius: 50%;\n  background: #c9ced1;\n  box-shadow: inset 0 -0.5vh 0 rgba(58, 74, 85, 0.18);\n  animation: tf-drop 460ms cubic-bezier(0.5, 0, 0.8, 1) both;\n}\n@keyframes tf-drop {\n  from {\n    transform: translateY(-16vh);\n    opacity: 0;\n  }\n  to {\n    transform: translateY(0);\n    opacity: 1;\n  }\n}\n.tf-graph {\n  width: 54vh;\n  height: 18vh;\n}\n.tf-focusprompt {\n  position: absolute;\n  left: 50%;\n  top: 62%;\n  transform: translateX(-50%);\n  background: rgba(255, 250, 241, 0.92);\n  border-radius: 3vh;\n  padding: 1vh 2.4vh;\n  box-shadow: var(--shadow);\n  font-size: var(--t-menu);\n  font-weight: 750;\n  display: inline-flex;\n  align-items: center;\n  gap: 1.2vh;\n}\n.tf-reticle {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 1.2vh;\n  height: 1.2vh;\n  margin: -0.6vh;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.85);\n  box-shadow: 0 0 0 0.25vh rgba(58, 74, 85, 0.4);\n}\n.tf-about {\n  width: 100vh;\n  max-width: 86vw;\n  white-space: pre-wrap;\n  font-size: 2.8vh;\n  min-height: 56vh;\n}\n.tf-about b {\n  color: var(--coral);\n}\n.tf-fade {\n  position: absolute;\n  inset: 0;\n  background: #fff;\n  opacity: 0;\n  transition: opacity 500ms ease;\n  pointer-events: none;\n}\n.tf-card-hub {\n  width: 110vh;\n  max-width: 88vw;\n}\n.tf-mats {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 1.6vh;\n  margin: 2vh 0;\n}\n.tf-mat {\n  border-radius: 3vh;\n  padding: 2.2vh 1.2vh;\n  text-align: center;\n  font-size: var(--t-body);\n  font-weight: 800;\n  background: var(--paper-2);\n  border: 0.5vh solid transparent;\n  min-height: 15vh;\n}\n.tf-mat[data-on='true'] {\n  color: #fff;\n}\nEOF\ncat > labs/game/ui/glyphs.ts <<'EOF'\n/**\n * @file Prompts that follow the input used last (PLAN.md section 4). Pads: PlayStation glyphs drawn as inline SVG, or Xbox\n * letters when Settings says so; keyboard and mouse: key caps and a mouse icon with the button lit. Never the engine's\n * `input.prompt()` text for pads: it guesses the family from the pad's id.\n *\n * Game code, a page's.\n *\n * @example\n * // glyph('confirm', 'gamepad', 'playstation'); // inline SVG of a cross\n */\n\n/** What is being used. */\nexport type Device = 'gamepad' | 'keyboard' | 'mouse';\n/** The button icon setting. */\nexport type GlyphSet = 'playstation' | 'xbox';\n\n/** A verb the game asks of you. */\nexport type Verb =\n  | 'confirm' | 'cancel' | 'lean' | 'footL' | 'footR' | 'both' | 'pause' | 'plan' | 'wave' | 'hop' | 'use' | 'look' | 'walk' | 'pageL' | 'pageR' | 'more' | 'any'; // prettier-ignore\n\n/** The four face shapes, as SVG. */\nconst FACE: Readonly<Record<string, string>> = {\n  cross: '<svg viewBox=\"0 0 24 24\"><path d=\"M5 5 19 19M19 5 5 19\" stroke=\"#7fc4f0\" stroke-width=\"3.4\" stroke-linecap=\"round\" fill=\"none\"/></svg>',\n  circle: '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"7.6\" stroke=\"#ff8a70\" stroke-width=\"3.2\" fill=\"none\"/></svg>',\n  square: '<svg viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"5\" width=\"14\" height=\"14\" rx=\"1.6\" stroke=\"#e3a3d6\" stroke-width=\"3.2\" fill=\"none\"/></svg>',\n  triangle: '<svg viewBox=\"0 0 24 24\"><path d=\"M12 4.5 20 19H4Z\" stroke=\"#8fd6b8\" stroke-width=\"3\" fill=\"none\" stroke-linejoin=\"round\"/></svg>',\n};\n\n/** The stick, as SVG. */\nconst STICK = '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\" stroke=\"#fff\" stroke-width=\"2.6\" fill=\"none\"/><circle cx=\"12\" cy=\"12\" r=\"3.4\" fill=\"#fff\"/></svg>';\n\n/** A pad glyph: an SVG or letters. */\nconst padGlyph = (text: string, kind = 'pad'): string => `<span class=\"tf-glyph\" data-kind=\"${kind}\" data-glyph=\"${text.length > 8 ? 'svg' : text}\">${text}</span>`;\n\n/** A key cap. */\nconst key = (text: string): string => `<span class=\"tf-glyph\" data-kind=\"key\" data-glyph=\"${text}\">${text}</span>`;\n\n/** A mouse with `button` lit. */\nfunction mouse(button: 'left' | 'right' | 'both' | 'none'): string {\n  const left = button === 'left' || button === 'both' ? '#ff8a70' : 'none';\n  const right = button === 'right' || button === 'both' ? '#ff8a70' : 'none';\n  return `<span class=\"tf-glyph\" data-kind=\"mouse\" data-glyph=\"mouse-${button}\"><svg viewBox=\"0 0 16 22\"><path d=\"M8 1v8H1.2V8A6.8 7 0 0 1 8 1Z\" fill=\"${left}\"/><path d=\"M8 1v8h6.8V8A6.8 7 0 0 0 8 1Z\" fill=\"${right}\"/><path d=\"M8 1v8M1.2 9h13.6\" stroke=\"#3a4a55\" stroke-width=\"1.2\" fill=\"none\"/></svg></span>`;\n}\n\n/** Each verb on a pad, PlayStation then Xbox. */\nconst PAD: Readonly<Record<Verb, readonly [string, string]>> = {\n  confirm: [FACE.cross, 'A'],\n  cancel: [FACE.circle, 'B'],\n  lean: [STICK, STICK],\n  footL: ['L2', 'LT'],\n  footR: ['R2', 'RT'],\n  both: ['L2+R2', 'LT+RT'],\n  pause: ['Options', 'Menu'],\n  plan: [FACE.triangle, 'Y'],\n  wave: [FACE.circle, 'B'],\n  hop: [FACE.square, 'X'],\n  use: [FACE.cross, 'A'],\n  look: ['R', 'R'],\n  walk: [STICK, STICK],\n  pageL: ['L1', 'LB'],\n  pageR: ['R1', 'RB'],\n  more: [FACE.triangle, 'Y'],\n  any: [FACE.cross, 'A'],\n};\n\n/** Each verb on keys, and with the mouse. */\nconst KEYS: Readonly<Record<Verb, () => string>> = {\n  confirm: () => key('Enter'),\n  cancel: () => key('Esc'),\n  lean: () => key('WASD'),\n  footL: () => key('Q'),\n  footR: () => key('E'),\n  both: () => key('Space'),\n  pause: () => key('Esc'),\n  plan: () => key('Tab'),\n  wave: () => key('C'),\n  hop: () => key('Space'),\n  use: () => key('E'),\n  look: () => mouse('none'),\n  walk: () => key('WASD'),\n  pageL: () => key('Q'),\n  pageR: () => key('E'),\n  more: () => key('T'),\n  any: () => key('Any key'),\n};\n\n/** Each verb with a mouse, where it has its own. */\nconst MOUSE: Partial<Readonly<Record<Verb, () => string>>> = {\n  confirm: () => mouse('left'),\n  lean: () => mouse('none'),\n  footL: () => mouse('left'),\n  footR: () => mouse('right'),\n  both: () => mouse('both'),\n  use: () => mouse('left'),\n  look: () => mouse('none'),\n};\n\n/** The HTML of `verb`'s glyph for a device and a set. */\nexport function glyph(verb: Verb, device: Device, set: GlyphSet): string {\n  if (device === 'gamepad') return padGlyph(PAD[verb][set === 'xbox' ? 1 : 0]);\n  if (device === 'mouse') return (MOUSE[verb] ?? KEYS[verb])();\n  return KEYS[verb]();\n}\n\n/** A prompt: a glyph and a word. */\nexport const promptHtml = (verb: Verb, word: string, device: Device, set: GlyphSet): string =>\n  `<span class=\"tf-prompt\">${glyph(verb, device, set)}<span>${word}</span></span>`;\nEOF\ncat > labs/game/ui/panel.ts <<'EOF'\n/**\n * @file The one list widget of the front end: at most six rows on a page at 10 feet, focus unmistakable from a sofa. D-pad,\n * stick, arrows or hover move the focus; Cross, Enter or a click picks; left and right adjust a value row; Circle or Esc\n * cancels. It reads the engine's system layer, which no map can rebind. Plan: `createMenu` does the lists, but Settings\n * needs value rows and paging, so one widget does all of them (called out in labs/game/README.md).\n *\n * Game code, a page's.\n *\n * @example\n * // new Panel(root, { title: 'Paused', rows: [{ id: 'resume', label: 'Resume' }], onPick: (id) => close() });\n */\nimport type { Input } from '../../../engine';\n\n/** Rows at most, per page. */\nexport const MAX_ROWS = 6;\n\n/** A row. */\nexport interface Row {\n  id: string;\n  label: string;\n  /** Shown at the right, or a 0-1 bar when `bar` is set. */\n  value?: () => string;\n  bar?: () => number;\n  /** Left and right change it. */\n  adjust?: (dir: -1 | 1, big: boolean) => void;\n  /** Dragging the bar sets it, 0 to 1. */\n  setBar?: (u: number) => void;\n  disabled?: boolean;\n}\n\n/** What a panel takes. */\nexport interface PanelOptions {\n  id: string;\n  title?: string;\n  sub?: string;\n  rows: Row[];\n  onPick?: (id: string) => void;\n  onCancel?: () => void;\n  sound?: (cue: 'move' | 'pick' | 'cancel') => void;\n  /** A class for where it sits. */\n  className?: string;\n  /** Rows on a page, if fewer than the most. */\n  perPage?: number;\n}\n\n/** A repeating direction: fires at once, again after 0.35 s, then every 0.11 s. */\nexport class Repeat {\n  private held = new Map<string, number>();\n  fire(input: Input, action: string, dt: number): boolean {\n    if (input.pressed(action)) {\n      this.held.set(action, 0);\n      return true;\n    }\n    if (!input.held(action)) {\n      this.held.delete(action);\n      return false;\n    }\n    const before = this.held.get(action) ?? 0;\n    const now = before + dt;\n    this.held.set(action, now);\n    const count = (t: number) => (t < 0.35 ? 0 : 1 + Math.floor((t - 0.35) / 0.11));\n    return count(now) > count(before);\n  }\n}\n\n/** A list of rows, paged. */\nexport class Panel {\n  readonly el: HTMLElement;\n  private rows: Row[];\n  private index = 0;\n  private page = 0;\n  private list: HTMLElement;\n  private rowEls: HTMLElement[] = [];\n  private repeat = new Repeat();\n  active = true;\n\n  constructor(\n    parent: HTMLElement,\n    readonly options: PanelOptions,\n  ) {\n    this.rows = options.rows;\n    const el = document.createElement('div');\n    el.className = `tf-panel ${options.className ?? ''}`;\n    el.dataset.panel = options.id;\n    if (options.title) {\n      const h = document.createElement('div');\n      h.className = 'tf-h1';\n      h.textContent = options.title;\n      el.append(h);\n    }\n    if (options.sub) {\n      const s = document.createElement('div');\n      s.className = 'tf-sub';\n      s.textContent = options.sub;\n      el.append(s);\n    }\n    this.list = document.createElement('div');\n    this.list.className = 'tf-rows';\n    el.append(this.list);\n    parent.append(el);\n    this.el = el;\n    this.draw();\n    this.index = this.firstEnabled();\n    this.mark();\n  }\n\n  /** Rows on a page, the \"More\" row counting. */\n  private get perPage(): number {\n    return Math.min(MAX_ROWS, this.options.perPage ?? MAX_ROWS);\n  }\n\n  /** The rows on this page, with paging rows laid in. */\n  private pageRows(): Row[] {\n    const n = this.perPage;\n    if (this.rows.length <= n) return this.rows;\n    const size = n - 1;\n    const pages = Math.ceil(this.rows.length / size);\n    const start = this.page * size;\n    const out = this.rows.slice(start, start + size);\n    out.push({ id: '__more', label: this.page + 1 < pages ? 'More…' : 'Back to the top' });\n    return out;\n  }\n\n  private firstEnabled(): number {\n    const rows = this.pageRows();\n    const i = rows.findIndex((r) => !r.disabled);\n    return i < 0 ? 0 : i;\n  }\n\n  /** Builds this page's elements. */\n  private draw(): void {\n    this.list.textContent = '';\n    this.rowEls = this.pageRows().map((row, i) => {\n      const el = document.createElement('div');\n      el.className = 'tf-row';\n      el.dataset.ui = 'item';\n      el.dataset.id = row.id;\n      if (row.disabled) el.dataset.disabled = 'true';\n      const label = document.createElement('span');\n      label.textContent = row.label;\n      el.append(label);\n      if (row.value || row.bar) {\n        const value = document.createElement('span');\n        value.className = 'tf-value';\n        if (row.bar) {\n          const bar = document.createElement('span');\n          bar.className = 'tf-bar';\n          bar.append(document.createElement('i'));\n          value.append(bar);\n          const set = (event: PointerEvent) => {\n            const box = bar.getBoundingClientRect();\n            row.setBar?.(Math.max(0, Math.min(1, (event.clientX - box.left) / box.width)));\n          };\n          bar.addEventListener('pointerdown', (event) => {\n            event.stopPropagation();\n            set(event);\n            bar.setPointerCapture(event.pointerId);\n          });\n          bar.addEventListener('pointermove', (event) => {\n            if (event.buttons) set(event);\n          });\n        }\n        const text = document.createElement('span');\n        text.dataset.value = '1';\n        value.append(text);\n        el.append(value);\n      }\n      el.addEventListener('pointermove', (event) => {\n        if ((event.movementX !== 0 || event.movementY !== 0) && this.active && !row.disabled && this.index !== i) {\n          this.index = i;\n          this.options.sound?.('move');\n          this.mark();\n        }\n      });\n      el.addEventListener('click', () => {\n        if (!this.active || row.disabled) return;\n        this.index = i;\n        this.mark();\n        if (row.adjust && !row.bar) {\n          row.adjust(1, false);\n          this.refresh();\n        } else this.pick();\n      });\n      this.list.append(el);\n      return el;\n    });\n    this.refresh();\n  }\n\n  /** Marks the focused row. */\n  private mark(): void {\n    this.rowEls.forEach((el, i) => {\n      el.dataset.focus = i === this.index ? 'true' : 'false';\n    });\n    this.el.dataset.focus = this.pageRows()[this.index]?.id ?? '';\n  }\n\n  /** Redraws the values. */\n  refresh(): void {\n    this.pageRows().forEach((row, i) => {\n      const el = this.rowEls[i];\n      if (!el) return;\n      const text = el.querySelector<HTMLElement>('[data-value]');\n      if (text && row.value) text.textContent = row.value();\n      const fill = el.querySelector<HTMLElement>('.tf-bar > i');\n      if (fill && row.bar) fill.style.width = `${Math.round(row.bar() * 100)}%`;\n    });\n  }\n\n  /** Replaces the rows, keeping the focus where it can. */\n  setRows(rows: Row[]): void {\n    this.rows = rows;\n    this.draw();\n    this.index = Math.min(this.index, this.pageRows().length - 1);\n    this.mark();\n  }\n\n  /** The focused row's id. */\n  get focused(): string {\n    return this.pageRows()[this.index]?.id ?? '';\n  }\n\n  /** Moves the focus. */\n  private move(dir: -1 | 1): void {\n    const rows = this.pageRows();\n    let at = this.index;\n    for (let k = 0; k < rows.length; k++) {\n      at = (at + dir + rows.length) % rows.length;\n      if (!rows[at].disabled) break;\n    }\n    if (at !== this.index) {\n      this.index = at;\n      this.options.sound?.('move');\n      this.mark();\n    }\n  }\n\n  /** Picks the focused row. */\n  pick(): void {\n    const row = this.pageRows()[this.index];\n    if (!row || row.disabled) return;\n    if (row.id === '__more') {\n      const size = this.perPage - 1;\n      const pages = Math.ceil(this.rows.length / size);\n      this.page = (this.page + 1) % pages;\n      this.index = 0;\n      this.draw();\n      this.index = this.firstEnabled();\n      this.mark();\n      this.options.sound?.('move');\n      return;\n    }\n    this.options.sound?.('pick');\n    this.options.onPick?.(row.id);\n  }\n\n  /** One frame: reads the system layer. */\n  update(input: Input, dt: number): void {\n    if (!this.active) return;\n    if (this.repeat.fire(input, 'uiUp', dt)) this.move(-1);\n    if (this.repeat.fire(input, 'uiDown', dt)) this.move(1);\n    const row = this.pageRows()[this.index];\n    if (row?.adjust) {\n      if (this.repeat.fire(input, 'uiLeft', dt)) {\n        row.adjust(-1, false);\n        this.options.sound?.('move');\n        this.refresh();\n      }\n      if (this.repeat.fire(input, 'uiRight', dt)) {\n        row.adjust(1, false);\n        this.options.sound?.('move');\n        this.refresh();\n      }\n    }\n    if (input.pressed('uiAccept')) {\n      if (row?.adjust && !row.bar) {\n        row.adjust(1, false);\n        this.refresh();\n      } else this.pick();\n    } else if (input.pressed('uiCancel') && this.options.onCancel) {\n      this.options.sound?.('cancel');\n      this.options.onCancel();\n    }\n    this.refresh();\n  }\n\n  /** Takes it away. */\n  remove(): void {\n    this.el.remove();\n    this.active = false;\n  }\n}\nEOF\ncat > labs/game/ui/save.ts <<'EOF'\n/**\n * @file The save and the settings, in the page's store (PLAN.md section 5): the sim never reads them; the page hands the sim\n * its starting state through `game.begin`.\n *\n * Game code, a page's.\n *\n * @example\n * // const save = loadSave(store);\n */\nimport type { Store } from '../../../engine';\nimport type { Flow } from '../scenes/components';\n\n/** What is kept between sittings. */\nexport interface SaveData {\n  started: boolean;\n  day: number;\n  done: string[];\n  seen: string[];\n  pebbles: number;\n  found: number[];\n  ages: number[];\n  bests: Record<string, number>;\n  look: number;\n  color: string;\n  finished: boolean;\n}\n\n/** What the player has set. */\nexport interface SettingsData {\n  music: number;\n  effects: number;\n  voices: number;\n  glyphs: 'playstation' | 'xbox';\n  mouse: number;\n  invert: boolean;\n  rumble: boolean;\n  steadier: boolean;\n  reduced: boolean;\n  cpuGuests: boolean;\n}\n\n/** A fresh save. */\nexport const NEW_SAVE: SaveData = { started: false, day: 1, done: [], seen: [], pebbles: 0, found: [], ages: [], bests: {}, look: 0, color: 'coral', finished: false }; // prettier-ignore\n\n/** Fresh settings: music at 10%. */\nexport const NEW_SETTINGS: SettingsData = { music: 0.1, effects: 1, voices: 1, glyphs: 'playstation', mouse: 1, invert: false, rumble: true, steadier: false, reduced: false, cpuGuests: true }; // prettier-ignore\n\n/** Reads the save. */\nexport const loadSave = (store: Store): SaveData => ({ ...NEW_SAVE, ...store.get<Partial<SaveData>>('save', {}) });\n/** Reads the settings. */\nexport const loadSettings = (store: Store): SettingsData => ({ ...NEW_SETTINGS, ...store.get<Partial<SettingsData>>('settings', {}) });\n\n/** A save made from the sim's flow. */\nexport function saveFromFlow(flow: Flow, was: SaveData): SaveData {\n  return {\n    started: true,\n    day: flow.day,\n    done: [...flow.done],\n    seen: [...flow.seen],\n    pebbles: flow.pebbles,\n    found: [...flow.found],\n    ages: [...flow.ages],\n    bests: { ...flow.bests },\n    look: flow.look,\n    color: flow.color,\n    finished: was.finished || flow.day > 5,\n  };\n}\nEOF\ncat > labs/game/ui/shots.ts <<'EOF'\n/**\n * @file The purpose-built camera for each activity, as a table of functions from what is happening to where the camera\n * stands (PLAN.md section 6's table). The page calls `shotFor` each frame and `cam3=shot` eases towards the answer. Reduced\n * Motion takes out roll and shake.\n *\n * Game code, a page's.\n *\n * @example\n * // setShot(shotFor('line', view));\n */\nimport type { Shot } from '../cameras/shot';\nimport { STATIONS } from '../scenes/data/stations';\n\n/** What a shot may look at. */\nexport interface ShotView {\n  t: number;\n  phase: string;\n  guest: { x: number; y: number; z: number; yaw: number };\n  tiltX: number;\n  tiltZ: number;\n  reduced: boolean;\n  data: Record<string, unknown>;\n  seat?: number;\n  round: boolean;\n}\n\n/** A shot that frames a mat from the front, with a slow drift. */\nfunction matShot(v: ShotView): Shot {\n  const { x, z } = STATIONS.pavilion;\n  const drift = Math.sin(v.t * 0.12) * 2.4;\n  const { y } = v.guest;\n  return { at: [v.guest.x + 3.2 + drift, y + 2.4, v.guest.z - 5.6], look: [v.guest.x + 0.2, y + 1, v.guest.z], fov: 40, ease: 0.8, ...(x + z > 1e9 ? {} : {}) };\n}\n\n/** The table. */\nconst SHOTS: Readonly<Record<string, (v: ShotView) => Shot>> = {\n  mat: matShot,\n  platform: (v) => {\n    const push = Math.min(1, v.t / 12);\n    return { at: [v.guest.x + 0.6, v.guest.y + 1.5, v.guest.z - (6.4 - push * 1.8)], look: [v.guest.x, v.guest.y + 1.05, v.guest.z], fov: 38, ease: 1 };\n  },\n  reps: (v) => ({ at: [v.guest.x + 5.2, v.guest.y + 2, v.guest.z + 3.6], look: [v.guest.x - 0.5, v.guest.y + 0.9, v.guest.z - 0.4], fov: 42, ease: 0.9 }),\n  step: (v) => ({ at: [v.guest.x + 0.5, v.guest.y + 4, v.guest.z + 5.6], look: [v.guest.x, v.guest.y + 0.8, v.guest.z - 1], fov: 46, ease: 0.9 }),\n  pond: (v) => ({ at: [v.guest.x, v.guest.y + 1, v.guest.z - 5.2], look: [v.guest.x, v.guest.y + 0.75, v.guest.z], fov: 32, ease: 1.2 }),\n  line: (v) => ({ at: [v.guest.x + 4.4, v.guest.y + 3.6, v.guest.z - 7.5], look: [v.guest.x, v.guest.y + 0.8, v.guest.z + 3], fov: 46, ease: 0.45 }),\n  paddle: (v) => {\n    const [fx, fz] = [Math.sin(v.guest.yaw), Math.cos(v.guest.yaw)];\n    return { at: [v.guest.x - fx * 8.6, v.guest.y + 3.1, v.guest.z - fz * 8.6], look: [v.guest.x + fx * 3, v.guest.y + 0.9, v.guest.z + fz * 3], fov: 50, ease: 0.5 };\n  },\n  garden: (v) => {\n    const { x, z } = STATIONS.terrace;\n    const y = v.guest.y;\n    return { at: [x, y + 5, z + 1.8], look: [x, y + 0.92, z], fov: 34, ease: 0.8 };\n  },\n  plunge: (v) => {\n    const { x } = STATIONS.cliff;\n    if (v.phase === 'cards') return { at: [x + 10.5, 2.5, v.guest.z + 6.5], look: [x - 3, 3.3, v.guest.z - 3], fov: 44, ease: 0.25 };\n    if (v.phase === 'air') return { at: [x + 13, Math.max(3.2, v.guest.y + 1), v.guest.z + 3], look: [x, v.guest.y, v.guest.z - 2], fov: 50, ease: 0.25 };\n    return { at: [x + 7, v.guest.y + 1.7, v.guest.z + 1.2], look: [x, v.guest.y + 1, v.guest.z - 1.5], fov: 44, ease: 0.8 };\n  },\n  hoop: (v) => ({ at: [v.guest.x + 1.6, v.guest.y + 2.1, v.guest.z - 6], look: [v.guest.x, v.guest.y + 1, v.guest.z], fov: 42, ease: 0.8 }),\n  jog: (v) => {\n    const [fx, fz] = [Math.sin(v.guest.yaw), Math.cos(v.guest.yaw)];\n    return { at: [v.guest.x - fx * 7, v.guest.y + 3.6, v.guest.z - fz * 7], look: [v.guest.x + fx * 4, v.guest.y + 1.1, v.guest.z + fz * 4], fov: 54, ease: 0.6 };\n  },\n  tilt: (v) => {\n    const roll = v.reduced ? 0 : (v.tiltX * Math.PI) / 180;\n    if (v.phase === 'storm') {\n      const plumbClose = v.t > 3 && v.t < 11;\n      const at: [number, number, number] = plumbClose ? [3.4, 10.2, 22.2] : [14, 18, 56];\n      const look: [number, number, number] = plumbClose ? [2, 9.3, 26] : [0, 8, 26];\n      return { at, look, fov: plumbClose ? 30 : 46, roll: roll * 0.5, ease: 0.9 };\n    }\n    if (v.phase === 'stone') {\n      const a = v.t * 0.045;\n      return { at: [Math.sin(a) * 92, 54, Math.cos(a) * 92], look: [0, 8, 0], fov: 46, roll, ease: 1.1 };\n    }\n    if (v.phase === 'dawn') return { at: [v.guest.x + 3.6, v.guest.y + 1.7, v.guest.z - 5], look: [v.guest.x + 1, v.guest.y + 1, v.guest.z + 1], fov: 38, ease: 1.2 };\n    if (v.phase === 'weights') return { at: [v.guest.x - 2, v.guest.y + 4.2, v.guest.z - 9], look: [v.guest.x + 2, v.guest.y + 0.8, v.guest.z + 1], fov: 48, roll: roll * 0.4, ease: 0.8 };\n    return { at: [v.guest.x - 9, v.guest.y + 8, v.guest.z - 3], look: [v.guest.x + 8, v.guest.y, v.guest.z], fov: 50, roll: roll * 0.7, ease: 0.6 };\n  },\n  title: (v) => {\n    const a = v.t * 0.05;\n    return { at: [Math.sin(a) * 130, 42, Math.cos(a) * 130], look: [0, 10, 0], fov: 42, ease: 0 };\n  },\n  card: (v) => {\n    const { x, z } = STATIONS.pavilion;\n    const a = Math.sin(v.t * 0.12) * 2;\n    return { at: [x + a, 11.6, z + 18], look: [x, 9, z + 2], fov: 42, ease: 0.8 };\n  },\n  credits: (v) => {\n    const a = v.t * 0.05;\n    return { at: [Math.sin(a) * 28 + 2, 13, Math.cos(a) * 28 + 26], look: [2, 8.8, 28], fov: 40, ease: 1.2 };\n  },\n};\n\n/** The shot for a name. */\nexport function shotFor(name: string, view: ShotView): Shot {\n  return (SHOTS[name] ?? SHOTS.title)(view);\n}\n\n/** Every shot's name, for tests. */\nexport const SHOT_NAMES = Object.keys(SHOTS);\nEOF\n","description":"Write theme, glyphs, panel widget, save and camera shots"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014wGrrb2ocHxMpKDMy2H18H","type":"tool_result","content":"(Bash completed with no output)","is_error":false}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"3655d049-d931-4b2a-9d5c-af6b5aedd419","timestamp":"2026-11-05T10:14:23.553Z","tool_use_result":{"stdout":"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014wGrrb2ocHxMpKDMy2H18H","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
