s=s.replace(\"\"\"  background: '#f6c9a8',\n  dome: { show: true, turbidity: 6, rayleigh: 2.4, mieCoefficient: 0.01, mieDirectionalG: 0.85, exposure: 0.38 },\"\"\",\"\"\"  background: '#f6c9a8',\n  dome: { show: false },\"\"\")\ns=s.replace(\"fog: { color: '#f4ccb0', start: 70, end: 360, amount: 0.6, floor: 0, ceiling: 1.5, height: 0 },\",\"fog: { color: '#f6c9a8', start: 130, end: 760, amount: 1, floor: 0, ceiling: 1.5, height: 0 },\")\ns=s.replace(\"fog: { color: '#46525e', start: 30, end: 190, amount: 0.9, floor: 0, ceiling: 1.5, height: 0 },\",\"fog: { color: '#39444f', start: 30, end: 300, amount: 1, floor: 0, ceiling: 1.5, height: 0 },\")\nopen(p,'w').write(s)\np='labs/game/props/core.ts'\ns=open(p).read()\ns=s.replace(\"[box('water', 900, 0.1, 900, 'material:seawater')]\",\"[box('water', 3200, 0.1, 3200, 'material:seawater')]\")\nopen(p,'w').write(s)\np='labs/game/scenes/terrain.ts'\ns=open(p).read()\ns=s.replace(\"{ at: [0, 0], radius: 32, height: 3.5 },\",\"{ at: [0, 0], radius: 44, height: 3.5 },\")\ns=s.replace(\"{ at: [0, -82], radius: 18, height: 5 },\",\"{ at: [0, -58], radius: 34, height: 6 },\\n    { at: [0, -82], radius: 16, height: 5 },\")\ns=s.replace(\"flat('centre', 3, 14, 6),\",\"flat('centre', 3, 14, 12),\")\ns=s.replace(\"flat('cliff', 7, 16, 5),\",\"flat('cliff', 7, 15, 9),\")\nopen(p,'w').write(s)\np='labs/game/scenes/data/stations.ts'\ns=open(p).read()\ns=s.replace(\"cliff: { id: 'cliff', title: 'North Cliff', x: 0, z: -80, yaw: Math.PI, y: 16 },\",\"cliff: { id: 'cliff', title: 'North Cliff', x: 0, z: -80, yaw: Math.PI, y: 15 },\")\nopen(p,'w').write(s)\np='labs/game/materials/retreat.ts'\ns=open(p).read()\ns=s.replace(\"map: { texture: 'texture:dirt', seed: 4, params: { base: '#f4e8c8', dark: '#e6d6ac' } },\",\"map: { texture: 'texture:plaster', seed: 4, params: { plaster: '#f4e8c8', shade: '#efe2bd' } },\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/tools/flow1.py <<'EOF'\n\"\"\"A quick drive of the built page: begin, walk, start an activity by query. Usage: flow1.py <html> <out-prefix> <event> [seconds]\"\"\"\nimport os, sys, json, time\nfrom playwright.sync_api import sync_playwright\nhtml = os.path.abspath(sys.argv[1]); prefix = sys.argv[2]; event = sys.argv[3]; seconds = float(sys.argv[4]) if len(sys.argv) > 4 else 6\nwith sync_playwright() as p:\n    b = p.chromium.launch(executable_path=os.environ.get('CHROMIUM_PATH'), args=['--no-sandbox', '--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    pg = b.new_page(viewport={'width': 1920, 'height': 1080})\n    pg.on('console', lambda m: print('CONSOLE', m.type, m.text[:500]) if m.type == 'error' else None)\n    pg.on('pageerror', lambda e: print('PAGEERROR', str(e)[:800]))\n    pg.goto('file://' + html + '?gfx.warmUp=asked&gfx.governor=false&quality=medium')\n    pg.wait_for_function(\"() => window.__game && window.__engine && window.__engine.ready\", timeout=120000)\n    pg.evaluate(\"() => { localStorage.clear(); }\")\n    pg.keyboard.press('Enter'); pg.wait_for_timeout(500)\n    pg.keyboard.press('ArrowDown'); pg.wait_for_timeout(100); pg.keyboard.press('ArrowDown'); pg.wait_for_timeout(100)\n    pg.keyboard.press('Enter'); pg.wait_for_timeout(1500)\n    print(json.dumps(pg.evaluate(\"() => window.__game\"))[:400])\n    if event != 'none':\n        for ev in event.split(','):\n            pg.evaluate(\"(e) => __engine.actions.run('game.start', { event: e })\", ev)\n            pg.evaluate(\"() => __engine.set('game.auto', true)\")\n            pg.wait_for_timeout(int(seconds * 1000))\n            print(json.dumps(pg.evaluate(\"() => window.__game\"))[:300])\n            pg.screenshot(path=f'{prefix}-{ev}.png')\n            pg.evaluate(\"() => __engine.set('game.auto', false)\")\n            pg.evaluate(\"() => __engine.actions.run('game.leave')\")\n            pg.wait_for_timeout(300)\n    else:\n        pg.wait_for_timeout(int(seconds * 1000))\n        pg.screenshot(path=f'{prefix}-roam.png')\n    b.close()\nEOF\nexport CHROMIUM_PATH=$HOME/.cache/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell; timeout 200 node labs/game/tools/onefile.mjs out/game.html 2>&1 | tail -1 | cut -c1-300; timeout 250 python3 labs/game/tools/flow1.py out/game.html out/f none 6 2>&1 | tail -6 | cut -c1-500","description":"Tune sky and terrain, build, and drive into roam","timeout":500000}}}
