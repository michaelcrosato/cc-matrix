, 28],\n    ['bex', 'Lighthouse', 6, 28],\n    ['nan', 'Nothing', 2, 31],\n    ['plumb', 'Archer', -4, 24],\n    ['tare', 'Bow', 8, 25],\n  ];\n  for (const [who, pose, x, z] of line) {\n    const person = castOf(w, who);\n    if (person) Object.assign(person.cast, { hold: true, x, y: groundAt(w, x, z) + 0.05, z, yaw: 0.2, pose, poseT: 1, leanX: 0, leanY: 0 });\n  }\n}\n\n/** Leaves the results screen. */\"\"\")\ns=s.replace(\"import { say } from './events/kit';\",\"import { castOf, say } from './events/kit';\")\ns=s.replace(\"import { flowOf, leaveActivity, startActivity } from './flow';\",\"import { flowOf, groundAt, leaveActivity, startActivity } from './flow';\")\nopen('labs/game/scenes/ending.ts','w').write(s)\ns=open('labs/game/scenes/actions.ts').read()\ns=s.replace(\"\"\"    const { on } = (args ?? {}) as { on: boolean };\n    flowOf(w).credits = on;\"\"\",\"\"\"    const { on } = (args ?? {}) as { on: boolean };\n    flowOf(w).credits = on;\n    if (!on) releaseAll({ w });\"\"\")\ns=s.replace(\"import { castOf, enter } from './events/kit';\",\"import { castOf, enter, releaseAll } from './events/kit';\")\nopen('labs/game/scenes/actions.ts','w').write(s)\ns=open('labs/game/scenes/director.ts').read()\ns=s.replace(\"\"\"    if (flow.cutTick > 600) {\n      flow.credits = false;\n      flow.cutTick = 0;\n    }\"\"\",\"\"\"    if (flow.cutTick > 600) {\n      flow.credits = false;\n      flow.cutTick = 0;\n      releaseAll({ w });\n    }\"\"\")\ns=s.replace(\"import { leaveResults } from './ending';\",\"import { leaveResults } from './ending';\\nimport { releaseAll } from './events/kit';\")\nopen('labs/game/scenes/director.ts','w').write(s)\nEOF\ngrep -n \"hud.show = {\" labs/game/scenes/events/pond.ts | head -3; grep -n \"composure:\" labs/game/scenes/events/pond.ts | head; sed -n 1,5p /dev/null; npx prettier --write labs/game/scenes labs/game/props > /dev/null; timeout 250 npx tsc -b tsconfig.check.json 2>&1 | grep -E \"labs/game|error\" | head -12 | cut -c1-2