es=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    pg = b.new_page(viewport={'width': 1600, 'height': 900})\n    pg.goto(f'http://127.0.0.1:{port}/harness.html?game=game.html&players=2&latency=150&jitter=50&loss=5')\n    games = lambda: [f for f in pg.frames if 'game.html' in f.url]\n    end = time.time() + 120\n    while time.time() < end and (len(games()) < 2 or not all(g.evaluate(\"() => !!document.querySelector('[data-ui=hubcard]')\") for g in games())):\n        pg.wait_for_timeout(500)\n    print('card shows', [g.evaluate(\"() => { const c = document.querySelector('[data-ui=hubcard]'); return c ? c.innerText.slice(0, 70) : null; }\") for g in games()])\n    for g in games():\n        g.evaluate(\"() => { const r = document.querySelector('[data-card=ready]'); if (r) r.click(); }\")\n    end = time.time() + 120\n    while time.time() < end and not all(g.evaluate(\"() => { const e = window.__engine; return !!(e && e.state && e.state('flow').entities[0].flow.mode === 'event'); }\") for g in games()):\n        pg.wait_for_timeout(500)\n    pg.wait_for_timeout(9000)\n    print('in play', [g.evaluate(\"() => { const e = __engine; const a = e.state('activity').entities[0].activity; return [__game.mode, __game.event, a.data.classes, e.state('ghost').entities.length, e.ready, e.errors.length]; }\") for g in games()])\n    print('ghost lean', [g.evaluate(\"() => __engine.state('ghost').entities.map((x) => [x.ghost.id, x.ghost.t, x.ghost.e, x.ghost.active])\") for g in games()])\n    print('labels', games()[0].evaluate(\"() => [...document.querySelectorAll('[data-ui=label]')].map((e) => e.textContent).slice(0, 4)\"))\n    pg.screenshot(path=shot)\n    pg.get_by_text('Time up').first.click()\n    pg.wait_for_timeout(5000)\n    print('after time up', pg.evaluate(\"() => (window.__hubCheck && window.__hubCheck.log || []).slice(-3)\"))\n    print('errors', [g.evaluate(\"() => __engine.errors.length\") for g in games()] if games() else 'frames gone')\n    b.close()\nserver.shutdown()\nshutil.rmtree(work, ignore_errors=True)\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_019e8N9qJjeSYUFNyg4bBRK2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
