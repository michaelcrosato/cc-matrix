 {\n  description: 'Pale green spores drifting up, swirling and fading (replace).',\n  area: [0.2, 0.1, 0.2],\n  velocity: [0, 0.8, 0],\n  spread: 0.5,\n  gravity: -0.3,\n  drag: 0.8,\n  turbulence: 1.5,\n  life: [0.8, 1.6],\n  size: [0.06, 0],\n  color: ['#c8ff9a', '#6ad16a'],\n  brightness: [1.5, 1],\n  alpha: [0.9, 0],\n  count: 16,\n  events: ['{{name}}'],\n  gallery: { camera: 'front', duration: 0, states: [] }, // node x gallery: four frames of its burst\n});\n/**\n * @file The effect `sfx:{{name}}`: what it is the sound of (replace this text; `x docs` puts the first sentence in INDEX).\n *\n * Invariants: voices in the chip synth's words (wave, freq, to, dur, vol, arp, vib, filter…; node x describe sfx lists\n * the kind's fields, engine/audio/dsp/voice.ts a voice's); `layers` mix other effects in ({ sfx, at, vol, pitch });\n * `variants` versions spread ±`vary` in pitch, for a sound heard often; `bus` is effects, ui or ambience.\n *\n * @example\n * {{name}}.id; // 'sfx:{{name}}'\n * @see {{id}}.test.ts\n */\nimport { defineSfx } from '../../../engine';\n\n/** The effect `sfx:{{name}}`: replace this sentence with what it is the sound of. */\nexport const {{name}} = defineSfx('sfx:{{name}}', {\n  voices: { wave: 'square', freq: 440, to: 880, dur: 0.12, vol: 0.25 },\n  variants: 4,\n});\n/**\n * @file The song `song:{{name}}`: where it plays and its mood (replace this text; `x docs` puts the first sentence in INDEX).\n *\n * Invariants: tracker notation, one token per step: a note (C4, F#3, Bb2), - holding the note before it, . a rest,\n * and | a bar line, which takes no step; a drums track writes the kit's tokens (k kick, s snare, h hat, o open hat,\n * c crash, t tom). At `steps` per beat and `beats` per bar, every track fills whole bars or divides one (node x\n * describe song lists the fields; engine/audio/data/song.ts gives the rules). `intensity` makes a track join only\n * when the music's intensity reaches it.\n *\n * @example\n * import { songTiming } from '../../../engine';\n * songTiming({{name}}).seconds; // 4: two bars of 4/4 at 120 bpm\n * @see {{id}}.test.ts\n */\nimport { defineSong } from '../../../engine';\n\n/** The song `song:{{name}}`: replace this sentence with where it plays. */\nexport const {{name}} = defineSong('song:{{name}}', {\n  bpm: 120,\n  tracks: [\n    { wave: 'square', vol: 0.12, notes: 'C5 - E5 - G5 - E5 - D5 - F5 - A5 - G5 - | E5 - - - D5 - - - C5 - - - - - . .' },\n    { wave: 'triangle', vol: 0.25, notes: 'C3 - - - G2 - - - C3 - - - G2 - - - | C3 - - - G2 - - - C3 - - - . . . .' },\n    { wave: 'drums', vol: 0.12, intensity: 0.25, notes: 'k . h . s . h . k . h . s . h h' },\n  ],\n});\n/**\n * @file The body `body:{{name}}`: who wears it (replace this text; `x docs` puts the first sentence in INDEX).\n *\n * Parts hang on the humanoid skeleton's joints and sockets, one line each (engine/gfx/puppets/grammar.ts lists the\n * part types and point forms); `mirror` holds the parts written for the left side, drawn on the right too; `slots`\n * are the default colours, which a palette overrides per character (`recolor`).\n *\n * Invariants: sizes in metres at size 1, or `[k, 'head' | 'limb' | 'torso']`; every slot a part names is in `slots`.\n *\n * @example\n * {{name}}.id; // 'body:{{name}}'\n * @see {{id}}.test.ts\n */\nimport { defineBody } from '../../../engine';\n\n/** The body `body:{{name}}`: replace this sentence with who wears it. */\nexport const {{name}} = defineBody('body:{{name}}', {\n  description: 'Replace this sentence with who wears it.',\n  slots: { skin: '#e0b090', cloth: '#406080', eye: '#101014' },\n  parts: [\n    ['limb', 'thighL', 'thighR', [1.2, 'limb'], [1.2, 'limb'], 'cloth', { on: 'pelvis' }],\n    ['limb', ['off', 'spine0', 0, 0, 0.05], 'chest', [0.6, 'torso'], [0.65, 'torso'], 'cloth', { on: 'spine1' }],\n    ['limb', 'chest', 'neck', [0.65, 'torso'], [0.7, 'torso'], 'cloth'],\n    ['limb', 'upperArmL', 'upperArmR', [1.1, 'limb'], [1.1, 'limb'], 'cloth', { on: 'chest' }],\n    ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'],\n  ],\n  mirror: [\n    ['limb', 'thighL', 'shinL', [1.3, 'limb'], [1.1, 'limb'], 'cloth'],\n    ['limb', 'shinL', 'footL', [1.1, 'limb'], [1, 'limb'], 'skin'],\n    ['limb', 'footL', 'toeL', [1, 'limb'], [0.85, 'limb'], 'skin'],\n    ['limb', 'upperArmL', 'forearmL', [1.05, 'limb'], [0.95, 'limb'], 'cloth'],\n    ['limb', 'forearmL', 'handL', [0.95, 'limb'], [0.85, 'limb'], 'skin'],\n    ['eye', 'eyeL', [0.12, 'head'], 'eye'],\n  ],\n  build: 'build:heroic', // the build it is made for: node x gallery draws it on it\n  gallery: { camera: 'front', duration: 0, states: ['idle', 'walk', 'run', 'kneel'] }, // a frame a state\n});\n/**\n * @file The build `build:{{name}}`: whose body it is (replace this text; `x docs` puts the first sentence in INDEX).\n *\n * Invariants: lengths in metres before `size`, which scales them all; a field left out keeps `build:chibi`'s value\n * (node x describe build lists the fields with their defaults); hipHeight is at most legUpper + legLower.\n *\n * @example\n * {{name}}.id; // 'build:{{name}}'\n * @see {{id}}.test.ts\n */\nimport { defineBuild } from '../../../engine/sim-api';\n\n/** The build `build:{{name}}`: replace this sentence with whose body it is. */\nexport const {{name}} = defineBuild('build:{{name}}', {\n  size: 1,\n  legUpper: 0.42,\n  legLower: 0.42,\n  hipHeight: 0.81,\n  torso: 0.55,\n  headRadius: 0.2,\n});\n/**\n * @file The look `look:{{name}}`: what the picture looks like (replace this text; `x docs` puts the first sentence in\n * INDEX). It starts as the scenery in 24 shades a channel, softly dithered, the characters and objects inked, the\n * whole picture a little warmer.\n *\n * Invariants: data only, the kind's fields (`node x describe look`): the filters it turns on, each with its scope\n * (all, characters, objects, environment, or two joined by '+') and numbers, every filter left out off; and a\n * material style (`style`: lambert, toon, flat, pbr), which only a page whose chain has a style set applies (advice\n * `GFX_POST_NO_STYLES` otherwise; '' keeps the scene's own). Levels are 0 (off) or 8 and more (24 suits pixel art),\n * so dull colours keep their hue. It may lay other looks on first (`combine`: each a look, an `amount` and `only` some\n * of its filters; its own filters that are on go over them) and fade the whole (`strength`). A page draws it when its\n * setting `post.look` names it; `__engine.look()` there gives the filters it draws.\n *\n * @example\n * look.id; // 'look:{{name}}'\n * @see {{id}}.test.ts\n */\nimport { defineLook } from '../../../engine';\n\n/** The look `look:{{name}}`: replace this sentence with what it looks like. */\nexport const look = defineLook('look:{{name}}', {\n  description: 'The scenery in 24 soft shades, the characters and objects inked, the picture warmer (replace).',\n  style: '',\n  filters: {\n    outline: { scope: 'characters+objects', width: 2, darken: 0 },\n    palette: { scope: 'environment', levels: 24, dither: 0.3 },\n    grade: { scope: 'all', temperature: 0.2, saturation: 1.1 },\n  },\n  combine: [{ look: 'look:vignette/soft', amount: 0.8 }], // looks laid on under its own filters\n  strength: 1, // how much of the whole look shows\n  gallery: { camera: 'front', duration: 0, states: [] }, // node x gallery: the gallery's set in it\n});\n/**\n * @file The action `action:{{name}}`: what sequence it is (replace this text; `x docs` puts the first sentence in INDEX).\n *\n * Invariants: each beat lasts its seconds and eases its channels to its own over them; effector targets are\n * `[forward, right, up]` metres, the hands' and the gaze's from the shoulder centre, the soles' from the ground; a beat\n * held `until: 'next'` or a loop needs `check.signals` (node x describe action lists the fields; data/anim/actions/\n * holds the engine's set, each a worked example).\n *\n * @example\n * {{name}}.id; // 'action:{{name}}'\n * @see {{id}}.test.ts\n */\nimport { defineAction } from '../../../engine/sim-api';\n\n/** The action `action:{{name}}`: replace this sentence with what sequence it is. */\nexport const {{name}} = defineAction('action:{{name}}', {\n  desc: 'Replace with what it is and where its timing comes from.',\n  beats: [\n    { name: 'wind', seconds: 0.15, motion: { lean: 0.15 } },\n    { name: 'reach', seconds: 0.2, effectors: { handR: [0.4, 0.15, -0.1] }, events: [{ type: 'contact', at: 1 }] },\n    { name: 'hold', seconds: 0.25, effectors: { handR: [0.4, 0.15, -0.1] } },\n    { name: 'recover', seconds: 0.2, cancel: { by: ['any'] } },\n  ],\n});\n/**\n * @file The material `material:{{name}}`: what it looks like and where it is used (replace this text; `x docs` puts\n * the first sentence in INDEX).\n *\n * Invariants: data only, three.js's classic parameters (node x describe material lists them); its map names a texture\n * defined before it (node x describe texture lists them, with their parameters).\n *\n * @example\n * {{name}}.id; // 'material:{{name}}'\n * @see {{id}}.test.ts\n */\nimport { defineMaterial } from '../../../engine';\n\n/** The material `material:{{name}}`: replace this sentence with what it is. */\nexport const {{name}} = defineMaterial('material:{{name}}', {\n  description: 'What it is for, in plain sentences (replace).',\n  color: '#ffffff',\n  map: { texture: 'texture:stone', seed: 1, params: { wear: 0.3 } },\n  roughness: 0.8,\n  gallery: { camera: 'front', duration: 0, states: [] }, // node x gallery: a cube in it\n});\n/**\n * @file The geometry `geometry:{{name}}`: what it is (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a crate: a rounded box standing on the ground, sized and rounded by its parameters.\n *\n * Invariants: built from the engine's geometry kit (boxGeometry, roundedBoxGeometry, rampGeometry, frustumGeometry,\n * ringGeometry, limbGeometry, mergeGeometries, sidesThenTops), so it stands on the ground, in metres, with normals\n * and UVs in metres; within its vertex budget at its defaults (`node x qa geo` checks it).\n *\n * @example\n * {{name}}.budget; // 300\n * @see {{id}}.test.ts\n */\nimport { defineGeometry, roundedBoxGeometry } from '../../../engine';\n\n/** The geometry `geometry:{{name}}`: replace this sentence with what it is. */\nexport const {{name}} = defineGeometry('geometry:{{name}}', {\n  description: 'A crate: a rounded box standing on the ground (replace).',\n  params: {\n    size: { type: 'number', default: 0.8, minimum: 0.1, maximum: 10, unit: 'm', description: 'Its side.' },\n    radius: {\n      type: 'number',\n      default: 0.04,\n      minimum: 0,\n      maximum: 0.5,\n      unit: 'm',\n      description: 'The rounding of its edges, at most half its side.',\n    },\n  },\n  budget: 300,\n  create: ({ size, radius }) =>\n    roundedBoxGeometry({ width: size, height: size, depth: size, radius: Math.min(radius, size / 2), segments: 2 }),\n});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0196e7Dj6SPm1JhPpjvcCTPd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
