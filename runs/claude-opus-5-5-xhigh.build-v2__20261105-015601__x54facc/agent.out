 = (look: number, color: string): string => `body:guest${look}.${color}`;\"\"\",\"\"\"export const guestBody = (look: number, color: string, band = false): string => `body:guest${look}.${color}${band ? '.band' : ''}`;\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/actions.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  color?: string;\n  /** Start in roam\"\"\",\"\"\"  color?: string;\n  band?: boolean;\n  /** Start in roam\"\"\")\ns=s.replace(\"\"\"    respawnGuest(w, guestBody(flow.look, flow.color), guestBuild(flow.look));\"\"\",\"\"\"    respawnGuest(w, guestBody(flow.look, flow.color, a.band ?? false), guestBuild(flow.look));\"\"\")\ns=s.replace(\"\"\"  'game.markDone': (w: GameWorld, args: unknown) => {\"\"\",\"\"\"  'game.dress': (w: GameWorld, args: unknown) => {\n    const { color, band } = (args ?? {}) as { color: string; band: boolean };\n    const flow = flowOf(w);\n    flow.color = color;\n    respawnGuest(w, guestBody(flow.look, color, band), guestBuild(flow.look));\n  },\n  'game.markDone': (w: GameWorld, args: unknown) => {\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/save.ts'\ns=open(p).read()\ns=s.replace(\"  color: string;\\n  finished: boolean;\\n}\",\"  color: string;\\n  band: boolean;\\n  finished: boolean;\\n}\")\ns=s.replace(\"color: 'coral', finished: false };\",\"color: 'coral', band: false, finished: false };\")\ns=s.replace(\"  reduced: boolean;\\n  cpuGuests: boolean;\\n}\",\"  reduced: boolean;\\n  cpuGuests: boolean;\\n  expert: boolean;\\n}\")\ns=s.replace(\"reduced: false, cpuGuests: true };\",\"reduced: false, cpuGuests: true, expert: false };\")\ns=s.replace(\"    color: flow.color,\\n\",\"    color: flow.color,\\n    band: was.band,\\n\")\nopen(p,'w').write(s)\np='labs/game/ui/screens/settings.ts'\ns=open(p).read()\ns=s.replace(\"\"\"        toggle(host, 'cpuGuests', 'CPU guests in class', 'cpuGuests'),\n        { id: 'erase', label: 'Erase Save' },\"\"\",\"\"\"        toggle(host, 'cpuGuests', 'CPU guests in class', 'cpuGuests'),