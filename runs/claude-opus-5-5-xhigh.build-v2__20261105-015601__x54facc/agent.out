\nexport function inTime(w: GameWorld, seat: Seat, wob: Wobble): boolean {\n  const steps = Math.max(1, Math.round(w.settings.get<number>('game.breath.period') * w.hz));\n  const both = wob.usesBreath && bothFeet(seat);\n  return (wob.bt % steps) / steps < 0.5 ? both : !both && wob.lungs > 0.02;\n}\n\n/** One step of the breath: the guide, the lungs, the running sync and calm. */\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/pose.ts'\ns=open(p).read()\na=\"    if (e.wobble.usesBreath) t.sync += e.wobble.sync;\"\nassert a in s\ns=s.replace(a,\"    if (e.wobble.usesBreath && inTime(c.w, e.seat, e.wobble)) t.sync += 1;\")\ns=s.replace(\"import { bothFeet, inRing } from '../wobble';\",\"import { bothFeet, inRing, inTime } from '../wobble';\")\nopen(p,'w').write(s)\n# Lighthouse back to the plan's ring: sync was the shortfall, not the ring.\np='labs/game/scenes/data/poses.ts'\ns=open(p).read()\ns=s.replace(\"ring: 0.16\",\"ring: 0.14\")\nopen(p,'w').write(s)\np='labs/game/README.md'\ns=open(p).read()\na=\"- **The Lighthouse's ring is 0.16,** not the plan's 0.14: at 0.14 the perfect bot fell short of its 750 target.\\n\"\nassert a in s\ns=s.replace(a,\"- **A pose's breath score is the share of the hold in time with the guide,** not the running `sync`, which starts each hold\\n  near 0 and takes seconds to climb: it held even a perfect player under the target in the Polite Bridge.\\n\")\nopen(p,'w').write(s)\n# 3. hubcheck: only frames still there are judged; a player who left mid-boot is fine\np='labs/game/tools/hubcheck.py'\ns=open(p).read()\na=\"\"\"    engine_ok = {}\n    ghosts = 0\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    engine_ok = {}\n    seen = set()\n    ghosts = 0\"\"\")\na=\"\"\"        for fr in page.frames:\n            if fr == page.main_frame: continue\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"        engine_ok = {}  # the frames there now: a player who left before the engine came up has nothing to report\n        for fr in page.frames:\n            if fr == page.main_frame: continue\"\"\")\na=\"\"\"            if st:\n                engine_ok[id(fr)] = st\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"            if st:\n                engine_ok[id(fr)] = st\n                seen.add(id(fr))\"\"\")\ns=s.replace(\"and len(engine_ok) >= int(n) - (1 if scenario else 0) and\",\"and len(seen) >= int(n) and\")\ns=s.replace(\"\"\"        done = page.evaluate(\"() => document.body.dataset.complete === 'true'\")\n        if done: break\"\"\",\"\"\"        done = page.evaluate(\"() => document.body.dataset.complete === 'true'\")\n        if done:\n            break\"\"\")\nopen(p,'w').write(s)\nprint('len(seen)' in s)\n# about-data\np='labs/game/ui/about-data.ts'\ns=open(p).read()\na=\"'Eight: every class pose silently not playing (seats held no actor), a crash at the session scene start, a boot far past the hub deadline, the Programme restarting the first activity for ever, Gerald walking off the map after Island Jog, a press opening and closing the same screen, a frame crash in Pose Class, and a crash removing the diving judges in mid-step.'\"\nassert a in s\ns=s.replace(a,\"'Nine: every class pose silently not playing (seats held no actor), a crash at the session scene start, a boot far past the hub deadline, the Programme restarting the first activity for ever, Gerald walking off the map after Island Jog, a press opening and closing the same screen, a frame crash in Pose Class, a crash removing the diving judges in mid-step, and the Carry on press dropping you straight back into the activity.'\")\nopen(p,'w').write(s)\nEOF\nwc -l labs/game/ui/app.ts; npx prettier --write labs/game/ui labs/game/scenes >/dev/null; timeout 250 npx tsc -b tsconfig.check.json 2>&1 | grep -E \"labs/game|error\" | head -8 | cut -c1-200; TEETER_SEEDS=10 TEETER_ONLY=poseC TEETER_SHOW=1 timeout 400 npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -E \"^poseC|^  [phsi]:|FAIL|AssertionError|Tests \" | head -8 | cut -c1-160","de