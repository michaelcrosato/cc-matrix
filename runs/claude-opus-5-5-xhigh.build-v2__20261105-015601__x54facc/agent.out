{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjc9YJjPSs9VyHRgQT8S","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Kgo5p8riKxTqkbBURqcvXw","name":"Bash","input":{"command":"cat > labs/game/ui/screens/types.ts <<'EOF'\n/**\n * @file What the screens share: the small interface a screen has, what the app gives them, and a card grid with focus.\n *\n * Game code, a page's.\n *\n * @example\n * // class Pause implements Screen { name = 'pause'; ... }\n */\nimport type { Engine, Input, Store } from '../../../../engine';\nimport type { Flow } from '../../scenes/components';\nimport type { Sound } from '../../audio/sound';\nimport type { Device, GlyphSet } from '../glyphs';\nimport type { SaveData, SettingsData } from '../save';\nimport { Repeat } from '../panel';\n\n/** A front-end screen. */\nexport interface Screen {\n  readonly name: string;\n  /** Whether it holds the sim's input while open. Everything but the touch page does. */\n  readonly modal?: boolean;\n  update(input: Input, dt: number): void;\n  remove(): void;\n  /** Refills itself after the settings changed. */\n  refresh?(): void;\n}\n\n/** What screens get from the app. */\nexport interface AppHost {\n  readonly root: HTMLElement;\n  readonly engine: Engine;\n  readonly store: Store;\n  readonly sound: Sound;\n  save: SaveData;\n  settings: SettingsData;\n  readonly session: boolean;\n  /** The device used last, and the icons. */\n  device(): Device;\n  glyphs(): GlyphSet;\n  /** The sim's flow now. */\n  flow(): Flow | null;\n  /** Runs a scene action. */\n  act(name: string, args?: unknown): void;\n  /** Opens a screen on top. */\n  open(screen: Screen): void;\n  /** Closes the top screen. */\n  close(screen?: Screen): void;\n  /** Closes all screens. */\n  closeAll(): void;\n  /** Keeps the settings, and applies them. */\n  applySettings(): void;\n  /** Keeps the save. */\n  writeSave(): void;\n  /** A sound cue, for menus. */\n  cue(what: 'move' | 'pick' | 'cancel'): void;\n  /** Starts play from the save, at the Plaza. */\n  beginPlay(): void;\n  /** Goes back to the title. */\n  toTitle(): void;\n  /** A running free play goes back to the board after results. */\n  freePlay: boolean;\n  /** The dev cheats. */\n  cheats: { bot: boolean; god: boolean };\n}\n\n/** A layer that covers the screen. */\nexport function layer(parent: HTMLElement, scrim = true): HTMLElement {\n  const el = document.createElement('div');\n  el.className = `tf-layer ${scrim ? 'tf-scrim' : ''}`;\n  parent.append(el);\n  return el;\n}\n\n/** A card in a grid. */\nexport interface Card {\n  id: string;\n  title: string;\n  sub?: string;\n  stamp?: string;\n  disabled?: boolean;\n}\n\n/** A grid of cards with focus: directions, hover, click; page keys page. */\nexport class CardGrid {\n  readonly el: HTMLElement;\n  private els: HTMLElement[] = [];\n  private index = 0;\n  private repeat = new Repeat();\n  active = true;\n\n  constructor(\n    parent: HTMLElement,\n    private cards: Card[],\n    private columns: number,\n    private onPick: (id: string) => void,\n    private cue: (what: 'move' | 'pick' | 'cancel') => void,\n  ) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-cards';\n    this.el.dataset.ui = 'cards';\n    this.el.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;\n    parent.append(this.el);\n    this.draw();\n  }\n\n  /** Replaces the cards. */\n  setCards(cards: Card[]): void {\n    this.cards = cards;\n    this.index = Math.min(this.index, Math.max(0, cards.length - 1));\n    this.draw();\n  }\n\n  private draw(): void {\n    this.el.textContent = '';\n    this.els = this.cards.map((card, i) => {\n      const el = document.createElement('div');\n      el.className = 'tf-card';\n      el.dataset.ui = 'item';\n      el.dataset.id = card.id;\n      if (card.disabled) el.dataset.disabled = 'true';\n      const title = document.createElement('div');\n      title.textContent = card.title;\n      el.append(title);\n      if (card.sub) {\n        const sub = document.createElement('small');\n        sub.textContent = card.sub;\n        el.append(sub);\n      }\n      if (card.stamp) {\n        const stamp = document.createElement('div');\n        stamp.className = 'tf-stamp';\n        stamp.textContent = card.stamp;\n        el.append(stamp);\n      }\n      el.addEventListener('pointermove', (event) => {\n        if ((event.movementX !== 0 || event.movementY !== 0) && i !== this.index) {\n          this.index = i;\n          this.cue('move');\n          this.mark();\n        }\n      });\n      el.addEventListener('click', () => {\n        this.index = i;\n        this.mark();\n        this.pick();\n      });\n      this.el.append(el);\n      return el;\n    });\n    this.mark();\n  }\n\n  private mark(): void {\n    this.els.forEach((el, i) => {\n      el.dataset.focus = i === this.index ? 'true' : 'false';\n    });\n  }\n\n  /** The focused card's id. */\n  get focused(): string {\n    return this.cards[this.index]?.id ?? '';\n  }\n\n  private pick(): void {\n    const card = this.cards[this.index];\n    if (!card || card.disabled) return;\n    this.cue('pick');\n    this.onPick(card.id);\n  }\n\n  /** One frame. */\n  update(input: Input, dt: number): void {\n    if (!this.active || !this.cards.length) return;\n    const n = this.cards.length;\n    const move = (to: number) => {\n      if (to !== this.index && to >= 0 && to < n) {\n        this.index = to;\n        this.cue('move');\n        this.mark();\n      }\n    };\n    if (this.repeat.fire(input, 'uiLeft', dt)) move(this.index - 1);\n    if (this.repeat.fire(input, 'uiRight', dt)) move(this.index + 1);\n    if (this.repeat.fire(input, 'uiUp', dt)) move(this.index - this.columns);\n    if (this.repeat.fire(input, 'uiDown', dt)) move(this.index + this.columns);\n    if (input.pressed('uiAccept')) this.pick();\n  }\n}\nEOF\ncat > labs/game/ui/screens/menus.ts <<'EOF'\n/**\n * @file The title and pause menus, the pier's look and colour pick, and the fullscreen and rows they share.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new PauseScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { COLORS } from '../../cast/roster';\nimport { Panel, type Row } from '../panel';\nimport { promptHtml } from '../glyphs';\nimport { AboutScreen } from './about';\nimport { ControlsScreen } from './controls';\nimport { DevScreen } from './dev';\nimport { SettingsScreen } from './settings';\nimport { BoardScreen } from './programme';\nimport { JoinScreen } from './join';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** The title's menu. */\nexport class TitleScreen implements Screen {\n  readonly name = 'title';\n  readonly modal = true;\n  readonly el: HTMLElement;\n  private panel: Panel;\n  private touchNote: HTMLElement;\n  private prompts: HTMLElement;\n  private lastKey = '';\n\n  constructor(private host: AppHost) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-title';\n    this.el.dataset.ui = 'title';\n    this.el.innerHTML = '<div><div class=\"tf-logo\">Teeter Fit</div><div class=\"tf-tagline\">Stand still. It is harder than it looks.</div></div>';\n    host.root.append(this.el);\n    const bottom = document.createElement('div');\n    bottom.style.cssText = 'display:flex;flex-direction:column;gap:2vh;align-items:flex-start';\n    this.el.append(bottom);\n    const save = host.save;\n    const rows: Row[] = [\n      { id: 'begin', label: save.started ? `Continue: Day ${Math.min(save.day, 6)}` : 'Begin' },\n      { id: 'free', label: 'Free Play', disabled: !(save.seen.length > 0 || save.day > 1) },\n      { id: 'group', label: 'Group Class' },\n      { id: 'settings', label: 'Settings' },\n      { id: 'about', label: 'About / Credits' },\n    ];\n    this.panel = new Panel(bottom, {\n      id: 'title',\n      rows,\n      sound: (cue) => host.cue(cue),\n      onPick: (id) => this.pick(id),\n    });\n    this.touchNote = document.createElement('div');\n    this.touchNote.className = 'tf-panel tf-touch';\n    this.touchNote.dataset.ui = 'touchonly';\n    this.touchNote.style.display = 'none';\n    this.touchNote.innerHTML = '<div class=\"tf-h1\">Controller or keyboard required</div><div class=\"tf-row\" data-id=\"touch-settings\" data-ui=\"item\" style=\"justify-content:center\">Settings</div>';\n    this.touchNote.querySelector<HTMLElement>('[data-id=touch-settings]')!.addEventListener('click', () => host.open(new SettingsScreen(host)));\n    host.root.append(this.touchNote);\n    this.prompts = document.createElement('div');\n    this.prompts.className = 'tf-prompts tf-chip';\n    this.prompts.style.cssText = 'position:absolute;right:var(--safe);bottom:var(--safe)';\n    host.root.append(this.prompts);\n  }\n\n  /** Touch-only devices see only the note and Settings. */\n  setTouchOnly(on: boolean): void {\n    this.touchNote.style.display = on ? '' : 'none';\n    this.panel.el.style.display = on ? 'none' : '';\n    this.prompts.style.display = on ? 'none' : '';\n    this.panel.active = !on;\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    if (id === 'begin') {\n      if (!host.save.started) host.open(new PierScreen(host));\n      else host.beginPlay();\n    } else if (id === 'free') host.open(new BoardScreen(host, true));\n    else if (id === 'group') host.open(new JoinScreen(host));\n    else if (id === 'settings') host.open(new SettingsScreen(host));\n    else if (id === 'about') host.open(new AboutScreen(host));\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n    const key = `${this.host.device()}|${this.host.glyphs()}`;\n    if (key !== this.lastKey) {\n      this.lastKey = key;\n      this.prompts.innerHTML = promptHtml('confirm', 'Choose', this.host.device(), this.host.glyphs());\n    }\n  }\n\n  /** Hides it, while attract plays or a screen is over it. */\n  show(on: boolean): void {\n    this.el.style.display = on ? '' : 'none';\n    if (!on) this.touchNote.style.display = 'none';\n    this.prompts.style.display = on ? '' : 'none';\n  }\n\n  remove(): void {\n    this.el.remove();\n    this.touchNote.remove();\n    this.prompts.remove();\n  }\n}\n\n/** Day 1, at the pier: pick one of three looks and a tracksuit colour. No name entry. */\nexport class PierScreen implements Screen {\n  readonly name = 'pier';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private look = 0;\n  private color = 0;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    this.panel = new Panel(this.el, {\n      id: 'pier',\n      title: 'Guest',\n      sub: 'The ferry is leaving. Who shall we say is here?',\n      sound: (cue) => host.cue(cue),\n      rows: [\n        { id: 'look', label: 'Look', value: () => ['Round', 'Long', 'Small'][this.look], adjust: (dir) => { this.look = (this.look + dir + 3) % 3; } },\n        { id: 'color', label: 'Tracksuit', value: () => COLORS[this.color], adjust: (dir) => { this.color = (this.color + dir + 2) % 2; } },\n        { id: 'go', label: 'Step off the ferry' },\n      ],\n      onCancel: () => host.close(this),\n      onPick: (id) => {\n        if (id !== 'go') return;\n        host.save = { ...host.save, started: true, look: this.look, color: COLORS[this.color] };\n        host.writeSave();\n        host.beginPlay();\n      },\n    }); // prettier-ignore\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\n\n/** The pause menu: pauses the sim; in a session it never does. */\nexport class PauseScreen implements Screen {\n  readonly name = 'pause';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const flow = host.flow();\n    const inEvent = flow?.mode === 'event';\n    const rows: Row[] = host.session\n      ? [\n          { id: 'resume', label: 'Resume' },\n          { id: 'settings', label: 'Volume and icons' },\n        ]\n      : [\n          { id: 'resume', label: 'Resume' },\n          { id: 'restart', label: 'Restart Activity', disabled: !inEvent },\n          { id: 'island', label: 'Back to the Island', disabled: !inEvent },\n          { id: 'settings', label: 'Settings' },\n          { id: 'controls', label: 'Controls' },\n          { id: 'dev', label: 'Dev Mode' },\n          { id: 'about', label: 'About / Credits' },\n          { id: 'title', label: 'Quit to Title' },\n        ];\n    this.panel = new Panel(this.el, {\n      id: 'pause',\n      title: 'Paused',\n      sub: 'Nobody is wobbling. You may look around.',\n      rows,\n      sound: (cue) => host.cue(cue),\n      onCancel: () => this.resume(),\n      onPick: (id) => this.pick(id),\n    });\n    if (!host.session) host.engine.inspector?.pause();\n  }\n\n  private resume(): void {\n    this.host.close(this);\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    if (id === 'resume') this.resume();\n    else if (id === 'restart') {\n      this.resume();\n      host.act('game.again');\n    } else if (id === 'island') {\n      this.resume();\n      host.act('game.leave');\n    } else if (id === 'settings') host.open(new SettingsScreen(host));\n    else if (id === 'controls') host.open(new ControlsScreen(host));\n    else if (id === 'dev') host.open(new DevScreen(host));\n    else if (id === 'about') host.open(new AboutScreen(host));\n    else if (id === 'title') {\n      this.resume();\n      host.toTitle();\n    }\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n    if (!this.host.session) this.host.engine.inspector?.resume();\n  }\n}\nEOF\ncat > labs/game/ui/screens/settings.ts <<'EOF'\n/**\n * @file Settings (PLAN.md section 8): Music (10% by default), Effects, Voices, Button icons, Mouse sensitivity, Invert look,\n * Rumble, Steadier Hands, Reduced Motion, Fullscreen, Group Class CPU guests, Erase Save with an in-game confirmation.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new SettingsScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { Panel, type Row } from '../panel';\nimport { NEW_SAVE } from '../save';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** A percentage row. */\nfunction volume(host: AppHost, id: string, label: string, key: 'music' | 'effects' | 'voices'): Row {\n  const set = (value: number) => {\n    host.settings = { ...host.settings, [key]: Math.round(Math.max(0, Math.min(1, value)) * 20) / 20 };\n    host.applySettings();\n  };\n  return {\n    id,\n    label,\n    value: () => `${Math.round(host.settings[key] * 100)}%`,\n    bar: () => host.settings[key],\n    adjust: (dir) => set(host.settings[key] + dir * 0.05),\n    setBar: set,\n  };\n}\n\n/** A yes or no row. */\nfunction toggle(host: AppHost, id: string, label: string, key: 'invert' | 'rumble' | 'steadier' | 'reduced' | 'cpuGuests'): Row {\n  return {\n    id,\n    label,\n    value: () => (host.settings[key] ? 'On' : 'Off'),\n    adjust: () => {\n      host.settings = { ...host.settings, [key]: !host.settings[key] };\n      host.applySettings();\n    },\n  };\n}\n\n/** Settings. */\nexport class SettingsScreen implements Screen {\n  readonly name = 'settings';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private confirm: Panel | null = null;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const rows: Row[] = [\n      volume(host, 'music', 'Music', 'music'),\n      volume(host, 'effects', 'Effects', 'effects'),\n      volume(host, 'voices', 'Voices', 'voices'),\n      {\n        id: 'glyphs',\n        label: 'Button icons',\n        value: () => (host.settings.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'),\n        adjust: () => {\n          host.settings = { ...host.settings, glyphs: host.settings.glyphs === 'xbox' ? 'playstation' : 'xbox' };\n          host.applySettings();\n        },\n      },\n    ];\n    if (!host.session) {\n      rows.push(\n        {\n          id: 'mouse',\n          label: 'Mouse sensitivity',\n          value: () => `${Math.round(host.settings.mouse * 100)}%`,\n          bar: () => host.settings.mouse / 2,\n          adjust: (dir) => {\n            host.settings = { ...host.settings, mouse: Math.max(0.25, Math.min(2, host.settings.mouse + dir * 0.25)) };\n            host.applySettings();\n          },\n          setBar: (u) => {\n            host.settings = { ...host.settings, mouse: Math.max(0.25, u * 2) };\n            host.applySettings();\n          },\n        },\n        toggle(host, 'invert', 'Invert look', 'invert'),\n        toggle(host, 'rumble', 'Rumble', 'rumble'),\n        toggle(host, 'steadier', 'Steadier Hands', 'steadier'),\n        toggle(host, 'reduced', 'Reduced Motion', 'reduced'),\n        {\n          id: 'fullscreen',\n          label: 'Fullscreen',\n          value: () => (document.fullscreenElement ? 'On' : 'Off'),\n          adjust: () => {\n            if (document.fullscreenElement) void document.exitFullscreen();\n            else void document.documentElement.requestFullscreen().catch(() => undefined);\n          },\n        },\n        toggle(host, 'cpuGuests', 'CPU guests in class', 'cpuGuests'),\n        { id: 'erase', label: 'Erase Save' },\n      );\n    }\n    this.panel = new Panel(this.el, {\n      id: 'settings',\n      title: 'Settings',\n      rows,\n      sound: (cue) => host.cue(cue),\n      onCancel: () => host.close(this),\n      onPick: (id) => {\n        if (id === 'erase') this.askErase();\n      },\n    });\n  }\n\n  /** Erase asks in-game: never `confirm()`. */\n  private askErase(): void {\n    const { host } = this;\n    this.panel.active = false;\n    this.panel.el.style.display = 'none';\n    this.confirm = new Panel(this.el, {\n      id: 'erase',\n      title: 'Erase your save?',\n      sub: 'Your Wobble Ages, your cairn, your days. The scale will forget you. It is good at that now.',\n      rows: [\n        { id: 'keep', label: 'Keep it' },\n        { id: 'erase', label: 'Erase it' },\n      ],\n      sound: (cue) => host.cue(cue),\n      onCancel: () => this.closeConfirm(),\n      onPick: (id) => {\n        if (id === 'erase') {\n          host.save = { ...NEW_SAVE };\n          host.writeSave();\n          host.closeAll();\n          host.toTitle();\n        } else this.closeConfirm();\n      },\n    });\n  }\n\n  private closeConfirm(): void {\n    this.confirm?.remove();\n    this.confirm = null;\n    this.panel.el.style.display = '';\n    this.panel.active = true;\n  }\n\n  update(input: Input, dt: number): void {\n    if (this.confirm) this.confirm.update(input, dt);\n    else this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/controls.ts <<'EOF'\n/**\n * @file Controls (PLAN.md section 8): the bindings per scheme, in words and glyphs; keyboard rebinding through the engine's\n * `bindingsFor`, `rebind` and `listen`. The store keeps what you change.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new ControlsScreen(host));\n */\nimport { codeLabel, type Input } from '../../../../engine';\nimport { Panel, type Row } from '../panel';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** What may be rebound on the keyboard: the balance map's actions. */\nconst REBINDABLE: readonly (readonly [string, string])[] = [\n  ['forward', 'Lean forward'],\n  ['back', 'Lean back'],\n  ['left', 'Lean left'],\n  ['right', 'Lean right'],\n  ['footl', 'Left foot'],\n  ['footr', 'Right foot'],\n  ['gentle', 'Lean gently'],\n  ['act', 'Skip, confirm'],\n];\n\n/** What a pad does, in words. */\nconst PAD_ROWS: readonly (readonly [string, string, string])[] = [\n  ['Lean', 'Left stick or D-pad', 'Left stick or D-pad'],\n  ['Feet', 'L2 and R2 (L1 and R1 too)', 'LT and RT (LB and RB too)'],\n  ['Breathe', 'L2 + R2 together', 'LT + RT together'],\n  ['On the island', 'Cross use, Square hop, Triangle Programme, Circle wave', 'A use, X hop, Y Programme, B wave'],\n  ['Pause', 'Options', 'Menu'],\n];\n\n/** Controls. */\nexport class ControlsScreen implements Screen {\n  readonly name = 'controls';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private listening = false;\n  private page: 'keys' | 'pad' = 'keys';\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    this.panel = new Panel(this.el, {\n      id: 'controls',\n      title: 'Controls',\n      sub: 'Pick a key to change it, then press the new one.',\n      rows: this.keyRows(),\n      sound: (cue) => host.cue(cue),\n      onCancel: () => host.close(this),\n      onPick: (id) => this.pick(id),\n    });\n  }\n\n  private bindings() {\n    return this.host.engine.input!.bindingsFor('actionMap:balance');\n  }\n\n  private keyRows(): Row[] {\n    const rows: Row[] = REBINDABLE.map(([action, label]) => ({\n      id: action,\n      label,\n      value: () => {\n        const code = this.bindings().codes(action).find((c) => !c.startsWith('Pad') && !c.startsWith('Mouse'));\n        return code ? codeLabel(code) : 'None';\n      },\n    }));\n    rows.push({ id: 'reset', label: 'Reset keys' }, { id: 'padpage', label: 'Show the pad' });\n    return rows;\n  }\n\n  private padRows(): Row[] {\n    const xbox = this.host.settings.glyphs === 'xbox';\n    return [\n      ...PAD_ROWS.map(([label, ps, xb]) => ({ id: label, label, value: () => (xbox ? xb : ps), disabled: true })),\n      { id: 'keypage', label: 'Show the keys' },\n    ];\n  }\n\n  private pick(id: string): void {\n    if (id === 'padpage') {\n      this.page = 'pad';\n      this.panel.setRows(this.padRows());\n      return;\n    }\n    if (id === 'keypage') {\n      this.page = 'keys';\n      this.panel.setRows(this.keyRows());\n      return;\n    }\n    if (id === 'reset') {\n      this.bindings().reset();\n      return;\n    }\n    if (this.listening) return;\n    this.listening = true;\n    this.panel.active = false;\n    const row = this.panel.el.querySelector<HTMLElement>(`[data-id=\"${id}\"] [data-value]`);\n    if (row) row.textContent = 'Press a key…';\n    void this.host.engine.input!.listen('keyboard').then((code) => {\n      this.listening = false;\n      this.panel.active = true;\n      if (code) {\n        const bindings = this.bindings();\n        const was = bindings.codes(id).find((c) => !c.startsWith('Pad') && !c.startsWith('Mouse'));\n        const result = bindings.rebind(id, code, was ? { replace: was } : {});\n        if (!result.ok) this.host.sound.play('sfx:miss');\n      }\n      this.panel.refresh();\n    });\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n    void this.page;\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/about.ts <<'EOF'\n/**\n * @file About / Credits (PLAN.md section 8), paged, from one data file: Source Information, Testing Feedback, Engine Feedback,\n * Prompt Feedback, credits. Every field is on screen, a few to a page, at sofa size.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new AboutScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { CREDITS, ENGINE_FEEDBACK, PROMPT_FEEDBACK, SOURCE_INFO, SOURCE_LABELS, TESTING_FEEDBACK } from '../about-data';\nimport { promptHtml } from '../glyphs';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** How many characters fit a page at this size. */\nconst PAGE_CHARS = 620;\n\n/** Splits entries into pages by length. */\nfunction paginate(title: string, entries: readonly string[]): { title: string; body: string }[] {\n  const pages: { title: string; body: string }[] = [];\n  let body = '';\n  for (const entry of entries) {\n    if (body && body.length + entry.length > PAGE_CHARS) {\n      pages.push({ title, body });\n      body = '';\n    }\n    body += `${entry}\\n\\n`;\n  }\n  if (body) pages.push({ title, body });\n  return pages;\n}\n\n/** Every page, in order. */\nexport function aboutPages(): { title: string; body: string }[] {\n  const qa = (list: readonly (readonly [string, string])[]) => list.map(([q, a]) => `<b>${q}</b>\\n${a}`);\n  return [\n    ...paginate('Source Information', SOURCE_LABELS.map(([key, label]) => `<b>${label}:</b> ${SOURCE_INFO[key]}`)),\n    ...paginate('Testing Feedback', qa(TESTING_FEEDBACK)),\n    ...paginate('Engine Feedback', qa(ENGINE_FEEDBACK)),\n    ...paginate('Prompt Feedback', qa(PROMPT_FEEDBACK)),\n    ...paginate('Credits', CREDITS),\n  ];\n}\n\n/** About. */\nexport class AboutScreen implements Screen {\n  readonly name = 'about';\n  readonly modal = true;\n  private el: HTMLElement;\n  private pages = aboutPages();\n  private page = 0;\n  private body: HTMLElement;\n  private title: HTMLElement;\n  private foot: HTMLElement;\n  private key = '';\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel';\n    panel.dataset.panel = 'about';\n    this.title = document.createElement('div');\n    this.title.className = 'tf-h1';\n    this.body = document.createElement('div');\n    this.body.className = 'tf-about';\n    this.body.dataset.ui = 'about';\n    this.foot = document.createElement('div');\n    this.foot.className = 'tf-prompts';\n    this.foot.style.justifyContent = 'flex-start';\n    panel.append(this.title, this.body, this.foot);\n    panel.addEventListener('click', () => this.flip(1));\n    this.el.append(panel);\n    this.draw();\n  }\n\n  private flip(dir: number): void {\n    const n = this.pages.length;\n    this.page = (this.page + dir + n) % n;\n    this.host.cue('move');\n    this.draw();\n  }\n\n  private draw(): void {\n    const { title, body } = this.pages[this.page];\n    this.title.textContent = title;\n    this.body.innerHTML = body.trim();\n    this.key = '';\n  }\n\n  update(input: Input): void {\n    if (input.pressed('uiRight') || input.pressed('uiDown') || input.pressed('uiAccept')) this.flip(1);\n    else if (input.pressed('uiLeft') || input.pressed('uiUp')) this.flip(-1);\n    else if (input.pressed('uiCancel')) this.host.close(this);\n    const key = `${this.host.device()}|${this.host.glyphs()}|${this.page}`;\n    if (key !== this.key) {\n      this.key = key;\n      const d = this.host.device();\n      const g = this.host.glyphs();\n      this.foot.innerHTML = `<span>Page ${this.page + 1} of ${this.pages.length}</span>${promptHtml('confirm', 'Next', d, g)}${promptHtml('cancel', 'Back', d, g)}`;\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/programme.ts <<'EOF'\n/**\n * @file Today's Programme: up to four cards with stamps, each with Go; and the Noticeboard: a three by two page of activity\n * cards with best rank, L1 and R1 or Q and E paging. Going fades to the station: a player on a sofa never has to cross the\n * island. Evening and Results live in results.ts.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new ProgrammeScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { BOARD, dayOf, todaysNext } from '../../scenes/data/days';\nimport { rankOf } from '../../scenes/scoring';\nimport { promptHtml } from '../glyphs';\nimport { getLine } from '../lines/index';\nimport { CardGrid, layer, type AppHost, type Card, type Screen } from './types';\n\n/** An activity's name on a card. */\nexport const TITLES: Readonly<Record<string, string>> = {\n  morning: 'Morning Check',\n  poseA: 'Pose Class A',\n  poseB: 'Pose Class B',\n  poseC: 'Pose Class C',\n  pond: 'Still Pond',\n  reps: 'Reps Hall',\n  garden: 'Sand Garden',\n  paddle: 'Paddle Glide',\n  line: 'The Line',\n  step: 'Step Class',\n  hoop: 'Hoop Patrol',\n  plunge: 'Cliff Plunge',\n  jog: 'Island Jog',\n  group: 'Group Class',\n  tilt: 'The Great Tilt',\n  noticeboard: 'Find the Noticeboard',\n};\n\n/** Cards per page on the Noticeboard. */\nconst PER_PAGE = 6;\n\n/** Today's Programme. */\nexport class ProgrammeScreen implements Screen {\n  readonly name = 'programme';\n  readonly modal = true;\n  private el: HTMLElement;\n  private grid: CardGrid;\n  private foot: HTMLElement;\n  private key = '';\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel';\n    panel.dataset.panel = 'programme';\n    const flow = host.flow();\n    const day = flow?.day ?? 1;\n    const def = dayOf(day);\n    const h = document.createElement('div');\n    h.className = 'tf-h1';\n    h.textContent = day > 5 ? 'After' : `Day ${day}: ${def.title}`;\n    panel.append(h);\n    this.el.append(panel);\n    const done = flow?.done ?? [];\n    const next = flow ? todaysNext(flow) : null;\n    const cards: Card[] = def.items.map((id) => ({\n      id,\n      title: TITLES[id] ?? id,\n      sub: done.includes(id) ? 'Done' : id === next ? 'Next' : 'Today',\n      stamp: done.includes(id) ? 'Done' : undefined,\n    }));\n    if (next === null || day > 5) cards.push({ id: 'sleep', title: 'Sleep', sub: 'Your hut will know' });\n    if (day > 5 || (flow?.seen.length ?? 0) > 2) cards.push({ id: 'board', title: 'The Noticeboard', sub: 'Everything so far' });\n    this.grid = new CardGrid(panel, cards, cards.length > 4 ? 3 : 2, (id) => this.pick(id), (c) => host.cue(c));\n    this.foot = document.createElement('div');\n    this.foot.className = 'tf-prompts';\n    this.foot.style.marginTop = '2vh';\n    this.foot.style.justifyContent = 'flex-start';\n    panel.append(this.foot);\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    host.close(this);\n    if (id === 'sleep') host.act('game.sleep');\n    else if (id === 'board') host.open(new BoardScreen(host, false));\n    else if (id === 'noticeboard') {\n      host.act('game.go', { station: 'plaza' });\n      host.open(new BoardScreen(host, false));\n    } else host.act('game.start', { event: id });\n  }\n\n  update(input: Input, dt: number): void {\n    this.grid.update(input, dt);\n    if (input.pressed('uiCancel') || input.pressed('plan')) this.host.close(this);\n    const key = `${this.host.device()}|${this.host.glyphs()}`;\n    if (key !== this.key) {\n      this.key = key;\n      const [d, g] = [this.host.device(), this.host.glyphs()];\n      this.foot.innerHTML = `${promptHtml('confirm', 'Go', d, g)}${promptHtml('cancel', 'Back', d, g)}`;\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\n\n/** The Noticeboard. From the title it is Free Play. */\nexport class BoardScreen implements Screen {\n  readonly name = 'board';\n  readonly modal = true;\n  private el: HTMLElement;\n  private grid: CardGrid;\n  private page = 0;\n  private heading: HTMLElement;\n  private foot: HTMLElement;\n  private key = '';\n  private notice: HTMLElement;\n  private pebbles: number;\n\n  constructor(\n    private host: AppHost,\n    private free: boolean,\n  ) {\n    this.el = layer(host.root);\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel';\n    panel.dataset.panel = 'board';\n    this.heading = document.createElement('div');\n    this.heading.className = 'tf-h1';\n    this.notice = document.createElement('div');\n    this.notice.className = 'tf-sub';\n    panel.append(this.heading, this.notice);\n    this.el.append(panel);\n    this.pebbles = host.flow()?.pebbles ?? host.save.pebbles;\n    this.grid = new CardGrid(panel, this.cards(), 3, (id) => this.pick(id), (c) => host.cue(c));\n    this.foot = document.createElement('div');\n    this.foot.className = 'tf-prompts';\n    this.foot.style.marginTop = '2vh';\n    this.foot.style.justifyContent = 'flex-start';\n    panel.append(this.foot);\n    this.draw();\n    const flow = host.flow();\n    if (flow && !this.free) {\n      if (!flow.done.includes('noticeboard') && dayOf(flow.day).items.includes('noticeboard')) host.act('game.markDone', { id: 'noticeboard' });\n    }\n  }\n\n  private cards(): Card[] {\n    const seen = this.host.flow()?.seen ?? this.host.save.seen;\n    const bests = this.host.flow()?.bests ?? this.host.save.bests;\n    const start = this.page * PER_PAGE;\n    return BOARD.slice(start, start + PER_PAGE).map((id) => {\n      const met = seen.includes(id) || id === 'morning';\n      const best = bests[id];\n      return {\n        id,\n        title: met ? (TITLES[id] ?? id) : 'Not yet',\n        sub: best !== undefined ? `${rankOf(best)} ${best}` : met ? 'Not yet scored' : 'Nobody is teaching this yet',\n        disabled: !met,\n      };\n    });\n  }\n\n  private draw(): void {\n    const pages = Math.ceil(BOARD.length / PER_PAGE);\n    const day = this.host.flow()?.day ?? this.host.save.day;\n    this.heading.textContent = this.free ? `Free Play ${this.page + 1} of ${pages}` : `Noticeboard ${this.page + 1} of ${pages}`;\n    const unlocks = this.pebbles >= 40 ? 'unlock.stamps' : this.pebbles >= 30 ? 'unlock.headband' : this.pebbles >= 20 ? 'unlock.color' : this.pebbles >= 10 ? 'unlock.expert' : '';\n    const line = unlocks && this.page === 1 ? getLine(unlocks)?.text : getLine(`notice.${Math.min(6, day)}`)?.text;\n    this.notice.textContent = line ?? '';\n    this.grid.setCards(this.cards());\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    host.close(this);\n    if (this.free) {\n      host.freePlay = true;\n      host.beginPlay();\n    }\n    host.act('game.start', { event: id });\n  }\n\n  update(input: Input, dt: number): void {\n    this.grid.update(input, dt);\n    const pages = Math.ceil(BOARD.length / PER_PAGE);\n    if (input.pressed('pageR')) {\n      this.page = (this.page + 1) % pages;\n      this.host.cue('move');\n      this.draw();\n    } else if (input.pressed('pageL')) {\n      this.page = (this.page - 1 + pages) % pages;\n      this.host.cue('move');\n      this.draw();\n    } else if (input.pressed('uiCancel')) this.host.close(this);\n    const key = `${this.host.device()}|${this.host.glyphs()}`;\n    if (key !== this.key) {\n      this.key = key;\n      const [d, g] = [this.host.device(), this.host.glyphs()];\n      this.foot.innerHTML = `${promptHtml('confirm', 'Go', d, g)}${promptHtml('pageL', 'Page', d, g)}${promptHtml('pageR', 'Page', d, g)}${promptHtml('cancel', 'Back', d, g)}`;\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/results.ts <<'EOF'\n/**\n * @file Results: one word, one number, one sentence, one small graph; pebbles falling onto a little cairn. The Morning Check\n * gets a big dial that spins past 100, \"recalibrating\", overshoots and settles. Evening: a calendar stamp, the age graph, a\n * closing remark, Sleep. Credits: every guest holding a pose as the camera drifts past.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new ResultsScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { getLine } from '../lines/index';\nimport { CREDITS } from '../about-data';\nimport { Panel, type Row } from '../panel';\nimport { layer, type AppHost, type Screen } from './types';\nimport { BoardScreen, TITLES } from './programme';\n\n/** A small line graph of ages, as SVG. Oldest first; lower is better. */\nfunction ageGraph(ages: readonly number[]): string {\n  const list = ages.slice(-7);\n  if (list.length === 0) return '';\n  const [w, h] = [320, 100];\n  const x = (i: number) => (list.length === 1 ? w / 2 : 18 + (i * (w - 36)) / (list.length - 1));\n  const y = (age: number) => 12 + ((age - 18) / 64) * (h - 24);\n  const line = list.map((age, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(age).toFixed(1)}`).join(' ');\n  const dots = list.map((age, i) => `<circle cx=\"${x(i).toFixed(1)}\" cy=\"${y(age).toFixed(1)}\" r=\"6\" fill=\"#ff8a70\"/>`).join('');\n  return `<svg class=\"tf-graph\" data-ui=\"graph\" viewBox=\"0 0 ${w} ${h}\"><rect width=\"${w}\" height=\"${h}\" rx=\"18\" fill=\"#f6efe0\"/><path d=\"${line}\" stroke=\"#3a4a55\" stroke-width=\"3.5\" fill=\"none\"/>${dots}</svg>`;\n}\n\n/** The age remark. */\nfunction ageRemark(age: number, before: number | undefined): string {\n  if (before === undefined) return (getLine('age.first', age)?.text ?? '').replaceAll('{age}', String(age));\n  const diff = Math.abs(before - age);\n  const id = age < before ? 'age.younger' : age > before ? 'age.older' : 'age.same';\n  return (getLine(id, age)?.text ?? '').replaceAll('{age}', String(age)).replaceAll('{before}', String(before)).replaceAll('{diff}', String(diff));\n}\n\n/** Results. */\nexport class ResultsScreen implements Screen {\n  readonly name = 'results';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private t = 0;\n  private needle: HTMLElement | null = null;\n  private dialValue: HTMLElement | null = null;\n  private note: HTMLElement | null = null;\n  private age: number | undefined;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const last = host.flow()?.last ?? {};\n    const box = document.createElement('div');\n    box.className = 'tf-panel';\n    box.dataset.panel = 'results';\n    box.style.cssText = 'display:flex;gap:5vh;align-items:center';\n    const left = document.createElement('div');\n    left.style.cssText = 'text-align:center;display:flex;flex-direction:column;gap:1.4vh;align-items:center';\n    const title = document.createElement('div');\n    title.className = 'tf-sub';\n    title.textContent = TITLES[last.event ?? ''] ?? last.event ?? '';\n    left.append(title);\n    this.age = last.age;\n    if (last.age !== undefined) {\n      const dial = document.createElement('div');\n      dial.className = 'tf-dial';\n      dial.innerHTML = '<div class=\"note\">Recalibrating</div><div class=\"needle\"></div><div class=\"value\" data-ui=\"age\">--</div>';\n      left.append(dial);\n      this.needle = dial.querySelector('.needle');\n      this.dialValue = dial.querySelector('.value');\n      this.note = dial.querySelector('.note');\n      host.sound.play('sfx:dialSpin');\n    } else {\n      const rank = document.createElement('div');\n      rank.className = 'tf-rank';\n      rank.dataset.ui = 'rank';\n      rank.textContent = last.rank ?? '';\n      const score = document.createElement('div');\n      score.className = 'tf-score';\n      score.dataset.ui = 'score';\n      score.textContent = String(last.score ?? 0);\n      left.append(rank, score);\n    }\n    const right = document.createElement('div');\n    right.style.cssText = 'display:flex;flex-direction:column;gap:2vh;align-items:center';\n    if (last.age !== undefined) {\n      const remark = document.createElement('div');\n      remark.style.cssText = 'max-width:66vh;font-size:3vh;font-weight:600';\n      remark.dataset.ui = 'remark';\n      remark.textContent = ageRemark(last.age, last.ageBefore);\n      right.append(remark);\n      const ages = host.flow()?.ages ?? [];\n      const g = document.createElement('div');\n      g.innerHTML = ageGraph(ages);\n      right.append(g);\n    }\n    const cairn = document.createElement('div');\n    cairn.className = 'tf-pebbles';\n    cairn.dataset.ui = 'pebbles';\n    const count = last.pebbles ?? 0;\n    for (let i = 0; i < count; i++) {\n      const stone = document.createElement('div');\n      stone.className = 'tf-pebble';\n      stone.style.left = `${6 + (i % 3) * 7}vh`;\n      stone.style.bottom = `${Math.floor(i / 3) * 2.6}vh`;\n      stone.style.animationDelay = `${0.4 + i * 0.28}s`;\n      cairn.append(stone);\n      setTimeout(() => host.sound.play('sfx:clack'), 800 + i * 280);\n    }\n    right.append(cairn);\n    const rows: Row[] = [\n      { id: 'carry', label: 'Carry on' },\n      { id: 'again', label: 'Again', disabled: last.event === 'tilt' || last.event === 'morning' },\n    ];\n    this.panel = new Panel(right, { id: 'results-menu', rows, sound: (cue) => host.cue(cue), onPick: (id) => this.pick(id) });\n    this.panel.el.style.boxShadow = 'none';\n    this.panel.el.style.background = 'transparent';\n    this.panel.el.style.padding = '0';\n    box.append(left, right);\n    this.el.append(box);\n    host.sound.play('sfx:stamp');\n    host.sound.audio.stinger('song:stamp');\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    host.close(this);\n    if (id === 'again') host.act('game.again');\n    else {\n      host.act('game.leave');\n      if (host.freePlay && host.flow()?.mode === 'roam') host.open(new BoardScreen(host, false));\n    }\n  }\n\n  update(input: Input, dt: number): void {\n    this.t += dt;\n    this.panel.update(input, dt);\n    if (this.needle && this.age !== undefined) {\n      const settle = 2.6;\n      const u = Math.min(1, this.t / settle);\n      // It spins past 100, overshoots and settles.\n      const shown = u < 1 ? this.age + (1 - u) * (130 - this.age) * Math.cos(u * 11) * (1 - u) : this.age;\n      this.needle.style.transform = `rotate(${(-140 + ((shown - 18) / 64) * 280).toFixed(1)}deg)`;\n      if (this.dialValue) this.dialValue.textContent = u < 1 ? String(Math.round(Math.max(0, shown))) : String(this.age);\n      if (this.note) this.note.textContent = u < 1 ? 'Recalibrating' : 'Wobble Age';\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\n\n/** Evening. */\nexport class EveningScreen implements Screen {\n  readonly name = 'evening';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n\n  constructor(\n    private host: AppHost,\n    private finished: number,\n    onDone: () => void,\n  ) {\n    this.el = layer(host.root);\n    const flow = host.flow();\n    const remark = getLine(`evening.${Math.min(6, finished)}`, finished)?.text ?? '';\n    this.panel = new Panel(this.el, {\n      id: 'evening',\n      title: finished > 5 ? 'Another evening' : `Day ${finished} is stamped`,\n      sub: remark,\n      rows: [{ id: 'sleep', label: 'Sleep' }],\n      sound: (cue) => host.cue(cue),\n      onPick: () => {\n        host.close(this);\n        onDone();\n      },\n    });\n    const graph = document.createElement('div');\n    graph.innerHTML = ageGraph(flow?.ages ?? []);\n    graph.style.margin = '2vh 0';\n    this.panel.el.insertBefore(graph, this.panel.el.querySelector('.tf-rows'));\n    host.sound.play('sfx:stamp');\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\n\n/** The credits: the camera drifts past the guests; you may stay as long as you like. */\nexport class CreditsScreen implements Screen {\n  readonly name = 'credits';\n  readonly modal = true;\n  private el: HTMLElement;\n  private t = 0;\n  private body: HTMLElement;\n  private i = 0;\n  private list: string[];\n\n  constructor(\n    private host: AppHost,\n    private onDone: () => void,\n  ) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-layer';\n    this.el.dataset.ui = 'credits';\n    this.el.style.alignItems = 'flex-end';\n    host.root.append(this.el);\n    const box = document.createElement('div');\n    box.className = 'tf-panel';\n    this.body = document.createElement('div');\n    this.body.style.cssText = 'font-size:3.2vh;font-weight:650;max-width:120vh;text-align:center';\n    box.append(this.body);\n    this.el.append(box);\n    this.list = ['Thank you for standing.', ...CREDITS, 'You may stay as long as you like. The ferry does not return.'];\n    this.body.textContent = this.list[0];\n  }\n\n  update(input: Input, dt: number): void {\n    this.t += dt;\n    const each = 4;\n    const at = Math.floor(this.t / each);\n    if (at !== this.i && at < this.list.length) {\n      this.i = at;\n      this.body.textContent = this.list[at];\n    }\n    if (at >= this.list.length || input.pressed('uiAccept') || input.pressed('uiCancel')) {\n      this.host.close(this);\n      this.onDone();\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/actions.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  'game.front': (w: GameWorld) => {\"\"\",\"\"\"  'game.markDone': (w: GameWorld, args: unknown) => {\n    const { id } = (args ?? {}) as { id: string };\n    const flow = flowOf(w);\n    if (!flow.done.includes(id)) flow.done.push(id);\n  },\n  'game.front': (w: GameWorld) => {\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/maps.ts'\ns=open(p).read()\ns=s.replace(\"  actions: { ...WALK },\\n  lock: false,\",\"  actions: { ...WALK, pageL: ['PadLeftShoulder', 'KeyQ'], pageR: ['PadRightShoulder', 'KeyE'], plan: ['Tab', 'PadNorth'] },\\n  lock: false,\")\nopen(p,'w').write(s)\nEOF\n","description":"Write screens: menus, settings, controls, about, programme, results"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11004,"cache_read_input_tokens":555771,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11004},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"3c3ffbee-20e6-4d15-b7f4-a0473494580f","timestamp":"2026-11-05T10:18:14.632Z","request_id":"req_011Cgjc9XyPBQEQpXnC3yHdK","wire_tool_inputs":{"toolu_01Kgo5p8riKxTqkbBURqcvXw":{"command":"cat > labs/game/ui/screens/types.ts <<'EOF'\n/**\n * @file What the screens share: the small interface a screen has, what the app gives them, and a card grid with focus.\n *\n * Game code, a page's.\n *\n * @example\n * // class Pause implements Screen { name = 'pause'; ... }\n */\nimport type { Engine, Input, Store } from '../../../../engine';\nimport type { Flow } from '../../scenes/components';\nimport type { Sound } from '../../audio/sound';\nimport type { Device, GlyphSet } from '../glyphs';\nimport type { SaveData, SettingsData } from '../save';\nimport { Repeat } from '../panel';\n\n/** A front-end screen. */\nexport interface Screen {\n  readonly name: string;\n  /** Whether it holds the sim's input while open. Everything but the touch page does. */\n  readonly modal?: boolean;\n  update(input: Input, dt: number): void;\n  remove(): void;\n  /** Refills itself after the settings changed. */\n  refresh?(): void;\n}\n\n/** What screens get from the app. */\nexport interface AppHost {\n  readonly root: HTMLElement;\n  readonly engine: Engine;\n  readonly store: Store;\n  readonly sound: Sound;\n  save: SaveData;\n  settings: SettingsData;\n  readonly session: boolean;\n  /** The device used last, and the icons. */\n  device(): Device;\n  glyphs(): GlyphSet;\n  /** The sim's flow now. */\n  flow(): Flow | null;\n  /** Runs a scene action. */\n  act(name: string, args?: unknown): void;\n  /** Opens a screen on top. */\n  open(screen: Screen): void;\n  /** Closes the top screen. */\n  close(screen?: Screen): void;\n  /** Closes all screens. */\n  closeAll(): void;\n  /** Keeps the settings, and applies them. */\n  applySettings(): void;\n  /** Keeps the save. */\n  writeSave(): void;\n  /** A sound cue, for menus. */\n  cue(what: 'move' | 'pick' | 'cancel'): void;\n  /** Starts play from the save, at the Plaza. */\n  beginPlay(): void;\n  /** Goes back to the title. */\n  toTitle(): void;\n  /** A running free play goes back to the board after results. */\n  freePlay: boolean;\n  /** The dev cheats. */\n  cheats: { bot: boolean; god: boolean };\n}\n\n/** A layer that covers the screen. */\nexport function layer(parent: HTMLElement, scrim = true): HTMLElement {\n  const el = document.createElement('div');\n  el.className = `tf-layer ${scrim ? 'tf-scrim' : ''}`;\n  parent.append(el);\n  return el;\n}\n\n/** A card in a grid. */\nexport interface Card {\n  id: string;\n  title: string;\n  sub?: string;\n  stamp?: string;\n  disabled?: boolean;\n}\n\n/** A grid of cards with focus: directions, hover, click; page keys page. */\nexport class CardGrid {\n  readonly el: HTMLElement;\n  private els: HTMLElement[] = [];\n  private index = 0;\n  private repeat = new Repeat();\n  active = true;\n\n  constructor(\n    parent: HTMLElement,\n    private cards: Card[],\n    private columns: number,\n    private onPick: (id: string) => void,\n    private cue: (what: 'move' | 'pick' | 'cancel') => void,\n  ) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-cards';\n    this.el.dataset.ui = 'cards';\n    this.el.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;\n    parent.append(this.el);\n    this.draw();\n  }\n\n  /** Replaces the cards. */\n  setCards(cards: Card[]): void {\n    this.cards = cards;\n    this.index = Math.min(this.index, Math.max(0, cards.length - 1));\n    this.draw();\n  }\n\n  private draw(): void {\n    this.el.textContent = '';\n    this.els = this.cards.map((card, i) => {\n      const el = document.createElement('div');\n      el.className = 'tf-card';\n      el.dataset.ui = 'item';\n      el.dataset.id = card.id;\n      if (card.disabled) el.dataset.disabled = 'true';\n      const title = document.createElement('div');\n      title.textContent = card.title;\n      el.append(title);\n      if (card.sub) {\n        const sub = document.createElement('small');\n        sub.textContent = card.sub;\n        el.append(sub);\n      }\n      if (card.stamp) {\n        const stamp = document.createElement('div');\n        stamp.className = 'tf-stamp';\n        stamp.textContent = card.stamp;\n        el.append(stamp);\n      }\n      el.addEventListener('pointermove', (event) => {\n        if ((event.movementX !== 0 || event.movementY !== 0) && i !== this.index) {\n          this.index = i;\n          this.cue('move');\n          this.mark();\n        }\n      });\n      el.addEventListener('click', () => {\n        this.index = i;\n        this.mark();\n        this.pick();\n      });\n      this.el.append(el);\n      return el;\n    });\n    this.mark();\n  }\n\n  private mark(): void {\n    this.els.forEach((el, i) => {\n      el.dataset.focus = i === this.index ? 'true' : 'false';\n    });\n  }\n\n  /** The focused card's id. */\n  get focused(): string {\n    return this.cards[this.index]?.id ?? '';\n  }\n\n  private pick(): void {\n    const card = this.cards[this.index];\n    if (!card || card.disabled) return;\n    this.cue('pick');\n    this.onPick(card.id);\n  }\n\n  /** One frame. */\n  update(input: Input, dt: number): void {\n    if (!this.active || !this.cards.length) return;\n    const n = this.cards.length;\n    const move = (to: number) => {\n      if (to !== this.index && to >= 0 && to < n) {\n        this.index = to;\n        this.cue('move');\n        this.mark();\n      }\n    };\n    if (this.repeat.fire(input, 'uiLeft', dt)) move(this.index - 1);\n    if (this.repeat.fire(input, 'uiRight', dt)) move(this.index + 1);\n    if (this.repeat.fire(input, 'uiUp', dt)) move(this.index - this.columns);\n    if (this.repeat.fire(input, 'uiDown', dt)) move(this.index + this.columns);\n    if (input.pressed('uiAccept')) this.pick();\n  }\n}\nEOF\ncat > labs/game/ui/screens/menus.ts <<'EOF'\n/**\n * @file The title and pause menus, the pier's look and colour pick, and the fullscreen and rows they share.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new PauseScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { COLORS } from '../../cast/roster';\nimport { Panel, type Row } from '../panel';\nimport { promptHtml } from '../glyphs';\nimport { AboutScreen } from './about';\nimport { ControlsScreen } from './controls';\nimport { DevScreen } from './dev';\nimport { SettingsScreen } from './settings';\nimport { BoardScreen } from './programme';\nimport { JoinScreen } from './join';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** The title's menu. */\nexport class TitleScreen implements Screen {\n  readonly name = 'title';\n  readonly modal = true;\n  readonly el: HTMLElement;\n  private panel: Panel;\n  private touchNote: HTMLElement;\n  private prompts: HTMLElement;\n  private lastKey = '';\n\n  constructor(private host: AppHost) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-title';\n    this.el.dataset.ui = 'title';\n    this.el.innerHTML = '<div><div class=\"tf-logo\">Teeter Fit</div><div class=\"tf-tagline\">Stand still. It is harder than it looks.</div></div>';\n    host.root.append(this.el);\n    const bottom = document.createElement('div');\n    bottom.style.cssText = 'display:flex;flex-direction:column;gap:2vh;align-items:flex-start';\n    this.el.append(bottom);\n    const save = host.save;\n    const rows: Row[] = [\n      { id: 'begin', label: save.started ? `Continue: Day ${Math.min(save.day, 6)}` : 'Begin' },\n      { id: 'free', label: 'Free Play', disabled: !(save.seen.length > 0 || save.day > 1) },\n      { id: 'group', label: 'Group Class' },\n      { id: 'settings', label: 'Settings' },\n      { id: 'about', label: 'About / Credits' },\n    ];\n    this.panel = new Panel(bottom, {\n      id: 'title',\n      rows,\n      sound: (cue) => host.cue(cue),\n      onPick: (id) => this.pick(id),\n    });\n    this.touchNote = document.createElement('div');\n    this.touchNote.className = 'tf-panel tf-touch';\n    this.touchNote.dataset.ui = 'touchonly';\n    this.touchNote.style.display = 'none';\n    this.touchNote.innerHTML = '<div class=\"tf-h1\">Controller or keyboard required</div><div class=\"tf-row\" data-id=\"touch-settings\" data-ui=\"item\" style=\"justify-content:center\">Settings</div>';\n    this.touchNote.querySelector<HTMLElement>('[data-id=touch-settings]')!.addEventListener('click', () => host.open(new SettingsScreen(host)));\n    host.root.append(this.touchNote);\n    this.prompts = document.createElement('div');\n    this.prompts.className = 'tf-prompts tf-chip';\n    this.prompts.style.cssText = 'position:absolute;right:var(--safe);bottom:var(--safe)';\n    host.root.append(this.prompts);\n  }\n\n  /** Touch-only devices see only the note and Settings. */\n  setTouchOnly(on: boolean): void {\n    this.touchNote.style.display = on ? '' : 'none';\n    this.panel.el.style.display = on ? 'none' : '';\n    this.prompts.style.display = on ? 'none' : '';\n    this.panel.active = !on;\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    if (id === 'begin') {\n      if (!host.save.started) host.open(new PierScreen(host));\n      else host.beginPlay();\n    } else if (id === 'free') host.open(new BoardScreen(host, true));\n    else if (id === 'group') host.open(new JoinScreen(host));\n    else if (id === 'settings') host.open(new SettingsScreen(host));\n    else if (id === 'about') host.open(new AboutScreen(host));\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n    const key = `${this.host.device()}|${this.host.glyphs()}`;\n    if (key !== this.lastKey) {\n      this.lastKey = key;\n      this.prompts.innerHTML = promptHtml('confirm', 'Choose', this.host.device(), this.host.glyphs());\n    }\n  }\n\n  /** Hides it, while attract plays or a screen is over it. */\n  show(on: boolean): void {\n    this.el.style.display = on ? '' : 'none';\n    if (!on) this.touchNote.style.display = 'none';\n    this.prompts.style.display = on ? '' : 'none';\n  }\n\n  remove(): void {\n    this.el.remove();\n    this.touchNote.remove();\n    this.prompts.remove();\n  }\n}\n\n/** Day 1, at the pier: pick one of three looks and a tracksuit colour. No name entry. */\nexport class PierScreen implements Screen {\n  readonly name = 'pier';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private look = 0;\n  private color = 0;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    this.panel = new Panel(this.el, {\n      id: 'pier',\n      title: 'Guest',\n      sub: 'The ferry is leaving. Who shall we say is here?',\n      sound: (cue) => host.cue(cue),\n      rows: [\n        { id: 'look', label: 'Look', value: () => ['Round', 'Long', 'Small'][this.look], adjust: (dir) => { this.look = (this.look + dir + 3) % 3; } },\n        { id: 'color', label: 'Tracksuit', value: () => COLORS[this.color], adjust: (dir) => { this.color = (this.color + dir + 2) % 2; } },\n        { id: 'go', label: 'Step off the ferry' },\n      ],\n      onCancel: () => host.close(this),\n      onPick: (id) => {\n        if (id !== 'go') return;\n        host.save = { ...host.save, started: true, look: this.look, color: COLORS[this.color] };\n        host.writeSave();\n        host.beginPlay();\n      },\n    }); // prettier-ignore\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\n\n/** The pause menu: pauses the sim; in a session it never does. */\nexport class PauseScreen implements Screen {\n  readonly name = 'pause';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const flow = host.flow();\n    const inEvent = flow?.mode === 'event';\n    const rows: Row[] = host.session\n      ? [\n          { id: 'resume', label: 'Resume' },\n          { id: 'settings', label: 'Volume and icons' },\n        ]\n      : [\n          { id: 'resume', label: 'Resume' },\n          { id: 'restart', label: 'Restart Activity', disabled: !inEvent },\n          { id: 'island', label: 'Back to the Island', disabled: !inEvent },\n          { id: 'settings', label: 'Settings' },\n          { id: 'controls', label: 'Controls' },\n          { id: 'dev', label: 'Dev Mode' },\n          { id: 'about', label: 'About / Credits' },\n          { id: 'title', label: 'Quit to Title' },\n        ];\n    this.panel = new Panel(this.el, {\n      id: 'pause',\n      title: 'Paused',\n      sub: 'Nobody is wobbling. You may look around.',\n      rows,\n      sound: (cue) => host.cue(cue),\n      onCancel: () => this.resume(),\n      onPick: (id) => this.pick(id),\n    });\n    if (!host.session) host.engine.inspector?.pause();\n  }\n\n  private resume(): void {\n    this.host.close(this);\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    if (id === 'resume') this.resume();\n    else if (id === 'restart') {\n      this.resume();\n      host.act('game.again');\n    } else if (id === 'island') {\n      this.resume();\n      host.act('game.leave');\n    } else if (id === 'settings') host.open(new SettingsScreen(host));\n    else if (id === 'controls') host.open(new ControlsScreen(host));\n    else if (id === 'dev') host.open(new DevScreen(host));\n    else if (id === 'about') host.open(new AboutScreen(host));\n    else if (id === 'title') {\n      this.resume();\n      host.toTitle();\n    }\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n    if (!this.host.session) this.host.engine.inspector?.resume();\n  }\n}\nEOF\ncat > labs/game/ui/screens/settings.ts <<'EOF'\n/**\n * @file Settings (PLAN.md section 8): Music (10% by default), Effects, Voices, Button icons, Mouse sensitivity, Invert look,\n * Rumble, Steadier Hands, Reduced Motion, Fullscreen, Group Class CPU guests, Erase Save with an in-game confirmation.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new SettingsScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { Panel, type Row } from '../panel';\nimport { NEW_SAVE } from '../save';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** A percentage row. */\nfunction volume(host: AppHost, id: string, label: string, key: 'music' | 'effects' | 'voices'): Row {\n  const set = (value: number) => {\n    host.settings = { ...host.settings, [key]: Math.round(Math.max(0, Math.min(1, value)) * 20) / 20 };\n    host.applySettings();\n  };\n  return {\n    id,\n    label,\n    value: () => `${Math.round(host.settings[key] * 100)}%`,\n    bar: () => host.settings[key],\n    adjust: (dir) => set(host.settings[key] + dir * 0.05),\n    setBar: set,\n  };\n}\n\n/** A yes or no row. */\nfunction toggle(host: AppHost, id: string, label: string, key: 'invert' | 'rumble' | 'steadier' | 'reduced' | 'cpuGuests'): Row {\n  return {\n    id,\n    label,\n    value: () => (host.settings[key] ? 'On' : 'Off'),\n    adjust: () => {\n      host.settings = { ...host.settings, [key]: !host.settings[key] };\n      host.applySettings();\n    },\n  };\n}\n\n/** Settings. */\nexport class SettingsScreen implements Screen {\n  readonly name = 'settings';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private confirm: Panel | null = null;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const rows: Row[] = [\n      volume(host, 'music', 'Music', 'music'),\n      volume(host, 'effects', 'Effects', 'effects'),\n      volume(host, 'voices', 'Voices', 'voices'),\n      {\n        id: 'glyphs',\n        label: 'Button icons',\n        value: () => (host.settings.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'),\n        adjust: () => {\n          host.settings = { ...host.settings, glyphs: host.settings.glyphs === 'xbox' ? 'playstation' : 'xbox' };\n          host.applySettings();\n        },\n      },\n    ];\n    if (!host.session) {\n      rows.push(\n        {\n          id: 'mouse',\n          label: 'Mouse sensitivity',\n          value: () => `${Math.round(host.settings.mouse * 100)}%`,\n          bar: () => host.settings.mouse / 2,\n          adjust: (dir) => {\n            host.settings = { ...host.settings, mouse: Math.max(0.25, Math.min(2, host.settings.mouse + dir * 0.25)) };\n            host.applySettings();\n          },\n          setBar: (u) => {\n            host.settings = { ...host.settings, mouse: Math.max(0.25, u * 2) };\n            host.applySettings();\n          },\n        },\n        toggle(host, 'invert', 'Invert look', 'invert'),\n        toggle(host, 'rumble', 'Rumble', 'rumble'),\n        toggle(host, 'steadier', 'Steadier Hands', 'steadier'),\n        toggle(host, 'reduced', 'Reduced Motion', 'reduced'),\n        {\n          id: 'fullscreen',\n          label: 'Fullscreen',\n          value: () => (document.fullscreenElement ? 'On' : 'Off'),\n          adjust: () => {\n            if (document.fullscreenElement) void document.exitFullscreen();\n            else void document.documentElement.requestFullscreen().catch(() => undefined);\n          },\n        },\n        toggle(host, 'cpuGuests', 'CPU guests in class', 'cpuGuests'),\n        { id: 'erase', label: 'Erase Save' },\n      );\n    }\n    this.panel = new Panel(this.el, {\n      id: 'settings',\n      title: 'Settings',\n      rows,\n      sound: (cue) => host.cue(cue),\n      onCancel: () => host.close(this),\n      onPick: (id) => {\n        if (id === 'erase') this.askErase();\n      },\n    });\n  }\n\n  /** Erase asks in-game: never `confirm()`. */\n  private askErase(): void {\n    const { host } = this;\n    this.panel.active = false;\n    this.panel.el.style.display = 'none';\n    this.confirm = new Panel(this.el, {\n      id: 'erase',\n      title: 'Erase your save?',\n      sub: 'Your Wobble Ages, your cairn, your days. The scale will forget you. It is good at that now.',\n      rows: [\n        { id: 'keep', label: 'Keep it' },\n        { id: 'erase', label: 'Erase it' },\n      ],\n      sound: (cue) => host.cue(cue),\n      onCancel: () => this.closeConfirm(),\n      onPick: (id) => {\n        if (id === 'erase') {\n          host.save = { ...NEW_SAVE };\n          host.writeSave();\n          host.closeAll();\n          host.toTitle();\n        } else this.closeConfirm();\n      },\n    });\n  }\n\n  private closeConfirm(): void {\n    this.confirm?.remove();\n    this.confirm = null;\n    this.panel.el.style.display = '';\n    this.panel.active = true;\n  }\n\n  update(input: Input, dt: number): void {\n    if (this.confirm) this.confirm.update(input, dt);\n    else this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/controls.ts <<'EOF'\n/**\n * @file Controls (PLAN.md section 8): the bindings per scheme, in words and glyphs; keyboard rebinding through the engine's\n * `bindingsFor`, `rebind` and `listen`. The store keeps what you change.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new ControlsScreen(host));\n */\nimport { codeLabel, type Input } from '../../../../engine';\nimport { Panel, type Row } from '../panel';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** What may be rebound on the keyboard: the balance map's actions. */\nconst REBINDABLE: readonly (readonly [string, string])[] = [\n  ['forward', 'Lean forward'],\n  ['back', 'Lean back'],\n  ['left', 'Lean left'],\n  ['right', 'Lean right'],\n  ['footl', 'Left foot'],\n  ['footr', 'Right foot'],\n  ['gentle', 'Lean gently'],\n  ['act', 'Skip, confirm'],\n];\n\n/** What a pad does, in words. */\nconst PAD_ROWS: readonly (readonly [string, string, string])[] = [\n  ['Lean', 'Left stick or D-pad', 'Left stick or D-pad'],\n  ['Feet', 'L2 and R2 (L1 and R1 too)', 'LT and RT (LB and RB too)'],\n  ['Breathe', 'L2 + R2 together', 'LT + RT together'],\n  ['On the island', 'Cross use, Square hop, Triangle Programme, Circle wave', 'A use, X hop, Y Programme, B wave'],\n  ['Pause', 'Options', 'Menu'],\n];\n\n/** Controls. */\nexport class ControlsScreen implements Screen {\n  readonly name = 'controls';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private listening = false;\n  private page: 'keys' | 'pad' = 'keys';\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    this.panel = new Panel(this.el, {\n      id: 'controls',\n      title: 'Controls',\n      sub: 'Pick a key to change it, then press the new one.',\n      rows: this.keyRows(),\n      sound: (cue) => host.cue(cue),\n      onCancel: () => host.close(this),\n      onPick: (id) => this.pick(id),\n    });\n  }\n\n  private bindings() {\n    return this.host.engine.input!.bindingsFor('actionMap:balance');\n  }\n\n  private keyRows(): Row[] {\n    const rows: Row[] = REBINDABLE.map(([action, label]) => ({\n      id: action,\n      label,\n      value: () => {\n        const code = this.bindings().codes(action).find((c) => !c.startsWith('Pad') && !c.startsWith('Mouse'));\n        return code ? codeLabel(code) : 'None';\n      },\n    }));\n    rows.push({ id: 'reset', label: 'Reset keys' }, { id: 'padpage', label: 'Show the pad' });\n    return rows;\n  }\n\n  private padRows(): Row[] {\n    const xbox = this.host.settings.glyphs === 'xbox';\n    return [\n      ...PAD_ROWS.map(([label, ps, xb]) => ({ id: label, label, value: () => (xbox ? xb : ps), disabled: true })),\n      { id: 'keypage', label: 'Show the keys' },\n    ];\n  }\n\n  private pick(id: string): void {\n    if (id === 'padpage') {\n      this.page = 'pad';\n      this.panel.setRows(this.padRows());\n      return;\n    }\n    if (id === 'keypage') {\n      this.page = 'keys';\n      this.panel.setRows(this.keyRows());\n      return;\n    }\n    if (id === 'reset') {\n      this.bindings().reset();\n      return;\n    }\n    if (this.listening) return;\n    this.listening = true;\n    this.panel.active = false;\n    const row = this.panel.el.querySelector<HTMLElement>(`[data-id=\"${id}\"] [data-value]`);\n    if (row) row.textContent = 'Press a key…';\n    void this.host.engine.input!.listen('keyboard').then((code) => {\n      this.listening = false;\n      this.panel.active = true;\n      if (code) {\n        const bindings = this.bindings();\n        const was = bindings.codes(id).find((c) => !c.startsWith('Pad') && !c.startsWith('Mouse'));\n        const result = bindings.rebind(id, code, was ? { replace: was } : {});\n        if (!result.ok) this.host.sound.play('sfx:miss');\n      }\n      this.panel.refresh();\n    });\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n    void this.page;\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/about.ts <<'EOF'\n/**\n * @file About / Credits (PLAN.md section 8), paged, from one data file: Source Information, Testing Feedback, Engine Feedback,\n * Prompt Feedback, credits. Every field is on screen, a few to a page, at sofa size.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new AboutScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { CREDITS, ENGINE_FEEDBACK, PROMPT_FEEDBACK, SOURCE_INFO, SOURCE_LABELS, TESTING_FEEDBACK } from '../about-data';\nimport { promptHtml } from '../glyphs';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** How many characters fit a page at this size. */\nconst PAGE_CHARS = 620;\n\n/** Splits entries into pages by length. */\nfunction paginate(title: string, entries: readonly string[]): { title: string; body: string }[] {\n  const pages: { title: string; body: string }[] = [];\n  let body = '';\n  for (const entry of entries) {\n    if (body && body.length + entry.length > PAGE_CHARS) {\n      pages.push({ title, body });\n      body = '';\n    }\n    body += `${entry}\\n\\n`;\n  }\n  if (body) pages.push({ title, body });\n  return pages;\n}\n\n/** Every page, in order. */\nexport function aboutPages(): { title: string; body: string }[] {\n  const qa = (list: readonly (readonly [string, string])[]) => list.map(([q, a]) => `<b>${q}</b>\\n${a}`);\n  return [\n    ...paginate('Source Information', SOURCE_LABELS.map(([key, label]) => `<b>${label}:</b> ${SOURCE_INFO[key]}`)),\n    ...paginate('Testing Feedback', qa(TESTING_FEEDBACK)),\n    ...paginate('Engine Feedback', qa(ENGINE_FEEDBACK)),\n    ...paginate('Prompt Feedback', qa(PROMPT_FEEDBACK)),\n    ...paginate('Credits', CREDITS),\n  ];\n}\n\n/** About. */\nexport class AboutScreen implements Screen {\n  readonly name = 'about';\n  readonly modal = true;\n  private el: HTMLElement;\n  private pages = aboutPages();\n  private page = 0;\n  private body: HTMLElement;\n  private title: HTMLElement;\n  private foot: HTMLElement;\n  private key = '';\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel';\n    panel.dataset.panel = 'about';\n    this.title = document.createElement('div');\n    this.title.className = 'tf-h1';\n    this.body = document.createElement('div');\n    this.body.className = 'tf-about';\n    this.body.dataset.ui = 'about';\n    this.foot = document.createElement('div');\n    this.foot.className = 'tf-prompts';\n    this.foot.style.justifyContent = 'flex-start';\n    panel.append(this.title, this.body, this.foot);\n    panel.addEventListener('click', () => this.flip(1));\n    this.el.append(panel);\n    this.draw();\n  }\n\n  private flip(dir: number): void {\n    const n = this.pages.length;\n    this.page = (this.page + dir + n) % n;\n    this.host.cue('move');\n    this.draw();\n  }\n\n  private draw(): void {\n    const { title, body } = this.pages[this.page];\n    this.title.textContent = title;\n    this.body.innerHTML = body.trim();\n    this.key = '';\n  }\n\n  update(input: Input): void {\n    if (input.pressed('uiRight') || input.pressed('uiDown') || input.pressed('uiAccept')) this.flip(1);\n    else if (input.pressed('uiLeft') || input.pressed('uiUp')) this.flip(-1);\n    else if (input.pressed('uiCancel')) this.host.close(this);\n    const key = `${this.host.device()}|${this.host.glyphs()}|${this.page}`;\n    if (key !== this.key) {\n      this.key = key;\n      const d = this.host.device();\n      const g = this.host.glyphs();\n      this.foot.innerHTML = `<span>Page ${this.page + 1} of ${this.pages.length}</span>${promptHtml('confirm', 'Next', d, g)}${promptHtml('cancel', 'Back', d, g)}`;\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/programme.ts <<'EOF'\n/**\n * @file Today's Programme: up to four cards with stamps, each with Go; and the Noticeboard: a three by two page of activity\n * cards with best rank, L1 and R1 or Q and E paging. Going fades to the station: a player on a sofa never has to cross the\n * island. Evening and Results live in results.ts.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new ProgrammeScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { BOARD, dayOf, todaysNext } from '../../scenes/data/days';\nimport { rankOf } from '../../scenes/scoring';\nimport { promptHtml } from '../glyphs';\nimport { getLine } from '../lines/index';\nimport { CardGrid, layer, type AppHost, type Card, type Screen } from './types';\n\n/** An activity's name on a card. */\nexport const TITLES: Readonly<Record<string, string>> = {\n  morning: 'Morning Check',\n  poseA: 'Pose Class A',\n  poseB: 'Pose Class B',\n  poseC: 'Pose Class C',\n  pond: 'Still Pond',\n  reps: 'Reps Hall',\n  garden: 'Sand Garden',\n  paddle: 'Paddle Glide',\n  line: 'The Line',\n  step: 'Step Class',\n  hoop: 'Hoop Patrol',\n  plunge: 'Cliff Plunge',\n  jog: 'Island Jog',\n  group: 'Group Class',\n  tilt: 'The Great Tilt',\n  noticeboard: 'Find the Noticeboard',\n};\n\n/** Cards per page on the Noticeboard. */\nconst PER_PAGE = 6;\n\n/** Today's Programme. */\nexport class ProgrammeScreen implements Screen {\n  readonly name = 'programme';\n  readonly modal = true;\n  private el: HTMLElement;\n  private grid: CardGrid;\n  private foot: HTMLElement;\n  private key = '';\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel';\n    panel.dataset.panel = 'programme';\n    const flow = host.flow();\n    const day = flow?.day ?? 1;\n    const def = dayOf(day);\n    const h = document.createElement('div');\n    h.className = 'tf-h1';\n    h.textContent = day > 5 ? 'After' : `Day ${day}: ${def.title}`;\n    panel.append(h);\n    this.el.append(panel);\n    const done = flow?.done ?? [];\n    const next = flow ? todaysNext(flow) : null;\n    const cards: Card[] = def.items.map((id) => ({\n      id,\n      title: TITLES[id] ?? id,\n      sub: done.includes(id) ? 'Done' : id === next ? 'Next' : 'Today',\n      stamp: done.includes(id) ? 'Done' : undefined,\n    }));\n    if (next === null || day > 5) cards.push({ id: 'sleep', title: 'Sleep', sub: 'Your hut will know' });\n    if (day > 5 || (flow?.seen.length ?? 0) > 2) cards.push({ id: 'board', title: 'The Noticeboard', sub: 'Everything so far' });\n    this.grid = new CardGrid(panel, cards, cards.length > 4 ? 3 : 2, (id) => this.pick(id), (c) => host.cue(c));\n    this.foot = document.createElement('div');\n    this.foot.className = 'tf-prompts';\n    this.foot.style.marginTop = '2vh';\n    this.foot.style.justifyContent = 'flex-start';\n    panel.append(this.foot);\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    host.close(this);\n    if (id === 'sleep') host.act('game.sleep');\n    else if (id === 'board') host.open(new BoardScreen(host, false));\n    else if (id === 'noticeboard') {\n      host.act('game.go', { station: 'plaza' });\n      host.open(new BoardScreen(host, false));\n    } else host.act('game.start', { event: id });\n  }\n\n  update(input: Input, dt: number): void {\n    this.grid.update(input, dt);\n    if (input.pressed('uiCancel') || input.pressed('plan')) this.host.close(this);\n    const key = `${this.host.device()}|${this.host.glyphs()}`;\n    if (key !== this.key) {\n      this.key = key;\n      const [d, g] = [this.host.device(), this.host.glyphs()];\n      this.foot.innerHTML = `${promptHtml('confirm', 'Go', d, g)}${promptHtml('cancel', 'Back', d, g)}`;\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\n\n/** The Noticeboard. From the title it is Free Play. */\nexport class BoardScreen implements Screen {\n  readonly name = 'board';\n  readonly modal = true;\n  private el: HTMLElement;\n  private grid: CardGrid;\n  private page = 0;\n  private heading: HTMLElement;\n  private foot: HTMLElement;\n  private key = '';\n  private notice: HTMLElement;\n  private pebbles: number;\n\n  constructor(\n    private host: AppHost,\n    private free: boolean,\n  ) {\n    this.el = layer(host.root);\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel';\n    panel.dataset.panel = 'board';\n    this.heading = document.createElement('div');\n    this.heading.className = 'tf-h1';\n    this.notice = document.createElement('div');\n    this.notice.className = 'tf-sub';\n    panel.append(this.heading, this.notice);\n    this.el.append(panel);\n    this.pebbles = host.flow()?.pebbles ?? host.save.pebbles;\n    this.grid = new CardGrid(panel, this.cards(), 3, (id) => this.pick(id), (c) => host.cue(c));\n    this.foot = document.createElement('div');\n    this.foot.className = 'tf-prompts';\n    this.foot.style.marginTop = '2vh';\n    this.foot.style.justifyContent = 'flex-start';\n    panel.append(this.foot);\n    this.draw();\n    const flow = host.flow();\n    if (flow && !this.free) {\n      if (!flow.done.includes('noticeboard') && dayOf(flow.day).items.includes('noticeboard')) host.act('game.markDone', { id: 'noticeboard' });\n    }\n  }\n\n  private cards(): Card[] {\n    const seen = this.host.flow()?.seen ?? this.host.save.seen;\n    const bests = this.host.flow()?.bests ?? this.host.save.bests;\n    const start = this.page * PER_PAGE;\n    return BOARD.slice(start, start + PER_PAGE).map((id) => {\n      const met = seen.includes(id) || id === 'morning';\n      const best = bests[id];\n      return {\n        id,\n        title: met ? (TITLES[id] ?? id) : 'Not yet',\n        sub: best !== undefined ? `${rankOf(best)} ${best}` : met ? 'Not yet scored' : 'Nobody is teaching this yet',\n        disabled: !met,\n      };\n    });\n  }\n\n  private draw(): void {\n    const pages = Math.ceil(BOARD.length / PER_PAGE);\n    const day = this.host.flow()?.day ?? this.host.save.day;\n    this.heading.textContent = this.free ? `Free Play ${this.page + 1} of ${pages}` : `Noticeboard ${this.page + 1} of ${pages}`;\n    const unlocks = this.pebbles >= 40 ? 'unlock.stamps' : this.pebbles >= 30 ? 'unlock.headband' : this.pebbles >= 20 ? 'unlock.color' : this.pebbles >= 10 ? 'unlock.expert' : '';\n    const line = unlocks && this.page === 1 ? getLine(unlocks)?.text : getLine(`notice.${Math.min(6, day)}`)?.text;\n    this.notice.textContent = line ?? '';\n    this.grid.setCards(this.cards());\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    host.close(this);\n    if (this.free) {\n      host.freePlay = true;\n      host.beginPlay();\n    }\n    host.act('game.start', { event: id });\n  }\n\n  update(input: Input, dt: number): void {\n    this.grid.update(input, dt);\n    const pages = Math.ceil(BOARD.length / PER_PAGE);\n    if (input.pressed('pageR')) {\n      this.page = (this.page + 1) % pages;\n      this.host.cue('move');\n      this.draw();\n    } else if (input.pressed('pageL')) {\n      this.page = (this.page - 1 + pages) % pages;\n      this.host.cue('move');\n      this.draw();\n    } else if (input.pressed('uiCancel')) this.host.close(this);\n    const key = `${this.host.device()}|${this.host.glyphs()}`;\n    if (key !== this.key) {\n      this.key = key;\n      const [d, g] = [this.host.device(), this.host.glyphs()];\n      this.foot.innerHTML = `${promptHtml('confirm', 'Go', d, g)}${promptHtml('pageL', 'Page', d, g)}${promptHtml('pageR', 'Page', d, g)}${promptHtml('cancel', 'Back', d, g)}`;\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/results.ts <<'EOF'\n/**\n * @file Results: one word, one number, one sentence, one small graph; pebbles falling onto a little cairn. The Morning Check\n * gets a big dial that spins past 100, \"recalibrating\", overshoots and settles. Evening: a calendar stamp, the age graph, a\n * closing remark, Sleep. Credits: every guest holding a pose as the camera drifts past.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new ResultsScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { getLine } from '../lines/index';\nimport { CREDITS } from '../about-data';\nimport { Panel, type Row } from '../panel';\nimport { layer, type AppHost, type Screen } from './types';\nimport { BoardScreen, TITLES } from './programme';\n\n/** A small line graph of ages, as SVG. Oldest first; lower is better. */\nfunction ageGraph(ages: readonly number[]): string {\n  const list = ages.slice(-7);\n  if (list.length === 0) return '';\n  const [w, h] = [320, 100];\n  const x = (i: number) => (list.length === 1 ? w / 2 : 18 + (i * (w - 36)) / (list.length - 1));\n  const y = (age: number) => 12 + ((age - 18) / 64) * (h - 24);\n  const line = list.map((age, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(age).toFixed(1)}`).join(' ');\n  const dots = list.map((age, i) => `<circle cx=\"${x(i).toFixed(1)}\" cy=\"${y(age).toFixed(1)}\" r=\"6\" fill=\"#ff8a70\"/>`).join('');\n  return `<svg class=\"tf-graph\" data-ui=\"graph\" viewBox=\"0 0 ${w} ${h}\"><rect width=\"${w}\" height=\"${h}\" rx=\"18\" fill=\"#f6efe0\"/><path d=\"${line}\" stroke=\"#3a4a55\" stroke-width=\"3.5\" fill=\"none\"/>${dots}</svg>`;\n}\n\n/** The age remark. */\nfunction ageRemark(age: number, before: number | undefined): string {\n  if (before === undefined) return (getLine('age.first', age)?.text ?? '').replaceAll('{age}', String(age));\n  const diff = Math.abs(before - age);\n  const id = age < before ? 'age.younger' : age > before ? 'age.older' : 'age.same';\n  return (getLine(id, age)?.text ?? '').replaceAll('{age}', String(age)).replaceAll('{before}', String(before)).replaceAll('{diff}', String(diff));\n}\n\n/** Results. */\nexport class ResultsScreen implements Screen {\n  readonly name = 'results';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private t = 0;\n  private needle: HTMLElement | null = null;\n  private dialValue: HTMLElement | null = null;\n  private note: HTMLElement | null = null;\n  private age: number | undefined;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    const last = host.flow()?.last ?? {};\n    const box = document.createElement('div');\n    box.className = 'tf-panel';\n    box.dataset.panel = 'results';\n    box.style.cssText = 'display:flex;gap:5vh;align-items:center';\n    const left = document.createElement('div');\n    left.style.cssText = 'text-align:center;display:flex;flex-direction:column;gap:1.4vh;align-items:center';\n    const title = document.createElement('div');\n    title.className = 'tf-sub';\n    title.textContent = TITLES[last.event ?? ''] ?? last.event ?? '';\n    left.append(title);\n    this.age = last.age;\n    if (last.age !== undefined) {\n      const dial = document.createElement('div');\n      dial.className = 'tf-dial';\n      dial.innerHTML = '<div class=\"note\">Recalibrating</div><div class=\"needle\"></div><div class=\"value\" data-ui=\"age\">--</div>';\n      left.append(dial);\n      this.needle = dial.querySelector('.needle');\n      this.dialValue = dial.querySelector('.value');\n      this.note = dial.querySelector('.note');\n      host.sound.play('sfx:dialSpin');\n    } else {\n      const rank = document.createElement('div');\n      rank.className = 'tf-rank';\n      rank.dataset.ui = 'rank';\n      rank.textContent = last.rank ?? '';\n      const score = document.createElement('div');\n      score.className = 'tf-score';\n      score.dataset.ui = 'score';\n      score.textContent = String(last.score ?? 0);\n      left.append(rank, score);\n    }\n    const right = document.createElement('div');\n    right.style.cssText = 'display:flex;flex-direction:column;gap:2vh;align-items:center';\n    if (last.age !== undefined) {\n      const remark = document.createElement('div');\n      remark.style.cssText = 'max-width:66vh;font-size:3vh;font-weight:600';\n      remark.dataset.ui = 'remark';\n      remark.textContent = ageRemark(last.age, last.ageBefore);\n      right.append(remark);\n      const ages = host.flow()?.ages ?? [];\n      const g = document.createElement('div');\n      g.innerHTML = ageGraph(ages);\n      right.append(g);\n    }\n    const cairn = document.createElement('div');\n    cairn.className = 'tf-pebbles';\n    cairn.dataset.ui = 'pebbles';\n    const count = last.pebbles ?? 0;\n    for (let i = 0; i < count; i++) {\n      const stone = document.createElement('div');\n      stone.className = 'tf-pebble';\n      stone.style.left = `${6 + (i % 3) * 7}vh`;\n      stone.style.bottom = `${Math.floor(i / 3) * 2.6}vh`;\n      stone.style.animationDelay = `${0.4 + i * 0.28}s`;\n      cairn.append(stone);\n      setTimeout(() => host.sound.play('sfx:clack'), 800 + i * 280);\n    }\n    right.append(cairn);\n    const rows: Row[] = [\n      { id: 'carry', label: 'Carry on' },\n      { id: 'again', label: 'Again', disabled: last.event === 'tilt' || last.event === 'morning' },\n    ];\n    this.panel = new Panel(right, { id: 'results-menu', rows, sound: (cue) => host.cue(cue), onPick: (id) => this.pick(id) });\n    this.panel.el.style.boxShadow = 'none';\n    this.panel.el.style.background = 'transparent';\n    this.panel.el.style.padding = '0';\n    box.append(left, right);\n    this.el.append(box);\n    host.sound.play('sfx:stamp');\n    host.sound.audio.stinger('song:stamp');\n  }\n\n  private pick(id: string): void {\n    const { host } = this;\n    host.close(this);\n    if (id === 'again') host.act('game.again');\n    else {\n      host.act('game.leave');\n      if (host.freePlay && host.flow()?.mode === 'roam') host.open(new BoardScreen(host, false));\n    }\n  }\n\n  update(input: Input, dt: number): void {\n    this.t += dt;\n    this.panel.update(input, dt);\n    if (this.needle && this.age !== undefined) {\n      const settle = 2.6;\n      const u = Math.min(1, this.t / settle);\n      // It spins past 100, overshoots and settles.\n      const shown = u < 1 ? this.age + (1 - u) * (130 - this.age) * Math.cos(u * 11) * (1 - u) : this.age;\n      this.needle.style.transform = `rotate(${(-140 + ((shown - 18) / 64) * 280).toFixed(1)}deg)`;\n      if (this.dialValue) this.dialValue.textContent = u < 1 ? String(Math.round(Math.max(0, shown))) : String(this.age);\n      if (this.note) this.note.textContent = u < 1 ? 'Recalibrating' : 'Wobble Age';\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\n\n/** Evening. */\nexport class EveningScreen implements Screen {\n  readonly name = 'evening';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n\n  constructor(\n    private host: AppHost,\n    private finished: number,\n    onDone: () => void,\n  ) {\n    this.el = layer(host.root);\n    const flow = host.flow();\n    const remark = getLine(`evening.${Math.min(6, finished)}`, finished)?.text ?? '';\n    this.panel = new Panel(this.el, {\n      id: 'evening',\n      title: finished > 5 ? 'Another evening' : `Day ${finished} is stamped`,\n      sub: remark,\n      rows: [{ id: 'sleep', label: 'Sleep' }],\n      sound: (cue) => host.cue(cue),\n      onPick: () => {\n        host.close(this);\n        onDone();\n      },\n    });\n    const graph = document.createElement('div');\n    graph.innerHTML = ageGraph(flow?.ages ?? []);\n    graph.style.margin = '2vh 0';\n    this.panel.el.insertBefore(graph, this.panel.el.querySelector('.tf-rows'));\n    host.sound.play('sfx:stamp');\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\n\n/** The credits: the camera drifts past the guests; you may stay as long as you like. */\nexport class CreditsScreen implements Screen {\n  readonly name = 'credits';\n  readonly modal = true;\n  private el: HTMLElement;\n  private t = 0;\n  private body: HTMLElement;\n  private i = 0;\n  private list: string[];\n\n  constructor(\n    private host: AppHost,\n    private onDone: () => void,\n  ) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-layer';\n    this.el.dataset.ui = 'credits';\n    this.el.style.alignItems = 'flex-end';\n    host.root.append(this.el);\n    const box = document.createElement('div');\n    box.className = 'tf-panel';\n    this.body = document.createElement('div');\n    this.body.style.cssText = 'font-size:3.2vh;font-weight:650;max-width:120vh;text-align:center';\n    box.append(this.body);\n    this.el.append(box);\n    this.list = ['Thank you for standing.', ...CREDITS, 'You may stay as long as you like. The ferry does not return.'];\n    this.body.textContent = this.list[0];\n  }\n\n  update(input: Input, dt: number): void {\n    this.t += dt;\n    const each = 4;\n    const at = Math.floor(this.t / each);\n    if (at !== this.i && at < this.list.length) {\n      this.i = at;\n      this.body.textContent = this.list[at];\n    }\n    if (at >= this.list.length || input.pressed('uiAccept') || input.pressed('uiCancel')) {\n      this.host.close(this);\n      this.onDone();\n    }\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/actions.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  'game.front': (w: GameWorld) => {\"\"\",\"\"\"  'game.markDone': (w: GameWorld, args: unknown) => {\n    const { id } = (args ?? {}) as { id: string };\n    const flow = flowOf(w);\n    if (!flow.done.includes(id)) flow.done.push(id);\n  },\n  'game.front': (w: GameWorld) => {\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/maps.ts'\ns=open(p).read()\ns=s.replace(\"  actions: { ...WALK },\\n  lock: false,\",\"  actions: { ...WALK, pageL: ['PadLeftShoulder', 'KeyQ'], pageR: ['PadRightShoulder', 'KeyE'], plan: ['Tab', 'PadNorth'] },\\n  lock: false,\")\nopen(p,'w').write(s)\nEOF\n","description":"Write screens: menus, settings, controls, about, programme, results"}}}
