umber, axes: readonly [number, number]): [number, number] {\n211-  const [right, forward] = axes;\n212-  const length = Math.sqrt(right * right + forward * forward);\n213-  const k = length > 1 ? 1 / length : 1;\n214-  const s = Math.sin(yaw);\n215-  const c = Math.cos(yaw);\n216-  return [k * (forward * s - right * c), k * (forward * c + right * s)];\n217-}\n218-\nreps {\nstep { p: [ 1000, 1000 ], h: [ 938, 941 ], s: [ 668, 690 ], i: [ 0, 0 ] }\nline { p: [ 1000, 1000 ], h: [ 1000, 1000 ], s: [ 976, 976 ], i: [ 0, 0 ] }\n      Tests  3 passed (3)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DEzEisjY1kqGh2nXoQ1iWc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
