{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BomHJsfukDXgVzEnqdbeMj","type":"tool_result","content":"/**\n * @file The game's HTML/CSS overlay (PLAN.md §6.7, WP 6.5; doctrine: WebGPU only): what a game shows over the canvas\n * as page elements, never drawn on the GPU. `createOverlay({ canvas })` puts a root over the canvas, sized to it each\n * frame, holding world-anchored labels and damage numbers (engine/ui/labels.ts), HUD lines in six places and a\n * crosshair. Call `update(camera, dt)` once per frame after drawing, with the camera the frame was drawn with; tests\n * and agents read it all through `state()` (engine/ui/state.ts) or DOM queries on `[data-ui]`.\n *\n * Elements: `[data-ui=label]` (`data-id`), `[data-ui=damage]` (`data-value`), `[data-ui=hud]` (`data-id`, and\n * `data-keyboard` for a key hint), `[data-ui=crosshair]` while it shows; WP 10.6's widgets (engine/ui/widgets.ts,\n * dialog.ts, menu.ts) in the HUD's places (`attach`) or over the root. Text uses the system font. The overlay's\n * stylesheet is one `<style id=\"ui-overlay-style\">` it adds to the page (no engine module imports a `.css` file: tsx,\n * which runs every `x` command, cannot load one). Damage numbers animate with CSS keyframes, paused and driven by the\nexport interface OverlayOptions {\n  canvas: HTMLCanvasElement;\n}\nexport interface Overlay {\n  readonly root: HTMLElement;\n  label(text: string, options: LabelOptions): Label;\n  damage(value: number | string, options: DamageOptions): void;\n  hud(id: string, text: string | null, options?: HudOptions): void;\n  attach(element: HTMLElement, at?: HudPlace): void;\n  crosshair(on: boolean): void;\n  update(camera: OverlayCamera, dt: number): void;\n  state(): UiState;\n  dispose(): void;\n}\nexport interface LabelOptions {\n  /** Where it is (see `Anchor`). */\n  at: Anchor;\n  /** Its `data-id`, for DOM queries and `ui.state()` (`label:<n>` by default). */\n  id?: string;\n  /** Its text colour (CSS). */\n  color?: string;\n  /** Whether it hides while its box overlaps a nearer decluttering label's on screen (false: it draws under it). */\n  declutter?: boolean;\n}\nexport interface Label {\n  readonly id: string;\n  readonly element: HTMLElement;\n  text: string;\nexport interface LabelOptions {\n  /** Where it is (see `Anchor`). */\n  at: Anchor;\n  /** Its `data-id`, for DOM queries and `ui.state()` (`label:<n>` by default). */\n  id?: string;\n  /** Its text colour (CSS). */\n  color?: string;\n  /** Whether it hides while its box overlaps a nearer decluttering label's on screen (false: it draws under it). */\n  declutter?: boolean;\n}\n124-\n125-/** Makes a page's sound (see the file comment). */\n126:export function createAudio(options: AudioOptions = {}): Audio {\n127-  const registry = options.registry ?? sharedRegistry;\n128-  const out = options.log ?? sharedLog;\n129-  sfxKind(registry);\n130-  songKind(registry);\n131-  /** `id` once it names a song or an effect; else throws `CORE_NO_ENTRY` naming the closest effects. */\n132-  const checkSound = (id: string) => (registry.has('song', id) ? id : getSfx(id, registry).id);\n133-  const footsteps = options.footsteps ?? {};\n134-  const pool = createVoicePool<RuntimeSound>(options.limits);\n135-  const buffers = new Map<string, AudioBuffer>();\n136-  const turns = new Map<string, number>();\n137-  const bindings = new Map<string, string>();\n138-  const volumes = { ...BUS_VOLUMES };\n139-  let muted = false;\n140-  let room: RoomName | RoomSpec = 'none';\nexport interface AudioOptions {\n  /** The context to play into (an `OfflineAudioContext` in a test); one is made on the first gesture by default. */\n  context?: BaseAudioContext;\n  /** Where gestures arrive (`window`). */\n  window?: GestureTarget;\n  /** Where the effects and songs come from (the shared registry). */\n  registry?: Registry;\n  /** The voice limits over the defaults (voices.ts). */\n  limits?: Partial<VoiceLimits>;\n  /** Surface tag → `sfx` id for footsteps; `'*'` for any other tag. */\n  footsteps?: Readonly<Record<string, string>>;\n  /** The seed the effects render from (0). */\n  seed?: number;\n  /** Where advice goes (the shared log). */\n  log?: Log;\n}\nexport interface SfxSpec {\n  /** One voice, or a list played together. */\n  voices?: SoundDef;\n  /** Other effects mixed in. */\n  layers?: readonly SfxLayer[];\n  /** How many versions the runtime picks between; 1 by default. */\n  variants?: number;\n  /** How far the variants' pitch spreads either way, as a fraction; 0.03 by default. */\n  vary?: number;\n  /** The mixer bus; `effects` by default. */\n  bus?: SfxBus;\n  /** Played looped, the pass it repeats, s (see the file comment); 0 (the whole render) by default. */\n  loop?: number;\n}\n3: * one voice or a list of voices played together, in the source chip synth's words (`wave`, `freq`, `to`, `dur`,\n4: * `vol`, `attack`, `hold`, `arp`, `step`, `loop`, `vib`, `filter`, `q`), so its effects, drums and songs copy over as\n5: * they are (WP 9.2), plus ADSR (`decay`, `sustain`, `release`), a start time `at`, an explicit filter, `fm`, `pluck`\n9: * Defaults (the source's): wave `square`, freq 440 Hz, dur 0.15 s (at least 0.012 s), vol 0.3, attack 0.004 s, step\n11: * false` makes it fall), because a string fades by itself. A noise voice without `filter` goes through a bandpass that\n13: * 20 Hz are raised to 20 Hz, as in the source. A filter given by its type alone (`filter: 'lowpass'`) follows the\n15: * `vib` and `fm` are refused on them, and `fm` on noise. The source's `delay` (a start offset) is `at` here, because\n16: * `delay` is the echo. Unknown fields and waves are refused with the closest name, never ignored.\n19: * const [voice] = normalizeSound({ wave: 'pulse', freq: 'A4', to: 880, dur: 0.14 }, 44100);\n33:    template: '{where}: there is no wave \"{wave}\"{suggestion}',\n34:    fix: 'use one of {waves}',\n35:    doc: 'Raised by `render` (engine/audio/dsp/render.ts) when a voice names a wave the DSP does not make.',\n40:    doc: 'Raised by `render` (engine/audio/dsp/render.ts) for a field a voice, filter, fm, pluck or delay does not have: usually a typo, which would otherwise be silen\n45:    doc: 'Raised by `render` (engine/audio/dsp/render.ts) for a value of the wrong type or outside its range, and for fields that do not apply to the voice (a pitch ch\nexport interface Voice {\n  /** The wave; `square` by default. */\n  wave?: Wave;\n  /** The pitch (for noise, its filter's frequency); 440 Hz by default. */\n  freq?: Pitch;\n  /** Sweeps the pitch exponentially to this over the voice. */\n  to?: Pitch;\n  /** Seconds, the release included; 0.15 by default. */\n  dur?: number;\n  /** The peak gain; 0.3 by default. */\n  vol?: number;\n  /** When the voice starts within the sound, in seconds; 0 by default. */\n  at?: number;\n  /** Seconds from silence to full volume; 0.004 by default. */\n  attack?: number;\n  /** Sustains full volume and releases over the last 30 ms, instead of falling away; a pluck's default. */\n  hold?: boolean;\n  /** ADSR: seconds from full volume to `sustain`; 0 by default. Any of decay, sustain, release makes the envelope ADSR.\n  decay?: number;\n  /** ADSR: the level held after the decay, from 0 to 1; 1 by default. */\n  sustain?: number;\n  /** ADSR: seconds of release, ending at the voice's end; 0.03 by default. */\n  release?: number;\n  /** An arpeggio: semitones over the pitch, one per `step`. */\n  arp?: readonly number[];\n  /** Seconds per arpeggio note; 0.06 by default. */\n  step?: number;\n  /** Repeats the arpeggio instead of holding its last note. */\n  loop?: boolean;\n  /** Vibrato: `[rate in Hz, depth as a fraction of the pitch]`. */\n  vib?: readonly [number, number];\n  /** A filter: a type that follows the pitch, or a `FilterSpec`. */\n  filter?: FilterType | FilterSpec;\n  /** The linear Q of the filter (and of a noise voice's bandpass); 1.1 by default. */\n  q?: number;\n  /** Simple FM on a tonal wave. */\n  fm?: FmSpec;\n  /** The string's settings, for `wave: 'pluck'`. */\n  pluck?: PluckSpec;\n  /** A feedback echo. */\n  delay?: DelaySpec;\n}\nexport interface SongSpec {\n  /** Beats per minute; 120 by default. */\n  bpm?: number;\n  /** Steps per beat; 4 (sixteenth notes) by default. */\n  steps?: number;\n  /** Beats per bar; 4 by default. */\n  beats?: number;\n  /** Loops when it ends; true by default. */\n  loop?: boolean;\n  /** The tracks, played together. */\n  tracks: readonly SongTrack[];\n  /** A drum track's tokens and the `sfx` ids they play; the engine's kit by default. */\n  kit?: Readonly<Record<string, string>>;\n}\nexport interface SongTrack {\n  /** One token per step: a note, `-` (hold), `.` (rest) or a kit token; `|` marks a bar line. */\n  notes: string;\n  /** `square` by default; `drums` plays kit tokens. */\n  wave?: TrackWave;\n  /** The notes' gain; 0.18 by default (and a drum track's 0.18 plays the kit as written). */\n  vol?: number;\n  /** Octaves added to every note; 0 by default. */\n  octave?: number;\n  /** The share of its held steps a note sounds for; 0.9 by default. */\n  gate?: number;\n  /** Seconds from silence to full volume; 0.006 by default. */\n  attack?: number;\n  /** Vibrato: `[rate in Hz, depth as a fraction of the pitch]`. */\n  vib?: readonly [number, number];\n  /** The music intensity from which the track plays, from 0 (always) to 1; 0 by default. */\n  intensity?: number;\n}\n * // await createEngine({ canvas, scenes, levels, onFrame: sound.frame });\n * // window.__boxSound.info().audio.state; // 'locked' until a key, then 'running'\n * @see labs/box/sounds/page.test.ts\n */\nimport {\n  createAudio,\n  getLevel,\n  type Audio,\n  type AudioInfo,\n  type CompiledLevel,\n  type ListenerPose,\n  type QueryView,\n  type RoomName,\n  type Sound,\n} from '../../../engine';\nimport './boxHall';\nimport './effects';\nimport { createSoundReader, type Point, type SoundWorld } from './events