hile the island tips.\n    const [ax, az] = [(island.tiltZ * 0.35 * Math.PI) / 360, (island.tiltX * 0.35 * Math.PI) / 360];\n    const ww = Math.sqrt(Math.max(0, 1 - ax * ax - az * az));\n    e.sceneProp.q = [ax, 0, az, ww];\n\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/components.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  fields: { x: n(0, 'Where it started, east.'), phase: n(0, 'Its phase.') },\n});\"\"\",\"\"\"  fields: { x: n(0, 'Where it started, east.'), phase: n(0, 'Its phase.'), span: n(0.03, 'How far it slides.') },\n});\n\ndefineComponent('roller', {\n  description: 'A marble that rolls by itself from Day 4.',\n  fields: { x: n(0, 'Centre, east.'), z: n(0, 'Centre, south.'), y: n(0, 'Height when shown.') },\n});\n\ndefineComponent('ferry', {\n  description: 'The ferry: it leaves, and does not return.',\n  fields: { t: i(0, 'Steps since it left.') },\n});\"\"\")\ns=s.replace(\"  slider: { x: number; phase: number };\",\"  slider: { x: number; phase: number; span: number };\\n  roller: { x: number; z: number; y: number };\\n  ferry: { t: number };\")\nopen(p,'w').write(s)\np='labs/game/props/stations.ts'\ns=open(p).read()\ns+=\"\"\"\nfree('prop:sign', 'A sign on the path from the pier. It says \"Please keep to the centre.\"', [\n  box('post', 0.1, 1.4, 0.1, 'material:clinical'),\n  box('face', 1.3, 0.6, 0.06, 'material:mint', [0, 1.2, 0]),\n]);\n\"\"\"\nopen(p,'w').write(s)\n# usable sign, plaque follows prop\np='labs/game/scenes/data/usables.ts'\ns=open(p).read()\ns=s.replace(\"  kind: 'board' | 'platform' | 'station' | 'person' | 'plaque' | 'bench' | 'hut' | 'stone';\",\"  kind: 'board' | 'platform' | 'station' | 'person' | 'plaque' | 'bench' | 'hut' | 'stone' | 'sign';\")\ns=s.replace(\"  { id: 'tare', kind: 'person', label: 'Talk', who: 'tare' },\",\"  { id: 'sign', kind: 'sign', label: 'Read', x: 6, z: 74 },\\n  { id: 'tare', kind: 'person', label: 'Talk', who: 'tare' },\")\ns=s.replace(\"\"\"    if (u.who === 'tare' && flow.mode === 'roam') return null; // she follows you; she talks by herself: use the board\n\"\"\",\"\")\ns=s.replace(\"\"\"    const e = w.query('plaque').find((p) => p.plaque.index === u.plaque);\n    return e ? [e.plaque.x, e.plaque.z] : null;\"\"\",\"\"\"    const e = w.query('plaque').find((p) => p.plaque.index === u.plaque);\n    const prop = e ? w.get(e.plaque.prop)?.sceneProp : undefined;\n    return prop ? [prop.x, prop.z] : null;\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/use.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  if (u.kind === 'board') w.emit('open', { what: 'noticeboard' });\n  else if (u.kind === 'plaque') {\"\"\",\"\"\"  if (u.kind === 'board') w.emit('open', { what: 'noticeboard' });\n  else if (u.kind === 'sign') say({ w }, 'tare', `notice.${Math.min(6, flow.day)}`);\n  else if (u.kind === 'plaque') {\"\"\")\nopen(p,'w').write(s)\n# Plumb's plait in the storm\np='labs/game/scenes/events/tilt.ts'\ns=open(p).read()\ns=s.replace(\"\"\"      case 'storm':\n        wob.on = false;\"\"\",\"\"\"      case 'storm': {\n        wob.on = false;\n        const plumb = castOf(c.w, 'plumb');\n        // In the storm the plait swings for the first time: the body sways a hair, and the chain does the rest.\n        if (plumb) plumb.cast.x = 2 + Math.sin(c.a.t * 0.16) * 0.07;\"\"\")\ns=s.replace(\"\"\"        c.hud.prompt = 'skip';\n        break;\n      case 'east': {\"\"\",\"\"\"        c.hud.prompt = 'skip';\n        break;\n      }\n      case 'east': {\"\"\")\nopen(p,'w').write(s)\n# group podium widget\np='labs/game/ui/hud/widgets.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    case 'jog':\n      return chip(\"\"\",\"\"\"    case 'podium': {\n      const totals = (show.totals ?? []) as number[];\n      const win = n('win');\n      const names = (show.names ?? []) as string[];\n      return `<div class=\"tf-panel\" data-ui=\"podium\" style=\"position:absolute;left:50%;top:22%;transform:translateX(-50%);text-align:center\"><div class=\"tf-h1\">Least Wobbly</div><div class=\"tf-rank\" style=\"font-size:7vh\">${names[win] ?? ''}</div><div class=\"tf-sub\">${totals.map((v, i) => (names[i] ? `${names[i]}: ${v}` : '')).filter(Boolean).join(' · ')}</div></div>`;\n    }\n    case 'jog':\n      return chip(\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/app.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    const inner = running.id === 'group' ? ((running.data as { inner?: ActivityData }).inner ?? running) : running;\n    this.hud.update({ activity: inner, hud: inner.hud, id: inner.id, phase: inner.phase, wobble: seat?.wobble, seat: seat?.seat, device: this.device_, glyphs: this.settings.glyphs });\"\"\",\"\"\"    const groupData = running.id === 'group' ? (running.data as { inner?: ActivityData; totals?: number[]; win?: number }) : null;\n    if (groupData && running.phase === 'podium') {\n      const names = this.sessionState ? this.sessionState.info.players.map((p) => p.name) : ['You', 'Gerald', 'Bex', 'Nan'];\n      this.hud.update({ activity: running, hud: { title: 'Group Class', show: { totals: groupData.totals, win: groupData.win, names } }, id: 'podium', phase: 'podium', device: this.device_, glyphs: this.settings.glyphs });\n      return;\n    }\n    const inner = groupData?.inner ?? running;\n    this.hud.update({ activity: inner, hud: inner.hud, id: inner.id, phase: inner.phase, wobble: seat?.wobble, seat: seat?.seat, device: this.device_, glyphs: this.settings.glyphs });\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/hud/hud.ts'\ns=open(p).read()\ns=s.replace(\"\"\"const list = hud.prompt === 'skip' ? ([['confirm', 'Skip']] as const) : (HINTS[id.startsWith('pose') || id === 'heron' ? 'ring' : id] ?? HINTS.ring);\"\"\",\"\"\"const list = hud.prompt === 'skip' ? ([['confirm', 'Skip']] as const) : id === 'podium' ? [] : (HINTS[id.startsWith('pose') || id === 'heron' ? 'ring' : id] ?? HINTS.ring);\"\"\")\nopen(p,'w').write(s)\nEOF\n","description":"Add story props, podium and outline fade; list inspector members"}}}
