pg)['device'])\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/app.ts'\ns=open(p).read()\na=s.index(\"  /** Which device was used last: glyphs follow it, the same frame. */\")\nb=s.index(\"  /** The screens, and pause. */\")\ns=s[:a]+\"\"\"  /** Which device was used last: glyphs follow it, the same frame. Pads are read here; keys and mouse by their events. */\n  updateDevice(): void {\n    for (const pad of navigator.getGamepads?.() ?? []) {\n      if (!pad) continue;\n      const pressed = pad.buttons.some((b) => b.pressed) || pad.axes.some((v) => Math.abs(v) > 0.4);\n      if (!pressed) continue;\n      this.device_ = 'gamepad';\n      this.idle = 0;\n      if (this.attract) this.endAttract();\n      if (!this.sawKeyOrPad) {\n        this.sawKeyOrPad = true;\n        this.title?.setTouchOnly(false);\n      }\n    }\n  }\n\n\"\"\"+s[b:]\ns=s.replace(\"this.updateDevice(input);\",\"this.updateDevice();\")\ns=s.replace(\"\"\"    addEventListener('keydown', hard);\n    addEventListener('pointerdown', (event) => {\n      if (event.pointerType === 'touch') {\n        this.idle = 0;\n        return;\n      }\n      hard();\n    });\"\"\",\"\"\"    addEventListener('keydown', () => {\n      this.device_ = 'keyboard';\n      hard();\n    });\n    addEventListener('pointerdown', (event) => {\n      if (event.pointerType === 'touch') {\n        this.idle = 0;\n        return;\n      }\n      this.device_ = 'mouse';\n      hard();\n    });\"\"\")\ns=s.replace(\"\"\"      if (event.pointerType === 'touch') return;\n      if (event.movementX !== 0 || event.movementY !== 0) wake();\"\"\",\"\"\"      if (event.pointerType === 'touch') return;\n      if (Math.abs(event.movementX) + Math.abs(event.movementY) > 1) {\n        wake();\n        if (this.engine.input?.mouse?.locked) this.device_ = 'mouse';\n      }\"\"\")\ns=s.replace(\"  lastInputKey = '';\\n\",\"\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"lastInputKey\" labs/game/ui/app.ts | head; export CHROMIUM_PATH=$HOME/.cache/ms-pla