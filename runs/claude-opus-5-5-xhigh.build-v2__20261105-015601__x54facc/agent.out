.html; TEETER_ABOUT_DUMP=out/about.txt timeout 400 python3 labs/game/tools/browser.py $H about; echo \"exit $?\"; wc -l out/about.txt; cat out/about.txt | cut -c1-260; echo \"--- gull+frog sound\"; grep -nEi \"gull|frog\" labs/game/sounds/effects.ts | cut -c1-140 | head -6","description":"Run stricter About check on the deliverable and dump its text","timeout":420000}}}
