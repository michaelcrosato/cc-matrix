as, sounds, bodies"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0196e7Dj6SPm1JhPpjvcCTPd","type":"tool_result","content":"/**\n * @file The prop `prop:{{name}}`: what it is (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a small wooden chest, a box of planks under a lid, that slides and tumbles when it is hit.\n *\n * Invariants: its parts stand on its base (the origin, +Y up), in metres, built from geometry and materials by id\n * (`node x describe geometry`, `node x describe material`); its body's shape stands on the base too, as tall as the\n * parts; `node x qa geo tex --only prop:{{name}}` checks its parts and their textures.\n *\n * @example\n * {{name}}.body.type; // 'dynamic'\n * @see {{id}}.test.ts\n */\nimport { defineProp } from '../../../engine/sim-api';\n\n/** The prop `prop:{{name}}`: replace this sentence with what it is. */\nexport const {{name}} = defineProp('prop:{{name}}', {\n  description: 'A small wooden chest: a box of planks under a lid (replace).',\n  parts: [\n    {\n      name: 'box',\n      geometry: 'geometry:box',\n      params: { width: 0.6, height: 0.3, depth: 0.4 },\n      material: 'material:planks',\n    },\n    {\n      name: 'lid',\n      geometry: 'geometry:box',\n      params: { width: 0.62, height: 0.15, depth: 0.42 },\n      material: 'material:planks',\n      position: [0, 0.3, 0],\n      tint: '#c8a080',\n    },\n  ],\n  body: { type: 'dynamic', shape: 'box', size: [0.6, 0.45, 0.4] },\n  place: { spawn: '{{name}}' },\n  gallery: { camera: 'turntable', duration: 0, states: [] }, // node x gallery: four views round it\n});\n/**\n * @file The camera mode `cam3={{name}}`: what it shows (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a side-scroller's dolly: it stands `distance` metres east of the player and `height` metres up, looks\n * west and down at a point a metre over his feet, and follows him with a lag (a time constant of 0.15 real seconds),\n * so a jump or a fall moves the picture smoothly and a stop settles it. Its code is\n * `cam3={{name}}[,<distance>,<height>]` in metres, 8 and 2.5 when left out.\n *\n * Invariants: view state, never the sim's: pure steps over plain data, which `followCamera` wraps in a camera; a\n * checked pose each frame (`makePose`: metres and radians, +Y up, its yaw the heading the intents' `cam` takes); `dt`\n * is real seconds since the last frame, so it frames alike at any frame rate. `defineCamera` adds the mode when the\n * page imports this module; from then `?cam3={{name}}`, `__engine.camera.set('cam3={{name}}', { blend: true })` and\n * the camera rig's blends reach it, and its name is a word no engine camera has.\n *\n * @example\n * import { createCamera } from '../../../engine';\n * const camera = createCamera('cam3={{name}},6');\n * camera.spec(); // { distance: 6, height: 2.5 }: 6 m east of the player, 2.5 m up\n * @see {{id}}.test.ts\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\n/** Where it stands when its code gives no numbers: metres east of the player, and up. */\nconst DEFAULTS = Object.freeze({ distance: 8, height: 2.5 });\n\n/** The point it looks at, over the player's feet (m), its follow's time constant (real s) and its lens (°, vertical). */\nconst AIM = 1;\nconst LAG = 0.15;\nconst FOV = 50;\n\n/** How its code is written: what a bad one is told. */\nconst FORM = 'cam3={{name}},<distance>,<height> (m), the distance over 0';\n\n/** Its code's numbers: metres east of the player, and up. */\ninterface Spec {\n  readonly distance: number;\n  readonly height: number;\n}\n\n/** Its state: its numbers, and the point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n    fov: FOV,\n    distance: Math.hypot(state.distance, rise),\n  });\n}\n\n/** The camera `cam3={{name}}`, standing `spec`'s metres from the player (see the file comment). */\nexport function {{name}}Camera(spec: Spec = DEFAULTS) {\n  return followCamera('{{name}}', { ...spec, at: null } as State, {\n    step,\n    pose,\n    spec: ({ distance, height }) => ({ distance, height }),\n    code: ({ distance, height }) => `cam3={{name}},${distance},${height}`,\n    describe: ({ distance, height }) => `{{name}}: ${distance} m east of the player, ${height} m up`,\n  });\n}\n\ndefineCamera('{{name}}', {\n  description: \"A side-scroller's dolly: east of the player, looking west, following him with a lag (replace).\",\n  create(code) {\n    const [distance = DEFAULTS.distance, height = DEFAULTS.height] = code.split(',').slice(1).map(Number);\n    if (!(distance > 0) || !Number.isFinite(height)) throw new Error(`${code} is no {{name}} camera: write ${FORM}`);\n    return {{name}}Camera({ distance, height });\n  },\n});\n/**\n * @file The emitter `emitter:{{name}}`: what it is (replace this text; `x docs` puts the first sentence in INDEX).\n * It starts as a puff of pale green spores drifting up, swirling and fading, burst at each `{{name}}` event.\n *\n * Invariants: its fields are the kind's (`node x describe emitter`), in metres and seconds; its colours are hex, a\n * brightness above 1 glows; it answers the event types in `events` (a view's `effects.event(type, { position })`).\n *\n * @example\n * {{name}}.events; // ['{{name}}']\n * @see {{id}}.test.ts\n */\nimport { defineEmitter } from '../../../engine';\n\n/** The emitter `emitter:{{name}}`: replace this sentence with what it is. */\nexport const {{name}} = defineEmitter('emitter:{{name}}', {\n  description: 'Pale green spores drifting up, swirling and fading (replace).',\n  area: [0.2, 0.1, 0.2],\n  velocity: [0, 0.8, 0],\n  spread: 0.5,\n  gravity: -0.3,\n  drag: 0.8,\n  turbulence: 1.5,\n  life: [0.8, 1.6],\n  size: [0.06, 0],\n  color: ['#c8ff9a', '#6ad16a'],\n  brightness: [1.5, 1],\n  alpha: [0.9, 0],\n  count: 16,\n  events: ['{{name}}'],\n  gallery: { camera: 'front', duration: 0, states: [] }, // node x gallery: four frames of its burst\n});\n/**\n * @file The effect `sfx:{{name}}`: what it is the sound of (replace this text; `x docs` puts the first sentence in INDEX).\n *\n * Invariants: voices in the chip synth's words (wave, freq, to, dur, vol, arp, vib, filter…; node x describe sfx lists\n * the kind's fields, engine/audio/dsp/voice.ts a voice's); `layers` mix other effects in ({ sfx, at, vol, pitch });\n * `variants` versions spread ±`vary` in pitch, for a sound heard often; `bus` is effects, ui or ambience.\n *\n * @example\n * {{name}}.id; // 'sfx:{{name}}'\n * @see {{id}}.test.ts\n */\nimport { defineSfx } from '../../../engine';\n\n/** The effect `sfx:{{name}}`: replace this sentence with what it is the sound of. */\nexport const {{name}} = defineSfx('sfx:{{name}}', {\n  voices: { wave: 'square', freq: 440, to: 880, dur: 0.12, vol: 0.25 },\n  variants: 4,\n});\n/**\n * @file The song `song:{{name}}`: where it plays and its mood (replace this text; `x docs` puts the first sentence in INDEX).\n *\n * Invariants: tracker notation, one token per step: a note (C4, F#3, Bb2), - h