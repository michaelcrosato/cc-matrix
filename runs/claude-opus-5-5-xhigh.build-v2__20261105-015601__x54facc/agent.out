 inside / steps, topples };\n  }\n  hash(): string;\n};\n\n/** A fresh engine on the island. */\nasync function fresh(seed: number): Promise<Engine> {\n  return (await createHeadless({ scene: island, seed })) as unknown as Engine;\n}\nconst flowOf = (engine: Engine): Flow => engine.state('flow').entities[0].flow as unknown as Flow;\n\ndescribe('the whole game', () => {\n  for (const seed of [1, 2, 3]) {\n    it(`plays from Day 1 to the credits on seed ${seed}`, async () => {\n      const engine = await fresh(seed);\n      engine.actions.run('game.begin', {});\n      engine.set('game.auto', true);\n      engine.set('game.skill', 'human');\n      const seen = new Set<string>();\n      const days = new Set<number>();\n      let n = 0;\n      let credits = false;\n      while (n < 60 * 60 * 60) {\n        engine.step(60);\n        n += 60;\n        const flow = flowOf(engine);\n        if (flow.mode === 'event') seen.add(flow.event);\n        days.add(flow.day);\n        if (flow.credits) credits = true;\n        if (credits && !flow.credits) break;\n      }\n12:import type { ActivityData, Cast, Flow, IslandData, Seat, Wobble } from '../scenes/components';\n102:  seat: { seat: Seat; wobble: Wobble } | undefined,\n  store!: Store;\n  root!: HTMLElement;\n  sound!: Sound;\n  save!: SaveData;\n  settings: SettingsData = { ...NEW_SETTINGS };\n  freePlay = false;\n  freeCamera = false;\n  throwaway = false;\n  cheats = { bot: false, god: false };\n  overlay!: StateOverlay;\n  stack: Screen[] = [];\n  title: TitleScreen | null = null;\n  hud!: Hud;\n/** Publishes the small read-only handle tests use. */\nexport function publishState(app: App, flow?: Flow | null, a?: ActivityData | null): void \n  (window as unknown as { __game: unknown }).__game = {\n    screen: app.stack.length ? app.stack[app.stack.length - 1].name : (flow?.mode ?? 'boot\n    stack: app.stack.map((s) => s.name),\n    attract: app.attract,\n    device: app.device_,\n    glyphs: app.settings.glyphs,\n    volu