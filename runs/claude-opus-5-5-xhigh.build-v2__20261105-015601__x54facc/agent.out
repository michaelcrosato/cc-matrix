 flow.found.includes(e.pebble.index)) prop.sceneProp.y = -30;\n  }\n}\n\n/** Where the `index`th cairn pebble sits: a tall stack in the Plaza, leaning by `lean`. */\nfunction cairnSpot(index: number, lean: number): [number, number, number] {\n  const [cx, cz] = CAIRN_AT;\n  const layer = Math.floor(index / 3);\n  const a = index * 2.399;\n  const r = Math.max(0.05, 0.42 - layer * 0.022);\n  const y = FLAT_Y + 0.02 + layer * 0.17;\n  const tip = layer * 0.012 * lean * 3;\n  return [cx + Math.cos(a) * r * 0.6 + tip, y, cz + Math.sin(a) * r * 0.6 + tip * 0.4];\n}\n\n/** Picks up hidden pebbles; keeps the sea drifting; lets drinks slide. */\n'''+s[b:].replace(\"/** One step of the world, after the physics. */\\n\",\"\").replace(\"\"\"export function stepIsland(w: GameWorld): void {\n  void flowOf(w);\n}\"\"\",\"\"\"export function stepIsland(w: GameWorld): void {\n  const flow = flowOf(w);\n  const island = islandOf(w);\n  const guest = castOf(w, 'guest');\n  const actor = guest ? w.get(guest.id)?.actor : undefined;\n  if (actor && flow.mode === 'roam') {\n    for (const e of w.query('pebble')) {\n      const { index } = e.pebble;\n      if (flow.found.includes(index)) continue;\n      const [px, pz] = HIDDEN_PEBBLES[index];\n      if (Math.hypot(actor.x - px, actor.z - pz) < 1.3) {\n        flow.found.push(index);\n        flow.pebbles += 1;\n        const prop = w.get(e.pebble.prop);\n        if (prop?.sceneProp) prop.sceneProp.y = -30;\n        w.emit('pebbleFound', { index, total: flow.found.filter((f) => f < 100).length });\n        syncCairn(w);\n      }\n    }\n  }\n  for (const e of w.query('sea', 'sceneProp')) {\n    e.sceneProp.x = Math.sin(island.seaX) * 6 + Math.cos(tickOf(w) * 0.0005) * 2;\n    e.sceneProp.z = Math.cos(island.seaZ) * 6;\n    e.sceneProp.y = SEA_Y + Math.sin(tickOf(w) * 0.02) * 0.04;\n  }\n  for (const e of w.query('slider', 'sceneProp')) {\n    // Drinks slide along tables: story tilt, a very little, a little more each day.\n    const slide = Math.sin(tickOf(w) * 0.004 + e.slider.phase) * 0.03 * island.tilt;\n    e.sceneProp.x = e.slider.x + slide;\n  }\n}\"\"\")\ns=s.replace(\"\"\"import { spawnCast } from '../cast/roster';\nimport type { GameWorld } from './components';\nimport { HIDDEN_PEBBLES, PLAQUES } from './data/plaques';\nimport { STATIONS } from './data/stations';\nimport { flowOf, groundAt } from './flow';\nimport { spawnCritters } from './critters';\n\"\"\",\"\"\"import { spawnProp } from '../../../engine/sim-api';\nimport { spawnCast } from '../cast/roster';\nimport type { GameWorld } from './components';\nimport { HIDDEN_PEBBLES, PLAQUES } from './data/plaques';\nimport { ANNEX_OFFSETS, FLAT_Y, MAT_OFFSETS, SEA_Y, STATIONS } from './data/stations';\nimport { castOf } from './events/kit';\nimport { flowOf, groundAt, islandOf } from './flow';\nimport { spawnCritters } from './critters';\n\n/** The most pebbles the cairn draws. */\nconst CAIRN_MAX = 60;\n/** Where the cairn stands. */\nexport const CAIRN_AT = [-4, 39] as const;\n/** The world's step, as a number. */\nconst tickOf = (w: GameWorld): number => w.tick;\n\"\"\")\ns=s.replace(\"  spawnProp(w, { prop: 'prop:sea', at: [0, SEA_Y, 0], yaw: 0 });\\n  spawnProp(w, { prop: 'prop:pondWater'\",\"  spawnProp(w, { prop: 'prop:sea', at: [0, SEA_Y, 0], yaw: 0 }, { components: { sea: {} } });\\n  spawnProp(w, { prop: 'prop:pondWater'\")\nopen(p,'w').write(s)\np='labs/game/scenes/components.ts'\ns=open(p).read()\ns=s.replace(\"defineComponent('critter', {\",\"\"\"defineComponent('sea', {\n  description: 'The sea prop: the world drifts it.',\n  fields: { on: b(true, 'Always.') },\n});\n\ndefineComponent('slider', {\n  description: 'A prop that slides with the story tilt: a drink, for instance.',\n  fields: { x: n(0, 'Where it started, east.'), phase: n(0, 'Its phase.') },\n});\n\ndefineComponent('critter', {\"\"\")\ns=s.replace(\"  pebble: { index: number; prop: number };\",\"  sea: { on: boolean };\\n  slider: { x: number; phase: number };\\n  pebble: { index: number; prop: number };\")\nopen(p,'w').write(s)\nEOF\nsed -i 's/from .\\.\\/data\\/usables/from \".\\/data\\/usables/' /dev/null; timeout 100 node x sim labs/game/scenes/island.ts --steps 120 2>&1 | head -6 | cut -c1-300; export CHROMIUM_PATH=$HOME/.cache/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell;timeout 200 node labs/game/tools/onefile.mjs out/game.html 2>&1 | tail -1 | cut -c1-300; timeout 200 python3 labs/game/tools/boottime.py out/game.html \"?gfx.warmUp=asked\" 2>&1 | tail -4 | cut -c1-300","description":"Build out the island props and time the boot","timeout":500000}}}
