{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjWzDhDCsrPvjQH237st","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01V1kZC9dHadmnqrXND8gNrf","name":"Bash","input":{"command":"cat >> labs/game/scenes/events/kit.ts <<'EOF'\n\n/** Stands each seat's person on a place round the station, facing `yaw`, with their pose reset. */\nexport function standSeats(c: Ctx, offsets: readonly (readonly [number, number])[], yaw: number, liftY = 0.05): void {\n  for (const e of c.seats) {\n    const [ox, oz] = offsets[e.seat.index] ?? [0, 0];\n    const [x, z] = [c.station.x + ox, c.station.z + oz];\n    const entity = c.w.get(e.seat.actor);\n    if (!entity?.cast) continue;\n    Object.assign(entity.cast, { hold: true, x, y: c.ground(x, z) + liftY, z, yaw, pose: '', poseT: 0, leanX: 0, leanY: 0 }); // prettier-ignore\n  }\n}\n\n/** Copies each seat's CoB onto its person's leans. */\nexport function leanSeats(c: Ctx, scale = 1): void {\n  for (const e of c.seats) {\n    const entity = c.w.get(e.seat.actor);\n    if (!entity?.cast) continue;\n    entity.cast.leanX = e.wobble.x * scale;\n    entity.cast.leanY = e.wobble.y * scale;\n  }\n}\n\n/** Sets every seat's person to a pose strip at a progress. */\nexport function poseSeats(c: Ctx, name: string, t: number): void {\n  for (const e of c.seats) {\n    const entity = c.w.get(e.seat.actor);\n    if (!entity?.cast) continue;\n    entity.cast.pose = name;\n    entity.cast.poseT = t;\n  }\n}\n\n/** The person standing in a seat. */\nexport function castInSeat(c: Ctx, index: number): Cast | undefined {\n  const e = c.seats.find((s) => s.seat.index === index);\n  return e ? c.w.get(e.seat.actor)?.cast : undefined;\n}\n\n/** Sends a critter somewhere. */\nexport function critterGo(c: { w: GameWorld }, kind: string, x: number, y: number, z: number, look = 0): void {\n  const e = c.w.query('critter').find((k) => k.critter.kind === kind);\n  if (e) Object.assign(e.critter, { goalX: x, goalY: y, goalZ: z, look, away: false });\n}\n\n/** Sends a critter away. */\nexport function critterAway(c: { w: GameWorld }, kind: string): void {\n  const e = c.w.query('critter').find((k) => k.critter.kind === kind);\n  if (e) e.critter.away = true;\n}\n\n/** Lets every named person walk again, and sends the critters off. */\nexport function releaseAll(c: { w: GameWorld }): void {\n  for (const e of c.w.query('cast')) Object.assign(e.cast, { hold: false, pose: '', poseT: 0, leanX: 0, leanY: 0 });\n  critterAway(c, 'gull');\n  critterAway(c, 'frog');\n}\nEOF\ncat > labs/game/scenes/data/poses.ts <<'EOF'\n/**\n * @file The pose table (PLAN.md section 6): adding a row adds a pose. Seats are places on the balance disc.\n *\n * Game code, sim-side data.\n *\n * @example\n * POSES.heron.needs; // 'L'\n */\n\n/** A pose. */\nexport interface PoseDef {\n  id: string;\n  name: string;\n  /** The clip strip it scrubs. */\n  clip: string;\n  /** The seat on the disc, and a second seat for two-part holds. */\n  seat: readonly [number, number];\n  seat2?: readonly [number, number];\n  clip2?: string;\n  /** Sway and instability multipliers. */\n  sway?: number;\n  inst?: number;\n  /** How much the breath weighs in its score (0.3 by default; 0 when feet are busy). */\n  breath?: number;\n  /** Feet that must stay held. */\n  needs?: 'both' | 'L' | 'R';\n  /** Its own ring, when not the default. */\n  ring?: number;\n  /** Sway climbs through the hold. */\n  climbs?: boolean;\n  /** The Gull lands halfway. */\n  gull?: boolean;\n  /** Hips follow your lungs: the strip from t = 0.5 on. */\n  lungs?: boolean;\n}\n\n/** The poses. */\nexport const POSES: Readonly<Record<string, PoseDef>> = Object.freeze({\n  nothing: { id: 'nothing', name: 'Seated Nothing', clip: 'Nothing', seat: [0, 0], sway: 0.5, breath: 0.6 },\n  chair: { id: 'chair', name: 'The Patient Chair', clip: 'Chair', seat: [0, -0.35], needs: 'both', breath: 0, climbs: true },\n  heron: { id: 'heron', name: 'The Heron', clip: 'Heron', seat: [0, 0], needs: 'L', inst: 1.5 },\n  archer: { id: 'archer', name: 'The Archer', clip: 'Archer', seat: [0.35, 0.35], inst: 1.2 },\n  comma: { id: 'comma', name: 'The Sideways Comma', clip: 'CommaR', clip2: 'CommaL', seat: [0.5, 0], seat2: [-0.5, 0] },\n  napkin: { id: 'napkin', name: 'The Folded Napkin', clip: 'Napkin', seat: [0, 0.5], gull: true },\n  bridge: { id: 'bridge', name: 'The Polite Bridge', clip: 'Bridge', seat: [0, 0], breath: 0.7, lungs: true },\n  lighthouse: { id: 'lighthouse', name: 'The Lighthouse', clip: 'Lighthouse', seat: [0, 0], ring: 0.14, sway: 1.2 },\n}); // prettier-ignore\n\n/** The classes: each activity id and its poses. */\nexport const CLASSES: Readonly<Record<string, readonly string[]>> = Object.freeze({\n  poseA: ['nothing', 'chair', 'heron'],\n  poseB: ['archer', 'comma', 'napkin'],\n  poseC: ['bridge', 'lighthouse'],\n  heron: ['heron'],\n});\nEOF\ncat > labs/game/scenes/events/pose.ts <<'EOF'\n/**\n * @file Pose Class (PLAN.md section 6): Plumb demonstrates, a guide dot leads you into the pose and your progress\n * scrubs the strip, you hold with the breath while your off-seat lean tips the body over, and rest. Every seat plays;\n * in a class the others are CPU guests. `makePoseClass` builds one activity per class in the table.\n *\n * Game code, sim-side.\n *\n * @example\n * // ACTIVITIES.poseA = makePoseClass('poseA', 'Pose Class');\n */\nimport { breathe, holdAt, type Player } from '../bot/players';\nimport { CLASSES, POSES, type PoseDef } from '../data/poses';\nimport { MAT_OFFSETS } from '../data/stations';\nimport { bothFeet, inRing } from '../wobble';\nimport { after, critterAway, critterGo, enter, leanSeats, say, standSeats, steps, castOf, pose as poseCast } from './kit';\nimport type { Activity, Ctx, SeatEntity } from './types';\n\n/** Seconds of each phase. */\nconst DEMO = 4;\nconst ENTER_TIMEOUT = 10;\nconst ENTER_SPEED = 1 / 3.2;\nconst REST = 2.2;\nconst NEAR = 0.18;\n\n/** One seat's running numbers for a pose. */\ninterface Tally {\n  inside: number;\n  total: number;\n  sync: number;\n  topples: number;\n  progress: number;\n}\n\n/** The class's state. */\ninterface PoseData {\n  list: string[];\n  index: number;\n  tally: Tally[];\n  scores: number[][];\n  part: number;\n  hold: number;\n}\n\nconst fresh = (): Tally => ({ inside: 0, total: 0, sync: 0, topples: 0, progress: 0 });\n\n/** The guide dot along its curve at `u`, from the centre to the seat. */\nexport function guideDot(def: PoseDef, u: number): [number, number] {\n  const [sx, sy] = def.seat;\n  const bow = Math.sin(Math.PI * u);\n  const size = Math.hypot(sx, sy);\n  if (size < 0.01) return [0.28 * bow * Math.sin(2 * Math.PI * u + 0.6), 0.28 * bow * Math.cos(2 * Math.PI * u)];\n  return [sx * u - sy * 0.35 * bow, sy * u + sx * 0.35 * bow];\n}\n\n/** The pose's score for one tally. */\nfunction poseScore(def: PoseDef, t: Tally): number {\n  if (t.total === 0) return 0;\n  const weight = def.breath ?? 0.3;\n  const inside = t.inside / t.total;\n  const sync = t.sync / t.total;\n  return 1000 * ((1 - weight) * inside + weight * sync) - 60 * t.topples;\n}\n\n/** Whether the pose's feet rule holds for a seat. */\nfunction feetOk(def: PoseDef, e: SeatEntity): boolean {\n  if (def.needs === 'both') return bothFeet(e.seat);\n  if (def.needs === 'L') return e.seat.fl >= 0.5;\n  if (def.needs === 'R') return e.seat.fr >= 0.5;\n  return true;\n}\n\n/** Sets the bodies up for the pose at `index`. */\nfunction beginPose(c: Ctx, d: PoseData): void {\n  const def = POSES[d.list[d.index]];\n  d.tally = [fresh(), fresh(), fresh(), fresh()];\n  d.part = 0;\n  for (const e of c.seats) {\n    e.wobble.instMul = def.inst ?? 1;\n    e.wobble.swayMul = def.sway ?? 1;\n    e.wobble.usesBreath = def.needs !== 'both';\n    e.wobble.topples = 0;\n  }\n  c.hud.show = { pose: def.id, name: def.name, needs: def.needs ?? '' };\n  c.hud.title = def.name;\n  enter(c, 'demo');\n  poseCast(c.w, 'plumb', def.clip, 0);\n  say(c, 'plumb', `pose.demo.${def.id}`);\n}\n\n/** The ring radius for a pose. */\nfunction ringOf(c: Ctx, def: PoseDef): number {\n  const expert = c.w.settings.get<boolean>('game.expert') ? 0.75 : 1;\n  return (def.ring ?? c.w.settings.get<number>('game.pose.ring')) * expert;\n}\n\n/** Hold seconds for this class's form. */\nfunction holdSeconds(c: Ctx, def: PoseDef): number {\n  if (c.a.short) return 34;\n  if (def.seat2) return 16;\n  return c.w.settings.get<number>('game.pose.hold');\n}\n\n/** One step of the entering phase. */\nfunction stepEnter(c: Ctx, d: PoseData, def: PoseDef): void {\n  let allIn = true;\n  for (const e of c.seats) {\n    const t = d.tally[e.seat.index];\n    const [gx, gy] = guideDot(def, t.progress);\n    if (Math.hypot(e.wobble.x - gx, e.wobble.y - gy) <= NEAR) t.progress = Math.min(1, t.progress + ENTER_SPEED * c.w.dt);\n    if (t.progress < 1) allIn = false;\n    const cast = c.w.get(e.seat.actor)?.cast;\n    if (cast) Object.assign(cast, { pose: def.clip, poseT: def.lungs ? t.progress * 0.5 : t.progress });\n  }\n  const first = d.tally[c.seats[0].seat.index];\n  c.hud.ring = [...guideDot(def, first.progress), NEAR] as [number, number, number];\n  c.hud.meter = first.progress;\n  c.hud.meterLabel = 'Into the pose';\n  const timedOut = after(c, ENTER_TIMEOUT);\n  if (allIn || timedOut) {\n    if (timedOut && !allIn) say(c, 'plumb', 'pose.start');\n    else say(c, 'plumb', 'pose.hold');\n    for (const e of c.seats) d.tally[e.seat.index].progress = 1;\n    d.hold = steps(c, holdSeconds(c, def));\n    enter(c, 'hold');\n  }\n}\n\n/** One step of the holding phase. */\nfunction stepHold(c: Ctx, d: PoseData, def: PoseDef): void {\n  const seatOf = (): readonly [number, number] => (d.part === 1 && def.seat2 ? def.seat2 : def.seat);\n  const half = def.seat2 ? Math.round(d.hold / 2) : -1;\n  if (d.part === 0 && c.a.pt === half) {\n    d.part = 1;\n    say(c, 'plumb', 'pose.other');\n  }\n  const [sx, sy] = seatOf();\n  const ring = ringOf(c, def);\n  const clip = d.part === 1 && def.clip2 ? def.clip2 : def.clip;\n  const u = c.a.pt / d.hold;\n  for (const e of c.seats) {\n    const t = d.tally[e.seat.index];\n    t.total += 1;\n    if (def.climbs) e.wobble.swayMul = 1 + 0.9 * u;\n    if (inRing(e.wobble, sx, sy, ring) && feetOk(def, e)) t.inside += 1;\n    if (e.wobble.usesBreath) t.sync += e.wobble.sync;\n    t.topples = e.wobble.topples;\n    const cast = c.w.get(e.seat.actor)?.cast;\n    if (cast) {\n      cast.pose = clip;\n      cast.poseT = def.lungs ? 0.5 + 0.5 * e.wobble.lungs : 1;\n      cast.leanX = (e.wobble.x - sx) * 1.6;\n      cast.leanY = (e.wobble.y - sy) * 1.6;\n    }\n  }\n  if (def.gull && c.a.pt === Math.round(d.hold / 2)) {\n    const guest = c.w.get(c.seats[0].seat.actor)?.cast;\n    if (guest) critterGo(c, 'gull', guest.x, guest.y + 1, guest.z - 0.1);\n    for (const e of c.seats) e.wobble.vy -= 0.25;\n    say(c, 'tare', 'pose.gull');\n  }\n  c.hud.ring = [sx, sy, ring];\n  c.hud.guide = !def.needs || def.needs !== 'both';\n  c.hud.meter = 1 - u;\n  c.hud.meterLabel = 'Hold';\n  poseCast(c.w, 'plumb', clip, def.lungs ? 0.5 + 0.5 * c.seats[0].wobble.guide : 1);\n  if (c.a.pt >= d.hold) {\n    for (const e of c.seats) d.scores[e.seat.index].push(poseScore(def, d.tally[e.seat.index]));\n    say(c, 'plumb', 'pose.rest');\n    critterAway(c, 'gull');\n    enter(c, 'rest');\n  }\n}\n\n/** Builds one class's activity. */\nexport function makePoseClass(id: string, title: string): Activity {\n  return {\n    id,\n    title,\n    station: 'pavilion',\n    map: 'actionMap:balance',\n    shot: 'mat',\n    wobble: true,\n    seats: 4,\n    setup(c) {\n      const list = [...(CLASSES[id] ?? CLASSES.poseA)];\n      const d: PoseData = { list, index: 0, tally: [], scores: [[], [], [], []], part: 0, hold: 1 };\n      c.a.data = d as unknown as Record<string, unknown>;\n      c.hud.disc = true;\n      c.hud.feet = true;\n      standSeats(c, MAT_OFFSETS, Math.PI);\n      const plumb = castOf(c.w, 'plumb');\n      if (plumb) Object.assign(plumb.cast, { hold: true, x: c.station.x, y: c.ground(c.station.x, c.station.z - 2) + 0.15, z: c.station.z - 2, yaw: 0 }); // prettier-ignore\n      beginPose(c, d);\n    },\n    step(c) {\n      const d = c.a.data as unknown as PoseData;\n      const def = POSES[d.list[d.index]];\n      if (c.a.phase === 'demo') {\n        poseCast(c.w, 'plumb', def.clip, Math.min(1, c.a.pt / steps(c, DEMO - 1)) * (def.lungs ? 0.5 : 1));\n        c.hud.big = '';\n        c.hud.prompt = 'skip';\n        c.hud.ring = [0, 0, 0.2];\n        for (const e of c.seats) {\n          const cast = c.w.get(e.seat.actor)?.cast;\n          if (cast) Object.assign(cast, { pose: def.clip, poseT: 0, leanX: e.wobble.x, leanY: e.wobble.y });\n        }\n        if (after(c, DEMO) || c.seats[0].seat.actP) {\n          c.hud.prompt = '';\n          say(c, 'plumb', 'pose.now');\n          enter(c, 'enter');\n        }\n      } else if (c.a.phase === 'enter') stepEnter(c, d, def);\n      else if (c.a.phase === 'hold') stepHold(c, d, def);\n      else if (after(c, REST)) {\n        for (const e of c.seats) {\n          const cast = c.w.get(e.seat.actor)?.cast;\n          if (cast) Object.assign(cast, { pose: '', poseT: 0, leanX: 0, leanY: 0 });\n        }\n        d.index += 1;\n        if (d.index >= d.list.length) c.a.done = true;\n        else beginPose(c, d);\n      } else {\n        for (const e of c.seats) {\n          const cast = c.w.get(e.seat.actor)?.cast;\n          if (cast) cast.poseT = Math.max(0, cast.poseT - c.w.dt / REST);\n        }\n        leanSeats(c, 0.3);\n      }\n    },\n    teardown(c) {\n      critterAway(c, 'gull');\n    },\n    bot(c, e, player: Player) {\n      const d = c.a.data as unknown as PoseData;\n      const def = POSES[d.list[d.index]];\n      const { seat, wobble } = e;\n      if (c.a.phase === 'demo') {\n        holdAt(c.w, seat, wobble, 0, 0, player);\n        seat.act = player.acts && c.a.pt > 30 && seat.index === 0;\n        seat.fl = seat.fr = 0;\n      } else if (c.a.phase === 'enter') {\n        const t = d.tally[seat.index];\n        const [gx, gy] = guideDot(def, Math.min(1, t.progress + 0.03));\n        holdAt(c.w, seat, wobble, gx, gy, player);\n        seat.fl = seat.fr = 0;\n        seat.act = false;\n      } else {\n        const [sx, sy] = d.part === 1 && def.seat2 ? def.seat2 : def.seat;\n        holdAt(c.w, seat, wobble, sx, sy, player);\n        breathe(c.w, seat, wobble, player);\n        if (player.acts && def.needs === 'both') seat.fl = seat.fr = 1;\n        if (player.acts && def.needs === 'L') seat.fl = 1;\n        if (player.acts && def.needs === 'R') seat.fr = 1;\n        seat.act = false;\n      }\n    },\n    score(c, index) {\n      const d = c.a.data as unknown as PoseData;\n      const list = d.scores[index] ?? [];\n      return list.length ? list.reduce((a, b) => a + b, 0) / list.length : 0;\n    },\n  };\n}\nEOF\ncat > labs/game/scenes/events/morning.ts <<'EOF'\n/**\n * @file The Morning Check (PLAN.md section 6): Tare asks one yes/no question, then three tests: Still Ring, Reach, One\n * Foot. Its share gives the Wobble Age. Day 1 teaches each verb a line at a time, through the same steps.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'morning');\n */\nimport { breathe, holdAt, type Player } from '../bot/players';\nimport { STATIONS } from '../data/stations';\nimport { wobbleAge } from '../scoring';\nimport { inRing } from '../wobble';\nimport { after, castOf, enter, leanSeats, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** Test lengths, s. */\nconst QUESTION = 9;\nconst RING = 12;\nconst NARROW_FROM = 8;\nconst REACH = 24;\nconst FOOT = 8;\n/** Reach's targets: six at this radius, hold each this long. */\nconst TARGET_R = 0.16;\nconst TARGET_AT = 0.5;\nconst TARGET_HOLD = 0.5;\n\n/** The check's state. */\ninterface MorningData {\n  inside: number;\n  footInside: number;\n  order: number[];\n  target: number;\n  held: number;\n  foot: 'L' | 'R';\n  a: number;\n  b: number;\n  c: number;\n  s: number;\n  age?: number;\n  reachT: number;\n}\n\n/** Where a Reach target stands. */\nconst targetAt = (slot: number): [number, number] => [TARGET_AT * Math.sin((slot * Math.PI) / 3), TARGET_AT * Math.cos((slot * Math.PI) / 3)];\n\n/** The Morning Check. */\nexport const morning: Activity = {\n  id: 'morning',\n  title: 'Morning Check',\n  station: 'plaza',\n  map: 'actionMap:balance',\n  shot: 'platform',\n  wobble: true,\n  setup(c) {\n    const rng = c.w.rng('morning');\n    const order = [0, 1, 2, 3, 4, 5];\n    for (let k = order.length - 1; k > 0; k--) {\n      const j = rng.int(0, k);\n      [order[k], order[j]] = [order[j], order[k]];\n    }\n    const d: MorningData = { inside: 0, footInside: 0, order, target: 0, held: 0, foot: rng.chance(0.5) ? 'L' : 'R', a: 0, b: 0, c: 0, s: 0, reachT: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    c.hud.disc = true;\n    c.hud.feet = true;\n    const guest = castOf(c.w, 'guest');\n    const [x, z] = [c.station.x, c.station.z + 1];\n    if (guest) Object.assign(guest.cast, { hold: true, x, y: c.ground(x, z) + 0.22, z, yaw: Math.PI, pose: '', poseT: 0 });\n    const tare = castOf(c.w, 'tare');\n    if (tare) Object.assign(tare.cast, { hold: true, x: x + 1.5, y: c.ground(x + 1.5, z - 1.4), z: z - 1.4, yaw: -0.5 });\n    c.hud.title = 'Morning Check';\n    enter(c, 'question');\n    say(c, 'tare', `morning.question.${Math.min(6, c.flow.day)}`);\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as MorningData;\n    const [{ seat, wobble: wob }] = c.seats;\n    leanSeats(c);\n    if (c.a.phase === 'question') {\n      for (const e of c.seats) [e.wobble.x, e.wobble.y, e.wobble.vx, e.wobble.vy] = [0, 0, 0, 0];\n      c.hud.ring = [0, 0, 0.22];\n      c.hud.show = { question: true };\n      const answered = seat.pfl ? 1 : seat.pfr ? 2 : 0;\n      if (answered || after(c, QUESTION)) {\n        c.flow.question = answered;\n        c.hud.show = {};\n        say(c, 'tare', answered === 1 ? 'morning.yes' : answered === 2 ? 'morning.no' : 'morning.silent');\n        say(c, 'tare', c.flow.day === 1 ? 'morning.teach.ring' : 'morning.ring');\n        enter(c, 'ring');\n      }\n      return;\n    }\n    if (c.a.phase === 'ring') {\n      const r = c.a.pt >= steps(c, NARROW_FROM) ? 0.16 : 0.22;\n      c.hud.ring = [0, 0, r];\n      c.hud.meter = 1 - c.a.pt / steps(c, RING);\n      c.hud.meterLabel = 'Still Ring';\n      if (inRing(wob, 0, 0, r)) d.inside += 1;\n      if (c.a.pt >= steps(c, RING)) {\n        d.a = d.inside / steps(c, RING);\n        say(c, 'tare', c.flow.day === 1 ? 'morning.teach.reach' : 'morning.reach');\n        enter(c, 'reach');\n      }\n      return;\n    }\n    if (c.a.phase === 'reach') {\n      d.reachT += 1;\n      const slot = d.order[d.target];\n      const [tx, ty] = targetAt(slot);\n      c.hud.ring = [tx, ty, TARGET_R];\n      c.hud.meter = 1 - c.a.pt / steps(c, REACH);\n      c.hud.meterLabel = `Reach ${d.target + 1} of 6`;\n      if (inRing(wob, tx, ty, TARGET_R)) {\n        d.held += 1;\n        if (d.held >= steps(c, TARGET_HOLD)) {\n          d.held = 0;\n          d.target += 1;\n          c.w.emit('reachHit', { n: d.target });\n        }\n      } else d.held = 0;\n      if (d.target >= 6 || c.a.pt >= steps(c, REACH)) {\n        d.b = d.target >= 6 ? Math.max(0, 1 - d.reachT / steps(c, REACH)) : 0;\n        wob.instMul = 1.6;\n        say(c, 'tare', d.foot === 'L' ? 'morning.foot.left' : 'morning.foot.right');\n        enter(c, 'foot');\n      }\n      return;\n    }\n    if (c.a.phase === 'foot') {\n      c.hud.ring = [0, 0, 0.3];\n      c.hud.meter = 1 - d.footInside / steps(c, FOOT);\n      c.hud.meterLabel = d.foot === 'L' ? 'Left foot' : 'Right foot';\n      c.hud.show = { foot: d.foot };\n      const heldFoot = d.foot === 'L' ? seat.fl >= 0.5 : seat.fr >= 0.5;\n      if (heldFoot && inRing(wob, 0, 0, 0.3)) d.footInside += 1;\n      else if (!heldFoot) d.footInside = Math.max(0, d.footInside - 1);\n      const tree = castOf(c.w, 'guest');\n      if (tree) Object.assign(tree.cast, { pose: heldFoot ? 'Heron' : '', poseT: heldFoot ? 0.5 : 0 });\n      if (c.a.pt >= steps(c, FOOT)) {\n        d.c = d.footInside / steps(c, FOOT);\n        d.s = 0.45 * d.a + 0.3 * d.b + 0.25 * d.c;\n        d.age = wobbleAge(d.s, c.w.settings.get<number>('game.age.k'));\n        (c.a.data as Record<string, unknown>).age = d.age;\n        wob.instMul = 1;\n        const guest = castOf(c.w, 'guest');\n        if (guest) Object.assign(guest.cast, { pose: '', poseT: 0 });\n        c.a.done = true;\n      }\n    }\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as MorningData;\n    const { seat, wobble } = e;\n    seat.fl = seat.fr = 0;\n    seat.act = false;\n    if (c.a.phase === 'question') {\n      seat.lx = seat.ly = 0;\n      if (player.acts && c.a.pt === 60) seat.fl = 1;\n    } else if (c.a.phase === 'reach') {\n      const [tx, ty] = targetAt(d.order[Math.min(5, d.target)]);\n      holdAt(c.w, seat, wobble, tx, ty, player);\n    } else if (c.a.phase === 'foot') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      if (player.acts) {\n        seat.fl = d.foot === 'L' ? 1 : 0;\n        seat.fr = d.foot === 'R' ? 1 : 0;\n      }\n    } else {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      breathe(c.w, seat, wobble, { ...player, acts: false });\n    }\n  },\n  score(c) {\n    const d = c.a.data as unknown as MorningData;\n    return d.s * 1000;\n  },\n};\n\n/** The Plaza's Tare platform, for the props. */\nexport const PLATFORM_AT = [STATIONS.plaza.x, STATIONS.plaza.z + 1] as const;\nEOF\ncat > labs/game/scenes/data/lures.ts <<'EOF'\n/**\n * @file Still Pond's lures (PLAN.md section 6), in order of escalation: the page shows each by id, and the sim knows\n * only its id and how long it stays. A new lure is a new row (and a page handler, and a line).\n *\n * Game code, sim-side data.\n *\n * @example\n * LURES[0].id; // 'press'\n */\n\n/** A lure. */\nexport interface Lure {\n  id: string;\n  /** How long it stays, s. */\n  stays: number;\n  /** Who speaks, if anyone. */\n  who?: string;\n  /** Whether the Frog or the Gull comes. */\n  critter?: 'frog' | 'gull';\n}\n\n/** The lures, escalating. */\nexport const LURES: readonly Lure[] = [\n  { id: 'press', stays: 3.5 },\n  { id: 'psst', stays: 4, who: 'tare' },\n  { id: 'stone', stays: 3.5, who: 'bex' },\n  { id: 'frog', stays: 6, critter: 'frog' },\n  { id: 'pause', stays: 4 },\n  { id: 'gull', stays: 6, critter: 'gull' },\n  { id: 'disconnected', stays: 4 },\n  { id: 'wrong', stays: 3.5, who: 'plumb' },\n  { id: 'credits', stays: 5 },\n];\nEOF\ncat > labs/game/scenes/events/pond.ts <<'EOF'\n/**\n * @file Still Pond (PLAN.md section 6): the funniest thing in the game, and almost no input. Composure starts at 1000.\n * The only correct input is breathing with the guide; anything else is \"You moved\". Every 6 to 10 s a lure from the\n * seeded table asks you to press something. Doing nothing at all earns exactly 500.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'pond');\n */\nimport { breathe, type Player } from '../bot/players';\nimport { LURES } from '../data/lures';\nimport { MAT_OFFSETS } from '../data/stations';\nimport { after, castOf, critterAway, critterGo, enter, say, standSeats, steps } from './kit';\nimport type { Activity, Ctx, SeatEntity } from './types';\n\n/** The stick travel, in lean units, that counts as moving. */\nconst STICK = 0.25;\n/** Mouse travel per step that counts. */\nconst MOUSE = 0.04;\n/** Steps a single foot may be down alone before it is a stray foot: the two triggers rarely go down together. */\nconst FOOT_GRACE = 12;\n/** A second's debounce. */\nconst DEBOUNCE = 60;\n/** Length of the sit, s. */\nconst LENGTH = 75;\nconst SHORT = 45;\nconst LEAD = 6;\n\n/** One seat's numbers. */\ninterface PondSeat {\n  composure: number;\n  moved: number;\n  cool: number;\n  alone: number;\n  syncSum: number;\n  total: number;\n}\n\n/** The sit's state. */\ninterface PondData {\n  seats: PondSeat[];\n  lure: number;\n  lureLeft: number;\n  next: number;\n  order: number[];\n  shown: number;\n  frog: number;\n}\n\n/** Whether this seat moved this step. */\nfunction moved(e: SeatEntity, s: PondSeat): boolean {\n  const { seat } = e;\n  const oneFoot = (seat.fl >= 0.5) !== (seat.fr >= 0.5);\n  s.alone = oneFoot ? s.alone + 1 : 0;\n  return Math.hypot(seat.lx, seat.ly) > STICK || seat.act || s.alone > FOOT_GRACE || seat.moved > MOUSE;\n}\n\n/** Still Pond. */\nexport const pond: Activity = {\n  id: 'pond',\n  title: 'Still Pond',\n  station: 'pond',\n  map: 'actionMap:balance',\n  shot: 'pond',\n  wobble: true,\n  setup(c) {\n    const rng = c.w.rng('pond');\n    const order: number[] = LURES.map((_lure, i) => i);\n    const d: PondData = {\n      seats: [0, 1, 2, 3].map(() => ({ composure: 1000, moved: 0, cool: 0, alone: 0, syncSum: 0, total: 0 })),\n      lure: -1,\n      lureLeft: 0,\n      next: steps(c, 6 + (c.a.short ? LEAD : 0)),\n      order,\n      shown: 0,\n      frog: 0,\n    };\n    c.a.data = d as unknown as Record<string, unknown>;\n    void rng;\n    c.hud.disc = true;\n    c.hud.guide = true;\n    c.hud.feet = true;\n    c.hud.title = 'Still Pond';\n    c.hud.show = { composure: 1000 };\n    if (c.round) standSeats(c, MAT_OFFSETS, Math.PI);\n    else {\n      const guest = castOf(c.w, 'guest');\n      if (guest) Object.assign(guest.cast, { hold: true, x: c.station.x, y: c.station.y + 0.45, z: c.station.z, yaw: Math.PI });\n    }\n    for (const e of c.seats) {\n      e.wobble.swayMul = 0.2;\n      const cast = c.w.get(e.seat.actor)?.cast;\n      if (cast) Object.assign(cast, { pose: 'Nothing', poseT: 1 });\n    }\n    enter(c, c.a.short ? 'lead' : 'sit');\n    say(c, 'plumb', 'pond.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as PondData;\n    if (c.a.phase === 'lead') {\n      c.hud.big = String(Math.max(1, LEAD - Math.floor(c.a.pt / c.w.hz)));\n      if (after(c, LEAD)) {\n        c.hud.big = '';\n        enter(c, 'sit');\n      }\n      return;\n    }\n    const length = steps(c, c.a.short ? SHORT : LENGTH);\n    c.hud.meter = 1 - c.a.pt / length;\n    for (const e of c.seats) {\n      const s = d.seats[e.seat.index];\n      s.total += 1;\n      s.syncSum += e.wobble.sync;\n      s.cool = Math.max(0, s.cool - 1);\n      if (moved(e, s) && s.cool === 0) {\n        s.cool = DEBOUNCE;\n        s.moved += 1;\n        s.composure = Math.max(0, s.composure - c.w.settings.get<number>('game.pond.penalty'));\n        c.w.emit('moved', { seat: e.seat.index, composure: s.composure });\n        const cast = c.w.get(e.seat.actor)?.cast;\n        if (cast && e.seat.index === c.seats[0].seat.index) c.w.emit('ripple', { x: cast.x, z: cast.z + 1.6 });\n      }\n      const cast = c.w.get(e.seat.actor)?.cast;\n      if (cast) {\n        cast.leanX = e.wobble.x * 0.5;\n        cast.leanY = e.wobble.y * 0.5 + e.wobble.lungs * 0.18;\n      }\n    }\n    c.hud.show = { composure: d.seats[c.seats[0].seat.index].composure, lure: d.lure >= 0 ? LURES[d.lure].id : '' };\n    // The lures.\n    if (d.lure >= 0) {\n      d.lureLeft -= 1;\n      if (d.lureLeft <= 0) {\n        critterAway(c, 'frog');\n        critterAway(c, 'gull');\n        d.lure = -1;\n        d.next = steps(c, c.w.rng('pond').range(6, 10));\n      }\n    } else if (--d.next <= 0 && d.shown < LURES.length) {\n      const lure = LURES[d.order[d.shown]];\n      d.lure = d.order[d.shown];\n      d.shown += 1;\n      d.lureLeft = steps(c, lure.stays);\n      c.w.emit('lure', { id: lure.id });\n      if (lure.who) say(c, lure.who, `pond.lure.${lure.id}`);\n      const guest = c.w.get(c.seats[0].seat.actor)?.cast;\n      if (guest && lure.critter === 'frog') critterGo(c, 'frog', guest.x + 0.25, guest.y + 0.45, guest.z + 0.2, Math.PI);\n      if (guest && lure.critter === 'gull') critterGo(c, 'gull', guest.x, guest.y + 1.12, guest.z, 0);\n    }\n    if (c.a.pt >= length) {\n      say(c, 'plumb', 'pond.end');\n      c.a.done = true;\n    }\n  },\n  teardown(c) {\n    critterAway(c, 'frog');\n    critterAway(c, 'gull');\n  },\n  bot(c, e, player: Player) {\n    const { seat, wobble } = e;\n    const d = c.a.data as unknown as PondData;\n    seat.lx = seat.ly = 0;\n    seat.act = false;\n    breathe(c.w, seat, wobble, player);\n    // A person sometimes falls for a lure: the human for the fake pause, the sloppy for three of them.\n    if (d.lure >= 0 && d.lureLeft === steps(c, LURES[d.lure].stays) - 30) {\n      const lure = LURES[d.lure].id;\n      if ((player.name === 'human' && lure === 'pause') || (player.name === 'sloppy' && ['press', 'pause', 'disconnected'].includes(lure))) seat.act = true; // prettier-ignore\n    }\n  },\n  score(c, index) {\n    const d = c.a.data as unknown as PondData;\n    const s = d.seats[index];\n    const sync = s.total > 0 ? s.syncSum / s.total : 0;\n    return s.composure * (0.5 + 0.5 * sync);\n  },\n};\nEOF\ncat > labs/game/scenes/events/index.ts <<'EOF'\n/**\n * @file The activity table: every module, by id. A new activity is a new module and a new row here.\n *\n * Game code, sim-side.\n *\n * @example\n * ACTIVITIES.pond.title; // 'Still Pond'\n */\nimport { morning } from './morning';\nimport { makePoseClass } from './pose';\nimport { pond } from './pond';\nimport { ring } from './ring';\nimport type { Activity } from './types';\n\n/** The activities, by id. */\nexport const ACTIVITIES: Record<string, Activity> = {\n  morning,\n  poseA: makePoseClass('poseA', 'Pose Class'),\n  poseB: makePoseClass('poseB', 'Pose Class'),\n  poseC: makePoseClass('poseC', 'Pose Class'),\n  heron: makePoseClass('heron', 'The Heron'),\n  pond,\n  ring,\n};\nEOF\n","description":"Write Pose Class, Morning Check and Still Pond"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9811,"cache_read_input_tokens":263650,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9811},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"33051ec0-b305-465e-b419-c7cc779b3290","timestamp":"2026-11-05T09:10:01.087Z","request_id":"req_011CgjWzDQbHdp8gZ2GzpQTM","wire_tool_inputs":{"toolu_01V1kZC9dHadmnqrXND8gNrf":{"command":"cat >> labs/game/scenes/events/kit.ts <<'EOF'\n\n/** Stands each seat's person on a place round the station, facing `yaw`, with their pose reset. */\nexport function standSeats(c: Ctx, offsets: readonly (readonly [number, number])[], yaw: number, liftY = 0.05): void {\n  for (const e of c.seats) {\n    const [ox, oz] = offsets[e.seat.index] ?? [0, 0];\n    const [x, z] = [c.station.x + ox, c.station.z + oz];\n    const entity = c.w.get(e.seat.actor);\n    if (!entity?.cast) continue;\n    Object.assign(entity.cast, { hold: true, x, y: c.ground(x, z) + liftY, z, yaw, pose: '', poseT: 0, leanX: 0, leanY: 0 }); // prettier-ignore\n  }\n}\n\n/** Copies each seat's CoB onto its person's leans. */\nexport function leanSeats(c: Ctx, scale = 1): void {\n  for (const e of c.seats) {\n    const entity = c.w.get(e.seat.actor);\n    if (!entity?.cast) continue;\n    entity.cast.leanX = e.wobble.x * scale;\n    entity.cast.leanY = e.wobble.y * scale;\n  }\n}\n\n/** Sets every seat's person to a pose strip at a progress. */\nexport function poseSeats(c: Ctx, name: string, t: number): void {\n  for (const e of c.seats) {\n    const entity = c.w.get(e.seat.actor);\n    if (!entity?.cast) continue;\n    entity.cast.pose = name;\n    entity.cast.poseT = t;\n  }\n}\n\n/** The person standing in a seat. */\nexport function castInSeat(c: Ctx, index: number): Cast | undefined {\n  const e = c.seats.find((s) => s.seat.index === index);\n  return e ? c.w.get(e.seat.actor)?.cast : undefined;\n}\n\n/** Sends a critter somewhere. */\nexport function critterGo(c: { w: GameWorld }, kind: string, x: number, y: number, z: number, look = 0): void {\n  const e = c.w.query('critter').find((k) => k.critter.kind === kind);\n  if (e) Object.assign(e.critter, { goalX: x, goalY: y, goalZ: z, look, away: false });\n}\n\n/** Sends a critter away. */\nexport function critterAway(c: { w: GameWorld }, kind: string): void {\n  const e = c.w.query('critter').find((k) => k.critter.kind === kind);\n  if (e) e.critter.away = true;\n}\n\n/** Lets every named person walk again, and sends the critters off. */\nexport function releaseAll(c: { w: GameWorld }): void {\n  for (const e of c.w.query('cast')) Object.assign(e.cast, { hold: false, pose: '', poseT: 0, leanX: 0, leanY: 0 });\n  critterAway(c, 'gull');\n  critterAway(c, 'frog');\n}\nEOF\ncat > labs/game/scenes/data/poses.ts <<'EOF'\n/**\n * @file The pose table (PLAN.md section 6): adding a row adds a pose. Seats are places on the balance disc.\n *\n * Game code, sim-side data.\n *\n * @example\n * POSES.heron.needs; // 'L'\n */\n\n/** A pose. */\nexport interface PoseDef {\n  id: string;\n  name: string;\n  /** The clip strip it scrubs. */\n  clip: string;\n  /** The seat on the disc, and a second seat for two-part holds. */\n  seat: readonly [number, number];\n  seat2?: readonly [number, number];\n  clip2?: string;\n  /** Sway and instability multipliers. */\n  sway?: number;\n  inst?: number;\n  /** How much the breath weighs in its score (0.3 by default; 0 when feet are busy). */\n  breath?: number;\n  /** Feet that must stay held. */\n  needs?: 'both' | 'L' | 'R';\n  /** Its own ring, when not the default. */\n  ring?: number;\n  /** Sway climbs through the hold. */\n  climbs?: boolean;\n  /** The Gull lands halfway. */\n  gull?: boolean;\n  /** Hips follow your lungs: the strip from t = 0.5 on. */\n  lungs?: boolean;\n}\n\n/** The poses. */\nexport const POSES: Readonly<Record<string, PoseDef>> = Object.freeze({\n  nothing: { id: 'nothing', name: 'Seated Nothing', clip: 'Nothing', seat: [0, 0], sway: 0.5, breath: 0.6 },\n  chair: { id: 'chair', name: 'The Patient Chair', clip: 'Chair', seat: [0, -0.35], needs: 'both', breath: 0, climbs: true },\n  heron: { id: 'heron', name: 'The Heron', clip: 'Heron', seat: [0, 0], needs: 'L', inst: 1.5 },\n  archer: { id: 'archer', name: 'The Archer', clip: 'Archer', seat: [0.35, 0.35], inst: 1.2 },\n  comma: { id: 'comma', name: 'The Sideways Comma', clip: 'CommaR', clip2: 'CommaL', seat: [0.5, 0], seat2: [-0.5, 0] },\n  napkin: { id: 'napkin', name: 'The Folded Napkin', clip: 'Napkin', seat: [0, 0.5], gull: true },\n  bridge: { id: 'bridge', name: 'The Polite Bridge', clip: 'Bridge', seat: [0, 0], breath: 0.7, lungs: true },\n  lighthouse: { id: 'lighthouse', name: 'The Lighthouse', clip: 'Lighthouse', seat: [0, 0], ring: 0.14, sway: 1.2 },\n}); // prettier-ignore\n\n/** The classes: each activity id and its poses. */\nexport const CLASSES: Readonly<Record<string, readonly string[]>> = Object.freeze({\n  poseA: ['nothing', 'chair', 'heron'],\n  poseB: ['archer', 'comma', 'napkin'],\n  poseC: ['bridge', 'lighthouse'],\n  heron: ['heron'],\n});\nEOF\ncat > labs/game/scenes/events/pose.ts <<'EOF'\n/**\n * @file Pose Class (PLAN.md section 6): Plumb demonstrates, a guide dot leads you into the pose and your progress\n * scrubs the strip, you hold with the breath while your off-seat lean tips the body over, and rest. Every seat plays;\n * in a class the others are CPU guests. `makePoseClass` builds one activity per class in the table.\n *\n * Game code, sim-side.\n *\n * @example\n * // ACTIVITIES.poseA = makePoseClass('poseA', 'Pose Class');\n */\nimport { breathe, holdAt, type Player } from '../bot/players';\nimport { CLASSES, POSES, type PoseDef } from '../data/poses';\nimport { MAT_OFFSETS } from '../data/stations';\nimport { bothFeet, inRing } from '../wobble';\nimport { after, critterAway, critterGo, enter, leanSeats, say, standSeats, steps, castOf, pose as poseCast } from './kit';\nimport type { Activity, Ctx, SeatEntity } from './types';\n\n/** Seconds of each phase. */\nconst DEMO = 4;\nconst ENTER_TIMEOUT = 10;\nconst ENTER_SPEED = 1 / 3.2;\nconst REST = 2.2;\nconst NEAR = 0.18;\n\n/** One seat's running numbers for a pose. */\ninterface Tally {\n  inside: number;\n  total: number;\n  sync: number;\n  topples: number;\n  progress: number;\n}\n\n/** The class's state. */\ninterface PoseData {\n  list: string[];\n  index: number;\n  tally: Tally[];\n  scores: number[][];\n  part: number;\n  hold: number;\n}\n\nconst fresh = (): Tally => ({ inside: 0, total: 0, sync: 0, topples: 0, progress: 0 });\n\n/** The guide dot along its curve at `u`, from the centre to the seat. */\nexport function guideDot(def: PoseDef, u: number): [number, number] {\n  const [sx, sy] = def.seat;\n  const bow = Math.sin(Math.PI * u);\n  const size = Math.hypot(sx, sy);\n  if (size < 0.01) return [0.28 * bow * Math.sin(2 * Math.PI * u + 0.6), 0.28 * bow * Math.cos(2 * Math.PI * u)];\n  return [sx * u - sy * 0.35 * bow, sy * u + sx * 0.35 * bow];\n}\n\n/** The pose's score for one tally. */\nfunction poseScore(def: PoseDef, t: Tally): number {\n  if (t.total === 0) return 0;\n  const weight = def.breath ?? 0.3;\n  const inside = t.inside / t.total;\n  const sync = t.sync / t.total;\n  return 1000 * ((1 - weight) * inside + weight * sync) - 60 * t.topples;\n}\n\n/** Whether the pose's feet rule holds for a seat. */\nfunction feetOk(def: PoseDef, e: SeatEntity): boolean {\n  if (def.needs === 'both') return bothFeet(e.seat);\n  if (def.needs === 'L') return e.seat.fl >= 0.5;\n  if (def.needs === 'R') return e.seat.fr >= 0.5;\n  return true;\n}\n\n/** Sets the bodies up for the pose at `index`. */\nfunction beginPose(c: Ctx, d: PoseData): void {\n  const def = POSES[d.list[d.index]];\n  d.tally = [fresh(), fresh(), fresh(), fresh()];\n  d.part = 0;\n  for (const e of c.seats) {\n    e.wobble.instMul = def.inst ?? 1;\n    e.wobble.swayMul = def.sway ?? 1;\n    e.wobble.usesBreath = def.needs !== 'both';\n    e.wobble.topples = 0;\n  }\n  c.hud.show = { pose: def.id, name: def.name, needs: def.needs ?? '' };\n  c.hud.title = def.name;\n  enter(c, 'demo');\n  poseCast(c.w, 'plumb', def.clip, 0);\n  say(c, 'plumb', `pose.demo.${def.id}`);\n}\n\n/** The ring radius for a pose. */\nfunction ringOf(c: Ctx, def: PoseDef): number {\n  const expert = c.w.settings.get<boolean>('game.expert') ? 0.75 : 1;\n  return (def.ring ?? c.w.settings.get<number>('game.pose.ring')) * expert;\n}\n\n/** Hold seconds for this class's form. */\nfunction holdSeconds(c: Ctx, def: PoseDef): number {\n  if (c.a.short) return 34;\n  if (def.seat2) return 16;\n  return c.w.settings.get<number>('game.pose.hold');\n}\n\n/** One step of the entering phase. */\nfunction stepEnter(c: Ctx, d: PoseData, def: PoseDef): void {\n  let allIn = true;\n  for (const e of c.seats) {\n    const t = d.tally[e.seat.index];\n    const [gx, gy] = guideDot(def, t.progress);\n    if (Math.hypot(e.wobble.x - gx, e.wobble.y - gy) <= NEAR) t.progress = Math.min(1, t.progress + ENTER_SPEED * c.w.dt);\n    if (t.progress < 1) allIn = false;\n    const cast = c.w.get(e.seat.actor)?.cast;\n    if (cast) Object.assign(cast, { pose: def.clip, poseT: def.lungs ? t.progress * 0.5 : t.progress });\n  }\n  const first = d.tally[c.seats[0].seat.index];\n  c.hud.ring = [...guideDot(def, first.progress), NEAR] as [number, number, number];\n  c.hud.meter = first.progress;\n  c.hud.meterLabel = 'Into the pose';\n  const timedOut = after(c, ENTER_TIMEOUT);\n  if (allIn || timedOut) {\n    if (timedOut && !allIn) say(c, 'plumb', 'pose.start');\n    else say(c, 'plumb', 'pose.hold');\n    for (const e of c.seats) d.tally[e.seat.index].progress = 1;\n    d.hold = steps(c, holdSeconds(c, def));\n    enter(c, 'hold');\n  }\n}\n\n/** One step of the holding phase. */\nfunction stepHold(c: Ctx, d: PoseData, def: PoseDef): void {\n  const seatOf = (): readonly [number, number] => (d.part === 1 && def.seat2 ? def.seat2 : def.seat);\n  const half = def.seat2 ? Math.round(d.hold / 2) : -1;\n  if (d.part === 0 && c.a.pt === half) {\n    d.part = 1;\n    say(c, 'plumb', 'pose.other');\n  }\n  const [sx, sy] = seatOf();\n  const ring = ringOf(c, def);\n  const clip = d.part === 1 && def.clip2 ? def.clip2 : def.clip;\n  const u = c.a.pt / d.hold;\n  for (const e of c.seats) {\n    const t = d.tally[e.seat.index];\n    t.total += 1;\n    if (def.climbs) e.wobble.swayMul = 1 + 0.9 * u;\n    if (inRing(e.wobble, sx, sy, ring) && feetOk(def, e)) t.inside += 1;\n    if (e.wobble.usesBreath) t.sync += e.wobble.sync;\n    t.topples = e.wobble.topples;\n    const cast = c.w.get(e.seat.actor)?.cast;\n    if (cast) {\n      cast.pose = clip;\n      cast.poseT = def.lungs ? 0.5 + 0.5 * e.wobble.lungs : 1;\n      cast.leanX = (e.wobble.x - sx) * 1.6;\n      cast.leanY = (e.wobble.y - sy) * 1.6;\n    }\n  }\n  if (def.gull && c.a.pt === Math.round(d.hold / 2)) {\n    const guest = c.w.get(c.seats[0].seat.actor)?.cast;\n    if (guest) critterGo(c, 'gull', guest.x, guest.y + 1, guest.z - 0.1);\n    for (const e of c.seats) e.wobble.vy -= 0.25;\n    say(c, 'tare', 'pose.gull');\n  }\n  c.hud.ring = [sx, sy, ring];\n  c.hud.guide = !def.needs || def.needs !== 'both';\n  c.hud.meter = 1 - u;\n  c.hud.meterLabel = 'Hold';\n  poseCast(c.w, 'plumb', clip, def.lungs ? 0.5 + 0.5 * c.seats[0].wobble.guide : 1);\n  if (c.a.pt >= d.hold) {\n    for (const e of c.seats) d.scores[e.seat.index].push(poseScore(def, d.tally[e.seat.index]));\n    say(c, 'plumb', 'pose.rest');\n    critterAway(c, 'gull');\n    enter(c, 'rest');\n  }\n}\n\n/** Builds one class's activity. */\nexport function makePoseClass(id: string, title: string): Activity {\n  return {\n    id,\n    title,\n    station: 'pavilion',\n    map: 'actionMap:balance',\n    shot: 'mat',\n    wobble: true,\n    seats: 4,\n    setup(c) {\n      const list = [...(CLASSES[id] ?? CLASSES.poseA)];\n      const d: PoseData = { list, index: 0, tally: [], scores: [[], [], [], []], part: 0, hold: 1 };\n      c.a.data = d as unknown as Record<string, unknown>;\n      c.hud.disc = true;\n      c.hud.feet = true;\n      standSeats(c, MAT_OFFSETS, Math.PI);\n      const plumb = castOf(c.w, 'plumb');\n      if (plumb) Object.assign(plumb.cast, { hold: true, x: c.station.x, y: c.ground(c.station.x, c.station.z - 2) + 0.15, z: c.station.z - 2, yaw: 0 }); // prettier-ignore\n      beginPose(c, d);\n    },\n    step(c) {\n      const d = c.a.data as unknown as PoseData;\n      const def = POSES[d.list[d.index]];\n      if (c.a.phase === 'demo') {\n        poseCast(c.w, 'plumb', def.clip, Math.min(1, c.a.pt / steps(c, DEMO - 1)) * (def.lungs ? 0.5 : 1));\n        c.hud.big = '';\n        c.hud.prompt = 'skip';\n        c.hud.ring = [0, 0, 0.2];\n        for (const e of c.seats) {\n          const cast = c.w.get(e.seat.actor)?.cast;\n          if (cast) Object.assign(cast, { pose: def.clip, poseT: 0, leanX: e.wobble.x, leanY: e.wobble.y });\n        }\n        if (after(c, DEMO) || c.seats[0].seat.actP) {\n          c.hud.prompt = '';\n          say(c, 'plumb', 'pose.now');\n          enter(c, 'enter');\n        }\n      } else if (c.a.phase === 'enter') stepEnter(c, d, def);\n      else if (c.a.phase === 'hold') stepHold(c, d, def);\n      else if (after(c, REST)) {\n        for (const e of c.seats) {\n          const cast = c.w.get(e.seat.actor)?.cast;\n          if (cast) Object.assign(cast, { pose: '', poseT: 0, leanX: 0, leanY: 0 });\n        }\n        d.index += 1;\n        if (d.index >= d.list.length) c.a.done = true;\n        else beginPose(c, d);\n      } else {\n        for (const e of c.seats) {\n          const cast = c.w.get(e.seat.actor)?.cast;\n          if (cast) cast.poseT = Math.max(0, cast.poseT - c.w.dt / REST);\n        }\n        leanSeats(c, 0.3);\n      }\n    },\n    teardown(c) {\n      critterAway(c, 'gull');\n    },\n    bot(c, e, player: Player) {\n      const d = c.a.data as unknown as PoseData;\n      const def = POSES[d.list[d.index]];\n      const { seat, wobble } = e;\n      if (c.a.phase === 'demo') {\n        holdAt(c.w, seat, wobble, 0, 0, player);\n        seat.act = player.acts && c.a.pt > 30 && seat.index === 0;\n        seat.fl = seat.fr = 0;\n      } else if (c.a.phase === 'enter') {\n        const t = d.tally[seat.index];\n        const [gx, gy] = guideDot(def, Math.min(1, t.progress + 0.03));\n        holdAt(c.w, seat, wobble, gx, gy, player);\n        seat.fl = seat.fr = 0;\n        seat.act = false;\n      } else {\n        const [sx, sy] = d.part === 1 && def.seat2 ? def.seat2 : def.seat;\n        holdAt(c.w, seat, wobble, sx, sy, player);\n        breathe(c.w, seat, wobble, player);\n        if (player.acts && def.needs === 'both') seat.fl = seat.fr = 1;\n        if (player.acts && def.needs === 'L') seat.fl = 1;\n        if (player.acts && def.needs === 'R') seat.fr = 1;\n        seat.act = false;\n      }\n    },\n    score(c, index) {\n      const d = c.a.data as unknown as PoseData;\n      const list = d.scores[index] ?? [];\n      return list.length ? list.reduce((a, b) => a + b, 0) / list.length : 0;\n    },\n  };\n}\nEOF\ncat > labs/game/scenes/events/morning.ts <<'EOF'\n/**\n * @file The Morning Check (PLAN.md section 6): Tare asks one yes/no question, then three tests: Still Ring, Reach, One\n * Foot. Its share gives the Wobble Age. Day 1 teaches each verb a line at a time, through the same steps.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'morning');\n */\nimport { breathe, holdAt, type Player } from '../bot/players';\nimport { STATIONS } from '../data/stations';\nimport { wobbleAge } from '../scoring';\nimport { inRing } from '../wobble';\nimport { after, castOf, enter, leanSeats, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** Test lengths, s. */\nconst QUESTION = 9;\nconst RING = 12;\nconst NARROW_FROM = 8;\nconst REACH = 24;\nconst FOOT = 8;\n/** Reach's targets: six at this radius, hold each this long. */\nconst TARGET_R = 0.16;\nconst TARGET_AT = 0.5;\nconst TARGET_HOLD = 0.5;\n\n/** The check's state. */\ninterface MorningData {\n  inside: number;\n  footInside: number;\n  order: number[];\n  target: number;\n  held: number;\n  foot: 'L' | 'R';\n  a: number;\n  b: number;\n  c: number;\n  s: number;\n  age?: number;\n  reachT: number;\n}\n\n/** Where a Reach target stands. */\nconst targetAt = (slot: number): [number, number] => [TARGET_AT * Math.sin((slot * Math.PI) / 3), TARGET_AT * Math.cos((slot * Math.PI) / 3)];\n\n/** The Morning Check. */\nexport const morning: Activity = {\n  id: 'morning',\n  title: 'Morning Check',\n  station: 'plaza',\n  map: 'actionMap:balance',\n  shot: 'platform',\n  wobble: true,\n  setup(c) {\n    const rng = c.w.rng('morning');\n    const order = [0, 1, 2, 3, 4, 5];\n    for (let k = order.length - 1; k > 0; k--) {\n      const j = rng.int(0, k);\n      [order[k], order[j]] = [order[j], order[k]];\n    }\n    const d: MorningData = { inside: 0, footInside: 0, order, target: 0, held: 0, foot: rng.chance(0.5) ? 'L' : 'R', a: 0, b: 0, c: 0, s: 0, reachT: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    c.hud.disc = true;\n    c.hud.feet = true;\n    const guest = castOf(c.w, 'guest');\n    const [x, z] = [c.station.x, c.station.z + 1];\n    if (guest) Object.assign(guest.cast, { hold: true, x, y: c.ground(x, z) + 0.22, z, yaw: Math.PI, pose: '', poseT: 0 });\n    const tare = castOf(c.w, 'tare');\n    if (tare) Object.assign(tare.cast, { hold: true, x: x + 1.5, y: c.ground(x + 1.5, z - 1.4), z: z - 1.4, yaw: -0.5 });\n    c.hud.title = 'Morning Check';\n    enter(c, 'question');\n    say(c, 'tare', `morning.question.${Math.min(6, c.flow.day)}`);\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as MorningData;\n    const [{ seat, wobble: wob }] = c.seats;\n    leanSeats(c);\n    if (c.a.phase === 'question') {\n      for (const e of c.seats) [e.wobble.x, e.wobble.y, e.wobble.vx, e.wobble.vy] = [0, 0, 0, 0];\n      c.hud.ring = [0, 0, 0.22];\n      c.hud.show = { question: true };\n      const answered = seat.pfl ? 1 : seat.pfr ? 2 : 0;\n      if (answered || after(c, QUESTION)) {\n        c.flow.question = answered;\n        c.hud.show = {};\n        say(c, 'tare', answered === 1 ? 'morning.yes' : answered === 2 ? 'morning.no' : 'morning.silent');\n        say(c, 'tare', c.flow.day === 1 ? 'morning.teach.ring' : 'morning.ring');\n        enter(c, 'ring');\n      }\n      return;\n    }\n    if (c.a.phase === 'ring') {\n      const r = c.a.pt >= steps(c, NARROW_FROM) ? 0.16 : 0.22;\n      c.hud.ring = [0, 0, r];\n      c.hud.meter = 1 - c.a.pt / steps(c, RING);\n      c.hud.meterLabel = 'Still Ring';\n      if (inRing(wob, 0, 0, r)) d.inside += 1;\n      if (c.a.pt >= steps(c, RING)) {\n        d.a = d.inside / steps(c, RING);\n        say(c, 'tare', c.flow.day === 1 ? 'morning.teach.reach' : 'morning.reach');\n        enter(c, 'reach');\n      }\n      return;\n    }\n    if (c.a.phase === 'reach') {\n      d.reachT += 1;\n      const slot = d.order[d.target];\n      const [tx, ty] = targetAt(slot);\n      c.hud.ring = [tx, ty, TARGET_R];\n      c.hud.meter = 1 - c.a.pt / steps(c, REACH);\n      c.hud.meterLabel = `Reach ${d.target + 1} of 6`;\n      if (inRing(wob, tx, ty, TARGET_R)) {\n        d.held += 1;\n        if (d.held >= steps(c, TARGET_HOLD)) {\n          d.held = 0;\n          d.target += 1;\n          c.w.emit('reachHit', { n: d.target });\n        }\n      } else d.held = 0;\n      if (d.target >= 6 || c.a.pt >= steps(c, REACH)) {\n        d.b = d.target >= 6 ? Math.max(0, 1 - d.reachT / steps(c, REACH)) : 0;\n        wob.instMul = 1.6;\n        say(c, 'tare', d.foot === 'L' ? 'morning.foot.left' : 'morning.foot.right');\n        enter(c, 'foot');\n      }\n      return;\n    }\n    if (c.a.phase === 'foot') {\n      c.hud.ring = [0, 0, 0.3];\n      c.hud.meter = 1 - d.footInside / steps(c, FOOT);\n      c.hud.meterLabel = d.foot === 'L' ? 'Left foot' : 'Right foot';\n      c.hud.show = { foot: d.foot };\n      const heldFoot = d.foot === 'L' ? seat.fl >= 0.5 : seat.fr >= 0.5;\n      if (heldFoot && inRing(wob, 0, 0, 0.3)) d.footInside += 1;\n      else if (!heldFoot) d.footInside = Math.max(0, d.footInside - 1);\n      const tree = castOf(c.w, 'guest');\n      if (tree) Object.assign(tree.cast, { pose: heldFoot ? 'Heron' : '', poseT: heldFoot ? 0.5 : 0 });\n      if (c.a.pt >= steps(c, FOOT)) {\n        d.c = d.footInside / steps(c, FOOT);\n        d.s = 0.45 * d.a + 0.3 * d.b + 0.25 * d.c;\n        d.age = wobbleAge(d.s, c.w.settings.get<number>('game.age.k'));\n        (c.a.data as Record<string, unknown>).age = d.age;\n        wob.instMul = 1;\n        const guest = castOf(c.w, 'guest');\n        if (guest) Object.assign(guest.cast, { pose: '', poseT: 0 });\n        c.a.done = true;\n      }\n    }\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as MorningData;\n    const { seat, wobble } = e;\n    seat.fl = seat.fr = 0;\n    seat.act = false;\n    if (c.a.phase === 'question') {\n      seat.lx = seat.ly = 0;\n      if (player.acts && c.a.pt === 60) seat.fl = 1;\n    } else if (c.a.phase === 'reach') {\n      const [tx, ty] = targetAt(d.order[Math.min(5, d.target)]);\n      holdAt(c.w, seat, wobble, tx, ty, player);\n    } else if (c.a.phase === 'foot') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      if (player.acts) {\n        seat.fl = d.foot === 'L' ? 1 : 0;\n        seat.fr = d.foot === 'R' ? 1 : 0;\n      }\n    } else {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      breathe(c.w, seat, wobble, { ...player, acts: false });\n    }\n  },\n  score(c) {\n    const d = c.a.data as unknown as MorningData;\n    return d.s * 1000;\n  },\n};\n\n/** The Plaza's Tare platform, for the props. */\nexport const PLATFORM_AT = [STATIONS.plaza.x, STATIONS.plaza.z + 1] as const;\nEOF\ncat > labs/game/scenes/data/lures.ts <<'EOF'\n/**\n * @file Still Pond's lures (PLAN.md section 6), in order of escalation: the page shows each by id, and the sim knows\n * only its id and how long it stays. A new lure is a new row (and a page handler, and a line).\n *\n * Game code, sim-side data.\n *\n * @example\n * LURES[0].id; // 'press'\n */\n\n/** A lure. */\nexport interface Lure {\n  id: string;\n  /** How long it stays, s. */\n  stays: number;\n  /** Who speaks, if anyone. */\n  who?: string;\n  /** Whether the Frog or the Gull comes. */\n  critter?: 'frog' | 'gull';\n}\n\n/** The lures, escalating. */\nexport const LURES: readonly Lure[] = [\n  { id: 'press', stays: 3.5 },\n  { id: 'psst', stays: 4, who: 'tare' },\n  { id: 'stone', stays: 3.5, who: 'bex' },\n  { id: 'frog', stays: 6, critter: 'frog' },\n  { id: 'pause', stays: 4 },\n  { id: 'gull', stays: 6, critter: 'gull' },\n  { id: 'disconnected', stays: 4 },\n  { id: 'wrong', stays: 3.5, who: 'plumb' },\n  { id: 'credits', stays: 5 },\n];\nEOF\ncat > labs/game/scenes/events/pond.ts <<'EOF'\n/**\n * @file Still Pond (PLAN.md section 6): the funniest thing in the game, and almost no input. Composure starts at 1000.\n * The only correct input is breathing with the guide; anything else is \"You moved\". Every 6 to 10 s a lure from the\n * seeded table asks you to press something. Doing nothing at all earns exactly 500.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'pond');\n */\nimport { breathe, type Player } from '../bot/players';\nimport { LURES } from '../data/lures';\nimport { MAT_OFFSETS } from '../data/stations';\nimport { after, castOf, critterAway, critterGo, enter, say, standSeats, steps } from './kit';\nimport type { Activity, Ctx, SeatEntity } from './types';\n\n/** The stick travel, in lean units, that counts as moving. */\nconst STICK = 0.25;\n/** Mouse travel per step that counts. */\nconst MOUSE = 0.04;\n/** Steps a single foot may be down alone before it is a stray foot: the two triggers rarely go down together. */\nconst FOOT_GRACE = 12;\n/** A second's debounce. */\nconst DEBOUNCE = 60;\n/** Length of the sit, s. */\nconst LENGTH = 75;\nconst SHORT = 45;\nconst LEAD = 6;\n\n/** One seat's numbers. */\ninterface PondSeat {\n  composure: number;\n  moved: number;\n  cool: number;\n  alone: number;\n  syncSum: number;\n  total: number;\n}\n\n/** The sit's state. */\ninterface PondData {\n  seats: PondSeat[];\n  lure: number;\n  lureLeft: number;\n  next: number;\n  order: number[];\n  shown: number;\n  frog: number;\n}\n\n/** Whether this seat moved this step. */\nfunction moved(e: SeatEntity, s: PondSeat): boolean {\n  const { seat } = e;\n  const oneFoot = (seat.fl >= 0.5) !== (seat.fr >= 0.5);\n  s.alone = oneFoot ? s.alone + 1 : 0;\n  return Math.hypot(seat.lx, seat.ly) > STICK || seat.act || s.alone > FOOT_GRACE || seat.moved > MOUSE;\n}\n\n/** Still Pond. */\nexport const pond: Activity = {\n  id: 'pond',\n  title: 'Still Pond',\n  station: 'pond',\n  map: 'actionMap:balance',\n  shot: 'pond',\n  wobble: true,\n  setup(c) {\n    const rng = c.w.rng('pond');\n    const order: number[] = LURES.map((_lure, i) => i);\n    const d: PondData = {\n      seats: [0, 1, 2, 3].map(() => ({ composure: 1000, moved: 0, cool: 0, alone: 0, syncSum: 0, total: 0 })),\n      lure: -1,\n      lureLeft: 0,\n      next: steps(c, 6 + (c.a.short ? LEAD : 0)),\n      order,\n      shown: 0,\n      frog: 0,\n    };\n    c.a.data = d as unknown as Record<string, unknown>;\n    void rng;\n    c.hud.disc = true;\n    c.hud.guide = true;\n    c.hud.feet = true;\n    c.hud.title = 'Still Pond';\n    c.hud.show = { composure: 1000 };\n    if (c.round) standSeats(c, MAT_OFFSETS, Math.PI);\n    else {\n      const guest = castOf(c.w, 'guest');\n      if (guest) Object.assign(guest.cast, { hold: true, x: c.station.x, y: c.station.y + 0.45, z: c.station.z, yaw: Math.PI });\n    }\n    for (const e of c.seats) {\n      e.wobble.swayMul = 0.2;\n      const cast = c.w.get(e.seat.actor)?.cast;\n      if (cast) Object.assign(cast, { pose: 'Nothing', poseT: 1 });\n    }\n    enter(c, c.a.short ? 'lead' : 'sit');\n    say(c, 'plumb', 'pond.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as PondData;\n    if (c.a.phase === 'lead') {\n      c.hud.big = String(Math.max(1, LEAD - Math.floor(c.a.pt / c.w.hz)));\n      if (after(c, LEAD)) {\n        c.hud.big = '';\n        enter(c, 'sit');\n      }\n      return;\n    }\n    const length = steps(c, c.a.short ? SHORT : LENGTH);\n    c.hud.meter = 1 - c.a.pt / length;\n    for (const e of c.seats) {\n      const s = d.seats[e.seat.index];\n      s.total += 1;\n      s.syncSum += e.wobble.sync;\n      s.cool = Math.max(0, s.cool - 1);\n      if (moved(e, s) && s.cool === 0) {\n        s.cool = DEBOUNCE;\n        s.moved += 1;\n        s.composure = Math.max(0, s.composure - c.w.settings.get<number>('game.pond.penalty'));\n        c.w.emit('moved', { seat: e.seat.index, composure: s.composure });\n        const cast = c.w.get(e.seat.actor)?.cast;\n        if (cast && e.seat.index === c.seats[0].seat.index) c.w.emit('ripple', { x: cast.x, z: cast.z + 1.6 });\n      }\n      const cast = c.w.get(e.seat.actor)?.cast;\n      if (cast) {\n        cast.leanX = e.wobble.x * 0.5;\n        cast.leanY = e.wobble.y * 0.5 + e.wobble.lungs * 0.18;\n      }\n    }\n    c.hud.show = { composure: d.seats[c.seats[0].seat.index].composure, lure: d.lure >= 0 ? LURES[d.lure].id : '' };\n    // The lures.\n    if (d.lure >= 0) {\n      d.lureLeft -= 1;\n      if (d.lureLeft <= 0) {\n        critterAway(c, 'frog');\n        critterAway(c, 'gull');\n        d.lure = -1;\n        d.next = steps(c, c.w.rng('pond').range(6, 10));\n      }\n    } else if (--d.next <= 0 && d.shown < LURES.length) {\n      const lure = LURES[d.order[d.shown]];\n      d.lure = d.order[d.shown];\n      d.shown += 1;\n      d.lureLeft = steps(c, lure.stays);\n      c.w.emit('lure', { id: lure.id });\n      if (lure.who) say(c, lure.who, `pond.lure.${lure.id}`);\n      const guest = c.w.get(c.seats[0].seat.actor)?.cast;\n      if (guest && lure.critter === 'frog') critterGo(c, 'frog', guest.x + 0.25, guest.y + 0.45, guest.z + 0.2, Math.PI);\n      if (guest && lure.critter === 'gull') critterGo(c, 'gull', guest.x, guest.y + 1.12, guest.z, 0);\n    }\n    if (c.a.pt >= length) {\n      say(c, 'plumb', 'pond.end');\n      c.a.done = true;\n    }\n  },\n  teardown(c) {\n    critterAway(c, 'frog');\n    critterAway(c, 'gull');\n  },\n  bot(c, e, player: Player) {\n    const { seat, wobble } = e;\n    const d = c.a.data as unknown as PondData;\n    seat.lx = seat.ly = 0;\n    seat.act = false;\n    breathe(c.w, seat, wobble, player);\n    // A person sometimes falls for a lure: the human for the fake pause, the sloppy for three of them.\n    if (d.lure >= 0 && d.lureLeft === steps(c, LURES[d.lure].stays) - 30) {\n      const lure = LURES[d.lure].id;\n      if ((player.name === 'human' && lure === 'pause') || (player.name === 'sloppy' && ['press', 'pause', 'disconnected'].includes(lure))) seat.act = true; // prettier-ignore\n    }\n  },\n  score(c, index) {\n    const d = c.a.data as unknown as PondData;\n    const s = d.seats[index];\n    const sync = s.total > 0 ? s.syncSum / s.total : 0;\n    return s.composure * (0.5 + 0.5 * sync);\n  },\n};\nEOF\ncat > labs/game/scenes/events/index.ts <<'EOF'\n/**\n * @file The activity table: every module, by id. A new activity is a new module and a new row here.\n *\n * Game code, sim-side.\n *\n * @example\n * ACTIVITIES.pond.title; // 'Still Pond'\n */\nimport { morning } from './morning';\nimport { makePoseClass } from './pose';\nimport { pond } from './pond';\nimport { ring } from './ring';\nimport type { Activity } from './types';\n\n/** The activities, by id. */\nexport const ACTIVITIES: Record<string, Activity> = {\n  morning,\n  poseA: makePoseClass('poseA', 'Pose Class'),\n  poseB: makePoseClass('poseB', 'Pose Class'),\n  poseC: makePoseClass('poseC', 'Pose Class'),\n  heron: makePoseClass('heron', 'The Heron'),\n  pond,\n  ring,\n};\nEOF\n","description":"Write Pose Class, Morning Check and Still Pond"}}}
