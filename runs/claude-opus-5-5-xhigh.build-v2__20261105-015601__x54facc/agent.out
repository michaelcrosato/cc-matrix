{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VvAVVc42Wx2rAYKVb5WtWr","type":"tool_result","content":"62\t};\n63\t\n64\t/** What a song choice depends on. */\n65\texport interface MusicState {\n66\t  event: string;\n67\t  mode: string;\n68\t  day: number;\n69\t  sky: string;\n70\t  front: boolean;\n71\t  phrase?: number;\n72\t  tilt?: number;\n73\t  credits?: boolean;\n74\t}\n75\t\n76\t/** The song for what is on. */\n77\tfunction songFor(m: MusicState): string {\n78\t  if (m.credits) return 'song:dawn';\n79\t  if (m.sky === 'storm') return 'song:tilt';\n80\t  switch (m.event && m.mode === 'event' ? m.event : '') {\n81\t    case 'poseA':\n82\t    case 'poseB':\n83\t    case 'poseC':\n84\t    case 'heron':\n85\t    case 'ring':\n86\t    case 'morning':\n87\t    case 'pond':\n88\t    case 'group':\n89\t      return 'song:stillness';\n90\t    case 'line':\n91\t    case 'paddle':\n92\t    case 'plunge':\n93\t      return 'song:water';\n94\t    case 'step':\n95\t      return `song:stepBed${[104, 112, 120][m.phrase ?? 0] ?? 112}`;\n96\t    case 'hoop':\n97\t    case 'garden':\n98\t      return 'song:hoop';\n99\t    default:\n100\t      return 'song:lobby';\n101\t  }\n102\t}\n103\t\n104\t/** The page's sound. */\n105\texport class Sound {\n106\t  readonly audio: Audio;\n107\t  private seq = 0;\n108\t  private world: object | null = null;\n109\t  private song = '';\n110\t  private ambience: { stop?: () => void }[] = [];\n111\t  private ambKind = '';\n112\t  private rolling: { stop?: () => void; volume?: (v: number) => void } | null = null;\n113\t  private lastCreak = 0;\n114\t  private speechUntil = 0;\n115\t  onSpeech: (who: string, text: string, seconds: number, id: string) => void = () => {};\n116\t  volumes: Volumes = { music: 0.1, effects: 1, voices: 1 };\n117\t\n118\t  constructor(context?: BaseAudioContext) {\n119\t    this.audio = createAudio(context ? { context } : {});\n120\t    this.audio.volume('music', 0.1);\n121\t  }\n122\t\n123\t  /** Applies the player's volumes. */\n124\t  setVolumes(v: Volumes): void {\n125\t    this.volumes = v;\n126\t    this.audio.volume('music', v.music);\n127\t    this.audio.volume('effects', v.effects);\n128\t    this.audio.volume('ambience', v.effects);\n129\t    this.audio.volume('ui', Math.max(v.effects, v.voices));\n130\t  }\n131\t\n132\t  /** Plays an effect. */\n133\t  play(id: string, vol = 1): void {\n134\t    this.audio.play(id, { vol });\n135\t  }\n136\t\n137\t  /** Speaks a line by id; n picks among its variants. */\n138\t  speak(who: string, line: string, n = 0): void {\n139\t    const entry = getLine(line, n);\n140\t    if (!entry) return;\n141\t    const speaker = entry.who ?? who;\n142\t    const seconds = say(this.audio, speaker, entry.text, this.volumes.voices);\n143\t    this.speechUntil = performance.now() + seconds * 1000;\n144\t    this.onSpeech(speaker, entry.text, seconds, line);\n145\t  }\n146\t\n147\t  /** Whether a line is being spoken. */\n148\t  get speaking(): boolean {\n149\t    return performance.now() < this.speechUntil;\n150\t  }\n151\t\n152\t  /** Sets the song and intensity for what is on. */\n153\t  setMusic(m: MusicState): void {\n154\t    const song = songFor(m);\n155\t    if (song !== this.song) {\n156\t      this.song = song;\n157\t      this.audio.music(song, { intensity: song === 'song:lobby' ? Math.min(1, 0.05 + (m.day - 1) * 0.22) : 0.6 });\n158\t    }\n159\t    if (m.sky === 'storm') this.audio.intensity(Math.min(1, 0.2 + (m.tilt ?? 0) / 8));\n160\t    const amb = m.sky === 'storm' ? 'storm' : 'calm';\n161\t    if (amb !== this.ambKind) {\n162\t      this.ambKind = amb;\n163\t      for (const s of this.ambience) s.stop?.();\n164\t      this.ambience = [];\n165\t      const list = amb === 'storm' ? ['sfx:ambRain', 'sfx:ambWind', 'sfx:ambSea'] : ['sfx:ambSea', 'sfx:ambBirds'];\n166\t      for (const id of list) {\n167\t        const played = this.audio.play(id, { loop: true }) as unknown as { stop?: () => void } | null;\n168\t        if (played) this.ambience.push(played);\n169\t      }\n170\t    }\n171\t  }\n172\t\n173\t  /** The marble roll: a loop with its level by speed; 0 stops it. */\n174\t  marble(speed: number): void {\n175\t    const on = speed > 0.08;\n176\t    if (on && !this.rolling)\n177\t      this.rolling = this.audio.play('sfx:marble', { loop: true, vol: 0.2 }) as unknown as {\n178\t        stop?: () => void;\n179\t        volume?: (v: number) => void;\n180\t      } | null;\n181\t    if (!on && this.rolling) {\n182\t      this.rolling.stop?.();\n183\t      this.rolling = null;\n184\t    }\n185\t    this.rolling?.volume?.(Math.min(1, speed * 0.45));\n186\t  }\n187\t\n188\t  /** The wobble creak, its pitch and level by how near the edge. */\n189\t  creak(r: number): void {\n190\t    const now = performance.now();\n191\t    if (r < 0.75 || now - this.lastCreak < 340) return;\n192\t    this.lastCreak = now;\n193\t    this.audio.play('sfx:creak', { pitch: 0.7 + r * 0.7, vol: (r - 0.7) * 2.2 });\n194\t  }\n195\t\n196\t  /** One frame: the listener, and each new sim event by `seq`. */\n197\t  frame(frame: EngineFrame, onEvent: (type: string, payload: Record<string, unknown>) => void): void {\n198\t    this.audio.update(frame.camera, frame.queries ?? undefined);\n199\t    if (frame.world !== this.world) {\n200\t      this.world = frame.world;\n201\t      this.seq = 0;\n202\t      const trace = frame.world.events.trace();\n203\t      this.seq = trace.length ? trace[trace.length - 1].seq - 0 : 0;\n204\t      for (const record of trace)\n205\t        if (record.seq >= this.seq) onEvent(record.type, record.payload as Record<string, unknown>);\n206\t      return;\n207\t    }\n208\t    for (const record of frame.world.events.trace()) {\n209\t      if (record.seq <= this.seq) continue;\n210\t      this.seq = record.seq;\n211\t      const payload = (record.payload ?? {}) as Record<string, unknown>;\n212\t      const id = SIMPLE[record.type];\n213\t      if (id) this.audio.play(id);\n214\t      onEvent(record.type, payload);\n215\t    }\n216\t  }\n217\t}\n218\t"}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"f7a8c772-c00c-4bce-bd0e-11a96c1a6049","timestamp":"2026-11-05T20:12:43.757Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-015601__x54facc/work/TeeterFit-WiiFit-claude-opus-5-5-xhigh-20261105-015601/labs/game/audio/sound.ts","content":"};\n\n/** What a song choice depends on. */\nexport interface MusicState {\n  event: string;\n  mode: string;\n  day: number;\n  sky: string;\n  front: boolean;\n  phrase?: number;\n  tilt?: number;\n  credits?: boolean;\n}\n\n/** The song for what is on. */\nfunction songFor(m: MusicState): string {\n  if (m.credits) return 'song:dawn';\n  if (m.sky === 'storm') return 'song:tilt';\n  switch (m.event && m.mode === 'event' ? m.event : '') {\n    case 'poseA':\n    case 'poseB':\n    case 'poseC':\n    case 'heron':\n    case 'ring':\n    case 'morning':\n    case 'pond':\n    case 'group':\n      return 'song:stillness';\n    case 'line':\n    case 'paddle':\n    case 'plunge':\n      return 'song:water';\n    case 'step':\n      return `song:stepBed${[104, 112, 120][m.phrase ?? 0] ?? 112}`;\n    case 'hoop':\n    case 'garden':\n      return 'song:hoop';\n    default:\n      return 'song:lobby';\n  }\n}\n\n/** The page's sound. */\nexport class Sound {\n  readonly audio: Audio;\n  private seq = 0;\n  private world: object | null = null;\n  private song = '';\n  private ambience: { stop?: () => void }[] = [];\n  private ambKind = '';\n  private rolling: { stop?: () => void; volume?: (v: number) => void } | null = null;\n  private lastCreak = 0;\n  private speechUntil = 0;\n  onSpeech: (who: string, text: string, seconds: number, id: string) => void = () => {};\n  volumes: Volumes = { music: 0.1, effects: 1, voices: 1 };\n\n  constructor(context?: BaseAudioContext) {\n    this.audio = createAudio(context ? { context } : {});\n    this.audio.volume('music', 0.1);\n  }\n\n  /** Applies the player's volumes. */\n  setVolumes(v: Volumes): void {\n    this.volumes = v;\n    this.audio.volume('music', v.music);\n    this.audio.volume('effects', v.effects);\n    this.audio.volume('ambience', v.effects);\n    this.audio.volume('ui', Math.max(v.effects, v.voices));\n  }\n\n  /** Plays an effect. */\n  play(id: string, vol = 1): void {\n    this.audio.play(id, { vol });\n  }\n\n  /** Speaks a line by id; n picks among its variants. */\n  speak(who: string, line: string, n = 0): void {\n    const entry = getLine(line, n);\n    if (!entry) return;\n    const speaker = entry.who ?? who;\n    const seconds = say(this.audio, speaker, entry.text, this.volumes.voices);\n    this.speechUntil = performance.now() + seconds * 1000;\n    this.onSpeech(speaker, entry.text, seconds, line);\n  }\n\n  /** Whether a line is being spoken. */\n  get speaking(): boolean {\n    return performance.now() < this.speechUntil;\n  }\n\n  /** Sets the song and intensity for what is on. */\n  setMusic(m: MusicState): void {\n    const song = songFor(m);\n    if (song !== this.song) {\n      this.song = song;\n      this.audio.music(song, { intensity: song === 'song:lobby' ? Math.min(1, 0.05 + (m.day - 1) * 0.22) : 0.6 });\n    }\n    if (m.sky === 'storm') this.audio.intensity(Math.min(1, 0.2 + (m.tilt ?? 0) / 8));\n    const amb = m.sky === 'storm' ? 'storm' : 'calm';\n    if (amb !== this.ambKind) {\n      this.ambKind = amb;\n      for (const s of this.ambience) s.stop?.();\n      this.ambience = [];\n      const list = amb === 'storm' ? ['sfx:ambRain', 'sfx:ambWind', 'sfx:ambSea'] : ['sfx:ambSea', 'sfx:ambBirds'];\n      for (const id of list) {\n        const played = this.audio.play(id, { loop: true }) as unknown as { stop?: () => void } | null;\n        if (played) this.ambience.push(played);\n      }\n    }\n  }\n\n  /** The marble roll: a loop with its level by speed; 0 stops it. */\n  marble(speed: number): void {\n    const on = speed > 0.08;\n    if (on && !this.rolling)\n      this.rolling = this.audio.play('sfx:marble', { loop: true, vol: 0.2 }) as unknown as {\n        stop?: () => void;\n        volume?: (v: number) => void;\n      } | null;\n    if (!on && this.rolling) {\n      this.rolling.stop?.();\n      this.rolling = null;\n    }\n    this.rolling?.volume?.(Math.min(1, speed * 0.45));\n  }\n\n  /** The wobble creak, its pitch and level by how near the edge. */\n  creak(r: number): void {\n    const now = performance.now();\n    if (r < 0.75 || now - this.lastCreak < 340) return;\n    this.lastCreak = now;\n    this.audio.play('sfx:creak', { pitch: 0.7 + r * 0.7, vol: (r - 0.7) * 2.2 });\n  }\n\n  /** One frame: the listener, and each new sim event by `seq`. */\n  frame(frame: EngineFrame, onEvent: (type: string, payload: Record<string, unknown>) => void): void {\n    this.audio.update(frame.camera, frame.queries ?? undefined);\n    if (frame.world !== this.world) {\n      this.world = frame.world;\n      this.seq = 0;\n      const trace = frame.world.events.trace();\n      this.seq = trace.length ? trace[trace.length - 1].seq - 0 : 0;\n      for (const record of trace)\n        if (record.seq >= this.seq) onEvent(record.type, record.payload as Record<string, unknown>);\n      return;\n    }\n    for (const record of frame.world.events.trace()) {\n      if (record.seq <= this.seq) continue;\n      this.seq = record.seq;\n      const payload = (record.payload ?? {}) as Record<string, unknown>;\n      const id = SIMPLE[record.type];\n      if (id) this.audio.play(id);\n      onEvent(record.type, payload);\n    }\n  }\n}\n","numLines":157,"startLine":62,"totalLines":218}},"tool_result_meta":[{"id":"toolu_01VvAVVc42Wx2rAYKVb5WtWr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
