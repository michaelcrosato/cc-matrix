{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjWmYBLEGhx8L3cGnzVz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JYMGdp5bUgzXmsqMasrkgC","name":"Bash","input":{"command":"cat > labs/game/scenes/data/stations.ts <<'EOF'\n/**\n * @file Little Fulcrum's station layout, in metres: x east, z south, island centre at 0, 0. Later content adds rows.\n *\n * Game code, sim-side data.\n *\n * @example\n * STATIONS.plaza.x; // 0\n */\n\n/** A place on the island. */\nexport interface Station {\n  id: string;\n  title: string;\n  x: number;\n  z: number;\n  /** Where a person faces on arrival, rad. */\n  yaw: number;\n  /** Flat ground height, when the station has a flat. */\n  y: number;\n}\n\n/** Height of the island's flat stations, m. */\nexport const FLAT_Y = 8;\n\n/** The stations (PLAN.md section 2). */\nexport const STATIONS: Readonly<Record<string, Station>> = Object.freeze({\n  pier: { id: 'pier', title: 'Ferry Pier', x: 0, z: 94, yaw: Math.PI, y: 3.1 },\n  plaza: { id: 'plaza', title: 'The Plaza', x: 0, z: 34, yaw: 0, y: FLAT_Y },\n  pavilion: { id: 'pavilion', title: 'Pose Pavilion', x: -52, z: 18, yaw: 0, y: FLAT_Y },\n  pond: { id: 'pond', title: 'Still Pond', x: -70, z: -12, yaw: 0, y: 5.4 },\n  annex: { id: 'annex', title: 'The Annex', x: 52, z: 22, yaw: 0, y: FLAT_Y },\n  huts: { id: 'huts', title: 'Guest Huts', x: 64, z: 52, yaw: 0, y: 5.2 },\n  lagoon: { id: 'lagoon', title: 'South-West Lagoon', x: -60, z: 85, yaw: Math.PI / 2, y: 3.4 },\n  terrace: { id: 'terrace', title: 'Sand Terrace', x: 30, z: -48, yaw: 0, y: 8 },\n  cliff: { id: 'cliff', title: 'North Cliff', x: 0, z: -80, yaw: Math.PI, y: 16 },\n  hoopBeach: { id: 'hoopBeach', title: 'Hoop Beach', x: 62, z: 84, yaw: 0, y: 3.4 },\n  lighthouse: { id: 'lighthouse', title: 'Lighthouse', x: 84, z: -60, yaw: 0, y: 4 },\n  eastTerrace: { id: 'eastTerrace', title: 'East Terrace', x: 74, z: 8, yaw: 0, y: 7 },\n  centre: { id: 'centre', title: 'Centre Stone', x: 0, z: 0, yaw: 0, y: 14 },\n});\n\n/** The sea's height, m. */\nexport const SEA_Y = 2;\n\n/** The offset of each of four mats from the pavilion's centre: seat 0 front left, then along. */\nexport const MAT_OFFSETS: readonly (readonly [number, number])[] = [\n  [-4.5, 3],\n  [-1.5, 3],\n  [1.5, 3],\n  [4.5, 3],\n];\n\n/** The Annex's four step platforms and rep mats, as offsets from its centre. */\nexport const ANNEX_OFFSETS: readonly (readonly [number, number])[] = [\n  [-4.5, 3],\n  [-1.5, 3],\n  [1.5, 3],\n  [4.5, 3],\n];\nEOF\ncat > labs/game/scenes/scoring.ts <<'EOF'\n/**\n * @file Scores, ranks, pebbles and the Wobble Age (PLAN.md sections 3 and 5). Pure functions.\n *\n * Game code, sim-side.\n *\n * @example\n * rankOf(760); // 'Serene'\n * wobbleAge(1, 1.3); // 18\n */\n\n/** The ranks from the bottom, each with the score it starts at. */\nexport const RANKS: readonly { name: string; from: number; pebbles: number }[] = [\n  { name: 'Present', from: 0, pebbles: 1 },\n  { name: 'Adequate', from: 300, pebbles: 2 },\n  { name: 'Composed', from: 550, pebbles: 3 },\n  { name: 'Serene', from: 750, pebbles: 4 },\n  { name: 'Unsettling', from: 900, pebbles: 5 },\n];\n\n/** The rank a score earns. */\nexport function rankEntry(score: number): { name: string; from: number; pebbles: number } {\n  let found = RANKS[0];\n  for (const rank of RANKS) if (score >= rank.from) found = rank;\n  return found;\n}\n\n/** The rank's name. */\nexport const rankOf = (score: number): string => rankEntry(score).name;\n\n/** Pebbles a score earns, before the dev multiplier. */\nexport const pebblesOf = (score: number): number => rankEntry(score).pebbles;\n\n/** The Wobble Age for a share `s` in 0 to 1: 18 at best, 82 at worst. */\nexport function wobbleAge(s: number, k: number): number {\n  const clamped = Math.min(1, Math.max(0, s));\n  return Math.round(18 + 64 * Math.pow(1 - clamped, k));\n}\n\n/** A score kept within 0 to 1000 and whole. */\nexport const clampScore = (score: number): number => Math.round(Math.min(1000, Math.max(0, score)));\nEOF\ncat > labs/game/scenes/events/types.ts <<'EOF'\n/**\n * @file The shape every activity shares (PLAN.md section 6): `step` emits sim events; the page turns them into text,\n * sound and HUD. `bot` writes the same seat input a player does: tests, attract mode and dev auto-play use it.\n *\n * Game code, sim-side.\n *\n * @example\n * // const pond: Activity = { id: 'pond', title: 'Still Pond', station: 'pond', map: 'actionMap:balance', ... };\n */\nimport type { ActivityData, Flow, GameWorld, HudData, Seat, Wobble } from '../components';\nimport type { Player } from '../bot/players';\nimport type { Station } from '../data/stations';\n\n/** A seat with its body. */\nexport interface SeatEntity {\n  id: number;\n  seat: Seat;\n  wobble: Wobble;\n}\n\n/** What an activity is handed each call. */\nexport interface Ctx {\n  w: GameWorld;\n  a: ActivityData;\n  flow: Flow;\n  /** The seats in play, seat 0 first. */\n  seats: SeatEntity[];\n  station: Station;\n  /** The ground's height at a place. */\n  ground(x: number, z: number): number;\n  /** Whether this is the small session scene. */\n  round: boolean;\n  /** The activity's HUD, to write. */\n  hud: HudData;\n}\n\n/** An activity. */\nexport interface Activity {\n  id: string;\n  title: string;\n  /** The station it runs at. */\n  station: string;\n  /** The action map the page uses for it. */\n  map: 'actionMap:balance' | 'actionMap:balanceFree';\n  /** The camera shot the page frames it with. */\n  shot: string;\n  /** Whether the Wobble Model steps each seat (false: the activity reads seats directly). */\n  wobble: boolean;\n  /** How many seats it wants by default. */\n  seats?: number;\n  /** Spawns what it needs. */\n  setup(c: Ctx): void;\n  /** One step of its rules, after the seats and bodies stepped. */\n  step(c: Ctx): void;\n  /** Removes what setup did not put in the spawned lists. */\n  teardown?(c: Ctx): void;\n  /** One seat's input for one step, as `player` would press it. */\n  bot(c: Ctx, seat: SeatEntity, player: Player): void;\n  /** Its score for a seat, once done. */\n  score(c: Ctx, index: number): number;\n}\nEOF\ncat > labs/game/scenes/events/kit.ts <<'EOF'\n/**\n * @file What activities share: phases, speech, ring markers, spawning that cleans itself up, and holding people in\n * place. Sim-side; everything spawned through it is listed on the activity, so teardown leaves nothing behind.\n *\n * Game code, sim-side.\n *\n * @example\n * // enter(c, 'hold'); say(c, 'plumb', 'pose.hold');\n */\nimport { removeActor, removeProp, spawnProp, type PropPlacement } from '../../../../engine/sim-api';\nimport type { Cast, GameComponents, GameWorld } from '../components';\nimport type { Ctx } from './types';\n\n/** The steps in `seconds`. */\nexport const steps = (c: { w: GameWorld }, seconds: number): number => Math.round(seconds * c.w.hz);\n\n/** Moves the activity to a phase. */\nexport function enter(c: Ctx, phase: string): void {\n  c.a.phase = phase;\n  c.a.pt = 0;\n  c.w.emit('phase', { event: c.a.id, phase });\n}\n\n/** Whether `seconds` have passed in this phase. */\nexport const after = (c: Ctx, seconds: number): boolean => c.a.pt >= steps(c, seconds);\n\n/** Asks the page to say a line: `who` a cast id, `line` a line group's id. */\nexport function say(c: { w: GameWorld }, who: string, line: string): void {\n  c.w.emit('say', { who, line, n: c.w.tick });\n}\n\n/** Spawns a prop for this activity; teardown removes it. */\nexport function propFor(c: Ctx, placement: PropPlacement): number {\n  const id = spawnProp(c.w, placement);\n  c.a.spawned.push(id);\n  return id;\n}\n\n/** Spawns a plain entity for this activity; teardown removes it. */\nexport function entityFor(c: Ctx, spec: Partial<GameComponents>): number {\n  const id = c.w.spawn(spec);\n  c.a.spawned.push(id);\n  return id;\n}\n\n/** Removes everything this activity spawned. */\nexport function clearSpawned(c: Ctx): void {\n  for (const id of c.a.spawned) {\n    const e = c.w.get(id);\n    if (!e) continue;\n    if (e.sceneProp) removeProp(c.w, id);\n    else c.w.despawn(id);\n  }\n  for (const id of c.a.actors) if (c.w.get(id)) removeActor(c.w, id);\n  c.a.spawned = [];\n  c.a.actors = [];\n}\n\n/** The named person's entity. */\nexport function castOf(w: GameWorld, who: string): { id: number; cast: Cast } | undefined {\n  return w.query('cast').find((e) => e.cast.who === who);\n}\n\n/** Holds a named person at a place until released. */\nexport function hold(w: GameWorld, who: string, x: number, y: number, z: number, yaw: number): void {\n  const e = castOf(w, who);\n  if (!e) return;\n  Object.assign(e.cast, { hold: true, x, y, z, yaw });\n}\n\n/** Lets a named person walk again. */\nexport function release(w: GameWorld, who: string): void {\n  const e = castOf(w, who);\n  if (e) Object.assign(e.cast, { hold: false, pose: '', poseT: 0, leanX: 0, leanY: 0 });\n}\n\n/** Sets the pose strip a person scrubs, and how far along it is. */\nexport function pose(w: GameWorld, who: string, name: string, t: number, leanX = 0, leanY = 0): void {\n  const e = castOf(w, who);\n  if (e) Object.assign(e.cast, { pose: name, poseT: t, leanX, leanY });\n}\n\n/** A marker for HUD text: a score as text. */\nexport const pct = (v: number): string => `${Math.round(v * 100)}%`;\nEOF\ncat > labs/game/scenes/flow.ts <<'EOF'\n/**\n * @file The flow of the game on one world (the one-scene rule, PLAN.md section 14): starting an activity, stepping it,\n * its results, leaving it, and the days. It owns the `activity` entity and the seats' use.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'pond'); // from an action or the director\n */\nimport { held, pressed, terrainHeight, type Intents, type Terrain } from '../../../engine/sim-api';\nimport type { ActivityData, Flow, GameWorld, IslandData, Seat, Wobble } from './components';\nimport { holdAt, mash, playerOf, type Player } from './bot/players';\nimport { STATIONS, type Station } from './data/stations';\nimport { ACTIVITIES } from './events/index';\nimport { clearSpawned, say } from './events/kit';\nimport type { Activity, Ctx, SeatEntity } from './events/types';\nimport { clampScore, pebblesOf, rankOf } from './scoring';\nimport { resetWobble, stepWobble } from './wobble';\n\n/** What differs between the island and the round scene. */\nexport interface FlowHost {\n  round: boolean;\n  terrain: Terrain | null;\n  floorY: number;\n  /** A station to use whichever one the activity names (the round: the pavilion). */\n  station?: string;\n}\n\n/** The world's host, per world: held in module state keyed by the world, never read for play beyond its constants. */\nconst HOSTS = new WeakMap<object, FlowHost>();\n\n/** Remembers what kind of world this is. */\nexport function setHost(w: GameWorld, host: FlowHost): void {\n  HOSTS.set(w, host);\n}\n\n/** The world's host. */\nexport const hostOf = (w: GameWorld): FlowHost => HOSTS.get(w) ?? { round: false, terrain: null, floorY: 0 };\n\n/** The ground at a place, in this world. */\nexport function groundAt(w: GameWorld, x: number, z: number): number {\n  const host = hostOf(w);\n  if (!host.terrain) return host.floorY;\n  return terrainHeight(host.terrain, x, z) ?? host.floorY;\n}\n\n/** The world's flow. */\nexport const flowOf = (w: GameWorld): Flow => w.query('flow')[0].flow;\n\n/** The world's island state. */\nexport const islandOf = (w: GameWorld): IslandData => w.query('island')[0].island;\n\n/** The running activity's entity, if any. */\nexport function activityOf(w: GameWorld): { id: number; activity: ActivityData } | undefined {\n  return w.query('activity')[0];\n}\n\n/** Every seat with its body, in seat order. */\nexport function allSeats(w: GameWorld): SeatEntity[] {\n  return w.query('seat', 'wobble') as unknown as SeatEntity[];\n}\n\n/** The seats in play. */\nexport const liveSeats = (w: GameWorld): SeatEntity[] => allSeats(w).filter((e) => e.seat.kind !== 'off');\n\n/** An activity's context for this world. */\nexport function contextOf(w: GameWorld, mod: Activity, a: ActivityData): Ctx {\n  const host = hostOf(w);\n  const station: Station = STATIONS[host.station ?? mod.station] ?? STATIONS.plaza;\n  return {\n    w,\n    a,\n    flow: flowOf(w),\n    seats: liveSeats(w),\n    station,\n    ground: (x, z) => groundAt(w, x, z),\n    round: host.round,\n    hud: a.hud,\n  };\n}\n\n/** How a seat takes part, for an activity's start. */\nexport interface SeatUse {\n  kind: Seat['kind'];\n  skill?: string;\n  sway?: number;\n}\n\n/** Starts an activity: the seats, its setup, the flow. Any activity running is ended first. */\nexport function startActivity(\n  w: GameWorld,\n  id: string,\n  options: { short?: boolean; seats?: readonly SeatUse[]; data?: Record<string, unknown> } = {},\n): void {\n  const mod = ACTIVITIES[id];\n  if (!mod) throw new Error(`no activity \"${id}\"`);\n  endActivity(w);\n  const flow = flowOf(w);\n  const uses = options.seats ?? [{ kind: 'local' as const }];\n  for (const e of allSeats(w)) {\n    const use = uses[e.seat.index];\n    e.seat.kind = use?.kind ?? 'off';\n    e.seat.skill = use?.skill ?? '';\n    e.seat.sway = use?.sway ?? 1;\n    Object.assign(e.seat, { lx: 0, ly: 0, fl: 0, fr: 0, act: false, actP: false, pfl: false, pfr: false, hist: [], mem: {} });\n    resetWobble(e.wobble);\n    e.wobble.on = e.seat.kind !== 'off';\n  }\n  const a: ActivityData = { id, short: options.short ?? false, phase: '', t: 0, pt: 0, done: false, score: 0, scores: [], data: options.data ?? {}, hud: {}, spawned: [], actors: [] }; // prettier-ignore\n  const entity = w.spawn({ activity: a });\n  const live = w.get(entity)?.activity as ActivityData | undefined;\n  const held2 = live ?? a;\n  flow.mode = 'event';\n  flow.event = id;\n  flow.focus = -1;\n  if (!flow.seen.includes(id)) flow.seen.push(id);\n  mod.setup(contextOf(w, mod, held2));\n  w.emit('activity', { id, start: true });\n}\n\n/** Takes the running activity away: teardown, and its entity. */\nexport function endActivity(w: GameWorld): void {\n  for (const entity of w.query('activity')) {\n    const a = entity.activity;\n    const mod = ACTIVITIES[a.id];\n    const c = contextOf(w, mod, a);\n    mod.teardown?.(c);\n    clearSpawned(c);\n    w.despawn(entity.id);\n  }\n  for (const e of allSeats(w)) {\n    e.seat.kind = e.seat.index === 0 ? 'local' : 'off';\n    e.wobble.on = false;\n  }\n}\n\n/** Reads the page's intents into the seats: seat 0 from the action map, the others from `game:seats`. */\nexport function readSeats(w: GameWorld, intents: Intents, mod: Activity | null, a: ActivityData | null): void {\n  const flow = flowOf(w);\n  const seats = allSeats(w);\n  const auto = w.settings.get<boolean>('game.auto') || flow.attract;\n  const local = intents as unknown as Record<string, unknown>;\n  const num = (key: string): number => {\n    const v = local[key];\n    return typeof v === 'number' ? v : 0;\n  };\n  const group = local['game:seats'];\n  const c = mod && a ? contextOf(w, mod, a) : null;\n  for (const e of seats) {\n    const { seat } = e;\n    const before = { l: seat.fl >= 0.5, r: seat.fr >= 0.5, a: seat.act };\n    seat.mx = seat.my = seat.moved = 0;\n    seat.pointer = false;\n    if (seat.kind === 'off') continue;\n    const useBot = seat.kind === 'cpu' || (seat.index === 0 && auto);\n    if (useBot && c && mod) {\n      const name = seat.kind === 'cpu' ? seat.skill || 'human' : flow.attract ? 'perfect' : w.settings.get<string>('game.skill'); // prettier-ignore\n      const player: Player = playerOf(name);\n      if (name === 'mash') mash(w, seat);\n      else mod.bot(c, e, player);\n    } else if (seat.index === 0 && !Array.isArray(group)) {\n      seat.lx = num('game:r') - num('game:l');\n      seat.ly = num('game:f') - num('game:b');\n      seat.fl = num('game:fl');\n      seat.fr = num('game:fr');\n      seat.gentle = held(intents, 'gentle');\n      seat.act = held(intents, 'act');\n      const mouse = local['game:mouse'];\n      if (Array.isArray(mouse)) {\n        seat.mx = Number(mouse[0]) || 0;\n        seat.my = Number(mouse[1]) || 0;\n        seat.moved = Math.hypot(seat.mx, seat.my);\n      }\n      const point = local['game:pointer'];\n      if (Array.isArray(point) && point[2]) {\n        seat.px = Number(point[0]) || 0;\n        seat.py = Number(point[1]) || 0;\n        seat.pointer = true;\n      }\n      if (pressed(intents, 'act')) before.a = false;\n    } else if (Array.isArray(group)) {\n      const at = seat.index * 5;\n      seat.lx = Number(group[at]) || 0;\n      seat.ly = Number(group[at + 1]) || 0;\n      seat.fl = Number(group[at + 2]) || 0;\n      seat.fr = Number(group[at + 3]) || 0;\n      seat.act = Boolean(group[at + 4]);\n    } else {\n      Object.assign(seat, { lx: 0, ly: 0, fl: 0, fr: 0, act: false });\n    }\n    seat.pfl = seat.fl >= 0.5 && !before.l;\n    seat.pfr = seat.fr >= 0.5 && !before.r;\n    seat.actP = seat.act && !before.a;\n  }\n}\n\n/** One step of the running activity: seats read, bodies stepped, its rules, its end. */\nexport function stepActivity(w: GameWorld, intents: Intents): void {\n  const entity = activityOf(w);\n  const flow = flowOf(w);\n  if (!entity) {\n    readSeats(w, intents, null, null);\n    return;\n  }\n  const a = entity.activity;\n  if (flow.mode !== 'event') {\n    readSeats(w, intents, null, null);\n    return;\n  }\n  const mod = ACTIVITIES[a.id];\n  readSeats(w, intents, mod, a);\n  a.t += 1;\n  a.pt += 1;\n  if (mod.wobble) for (const e of liveSeats(w)) if (e.wobble.on) stepWobble(w, e.seat, e.wobble as Wobble);\n  const c = contextOf(w, mod, a);\n  mod.step(c);\n  if (a.done) finishActivity(w, entity.activity);\n}\n\n/** The score, the rank, the pebbles; flow to results. */\nexport function finishActivity(w: GameWorld, a: ActivityData): void {\n  const mod = ACTIVITIES[a.id];\n  const c = contextOf(w, mod, a);\n  const flow = flowOf(w);\n  a.score = clampScore(mod.score(c, 0));\n  a.scores = c.seats.map((e) => clampScore(mod.score(c, e.seat.index)));\n  const mult = w.settings.get<number>('game.pebbles.mult');\n  const pebbles = Math.round(pebblesOf(a.score) * mult);\n  const rank = rankOf(a.score);\n  const age = typeof a.data.age === 'number' ? a.data.age : undefined;\n  const ageBefore = flow.ages.length > 0 ? flow.ages[flow.ages.length - 1] : undefined;\n  if (age !== undefined && !flow.attract) flow.ages.push(age);\n  flow.last = { event: a.id, score: a.score, rank, pebbles, ...(age !== undefined ? { age } : {}), ...(ageBefore !== undefined ? { ageBefore } : {}) }; // prettier-ignore\n  if (!flow.attract) {\n    flow.pebbles += pebbles;\n    if (!flow.done.includes(a.id)) flow.done.push(a.id);\n    flow.bests[a.id] = Math.max(flow.bests[a.id] ?? 0, a.score);\n  }\n  flow.mode = 'results';\n  w.emit('results', { event: a.id, score: a.score, rank, pebbles, scores: a.scores });\n  say({ w }, a.score >= 550 ? 'plumb' : 'tare', `results.${rank.toLowerCase()}`);\n}\n\n/** Leaves the results (or an activity, from the pause menu) for the island. */\nexport function leaveActivity(w: GameWorld): void {\n  endActivity(w);\n  const flow = flowOf(w);\n  flow.mode = 'roam';\n  w.emit('activity', { id: flow.event, start: false });\n}\n\n/** Keeps a lean inside the disc, for steering by the CoB. */\nexport const steerTo = holdAt;\nEOF\n","description":"Write stations, scoring, activity kit and flow"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11478,"cache_read_input_tokens":236782,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11478},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"6e72fa5c-05be-48e9-8973-38ce676b51f0","timestamp":"2026-11-05T09:06:18.268Z","request_id":"req_011CgjWmXrVryUfh55piTKXn","wire_tool_inputs":{"toolu_01JYMGdp5bUgzXmsqMasrkgC":{"command":"cat > labs/game/scenes/data/stations.ts <<'EOF'\n/**\n * @file Little Fulcrum's station layout, in metres: x east, z south, island centre at 0, 0. Later content adds rows.\n *\n * Game code, sim-side data.\n *\n * @example\n * STATIONS.plaza.x; // 0\n */\n\n/** A place on the island. */\nexport interface Station {\n  id: string;\n  title: string;\n  x: number;\n  z: number;\n  /** Where a person faces on arrival, rad. */\n  yaw: number;\n  /** Flat ground height, when the station has a flat. */\n  y: number;\n}\n\n/** Height of the island's flat stations, m. */\nexport const FLAT_Y = 8;\n\n/** The stations (PLAN.md section 2). */\nexport const STATIONS: Readonly<Record<string, Station>> = Object.freeze({\n  pier: { id: 'pier', title: 'Ferry Pier', x: 0, z: 94, yaw: Math.PI, y: 3.1 },\n  plaza: { id: 'plaza', title: 'The Plaza', x: 0, z: 34, yaw: 0, y: FLAT_Y },\n  pavilion: { id: 'pavilion', title: 'Pose Pavilion', x: -52, z: 18, yaw: 0, y: FLAT_Y },\n  pond: { id: 'pond', title: 'Still Pond', x: -70, z: -12, yaw: 0, y: 5.4 },\n  annex: { id: 'annex', title: 'The Annex', x: 52, z: 22, yaw: 0, y: FLAT_Y },\n  huts: { id: 'huts', title: 'Guest Huts', x: 64, z: 52, yaw: 0, y: 5.2 },\n  lagoon: { id: 'lagoon', title: 'South-West Lagoon', x: -60, z: 85, yaw: Math.PI / 2, y: 3.4 },\n  terrace: { id: 'terrace', title: 'Sand Terrace', x: 30, z: -48, yaw: 0, y: 8 },\n  cliff: { id: 'cliff', title: 'North Cliff', x: 0, z: -80, yaw: Math.PI, y: 16 },\n  hoopBeach: { id: 'hoopBeach', title: 'Hoop Beach', x: 62, z: 84, yaw: 0, y: 3.4 },\n  lighthouse: { id: 'lighthouse', title: 'Lighthouse', x: 84, z: -60, yaw: 0, y: 4 },\n  eastTerrace: { id: 'eastTerrace', title: 'East Terrace', x: 74, z: 8, yaw: 0, y: 7 },\n  centre: { id: 'centre', title: 'Centre Stone', x: 0, z: 0, yaw: 0, y: 14 },\n});\n\n/** The sea's height, m. */\nexport const SEA_Y = 2;\n\n/** The offset of each of four mats from the pavilion's centre: seat 0 front left, then along. */\nexport const MAT_OFFSETS: readonly (readonly [number, number])[] = [\n  [-4.5, 3],\n  [-1.5, 3],\n  [1.5, 3],\n  [4.5, 3],\n];\n\n/** The Annex's four step platforms and rep mats, as offsets from its centre. */\nexport const ANNEX_OFFSETS: readonly (readonly [number, number])[] = [\n  [-4.5, 3],\n  [-1.5, 3],\n  [1.5, 3],\n  [4.5, 3],\n];\nEOF\ncat > labs/game/scenes/scoring.ts <<'EOF'\n/**\n * @file Scores, ranks, pebbles and the Wobble Age (PLAN.md sections 3 and 5). Pure functions.\n *\n * Game code, sim-side.\n *\n * @example\n * rankOf(760); // 'Serene'\n * wobbleAge(1, 1.3); // 18\n */\n\n/** The ranks from the bottom, each with the score it starts at. */\nexport const RANKS: readonly { name: string; from: number; pebbles: number }[] = [\n  { name: 'Present', from: 0, pebbles: 1 },\n  { name: 'Adequate', from: 300, pebbles: 2 },\n  { name: 'Composed', from: 550, pebbles: 3 },\n  { name: 'Serene', from: 750, pebbles: 4 },\n  { name: 'Unsettling', from: 900, pebbles: 5 },\n];\n\n/** The rank a score earns. */\nexport function rankEntry(score: number): { name: string; from: number; pebbles: number } {\n  let found = RANKS[0];\n  for (const rank of RANKS) if (score >= rank.from) found = rank;\n  return found;\n}\n\n/** The rank's name. */\nexport const rankOf = (score: number): string => rankEntry(score).name;\n\n/** Pebbles a score earns, before the dev multiplier. */\nexport const pebblesOf = (score: number): number => rankEntry(score).pebbles;\n\n/** The Wobble Age for a share `s` in 0 to 1: 18 at best, 82 at worst. */\nexport function wobbleAge(s: number, k: number): number {\n  const clamped = Math.min(1, Math.max(0, s));\n  return Math.round(18 + 64 * Math.pow(1 - clamped, k));\n}\n\n/** A score kept within 0 to 1000 and whole. */\nexport const clampScore = (score: number): number => Math.round(Math.min(1000, Math.max(0, score)));\nEOF\ncat > labs/game/scenes/events/types.ts <<'EOF'\n/**\n * @file The shape every activity shares (PLAN.md section 6): `step` emits sim events; the page turns them into text,\n * sound and HUD. `bot` writes the same seat input a player does: tests, attract mode and dev auto-play use it.\n *\n * Game code, sim-side.\n *\n * @example\n * // const pond: Activity = { id: 'pond', title: 'Still Pond', station: 'pond', map: 'actionMap:balance', ... };\n */\nimport type { ActivityData, Flow, GameWorld, HudData, Seat, Wobble } from '../components';\nimport type { Player } from '../bot/players';\nimport type { Station } from '../data/stations';\n\n/** A seat with its body. */\nexport interface SeatEntity {\n  id: number;\n  seat: Seat;\n  wobble: Wobble;\n}\n\n/** What an activity is handed each call. */\nexport interface Ctx {\n  w: GameWorld;\n  a: ActivityData;\n  flow: Flow;\n  /** The seats in play, seat 0 first. */\n  seats: SeatEntity[];\n  station: Station;\n  /** The ground's height at a place. */\n  ground(x: number, z: number): number;\n  /** Whether this is the small session scene. */\n  round: boolean;\n  /** The activity's HUD, to write. */\n  hud: HudData;\n}\n\n/** An activity. */\nexport interface Activity {\n  id: string;\n  title: string;\n  /** The station it runs at. */\n  station: string;\n  /** The action map the page uses for it. */\n  map: 'actionMap:balance' | 'actionMap:balanceFree';\n  /** The camera shot the page frames it with. */\n  shot: string;\n  /** Whether the Wobble Model steps each seat (false: the activity reads seats directly). */\n  wobble: boolean;\n  /** How many seats it wants by default. */\n  seats?: number;\n  /** Spawns what it needs. */\n  setup(c: Ctx): void;\n  /** One step of its rules, after the seats and bodies stepped. */\n  step(c: Ctx): void;\n  /** Removes what setup did not put in the spawned lists. */\n  teardown?(c: Ctx): void;\n  /** One seat's input for one step, as `player` would press it. */\n  bot(c: Ctx, seat: SeatEntity, player: Player): void;\n  /** Its score for a seat, once done. */\n  score(c: Ctx, index: number): number;\n}\nEOF\ncat > labs/game/scenes/events/kit.ts <<'EOF'\n/**\n * @file What activities share: phases, speech, ring markers, spawning that cleans itself up, and holding people in\n * place. Sim-side; everything spawned through it is listed on the activity, so teardown leaves nothing behind.\n *\n * Game code, sim-side.\n *\n * @example\n * // enter(c, 'hold'); say(c, 'plumb', 'pose.hold');\n */\nimport { removeActor, removeProp, spawnProp, type PropPlacement } from '../../../../engine/sim-api';\nimport type { Cast, GameComponents, GameWorld } from '../components';\nimport type { Ctx } from './types';\n\n/** The steps in `seconds`. */\nexport const steps = (c: { w: GameWorld }, seconds: number): number => Math.round(seconds * c.w.hz);\n\n/** Moves the activity to a phase. */\nexport function enter(c: Ctx, phase: string): void {\n  c.a.phase = phase;\n  c.a.pt = 0;\n  c.w.emit('phase', { event: c.a.id, phase });\n}\n\n/** Whether `seconds` have passed in this phase. */\nexport const after = (c: Ctx, seconds: number): boolean => c.a.pt >= steps(c, seconds);\n\n/** Asks the page to say a line: `who` a cast id, `line` a line group's id. */\nexport function say(c: { w: GameWorld }, who: string, line: string): void {\n  c.w.emit('say', { who, line, n: c.w.tick });\n}\n\n/** Spawns a prop for this activity; teardown removes it. */\nexport function propFor(c: Ctx, placement: PropPlacement): number {\n  const id = spawnProp(c.w, placement);\n  c.a.spawned.push(id);\n  return id;\n}\n\n/** Spawns a plain entity for this activity; teardown removes it. */\nexport function entityFor(c: Ctx, spec: Partial<GameComponents>): number {\n  const id = c.w.spawn(spec);\n  c.a.spawned.push(id);\n  return id;\n}\n\n/** Removes everything this activity spawned. */\nexport function clearSpawned(c: Ctx): void {\n  for (const id of c.a.spawned) {\n    const e = c.w.get(id);\n    if (!e) continue;\n    if (e.sceneProp) removeProp(c.w, id);\n    else c.w.despawn(id);\n  }\n  for (const id of c.a.actors) if (c.w.get(id)) removeActor(c.w, id);\n  c.a.spawned = [];\n  c.a.actors = [];\n}\n\n/** The named person's entity. */\nexport function castOf(w: GameWorld, who: string): { id: number; cast: Cast } | undefined {\n  return w.query('cast').find((e) => e.cast.who === who);\n}\n\n/** Holds a named person at a place until released. */\nexport function hold(w: GameWorld, who: string, x: number, y: number, z: number, yaw: number): void {\n  const e = castOf(w, who);\n  if (!e) return;\n  Object.assign(e.cast, { hold: true, x, y, z, yaw });\n}\n\n/** Lets a named person walk again. */\nexport function release(w: GameWorld, who: string): void {\n  const e = castOf(w, who);\n  if (e) Object.assign(e.cast, { hold: false, pose: '', poseT: 0, leanX: 0, leanY: 0 });\n}\n\n/** Sets the pose strip a person scrubs, and how far along it is. */\nexport function pose(w: GameWorld, who: string, name: string, t: number, leanX = 0, leanY = 0): void {\n  const e = castOf(w, who);\n  if (e) Object.assign(e.cast, { pose: name, poseT: t, leanX, leanY });\n}\n\n/** A marker for HUD text: a score as text. */\nexport const pct = (v: number): string => `${Math.round(v * 100)}%`;\nEOF\ncat > labs/game/scenes/flow.ts <<'EOF'\n/**\n * @file The flow of the game on one world (the one-scene rule, PLAN.md section 14): starting an activity, stepping it,\n * its results, leaving it, and the days. It owns the `activity` entity and the seats' use.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'pond'); // from an action or the director\n */\nimport { held, pressed, terrainHeight, type Intents, type Terrain } from '../../../engine/sim-api';\nimport type { ActivityData, Flow, GameWorld, IslandData, Seat, Wobble } from './components';\nimport { holdAt, mash, playerOf, type Player } from './bot/players';\nimport { STATIONS, type Station } from './data/stations';\nimport { ACTIVITIES } from './events/index';\nimport { clearSpawned, say } from './events/kit';\nimport type { Activity, Ctx, SeatEntity } from './events/types';\nimport { clampScore, pebblesOf, rankOf } from './scoring';\nimport { resetWobble, stepWobble } from './wobble';\n\n/** What differs between the island and the round scene. */\nexport interface FlowHost {\n  round: boolean;\n  terrain: Terrain | null;\n  floorY: number;\n  /** A station to use whichever one the activity names (the round: the pavilion). */\n  station?: string;\n}\n\n/** The world's host, per world: held in module state keyed by the world, never read for play beyond its constants. */\nconst HOSTS = new WeakMap<object, FlowHost>();\n\n/** Remembers what kind of world this is. */\nexport function setHost(w: GameWorld, host: FlowHost): void {\n  HOSTS.set(w, host);\n}\n\n/** The world's host. */\nexport const hostOf = (w: GameWorld): FlowHost => HOSTS.get(w) ?? { round: false, terrain: null, floorY: 0 };\n\n/** The ground at a place, in this world. */\nexport function groundAt(w: GameWorld, x: number, z: number): number {\n  const host = hostOf(w);\n  if (!host.terrain) return host.floorY;\n  return terrainHeight(host.terrain, x, z) ?? host.floorY;\n}\n\n/** The world's flow. */\nexport const flowOf = (w: GameWorld): Flow => w.query('flow')[0].flow;\n\n/** The world's island state. */\nexport const islandOf = (w: GameWorld): IslandData => w.query('island')[0].island;\n\n/** The running activity's entity, if any. */\nexport function activityOf(w: GameWorld): { id: number; activity: ActivityData } | undefined {\n  return w.query('activity')[0];\n}\n\n/** Every seat with its body, in seat order. */\nexport function allSeats(w: GameWorld): SeatEntity[] {\n  return w.query('seat', 'wobble') as unknown as SeatEntity[];\n}\n\n/** The seats in play. */\nexport const liveSeats = (w: GameWorld): SeatEntity[] => allSeats(w).filter((e) => e.seat.kind !== 'off');\n\n/** An activity's context for this world. */\nexport function contextOf(w: GameWorld, mod: Activity, a: ActivityData): Ctx {\n  const host = hostOf(w);\n  const station: Station = STATIONS[host.station ?? mod.station] ?? STATIONS.plaza;\n  return {\n    w,\n    a,\n    flow: flowOf(w),\n    seats: liveSeats(w),\n    station,\n    ground: (x, z) => groundAt(w, x, z),\n    round: host.round,\n    hud: a.hud,\n  };\n}\n\n/** How a seat takes part, for an activity's start. */\nexport interface SeatUse {\n  kind: Seat['kind'];\n  skill?: string;\n  sway?: number;\n}\n\n/** Starts an activity: the seats, its setup, the flow. Any activity running is ended first. */\nexport function startActivity(\n  w: GameWorld,\n  id: string,\n  options: { short?: boolean; seats?: readonly SeatUse[]; data?: Record<string, unknown> } = {},\n): void {\n  const mod = ACTIVITIES[id];\n  if (!mod) throw new Error(`no activity \"${id}\"`);\n  endActivity(w);\n  const flow = flowOf(w);\n  const uses = options.seats ?? [{ kind: 'local' as const }];\n  for (const e of allSeats(w)) {\n    const use = uses[e.seat.index];\n    e.seat.kind = use?.kind ?? 'off';\n    e.seat.skill = use?.skill ?? '';\n    e.seat.sway = use?.sway ?? 1;\n    Object.assign(e.seat, { lx: 0, ly: 0, fl: 0, fr: 0, act: false, actP: false, pfl: false, pfr: false, hist: [], mem: {} });\n    resetWobble(e.wobble);\n    e.wobble.on = e.seat.kind !== 'off';\n  }\n  const a: ActivityData = { id, short: options.short ?? false, phase: '', t: 0, pt: 0, done: false, score: 0, scores: [], data: options.data ?? {}, hud: {}, spawned: [], actors: [] }; // prettier-ignore\n  const entity = w.spawn({ activity: a });\n  const live = w.get(entity)?.activity as ActivityData | undefined;\n  const held2 = live ?? a;\n  flow.mode = 'event';\n  flow.event = id;\n  flow.focus = -1;\n  if (!flow.seen.includes(id)) flow.seen.push(id);\n  mod.setup(contextOf(w, mod, held2));\n  w.emit('activity', { id, start: true });\n}\n\n/** Takes the running activity away: teardown, and its entity. */\nexport function endActivity(w: GameWorld): void {\n  for (const entity of w.query('activity')) {\n    const a = entity.activity;\n    const mod = ACTIVITIES[a.id];\n    const c = contextOf(w, mod, a);\n    mod.teardown?.(c);\n    clearSpawned(c);\n    w.despawn(entity.id);\n  }\n  for (const e of allSeats(w)) {\n    e.seat.kind = e.seat.index === 0 ? 'local' : 'off';\n    e.wobble.on = false;\n  }\n}\n\n/** Reads the page's intents into the seats: seat 0 from the action map, the others from `game:seats`. */\nexport function readSeats(w: GameWorld, intents: Intents, mod: Activity | null, a: ActivityData | null): void {\n  const flow = flowOf(w);\n  const seats = allSeats(w);\n  const auto = w.settings.get<boolean>('game.auto') || flow.attract;\n  const local = intents as unknown as Record<string, unknown>;\n  const num = (key: string): number => {\n    const v = local[key];\n    return typeof v === 'number' ? v : 0;\n  };\n  const group = local['game:seats'];\n  const c = mod && a ? contextOf(w, mod, a) : null;\n  for (const e of seats) {\n    const { seat } = e;\n    const before = { l: seat.fl >= 0.5, r: seat.fr >= 0.5, a: seat.act };\n    seat.mx = seat.my = seat.moved = 0;\n    seat.pointer = false;\n    if (seat.kind === 'off') continue;\n    const useBot = seat.kind === 'cpu' || (seat.index === 0 && auto);\n    if (useBot && c && mod) {\n      const name = seat.kind === 'cpu' ? seat.skill || 'human' : flow.attract ? 'perfect' : w.settings.get<string>('game.skill'); // prettier-ignore\n      const player: Player = playerOf(name);\n      if (name === 'mash') mash(w, seat);\n      else mod.bot(c, e, player);\n    } else if (seat.index === 0 && !Array.isArray(group)) {\n      seat.lx = num('game:r') - num('game:l');\n      seat.ly = num('game:f') - num('game:b');\n      seat.fl = num('game:fl');\n      seat.fr = num('game:fr');\n      seat.gentle = held(intents, 'gentle');\n      seat.act = held(intents, 'act');\n      const mouse = local['game:mouse'];\n      if (Array.isArray(mouse)) {\n        seat.mx = Number(mouse[0]) || 0;\n        seat.my = Number(mouse[1]) || 0;\n        seat.moved = Math.hypot(seat.mx, seat.my);\n      }\n      const point = local['game:pointer'];\n      if (Array.isArray(point) && point[2]) {\n        seat.px = Number(point[0]) || 0;\n        seat.py = Number(point[1]) || 0;\n        seat.pointer = true;\n      }\n      if (pressed(intents, 'act')) before.a = false;\n    } else if (Array.isArray(group)) {\n      const at = seat.index * 5;\n      seat.lx = Number(group[at]) || 0;\n      seat.ly = Number(group[at + 1]) || 0;\n      seat.fl = Number(group[at + 2]) || 0;\n      seat.fr = Number(group[at + 3]) || 0;\n      seat.act = Boolean(group[at + 4]);\n    } else {\n      Object.assign(seat, { lx: 0, ly: 0, fl: 0, fr: 0, act: false });\n    }\n    seat.pfl = seat.fl >= 0.5 && !before.l;\n    seat.pfr = seat.fr >= 0.5 && !before.r;\n    seat.actP = seat.act && !before.a;\n  }\n}\n\n/** One step of the running activity: seats read, bodies stepped, its rules, its end. */\nexport function stepActivity(w: GameWorld, intents: Intents): void {\n  const entity = activityOf(w);\n  const flow = flowOf(w);\n  if (!entity) {\n    readSeats(w, intents, null, null);\n    return;\n  }\n  const a = entity.activity;\n  if (flow.mode !== 'event') {\n    readSeats(w, intents, null, null);\n    return;\n  }\n  const mod = ACTIVITIES[a.id];\n  readSeats(w, intents, mod, a);\n  a.t += 1;\n  a.pt += 1;\n  if (mod.wobble) for (const e of liveSeats(w)) if (e.wobble.on) stepWobble(w, e.seat, e.wobble as Wobble);\n  const c = contextOf(w, mod, a);\n  mod.step(c);\n  if (a.done) finishActivity(w, entity.activity);\n}\n\n/** The score, the rank, the pebbles; flow to results. */\nexport function finishActivity(w: GameWorld, a: ActivityData): void {\n  const mod = ACTIVITIES[a.id];\n  const c = contextOf(w, mod, a);\n  const flow = flowOf(w);\n  a.score = clampScore(mod.score(c, 0));\n  a.scores = c.seats.map((e) => clampScore(mod.score(c, e.seat.index)));\n  const mult = w.settings.get<number>('game.pebbles.mult');\n  const pebbles = Math.round(pebblesOf(a.score) * mult);\n  const rank = rankOf(a.score);\n  const age = typeof a.data.age === 'number' ? a.data.age : undefined;\n  const ageBefore = flow.ages.length > 0 ? flow.ages[flow.ages.length - 1] : undefined;\n  if (age !== undefined && !flow.attract) flow.ages.push(age);\n  flow.last = { event: a.id, score: a.score, rank, pebbles, ...(age !== undefined ? { age } : {}), ...(ageBefore !== undefined ? { ageBefore } : {}) }; // prettier-ignore\n  if (!flow.attract) {\n    flow.pebbles += pebbles;\n    if (!flow.done.includes(a.id)) flow.done.push(a.id);\n    flow.bests[a.id] = Math.max(flow.bests[a.id] ?? 0, a.score);\n  }\n  flow.mode = 'results';\n  w.emit('results', { event: a.id, score: a.score, rank, pebbles, scores: a.scores });\n  say({ w }, a.score >= 550 ? 'plumb' : 'tare', `results.${rank.toLowerCase()}`);\n}\n\n/** Leaves the results (or an activity, from the pause menu) for the island. */\nexport function leaveActivity(w: GameWorld): void {\n  endActivity(w);\n  const flow = flowOf(w);\n  flow.mode = 'roam';\n  w.emit('activity', { id: flow.event, start: false });\n}\n\n/** Keeps a lean inside the disc, for steering by the CoB. */\nexport const steerTo = holdAt;\nEOF\n","description":"Write stations, scoring, activity kit and flow"}}}
