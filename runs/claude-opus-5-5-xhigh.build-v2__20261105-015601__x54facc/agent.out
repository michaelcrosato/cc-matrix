{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjaAvCQBaqQLJPGANJPn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019ToRJXjVB34FzUmS951U27","name":"Bash","input":{"command":"python3 - <<'EOF'\np='labs/game/scenes/events/hoop.ts'\ns=open(p).read()\ns=s.replace(\"player.name === 'human' ? 0.8 : 3.2;\",\"player.name === 'human' ? 0.8 : 2.4;\")\nopen(p,'w').write(s)\np='labs/game/scenes/terrain.ts'\ns=open(p).read()\ns=s.replace(\"{ at: [0, -92], radius: 24, height: 5 },\",\"{ at: [0, -82], radius: 18, height: 5 },\\n    { at: [0, -106], radius: 26, height: -9 },\")\ns=s.replace(\"flat('cliff', 7, 16, 8),\",\"flat('cliff', 7, 16, 5),\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/plunge.ts'\ns=open(p).read()\ns=s.replace(\"const lipZ = z - 3.6;\",\"const lipZ = z - 8.6;\")\ns=s.replace(\"d.z -= (d.slip ? 2.2 : 3.2 + d.q * 2.2) * c.w.dt;\",\"d.z -= (d.slip ? 3 : 4.6 + d.q * 2.2) * c.w.dt;\")\ns=s.replace(\"propFor(c, { prop: 'prop:diveLip', at: [x, lipY - 0.14, z - 6], yaw: Math.PI });\",\"propFor(c, { prop: 'prop:diveLip', at: [x, lipY - 0.14, z - 6.4], yaw: Math.PI });\")\ns=s.replace(\"const [gx, gz] = [x - 8 + g * 2.2, z - 26];\",\"const [gx, gz] = [x - 11 + g * 2.2, z - 24];\")\nopen(p,'w').write(s)\np='labs/game/cast/roster.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    if (c.hold) placeActor(w, e.id, [c.x, c.y, c.z], c.yaw);\"\"\",\"\"\"    if (!c.hold) continue;\n    try {\n      placeActor(w, e.id, [c.x, c.y, c.z], c.yaw);\n    } catch {\n      // A place under the ground, a moment's fall through a cliff face: they stay where they were this step.\n      e.actor.yaw = c.yaw;\n    }\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/events/jog.ts <<'EOF'\n/**\n * @file Island Jog (PLAN.md section 6): follow Gerald round the coast path, a ring of flags past every landmark. The stick\n * steers; alternating feet at about 2.5 Hz gives +35% speed. Stay within 8 m of him: the Pace Ribbon. Tare hops beside you\n * and talks, the plaques go by. At the end Gerald says the longest thing he will ever say.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'jog');\n */\nimport { createCharacter, placeActor } from '../../../../engine/sim-api';\nimport { holdAt, type Player } from '../bot/players';\nimport { COAST } from '../data/courses';\nimport { castOf, enter, isBot, leanForWorld, propFor, say, steps, worldFromLean } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** The ribbon's reach, m; how long the path may take, s; how close a flag counts, m. */\nconst RIBBON = 8;\nconst LENGTH = 170;\nconst FLAG_REACH = 3.2;\n\n/** The jog's state. */\ninterface JogData {\n  flag: number;\n  inside: number;\n  total: number;\n  stuck: number;\n  lastX: number;\n  lastZ: number;\n  boost: number;\n  lastFoot: string;\n  footT: number;\n  fast: boolean;\n  talk: number;\n  gap: number;\n}\n\n/** Island Jog. */\nexport const jog: Activity = {\n  id: 'jog',\n  title: 'Island Jog',\n  station: 'plaza',\n  map: 'actionMap:balance',\n  shot: 'jog',\n  wobble: false,\n  setup(c) {\n    const d: JogData = { flag: 0, inside: 0, total: 0, stuck: 0, lastX: 0, lastZ: 0, boost: 0, lastFoot: '', footT: 999, fast: false, talk: steps(c, 6), gap: 0 };\n    c.a.data = d as unknown as Record<string, unknown>;\n    COAST.forEach(([x, z]) => propFor(c, { prop: 'prop:lineFlag', at: [x, c.ground(x, z), z], yaw: 0 }));\n    const speed = c.w.settings.get<number>('game.jog.speed');\n    const guest = castOf(c.w, 'guest');\n    const gerald = castOf(c.w, 'gerald');\n    const [x, z] = [COAST[0][0] - 2, COAST[0][1] - 8];\n    if (guest) {\n      Object.assign(guest.cast, { hold: false, pose: '', poseT: 0 });\n      placeActor(c.w, guest.id, [x, c.ground(x, z), z], 0.2);\n      const actor = c.w.get(guest.id)?.actor;\n      if (actor) actor.character = createCharacter({ speed, jumpSpeed: 6.5 });\n    }\n    if (gerald) {\n      Object.assign(gerald.cast, { hold: false, pose: '', poseT: 0 });\n      placeActor(c.w, gerald.id, [x + 2, c.ground(x + 2, z + 3), z + 3], 0.2);\n      const actor = c.w.get(gerald.id)?.actor;\n      if (actor) actor.character = createCharacter({ speed: speed * 0.8, jumpSpeed: 6 });\n    }\n    c.hud.title = 'Island Jog';\n    c.hud.feet = true;\n    enter(c, 'jog');\n    say(c, 'gerald', 'jog.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as JogData;\n    const [{ seat }] = c.seats;\n    const guest = castOf(c.w, 'guest');\n    const gerald = castOf(c.w, 'gerald');\n    const me = guest ? c.w.get(guest.id)?.actor : undefined;\n    const him = gerald ? c.w.get(gerald.id)?.actor : undefined;\n    if (!me || !him) {\n      c.a.done = true;\n      return;\n    }\n    const base = c.w.settings.get<number>('game.jog.speed');\n    // Feet alternating at about 2.5 Hz: +35%.\n    d.footT += 1;\n    const foot = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n    if (foot && foot !== d.lastFoot) {\n      if (d.footT < c.w.hz * 0.6) d.boost = Math.min(1, d.boost + 0.4);\n      d.footT = 0;\n      d.lastFoot = foot;\n    }\n    d.boost = Math.max(0, d.boost - c.w.dt * 0.8);\n    const fast = d.boost > 0.3;\n    if (fast !== d.fast) {\n      d.fast = fast;\n      me.character = createCharacter({ speed: base * (fast ? 1.35 : 1), jumpSpeed: 6.5 });\n      c.w.emit('jogBoost', { fast });\n    }\n    // Your move, by the stick, from where the camera looks.\n    const cam = isBot(c, seat.index) ? 0 : c.flow.camYaw;\n    const [mx, mz] = worldFromLean(seat.lx, seat.ly, cam);\n    me.intents = { move: [mx, mz] };\n    // Gerald goes flag to flag and does not look back.\n    const [fx, fz] = COAST[Math.min(d.flag, COAST.length - 1)];\n    const [dx, dz] = [fx - him.x, fz - him.z];\n    const dist = Math.hypot(dx, dz);\n    him.intents = dist > 0.1 ? { move: [dx / dist, dz / dist] } : {};\n    if (dist < FLAG_REACH) {\n      d.flag += 1;\n      c.w.emit('jogFlag', { flag: d.flag });\n    }\n    if (c.a.t % 60 === 0) {\n      if (Math.hypot(him.x - d.lastX, him.z - d.lastZ) < 1 && c.a.t > 0) {\n        d.stuck += 1;\n        if (d.stuck >= 2) placeActor(c.w, gerald!.id, [fx, c.ground(fx, fz), fz], him.yaw);\n      } else d.stuck = 0;\n      [d.lastX, d.lastZ] = [him.x, him.z];\n    }\n    // The Pace Ribbon.\n    d.gap = Math.hypot(me.x - him.x, me.z - him.z);\n    d.total += 1;\n    if (d.gap <= RIBBON) d.inside += 1;\n    // Tare hops beside you, and talks.\n    const tare = castOf(c.w, 'tare');\n    if (tare) tare.cast.home = [me.x + 1.6, me.z + 1.3];\n    d.talk -= 1;\n    if (d.talk <= 0) {\n      d.talk = steps(c, 14);\n      say(c, 'tare', 'jog.chatter');\n    }\n    c.hud.show = { gap: d.gap, ribbon: RIBBON, inRibbon: d.gap <= RIBBON, flags: d.flag, of: COAST.length, fast };\n    c.hud.meter = d.flag / COAST.length;\n    c.hud.meterLabel = d.gap <= RIBBON ? 'In the ribbon' : 'Catch Gerald';\n    if (d.flag >= COAST.length || c.a.t >= steps(c, LENGTH)) {\n      say(c, 'gerald', 'jog.end');\n      c.a.done = true;\n    }\n  },\n  teardown(c) {\n    const speed = 5.4;\n    const guest = castOf(c.w, 'guest');\n    const actor = guest ? c.w.get(guest.id)?.actor : undefined;\n    if (actor) {\n      actor.character = createCharacter({ speed, jumpSpeed: 6.5 });\n      actor.intents = {};\n    }\n    const gerald = castOf(c.w, 'gerald');\n    const his = gerald ? c.w.get(gerald.id)?.actor : undefined;\n    if (his) {\n      his.character = createCharacter({ speed: 3.6, jumpSpeed: 6.5 });\n      his.intents = {};\n    }\n  },\n  bot(c, e, player: Player) {\n    const { seat, wobble } = e;\n    seat.act = false;\n    if (!player.acts) {\n      Object.assign(seat, { lx: 0, ly: 0, fl: 0, fr: 0 });\n      return;\n    }\n    const guest = castOf(c.w, 'guest');\n    const gerald = castOf(c.w, 'gerald');\n    const me = guest ? c.w.get(guest.id)?.actor : undefined;\n    const him = gerald ? c.w.get(gerald.id)?.actor : undefined;\n    if (!me || !him) return;\n    const [dx, dz] = [him.x - me.x, him.z - me.z];\n    const dist = Math.hypot(dx, dz) || 1;\n    const go = dist > 2.5 ? 1 : 0.4;\n    const late = player.name === 'perfect' ? 0 : player.name === 'human' ? 0.08 : 0.18;\n    const [lx, ly] = leanForWorld((dx / dist) * go, (dz / dist) * go);\n    seat.lx = lx + late * Math.sin(c.a.t * 0.05);\n    seat.ly = ly;\n    holdAt;\n    void wobble;\n    const cycle = player.name === 'sloppy' ? 40 : 22;\n    const t = c.a.t % cycle;\n    const left = Math.floor(c.a.t / cycle) % 2 === 0;\n    const hurry = dist > 4;\n    seat.fl = hurry && left && t < 6 ? 1 : 0;\n    seat.fr = hurry && !left && t < 6 ? 1 : 0;\n  },\n  score(c) {\n    const d = c.a.data as unknown as JogData;\n    return d.total ? (1000 * d.inside) / d.total : 0;\n  },\n};\nEOF\ncat > labs/game/scenes/data/guests.ts <<'EOF'\n/**\n * @file The twelve guests of the Great Tilt: who they are and where the storm finds them. Gerald, Bex and Nan are the named\n * cast; the rest are crowd bodies in the engine's own builds.\n *\n * Game code, sim-side data.\n *\n * @example\n * TILT_GUESTS.length; // 12\n */\n\n/** A guest in the finale. */\nexport interface TiltGuest {\n  name: string;\n  x: number;\n  z: number;\n  build: string;\n}\n\n/** The guests. */\nexport const TILT_GUESTS: readonly TiltGuest[] = [\n  { name: 'gerald', x: 10, z: 26, build: '' },\n  { name: 'bex', x: -6, z: 22, build: '' },\n  { name: 'nan', x: 2, z: 44, build: '' },\n  { name: 'guest', x: -14, z: 30, build: 'build:guest0' },\n  { name: 'guest', x: -20, z: 40, build: 'build:guest1' },\n  { name: 'guest', x: 16, z: 40, build: 'build:guest2' },\n  { name: 'guest', x: 22, z: 30, build: 'build:guest0' },\n  { name: 'guest', x: -30, z: 24, build: 'build:guest1' },\n  { name: 'guest', x: -26, z: 10, build: 'build:guest2' },\n  { name: 'guest', x: 32, z: 14, build: 'build:guest1' },\n  { name: 'guest', x: 8, z: 12, build: 'build:guest0' },\n  { name: 'guest', x: -10, z: 6, build: 'build:guest2' },\n];\nEOF\ncat > labs/game/scenes/events/tilt.ts <<'EOF'\n/**\n * @file The Great Tilt (PLAN.md section 7): the finale, using every verb at the scale of the world. Storm; Everyone East;\n * Counterweights; the Centre Stone, where your CoB is the island's tilt; Dawn. There is no fail state, only remarks, and\n * every step is time boxed. The island's geometry never moves: walkers get a slope push, the camera banks, the sea\n * counter-rotates.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'tilt');\n */\nimport { placeActor, stepCrowdBody } from '../../../../engine/sim-api';\nimport { breathe, holdAt, type Player } from '../bot/players';\nimport { FLAT_Y, STATIONS } from '../data/stations';\nimport { TILT_GUESTS } from '../data/guests';\nimport { bothFeet, inRing } from '../wobble';\nimport { after, castOf, enter, entityFor, floorShape, isBot, leanForWorld, moveProp, propFor, say, steps, worldFromLean } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** Seconds of each step (PLAN.md section 7). */\nconst STORM = 20;\nconst EAST = 75;\nconst WEIGHTS = 45;\nconst STONE = 60;\nconst DAWN = 16;\n/** The Calm Call: how long it takes to charge, how far it reaches, how long they follow. */\nconst CALL_CHARGE = 2;\nconst CALL_REACH = 8;\nconst FOLLOW = 12;\n/** The East Terrace's radius. */\nconst TERRACE = 8;\n\n/** A guest in the finale. */\ninterface Walker {\n  x: number;\n  z: number;\n  body: number;\n  named: string;\n  following: number;\n  delivered: boolean;\n}\n\n/** The finale's state. */\ninterface TiltData {\n  walkers: Walker[];\n  delivered: number;\n  charge: number;\n  wave: number;\n  waveT: number;\n  loungers: number[];\n  cartProp: number[];\n  carts: number[];\n  cartFoot: string;\n  wavePhase: number;\n  stoneIn: number;\n  stoneTotal: number;\n  syncSum: number;\n  ringR: number;\n  lurches: number;\n  beam: number;\n  attract: boolean;\n  remark: number;\n  eyes: boolean;\n}\n\n/** Spawns the guests and the storm's props. */\nfunction setOut(c: Ctx, d: TiltData): void {\n  TILT_GUESTS.forEach((g) => {\n    const y = c.ground(g.x, g.z);\n    if (g.name === 'guest') {\n      const body = entityFor(c, { crowdBody: { rig: 'humanoid', look: g.build, size: 0, x: g.x, y, z: g.z, yaw: 1.5, state: {} } as never });\n      d.walkers.push({ x: g.x, z: g.z, body, named: '', following: 0, delivered: false });\n    } else {\n      const person = castOf(c.w, g.name);\n      if (person) {\n        placeActor(c.w, person.id, [g.x, y, g.z], 1.5);\n        Object.assign(person.cast, { hold: false, pose: '', poseT: 0 });\n      }\n      d.walkers.push({ x: g.x, z: g.z, body: person?.id ?? -1, named: g.name, following: 0, delivered: false });\n    }\n  });\n  for (let i = 0; i < 6; i++) {\n    const [lx, lz] = [20 + i * 7, 8 + (i % 3) * 7];\n    d.loungers.push(propFor(c, { prop: 'prop:lounger', at: [lx, c.ground(lx, lz), lz], yaw: 1.5 }));\n  }\n  d.beam = propFor(c, { prop: 'prop:beam', at: [0, -40, 0], yaw: 0 });\n}\n\n/** Moves the finale's guests a step. They drift downhill politely unless called, and Nan is already there. */\nfunction stepWalkers(c: Ctx, d: TiltData, ghx: number, ghz: number): void {\n  const isl = c.w.query('island')[0].island;\n  const { x: tx, z: tz } = STATIONS.eastTerrace;\n  const push = -isl.tiltX * 0.09;\n  const lateShuffle = c.a.phase !== 'east';\n  d.walkers.forEach((g) => {\n    if (g.delivered && !lateShuffle) return;\n    let [vx, vz] = [-push, 0.12 * Math.sin(c.a.t * 0.01 + g.x)];\n    if (g.named === 'nan' && !g.delivered) {\n      // Nan walks up on her own and is already there.\n      const [dx, dz] = [tx - g.x, tz - g.z];\n      const r = Math.hypot(dx, dz) || 1;\n      vx = (dx / r) * 2.2;\n      vz = (dz / r) * 2.2;\n    } else if (g.following > 0) {\n      g.following -= 1;\n      const [dx, dz] = [ghx - g.x, ghz - g.z];\n      const r = Math.hypot(dx, dz) || 1;\n      const speed = r > 2 ? 3.6 : 0.6;\n      vx = (dx / r) * speed - push * 0.3;\n      vz = (dz / r) * speed;\n    } else if (lateShuffle && !g.delivered) {\n      const [dx, dz] = [tx - g.x, tz - g.z];\n      const r = Math.hypot(dx, dz) || 1;\n      vx = (dx / r) * 3;\n      vz = (dz / r) * 3;\n    } else if (g.delivered) {\n      vx = vz = 0;\n    }\n    g.x = Math.max(-92, Math.min(95, g.x + vx * c.w.dt));\n    g.z = Math.max(-80, Math.min(85, g.z + vz * c.w.dt));\n    const y = c.ground(g.x, g.z);\n    if (g.named) {\n      const person = castOf(c.w, g.named);\n      if (person) {\n        Object.assign(person.cast, { hold: true, x: g.x, y, z: g.z, yaw: Math.atan2(vx, vz) });\n        const actor = c.w.get(person.id)?.actor;\n        if (actor) actor.intents = {};\n      }\n    } else {\n      const body = c.w.get(g.body)?.crowdBody;\n      if (body) stepCrowdBody(c.w, g.body, body, { at: [g.x, y, g.z], velocity: [vx, 0, vz], yaw: Math.atan2(vx, vz) });\n    }\n    if (!g.delivered && Math.hypot(g.x - tx, g.z - tz) < TERRACE) {\n      g.delivered = true;\n      d.delivered += 1;\n      isl.tiltX = Math.min(-0.5, isl.tiltX + 0.5);\n      c.w.emit('guestDelivered', { n: d.delivered, named: g.named });\n      if (g.named === 'nan') say(c, 'nan', 'tilt.nan');\n    }\n  });\n}\n\n/** Puts the player on their feet at a place, walking. */\nfunction freeGuest(c: Ctx, x: number, z: number): void {\n  const guest = castOf(c.w, 'guest');\n  if (!guest) return;\n  Object.assign(guest.cast, { hold: false, pose: '', poseT: 0 });\n  placeActor(c.w, guest.id, [x, c.ground(x, z), z], 1.5);\n}\n\n/** The Great Tilt. */\nexport const tilt: Activity = {\n  id: 'tilt',\n  title: 'The Great Tilt',\n  station: 'plaza',\n  map: 'actionMap:balance',\n  shot: 'tilt',\n  wobble: true,\n  setup(c) {\n    const attract = Boolean((c.a.data as { attract?: boolean }).attract);\n    const d: TiltData = { walkers: [], delivered: 0, charge: 0, wave: -1, waveT: 0, loungers: [], cartProp: [], carts: [0, 0], cartFoot: '', wavePhase: 0, stoneIn: 0, stoneTotal: 0, syncSum: 0, ringR: 0.5, lurches: 0, beam: -1, attract, remark: 0, eyes: false }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    const isl = c.w.query('island')[0].island;\n    Object.assign(isl, { tiltX: -6, tiltZ: 0, storm: 1, sky: 'storm' });\n    d.wave = floorShape(c, '', 0, c.station.y, 0, 0.1);\n    setOut(c, d);\n    const plumb = castOf(c.w, 'plumb');\n    if (plumb) Object.assign(plumb.cast, { hold: true, x: 2, y: c.ground(2, 26), z: 26, yaw: 0, pose: 'Upright', poseT: 1 });\n    freeGuest(c, 0, 32);\n    c.hud.title = 'The Great Tilt';\n    c.hud.disc = false;\n    enter(c, 'storm');\n    c.w.emit('storm', { on: true });\n    c.w.emit('cutscene', { id: 'plait' });\n    if (attract) enter(c, 'stone');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as TiltData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const isl = c.w.query('island')[0].island;\n    const guest = castOf(c.w, 'guest');\n    const me = guest ? c.w.get(guest.id)?.actor : undefined;\n    const rate = c.w.settings.get<number>('game.tilt.rate');\n    const forced = Boolean((c.a.data as { jumped?: boolean }).jumped);\n    if (forced) (c.a.data as { jumped?: boolean }).jumped = false;\n    // The loungers slide through, whatever the phase.\n    if (c.a.phase === 'east' || c.a.phase === 'storm') {\n      d.loungers.forEach((id, i) => {\n        const e = c.w.get(id)?.sceneProp;\n        if (!e) return;\n        const nx = e.x - (0.9 + i * 0.06) * -isl.tiltX * 0.25 * c.w.dt;\n        const wrap = nx < -50 ? 60 : nx;\n        moveProp(c.w, id, wrap, c.ground(wrap, e.z), e.z, 1.5 + Math.sin(c.a.t * 0.02 + i) * 0.2);\n      });\n    }\n    switch (c.a.phase) {\n      case 'storm':\n        wob.on = false;\n        if (c.a.pt === steps(c, 6)) {\n          say(c, 'pa', 'tilt.outOfTrue');\n          c.w.emit('ferryHorn', {});\n        }\n        if (c.a.pt === steps(c, 14)) c.w.emit('thunder', {});\n        if (seat.actP && c.a.pt > 60) enter(c, 'east');\n        else if (after(c, STORM)) {\n          say(c, 'pa', 'tilt.east');\n          enter(c, 'east');\n        }\n        c.hud.prompt = 'skip';\n        break;\n      case 'east': {\n        c.hud.prompt = '';\n        wob.on = false;\n        if (me) {\n          const cam = isBot(c, seat.index) ? 0 : c.flow.camYaw;\n          const [mx, mz] = worldFromLean(seat.lx, seat.ly, cam);\n          me.intents = { move: [mx - isl.tiltX * 0.055, mz] };\n          const calling = bothFeet(seat);\n          d.charge = calling ? Math.min(1, d.charge + c.w.dt / CALL_CHARGE) : d.charge;\n          if (!calling && d.charge >= 1) {\n            d.charge = 0;\n            d.waveT = steps(c, 1.4);\n            let n = 0;\n            for (const g of d.walkers) {\n              if (!g.delivered && Math.hypot(g.x - me.x, g.z - me.z) <= CALL_REACH) {\n                g.following = steps(c, FOLLOW);\n                n += 1;\n              }\n            }\n            c.w.emit('calmCall', { n });\n            say(c, 'tare', n > 0 ? 'tilt.calmed' : 'tilt.calmedNobody');\n          } else if (!calling) d.charge = Math.max(0, d.charge - c.w.dt);\n          if (guest) Object.assign(guest.cast, { pose: calling ? 'CalmCall' : '', poseT: d.charge });\n          d.waveT = Math.max(0, d.waveT - 1);\n          const ring = c.w.get(d.wave)?.matRing;\n          if (ring) {\n            ring.telegraph = d.waveT > 0 ? 'telegraph:calmWave' : '';\n            ring.position = [me.x, me.y + 0.1, me.z];\n            ring.size = CALL_REACH * (1 - d.waveT / steps(c, 1.4));\n          }\n          stepWalkers(c, d, me.x, me.z);\n        }\n        isl.tiltX -= rate * c.w.dt;\n        const show: Record<string, unknown> = { delivered: d.delivered, charge: d.charge, followers: d.walkers.filter((g) => g.following > 0).length, tiltDeg: Math.abs(isl.tiltX) };\n        c.hud.show = show;\n        c.hud.meter = 1 - c.a.pt / steps(c, EAST);\n        c.hud.meterLabel = 'Everyone East';\n        if (d.delivered >= d.walkers.length || after(c, EAST)) {\n          if (d.delivered < d.walkers.length) say(c, 'plumb', 'tilt.shuffle');\n          setUpWeights(c, d);\n        }\n        break;\n      }\n      case 'weights': {\n        wob.on = true;\n        wob.usesBreath = false;\n        const { x, z } = STATIONS.eastTerrace;\n        c.hud.disc = true;\n        c.hud.feet = true;\n        c.hud.ring = [0.3, 0, 0.32];\n        stepWalkers(c, d, x, z);\n        const foot = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n        const cart = d.carts[0] < 1 ? 0 : 1;\n        if (foot && foot !== d.cartFoot && inRing(wob, 0.3, 0, 0.4)) {\n          d.cartFoot = foot;\n          d.carts[cart] = Math.min(1, d.carts[cart] + 0.055);\n          c.w.emit('crank', { foot, cart });\n          if (d.carts[cart] >= 1) {\n            isl.tiltX = Math.min(-0.5, isl.tiltX + 1);\n            c.w.emit('cartHome', { cart });\n          }\n        }\n        wob.dx += isl.tiltX * 0.8;\n        d.cartProp.forEach((id, i) => moveProp(c.w, id, x - 22 + d.carts[i] * 16, FLAT_Y - 0.6, z - 8 + i * 4));\n        if (guest) Object.assign(guest.cast, { hold: true, x: x - 19 + d.carts[cart] * 16, y: c.ground(x - 19, z - 8 + cart * 4), z: z - 8 + cart * 4 - 1.4, yaw: 0, pose: 'Crank', poseT: d.carts[cart] * 8, leanX: wob.x, leanY: wob.y });\n        c.hud.meter = 1 - c.a.pt / steps(c, WEIGHTS);\n        c.hud.meterLabel = `Cart ${cart + 1} of 2`;\n        c.hud.show = { tiltDeg: Math.abs(isl.tiltX), cart, cartProgress: d.carts[cart] };\n        isl.tiltX -= rate * c.w.dt * 0.5;\n        if ((d.carts[0] >= 1 && d.carts[1] >= 1) || after(c, WEIGHTS)) {\n          if (d.carts[1] < 1) say(c, 'plumb', 'tilt.start');\n          setUpStone(c, d);\n        }\n        break;\n      }\n      case 'stone': {\n        if (c.a.pt === 1 || forced) setUpStone(c, d);\n        wob.on = true;\n        wob.usesBreath = true;\n        const u = c.a.pt / steps(c, STONE);\n        d.ringR = 0.5 - 0.28 * u;\n        d.wavePhase += c.w.dt;\n        const big = 1 + 2.2 * u;\n        wob.dx += Math.sin(d.wavePhase * 0.9) * big;\n        wob.dy += Math.sin(d.wavePhase * 1.37 + 1) * big;\n        // The tilt is your CoB.\n        isl.tiltX = wob.x * 9;\n        isl.tiltZ = wob.y * 9;\n        d.stoneTotal += 1;\n        d.syncSum += wob.sync;\n        if (inRing(wob, 0, 0, d.ringR)) d.stoneIn += 1;\n        if (guest) Object.assign(guest.cast, { pose: 'StoneStand', poseT: 1, leanX: wob.x * 1.4, leanY: wob.y * 1.4 });\n        c.hud.disc = true;\n        c.hud.guide = true;\n        c.hud.feet = true;\n        c.hud.ring = [0, 0, d.ringR];\n        c.hud.meter = 1 - u;\n        c.hud.meterLabel = 'Hold the island';\n        c.hud.show = { tiltDeg: Math.hypot(isl.tiltX, isl.tiltZ), stone: true };\n        const lighthouse = STATIONS.lighthouse;\n        const beamYaw = c.a.t * 0.012;\n        moveProp(c.w, d.beam, lighthouse.x, 16, lighthouse.z, [Math.sin(beamYaw / 2) * 0.7, Math.sin(beamYaw / 2) * 0.1, Math.cos(beamYaw / 2) * 0.7, Math.cos(beamYaw / 2)]);\n        if (wob.recover === 59) {\n          d.lurches += 1;\n          say(c, 'plumb', 'tilt.again');\n          c.w.emit('lurch', {});\n        }\n        if (u >= 1 && !d.attract) enter(c, 'dawn');\n        else if (u >= 1) c.a.pt = 0;\n        break;\n      }\n      case 'dawn':\n      default: {\n        wob.on = false;\n        c.hud.disc = false;\n        c.hud.feet = false;\n        c.hud.prompt = '';\n        if (c.a.pt === 1) {\n          Object.assign(isl, { sky: 'dawn', storm: 0, tiltX: 0, tiltZ: 0 });\n          c.w.emit('storm', { on: false });\n          c.w.emit('cutscene', { id: 'dawn' });\n          say(c, 'tare', 'tilt.balanced');\n        }\n        const plumb = castOf(c.w, 'plumb');\n        if (plumb) {\n          Object.assign(plumb.cast, { hold: true, x: 3, y: c.ground(3, 4) + 0.1, z: 4, yaw: Math.PI + 0.3, pose: 'Upright', poseT: 1 });\n          const puppet = c.w.get(plumb.id)?.puppet;\n          if (puppet && c.a.pt === steps(c, 5)) {\n            puppet.body = 'body:plumbOpen';\n            say(c, 'plumb', 'tilt.hm');\n          }\n          if (puppet && c.a.pt === steps(c, 8)) puppet.body = 'body:plumb';\n        }\n        if (c.a.pt === steps(c, 10)) say(c, 'tare', 'tilt.rock');\n        if (after(c, DAWN)) c.a.done = true;\n      }\n    }\n  },\n  teardown(c) {\n    const isl = c.w.query('island')[0].island;\n    Object.assign(isl, { tiltX: 0, tiltZ: 0, storm: 0 });\n    if (isl.sky === 'storm') isl.sky = 'day';\n    const plumb = castOf(c.w, 'plumb');\n    const puppet = plumb ? c.w.get(plumb.id)?.puppet : undefined;\n    if (puppet) puppet.body = 'body:plumb';\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as TiltData;\n    const { seat, wobble } = e;\n    seat.act = false;\n    seat.fl = seat.fr = 0;\n    const guest = castOf(c.w, 'guest');\n    const me = guest ? c.w.get(guest.id)?.actor : undefined;\n    if (!player.acts || !me) {\n      seat.lx = seat.ly = 0;\n      return;\n    }\n    if (c.a.phase === 'east') {\n      const { x: tx, z: tz } = STATIONS.eastTerrace;\n      const followers = d.walkers.filter((g) => g.following > steps(c, 2) && !g.delivered);\n      let goal: [number, number] = [tx, tz];\n      if (followers.length === 0) {\n        const near = d.walkers.filter((g) => !g.delivered).sort((a, b) => Math.hypot(a.x - me.x, a.z - me.z) - Math.hypot(b.x - me.x, b.z - me.z))[0];\n        if (near) goal = [near.x, near.z];\n        if (near && Math.hypot(near.x - me.x, near.z - me.z) < CALL_REACH - 2) {\n          const mem = seat.mem as { hold?: number };\n          mem.hold = (mem.hold ?? 0) + 1;\n          if (mem.hold < steps(c, CALL_CHARGE) + 3) seat.fl = seat.fr = 1;\n          else mem.hold = 0;\n        }\n      }\n      const [dx, dz] = [goal[0] - me.x, goal[1] - me.z];\n      const r = Math.hypot(dx, dz) || 1;\n      const [lx, ly] = leanForWorld(dx / r, dz / r);\n      [seat.lx, seat.ly] = [lx, ly];\n    } else if (c.a.phase === 'weights') {\n      holdAt(c.w, seat, wobble, 0.3, 0, player);\n      const cycle = player.name === 'perfect' ? 20 : 36;\n      const left = Math.floor(c.a.t / cycle) % 2 === 0;\n      const t = c.a.t % cycle;\n      seat.fl = left && t < 6 ? 1 : 0;\n      seat.fr = !left && t < 6 ? 1 : 0;\n    } else if (c.a.phase === 'stone') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      breathe(c.w, seat, wobble, player);\n    } else {\n      seat.lx = seat.ly = 0;\n    }\n  },\n  score(c) {\n    const d = c.a.data as unknown as TiltData;\n    const guests = d.delivered / Math.max(1, d.walkers.length);\n    const held = d.stoneTotal ? d.stoneIn / d.stoneTotal : 0;\n    const breath = d.stoneTotal ? d.syncSum / d.stoneTotal : 0;\n    return 1000 * (0.35 * guests + 0.45 * held + 0.2 * breath);\n  },\n};\n\n/** Sets up Counterweights. */\nfunction setUpWeights(c: Ctx, d: TiltData): void {\n  const { x, z } = STATIONS.eastTerrace;\n  const yr = FLAT_Y - 0.8;\n  propFor(c, { prop: 'prop:rail', at: [x - 14, yr, z - 8], yaw: 0 });\n  propFor(c, { prop: 'prop:rail', at: [x - 14, yr, z - 4], yaw: 0 });\n  d.cartProp = [propFor(c, { prop: 'prop:cart', at: [x - 22, yr, z - 8], yaw: 0 }), propFor(c, { prop: 'prop:cart', at: [x - 22, yr, z - 4], yaw: 0 })];\n  say(c, 'tare', 'tilt.weights');\n  enter(c, 'weights');\n}\n\n/** Sets up the Centre Stone: the fade takes you there. */\nfunction setUpStone(c: Ctx, d: TiltData): void {\n  const { x, z } = STATIONS.centre;\n  const guest = castOf(c.w, 'guest');\n  if (guest) Object.assign(guest.cast, { hold: true, x, y: c.ground(x, z) + 0.74, z: z + 0.1, yaw: Math.PI, pose: 'StoneStand', poseT: 1, leanX: 0, leanY: 0 });\n  Object.assign(c.seats[0].wobble, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, recover: 0, instMul: 1, swayMul: 1 });\n  if (c.a.phase !== 'stone') {\n    say(c, 'plumb', 'tilt.stone');\n    enter(c, 'stone');\n  }\n  c.w.emit('fade', {});\n  d.remark = 1;\n}\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\ns=open(p).read()\ns=s.replace(\"import { hoop } from './hoop';\",\"import { hoop } from './hoop';\\nimport { jog } from './jog';\\nimport { tilt } from './tilt';\")\ns=s.replace(\"  hoop,\\n\",\"  hoop,\\n  jog,\\n  tilt,\\n\",1)\nopen(p,'w').write(s)\np='labs/game/scenes/components.ts'\ns=open(p).read()\ns=s.replace(\"    resting: i(0, 'Steps sat on a bench.'),\\n\",\"    resting: i(0, 'Steps sat on a bench.'),\\n    camYaw: n(0, 'The camera heading the page reports.'),\\n\")\ns=s.replace(\"  resting: number;\\n}\",\"  resting: number;\\n  camYaw: number;\\n}\")\nopen(p,'w').write(s)\np='labs/game/scenes/flow.ts'\ns=open(p).read()\ns=s.replace(\"  const group = local['game:seats'];\\n\",\"  const group = local['game:seats'];\\n  if (typeof intents.cam === 'number') flow.camYaw = intents.cam;\\n\")\nopen(p,'w').write(s)\np='labs/game/scenes/director.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  if (flow.mode === 'event') return;\n  if (flow.mode !== 'roam' || flow.credits) return;\n\"\"\",\"\"\"  if (flow.mode === 'event') return;\n  if (flow.credits) {\n    flow.cutTick += 1;\n    if (flow.cutTick > 600) {\n      flow.credits = false;\n      flow.cutTick = 0;\n    }\n    return;\n  }\n  if (flow.mode !== 'roam') return;\n  if (flow.day > 5) return;\n\"\"\")\ns=s.replace(\"\"\"    if (flow.day <= 5) sleepNow(w);\n    return;\"\"\",\"\"\"    if (flow.day < 5) sleepNow(w);\n    return;\"\"\")\ns=s.replace(\"\"\"    if (flow.actTick >= AUTO_RESULTS) {\n      flow.actTick = 0;\n      leaveActivity(w);\n    }\"\"\",\"\"\"    if (flow.actTick >= AUTO_RESULTS) {\n      flow.actTick = 0;\n      leaveResults(w);\n    }\"\"\")\ns=s.replace(\"import { activityOf, endActivity, flowOf, leaveActivity, startActivity } from './flow';\",\"import { activityOf, endActivity, flowOf, startActivity } from './flow';\\nimport { leaveResults } from './ending';\")\nopen(p,'w').write(s)\np='labs/game/scenes/actions.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    if (activityOf(w) || flow.mode === 'results') leaveActivity(w);\n    syncCairn(w);\"\"\",\"\"\"    if (flow.mode === 'results') leaveResults(w);\n    else if (activityOf(w)) leaveActivity(w);\n    syncCairn(w);\"\"\")\ns=s.replace(\"import { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity } from './flow';\",\"import { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity } from './flow';\\nimport { leaveResults } from './ending';\")\ns=s.replace(\"\"\"  'game.front': (w: GameWorld) => {\"\"\",\"\"\"  'game.credits': (w: GameWorld, args: unknown) => {\n    const { on } = (args ?? {}) as { on: boolean };\n    flowOf(w).credits = on;\n  },\n  'game.front': (w: GameWorld) => {\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/ending.ts <<'EOF'\n/**\n * @file Leaving results, with the story's one-way doors: the Great Tilt leads to the last Morning Check; that leads to the\n * credits; and then you may stay as long as you like. The ferry does not return.\n *\n * Game code, sim-side.\n *\n * @example\n * // leaveResults(w);\n */\nimport type { GameWorld } from './components';\nimport { syncCairn } from './world';\nimport { applyDay } from './days';\nimport { flowOf, leaveActivity, startActivity } from './flow';\nimport { say } from './events/kit';\n\n/** Leaves the results screen. */\nexport function leaveResults(w: GameWorld): void {\n  const flow = flowOf(w);\n  const was = flow.event;\n  leaveActivity(w);\n  syncCairn(w);\n  if (was === 'tilt') {\n    flow.day = 6;\n    flow.done = [];\n    applyDay(w);\n    w.query('island')[0].island.sky = 'dawn';\n    startActivity(w, 'morning', { data: { last: true } });\n    flow.script = 1;\n  } else if (was === 'morning' && flow.script === 1) {\n    flow.script = 2;\n    flow.credits = true;\n    flow.cutTick = 0;\n    w.emit('credits', {});\n    say({ w }, 'tare', 'after.stay');\n  }\n}\nEOF\ngrep -n \"'game.finish'\" -A6 labs/game/scenes/actions.ts | head -3 >/dev/null; TEETER_SEEDS=2 TEETER_SHOW=1 TEETER_ONLY=hoop,plunge,jog npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -E \"^(hoop|plunge|jog)|^  [phsi]:|AssertionError|Error:|❯ labs|Tests \" | head -30 | cut -c1-220","description":"Write Island Jog and the finale, then test balance","timeout":500000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20754,"cache_read_input_tokens":444158,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20754},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"7508ee02-7c1d-491c-99ff-6291baa9f4a7","timestamp":"2026-11-05T09:51:57.281Z","request_id":"req_011CgjaAuto6ya1y7z8pddq4","wire_tool_inputs":{"toolu_019ToRJXjVB34FzUmS951U27":{"command":"python3 - <<'EOF'\np='labs/game/scenes/events/hoop.ts'\ns=open(p).read()\ns=s.replace(\"player.name === 'human' ? 0.8 : 3.2;\",\"player.name === 'human' ? 0.8 : 2.4;\")\nopen(p,'w').write(s)\np='labs/game/scenes/terrain.ts'\ns=open(p).read()\ns=s.replace(\"{ at: [0, -92], radius: 24, height: 5 },\",\"{ at: [0, -82], radius: 18, height: 5 },\\n    { at: [0, -106], radius: 26, height: -9 },\")\ns=s.replace(\"flat('cliff', 7, 16, 8),\",\"flat('cliff', 7, 16, 5),\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/plunge.ts'\ns=open(p).read()\ns=s.replace(\"const lipZ = z - 3.6;\",\"const lipZ = z - 8.6;\")\ns=s.replace(\"d.z -= (d.slip ? 2.2 : 3.2 + d.q * 2.2) * c.w.dt;\",\"d.z -= (d.slip ? 3 : 4.6 + d.q * 2.2) * c.w.dt;\")\ns=s.replace(\"propFor(c, { prop: 'prop:diveLip', at: [x, lipY - 0.14, z - 6], yaw: Math.PI });\",\"propFor(c, { prop: 'prop:diveLip', at: [x, lipY - 0.14, z - 6.4], yaw: Math.PI });\")\ns=s.replace(\"const [gx, gz] = [x - 8 + g * 2.2, z - 26];\",\"const [gx, gz] = [x - 11 + g * 2.2, z - 24];\")\nopen(p,'w').write(s)\np='labs/game/cast/roster.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    if (c.hold) placeActor(w, e.id, [c.x, c.y, c.z], c.yaw);\"\"\",\"\"\"    if (!c.hold) continue;\n    try {\n      placeActor(w, e.id, [c.x, c.y, c.z], c.yaw);\n    } catch {\n      // A place under the ground, a moment's fall through a cliff face: they stay where they were this step.\n      e.actor.yaw = c.yaw;\n    }\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/events/jog.ts <<'EOF'\n/**\n * @file Island Jog (PLAN.md section 6): follow Gerald round the coast path, a ring of flags past every landmark. The stick\n * steers; alternating feet at about 2.5 Hz gives +35% speed. Stay within 8 m of him: the Pace Ribbon. Tare hops beside you\n * and talks, the plaques go by. At the end Gerald says the longest thing he will ever say.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'jog');\n */\nimport { createCharacter, placeActor } from '../../../../engine/sim-api';\nimport { holdAt, type Player } from '../bot/players';\nimport { COAST } from '../data/courses';\nimport { castOf, enter, isBot, leanForWorld, propFor, say, steps, worldFromLean } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** The ribbon's reach, m; how long the path may take, s; how close a flag counts, m. */\nconst RIBBON = 8;\nconst LENGTH = 170;\nconst FLAG_REACH = 3.2;\n\n/** The jog's state. */\ninterface JogData {\n  flag: number;\n  inside: number;\n  total: number;\n  stuck: number;\n  lastX: number;\n  lastZ: number;\n  boost: number;\n  lastFoot: string;\n  footT: number;\n  fast: boolean;\n  talk: number;\n  gap: number;\n}\n\n/** Island Jog. */\nexport const jog: Activity = {\n  id: 'jog',\n  title: 'Island Jog',\n  station: 'plaza',\n  map: 'actionMap:balance',\n  shot: 'jog',\n  wobble: false,\n  setup(c) {\n    const d: JogData = { flag: 0, inside: 0, total: 0, stuck: 0, lastX: 0, lastZ: 0, boost: 0, lastFoot: '', footT: 999, fast: false, talk: steps(c, 6), gap: 0 };\n    c.a.data = d as unknown as Record<string, unknown>;\n    COAST.forEach(([x, z]) => propFor(c, { prop: 'prop:lineFlag', at: [x, c.ground(x, z), z], yaw: 0 }));\n    const speed = c.w.settings.get<number>('game.jog.speed');\n    const guest = castOf(c.w, 'guest');\n    const gerald = castOf(c.w, 'gerald');\n    const [x, z] = [COAST[0][0] - 2, COAST[0][1] - 8];\n    if (guest) {\n      Object.assign(guest.cast, { hold: false, pose: '', poseT: 0 });\n      placeActor(c.w, guest.id, [x, c.ground(x, z), z], 0.2);\n      const actor = c.w.get(guest.id)?.actor;\n      if (actor) actor.character = createCharacter({ speed, jumpSpeed: 6.5 });\n    }\n    if (gerald) {\n      Object.assign(gerald.cast, { hold: false, pose: '', poseT: 0 });\n      placeActor(c.w, gerald.id, [x + 2, c.ground(x + 2, z + 3), z + 3], 0.2);\n      const actor = c.w.get(gerald.id)?.actor;\n      if (actor) actor.character = createCharacter({ speed: speed * 0.8, jumpSpeed: 6 });\n    }\n    c.hud.title = 'Island Jog';\n    c.hud.feet = true;\n    enter(c, 'jog');\n    say(c, 'gerald', 'jog.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as JogData;\n    const [{ seat }] = c.seats;\n    const guest = castOf(c.w, 'guest');\n    const gerald = castOf(c.w, 'gerald');\n    const me = guest ? c.w.get(guest.id)?.actor : undefined;\n    const him = gerald ? c.w.get(gerald.id)?.actor : undefined;\n    if (!me || !him) {\n      c.a.done = true;\n      return;\n    }\n    const base = c.w.settings.get<number>('game.jog.speed');\n    // Feet alternating at about 2.5 Hz: +35%.\n    d.footT += 1;\n    const foot = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n    if (foot && foot !== d.lastFoot) {\n      if (d.footT < c.w.hz * 0.6) d.boost = Math.min(1, d.boost + 0.4);\n      d.footT = 0;\n      d.lastFoot = foot;\n    }\n    d.boost = Math.max(0, d.boost - c.w.dt * 0.8);\n    const fast = d.boost > 0.3;\n    if (fast !== d.fast) {\n      d.fast = fast;\n      me.character = createCharacter({ speed: base * (fast ? 1.35 : 1), jumpSpeed: 6.5 });\n      c.w.emit('jogBoost', { fast });\n    }\n    // Your move, by the stick, from where the camera looks.\n    const cam = isBot(c, seat.index) ? 0 : c.flow.camYaw;\n    const [mx, mz] = worldFromLean(seat.lx, seat.ly, cam);\n    me.intents = { move: [mx, mz] };\n    // Gerald goes flag to flag and does not look back.\n    const [fx, fz] = COAST[Math.min(d.flag, COAST.length - 1)];\n    const [dx, dz] = [fx - him.x, fz - him.z];\n    const dist = Math.hypot(dx, dz);\n    him.intents = dist > 0.1 ? { move: [dx / dist, dz / dist] } : {};\n    if (dist < FLAG_REACH) {\n      d.flag += 1;\n      c.w.emit('jogFlag', { flag: d.flag });\n    }\n    if (c.a.t % 60 === 0) {\n      if (Math.hypot(him.x - d.lastX, him.z - d.lastZ) < 1 && c.a.t > 0) {\n        d.stuck += 1;\n        if (d.stuck >= 2) placeActor(c.w, gerald!.id, [fx, c.ground(fx, fz), fz], him.yaw);\n      } else d.stuck = 0;\n      [d.lastX, d.lastZ] = [him.x, him.z];\n    }\n    // The Pace Ribbon.\n    d.gap = Math.hypot(me.x - him.x, me.z - him.z);\n    d.total += 1;\n    if (d.gap <= RIBBON) d.inside += 1;\n    // Tare hops beside you, and talks.\n    const tare = castOf(c.w, 'tare');\n    if (tare) tare.cast.home = [me.x + 1.6, me.z + 1.3];\n    d.talk -= 1;\n    if (d.talk <= 0) {\n      d.talk = steps(c, 14);\n      say(c, 'tare', 'jog.chatter');\n    }\n    c.hud.show = { gap: d.gap, ribbon: RIBBON, inRibbon: d.gap <= RIBBON, flags: d.flag, of: COAST.length, fast };\n    c.hud.meter = d.flag / COAST.length;\n    c.hud.meterLabel = d.gap <= RIBBON ? 'In the ribbon' : 'Catch Gerald';\n    if (d.flag >= COAST.length || c.a.t >= steps(c, LENGTH)) {\n      say(c, 'gerald', 'jog.end');\n      c.a.done = true;\n    }\n  },\n  teardown(c) {\n    const speed = 5.4;\n    const guest = castOf(c.w, 'guest');\n    const actor = guest ? c.w.get(guest.id)?.actor : undefined;\n    if (actor) {\n      actor.character = createCharacter({ speed, jumpSpeed: 6.5 });\n      actor.intents = {};\n    }\n    const gerald = castOf(c.w, 'gerald');\n    const his = gerald ? c.w.get(gerald.id)?.actor : undefined;\n    if (his) {\n      his.character = createCharacter({ speed: 3.6, jumpSpeed: 6.5 });\n      his.intents = {};\n    }\n  },\n  bot(c, e, player: Player) {\n    const { seat, wobble } = e;\n    seat.act = false;\n    if (!player.acts) {\n      Object.assign(seat, { lx: 0, ly: 0, fl: 0, fr: 0 });\n      return;\n    }\n    const guest = castOf(c.w, 'guest');\n    const gerald = castOf(c.w, 'gerald');\n    const me = guest ? c.w.get(guest.id)?.actor : undefined;\n    const him = gerald ? c.w.get(gerald.id)?.actor : undefined;\n    if (!me || !him) return;\n    const [dx, dz] = [him.x - me.x, him.z - me.z];\n    const dist = Math.hypot(dx, dz) || 1;\n    const go = dist > 2.5 ? 1 : 0.4;\n    const late = player.name === 'perfect' ? 0 : player.name === 'human' ? 0.08 : 0.18;\n    const [lx, ly] = leanForWorld((dx / dist) * go, (dz / dist) * go);\n    seat.lx = lx + late * Math.sin(c.a.t * 0.05);\n    seat.ly = ly;\n    holdAt;\n    void wobble;\n    const cycle = player.name === 'sloppy' ? 40 : 22;\n    const t = c.a.t % cycle;\n    const left = Math.floor(c.a.t / cycle) % 2 === 0;\n    const hurry = dist > 4;\n    seat.fl = hurry && left && t < 6 ? 1 : 0;\n    seat.fr = hurry && !left && t < 6 ? 1 : 0;\n  },\n  score(c) {\n    const d = c.a.data as unknown as JogData;\n    return d.total ? (1000 * d.inside) / d.total : 0;\n  },\n};\nEOF\ncat > labs/game/scenes/data/guests.ts <<'EOF'\n/**\n * @file The twelve guests of the Great Tilt: who they are and where the storm finds them. Gerald, Bex and Nan are the named\n * cast; the rest are crowd bodies in the engine's own builds.\n *\n * Game code, sim-side data.\n *\n * @example\n * TILT_GUESTS.length; // 12\n */\n\n/** A guest in the finale. */\nexport interface TiltGuest {\n  name: string;\n  x: number;\n  z: number;\n  build: string;\n}\n\n/** The guests. */\nexport const TILT_GUESTS: readonly TiltGuest[] = [\n  { name: 'gerald', x: 10, z: 26, build: '' },\n  { name: 'bex', x: -6, z: 22, build: '' },\n  { name: 'nan', x: 2, z: 44, build: '' },\n  { name: 'guest', x: -14, z: 30, build: 'build:guest0' },\n  { name: 'guest', x: -20, z: 40, build: 'build:guest1' },\n  { name: 'guest', x: 16, z: 40, build: 'build:guest2' },\n  { name: 'guest', x: 22, z: 30, build: 'build:guest0' },\n  { name: 'guest', x: -30, z: 24, build: 'build:guest1' },\n  { name: 'guest', x: -26, z: 10, build: 'build:guest2' },\n  { name: 'guest', x: 32, z: 14, build: 'build:guest1' },\n  { name: 'guest', x: 8, z: 12, build: 'build:guest0' },\n  { name: 'guest', x: -10, z: 6, build: 'build:guest2' },\n];\nEOF\ncat > labs/game/scenes/events/tilt.ts <<'EOF'\n/**\n * @file The Great Tilt (PLAN.md section 7): the finale, using every verb at the scale of the world. Storm; Everyone East;\n * Counterweights; the Centre Stone, where your CoB is the island's tilt; Dawn. There is no fail state, only remarks, and\n * every step is time boxed. The island's geometry never moves: walkers get a slope push, the camera banks, the sea\n * counter-rotates.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'tilt');\n */\nimport { placeActor, stepCrowdBody } from '../../../../engine/sim-api';\nimport { breathe, holdAt, type Player } from '../bot/players';\nimport { FLAT_Y, STATIONS } from '../data/stations';\nimport { TILT_GUESTS } from '../data/guests';\nimport { bothFeet, inRing } from '../wobble';\nimport { after, castOf, enter, entityFor, floorShape, isBot, leanForWorld, moveProp, propFor, say, steps, worldFromLean } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** Seconds of each step (PLAN.md section 7). */\nconst STORM = 20;\nconst EAST = 75;\nconst WEIGHTS = 45;\nconst STONE = 60;\nconst DAWN = 16;\n/** The Calm Call: how long it takes to charge, how far it reaches, how long they follow. */\nconst CALL_CHARGE = 2;\nconst CALL_REACH = 8;\nconst FOLLOW = 12;\n/** The East Terrace's radius. */\nconst TERRACE = 8;\n\n/** A guest in the finale. */\ninterface Walker {\n  x: number;\n  z: number;\n  body: number;\n  named: string;\n  following: number;\n  delivered: boolean;\n}\n\n/** The finale's state. */\ninterface TiltData {\n  walkers: Walker[];\n  delivered: number;\n  charge: number;\n  wave: number;\n  waveT: number;\n  loungers: number[];\n  cartProp: number[];\n  carts: number[];\n  cartFoot: string;\n  wavePhase: number;\n  stoneIn: number;\n  stoneTotal: number;\n  syncSum: number;\n  ringR: number;\n  lurches: number;\n  beam: number;\n  attract: boolean;\n  remark: number;\n  eyes: boolean;\n}\n\n/** Spawns the guests and the storm's props. */\nfunction setOut(c: Ctx, d: TiltData): void {\n  TILT_GUESTS.forEach((g) => {\n    const y = c.ground(g.x, g.z);\n    if (g.name === 'guest') {\n      const body = entityFor(c, { crowdBody: { rig: 'humanoid', look: g.build, size: 0, x: g.x, y, z: g.z, yaw: 1.5, state: {} } as never });\n      d.walkers.push({ x: g.x, z: g.z, body, named: '', following: 0, delivered: false });\n    } else {\n      const person = castOf(c.w, g.name);\n      if (person) {\n        placeActor(c.w, person.id, [g.x, y, g.z], 1.5);\n        Object.assign(person.cast, { hold: false, pose: '', poseT: 0 });\n      }\n      d.walkers.push({ x: g.x, z: g.z, body: person?.id ?? -1, named: g.name, following: 0, delivered: false });\n    }\n  });\n  for (let i = 0; i < 6; i++) {\n    const [lx, lz] = [20 + i * 7, 8 + (i % 3) * 7];\n    d.loungers.push(propFor(c, { prop: 'prop:lounger', at: [lx, c.ground(lx, lz), lz], yaw: 1.5 }));\n  }\n  d.beam = propFor(c, { prop: 'prop:beam', at: [0, -40, 0], yaw: 0 });\n}\n\n/** Moves the finale's guests a step. They drift downhill politely unless called, and Nan is already there. */\nfunction stepWalkers(c: Ctx, d: TiltData, ghx: number, ghz: number): void {\n  const isl = c.w.query('island')[0].island;\n  const { x: tx, z: tz } = STATIONS.eastTerrace;\n  const push = -isl.tiltX * 0.09;\n  const lateShuffle = c.a.phase !== 'east';\n  d.walkers.forEach((g) => {\n    if (g.delivered && !lateShuffle) return;\n    let [vx, vz] = [-push, 0.12 * Math.sin(c.a.t * 0.01 + g.x)];\n    if (g.named === 'nan' && !g.delivered) {\n      // Nan walks up on her own and is already there.\n      const [dx, dz] = [tx - g.x, tz - g.z];\n      const r = Math.hypot(dx, dz) || 1;\n      vx = (dx / r) * 2.2;\n      vz = (dz / r) * 2.2;\n    } else if (g.following > 0) {\n      g.following -= 1;\n      const [dx, dz] = [ghx - g.x, ghz - g.z];\n      const r = Math.hypot(dx, dz) || 1;\n      const speed = r > 2 ? 3.6 : 0.6;\n      vx = (dx / r) * speed - push * 0.3;\n      vz = (dz / r) * speed;\n    } else if (lateShuffle && !g.delivered) {\n      const [dx, dz] = [tx - g.x, tz - g.z];\n      const r = Math.hypot(dx, dz) || 1;\n      vx = (dx / r) * 3;\n      vz = (dz / r) * 3;\n    } else if (g.delivered) {\n      vx = vz = 0;\n    }\n    g.x = Math.max(-92, Math.min(95, g.x + vx * c.w.dt));\n    g.z = Math.max(-80, Math.min(85, g.z + vz * c.w.dt));\n    const y = c.ground(g.x, g.z);\n    if (g.named) {\n      const person = castOf(c.w, g.named);\n      if (person) {\n        Object.assign(person.cast, { hold: true, x: g.x, y, z: g.z, yaw: Math.atan2(vx, vz) });\n        const actor = c.w.get(person.id)?.actor;\n        if (actor) actor.intents = {};\n      }\n    } else {\n      const body = c.w.get(g.body)?.crowdBody;\n      if (body) stepCrowdBody(c.w, g.body, body, { at: [g.x, y, g.z], velocity: [vx, 0, vz], yaw: Math.atan2(vx, vz) });\n    }\n    if (!g.delivered && Math.hypot(g.x - tx, g.z - tz) < TERRACE) {\n      g.delivered = true;\n      d.delivered += 1;\n      isl.tiltX = Math.min(-0.5, isl.tiltX + 0.5);\n      c.w.emit('guestDelivered', { n: d.delivered, named: g.named });\n      if (g.named === 'nan') say(c, 'nan', 'tilt.nan');\n    }\n  });\n}\n\n/** Puts the player on their feet at a place, walking. */\nfunction freeGuest(c: Ctx, x: number, z: number): void {\n  const guest = castOf(c.w, 'guest');\n  if (!guest) return;\n  Object.assign(guest.cast, { hold: false, pose: '', poseT: 0 });\n  placeActor(c.w, guest.id, [x, c.ground(x, z), z], 1.5);\n}\n\n/** The Great Tilt. */\nexport const tilt: Activity = {\n  id: 'tilt',\n  title: 'The Great Tilt',\n  station: 'plaza',\n  map: 'actionMap:balance',\n  shot: 'tilt',\n  wobble: true,\n  setup(c) {\n    const attract = Boolean((c.a.data as { attract?: boolean }).attract);\n    const d: TiltData = { walkers: [], delivered: 0, charge: 0, wave: -1, waveT: 0, loungers: [], cartProp: [], carts: [0, 0], cartFoot: '', wavePhase: 0, stoneIn: 0, stoneTotal: 0, syncSum: 0, ringR: 0.5, lurches: 0, beam: -1, attract, remark: 0, eyes: false }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    const isl = c.w.query('island')[0].island;\n    Object.assign(isl, { tiltX: -6, tiltZ: 0, storm: 1, sky: 'storm' });\n    d.wave = floorShape(c, '', 0, c.station.y, 0, 0.1);\n    setOut(c, d);\n    const plumb = castOf(c.w, 'plumb');\n    if (plumb) Object.assign(plumb.cast, { hold: true, x: 2, y: c.ground(2, 26), z: 26, yaw: 0, pose: 'Upright', poseT: 1 });\n    freeGuest(c, 0, 32);\n    c.hud.title = 'The Great Tilt';\n    c.hud.disc = false;\n    enter(c, 'storm');\n    c.w.emit('storm', { on: true });\n    c.w.emit('cutscene', { id: 'plait' });\n    if (attract) enter(c, 'stone');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as TiltData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const isl = c.w.query('island')[0].island;\n    const guest = castOf(c.w, 'guest');\n    const me = guest ? c.w.get(guest.id)?.actor : undefined;\n    const rate = c.w.settings.get<number>('game.tilt.rate');\n    const forced = Boolean((c.a.data as { jumped?: boolean }).jumped);\n    if (forced) (c.a.data as { jumped?: boolean }).jumped = false;\n    // The loungers slide through, whatever the phase.\n    if (c.a.phase === 'east' || c.a.phase === 'storm') {\n      d.loungers.forEach((id, i) => {\n        const e = c.w.get(id)?.sceneProp;\n        if (!e) return;\n        const nx = e.x - (0.9 + i * 0.06) * -isl.tiltX * 0.25 * c.w.dt;\n        const wrap = nx < -50 ? 60 : nx;\n        moveProp(c.w, id, wrap, c.ground(wrap, e.z), e.z, 1.5 + Math.sin(c.a.t * 0.02 + i) * 0.2);\n      });\n    }\n    switch (c.a.phase) {\n      case 'storm':\n        wob.on = false;\n        if (c.a.pt === steps(c, 6)) {\n          say(c, 'pa', 'tilt.outOfTrue');\n          c.w.emit('ferryHorn', {});\n        }\n        if (c.a.pt === steps(c, 14)) c.w.emit('thunder', {});\n        if (seat.actP && c.a.pt > 60) enter(c, 'east');\n        else if (after(c, STORM)) {\n          say(c, 'pa', 'tilt.east');\n          enter(c, 'east');\n        }\n        c.hud.prompt = 'skip';\n        break;\n      case 'east': {\n        c.hud.prompt = '';\n        wob.on = false;\n        if (me) {\n          const cam = isBot(c, seat.index) ? 0 : c.flow.camYaw;\n          const [mx, mz] = worldFromLean(seat.lx, seat.ly, cam);\n          me.intents = { move: [mx - isl.tiltX * 0.055, mz] };\n          const calling = bothFeet(seat);\n          d.charge = calling ? Math.min(1, d.charge + c.w.dt / CALL_CHARGE) : d.charge;\n          if (!calling && d.charge >= 1) {\n            d.charge = 0;\n            d.waveT = steps(c, 1.4);\n            let n = 0;\n            for (const g of d.walkers) {\n              if (!g.delivered && Math.hypot(g.x - me.x, g.z - me.z) <= CALL_REACH) {\n                g.following = steps(c, FOLLOW);\n                n += 1;\n              }\n            }\n            c.w.emit('calmCall', { n });\n            say(c, 'tare', n > 0 ? 'tilt.calmed' : 'tilt.calmedNobody');\n          } else if (!calling) d.charge = Math.max(0, d.charge - c.w.dt);\n          if (guest) Object.assign(guest.cast, { pose: calling ? 'CalmCall' : '', poseT: d.charge });\n          d.waveT = Math.max(0, d.waveT - 1);\n          const ring = c.w.get(d.wave)?.matRing;\n          if (ring) {\n            ring.telegraph = d.waveT > 0 ? 'telegraph:calmWave' : '';\n            ring.position = [me.x, me.y + 0.1, me.z];\n            ring.size = CALL_REACH * (1 - d.waveT / steps(c, 1.4));\n          }\n          stepWalkers(c, d, me.x, me.z);\n        }\n        isl.tiltX -= rate * c.w.dt;\n        const show: Record<string, unknown> = { delivered: d.delivered, charge: d.charge, followers: d.walkers.filter((g) => g.following > 0).length, tiltDeg: Math.abs(isl.tiltX) };\n        c.hud.show = show;\n        c.hud.meter = 1 - c.a.pt / steps(c, EAST);\n        c.hud.meterLabel = 'Everyone East';\n        if (d.delivered >= d.walkers.length || after(c, EAST)) {\n          if (d.delivered < d.walkers.length) say(c, 'plumb', 'tilt.shuffle');\n          setUpWeights(c, d);\n        }\n        break;\n      }\n      case 'weights': {\n        wob.on = true;\n        wob.usesBreath = false;\n        const { x, z } = STATIONS.eastTerrace;\n        c.hud.disc = true;\n        c.hud.feet = true;\n        c.hud.ring = [0.3, 0, 0.32];\n        stepWalkers(c, d, x, z);\n        const foot = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n        const cart = d.carts[0] < 1 ? 0 : 1;\n        if (foot && foot !== d.cartFoot && inRing(wob, 0.3, 0, 0.4)) {\n          d.cartFoot = foot;\n          d.carts[cart] = Math.min(1, d.carts[cart] + 0.055);\n          c.w.emit('crank', { foot, cart });\n          if (d.carts[cart] >= 1) {\n            isl.tiltX = Math.min(-0.5, isl.tiltX + 1);\n            c.w.emit('cartHome', { cart });\n          }\n        }\n        wob.dx += isl.tiltX * 0.8;\n        d.cartProp.forEach((id, i) => moveProp(c.w, id, x - 22 + d.carts[i] * 16, FLAT_Y - 0.6, z - 8 + i * 4));\n        if (guest) Object.assign(guest.cast, { hold: true, x: x - 19 + d.carts[cart] * 16, y: c.ground(x - 19, z - 8 + cart * 4), z: z - 8 + cart * 4 - 1.4, yaw: 0, pose: 'Crank', poseT: d.carts[cart] * 8, leanX: wob.x, leanY: wob.y });\n        c.hud.meter = 1 - c.a.pt / steps(c, WEIGHTS);\n        c.hud.meterLabel = `Cart ${cart + 1} of 2`;\n        c.hud.show = { tiltDeg: Math.abs(isl.tiltX), cart, cartProgress: d.carts[cart] };\n        isl.tiltX -= rate * c.w.dt * 0.5;\n        if ((d.carts[0] >= 1 && d.carts[1] >= 1) || after(c, WEIGHTS)) {\n          if (d.carts[1] < 1) say(c, 'plumb', 'tilt.start');\n          setUpStone(c, d);\n        }\n        break;\n      }\n      case 'stone': {\n        if (c.a.pt === 1 || forced) setUpStone(c, d);\n        wob.on = true;\n        wob.usesBreath = true;\n        const u = c.a.pt / steps(c, STONE);\n        d.ringR = 0.5 - 0.28 * u;\n        d.wavePhase += c.w.dt;\n        const big = 1 + 2.2 * u;\n        wob.dx += Math.sin(d.wavePhase * 0.9) * big;\n        wob.dy += Math.sin(d.wavePhase * 1.37 + 1) * big;\n        // The tilt is your CoB.\n        isl.tiltX = wob.x * 9;\n        isl.tiltZ = wob.y * 9;\n        d.stoneTotal += 1;\n        d.syncSum += wob.sync;\n        if (inRing(wob, 0, 0, d.ringR)) d.stoneIn += 1;\n        if (guest) Object.assign(guest.cast, { pose: 'StoneStand', poseT: 1, leanX: wob.x * 1.4, leanY: wob.y * 1.4 });\n        c.hud.disc = true;\n        c.hud.guide = true;\n        c.hud.feet = true;\n        c.hud.ring = [0, 0, d.ringR];\n        c.hud.meter = 1 - u;\n        c.hud.meterLabel = 'Hold the island';\n        c.hud.show = { tiltDeg: Math.hypot(isl.tiltX, isl.tiltZ), stone: true };\n        const lighthouse = STATIONS.lighthouse;\n        const beamYaw = c.a.t * 0.012;\n        moveProp(c.w, d.beam, lighthouse.x, 16, lighthouse.z, [Math.sin(beamYaw / 2) * 0.7, Math.sin(beamYaw / 2) * 0.1, Math.cos(beamYaw / 2) * 0.7, Math.cos(beamYaw / 2)]);\n        if (wob.recover === 59) {\n          d.lurches += 1;\n          say(c, 'plumb', 'tilt.again');\n          c.w.emit('lurch', {});\n        }\n        if (u >= 1 && !d.attract) enter(c, 'dawn');\n        else if (u >= 1) c.a.pt = 0;\n        break;\n      }\n      case 'dawn':\n      default: {\n        wob.on = false;\n        c.hud.disc = false;\n        c.hud.feet = false;\n        c.hud.prompt = '';\n        if (c.a.pt === 1) {\n          Object.assign(isl, { sky: 'dawn', storm: 0, tiltX: 0, tiltZ: 0 });\n          c.w.emit('storm', { on: false });\n          c.w.emit('cutscene', { id: 'dawn' });\n          say(c, 'tare', 'tilt.balanced');\n        }\n        const plumb = castOf(c.w, 'plumb');\n        if (plumb) {\n          Object.assign(plumb.cast, { hold: true, x: 3, y: c.ground(3, 4) + 0.1, z: 4, yaw: Math.PI + 0.3, pose: 'Upright', poseT: 1 });\n          const puppet = c.w.get(plumb.id)?.puppet;\n          if (puppet && c.a.pt === steps(c, 5)) {\n            puppet.body = 'body:plumbOpen';\n            say(c, 'plumb', 'tilt.hm');\n          }\n          if (puppet && c.a.pt === steps(c, 8)) puppet.body = 'body:plumb';\n        }\n        if (c.a.pt === steps(c, 10)) say(c, 'tare', 'tilt.rock');\n        if (after(c, DAWN)) c.a.done = true;\n      }\n    }\n  },\n  teardown(c) {\n    const isl = c.w.query('island')[0].island;\n    Object.assign(isl, { tiltX: 0, tiltZ: 0, storm: 0 });\n    if (isl.sky === 'storm') isl.sky = 'day';\n    const plumb = castOf(c.w, 'plumb');\n    const puppet = plumb ? c.w.get(plumb.id)?.puppet : undefined;\n    if (puppet) puppet.body = 'body:plumb';\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as TiltData;\n    const { seat, wobble } = e;\n    seat.act = false;\n    seat.fl = seat.fr = 0;\n    const guest = castOf(c.w, 'guest');\n    const me = guest ? c.w.get(guest.id)?.actor : undefined;\n    if (!player.acts || !me) {\n      seat.lx = seat.ly = 0;\n      return;\n    }\n    if (c.a.phase === 'east') {\n      const { x: tx, z: tz } = STATIONS.eastTerrace;\n      const followers = d.walkers.filter((g) => g.following > steps(c, 2) && !g.delivered);\n      let goal: [number, number] = [tx, tz];\n      if (followers.length === 0) {\n        const near = d.walkers.filter((g) => !g.delivered).sort((a, b) => Math.hypot(a.x - me.x, a.z - me.z) - Math.hypot(b.x - me.x, b.z - me.z))[0];\n        if (near) goal = [near.x, near.z];\n        if (near && Math.hypot(near.x - me.x, near.z - me.z) < CALL_REACH - 2) {\n          const mem = seat.mem as { hold?: number };\n          mem.hold = (mem.hold ?? 0) + 1;\n          if (mem.hold < steps(c, CALL_CHARGE) + 3) seat.fl = seat.fr = 1;\n          else mem.hold = 0;\n        }\n      }\n      const [dx, dz] = [goal[0] - me.x, goal[1] - me.z];\n      const r = Math.hypot(dx, dz) || 1;\n      const [lx, ly] = leanForWorld(dx / r, dz / r);\n      [seat.lx, seat.ly] = [lx, ly];\n    } else if (c.a.phase === 'weights') {\n      holdAt(c.w, seat, wobble, 0.3, 0, player);\n      const cycle = player.name === 'perfect' ? 20 : 36;\n      const left = Math.floor(c.a.t / cycle) % 2 === 0;\n      const t = c.a.t % cycle;\n      seat.fl = left && t < 6 ? 1 : 0;\n      seat.fr = !left && t < 6 ? 1 : 0;\n    } else if (c.a.phase === 'stone') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      breathe(c.w, seat, wobble, player);\n    } else {\n      seat.lx = seat.ly = 0;\n    }\n  },\n  score(c) {\n    const d = c.a.data as unknown as TiltData;\n    const guests = d.delivered / Math.max(1, d.walkers.length);\n    const held = d.stoneTotal ? d.stoneIn / d.stoneTotal : 0;\n    const breath = d.stoneTotal ? d.syncSum / d.stoneTotal : 0;\n    return 1000 * (0.35 * guests + 0.45 * held + 0.2 * breath);\n  },\n};\n\n/** Sets up Counterweights. */\nfunction setUpWeights(c: Ctx, d: TiltData): void {\n  const { x, z } = STATIONS.eastTerrace;\n  const yr = FLAT_Y - 0.8;\n  propFor(c, { prop: 'prop:rail', at: [x - 14, yr, z - 8], yaw: 0 });\n  propFor(c, { prop: 'prop:rail', at: [x - 14, yr, z - 4], yaw: 0 });\n  d.cartProp = [propFor(c, { prop: 'prop:cart', at: [x - 22, yr, z - 8], yaw: 0 }), propFor(c, { prop: 'prop:cart', at: [x - 22, yr, z - 4], yaw: 0 })];\n  say(c, 'tare', 'tilt.weights');\n  enter(c, 'weights');\n}\n\n/** Sets up the Centre Stone: the fade takes you there. */\nfunction setUpStone(c: Ctx, d: TiltData): void {\n  const { x, z } = STATIONS.centre;\n  const guest = castOf(c.w, 'guest');\n  if (guest) Object.assign(guest.cast, { hold: true, x, y: c.ground(x, z) + 0.74, z: z + 0.1, yaw: Math.PI, pose: 'StoneStand', poseT: 1, leanX: 0, leanY: 0 });\n  Object.assign(c.seats[0].wobble, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, recover: 0, instMul: 1, swayMul: 1 });\n  if (c.a.phase !== 'stone') {\n    say(c, 'plumb', 'tilt.stone');\n    enter(c, 'stone');\n  }\n  c.w.emit('fade', {});\n  d.remark = 1;\n}\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\ns=open(p).read()\ns=s.replace(\"import { hoop } from './hoop';\",\"import { hoop } from './hoop';\\nimport { jog } from './jog';\\nimport { tilt } from './tilt';\")\ns=s.replace(\"  hoop,\\n\",\"  hoop,\\n  jog,\\n  tilt,\\n\",1)\nopen(p,'w').write(s)\np='labs/game/scenes/components.ts'\ns=open(p).read()\ns=s.replace(\"    resting: i(0, 'Steps sat on a bench.'),\\n\",\"    resting: i(0, 'Steps sat on a bench.'),\\n    camYaw: n(0, 'The camera heading the page reports.'),\\n\")\ns=s.replace(\"  resting: number;\\n}\",\"  resting: number;\\n  camYaw: number;\\n}\")\nopen(p,'w').write(s)\np='labs/game/scenes/flow.ts'\ns=open(p).read()\ns=s.replace(\"  const group = local['game:seats'];\\n\",\"  const group = local['game:seats'];\\n  if (typeof intents.cam === 'number') flow.camYaw = intents.cam;\\n\")\nopen(p,'w').write(s)\np='labs/game/scenes/director.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  if (flow.mode === 'event') return;\n  if (flow.mode !== 'roam' || flow.credits) return;\n\"\"\",\"\"\"  if (flow.mode === 'event') return;\n  if (flow.credits) {\n    flow.cutTick += 1;\n    if (flow.cutTick > 600) {\n      flow.credits = false;\n      flow.cutTick = 0;\n    }\n    return;\n  }\n  if (flow.mode !== 'roam') return;\n  if (flow.day > 5) return;\n\"\"\")\ns=s.replace(\"\"\"    if (flow.day <= 5) sleepNow(w);\n    return;\"\"\",\"\"\"    if (flow.day < 5) sleepNow(w);\n    return;\"\"\")\ns=s.replace(\"\"\"    if (flow.actTick >= AUTO_RESULTS) {\n      flow.actTick = 0;\n      leaveActivity(w);\n    }\"\"\",\"\"\"    if (flow.actTick >= AUTO_RESULTS) {\n      flow.actTick = 0;\n      leaveResults(w);\n    }\"\"\")\ns=s.replace(\"import { activityOf, endActivity, flowOf, leaveActivity, startActivity } from './flow';\",\"import { activityOf, endActivity, flowOf, startActivity } from './flow';\\nimport { leaveResults } from './ending';\")\nopen(p,'w').write(s)\np='labs/game/scenes/actions.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    if (activityOf(w) || flow.mode === 'results') leaveActivity(w);\n    syncCairn(w);\"\"\",\"\"\"    if (flow.mode === 'results') leaveResults(w);\n    else if (activityOf(w)) leaveActivity(w);\n    syncCairn(w);\"\"\")\ns=s.replace(\"import { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity } from './flow';\",\"import { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity } from './flow';\\nimport { leaveResults } from './ending';\")\ns=s.replace(\"\"\"  'game.front': (w: GameWorld) => {\"\"\",\"\"\"  'game.credits': (w: GameWorld, args: unknown) => {\n    const { on } = (args ?? {}) as { on: boolean };\n    flowOf(w).credits = on;\n  },\n  'game.front': (w: GameWorld) => {\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/ending.ts <<'EOF'\n/**\n * @file Leaving results, with the story's one-way doors: the Great Tilt leads to the last Morning Check; that leads to the\n * credits; and then you may stay as long as you like. The ferry does not return.\n *\n * Game code, sim-side.\n *\n * @example\n * // leaveResults(w);\n */\nimport type { GameWorld } from './components';\nimport { syncCairn } from './world';\nimport { applyDay } from './days';\nimport { flowOf, leaveActivity, startActivity } from './flow';\nimport { say } from './events/kit';\n\n/** Leaves the results screen. */\nexport function leaveResults(w: GameWorld): void {\n  const flow = flowOf(w);\n  const was = flow.event;\n  leaveActivity(w);\n  syncCairn(w);\n  if (was === 'tilt') {\n    flow.day = 6;\n    flow.done = [];\n    applyDay(w);\n    w.query('island')[0].island.sky = 'dawn';\n    startActivity(w, 'morning', { data: { last: true } });\n    flow.script = 1;\n  } else if (was === 'morning' && flow.script === 1) {\n    flow.script = 2;\n    flow.credits = true;\n    flow.cutTick = 0;\n    w.emit('credits', {});\n    say({ w }, 'tare', 'after.stay');\n  }\n}\nEOF\ngrep -n \"'game.finish'\" -A6 labs/game/scenes/actions.ts | head -3 >/dev/null; TEETER_SEEDS=2 TEETER_SHOW=1 TEETER_ONLY=hoop,plunge,jog npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -E \"^(hoop|plunge|jog)|^  [phsi]:|AssertionError|Error:|❯ labs|Tests \" | head -30 | cut -c1-220","description":"Write Island Jog and the finale, then test balance","timeout":500000}}}
