{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjYDs5Efi3GcEyJ6MPsu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012DFGYgn3183fQWpyU5tqVp","name":"Bash","input":{"command":"python3 - <<'EOF'\np='labs/game/scenes/round.ts'\ns=open(p).read()\ns=s.replace(\"import { addBox, defineScene, physicsOf, placeActor, spawnProp, type Intents } from '../../../engine/sim-api';\",\"import { defineScene, physicsOf, placeActor, spawnProp, type Intents } from '../../../engine/sim-api';\")\ns=s.replace(\"  addBox(physicsOf(w), { size: [80, 2, 80], position: [x, FLAT_Y - 1, z], type: 'fixed' } as never);\",\"  physicsOf(w).addBody({ type: 'fixed', position: [x, FLAT_Y - 1, z], colliders: [{ shape: { type: 'box', size: [80, 2, 80] } }] });\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/index.html <<'EOF'\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#bfe9ff\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>Teeter Fit</title>\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #bfe9ff;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        flex-direction: column;\n        gap: 2vh;\n        align-items: center;\n        justify-content: center;\n        padding: 5vh;\n        font: 600 3.4vh ui-rounded, \"SF Pro Rounded\", \"Segoe UI Rounded\", system-ui, sans-serif;\n        color: #3a4a55;\n        text-align: center;\n        pointer-events: none;\n      }\n      #msg b {\n        font-size: 8vh;\n        letter-spacing: 0.02em;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return;\n        window.__engine.errors.push({ code: 'APP_START', message: 'the page failed to start: ' + message, fix: 'the console names the cause' });\n        var msg = document.getElementById('msg');\n        if (msg) msg.innerHTML = '<b>Teeter Fit</b><span>Something went sideways while loading. Please reload.</span>';\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\"><b>Teeter Fit</b><span>Calibrating…</span></div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('main.ts did not load')\"></script>\n  </body>\n</html>\nEOF\ncat > labs/game/cameras/shot.ts <<'EOF'\n/**\n * @file The camera mode `cam3=shot`: a single data-driven camera the page aims each frame (ui/shots.ts): where it stands,\n * what it looks at, its lens and its roll. Every activity's purpose-built camera is a row in that table, and this\n * eases towards it, so one activity's shot blends into the next's with no pop.\n *\n * Game code, a page's: view state, never the sim's.\n *\n * @example\n * // setShot({ at: [0, 3, 8], look: [0, 1, 0], fov: 40 });\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\n/** What a shot asks for. */\nexport interface Shot {\n  at: readonly [number, number, number];\n  look: readonly [number, number, number];\n  fov?: number;\n  roll?: number;\n  /** Time constant of the ease, s; 0 cuts. */\n  ease?: number;\n}\n\n/** The shot asked for: the page writes it each frame. */\nlet wanted: Shot = { at: [0, 30, 120], look: [0, 6, 0], fov: 40, ease: 0 };\n\n/** Aims the camera. */\nexport function setShot(shot: Shot): void {\n  wanted = shot;\n}\n\n/** Its state. */\ninterface State {\n  at: readonly [number, number, number] | null;\n  look: readonly [number, number, number];\n  fov: number;\n  roll: number;\n}\n\n/** The step: ease towards the shot. */\nfunction step(state: State, _input: CameraInput, dt: number): State {\n  const ease = wanted.ease ?? 0.6;\n  const k = ease <= 0 || !state.at ? 1 : 1 - Math.exp(-dt / ease);\n  const mix = (a: readonly number[], b: readonly number[]) => a.map((v, i) => v + (b[i] - v) * k) as unknown as [number, number, number];\n  const from = state.at ?? wanted.at;\n  return {\n    at: mix(from, wanted.at),\n    look: mix(state.at ? state.look : wanted.look, wanted.look),\n    fov: state.fov + ((wanted.fov ?? 45) - state.fov) * k,\n    roll: state.roll + ((wanted.roll ?? 0) - state.roll) * k,\n  };\n}\n\n/** The pose from the state. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? wanted.at;\n  const [lx, ly, lz] = state.look;\n  const [dx, dy, dz] = [lx - x, ly - y, lz - z];\n  const flat = Math.hypot(dx, dz) || 1e-3;\n  return makePose({\n    position: [x, y, z],\n    yaw: Math.atan2(dx, dz),\n    pitch: Math.max(-1.55, Math.min(1.55, Math.atan2(dy, flat))),\n    roll: state.roll,\n    fov: state.fov,\n    distance: Math.hypot(flat, dy),\n    far: 1400,\n  });\n}\n\n/** The camera. */\nexport function shotCamera() {\n  return followCamera('shot', { at: null, look: wanted.look, fov: wanted.fov ?? 45, roll: 0 } as State, {\n    step,\n    pose,\n    spec: () => ({}),\n    code: () => 'cam3=shot',\n    describe: () => 'shot: wherever the page aims it',\n  });\n}\n\ndefineCamera('shot', {\n  description: 'A camera the page aims each frame: the table of purpose-built shots in ui/shots.ts.',\n  create: () => shotCamera(),\n});\nEOF\ncat > labs/game/ui/maps.ts <<'EOF'\n/**\n * @file The action maps (PLAN.md section 4): `balance` for every activity, `balanceFree` with the pointer left visible,\n * `roam` for the island, `front` for menus. Pause and the menu's keys are the engine's system layer.\n *\n * Game code, a page's.\n *\n * @example\n * // engine.input.use('actionMap:roam');\n */\nimport { defineActionMap } from '../../../engine';\n\n/** The walk block every map shares: world-space move from keys and the left stick. */\nconst WALK = {\n  forward: ['KeyW', 'ArrowUp', 'PadUp', 'PadLeftStickUp'],\n  back: ['KeyS', 'ArrowDown', 'PadDown', 'PadLeftStickDown'],\n  left: ['KeyA', 'ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\n  right: ['KeyD', 'ArrowRight', 'PadRight', 'PadLeftStickRight'],\n};\n\n/** The feet and the rest, for balancing. */\nconst BALANCE_ACTIONS = {\n  ...WALK,\n  footl: ['KeyQ', 'MouseLeft', 'PadLeftTrigger', 'PadLeftShoulder', 'Space'],\n  footr: ['KeyE', 'MouseRight', 'PadRightTrigger', 'PadRightShoulder', 'Space'],\n  gentle: ['ShiftLeft', 'ShiftRight'],\n  act: ['KeyF', 'Enter', 'PadSouth', 'PadEast', 'PadWest', 'PadNorth'],\n};\n\n/** The values the sim reads raw. */\nconst BALANCE_VALUES = { 'game:r': 'right', 'game:l': 'left', 'game:f': 'forward', 'game:b': 'back', 'game:fl': 'footl', 'game:fr': 'footr' };\n\ndefineActionMap('actionMap:balance', {\n  description: 'The lean, the two feet, and anything else, which still pond punishes.',\n  actions: BALANCE_ACTIONS,\n  values: BALANCE_VALUES,\n  lock: true,\n});\n\ndefineActionMap('actionMap:balanceFree', {\n  description: 'The same, with the pointer visible: Sand Garden reads where it is.',\n  actions: BALANCE_ACTIONS,\n  values: BALANCE_VALUES,\n  lock: false,\n});\n\ndefineActionMap('actionMap:roam', {\n  description: 'Walking the island: move, hop, talk, the Programme, wave.',\n  actions: {\n    ...WALK,\n    jump: ['Space', 'PadWest'],\n    use: ['KeyE', 'Enter', 'MouseLeft', 'PadSouth'],\n    walk: ['ShiftLeft', 'ShiftRight'],\n    plan: ['Tab', 'PadNorth'],\n    wave: ['KeyC', 'PadEast'],\n  },\n  lock: true,\n});\n\ndefineActionMap('actionMap:front', {\n  description: 'Front-end screens: nothing reaches play; a click takes no pointer.',\n  actions: {},\n  lock: false,\n});\nEOF\ncat > labs/game/hub/session.ts <<'EOF'\n/**\n * @file AI Hub Session Protocol v1, ghost mode (PLAN.md section 9): the page's half of a hub round. It answers the card,\n * starts the round on the hub's clock, sends this player's lean and score, feeds the other copies to the sim as ghosts,\n * and reports the result. It owns nothing in the sim but the scene actions and `game:ghosts`.\n *\n * Game code, a page's.\n *\n * @example\n * // const hub = await startSession(); // null outside a session\n */\nimport type { Engine, EngineFrame } from '../../../engine';\n\n/** A player, as the hub says. */\nexport interface HubPlayer {\n  id: number;\n  name: string;\n  color: string;\n}\n\n/** What `connect` gives. */\nexport interface HubInfo {\n  me: number;\n  players: HubPlayer[];\n  seed: number;\n  mode: string;\n  limitMs: number;\n  isHost: boolean;\n}\n\n/** The hub's client, as much of it as the game uses. */\nexport interface HubClient {\n  active: boolean;\n  connect(options: { mode: string; seats: [number, number]; card?: boolean }): Promise<HubInfo | null>;\n  ready(): void;\n  answer(what: 'ready' | 'more'): void;\n  time(): number;\n  on(event: string, fn: (...args: never[]) => void): () => void;\n  progress(data: { score: number; label: string }): void;\n  result(data: { score: number; stats?: Record<string, string | number>; awards?: { title: string; detail: string }[] }): void;\n  send(data: unknown, options?: { reliable?: boolean; to?: number }): boolean;\n  fail(message: string): void;\n  rng(label: string): () => number;\n}\n\n/** The hub's client, when the page has one. */\nexport const hubClient = (): HubClient | null => (window as unknown as { AIHub?: HubClient }).AIHub ?? null;\n\n/** What a ghost message carries. */\ninterface GhostMsg {\n  t: 'g';\n  e: number;\n  x: number;\n  y: number;\n  p: string;\n  s: number;\n}\n\n/** A running session's page state. */\nexport class Session {\n  readonly hub: HubClient;\n  readonly info: HubInfo;\n  /** Who else is here: their latest message. */\n  readonly others = new Map<number, GhostMsg & { id: number; gone?: boolean }>();\n  /** The card's latest state. */\n  card: { left: number | null; paused?: boolean; starting?: boolean; ready: number[]; asking: number; asked?: boolean } | null = null;\n  started = false;\n  playing = false;\n  ended = false;\n  reported = false;\n  answered = false;\n  private lastSend = 0;\n  private lastScore = -1;\n  private lastLabel = '';\n  private dirty = false;\n  private started0 = false;\n  onEnd: () => void = () => {};\n  onStart: () => void = () => {};\n\n  constructor(hub: HubClient, info: HubInfo) {\n    this.hub = hub;\n    this.info = info;\n    hub.on('card', ((card: Session['card']) => {\n      this.card = card;\n    }) as never);\n    hub.on('start', (() => {\n      this.started = true;\n      this.hub.progress({ score: 0, label: 'Breathing in' });\n      this.hub.send({ t: 'g', e: 0, x: 0, y: 0, p: '', s: 0 } satisfies GhostMsg, { reliable: false });\n      this.onStart();\n    }) as never);\n    hub.on('message', ((data: GhostMsg, from: number) => {\n      if (data?.t === 'g') {\n        this.others.set(from, { ...data, id: from });\n        this.dirty = true;\n      }\n    }) as never);\n    hub.on('leave', ((event: { id: number }) => {\n      const other = this.others.get(event.id) ?? { t: 'g' as const, e: 0, x: 0, y: 0, p: '', s: 0, id: event.id };\n      this.others.set(event.id, { ...other, gone: true });\n      this.engine?.inspector?.actions && (this.engine.inspector.actions as { run(n: string, a: unknown): void }).run('round.leave', { id: event.id });\n    }) as never);\n    hub.on('time-up', (() => this.report()) as never);\n    hub.on('end', (() => {\n      this.ended = true;\n      this.report();\n      this.onEnd();\n    }) as never);\n  }\n\n  engine: Engine | null = null;\n\n  /** The current numbers, set by the page each frame. */\n  now = { classIndex: 0, x: 0, y: 0, pose: '', total: 0, label: 'Breathing in', done: false, stats: {} as Record<string, string | number>, awards: [] as { title: string; detail: string }[] };\n\n  /** Reports the score, once. */\n  report(): void {\n    if (this.reported) return;\n    this.reported = true;\n    this.hub.result({ score: Math.round(this.now.total), stats: this.now.stats, awards: this.now.awards });\n  }\n\n  /** One frame: start at time 0, send ghosts every 100 ms, progress when it changes. */\n  frame(frame: EngineFrame): void {\n    if (this.ended) return;\n    const inspector = this.engine?.inspector;\n    const actions = inspector?.actions as { run(n: string, a?: unknown): void } | undefined;\n    if (this.started && !this.playing && this.hub.time() >= 0) {\n      this.playing = true;\n      if (!this.started0) {\n        this.started0 = true;\n        actions?.run('round.go', { me: this.info.me });\n      }\n    }\n    if (this.dirty) {\n      this.dirty = false;\n      this.engine?.input?.virtual.axis('game:ghosts', [...this.others.values()].map(({ id, e, x, y, p, s, gone }) => ({ id, e, x, y, p, s, gone: gone ?? false })));\n    }\n    if (!this.playing) return;\n    const time = performance.now();\n    if (time - this.lastSend >= 100) {\n      this.lastSend = time;\n      const { classIndex, x, y, pose, total } = this.now;\n      this.hub.send({ t: 'g', e: classIndex, x, y, p: pose, s: total } satisfies GhostMsg, { reliable: false });\n    }\n    if (this.now.total !== this.lastScore || this.now.label !== this.lastLabel) {\n      this.lastScore = this.now.total;\n      this.lastLabel = this.now.label;\n      this.hub.progress({ score: Math.round(this.now.total), label: this.now.label.slice(0, 24) });\n    }\n    if (this.now.done) this.report();\n    void frame;\n  }\n}\nEOF\ncat > labs/game/main.ts <<'EOF'\n/**\n * @file Teeter Fit's page: it connects to the hub when opened by one, starts the engine on `game:island` (or the small\n * `game:round` in a session), and hands every drawn frame to the app (ui/app.ts). Everything drawn is a sim entity;\n * everything else is HTML under the overlay.\n *\n * Game code, a page's: it imports only the engine's public API and the game's own files.\n *\n * Open it from the built single file on file://, or `npm run dev` at /labs/game/.\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, createStore, type Engine } from '../../engine';\nimport './cast/index';\nimport './scenes/island';\nimport './scenes/round';\nimport './materials/retreat';\nimport './looks/retreat';\nimport './bodies/cast';\nimport './cameras/shot';\nimport './ui/maps';\nimport './ui/theme.css';\nimport { Session, hubClient } from './hub/session';\nimport { App } from './ui/app';\nimport { hasWebGpu, showNoWebGpu } from './ui/nogpu';\n\nconst search = new URLSearchParams(location.search);\nfor (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key);\nsearch.set('touch', 'off');\nif (!search.has('post.look')) search.set('post.look', 'look:retreat');\n\nconst hub = hubClient();\nconst inSession = Boolean(hub?.active);\nconst info = hub && inSession ? await hub.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\nif (info) {\n  search.set('scene', 'game:round');\n  search.set('seed', String(info.seed));\n  search.set('cam3', 'shot');\n} else if (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'shot');\n\nconst watchdog = info ? setTimeout(() => hub?.ready(), 14000) : 0;\nlet readyCalled = false;\nconst callReady = (): void => {\n  if (readyCalled) return;\n  readyCalled = true;\n  clearTimeout(watchdog);\n  hub?.ready();\n};\nif (info) setTimeout(callReady, 14000);\n\nconst canvas = document.querySelector<HTMLCanvasElement>('#view')!;\nconst session = info && hub ? new Session(hub, info) : null;\nconst app = new App(session, search);\n\nif (!(await hasWebGpu())) {\n  if (info) hub?.fail('WebGPU required');\n  showNoWebGpu();\n} else {\n  let engine: Engine | null = null;\n  const store = createStore({ prefix: 'teeter-fit:', mode: search.has('replay') ? 'demo' : 'play' });\n  engine = await createEngine({\n    canvas,\n    scenes: ['game:island', 'game:round'],\n    search: `?${search}`,\n    store,\n    modal: () => app.modal(),\n    cameraInput: () => app.cameraInput(),\n    onFrame: (frame) => app.frame(frame),\n    actionMap: () => app.mapName(),\n  });\n  if (session) session.engine = engine;\n  app.attach(engine, store);\n  if (info) {\n    callReady();\n    if (!engine.ready && !engine.inspector) hub?.fail('WebGPU required');\n  }\n  const msg = document.getElementById('msg');\n  if (msg) msg.hidden = true;\n}\nEOF\ncat > labs/game/ui/nogpu.ts <<'EOF'\n/**\n * @file The friendly page for a browser with no WebGPU: never a blank page.\n *\n * Game code, a page's.\n *\n * @example\n * // if (!(await hasWebGpu())) showNoWebGpu();\n */\n\n/** Whether this browser can give an adapter. */\nexport async function hasWebGpu(): Promise<boolean> {\n  const gpu = (navigator as unknown as { gpu?: { requestAdapter(): Promise<unknown> } }).gpu;\n  if (!gpu) return false;\n  try {\n    return Boolean(await gpu.requestAdapter());\n  } catch {\n    return false;\n  }\n}\n\n/** Shows the page. */\nexport function showNoWebGpu(): void {\n  const msg = document.getElementById('msg');\n  if (!msg) return;\n  msg.hidden = false;\n  msg.innerHTML = '<b>Teeter Fit</b><span>This game needs a browser with WebGPU, such as current Chrome or Edge.</span>';\n  const canvas = document.querySelector('canvas');\n  if (canvas) canvas.style.display = 'none';\n}\nEOF\nawk '/function clipsFor/,/^}/' engine/sim/actorClips.ts | head -20 | cut -c1-140; grep -n \"actionMap\" engine/app/*.ts | head -12 | cut -c1-170; grep -n \"readonly actions\\|actions:\" engine/dev/actions.ts | head -5","description":"Write page entry, hub session, camera, and action maps"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11137,"cache_read_input_tokens":349297,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11137},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"aa355327-fb1a-469a-b729-981c30f1caed","timestamp":"2026-11-05T09:25:17.745Z","request_id":"req_011CgjYDrocLpJF7YPzUAsKH","wire_tool_inputs":{"toolu_012DFGYgn3183fQWpyU5tqVp":{"command":"python3 - <<'EOF'\np='labs/game/scenes/round.ts'\ns=open(p).read()\ns=s.replace(\"import { addBox, defineScene, physicsOf, placeActor, spawnProp, type Intents } from '../../../engine/sim-api';\",\"import { defineScene, physicsOf, placeActor, spawnProp, type Intents } from '../../../engine/sim-api';\")\ns=s.replace(\"  addBox(physicsOf(w), { size: [80, 2, 80], position: [x, FLAT_Y - 1, z], type: 'fixed' } as never);\",\"  physicsOf(w).addBody({ type: 'fixed', position: [x, FLAT_Y - 1, z], colliders: [{ shape: { type: 'box', size: [80, 2, 80] } }] });\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/index.html <<'EOF'\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#bfe9ff\" />\n    <link rel=\"icon\" href=\"data:,\" />\n    <title>Teeter Fit</title>\n    <style>\n      html,\n      body {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n        background: #bfe9ff;\n      }\n      canvas {\n        display: block;\n        width: 100vw;\n        height: 100vh;\n        height: 100dvh;\n        outline: none;\n        touch-action: none;\n      }\n      #msg {\n        position: fixed;\n        inset: 0;\n        display: flex;\n        flex-direction: column;\n        gap: 2vh;\n        align-items: center;\n        justify-content: center;\n        padding: 5vh;\n        font: 600 3.4vh ui-rounded, \"SF Pro Rounded\", \"Segoe UI Rounded\", system-ui, sans-serif;\n        color: #3a4a55;\n        text-align: center;\n        pointer-events: none;\n      }\n      #msg b {\n        font-size: 8vh;\n        letter-spacing: 0.02em;\n      }\n      #msg[hidden] {\n        display: none;\n      }\n    </style>\n    <script>\n      window.__engine = { ready: false, errors: [] };\n      function gameFailed(message) {\n        if (!window.__engine || typeof window.__engine.help === 'function') return;\n        window.__engine.errors.push({ code: 'APP_START', message: 'the page failed to start: ' + message, fix: 'the console names the cause' });\n        var msg = document.getElementById('msg');\n        if (msg) msg.innerHTML = '<b>Teeter Fit</b><span>Something went sideways while loading. Please reload.</span>';\n      }\n      addEventListener('error', function (event) {\n        gameFailed(event.message || 'a script failed');\n      });\n      addEventListener('unhandledrejection', function (event) {\n        gameFailed(String((event.reason && event.reason.message) || event.reason));\n      });\n    </script>\n  </head>\n  <body>\n    <canvas id=\"view\"></canvas>\n    <div id=\"msg\" role=\"status\" aria-live=\"polite\"><b>Teeter Fit</b><span>Calibrating…</span></div>\n    <script type=\"module\" src=\"./main.ts\" onerror=\"gameFailed('main.ts did not load')\"></script>\n  </body>\n</html>\nEOF\ncat > labs/game/cameras/shot.ts <<'EOF'\n/**\n * @file The camera mode `cam3=shot`: a single data-driven camera the page aims each frame (ui/shots.ts): where it stands,\n * what it looks at, its lens and its roll. Every activity's purpose-built camera is a row in that table, and this\n * eases towards it, so one activity's shot blends into the next's with no pop.\n *\n * Game code, a page's: view state, never the sim's.\n *\n * @example\n * // setShot({ at: [0, 3, 8], look: [0, 1, 0], fov: 40 });\n */\nimport { defineCamera, followCamera, makePose, type CameraInput, type CameraPose } from '../../../engine';\n\n/** What a shot asks for. */\nexport interface Shot {\n  at: readonly [number, number, number];\n  look: readonly [number, number, number];\n  fov?: number;\n  roll?: number;\n  /** Time constant of the ease, s; 0 cuts. */\n  ease?: number;\n}\n\n/** The shot asked for: the page writes it each frame. */\nlet wanted: Shot = { at: [0, 30, 120], look: [0, 6, 0], fov: 40, ease: 0 };\n\n/** Aims the camera. */\nexport function setShot(shot: Shot): void {\n  wanted = shot;\n}\n\n/** Its state. */\ninterface State {\n  at: readonly [number, number, number] | null;\n  look: readonly [number, number, number];\n  fov: number;\n  roll: number;\n}\n\n/** The step: ease towards the shot. */\nfunction step(state: State, _input: CameraInput, dt: number): State {\n  const ease = wanted.ease ?? 0.6;\n  const k = ease <= 0 || !state.at ? 1 : 1 - Math.exp(-dt / ease);\n  const mix = (a: readonly number[], b: readonly number[]) => a.map((v, i) => v + (b[i] - v) * k) as unknown as [number, number, number];\n  const from = state.at ?? wanted.at;\n  return {\n    at: mix(from, wanted.at),\n    look: mix(state.at ? state.look : wanted.look, wanted.look),\n    fov: state.fov + ((wanted.fov ?? 45) - state.fov) * k,\n    roll: state.roll + ((wanted.roll ?? 0) - state.roll) * k,\n  };\n}\n\n/** The pose from the state. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? wanted.at;\n  const [lx, ly, lz] = state.look;\n  const [dx, dy, dz] = [lx - x, ly - y, lz - z];\n  const flat = Math.hypot(dx, dz) || 1e-3;\n  return makePose({\n    position: [x, y, z],\n    yaw: Math.atan2(dx, dz),\n    pitch: Math.max(-1.55, Math.min(1.55, Math.atan2(dy, flat))),\n    roll: state.roll,\n    fov: state.fov,\n    distance: Math.hypot(flat, dy),\n    far: 1400,\n  });\n}\n\n/** The camera. */\nexport function shotCamera() {\n  return followCamera('shot', { at: null, look: wanted.look, fov: wanted.fov ?? 45, roll: 0 } as State, {\n    step,\n    pose,\n    spec: () => ({}),\n    code: () => 'cam3=shot',\n    describe: () => 'shot: wherever the page aims it',\n  });\n}\n\ndefineCamera('shot', {\n  description: 'A camera the page aims each frame: the table of purpose-built shots in ui/shots.ts.',\n  create: () => shotCamera(),\n});\nEOF\ncat > labs/game/ui/maps.ts <<'EOF'\n/**\n * @file The action maps (PLAN.md section 4): `balance` for every activity, `balanceFree` with the pointer left visible,\n * `roam` for the island, `front` for menus. Pause and the menu's keys are the engine's system layer.\n *\n * Game code, a page's.\n *\n * @example\n * // engine.input.use('actionMap:roam');\n */\nimport { defineActionMap } from '../../../engine';\n\n/** The walk block every map shares: world-space move from keys and the left stick. */\nconst WALK = {\n  forward: ['KeyW', 'ArrowUp', 'PadUp', 'PadLeftStickUp'],\n  back: ['KeyS', 'ArrowDown', 'PadDown', 'PadLeftStickDown'],\n  left: ['KeyA', 'ArrowLeft', 'PadLeft', 'PadLeftStickLeft'],\n  right: ['KeyD', 'ArrowRight', 'PadRight', 'PadLeftStickRight'],\n};\n\n/** The feet and the rest, for balancing. */\nconst BALANCE_ACTIONS = {\n  ...WALK,\n  footl: ['KeyQ', 'MouseLeft', 'PadLeftTrigger', 'PadLeftShoulder', 'Space'],\n  footr: ['KeyE', 'MouseRight', 'PadRightTrigger', 'PadRightShoulder', 'Space'],\n  gentle: ['ShiftLeft', 'ShiftRight'],\n  act: ['KeyF', 'Enter', 'PadSouth', 'PadEast', 'PadWest', 'PadNorth'],\n};\n\n/** The values the sim reads raw. */\nconst BALANCE_VALUES = { 'game:r': 'right', 'game:l': 'left', 'game:f': 'forward', 'game:b': 'back', 'game:fl': 'footl', 'game:fr': 'footr' };\n\ndefineActionMap('actionMap:balance', {\n  description: 'The lean, the two feet, and anything else, which still pond punishes.',\n  actions: BALANCE_ACTIONS,\n  values: BALANCE_VALUES,\n  lock: true,\n});\n\ndefineActionMap('actionMap:balanceFree', {\n  description: 'The same, with the pointer visible: Sand Garden reads where it is.',\n  actions: BALANCE_ACTIONS,\n  values: BALANCE_VALUES,\n  lock: false,\n});\n\ndefineActionMap('actionMap:roam', {\n  description: 'Walking the island: move, hop, talk, the Programme, wave.',\n  actions: {\n    ...WALK,\n    jump: ['Space', 'PadWest'],\n    use: ['KeyE', 'Enter', 'MouseLeft', 'PadSouth'],\n    walk: ['ShiftLeft', 'ShiftRight'],\n    plan: ['Tab', 'PadNorth'],\n    wave: ['KeyC', 'PadEast'],\n  },\n  lock: true,\n});\n\ndefineActionMap('actionMap:front', {\n  description: 'Front-end screens: nothing reaches play; a click takes no pointer.',\n  actions: {},\n  lock: false,\n});\nEOF\ncat > labs/game/hub/session.ts <<'EOF'\n/**\n * @file AI Hub Session Protocol v1, ghost mode (PLAN.md section 9): the page's half of a hub round. It answers the card,\n * starts the round on the hub's clock, sends this player's lean and score, feeds the other copies to the sim as ghosts,\n * and reports the result. It owns nothing in the sim but the scene actions and `game:ghosts`.\n *\n * Game code, a page's.\n *\n * @example\n * // const hub = await startSession(); // null outside a session\n */\nimport type { Engine, EngineFrame } from '../../../engine';\n\n/** A player, as the hub says. */\nexport interface HubPlayer {\n  id: number;\n  name: string;\n  color: string;\n}\n\n/** What `connect` gives. */\nexport interface HubInfo {\n  me: number;\n  players: HubPlayer[];\n  seed: number;\n  mode: string;\n  limitMs: number;\n  isHost: boolean;\n}\n\n/** The hub's client, as much of it as the game uses. */\nexport interface HubClient {\n  active: boolean;\n  connect(options: { mode: string; seats: [number, number]; card?: boolean }): Promise<HubInfo | null>;\n  ready(): void;\n  answer(what: 'ready' | 'more'): void;\n  time(): number;\n  on(event: string, fn: (...args: never[]) => void): () => void;\n  progress(data: { score: number; label: string }): void;\n  result(data: { score: number; stats?: Record<string, string | number>; awards?: { title: string; detail: string }[] }): void;\n  send(data: unknown, options?: { reliable?: boolean; to?: number }): boolean;\n  fail(message: string): void;\n  rng(label: string): () => number;\n}\n\n/** The hub's client, when the page has one. */\nexport const hubClient = (): HubClient | null => (window as unknown as { AIHub?: HubClient }).AIHub ?? null;\n\n/** What a ghost message carries. */\ninterface GhostMsg {\n  t: 'g';\n  e: number;\n  x: number;\n  y: number;\n  p: string;\n  s: number;\n}\n\n/** A running session's page state. */\nexport class Session {\n  readonly hub: HubClient;\n  readonly info: HubInfo;\n  /** Who else is here: their latest message. */\n  readonly others = new Map<number, GhostMsg & { id: number; gone?: boolean }>();\n  /** The card's latest state. */\n  card: { left: number | null; paused?: boolean; starting?: boolean; ready: number[]; asking: number; asked?: boolean } | null = null;\n  started = false;\n  playing = false;\n  ended = false;\n  reported = false;\n  answered = false;\n  private lastSend = 0;\n  private lastScore = -1;\n  private lastLabel = '';\n  private dirty = false;\n  private started0 = false;\n  onEnd: () => void = () => {};\n  onStart: () => void = () => {};\n\n  constructor(hub: HubClient, info: HubInfo) {\n    this.hub = hub;\n    this.info = info;\n    hub.on('card', ((card: Session['card']) => {\n      this.card = card;\n    }) as never);\n    hub.on('start', (() => {\n      this.started = true;\n      this.hub.progress({ score: 0, label: 'Breathing in' });\n      this.hub.send({ t: 'g', e: 0, x: 0, y: 0, p: '', s: 0 } satisfies GhostMsg, { reliable: false });\n      this.onStart();\n    }) as never);\n    hub.on('message', ((data: GhostMsg, from: number) => {\n      if (data?.t === 'g') {\n        this.others.set(from, { ...data, id: from });\n        this.dirty = true;\n      }\n    }) as never);\n    hub.on('leave', ((event: { id: number }) => {\n      const other = this.others.get(event.id) ?? { t: 'g' as const, e: 0, x: 0, y: 0, p: '', s: 0, id: event.id };\n      this.others.set(event.id, { ...other, gone: true });\n      this.engine?.inspector?.actions && (this.engine.inspector.actions as { run(n: string, a: unknown): void }).run('round.leave', { id: event.id });\n    }) as never);\n    hub.on('time-up', (() => this.report()) as never);\n    hub.on('end', (() => {\n      this.ended = true;\n      this.report();\n      this.onEnd();\n    }) as never);\n  }\n\n  engine: Engine | null = null;\n\n  /** The current numbers, set by the page each frame. */\n  now = { classIndex: 0, x: 0, y: 0, pose: '', total: 0, label: 'Breathing in', done: false, stats: {} as Record<string, string | number>, awards: [] as { title: string; detail: string }[] };\n\n  /** Reports the score, once. */\n  report(): void {\n    if (this.reported) return;\n    this.reported = true;\n    this.hub.result({ score: Math.round(this.now.total), stats: this.now.stats, awards: this.now.awards });\n  }\n\n  /** One frame: start at time 0, send ghosts every 100 ms, progress when it changes. */\n  frame(frame: EngineFrame): void {\n    if (this.ended) return;\n    const inspector = this.engine?.inspector;\n    const actions = inspector?.actions as { run(n: string, a?: unknown): void } | undefined;\n    if (this.started && !this.playing && this.hub.time() >= 0) {\n      this.playing = true;\n      if (!this.started0) {\n        this.started0 = true;\n        actions?.run('round.go', { me: this.info.me });\n      }\n    }\n    if (this.dirty) {\n      this.dirty = false;\n      this.engine?.input?.virtual.axis('game:ghosts', [...this.others.values()].map(({ id, e, x, y, p, s, gone }) => ({ id, e, x, y, p, s, gone: gone ?? false })));\n    }\n    if (!this.playing) return;\n    const time = performance.now();\n    if (time - this.lastSend >= 100) {\n      this.lastSend = time;\n      const { classIndex, x, y, pose, total } = this.now;\n      this.hub.send({ t: 'g', e: classIndex, x, y, p: pose, s: total } satisfies GhostMsg, { reliable: false });\n    }\n    if (this.now.total !== this.lastScore || this.now.label !== this.lastLabel) {\n      this.lastScore = this.now.total;\n      this.lastLabel = this.now.label;\n      this.hub.progress({ score: Math.round(this.now.total), label: this.now.label.slice(0, 24) });\n    }\n    if (this.now.done) this.report();\n    void frame;\n  }\n}\nEOF\ncat > labs/game/main.ts <<'EOF'\n/**\n * @file Teeter Fit's page: it connects to the hub when opened by one, starts the engine on `game:island` (or the small\n * `game:round` in a session), and hands every drawn frame to the app (ui/app.ts). Everything drawn is a sim entity;\n * everything else is HTML under the overlay.\n *\n * Game code, a page's: it imports only the engine's public API and the game's own files.\n *\n * Open it from the built single file on file://, or `npm run dev` at /labs/game/.\n */\n/// <reference types=\"vite/client\" />\nimport { createEngine, createStore, type Engine } from '../../engine';\nimport './cast/index';\nimport './scenes/island';\nimport './scenes/round';\nimport './materials/retreat';\nimport './looks/retreat';\nimport './bodies/cast';\nimport './cameras/shot';\nimport './ui/maps';\nimport './ui/theme.css';\nimport { Session, hubClient } from './hub/session';\nimport { App } from './ui/app';\nimport { hasWebGpu, showNoWebGpu } from './ui/nogpu';\n\nconst search = new URLSearchParams(location.search);\nfor (const key of [...search.keys()]) if (key.startsWith('aihub')) search.delete(key);\nsearch.set('touch', 'off');\nif (!search.has('post.look')) search.set('post.look', 'look:retreat');\n\nconst hub = hubClient();\nconst inSession = Boolean(hub?.active);\nconst info = hub && inSession ? await hub.connect({ mode: 'ghost', seats: [1, 4], card: true }) : null;\nif (info) {\n  search.set('scene', 'game:round');\n  search.set('seed', String(info.seed));\n  search.set('cam3', 'shot');\n} else if (!search.has('cam') && !search.has('cam3')) search.set('cam3', 'shot');\n\nconst watchdog = info ? setTimeout(() => hub?.ready(), 14000) : 0;\nlet readyCalled = false;\nconst callReady = (): void => {\n  if (readyCalled) return;\n  readyCalled = true;\n  clearTimeout(watchdog);\n  hub?.ready();\n};\nif (info) setTimeout(callReady, 14000);\n\nconst canvas = document.querySelector<HTMLCanvasElement>('#view')!;\nconst session = info && hub ? new Session(hub, info) : null;\nconst app = new App(session, search);\n\nif (!(await hasWebGpu())) {\n  if (info) hub?.fail('WebGPU required');\n  showNoWebGpu();\n} else {\n  let engine: Engine | null = null;\n  const store = createStore({ prefix: 'teeter-fit:', mode: search.has('replay') ? 'demo' : 'play' });\n  engine = await createEngine({\n    canvas,\n    scenes: ['game:island', 'game:round'],\n    search: `?${search}`,\n    store,\n    modal: () => app.modal(),\n    cameraInput: () => app.cameraInput(),\n    onFrame: (frame) => app.frame(frame),\n    actionMap: () => app.mapName(),\n  });\n  if (session) session.engine = engine;\n  app.attach(engine, store);\n  if (info) {\n    callReady();\n    if (!engine.ready && !engine.inspector) hub?.fail('WebGPU required');\n  }\n  const msg = document.getElementById('msg');\n  if (msg) msg.hidden = true;\n}\nEOF\ncat > labs/game/ui/nogpu.ts <<'EOF'\n/**\n * @file The friendly page for a browser with no WebGPU: never a blank page.\n *\n * Game code, a page's.\n *\n * @example\n * // if (!(await hasWebGpu())) showNoWebGpu();\n */\n\n/** Whether this browser can give an adapter. */\nexport async function hasWebGpu(): Promise<boolean> {\n  const gpu = (navigator as unknown as { gpu?: { requestAdapter(): Promise<unknown> } }).gpu;\n  if (!gpu) return false;\n  try {\n    return Boolean(await gpu.requestAdapter());\n  } catch {\n    return false;\n  }\n}\n\n/** Shows the page. */\nexport function showNoWebGpu(): void {\n  const msg = document.getElementById('msg');\n  if (!msg) return;\n  msg.hidden = false;\n  msg.innerHTML = '<b>Teeter Fit</b><span>This game needs a browser with WebGPU, such as current Chrome or Edge.</span>';\n  const canvas = document.querySelector('canvas');\n  if (canvas) canvas.style.display = 'none';\n}\nEOF\nawk '/function clipsFor/,/^}/' engine/sim/actorClips.ts | head -20 | cut -c1-140; grep -n \"actionMap\" engine/app/*.ts | head -12 | cut -c1-170; grep -n \"readonly actions\\|actions:\" engine/dev/actions.ts | head -5","description":"Write page entry, hub session, camera, and action maps"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012DFGYgn3183fQWpyU5tqVp","type":"tool_result","content":"export function clipsFor<C extends object>(world: World<C>, spec: ClipsSpec, build: Build | string): ClipsData {\n  const w = world as unknown as World;\n  const pool = poolOf(w);\n  const library = spec.sets.map((set) => pool.library(set));\n  if (!w.systems.has('actors.clips')) w.systems.add('actors.clips', stepClips, { phase: 'anim' });\n  const data = { sets: [...spec.sets], ik: spec.ik ?? true, blade: spec.blade ?? 0, state: emptyClipState() };\n  if (spec.play === undefined) return data;\n  const { clip, ...play } = typeof spec.play === 'string' ? { clip: spec.play } : spec.play;\n  const layer = new ClipLayer({ library, build, dt: w.dt, ik: data.ik, blade: data.blade }).play(clip, play);\n  return { ...data, state: layer.save() };\n}\nengine/app/engine.ts:129:   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\nengine/app/engine.ts:132:  actionMap?: string | ((camera: string) => string);\nengine/app/engine.ts:304:    const asked = options.actionMap;\nengine/app/engine.ts:305:    return (typeof asked === 'function' ? asked(viewNow().camera.code()) : asked) ?? 'actionMap:thirdPerson';\n57:  help: \"Lists the run's dev actions: the scene's own, then the engine's (god, freeze, spawn, travel, timeScale).\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"218d147c-ba6e-4232-ac8d-500791d5e0b4","timestamp":"2026-11-05T09:25:17.908Z","tool_use_result":{"stdout":"export function clipsFor<C extends object>(world: World<C>, spec: ClipsSpec, build: Build | string): ClipsData {\n  const w = world as unknown as World;\n  const pool = poolOf(w);\n  const library = spec.sets.map((set) => pool.library(set));\n  if (!w.systems.has('actors.clips')) w.systems.add('actors.clips', stepClips, { phase: 'anim' });\n  const data = { sets: [...spec.sets], ik: spec.ik ?? true, blade: spec.blade ?? 0, state: emptyClipState() };\n  if (spec.play === undefined) return data;\n  const { clip, ...play } = typeof spec.play === 'string' ? { clip: spec.play } : spec.play;\n  const layer = new ClipLayer({ library, build, dt: w.dt, ik: data.ik, blade: data.blade }).play(clip, play);\n  return { ...data, state: layer.save() };\n}\nengine/app/engine.ts:129:   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\nengine/app/engine.ts:132:  actionMap?: string | ((camera: string) => string);\nengine/app/engine.ts:304:    const asked = options.actionMap;\nengine/app/engine.ts:305:    return (typeof asked === 'function' ? asked(viewNow().camera.code()) : asked) ?? 'actionMap:thirdPerson';\n57:  help: \"Lists the run's dev actions: the scene's own, then the engine's (god, freeze, spawn, travel, timeScale).\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012DFGYgn3183fQWpyU5tqVp","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
