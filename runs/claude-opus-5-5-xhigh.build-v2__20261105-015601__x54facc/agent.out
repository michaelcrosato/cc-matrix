   const key = `${this.host.device()}|${this.host.glyphs()}`;\"\"\",\"\"\"  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n    if (!this.woken && this.host.sawInput()) {\n      this.woken = true;\n      this.wakeHint.style.display = 'none';\n    }\n    const key = `${this.host.device()}|${this.host.glyphs()}`;\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/screens/types.ts'\ns=open(p).read()\ns=s.replace(\"  /** The sim's flow now. */\",\"  /** Whether anyone has pressed anything yet. */\\n  sawInput(): boolean;\\n  /** The sim's flow now. */\",1)\nopen(p,'w').write(s)\np='labs/game/ui/screens/settings.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    this.panel = new Panel(this.el, {\n      id: 'settings',\n      title: 'Settings',\n      rows,\"\"\",\"\"\"    rows.push({ id: 'back', label: 'Back' });\n    this.panel = new Panel(this.el, {\n      id: 'settings',\n      title: 'Settings',\n      rows,\"\"\")\ns=s.replace(\"\"\"        if (id === 'erase') this.askErase();\n      },\"\"\",\"\"\"        if (id === 'erase') this.askErase();\n        if (id === 'back') host.close(this);\n      },\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/app.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    this.title?.show(false);\n    this.act('game.begin', { roam: false });\"\"\",\"\"\"    this.title?.show(false, true);\n    this.act('game.begin', { roam: false });\"\"\")\ns=s.replace(\"\"\"  setting(path: string): unknown {\"\"\",\"\"\"  sawInput(): boolean {\n    return this.inputSeen;\n  }\n  setting(path: string): unknown {\"\"\")\ns=s.replace(\"  frameCount = 0;\\n\",\"  frameCount = 0;\\n  inputSeen = false;\\n\")\ns=s.replace(\"\"\"      if (!pressed) continue;\n      this.device_ = 'gamepad';\"\"\",\"\"\"      if (!pressed) continue;\n      this.device_ = 'gamepad';\n      this.inputSeen = true;\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/appInput.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  addEventListener('keydown', () => {\n    app.device_ = 'keyboar