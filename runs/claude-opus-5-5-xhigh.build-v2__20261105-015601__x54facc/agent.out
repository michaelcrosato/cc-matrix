 flags under it: r182\n29: * `unpackFlags` are inverse for every part, group 1..511 and pixel-art flag; a tag takes effect on the next frame,\n30: * whether or not the object moves; slot 0 is never given out and always holds the environment's flags.\n34: * unpackFlags(-1031); // { part: 'object', group: 7, pixelArt: true }\n46:export const PARTS = ['character', 'object', 'environment'] as const;\n48:/** A part of the scene: a character (puppets, the hero), an object (props, entities) or the environment. */\n52:export const PART_BITS: Readonly<Record<Part, number>> = { character: 1, object: 2, environment: 4 };\n57:/** The packed value's bits: +512 on characters, +1024 on characters and objects. */\n63:  /** The outline group: pixels of different groups are outlined where they meet; folded into 1..511. */\n64:  group?: number;\n== who sets the group\nengine/gfx/sky.ts:199:    knob.setGroup(renderGroup);\nengine/gfx/sky.ts:200:  const exposure = uniform(1).setGroup(renderGroup);\nengine/gfx/sky.ts:203:  for (const knob of [gradient, zenith, horizon]) knob.setGroup(renderGroup);\nengine/gfx/shadows.ts:122:export const SHADOW_GRID = uniform(new Vector3(0, 0, 1)).setGroup(renderGroup);\nengine/gfx/shadows.ts:127:/** A shadow's `name` field as the render group's uniform, as r182's filters read it (the pinned types lack `setGroup`). */\nengine/gfx/shadows.ts:129:  (reference(name, type, shadow) as unknown as UniformNode<unknown>).setGroup(renderGroup);\nengine/gfx/materials/toon.ts:115:  const each = (value: number) => uniform(value).setGroup(renderGroup);\nengine/gfx/materials/toon.ts:117:  const grid = uniform(new Vector3(0, 0, 1)).setGroup(renderGroup);\nengine/gfx/atmosphere.ts:133:  const number = (value: number) => uniform(value).setGroup(renderGroup);\nengine/gfx/atmosphere.ts:135:    color: uniform(new Color()).setGroup(renderGroup),\nengine/gfx/enhanced/ssr.ts:83:  const ortho = uniform(0).setGroup(renderGroup);\nengine/gfx/enhanced/air.ts:194:  const lightVp = un