meras a warm-up compiles for (`gfx.warmUp`, engine/gfx/warmup.ts): every one of the view's in `all`, else\nengine/app/drawing.ts:158:    return warmedCameras<FrameView['camera']>(view.cameras, drawn, warmsAsked(settings));\nengine/app/drawing.ts:184:      const cold = warmsAsked(settings) && !warmedAt.has(view.camera);\nengine/app/drawing.ts:232:      if (warmsAsked(settings) && !warmedAt.has(view.camera)) {\nengine/gfx/renderer.ts:173:  warmUps: number;\nengine/gfx/renderer.ts:347:      warmUps: warmup.last?.count ?? 0,\nout/game.html: 6.9 MB\n0.0 {'engine': False, 'game': False, 'help': False}\n0.7 {'engine': False, 'game': False, 'help': True}\n38.1 {'engine': True, 'game': True, 'help': True}\n0.1 {'engine': False, 'game': False, 'help': False}\n1.0 {'engine': False, 'game': False, 'help': True}\n9.0 {'engine': True, 'game': True, 'help': True}","is_error":false}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"458c4a19-2f63-41cb-90e4-0b4abc5995e4","timestamp":"2026-11-05T09:35:03.208Z","tool_use_result":{"stdout":" * (engine/app/drawing.ts, engine/gfx/post/chain.ts, engine/app/look.ts) warm up a camera, the plain frame or a style\n * the first time a frame needs it, before that frame, never in it.\n */\nexport const WARMUP_SETTINGS = {\n  'gfx.warmUp': {\n    type: 'string',\n    enum: ['all', 'asked'],\n    default: 'all',\n    view: true,\n    description:\n      \"What a page's warm-ups compile: all (both cameras, the plain frame and the style set's own style, so no later switch warms up) or asked (only the cameras, the frame and the styles the page has drawn: a first frame of another warms up first, once; a fast\n  },\n} as const satisfies Record<string, Field>;\ndefineSettings(WARMUP_SETTINGS);\n\n/** Whether `settings` ask a page's warm-ups to compile only what it has drawn (`gfx.warmUp: asked`). */\nexport const warmsAsked = (settings: { get(path: string): unknown }): boolean => settings.get('gfx.warmUp') === 'asked