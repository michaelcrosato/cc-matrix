{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjXAt9X5Jwb5UQJqdm6g","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5658,"cache_read_input_tokens":289029,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5658},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"0a9a3e41-ff47-47b7-ad50-610a34eb4154","timestamp":"2026-11-05T09:10:32.974Z","request_id":"req_011CgjXAspfriR4oEAcHG98f","thinking_duration_ms":3175,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjXAt9X5Jwb5UQJqdm6g","type":"message","role":"assistant","content":[{"type":"text","text":"Now the pilot, the director and the actions, plus a first Node balance test, so I can check the wobble tuning before building any art."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5658,"cache_read_input_tokens":289029,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5658},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"f3f810f1-75a1-4817-adf4-72783aa3d012","timestamp":"2026-11-05T09:10:32.976Z","request_id":"req_011CgjXAspfriR4oEAcHG98f"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjXAt9X5Jwb5UQJqdm6g","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YaNuhu4erEejaBmj7KN5jg","name":"Bash","input":{"command":"sed -i \"s/origin: \\[-120, -120\\],/origin: [-120, 0, -120],/\" labs/game/scenes/terrain.ts\ncat > labs/game/scenes/pilot.ts <<'EOF'\n/**\n * @file The pilot (PLAN.md section 14): every character, the Guest included, is `player: false`, and this one system\n * writes `actor.intents` each step: the step's `move` on the island, nothing in an activity, the bot's in attract, the\n * slope added in the finale. It also runs what roam offers: the thing the Guest is looking at, using it, hidden\n * pebbles, staying out of deep water, and the other guests' idle errands.\n *\n * Game code, sim-side.\n *\n * @example\n * // stepPilot(w, intents); // first, each step\n */\nimport { held, placeActor, pressed, type Intents } from '../../../engine/sim-api';\nimport type { GameWorld } from './components';\nimport { USABLES, usableAt } from './data/usables';\nimport { SEA_Y } from './data/stations';\nimport { castOf } from './events/kit';\nimport { flowOf, groundAt, islandOf } from './flow';\nimport { tiltPushFor } from './tilt';\nimport { useThing } from './use';\n\n/** How far the thing in view may be, m, and how far off the view's centre, rad. */\nconst FOCUS_REACH = 7;\nconst FOCUS_CONE = 0.75;\n/** The depth of water a walker turns back at. */\nconst DEEP = 0.5;\n\n/** The world-space move of the Guest this step, by whoever drives it. */\nfunction guestMove(w: GameWorld, intents: Intents): readonly [number, number] {\n  const move = intents.move;\n  return move ? [move[0], move[1]] : [0, 0];\n}\n\n/** Picks the usable thing nearest the view's centre, within reach. */\nfunction findFocus(w: GameWorld, x: number, z: number, cam: number): number {\n  let best = -1;\n  let bestScore = Infinity;\n  const flow = flowOf(w);\n  USABLES.forEach((_u, i) => {\n    const at = usableAt(w, i, flow);\n    if (!at) return;\n    const [dx, dz] = [at[0] - x, at[1] - z];\n    const d = Math.hypot(dx, dz);\n    if (d > FOCUS_REACH) return;\n    let off = Math.atan2(dx, dz) - cam;\n    off = Math.atan2(Math.sin(off), Math.cos(off));\n    if (d > 1.8 && Math.abs(off) > FOCUS_CONE) return;\n    const score = d + 3 * Math.abs(off);\n    if (score < bestScore) [best, bestScore] = [i, score];\n  });\n  return best;\n}\n\n/** One step of the people's feet. */\nexport function stepPilot(w: GameWorld, intents: Intents): void {\n  const flow = flowOf(w);\n  const guest = castOf(w, 'guest');\n  const actorEntity = guest ? w.get(guest.id) : undefined;\n  const actor = actorEntity?.actor;\n  if (!actor || !guest) return;\n  const roaming = flow.mode === 'roam';\n  if (roaming && !guest.cast.hold) {\n    const move = flow.attract || w.settings.get<boolean>('game.auto') ? ([0, 0] as const) : guestMove(w, intents);\n    const slow = held(intents, 'walk') ? 0.45 : 1;\n    const [px, pz] = tiltPushFor(w, actor.x, actor.z);\n    actor.intents = { move: [move[0] * slow + px, move[1] * slow + pz], b: held(intents, 'jump') ? ['jump'] : [] };\n    const cam = typeof intents.cam === 'number' ? intents.cam : 0;\n    flow.focus = findFocus(w, actor.x, actor.z, cam);\n    if (pressed(intents, 'use') && flow.focus >= 0) useThing(w, flow.focus);\n    if (pressed(intents, 'plan')) w.emit('open', { what: 'programme' });\n    if (pressed(intents, 'wave')) w.emit('wave', { day: flow.day });\n    guest.cast.pose = held(intents, 'wave') ? '~Greeting' : flow.resting > 0 ? '~Meditate' : '';\n    if (flow.resting > 0) {\n      flow.resting = Math.hypot(move[0], move[1]) > 0.1 ? 0 : flow.resting + 1;\n      if (flow.resting === 0) guest.cast.hold = false;\n    }\n    // Keep walkers out of deep water.\n    const under = groundAt(w, actor.x, actor.z);\n    if (under < SEA_Y - DEEP || Math.hypot(actor.x, actor.z) > 118) {\n      const r = Math.hypot(actor.x, actor.z) || 1;\n      const pull = 0.5;\n      const [nx, nz] = [actor.x - (actor.x / r) * pull, actor.z - (actor.z / r) * pull];\n      placeActor(w, guest.id, [nx, groundAt(w, nx, nz), nz], actor.yaw);\n    }\n  } else if (!guest.cast.hold) {\n    actor.intents = {};\n  }\n  stepHelpers(w);\n  const isl = islandOf(w);\n  isl.seaX += 0.15 * w.dt;\n  isl.seaZ += 0.08 * w.dt;\n}\n\n/** Where a helper wants to be, when not held. */\nfunction stepHelpers(w: GameWorld): void {\n  const flow = flowOf(w);\n  const guest = castOf(w, 'guest');\n  const guestActor = guest ? w.get(guest.id)?.actor : undefined;\n  for (const e of w.query('cast', 'actor')) {\n    const c = e.cast;\n    if (c.who === 'guest' || c.hold) continue;\n    let [gx, gz] = [c.home[0], c.home[1]];\n    if (c.who === 'tare' && guestActor && flow.mode === 'roam') [gx, gz] = [guestActor.x + 1.6, guestActor.z + 1.3];\n    const [dx, dz] = [gx - e.actor.x, gz - e.actor.z];\n    const d = Math.hypot(dx, dz);\n    const stop = c.who === 'tare' ? 1.2 : 0.5;\n    const far = d > stop;\n    if (d > 40) placeActor(w, e.id, [gx, groundAt(w, gx, gz), gz], e.actor.yaw);\n    const tare = c.who === 'tare';\n    const hop = tare && far && w.tick % 42 === 0;\n    e.actor.intents = far ? { move: [dx / d, dz / d], b: hop ? ['jump'] : [] } : {};\n    if (!far && c.pose === '' && c.who === 'nan') c.pose = 'Stoop';\n    if (c.pose === 'Stoop') c.poseT = 1;\n    if (!far && c.who === 'bex' && c.pose === '') c.pose = 'PhoneStare';\n    if (c.pose === 'PhoneStare') c.poseT = 1;\n    if (!far && c.who === 'plumb' && c.pose === '') c.pose = 'Upright';\n    if (c.pose === 'Upright') c.poseT = 1;\n  }\n}\n\n/** Every usable, for the page's prompts. */\nexport const usableList = USABLES;\nEOF\ncat > labs/game/scenes/data/usables.ts <<'EOF'\n/**\n * @file The things a Guest can use on the island, as data: stations start an activity, people talk, boards open, plaques\n * read, benches sit. Add a row to add one.\n *\n * Game code, sim-side data.\n *\n * @example\n * USABLES[0].kind; // 'station'\n */\nimport type { Flow, GameWorld } from '../components';\nimport { castOf } from '../events/kit';\nimport { PLAQUES } from './plaques';\nimport { STATIONS } from './stations';\n\n/** A usable thing. */\nexport interface Usable {\n  id: string;\n  kind: 'board' | 'platform' | 'station' | 'person' | 'plaque' | 'bench' | 'hut' | 'stone';\n  label: string;\n  /** Where it is, for those that stay put. */\n  x?: number;\n  z?: number;\n  /** A person's name. */\n  who?: string;\n  /** Activities a station starts, in the order they are looked for on the Programme. */\n  events?: readonly string[];\n  /** A plaque's number. */\n  plaque?: number;\n}\n\n/** The fixed things. */\nconst FIXED: readonly Usable[] = [\n  { id: 'board', kind: 'board', label: 'Read', x: 7, z: 28 },\n  { id: 'platform', kind: 'platform', label: 'Step on', x: 0, z: 35, events: ['morning'] },\n  { id: 'pavilion', kind: 'station', label: 'Enter', x: STATIONS.pavilion.x, z: STATIONS.pavilion.z + 8, events: ['poseA', 'poseB', 'poseC', 'group'] },\n  { id: 'annex', kind: 'station', label: 'Enter', x: STATIONS.annex.x, z: STATIONS.annex.z + 8, events: ['reps', 'step'] },\n  { id: 'pondJetty', kind: 'station', label: 'Sit', x: STATIONS.pond.x, z: STATIONS.pond.z + 4, events: ['pond'] },\n  { id: 'lagoonHead', kind: 'station', label: 'Begin', x: STATIONS.lagoon.x, z: STATIONS.lagoon.z - 1, events: ['line', 'paddle'] },\n  { id: 'garden', kind: 'station', label: 'Begin', x: STATIONS.terrace.x, z: STATIONS.terrace.z + 3, events: ['garden'] },\n  { id: 'cliffLip', kind: 'station', label: 'Begin', x: STATIONS.cliff.x, z: STATIONS.cliff.z + 2, events: ['plunge'] },\n  { id: 'hoopSpot', kind: 'station', label: 'Begin', x: STATIONS.hoopBeach.x, z: STATIONS.hoopBeach.z, events: ['hoop'] },\n  { id: 'jogFlag', kind: 'station', label: 'Begin', x: 12, z: 28, events: ['jog'] },\n  { id: 'hut', kind: 'hut', label: 'Sleep', x: STATIONS.huts.x, z: STATIONS.huts.z + 2 },\n  { id: 'stone', kind: 'stone', label: 'Do not', x: STATIONS.centre.x, z: STATIONS.centre.z },\n  { id: 'bench1', kind: 'bench', label: 'Sit', x: -8, z: 46 },\n  { id: 'bench2', kind: 'bench', label: 'Sit', x: 36, z: -34 },\n  { id: 'bench3', kind: 'bench', label: 'Sit', x: -48, z: 44 },\n  { id: 'tare', kind: 'person', label: 'Talk', who: 'tare' },\n  { id: 'plumb', kind: 'person', label: 'Talk', who: 'plumb' },\n  { id: 'gerald', kind: 'person', label: 'Talk', who: 'gerald' },\n  { id: 'bex', kind: 'person', label: 'Talk', who: 'bex' },\n  { id: 'nan', kind: 'person', label: 'Talk', who: 'nan' },\n]; // prettier-ignore\n\n/** Every usable: the fixed things, then each plaque. */\nexport const USABLES: readonly Usable[] = [\n  ...FIXED,\n  ...PLAQUES.map((_p, i): Usable => ({ id: `plaque${i}`, kind: 'plaque', label: 'Read', plaque: i })),\n];\n\n/** Where usable `i` is now, or null when it cannot be used. */\nexport function usableAt(w: GameWorld, i: number, flow: Flow): [number, number] | null {\n  const u = USABLES[i];\n  if (u.kind === 'person') {\n    const c = castOf(w, u.who ?? '');\n    const actor = c ? w.get(c.id)?.actor : undefined;\n    if (u.who === 'tare' && flow.mode === 'roam') return null; // she follows you; she talks by herself: use the board\n    return actor ? [actor.x, actor.z] : null;\n  }\n  if (u.kind === 'plaque') {\n    const e = w.query('plaque').find((p) => p.plaque.index === u.plaque);\n    return e ? [e.plaque.x, e.plaque.z] : null;\n  }\n  return [u.x ?? 0, u.z ?? 0];\n}\nEOF\ncat > labs/game/scenes/data/plaques.ts <<'EOF'\n/**\n * @file The twelve \"Did you know?\" plaques, and the twenty hidden pebbles. The plaques' places are their Day 1 places:\n * each creeps a little downhill every night.\n *\n * Game code, sim-side data.\n *\n * @example\n * PLAQUES.length; // 12\n */\n\n/** A plaque's Day 1 place. */\nexport const PLAQUES: readonly (readonly [number, number])[] = [\n  [-10, 22], [14, 44], [-38, 30], [40, 40], [-58, -2], [-74, 8], [20, -32], [44, -56], [-10, -56], [66, 66], [-30, 72], [62, -30],\n]; // prettier-ignore\n\n/** The hidden pebbles' places. */\nexport const HIDDEN_PEBBLES: readonly (readonly [number, number])[] = [\n  [-20, 8], [24, 10], [-6, -24], [-62, 34], [72, 34], [78, 58], [52, 72], [-30, 88], [14, 92], [-80, 56],\n  [-92, 4], [-52, -34], [12, -60], [34, -66], [60, -46], [92, -12], [86, 22], [-16, 52], [32, 64], [0, -38],\n]; // prettier-ignore\nEOF\ncat > labs/game/scenes/use.ts <<'EOF'\n/**\n * @file What using a thing on the island does: stations start today's activity, people talk, boards open on the page.\n * Sim events carry what the page must show.\n *\n * Game code, sim-side.\n *\n * @example\n * // useThing(w, focusIndex);\n */\nimport type { GameWorld } from './components';\nimport { USABLES, usableAt } from './data/usables';\nimport { todaysNext } from './data/days';\nimport { castOf, say } from './events/kit';\nimport { flowOf, groundAt, startActivity } from './flow';\nimport { sleepNow } from './days';\nimport { startFinale, startGroup } from './start';\n\n/** Uses thing `i`. */\nexport function useThing(w: GameWorld, i: number): void {\n  const u = USABLES[i];\n  const flow = flowOf(w);\n  w.emit('used', { id: u.id, kind: u.kind });\n  if (u.kind === 'board') w.emit('open', { what: 'noticeboard' });\n  else if (u.kind === 'plaque') {\n    if (u.plaque !== undefined && !flow.found.includes(100 + u.plaque)) flow.found.push(100 + u.plaque);\n    w.emit('plaqueRead', { plaque: u.plaque ?? 0 });\n  } else if (u.kind === 'person') say({ w }, u.who ?? 'tare', `talk.${u.who}.${Math.min(6, flow.day)}`);\n  else if (u.kind === 'hut') {\n    if (todaysNext(flow) === null) sleepNow(w);\n    else say({ w }, 'tare', 'hut.early');\n  } else if (u.kind === 'bench') {\n    const guest = castOf(w, 'guest');\n    const at = usableAt(w, i, flow);\n    if (guest && at) {\n      Object.assign(guest.cast, { hold: true, x: at[0], y: groundAt(w, at[0], at[1]) + 0.1, z: at[1], pose: '~Meditate' });\n      flow.resting = 1;\n    }\n  } else if (u.kind === 'stone') {\n    if (flow.day === 5 && todaysNext(flow) === 'tilt') startFinale(w);\n    else say({ w }, 'tare', 'stone.donot');\n  } else {\n    const want = todaysNext(flow);\n    const list = u.events ?? [];\n    const pick = want && list.includes(want) ? want : list.find((id) => flow.seen.includes(id));\n    if (!pick) say({ w }, 'tare', 'station.notyet');\n    else if (pick === 'group') startGroup(w);\n    else startActivity(w, pick, activitySeats(pick));\n  }\n}\n\n/** The seats an activity runs with on the island: classes fill their mats with CPU guests. */\nexport function activitySeats(id: string): { seats?: { kind: 'local' | 'cpu'; skill?: string; sway?: number }[] } {\n  const classy = ['poseA', 'poseB', 'poseC'].includes(id);\n  if (!classy) return {};\n  return {\n    seats: [\n      { kind: 'local' },\n      { kind: 'cpu', skill: 'human', sway: 0.8 },\n      { kind: 'cpu', skill: 'perfect', sway: 1.1 },\n      { kind: 'cpu', skill: 'perfect', sway: 0.5 },\n    ],\n  };\n}\nEOF\ncat > labs/game/scenes/data/days.ts <<'EOF'\n/**\n * @file The residency (PLAN.md section 5), as data: each day is a Morning Check plus three activities. Adding a day is\n * adding a row. `todaysNext` says what the Programme offers next; null means the day is done and the hut is open.\n *\n * Game code, sim-side data.\n *\n * @example\n * DAYS[0].items[0]; // 'morning'\n */\nimport type { Flow } from '../components';\n\n/** A day. */\nexport interface DayDef {\n  title: string;\n  items: readonly string[];\n}\n\n/** The days, Day 1 first. */\nexport const DAYS: readonly DayDef[] = [\n  { title: 'Arrival', items: ['morning', 'poseA', 'pond', 'noticeboard'] },\n  { title: 'The Mat', items: ['morning', 'reps', 'garden', 'poseB'] },\n  { title: 'The Water', items: ['morning', 'paddle', 'line', 'step'] },\n  { title: 'The Sand', items: ['morning', 'hoop', 'plunge', 'jog'] },\n  { title: 'The Tilt', items: ['morning', 'group', 'poseC', 'tilt'] },\n];\n\n/** Free Play, after Day 5: a fresh Morning Check every day. */\nexport const AFTER: DayDef = { title: 'After', items: ['morning'] };\n\n/** Today's list. */\nexport const dayOf = (day: number): DayDef => DAYS[day - 1] ?? AFTER;\n\n/** What the Programme offers next today, or null when the day is done. */\nexport function todaysNext(flow: Pick<Flow, 'day' | 'done'>): string | null {\n  for (const id of dayOf(flow.day).items) if (!flow.done.includes(id)) return id;\n  return null;\n}\n\n/** Activities on the Noticeboard, in the order the cards appear. */\nexport const BOARD: readonly string[] = ['morning', 'poseA', 'poseB', 'poseC', 'pond', 'reps', 'garden', 'paddle', 'line', 'step', 'hoop', 'plunge', 'jog', 'group', 'tilt']; // prettier-ignore\n\n/** Who says what at evening, by day. */\nexport const STORY_TILT = { start: 0.4, perDay: 0.5 };\nEOF\ncat > labs/game/scenes/days.ts <<'EOF'\n/**\n * @file The days' turning: sleeping ends one day and starts the next; plaques creep, the tilt rises, the evening's\n * event carries what the page shows.\n *\n * Game code, sim-side.\n *\n * @example\n * // sleepNow(w);\n */\nimport { placeActor } from '../../../engine/sim-api';\nimport type { GameWorld } from './components';\nimport { STORY_TILT } from './data/days';\nimport { STATIONS } from './data/stations';\nimport { castOf } from './events/kit';\nimport { flowOf, groundAt, islandOf } from './flow';\nimport { homeOf } from './world';\n\n/** Ends the day: next morning, at the plaza, the plaques a little further downhill. */\nexport function sleepNow(w: GameWorld): void {\n  const flow = flowOf(w);\n  const finished = flow.day;\n  flow.day += 1;\n  flow.done = [];\n  w.emit('evening', { day: finished });\n  applyDay(w);\n}\n\n/** Puts the world where this day has it: the tilt, the plaques, who stands where, the Guest at the plaza. */\nexport function applyDay(w: GameWorld): void {\n  const flow = flowOf(w);\n  const island = islandOf(w);\n  island.tilt = STORY_TILT.start + STORY_TILT.perDay * (Math.min(flow.day, 5) - 1);\n  island.sky = 'day';\n  island.storm = 0;\n  for (const e of w.query('plaque')) {\n    const r = Math.hypot(e.plaque.x, e.plaque.z) || 1;\n    const creep = 0.45 * (flow.day - 1);\n    const base = e.plaque.index;\n    w.emit('plaqueMoved', { plaque: base, creep });\n    const prop = w.get(e.plaque.prop);\n    if (prop?.sceneProp) {\n      const [nx, nz] = [e.plaque.x + (e.plaque.x / r) * creep, e.plaque.z + (e.plaque.z / r) * creep];\n      prop.sceneProp.x = nx;\n      prop.sceneProp.z = nz;\n      prop.sceneProp.y = groundAt(w, nx, nz);\n    }\n  }\n  const guest = castOf(w, 'guest');\n  const { x, z } = STATIONS.plaza;\n  if (guest) {\n    guest.cast.hold = false;\n    placeActor(w, guest.id, [x, groundAt(w, x, z + 6), z + 6], Math.PI);\n  }\n  for (const who of ['gerald', 'bex', 'nan', 'plumb', 'tare']) {\n    const c = castOf(w, who);\n    if (!c) continue;\n    const [hx, hz] = homeOf(who, flow.day);\n    c.cast.home = [hx, hz];\n    c.cast.hold = false;\n    placeActor(w, c.id, [hx, groundAt(w, hx, hz), hz], Math.PI);\n  }\n}\nEOF\ncat > labs/game/scenes/critters.ts <<'EOF'\n/**\n * @file The Gull and the Frog: blobs on the engine's blob rig that go where activities send them, land on you at the\n * worst moment, and go away. They move by themselves, with no physics.\n *\n * Game code, sim-side.\n *\n * @example\n * // critterGo(c, 'frog', x, y, z);\n */\nimport { stepCrowdBody } from '../../../engine/sim-api';\nimport type { GameWorld } from './components';\n\n/** Where each waits, off stage. */\nconst AWAY = { gull: [40, 30, -90], frog: [-74, 4.2, -8] } as const;\n\n/** Spawns the two. */\nexport function spawnCritters(w: GameWorld): void {\n  const away = (kind: 'gull' | 'frog') => ({ goalX: AWAY[kind][0], goalY: AWAY[kind][1], goalZ: AWAY[kind][2], kind, away: true, look: 0, speed: kind === 'gull' ? 9 : 3, tick: 0 }); // prettier-ignore\n  w.spawn({ critter: away('gull'), crowdBody: { rig: 'blob', look: 'wings', size: 0.2, x: AWAY.gull[0], y: AWAY.gull[1], z: AWAY.gull[2], yaw: 0, state: {} } } as never); // prettier-ignore\n  w.spawn({ critter: away('frog'), crowdBody: { rig: 'blob', look: 'ears', size: 0.16, x: AWAY.frog[0], y: AWAY.frog[1], z: AWAY.frog[2], yaw: 0, state: {} } } as never); // prettier-ignore\n}\n\n/** One step of each. */\nexport function stepCritters(w: GameWorld): void {\n  for (const e of w.query('critter', 'crowdBody')) {\n    const { critter: k, crowdBody: body } = e;\n    k.tick += 1;\n    const [gx, gy, gz] = k.away ? AWAY[k.kind] : [k.goalX, k.goalY, k.goalZ];\n    const [dx, dy, dz] = [gx - body.x, gy - body.y, gz - body.z];\n    const d = Math.hypot(dx, dy, dz);\n    const step = Math.min(d, (k.away ? k.speed * 1.5 : k.speed) * w.dt);\n    const scale = d > 1e-6 ? step / d : 0;\n    const flying = d > 0.05;\n    const at: [number, number, number] = [body.x + dx * scale, body.y + dy * scale, body.z + dz * scale];\n    const [vx, vz] = [(dx * scale) / w.dt, (dz * scale) / w.dt];\n    const blob = k.kind === 'gull' ? { flap: flying ? 1 : 0 } : {};\n    stepCrowdBody(w, e.id, body, { at, velocity: [vx, 0, vz], blob } as never);\n    if (!flying) body.yaw = k.look;\n  }\n}\nEOF\ncat > labs/game/scenes/start.ts <<'EOF'\n/**\n * @file Starting the big things: Group Class on the island and the finale. Kept apart so `use.ts` and the actions read\n * alike.\n *\n * Game code, sim-side.\n *\n * @example\n * // startGroup(w);\n */\nimport type { GameWorld } from './components';\nimport { flowOf, startActivity, type SeatUse } from './flow';\n\n/** Starts Group Class with the seats asked for; empty seats go to CPU guests. */\nexport function startGroup(w: GameWorld, seats?: readonly SeatUse[]): void {\n  const flow = flowOf(w);\n  const cpu = (sway: number): SeatUse => ({ kind: 'cpu', skill: flow.day >= 5 ? 'perfect' : 'human', sway });\n  startActivity(w, 'group', { seats: seats ?? [{ kind: 'local' }, cpu(0.9), cpu(1.2), cpu(0.5)] });\n}\n\n/** Starts the Great Tilt. */\nexport function startFinale(w: GameWorld): void {\n  startActivity(w, 'tilt');\n}\nEOF\ncat > labs/game/scenes/tilt.ts <<'EOF'\n/**\n * @file The tilt as a force: while the Great Tilt runs, every walker gets a downhill push. The island's geometry never\n * moves (PLAN.md section 7); the slope pushes, the camera banks and the sea counter-rotates.\n *\n * Game code, sim-side.\n *\n * @example\n * // const [px, pz] = tiltPushFor(w, x, z);\n */\nimport type { GameWorld } from './components';\nimport { islandOf } from './flow';\n\n/** How much of the walker's speed a degree of tilt takes. */\nconst PUSH_PER_DEGREE = 0.055;\n\n/** The downhill push on a walker, as a share of its move. The story tilt is too small to push. */\nexport function tiltPushFor(w: GameWorld, _x: number, _z: number): [number, number] {\n  const { tiltX, tiltZ } = islandOf(w);\n  return [tiltX * PUSH_PER_DEGREE, tiltZ * PUSH_PER_DEGREE];\n}\nEOF\ncat > labs/game/scenes/actions.ts <<'EOF'\n/**\n * @file The scene actions the page calls for every menu pick (recorded in replays): `game.begin` hands the sim the save,\n * `game.start` starts an activity, `game.leave` leaves one, `game.sleep` ends the day, and the dev jumps.\n *\n * Game code, sim-side.\n *\n * @example\n * // inspector.actions.run('game.start', { event: 'pond' });\n */\nimport { placeActor } from '../../../engine/sim-api';\nimport { guestBody, guestBuild } from '../cast/roster';\nimport type { GameWorld } from './components';\nimport { STATIONS } from './data/stations';\nimport { applyDay, sleepNow } from './days';\nimport { castOf, enter } from './events/kit';\nimport { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity } from './flow';\nimport { respawnGuest, syncCairn, syncFinds } from './world';\nimport { activitySeats } from './use';\nimport { startFinale, startGroup } from './start';\n\n/** What `game.begin` hands the sim from the save. */\nexport interface BeginArgs {\n  day?: number;\n  done?: string[];\n  seen?: string[];\n  pebbles?: number;\n  found?: number[];\n  ages?: number[];\n  bests?: Record<string, number>;\n  look?: number;\n  color?: string;\n  /** Start in roam mode at the plaza (false: stays on the front end). */\n  roam?: boolean;\n}\n\n/** The actions. */\nexport const ISLAND_ACTIONS = {\n  'game.begin': (w: GameWorld, args: unknown) => {\n    const a = (args ?? {}) as BeginArgs;\n    const flow = flowOf(w);\n    endActivity(w);\n    Object.assign(flow, {\n      day: a.day ?? 1,\n      done: [...(a.done ?? [])],\n      seen: [...(a.seen ?? [])],\n      pebbles: a.pebbles ?? 0,\n      found: [...(a.found ?? [])],\n      ages: [...(a.ages ?? [])],\n      bests: { ...(a.bests ?? {}) },\n      look: a.look ?? 0,\n      color: a.color ?? 'coral',\n      mode: a.roam === false ? 'front' : 'roam',\n      attract: false,\n      credits: false,\n    });\n    respawnGuest(w, guestBody(flow.look, flow.color), guestBuild(flow.look));\n    applyDay(w);\n    syncCairn(w);\n    syncFinds(w);\n  },\n  'game.start': (w: GameWorld, args: unknown) => {\n    const { event, short } = (args ?? {}) as { event: string; short?: boolean };\n    if (event === 'group') startGroup(w);\n    else if (event === 'tilt') startFinale(w);\n    else startActivity(w, event, { ...activitySeats(event), short: short ?? false });\n  },\n  'game.leave': (w: GameWorld) => {\n    const flow = flowOf(w);\n    if (activityOf(w) || flow.mode === 'results') leaveActivity(w);\n    syncCairn(w);\n  },\n  'game.again': (w: GameWorld) => {\n    const flow = flowOf(w);\n    const event = flow.event;\n    if (event === 'group') startGroup(w);\n    else if (event === 'tilt') startFinale(w);\n    else startActivity(w, event, activitySeats(event));\n  },\n  'game.sleep': (w: GameWorld) => sleepNow(w),\n  'game.go': (w: GameWorld, args: unknown) => {\n    const { station } = (args ?? {}) as { station: string };\n    const s = STATIONS[station];\n    const guest = castOf(w, 'guest');\n    if (s && guest) placeActor(w, guest.id, [s.x, groundAt(w, s.x, s.z + 3), s.z + 3], s.yaw);\n  },\n  'game.front': (w: GameWorld) => {\n    const flow = flowOf(w);\n    endActivity(w);\n    flow.mode = 'front';\n  },\n  /** Finish the running activity at a chosen score (dev mode). */\n  'game.finish': (w: GameWorld, args: unknown) => {\n    const { score } = (args ?? {}) as { score?: number };\n    const entity = activityOf(w);\n    if (!entity) return;\n    entity.activity.data.forced = score ?? 750;\n    entity.activity.done = true;\n  },\n  /** Jump to a day (dev mode). */\n  'game.day': (w: GameWorld, args: unknown) => {\n    const { day } = (args ?? {}) as { day: number };\n    const flow = flowOf(w);\n    endActivity(w);\n    flow.day = day;\n    flow.done = [];\n    flow.mode = 'roam';\n    applyDay(w);\n  },\n  /** Jump to a finale step (dev mode). */\n  'game.tiltStep': (w: GameWorld, args: unknown) => {\n    const { phase } = (args ?? {}) as { phase: string };\n    const flow = flowOf(w);\n    if (flow.event !== 'tilt' || flow.mode !== 'event') startFinale(w);\n    const entity = activityOf(w);\n    if (!entity) return;\n    const c = { w, a: entity.activity } as never;\n    enter(c, phase);\n    entity.activity.data.jumped = true;\n  },\n  /** Give pebbles (dev mode). */\n  'game.give': (w: GameWorld, args: unknown) => {\n    const { pebbles } = (args ?? {}) as { pebbles: number };\n    flowOf(w).pebbles += pebbles;\n    syncCairn(w);\n  },\n  'game.attract': (w: GameWorld, args: unknown) => {\n    const { on } = (args ?? {}) as { on: boolean };\n    const flow = flowOf(w);\n    flow.attract = on;\n    flow.roster = 0;\n    flow.actTick = 0;\n    if (!on) {\n      endActivity(w);\n      flow.mode = 'front';\n    }\n  },\n};\nEOF\ncat > labs/game/scenes/director.ts <<'EOF'\n/**\n * @file The director: the attract loop (15 s of each activity, round and round) and `game.auto`'s scripted playthrough\n * of the whole game, which the tests use as a softlock finder.\n *\n * Game code, sim-side.\n *\n * @example\n * // stepDirector(w); // first thing, each step\n */\nimport type { GameWorld } from './components';\nimport { dayOf, todaysNext } from './data/days';\nimport { activityOf, endActivity, flowOf, leaveActivity, startActivity } from './flow';\nimport { sleepNow } from './days';\nimport { activitySeats } from './use';\nimport { startFinale, startGroup } from './start';\nimport { ACTIVITIES } from './events/index';\n\n/** The attract roster, in order: each shows for this many seconds. */\nexport const ATTRACT: readonly string[] = ['jog', 'poseA', 'pond', 'line', 'paddle', 'garden', 'step', 'hoop', 'plunge', 'tilt']; // prettier-ignore\n/** Seconds an attract act lasts. */\nexport const ATTRACT_SECONDS = 15;\n/** Steps results stay when nobody presses anything, in auto mode. */\nconst AUTO_RESULTS = 90;\n\n/** One step of the attract loop. */\nfunction stepAttract(w: GameWorld): void {\n  const flow = flowOf(w);\n  flow.actTick += 1;\n  const known = ATTRACT.filter((id) => ACTIVITIES[id]);\n  const running = activityOf(w);\n  if (!running || flow.mode !== 'event' || flow.actTick >= ATTRACT_SECONDS * w.hz) {\n    if (running) endActivity(w);\n    const id = known[flow.roster % known.length];\n    flow.roster += 1;\n    flow.actTick = 0;\n    startActivity(w, id, { ...activitySeats(id), data: id === 'tilt' ? { attract: true } : {} });\n  }\n}\n\n/** One step of the playthrough: starts what the Programme offers; leaves results; sleeps. */\nfunction stepAuto(w: GameWorld): void {\n  const flow = flowOf(w);\n  flow.actTick += 1;\n  if (flow.mode === 'results') {\n    if (flow.actTick >= AUTO_RESULTS) {\n      flow.actTick = 0;\n      leaveActivity(w);\n    }\n    return;\n  }\n  if (flow.mode === 'event') return;\n  if (flow.mode !== 'roam' || flow.credits) return;\n  const next = todaysNext(flow);\n  flow.actTick = 0;\n  if (next === null) {\n    if (flow.day <= 5) sleepNow(w);\n    return;\n  }\n  if (next === 'noticeboard') {\n    flow.done.push('noticeboard');\n    return;\n  }\n  if (next === 'group') startGroup(w);\n  else if (next === 'tilt') startFinale(w);\n  else if (ACTIVITIES[next]) startActivity(w, next, activitySeats(next));\n  else flow.done.push(next);\n  void dayOf;\n}\n\n/** One step of whichever the director is doing. */\nexport function stepDirector(w: GameWorld): void {\n  const flow = flowOf(w);\n  if (flow.attract) stepAttract(w);\n  else if (w.settings.get<boolean>('game.auto')) stepAuto(w);\n}\nEOF\ncat > labs/game/scenes/world.ts <<'EOF'\n/**\n * @file The island's standing things: the cast, the station props, plaques, hidden pebbles, the cairn; and each step's\n * world work (hidden pebbles picked up, the sea drifting, the story tilt's drinks and drifting props).\n *\n * Game code, sim-side.\n *\n * @example\n * // buildIsland(w); // once, in setup\n */\nimport { removeActor } from '../../../engine/sim-api';\nimport { spawnCast } from '../cast/roster';\nimport type { GameWorld } from './components';\nimport { HIDDEN_PEBBLES, PLAQUES } from './data/plaques';\nimport { STATIONS } from './data/stations';\nimport { flowOf, groundAt } from './flow';\nimport { spawnCritters } from './critters';\n\n/** Where each person spends each day: x, z. */\nexport function homeOf(who: string, day: number): [number, number] {\n  const spots: Record<string, readonly (readonly [number, number])[]> = {\n    gerald: [[-8, 28], [40, 18], [-44, 70], [10, -52], [62, 12]],\n    bex: [[10, 40], [-40, 24], [-52, 78], [24, -44], [66, 8]],\n    nan: [[-14, 36], [46, 30], [-60, 80], [-6, -74], [74, 4]],\n    plumb: [[-52, 14], [-52, 14], [52, 14], [-4, -68], [-52, 14]],\n    tare: [[3, 40], [3, 40], [3, 40], [3, 40], [3, 40]],\n  };\n  const list = spots[who] ?? [[0, 30]];\n  return [list[Math.min(day, list.length) - 1][0], list[Math.min(day, list.length) - 1][1]];\n}\n\n/** The Guest's three looks' make, by body and build. */\nexport function respawnGuest(w: GameWorld, body: string, build: string): void {\n  const old = w.query('cast').find((e) => e.cast.who === 'guest');\n  const seat = w.query('seat').find((e) => e.seat.index === 0);\n  const { x, z } = STATIONS.plaza;\n  if (old) removeActor(w, old.id);\n  const id = spawnCast(w, 'guest', x, groundAt(w, x, z + 6), z + 6, Math.PI, { body, build, speed: 5.4 });\n  if (seat) seat.seat.actor = id;\n}\n\n/** Stands everyone and everything. */\nexport function buildIsland(w: GameWorld): void {\n  const { x, z } = STATIONS.plaza;\n  spawnCast(w, 'guest', x, groundAt(w, x, z + 6), z + 6, Math.PI, { body: 'body:guest0.coral', build: 'build:guest0', speed: 5.4 }); // prettier-ignore\n  for (const who of ['plumb', 'tare', 'gerald', 'bex', 'nan']) {\n    const [hx, hz] = homeOf(who, 1);\n    spawnCast(w, who, hx, groundAt(w, hx, hz), hz, Math.PI);\n  }\n  spawnCritters(w);\n  PLAQUES.forEach(([px, pz], index) => {\n    w.spawn({ plaque: { index, x: px, z: pz, prop: -1 } });\n  });\n  HIDDEN_PEBBLES.forEach((_p, index) => {\n    w.spawn({ pebble: { index, prop: -1 } });\n  });\n}\n\n/** Keeps the cairn's pebbles up with the count. */\nexport function syncCairn(_w: GameWorld): void {\n  void _w;\n}\n\n/** Takes away hidden pebbles already found. */\nexport function syncFinds(_w: GameWorld): void {\n  void _w;\n}\n\n/** One step of the world, after the physics. */\nexport function stepIsland(w: GameWorld): void {\n  void flowOf(w);\n}\nEOF\ncat > labs/game/scenes/balance.test.ts <<'EOF'\n/**\n * @file Balance targets (PLAN.md sections 3 and 16): on 10 seeds at default settings, in every activity, the perfect\n * bot scores at least 750, the human-like delayed thumb 550, the sloppy thumb 300, no input at most 500 and below the\n * human-like thumb. Random mashing never throws, idle finishes by itself, teardown leaves nothing behind.\n */\nimport { describe, expect, it } from 'vitest';\nimport { createHeadless } from '../../../engine';\nimport '../cast/clips';\nimport { ACTIVITIES } from './events/index';\nimport { island } from './island';\nimport type { GameComponents } from './components';\n\n/** Seeds per activity: PLAN says 10; TEETER_SEEDS can narrow it while tuning. */\nconst SEEDS = Number(process.env.TEETER_SEEDS ?? 10);\n/** The activities to run; TEETER_ONLY narrows it. */\nconst ONLY = process.env.TEETER_ONLY?.split(',') ?? Object.keys(ACTIVITIES).filter((id) => id !== 'tilt');\n\n/** Runs one activity to its end with a bot, returns its score. */\nasync function run(id: string, skill: string, seed: number): Promise<{ score: number; steps: number; rank: string }> {\n  const engine = await createHeadless({ scene: island, seed, settings: { 'game.auto': false } });\n  const inspector = engine as unknown as {\n    actions: { run(name: string, args?: unknown): void };\n    set(path: string, value: unknown): void;\n    step(n?: number): number;\n    state(q: string): { entities: Record<string, unknown>[] };\n    hash(): string;\n    world?: unknown;\n  };\n  inspector.actions.run('game.begin', {});\n  inspector.set('game.auto', false);\n  inspector.set('game.skill', skill);\n  inspector.actions.run('game.start', { event: id, botSeat: true });\n  let flow = inspector.state('flow').entities[0].flow as GameComponents['flow'];\n  // The bot reads game.auto; set it after the start so the director does not start anything of its own.\n  inspector.set('game.auto', true);\n  let n = 0;\n  while (n < 60 * 240) {\n    inspector.step(30);\n    n += 30;\n    flow = inspector.state('flow').entities[0].flow as GameComponents['flow'];\n    if (flow.mode === 'results') break;\n  }\n  const { score = -1, rank = '' } = flow.last;\n  return { score, steps: n, rank };\n}\n\ndescribe('balance', () => {\n  for (const id of ONLY) {\n    it(`${id}: the four players meet their targets`, async () => {\n      const scores: Record<string, number[]> = { perfect: [], human: [], sloppy: [], idle: [] };\n      for (let seed = 1; seed <= SEEDS; seed++) {\n        for (const skill of Object.keys(scores)) {\n          const { score, steps } = await run(id, skill, seed);\n          scores[skill].push(score);\n          expect(steps, `${id} ${skill} seed ${seed} never finished`).toBeLessThan(60 * 240);\n          expect(score).toBeGreaterThanOrEqual(0);\n          expect(score).toBeLessThanOrEqual(1000);\n        }\n      }\n      const low = (list: number[]) => Math.min(...list);\n      const high = (list: number[]) => Math.max(...list);\n      const mean = (list: number[]) => Math.round(list.reduce((a, b) => a + b, 0) / list.length);\n      if (process.env.TEETER_SHOW) console.log(id, { p: [low(scores.perfect), mean(scores.perfect)], h: [low(scores.human), mean(scores.human)], s: [low(scores.sloppy), mean(scores.sloppy)], i: [high(scores.idle), mean(scores.idle)] }); // prettier-ignore\n      expect(low(scores.perfect)).toBeGreaterThanOrEqual(750);\n      expect(low(scores.human)).toBeGreaterThanOrEqual(550);\n      expect(low(scores.sloppy)).toBeGreaterThanOrEqual(300);\n      expect(high(scores.idle)).toBeLessThanOrEqual(500);\n      expect(mean(scores.idle)).toBeLessThan(mean(scores.human));\n    }, 600_000);\n  }\n});\nEOF\nrm -f labs/game/scenes/play.ts labs/game/scenes/play.test.ts labs/game/cast/player.ts labs/game/bot.ts labs/game/best.ts labs/game/best.test.ts labs/game/replays/bot.replay.json\nTEETER_SEEDS=2 TEETER_SHOW=1 TEETER_ONLY=ring npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -v \"^$\" | head -40 | cut -c1-220","description":"Write remaining sim core and run the first balance test","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5658,"cache_read_input_tokens":289029,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5658},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"e2b20b5a-2734-4143-9622-3054716cb21b","timestamp":"2026-11-05T09:12:33.229Z","request_id":"req_011CgjXAspfriR4oEAcHG98f","wire_tool_inputs":{"toolu_01YaNuhu4erEejaBmj7KN5jg":{"command":"sed -i \"s/origin: \\[-120, -120\\],/origin: [-120, 0, -120],/\" labs/game/scenes/terrain.ts\ncat > labs/game/scenes/pilot.ts <<'EOF'\n/**\n * @file The pilot (PLAN.md section 14): every character, the Guest included, is `player: false`, and this one system\n * writes `actor.intents` each step: the step's `move` on the island, nothing in an activity, the bot's in attract, the\n * slope added in the finale. It also runs what roam offers: the thing the Guest is looking at, using it, hidden\n * pebbles, staying out of deep water, and the other guests' idle errands.\n *\n * Game code, sim-side.\n *\n * @example\n * // stepPilot(w, intents); // first, each step\n */\nimport { held, placeActor, pressed, type Intents } from '../../../engine/sim-api';\nimport type { GameWorld } from './components';\nimport { USABLES, usableAt } from './data/usables';\nimport { SEA_Y } from './data/stations';\nimport { castOf } from './events/kit';\nimport { flowOf, groundAt, islandOf } from './flow';\nimport { tiltPushFor } from './tilt';\nimport { useThing } from './use';\n\n/** How far the thing in view may be, m, and how far off the view's centre, rad. */\nconst FOCUS_REACH = 7;\nconst FOCUS_CONE = 0.75;\n/** The depth of water a walker turns back at. */\nconst DEEP = 0.5;\n\n/** The world-space move of the Guest this step, by whoever drives it. */\nfunction guestMove(w: GameWorld, intents: Intents): readonly [number, number] {\n  const move = intents.move;\n  return move ? [move[0], move[1]] : [0, 0];\n}\n\n/** Picks the usable thing nearest the view's centre, within reach. */\nfunction findFocus(w: GameWorld, x: number, z: number, cam: number): number {\n  let best = -1;\n  let bestScore = Infinity;\n  const flow = flowOf(w);\n  USABLES.forEach((_u, i) => {\n    const at = usableAt(w, i, flow);\n    if (!at) return;\n    const [dx, dz] = [at[0] - x, at[1] - z];\n    const d = Math.hypot(dx, dz);\n    if (d > FOCUS_REACH) return;\n    let off = Math.atan2(dx, dz) - cam;\n    off = Math.atan2(Math.sin(off), Math.cos(off));\n    if (d > 1.8 && Math.abs(off) > FOCUS_CONE) return;\n    const score = d + 3 * Math.abs(off);\n    if (score < bestScore) [best, bestScore] = [i, score];\n  });\n  return best;\n}\n\n/** One step of the people's feet. */\nexport function stepPilot(w: GameWorld, intents: Intents): void {\n  const flow = flowOf(w);\n  const guest = castOf(w, 'guest');\n  const actorEntity = guest ? w.get(guest.id) : undefined;\n  const actor = actorEntity?.actor;\n  if (!actor || !guest) return;\n  const roaming = flow.mode === 'roam';\n  if (roaming && !guest.cast.hold) {\n    const move = flow.attract || w.settings.get<boolean>('game.auto') ? ([0, 0] as const) : guestMove(w, intents);\n    const slow = held(intents, 'walk') ? 0.45 : 1;\n    const [px, pz] = tiltPushFor(w, actor.x, actor.z);\n    actor.intents = { move: [move[0] * slow + px, move[1] * slow + pz], b: held(intents, 'jump') ? ['jump'] : [] };\n    const cam = typeof intents.cam === 'number' ? intents.cam : 0;\n    flow.focus = findFocus(w, actor.x, actor.z, cam);\n    if (pressed(intents, 'use') && flow.focus >= 0) useThing(w, flow.focus);\n    if (pressed(intents, 'plan')) w.emit('open', { what: 'programme' });\n    if (pressed(intents, 'wave')) w.emit('wave', { day: flow.day });\n    guest.cast.pose = held(intents, 'wave') ? '~Greeting' : flow.resting > 0 ? '~Meditate' : '';\n    if (flow.resting > 0) {\n      flow.resting = Math.hypot(move[0], move[1]) > 0.1 ? 0 : flow.resting + 1;\n      if (flow.resting === 0) guest.cast.hold = false;\n    }\n    // Keep walkers out of deep water.\n    const under = groundAt(w, actor.x, actor.z);\n    if (under < SEA_Y - DEEP || Math.hypot(actor.x, actor.z) > 118) {\n      const r = Math.hypot(actor.x, actor.z) || 1;\n      const pull = 0.5;\n      const [nx, nz] = [actor.x - (actor.x / r) * pull, actor.z - (actor.z / r) * pull];\n      placeActor(w, guest.id, [nx, groundAt(w, nx, nz), nz], actor.yaw);\n    }\n  } else if (!guest.cast.hold) {\n    actor.intents = {};\n  }\n  stepHelpers(w);\n  const isl = islandOf(w);\n  isl.seaX += 0.15 * w.dt;\n  isl.seaZ += 0.08 * w.dt;\n}\n\n/** Where a helper wants to be, when not held. */\nfunction stepHelpers(w: GameWorld): void {\n  const flow = flowOf(w);\n  const guest = castOf(w, 'guest');\n  const guestActor = guest ? w.get(guest.id)?.actor : undefined;\n  for (const e of w.query('cast', 'actor')) {\n    const c = e.cast;\n    if (c.who === 'guest' || c.hold) continue;\n    let [gx, gz] = [c.home[0], c.home[1]];\n    if (c.who === 'tare' && guestActor && flow.mode === 'roam') [gx, gz] = [guestActor.x + 1.6, guestActor.z + 1.3];\n    const [dx, dz] = [gx - e.actor.x, gz - e.actor.z];\n    const d = Math.hypot(dx, dz);\n    const stop = c.who === 'tare' ? 1.2 : 0.5;\n    const far = d > stop;\n    if (d > 40) placeActor(w, e.id, [gx, groundAt(w, gx, gz), gz], e.actor.yaw);\n    const tare = c.who === 'tare';\n    const hop = tare && far && w.tick % 42 === 0;\n    e.actor.intents = far ? { move: [dx / d, dz / d], b: hop ? ['jump'] : [] } : {};\n    if (!far && c.pose === '' && c.who === 'nan') c.pose = 'Stoop';\n    if (c.pose === 'Stoop') c.poseT = 1;\n    if (!far && c.who === 'bex' && c.pose === '') c.pose = 'PhoneStare';\n    if (c.pose === 'PhoneStare') c.poseT = 1;\n    if (!far && c.who === 'plumb' && c.pose === '') c.pose = 'Upright';\n    if (c.pose === 'Upright') c.poseT = 1;\n  }\n}\n\n/** Every usable, for the page's prompts. */\nexport const usableList = USABLES;\nEOF\ncat > labs/game/scenes/data/usables.ts <<'EOF'\n/**\n * @file The things a Guest can use on the island, as data: stations start an activity, people talk, boards open, plaques\n * read, benches sit. Add a row to add one.\n *\n * Game code, sim-side data.\n *\n * @example\n * USABLES[0].kind; // 'station'\n */\nimport type { Flow, GameWorld } from '../components';\nimport { castOf } from '../events/kit';\nimport { PLAQUES } from './plaques';\nimport { STATIONS } from './stations';\n\n/** A usable thing. */\nexport interface Usable {\n  id: string;\n  kind: 'board' | 'platform' | 'station' | 'person' | 'plaque' | 'bench' | 'hut' | 'stone';\n  label: string;\n  /** Where it is, for those that stay put. */\n  x?: number;\n  z?: number;\n  /** A person's name. */\n  who?: string;\n  /** Activities a station starts, in the order they are looked for on the Programme. */\n  events?: readonly string[];\n  /** A plaque's number. */\n  plaque?: number;\n}\n\n/** The fixed things. */\nconst FIXED: readonly Usable[] = [\n  { id: 'board', kind: 'board', label: 'Read', x: 7, z: 28 },\n  { id: 'platform', kind: 'platform', label: 'Step on', x: 0, z: 35, events: ['morning'] },\n  { id: 'pavilion', kind: 'station', label: 'Enter', x: STATIONS.pavilion.x, z: STATIONS.pavilion.z + 8, events: ['poseA', 'poseB', 'poseC', 'group'] },\n  { id: 'annex', kind: 'station', label: 'Enter', x: STATIONS.annex.x, z: STATIONS.annex.z + 8, events: ['reps', 'step'] },\n  { id: 'pondJetty', kind: 'station', label: 'Sit', x: STATIONS.pond.x, z: STATIONS.pond.z + 4, events: ['pond'] },\n  { id: 'lagoonHead', kind: 'station', label: 'Begin', x: STATIONS.lagoon.x, z: STATIONS.lagoon.z - 1, events: ['line', 'paddle'] },\n  { id: 'garden', kind: 'station', label: 'Begin', x: STATIONS.terrace.x, z: STATIONS.terrace.z + 3, events: ['garden'] },\n  { id: 'cliffLip', kind: 'station', label: 'Begin', x: STATIONS.cliff.x, z: STATIONS.cliff.z + 2, events: ['plunge'] },\n  { id: 'hoopSpot', kind: 'station', label: 'Begin', x: STATIONS.hoopBeach.x, z: STATIONS.hoopBeach.z, events: ['hoop'] },\n  { id: 'jogFlag', kind: 'station', label: 'Begin', x: 12, z: 28, events: ['jog'] },\n  { id: 'hut', kind: 'hut', label: 'Sleep', x: STATIONS.huts.x, z: STATIONS.huts.z + 2 },\n  { id: 'stone', kind: 'stone', label: 'Do not', x: STATIONS.centre.x, z: STATIONS.centre.z },\n  { id: 'bench1', kind: 'bench', label: 'Sit', x: -8, z: 46 },\n  { id: 'bench2', kind: 'bench', label: 'Sit', x: 36, z: -34 },\n  { id: 'bench3', kind: 'bench', label: 'Sit', x: -48, z: 44 },\n  { id: 'tare', kind: 'person', label: 'Talk', who: 'tare' },\n  { id: 'plumb', kind: 'person', label: 'Talk', who: 'plumb' },\n  { id: 'gerald', kind: 'person', label: 'Talk', who: 'gerald' },\n  { id: 'bex', kind: 'person', label: 'Talk', who: 'bex' },\n  { id: 'nan', kind: 'person', label: 'Talk', who: 'nan' },\n]; // prettier-ignore\n\n/** Every usable: the fixed things, then each plaque. */\nexport const USABLES: readonly Usable[] = [\n  ...FIXED,\n  ...PLAQUES.map((_p, i): Usable => ({ id: `plaque${i}`, kind: 'plaque', label: 'Read', plaque: i })),\n];\n\n/** Where usable `i` is now, or null when it cannot be used. */\nexport function usableAt(w: GameWorld, i: number, flow: Flow): [number, number] | null {\n  const u = USABLES[i];\n  if (u.kind === 'person') {\n    const c = castOf(w, u.who ?? '');\n    const actor = c ? w.get(c.id)?.actor : undefined;\n    if (u.who === 'tare' && flow.mode === 'roam') return null; // she follows you; she talks by herself: use the board\n    return actor ? [actor.x, actor.z] : null;\n  }\n  if (u.kind === 'plaque') {\n    const e = w.query('plaque').find((p) => p.plaque.index === u.plaque);\n    return e ? [e.plaque.x, e.plaque.z] : null;\n  }\n  return [u.x ?? 0, u.z ?? 0];\n}\nEOF\ncat > labs/game/scenes/data/plaques.ts <<'EOF'\n/**\n * @file The twelve \"Did you know?\" plaques, and the twenty hidden pebbles. The plaques' places are their Day 1 places:\n * each creeps a little downhill every night.\n *\n * Game code, sim-side data.\n *\n * @example\n * PLAQUES.length; // 12\n */\n\n/** A plaque's Day 1 place. */\nexport const PLAQUES: readonly (readonly [number, number])[] = [\n  [-10, 22], [14, 44], [-38, 30], [40, 40], [-58, -2], [-74, 8], [20, -32], [44, -56], [-10, -56], [66, 66], [-30, 72], [62, -30],\n]; // prettier-ignore\n\n/** The hidden pebbles' places. */\nexport const HIDDEN_PEBBLES: readonly (readonly [number, number])[] = [\n  [-20, 8], [24, 10], [-6, -24], [-62, 34], [72, 34], [78, 58], [52, 72], [-30, 88], [14, 92], [-80, 56],\n  [-92, 4], [-52, -34], [12, -60], [34, -66], [60, -46], [92, -12], [86, 22], [-16, 52], [32, 64], [0, -38],\n]; // prettier-ignore\nEOF\ncat > labs/game/scenes/use.ts <<'EOF'\n/**\n * @file What using a thing on the island does: stations start today's activity, people talk, boards open on the page.\n * Sim events carry what the page must show.\n *\n * Game code, sim-side.\n *\n * @example\n * // useThing(w, focusIndex);\n */\nimport type { GameWorld } from './components';\nimport { USABLES, usableAt } from './data/usables';\nimport { todaysNext } from './data/days';\nimport { castOf, say } from './events/kit';\nimport { flowOf, groundAt, startActivity } from './flow';\nimport { sleepNow } from './days';\nimport { startFinale, startGroup } from './start';\n\n/** Uses thing `i`. */\nexport function useThing(w: GameWorld, i: number): void {\n  const u = USABLES[i];\n  const flow = flowOf(w);\n  w.emit('used', { id: u.id, kind: u.kind });\n  if (u.kind === 'board') w.emit('open', { what: 'noticeboard' });\n  else if (u.kind === 'plaque') {\n    if (u.plaque !== undefined && !flow.found.includes(100 + u.plaque)) flow.found.push(100 + u.plaque);\n    w.emit('plaqueRead', { plaque: u.plaque ?? 0 });\n  } else if (u.kind === 'person') say({ w }, u.who ?? 'tare', `talk.${u.who}.${Math.min(6, flow.day)}`);\n  else if (u.kind === 'hut') {\n    if (todaysNext(flow) === null) sleepNow(w);\n    else say({ w }, 'tare', 'hut.early');\n  } else if (u.kind === 'bench') {\n    const guest = castOf(w, 'guest');\n    const at = usableAt(w, i, flow);\n    if (guest && at) {\n      Object.assign(guest.cast, { hold: true, x: at[0], y: groundAt(w, at[0], at[1]) + 0.1, z: at[1], pose: '~Meditate' });\n      flow.resting = 1;\n    }\n  } else if (u.kind === 'stone') {\n    if (flow.day === 5 && todaysNext(flow) === 'tilt') startFinale(w);\n    else say({ w }, 'tare', 'stone.donot');\n  } else {\n    const want = todaysNext(flow);\n    const list = u.events ?? [];\n    const pick = want && list.includes(want) ? want : list.find((id) => flow.seen.includes(id));\n    if (!pick) say({ w }, 'tare', 'station.notyet');\n    else if (pick === 'group') startGroup(w);\n    else startActivity(w, pick, activitySeats(pick));\n  }\n}\n\n/** The seats an activity runs with on the island: classes fill their mats with CPU guests. */\nexport function activitySeats(id: string): { seats?: { kind: 'local' | 'cpu'; skill?: string; sway?: number }[] } {\n  const classy = ['poseA', 'poseB', 'poseC'].includes(id);\n  if (!classy) return {};\n  return {\n    seats: [\n      { kind: 'local' },\n      { kind: 'cpu', skill: 'human', sway: 0.8 },\n      { kind: 'cpu', skill: 'perfect', sway: 1.1 },\n      { kind: 'cpu', skill: 'perfect', sway: 0.5 },\n    ],\n  };\n}\nEOF\ncat > labs/game/scenes/data/days.ts <<'EOF'\n/**\n * @file The residency (PLAN.md section 5), as data: each day is a Morning Check plus three activities. Adding a day is\n * adding a row. `todaysNext` says what the Programme offers next; null means the day is done and the hut is open.\n *\n * Game code, sim-side data.\n *\n * @example\n * DAYS[0].items[0]; // 'morning'\n */\nimport type { Flow } from '../components';\n\n/** A day. */\nexport interface DayDef {\n  title: string;\n  items: readonly string[];\n}\n\n/** The days, Day 1 first. */\nexport const DAYS: readonly DayDef[] = [\n  { title: 'Arrival', items: ['morning', 'poseA', 'pond', 'noticeboard'] },\n  { title: 'The Mat', items: ['morning', 'reps', 'garden', 'poseB'] },\n  { title: 'The Water', items: ['morning', 'paddle', 'line', 'step'] },\n  { title: 'The Sand', items: ['morning', 'hoop', 'plunge', 'jog'] },\n  { title: 'The Tilt', items: ['morning', 'group', 'poseC', 'tilt'] },\n];\n\n/** Free Play, after Day 5: a fresh Morning Check every day. */\nexport const AFTER: DayDef = { title: 'After', items: ['morning'] };\n\n/** Today's list. */\nexport const dayOf = (day: number): DayDef => DAYS[day - 1] ?? AFTER;\n\n/** What the Programme offers next today, or null when the day is done. */\nexport function todaysNext(flow: Pick<Flow, 'day' | 'done'>): string | null {\n  for (const id of dayOf(flow.day).items) if (!flow.done.includes(id)) return id;\n  return null;\n}\n\n/** Activities on the Noticeboard, in the order the cards appear. */\nexport const BOARD: readonly string[] = ['morning', 'poseA', 'poseB', 'poseC', 'pond', 'reps', 'garden', 'paddle', 'line', 'step', 'hoop', 'plunge', 'jog', 'group', 'tilt']; // prettier-ignore\n\n/** Who says what at evening, by day. */\nexport const STORY_TILT = { start: 0.4, perDay: 0.5 };\nEOF\ncat > labs/game/scenes/days.ts <<'EOF'\n/**\n * @file The days' turning: sleeping ends one day and starts the next; plaques creep, the tilt rises, the evening's\n * event carries what the page shows.\n *\n * Game code, sim-side.\n *\n * @example\n * // sleepNow(w);\n */\nimport { placeActor } from '../../../engine/sim-api';\nimport type { GameWorld } from './components';\nimport { STORY_TILT } from './data/days';\nimport { STATIONS } from './data/stations';\nimport { castOf } from './events/kit';\nimport { flowOf, groundAt, islandOf } from './flow';\nimport { homeOf } from './world';\n\n/** Ends the day: next morning, at the plaza, the plaques a little further downhill. */\nexport function sleepNow(w: GameWorld): void {\n  const flow = flowOf(w);\n  const finished = flow.day;\n  flow.day += 1;\n  flow.done = [];\n  w.emit('evening', { day: finished });\n  applyDay(w);\n}\n\n/** Puts the world where this day has it: the tilt, the plaques, who stands where, the Guest at the plaza. */\nexport function applyDay(w: GameWorld): void {\n  const flow = flowOf(w);\n  const island = islandOf(w);\n  island.tilt = STORY_TILT.start + STORY_TILT.perDay * (Math.min(flow.day, 5) - 1);\n  island.sky = 'day';\n  island.storm = 0;\n  for (const e of w.query('plaque')) {\n    const r = Math.hypot(e.plaque.x, e.plaque.z) || 1;\n    const creep = 0.45 * (flow.day - 1);\n    const base = e.plaque.index;\n    w.emit('plaqueMoved', { plaque: base, creep });\n    const prop = w.get(e.plaque.prop);\n    if (prop?.sceneProp) {\n      const [nx, nz] = [e.plaque.x + (e.plaque.x / r) * creep, e.plaque.z + (e.plaque.z / r) * creep];\n      prop.sceneProp.x = nx;\n      prop.sceneProp.z = nz;\n      prop.sceneProp.y = groundAt(w, nx, nz);\n    }\n  }\n  const guest = castOf(w, 'guest');\n  const { x, z } = STATIONS.plaza;\n  if (guest) {\n    guest.cast.hold = false;\n    placeActor(w, guest.id, [x, groundAt(w, x, z + 6), z + 6], Math.PI);\n  }\n  for (const who of ['gerald', 'bex', 'nan', 'plumb', 'tare']) {\n    const c = castOf(w, who);\n    if (!c) continue;\n    const [hx, hz] = homeOf(who, flow.day);\n    c.cast.home = [hx, hz];\n    c.cast.hold = false;\n    placeActor(w, c.id, [hx, groundAt(w, hx, hz), hz], Math.PI);\n  }\n}\nEOF\ncat > labs/game/scenes/critters.ts <<'EOF'\n/**\n * @file The Gull and the Frog: blobs on the engine's blob rig that go where activities send them, land on you at the\n * worst moment, and go away. They move by themselves, with no physics.\n *\n * Game code, sim-side.\n *\n * @example\n * // critterGo(c, 'frog', x, y, z);\n */\nimport { stepCrowdBody } from '../../../engine/sim-api';\nimport type { GameWorld } from './components';\n\n/** Where each waits, off stage. */\nconst AWAY = { gull: [40, 30, -90], frog: [-74, 4.2, -8] } as const;\n\n/** Spawns the two. */\nexport function spawnCritters(w: GameWorld): void {\n  const away = (kind: 'gull' | 'frog') => ({ goalX: AWAY[kind][0], goalY: AWAY[kind][1], goalZ: AWAY[kind][2], kind, away: true, look: 0, speed: kind === 'gull' ? 9 : 3, tick: 0 }); // prettier-ignore\n  w.spawn({ critter: away('gull'), crowdBody: { rig: 'blob', look: 'wings', size: 0.2, x: AWAY.gull[0], y: AWAY.gull[1], z: AWAY.gull[2], yaw: 0, state: {} } } as never); // prettier-ignore\n  w.spawn({ critter: away('frog'), crowdBody: { rig: 'blob', look: 'ears', size: 0.16, x: AWAY.frog[0], y: AWAY.frog[1], z: AWAY.frog[2], yaw: 0, state: {} } } as never); // prettier-ignore\n}\n\n/** One step of each. */\nexport function stepCritters(w: GameWorld): void {\n  for (const e of w.query('critter', 'crowdBody')) {\n    const { critter: k, crowdBody: body } = e;\n    k.tick += 1;\n    const [gx, gy, gz] = k.away ? AWAY[k.kind] : [k.goalX, k.goalY, k.goalZ];\n    const [dx, dy, dz] = [gx - body.x, gy - body.y, gz - body.z];\n    const d = Math.hypot(dx, dy, dz);\n    const step = Math.min(d, (k.away ? k.speed * 1.5 : k.speed) * w.dt);\n    const scale = d > 1e-6 ? step / d : 0;\n    const flying = d > 0.05;\n    const at: [number, number, number] = [body.x + dx * scale, body.y + dy * scale, body.z + dz * scale];\n    const [vx, vz] = [(dx * scale) / w.dt, (dz * scale) / w.dt];\n    const blob = k.kind === 'gull' ? { flap: flying ? 1 : 0 } : {};\n    stepCrowdBody(w, e.id, body, { at, velocity: [vx, 0, vz], blob } as never);\n    if (!flying) body.yaw = k.look;\n  }\n}\nEOF\ncat > labs/game/scenes/start.ts <<'EOF'\n/**\n * @file Starting the big things: Group Class on the island and the finale. Kept apart so `use.ts` and the actions read\n * alike.\n *\n * Game code, sim-side.\n *\n * @example\n * // startGroup(w);\n */\nimport type { GameWorld } from './components';\nimport { flowOf, startActivity, type SeatUse } from './flow';\n\n/** Starts Group Class with the seats asked for; empty seats go to CPU guests. */\nexport function startGroup(w: GameWorld, seats?: readonly SeatUse[]): void {\n  const flow = flowOf(w);\n  const cpu = (sway: number): SeatUse => ({ kind: 'cpu', skill: flow.day >= 5 ? 'perfect' : 'human', sway });\n  startActivity(w, 'group', { seats: seats ?? [{ kind: 'local' }, cpu(0.9), cpu(1.2), cpu(0.5)] });\n}\n\n/** Starts the Great Tilt. */\nexport function startFinale(w: GameWorld): void {\n  startActivity(w, 'tilt');\n}\nEOF\ncat > labs/game/scenes/tilt.ts <<'EOF'\n/**\n * @file The tilt as a force: while the Great Tilt runs, every walker gets a downhill push. The island's geometry never\n * moves (PLAN.md section 7); the slope pushes, the camera banks and the sea counter-rotates.\n *\n * Game code, sim-side.\n *\n * @example\n * // const [px, pz] = tiltPushFor(w, x, z);\n */\nimport type { GameWorld } from './components';\nimport { islandOf } from './flow';\n\n/** How much of the walker's speed a degree of tilt takes. */\nconst PUSH_PER_DEGREE = 0.055;\n\n/** The downhill push on a walker, as a share of its move. The story tilt is too small to push. */\nexport function tiltPushFor(w: GameWorld, _x: number, _z: number): [number, number] {\n  const { tiltX, tiltZ } = islandOf(w);\n  return [tiltX * PUSH_PER_DEGREE, tiltZ * PUSH_PER_DEGREE];\n}\nEOF\ncat > labs/game/scenes/actions.ts <<'EOF'\n/**\n * @file The scene actions the page calls for every menu pick (recorded in replays): `game.begin` hands the sim the save,\n * `game.start` starts an activity, `game.leave` leaves one, `game.sleep` ends the day, and the dev jumps.\n *\n * Game code, sim-side.\n *\n * @example\n * // inspector.actions.run('game.start', { event: 'pond' });\n */\nimport { placeActor } from '../../../engine/sim-api';\nimport { guestBody, guestBuild } from '../cast/roster';\nimport type { GameWorld } from './components';\nimport { STATIONS } from './data/stations';\nimport { applyDay, sleepNow } from './days';\nimport { castOf, enter } from './events/kit';\nimport { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity } from './flow';\nimport { respawnGuest, syncCairn, syncFinds } from './world';\nimport { activitySeats } from './use';\nimport { startFinale, startGroup } from './start';\n\n/** What `game.begin` hands the sim from the save. */\nexport interface BeginArgs {\n  day?: number;\n  done?: string[];\n  seen?: string[];\n  pebbles?: number;\n  found?: number[];\n  ages?: number[];\n  bests?: Record<string, number>;\n  look?: number;\n  color?: string;\n  /** Start in roam mode at the plaza (false: stays on the front end). */\n  roam?: boolean;\n}\n\n/** The actions. */\nexport const ISLAND_ACTIONS = {\n  'game.begin': (w: GameWorld, args: unknown) => {\n    const a = (args ?? {}) as BeginArgs;\n    const flow = flowOf(w);\n    endActivity(w);\n    Object.assign(flow, {\n      day: a.day ?? 1,\n      done: [...(a.done ?? [])],\n      seen: [...(a.seen ?? [])],\n      pebbles: a.pebbles ?? 0,\n      found: [...(a.found ?? [])],\n      ages: [...(a.ages ?? [])],\n      bests: { ...(a.bests ?? {}) },\n      look: a.look ?? 0,\n      color: a.color ?? 'coral',\n      mode: a.roam === false ? 'front' : 'roam',\n      attract: false,\n      credits: false,\n    });\n    respawnGuest(w, guestBody(flow.look, flow.color), guestBuild(flow.look));\n    applyDay(w);\n    syncCairn(w);\n    syncFinds(w);\n  },\n  'game.start': (w: GameWorld, args: unknown) => {\n    const { event, short } = (args ?? {}) as { event: string; short?: boolean };\n    if (event === 'group') startGroup(w);\n    else if (event === 'tilt') startFinale(w);\n    else startActivity(w, event, { ...activitySeats(event), short: short ?? false });\n  },\n  'game.leave': (w: GameWorld) => {\n    const flow = flowOf(w);\n    if (activityOf(w) || flow.mode === 'results') leaveActivity(w);\n    syncCairn(w);\n  },\n  'game.again': (w: GameWorld) => {\n    const flow = flowOf(w);\n    const event = flow.event;\n    if (event === 'group') startGroup(w);\n    else if (event === 'tilt') startFinale(w);\n    else startActivity(w, event, activitySeats(event));\n  },\n  'game.sleep': (w: GameWorld) => sleepNow(w),\n  'game.go': (w: GameWorld, args: unknown) => {\n    const { station } = (args ?? {}) as { station: string };\n    const s = STATIONS[station];\n    const guest = castOf(w, 'guest');\n    if (s && guest) placeActor(w, guest.id, [s.x, groundAt(w, s.x, s.z + 3), s.z + 3], s.yaw);\n  },\n  'game.front': (w: GameWorld) => {\n    const flow = flowOf(w);\n    endActivity(w);\n    flow.mode = 'front';\n  },\n  /** Finish the running activity at a chosen score (dev mode). */\n  'game.finish': (w: GameWorld, args: unknown) => {\n    const { score } = (args ?? {}) as { score?: number };\n    const entity = activityOf(w);\n    if (!entity) return;\n    entity.activity.data.forced = score ?? 750;\n    entity.activity.done = true;\n  },\n  /** Jump to a day (dev mode). */\n  'game.day': (w: GameWorld, args: unknown) => {\n    const { day } = (args ?? {}) as { day: number };\n    const flow = flowOf(w);\n    endActivity(w);\n    flow.day = day;\n    flow.done = [];\n    flow.mode = 'roam';\n    applyDay(w);\n  },\n  /** Jump to a finale step (dev mode). */\n  'game.tiltStep': (w: GameWorld, args: unknown) => {\n    const { phase } = (args ?? {}) as { phase: string };\n    const flow = flowOf(w);\n    if (flow.event !== 'tilt' || flow.mode !== 'event') startFinale(w);\n    const entity = activityOf(w);\n    if (!entity) return;\n    const c = { w, a: entity.activity } as never;\n    enter(c, phase);\n    entity.activity.data.jumped = true;\n  },\n  /** Give pebbles (dev mode). */\n  'game.give': (w: GameWorld, args: unknown) => {\n    const { pebbles } = (args ?? {}) as { pebbles: number };\n    flowOf(w).pebbles += pebbles;\n    syncCairn(w);\n  },\n  'game.attract': (w: GameWorld, args: unknown) => {\n    const { on } = (args ?? {}) as { on: boolean };\n    const flow = flowOf(w);\n    flow.attract = on;\n    flow.roster = 0;\n    flow.actTick = 0;\n    if (!on) {\n      endActivity(w);\n      flow.mode = 'front';\n    }\n  },\n};\nEOF\ncat > labs/game/scenes/director.ts <<'EOF'\n/**\n * @file The director: the attract loop (15 s of each activity, round and round) and `game.auto`'s scripted playthrough\n * of the whole game, which the tests use as a softlock finder.\n *\n * Game code, sim-side.\n *\n * @example\n * // stepDirector(w); // first thing, each step\n */\nimport type { GameWorld } from './components';\nimport { dayOf, todaysNext } from './data/days';\nimport { activityOf, endActivity, flowOf, leaveActivity, startActivity } from './flow';\nimport { sleepNow } from './days';\nimport { activitySeats } from './use';\nimport { startFinale, startGroup } from './start';\nimport { ACTIVITIES } from './events/index';\n\n/** The attract roster, in order: each shows for this many seconds. */\nexport const ATTRACT: readonly string[] = ['jog', 'poseA', 'pond', 'line', 'paddle', 'garden', 'step', 'hoop', 'plunge', 'tilt']; // prettier-ignore\n/** Seconds an attract act lasts. */\nexport const ATTRACT_SECONDS = 15;\n/** Steps results stay when nobody presses anything, in auto mode. */\nconst AUTO_RESULTS = 90;\n\n/** One step of the attract loop. */\nfunction stepAttract(w: GameWorld): void {\n  const flow = flowOf(w);\n  flow.actTick += 1;\n  const known = ATTRACT.filter((id) => ACTIVITIES[id]);\n  const running = activityOf(w);\n  if (!running || flow.mode !== 'event' || flow.actTick >= ATTRACT_SECONDS * w.hz) {\n    if (running) endActivity(w);\n    const id = known[flow.roster % known.length];\n    flow.roster += 1;\n    flow.actTick = 0;\n    startActivity(w, id, { ...activitySeats(id), data: id === 'tilt' ? { attract: true } : {} });\n  }\n}\n\n/** One step of the playthrough: starts what the Programme offers; leaves results; sleeps. */\nfunction stepAuto(w: GameWorld): void {\n  const flow = flowOf(w);\n  flow.actTick += 1;\n  if (flow.mode === 'results') {\n    if (flow.actTick >= AUTO_RESULTS) {\n      flow.actTick = 0;\n      leaveActivity(w);\n    }\n    return;\n  }\n  if (flow.mode === 'event') return;\n  if (flow.mode !== 'roam' || flow.credits) return;\n  const next = todaysNext(flow);\n  flow.actTick = 0;\n  if (next === null) {\n    if (flow.day <= 5) sleepNow(w);\n    return;\n  }\n  if (next === 'noticeboard') {\n    flow.done.push('noticeboard');\n    return;\n  }\n  if (next === 'group') startGroup(w);\n  else if (next === 'tilt') startFinale(w);\n  else if (ACTIVITIES[next]) startActivity(w, next, activitySeats(next));\n  else flow.done.push(next);\n  void dayOf;\n}\n\n/** One step of whichever the director is doing. */\nexport function stepDirector(w: GameWorld): void {\n  const flow = flowOf(w);\n  if (flow.attract) stepAttract(w);\n  else if (w.settings.get<boolean>('game.auto')) stepAuto(w);\n}\nEOF\ncat > labs/game/scenes/world.ts <<'EOF'\n/**\n * @file The island's standing things: the cast, the station props, plaques, hidden pebbles, the cairn; and each step's\n * world work (hidden pebbles picked up, the sea drifting, the story tilt's drinks and drifting props).\n *\n * Game code, sim-side.\n *\n * @example\n * // buildIsland(w); // once, in setup\n */\nimport { removeActor } from '../../../engine/sim-api';\nimport { spawnCast } from '../cast/roster';\nimport type { GameWorld } from './components';\nimport { HIDDEN_PEBBLES, PLAQUES } from './data/plaques';\nimport { STATIONS } from './data/stations';\nimport { flowOf, groundAt } from './flow';\nimport { spawnCritters } from './critters';\n\n/** Where each person spends each day: x, z. */\nexport function homeOf(who: string, day: number): [number, number] {\n  const spots: Record<string, readonly (readonly [number, number])[]> = {\n    gerald: [[-8, 28], [40, 18], [-44, 70], [10, -52], [62, 12]],\n    bex: [[10, 40], [-40, 24], [-52, 78], [24, -44], [66, 8]],\n    nan: [[-14, 36], [46, 30], [-60, 80], [-6, -74], [74, 4]],\n    plumb: [[-52, 14], [-52, 14], [52, 14], [-4, -68], [-52, 14]],\n    tare: [[3, 40], [3, 40], [3, 40], [3, 40], [3, 40]],\n  };\n  const list = spots[who] ?? [[0, 30]];\n  return [list[Math.min(day, list.length) - 1][0], list[Math.min(day, list.length) - 1][1]];\n}\n\n/** The Guest's three looks' make, by body and build. */\nexport function respawnGuest(w: GameWorld, body: string, build: string): void {\n  const old = w.query('cast').find((e) => e.cast.who === 'guest');\n  const seat = w.query('seat').find((e) => e.seat.index === 0);\n  const { x, z } = STATIONS.plaza;\n  if (old) removeActor(w, old.id);\n  const id = spawnCast(w, 'guest', x, groundAt(w, x, z + 6), z + 6, Math.PI, { body, build, speed: 5.4 });\n  if (seat) seat.seat.actor = id;\n}\n\n/** Stands everyone and everything. */\nexport function buildIsland(w: GameWorld): void {\n  const { x, z } = STATIONS.plaza;\n  spawnCast(w, 'guest', x, groundAt(w, x, z + 6), z + 6, Math.PI, { body: 'body:guest0.coral', build: 'build:guest0', speed: 5.4 }); // prettier-ignore\n  for (const who of ['plumb', 'tare', 'gerald', 'bex', 'nan']) {\n    const [hx, hz] = homeOf(who, 1);\n    spawnCast(w, who, hx, groundAt(w, hx, hz), hz, Math.PI);\n  }\n  spawnCritters(w);\n  PLAQUES.forEach(([px, pz], index) => {\n    w.spawn({ plaque: { index, x: px, z: pz, prop: -1 } });\n  });\n  HIDDEN_PEBBLES.forEach((_p, index) => {\n    w.spawn({ pebble: { index, prop: -1 } });\n  });\n}\n\n/** Keeps the cairn's pebbles up with the count. */\nexport function syncCairn(_w: GameWorld): void {\n  void _w;\n}\n\n/** Takes away hidden pebbles already found. */\nexport function syncFinds(_w: GameWorld): void {\n  void _w;\n}\n\n/** One step of the world, after the physics. */\nexport function stepIsland(w: GameWorld): void {\n  void flowOf(w);\n}\nEOF\ncat > labs/game/scenes/balance.test.ts <<'EOF'\n/**\n * @file Balance targets (PLAN.md sections 3 and 16): on 10 seeds at default settings, in every activity, the perfect\n * bot scores at least 750, the human-like delayed thumb 550, the sloppy thumb 300, no input at most 500 and below the\n * human-like thumb. Random mashing never throws, idle finishes by itself, teardown leaves nothing behind.\n */\nimport { describe, expect, it } from 'vitest';\nimport { createHeadless } from '../../../engine';\nimport '../cast/clips';\nimport { ACTIVITIES } from './events/index';\nimport { island } from './island';\nimport type { GameComponents } from './components';\n\n/** Seeds per activity: PLAN says 10; TEETER_SEEDS can narrow it while tuning. */\nconst SEEDS = Number(process.env.TEETER_SEEDS ?? 10);\n/** The activities to run; TEETER_ONLY narrows it. */\nconst ONLY = process.env.TEETER_ONLY?.split(',') ?? Object.keys(ACTIVITIES).filter((id) => id !== 'tilt');\n\n/** Runs one activity to its end with a bot, returns its score. */\nasync function run(id: string, skill: string, seed: number): Promise<{ score: number; steps: number; rank: string }> {\n  const engine = await createHeadless({ scene: island, seed, settings: { 'game.auto': false } });\n  const inspector = engine as unknown as {\n    actions: { run(name: string, args?: unknown): void };\n    set(path: string, value: unknown): void;\n    step(n?: number): number;\n    state(q: string): { entities: Record<string, unknown>[] };\n    hash(): string;\n    world?: unknown;\n  };\n  inspector.actions.run('game.begin', {});\n  inspector.set('game.auto', false);\n  inspector.set('game.skill', skill);\n  inspector.actions.run('game.start', { event: id, botSeat: true });\n  let flow = inspector.state('flow').entities[0].flow as GameComponents['flow'];\n  // The bot reads game.auto; set it after the start so the director does not start anything of its own.\n  inspector.set('game.auto', true);\n  let n = 0;\n  while (n < 60 * 240) {\n    inspector.step(30);\n    n += 30;\n    flow = inspector.state('flow').entities[0].flow as GameComponents['flow'];\n    if (flow.mode === 'results') break;\n  }\n  const { score = -1, rank = '' } = flow.last;\n  return { score, steps: n, rank };\n}\n\ndescribe('balance', () => {\n  for (const id of ONLY) {\n    it(`${id}: the four players meet their targets`, async () => {\n      const scores: Record<string, number[]> = { perfect: [], human: [], sloppy: [], idle: [] };\n      for (let seed = 1; seed <= SEEDS; seed++) {\n        for (const skill of Object.keys(scores)) {\n          const { score, steps } = await run(id, skill, seed);\n          scores[skill].push(score);\n          expect(steps, `${id} ${skill} seed ${seed} never finished`).toBeLessThan(60 * 240);\n          expect(score).toBeGreaterThanOrEqual(0);\n          expect(score).toBeLessThanOrEqual(1000);\n        }\n      }\n      const low = (list: number[]) => Math.min(...list);\n      const high = (list: number[]) => Math.max(...list);\n      const mean = (list: number[]) => Math.round(list.reduce((a, b) => a + b, 0) / list.length);\n      if (process.env.TEETER_SHOW) console.log(id, { p: [low(scores.perfect), mean(scores.perfect)], h: [low(scores.human), mean(scores.human)], s: [low(scores.sloppy), mean(scores.sloppy)], i: [high(scores.idle), mean(scores.idle)] }); // prettier-ignore\n      expect(low(scores.perfect)).toBeGreaterThanOrEqual(750);\n      expect(low(scores.human)).toBeGreaterThanOrEqual(550);\n      expect(low(scores.sloppy)).toBeGreaterThanOrEqual(300);\n      expect(high(scores.idle)).toBeLessThanOrEqual(500);\n      expect(mean(scores.idle)).toBeLessThan(mean(scores.human));\n    }, 600_000);\n  }\n});\nEOF\nrm -f labs/game/scenes/play.ts labs/game/scenes/play.test.ts labs/game/cast/player.ts labs/game/bot.ts labs/game/best.ts labs/game/best.test.ts labs/game/replays/bot.replay.json\nTEETER_SEEDS=2 TEETER_SHOW=1 TEETER_ONLY=ring npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -v \"^$\" | head -40 | cut -c1-220","description":"Write remaining sim core and run the first balance test","timeout":300000}}}
