{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjZpg2oB2QH9G9i37Qur","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25393,"cache_read_input_tokens":418765,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25393},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"ccf76c5f-3203-4de9-8eed-c2a984ff2408","timestamp":"2026-11-05T09:45:17.151Z","request_id":"req_011CgjZpfkgJQ74kNMunLrry","thinking_duration_ms":875,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjZpg2oB2QH9G9i37Qur","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HFkLb58Lak3xc8twSpCTuF","name":"Bash","input":{"command":"cat > labs/game/scenes/data/courses.ts <<'EOF'\n/**\n * @file The water and land courses (PLAN.md section 6): Paddle Glide's twelve gates round the lagoon and the coast path's\n * ring of flags. Each a table; a new course is a new table.\n *\n * Game code, sim-side data.\n *\n * @example\n * GATES.length; // 12\n */\n\n/** Paddle Glide's course: a circle out in the lagoon, its centre and radius. */\nexport const LAGOON = { x: -82, z: 128, radius: 30 } as const;\n\n/** The twelve gates, as angles round the lagoon. */\nexport const GATES: readonly number[] = Array.from({ length: 12 }, (_v, i) => Math.PI / 2 + ((i + 1) * 2 * Math.PI) / 12);\n\n/** The coast path, in order: past every landmark and back to the Plaza. */\nexport const COAST: readonly (readonly [number, number])[] = [\n  [8, 44], [22, 62], [34, 78], [52, 76], [66, 72], [82, 58], [90, 36], [90, 12], [92, -12], [84, -38], [64, -56],\n  [40, -66], [18, -66], [-4, -66], [-26, -64], [-50, -52], [-76, -34], [-92, -8], [-94, 20], [-82, 48], [-60, 66],\n  [-36, 76], [-14, 66], [-4, 48],\n]; // prettier-ignore\nEOF\ncat > labs/game/scenes/data/trays.ts <<'EOF'\n/**\n * @file Sand Garden's trays (PLAN.md section 6): 1 to 3 marbles each, rising to moving rakes and a gap in the rim. The tray\n * is 2.4 m wide, its half 1.2. Adding a row adds a tray. `via` is where the bot aims first, so it can find the way.\n *\n * Game code, sim-side data.\n *\n * @example\n * TRAYS[0].marbles.length; // 1\n */\n\n/** A point on a tray. */\ntype P = readonly [number, number];\n\n/** A tray. */\nexport interface TrayDef {\n  marbles: readonly P[];\n  holes: readonly P[];\n  /** Ridges: [x0, z0, x1, z1]. */\n  ridges: readonly (readonly [number, number, number, number])[];\n  /** Moving rakes: x, z, half length, speed, along x when true. */\n  rakes: readonly { x: number; z: number; half: number; speed: number; range: number; alongX: boolean }[];\n  /** A gap in the rim: on which side, centre, half width. Marbles that fall through come back. */\n  gap?: { side: 'N' | 'S' | 'E' | 'W'; at: number; half: number };\n  /** The bot's waypoints per marble. */\n  via?: readonly (readonly P[])[];\n}\n\n/** The trays. */\nexport const TRAYS: readonly TrayDef[] = [\n  { marbles: [[-0.7, 0.7]], holes: [[0.6, -0.6]], ridges: [], rakes: [] },\n  {\n    marbles: [[-0.8, -0.7], [0.8, -0.7]],\n    holes: [[-0.6, 0.7], [0.6, 0.7]],\n    ridges: [[-0.25, -0.2, 0.25, -0.2]],\n    rakes: [],\n  },\n  {\n    marbles: [[-0.85, 0.85], [-0.4, 0.85]],\n    holes: [[0.8, -0.8], [0.3, -0.8]],\n    ridges: [[-1.2, 0, 0.5, 0]],\n    rakes: [],\n    via: [[[0.85, 0.4], [0.85, -0.3]], [[0.85, 0.4], [0.85, -0.3]]],\n  },\n  {\n    marbles: [[-0.9, 0.9], [0, 0.9], [0.9, 0.9]],\n    holes: [[-0.7, -0.8], [0, -0.8], [0.7, -0.8]],\n    ridges: [],\n    rakes: [{ x: 0, z: 0, half: 0.4, speed: 0.5, range: 0.75, alongX: true }],\n  },\n  {\n    marbles: [[-0.8, 0.8], [0.8, 0.8], [0, 0.2]],\n    holes: [[-0.8, -0.85], [0.8, -0.85], [0, -0.3]],\n    ridges: [[-0.5, 0.3, -0.1, 0.3], [0.1, 0.3, 0.5, 0.3]],\n    rakes: [{ x: 0, z: -0.65, half: 0.3, speed: 0.4, range: 0.5, alongX: true }],\n    gap: { side: 'S', at: 0, half: 0.22 },\n  },\n]; // prettier-ignore\nEOF\ncat > labs/game/scenes/events/paddle.ts <<'EOF'\n/**\n * @file Paddle Glide (PLAN.md section 6): stand on a board. Forward lean is speed, side lean steers, feet alternating at\n * about 1.2 Hz give +30% and a kick. Twelve buoy gates round the lagoon with seeded jitter. A ferry wake at gate 7 and a\n * crossing turtle at gate 9 shove your centre. A topple is a splash and a 3-second remount.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'paddle');\n */\nimport { holdAt, type Player } from '../bot/players';\nimport { GATES, LAGOON } from '../data/courses';\nimport { SEA_Y } from '../data/stations';\nimport { after, castOf, enter, moveProp, propFor, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** How close to a buoy counts, m; how long the course is open, s; how fast side lean turns, rad/s. */\nconst GATE_REACH = 4.6;\nconst LENGTH = 75;\nconst TURN = 1.2;\n\n/** The glide's state. */\ninterface PaddleData {\n  x: number;\n  z: number;\n  yaw: number;\n  speed: number;\n  gate: number;\n  gates: number[][];\n  props: number[];\n  board: number;\n  boost: number;\n  lastFoot: string;\n  footT: number;\n  time: number;\n  finished: number;\n  wake: number;\n  turtle: number;\n  shoved: number[];\n  paddleT: number;\n}\n\n/** Puts the gates' props right: the next one is the lit one. */\nfunction lightGate(c: Ctx, d: PaddleData): void {\n  const [x, z] = d.gates[Math.min(d.gate, d.gates.length - 1)];\n  moveProp(c.w, d.props[0], x, SEA_Y, z, 0);\n}\n\n/** Paddle Glide. */\nexport const paddle: Activity = {\n  id: 'paddle',\n  title: 'Paddle Glide',\n  station: 'lagoon',\n  map: 'actionMap:balance',\n  shot: 'paddle',\n  wobble: true,\n  setup(c) {\n    const rng = c.w.rng('gates');\n    const gates = GATES.map((angle) => {\n      const r = LAGOON.radius + rng.range(-2.5, 2.5);\n      return [LAGOON.x + Math.cos(angle) * r, LAGOON.z + Math.sin(angle) * r];\n    });\n    const startX = LAGOON.x + Math.cos(Math.PI / 2) * LAGOON.radius;\n    const startZ = LAGOON.z + Math.sin(Math.PI / 2) * LAGOON.radius;\n    const d: PaddleData = { x: startX, z: startZ, yaw: -Math.PI / 2 + 0.3, speed: 0, gate: 0, gates, props: [], board: -1, boost: 0, lastFoot: '', footT: 999, time: 0, finished: -1, wake: -1, turtle: -1, shoved: [], paddleT: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    d.props.push(propFor(c, { prop: 'prop:buoyNext', at: [gates[0][0], SEA_Y, gates[0][1]], yaw: 0 }));\n    for (const [x, z] of gates) propFor(c, { prop: 'prop:buoy', at: [x, SEA_Y, z], yaw: 0 });\n    d.board = propFor(c, { prop: 'prop:paddleboard', at: [startX, SEA_Y + 0.02, startZ], yaw: d.yaw });\n    d.wake = propFor(c, { prop: 'prop:wake', at: [0, -20, 0], yaw: 0 });\n    d.turtle = propFor(c, { prop: 'prop:turtle', at: [0, -20, 0], yaw: 0 });\n    const guest = castOf(c.w, 'guest');\n    if (guest) Object.assign(guest.cast, { hold: true, x: startX, y: SEA_Y + 0.14, z: startZ, yaw: d.yaw, pose: 'Paddling', poseT: 0 });\n    c.hud.disc = true;\n    c.hud.feet = true;\n    c.hud.title = 'Paddle Glide';\n    enter(c, 'glide');\n    say(c, 'tare', 'paddle.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as PaddleData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const guest = castOf(c.w, 'guest');\n    const cast = guest?.cast;\n    d.time += 1;\n    wob.usesBreath = false;\n    if (c.a.phase === 'remount') {\n      if (cast) cast.y = c.a.pt < steps(c, 2) ? SEA_Y - 0.6 : SEA_Y + 0.14;\n      if (after(c, 3)) {\n        Object.assign(wob, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, recover: 0 });\n        enter(c, 'glide');\n      }\n    } else {\n      // Feet: alternating at about 1.2 Hz gives +30% and a kick.\n      d.footT += 1;\n      const foot = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n      if (foot && foot !== d.lastFoot) {\n        if (d.footT < c.w.hz * 1.3) {\n          d.boost = Math.min(1, d.boost + 0.5);\n          d.speed += 0.4;\n        }\n        d.footT = 0;\n        d.lastFoot = foot;\n        d.paddleT += 0.5;\n        c.w.emit('paddleStroke', { foot });\n      }\n      d.boost = Math.max(0, d.boost - c.w.dt * 0.7);\n      const top = c.w.settings.get<number>('game.paddle.speed') * (1 + 0.3 * d.boost);\n      const want = Math.max(0, Math.min(1, wob.y / 0.8)) * top;\n      d.speed += (want - d.speed) * (1 - Math.exp(-c.w.dt * 1.4));\n      d.yaw -= wob.x * TURN * c.w.dt;\n      d.x += Math.sin(d.yaw) * d.speed * c.w.dt;\n      d.z += Math.cos(d.yaw) * d.speed * c.w.dt;\n      // Gates, in order.\n      if (d.gate < d.gates.length) {\n        const [gx, gz] = d.gates[d.gate];\n        if (Math.hypot(gx - d.x, gz - d.z) <= GATE_REACH) {\n          d.gate += 1;\n          c.w.emit('gate', { gate: d.gate });\n          if (d.gate < d.gates.length) lightGate(c, d);\n          else {\n            moveProp(c.w, d.props[0], 0, -20, 0, 0);\n            d.finished = d.time;\n            say(c, 'tare', 'paddle.done');\n            c.a.done = true;\n          }\n        }\n      }\n      // The ferry's wake and the turtle.\n      if (d.gate === 7 && !d.shoved.includes(7)) {\n        d.shoved.push(7);\n        wob.vy -= 1.5;\n        wob.vx += 0.6;\n        c.w.emit('wake', {});\n        say(c, 'tare', 'paddle.wake');\n        moveProp(c.w, d.wake, d.x, SEA_Y + 0.05, d.z + 6, d.yaw);\n      }\n      if (d.gate === 9 && !d.shoved.includes(9)) {\n        d.shoved.push(9);\n        wob.vx -= 1.3;\n        c.w.emit('turtle', {});\n        say(c, 'tare', 'paddle.turtle');\n        moveProp(c.w, d.turtle, d.x + Math.sin(d.yaw) * 7, SEA_Y + 0.05, d.z + Math.cos(d.yaw) * 7, d.yaw + 1.4);\n      }\n      if (wob.recover > 0) {\n        c.w.emit('splash', { big: false, x: d.x, z: d.z, y: SEA_Y });\n        say(c, 'tare', 'paddle.fall');\n        d.speed = 0;\n        enter(c, 'remount');\n      }\n    }\n    if (cast) {\n      cast.x = d.x;\n      cast.z = d.z;\n      cast.yaw = d.yaw;\n      if (c.a.phase === 'glide') cast.y = SEA_Y + 0.14;\n      cast.pose = 'Paddling';\n      cast.poseT = d.paddleT;\n      cast.leanX = wob.x * 0.8;\n      cast.leanY = wob.y * 0.6;\n    }\n    moveProp(c.w, d.board, d.x, SEA_Y + 0.02 + Math.sin(c.a.t * 0.05) * 0.015, d.z, d.yaw);\n    const [gx, gz] = d.gates[Math.min(d.gate, d.gates.length - 1)];\n    let err = Math.atan2(gx - d.x, gz - d.z) - d.yaw;\n    err = Math.atan2(Math.sin(err), Math.cos(err));\n    c.hud.ring = [0, 0.55, 0.5];\n    c.hud.meter = d.gate / d.gates.length;\n    c.hud.meterLabel = `Gate ${Math.min(d.gate + 1, 12)} of 12`;\n    c.hud.show = { err, speed: d.speed, seconds: Math.max(0, LENGTH - Math.floor(d.time / c.w.hz)), boost: d.boost };\n    if (d.time >= steps(c, LENGTH)) {\n      say(c, 'tare', 'paddle.time');\n      c.a.done = true;\n    }\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as PaddleData;\n    const { seat, wobble } = e;\n    seat.act = false;\n    if (!player.acts) {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      seat.fl = seat.fr = 0;\n      return;\n    }\n    const [gx, gz] = d.gates[Math.min(d.gate, d.gates.length - 1)];\n    let err = Math.atan2(gx - d.x, gz - d.z) - d.yaw;\n    err = Math.atan2(Math.sin(err), Math.cos(err));\n    const turn = Math.max(-0.55, Math.min(0.55, -err * 1.2));\n    const go = Math.abs(err) < 0.9 ? 0.62 : 0.2;\n    holdAt(c.w, seat, wobble, turn, go, player);\n    const cycle = Math.round((c.w.hz / 1.2) * (player.name === 'perfect' ? 1 : 1.1));\n    const t = c.a.t % cycle;\n    const left = Math.floor(c.a.t / cycle) % 2 === 0;\n    seat.fl = left && t < 6 ? 1 : 0;\n    seat.fr = !left && t < 6 ? 1 : 0;\n  },\n  score(c) {\n    const d = c.a.data as unknown as PaddleData;\n    const bonus = d.finished > 0 ? 280 * Math.min(1, (steps(c, LENGTH) - d.finished) / steps(c, 40)) : 0;\n    return d.gate * 60 + bonus;\n  },\n};\nEOF\ncat > labs/game/scenes/events/garden.ts <<'EOF'\n/**\n * @file Sand Garden (PLAN.md section 6): a raked sand tray on a stand, seen from above. Lean tilts it up to 12 degrees; the\n * pointer's place on the tray does the same. Marbles obey a little 2D integrator of the game's own (slope, friction,\n * ridges, holes that catch below a speed). No Wobble noise here: this one is about touch.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'garden');\n */\nimport type { Player } from '../bot/players';\nimport { TRAYS, type TrayDef } from '../data/trays';\nimport { castOf, enter, moveProp, propFor, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** The tray's half width, m; a marble's radius, m; a hole's catching radius. */\nconst HALF = 1.17;\nconst R = 0.055;\nconst CATCH = 0.12;\n/** Rolling friction, 1/s; bounce off rims and ridges. */\nconst FRICTION = 0.55;\nconst BOUNCE = 0.45;\n/** How long a tray may take, s; how long the whole garden is, s. */\nconst TRAY_TIME = 18;\nconst TOTAL = 90;\n/** The tray's height over the ground. */\nconst LIFT = 0.92;\n\n/** A marble's numbers. */\ninterface Marble {\n  x: number;\n  z: number;\n  vx: number;\n  vz: number;\n  sunk: boolean;\n  prop: number;\n  rolling: number;\n}\n\n/** The garden's state. */\ninterface GardenData {\n  tray: number;\n  tiltX: number;\n  tiltZ: number;\n  marbles: Marble[];\n  sunk: number;\n  total: number;\n  props: number[];\n  trayProp: number;\n  ridgeProps: number[];\n  rakeProps: number[];\n  trayT: number;\n  time: number;\n  rakes: number[];\n  cx: number;\n  cz: number;\n  cy: number;\n  roll: number;\n}\n\n/** The turn of the tray, as a quaternion: pitched and rolled by small tilts. */\nfunction tiltQuat(tx: number, tz: number): number[] {\n  const [x, z] = [tz * 0.5, -tx * 0.5];\n  const w = Math.sqrt(Math.max(0, 1 - x * x - z * z));\n  return [x, 0, z, w];\n}\n\n/** A point on the tray, in the world, tilted. */\nfunction onTray(d: GardenData, x: number, z: number, up = 0.04): [number, number, number] {\n  return [d.cx + x, d.cy + up - x * d.tiltX + z * d.tiltZ, d.cz + z];\n}\n\n/** Sets out tray `index`. */\nfunction setOut(c: Ctx, d: GardenData, index: number): void {\n  for (const id of [...d.props]) {\n    const e = c.w.get(id);\n    if (e?.sceneProp) moveProp(c.w, id, 0, -20, 0, 0);\n  }\n  d.props = [];\n  const def = TRAYS[index];\n  d.marbles = def.marbles.map(([x, z], i) => {\n    const prop = propFor(c, { prop: ['prop:marble', 'prop:marbleRed', 'prop:marbleBlue'][i % 3], at: [0, -20, 0], yaw: 0 });\n    d.props.push(prop);\n    return { x, z, vx: 0, vz: 0, sunk: false, prop, rolling: 0 };\n  });\n  for (const [x, z] of def.holes) {\n    const prop = propFor(c, { prop: 'prop:holeMark', at: [d.cx + x, d.cy + 0.05, d.cz + z], yaw: 0 });\n    d.props.push(prop);\n  }\n  d.ridgeProps = def.ridges.map(([x0, z0, x1, z1]) => {\n    const prop = propFor(c, { prop: 'prop:ridge', at: [d.cx + (x0 + x1) / 2, d.cy + 0.05, d.cz + (z0 + z1) / 2], yaw: -Math.atan2(z1 - z0, x1 - x0) });\n    d.props.push(prop);\n    const e = c.w.get(prop)?.sceneProp;\n    void e;\n    return prop;\n  });\n  d.rakeProps = def.rakes.map((rake) => {\n    const prop = propFor(c, { prop: 'prop:rake', at: [d.cx + rake.x, d.cy + 0.05, d.cz + rake.z], yaw: 0 });\n    d.props.push(prop);\n    return prop;\n  });\n  d.rakes = def.rakes.map(() => 0);\n  d.trayT = 0;\n  c.w.emit('tray', { index });\n}\n\n/** Bounces a marble off a segment: a ridge or a rake. */\nfunction bounceSegment(m: Marble, x0: number, z0: number, x1: number, z1: number): boolean {\n  const [dx, dz] = [x1 - x0, z1 - z0];\n  const len2 = dx * dx + dz * dz || 1;\n  const u = Math.max(0, Math.min(1, ((m.x - x0) * dx + (m.z - z0) * dz) / len2));\n  const [px, pz] = [x0 + dx * u, z0 + dz * u];\n  const [nx, nz] = [m.x - px, m.z - pz];\n  const dist = Math.hypot(nx, nz);\n  if (dist >= R + 0.04 || dist === 0) return false;\n  const [ux, uz] = [nx / dist, nz / dist];\n  m.x = px + ux * (R + 0.04);\n  m.z = pz + uz * (R + 0.04);\n  const vn = m.vx * ux + m.vz * uz;\n  if (vn < 0) {\n    m.vx -= (1 + BOUNCE) * vn * ux;\n    m.vz -= (1 + BOUNCE) * vn * uz;\n    return true;\n  }\n  return false;\n}\n\n/** One step of one marble. */\nfunction roll(c: Ctx, d: GardenData, def: TrayDef, m: Marble): void {\n  const { w } = c;\n  const gravity = w.settings.get<number>('game.garden.gravity');\n  const sink = w.settings.get<number>('game.garden.sink');\n  m.vx += gravity * d.tiltX * w.dt;\n  m.vz -= gravity * d.tiltZ * w.dt;\n  const keep = Math.exp(-FRICTION * w.dt);\n  m.vx *= keep;\n  m.vz *= keep;\n  m.x += m.vx * w.dt;\n  m.z += m.vz * w.dt;\n  let hit = false;\n  // The rim: a gap lets a marble through, and it comes back to its start.\n  const gap = def.gap;\n  if (gap && gap.side === 'S' && m.z > HALF && Math.abs(m.x - gap.at) < gap.half) {\n    const [sx, sz] = def.marbles[d.marbles.indexOf(m)];\n    Object.assign(m, { x: sx, z: sz, vx: 0, vz: 0 });\n    w.emit('marbleLost', {});\n    return;\n  }\n  if (Math.abs(m.x) > HALF) {\n    m.x = Math.sign(m.x) * HALF;\n    m.vx = -m.vx * BOUNCE;\n    hit = true;\n  }\n  if (Math.abs(m.z) > HALF) {\n    m.z = Math.sign(m.z) * HALF;\n    m.vz = -m.vz * BOUNCE;\n    hit = true;\n  }\n  for (const [x0, z0, x1, z1] of def.ridges) hit = bounceSegment(m, x0, z0, x1, z1) || hit;\n  def.rakes.forEach((rake, i) => {\n    const off = Math.sin(d.rakes[i] * rake.speed) * rake.range;\n    const [rx, rz] = rake.alongX ? [rake.x + off, rake.z] : [rake.x, rake.z + off];\n    hit = bounceSegment(m, rx - rake.half, rz, rx + rake.half, rz) || hit;\n  });\n  if (hit && Math.hypot(m.vx, m.vz) > 0.2) w.emit('marbleTap', {});\n  for (const [hx, hz] of def.holes) {\n    if (Math.hypot(hx - m.x, hz - m.z) < CATCH && Math.hypot(m.vx, m.vz) < sink) {\n      m.sunk = true;\n      d.sunk += 1;\n      w.emit('marbleSunk', { n: d.sunk });\n      return;\n    }\n  }\n}\n\n/** Sand Garden. */\nexport const garden: Activity = {\n  id: 'garden',\n  title: 'Sand Garden',\n  station: 'terrace',\n  map: 'actionMap:balanceFree',\n  shot: 'garden',\n  wobble: false,\n  setup(c) {\n    const { x, z } = c.station;\n    const total = TRAYS.reduce((sum, tray) => sum + tray.marbles.length, 0);\n    const cy = c.ground(x, z) + LIFT;\n    const d: GardenData = { tray: 0, tiltX: 0, tiltZ: 0, marbles: [], sunk: 0, total, props: [], trayProp: -1, ridgeProps: [], rakeProps: [], trayT: 0, time: 0, rakes: [], cx: x, cz: z, cy, roll: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    propFor(c, { prop: 'prop:trayStand', at: [x, c.ground(x, z), z], yaw: 0 });\n    d.trayProp = propFor(c, { prop: 'prop:tray', at: [x, cy, z], yaw: 0 });\n    const guest = castOf(c.w, 'guest');\n    if (guest) Object.assign(guest.cast, { hold: true, x, y: c.ground(x, z), z: z + 2.2, yaw: Math.PI, pose: 'Stoop', poseT: 0.6 });\n    setOut(c, d, 0);\n    c.hud.title = 'Sand Garden';\n    c.hud.show = { tray: 0 };\n    enter(c, 'play');\n    say(c, 'plumb', 'garden.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as GardenData;\n    const [{ seat }] = c.seats;\n    const limit = (c.w.settings.get<number>('game.garden.tilt') * Math.PI) / 180;\n    d.time += 1;\n    d.trayT += 1;\n    let [wantX, wantZ] = [seat.lx, seat.ly];\n    if (seat.pointer) [wantX, wantZ] = [seat.px, seat.py];\n    const size = Math.hypot(wantX, wantZ);\n    if (size > 1) [wantX, wantZ] = [wantX / size, wantZ / size];\n    const rate = 5 * c.w.dt;\n    d.tiltX += Math.max(-rate * limit, Math.min(rate * limit, wantX * limit - d.tiltX));\n    d.tiltZ += Math.max(-rate * limit, Math.min(rate * limit, wantZ * limit - d.tiltZ));\n    const def = TRAYS[d.tray];\n    def.rakes.forEach((rake, i) => {\n      d.rakes[i] += c.w.dt * 2;\n      const off = Math.sin(d.rakes[i] * rake.speed) * rake.range;\n      const [rx, rz] = rake.alongX ? [rake.x + off, rake.z] : [rake.x, rake.z + off];\n      moveProp(c.w, d.rakeProps[i], ...onTray(d, rx, rz, 0.05), 0);\n    });\n    let speed = 0;\n    for (const m of d.marbles) {\n      if (!m.sunk) {\n        roll(c, d, def, m);\n        speed = Math.max(speed, Math.hypot(m.vx, m.vz));\n      }\n      moveProp(c.w, m.prop, ...(m.sunk ? ([0, -20, 0] as [number, number, number]) : onTray(d, m.x, m.z, 0.05)), 0);\n    }\n    const q = tiltQuat(d.tiltX, d.tiltZ);\n    moveProp(c.w, d.trayProp, d.cx, d.cy, d.cz, q);\n    const guest = castOf(c.w, 'guest');\n    if (guest) {\n      guest.cast.leanX = (d.tiltX / limit) * 0.6;\n      guest.cast.leanY = (d.tiltZ / limit) * 0.3;\n    }\n    c.hud.show = { tray: d.tray, of: TRAYS.length, sunk: d.sunk, total: d.total, speed, tiltX: d.tiltX / limit, tiltZ: d.tiltZ / limit, seconds: Math.max(0, TOTAL - Math.floor(d.time / c.w.hz)) }; // prettier-ignore\n    c.hud.meter = 1 - d.time / steps(c, TOTAL);\n    c.hud.meterLabel = `Tray ${d.tray + 1} of ${TRAYS.length}`;\n    const allIn = d.marbles.every((m) => m.sunk);\n    if (allIn || d.trayT >= steps(c, TRAY_TIME)) {\n      if (allIn) say(c, 'plumb', 'garden.tray');\n      d.tray += 1;\n      if (d.tray >= TRAYS.length || d.time >= steps(c, TOTAL)) {\n        d.tray = Math.min(d.tray, TRAYS.length - 1);\n        c.a.done = true;\n      } else setOut(c, d, d.tray);\n    }\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as GardenData;\n    const { seat } = e;\n    seat.act = false;\n    if (!player.acts) {\n      seat.lx = seat.ly = 0;\n      return;\n    }\n    const def = TRAYS[d.tray];\n    const free = d.marbles.findIndex((m) => !m.sunk);\n    if (free < 0) return;\n    const m = d.marbles[free];\n    // Aim for the next free hole, through its waypoint while one is left.\n    const taken = new Set(def.holes.map((_h, i) => i).filter((i) => i < d.marbles.filter((k) => k.sunk).length));\n    const hole = def.holes.find((_h, i) => !taken.has(i)) ?? def.holes[0];\n    const mem = seat.mem as { leg?: number; of?: number };\n    if (mem.of !== free * 100 + d.tray) [mem.of, mem.leg] = [free * 100 + d.tray, 0];\n    const via = def.via?.[free] ?? [];\n    let goal: readonly [number, number] = hole;\n    if ((mem.leg ?? 0) < via.length) {\n      goal = via[mem.leg ?? 0];\n      if (Math.hypot(goal[0] - m.x, goal[1] - m.z) < 0.28) mem.leg = (mem.leg ?? 0) + 1;\n    }\n    const delay = player.delay;\n    const hist = (seat.hist as number[]);\n    hist.push(m.x, m.z, m.vx, m.vz);\n    const keep = 4 * (delay + 2);\n    if (hist.length > keep) hist.splice(0, hist.length - keep);\n    const at = Math.max(0, hist.length - 4 - 4 * delay);\n    const [sx, sz, svx, svz] = [hist[at], hist[at + 1], hist[at + 2], hist[at + 3]];\n    const kp = player.name === 'perfect' ? 1.6 : player.name === 'human' ? 1 : 0.8;\n    const kd = player.name === 'perfect' ? 1.1 : 0.9;\n    const jit = player.jitter;\n    const rng = c.w.rng('botJitter', seat.index);\n    seat.lx = kp * (goal[0] - sx) - kd * svx + (jit ? rng.range(-jit, jit) : 0);\n    seat.ly = -(kp * (goal[1] - sz) - kd * svz) + (jit ? rng.range(-jit, jit) : 0);\n  },\n  score(c) {\n    const d = c.a.data as unknown as GardenData;\n    const left = Math.max(0, 1 - d.time / steps(c, TOTAL));\n    return (800 * d.sunk) / d.total + 200 * left * (d.sunk / d.total);\n  },\n};\nEOF\ncat > labs/game/scenes/events/plunge.ts <<'EOF'\n/**\n * @file Cliff Plunge (PLAN.md section 6): three dives from a 14 m cliff. Compose: hold ring and breath for 4 s to fill\n * power. Go: release both feet as a swinging gauge peaks. Air: lean y spins you, lean x twists, scrubbing a rotation\n * strip. Enter the water within 15 degrees of vertical. Three Gulls hold up score cards, 0 to 10; one always scores 4.\n * Wait too long at the lip and you slip off anyway: a small splash, low cards.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'plunge');\n */\nimport { breathe, holdAt, type Player } from '../bot/players';\nimport { SEA_Y } from '../data/stations';\nimport { bothFeet, inRing } from '../wobble';\nimport { after, castOf, enter, entityFor, propFor, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** Seconds: how long composing may wait, the gauge's swing, the cards. */\nconst WAIT = 12;\nconst SWING = 1.4;\nconst GO_BOX = 5;\nconst CARDS_FOR = 3.2;\nconst RING = 0.28;\n/** Gravity on a diver, m/s2. */\nconst FALL = 9.5;\n/** Fifteen degrees, the clean entry. */\nconst CLEAN = (15 * Math.PI) / 180;\n/** How many dives. */\nconst DIVES = 3;\n\n/** The dives' state. */\ninterface PlungeData {\n  dive: number;\n  power: number;\n  gauge: number;\n  q: number;\n  y: number;\n  vy: number;\n  z: number;\n  x: number;\n  angle: number;\n  twist: number;\n  lipY: number;\n  lipZ: number;\n  cards: number[][];\n  sum: number;\n  slip: boolean;\n  gulls: number[];\n  entry: number;\n  airT: number;\n}\n\n/** The three judges' cards for a dive. */\nfunction cardsOf(c: Ctx, d: PlungeData): number[] {\n  if (d.slip) return [1, 2, 4];\n  const full = Math.PI + 2 * Math.PI * Math.max(0, Math.round((d.angle - Math.PI) / (2 * Math.PI)));\n  const err = Math.abs(d.angle - full);\n  d.entry = err;\n  const entry = err <= CLEAN ? 1 : Math.max(0, 1 - (err - CLEAN) / 1.05);\n  const flips = Math.floor((Math.abs(d.angle) + CLEAN) / (2 * Math.PI)) + (Math.abs(d.angle) > 2.5 ? 0.5 : 0);\n  const twists = Math.abs(d.twist) > 5 ? 1 : 0;\n  const base = 1 + 5 * entry + 2 * d.q + (flips >= 1 ? 1 : 0) + twists;\n  const j1 = Math.max(0, Math.min(10, Math.round(base)));\n  const j2 = Math.max(0, Math.min(10, Math.round(base + c.w.rng('judges').range(-0.6, 0.4))));\n  return [j1, j2, 4];\n}\n\n/** Sets up the next dive at the lip. */\nfunction toLip(c: Ctx, d: PlungeData): void {\n  const guest = castOf(c.w, 'guest');\n  const e = c.seats[0].wobble;\n  Object.assign(e, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, sync: 0, calm: 0, lungs: 0, recover: 0 });\n  Object.assign(d, { power: 0, gauge: 0, q: 0, y: d.lipY, vy: 0, z: d.lipZ, x: c.station.x, angle: 0, twist: 0, slip: false, airT: 0 });\n  if (guest) Object.assign(guest.cast, { hold: true, x: d.x, y: d.lipY, z: d.z, yaw: Math.PI, pose: 'DiveReady', poseT: 0, leanX: 0, leanY: 0 });\n  c.hud.title = `Dive ${d.dive + 1} of ${DIVES}`;\n  enter(c, 'compose');\n  say(c, 'plumb', 'plunge.compose');\n}\n\n/** Cliff Plunge. */\nexport const plunge: Activity = {\n  id: 'plunge',\n  title: 'Cliff Plunge',\n  station: 'cliff',\n  map: 'actionMap:balance',\n  shot: 'plunge',\n  wobble: true,\n  setup(c) {\n    const { x, z } = c.station;\n    const lipY = c.ground(x, z) + 0.2;\n    const lipZ = z - 3.6;\n    const d: PlungeData = { dive: 0, power: 0, gauge: 0, q: 0, y: lipY, vy: 0, z: lipZ, x, angle: 0, twist: 0, lipY, lipZ, cards: [], sum: 0, slip: false, gulls: [], entry: 0, airT: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    propFor(c, { prop: 'prop:diveLip', at: [x, lipY - 0.14, z - 6], yaw: Math.PI });\n    for (let g = 0; g < 3; g++) {\n      const [gx, gz] = [x - 8 + g * 2.2, z - 26];\n      d.gulls.push(entityFor(c, { critter: { kind: 'gull', goalX: gx, goalY: SEA_Y + 1.2, goalZ: gz, look: 0, speed: 3, away: false, tick: 0 }, crowdBody: { rig: 'blob', look: 'wings', size: 0.22, x: gx, y: SEA_Y + 1.2, z: gz, yaw: 0, state: {} } as never }));\n      propFor(c, { prop: 'prop:scoreCard', at: [gx, SEA_Y + 2.1, gz], yaw: 0 });\n    }\n    c.hud.disc = true;\n    c.hud.feet = true;\n    c.hud.guide = true;\n    toLip(c, d);\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as PlungeData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const guest = castOf(c.w, 'guest');\n    const cast = guest?.cast;\n    if (c.a.phase === 'compose') {\n      c.hud.disc = true;\n      c.hud.ring = [0, 0, RING];\n      if (inRing(wob, 0, 0, RING) && bothFeet(seat)) d.power = Math.min(1, d.power + c.w.dt / 4);\n      c.hud.meter = d.power;\n      c.hud.meterLabel = 'Compose';\n      c.hud.show = { power: d.power };\n      if (cast) {\n        cast.leanX = wob.x * 1.2;\n        cast.leanY = wob.y * 1.2;\n        cast.poseT = d.power;\n      }\n      if (d.power >= 1) {\n        say(c, 'plumb', 'plunge.go');\n        enter(c, 'go');\n      } else if (after(c, WAIT)) {\n        d.slip = true;\n        say(c, 'tare', 'plunge.slip');\n        c.w.emit('slip', {});\n        d.q = 0;\n        d.vy = 0;\n        enter(c, 'air');\n      }\n      return;\n    }\n    if (c.a.phase === 'go') {\n      const t = (c.a.pt / c.w.hz / SWING) * Math.PI;\n      d.gauge = Math.abs(Math.sin(t));\n      c.hud.show = { gauge: d.gauge, power: 1 };\n      c.hud.meter = d.gauge;\n      c.hud.meterLabel = 'Let go at the top';\n      if (!bothFeet(seat)) {\n        d.q = d.gauge;\n        d.vy = 1.5 + d.q * 3;\n        c.w.emit('launch', { q: d.q });\n        enter(c, 'air');\n      } else if (after(c, GO_BOX)) {\n        d.slip = true;\n        d.q = 0;\n        d.vy = 0;\n        say(c, 'tare', 'plunge.slip');\n        c.w.emit('slip', {});\n        enter(c, 'air');\n      }\n      return;\n    }\n    if (c.a.phase === 'air') {\n      c.hud.disc = false;\n      wob.on = false;\n      d.vy -= FALL * c.w.dt;\n      d.y += d.vy * c.w.dt;\n      d.z -= (d.slip ? 2.2 : 3.2 + d.q * 2.2) * c.w.dt;\n      if (!d.slip) {\n        const spin = c.w.settings.get<number>('game.dive.spin');\n        d.angle += seat.ly * spin * c.w.dt;\n        d.twist += seat.lx * spin * c.w.dt;\n      } else d.angle += 2.6 * c.w.dt;\n      d.airT += 1;\n      if (cast) {\n        cast.z = d.z;\n        cast.y = d.y;\n        cast.yaw = Math.PI + d.twist;\n        cast.pose = 'Somersault';\n        cast.poseT = Math.max(0, Math.min(1, d.angle / (4 * Math.PI)));\n        cast.leanX = cast.leanY = 0;\n      }\n      c.hud.show = { angle: d.angle, twist: d.twist, air: true };\n      if (d.y <= SEA_Y - 0.4) {\n        const cards = cardsOf(c, d);\n        d.cards.push(cards);\n        d.sum += cards[0] + cards[1] + cards[2];\n        c.w.emit('splash', { big: !d.slip, x: d.x, z: d.z, y: SEA_Y });\n        c.w.emit('cards', { cards, dive: d.dive, entry: d.entry });\n        say(c, 'tare', d.slip ? 'plunge.slipped' : cards[0] >= 8 ? 'plunge.great' : 'plunge.dive');\n        if (cast) Object.assign(cast, { y: SEA_Y - 0.9, pose: 'Splashed', poseT: 1 });\n        enter(c, 'cards');\n      }\n      return;\n    }\n    // Cards.\n    c.hud.show = { cards: d.cards[d.cards.length - 1], dive: d.dive, slip: d.slip };\n    if (after(c, CARDS_FOR)) {\n      d.dive += 1;\n      wob.on = true;\n      if (d.dive >= DIVES) c.a.done = true;\n      else toLip(c, d);\n    }\n    void steps;\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as PlungeData;\n    const { seat, wobble } = e;\n    seat.act = false;\n    if (c.a.phase === 'compose') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      seat.fl = seat.fr = player.acts ? 1 : 0;\n      breathe;\n    } else if (c.a.phase === 'go') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      seat.fl = seat.fr = player.acts ? 1 : 0;\n      const period = SWING * c.w.hz;\n      const atPeak = Math.abs((c.a.pt % period) - period / 2) < 1 + player.timing;\n      if (player.acts && atPeak && c.a.pt > 10) seat.fl = seat.fr = 0;\n    } else if (c.a.phase === 'air') {\n      seat.fl = seat.fr = 0;\n      if (!player.acts) {\n        seat.lx = seat.ly = 0;\n        return;\n      }\n      // Solve the rest of the fall, and turn so as to arrive head down.\n      const left = (d.vy + Math.sqrt(Math.max(0, d.vy * d.vy + 2 * FALL * (d.y - SEA_Y + 0.4)))) / FALL;\n      const target = 3 * Math.PI;\n      const spin = c.w.settings.get<number>('game.dive.spin');\n      const lag = player.delay / c.w.hz;\n      const want = (target - d.angle) / Math.max(0.1, left + lag * 0.2);\n      seat.ly = Math.max(-1, Math.min(1, want / spin));\n      seat.lx = player.name === 'sloppy' ? 0 : Math.max(-1, Math.min(1, ((6 - d.twist) / Math.max(0.2, left)) / spin));\n    } else {\n      seat.lx = seat.ly = seat.fl = seat.fr = 0;\n    }\n  },\n  score(c) {\n    const d = c.a.data as unknown as PlungeData;\n    return (d.sum / (24 * DIVES)) * 1000;\n  },\n};\nEOF\ncat > labs/game/scenes/events/hoop.ts <<'EOF'\n/**\n * @file Hoop Patrol (PLAN.md section 6): hoops fly in from Tare. Spin your stick in circles: angular speed in the band keeps\n * every hoop up; outside it they sink and fall. A new hoop every 8 s from a telegraphed side: lean that way within 0.6 s\n * to catch it. Up to eight at once. Alternate feet at 2.5 Hz counts as spinning too; a mouse circles. Every seat plays.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'hoop');\n */\nimport type { Player } from '../bot/players';\nimport { MAT_OFFSETS } from '../data/stations';\nimport { enter, floorShape, say, standSeats, steps } from './kit';\nimport type { Activity, Ctx, SeatEntity } from './types';\n\n/** Seconds: the whole class, a new hoop, the warning, the catch. */\nconst LENGTH = 60;\nconst EVERY = 8;\nconst WARN = 1.2;\nconst WINDOW = 0.6;\nconst MAX_HOOPS = 8;\n/** Hoop·seconds a very good class earns: 1000. */\nconst FULL = 250;\nconst FULL_SHORT = 150;\n\n/** One seat's numbers. */\ninterface HoopSeat {\n  angle: number;\n  was: number[];\n  spin: number;\n  footT: number;\n  lastFoot: string;\n  hoops: number[];\n  sum: number;\n  shape: number[];\n  caught: number;\n  inBand: boolean;\n  mouseAngle: number;\n}\n\n/** The class's state. */\ninterface HoopData {\n  seats: HoopSeat[];\n  next: number;\n  side: number;\n  phase: 'wait' | 'warn' | 'catch';\n  phaseT: number;\n  lead: number;\n  waist: number[];\n  length: number;\n}\n\n/** One seat's step. */\nfunction stepSeat(c: Ctx, d: HoopData, e: SeatEntity): void {\n  const s = d.seats[e.seat.index];\n  const { w } = c;\n  const { seat } = e;\n  // The stick's angle round the centre.\n  const size = Math.hypot(seat.lx, seat.ly);\n  let rate = 0;\n  if (size > 0.4) {\n    const angle = Math.atan2(seat.ly, seat.lx);\n    if (s.was.length) {\n      const prior = s.was[0];\n      const change = Math.atan2(Math.sin(angle - prior), Math.cos(angle - prior));\n      rate = Math.abs(change) * w.hz;\n    }\n    s.was = [angle];\n    s.angle = angle;\n  } else s.was = [];\n  // The mouse: its heading turning is a circle.\n  if (seat.moved > 0.002) {\n    const heading = Math.atan2(seat.my, seat.mx);\n    const change = Math.atan2(Math.sin(heading - s.mouseAngle), Math.cos(heading - s.mouseAngle));\n    rate = Math.max(rate, Math.abs(change) * w.hz);\n    s.mouseAngle = heading;\n    s.angle = heading;\n  }\n  // Alternating feet at 2.5 Hz or more counts as spinning.\n  s.footT += 1;\n  const foot = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n  let feet = 0;\n  if (foot && foot !== s.lastFoot) {\n    if (s.footT <= w.hz / 2.5 + 2) feet = 7;\n    s.footT = 0;\n    s.lastFoot = foot;\n  }\n  if (feet > 0) rate = Math.max(rate, feet);\n  if (s.footT < w.hz / 2.5 + 2 && s.lastFoot) rate = Math.max(rate, 7);\n  s.spin += (rate - s.spin) * (1 - Math.exp(-w.dt / 0.22));\n  const lo = w.settings.get<number>('game.hoop.bandMin');\n  const hi = w.settings.get<number>('game.hoop.bandMax');\n  s.inBand = s.spin >= lo && s.spin <= hi;\n  // Hoops rise toward the waist in the band, and sink out of it.\n  const speed = s.inBand ? 0.6 : -0.55;\n  s.hoops = s.hoops.map((h) => Math.min(1, h + speed * w.dt));\n  const before = s.hoops.length;\n  s.hoops = s.hoops.filter((h) => h > 0);\n  if (s.hoops.length < before) w.emit('hoopDrop', { seat: seat.index, left: s.hoops.length });\n  s.sum += s.hoops.length * w.dt;\n  const cast = w.get(seat.actor)?.cast;\n  const y = d.waist[seat.index];\n  s.shape.forEach((id, i) => {\n    const ring = w.get(id)?.matRing;\n    if (!ring || !cast) return;\n    const shown = i < s.hoops.length;\n    ring.telegraph = shown ? (i % 2 ? 'telegraph:hoop2' : 'telegraph:hoop') : '';\n    const h = s.hoops[i] ?? 0;\n    const wig = 0.05 * Math.sin(s.angle + i * 1.6);\n    ring.position = [cast.x + wig, y - 0.55 + h * 0.55 + i * 0.07, cast.z + 0.05 * Math.cos(s.angle + i * 1.6)];\n  });\n  if (cast) {\n    cast.pose = 'HipCircle';\n    cast.poseT = (s.angle + Math.PI) / (2 * Math.PI);\n    cast.leanX = cast.leanY = 0;\n  }\n}\n\n/** Hoop Patrol. */\nexport const hoop: Activity = {\n  id: 'hoop',\n  title: 'Hoop Patrol',\n  station: 'hoopBeach',\n  map: 'actionMap:balance',\n  shot: 'hoop',\n  wobble: false,\n  setup(c) {\n    const lead = steps(c, c.a.short ? 6 : 2);\n    const d: HoopData = {\n      seats: [0, 1, 2, 3].map(() => ({ angle: 0, was: [], spin: 0, footT: 999, lastFoot: '', hoops: [0.6], sum: 0, shape: [], caught: 0, inBand: false, mouseAngle: 0 })),\n      next: lead + steps(c, 3),\n      side: 1,\n      phase: 'wait',\n      phaseT: 0,\n      lead,\n      waist: [0, 0, 0, 0],\n      length: steps(c, c.a.short ? 45 : LENGTH) + lead,\n    };\n    c.a.data = d as unknown as Record<string, unknown>;\n    if (c.round) standSeats(c, MAT_OFFSETS, Math.PI);\n    else {\n      const guest = c.w.get(c.seats[0].seat.actor)?.cast;\n      const [x, z] = [c.station.x, c.station.z];\n      if (guest) Object.assign(guest, { hold: true, x, y: c.ground(x, z), z, yaw: Math.PI });\n      const tare = c.w.query('cast').find((k) => k.cast.who === 'tare');\n      if (tare) Object.assign(tare.cast, { hold: true, x: x + 3, y: c.ground(x + 3, z - 3), z: z - 3, yaw: -0.8 });\n    }\n    for (const e of c.seats) {\n      const s = d.seats[e.seat.index];\n      const cast = c.w.get(e.seat.actor)?.cast;\n      const y = cast ? cast.y + 0.86 : 8.9;\n      d.waist[e.seat.index] = y;\n      for (let i = 0; i < MAX_HOOPS; i++) s.shape.push(floorShape(c, '', cast?.x ?? 0, y, cast?.z ?? 0));\n    }\n    c.hud.title = 'Hoop Patrol';\n    c.hud.disc = false;\n    enter(c, 'play');\n    say(c, 'tare', 'hoop.start');\n  },\n  step(c) {\n    const d = c.a.data as unknown as HoopData;\n    const now = c.a.t;\n    for (const e of c.seats) stepSeat(c, d, e);\n    // New hoops.\n    d.phaseT += 1;\n    if (d.phase === 'wait' && now >= d.next) {\n      d.phase = 'warn';\n      d.phaseT = 0;\n      d.side = c.w.rng('hoops').chance(0.5) ? 1 : -1;\n      c.w.emit('hoopWarn', { side: d.side });\n    } else if (d.phase === 'warn' && d.phaseT >= steps(c, WARN)) {\n      d.phase = 'catch';\n      d.phaseT = 0;\n      c.w.emit('hoopFly', { side: d.side });\n    } else if (d.phase === 'catch') {\n      for (const e of c.seats) {\n        const s = d.seats[e.seat.index];\n        if (s.caught === d.next) continue;\n        if (e.seat.lx * d.side > 0.5 || e.seat.mx * d.side > 0.01) {\n          s.caught = d.next;\n          if (s.hoops.length < MAX_HOOPS) s.hoops.push(0.4);\n          c.w.emit('hoopCatch', { seat: e.seat.index, hoops: s.hoops.length });\n        }\n      }\n      if (d.phaseT >= steps(c, WINDOW)) {\n        d.phase = 'wait';\n        d.next = now + steps(c, EVERY - WARN - WINDOW);\n      }\n    }\n    const me = d.seats[c.seats[0].seat.index];\n    const lo = c.w.settings.get<number>('game.hoop.bandMin');\n    const hi = c.w.settings.get<number>('game.hoop.bandMax');\n    c.hud.show = { spin: me.spin, lo, hi, hoops: me.hoops.length, phase: d.phase, side: d.side, angle: me.angle, inBand: me.inBand };\n    c.hud.meter = 1 - now / d.length;\n    if (now >= d.length) c.a.done = true;\n  },\n  bot(c, e, player: Player) {\n    const { seat } = e;\n    seat.act = false;\n    seat.fl = seat.fr = 0;\n    if (!player.acts) {\n      seat.lx = seat.ly = 0;\n      return;\n    }\n    const mem = seat.mem as { angle?: number };\n    const wobbly = player.name === 'perfect' ? 0 : player.name === 'human' ? 0.8 : 3.2;\n    const rate = 7 + wobbly * Math.sin(c.a.t * 0.021 + seat.index);\n    mem.angle = (mem.angle ?? 0) + rate * c.w.dt;\n    const jitter = player.jitter;\n    const rng = c.w.rng('botJitter', seat.index);\n    seat.lx = Math.cos(mem.angle) + (jitter ? rng.range(-jitter, jitter) : 0);\n    seat.ly = Math.sin(mem.angle) + (jitter ? rng.range(-jitter, jitter) : 0);\n  },\n  score(c, index) {\n    const d = c.a.data as unknown as HoopData;\n    return (1000 * d.seats[index].sum) / (c.a.short ? FULL_SHORT : FULL);\n  },\n};\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\ns=open(p).read()\ns=s.replace(\"import { group, setGroupTable } from './group';\",\"import { garden } from './garden';\\nimport { group, setGroupTable } from './group';\\nimport { hoop } from './hoop';\\nimport { paddle } from './paddle';\\nimport { plunge } from './plunge';\")\ns=s.replace(\"  reps,\\n  step,\\n  line,\",\"  reps,\\n  step,\\n  line,\\n  paddle,\\n  garden,\\n  plunge,\\n  hoop,\")\nopen(p,'w').write(s)\nEOF\nTEETER_SEEDS=2 TEETER_SHOW=1 TEETER_ONLY=paddle,garden,plunge,hoop npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -E \"^(paddle|garden|plunge|hoop)|^  [phsi]:|AssertionError|Error:|❯ labs|Tests \" | head -30 | cut -c1-220","description":"Write Paddle, Garden, Plunge and Hoop, then test balance","timeout":400000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25393,"cache_read_input_tokens":418765,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25393},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"3f732496-71d9-4d8b-b58d-463e9e1d6bb3","timestamp":"2026-11-05T09:47:40.304Z","request_id":"req_011CgjZpfkgJQ74kNMunLrry","wire_tool_inputs":{"toolu_01HFkLb58Lak3xc8twSpCTuF":{"command":"cat > labs/game/scenes/data/courses.ts <<'EOF'\n/**\n * @file The water and land courses (PLAN.md section 6): Paddle Glide's twelve gates round the lagoon and the coast path's\n * ring of flags. Each a table; a new course is a new table.\n *\n * Game code, sim-side data.\n *\n * @example\n * GATES.length; // 12\n */\n\n/** Paddle Glide's course: a circle out in the lagoon, its centre and radius. */\nexport const LAGOON = { x: -82, z: 128, radius: 30 } as const;\n\n/** The twelve gates, as angles round the lagoon. */\nexport const GATES: readonly number[] = Array.from({ length: 12 }, (_v, i) => Math.PI / 2 + ((i + 1) * 2 * Math.PI) / 12);\n\n/** The coast path, in order: past every landmark and back to the Plaza. */\nexport const COAST: readonly (readonly [number, number])[] = [\n  [8, 44], [22, 62], [34, 78], [52, 76], [66, 72], [82, 58], [90, 36], [90, 12], [92, -12], [84, -38], [64, -56],\n  [40, -66], [18, -66], [-4, -66], [-26, -64], [-50, -52], [-76, -34], [-92, -8], [-94, 20], [-82, 48], [-60, 66],\n  [-36, 76], [-14, 66], [-4, 48],\n]; // prettier-ignore\nEOF\ncat > labs/game/scenes/data/trays.ts <<'EOF'\n/**\n * @file Sand Garden's trays (PLAN.md section 6): 1 to 3 marbles each, rising to moving rakes and a gap in the rim. The tray\n * is 2.4 m wide, its half 1.2. Adding a row adds a tray. `via` is where the bot aims first, so it can find the way.\n *\n * Game code, sim-side data.\n *\n * @example\n * TRAYS[0].marbles.length; // 1\n */\n\n/** A point on a tray. */\ntype P = readonly [number, number];\n\n/** A tray. */\nexport interface TrayDef {\n  marbles: readonly P[];\n  holes: readonly P[];\n  /** Ridges: [x0, z0, x1, z1]. */\n  ridges: readonly (readonly [number, number, number, number])[];\n  /** Moving rakes: x, z, half length, speed, along x when true. */\n  rakes: readonly { x: number; z: number; half: number; speed: number; range: number; alongX: boolean }[];\n  /** A gap in the rim: on which side, centre, half width. Marbles that fall through come back. */\n  gap?: { side: 'N' | 'S' | 'E' | 'W'; at: number; half: number };\n  /** The bot's waypoints per marble. */\n  via?: readonly (readonly P[])[];\n}\n\n/** The trays. */\nexport const TRAYS: readonly TrayDef[] = [\n  { marbles: [[-0.7, 0.7]], holes: [[0.6, -0.6]], ridges: [], rakes: [] },\n  {\n    marbles: [[-0.8, -0.7], [0.8, -0.7]],\n    holes: [[-0.6, 0.7], [0.6, 0.7]],\n    ridges: [[-0.25, -0.2, 0.25, -0.2]],\n    rakes: [],\n  },\n  {\n    marbles: [[-0.85, 0.85], [-0.4, 0.85]],\n    holes: [[0.8, -0.8], [0.3, -0.8]],\n    ridges: [[-1.2, 0, 0.5, 0]],\n    rakes: [],\n    via: [[[0.85, 0.4], [0.85, -0.3]], [[0.85, 0.4], [0.85, -0.3]]],\n  },\n  {\n    marbles: [[-0.9, 0.9], [0, 0.9], [0.9, 0.9]],\n    holes: [[-0.7, -0.8], [0, -0.8], [0.7, -0.8]],\n    ridges: [],\n    rakes: [{ x: 0, z: 0, half: 0.4, speed: 0.5, range: 0.75, alongX: true }],\n  },\n  {\n    marbles: [[-0.8, 0.8], [0.8, 0.8], [0, 0.2]],\n    holes: [[-0.8, -0.85], [0.8, -0.85], [0, -0.3]],\n    ridges: [[-0.5, 0.3, -0.1, 0.3], [0.1, 0.3, 0.5, 0.3]],\n    rakes: [{ x: 0, z: -0.65, half: 0.3, speed: 0.4, range: 0.5, alongX: true }],\n    gap: { side: 'S', at: 0, half: 0.22 },\n  },\n]; // prettier-ignore\nEOF\ncat > labs/game/scenes/events/paddle.ts <<'EOF'\n/**\n * @file Paddle Glide (PLAN.md section 6): stand on a board. Forward lean is speed, side lean steers, feet alternating at\n * about 1.2 Hz give +30% and a kick. Twelve buoy gates round the lagoon with seeded jitter. A ferry wake at gate 7 and a\n * crossing turtle at gate 9 shove your centre. A topple is a splash and a 3-second remount.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'paddle');\n */\nimport { holdAt, type Player } from '../bot/players';\nimport { GATES, LAGOON } from '../data/courses';\nimport { SEA_Y } from '../data/stations';\nimport { after, castOf, enter, moveProp, propFor, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** How close to a buoy counts, m; how long the course is open, s; how fast side lean turns, rad/s. */\nconst GATE_REACH = 4.6;\nconst LENGTH = 75;\nconst TURN = 1.2;\n\n/** The glide's state. */\ninterface PaddleData {\n  x: number;\n  z: number;\n  yaw: number;\n  speed: number;\n  gate: number;\n  gates: number[][];\n  props: number[];\n  board: number;\n  boost: number;\n  lastFoot: string;\n  footT: number;\n  time: number;\n  finished: number;\n  wake: number;\n  turtle: number;\n  shoved: number[];\n  paddleT: number;\n}\n\n/** Puts the gates' props right: the next one is the lit one. */\nfunction lightGate(c: Ctx, d: PaddleData): void {\n  const [x, z] = d.gates[Math.min(d.gate, d.gates.length - 1)];\n  moveProp(c.w, d.props[0], x, SEA_Y, z, 0);\n}\n\n/** Paddle Glide. */\nexport const paddle: Activity = {\n  id: 'paddle',\n  title: 'Paddle Glide',\n  station: 'lagoon',\n  map: 'actionMap:balance',\n  shot: 'paddle',\n  wobble: true,\n  setup(c) {\n    const rng = c.w.rng('gates');\n    const gates = GATES.map((angle) => {\n      const r = LAGOON.radius + rng.range(-2.5, 2.5);\n      return [LAGOON.x + Math.cos(angle) * r, LAGOON.z + Math.sin(angle) * r];\n    });\n    const startX = LAGOON.x + Math.cos(Math.PI / 2) * LAGOON.radius;\n    const startZ = LAGOON.z + Math.sin(Math.PI / 2) * LAGOON.radius;\n    const d: PaddleData = { x: startX, z: startZ, yaw: -Math.PI / 2 + 0.3, speed: 0, gate: 0, gates, props: [], board: -1, boost: 0, lastFoot: '', footT: 999, time: 0, finished: -1, wake: -1, turtle: -1, shoved: [], paddleT: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    d.props.push(propFor(c, { prop: 'prop:buoyNext', at: [gates[0][0], SEA_Y, gates[0][1]], yaw: 0 }));\n    for (const [x, z] of gates) propFor(c, { prop: 'prop:buoy', at: [x, SEA_Y, z], yaw: 0 });\n    d.board = propFor(c, { prop: 'prop:paddleboard', at: [startX, SEA_Y + 0.02, startZ], yaw: d.yaw });\n    d.wake = propFor(c, { prop: 'prop:wake', at: [0, -20, 0], yaw: 0 });\n    d.turtle = propFor(c, { prop: 'prop:turtle', at: [0, -20, 0], yaw: 0 });\n    const guest = castOf(c.w, 'guest');\n    if (guest) Object.assign(guest.cast, { hold: true, x: startX, y: SEA_Y + 0.14, z: startZ, yaw: d.yaw, pose: 'Paddling', poseT: 0 });\n    c.hud.disc = true;\n    c.hud.feet = true;\n    c.hud.title = 'Paddle Glide';\n    enter(c, 'glide');\n    say(c, 'tare', 'paddle.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as PaddleData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const guest = castOf(c.w, 'guest');\n    const cast = guest?.cast;\n    d.time += 1;\n    wob.usesBreath = false;\n    if (c.a.phase === 'remount') {\n      if (cast) cast.y = c.a.pt < steps(c, 2) ? SEA_Y - 0.6 : SEA_Y + 0.14;\n      if (after(c, 3)) {\n        Object.assign(wob, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, recover: 0 });\n        enter(c, 'glide');\n      }\n    } else {\n      // Feet: alternating at about 1.2 Hz gives +30% and a kick.\n      d.footT += 1;\n      const foot = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n      if (foot && foot !== d.lastFoot) {\n        if (d.footT < c.w.hz * 1.3) {\n          d.boost = Math.min(1, d.boost + 0.5);\n          d.speed += 0.4;\n        }\n        d.footT = 0;\n        d.lastFoot = foot;\n        d.paddleT += 0.5;\n        c.w.emit('paddleStroke', { foot });\n      }\n      d.boost = Math.max(0, d.boost - c.w.dt * 0.7);\n      const top = c.w.settings.get<number>('game.paddle.speed') * (1 + 0.3 * d.boost);\n      const want = Math.max(0, Math.min(1, wob.y / 0.8)) * top;\n      d.speed += (want - d.speed) * (1 - Math.exp(-c.w.dt * 1.4));\n      d.yaw -= wob.x * TURN * c.w.dt;\n      d.x += Math.sin(d.yaw) * d.speed * c.w.dt;\n      d.z += Math.cos(d.yaw) * d.speed * c.w.dt;\n      // Gates, in order.\n      if (d.gate < d.gates.length) {\n        const [gx, gz] = d.gates[d.gate];\n        if (Math.hypot(gx - d.x, gz - d.z) <= GATE_REACH) {\n          d.gate += 1;\n          c.w.emit('gate', { gate: d.gate });\n          if (d.gate < d.gates.length) lightGate(c, d);\n          else {\n            moveProp(c.w, d.props[0], 0, -20, 0, 0);\n            d.finished = d.time;\n            say(c, 'tare', 'paddle.done');\n            c.a.done = true;\n          }\n        }\n      }\n      // The ferry's wake and the turtle.\n      if (d.gate === 7 && !d.shoved.includes(7)) {\n        d.shoved.push(7);\n        wob.vy -= 1.5;\n        wob.vx += 0.6;\n        c.w.emit('wake', {});\n        say(c, 'tare', 'paddle.wake');\n        moveProp(c.w, d.wake, d.x, SEA_Y + 0.05, d.z + 6, d.yaw);\n      }\n      if (d.gate === 9 && !d.shoved.includes(9)) {\n        d.shoved.push(9);\n        wob.vx -= 1.3;\n        c.w.emit('turtle', {});\n        say(c, 'tare', 'paddle.turtle');\n        moveProp(c.w, d.turtle, d.x + Math.sin(d.yaw) * 7, SEA_Y + 0.05, d.z + Math.cos(d.yaw) * 7, d.yaw + 1.4);\n      }\n      if (wob.recover > 0) {\n        c.w.emit('splash', { big: false, x: d.x, z: d.z, y: SEA_Y });\n        say(c, 'tare', 'paddle.fall');\n        d.speed = 0;\n        enter(c, 'remount');\n      }\n    }\n    if (cast) {\n      cast.x = d.x;\n      cast.z = d.z;\n      cast.yaw = d.yaw;\n      if (c.a.phase === 'glide') cast.y = SEA_Y + 0.14;\n      cast.pose = 'Paddling';\n      cast.poseT = d.paddleT;\n      cast.leanX = wob.x * 0.8;\n      cast.leanY = wob.y * 0.6;\n    }\n    moveProp(c.w, d.board, d.x, SEA_Y + 0.02 + Math.sin(c.a.t * 0.05) * 0.015, d.z, d.yaw);\n    const [gx, gz] = d.gates[Math.min(d.gate, d.gates.length - 1)];\n    let err = Math.atan2(gx - d.x, gz - d.z) - d.yaw;\n    err = Math.atan2(Math.sin(err), Math.cos(err));\n    c.hud.ring = [0, 0.55, 0.5];\n    c.hud.meter = d.gate / d.gates.length;\n    c.hud.meterLabel = `Gate ${Math.min(d.gate + 1, 12)} of 12`;\n    c.hud.show = { err, speed: d.speed, seconds: Math.max(0, LENGTH - Math.floor(d.time / c.w.hz)), boost: d.boost };\n    if (d.time >= steps(c, LENGTH)) {\n      say(c, 'tare', 'paddle.time');\n      c.a.done = true;\n    }\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as PaddleData;\n    const { seat, wobble } = e;\n    seat.act = false;\n    if (!player.acts) {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      seat.fl = seat.fr = 0;\n      return;\n    }\n    const [gx, gz] = d.gates[Math.min(d.gate, d.gates.length - 1)];\n    let err = Math.atan2(gx - d.x, gz - d.z) - d.yaw;\n    err = Math.atan2(Math.sin(err), Math.cos(err));\n    const turn = Math.max(-0.55, Math.min(0.55, -err * 1.2));\n    const go = Math.abs(err) < 0.9 ? 0.62 : 0.2;\n    holdAt(c.w, seat, wobble, turn, go, player);\n    const cycle = Math.round((c.w.hz / 1.2) * (player.name === 'perfect' ? 1 : 1.1));\n    const t = c.a.t % cycle;\n    const left = Math.floor(c.a.t / cycle) % 2 === 0;\n    seat.fl = left && t < 6 ? 1 : 0;\n    seat.fr = !left && t < 6 ? 1 : 0;\n  },\n  score(c) {\n    const d = c.a.data as unknown as PaddleData;\n    const bonus = d.finished > 0 ? 280 * Math.min(1, (steps(c, LENGTH) - d.finished) / steps(c, 40)) : 0;\n    return d.gate * 60 + bonus;\n  },\n};\nEOF\ncat > labs/game/scenes/events/garden.ts <<'EOF'\n/**\n * @file Sand Garden (PLAN.md section 6): a raked sand tray on a stand, seen from above. Lean tilts it up to 12 degrees; the\n * pointer's place on the tray does the same. Marbles obey a little 2D integrator of the game's own (slope, friction,\n * ridges, holes that catch below a speed). No Wobble noise here: this one is about touch.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'garden');\n */\nimport type { Player } from '../bot/players';\nimport { TRAYS, type TrayDef } from '../data/trays';\nimport { castOf, enter, moveProp, propFor, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** The tray's half width, m; a marble's radius, m; a hole's catching radius. */\nconst HALF = 1.17;\nconst R = 0.055;\nconst CATCH = 0.12;\n/** Rolling friction, 1/s; bounce off rims and ridges. */\nconst FRICTION = 0.55;\nconst BOUNCE = 0.45;\n/** How long a tray may take, s; how long the whole garden is, s. */\nconst TRAY_TIME = 18;\nconst TOTAL = 90;\n/** The tray's height over the ground. */\nconst LIFT = 0.92;\n\n/** A marble's numbers. */\ninterface Marble {\n  x: number;\n  z: number;\n  vx: number;\n  vz: number;\n  sunk: boolean;\n  prop: number;\n  rolling: number;\n}\n\n/** The garden's state. */\ninterface GardenData {\n  tray: number;\n  tiltX: number;\n  tiltZ: number;\n  marbles: Marble[];\n  sunk: number;\n  total: number;\n  props: number[];\n  trayProp: number;\n  ridgeProps: number[];\n  rakeProps: number[];\n  trayT: number;\n  time: number;\n  rakes: number[];\n  cx: number;\n  cz: number;\n  cy: number;\n  roll: number;\n}\n\n/** The turn of the tray, as a quaternion: pitched and rolled by small tilts. */\nfunction tiltQuat(tx: number, tz: number): number[] {\n  const [x, z] = [tz * 0.5, -tx * 0.5];\n  const w = Math.sqrt(Math.max(0, 1 - x * x - z * z));\n  return [x, 0, z, w];\n}\n\n/** A point on the tray, in the world, tilted. */\nfunction onTray(d: GardenData, x: number, z: number, up = 0.04): [number, number, number] {\n  return [d.cx + x, d.cy + up - x * d.tiltX + z * d.tiltZ, d.cz + z];\n}\n\n/** Sets out tray `index`. */\nfunction setOut(c: Ctx, d: GardenData, index: number): void {\n  for (const id of [...d.props]) {\n    const e = c.w.get(id);\n    if (e?.sceneProp) moveProp(c.w, id, 0, -20, 0, 0);\n  }\n  d.props = [];\n  const def = TRAYS[index];\n  d.marbles = def.marbles.map(([x, z], i) => {\n    const prop = propFor(c, { prop: ['prop:marble', 'prop:marbleRed', 'prop:marbleBlue'][i % 3], at: [0, -20, 0], yaw: 0 });\n    d.props.push(prop);\n    return { x, z, vx: 0, vz: 0, sunk: false, prop, rolling: 0 };\n  });\n  for (const [x, z] of def.holes) {\n    const prop = propFor(c, { prop: 'prop:holeMark', at: [d.cx + x, d.cy + 0.05, d.cz + z], yaw: 0 });\n    d.props.push(prop);\n  }\n  d.ridgeProps = def.ridges.map(([x0, z0, x1, z1]) => {\n    const prop = propFor(c, { prop: 'prop:ridge', at: [d.cx + (x0 + x1) / 2, d.cy + 0.05, d.cz + (z0 + z1) / 2], yaw: -Math.atan2(z1 - z0, x1 - x0) });\n    d.props.push(prop);\n    const e = c.w.get(prop)?.sceneProp;\n    void e;\n    return prop;\n  });\n  d.rakeProps = def.rakes.map((rake) => {\n    const prop = propFor(c, { prop: 'prop:rake', at: [d.cx + rake.x, d.cy + 0.05, d.cz + rake.z], yaw: 0 });\n    d.props.push(prop);\n    return prop;\n  });\n  d.rakes = def.rakes.map(() => 0);\n  d.trayT = 0;\n  c.w.emit('tray', { index });\n}\n\n/** Bounces a marble off a segment: a ridge or a rake. */\nfunction bounceSegment(m: Marble, x0: number, z0: number, x1: number, z1: number): boolean {\n  const [dx, dz] = [x1 - x0, z1 - z0];\n  const len2 = dx * dx + dz * dz || 1;\n  const u = Math.max(0, Math.min(1, ((m.x - x0) * dx + (m.z - z0) * dz) / len2));\n  const [px, pz] = [x0 + dx * u, z0 + dz * u];\n  const [nx, nz] = [m.x - px, m.z - pz];\n  const dist = Math.hypot(nx, nz);\n  if (dist >= R + 0.04 || dist === 0) return false;\n  const [ux, uz] = [nx / dist, nz / dist];\n  m.x = px + ux * (R + 0.04);\n  m.z = pz + uz * (R + 0.04);\n  const vn = m.vx * ux + m.vz * uz;\n  if (vn < 0) {\n    m.vx -= (1 + BOUNCE) * vn * ux;\n    m.vz -= (1 + BOUNCE) * vn * uz;\n    return true;\n  }\n  return false;\n}\n\n/** One step of one marble. */\nfunction roll(c: Ctx, d: GardenData, def: TrayDef, m: Marble): void {\n  const { w } = c;\n  const gravity = w.settings.get<number>('game.garden.gravity');\n  const sink = w.settings.get<number>('game.garden.sink');\n  m.vx += gravity * d.tiltX * w.dt;\n  m.vz -= gravity * d.tiltZ * w.dt;\n  const keep = Math.exp(-FRICTION * w.dt);\n  m.vx *= keep;\n  m.vz *= keep;\n  m.x += m.vx * w.dt;\n  m.z += m.vz * w.dt;\n  let hit = false;\n  // The rim: a gap lets a marble through, and it comes back to its start.\n  const gap = def.gap;\n  if (gap && gap.side === 'S' && m.z > HALF && Math.abs(m.x - gap.at) < gap.half) {\n    const [sx, sz] = def.marbles[d.marbles.indexOf(m)];\n    Object.assign(m, { x: sx, z: sz, vx: 0, vz: 0 });\n    w.emit('marbleLost', {});\n    return;\n  }\n  if (Math.abs(m.x) > HALF) {\n    m.x = Math.sign(m.x) * HALF;\n    m.vx = -m.vx * BOUNCE;\n    hit = true;\n  }\n  if (Math.abs(m.z) > HALF) {\n    m.z = Math.sign(m.z) * HALF;\n    m.vz = -m.vz * BOUNCE;\n    hit = true;\n  }\n  for (const [x0, z0, x1, z1] of def.ridges) hit = bounceSegment(m, x0, z0, x1, z1) || hit;\n  def.rakes.forEach((rake, i) => {\n    const off = Math.sin(d.rakes[i] * rake.speed) * rake.range;\n    const [rx, rz] = rake.alongX ? [rake.x + off, rake.z] : [rake.x, rake.z + off];\n    hit = bounceSegment(m, rx - rake.half, rz, rx + rake.half, rz) || hit;\n  });\n  if (hit && Math.hypot(m.vx, m.vz) > 0.2) w.emit('marbleTap', {});\n  for (const [hx, hz] of def.holes) {\n    if (Math.hypot(hx - m.x, hz - m.z) < CATCH && Math.hypot(m.vx, m.vz) < sink) {\n      m.sunk = true;\n      d.sunk += 1;\n      w.emit('marbleSunk', { n: d.sunk });\n      return;\n    }\n  }\n}\n\n/** Sand Garden. */\nexport const garden: Activity = {\n  id: 'garden',\n  title: 'Sand Garden',\n  station: 'terrace',\n  map: 'actionMap:balanceFree',\n  shot: 'garden',\n  wobble: false,\n  setup(c) {\n    const { x, z } = c.station;\n    const total = TRAYS.reduce((sum, tray) => sum + tray.marbles.length, 0);\n    const cy = c.ground(x, z) + LIFT;\n    const d: GardenData = { tray: 0, tiltX: 0, tiltZ: 0, marbles: [], sunk: 0, total, props: [], trayProp: -1, ridgeProps: [], rakeProps: [], trayT: 0, time: 0, rakes: [], cx: x, cz: z, cy, roll: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    propFor(c, { prop: 'prop:trayStand', at: [x, c.ground(x, z), z], yaw: 0 });\n    d.trayProp = propFor(c, { prop: 'prop:tray', at: [x, cy, z], yaw: 0 });\n    const guest = castOf(c.w, 'guest');\n    if (guest) Object.assign(guest.cast, { hold: true, x, y: c.ground(x, z), z: z + 2.2, yaw: Math.PI, pose: 'Stoop', poseT: 0.6 });\n    setOut(c, d, 0);\n    c.hud.title = 'Sand Garden';\n    c.hud.show = { tray: 0 };\n    enter(c, 'play');\n    say(c, 'plumb', 'garden.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as GardenData;\n    const [{ seat }] = c.seats;\n    const limit = (c.w.settings.get<number>('game.garden.tilt') * Math.PI) / 180;\n    d.time += 1;\n    d.trayT += 1;\n    let [wantX, wantZ] = [seat.lx, seat.ly];\n    if (seat.pointer) [wantX, wantZ] = [seat.px, seat.py];\n    const size = Math.hypot(wantX, wantZ);\n    if (size > 1) [wantX, wantZ] = [wantX / size, wantZ / size];\n    const rate = 5 * c.w.dt;\n    d.tiltX += Math.max(-rate * limit, Math.min(rate * limit, wantX * limit - d.tiltX));\n    d.tiltZ += Math.max(-rate * limit, Math.min(rate * limit, wantZ * limit - d.tiltZ));\n    const def = TRAYS[d.tray];\n    def.rakes.forEach((rake, i) => {\n      d.rakes[i] += c.w.dt * 2;\n      const off = Math.sin(d.rakes[i] * rake.speed) * rake.range;\n      const [rx, rz] = rake.alongX ? [rake.x + off, rake.z] : [rake.x, rake.z + off];\n      moveProp(c.w, d.rakeProps[i], ...onTray(d, rx, rz, 0.05), 0);\n    });\n    let speed = 0;\n    for (const m of d.marbles) {\n      if (!m.sunk) {\n        roll(c, d, def, m);\n        speed = Math.max(speed, Math.hypot(m.vx, m.vz));\n      }\n      moveProp(c.w, m.prop, ...(m.sunk ? ([0, -20, 0] as [number, number, number]) : onTray(d, m.x, m.z, 0.05)), 0);\n    }\n    const q = tiltQuat(d.tiltX, d.tiltZ);\n    moveProp(c.w, d.trayProp, d.cx, d.cy, d.cz, q);\n    const guest = castOf(c.w, 'guest');\n    if (guest) {\n      guest.cast.leanX = (d.tiltX / limit) * 0.6;\n      guest.cast.leanY = (d.tiltZ / limit) * 0.3;\n    }\n    c.hud.show = { tray: d.tray, of: TRAYS.length, sunk: d.sunk, total: d.total, speed, tiltX: d.tiltX / limit, tiltZ: d.tiltZ / limit, seconds: Math.max(0, TOTAL - Math.floor(d.time / c.w.hz)) }; // prettier-ignore\n    c.hud.meter = 1 - d.time / steps(c, TOTAL);\n    c.hud.meterLabel = `Tray ${d.tray + 1} of ${TRAYS.length}`;\n    const allIn = d.marbles.every((m) => m.sunk);\n    if (allIn || d.trayT >= steps(c, TRAY_TIME)) {\n      if (allIn) say(c, 'plumb', 'garden.tray');\n      d.tray += 1;\n      if (d.tray >= TRAYS.length || d.time >= steps(c, TOTAL)) {\n        d.tray = Math.min(d.tray, TRAYS.length - 1);\n        c.a.done = true;\n      } else setOut(c, d, d.tray);\n    }\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as GardenData;\n    const { seat } = e;\n    seat.act = false;\n    if (!player.acts) {\n      seat.lx = seat.ly = 0;\n      return;\n    }\n    const def = TRAYS[d.tray];\n    const free = d.marbles.findIndex((m) => !m.sunk);\n    if (free < 0) return;\n    const m = d.marbles[free];\n    // Aim for the next free hole, through its waypoint while one is left.\n    const taken = new Set(def.holes.map((_h, i) => i).filter((i) => i < d.marbles.filter((k) => k.sunk).length));\n    const hole = def.holes.find((_h, i) => !taken.has(i)) ?? def.holes[0];\n    const mem = seat.mem as { leg?: number; of?: number };\n    if (mem.of !== free * 100 + d.tray) [mem.of, mem.leg] = [free * 100 + d.tray, 0];\n    const via = def.via?.[free] ?? [];\n    let goal: readonly [number, number] = hole;\n    if ((mem.leg ?? 0) < via.length) {\n      goal = via[mem.leg ?? 0];\n      if (Math.hypot(goal[0] - m.x, goal[1] - m.z) < 0.28) mem.leg = (mem.leg ?? 0) + 1;\n    }\n    const delay = player.delay;\n    const hist = (seat.hist as number[]);\n    hist.push(m.x, m.z, m.vx, m.vz);\n    const keep = 4 * (delay + 2);\n    if (hist.length > keep) hist.splice(0, hist.length - keep);\n    const at = Math.max(0, hist.length - 4 - 4 * delay);\n    const [sx, sz, svx, svz] = [hist[at], hist[at + 1], hist[at + 2], hist[at + 3]];\n    const kp = player.name === 'perfect' ? 1.6 : player.name === 'human' ? 1 : 0.8;\n    const kd = player.name === 'perfect' ? 1.1 : 0.9;\n    const jit = player.jitter;\n    const rng = c.w.rng('botJitter', seat.index);\n    seat.lx = kp * (goal[0] - sx) - kd * svx + (jit ? rng.range(-jit, jit) : 0);\n    seat.ly = -(kp * (goal[1] - sz) - kd * svz) + (jit ? rng.range(-jit, jit) : 0);\n  },\n  score(c) {\n    const d = c.a.data as unknown as GardenData;\n    const left = Math.max(0, 1 - d.time / steps(c, TOTAL));\n    return (800 * d.sunk) / d.total + 200 * left * (d.sunk / d.total);\n  },\n};\nEOF\ncat > labs/game/scenes/events/plunge.ts <<'EOF'\n/**\n * @file Cliff Plunge (PLAN.md section 6): three dives from a 14 m cliff. Compose: hold ring and breath for 4 s to fill\n * power. Go: release both feet as a swinging gauge peaks. Air: lean y spins you, lean x twists, scrubbing a rotation\n * strip. Enter the water within 15 degrees of vertical. Three Gulls hold up score cards, 0 to 10; one always scores 4.\n * Wait too long at the lip and you slip off anyway: a small splash, low cards.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'plunge');\n */\nimport { breathe, holdAt, type Player } from '../bot/players';\nimport { SEA_Y } from '../data/stations';\nimport { bothFeet, inRing } from '../wobble';\nimport { after, castOf, enter, entityFor, propFor, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** Seconds: how long composing may wait, the gauge's swing, the cards. */\nconst WAIT = 12;\nconst SWING = 1.4;\nconst GO_BOX = 5;\nconst CARDS_FOR = 3.2;\nconst RING = 0.28;\n/** Gravity on a diver, m/s2. */\nconst FALL = 9.5;\n/** Fifteen degrees, the clean entry. */\nconst CLEAN = (15 * Math.PI) / 180;\n/** How many dives. */\nconst DIVES = 3;\n\n/** The dives' state. */\ninterface PlungeData {\n  dive: number;\n  power: number;\n  gauge: number;\n  q: number;\n  y: number;\n  vy: number;\n  z: number;\n  x: number;\n  angle: number;\n  twist: number;\n  lipY: number;\n  lipZ: number;\n  cards: number[][];\n  sum: number;\n  slip: boolean;\n  gulls: number[];\n  entry: number;\n  airT: number;\n}\n\n/** The three judges' cards for a dive. */\nfunction cardsOf(c: Ctx, d: PlungeData): number[] {\n  if (d.slip) return [1, 2, 4];\n  const full = Math.PI + 2 * Math.PI * Math.max(0, Math.round((d.angle - Math.PI) / (2 * Math.PI)));\n  const err = Math.abs(d.angle - full);\n  d.entry = err;\n  const entry = err <= CLEAN ? 1 : Math.max(0, 1 - (err - CLEAN) / 1.05);\n  const flips = Math.floor((Math.abs(d.angle) + CLEAN) / (2 * Math.PI)) + (Math.abs(d.angle) > 2.5 ? 0.5 : 0);\n  const twists = Math.abs(d.twist) > 5 ? 1 : 0;\n  const base = 1 + 5 * entry + 2 * d.q + (flips >= 1 ? 1 : 0) + twists;\n  const j1 = Math.max(0, Math.min(10, Math.round(base)));\n  const j2 = Math.max(0, Math.min(10, Math.round(base + c.w.rng('judges').range(-0.6, 0.4))));\n  return [j1, j2, 4];\n}\n\n/** Sets up the next dive at the lip. */\nfunction toLip(c: Ctx, d: PlungeData): void {\n  const guest = castOf(c.w, 'guest');\n  const e = c.seats[0].wobble;\n  Object.assign(e, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, sync: 0, calm: 0, lungs: 0, recover: 0 });\n  Object.assign(d, { power: 0, gauge: 0, q: 0, y: d.lipY, vy: 0, z: d.lipZ, x: c.station.x, angle: 0, twist: 0, slip: false, airT: 0 });\n  if (guest) Object.assign(guest.cast, { hold: true, x: d.x, y: d.lipY, z: d.z, yaw: Math.PI, pose: 'DiveReady', poseT: 0, leanX: 0, leanY: 0 });\n  c.hud.title = `Dive ${d.dive + 1} of ${DIVES}`;\n  enter(c, 'compose');\n  say(c, 'plumb', 'plunge.compose');\n}\n\n/** Cliff Plunge. */\nexport const plunge: Activity = {\n  id: 'plunge',\n  title: 'Cliff Plunge',\n  station: 'cliff',\n  map: 'actionMap:balance',\n  shot: 'plunge',\n  wobble: true,\n  setup(c) {\n    const { x, z } = c.station;\n    const lipY = c.ground(x, z) + 0.2;\n    const lipZ = z - 3.6;\n    const d: PlungeData = { dive: 0, power: 0, gauge: 0, q: 0, y: lipY, vy: 0, z: lipZ, x, angle: 0, twist: 0, lipY, lipZ, cards: [], sum: 0, slip: false, gulls: [], entry: 0, airT: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    propFor(c, { prop: 'prop:diveLip', at: [x, lipY - 0.14, z - 6], yaw: Math.PI });\n    for (let g = 0; g < 3; g++) {\n      const [gx, gz] = [x - 8 + g * 2.2, z - 26];\n      d.gulls.push(entityFor(c, { critter: { kind: 'gull', goalX: gx, goalY: SEA_Y + 1.2, goalZ: gz, look: 0, speed: 3, away: false, tick: 0 }, crowdBody: { rig: 'blob', look: 'wings', size: 0.22, x: gx, y: SEA_Y + 1.2, z: gz, yaw: 0, state: {} } as never }));\n      propFor(c, { prop: 'prop:scoreCard', at: [gx, SEA_Y + 2.1, gz], yaw: 0 });\n    }\n    c.hud.disc = true;\n    c.hud.feet = true;\n    c.hud.guide = true;\n    toLip(c, d);\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as PlungeData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const guest = castOf(c.w, 'guest');\n    const cast = guest?.cast;\n    if (c.a.phase === 'compose') {\n      c.hud.disc = true;\n      c.hud.ring = [0, 0, RING];\n      if (inRing(wob, 0, 0, RING) && bothFeet(seat)) d.power = Math.min(1, d.power + c.w.dt / 4);\n      c.hud.meter = d.power;\n      c.hud.meterLabel = 'Compose';\n      c.hud.show = { power: d.power };\n      if (cast) {\n        cast.leanX = wob.x * 1.2;\n        cast.leanY = wob.y * 1.2;\n        cast.poseT = d.power;\n      }\n      if (d.power >= 1) {\n        say(c, 'plumb', 'plunge.go');\n        enter(c, 'go');\n      } else if (after(c, WAIT)) {\n        d.slip = true;\n        say(c, 'tare', 'plunge.slip');\n        c.w.emit('slip', {});\n        d.q = 0;\n        d.vy = 0;\n        enter(c, 'air');\n      }\n      return;\n    }\n    if (c.a.phase === 'go') {\n      const t = (c.a.pt / c.w.hz / SWING) * Math.PI;\n      d.gauge = Math.abs(Math.sin(t));\n      c.hud.show = { gauge: d.gauge, power: 1 };\n      c.hud.meter = d.gauge;\n      c.hud.meterLabel = 'Let go at the top';\n      if (!bothFeet(seat)) {\n        d.q = d.gauge;\n        d.vy = 1.5 + d.q * 3;\n        c.w.emit('launch', { q: d.q });\n        enter(c, 'air');\n      } else if (after(c, GO_BOX)) {\n        d.slip = true;\n        d.q = 0;\n        d.vy = 0;\n        say(c, 'tare', 'plunge.slip');\n        c.w.emit('slip', {});\n        enter(c, 'air');\n      }\n      return;\n    }\n    if (c.a.phase === 'air') {\n      c.hud.disc = false;\n      wob.on = false;\n      d.vy -= FALL * c.w.dt;\n      d.y += d.vy * c.w.dt;\n      d.z -= (d.slip ? 2.2 : 3.2 + d.q * 2.2) * c.w.dt;\n      if (!d.slip) {\n        const spin = c.w.settings.get<number>('game.dive.spin');\n        d.angle += seat.ly * spin * c.w.dt;\n        d.twist += seat.lx * spin * c.w.dt;\n      } else d.angle += 2.6 * c.w.dt;\n      d.airT += 1;\n      if (cast) {\n        cast.z = d.z;\n        cast.y = d.y;\n        cast.yaw = Math.PI + d.twist;\n        cast.pose = 'Somersault';\n        cast.poseT = Math.max(0, Math.min(1, d.angle / (4 * Math.PI)));\n        cast.leanX = cast.leanY = 0;\n      }\n      c.hud.show = { angle: d.angle, twist: d.twist, air: true };\n      if (d.y <= SEA_Y - 0.4) {\n        const cards = cardsOf(c, d);\n        d.cards.push(cards);\n        d.sum += cards[0] + cards[1] + cards[2];\n        c.w.emit('splash', { big: !d.slip, x: d.x, z: d.z, y: SEA_Y });\n        c.w.emit('cards', { cards, dive: d.dive, entry: d.entry });\n        say(c, 'tare', d.slip ? 'plunge.slipped' : cards[0] >= 8 ? 'plunge.great' : 'plunge.dive');\n        if (cast) Object.assign(cast, { y: SEA_Y - 0.9, pose: 'Splashed', poseT: 1 });\n        enter(c, 'cards');\n      }\n      return;\n    }\n    // Cards.\n    c.hud.show = { cards: d.cards[d.cards.length - 1], dive: d.dive, slip: d.slip };\n    if (after(c, CARDS_FOR)) {\n      d.dive += 1;\n      wob.on = true;\n      if (d.dive >= DIVES) c.a.done = true;\n      else toLip(c, d);\n    }\n    void steps;\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as PlungeData;\n    const { seat, wobble } = e;\n    seat.act = false;\n    if (c.a.phase === 'compose') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      seat.fl = seat.fr = player.acts ? 1 : 0;\n      breathe;\n    } else if (c.a.phase === 'go') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      seat.fl = seat.fr = player.acts ? 1 : 0;\n      const period = SWING * c.w.hz;\n      const atPeak = Math.abs((c.a.pt % period) - period / 2) < 1 + player.timing;\n      if (player.acts && atPeak && c.a.pt > 10) seat.fl = seat.fr = 0;\n    } else if (c.a.phase === 'air') {\n      seat.fl = seat.fr = 0;\n      if (!player.acts) {\n        seat.lx = seat.ly = 0;\n        return;\n      }\n      // Solve the rest of the fall, and turn so as to arrive head down.\n      const left = (d.vy + Math.sqrt(Math.max(0, d.vy * d.vy + 2 * FALL * (d.y - SEA_Y + 0.4)))) / FALL;\n      const target = 3 * Math.PI;\n      const spin = c.w.settings.get<number>('game.dive.spin');\n      const lag = player.delay / c.w.hz;\n      const want = (target - d.angle) / Math.max(0.1, left + lag * 0.2);\n      seat.ly = Math.max(-1, Math.min(1, want / spin));\n      seat.lx = player.name === 'sloppy' ? 0 : Math.max(-1, Math.min(1, ((6 - d.twist) / Math.max(0.2, left)) / spin));\n    } else {\n      seat.lx = seat.ly = seat.fl = seat.fr = 0;\n    }\n  },\n  score(c) {\n    const d = c.a.data as unknown as PlungeData;\n    return (d.sum / (24 * DIVES)) * 1000;\n  },\n};\nEOF\ncat > labs/game/scenes/events/hoop.ts <<'EOF'\n/**\n * @file Hoop Patrol (PLAN.md section 6): hoops fly in from Tare. Spin your stick in circles: angular speed in the band keeps\n * every hoop up; outside it they sink and fall. A new hoop every 8 s from a telegraphed side: lean that way within 0.6 s\n * to catch it. Up to eight at once. Alternate feet at 2.5 Hz counts as spinning too; a mouse circles. Every seat plays.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'hoop');\n */\nimport type { Player } from '../bot/players';\nimport { MAT_OFFSETS } from '../data/stations';\nimport { enter, floorShape, say, standSeats, steps } from './kit';\nimport type { Activity, Ctx, SeatEntity } from './types';\n\n/** Seconds: the whole class, a new hoop, the warning, the catch. */\nconst LENGTH = 60;\nconst EVERY = 8;\nconst WARN = 1.2;\nconst WINDOW = 0.6;\nconst MAX_HOOPS = 8;\n/** Hoop·seconds a very good class earns: 1000. */\nconst FULL = 250;\nconst FULL_SHORT = 150;\n\n/** One seat's numbers. */\ninterface HoopSeat {\n  angle: number;\n  was: number[];\n  spin: number;\n  footT: number;\n  lastFoot: string;\n  hoops: number[];\n  sum: number;\n  shape: number[];\n  caught: number;\n  inBand: boolean;\n  mouseAngle: number;\n}\n\n/** The class's state. */\ninterface HoopData {\n  seats: HoopSeat[];\n  next: number;\n  side: number;\n  phase: 'wait' | 'warn' | 'catch';\n  phaseT: number;\n  lead: number;\n  waist: number[];\n  length: number;\n}\n\n/** One seat's step. */\nfunction stepSeat(c: Ctx, d: HoopData, e: SeatEntity): void {\n  const s = d.seats[e.seat.index];\n  const { w } = c;\n  const { seat } = e;\n  // The stick's angle round the centre.\n  const size = Math.hypot(seat.lx, seat.ly);\n  let rate = 0;\n  if (size > 0.4) {\n    const angle = Math.atan2(seat.ly, seat.lx);\n    if (s.was.length) {\n      const prior = s.was[0];\n      const change = Math.atan2(Math.sin(angle - prior), Math.cos(angle - prior));\n      rate = Math.abs(change) * w.hz;\n    }\n    s.was = [angle];\n    s.angle = angle;\n  } else s.was = [];\n  // The mouse: its heading turning is a circle.\n  if (seat.moved > 0.002) {\n    const heading = Math.atan2(seat.my, seat.mx);\n    const change = Math.atan2(Math.sin(heading - s.mouseAngle), Math.cos(heading - s.mouseAngle));\n    rate = Math.max(rate, Math.abs(change) * w.hz);\n    s.mouseAngle = heading;\n    s.angle = heading;\n  }\n  // Alternating feet at 2.5 Hz or more counts as spinning.\n  s.footT += 1;\n  const foot = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n  let feet = 0;\n  if (foot && foot !== s.lastFoot) {\n    if (s.footT <= w.hz / 2.5 + 2) feet = 7;\n    s.footT = 0;\n    s.lastFoot = foot;\n  }\n  if (feet > 0) rate = Math.max(rate, feet);\n  if (s.footT < w.hz / 2.5 + 2 && s.lastFoot) rate = Math.max(rate, 7);\n  s.spin += (rate - s.spin) * (1 - Math.exp(-w.dt / 0.22));\n  const lo = w.settings.get<number>('game.hoop.bandMin');\n  const hi = w.settings.get<number>('game.hoop.bandMax');\n  s.inBand = s.spin >= lo && s.spin <= hi;\n  // Hoops rise toward the waist in the band, and sink out of it.\n  const speed = s.inBand ? 0.6 : -0.55;\n  s.hoops = s.hoops.map((h) => Math.min(1, h + speed * w.dt));\n  const before = s.hoops.length;\n  s.hoops = s.hoops.filter((h) => h > 0);\n  if (s.hoops.length < before) w.emit('hoopDrop', { seat: seat.index, left: s.hoops.length });\n  s.sum += s.hoops.length * w.dt;\n  const cast = w.get(seat.actor)?.cast;\n  const y = d.waist[seat.index];\n  s.shape.forEach((id, i) => {\n    const ring = w.get(id)?.matRing;\n    if (!ring || !cast) return;\n    const shown = i < s.hoops.length;\n    ring.telegraph = shown ? (i % 2 ? 'telegraph:hoop2' : 'telegraph:hoop') : '';\n    const h = s.hoops[i] ?? 0;\n    const wig = 0.05 * Math.sin(s.angle + i * 1.6);\n    ring.position = [cast.x + wig, y - 0.55 + h * 0.55 + i * 0.07, cast.z + 0.05 * Math.cos(s.angle + i * 1.6)];\n  });\n  if (cast) {\n    cast.pose = 'HipCircle';\n    cast.poseT = (s.angle + Math.PI) / (2 * Math.PI);\n    cast.leanX = cast.leanY = 0;\n  }\n}\n\n/** Hoop Patrol. */\nexport const hoop: Activity = {\n  id: 'hoop',\n  title: 'Hoop Patrol',\n  station: 'hoopBeach',\n  map: 'actionMap:balance',\n  shot: 'hoop',\n  wobble: false,\n  setup(c) {\n    const lead = steps(c, c.a.short ? 6 : 2);\n    const d: HoopData = {\n      seats: [0, 1, 2, 3].map(() => ({ angle: 0, was: [], spin: 0, footT: 999, lastFoot: '', hoops: [0.6], sum: 0, shape: [], caught: 0, inBand: false, mouseAngle: 0 })),\n      next: lead + steps(c, 3),\n      side: 1,\n      phase: 'wait',\n      phaseT: 0,\n      lead,\n      waist: [0, 0, 0, 0],\n      length: steps(c, c.a.short ? 45 : LENGTH) + lead,\n    };\n    c.a.data = d as unknown as Record<string, unknown>;\n    if (c.round) standSeats(c, MAT_OFFSETS, Math.PI);\n    else {\n      const guest = c.w.get(c.seats[0].seat.actor)?.cast;\n      const [x, z] = [c.station.x, c.station.z];\n      if (guest) Object.assign(guest, { hold: true, x, y: c.ground(x, z), z, yaw: Math.PI });\n      const tare = c.w.query('cast').find((k) => k.cast.who === 'tare');\n      if (tare) Object.assign(tare.cast, { hold: true, x: x + 3, y: c.ground(x + 3, z - 3), z: z - 3, yaw: -0.8 });\n    }\n    for (const e of c.seats) {\n      const s = d.seats[e.seat.index];\n      const cast = c.w.get(e.seat.actor)?.cast;\n      const y = cast ? cast.y + 0.86 : 8.9;\n      d.waist[e.seat.index] = y;\n      for (let i = 0; i < MAX_HOOPS; i++) s.shape.push(floorShape(c, '', cast?.x ?? 0, y, cast?.z ?? 0));\n    }\n    c.hud.title = 'Hoop Patrol';\n    c.hud.disc = false;\n    enter(c, 'play');\n    say(c, 'tare', 'hoop.start');\n  },\n  step(c) {\n    const d = c.a.data as unknown as HoopData;\n    const now = c.a.t;\n    for (const e of c.seats) stepSeat(c, d, e);\n    // New hoops.\n    d.phaseT += 1;\n    if (d.phase === 'wait' && now >= d.next) {\n      d.phase = 'warn';\n      d.phaseT = 0;\n      d.side = c.w.rng('hoops').chance(0.5) ? 1 : -1;\n      c.w.emit('hoopWarn', { side: d.side });\n    } else if (d.phase === 'warn' && d.phaseT >= steps(c, WARN)) {\n      d.phase = 'catch';\n      d.phaseT = 0;\n      c.w.emit('hoopFly', { side: d.side });\n    } else if (d.phase === 'catch') {\n      for (const e of c.seats) {\n        const s = d.seats[e.seat.index];\n        if (s.caught === d.next) continue;\n        if (e.seat.lx * d.side > 0.5 || e.seat.mx * d.side > 0.01) {\n          s.caught = d.next;\n          if (s.hoops.length < MAX_HOOPS) s.hoops.push(0.4);\n          c.w.emit('hoopCatch', { seat: e.seat.index, hoops: s.hoops.length });\n        }\n      }\n      if (d.phaseT >= steps(c, WINDOW)) {\n        d.phase = 'wait';\n        d.next = now + steps(c, EVERY - WARN - WINDOW);\n      }\n    }\n    const me = d.seats[c.seats[0].seat.index];\n    const lo = c.w.settings.get<number>('game.hoop.bandMin');\n    const hi = c.w.settings.get<number>('game.hoop.bandMax');\n    c.hud.show = { spin: me.spin, lo, hi, hoops: me.hoops.length, phase: d.phase, side: d.side, angle: me.angle, inBand: me.inBand };\n    c.hud.meter = 1 - now / d.length;\n    if (now >= d.length) c.a.done = true;\n  },\n  bot(c, e, player: Player) {\n    const { seat } = e;\n    seat.act = false;\n    seat.fl = seat.fr = 0;\n    if (!player.acts) {\n      seat.lx = seat.ly = 0;\n      return;\n    }\n    const mem = seat.mem as { angle?: number };\n    const wobbly = player.name === 'perfect' ? 0 : player.name === 'human' ? 0.8 : 3.2;\n    const rate = 7 + wobbly * Math.sin(c.a.t * 0.021 + seat.index);\n    mem.angle = (mem.angle ?? 0) + rate * c.w.dt;\n    const jitter = player.jitter;\n    const rng = c.w.rng('botJitter', seat.index);\n    seat.lx = Math.cos(mem.angle) + (jitter ? rng.range(-jitter, jitter) : 0);\n    seat.ly = Math.sin(mem.angle) + (jitter ? rng.range(-jitter, jitter) : 0);\n  },\n  score(c, index) {\n    const d = c.a.data as unknown as HoopData;\n    return (1000 * d.seats[index].sum) / (c.a.short ? FULL_SHORT : FULL);\n  },\n};\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\ns=open(p).read()\ns=s.replace(\"import { group, setGroupTable } from './group';\",\"import { garden } from './garden';\\nimport { group, setGroupTable } from './group';\\nimport { hoop } from './hoop';\\nimport { paddle } from './paddle';\\nimport { plunge } from './plunge';\")\ns=s.replace(\"  reps,\\n  step,\\n  line,\",\"  reps,\\n  step,\\n  line,\\n  paddle,\\n  garden,\\n  plunge,\\n  hoop,\")\nopen(p,'w').write(s)\nEOF\nTEETER_SEEDS=2 TEETER_SHOW=1 TEETER_ONLY=paddle,garden,plunge,hoop npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -E \"^(paddle|garden|plunge|hoop)|^  [phsi]:|AssertionError|Error:|❯ labs|Tests \" | head -30 | cut -c1-220","description":"Write Paddle, Garden, Plunge and Hoop, then test balance","timeout":400000}}}
