{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012YL6juZmWppuFFL9suafLk","type":"tool_result","content":"engine/sim/actors.ts:261:export function placeActor<C extends object>(\nexport function placeActor<C extends object>(\n  world: World<C>,\n  id: number,\n  at: Vec3Like,\n  yaw?: number,\n  options: { crouch?: boolean } = {},\n): void {\n  const w = world as unknown as World;\n  const e = w.get(id) as Partial<ActorComponents> | undefined;\n  if (!e?.actor) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(w, id)', value: String(id), expected: 'an actor’s id' }); // prettier-ignore\n  const { actor, motion } = e;\n  if (options.crouch && !motion) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(options.crouch)', value: `true for actor ${id}, on no moveme\n  const physics = physicsOf(w);\n  const { offset, capsule } = actor.character;\n  const centre = bodyAt(actor.character, at, 'placeActor(at)'); // the standing hull's, its feet just over `at`\n  const middle = motion && options.crouch ? hullFor(actor.character, { ...motion, stance: 'crouch' }) : capsule.height; // prettier-ignore\n  const up = { maxDistance: middle + capsule.radius, exclude: actor.body, groups: 'world' } as const;\n  const ceiling = physics.raycast([centre[0], centre[1] - capsule.height / 2, centre[2]], [0, 1, 0], up); // up its axis\n  if (ceiling && !oneWayOf(w).has(ceiling.body)) {\n    const given = vec(at, 'placeActor(at)');\n    const place = [given.x, given.y, given.z].map((v) => Math.round(v * 100) / 100).join(', ');\n    const [over, tall] = [(offset + capsule.radius + ceiling.distance).toFixed(2), (middle + 2 * capsule.radius).toFixed(2)]; // prettier-ignore\n    throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(at)', value: `[${place}], where a ceiling ${over} m over its feet cuts its ${options.crou\n  }\n  matchHull(physics, actor.body, actor.character, capsule.height, { air: false, tuck: false });\n  physics.setBody(actor.body, { position: centre, velocity: [0, 0, 0] });\n  const { x, y, z } = feetOf(physics, actor.body, actor.character);\n  Object.assign(actor, createCharacterState(), { yaw: yaw ?? actor.yaw, x, y, z });\n  if (motion) Object.assign(motion, createMotionState(), { holstered: motion.holstered }, options.crouch ? { stance: 'crouch', duck: 'ducked' } : {});\n}\n14: * nothing when anything is wrong. Values are plain data, stored frozen all the way down, defaults included (each a\n18: * `when` says when a change takes effect; `set` reports it.\n28: * settings.set('crowd', 400).when; // 'now'\n74:/** What `set` reports: the new and previous values, and when the change takes effect. */\n79:  when: When;\n93:  when: When;\n104:  /** Validates and sets a value; returns what changed and when it takes effect. */\n108:  /** Back to the default: one setting, or every setting (overrides included) when no path is given. */\n154:  when: {\n158:    description: 'When a change takes effect: at once, for what spawns next, or when the scene next starts.',\n164:      'True when it changes only how the game looks or performs: kept out of the hash, captures and replays.',\n196:/** Text from a URL or the command line as a value of `field`'s type; undefined when it cannot be. */\nexport function removeActor<C extends object>(world: World<C>, id: number): void {\n  const w = world as unknown as World;\n  const actor = (w.get(id) as Partial<ActorComponents> | undefined)?.actor;\n  if (!actor)\n    throw codeError('SIM_BAD_ARGUMENT', { where: 'removeActor(w, id)', value: String(id), expected: 'an actor’s id' });\n  const physics = physicsOf(w);\n  physics.removeBody(actor.body);\n  const parts = (w.get(id) as { ragdoll?: { bodies: number[] } }).ragdoll?.bodies ?? []; // its ragdoll's, if it lies so\n  for (const body of parts) if (physics.hasBody(body)) physics.removeBody(body);\n  w.despawn(id);\n}\nexport interface ActorComponent extends CharacterState {\n  body: number;\n  player: boolean;\n  character: Character;\n  intents: Partial<Intents>;\n  held: string[];\n  x: number;\n  y: number;\n  z: number;\n}\n/**\n * @file What an actor reads of a step's intents (PLAN.md WP 3.2, WP 13.3, WP 13.9; split from engine/sim/actors.ts at\n * its cap, WP 13.16): `intentsOf(actor, intents)` is the step's intents for a player, else its AI's (`actor.intents`,\n * its presses from the edges of the buttons it held, `actor.held`); `motionInput(actor, wants, controls)` is what an\n * actor on a movement model (engine/physics/movement/) takes of them: the sprint, walk and crouch buttons as a player's\n * controls (`input.sprint`, `input.crouch`) say, the use press (unless a use took it, `used`: engine/sim/interact.ts),\n * the view, the keys' frame and what it faces (the aim's point, else the view), whether a melee swings (no mantle\n * then: engine/sim/melee.ts) and whether he aims down a weapon's sights (a walk then: engine/sim/weapons.ts).\n *\n * Invariants: pure but for an AI actor's own button edges, which `intentsOf` keeps in its component.\n *\n * @example\n * // const wants = intentsOf(actor, intents); // a player's: the step's own\n * // const input = motionInput(actor, wants, { holdSprint: false, toggleCrouch: false });\n * @see engine/sim/actors.test.ts\n */\nimport { held, normalizeIntents, pressed, type Intents } from '../input/intents';\nimport type { CharacterInput } from '../physics/character';\nimport type { ActorComponent } from './actors';\n\n/** The intents an actor acts on this step: the step's for a player, else its AI's (with presses from `b`'s edges). */\nexport function intentsOf(actor: ActorComponent, intents: Intents): Intents {\n  if (actor.player) return intents;\n  const own = normalizeIntents(actor.intents, normalizeIntents({ b: actor.held }));\n  const { p: _pressed, ...rest } = actor.intents;\n  [actor.held, actor.intents] = [[...(own.b ?? [])], rest];\n  return own;\n}\n\n/** A player's controls (the settings `input.sprint` and `input.crouch`): a held sprint, a toggled crouch. */\n10: * - `defineClipSet(set)` parses the set (validate.ts `parseClipSet`: a broken clip is refused with its `ANIM_CLIP_*`\n11- *   code) and registers it as `clipset:<set, lower case>`; the same set again returns the entry already there.\n12- *   `clipSetFromFiles(files)` joins a set directory's files into one set first (a page's import of the files);\n13- *   `getClipSet(id)` is one, `clipSetIds()` lists them; `defineSetBuild(id, setId)` registers the build a set's clips\n14- *   were captured on (`build:mannequin`).\n15- * - `ClipLayerPool.library(id)` loads a set for playing (library.ts `loadClipLibrary`) once per pool: the sim keeps a\n16- *   pool per world and the view its own, so a bake made while the sim steps (under its fdlibm maths) is never one the\n17- *   view made, and the reverse.\n18- * - `CLIPS_FIELDS` are the fields of an actor's component `clips` (engine/sim/actors.ts): the sets it plays from, its\n19- *   contact IK and blade, and the layer's state (`ClipLayerState`), which the sim's step changes and the hash covers.\n20- * - `legsHeld(layer)`: how much of the legs a layer's clips hold now, which the view's foot plant leaves them (WP 13.10).\n21- *\n22- * Invariants: an entry is the parsed set, frozen; clip names are the set's own, played as `SET/Clip` (or bare: the\n23- * first set's with that name, layer.ts). A pool's layer is made again only when its make (build, sets, IK, blade,\n24- * step) changes, and is loaded from the data at every `get`, so it keeps nothing of its own between calls.\n25- *\n26- * @example\n--\n31: * defineClipSet(set, { registry }).id; // 'clipset:test'\n32- * const pool = new ClipLayerPool(registry);\n33- * const data = { sets: ['clipset:test'], ik: true, blade: 0, state: emptyClipState() };\n34- * pool.get(1, data, 'build:heroic').play('Stand').save().slots[0].clip; // 'TEST/Stand'\n35- * @see engine/anim/clip/clipsets.test.ts\n36- */\n37-import { registry as sharedRegistry, sameValue, type Registry } from '../../core/registry';\n38-import { defineSchema } from '../../core/schema';\n39-import { codeError } from '../../core/log';\n40-import { MathUtils } from '../../core/math';\n41-import { buildKind, defineBuild, getBuild, type Build } from '../builds';\n42-import { boneMask, jointIndex } from '../skeleton';\n43-import { ClipLayer, type ClipLayerState } from './layer';\n44-import { loadClipLibrary, type ClipLibrary } from './library';\n45-import { restBuild } from './rest';\n46-import type { Clip } from './readable';\n47-import { parseClip, parseClipSet, type ClipSet } from './validate';\n--\n89:      'A set of readable clips loaded for playing (PLAN.md §10): its header and its clips. The library is data/anim/sets/, one directory a set, whi\n90-    fields: CLIPSET_FIELDS,\n91-    defineWith:\n92:      \"defineClipSet({ set: 'NAME', sources: { … }, clips: { … } }) with a set's _set.json and its clip files\",\n93-  });\n94-}\n95-clipSetKind(sharedRegistry);\n96-\n97-/** The id a set registers under: `clipset:` and its name in lower case (`clipset:style100_back`). */\n98-export function clipSetId(name: string): string {\n99-  return `clipset:${name.toLowerCase()}`;\n100-}\n101-\n102-/**\n/**\n * @file Reactions and secondary motion on a scene's bodies (PLAN.md WP 6.2, WP 7.8, ADR-0018 amendment 1): the two\n * components that put engine/anim's reactions and secondary motion on an entity.\n *\n * - **`reactions`** (`REACTION_FIELDS`): a body's reactions (engine/anim/reactions.ts `Reactions`: the flinch spring,\n *   the knockdown, the death and the get-up chosen by how it lies) as the plain data `Reactions.save()` writes, so\n *   the hash, captures and replays hold them. `reactTo(w, id, act)` runs `act` on an entity's reactions, adding the\n *   component at rest the first time, and saves them back. `stepReactions(state, dt)` steps them one tick and returns\n *   what the phase playing tells the body (`down`, `pose`), to lay over its body states. The system `actors.anim`\n *   steps an actor's (engine/sim/actors.ts); game code steps any other body's in its own rig system (a crowd body's\n *   states, engine/sim/crowdBodies.ts). The view draws an actor's flinch and how it lies (engine/gfx/puppets/actors.ts).\n * - **`secondary`** (`SECONDARY_FIELDS`): the secondary motion the view hangs on an actor's puppet (engine/anim/\n *   secondary.ts `Secondary`: hair, a cape, a tail) and its colour. The sim only carries it, as it carries a build or\n *   a stand-in's material: the view steps the chains, so none of their motion reaches the hash.\n *\n * Invariants: everything a reaction remembers is in its component (the `Reactions` here are scratch, loaded at every\n * call), so a capture restores it exactly; a body at rest (no flinch, nothing playing) steps for nothing.\n *\n * @example\n * import { Vector3 } from '../core/math';\n * import { createWorld } from './world';\n * const w = createWorld({ seed: 1 });\n * const id = w.spawn({});\n * reactTo(w, id, (r) => r.knockDown(new Vector3(0, 0, -1), 0)); // struck from the front: it falls onto its back\n * stepReactions(w.get(id).reactions, w.dt); // { down: 1 }: what the body is told while it falls\nexport const SECONDARY_FIELDS = defineSchema({\n  hair: {\n    type: 'string',\n    enum: ['', 'long', 'ponytail'],\n    default: '',\n    description: 'Hair from the back of the head (engine/anim/secondary.ts HAIR: long or ponytail), or empty for none.',\n  },\n  cape: { type: 'boolean', default: false, description: 'A cape from the backs of the shoulders.' },\n  tail: { type: 'boolean', default: false, description: 'A tail from the back of the pelvis.' },\n  color: { type: 'string', default: '#7a2430', description: 'Their colour, a CSS hex colour.' },\n});\n121:export function reactTo<C extends object, E extends EventMap>(\n122-  world: World<C, E>,\n123-  id: number,\n124-  act: (reactions: Reactions) => unknown,\n125-): ReactionState {\n126-  const w = world as unknown a