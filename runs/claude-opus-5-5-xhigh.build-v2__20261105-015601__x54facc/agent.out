{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjWUEbwDDsqL9JewjbWg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PNPGYc2TfPysyMDa3yzSZM","name":"Bash","input":{"command":"mkdir -p labs/game/scenes/events labs/game/scenes/bot labs/game/scenes/data labs/game/cast/clipdata labs/game/props labs/game/geometry labs/game/materials labs/game/textures labs/game/bodies labs/game/builds labs/game/emitters labs/game/looks labs/game/cameras labs/game/sounds labs/game/ui/screens labs/game/ui/hud labs/game/ui/lines labs/game/ui/dev labs/game/audio labs/game/tools labs/game/replays\ncat > labs/game/scenes/settings.ts <<'EOF'\n/**\n * @file Teeter Fit's tunable numbers: every `game.*` setting the dev panel exposes as a live slider, plus the switches\n * the director and tests use. All are sim settings read every step (`when: 'now'`), so a change plays at once and\n * replays hold it. `SLIDER_GROUPS` names which settings the dev panel shows, in which group.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * // w.settings.get<number>('game.wobble.gain'); // 14\n * @see labs/game/scenes/wobble.test.ts\n */\nimport { defineSettings } from '../../../engine/sim-api';\n\n/** A number setting, live. */\nconst num = (value: number, minimum: number, maximum: number, unit: string, description: string) =>\n  ({ type: 'number', default: value, minimum, maximum, unit, when: 'now', description }) as const;\n\n/** The settings (see the file comment). */\nexport const GAME_SETTINGS = defineSettings({\n  'game.wobble.gain': num(14, 4, 30, '1/s2', 'How fast your weight follows your thumb.'),\n  'game.wobble.instability': num(3, 0, 10, '1/s2', 'How hard you fall away from the centre.'),\n  'game.wobble.damping': num(5, 1, 12, '1/s', 'How heavy the body feels.'),\n  'game.wobble.noise': num(3.5, 0, 8, '1/s2', 'Sway strength.'),\n  'game.wobble.noiseRate': num(0.15, 0.05, 0.4, 'Hz', 'Sway speed: a slow push you lean against.'),\n  'game.wobble.reach': num(0.9, 0.5, 1, '', \"Full stick's target; a held full stick topples, on purpose.\"),\n  'game.breath.period': num(8, 4, 14, 's', 'One breath, half in, half out.'),\n  'game.breath.calmEffect': num(0.5, 0, 1, '', 'How much full calm quiets the sway.'),\n  'game.age.k': num(1.3, 0.5, 3, '', 'The Wobble Age curve.'),\n  'game.pebbles.mult': num(1, 0, 5, '', 'Pebbles earned, multiplied.'),\n  'game.pose.hold': num(12, 4, 30, 's', 'How long a pose is held.'),\n  'game.pose.ring': num(0.2, 0.08, 0.4, '', 'The seat ring of a pose.'),\n  'game.reps.tempo': num(3, 1.5, 6, 's', 'Seconds for one rep.'),\n  'game.step.bpm': num(1, 0.5, 1.5, 'x', 'Scales the tempo of every Step Class phrase.'),\n  'game.step.perfect': num(3, 1, 8, 'steps', 'The Perfect window, either side.'),\n  'game.step.good': num(7, 3, 16, 'steps', 'The Good window, either side.'),\n  'game.pond.penalty': num(80, 10, 200, '', 'Composure lost each time you move.'),\n  'game.line.stepKick': num(0.35, 0, 1, '', 'How hard each step kicks you sideways.'),\n  'game.line.gust': num(1.2, 0, 3, '', 'How hard the gusts push.'),\n  'game.paddle.speed': num(6, 2, 12, 'm/s', 'Board speed at full forward lean.'),\n  'game.garden.tilt': num(12, 4, 24, 'deg', 'The most the tray tilts.'),\n  'game.garden.gravity': num(9, 2, 20, 'm/s2', 'How hard marbles roll downhill.'),\n  'game.garden.sink': num(1.6, 0.4, 4, 'm/s', 'Below this speed a hole catches a marble.'),\n  'game.dive.spin': num(9, 3, 16, 'rad/s', 'Full lean, spin speed in the air.'),\n  'game.hoop.bandMin': num(5, 2, 8, 'rad/s', 'Slowest spin that keeps hoops up.'),\n  'game.hoop.bandMax': num(9, 6, 18, 'rad/s', 'Fastest spin that keeps hoops up.'),\n  'game.jog.speed': num(4.6, 2, 9, 'm/s', 'Island Jog speed.'),\n  'game.tilt.rate': num(0.03, 0, 0.2, 'deg/s', 'How fast the Great Tilt grows.'),\n  'game.auto': { type: 'boolean', default: false, when: 'now', description: 'The bot plays seat 0.' },\n  'game.skill': {\n    type: 'string',\n    enum: ['perfect', 'human', 'sloppy', 'idle', 'mash'],\n    default: 'perfect',\n    when: 'now',\n    description: 'Which of the test players the bot is.',\n  },\n  'game.noTopple': { type: 'boolean', default: false, when: 'now', description: 'Nobody topples.' },\n  'game.assist': { type: 'boolean', default: false, when: 'now', description: 'Steadier Hands: halves the sway.' },\n  'game.expert': { type: 'boolean', default: false, when: 'now', description: 'Expert: a smaller ring and more sway.' },\n});\n\n/** The dev panel's slider groups: each a title and its settings, in order. */\nexport const SLIDER_GROUPS: readonly { title: string; paths: readonly string[] }[] = [\n  { title: 'Wobble', paths: ['game.wobble.gain', 'game.wobble.instability', 'game.wobble.damping', 'game.wobble.noise', 'game.wobble.noiseRate', 'game.wobble.reach'] },\n  { title: 'Breath & age', paths: ['game.breath.period', 'game.breath.calmEffect', 'game.age.k', 'game.pebbles.mult'] },\n  { title: 'Pose & reps', paths: ['game.pose.hold', 'game.pose.ring', 'game.reps.tempo', 'game.pond.penalty'] },\n  { title: 'Step', paths: ['game.step.bpm', 'game.step.perfect', 'game.step.good'] },\n  { title: 'Water', paths: ['game.line.stepKick', 'game.line.gust', 'game.paddle.speed', 'game.dive.spin'] },\n  { title: 'Sand & hoops', paths: ['game.garden.tilt', 'game.garden.gravity', 'game.garden.sink', 'game.hoop.bandMin', 'game.hoop.bandMax'] },\n  { title: 'Jog & tilt', paths: ['game.jog.speed', 'game.tilt.rate'] },\n];\nEOF\ncat > labs/game/scenes/components.ts <<'EOF'\n/**\n * @file Teeter Fit's components: plain data the sim hashes. `flow` is where the game is, `activity` the activity\n * running (its own state in `data`, what the HUD shows in `hud`), `seat` one balancing person's input, `wobble` their\n * body, `cast` a named person on the island, `island` the tilt, `pebble`, `plaque`, `ghost` and `critter` the rest.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * // w.query('seat', 'wobble')[0].wobble.x; // the first seat's centre of balance, x\n */\nimport {\n  defineComponent,\n  type ActorComponent,\n  type ClipsData,\n  type CrowdBody,\n  type ScenePropComponent,\n  type World,\n} from '../../../engine/sim-api';\n\n/** Number field. */\nconst n = (value = 0, description = 'A number.') => ({ type: 'number', default: value, description }) as const;\n/** Whole-number field. */\nconst i = (value = 0, description = 'A whole number.') => ({ type: 'integer', default: value, description }) as const;\n/** Text field. */\nconst s = (value = '', description = 'Text.') => ({ type: 'string', default: value, description }) as const;\n/** True or false field. */\nconst b = (value = false, description = 'A flag.') => ({ type: 'boolean', default: value, description }) as const;\n/** List field. */\nconst list = (description = 'A list.') => ({ type: 'array', default: [], description }) as const;\n/** Any plain object. */\nconst obj = (description = 'Plain data.') => ({ type: 'object', default: {}, description }) as const;\n\ndefineComponent('flow', {\n  description: 'Where the game is: front end, roaming, an activity, a cutscene or results.',\n  fields: {\n    mode: s('front', 'front, roam, event, cutscene, results.'),\n    event: s('', 'The activity running or just finished.'),\n    day: i(1, 'The residency day, 1 to 6 (6: after).'),\n    done: list('Activity ids finished today.'),\n    seen: list('Activities met, for the Noticeboard.'),\n    pebbles: i(0, 'Pebbles on the cairn.'),\n    found: list('Hidden pebble and plaque ids found.'),\n    ages: list('Wobble Ages so far, oldest first.'),\n    last: obj('The last result: score, rank, pebbles, event, age.'),\n    bests: obj('Best score by activity.'),\n    look: i(0, 'Guest look, 0 to 2.'),\n    color: s('coral', 'Guest tracksuit colour.'),\n    attract: b(false, 'The attract loop is running.'),\n    roster: i(0, 'Which attract act is on.'),\n    actTick: i(0, 'Steps in this attract act.'),\n    focus: i(-1, 'The usable the Guest is looking at, by index.'),\n    question: i(0, 'Morning question answer, 1 yes, 2 no.'),\n    script: i(0, 'The playthrough script step.'),\n    cutTick: i(0, 'Steps in this cutscene.'),\n    cut: s('', 'The cutscene playing.'),\n    credits: b(false, 'The credits are rolling.'),\n    resting: i(0, 'Steps sat on a bench.'),\n  },\n});\n\ndefineComponent('activity', {\n  description: 'The activity running: its id, phase, step counters, seats and its own plain data.',\n  fields: {\n    id: s('', 'Activity id.'),\n    short: b(false, 'The 45-second form for rounds.'),\n    phase: s('', 'Where in the activity it is.'),\n    t: i(0, 'Steps in this activity.'),\n    pt: i(0, 'Steps in this phase.'),\n    done: b(false, 'Finished: flow takes it to results.'),\n    score: n(0, 'Seat 0 score, 0 to 1000.'),\n    scores: list('Score by seat.'),\n    data: obj('The activity own state.'),\n    hud: obj('What the HUD shows, written by the activity.'),\n    spawned: list('Entities to remove at teardown.'),\n    actors: list('Actors to remove at teardown.'),\n  },\n});\n\ndefineComponent('seat', {\n  description: 'One balancing person: who feeds them and what they press this step.',\n  fields: {\n    index: i(0, 'Seat number, 0 to 3.'),\n    kind: s('local', 'local, pad, cpu, off.'),\n    skill: s('', 'cpu seats: which bot.'),\n    sway: n(1, 'cpu seats: extra sway multiplier.'),\n    actor: i(-1, 'The actor they stand in.'),\n    lx: n(0, 'Lean right.'),\n    ly: n(0, 'Lean forward.'),\n    fl: n(0, 'Left foot, 0 to 1.'),\n    fr: n(0, 'Right foot, 0 to 1.'),\n    act: b(false, 'An act button is down.'),\n    actP: b(false, 'An act button went down this step.'),\n    pfl: b(false, 'Left foot went down this step.'),\n    pfr: b(false, 'Right foot went down this step.'),\n    wasL: b(false, 'Left foot held last step.'),\n    wasR: b(false, 'Right foot held last step.'),\n    wasA: b(false, 'Act held last step.'),\n    gentle: b(false, 'Gentle lean held.'),\n    mx: n(0, 'Mouse lean, x, this step.'),\n    my: n(0, 'Mouse lean, y, this step.'),\n    px: n(0, 'Pointer place x, -1 to 1 (Sand Garden).'),\n    py: n(0, 'Pointer place y, -1 to 1.'),\n    pointer: b(false, 'The pointer place is live.'),\n    moved: n(0, 'Mouse travel this step.'),\n    hist: list('Bot memory: recent CoB positions.'),\n    mem: obj('Bot memory by activity.'),\n  },\n});\n\ndefineComponent('wobble', {\n  description: 'A centre of balance in the unit disc, its velocity, the breath, the sway.',\n  fields: {\n    x: n(0, 'CoB right.'),\n    y: n(0, 'CoB forward.'),\n    vx: n(0, 'Velocity x.'),\n    vy: n(0, 'Velocity y.'),\n    tx: n(0, 'Slewed lean target x.'),\n    ty: n(0, 'Slewed lean target y.'),\n    mx: n(0, 'Mouse target x.'),\n    my: n(0, 'Mouse target y.'),\n    dx: n(0, 'Disturbance this step, x.'),\n    dy: n(0, 'Disturbance this step, y.'),\n    instMul: n(1, 'Instability multiplier.'),\n    swayMul: n(1, 'Sway multiplier.'),\n    on: b(false, 'Stepped this step.'),\n    usesBreath: b(true, 'Both feet are breath here.'),\n    over: i(0, 'Steps past the edge.'),\n    recover: i(0, 'Steps left of recovery.'),\n    topples: i(0, 'Topples so far.'),\n    bt: i(0, 'Breath steps counted.'),\n    guide: n(0, 'The guide lungs, 0 to 1.'),\n    lungs: n(0, 'Your lungs, 0 to 1.'),\n    sync: n(0, 'Running match with the guide, 0 to 1.'),\n    calm: n(0, 'Calm, 0 to 1.'),\n    phases: list('Sway phases.'),\n    rates: list('Sway rate ratios.'),\n  },\n});\n\ndefineComponent('cast', {\n  description: 'A named person on the island, held in place while an activity or scene wants them there.',\n  fields: {\n    who: s('', 'guest, plumb, tare, gerald, bex, nan, or class.'),\n    hold: b(false, 'Placed each step at x, y, z.'),\n    x: n(0, 'Held east.'),\n    y: n(0, 'Held up.'),\n    z: n(0, 'Held south.'),\n    yaw: n(0, 'Held facing.'),\n    pose: s('', 'The strip scrubbed.'),\n    poseT: n(0, 'Pose progress.'),\n    leanX: n(0, 'Lean right, -1 to 1.'),\n    leanY: n(0, 'Lean forward, -1 to 1.'),\n    home: list('Where it roams from: x, z.'),\n  },\n});\n\ndefineComponent('island', {\n  description: 'How far out of true the island is.',\n  fields: {\n    tilt: n(0.4, 'The story tilt, degrees.'),\n    tiltX: n(0, 'Finale tilt east, degrees.'),\n    tiltZ: n(0, 'Finale tilt south, degrees.'),\n    storm: n(0, 'Storm level, 0 to 1.'),\n    sky: s('day', 'day, dusk, dawn, storm.'),\n    seaX: n(0, 'Sea drift.'),\n    seaZ: n(0, 'Sea drift.'),\n  },\n});\n\ndefineComponent('pebble', {\n  description: 'A hidden pebble on the island.',\n  fields: { index: i(0, 'Its number.'), prop: i(-1, 'Its prop.') },\n});\n\ndefineComponent('plaque', {\n  description: 'A plaque that creeps downhill by the day.',\n  fields: { index: i(0, 'Its number.'), x: n(0, 'East.'), z: n(0, 'South.'), prop: i(-1, 'Its prop.') },\n});\n\ndefineComponent('cairnStone', {\n  description: 'A pebble on your cairn.',\n  fields: { index: i(0, 'Which from the bottom.'), prop: i(-1, 'Its prop.') },\n});\n\ndefineComponent('critter', {\n  description: 'The Gull or the Frog: a blob on a blob rig, with where it wants to be.',\n  fields: {\n    kind: s('gull', 'gull or frog.'),\n    goalX: n(0, 'Wants to be, east.'),\n    goalY: n(0, 'Up.'),\n    goalZ: n(0, 'South.'),\n    look: n(0, 'Looks towards, rad.'),\n    speed: n(6, 'How fast it gets there.'),\n    away: b(true, 'Off screen, waiting.'),\n    tick: i(0, 'Its clock.'),\n  },\n});\n\ndefineComponent('ghost', {\n  description: 'Another player in the session, on their own mat.',\n  fields: {\n    id: i(0, 'Their player id.'),\n    x: n(0, 'Their CoB x.'),\n    y: n(0, 'Their CoB y.'),\n    e: i(0, 'Which class they are in.'),\n    p: s('', 'Their pose.'),\n    s: n(0, 'Their score.'),\n    gone: b(false, 'They left.'),\n    goneT: i(0, 'Steps since they left.'),\n    t: i(0, 'Steps since the last message.'),\n    actor: i(-1, 'The actor drawn.'),\n    active: b(true, 'Shown now.'),\n  },\n});\n\ndefineComponent('matRing', {\n  description: 'A ring on the floor of a mat, drawn as a telegraph.',\n  fields: {\n    telegraph: s('telegraph:matRing', 'The telegraph.'),\n    position: { type: 'array', default: [0, 0, 0], description: 'Its place.' },\n    yaw: n(0, 'Its turn.'),\n    u: n(1, 'Its fill.'),\n    size: n(1, 'Its size.'),\n    owner: i(-1, 'The entity it follows.'),\n  },\n});\n\n/** The flow, as held. */\nexport interface Flow {\n  mode: 'front' | 'roam' | 'event' | 'cutscene' | 'results';\n  event: string;\n  day: number;\n  done: string[];\n  seen: string[];\n  pebbles: number;\n  found: number[];\n  ages: number[];\n  last: LastResult;\n  bests: Record<string, number>;\n  look: number;\n  color: string;\n  attract: boolean;\n  roster: number;\n  actTick: number;\n  focus: number;\n  question: number;\n  script: number;\n  cutTick: number;\n  cut: string;\n  credits: boolean;\n  resting: number;\n}\n\n/** The last result, as the page shows it. */\nexport interface LastResult {\n  event?: string;\n  score?: number;\n  rank?: string;\n  pebbles?: number;\n  age?: number;\n  ageBefore?: number;\n}\n\n/** What the HUD reads, written by the activity. Any field may be absent. */\nexport interface HudData {\n  title?: string;\n  disc?: boolean;\n  ring?: [number, number, number];\n  guide?: boolean;\n  feet?: boolean;\n  meter?: number;\n  meterLabel?: string;\n  big?: string;\n  prompt?: string;\n  show?: Record<string, unknown>;\n}\n\n/** The running activity, as held. */\nexport interface ActivityData {\n  id: string;\n  short: boolean;\n  phase: string;\n  t: number;\n  pt: number;\n  done: boolean;\n  score: number;\n  scores: number[];\n  data: Record<string, unknown>;\n  hud: HudData;\n  spawned: number[];\n  actors: number[];\n}\n\n/** A seat, as held. */\nexport interface Seat {\n  index: number;\n  kind: 'local' | 'pad' | 'cpu' | 'off';\n  skill: string;\n  sway: number;\n  actor: number;\n  lx: number;\n  ly: number;\n  fl: number;\n  fr: number;\n  act: boolean;\n  actP: boolean;\n  pfl: boolean;\n  pfr: boolean;\n  wasL: boolean;\n  wasR: boolean;\n  wasA: boolean;\n  gentle: boolean;\n  mx: number;\n  my: number;\n  px: number;\n  py: number;\n  pointer: boolean;\n  moved: number;\n  hist: number[];\n  mem: Record<string, unknown>;\n}\n\n/** A centre of balance, as held. */\nexport interface Wobble {\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  tx: number;\n  ty: number;\n  mx: number;\n  my: number;\n  dx: number;\n  dy: number;\n  instMul: number;\n  swayMul: number;\n  on: boolean;\n  usesBreath: boolean;\n  over: number;\n  recover: number;\n  topples: number;\n  bt: number;\n  guide: number;\n  lungs: number;\n  sync: number;\n  calm: number;\n  phases: number[];\n  rates: number[];\n}\n\n/** A named person, as held. */\nexport interface Cast {\n  who: string;\n  hold: boolean;\n  x: number;\n  y: number;\n  z: number;\n  yaw: number;\n  pose: string;\n  poseT: number;\n  leanX: number;\n  leanY: number;\n  home: number[];\n}\n\n/** The tilt, as held. */\nexport interface IslandData {\n  tilt: number;\n  tiltX: number;\n  tiltZ: number;\n  storm: number;\n  sky: 'day' | 'dusk' | 'dawn' | 'storm';\n  seaX: number;\n  seaZ: number;\n}\n\n/** A critter, as held. */\nexport interface Critter {\n  kind: 'gull' | 'frog';\n  goalX: number;\n  goalY: number;\n  goalZ: number;\n  look: number;\n  speed: number;\n  away: boolean;\n  tick: number;\n}\n\n/** A ghost, as held. */\nexport interface Ghost {\n  id: number;\n  x: number;\n  y: number;\n  e: number;\n  p: string;\n  s: number;\n  gone: boolean;\n  goneT: number;\n  t: number;\n  actor: number;\n  active: boolean;\n}\n\n/** A floor ring, as held. */\nexport interface MatRing {\n  telegraph: string;\n  position: number[];\n  yaw: number;\n  u: number;\n  size: number;\n  owner: number;\n}\n\n/** Every component of the game's worlds, typed. */\nexport type GameComponents = {\n  flow: Flow;\n  activity: ActivityData;\n  seat: Seat;\n  wobble: Wobble;\n  cast: Cast;\n  island: IslandData;\n  pebble: { index: number; prop: number };\n  plaque: { index: number; x: number; z: number; prop: number };\n  cairnStone: { index: number; prop: number };\n  critter: Critter;\n  ghost: Ghost;\n  matRing: MatRing;\n  actor: ActorComponent;\n  clips: ClipsData;\n  crowdBody: CrowdBody;\n  sceneProp: ScenePropComponent;\n};\n\n/** A world of the game. */\nexport type GameWorld = World<GameComponents>;\nEOF\ncat > labs/game/scenes/wobble.ts <<'EOF'\n/**\n * @file The Wobble Model, the game's one verb (PLAN.md section 3): a centre of balance in a unit disc, moved each step\n * by the lean target, instability, a slow sway and disturbances; plus the breath: lungs, a guide, sync and calm.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts. It writes `Math.sin` and friends plainly, so the sim's math\n * swap reaches them, and reads each setting every step, so the dev sliders apply at once.\n *\n * @example\n * // stepWobble(w, seat, wobble); // once per step, for each seat in play\n */\nimport type { GameWorld, Seat, Wobble } from './components';\n\n/** How fast the lean target moves, units/s: a quick tap is a nudge, a held key a full lean. */\nexport const SLEW = 4;\n/** How much the gentle key scales the lean. */\nexport const GENTLE = 0.4;\n/** Steps past the edge before a topple. */\nexport const TOPPLE_STEPS = 6;\n/** Steps of recovery after a topple: a second. */\nexport const RECOVER_STEPS = 60;\n/** The mouse target's decay time constant, s. */\nexport const MOUSE_DECAY = 0.6;\n/** The most a mouse-made lean reaches. */\nconst MOUSE_MAX = 1;\n/** Seconds of the breath match's memory, as a share of the period. */\nconst SYNC_MEMORY = 0.5;\n/** How fast calm follows sync, 1/s. */\nconst CALM_RATE = 0.5;\n\n/** A fresh centre of balance, with its sway drawn from the named stream. */\nexport function makeWobble(w: GameWorld, seat: number, stream = 'sway'): Wobble {\n  const rng = w.rng(stream, seat);\n  return {\n    x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, mx: 0, my: 0, dx: 0, dy: 0,\n    instMul: 1, swayMul: 1, on: false, usesBreath: true, over: 0, recover: 0, topples: 0, bt: 0,\n    guide: 0, lungs: 0, sync: 0, calm: 0,\n    phases: [0, 1, 2, 3, 4, 5].map(() => rng.range(0, 2 * Math.PI)),\n    rates: [0, 1, 2, 3, 4, 5].map(() => rng.range(0.8, 1.25)),\n  }; // prettier-ignore\n}\n\n/** The sway at `t` seconds for an axis (0 or 1), from its phases and rates. */\nexport function swayAt(wob: Wobble, axis: number, t: number, rate: number): number {\n  const at = axis * 3;\n  const tau = 2 * Math.PI * rate * t;\n  const a = Math.sin(tau * wob.rates[at] + wob.phases[at]);\n  const b = 0.6 * Math.sin(tau * 1.7 * wob.rates[at + 1] + wob.phases[at + 1]);\n  const c = 0.3 * Math.sin(tau * 3.1 * wob.rates[at + 2] + wob.phases[at + 2]);\n  return (a + b + c) / 1.3;\n}\n\n/** Puts a body back at the centre, at rest (a new activity). Keeps its sway and its topple count unless told. */\nexport function resetWobble(wob: Wobble, keepTopples = false): void {\n  Object.assign(wob, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, mx: 0, my: 0, dx: 0, dy: 0, over: 0, recover: 0, instMul: 1, swayMul: 1 }); // prettier-ignore\n  Object.assign(wob, { bt: 0, guide: 0, lungs: 0, sync: 0, calm: 0, usesBreath: true });\n  if (!keepTopples) wob.topples = 0;\n}\n\n/** Whether both feet are held on this seat. */\nexport const bothFeet = (seat: Seat): boolean => seat.fl >= 0.5 && seat.fr >= 0.5;\n\n/** One step of the breath: the guide, the lungs, the running sync and calm. */\nfunction stepBreath(w: GameWorld, seat: Seat, wob: Wobble): void {\n  const period = w.settings.get<number>('game.breath.period');\n  const steps = Math.max(1, Math.round(period * w.hz));\n  wob.bt += 1;\n  const phase = (wob.bt % steps) / steps;\n  wob.guide = phase < 0.5 ? phase * 2 : 2 - phase * 2;\n  const both = wob.usesBreath && bothFeet(seat);\n  const rate = (2 / period) * w.dt;\n  wob.lungs = Math.min(1, Math.max(0, wob.lungs + (both ? rate : -rate)));\n  const inhaling = phase < 0.5;\n  const match = inhaling ? (both ? 1 : 0) : !both && wob.lungs > 0.02 ? 1 : 0;\n  const memory = Math.max(0.5, period * SYNC_MEMORY);\n  wob.sync += (match - wob.sync) * (1 - Math.exp(-w.dt / memory));\n  wob.calm += (wob.sync - wob.calm) * (1 - Math.exp(-w.dt * CALM_RATE));\n}\n\n/**\n * One step of a body, from its seat's input (the plan's model, per axis). `t` is the sway's clock in seconds. It emits\n * `topple` with the seat's index when the body stays past the edge; `game.noTopple` keeps it inside instead.\n */\nexport function stepWobble(w: GameWorld, seat: Seat, wob: Wobble): void {\n  const dt = w.dt;\n  stepBreath(w, seat, wob);\n  const get = (path: string) => w.settings.get<number>(path);\n  const gain = get('game.wobble.gain');\n  const instability = get('game.wobble.instability') * wob.instMul;\n  const damping = get('game.wobble.damping');\n  const reach = get('game.wobble.reach');\n  const calmEffect = get('game.breath.calmEffect');\n  const assist = w.settings.get<boolean>('game.assist') ? 0.5 : 1;\n  const expert = w.settings.get<boolean>('game.expert') ? 1.3 : 1;\n  const noise = get('game.wobble.noise') * wob.swayMul * assist * expert * seat.sway;\n  const rate = get('game.wobble.noiseRate');\n\n  wob.mx += seat.mx;\n  wob.my += seat.my;\n  const decay = Math.exp(-dt / MOUSE_DECAY);\n  wob.mx = clamp(wob.mx * decay, MOUSE_MAX);\n  wob.my = clamp(wob.my * decay, MOUSE_MAX);\n\n  let wantX = seat.lx + wob.mx;\n  let wantY = seat.ly + wob.my;\n  const size = Math.hypot(wantX, wantY);\n  if (size > 1) [wantX, wantY] = [wantX / size, wantY / size];\n  const lean = SLEW * dt;\n  wob.tx += clamp(wantX - wob.tx, lean);\n  wob.ty += clamp(wantY - wob.ty, lean);\n  const scale = (seat.gentle ? GENTLE : 1) * reach;\n  let targetX = wob.tx * scale;\n  let targetY = wob.ty * scale;\n  const far = Math.hypot(targetX, targetY);\n  if (far > 1) [targetX, targetY] = [targetX / far, targetY / far];\n\n  if (wob.recover > 0) {\n    wob.recover -= 1;\n    const back = Math.exp(-dt * 5);\n    [wob.x, wob.y, wob.vx, wob.vy] = [wob.x * back, wob.y * back, 0, 0];\n    wob.dx = wob.dy = 0;\n    return;\n  }\n\n  const t = w.tick / w.hz;\n  const sway = noise * (1 - calmEffect * wob.calm);\n  const ax = gain * (targetX - wob.x) + instability * wob.x + swayAt(wob, 0, t, rate) * sway + wob.dx;\n  const ay = gain * (targetY - wob.y) + instability * wob.y + swayAt(wob, 1, t, rate) * sway + wob.dy;\n  const keep = Math.exp(-damping * dt);\n  wob.vx = (wob.vx + ax * dt) * keep;\n  wob.vy = (wob.vy + ay * dt) * keep;\n  wob.x += wob.vx * dt;\n  wob.y += wob.vy * dt;\n  wob.dx = wob.dy = 0;\n\n  const r = Math.hypot(wob.x, wob.y);\n  if (w.settings.get<boolean>('game.noTopple') && r > 0.98) {\n    wob.x *= 0.98 / r;\n    wob.y *= 0.98 / r;\n    wob.over = 0;\n    return;\n  }\n  wob.over = r > 1 ? wob.over + 1 : 0;\n  if (wob.over >= TOPPLE_STEPS) {\n    wob.over = 0;\n    wob.recover = RECOVER_STEPS;\n    wob.topples += 1;\n    w.emit('topple', { seat: seat.index, x: wob.x, y: wob.y });\n  }\n}\n\n/** `v` kept within ±`limit`. */\nexport function clamp(v: number, limit: number): number {\n  return v > limit ? limit : v < -limit ? -limit : v;\n}\n\n/** Whether the body is within `r` of the point `x, y`. */\nexport function inRing(wob: Wobble, x: number, y: number, r: number): boolean {\n  return Math.hypot(wob.x - x, wob.y - y) <= r;\n}\nEOF\ncat > labs/game/scenes/bot/players.ts <<'EOF'\n/**\n * @file The four players that stand in for a human (PLAN.md section 16), plus a masher. They write the same seat input\n * a person does. `perfect` has no delay; `human` reads the CoB 250 ms late at gain 1.2 with a little jitter; `sloppy`\n * reads 350 ms late at gain 0.8; `idle` does nothing; `mash` presses at random, to prove nothing throws. In rhythm and\n * timing activities the delay and jitter become timing error (`timing`, in steps).\n *\n * Game code, sim-side.\n *\n * @example\n * // holdAt(w, seat, wobble, 0, 0, playerOf('human')); // steer towards the centre\n */\nimport type { GameWorld, Seat, Wobble } from '../components';\n\n/** One of the players' numbers. */\nexport interface Player {\n  name: string;\n  /** Steps it reads the CoB late. */\n  delay: number;\n  /** Proportional gain on what it reads. */\n  gain: number;\n  /** Stick jitter. */\n  jitter: number;\n  /** Timing error in rhythm, steps either side. */\n  timing: number;\n  /** Whether it takes any action at all. */\n  acts: boolean;\n}\n\n/** The players (see the file comment). */\nexport const PLAYERS: Readonly<Record<string, Player>> = Object.freeze({\n  perfect: { name: 'perfect', delay: 0, gain: 3, jitter: 0, timing: 0, acts: true },\n  human: { name: 'human', delay: 15, gain: 1.2, jitter: 0.04, timing: 4, acts: true },\n  sloppy: { name: 'sloppy', delay: 21, gain: 0.8, jitter: 0.06, timing: 8, acts: true },\n  idle: { name: 'idle', delay: 0, gain: 0, jitter: 0, timing: 0, acts: false },\n  mash: { name: 'mash', delay: 0, gain: 0, jitter: 1, timing: 0, acts: true },\n});\n\n/** The player called `name`, or the perfect one. */\nexport const playerOf = (name: string): Player => PLAYERS[name] ?? PLAYERS.perfect;\n\n/** How much lean holds a body still at a place: the model's balance of gain, instability and reach, at defaults. */\nconst FEED_FORWARD = 0.87;\n\n/** The CoB as the player read it `delay` steps ago; pushes the current one into its memory. */\nexport function remembered(seat: Seat, wob: Wobble, delay: number): [number, number] {\n  const hist = seat.hist;\n  hist.push(wob.x, wob.y);\n  const keep = 2 * (delay + 2);\n  if (hist.length > keep) hist.splice(0, hist.length - keep);\n  const at = Math.max(0, hist.length - 2 - 2 * delay);\n  return [hist[at], hist[at + 1]];\n}\n\n/** Writes the lean that steers this body towards `gx, gy`, as `player` would. */\nexport function holdAt(w: GameWorld, seat: Seat, wob: Wobble, gx: number, gy: number, player: Player): void {\n  if (!player.acts) {\n    seat.lx = seat.ly = 0;\n    return;\n  }\n  const [cx, cy] = remembered(seat, wob, player.delay);\n  const jitter = player.jitter;\n  const rng = w.rng('botJitter', seat.index);\n  const jx = jitter > 0 ? rng.range(-jitter, jitter) : 0;\n  const jy = jitter > 0 ? rng.range(-jitter, jitter) : 0;\n  seat.lx = gx * FEED_FORWARD + (gx - cx) * player.gain + jx;\n  seat.ly = gy * FEED_FORWARD + (gy - cy) * player.gain + jy;\n}\n\n/** Writes the breath: holds both feet while the guide fills, lets go while it empties, `lag` steps late. */\nexport function breathe(w: GameWorld, seat: Seat, wob: Wobble, player: Player): void {\n  if (!player.acts) {\n    seat.fl = seat.fr = 0;\n    return;\n  }\n  const period = Math.max(1, Math.round(w.settings.get<number>('game.breath.period') * w.hz));\n  const lag = player.delay;\n  const phase = ((wob.bt - lag + period * 4) % period) / period;\n  const down = phase < 0.5 ? 1 : 0;\n  seat.fl = seat.fr = down;\n}\n\n/** A timing error for one press, in steps, as this player has it; 0 for the perfect one. */\nexport function timingError(w: GameWorld, seat: Seat, player: Player): number {\n  if (player.timing <= 0) return 0;\n  return Math.round(w.rng('botTiming', seat.index).range(-player.timing, player.timing));\n}\n\n/** Random input for a step: the masher. */\nexport function mash(w: GameWorld, seat: Seat): void {\n  const rng = w.rng('botMash', seat.index);\n  if (rng.chance(0.2)) seat.lx = rng.range(-1, 1);\n  if (rng.chance(0.2)) seat.ly = rng.range(-1, 1);\n  if (rng.chance(0.2)) seat.fl = rng.chance(0.5) ? 1 : 0;\n  if (rng.chance(0.2)) seat.fr = rng.chance(0.5) ? 1 : 0;\n  seat.act = rng.chance(0.1);\n}\nEOF\n","description":"Write the settings, components, wobble model and bot players"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2810,"cache_read_input_tokens":215059,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2810},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"ee4b88dc-f307-46db-a085-a3c0e22d75ac","timestamp":"2026-11-05T09:03:52.774Z","request_id":"req_011CgjWUE9A5AEo2QkALMx19","wire_tool_inputs":{"toolu_01PNPGYc2TfPysyMDa3yzSZM":{"command":"mkdir -p labs/game/scenes/events labs/game/scenes/bot labs/game/scenes/data labs/game/cast/clipdata labs/game/props labs/game/geometry labs/game/materials labs/game/textures labs/game/bodies labs/game/builds labs/game/emitters labs/game/looks labs/game/cameras labs/game/sounds labs/game/ui/screens labs/game/ui/hud labs/game/ui/lines labs/game/ui/dev labs/game/audio labs/game/tools labs/game/replays\ncat > labs/game/scenes/settings.ts <<'EOF'\n/**\n * @file Teeter Fit's tunable numbers: every `game.*` setting the dev panel exposes as a live slider, plus the switches\n * the director and tests use. All are sim settings read every step (`when: 'now'`), so a change plays at once and\n * replays hold it. `SLIDER_GROUPS` names which settings the dev panel shows, in which group.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * // w.settings.get<number>('game.wobble.gain'); // 14\n * @see labs/game/scenes/wobble.test.ts\n */\nimport { defineSettings } from '../../../engine/sim-api';\n\n/** A number setting, live. */\nconst num = (value: number, minimum: number, maximum: number, unit: string, description: string) =>\n  ({ type: 'number', default: value, minimum, maximum, unit, when: 'now', description }) as const;\n\n/** The settings (see the file comment). */\nexport const GAME_SETTINGS = defineSettings({\n  'game.wobble.gain': num(14, 4, 30, '1/s2', 'How fast your weight follows your thumb.'),\n  'game.wobble.instability': num(3, 0, 10, '1/s2', 'How hard you fall away from the centre.'),\n  'game.wobble.damping': num(5, 1, 12, '1/s', 'How heavy the body feels.'),\n  'game.wobble.noise': num(3.5, 0, 8, '1/s2', 'Sway strength.'),\n  'game.wobble.noiseRate': num(0.15, 0.05, 0.4, 'Hz', 'Sway speed: a slow push you lean against.'),\n  'game.wobble.reach': num(0.9, 0.5, 1, '', \"Full stick's target; a held full stick topples, on purpose.\"),\n  'game.breath.period': num(8, 4, 14, 's', 'One breath, half in, half out.'),\n  'game.breath.calmEffect': num(0.5, 0, 1, '', 'How much full calm quiets the sway.'),\n  'game.age.k': num(1.3, 0.5, 3, '', 'The Wobble Age curve.'),\n  'game.pebbles.mult': num(1, 0, 5, '', 'Pebbles earned, multiplied.'),\n  'game.pose.hold': num(12, 4, 30, 's', 'How long a pose is held.'),\n  'game.pose.ring': num(0.2, 0.08, 0.4, '', 'The seat ring of a pose.'),\n  'game.reps.tempo': num(3, 1.5, 6, 's', 'Seconds for one rep.'),\n  'game.step.bpm': num(1, 0.5, 1.5, 'x', 'Scales the tempo of every Step Class phrase.'),\n  'game.step.perfect': num(3, 1, 8, 'steps', 'The Perfect window, either side.'),\n  'game.step.good': num(7, 3, 16, 'steps', 'The Good window, either side.'),\n  'game.pond.penalty': num(80, 10, 200, '', 'Composure lost each time you move.'),\n  'game.line.stepKick': num(0.35, 0, 1, '', 'How hard each step kicks you sideways.'),\n  'game.line.gust': num(1.2, 0, 3, '', 'How hard the gusts push.'),\n  'game.paddle.speed': num(6, 2, 12, 'm/s', 'Board speed at full forward lean.'),\n  'game.garden.tilt': num(12, 4, 24, 'deg', 'The most the tray tilts.'),\n  'game.garden.gravity': num(9, 2, 20, 'm/s2', 'How hard marbles roll downhill.'),\n  'game.garden.sink': num(1.6, 0.4, 4, 'm/s', 'Below this speed a hole catches a marble.'),\n  'game.dive.spin': num(9, 3, 16, 'rad/s', 'Full lean, spin speed in the air.'),\n  'game.hoop.bandMin': num(5, 2, 8, 'rad/s', 'Slowest spin that keeps hoops up.'),\n  'game.hoop.bandMax': num(9, 6, 18, 'rad/s', 'Fastest spin that keeps hoops up.'),\n  'game.jog.speed': num(4.6, 2, 9, 'm/s', 'Island Jog speed.'),\n  'game.tilt.rate': num(0.03, 0, 0.2, 'deg/s', 'How fast the Great Tilt grows.'),\n  'game.auto': { type: 'boolean', default: false, when: 'now', description: 'The bot plays seat 0.' },\n  'game.skill': {\n    type: 'string',\n    enum: ['perfect', 'human', 'sloppy', 'idle', 'mash'],\n    default: 'perfect',\n    when: 'now',\n    description: 'Which of the test players the bot is.',\n  },\n  'game.noTopple': { type: 'boolean', default: false, when: 'now', description: 'Nobody topples.' },\n  'game.assist': { type: 'boolean', default: false, when: 'now', description: 'Steadier Hands: halves the sway.' },\n  'game.expert': { type: 'boolean', default: false, when: 'now', description: 'Expert: a smaller ring and more sway.' },\n});\n\n/** The dev panel's slider groups: each a title and its settings, in order. */\nexport const SLIDER_GROUPS: readonly { title: string; paths: readonly string[] }[] = [\n  { title: 'Wobble', paths: ['game.wobble.gain', 'game.wobble.instability', 'game.wobble.damping', 'game.wobble.noise', 'game.wobble.noiseRate', 'game.wobble.reach'] },\n  { title: 'Breath & age', paths: ['game.breath.period', 'game.breath.calmEffect', 'game.age.k', 'game.pebbles.mult'] },\n  { title: 'Pose & reps', paths: ['game.pose.hold', 'game.pose.ring', 'game.reps.tempo', 'game.pond.penalty'] },\n  { title: 'Step', paths: ['game.step.bpm', 'game.step.perfect', 'game.step.good'] },\n  { title: 'Water', paths: ['game.line.stepKick', 'game.line.gust', 'game.paddle.speed', 'game.dive.spin'] },\n  { title: 'Sand & hoops', paths: ['game.garden.tilt', 'game.garden.gravity', 'game.garden.sink', 'game.hoop.bandMin', 'game.hoop.bandMax'] },\n  { title: 'Jog & tilt', paths: ['game.jog.speed', 'game.tilt.rate'] },\n];\nEOF\ncat > labs/game/scenes/components.ts <<'EOF'\n/**\n * @file Teeter Fit's components: plain data the sim hashes. `flow` is where the game is, `activity` the activity\n * running (its own state in `data`, what the HUD shows in `hud`), `seat` one balancing person's input, `wobble` their\n * body, `cast` a named person on the island, `island` the tilt, `pebble`, `plaque`, `ghost` and `critter` the rest.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * // w.query('seat', 'wobble')[0].wobble.x; // the first seat's centre of balance, x\n */\nimport {\n  defineComponent,\n  type ActorComponent,\n  type ClipsData,\n  type CrowdBody,\n  type ScenePropComponent,\n  type World,\n} from '../../../engine/sim-api';\n\n/** Number field. */\nconst n = (value = 0, description = 'A number.') => ({ type: 'number', default: value, description }) as const;\n/** Whole-number field. */\nconst i = (value = 0, description = 'A whole number.') => ({ type: 'integer', default: value, description }) as const;\n/** Text field. */\nconst s = (value = '', description = 'Text.') => ({ type: 'string', default: value, description }) as const;\n/** True or false field. */\nconst b = (value = false, description = 'A flag.') => ({ type: 'boolean', default: value, description }) as const;\n/** List field. */\nconst list = (description = 'A list.') => ({ type: 'array', default: [], description }) as const;\n/** Any plain object. */\nconst obj = (description = 'Plain data.') => ({ type: 'object', default: {}, description }) as const;\n\ndefineComponent('flow', {\n  description: 'Where the game is: front end, roaming, an activity, a cutscene or results.',\n  fields: {\n    mode: s('front', 'front, roam, event, cutscene, results.'),\n    event: s('', 'The activity running or just finished.'),\n    day: i(1, 'The residency day, 1 to 6 (6: after).'),\n    done: list('Activity ids finished today.'),\n    seen: list('Activities met, for the Noticeboard.'),\n    pebbles: i(0, 'Pebbles on the cairn.'),\n    found: list('Hidden pebble and plaque ids found.'),\n    ages: list('Wobble Ages so far, oldest first.'),\n    last: obj('The last result: score, rank, pebbles, event, age.'),\n    bests: obj('Best score by activity.'),\n    look: i(0, 'Guest look, 0 to 2.'),\n    color: s('coral', 'Guest tracksuit colour.'),\n    attract: b(false, 'The attract loop is running.'),\n    roster: i(0, 'Which attract act is on.'),\n    actTick: i(0, 'Steps in this attract act.'),\n    focus: i(-1, 'The usable the Guest is looking at, by index.'),\n    question: i(0, 'Morning question answer, 1 yes, 2 no.'),\n    script: i(0, 'The playthrough script step.'),\n    cutTick: i(0, 'Steps in this cutscene.'),\n    cut: s('', 'The cutscene playing.'),\n    credits: b(false, 'The credits are rolling.'),\n    resting: i(0, 'Steps sat on a bench.'),\n  },\n});\n\ndefineComponent('activity', {\n  description: 'The activity running: its id, phase, step counters, seats and its own plain data.',\n  fields: {\n    id: s('', 'Activity id.'),\n    short: b(false, 'The 45-second form for rounds.'),\n    phase: s('', 'Where in the activity it is.'),\n    t: i(0, 'Steps in this activity.'),\n    pt: i(0, 'Steps in this phase.'),\n    done: b(false, 'Finished: flow takes it to results.'),\n    score: n(0, 'Seat 0 score, 0 to 1000.'),\n    scores: list('Score by seat.'),\n    data: obj('The activity own state.'),\n    hud: obj('What the HUD shows, written by the activity.'),\n    spawned: list('Entities to remove at teardown.'),\n    actors: list('Actors to remove at teardown.'),\n  },\n});\n\ndefineComponent('seat', {\n  description: 'One balancing person: who feeds them and what they press this step.',\n  fields: {\n    index: i(0, 'Seat number, 0 to 3.'),\n    kind: s('local', 'local, pad, cpu, off.'),\n    skill: s('', 'cpu seats: which bot.'),\n    sway: n(1, 'cpu seats: extra sway multiplier.'),\n    actor: i(-1, 'The actor they stand in.'),\n    lx: n(0, 'Lean right.'),\n    ly: n(0, 'Lean forward.'),\n    fl: n(0, 'Left foot, 0 to 1.'),\n    fr: n(0, 'Right foot, 0 to 1.'),\n    act: b(false, 'An act button is down.'),\n    actP: b(false, 'An act button went down this step.'),\n    pfl: b(false, 'Left foot went down this step.'),\n    pfr: b(false, 'Right foot went down this step.'),\n    wasL: b(false, 'Left foot held last step.'),\n    wasR: b(false, 'Right foot held last step.'),\n    wasA: b(false, 'Act held last step.'),\n    gentle: b(false, 'Gentle lean held.'),\n    mx: n(0, 'Mouse lean, x, this step.'),\n    my: n(0, 'Mouse lean, y, this step.'),\n    px: n(0, 'Pointer place x, -1 to 1 (Sand Garden).'),\n    py: n(0, 'Pointer place y, -1 to 1.'),\n    pointer: b(false, 'The pointer place is live.'),\n    moved: n(0, 'Mouse travel this step.'),\n    hist: list('Bot memory: recent CoB positions.'),\n    mem: obj('Bot memory by activity.'),\n  },\n});\n\ndefineComponent('wobble', {\n  description: 'A centre of balance in the unit disc, its velocity, the breath, the sway.',\n  fields: {\n    x: n(0, 'CoB right.'),\n    y: n(0, 'CoB forward.'),\n    vx: n(0, 'Velocity x.'),\n    vy: n(0, 'Velocity y.'),\n    tx: n(0, 'Slewed lean target x.'),\n    ty: n(0, 'Slewed lean target y.'),\n    mx: n(0, 'Mouse target x.'),\n    my: n(0, 'Mouse target y.'),\n    dx: n(0, 'Disturbance this step, x.'),\n    dy: n(0, 'Disturbance this step, y.'),\n    instMul: n(1, 'Instability multiplier.'),\n    swayMul: n(1, 'Sway multiplier.'),\n    on: b(false, 'Stepped this step.'),\n    usesBreath: b(true, 'Both feet are breath here.'),\n    over: i(0, 'Steps past the edge.'),\n    recover: i(0, 'Steps left of recovery.'),\n    topples: i(0, 'Topples so far.'),\n    bt: i(0, 'Breath steps counted.'),\n    guide: n(0, 'The guide lungs, 0 to 1.'),\n    lungs: n(0, 'Your lungs, 0 to 1.'),\n    sync: n(0, 'Running match with the guide, 0 to 1.'),\n    calm: n(0, 'Calm, 0 to 1.'),\n    phases: list('Sway phases.'),\n    rates: list('Sway rate ratios.'),\n  },\n});\n\ndefineComponent('cast', {\n  description: 'A named person on the island, held in place while an activity or scene wants them there.',\n  fields: {\n    who: s('', 'guest, plumb, tare, gerald, bex, nan, or class.'),\n    hold: b(false, 'Placed each step at x, y, z.'),\n    x: n(0, 'Held east.'),\n    y: n(0, 'Held up.'),\n    z: n(0, 'Held south.'),\n    yaw: n(0, 'Held facing.'),\n    pose: s('', 'The strip scrubbed.'),\n    poseT: n(0, 'Pose progress.'),\n    leanX: n(0, 'Lean right, -1 to 1.'),\n    leanY: n(0, 'Lean forward, -1 to 1.'),\n    home: list('Where it roams from: x, z.'),\n  },\n});\n\ndefineComponent('island', {\n  description: 'How far out of true the island is.',\n  fields: {\n    tilt: n(0.4, 'The story tilt, degrees.'),\n    tiltX: n(0, 'Finale tilt east, degrees.'),\n    tiltZ: n(0, 'Finale tilt south, degrees.'),\n    storm: n(0, 'Storm level, 0 to 1.'),\n    sky: s('day', 'day, dusk, dawn, storm.'),\n    seaX: n(0, 'Sea drift.'),\n    seaZ: n(0, 'Sea drift.'),\n  },\n});\n\ndefineComponent('pebble', {\n  description: 'A hidden pebble on the island.',\n  fields: { index: i(0, 'Its number.'), prop: i(-1, 'Its prop.') },\n});\n\ndefineComponent('plaque', {\n  description: 'A plaque that creeps downhill by the day.',\n  fields: { index: i(0, 'Its number.'), x: n(0, 'East.'), z: n(0, 'South.'), prop: i(-1, 'Its prop.') },\n});\n\ndefineComponent('cairnStone', {\n  description: 'A pebble on your cairn.',\n  fields: { index: i(0, 'Which from the bottom.'), prop: i(-1, 'Its prop.') },\n});\n\ndefineComponent('critter', {\n  description: 'The Gull or the Frog: a blob on a blob rig, with where it wants to be.',\n  fields: {\n    kind: s('gull', 'gull or frog.'),\n    goalX: n(0, 'Wants to be, east.'),\n    goalY: n(0, 'Up.'),\n    goalZ: n(0, 'South.'),\n    look: n(0, 'Looks towards, rad.'),\n    speed: n(6, 'How fast it gets there.'),\n    away: b(true, 'Off screen, waiting.'),\n    tick: i(0, 'Its clock.'),\n  },\n});\n\ndefineComponent('ghost', {\n  description: 'Another player in the session, on their own mat.',\n  fields: {\n    id: i(0, 'Their player id.'),\n    x: n(0, 'Their CoB x.'),\n    y: n(0, 'Their CoB y.'),\n    e: i(0, 'Which class they are in.'),\n    p: s('', 'Their pose.'),\n    s: n(0, 'Their score.'),\n    gone: b(false, 'They left.'),\n    goneT: i(0, 'Steps since they left.'),\n    t: i(0, 'Steps since the last message.'),\n    actor: i(-1, 'The actor drawn.'),\n    active: b(true, 'Shown now.'),\n  },\n});\n\ndefineComponent('matRing', {\n  description: 'A ring on the floor of a mat, drawn as a telegraph.',\n  fields: {\n    telegraph: s('telegraph:matRing', 'The telegraph.'),\n    position: { type: 'array', default: [0, 0, 0], description: 'Its place.' },\n    yaw: n(0, 'Its turn.'),\n    u: n(1, 'Its fill.'),\n    size: n(1, 'Its size.'),\n    owner: i(-1, 'The entity it follows.'),\n  },\n});\n\n/** The flow, as held. */\nexport interface Flow {\n  mode: 'front' | 'roam' | 'event' | 'cutscene' | 'results';\n  event: string;\n  day: number;\n  done: string[];\n  seen: string[];\n  pebbles: number;\n  found: number[];\n  ages: number[];\n  last: LastResult;\n  bests: Record<string, number>;\n  look: number;\n  color: string;\n  attract: boolean;\n  roster: number;\n  actTick: number;\n  focus: number;\n  question: number;\n  script: number;\n  cutTick: number;\n  cut: string;\n  credits: boolean;\n  resting: number;\n}\n\n/** The last result, as the page shows it. */\nexport interface LastResult {\n  event?: string;\n  score?: number;\n  rank?: string;\n  pebbles?: number;\n  age?: number;\n  ageBefore?: number;\n}\n\n/** What the HUD reads, written by the activity. Any field may be absent. */\nexport interface HudData {\n  title?: string;\n  disc?: boolean;\n  ring?: [number, number, number];\n  guide?: boolean;\n  feet?: boolean;\n  meter?: number;\n  meterLabel?: string;\n  big?: string;\n  prompt?: string;\n  show?: Record<string, unknown>;\n}\n\n/** The running activity, as held. */\nexport interface ActivityData {\n  id: string;\n  short: boolean;\n  phase: string;\n  t: number;\n  pt: number;\n  done: boolean;\n  score: number;\n  scores: number[];\n  data: Record<string, unknown>;\n  hud: HudData;\n  spawned: number[];\n  actors: number[];\n}\n\n/** A seat, as held. */\nexport interface Seat {\n  index: number;\n  kind: 'local' | 'pad' | 'cpu' | 'off';\n  skill: string;\n  sway: number;\n  actor: number;\n  lx: number;\n  ly: number;\n  fl: number;\n  fr: number;\n  act: boolean;\n  actP: boolean;\n  pfl: boolean;\n  pfr: boolean;\n  wasL: boolean;\n  wasR: boolean;\n  wasA: boolean;\n  gentle: boolean;\n  mx: number;\n  my: number;\n  px: number;\n  py: number;\n  pointer: boolean;\n  moved: number;\n  hist: number[];\n  mem: Record<string, unknown>;\n}\n\n/** A centre of balance, as held. */\nexport interface Wobble {\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  tx: number;\n  ty: number;\n  mx: number;\n  my: number;\n  dx: number;\n  dy: number;\n  instMul: number;\n  swayMul: number;\n  on: boolean;\n  usesBreath: boolean;\n  over: number;\n  recover: number;\n  topples: number;\n  bt: number;\n  guide: number;\n  lungs: number;\n  sync: number;\n  calm: number;\n  phases: number[];\n  rates: number[];\n}\n\n/** A named person, as held. */\nexport interface Cast {\n  who: string;\n  hold: boolean;\n  x: number;\n  y: number;\n  z: number;\n  yaw: number;\n  pose: string;\n  poseT: number;\n  leanX: number;\n  leanY: number;\n  home: number[];\n}\n\n/** The tilt, as held. */\nexport interface IslandData {\n  tilt: number;\n  tiltX: number;\n  tiltZ: number;\n  storm: number;\n  sky: 'day' | 'dusk' | 'dawn' | 'storm';\n  seaX: number;\n  seaZ: number;\n}\n\n/** A critter, as held. */\nexport interface Critter {\n  kind: 'gull' | 'frog';\n  goalX: number;\n  goalY: number;\n  goalZ: number;\n  look: number;\n  speed: number;\n  away: boolean;\n  tick: number;\n}\n\n/** A ghost, as held. */\nexport interface Ghost {\n  id: number;\n  x: number;\n  y: number;\n  e: number;\n  p: string;\n  s: number;\n  gone: boolean;\n  goneT: number;\n  t: number;\n  actor: number;\n  active: boolean;\n}\n\n/** A floor ring, as held. */\nexport interface MatRing {\n  telegraph: string;\n  position: number[];\n  yaw: number;\n  u: number;\n  size: number;\n  owner: number;\n}\n\n/** Every component of the game's worlds, typed. */\nexport type GameComponents = {\n  flow: Flow;\n  activity: ActivityData;\n  seat: Seat;\n  wobble: Wobble;\n  cast: Cast;\n  island: IslandData;\n  pebble: { index: number; prop: number };\n  plaque: { index: number; x: number; z: number; prop: number };\n  cairnStone: { index: number; prop: number };\n  critter: Critter;\n  ghost: Ghost;\n  matRing: MatRing;\n  actor: ActorComponent;\n  clips: ClipsData;\n  crowdBody: CrowdBody;\n  sceneProp: ScenePropComponent;\n};\n\n/** A world of the game. */\nexport type GameWorld = World<GameComponents>;\nEOF\ncat > labs/game/scenes/wobble.ts <<'EOF'\n/**\n * @file The Wobble Model, the game's one verb (PLAN.md section 3): a centre of balance in a unit disc, moved each step\n * by the lean target, instability, a slow sway and disturbances; plus the breath: lungs, a guide, sync and calm.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts. It writes `Math.sin` and friends plainly, so the sim's math\n * swap reaches them, and reads each setting every step, so the dev sliders apply at once.\n *\n * @example\n * // stepWobble(w, seat, wobble); // once per step, for each seat in play\n */\nimport type { GameWorld, Seat, Wobble } from './components';\n\n/** How fast the lean target moves, units/s: a quick tap is a nudge, a held key a full lean. */\nexport const SLEW = 4;\n/** How much the gentle key scales the lean. */\nexport const GENTLE = 0.4;\n/** Steps past the edge before a topple. */\nexport const TOPPLE_STEPS = 6;\n/** Steps of recovery after a topple: a second. */\nexport const RECOVER_STEPS = 60;\n/** The mouse target's decay time constant, s. */\nexport const MOUSE_DECAY = 0.6;\n/** The most a mouse-made lean reaches. */\nconst MOUSE_MAX = 1;\n/** Seconds of the breath match's memory, as a share of the period. */\nconst SYNC_MEMORY = 0.5;\n/** How fast calm follows sync, 1/s. */\nconst CALM_RATE = 0.5;\n\n/** A fresh centre of balance, with its sway drawn from the named stream. */\nexport function makeWobble(w: GameWorld, seat: number, stream = 'sway'): Wobble {\n  const rng = w.rng(stream, seat);\n  return {\n    x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, mx: 0, my: 0, dx: 0, dy: 0,\n    instMul: 1, swayMul: 1, on: false, usesBreath: true, over: 0, recover: 0, topples: 0, bt: 0,\n    guide: 0, lungs: 0, sync: 0, calm: 0,\n    phases: [0, 1, 2, 3, 4, 5].map(() => rng.range(0, 2 * Math.PI)),\n    rates: [0, 1, 2, 3, 4, 5].map(() => rng.range(0.8, 1.25)),\n  }; // prettier-ignore\n}\n\n/** The sway at `t` seconds for an axis (0 or 1), from its phases and rates. */\nexport function swayAt(wob: Wobble, axis: number, t: number, rate: number): number {\n  const at = axis * 3;\n  const tau = 2 * Math.PI * rate * t;\n  const a = Math.sin(tau * wob.rates[at] + wob.phases[at]);\n  const b = 0.6 * Math.sin(tau * 1.7 * wob.rates[at + 1] + wob.phases[at + 1]);\n  const c = 0.3 * Math.sin(tau * 3.1 * wob.rates[at + 2] + wob.phases[at + 2]);\n  return (a + b + c) / 1.3;\n}\n\n/** Puts a body back at the centre, at rest (a new activity). Keeps its sway and its topple count unless told. */\nexport function resetWobble(wob: Wobble, keepTopples = false): void {\n  Object.assign(wob, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, mx: 0, my: 0, dx: 0, dy: 0, over: 0, recover: 0, instMul: 1, swayMul: 1 }); // prettier-ignore\n  Object.assign(wob, { bt: 0, guide: 0, lungs: 0, sync: 0, calm: 0, usesBreath: true });\n  if (!keepTopples) wob.topples = 0;\n}\n\n/** Whether both feet are held on this seat. */\nexport const bothFeet = (seat: Seat): boolean => seat.fl >= 0.5 && seat.fr >= 0.5;\n\n/** One step of the breath: the guide, the lungs, the running sync and calm. */\nfunction stepBreath(w: GameWorld, seat: Seat, wob: Wobble): void {\n  const period = w.settings.get<number>('game.breath.period');\n  const steps = Math.max(1, Math.round(period * w.hz));\n  wob.bt += 1;\n  const phase = (wob.bt % steps) / steps;\n  wob.guide = phase < 0.5 ? phase * 2 : 2 - phase * 2;\n  const both = wob.usesBreath && bothFeet(seat);\n  const rate = (2 / period) * w.dt;\n  wob.lungs = Math.min(1, Math.max(0, wob.lungs + (both ? rate : -rate)));\n  const inhaling = phase < 0.5;\n  const match = inhaling ? (both ? 1 : 0) : !both && wob.lungs > 0.02 ? 1 : 0;\n  const memory = Math.max(0.5, period * SYNC_MEMORY);\n  wob.sync += (match - wob.sync) * (1 - Math.exp(-w.dt / memory));\n  wob.calm += (wob.sync - wob.calm) * (1 - Math.exp(-w.dt * CALM_RATE));\n}\n\n/**\n * One step of a body, from its seat's input (the plan's model, per axis). `t` is the sway's clock in seconds. It emits\n * `topple` with the seat's index when the body stays past the edge; `game.noTopple` keeps it inside instead.\n */\nexport function stepWobble(w: GameWorld, seat: Seat, wob: Wobble): void {\n  const dt = w.dt;\n  stepBreath(w, seat, wob);\n  const get = (path: string) => w.settings.get<number>(path);\n  const gain = get('game.wobble.gain');\n  const instability = get('game.wobble.instability') * wob.instMul;\n  const damping = get('game.wobble.damping');\n  const reach = get('game.wobble.reach');\n  const calmEffect = get('game.breath.calmEffect');\n  const assist = w.settings.get<boolean>('game.assist') ? 0.5 : 1;\n  const expert = w.settings.get<boolean>('game.expert') ? 1.3 : 1;\n  const noise = get('game.wobble.noise') * wob.swayMul * assist * expert * seat.sway;\n  const rate = get('game.wobble.noiseRate');\n\n  wob.mx += seat.mx;\n  wob.my += seat.my;\n  const decay = Math.exp(-dt / MOUSE_DECAY);\n  wob.mx = clamp(wob.mx * decay, MOUSE_MAX);\n  wob.my = clamp(wob.my * decay, MOUSE_MAX);\n\n  let wantX = seat.lx + wob.mx;\n  let wantY = seat.ly + wob.my;\n  const size = Math.hypot(wantX, wantY);\n  if (size > 1) [wantX, wantY] = [wantX / size, wantY / size];\n  const lean = SLEW * dt;\n  wob.tx += clamp(wantX - wob.tx, lean);\n  wob.ty += clamp(wantY - wob.ty, lean);\n  const scale = (seat.gentle ? GENTLE : 1) * reach;\n  let targetX = wob.tx * scale;\n  let targetY = wob.ty * scale;\n  const far = Math.hypot(targetX, targetY);\n  if (far > 1) [targetX, targetY] = [targetX / far, targetY / far];\n\n  if (wob.recover > 0) {\n    wob.recover -= 1;\n    const back = Math.exp(-dt * 5);\n    [wob.x, wob.y, wob.vx, wob.vy] = [wob.x * back, wob.y * back, 0, 0];\n    wob.dx = wob.dy = 0;\n    return;\n  }\n\n  const t = w.tick / w.hz;\n  const sway = noise * (1 - calmEffect * wob.calm);\n  const ax = gain * (targetX - wob.x) + instability * wob.x + swayAt(wob, 0, t, rate) * sway + wob.dx;\n  const ay = gain * (targetY - wob.y) + instability * wob.y + swayAt(wob, 1, t, rate) * sway + wob.dy;\n  const keep = Math.exp(-damping * dt);\n  wob.vx = (wob.vx + ax * dt) * keep;\n  wob.vy = (wob.vy + ay * dt) * keep;\n  wob.x += wob.vx * dt;\n  wob.y += wob.vy * dt;\n  wob.dx = wob.dy = 0;\n\n  const r = Math.hypot(wob.x, wob.y);\n  if (w.settings.get<boolean>('game.noTopple') && r > 0.98) {\n    wob.x *= 0.98 / r;\n    wob.y *= 0.98 / r;\n    wob.over = 0;\n    return;\n  }\n  wob.over = r > 1 ? wob.over + 1 : 0;\n  if (wob.over >= TOPPLE_STEPS) {\n    wob.over = 0;\n    wob.recover = RECOVER_STEPS;\n    wob.topples += 1;\n    w.emit('topple', { seat: seat.index, x: wob.x, y: wob.y });\n  }\n}\n\n/** `v` kept within ±`limit`. */\nexport function clamp(v: number, limit: number): number {\n  return v > limit ? limit : v < -limit ? -limit : v;\n}\n\n/** Whether the body is within `r` of the point `x, y`. */\nexport function inRing(wob: Wobble, x: number, y: number, r: number): boolean {\n  return Math.hypot(wob.x - x, wob.y - y) <= r;\n}\nEOF\ncat > labs/game/scenes/bot/players.ts <<'EOF'\n/**\n * @file The four players that stand in for a human (PLAN.md section 16), plus a masher. They write the same seat input\n * a person does. `perfect` has no delay; `human` reads the CoB 250 ms late at gain 1.2 with a little jitter; `sloppy`\n * reads 350 ms late at gain 0.8; `idle` does nothing; `mash` presses at random, to prove nothing throws. In rhythm and\n * timing activities the delay and jitter become timing error (`timing`, in steps).\n *\n * Game code, sim-side.\n *\n * @example\n * // holdAt(w, seat, wobble, 0, 0, playerOf('human')); // steer towards the centre\n */\nimport type { GameWorld, Seat, Wobble } from '../components';\n\n/** One of the players' numbers. */\nexport interface Player {\n  name: string;\n  /** Steps it reads the CoB late. */\n  delay: number;\n  /** Proportional gain on what it reads. */\n  gain: number;\n  /** Stick jitter. */\n  jitter: number;\n  /** Timing error in rhythm, steps either side. */\n  timing: number;\n  /** Whether it takes any action at all. */\n  acts: boolean;\n}\n\n/** The players (see the file comment). */\nexport const PLAYERS: Readonly<Record<string, Player>> = Object.freeze({\n  perfect: { name: 'perfect', delay: 0, gain: 3, jitter: 0, timing: 0, acts: true },\n  human: { name: 'human', delay: 15, gain: 1.2, jitter: 0.04, timing: 4, acts: true },\n  sloppy: { name: 'sloppy', delay: 21, gain: 0.8, jitter: 0.06, timing: 8, acts: true },\n  idle: { name: 'idle', delay: 0, gain: 0, jitter: 0, timing: 0, acts: false },\n  mash: { name: 'mash', delay: 0, gain: 0, jitter: 1, timing: 0, acts: true },\n});\n\n/** The player called `name`, or the perfect one. */\nexport const playerOf = (name: string): Player => PLAYERS[name] ?? PLAYERS.perfect;\n\n/** How much lean holds a body still at a place: the model's balance of gain, instability and reach, at defaults. */\nconst FEED_FORWARD = 0.87;\n\n/** The CoB as the player read it `delay` steps ago; pushes the current one into its memory. */\nexport function remembered(seat: Seat, wob: Wobble, delay: number): [number, number] {\n  const hist = seat.hist;\n  hist.push(wob.x, wob.y);\n  const keep = 2 * (delay + 2);\n  if (hist.length > keep) hist.splice(0, hist.length - keep);\n  const at = Math.max(0, hist.length - 2 - 2 * delay);\n  return [hist[at], hist[at + 1]];\n}\n\n/** Writes the lean that steers this body towards `gx, gy`, as `player` would. */\nexport function holdAt(w: GameWorld, seat: Seat, wob: Wobble, gx: number, gy: number, player: Player): void {\n  if (!player.acts) {\n    seat.lx = seat.ly = 0;\n    return;\n  }\n  const [cx, cy] = remembered(seat, wob, player.delay);\n  const jitter = player.jitter;\n  const rng = w.rng('botJitter', seat.index);\n  const jx = jitter > 0 ? rng.range(-jitter, jitter) : 0;\n  const jy = jitter > 0 ? rng.range(-jitter, jitter) : 0;\n  seat.lx = gx * FEED_FORWARD + (gx - cx) * player.gain + jx;\n  seat.ly = gy * FEED_FORWARD + (gy - cy) * player.gain + jy;\n}\n\n/** Writes the breath: holds both feet while the guide fills, lets go while it empties, `lag` steps late. */\nexport function breathe(w: GameWorld, seat: Seat, wob: Wobble, player: Player): void {\n  if (!player.acts) {\n    seat.fl = seat.fr = 0;\n    return;\n  }\n  const period = Math.max(1, Math.round(w.settings.get<number>('game.breath.period') * w.hz));\n  const lag = player.delay;\n  const phase = ((wob.bt - lag + period * 4) % period) / period;\n  const down = phase < 0.5 ? 1 : 0;\n  seat.fl = seat.fr = down;\n}\n\n/** A timing error for one press, in steps, as this player has it; 0 for the perfect one. */\nexport function timingError(w: GameWorld, seat: Seat, player: Player): number {\n  if (player.timing <= 0) return 0;\n  return Math.round(w.rng('botTiming', seat.index).range(-player.timing, player.timing));\n}\n\n/** Random input for a step: the masher. */\nexport function mash(w: GameWorld, seat: Seat): void {\n  const rng = w.rng('botMash', seat.index);\n  if (rng.chance(0.2)) seat.lx = rng.range(-1, 1);\n  if (rng.chance(0.2)) seat.ly = rng.range(-1, 1);\n  if (rng.chance(0.2)) seat.fl = rng.chance(0.5) ? 1 : 0;\n  if (rng.chance(0.2)) seat.fr = rng.chance(0.5) ? 1 : 0;\n  seat.act = rng.chance(0.1);\n}\nEOF\n","description":"Write the settings, components, wobble model and bot players"}}}
