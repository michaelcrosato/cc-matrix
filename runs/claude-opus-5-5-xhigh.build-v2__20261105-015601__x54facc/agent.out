{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NJrSBoyRAMD2qhkKMY2iDa","type":"tool_result","content":"/** How much fog covers a point `depth` metres along the view and `y` high, the focus at view depth `focus` (0..1). */\nexport function fogAt(spec: FogSpec, depth: number, y: number, focus: number): number {\n  const range = smooth(focus + spec.start, focus + spec.end, depth);\n  const height = spec.height * (1 - smooth(spec.floor, spec.ceiling, y)) * smooth(focus, focus + spec.end, depth);\n  return (1 - (1 - range) * (1 - height)) * spec.amount;\n}\n\n/** Makes an atmosphere (fog and ambient light), off until `set` gives it a preset. */\nexport function createAtmosphere(): Atmosphere {\n  const ambient = new HemisphereLight('#ffffff', '#000000', 0);\n    floor: number(0),\n    ceiling: number(1),\n    height: number(0),\n  };\n  const depth = positionView.z.negate();\n  const range = smoothstep(u.near, u.far, depth);\n  const low = float(1).sub(smoothstep(u.floor, u.ceiling, positionWorld.y));\n  const height = u.height.mul(low).mul(smoothstep(u.focus, u.far, depth));\n  const factor = float(1)\n    .sub(float(1).sub(range).mul(float(1).sub(height)))\n    .mul(u.amount);\n  const fogNode = fog(u.color, factor);\n  let scene: Scene | null = null;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"98b2e1ff-5b5f-4467-98fa-ccf019a1c7c3","timestamp":"2026-11-05T10:36:10.716Z","tool_use_result":{"stdout":"/** How much fog covers a point `depth` metres along the view and `y` high, the focus at view depth `focus` (0..1). */\nexport function fogAt(spec: FogSpec, depth: number, y: number, focus: number): number {\n  const range = smooth(focus + spec.start, focus + spec.end, depth);\n  const height = spec.height * (1 - smooth(spec.floor, spec.ceiling, y)) * smooth(focus, focus + spec.end, depth);\n  return (1 - (1 - range) * (1 - height)) * spec.amount;\n}\n\n/** Makes an atmosphere (fog and ambient light), off until `set` gives it a preset. */\nexport function createAtmosphere(): Atmosphere {\n  const ambient = new HemisphereLight('#ffffff', '#000000', 0);\n    floor: number(0),\n    ceiling: number(1),\n    height: number(0),\n  };\n  const depth = positionView.z.negate();\n  const range = smoothstep(u.near, u.far, depth);\n  const low = float(1).sub(smoothstep(u.floor, u.ceiling, positionWorld.y));\n  const height = u.height.mul(low).mul(smoothstep(u.focus, u.far, depth));\n  const factor = float(1)\n    .sub(float(1).sub(range).mul(float(1).sub(height)))\n    .mul(u.amount);\n  const fogNode = fog(u.color, factor);\n  let scene: Scene | null = null;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NJrSBoyRAMD2qhkKMY2iDa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
