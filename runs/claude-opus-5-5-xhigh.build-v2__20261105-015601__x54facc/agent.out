e is scaled to nothing; an `InstancedMesh` with no instances gets one, at zero scale; every\n * object in the scene is drawn without frustum culling, so what is behind the camera is built too. All of it is put\n * back afterwards, in reverse order. Carried from `my-3d2dge:src/stress-world/50-frame.js:29-47` (`warmUp()`) as the\n * idea for a registry. What a page's warm-ups compile is the view setting `gfx.warmUp` (`WARMUP_SETTINGS`).\n *\n * Invariants: one warm-up runs at a time (a second `run` returns the first's promise); entries and key parts are kept\n * in id order; the report counts the pipelines this warm-up built (counted at the device, engine/gfx/pipelines.ts).\n *\n * @example\n * // const warmup = createWarmup({ renderer, counter: countPipelines(device) });\n * // warmup.register('pool:sparks', { objects: () => [sparks.mesh] });\n * // const report = await warmup.run({ scene, camera }, { onProgress: ({ done, total }) => bar(done / total) });\n * @see tests/e2e/renderer.spec.ts\n * @see engine/gfx/warmup.test.ts\n */\nimport {\n  ColorManagement,\n  Matrix4,\n  RenderTarget,\n  type Camera,\n  type ColorSpace,\n  type InstancedMesh,\n  type Object3D,\n  type Scene,\n  type WebGPURenderer,\n} from 'three/webgpu';\n86:export const warmsAsked = (settings: { get(path: string): unknown }): boolean => settings.get('gfx.warmUp') === 'asked';\n87-\n88-/** What a pool or batch registers: the objects it may show, each made drawable for the warm-up. */\n89-export interface WarmupEntry {\n90-  objects(): readonly Object3D[];\n91-}\n92-\n93-/** One way a frame draws the scene: into a render target, with the renderer set up for it. */\n94-export interface WarmupPass {\n95-  /** The render target (a post pass's `renderTarget`); what `render()` draws into when left out. */\n96-  target?: RenderTarget | null;\nengine/app/headless.ts:43:import { createSettings, defineSettings, type SettingValue } from '../core/settings';\nengine/app/headless.ts:182:  if (!timed) defineSettings(TIME_SETTINGS, registry); // the clock reads them: a test registry may lack them\nengine/gfx/stageFx.ts:46:import { defineSettings } from '../core/settings';\nengine/gfx/stageFx.ts:56:export const STAGE_FX_SETTINGS = defineSettings({\nengine/gfx/stageFx.ts:57:  'gfx.effects': {\nengine/gfx/resolution.ts:40:import { createSettings, defineSettings, type Settings } from '../core/settings';\nengine/gfx/resolution.ts:59:  'gfx.resolution': {\nengine/gfx/resolution.ts:68:defineSettings(RESOLUTION_SETTINGS);\nengine/gfx/resolution.ts:193:      const asked = settings.get<ResolutionSetting>('gfx.resolution');\nengine/app/view.ts:188:    const declared = registry.kinds().includes('setting') && registry.has('setting', 'gfx.effects');\nengine/app/view.ts:189:    const enabled = !declared || run.settings.get<boolean>('gfx.effects') !== false;\nengine/app/engine.ts:367:      parts.governor!.freeze((playback !== null && !playback.done) || !settingsNow.get<boolean>('gfx.governor'));\nengine/gfx/warmup.ts:53:import { defineSettings } from '../core/settings';\nengine/gfx/warmup.ts:74:  'gfx.warmUp': {\nengine/gfx/warmup.ts:83:defineSettings(WARMUP_SETTINGS);\nengine/gfx/warmup.ts:86:export const warmsAsked = (settings: { get(path: string): unknown }): boolean => settings.get('gfx.warmUp') === 'ask\nengine/gfx/quality.ts:25:import { defineSettings } from '../core/settings';\nengine/gfx/quality.ts:47:defineSettings(QUALITY_SETTINGS);\nengine/gfx/features.ts:37:import { createSettings, defineSettings, type Settings } from '../core/settings';\nengine/gfx/features.ts:112:  'gfx.featuresOff': {\n  function drawOf(id: string) {\n    const prop = getProp(id, registry);\n    let draw = draws.get(prop.id);\n    if (!draw) {\n      draw = { prop, parts: prop.parts.map((part) => partDraw(prop, part)), drawn: 0 };\n      draws.set(prop.id, draw);\n    }\n    return draw;\n  }\n\n  /** The phase (s) of the prop `id` named `key`: drawn once from its visual stream. */\n  function phaseOf(id: string, key: string | number): number {\n    const name = `${id}#${key}`;\n    let phase = phases.get(name);\n    if (phase === undefined) phases.set(name, (phase = fx('prop', id, key).range(0, 9)));\n    return phase;\n  }\n\n  for (const id of options.props ?? registry.list('prop').map((entry) => entry.id)) drawOf(id);\n\n  const props: PropMeshes = {\n    root,\n    batches: () => [...draws.values()].flatMap((draw) => draw.parts.map((part) => part.batch)),\n    begin(t) {\n      time = t;\n      lights = [];\n      for (const draw of draws.values()) {\n        draw.drawn = 0;\n        for (const { batch } of draw.parts) batch.begin();\n      }\n    },\n    add(id, { position, rotation, on = true }, key) {\n      const draw = drawOf(id);\n      const { prop } = draw;\n      const name = key ?? draw.drawn;\n      draw.drawn++;\n      if (Array.isArray(position)) place.fromArray(position);\n      else place.copy(position as Vector3);\n      if (!rotation) turn.identity();\n      else if (Array.isArray(rotation)) turn.fromArray(rotation);\n      else turn.copy(rotation as Quaternion);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RjCMobQ4ZNh5HiFuqCAF6C","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
