no layers draws no backdrop.', {\n3: * ambient light, the fog, the backdrop's layers and how bright the light pool's point lights shine), `defineSky` for\n59:  backdrop: group('Silhouettes round the horizon, far layers first; no layers draws no backdrop.', {\n60:    haze: text('The colour hazed layers fade toward, hex.', '#c8e4f8'),\n62:    layers: {\n65:      description: 'The layers, far to near.',\n69:          kind: { type: 'string', enum: BACKDROP_KINDS, required: true, description: 'Its silhouette.' },\n83:/** What `defineSky` takes: any of the fields, and any of a nested object's (a backdrop's layers whole). */\n122:      layers: [\n123:        { kind: 'mountains', color: '#7a98c8', height: 0.95, haze: 0.45, seed: 3 },\n124:        { kind: 'hills', color: '#5aa060', height: 0.5, haze: 0.25, seed: 7 },","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RHroCUZfMPHG8AQgsBZ71C","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjXuzsnWwvDSWCkJdBYG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KmAVHDi3EU3awPk9DVp9V9","name":"Bash","input":{"command":"sed -n 25,125p engine/gfx/geometry/builtins.ts | grep -E \"^\\s+(width|height|depth|radius[A-Za-z]*|segments|innerRadius|outerRadius|length|.*: \\{ type)\" | cut -c1-120 | head -40; cat > labs/game/materials/retreat.ts <<'EOF'\n/**\n * @file Teeter Fit's materials: the brochure palette as data. Clinical white, mint, sand, lawn and a sea that drifts.\n * Materials are page-side; props name them by id.\n *\n * Game code, a page's.\n *\n * @example\n * // 'material:lawn' on the terrain's high layer.\n */\nimport { defineMaterial } from '../../../engine';\n\n/** A plain coloured material. */\nconst flat = (id: string, color: string, roughness = 0.8, more: object = {}) =>\n  defineMaterial(id, { description: `Plain ${id.split(':')[1]}.`, color, roughness, ...more });\n\ndefineMaterial('material:sand', {\n  description: 'Pale shore sand, the low ground.',\n  color: '#ffffff',\n  map: { texture: 'texture:dirt', seed: 4, params: { base: '#f4e8c8', dark: '#e6d6ac' } },\n  roughness: 1,\n});\ndefineMaterial('material:lawn', {\n  description: 'Tidy lawn, the upland ground.',\n  color: '#ffffff',\n  map: { texture: 'texture:grass', seed: 5, params: { base: '#a9d98a', dark: '#93c776' } },\n  roughness: 1,\n});\ndefineMaterial('material:seawater', {\n  description: 'The brochure sea: a baked ripple on a flat prop that drifts.',\n  color: '#ffffff',\n  map: { texture: 'texture:water', seed: 2, params: { base: '#6fd0e8' } },\n  roughness: 0.25,\n});\ndefineMaterial('material:clinical', {\n  description: 'Painted white plaster, the retreat itself.',\n  color: '#ffffff',\n  map: { texture: 'texture:plaster', seed: 8, params: { plaster: '#f7fafc', shade: '#e8eef2' } },\n  roughness: 0.7,\n});\ndefineMaterial('material:deck', {\n  description: 'Bleached decking, pier and jetty.',\n  color: '#efe2c8',\n  map: { texture: 'texture:planks', seed: 7 },\n  roughness: 0.9,\n});\ndefineMaterial('material:floorWhite', {\n  description: 'The pavilion floor.',\n  color: '#ffffff',\n  map: { texture: 'texture:tiles', seed: 3 },\n  roughness: 0.5,\n});\nflat('material:mint', '#bfead6');\nflat('material:mintDeep', '#8fd6b8');\nflat('material:skyPale', '#bfe9ff');\nflat('material:coral', '#ff8a70');\nflat('material:slate', '#3a4a55');\nflat('material:white', '#f7fafc', 0.6);\nflat('material:sandstone', '#e6d6ac');\nflat('material:rock', '#a7a9a4', 1);\nflat('material:rockDark', '#7e8580', 1);\nflat('material:palmTrunk', '#b9976c', 1);\nflat('material:palmLeaf', '#6dbb6a', 1);\nflat('material:rope', '#c9b79a', 1);\nflat('material:brass', '#d9b45a', 0.35, { metalness: 0.6 });\nflat('material:mirror', '#d6eaf3', 0.08, { metalness: 0.9 });\nflat('material:curtain', '#f2f7f8', 1, { side: 'double' });\nflat('material:marble', '#fbfdff', 0.15);\nflat('material:marbleRed', '#ff8a70', 0.2);\nflat('material:marbleBlue', '#5db6e8', 0.2);\nflat('material:rakedSand', '#f4e8c8', 1);\nflat('material:ridge', '#d9c79a', 1);\nflat('material:hole', '#5a4d3a', 1);\nflat('material:tray', '#d9c8a8', 0.9);\nflat('material:ferry', '#f7fafc', 0.5);\nflat('material:ferryTrim', '#3b82f6', 0.5);\nflat('material:board', '#ffd6a0', 0.5);\nflat('material:buoy', '#ff8a70', 0.4);\nflat('material:buoyWhite', '#ffffff', 0.4);\nflat('material:hoop', '#ffb46e', 0.5);\nflat('material:hoop2', '#7fd6c0', 0.5);\nflat('material:glassDrink', '#fff3d6', 0.2, { transparent: true, opacity: 0.8 });\nflat('material:cart', '#8a96a0', 0.6, { metalness: 0.3 });\nflat('material:card', '#ffffff', 0.9);\nflat('material:wet', '#ffffff', 0.4, { emissive: '#bfe9ff', emissiveIntensity: 0.4 });\nflat('material:ringGlow', '#ff8a70', 0.5, { emissive: '#ff8a70', emissiveIntensity: 1.2 });\nflat('material:tileLit', '#ffe0a0', 0.5, { emissive: '#ffb46e', emissiveIntensity: 0.9 });\nflat('material:beam', '#fff6c8', 1, { unlit: true, transparent: true, opacity: 0.32, side: 'double' });\nfor (const [name, color] of [['red', '#e8443a'], ['blue', '#3b82f6'], ['green', '#22c55e'], ['gold', '#f5b700'], ['plain', '#bfead6']] as const) {\n  flat(`material:mat.${name}`, color, 0.95);\n}\nfor (let i = 0; i < 6; i++) flat(`material:stone${i}`, ['#c9ced1', '#b7bdb9', '#e0dcd2', '#a9b4b8', '#d4cdbe', '#bfc7cc'][i], 1);\nEOF\ncat > labs/game/looks/retreat.ts <<'EOF'\n/**\n * @file The picture: `look:retreat`, high-key brochure daylight (PLAN.md section 10), its skies (day, dawn, dusk, storm,\n * none with a silhouette backdrop: the sea horizon stays empty), and `look:storm`, which drains the colour.\n *\n * Game code, a page's.\n *\n * @example\n * // ?post.look=look:retreat\n */\nimport { defineLook, defineSky } from '../../../engine';\n\n/** No backdrop: an empty sea horizon. */\nconst NO_BACKDROP = { haze: '#c8e4f8', tint: '#ffffff', layers: [] };\n\ndefineSky('sky:retreat', {\n  description: 'Brochure noon: a clear dome, a high sun, an empty horizon.',\n  background: '#bfe9ff',\n  dome: { show: true, turbidity: 2, rayleigh: 1, mieCoefficient: 0.005, mieDirectionalG: 0.8, exposure: 0.5 },\n  sun: { color: '#fff0d8', intensity: 2.6, azimuth: 0.6, elevation: 0.95 },\n  ambient: { sky: '#d8e6ff', ground: '#8a8370', intensity: 1.8 },\n  fog: { color: '#d8ecf6', start: 110, end: 520, amount: 0.5, floor: 0, ceiling: 1.5, height: 0 },\n  backdrop: NO_BACKDROP,\n} as never);\ndefineSky('sky:retreatDawn', {\n  description: 'Dawn after the storm: pale gold on a glass sea.',\n  background: '#ffe9cf',\n  dome: { show: true, turbidity: 4, rayleigh: 2, mieCoefficient: 0.01, mieDirectionalG: 0.85, exposure: 0.42 },\n  sun: { color: '#ffd9a8', intensity: 2, azimuth: 1.5, elevation: 0.18 },\n  ambient: { sky: '#ffe6cc', ground: '#8a7a68', intensity: 1.6 },\n  fog: { color: '#ffe9d2', start: 80, end: 420, amount: 0.6, floor: 0, ceiling: 1.5, height: 0 },\n  backdrop: NO_BACKDROP,\n} as never);\ndefineSky('sky:retreatDusk', {\n  description: 'Evening: a low warm sun, the huts catching it.',\n  background: '#f6c9a8',\n  dome: { show: true, turbidity: 6, rayleigh: 2.4, mieCoefficient: 0.01, mieDirectionalG: 0.85, exposure: 0.38 },\n  sun: { color: '#ffb98a', intensity: 1.7, azimuth: -1.4, elevation: 0.14 },\n  ambient: { sky: '#e4c8d8', ground: '#7a6a60', intensity: 1.3 },\n  fog: { color: '#f4ccb0', start: 70, end: 360, amount: 0.6, floor: 0, ceiling: 1.5, height: 0 },\n  backdrop: NO_BACKDROP,\n} as never);\ndefineSky('sky:storm', {\n  description: 'The Great Tilt: slate cloud, low light, close fog.',\n  background: '#39444f',\n  dome: { show: false },\n  sun: { color: '#b8c4d0', intensity: 1, azimuth: 0.6, elevation: 0.8 },\n  ambient: { sky: '#7f8e9c', ground: '#3a4148', intensity: 1.2 },\n  fog: { color: '#46525e', start: 30, end: 190, amount: 0.9, floor: 0, ceiling: 1.5, height: 0 },\n  backdrop: NO_BACKDROP,\n} as never);\n\n/** The look's filters, shared. */\nconst FILTERS = {\n  bloom: { scope: 'all', strength: 0.35, threshold: 0.92 },\n  grade: { scope: 'all', brightness: 1.08, saturation: 0.92, lift: 0.03 },\n  outline: { scope: 'characters+objects', width: 1, darken: 0.25 },\n};\n\ndefineLook('look:retreat', {\n  description: 'High-key brochure daylight: soft toon light, a little bloom, a thin ink line on people and things.',\n  sky: 'sky:retreat',\n  style: 'toon',\n  filters: FILTERS,\n} as never);\ndefineLook('look:retreatDawn', {\n  description: 'Dawn over glass.',\n  sky: 'sky:retreatDawn',\n  style: 'toon',\n  filters: FILTERS,\n} as never);\ndefineLook('look:retreatDusk', {\n  description: 'Evening on the island.',\n  sky: 'sky:retreatDusk',\n  style: 'toon',\n  filters: FILTERS,\n} as never);\ndefineLook('look:storm', {\n  description: 'The storm: the colour drained out of the brochure.',\n  sky: 'sky:storm',\n  style: 'toon',\n  filters: {\n    bloom: { scope: 'all', strength: 0.2, threshold: 0.9 },\n    grade: { scope: 'all', brightness: 0.86, saturation: 0.45, lift: 0.01 },\n    outline: { scope: 'characters+objects', width: 1, darken: 0.35 },\n  },\n} as never);\nEOF\ncat > labs/game/bodies/cast.ts <<'EOF'\n/**\n * @file The cast's bodies (PLAN.md section 10), as data on the humanoid's bones. Each Guest look comes in every tracksuit\n * colour, and each seat colour; Plumb also comes with open eyes, for the one time they open them; Tare is a round dial\n * on two stubby legs with no arms.\n *\n * Game code, a page's: the sim names bodies by id.\n *\n * @example\n * // 'body:guest1.teal', 'body:plumb', 'body:tare'\n */\nimport { defineBody } from '../../../engine';\nimport { COLORS, SEAT_COLORS } from '../cast/roster';\n\n/** The tracksuit palettes, by colour name. */\nexport const SUITS: Readonly<Record<string, readonly [string, string]>> = {\n  coral: ['#ff8a70', '#fff4ec'],\n  teal: ['#3fb7a6', '#eafff8'],\n  plum: ['#9a7bc0', '#f3ecff'],\n  sun: ['#f2c14e', '#fff8e0'],\n  sky: ['#6fb9e8', '#eef8ff'],\n  forest: ['#5d9f6a', '#eef8ec'],\n  red: ['#e8443a', '#ffe6e3'],\n  blue: ['#3b82f6', '#e6efff'],\n  green: ['#22c55e', '#e3fff0'],\n  gold: ['#f5b700', '#fff6d6'],\n};\n\n/** Skin and hair per look. */\nconst LOOKS: readonly { skin: string; hair: string }[] = [\n  { skin: '#f0c4a0', hair: '#5a4034' },\n  { skin: '#b57e58', hair: '#231c1a' },\n  { skin: '#e6b48a', hair: '#c48a44' },\n];\n\n/** The torso and limbs everyone but Tare shares. */\nconst FRAME = [\n  ['limb', 'thighL', 'thighR', [1.25, 'limb'], [1.25, 'limb'], 'suit', { on: 'pelvis' }],\n  ['limb', ['off', 'spine0', 0, 0, 0.05], 'chest', [0.58, 'torso'], [0.62, 'torso'], 'suit', { on: 'spine1' }],\n  ['limb', 'chest', 'neck', [0.62, 'torso'], [0.5, 'torso'], 'trim'],\n  ['limb', 'neck', 'head', [0.7, 'limb'], [0.7, 'limb'], 'skin'],\n  ['limb', 'upperArmL', 'upperArmR', [1.1, 'limb'], [1.1, 'limb'], 'suit', { on: 'chest' }],\n];\n\n/** The limbs, written for the left. */\nconst LIMBS = [\n  ['limb', 'thighL', 'shinL', [1.3, 'limb'], [1.05, 'limb'], 'suit'],\n  ['limb', 'shinL', 'footL', [1.05, 'limb'], [0.85, 'limb'], 'suit'],\n  ['limb', 'footL', 'toeL', [1, 'limb'], [0.85, 'limb'], 'shoe'],\n  ['limb', 'upperArmL', 'forearmL', [1.05, 'limb'], [0.9, 'limb'], 'suit'],\n  ['limb', 'forearmL', 'handL', [0.9, 'limb'], [0.8, 'limb'], 'skin'],\n];\n\n/** Defines one Guest's body. */\nfunction guest(look: number, colorName: string): void {\n  const [suit, trim] = SUITS[colorName];\n  const { skin, hair } = LOOKS[look];\n  const hairParts = [\n    [['ball', ['off', 'head', -0.02, 0, [1.1, 'head']], [0.95, 'head'], 'hair']],\n    [['ball', ['off', 'head', -0.03, 0, [1.05, 'head']], [0.93, 'head'], 'hair'], ['ball', ['off', 'head', -0.03, 0, [2.05, 'head']], [0.42, 'head'], 'hair']],\n    [['ball', ['off', 'head', 0, 0, [1.25, 'head']], [0.92, 'head'], 'hair'], ['limb', ['off', 'head', [0.8, 'head'], -0.07, [1.5, 'head']], ['off', 'head', [0.8, 'head'], 0.07, [1.5, 'head']], 0.025, 0.025, 'trim']],\n  ][look];\n  defineBody(`body:guest${look}.${colorName}`, {\n    description: `A guest of Little Fulcrum: look ${look}, in a ${colorName} tracksuit.`,\n    slots: { skin, suit, trim, hair, shoe: '#f7fafc', eye: '#2a3036' },\n    parts: [...FRAME, ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'], ...hairParts],\n    mirror: [...LIMBS, ['eye', 'eyeL', [0.1, 'head'], 'eye']],\n    build: `build:guest${look}`,\n  } as never);\n}\n\nfor (let look = 0; look < 3; look++) {\n  for (const color of [...COLORS, ...SEAT_COLORS]) guest(look, color);\n}\n\n/** Plumb: tall, narrow, utterly vertical; pale mint tracksuit; eyes closed in two calm arcs. */\nfunction plumb(id: string, open: boolean): void {\n  defineBody(id, {\n    description: open ? 'Instructor Plumb, once, with open eyes.' : 'Instructor Plumb: mint tracksuit, eyes closed in two calm arcs.',\n    slots: { skin: '#eccdb0', suit: '#bfead6', trim: '#f7fafc', hair: '#3a4a55', shoe: '#f7fafc', eye: '#3a4a55' },\n    parts: [...FRAME, ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.95, 'head'], 'skin'], ['ball', ['off', 'head', -0.012, 0, [1.28, 'head']], [0.86, 'head'], 'hair']],\n    mirror: [\n      ...LIMBS,\n      open\n        ? ['eye', 'eyeL', [0.16, 'head'], 'eye']\n        : ['curve', ['off', 'eyeL', 0.005, -0.03, 0], ['off', 'eyeL', 0.005, 0.03, 0], -0.5, 0.008, 0.008, 'eye', { on: 'head' }],\n    ],\n    limbRadius: 0.05,\n    torsoRadius: 0.14,\n    build: 'build:plumb',\n  } as never);\n}\nplumb('body:plumb', false);\nplumb('body:plumbOpen', true);\n\ndefineBody('body:gerald', {\n  description: 'Gerald: a retired guest with immense calves, always already there.',\n  slots: { skin: '#e8b48c', suit: '#7a8fa6', trim: '#e6e6e0', hair: '#e8e8e4', shoe: '#6c5840', eye: '#2a3036', shorts: '#5c6e80' },\n  parts: [\n    ['limb', 'thighL', 'thighR', [1.5, 'limb'], [1.5, 'limb'], 'shorts', { on: 'pelvis' }],\n    ['limb', ['off', 'spine0', 0, 0, 0.05], 'chest', [0.66, 'torso'], [0.66, 'torso'], 'suit', { on: 'spine1' }],\n    ['limb', 'chest', 'neck', [0.62, 'torso'], [0.5, 'torso'], 'suit'],\n    ['limb', 'neck', 'head', [0.8, 'limb'], [0.8, 'limb'], 'skin'],\n    ['limb', 'upperArmL', 'upperArmR', [1.2, 'limb'], [1.2, 'limb'], 'suit', { on: 'chest' }],\n    ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'],\n    ['ball', ['off', 'head', -0.03, 0, [1.3, 'head']], [0.72, 'head'], 'hair'],\n    ['limb', ['off', 'head', [0.86, 'head'], -0.05, [0.72, 'head']], ['off', 'head', [0.86, 'head'], 0.05, [0.72, 'head']], 0.018, 0.018, 'hair'],\n  ],\n  mirror: [\n    ['limb', 'thighL', 'shinL', [1.45, 'limb'], [1.3, 'limb'], 'shorts'],\n    ['ball', ['lerp', 'shinL', 'footL', 0.32], [2.5, 'limb'], 'skin', { on: 'shinL' }],\n    ['limb', 'shinL', 'footL', [1.5, 'limb'], [0.85, 'limb'], 'skin'],\n    ['limb', 'footL', 'toeL', [1, 'limb'], [0.85, 'limb'], 'shoe'],\n    ['limb', 'upperArmL', 'forearmL', [1.1, 'limb'], [0.95, 'limb'], 'skin'],\n    ['limb', 'forearmL', 'handL', [0.95, 'limb'], [0.85, 'limb'], 'skin'],\n    ['eye', 'eyeL', [0.1, 'head'], 'eye'],\n  ],\n  build: 'build:gerald',\n} as never);\n\ndefineBody('body:bex', {\n  description: 'Bex: a bored teenager in a hoodie, holding a phone-shaped stone, annoyingly excellent.',\n  slots: { skin: '#c8966c', suit: '#54576a', trim: '#9a9fb0', hair: '#201c26', shoe: '#e8444a', eye: '#2a3036', stone: '#a7a9a4' },\n  parts: [\n    ...FRAME,\n    ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'],\n    ['ball', ['off', 'head', -0.04, 0.02, [1.2, 'head']], [0.94, 'head'], 'hair'],\n    ['box', ['off', 'weaponR', 0, 0, -0.02], ['off', 'weaponR', 0, 0, 0.12], 0.07, 0.02, 'stone', { on: 'handR' }],\n  ],\n  mirror: [...LIMBS, ['eye', 'eyeL', [0.1, 'head'], 'eye']],\n  build: 'build:bex',\n} as never);\n\ndefineBody('body:nan', {\n  description: 'Old Nan: 91, Wobble Age 19, small, in a cardigan.',\n  slots: { skin: '#eccab0', suit: '#c9a0a8', trim: '#f7f2ec', hair: '#f0f0f0', shoe: '#7a6a5a', eye: '#2a3036' },\n  parts: [\n    ...FRAME,\n    ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.92, 'head'], 'skin'],\n    ['ball', ['off', 'head', -0.02, 0, [1.25, 'head']], [0.86, 'head'], 'hair'],\n    ['ball', ['off', 'head', -0.03, 0, [2.05, 'head']], [0.4, 'head'], 'hair'],\n  ],\n  mirror: [...LIMBS, ['eye', 'eyeL', [0.1, 'head'], 'eye']],\n  limbRadius: 0.04,\n  torsoRadius: 0.13,\n  build: 'build:nan',\n} as never);\n\ndefineBody('body:tare', {\n  description: 'Tare: a squat round dial bathroom scale on two stubby legs, its face in the dial. Retired from weighing.',\n  slots: { shell: '#e8eef2', dial: '#fdfefe', rim: '#9aa8b2', needle: '#ff8a70', leg: '#c9d3da', eye: '#2a3036' },\n  parts: [\n    ['ball', ['off', 'chest', 0, 0, -0.02], [0.36, 0.36, 0.16], 'shell', { on: 'spine1' }],\n    ['ball', ['off', 'chest', 0.09, 0, -0.02], [0.29, 0.29, 0.1], 'rim', { on: 'spine1' }],\n    ['ball', ['off', 'chest', 0.125, 0, -0.02], [0.255, 0.255, 0.075], 'dial', { on: 'spine1' }],\n    ['limb', ['off', 'chest', 0.2, 0, -0.1], ['off', 'chest', 0.2, 0.09, 0.04], 0.012, 0.006, 'needle', { on: 'spine1' }],\n    ['ball', ['off', 'chest', 0.2, 0, -0.1], 0.024, 'needle', { on: 'spine1' }],\n  ],\n  mirror: [\n    ['limb', 'thighL', 'footL', 0.05, 0.05, 'leg'],\n    ['ball', ['off', 'footL', 0.03, 0, 0.0], [0.07, 0.04, 0.1], 'leg', { on: 'footL' }],\n    ['eye', ['off', 'chest', 0.2, -0.08, 0.1], 0.025, 'eye', { on: 'spine1' }],\n  ],\n  build: 'build:tare',\n} as never);\nEOF\n","description":"Write materials, skies, looks and cast bodies"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3540,"cache_read_input_tokens":324549,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3540},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"89e0a215-7499-4436-8bc7-7663dc31b45e","timestamp":"2026-11-05T09:21:24.161Z","request_id":"req_011CgjXuzbf9BhM1efFTQriK","wire_tool_inputs":{"toolu_01KmAVHDi3EU3awPk9DVp9V9":{"command":"sed -n 25,125p engine/gfx/geometry/builtins.ts | grep -E \"^\\s+(width|height|depth|radius[A-Za-z]*|segments|innerRadius|outerRadius|length|.*: \\{ type)\" | cut -c1-120 | head -40; cat > labs/game/materials/retreat.ts <<'EOF'\n/**\n * @file Teeter Fit's materials: the brochure palette as data. Clinical white, mint, sand, lawn and a sea that drifts.\n * Materials are page-side; props name them by id.\n *\n * Game code, a page's.\n *\n * @example\n * // 'material:lawn' on the terrain's high layer.\n */\nimport { defineMaterial } from '../../../engine';\n\n/** A plain coloured material. */\nconst flat = (id: string, color: string, roughness = 0.8, more: object = {}) =>\n  defineMaterial(id, { description: `Plain ${id.split(':')[1]}.`, color, roughness, ...more });\n\ndefineMaterial('material:sand', {\n  description: 'Pale shore sand, the low ground.',\n  color: '#ffffff',\n  map: { texture: 'texture:dirt', seed: 4, params: { base: '#f4e8c8', dark: '#e6d6ac' } },\n  roughness: 1,\n});\ndefineMaterial('material:lawn', {\n  description: 'Tidy lawn, the upland ground.',\n  color: '#ffffff',\n  map: { texture: 'texture:grass', seed: 5, params: { base: '#a9d98a', dark: '#93c776' } },\n  roughness: 1,\n});\ndefineMaterial('material:seawater', {\n  description: 'The brochure sea: a baked ripple on a flat prop that drifts.',\n  color: '#ffffff',\n  map: { texture: 'texture:water', seed: 2, params: { base: '#6fd0e8' } },\n  roughness: 0.25,\n});\ndefineMaterial('material:clinical', {\n  description: 'Painted white plaster, the retreat itself.',\n  color: '#ffffff',\n  map: { texture: 'texture:plaster', seed: 8, params: { plaster: '#f7fafc', shade: '#e8eef2' } },\n  roughness: 0.7,\n});\ndefineMaterial('material:deck', {\n  description: 'Bleached decking, pier and jetty.',\n  color: '#efe2c8',\n  map: { texture: 'texture:planks', seed: 7 },\n  roughness: 0.9,\n});\ndefineMaterial('material:floorWhite', {\n  description: 'The pavilion floor.',\n  color: '#ffffff',\n  map: { texture: 'texture:tiles', seed: 3 },\n  roughness: 0.5,\n});\nflat('material:mint', '#bfead6');\nflat('material:mintDeep', '#8fd6b8');\nflat('material:skyPale', '#bfe9ff');\nflat('material:coral', '#ff8a70');\nflat('material:slate', '#3a4a55');\nflat('material:white', '#f7fafc', 0.6);\nflat('material:sandstone', '#e6d6ac');\nflat('material:rock', '#a7a9a4', 1);\nflat('material:rockDark', '#7e8580', 1);\nflat('material:palmTrunk', '#b9976c', 1);\nflat('material:palmLeaf', '#6dbb6a', 1);\nflat('material:rope', '#c9b79a', 1);\nflat('material:brass', '#d9b45a', 0.35, { metalness: 0.6 });\nflat('material:mirror', '#d6eaf3', 0.08, { metalness: 0.9 });\nflat('material:curtain', '#f2f7f8', 1, { side: 'double' });\nflat('material:marble', '#fbfdff', 0.15);\nflat('material:marbleRed', '#ff8a70', 0.2);\nflat('material:marbleBlue', '#5db6e8', 0.2);\nflat('material:rakedSand', '#f4e8c8', 1);\nflat('material:ridge', '#d9c79a', 1);\nflat('material:hole', '#5a4d3a', 1);\nflat('material:tray', '#d9c8a8', 0.9);\nflat('material:ferry', '#f7fafc', 0.5);\nflat('material:ferryTrim', '#3b82f6', 0.5);\nflat('material:board', '#ffd6a0', 0.5);\nflat('material:buoy', '#ff8a70', 0.4);\nflat('material:buoyWhite', '#ffffff', 0.4);\nflat('material:hoop', '#ffb46e', 0.5);\nflat('material:hoop2', '#7fd6c0', 0.5);\nflat('material:glassDrink', '#fff3d6', 0.2, { transparent: true, opacity: 0.8 });\nflat('material:cart', '#8a96a0', 0.6, { metalness: 0.3 });\nflat('material:card', '#ffffff', 0.9);\nflat('material:wet', '#ffffff', 0.4, { emissive: '#bfe9ff', emissiveIntensity: 0.4 });\nflat('material:ringGlow', '#ff8a70', 0.5, { emissive: '#ff8a70', emissiveIntensity: 1.2 });\nflat('material:tileLit', '#ffe0a0', 0.5, { emissive: '#ffb46e', emissiveIntensity: 0.9 });\nflat('material:beam', '#fff6c8', 1, { unlit: true, transparent: true, opacity: 0.32, side: 'double' });\nfor (const [name, color] of [['red', '#e8443a'], ['blue', '#3b82f6'], ['green', '#22c55e'], ['gold', '#f5b700'], ['plain', '#bfead6']] as const) {\n  flat(`material:mat.${name}`, color, 0.95);\n}\nfor (let i = 0; i < 6; i++) flat(`material:stone${i}`, ['#c9ced1', '#b7bdb9', '#e0dcd2', '#a9b4b8', '#d4cdbe', '#bfc7cc'][i], 1);\nEOF\ncat > labs/game/looks/retreat.ts <<'EOF'\n/**\n * @file The picture: `look:retreat`, high-key brochure daylight (PLAN.md section 10), its skies (day, dawn, dusk, storm,\n * none with a silhouette backdrop: the sea horizon stays empty), and `look:storm`, which drains the colour.\n *\n * Game code, a page's.\n *\n * @example\n * // ?post.look=look:retreat\n */\nimport { defineLook, defineSky } from '../../../engine';\n\n/** No backdrop: an empty sea horizon. */\nconst NO_BACKDROP = { haze: '#c8e4f8', tint: '#ffffff', layers: [] };\n\ndefineSky('sky:retreat', {\n  description: 'Brochure noon: a clear dome, a high sun, an empty horizon.',\n  background: '#bfe9ff',\n  dome: { show: true, turbidity: 2, rayleigh: 1, mieCoefficient: 0.005, mieDirectionalG: 0.8, exposure: 0.5 },\n  sun: { color: '#fff0d8', intensity: 2.6, azimuth: 0.6, elevation: 0.95 },\n  ambient: { sky: '#d8e6ff', ground: '#8a8370', intensity: 1.8 },\n  fog: { color: '#d8ecf6', start: 110, end: 520, amount: 0.5, floor: 0, ceiling: 1.5, height: 0 },\n  backdrop: NO_BACKDROP,\n} as never);\ndefineSky('sky:retreatDawn', {\n  description: 'Dawn after the storm: pale gold on a glass sea.',\n  background: '#ffe9cf',\n  dome: { show: true, turbidity: 4, rayleigh: 2, mieCoefficient: 0.01, mieDirectionalG: 0.85, exposure: 0.42 },\n  sun: { color: '#ffd9a8', intensity: 2, azimuth: 1.5, elevation: 0.18 },\n  ambient: { sky: '#ffe6cc', ground: '#8a7a68', intensity: 1.6 },\n  fog: { color: '#ffe9d2', start: 80, end: 420, amount: 0.6, floor: 0, ceiling: 1.5, height: 0 },\n  backdrop: NO_BACKDROP,\n} as never);\ndefineSky('sky:retreatDusk', {\n  description: 'Evening: a low warm sun, the huts catching it.',\n  background: '#f6c9a8',\n  dome: { show: true, turbidity: 6, rayleigh: 2.4, mieCoefficient: 0.01, mieDirectionalG: 0.85, exposure: 0.38 },\n  sun: { color: '#ffb98a', intensity: 1.7, azimuth: -1.4, elevation: 0.14 },\n  ambient: { sky: '#e4c8d8', ground: '#7a6a60', intensity: 1.3 },\n  fog: { color: '#f4ccb0', start: 70, end: 360, amount: 0.6, floor: 0, ceiling: 1.5, height: 0 },\n  backdrop: NO_BACKDROP,\n} as never);\ndefineSky('sky:storm', {\n  description: 'The Great Tilt: slate cloud, low light, close fog.',\n  background: '#39444f',\n  dome: { show: false },\n  sun: { color: '#b8c4d0', intensity: 1, azimuth: 0.6, elevation: 0.8 },\n  ambient: { sky: '#7f8e9c', ground: '#3a4148', intensity: 1.2 },\n  fog: { color: '#46525e', start: 30, end: 190, amount: 0.9, floor: 0, ceiling: 1.5, height: 0 },\n  backdrop: NO_BACKDROP,\n} as never);\n\n/** The look's filters, shared. */\nconst FILTERS = {\n  bloom: { scope: 'all', strength: 0.35, threshold: 0.92 },\n  grade: { scope: 'all', brightness: 1.08, saturation: 0.92, lift: 0.03 },\n  outline: { scope: 'characters+objects', width: 1, darken: 0.25 },\n};\n\ndefineLook('look:retreat', {\n  description: 'High-key brochure daylight: soft toon light, a little bloom, a thin ink line on people and things.',\n  sky: 'sky:retreat',\n  style: 'toon',\n  filters: FILTERS,\n} as never);\ndefineLook('look:retreatDawn', {\n  description: 'Dawn over glass.',\n  sky: 'sky:retreatDawn',\n  style: 'toon',\n  filters: FILTERS,\n} as never);\ndefineLook('look:retreatDusk', {\n  description: 'Evening on the island.',\n  sky: 'sky:retreatDusk',\n  style: 'toon',\n  filters: FILTERS,\n} as never);\ndefineLook('look:storm', {\n  description: 'The storm: the colour drained out of the brochure.',\n  sky: 'sky:storm',\n  style: 'toon',\n  filters: {\n    bloom: { scope: 'all', strength: 0.2, threshold: 0.9 },\n    grade: { scope: 'all', brightness: 0.86, saturation: 0.45, lift: 0.01 },\n    outline: { scope: 'characters+objects', width: 1, darken: 0.35 },\n  },\n} as never);\nEOF\ncat > labs/game/bodies/cast.ts <<'EOF'\n/**\n * @file The cast's bodies (PLAN.md section 10), as data on the humanoid's bones. Each Guest look comes in every tracksuit\n * colour, and each seat colour; Plumb also comes with open eyes, for the one time they open them; Tare is a round dial\n * on two stubby legs with no arms.\n *\n * Game code, a page's: the sim names bodies by id.\n *\n * @example\n * // 'body:guest1.teal', 'body:plumb', 'body:tare'\n */\nimport { defineBody } from '../../../engine';\nimport { COLORS, SEAT_COLORS } from '../cast/roster';\n\n/** The tracksuit palettes, by colour name. */\nexport const SUITS: Readonly<Record<string, readonly [string, string]>> = {\n  coral: ['#ff8a70', '#fff4ec'],\n  teal: ['#3fb7a6', '#eafff8'],\n  plum: ['#9a7bc0', '#f3ecff'],\n  sun: ['#f2c14e', '#fff8e0'],\n  sky: ['#6fb9e8', '#eef8ff'],\n  forest: ['#5d9f6a', '#eef8ec'],\n  red: ['#e8443a', '#ffe6e3'],\n  blue: ['#3b82f6', '#e6efff'],\n  green: ['#22c55e', '#e3fff0'],\n  gold: ['#f5b700', '#fff6d6'],\n};\n\n/** Skin and hair per look. */\nconst LOOKS: readonly { skin: string; hair: string }[] = [\n  { skin: '#f0c4a0', hair: '#5a4034' },\n  { skin: '#b57e58', hair: '#231c1a' },\n  { skin: '#e6b48a', hair: '#c48a44' },\n];\n\n/** The torso and limbs everyone but Tare shares. */\nconst FRAME = [\n  ['limb', 'thighL', 'thighR', [1.25, 'limb'], [1.25, 'limb'], 'suit', { on: 'pelvis' }],\n  ['limb', ['off', 'spine0', 0, 0, 0.05], 'chest', [0.58, 'torso'], [0.62, 'torso'], 'suit', { on: 'spine1' }],\n  ['limb', 'chest', 'neck', [0.62, 'torso'], [0.5, 'torso'], 'trim'],\n  ['limb', 'neck', 'head', [0.7, 'limb'], [0.7, 'limb'], 'skin'],\n  ['limb', 'upperArmL', 'upperArmR', [1.1, 'limb'], [1.1, 'limb'], 'suit', { on: 'chest' }],\n];\n\n/** The limbs, written for the left. */\nconst LIMBS = [\n  ['limb', 'thighL', 'shinL', [1.3, 'limb'], [1.05, 'limb'], 'suit'],\n  ['limb', 'shinL', 'footL', [1.05, 'limb'], [0.85, 'limb'], 'suit'],\n  ['limb', 'footL', 'toeL', [1, 'limb'], [0.85, 'limb'], 'shoe'],\n  ['limb', 'upperArmL', 'forearmL', [1.05, 'limb'], [0.9, 'limb'], 'suit'],\n  ['limb', 'forearmL', 'handL', [0.9, 'limb'], [0.8, 'limb'], 'skin'],\n];\n\n/** Defines one Guest's body. */\nfunction guest(look: number, colorName: string): void {\n  const [suit, trim] = SUITS[colorName];\n  const { skin, hair } = LOOKS[look];\n  const hairParts = [\n    [['ball', ['off', 'head', -0.02, 0, [1.1, 'head']], [0.95, 'head'], 'hair']],\n    [['ball', ['off', 'head', -0.03, 0, [1.05, 'head']], [0.93, 'head'], 'hair'], ['ball', ['off', 'head', -0.03, 0, [2.05, 'head']], [0.42, 'head'], 'hair']],\n    [['ball', ['off', 'head', 0, 0, [1.25, 'head']], [0.92, 'head'], 'hair'], ['limb', ['off', 'head', [0.8, 'head'], -0.07, [1.5, 'head']], ['off', 'head', [0.8, 'head'], 0.07, [1.5, 'head']], 0.025, 0.025, 'trim']],\n  ][look];\n  defineBody(`body:guest${look}.${colorName}`, {\n    description: `A guest of Little Fulcrum: look ${look}, in a ${colorName} tracksuit.`,\n    slots: { skin, suit, trim, hair, shoe: '#f7fafc', eye: '#2a3036' },\n    parts: [...FRAME, ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'], ...hairParts],\n    mirror: [...LIMBS, ['eye', 'eyeL', [0.1, 'head'], 'eye']],\n    build: `build:guest${look}`,\n  } as never);\n}\n\nfor (let look = 0; look < 3; look++) {\n  for (const color of [...COLORS, ...SEAT_COLORS]) guest(look, color);\n}\n\n/** Plumb: tall, narrow, utterly vertical; pale mint tracksuit; eyes closed in two calm arcs. */\nfunction plumb(id: string, open: boolean): void {\n  defineBody(id, {\n    description: open ? 'Instructor Plumb, once, with open eyes.' : 'Instructor Plumb: mint tracksuit, eyes closed in two calm arcs.',\n    slots: { skin: '#eccdb0', suit: '#bfead6', trim: '#f7fafc', hair: '#3a4a55', shoe: '#f7fafc', eye: '#3a4a55' },\n    parts: [...FRAME, ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.95, 'head'], 'skin'], ['ball', ['off', 'head', -0.012, 0, [1.28, 'head']], [0.86, 'head'], 'hair']],\n    mirror: [\n      ...LIMBS,\n      open\n        ? ['eye', 'eyeL', [0.16, 'head'], 'eye']\n        : ['curve', ['off', 'eyeL', 0.005, -0.03, 0], ['off', 'eyeL', 0.005, 0.03, 0], -0.5, 0.008, 0.008, 'eye', { on: 'head' }],\n    ],\n    limbRadius: 0.05,\n    torsoRadius: 0.14,\n    build: 'build:plumb',\n  } as never);\n}\nplumb('body:plumb', false);\nplumb('body:plumbOpen', true);\n\ndefineBody('body:gerald', {\n  description: 'Gerald: a retired guest with immense calves, always already there.',\n  slots: { skin: '#e8b48c', suit: '#7a8fa6', trim: '#e6e6e0', hair: '#e8e8e4', shoe: '#6c5840', eye: '#2a3036', shorts: '#5c6e80' },\n  parts: [\n    ['limb', 'thighL', 'thighR', [1.5, 'limb'], [1.5, 'limb'], 'shorts', { on: 'pelvis' }],\n    ['limb', ['off', 'spine0', 0, 0, 0.05], 'chest', [0.66, 'torso'], [0.66, 'torso'], 'suit', { on: 'spine1' }],\n    ['limb', 'chest', 'neck', [0.62, 'torso'], [0.5, 'torso'], 'suit'],\n    ['limb', 'neck', 'head', [0.8, 'limb'], [0.8, 'limb'], 'skin'],\n    ['limb', 'upperArmL', 'upperArmR', [1.2, 'limb'], [1.2, 'limb'], 'suit', { on: 'chest' }],\n    ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'],\n    ['ball', ['off', 'head', -0.03, 0, [1.3, 'head']], [0.72, 'head'], 'hair'],\n    ['limb', ['off', 'head', [0.86, 'head'], -0.05, [0.72, 'head']], ['off', 'head', [0.86, 'head'], 0.05, [0.72, 'head']], 0.018, 0.018, 'hair'],\n  ],\n  mirror: [\n    ['limb', 'thighL', 'shinL', [1.45, 'limb'], [1.3, 'limb'], 'shorts'],\n    ['ball', ['lerp', 'shinL', 'footL', 0.32], [2.5, 'limb'], 'skin', { on: 'shinL' }],\n    ['limb', 'shinL', 'footL', [1.5, 'limb'], [0.85, 'limb'], 'skin'],\n    ['limb', 'footL', 'toeL', [1, 'limb'], [0.85, 'limb'], 'shoe'],\n    ['limb', 'upperArmL', 'forearmL', [1.1, 'limb'], [0.95, 'limb'], 'skin'],\n    ['limb', 'forearmL', 'handL', [0.95, 'limb'], [0.85, 'limb'], 'skin'],\n    ['eye', 'eyeL', [0.1, 'head'], 'eye'],\n  ],\n  build: 'build:gerald',\n} as never);\n\ndefineBody('body:bex', {\n  description: 'Bex: a bored teenager in a hoodie, holding a phone-shaped stone, annoyingly excellent.',\n  slots: { skin: '#c8966c', suit: '#54576a', trim: '#9a9fb0', hair: '#201c26', shoe: '#e8444a', eye: '#2a3036', stone: '#a7a9a4' },\n  parts: [\n    ...FRAME,\n    ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.9, 'head'], 'skin'],\n    ['ball', ['off', 'head', -0.04, 0.02, [1.2, 'head']], [0.94, 'head'], 'hair'],\n    ['box', ['off', 'weaponR', 0, 0, -0.02], ['off', 'weaponR', 0, 0, 0.12], 0.07, 0.02, 'stone', { on: 'handR' }],\n  ],\n  mirror: [...LIMBS, ['eye', 'eyeL', [0.1, 'head'], 'eye']],\n  build: 'build:bex',\n} as never);\n\ndefineBody('body:nan', {\n  description: 'Old Nan: 91, Wobble Age 19, small, in a cardigan.',\n  slots: { skin: '#eccab0', suit: '#c9a0a8', trim: '#f7f2ec', hair: '#f0f0f0', shoe: '#7a6a5a', eye: '#2a3036' },\n  parts: [\n    ...FRAME,\n    ['ball', ['off', 'head', 0, 0, [0.95, 'head']], [0.92, 'head'], 'skin'],\n    ['ball', ['off', 'head', -0.02, 0, [1.25, 'head']], [0.86, 'head'], 'hair'],\n    ['ball', ['off', 'head', -0.03, 0, [2.05, 'head']], [0.4, 'head'], 'hair'],\n  ],\n  mirror: [...LIMBS, ['eye', 'eyeL', [0.1, 'head'], 'eye']],\n  limbRadius: 0.04,\n  torsoRadius: 0.13,\n  build: 'build:nan',\n} as never);\n\ndefineBody('body:tare', {\n  description: 'Tare: a squat round dial bathroom scale on two stubby legs, its face in the dial. Retired from weighing.',\n  slots: { shell: '#e8eef2', dial: '#fdfefe', rim: '#9aa8b2', needle: '#ff8a70', leg: '#c9d3da', eye: '#2a3036' },\n  parts: [\n    ['ball', ['off', 'chest', 0, 0, -0.02], [0.36, 0.36, 0.16], 'shell', { on: 'spine1' }],\n    ['ball', ['off', 'chest', 0.09, 0, -0.02], [0.29, 0.29, 0.1], 'rim', { on: 'spine1' }],\n    ['ball', ['off', 'chest', 0.125, 0, -0.02], [0.255, 0.255, 0.075], 'dial', { on: 'spine1' }],\n    ['limb', ['off', 'chest', 0.2, 0, -0.1], ['off', 'chest', 0.2, 0.09, 0.04], 0.012, 0.006, 'needle', { on: 'spine1' }],\n    ['ball', ['off', 'chest', 0.2, 0, -0.1], 0.024, 'needle', { on: 'spine1' }],\n  ],\n  mirror: [\n    ['limb', 'thighL', 'footL', 0.05, 0.05, 'leg'],\n    ['ball', ['off', 'footL', 0.03, 0, 0.0], [0.07, 0.04, 0.1], 'leg', { on: 'footL' }],\n    ['eye', ['off', 'chest', 0.2, -0.08, 0.1], 0.025, 'eye', { on: 'spine1' }],\n  ],\n  build: 'build:tare',\n} as never);\nEOF\n","description":"Write materials, skies, looks and cast bodies"}}}
