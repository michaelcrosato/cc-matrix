* menu pick arrives as a scene action.\n *\n * Game code, sim-side: `node x sim labs/game/scenes/island.ts` runs it in Node.\n *\n * @example\n * // inspector.actions.run('game.begin', { day: 1 });\n */\nimport {\n  addTerrainBody,\n  defineScene,\n  getTerrain,\n  physicsOf,\n  placeActor,\n  type Intents,\n} from '../../../engine/sim-api';\nimport type { GameComponents, GameWorld } from './components';\nimport './components';\nimport './settings';\nimport { scrubCast } from '../cast/roster';\nimport { ISLAND_ACTIONS } from './actions';\nimport { flowOf, setHost, stepActivity } from './flow';\nimport { buildIsland, stepIsland } from './world';\nimport { makeSeats } from './seats';\nimport { stepDirector } from './director';\nimport { stepPilot } from './pilot';\nimport { stepCritters } from './critters';\nimport './terrain';\n\n/** Holds people where the activity or scene wants them, after the physics, so nothing drifts. */\nexport function holdCast(w: GameWorld): void {\n  for (const e of w.query('cast', 'actor')) {\n    const c = e.cast;\n    if (!c.hold) continue;\n    placeActor(w, e.id, [c.x, c.y, c.z], c.yaw);\n  }\n}\n\n/** The island. */\nexport const island = defineScene<GameComponents>('game:island', {\n  description: 'Little Fulcrum Wellness Retreat: the island, its stations, every activity, the five days.',\n  terrain: 'terrain:fulcrum',\n  physics: true,\n  setup(w) {\n    const terrain = getTerrain('terrain:fulcrum');\n    addTerrainBody(physicsOf(w), terrain);\n    setHost(w, { round: false, terrain, floorY: 2 });\n    w.spawn({ flow: {} });\n    w.spawn({ activity: {} });\n    w.spawn({ island: {} });\n    buildIsland(w);\n    makeSeats(w);\n    w.systems.add('game.hold', holdCast, { phase: 'readback' });\n    w.systems.add('game.scrub', scrubCast, { phase: 'ai' });\n    w.systems.add('game.critters', stepCritters, { phase: 'ai' });\n    w.systems.add('game.world', stepIsland, { phase: 'rules' });\n  },\n  step(w, intents: Intents) {\n    stepDirector(w);\n    stepPilot(w, intents);\n    stepActivity(w, intents);\n    void flowOf;\n  },\n  actions: ISLAND_ACTIONS,\n});\n\nexport default island;\nEOF\ncat > labs/game/scenes/seats.ts <<'EOF'\n/**\n * @file Makes the four seats: each a `seat` and a `wobble`, tied to the person who stands in it.\n *\n * Game code, sim-side.\n *\n * @example\n * // makeSeats(w); // once, in setup\n */\nimport type { GameWorld } from './components';\nimport { castOf } from './events/kit';\nimport { makeWobble } from './wobble';\n\n/** Who stands in each seat on the island. */\nconst WHO = ['guest', 'gerald', 'bex', 'nan'];\n\n/** Spawns the four seats. */\nexport function makeSeats(w: GameWorld, who: readonly string[] = WHO): void {\n  who.forEach((name, index) => {\n    const actor = castOf(w, name)?.id ?? -1;\n    w.spawn({\n      seat: { index, kind: index === 0 ? 'local' : 'off', actor } as never,\n      wobble: makeWobble(w, index),\n    });\n  });\n}\nEOF\ncat > labs/game/scenes/terrain.ts <<'EOF'\n/**\n * @file Little Fulcrum's terrain (PLAN.md section 10): 240 by 240 m, a dome with a summit hill, flats for each station,\n * negative hills for the pond and the north cove; sand shores and lawn uplands by height.\n *\n * Game code, sim-side data.\n *\n * @example\n * // getTerrain('terrain:fulcrum');\n */\nimport { defineTerrain } from '../../../engine/sim-api';\nimport { FLAT_Y, STATIONS } from './data/stations';\n\n/** A flat footprint round a station. */\nconst flat = (id: string, half: number, height: number, margin = 7) => {\n  const s = STATIONS[id];\n  return { rect: [s.x - half, s.z - half, s.x + half, s.z + half] as const, height, margin };\n};\n\ndefineTerrain('terrain:fulcrum', {\n  size: [240, 240],\n  cell: 2,\n  origin: [-120, -120],\n  height: 0.5,\n  scale: 34,\n  seed: 11,\n  hills: [\n    { at: [0, 0], radius: 118, height: 12.5 },\n    { at: [0, 0], radius: 32, height: 3.5 },\n    { at: [-70, -12], radius: 18, height: -3 },\n    { at: [0, -92], radius: 24, height: 5 },\n    { at: [70, -96], radius: 20, height: -6 },\n    { at: [-90, -80], radius: 26, height: -5 },\n  ],\n  flats: [\n    flat('plaza', 16, FLAT_Y),\n    flat('pavilion', 12, FLAT_Y),\n    flat('annex', 14, FLAT_Y),\n    flat('terrace', 8, 8),\n    flat('huts', 8, 5.2),\n    flat('eastTerrace', 8, 7),\n    flat('pond', 3, 5.4, 6),\n    flat('centre', 3, 14, 6),\n    flat('cliff', 7, 16, 8),\n    flat('hoopBeach', 7, 3.4, 8),\n    flat('lighthouse', 4, 4, 6),\n  ],\n  surface: 'grass',\n  materials: ['material:sand', 'material:sand', 'material:lawn'],\n  high: 5,\n} as never);\nEOF\ngrep -n \"  [a-zA-Z]*: \" engine/world/terrain.ts | sed -n 1,30p | cut -c1-130; sed -n 50,62p engine/world/terrain.ts | cut -c1-200","description":"Write the island scene, seats and terrain"}}}
