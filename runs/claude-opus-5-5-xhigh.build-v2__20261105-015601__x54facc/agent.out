'+json.dumps(b,separators=(\",\",\":\")).replace(\"\\\\\",\"\\\\\\\\\").replace(\"'\",\"\\\\'\")+'\\',\\n) as { sources: Record<string, unknown>; clips: Record<string, unknown> };\\n\\n/** The rest pose a hand-written strip is measured on. */\\nexport const REST = JSON.parse(\\n  \\''+json.dumps(r,separators=(\",\",\":\"))+'\\',\\n) as Record<string, unknown>;\\n')\ns=open('labs/game/cast/clips.ts').read()\ns=s.replace(\"import borrowed from './clipdata/borrowed.json' with { type: 'json' };\\nimport rest from './rest.json' with { type: 'json' };\\n\",\"import { BORROWED as borrowed, REST as rest } from './clipdata/borrowed';\\n\")\nopen('labs/game/cast/clips.ts','w').write(s)\ns=open('labs/game/tools/borrow-clips.mjs').read()\ns=s.replace(\"writeFileSync('labs/game/cast/clipdata/borrowed.json', JSON.stringify({ sources, clips }));\",\"writeFileSync('out/borrowed.json', JSON.stringify({ sources, clips })); // then pasted into cast/clipdata/borrowed.ts as text\")\ns=s.replace(\"labs/game/cast/clipdata/borrowed.json, with\",\"labs/game/cast/clipdata/borrowed.ts, with\")\nopen('labs/game/tools/borrow-clips.mjs','w').write(s)\n# 3. sfx clashes\ns=open('labs/game/sounds/effects.ts').read()\ns=s.replace(\"fx('whoosh',\",\"fx('hoopWhoosh',\").replace(\"fx('kick',\",\"fx('stepKick',\")\nopen('labs/game/sounds/effects.ts','w').write(s)\ns=open('labs/game/audio/sound.ts').read()\ns=s.replace(\"'sfx:whoosh'\",\"'sfx:hoopWhoosh'\")\nopen('labs/game/audio/sound.ts','w').write(s)\ns=open('labs/game/ui/app.ts').read()\ns=s.replace(\"'sfx:kick'\",\"'sfx:stepKick'\")\nopen('labs/game/ui/app.ts','w').write(s)\n# 4. type fixes\ns=open('labs/game/scenes/events/kit.ts').read()\ns=s.replace(\"e.sceneProp.q = typeof turn === 'number' ? [0, Math.sin(turn / 2), 0, Math.cos(turn / 2)] : [...turn];\",\"e.sceneProp.q = (typeof turn === 'number' ? [0, Math.sin(turn / 2), 0, Math.cos(turn / 2)] : [...turn]) as [number, number, number, number];\")\nopen('labs/game/scenes/events/kit.ts','w').write(