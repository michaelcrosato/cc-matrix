{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjWtmopn71S1SyXY4TKS","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1946,"cache_read_input_tokens":261704,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1946},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"00f85cdc-f11c-487c-b1de-86f5f5852b43","timestamp":"2026-11-05T09:06:52.579Z","request_id":"req_011CgjWtmTVbtF8ix9gXrM4B","thinking_duration_ms":1177,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjWtmopn71S1SyXY4TKS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DaGQdKM2kZTzfyTZxHtjs6","name":"Bash","input":{"command":"cat > labs/game/cast/clips.ts <<'EOF'\n/**\n * @file The game's own clip set, `clipset:retreat`: every pose is a readable two-key strip, t = 0 stands, t = 1 is the\n * pose, played at speed 0 and scrubbed from the sim, so the body goes where your thumb goes (PLAN.md section 11). The\n * key format's legend is engine/anim/clip/lens.ts: hips [forward, right, up] in percent of hip height, body, chest and\n * head [turn, lean, tilt] in degrees, limbs [forward, out, up, bend, twist]. Additive `Lean*` strips lie on top.\n * `BORROWED` adds a few CC0 library clips.\n *\n * Game code, sim-side data.\n *\n * @example\n * SET.id; // 'clipset:retreat'\n */\nimport { defineClipSet } from '../../../engine/sim-api';\nimport borrowed from './clipdata/borrowed.json' with { type: 'json' };\nimport rest from './rest.json' with { type: 'json' };\n\n/** The neutral standing key every strip starts from. */\nconst STAND = {\n  hips: [0, 0, 100], body: [0, 0, 0], chest: [0, 0, 0], head: [0, 0, 0], shL: [0, 0], shR: [0, 0],\n  armL: [0, 20, -100, 8, 0], armR: [0, 20, -100, 8, 0], legL: [0, 6, -100, 4, 0], legR: [0, 6, -100, 4, 0],\n  footL: [0, 6, 0], footR: [0, 6, 0],\n}; // prettier-ignore\n\n/** A key at `t`, the stand with `over` laid on. */\nconst key = (t: number, over: object) => ({ t, ...STAND, ...over });\n\n/** A two-key strip from standing to `over`. */\nconst strip = (over: object) => ({ src: 'RETREAT', dur: 1, loop: false, keys: [key(0, {}), key(1, over)] });\n\n/** A strip through several poses, evenly. */\nconst path = (...poses: object[]) => ({\n  src: 'RETREAT',\n  dur: 1,\n  loop: false,\n  keys: [key(0, {}), ...poses.map((p, i) => key((i + 1) / poses.length, p))],\n});\n\n/** Sat cross-legged, the pose of Seated Nothing and of Still Pond. */\nconst NOTHING = {\n  hips: [-5, 0, 28],\n  legL: [70, 60, -18, 140, 40],\n  legR: [70, 60, -22, 140, -40],\n  footL: [-20, 60, 0],\n  footR: [-20, 60, 0],\n  armL: [70, 22, -60, 58, 20],\n  armR: [70, 22, -60, 58, -20],\n};\n\n/** Long on your back: the Polite Bridge's start. */\nconst LYING = {\n  hips: [0, 0, 18],\n  body: [0, -86, 0],\n  armL: [0, 30, -100, 0, 0],\n  armR: [0, 30, -100, 0, 0],\n  legL: [100, 8, -30, 96, 0],\n  legR: [100, 8, -30, 96, 0],\n  footL: [-30, 6, 0],\n  footR: [-30, 6, 0],\n};\n\n/** The plank of a push-up. */\nconst PLANK = {\n  hips: [0, 0, 50],\n  body: [0, 74, 0],\n  armL: [100, 14, 8, 4, 0],\n  armR: [100, 14, 8, 4, 0],\n  legL: [0, 4, -100, 2, 0],\n  legR: [0, 4, -100, 2, 0],\n  footL: [50, 0, 0],\n  footR: [50, 0, 0],\n};\n\n/** The clips, by name. */\nconst CLIPS = {\n  // The eight poses.\n  Nothing: strip(NOTHING),\n  Chair: strip({ hips: [-22, 0, 62], body: [0, 24, 0], chest: [0, 2, 0], armL: [100, 6, 10, 4, 0], armR: [100, 6, 10, 4, 0], legL: [60, 6, -78, 88, 0], legR: [60, 6, -78, 88, 0] }),\n  Heron: strip({ hips: [0, 0, 99], legL: [0, 2, -100, 2, 0], legR: [28, 62, -42, 118, 40], footR: [30, 20, 0], armL: [6, 4, 100, 30, 0], armR: [6, 4, 100, 30, 0] }),\n  Archer: strip({ hips: [0, 0, 72], legL: [62, 12, -78, 62, 0], legR: [-70, 10, -72, 4, 0], footR: [10, 40, 0], armL: [0, 100, 4, 2, 0], armR: [0, 100, 4, 2, 0] }),\n  CommaR: strip({ hips: [0, -8, 98], body: [0, 0, 16], chest: [0, 0, 20], head: [0, 0, 8], armL: [0, 40, 100, 14, 0], armR: [0, 12, -100, 6, 0] }),\n  CommaL: strip({ hips: [0, 8, 98], body: [0, 0, -16], chest: [0, 0, -20], head: [0, 0, -8], armR: [0, 40, 100, 14, 0], armL: [0, 12, -100, 6, 0] }),\n  Napkin: strip({ hips: [-14, 0, 90], body: [0, 62, 0], chest: [0, 26, 0], head: [0, 10, 0], armL: [80, 4, -60, 6, 0], armR: [80, 4, -60, 6, 0], legL: [8, 4, -100, 6, 0], legR: [8, 4, -100, 6, 0] }),\n  Bridge: path(LYING, { ...LYING, hips: [0, 0, 44], body: [0, -60, 0], legL: [100, 8, -60, 80, 0], legR: [100, 8, -60, 80, 0] }),\n  Lighthouse: strip({ hips: [0, 0, 106], armL: [0, 2, 100, 0, 0], armR: [0, 2, 100, 0, 0], footL: [36, 2, 30], footR: [36, 2, 30] }),\n  // The leans: additive, so first key neutral; the full key reads about 12 degrees on screen.\n  LeanR: strip({ body: [0, 0, 8], chest: [0, 0, 4], hips: [0, 5, 99], armL: [0, 40, -70, 8, 0] }),\n  LeanL: strip({ body: [0, 0, -8], chest: [0, 0, -4], hips: [0, -5, 99], armR: [0, 40, -70, 8, 0] }),\n  LeanF: strip({ body: [0, 8, 0], chest: [0, 4, 0], hips: [5, 0, 98], armL: [24, 26, -80, 10, 0], armR: [24, 26, -80, 10, 0] }),\n  LeanB: strip({ body: [0, -8, 0], chest: [0, -4, 0], hips: [-5, 0, 98], armL: [-20, 26, -80, 10, 0], armR: [-20, 26, -80, 10, 0] }),\n  // Reps.\n  DeepKnee: strip({ hips: [-14, 0, 56], body: [0, 28, 0], armL: [100, 6, 4, 6, 0], armR: [100, 6, 4, 6, 0], legL: [58, 10, -80, 100, 0], legR: [58, 10, -80, 100, 0] }),\n  PushUp: path(PLANK, { ...PLANK, hips: [0, 0, 30], armL: [100, 40, -30, 96, 0], armR: [100, 40, -30, 96, 0] }),\n  LungeR: strip({ hips: [0, 34, 70], body: [0, 8, 8], legR: [10, 72, -60, 84, 0], legL: [0, 64, -76, 4, 0], armL: [60, 20, 0, 40, 0], armR: [60, 20, 0, 40, 0] }),\n  LungeL: strip({ hips: [0, -34, 70], body: [0, 8, -8], legL: [10, 72, -60, 84, 0], legR: [0, 64, -76, 4, 0], armL: [60, 20, 0, 40, 0], armR: [60, 20, 0, 40, 0] }),\n  // Step.\n  StepUpL: strip({ hips: [8, 6, 104], legL: [72, 8, -40, 90, 0], armR: [50, 20, -40, 60, 0], armL: [-20, 20, -80, 20, 0] }),\n  StepUpR: strip({ hips: [8, -6, 104], legR: [72, 8, -40, 90, 0], armL: [50, 20, -40, 60, 0], armR: [-20, 20, -80, 20, 0] }),\n  SideStepR: strip({ hips: [0, 30, 92], legR: [0, 66, -68, 26, 0], legL: [0, -6, -100, 8, 0], armL: [0, 66, 30, 30, 0], armR: [0, 66, 30, 30, 0] }),\n  SideStepL: strip({ hips: [0, -30, 92], legL: [0, 66, -68, 26, 0], legR: [0, -6, -100, 8, 0], armL: [0, 66, 30, 30, 0], armR: [0, 66, 30, 30, 0] }),\n  Jump: strip({ hips: [0, 0, 118], legL: [20, 18, -90, 30, 0], legR: [20, 18, -90, 30, 0], armL: [0, 40, 90, 12, 0], armR: [0, 40, 90, 12, 0], footL: [40, 6, 0], footR: [40, 6, 0] }),\n  // Hip circle: a ring of keys scrubbed by the stick's angle.\n  HipCircle: { src: 'RETREAT', dur: 1, loop: true, keys: [\n    key(0, { hips: [0, 16, 96], body: [0, 0, 10], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n    key(0.25, { hips: [16, 0, 96], body: [0, 10, 0], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n    key(0.5, { hips: [0, -16, 96], body: [0, 0, -10], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n    key(0.75, { hips: [-16, 0, 96], body: [0, -10, 0], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n    key(1, { hips: [0, 16, 96], body: [0, 0, 10], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n  ] }, // prettier-ignore\n  // Dive: arms up at the lip; a somersault's lean keeps counting past 360; a twist's turn too.\n  DiveReady: strip({ hips: [0, 0, 104], armL: [0, 8, 100, 2, 0], armR: [0, 8, 100, 2, 0], footL: [20, 2, 20], footR: [20, 2, 20] }),\n  Somersault: { src: 'RETREAT', dur: 1, loop: false, keys: [\n    key(0, { armL: [0, 8, 100, 2, 0], armR: [0, 8, 100, 2, 0] }),\n    key(0.25, { body: [0, 180, 0], hips: [0, 0, 80], legL: [80, 8, -20, 120, 0], legR: [80, 8, -20, 120, 0], armL: [90, 10, -30, 110, 0], armR: [90, 10, -30, 110, 0] }),\n    key(0.5, { body: [0, 360, 0], hips: [0, 0, 80], legL: [80, 8, -20, 120, 0], legR: [80, 8, -20, 120, 0], armL: [90, 10, -30, 110, 0], armR: [90, 10, -30, 110, 0] }),\n    key(0.75, { body: [0, 540, 0], hips: [0, 0, 80], legL: [80, 8, -20, 120, 0], legR: [80, 8, -20, 120, 0], armL: [90, 10, -30, 110, 0], armR: [90, 10, -30, 110, 0] }),\n    key(1, { body: [0, 720, 0], armL: [0, 8, 100, 2, 0], armR: [0, 8, 100, 2, 0] }),\n  ] }, // prettier-ignore\n  Twist: { src: 'RETREAT', dur: 1, loop: false, keys: [\n    key(0, {}),\n    key(0.5, { body: [360, 0, 0] }),\n    key(1, { body: [720, 0, 0] }),\n  ] }, // prettier-ignore\n  Splashed: strip({ body: [0, -18, 0], armL: [0, 70, 60, 20, 0], armR: [0, 70, 60, 20, 0], legL: [20, 30, -70, 40, 0], legR: [-10, 30, -70, 30, 0] }),\n  // Paddle: stands on the board, the paddle swings by the feet.\n  Paddling: { src: 'RETREAT', dur: 1, loop: true, keys: [\n    key(0, { body: [14, 10, 0], hips: [0, 0, 92], legL: [12, 10, -94, 18, 0], legR: [-4, 10, -94, 18, 0], armL: [90, 30, 40, 36, 0], armR: [80, 12, -24, 56, 0] }),\n    key(0.5, { body: [-14, 10, 0], hips: [0, 0, 92], legL: [-4, 10, -94, 18, 0], legR: [12, 10, -94, 18, 0], armR: [90, 30, 40, 36, 0], armL: [80, 12, -24, 56, 0] }),\n    key(1, { body: [14, 10, 0], hips: [0, 0, 92], legL: [12, 10, -94, 18, 0], legR: [-4, 10, -94, 18, 0], armL: [90, 30, 40, 36, 0], armR: [80, 12, -24, 56, 0] }),\n  ] }, // prettier-ignore\n  // The line: arms out, knees soft.\n  LineWalk: strip({ hips: [0, 0, 94], armL: [0, 96, 6, 8, 0], armR: [0, 96, 6, 8, 0], legL: [8, 2, -98, 14, 0], legR: [-8, 2, -98, 14, 0] }),\n  LineFall: strip({ body: [0, 30, 30], hips: [0, 0, 80], armL: [40, 80, 70, 20, 0], armR: [40, 80, 70, 20, 0], legL: [40, 40, -60, 50, 0], legR: [-20, 30, -80, 30, 0] }),\n  // The finale.\n  CalmCall: strip({ hips: [0, 0, 96], armL: [60, 20, -40, 30, 0], armR: [60, 20, -40, 30, 0], chest: [0, 8, 0] }),\n  Crank: { src: 'RETREAT', dur: 1, loop: true, keys: [\n    key(0, { hips: [0, 0, 84], body: [0, 26, 0], armL: [100, 8, 30, 20, 0], armR: [100, 8, 30, 20, 0], legL: [40, 10, -90, 34, 0], legR: [-30, 10, -90, 18, 0] }),\n    key(0.5, { hips: [0, 0, 84], body: [0, 34, 0], armL: [100, 8, -30, 60, 0], armR: [100, 8, -30, 60, 0], legL: [-30, 10, -90, 18, 0], legR: [40, 10, -90, 34, 0] }),\n    key(1, { hips: [0, 0, 84], body: [0, 26, 0], armL: [100, 8, 30, 20, 0], armR: [100, 8, 30, 20, 0], legL: [40, 10, -90, 34, 0], legR: [-30, 10, -90, 18, 0] }),\n  ] }, // prettier-ignore\n  StoneStand: strip({ hips: [0, 0, 92], armL: [0, 70, -10, 14, 0], armR: [0, 70, -10, 14, 0], legL: [0, 22, -96, 14, 0], legR: [0, 22, -96, 14, 0] }),\n  // Others: a stoop, Nan's single slow nod, Plumb's upright, Tare's bow.\n  NanNod: path({ head: [0, 22, 0], chest: [0, 12, 0] }, { head: [0, 0, 0] }),\n  Stoop: strip({ body: [0, 18, 0], chest: [0, 12, 0], head: [0, -14, 0], hips: [0, 0, 92], armL: [20, 10, -90, 30, 0], armR: [20, 10, -90, 30, 0] }),\n  Upright: strip({ hips: [0, 0, 102], armL: [0, 4, -100, 0, 0], armR: [0, 4, -100, 0, 0], legL: [0, 1, -100, 0, 0], legR: [0, 1, -100, 0, 0], footL: [0, 0, 0], footR: [0, 0, 0] }),\n  PhoneStare: strip({ hips: [0, 4, 98], body: [0, 4, 2], head: [0, 18, 0], armR: [80, 14, -30, 110, 0], armL: [0, 10, -100, 12, 0] }),\n  Bow: strip({ body: [0, 30, 0], hips: [-4, 0, 96] }),\n}; // prettier-ignore\n\n/** The strips that are additive leans. */\nexport const LEANS = ['RETREAT/LeanR', 'RETREAT/LeanL', 'RETREAT/LeanF', 'RETREAT/LeanB'] as const;\n\n/** The set, registered: the sim and the view play from it. */\nexport const SET = defineClipSet({\n  set: 'RETREAT',\n  title: 'Retreat poses',\n  format: 2,\n  fps: 30,\n  credit: 'Original, written by hand, with a few CC0 clips from Mesh2Motion and Quaternius.',\n  sources: {\n    RETREAT: { file: 'none', rig: 'unreal', label: 'Original', origin: 'Written by hand', license: 'CC0', url: '', rest },\n    ...borrowed.sources,\n  },\n  clips: { ...CLIPS, ...borrowed.clips },\n} as never);\n\n/** The id every cast member plays from. */\nexport const CLIPSET = 'clipset:retreat';\nEOF\ncat > labs/game/cast/roster.ts <<'EOF'\n/**\n * @file Who is on the island: `spawnCast` stands a named person in a world, with a character on the controller, a body\n * and build by id, the retreat's clip set, and (for Plumb) a long plait the view swings by itself. Every person is\n * `player: false`: the pilot (scenes/pilot.ts) writes their intents. Scrubbing writes the clip slots directly.\n *\n * Game code, sim-side.\n *\n * @example\n * // spawnCast(w, 'plumb', 2, 8, 3, 0);\n */\nimport { createCharacter, playClip, spawnActor, stopClip, type ClipsData } from '../../../engine/sim-api';\nimport type { Cast, GameWorld } from '../scenes/components';\nimport { CLIPSET, LEANS } from './clips';\n\n/** The guests' tracksuit colours, the first free, the rest bought with pebbles. */\nexport const COLORS = ['coral', 'teal', 'plum', 'sun', 'sky', 'forest'] as const;\n/** The hub's seat colours, by name. */\nexport const SEAT_COLORS = ['red', 'blue', 'green', 'gold'] as const;\n\n/** How each person is made: a body and a build by id, and how fast they walk. */\nexport const PEOPLE: Readonly<Record<string, { body: string; build: string; speed: number; hair?: string }>> = {\n  plumb: { body: 'body:plumb', build: 'build:plumb', speed: 2.4, hair: 'ponytail' },\n  tare: { body: 'body:tare', build: 'build:tare', speed: 4.8 },\n  gerald: { body: 'body:gerald', build: 'build:gerald', speed: 3.6 },\n  bex: { body: 'body:bex', build: 'build:bex', speed: 3.2 },\n  nan: { body: 'body:nan', build: 'build:nan', speed: 1.6 },\n};\n\n/** The Guest's body id, by look and colour. */\nexport const guestBody = (look: number, color: string): string => `body:guest${look}.${color}`;\n/** The Guest's build id, by look. */\nexport const guestBuild = (look: number): string => `build:guest${look}`;\n\n/** Spawns a person: returns the entity id. */\nexport function spawnCast(\n  w: GameWorld,\n  who: string,\n  x: number,\n  y: number,\n  z: number,\n  yaw = 0,\n  make?: { body: string; build: string; speed: number; hair?: string },\n): number {\n  const person = make ?? PEOPLE[who];\n  const character = createCharacter({ speed: person.speed, jumpSpeed: 6.5 });\n  const cast: Cast = { who, hold: false, x, y, z, yaw, pose: '', poseT: 0, leanX: 0, leanY: 0, home: [x, z] };\n  const components: Record<string, object> = { cast };\n  if (person.hair) components.secondary = { hair: person.hair, color: '#3a4a55' };\n  return spawnActor(w, {\n    at: [x, y, z],\n    character,\n    player: false,\n    yaw,\n    anim: { build: person.build, weapon: 'none' },\n    body: person.body,\n    clips: { sets: [CLIPSET], ik: false },\n    components,\n  });\n}\n\n/** The clip layer of an entity, as data. */\ntype Clipped = { clips: ClipsData; cast: Cast; id: number };\n\n/** Puts a strip plus the four leans on a person's clip layer. */\nfunction dress(w: GameWorld, e: Clipped, pose: string): void {\n  stopClip(w, e.id, 0.25);\n  if (!pose) return;\n  playClip(w, e.id, `RETREAT/${pose}`, { speed: 0, hold: true, walk: true, loop: false, fade: 0.2, out: 0.25 });\n  for (const lean of LEANS) playClip(w, e.id, lean, { speed: 0, hold: true, walk: true, loop: false, additive: true, fade: 0.2, out: 0.25 }); // prettier-ignore\n}\n\n/**\n * Keeps each person's clips matching their `cast`: dresses them when the pose changes, and writes each slot's time: the\n * pose by its progress, the leans by the CoB. A pose named `~Clip` plays a looping library clip instead.\n */\nexport function scrubCast(w: GameWorld): void {\n  for (const e of w.query('cast', 'clips') as unknown as Clipped[]) {\n    const { cast, clips } = e;\n    const state = clips.state;\n    const name = cast.pose;\n    const top = state.slots.find((slot) => slot.stopping === 0 && !slot.play.additive);\n    const playing = top ? top.clip.split('/')[1] : '';\n    const wanted = name.startsWith('~') ? name.slice(1) : name;\n    if (playing !== wanted) {\n      if (name.startsWith('~')) {\n        stopClip(w, e.id, 0.25);\n        playClip(w, e.id, `RETREAT/${wanted}`, { walk: true, loop: true, fade: 0.25, out: 0.25 });\n      } else dress(w, e, wanted);\n    }\n    if (name.startsWith('~')) continue;\n    for (const slot of clips.state.slots) {\n      if (slot.stopping > 0) continue;\n      if (slot.clip === 'RETREAT/LeanR') slot.t = Math.max(0, Math.min(1, cast.leanX));\n      else if (slot.clip === 'RETREAT/LeanL') slot.t = Math.max(0, Math.min(1, -cast.leanX));\n      else if (slot.clip === 'RETREAT/LeanF') slot.t = Math.max(0, Math.min(1, cast.leanY));\n      else if (slot.clip === 'RETREAT/LeanB') slot.t = Math.max(0, Math.min(1, -cast.leanY));\n      else slot.t = slot.play.loop ? cast.poseT : Math.max(0, Math.min(1, cast.poseT));\n    }\n  }\n}\nEOF\ncat > labs/game/scenes/events/ring.ts <<'EOF'\n/**\n * @file Still Ring, the first class of every Round: stay inside a ring that slowly narrows. All seats play at once.\n * Only rounds use it on its own; the Morning Check has its own version.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'ring', { short: true, seats });\n */\nimport { holdAt } from '../bot/players';\nimport { inRing } from '../wobble';\nimport { enter, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** Per-seat state. */\ninterface RingData {\n  inside: number[];\n  total: number;\n}\n\n/** Lead-in and play seconds. */\nconst LEAD = 6;\nconst PLAY = 45;\n\n/** The ring's radius after `u` of the class. */\nconst ringAt = (u: number): number => 0.3 - 0.14 * u;\n\n/** Still Ring. */\nexport const ring: Activity = {\n  id: 'ring',\n  title: 'Still Ring',\n  station: 'pavilion',\n  map: 'actionMap:balance',\n  shot: 'mat',\n  wobble: true,\n  setup(c) {\n    c.a.data = { inside: [0, 0, 0, 0], total: 0 } satisfies RingData as unknown as Record<string, unknown>;\n    enter(c, 'lead');\n    c.hud.title = 'Still Ring';\n    say(c, 'plumb', 'ring.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as RingData;\n    if (c.a.phase === 'lead') {\n      c.hud.big = String(Math.max(1, LEAD - Math.floor(c.a.pt / c.w.hz)));\n      c.hud.disc = true;\n      c.hud.ring = [0, 0, ringAt(0)];\n      for (const e of c.seats) [e.wobble.x, e.wobble.y, e.wobble.vx, e.wobble.vy] = [0, 0, 0, 0];\n      if (c.a.pt >= steps(c, LEAD)) {\n        enter(c, 'play');\n        c.hud.big = '';\n      }\n      return;\n    }\n    const u = c.a.pt / steps(c, PLAY);\n    const r = ringAt(u);\n    c.hud.ring = [0, 0, r];\n    c.hud.meter = 1 - u;\n    d.total += 1;\n    for (const e of c.seats) if (inRing(e.wobble, 0, 0, r)) d.inside[e.seat.index] += 1;\n    if (u >= 1) c.a.done = true;\n  },\n  bot(_c, e, player) {\n    holdAt(_c.w, e.seat, e.wobble, 0, 0, player);\n  },\n  score(c, index) {\n    const d = c.a.data as unknown as RingData;\n    return d.total > 0 ? (1000 * d.inside[index]) / d.total : 0;\n  },\n};\nEOF\n","description":"Write the clip set, cast roster and Still Ring"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1946,"cache_read_input_tokens":261704,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1946},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"262adff3-3c90-4dbd-9711-25de1cabbf82","timestamp":"2026-11-05T09:08:04.112Z","request_id":"req_011CgjWtmTVbtF8ix9gXrM4B","wire_tool_inputs":{"toolu_01DaGQdKM2kZTzfyTZxHtjs6":{"command":"cat > labs/game/cast/clips.ts <<'EOF'\n/**\n * @file The game's own clip set, `clipset:retreat`: every pose is a readable two-key strip, t = 0 stands, t = 1 is the\n * pose, played at speed 0 and scrubbed from the sim, so the body goes where your thumb goes (PLAN.md section 11). The\n * key format's legend is engine/anim/clip/lens.ts: hips [forward, right, up] in percent of hip height, body, chest and\n * head [turn, lean, tilt] in degrees, limbs [forward, out, up, bend, twist]. Additive `Lean*` strips lie on top.\n * `BORROWED` adds a few CC0 library clips.\n *\n * Game code, sim-side data.\n *\n * @example\n * SET.id; // 'clipset:retreat'\n */\nimport { defineClipSet } from '../../../engine/sim-api';\nimport borrowed from './clipdata/borrowed.json' with { type: 'json' };\nimport rest from './rest.json' with { type: 'json' };\n\n/** The neutral standing key every strip starts from. */\nconst STAND = {\n  hips: [0, 0, 100], body: [0, 0, 0], chest: [0, 0, 0], head: [0, 0, 0], shL: [0, 0], shR: [0, 0],\n  armL: [0, 20, -100, 8, 0], armR: [0, 20, -100, 8, 0], legL: [0, 6, -100, 4, 0], legR: [0, 6, -100, 4, 0],\n  footL: [0, 6, 0], footR: [0, 6, 0],\n}; // prettier-ignore\n\n/** A key at `t`, the stand with `over` laid on. */\nconst key = (t: number, over: object) => ({ t, ...STAND, ...over });\n\n/** A two-key strip from standing to `over`. */\nconst strip = (over: object) => ({ src: 'RETREAT', dur: 1, loop: false, keys: [key(0, {}), key(1, over)] });\n\n/** A strip through several poses, evenly. */\nconst path = (...poses: object[]) => ({\n  src: 'RETREAT',\n  dur: 1,\n  loop: false,\n  keys: [key(0, {}), ...poses.map((p, i) => key((i + 1) / poses.length, p))],\n});\n\n/** Sat cross-legged, the pose of Seated Nothing and of Still Pond. */\nconst NOTHING = {\n  hips: [-5, 0, 28],\n  legL: [70, 60, -18, 140, 40],\n  legR: [70, 60, -22, 140, -40],\n  footL: [-20, 60, 0],\n  footR: [-20, 60, 0],\n  armL: [70, 22, -60, 58, 20],\n  armR: [70, 22, -60, 58, -20],\n};\n\n/** Long on your back: the Polite Bridge's start. */\nconst LYING = {\n  hips: [0, 0, 18],\n  body: [0, -86, 0],\n  armL: [0, 30, -100, 0, 0],\n  armR: [0, 30, -100, 0, 0],\n  legL: [100, 8, -30, 96, 0],\n  legR: [100, 8, -30, 96, 0],\n  footL: [-30, 6, 0],\n  footR: [-30, 6, 0],\n};\n\n/** The plank of a push-up. */\nconst PLANK = {\n  hips: [0, 0, 50],\n  body: [0, 74, 0],\n  armL: [100, 14, 8, 4, 0],\n  armR: [100, 14, 8, 4, 0],\n  legL: [0, 4, -100, 2, 0],\n  legR: [0, 4, -100, 2, 0],\n  footL: [50, 0, 0],\n  footR: [50, 0, 0],\n};\n\n/** The clips, by name. */\nconst CLIPS = {\n  // The eight poses.\n  Nothing: strip(NOTHING),\n  Chair: strip({ hips: [-22, 0, 62], body: [0, 24, 0], chest: [0, 2, 0], armL: [100, 6, 10, 4, 0], armR: [100, 6, 10, 4, 0], legL: [60, 6, -78, 88, 0], legR: [60, 6, -78, 88, 0] }),\n  Heron: strip({ hips: [0, 0, 99], legL: [0, 2, -100, 2, 0], legR: [28, 62, -42, 118, 40], footR: [30, 20, 0], armL: [6, 4, 100, 30, 0], armR: [6, 4, 100, 30, 0] }),\n  Archer: strip({ hips: [0, 0, 72], legL: [62, 12, -78, 62, 0], legR: [-70, 10, -72, 4, 0], footR: [10, 40, 0], armL: [0, 100, 4, 2, 0], armR: [0, 100, 4, 2, 0] }),\n  CommaR: strip({ hips: [0, -8, 98], body: [0, 0, 16], chest: [0, 0, 20], head: [0, 0, 8], armL: [0, 40, 100, 14, 0], armR: [0, 12, -100, 6, 0] }),\n  CommaL: strip({ hips: [0, 8, 98], body: [0, 0, -16], chest: [0, 0, -20], head: [0, 0, -8], armR: [0, 40, 100, 14, 0], armL: [0, 12, -100, 6, 0] }),\n  Napkin: strip({ hips: [-14, 0, 90], body: [0, 62, 0], chest: [0, 26, 0], head: [0, 10, 0], armL: [80, 4, -60, 6, 0], armR: [80, 4, -60, 6, 0], legL: [8, 4, -100, 6, 0], legR: [8, 4, -100, 6, 0] }),\n  Bridge: path(LYING, { ...LYING, hips: [0, 0, 44], body: [0, -60, 0], legL: [100, 8, -60, 80, 0], legR: [100, 8, -60, 80, 0] }),\n  Lighthouse: strip({ hips: [0, 0, 106], armL: [0, 2, 100, 0, 0], armR: [0, 2, 100, 0, 0], footL: [36, 2, 30], footR: [36, 2, 30] }),\n  // The leans: additive, so first key neutral; the full key reads about 12 degrees on screen.\n  LeanR: strip({ body: [0, 0, 8], chest: [0, 0, 4], hips: [0, 5, 99], armL: [0, 40, -70, 8, 0] }),\n  LeanL: strip({ body: [0, 0, -8], chest: [0, 0, -4], hips: [0, -5, 99], armR: [0, 40, -70, 8, 0] }),\n  LeanF: strip({ body: [0, 8, 0], chest: [0, 4, 0], hips: [5, 0, 98], armL: [24, 26, -80, 10, 0], armR: [24, 26, -80, 10, 0] }),\n  LeanB: strip({ body: [0, -8, 0], chest: [0, -4, 0], hips: [-5, 0, 98], armL: [-20, 26, -80, 10, 0], armR: [-20, 26, -80, 10, 0] }),\n  // Reps.\n  DeepKnee: strip({ hips: [-14, 0, 56], body: [0, 28, 0], armL: [100, 6, 4, 6, 0], armR: [100, 6, 4, 6, 0], legL: [58, 10, -80, 100, 0], legR: [58, 10, -80, 100, 0] }),\n  PushUp: path(PLANK, { ...PLANK, hips: [0, 0, 30], armL: [100, 40, -30, 96, 0], armR: [100, 40, -30, 96, 0] }),\n  LungeR: strip({ hips: [0, 34, 70], body: [0, 8, 8], legR: [10, 72, -60, 84, 0], legL: [0, 64, -76, 4, 0], armL: [60, 20, 0, 40, 0], armR: [60, 20, 0, 40, 0] }),\n  LungeL: strip({ hips: [0, -34, 70], body: [0, 8, -8], legL: [10, 72, -60, 84, 0], legR: [0, 64, -76, 4, 0], armL: [60, 20, 0, 40, 0], armR: [60, 20, 0, 40, 0] }),\n  // Step.\n  StepUpL: strip({ hips: [8, 6, 104], legL: [72, 8, -40, 90, 0], armR: [50, 20, -40, 60, 0], armL: [-20, 20, -80, 20, 0] }),\n  StepUpR: strip({ hips: [8, -6, 104], legR: [72, 8, -40, 90, 0], armL: [50, 20, -40, 60, 0], armR: [-20, 20, -80, 20, 0] }),\n  SideStepR: strip({ hips: [0, 30, 92], legR: [0, 66, -68, 26, 0], legL: [0, -6, -100, 8, 0], armL: [0, 66, 30, 30, 0], armR: [0, 66, 30, 30, 0] }),\n  SideStepL: strip({ hips: [0, -30, 92], legL: [0, 66, -68, 26, 0], legR: [0, -6, -100, 8, 0], armL: [0, 66, 30, 30, 0], armR: [0, 66, 30, 30, 0] }),\n  Jump: strip({ hips: [0, 0, 118], legL: [20, 18, -90, 30, 0], legR: [20, 18, -90, 30, 0], armL: [0, 40, 90, 12, 0], armR: [0, 40, 90, 12, 0], footL: [40, 6, 0], footR: [40, 6, 0] }),\n  // Hip circle: a ring of keys scrubbed by the stick's angle.\n  HipCircle: { src: 'RETREAT', dur: 1, loop: true, keys: [\n    key(0, { hips: [0, 16, 96], body: [0, 0, 10], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n    key(0.25, { hips: [16, 0, 96], body: [0, 10, 0], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n    key(0.5, { hips: [0, -16, 96], body: [0, 0, -10], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n    key(0.75, { hips: [-16, 0, 96], body: [0, -10, 0], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n    key(1, { hips: [0, 16, 96], body: [0, 0, 10], armL: [0, 86, 10, 12, 0], armR: [0, 86, 10, 12, 0] }),\n  ] }, // prettier-ignore\n  // Dive: arms up at the lip; a somersault's lean keeps counting past 360; a twist's turn too.\n  DiveReady: strip({ hips: [0, 0, 104], armL: [0, 8, 100, 2, 0], armR: [0, 8, 100, 2, 0], footL: [20, 2, 20], footR: [20, 2, 20] }),\n  Somersault: { src: 'RETREAT', dur: 1, loop: false, keys: [\n    key(0, { armL: [0, 8, 100, 2, 0], armR: [0, 8, 100, 2, 0] }),\n    key(0.25, { body: [0, 180, 0], hips: [0, 0, 80], legL: [80, 8, -20, 120, 0], legR: [80, 8, -20, 120, 0], armL: [90, 10, -30, 110, 0], armR: [90, 10, -30, 110, 0] }),\n    key(0.5, { body: [0, 360, 0], hips: [0, 0, 80], legL: [80, 8, -20, 120, 0], legR: [80, 8, -20, 120, 0], armL: [90, 10, -30, 110, 0], armR: [90, 10, -30, 110, 0] }),\n    key(0.75, { body: [0, 540, 0], hips: [0, 0, 80], legL: [80, 8, -20, 120, 0], legR: [80, 8, -20, 120, 0], armL: [90, 10, -30, 110, 0], armR: [90, 10, -30, 110, 0] }),\n    key(1, { body: [0, 720, 0], armL: [0, 8, 100, 2, 0], armR: [0, 8, 100, 2, 0] }),\n  ] }, // prettier-ignore\n  Twist: { src: 'RETREAT', dur: 1, loop: false, keys: [\n    key(0, {}),\n    key(0.5, { body: [360, 0, 0] }),\n    key(1, { body: [720, 0, 0] }),\n  ] }, // prettier-ignore\n  Splashed: strip({ body: [0, -18, 0], armL: [0, 70, 60, 20, 0], armR: [0, 70, 60, 20, 0], legL: [20, 30, -70, 40, 0], legR: [-10, 30, -70, 30, 0] }),\n  // Paddle: stands on the board, the paddle swings by the feet.\n  Paddling: { src: 'RETREAT', dur: 1, loop: true, keys: [\n    key(0, { body: [14, 10, 0], hips: [0, 0, 92], legL: [12, 10, -94, 18, 0], legR: [-4, 10, -94, 18, 0], armL: [90, 30, 40, 36, 0], armR: [80, 12, -24, 56, 0] }),\n    key(0.5, { body: [-14, 10, 0], hips: [0, 0, 92], legL: [-4, 10, -94, 18, 0], legR: [12, 10, -94, 18, 0], armR: [90, 30, 40, 36, 0], armL: [80, 12, -24, 56, 0] }),\n    key(1, { body: [14, 10, 0], hips: [0, 0, 92], legL: [12, 10, -94, 18, 0], legR: [-4, 10, -94, 18, 0], armL: [90, 30, 40, 36, 0], armR: [80, 12, -24, 56, 0] }),\n  ] }, // prettier-ignore\n  // The line: arms out, knees soft.\n  LineWalk: strip({ hips: [0, 0, 94], armL: [0, 96, 6, 8, 0], armR: [0, 96, 6, 8, 0], legL: [8, 2, -98, 14, 0], legR: [-8, 2, -98, 14, 0] }),\n  LineFall: strip({ body: [0, 30, 30], hips: [0, 0, 80], armL: [40, 80, 70, 20, 0], armR: [40, 80, 70, 20, 0], legL: [40, 40, -60, 50, 0], legR: [-20, 30, -80, 30, 0] }),\n  // The finale.\n  CalmCall: strip({ hips: [0, 0, 96], armL: [60, 20, -40, 30, 0], armR: [60, 20, -40, 30, 0], chest: [0, 8, 0] }),\n  Crank: { src: 'RETREAT', dur: 1, loop: true, keys: [\n    key(0, { hips: [0, 0, 84], body: [0, 26, 0], armL: [100, 8, 30, 20, 0], armR: [100, 8, 30, 20, 0], legL: [40, 10, -90, 34, 0], legR: [-30, 10, -90, 18, 0] }),\n    key(0.5, { hips: [0, 0, 84], body: [0, 34, 0], armL: [100, 8, -30, 60, 0], armR: [100, 8, -30, 60, 0], legL: [-30, 10, -90, 18, 0], legR: [40, 10, -90, 34, 0] }),\n    key(1, { hips: [0, 0, 84], body: [0, 26, 0], armL: [100, 8, 30, 20, 0], armR: [100, 8, 30, 20, 0], legL: [40, 10, -90, 34, 0], legR: [-30, 10, -90, 18, 0] }),\n  ] }, // prettier-ignore\n  StoneStand: strip({ hips: [0, 0, 92], armL: [0, 70, -10, 14, 0], armR: [0, 70, -10, 14, 0], legL: [0, 22, -96, 14, 0], legR: [0, 22, -96, 14, 0] }),\n  // Others: a stoop, Nan's single slow nod, Plumb's upright, Tare's bow.\n  NanNod: path({ head: [0, 22, 0], chest: [0, 12, 0] }, { head: [0, 0, 0] }),\n  Stoop: strip({ body: [0, 18, 0], chest: [0, 12, 0], head: [0, -14, 0], hips: [0, 0, 92], armL: [20, 10, -90, 30, 0], armR: [20, 10, -90, 30, 0] }),\n  Upright: strip({ hips: [0, 0, 102], armL: [0, 4, -100, 0, 0], armR: [0, 4, -100, 0, 0], legL: [0, 1, -100, 0, 0], legR: [0, 1, -100, 0, 0], footL: [0, 0, 0], footR: [0, 0, 0] }),\n  PhoneStare: strip({ hips: [0, 4, 98], body: [0, 4, 2], head: [0, 18, 0], armR: [80, 14, -30, 110, 0], armL: [0, 10, -100, 12, 0] }),\n  Bow: strip({ body: [0, 30, 0], hips: [-4, 0, 96] }),\n}; // prettier-ignore\n\n/** The strips that are additive leans. */\nexport const LEANS = ['RETREAT/LeanR', 'RETREAT/LeanL', 'RETREAT/LeanF', 'RETREAT/LeanB'] as const;\n\n/** The set, registered: the sim and the view play from it. */\nexport const SET = defineClipSet({\n  set: 'RETREAT',\n  title: 'Retreat poses',\n  format: 2,\n  fps: 30,\n  credit: 'Original, written by hand, with a few CC0 clips from Mesh2Motion and Quaternius.',\n  sources: {\n    RETREAT: { file: 'none', rig: 'unreal', label: 'Original', origin: 'Written by hand', license: 'CC0', url: '', rest },\n    ...borrowed.sources,\n  },\n  clips: { ...CLIPS, ...borrowed.clips },\n} as never);\n\n/** The id every cast member plays from. */\nexport const CLIPSET = 'clipset:retreat';\nEOF\ncat > labs/game/cast/roster.ts <<'EOF'\n/**\n * @file Who is on the island: `spawnCast` stands a named person in a world, with a character on the controller, a body\n * and build by id, the retreat's clip set, and (for Plumb) a long plait the view swings by itself. Every person is\n * `player: false`: the pilot (scenes/pilot.ts) writes their intents. Scrubbing writes the clip slots directly.\n *\n * Game code, sim-side.\n *\n * @example\n * // spawnCast(w, 'plumb', 2, 8, 3, 0);\n */\nimport { createCharacter, playClip, spawnActor, stopClip, type ClipsData } from '../../../engine/sim-api';\nimport type { Cast, GameWorld } from '../scenes/components';\nimport { CLIPSET, LEANS } from './clips';\n\n/** The guests' tracksuit colours, the first free, the rest bought with pebbles. */\nexport const COLORS = ['coral', 'teal', 'plum', 'sun', 'sky', 'forest'] as const;\n/** The hub's seat colours, by name. */\nexport const SEAT_COLORS = ['red', 'blue', 'green', 'gold'] as const;\n\n/** How each person is made: a body and a build by id, and how fast they walk. */\nexport const PEOPLE: Readonly<Record<string, { body: string; build: string; speed: number; hair?: string }>> = {\n  plumb: { body: 'body:plumb', build: 'build:plumb', speed: 2.4, hair: 'ponytail' },\n  tare: { body: 'body:tare', build: 'build:tare', speed: 4.8 },\n  gerald: { body: 'body:gerald', build: 'build:gerald', speed: 3.6 },\n  bex: { body: 'body:bex', build: 'build:bex', speed: 3.2 },\n  nan: { body: 'body:nan', build: 'build:nan', speed: 1.6 },\n};\n\n/** The Guest's body id, by look and colour. */\nexport const guestBody = (look: number, color: string): string => `body:guest${look}.${color}`;\n/** The Guest's build id, by look. */\nexport const guestBuild = (look: number): string => `build:guest${look}`;\n\n/** Spawns a person: returns the entity id. */\nexport function spawnCast(\n  w: GameWorld,\n  who: string,\n  x: number,\n  y: number,\n  z: number,\n  yaw = 0,\n  make?: { body: string; build: string; speed: number; hair?: string },\n): number {\n  const person = make ?? PEOPLE[who];\n  const character = createCharacter({ speed: person.speed, jumpSpeed: 6.5 });\n  const cast: Cast = { who, hold: false, x, y, z, yaw, pose: '', poseT: 0, leanX: 0, leanY: 0, home: [x, z] };\n  const components: Record<string, object> = { cast };\n  if (person.hair) components.secondary = { hair: person.hair, color: '#3a4a55' };\n  return spawnActor(w, {\n    at: [x, y, z],\n    character,\n    player: false,\n    yaw,\n    anim: { build: person.build, weapon: 'none' },\n    body: person.body,\n    clips: { sets: [CLIPSET], ik: false },\n    components,\n  });\n}\n\n/** The clip layer of an entity, as data. */\ntype Clipped = { clips: ClipsData; cast: Cast; id: number };\n\n/** Puts a strip plus the four leans on a person's clip layer. */\nfunction dress(w: GameWorld, e: Clipped, pose: string): void {\n  stopClip(w, e.id, 0.25);\n  if (!pose) return;\n  playClip(w, e.id, `RETREAT/${pose}`, { speed: 0, hold: true, walk: true, loop: false, fade: 0.2, out: 0.25 });\n  for (const lean of LEANS) playClip(w, e.id, lean, { speed: 0, hold: true, walk: true, loop: false, additive: true, fade: 0.2, out: 0.25 }); // prettier-ignore\n}\n\n/**\n * Keeps each person's clips matching their `cast`: dresses them when the pose changes, and writes each slot's time: the\n * pose by its progress, the leans by the CoB. A pose named `~Clip` plays a looping library clip instead.\n */\nexport function scrubCast(w: GameWorld): void {\n  for (const e of w.query('cast', 'clips') as unknown as Clipped[]) {\n    const { cast, clips } = e;\n    const state = clips.state;\n    const name = cast.pose;\n    const top = state.slots.find((slot) => slot.stopping === 0 && !slot.play.additive);\n    const playing = top ? top.clip.split('/')[1] : '';\n    const wanted = name.startsWith('~') ? name.slice(1) : name;\n    if (playing !== wanted) {\n      if (name.startsWith('~')) {\n        stopClip(w, e.id, 0.25);\n        playClip(w, e.id, `RETREAT/${wanted}`, { walk: true, loop: true, fade: 0.25, out: 0.25 });\n      } else dress(w, e, wanted);\n    }\n    if (name.startsWith('~')) continue;\n    for (const slot of clips.state.slots) {\n      if (slot.stopping > 0) continue;\n      if (slot.clip === 'RETREAT/LeanR') slot.t = Math.max(0, Math.min(1, cast.leanX));\n      else if (slot.clip === 'RETREAT/LeanL') slot.t = Math.max(0, Math.min(1, -cast.leanX));\n      else if (slot.clip === 'RETREAT/LeanF') slot.t = Math.max(0, Math.min(1, cast.leanY));\n      else if (slot.clip === 'RETREAT/LeanB') slot.t = Math.max(0, Math.min(1, -cast.leanY));\n      else slot.t = slot.play.loop ? cast.poseT : Math.max(0, Math.min(1, cast.poseT));\n    }\n  }\n}\nEOF\ncat > labs/game/scenes/events/ring.ts <<'EOF'\n/**\n * @file Still Ring, the first class of every Round: stay inside a ring that slowly narrows. All seats play at once.\n * Only rounds use it on its own; the Morning Check has its own version.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'ring', { short: true, seats });\n */\nimport { holdAt } from '../bot/players';\nimport { inRing } from '../wobble';\nimport { enter, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** Per-seat state. */\ninterface RingData {\n  inside: number[];\n  total: number;\n}\n\n/** Lead-in and play seconds. */\nconst LEAD = 6;\nconst PLAY = 45;\n\n/** The ring's radius after `u` of the class. */\nconst ringAt = (u: number): number => 0.3 - 0.14 * u;\n\n/** Still Ring. */\nexport const ring: Activity = {\n  id: 'ring',\n  title: 'Still Ring',\n  station: 'pavilion',\n  map: 'actionMap:balance',\n  shot: 'mat',\n  wobble: true,\n  setup(c) {\n    c.a.data = { inside: [0, 0, 0, 0], total: 0 } satisfies RingData as unknown as Record<string, unknown>;\n    enter(c, 'lead');\n    c.hud.title = 'Still Ring';\n    say(c, 'plumb', 'ring.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as RingData;\n    if (c.a.phase === 'lead') {\n      c.hud.big = String(Math.max(1, LEAD - Math.floor(c.a.pt / c.w.hz)));\n      c.hud.disc = true;\n      c.hud.ring = [0, 0, ringAt(0)];\n      for (const e of c.seats) [e.wobble.x, e.wobble.y, e.wobble.vx, e.wobble.vy] = [0, 0, 0, 0];\n      if (c.a.pt >= steps(c, LEAD)) {\n        enter(c, 'play');\n        c.hud.big = '';\n      }\n      return;\n    }\n    const u = c.a.pt / steps(c, PLAY);\n    const r = ringAt(u);\n    c.hud.ring = [0, 0, r];\n    c.hud.meter = 1 - u;\n    d.total += 1;\n    for (const e of c.seats) if (inRing(e.wobble, 0, 0, r)) d.inside[e.seat.index] += 1;\n    if (u >= 1) c.a.done = true;\n  },\n  bot(_c, e, player) {\n    holdAt(_c.w, e.seat, e.wobble, 0, 0, player);\n  },\n  score(c, index) {\n    const d = c.a.data as unknown as RingData;\n    return d.total > 0 ? (1000 * d.inside[index]) / d.total : 0;\n  },\n};\nEOF\n","description":"Write the clip set, cast roster and Still Ring"}}}
