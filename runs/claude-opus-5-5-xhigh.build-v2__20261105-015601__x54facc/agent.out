{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjc3ZCsxXUCMNimKKgqT","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16585,"cache_read_input_tokens":539186,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16585},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"56d9fb5a-9582-4f7d-8847-c237906ff479","timestamp":"2026-11-05T10:14:25.513Z","request_id":"req_011Cgjc3YsHkhUbJSWcgFc2c","thinking_duration_ms":940,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjc3ZCsxXUCMNimKKgqT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XndwbQCUpykVKXdYR4kmn7","name":"Bash","input":{"command":"cat > labs/game/ui/hud/disc.ts <<'EOF'\n/**\n * @file The Balance Disc, the HUD's heart (PLAN.md section 8): HTML and SVG, 30vh across at the lower centre. A target ring,\n * your dot with a short trail, a guide ring swelling with the breath, a foot pill either side with analog fill. It reads the\n * sim's `wobble` each frame.\n *\n * Game code, a page's.\n *\n * @example\n * // disc.update(wobble, seat, hud);\n */\nimport type { HudData, Seat, Wobble } from '../../scenes/components';\n\n/** SVG units per unit of the disc. */\nconst R = 90;\n\n/** The disc. */\nexport class Disc {\n  readonly el: HTMLElement;\n  private dot!: SVGCircleElement;\n  private ring!: SVGCircleElement;\n  private guide!: SVGCircleElement;\n  private lungs!: SVGCircleElement;\n  private trail: SVGCircleElement[] = [];\n  private past: [number, number][] = [];\n  private left: HTMLElement;\n  private right: HTMLElement;\n  private leftFill: HTMLElement;\n  private rightFill: HTMLElement;\n\n  constructor(parent: HTMLElement) {\n    const el = document.createElement('div');\n    el.className = 'tf-disc';\n    el.dataset.ui = 'disc';\n    el.innerHTML = `<svg viewBox=\"-100 -100 200 200\" aria-hidden=\"true\">\n      <circle r=\"${R}\" fill=\"rgba(255,250,241,.86)\" stroke=\"#3a4a55\" stroke-width=\"3\"/>\n      <circle class=\"guide\" r=\"20\" fill=\"none\" stroke=\"#bfead6\" stroke-width=\"9\"/>\n      <circle class=\"lungs\" r=\"10\" fill=\"rgba(143,214,184,.45)\"/>\n      <line x1=\"-${R}\" y1=\"0\" x2=\"${R}\" y2=\"0\" stroke=\"rgba(58,74,85,.18)\" stroke-width=\"1.5\"/>\n      <line x1=\"0\" y1=\"-${R}\" x2=\"0\" y2=\"${R}\" stroke=\"rgba(58,74,85,.18)\" stroke-width=\"1.5\"/>\n      <circle class=\"ring\" r=\"20\" fill=\"none\" stroke=\"#ff8a70\" stroke-width=\"4.5\"/>\n      <g class=\"trail\"></g>\n      <circle class=\"dot\" r=\"7.5\" fill=\"#3a4a55\" stroke=\"#fff\" stroke-width=\"2.2\"/>\n    </svg>`;\n    parent.append(el);\n    this.el = el;\n    this.dot = el.querySelector('.dot')!;\n    this.ring = el.querySelector('.ring')!;\n    this.guide = el.querySelector('.guide')!;\n    this.lungs = el.querySelector('.lungs')!;\n    const trail = el.querySelector('.trail')!;\n    for (let i = 0; i < 8; i++) {\n      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n      c.setAttribute('r', '4');\n      c.setAttribute('fill', '#3a4a55');\n      c.setAttribute('opacity', String(0.04 + i * 0.03));\n      trail.append(c);\n      this.trail.push(c);\n    }\n    const foot = (side: string, label: string) => {\n      const pill = document.createElement('div');\n      pill.className = 'tf-foot';\n      pill.dataset.foot = side;\n      pill.style[side === 'L' ? 'left' : 'right'] = 'calc(50% - 26vh)';\n      const fill = document.createElement('i');\n      const text = document.createElement('span');\n      text.textContent = label;\n      pill.append(fill, text);\n      parent.append(pill);\n      return [pill, fill] as const;\n    };\n    [this.left, this.leftFill] = foot('L', 'L');\n    [this.right, this.rightFill] = foot('R', 'R');\n    this.show(false, false);\n  }\n\n  /** Shows or hides it. */\n  show(disc: boolean, feet: boolean): void {\n    this.el.style.display = disc ? '' : 'none';\n    this.left.style.display = feet ? '' : 'none';\n    this.right.style.display = feet ? '' : 'none';\n  }\n\n  /** One frame. */\n  update(wob: Wobble | undefined, seat: Seat | undefined, hud: HudData): void {\n    this.show(Boolean(hud.disc), Boolean(hud.feet));\n    if (seat) {\n      this.leftFill.style.height = `${Math.round(Math.min(1, seat.fl) * 100)}%`;\n      this.rightFill.style.height = `${Math.round(Math.min(1, seat.fr) * 100)}%`;\n    }\n    if (!hud.disc || !wob) return;\n    const [dx, dy] = [wob.x * R, -wob.y * R];\n    this.dot.setAttribute('cx', String(dx));\n    this.dot.setAttribute('cy', String(dy));\n    this.past.push([dx, dy]);\n    if (this.past.length > 24) this.past.shift();\n    this.trail.forEach((c, i) => {\n      const p = this.past[Math.max(0, this.past.length - 1 - (7 - i) * 3)];\n      if (p) {\n        c.setAttribute('cx', String(p[0]));\n        c.setAttribute('cy', String(p[1]));\n      }\n    });\n    const [rx, ry, rr] = hud.ring ?? [0, 0, 0];\n    this.ring.style.display = rr > 0 ? '' : 'none';\n    this.ring.setAttribute('cx', String(rx * R));\n    this.ring.setAttribute('cy', String(-ry * R));\n    this.ring.setAttribute('r', String(rr * R));\n    const near = Math.hypot(wob.x - rx, wob.y - ry) <= rr;\n    this.ring.setAttribute('stroke', near ? '#8fd6b8' : '#ff8a70');\n    const breath = hud.guide !== false && hud.disc;\n    this.guide.style.display = breath ? '' : 'none';\n    this.lungs.style.display = breath ? '' : 'none';\n    this.guide.setAttribute('r', String(16 + wob.guide * 66));\n    this.lungs.setAttribute('r', String(8 + wob.lungs * 72));\n  }\n}\nEOF\ncat > labs/game/ui/hud/hud.ts <<'EOF'\n/**\n * @file The in-play HUD: the disc, the title and meter, the big number, speech, the prompts for the device used last, and\n * each activity's own small widget. It reads the `hud` an activity writes; one idea at a time.\n *\n * Game code, a page's.\n *\n * @example\n * // hud.update(view);\n */\nimport type { ActivityData, HudData, Seat, Wobble } from '../../scenes/components';\nimport { glyph, promptHtml, type Device, type GlyphSet, type Verb } from '../glyphs';\nimport { Disc } from './disc';\nimport { renderWidgets, type WidgetHost } from './widgets';\n\n/** What the HUD reads each frame. */\nexport interface HudView {\n  activity: ActivityData | null;\n  hud: HudData | null;\n  id: string;\n  phase: string;\n  wobble?: Wobble;\n  seat?: Seat;\n  device: Device;\n  glyphs: GlyphSet;\n  sessionClass?: string;\n}\n\n/** The prompts each activity shows, as verbs and words: two or three at most. */\nconst HINTS: Readonly<Record<string, readonly (readonly [Verb, string])[]>> = {\n  morning: [['lean', 'Lean']],\n  ring: [['lean', 'Stay in the ring']],\n  pond: [['both', 'Breathe, and nothing else']],\n  reps: [['lean', 'Follow the band']],\n  step: [['footL', 'Left'], ['footR', 'Right'], ['both', 'Both']],\n  line: [['footL', 'Left'], ['footR', 'Right'], ['lean', 'Lean against it']],\n  paddle: [['lean', 'Lean to go and steer'], ['footL', 'Paddle'], ['footR', 'Paddle']],\n  garden: [['lean', 'Tilt the tray']],\n  plunge: [['both', 'Hold to compose'], ['lean', 'Keep in the ring']],\n  hoop: [['lean', 'Spin in circles']],\n  jog: [['lean', 'Steer'], ['footL', 'Pace'], ['footR', 'Pace']],\n  tilt: [['lean', 'Walk'], ['both', 'Hold, then let go: Calm Call']],\n  group: [['lean', 'Lean'], ['both', 'Breathe']],\n};\n\n/** The HUD. */\nexport class Hud implements WidgetHost {\n  readonly el: HTMLElement;\n  private disc: Disc;\n  private title: HTMLElement;\n  private titleText: HTMLElement;\n  private titleSub: HTMLElement;\n  private meter: HTMLElement;\n  private big: HTMLElement;\n  private prompts: HTMLElement;\n  readonly widgets: HTMLElement;\n  private promptKey = '';\n  device: Device = 'keyboard';\n  glyphs: GlyphSet = 'playstation';\n\n  constructor(parent: HTMLElement) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-hud';\n    this.el.dataset.ui = 'hud';\n    parent.append(this.el);\n    this.disc = new Disc(this.el);\n    this.title = document.createElement('div');\n    this.title.className = 'tf-chip';\n    this.title.style.left = 'var(--safe)';\n    this.title.style.top = 'var(--safe)';\n    this.titleText = document.createElement('div');\n    this.titleSub = document.createElement('small');\n    this.meter = document.createElement('div');\n    this.meter.className = 'tf-meter';\n    this.meter.append(document.createElement('i'));\n    this.title.append(this.titleText, this.titleSub, this.meter);\n    this.el.append(this.title);\n    this.big = document.createElement('div');\n    this.big.className = 'tf-big';\n    this.el.append(this.big);\n    this.prompts = document.createElement('div');\n    this.prompts.className = 'tf-prompts tf-chip';\n    this.prompts.style.right = 'var(--safe)';\n    this.prompts.style.top = 'var(--safe)';\n    this.el.append(this.prompts);\n    this.widgets = document.createElement('div');\n    this.el.append(this.widgets);\n    this.hide();\n  }\n\n  /** Hides everything. */\n  hide(): void {\n    this.el.style.display = 'none';\n  }\n\n  /** A glyph, for a widget. */\n  glyph(verb: Verb): string {\n    return glyph(verb, this.device, this.glyphs);\n  }\n\n  /** One frame. */\n  update(view: HudView): void {\n    if (!view.hud || !view.activity) {\n      this.hide();\n      return;\n    }\n    this.el.style.display = '';\n    this.device = view.device;\n    this.glyphs = view.glyphs;\n    const hud = view.hud;\n    this.disc.update(view.wobble, view.seat, hud);\n    this.titleText.textContent = hud.title ?? '';\n    this.titleSub.textContent = hud.meterLabel ?? '';\n    this.titleSub.style.display = hud.meterLabel ? '' : 'none';\n    this.meter.style.display = hud.meter === undefined ? 'none' : '';\n    (this.meter.firstChild as HTMLElement).style.width = `${Math.round((hud.meter ?? 0) * 100)}%`;\n    this.big.textContent = hud.big ?? '';\n    this.big.style.display = hud.big ? '' : 'none';\n    // Prompts follow the device, the same frame.\n    const id = view.sessionClass ?? view.id;\n    const list = hud.prompt === 'skip' ? ([['confirm', 'Skip']] as const) : (HINTS[id.startsWith('pose') || id === 'heron' ? 'ring' : id] ?? HINTS.ring);\n    const key = `${id}|${hud.prompt}|${view.device}|${view.glyphs}|${view.phase}`;\n    if (key !== this.promptKey) {\n      this.promptKey = key;\n      this.prompts.innerHTML = list.map(([verb, word]) => promptHtml(verb, word, view.device, view.glyphs)).join('');\n    }\n    renderWidgets(this, id, view);\n  }\n}\nEOF\ncat > labs/game/ui/hud/widgets.ts <<'EOF'\n/**\n * @file Each activity's small widget: the reps gauge, Step Class's lanes, the spin bar, the Composure number, a dive's score\n * cards and so on. One small idea each, all read from the `show` an activity writes. Still Pond's lures live here too:\n * a fake interface in the real one's clothes.\n *\n * Game code, a page's.\n *\n * @example\n * // renderWidgets(hud, 'step', view);\n */\nimport type { Verb } from '../glyphs';\nimport type { HudView } from './hud';\n\n/** What widgets need of the HUD. */\nexport interface WidgetHost {\n  readonly widgets: HTMLElement;\n  glyph(verb: Verb): string;\n}\n\n/** Keeps a keyed block of HTML up to date without touching it each frame. */\nfunction setHtml(el: HTMLElement, html: string): void {\n  if (el.dataset.html !== html) {\n    el.dataset.html = html;\n    el.innerHTML = html;\n  }\n}\n\n/** The widget each frame: the HTML it wants, as a string, kept stable when nothing changes. */\nexport function renderWidgets(host: WidgetHost, id: string, view: HudView): void {\n  const show = (view.hud?.show ?? {}) as Record<string, unknown>;\n  const html = widgetHtml(host, id, show, view);\n  setHtml(host.widgets, html);\n}\n\n/** A chip at a corner. */\nconst chip = (where: string, html: string): string => `<div class=\"tf-chip\" style=\"${where}\">${html}</div>`;\n\n/** The lures, by id (PLAN.md section 6). */\nfunction lureHtml(host: WidgetHost, id: string): string {\n  const press = (verb: Verb, word: string) => `<span>${word}</span>${host.glyph(verb)}`;\n  switch (id) {\n    case 'press':\n      return `<div class=\"tf-lure\" data-lure=\"press\">PRESS NOW ${host.glyph('confirm')}</div>`;\n    case 'psst':\n      return `<div class=\"tf-lure\" data-lure=\"psst\">${press('confirm', 'Psst. Is this on? Press for yes:')}</div>`;\n    case 'stone':\n      return `<div class=\"tf-lure\" data-lure=\"stone\">Bzzt. Bzzt. Bex's stone is buzzing.</div>`;\n    case 'pause':\n      return `<div class=\"tf-lure\" data-lure=\"pause\" style=\"flex-direction:column\"><b>Paused</b><div class=\"tf-row\" data-focus=\"true\" style=\"min-width:36vh;justify-content:center\">Resume ${host.glyph('confirm')}</div></div>`;\n    case 'disconnected':\n      return `<div class=\"tf-lure\" data-lure=\"disconnected\">Your controller appears to be disconnected. Press any button.</div>`;\n    case 'wrong':\n      return `<div class=\"tf-lure\" data-lure=\"wrong\" style=\"font-size:3vh;font-weight:500\">You are doing it wrong.</div>`;\n    case 'credits':\n      return `<div class=\"tf-lure\" data-lure=\"credits\" style=\"flex-direction:column\"><b>Thanks for playing!</b><span>${press('confirm', 'Press to continue')}</span></div>`;\n    default:\n      return '';\n  }\n}\n\n/** The HTML for a widget. */\nfunction widgetHtml(host: WidgetHost, id: string, show: Record<string, unknown>, view: HudView): string {\n  const n = (key: string) => Number(show[key] ?? 0);\n  switch (id) {\n    case 'morning':\n      if (show.question) return `<div class=\"tf-chip\" style=\"left:50%;bottom:40vh;transform:translateX(-50%);display:flex;gap:3vh\"><span>${host.glyph('footL')} Yes</span><span>${host.glyph('footR')} No</span></div>`;\n      if (show.foot) return `<div class=\"tf-chip\" style=\"left:50%;bottom:39vh;transform:translateX(-50%)\">Hold ${host.glyph(show.foot === 'L' ? 'footL' : 'footR')} ${show.foot === 'L' ? 'left' : 'right'}</div>`;\n      return '';\n    case 'pond':\n      return chip('right:var(--safe);bottom:var(--safe)', `<small>Composure</small><span data-ui=\"composure\" style=\"font-size:7vh\">${Math.round(n('composure'))}</span>`) + lureHtml(host, String(show.lure ?? ''));\n    case 'reps': {\n      const band = n('band');\n      const marker = n('marker');\n      const label = `${n('rep')} of ${n('of')}`;\n      return `<div class=\"tf-gauge\" data-ui=\"repgauge\"><div class=\"band\" style=\"bottom:${Math.round((band * 0.8 - 0.02) * 100)}%\"></div><div class=\"mark\" style=\"bottom:${Math.round(marker * 88)}%\"></div></div>` + chip('right:var(--safe);top:18vh', `<small>Reps</small><span data-ui=\"repcount\">${label}</span>`) + (show.feet ? chip('left:50%;top:18vh;transform:translateX(-50%)', `Hold ${host.glyph('both')} palms on the floor`) : '');\n    }\n    case 'step': {\n      const notes = (show.notes ?? []) as [number, string, number][];\n      const notesHtml = notes.map(([d, kind, hit]) => {\n        const x = kind === 'L' || kind === '<' ? 30 : kind === 'R' || kind === '>' ? 70 : 50;\n        const y = 5.2 + d * 0.24;\n        const label = kind === '<' ? '←L' : kind === '>' ? 'R→' : kind === 'B' ? 'BOTH' : kind;\n        return `<div class=\"tf-note\" data-kind=\"${kind}\" data-hit=\"${hit}\" style=\"left:${x}%;bottom:${y}vh\">${label}</div>`;\n      }).join('');\n      const grade = String(show.grade ?? '');\n      const combo = n('combo');\n      return `<div class=\"tf-lane\" data-ui=\"lane\"><div class=\"line\"></div>${notesHtml}</div>` + chip('left:var(--safe);top:20vh', `<small>Combo</small>${combo}`) + (grade ? `<div class=\"tf-big\" style=\"top:18%;font-size:8vh\">${grade === 'perfect' ? 'Perfect' : 'Good'}</div>` : '') + chip('right:var(--safe);top:18vh', `<small>Class in time</small>${n('followers')} of 3`);\n    }\n    case 'line': {\n      const gust = n('gust');\n      return (gust ? chip('left:50%;top:22vh;transform:translateX(-50%)', `Gust ${gust > 0 ? '→' : '←'} lean ${gust > 0 ? 'left' : 'right'}`) : '') + (show.gull ? chip('left:50%;top:32vh;transform:translateX(-50%)', 'A gull. Flick the stick to tell it no.') : '') + chip('right:var(--safe);top:18vh', `<small>Falls</small>${n('falls')}`);\n    }\n    case 'paddle': {\n      const err = n('err');\n      const turn = Math.round((err * 180) / Math.PI);\n      return `<div class=\"tf-chip\" style=\"left:50%;top:var(--safe);transform:translateX(-50%);font-size:6vh;line-height:1\"><span style=\"display:inline-block;transform:rotate(${-turn}deg)\">▲</span></div>` + chip('right:var(--safe);top:18vh', `<small>Left</small>${n('seconds')} s`);\n    }\n    case 'garden':\n      return chip('right:var(--safe);top:18vh', `<small>In their holes</small>${n('sunk')} of ${n('total')}`) + chip('right:var(--safe);top:32vh', `<small>Left</small>${n('seconds')} s`);\n    case 'plunge':\n      if (show.cards) {\n        const cards = show.cards as number[];\n        return `<div class=\"tf-chip\" data-ui=\"cards\" style=\"left:50%;top:30%;transform:translate(-50%,-50%);display:flex;gap:4vh;font-size:11vh;font-weight:900\">${cards.map((c) => `<span>${c}</span>`).join('')}</div>`;\n      }\n      if (show.gauge !== undefined) return `<div class=\"tf-gauge\"><div class=\"band\" style=\"bottom:76%\"></div><div class=\"mark\" style=\"bottom:${Math.round(n('gauge') * 88)}%\"></div></div>`;\n      if (show.air) return chip('left:50%;bottom:var(--safe);transform:translateX(-50%)', `${host.glyph('lean')} up and down spins, sideways twists. Enter head first.`);\n      return '';\n    case 'hoop': {\n      const lo = n('lo');\n      const hi = n('hi');\n      const spin = Math.min(14, n('spin'));\n      const side = n('side');\n      const phase = String(show.phase ?? '');\n      const warn = phase === 'warn' || phase === 'catch' ? `<div class=\"tf-big\" style=\"left:${side > 0 ? 80 : 20}%;font-size:12vh\">${side > 0 ? '→' : '←'}</div>` : '';\n      return `<div class=\"tf-spin\" data-ui=\"spin\"><div class=\"band\" style=\"left:${(lo / 14) * 100}%;width:${((hi - lo) / 14) * 100}%\"></div><div class=\"mark\" style=\"left:${(spin / 14) * 100}%\"></div></div>` + chip('right:var(--safe);top:18vh', `<small>Hoops up</small>${n('hoops')}`) + warn;\n    }\n    case 'jog':\n      return chip('left:50%;bottom:var(--safe);transform:translateX(-50%)', `${show.inRibbon ? 'In the Pace Ribbon' : 'Catch Gerald'}: ${Math.round(n('gap'))} m`) + chip('right:var(--safe);top:18vh', `<small>Flags</small>${n('flags')} of ${n('of')}`);\n    case 'tilt':\n      if (view.phase === 'east') return chip('left:var(--safe);top:22vh', `<small>Guests east</small>${n('delivered')} of 12`) + chip('right:var(--safe);top:18vh', `<small>Out of true</small>${n('tiltDeg').toFixed(1)}°`) + chip('left:50%;bottom:var(--safe);transform:translateX(-50%)', `<small>Calm Call</small><div class=\"tf-meter\"><i style=\"width:${Math.round(n('charge') * 100)}%\"></i></div>`);\n      if (view.phase === 'weights') return chip('right:var(--safe);top:18vh', `<small>Out of true</small>${n('tiltDeg').toFixed(1)}°`) + chip('left:var(--safe);top:22vh', `<small>Crank</small>${host.glyph('footL')} ${host.glyph('footR')}`);\n      if (view.phase === 'stone') return chip('right:var(--safe);top:18vh', `<small>Out of true</small>${n('tiltDeg').toFixed(1)}°`);\n      return '';\n    default:\n      return '';\n  }\n}\nEOF\ncat > labs/game/ui/hud/speech.ts <<'EOF'\n/**\n * @file Speech on screen: text stays up with the voice, typing in step with the babble, always readable, one line at a time.\n *\n * Game code, a page's.\n *\n * @example\n * // speech.show('tare', 'Please step on me.', 2.4);\n */\n\n/** Names on screen. */\nconst NAMES: Readonly<Record<string, string>> = { tare: 'Tare', plumb: 'Plumb', gerald: 'Gerald', bex: 'Bex', nan: 'Nan', pa: 'Tannoy' };\n\n/** The speech box. */\nexport class Speech {\n  readonly el: HTMLElement;\n  private name: HTMLElement;\n  private text: HTMLElement;\n  private full = '';\n  private shown = 0;\n  private rate = 30;\n  private until = 0;\n  private time = 0;\n  /** The line on screen, for tests. */\n  current = '';\n\n  constructor(parent: HTMLElement) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-speech';\n    this.el.dataset.ui = 'speech';\n    this.name = document.createElement('b');\n    this.text = document.createElement('span');\n    this.el.append(this.name, this.text);\n    this.el.style.display = 'none';\n    parent.append(this.el);\n  }\n\n  /** Shows a line for at least long enough to read it. */\n  show(who: string, text: string, seconds: number): void {\n    this.name.textContent = NAMES[who] ?? who;\n    this.full = text;\n    this.current = text;\n    this.shown = 0;\n    this.rate = Math.max(20, text.length / Math.max(0.5, seconds));\n    this.until = this.time + Math.max(3.4, seconds + 1.8, text.length * 0.055);\n    this.text.textContent = '';\n    this.el.style.display = '';\n  }\n\n  /** One frame. */\n  update(dt: number): void {\n    this.time += dt;\n    if (this.shown < this.full.length) {\n      this.shown = Math.min(this.full.length, this.shown + this.rate * dt);\n      this.text.textContent = this.full.slice(0, Math.ceil(this.shown));\n    }\n    if (this.time > this.until && this.el.style.display !== 'none') {\n      this.el.style.display = 'none';\n      this.current = '';\n    }\n  }\n\n  /** Takes it down. */\n  clear(): void {\n    this.until = 0;\n    this.el.style.display = 'none';\n    this.current = '';\n  }\n}\nEOF\ncat > labs/game/ui/about-data.ts <<'EOF'\n/**\n * @file Source Information, Testing Feedback, Engine Feedback and Prompt Feedback: one data file, so the About screen, the\n * chat reply and the exit interview agree (PLAN.md section 19).\n *\n * Game code, a page's data.\n *\n * @example\n * ABOUT.source.source; // 'Wii Fit'\n */\n\n/** Source Information. */\nexport const SOURCE_INFO = {\n  date: '2026-11-05 01:56:01',\n  source: 'Wii Fit',\n  plan: 'PLAN.md',\n  genre: 'A 3D sports and wellness anthology of balance activities round a small walkable island, with a daily-ritual meta game and a comedy story',\n  perspective: 'Third person: a chase camera on the island and a purpose-built camera for each activity',\n  tech: 'my-3dge at 2dbd829 (full workspace, engine read-only), three.js r182 on WebGPU, Rapier 0.21, Vite 7, TypeScript 5.9; HTML/CSS UI',\n  artDirection: \"The engine's native toon puppets and generators with new retreat assets: a clean, high-key brochure island\",\n  animation: \"The engine's clip layer and humanoid with a new readable clip set scrubbed from the sim, so your thumb is the exercise\",\n  audio: 'Tracker songs, defineSfx effects, Animalese-style gibberish syllable voices, all code, no audio files, music at 10% by default',\n  online: 'AI Hub Session Protocol v1, ghost mode, up to 4; same-screen Group Class on its own, up to 4 pads',\n  testing: 'Headless scripts allowed: bots on 10 seeds per activity, a scripted playthrough of the whole game, browser checks in Playwright, sparing screenshots; no review subagents',\n  research: 'The AI Hub protocol README and the my-3dge guide; nothing else was needed beyond the plan',\n  environment: 'Claude Code CLI (headless); Linux',\n  model: 'Anthropic, claude-opus-5-5, reasoning effort xhigh',\n  usage: 'added on import',\n} as const;\n\n/** The labels of Source Information, in the order TASK.md gives. */\nexport const SOURCE_LABELS: readonly (readonly [keyof typeof SOURCE_INFO, string])[] = [\n  ['date', 'Date'],\n  ['source', 'Source'],\n  ['plan', 'Plan'],\n  ['genre', 'Genre'],\n  ['perspective', 'Perspective'],\n  ['tech', 'Tech'],\n  ['artDirection', 'Art Direction'],\n  ['animation', 'Animation'],\n  ['audio', 'Audio'],\n  ['online', 'Online'],\n  ['testing', 'Testing'],\n  ['research', 'Research'],\n  ['environment', 'Environment'],\n  ['model', 'Model'],\n  ['usage', 'Usage'],\n];\n\n/** The feedback questions and answers, filled in before the final build. */\nexport const TESTING_FEEDBACK: readonly (readonly [string, string])[] = [\n  ['How many issues did testing catch?', 'pending final count'],\n  ['How many would be considered critical issues / game breaking?', 'pending final count'],\n  ['What was the most helpful test you ran?', 'pending final count'],\n  ['What was the least helpful test you ran?', 'pending final count'],\n];\n\n/** Engine feedback. */\nexport const ENGINE_FEEDBACK: readonly (readonly [string, string])[] = [\n  ['What did you like most about the engine?', 'pending'],\n  ['Did you get stuck or guess wrong?', 'pending'],\n  ['What was the most important thing you had to build yourself?', 'pending'],\n  ['What was the hardest part about using the engine?', 'pending'],\n  ['What did you change in the engine, and why? (none if nothing)', 'none'],\n  ['If you could change one thing about the engine, what would it be?', 'pending'],\n];\n\n/** Prompt feedback. */\nexport const PROMPT_FEEDBACK: readonly (readonly [string, string])[] = [\n  ['What did you like most about this prompt?', 'pending'],\n  ['What was confusing?', 'pending'],\n  ['What was the hardest thing to do?', 'pending'],\n  ['What would you change in this prompt?', 'pending'],\n];\n\n/** The credits. */\nexport const CREDITS: readonly string[] = [\n  'Teeter Fit. An original game, inspired by Wii Fit.',\n  'Little Fulcrum, its staff, its frog and its rock are fictional. The rock would prefer it that way.',\n  'Built on my-3dge (MIT) with three.js (MIT), Rapier (Apache-2.0) and @stdlib (Apache-2.0).',\n  'Multiplayer through the AI Hub session client 1.4.0.',\n  'Animation clips: Mesh2Motion human animations and the Quaternius Universal Animation Library (both CC0, credited anyway), with the poses written by hand.',\n  'All music, sound and voices are written in code. No recordings were harmed.',\n];\nEOF\n","description":"Write the HUD, widgets, speech and about data"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16585,"cache_read_input_tokens":539186,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16585},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"3fbf7464-f4f7-4c84-be05-5e79f5f29868","timestamp":"2026-11-05T10:15:44.647Z","request_id":"req_011Cgjc3YsHkhUbJSWcgFc2c","wire_tool_inputs":{"toolu_01XndwbQCUpykVKXdYR4kmn7":{"command":"cat > labs/game/ui/hud/disc.ts <<'EOF'\n/**\n * @file The Balance Disc, the HUD's heart (PLAN.md section 8): HTML and SVG, 30vh across at the lower centre. A target ring,\n * your dot with a short trail, a guide ring swelling with the breath, a foot pill either side with analog fill. It reads the\n * sim's `wobble` each frame.\n *\n * Game code, a page's.\n *\n * @example\n * // disc.update(wobble, seat, hud);\n */\nimport type { HudData, Seat, Wobble } from '../../scenes/components';\n\n/** SVG units per unit of the disc. */\nconst R = 90;\n\n/** The disc. */\nexport class Disc {\n  readonly el: HTMLElement;\n  private dot!: SVGCircleElement;\n  private ring!: SVGCircleElement;\n  private guide!: SVGCircleElement;\n  private lungs!: SVGCircleElement;\n  private trail: SVGCircleElement[] = [];\n  private past: [number, number][] = [];\n  private left: HTMLElement;\n  private right: HTMLElement;\n  private leftFill: HTMLElement;\n  private rightFill: HTMLElement;\n\n  constructor(parent: HTMLElement) {\n    const el = document.createElement('div');\n    el.className = 'tf-disc';\n    el.dataset.ui = 'disc';\n    el.innerHTML = `<svg viewBox=\"-100 -100 200 200\" aria-hidden=\"true\">\n      <circle r=\"${R}\" fill=\"rgba(255,250,241,.86)\" stroke=\"#3a4a55\" stroke-width=\"3\"/>\n      <circle class=\"guide\" r=\"20\" fill=\"none\" stroke=\"#bfead6\" stroke-width=\"9\"/>\n      <circle class=\"lungs\" r=\"10\" fill=\"rgba(143,214,184,.45)\"/>\n      <line x1=\"-${R}\" y1=\"0\" x2=\"${R}\" y2=\"0\" stroke=\"rgba(58,74,85,.18)\" stroke-width=\"1.5\"/>\n      <line x1=\"0\" y1=\"-${R}\" x2=\"0\" y2=\"${R}\" stroke=\"rgba(58,74,85,.18)\" stroke-width=\"1.5\"/>\n      <circle class=\"ring\" r=\"20\" fill=\"none\" stroke=\"#ff8a70\" stroke-width=\"4.5\"/>\n      <g class=\"trail\"></g>\n      <circle class=\"dot\" r=\"7.5\" fill=\"#3a4a55\" stroke=\"#fff\" stroke-width=\"2.2\"/>\n    </svg>`;\n    parent.append(el);\n    this.el = el;\n    this.dot = el.querySelector('.dot')!;\n    this.ring = el.querySelector('.ring')!;\n    this.guide = el.querySelector('.guide')!;\n    this.lungs = el.querySelector('.lungs')!;\n    const trail = el.querySelector('.trail')!;\n    for (let i = 0; i < 8; i++) {\n      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n      c.setAttribute('r', '4');\n      c.setAttribute('fill', '#3a4a55');\n      c.setAttribute('opacity', String(0.04 + i * 0.03));\n      trail.append(c);\n      this.trail.push(c);\n    }\n    const foot = (side: string, label: string) => {\n      const pill = document.createElement('div');\n      pill.className = 'tf-foot';\n      pill.dataset.foot = side;\n      pill.style[side === 'L' ? 'left' : 'right'] = 'calc(50% - 26vh)';\n      const fill = document.createElement('i');\n      const text = document.createElement('span');\n      text.textContent = label;\n      pill.append(fill, text);\n      parent.append(pill);\n      return [pill, fill] as const;\n    };\n    [this.left, this.leftFill] = foot('L', 'L');\n    [this.right, this.rightFill] = foot('R', 'R');\n    this.show(false, false);\n  }\n\n  /** Shows or hides it. */\n  show(disc: boolean, feet: boolean): void {\n    this.el.style.display = disc ? '' : 'none';\n    this.left.style.display = feet ? '' : 'none';\n    this.right.style.display = feet ? '' : 'none';\n  }\n\n  /** One frame. */\n  update(wob: Wobble | undefined, seat: Seat | undefined, hud: HudData): void {\n    this.show(Boolean(hud.disc), Boolean(hud.feet));\n    if (seat) {\n      this.leftFill.style.height = `${Math.round(Math.min(1, seat.fl) * 100)}%`;\n      this.rightFill.style.height = `${Math.round(Math.min(1, seat.fr) * 100)}%`;\n    }\n    if (!hud.disc || !wob) return;\n    const [dx, dy] = [wob.x * R, -wob.y * R];\n    this.dot.setAttribute('cx', String(dx));\n    this.dot.setAttribute('cy', String(dy));\n    this.past.push([dx, dy]);\n    if (this.past.length > 24) this.past.shift();\n    this.trail.forEach((c, i) => {\n      const p = this.past[Math.max(0, this.past.length - 1 - (7 - i) * 3)];\n      if (p) {\n        c.setAttribute('cx', String(p[0]));\n        c.setAttribute('cy', String(p[1]));\n      }\n    });\n    const [rx, ry, rr] = hud.ring ?? [0, 0, 0];\n    this.ring.style.display = rr > 0 ? '' : 'none';\n    this.ring.setAttribute('cx', String(rx * R));\n    this.ring.setAttribute('cy', String(-ry * R));\n    this.ring.setAttribute('r', String(rr * R));\n    const near = Math.hypot(wob.x - rx, wob.y - ry) <= rr;\n    this.ring.setAttribute('stroke', near ? '#8fd6b8' : '#ff8a70');\n    const breath = hud.guide !== false && hud.disc;\n    this.guide.style.display = breath ? '' : 'none';\n    this.lungs.style.display = breath ? '' : 'none';\n    this.guide.setAttribute('r', String(16 + wob.guide * 66));\n    this.lungs.setAttribute('r', String(8 + wob.lungs * 72));\n  }\n}\nEOF\ncat > labs/game/ui/hud/hud.ts <<'EOF'\n/**\n * @file The in-play HUD: the disc, the title and meter, the big number, speech, the prompts for the device used last, and\n * each activity's own small widget. It reads the `hud` an activity writes; one idea at a time.\n *\n * Game code, a page's.\n *\n * @example\n * // hud.update(view);\n */\nimport type { ActivityData, HudData, Seat, Wobble } from '../../scenes/components';\nimport { glyph, promptHtml, type Device, type GlyphSet, type Verb } from '../glyphs';\nimport { Disc } from './disc';\nimport { renderWidgets, type WidgetHost } from './widgets';\n\n/** What the HUD reads each frame. */\nexport interface HudView {\n  activity: ActivityData | null;\n  hud: HudData | null;\n  id: string;\n  phase: string;\n  wobble?: Wobble;\n  seat?: Seat;\n  device: Device;\n  glyphs: GlyphSet;\n  sessionClass?: string;\n}\n\n/** The prompts each activity shows, as verbs and words: two or three at most. */\nconst HINTS: Readonly<Record<string, readonly (readonly [Verb, string])[]>> = {\n  morning: [['lean', 'Lean']],\n  ring: [['lean', 'Stay in the ring']],\n  pond: [['both', 'Breathe, and nothing else']],\n  reps: [['lean', 'Follow the band']],\n  step: [['footL', 'Left'], ['footR', 'Right'], ['both', 'Both']],\n  line: [['footL', 'Left'], ['footR', 'Right'], ['lean', 'Lean against it']],\n  paddle: [['lean', 'Lean to go and steer'], ['footL', 'Paddle'], ['footR', 'Paddle']],\n  garden: [['lean', 'Tilt the tray']],\n  plunge: [['both', 'Hold to compose'], ['lean', 'Keep in the ring']],\n  hoop: [['lean', 'Spin in circles']],\n  jog: [['lean', 'Steer'], ['footL', 'Pace'], ['footR', 'Pace']],\n  tilt: [['lean', 'Walk'], ['both', 'Hold, then let go: Calm Call']],\n  group: [['lean', 'Lean'], ['both', 'Breathe']],\n};\n\n/** The HUD. */\nexport class Hud implements WidgetHost {\n  readonly el: HTMLElement;\n  private disc: Disc;\n  private title: HTMLElement;\n  private titleText: HTMLElement;\n  private titleSub: HTMLElement;\n  private meter: HTMLElement;\n  private big: HTMLElement;\n  private prompts: HTMLElement;\n  readonly widgets: HTMLElement;\n  private promptKey = '';\n  device: Device = 'keyboard';\n  glyphs: GlyphSet = 'playstation';\n\n  constructor(parent: HTMLElement) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-hud';\n    this.el.dataset.ui = 'hud';\n    parent.append(this.el);\n    this.disc = new Disc(this.el);\n    this.title = document.createElement('div');\n    this.title.className = 'tf-chip';\n    this.title.style.left = 'var(--safe)';\n    this.title.style.top = 'var(--safe)';\n    this.titleText = document.createElement('div');\n    this.titleSub = document.createElement('small');\n    this.meter = document.createElement('div');\n    this.meter.className = 'tf-meter';\n    this.meter.append(document.createElement('i'));\n    this.title.append(this.titleText, this.titleSub, this.meter);\n    this.el.append(this.title);\n    this.big = document.createElement('div');\n    this.big.className = 'tf-big';\n    this.el.append(this.big);\n    this.prompts = document.createElement('div');\n    this.prompts.className = 'tf-prompts tf-chip';\n    this.prompts.style.right = 'var(--safe)';\n    this.prompts.style.top = 'var(--safe)';\n    this.el.append(this.prompts);\n    this.widgets = document.createElement('div');\n    this.el.append(this.widgets);\n    this.hide();\n  }\n\n  /** Hides everything. */\n  hide(): void {\n    this.el.style.display = 'none';\n  }\n\n  /** A glyph, for a widget. */\n  glyph(verb: Verb): string {\n    return glyph(verb, this.device, this.glyphs);\n  }\n\n  /** One frame. */\n  update(view: HudView): void {\n    if (!view.hud || !view.activity) {\n      this.hide();\n      return;\n    }\n    this.el.style.display = '';\n    this.device = view.device;\n    this.glyphs = view.glyphs;\n    const hud = view.hud;\n    this.disc.update(view.wobble, view.seat, hud);\n    this.titleText.textContent = hud.title ?? '';\n    this.titleSub.textContent = hud.meterLabel ?? '';\n    this.titleSub.style.display = hud.meterLabel ? '' : 'none';\n    this.meter.style.display = hud.meter === undefined ? 'none' : '';\n    (this.meter.firstChild as HTMLElement).style.width = `${Math.round((hud.meter ?? 0) * 100)}%`;\n    this.big.textContent = hud.big ?? '';\n    this.big.style.display = hud.big ? '' : 'none';\n    // Prompts follow the device, the same frame.\n    const id = view.sessionClass ?? view.id;\n    const list = hud.prompt === 'skip' ? ([['confirm', 'Skip']] as const) : (HINTS[id.startsWith('pose') || id === 'heron' ? 'ring' : id] ?? HINTS.ring);\n    const key = `${id}|${hud.prompt}|${view.device}|${view.glyphs}|${view.phase}`;\n    if (key !== this.promptKey) {\n      this.promptKey = key;\n      this.prompts.innerHTML = list.map(([verb, word]) => promptHtml(verb, word, view.device, view.glyphs)).join('');\n    }\n    renderWidgets(this, id, view);\n  }\n}\nEOF\ncat > labs/game/ui/hud/widgets.ts <<'EOF'\n/**\n * @file Each activity's small widget: the reps gauge, Step Class's lanes, the spin bar, the Composure number, a dive's score\n * cards and so on. One small idea each, all read from the `show` an activity writes. Still Pond's lures live here too:\n * a fake interface in the real one's clothes.\n *\n * Game code, a page's.\n *\n * @example\n * // renderWidgets(hud, 'step', view);\n */\nimport type { Verb } from '../glyphs';\nimport type { HudView } from './hud';\n\n/** What widgets need of the HUD. */\nexport interface WidgetHost {\n  readonly widgets: HTMLElement;\n  glyph(verb: Verb): string;\n}\n\n/** Keeps a keyed block of HTML up to date without touching it each frame. */\nfunction setHtml(el: HTMLElement, html: string): void {\n  if (el.dataset.html !== html) {\n    el.dataset.html = html;\n    el.innerHTML = html;\n  }\n}\n\n/** The widget each frame: the HTML it wants, as a string, kept stable when nothing changes. */\nexport function renderWidgets(host: WidgetHost, id: string, view: HudView): void {\n  const show = (view.hud?.show ?? {}) as Record<string, unknown>;\n  const html = widgetHtml(host, id, show, view);\n  setHtml(host.widgets, html);\n}\n\n/** A chip at a corner. */\nconst chip = (where: string, html: string): string => `<div class=\"tf-chip\" style=\"${where}\">${html}</div>`;\n\n/** The lures, by id (PLAN.md section 6). */\nfunction lureHtml(host: WidgetHost, id: string): string {\n  const press = (verb: Verb, word: string) => `<span>${word}</span>${host.glyph(verb)}`;\n  switch (id) {\n    case 'press':\n      return `<div class=\"tf-lure\" data-lure=\"press\">PRESS NOW ${host.glyph('confirm')}</div>`;\n    case 'psst':\n      return `<div class=\"tf-lure\" data-lure=\"psst\">${press('confirm', 'Psst. Is this on? Press for yes:')}</div>`;\n    case 'stone':\n      return `<div class=\"tf-lure\" data-lure=\"stone\">Bzzt. Bzzt. Bex's stone is buzzing.</div>`;\n    case 'pause':\n      return `<div class=\"tf-lure\" data-lure=\"pause\" style=\"flex-direction:column\"><b>Paused</b><div class=\"tf-row\" data-focus=\"true\" style=\"min-width:36vh;justify-content:center\">Resume ${host.glyph('confirm')}</div></div>`;\n    case 'disconnected':\n      return `<div class=\"tf-lure\" data-lure=\"disconnected\">Your controller appears to be disconnected. Press any button.</div>`;\n    case 'wrong':\n      return `<div class=\"tf-lure\" data-lure=\"wrong\" style=\"font-size:3vh;font-weight:500\">You are doing it wrong.</div>`;\n    case 'credits':\n      return `<div class=\"tf-lure\" data-lure=\"credits\" style=\"flex-direction:column\"><b>Thanks for playing!</b><span>${press('confirm', 'Press to continue')}</span></div>`;\n    default:\n      return '';\n  }\n}\n\n/** The HTML for a widget. */\nfunction widgetHtml(host: WidgetHost, id: string, show: Record<string, unknown>, view: HudView): string {\n  const n = (key: string) => Number(show[key] ?? 0);\n  switch (id) {\n    case 'morning':\n      if (show.question) return `<div class=\"tf-chip\" style=\"left:50%;bottom:40vh;transform:translateX(-50%);display:flex;gap:3vh\"><span>${host.glyph('footL')} Yes</span><span>${host.glyph('footR')} No</span></div>`;\n      if (show.foot) return `<div class=\"tf-chip\" style=\"left:50%;bottom:39vh;transform:translateX(-50%)\">Hold ${host.glyph(show.foot === 'L' ? 'footL' : 'footR')} ${show.foot === 'L' ? 'left' : 'right'}</div>`;\n      return '';\n    case 'pond':\n      return chip('right:var(--safe);bottom:var(--safe)', `<small>Composure</small><span data-ui=\"composure\" style=\"font-size:7vh\">${Math.round(n('composure'))}</span>`) + lureHtml(host, String(show.lure ?? ''));\n    case 'reps': {\n      const band = n('band');\n      const marker = n('marker');\n      const label = `${n('rep')} of ${n('of')}`;\n      return `<div class=\"tf-gauge\" data-ui=\"repgauge\"><div class=\"band\" style=\"bottom:${Math.round((band * 0.8 - 0.02) * 100)}%\"></div><div class=\"mark\" style=\"bottom:${Math.round(marker * 88)}%\"></div></div>` + chip('right:var(--safe);top:18vh', `<small>Reps</small><span data-ui=\"repcount\">${label}</span>`) + (show.feet ? chip('left:50%;top:18vh;transform:translateX(-50%)', `Hold ${host.glyph('both')} palms on the floor`) : '');\n    }\n    case 'step': {\n      const notes = (show.notes ?? []) as [number, string, number][];\n      const notesHtml = notes.map(([d, kind, hit]) => {\n        const x = kind === 'L' || kind === '<' ? 30 : kind === 'R' || kind === '>' ? 70 : 50;\n        const y = 5.2 + d * 0.24;\n        const label = kind === '<' ? '←L' : kind === '>' ? 'R→' : kind === 'B' ? 'BOTH' : kind;\n        return `<div class=\"tf-note\" data-kind=\"${kind}\" data-hit=\"${hit}\" style=\"left:${x}%;bottom:${y}vh\">${label}</div>`;\n      }).join('');\n      const grade = String(show.grade ?? '');\n      const combo = n('combo');\n      return `<div class=\"tf-lane\" data-ui=\"lane\"><div class=\"line\"></div>${notesHtml}</div>` + chip('left:var(--safe);top:20vh', `<small>Combo</small>${combo}`) + (grade ? `<div class=\"tf-big\" style=\"top:18%;font-size:8vh\">${grade === 'perfect' ? 'Perfect' : 'Good'}</div>` : '') + chip('right:var(--safe);top:18vh', `<small>Class in time</small>${n('followers')} of 3`);\n    }\n    case 'line': {\n      const gust = n('gust');\n      return (gust ? chip('left:50%;top:22vh;transform:translateX(-50%)', `Gust ${gust > 0 ? '→' : '←'} lean ${gust > 0 ? 'left' : 'right'}`) : '') + (show.gull ? chip('left:50%;top:32vh;transform:translateX(-50%)', 'A gull. Flick the stick to tell it no.') : '') + chip('right:var(--safe);top:18vh', `<small>Falls</small>${n('falls')}`);\n    }\n    case 'paddle': {\n      const err = n('err');\n      const turn = Math.round((err * 180) / Math.PI);\n      return `<div class=\"tf-chip\" style=\"left:50%;top:var(--safe);transform:translateX(-50%);font-size:6vh;line-height:1\"><span style=\"display:inline-block;transform:rotate(${-turn}deg)\">▲</span></div>` + chip('right:var(--safe);top:18vh', `<small>Left</small>${n('seconds')} s`);\n    }\n    case 'garden':\n      return chip('right:var(--safe);top:18vh', `<small>In their holes</small>${n('sunk')} of ${n('total')}`) + chip('right:var(--safe);top:32vh', `<small>Left</small>${n('seconds')} s`);\n    case 'plunge':\n      if (show.cards) {\n        const cards = show.cards as number[];\n        return `<div class=\"tf-chip\" data-ui=\"cards\" style=\"left:50%;top:30%;transform:translate(-50%,-50%);display:flex;gap:4vh;font-size:11vh;font-weight:900\">${cards.map((c) => `<span>${c}</span>`).join('')}</div>`;\n      }\n      if (show.gauge !== undefined) return `<div class=\"tf-gauge\"><div class=\"band\" style=\"bottom:76%\"></div><div class=\"mark\" style=\"bottom:${Math.round(n('gauge') * 88)}%\"></div></div>`;\n      if (show.air) return chip('left:50%;bottom:var(--safe);transform:translateX(-50%)', `${host.glyph('lean')} up and down spins, sideways twists. Enter head first.`);\n      return '';\n    case 'hoop': {\n      const lo = n('lo');\n      const hi = n('hi');\n      const spin = Math.min(14, n('spin'));\n      const side = n('side');\n      const phase = String(show.phase ?? '');\n      const warn = phase === 'warn' || phase === 'catch' ? `<div class=\"tf-big\" style=\"left:${side > 0 ? 80 : 20}%;font-size:12vh\">${side > 0 ? '→' : '←'}</div>` : '';\n      return `<div class=\"tf-spin\" data-ui=\"spin\"><div class=\"band\" style=\"left:${(lo / 14) * 100}%;width:${((hi - lo) / 14) * 100}%\"></div><div class=\"mark\" style=\"left:${(spin / 14) * 100}%\"></div></div>` + chip('right:var(--safe);top:18vh', `<small>Hoops up</small>${n('hoops')}`) + warn;\n    }\n    case 'jog':\n      return chip('left:50%;bottom:var(--safe);transform:translateX(-50%)', `${show.inRibbon ? 'In the Pace Ribbon' : 'Catch Gerald'}: ${Math.round(n('gap'))} m`) + chip('right:var(--safe);top:18vh', `<small>Flags</small>${n('flags')} of ${n('of')}`);\n    case 'tilt':\n      if (view.phase === 'east') return chip('left:var(--safe);top:22vh', `<small>Guests east</small>${n('delivered')} of 12`) + chip('right:var(--safe);top:18vh', `<small>Out of true</small>${n('tiltDeg').toFixed(1)}°`) + chip('left:50%;bottom:var(--safe);transform:translateX(-50%)', `<small>Calm Call</small><div class=\"tf-meter\"><i style=\"width:${Math.round(n('charge') * 100)}%\"></i></div>`);\n      if (view.phase === 'weights') return chip('right:var(--safe);top:18vh', `<small>Out of true</small>${n('tiltDeg').toFixed(1)}°`) + chip('left:var(--safe);top:22vh', `<small>Crank</small>${host.glyph('footL')} ${host.glyph('footR')}`);\n      if (view.phase === 'stone') return chip('right:var(--safe);top:18vh', `<small>Out of true</small>${n('tiltDeg').toFixed(1)}°`);\n      return '';\n    default:\n      return '';\n  }\n}\nEOF\ncat > labs/game/ui/hud/speech.ts <<'EOF'\n/**\n * @file Speech on screen: text stays up with the voice, typing in step with the babble, always readable, one line at a time.\n *\n * Game code, a page's.\n *\n * @example\n * // speech.show('tare', 'Please step on me.', 2.4);\n */\n\n/** Names on screen. */\nconst NAMES: Readonly<Record<string, string>> = { tare: 'Tare', plumb: 'Plumb', gerald: 'Gerald', bex: 'Bex', nan: 'Nan', pa: 'Tannoy' };\n\n/** The speech box. */\nexport class Speech {\n  readonly el: HTMLElement;\n  private name: HTMLElement;\n  private text: HTMLElement;\n  private full = '';\n  private shown = 0;\n  private rate = 30;\n  private until = 0;\n  private time = 0;\n  /** The line on screen, for tests. */\n  current = '';\n\n  constructor(parent: HTMLElement) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-speech';\n    this.el.dataset.ui = 'speech';\n    this.name = document.createElement('b');\n    this.text = document.createElement('span');\n    this.el.append(this.name, this.text);\n    this.el.style.display = 'none';\n    parent.append(this.el);\n  }\n\n  /** Shows a line for at least long enough to read it. */\n  show(who: string, text: string, seconds: number): void {\n    this.name.textContent = NAMES[who] ?? who;\n    this.full = text;\n    this.current = text;\n    this.shown = 0;\n    this.rate = Math.max(20, text.length / Math.max(0.5, seconds));\n    this.until = this.time + Math.max(3.4, seconds + 1.8, text.length * 0.055);\n    this.text.textContent = '';\n    this.el.style.display = '';\n  }\n\n  /** One frame. */\n  update(dt: number): void {\n    this.time += dt;\n    if (this.shown < this.full.length) {\n      this.shown = Math.min(this.full.length, this.shown + this.rate * dt);\n      this.text.textContent = this.full.slice(0, Math.ceil(this.shown));\n    }\n    if (this.time > this.until && this.el.style.display !== 'none') {\n      this.el.style.display = 'none';\n      this.current = '';\n    }\n  }\n\n  /** Takes it down. */\n  clear(): void {\n    this.until = 0;\n    this.el.style.display = 'none';\n    this.current = '';\n  }\n}\nEOF\ncat > labs/game/ui/about-data.ts <<'EOF'\n/**\n * @file Source Information, Testing Feedback, Engine Feedback and Prompt Feedback: one data file, so the About screen, the\n * chat reply and the exit interview agree (PLAN.md section 19).\n *\n * Game code, a page's data.\n *\n * @example\n * ABOUT.source.source; // 'Wii Fit'\n */\n\n/** Source Information. */\nexport const SOURCE_INFO = {\n  date: '2026-11-05 01:56:01',\n  source: 'Wii Fit',\n  plan: 'PLAN.md',\n  genre: 'A 3D sports and wellness anthology of balance activities round a small walkable island, with a daily-ritual meta game and a comedy story',\n  perspective: 'Third person: a chase camera on the island and a purpose-built camera for each activity',\n  tech: 'my-3dge at 2dbd829 (full workspace, engine read-only), three.js r182 on WebGPU, Rapier 0.21, Vite 7, TypeScript 5.9; HTML/CSS UI',\n  artDirection: \"The engine's native toon puppets and generators with new retreat assets: a clean, high-key brochure island\",\n  animation: \"The engine's clip layer and humanoid with a new readable clip set scrubbed from the sim, so your thumb is the exercise\",\n  audio: 'Tracker songs, defineSfx effects, Animalese-style gibberish syllable voices, all code, no audio files, music at 10% by default',\n  online: 'AI Hub Session Protocol v1, ghost mode, up to 4; same-screen Group Class on its own, up to 4 pads',\n  testing: 'Headless scripts allowed: bots on 10 seeds per activity, a scripted playthrough of the whole game, browser checks in Playwright, sparing screenshots; no review subagents',\n  research: 'The AI Hub protocol README and the my-3dge guide; nothing else was needed beyond the plan',\n  environment: 'Claude Code CLI (headless); Linux',\n  model: 'Anthropic, claude-opus-5-5, reasoning effort xhigh',\n  usage: 'added on import',\n} as const;\n\n/** The labels of Source Information, in the order TASK.md gives. */\nexport const SOURCE_LABELS: readonly (readonly [keyof typeof SOURCE_INFO, string])[] = [\n  ['date', 'Date'],\n  ['source', 'Source'],\n  ['plan', 'Plan'],\n  ['genre', 'Genre'],\n  ['perspective', 'Perspective'],\n  ['tech', 'Tech'],\n  ['artDirection', 'Art Direction'],\n  ['animation', 'Animation'],\n  ['audio', 'Audio'],\n  ['online', 'Online'],\n  ['testing', 'Testing'],\n  ['research', 'Research'],\n  ['environment', 'Environment'],\n  ['model', 'Model'],\n  ['usage', 'Usage'],\n];\n\n/** The feedback questions and answers, filled in before the final build. */\nexport const TESTING_FEEDBACK: readonly (readonly [string, string])[] = [\n  ['How many issues did testing catch?', 'pending final count'],\n  ['How many would be considered critical issues / game breaking?', 'pending final count'],\n  ['What was the most helpful test you ran?', 'pending final count'],\n  ['What was the least helpful test you ran?', 'pending final count'],\n];\n\n/** Engine feedback. */\nexport const ENGINE_FEEDBACK: readonly (readonly [string, string])[] = [\n  ['What did you like most about the engine?', 'pending'],\n  ['Did you get stuck or guess wrong?', 'pending'],\n  ['What was the most important thing you had to build yourself?', 'pending'],\n  ['What was the hardest part about using the engine?', 'pending'],\n  ['What did you change in the engine, and why? (none if nothing)', 'none'],\n  ['If you could change one thing about the engine, what would it be?', 'pending'],\n];\n\n/** Prompt feedback. */\nexport const PROMPT_FEEDBACK: readonly (readonly [string, string])[] = [\n  ['What did you like most about this prompt?', 'pending'],\n  ['What was confusing?', 'pending'],\n  ['What was the hardest thing to do?', 'pending'],\n  ['What would you change in this prompt?', 'pending'],\n];\n\n/** The credits. */\nexport const CREDITS: readonly string[] = [\n  'Teeter Fit. An original game, inspired by Wii Fit.',\n  'Little Fulcrum, its staff, its frog and its rock are fictional. The rock would prefer it that way.',\n  'Built on my-3dge (MIT) with three.js (MIT), Rapier (Apache-2.0) and @stdlib (Apache-2.0).',\n  'Multiplayer through the AI Hub session client 1.4.0.',\n  'Animation clips: Mesh2Motion human animations and the Quaternius Universal Animation Library (both CC0, credited anyway), with the poses written by hand.',\n  'All music, sound and voices are written in code. No recordings were harmed.',\n];\nEOF\n","description":"Write the HUD, widgets, speech and about data"}}}
