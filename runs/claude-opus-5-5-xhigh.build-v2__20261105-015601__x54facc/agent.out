 terrace: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'Rounds heights to steps this high (0: smooth).' }, // prettier-ignore\n  flats: { type: 'array', items: { type: 'object' }, default: [], description: 'Footprints flattened: { rect: [x0, z0, x1, z1], height, margin } (m), the ground blending back over margin round each.' \n  surface: { type: 'string', default: 'grass', description: 'The surface tag underfoot (footsteps, particles).' },\n  steep: { type: 'number', default: 0.7, minimum: 0, unit: 'm/m', description: 'Ground rising this much a metre or more is steep (0.7: 35°).' }, // prettier-ignore\n  steepSurface: { type: 'string', default: 'rock', description: 'The surface tag on steep ground.' },","is_error":false}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"43dd33eb-8f71-41ba-8daa-8b0297b9d69e","timestamp":"2026-11-05T09:10:28.832Z","tool_use_result":{"stdout":"49:  size: pair('Its extent along x and along z, each a whole number of cells: [24, 96].', true),\n50:  cell: { type: 'number', default: 1, minimum: 0.25, maximum: 8, unit: 'm', description: 'The grid’s spacing: a height stands a\n51:  origin: { type: 'array', items: { type: 'number' }, default: [0, 0, 0], unit: 'm', description: 'Its north-west corner, at th\n52:  seed: { type: 'integer', default: 0, description: 'The noise’s seed.' },\n53:  height: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'The noise’s range: rolling ground about this high \n54:  scale: { type: 'number', default: 40, minimum: 1, unit: 'm', description: 'The size of the noise’s features.' },\n55:  octaves: { type: 'integer', default: 5, minimum: 1, maximum: 8, description: 'The noise’s octaves.' },\n56:  ridges: { type: 'number', default: 0.5, minimum: 0, maximum: 1, description: 'How much ridged noise is added: shardfall’s hal\n57:  hills: { type: 'array', items: { type: 'object' }, default: [], description: 'Smooth domes added: { at: [x, z], radius, heigh\n58:  terrace: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'Rounds heights to steps this high (0: smooth).' }\n59:  flats: { type: 'array', items: { type: 'object' }, default: [], description: 'Footprints flattened: { rect: [x0, z0, x1, z1],\n60:  surface: { type: 'string', default: 'grass', description: 'The surface tag underfoot (footsteps, particles).' },\n61:  steep: { type: 'number', default: 0.7, minimum: 0, unit: 'm/m', description: 'Ground rising this much a metre or more is stee\n62:  steepSurface: { type: 'string', default: 'rock', description: 'The surface tag on steep ground.' },\n63:  high: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'The high layer shows from this height over the origi\n64:  materials: { type: 'array', items: { type: 'string' }, default: ['material:default'], description: 'Drawing only: the layers’\n120:  density: number;\n212:    cell: s.cell,\n213:    origin: [ox, oy, oz],\n215:    bounds: { min: [ox, low, oz], max: [ox + cols * s.cell, top, oz + rows * s.cell] },\n216:    surface: s.surface,\n217:    steep: s.steep,\n218:    steepSurface: s.steepSurface,\n219:    high: s.high,\n220:    materials: [...(s.materials as string[])],\n221:    seed: s.seed,\n222:    flats: flats.map((flat) => ({ rect: [...flat.rect] as const, height: flat.height, margin: flat.margin })),\n319:    description: 'Terrain: outdoor ground as a seeded heightfield (noise, hills, terraces, flattened footprints).',\n320:    fields: TERRAIN_FIELDS,\n321:    defineWith: \"defineTerrain('<id>', { size, cell, origin, seed, height, hills, flats, … })\",\n  cell: { type: 'number', default: 1, minimum: 0.25, maximum: 8, unit: 'm', description: 'The grid’s spacing: a height stands at every cell’s corners.' }, // prettier-ignore\n  origin: { type: 'array', items: { type: 'number' }, default: [0, 0, 0], unit: 'm', description: 'Its north-west corner, at the height everything else is added to: [x, y, z].' }, // prettier-ignore\n  seed: { type: 'integer', default: 0, description: 'The noise’s seed.' },\n  height: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'The noise’s range: rolling ground about this high (0: none).' }, // prettier-ignore\n  scale: { type: 'number', default: 40, minimum: 1, unit: 'm', description: 'The size of the noise’s features.' },\n  octaves: { type: 'integer', default: 5, minimum: 1, maximum: 8, description: 'The noise’s octaves.' },\n  ridges: { type: 'number', default: 0.5, minimum: 0, maximum: 1, description: 'How much ridged noise is added: shardfall’s half.' }, // prettier-ignore\n  hills: { type: 'array', items: { type: 'object' }, default: [], description: 'Smooth domes added: { at: [x, z], radius, height } (m; a negative height digs a hollow).' }, // prettier-ignore\n  terrace: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'Rounds heights to steps this high (0: smooth).' }, // prettier-ignore\n  flats: { type: 'array', items: { type: 'object' }, default: [], description: 'Footprints flattened: { rect: [x0, z0, x1, z1], height, margin } (m), the ground blending back over margin round each.' \n  surface: { type: 'string', default: 'grass', description: 'The surface tag underfoot (footsteps, particles).' },\n  steep: { type: 'number', default: 0.7, minimum: 0, unit: 'm/m', description: 'Ground rising this much a metre or more is steep (0.7: 35°).' }, // prettier-ignore\n  steepSurface: { type: 'string', default: 'rock', description: 'The surface tag on steep ground.' },","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KXjni9XbMkcDsRbviDsEPe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
