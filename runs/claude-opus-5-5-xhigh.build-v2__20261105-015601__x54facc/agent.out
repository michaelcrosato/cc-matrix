{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjbhW928R3xSKvvgMsEB","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15129,"cache_read_input_tokens":506309,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15129},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"25d32c5d-af49-47f3-84a8-6b232338a1a1","timestamp":"2026-11-05T10:09:54.579Z","request_id":"req_011CgjbhVaJM2ryWmsw2pK8E","thinking_duration_ms":2134,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjbhW928R3xSKvvgMsEB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011QTQzA922T7UuiXW7ovQRX","name":"Bash","input":{"command":"python3 - <<'EOF'\nimport re\np='labs/game/scenes/events/line.ts'\ns=open(p).read()\ns=s.replace(\"c.w.emit('splash', { big: true, x: d.x0, z: d.z0 + d.s, y: SEA_Y });\",\"c.w.emit('splashBig', { x: d.x0, z: d.z0 + d.s, y: SEA_Y });\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/paddle.ts'\ns=open(p).read()\ns=s.replace(\"c.w.emit('splash', { big: false, x: d.x, z: d.z, y: SEA_Y });\",\"c.w.emit('splash', { x: d.x, z: d.z, y: SEA_Y });\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/plunge.ts'\ns=open(p).read()\ns=s.replace(\"c.w.emit('splash', { big: !d.slip, x: d.x, z: d.z, y: SEA_Y });\",\"c.w.emit(d.slip ? 'splash' : 'splashBig', { x: d.x, z: d.z, y: SEA_Y });\")\nopen(p,'w').write(s)\np='labs/game/audio/sound.ts'\ns=open(p).read()\ns=s.replace(\"  topple: 'sfx:creak',\",\"  topple: 'sfx:creak',\\n  splash: 'sfx:splash',\\n  splashBig: 'sfx:splashBig',\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/ui/lines/index.ts <<'EOF'\n/**\n * @file Every line in the game, keyed by id; the sim emits ids, the page says them. An entry is a list of variants, each at\n * most two short sentences. A line group may name its speaker; otherwise the sim's `who` speaks it.\n *\n * Game code, a page's data (the tests read it too).\n *\n * @example\n * getLine('pose.rest', 0)?.text;\n */\nimport { PLAQUE_TEXT } from './plaques';\nimport { LINES_ACTIVITIES } from './activities';\nimport { LINES_PEOPLE } from './people';\nimport { LINES_STORY } from './story';\n\n/** The whole table. */\nexport const LINES: Readonly<Record<string, readonly string[]>> = {\n  ...LINES_ACTIVITIES,\n  ...LINES_PEOPLE,\n  ...LINES_STORY,\n};\n\n/** Who speaks a group when the sim does not say: by the first dotted part. */\nconst SPEAKER_OF: Readonly<Record<string, string>> = {};\n\n/** A line to speak. */\nexport interface Spoken {\n  text: string;\n  who?: string;\n}\n\n/** The `n`th variant of a line id, or null. Variants cycle with `n`. */\nexport function getLine(id: string, n = 0): Spoken | null {\n  const list = LINES[id];\n  if (!list || list.length === 0) return null;\n  const at = ((n % list.length) + list.length) % list.length;\n  return { text: list[at], who: SPEAKER_OF[id.split('.')[0]] };\n}\n\n/** Every line the game can say, for counting. */\nexport const allLines = (): string[] => [...Object.values(LINES).flat(), ...PLAQUE_TEXT];\nEOF\ncat > labs/game/ui/lines/plaques.ts <<'EOF'\n/**\n * @file The twelve \"Did you know?\" plaques: trivia that is not quite trivia. A plaque moves a little each night.\n *\n * Game code, a page's data.\n *\n * @example\n * PLAQUE_TEXT.length; // 12\n */\n\n/** The plaques, in order. */\nexport const PLAQUE_TEXT: readonly string[] = [\n  'Did you know? The average person leans two degrees toward the things they want.',\n  'Did you know? This plaque was four centimetres to the left on Tuesday.',\n  'Did you know? A flamingo stands on one leg because it has been told it is being watched.',\n  'Did you know? Gulls do not have a Wobble Age. They have been asked.',\n  'Did you know? Frogs do not blink. They are keeping count.',\n  'Did you know? Standing still burns nothing. It does use up the afternoon.',\n  'Did you know? Sand remembers the last person to rake it. Please rake kindly.',\n  'Did you know? A marble will always find the low point. We admire this.',\n  'Did you know? The ferry timetable is a work of fiction.',\n  'Did you know? Your left foot is slightly more honest than your right.',\n  'Did you know? This island is quite level. Please stop checking.',\n  'Did you know? The word \"plumb\" comes from lead. It has nothing to do with Instructor Plumb. We have asked them.',\n];\nEOF\ncat > labs/game/ui/lines/activities.ts <<'EOF'\n/**\n * @file What is said during the activities (PLAN.md section 13). Polite, level, a beat too honest. Never about bodies, only\n * about wobble. Plumb never uses an exclamation mark.\n *\n * Game code, a page's data.\n *\n * @example\n * LINES_ACTIVITIES['pose.rest'][0];\n */\n\n/** The lines, by id. */\nexport const LINES_ACTIVITIES: Readonly<Record<string, readonly string[]>> = {\n  'results.present': ['You were present. Attendance is a kind of score.', 'You attended. We have made a note.', 'That was your best score so far. It is also your only score so far. Well done on both.'],\n  'results.adequate': ['That was adequate. I chose that word carefully.', 'Adequate. Many people go their whole lives.', 'You fell. The mat forgives you. The mat is not me.'],\n  'results.composed': ['Composed. I mention it because it is rare.', 'Good. Now do that again, but as though you meant it.', 'Your knee is where it should be. I mention it because it is rare.'],\n  'results.serene': ['Serene. I would ask you to stop, but I would not mean it.', 'That was quite steady. Nobody will believe you.', 'Serene. You may tell people. They will not ask.'],\n  'results.unsettling': ['Unsettling. Please do that less near the other guests.', 'I have stopped taking notes. There is nothing to write.', 'Unsettling. The frog has asked for your name.'],\n\n  'ring.start': ['Stand on your mat. Stay inside the ring. It will get smaller. So will you.', 'A ring. You, inside it. That is the whole class.'],\n  'pose.demo.nothing': ['Seated Nothing. We sit, and we do it. Watch me not do anything.'],\n  'pose.demo.chair': ['The Patient Chair. There is no chair. Be patient about that.'],\n  'pose.demo.heron': ['The Heron. One leg, hands up. Herons do this for hours. Herons have nowhere to be.'],\n  'pose.demo.archer': ['The Archer. Long lunge, arms wide. There is no bow. There is no target. Hold it anyway.'],\n  'pose.demo.comma': ['The Sideways Comma. Bend to one side, then the other. Pause, as a comma would.'],\n  'pose.demo.napkin': ['The Folded Napkin. Forward from the hips. Neatly. As if someone were coming to dinner.'],\n  'pose.demo.bridge': ['The Polite Bridge. On your back. Lift your hips with your breath. Do not make a fuss.'],\n  'pose.demo.lighthouse': ['The Lighthouse. Tiptoe, arms straight up. Be visible from some distance.'],\n  'pose.now': ['Now you.', 'Your turn. Follow the dot.', 'Now you. I will wait. I am very good at it.'],\n  'pose.start': ['We will call that a start.', 'I will call that a start. I have called worse things a start.'],\n  'pose.hold': ['Hold. Breathe in. Breathe out. You have been doing this for years, and yet.', 'Stay there. Breathe with the ring.', 'Good. Stay. Nobody is watching. I am watching.', 'Hold. Your weight goes where your thumb goes.'],\n  'pose.other': ['Now the other side. The first side has been told.', 'And across. Slowly. It will still be there.'],\n  'pose.rest': ['And rest. You may stop wobbling now. Thank you for stopping.', 'And rest.', 'Rest. You did not need to look at me like that.'],\n  'pose.gull': ['There is a gull on you. Please do not make it a whole thing.', 'Oh. That is the Gull. It likes you. It likes everyone. It is not personal.'],\n\n  'morning.question.1': ['Have you ever stood on one foot when nobody was looking?'],\n  'morning.question.2': ['Did you sleep on your left side? You do not have to answer. I can tell. I cannot tell. Did you?'],\n  'morning.question.3': ['Have you been leaning toward anything lately? A person? A decision?'],\n  'morning.question.4': ['If everyone else went east, would you also go east? For no reason?'],\n  'morning.question.5': ['Do you feel the floor is where it was yesterday?'],\n  'morning.question.6': ['Are you staying? You do not have to answer. The ferry has answered.'],\n  'morning.yes': ['I know.', 'I thought so. It shows in your ankles. I am joking. I do not know what ankles do.'],\n  'morning.no': ['I know.', 'That is what people say.', 'Fine. I will put down \"probably\".'],\n  'morning.silent': ['You did not answer. That is also an answer. I have written it down.'],\n  'morning.ring': ['Please stand still.', 'Stay inside the ring. No reason.', 'Please keep to the centre. No reason.'],\n  'morning.teach.ring': ['Please step on me. Not like that. Actually, like that is fine. Now use the lean to stay in the ring.'],\n  'morning.reach': ['Now reach for each one. Do not stretch. Lean.', 'Each target in turn, please. They are not going anywhere. Probably.'],\n  'morning.teach.reach': ['That was still. Now lean to each target and stay a moment. Your weight is the whole game. Well, the whole test.'],\n  'morning.foot.left': ['Left foot only now. Hold it. The other one can have the morning off.'],\n  'morning.foot.right': ['Right foot only now. Hold it. The other one can have the morning off.'],\n\n  'pond.start': ['Sit. Breathe with the ring. Press nothing. That is the entire exercise.', 'This is Still Pond. There is one rule, and you already know it, and you are about to break it.'],\n  'pond.end': ['You did nothing for seventy-five seconds. Nobody has ever been prouder of you. Nobody was watching.'],\n  'pond.lure.psst': ['Psst. Is this on? Press the button for yes.'],\n  'pond.lure.stone': ['Your stone is buzzing. Mine is buzzing. Check it. Everyone is checking theirs.'],\n  'pond.lure.wrong': ['You are doing it wrong.'],\n\n  'group.start': ['Today we are a class. Do not look at each other. You will look at each other.', 'Three classes. Find a mat. There are enough mats. I counted them twice.'],\n  'group.podium': ['One of you was the least wobbly. There is a sash. It is not a large sash.'],\n\n  'reps.start': ['Reps. The band goes down. You go down. That is how it has always been.', 'Follow the band with your thumb. Your body will find out afterwards.'],\n  'reps.knees': ['Deep Knees. Pull back to sink. Do not rush. The floor is not going anywhere. Today.'],\n  'reps.pushups': ['Polite Push-Ups. Hold both feet. Palms on the floor. Say sorry to the floor, if you like.'],\n  'reps.lunges': ['Side Lunges. Lean left, lean right, and back. Gerald finished these on Tuesday.'],\n  'reps.lying': ['Four more. I may be lying. We will both find out.', 'Nearly. I have said nearly before.'],\n\n  'step.start': ['Step Class. Feet on the beat. The others will follow you. I am sorry to tell you that.', 'Left, right, both. The class does what you do. Please think of the class.'],\n\n  'line.start': ['Left foot, right foot. Lean against whatever happens. I am in the boat if you need me. I am not sure what I would do.'],\n  'line.flag': ['That is a flag. You are allowed to feel something about it.', 'A flag. I will bring you back to this one, later, when you fall.'],\n  'line.gull': ['A gull is on your arm. It adds some weight. Flick the stick quickly to tell it no.', 'Is that the Gull? Flick it off. Flick the stick. Do not hit the Gull. We have rules about the Gull.'],\n  'line.flicked': ['It has gone. It has not forgiven you.', 'The Gull has left. It will be back when you are busy.'],\n  'line.fall': ['You have left the line. The line is fine.', 'That was a large splash. I have written \"large\".', 'You are in the water. The line has asked me to tell you it feels nothing.'],\n  'line.done': ['You crossed. The rock is pleased. It will not say so.'],\n  'line.closes': ['The line closes at this time.'],\n\n  'paddle.start': ['Lean forward to go. Lean sideways to turn. Your feet can paddle, if they want to be useful.'],\n  'paddle.done': ['Twelve gates. Very tidy. I will not tell the buoys, they get ideas.'],\n  'paddle.wake': ['That is the ferry wake. There is no ferry. Please do not think about it.'],\n  'paddle.turtle': ['A turtle is crossing. It has right of way. It has always had right of way.'],\n  'paddle.fall': ['Back on the board, please. The sea is not for standing in.', 'That was a splash. Remount when you feel ready. You have three seconds.'],\n  'paddle.time': ['The lagoon is closing. We did not tell you it could do that.'],\n\n  'garden.start': ['Tilt the tray. Roll the marbles home. It is a garden. Nothing is alive in it. Be gentle anyway.'],\n  'garden.tray': ['Good. I will rake that.', 'Next tray. They are all quite similar. So are we all.', 'That marble has somewhere to be now. That is more than most.'],\n\n  'plunge.compose': ['Stand at the lip. Hold the ring and breathe. Nobody will push you. I have checked the rota.', 'Compose yourself. There is water at the bottom. I checked this morning.'],\n  'plunge.go': ['Now. Let go when the gauge is at the top.', 'Let go at the top. Only at the top. That is the only advice I have ever had.'],\n  'plunge.slip': ['You have waited long enough for the cliff to make the decision.', 'Ah. You are slipping. That is also a way to do it.'],\n  'plunge.slipped': ['A small splash. A small splash is a splash.'],\n  'plunge.great': ['Very clean. The Gulls are confused. One of them still gave you a four.', 'That was a very good dive. One judge always gives a four. It is his only number.'],\n  'plunge.dive': ['That was a dive. Mostly in the sense that you went down.', 'You have reached the water. Everybody does. You did it in your own way.'],\n\n  'hoop.start': ['Spin your stick in circles. Not too slow, not too fast. Catch the hoops I throw. I have no arms. Do not ask.'],\n\n  'jog.start': ['Morning.'],\n  'jog.chatter': ['That is the pier. It is very nearly straight.', 'We jog past this plaque every day. It used to be over there.', 'Gerald has done this eleven thousand times. I am not sure he knows.', 'The sea is flat today. Slightly flat. In one direction.', 'That is the lighthouse. It leans to the right. It is a matter of perspective.', 'Keep up with Gerald, please. Nobody has caught him. Nobody has asked him why.', 'Your feet can help. Left, right, quickly. It makes you faster. I do not understand it either.'],\n  'jog.end': ['Nice weather for it.'],\n\n  'tilt.outOfTrue': ['The island is now six degrees out of true. Please remain calm. Calm is mandatory.'],\n  'tilt.east': ['Guests are reminded to distribute themselves evenly. Guests are reminded to go east.'],\n  'tilt.calmed': ['They are following you. I do not recommend looking back. They are very polite.', 'Good. They think you know where you are going. Do not tell them.'],\n  'tilt.calmedNobody': ['You calmed nobody. A loungers seems calmer. Stand closer.'],\n  'tilt.shuffle': ['Those who remain may now shuffle uphill by themselves. We will call that a start.'],\n  'tilt.nan': ['I have been here since Tuesday.'],\n  'tilt.weights': ['There are carts. Your cairn is in one of them. Crank with your feet. Lean into the slope. I will not look at your cairn.'],\n  'tilt.start': ['We will call that a start. Please go to the stone.'],\n  'tilt.stone': ['Go to the stone. It says \"Do not\". Please do. Now it is your balance. All of it.'],\n  'tilt.again': ['Again, please.', 'Again.'],\n  'tilt.balanced': ['Everything is balanced now. Please do not tell anyone about the rock.'],\n  'tilt.hm': ['Hm.'],\n  'tilt.rock': ['Everything is fine. If anyone asks, everything was always fine.'],\n  'after.stay': ['You may stay as long as you like. The ferry does not return.'],\n};\nEOF\ncat > labs/game/ui/lines/people.ts <<'EOF'\n/**\n * @file What the people say when you walk up to them, by person and day. Each has new lines each day; Gerald says only\n * \"Morning.\" until Day 4.\n *\n * Game code, a page's data.\n *\n * @example\n * LINES_PEOPLE['talk.gerald.1'][0]; // 'Morning.'\n */\n\n/** The lines, by id. */\nexport const LINES_PEOPLE: Readonly<Record<string, readonly string[]>> = {\n  'talk.tare.1': [\n    'Welcome to Little Fulcrum. I am Tare. I used to weigh people. We don\\'t talk about that.',\n    'I no longer measure weight. It made people sad, and it made me sad. Now I only measure how much you wobble.',\n    'The ferry has gone. It does that. Your things are in your hut. Some of your things.',\n    'Please keep to the centre. No reason.',\n  ],\n  'talk.tare.2': ['You came back. A lot of people say they will.', 'The plaques have moved. They have not. Please do not mention it to them.', 'Everything is fine. It is very fine. I am fine.', 'Some guests like to wave at Gerald. Gerald allows it.'],\n  'talk.tare.3': ['If your drink slides, that is a feature of the drink.', 'The water looks level from here. I recommend staying here.', 'Have you been up to the Centre Stone? Please do not. It says so on the plate.', 'I am told I hum when I am nervous. I do not have a mouth.'],\n  'talk.tare.4': ['We don\\'t mention it to guests. You\\'re a guest. I didn\\'t mention it.', 'The marbles do that by themselves now. It is a new kind of garden.', 'I weighed the island once. Do not tell Instructor Plumb. It was the most anyone has ever weighed.', 'One rock. It is a good rock. I would not say anything against that rock.'],\n  'talk.tare.5': ['Today is a very normal day. Please stand further east.', 'Everything is fine. If anyone asks, everything was always fine.', 'If you see a lot of people on the east lawn, you did not. It is fully booked.', 'I have stopped being able to read my own needle.'],\n  'talk.tare.6': ['You stayed. I did not think anyone would. I will not weigh you. I promise.', 'It is level now. I would know. I checked it with myself.', 'Same time tomorrow? There is only the same time, now.', 'That was your best morning so far. I will say that every morning.'],\n  'talk.plumb.1': ['Welcome. You are wobbling. It is all right. Everyone is, at first.', 'Your first class is at the Pavilion. It is the white one. They are all white.', 'Breathe in. Breathe out. You have been doing this for years, and yet.'],\n  'talk.plumb.2': ['Good. Now do that again, but as though you meant it.', 'You look taller today. No. I have looked again.', 'I do not get tired. I have tried.'],\n  'talk.plumb.3': ['Water is only a floor that has stopped trying.', 'The line is for the balance. The boat is for the rest of you.', 'I have never fallen. I once sat down quite quickly.'],\n  'talk.plumb.4': ['Some of the marbles have left. Let them go.', 'I see you have been talking to the scale. It talks.', 'Your knee is where it should be. I mention it because it is rare.'],\n  'talk.plumb.5': ['Class is at the usual time. Please arrive from the east.', 'There will be weather. I do not call it weather. I do not call it anything.', 'My hair is not moving. That is the correct number of times for it to move.'],\n  'talk.plumb.6': ['You remained. Good. I have no further remarks.', 'Do not tell me about the storm. I was there. I was perfectly still.', 'Tomorrow, we will do this again. It will be the same. It will be better.'],\n  'talk.gerald.1': ['Morning.'],\n  'talk.gerald.2': ['Morning.'],\n  'talk.gerald.3': ['Morning.'],\n  'talk.gerald.4': ['Afternoon.', 'It is the afternoon now.', 'I stand here. Over there is further east.'],\n  'talk.gerald.5': ['East.', 'Morning. East.', 'It is steep, for a Thursday.'],\n  'talk.gerald.6': ['Morning.', 'Still here.', 'Nice weather for it.'],\n  'talk.bex.1': ['My mum says this is good for me.', 'I got a 98. I wasn\\'t trying.', 'This is a stone. It looks like a phone. There is no signal here. It is also a stone.', 'Are you going to do the thing on the mat? Everyone does the thing on the mat.'],\n  'talk.bex.2': ['Plaques move here. Nobody cares. I care a bit. Not a lot.', 'I can do the Heron for an hour. I did it by accident.', 'My stone says you are doing fine. I typed that.'],\n  'talk.bex.3': ['The drinks go that way. All of them. I have started betting on them.', 'Have you noticed the sea looks sort of wrong? No? Cool. Me neither.', 'If you fall in, it is warmer than it looks. Don\\'t ask how I know.'],\n  'talk.bex.4': ['The scale told you too, right? About the rock? It told me and it told the frog.', 'I got a 99. Annoying. I was trying.', 'Nothing is level here. Have you ever seen a level? I found one. It left.'],\n  'talk.bex.5': ['Everyone is walking east like it is normal. It is normal. It is fine.', 'My mum says to stay away from weather. I think she means this.', 'I am going to stand here until it stops being a problem.'],\n  'talk.bex.6': ['So that happened. Nobody is going to believe my stone.', 'My mum still says this is good for me. I\\'m starting to worry she is right.', 'Why are you still here? No, same.'],\n  'talk.nan.1': ['I\\'ve been standing here since Tuesday.', 'Which Tuesday? Yes.', 'I am ninety-one. My Wobble Age is nineteen. I do not know what it means either.', 'You are young. You will get steadier, or you won\\'t.'],\n  'talk.nan.2': ['You keep moving about. Why is that?', 'Nobody has seen me arrive. I like it that way.', 'I knew the scale when it was still weighing. A different person. Very sad.'],\n  'talk.nan.3': ['Water is lovely. I stay out of it.', 'There is a turtle in there older than I am. We nod.', 'My late husband fell over in 1962. Once. He never heard the end of it.'],\n  'talk.nan.4': ['The rock. Yes. We all know about the rock. It was my idea.', 'There are worse things to stand on than one rock.', 'You will want to know what to do. You will do it. Don\\'t ask me.'],\n  'talk.nan.5': ['I\\'m going east. I may already be there.', 'Don\\'t worry about me, dear. Worry about the deckchairs.', 'When it comes, keep your knees soft and your opinions to yourself.'],\n  'talk.nan.6': ['There you are. I\\'ve been here since Tuesday.', 'That was a good one. Nineteen sixty-two was better.', 'You may stay. I did.'],\n  'hut.early': ['The day is not finished. Your hut knows. Please see the Programme.', 'You still have things on today. I will tell the bed.'],\n  'stone.donot': ['It says \"Do not\". I would not. Today.', 'Please do not stand there. No reason.'],\n  'station.notyet': ['That is for another day. You may look at it. Looking is free.', 'Nobody is teaching that yet. Please see the Programme.'],\n};\nEOF\ncat > labs/game/ui/lines/story.ts <<'EOF'\n/**\n * @file The five-day story, in one-liners (PLAN.md section 2), notices on the Noticeboard, evening remarks, and what the\n * Wobble Age comparison says, in a tone of mild scientific surprise.\n *\n * Game code, a page's data.\n *\n * @example\n * LINES_STORY['day.1.intro'][0];\n */\n\n/** The lines, by id. */\nexport const LINES_STORY: Readonly<Record<string, readonly string[]>> = {\n  'day.1.intro': ['Welcome to Little Fulcrum. The ferry has left. Please step on me when you are ready.'],\n  'day.2.intro': ['Good morning. The plaques have moved. They have not. Guests are reminded to distribute themselves evenly.'],\n  'day.3.intro': ['Good morning. Today is about water. Drinks may slide along tables. That is a feature of the drink.'],\n  'day.4.intro': ['Good morning. The marbles have started without you. Please do not encourage them.'],\n  'day.5.intro': ['Good morning. There is a class. Then there may be some weather. Please stand further east.'],\n  'day.6.intro': ['You stayed. Good morning. Everything is level. Your Morning Check is ready. It always is.'],\n\n  'evening.1': ['Today you wobbled less than you might have. Goodnight.', 'Your first day. You stood on a lot of things. Goodnight.'],\n  'evening.2': ['Today your plaques stayed roughly where you left them. Goodnight.', 'You were adequately distributed today. Goodnight.'],\n  'evening.3': ['Today the water held you, mostly. Goodnight.', 'You came back from the sea twice as yourself. Goodnight.'],\n  'evening.4': ['The island sits on one rock. We don\\'t mention it to guests. You\\'re a guest. I didn\\'t mention it. Goodnight.'],\n  'evening.5': ['Everything is balanced now. Goodnight, I suppose.'],\n  'evening.6': ['Another day, and you are still here. Goodnight.', 'Tomorrow will be level. Goodnight.'],\n\n  'age.first': ['This is your first Wobble Age. It is terrible. Everyone\\'s is. Yours is especially so, but in a promising way.', 'Your Wobble Age is {age}. This is high. You are welcome to feel something about that.'],\n  'age.younger': ['Your Wobble Age is {age}. Yesterday it was {before}. You have become {diff} years younger by standing still. Science.', 'Your Wobble Age is {age}. Yesterday: {before}. We cannot explain it, and we have stopped trying.'],\n  'age.older': ['Your Wobble Age is {age}. Yesterday it was {before}. That is {diff} years in one night. Did you do something? You do not have to tell me.', 'Your Wobble Age is {age}. Yesterday: {before}. I will write that down in pencil.'],\n  'age.same': ['Your Wobble Age is {age}. It was {age} yesterday. You have not aged at all. We will be looking into you.'],\n\n  'notice.1': ['Please keep to the centre.'],\n  'notice.2': ['Notice: Guests are reminded to distribute themselves evenly.'],\n  'notice.3': ['Notice: If your drink slides, that is a feature of the drink.'],\n  'notice.4': ['Notice: Marbles found moving should be left alone. They know what they are doing.'],\n  'notice.5': ['Notice: The east lawn is fully booked. Please enjoy the east lawn.'],\n  'notice.6': ['Notice: The ferry timetable has been removed. It was upsetting people.'],\n\n  'unlock.expert': ['Ten pebbles. Expert classes are open: a smaller ring, and more sway. Nobody asked for this.'],\n  'unlock.color': ['Twenty pebbles. There is a new tracksuit in your hut. It was always there.'],\n  'unlock.headband': ['Thirty pebbles. There are new tracksuits. They will not help.'],\n  'unlock.stamps': ['Forty pebbles. You have the Unsettling stamp set. We do not know who approved it.'],\n};\nEOF\npython3 - <<'EOF'\nimport re,sys\ns=open('labs/game/ui/lines/activities.ts').read()+open('labs/game/ui/lines/people.ts').read()+open('labs/game/ui/lines/story.ts').read()+open('labs/game/ui/lines/plaques.ts').read()\nprint('approx lines', len(re.findall(r\"'[A-Z][^']*(?:\\\\'[^']*)*'\",s)))\nEOF","description":"Write all the game's lines"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15129,"cache_read_input_tokens":506309,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15129},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"a8849e05-3995-45b2-9bb2-42bd141d01e5","timestamp":"2026-11-05T10:11:35.362Z","request_id":"req_011CgjbhVaJM2ryWmsw2pK8E","wire_tool_inputs":{"toolu_011QTQzA922T7UuiXW7ovQRX":{"command":"python3 - <<'EOF'\nimport re\np='labs/game/scenes/events/line.ts'\ns=open(p).read()\ns=s.replace(\"c.w.emit('splash', { big: true, x: d.x0, z: d.z0 + d.s, y: SEA_Y });\",\"c.w.emit('splashBig', { x: d.x0, z: d.z0 + d.s, y: SEA_Y });\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/paddle.ts'\ns=open(p).read()\ns=s.replace(\"c.w.emit('splash', { big: false, x: d.x, z: d.z, y: SEA_Y });\",\"c.w.emit('splash', { x: d.x, z: d.z, y: SEA_Y });\")\nopen(p,'w').write(s)\np='labs/game/scenes/events/plunge.ts'\ns=open(p).read()\ns=s.replace(\"c.w.emit('splash', { big: !d.slip, x: d.x, z: d.z, y: SEA_Y });\",\"c.w.emit(d.slip ? 'splash' : 'splashBig', { x: d.x, z: d.z, y: SEA_Y });\")\nopen(p,'w').write(s)\np='labs/game/audio/sound.ts'\ns=open(p).read()\ns=s.replace(\"  topple: 'sfx:creak',\",\"  topple: 'sfx:creak',\\n  splash: 'sfx:splash',\\n  splashBig: 'sfx:splashBig',\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/ui/lines/index.ts <<'EOF'\n/**\n * @file Every line in the game, keyed by id; the sim emits ids, the page says them. An entry is a list of variants, each at\n * most two short sentences. A line group may name its speaker; otherwise the sim's `who` speaks it.\n *\n * Game code, a page's data (the tests read it too).\n *\n * @example\n * getLine('pose.rest', 0)?.text;\n */\nimport { PLAQUE_TEXT } from './plaques';\nimport { LINES_ACTIVITIES } from './activities';\nimport { LINES_PEOPLE } from './people';\nimport { LINES_STORY } from './story';\n\n/** The whole table. */\nexport const LINES: Readonly<Record<string, readonly string[]>> = {\n  ...LINES_ACTIVITIES,\n  ...LINES_PEOPLE,\n  ...LINES_STORY,\n};\n\n/** Who speaks a group when the sim does not say: by the first dotted part. */\nconst SPEAKER_OF: Readonly<Record<string, string>> = {};\n\n/** A line to speak. */\nexport interface Spoken {\n  text: string;\n  who?: string;\n}\n\n/** The `n`th variant of a line id, or null. Variants cycle with `n`. */\nexport function getLine(id: string, n = 0): Spoken | null {\n  const list = LINES[id];\n  if (!list || list.length === 0) return null;\n  const at = ((n % list.length) + list.length) % list.length;\n  return { text: list[at], who: SPEAKER_OF[id.split('.')[0]] };\n}\n\n/** Every line the game can say, for counting. */\nexport const allLines = (): string[] => [...Object.values(LINES).flat(), ...PLAQUE_TEXT];\nEOF\ncat > labs/game/ui/lines/plaques.ts <<'EOF'\n/**\n * @file The twelve \"Did you know?\" plaques: trivia that is not quite trivia. A plaque moves a little each night.\n *\n * Game code, a page's data.\n *\n * @example\n * PLAQUE_TEXT.length; // 12\n */\n\n/** The plaques, in order. */\nexport const PLAQUE_TEXT: readonly string[] = [\n  'Did you know? The average person leans two degrees toward the things they want.',\n  'Did you know? This plaque was four centimetres to the left on Tuesday.',\n  'Did you know? A flamingo stands on one leg because it has been told it is being watched.',\n  'Did you know? Gulls do not have a Wobble Age. They have been asked.',\n  'Did you know? Frogs do not blink. They are keeping count.',\n  'Did you know? Standing still burns nothing. It does use up the afternoon.',\n  'Did you know? Sand remembers the last person to rake it. Please rake kindly.',\n  'Did you know? A marble will always find the low point. We admire this.',\n  'Did you know? The ferry timetable is a work of fiction.',\n  'Did you know? Your left foot is slightly more honest than your right.',\n  'Did you know? This island is quite level. Please stop checking.',\n  'Did you know? The word \"plumb\" comes from lead. It has nothing to do with Instructor Plumb. We have asked them.',\n];\nEOF\ncat > labs/game/ui/lines/activities.ts <<'EOF'\n/**\n * @file What is said during the activities (PLAN.md section 13). Polite, level, a beat too honest. Never about bodies, only\n * about wobble. Plumb never uses an exclamation mark.\n *\n * Game code, a page's data.\n *\n * @example\n * LINES_ACTIVITIES['pose.rest'][0];\n */\n\n/** The lines, by id. */\nexport const LINES_ACTIVITIES: Readonly<Record<string, readonly string[]>> = {\n  'results.present': ['You were present. Attendance is a kind of score.', 'You attended. We have made a note.', 'That was your best score so far. It is also your only score so far. Well done on both.'],\n  'results.adequate': ['That was adequate. I chose that word carefully.', 'Adequate. Many people go their whole lives.', 'You fell. The mat forgives you. The mat is not me.'],\n  'results.composed': ['Composed. I mention it because it is rare.', 'Good. Now do that again, but as though you meant it.', 'Your knee is where it should be. I mention it because it is rare.'],\n  'results.serene': ['Serene. I would ask you to stop, but I would not mean it.', 'That was quite steady. Nobody will believe you.', 'Serene. You may tell people. They will not ask.'],\n  'results.unsettling': ['Unsettling. Please do that less near the other guests.', 'I have stopped taking notes. There is nothing to write.', 'Unsettling. The frog has asked for your name.'],\n\n  'ring.start': ['Stand on your mat. Stay inside the ring. It will get smaller. So will you.', 'A ring. You, inside it. That is the whole class.'],\n  'pose.demo.nothing': ['Seated Nothing. We sit, and we do it. Watch me not do anything.'],\n  'pose.demo.chair': ['The Patient Chair. There is no chair. Be patient about that.'],\n  'pose.demo.heron': ['The Heron. One leg, hands up. Herons do this for hours. Herons have nowhere to be.'],\n  'pose.demo.archer': ['The Archer. Long lunge, arms wide. There is no bow. There is no target. Hold it anyway.'],\n  'pose.demo.comma': ['The Sideways Comma. Bend to one side, then the other. Pause, as a comma would.'],\n  'pose.demo.napkin': ['The Folded Napkin. Forward from the hips. Neatly. As if someone were coming to dinner.'],\n  'pose.demo.bridge': ['The Polite Bridge. On your back. Lift your hips with your breath. Do not make a fuss.'],\n  'pose.demo.lighthouse': ['The Lighthouse. Tiptoe, arms straight up. Be visible from some distance.'],\n  'pose.now': ['Now you.', 'Your turn. Follow the dot.', 'Now you. I will wait. I am very good at it.'],\n  'pose.start': ['We will call that a start.', 'I will call that a start. I have called worse things a start.'],\n  'pose.hold': ['Hold. Breathe in. Breathe out. You have been doing this for years, and yet.', 'Stay there. Breathe with the ring.', 'Good. Stay. Nobody is watching. I am watching.', 'Hold. Your weight goes where your thumb goes.'],\n  'pose.other': ['Now the other side. The first side has been told.', 'And across. Slowly. It will still be there.'],\n  'pose.rest': ['And rest. You may stop wobbling now. Thank you for stopping.', 'And rest.', 'Rest. You did not need to look at me like that.'],\n  'pose.gull': ['There is a gull on you. Please do not make it a whole thing.', 'Oh. That is the Gull. It likes you. It likes everyone. It is not personal.'],\n\n  'morning.question.1': ['Have you ever stood on one foot when nobody was looking?'],\n  'morning.question.2': ['Did you sleep on your left side? You do not have to answer. I can tell. I cannot tell. Did you?'],\n  'morning.question.3': ['Have you been leaning toward anything lately? A person? A decision?'],\n  'morning.question.4': ['If everyone else went east, would you also go east? For no reason?'],\n  'morning.question.5': ['Do you feel the floor is where it was yesterday?'],\n  'morning.question.6': ['Are you staying? You do not have to answer. The ferry has answered.'],\n  'morning.yes': ['I know.', 'I thought so. It shows in your ankles. I am joking. I do not know what ankles do.'],\n  'morning.no': ['I know.', 'That is what people say.', 'Fine. I will put down \"probably\".'],\n  'morning.silent': ['You did not answer. That is also an answer. I have written it down.'],\n  'morning.ring': ['Please stand still.', 'Stay inside the ring. No reason.', 'Please keep to the centre. No reason.'],\n  'morning.teach.ring': ['Please step on me. Not like that. Actually, like that is fine. Now use the lean to stay in the ring.'],\n  'morning.reach': ['Now reach for each one. Do not stretch. Lean.', 'Each target in turn, please. They are not going anywhere. Probably.'],\n  'morning.teach.reach': ['That was still. Now lean to each target and stay a moment. Your weight is the whole game. Well, the whole test.'],\n  'morning.foot.left': ['Left foot only now. Hold it. The other one can have the morning off.'],\n  'morning.foot.right': ['Right foot only now. Hold it. The other one can have the morning off.'],\n\n  'pond.start': ['Sit. Breathe with the ring. Press nothing. That is the entire exercise.', 'This is Still Pond. There is one rule, and you already know it, and you are about to break it.'],\n  'pond.end': ['You did nothing for seventy-five seconds. Nobody has ever been prouder of you. Nobody was watching.'],\n  'pond.lure.psst': ['Psst. Is this on? Press the button for yes.'],\n  'pond.lure.stone': ['Your stone is buzzing. Mine is buzzing. Check it. Everyone is checking theirs.'],\n  'pond.lure.wrong': ['You are doing it wrong.'],\n\n  'group.start': ['Today we are a class. Do not look at each other. You will look at each other.', 'Three classes. Find a mat. There are enough mats. I counted them twice.'],\n  'group.podium': ['One of you was the least wobbly. There is a sash. It is not a large sash.'],\n\n  'reps.start': ['Reps. The band goes down. You go down. That is how it has always been.', 'Follow the band with your thumb. Your body will find out afterwards.'],\n  'reps.knees': ['Deep Knees. Pull back to sink. Do not rush. The floor is not going anywhere. Today.'],\n  'reps.pushups': ['Polite Push-Ups. Hold both feet. Palms on the floor. Say sorry to the floor, if you like.'],\n  'reps.lunges': ['Side Lunges. Lean left, lean right, and back. Gerald finished these on Tuesday.'],\n  'reps.lying': ['Four more. I may be lying. We will both find out.', 'Nearly. I have said nearly before.'],\n\n  'step.start': ['Step Class. Feet on the beat. The others will follow you. I am sorry to tell you that.', 'Left, right, both. The class does what you do. Please think of the class.'],\n\n  'line.start': ['Left foot, right foot. Lean against whatever happens. I am in the boat if you need me. I am not sure what I would do.'],\n  'line.flag': ['That is a flag. You are allowed to feel something about it.', 'A flag. I will bring you back to this one, later, when you fall.'],\n  'line.gull': ['A gull is on your arm. It adds some weight. Flick the stick quickly to tell it no.', 'Is that the Gull? Flick it off. Flick the stick. Do not hit the Gull. We have rules about the Gull.'],\n  'line.flicked': ['It has gone. It has not forgiven you.', 'The Gull has left. It will be back when you are busy.'],\n  'line.fall': ['You have left the line. The line is fine.', 'That was a large splash. I have written \"large\".', 'You are in the water. The line has asked me to tell you it feels nothing.'],\n  'line.done': ['You crossed. The rock is pleased. It will not say so.'],\n  'line.closes': ['The line closes at this time.'],\n\n  'paddle.start': ['Lean forward to go. Lean sideways to turn. Your feet can paddle, if they want to be useful.'],\n  'paddle.done': ['Twelve gates. Very tidy. I will not tell the buoys, they get ideas.'],\n  'paddle.wake': ['That is the ferry wake. There is no ferry. Please do not think about it.'],\n  'paddle.turtle': ['A turtle is crossing. It has right of way. It has always had right of way.'],\n  'paddle.fall': ['Back on the board, please. The sea is not for standing in.', 'That was a splash. Remount when you feel ready. You have three seconds.'],\n  'paddle.time': ['The lagoon is closing. We did not tell you it could do that.'],\n\n  'garden.start': ['Tilt the tray. Roll the marbles home. It is a garden. Nothing is alive in it. Be gentle anyway.'],\n  'garden.tray': ['Good. I will rake that.', 'Next tray. They are all quite similar. So are we all.', 'That marble has somewhere to be now. That is more than most.'],\n\n  'plunge.compose': ['Stand at the lip. Hold the ring and breathe. Nobody will push you. I have checked the rota.', 'Compose yourself. There is water at the bottom. I checked this morning.'],\n  'plunge.go': ['Now. Let go when the gauge is at the top.', 'Let go at the top. Only at the top. That is the only advice I have ever had.'],\n  'plunge.slip': ['You have waited long enough for the cliff to make the decision.', 'Ah. You are slipping. That is also a way to do it.'],\n  'plunge.slipped': ['A small splash. A small splash is a splash.'],\n  'plunge.great': ['Very clean. The Gulls are confused. One of them still gave you a four.', 'That was a very good dive. One judge always gives a four. It is his only number.'],\n  'plunge.dive': ['That was a dive. Mostly in the sense that you went down.', 'You have reached the water. Everybody does. You did it in your own way.'],\n\n  'hoop.start': ['Spin your stick in circles. Not too slow, not too fast. Catch the hoops I throw. I have no arms. Do not ask.'],\n\n  'jog.start': ['Morning.'],\n  'jog.chatter': ['That is the pier. It is very nearly straight.', 'We jog past this plaque every day. It used to be over there.', 'Gerald has done this eleven thousand times. I am not sure he knows.', 'The sea is flat today. Slightly flat. In one direction.', 'That is the lighthouse. It leans to the right. It is a matter of perspective.', 'Keep up with Gerald, please. Nobody has caught him. Nobody has asked him why.', 'Your feet can help. Left, right, quickly. It makes you faster. I do not understand it either.'],\n  'jog.end': ['Nice weather for it.'],\n\n  'tilt.outOfTrue': ['The island is now six degrees out of true. Please remain calm. Calm is mandatory.'],\n  'tilt.east': ['Guests are reminded to distribute themselves evenly. Guests are reminded to go east.'],\n  'tilt.calmed': ['They are following you. I do not recommend looking back. They are very polite.', 'Good. They think you know where you are going. Do not tell them.'],\n  'tilt.calmedNobody': ['You calmed nobody. A loungers seems calmer. Stand closer.'],\n  'tilt.shuffle': ['Those who remain may now shuffle uphill by themselves. We will call that a start.'],\n  'tilt.nan': ['I have been here since Tuesday.'],\n  'tilt.weights': ['There are carts. Your cairn is in one of them. Crank with your feet. Lean into the slope. I will not look at your cairn.'],\n  'tilt.start': ['We will call that a start. Please go to the stone.'],\n  'tilt.stone': ['Go to the stone. It says \"Do not\". Please do. Now it is your balance. All of it.'],\n  'tilt.again': ['Again, please.', 'Again.'],\n  'tilt.balanced': ['Everything is balanced now. Please do not tell anyone about the rock.'],\n  'tilt.hm': ['Hm.'],\n  'tilt.rock': ['Everything is fine. If anyone asks, everything was always fine.'],\n  'after.stay': ['You may stay as long as you like. The ferry does not return.'],\n};\nEOF\ncat > labs/game/ui/lines/people.ts <<'EOF'\n/**\n * @file What the people say when you walk up to them, by person and day. Each has new lines each day; Gerald says only\n * \"Morning.\" until Day 4.\n *\n * Game code, a page's data.\n *\n * @example\n * LINES_PEOPLE['talk.gerald.1'][0]; // 'Morning.'\n */\n\n/** The lines, by id. */\nexport const LINES_PEOPLE: Readonly<Record<string, readonly string[]>> = {\n  'talk.tare.1': [\n    'Welcome to Little Fulcrum. I am Tare. I used to weigh people. We don\\'t talk about that.',\n    'I no longer measure weight. It made people sad, and it made me sad. Now I only measure how much you wobble.',\n    'The ferry has gone. It does that. Your things are in your hut. Some of your things.',\n    'Please keep to the centre. No reason.',\n  ],\n  'talk.tare.2': ['You came back. A lot of people say they will.', 'The plaques have moved. They have not. Please do not mention it to them.', 'Everything is fine. It is very fine. I am fine.', 'Some guests like to wave at Gerald. Gerald allows it.'],\n  'talk.tare.3': ['If your drink slides, that is a feature of the drink.', 'The water looks level from here. I recommend staying here.', 'Have you been up to the Centre Stone? Please do not. It says so on the plate.', 'I am told I hum when I am nervous. I do not have a mouth.'],\n  'talk.tare.4': ['We don\\'t mention it to guests. You\\'re a guest. I didn\\'t mention it.', 'The marbles do that by themselves now. It is a new kind of garden.', 'I weighed the island once. Do not tell Instructor Plumb. It was the most anyone has ever weighed.', 'One rock. It is a good rock. I would not say anything against that rock.'],\n  'talk.tare.5': ['Today is a very normal day. Please stand further east.', 'Everything is fine. If anyone asks, everything was always fine.', 'If you see a lot of people on the east lawn, you did not. It is fully booked.', 'I have stopped being able to read my own needle.'],\n  'talk.tare.6': ['You stayed. I did not think anyone would. I will not weigh you. I promise.', 'It is level now. I would know. I checked it with myself.', 'Same time tomorrow? There is only the same time, now.', 'That was your best morning so far. I will say that every morning.'],\n  'talk.plumb.1': ['Welcome. You are wobbling. It is all right. Everyone is, at first.', 'Your first class is at the Pavilion. It is the white one. They are all white.', 'Breathe in. Breathe out. You have been doing this for years, and yet.'],\n  'talk.plumb.2': ['Good. Now do that again, but as though you meant it.', 'You look taller today. No. I have looked again.', 'I do not get tired. I have tried.'],\n  'talk.plumb.3': ['Water is only a floor that has stopped trying.', 'The line is for the balance. The boat is for the rest of you.', 'I have never fallen. I once sat down quite quickly.'],\n  'talk.plumb.4': ['Some of the marbles have left. Let them go.', 'I see you have been talking to the scale. It talks.', 'Your knee is where it should be. I mention it because it is rare.'],\n  'talk.plumb.5': ['Class is at the usual time. Please arrive from the east.', 'There will be weather. I do not call it weather. I do not call it anything.', 'My hair is not moving. That is the correct number of times for it to move.'],\n  'talk.plumb.6': ['You remained. Good. I have no further remarks.', 'Do not tell me about the storm. I was there. I was perfectly still.', 'Tomorrow, we will do this again. It will be the same. It will be better.'],\n  'talk.gerald.1': ['Morning.'],\n  'talk.gerald.2': ['Morning.'],\n  'talk.gerald.3': ['Morning.'],\n  'talk.gerald.4': ['Afternoon.', 'It is the afternoon now.', 'I stand here. Over there is further east.'],\n  'talk.gerald.5': ['East.', 'Morning. East.', 'It is steep, for a Thursday.'],\n  'talk.gerald.6': ['Morning.', 'Still here.', 'Nice weather for it.'],\n  'talk.bex.1': ['My mum says this is good for me.', 'I got a 98. I wasn\\'t trying.', 'This is a stone. It looks like a phone. There is no signal here. It is also a stone.', 'Are you going to do the thing on the mat? Everyone does the thing on the mat.'],\n  'talk.bex.2': ['Plaques move here. Nobody cares. I care a bit. Not a lot.', 'I can do the Heron for an hour. I did it by accident.', 'My stone says you are doing fine. I typed that.'],\n  'talk.bex.3': ['The drinks go that way. All of them. I have started betting on them.', 'Have you noticed the sea looks sort of wrong? No? Cool. Me neither.', 'If you fall in, it is warmer than it looks. Don\\'t ask how I know.'],\n  'talk.bex.4': ['The scale told you too, right? About the rock? It told me and it told the frog.', 'I got a 99. Annoying. I was trying.', 'Nothing is level here. Have you ever seen a level? I found one. It left.'],\n  'talk.bex.5': ['Everyone is walking east like it is normal. It is normal. It is fine.', 'My mum says to stay away from weather. I think she means this.', 'I am going to stand here until it stops being a problem.'],\n  'talk.bex.6': ['So that happened. Nobody is going to believe my stone.', 'My mum still says this is good for me. I\\'m starting to worry she is right.', 'Why are you still here? No, same.'],\n  'talk.nan.1': ['I\\'ve been standing here since Tuesday.', 'Which Tuesday? Yes.', 'I am ninety-one. My Wobble Age is nineteen. I do not know what it means either.', 'You are young. You will get steadier, or you won\\'t.'],\n  'talk.nan.2': ['You keep moving about. Why is that?', 'Nobody has seen me arrive. I like it that way.', 'I knew the scale when it was still weighing. A different person. Very sad.'],\n  'talk.nan.3': ['Water is lovely. I stay out of it.', 'There is a turtle in there older than I am. We nod.', 'My late husband fell over in 1962. Once. He never heard the end of it.'],\n  'talk.nan.4': ['The rock. Yes. We all know about the rock. It was my idea.', 'There are worse things to stand on than one rock.', 'You will want to know what to do. You will do it. Don\\'t ask me.'],\n  'talk.nan.5': ['I\\'m going east. I may already be there.', 'Don\\'t worry about me, dear. Worry about the deckchairs.', 'When it comes, keep your knees soft and your opinions to yourself.'],\n  'talk.nan.6': ['There you are. I\\'ve been here since Tuesday.', 'That was a good one. Nineteen sixty-two was better.', 'You may stay. I did.'],\n  'hut.early': ['The day is not finished. Your hut knows. Please see the Programme.', 'You still have things on today. I will tell the bed.'],\n  'stone.donot': ['It says \"Do not\". I would not. Today.', 'Please do not stand there. No reason.'],\n  'station.notyet': ['That is for another day. You may look at it. Looking is free.', 'Nobody is teaching that yet. Please see the Programme.'],\n};\nEOF\ncat > labs/game/ui/lines/story.ts <<'EOF'\n/**\n * @file The five-day story, in one-liners (PLAN.md section 2), notices on the Noticeboard, evening remarks, and what the\n * Wobble Age comparison says, in a tone of mild scientific surprise.\n *\n * Game code, a page's data.\n *\n * @example\n * LINES_STORY['day.1.intro'][0];\n */\n\n/** The lines, by id. */\nexport const LINES_STORY: Readonly<Record<string, readonly string[]>> = {\n  'day.1.intro': ['Welcome to Little Fulcrum. The ferry has left. Please step on me when you are ready.'],\n  'day.2.intro': ['Good morning. The plaques have moved. They have not. Guests are reminded to distribute themselves evenly.'],\n  'day.3.intro': ['Good morning. Today is about water. Drinks may slide along tables. That is a feature of the drink.'],\n  'day.4.intro': ['Good morning. The marbles have started without you. Please do not encourage them.'],\n  'day.5.intro': ['Good morning. There is a class. Then there may be some weather. Please stand further east.'],\n  'day.6.intro': ['You stayed. Good morning. Everything is level. Your Morning Check is ready. It always is.'],\n\n  'evening.1': ['Today you wobbled less than you might have. Goodnight.', 'Your first day. You stood on a lot of things. Goodnight.'],\n  'evening.2': ['Today your plaques stayed roughly where you left them. Goodnight.', 'You were adequately distributed today. Goodnight.'],\n  'evening.3': ['Today the water held you, mostly. Goodnight.', 'You came back from the sea twice as yourself. Goodnight.'],\n  'evening.4': ['The island sits on one rock. We don\\'t mention it to guests. You\\'re a guest. I didn\\'t mention it. Goodnight.'],\n  'evening.5': ['Everything is balanced now. Goodnight, I suppose.'],\n  'evening.6': ['Another day, and you are still here. Goodnight.', 'Tomorrow will be level. Goodnight.'],\n\n  'age.first': ['This is your first Wobble Age. It is terrible. Everyone\\'s is. Yours is especially so, but in a promising way.', 'Your Wobble Age is {age}. This is high. You are welcome to feel something about that.'],\n  'age.younger': ['Your Wobble Age is {age}. Yesterday it was {before}. You have become {diff} years younger by standing still. Science.', 'Your Wobble Age is {age}. Yesterday: {before}. We cannot explain it, and we have stopped trying.'],\n  'age.older': ['Your Wobble Age is {age}. Yesterday it was {before}. That is {diff} years in one night. Did you do something? You do not have to tell me.', 'Your Wobble Age is {age}. Yesterday: {before}. I will write that down in pencil.'],\n  'age.same': ['Your Wobble Age is {age}. It was {age} yesterday. You have not aged at all. We will be looking into you.'],\n\n  'notice.1': ['Please keep to the centre.'],\n  'notice.2': ['Notice: Guests are reminded to distribute themselves evenly.'],\n  'notice.3': ['Notice: If your drink slides, that is a feature of the drink.'],\n  'notice.4': ['Notice: Marbles found moving should be left alone. They know what they are doing.'],\n  'notice.5': ['Notice: The east lawn is fully booked. Please enjoy the east lawn.'],\n  'notice.6': ['Notice: The ferry timetable has been removed. It was upsetting people.'],\n\n  'unlock.expert': ['Ten pebbles. Expert classes are open: a smaller ring, and more sway. Nobody asked for this.'],\n  'unlock.color': ['Twenty pebbles. There is a new tracksuit in your hut. It was always there.'],\n  'unlock.headband': ['Thirty pebbles. There are new tracksuits. They will not help.'],\n  'unlock.stamps': ['Forty pebbles. You have the Unsettling stamp set. We do not know who approved it.'],\n};\nEOF\npython3 - <<'EOF'\nimport re,sys\ns=open('labs/game/ui/lines/activities.ts').read()+open('labs/game/ui/lines/people.ts').read()+open('labs/game/ui/lines/story.ts').read()+open('labs/game/ui/lines/plaques.ts').read()\nprint('approx lines', len(re.findall(r\"'[A-Z][^']*(?:\\\\'[^']*)*'\",s)))\nEOF","description":"Write all the game's lines"}}}
