{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjcLeA1ZDpr9X2PCcca5","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20476,"cache_read_input_tokens":566775,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20476},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"4c346d07-39d0-4415-aa89-26c4010da2d9","timestamp":"2026-11-05T10:18:18.986Z","request_id":"req_011CgjcLdrewS9DeJAA3iQQs","thinking_duration_ms":2687,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjcLeA1ZDpr9X2PCcca5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015V3pSiHSPFejuJEtB8mCut","name":"Bash","input":{"command":"cat > labs/game/ui/screens/dev.ts <<'EOF'\n/**\n * @file Dev Mode, reachable from the pause menu (PLAN.md section 8): live sliders with Reset per group and for all; jumps to\n * any day, activity or finale step; finish now at a chosen rank; cheats; time scale, frame step, free camera, a state overlay,\n * seed, and copying the tuned settings as JSON. Works with pad, keyboard and mouse. Absent in hub sessions.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new DevScreen(host));\n */\nimport type { Inspector, Input } from '../../../../engine';\nimport { BOARD } from '../../scenes/data/days';\nimport { SLIDER_GROUPS } from '../../scenes/settings';\nimport { Panel, type Row } from '../panel';\nimport { NEW_SAVE } from '../save';\nimport { TITLES } from './programme';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** A setting's schema, as describe gives it. */\ninterface Described {\n  default: number;\n  minimum: number;\n  maximum: number;\n  unit?: string;\n  description?: string;\n}\n\n/** The overlay of state, while it is on. */\nexport class StateOverlay {\n  readonly el: HTMLElement;\n  on = false;\n  constructor(parent: HTMLElement) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-chip';\n    this.el.dataset.ui = 'state';\n    this.el.style.cssText = 'left:var(--safe);bottom:var(--safe);white-space:pre;font-size:2.7vh;font-weight:600;display:none';\n    parent.append(this.el);\n  }\n  update(text: string): void {\n    this.el.style.display = this.on ? '' : 'none';\n    if (this.on) this.el.textContent = text;\n  }\n}\n\n/** Dev Mode. */\nexport class DevScreen implements Screen {\n  readonly name = 'dev';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private ins: Inspector;\n  private scale = 1;\n  private stack: (() => Row[])[] = [];\n  private head: HTMLElement;\n  private free = false;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    this.ins = host.engine.inspector!;\n    this.panel = new Panel(this.el, {\n      id: 'dev',\n      title: 'Dev Mode',\n      rows: [],\n      sound: (cue) => host.cue(cue),\n      onCancel: () => this.back(),\n      onPick: (id) => this.pick(id),\n    });\n    this.head = this.panel.el.querySelector('.tf-h1')!;\n    this.go('Dev Mode', () => this.mainRows());\n  }\n\n  private actions: Record<string, () => void> = {};\n\n  /** Shows a page of rows. */\n  private go(title: string, rows: () => Row[]): void {\n    this.stack.push(rows);\n    this.head.textContent = title;\n    this.panel.setRows(rows());\n  }\n\n  private back(): void {\n    this.stack.pop();\n    const rows = this.stack[this.stack.length - 1];\n    if (!rows) this.host.close(this);\n    else {\n      this.head.textContent = 'Dev Mode';\n      this.panel.setRows(rows());\n    }\n  }\n\n  private pick(id: string): void {\n    this.actions[id]?.();\n  }\n\n  /** A row that does something. */\n  private doRow(id: string, label: string, run: () => void, value?: () => string): Row {\n    this.actions[id] = run;\n    return value ? { id, label, value, adjust: run } : { id, label };\n  }\n\n  private mainRows(): Row[] {\n    return [\n      this.doRow('sliders', 'Live sliders', () => this.go('Sliders', () => this.groupRows())),\n      this.doRow('jumps', 'Jumps', () => this.go('Jumps', () => this.jumpRows())),\n      this.doRow('cheats', 'Cheats', () => this.go('Cheats', () => this.cheatRows())),\n      this.doRow('tools', 'Tools', () => this.go('Tools', () => this.toolRows())),\n      this.doRow('close', 'Close', () => this.host.close(this)),\n    ];\n  }\n\n  private groupRows(): Row[] {\n    return [\n      ...SLIDER_GROUPS.map((group, i) => this.doRow(`group${i}`, group.title, () => this.go(group.title, () => this.sliderRows(i)))),\n      this.doRow('resetAll', 'Reset all to defaults', () => {\n        for (const group of SLIDER_GROUPS) for (const path of group.paths) this.resetPath(path);\n        this.panel.refresh();\n      }),\n    ];\n  }\n\n  private schema(path: string): Described {\n    return this.ins.describe('setting', path) as Described;\n  }\n\n  private resetPath(path: string): void {\n    this.ins.set(path, this.schema(path).default);\n  }\n\n  private value(path: string): number {\n    const state = this.ins.state('flow') as unknown as { settings?: Record<string, number> };\n    void state;\n    return (this.ins as unknown as { get_setting?: (p: string) => number }).get_setting?.(path) ?? this.readSetting(path);\n  }\n\n  /** The value a setting has now. */\n  private readSetting(path: string): number {\n    const q = this.ins as unknown as { settings?: { get(p: string): number } };\n    return q.settings?.get(path) ?? this.tuned.get(path) ?? this.schema(path).default;\n  }\n\n  /** What has been set here. */\n  private tuned = new Map<string, number>();\n\n  private sliderRows(index: number): Row[] {\n    const group = SLIDER_GROUPS[index];\n    const rows: Row[] = group.paths.map((path) => {\n      const s = this.schema(path);\n      const set = (v: number) => {\n        const clamped = Math.max(s.minimum, Math.min(s.maximum, v));\n        this.tuned.set(path, clamped);\n        this.ins.set(path, clamped);\n      };\n      const step = (s.maximum - s.minimum) / 40;\n      return {\n        id: path,\n        label: path.replace('game.', ''),\n        value: () => this.value(path).toFixed(2),\n        bar: () => (this.value(path) - s.minimum) / (s.maximum - s.minimum),\n        adjust: (dir) => set(this.value(path) + dir * step),\n        setBar: (u) => set(s.minimum + u * (s.maximum - s.minimum)),\n      } satisfies Row;\n    });\n    rows.push(\n      this.doRow(`reset${index}`, 'Reset this group', () => {\n        for (const path of group.paths) {\n          this.resetPath(path);\n          this.tuned.delete(path);\n        }\n        this.panel.refresh();\n      }),\n    );\n    return rows;\n  }\n\n  private jumpRows(): Row[] {\n    const { host } = this;\n    const leave = () => {\n      this.host.closeAll();\n    };\n    return [\n      ...[1, 2, 3, 4, 5, 6].map((day) =>\n        this.doRow(`day${day}`, day > 5 ? 'To After' : `To Day ${day}`, () => {\n          leave();\n          host.act('game.day', { day });\n        }),\n      ),\n      ...BOARD.map((id) =>\n        this.doRow(`act-${id}`, `Start ${TITLES[id] ?? id}`, () => {\n          leave();\n          host.act('game.start', { event: id });\n        }),\n      ),\n      ...['storm', 'east', 'weights', 'stone', 'dawn'].map((phase) =>\n        this.doRow(`tilt-${phase}`, `Finale: ${phase}`, () => {\n          leave();\n          host.act('game.tiltStep', { phase });\n        }),\n      ),\n      ...([['Present', 150], ['Adequate', 400], ['Composed', 650], ['Serene', 800], ['Unsettling', 950]] as const).map(([name, score]) =>\n        this.doRow(`finish-${name}`, `Finish now: ${name}`, () => {\n          leave();\n          host.act('game.finish', { score });\n        }),\n      ),\n    ];\n  }\n\n  private cheatRows(): Row[] {\n    const { host } = this;\n    return [\n      this.doRow('bot', 'Bot plays for me', () => {\n        host.cheats.bot = !host.cheats.bot;\n        this.ins.set('game.auto', false);\n        host.applySettings();\n        this.panel.refresh();\n      }, () => (host.cheats.bot ? 'On' : 'Off')),\n      this.doRow('god', 'No topple', () => {\n        host.cheats.god = !host.cheats.god;\n        host.applySettings();\n        this.panel.refresh();\n      }, () => (host.cheats.god ? 'On' : 'Off')),\n      this.doRow('unlock', 'Unlock everything', () => {\n        host.act('game.unlock');\n      }),\n      this.doRow('pebbles', 'Give 10 pebbles', () => host.act('game.give', { pebbles: 10 })),\n      this.doRow('throwaway', 'Throwaway save', () => {\n        host.save = { ...host.save };\n        (host as unknown as { throwaway: boolean }).throwaway = !(host as unknown as { throwaway: boolean }).throwaway;\n        this.panel.refresh();\n      }, () => ((host as unknown as { throwaway: boolean }).throwaway ? 'On: nothing is kept' : 'Off')),\n      this.doRow('wipe', 'Reset save', () => {\n        host.save = { ...NEW_SAVE };\n        host.writeSave();\n        host.closeAll();\n        host.toTitle();\n      }),\n    ];\n  }\n\n  private toolRows(): Row[] {\n    const ins = this.ins;\n    const scales = [0.25, 1, 4];\n    return [\n      this.doRow('scale', 'Time scale', () => {\n        this.scale = scales[(scales.indexOf(this.scale) + 1) % scales.length];\n        (ins.timeScale as (k: number) => number)(this.scale);\n        this.panel.refresh();\n      }, () => `${this.scale}x`),\n      this.doRow('stepone', 'Frame step', () => {\n        ins.step(1);\n      }),\n      this.doRow('fly', 'Free camera', () => {\n        this.free = !this.free;\n        (this.host as unknown as { freeCamera: boolean }).freeCamera = this.free;\n        this.panel.refresh();\n      }, () => (this.free ? 'On' : 'Off')),\n      this.doRow('overlay', 'State overlay', () => {\n        const overlay = (this.host as unknown as { overlay: StateOverlay }).overlay;\n        overlay.on = !overlay.on;\n        this.panel.refresh();\n      }, () => ((this.host as unknown as { overlay: StateOverlay }).overlay.on ? 'On' : 'Off')),\n      this.doRow('seed', 'New seed', () => {\n        const next = (ins.seed() as number) + 1;\n        this.host.closeAll();\n        ins.seed(next);\n        this.host.beginPlay();\n      }, () => String(ins.seed())),\n      this.doRow('copy', 'Copy tuned settings', () => {\n        const out = Object.fromEntries(this.tuned);\n        void navigator.clipboard?.writeText(JSON.stringify(out, null, 2));\n        (window as unknown as { __tuned?: unknown }).__tuned = out;\n        this.host.sound.play('sfx:good');\n      }),\n    ];\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/join.ts <<'EOF'\n/**\n * @file Group Class's join screen (PLAN.md section 9): same screen, up to four pads; keyboard and mouse can hold one seat. Mats\n * light in seat colours as people press Cross or Space. Empty seats go to CPU guests.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new JoinScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { promptHtml } from '../glyphs';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** The seats' colours. */\nconst COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\n\n/** Who holds a seat: a pad's index, or -1 for the keyboard. */\nexport interface Joined {\n  seat: number;\n  pad: number;\n}\n\n/** The people who joined, kept for the frame reader in app.ts. */\nexport const joined: Joined[] = [];\n\n/** Reads a pad's seat input: [lean x, lean y, left foot, right foot, act]. */\nexport function padSeat(pad: Gamepad): number[] {\n  const b = pad.buttons;\n  const down = (i: number) => (b[i]?.value ?? 0) > 0.5 || Boolean(b[i]?.pressed);\n  const trig = (i: number, s: number) => Math.max(b[i]?.value ?? 0, b[s]?.pressed ? 1 : 0);\n  const dead = (v: number) => (Math.abs(v) < 0.12 ? 0 : v);\n  const lx = dead(pad.axes[0] ?? 0) + (down(15) ? 1 : 0) - (down(14) ? 1 : 0);\n  const ly = -dead(pad.axes[1] ?? 0) + (down(12) ? 1 : 0) - (down(13) ? 1 : 0);\n  return [lx, ly, trig(6, 4), trig(7, 5), down(0) || down(1) || down(2) || down(3) ? 1 : 0];\n}\n\n/** The join screen. */\nexport class JoinScreen implements Screen {\n  readonly name = 'join';\n  readonly modal = true;\n  private el: HTMLElement;\n  private mats: HTMLElement[] = [];\n  private foot: HTMLElement;\n  private key = '';\n  private padsDown = new Set<number>();\n  private keyDown = false;\n  private handler: (event: KeyboardEvent) => void;\n\n  constructor(private host: AppHost) {\n    joined.length = 0;\n    this.el = layer(host.root);\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel tf-card-hub';\n    panel.dataset.panel = 'join';\n    panel.innerHTML = '<div class=\"tf-h1\">Group Class</div><div class=\"tf-sub\">Three classes, four mats. Stand on one. Whoever wobbles least gets a sash.</div>';\n    const mats = document.createElement('div');\n    mats.className = 'tf-mats';\n    panel.append(mats);\n    for (let i = 0; i < 4; i++) {\n      const mat = document.createElement('div');\n      mat.className = 'tf-mat';\n      mat.dataset.mat = String(i);\n      mats.append(mat);\n      this.mats.push(mat);\n    }\n    this.foot = document.createElement('div');\n    this.foot.className = 'tf-prompts';\n    this.foot.style.justifyContent = 'flex-start';\n    panel.append(this.foot);\n    this.el.append(panel);\n    this.handler = (event) => {\n      if (event.code !== 'Space' && event.code !== 'Enter') return;\n      if (event.repeat) return;\n      this.joinOrStart(-1);\n    };\n    addEventListener('keydown', this.handler);\n    panel.addEventListener('click', () => this.joinOrStart(-1));\n    this.drawMats();\n  }\n\n  /** The first press joins; a joined person's next press starts. */\n  private joinOrStart(pad: number): void {\n    const already = joined.find((j) => j.pad === pad);\n    if (already) {\n      this.start();\n      return;\n    }\n    if (joined.length >= 4) return;\n    joined.push({ seat: joined.length, pad });\n    this.host.sound.play('sfx:squeak');\n    this.drawMats();\n  }\n\n  private start(): void {\n    const { host } = this;\n    host.freePlay = false;\n    host.closeAll();\n    host.beginPlay();\n    const cpuOn = host.settings.cpuGuests;\n    const humans = joined.length;\n    const single = humans <= 1;\n    const seats = [0, 1, 2, 3].map((i) => {\n      if (i < humans) return { kind: single ? 'local' : 'pad' };\n      if (!cpuOn) return { kind: 'off' };\n      return { kind: 'cpu', skill: 'human', sway: 0.7 + i * 0.2 };\n    });\n    host.act('game.group', { seats });\n  }\n\n  private drawMats(): void {\n    this.mats.forEach((mat, i) => {\n      const who = joined[i];\n      mat.dataset.on = who ? 'true' : 'false';\n      mat.style.background = who ? COLORS[i] : '';\n      mat.textContent = who ? (who.pad < 0 ? 'Keyboard' : `Pad ${who.pad + 1}`) : this.host.settings.cpuGuests ? 'CPU guest' : 'Empty';\n    });\n  }\n\n  update(input: Input): void {\n    for (const pad of navigator.getGamepads?.() ?? []) {\n      if (!pad) continue;\n      const down = Boolean(pad.buttons[0]?.pressed);\n      if (down && !this.padsDown.has(pad.index)) {\n        this.padsDown.add(pad.index);\n        this.joinOrStart(pad.index);\n      } else if (!down) this.padsDown.delete(pad.index);\n    }\n    if (input.pressed('uiCancel')) this.host.close(this);\n    const key = `${this.host.device()}|${this.host.glyphs()}|${joined.length}`;\n    if (key !== this.key) {\n      this.key = key;\n      const [d, g] = [this.host.device(), this.host.glyphs()];\n      this.foot.innerHTML = `${promptHtml(d === 'gamepad' ? 'confirm' : 'both', joined.length ? 'Join, or press again to start' : 'Join', d, g)}${promptHtml('cancel', 'Back', d, g)}`;\n    }\n    void this.keyDown;\n  }\n\n  remove(): void {\n    removeEventListener('keydown', this.handler);\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/card.ts <<'EOF'\n/**\n * @file The hub session's own card (PLAN.md section 9): HTML over whatever is drawn, because the watchdog may call `ready()`\n * while the view is still warming up. The game's title, players in colour with who is ready, how to win, this player's\n * controls, seconds left. Enter or Cross is Ready; Triangle or T is More time; a tap or click works too. No menus or choices.\n *\n * Game code, a page's.\n *\n * @example\n * // const card = new HubCard(root, session);\n */\nimport type { Session } from '../../hub/session';\n\n/** The card. */\nexport class HubCard {\n  readonly el: HTMLElement;\n  private players: HTMLElement;\n  private left: HTMLElement;\n  private readyBtn: HTMLElement;\n  private moreBtn: HTMLElement;\n  private padDown = { ready: false, more: false };\n\n  constructor(\n    parent: HTMLElement,\n    private session: Session,\n  ) {\n    const el = document.createElement('div');\n    el.className = 'tf-layer';\n    el.dataset.ui = 'hubcard';\n    el.style.pointerEvents = 'none';\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel tf-card-hub';\n    panel.innerHTML = `<div class=\"tf-h1\">Teeter Fit</div>\n      <div class=\"tf-sub\">Stay the steadiest across three classes. Stand on your mat.</div>\n      <div class=\"tf-mats\" data-ui=\"players\"></div>\n      <div class=\"tf-sub\">Lean: stick or WASD. Feet: L2 R2 or Q E. Breathe: both, or Space.</div>\n      <div class=\"tf-prompts\" style=\"justify-content:flex-start\">\n        <div class=\"tf-row\" data-card=\"ready\" data-ui=\"item\">Ready <span class=\"tf-glyph\" data-kind=\"key\">Enter</span></div>\n        <div class=\"tf-row\" data-card=\"more\" data-ui=\"item\">More time <span class=\"tf-glyph\" data-kind=\"key\">T</span></div>\n        <span data-ui=\"left\" style=\"font-size:var(--t-menu);font-weight:800\"></span>\n      </div>`;\n    el.append(panel);\n    parent.append(el);\n    this.el = el;\n    this.players = panel.querySelector('[data-ui=players]')!;\n    this.left = panel.querySelector('[data-ui=left]')!;\n    this.readyBtn = panel.querySelector('[data-card=ready]')!;\n    this.moreBtn = panel.querySelector('[data-card=more]')!;\n    this.readyBtn.addEventListener('click', () => session.answer('ready'));\n    this.moreBtn.addEventListener('click', () => session.answer('more'));\n    for (const player of session.info.players) {\n      const mat = document.createElement('div');\n      mat.className = 'tf-mat';\n      mat.dataset.on = 'true';\n      mat.dataset.player = String(player.id);\n      mat.style.background = player.color;\n      mat.textContent = player.name; // names come from the hub, and are never HTML\n      this.players.append(mat);\n    }\n  }\n\n  /** One frame: the card's state, and the pad's answers. */\n  update(): void {\n    const card = this.session.card;\n    if (card) {\n      for (const mat of this.players.children) {\n        const id = Number((mat as HTMLElement).dataset.player);\n        (mat as HTMLElement).style.opacity = card.ready.includes(id) ? '1' : '0.65';\n        (mat as HTMLElement).style.outline = card.ready.includes(id) ? '0.5vh solid #3a4a55' : 'none';\n      }\n      this.left.textContent = card.starting ? 'Starting' : card.paused ? 'Waiting' : card.left !== null ? `${Math.ceil(card.left / 1000)} s` : '';\n      this.readyBtn.dataset.focus = this.session.answered ? 'true' : 'false';\n    }\n    for (const pad of navigator.getGamepads?.() ?? []) {\n      if (!pad) continue;\n      const [ready, more] = [Boolean(pad.buttons[0]?.pressed), Boolean(pad.buttons[3]?.pressed)];\n      if (ready && !this.padDown.ready) this.session.answer('ready');\n      if (more && !this.padDown.more) this.session.answer('more');\n      this.padDown = { ready, more };\n    }\n  }\n\n  /** Takes it down. */\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/app.ts <<'EOF'\n/**\n * @file Teeter Fit's page app: every drawn frame it reads the sim, plays new events, keeps the screens, HUD, camera and sound\n * up to date, and turns menu picks into scene actions. It reads the sim and never writes it.\n *\n * Game code, a page's.\n *\n * @example\n * // const app = new App(session, search); app.attach(engine, store);\n */\nimport { type CameraInput, type Engine, type EngineFrame, type Input, type Inspector, type Store } from '../../../engine';\nimport { Sound } from '../audio/sound';\nimport { setShot } from '../cameras/shot';\nimport type { Session } from '../hub/session';\nimport type { ActivityData, Cast, Flow, GameComponents, IslandData, Seat, Wobble } from '../scenes/components';\nimport { ACTIVITIES } from '../scenes/events/index';\nimport { USABLES } from '../scenes/data/usables';\nimport { STATIONS } from '../scenes/data/stations';\nimport { PLAQUE_TEXT } from './lines/plaques';\nimport { getLine } from './lines/index';\nimport { promptHtml, type Device, type GlyphSet } from './glyphs';\nimport { Hud } from './hud/hud';\nimport { Speech } from './hud/speech';\nimport { HubCard } from './screens/card';\nimport { StateOverlay } from './screens/dev';\nimport { joined, padSeat } from './screens/join';\nimport { PauseScreen, TitleScreen } from './screens/menus';\nimport { BoardScreen, ProgrammeScreen } from './screens/programme';\nimport { CreditsScreen, EveningScreen, ResultsScreen } from './screens/results';\nimport type { AppHost, Screen } from './screens/types';\nimport { loadSave, loadSettings, NEW_SETTINGS, saveFromFlow, type SaveData, type SettingsData } from './save';\nimport { shotFor, type ShotView } from './shots';\nimport { readDevices } from './devices';\n\n/** Seconds on a front-end menu before attract starts. */\nconst ATTRACT_AFTER = 10;\n\n/** Entities as the frame sees them. */\ntype Entities = Record<string, unknown>[];\n\n/** The page app. */\nexport class App implements AppHost {\n  engine!: Engine;\n  store!: Store;\n  root!: HTMLElement;\n  sound!: Sound;\n  save!: SaveData;\n  settings: SettingsData = { ...NEW_SETTINGS };\n  freePlay = false;\n  freeCamera = false;\n  throwaway = false;\n  cheats = { bot: false, god: false };\n  overlay!: StateOverlay;\n  private stack: Screen[] = [];\n  private title: TitleScreen | null = null;\n  private hud!: Hud;\n  private speech!: Speech;\n  private focusEl!: HTMLElement;\n  private reticle!: HTMLElement;\n  private attractEl!: HTMLElement;\n  private fadeEl!: HTMLElement;\n  private card: HubCard | null = null;\n  private dev = '';\n  private lastSeen = 0;\n  private lastFlow: Flow | null = null;\n  private clock = 0;\n  private camCode = '';\n  private idle = 0;\n  private attract = false;\n  private device_: Device = 'keyboard';\n  private lastInputKey = '';\n  private feet: [number, number, number] = [0, 0, 0];\n  private lastMode = '';\n  private look = 'look:retreat';\n  private mouse = [0, 0];\n  private point: [number, number, number] = [0, 0, 0];\n  private touchOnly = false;\n  private sawKeyOrPad = false;\n  private ending = false;\n  private sessionDone = false;\n  private lastPhase = '';\n\n  constructor(\n    readonly sessionState: Session | null,\n    readonly search: URLSearchParams,\n  ) {}\n\n  /** Whether this page is a hub session. */\n  get session(): boolean {\n    return this.sessionState !== null;\n  }\n\n  // ---- AppHost ----\n  device(): Device {\n    return this.device_;\n  }\n  glyphs(): GlyphSet {\n    return this.settings.glyphs;\n  }\n  flow(): Flow | null {\n    return this.lastFlow;\n  }\n  act(name: string, args?: unknown): void {\n    (this.engine.inspector?.actions as { run(n: string, a?: unknown): void } | undefined)?.run(name, args);\n    this.readFlowNow();\n  }\n  open(screen: Screen): void {\n    this.stack.push(screen);\n    this.title?.show(this.stack.every((s) => s === this.title));\n  }\n  close(screen?: Screen): void {\n    const at = screen ? this.stack.indexOf(screen) : this.stack.length - 1;\n    if (at < 0) return;\n    this.stack[at].remove();\n    this.stack.splice(at, 1);\n    this.title?.show(this.stack.length === 1 && this.stack[0] === this.title);\n  }\n  closeAll(): void {\n    for (const screen of [...this.stack]) if (screen !== this.title) this.close(screen);\n  }\n  applySettings(): void {\n    if (!this.session) this.store.set('settings', this.settings);\n    this.sound.setVolumes(this.settings);\n    this.engine.inspector?.set('game.assist', this.settings.steadier);\n    this.engine.inspector?.set('game.noTopple', this.cheats.god);\n    if (!this.attract) this.engine.inspector?.set('game.auto', this.cheats.bot);\n    this.engine.inspector?.set('game.skill', 'perfect');\n  }\n  writeSave(): void {\n    if (!this.session && !this.throwaway) this.store.set('save', this.save);\n  }\n  cue(what: 'move' | 'pick' | 'cancel'): void {\n    this.sound.play(what === 'move' ? 'sfx:blip' : what === 'pick' ? 'sfx:confirm' : 'sfx:cancel', 0.6);\n  }\n  beginPlay(): void {\n    this.closeTitle();\n    this.endAttract();\n    this.act('game.begin', { ...this.save, roam: true });\n    this.lastSeen = -1;\n    const flow = this.lastFlow;\n    const day = flow?.day ?? this.save.day;\n    const firstEver = day === 1 && (flow?.done.length ?? 0) === 0;\n    if (firstEver) this.act('game.go', { station: 'pier' });\n    this.sound.speak('tare', `day.${Math.min(day, 6)}.intro`, 0);\n    this.look = 'look:retreat';\n  }\n  toTitle(): void {\n    this.closeAll();\n    this.freePlay = false;\n    this.act('game.front');\n    this.save = loadSave(this.store);\n    this.openTitle();\n  }\n\n  // ---- the engine's hooks ----\n  modal(): boolean {\n    if (this.session) return this.stack.length > 0;\n    return this.stack.length > 0 || this.attract;\n  }\n  mapName(): string {\n    if (this.stack.length > 0) return 'actionMap:front';\n    const flow = this.lastFlow;\n    if (!flow) return this.session ? 'actionMap:balance' : 'actionMap:front';\n    if (this.session) return 'actionMap:balance';\n    if (flow.mode === 'roam') return 'actionMap:roam';\n    if (flow.mode === 'event') return ACTIVITIES[flow.event]?.map ?? 'actionMap:balance';\n    return 'actionMap:front';\n  }\n  cameraInput(): CameraInput | undefined {\n    return { follow: this.feet };\n  }\n\n  /** The first moment the engine is up. */\n  attach(engine: Engine, store: Store): void {\n    this.engine = engine;\n    this.store = store;\n    this.root = document.createElement('div');\n    this.root.className = 'tf-root';\n    (engine.ui?.root ?? document.body).append(this.root);\n    this.hud = new Hud(this.root);\n    this.speech = new Speech(this.root);\n    this.focusEl = document.createElement('div');\n    this.focusEl.className = 'tf-focusprompt';\n    this.focusEl.dataset.ui = 'prompt';\n    this.focusEl.style.display = 'none';\n    this.reticle = document.createElement('div');\n    this.reticle.className = 'tf-reticle';\n    this.reticle.style.display = 'none';\n    this.attractEl = document.createElement('div');\n    this.attractEl.className = 'tf-banner';\n    this.attractEl.dataset.ui = 'attract';\n    this.attractEl.style.display = 'none';\n    this.fadeEl = document.createElement('div');\n    this.fadeEl.className = 'tf-fade';\n    this.root.append(this.focusEl, this.reticle, this.attractEl, this.fadeEl);\n    this.overlay = new StateOverlay(this.root);\n    this.sound = new Sound();\n    this.sound.onSpeech = (who, text, seconds) => this.speech.show(who, text, seconds);\n    if (this.session) {\n      this.save = loadSave(store);\n      this.settings = { ...NEW_SETTINGS };\n    } else {\n      this.save = loadSave(store);\n      this.settings = loadSettings(store);\n    }\n    this.applySettings();\n    this.listenDevices();\n    this.touchOnly = matchMedia('(hover: none) and (pointer: coarse)').matches;\n    if (this.sessionState) {\n      const s = this.sessionState;\n      this.act('round.join', { me: s.info.me, players: s.info.players.map((p) => p.id) });\n      this.card = new HubCard(this.root, s);\n      s.onStart = () => {\n        this.card?.remove();\n        this.card = null;\n      };\n      s.onEnd = () => {\n        this.sessionDone = true;\n        engine.stop();\n        void this.sound.audio.close();\n        this.hud.hide();\n      };\n    } else if (this.search.get('scene') === 'game:round') {\n      this.act('round.alone');\n    } else this.openTitle();\n    this.publish();\n  }\n\n  private openTitle(): void {\n    this.closeTitle();\n    this.title = new TitleScreen(this);\n    this.stack.unshift(this.title);\n    this.title.setTouchOnly(this.touchOnly && !this.sawKeyOrPad);\n    this.lastSeen = -1;\n  }\n\n  private closeTitle(): void {\n    if (!this.title) return;\n    const at = this.stack.indexOf(this.title);\n    if (at >= 0) this.stack.splice(at, 1);\n    this.title.remove();\n    this.title = null;\n  }\n\n  /** Reads the flow straight after an action, so a screen opened now sees it. */\n  private readFlowNow(): void {\n    const q = this.engine.inspector?.state('flow') as unknown as { entities?: { flow: Flow }[] } | undefined;\n    const flow = q?.entities?.[0]?.flow;\n    if (flow) this.lastFlow = flow;\n  }\n\n  /** Mouse lean, the pointer's place, and what wakes things up. */\n  private listenDevices(): void {\n    const wake = () => {\n      this.idle = 0;\n      if (this.attract) this.endAttract();\n    };\n    const hard = () => {\n      if (this.touchOnly && !this.sawKeyOrPad) {\n        this.sawKeyOrPad = true;\n        this.title?.setTouchOnly(false);\n      }\n      wake();\n    };\n    addEventListener('keydown', hard);\n    addEventListener('pointerdown', (event) => {\n      if (event.pointerType === 'touch') {\n        this.idle = 0;\n        return;\n      }\n      hard();\n    });\n    addEventListener('pointermove', (event) => {\n      if (event.pointerType === 'touch') return;\n      if (event.movementX !== 0 || event.movementY !== 0) wake();\n      if (this.engine.input?.mouse?.locked) {\n        this.mouse[0] += event.movementX;\n        this.mouse[1] += event.movementY;\n      }\n      const aspect = innerWidth / Math.max(1, innerHeight);\n      this.point = [((event.clientX / innerWidth) * 2 - 1) * aspect * 1.25, -((event.clientY / innerHeight) * 2 - 1) * 1.25, 1];\n    });\n  }\n\n  /** Starts attract. */\n  private startAttract(): void {\n    if (this.attract) return;\n    this.attract = true;\n    this.title?.show(false);\n    this.act('game.begin', { roam: false });\n    this.act('game.attract', { on: true });\n    this.attractEl.style.display = '';\n    this.publish();\n  }\n\n  /** Leaves attract: back to where you were. The save was never touched. */\n  private endAttract(): void {\n    if (!this.attract) return;\n    this.attract = false;\n    this.attractEl.style.display = 'none';\n    this.act('game.attract', { on: false });\n    this.title?.show(this.stack.length === 1);\n    this.title?.setTouchOnly(this.touchOnly && !this.sawKeyOrPad);\n    this.idle = 0;\n    this.hud.hide();\n    this.speech.clear();\n    this.publish();\n  }\n\n  /** Publishes the small read-only handle tests use. */\n  private publish(flow?: Flow | null, a?: ActivityData | null): void {\n    (window as unknown as { __game: unknown }).__game = {\n      screen: this.stack.length ? this.stack[this.stack.length - 1].name : (flow?.mode ?? 'boot'),\n      stack: this.stack.map((s) => s.name),\n      attract: this.attract,\n      device: this.device_,\n      glyphs: this.settings.glyphs,\n      volumes: { music: this.sound.audio.volume('music'), effects: this.settings.effects, voices: this.settings.voices },\n      day: flow?.day ?? this.lastFlow?.day ?? 0,\n      mode: flow?.mode ?? this.lastFlow?.mode ?? '',\n      event: flow?.event ?? '',\n      phase: a?.phase ?? '',\n      focus: flow?.focus ?? -1,\n      map: this.mapName(),\n      camera: this.camCode,\n      speech: this.speech?.current ?? '',\n      touchOnly: this.touchOnly && !this.sawKeyOrPad,\n      idle: this.idle,\n    };\n  }\n\n  /** One drawn frame. */\n  frame(frame: EngineFrame): void {\n    if (!this.engine || !this.root || this.sessionDone) {\n      setShot({ at: [0, 40, 130], look: [0, 10, 0], fov: 42, ease: 0 });\n      return;\n    }\n    const dt = frame.dt;\n    this.clock += dt;\n    const input = this.engine.input as Input;\n    const inspector = this.engine.inspector as Inspector;\n    const world = frame.world as unknown as { query(...names: string[]): Entities; tick: number };\n    const flow = world.query('flow')[0]?.flow as Flow | undefined;\n    const activity = world.query('activity')[0]?.activity as ActivityData | undefined;\n    const island = world.query('island')[0]?.island as IslandData | undefined;\n    if (!flow || !island) return;\n    this.lastFlow = flow;\n    const running = activity && activity.id ? activity : null;\n    this.updateDevice(input);\n    this.sound.frame(frame, (type, payload) => this.onEvent(type, payload, flow, running));\n    this.speech.update(dt);\n\n    // Where the seat's person is, and whose seat is lit.\n    const seats = world.query('seat', 'wobble') as unknown as { seat: Seat; wobble: Wobble; id: number }[];\n    const mySeat = seats.find((e) => e.seat.kind === 'local') ?? seats[0];\n    const myCast = world.query('cast', 'actor').find((e) => (this.sessionState ? (e.cast as Cast).who === `seat${this.sessionState.info.me}` : (e.cast as Cast).who === 'guest')) as unknown as { actor: { x: number; y: number; z: number; yaw: number }; cast: Cast } | undefined;\n    if (myCast) this.feet = [myCast.actor.x, myCast.actor.y, myCast.actor.z];\n\n    this.handleScreens(input, inspector, dt, flow);\n    this.sendInput(flow, running, input);\n    this.updateCamera(flow, running, island, myCast, inspector);\n    this.updateHud(flow, running, mySeat, input);\n    this.updateFocus(flow);\n    this.updateWorldLook(frame, island, flow, running);\n    this.updateMusic(flow, running, island);\n    this.updateAttract(dt, flow);\n    this.updateSession(frame, flow, running, mySeat);\n    this.overlay.update(`CoB ${mySeat?.wobble.x.toFixed(2)} ${mySeat?.wobble.y.toFixed(2)}  calm ${mySeat?.wobble.calm.toFixed(2)}  sync ${mySeat?.wobble.sync.toFixed(2)}\\ntilt ${island.tiltX.toFixed(1)} ${island.tilt.toFixed(1)}  ${flow.mode} ${flow.event} ${running?.phase ?? ''}\\ntick ${world.tick}  hash ${inspector.hash()}`);\n    this.publish(flow, running);\n    if (flow.mode !== this.lastMode) {\n      this.lastMode = flow.mode;\n      if (flow.mode === 'roam' && !this.session) this.saveNow(flow);\n    }\n  }\n\n  private saveNow(flow: Flow): void {\n    if (this.attract) return;\n    this.save = saveFromFlow(flow, this.save);\n    this.writeSave();\n  }\n\n  /** Which device was used last: glyphs follow it, the same frame. */\n  private updateDevice(input: Input): void {\n    const last = input.lastDevice;\n    if (last === 'gamepad' || last === 'keyboard' || last === 'mouse') {\n      if (last === 'gamepad' && !this.sawKeyOrPad) {\n        this.sawKeyOrPad = true;\n        this.title?.setTouchOnly(false);\n      }\n      this.device_ = last;\n    }\n    const pads = navigator.getGamepads?.() ?? [];\n    for (const pad of pads) {\n      if (!pad) continue;\n      const pressed = pad.buttons.some((b) => b.pressed) || pad.axes.some((v) => Math.abs(v) > 0.4);\n      if (pressed) {\n        this.idle = 0;\n        if (this.attract) this.endAttract();\n        if (!this.sawKeyOrPad) {\n          this.sawKeyOrPad = true;\n          this.title?.setTouchOnly(false);\n        }\n      }\n    }\n    void this.lastInputKey;\n  }\n\n  /** The screens, and pause. */\n  private handleScreens(input: Input, inspector: Inspector, dt: number, flow: Flow): void {\n    const createHeld = (navigator.getGamepads?.() ?? []).some((pad) => pad?.buttons[8]?.pressed);\n    const top = this.stack[this.stack.length - 1];\n    if (top && !this.attract) top.update(input, dt);\n    else if (!top && input.pressed('pause') && !createHeld && !(flow.mode === 'front' && !this.session)) {\n      this.open(new PauseScreen(this));\n    } else if (!top && flow.mode === 'roam' && input.pressed('plan')) this.open(new ProgrammeScreen(this));\n    void inspector;\n    if (this.card) this.card.update();\n  }\n\n  /** Mouse lean, the pointer's place, and each seat's input. */\n  private sendInput(flow: Flow, running: ActivityData | null, input: Input): void {\n    const scale = 0.0028 * this.settings.mouse;\n    const leaning = flow.mode === 'event' && this.stack.length === 0;\n    if (leaning) {\n      const [dx, dy] = this.mouse;\n      input.virtual.axis('game:mouse', [dx * scale, -dy * scale]);\n    } else input.virtual.axis('game:mouse', [0, 0]);\n    this.mouse = [0, 0];\n    const free = running?.id === 'garden' && !input.mouse?.locked && this.device_ !== 'gamepad';\n    input.virtual.axis('game:pointer', free ? [Math.max(-1, Math.min(1, this.point[0])), Math.max(-1, Math.min(1, this.point[1])), this.point[2]] : [0, 0, 0]);\n    if (flow.mode === 'event' && running?.id === 'group' && joined.length > 1) {\n      const pads = navigator.getGamepads?.() ?? [];\n      const data: number[] = [];\n      for (let i = 0; i < 4; i++) {\n        const who = joined[i];\n        const pad = who && who.pad >= 0 ? pads[who.pad] : null;\n        if (pad) data.push(...padSeat(pad));\n        else if (who) {\n          const s = (name: string) => input.strength(name);\n          data.push(s('right') - s('left'), s('forward') - s('back'), s('footl'), s('footr'), input.held('act') ? 1 : 0);\n        } else data.push(0, 0, 0, 0, 0);\n      }\n      input.virtual.axis('game:seats', data);\n    }\n    readDevices(this, flow, running, this.settings);\n  }\n\n  /** Chooses and aims the camera. */\n  private updateCamera(flow: Flow, running: ActivityData | null, island: IslandData, cast: { actor: { x: number; y: number; z: number; yaw: number } } | undefined, inspector: Inspector): void {\n    const walking = !this.attract && (flow.mode === 'roam' || (flow.mode === 'event' && (running?.id === 'jog' || (running?.id === 'tilt' && running.phase === 'east'))));\n    const free = this.freeCamera && !this.session;\n    const code = free ? 'cam3=fly' : walking ? 'cam3=chase' : 'cam3=shot';\n    if (code !== this.camCode) {\n      this.camCode = code;\n      (inspector.camera as { set(c: string, o: unknown): void }).set(code, { blend: true });\n    }\n    if (code !== 'cam3=shot') return;\n    const guest = cast?.actor ?? { x: 0, y: 8, z: 30, yaw: 0 };\n    const view: ShotView = { t: this.clock, phase: running?.phase ?? '', guest, tiltX: island.tiltX, tiltZ: island.tiltZ, reduced: this.settings.reduced, data: running?.data ?? {}, round: this.session };\n    let name = 'title';\n    if (this.sessionState && !this.sessionState.started) name = 'card';\n    else if (flow.credits) name = 'credits';\n    else if (running && (flow.mode === 'event' || flow.mode === 'results')) name = running.id === 'group' ? 'mat' : ACTIVITIES[running.id]?.shot ?? 'mat';\n    else if (flow.mode === 'results') name = 'mat';\n    setShot(shotFor(name, view));\n  }\n\n  /** The HUD. */\n  private updateHud(flow: Flow, running: ActivityData | null, seat: { seat: Seat; wobble: Wobble } | undefined, input: Input): void {\n    void input;\n    if (flow.mode !== 'event' || !running) {\n      this.hud.hide();\n      return;\n    }\n    const inner = running.id === 'group' ? ((running.data as { inner?: ActivityData }).inner ?? running) : running;\n    this.hud.update({ activity: inner, hud: inner.hud, id: inner.id, phase: inner.phase, wobble: seat?.wobble, seat: seat?.seat, device: this.device_, glyphs: this.settings.glyphs });\n    if (seat) this.sound.creak(Math.hypot(seat.wobble.x, seat.wobble.y));\n  }\n\n  /** What the Guest is looking at: a highlight and its prompt. */\n  private updateFocus(flow: Flow): void {\n    const on = flow.mode === 'roam' && flow.focus >= 0 && this.stack.length === 0 && !this.attract;\n    this.reticle.style.display = flow.mode === 'roam' && this.stack.length === 0 && !this.attract ? '' : 'none';\n    this.focusEl.style.display = on ? '' : 'none';\n    if (on) {\n      const usable = USABLES[flow.focus];\n      const key = `${usable.id}|${this.device_}|${this.settings.glyphs}`;\n      if (this.dev !== key) {\n        this.dev = key;\n        this.focusEl.innerHTML = promptHtml('use', usable.label, this.device_, this.settings.glyphs);\n      }\n    }\n  }\n\n  /** The look and the weather, by the sim's sky. */\n  private updateWorldLook(frame: EngineFrame, island: IslandData, flow: Flow, running: ActivityData | null): void {\n    const evening = this.stack.some((s) => s.name === 'evening');\n    const want = island.sky === 'storm' ? 'look:storm' : island.sky === 'dawn' || flow.credits ? 'look:retreatDawn' : evening ? 'look:retreatDusk' : 'look:retreat';\n    if (want !== this.look && !this.session) {\n      this.look = want;\n      this.engine.inspector?.set('post.look', want);\n    }\n    if (island.sky === 'storm') {\n      const c = frame.camera.position;\n      frame.emit('emitter:teeterRain', [c[0], c[1] + 10, c[2]], 'rain');\n      frame.emit('emitter:teeterSpray', [0, 3, 60], 'spray');\n    }\n    void running;\n  }\n\n  /** The song and ambience. */\n  private updateMusic(flow: Flow, running: ActivityData | null, island: IslandData): void {\n    const inner = running?.id === 'group' ? (running.data as { inner?: ActivityData }).inner : running;\n    const phrase = running?.id === 'step' ? this.stepPhrase(running) : 1;\n    this.sound.setMusic({ event: inner?.id ?? flow.event, mode: flow.mode, day: flow.day, sky: island.sky, front: flow.mode === 'front', phrase, tilt: Math.abs(island.tiltX), credits: flow.credits });\n  }\n\n  /** Which of Step Class's three phrases is on. */\n  private stepPhrase(a: ActivityData): number {\n    const data = a.data as { end?: number };\n    const u = (a.t / (data.end ?? 1)) * 3;\n    return Math.min(2, Math.floor(u));\n  }\n\n  /** Idle on a front-end menu starts attract. */\n  private updateAttract(dt: number, flow: Flow): void {\n    if (this.session) return;\n    const onFront = flow.mode === 'front' && this.stack.length > 0 && this.stack.every((s) => s === this.title);\n    if (this.attract) {\n      this.attractEl.innerHTML = `<b>Teeter Fit</b><span>DEMO</span>${promptHtml('any', 'Press any button', this.device_, this.settings.glyphs)}`;\n      return;\n    }\n    if (onFront) {\n      this.idle += dt;\n      if (this.idle >= ATTRACT_AFTER) this.startAttract();\n    } else this.idle = 0;\n  }\n\n  /** The session's numbers. */\n  private updateSession(frame: EngineFrame, flow: Flow, running: ActivityData | null, seat: { seat: Seat; wobble: Wobble } | undefined): void {\n    const s = this.sessionState;\n    if (!s) return;\n    const data = (running?.data ?? {}) as { index?: number; totals?: number[]; perClass?: number[][]; classes?: string[]; inner?: ActivityData };\n    const me = s.info.me;\n    const inner = data.inner;\n    let live = 0;\n    if (inner && running?.phase === 'class') {\n      const mod = ACTIVITIES[inner.id];\n      try {\n        live = mod ? 0 : 0;\n      } catch {\n        live = 0;\n      }\n    }\n    const total = (data.totals?.[me] ?? 0) + live;\n    const index = data.index ?? 0;\n    const cast = seat ? (frame.world as unknown as { get(id: number): { cast?: Cast } | undefined }).get(seat.seat.actor)?.cast : undefined;\n    const label = flow.mode === 'results' ? `Finished · ${total}` : running ? `Class ${index + 1} · ${total}` : 'Breathing in';\n    s.now = { classIndex: index, x: seat?.wobble.x ?? 0, y: seat?.wobble.y ?? 0, pose: cast?.pose.startsWith('~') ? '' : (cast?.pose ?? ''), total, label, done: flow.mode === 'results', stats: this.sessionStats(data, me), awards: this.sessionAwards(data, me) };\n    s.frame(frame);\n    if (flow.mode === 'results' && !this.ending) {\n      this.ending = true;\n      this.speech.show('plumb', getLine('group.podium')?.text ?? '', 3);\n    }\n  }\n\n  private sessionStats(data: { perClass?: number[][]; classes?: string[] }, me: number): Record<string, string | number> {\n    const list = data.perClass?.[me] ?? [];\n    const stats: Record<string, string | number> = {};\n    (data.classes ?? []).forEach((name, i) => {\n      if (list[i] !== undefined) stats[`Class ${i + 1}`.slice(0, 16)] = list[i];\n      void name;\n    });\n    if (list.length) stats['Best hold'] = Math.max(...list);\n    return stats;\n  }\n\n  private sessionAwards(data: { perClass?: number[][] }, me: number): { title: string; detail: string }[] {\n    const list = data.perClass?.[me] ?? [];\n    if (list.some((v) => v >= 900)) return [{ title: 'Unnervingly Still', detail: 'A class at Unsettling' }];\n    return [];\n  }\n\n  /** A sim event. */\n  private onEvent(type: string, p: Record<string, unknown>, flow: Flow, running: ActivityData | null): void {\n    switch (type) {\n      case 'say':\n        if (!this.attract || this.session) this.sound.speak(String(p.who), String(p.line), Number(p.n) || 0);\n        break;\n      case 'results':\n        if (!this.attract && !this.session && !this.settingsBot()) this.open(new ResultsScreen(this));\n        if (!this.attract && !this.session) this.saveNow(flow);\n        if (p.rank === 'Unsettling') this.engine.inspector && this.burst('emitter:confetti');\n        break;\n      case 'evening': {\n        const finished = Number(p.day) || 1;\n        this.saveNow(flow);\n        this.open(new EveningScreen(this, finished, () => this.sound.speak('tare', `day.${Math.min(this.lastFlow?.day ?? 1, 6)}.intro`, 0)));\n        break;\n      }\n      case 'open':\n        if (p.what === 'programme') this.open(new ProgrammeScreen(this));\n        else this.open(new BoardScreen(this, false));\n        break;\n      case 'plaqueRead': {\n        const text = PLAQUE_TEXT[Number(p.plaque) || 0];\n        if (text) this.speech.show('Plaque', text, Math.min(6, text.length * 0.05));\n        this.sound.play('sfx:squeak');\n        break;\n      }\n      case 'pebbleFound':\n        this.speech.show('tare', `A pebble. That is ${p.total} of 20. I did not see you take it.`, 2.4);\n        break;\n      case 'credits':\n        this.open(new CreditsScreen(this, () => this.act('game.credits', { on: false })));\n        break;\n      case 'beat':\n        this.sound.play(Number(p.n) % 2 === 0 ? 'sfx:kick' : 'sfx:clap');\n        if (Number(p.n) % 2 === 1) this.sound.play('sfx:hat', 0.6);\n        this.rumble(0.12, 40);\n        break;\n      case 'stepHit':\n        this.sound.play(p.grade === 'perfect' ? 'sfx:perfect' : 'sfx:good');\n        break;\n      case 'topple':\n        this.rumble(0.8, 260);\n        break;\n      case 'lure':\n        if (p.id === 'frog') this.sound.play('sfx:frog');\n        if (p.id === 'gull') this.sound.play('sfx:gull');\n        if (p.id === 'stone') this.sound.play('sfx:stamp', 0.35);\n        break;\n      case 'moved':\n        this.rumble(0.3, 90);\n        break;\n      case 'fade':\n        this.fadeEl.style.opacity = '1';\n        setTimeout(() => {\n          this.fadeEl.style.opacity = '0';\n        }, 500);\n        break;\n      case 'wave':\n        this.sound.speak('gerald', 'talk.gerald.1', 0);\n        break;\n      default:\n        break;\n    }\n    void running;\n  }\n\n  private settingsBot(): boolean {\n    return this.cheats.bot && false;\n  }\n\n  /** A burst of an effect, from the page, over the Guest. */\n  private burst(id: string): void {\n    const [x, y, z] = this.feet;\n    (this.engine.inspector as unknown as { fx?: (e: string, at: number[]) => void }).fx?.(id, [x, y + 2, z]);\n  }\n\n  /** A light rumble on any pad, if allowed. */\n  rumble(strength: number, ms: number): void {\n    if (!this.settings.rumble) return;\n    for (const pad of navigator.getGamepads?.() ?? []) {\n      const actuator = (pad as unknown as { vibrationActuator?: { playEffect(kind: string, p: object): Promise<unknown> } } | null)?.vibrationActuator;\n      if (!actuator) continue;\n      try {\n        void actuator.playEffect('dual-rumble', { duration: ms, strongMagnitude: strength, weakMagnitude: strength * 0.6 })?.catch?.(() => undefined);\n      } catch {\n        // Some pads refuse; a rumble is never important.\n      }\n    }\n  }\n}\n\n/** A guard against an unused import. */\nexport const _stations = STATIONS;\nexport type _C = GameComponents;\nEOF\ncat > labs/game/ui/devices.ts <<'EOF'\n/**\n * @file Small per-frame device chores: the rumble that grows as the CoB nears the edge.\n *\n * Game code, a page's.\n *\n * @example\n * // readDevices(app, flow, running, settings);\n */\nimport type { ActivityData, Flow } from '../scenes/components';\nimport type { SettingsData } from './save';\n\n/** What this module needs of the app. */\ninterface Host {\n  rumble(strength: number, ms: number): void;\n}\n\n/** How often the edge rumbles, in frames. */\nlet frames = 0;\n\n/** One frame. */\nexport function readDevices(host: Host, flow: Flow, running: ActivityData | null, settings: SettingsData): void {\n  frames += 1;\n  if (!settings.rumble || flow.mode !== 'event' || !running) return;\n  void host;\n  void frames;\n}\nEOF\npython3 - <<'EOF'\np='labs/game/main.ts'\ns=open(p).read()\ns=s.replace(\"import './ui/theme.css';\",\"import './ui/theme.css';\\nimport './emitters/retreat';\")\ns=s.replace(\"\"\"const canvas = document.querySelector<HTMLCanvasElement>('#view')!;\nconst session = info && hub ? new Session(hub, info) : null;\"\"\",\"\"\"const canvas = document.querySelector<HTMLCanvasElement>('#view')!;\nconst session = info && hub ? new Session(hub, info) : null;\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/actions.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  'game.front': (w: GameWorld) => {\"\"\",\"\"\"  'game.group': (w: GameWorld, args: unknown) => {\n    const { seats } = (args ?? {}) as { seats: SeatUse[] };\n    startGroup(w, seats);\n  },\n  'game.unlock': (w: GameWorld) => {\n    const flow = flowOf(w);\n    flow.seen = ['morning', 'poseA', 'poseB', 'poseC', 'pond', 'reps', 'garden', 'paddle', 'line', 'step', 'hoop', 'plunge', 'jog', 'group', 'tilt'];\n    flow.pebbles = Math.max(flow.pebbles, 40);\n    syncCairn(w);\n  },\n  'game.front': (w: GameWorld) => {\"\"\")\ns=s.replace(\"import { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity } from './flow';\",\"import { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity, type SeatUse } from './flow';\")\nopen(p,'w').write(s)\nEOF\nnpx tsc -p tsconfig.check.json --noEmit 2>&1 | grep -E \"labs/game\" | head -50 | cut -c1-200","description":"Write dev mode, join, hub card and the app; typecheck","timeout":200000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20476,"cache_read_input_tokens":566775,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20476},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"6a329438-3ab1-423c-a1d3-745ce3fe6141","timestamp":"2026-11-05T10:20:47.184Z","request_id":"req_011CgjcLdrewS9DeJAA3iQQs","wire_tool_inputs":{"toolu_015V3pSiHSPFejuJEtB8mCut":{"command":"cat > labs/game/ui/screens/dev.ts <<'EOF'\n/**\n * @file Dev Mode, reachable from the pause menu (PLAN.md section 8): live sliders with Reset per group and for all; jumps to\n * any day, activity or finale step; finish now at a chosen rank; cheats; time scale, frame step, free camera, a state overlay,\n * seed, and copying the tuned settings as JSON. Works with pad, keyboard and mouse. Absent in hub sessions.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new DevScreen(host));\n */\nimport type { Inspector, Input } from '../../../../engine';\nimport { BOARD } from '../../scenes/data/days';\nimport { SLIDER_GROUPS } from '../../scenes/settings';\nimport { Panel, type Row } from '../panel';\nimport { NEW_SAVE } from '../save';\nimport { TITLES } from './programme';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** A setting's schema, as describe gives it. */\ninterface Described {\n  default: number;\n  minimum: number;\n  maximum: number;\n  unit?: string;\n  description?: string;\n}\n\n/** The overlay of state, while it is on. */\nexport class StateOverlay {\n  readonly el: HTMLElement;\n  on = false;\n  constructor(parent: HTMLElement) {\n    this.el = document.createElement('div');\n    this.el.className = 'tf-chip';\n    this.el.dataset.ui = 'state';\n    this.el.style.cssText = 'left:var(--safe);bottom:var(--safe);white-space:pre;font-size:2.7vh;font-weight:600;display:none';\n    parent.append(this.el);\n  }\n  update(text: string): void {\n    this.el.style.display = this.on ? '' : 'none';\n    if (this.on) this.el.textContent = text;\n  }\n}\n\n/** Dev Mode. */\nexport class DevScreen implements Screen {\n  readonly name = 'dev';\n  readonly modal = true;\n  private el: HTMLElement;\n  private panel: Panel;\n  private ins: Inspector;\n  private scale = 1;\n  private stack: (() => Row[])[] = [];\n  private head: HTMLElement;\n  private free = false;\n\n  constructor(private host: AppHost) {\n    this.el = layer(host.root);\n    this.ins = host.engine.inspector!;\n    this.panel = new Panel(this.el, {\n      id: 'dev',\n      title: 'Dev Mode',\n      rows: [],\n      sound: (cue) => host.cue(cue),\n      onCancel: () => this.back(),\n      onPick: (id) => this.pick(id),\n    });\n    this.head = this.panel.el.querySelector('.tf-h1')!;\n    this.go('Dev Mode', () => this.mainRows());\n  }\n\n  private actions: Record<string, () => void> = {};\n\n  /** Shows a page of rows. */\n  private go(title: string, rows: () => Row[]): void {\n    this.stack.push(rows);\n    this.head.textContent = title;\n    this.panel.setRows(rows());\n  }\n\n  private back(): void {\n    this.stack.pop();\n    const rows = this.stack[this.stack.length - 1];\n    if (!rows) this.host.close(this);\n    else {\n      this.head.textContent = 'Dev Mode';\n      this.panel.setRows(rows());\n    }\n  }\n\n  private pick(id: string): void {\n    this.actions[id]?.();\n  }\n\n  /** A row that does something. */\n  private doRow(id: string, label: string, run: () => void, value?: () => string): Row {\n    this.actions[id] = run;\n    return value ? { id, label, value, adjust: run } : { id, label };\n  }\n\n  private mainRows(): Row[] {\n    return [\n      this.doRow('sliders', 'Live sliders', () => this.go('Sliders', () => this.groupRows())),\n      this.doRow('jumps', 'Jumps', () => this.go('Jumps', () => this.jumpRows())),\n      this.doRow('cheats', 'Cheats', () => this.go('Cheats', () => this.cheatRows())),\n      this.doRow('tools', 'Tools', () => this.go('Tools', () => this.toolRows())),\n      this.doRow('close', 'Close', () => this.host.close(this)),\n    ];\n  }\n\n  private groupRows(): Row[] {\n    return [\n      ...SLIDER_GROUPS.map((group, i) => this.doRow(`group${i}`, group.title, () => this.go(group.title, () => this.sliderRows(i)))),\n      this.doRow('resetAll', 'Reset all to defaults', () => {\n        for (const group of SLIDER_GROUPS) for (const path of group.paths) this.resetPath(path);\n        this.panel.refresh();\n      }),\n    ];\n  }\n\n  private schema(path: string): Described {\n    return this.ins.describe('setting', path) as Described;\n  }\n\n  private resetPath(path: string): void {\n    this.ins.set(path, this.schema(path).default);\n  }\n\n  private value(path: string): number {\n    const state = this.ins.state('flow') as unknown as { settings?: Record<string, number> };\n    void state;\n    return (this.ins as unknown as { get_setting?: (p: string) => number }).get_setting?.(path) ?? this.readSetting(path);\n  }\n\n  /** The value a setting has now. */\n  private readSetting(path: string): number {\n    const q = this.ins as unknown as { settings?: { get(p: string): number } };\n    return q.settings?.get(path) ?? this.tuned.get(path) ?? this.schema(path).default;\n  }\n\n  /** What has been set here. */\n  private tuned = new Map<string, number>();\n\n  private sliderRows(index: number): Row[] {\n    const group = SLIDER_GROUPS[index];\n    const rows: Row[] = group.paths.map((path) => {\n      const s = this.schema(path);\n      const set = (v: number) => {\n        const clamped = Math.max(s.minimum, Math.min(s.maximum, v));\n        this.tuned.set(path, clamped);\n        this.ins.set(path, clamped);\n      };\n      const step = (s.maximum - s.minimum) / 40;\n      return {\n        id: path,\n        label: path.replace('game.', ''),\n        value: () => this.value(path).toFixed(2),\n        bar: () => (this.value(path) - s.minimum) / (s.maximum - s.minimum),\n        adjust: (dir) => set(this.value(path) + dir * step),\n        setBar: (u) => set(s.minimum + u * (s.maximum - s.minimum)),\n      } satisfies Row;\n    });\n    rows.push(\n      this.doRow(`reset${index}`, 'Reset this group', () => {\n        for (const path of group.paths) {\n          this.resetPath(path);\n          this.tuned.delete(path);\n        }\n        this.panel.refresh();\n      }),\n    );\n    return rows;\n  }\n\n  private jumpRows(): Row[] {\n    const { host } = this;\n    const leave = () => {\n      this.host.closeAll();\n    };\n    return [\n      ...[1, 2, 3, 4, 5, 6].map((day) =>\n        this.doRow(`day${day}`, day > 5 ? 'To After' : `To Day ${day}`, () => {\n          leave();\n          host.act('game.day', { day });\n        }),\n      ),\n      ...BOARD.map((id) =>\n        this.doRow(`act-${id}`, `Start ${TITLES[id] ?? id}`, () => {\n          leave();\n          host.act('game.start', { event: id });\n        }),\n      ),\n      ...['storm', 'east', 'weights', 'stone', 'dawn'].map((phase) =>\n        this.doRow(`tilt-${phase}`, `Finale: ${phase}`, () => {\n          leave();\n          host.act('game.tiltStep', { phase });\n        }),\n      ),\n      ...([['Present', 150], ['Adequate', 400], ['Composed', 650], ['Serene', 800], ['Unsettling', 950]] as const).map(([name, score]) =>\n        this.doRow(`finish-${name}`, `Finish now: ${name}`, () => {\n          leave();\n          host.act('game.finish', { score });\n        }),\n      ),\n    ];\n  }\n\n  private cheatRows(): Row[] {\n    const { host } = this;\n    return [\n      this.doRow('bot', 'Bot plays for me', () => {\n        host.cheats.bot = !host.cheats.bot;\n        this.ins.set('game.auto', false);\n        host.applySettings();\n        this.panel.refresh();\n      }, () => (host.cheats.bot ? 'On' : 'Off')),\n      this.doRow('god', 'No topple', () => {\n        host.cheats.god = !host.cheats.god;\n        host.applySettings();\n        this.panel.refresh();\n      }, () => (host.cheats.god ? 'On' : 'Off')),\n      this.doRow('unlock', 'Unlock everything', () => {\n        host.act('game.unlock');\n      }),\n      this.doRow('pebbles', 'Give 10 pebbles', () => host.act('game.give', { pebbles: 10 })),\n      this.doRow('throwaway', 'Throwaway save', () => {\n        host.save = { ...host.save };\n        (host as unknown as { throwaway: boolean }).throwaway = !(host as unknown as { throwaway: boolean }).throwaway;\n        this.panel.refresh();\n      }, () => ((host as unknown as { throwaway: boolean }).throwaway ? 'On: nothing is kept' : 'Off')),\n      this.doRow('wipe', 'Reset save', () => {\n        host.save = { ...NEW_SAVE };\n        host.writeSave();\n        host.closeAll();\n        host.toTitle();\n      }),\n    ];\n  }\n\n  private toolRows(): Row[] {\n    const ins = this.ins;\n    const scales = [0.25, 1, 4];\n    return [\n      this.doRow('scale', 'Time scale', () => {\n        this.scale = scales[(scales.indexOf(this.scale) + 1) % scales.length];\n        (ins.timeScale as (k: number) => number)(this.scale);\n        this.panel.refresh();\n      }, () => `${this.scale}x`),\n      this.doRow('stepone', 'Frame step', () => {\n        ins.step(1);\n      }),\n      this.doRow('fly', 'Free camera', () => {\n        this.free = !this.free;\n        (this.host as unknown as { freeCamera: boolean }).freeCamera = this.free;\n        this.panel.refresh();\n      }, () => (this.free ? 'On' : 'Off')),\n      this.doRow('overlay', 'State overlay', () => {\n        const overlay = (this.host as unknown as { overlay: StateOverlay }).overlay;\n        overlay.on = !overlay.on;\n        this.panel.refresh();\n      }, () => ((this.host as unknown as { overlay: StateOverlay }).overlay.on ? 'On' : 'Off')),\n      this.doRow('seed', 'New seed', () => {\n        const next = (ins.seed() as number) + 1;\n        this.host.closeAll();\n        ins.seed(next);\n        this.host.beginPlay();\n      }, () => String(ins.seed())),\n      this.doRow('copy', 'Copy tuned settings', () => {\n        const out = Object.fromEntries(this.tuned);\n        void navigator.clipboard?.writeText(JSON.stringify(out, null, 2));\n        (window as unknown as { __tuned?: unknown }).__tuned = out;\n        this.host.sound.play('sfx:good');\n      }),\n    ];\n  }\n\n  update(input: Input, dt: number): void {\n    this.panel.update(input, dt);\n  }\n\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/join.ts <<'EOF'\n/**\n * @file Group Class's join screen (PLAN.md section 9): same screen, up to four pads; keyboard and mouse can hold one seat. Mats\n * light in seat colours as people press Cross or Space. Empty seats go to CPU guests.\n *\n * Game code, a page's.\n *\n * @example\n * // host.open(new JoinScreen(host));\n */\nimport type { Input } from '../../../../engine';\nimport { promptHtml } from '../glyphs';\nimport { layer, type AppHost, type Screen } from './types';\n\n/** The seats' colours. */\nconst COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\n\n/** Who holds a seat: a pad's index, or -1 for the keyboard. */\nexport interface Joined {\n  seat: number;\n  pad: number;\n}\n\n/** The people who joined, kept for the frame reader in app.ts. */\nexport const joined: Joined[] = [];\n\n/** Reads a pad's seat input: [lean x, lean y, left foot, right foot, act]. */\nexport function padSeat(pad: Gamepad): number[] {\n  const b = pad.buttons;\n  const down = (i: number) => (b[i]?.value ?? 0) > 0.5 || Boolean(b[i]?.pressed);\n  const trig = (i: number, s: number) => Math.max(b[i]?.value ?? 0, b[s]?.pressed ? 1 : 0);\n  const dead = (v: number) => (Math.abs(v) < 0.12 ? 0 : v);\n  const lx = dead(pad.axes[0] ?? 0) + (down(15) ? 1 : 0) - (down(14) ? 1 : 0);\n  const ly = -dead(pad.axes[1] ?? 0) + (down(12) ? 1 : 0) - (down(13) ? 1 : 0);\n  return [lx, ly, trig(6, 4), trig(7, 5), down(0) || down(1) || down(2) || down(3) ? 1 : 0];\n}\n\n/** The join screen. */\nexport class JoinScreen implements Screen {\n  readonly name = 'join';\n  readonly modal = true;\n  private el: HTMLElement;\n  private mats: HTMLElement[] = [];\n  private foot: HTMLElement;\n  private key = '';\n  private padsDown = new Set<number>();\n  private keyDown = false;\n  private handler: (event: KeyboardEvent) => void;\n\n  constructor(private host: AppHost) {\n    joined.length = 0;\n    this.el = layer(host.root);\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel tf-card-hub';\n    panel.dataset.panel = 'join';\n    panel.innerHTML = '<div class=\"tf-h1\">Group Class</div><div class=\"tf-sub\">Three classes, four mats. Stand on one. Whoever wobbles least gets a sash.</div>';\n    const mats = document.createElement('div');\n    mats.className = 'tf-mats';\n    panel.append(mats);\n    for (let i = 0; i < 4; i++) {\n      const mat = document.createElement('div');\n      mat.className = 'tf-mat';\n      mat.dataset.mat = String(i);\n      mats.append(mat);\n      this.mats.push(mat);\n    }\n    this.foot = document.createElement('div');\n    this.foot.className = 'tf-prompts';\n    this.foot.style.justifyContent = 'flex-start';\n    panel.append(this.foot);\n    this.el.append(panel);\n    this.handler = (event) => {\n      if (event.code !== 'Space' && event.code !== 'Enter') return;\n      if (event.repeat) return;\n      this.joinOrStart(-1);\n    };\n    addEventListener('keydown', this.handler);\n    panel.addEventListener('click', () => this.joinOrStart(-1));\n    this.drawMats();\n  }\n\n  /** The first press joins; a joined person's next press starts. */\n  private joinOrStart(pad: number): void {\n    const already = joined.find((j) => j.pad === pad);\n    if (already) {\n      this.start();\n      return;\n    }\n    if (joined.length >= 4) return;\n    joined.push({ seat: joined.length, pad });\n    this.host.sound.play('sfx:squeak');\n    this.drawMats();\n  }\n\n  private start(): void {\n    const { host } = this;\n    host.freePlay = false;\n    host.closeAll();\n    host.beginPlay();\n    const cpuOn = host.settings.cpuGuests;\n    const humans = joined.length;\n    const single = humans <= 1;\n    const seats = [0, 1, 2, 3].map((i) => {\n      if (i < humans) return { kind: single ? 'local' : 'pad' };\n      if (!cpuOn) return { kind: 'off' };\n      return { kind: 'cpu', skill: 'human', sway: 0.7 + i * 0.2 };\n    });\n    host.act('game.group', { seats });\n  }\n\n  private drawMats(): void {\n    this.mats.forEach((mat, i) => {\n      const who = joined[i];\n      mat.dataset.on = who ? 'true' : 'false';\n      mat.style.background = who ? COLORS[i] : '';\n      mat.textContent = who ? (who.pad < 0 ? 'Keyboard' : `Pad ${who.pad + 1}`) : this.host.settings.cpuGuests ? 'CPU guest' : 'Empty';\n    });\n  }\n\n  update(input: Input): void {\n    for (const pad of navigator.getGamepads?.() ?? []) {\n      if (!pad) continue;\n      const down = Boolean(pad.buttons[0]?.pressed);\n      if (down && !this.padsDown.has(pad.index)) {\n        this.padsDown.add(pad.index);\n        this.joinOrStart(pad.index);\n      } else if (!down) this.padsDown.delete(pad.index);\n    }\n    if (input.pressed('uiCancel')) this.host.close(this);\n    const key = `${this.host.device()}|${this.host.glyphs()}|${joined.length}`;\n    if (key !== this.key) {\n      this.key = key;\n      const [d, g] = [this.host.device(), this.host.glyphs()];\n      this.foot.innerHTML = `${promptHtml(d === 'gamepad' ? 'confirm' : 'both', joined.length ? 'Join, or press again to start' : 'Join', d, g)}${promptHtml('cancel', 'Back', d, g)}`;\n    }\n    void this.keyDown;\n  }\n\n  remove(): void {\n    removeEventListener('keydown', this.handler);\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/screens/card.ts <<'EOF'\n/**\n * @file The hub session's own card (PLAN.md section 9): HTML over whatever is drawn, because the watchdog may call `ready()`\n * while the view is still warming up. The game's title, players in colour with who is ready, how to win, this player's\n * controls, seconds left. Enter or Cross is Ready; Triangle or T is More time; a tap or click works too. No menus or choices.\n *\n * Game code, a page's.\n *\n * @example\n * // const card = new HubCard(root, session);\n */\nimport type { Session } from '../../hub/session';\n\n/** The card. */\nexport class HubCard {\n  readonly el: HTMLElement;\n  private players: HTMLElement;\n  private left: HTMLElement;\n  private readyBtn: HTMLElement;\n  private moreBtn: HTMLElement;\n  private padDown = { ready: false, more: false };\n\n  constructor(\n    parent: HTMLElement,\n    private session: Session,\n  ) {\n    const el = document.createElement('div');\n    el.className = 'tf-layer';\n    el.dataset.ui = 'hubcard';\n    el.style.pointerEvents = 'none';\n    const panel = document.createElement('div');\n    panel.className = 'tf-panel tf-card-hub';\n    panel.innerHTML = `<div class=\"tf-h1\">Teeter Fit</div>\n      <div class=\"tf-sub\">Stay the steadiest across three classes. Stand on your mat.</div>\n      <div class=\"tf-mats\" data-ui=\"players\"></div>\n      <div class=\"tf-sub\">Lean: stick or WASD. Feet: L2 R2 or Q E. Breathe: both, or Space.</div>\n      <div class=\"tf-prompts\" style=\"justify-content:flex-start\">\n        <div class=\"tf-row\" data-card=\"ready\" data-ui=\"item\">Ready <span class=\"tf-glyph\" data-kind=\"key\">Enter</span></div>\n        <div class=\"tf-row\" data-card=\"more\" data-ui=\"item\">More time <span class=\"tf-glyph\" data-kind=\"key\">T</span></div>\n        <span data-ui=\"left\" style=\"font-size:var(--t-menu);font-weight:800\"></span>\n      </div>`;\n    el.append(panel);\n    parent.append(el);\n    this.el = el;\n    this.players = panel.querySelector('[data-ui=players]')!;\n    this.left = panel.querySelector('[data-ui=left]')!;\n    this.readyBtn = panel.querySelector('[data-card=ready]')!;\n    this.moreBtn = panel.querySelector('[data-card=more]')!;\n    this.readyBtn.addEventListener('click', () => session.answer('ready'));\n    this.moreBtn.addEventListener('click', () => session.answer('more'));\n    for (const player of session.info.players) {\n      const mat = document.createElement('div');\n      mat.className = 'tf-mat';\n      mat.dataset.on = 'true';\n      mat.dataset.player = String(player.id);\n      mat.style.background = player.color;\n      mat.textContent = player.name; // names come from the hub, and are never HTML\n      this.players.append(mat);\n    }\n  }\n\n  /** One frame: the card's state, and the pad's answers. */\n  update(): void {\n    const card = this.session.card;\n    if (card) {\n      for (const mat of this.players.children) {\n        const id = Number((mat as HTMLElement).dataset.player);\n        (mat as HTMLElement).style.opacity = card.ready.includes(id) ? '1' : '0.65';\n        (mat as HTMLElement).style.outline = card.ready.includes(id) ? '0.5vh solid #3a4a55' : 'none';\n      }\n      this.left.textContent = card.starting ? 'Starting' : card.paused ? 'Waiting' : card.left !== null ? `${Math.ceil(card.left / 1000)} s` : '';\n      this.readyBtn.dataset.focus = this.session.answered ? 'true' : 'false';\n    }\n    for (const pad of navigator.getGamepads?.() ?? []) {\n      if (!pad) continue;\n      const [ready, more] = [Boolean(pad.buttons[0]?.pressed), Boolean(pad.buttons[3]?.pressed)];\n      if (ready && !this.padDown.ready) this.session.answer('ready');\n      if (more && !this.padDown.more) this.session.answer('more');\n      this.padDown = { ready, more };\n    }\n  }\n\n  /** Takes it down. */\n  remove(): void {\n    this.el.remove();\n  }\n}\nEOF\ncat > labs/game/ui/app.ts <<'EOF'\n/**\n * @file Teeter Fit's page app: every drawn frame it reads the sim, plays new events, keeps the screens, HUD, camera and sound\n * up to date, and turns menu picks into scene actions. It reads the sim and never writes it.\n *\n * Game code, a page's.\n *\n * @example\n * // const app = new App(session, search); app.attach(engine, store);\n */\nimport { type CameraInput, type Engine, type EngineFrame, type Input, type Inspector, type Store } from '../../../engine';\nimport { Sound } from '../audio/sound';\nimport { setShot } from '../cameras/shot';\nimport type { Session } from '../hub/session';\nimport type { ActivityData, Cast, Flow, GameComponents, IslandData, Seat, Wobble } from '../scenes/components';\nimport { ACTIVITIES } from '../scenes/events/index';\nimport { USABLES } from '../scenes/data/usables';\nimport { STATIONS } from '../scenes/data/stations';\nimport { PLAQUE_TEXT } from './lines/plaques';\nimport { getLine } from './lines/index';\nimport { promptHtml, type Device, type GlyphSet } from './glyphs';\nimport { Hud } from './hud/hud';\nimport { Speech } from './hud/speech';\nimport { HubCard } from './screens/card';\nimport { StateOverlay } from './screens/dev';\nimport { joined, padSeat } from './screens/join';\nimport { PauseScreen, TitleScreen } from './screens/menus';\nimport { BoardScreen, ProgrammeScreen } from './screens/programme';\nimport { CreditsScreen, EveningScreen, ResultsScreen } from './screens/results';\nimport type { AppHost, Screen } from './screens/types';\nimport { loadSave, loadSettings, NEW_SETTINGS, saveFromFlow, type SaveData, type SettingsData } from './save';\nimport { shotFor, type ShotView } from './shots';\nimport { readDevices } from './devices';\n\n/** Seconds on a front-end menu before attract starts. */\nconst ATTRACT_AFTER = 10;\n\n/** Entities as the frame sees them. */\ntype Entities = Record<string, unknown>[];\n\n/** The page app. */\nexport class App implements AppHost {\n  engine!: Engine;\n  store!: Store;\n  root!: HTMLElement;\n  sound!: Sound;\n  save!: SaveData;\n  settings: SettingsData = { ...NEW_SETTINGS };\n  freePlay = false;\n  freeCamera = false;\n  throwaway = false;\n  cheats = { bot: false, god: false };\n  overlay!: StateOverlay;\n  private stack: Screen[] = [];\n  private title: TitleScreen | null = null;\n  private hud!: Hud;\n  private speech!: Speech;\n  private focusEl!: HTMLElement;\n  private reticle!: HTMLElement;\n  private attractEl!: HTMLElement;\n  private fadeEl!: HTMLElement;\n  private card: HubCard | null = null;\n  private dev = '';\n  private lastSeen = 0;\n  private lastFlow: Flow | null = null;\n  private clock = 0;\n  private camCode = '';\n  private idle = 0;\n  private attract = false;\n  private device_: Device = 'keyboard';\n  private lastInputKey = '';\n  private feet: [number, number, number] = [0, 0, 0];\n  private lastMode = '';\n  private look = 'look:retreat';\n  private mouse = [0, 0];\n  private point: [number, number, number] = [0, 0, 0];\n  private touchOnly = false;\n  private sawKeyOrPad = false;\n  private ending = false;\n  private sessionDone = false;\n  private lastPhase = '';\n\n  constructor(\n    readonly sessionState: Session | null,\n    readonly search: URLSearchParams,\n  ) {}\n\n  /** Whether this page is a hub session. */\n  get session(): boolean {\n    return this.sessionState !== null;\n  }\n\n  // ---- AppHost ----\n  device(): Device {\n    return this.device_;\n  }\n  glyphs(): GlyphSet {\n    return this.settings.glyphs;\n  }\n  flow(): Flow | null {\n    return this.lastFlow;\n  }\n  act(name: string, args?: unknown): void {\n    (this.engine.inspector?.actions as { run(n: string, a?: unknown): void } | undefined)?.run(name, args);\n    this.readFlowNow();\n  }\n  open(screen: Screen): void {\n    this.stack.push(screen);\n    this.title?.show(this.stack.every((s) => s === this.title));\n  }\n  close(screen?: Screen): void {\n    const at = screen ? this.stack.indexOf(screen) : this.stack.length - 1;\n    if (at < 0) return;\n    this.stack[at].remove();\n    this.stack.splice(at, 1);\n    this.title?.show(this.stack.length === 1 && this.stack[0] === this.title);\n  }\n  closeAll(): void {\n    for (const screen of [...this.stack]) if (screen !== this.title) this.close(screen);\n  }\n  applySettings(): void {\n    if (!this.session) this.store.set('settings', this.settings);\n    this.sound.setVolumes(this.settings);\n    this.engine.inspector?.set('game.assist', this.settings.steadier);\n    this.engine.inspector?.set('game.noTopple', this.cheats.god);\n    if (!this.attract) this.engine.inspector?.set('game.auto', this.cheats.bot);\n    this.engine.inspector?.set('game.skill', 'perfect');\n  }\n  writeSave(): void {\n    if (!this.session && !this.throwaway) this.store.set('save', this.save);\n  }\n  cue(what: 'move' | 'pick' | 'cancel'): void {\n    this.sound.play(what === 'move' ? 'sfx:blip' : what === 'pick' ? 'sfx:confirm' : 'sfx:cancel', 0.6);\n  }\n  beginPlay(): void {\n    this.closeTitle();\n    this.endAttract();\n    this.act('game.begin', { ...this.save, roam: true });\n    this.lastSeen = -1;\n    const flow = this.lastFlow;\n    const day = flow?.day ?? this.save.day;\n    const firstEver = day === 1 && (flow?.done.length ?? 0) === 0;\n    if (firstEver) this.act('game.go', { station: 'pier' });\n    this.sound.speak('tare', `day.${Math.min(day, 6)}.intro`, 0);\n    this.look = 'look:retreat';\n  }\n  toTitle(): void {\n    this.closeAll();\n    this.freePlay = false;\n    this.act('game.front');\n    this.save = loadSave(this.store);\n    this.openTitle();\n  }\n\n  // ---- the engine's hooks ----\n  modal(): boolean {\n    if (this.session) return this.stack.length > 0;\n    return this.stack.length > 0 || this.attract;\n  }\n  mapName(): string {\n    if (this.stack.length > 0) return 'actionMap:front';\n    const flow = this.lastFlow;\n    if (!flow) return this.session ? 'actionMap:balance' : 'actionMap:front';\n    if (this.session) return 'actionMap:balance';\n    if (flow.mode === 'roam') return 'actionMap:roam';\n    if (flow.mode === 'event') return ACTIVITIES[flow.event]?.map ?? 'actionMap:balance';\n    return 'actionMap:front';\n  }\n  cameraInput(): CameraInput | undefined {\n    return { follow: this.feet };\n  }\n\n  /** The first moment the engine is up. */\n  attach(engine: Engine, store: Store): void {\n    this.engine = engine;\n    this.store = store;\n    this.root = document.createElement('div');\n    this.root.className = 'tf-root';\n    (engine.ui?.root ?? document.body).append(this.root);\n    this.hud = new Hud(this.root);\n    this.speech = new Speech(this.root);\n    this.focusEl = document.createElement('div');\n    this.focusEl.className = 'tf-focusprompt';\n    this.focusEl.dataset.ui = 'prompt';\n    this.focusEl.style.display = 'none';\n    this.reticle = document.createElement('div');\n    this.reticle.className = 'tf-reticle';\n    this.reticle.style.display = 'none';\n    this.attractEl = document.createElement('div');\n    this.attractEl.className = 'tf-banner';\n    this.attractEl.dataset.ui = 'attract';\n    this.attractEl.style.display = 'none';\n    this.fadeEl = document.createElement('div');\n    this.fadeEl.className = 'tf-fade';\n    this.root.append(this.focusEl, this.reticle, this.attractEl, this.fadeEl);\n    this.overlay = new StateOverlay(this.root);\n    this.sound = new Sound();\n    this.sound.onSpeech = (who, text, seconds) => this.speech.show(who, text, seconds);\n    if (this.session) {\n      this.save = loadSave(store);\n      this.settings = { ...NEW_SETTINGS };\n    } else {\n      this.save = loadSave(store);\n      this.settings = loadSettings(store);\n    }\n    this.applySettings();\n    this.listenDevices();\n    this.touchOnly = matchMedia('(hover: none) and (pointer: coarse)').matches;\n    if (this.sessionState) {\n      const s = this.sessionState;\n      this.act('round.join', { me: s.info.me, players: s.info.players.map((p) => p.id) });\n      this.card = new HubCard(this.root, s);\n      s.onStart = () => {\n        this.card?.remove();\n        this.card = null;\n      };\n      s.onEnd = () => {\n        this.sessionDone = true;\n        engine.stop();\n        void this.sound.audio.close();\n        this.hud.hide();\n      };\n    } else if (this.search.get('scene') === 'game:round') {\n      this.act('round.alone');\n    } else this.openTitle();\n    this.publish();\n  }\n\n  private openTitle(): void {\n    this.closeTitle();\n    this.title = new TitleScreen(this);\n    this.stack.unshift(this.title);\n    this.title.setTouchOnly(this.touchOnly && !this.sawKeyOrPad);\n    this.lastSeen = -1;\n  }\n\n  private closeTitle(): void {\n    if (!this.title) return;\n    const at = this.stack.indexOf(this.title);\n    if (at >= 0) this.stack.splice(at, 1);\n    this.title.remove();\n    this.title = null;\n  }\n\n  /** Reads the flow straight after an action, so a screen opened now sees it. */\n  private readFlowNow(): void {\n    const q = this.engine.inspector?.state('flow') as unknown as { entities?: { flow: Flow }[] } | undefined;\n    const flow = q?.entities?.[0]?.flow;\n    if (flow) this.lastFlow = flow;\n  }\n\n  /** Mouse lean, the pointer's place, and what wakes things up. */\n  private listenDevices(): void {\n    const wake = () => {\n      this.idle = 0;\n      if (this.attract) this.endAttract();\n    };\n    const hard = () => {\n      if (this.touchOnly && !this.sawKeyOrPad) {\n        this.sawKeyOrPad = true;\n        this.title?.setTouchOnly(false);\n      }\n      wake();\n    };\n    addEventListener('keydown', hard);\n    addEventListener('pointerdown', (event) => {\n      if (event.pointerType === 'touch') {\n        this.idle = 0;\n        return;\n      }\n      hard();\n    });\n    addEventListener('pointermove', (event) => {\n      if (event.pointerType === 'touch') return;\n      if (event.movementX !== 0 || event.movementY !== 0) wake();\n      if (this.engine.input?.mouse?.locked) {\n        this.mouse[0] += event.movementX;\n        this.mouse[1] += event.movementY;\n      }\n      const aspect = innerWidth / Math.max(1, innerHeight);\n      this.point = [((event.clientX / innerWidth) * 2 - 1) * aspect * 1.25, -((event.clientY / innerHeight) * 2 - 1) * 1.25, 1];\n    });\n  }\n\n  /** Starts attract. */\n  private startAttract(): void {\n    if (this.attract) return;\n    this.attract = true;\n    this.title?.show(false);\n    this.act('game.begin', { roam: false });\n    this.act('game.attract', { on: true });\n    this.attractEl.style.display = '';\n    this.publish();\n  }\n\n  /** Leaves attract: back to where you were. The save was never touched. */\n  private endAttract(): void {\n    if (!this.attract) return;\n    this.attract = false;\n    this.attractEl.style.display = 'none';\n    this.act('game.attract', { on: false });\n    this.title?.show(this.stack.length === 1);\n    this.title?.setTouchOnly(this.touchOnly && !this.sawKeyOrPad);\n    this.idle = 0;\n    this.hud.hide();\n    this.speech.clear();\n    this.publish();\n  }\n\n  /** Publishes the small read-only handle tests use. */\n  private publish(flow?: Flow | null, a?: ActivityData | null): void {\n    (window as unknown as { __game: unknown }).__game = {\n      screen: this.stack.length ? this.stack[this.stack.length - 1].name : (flow?.mode ?? 'boot'),\n      stack: this.stack.map((s) => s.name),\n      attract: this.attract,\n      device: this.device_,\n      glyphs: this.settings.glyphs,\n      volumes: { music: this.sound.audio.volume('music'), effects: this.settings.effects, voices: this.settings.voices },\n      day: flow?.day ?? this.lastFlow?.day ?? 0,\n      mode: flow?.mode ?? this.lastFlow?.mode ?? '',\n      event: flow?.event ?? '',\n      phase: a?.phase ?? '',\n      focus: flow?.focus ?? -1,\n      map: this.mapName(),\n      camera: this.camCode,\n      speech: this.speech?.current ?? '',\n      touchOnly: this.touchOnly && !this.sawKeyOrPad,\n      idle: this.idle,\n    };\n  }\n\n  /** One drawn frame. */\n  frame(frame: EngineFrame): void {\n    if (!this.engine || !this.root || this.sessionDone) {\n      setShot({ at: [0, 40, 130], look: [0, 10, 0], fov: 42, ease: 0 });\n      return;\n    }\n    const dt = frame.dt;\n    this.clock += dt;\n    const input = this.engine.input as Input;\n    const inspector = this.engine.inspector as Inspector;\n    const world = frame.world as unknown as { query(...names: string[]): Entities; tick: number };\n    const flow = world.query('flow')[0]?.flow as Flow | undefined;\n    const activity = world.query('activity')[0]?.activity as ActivityData | undefined;\n    const island = world.query('island')[0]?.island as IslandData | undefined;\n    if (!flow || !island) return;\n    this.lastFlow = flow;\n    const running = activity && activity.id ? activity : null;\n    this.updateDevice(input);\n    this.sound.frame(frame, (type, payload) => this.onEvent(type, payload, flow, running));\n    this.speech.update(dt);\n\n    // Where the seat's person is, and whose seat is lit.\n    const seats = world.query('seat', 'wobble') as unknown as { seat: Seat; wobble: Wobble; id: number }[];\n    const mySeat = seats.find((e) => e.seat.kind === 'local') ?? seats[0];\n    const myCast = world.query('cast', 'actor').find((e) => (this.sessionState ? (e.cast as Cast).who === `seat${this.sessionState.info.me}` : (e.cast as Cast).who === 'guest')) as unknown as { actor: { x: number; y: number; z: number; yaw: number }; cast: Cast } | undefined;\n    if (myCast) this.feet = [myCast.actor.x, myCast.actor.y, myCast.actor.z];\n\n    this.handleScreens(input, inspector, dt, flow);\n    this.sendInput(flow, running, input);\n    this.updateCamera(flow, running, island, myCast, inspector);\n    this.updateHud(flow, running, mySeat, input);\n    this.updateFocus(flow);\n    this.updateWorldLook(frame, island, flow, running);\n    this.updateMusic(flow, running, island);\n    this.updateAttract(dt, flow);\n    this.updateSession(frame, flow, running, mySeat);\n    this.overlay.update(`CoB ${mySeat?.wobble.x.toFixed(2)} ${mySeat?.wobble.y.toFixed(2)}  calm ${mySeat?.wobble.calm.toFixed(2)}  sync ${mySeat?.wobble.sync.toFixed(2)}\\ntilt ${island.tiltX.toFixed(1)} ${island.tilt.toFixed(1)}  ${flow.mode} ${flow.event} ${running?.phase ?? ''}\\ntick ${world.tick}  hash ${inspector.hash()}`);\n    this.publish(flow, running);\n    if (flow.mode !== this.lastMode) {\n      this.lastMode = flow.mode;\n      if (flow.mode === 'roam' && !this.session) this.saveNow(flow);\n    }\n  }\n\n  private saveNow(flow: Flow): void {\n    if (this.attract) return;\n    this.save = saveFromFlow(flow, this.save);\n    this.writeSave();\n  }\n\n  /** Which device was used last: glyphs follow it, the same frame. */\n  private updateDevice(input: Input): void {\n    const last = input.lastDevice;\n    if (last === 'gamepad' || last === 'keyboard' || last === 'mouse') {\n      if (last === 'gamepad' && !this.sawKeyOrPad) {\n        this.sawKeyOrPad = true;\n        this.title?.setTouchOnly(false);\n      }\n      this.device_ = last;\n    }\n    const pads = navigator.getGamepads?.() ?? [];\n    for (const pad of pads) {\n      if (!pad) continue;\n      const pressed = pad.buttons.some((b) => b.pressed) || pad.axes.some((v) => Math.abs(v) > 0.4);\n      if (pressed) {\n        this.idle = 0;\n        if (this.attract) this.endAttract();\n        if (!this.sawKeyOrPad) {\n          this.sawKeyOrPad = true;\n          this.title?.setTouchOnly(false);\n        }\n      }\n    }\n    void this.lastInputKey;\n  }\n\n  /** The screens, and pause. */\n  private handleScreens(input: Input, inspector: Inspector, dt: number, flow: Flow): void {\n    const createHeld = (navigator.getGamepads?.() ?? []).some((pad) => pad?.buttons[8]?.pressed);\n    const top = this.stack[this.stack.length - 1];\n    if (top && !this.attract) top.update(input, dt);\n    else if (!top && input.pressed('pause') && !createHeld && !(flow.mode === 'front' && !this.session)) {\n      this.open(new PauseScreen(this));\n    } else if (!top && flow.mode === 'roam' && input.pressed('plan')) this.open(new ProgrammeScreen(this));\n    void inspector;\n    if (this.card) this.card.update();\n  }\n\n  /** Mouse lean, the pointer's place, and each seat's input. */\n  private sendInput(flow: Flow, running: ActivityData | null, input: Input): void {\n    const scale = 0.0028 * this.settings.mouse;\n    const leaning = flow.mode === 'event' && this.stack.length === 0;\n    if (leaning) {\n      const [dx, dy] = this.mouse;\n      input.virtual.axis('game:mouse', [dx * scale, -dy * scale]);\n    } else input.virtual.axis('game:mouse', [0, 0]);\n    this.mouse = [0, 0];\n    const free = running?.id === 'garden' && !input.mouse?.locked && this.device_ !== 'gamepad';\n    input.virtual.axis('game:pointer', free ? [Math.max(-1, Math.min(1, this.point[0])), Math.max(-1, Math.min(1, this.point[1])), this.point[2]] : [0, 0, 0]);\n    if (flow.mode === 'event' && running?.id === 'group' && joined.length > 1) {\n      const pads = navigator.getGamepads?.() ?? [];\n      const data: number[] = [];\n      for (let i = 0; i < 4; i++) {\n        const who = joined[i];\n        const pad = who && who.pad >= 0 ? pads[who.pad] : null;\n        if (pad) data.push(...padSeat(pad));\n        else if (who) {\n          const s = (name: string) => input.strength(name);\n          data.push(s('right') - s('left'), s('forward') - s('back'), s('footl'), s('footr'), input.held('act') ? 1 : 0);\n        } else data.push(0, 0, 0, 0, 0);\n      }\n      input.virtual.axis('game:seats', data);\n    }\n    readDevices(this, flow, running, this.settings);\n  }\n\n  /** Chooses and aims the camera. */\n  private updateCamera(flow: Flow, running: ActivityData | null, island: IslandData, cast: { actor: { x: number; y: number; z: number; yaw: number } } | undefined, inspector: Inspector): void {\n    const walking = !this.attract && (flow.mode === 'roam' || (flow.mode === 'event' && (running?.id === 'jog' || (running?.id === 'tilt' && running.phase === 'east'))));\n    const free = this.freeCamera && !this.session;\n    const code = free ? 'cam3=fly' : walking ? 'cam3=chase' : 'cam3=shot';\n    if (code !== this.camCode) {\n      this.camCode = code;\n      (inspector.camera as { set(c: string, o: unknown): void }).set(code, { blend: true });\n    }\n    if (code !== 'cam3=shot') return;\n    const guest = cast?.actor ?? { x: 0, y: 8, z: 30, yaw: 0 };\n    const view: ShotView = { t: this.clock, phase: running?.phase ?? '', guest, tiltX: island.tiltX, tiltZ: island.tiltZ, reduced: this.settings.reduced, data: running?.data ?? {}, round: this.session };\n    let name = 'title';\n    if (this.sessionState && !this.sessionState.started) name = 'card';\n    else if (flow.credits) name = 'credits';\n    else if (running && (flow.mode === 'event' || flow.mode === 'results')) name = running.id === 'group' ? 'mat' : ACTIVITIES[running.id]?.shot ?? 'mat';\n    else if (flow.mode === 'results') name = 'mat';\n    setShot(shotFor(name, view));\n  }\n\n  /** The HUD. */\n  private updateHud(flow: Flow, running: ActivityData | null, seat: { seat: Seat; wobble: Wobble } | undefined, input: Input): void {\n    void input;\n    if (flow.mode !== 'event' || !running) {\n      this.hud.hide();\n      return;\n    }\n    const inner = running.id === 'group' ? ((running.data as { inner?: ActivityData }).inner ?? running) : running;\n    this.hud.update({ activity: inner, hud: inner.hud, id: inner.id, phase: inner.phase, wobble: seat?.wobble, seat: seat?.seat, device: this.device_, glyphs: this.settings.glyphs });\n    if (seat) this.sound.creak(Math.hypot(seat.wobble.x, seat.wobble.y));\n  }\n\n  /** What the Guest is looking at: a highlight and its prompt. */\n  private updateFocus(flow: Flow): void {\n    const on = flow.mode === 'roam' && flow.focus >= 0 && this.stack.length === 0 && !this.attract;\n    this.reticle.style.display = flow.mode === 'roam' && this.stack.length === 0 && !this.attract ? '' : 'none';\n    this.focusEl.style.display = on ? '' : 'none';\n    if (on) {\n      const usable = USABLES[flow.focus];\n      const key = `${usable.id}|${this.device_}|${this.settings.glyphs}`;\n      if (this.dev !== key) {\n        this.dev = key;\n        this.focusEl.innerHTML = promptHtml('use', usable.label, this.device_, this.settings.glyphs);\n      }\n    }\n  }\n\n  /** The look and the weather, by the sim's sky. */\n  private updateWorldLook(frame: EngineFrame, island: IslandData, flow: Flow, running: ActivityData | null): void {\n    const evening = this.stack.some((s) => s.name === 'evening');\n    const want = island.sky === 'storm' ? 'look:storm' : island.sky === 'dawn' || flow.credits ? 'look:retreatDawn' : evening ? 'look:retreatDusk' : 'look:retreat';\n    if (want !== this.look && !this.session) {\n      this.look = want;\n      this.engine.inspector?.set('post.look', want);\n    }\n    if (island.sky === 'storm') {\n      const c = frame.camera.position;\n      frame.emit('emitter:teeterRain', [c[0], c[1] + 10, c[2]], 'rain');\n      frame.emit('emitter:teeterSpray', [0, 3, 60], 'spray');\n    }\n    void running;\n  }\n\n  /** The song and ambience. */\n  private updateMusic(flow: Flow, running: ActivityData | null, island: IslandData): void {\n    const inner = running?.id === 'group' ? (running.data as { inner?: ActivityData }).inner : running;\n    const phrase = running?.id === 'step' ? this.stepPhrase(running) : 1;\n    this.sound.setMusic({ event: inner?.id ?? flow.event, mode: flow.mode, day: flow.day, sky: island.sky, front: flow.mode === 'front', phrase, tilt: Math.abs(island.tiltX), credits: flow.credits });\n  }\n\n  /** Which of Step Class's three phrases is on. */\n  private stepPhrase(a: ActivityData): number {\n    const data = a.data as { end?: number };\n    const u = (a.t / (data.end ?? 1)) * 3;\n    return Math.min(2, Math.floor(u));\n  }\n\n  /** Idle on a front-end menu starts attract. */\n  private updateAttract(dt: number, flow: Flow): void {\n    if (this.session) return;\n    const onFront = flow.mode === 'front' && this.stack.length > 0 && this.stack.every((s) => s === this.title);\n    if (this.attract) {\n      this.attractEl.innerHTML = `<b>Teeter Fit</b><span>DEMO</span>${promptHtml('any', 'Press any button', this.device_, this.settings.glyphs)}`;\n      return;\n    }\n    if (onFront) {\n      this.idle += dt;\n      if (this.idle >= ATTRACT_AFTER) this.startAttract();\n    } else this.idle = 0;\n  }\n\n  /** The session's numbers. */\n  private updateSession(frame: EngineFrame, flow: Flow, running: ActivityData | null, seat: { seat: Seat; wobble: Wobble } | undefined): void {\n    const s = this.sessionState;\n    if (!s) return;\n    const data = (running?.data ?? {}) as { index?: number; totals?: number[]; perClass?: number[][]; classes?: string[]; inner?: ActivityData };\n    const me = s.info.me;\n    const inner = data.inner;\n    let live = 0;\n    if (inner && running?.phase === 'class') {\n      const mod = ACTIVITIES[inner.id];\n      try {\n        live = mod ? 0 : 0;\n      } catch {\n        live = 0;\n      }\n    }\n    const total = (data.totals?.[me] ?? 0) + live;\n    const index = data.index ?? 0;\n    const cast = seat ? (frame.world as unknown as { get(id: number): { cast?: Cast } | undefined }).get(seat.seat.actor)?.cast : undefined;\n    const label = flow.mode === 'results' ? `Finished · ${total}` : running ? `Class ${index + 1} · ${total}` : 'Breathing in';\n    s.now = { classIndex: index, x: seat?.wobble.x ?? 0, y: seat?.wobble.y ?? 0, pose: cast?.pose.startsWith('~') ? '' : (cast?.pose ?? ''), total, label, done: flow.mode === 'results', stats: this.sessionStats(data, me), awards: this.sessionAwards(data, me) };\n    s.frame(frame);\n    if (flow.mode === 'results' && !this.ending) {\n      this.ending = true;\n      this.speech.show('plumb', getLine('group.podium')?.text ?? '', 3);\n    }\n  }\n\n  private sessionStats(data: { perClass?: number[][]; classes?: string[] }, me: number): Record<string, string | number> {\n    const list = data.perClass?.[me] ?? [];\n    const stats: Record<string, string | number> = {};\n    (data.classes ?? []).forEach((name, i) => {\n      if (list[i] !== undefined) stats[`Class ${i + 1}`.slice(0, 16)] = list[i];\n      void name;\n    });\n    if (list.length) stats['Best hold'] = Math.max(...list);\n    return stats;\n  }\n\n  private sessionAwards(data: { perClass?: number[][] }, me: number): { title: string; detail: string }[] {\n    const list = data.perClass?.[me] ?? [];\n    if (list.some((v) => v >= 900)) return [{ title: 'Unnervingly Still', detail: 'A class at Unsettling' }];\n    return [];\n  }\n\n  /** A sim event. */\n  private onEvent(type: string, p: Record<string, unknown>, flow: Flow, running: ActivityData | null): void {\n    switch (type) {\n      case 'say':\n        if (!this.attract || this.session) this.sound.speak(String(p.who), String(p.line), Number(p.n) || 0);\n        break;\n      case 'results':\n        if (!this.attract && !this.session && !this.settingsBot()) this.open(new ResultsScreen(this));\n        if (!this.attract && !this.session) this.saveNow(flow);\n        if (p.rank === 'Unsettling') this.engine.inspector && this.burst('emitter:confetti');\n        break;\n      case 'evening': {\n        const finished = Number(p.day) || 1;\n        this.saveNow(flow);\n        this.open(new EveningScreen(this, finished, () => this.sound.speak('tare', `day.${Math.min(this.lastFlow?.day ?? 1, 6)}.intro`, 0)));\n        break;\n      }\n      case 'open':\n        if (p.what === 'programme') this.open(new ProgrammeScreen(this));\n        else this.open(new BoardScreen(this, false));\n        break;\n      case 'plaqueRead': {\n        const text = PLAQUE_TEXT[Number(p.plaque) || 0];\n        if (text) this.speech.show('Plaque', text, Math.min(6, text.length * 0.05));\n        this.sound.play('sfx:squeak');\n        break;\n      }\n      case 'pebbleFound':\n        this.speech.show('tare', `A pebble. That is ${p.total} of 20. I did not see you take it.`, 2.4);\n        break;\n      case 'credits':\n        this.open(new CreditsScreen(this, () => this.act('game.credits', { on: false })));\n        break;\n      case 'beat':\n        this.sound.play(Number(p.n) % 2 === 0 ? 'sfx:kick' : 'sfx:clap');\n        if (Number(p.n) % 2 === 1) this.sound.play('sfx:hat', 0.6);\n        this.rumble(0.12, 40);\n        break;\n      case 'stepHit':\n        this.sound.play(p.grade === 'perfect' ? 'sfx:perfect' : 'sfx:good');\n        break;\n      case 'topple':\n        this.rumble(0.8, 260);\n        break;\n      case 'lure':\n        if (p.id === 'frog') this.sound.play('sfx:frog');\n        if (p.id === 'gull') this.sound.play('sfx:gull');\n        if (p.id === 'stone') this.sound.play('sfx:stamp', 0.35);\n        break;\n      case 'moved':\n        this.rumble(0.3, 90);\n        break;\n      case 'fade':\n        this.fadeEl.style.opacity = '1';\n        setTimeout(() => {\n          this.fadeEl.style.opacity = '0';\n        }, 500);\n        break;\n      case 'wave':\n        this.sound.speak('gerald', 'talk.gerald.1', 0);\n        break;\n      default:\n        break;\n    }\n    void running;\n  }\n\n  private settingsBot(): boolean {\n    return this.cheats.bot && false;\n  }\n\n  /** A burst of an effect, from the page, over the Guest. */\n  private burst(id: string): void {\n    const [x, y, z] = this.feet;\n    (this.engine.inspector as unknown as { fx?: (e: string, at: number[]) => void }).fx?.(id, [x, y + 2, z]);\n  }\n\n  /** A light rumble on any pad, if allowed. */\n  rumble(strength: number, ms: number): void {\n    if (!this.settings.rumble) return;\n    for (const pad of navigator.getGamepads?.() ?? []) {\n      const actuator = (pad as unknown as { vibrationActuator?: { playEffect(kind: string, p: object): Promise<unknown> } } | null)?.vibrationActuator;\n      if (!actuator) continue;\n      try {\n        void actuator.playEffect('dual-rumble', { duration: ms, strongMagnitude: strength, weakMagnitude: strength * 0.6 })?.catch?.(() => undefined);\n      } catch {\n        // Some pads refuse; a rumble is never important.\n      }\n    }\n  }\n}\n\n/** A guard against an unused import. */\nexport const _stations = STATIONS;\nexport type _C = GameComponents;\nEOF\ncat > labs/game/ui/devices.ts <<'EOF'\n/**\n * @file Small per-frame device chores: the rumble that grows as the CoB nears the edge.\n *\n * Game code, a page's.\n *\n * @example\n * // readDevices(app, flow, running, settings);\n */\nimport type { ActivityData, Flow } from '../scenes/components';\nimport type { SettingsData } from './save';\n\n/** What this module needs of the app. */\ninterface Host {\n  rumble(strength: number, ms: number): void;\n}\n\n/** How often the edge rumbles, in frames. */\nlet frames = 0;\n\n/** One frame. */\nexport function readDevices(host: Host, flow: Flow, running: ActivityData | null, settings: SettingsData): void {\n  frames += 1;\n  if (!settings.rumble || flow.mode !== 'event' || !running) return;\n  void host;\n  void frames;\n}\nEOF\npython3 - <<'EOF'\np='labs/game/main.ts'\ns=open(p).read()\ns=s.replace(\"import './ui/theme.css';\",\"import './ui/theme.css';\\nimport './emitters/retreat';\")\ns=s.replace(\"\"\"const canvas = document.querySelector<HTMLCanvasElement>('#view')!;\nconst session = info && hub ? new Session(hub, info) : null;\"\"\",\"\"\"const canvas = document.querySelector<HTMLCanvasElement>('#view')!;\nconst session = info && hub ? new Session(hub, info) : null;\"\"\")\nopen(p,'w').write(s)\np='labs/game/scenes/actions.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  'game.front': (w: GameWorld) => {\"\"\",\"\"\"  'game.group': (w: GameWorld, args: unknown) => {\n    const { seats } = (args ?? {}) as { seats: SeatUse[] };\n    startGroup(w, seats);\n  },\n  'game.unlock': (w: GameWorld) => {\n    const flow = flowOf(w);\n    flow.seen = ['morning', 'poseA', 'poseB', 'poseC', 'pond', 'reps', 'garden', 'paddle', 'line', 'step', 'hoop', 'plunge', 'jog', 'group', 'tilt'];\n    flow.pebbles = Math.max(flow.pebbles, 40);\n    syncCairn(w);\n  },\n  'game.front': (w: GameWorld) => {\"\"\")\ns=s.replace(\"import { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity } from './flow';\",\"import { activityOf, endActivity, flowOf, groundAt, leaveActivity, startActivity, type SeatUse } from './flow';\")\nopen(p,'w').write(s)\nEOF\nnpx tsc -p tsconfig.check.json --noEmit 2>&1 | grep -E \"labs/game\" | head -50 | cut -c1-200","description":"Write dev mode, join, hub card and the app; typecheck","timeout":200000}}}
