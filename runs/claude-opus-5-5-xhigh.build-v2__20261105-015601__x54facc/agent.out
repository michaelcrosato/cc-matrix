{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjZN2jW1RBEAHEQDe9VF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DEzEisjY1kqGh2nXoQ1iWc","name":"Bash","input":{"command":"grep -n \"export function propCentre\" -A8 engine/world/props/*.ts | cut -c1-150 | head -14; grep -n \"export function fromCamera\" -A8 engine/input/intents.ts | cut -c1-120; cat >> labs/game/scenes/events/kit.ts <<'EOF'\n\n/** Moves a body-less prop: its base at `x, y, z`, turned by quaternion `q` (or a yaw). */\nexport function moveProp(w: GameWorld, id: number, x: number, y: number, z: number, turn: number | number[] = 0): void {\n  const e = w.get(id);\n  if (!e?.sceneProp) return;\n  const centre = propCentre(getProp(e.sceneProp.prop));\n  e.sceneProp.x = x;\n  e.sceneProp.y = y + centre;\n  e.sceneProp.z = z;\n  e.sceneProp.q = typeof turn === 'number' ? [0, Math.sin(turn / 2), 0, Math.cos(turn / 2)] : [...turn];\n}\n\n/** Spawns a floor shape for this activity. Its telegraph '' draws nothing. */\nexport function floorShape(c: Ctx, telegraph: string, x: number, y: number, z: number, size = 1, yaw = 0): number {\n  return entityFor(c, { matRing: { telegraph, position: [x, y, z], yaw, u: 1, size, owner: -1 } });\n}\n\n/** The world direction a lean means from a camera's heading. */\nexport function worldFromLean(lx: number, ly: number, cam: number): [number, number] {\n  const [x, z] = fromCamera(cam, [lx, ly]);\n  return [x, z];\n}\n\n/** The lean that means a world direction, at heading 0 (the bots steer this way). */\nexport function leanForWorld(wx: number, wz: number): [number, number] {\n  const [rx, rz] = fromCamera(0, [1, 0]);\n  const [fx, fz] = fromCamera(0, [0, 1]);\n  return [wx * rx + wz * rz, wx * fx + wz * fz];\n}\n\n/** Whether this seat is being played by a bot just now. */\nexport function isBot(c: Ctx, index: number): boolean {\n  const e = c.seats.find((s) => s.seat.index === index);\n  if (!e) return false;\n  return e.seat.kind === 'cpu' || c.flow.attract || c.w.settings.get<boolean>('game.auto');\n}\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/kit.ts'\ns=open(p).read()\ns=s.replace(\"import { removeActor, removeProp, spawnProp, type PropPlacement } from '../../../../engine/sim-api';\",\"import { fromCamera, getProp, propCentre, removeActor, removeProp, spawnProp, type PropPlacement } from '../../../../engine/sim-api';\")\nopen(p,'w').write(s)\np='labs/game/props/stations.ts'\ns=open(p).read()\ns=s.replace(\"\"\"defineProp('prop:lounger', {\n  description: 'A sun lounger. It slides when the island does.',\n  parts: [\n    box('bed', 0.7, 0.08, 1.7, 'material:clinical', [0, 0.28, 0]),\n    box('rest', 0.7, 0.08, 0.6, 'material:coral', [0, 0.4, -0.9], [0.5, 0, 0]),\n    box('frame', 0.6, 0.28, 1.4, 'material:slate', [0, 0, 0]),\n  ],\n  body: { type: 'dynamic', shape: 'box', size: [0.7, 0.4, 1.9], density: 40, friction: 0.25 },\n} as never);\"\"\",\"\"\"free('prop:lounger', 'A sun lounger. It slides when the island does.', [\n  box('bed', 0.7, 0.08, 1.7, 'material:clinical', [0, 0.28, 0]),\n  box('rest', 0.7, 0.08, 0.6, 'material:coral', [0, 0.4, -0.9], [0.5, 0, 0]),\n  box('frame', 0.6, 0.28, 1.4, 'material:slate', [0, 0, 0]),\n]);\"\"\")\nopen(p,'w').write(s)\np='labs/game/cast/roster.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  playClip(w, e.id, `RETREAT/${pose}`, { speed: 0, hold: true, walk: true, loop: false, fade: 0.2, out: 0.25 });\"\"\",\"\"\"  playClip(w, e.id, `RETREAT/${pose}`, { speed: 0, hold: true, walk: true, loop: LOOPED.has(pose), fade: 0.2, out: 0.25 });\"\"\")\ns=s.replace(\"\"\"/** The clip layer of an entity, as data. */\"\"\",\"\"\"/** Strips that run round in a ring, scrubbed by an angle or a clock. */\nconst LOOPED = new Set(['HipCircle', 'Paddling', 'Crank']);\n\n/** The clip layer of an entity, as data. */\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/events/reps.ts <<'EOF'\n/**\n * @file Reps Hall (PLAN.md section 6): the signature \"thumb is the exercise\" activity. A band moves at the tempo; stick\n * depth moves your marker and scrubs the body. Stay within 0.2 of the band to bank the rep. Gerald does two for each of\n * yours. Near the finish the counter cheats.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'reps');\n */\nimport { holdAt, type Player } from '../bot/players';\nimport { ANNEX_OFFSETS } from '../data/stations';\nimport { bothFeet } from '../wobble';\nimport { after, castOf, enter, say, standSeats, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** The exercises: adding a row adds one. */\nconst EXERCISES = [\n  { id: 'knees', name: 'Deep Knees', count: 10, clip: 'DeepKnee', axis: 'y', feet: false },\n  { id: 'pushups', name: 'Polite Push-Ups', count: 8, clip: 'PushUp', axis: 'y', feet: true },\n  { id: 'lunges', name: 'Side Lunges', count: 10, clip: 'LungeR', axis: 'x', feet: false },\n] as const;\n\n/** Full depth, on the balance disc. */\nconst DEPTH = 0.68;\n/** How close the marker must be to the band. */\nconst NEAR = 0.24;\n/** A rep banks at this share of its time in the band. */\nconst BANKS = 0.45;\n\n/** The hall's state. */\ninterface RepsData {\n  ex: number;\n  rep: number;\n  p: number;\n  inside: number;\n  total: number;\n  accs: number[];\n  side: number;\n  band: number;\n  marker: number;\n}\n\n/** The band at progress `p`: down and back up, easing at each end. */\nconst bandAt = (p: number): number => Math.pow(Math.sin(Math.PI * p), 2);\n\n/** How fast the band goes on this rep: speeds up a little near the end of a set. */\nfunction repSteps(c: Ctx, d: RepsData): number {\n  const count = EXERCISES[d.ex].count;\n  const speed = 1 + (0.18 * d.rep) / count;\n  return Math.round((c.w.settings.get<number>('game.reps.tempo') * c.w.hz) / speed);\n}\n\n/** Reps Hall. */\nexport const reps: Activity = {\n  id: 'reps',\n  title: 'Reps Hall',\n  station: 'annex',\n  map: 'actionMap:balance',\n  shot: 'reps',\n  wobble: true,\n  setup(c) {\n    const d: RepsData = { ex: 0, rep: 0, p: 0, inside: 0, total: 0, accs: [], side: 1, band: 0, marker: 0 };\n    c.a.data = d as unknown as Record<string, unknown>;\n    standSeats(c, ANNEX_OFFSETS, Math.PI);\n    const { x, z } = c.station;\n    const gerald = castOf(c.w, 'gerald');\n    if (gerald) Object.assign(gerald.cast, { hold: true, x: x + ANNEX_OFFSETS[1][0], y: c.ground(x, z) + 0.15, z: z + ANNEX_OFFSETS[1][1], yaw: Math.PI });\n    const plumb = castOf(c.w, 'plumb');\n    if (plumb) Object.assign(plumb.cast, { hold: true, x: x + 3, y: c.ground(x, z) + 0.05, z: z - 2.5, yaw: 0, pose: 'Upright', poseT: 1 });\n    c.hud.disc = true;\n    c.hud.feet = true;\n    c.hud.title = EXERCISES[0].name;\n    enter(c, 'ready');\n    say(c, 'plumb', 'reps.start');\n  },\n  step(c) {\n    const d = c.a.data as unknown as RepsData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const ex = EXERCISES[d.ex];\n    const body = castOf(c.w, 'guest');\n    const gerald = castOf(c.w, 'gerald');\n    if (c.a.phase === 'ready') {\n      c.hud.show = { exercise: ex.id, rep: 0, of: ex.count, band: 0, marker: 0, side: 1 };\n      if (body) Object.assign(body.cast, { pose: ex.clip, poseT: 0, leanX: wob.x * 0.5, leanY: 0 });\n      if (after(c, 2.5)) {\n        say(c, 'plumb', `reps.${ex.id}`);\n        enter(c, 'rep');\n      }\n      return;\n    }\n    if (c.a.phase === 'switch') {\n      if (body) Object.assign(body.cast, { poseT: Math.max(0, body.cast.poseT - c.w.dt * 2) });\n      if (after(c, 2)) enter(c, 'ready');\n      return;\n    }\n    // A rep.\n    const total = repSteps(c, d);\n    d.p += 1 / total;\n    d.band = bandAt(Math.min(1, d.p));\n    wob.swayMul = 0.7 + 0.5 * (d.rep / ex.count);\n    wob.usesBreath = false;\n    const raw = ex.axis === 'y' ? -wob.y : wob.x * d.side;\n    d.marker = Math.max(0, Math.min(1, raw / DEPTH));\n    const feetOk = !ex.feet || bothFeet(seat);\n    d.total += 1;\n    if (Math.abs(d.marker - d.band) <= NEAR && feetOk) d.inside += 1;\n    if (body) {\n      const clip = ex.axis === 'x' ? (d.side > 0 ? 'LungeR' : 'LungeL') : ex.clip;\n      const t = ex.feet ? (feetOk ? 0.4 + 0.6 * d.marker : 0.25) : d.marker;\n      Object.assign(body.cast, { pose: clip, poseT: t, leanX: ex.axis === 'x' ? 0 : wob.x * 0.4, leanY: 0 });\n    }\n    if (gerald) Object.assign(gerald.cast, { pose: ex.axis === 'x' ? (d.side > 0 ? 'LungeL' : 'LungeR') : ex.clip, poseT: (ex.feet ? 0.4 + 0.6 : 1) * bandAt((d.p * 2) % 1) });\n    if (d.p >= 1) {\n      const acc = d.total > 0 ? d.inside / d.total : 0;\n      d.accs.push(acc);\n      if (acc >= BANKS) d.rep += 1;\n      else d.rep += 0;\n      c.w.emit('rep', { banked: acc >= BANKS, rep: d.rep, acc });\n      d.p = 0;\n      d.inside = d.total = 0;\n      if (ex.axis === 'x') d.side = -d.side;\n      const attempts = d.accs.length;\n      if (d.rep === ex.count - 2 && acc >= BANKS) say(c, 'plumb', 'reps.lying');\n      if (d.rep >= ex.count || c.a.pt > steps(c, ex.count * 5)) {\n        d.ex += 1;\n        d.rep = 0;\n        if (d.ex >= EXERCISES.length) c.a.done = true;\n        else {\n          enter(c, 'switch');\n          c.hud.title = EXERCISES[d.ex].name;\n        }\n      }\n      void attempts;\n    }\n    // The counter cheats near the finish: \"9 of 10\" becomes \"10 of 11\".\n    const cheat = d.rep >= ex.count - 1 ? 1 : 0;\n    c.hud.show = { exercise: ex.id, rep: d.rep + cheat, of: ex.count + cheat, band: d.band, marker: d.marker, side: d.side, feet: ex.feet, axis: ex.axis };\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as RepsData;\n    const { seat, wobble } = e;\n    const ex = EXERCISES[Math.min(d.ex, EXERCISES.length - 1)];\n    seat.act = false;\n    seat.fl = seat.fr = ex.feet && player.acts && c.a.phase === 'rep' ? 1 : 0;\n    if (c.a.phase !== 'rep') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      return;\n    }\n    // People look ahead a little: a thumb follows the rhythm, not the moment.\n    const total = Math.max(1, repSteps(c, d));\n    const ahead = bandAt(Math.min(1, d.p + (player.delay + 8) / total));\n    const goal = ahead * DEPTH;\n    if (ex.axis === 'y') holdAt(c.w, seat, wobble, 0, -goal, player);\n    else holdAt(c.w, seat, wobble, goal * d.side, 0, player);\n  },\n  score(c) {\n    const d = c.a.data as unknown as RepsData;\n    if (d.accs.length === 0) return 0;\n    return (1000 * d.accs.reduce((a, b) => a + b, 0)) / d.accs.length;\n  },\n};\nEOF\ncat > labs/game/scenes/data/charts.ts <<'EOF'\n/**\n * @file Step Class's charts (PLAN.md section 6): strings, one token per half beat: L, R, B (both, a jump), < and > (side\n * steps: lean plus foot), . rest, | a bar line. A new chart is a new string.\n *\n * Game code, sim-side data.\n *\n * @example\n * parseChart('L . R . | B . . .').length; // 3\n */\n\n/** The three phrases of Step Class, each at its tempo. */\nexport const PHRASES: readonly { bpm: number; chart: string }[] = [\n  {\n    bpm: 104,\n    chart:\n      'L . R . L . R . | L . R . L . R . | L . R . L . R . | B . . . B . . . | L . R . L . R . | L L R . B . . . | R . L . R . L . | R R L . B . . . | L . R . < . . . | R . L . > . . . | L . R . L . R . | B . . . . . . .',\n  },\n  {\n    bpm: 112,\n    chart:\n      'L . R . < . > . | L . R . < . > . | L L R . L L R . | B . B . B . . . | R . L . > . < . | R . L . > . < . | R R L . R R L . | B . B . B . . . | L R L . R L R . | < . > . < . > . | L R L . R L R . | B . . . B . . .',\n  },\n  {\n    bpm: 120,\n    chart:\n      'L . R . L . R . | L R L R B . . . | < . > . < . > . | L R L R B . . . | R . L . R . L . | R L R L B . . . | > . < . > . < . | R L R L B . . . | L L R R L L R R | B . B . B . B . | L . < . R . > . | L . < . R . > . | L R L R L R L R | B . . . B . . . | < . > . < . > . | B . . . . . . .',\n  },\n];\n\n/** The one phrase of a Round's short class. */\nexport const SHORT_PHRASE: { bpm: number; chart: string } = {\n  bpm: 112,\n  chart:\n    'L . R . L . R . | L . R . L . R . | L . R . < . > . | B . . . B . . . | L . R . L . R . | L L R . B . . . | R . L . > . < . | R R L . B . . . | L . R . L . R . | < . > . < . > . | L R L R B . . . | R . L . R . L . | L L R . L L R . | B . B . B . . . | R L R L R . L . | < . > . < . > . | L . R . L . R . | L R L R B . . . | L . R . L . R . | B . . . . . . .',\n};\n\n/** A note: its slot (half beats from the phrase's start) and what it asks. */\nexport interface ChartNote {\n  slot: number;\n  kind: 'L' | 'R' | 'B' | '<' | '>';\n}\n\n/** The notes of a chart. */\nexport function parseChart(chart: string): ChartNote[] {\n  const notes: ChartNote[] = [];\n  let slot = 0;\n  for (const token of chart.split(/\\s+/)) {\n    if (token === '|' || token === '') continue;\n    if (token !== '.') notes.push({ slot, kind: token as ChartNote['kind'] });\n    slot += 1;\n  }\n  return notes;\n}\n\n/** The slots a chart takes. */\nexport const slotsOf = (chart: string): number => chart.split(/\\s+/).filter((t) => t !== '|' && t !== '').length;\nEOF\ncat > labs/game/scenes/events/step.ts <<'EOF'\n/**\n * @file Step Class (PLAN.md section 6): rhythm on a step platform. Footprints scroll to a hit line on the HUD, floor tiles\n * light in the world. Timing is in sim steps, never audio time. Every seat plays; the guests behind you follow your\n * combo: lose it and they fall out of time, politely.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'step');\n */\nimport { timingError, type Player } from '../bot/players';\nimport { parseChart, PHRASES, SHORT_PHRASE, slotsOf } from '../data/charts';\nimport { ANNEX_OFFSETS, MAT_OFFSETS } from '../data/stations';\nimport { enter, floorShape, propFor, say, standSeats, steps } from './kit';\nimport type { Activity, Ctx, SeatEntity } from './types';\n\n/** A note on the sim's clock. */\ninterface TimedNote {\n  at: number;\n  kind: 'L' | 'R' | 'B' | '<' | '>';\n  hit: boolean[];\n}\n\n/** One seat's numbers. */\ninterface StepSeat {\n  next: number;\n  combo: number;\n  best: number;\n  value: number;\n  perfects: number;\n  goods: number;\n  misses: number;\n  last: string;\n  lastT: number;\n  foot: 'L' | 'R';\n  poseT: number;\n}\n\n/** The class's state. */\ninterface StepData {\n  notes: TimedNote[];\n  beats: number[];\n  nextBeat: number;\n  end: number;\n  seats: StepSeat[];\n  tiles: number[];\n  litL: number;\n  litR: number;\n  max: number;\n  lead: number;\n}\n\n/** Gives the multiplier for a combo: up to 1.5. */\nconst multiplier = (combo: number): number => 1 + 0.5 * Math.min(1, combo / 16);\n\n/** Lays the phrases out on the clock. */\nfunction layOut(c: Ctx, lead: number): { notes: TimedNote[]; beats: number[]; end: number } {\n  const scale = c.w.settings.get<number>('game.step.bpm');\n  const phrases = c.a.short ? [SHORT_PHRASE] : PHRASES;\n  const notes: TimedNote[] = [];\n  const beats: number[] = [];\n  let start = lead;\n  for (const phrase of phrases) {\n    const half = (c.w.hz * 60) / (phrase.bpm * scale * 2);\n    for (const note of parseChart(phrase.chart)) notes.push({ at: Math.round(start + note.slot * half), kind: note.kind, hit: [false, false, false, false] });\n    const slots = slotsOf(phrase.chart);\n    for (let slot = 0; slot < slots; slot += 2) beats.push(Math.round(start + slot * half));\n    start += Math.round(slots * half) + Math.round(half * 4);\n  }\n  return { notes, beats, end: start };\n}\n\n/** Whether a press fits a note's kind. */\nfunction fits(kind: TimedNote['kind'], e: SeatEntity): boolean {\n  const lean = e.seat.lx + e.wobble.mx;\n  const { pfl, pfr, fl, fr } = e.seat;\n  if (kind === 'L') return pfl;\n  if (kind === 'R') return pfr;\n  if (kind === 'B') return (pfl && fr >= 0.5) || (pfr && fl >= 0.5);\n  if (kind === '<') return pfl && lean < -0.35;\n  return pfr && lean > 0.35;\n}\n\n/** One seat's step: its presses against the notes in its windows; its misses. */\nfunction stepSeat(c: Ctx, d: StepData, e: SeatEntity): void {\n  const s = d.seats[e.seat.index];\n  const { w, a } = c;\n  const now = a.t;\n  const good = w.settings.get<number>('game.step.good');\n  const perfect = w.settings.get<number>('game.step.perfect');\n  const i0 = e.seat.index;\n  while (s.next < d.notes.length && !d.notes[s.next].hit[i0] && d.notes[s.next].at + good < now) {\n    s.combo = 0;\n    s.misses += 1;\n    s.next += 1;\n    if (i0 === c.seats[0].seat.index) w.emit('stepMiss', { seat: i0 });\n  }\n  if (e.seat.pfl || e.seat.pfr) {\n    for (let n = s.next; n < d.notes.length; n++) {\n      const note = d.notes[n];\n      if (note.at > now + good) break;\n      if (note.hit[i0] || !fits(note.kind, e)) continue;\n      const off = Math.abs(note.at - now);\n      const grade = off <= perfect ? 'perfect' : 'good';\n      note.hit[i0] = true;\n      s.combo += 1;\n      s.best = Math.max(s.best, s.combo);\n      s.value += (grade === 'perfect' ? 1 : 0.6) * multiplier(s.combo);\n      if (grade === 'perfect') s.perfects += 1;\n      else s.goods += 1;\n      s.last = grade;\n      s.lastT = now;\n      s.foot = note.kind === 'R' || note.kind === '>' ? 'R' : 'L';\n      s.poseT = 1;\n      if (n === s.next) s.next += 1;\n      if (i0 === c.seats[0].seat.index) w.emit('stepHit', { seat: i0, grade, kind: note.kind, combo: s.combo });\n      break;\n    }\n    while (s.next < d.notes.length && d.notes[s.next].hit[i0]) s.next += 1;\n  }\n  s.poseT = Math.max(0, s.poseT - w.dt * 5);\n  const cast = w.get(e.seat.actor)?.cast;\n  if (cast) {\n    const kind = s.foot === 'R' ? 'StepUpR' : 'StepUpL';\n    cast.pose = kind;\n    cast.poseT = s.poseT;\n    cast.leanX = e.wobble.x * 0.8;\n    cast.leanY = 0;\n  }\n}\n\n/** Step Class. */\nexport const step: Activity = {\n  id: 'step',\n  title: 'Step Class',\n  station: 'annex',\n  map: 'actionMap:balance',\n  shot: 'step',\n  wobble: true,\n  setup(c) {\n    const lead = steps(c, c.a.short ? 6 : 4);\n    const { notes, beats, end } = layOut(c, lead);\n    const d: StepData = {\n      notes,\n      beats,\n      end,\n      nextBeat: 0,\n      seats: [0, 1, 2, 3].map(() => ({ next: 0, combo: 0, best: 0, value: 0, perfects: 0, goods: 0, misses: 0, last: '', lastT: -999, foot: 'L', poseT: 0 })),\n      tiles: [],\n      litL: 0,\n      litR: 0,\n      lead,\n      max: notes.reduce((sum, _n, i) => sum + multiplier(i + 1), 0),\n    };\n    c.a.data = d as unknown as Record<string, unknown>;\n    const offsets = c.round ? MAT_OFFSETS : ANNEX_OFFSETS;\n    standSeats(c, offsets, Math.PI, c.round ? 0.05 : 0.27);\n    for (const e of c.seats) {\n      e.wobble.swayMul = 0.25;\n      e.wobble.usesBreath = false;\n      const [ox, oz] = offsets[e.seat.index];\n      const [x, z] = [c.station.x + ox, c.station.z + oz];\n      if (!c.round) propFor(c, { prop: 'prop:stepBlock', at: [x, c.ground(x, z) + 0.1, z], yaw: 0 });\n      d.tiles.push(floorShape(c, '', x - 0.6, c.ground(x, z) + 0.16, z + 0.8), floorShape(c, '', x + 0.6, c.ground(x, z) + 0.16, z + 0.8));\n    }\n    c.hud.disc = false;\n    c.hud.feet = true;\n    c.hud.title = 'Step Class';\n    enter(c, 'play');\n    say(c, 'plumb', 'step.start');\n  },\n  step(c) {\n    const d = c.a.data as unknown as StepData;\n    const now = c.a.t;\n    while (d.nextBeat < d.beats.length && d.beats[d.nextBeat] <= now) {\n      c.w.emit('beat', { n: d.nextBeat, at: d.beats[d.nextBeat] });\n      d.nextBeat += 1;\n    }\n    for (const e of c.seats) stepSeat(c, d, e);\n    const me = d.seats[c.seats[0].seat.index];\n    // The tiles light in the world for the next note.\n    const upcoming = d.notes.find((n) => n.at >= now && n.at <= now + 10);\n    c.seats.forEach((_e, i) => {\n      const [tileL, tileR] = [d.tiles[i * 2], d.tiles[i * 2 + 1]];\n      const ml = c.w.get(tileL)?.matRing;\n      const mr = c.w.get(tileR)?.matRing;\n      const kind = upcoming?.kind ?? '';\n      if (ml) ml.telegraph = kind === 'L' || kind === '<' || kind === 'B' ? 'telegraph:tileL' : '';\n      if (mr) mr.telegraph = kind === 'R' || kind === '>' || kind === 'B' ? 'telegraph:tileR' : '';\n    });\n    // What the lanes need: the next few notes.\n    const soon = d.notes.filter((n) => n.at >= now - 12 && n.at <= now + 150).slice(0, 14);\n    c.hud.show = {\n      notes: soon.map((n) => [n.at - now, n.kind, n.hit[c.seats[0].seat.index] ? 1 : 0]),\n      combo: me.combo,\n      grade: now - me.lastT < 30 ? me.last : '',\n      value: me.value,\n      followers: Math.min(3, Math.floor(me.combo / 5)),\n    };\n    c.hud.meter = 1 - now / Math.max(1, d.end);\n    if (now >= d.end) c.a.done = true;\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as StepData;\n    const { seat } = e;\n    const mem = seat.mem as { note?: number; err?: number; holdL?: number; holdR?: number };\n    seat.act = false;\n    mem.note ??= 0;\n    mem.err ??= 0;\n    mem.holdL ??= 0;\n    mem.holdR ??= 0;\n    if (!player.acts) {\n      Object.assign(seat, { fl: 0, fr: 0, lx: 0, ly: 0 });\n      return;\n    }\n    const now = c.a.t;\n    const note = d.notes[mem.note];\n    seat.lx = 0;\n    seat.ly = 0;\n    if (note) {\n      if (note.kind === '<' && note.at - now < 14) seat.lx = -0.8;\n      if (note.kind === '>' && note.at - now < 14) seat.lx = 0.8;\n      if (now >= note.at + mem.err) {\n        if (note.kind === 'L' || note.kind === '<' || note.kind === 'B') mem.holdL = 5;\n        if (note.kind === 'R' || note.kind === '>' || note.kind === 'B') mem.holdR = 5;\n        mem.note += 1;\n        mem.err = timingError(c.w, seat, player);\n      }\n    }\n    seat.fl = mem.holdL > 0 ? 1 : 0;\n    seat.fr = mem.holdR > 0 ? 1 : 0;\n    mem.holdL -= 1;\n    mem.holdR -= 1;\n  },\n  score(c, index) {\n    const d = c.a.data as unknown as StepData;\n    return d.max > 0 ? (1000 * d.seats[index].value) / d.max : 0;\n  },\n};\nEOF\ncat > labs/game/scenes/events/line.ts <<'EOF'\n/**\n * @file The Line (PLAN.md section 6): a 40 m slackline across the lagoon with three flags. Alternate feet to step: each\n * step moves 0.75 m and kicks you sideways; the same foot twice is a stumble. Lean x fights it. Gusts come, telegraphed.\n * At 15 m the Gull lands on your arm until you flick it off. Falling is a large splash; Tare's boat takes you back to the\n * last flag. After 120 s the boat collects you.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'line');\n */\nimport { holdAt, type Player } from '../bot/players';\nimport { SEA_Y } from '../data/stations';\nimport { after, castOf, critterAway, critterGo, enter, moveProp, propFor, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** The line's length, m, its height over the water, its flags. */\nconst LENGTH = 40;\nconst HEIGHT = 3.2;\nconst FLAGS = [0, 13, 26];\nconst STEP = 0.75;\n/** Par time, s, and the time the line closes. */\nconst PAR = 50;\nconst CLOSES = 120;\n/** Where the Gull lands, m. */\nconst GULL_AT = 15;\n\n/** The line's state. */\ninterface LineData {\n  s: number;\n  x0: number;\n  z0: number;\n  last: string;\n  cool: number;\n  falls: number;\n  flag: number;\n  gustIn: number;\n  gustLeft: number;\n  gustDir: number;\n  warned: boolean;\n  gull: 'waiting' | 'on' | 'gone';\n  stickWas: number[];\n  boat: number;\n  time: number;\n  end: boolean;\n  walkT: number;\n}\n\n/** The Line. */\nexport const line: Activity = {\n  id: 'line',\n  title: 'The Line',\n  station: 'lagoon',\n  map: 'actionMap:balance',\n  shot: 'line',\n  wobble: true,\n  setup(c) {\n    const { x, z } = c.station;\n    const [x0, z0] = [x, z + 8];\n    const d: LineData = { s: 0, x0, z0, last: '', cool: 0, falls: 0, flag: 0, gustIn: steps(c, c.w.rng('line').range(4, 7)), gustLeft: 0, gustDir: 1, warned: false, gull: 'waiting', stickWas: [], boat: -1, time: 0, end: false, walkT: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    propFor(c, { prop: 'prop:slackPost', at: [x0, SEA_Y + HEIGHT - 1.2, z0 - 0.4], yaw: 0 });\n    propFor(c, { prop: 'prop:slackPost', at: [x0, SEA_Y + HEIGHT - 1.2, z0 + LENGTH + 0.4], yaw: 0 });\n    propFor(c, { prop: 'prop:slackLine', at: [x0, SEA_Y + HEIGHT, z0], yaw: 0 });\n    for (const flag of FLAGS) propFor(c, { prop: 'prop:lineFlag', at: [x0 + 0.4, SEA_Y + HEIGHT - 0.1, z0 + flag], yaw: 0 });\n    d.boat = propFor(c, { prop: 'prop:boat', at: [x0 + 5, SEA_Y, z0], yaw: 0 });\n    const guest = castOf(c.w, 'guest');\n    if (guest) Object.assign(guest.cast, { hold: true, x: x0, y: SEA_Y + HEIGHT, z: z0, yaw: 0, pose: 'LineWalk', poseT: 1 });\n    const tare = castOf(c.w, 'tare');\n    if (tare) Object.assign(tare.cast, { hold: true, x: x0 + 5, y: SEA_Y + 0.3, z: z0, yaw: -1.2 });\n    c.hud.disc = true;\n    c.hud.feet = true;\n    c.hud.title = 'The Line';\n    enter(c, 'walk');\n    say(c, 'tare', 'line.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as LineData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const guest = castOf(c.w, 'guest');\n    d.time += 1;\n    wob.usesBreath = false;\n    const cast = guest?.cast;\n    if (c.a.phase === 'fall') {\n      if (cast) {\n        cast.y = Math.max(SEA_Y - 0.8, cast.y - c.w.dt * 7);\n        cast.pose = 'LineFall';\n        cast.poseT = 1;\n        cast.leanX = 0;\n      }\n      if (c.a.pt === steps(c, 0.45)) c.w.emit('splash', { big: true, x: d.x0, z: d.z0 + d.s, y: SEA_Y });\n      if (after(c, 3)) {\n        d.s = FLAGS[d.flag];\n        d.last = '';\n        Object.assign(wob, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, recover: 0 });\n        if (cast) Object.assign(cast, { y: SEA_Y + HEIGHT, pose: 'LineWalk', poseT: 1 });\n        enter(c, 'walk');\n      }\n      moveProp(c.w, d.boat, d.x0 + 3 - Math.min(1, c.a.pt / 90), SEA_Y, d.z0 + d.s, 0);\n      return;\n    }\n    // Steps.\n    d.cool = Math.max(0, d.cool - 1);\n    const kick = c.w.settings.get<number>('game.line.stepKick');\n    const pressed = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n    if (pressed && d.cool === 0) {\n      if (pressed === d.last) {\n        wob.vx += pressed === 'L' ? -0.9 : 0.9;\n        c.w.emit('stumble', { foot: pressed });\n      } else {\n        d.s = Math.min(LENGTH, d.s + STEP);\n        wob.vx += (pressed === 'L' ? 1 : -1) * kick;\n        d.walkT = 8;\n        c.w.emit('lineStep', { foot: pressed, s: d.s });\n        for (let f = FLAGS.length - 1; f > d.flag; f--) {\n          if (d.s >= FLAGS[f]) {\n            d.flag = f;\n            c.w.emit('lineFlag', { flag: f });\n            say(c, 'tare', 'line.flag');\n            break;\n          }\n        }\n      }\n      d.last = pressed;\n      d.cool = 6;\n    }\n    // Gusts, telegraphed 1.5 s ahead.\n    if (d.gustLeft > 0) {\n      d.gustLeft -= 1;\n      wob.dx += d.gustDir * c.w.settings.get<number>('game.line.gust') * 4;\n    } else {\n      d.gustIn -= 1;\n      if (!d.warned && d.gustIn <= steps(c, 1.5)) {\n        d.warned = true;\n        d.gustDir = c.w.rng('line').chance(0.5) ? 1 : -1;\n        c.w.emit('gustWarn', { dir: d.gustDir });\n      }\n      if (d.gustIn <= 0) {\n        d.gustLeft = steps(c, 1.4);\n        d.warned = false;\n        d.gustIn = steps(c, c.w.rng('line').range(6, 10));\n      }\n    }\n    // The Gull.\n    d.stickWas.push(seat.lx);\n    if (d.stickWas.length > 15) d.stickWas.shift();\n    if (d.gull === 'waiting' && d.s >= GULL_AT && cast) {\n      d.gull = 'on';\n      say(c, 'tare', 'line.gull');\n      c.w.emit('gullLands', {});\n    }\n    if (d.gull === 'on') {\n      wob.dx += 2.6;\n      if (cast) critterGo(c, 'gull', cast.x - 0.32, cast.y + 1.3, cast.z, 1.2);\n      const flick = Math.max(...d.stickWas) - Math.min(...d.stickWas);\n      if (flick > 1.2) {\n        d.gull = 'gone';\n        critterAway(c, 'gull');\n        c.w.emit('gullFlicked', {});\n        say(c, 'tare', 'line.flicked');\n      }\n    }\n    if (cast) {\n      cast.x = d.x0 + wob.x * 0.3;\n      cast.z = d.z0 + d.s;\n      cast.leanX = wob.x * 1.2;\n      cast.leanY = wob.y * 0.5;\n      cast.pose = 'LineWalk';\n      cast.poseT = 1;\n    }\n    moveProp(c.w, d.boat, d.x0 + 5, SEA_Y + Math.sin(c.a.t * 0.04) * 0.05, d.z0 + d.s * 0.9, 0);\n    c.hud.ring = [0, 0, 0.7];\n    const gust = d.warned ? d.gustDir : 0;\n    c.hud.meter = d.s / LENGTH;\n    c.hud.meterLabel = `${Math.round(d.s)} of ${LENGTH} m`;\n    c.hud.show = { gust, gull: d.gull === 'on', falls: d.falls };\n    // Falling.\n    if (wob.recover > 0) {\n      d.falls += 1;\n      say(c, 'tare', 'line.fall');\n      c.w.emit('lineFall', {});\n      enter(c, 'fall');\n    } else if (d.s >= LENGTH) {\n      say(c, 'tare', 'line.done');\n      c.a.done = true;\n    } else if (d.time >= steps(c, CLOSES)) {\n      say(c, 'tare', 'line.closes');\n      c.a.done = true;\n    }\n  },\n  teardown(c) {\n    critterAway(c, 'gull');\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as LineData;\n    const { seat, wobble } = e;\n    seat.act = false;\n    holdAt(c.w, seat, wobble, 0, 0, player);\n    seat.ly = 0;\n    if (!player.acts) {\n      seat.fl = seat.fr = 0;\n      return;\n    }\n    const mem = seat.mem as { tick?: number; flick?: number };\n    mem.tick = (mem.tick ?? 0) + 1;\n    const cadence = player.name === 'perfect' ? 30 : player.name === 'human' ? 44 : 60;\n    const foot = mem.tick % cadence;\n    const left = Math.floor(mem.tick / cadence) % 2 === 0;\n    seat.fl = left && foot < 6 ? 1 : 0;\n    seat.fr = !left && foot < 6 ? 1 : 0;\n    if (d.gull === 'on') {\n      mem.flick = (mem.flick ?? 0) + 1;\n      const wait = player.name === 'perfect' ? 30 : player.name === 'human' ? 90 : 240;\n      if (mem.flick > wait) seat.lx = mem.flick % 16 < 8 ? 1 : -1;\n    }\n  },\n  score(c) {\n    const d = c.a.data as unknown as LineData;\n    const seconds = d.time / c.w.hz;\n    return Math.max(0, 1000 - 150 * d.falls - 8 * Math.max(0, seconds - PAR)) * (d.s / LENGTH);\n  },\n};\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\ns=open(p).read()\ns=s.replace(\"import { group, setGroupTable } from './group';\",\"import { group, setGroupTable } from './group';\\nimport { line } from './line';\\nimport { reps } from './reps';\\nimport { step } from './step';\")\ns=s.replace(\"  ring,\\n  group,\",\"  ring,\\n  group,\\n  reps,\\n  step,\\n  line,\")\nopen(p,'w').write(s)\nEOF\nTEETER_SEEDS=2 TEETER_SHOW=1 TEETER_ONLY=reps,step,line npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -E \"^(reps|step|line)|AssertionError|Error:|❯ labs|Tests \" | head -20 | cut -c1-220","description":"Write Reps Hall, Step Class and The Line, then test balance","timeout":400000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3775,"cache_read_input_tokens":414990,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3775},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"268d9284-0003-4a1d-ba44-6da07befe127","timestamp":"2026-11-05T09:42:51.469Z","request_id":"req_011CgjZN2QQVHzDU2WHa7KRs","wire_tool_inputs":{"toolu_01DEzEisjY1kqGh2nXoQ1iWc":{"command":"grep -n \"export function propCentre\" -A8 engine/world/props/*.ts | cut -c1-150 | head -14; grep -n \"export function fromCamera\" -A8 engine/input/intents.ts | cut -c1-120; cat >> labs/game/scenes/events/kit.ts <<'EOF'\n\n/** Moves a body-less prop: its base at `x, y, z`, turned by quaternion `q` (or a yaw). */\nexport function moveProp(w: GameWorld, id: number, x: number, y: number, z: number, turn: number | number[] = 0): void {\n  const e = w.get(id);\n  if (!e?.sceneProp) return;\n  const centre = propCentre(getProp(e.sceneProp.prop));\n  e.sceneProp.x = x;\n  e.sceneProp.y = y + centre;\n  e.sceneProp.z = z;\n  e.sceneProp.q = typeof turn === 'number' ? [0, Math.sin(turn / 2), 0, Math.cos(turn / 2)] : [...turn];\n}\n\n/** Spawns a floor shape for this activity. Its telegraph '' draws nothing. */\nexport function floorShape(c: Ctx, telegraph: string, x: number, y: number, z: number, size = 1, yaw = 0): number {\n  return entityFor(c, { matRing: { telegraph, position: [x, y, z], yaw, u: 1, size, owner: -1 } });\n}\n\n/** The world direction a lean means from a camera's heading. */\nexport function worldFromLean(lx: number, ly: number, cam: number): [number, number] {\n  const [x, z] = fromCamera(cam, [lx, ly]);\n  return [x, z];\n}\n\n/** The lean that means a world direction, at heading 0 (the bots steer this way). */\nexport function leanForWorld(wx: number, wz: number): [number, number] {\n  const [rx, rz] = fromCamera(0, [1, 0]);\n  const [fx, fz] = fromCamera(0, [0, 1]);\n  return [wx * rx + wz * rz, wx * fx + wz * fz];\n}\n\n/** Whether this seat is being played by a bot just now. */\nexport function isBot(c: Ctx, index: number): boolean {\n  const e = c.seats.find((s) => s.seat.index === index);\n  if (!e) return false;\n  return e.seat.kind === 'cpu' || c.flow.attract || c.w.settings.get<boolean>('game.auto');\n}\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/kit.ts'\ns=open(p).read()\ns=s.replace(\"import { removeActor, removeProp, spawnProp, type PropPlacement } from '../../../../engine/sim-api';\",\"import { fromCamera, getProp, propCentre, removeActor, removeProp, spawnProp, type PropPlacement } from '../../../../engine/sim-api';\")\nopen(p,'w').write(s)\np='labs/game/props/stations.ts'\ns=open(p).read()\ns=s.replace(\"\"\"defineProp('prop:lounger', {\n  description: 'A sun lounger. It slides when the island does.',\n  parts: [\n    box('bed', 0.7, 0.08, 1.7, 'material:clinical', [0, 0.28, 0]),\n    box('rest', 0.7, 0.08, 0.6, 'material:coral', [0, 0.4, -0.9], [0.5, 0, 0]),\n    box('frame', 0.6, 0.28, 1.4, 'material:slate', [0, 0, 0]),\n  ],\n  body: { type: 'dynamic', shape: 'box', size: [0.7, 0.4, 1.9], density: 40, friction: 0.25 },\n} as never);\"\"\",\"\"\"free('prop:lounger', 'A sun lounger. It slides when the island does.', [\n  box('bed', 0.7, 0.08, 1.7, 'material:clinical', [0, 0.28, 0]),\n  box('rest', 0.7, 0.08, 0.6, 'material:coral', [0, 0.4, -0.9], [0.5, 0, 0]),\n  box('frame', 0.6, 0.28, 1.4, 'material:slate', [0, 0, 0]),\n]);\"\"\")\nopen(p,'w').write(s)\np='labs/game/cast/roster.ts'\ns=open(p).read()\ns=s.replace(\"\"\"  playClip(w, e.id, `RETREAT/${pose}`, { speed: 0, hold: true, walk: true, loop: false, fade: 0.2, out: 0.25 });\"\"\",\"\"\"  playClip(w, e.id, `RETREAT/${pose}`, { speed: 0, hold: true, walk: true, loop: LOOPED.has(pose), fade: 0.2, out: 0.25 });\"\"\")\ns=s.replace(\"\"\"/** The clip layer of an entity, as data. */\"\"\",\"\"\"/** Strips that run round in a ring, scrubbed by an angle or a clock. */\nconst LOOPED = new Set(['HipCircle', 'Paddling', 'Crank']);\n\n/** The clip layer of an entity, as data. */\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > labs/game/scenes/events/reps.ts <<'EOF'\n/**\n * @file Reps Hall (PLAN.md section 6): the signature \"thumb is the exercise\" activity. A band moves at the tempo; stick\n * depth moves your marker and scrubs the body. Stay within 0.2 of the band to bank the rep. Gerald does two for each of\n * yours. Near the finish the counter cheats.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'reps');\n */\nimport { holdAt, type Player } from '../bot/players';\nimport { ANNEX_OFFSETS } from '../data/stations';\nimport { bothFeet } from '../wobble';\nimport { after, castOf, enter, say, standSeats, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** The exercises: adding a row adds one. */\nconst EXERCISES = [\n  { id: 'knees', name: 'Deep Knees', count: 10, clip: 'DeepKnee', axis: 'y', feet: false },\n  { id: 'pushups', name: 'Polite Push-Ups', count: 8, clip: 'PushUp', axis: 'y', feet: true },\n  { id: 'lunges', name: 'Side Lunges', count: 10, clip: 'LungeR', axis: 'x', feet: false },\n] as const;\n\n/** Full depth, on the balance disc. */\nconst DEPTH = 0.68;\n/** How close the marker must be to the band. */\nconst NEAR = 0.24;\n/** A rep banks at this share of its time in the band. */\nconst BANKS = 0.45;\n\n/** The hall's state. */\ninterface RepsData {\n  ex: number;\n  rep: number;\n  p: number;\n  inside: number;\n  total: number;\n  accs: number[];\n  side: number;\n  band: number;\n  marker: number;\n}\n\n/** The band at progress `p`: down and back up, easing at each end. */\nconst bandAt = (p: number): number => Math.pow(Math.sin(Math.PI * p), 2);\n\n/** How fast the band goes on this rep: speeds up a little near the end of a set. */\nfunction repSteps(c: Ctx, d: RepsData): number {\n  const count = EXERCISES[d.ex].count;\n  const speed = 1 + (0.18 * d.rep) / count;\n  return Math.round((c.w.settings.get<number>('game.reps.tempo') * c.w.hz) / speed);\n}\n\n/** Reps Hall. */\nexport const reps: Activity = {\n  id: 'reps',\n  title: 'Reps Hall',\n  station: 'annex',\n  map: 'actionMap:balance',\n  shot: 'reps',\n  wobble: true,\n  setup(c) {\n    const d: RepsData = { ex: 0, rep: 0, p: 0, inside: 0, total: 0, accs: [], side: 1, band: 0, marker: 0 };\n    c.a.data = d as unknown as Record<string, unknown>;\n    standSeats(c, ANNEX_OFFSETS, Math.PI);\n    const { x, z } = c.station;\n    const gerald = castOf(c.w, 'gerald');\n    if (gerald) Object.assign(gerald.cast, { hold: true, x: x + ANNEX_OFFSETS[1][0], y: c.ground(x, z) + 0.15, z: z + ANNEX_OFFSETS[1][1], yaw: Math.PI });\n    const plumb = castOf(c.w, 'plumb');\n    if (plumb) Object.assign(plumb.cast, { hold: true, x: x + 3, y: c.ground(x, z) + 0.05, z: z - 2.5, yaw: 0, pose: 'Upright', poseT: 1 });\n    c.hud.disc = true;\n    c.hud.feet = true;\n    c.hud.title = EXERCISES[0].name;\n    enter(c, 'ready');\n    say(c, 'plumb', 'reps.start');\n  },\n  step(c) {\n    const d = c.a.data as unknown as RepsData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const ex = EXERCISES[d.ex];\n    const body = castOf(c.w, 'guest');\n    const gerald = castOf(c.w, 'gerald');\n    if (c.a.phase === 'ready') {\n      c.hud.show = { exercise: ex.id, rep: 0, of: ex.count, band: 0, marker: 0, side: 1 };\n      if (body) Object.assign(body.cast, { pose: ex.clip, poseT: 0, leanX: wob.x * 0.5, leanY: 0 });\n      if (after(c, 2.5)) {\n        say(c, 'plumb', `reps.${ex.id}`);\n        enter(c, 'rep');\n      }\n      return;\n    }\n    if (c.a.phase === 'switch') {\n      if (body) Object.assign(body.cast, { poseT: Math.max(0, body.cast.poseT - c.w.dt * 2) });\n      if (after(c, 2)) enter(c, 'ready');\n      return;\n    }\n    // A rep.\n    const total = repSteps(c, d);\n    d.p += 1 / total;\n    d.band = bandAt(Math.min(1, d.p));\n    wob.swayMul = 0.7 + 0.5 * (d.rep / ex.count);\n    wob.usesBreath = false;\n    const raw = ex.axis === 'y' ? -wob.y : wob.x * d.side;\n    d.marker = Math.max(0, Math.min(1, raw / DEPTH));\n    const feetOk = !ex.feet || bothFeet(seat);\n    d.total += 1;\n    if (Math.abs(d.marker - d.band) <= NEAR && feetOk) d.inside += 1;\n    if (body) {\n      const clip = ex.axis === 'x' ? (d.side > 0 ? 'LungeR' : 'LungeL') : ex.clip;\n      const t = ex.feet ? (feetOk ? 0.4 + 0.6 * d.marker : 0.25) : d.marker;\n      Object.assign(body.cast, { pose: clip, poseT: t, leanX: ex.axis === 'x' ? 0 : wob.x * 0.4, leanY: 0 });\n    }\n    if (gerald) Object.assign(gerald.cast, { pose: ex.axis === 'x' ? (d.side > 0 ? 'LungeL' : 'LungeR') : ex.clip, poseT: (ex.feet ? 0.4 + 0.6 : 1) * bandAt((d.p * 2) % 1) });\n    if (d.p >= 1) {\n      const acc = d.total > 0 ? d.inside / d.total : 0;\n      d.accs.push(acc);\n      if (acc >= BANKS) d.rep += 1;\n      else d.rep += 0;\n      c.w.emit('rep', { banked: acc >= BANKS, rep: d.rep, acc });\n      d.p = 0;\n      d.inside = d.total = 0;\n      if (ex.axis === 'x') d.side = -d.side;\n      const attempts = d.accs.length;\n      if (d.rep === ex.count - 2 && acc >= BANKS) say(c, 'plumb', 'reps.lying');\n      if (d.rep >= ex.count || c.a.pt > steps(c, ex.count * 5)) {\n        d.ex += 1;\n        d.rep = 0;\n        if (d.ex >= EXERCISES.length) c.a.done = true;\n        else {\n          enter(c, 'switch');\n          c.hud.title = EXERCISES[d.ex].name;\n        }\n      }\n      void attempts;\n    }\n    // The counter cheats near the finish: \"9 of 10\" becomes \"10 of 11\".\n    const cheat = d.rep >= ex.count - 1 ? 1 : 0;\n    c.hud.show = { exercise: ex.id, rep: d.rep + cheat, of: ex.count + cheat, band: d.band, marker: d.marker, side: d.side, feet: ex.feet, axis: ex.axis };\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as RepsData;\n    const { seat, wobble } = e;\n    const ex = EXERCISES[Math.min(d.ex, EXERCISES.length - 1)];\n    seat.act = false;\n    seat.fl = seat.fr = ex.feet && player.acts && c.a.phase === 'rep' ? 1 : 0;\n    if (c.a.phase !== 'rep') {\n      holdAt(c.w, seat, wobble, 0, 0, player);\n      return;\n    }\n    // People look ahead a little: a thumb follows the rhythm, not the moment.\n    const total = Math.max(1, repSteps(c, d));\n    const ahead = bandAt(Math.min(1, d.p + (player.delay + 8) / total));\n    const goal = ahead * DEPTH;\n    if (ex.axis === 'y') holdAt(c.w, seat, wobble, 0, -goal, player);\n    else holdAt(c.w, seat, wobble, goal * d.side, 0, player);\n  },\n  score(c) {\n    const d = c.a.data as unknown as RepsData;\n    if (d.accs.length === 0) return 0;\n    return (1000 * d.accs.reduce((a, b) => a + b, 0)) / d.accs.length;\n  },\n};\nEOF\ncat > labs/game/scenes/data/charts.ts <<'EOF'\n/**\n * @file Step Class's charts (PLAN.md section 6): strings, one token per half beat: L, R, B (both, a jump), < and > (side\n * steps: lean plus foot), . rest, | a bar line. A new chart is a new string.\n *\n * Game code, sim-side data.\n *\n * @example\n * parseChart('L . R . | B . . .').length; // 3\n */\n\n/** The three phrases of Step Class, each at its tempo. */\nexport const PHRASES: readonly { bpm: number; chart: string }[] = [\n  {\n    bpm: 104,\n    chart:\n      'L . R . L . R . | L . R . L . R . | L . R . L . R . | B . . . B . . . | L . R . L . R . | L L R . B . . . | R . L . R . L . | R R L . B . . . | L . R . < . . . | R . L . > . . . | L . R . L . R . | B . . . . . . .',\n  },\n  {\n    bpm: 112,\n    chart:\n      'L . R . < . > . | L . R . < . > . | L L R . L L R . | B . B . B . . . | R . L . > . < . | R . L . > . < . | R R L . R R L . | B . B . B . . . | L R L . R L R . | < . > . < . > . | L R L . R L R . | B . . . B . . .',\n  },\n  {\n    bpm: 120,\n    chart:\n      'L . R . L . R . | L R L R B . . . | < . > . < . > . | L R L R B . . . | R . L . R . L . | R L R L B . . . | > . < . > . < . | R L R L B . . . | L L R R L L R R | B . B . B . B . | L . < . R . > . | L . < . R . > . | L R L R L R L R | B . . . B . . . | < . > . < . > . | B . . . . . . .',\n  },\n];\n\n/** The one phrase of a Round's short class. */\nexport const SHORT_PHRASE: { bpm: number; chart: string } = {\n  bpm: 112,\n  chart:\n    'L . R . L . R . | L . R . L . R . | L . R . < . > . | B . . . B . . . | L . R . L . R . | L L R . B . . . | R . L . > . < . | R R L . B . . . | L . R . L . R . | < . > . < . > . | L R L R B . . . | R . L . R . L . | L L R . L L R . | B . B . B . . . | R L R L R . L . | < . > . < . > . | L . R . L . R . | L R L R B . . . | L . R . L . R . | B . . . . . . .',\n};\n\n/** A note: its slot (half beats from the phrase's start) and what it asks. */\nexport interface ChartNote {\n  slot: number;\n  kind: 'L' | 'R' | 'B' | '<' | '>';\n}\n\n/** The notes of a chart. */\nexport function parseChart(chart: string): ChartNote[] {\n  const notes: ChartNote[] = [];\n  let slot = 0;\n  for (const token of chart.split(/\\s+/)) {\n    if (token === '|' || token === '') continue;\n    if (token !== '.') notes.push({ slot, kind: token as ChartNote['kind'] });\n    slot += 1;\n  }\n  return notes;\n}\n\n/** The slots a chart takes. */\nexport const slotsOf = (chart: string): number => chart.split(/\\s+/).filter((t) => t !== '|' && t !== '').length;\nEOF\ncat > labs/game/scenes/events/step.ts <<'EOF'\n/**\n * @file Step Class (PLAN.md section 6): rhythm on a step platform. Footprints scroll to a hit line on the HUD, floor tiles\n * light in the world. Timing is in sim steps, never audio time. Every seat plays; the guests behind you follow your\n * combo: lose it and they fall out of time, politely.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'step');\n */\nimport { timingError, type Player } from '../bot/players';\nimport { parseChart, PHRASES, SHORT_PHRASE, slotsOf } from '../data/charts';\nimport { ANNEX_OFFSETS, MAT_OFFSETS } from '../data/stations';\nimport { enter, floorShape, propFor, say, standSeats, steps } from './kit';\nimport type { Activity, Ctx, SeatEntity } from './types';\n\n/** A note on the sim's clock. */\ninterface TimedNote {\n  at: number;\n  kind: 'L' | 'R' | 'B' | '<' | '>';\n  hit: boolean[];\n}\n\n/** One seat's numbers. */\ninterface StepSeat {\n  next: number;\n  combo: number;\n  best: number;\n  value: number;\n  perfects: number;\n  goods: number;\n  misses: number;\n  last: string;\n  lastT: number;\n  foot: 'L' | 'R';\n  poseT: number;\n}\n\n/** The class's state. */\ninterface StepData {\n  notes: TimedNote[];\n  beats: number[];\n  nextBeat: number;\n  end: number;\n  seats: StepSeat[];\n  tiles: number[];\n  litL: number;\n  litR: number;\n  max: number;\n  lead: number;\n}\n\n/** Gives the multiplier for a combo: up to 1.5. */\nconst multiplier = (combo: number): number => 1 + 0.5 * Math.min(1, combo / 16);\n\n/** Lays the phrases out on the clock. */\nfunction layOut(c: Ctx, lead: number): { notes: TimedNote[]; beats: number[]; end: number } {\n  const scale = c.w.settings.get<number>('game.step.bpm');\n  const phrases = c.a.short ? [SHORT_PHRASE] : PHRASES;\n  const notes: TimedNote[] = [];\n  const beats: number[] = [];\n  let start = lead;\n  for (const phrase of phrases) {\n    const half = (c.w.hz * 60) / (phrase.bpm * scale * 2);\n    for (const note of parseChart(phrase.chart)) notes.push({ at: Math.round(start + note.slot * half), kind: note.kind, hit: [false, false, false, false] });\n    const slots = slotsOf(phrase.chart);\n    for (let slot = 0; slot < slots; slot += 2) beats.push(Math.round(start + slot * half));\n    start += Math.round(slots * half) + Math.round(half * 4);\n  }\n  return { notes, beats, end: start };\n}\n\n/** Whether a press fits a note's kind. */\nfunction fits(kind: TimedNote['kind'], e: SeatEntity): boolean {\n  const lean = e.seat.lx + e.wobble.mx;\n  const { pfl, pfr, fl, fr } = e.seat;\n  if (kind === 'L') return pfl;\n  if (kind === 'R') return pfr;\n  if (kind === 'B') return (pfl && fr >= 0.5) || (pfr && fl >= 0.5);\n  if (kind === '<') return pfl && lean < -0.35;\n  return pfr && lean > 0.35;\n}\n\n/** One seat's step: its presses against the notes in its windows; its misses. */\nfunction stepSeat(c: Ctx, d: StepData, e: SeatEntity): void {\n  const s = d.seats[e.seat.index];\n  const { w, a } = c;\n  const now = a.t;\n  const good = w.settings.get<number>('game.step.good');\n  const perfect = w.settings.get<number>('game.step.perfect');\n  const i0 = e.seat.index;\n  while (s.next < d.notes.length && !d.notes[s.next].hit[i0] && d.notes[s.next].at + good < now) {\n    s.combo = 0;\n    s.misses += 1;\n    s.next += 1;\n    if (i0 === c.seats[0].seat.index) w.emit('stepMiss', { seat: i0 });\n  }\n  if (e.seat.pfl || e.seat.pfr) {\n    for (let n = s.next; n < d.notes.length; n++) {\n      const note = d.notes[n];\n      if (note.at > now + good) break;\n      if (note.hit[i0] || !fits(note.kind, e)) continue;\n      const off = Math.abs(note.at - now);\n      const grade = off <= perfect ? 'perfect' : 'good';\n      note.hit[i0] = true;\n      s.combo += 1;\n      s.best = Math.max(s.best, s.combo);\n      s.value += (grade === 'perfect' ? 1 : 0.6) * multiplier(s.combo);\n      if (grade === 'perfect') s.perfects += 1;\n      else s.goods += 1;\n      s.last = grade;\n      s.lastT = now;\n      s.foot = note.kind === 'R' || note.kind === '>' ? 'R' : 'L';\n      s.poseT = 1;\n      if (n === s.next) s.next += 1;\n      if (i0 === c.seats[0].seat.index) w.emit('stepHit', { seat: i0, grade, kind: note.kind, combo: s.combo });\n      break;\n    }\n    while (s.next < d.notes.length && d.notes[s.next].hit[i0]) s.next += 1;\n  }\n  s.poseT = Math.max(0, s.poseT - w.dt * 5);\n  const cast = w.get(e.seat.actor)?.cast;\n  if (cast) {\n    const kind = s.foot === 'R' ? 'StepUpR' : 'StepUpL';\n    cast.pose = kind;\n    cast.poseT = s.poseT;\n    cast.leanX = e.wobble.x * 0.8;\n    cast.leanY = 0;\n  }\n}\n\n/** Step Class. */\nexport const step: Activity = {\n  id: 'step',\n  title: 'Step Class',\n  station: 'annex',\n  map: 'actionMap:balance',\n  shot: 'step',\n  wobble: true,\n  setup(c) {\n    const lead = steps(c, c.a.short ? 6 : 4);\n    const { notes, beats, end } = layOut(c, lead);\n    const d: StepData = {\n      notes,\n      beats,\n      end,\n      nextBeat: 0,\n      seats: [0, 1, 2, 3].map(() => ({ next: 0, combo: 0, best: 0, value: 0, perfects: 0, goods: 0, misses: 0, last: '', lastT: -999, foot: 'L', poseT: 0 })),\n      tiles: [],\n      litL: 0,\n      litR: 0,\n      lead,\n      max: notes.reduce((sum, _n, i) => sum + multiplier(i + 1), 0),\n    };\n    c.a.data = d as unknown as Record<string, unknown>;\n    const offsets = c.round ? MAT_OFFSETS : ANNEX_OFFSETS;\n    standSeats(c, offsets, Math.PI, c.round ? 0.05 : 0.27);\n    for (const e of c.seats) {\n      e.wobble.swayMul = 0.25;\n      e.wobble.usesBreath = false;\n      const [ox, oz] = offsets[e.seat.index];\n      const [x, z] = [c.station.x + ox, c.station.z + oz];\n      if (!c.round) propFor(c, { prop: 'prop:stepBlock', at: [x, c.ground(x, z) + 0.1, z], yaw: 0 });\n      d.tiles.push(floorShape(c, '', x - 0.6, c.ground(x, z) + 0.16, z + 0.8), floorShape(c, '', x + 0.6, c.ground(x, z) + 0.16, z + 0.8));\n    }\n    c.hud.disc = false;\n    c.hud.feet = true;\n    c.hud.title = 'Step Class';\n    enter(c, 'play');\n    say(c, 'plumb', 'step.start');\n  },\n  step(c) {\n    const d = c.a.data as unknown as StepData;\n    const now = c.a.t;\n    while (d.nextBeat < d.beats.length && d.beats[d.nextBeat] <= now) {\n      c.w.emit('beat', { n: d.nextBeat, at: d.beats[d.nextBeat] });\n      d.nextBeat += 1;\n    }\n    for (const e of c.seats) stepSeat(c, d, e);\n    const me = d.seats[c.seats[0].seat.index];\n    // The tiles light in the world for the next note.\n    const upcoming = d.notes.find((n) => n.at >= now && n.at <= now + 10);\n    c.seats.forEach((_e, i) => {\n      const [tileL, tileR] = [d.tiles[i * 2], d.tiles[i * 2 + 1]];\n      const ml = c.w.get(tileL)?.matRing;\n      const mr = c.w.get(tileR)?.matRing;\n      const kind = upcoming?.kind ?? '';\n      if (ml) ml.telegraph = kind === 'L' || kind === '<' || kind === 'B' ? 'telegraph:tileL' : '';\n      if (mr) mr.telegraph = kind === 'R' || kind === '>' || kind === 'B' ? 'telegraph:tileR' : '';\n    });\n    // What the lanes need: the next few notes.\n    const soon = d.notes.filter((n) => n.at >= now - 12 && n.at <= now + 150).slice(0, 14);\n    c.hud.show = {\n      notes: soon.map((n) => [n.at - now, n.kind, n.hit[c.seats[0].seat.index] ? 1 : 0]),\n      combo: me.combo,\n      grade: now - me.lastT < 30 ? me.last : '',\n      value: me.value,\n      followers: Math.min(3, Math.floor(me.combo / 5)),\n    };\n    c.hud.meter = 1 - now / Math.max(1, d.end);\n    if (now >= d.end) c.a.done = true;\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as StepData;\n    const { seat } = e;\n    const mem = seat.mem as { note?: number; err?: number; holdL?: number; holdR?: number };\n    seat.act = false;\n    mem.note ??= 0;\n    mem.err ??= 0;\n    mem.holdL ??= 0;\n    mem.holdR ??= 0;\n    if (!player.acts) {\n      Object.assign(seat, { fl: 0, fr: 0, lx: 0, ly: 0 });\n      return;\n    }\n    const now = c.a.t;\n    const note = d.notes[mem.note];\n    seat.lx = 0;\n    seat.ly = 0;\n    if (note) {\n      if (note.kind === '<' && note.at - now < 14) seat.lx = -0.8;\n      if (note.kind === '>' && note.at - now < 14) seat.lx = 0.8;\n      if (now >= note.at + mem.err) {\n        if (note.kind === 'L' || note.kind === '<' || note.kind === 'B') mem.holdL = 5;\n        if (note.kind === 'R' || note.kind === '>' || note.kind === 'B') mem.holdR = 5;\n        mem.note += 1;\n        mem.err = timingError(c.w, seat, player);\n      }\n    }\n    seat.fl = mem.holdL > 0 ? 1 : 0;\n    seat.fr = mem.holdR > 0 ? 1 : 0;\n    mem.holdL -= 1;\n    mem.holdR -= 1;\n  },\n  score(c, index) {\n    const d = c.a.data as unknown as StepData;\n    return d.max > 0 ? (1000 * d.seats[index].value) / d.max : 0;\n  },\n};\nEOF\ncat > labs/game/scenes/events/line.ts <<'EOF'\n/**\n * @file The Line (PLAN.md section 6): a 40 m slackline across the lagoon with three flags. Alternate feet to step: each\n * step moves 0.75 m and kicks you sideways; the same foot twice is a stumble. Lean x fights it. Gusts come, telegraphed.\n * At 15 m the Gull lands on your arm until you flick it off. Falling is a large splash; Tare's boat takes you back to the\n * last flag. After 120 s the boat collects you.\n *\n * Game code, sim-side.\n *\n * @example\n * // startActivity(w, 'line');\n */\nimport { holdAt, type Player } from '../bot/players';\nimport { SEA_Y } from '../data/stations';\nimport { after, castOf, critterAway, critterGo, enter, moveProp, propFor, say, steps } from './kit';\nimport type { Activity, Ctx } from './types';\n\n/** The line's length, m, its height over the water, its flags. */\nconst LENGTH = 40;\nconst HEIGHT = 3.2;\nconst FLAGS = [0, 13, 26];\nconst STEP = 0.75;\n/** Par time, s, and the time the line closes. */\nconst PAR = 50;\nconst CLOSES = 120;\n/** Where the Gull lands, m. */\nconst GULL_AT = 15;\n\n/** The line's state. */\ninterface LineData {\n  s: number;\n  x0: number;\n  z0: number;\n  last: string;\n  cool: number;\n  falls: number;\n  flag: number;\n  gustIn: number;\n  gustLeft: number;\n  gustDir: number;\n  warned: boolean;\n  gull: 'waiting' | 'on' | 'gone';\n  stickWas: number[];\n  boat: number;\n  time: number;\n  end: boolean;\n  walkT: number;\n}\n\n/** The Line. */\nexport const line: Activity = {\n  id: 'line',\n  title: 'The Line',\n  station: 'lagoon',\n  map: 'actionMap:balance',\n  shot: 'line',\n  wobble: true,\n  setup(c) {\n    const { x, z } = c.station;\n    const [x0, z0] = [x, z + 8];\n    const d: LineData = { s: 0, x0, z0, last: '', cool: 0, falls: 0, flag: 0, gustIn: steps(c, c.w.rng('line').range(4, 7)), gustLeft: 0, gustDir: 1, warned: false, gull: 'waiting', stickWas: [], boat: -1, time: 0, end: false, walkT: 0 }; // prettier-ignore\n    c.a.data = d as unknown as Record<string, unknown>;\n    propFor(c, { prop: 'prop:slackPost', at: [x0, SEA_Y + HEIGHT - 1.2, z0 - 0.4], yaw: 0 });\n    propFor(c, { prop: 'prop:slackPost', at: [x0, SEA_Y + HEIGHT - 1.2, z0 + LENGTH + 0.4], yaw: 0 });\n    propFor(c, { prop: 'prop:slackLine', at: [x0, SEA_Y + HEIGHT, z0], yaw: 0 });\n    for (const flag of FLAGS) propFor(c, { prop: 'prop:lineFlag', at: [x0 + 0.4, SEA_Y + HEIGHT - 0.1, z0 + flag], yaw: 0 });\n    d.boat = propFor(c, { prop: 'prop:boat', at: [x0 + 5, SEA_Y, z0], yaw: 0 });\n    const guest = castOf(c.w, 'guest');\n    if (guest) Object.assign(guest.cast, { hold: true, x: x0, y: SEA_Y + HEIGHT, z: z0, yaw: 0, pose: 'LineWalk', poseT: 1 });\n    const tare = castOf(c.w, 'tare');\n    if (tare) Object.assign(tare.cast, { hold: true, x: x0 + 5, y: SEA_Y + 0.3, z: z0, yaw: -1.2 });\n    c.hud.disc = true;\n    c.hud.feet = true;\n    c.hud.title = 'The Line';\n    enter(c, 'walk');\n    say(c, 'tare', 'line.start');\n  },\n  step(c: Ctx) {\n    const d = c.a.data as unknown as LineData;\n    const [{ seat, wobble: wob }] = c.seats;\n    const guest = castOf(c.w, 'guest');\n    d.time += 1;\n    wob.usesBreath = false;\n    const cast = guest?.cast;\n    if (c.a.phase === 'fall') {\n      if (cast) {\n        cast.y = Math.max(SEA_Y - 0.8, cast.y - c.w.dt * 7);\n        cast.pose = 'LineFall';\n        cast.poseT = 1;\n        cast.leanX = 0;\n      }\n      if (c.a.pt === steps(c, 0.45)) c.w.emit('splash', { big: true, x: d.x0, z: d.z0 + d.s, y: SEA_Y });\n      if (after(c, 3)) {\n        d.s = FLAGS[d.flag];\n        d.last = '';\n        Object.assign(wob, { x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0, recover: 0 });\n        if (cast) Object.assign(cast, { y: SEA_Y + HEIGHT, pose: 'LineWalk', poseT: 1 });\n        enter(c, 'walk');\n      }\n      moveProp(c.w, d.boat, d.x0 + 3 - Math.min(1, c.a.pt / 90), SEA_Y, d.z0 + d.s, 0);\n      return;\n    }\n    // Steps.\n    d.cool = Math.max(0, d.cool - 1);\n    const kick = c.w.settings.get<number>('game.line.stepKick');\n    const pressed = seat.pfl ? 'L' : seat.pfr ? 'R' : '';\n    if (pressed && d.cool === 0) {\n      if (pressed === d.last) {\n        wob.vx += pressed === 'L' ? -0.9 : 0.9;\n        c.w.emit('stumble', { foot: pressed });\n      } else {\n        d.s = Math.min(LENGTH, d.s + STEP);\n        wob.vx += (pressed === 'L' ? 1 : -1) * kick;\n        d.walkT = 8;\n        c.w.emit('lineStep', { foot: pressed, s: d.s });\n        for (let f = FLAGS.length - 1; f > d.flag; f--) {\n          if (d.s >= FLAGS[f]) {\n            d.flag = f;\n            c.w.emit('lineFlag', { flag: f });\n            say(c, 'tare', 'line.flag');\n            break;\n          }\n        }\n      }\n      d.last = pressed;\n      d.cool = 6;\n    }\n    // Gusts, telegraphed 1.5 s ahead.\n    if (d.gustLeft > 0) {\n      d.gustLeft -= 1;\n      wob.dx += d.gustDir * c.w.settings.get<number>('game.line.gust') * 4;\n    } else {\n      d.gustIn -= 1;\n      if (!d.warned && d.gustIn <= steps(c, 1.5)) {\n        d.warned = true;\n        d.gustDir = c.w.rng('line').chance(0.5) ? 1 : -1;\n        c.w.emit('gustWarn', { dir: d.gustDir });\n      }\n      if (d.gustIn <= 0) {\n        d.gustLeft = steps(c, 1.4);\n        d.warned = false;\n        d.gustIn = steps(c, c.w.rng('line').range(6, 10));\n      }\n    }\n    // The Gull.\n    d.stickWas.push(seat.lx);\n    if (d.stickWas.length > 15) d.stickWas.shift();\n    if (d.gull === 'waiting' && d.s >= GULL_AT && cast) {\n      d.gull = 'on';\n      say(c, 'tare', 'line.gull');\n      c.w.emit('gullLands', {});\n    }\n    if (d.gull === 'on') {\n      wob.dx += 2.6;\n      if (cast) critterGo(c, 'gull', cast.x - 0.32, cast.y + 1.3, cast.z, 1.2);\n      const flick = Math.max(...d.stickWas) - Math.min(...d.stickWas);\n      if (flick > 1.2) {\n        d.gull = 'gone';\n        critterAway(c, 'gull');\n        c.w.emit('gullFlicked', {});\n        say(c, 'tare', 'line.flicked');\n      }\n    }\n    if (cast) {\n      cast.x = d.x0 + wob.x * 0.3;\n      cast.z = d.z0 + d.s;\n      cast.leanX = wob.x * 1.2;\n      cast.leanY = wob.y * 0.5;\n      cast.pose = 'LineWalk';\n      cast.poseT = 1;\n    }\n    moveProp(c.w, d.boat, d.x0 + 5, SEA_Y + Math.sin(c.a.t * 0.04) * 0.05, d.z0 + d.s * 0.9, 0);\n    c.hud.ring = [0, 0, 0.7];\n    const gust = d.warned ? d.gustDir : 0;\n    c.hud.meter = d.s / LENGTH;\n    c.hud.meterLabel = `${Math.round(d.s)} of ${LENGTH} m`;\n    c.hud.show = { gust, gull: d.gull === 'on', falls: d.falls };\n    // Falling.\n    if (wob.recover > 0) {\n      d.falls += 1;\n      say(c, 'tare', 'line.fall');\n      c.w.emit('lineFall', {});\n      enter(c, 'fall');\n    } else if (d.s >= LENGTH) {\n      say(c, 'tare', 'line.done');\n      c.a.done = true;\n    } else if (d.time >= steps(c, CLOSES)) {\n      say(c, 'tare', 'line.closes');\n      c.a.done = true;\n    }\n  },\n  teardown(c) {\n    critterAway(c, 'gull');\n  },\n  bot(c, e, player: Player) {\n    const d = c.a.data as unknown as LineData;\n    const { seat, wobble } = e;\n    seat.act = false;\n    holdAt(c.w, seat, wobble, 0, 0, player);\n    seat.ly = 0;\n    if (!player.acts) {\n      seat.fl = seat.fr = 0;\n      return;\n    }\n    const mem = seat.mem as { tick?: number; flick?: number };\n    mem.tick = (mem.tick ?? 0) + 1;\n    const cadence = player.name === 'perfect' ? 30 : player.name === 'human' ? 44 : 60;\n    const foot = mem.tick % cadence;\n    const left = Math.floor(mem.tick / cadence) % 2 === 0;\n    seat.fl = left && foot < 6 ? 1 : 0;\n    seat.fr = !left && foot < 6 ? 1 : 0;\n    if (d.gull === 'on') {\n      mem.flick = (mem.flick ?? 0) + 1;\n      const wait = player.name === 'perfect' ? 30 : player.name === 'human' ? 90 : 240;\n      if (mem.flick > wait) seat.lx = mem.flick % 16 < 8 ? 1 : -1;\n    }\n  },\n  score(c) {\n    const d = c.a.data as unknown as LineData;\n    const seconds = d.time / c.w.hz;\n    return Math.max(0, 1000 - 150 * d.falls - 8 * Math.max(0, seconds - PAR)) * (d.s / LENGTH);\n  },\n};\nEOF\npython3 - <<'EOF'\np='labs/game/scenes/events/index.ts'\ns=open(p).read()\ns=s.replace(\"import { group, setGroupTable } from './group';\",\"import { group, setGroupTable } from './group';\\nimport { line } from './line';\\nimport { reps } from './reps';\\nimport { step } from './step';\")\ns=s.replace(\"  ring,\\n  group,\",\"  ring,\\n  group,\\n  reps,\\n  step,\\n  line,\")\nopen(p,'w').write(s)\nEOF\nTEETER_SEEDS=2 TEETER_SHOW=1 TEETER_ONLY=reps,step,line npx vitest run labs/game/scenes/balance.test.ts 2>&1 | grep -E \"^(reps|step|line)|AssertionError|Error:|❯ labs|Tests \" | head -20 | cut -c1-220","description":"Write Reps Hall, Step Class and The Line, then test balance","timeout":400000}}}
