g.stop?.();\n      this.rolling = null;\n    }\n    this.rolling?.volume?.(Math.min(1, speed * 0.45));\n  }\n\n  /** The wobble creak, its pitch and level by how near the edge. */\"\"\")\ns=s.replace(\"  private ambKind = '';\\n\",\"  private ambKind = '';\\n  private rolling: { stop?: () => void; volume?: (v: number) => void } | null = null;\\n\")\nopen(p,'w').write(s)\n# 8. session: live score and name labels\np='labs/game/ui/frame.ts'\ns=open(p).read()\ns=re.sub(r\"  let live = 0;\\n  if \\(inner && running\\?\\.phase === 'class'\\) \\{.*?\\n  \\}\\n  const total\",\"\"\"  let live = 0;\n  if (inner && running?.phase === 'class') {\n    try {\n      live = Math.max(0, Math.min(1000, ACTIVITIES[inner.id]?.score({ a: inner } as never, me) ?? 0));\n    } catch {\n      live = 0; // a class's first steps may have nothing to score yet\n    }\n  }\n  const total\"\"\",s,flags=re.S)\ns=s.replace(\"const total = (data.totals?.[me] ?? 0) + live;\",\"const total = Math.round((data.totals?.[me] ?? 0) + live);\")\nopen(p,'w').write(s)\np='labs/game/ui/app.ts'\ns=open(p).read()\ns=s.replace(\"\"\"      this.card = new HubCard(this.root, s);\"\"\",\"\"\"      this.card = new HubCard(this.root, s);\n      nameLabels(engine, s);\"\"\")\ns=s.replace(\"import { sendInput,\",\"import { nameLabels } from './names';\\nimport { sendInput,\")\nopen(p,'w').write(s)\nEOF\nrm -f labs/game/ui/devices.ts; cat > labs/game/ui/names.ts <<'EOF'\n/**\n * @file The session's name labels: each other player's name from the hub, over their mat, as text and never as HTML.\n *\n * Game code, a page's.\n *\n * @example\n * // nameLabels(engine, session);\n */\nimport type { Engine } from '../../../engine';\nimport type { Session } from '../hub/session';\nimport { FLAT_Y, MAT_OFFSETS, STATIONS } from '../scenes/data/stations';\n\n/** Puts a label over each other player's mat. */\nexport function nameLabels(engine: Engine, session: Session): void {\n  const { x, z } = STATIONS.pavilion;\n  for (const player of session.info.players) {\n    const [ox, oz] = MAT_OFFSETS[player.id] ?? [0, 0];\n    engine.ui?.label(player.name, { id: `name:${player.id}`, at: [x + ox, FLAT_Y + 2.3, z + oz], color: player.color });\n  }\n}\nEOF\nsed -i \"s/  private pad(pg/  private pad(pg/\" /dev/null 2>/dev/null; python3 - <<'EOF'\np='labs/game/tools/browser.py'\ns=open(p).read()\ns=s.replace(\"def pad(pg, i, wait=260):\",\"def pad(pg, i, wait=340):\")\ns=s.replace(\"\"\"STAGES = ['boot', 'keys', 'pad', 'attract', 'pause', 'tenfoot', 'touch', 'about', 'standalone', 'sound', 'mouse', 'credits', 'webkit']\"\"\",\"\"\"def stage_roam(browser):\n    pg = open_page(browser)\n    begin(pg)\n    act(pg, 'game.go', {'station': 'plaza'})\n    pg.wait_for_timeout(500)\n    where = lambda: pg.evaluate(\"() => { const e = __engine.state('cast').entities.find((x) => x.cast.who === 'guest'); return [e.actor.x, e.actor.z]; }\")\n    a = where()\n    pg.keyboard.down('KeyW')\n    pg.wait_for_timeout(1500)\n    pg.keyboard.up('KeyW')\n    pg.wait_for_timeout(200)\n    b = where()\n    check('roam: W walks', abs(a[0] - b[0]) + abs(a[1] - b[1]) > 1, f'{a} {b}')\n    check('roam: the chase camera', game(pg)['camera'].startswith('cam3=chase'), game(pg)['camera'])\n    # The thing in view: walk up to the board by the dev's go, face it, and use it.\n    act(pg, 'game.go', {'station': 'plaza'})\n    pg.wait_for_timeout(400)\n    found = pg.evaluate(\"() => __game.focus\")\n    for _ in range(14):\n        if pg.evaluate(\"() => __game.focus\") >= 0:\n            break\n        pg.keyboard.down('KeyD'); pg.wait_for_timeout(300); pg.keyboard.up('KeyD')\n    check('roam: something comes into view', pg.evaluate(\"() => __game.focus\") >= 0, found)\n    check('roam: its prompt shows', pg.evaluate(\"() => { const e = document.querySelector('[data-ui=prompt]'); return !!e && getComputedStyle(e).display !== 'none' && e.innerText.length > 0; }\"), '')\n    key(pg, 'KeyE', 500)\n    check('roam: using it answers', pg.evaluate(\"() => __game.speech.length > 0 || __game.mode === 'event' || __game.stack.length > 0\"), game(pg))\n    check('roam: no errors', not pg.errors, pg.errors[:3])\n    pg.context.close()\n\n\ndef stage_group(browser):\n    pg = open_page(browser)\n    wake(pg)\n    key(pg, 'ArrowDown'); key(pg, 'Enter', 400)\n    check('group: the join screen', game(pg)['screen'] == 'join', game(pg)['screen'])\n    key(pg, 'Space', 300)\n    pad(pg, 0)\n    lit = pg.evaluate(\"() => [...document.querySelectorAll('[data-mat]')].map((m) => m.dataset.on)\")\n    check('group: mats light as people join', lit[:2] == ['true', 'true'], lit)\n    key(pg, 'Space', 900)\n    check('group: starts on a joined press', game(pg)['event'] == 'group' and game(pg)['mode'] == 'event', game(pg))\n    pg.evaluate('() => { __padState.axes[0] = 1; }')\n    pg.wait_for_timeout(900)\n    seats = pg.evaluate(\"() => __engine.state('seat').entities.map((e) => [e.seat.index, e.seat.kind, e.seat.lx])\")\n    check('group: the second seat reads its pad', seats[1][1] == 'pad' and seats[1][2] > 0.5, seats)\n    check('group: empty seats go to CPU guests', seats[3][1] == 'cpu', seats)\n    check('group: no errors', not pg.errors, pg.errors[:3])\n    pg.context.close()\n\n\nSTAGES = ['boot', 'keys', 'pad', 'attract', 'pause', 'roam', 'group', 'tenfoot', 'touch', 'about', 'standalone', 'sound', 'mouse', 'credits', 'webkit']\"\"\")\nopen(p,'w').write(s)\nEOF\nnpx prettier --write labs/game >/dev/null; timeout 200 npx tsc -b tsconfig.check.json 2>&1 | grep -E \"labs/game|error\" | head -14 | cut -c1-220; export CHROMIUM_PATH=$HOME/.cache/ms-playwright/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell; timeout 200 node labs/game/tools/onefile.mjs out/game.html 2>&1 | tail -1 | cut -c1-300; timeout 400 python3 labs/game/tools/browser.py out/game.html roam group 2>&1 | tail -12 | cut -c1-420","description":"Add polish items, rumble, labels; test roam and group stages","timeout":880000}}}
