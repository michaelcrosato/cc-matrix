{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JNyac6YHAKQR7j7dzu7p5X","type":"tool_result","content":"  for (const spawn of level.spawns) {\n    for (const prop of props) {\n      if (prop.place.spawn && prop.place.spawn === spawn.name) out.push({ prop: prop.id, at: spawn.position, yaw: 0 });\n    }\n  }\n  for (const spot of level.lights) {\n    const [x, , z] = spot.position;\n    const top = level.top[spot.row * level.cols + spot.col];\n    for (const prop of props) {\n      if (prop.place.light && prop.place.light === spot.tag) out.push({ prop: prop.id, at: [x, top, z], yaw: 0 });\n    }\n  }\n  return out;\n}\n\n/** `placement`'s centre and turn, for `prop`. */\nfunction poseOf(prop: Prop, { at, yaw }: PropPlacement): PropPose {\n  return {\n    position: [at[0], at[1] + propCentre(prop), at[2]],\n    rotation: [0, Math.sin(yaw / 2), 0, Math.cos(yaw / 2)],\n  };\n}\n\n/** Where `placement` is drawn while no body moves it: the prop's centre and turn. */\nexport function propPose(placement: PropPlacement, registry: Registry = sharedRegistry): PropPose {\n  return poseOf(getProp(placement.prop, registry), placement);\n}\n\n/**\n * The body `physics.addBody` takes for `placement`, or `null` when its prop has none; see the file comment. `as` gives\n * it another type: a broken door's leaf falls (`'dynamic'`), a carried prop's body is the same body.\n */\nexport function propBody(\nexport interface PropPlacement {\n  /** The prop, by id (`prop:crate`). */\n  prop: string;\n  /** Where its base stands (m). */\n  at: Point3;\n  /** Its turn about +Y (rad). */\n  yaw: number;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"9dd98077-2f1f-4b79-bf36-2031f176f317","uuid":"ccbe3c64-b6e6-4145-a101-75d50510d34b","timestamp":"2026-11-05T09:27:58.237Z","tool_use_result":{"stdout":"  for (const spawn of level.spawns) {\n    for (const prop of props) {\n      if (prop.place.spawn && prop.place.spawn === spawn.name) out.push({ prop: prop.id, at: spawn.position, yaw: 0 });\n    }\n  }\n  for (const spot of level.lights) {\n    const [x, , z] = spot.position;\n    const top = level.top[spot.row * level.cols + spot.col];\n    for (const prop of props) {\n      if (prop.place.light && prop.place.light === spot.tag) out.push({ prop: prop.id, at: [x, top, z], yaw: 0 });\n    }\n  }\n  return out;\n}\n\n/** `placement`'s centre and turn, for `prop`. */\nfunction poseOf(prop: Prop, { at, yaw }: PropPlacement): PropPose {\n  return {\n    position: [at[0], at[1] + propCentre(prop), at[2]],\n    rotation: [0, Math.sin(yaw / 2), 0, Math.cos(yaw / 2)],\n  };\n}\n\n/** Where `placement` is drawn while no body moves it: the prop's centre and turn. */\nexport function propPose(placement: PropPlacement, registry: Registry = sharedRegistry): PropPose {\n  return poseOf(getProp(placement.prop, registry), placement);\n}\n\n/**\n * The body `physics.addBody` takes for `placement`, or `null` when its prop has none; see the file comment. `as` gives\n * it another type: a broken door's leaf falls (`'dynamic'`), a carried prop's body is the same body.\n */\nexport function propBody(\nexport interface PropPlacement {\n  /** The prop, by id (`prop:crate`). */\n  prop: string;\n  /** Where its base stands (m). */\n  at: Point3;\n  /** Its turn about +Y (rad). */\n  yaw: number;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JNyac6YHAKQR7j7dzu7p5X","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
