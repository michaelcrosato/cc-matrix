se = going ? 'Flap' : 'Perch';\n      cast.poseT = going ? k.tick * 0.09 : 1;\n    }\n  }\n}\nEOF\npython3 - <<'EOF'\nimport re\n# plunge's judges\np='labs/game/scenes/events/plunge.ts'\ns=open(p).read()\nm=re.search(r\"      d\\.gulls\\.push\\(.*?\\n\\s*\\);\\n\",s,re.S)\nassert m\ns=s.replace(m.group(0),\"\"\"      const judge = spawnCritter(c.w, 'gull', 'judge', [gx, SEA_Y + 1.2, gz], true);\n      c.a.actors.push(judge);\n      d.gulls.push(judge);\n\"\"\")\ns=s.replace(\"import { after, castOf, enter, entityFor, propFor, say } from './kit';\",\"import { spawnCritter } from '../critters';\\nimport { after, castOf, enter, propFor, say } from './kit';\")\nopen(p,'w').write(s)\n# tilt: dawn clears the HUD; calm call chip\np='labs/game/scenes/events/tilt.ts'\ns=open(p).read()\na=\"\"\"        if (c.a.pt === 1) {\n          Object.assign(isl, { sky: 'dawn', storm: 0, tiltX: 0, tiltZ: 0 });\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"        if (c.a.pt === 1) {\n          c.a.hud = { title: 'Dawn' };\n          Object.assign(isl, { sky: 'dawn', storm: 0, tiltX: 0, tiltZ: 0 });\"\"\")\nopen(p,'w').write(s)\np='labs/game/ui/hud/widgets.ts'\ns=open(p).read()\ns2=re.sub(r\"'left:50%;bottom:var\\(--safe\\);transform:translateX\\(-50%\\)',\\s*`<small>Calm Call</small>\",\"'left:50%;bottom:calc(var(--safe) + 13vh);transform:translateX(-50%)',\\n          `<small>Calm Call</small>\",s)\nassert s2!=s\nopen(p,'w').write(s2)\np='labs/game/ui/hud/speech.ts'\ns=open(p).read()\ns=s.replace(\"pa: 'Tannoy' };\",\"pa: 'Tannoy', Plaque: 'Plaque' };\") if \"Plaque:\" not in s else s\nopen(p,'w').write(s)\nEOF\ngrep -n \"critterGo\\|critterAway\" labs/game/scenes/events/kit.ts | head -3; grep -n \"query('critter')\" labs/game/scenes/events/kit.ts | cut -c1-120; grep -n \"crowdBody\\|stepCrowdBody\" labs/game/scenes/*.ts labs/game/scenes/events/*.ts | cut -c1-130 | head; npx prettier --write labs/game/scenes labs/game/cast labs/game/bodies labs/game/ui/hud >/dev/null; timeout 250 npx tsc -b