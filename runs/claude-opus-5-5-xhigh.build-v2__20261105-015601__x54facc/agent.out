lphas give equal matrices; every object it makes is under the prop meshes' root.\n *\n * @example\n * // const props = createStageProps({ scene: stage.scene, materials: library });\n * // const drawn = props.capture(world.query('sceneProp'), world.dt); // the ids drawn as props\n * // props.draw(0.5); // halfway between the last two steps\n * @see engine/gfx/stageProps.test.ts\n */\nimport { Quaternion, Vector3, type Material, type Scene } from 'three/webgpu';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { EntityData } from '../sim/state';\nimport { createPropMeshes, type PropLight, type PropMeshes } from './props';\nimport type { Warmup } from './warmup';\nimport type { HeldGun } from './weapons';\n\n/** What `createStageProps` takes. */\nexport interface StagePropsOptions {\n  /** The scene the prop meshes join when the first prop arrives. */\n  scene: Scene;\n  /** Where the materials come from: the page's material library. */\n  materials: { get(id: string): Material };\n  /** Where the props are declared (the shared registry by default). */\n  registry?: Registry;\n}\n\n/** A prop's pose: its centre (m) and its turn. */\ninterface Pose {\n  p: [number, number, number];\n  q: [number, number, number, number];\n}\n\n/** What the module keeps of one prop: its poses, and whether it is on (its `propLight`'s; true without one). */\ninterface Held {\n  prop: string;\n  before: Pose;\n  after: Pose;\n  on: boolean;\n}\nfunction readProps(w: World): void {\n  const physics = physicsOf(w);\n  for (const { sceneProp } of w.query('sceneProp') as unknown as ScenePropComponents[]) {\n    if (sceneProp.body < 0) continue;\n    const { position: p, rotation: r } = physics.readBody(sceneProp.body);\n    [sceneProp.x, sceneProp.y, sceneProp.z] = [p.x, p.y, p.z];\n    sceneProp.q = [r.x, r.y, r.z, r.w];\n  }\n}\nexport function removeProp<C extends object, E extends EventMap>(world: World<C, E>, id: number): void {\n  const w = world as unknown as World;\n  const data = propOf(w, id, 'removeProp(w, id)');\n  if (data.body >= 0) physicsOf(w).removeBody(data.body);\n  data.body = -1; // inside a step its entity stays to the step's end: nothing reads the body it no longer has\n  w.despawn(id);\n}\nawk: fatal: cannot open file `engine/world/props.ts' for reading: No such file or directory\nawk: fatal: cannot open file `engine/world/props.ts' for reading: No such file or directory\nawk: fatal: cannot open file `engine/world/props.ts' for reading: No such file or directory\nx describe: ok: geometry: 4 fields, 7 entries\nShapes props, levels and bodies name by id: a builder of a three.js BufferGeometry with its parameters and a vertex budg\nfallback: geometry:box\nids: geometry:box, geometry:frustum, geometry:limb, geometry:pillar, geometry:ramp, geometry:ring, geometry:roundedBox\n  description: string, required: What it is, in plain sentences.\n  params: object, = {}: Its parameters as schema fields (engine/core/schema.ts: type, default, description, minimum…), e\n  budget: integer, = 4096, 1..inf: The most vertices it may have at its default parameters (the geo QA family checks it)\n  create: function, required: The builder: (params) => BufferGeometry, standing on the ground, in metres, with normals a\n(a line above is cut short: the whole text is in out/describe/geometry/describe.json)\nreport: out/describe/geometry/report.json\nx describe: ok: material: 18 fields, 29 entries\nMaterials as data with three.js's classic parameters (color, map, roughness, emissive, flags); the e\nfallback: material:default\nids: material:asphalt, material:barrel, material:barrelLid, material:barrelStaves, material:blobShad\n  description: string, = \"\": What it is for, in plain sentences.\n  color: string, = \"#ffffff\": The base colour, hex; it multiplies the map (three.js's color).\n  map: any, = null: The texture generator that fills the maps: a texture id ('texture:brick'), or { \n  roughness: number, = 1, 0..1: