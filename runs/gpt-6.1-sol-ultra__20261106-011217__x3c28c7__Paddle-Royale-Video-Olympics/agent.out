fy-content:center;background:var(--paper);z-index:100;flex-direction:column;gap:15px}.loading b{font-size:36px;font-weight:900;letter-spacing:-.05em}.loading small{font-size:13px}.spinner{width:30px;height:30px;border:3px solid #d5d7bf;border-top-color:var(--coral);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}#touchpop{position:absolute;right:13%;top:50%;border-radius:50%;width:75px;height:75px;background:var(--coral);border:3px solid var(--ink);font-size:15px;font-weight:900;pointer-events:none;box-shadow:0 4px 0 var(--ink)}.touch-mode .controls,.touch-mode .meters{display:none}.touch-mode #hud .menu-btn{right:14px;top:14px}.touch-mode .scorebar{top:14px;min-width:260px}.touch-mode .team{padding:7px 13px;gap:10px}.touch-mode .team .pts{font-size:28px}.touch-mode .team b{font-size:11px}.touch-mode .hud-title{top:16px;left:14px}.touch-mode .hud-title b{font-size:12px}.touch-mode .hud-title small{display:none}#debugbadge{position:absolute;bottom:100px;right:32px;background:var(--gold);padding:6px 13px;font-size:11px;font-weight:800;border-radius:20px;pointer-events:none}@media(min-width:1700px){.hero{left:8%;width:510px}.hero h1{font-size:132px}.hero .tagline{font-size:24px;max-width:420px}.hero button{font-size:21px;min-height:67px}.hero .split button{font-size:17px}.hero .links button{font-size:16px}.eyebrow{font-size:14px}.titlefoot{left:8%;font-size:15px}.topbar{top:35px;left:45px;right:45px}.brand{font-size:22px}.top-right{font-size:16px}.panel{transform:scale(1.15)}.scorebar{transform:translateX(-50%) scale(1.2);transform-origin:top}.hud-foot{bottom:38px}.controls{font-size:16px}.meters{transform:scale(1.2);transform-origin:bottom right}.hud-title b{font-size:22px}.hud-title small{font-size:13px}.menu-btn{font-size:17px;min-height:50px}}@media(max-width:900px){.hero{left:5%;max-width:45vw;top:20%;width:355px}.hero h1{font-size:70px}.hero .tagline{font-size:16px;max-width:270px}.hero button{font-size:14px;padding:12px}.split{gap:7px}.hero .split button{font-size:12px}.eyebrow{font-size:10px}.topbar{top:18px;left:22px;right:22px}.brand{font-size:13px}.top-right{font-size:10px}.stamp{width:76px;height:76px;top:14%}.stamp b{font-size:24px}.titlecourt{font-size:9px;bottom:70px}.titlecourt b{font-size:20px}.titlefoot{font-size:9px}.scorebar{min-width:360px}.team{padding:8px 14px;gap:10px}.team .pts{font-size:34px}.hud-title{top:26px;left:20px;max-width:120px}.hud-title b{font-size:13px}.hud-title small{font-size:9px}.menu-btn{right:20px;font-size:11px;padding:0 11px}.hud-foot{left:20px;right:20px;bottom:18px}.controls{font-size:10px}.meter{width:72px}}@media(max-width:600px){.hero{top:17%;max-width:88vw;width:345px;left:7%}.hero h1{font-size:75px;margin:14px 0}.hero .tagline{max-width:300px;margin-bottom:19px}.hero .eyebrow{font-size:9px}.hero button{min-height:46px}.hero .links{margin-top:7px}.hero .links button{font-size:11px}.top-right .pill{display:none}.stamp{right:6%;top:22%;width:60px;height:60px;font-size:8px}.stamp b{font-size:21px}.titlecourt{display:none}.titlefoot{left:7%;bottom:15px}.panel{padding:24px;max-height:92vh}.panel h2{font-size:32px}.panel p{font-size:14px}.row{font-size:13px;gap:10px}.row input[type=range]{width:120px}.row output{min-width:35px}.helpgrid{grid-template-columns:1fr;gap:7px}.helpgrid p{font-size:12px}.scorebar{min-width:240px;top:14px}.team{padding:7px 10px}.team .pts{font-size:28px}.team b{font-size:10px}.team small{font-size:8px}.hud-title{top:80px;left:15px}.hud-title small{font-size:8px}.menu-btn{right:12px;top:17px;font-size:0;min-width:40px;min-height:36px}.menu-btn:after{content:'\"'Ⅱ';font-size:15px}.hud-foot{bottom:15px}.controls{font-size:8px;padding:7px}.meters{padding:9px;gap:10px}.meter{width:50px}.meter small{font-size:7px}#centerMsg{font-size:21px;top:27%}.abouttext dl{grid-template-columns:85px 1fr;font-size:11px}.stats{gap:18px}.stats b{font-size:25px}.devgrid{gap:6px}.attract-foot{width:85%}.attract-foot b{font-size:20px}.attract-label{font-size:10px;width:230px;text-align:center}.titlefoot .input-label{display:none}}@media(max-height:650px) and (min-width:600px){.hero{top:16%;width:355px}.hero h1{font-size:68px;margin:15px 0}.hero .tagline{font-size:16px;margin-bottom:15px}.hero button{min-height:44px;padding:9px 14px}.hero .links{margin-top:8px}.titlefoot{bottom:14px}.panel{padding:24px 30px}.panel h2{font-size:32px}.panel .menu-stack{gap:8px;margin-top:14px}.panel .menu-stack button{min-height:43px;padding:8px 15px}.row{margin:13px 0}.topbar{top:18px}}\n</style>\n<script type=\\\"importmap\\\">{\\\"imports\\\":{\\\"three\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\\\",\\\"three/webgpu\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\\\",\\\"three/tsl\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js\\\"}}</script>\n</head><body><canvas id=\\\"scene\\\" aria-label=\\\"Paddle Royale three-dimensional sports court\\\"></canvas><main id=\\\"ui\\\"><div id=\\\"titleScreen\\\"></div><div id=\\\"hud\\\" class=\\\"hidden\\\"></div><div id=\\\"attractUI\\\" class=\\\"hidden\\\"></div><div id=\\\"modal\\\" class=\\\"hidden\\\"></div><div id=\\\"centerMsg\\\" class=\\\"hidden\\\"></div><div id=\\\"toast\\\" class=\\\"hidden\\\" role=\\\"status\\\"></div><button id=\\\"touchpop\\\" class=\\\"hidden\\\">POP\"'!</button><div id=\"debugbadge\" class=\"hidden\">DEV ASSISTS ON</div><div id=\"loading\" class=\"loading\"><div class=\"spinner\"></div><b>PADDLE ROYALE</b><small id=\"loadstatus\">Polishing the paddles…</small></div></main>\n<script>window.addEventListener('\"'error',e=>{const el=document.getElementById('loadstatus');if(el&&\"'!document.getElementById('\"'loading').classList.contains('hidden'))el.textContent='Unable to start: '+e.message});</script>\n<script type=\\\"module\\\">\nimport * as THREE from 'three/webgpu';\nimport RAPIER from 'https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/rapier.mjs';\n//APP_JS\n</script></body></html>\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' Paddle-Royale-Video-Olympics-gpt-6.1-sol-ultra-20261106-011217/network.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' Paddle-Royale-Video-Olympics-gpt-6.1-sol-ultra-20261106-011217/network.js\"","aggregated_output":"/** Paddle Royale: AI Hub shared-world adapter and standalone peer rooms. */\nexport function createNetwork(callbacks = {}) {\n  const cb = Object.assign({onRole(){},onInput(){},onSnapshot(){},onStatus(){},onStart(){},onEnd(){},onTimeUp(){},onLeave(){}}, callbacks);\n  const uniqueId = () => Array.from(crypto.getRandomValues(new Uint8Array(8)), v=>v.toString(16).padStart(2,'0')).join('');\n  const tabId = uniqueId();\n  let state = {active:false,mode:'offline',role:'host',isHost:true,me:0,localSeat:0,server:false,players:[],code:'',connected:false,transport:'none'};\n  let channel=null,peer=null,connection=null,remoteId=null,remoteTab=null,heartbeat=null,joinTimer=null,peerTimer=null,joinDeadline=null,lastSeen=0,generation=0,hubFinished=false,hubEnded=false,lastScores=[0,0],lastInput=0,lastSnapshot=0;\n  const publish = () => cb.onRole({...state});\n  const status = text => cb.onStatus(text,{...state});\n  const peerId = code => 'paddle-royale-v1-'+code.toLowerCase();\n  const clearTimers=()=>{clearInterval(heartbeat);clearInterval(joinTimer);clearTimeout(peerTimer);clearTimeout(joinDeadline);heartbeat=joinTimer=peerTimer=joinDeadline=null;};\n  const cleanStandalone=()=>{\n    generation++;clearTimers();\n    if(channel){channel.close();channel=null;}\n    if(connection){connection.close();connection=null;}\n    if(peer){peer.destroy();peer=null;}\n    remoteId=remoteTab=null;\n  };\n  const notifyLeft=()=>{\n    if(!state.connected)return;\n    state.connected=false;remoteId=remoteTab=null;publish();status(state.isHost?'Guest disconnected. Room remains open.':'Host disconnected. Return to the lobby to reconnect.');cb.onLeave(state.isHost?1:0);\n  };\n  const deliver = (kind,data) => {\n    lastSeen=performance.now();\n    if(kind==='input' && state.isHost)cb.onInput(data,1);\n    else if(kind==='snapshot' && !state.isHost)cb.onSnapshot(data);\n    else if(kind==='start' && !state.isHost)cb.onStart(data,{hub:false,countdownMs:0});\n    else if(kind==='leave')notifyLeft();\n  };\n  const send = (kind,data) => {\n    if(!state.connected)return false;\n    if(state.transport==='local' && channel){channel.postMessage({kind,from:tabId,target:remoteTab,data});return true;}\n    if(connection?.open){connection.send({kind,data});return true;}\n    return false;\n  };\n  const connected = transport => {\n    if(state.connected)return;\n    state.connected=true;state.transport=transport;lastSeen=performance.now();clearInterval(joinTimer);clearTimeout(joinDeadline);\n    publish();status(state.isHost?'Guest connected. Ready for a friendly rivalry.':'Connected. Host chooses when to play.');\n  };\n  function openChannel(code) {\n    if(!('BroadcastChannel' in window))return;\n    channel=new BroadcastChannel('paddle-royale-room-'+code);\n    channel.onmessage=event=>{\n      const packet=event.data;\n      if(!packet || packet.from===tabId || (packet.target && packet.target!==tabId))return;\n      if(packet.kind==='join' && state.isHost){\n        if(state.connected && packet.from!==remoteTab){channel.postMessage({kind:'full',from:tabId,target:packet.from});return;}\n        remoteTab=packet.from;connected('local');channel.postMessage({kind:'joined',from:tabId,target:remoteTab});\n      } else if(packet.kind==='joined' && !state.isHost && (!state.connected || state.transport==='local')){\n        remoteTab=packet.from;connected('local');if(connection){connection.close();connection=null;}if(peer){peer.destroy();peer=null;}\n      } else if(packet.kind==='full' && !state.isHost){status('This room already has two players.');}\n      else if(state.connected && state.transport==='local' && packet.from===remoteTab)deliver(packet.kind,packet.data);\n    };\n    heartbeat=setInterval(()=>{if(state.connected){send('ping',null);if(performance.now()-lastSeen>8500)notifyLeft();}},1500);\n  }\n  let loadingPeer=null;\n  const loadPeer=()=>{\n    if(window.Peer)return Promise.resolve(window.Peer);\n    if(loadingPeer)return loadingPeer;\n    loadingPeer=new Promise((resolve,reject)=>{\n      const tag=document.createElement('script');tag.src='https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js';tag.crossOrigin='anonymous';\n      tag.onload=()=>window.Peer?resolve(window.Peer):reject(new Error('Peer library did not initialize'));\n      tag.onerror=()=>reject(new Error('The internet room service could not be reached'));document.head.appendChild(tag);\n    }).catch(error=>{loadingPeer=null;throw error;});\n    return loadingPeer;\n  };\n  const configureConnection=(conn,token)=>{\n    conn.on('open',()=>{\n      if(token!==generation || (state.connected && state.transport==='local')){conn.close();return;}\n      if(state.connected && connection!==conn){conn.send({kind:'full'});conn.close();return;}\n      connection=conn;remoteId=conn.peer;connected('internet');\n    });\n    conn.on('data',packet=>{\n      if(token!==generation || !packet || (state.transport==='local'))return;\n      if(packet.kind==='full'){status('This room already has two players.');return;}\n      deliver(packet.kind,packet.data);\n    });\n    conn.on('close',()=>{if(token===generation && state.transport==='internet' && connection===conn){connection=null;notifyLeft();}});\n    conn.on('error',()=>{if(token===generation && !state.connected)status('Connection could not be made. Try the room code again.');});\n  };\n  const openPeer=async(hosting,token)=>{\n    try{\n      const Peer=await loadPeer();if(token!==generation || (state.connected && state.transport==='local'))return;\n      peer=new Peer(hosting?peerId(state.code):undefined,{debug:0});\n      peer.on('open',()=>{\n        if(token!==generation)return;\n        if(hosting)status(state.connected?'Guest connected. Ready for a friendly rivalry.':'Room '+state.code+' is open. Share its code.');\n        else if(!state.connected){const conn=peer.connect(peerId(state.code),{reliable:true,serialization:'json'});configureConnection(conn,token);}\n      });\n      peer.on('connection',conn=>configureConnection(conn,token));\n      peer.on('error',error=>{\n        if(token!==generation)return;\n        if(state.connected && state.transport==='local')return;\n        if(error.type==='peer-unavailable')status('Room not found. Check its code and that the host is still here.');\n        else if(error.type==='unavailable-id')status('That code is busy. Create another room.');\n        else status(hosting?'Internet rooms unavailable. This code still works between tabs on this device.':'Internet connection unavailable. Check the code or try again.');\n      });\n    }catch(error){if(token===generation && !state.connected)status(error.message+'. Same-device rooms still work.');}\n  };\n  const roomCode = () => {\n    const alphabet='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';const bytes=crypto.getRandomValues(new Uint8Array(6));return Array.from(bytes,v=>alphabet[v%alphabet.length]).join('');\n  };\n  const api={\n    get info(){return {...state};},\n    async connectHub(){\n      if(!window.AIHub?.active)return null;\n      const hub=await AIHub.connect({mode:'shared-world',seats:[2,2]});if(!hub)return null;\n      state={active:true,mode:'hub',role:hub.isHost?'host':'guest',isHost:hub.isHost,me:hub.me,localSeat:hub.server?null:hub.players.findIndex(p=>p.id===hub.me),server:!!hub.server,players:hub.players,code:'',connected:true,transport:'hub'};\n      hubFinished=hubEnded=false;publish();status('Waiting for the AI Hub round.');\n      AIHub.on('start',event=>{if(hubEnded)return;cb.onStart({mode:'versus',court:0},{hub:true,countdownMs:Number(event?.in)||3000});});\n      AIHub.on('message',(packet,from)=>{\n        if(hubEnded || !packet || typeof packet!=='object')return;\n        if(state.isHost && packet.kind==='input'){\n          const seat=state.players.findIndex(p=>p.id===from);if(seat>=0)cb.onInput(packet.data,seat);\n        } else if(!state.isHost && from===AIHub.host && packet.kind==='snapshot')cb.onSnapshot(packet.data);\n      });\n      AIHub.on('leave',event=>{const seat=state.players.findIndex(p=>p.id===event.id);if(seat>=0)cb.onLeave(seat);});\n      AIHub.on('time-up',()=>{if(hubEnded)return;cb.onTimeUp();if(state.isHost && !hubFinished)api.finish(lastScores);});\n      AIHub.on('end',event=>{hubEnded=true;cb.onEnd(event?.reason||'finished');status('AI Hub round complete.');});\n      return {...state};\n    },\n    ready(){if(state.mode==='hub')AIHub.ready();},\n    host(){\n      if(window.AIHub?.active)return '';\n      cleanStandalone();state={active:true,mode:'standalone',role:'host',isHost:true,me:0,localSeat:0,server:false,players:[{id:0,name:'CORAL'},{id:1,name:'MINT'}],code:roomCode(),connected:false,transport:'none'};\n      openChannel(state.code);publish();status('Room '+state.code+' created. Opening internet connection…');openPeer(true,generation);return state.code;\n    },\n    join(code){\n      if(window.AIHub?.active)return false;\n      code=String(code||'').toUpperCase().replace(/[^A-Z0-9]/g,'');\n      if(code.length!==6){status('Room codes have six letters and numbers.');return false;}\n      cleanStandalone();state={active:true,mode:'standalone',role:'guest',isHost:false,me:1,localSeat:1,server:false,players:[{id:0,name:'CORAL'},{id:1,name:'MINT'}],code,connected:false,transport:'none'};\n      openChannel(code);publish();status('Looking for room '+code+'…');\n      const knock=()=>channel?.postMessage({kind:'join',from:tabId});knock();joinTimer=setInterval(knock,250);\n      const token=generation;peerTimer=setTimeout(()=>openPeer(false,token),650);\n      joinDeadline=setTimeout(()=>{if(token===generation && !state.connected)status('Could not connect. Check the room code and try again.');clearInterval(joinTimer);},22000);return true;\n    },\n    start(config){if(state.mode==='hub' || !state.isHost || !state.connected)return false;send('start',config);cb.onStart(config,{hub:false,countdownMs:0});return true;},\n    sendInput(input){\n      if(hubEnded)return false;\n      if(state.mode==='hub'){\n        if(state.isHost || state.localSeat===null)return false;\n        const now=performance.now();if(now-lastInput<65)return false;lastInput=now;\n        return AIHub.send({kind:'input',data:input},{to:AIHub.host,reliable:false});\n      }\n      return send('input',input);\n    },\n    sendSnapshot(snapshot){\n      if(hubEnded || !state.isHost)return false;\n      if(snapshot?.scores)lastScores=snapshot.scores;\n      if(state.mode==='hub'){\n        const now=performance.now();if(now-lastSnapshot<65)return false;lastSnapshot=now;\n        return AIHub.send({kind:'snapshot',data:snapshot},{reliable:false});\n      }\n      return send('snapshot',snapshot);\n    },\n    finish(scores=[0,0]){\n      if(state.mode!=='hub' || !state.isHost || hubFinished || hubEnded)return false;\n      const entries=state.players.map((p,i)=>({id:p.id,score:Number(scores[i])||0})).sort((a,b)=>b.score-a.score);\n","exit_code":0,"status":"completed"}}
