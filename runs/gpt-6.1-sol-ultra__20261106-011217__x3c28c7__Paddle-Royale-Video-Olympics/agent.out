{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,55p' Paddle-Royale-Video-Olympics-gpt-6.1-sol-ultra-20261106-011217/arena.js; sed -n '1,100p' Paddle-Royale-Video-Olympics-gpt-6.1-sol-ultra-20261106-011217/audio.js\"","aggregated_output":"export async function createArena(THREE, canvas) {\n  const C={ink:0x183b3c,paper:0xf5edce,white:0xfff9e6,coral:0xf16b50,mint:0x64bea5,gold:0xf2bc44,muted:0x9aab91,deep:0x2f6257,blue:0x6ca0b2};\n  const renderer=new THREE.WebGPURenderer({canvas,antialias:true,alpha:false,powerPreference:'high-performance'});\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));\n  renderer.setSize(innerWidth,innerHeight);\n  renderer.setClearColor(C.paper,1);\n  renderer.shadowMap.enabled=true;\n  renderer.shadowMap.type=THREE.PCFSoftShadowMap;\n  renderer.outputColorSpace=THREE.SRGBColorSpace;\n  renderer.toneMapping=THREE.ACESFilmicToneMapping;\n  renderer.toneMappingExposure=1.05;\n  await renderer.init();\n  const scene=new THREE.Scene();\n  scene.background=new THREE.Color(C.paper);\n  scene.fog=new THREE.Fog(C.paper,45,100);\n  const camera=new THREE.OrthographicCamera(-20,20,12,-12,.1,150);\n  camera.position.set(0,24,19);camera.lookAt(0,0,0);\n  const hemi=new THREE.HemisphereLight(0xfffbe8,0x86a68e,1.75);scene.add(hemi);\n  const sun=new THREE.DirectionalLight(0xfff0cf,2.35);sun.position.set(-9,22,6);sun.castShadow=true;\n  sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-19;sun.shadow.camera.right=19;sun.shadow.camera.top=16;sun.shadow.camera.bottom=-16;sun.shadow.normalBias=.05;sun.shadow.bias=-.0003;scene.add(sun);\n  const fill=new THREE.DirectionalLight(0xc6e5d8,.7);fill.position.set(10,5,-8);scene.add(fill);\n  const materials=new Map();\n  function mat(color,extra={}) { const key=String(color)+JSON.stringify(extra);if(!materials.has(key))materials.set(key,new THREE.MeshStandardMaterial({color,roughness:1,metalness:0,flatShading:true,...extra}));return materials.get(key); }\n  const inkMat=new THREE.MeshBasicMaterial({color:C.ink,side:THREE.BackSide});\n  const softInk=new THREE.MeshBasicMaterial({color:C.ink,transparent:true,opacity:.12,depthWrite:false});\n  const gBox=new THREE.BoxGeometry(1,1,1),gBall=new THREE.IcosahedronGeometry(1,2),gDisc=new THREE.CylinderGeometry(1,1,1,24),gHead=new THREE.IcosahedronGeometry(1,1);\n  function mesh(geometry,color,parent=scene,outline=.025){ const m=new THREE.Mesh(geometry,mat(color));m.castShadow=true;m.receiveShadow=true;parent.add(m);if(outline){const o=new THREE.Mesh(geometry,inkMat);o.scale.setScalar(1+outline);m.add(o);}return m; }\n  function box(x,y,z,w,h,d,color,parent=scene,outline=.025) {const m=mesh(gBox,color,parent,outline);m.position.set(x,y,z);m.scale.set(w,h,d);return m;}\n  function sphere(x,y,z,r,color,parent=scene,geometry=gBall){const m=mesh(geometry,color,parent,.04);m.position.set(x,y,z);m.scale.setScalar(r);return m;}\n  function disc(x,y,z,r,h,color,parent=scene,outline=.025){const m=mesh(gDisc,color,parent,outline);m.position.set(x,y,z);m.scale.set(r,h,r);return m;}\n  function line(x,z,w,d,color=C.ink,y=.091,parent=scene){return box(x,y,z,w,.014,d,color,parent,0);}\n  function textTexture(text,width=1024,height=128,bg=null,fg='#183b3c',size=72){const c=document.createElement('canvas');c.width=width;c.height=height;const cx=c.getContext('2d');if(bg){cx.fillStyle=bg;cx.fillRect(0,0,width,height);}cx.fillStyle=fg;cx.font=`900 ${size}px \"Arial Black\",Arial,sans-serif`;cx.textAlign='center';cx.textBaseline='middle';cx.fillText(text,width/2,height/2);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;t.anisotropy=4;return t;}\n  function label(text,x,y,z,w,h,{rotation=0,color='#183b3c',bg=null,size=72}={}){const height=192,width=Math.round(height*w/h);const fitSize=Math.min(height*.72,width/(text.length*.63));const tex=textTexture(text,width,height,bg,color,fitSize);const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshBasicMaterial({map:tex,transparent:!bg,depthWrite:!!bg}));m.position.set(x,y,z);m.rotation.x=rotation;scene.add(m);return m;}\n  // A miniature arena cut from layers of painted wood and heavy ink.\n  const backdrop=box(0,-1.55,0,300,.12,300,C.paper,scene,0);backdrop.receiveShadow=true;\n  box(0,-.95,0,27,.7,19.1,C.ink,scene,.006);\n  box(0,-.53,0,26.6,.28,18.7,C.gold,scene,.008);\n  box(0,-.27,0,26.15,.28,18.25,C.white,scene,.008);\n  box(0,-.09,0,22.5,.24,13.8,C.ink,scene,.006);\n  const field=box(0,.035,0,20.2,.11,12.1,C.paper,scene,0);\n  // Paper-print striping, borders, and scoring marks.\n  const stripes=[];\n  for(let i=0;i<10;i++){const m=line(-9+i*2,0,1.98,11.9,i%2?0xefe5c1:0xf5edce,.098);stripes.push(m);}\n  line(0,-6,20.3,.11);line(0,6,20.3,.11);line(-10,0,.11,12);line(10,0,.11,12);\n  for(let z=-5.6;z<6;z+=.7)line(0,z,.08,.33,C.ink,.113);\n  const centerCircle=new THREE.Mesh(new THREE.RingGeometry(1.59,1.63,64),mat(C.ink));centerCircle.rotation.x=-Math.PI/2;centerCircle.position.y=.117;scene.add(centerCircle);\n  disc(0,.12,0,.13,.016,C.ink,scene,0);\n  for(const side of [-1,1]){\n    line(side*7.8,0,.045,11.8,side<0?C.coral:C.mint,.116);\n    for(let z=-5;z<=5;z+=1)line(side*9.6,z,.18,.035,C.ink,.12);\n    const p=label(side<0?'01':'02',side*7.45,.14,4.7,1.5,.35,{rotation:-Math.PI/2,size:82});\n    // Colored out-of-bounds aprons.\n    box(side*11.15,.015,0,1.85,.15,12.2,side<0?C.coral:C.mint,scene,.008);\n    for(let z=-5.5;z<6;z+=1.1){const hatch=line(side*11.2,z,1.2,.04,C.ink,.112);hatch.rotation.y=-.32*side;}\n  }\n/** Paddle Royale — all sound is synthesized here. No samples, files or speech service. */\nexport class AudioEngine {\n  constructor(options = {}) {\n    this.ctx = options.context || null;\n    this.musicVolume = 0.1;\n    this.sfxVolume = 0.7;\n    this.muted = false;\n    this.enabled = false;\n    this.musicEnabled = true;\n    this.step = 0;\n    this.nextBeat = 0;\n    this.tempo = 116;\n    this.intensity = 0;\n    this.nodes = 0;\n    this.events = { music: 0, sfx: 0, voice: 0 };\n    this.lastVoice = -100;\n    this.seed = 0x197707;\n    if (this.ctx) this._init();\n  }\n\n  _init() {\n    if (this.master) return;\n    const c = this.ctx;\n    this.master = c.createGain();\n    this.master.gain.value = this.muted ? 0 : 0.78;\n    this.compressor = c.createDynamicsCompressor();\n    this.compressor.threshold.value = -12;\n    this.compressor.knee.value = 15;\n    this.compressor.ratio.value = 5;\n    this.compressor.attack.value = 0.003;\n    this.compressor.release.value = 0.18;\n    this.musicBus = c.createGain();\n    this.musicBus.gain.value = this.musicVolume;\n    this.sfxBus = c.createGain();\n    this.sfxBus.gain.value = this.sfxVolume;\n    this.voiceBus = c.createGain();\n    this.voiceBus.gain.value = this.sfxVolume * 0.65;\n    this.analyser = c.createAnalyser();\n    this.analyser.fftSize = 512;\n    this.musicBus.connect(this.master);\n    this.sfxBus.connect(this.master);\n    this.voiceBus.connect(this.master);\n    this.master.connect(this.compressor);\n    this.compressor.connect(this.analyser);\n    this.analyser.connect(c.destination);\n    const n = Math.floor(c.sampleRate * 1.1);\n    this.noise = c.createBuffer(1, n, c.sampleRate);\n    const a = this.noise.getChannelData(0);\n    for (let i = 0; i < n; i++) a[i] = this._random() * 2 - 1;\n    this.nextBeat = c.currentTime + 0.04;\n    this.enabled = true;\n  }\n\n  _random() {\n    this.seed ^= this.seed << 13;\n    this.seed ^= this.seed >>> 17;\n    this.seed ^= this.seed << 5;\n    return (this.seed >>> 0) / 4294967296;\n  }\n\n  async resume() {\n    if (!this.ctx) {\n      const AC = globalThis.AudioContext || globalThis.webkitAudioContext;\n      if (!AC) return false;\n      this.ctx = new AC();\n    }\n    this._init();\n    if (this.ctx.state === 'suspended' && this.ctx.resume) {\n      try { await this.ctx.resume(); } catch (_) { return false; }\n    }\n    this.enabled = true;\n    return this.ctx.state !== 'closed';\n  }\n\n  setMusic(value) {\n    this.musicVolume = Math.max(0, Math.min(1, Number(value) || 0));\n    if (this.musicBus) this.musicBus.gain.setTargetAtTime(this.musicVolume, this.ctx.currentTime, 0.04);\n  }\n\n  setSfx(value) {\n    this.sfxVolume = Math.max(0, Math.min(1, Number(value) || 0));\n    if (this.sfxBus) {\n      this.sfxBus.gain.setTargetAtTime(this.sfxVolume, this.ctx.currentTime, 0.025);\n      this.voiceBus.gain.setTargetAtTime(this.sfxVolume * 0.65, this.ctx.currentTime, 0.025);\n    }\n  }\n\n  setMuted(value) {\n    this.muted = !!value;\n    if (this.master) this.master.gain.setTargetAtTime(this.muted ? 0 : 0.78, this.ctx.currentTime, 0.025);\n  }\n\n  _tone(freq, time, duration, gain, type = 'triangle', bus = this.sfxBus, endFreq = null) {\n    const c = this.ctx;\n    const o = c.createOscillator();\n    const v = c.createGain();\n    o.type = type;\n    o.frequency.setValueAtTime(Math.max(20, freq), time);\n    if (endFreq != null) o.frequency.exponentialRampToValueAtTime(Math.max(20, endFreq), time + duration);\n    v.gain.setValueAtTime(0, time);\n","exit_code":0,"status":"completed"}}
