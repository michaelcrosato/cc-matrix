{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > Paddle-Royale-Video-Olympics-gpt-6.1-sol-ultra-20261106-011217/game.js <<'EOF'\nconst \"'$=id=>document.getElementById(id), clamp=(n,a,b)=>Math.max(a,Math.min(b,n));\nconst COURTS=[{id:'\"'rally',name:'Classic Rally',short:'The original good time.',desc:'Open court. Pure paddle play. Find the gap and keep it moving.',tip:'Meet the ball off-center to send it at an angle.',color:'#ed7055'},{id:'bank',name:'Bankshot',short:'A little bounce of genius.',desc:'Two brass bumpers change every angle. Bank a shot to build your style score.',tip:'Brass bumpers ricochet the ball. Keep an eye on the second bounce.',color:'#ecc35c'},{id:'goal',name:'Goal Rush',short:'Small goal. Big ambitions.',desc:'Beat the keeper through the little goal. The back walls keep wild shots alive.',tip:'Only the mint and coral goal mouths score. Aim for the middle.',color:'#6bb6a4'}];\nconst DEFAULTS={ballSpeed:9.2,paddleSpeed:7.8,paddleSize:1.05,aiSkill:.7,chargeRate:.8,targetScore:5};\nconst params={...DEFAULTS};\nconst defaultSettings={music:.1,sfx:.7,glyphs:'ps',reduceMotion:false,muted:false};\nlet settings={...defaultSettings},best={rally:0,cups:0,gold:0};\ntry{settings={...settings,...JSON.parse(localStorage.getItem('paddle-royale-settings')||'{}')};best={...best,...JSON.parse(localStorage.getItem('paddle-royale-best')||'{}')}}catch{}\nconst save=()=>{try{localStorage.setItem('paddle-royale-settings',JSON.stringify(settings));localStorage.setItem('paddle-royale-best',JSON.stringify(best))}catch{}};\nconst audio=new AudioEngine();audio.setMusic(settings.music);audio.setSfx(settings.sfx);audio.setMuted(settings.muted);\nlet arena,world,ballBody,ballCollider,paddleBodies=[],paddleColliders=[],bankBodies=[],endBodies=[];\nlet focusIndex=0,screen='title',modalReturn='title',lastInput='keyboard',lastActivity=performance.now(),toastUntil=0,centerUntil=0,frameTime=0,accumulator=0,netTimer=0,renderTime=0,uiTimer=0,hubHoldUntil=0,netStatus='',suppressClick=false;\nlet keys=new Set(),mouse={active:false,z:0,aim:0,charge:false,dash:false},touches=new Map(),touchAxis=0,touchAim=0,touchDash=false,touchActive=false;\nlet padPrev=[],padAxesPrev=0,padNavAt=0,lastChargeSound=0,uiPrev='',attractElapsed=0,attractCourtAt=0;\nconst remoteInputs=[{move:0,aim:0,charge:false,dash:false},{move:0,aim:0,charge:false,dash:false}];\nconst G={phase:'title',mode:'solo',court:0,scores:[0,0],paddles:[{z:0,v:0,charge:0,dash:0,cooldown:0,aim:0},{z:0,v:0,charge:0,dash:0,cooldown:0,aim:0}],ball:{x:0,z:0,vx:0,vz:0},trail:[],particles:[],rally:0,time:0,serve:1,serveTimer:1.7,pointPause:0,winner:null,attract:false,wins:[],stats:{bestRally:0,power:0,banks:0,dashes:0,points:0},flash:0,perfect:false,debug:false};\nlet bankCooldown=0,lastWallAt=-10,receivedPhase=null;\nconst network=createNetwork({\n onRole:()=>{if(screen==='room')renderRoom()},\n onStatus:text=>{netStatus=text;const el=\"'$('\"'roomstatus');if(el)el.textContent=text;},\n onInput:(input,seat)=>{if(seat>=0&&seat<2)remoteInputs[seat]={move:clamp(Number(input?.move)||0,-1,1),aim:clamp(Number(input?.aim)||0,-1,1),charge:\"'!!input?.charge,dash:!!input?.dash};},\n onSnapshot:snapshot=>{if(network.info.isHost||!snapshot)return;applySnapshot(snapshot)},\n onStart:(config,context)=>{hubHoldUntil=context.hub?performance.now()+context.countdownMs:0;startGame({mode:'\"'online',court:config.court||0});},\n onLeave:()=>{if(G.mode==='online'&&['play','serve','pause'].includes(G.phase)){G.phase='pause';showToast('Your rival has left the court.',6000);openModal('disconnected')}},\n onTimeUp:()=>{if(network.info.isHost){G.winner=G.scores[0]===G.scores[1]?null:G.scores[0]>G.scores[1]?0:1;network.finish(G.scores);G.phase='result';showResult()}},\n onEnd:reason=>{if(G.mode==='online'){G.phase='result';showResult(reason)}},\n});\nfunction snapshot(){return{phase:G.phase,court:G.court,mode:G.mode,scores:G.scores,ball:G.ball,paddles:G.paddles,trail:G.trail.slice(-16),particles:G.particles.slice(0,12),rally:G.rally,time:G.time,serve:G.serve,serveTimer:G.serveTimer,winner:G.winner,stats:G.stats,wins:G.wins,flash:G.flash}}\nfunction applySnapshot(s){\n const old=G.phase,oldScores=G.scores.join();for(const k of ['phase','court','scores','ball','paddles','trail','particles','rally','time','serve','serveTimer','winner','stats','wins','flash'])if(s[k]\"'!==undefined)G[k]=s[k];G.mode='\"'online';\n if(oldScores\"'!==G.scores.join()){audio.play('\"'goal');showToast(G.scores[0]>Number(oldScores.split(',')[0])?'CORAL SCORES\"'!'\"':'MINT SCORES\"'!'\"',1800)}\n if(G.phase==='result'&&old\"'!=='\"'result')showResult();else if(['play','serve'].includes(G.phase)&&old==='result'){screen='game';\"'$('\"'modal').classList.add('hidden');\"'$('\"'hud').classList.remove('hidden')}\n if(G.phase==='pause'&&old\"'!=='\"'pause'){openModal('onlinepaused')}else if(['play','serve'].includes(G.phase)&&screen==='onlinepaused'){screen='game';\"'$('\"'modal').classList.add('hidden')}\n}\nfunction setInput(type){if(lastInput\"'!==type){lastInput=type;document.body.classList.toggle('\"'touch-mode',type==='touch');updatePrompts()}lastActivity=performance.now();audio.resume().catch(()=>{});if(G.attract){exitAttract();return true}return false}\nfunction glyph(action){const ps={accept:'×',charge:'×',dash:'R1',pause:'OPTIONS',back:'○',move:'L',aim:'L ← →'},xb={accept:'A',charge:'A',dash:'RB',pause:'MENU',back:'B',move:'L',aim:'L ← →'};if(lastInput==='gamepad')return(settings.glyphs==='xbox'?xb:ps)[action];return{accept:'ENTER',charge:mouse.active?'LMB':'SPACE',dash:mouse.active?'RMB':'SHIFT',pause:'ESC',back:'ESC',move:mouse.active?'MOUSE':'W S / ↑ ↓',aim:mouse.active?'MOUSE':'A D'}[action]}\nfunction showToast(text,ms=2300){\"'$('\"'toast').textContent=text;\"'$('\"'toast').classList.remove('hidden');toastUntil=performance.now()+ms}\nfunction center(text,ms=1500){\"'$('\"'centerMsg').textContent=text;\"'$('\"'centerMsg').classList.remove('hidden');centerUntil=performance.now()+ms}\nfunction vibrate(strength=.2){const pad=navigator.getGamepads?.()[0];try{pad?.vibrationActuator?.playEffect('dual-rumble',{duration:80,strongMagnitude:strength,weakMagnitude:strength*.5}).catch(()=>{})}catch{}}\nfunction updatePrompts(){if(\"'$('\"'controlshint'))\"'$('\"'controlshint').innerHTML=\"'`<span class=\"controlkey\">${glyph('\"'move')}</span> MOVE &nbsp; <span class=\\\"controlkey\\\">\"'${glyph('\"'charge')}</span> HOLD TO POWER &nbsp; <span class=\\\"controlkey\\\">\"'${glyph('\"'dash')}</span> DASH\"'`;if($('\"'inputlabel'))\"'$('\"'inputlabel').textContent=lastInput==='gamepad'?\"'`${glyph('\"'accept')} SELECT · \"'${glyph('\"'back')} BACK\"'`:lastInput==='\"'touch'?'TAP TO PLAY':'ARROWS + ENTER, OR CLICK TO PLAY'}\nfunction focusable(){const root=\"'!$('\"'modal').classList.contains('hidden')?\"'$('\"'modal'):\"'$('\"'titleScreen');return [...root.querySelectorAll('button:not(:disabled),input')].filter(el=>el.offsetParent\"'!==null)}\nfunction focusAt(index){const list=focusable();if(!list.length)return;focusIndex=(index+list.length)%list.length;for(const e of document.querySelectorAll('\"'.focused'))e.classList.remove('focused');list[focusIndex].classList.add('focused');if(lastInput==='gamepad')list[focusIndex].scrollIntoView({block:'nearest'});}\nfunction focusMove(delta){audio.play('menu',.45);focusAt(focusIndex+delta)}\nfunction confirmFocus(){const el=focusable()[focusIndex];if(el?.tagName==='BUTTON')el.click();else if(el)el.focus()}\nfunction adjustFocus(delta){const el=focusable()[focusIndex];if(el?.type==='range'){el.value=clamp(Number(el.value)+Number(el.step||1)*delta,Number(el.min),Number(el.max));el.dispatchEvent(new Event('input',{bubbles:true}))}else focusMove(delta)}\nfunction titleMarkup(){return \"'`<header class=\"topbar\"><div class=\"brand\"><i></i>THE ROYALE SPORTS CLUB</div><div class=\"top-right\"><span class=\"pill\">1–2 PLAYERS</span><span>VOL. 01 / PADDLE SPORTS</span></div></header><section class=\"hero\"><div class=\"eyebrow\">SMALL COURT. GRAND OCCASION.</div><h1>PADDLE<br><span>ROYALE</span></h1><p class=\"tagline\">A little court.<br>A lot of glory.</p><button class=\"primary\" data-action=\"cup\">Play the Royale Cup <span class=\"arrow\">↗</span></button><div class=\"split\"><button data-action=\"courts\">Pick a court <span class=\"arrow\">→</span></button><button class=\"secondary\" data-action=\"together\">Play together <span class=\"arrow\">↗</span></button></div><div class=\"links\"><button class=\"quiet\" data-action=\"how\">How to play</button><button class=\"quiet\" data-action=\"settings\">Settings</button><button class=\"quiet\" data-action=\"about\">About</button></div></section><div class=\"stamp\">THE CLASS OF<b>1977</b>REMIXED</div><div class=\"titlecourt\"><b>Good rallies. Great company.</b>THREE EVENTS · ONE TINY CROWN</div><footer class=\"titlefoot\">PADDLE SPORT, WITH A TWIST.<br><span class=\"input-label\" id=\"inputlabel\">ARROWS + ENTER, OR CLICK TO PLAY</span></footer>`}\nfunction showTitle(){if(network.info.mode==='\"'hub')return;network.disconnect();G.phase='title';G.attract=false;G.mode='solo';screen='title';G.winner=null;G.scores=[0,0];G.trail=[];G.particles=[];keys.clear();mouse.active=false;mouse.charge=false;\"'$('\"'titleScreen').innerHTML=titleMarkup();\"'$('\"'titleScreen').classList.remove('hidden');\"'$('\"'hud').classList.add('hidden');\"'$('\"'attractUI').classList.add('hidden');\"'$('\"'modal').classList.add('hidden');\"'$('\"'centerMsg').classList.add('hidden');\"'$('\"'touchpop').classList.add('hidden');\"'$('\"'debugbadge').classList.add('hidden');lastActivity=performance.now();focusAt(0);updatePrompts()}\nfunction modalShell(title,body,{wide=false,kicker='THE ROYALE SPORTS CLUB',back='Back',backAction='back'}={}){return \"'`<div class=\"scrim\"><section class=\"panel ${wide?'\"'wide':''}\\\"><div class=\\\"eyebrow\\\">\"'${kicker}</div><h2>${title}</h2>${body}${back?`<button class=\"quiet back\" data-action=\"${backAction}\">← ${back}</button>`:'\"''}</section></div>\"'`}\nfunction openModal(name,returnTo){if(returnTo)modalReturn=returnTo;screen=name;let html='\"'';\n if(name==='courts'){html=modalShell('Choose your court.',\"'`<p>One match. First to ${params.targetScore}. Make it a good one.</p><div class=\"court-cards\">${COURTS.map((c,i)=>`<button class=\"courtcard\" data-action=\"quick-${i}\"><span class=\"number\">0${i+1}</span><span><strong>${c.name}</strong><small>${c.desc}</small></span></button>`).join('\"'')}</div>\"'`)}\n if(name==='\"'together')html=modalShell('Rivalry looks good on you.',\"'`<p>Bring a friend. Leave with bragging rights.</p><div class=\"menu-stack\"><button class=\"primary\" data-action=\"local\">Same couch · 2 players <span class=\"arrow\">↗</span></button><button data-action=\"host\">Create an online room</button><button data-action=\"join\">Join with a room code</button></div><p class=\"hint\">Local: two pads, or W/S + Space/Shift against ↑/↓ + Enter/Right Shift. One pad plays Coral; the keyboard plays Mint.</p>`)\n if(name==='\"'join')html=modalShell('Got an invitation?',\"'`<p>Enter the six-character room code from your rival.</p><input class=\"roominput\" id=\"roominput\" maxlength=\"6\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"ABC123\" aria-label=\"Room code\"><div class=\"menu-stack\"><button class=\"primary\" data-action=\"connect\">Join the court →</button></div><p class=\"status\" id=\"roomstatus\">Internet rooms use a public connection broker. The host keeps this page open.</p>`)\n if(name==='\"'how')html=modalShell('Keep the good times rallying.',\"'`<div class=\"helpgrid\"><article><b>01 / Meet the ball</b><p>${lastInput==='\"'gamepad'?'Left stick':lastInput==='touch'?'Drag an invisible stick on either side of the screen':'W/S, ↑/↓, or move the mouse'} to move. A return near the edge of your paddle flies at a sharper angle.</p></article><article><b>02 / Make a power play</b><p>Hold \"'${glyph('\"'charge')} to charge. Meet the ball with a full meter for a power shot. \"'${lastInput==='\"'touch'?'Power is assisted on touch.':'A/D or the stick’s horizontal axis adds aim.'}</p></article><article><b>03 / Close the gap</b><p>\"'${glyph('\"'dash')} to dash in your movement direction. It recharges in 1.6 seconds. \"'${lastInput==='\"'touch'?'Tap with a second finger to dash.':''}</p></article><article><b>04 / Claim the crown</b><p>First to \"'${params.targetScore} wins the match. Play all three courts in the Royale Cup. Three victories earn gold.</p></article></div><p class=\"hint\">Mouse: position to move and aim, hold left click to power, right click to dash. Touch: drag to move, automatic power, tap with a second finger to dash. ${glyph('\"'pause')} pauses.</p>\"'`,{wide:true});\n if(name==='\"'settings')html=modalShell('Set your own tempo.',\"'`<div class=\"row\"><label for=\"music\">Music</label><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"${Math.round(settings.music*100)}\" data-setting=\"music\"><output>${Math.round(settings.music*100)}%</output></div><div class=\"row\"><label for=\"sfx\">Effects & voices</label><input id=\"sfx\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"${Math.round(settings.sfx*100)}\" data-setting=\"sfx\"><output>${Math.round(settings.sfx*100)}%</output></div><div class=\"row\"><label>Controller symbols</label><button data-action=\"glyphs\">${settings.glyphs==='\"'ps'?'PlayStation · × ○':'Xbox · A B'}</button></div><div class=\\\"row\\\"><label>Reduced motion</label><button data-action=\\\"motion\\\">\"'${settings.reduceMotion?'\"'On':'Off'}</button></div><div class=\\\"row\\\"><label>Sound</label><button data-action=\\\"mute\\\">\"'${settings.muted?'\"'Muted':'On'}</button></div><p class=\\\"hint\\\">Music starts at 10%. Settings save on this device. WebGPU is preferred; WebGL2 is used when unavailable.</p>\"'`)\n if(name==='\"'pause')html=modalShell('Take a breather.',\"'`<p>${COURTS[G.court].name} · First to ${params.targetScore}. The court will wait.</p><div class=\"menu-stack\"><button class=\"primary\" data-action=\"resume\">Back to the rally →</button><button data-action=\"settings-pause\">Settings</button><button data-action=\"dev\">Dev mode & balance</button><button data-action=\"restart\">Restart match</button><button data-action=\"quit\">Return to clubhouse</button></div>`,{back:false,kicker:'\"'TIME OUT'});\n if(name==='onlinepaused')html=modalShell('Time out on the court.',\"'`<p>The host paused the match. We’ll be right back.</p><p class=\"hint\">The host controls match flow so both courts stay in sync.</p>`,{back:false});\n if(name==='\"'disconnected')html=modalShell('Your rival stepped away.',\"'`<p>The connection closed. Head back to the clubhouse and start a fresh room.</p><div class=\"menu-stack\"><button class=\"primary\" data-action=\"quit\">Return to clubhouse →</button></div>`,{back:false});\n if(name==='\"'dev')html=devMarkup();\n if(name==='about')html=aboutMarkup('source');\n \"'$('\"'modal').innerHTML=html;\"'$('\"'modal').classList.remove('hidden');focusAt(0);\n}\nfunction renderRoom(){screen='room';\"'$('\"'modal').innerHTML=modalShell('A court for two.',\"'`<p>${network.info.isHost?'\"'Share this code. Your rival can join from another browser or device.':'You’re on the mint team. The host chooses when to begin.'}</p><div class=\\\"roomcode\\\" id=\\\"roomcode\\\"></div><p class=\\\"status\\\" id=\\\"roomstatus\\\"></p><div class=\\\"menu-stack\\\">\"'${network.info.isHost?`<button class=\"primary\" data-action=\"online-start\" ${network.info.connected?'\"'':'disabled'}>Start match →</button><button data-action=\\\"room-court\\\">Court: \"'${COURTS[G.court].name}</button>`:'\"'<button disabled>Waiting for the host…</button>'}<button data-action=\\\"copy-code\\\">Copy room code</button></div><p class=\\\"hint\\\">Room stays open while the host is here. A public broker connects internet players; some networks may block direct connections.</p>\"'`,{back:'\"'Leave room',backAction:'quit'});\"'$('\"'roomcode').textContent=network.info.code;\"'$('\"'roomstatus').textContent=netStatus;\"'$('\"'modal').classList.remove('hidden');focusAt(0)}\nfunction devMarkup(){return modalShell('Tune the good times.',\"'`<p class=\"hint\">Changes apply live to this match. These tools are available in solo and local play.</p>${[['\"'ballSpeed','Ball speed',5,18,.1],['paddleSpeed','Paddle speed',4,15,.1],['paddleSize','Paddle reach',.6,1.8,.05],['aiSkill','Opponent skill',.1,1,.05],['chargeRate','Charge rate',.3,2,.1],['targetScore','Winning score',1,11,1]].map(([key,label,min,max,step])=>\"'`<div class=\"row\"><label for=\"dev-${key}\">${label}</label><input id=\"dev-${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${params[key]}\" data-param=\"${key}\"><output>${key==='\"'aiSkill'?Math.round(params[key]*100)+'%':Number(params[key]).toFixed(step===1?0:1)}</output></div>\"'`).join('\"'')}<div class=\\\"devgrid\\\"><button data-action=\\\"dev-point-0\\\">Point to Coral</button><button data-action=\\\"dev-point-1\\\">Point to Mint</button><button data-action=\\\"dev-serve\\\">Reset rally</button><button data-action=\\\"dev-court\\\">Next court</button><button data-action=\\\"dev-auto\\\">AI pilot: \"'${G.perfect?'\"'ON':'OFF'}</button><button data-action=\\\"dev-debug\\\">Physics guides: \"'${G.debug?'\"'ON':'OFF'}</button><button data-action=\\\"dev-reset\\\">Reset defaults</button><button class=\\\"primary\\\" data-action=\\\"resume\\\">Return to game →</button></div>\"'`,{back:'\"'Pause menu'});}\nfunction aboutMarkup(tab){const data=CREDITS;let body='';if(tab==='source')body=\"'`<dl>${Object.entries(data.sourceInformation).map(([key,value])=>`<dt>${({artDirection:'\"'Art direction',source:'Source',genre:'Genre',perspective:'Perspective',tech:'Tech',online:'Online',usage:'Usage'}[key]||key[0].toUpperCase()+key.slice(1))}</dt><dd>\"'${value}</dd>`).join('\"'')}</dl><p>Created with procedural geometry, code-written music, and a fondness for the friendly paddle-sports variety of Video Olympics (1977). This is an original tribute, unaffiliated with the original publishers.</p><p>Best rally: \"'${best.rally} · Cups completed: ${best.cups} · Gold crowns: ${best.gold}</p>`;else{const questions={testing:['\"'How many issues did testing catch?','How many were critical / game breaking?','Most helpful test?','Least helpful test?'],engine:['What did you like most?','Did you get stuck or guess wrong?','What did you build yourself?','Hardest part of the engine?','Engine changes?','One thing to change?'],prompt:['What did you like most?','What was confusing?','What was hardest?','What would you change?']}[tab];const answers=data[tab+'Feedback'];body=questions.map((q,i)=>\"'`<h3>${q}</h3><p>${answers[i]}</p>`).join('\"'')}\n return modalShell('Behind the little court.',\"'`<div class=\"about-tabs\"><button data-action=\"about-source\">Source Information</button><button data-action=\"about-testing\">Testing Feedback</button><button data-action=\"about-engine\">Engine Feedback</button><button data-action=\"about-prompt\">Prompt Feedback</button></div><div class=\"abouttext\">${body}</div>`,{wide:true,kicker:'\"'ABOUT & CREDITS'});\n}\nfunction back(){audio.play('menu',.5);if(screen==='pause'){resume();return}if(screen==='dev'){openModal('pause');return}if(screen==='settings'&&modalReturn==='pause'){openModal('pause');modalReturn='title';return}if(screen==='room'||screen==='join'){network.disconnect();openModal('together');return}if(screen==='game'){pause();return}if(screen==='onlinepaused')return;\"'$('\"'modal').classList.add('hidden');screen='title';focusAt(0);lastActivity=performance.now();}\nfunction pause(){if(G.attract)return;if(G.mode==='online'&&\"'!network.info.isHost){showToast('\"'The host controls time outs.');return}if(\"'!['\"'play','serve'].includes(G.phase))return;G.resumePhase=G.phase;G.phase='pause';keys.clear();mouse.charge=false;openModal('pause');if(G.mode==='online'){const buttons=\"'$('\"'modal').querySelectorAll('[data-action=\\\"dev\\\"],[data-action=\\\"restart\\\"]');buttons.forEach(b=>b.remove())}}\nfunction resume(){G.phase=G.resumePhase||'play';if(G.phase==='pause')G.phase='serve';screen='game';\"'$('\"'modal').classList.add('hidden');keys.clear();accumulator=0;updatePrompts()}\nfunction hudMarkup(){const online=G.mode==='online';return \"'`<div class=\"hud-title\"><small>${G.mode==='\"'cup'?'THE ROYALE CUP':G.mode==='local'?'SAME COUCH · VERSUS':online?'ONLINE · VERSUS':'CLUB FRIENDLY'}</small><b>\"'${COURTS[G.court].name}</b><small>FIRST TO ${params.targetScore}</small><div class=\"eventdots\">${G.mode==='\"'cup'?[0,1,2].map((i)=>\"'`<span class=\"eventdot ${i===G.court?'\"'current':G.wins[i]?'win':''}\\\"></span>\"'`).join('\"''):''}</div></div><div class=\\\"scorebar\\\"><div class=\\\"team\\\"><div><small>CORAL CLUB</small><b>\"'${G.mode==='\"'solo'||G.mode==='cup'?'YOU':online&&network.info.localSeat===0?'YOU':'PLAYER 1'}</b></div><span class=\\\"pts coral\\\" id=\\\"score0\\\">0</span></div><div class=\\\"divider\\\"></div><div class=\\\"team\\\"><div><small>MINT CLUB</small><b>\"'${G.mode==='\"'solo'||G.mode==='cup'?'CHALLENGER':online&&network.info.localSeat===1?'YOU':'PLAYER 2'}</b></div><span class=\\\"pts mint\\\" id=\\\"score1\\\">0</span></div></div><button class=\\\"menu-btn\\\" data-action=\\\"pause\\\">\"'${glyph('\"'pause')} &nbsp; MENU</button><div class=\\\"hud-foot\\\"><div class=\\\"controls\\\" id=\\\"controlshint\\\"></div><div class=\\\"meters\\\"><div class=\\\"meter\\\"><small>POWER <span id=\\\"powertext\\\">0%</span></small><div class=\\\"track\\\"><div class=\\\"fill\\\" id=\\\"powerfill\\\"></div></div></div><div class=\\\"meter\\\"><small>DASH <span id=\\\"dashtext\\\">READY</span></small><div class=\\\"track\\\"><div class=\\\"fill mintfill\\\" id=\\\"dashfill\\\" style=\\\"width:100%\\\"></div></div></div></div></div>\"'`}\nfunction startGame({mode='\"'solo',court=0}={}){G.mode=mode;G.court=clamp(court,0,2);G.attract=false;G.scores=[0,0];G.wins=[];G.stats={bestRally:0,power:0,banks:0,dashes:0,points:0};G.winner=null;G.rally=0;G.time=0;G.trail=[];G.particles=[];G.perfect=false;G.debug=false;G.paddles.forEach(p=>Object.assign(p,{z:0,v:0,charge:0,dash:0,cooldown:0,aim:0}));createWorld();newServe(Math.random()<.5?0:1);screen='game';\"'$('\"'modal').classList.add('hidden');\"'$('\"'titleScreen').classList.add('hidden');\"'$('\"'attractUI').classList.add('hidden');\"'$('\"'hud').innerHTML=hudMarkup();\"'$('\"'hud').classList.remove('hidden');keys.clear();mouse.charge=false;mouse.active=false;accumulator=0;center(COURTS[G.court].name,1800);showToast(COURTS[G.court].tip,4300);updatePrompts();audio.play('start');audio.speak('welcome')}\nfunction createWorld(){if(world)world.free();world=new RAPIER.World({x:0,y:0,z:0});world.timestep=1/120;paddleBodies=[];paddleColliders=[];bankBodies=[];endBodies=[];\n const fixedBox=(x,z,hx,hz)=>{const rb=world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x,.5,z));world.createCollider(RAPIER.ColliderDesc.cuboid(hx,.8,hz).setRestitution(1).setFriction(0),rb);return rb};\n fixedBox(0,-6.25,12,.25);fixedBox(0,6.25,12,.25);\n for(let i=0;i<2;i++){const rb=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(i===0?-9:9,.5,G.paddles[i].z));paddleBodies.push(rb);paddleColliders.push(world.createCollider(RAPIER.ColliderDesc.cuboid(.22,.6,params.paddleSize).setSensor(true),rb))}\n if(G.court===1)for(const [x,z]of[[-3,-2.5],[3,2.5]]){const rb=world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x,.5,z));world.createCollider(RAPIER.ColliderDesc.cylinder(.6,.58).setRestitution(1).setFriction(0),rb);bankBodies.push(rb)}\n if(G.court===2)for(const x of[-10.3,10.3])for(const z of[-4.2,4.2])endBodies.push(fixedBox(x,z,.25,1.8));\n ballBody=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,.5,0).enabledTranslations(true,false,true).enabledRotations(false,false,false).setCcdEnabled(true).setLinearDamping(0));ballCollider=world.createCollider(RAPIER.ColliderDesc.ball(.28).setRestitution(1).setFriction(0).setDensity(.1),ballBody);syncBall();}\nfunction syncBall(){const p=ballBody.translation(),v=ballBody.linvel();G.ball={x:p.x,z:p.z,vx:v.x,vz:v.z}}\nfunction newServe(direction=0){G.phase='serve';G.serve=direction;G.serveTimer=1.5;G.rally=0;G.trail=[];G.ball={x:0,z:0,vx:0,vz:0};ballBody.setTranslation({x:0,y:.5,z:0},true);ballBody.setLinvel({x:0,y:0,z:0},true);G.paddles.forEach(p=>{p.charge=0});bankCooldown=0;}\nfunction launch(){if(G.phase\"'!=='\"'serve')return;const angle=(Math.random()-.5)*.8;const sign=G.serve===0?-1:1;ballBody.setLinvel({x:sign*params.ballSpeed*Math.cos(angle),y:0,z:params.ballSpeed*Math.sin(angle)},true);G.phase='play';audio.play('serve');center('LET’S RALLY',650);}\nfunction burst(x,z,color,count=15){for(let i=0;i<count;i++){const a=Math.random()*Math.PI*2,s=1.8+Math.random()*4;G.particles.push({x,z,y:.4,vx:Math.cos(a)*s,vz:Math.sin(a)*s,vy:1+Math.random()*3,life:.45+Math.random()*.5,color})}if(G.particles.length>100)G.particles.splice(0,G.particles.length-100)}\nfunction scorePoint(seat){if(\"'!['\"'play','serve','pause'].includes(G.phase))return;G.scores[seat]++;G.stats.points++;G.stats.bestRally=Math.max(G.stats.bestRally,G.rally);best.rally=Math.max(best.rally,G.rally);save();burst(seat===0?10:-10,G.ball.z,seat===0?'#ed7055':'#6bb6a4',35);audio.play('goal');audio.speak(seat===0?'point':'surprise');vibrate(.7);G.flash=1;showToast((seat===0?'CORAL':'MINT')+' SCORES\"'!'\"'+(G.rally>=8?\"'` ${G.rally}-HIT RALLY!`:'\"''),2200);\n if(G.scores[seat]>=params.targetScore){finishMatch(seat);return}G.nextServe=seat===0?1:0;G.phase='point';G.pointPause=1.5;ballBody.setLinvel({x:0,y:0,z:0},true);}\nfunction finishMatch(winner){G.winner=winner;G.phase='result';if(G.mode==='cup')G.wins[G.court]=winner===0;audio.play(winner===0?'win':'lose');audio.speak('victory');if(G.mode==='cup'&&G.court===2){best.cups++;if(G.wins.filter(Boolean).length===3)best.gold++;save()}if(G.mode==='online')network.finish(G.scores);if(\"'!G.attract)showResult()}\nfunction showResult(reason){screen='\"'result';\"'$('\"'centerMsg').classList.add('hidden');const finalCup=G.mode==='cup'&&G.court===2,wins=G.wins.filter(Boolean).length;let title=G.winner===null?'Honors shared.':G.winner===0?'Coral takes the court.':'Mint takes the court.';if(finalCup)title=['A splendid first outing.','A bronze beginning.','Silver looks good on you.','The crown is yours.'][wins];\n const subtitle=reason?\"'`Round complete · ${reason}`:finalCup?`${wins} of 3 events won. ${wins===3?'\"'A perfect little occasion.':wins===2?'One more rally from glory.':'Every good club starts somewhere.'}\"'`:COURTS[G.court].short;\n const next=G.mode==='\"'cup'&&G.court<2?\"'`<button class=\"primary\" data-action=\"next\">Next: ${COURTS[G.court+1].name} →</button>`:network.info.mode==='\"'hub'?'<button disabled>Waiting for AI Hub…</button>':G.mode==='online'?(network.info.isHost?'<button class=\\\"primary\\\" data-action=\\\"rematch\\\">Rematch →</button>':'<button disabled>Waiting for a rematch…</button>'):'<button class=\\\"primary\\\" data-action=\\\"replay\\\">Play it again →</button>';\n \"'$('\"'modal').innerHTML=modalShell(title,\"'`<div class=\"medal\">${finalCup?(wins===3?'\"'♛':wins===2?'✦':'★'):'✦'}</div><p>\"'${subtitle}</p><div class=\"scorebar-inline\" style=\"font-size:30px;font-weight:900\"><span class=\"coral\">${G.scores[0]}</span> <span style=\"font-size:18px;padding:0 16px\">—</span> <span class=\"mint\">${G.scores[1]}</span></div><div class=\"stats\"><div><b>${G.stats.bestRally}</b><small>BEST RALLY</small></div><div><b>${G.stats.power}</b><small>POWER SHOTS</small></div><div><b>${G.stats.banks}</b><small>BANK SHOTS</small></div></div><div class=\"menu-stack\">${next}${network.info.mode==='\"'hub'?'':'<button data-action=\\\"quit\\\">Back to the clubhouse</button>'}</div>\"'`,{back:false,kicker:finalCup?'\"'ROYALE CUP · FINAL RESULTS':'FULL TIME · GOOD GAME'});\"'$('\"'modal').classList.remove('hidden');focusAt(0)}\nfunction nextEvent(){if(G.court>=2)return;G.court++;G.scores=[0,0];G.winner=null;G.paddles.forEach(p=>Object.assign(p,{z:0,charge:0,cooldown:0,dash:0}));createWorld();newServe(0);screen='game';\"'$('\"'modal').classList.add('hidden');\"'$('\"'hud').innerHTML=hudMarkup();center(COURTS[G.court].name,1900);showToast(COURTS[G.court].tip,4200);updatePrompts();audio.play('start')}\nfunction reflectZ(z){const range=11.2;let q=((z+5.6)%(range*2)+range*2)%(range*2);return(q>range?range*2-q:q)-5.6}\nfunction aiInput(seat){const p=G.paddles[seat],sign=seat===0?-1:1,b=G.ball,toward=b.vx*sign>0;const intercept=toward&&Math.abs(b.vx)>1?reflectZ(b.z+b.vz*((sign*8.5-b.x)/b.vx)):Math.sin(G.time*.7+seat)*.9;const skill=G.attract||G.perfect?1:clamp(params.aiSkill+G.court*.065,.1,1);const wobble=(Math.sin(G.time*1.71+seat*5)+Math.sin(G.time*.8))*((1-skill)*1.5);const target=G.court===2?clamp(intercept+wobble,-3.1,3.1):intercept+wobble;const gap=target-p.z;const opponent=G.paddles[1-seat];return{move:clamp(gap*(skill*3+1),-1,1)*(G.attract||G.perfect?1:.48+skill*.43),aim:G.court===2?clamp(-p.z/4,-1,1):clamp(-opponent.z/4+Math.sin(G.time)*.3,-1,1),charge:toward||G.attract,dash:Math.abs(gap)>2.5&&Math.abs(b.x)>4&&toward}}\nfunction padInput(pad){return{move:Math.abs(pad?.axes?.[1]||0)>.13?clamp(pad.axes[1],-1,1):((pad?.buttons?.[13]?.pressed?1:0)-(pad?.buttons?.[12]?.pressed?1:0)),aim:Math.abs(pad?.axes?.[0]||0)>.13?pad.axes[0]:0,charge:\"'!!(pad?.buttons?.[0]?.pressed||pad?.buttons?.[7]?.pressed),dash:!!(pad?.buttons?.[5]?.pressed||pad?.buttons?.[4]?.pressed)}}\nfunction localInput(seat){const pads=[...(navigator.getGamepads?.()||[])].filter(p=>p?.connected);const local=G.mode==='\"'local';let pad=local?pads[seat]:pads[0];if(local&&pads.length===1){if(seat===0)return padInput(pads[0]);pad=null;}if(pad&&lastInput==='gamepad')return padInput(pad);\n let up,down,charge,dash,aim;if(local&&seat===1){up=keys.has('ArrowUp');down=keys.has('ArrowDown');charge=keys.has('Enter');dash=keys.has('ShiftRight');aim=(keys.has('ArrowRight')?1:0)-(keys.has('ArrowLeft')?1:0)}else{up=keys.has('KeyW')||(\"'!local&&keys.has('\"'ArrowUp'));down=keys.has('KeyS')||(\"'!local&&keys.has('\"'ArrowDown'));charge=keys.has('Space');dash=keys.has('ShiftLeft')||(\"'!local&&keys.has('\"'ShiftRight'));aim=(keys.has('KeyD')||(\"'!local&&keys.has('\"'ArrowRight'))?1:0)-(keys.has('KeyA')||(\"'!local&&keys.has('\"'ArrowLeft'))?1:0)}\n if(lastInput==='touch'&&(\"'!local||seat===0))return{move:touchAxis,aim:touchAim,charge:true,dash:touchDash,assist:true};\n if(mouse.active&&(!local||seat===0)&&lastInput==='\"'mouse')return{move:clamp((mouse.z-G.paddles[seat].z)*5,-1,1),aim:mouse.aim,charge:mouse.charge,dash:mouse.dash};return{move:(down?1:0)-(up?1:0),aim,charge,dash}}\nfunction getInputs(){if(G.attract)return[aiInput(0),aiInput(1)];if(G.mode==='online'){const info=network.info;if(info.isHost){const a=[{...remoteInputs[0]},{...remoteInputs[1]}];if(info.localSeat\"'!==null)a[info.localSeat]=localInput(info.localSeat);return a}return[{},{}]};return[G.perfect?aiInput(0):localInput(0),G.mode==='\"'local'?localInput(1):aiInput(1)]}\nfunction step(dt){G.time+=dt;bankCooldown=Math.max(0,bankCooldown-dt);G.flash=Math.max(0,G.flash-dt*3);for(const p of G.particles){p.life-=dt;p.x+=p.vx*dt;p.z+=p.vz*dt;p.y=Math.max(.1,p.y+p.vy*dt);p.vy-=10*dt}G.particles=G.particles.filter(p=>p.life>0);\n if(G.phase==='point'){G.pointPause-=dt;if(G.pointPause<=0)newServe(G.nextServe);return}if(\"'!['\"'play','serve'].includes(G.phase))return;\n if(hubHoldUntil>performance.now())return;const inputs=getInputs();\n for(let i=0;i<2;i++){const p=G.paddles[i],input=inputs[i];p.cooldown=Math.max(0,p.cooldown-dt);p.dash=Math.max(0,p.dash-dt);p.aim=clamp(Number(input.aim)||0,-1,1);if(input.dash&&p.cooldown===0){p.dash=.17;p.cooldown=1.6;G.stats.dashes++;audio.play('dash');burst(i===0?-9:9,p.z,i===0?'#ed7055':'#6