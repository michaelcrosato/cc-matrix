n(e);mouse.active=true;if(e.button===0)mouse.charge=true;if(e.button===2)mouse.dash=true}});\ndocument.addEventListener('pointermove',e=>{if(e.pointerType==='touch'){const t=touches.get(e.pointerId);if(t){touchAxis=clamp((e.clientY-t.y)/65,-1,1);touchAim=clamp((e.clientX-t.x)/90,-1,1);lastActivity=performance.now()}}else if(screen==='game'&&e.target===\"'$('\"'scene')){setInput('mouse');mousePosition(e);mouse.active=true}});\ndocument.addEventListener('pointerup',e=>{if(e.pointerType==='touch'){touches.delete(e.pointerId);if(\"'!touches.size){touchAxis=0;touchAim=0;touchActive=false}touchDash=false}else{if(e.button===0)mouse.charge=false;if(e.button===2)mouse.dash=false}});\ndocument.addEventListener('\"'pointercancel',()=>{touches.clear();touchAxis=0;touchDash=false;mouse.charge=false;mouse.dash=false});\ndocument.addEventListener('contextmenu',e=>{if(e.target===\"'$('\"'scene'))e.preventDefault()});\nwindow.addEventListener('blur',()=>{keys.clear();mouse.charge=false;mouse.dash=false;touchAxis=0;if(['play','serve'].includes(G.phase)&&\"'!G.attract&&G.mode!=='\"'online')pause()});\nwindow.addEventListener('resize',()=>arena?.resize());\nfunction tick(now){requestAnimationFrame(tick);const dt=Math.min(.05,(now-frameTime)/1000||1/60);frameTime=now;pollGamepad();if(screen==='title'&&\"'!G.attract&&now-lastActivity>10000&&network.info.mode!=='\"'hub')attract();\n const playing=['play','serve','point'].includes(G.phase);if(playing&&(G.mode\"'!=='\"'online'||network.info.isHost)){accumulator+=dt;while(accumulator>=1/120){step(1/120);accumulator-=1/120}}else accumulator=0;\n if(G.mode==='online'&&network.info.active){netTimer+=dt;if(netTimer>.066){netTimer=0;if(network.info.isHost)network.sendSnapshot(snapshot());else network.sendInput(localInput(network.info.localSeat??1));}}\n if(G.attract){attractElapsed+=dt;if(attractElapsed-attractCourtAt>18||G.phase==='result'){attractCourtAt=attractElapsed;G.court=(G.court+1)%3;G.scores=[0,0];G.paddles.forEach(p=>p.z=0);createWorld();newServe(G.court%2);\"'$('\"'attractcourt').textContent=COURTS[G.court].name}}\n if(G.phase==='title'){G.time+=dt;G.ball={x:Math.sin(G.time*1.3)*7.7,z:Math.sin(G.time*1.9)*3.8};G.paddles[0].z=Math.sin(G.time*1.9-.6)*3.4;G.paddles[1].z=Math.sin(G.time*1.9+.6)*3.4;G.trail.push({x:G.ball.x,z:G.ball.z});if(G.trail.length>20)G.trail.shift()}\n if(now>toastUntil)\"'$('\"'toast').classList.add('hidden');if(now>centerUntil)\"'$('\"'centerMsg').classList.add('hidden');\n if(G.phase==='serve'&&\"'!G.attract){if(hubHoldUntil>now){$('\"'centerMsg').textContent='STARTING IN '+Math.max(1,Math.ceil((hubHoldUntil-now)/1000))}else \"'$('\"'centerMsg').textContent=G.serveTimer>.65?'READY?':'LET’S RALLY';\"'$('\"'centerMsg').classList.remove('hidden');centerUntil=now+100}\n uiTimer+=dt;if(uiTimer>.05){renderHud();uiTimer=0}audio.tick(dt,{intensity:playing?clamp(G.rally/15,.25,1):.2});\n const visualState={...G,mode:COURTS[G.court].id,phase:G.phase==='title'?'title':G.phase==='pause'?'pause':'play',paddleSize:params.paddleSize,reduceMotion:settings.reduceMotion};arena.update(settings.reduceMotion?dt*.25:dt,visualState);if(G.debug)drawDebug();\n}\nlet debugCanvas,debugCtx;function drawDebug(){if(\"'!debugCanvas){debugCanvas=document.createElement('\"'canvas');debugCanvas.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:5';document.body.appendChild(debugCanvas);debugCtx=debugCanvas.getContext('2d')}debugCanvas.width=innerWidth;debugCanvas.height=innerHeight;debugCtx.strokeStyle='#ec4156';debugCtx.lineWidth=2;for(const [x,z,r]of[[-9,G.paddles[0].z,params.paddleSize],[9,G.paddles[1].z,params.paddleSize],[G.ball.x,G.ball.z,.28]]){const p=arena.project(x,z),q=arena.project(x,z+r);debugCtx.beginPath();debugCtx.arc(p.x,p.y,Math.max(4,Math.abs(p.y-q.y)),0,Math.PI*2);debugCtx.stroke()}debugCanvas.classList.toggle('hidden',\"'!G.debug)}\nasync function boot(){try{$('\"'loadstatus').textContent='Setting out the three courts…';await RAPIER.init();arena=await createArena(THREE,\"