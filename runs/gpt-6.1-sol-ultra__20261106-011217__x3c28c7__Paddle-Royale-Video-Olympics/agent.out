court=(G.court+1)%3;G.scores=[0,0];createWorld();newServe(0);G.resumePhase='serve';G.phase='pause';\"'$('\"'hud').innerHTML=hudMarkup();openModal('dev');break;case'dev-auto':G.perfect=\"'!G.perfect;openModal('\"'dev');break;case'dev-debug':G.debug=\"'!G.debug;openModal('\"'dev');break;case'dev-reset':Object.assign(params,DEFAULTS);updatePaddleSize();openModal('dev');break;default:if(action.startsWith('quick-'))startGame({mode:'solo',court:Number(action.slice(-1))});if(action.startsWith('about-')){\"'$('\"'modal').innerHTML=aboutMarkup(action.slice(6));focusAt(0)};}}\nfunction updatePaddleSize(){for(const collider of paddleColliders)collider.setShape(new RAPIER.Cuboid(.22,.6,params.paddleSize));}\nfunction pollGamepad(){const pads=[...(navigator.getGamepads?.()||[])].filter(p=>p?.connected),pad=pads[0];if(\"'!pad){padPrev=[];return}const buttons=pad.buttons.map(b=>b.pressed);const edge=i=>buttons[i]&&!padPrev[i];const axis=pad.axes[1]||0,hor=pad.axes[0]||0;const active=Math.abs(axis)>.2||Math.abs(hor)>.2||buttons.some(Boolean);if(active){if(setInput('\"'gamepad')){padPrev=buttons;return}}const inMenu=\"'!['\"'game','attract'].includes(screen);if(edge(9)){if(screen==='game')pause();else if(screen==='pause')resume()}if(inMenu){const now=performance.now();let nav=0;if(edge(13)||axis>.5&&now>padNavAt)nav=1;else if(edge(12)||axis<-.5&&now>padNavAt)nav=-1;if(nav){focusMove(nav);padNavAt=now+230}if(edge(15)||hor>.5&&now>padNavAt){adjustFocus(1);padNavAt=now+200}if(edge(14)||hor<-.5&&now>padNavAt){adjustFocus(-1);padNavAt=now+200}if(edge(0))confirmFocus();if(edge(1))back()}padPrev=buttons;}\ndocument.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(\"'!b||b.disabled)return;if(suppressClick){suppressClick=false;return}onAction(b.dataset.action)});\ndocument.addEventListener('\"'pointerover',e=>{const b=e.target.closest('button,input');if(\"'!b)return;const list=focusable();const i=list.indexOf(b);if(i>=0)focusAt(i)});\ndocument.addEventListener('\"'in