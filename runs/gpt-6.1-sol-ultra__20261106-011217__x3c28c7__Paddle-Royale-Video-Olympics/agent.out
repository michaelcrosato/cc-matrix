{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > Paddle-Royale-Video-Olympics-gpt-6.1-sol-ultra-20261106-011217/index.template.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<!--HUB_SCRIPT-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"color-scheme\" content=\"light\">\n<meta name=\"ai-hub:session\" content=\"1\"><meta name=\"ai-hub:players\" content=\"2-2\"><meta name=\"ai-hub:mode\" content=\"shared-world\"><meta name=\"ai-hub:name\" content=\"Paddle Royale\">\n<title>Paddle Royale · A little court. A lot of glory.</title>\n<style>\n:root{--paper:#f5f0dd;--ink:#203b40;--muted:#647471;--coral:#ed7055;--mint:#6bb6a4;--gold:#ecc35c;--line:#c6c9b5;--shadow:0 6px 0 var(--ink);font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none}*{box-sizing:border-box}body{margin:0;overflow:hidden}button,input{font:inherit}button{color:inherit;cursor:pointer;border:2px solid var(--ink);background:var(--paper);border-radius:12px;min-height:52px;font-weight:800;letter-spacing:.01em;transition:transform .12s,background .12s,box-shadow .12s}button:hover,button.focused,button:focus-visible{outline:none;background:#f8d477;box-shadow:0 4px 0 var(--ink);transform:translateY(-2px)}button:active{transform:translateY(2px);box-shadow:none}button:disabled{opacity:.45;cursor:default;transform:none;box-shadow:none}.primary{background:var(--coral);box-shadow:0 5px 0 var(--ink)}.secondary{background:var(--mint)}.quiet{border-color:transparent;background:transparent;min-height:42px;padding:8px 12px}.quiet:hover,.quiet.focused{border-color:var(--ink)}#scene{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}#ui{position:fixed;inset:0;pointer-events:none}#ui>*{pointer-events:auto}.hidden{display:none!important}.brand{font-size:17px;font-weight:900;letter-spacing:.12em}.brand i{display:inline-block;width:15px;height:15px;border-radius:50%;background:var(--coral);border:2px solid var(--ink);margin-right:8px;vertical-align:-1px}.topbar{position:absolute;top:25px;left:35px;right:35px;display:flex;justify-content:space-between;align-items:center;gap:20px}.top-right{display:flex;align-items:center;gap:14px;font-size:13px;font-weight:800;letter-spacing:.08em}.pill{padding:9px 14px;border:1.5px solid var(--ink);border-radius:30px;background:var(--paper)}.hero{position:absolute;left:6%;top:18%;width:425px;max-width:39vw}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.19em;line-height:1.6}.hero h1{font-size:clamp(68px,7.2vw,108px);font-weight:950;letter-spacing:-.075em;line-height:.85;margin:21px 0 22px;text-shadow:3px 3px 0 #f5f0dd,-1px -1px 0 #f5f0dd}.hero h1 span{color:var(--coral)}.tagline{font-size:20px;line-height:1.4;max-width:360px;margin:0 0 28px}.hero button{width:100%;font-size:17px;padding:13px 16px;text-align:left}.hero button .arrow{float:right}.split{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.split button{font-size:14px}.hero .links{display:flex;gap:9px;margin-top:13px}.hero .links button{width:auto;font-size:13px}.titlefoot{position:absolute;bottom:25px;left:6%;font-size:12px;letter-spacing:.12em;font-weight:800;line-height:1.8}.stamp{position:absolute;right:7%;top:14%;width:98px;height:98px;border:2px solid var(--ink);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;transform:rotate(12deg);background:var(--gold);box-shadow:4px 4px 0 var(--ink);font-size:11px;font-weight:800;letter-spacing:.08em}.stamp b{font-size:29px;letter-spacing:-.04em}.titlecourt{position:absolute;right:7%;bottom:70px;text-align:right;font-size:12px;font-weight:800;letter-spacing:.14em}.titlecourt b{display:block;font-size:27px;letter-spacing:-.04em;margin-bottom:5px}.scrim{position:absolute;inset:0;background:rgba(24,44,48,.3);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:24px}.panel{width:620px;max-width:95vw;max-height:91vh;overflow:auto;padding:35px 40px;background:var(--paper);border:2px solid var(--ink);border-radius:20px;box-shadow:8px 10px 0 rgba(19,44,48,.9)}.panel.wide{width:790px}.panel h2{font-size:40px;line-height:1;letter-spacing:-.06em;margin:9px 0 16px}.panel p{line-height:1.55;font-size:16px;color:#4e6260}.panel .menu-stack{display:grid;gap:12px;margin-top:25px}.panel .menu-stack button{padding:13px 18px;text-align:left}.panel .back{margin-top:20px}.court-cards{display:grid;gap:12px;margin-top:23px}.courtcard{padding:16px 20px;text-align:left;display:grid;grid-template-columns:46px 1fr;gap:15px;align-items:center}.courtcard .number{font-size:29px;font-weight:900;color:var(--coral)}.courtcard strong{font-size:20px;display:block}.courtcard small{font-size:12px;font-weight:500;display:block;margin-top:5px;color:#536561}.row{display:flex;align-items:center;justify-content:space-between;gap:18px;margin:18px 0;font-size:16px}.row label{font-weight:700}.row output{font-size:14px;min-width:48px;text-align:right}.row input[type=range]{width:180px;accent-color:var(--coral)}.row button{font-size:13px;padding:8px 14px;min-height:40px}.helpgrid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.helpgrid article{border-top:2px solid var(--ink);padding-top:12px}.helpgrid b{font-size:16px}.helpgrid p{font-size:14px;margin:8px 0}.controlkey{display:inline-flex;align-items:center;justify-content:center;min-width:24px;min-height:24px;padding:2px 6px;border:1.5px solid currentColor;border-radius:5px;font-size:12px;font-weight:800}.hint{font-size:12px;color:#5c706a;line-height:1.6}#hud{position:absolute;inset:0;pointer-events:none}#hud button{pointer-events:auto}.scorebar{position:absolute;top:24px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:0;min-width:490px;background:var(--paper);border:2px solid var(--ink);border-radius:13px;box-shadow:0 4px 0 var(--ink);overflow:hidden}.team