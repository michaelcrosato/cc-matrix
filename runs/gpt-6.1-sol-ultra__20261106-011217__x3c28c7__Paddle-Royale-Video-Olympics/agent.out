==1&&bankCooldown<=0&&Math.sign(old.vz)!==Math.sign(G.ball.vz)){for(const [x,z]of[[-3,-2.5],[3,2.5]])if(Math.hypot(G.ball.x-x,G.ball.z-z)<1.05){G.stats.banks++;audio.play('\"'bank');burst(x,z,'#ecc35c',14);showToast('NICE BANK\"'!'\"',1000);bankCooldown=.15;break}}\n // Keep elastic contacts from ever producing a near-vertical stalemate.\n if(Math.abs(G.ball.vx)<2.6){const v=ballBody.linvel(),sign=Math.sign(v.x)||Math.sign(old.vx)||1;ballBody.setLinvel({x:sign*2.6,y:0,z:v.z},true);syncBall()}\n if(Math.abs(G.ball.x)>10.85){scorePoint(G.ball.x>0?0:1)}\n G.trail.push({x:G.ball.x,z:G.ball.z});if(G.trail.length>23)G.trail.shift();\n}\nfunction attract(){G.attract=true;G.mode='solo';G.phase='serve';G.court=0;G.time=0;G.scores=[0,0];G.stats={bestRally:0,power:0,banks:0,dashes:0,points:0};G.paddles.forEach(p=>Object.assign(p,{z:0,charge:0,cooldown:0,dash:0}));createWorld();newServe(1);attractElapsed=0;attractCourtAt=0;screen='attract';\"'$('\"'titleScreen').classList.add('hidden');\"'$('\"'modal').classList.add('hidden');\"'$('\"'hud').classList.add('hidden');\"'$('\"'attractUI').classList.remove('hidden');\"'$('\"'attractUI').innerHTML='<div class=\\\"attract-label\\\">● ON AIR · CLUB EXHIBITION</div><div class=\\\"attract-foot\\\"><b id=\\\"attractcourt\\\">Classic Rally</b><small>AI exhibition · Any button brings you back.</small></div>';\"'$('\"'toast').classList.add('hidden');\"'$('\"'centerMsg').classList.add('hidden')}\nfunction exitAttract(){G.attract=false;showTitle();audio.play('menu')}\nfunction renderHud(){if(\"'$('\"'score0')){\"'$('\"'score0').textContent=G.scores[0];\"'$('\"'score1').textContent=G.scores[1];const seat=G.mode==='online'?(network.info.localSeat??0):0,p=G.paddles[seat];\"'$('\"'powertext').textContent=p.charge>=.99?'READY':Math.floor(p.charge*100)+'%';\"'$('\"'powerfill').style.width=p.charge*100+'%';\"'$('\"'dashfill').style.width=(1-p.cooldown/1.6)*100+'%';\"'$('\"'dashtext').textContent=p.cooldown<=0?'READY':p.cooldown.toFixed(1)+'s'}const t