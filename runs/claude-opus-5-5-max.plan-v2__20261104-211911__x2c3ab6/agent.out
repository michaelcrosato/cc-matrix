{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9A8kXCxF5c1QagbmAV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WskSXiYHy4cWyScNrrEirp","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211911__x2c3ab6/work/.research/shardfall/crates/pav_app/src/app.rs","offset":700,"limit":1500},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28421,"cache_read_input_tokens":149139,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28421},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"eb3d8a44-de88-4121-ac6f-adf7ca0c1ca2","uuid":"b4a34d3c-fc84-48ed-b4af-d193ac761eaa","timestamp":"2026-11-05T04:21:52.514Z","request_id":"req_011Cgj9A8XNRHqgXT3FwKaxH","wire_tool_inputs":{"toolu_01WskSXiYHy4cWyScNrrEirp":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211911__x2c3ab6/work/.research/shardfall/crates/pav_app/src/app.rs","offset":700,"limit":1500}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WskSXiYHy4cWyScNrrEirp","type":"tool_result","content":"700\t                if ok { format!(\"went to {key}\") } else { format!(\"could not go to {key}\") }\n701\t            }\n702\t            TeleportTarget::Hub => {\n703\t                host.exec(|sim| {\n704\t                    if let Some(pid) = sim.state.player {\n705\t                        sim.set_position(pid, Vec3::new(0.0, 0.0, 6.0));\n706\t                    }\n707\t                });\n708\t                \"went to the plaza\".into()\n709\t            }\n710\t            TeleportTarget::Wilderness => {\n711\t                let a = self.started.elapsed().as_secs_f32() * 7.3;\n712\t                let p = Vec3::new(a.cos(), 0.0, a.sin()) * 220.0 + Vec3::Y * 25.0;\n713\t                host.exec(move |sim| {\n714\t                    sim.state.world.interest.push(p);\n715\t                    sim.update_streaming(usize::MAX);\n716\t                    sim.state.world.interest.pop();\n717\t                    if let Some(pid) = sim.state.player {\n718\t                        sim.set_position(pid, p);\n719\t                    }\n720\t                });\n721\t                \"went to the wilderness\".into()\n722\t            }\n723\t        };\n724\t        self.toast(msg);\n725\t    }\n726\t\n727\t    fn open_teleport(&mut self) {\n728\t        if let Some(host) = &self.host {\n729\t            if let Some(e) = host.query(|sim| room_entries(sim)) {\n730\t                self.hud.entries = e;\n731\t            }\n732\t        }\n733\t        self.hud.teleport_open = true;\n734\t    }\n735\t\n736\t    /// Hot reload: re-read room files and rebuild what changed.\n737\t    fn reload_rooms(&mut self) {\n738\t        let Some(host) = &self.host else { return };\n739\t        let dir = self.watcher.as_ref().map(|w| w.dir.clone());\n740\t        let sources = pav_core::room::load_sources(dir.as_deref());\n741\t        let (defs, errors) = pav_core::room::parse_all(&sources);\n742\t        self.hud.errors = errors.iter().map(|(k, e)| format!(\"{k}: {e}\")).collect();\n743\t        for e in &self.hud.errors {\n744\t            log::error!(\"room file: {e}\");\n745\t        }\n746\t        let bad: Vec<String> = errors.into_iter().map(|(k, _)| k).collect();\n747\t        let changed = host\n748\t            .query(move |sim| {\n749\t                // Rooms whose file is broken keep their current definition.\n750\t                let mut defs = defs;\n751\t                for k in &bad {\n752\t                    if let Some(r) = sim.state.world.room(k) {\n753\t                        defs.push((k.clone(), (*r.def).clone()));\n754\t                    }\n755\t                }\n756\t                pav_tools::tools::reload_rooms(sim, defs)\n757\t            })\n758\t            .unwrap_or(0);\n759\t        if self.hud.errors.is_empty() {\n760\t            self.toast(format!(\"rooms reloaded ({changed} changed)\"));\n761\t        }\n762\t    }\n763\t\n764\t    fn set_menu(&mut self, open: bool) {\n765\t        let Some(host) = &self.host else { return };\n766\t        if open && !self.menu_open {\n767\t            self.paused_before_menu = host.control().paused;\n768\t            host.set_control(|c| c.paused = true);\n769\t        } else if !open && self.menu_open {\n770\t            let p = self.paused_before_menu;\n771\t            host.set_control(|c| c.paused = p);\n772\t        }\n773\t        self.menu_open = open;\n774\t        self.input.clear();\n775\t    }\n776\t\n777\t    /// The fixed system layer: never rebinds, works in every room.\n778\t    fn handle_key(&mut self, code: KeyCode) {\n779\t        let Some(host) = &self.host else { return };\n780\t        if self.studio_mode == StudioMode::Animation {\n781\t            if let Some(p) = host.frames().1.animation_preview.as_ref() {\n782\t                let args = match code {\n783\t                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n784\t                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n785\t                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n786\t                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n787\t                    _ => None,\n788\t                };\n789\t                if let Some(args) = args {\n790\t                    self.studio_command(crate::animation_ui::Command {\n791\t                        tool: \"anim_preview\",\n792\t                        args: args.as_object().unwrap().clone(),\n793\t                    });\n794\t                    return;\n795\t                }\n796\t            }\n797\t        }\n798\t        if self.studio_mode == StudioMode::Prop {\n799\t            if let Some(p) = host.frames().1.prop_preview.as_ref() {\n800\t                let args = match code {\n801\t                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n802\t                    KeyCode::F7 => Some(serde_json::json!({\"playing\": false, \"time\": p.time + 1.0 / 60.0})),\n803\t                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n804\t                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n805\t                    _ => None,\n806\t                };\n807\t                if let Some(args) = args {\n808\t                    self.studio_command(crate::animation_ui::Command {\n809\t                        tool: \"asset_preview\",\n810\t                        args: args.as_object().unwrap().clone(),\n811\t                    });\n812\t                    return;\n813\t                }\n814\t            }\n815\t        }\n816\t        if self.studio_mode == StudioMode::Creature {\n817\t            if let Some(p) = host.frames().1.creature_preview.as_ref() {\n818\t                let args = match code {\n819\t                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n820\t                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n821\t                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n822\t                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n823\t                    _ => None,\n824\t                };\n825\t                if let Some(args) = args {\n826\t                    self.studio_command(crate::animation_ui::Command {\n827\t                        tool: \"creature_preview\",\n828\t                        args: args.as_object().unwrap().clone(),\n829\t                    });\n830\t                    return;\n831\t                }\n832\t            }\n833\t        }\n834\t        // Shardfall's menu keys.\n835\t        if self.input.game && !self.menu_open && self.studio_mode == StudioMode::World {\n836\t            let ui = &mut self.game_ui;\n837\t            match code {\n838\t                KeyCode::KeyI | KeyCode::Tab => {\n839\t                    ui.inventory = !ui.inventory;\n840\t                    return;\n841\t                }\n842\t                KeyCode::KeyC => {\n843\t                    ui.character = !ui.character;\n844\t                    return;\n845\t                }\n846\t                KeyCode::KeyK => {\n847\t                    ui.skills = !ui.skills;\n848\t                    return;\n849\t                }\n850\t                KeyCode::KeyP => {\n851\t                    ui.tree.open = !ui.tree.open;\n852\t                    return;\n853\t                }\n854\t                KeyCode::KeyM => {\n855\t                    ui.map = !ui.map;\n856\t                    return;\n857\t                }\n858\t                KeyCode::KeyT => {\n859\t                    // Town portal: home from anywhere.\n860\t                    if self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town) {\n861\t                        host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n862\t                    }\n863\t                    return;\n864\t                }\n865\t                KeyCode::Escape if ui.any_open() => {\n866\t                    ui.close_all();\n867\t                    return;\n868\t                }\n869\t                _ => {}\n870\t            }\n871\t        }\n872\t        match code {\n873\t            KeyCode::Escape => {\n874\t                let open = !self.menu_open;\n875\t                self.set_menu(open);\n876\t            }\n877\t            KeyCode::F1 => self.panel.open = !self.panel.open,\n878\t            // How the room you are in works (outside the rooms: the field guide).\n879\t            KeyCode::KeyH if !self.input.game => {\n880\t                if self.hud.current.is_some() {\n881\t                    self.guide.station = !self.guide.station;\n882\t                } else {\n883\t                    self.guide.field = !self.guide.field;\n884\t                }\n885\t            }\n886\t            KeyCode::F2 => {\n887\t                if self.hud.teleport_open {\n888\t                    self.hud.teleport_open = false;\n889\t                } else {\n890\t                    self.open_teleport();\n891\t                }\n892\t            }\n893\t            KeyCode::F3 => self.show_boot = !self.show_boot,\n894\t            KeyCode::F4 => {\n895\t                host.exec(|sim| {\n896\t                    sim.leave_room();\n897\t                });\n898\t                self.toast(\"left the room\");\n899\t            }\n900\t            KeyCode::F5 => self.reset_room(),\n901\t            KeyCode::F6 => host.set_control(|c| c.paused = !c.paused),\n902\t            KeyCode::F7 => host.set_control(|c| {\n903\t                c.paused = true;\n904\t                c.step_requests += 1;\n905\t            }),\n906\t            KeyCode::F8 => host.set_control(|c| c.speed = (c.speed * 0.5).max(0.0625)),\n907\t            KeyCode::F9 => host.set_control(|c| c.speed = (c.speed * 2.0).min(8.0)),\n908\t            KeyCode::F10 if self.studio_mode == StudioMode::World => {\n909\t                self.editor.on = !self.editor.on;\n910\t                self.editor.dragging = None;\n911\t                let on = self.editor.on;\n912\t                self.toast(if on { \"edit mode on\" } else { \"edit mode off\" });\n913\t            }\n914\t            KeyCode::F11 => {\n915\t                if let Some(g) = &self.gfx {\n916\t                    let fs = g.window.fullscreen().is_some();\n917\t                    g.window.set_fullscreen(if fs { None } else { Some(Fullscreen::Borderless(None)) });\n918\t                }\n919\t            }\n920\t            KeyCode::F12 => self.screenshot_requested = true,\n921\t            _ => {\n922\t                let digits = [\n923\t                    KeyCode::Digit1,\n924\t                    KeyCode::Digit2,\n925\t                    KeyCode::Digit3,\n926\t                    KeyCode::Digit4,\n927\t                    KeyCode::Digit5,\n928\t                    KeyCode::Digit6,\n929\t                    KeyCode::Digit7,\n930\t                    KeyCode::Digit8,\n931\t                ];\n932\t                // (In Shardfall the number keys are potions and belt items.)\n933\t                let digit =\n934\t                    digits.iter().position(|k| *k == code).filter(|i| *i < CameraParams::PRESETS.len() && !self.input.game);\n935\t                if let Some(i) = digit {\n936\t                    let yaw = self.rig.params.yaw;\n937\t                    self.rig.params = (CameraParams::PRESETS[i].1)();\n938\t                    if CameraParams::PRESETS[i].0 != \"isometric\" {\n939\t                        self.rig.params.yaw = yaw;\n940\t                    }\n941\t                    self.toast(format!(\"camera: {}\", CameraParams::PRESETS[i].0));\n942\t                }\n943\t            }\n944\t        }\n945\t    }\n946\t\n947\t    fn frame(&mut self) {\n948\t        if self.gfx.is_none() || self.host.is_none() {\n949\t            return;\n950\t        }\n951\t        // Touch screens draw at most 60 frames a second (a phone with a faster screen would\n952\t        // spend battery and heat on the rest).\n953\t        if self.touch_screen {\n954\t            let now = Instant::now();\n955\t            let step = std::time::Duration::from_micros(16_667);\n956\t            if now + std::time::Duration::from_micros(2_500) < self.next_draw {\n957\t                return;\n958\t            }\n959\t            self.next_draw = if now > self.next_draw + step { now + step } else { self.next_draw + step };\n960\t        }\n961\t        let now = Instant::now();\n962\t        let dt = (now - self.last).as_secs_f32().min(0.1);\n963\t        self.last = now;\n964\t        self.fps.frames += 1;\n965\t        let since = self.fps.since.elapsed().as_secs_f32();\n966\t        if since >= 0.5 {\n967\t            self.fps.fps = self.fps.frames as f32 / since;\n968\t            self.fps.frame_ms = since * 1000.0 / self.fps.frames as f32;\n969\t            self.fps.frames = 0;\n970\t            self.fps.since = now;\n971\t        }\n972\t\n973\t        // Devices.\n974\t        self.input.poll_gamepad();\n975\t        if self.input.pad.start_pressed {\n976\t            let open = !self.menu_open;\n977\t            self.set_menu(open);\n978\t        }\n979\t        if self.input.pad.map_pressed {\n980\t            self.game_ui.map = !self.game_ui.map;\n981\t        }\n982\t        self.pad_menus(dt);\n983\t        let pad = self.input.last_device == Device::Gamepad;\n984\t        self.game_ui.pad = pad;\n985\t        self.game_ui.tree.pad = pad;\n986\t        self.rig.params.yaw = (self.rig.params.yaw + self.input.pad.rotate * 90.0 * dt + 540.0).rem_euclid(360.0) - 180.0;\n987\t        self.rig.params.distance = (self.rig.params.distance * (1.0 + self.input.pad.zoom * dt)).clamp(2.0, 120.0);\n988\t\n989\t        let host = self.host.as_ref().unwrap();\n990\t        host.pump();\n991\t        #[cfg(not(target_arch = \"wasm32\"))]\n992\t        if let Some(b) = &self.bridge {\n993\t            // Agent tools run on the simulation thread and can change the camera, view and look.\n994\t            if let Some(l) = b.poll(host, &mut self.rig, &mut self.view, self.look_ui.look()) {\n995\t                self.look_ui.set_look(l);\n996\t            }\n997\t        }\n998\t        let ui_wants_keys = self.egui_ctx.egui_wants_keyboard_input();\n999\t        let game_input = !self.menu_open && !ui_wants_keys;\n1000\t        let rewinding = game_input && self.studio_mode == StudioMode::World && self.input.rewind_held();\n1001\t        host.set_control(|c| c.rewinding = rewinding);\n1002\t\n1003\t        let (prev, curr, curr_at, tick_wall) = host.frames();\n1004\t        let studio_mode = curr.studio_mode();\n1005\t        let studio_active = curr.studio_active();\n1006\t        self.studio_navigation |= studio_active;\n1007\t        let snap_camera = studio_mode != self.studio_mode\n1008\t            || prev.studio_mode() != studio_mode\n1009\t            || prev.live_edit_ticket != curr.live_edit_ticket;\n1010\t        let game_input = game_input && !studio_active;\n1011\t        if studio_mode != self.studio_mode {\n1012\t            let keep_object_redo = studio_mode == StudioMode::World && self.asset_ui.open && self.asset_ui.creation_removed();\n1013\t            let keep_creature_redo =\n1014\t                studio_mode == StudioMode::World && self.creature_ui.open && self.creature_ui.creation_removed();\n1015\t            self.builder = ViewBuilder::new();\n1016\t            if let Some(gfx) = &mut self.gfx {\n1017\t                gfx.renderer.clear_particles();\n1018\t            }\n1019\t            self.studio_mode = studio_mode;\n1020\t            self.animation_ui.open = studio_mode == StudioMode::Animation;\n1021\t            self.asset_ui.open = studio_mode == StudioMode::Prop || keep_object_redo;\n1022\t            self.creature_ui.open = studio_mode == StudioMode::Creature || keep_creature_redo;\n1023\t        }\n1024\t        if !studio_active {\n1025\t            let room_before = self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def)));\n1026\t            let quarters = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n1027\t            self.director.update(&curr.hud, quarters, &mut self.rig);\n1028\t            let room_id_before = self.hud.current.as_ref().map(|r| r.id);\n1029\t            self.hud.update(&curr.room, &mut self.rig);\n1030\t            // Rooms and pads can change view settings (night lighting, bloom, filters).\n1031\t            let key = (curr.room.as_ref().map(|r| r.id), curr.hud.view_serial);\n1032\t            if key != self.view_key {\n1033\t                self.view_key = key;\n1034\t                if let Some(b) = self.view_base.take() {\n1035\t                    self.view = b;\n1036\t                }\n1037\t                let q = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n1038\t                let room = curr.room.as_ref().map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n1039\t                let pads = pav_view::build::room_view_map(&curr.hud.view, q);\n1040\t                if !room.is_empty() || !pads.is_empty() {\n1041\t                    self.view_base = Some(self.view.clone());\n1042\t                    for u in self.view.apply(&room).into_iter().chain(self.view.apply(&pads)) {\n1043\t                        log::warn!(\"unknown view setting '{u}'\");\n1044\t                    }\n1045\t                }\n1046\t            }\n1047\t            if self.hud.current.as_ref().map(|r| r.id) != room_id_before {\n1048\t                // Rooms can open HUD overlays (feel metrics) while you are inside.\n1049\t                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"feel\"));\n1050\t                if wants && !self.feel.open {\n1051\t                    self.feel.open = true;\n1052\t                    self.feel.auto = true;\n1053\t                } else if !wants && self.feel.auto {\n1054\t                    self.feel.open = false;\n1055\t                    self.feel.auto = false;\n1056\t                }\n1057\t                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"physics\"));\n1058\t                if wants && !self.physics.open {\n1059\t                    self.physics.open = true;\n1060\t                    self.physics.auto = true;\n1061\t                } else if !wants && self.physics.auto {\n1062\t                    self.physics.open = false;\n1063\t                    self.physics.auto = false;\n1064\t                }\n1065\t            }\n1066\t            self.feel.record(curr.tick, curr.hud.feel.speed);\n1067\t            if self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def))) != room_before {\n1068\t                // Input switching: the room's key overrides apply while inside.\n1069\t                let (b, errs) = match &self.hud.current {\n1070\t                    Some(r) => crate::input::Bindings::with_overrides(&r.def.keys),\n1071\t                    None if curr.game.is_some() => (crate::input::Bindings::game(), Vec::new()),\n1072\t                    None => (crate::input::Bindings::default(), Vec::new()),\n1073\t                };\n1074\t                self.input.bindings = b;\n1075\t                for e in errs {\n1076\t                    log::warn!(\"room keys: {e}\");\n1077\t                }\n1078\t            }\n1079\t            if *curr.config != self.sim_config && curr.tick > self.config_push_tick + 3 {\n1080\t                // The simulation changed its configuration (room overrides): adopt it.\n1081\t                self.sim_config = (*curr.config).clone();\n1082\t            }\n1083\t            // Entering or leaving Shardfall: its controls, camera and look.\n1084\t            let game_mode = curr.game.is_some();\n1085\t            if game_mode != self.input.game {\n1086\t                self.input.game = game_mode;\n1087\t                self.input.bindings = if game_mode { crate::input::Bindings::game() } else { crate::input::Bindings::default() };\n1088\t                self.rig.blend_from_current(0.5);\n1089\t                if game_mode {\n1090\t                    self.game_saved = Some((self.rig.params.clone(), self.view.clone()));\n1091\t                    self.rig.params = CameraParams {\n1092\t                        tilt: 56.0,\n1093\t                        yaw: 0.0,\n1094\t                        distance: 15.5,\n1095\t                        fov: 40.0,\n1096\t                        ortho: false,\n1097\t                        follow_lag: 0.06,\n1098\t                        height_offset: 0.8,\n1099\t                    };\n1100\t                    let v = &mut self.view;\n1101\t                    v.bloom = 0.55;\n1102\t                    v.bloom_threshold = 1.0;\n1103\t                    v.sky = \"#14161c\".into();\n1104\t                    v.light.sun_elevation = 52.0;\n1105\t                    v.light.sun_azimuth = 35.0;\n1106\t                    v.light.sun_intensity = 0.95;\n1107\t                    v.light.ambient = 0.5;\n1108\t                    v.saturation = 1.08;\n1109\t                    v.fog = false;\n1110\t                } else if let Some((cam, view)) = self.game_saved.take() {\n1111\t                    self.rig.params = cam;\n1112\t                    self.view = view;\n1113\t                }\n1114\t            }\n1115\t            self.game_frame = curr.game.clone();\n1116\t            if !game_mode {\n1117\t                self.game_ui.close_all();\n1118\t                self.game_place = None;\n1119\t            }\n1120\t            if let Some(g) = &curr.game {\n1121\t                if self.game_place != Some(g.place) {\n1122\t                    self.game_place = Some(g.place);\n1123\t                    self.arrival = Some(Instant::now());\n1124\t                    self.game_ui.panel = None;\n1125\t                    pav_view::arpg::place_look(g, &mut self.view);\n1126\t                }\n1127\t            }\n1128\t        } else {\n1129\t            self.game_frame = None;\n1130\t        }\n1131\t        let alpha = if self.app_settings.smoothing && !snap_camera {\n1132\t            ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0)\n1133\t        } else {\n1134\t            1.0\n1135\t        };\n1136\t        if snap_camera {\n1137\t            // A submitted edit must contain its new framing as well as its new geometry.\n1138\t            self.rig = CameraRig::new(self.rig.params.clone());\n1139\t            self.rig.snap(curr.focus);\n1140\t        }\n1141\t        let focus = prev.focus.lerp(curr.focus, alpha);\n1142\t        let player = curr.player.and_then(|id| curr.objects.iter().find(|o| o.id == id));\n1143\t        let feet = player.and_then(|p| p.puppet.as_ref().map(|pp| p.pos - Vec3::Y * pp.feet_offset)).unwrap_or(focus);\n1144\t        let facing = player.and_then(|p| p.puppet.as_ref().map(|pp| pp.state.facing)).unwrap_or(0.0);\n1145\t\n1146\t        // Game input -> the simulation thread.\n1147\t        let (w, h) = self.gfx.as_ref().unwrap().size();\n1148\t        let size = Vec2::new(w as f32, h as f32);\n1149\t        let over_ui = self.egui_ctx.egui_wants_pointer_input();\n1150\t        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\n1151\t        if over_ui {\n1152\t            self.input.mouse_taps.clear();\n1153\t        }\n1154\t        let (mut held, mut pressed) = self.input.buttons();\n1155\t        // Touch: the stick, the buttons and auto-attack.\n1156\t        let touch_game = curr.game.as_deref().filter(|_| game_input).map(|g| (g, feet, facing));\n1157\t        let rig = &self.rig;\n1158\t        let intent = self.touch.intent(touch_game, |v| rig.relative_move(v), self.prefs.auto_attack);\n1159\t        if game_input {\n1160\t            held |= intent.held;\n1161\t            pressed |= intent.pressed;\n1162\t        }\n1163\t        if pressed & pav_core::input::buttons::INTERACT != 0 {\n1164\t            if let Some(g) = &curr.game {\n1165\t                if let Some(c) = self.game_ui.interact(g) {\n1166\t                    host.shared.command(c);\n1167\t                }\n1168\t            }\n1169\t        }\n1170\t        if pressed != 0 && self.input.last_device == Device::Gamepad {\n1171\t            // Gamepad presses are timed from when they were polled (gilrs queues them).\n1172\t            self.latency.press();\n1173\t        }\n1174\t        let room_id = self.hud.current.as_ref().map(|r| r.id);\n1175\t        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n1176\t        if left_tap && !self.editor.on && game_input {\n1177\t            pressed |= pav_core::input::buttons::PRIMARY;\n1178\t        }\n1179\t        if !studio_active && self.editor.update(host, &self.rig, self.input.cursor, size, left, left_tap, room_id) {\n1180\t            held &= !pav_core::input::buttons::PRIMARY;\n1181\t            pressed &= !pav_core::input::buttons::PRIMARY;\n1182\t        }\n1183\t        let aim = match self.input.last_device {\n1184\t            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\n1185\t            Device::Gamepad => {\n1186\t                let r = self.input.pad.right;\n1187\t                if r.length() > 0.2 {\n1188\t                    let d = self.rig.relative_move(r);\n1189\t                    Some(feet + Vec3::new(d.x, 0.0, d.y) * self.sim_config.bombs.throw_range * r.length().min(1.0))\n1190\t                } else {\n1191\t                    Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)\n1192\t                }\n1193\t            }\n1194\t            Device::Touch => intent.aim.or(Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)),\n1195\t        };\n1196\t        {\n1197\t            let mut i = host.shared.input.lock().unwrap();\n1198\t            if game_input {\n1199\t                let axis = (self.input.move_axis() + intent.move_axis).clamp_length_max(1.0);\n1200\t                i.move_dir = match intent.move_world {\n1201\t                    // Auto-attack stepping in to a foe (only while the stick is still).\n1202\t                    Some(m) if axis == Vec2::ZERO => m,\n1203\t                    _ => self.rig.relative_move(axis),\n1204\t                };\n1205\t                i.held = held;\n1206\t                i.pressed |= pressed;\n1207\t                i.aim = aim;\n1208\t                if let Some(t) = self.latency.pending.take() {\n1209\t                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\n1210\t                }\n1211\t            } else {\n1212\t                *i = InputFrame::default();\n1213\t            }\n1214\t        }\n1215\t\n1216\t        self.rig.update(focus, dt);\n1217\t        self.builder.now = self.started.elapsed().as_secs_f64();\n1218\t        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n1219\t        let events = if studio_active { Vec::new() } else { events };\n1220\t        self.builder.add_events(&events);\n1221\t        // Save the hero on every arrival somewhere, and once a minute while playing.\n1222\t        let travelled = events.iter().any(|e| matches!(e, pav_core::SimEvent::Travel { .. }));\n1223\t        if curr.game.is_some() && (travelled || self.last_save.elapsed().as_secs() >= 60) {\n1224\t            self.last_save = Instant::now();\n1225\t            host.exec(|sim| crate::save::save_from(sim));\n1226\t        }\n1227\t        if let Some(a) = &self.audio {\n1228\t            let (_, right) = self.rig.ground_axes();\n1229\t            let l = pav_audio::Listener { pos: self.rig.target, right };\n1230\t            for e in &events {\n1231\t                if matches!(e, pav_core::SimEvent::Step { .. }) && !self.audio_settings.footsteps {\n1232\t                    continue;\n1233\t                }\n1234\t                a.play_event(e, &l, self.audio_settings.sfx);\n1235\t            }\n1236\t        }\n1237\t        // The look layer (Look & Filters) over the scene's own settings.\n1238\t        let mut view = self.view.clone();\n1239\t        self.look_ui.apply(&mut view);\n1240\t        self.prefs.quality.trim(self.touch_screen, &mut view);\n1241\t        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n1242\t        // Arriving somewhere new: the screen opens with the chosen transition, on the player.\n1243\t        if let Some(t0) = self.arrival {\n1244\t            let t = t0.elapsed().as_secs_f32() / view.filter.transition_time.max(0.05);\n1245\t            match view.filter.transition.kind() {\n1246\t                Some(kind) if t < 1.0 => {\n1247\t                    scene.filter.transition = 1.0 - t * t * (3.0 - 2.0 * t);\n1248\t                    scene.filter.transition_kind = kind;\n1249\t                    scene.filter.transition_center = pav_view::build::screen_uv(&scene.camera, feet + Vec3::Y * 0.9);\n1250\t                }\n1251\t                _ => self.arrival = None,\n1252\t            }\n1253\t        }\n1254\t        if !studio_active {\n1255\t            self.editor.draw_preview(&mut scene);\n1256\t        }\n1257\t        if let Some(a) = intent.aiming.filter(|_| game_input) {\n1258\t            // A skill aimed by hand: a ring where it lands and dots on the way there.\n1259\t            let mark = |at: Vec3, s: f32, color: Vec3| MeshInstance {\n1260\t                mesh: MeshKey::Cylinder,\n1261\t                transform: Mat4::from_scale_rotation_translation(Vec3::new(s, 0.02, s), Quat::IDENTITY, at + Vec3::Y * 0.04),\n1262\t                color,\n1263\t                emissive: 0.6,\n1264\t                style: Style::Unlit,\n1265\t                flags: rflags::NO_SHADOW | rflags::NO_CUT,\n1266\t                group: 0,\n1267\t                material: 0,\n1268\t                ext: Vec3::ZERO,\n1269\t            };\n1270\t            let a = Vec3::new(a.x, feet.y, a.z);\n1271\t            scene.meshes.push(mark(a, 0.9, Vec3::new(1.0, 0.78, 0.4)));\n1272\t            let n = ((a - feet).length() / 0.8) as usize;\n1273\t            for k in 1..n {\n1274\t                scene.meshes.push(mark(feet.lerp(a, k as f32 / n as f32), 0.14, Vec3::new(1.0, 0.9, 0.7)));\n1275\t            }\n1276\t        }\n1277\t        if self.app_settings.aim_marker && game_input && curr.player.is_some() && !self.editor.on && curr.game.is_none() {\n1278\t            if let Some(a) = aim {\n1279\t                let d = Vec2::new(a.x - feet.x, a.z - feet.z);\n1280\t                let a = if d.length() > self.sim_config.bombs.throw_range {\n1281\t                    let d = d.normalize() * self.sim_config.bombs.throw_range;\n1282\t                    Vec3::new(feet.x + d.x, a.y, feet.z + d.y)\n1283\t                } else {\n1284\t                    a\n1285\t                };\n1286\t                scene.meshes.push(MeshInstance {\n1287\t                    mesh: MeshKey::Cylinder,\n1288\t                    transform: Mat4::from_scale_rotation_translation(\n1289\t                        Vec3::new(0.5, 0.02, 0.5),\n1290\t                        Quat::IDENTITY,\n1291\t                        a + Vec3::Y * 0.03,\n1292\t                    ),\n1293\t                    color: Vec3::new(1.0, 0.95, 0.7),\n1294\t                    emissive: 0.0,\n1295\t                    style: Style::Unlit,\n1296\t                    flags: rflags::NO_SHADOW | rflags::NO_CUT,\n1297\t                    group: 0,\n1298\t                    material: 0,\n1299\t                    ext: Vec3::ZERO,\n1300\t                });\n1301\t            }\n1302\t        }\n1303\t\n1304\t        // UI.\n1305\t        let stats = *host.shared.stats.lock().unwrap();\n1306\t        let mut ctl = host.control();\n1307\t        let ctl_before = ctl;\n1308\t        let crash = host.shared.crashed.lock().unwrap().clone();\n1309\t        self.panel.record_timing(dt * 1000.0, stats.tick_ms);\n1310\t        let gfx = self.gfx.as_mut().unwrap();\n1311\t        let (render_scale, lights) =\n1312\t            self.scaler.update(self.prefs.quality, self.touch_screen, dt * 1000.0, gfx.size(), gfx.window.scale_factor() as f32);\n1313\t        gfx.renderer.render_scale = render_scale;\n1314\t        gfx.renderer.max_shadow_lights = lights;\n1315\t        let info = ui::OverlayInfo {\n1316\t            fps: self.fps.fps,\n1317\t            frame_ms: self.fps.frame_ms,\n1318\t            tps: stats.tps,\n1319\t            tick_ms: stats.tick_ms,\n1320\t            tick: stats.tick,\n1321\t            entities: stats.entities,\n1322\t            gpu_errors: gfx.gpu_errors.load(std::sync::atomic::Ordering::Relaxed),\n1323\t            adapter: &gfx.adapter_name,\n1324\t            crash: crash.clone(),\n1325\t            paused: ctl.paused,\n1326\t            speed: ctl.speed,\n1327\t            rewinding,\n1328\t            render_scale,\n1329\t        };\n1330\t        if let Some(t) = self.boot_done_at {\n1331\t            if t.elapsed().as_secs_f32() > 10.0 && self.show_boot {\n1332\t                self.show_boot = false;\n1333\t                self.boot_done_at = None;\n1334\t            }\n1335\t        }\n1336\t        let toast = self.toast.as_ref().filter(|(_, t)| t.elapsed().as_secs_f32() < 3.0).map(|(m, _)| m.clone());\n1337\t        let card_visible = !studio_active && self.hud.card_visible();\n1338\t        let guide_visible =\n1339\t            !studio_active && self.app_settings.show_guide && self.started.elapsed().as_secs_f32() < 25.0 && !card_visible;\n1340\t        let device = self.input.last_device;\n1341\t        let touch_ui = device == Device::Touch;\n1342\t        if touch_ui != self.touch_styled {\n1343\t            self.touch_styled = touch_ui;\n1344\t            pav_ui::touch_style(&self.egui_ctx, touch_ui);\n1345\t        }\n1346\t        self.game_ui.touch = touch_ui;\n1347\t        self.game_ui.tree.touch = touch_ui;\n1348\t        self.touch.swipes.begin_frame();\n1349\t        let touch = &mut self.touch;\n1350\t        let auto_attack = self.prefs.auto_attack;\n1351\t        let tips = touch_ui && !self.prefs.tips_seen && self.started.elapsed().as_secs_f32() < 45.0;\n1352\t        let mut prefs = self.prefs.clone();\n1353\t        let portal = self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town);\n1354\t        let state = self.egui_state.as_mut().unwrap();\n1355\t        let mut raw = state.take(&gfx.window);\n1356\t        raw.events.append(&mut self.pad_events);\n1357\t        let pad_cursor = self.pad_cursor;\n1358\t        let mut show_boot = self.show_boot;\n1359\t        let menu_open = self.menu_open;\n1360\t        let scene_name = self.scene_name.clone();\n1361\t        let mut menu_action = None;\n1362\t        let mut panel_actions = Vec::new();\n1363\t        let mut teleport = None;\n1364\t        let mut save_room = false;\n1365\t        let room_name = self.hud.current.as_ref().map(|r| r.key.clone());\n1366\t        let editor = &mut self.editor;\n1367\t        let hud = &mut self.hud;\n1368\t        let config_before = self.sim_config.clone();\n1369\t        let app_before = self.app_settings.clone();\n1370\t        let panel = &mut self.panel;\n1371\t        let master_before = self.audio_settings.master;\n1372\t        let view_proj = self.rig.view_proj(w as f32 / h.max(1) as f32);\n1373\t        let mut root = Root {\n1374\t            sim: &mut self.sim_config,\n1375\t            camera: &mut self.rig.params,\n1376\t            view: &mut self.view,\n1377\t            app: &mut self.app_settings,\n1378\t            audio: &mut self.audio_settings,\n1379\t        };\n1380\t        let show_stats = root.app.show_stats;\n1381\t        let feel = &mut self.feel;\n1382\t        let physics = &mut self.physics;\n1383\t        let latency = &self.latency;\n1384\t        let hud_ctx = HudCtx { hud: &curr.hud, tick: curr.tick, dt: curr.dt };\n1385\t        let game_frame = curr.game.clone();\n1386\t        let game_ui = &mut self.game_ui;\n1387\t        let look_ui = &mut self.look_ui;\n1388\t        let animation_ui = &mut self.animation_ui;\n1389\t        let asset_ui = &mut self.asset_ui;\n1390\t        let creature_ui = &mut self.creature_ui;\n1391\t        let studio_navigation = self.studio_navigation;\n1392\t        let mut creature_commands = Vec::new();\n1393\t        let mut animation_commands = Vec::new();\n1394\t        let mut asset_commands = Vec::new();\n1395\t        let mut studio_target = None;\n1396\t        #[cfg(not(target_arch = \"wasm32\"))]\n1397\t        let animation_bridge = self.bridge.as_ref().map(|b| b.addr.as_str());\n1398\t        #[cfg(target_arch = \"wasm32\")]\n1399\t        let animation_bridge: Option<&str> = None;\n1400\t        #[cfg(not(target_arch = \"wasm32\"))]\n1401\t        let creature_feedback =\n1402\t            self.bridge.as_ref().and_then(|bridge| bridge.feedback.lock().ok().map(|feedback| feedback.status(None)));\n1403\t        #[cfg(target_arch = \"wasm32\")]\n1404\t        let creature_feedback: Option<serde_json::Value> = None;\n1405\t        let mut look_msg = None;\n1406\t        let guide = &mut self.guide;\n1407\t        let mut guide_out = Vec::new();\n1408\t        let mut game_cmds = Vec::new();\n1409\t        let out = self.egui_ctx.run_ui(raw, |ui| {\n1410\t            let ctx = ui.ctx().clone();\n1411\t            if let Some(c) = &info.crash {\n1412\t                ui::crash_banner(ui, c);\n1413\t            }\n1414\t            panel_actions = panel.ui(ui, &mut root, &mut ctl, &stats);\n1415\t            let free = ui.available_rect_before_wrap();\n1416\t            ui::boot_panel(&ctx, &mut show_boot);\n1417\t            if show_stats {\n1418\t                ui::stats_panel(&ctx, &info, free, touch_ui);\n1419\t            }\n1420\t            if guide_visible && !menu_open && !touch_ui {\n1421\t                ui::guide_panel(&ctx, device, game_frame.is_some());\n1422\t            }\n1423\t            if let Some(g) = &game_frame {\n1424\t                let proj = crate::arpg_ui::Projector { vp: view_proj, size: ctx.content_rect().size() };\n1425\t                crate::arpg_ui::hud(&ctx, g, &proj, device, game_ui.map, &mut touch.swipes);\n1426\t                if !menu_open {\n1427\t                    game_cmds = game_ui.ui(&ctx, g, &proj);\n1428\t                }\n1429\t            }\n1430\t            if touch_ui {\n1431\t                let map_hidden = touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n1432\t                let covered = menu_open || game_ui.any_open() || look_ui.open || guide.station || guide.field;\n1433\t                let points = game_frame.as_ref().and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n1434\t                touch.draw(&ctx, &crate::touch::View { game: game_frame.as_deref(), auto_attack, map_hidden, points, covered });\n1435\t                if tips && !covered {\n1436\t                    ui::touch_tips(&ctx, game_frame.is_some(), &mut touch.swipes);\n1437\t                }\n1438\t            }\n1439\t            if card_visible && !menu_open && hud.card(&ctx, device) {\n1440\t                guide.station = true;\n1441\t            }\n1442\t            if !menu_open {\n1443\t                crate::guide_ui::pad_note(&ctx, hud_ctx.hud, hud_ctx.tick, hud_ctx.dt, touch_ui.then_some(&mut touch.swipes));\n1444\t            }\n1445\t            crate::hud::course_hud(&ctx, &hud_ctx);\n1446\t            pav_ui::game_lines(&ctx, hud_ctx.hud);\n1447\t            if let Some(p) = pad_cursor {\n1448\t                // The gamepad's menu cursor, above everything.\n1449\t                let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new(\"pad_cursor\")));\n1450\t                let tip = egui::Pos2::new(p.x, p.y);\n1451\t                let pts = vec![tip, tip + egui::vec2(0.0, 22.0), tip + egui::vec2(6.0, 16.5), tip + egui::vec2(15.0, 16.0)];\n1452\t                painter.add(egui::Shape::convex_polygon(\n1453\t                    pts,\n1454\t                    egui::Color32::from_rgb(255, 225, 150),\n1455\t                    egui::Stroke::new(1.5, egui::Color32::BLACK),\n1456\t                ));\n1457\t            }\n1458\t            physics.ui(&ctx, &hud_ctx, stats.tps, stats.tick_ms);\n1459\t            crate::hud::hit_flash(&ctx, hud_ctx.hud.invuln);\n1460\t            feel.ui(\n1461\t                &ctx,\n1462\t                &hud_ctx,\n1463\t                latency,\n1464\t                FeelSettings {\n1465\t                    model: &mut root.sim.movement.model,\n1466\t                    tick_rate: &mut root.sim.tick_rate,\n1467\t                    vsync: &mut root.app.vsync,\n1468\t                    smoothing: &mut root.app.smoothing,\n1469\t                },\n1470\t            );\n1471\t            teleport = hud.teleport_menu(&ctx);\n1472\t            hud.error_panel(&ctx);\n1473\t            if !studio_active {\n1474\t                save_room = editor.ui(&ctx, room_name.as_deref());\n1475\t            }\n1476\t            look_msg = look_ui.window(&ctx, root.view);\n1477\t            if studio_navigation || studio_active || animation_ui.open || asset_ui.open || creature_ui.open {\n1478\t                egui::Window::new(\"Studio workspace\")\n1479\t                    .id(egui::Id::new(\"studio_navigation\"))\n1480\t                    .title_bar(false)\n1481\t                    .resizable(false)\n1482\t                    .fixed_pos([16.0, 8.0])\n1483\t                    .show(&ctx, |ui| {\n1484\t                        ui.horizontal(|ui| {\n1485\t                            ui.strong(\"SHARDFALL STUDIO\");\n1486\t                            for (mode, label) in [\n1487\t                                (StudioMode::Animation, \"Animations\"),\n1488\t                                (StudioMode::Prop, \"Objects\"),\n1489\t                                (StudioMode::Creature, \"Creatures\"),\n1490\t                                (StudioMode::World, \"Game\"),\n1491\t                            ] {\n1492\t                                let panel_open = animation_ui.open || asset_ui.open || creature_ui.open;\n1493\t                                let reopen = match mode {\n1494\t                                    StudioMode::World => panel_open,\n1495\t                                    StudioMode::Animation => !animation_ui.open,\n1496\t                                    StudioMode::Prop => !asset_ui.open,\n1497\t                                    StudioMode::Creature => !creature_ui.open,\n1498\t                                };\n1499\t                                if ui.selectable_label(studio_mode == mode, label).clicked() && (studio_mode != mode || reopen) {\n1500\t                                    studio_target = Some(mode);\n1501\t                                }\n1502\t                            }\n1503\t                        });\n1504\t                    });\n1505\t            }\n1506\t            if matches!(studio_mode, StudioMode::Animation | StudioMode::World) {\n1507\t                animation_commands = animation_ui.window(&ctx, curr.animation_preview.as_ref(), animation_bridge);\n1508\t            }\n1509\t            if matches!(studio_mode, StudioMode::Prop | StudioMode::World) {\n1510\t                asset_commands = asset_ui.window(&ctx, &curr, animation_bridge);\n1511\t            }\n1512\t            if matches!(studio_mode, StudioMode::Creature | StudioMode::World) {\n1513\t                creature_commands = creature_ui.window(&ctx, &curr, animation_bridge, creature_feedback.as_ref());\n1514\t            }\n1515\t            let here = hud.current.clone();\n1516\t            guide_out.extend(guide.station(&ctx, here.as_ref(), &mut root));\n1517\t            guide_out.extend(guide.field_guide(&ctx, &hud.entries));\n1518\t            if menu_open {\n1519\t                let difficulty = game_frame.is_some().then_some(&mut root.sim.difficulty);\n1520\t                menu_action = if touch_ui {\n1521\t                    let show_fps = &mut root.app.show_stats;\n1522\t                    let m = ui::TouchMenu { prefs: &mut prefs, show_fps, difficulty, portal, scale: render_scale };\n1523\t                    ui::touch_menu(&ctx, &scene_name, m)\n1524\t                } else {\n1525\t                    ui::pause_menu(&ctx, device, &scene_name, difficulty)\n1526\t                };\n1527\t            }\n1528\t            if let Some(t) = &toast {\n1529\t                if touch_ui {\n1530\t                    ui::toast_touch(&ctx, t, &mut touch.swipes);\n1531\t                } else {\n1532\t                    ui::toast(&ctx, t);\n1533\t                }\n1534\t            }\n1535\t            if !touch_ui {\n1536\t                const GAME_KEYS: &str =\n1537\t                    \"Esc menu · I inventory · P passives · C character · K skills · T town · G use · Space dodge · 1 potion\";\n1538\t                ui::hint_bar(\n1539\t                    &ctx,\n1540\t                    match (device, game_frame.is_some()) {\n1541\t                        (Device::Gamepad, _) => \"Start: menu\",\n1542\t                        (_, true) => GAME_KEYS,\n1543\t                        _ => \"Esc menu · F1 tuning · F2 rooms · F12 screenshot\",\n1544\t                    },\n1545\t                );\n1546\t            }\n1547\t        });\n1548\t        if prefs != self.prefs {\n1549\t            self.prefs = prefs;\n1550\t            crate::save::save_prefs(&self.prefs);\n1551\t        }\n1552\t        // The map: a tap on the minimap opens the big one; a tap or a swipe closes that.\n1553\t        let sw = &mut self.touch.swipes;\n1554\t        if sw.take_tap(egui::Id::new(\"minimap\")) {\n1555\t            self.game_ui.map = true;\n1556\t        }\n1557\t        let big = egui::Id::new(\"big_map\");\n1558\t        if sw.take_tap(big) || sw.is_gone(big, 0) {\n1559\t            self.game_ui.map = false;\n1560\t            sw.restore(big);\n1561\t        }\n1562\t        if !self.prefs.tips_seen && sw.is_gone(egui::Id::new(\"touch_tips\"), 0) {\n1563\t            self.prefs.tips_seen = true;\n1564\t            crate::save::save_prefs(&self.prefs);\n1565\t        }\n1566\t        self.show_boot = show_boot;\n1567\t        for a in guide_out {\n1568\t            match a {\n1569\t                crate::guide_ui::GuideAction::Go(key) => teleport = Some(crate::rooms::TeleportTarget::Room(key)),\n1570\t                crate::guide_ui::GuideAction::Toast(m) => self.toast = Some((m, Instant::now())),\n1571\t            }\n1572\t        }\n1573\t        if let Some(m) = look_msg {\n1574\t            self.toast = Some((m, Instant::now()));\n1575\t        }\n1576\t        self.look_ui.save_if_dirty(false);\n1577\t        for c in game_cmds {\n1578\t            host.shared.command(c);\n1579\t        }\n1580\t        if ctl.paused != ctl_before.paused\n1581\t            || ctl.speed != ctl_before.speed\n1582\t            || ctl.step_requests != ctl_before.step_requests\n1583\t            || ctl.rewind_speed != ctl_before.rewind_speed\n1584\t        {\n1585\t            let c = ctl;\n1586\t            host.set_control(|x| {\n1587\t                x.paused = c.paused;\n1588\t                x.speed = c.speed;\n1589\t                x.step_requests = c.step_requests;\n1590\t                x.rewind_speed = c.rewind_speed;\n1591\t            });\n1592\t        }\n1593\t        if self.sim_config != config_before {\n1594\t            let cfg = self.sim_config.clone();\n1595\t            host.exec(move |sim| sim.config = cfg);\n1596\t            self.config_push_tick = stats.tick.max(curr.tick);\n1597\t        }\n1598\t        if self.app_settings.vsync != app_before.vsync {\n1599\t            gfx.set_vsync(self.app_settings.vsync);\n1600\t        }\n1601\t        if self.audio_settings.master != master_before {\n1602\t            if let Some(a) = &self.audio {\n1603\t                a.set_master(self.audio_settings.master);\n1604\t            }\n1605\t        }\n1606\t        state.platform_output(&gfx.window, out.platform_output);\n1607\t        let ppp = out.pixels_per_point;\n1608\t        let prims = self.egui_ctx.tessellate(out.shapes, ppp);\n1609\t        let mut textures = out.textures_delta;\n1610\t\n1611\t        #[cfg(target_arch = \"wasm32\")]\n1612\t        if self.screenshot_requested {\n1613\t            // Reading pixels back waits on the GPU, which the browser does not allow here.\n1614\t            self.screenshot_requested = false;\n1615\t            self.toast = Some((\"screenshots are not available in the browser\".into(), Instant::now()));\n1616\t        }\n1617\t        #[cfg(not(target_arch = \"wasm32\"))]\n1618\t        if self.screenshot_requested {\n1619\t            self.screenshot_requested = false;\n1620\t            let (w, h) = gfx.size();\n1621\t            let dir = boot::exe_dir().join(\"screenshots\");\n1622\t            let path = dir.join(format!(\n1623\t                \"shardfall-{}.png\",\n1624\t                web_time::SystemTime::now().duration_since(web_time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)\n1625\t            ));\n1626\t            let r = pav_render::capture::render_to_rgba(&mut gfx.renderer, &scene, w, h)\n1627\t                .and_then(|px| pav_render::capture::save_png(&path, w, h, &px));\n1628\t            self.toast = Some((\n1629\t                match r {\n1630\t                    Ok(_) => format!(\"screenshot saved: {}\", path.display()),\n1631\t                    Err(e) => format!(\"screenshot failed: {e:#}\"),\n1632\t                },\n1633\t                Instant::now(),\n1634\t            ));\n1635\t        }\n1636\t\n1637\t        let first = self.boot_done_at.is_none()\n1638\t            && boot::diag().stages.lock().map(|s| !s.iter().any(|s| s.name == \"first frame\")).unwrap_or(false);\n1639\t        let submitted = if first {\n1640\t            let submitted = stage(\"first frame\", || {\n1641\t                let submitted = gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\n1642\t                Ok((submitted, format!(\"{} meshes, {} sdf\", gfx.renderer.stats.mesh_instances, gfx.renderer.stats.sdf_instances)))\n1643\t            });\n1644\t            self.boot_done_at = Some(Instant::now());\n1645\t            log::info!(\"boot complete in {:.0} ms\", boot::diag().start.elapsed().as_secs_f64() * 1000.0);\n1646\t            submitted.unwrap_or(false)\n1647\t        } else {\n1648\t            gfx.draw(&scene, Some((&prims, &mut textures, ppp)))\n1649\t        };\n1650\t        #[cfg(not(target_arch = \"wasm32\"))]\n1651\t        if submitted {\n1652\t            if let Some(bridge) = &self.bridge {\n1653\t                bridge.submitted(curr.live_edit_ticket);\n1654\t            }\n1655\t        }\n1656\t        // Input latency: the frame showing the tick that consumed a press is now submitted.\n1657\t        if submitted {\n1658\t            let mut probe = host.shared.latency_probe.lock().unwrap();\n1659\t            if let Some((pressed_at, ticked_at, tick)) = *probe {\n1660\t                if curr.tick >= tick {\n1661\t                    let now = Instant::now();\n1662\t                    self.latency.record(LatencySample {\n1663\t                        to_tick: (ticked_at - pressed_at).as_secs_f32() * 1000.0,\n1664\t                        to_screen: (now - ticked_at).as_secs_f32() * 1000.0,\n1665\t                    });\n1666\t                    *probe = None;\n1667\t                }\n1668\t            }\n1669\t        }\n1670\t\n1671\t        for a in panel_actions {\n1672\t            self.panel_action(a);\n1673\t        }\n1674\t        if let Some(t) = teleport {\n1675\t            self.teleport(t);\n1676\t        }\n1677\t        if save_room {\n1678\t            if let (Some(host), Some(id)) = (&self.host, room_id) {\n1679\t                let msg = match crate::edit::save_room(host, id) {\n1680\t                    Ok(p) => format!(\"saved {}\", p.display()),\n1681\t                    Err(e) => format!(\"save failed: {e:#}\"),\n1682\t                };\n1683\t                self.editor.status = msg.clone();\n1684\t                self.toast(msg);\n1685\t                if self.watcher.is_none() {\n1686\t                    self.watcher = RoomWatcher::start();\n1687\t                }\n1688\t            }\n1689\t        }\n1690\t        if self.watcher.as_mut().is_some_and(|w| w.poll()) {\n1691\t            self.reload_rooms();\n1692\t        }\n1693\t        if studio_active {\n1694\t            self.ensure_animation_watcher();\n1695\t        }\n1696\t        let animation_updates = self.animation_watcher.as_mut().map(|w| w.poll()).unwrap_or_default();\n1697\t        for update in animation_updates {\n1698\t            match update {\n1699\t                Ok(message) => {\n1700\t                    log::info!(\"{message}\");\n1701\t                    self.animation_ui.status = message;\n1702\t                    self.animation_ui.error = false;\n1703\t                }\n1704\t                Err(error) => {\n1705\t                    log::warn!(\"animation reload: {error}\");\n1706\t                    self.animation_ui.report(Err(error));\n1707\t                }\n1708\t            }\n1709\t        }\n1710\t        for command in animation_commands {\n1711\t            self.studio_command(command);\n1712\t        }\n1713\t        for command in asset_commands {\n1714\t            self.studio_command(command);\n1715\t        }\n1716\t        for command in creature_commands {\n1717\t            self.studio_command(command);\n1718\t        }\n1719\t        for result in self.creature_watcher.poll() {\n1720\t            self.creature_ui.report(result);\n1721\t        }\n1722\t        self.poll_creature_updates();\n1723\t        for update in self.asset_watcher.poll() {\n1724\t            match update {\n1725\t                Ok((name, definition)) => {\n1726\t                    self.asset_ui.status = format!(\"Reloaded {name}\");\n1727\t                    self.asset_ui.error = false;\n1728\t                    #[cfg(not(target_arch = \"wasm32\"))]\n1729\t                    let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1730\t                    #[cfg(target_arch = \"wasm32\")]\n1731\t                    let feedback: Option<pav_tools::live_feedback::SharedFeedback> = None;\n1732\t                    if let Some(host) = &self.host {\n1733\t                        let _ticket = host.query(move |sim| {\n1734\t                            let started = feedback.as_ref().map(|_| std::time::Instant::now());\n1735\t                            if !crate::asset_watch::apply_update(sim, &name, definition) {\n1736\t                                return None;\n1737\t                            }\n1738\t                            if let Some(feedback) = feedback {\n1739\t                                if let Ok(mut feedback) = feedback.lock() {\n1740\t                                    let note = feedback.accepted(\"asset_file_reload\", started.unwrap());\n1741\t                                    sim.live_edit_ticket = note[\"ticket\"].as_u64().unwrap_or_default();\n1742\t                                }\n1743\t                            }\n1744\t                            Some(sim.live_edit_ticket)\n1745\t                        });\n1746\t                        #[cfg(not(target_arch = \"wasm32\"))]\n1747\t                        if let (Some(bridge), Some(ticket)) = (&self.bridge, _ticket.flatten()) {\n1748\t                            bridge.adopted(ticket);\n1749\t                        }\n1750\t                    }\n1751\t                }\n1752\t                Err(error) => {\n1753\t                    log::warn!(\"object reload: {error}\");\n1754\t                    self.asset_ui.report(Err(error));\n1755\t                }\n1756\t            }\n1757\t        }\n1758\t        if let Some(mode) = studio_target {\n1759\t            self.switch_studio(mode);\n1760\t        }\n1761\t        if let Some(a) = menu_action {\n1762\t            self.menu_action(a);\n1763\t        }\n1764\t        // Touch: the bag, the menu, the map button, and taps on the open game.\n1765\t        for c in &intent.ui {\n1766\t            match c {\n1767\t                crate::touch::Control::Bag => {\n1768\t                    let ui = &mut self.game_ui;\n1769\t                    if ui.any_open() {\n1770\t                        ui.close_all();\n1771\t                    } else {\n1772\t                        ui.inventory = true;\n1773\t                    }\n1774\t                }\n1775\t                crate::touch::Control::Menu => {\n1776\t                    let open = !self.menu_open;\n1777\t                    self.set_menu(open);\n1778\t                }\n1779\t                crate::touch::Control::Map => self.touch.swipes.restore(egui::Id::new(\"minimap\")),\n1780\t                _ => {}\n1781\t            }\n1782\t        }\n1783\t        if intent.world_tap {\n1784\t            self.close_on_tap();\n1785\t        }\n1786\t    }\n1787\t\n1788\t    fn panel_action(&mut self, a: PanelAction) {\n1789\t        let Some(host) = &self.host else { return };\n1790\t        let dir = boot::exe_dir();\n1791\t        match a {\n1792\t            PanelAction::Reset => self.reset(),\n1793\t            PanelAction::Scrub(t) => host.set_control(|c| {\n1794\t                c.paused = true;\n1795\t                c.scrub = Some(t);\n1796\t            }),\n1797\t            PanelAction::SaveSnapshot => {\n1798\t                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n1799\t                let r = host.query(move |sim| sim.save_state(&path).map(|_| path.display().to_string()));\n1800\t                match r {\n1801\t                    Some(Ok(p)) => self.toast(format!(\"snapshot saved: {p}\")),\n1802\t                    Some(Err(e)) => self.toast(format!(\"snapshot failed: {e:#}\")),\n1803\t                    None => self.toast(\"snapshot timed out\"),\n1804\t                }\n1805\t            }\n1806\t            PanelAction::LoadSnapshot => {\n1807\t                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n1808\t                let r = host.query(move |sim| sim.load_state(&path));\n1809\t                match r {\n1810\t                    Some(Ok(())) => self.toast(\"snapshot loaded\"),\n1811\t                    Some(Err(e)) => self.toast(format!(\"load failed: {e:#}\")),\n1812\t                    None => self.toast(\"load timed out\"),\n1813\t                }\n1814\t            }\n1815\t            PanelAction::SaveReplay => {\n1816\t                let path = dir.join(\"replays\").join(\"last.replay.json\");\n1817\t                let r = host.query(move |sim| -> Result<String> {\n1818\t                    let mut rep = sim.recording.clone();\n1819\t                    rep.final_hash = Some(format!(\"{:016x}\", sim.state_hash()));\n1820\t                    std::fs::create_dir_all(path.parent().unwrap())?;\n1821\t                    std::fs::write(&path, serde_json::to_string(&rep)?)?;\n1822\t                    Ok(path.display().to_string())\n1823\t                });\n1824\t                match r {\n1825\t                    Some(Ok(p)) => self.toast(format!(\"replay saved: {p}\")),\n1826\t                    Some(Err(e)) => self.toast(format!(\"replay failed: {e:#}\")),\n1827\t                    None => self.toast(\"replay timed out\"),\n1828\t                }\n1829\t            }\n1830\t            PanelAction::Look => self.look_ui.open = true,\n1831\t            PanelAction::Status(s) => {\n1832\t                self.panel.status(s.clone());\n1833\t                self.toast(s);\n1834\t            }\n1835\t        }\n1836\t    }\n1837\t\n1838\t    /// Use the registered tools for UI edits too. This keeps validation, undo, and\n1839\t    /// persistence identical for a user and an LLM.\n1840\t    fn studio_command(&mut self, command: crate::animation_ui::Command) {\n1841\t        let Some(host) = &self.host else { return };\n1842\t        let asset = command.tool.starts_with(\"asset\");\n1843\t        let creature = command.tool.starts_with(\"creature\");\n1844\t        #[cfg(not(target_arch = \"wasm32\"))]\n1845\t        if let Some(bridge) = &self.bridge {\n1846\t            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n1847\t                Ok(Some(look)) => self.look_ui.set_look(look),\n1848\t                Ok(None) => {}\n1849\t                Err(error) => {\n1850\t                    let message = format!(\"The previous live edit is still pending: {error:#}\");\n1851\t                    if creature {\n1852\t                        self.creature_ui.report(Err(message));\n1853\t                    } else if asset {\n1854\t                        self.asset_ui.report(Err(message));\n1855\t                    } else {\n1856\t                        self.animation_ui.report(Err(message));\n1857\t                    }\n1858\t                    return;\n1859\t                }\n1860\t            }\n1861\t        }\n1862\t        let rig = self.rig.clone();\n1863\t        let view = self.view.clone();\n1864\t        let look = self.look_ui.look().clone();\n1865\t        #[cfg(not(target_arch = \"wasm32\"))]\n1866\t        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1867\t        #[cfg(target_arch = \"wasm32\")]\n1868\t        let feedback = None;\n1869\t        let reply = host.query(move |sim| {\n1870\t            let live = std::mem::replace(sim, Sim::empty(1));\n1871\t            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n1872\t            session.look = look;\n1873\t            session.feedback = feedback;\n1874\t            let result = pav_tools::tools::call(&mut session, command.tool, &command.args)\n1875\t                .map(|out| match out {\n1876\t                    pav_tools::Output::Json(v) => v,\n1877\t                    pav_tools::Output::Image { meta, .. } => meta,\n1878\t                })\n1879\t                .map_err(|e| format!(\"{e:#}\"));\n1880\t            let (live, rig, view, _) = session.into_live();\n1881\t            let ticket = live.live_edit_ticket;\n1882\t            *sim = live;\n1883\t            (result, rig, view, ticket)\n1884\t        });\n1885\t        let result = match reply {\n1886\t            Some((result, rig, view, _ticket)) => {\n1887\t                self.rig = rig;\n1888\t                self.view = view;\n1889\t                #[cfg(not(target_arch = \"wasm32\"))]\n1890\t                if let Some(bridge) = &self.bridge {\n1891\t                    bridge.adopted(_ticket);\n1892\t                }\n1893\t                result\n1894\t            }\n1895\t            None => Err(\"The studio command did not answer. Check the game log.\".into()),\n1896\t        };\n1897\t        if creature {\n1898\t            self.creature_ui.report_command(result);\n1899\t        } else if asset {\n1900\t            self.asset_ui.report(result);\n1901\t        } else {\n1902\t            self.animation_ui.report(result);\n1903\t        }\n1904\t        self.ensure_animation_watcher();\n1905\t    }\n1906\t\n1907\t    /// Adopt completed jobs on the live simulation thread, with the bridge camera current.\n1908\t    fn poll_creature_updates(&mut self) {\n1909\t        if !pav_tools::creature_tools::has_updates() {\n1910\t            return;\n1911\t        }\n1912\t        let Some(host) = &self.host else { return };\n1913\t        #[cfg(not(target_arch = \"wasm32\"))]\n1914\t        if let Some(bridge) = &self.bridge {\n1915\t            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n1916\t                Ok(Some(look)) => self.look_ui.set_look(look),\n1917\t                Ok(None) => {}\n1918\t                Err(_) => return,\n1919\t            }\n1920\t        }\n1921\t        let rig = self.rig.clone();\n1922\t        let view = self.view.clone();\n1923\t        let look = self.look_ui.look().clone();\n1924\t        #[cfg(not(target_arch = \"wasm32\"))]\n1925\t        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n1926\t        #[cfg(target_arch = \"wasm32\")]\n1927\t        let feedback = None;\n1928\t        if let Some((reports, rig, view, ticket)) = host.query(move |sim| {\n1929\t            let live = std::mem::replace(sim, Sim::empty(1));\n1930\t            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n1931\t            session.look = look;\n1932\t            session.feedback = feedback;\n1933\t            let reports = pav_tools::creature_tools::poll(&mut session);\n1934\t            let (live, rig, view, _) = session.into_live();\n1935\t            let ticket = live.live_edit_ticket;\n1936\t            *sim = live;\n1937\t            (reports, rig, view, ticket)\n1938\t        }) {\n1939\t            self.rig = rig;\n1940\t            self.view = view;\n1941\t            #[cfg(not(target_arch = \"wasm32\"))]\n1942\t            if let Some(bridge) = &self.bridge {\n1943\t                bridge.adopted(ticket);\n1944\t            }\n1945\t            #[cfg(target_arch = \"wasm32\")]\n1946\t            let _ = ticket;\n1947\t            for report in reports {\n1948\t                self.creature_ui.report(Ok(report));\n1949\t            }\n1950\t        }\n1951\t    }\n1952\t\n1953\t    fn switch_studio(&mut self, mode: StudioMode) {\n1954\t        self.studio_navigation = true;\n1955\t        self.set_menu(false);\n1956\t        #[cfg(not(target_arch = \"wasm32\"))]\n1957\t        if mode != StudioMode::World {\n1958\t            if mode == StudioMode::Animation {\n1959\t                if let Err(error) = pav_tools::animation_tools::reload_authored() {\n1960\t                    self.animation_ui.report(Err(format!(\"Could not load saved animations: {error:#}\")));\n1961\t                }\n1962\t            }\n1963\t            if self.bridge.is_none() {\n1964\t                match crate::bridge::Bridge::start(pav_tools::bridge::DEFAULT_ADDR) {\n1965\t                    Ok(bridge) => self.bridge = Some(bridge),\n1966\t                    Err(error) => {\n1967\t                        let message = format!(\"Could not open the live bridge: {error}\");\n1968\t                        if mode == StudioMode::Creature {\n1969\t                            self.creature_ui.report(Err(message));\n1970\t                        } else if mode == StudioMode::Prop {\n1971\t                            self.asset_ui.report(Err(message));\n1972\t                        } else {\n1973\t                            self.animation_ui.report(Err(message));\n1974\t                        }\n1975\t                    }\n1976\t                }\n1977\t            }\n1978\t        }\n1979\t        self.animation_ui.open = mode == StudioMode::Animation;\n1980\t        self.asset_ui.open = mode == StudioMode::Prop;\n1981\t        self.creature_ui.open = mode == StudioMode::Creature;\n1982\t        let tool = match mode {\n1983\t            StudioMode::Animation => \"anim_preview\",\n1984\t            StudioMode::Prop => \"asset_preview\",\n1985\t            StudioMode::Creature => \"creature_preview\",\n1986\t            StudioMode::World if self.studio_mode == StudioMode::Creature => \"creature_preview\",\n1987\t            StudioMode::World if self.studio_mode == StudioMode::Prop => \"asset_preview\",\n1988\t            StudioMode::World => \"anim_preview\",\n1989\t        };\n1990\t        let action = if mode == StudioMode::World { \"close\" } else { \"open\" };\n1991\t        self.studio_command(crate::animation_ui::Command {\n1992\t            tool,\n1993\t            args: serde_json::json!({\"action\":action}).as_object().unwrap().clone(),\n1994\t        });\n1995\t    }\n1996\t\n1997\t    fn ensure_animation_watcher(&mut self) {\n1998\t        // An agent may create the first animation directory through the bridge. Attach\n1999\t        // then, but do not retry a failed native watcher on every frame.\n2000\t        if !self.animation_watch_attempted && crate::animation_watch::AnimationWatcher::directory_exists() {\n2001\t            self.animation_watch_attempted = true;\n2002\t            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n2003\t        }\n2004\t    }\n2005\t\n2006\t    fn menu_action(&mut self, a: MenuAction) {\n2007\t        match a {\n2008\t            MenuAction::Resume => self.set_menu(false),\n2009\t            MenuAction::AnimationStudio => self.switch_studio(StudioMode::Animation),\n2010\t            MenuAction::AssetStudio => self.switch_studio(StudioMode::Prop),\n2011\t            MenuAction::CreatureStudio => self.switch_studio(StudioMode::Creature),\n2012\t            MenuAction::Reset => {\n2013\t                self.set_menu(false);\n2014\t                self.reset();\n2015\t            }\n2016\t            MenuAction::LoadScene(name) => {\n2017\t                self.set_menu(false);\n2018\t                self.load_scene(&name);\n2019\t            }\n2020\t            MenuAction::NewHero => {\n2021\t                self.set_menu(false);\n2022\t                if let Some(host) = &self.host {\n2023\t                    let (cfg, seed) = (self.sim_config.clone(), self.settings.seed);\n2024\t                    host.exec(move |sim| {\n2025\t                        crate::save::erase();\n2026\t                        if let Ok(mut fresh) = Sim::new(\"town\", seed) {\n2027\t                            fresh.config = cfg;\n2028\t                            *sim = fresh;\n2029\t                        }\n2030\t                    });\n2031\t                }\n2032\t                self.scene_name = \"town\".into();\n2033\t                self.toast(\"a new hero arrives in Emberwatch\");\n2034\t            }\n2035\t            MenuAction::Tuning => {\n2036\t                self.set_menu(false);\n2037\t                self.panel.open = true;\n2038\t            }\n2039\t            MenuAction::Look => {\n2040\t                self.set_menu(false);\n2041\t                self.look_ui.open = true;\n2042\t            }\n2043\t            MenuAction::Guide => {\n2044\t                self.set_menu(false);\n2045\t                if self.hud.current.is_some() {\n2046\t                    self.guide.station = true;\n2047\t                } else {\n2048\t                    self.guide.field = true;\n2049\t                }\n2050\t            }\n2051\t            MenuAction::FieldGuide => {\n2052\t                self.set_menu(false);\n2053\t                self.guide.field = true;\n2054\t            }\n2055\t            MenuAction::Rooms => {\n2056\t                self.set_menu(false);\n2057\t                self.open_teleport();\n2058\t            }\n2059\t            MenuAction::RoomCard => {\n2060\t                self.set_menu(false);\n2061\t                self.hud.show_card();\n2062\t            }\n2063\t            MenuAction::Screenshot => {\n2064\t                self.set_menu(false);\n2065\t                self.screenshot_requested = true;\n2066\t            }\n2067\t            MenuAction::Feel => {\n2068\t                self.set_menu(false);\n2069\t                self.feel.open = !self.feel.open;\n2070\t                self.feel.auto = false;\n2071\t            }\n2072\t            MenuAction::Physics => {\n2073\t                self.set_menu(false);\n2074\t                self.physics.open = !self.physics.open;\n2075\t                self.physics.auto = false;\n2076\t            }\n2077\t            MenuAction::Quit => {\n2078\t                self.look_ui.save_if_dirty(true);\n2079\t                self.quit = true;\n2080\t            }\n2081\t            MenuAction::TownPortal => {\n2082\t                self.set_menu(false);\n2083\t                if let Some(host) = &self.host {\n2084\t                    host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n2085\t                }\n2086\t            }\n2087\t            MenuAction::Fullscreen => {\n2088\t                if let Some(g) = &self.gfx {\n2089\t                    crate::platform::toggle_fullscreen(&g.window);\n2090\t                }\n2091\t            }\n2092\t        }\n2093\t    }\n2094\t}\n2095\t\n2096\timpl App {\n2097\t    /// The browser only allows sound after the first click or key press.\n2098\t    #[cfg(target_arch = \"wasm32\")]\n2099\t    fn resume_audio(&mut self) {\n2100\t        if !self.audio_resumed {\n2101\t            self.audio_resumed = true;\n2102\t            if let Some(a) = &self.audio {\n2103\t                a.resume();\n2104\t            }\n2105\t        }\n2106\t    }\n2107\t\n2108\t    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n2109\t    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n2110\t        let msg = format!(\"{e:#}\");\n2111\t        #[cfg(target_arch = \"wasm32\")]\n2112\t        crate::platform::error_box(\"Shardfall could not start\", &msg);\n2113\t        self.fatal = Some(msg);\n2114\t        el.exit();\n2115\t    }\n2116\t}\n2117\t\n2118\timpl ApplicationHandler for App {\n2119\t    fn resumed(&mut self, el: &ActiveEventLoop) {\n2120\t        if self.init_started || self.fatal.is_some() {\n2121\t            return;\n2122\t        }\n2123\t        self.init_started = true;\n2124\t        if let Err(e) = self.init(el) {\n2125\t            self.fail(el, e);\n2126\t        }\n2127\t    }\n2128\t\n2129\t    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n2130\t        if let WindowEvent::Touch(t) = &event {\n2131\t            self.on_touch(t, &event);\n2132\t            return;\n2133\t        }\n2134\t        let consumed = match (&mut self.egui_state, &self.gfx) {\n2135\t            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n2136\t            _ => false,\n2137\t        };\n2138\t        match event {\n2139\t            WindowEvent::CloseRequested => {\n2140\t                if let Some(host) = &self.host {\n2141\t                    host.exec(|sim| crate::save::save_from(sim));\n2142\t                }\n2143\t                self.look_ui.save_if_dirty(true);\n2144\t                el.exit()\n2145\t            }\n2146\t            WindowEvent::Focused(false) => {\n2147\t                self.input.clear();\n2148\t                self.touch.clear();\n2149\t            }\n2150\t            WindowEvent::Resized(sz) => {\n2151\t                if let Some(g) = &mut self.gfx {\n2152\t                    g.resize(sz.width, sz.height);\n2153\t                }\n2154\t            }\n2155\t            WindowEvent::RedrawRequested => {\n2156\t                self.frame();\n2157\t                if self.quit {\n2158\t                    el.exit();\n2159\t                }\n2160\t            }\n2161\t            WindowEvent::KeyboardInput { event, .. } => {\n2162\t                #[cfg(target_arch = \"wasm32\")]\n2163\t                self.resume_audio();\n2164\t                if let PhysicalKey::Code(code) = event.physical_key {\n2165\t                    let system = matches!(\n2166\t                        code,\n2167\t                        KeyCode::Escape\n2168\t                            | KeyCode::F1\n2169\t                            | KeyCode::F2\n2170\t                            | KeyCode::F3\n2171\t                            | KeyCode::F4\n2172\t                            | KeyCode::F5\n2173\t                            | KeyCode::F6\n2174\t                            | KeyCode::F7\n2175\t                            | KeyCode::F8\n2176\t                            | KeyCode::F9\n2177\t                            | KeyCode::F10\n2178\t                            | KeyCode::F11\n2179\t                            | KeyCode::F12\n2180\t                    );\n2181\t                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n2182\t                        self.handle_key(code);\n2183\t                        if !system && !consumed {\n2184\t                            self.latency.press();\n2185\t                        }\n2186\t                    }\n2187\t                    if !consumed || event.state == ElementState::Released {\n2188\t                        self.input.key(code, event.state);\n2189\t                    }\n2190\t                }\n2191\t            }\n2192\t            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n2193\t                let lines = match delta {\n2194\t                    MouseScrollDelta::LineDelta(_, y) => y,\n2195\t                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n2196\t                };\n2197\t                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n2198\t            }\n2199\t            WindowEvent::MouseInput { state, button, .. } => {"}]},"parent_tool_use_id":null,"session_id":"eb3d8a44-de88-4121-ac6f-adf7ca0c1ca2","uuid":"a6f26c2e-4f5c-4c3b-854e-e0538510fbb0","timestamp":"2026-11-05T04:21:52.670Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211911__x2c3ab6/work/.research/shardfall/crates/pav_app/src/app.rs","content":"                if ok { format!(\"went to {key}\") } else { format!(\"could not go to {key}\") }\n            }\n            TeleportTarget::Hub => {\n                host.exec(|sim| {\n                    if let Some(pid) = sim.state.player {\n                        sim.set_position(pid, Vec3::new(0.0, 0.0, 6.0));\n                    }\n                });\n                \"went to the plaza\".into()\n            }\n            TeleportTarget::Wilderness => {\n                let a = self.started.elapsed().as_secs_f32() * 7.3;\n                let p = Vec3::new(a.cos(), 0.0, a.sin()) * 220.0 + Vec3::Y * 25.0;\n                host.exec(move |sim| {\n                    sim.state.world.interest.push(p);\n                    sim.update_streaming(usize::MAX);\n                    sim.state.world.interest.pop();\n                    if let Some(pid) = sim.state.player {\n                        sim.set_position(pid, p);\n                    }\n                });\n                \"went to the wilderness\".into()\n            }\n        };\n        self.toast(msg);\n    }\n\n    fn open_teleport(&mut self) {\n        if let Some(host) = &self.host {\n            if let Some(e) = host.query(|sim| room_entries(sim)) {\n                self.hud.entries = e;\n            }\n        }\n        self.hud.teleport_open = true;\n    }\n\n    /// Hot reload: re-read room files and rebuild what changed.\n    fn reload_rooms(&mut self) {\n        let Some(host) = &self.host else { return };\n        let dir = self.watcher.as_ref().map(|w| w.dir.clone());\n        let sources = pav_core::room::load_sources(dir.as_deref());\n        let (defs, errors) = pav_core::room::parse_all(&sources);\n        self.hud.errors = errors.iter().map(|(k, e)| format!(\"{k}: {e}\")).collect();\n        for e in &self.hud.errors {\n            log::error!(\"room file: {e}\");\n        }\n        let bad: Vec<String> = errors.into_iter().map(|(k, _)| k).collect();\n        let changed = host\n            .query(move |sim| {\n                // Rooms whose file is broken keep their current definition.\n                let mut defs = defs;\n                for k in &bad {\n                    if let Some(r) = sim.state.world.room(k) {\n                        defs.push((k.clone(), (*r.def).clone()));\n                    }\n                }\n                pav_tools::tools::reload_rooms(sim, defs)\n            })\n            .unwrap_or(0);\n        if self.hud.errors.is_empty() {\n            self.toast(format!(\"rooms reloaded ({changed} changed)\"));\n        }\n    }\n\n    fn set_menu(&mut self, open: bool) {\n        let Some(host) = &self.host else { return };\n        if open && !self.menu_open {\n            self.paused_before_menu = host.control().paused;\n            host.set_control(|c| c.paused = true);\n        } else if !open && self.menu_open {\n            let p = self.paused_before_menu;\n            host.set_control(|c| c.paused = p);\n        }\n        self.menu_open = open;\n        self.input.clear();\n    }\n\n    /// The fixed system layer: never rebinds, works in every room.\n    fn handle_key(&mut self, code: KeyCode) {\n        let Some(host) = &self.host else { return };\n        if self.studio_mode == StudioMode::Animation {\n            if let Some(p) = host.frames().1.animation_preview.as_ref() {\n                let args = match code {\n                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n                    _ => None,\n                };\n                if let Some(args) = args {\n                    self.studio_command(crate::animation_ui::Command {\n                        tool: \"anim_preview\",\n                        args: args.as_object().unwrap().clone(),\n                    });\n                    return;\n                }\n            }\n        }\n        if self.studio_mode == StudioMode::Prop {\n            if let Some(p) = host.frames().1.prop_preview.as_ref() {\n                let args = match code {\n                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n                    KeyCode::F7 => Some(serde_json::json!({\"playing\": false, \"time\": p.time + 1.0 / 60.0})),\n                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n                    _ => None,\n                };\n                if let Some(args) = args {\n                    self.studio_command(crate::animation_ui::Command {\n                        tool: \"asset_preview\",\n                        args: args.as_object().unwrap().clone(),\n                    });\n                    return;\n                }\n            }\n        }\n        if self.studio_mode == StudioMode::Creature {\n            if let Some(p) = host.frames().1.creature_preview.as_ref() {\n                let args = match code {\n                    KeyCode::F6 => Some(serde_json::json!({\"playing\": !p.playing})),\n                    KeyCode::F7 => Some(serde_json::json!({\"step\": 1})),\n                    KeyCode::F8 => Some(serde_json::json!({\"speed\": (p.speed * 0.5).max(0.05)})),\n                    KeyCode::F9 => Some(serde_json::json!({\"speed\": (p.speed * 2.0).min(8.0)})),\n                    _ => None,\n                };\n                if let Some(args) = args {\n                    self.studio_command(crate::animation_ui::Command {\n                        tool: \"creature_preview\",\n                        args: args.as_object().unwrap().clone(),\n                    });\n                    return;\n                }\n            }\n        }\n        // Shardfall's menu keys.\n        if self.input.game && !self.menu_open && self.studio_mode == StudioMode::World {\n            let ui = &mut self.game_ui;\n            match code {\n                KeyCode::KeyI | KeyCode::Tab => {\n                    ui.inventory = !ui.inventory;\n                    return;\n                }\n                KeyCode::KeyC => {\n                    ui.character = !ui.character;\n                    return;\n                }\n                KeyCode::KeyK => {\n                    ui.skills = !ui.skills;\n                    return;\n                }\n                KeyCode::KeyP => {\n                    ui.tree.open = !ui.tree.open;\n                    return;\n                }\n                KeyCode::KeyM => {\n                    ui.map = !ui.map;\n                    return;\n                }\n                KeyCode::KeyT => {\n                    // Town portal: home from anywhere.\n                    if self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town) {\n                        host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n                    }\n                    return;\n                }\n                KeyCode::Escape if ui.any_open() => {\n                    ui.close_all();\n                    return;\n                }\n                _ => {}\n            }\n        }\n        match code {\n            KeyCode::Escape => {\n                let open = !self.menu_open;\n                self.set_menu(open);\n            }\n            KeyCode::F1 => self.panel.open = !self.panel.open,\n            // How the room you are in works (outside the rooms: the field guide).\n            KeyCode::KeyH if !self.input.game => {\n                if self.hud.current.is_some() {\n                    self.guide.station = !self.guide.station;\n                } else {\n                    self.guide.field = !self.guide.field;\n                }\n            }\n            KeyCode::F2 => {\n                if self.hud.teleport_open {\n                    self.hud.teleport_open = false;\n                } else {\n                    self.open_teleport();\n                }\n            }\n            KeyCode::F3 => self.show_boot = !self.show_boot,\n            KeyCode::F4 => {\n                host.exec(|sim| {\n                    sim.leave_room();\n                });\n                self.toast(\"left the room\");\n            }\n            KeyCode::F5 => self.reset_room(),\n            KeyCode::F6 => host.set_control(|c| c.paused = !c.paused),\n            KeyCode::F7 => host.set_control(|c| {\n                c.paused = true;\n                c.step_requests += 1;\n            }),\n            KeyCode::F8 => host.set_control(|c| c.speed = (c.speed * 0.5).max(0.0625)),\n            KeyCode::F9 => host.set_control(|c| c.speed = (c.speed * 2.0).min(8.0)),\n            KeyCode::F10 if self.studio_mode == StudioMode::World => {\n                self.editor.on = !self.editor.on;\n                self.editor.dragging = None;\n                let on = self.editor.on;\n                self.toast(if on { \"edit mode on\" } else { \"edit mode off\" });\n            }\n            KeyCode::F11 => {\n                if let Some(g) = &self.gfx {\n                    let fs = g.window.fullscreen().is_some();\n                    g.window.set_fullscreen(if fs { None } else { Some(Fullscreen::Borderless(None)) });\n                }\n            }\n            KeyCode::F12 => self.screenshot_requested = true,\n            _ => {\n                let digits = [\n                    KeyCode::Digit1,\n                    KeyCode::Digit2,\n                    KeyCode::Digit3,\n                    KeyCode::Digit4,\n                    KeyCode::Digit5,\n                    KeyCode::Digit6,\n                    KeyCode::Digit7,\n                    KeyCode::Digit8,\n                ];\n                // (In Shardfall the number keys are potions and belt items.)\n                let digit =\n                    digits.iter().position(|k| *k == code).filter(|i| *i < CameraParams::PRESETS.len() && !self.input.game);\n                if let Some(i) = digit {\n                    let yaw = self.rig.params.yaw;\n                    self.rig.params = (CameraParams::PRESETS[i].1)();\n                    if CameraParams::PRESETS[i].0 != \"isometric\" {\n                        self.rig.params.yaw = yaw;\n                    }\n                    self.toast(format!(\"camera: {}\", CameraParams::PRESETS[i].0));\n                }\n            }\n        }\n    }\n\n    fn frame(&mut self) {\n        if self.gfx.is_none() || self.host.is_none() {\n            return;\n        }\n        // Touch screens draw at most 60 frames a second (a phone with a faster screen would\n        // spend battery and heat on the rest).\n        if self.touch_screen {\n            let now = Instant::now();\n            let step = std::time::Duration::from_micros(16_667);\n            if now + std::time::Duration::from_micros(2_500) < self.next_draw {\n                return;\n            }\n            self.next_draw = if now > self.next_draw + step { now + step } else { self.next_draw + step };\n        }\n        let now = Instant::now();\n        let dt = (now - self.last).as_secs_f32().min(0.1);\n        self.last = now;\n        self.fps.frames += 1;\n        let since = self.fps.since.elapsed().as_secs_f32();\n        if since >= 0.5 {\n            self.fps.fps = self.fps.frames as f32 / since;\n            self.fps.frame_ms = since * 1000.0 / self.fps.frames as f32;\n            self.fps.frames = 0;\n            self.fps.since = now;\n        }\n\n        // Devices.\n        self.input.poll_gamepad();\n        if self.input.pad.start_pressed {\n            let open = !self.menu_open;\n            self.set_menu(open);\n        }\n        if self.input.pad.map_pressed {\n            self.game_ui.map = !self.game_ui.map;\n        }\n        self.pad_menus(dt);\n        let pad = self.input.last_device == Device::Gamepad;\n        self.game_ui.pad = pad;\n        self.game_ui.tree.pad = pad;\n        self.rig.params.yaw = (self.rig.params.yaw + self.input.pad.rotate * 90.0 * dt + 540.0).rem_euclid(360.0) - 180.0;\n        self.rig.params.distance = (self.rig.params.distance * (1.0 + self.input.pad.zoom * dt)).clamp(2.0, 120.0);\n\n        let host = self.host.as_ref().unwrap();\n        host.pump();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(b) = &self.bridge {\n            // Agent tools run on the simulation thread and can change the camera, view and look.\n            if let Some(l) = b.poll(host, &mut self.rig, &mut self.view, self.look_ui.look()) {\n                self.look_ui.set_look(l);\n            }\n        }\n        let ui_wants_keys = self.egui_ctx.egui_wants_keyboard_input();\n        let game_input = !self.menu_open && !ui_wants_keys;\n        let rewinding = game_input && self.studio_mode == StudioMode::World && self.input.rewind_held();\n        host.set_control(|c| c.rewinding = rewinding);\n\n        let (prev, curr, curr_at, tick_wall) = host.frames();\n        let studio_mode = curr.studio_mode();\n        let studio_active = curr.studio_active();\n        self.studio_navigation |= studio_active;\n        let snap_camera = studio_mode != self.studio_mode\n            || prev.studio_mode() != studio_mode\n            || prev.live_edit_ticket != curr.live_edit_ticket;\n        let game_input = game_input && !studio_active;\n        if studio_mode != self.studio_mode {\n            let keep_object_redo = studio_mode == StudioMode::World && self.asset_ui.open && self.asset_ui.creation_removed();\n            let keep_creature_redo =\n                studio_mode == StudioMode::World && self.creature_ui.open && self.creature_ui.creation_removed();\n            self.builder = ViewBuilder::new();\n            if let Some(gfx) = &mut self.gfx {\n                gfx.renderer.clear_particles();\n            }\n            self.studio_mode = studio_mode;\n            self.animation_ui.open = studio_mode == StudioMode::Animation;\n            self.asset_ui.open = studio_mode == StudioMode::Prop || keep_object_redo;\n            self.creature_ui.open = studio_mode == StudioMode::Creature || keep_creature_redo;\n        }\n        if !studio_active {\n            let room_before = self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def)));\n            let quarters = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n            self.director.update(&curr.hud, quarters, &mut self.rig);\n            let room_id_before = self.hud.current.as_ref().map(|r| r.id);\n            self.hud.update(&curr.room, &mut self.rig);\n            // Rooms and pads can change view settings (night lighting, bloom, filters).\n            let key = (curr.room.as_ref().map(|r| r.id), curr.hud.view_serial);\n            if key != self.view_key {\n                self.view_key = key;\n                if let Some(b) = self.view_base.take() {\n                    self.view = b;\n                }\n                let q = curr.room.as_ref().map(|r| r.quarters).unwrap_or(0);\n                let room = curr.room.as_ref().map(|r| pav_view::build::room_view_map(&r.def.view, q)).unwrap_or_default();\n                let pads = pav_view::build::room_view_map(&curr.hud.view, q);\n                if !room.is_empty() || !pads.is_empty() {\n                    self.view_base = Some(self.view.clone());\n                    for u in self.view.apply(&room).into_iter().chain(self.view.apply(&pads)) {\n                        log::warn!(\"unknown view setting '{u}'\");\n                    }\n                }\n            }\n            if self.hud.current.as_ref().map(|r| r.id) != room_id_before {\n                // Rooms can open HUD overlays (feel metrics) while you are inside.\n                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"feel\"));\n                if wants && !self.feel.open {\n                    self.feel.open = true;\n                    self.feel.auto = true;\n                } else if !wants && self.feel.auto {\n                    self.feel.open = false;\n                    self.feel.auto = false;\n                }\n                let wants = self.hud.current.as_ref().is_some_and(|r| r.def.overlays.iter().any(|o| o == \"physics\"));\n                if wants && !self.physics.open {\n                    self.physics.open = true;\n                    self.physics.auto = true;\n                } else if !wants && self.physics.auto {\n                    self.physics.open = false;\n                    self.physics.auto = false;\n                }\n            }\n            self.feel.record(curr.tick, curr.hud.feel.speed);\n            if self.hud.current.as_ref().map(|r| (r.id, std::sync::Arc::as_ptr(&r.def))) != room_before {\n                // Input switching: the room's key overrides apply while inside.\n                let (b, errs) = match &self.hud.current {\n                    Some(r) => crate::input::Bindings::with_overrides(&r.def.keys),\n                    None if curr.game.is_some() => (crate::input::Bindings::game(), Vec::new()),\n                    None => (crate::input::Bindings::default(), Vec::new()),\n                };\n                self.input.bindings = b;\n                for e in errs {\n                    log::warn!(\"room keys: {e}\");\n                }\n            }\n            if *curr.config != self.sim_config && curr.tick > self.config_push_tick + 3 {\n                // The simulation changed its configuration (room overrides): adopt it.\n                self.sim_config = (*curr.config).clone();\n            }\n            // Entering or leaving Shardfall: its controls, camera and look.\n            let game_mode = curr.game.is_some();\n            if game_mode != self.input.game {\n                self.input.game = game_mode;\n                self.input.bindings = if game_mode { crate::input::Bindings::game() } else { crate::input::Bindings::default() };\n                self.rig.blend_from_current(0.5);\n                if game_mode {\n                    self.game_saved = Some((self.rig.params.clone(), self.view.clone()));\n                    self.rig.params = CameraParams {\n                        tilt: 56.0,\n                        yaw: 0.0,\n                        distance: 15.5,\n                        fov: 40.0,\n                        ortho: false,\n                        follow_lag: 0.06,\n                        height_offset: 0.8,\n                    };\n                    let v = &mut self.view;\n                    v.bloom = 0.55;\n                    v.bloom_threshold = 1.0;\n                    v.sky = \"#14161c\".into();\n                    v.light.sun_elevation = 52.0;\n                    v.light.sun_azimuth = 35.0;\n                    v.light.sun_intensity = 0.95;\n                    v.light.ambient = 0.5;\n                    v.saturation = 1.08;\n                    v.fog = false;\n                } else if let Some((cam, view)) = self.game_saved.take() {\n                    self.rig.params = cam;\n                    self.view = view;\n                }\n            }\n            self.game_frame = curr.game.clone();\n            if !game_mode {\n                self.game_ui.close_all();\n                self.game_place = None;\n            }\n            if let Some(g) = &curr.game {\n                if self.game_place != Some(g.place) {\n                    self.game_place = Some(g.place);\n                    self.arrival = Some(Instant::now());\n                    self.game_ui.panel = None;\n                    pav_view::arpg::place_look(g, &mut self.view);\n                }\n            }\n        } else {\n            self.game_frame = None;\n        }\n        let alpha = if self.app_settings.smoothing && !snap_camera {\n            ((now - curr_at).as_secs_f32() / tick_wall.max(1e-4)).clamp(0.0, 1.0)\n        } else {\n            1.0\n        };\n        if snap_camera {\n            // A submitted edit must contain its new framing as well as its new geometry.\n            self.rig = CameraRig::new(self.rig.params.clone());\n            self.rig.snap(curr.focus);\n        }\n        let focus = prev.focus.lerp(curr.focus, alpha);\n        let player = curr.player.and_then(|id| curr.objects.iter().find(|o| o.id == id));\n        let feet = player.and_then(|p| p.puppet.as_ref().map(|pp| p.pos - Vec3::Y * pp.feet_offset)).unwrap_or(focus);\n        let facing = player.and_then(|p| p.puppet.as_ref().map(|pp| pp.state.facing)).unwrap_or(0.0);\n\n        // Game input -> the simulation thread.\n        let (w, h) = self.gfx.as_ref().unwrap().size();\n        let size = Vec2::new(w as f32, h as f32);\n        let over_ui = self.egui_ctx.egui_wants_pointer_input();\n        let left_tap = self.input.take_mouse_tap(MouseButton::Left) && !over_ui;\n        if over_ui {\n            self.input.mouse_taps.clear();\n        }\n        let (mut held, mut pressed) = self.input.buttons();\n        // Touch: the stick, the buttons and auto-attack.\n        let touch_game = curr.game.as_deref().filter(|_| game_input).map(|g| (g, feet, facing));\n        let rig = &self.rig;\n        let intent = self.touch.intent(touch_game, |v| rig.relative_move(v), self.prefs.auto_attack);\n        if game_input {\n            held |= intent.held;\n            pressed |= intent.pressed;\n        }\n        if pressed & pav_core::input::buttons::INTERACT != 0 {\n            if let Some(g) = &curr.game {\n                if let Some(c) = self.game_ui.interact(g) {\n                    host.shared.command(c);\n                }\n            }\n        }\n        if pressed != 0 && self.input.last_device == Device::Gamepad {\n            // Gamepad presses are timed from when they were polled (gilrs queues them).\n            self.latency.press();\n        }\n        let room_id = self.hud.current.as_ref().map(|r| r.id);\n        let left = self.input.mouse.contains(&MouseButton::Left) && !over_ui;\n        if left_tap && !self.editor.on && game_input {\n            pressed |= pav_core::input::buttons::PRIMARY;\n        }\n        if !studio_active && self.editor.update(host, &self.rig, self.input.cursor, size, left, left_tap, room_id) {\n            held &= !pav_core::input::buttons::PRIMARY;\n            pressed &= !pav_core::input::buttons::PRIMARY;\n        }\n        let aim = match self.input.last_device {\n            Device::KeyboardMouse => self.rig.ground_point(self.input.cursor, size, feet.y),\n            Device::Gamepad => {\n                let r = self.input.pad.right;\n                if r.length() > 0.2 {\n                    let d = self.rig.relative_move(r);\n                    Some(feet + Vec3::new(d.x, 0.0, d.y) * self.sim_config.bombs.throw_range * r.length().min(1.0))\n                } else {\n                    Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)\n                }\n            }\n            Device::Touch => intent.aim.or(Some(feet + Vec3::new(facing.sin(), 0.0, facing.cos()) * 4.0)),\n        };\n        {\n            let mut i = host.shared.input.lock().unwrap();\n            if game_input {\n                let axis = (self.input.move_axis() + intent.move_axis).clamp_length_max(1.0);\n                i.move_dir = match intent.move_world {\n                    // Auto-attack stepping in to a foe (only while the stick is still).\n                    Some(m) if axis == Vec2::ZERO => m,\n                    _ => self.rig.relative_move(axis),\n                };\n                i.held = held;\n                i.pressed |= pressed;\n                i.aim = aim;\n                if let Some(t) = self.latency.pending.take() {\n                    host.shared.input_stamp.lock().unwrap().get_or_insert(t);\n                }\n            } else {\n                *i = InputFrame::default();\n            }\n        }\n\n        self.rig.update(focus, dt);\n        self.builder.now = self.started.elapsed().as_secs_f64();\n        let events: Vec<_> = std::mem::take(&mut *host.shared.events.lock().unwrap());\n        let events = if studio_active { Vec::new() } else { events };\n        self.builder.add_events(&events);\n        // Save the hero on every arrival somewhere, and once a minute while playing.\n        let travelled = events.iter().any(|e| matches!(e, pav_core::SimEvent::Travel { .. }));\n        if curr.game.is_some() && (travelled || self.last_save.elapsed().as_secs() >= 60) {\n            self.last_save = Instant::now();\n            host.exec(|sim| crate::save::save_from(sim));\n        }\n        if let Some(a) = &self.audio {\n            let (_, right) = self.rig.ground_axes();\n            let l = pav_audio::Listener { pos: self.rig.target, right };\n            for e in &events {\n                if matches!(e, pav_core::SimEvent::Step { .. }) && !self.audio_settings.footsteps {\n                    continue;\n                }\n                a.play_event(e, &l, self.audio_settings.sfx);\n            }\n        }\n        // The look layer (Look & Filters) over the scene's own settings.\n        let mut view = self.view.clone();\n        self.look_ui.apply(&mut view);\n        self.prefs.quality.trim(self.touch_screen, &mut view);\n        let mut scene = self.builder.build(&prev, &curr, alpha, &self.rig, w as f32 / h.max(1) as f32, &view, focus);\n        // Arriving somewhere new: the screen opens with the chosen transition, on the player.\n        if let Some(t0) = self.arrival {\n            let t = t0.elapsed().as_secs_f32() / view.filter.transition_time.max(0.05);\n            match view.filter.transition.kind() {\n                Some(kind) if t < 1.0 => {\n                    scene.filter.transition = 1.0 - t * t * (3.0 - 2.0 * t);\n                    scene.filter.transition_kind = kind;\n                    scene.filter.transition_center = pav_view::build::screen_uv(&scene.camera, feet + Vec3::Y * 0.9);\n                }\n                _ => self.arrival = None,\n            }\n        }\n        if !studio_active {\n            self.editor.draw_preview(&mut scene);\n        }\n        if let Some(a) = intent.aiming.filter(|_| game_input) {\n            // A skill aimed by hand: a ring where it lands and dots on the way there.\n            let mark = |at: Vec3, s: f32, color: Vec3| MeshInstance {\n                mesh: MeshKey::Cylinder,\n                transform: Mat4::from_scale_rotation_translation(Vec3::new(s, 0.02, s), Quat::IDENTITY, at + Vec3::Y * 0.04),\n                color,\n                emissive: 0.6,\n                style: Style::Unlit,\n                flags: rflags::NO_SHADOW | rflags::NO_CUT,\n                group: 0,\n                material: 0,\n                ext: Vec3::ZERO,\n            };\n            let a = Vec3::new(a.x, feet.y, a.z);\n            scene.meshes.push(mark(a, 0.9, Vec3::new(1.0, 0.78, 0.4)));\n            let n = ((a - feet).length() / 0.8) as usize;\n            for k in 1..n {\n                scene.meshes.push(mark(feet.lerp(a, k as f32 / n as f32), 0.14, Vec3::new(1.0, 0.9, 0.7)));\n            }\n        }\n        if self.app_settings.aim_marker && game_input && curr.player.is_some() && !self.editor.on && curr.game.is_none() {\n            if let Some(a) = aim {\n                let d = Vec2::new(a.x - feet.x, a.z - feet.z);\n                let a = if d.length() > self.sim_config.bombs.throw_range {\n                    let d = d.normalize() * self.sim_config.bombs.throw_range;\n                    Vec3::new(feet.x + d.x, a.y, feet.z + d.y)\n                } else {\n                    a\n                };\n                scene.meshes.push(MeshInstance {\n                    mesh: MeshKey::Cylinder,\n                    transform: Mat4::from_scale_rotation_translation(\n                        Vec3::new(0.5, 0.02, 0.5),\n                        Quat::IDENTITY,\n                        a + Vec3::Y * 0.03,\n                    ),\n                    color: Vec3::new(1.0, 0.95, 0.7),\n                    emissive: 0.0,\n                    style: Style::Unlit,\n                    flags: rflags::NO_SHADOW | rflags::NO_CUT,\n                    group: 0,\n                    material: 0,\n                    ext: Vec3::ZERO,\n                });\n            }\n        }\n\n        // UI.\n        let stats = *host.shared.stats.lock().unwrap();\n        let mut ctl = host.control();\n        let ctl_before = ctl;\n        let crash = host.shared.crashed.lock().unwrap().clone();\n        self.panel.record_timing(dt * 1000.0, stats.tick_ms);\n        let gfx = self.gfx.as_mut().unwrap();\n        let (render_scale, lights) =\n            self.scaler.update(self.prefs.quality, self.touch_screen, dt * 1000.0, gfx.size(), gfx.window.scale_factor() as f32);\n        gfx.renderer.render_scale = render_scale;\n        gfx.renderer.max_shadow_lights = lights;\n        let info = ui::OverlayInfo {\n            fps: self.fps.fps,\n            frame_ms: self.fps.frame_ms,\n            tps: stats.tps,\n            tick_ms: stats.tick_ms,\n            tick: stats.tick,\n            entities: stats.entities,\n            gpu_errors: gfx.gpu_errors.load(std::sync::atomic::Ordering::Relaxed),\n            adapter: &gfx.adapter_name,\n            crash: crash.clone(),\n            paused: ctl.paused,\n            speed: ctl.speed,\n            rewinding,\n            render_scale,\n        };\n        if let Some(t) = self.boot_done_at {\n            if t.elapsed().as_secs_f32() > 10.0 && self.show_boot {\n                self.show_boot = false;\n                self.boot_done_at = None;\n            }\n        }\n        let toast = self.toast.as_ref().filter(|(_, t)| t.elapsed().as_secs_f32() < 3.0).map(|(m, _)| m.clone());\n        let card_visible = !studio_active && self.hud.card_visible();\n        let guide_visible =\n            !studio_active && self.app_settings.show_guide && self.started.elapsed().as_secs_f32() < 25.0 && !card_visible;\n        let device = self.input.last_device;\n        let touch_ui = device == Device::Touch;\n        if touch_ui != self.touch_styled {\n            self.touch_styled = touch_ui;\n            pav_ui::touch_style(&self.egui_ctx, touch_ui);\n        }\n        self.game_ui.touch = touch_ui;\n        self.game_ui.tree.touch = touch_ui;\n        self.touch.swipes.begin_frame();\n        let touch = &mut self.touch;\n        let auto_attack = self.prefs.auto_attack;\n        let tips = touch_ui && !self.prefs.tips_seen && self.started.elapsed().as_secs_f32() < 45.0;\n        let mut prefs = self.prefs.clone();\n        let portal = self.game_frame.as_ref().is_some_and(|g| g.place != pav_core::arpg::Place::Town);\n        let state = self.egui_state.as_mut().unwrap();\n        let mut raw = state.take(&gfx.window);\n        raw.events.append(&mut self.pad_events);\n        let pad_cursor = self.pad_cursor;\n        let mut show_boot = self.show_boot;\n        let menu_open = self.menu_open;\n        let scene_name = self.scene_name.clone();\n        let mut menu_action = None;\n        let mut panel_actions = Vec::new();\n        let mut teleport = None;\n        let mut save_room = false;\n        let room_name = self.hud.current.as_ref().map(|r| r.key.clone());\n        let editor = &mut self.editor;\n        let hud = &mut self.hud;\n        let config_before = self.sim_config.clone();\n        let app_before = self.app_settings.clone();\n        let panel = &mut self.panel;\n        let master_before = self.audio_settings.master;\n        let view_proj = self.rig.view_proj(w as f32 / h.max(1) as f32);\n        let mut root = Root {\n            sim: &mut self.sim_config,\n            camera: &mut self.rig.params,\n            view: &mut self.view,\n            app: &mut self.app_settings,\n            audio: &mut self.audio_settings,\n        };\n        let show_stats = root.app.show_stats;\n        let feel = &mut self.feel;\n        let physics = &mut self.physics;\n        let latency = &self.latency;\n        let hud_ctx = HudCtx { hud: &curr.hud, tick: curr.tick, dt: curr.dt };\n        let game_frame = curr.game.clone();\n        let game_ui = &mut self.game_ui;\n        let look_ui = &mut self.look_ui;\n        let animation_ui = &mut self.animation_ui;\n        let asset_ui = &mut self.asset_ui;\n        let creature_ui = &mut self.creature_ui;\n        let studio_navigation = self.studio_navigation;\n        let mut creature_commands = Vec::new();\n        let mut animation_commands = Vec::new();\n        let mut asset_commands = Vec::new();\n        let mut studio_target = None;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let animation_bridge = self.bridge.as_ref().map(|b| b.addr.as_str());\n        #[cfg(target_arch = \"wasm32\")]\n        let animation_bridge: Option<&str> = None;\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let creature_feedback =\n            self.bridge.as_ref().and_then(|bridge| bridge.feedback.lock().ok().map(|feedback| feedback.status(None)));\n        #[cfg(target_arch = \"wasm32\")]\n        let creature_feedback: Option<serde_json::Value> = None;\n        let mut look_msg = None;\n        let guide = &mut self.guide;\n        let mut guide_out = Vec::new();\n        let mut game_cmds = Vec::new();\n        let out = self.egui_ctx.run_ui(raw, |ui| {\n            let ctx = ui.ctx().clone();\n            if let Some(c) = &info.crash {\n                ui::crash_banner(ui, c);\n            }\n            panel_actions = panel.ui(ui, &mut root, &mut ctl, &stats);\n            let free = ui.available_rect_before_wrap();\n            ui::boot_panel(&ctx, &mut show_boot);\n            if show_stats {\n                ui::stats_panel(&ctx, &info, free, touch_ui);\n            }\n            if guide_visible && !menu_open && !touch_ui {\n                ui::guide_panel(&ctx, device, game_frame.is_some());\n            }\n            if let Some(g) = &game_frame {\n                let proj = crate::arpg_ui::Projector { vp: view_proj, size: ctx.content_rect().size() };\n                crate::arpg_ui::hud(&ctx, g, &proj, device, game_ui.map, &mut touch.swipes);\n                if !menu_open {\n                    game_cmds = game_ui.ui(&ctx, g, &proj);\n                }\n            }\n            if touch_ui {\n                let map_hidden = touch.swipes.is_gone(egui::Id::new(\"minimap\"), 0);\n                let covered = menu_open || game_ui.any_open() || look_ui.open || guide.station || guide.field;\n                let points = game_frame.as_ref().and_then(|g| g.inv.as_ref()).map(|i| i.points).unwrap_or(0);\n                touch.draw(&ctx, &crate::touch::View { game: game_frame.as_deref(), auto_attack, map_hidden, points, covered });\n                if tips && !covered {\n                    ui::touch_tips(&ctx, game_frame.is_some(), &mut touch.swipes);\n                }\n            }\n            if card_visible && !menu_open && hud.card(&ctx, device) {\n                guide.station = true;\n            }\n            if !menu_open {\n                crate::guide_ui::pad_note(&ctx, hud_ctx.hud, hud_ctx.tick, hud_ctx.dt, touch_ui.then_some(&mut touch.swipes));\n            }\n            crate::hud::course_hud(&ctx, &hud_ctx);\n            pav_ui::game_lines(&ctx, hud_ctx.hud);\n            if let Some(p) = pad_cursor {\n                // The gamepad's menu cursor, above everything.\n                let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new(\"pad_cursor\")));\n                let tip = egui::Pos2::new(p.x, p.y);\n                let pts = vec![tip, tip + egui::vec2(0.0, 22.0), tip + egui::vec2(6.0, 16.5), tip + egui::vec2(15.0, 16.0)];\n                painter.add(egui::Shape::convex_polygon(\n                    pts,\n                    egui::Color32::from_rgb(255, 225, 150),\n                    egui::Stroke::new(1.5, egui::Color32::BLACK),\n                ));\n            }\n            physics.ui(&ctx, &hud_ctx, stats.tps, stats.tick_ms);\n            crate::hud::hit_flash(&ctx, hud_ctx.hud.invuln);\n            feel.ui(\n                &ctx,\n                &hud_ctx,\n                latency,\n                FeelSettings {\n                    model: &mut root.sim.movement.model,\n                    tick_rate: &mut root.sim.tick_rate,\n                    vsync: &mut root.app.vsync,\n                    smoothing: &mut root.app.smoothing,\n                },\n            );\n            teleport = hud.teleport_menu(&ctx);\n            hud.error_panel(&ctx);\n            if !studio_active {\n                save_room = editor.ui(&ctx, room_name.as_deref());\n            }\n            look_msg = look_ui.window(&ctx, root.view);\n            if studio_navigation || studio_active || animation_ui.open || asset_ui.open || creature_ui.open {\n                egui::Window::new(\"Studio workspace\")\n                    .id(egui::Id::new(\"studio_navigation\"))\n                    .title_bar(false)\n                    .resizable(false)\n                    .fixed_pos([16.0, 8.0])\n                    .show(&ctx, |ui| {\n                        ui.horizontal(|ui| {\n                            ui.strong(\"SHARDFALL STUDIO\");\n                            for (mode, label) in [\n                                (StudioMode::Animation, \"Animations\"),\n                                (StudioMode::Prop, \"Objects\"),\n                                (StudioMode::Creature, \"Creatures\"),\n                                (StudioMode::World, \"Game\"),\n                            ] {\n                                let panel_open = animation_ui.open || asset_ui.open || creature_ui.open;\n                                let reopen = match mode {\n                                    StudioMode::World => panel_open,\n                                    StudioMode::Animation => !animation_ui.open,\n                                    StudioMode::Prop => !asset_ui.open,\n                                    StudioMode::Creature => !creature_ui.open,\n                                };\n                                if ui.selectable_label(studio_mode == mode, label).clicked() && (studio_mode != mode || reopen) {\n                                    studio_target = Some(mode);\n                                }\n                            }\n                        });\n                    });\n            }\n            if matches!(studio_mode, StudioMode::Animation | StudioMode::World) {\n                animation_commands = animation_ui.window(&ctx, curr.animation_preview.as_ref(), animation_bridge);\n            }\n            if matches!(studio_mode, StudioMode::Prop | StudioMode::World) {\n                asset_commands = asset_ui.window(&ctx, &curr, animation_bridge);\n            }\n            if matches!(studio_mode, StudioMode::Creature | StudioMode::World) {\n                creature_commands = creature_ui.window(&ctx, &curr, animation_bridge, creature_feedback.as_ref());\n            }\n            let here = hud.current.clone();\n            guide_out.extend(guide.station(&ctx, here.as_ref(), &mut root));\n            guide_out.extend(guide.field_guide(&ctx, &hud.entries));\n            if menu_open {\n                let difficulty = game_frame.is_some().then_some(&mut root.sim.difficulty);\n                menu_action = if touch_ui {\n                    let show_fps = &mut root.app.show_stats;\n                    let m = ui::TouchMenu { prefs: &mut prefs, show_fps, difficulty, portal, scale: render_scale };\n                    ui::touch_menu(&ctx, &scene_name, m)\n                } else {\n                    ui::pause_menu(&ctx, device, &scene_name, difficulty)\n                };\n            }\n            if let Some(t) = &toast {\n                if touch_ui {\n                    ui::toast_touch(&ctx, t, &mut touch.swipes);\n                } else {\n                    ui::toast(&ctx, t);\n                }\n            }\n            if !touch_ui {\n                const GAME_KEYS: &str =\n                    \"Esc menu · I inventory · P passives · C character · K skills · T town · G use · Space dodge · 1 potion\";\n                ui::hint_bar(\n                    &ctx,\n                    match (device, game_frame.is_some()) {\n                        (Device::Gamepad, _) => \"Start: menu\",\n                        (_, true) => GAME_KEYS,\n                        _ => \"Esc menu · F1 tuning · F2 rooms · F12 screenshot\",\n                    },\n                );\n            }\n        });\n        if prefs != self.prefs {\n            self.prefs = prefs;\n            crate::save::save_prefs(&self.prefs);\n        }\n        // The map: a tap on the minimap opens the big one; a tap or a swipe closes that.\n        let sw = &mut self.touch.swipes;\n        if sw.take_tap(egui::Id::new(\"minimap\")) {\n            self.game_ui.map = true;\n        }\n        let big = egui::Id::new(\"big_map\");\n        if sw.take_tap(big) || sw.is_gone(big, 0) {\n            self.game_ui.map = false;\n            sw.restore(big);\n        }\n        if !self.prefs.tips_seen && sw.is_gone(egui::Id::new(\"touch_tips\"), 0) {\n            self.prefs.tips_seen = true;\n            crate::save::save_prefs(&self.prefs);\n        }\n        self.show_boot = show_boot;\n        for a in guide_out {\n            match a {\n                crate::guide_ui::GuideAction::Go(key) => teleport = Some(crate::rooms::TeleportTarget::Room(key)),\n                crate::guide_ui::GuideAction::Toast(m) => self.toast = Some((m, Instant::now())),\n            }\n        }\n        if let Some(m) = look_msg {\n            self.toast = Some((m, Instant::now()));\n        }\n        self.look_ui.save_if_dirty(false);\n        for c in game_cmds {\n            host.shared.command(c);\n        }\n        if ctl.paused != ctl_before.paused\n            || ctl.speed != ctl_before.speed\n            || ctl.step_requests != ctl_before.step_requests\n            || ctl.rewind_speed != ctl_before.rewind_speed\n        {\n            let c = ctl;\n            host.set_control(|x| {\n                x.paused = c.paused;\n                x.speed = c.speed;\n                x.step_requests = c.step_requests;\n                x.rewind_speed = c.rewind_speed;\n            });\n        }\n        if self.sim_config != config_before {\n            let cfg = self.sim_config.clone();\n            host.exec(move |sim| sim.config = cfg);\n            self.config_push_tick = stats.tick.max(curr.tick);\n        }\n        if self.app_settings.vsync != app_before.vsync {\n            gfx.set_vsync(self.app_settings.vsync);\n        }\n        if self.audio_settings.master != master_before {\n            if let Some(a) = &self.audio {\n                a.set_master(self.audio_settings.master);\n            }\n        }\n        state.platform_output(&gfx.window, out.platform_output);\n        let ppp = out.pixels_per_point;\n        let prims = self.egui_ctx.tessellate(out.shapes, ppp);\n        let mut textures = out.textures_delta;\n\n        #[cfg(target_arch = \"wasm32\")]\n        if self.screenshot_requested {\n            // Reading pixels back waits on the GPU, which the browser does not allow here.\n            self.screenshot_requested = false;\n            self.toast = Some((\"screenshots are not available in the browser\".into(), Instant::now()));\n        }\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if self.screenshot_requested {\n            self.screenshot_requested = false;\n            let (w, h) = gfx.size();\n            let dir = boot::exe_dir().join(\"screenshots\");\n            let path = dir.join(format!(\n                \"shardfall-{}.png\",\n                web_time::SystemTime::now().duration_since(web_time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)\n            ));\n            let r = pav_render::capture::render_to_rgba(&mut gfx.renderer, &scene, w, h)\n                .and_then(|px| pav_render::capture::save_png(&path, w, h, &px));\n            self.toast = Some((\n                match r {\n                    Ok(_) => format!(\"screenshot saved: {}\", path.display()),\n                    Err(e) => format!(\"screenshot failed: {e:#}\"),\n                },\n                Instant::now(),\n            ));\n        }\n\n        let first = self.boot_done_at.is_none()\n            && boot::diag().stages.lock().map(|s| !s.iter().any(|s| s.name == \"first frame\")).unwrap_or(false);\n        let submitted = if first {\n            let submitted = stage(\"first frame\", || {\n                let submitted = gfx.draw(&scene, Some((&prims, &mut textures, ppp)));\n                Ok((submitted, format!(\"{} meshes, {} sdf\", gfx.renderer.stats.mesh_instances, gfx.renderer.stats.sdf_instances)))\n            });\n            self.boot_done_at = Some(Instant::now());\n            log::info!(\"boot complete in {:.0} ms\", boot::diag().start.elapsed().as_secs_f64() * 1000.0);\n            submitted.unwrap_or(false)\n        } else {\n            gfx.draw(&scene, Some((&prims, &mut textures, ppp)))\n        };\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if submitted {\n            if let Some(bridge) = &self.bridge {\n                bridge.submitted(curr.live_edit_ticket);\n            }\n        }\n        // Input latency: the frame showing the tick that consumed a press is now submitted.\n        if submitted {\n            let mut probe = host.shared.latency_probe.lock().unwrap();\n            if let Some((pressed_at, ticked_at, tick)) = *probe {\n                if curr.tick >= tick {\n                    let now = Instant::now();\n                    self.latency.record(LatencySample {\n                        to_tick: (ticked_at - pressed_at).as_secs_f32() * 1000.0,\n                        to_screen: (now - ticked_at).as_secs_f32() * 1000.0,\n                    });\n                    *probe = None;\n                }\n            }\n        }\n\n        for a in panel_actions {\n            self.panel_action(a);\n        }\n        if let Some(t) = teleport {\n            self.teleport(t);\n        }\n        if save_room {\n            if let (Some(host), Some(id)) = (&self.host, room_id) {\n                let msg = match crate::edit::save_room(host, id) {\n                    Ok(p) => format!(\"saved {}\", p.display()),\n                    Err(e) => format!(\"save failed: {e:#}\"),\n                };\n                self.editor.status = msg.clone();\n                self.toast(msg);\n                if self.watcher.is_none() {\n                    self.watcher = RoomWatcher::start();\n                }\n            }\n        }\n        if self.watcher.as_mut().is_some_and(|w| w.poll()) {\n            self.reload_rooms();\n        }\n        if studio_active {\n            self.ensure_animation_watcher();\n        }\n        let animation_updates = self.animation_watcher.as_mut().map(|w| w.poll()).unwrap_or_default();\n        for update in animation_updates {\n            match update {\n                Ok(message) => {\n                    log::info!(\"{message}\");\n                    self.animation_ui.status = message;\n                    self.animation_ui.error = false;\n                }\n                Err(error) => {\n                    log::warn!(\"animation reload: {error}\");\n                    self.animation_ui.report(Err(error));\n                }\n            }\n        }\n        for command in animation_commands {\n            self.studio_command(command);\n        }\n        for command in asset_commands {\n            self.studio_command(command);\n        }\n        for command in creature_commands {\n            self.studio_command(command);\n        }\n        for result in self.creature_watcher.poll() {\n            self.creature_ui.report(result);\n        }\n        self.poll_creature_updates();\n        for update in self.asset_watcher.poll() {\n            match update {\n                Ok((name, definition)) => {\n                    self.asset_ui.status = format!(\"Reloaded {name}\");\n                    self.asset_ui.error = false;\n                    #[cfg(not(target_arch = \"wasm32\"))]\n                    let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n                    #[cfg(target_arch = \"wasm32\")]\n                    let feedback: Option<pav_tools::live_feedback::SharedFeedback> = None;\n                    if let Some(host) = &self.host {\n                        let _ticket = host.query(move |sim| {\n                            let started = feedback.as_ref().map(|_| std::time::Instant::now());\n                            if !crate::asset_watch::apply_update(sim, &name, definition) {\n                                return None;\n                            }\n                            if let Some(feedback) = feedback {\n                                if let Ok(mut feedback) = feedback.lock() {\n                                    let note = feedback.accepted(\"asset_file_reload\", started.unwrap());\n                                    sim.live_edit_ticket = note[\"ticket\"].as_u64().unwrap_or_default();\n                                }\n                            }\n                            Some(sim.live_edit_ticket)\n                        });\n                        #[cfg(not(target_arch = \"wasm32\"))]\n                        if let (Some(bridge), Some(ticket)) = (&self.bridge, _ticket.flatten()) {\n                            bridge.adopted(ticket);\n                        }\n                    }\n                }\n                Err(error) => {\n                    log::warn!(\"object reload: {error}\");\n                    self.asset_ui.report(Err(error));\n                }\n            }\n        }\n        if let Some(mode) = studio_target {\n            self.switch_studio(mode);\n        }\n        if let Some(a) = menu_action {\n            self.menu_action(a);\n        }\n        // Touch: the bag, the menu, the map button, and taps on the open game.\n        for c in &intent.ui {\n            match c {\n                crate::touch::Control::Bag => {\n                    let ui = &mut self.game_ui;\n                    if ui.any_open() {\n                        ui.close_all();\n                    } else {\n                        ui.inventory = true;\n                    }\n                }\n                crate::touch::Control::Menu => {\n                    let open = !self.menu_open;\n                    self.set_menu(open);\n                }\n                crate::touch::Control::Map => self.touch.swipes.restore(egui::Id::new(\"minimap\")),\n                _ => {}\n            }\n        }\n        if intent.world_tap {\n            self.close_on_tap();\n        }\n    }\n\n    fn panel_action(&mut self, a: PanelAction) {\n        let Some(host) = &self.host else { return };\n        let dir = boot::exe_dir();\n        match a {\n            PanelAction::Reset => self.reset(),\n            PanelAction::Scrub(t) => host.set_control(|c| {\n                c.paused = true;\n                c.scrub = Some(t);\n            }),\n            PanelAction::SaveSnapshot => {\n                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n                let r = host.query(move |sim| sim.save_state(&path).map(|_| path.display().to_string()));\n                match r {\n                    Some(Ok(p)) => self.toast(format!(\"snapshot saved: {p}\")),\n                    Some(Err(e)) => self.toast(format!(\"snapshot failed: {e:#}\")),\n                    None => self.toast(\"snapshot timed out\"),\n                }\n            }\n            PanelAction::LoadSnapshot => {\n                let path = dir.join(\"snapshots\").join(\"quicksave.snap\");\n                let r = host.query(move |sim| sim.load_state(&path));\n                match r {\n                    Some(Ok(())) => self.toast(\"snapshot loaded\"),\n                    Some(Err(e)) => self.toast(format!(\"load failed: {e:#}\")),\n                    None => self.toast(\"load timed out\"),\n                }\n            }\n            PanelAction::SaveReplay => {\n                let path = dir.join(\"replays\").join(\"last.replay.json\");\n                let r = host.query(move |sim| -> Result<String> {\n                    let mut rep = sim.recording.clone();\n                    rep.final_hash = Some(format!(\"{:016x}\", sim.state_hash()));\n                    std::fs::create_dir_all(path.parent().unwrap())?;\n                    std::fs::write(&path, serde_json::to_string(&rep)?)?;\n                    Ok(path.display().to_string())\n                });\n                match r {\n                    Some(Ok(p)) => self.toast(format!(\"replay saved: {p}\")),\n                    Some(Err(e)) => self.toast(format!(\"replay failed: {e:#}\")),\n                    None => self.toast(\"replay timed out\"),\n                }\n            }\n            PanelAction::Look => self.look_ui.open = true,\n            PanelAction::Status(s) => {\n                self.panel.status(s.clone());\n                self.toast(s);\n            }\n        }\n    }\n\n    /// Use the registered tools for UI edits too. This keeps validation, undo, and\n    /// persistence identical for a user and an LLM.\n    fn studio_command(&mut self, command: crate::animation_ui::Command) {\n        let Some(host) = &self.host else { return };\n        let asset = command.tool.starts_with(\"asset\");\n        let creature = command.tool.starts_with(\"creature\");\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(bridge) = &self.bridge {\n            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n                Ok(Some(look)) => self.look_ui.set_look(look),\n                Ok(None) => {}\n                Err(error) => {\n                    let message = format!(\"The previous live edit is still pending: {error:#}\");\n                    if creature {\n                        self.creature_ui.report(Err(message));\n                    } else if asset {\n                        self.asset_ui.report(Err(message));\n                    } else {\n                        self.animation_ui.report(Err(message));\n                    }\n                    return;\n                }\n            }\n        }\n        let rig = self.rig.clone();\n        let view = self.view.clone();\n        let look = self.look_ui.look().clone();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n        #[cfg(target_arch = \"wasm32\")]\n        let feedback = None;\n        let reply = host.query(move |sim| {\n            let live = std::mem::replace(sim, Sim::empty(1));\n            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n            session.look = look;\n            session.feedback = feedback;\n            let result = pav_tools::tools::call(&mut session, command.tool, &command.args)\n                .map(|out| match out {\n                    pav_tools::Output::Json(v) => v,\n                    pav_tools::Output::Image { meta, .. } => meta,\n                })\n                .map_err(|e| format!(\"{e:#}\"));\n            let (live, rig, view, _) = session.into_live();\n            let ticket = live.live_edit_ticket;\n            *sim = live;\n            (result, rig, view, ticket)\n        });\n        let result = match reply {\n            Some((result, rig, view, _ticket)) => {\n                self.rig = rig;\n                self.view = view;\n                #[cfg(not(target_arch = \"wasm32\"))]\n                if let Some(bridge) = &self.bridge {\n                    bridge.adopted(_ticket);\n                }\n                result\n            }\n            None => Err(\"The studio command did not answer. Check the game log.\".into()),\n        };\n        if creature {\n            self.creature_ui.report_command(result);\n        } else if asset {\n            self.asset_ui.report(result);\n        } else {\n            self.animation_ui.report(result);\n        }\n        self.ensure_animation_watcher();\n    }\n\n    /// Adopt completed jobs on the live simulation thread, with the bridge camera current.\n    fn poll_creature_updates(&mut self) {\n        if !pav_tools::creature_tools::has_updates() {\n            return;\n        }\n        let Some(host) = &self.host else { return };\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if let Some(bridge) = &self.bridge {\n            match bridge.synchronize(host, &mut self.rig, &mut self.view) {\n                Ok(Some(look)) => self.look_ui.set_look(look),\n                Ok(None) => {}\n                Err(_) => return,\n            }\n        }\n        let rig = self.rig.clone();\n        let view = self.view.clone();\n        let look = self.look_ui.look().clone();\n        #[cfg(not(target_arch = \"wasm32\"))]\n        let feedback = self.bridge.as_ref().map(|b| b.feedback.clone());\n        #[cfg(target_arch = \"wasm32\")]\n        let feedback = None;\n        if let Some((reports, rig, view, ticket)) = host.query(move |sim| {\n            let live = std::mem::replace(sim, Sim::empty(1));\n            let mut session = pav_tools::Session::from_live(live, rig, view, None);\n            session.look = look;\n            session.feedback = feedback;\n            let reports = pav_tools::creature_tools::poll(&mut session);\n            let (live, rig, view, _) = session.into_live();\n            let ticket = live.live_edit_ticket;\n            *sim = live;\n            (reports, rig, view, ticket)\n        }) {\n            self.rig = rig;\n            self.view = view;\n            #[cfg(not(target_arch = \"wasm32\"))]\n            if let Some(bridge) = &self.bridge {\n                bridge.adopted(ticket);\n            }\n            #[cfg(target_arch = \"wasm32\")]\n            let _ = ticket;\n            for report in reports {\n                self.creature_ui.report(Ok(report));\n            }\n        }\n    }\n\n    fn switch_studio(&mut self, mode: StudioMode) {\n        self.studio_navigation = true;\n        self.set_menu(false);\n        #[cfg(not(target_arch = \"wasm32\"))]\n        if mode != StudioMode::World {\n            if mode == StudioMode::Animation {\n                if let Err(error) = pav_tools::animation_tools::reload_authored() {\n                    self.animation_ui.report(Err(format!(\"Could not load saved animations: {error:#}\")));\n                }\n            }\n            if self.bridge.is_none() {\n                match crate::bridge::Bridge::start(pav_tools::bridge::DEFAULT_ADDR) {\n                    Ok(bridge) => self.bridge = Some(bridge),\n                    Err(error) => {\n                        let message = format!(\"Could not open the live bridge: {error}\");\n                        if mode == StudioMode::Creature {\n                            self.creature_ui.report(Err(message));\n                        } else if mode == StudioMode::Prop {\n                            self.asset_ui.report(Err(message));\n                        } else {\n                            self.animation_ui.report(Err(message));\n                        }\n                    }\n                }\n            }\n        }\n        self.animation_ui.open = mode == StudioMode::Animation;\n        self.asset_ui.open = mode == StudioMode::Prop;\n        self.creature_ui.open = mode == StudioMode::Creature;\n        let tool = match mode {\n            StudioMode::Animation => \"anim_preview\",\n            StudioMode::Prop => \"asset_preview\",\n            StudioMode::Creature => \"creature_preview\",\n            StudioMode::World if self.studio_mode == StudioMode::Creature => \"creature_preview\",\n            StudioMode::World if self.studio_mode == StudioMode::Prop => \"asset_preview\",\n            StudioMode::World => \"anim_preview\",\n        };\n        let action = if mode == StudioMode::World { \"close\" } else { \"open\" };\n        self.studio_command(crate::animation_ui::Command {\n            tool,\n            args: serde_json::json!({\"action\":action}).as_object().unwrap().clone(),\n        });\n    }\n\n    fn ensure_animation_watcher(&mut self) {\n        // An agent may create the first animation directory through the bridge. Attach\n        // then, but do not retry a failed native watcher on every frame.\n        if !self.animation_watch_attempted && crate::animation_watch::AnimationWatcher::directory_exists() {\n            self.animation_watch_attempted = true;\n            self.animation_watcher = crate::animation_watch::AnimationWatcher::start();\n        }\n    }\n\n    fn menu_action(&mut self, a: MenuAction) {\n        match a {\n            MenuAction::Resume => self.set_menu(false),\n            MenuAction::AnimationStudio => self.switch_studio(StudioMode::Animation),\n            MenuAction::AssetStudio => self.switch_studio(StudioMode::Prop),\n            MenuAction::CreatureStudio => self.switch_studio(StudioMode::Creature),\n            MenuAction::Reset => {\n                self.set_menu(false);\n                self.reset();\n            }\n            MenuAction::LoadScene(name) => {\n                self.set_menu(false);\n                self.load_scene(&name);\n            }\n            MenuAction::NewHero => {\n                self.set_menu(false);\n                if let Some(host) = &self.host {\n                    let (cfg, seed) = (self.sim_config.clone(), self.settings.seed);\n                    host.exec(move |sim| {\n                        crate::save::erase();\n                        if let Ok(mut fresh) = Sim::new(\"town\", seed) {\n                            fresh.config = cfg;\n                            *sim = fresh;\n                        }\n                    });\n                }\n                self.scene_name = \"town\".into();\n                self.toast(\"a new hero arrives in Emberwatch\");\n            }\n            MenuAction::Tuning => {\n                self.set_menu(false);\n                self.panel.open = true;\n            }\n            MenuAction::Look => {\n                self.set_menu(false);\n                self.look_ui.open = true;\n            }\n            MenuAction::Guide => {\n                self.set_menu(false);\n                if self.hud.current.is_some() {\n                    self.guide.station = true;\n                } else {\n                    self.guide.field = true;\n                }\n            }\n            MenuAction::FieldGuide => {\n                self.set_menu(false);\n                self.guide.field = true;\n            }\n            MenuAction::Rooms => {\n                self.set_menu(false);\n                self.open_teleport();\n            }\n            MenuAction::RoomCard => {\n                self.set_menu(false);\n                self.hud.show_card();\n            }\n            MenuAction::Screenshot => {\n                self.set_menu(false);\n                self.screenshot_requested = true;\n            }\n            MenuAction::Feel => {\n                self.set_menu(false);\n                self.feel.open = !self.feel.open;\n                self.feel.auto = false;\n            }\n            MenuAction::Physics => {\n                self.set_menu(false);\n                self.physics.open = !self.physics.open;\n                self.physics.auto = false;\n            }\n            MenuAction::Quit => {\n                self.look_ui.save_if_dirty(true);\n                self.quit = true;\n            }\n            MenuAction::TownPortal => {\n                self.set_menu(false);\n                if let Some(host) = &self.host {\n                    host.shared.command(pav_core::arpg::GameCmd::Travel(pav_core::arpg::Place::Town.code()));\n                }\n            }\n            MenuAction::Fullscreen => {\n                if let Some(g) = &self.gfx {\n                    crate::platform::toggle_fullscreen(&g.window);\n                }\n            }\n        }\n    }\n}\n\nimpl App {\n    /// The browser only allows sound after the first click or key press.\n    #[cfg(target_arch = \"wasm32\")]\n    fn resume_audio(&mut self) {\n        if !self.audio_resumed {\n            self.audio_resumed = true;\n            if let Some(a) = &self.audio {\n                a.resume();\n            }\n        }\n    }\n\n    /// A start-up failure: stop, and show why (the browser has no exit to report it).\n    fn fail(&mut self, el: &ActiveEventLoop, e: anyhow::Error) {\n        let msg = format!(\"{e:#}\");\n        #[cfg(target_arch = \"wasm32\")]\n        crate::platform::error_box(\"Shardfall could not start\", &msg);\n        self.fatal = Some(msg);\n        el.exit();\n    }\n}\n\nimpl ApplicationHandler for App {\n    fn resumed(&mut self, el: &ActiveEventLoop) {\n        if self.init_started || self.fatal.is_some() {\n            return;\n        }\n        self.init_started = true;\n        if let Err(e) = self.init(el) {\n            self.fail(el, e);\n        }\n    }\n\n    fn window_event(&mut self, el: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {\n        if let WindowEvent::Touch(t) = &event {\n            self.on_touch(t, &event);\n            return;\n        }\n        let consumed = match (&mut self.egui_state, &self.gfx) {\n            (Some(st), Some(g)) => st.on_window_event(&g.window, &event),\n            _ => false,\n        };\n        match event {\n            WindowEvent::CloseRequested => {\n                if let Some(host) = &self.host {\n                    host.exec(|sim| crate::save::save_from(sim));\n                }\n                self.look_ui.save_if_dirty(true);\n                el.exit()\n            }\n            WindowEvent::Focused(false) => {\n                self.input.clear();\n                self.touch.clear();\n            }\n            WindowEvent::Resized(sz) => {\n                if let Some(g) = &mut self.gfx {\n                    g.resize(sz.width, sz.height);\n                }\n            }\n            WindowEvent::RedrawRequested => {\n                self.frame();\n                if self.quit {\n                    el.exit();\n                }\n            }\n            WindowEvent::KeyboardInput { event, .. } => {\n                #[cfg(target_arch = \"wasm32\")]\n                self.resume_audio();\n                if let PhysicalKey::Code(code) = event.physical_key {\n                    let system = matches!(\n                        code,\n                        KeyCode::Escape\n                            | KeyCode::F1\n                            | KeyCode::F2\n                            | KeyCode::F3\n                            | KeyCode::F4\n                            | KeyCode::F5\n                            | KeyCode::F6\n                            | KeyCode::F7\n                            | KeyCode::F8\n                            | KeyCode::F9\n                            | KeyCode::F10\n                            | KeyCode::F11\n                            | KeyCode::F12\n                    );\n                    if event.state == ElementState::Pressed && !event.repeat && (system || !consumed) {\n                        self.handle_key(code);\n                        if !system && !consumed {\n                            self.latency.press();\n                        }\n                    }\n                    if !consumed || event.state == ElementState::Released {\n                        self.input.key(code, event.state);\n                    }\n                }\n            }\n            WindowEvent::MouseWheel { delta, .. } if !consumed => {\n                let lines = match delta {\n                    MouseScrollDelta::LineDelta(_, y) => y,\n                    MouseScrollDelta::PixelDelta(p) => p.y as f32 / 40.0,\n                };\n                self.rig.params.distance = (self.rig.params.distance * 0.9f32.powf(lines)).clamp(2.0, 120.0);\n            }\n            WindowEvent::MouseInput { state, button, .. } => {","numLines":1500,"startLine":700,"totalLines":2267}},"tool_result_meta":[{"id":"toolu_01WskSXiYHy4cWyScNrrEirp","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9A8kXCxF5c1QagbmAV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019CS6NwLeV8or8PHuavhnG6","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211911__x2c3ab6/work/.research/shardfall/crates/pav_app/src/simhost.rs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28421,"cache_read_input_tokens":149139,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28421},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"eb3d8a44-de88-4121-ac6f-adf7ca0c1ca2","uuid":"c146b0aa-5eef-4924-abf2-d9098eab289e","timestamp":"2026-11-05T04:21:54.010Z","request_id":"req_011Cgj9A8XNRHqgXT3FwKaxH","wire_tool_inputs":{"toolu_019CS6NwLeV8or8PHuavhnG6":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211911__x2c3ab6/work/.research/shardfall/crates/pav_app/src/simhost.rs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019CS6NwLeV8or8PHuavhnG6","type":"tool_result","content":"1\t//! Runs the simulation at a fixed tick rate: on its own thread natively, and stepped from the\n2\t//! frame loop in the browser (no threads there). The renderer never waits for it: it reads the\n3\t//! two most recent frames and interpolates between them.\n4\t\n5\tuse std::sync::{Arc, Mutex};\n6\tuse std::time::Duration;\n7\t\n8\tuse pav_core::{InputFrame, RenderFrame, Sim, SimEvent};\n9\tuse web_time::Instant;\n10\t\n11\t#[cfg(not(target_arch = \"wasm32\"))]\n12\ttype Job = Box<dyn FnOnce(&mut Sim) + Send>;\n13\t\n14\t#[cfg(not(target_arch = \"wasm32\"))]\n15\tenum Cmd {\n16\t    Run(Job),\n17\t    Quit,\n18\t}\n19\t\n20\t#[derive(Clone, Copy, Debug)]\n21\tpub struct TimeControl {\n22\t    pub paused: bool,\n23\t    /// Simulation speed multiplier (0.05 .. 8).\n24\t    pub speed: f32,\n25\t    /// Ticks to advance while paused.\n26\t    pub step_requests: u32,\n27\t    /// Holding the rewind button.\n28\t    pub rewinding: bool,\n29\t    /// Ticks travelled back per tick while rewinding.\n30\t    pub rewind_speed: u32,\n31\t    /// Jump to this tick (timeline scrubbing), keeping the future until play resumes.\n32\t    pub scrub: Option<u64>,\n33\t}\n34\t\n35\timpl Default for TimeControl {\n36\t    fn default() -> Self {\n37\t        Self { paused: false, speed: 1.0, step_requests: 0, rewinding: false, rewind_speed: 1, scrub: None }\n38\t    }\n39\t}\n40\t\n41\t#[derive(Clone, Copy, Debug, Default)]\n42\tpub struct SimStats {\n43\t    /// Measured ticks per second of wall time.\n44\t    pub tps: f32,\n45\t    /// Average CPU time per tick (ms).\n46\t    pub tick_ms: f32,\n47\t    pub tick: u64,\n48\t    pub entities: usize,\n49\t    /// Rewind range available (ticks).\n50\t    pub oldest: u64,\n51\t    pub newest: u64,\n52\t    pub history_mb: f32,\n53\t    pub rewound: bool,\n54\t}\n55\t\n56\tpub struct FramePair {\n57\t    pub prev: Arc<RenderFrame>,\n58\t    pub curr: Arc<RenderFrame>,\n59\t    /// When `curr` became current (wall clock).\n60\t    pub curr_at: Instant,\n61\t    /// Wall-clock length of one tick at the current speed.\n62\t    pub tick_wall: f32,\n63\t}\n64\t\n65\tpub struct Shared {\n66\t    pub frames: Mutex<FramePair>,\n67\t    pub input: Mutex<InputFrame>,\n68\t    pub control: Mutex<TimeControl>,\n69\t    pub stats: Mutex<SimStats>,\n70\t    pub crashed: Mutex<Option<String>>,\n71\t    /// Events for sound and effects, drained by the render thread.\n72\t    pub events: Mutex<Vec<SimEvent>>,\n73\t    /// When the input that is waiting for the next tick was pressed (latency measurement).\n74\t    pub input_stamp: Mutex<Option<Instant>>,\n75\t    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\n76\t    pub latency_probe: Mutex<Option<(Instant, Instant, u64)>>,\n77\t    /// Menu commands waiting for a tick (one rides along with each tick's input).\n78\t    pub cmds: Mutex<std::collections::VecDeque<pav_core::arpg::GameCmd>>,\n79\t}\n80\t\n81\timpl Shared {\n82\t    /// Queues a game command for the next free tick.\n83\t    pub fn command(&self, c: pav_core::arpg::GameCmd) {\n84\t        let mut q = self.cmds.lock().unwrap();\n85\t        if q.len() < 64 {\n86\t            q.push_back(c);\n87\t        }\n88\t    }\n89\t}\n90\t\n91\t#[cfg(not(target_arch = \"wasm32\"))]\n92\tpub struct SimHost {\n93\t    tx: std::sync::mpsc::Sender<Cmd>,\n94\t    pub shared: Arc<Shared>,\n95\t    thread: Option<std::thread::JoinHandle<()>>,\n96\t}\n97\t\n98\t/// In the browser the simulation lives on the main thread and `pump` advances it every frame.\n99\t#[cfg(target_arch = \"wasm32\")]\n100\tpub struct SimHost {\n101\t    sim: std::cell::RefCell<Sim>,\n102\t    clock: std::cell::RefCell<Clock>,\n103\t    pub shared: Arc<Shared>,\n104\t}\n105\t\n106\tfn shared_for(sim: &mut Sim) -> Arc<Shared> {\n107\t    let f = Arc::new(sim.frame());\n108\t    Arc::new(Shared {\n109\t        frames: Mutex::new(FramePair { prev: f.clone(), curr: f, curr_at: Instant::now(), tick_wall: sim.dt() }),\n110\t        input: Mutex::new(InputFrame::default()),\n111\t        control: Mutex::new(TimeControl::default()),\n112\t        stats: Mutex::new(SimStats::default()),\n113\t        crashed: Mutex::new(None),\n114\t        events: Mutex::new(Vec::new()),\n115\t        input_stamp: Mutex::new(None),\n116\t        latency_probe: Mutex::new(None),\n117\t        cmds: Mutex::new(Default::default()),\n118\t    })\n119\t}\n120\t\n121\t#[cfg(not(target_arch = \"wasm32\"))]\n122\timpl SimHost {\n123\t    pub fn start(mut sim: Sim) -> Self {\n124\t        let shared = shared_for(&mut sim);\n125\t        let (tx, rx) = std::sync::mpsc::channel();\n126\t        let sh = shared.clone();\n127\t        let thread = std::thread::Builder::new()\n128\t            .name(\"simulation\".into())\n129\t            .spawn(move || {\n130\t                let sh2 = sh.clone();\n131\t                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || run(sim, rx, sh2)));\n132\t                if let Err(e) = r {\n133\t                    let msg = e\n134\t                        .downcast_ref::<&str>()\n135\t                        .map(|s| s.to_string())\n136\t                        .or_else(|| e.downcast_ref::<String>().cloned())\n137\t                        .unwrap_or_else(|| \"unknown panic\".into());\n138\t                    *sh.crashed.lock().unwrap() = Some(msg);\n139\t                }\n140\t            })\n141\t            .expect(\"spawn simulation thread\");\n142\t        Self { tx, shared, thread: Some(thread) }\n143\t    }\n144\t\n145\t    /// Runs `f` on the simulation thread (fire and forget).\n146\t    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\n147\t        let _ = self.tx.send(Cmd::Run(Box::new(f)));\n148\t    }\n149\t\n150\t    /// Runs `f` on the simulation thread and waits for its result.\n151\t    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\n152\t        let (rtx, rrx) = std::sync::mpsc::channel();\n153\t        self.exec(move |sim| {\n154\t            let _ = rtx.send(f(sim));\n155\t        });\n156\t        rrx.recv_timeout(Duration::from_secs(5)).ok()\n157\t    }\n158\t\n159\t    /// Advances the simulation (the thread does this by itself natively).\n160\t    pub fn pump(&self) {}\n161\t}\n162\t\n163\t#[cfg(target_arch = \"wasm32\")]\n164\timpl SimHost {\n165\t    pub fn start(mut sim: Sim) -> Self {\n166\t        let shared = shared_for(&mut sim);\n167\t        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\n168\t    }\n169\t\n170\t    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\n171\t        let mut sim = self.sim.borrow_mut();\n172\t        f(&mut sim);\n173\t        let dt = sim.dt();\n174\t        publish(&mut sim, &self.shared, dt, Instant::now());\n175\t    }\n176\t\n177\t    pub fn query<R: 'static>(&self, f: impl FnOnce(&mut Sim) -> R + 'static) -> Option<R> {\n178\t        let mut sim = self.sim.borrow_mut();\n179\t        let r = f(&mut sim);\n180\t        let dt = sim.dt();\n181\t        publish(&mut sim, &self.shared, dt, Instant::now());\n182\t        Some(r)\n183\t    }\n184\t\n185\t    /// Runs the ticks that are due (called once per frame).\n186\t    pub fn pump(&self) {\n187\t        self.clock.borrow_mut().advance(&mut self.sim.borrow_mut(), &self.shared);\n188\t    }\n189\t}\n190\t\n191\timpl SimHost {\n192\t    pub fn frames(&self) -> (Arc<RenderFrame>, Arc<RenderFrame>, Instant, f32) {\n193\t        let f = self.shared.frames.lock().unwrap();\n194\t        (f.prev.clone(), f.curr.clone(), f.curr_at, f.tick_wall)\n195\t    }\n196\t\n197\t    pub fn control(&self) -> TimeControl {\n198\t        *self.shared.control.lock().unwrap()\n199\t    }\n200\t\n201\t    pub fn set_control(&self, f: impl FnOnce(&mut TimeControl)) {\n202\t        f(&mut self.shared.control.lock().unwrap());\n203\t    }\n204\t}\n205\t\n206\t#[cfg(not(target_arch = \"wasm32\"))]\n207\timpl Drop for SimHost {\n208\t    fn drop(&mut self) {\n209\t        let _ = self.tx.send(Cmd::Quit);\n210\t        if let Some(t) = self.thread.take() {\n211\t            let _ = t.join();\n212\t        }\n213\t    }\n214\t}\n215\t\n216\tfn publish(sim: &mut Sim, sh: &Shared, tick_wall: f32, at: Instant) {\n217\t    let events = sim.drain_events();\n218\t    if !events.is_empty() {\n219\t        let mut q = sh.events.lock().unwrap();\n220\t        q.extend(events);\n221\t        let n = q.len();\n222\t        if n > 512 {\n223\t            q.drain(..n - 512);\n224\t        }\n225\t    }\n226\t    let frame = Arc::new(sim.frame());\n227\t    let mut f = sh.frames.lock().unwrap();\n228\t    f.prev = std::mem::replace(&mut f.curr, frame);\n229\t    f.curr_at = at;\n230\t    f.tick_wall = tick_wall;\n231\t}\n232\t\n233\t/// Fixed-rate ticking with time controls (pause, single steps, speed, rewind, scrubbing).\n234\tstruct Clock {\n235\t    next: Instant,\n236\t    window_start: Instant,\n237\t    window_ticks: u32,\n238\t    busy: Duration,\n239\t    rewound: bool,\n240\t    studio_mode: pav_core::prop_preview::StudioMode,\n241\t}\n242\t\n243\timpl Clock {\n244\t    fn new() -> Self {\n245\t        Self {\n246\t            next: Instant::now(),\n247\t            window_start: Instant::now(),\n248\t            window_ticks: 0,\n249\t            busy: Duration::ZERO,\n250\t            rewound: false,\n251\t            studio_mode: pav_core::prop_preview::StudioMode::World,\n252\t        }\n253\t    }\n254\t\n255\t    /// Runs whatever is due now; returns how long until the next tick.\n256\t    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n257\t        let previewing = sim.studio_active();\n258\t        let mode = sim.studio_mode();\n259\t        if self.studio_mode != mode {\n260\t            self.studio_mode = mode;\n261\t            self.next = Instant::now();\n262\t        }\n263\t        let ctl = *sh.control.lock().unwrap();\n264\t        // The animation stage has its own play, pause and speed controls. The world's time\n265\t        // controls stay untouched, including a paused or rewound game behind the stage.\n266\t        let tick_wall = if previewing { sim.dt() } else { sim.dt() / ctl.speed.clamp(0.01, 16.0) };\n267\t        let (busy, window_ticks) = (&mut self.busy, &mut self.window_ticks);\n268\t        let mut tick_once = |sim: &mut Sim, at: Instant| {\n269\t            let input = if previewing {\n270\t                InputFrame::default()\n271\t            } else {\n272\t                let mut i = sh.input.lock().unwrap();\n273\t                let mut frame = *i;\n274\t                i.pressed = 0;\n275\t                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n276\t                frame\n277\t            };\n278\t            let stamp = if previewing { None } else { sh.input_stamp.lock().unwrap().take() };\n279\t            let t = Instant::now();\n280\t            sim.step(&input);\n281\t            *busy += t.elapsed();\n282\t            if let Some(s) = stamp {\n283\t                *sh.latency_probe.lock().unwrap() = Some((s, Instant::now(), sim.state.tick));\n284\t            }\n285\t            *window_ticks += 1;\n286\t            publish(sim, sh, tick_wall, at);\n287\t        };\n288\t\n289\t        let now = Instant::now();\n290\t        if previewing {\n291\t            let mut n = 0;\n292\t            while now >= self.next && n < 8 {\n293\t                self.next += Duration::from_secs_f32(tick_wall);\n294\t                tick_once(sim, self.next);\n295\t                n += 1;\n296\t            }\n297\t            if n == 8 && now > self.next {\n298\t                self.next = now;\n299\t            }\n300\t        } else if ctl.rewinding {\n301\t            if now >= self.next {\n302\t                self.next = now + Duration::from_secs_f32(sim.dt());\n303\t                let oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n304\t                let target = sim.state.tick.saturating_sub(ctl.rewind_speed.max(1) as u64).max(oldest);\n305\t                if target < sim.state.tick && sim.rewind_to(target) {\n306\t                    self.rewound = true;\n307\t                }\n308\t                let dt = sim.dt();\n309\t                publish(sim, sh, dt, now);\n310\t            }\n311\t        } else if let Some(t) = ctl.scrub {\n312\t            sh.control.lock().unwrap().scrub = None;\n313\t            if sim.rewind_to(t) {\n314\t                self.rewound = true;\n315\t            }\n316\t            let dt = sim.dt();\n317\t            publish(sim, sh, dt, now);\n318\t            self.next = now;\n319\t        } else if ctl.paused {\n320\t            if ctl.step_requests > 0 {\n321\t                sh.control.lock().unwrap().step_requests -= 1;\n322\t                if self.rewound {\n323\t                    sim.commit_rewind();\n324\t                    self.rewound = false;\n325\t                }\n326\t                tick_once(sim, now);\n327\t            }\n328\t            self.next = now;\n329\t        } else {\n330\t            if self.rewound {\n331\t                // Acting after a rewind starts a new timeline.\n332\t                sim.commit_rewind();\n333\t                self.rewound = false;\n334\t                self.next = now;\n335\t            }\n336\t            let mut n = 0;\n337\t            while now >= self.next && n < 8 {\n338\t                self.next += Duration::from_secs_f32(tick_wall);\n339\t                tick_once(sim, self.next);\n340\t                n += 1;\n341\t            }\n342\t            if n == 8 && now > self.next {\n343\t                self.next = now; // too far behind: drop time instead of spiralling\n344\t            }\n345\t        }\n346\t\n347\t        let elapsed = self.window_start.elapsed();\n348\t        if elapsed >= Duration::from_millis(500) {\n349\t            let mut s = sh.stats.lock().unwrap();\n350\t            s.tps = self.window_ticks as f32 / elapsed.as_secs_f32();\n351\t            s.tick_ms = if self.window_ticks > 0 { self.busy.as_secs_f32() * 1000.0 / self.window_ticks as f32 } else { 0.0 };\n352\t            s.tick = sim.state.tick;\n353\t            s.entities = sim.state.entities.len();\n354\t            s.oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n355\t            s.newest = sim.history.newest_tick().unwrap_or(sim.state.tick).max(sim.state.tick);\n356\t            s.history_mb = sim.history.approx_bytes() as f32 / 1.0e6;\n357\t            s.rewound = self.rewound;\n358\t            self.window_start = Instant::now();\n359\t            self.window_ticks = 0;\n360\t            self.busy = Duration::ZERO;\n361\t        }\n362\t        if ctl.paused && !previewing { Duration::from_millis(4) } else { self.next.saturating_duration_since(Instant::now()) }\n363\t    }\n364\t}\n365\t\n366\t#[cfg(not(target_arch = \"wasm32\"))]\n367\tfn run(mut sim: Sim, rx: std::sync::mpsc::Receiver<Cmd>, sh: Arc<Shared>) {\n368\t    use std::sync::mpsc::{RecvTimeoutError, TryRecvError};\n369\t    let mut clock = Clock::new();\n370\t    loop {\n371\t        // Commands first.\n372\t        loop {\n373\t            match rx.try_recv() {\n374\t                Ok(Cmd::Run(job)) => {\n375\t                    job(&mut sim);\n376\t                    let dt = sim.dt();\n377\t                    publish(&mut sim, &sh, dt, Instant::now());\n378\t                }\n379\t                Ok(Cmd::Quit) => return,\n380\t                Err(TryRecvError::Empty) => break,\n381\t                Err(TryRecvError::Disconnected) => return,\n382\t            }\n383\t        }\n384\t        let wait = clock.advance(&mut sim, &sh);\n385\t        match rx.recv_timeout(wait) {\n386\t            Ok(Cmd::Run(job)) => {\n387\t                job(&mut sim);\n388\t                let dt = sim.dt();\n389\t                publish(&mut sim, &sh, dt, Instant::now());\n390\t            }\n391\t            Ok(Cmd::Quit) => return,\n392\t            Err(RecvTimeoutError::Timeout) => {}\n393\t            Err(RecvTimeoutError::Disconnected) => return,\n394\t        }\n395\t    }\n396\t}\n397\t\n398\t#[cfg(test)]\n399\tmod tests {\n400\t    use super::*;\n401\t\n402\t    #[test]\n403\t    fn preview_runs_over_a_paused_world_without_changing_its_time_controls() {\n404\t        let mut sim = Sim::empty(1);\n405\t        let shared = shared_for(&mut sim);\n406\t        {\n407\t            let mut control = shared.control.lock().unwrap();\n408\t            control.paused = true;\n409\t            control.speed = 8.0;\n410\t        }\n411\t        let mut clock = Clock::new();\n412\t        clock.rewound = true;\n413\t        sim.preview_open(Some(\"QUATERNIUS/Idle_Loop\"), None).unwrap();\n414\t        clock.advance(&mut sim, &shared);\n415\t        let time = sim.preview_info().unwrap().time;\n416\t        assert!(time >= sim.dt() && time < sim.dt() * 2.0);\n417\t        assert!(clock.rewound, \"opening a preview must not commit the world's rewind\");\n418\t        assert_eq!(sim.state.tick, 0);\n419\t        let control = *shared.control.lock().unwrap();\n420\t        assert!(control.paused);\n421\t        assert_eq!(control.speed, 8.0);\n422\t        sim.preview_close();\n423\t        clock.advance(&mut sim, &shared);\n424\t        assert_eq!(sim.state.tick, 0, \"the paused world stays paused after closing\");\n425\t        assert!(clock.rewound);\n426\t    }\n427\t}\n428\t"}]},"parent_tool_use_id":null,"session_id":"eb3d8a44-de88-4121-ac6f-adf7ca0c1ca2","uuid":"d515d13f-e03c-4290-b279-b936acfa713a","timestamp":"2026-11-05T04:21:54.027Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211911__x2c3ab6/work/.research/shardfall/crates/pav_app/src/simhost.rs","content":"//! Runs the simulation at a fixed tick rate: on its own thread natively, and stepped from the\n//! frame loop in the browser (no threads there). The renderer never waits for it: it reads the\n//! two most recent frames and interpolates between them.\n\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse pav_core::{InputFrame, RenderFrame, Sim, SimEvent};\nuse web_time::Instant;\n\n#[cfg(not(target_arch = \"wasm32\"))]\ntype Job = Box<dyn FnOnce(&mut Sim) + Send>;\n\n#[cfg(not(target_arch = \"wasm32\"))]\nenum Cmd {\n    Run(Job),\n    Quit,\n}\n\n#[derive(Clone, Copy, Debug)]\npub struct TimeControl {\n    pub paused: bool,\n    /// Simulation speed multiplier (0.05 .. 8).\n    pub speed: f32,\n    /// Ticks to advance while paused.\n    pub step_requests: u32,\n    /// Holding the rewind button.\n    pub rewinding: bool,\n    /// Ticks travelled back per tick while rewinding.\n    pub rewind_speed: u32,\n    /// Jump to this tick (timeline scrubbing), keeping the future until play resumes.\n    pub scrub: Option<u64>,\n}\n\nimpl Default for TimeControl {\n    fn default() -> Self {\n        Self { paused: false, speed: 1.0, step_requests: 0, rewinding: false, rewind_speed: 1, scrub: None }\n    }\n}\n\n#[derive(Clone, Copy, Debug, Default)]\npub struct SimStats {\n    /// Measured ticks per second of wall time.\n    pub tps: f32,\n    /// Average CPU time per tick (ms).\n    pub tick_ms: f32,\n    pub tick: u64,\n    pub entities: usize,\n    /// Rewind range available (ticks).\n    pub oldest: u64,\n    pub newest: u64,\n    pub history_mb: f32,\n    pub rewound: bool,\n}\n\npub struct FramePair {\n    pub prev: Arc<RenderFrame>,\n    pub curr: Arc<RenderFrame>,\n    /// When `curr` became current (wall clock).\n    pub curr_at: Instant,\n    /// Wall-clock length of one tick at the current speed.\n    pub tick_wall: f32,\n}\n\npub struct Shared {\n    pub frames: Mutex<FramePair>,\n    pub input: Mutex<InputFrame>,\n    pub control: Mutex<TimeControl>,\n    pub stats: Mutex<SimStats>,\n    pub crashed: Mutex<Option<String>>,\n    /// Events for sound and effects, drained by the render thread.\n    pub events: Mutex<Vec<SimEvent>>,\n    /// When the input that is waiting for the next tick was pressed (latency measurement).\n    pub input_stamp: Mutex<Option<Instant>>,\n    /// (pressed, consumed by a tick, that tick's number) for the latest measured press.\n    pub latency_probe: Mutex<Option<(Instant, Instant, u64)>>,\n    /// Menu commands waiting for a tick (one rides along with each tick's input).\n    pub cmds: Mutex<std::collections::VecDeque<pav_core::arpg::GameCmd>>,\n}\n\nimpl Shared {\n    /// Queues a game command for the next free tick.\n    pub fn command(&self, c: pav_core::arpg::GameCmd) {\n        let mut q = self.cmds.lock().unwrap();\n        if q.len() < 64 {\n            q.push_back(c);\n        }\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\npub struct SimHost {\n    tx: std::sync::mpsc::Sender<Cmd>,\n    pub shared: Arc<Shared>,\n    thread: Option<std::thread::JoinHandle<()>>,\n}\n\n/// In the browser the simulation lives on the main thread and `pump` advances it every frame.\n#[cfg(target_arch = \"wasm32\")]\npub struct SimHost {\n    sim: std::cell::RefCell<Sim>,\n    clock: std::cell::RefCell<Clock>,\n    pub shared: Arc<Shared>,\n}\n\nfn shared_for(sim: &mut Sim) -> Arc<Shared> {\n    let f = Arc::new(sim.frame());\n    Arc::new(Shared {\n        frames: Mutex::new(FramePair { prev: f.clone(), curr: f, curr_at: Instant::now(), tick_wall: sim.dt() }),\n        input: Mutex::new(InputFrame::default()),\n        control: Mutex::new(TimeControl::default()),\n        stats: Mutex::new(SimStats::default()),\n        crashed: Mutex::new(None),\n        events: Mutex::new(Vec::new()),\n        input_stamp: Mutex::new(None),\n        latency_probe: Mutex::new(None),\n        cmds: Mutex::new(Default::default()),\n    })\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl SimHost {\n    pub fn start(mut sim: Sim) -> Self {\n        let shared = shared_for(&mut sim);\n        let (tx, rx) = std::sync::mpsc::channel();\n        let sh = shared.clone();\n        let thread = std::thread::Builder::new()\n            .name(\"simulation\".into())\n            .spawn(move || {\n                let sh2 = sh.clone();\n                let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || run(sim, rx, sh2)));\n                if let Err(e) = r {\n                    let msg = e\n                        .downcast_ref::<&str>()\n                        .map(|s| s.to_string())\n                        .or_else(|| e.downcast_ref::<String>().cloned())\n                        .unwrap_or_else(|| \"unknown panic\".into());\n                    *sh.crashed.lock().unwrap() = Some(msg);\n                }\n            })\n            .expect(\"spawn simulation thread\");\n        Self { tx, shared, thread: Some(thread) }\n    }\n\n    /// Runs `f` on the simulation thread (fire and forget).\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + Send + 'static) {\n        let _ = self.tx.send(Cmd::Run(Box::new(f)));\n    }\n\n    /// Runs `f` on the simulation thread and waits for its result.\n    pub fn query<R: Send + 'static>(&self, f: impl FnOnce(&mut Sim) -> R + Send + 'static) -> Option<R> {\n        let (rtx, rrx) = std::sync::mpsc::channel();\n        self.exec(move |sim| {\n            let _ = rtx.send(f(sim));\n        });\n        rrx.recv_timeout(Duration::from_secs(5)).ok()\n    }\n\n    /// Advances the simulation (the thread does this by itself natively).\n    pub fn pump(&self) {}\n}\n\n#[cfg(target_arch = \"wasm32\")]\nimpl SimHost {\n    pub fn start(mut sim: Sim) -> Self {\n        let shared = shared_for(&mut sim);\n        Self { sim: std::cell::RefCell::new(sim), clock: std::cell::RefCell::new(Clock::new()), shared }\n    }\n\n    pub fn exec(&self, f: impl FnOnce(&mut Sim) + 'static) {\n        let mut sim = self.sim.borrow_mut();\n        f(&mut sim);\n        let dt = sim.dt();\n        publish(&mut sim, &self.shared, dt, Instant::now());\n    }\n\n    pub fn query<R: 'static>(&self, f: impl FnOnce(&mut Sim) -> R + 'static) -> Option<R> {\n        let mut sim = self.sim.borrow_mut();\n        let r = f(&mut sim);\n        let dt = sim.dt();\n        publish(&mut sim, &self.shared, dt, Instant::now());\n        Some(r)\n    }\n\n    /// Runs the ticks that are due (called once per frame).\n    pub fn pump(&self) {\n        self.clock.borrow_mut().advance(&mut self.sim.borrow_mut(), &self.shared);\n    }\n}\n\nimpl SimHost {\n    pub fn frames(&self) -> (Arc<RenderFrame>, Arc<RenderFrame>, Instant, f32) {\n        let f = self.shared.frames.lock().unwrap();\n        (f.prev.clone(), f.curr.clone(), f.curr_at, f.tick_wall)\n    }\n\n    pub fn control(&self) -> TimeControl {\n        *self.shared.control.lock().unwrap()\n    }\n\n    pub fn set_control(&self, f: impl FnOnce(&mut TimeControl)) {\n        f(&mut self.shared.control.lock().unwrap());\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nimpl Drop for SimHost {\n    fn drop(&mut self) {\n        let _ = self.tx.send(Cmd::Quit);\n        if let Some(t) = self.thread.take() {\n            let _ = t.join();\n        }\n    }\n}\n\nfn publish(sim: &mut Sim, sh: &Shared, tick_wall: f32, at: Instant) {\n    let events = sim.drain_events();\n    if !events.is_empty() {\n        let mut q = sh.events.lock().unwrap();\n        q.extend(events);\n        let n = q.len();\n        if n > 512 {\n            q.drain(..n - 512);\n        }\n    }\n    let frame = Arc::new(sim.frame());\n    let mut f = sh.frames.lock().unwrap();\n    f.prev = std::mem::replace(&mut f.curr, frame);\n    f.curr_at = at;\n    f.tick_wall = tick_wall;\n}\n\n/// Fixed-rate ticking with time controls (pause, single steps, speed, rewind, scrubbing).\nstruct Clock {\n    next: Instant,\n    window_start: Instant,\n    window_ticks: u32,\n    busy: Duration,\n    rewound: bool,\n    studio_mode: pav_core::prop_preview::StudioMode,\n}\n\nimpl Clock {\n    fn new() -> Self {\n        Self {\n            next: Instant::now(),\n            window_start: Instant::now(),\n            window_ticks: 0,\n            busy: Duration::ZERO,\n            rewound: false,\n            studio_mode: pav_core::prop_preview::StudioMode::World,\n        }\n    }\n\n    /// Runs whatever is due now; returns how long until the next tick.\n    fn advance(&mut self, sim: &mut Sim, sh: &Shared) -> Duration {\n        let previewing = sim.studio_active();\n        let mode = sim.studio_mode();\n        if self.studio_mode != mode {\n            self.studio_mode = mode;\n            self.next = Instant::now();\n        }\n        let ctl = *sh.control.lock().unwrap();\n        // The animation stage has its own play, pause and speed controls. The world's time\n        // controls stay untouched, including a paused or rewound game behind the stage.\n        let tick_wall = if previewing { sim.dt() } else { sim.dt() / ctl.speed.clamp(0.01, 16.0) };\n        let (busy, window_ticks) = (&mut self.busy, &mut self.window_ticks);\n        let mut tick_once = |sim: &mut Sim, at: Instant| {\n            let input = if previewing {\n                InputFrame::default()\n            } else {\n                let mut i = sh.input.lock().unwrap();\n                let mut frame = *i;\n                i.pressed = 0;\n                frame.cmd = sh.cmds.lock().unwrap().pop_front();\n                frame\n            };\n            let stamp = if previewing { None } else { sh.input_stamp.lock().unwrap().take() };\n            let t = Instant::now();\n            sim.step(&input);\n            *busy += t.elapsed();\n            if let Some(s) = stamp {\n                *sh.latency_probe.lock().unwrap() = Some((s, Instant::now(), sim.state.tick));\n            }\n            *window_ticks += 1;\n            publish(sim, sh, tick_wall, at);\n        };\n\n        let now = Instant::now();\n        if previewing {\n            let mut n = 0;\n            while now >= self.next && n < 8 {\n                self.next += Duration::from_secs_f32(tick_wall);\n                tick_once(sim, self.next);\n                n += 1;\n            }\n            if n == 8 && now > self.next {\n                self.next = now;\n            }\n        } else if ctl.rewinding {\n            if now >= self.next {\n                self.next = now + Duration::from_secs_f32(sim.dt());\n                let oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n                let target = sim.state.tick.saturating_sub(ctl.rewind_speed.max(1) as u64).max(oldest);\n                if target < sim.state.tick && sim.rewind_to(target) {\n                    self.rewound = true;\n                }\n                let dt = sim.dt();\n                publish(sim, sh, dt, now);\n            }\n        } else if let Some(t) = ctl.scrub {\n            sh.control.lock().unwrap().scrub = None;\n            if sim.rewind_to(t) {\n                self.rewound = true;\n            }\n            let dt = sim.dt();\n            publish(sim, sh, dt, now);\n            self.next = now;\n        } else if ctl.paused {\n            if ctl.step_requests > 0 {\n                sh.control.lock().unwrap().step_requests -= 1;\n                if self.rewound {\n                    sim.commit_rewind();\n                    self.rewound = false;\n                }\n                tick_once(sim, now);\n            }\n            self.next = now;\n        } else {\n            if self.rewound {\n                // Acting after a rewind starts a new timeline.\n                sim.commit_rewind();\n                self.rewound = false;\n                self.next = now;\n            }\n            let mut n = 0;\n            while now >= self.next && n < 8 {\n                self.next += Duration::from_secs_f32(tick_wall);\n                tick_once(sim, self.next);\n                n += 1;\n            }\n            if n == 8 && now > self.next {\n                self.next = now; // too far behind: drop time instead of spiralling\n            }\n        }\n\n        let elapsed = self.window_start.elapsed();\n        if elapsed >= Duration::from_millis(500) {\n            let mut s = sh.stats.lock().unwrap();\n            s.tps = self.window_ticks as f32 / elapsed.as_secs_f32();\n            s.tick_ms = if self.window_ticks > 0 { self.busy.as_secs_f32() * 1000.0 / self.window_ticks as f32 } else { 0.0 };\n            s.tick = sim.state.tick;\n            s.entities = sim.state.entities.len();\n            s.oldest = sim.history.oldest_tick().unwrap_or(sim.state.tick);\n            s.newest = sim.history.newest_tick().unwrap_or(sim.state.tick).max(sim.state.tick);\n            s.history_mb = sim.history.approx_bytes() as f32 / 1.0e6;\n            s.rewound = self.rewound;\n            self.window_start = Instant::now();\n            self.window_ticks = 0;\n            self.busy = Duration::ZERO;\n        }\n        if ctl.paused && !previewing { Duration::from_millis(4) } else { self.next.saturating_duration_since(Instant::now()) }\n    }\n}\n\n#[cfg(not(target_arch = \"wasm32\"))]\nfn run(mut sim: Sim, rx: std::sync::mpsc::Receiver<Cmd>, sh: Arc<Shared>) {\n    use std::sync::mpsc::{RecvTimeoutError, TryRecvError};\n    let mut clock = Clock::new();\n    loop {\n        // Commands first.\n        loop {\n            match rx.try_recv() {\n                Ok(Cmd::Run(job)) => {\n                    job(&mut sim);\n                    let dt = sim.dt();\n                    publish(&mut sim, &sh, dt, Instant::now());\n                }\n                Ok(Cmd::Quit) => return,\n                Err(TryRecvError::Empty) => break,\n                Err(TryRecvError::Disconnected) => return,\n            }\n        }\n        let wait = clock.advance(&mut sim, &sh);\n        match rx.recv_timeout(wait) {\n            Ok(Cmd::Run(job)) => {\n                job(&mut sim);\n                let dt = sim.dt();\n                publish(&mut sim, &sh, dt, Instant::now());\n            }\n            Ok(Cmd::Quit) => return,\n            Err(RecvTimeoutError::Timeout) => {}\n            Err(RecvTimeoutError::Disconnected) => return,\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn preview_runs_over_a_paused_world_without_changing_its_time_controls() {\n        let mut sim = Sim::empty(1);\n        let shared = shared_for(&mut sim);\n        {\n            let mut control = shared.control.lock().unwrap();\n            control.paused = true;\n            control.speed = 8.0;\n        }\n        let mut clock = Clock::new();\n        clock.rewound = true;\n        sim.preview_open(Some(\"QUATERNIUS/Idle_Loop\"), None).unwrap();\n        clock.advance(&mut sim, &shared);\n        let time = sim.preview_info().unwrap().time;\n        assert!(time >= sim.dt() && time < sim.dt() * 2.0);\n        assert!(clock.rewound, \"opening a preview must not commit the world's rewind\");\n        assert_eq!(sim.state.tick, 0);\n        let control = *shared.control.lock().unwrap();\n        assert!(control.paused);\n        assert_eq!(control.speed, 8.0);\n        sim.preview_close();\n        clock.advance(&mut sim, &shared);\n        assert_eq!(sim.state.tick, 0, \"the paused world stays paused after closing\");\n        assert!(clock.rewound);\n    }\n}\n","numLines":428,"startLine":1,"totalLines":428}},"tool_result_meta":[{"id":"toolu_019CS6NwLeV8or8PHuavhnG6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
