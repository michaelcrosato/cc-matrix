{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B8t1DG2XcHLpdQFWbF9kB4","type":"tool_result","content":"    pub fn frame(&mut self) -> RenderFrame {\n        if *self.config_arc != self.config {\n            self.config_arc = std::sync::Arc::new(self.config.clone());\n        }\n        match self.studio_mode() {\n            crate::prop_preview::StudioMode::Animation => {\n                if let Some(preview) = &self.state.animation_preview {\n                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n                }\n            }\n            crate::prop_preview::StudioMode::Prop => {\n                if let Some(preview) = &self.state.prop_preview {\n                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n                }\n            }\n            crate::prop_preview::StudioMode::Creature => {\n                return match &self.state.creature_preview {\n                    Some(preview) => preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n                    None => crate::creature_preview::empty_frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n                };\n            }\n            crate::prop_preview::StudioMode::World => {}\n        }\n        let room = self\n            .state\n            .world\n            .current_room\n            .and_then(|i| self.state.world.rooms.get(i as usize))\n            .map(|r| crate::frame::RoomInfo { id: r.id, key: r.key.clone(), def: r.def.clone(), quarters: r.place.quarters });\n        let c = &self.state.courses;\n        let invuln = self.player().and_then(|p| p.character.as_ref()).map(|c| c.invuln).unwrap_or(0.0);\n        let hud = crate::frame::HudFrame {\n            course: c.hud(self.state.tick, self.dt()),\n            last_result: c.last.clone(),\n            message: c.message.clone(),\n            feel: self.state.feel.report,\n            cue: c.cue(),\n            cue_serial: c.cue_serial,\n            invuln,\n            model: crate::params::ChoiceParam::name(self.config.movement.model).to_string(),\n            physics: self.physics_stats(),\n            view: c.view.clone(),\n            view_serial: c.view_serial,\n            boss: self.boss_bar(),\n            pad_note: c.pad_note.clone(),\n//! Tools for games built on the engine (`pav_core::games`): the starter and any game an agent\n//! adds there.\n\nuse anyhow::{Result, bail};\nuse pav_core::Sim;\nuse pav_core::games::{GAMES, Outcome};\nuse serde_json::json;\n\nuse crate::session::Session;\nuse crate::tools::{Args, Output, get_bool, get_u64};\n\n/// `play`: the running game's HUD, outcome and state; `bot=true` lets its bot play on;\n/// `seeds=N` plays fresh runs on seeds 1..N with the bot and leaves the session alone.\npub fn t_play(s: &mut Session, a: &Args) -> Result<Output> {\n    let keys = || GAMES.iter().map(|g| g.key).collect::<Vec<_>>().join(\", \");\n    let Some(key) = s.sim.play().map(|g| g.key()) else {\n        bail!(\"no game is running: `load scene=<key>` with one of: {}\", keys());\n    };\n    let bot = get_bool(a, \"bot\", false)?;\n    let ticks = get_u64(a, \"ticks\", 3600)?;\n    let hz = s.sim.config.tick_rate.hz() as f64;\n    if a.contains_key(\"seeds\") {\n        if !bot {\n            bail!(\"seeds= runs the bot: add bot=true\");\n        }\n        let n = get_u64(a, \"seeds\", 1)?.clamp(1, 200);\n        let scene = s.sim.state.scene.clone();\n        let (mut runs, mut not_won) = (Vec::new(), Vec::new());\n        let mut wins = 0;\n        for seed in 1..=n {\n            let mut sim = Sim::new(&scene, seed)?;\n            sim.config = s.sim.config.clone();\n            let (outcome, played) = sim.run_bot(ticks);\n            runs.push(json!([seed, outcome, round2(played as f64 / hz)]));\n            if outcome == Outcome::Won {\n                wins += 1;\n            } else {\n                // The state where the bot lost or ran out of time, to see why.\n                not_won.push(json!({ \"seed\": seed, \"status\": sim.play().map(|g| g.status(&sim)) }));\n            }\n        }\n        return Ok(Output::Json(json!({\n            \"game\": key,\n            \"wins\": format!(\"{wins}/{n}\"),\n            \"cols\": \"seed outcome seconds\",\n            \"runs\": runs,\n            \"not_won\": not_won,\n        })));\n    }\n    let mut played = None;\n    if bot {\n        let (_, t) = s.sim.run_bot(ticks);\n        s.keep_events();\n        s.sync_camera();\n        played = Some(round2(t as f64 / hz));\n    }\n    let g = s.sim.play().expect(\"the game is still running\");\n    Ok(Output::Json(json!({\n        \"game\": key,\n        \"outcome\": g.outcome(),\n        \"bot_seconds\": played,\n        \"time\": round2(s.sim.time()),\n        \"hud\": g.hud(&s.sim),\n        \"status\": g.status(&s.sim),\n    })))\n}\n\nfn round2(x: f64) -> f64 {\n    (x * 100.0).round() / 100.0\n}\n//! The game UI through the tools: `ui` reads the HUD, the open windows and the touch controls\n//! as text and clicks them; captures draw the UI over the game.\n\nuse pav_tools::{Output, Session};\nuse serde_json::{Value, json};\n\nfn call(s: &mut Session, tool: &str, args: Value) -> anyhow::Result<Value> {\n    match pav_tools::call(s, tool, args.as_object().unwrap())? {\n        Output::Json(value) => Ok(value),\n        Output::Image { meta, .. } => Ok(meta),\n    }\n}\n\nfn texts(list: &Value) -> Vec<String> {\n    list.as_array().unwrap().iter().map(|t| t[\"text\"].as_str().unwrap().to_owned()).collect()\n}\n\nfn window<'a>(r: &'a Value, title: &str) -> &'a Value {\n    let found = r[\"windows\"].as_array().unwrap().iter().find(|w| w[\"title\"] == title);\n    found.unwrap_or_else(|| panic!(\"no window \\\"{title}\\\": {r}\"))\n}\n\n#[test]\nfn ui_reads_the_hud_windows_and_touch_controls() {\n    let mut s = Session::new(\"town\", 1).unwrap();\n    s.step(30);\n    let r = call(&mut s, \"ui\", json!({})).unwrap();\n    let hud = texts(&r[\"hud\"]);\n    for line in [\"70/70\", \"50/50\", \"LMB\", \"1 potion\", \"Hilda the Smith\"] {\n        assert!(hud.iter().any(|t| t == line), \"the HUD shows {line}: {hud:?}\");\n    }\n    assert_eq!(r[\"windows\"], json!([]));\n\n    let r = call(&mut s, \"ui\", json!({\"open\": \"inventory,tree\"})).unwrap();\n    assert_eq!(r[\"open\"], json!([\"inventory\", \"tree\"]));\n    let inventory = texts(&window(&r, \"Inventory\")[\"text\"]);\n    assert!(inventory.iter().any(|t| t == \"helmet\") && inventory.iter().any(|t| t == \"Sort\"), \"{inventory:?}\");\n    assert!(texts(&window(&r, \"Passive Tree\")[\"text\"]).iter().any(|t| t.contains(\"points to spend\")));\n    // Text on a window's layer is the window's, even where the HUD shows under it.\n    assert!(!texts(&r[\"hud\"]).iter().any(|t| t == \"Sort\"));\n\n    // A click presses what is there: the inventory's Sort button.\n    let sort = &window(&r, \"Inventory\")[\"text\"].as_array().unwrap().iter().find(|t| t[\"text\"] == \"Sort\").unwrap()[\"at\"];\n    let at = [sort[0].as_f64().unwrap() + 8.0, sort[1].as_f64().unwrap() + 7.0];\n    let r = call(&mut s, \"ui\", json!({\"close\": \"tree\", \"click\": at})).unwrap();\n    assert_eq!(r[\"did\"], json!([\"Sort\"]), \"{r}\");\n\n    let r = call(&mut s, \"ui\", json!({\"close\": \"all\", \"device\": \"touch\", \"width\": 844, \"height\": 390})).unwrap();\n    let controls: Vec<&str> = r[\"controls\"].as_array().unwrap().iter().map(|c| c[\"control\"].as_str().unwrap()).collect();\n    for c in [\"Dodge\", \"Potion\", \"Bag\", \"Menu\", \"Skill(1)\"] {\n        assert!(controls.contains(&c), \"touch shows {c}: {controls:?}\");\n    }\n    let err = call(&mut s, \"ui\", json!({\"open\": \"inventroy\"})).unwrap_err().to_string();\n    assert!(err.contains(\"inventory\"), \"{err}\");\n}\n\n#[test]\nfn captures_draw_the_game_ui() {\n    let mut s = Session::new(\"town\", 1).unwrap();\n    s.step(30);\n//! Games built on the engine (`pav_core::games`): the starter's bot wins on many seeds, the\n//! starter can be lost, and a game's state survives snapshot files, rewind and replays like\n//! the rest of the simulation. Copy these tests for a new game.\n\nuse pav_core::games::{GAMES, Outcome};\nuse pav_core::{InputFrame, Sim, SimState};\n\n#[test]\nfn the_starter_bot_wins_on_ten_seeds() {\n    for seed in 1..=10 {\n        let mut sim = Sim::new(\"starter\", seed).unwrap();\n        let (outcome, ticks) = sim.run_bot(60 * 60);\n        let status = sim.play().unwrap().status(&sim);\n        assert_eq!(outcome, Outcome::Won, \"seed {seed}, {ticks} ticks: {status}\");\n    }\n}\n\n#[test]\nfn standing_still_gets_caught() {\n    let mut sim = Sim::new(\"starter\", 1).unwrap();\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 3\"]);\n    for _ in 0..60 * 60 {\n        sim.step(&InputFrame::default());\n    }\n    assert_eq!(sim.outcome(), Outcome::Lost);\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 0\", \"Game over\"]);\n}\n\n#[test]\nfn snapshots_rewind_and_replays_are_exact() {\n    let mut sim = Sim::new(\"starter\", 3).unwrap();\n    for _ in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n    }\n    // A snapshot file (CBOR) restores the game, and both copies then play on the same.\n    let mut bytes = Vec::new();\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\n    let state: SimState = ciborium::from_reader(bytes.as_slice()).unwrap();\n    let mut copy = Sim::new(\"starter\", 3).unwrap();\n    copy.restore(state);\n    assert_eq!(copy.state_hash(), sim.state_hash());\n    for _ in 0..240 {\n        let (a, b) = (sim.bot_input(), copy.bot_input());\n        sim.step(&a);\n        copy.step(&b);\n    }\n    assert_eq!(copy.state_hash(), sim.state_hash());\n\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\n    assert!(sim.rewind_to(tick - 90));\n    assert!(sim.rewind_to(tick));\n    assert_eq!(sim.state_hash(), hash);\n\n    let mut again = Sim::new(\"starter\", 3).unwrap();\n    for f in sim.recording.iter() {\n        again.step(f);\n    }\n    assert_eq!(again.state_hash(), hash);\n}\n42:pub fn build_standalone_room(sim: &mut Sim, key: &str, def: RoomDef) {\n43-    let place = Placement::new(def.layout.origin, 0);\n44-    let (cols, rows) = def.layout.extent();\n45-    let (min, max) = place.aabb(Vec3::new(0.0, -1.0, 0.0), Vec3::new(cols as f32, def.height.max(2.0), rows as f32));\n46-    let start = def.local_start();\n47-    let inward = -def.entrance.facing.dir();\n48-    let def = Arc::new(def);\n49-    sim.state.world = World {\n50-        enabled: false,\n51-        rooms: vec![RoomSlot {\n52-            id: 0,\n53-            key: key.to_string(),\n54-            def: def.clone(),\n55-            place,\n56-            min,\n57-            max,\n58-            inside: place.point(start),\n59-            outside: place.point(start) - inward * 4.0,\n60-            inward,\n61-            built: false,\n62-        }],\n63-        current_room: Some(0),\n64-        ..Default::default()\n65-    };\n66-    sim.build_room(0);\n67-    // Player at the \"player\" marker if the layout has one, else inside the entrance.\n68-    let marker = def\n69-        .layout\n70-        .layers\n71-        .iter()\n72-        .any(|l| def.layout.legend.iter().any(|(k, t)| t.marker.as_deref() == Some(\"player\") && l.map.contains(k.as_str())));\n88-            arg(\"height\", \"integer\", \"default 540\"),\n89-            arg(\"stats\", \"string\", \"true adds render cost; only returns it without an image\"),\n90:            arg(\"ui\", \"boolean\", \"the game UI over it (default: in a game)\"),\n91-        ],\n92-        run: t_capture,\n93-    },\n94-    Tool {\n95-        name: \"bench\",\n96-        help: \"Measure simulation ticks per second.\",\n--\n388-    },\n389-    Tool {\n390:        name: \"ui\",\n391-        help: \"The game UI as the player sees it: HUD, windows and touch controls as text; image=true draws it over the game.\",\n392-        args: &[\n393-            arg(\"open\", \"string\", \"inventory, character, skills, tree, map\"),\n394-            arg(\"close\", \"string\", \"windows, or all\"),\n395-            arg(\"device\", \"string\", \"mouse | pad | touch\"),\n396-            arg(\"hover\", \"array\", \"pointer at [x, y] (tooltips)\"),\n--\n1251-    let path = PathBuf::from(get_str(a, \"out\").map(String::from).unwrap_or(format!(\"out/capture-{}.png\", s.sim.state.tick)));\n1252-    let t = Instant::now();\n1253:    let ui = get_bool(a, \"ui\", crate::session::has_ui(&s.sim.frame()))?;\n1254-    let rgba = if ui { s.render_ui(w, h, Default::default())?.0 } else { s.render(w, h)? };\n1255-    if stats == Some(true) {\n1256-        let mut reply = render_stats(s)?;\n1257-        reply[\"render_ms\"] = json!(t.elapsed().as_millis());\n1258-        return Ok(Output::Json(reply));\n1259-    }\ncrates/pav_tools/src/game_tools.rs:1438:pub fn t_ui(s: &mut Session, a: &Args) -> Result<Output> {\ncrates/pav_tools/src/game_tools.rs-1439-    const ARGS: [&str; 9] = [\"open\", \"close\", \"device\", \"hover\", \"click\", \"width\", \"height\", \"image\", \"out\"];\ncrates/pav_tools/src/game_tools.rs-1440-    for key in a.keys() {\ncrates/pav_tools/src/game_tools.rs-1441-        if !ARGS.contains(&key.as_str()) {\ncrates/pav_tools/src/game_tools.rs-1442-            let fix = pav_core::issue::suggestion(key, ARGS).map(|f| format!(\" — {f}\")).unwrap_or_default();\ncrates/pav_tools/src/game_tools.rs-1443-            bail!(\"ui: unknown argument \\\"{key}\\\"{fix} (takes {})\", ARGS.join(\", \"));\ncrates/pav_tools/src/game_tools.rs-1444-        }\ncrates/pav_tools/src/game_tools.rs-1445-    }\ncrates/pav_tools/src/game_tools.rs-1446-    if !crate::session::has_ui(&s.sim.frame()) {\ncrates/pav_tools/src/game_tools.rs-1447-        bail!(\"no game UI in this scene (load scene=town, or a games/ game such as starter)\");\ncrates/pav_tools/src/game_tools.rs-1448-    }\ncrates/pav_tools/src/game_tools.rs-1449-    let names = |key: &str| -> Vec<String> {\ncrates/pav_tools/src/game_tools.rs-1450-        match a.get(key) {\ncrates/pav_tools/src/game_tools.rs-1451-            Some(Value::Array(v)) => v.iter().filter_map(|x| x.as_str().map(str::to_owned)).collect(),\ncrates/pav_tools/src/game_tools.rs-1452-            Some(Value::String(t)) => t.split(',').map(|x| x.trim().to_owned()).filter(|x| !x.is_empty()).collect(),\ncrates/pav_tools/src/game_tools.rs-1453-            _ => Vec::new(),\ncrates/pav_tools/src/game_tools.rs-1454-        }\ncrates/pav_tools/src/game_tools.rs-1455-    };\ncrates/pav_tools/src/game_tools.rs-1456-    let windows = pav_ui::headless::Headless::WINDOWS;\ncrates/pav_tools/src/game_tools.rs-1457-    for (key, open) in [(\"close\", false), (\"open\", true)] {\ncrates/pav_tools/src/game_tools.rs-1458-        for name in names(key) {\ncrates/pav_tools/src/game_tools.rs-1459-            if key == \"close\" && name == \"all\" {\ncrates/pav_tools/src/game_tools.rs-1460-                s.ui.game.close_all();\ncrates/pav_tools/src/game_tools.rs-1461-                s.ui.game.map = false;\ncrates/pav_tools/src/game_tools.rs-1462-            } else if !s.ui.set_open(&name, open) {\ncrates/pav_tools/src/game_tools.rs-1463-                let fix = pav_core::issue::suggestion(&name, windows).map(|f| format!(\" — {f}\")).unwrap_or_default();\ncrates/pav_tools/src/game_tools.rs-1464-                bail!(\"{key}: no window \\\"{name}\\\"{fix} (windows: {}; close=all)\", windows.join(\", \"));\ncrates/pav_tools/src/game_tools.rs-1465-            }\ncrates/pav_tools/src/game_tools.rs-1466-        }\ncrates/pav_tools/src/game_tools.rs-1467-    }\ncrates/pav_tools/src/game_tools.rs-1468-    if let Some(d) = get_str(a, \"device\") {\ncrates/pav_tools/src/game_tools.rs-1469-        s.ui.device = match d {\ncrates/pav_tools/src/game_tools.rs-1470-            \"mouse\" | \"keyboard\" => pav_ui::Device::KeyboardMouse,\ncrates/pav_tools/src/game_tools.rs-1471-            \"pad\" | \"gamepad\" => pav_ui::Device::Gamepad,\ncrates/pav_tools/src/game_tools.rs-1472-            \"touch\" => pav_ui::Device::Touch,\ncrates/pav_tools/src/game_tools.rs-1473-            o => bail!(\"device: \\\"{o}\\\" is not mouse, pad or touch\"),\ncrates/pav_tools/src/game_tools.rs-1474-        };\ncrates/pav_tools/src/game_tools.rs-1475-    }\ncrates/pav_tools/src/game_tools.rs-1476-    let point = |key: &str| -> Result<Option<egui::Pos2>> {\ncrates/pav_tools/src/game_tools.rs-1477-        match vec_arg(a, key)? {\ncrates/pav_tools/src/game_tools.rs-1478-            None => Ok(None),","is_error":false}]},"parent_tool_use_id":null,"session_id":"eb3d8a44-de88-4121-ac6f-adf7ca0c1ca2","uuid":"720005b1-407c-4379-b276-284c95fcd572","timestamp":"2026-11-05T04:38:36.282Z","tool_use_result":{"stdout":"    pub fn frame(&mut self) -> RenderFrame {\n        if *self.config_arc != self.config {\n            self.config_arc = std::sync::Arc::new(self.config.clone());\n        }\n        match self.studio_mode() {\n            crate::prop_preview::StudioMode::Animation => {\n                if let Some(preview) = &self.state.animation_preview {\n                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n                }\n            }\n            crate::prop_preview::StudioMode::Prop => {\n                if let Some(preview) = &self.state.prop_preview {\n                    return preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket);\n                }\n            }\n            crate::prop_preview::StudioMode::Creature => {\n                return match &self.state.creature_preview {\n                    Some(preview) => preview.frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n                    None => crate::creature_preview::empty_frame(self.config_arc.clone(), self.dt(), self.live_edit_ticket),\n                };\n            }\n            crate::prop_preview::StudioMode::World => {}\n        }\n        let room = self\n            .state\n            .world\n            .current_room\n            .and_then(|i| self.state.world.rooms.get(i as usize))\n            .map(|r| crate::frame::RoomInfo { id: r.id, key: r.key.clone(), def: r.def.clone(), quarters: r.place.quarters });\n        let c = &self.state.courses;\n        let invuln = self.player().and_then(|p| p.character.as_ref()).map(|c| c.invuln).unwrap_or(0.0);\n        let hud = crate::frame::HudFrame {\n            course: c.hud(self.state.tick, self.dt()),\n            last_result: c.last.clone(),\n            message: c.message.clone(),\n            feel: self.state.feel.report,\n            cue: c.cue(),\n            cue_serial: c.cue_serial,\n            invuln,\n            model: crate::params::ChoiceParam::name(self.config.movement.model).to_string(),\n            physics: self.physics_stats(),\n            view: c.view.clone(),\n            view_serial: c.view_serial,\n            boss: self.boss_bar(),\n            pad_note: c.pad_note.clone(),\n//! Tools for games built on the engine (`pav_core::games`): the starter and any game an agent\n//! adds there.\n\nuse anyhow::{Result, bail};\nuse pav_core::Sim;\nuse pav_core::games::{GAMES, Outcome};\nuse serde_json::json;\n\nuse crate::session::Session;\nuse crate::tools::{Args, Output, get_bool, get_u64};\n\n/// `play`: the running game's HUD, outcome and state; `bot=true` lets its bot play on;\n/// `seeds=N` plays fresh runs on seeds 1..N with the bot and leaves the session alone.\npub fn t_play(s: &mut Session, a: &Args) -> Result<Output> {\n    let keys = || GAMES.iter().map(|g| g.key).collect::<Vec<_>>().join(\", \");\n    let Some(key) = s.sim.play().map(|g| g.key()) else {\n        bail!(\"no game is running: `load scene=<key>` with one of: {}\", keys());\n    };\n    let bot = get_bool(a, \"bot\", false)?;\n    let ticks = get_u64(a, \"ticks\", 3600)?;\n    let hz = s.sim.config.tick_rate.hz() as f64;\n    if a.contains_key(\"seeds\") {\n        if !bot {\n            bail!(\"seeds= runs the bot: add bot=true\");\n        }\n        let n = get_u64(a, \"seeds\", 1)?.clamp(1, 200);\n        let scene = s.sim.state.scene.clone();\n        let (mut runs, mut not_won) = (Vec::new(), Vec::new());\n        let mut wins = 0;\n        for seed in 1..=n {\n            let mut sim = Sim::new(&scene, seed)?;\n            sim.config = s.sim.config.clone();\n            let (outcome, played) = sim.run_bot(ticks);\n            runs.push(json!([seed, outcome, round2(played as f64 / hz)]));\n            if outcome == Outcome::Won {\n                wins += 1;\n            } else {\n                // The state where the bot lost or ran out of time, to see why.\n                not_won.push(json!({ \"seed\": seed, \"status\": sim.play().map(|g| g.status(&sim)) }));\n            }\n        }\n        return Ok(Output::Json(json!({\n            \"game\": key,\n            \"wins\": format!(\"{wins}/{n}\"),\n            \"cols\": \"seed outcome seconds\",\n            \"runs\": runs,\n            \"not_won\": not_won,\n        })));\n    }\n    let mut played = None;\n    if bot {\n        let (_, t) = s.sim.run_bot(ticks);\n        s.keep_events();\n        s.sync_camera();\n        played = Some(round2(t as f64 / hz));\n    }\n    let g = s.sim.play().expect(\"the game is still running\");\n    Ok(Output::Json(json!({\n        \"game\": key,\n        \"outcome\": g.outcome(),\n        \"bot_seconds\": played,\n        \"time\": round2(s.sim.time()),\n        \"hud\": g.hud(&s.sim),\n        \"status\": g.status(&s.sim),\n    })))\n}\n\nfn round2(x: f64) -> f64 {\n    (x * 100.0).round() / 100.0\n}\n//! The game UI through the tools: `ui` reads the HUD, the open windows and the touch controls\n//! as text and clicks them; captures draw the UI over the game.\n\nuse pav_tools::{Output, Session};\nuse serde_json::{Value, json};\n\nfn call(s: &mut Session, tool: &str, args: Value) -> anyhow::Result<Value> {\n    match pav_tools::call(s, tool, args.as_object().unwrap())? {\n        Output::Json(value) => Ok(value),\n        Output::Image { meta, .. } => Ok(meta),\n    }\n}\n\nfn texts(list: &Value) -> Vec<String> {\n    list.as_array().unwrap().iter().map(|t| t[\"text\"].as_str().unwrap().to_owned()).collect()\n}\n\nfn window<'a>(r: &'a Value, title: &str) -> &'a Value {\n    let found = r[\"windows\"].as_array().unwrap().iter().find(|w| w[\"title\"] == title);\n    found.unwrap_or_else(|| panic!(\"no window \\\"{title}\\\": {r}\"))\n}\n\n#[test]\nfn ui_reads_the_hud_windows_and_touch_controls() {\n    let mut s = Session::new(\"town\", 1).unwrap();\n    s.step(30);\n    let r = call(&mut s, \"ui\", json!({})).unwrap();\n    let hud = texts(&r[\"hud\"]);\n    for line in [\"70/70\", \"50/50\", \"LMB\", \"1 potion\", \"Hilda the Smith\"] {\n        assert!(hud.iter().any(|t| t == line), \"the HUD shows {line}: {hud:?}\");\n    }\n    assert_eq!(r[\"windows\"], json!([]));\n\n    let r = call(&mut s, \"ui\", json!({\"open\": \"inventory,tree\"})).unwrap();\n    assert_eq!(r[\"open\"], json!([\"inventory\", \"tree\"]));\n    let inventory = texts(&window(&r, \"Inventory\")[\"text\"]);\n    assert!(inventory.iter().any(|t| t == \"helmet\") && inventory.iter().any(|t| t == \"Sort\"), \"{inventory:?}\");\n    assert!(texts(&window(&r, \"Passive Tree\")[\"text\"]).iter().any(|t| t.contains(\"points to spend\")));\n    // Text on a window's layer is the window's, even where the HUD shows under it.\n    assert!(!texts(&r[\"hud\"]).iter().any(|t| t == \"Sort\"));\n\n    // A click presses what is there: the inventory's Sort button.\n    let sort = &window(&r, \"Inventory\")[\"text\"].as_array().unwrap().iter().find(|t| t[\"text\"] == \"Sort\").unwrap()[\"at\"];\n    let at = [sort[0].as_f64().unwrap() + 8.0, sort[1].as_f64().unwrap() + 7.0];\n    let r = call(&mut s, \"ui\", json!({\"close\": \"tree\", \"click\": at})).unwrap();\n    assert_eq!(r[\"did\"], json!([\"Sort\"]), \"{r}\");\n\n    let r = call(&mut s, \"ui\", json!({\"close\": \"all\", \"device\": \"touch\", \"width\": 844, \"height\": 390})).unwrap();\n    let controls: Vec<&str> = r[\"controls\"].as_array().unwrap().iter().map(|c| c[\"control\"].as_str().unwrap()).collect();\n    for c in [\"Dodge\", \"Potion\", \"Bag\", \"Menu\", \"Skill(1)\"] {\n        assert!(controls.contains(&c), \"touch shows {c}: {controls:?}\");\n    }\n    let err = call(&mut s, \"ui\", json!({\"open\": \"inventroy\"})).unwrap_err().to_string();\n    assert!(err.contains(\"inventory\"), \"{err}\");\n}\n\n#[test]\nfn captures_draw_the_game_ui() {\n    let mut s = Session::new(\"town\", 1).unwrap();\n    s.step(30);\n//! Games built on the engine (`pav_core::games`): the starter's bot wins on many seeds, the\n//! starter can be lost, and a game's state survives snapshot files, rewind and replays like\n//! the rest of the simulation. Copy these tests for a new game.\n\nuse pav_core::games::{GAMES, Outcome};\nuse pav_core::{InputFrame, Sim, SimState};\n\n#[test]\nfn the_starter_bot_wins_on_ten_seeds() {\n    for seed in 1..=10 {\n        let mut sim = Sim::new(\"starter\", seed).unwrap();\n        let (outcome, ticks) = sim.run_bot(60 * 60);\n        let status = sim.play().unwrap().status(&sim);\n        assert_eq!(outcome, Outcome::Won, \"seed {seed}, {ticks} ticks: {status}\");\n    }\n}\n\n#[test]\nfn standing_still_gets_caught() {\n    let mut sim = Sim::new(\"starter\", 1).unwrap();\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 3\"]);\n    for _ in 0..60 * 60 {\n        sim.step(&InputFrame::default());\n    }\n    assert_eq!(sim.outcome(), Outcome::Lost);\n    assert_eq!(sim.frame().hud.lines, [\"Shards 0/5\", \"Lives 0\", \"Game over\"]);\n}\n\n#[test]\nfn snapshots_rewind_and_replays_are_exact() {\n    let mut sim = Sim::new(\"starter\", 3).unwrap();\n    for _ in 0..240 {\n        let f = sim.bot_input();\n        sim.step(&f);\n    }\n    // A snapshot file (CBOR) restores the game, and both copies then play on the same.\n    let mut bytes = Vec::new();\n    ciborium::into_writer(&sim.snapshot(), &mut bytes).unwrap();\n    let state: SimState = ciborium::from_reader(bytes.as_slice()).unwrap();\n    let mut copy = Sim::new(\"starter\", 3).unwrap();\n    copy.restore(state);\n    assert_eq!(copy.state_hash(), sim.state_hash());\n    for _ in 0..240 {\n        let (a, b) = (sim.bot_input(), copy.bot_input());\n        sim.step(&a);\n        copy.step(&b);\n    }\n    assert_eq!(copy.state_hash(), sim.state_hash());\n\n    let (tick, hash) = (sim.state.tick, sim.state_hash());\n    assert!(sim.rewind_to(tick - 90));\n    assert!(sim.rewind_to(tick));\n    assert_eq!(sim.state_hash(), hash);\n\n    let mut again = Sim::new(\"starter\", 3).unwrap();\n    for f in sim.recording.iter() {\n        again.step(f);\n    }\n    assert_eq!(again.state_hash(), hash);\n}\n42:pub fn build_standalone_room(sim: &mut Sim, key: &str, def: RoomDef) {\n43-    let place = Placement::new(def.layout.origin, 0);\n44-    let (cols, rows) = def.layout.extent();\n45-    let (min, max) = place.aabb(Vec3::new(0.0, -1.0, 0.0), Vec3::new(cols as f32, def.height.max(2.0), rows as f32));\n46-    let start = def.local_start();\n47-    let inward = -def.entrance.facing.dir();\n48-    let def = Arc::new(def);\n49-    sim.state.world = World {\n50-        enabled: false,\n51-        rooms: vec![RoomSlot {\n52-            id: 0,\n53-            key: key.to_string(),\n54-            def: def.clone(),\n55-            place,\n56-            min,\n57-            max,\n58-            inside: place.point(start),\n59-            outside: place.point(start) - inward * 4.0,\n60-            inward,\n61-            built: false,\n62-        }],\n63-        current_room: Some(0),\n64-        ..Default::default()\n65-    };\n66-    sim.build_room(0);\n67-    // Player at the \"player\" marker if the layout has one, else inside the entrance.\n68-    let marker = def\n69-        .layout\n70-        .layers\n71-        .iter()\n72-        .any(|l| def.layout.legend.iter().any(|(k, t)| t.marker.as_deref() == Some(\"player\") && l.map.contains(k.as_str())));\n88-            arg(\"height\", \"integer\", \"default 540\"),\n89-            arg(\"stats\", \"string\", \"true adds render cost; only returns it without an image\"),\n90:            arg(\"ui\", \"boolean\", \"the game UI over it (default: in a game)\"),\n91-        ],\n92-        run: t_capture,\n93-    },\n94-    Tool {\n95-        name: \"bench\",\n96-        help: \"Measure simulation ticks per second.\",\n--\n388-    },\n389-    Tool {\n390:        name: \"ui\",\n391-        help: \"The game UI as the player sees it: HUD, windows and touch controls as text; image=true draws it over the game.\",\n392-        args: &[\n393-            arg(\"open\", \"string\", \"inventory, character, skills, tree, map\"),\n394-            arg(\"close\", \"string\", \"windows, or all\"),\n395-            arg(\"device\", \"string\", \"mouse | pad | touch\"),\n396-            arg(\"hover\", \"array\", \"pointer at [x, y] (tooltips)\"),\n--\n1251-    let path = PathBuf::from(get_str(a, \"out\").map(String::from).unwrap_or(format!(\"out/capture-{}.png\", s.sim.state.tick)));\n1252-    let t = Instant::now();\n1253:    let ui = get_bool(a, \"ui\", crate::session::has_ui(&s.sim.frame()))?;\n1254-    let rgba = if ui { s.render_ui(w, h, Default::default())?.0 } else { s.render(w, h)? };\n1255-    if stats == Some(true) {\n1256-        let mut reply = render_stats(s)?;\n1257-        reply[\"render_ms\"] = json!(t.elapsed().as_millis());\n1258-        return Ok(Output::Json(reply));\n1259-    }\ncrates/pav_tools/src/game_tools.rs:1438:pub fn t_ui(s: &mut Session, a: &Args) -> Result<Output> {\ncrates/pav_tools/src/game_tools.rs-1439-    const ARGS: [&str; 9] = [\"open\", \"close\", \"device\", \"hover\", \"click\", \"wid