> !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\nexport const TIMINGS = Object.freeze({\n  helloMs: 10_000,\n  readyMs: 45_000,\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n  loadGraceMs: 20_000,\n  countdownMs: 3_000,\n  graceMs: 5_000,\n  hiddenMs: 20_000,\n  maxRoundMs: 15 * 60_000,\n});\n\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n\n/** Each mode's name on screen. */\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n\n/** The mode a tag or a hello names, older tags included; null for anything else. */\nexport function modeOf(word) {\n  const w = String(word ?? '').trim().toLowerCase();\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HJxW56H4xhuFAzbtUKUiuV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
