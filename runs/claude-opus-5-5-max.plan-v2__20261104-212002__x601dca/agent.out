{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XFqhgkm6hPHH3NpZCSMXqm","type":"tool_result","content":"/**\n * @file What a game made from the engine holds, and the lock that pins it (PLAN.md WP 10.7, ADR-0024): which of the\n * engine's files a game gets and as whose (`RULES`, `ownerOf`, `plan`), the engine's identity (`engineIdentity`), its\n * package.json and package-lock.json from the engine's (`gamePackage`, `gameLockfile`, `npmClashes`, `npmLost`), and\n * engine-lock.json, the game's record of the engine commit and every engine file's SHA-256 (`lockFor`, `verifyGame`).\n * tools/game/new-game.mjs makes and updates games with it; `node x engine` and `x check`'s `engine` plugin read it in\n * a game. Plain JavaScript for any Node from 18, as new-game.mjs runs before anything is installed.\n *\n * Whose a file is: 'engine' files are copied into every game byte for byte and never edited there (engine/, tools/,\n * data/, the box as the worked example, the configs, scripts/setup.sh, DOCTRINE.md and the docs a game reads); the\n * starter game (labs/game/) is copied once and is the game's own from then on; 'skip' stays in the engine's\n * repository (its plan, records, CI, the one-file playground, test suites, fixtures, the playground, labs/playground/, whose\n * mechanisms a game reaches through the engine, and the lab pages with their index, labs/labs.json, WP 10.8). A path no rule names is never copied, and\n * tools/game/new-game.test.ts fails on one, so each new file at the engine's root is a decision.\n *\n * Invariants: lists use `/` and are sorted; the lock's `files` are the game's paths; its `npm` holds the package.json\n * entries the engine gave the game (`engineNpm`), so an update tells them from the game's own; its `templates` holds\n * each root file new-game.mjs wrote from tools/game/template/, with the SHA-256 of what it wrote (null for a file the\n * game already had); a declared patch is a path in backticks at the start of a list item under ENGINE-FEEDBACK.md's\n * \"## Local engine patches\", outside comments.\n *\n * @example\n * ownerOf('engine/sim/world.ts'); // 'engine'\n * ownerOf('labs/game/scenes/play.ts'); // 'game'\n * ownerOf('PLAN.md'); // 'skip'\n * plan().find((item) => item.from === 'LICENSE')?.to; // 'engine/LICENSE'\n * @see tools/game/new-game.test.ts\n */\nimport { execFileSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync } from 'node:fs';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\n/** Where the engine lives on GitHub: what a game's lock names and `x engine --update` clones. */\nexport const ENGINE_REPOSITORY = 'https://github.com/michaelcrosato/my-3dge';\n/** The lock a game keeps at its root: the engine's commit and every engine file's hash. */\nexport const LOCK_FILE = 'engine-lock.json';\n/** The lock's format. */\nexport const LOCK_FORMAT = 'my3dge-engine-lock/1';\n/** Where a game writes what it needed from the engine, and declares the engine files it patched. */\nexport const FEEDBACK_FILE = 'ENGINE-FEEDBACK.md';\n/** The starter game: copied into a new game, then the game's own. */\nexport const STARTER = 'labs/game/';\n\n/** This checkout's root: two levels above this file. */\nexport const SOURCE = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');\n\n/** Single files a game gets as the engine's: configs, setup, the hook, the pages and docs its tools and agents read. */\nconst ENGINE_FILES = new Set([\n  'x.js',\n  'vite.config.ts',\n  'eslint.config.js',\n  'tsconfig.json',\n  'tsconfig.base.json',\n  'tsconfig.check.json',\n  'tsconfig.engine.json',\n  'tsconfig.apps.json',\n  'tsconfig.tests.json',\n  '.prettierrc.json',\n  '.prettierignore',\n  '.editorconfig',\n  '.nvmrc',\n  'DOCTRINE.md',\n  'scripts/setup.sh',\n  'docs/GAME-GUIDE.md',\n  'docs/API.md',\n  'docs/ERRORS.md',\n  'tests/setup/adviceTrap.ts',\n  'tests/pages/replay.html',\n  'tests/pages/replay.ts',\n  '.claude/hooks/post-tool-use.ts',\n]);\n\n/** Engine files a game gets under another path: the engine's license travels with its code. */\nexport const RENAMED = Object.freeze({ LICENSE: 'engine/LICENSE' });\n\n/** The engine's own: plan, records, CI, the one-file playground, suites, fixtures, evals and mutation runs, playground and lean. */\nconst ENGINE_ONLY =\n  /^(PLAN\\.md|AGENTS\\.md|CLAUDE\\.md|GEMINI\\.md|README\\.md|index\\.html|package(-lock)?\\.json|playwright\\.config\\.ts|stryker\\.config\\.json|playground\\.html|\\.gitignore|\\.gitattributes|\\.github\\/|\\.claude\\/|fixtures\\/|tests\\/|docs\\/|scripts\\/|evals\\/|labs\\/hello\\/|labs\\/playground\\/|labs\\/labs\\.json|labs\\/(anim|cameras|fx|index|library|materials|physics|props)\\/|lean\\/)/;\n\n/** Which source files a game gets, and as whose: the first rule whose `test` matches a path decides (`ownerOf`). */\nexport const RULES = Object.freeze([\n  { owner: 'game', why: 'the starter game: the game’s own once copied', test: (p) => p.startsWith(STARTER) },\n  { owner: 'skip', why: 'the engine’s tests stay in its repository', test: (p) => p.endsWith('.test.ts') },\n  { owner: 'engine', why: 'the engine, its tools and data', test: (p) => /^(engine|tools|data)\\//.test(p) },\n  { owner: 'engine', why: 'the box: the engine’s worked example', test: (p) => p.startsWith('labs/box/') },\n  { owner: 'skip', why: 'the port’s reference vectors: x port is the engine’s', test: (p) => p.startsWith('tests/baselines/port/') }, // prettier-ignore\n  { owner: 'engine', why: 'the baselines its tools read (QA, advice, perf, thumbnails)', test: (p) => p.startsWith('tests/baselines/') }, // prettier-ignore\n  { owner: 'engine', why: 'configs, setup and docs a game reads', test: (p) => ENGINE_FILES.has(p) || p in RENAMED },\n  { owner: 'skip', why: 'the engine’s own: plan, records, CI, suites', test: (p) => ENGINE_ONLY.test(p) },\n]);\n\n/** Never walked when the source is no git checkout (an archive): what git would ignore. */\nconst UNTRACKED = new Set(['.git', 'node_modules', 'out', 'dist', '.cache', 'test-results']);\n\n/** Whose a source path is: 'engine', 'game' (the starter) or 'skip'; null when no rule names it. */\nexport function ownerOf(path) {\n  return RULES.find((rule) => rule.test(path))?.owner ?? null;\n}\n\n/** The source's files, as git tracks or would track them (or, in an archive, every file), sorted, with `/`. */\nexport function sourceFiles(source = SOURCE) {\n  if (existsSync(join(source, '.git'))) {\n    try {\n      const args = ['-C', source, 'ls-files', '-z', '--cached', '--others', '--exclude-standard'];\n      const listed = execFileSync('git', args, { encoding: 'utf8', maxBuffer: 64 << 20 });\n      return [...new Set(listed.split('\\0'))].filter((p) => p && existsSync(join(source, p))).sort();\n    } catch {\n      // no git on PATH: walk instead\n    }\n  }\n  const files = [];\n  const walk = (dir) => {\n    for (const entry of readdirSync(join(source, dir), { withFileTypes: true })) {\n      if (UNTRACKED.has(entry.name)) continue;\n      const path = dir ? `${dir}/${entry.name}` : entry.name;\n      if (entry.isDirectory()) walk(path);\n      else if (entry.isFile()) files.push(path);\n    }\n---SETUP\n#!/usr/bin/env bash\n# scripts/setup.sh: the development platform (PLAN.md §6.10, WP 0.1). Idempotent: run it as often as you like.\n#\n#   bash scripts/setup.sh\n#\n# 1. Node. When the active `node` is not the version in .nvmrc, it downloads the official Linux x64 build from\n#    nodejs.org, checks it against SHASUMS256.txt, unpacks it under ~/.cache/my3dge/ (once), puts it first on PATH\n#    for the rest of this script, and appends that PATH to $CLAUDE_ENV_FILE when the variable is set, so later\n#    Claude Code shells use it. Offline, it says so and keeps the active Node (everything also runs on Node 22;\n#    Node goldens are recorded on 24).\n# 2. The read-only source checkouts. $MY3D2DGE_SRC (my-3d2dge@e37e4ee) and $SHARDFALL_SRC (shardfall@fa2dab6) are\n#    resolved in this order: the environment variable; else an existing local clone, cloned with\n#    `git clone --shared` into .cache/src-3d2dge or .cache/src-shardfall; else a clone from GitHub. Either clone is\n#    then detached at the pinned commit. The resolved paths are printed, and appended to $CLAUDE_ENV_FILE when set.\n#    In a game made from the engine (engine-lock.json at its root, tools/game/new-game.mjs), nothing ports from the\n#    sources, so this step is skipped.\n# 3. Chromium. Outside the cloud container (no /opt/pw-browsers/chromium and no $CHROMIUM_PATH), it downloads Chrome for\n#    Testing at the platform's release (tools/deps.json) from Google's official bucket into ~/.cache/my3dge/ (once);\n#    tools/lib/browser.ts finds it there, so no shell state is needed. Offline, it warns and T2 cannot run.\n# 4. `npm ci`.\n#\n# Exit status: 0 when the dependencies are installed (an offline Node download or an unreachable source only warns);\n# 1 when `npm ci` fails.\n\nset -euo pipefail\n\nrepo_root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$repo_root\"\n\nsay() { printf 'setup: %s\\n' \"$*\"; }\n\n# Appends one line to $CLAUDE_ENV_FILE, unless the variable is unset or the line is already there.\nappend_env_line() {\n  local line=\"$1\"\n  [ -n \"${CLAUDE_ENV_FILE:-}\" ] || return 0\n  touch \"$CLAUDE_ENV_FILE\"\n  grep -qxF -- \"$line\" \"$CLAUDE_ENV_FILE\" || printf '%s\\n' \"$line\" >>\"$CLAUDE_ENV_FILE\"\n}\n\n# ---------------------------------------------------------------------------------------------------------------------\n# 1. Node\n# ---------------------------------------------------------------------------------------------------------------------\n\nwant_version=\"$(tr -d ' \\t\\r\\nv' <.nvmrc)\"\nactive_version=\"$(node --version 2>/dev/null | tr -d 'v' || true)\"\ncache_dir=\"$HOME/.cache/my3dge\"\nnode_name=\"node-v${want_version}-linux-x64\"\nnode_dir=\"$cache_dir/$node_name\"\n\n# Downloads the official build, checks it against SHASUMS256.txt and moves it into $node_dir. Runs in a subshell so\n# its temporary directory is always removed. Exits non-zero, having installed nothing, when offline or on a mismatch.\ninstall_node() (\n  base=\"https://nodejs.org/dist/v${want_version}\"\n  if command -v xz >/dev/null 2>&1; then tarball=\"${node_name}.tar.xz\"; else tarball=\"${node_name}.tar.gz\"; fi\n  mkdir -p \"$cache_dir\"\n  work=\"$(mktemp -d \"$cache_dir/.download.XXXXXX\")\"\n  trap 'rm -rf \"$work\"' EXIT\n  curl_opts=(--fail --silent --show-error --location --retry 2 --connect-timeout 15)\n  if ! curl \"${curl_opts[@]}\" -o \"$work/SHASUMS256.txt\" \"$base/SHASUMS256.txt\" ||\n    ! curl \"${curl_opts[@]}\" -o \"$work/$tarball\" \"$base/$tarball\"; then\n    say \"offline: could not download Node ${want_version} from nodejs.org\"\n    exit 1\n  fi\n  awk -v f=\"$tarball\" '$2 == f' \"$work/SHASUMS256.txt\" >\"$work/expected.txt\"\n  if [ ! -s \"$work/expected.txt\" ] || ! (cd \"$work\" && sha256sum --check --status expected.txt); then\n    say \"error: ${tarball} does not match nodejs.org's SHASUMS256.txt; nothing was installed\"\n    exit 1\n  fi\n  mkdir \"$work/unpacked\"\n  if ! tar -xf \"$work/$tarball\" -C \"$work/unpacked\" || [ ! -x \"$work/unpacked/$node_name/bin/node\" ]; then\n    say \"error: could not unpack ${tarball}; nothing was installed\"\n    exit 1\n  fi\n  rm -rf \"$node_dir\"\n  mv \"$work/unpacked/$node_name\" \"$node_dir\"\n  say \"installed Node ${want_version} (SHA-256 checked) in $node_dir\"\n)\n\nif [ \"$active_version\" = \"$want_version\" ]; then\n  say \"Node ${want_version} is active ($(command -v node)); nothing to install\"\nelif [ \"$(uname -s)\" != \"Linux\" ] || [ \"$(uname -m)\" != \"x86_64\" ]; then\n  say \"not the development platform (Linux x64); keeping the active Node ${active_version:-none}\"\nelse\n  if [ \"$(\"$node_dir/bin/node\" --version 2>/dev/null || true)\" = \"v${want_version}\" ]; then\n    say \"Node ${want_version} is already in $node_dir\"\n  else\n    install_node || true\n  fi\n  if [ -x \"$node_dir/bin/node\" ]; then\n    export PATH=\"$node_dir/bin:$PATH\"\n    path_line=\"export PATH=\\\"$node_dir/bin:\\$PATH\\\"\"\n    append_env_line \"$path_line\"\n    say \"Node ${want_version} is first on PATH for this script; for another shell: $path_line\"\n  else\n    say \"keeping the active Node ${active_version:-none}: everything runs on it, but Node goldens are recorded on ${want_version}\"\n  fi\nfi\n\n# ---------------------------------------------------------------------------------------------------------------------\n# 2. The read-only source checkouts\n# ---------------------------------------------------------------------------------------------------------------------\n\n# resolve_source VAR DEST COMMIT LOCAL_CLONE URL\n#   VAR          the environment variable that may already name a checkout (used as it is: it is read-only)\n#   DEST         the clone under the repository used otherwise\n#   COMMIT       the pinned commit (full SHA)\n#   LOCAL_CLONE  an existing clone to share objects with (the Claude Code cloud image's)\n#   URL          the GitHub repository, the last resort\n# Prints the resolved path and appends `export VAR=<path>` to $CLAUDE_ENV_FILE. Problems only warn.\nresolve_source() {\n  local var=\"$1\" dest=\"$2\" commit=\"$3\" local_clone=\"$4\" url=\"$5\" path head\n  [ -f \"$repo_root/engine-lock.json\" ] && return 0 # a game: nothing ports from the sources (see step 2 above)\n  if [ -n \"${!var:-}\" ]; then\n    path=\"${!var}\"\n  else\n    path=\"$repo_root/$dest\"\n    if [ ! -d \"$path/.git\" ]; then\n      rm -rf \"$path\"\n      mkdir -p \"$(dirname \"$path\")\"\n      if [ -d \"$local_clone/.git\" ]; then\n---\n{\n  \"name\": \"my-3dge\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"A fully 3D web game engine written and maintained only by AI coding agents: three.js on WebGPU, Rapier physics, gameplay reproducible on the CPU.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=24.10 <25\"\n  },\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"typecheck\": \"tsc -b tsconfig.check.json\",\n    \"lint\": \"eslint --cache --cache-location node_modules/.cache/eslint/ .\",\n    \"format\": \"prettier --write --cache .\",\n    \"check\": \"node tools/checkAll.ts\",\n    \"test\": \"vitest run\",\n    \"e2e\": \"playwright test\"\n  },\n  \"dependencies\": {\n    \"@dimforge/rapier3d-simd-compat\": \"0.21.0\",\n    \"@stdlib/math-base-special-cos\": \"0.3.1\",\n    \"@stdlib/math-base-special-pow\": \"0.3.1\",\n    \"@stdlib/math-base-special-sin\": \"0.3.1\",\n    \"three\": \"0.182.0\"\n  },\n  \"devDependencies\": {\n    \"@modelcontextprotocol/sdk\": \"1.32.2\",\n    \"@playwright/test\": \"1.64.1\",\n    \"@stryker-mutator/core\": \"9.6.1\",\n    \"@stryker-mutator/vitest-runner\": \"9.6.1\",\n    \"@types/node\": \"24.19.2\",\n    \"@types/three\": \"0.182.0\",\n    \"eslint\": \"9.39.5\",\n    \"eslint-plugin-jsdoc\": \"61.7.1\",\n    \"globals\": \"16.5.0\",\n    \"prettier\": \"3.9.10\",\n    \"tsx\": \"4.23.15\",\n    \"typescript\": \"5.9.3\",\n    \"typescript-eslint\": \"8.72.1\",\n    \"vite\": \"7.3.7\",\n    \"vitest\": \"4.1.12\"\n  },\n  \"allowScripts\": {\n    \"esbuild\": false\n  }\n}\n24.22.2\ntools:\nanim\ncheckAll.test.ts\ncheckAll.ts\ncmd\ndeps.json\neslint\ngame\nlib\nmcp\nqa\nstryker\ntemplates\nx.test.ts\nx.ts\n\ntools/cmd:\nanim.test.ts\nanim.ts\naudio.test.ts\naudio.ts\ncheck.test.ts\ncheck.ts\nci-workflow.test.ts\nci.test.ts\nci.ts\ndeps.test.ts\ndeps.ts\ndescribe.test.ts\ndescribe.ts\ndocs.test.ts\ndocs.ts\ndump.ts\nengine.test.ts\nengine.ts\nesc.test.ts\nesc.ts\neval.ts\nevals.test.ts\nevals.ts\neye.test.ts\neye.ts\nfeel.test.ts\nfeel.ts\nfilm.test.ts\nfilm.ts\ngallery.test.ts\ngallery.ts\nhelp.ts\nhtml.test.ts\nhtml.ts\ninspect.test.ts\ninspect.ts\nlab.test.ts\nlab.ts\nmcp.test.ts\nmcp.ts\nnew.test.ts\nnew.ts\nperf.test.ts\nperf.ts\nport.test.ts\nport.ts\nqa.test.ts\nqa.ts\nreplay.test.ts\nreplay.ts\nset.test.ts\nset.ts\nsheet.test.ts\nsheet.ts\nshot.test.ts\nshot.ts\nsim.test.ts\nsim.ts\nsrc.ts","is_error":false}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"a8d7dcdb-7230-49b7-858b-51aac3d6dd53","timestamp":"2026-11-05T04:25:37.800Z","tool_use_result":{"stdout":"/**\n * @file What a game made from the engine holds, and the lock that pins it (PLAN.md WP 10.7, ADR-0024): which of the\n * engine's files a game gets and as whose (`RULES`, `ownerOf`, `plan`), the engine's identity (`engineIdentity`), its\n * package.json and package-lock.json from the engine's (`gamePackage`, `gameLockfile`, `npmClashes`, `npmLost`), and\n * engine-lock.json, the game's record of the engine commit and every engine file's SHA-256 (`lockFor`, `verifyGame`).\n * tools/game/new-game.mjs makes and updates games with it; `node x engine` and `x check`'s `engine` plugin read it in\n * a game. Plain JavaScript for any Node from 18, as new-game.mjs runs before anything is installed.\n *\n * Whose a file is: 'engine' files are copied into every game byte for byte and never edited there (engine/, tools/,\n * data/, the box as the worked example, the configs, scripts/setup.sh, DOCTRINE.md and the docs a game reads); the\n * starter game (labs/game/) is copied once and is the game's own from then on; 'skip' stays in the engine's\n * repository (its plan, records, CI, the one-file playground, test suites, fixtures, the playground, labs/playground/, whose\n * mechanisms a game reaches through the engine, and the lab pages with their index, labs/labs.json, WP 10.8). A path no rule names is never copied, and\n * tools/game/new-game.test.ts fails on one, so each new file at the engine's root is a decision.\n *\n * Invariants: lists use `/` and are sorted; the lock's `files` are the game's paths; its `npm` holds the package.json\n * entries the engine gave the game (`engineNpm`), so an update tells them from the game's own; its `templates` holds\n * each root file new-game.mjs wrote from tools/game/template/, with the SHA-256 of what it wrote (null for a file the\n * game already had); a declared patch is a path in backticks at the start of a list item under ENGINE-FEEDBACK.md's\n * \"## Local engine patches\", outside comments.\n *\n * @example\n * ownerOf('engine/sim/world.ts'); // 'engine'\n * ownerOf('labs/game/scenes/play.ts'); // 'game'\n * ownerOf('PLAN.md'); // 'skip'\n * plan().find((item) => item.from === 'LICENSE')?.to; // 'engine/LICENSE'\n * @see tools/game/new-game.test.ts\n */\nimport { execFileSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync } from 'node:fs';\nimport { dirname, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\n/** Where the engine lives on GitHub: what a game's lock names and `x engine --update` clones. */\nexport const ENGINE_REPOSITORY = 'https://github.com/michaelcrosato/my-3dge';\n/** The lock a game keeps at its root: the engine's commit and every engine file's hash. */\nexport const LOCK_FILE = 'engine-lock.json';\n/** The lock's format. */\nexport const LOCK_FORMAT = 'my3dge-engine-lock/1';\n/** Where a game writes what it needed from the engine, and declares the engine files it patched. */\nexport const FEEDBACK_FILE = 'ENGINE-FEEDBACK.md';\n/** The starter game: copied into a new game, then the game's own. */\nexport const STARTER = 'labs/game/';\n\n/** This checkout's root: two levels above this file. */\nexport const SOURCE = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');\n\n/** Single files a game gets as the engine's: configs, setup, the hook, the pages and docs its tools and agents read. */\nconst ENGINE_FILES = new Set([\n  'x.js',\n  'vite.config.ts',\n  'eslint.config.js',\n  'tsconfig.json',\n  'tsconfig.base.json',\n  'tsconfig.check.json',\n  'tsconfig.engine.json',\n  'tsconfig.apps.json',\n  'tsconfig.tests.json',\n  '.prettierrc.json',\n  '.prettierignore',\n  '.editorconfig',\n  '.nvmrc',\n  'DOCTRINE.md',\n  'scripts/setup.sh',\n  'docs/GAME-GUIDE.md',\n  'docs/API.md',\n  'docs/ERRORS.md',\n  'tests/setup/adviceTrap.ts',\n  'tests/pages/replay.html',\n  'tests/pages/replay.ts',\n  '.claude/hooks/post-tool-use.ts',\n]);\n\n/** Engine files a game gets under another path: the engine's license travels with its code. */\nexport const RENAMED = Object.freeze({ LICENSE: 'engine/LICENSE' });\n\n/** The engine's own: plan, records, CI, the one-file playground, suites, fixtures, evals and mutation runs, playground and lean. */\nconst ENGINE_ONLY =\n  /^(PLAN\\.md|AGENTS\\.md|CLAUDE\\.md|GEMINI\\.md|README\\.md|index\\.html|package(-lock)?\\.json|playwright\\.config\\.ts|stryker\\.config\\.json|playground\\.html|\\.gitignore|\\.gitattributes|\\.github\\/|\\.claude\\/|fixtures\\/|tests\\/|docs\\/|scripts\\/|evals\\/|labs\\/hello\\/|labs\\/playground\\/|labs\\/labs\\.json|labs\\/(anim|cameras|fx|index|library|materials|physics|props)\\/|lean\\/)/;\n\n/** Which source files a game gets, and as whose: the first rule whose `test` matches a path decides (`ownerOf`). */\nexport const RULES = Object.freeze([\n  { owner: 'game', why: 'the starter game: the game’s own once copied', test: (p) => p.startsWith(STARTER) },\n  { owner: 'skip', why: 'the engine’s tests stay in its repository', test: (p) => p.endsWith('.test.ts') },\n  { owner: 'engine', why: 'the engine, its tools and data', test: (p) => /^(engine|tools|data)\\//.test(p) },\n  { owner: 'engine', why: 'the box: the engine’s worked example', test: (p) => p.startsWith('labs/box/') },\n  { owner: 'skip', why: 'the port’s reference vectors: x port is the engine’s', test: (p) => p.startsWith('tests/baselines/port/') }, // prettier-ignore\n  { owner: 'engine', why: 'the baselines its tools read (QA, advice, perf, thumbnails)', test: (p) => p.startsWith('tests/baselines/') }, // prettier-ignore\n  { owner: 'engine', why: 'configs, setup and docs a game reads', test: (p) => ENGINE_FILES.has(p) || p in RENAMED },\n  { owner: 'skip', why: 'the engine’s own: plan, records, CI, suites', test: (p) => ENGINE_ONLY.test(p) },\n]);\n\n/** Never walked when the source is no git checkout (an archive): what git would ignore. */\nconst UNTRACKED = new Set(['.git', 'node_modules', 'out', 'dist', '.cache', 'test-results']);\n\n/** Whose a source path is: 'engine', 'game' (the starter) or 'skip'; null when no rule names it. */\nexport function ownerOf(path) {\n  return RULES.find((rule) => rule.test(path))?.owner ?? null;\n}\n\n/** The source's files, as git tracks or would track them (or, in an archive, every file), sorted, with `/`. */\nexport function sourceFiles(source = SOURCE) {\n  if (existsSync(join(source, '.git'))) {\n    try {\n      const args = ['-C', source, 'ls-files', '-z', '--cached', '--others', '--exclude-standard'];\n      const listed = execFileSync('git', args, { encoding: 'utf8', maxBuffer: 64 << 20 });\n      return [...new Set(listed.split('\\0'))].filter((p) => p && existsSync(join(source, p))).sort();\n    } catch {\n      // no git on PATH: walk instead\n    }\n  }\n  const files = [];\n  const walk = (dir) => {\n    for (const entry of readdirSync(join(source, dir), { withFileTypes: true })) {\n      if (UNTRACKED.has(entry.name)) continue;\n      const path = dir ? `${dir}/${entry.name}` : entry.name;\n      if (entry.isDirectory()) walk(path);\n      else if (entry.isFile()) files.push(path);\n    }\n---SETUP\n#!/usr/bin/env bash\n# scripts/setup.sh: the development platform (PLAN.md §6.10, WP 0.1). Idempotent: run it as often as you like.\n#\n#   bash scripts/setup.sh\n#\n# 1. Node. When the active `node` is not the version in .nvmrc, it downloads the official Linux x64 build from\n#    nodejs.org, checks it against SHASUMS256.txt, unpacks it under ~/.cache/my3dge/ (once), puts it first on PATH\n#    for the rest of this script, and appends that PATH to $CLAUDE_ENV_FILE when the variable is set, so later\n#    Claude Code shells use it. Offline, it says so and keeps the active Node (everything also runs on Node 22;\n#    Node goldens are recorded on 24).\n# 2. The read-only source checkouts. $MY3D2DGE_SRC (my-3d2dge@e37e4ee) and $SHARDFALL_SRC (shardfall@fa2dab6) are\n#    resolved in this order: the environment variable; else an existing local clone, cloned with\n#    `git clone --shared` into .cache/src-3d2dge or .cache/src-shardfall; else a clone from GitHub. Either clone is\n#    then detached at the pinned commit. The resolved paths are printed, and appended to $CLAUDE_ENV_FILE when set.\n#    In a game made from the engine (engine-lock.json at its root, tools/game/new-game.mjs), nothing ports from the\n#    sources, so this step is skipped.\n# 3. Chromium. Outside the cloud container (no /opt/pw-browsers/chromium and no $CHROMIUM_PATH), it downloads Chrome for\n#    Testing at the platform's release (tools/deps.json) from Google's official bucket into ~/.cache/my3dge/ (once);\n#    tools/lib/browser.ts finds it there, so no shell state is needed. Offline, it warns and T2 cannot run.\n# 4. `npm ci`.\n#\n# Exit status: 0 when the dependencies are installed (an offline Node download or an unreachable source only warns);\n# 1 when `npm ci` fails.\n\nset -euo pipefail\n\nrepo_root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$repo_root\"\n\nsay() { printf 'setup: %s\\n' \"$*\"; }\n\n# Appends one line to $CLAUDE_ENV_FILE, unless the variable is unset or the line is already there.\nappend_env_line() {\n  local line=\"$1\"\n  [ -n \"${CLAUDE_ENV_FILE:-}\" ] || return 0\n  touch \"$CLAUDE_ENV_FILE\"\n  grep -qxF -- \"$line\" \"$CLAUDE_ENV_FILE\" || printf '%s\\n' \"$line\" >>\"$CLAUDE_ENV_FILE\"\n}\n\n# ---------------------------------------------------------------------------------------------------------------------\n# 1. Node\n# ---------------------------------------------------------------------------------------------------------------------\n\nwant_version=\"$(tr -d ' \\t\\r\\nv' <.nvmrc)\"\nactive_version=\"$(node --version 2>/dev/null | tr -d 'v' || true)\"\ncache_dir=\"$HOME/.cache/my3dge\"\nnode_name=\"node-v${want_version}-linux-x64\"\nnode_dir=\"$cache_dir/$node_name\"\n\n# Downloads the official build, checks it against SHASUMS256.txt and moves it into $node_dir. Runs in a subshell so\n# its temporary directory is always removed. Exits non-zero, having installed nothing, when offline or on a mismatch.\ninstall_node() (\n  base=\"https://nodejs.org/dist/v${want_version}\"\n  if command -v xz >/dev/null 2>&1; then tarball=\"${node_name}.tar.xz\"; else tarball=\"${node_name}.tar.gz\"; fi\n  mkdir -p \"$cache_dir\"\n  work=\"$(mktemp -d \"$cache_dir/.download.XXXXXX\")\"\n  trap 'rm -rf \"$work\"' EXIT\n  curl_opts=(--fail --silent --show-error --location --retry 2 --connect-timeout 15)\n  if ! curl \"${curl_opts[@]}\" -o \"$work/SHASUMS256.txt\" \"$base/SHASUMS256.txt\" ||\n    ! curl \"${curl_opts[@]}\" -o \"$work/$tarball\" \"$base/$tarball\"; then\n    say \"offline: could not download Node ${want_version} from nodejs.org\"\n    exit 1\n  fi\n  awk -v f=\"$tarball\" '$2 == f' \"$work/SHASUMS256.txt\" >\"$work/expected.txt\"\n  if [ ! -s \"$work/expected.txt\" ] || ! (cd \"$work\" && sha256sum --check --status expected.txt); then\n    say \"error: ${tarball} does not match nodejs.org's SHASUMS256.txt; nothing was installed\"\n    exit 1\n  fi\n  mkdir \"$work/unpacked\"\n  if ! tar -xf \"$work/$tarball\" -C \"$work/unpacked\" || [ ! -x \"$work/unpacked/$node_name/bin/node\" ]; then\n    say \"error: could not unpack ${tarball}; nothing was installed\"\n    exit 1\n  fi\n  rm -rf \"$node_dir\"\n  mv \"$work/unpacked/$node_name\" \"$node_dir\"\n  say \"installed Node ${want_version} (SHA-256 checked) in $node_dir\"\n)\n\nif [ \"$active_version\" = \"$want_version\" ]; then\n  say \"Node ${want_version} is active ($(command -v node)); nothing to install\"\nelif [ \"$(uname -s)\" != \"Linux\" ] || [ \"$(uname -m)\" != \"x86_64\" ]; then\n  say \"not the development platform (Linux x64); keeping the active Node ${active_version:-none}\"\nelse\n  if [ \"$(\"$node_dir/bin/node\" --version 2>/dev/null || true)\" = \"v${want_version}\" ]; then\n    say \"Node ${want_version} is already in $node_dir\"\n  else\n    install_node || true\n  fi\n  if [ -x \"$node_dir/bin/node\" ]; then\n    export PATH=\"$node_dir/bin:$PATH\"\n    path_line=\"export PATH=\\\"$node_dir/bin:\\$PATH\\\"\"\n    append_env_line \"$path_line\"\n    say \"Node ${want_version} is first on PATH for this script; for another shell: $path_line\"\n  else\n    say \"keeping the active Node ${active_version:-none}: everything runs on it, but Node goldens are recorded on ${want_version}\"\n  fi\nfi\n\n# ---------------------------------------------------------------------------------------------------------------------\n# 2. The read-only source checkouts\n# ---------------------------------------------------------------------------------------------------------------------\n\n# resolve_source VAR DEST COMMIT LOCAL_CLONE URL\n#   VAR          the environment variable that may already name a checkout (used as it is: it is read-only)\n#   DEST         the clone under the repository used otherwise\n#   COMMIT       the pinned commit (full SHA)\n#   LOCAL_CLONE  an existing clone to share objects with (the Claude Code cloud image's)\n#   URL          the GitHub repository, the last resort\n# Prints the resolved path and appends `export VAR=<path>` to $CLAUDE_ENV_FILE. Problems only warn.\nresolve_source() {\n  local var=\"$1\" dest=\"$2\" commit=\"$3\" local_clone=\"$4\" url=\"$5\" path head\n  [ -f \"$repo_root/engine-lock.json\" ] && return 0 # a game: nothing ports from the sources (see step 2 above)\n  if [ -n \"${!var:-}\" ]; then\n    path=\"${!var}\"\n  else\n    path=\"$repo_root/$dest\"\n    if [ ! -d \"$path/.git\" ]; then\n      rm -rf \"$path\"\n      mkdir -p \"$(dirname \"$path\")\"\n      if [ -d \"$local_clone/.git\" ]; then\n---\n{\n  \"name\": \"my-3dge\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"description\": \"A fully 3D web game engine written and maintained only by AI coding agents: three.js on WebGPU, Rapier physics, gameplay reproducible on the CPU.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=24.10 <25\"\n  },\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"typecheck\": \"tsc -b tsconfig.check.json\",\n    \"lint\": \"eslint --cache --cache-location node_modules/.cache/eslint/ .\",\n    \"format\": \"prettier --write --cache .\",\n    \"check\": \"node tools/checkAll.ts\",\n    \"test\": \"vitest run\",\n    \"e2e\": \"playwright test\"\n  },\n  \"dependencies\": {\n    \"@dimforge/rapier3d-simd-compat\": \"0.21.0\",\n    \"@stdlib/math-base-special-cos\": \"0.3.1\",\n    \"@stdlib/math-base-special-pow\": \"0.3.1\",\n    \"@stdlib/math-base-special-sin\": \"0.3.1\",\n    \"three\": \"0.182.0\"\n  },\n  \"devDependencies\": {\n    \"@modelcontextprotocol/sdk\": \"1.32.2\",\n    \"@playwright/test\": \"1.64.1\",\n    \"@stryker-mutator/core\": \"9.6.1\",\n    \"@stryker-mutator/vitest-runner\": \"9.6.1\",\n    \"@types/node\": \"24.19.2\",\n    \"@types/three\": \"0.182.0\",\n    \"eslint\": \"9.39.5\",\n    \"eslint-plugin-jsdoc\": \"61.7.1\",\n    \"globals\": \"16.5.0\",\n    \"prettier\": \"3.9.10\",\n    \"tsx\": \"4.23.15\",\n    \"typescript\": \"5.9.3\",\n    \"typescript-eslint\": \"8.72.1\",\n    \"vite\": \"7.3.7\",\n    \"vitest\": \"4.1.12\"\n  },\n  \"allowScripts\": {\n    \"esbuild\": false\n  }\n}\n24.22.2\ntools:\nanim\ncheckAll.test.ts\ncheckAll.ts\ncmd\ndeps.json\neslint\ngame\nlib\nmcp\nqa\nstryker\ntemplates\nx.test.ts\nx.ts\n\ntools/cmd:\nanim.test.ts\nanim.ts\naudio.test.ts\naudio.ts\ncheck.test.ts\ncheck.ts\nci-workflow.test.ts\nci.test.ts\nci.ts\ndeps.test.ts\ndeps.ts\ndescribe.test.ts\ndescribe.ts\ndocs.test.ts\ndocs.ts\ndump.ts\nengine.test.ts\nengine.ts\nesc.test.ts\nesc.ts\neval.ts\nevals.test.ts\nevals.ts\neye.test.ts\neye.ts\nfeel.test.ts\nfeel.ts\nfilm.test.ts\nfilm.ts\ngallery.test.ts\ngallery.ts\nhelp.ts\nhtml.test.ts\nhtml.ts\ninspect.test.ts\ninspect.ts\nlab.test.ts\nlab.ts\nmcp.test.ts\nmcp.ts\nnew.test.ts\nnew.ts\nperf.test.ts\nperf.ts\nport.test.ts\nport.ts\nqa.test.ts\nqa.ts\nreplay.test.ts\nreplay.ts\nset.test.ts\nset.ts\nsheet.test.ts\nsheet.ts\nshot.test.ts\nshot.ts\nsim.test.ts\nsim.ts\nsrc.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01XFqhgkm6hPHH3NpZCSMXqm","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
