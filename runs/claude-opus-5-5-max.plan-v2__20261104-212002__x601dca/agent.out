 labs/game/hubspike.ts <<'EOF'\n/**\n * @file Planner's throwaway spike: minimal shared-world wiring over createEngine (deleted with the research folder).\n */\nimport type { Engine, EngineFrame } from '../../engine';\ntype Hub = any;\nexport function hubSpike(engine: Engine, hub: Hub, info: any) {\n  const inspector: any = engine.inspector;\n  const seen: Record<string, number> = { sent: 0, recv: 0 };\n  (window as any).__spike = seen;\n  let finished = false;\n  hub.on('message', (data: any, from: number) => { seen.recv++; (window as any).__lastMsg = { data, from }; });\n  hub.on('time-up', () => { if (info.isHost && !finished) { finished = true; hub.finish({ standings: [info.players.map((p: any) => p.id)], won: true }); } });\n  hub.on('end', () => { engine.stop(); });\n  hub.on('leave', (l: any) => { (window as any).__left = l; });\n  let startAt = -1;\n  hub.on('start', (s: any) => { startAt = performance.now() + s.in; });\n  hub.ready();\n  let last = 0;\n  return (frame: EngineFrame) => {\n    const t = hub.time();\n    if (t < 0) return;\n    const now = performance.now();\n    if (now - last > 100) {\n      last = now;\n      const player = frame.world.query('actor')[0] as any;\n      const payload = info.isHost\n        ? { k: 's', t: frame.world.tick, p: player ? [player.actor.x, player.actor.z, player.actor.yaw] : [] }\n        : { k: 'i', m: [0, 1] };\n      if (hub.send(payload, { reliable: false })) seen.sent++;\n    }\n    if (info.isHost && !finished && t > 20000) {\n      finished = true;\n      hub.finish({ standings: [info.players.map((p: any) => p.id)], won: true, scores: Object.fromEntries(info.players.map((p: any) => [p.id, 100])) });\n    }\n  };\n}\nEOF\npython3 - <<'EOF'\nimport re\np='labs/game/main.ts'\ns=open(p).read()\n# keep the starter intact but add session wiring\ns=s.replace(\"engine = await createEngine({\",\"\"\"const hub = (window as any).AIHub;\nconst info = hub?.active ? await hub.connect({ mode: 'shared-world', seats: [1, 4] }) : null;\nlet spikeFrame: ((f: EngineFrame) => void) | null = null;\nengine = await createEngine({\"\"\")\ns=s.replace(\"\"\"    showRound(frame);\n  },\"\"\",\"\"\"    showRound(frame);\n    spikeFrame?.(frame);\n  },\"\"\")\ns=s.replace(\"addEventListener('keydown', (event) => {\",\"\"\"if (info) spikeFrame = (await import('./hubspike')).hubSpike(engine, hub, info);\naddEventListener('keydown', (event) => {\"\"\",1)\nopen(p,'w').write(s)\nEOF\ngrep -n \"spikeFrame\\|hub\" labs/game/main.ts | head; cat > _b.mjs <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nimport { build } from 'vite';\nconst root = resolve('.');\nconst out = process.argv[2];\nconst session = readFileSync(process.argv[3], 'utf8');\nconst result = await build({\n  root, configFile: false, logLevel: 'warn', base: './',\n  resolve: { alias: [{ find: /^three$/, replacement: 'three/webgpu' }] },\n  build: { write: false, modulePreload: false, cssCodeSplit: false, assetsInlineLimit: () => true, chunkSizeWarningLimit: Infinity,\n    rollupOptions: { input: { game: join(root, 'labs/game/index.html') }, output: { inlineDynamicImports: true } } },\n});\nconst outputs = Array.isArray(result) ? result : [result];\nconst files = {}; let html;\nfor (const item of outputs.flatMap((o) => o.output)) {\n  const text = item.type === 'chunk' ? item.code : typeof item.source === 'string' ? item.source : new TextDecoder().decode(item.source);\n  if (item.fileName.endsWith('.html')) html = text; else files[item.fileName] = text;\n}\nconst LOADED = /<script type=\"module\" crossorigin src=\"([^\"]+)\"><\\/script>|<link rel=\"stylesheet\" crossorigin href=\"([^\"]+)\">/g;\nconst find = (ref) => { const n = Object.keys(files).find((f) => ref.endsWith('/' + f) || ref === f || ref === './' + f); if (!n) throw new Error('no ' + ref); return files[n]; };\nhtml = html.replace(LOADED, (_t, s, c) => c ? `<style>${find(c)}</style>` : `<script type=\"module\">${find(s).replaceAll('</script', '<\\\\/script')}</script>`);\nconst metas = [\n '<meta name=\"hub:session\" content=\"1\">',\n '<meta name=\"hub:session-players\" content=\"1-4\">',\n '<meta name=\"hub:session-mode\" content=\"shared-world\">',\n '<meta name=\"hub:session-minutes\" content=\"2\">',\n '<meta name=\"hub:session-goal\" content=\"Spike: survive together\">',\n '<meta name=\"hub:session-howto\" content=\"Spike: WASD or a stick\">',\n '<meta name=\"hub:webgpu\" content=\"required\">',\n].join('\\n');\nconst clientTag = () => `<meta charset=\"utf-8\" />\\n<script>${session}</script>\\n${metas}`;\nif (!html.includes('<meta charset=\"utf-8\" />')) throw new Error('no charset');\nhtml = html.replace('<meta charset=\"utf-8\" />', clientTag);\nwriteFileSync(out, html);\nconsole.log('bytes', Buffer.byteLength(html));\nEOF\nnode _b.mjs ../spike/spike.html ../ai-hub/lib/hub/session.js; rm -f _b.mjs; cp ../ai-hub/lib/hub/harness.html ../ai-hub/lib/hub/bridge.js ../ai-hub/lib/hub/round.js ../spike/; ls -la ../spike; head -c 600 ../spike/spike.html","timeout":120000,"description":"Wire a minimal shared-world spike and bundle it with session client"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":112,"subtype":"success","api_error_status":null,"result":"`PLAN.md` and `planner-exit-interview.json` are both written and sit in this folder. `PLAN.md` ends with a table mapping every line of `TASK.md` to its plan section and how it gets proved. Nothing is committed, and I deleted my 5+ GB of temporary clones and test projects.\n\n**The game:** it's an original over-the-shoulder action-horror game. Desmond Quill, a 51-year-old insurance adjuster, goes to a foggy North Atlantic island where all 412 residents drowned on paper and keep trying to gut him.\n- **Carried over from the source, as mechanics only:** planted-feet aiming, body-part hits that open a crowd-scattering kick, a briefcase grid inventory and merchant economy, an escort partner, and hammy villains.\n- **Original:** the cast, story, levels and music. The signature set piece is a siege on a beached trawler that ends when a foghorn sends the crowd walking into the sea.\n- **Multiplayer:** a 1–4 player co-op round for AI Hub.\n- **Title:** left to each builder, as you asked; the plan names no title and none of `TASK.md`'s file or folder names.\n\n**Traps found by testing on this machine (engine commit `e7a1243`); the plan gives builders the workaround for each:**\n- The hub's `?aihub=1` URL stops the engine from starting unless that parameter is removed first.\n- `await import()` runs too early in the one-file build, so code that works in dev breaks in the bundle.\n- The hub's test harness allows only 20 s for every copy to report ready; my test scene took 12.5–17 s at 4 players, and only with reduced graphics.\n- `x shot` crashes with the full Chromium under the run's long temp path, but works with the headless shell.\n- A running page can't switch scenes, so the campaign is one connected island; a 320 m test site with 41 buildings loaded fine.\n- Some engine behaviour needs working around: the last-used-device reading goes wrong when the game feeds in its own input, and changing a character's body mid-game doesn't show.\n\n**Not run, so builders are testing these for the first time:**\n- **Game content:** no game exists yet, so nothing in the plan has been played, and all balance numbers are starting guesses.\n- **Co-op:** only the plumbing passed all four harness scenarios, using simple test messages, not real shared gameplay or the game's own pre-round card screen.\n- **Other parts:** the gibberish voices, the laser drawing and aim assist are designs only. The Esc and pointer-lock trap comes from reading engine comments, and the plan marks it that way.\n\n**Decisions you may want to check:**\n- **\"The game on its own\":** I read this as solo play, because the hub protocol has no network outside a session. The plan adds optional AI teammates. If you meant a second network path, the plan needs changing.\n- **Who decides:** the plan settles genre, perspective and stack for every builder, even though `TASK.md` says \"pick\". The title is the only exception.\n- **Scope:** I don't know which models or budgets the builders will have, so the plan uses a build order that's shippable at each milestone plus a fixed order for cutting content. It's also long, at about 81 KB.","ttft_ms":1377,"type":"result","duration_ms":3758102,"uuid":"34ba7a89-8e7e-400a-a1cc-777ed8a1aadd","ttft_stream_ms":1048,"time_to_request_ms":217,"first_content_frame_ms":1048,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":142,"outputTokens":222677,"cacheReadInputTokens":26583959,"cacheCreationInputTokens":651398,"webSearchRequests":0,"costUSD":14.982083800000002,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":128635,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":651398,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"},"claude-haiku-5-5":{"inputTokens":4,"outputTokens":1433,"cacheReadInputTokens":872,"cacheCreationInputTokens":527900,"webSearchRequests":0,"costUSD":0.3335656,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1226,"cacheCreationEphemeral5mInputTokens":527900,"cacheCreationEphemeral1hInputTokens":0,"canonicalModel":"claude-haiku-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T10:53:37.765Z"}
