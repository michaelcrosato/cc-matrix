{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Zrt6W1j4VP5V96tKXZkYr","type":"tool_result","content":"  weapon1: 'Draw the pistol',\n  weapon2: 'Draw the rifle',\n  swap: 'Swap weapons',\n  holster: 'Holster, or draw again',\n};\n\n/** The keys the page keeps for itself: the look (P), the feel panel (F), Go to (M), the controls sheet (H) and the area's card (I). */ // prettier-ignore\nconst PAGE_KEYS = [LOOK_KEY, FEEL_KEY, GOTO_KEY, HELP_KEY, CARD_KEY];\n\n/** Every mode's bindings (see the file comment). */\nconst ACTIONS: Readonly<Record<string, readonly string[]>> = {\n  forward: ['KeyW', 'ArrowUp', 'PadLeftStickUp'],\n  back: ['KeyS', 'ArrowDown', 'PadLeftStickDown'],\n  left: ['KeyA', 'ArrowLeft', 'PadLeftStickLeft'],\n  right: ['KeyD', 'ArrowRight', 'PadLeftStickRight'],\n  jump: ['Space', 'PadSouth'],\n  sprint: ['ShiftLeft', 'PadLeftStick'],\n  walk: ['AltLeft'],\n  crouch: ['KeyC', 'PadEast'],\n  interact: ['KeyE', 'PadWest'],\n  melee: ['KeyV', 'PadRightStick'],\n  fire: ['MouseLeft', 'PadRightTrigger'],\n  aim: ['MouseRight', 'PadLeftTrigger'],\n  reload: ['KeyR', 'Hold:PadWest'],\n  weapon1: ['Digit1'],\n  weapon2: ['Digit2'],\n  swap: ['PadNorth'],\n  holster: ['Digit3', 'Hold:PadNorth'],\n  camera: ['KeyT', 'PadSelect'],\n};\n\n/** Each mode's map, written once here and registered below. */\nconst SPECS: Readonly<Record<keyof typeof PLAYGROUND_MAPS, ActionMapSpec>> = {\n  shooter: {\n    description: 'The playground’s shooter camera: the view sent, aimed at the screen’s centre, X swaps the shoulder.',\n    actions: { ...ACTIONS, shoulder: ['KeyX', 'PadLeft'] },\n    view: ['camera', 'shoulder'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  first: {\n    description: 'The playground’s first person: the view sent, aimed at the screen’s centre.',\n    actions: ACTIONS,\n    view: ['camera'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  platformer: {\n    description: 'The playground’s platformer camera: moving relative to it, the mouse turning it, facing the move.',\n    actions: ACTIONS,\n    view: ['camera'],\n    lock: true,\n  },\n  isometric: {\n    description: 'The playground’s isometric view: aimed with the pointer, Q and E turning the view, so G uses.',\n    actions: { ...ACTIONS, interact: ['KeyG', 'PadWest'], turnLeft: ['KeyQ'], turnRight: ['KeyE', 'PadRight'] },\n    view: ['camera', 'turnLeft', 'turnRight'],\n    aimWith: 'pointer',\n  },\n  'top-down': {\n    description: 'The playground’s top-down view: aimed with the pointer.',\n    actions: ACTIONS,\n    view: ['camera'],\n    aimWith: 'pointer',\n  },\n};\n\nfor (const [mode, spec] of Object.entries(SPECS)) {\n  defineActionMap(PLAYGROUND_MAPS[mode as keyof typeof PLAYGROUND_MAPS], { ...spec, reserved: PAGE_KEYS });\n33:import { addDoor, addInteraction, addLauncher, addLevelDoors, addLevelWindows, addMelee, addSiteBodies, addSiteLadders, addSwitch, addWeapons, addZipline, DAWN, defineScene, defineSetting\n34-import { standDog } from '../cast/dog';\n35-import { standDummies } from '../cast/dummies';\n36-import { standNeighbours } from '../cast/neighbours';\n37-import { standPartners } from '../cast/partners';\n38-import { spawnPlayer } from '../cast/player';\n39-import { GARAGE_SWITCHES, HOUSE_FURNITURE, HOUSE_LIGHTS, OUTDOORS, SITE_RIDES } from '../furnish';\n40-import { GYM_BALLOON, GYM_LAUNCHERS, GYM_PROPS, GYM_ZIPLINE } from '../levels/gym';\n41-import { SITE, SITE_AREAS, SITE_STRUCTURES, type SiteArea } from '../levels/site';\n42-import { DECK_HEIGHT } from '../levels/yard';\n43-import '../props/house';\n44-import '../props/outdoors';\n45-import { playgroundSounds } from '../sounds/events';\n46-import { SITE_GROUND } from '../sounds/ground';\n47-import { PLAYGROUND_WEAPONS } from '../weapons/guns';\n48-import { standRange } from '../weapons/range';\n49-import { gym } from './gym';\n50-\n51-/** A structure of the block by its name in `SITE_STRUCTURES`. */\n52-const structure = (name: keyof typeof SITE_STRUCTURES) => SITE.structures[Object.keys(SITE_STRUCTURES).indexOf(name)];\n53-const [HOUSE, SHED, GYM, LOOKOUT] = [structure('house'), structure('shed'), structure('gym'), structure('lookout')];\n54-\n55-/** A point of the house's (its own metres, a height over its ground floor) in the world. */\n56-function inHouse(x: number, y: number, z: number): [number, number, number] {\n57-  const [wx, wz] = toWorld(HOUSE, x, z);\n58-  return [wx, HOUSE.at[1] + y, wz];\n59-}\n60-\n61-/** The house's storey `k`'s floor (m over its ground floor). */\n62-const floorOf = (k: number) => HOUSE.level.storeys![k].base;\n63-\n64-/** Where the attic's lamp hangs from: its gable's underside over row `z` (its ridge along x, over the house's middle). */\n65-function atticCeiling(z: number): number {\n66-  const roof = HOUSE.level.roofs![0];\n67-  const [, z0, , z1] = roof.footprint;\n68-  return roof.eave + ((z1 - z0) / 2 - Math.abs(z - (z0 + z1) / 2)) * roof.slope - roof.thickness;\n69-}\n70-\n71-/** The ground's height on the block at (x, z), for what stands on the terrain. */\n72-const ground = (x: number, z: number) => terrainHeight(SITE.terrain!, x, z)!;\n73-\n--\n240:export const site = defineScene('playground:site', siteSpec('frontyard'));\n241-/** The block, the player in the hall. */\n242:export const house = defineScene('playground:site-house', siteSpec('house'));\n243-/** The block, the player in the backyard. */\n244:export const backyard = defineScene('playground:site-backyard', siteSpec('backyard'));\n245-/** The block, the player on the street's sidewalk. */\n246:export const street = defineScene('playground:site-street', siteSpec('street'));\n247-/** The block, the player at the gym's spawn. */\n248:export const siteGym = defineScene('playground:site-gym', siteSpec('gym'));\n249-/** The block, the player at the hill's foot. */\n250:export const siteHill = defineScene('playground:site-hill', siteSpec('hill'));\n251-/** The block, the player behind the range's counter. */\n252:export const range = defineScene('playground:site-range', siteSpec('range'));\n253-/** The block, the player at the ring's steps. */\n254:export const ring = defineScene('playground:site-ring', siteSpec('ring'));\n255-export default site;\n256-\n257-/** The block's scenes by area: the front yard's is `playground:site`, every other `playground:site-<area>`. */\n258-export const SITE_SCENES: Readonly<Record<SiteArea, typeof site>> = { frontyard: site, house, backyard, street, gym: siteGym, hill: siteHill, range, ring }; // prettier-ignore\n/**\n * @file The body grammar, v2 (PLAN.md WP 3.8, §5.1; I-21): a puppet's body as data, the registry kind `body`. A body\n * lists its parts, one line each, hung on the humanoid skeleton's bones (engine/anim/skeleton.ts), its material slots\n * (the default palette) and the drawing sizes its lengths may name. `compileBody` (compile.ts) turns it into pieces\n * for one build; `createPuppet` and `createPuppetBatches` (draw.ts) draw them.\n *\n * Parts (sizes in metres, scaled with the build's `size`; a size may also be `[k, 'head' | 'limb' | 'torso']`, k\n * times the skeleton's head radius or the body's `limbRadius` or `torsoRadius`):\n * - `['limb', a, b, radiusA, radiusB, slot]`: a tapered limb from a to b, round at both ends;\n * - `['curve', a, b, bow, radiusA, radiusB, slot]`: a limb bowed away from the body by `bow` × its length;\n * - `['ball', at, radius | [rx, ry, rz], slot]`: a sphere, or an ellipsoid along its bone's axes;\n * - `['eye', at, radius, slot]`: a small unlit sphere;\n * - `['box', a, b, width, depth, slot]`: a box from a to b, `width` across the body and `depth` along its facing;\n * - `['cone', base, tip, radius, slot]`: horns, spikes, hats;\n * - `['blade', grip, tip, width, thickness, slot]`: a flat blade pointed at its tip;\n * - `['cape', top, bottom, width, slot]`: a cape strip hanging from top to bottom, flaring by a quarter;\n * - `['hair', centre, radius, count, length, width, slot]`: `count` strands rooted over the back and top of a sphere.\n * Each may end with options, `{ on: bone }`: the bone it rides.\n *\n * Points: a joint (`'shinL'`), a socket (`'eyeL'`, `'weaponR'`, `'back'`), `[f, r, u]` (forward, right and up from\n * the root), `['lerp', a, b, t]` or `['off', p, f, r, u]` (p moved forward, right and up). Every point is a rest\n * position: at rest every bone's frame is the character's (+Z forward, +Y up, right is −X). A part rides one bone,\n * rigidly: its `on`, else the bone of its first point that names a joint or socket, else the root.\n *\n * `mirror` lists parts written for the left side; each is drawn on the right too, its L and R names swapped and its\n * right offsets negated. `slots` maps slot names to hex colours; a palette overrides them per character. Eyes draw\n * with `glowMaterial` (unlit), the rest with `material`. `builds` gives a build's own `limbRadius` and `torsoRadius`\n * by its id: the builds' drawing fields (my-3d2dge's `limbW` / 2 and `torsoW`, in metres).\n *\n * Invariants: a body is checked when defined (`CORE_BAD_SPEC` names each problem, `bodyProblems`); a missing id\n * stands in as `body:humanoid`. Nothing here draws or reaches the sim.\n *\n * Carried from the lab3d grammar, `my-3d2dge:src/lab3d/40-characters.js:8-48`, in metres on bones.\n *\n * @example\n * mirrorPart(['limb', 'thighL', ['off', 'shinL', 0, 0.02, 0], 0.07, 0.06, 'pants']);\n * // ['limb', 'thighR', ['off', 'shinR', 0, -0.02, 0], 0.07, 0.06, 'pants']\n * getBody('body:humanoid').slots.skin; // '#f1c7a0'\n * @see engine/gfx/puppets/grammar.test.ts\n */\nimport { JOINTS, SOCKETS } from '../../anim/skeleton';\nimport { hex } from '../../core/color';\nimport { didYouMean } from '../../core/log';\nimport { galleryField, type Gallery } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport type { Schema } from '../../core/schema';\nimport { HUMANOID_BODY } from './bodies/humanoid';\n\n/** A size or an offset: metres, or `[k, ref]`, k times the head radius, the limb radius or the torso radius. */\nexport type BodyLength = number | readonly [number, 'head' | 'limb' | 'torso'];\n\n/** Where a part's end lies (see the file comment). */\nexport type BodyPoint =\n  | string\n  | readonly [BodyLength, BodyLength, BodyLength]\n  | readonly ['lerp', BodyPoint, BodyPoint, number]\n  | readonly ['off', BodyPoint, BodyLength, BodyLength, BodyLength];\n\n/** A part's options: the bone it rides (a joint, or `'root'`). */\nexport interface PartOptions {\n/**\n * @file The look `look:playground-clean`, the playground's default (docs/PLAYGROUND.md §5.2; the owner's direction of\n * 2026-11-03, ADR-0025 amendment 46): the picture as the scene draws it, unstyled: every material in the set's own\n * lit style (`style` left `''`), lit by the hour's sky (`sky:daylight`, engine/gfx/daylight.ts: the sun, the moon,\n * the ambient and the streetlights at dusk, as the other two looks have them), its dome as the day draws it (no\n * gradient), and edges smoothed (the `aa` filter: the engine's edge smoothing, FXAA unless the view setting `post.aa`\n * names another, engine/gfx/post/aa.ts), with no bands, ink, outline shells, pixels or grade. The engine's own\n * `look:clean` would keep the stage's own lights (a hemisphere and one sun under a plain background,\n * engine/gfx/stageSky.ts), which the hour and the lamps never reach, and smooth nothing.\n *\n * Drawn at the screen's full resolution (`resolution: 'full'`, while `gfx.resolution` is `auto`) with every texture\n * blended (`textures: 'smooth'`: linear filtering, so a floor up close is not a grid of 6 cm squares), the owner's\n * direction of 2026-11-03 (WP 13.30, ADR-0025 amendment 47): the engine's own `pixels` resolution and crisp texels\n * are the pixel look's.\n *\n * Invariants: data only, the kind's fields (`node x describe look`); the sky `sky:daylight`; the scene's own style;\n * every filter it leaves out off. The page draws it by default (labs/playground/main.ts); P steps on to the cel look,\n * then the pixel look.\n *\n * @example\n * look.id; // 'look:playground-clean'\n * look.filters.aa.scope; // 'all': its edges smoothed\n * [look.resolution, look.textures]; // ['full', 'smooth']\n * @see labs/playground/looks/looks.test.ts\n * @see tests/e2e/playground-looks.spec.ts\n */\nimport { defineLook } from '../../../engine';\n\n/** The look `look:playground-clean`: the scene's own lit materials under the hour's sky at full resolution, smoothed. */\nexport const look = defineLook('look:playground-clean', {\n  description:\n    \"The playground clean, its default: the scene's own lit materials under the hour's sky at full resolution, textures and edges smoothed; no bands, ink, outlines or pixels.\",\n  sky: 'sky:daylight',\n  resolution: 'full',\n  textures: 'smooth',\n  filters: { aa: { scope: 'all' } },\n});\nx describe: ok: sky: 8 fields, 6 entries\nSky presets: what surrounds and lights a level (background, dome, backdrop, sun, ambient light, fog, how bright the point lights shine).\nfallback: sky:daylight\nids: sky:dawn, sky:daylight, sky:dusk, sky:hall, sky:night, sky:noon\n  description: string, = \"\": What it looks like, in plain sentences.\n  background: string, = \"#06050b\": The colour behind everything, hex, where neither dome nor backdrop is drawn.\n  pointLights: number, = 1, 0..inf: A multiplier on the light pool's intensities: 1 as the light kinds say, 0 puts them out.\n  dome: object, = {\"show\":false,\"turbidity\":2,\"rayleigh...: The sky dome: three.js's SkyMesh (the Preetham daylight model), lit by the su...\n  sun: object, = {\"color\":\"#fff0d8\",\"intensity\":0,\"azi...: The sun: three.js's DirectionalLight, shining from its azimuth and elevation; ...\n  ambient: object, = {\"sky\":\"#c8d4ff\",\"ground\":\"#4a3f30\",\"...: The ambient light: three.js's HemisphereLight, one colour from above and o...\n  fog: object, = {\"color\":\"#06050b\",\"start\":12,\"end\":7...: Range fog past the focus plus height fog on the floor (engine/gfx/atmosphere.t...\n  backdrop: object, = {\"haze\":\"#c8e4f8\",\"tint\":\"#ffffff\",\"l...: Silhouettes round the horizon, far layers first; no layers draws no backd...\n(a line above is cut short: the whole text is in out/describe/sky/describe.json)\nreport: out/describe/sky/report.json\nx describe: ok: sky \"sky:dusk\": 7 of 8 fields differ from the default\n* description = \"Dusk by the clock: an orange sky, the sun setting in the west.\"\n* background = \"#e09060\"\n  pointLights = 1\n* dome = {\"show\":true,\"turbidity\":6,\"rayleigh\":3,\"mieCoefficient\":0.012,\"mieDirectionalG\":0.85,\"exposure\":...\n* sun = {\"color\":\"#ff9a60\",\"intensity\":1.6,\"azimuth\":0,\"elevation\":0.9}\n* ambient = {\"sky\":\"#e0b0a0\",\"ground\":\"#2e2620\",\"intensity\":1.1}\n* fog = {\"color\":\"#d8a890\",\"start\":30,\"end\":200,\"amount\":0.55,\"floor\":0,\"ceiling\":1.5,\"height\":0}\n* backdrop = {\"haze\":\"#c8e4f8\",\"tint\":\"#d0a088\",\"layers\":[{\"kind\":\"mountains\",\"color\":\"#7a98c8\",\"height\":0.95,...\n(a line above is cut short: the whole text is in out/describe/sky-sky-dusk/describe.json)\nreport: out/describe/sky-sky-dusk/report.json","is_error":false}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"a73c2120-dad6-4c95-9a44-8c37f158f259","timestamp":"2026-11-05T04:43:11.505Z","tool_use_result":{"stdout":"  weapon1: 'Draw the pistol',\n  weapon2: 'Draw the rifle',\n  swap: 'Swap weapons',\n  holster: 'Holster, or draw again',\n};\n\n/** The keys the page keeps for itself: the look (P), the feel panel (F), Go to (M), the controls sheet (H) and the area's card (I). */ // prettier-ignore\nconst PAGE_KEYS = [LOOK_KEY, FEEL_KEY, GOTO_KEY, HELP_KEY, CARD_KEY];\n\n/** Every mode's bindings (see the file comment). */\nconst ACTIONS: Readonly<Record<string, readonly string[]>> = {\n  forward: ['KeyW', 'ArrowUp', 'PadLeftStickUp'],\n  back: ['KeyS', 'ArrowDown', 'PadLeftStickDown'],\n  left: ['KeyA', 'ArrowLeft', 'PadLeftStickLeft'],\n  right: ['KeyD', 'ArrowRight', 'PadLeftStickRight'],\n  jump: ['Space', 'PadSouth'],\n  sprint: ['ShiftLeft', 'PadLeftStick'],\n  walk: ['AltLeft'],\n  crouch: ['KeyC', 'PadEast'],\n  interact: ['KeyE', 'PadWest'],\n  melee: ['KeyV', 'PadRightStick'],\n  fire: ['MouseLeft', 'PadRightTrigger'],\n  aim: ['MouseRight', 'PadLeftTrigger'],\n  reload: ['KeyR', 'Hold:PadWest'],\n  weapon1: ['Digit1'],\n  weapon2: ['Digit2'],\n  swap: ['PadNorth'],\n  holster: ['Digit3', 'Hold:PadNorth'],\n  camera: ['KeyT', 'PadSelect'],\n};\n\n/** Each mode's map, written once here and registered below. */\nconst SPECS: Readonly<Record<keyof typeof PLAYGROUND_MAPS, ActionMapSpec>> = {\n  shooter: {\n    description: 'The playground’s shooter camera: the view sent, aimed at the screen’s centre, X swaps the shoulder.',\n    actions: { ...ACTIONS, shoulder: ['KeyX', 'PadLeft'] },\n    view: ['camera', 'shoulder'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  first: {\n    description: 'The playground’s first person: the view sent, aimed at the screen’s centre.',\n    actions: ACTIONS,\n    view: ['camera'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  platformer: {\n    description: 'The playground’s platformer camera: moving relative to it, the mouse turning it, facing the move.',\n    actions: ACTIONS,\n    view: ['camera'],\n    lock: true,\n  },\n  isometric: {\n    description: 'The playground’s isometric view: aimed with the pointer, Q and E turning the view, so G uses.',\n    actions: { ...ACTIONS, interact: ['KeyG', 'PadWest'], turnLeft: ['KeyQ'], turnRight: ['KeyE', 'PadRight'] },\n    view: ['camera', 'turnLeft', 'turnRight'],\n    aimWith: 'pointer',\n  },\n  'top-down': {\n    description: 'The playground’s top-down view: aimed with the pointer.',\n    actions: ACTIONS,\n    view: ['camera'],\n    aimWith: 'pointer',\n  },\n};\n\nfor (const [mode, spec] of Object.entries(SPECS)) {\n  defineActionMap(PLAYGROUND_MAPS[mode as keyof typeof PLAYGROUND_MAPS], { ...spec, reserved: PAGE_KEYS });\n33:import { addDoor, addInteraction, addLauncher, addLevelDoors, addLevelWindows, addMelee, addSiteBodies, addSiteLadders, addSwitch, addWeapons, addZipline, DAWN, defineScene, defineSetting\n34-import { standDog } from '../cast/dog';\n35-import { standDummies } from '../cast/dummies';\n36-import { standNeighbours } from '../cast/neighbours';\n37-import { standPartners } from '../cast/partners';\n38-import { spawnPlayer } from '../cast/player';\n39-import { GARAGE_SWITCHES, HOUSE_FURNITURE, HOUSE_LIGHTS, OUTDOORS, SITE_RIDES } from '../furnish';\n40-import { GYM_BALLOON, GYM_LAUNCHERS, GYM_PROPS, GYM_ZIPLINE } from '../levels/gym';\n41-import { SITE, SITE_AREAS, SITE_STRUCTURES, type SiteArea } from '../levels/site';\n42-import { DECK_HEIGHT } from '../levels/yard';\n43-import '../props/house';\n44-import '../props/outdoors';\n45-import { playgroundSounds } from '../sounds/events';\n46-import { SITE_GROUND } from '../sounds/ground';\n47-import { PLAYGROUND_WEAPONS } from '../weapons/guns';\n48-import { standRange } from '../weapons/range';\n49-import { gym } from './gym';\n50-\n51-/** A structure of the block by its name in `SITE_STRUCTURES`. */\n52-const structure = (name: keyof typeof SITE_STRUCTURES) => SITE.structures[Object.keys(SITE_STRUCTURES).indexOf(name)];\n53-const [HOUSE, SHED, GYM, LOOKOUT] = [structure('house'), structure('shed'), structure('gym'), structure('lookout')];\n54-\n55-/** A point of the house's (its own metres, a height over its ground floor) in the world. */\n56-function inHouse(x: number, y: number, z: number): [number, number, number] {\n57-  const [wx, wz] = toWorld(HOUSE, x, z);\n58-  return [wx, HOUSE.at[1] + y, wz];\n59-}\n60-\n61-/** The house's storey `k`'s floor (m over its ground floor). */\n62-const floorOf = (k: number) => HOUSE.level.storeys![k].base;\n63-\n64-/** Where the attic's lamp hangs from: its gable's underside over row `z` (its ridge along x, over the house's middle). */\n65-function atticCeiling(z: number): number {\n66-  const roof = HOUSE.level.roofs![0];\n67-  const [, z0, , z1] = roof.footprint;\n68-  return roof.eave + ((z1 - z0) / 2 - Math.abs(z - (z0 + z1) / 2)) * roof.slope - roof.thickness;\n69-}\n70-\n71-/** The ground's height on the block at (x, z), for what stands on the terrain. */\n72-const ground = (x: number, z: number) => terrainHeight(SITE.terrain!, x, z)!;\n73-\n--\n240:export const site = defineScene('playground:site', siteSpec('frontyard'));\n241-/** The block, the player in the hall. */\n242:export const house = defineScene('playground:site-house', siteSpec('house'));\n243-/** The block, the player in the backyard. */\n244:export const backyard = defineScene('playground:site-backyard', siteSpec('backyard'));\n245-/** The block, the player on the street's sidewalk. */\n246:export const street = defineScene('playground:site-street', siteSpec('street'));\n247-/** The block, the player at the gym's spawn. */\n248:export const siteGym = defineScene('playground:site-gym', siteSpec('gym'));\n249-/** The block, the player at the hill's foot. */\n250:export const siteHill = defineScene('playground:site-hill', siteSpec('hill'));\n251-/** The block, the player behind the range's counter. */\n252:export const range = defineScene('playground:site-range', siteSpec('range'));\n253-/** The block, the player at the ring's steps. */\n254:export const ring = defineScene('playground:site-ring', siteSpec('ring'));\n255-export default site;\n256-\n257-/** The block's scenes by area: the front yard's is `playground:site`, every other `playground:site-<area>`. */\n258-export const SITE_SCENES: Readonly<Record<SiteArea, typeof site>> = { frontyard: site, house, backyard, street, gym: siteGym, hill: siteHill, range, ring }; // prettier-ignore\n/**\n * @file The body grammar, v2 (PLAN.md WP 3.8, §5.1; I-21): a puppet's body as data, the registry kind `body`. A body\n * lists its parts, one line each, hung on the humanoid skeleton's bones (engine/anim/skeleton.ts), its material slots\n * (the default palette) and the drawing sizes its lengths may name. `compileBody` (compile.ts) turns it into pieces\n * for one build; `createPuppet` and `createPuppetBatches` (draw.ts) draw them.\n *\n * Parts (sizes in metres, scaled with the build's `size`; a size may also be `[k, 'head' | 'limb' | 'torso']`, k\n * times the skeleton's head radius or the body's `limbRadius` or `torsoRadius`):\n * - `['limb', a, b, radiusA, radiusB, slot]`: a tapered limb from a to b, round at both ends;\n * - `['curve', a, b, bow, radiusA, radiusB, slot]`: a limb bowed away from the body by `bow` × its length;\n * - `['ball', at, radius | [rx, ry, rz], slot]`: a sphere, or an ellipsoid along its bone's axes;\n * - `['eye', at, radius, slot]`: a small unlit sphere;\n * - `['box', a, b, width, depth, slot]`: a box from a to b, `width` across the body and `depth` along its facing;\n * - `['cone', base, tip, radius, slot]`: horns, spikes, hats;\n * - `['blade', grip, tip, width, thickness, slot]`: a flat blade pointed at its tip;\n * - `['cape', top, bottom, width, slot]`: a cape strip hanging from top to bottom, flaring by a quarter;\n * - `['hair', centre, radius, count, length, width, slot]`: `count` strands rooted over the back and top of a sphere.\n * Each may end with options, `{ on: bone }`: the bone it rides.\n *\n * Points: a joint (`'shinL'`), a socket (`'eyeL'`, `'weaponR'`, `'back'`), `[f, r, u]` (forward, right and up from\n * the root), `['lerp', a, b, t]` or `['off', p, f, r, u]` (p moved forward, right and up). Every point is a rest\n * position: at rest every bone's frame is the character's (+Z forward, +Y up, right is −X). A part rides one bone,\n * rigidly: its `on`, else the bone of its first point that names a joint or socket, else the root.\n *\n * `mirror` lists parts written for the left side; each is drawn on the right too, its L and R names swapped and its\n * right offsets negated. `slots` maps slot names to hex colours; a palette overrides them per character. Eyes draw\n * with `glowMaterial` (unlit), the rest with `material`. `builds` gives a build's own `limbRadius` and `torsoRadius`\n * by its id: the builds' drawing fields (my-3d2dge's `limbW` / 2 and `torsoW`, in metres).\n *\n * Invariants: a body is checked when defined (`CORE_BAD_SPEC` names each problem, `bodyProblems`); a missing id\n * stands in as `body:humanoid`. Nothing here draws or reaches the sim.\n *\n * Carried from the lab3d grammar, `my-3d2dge:src/lab3d/40-characters.js:8-48`, in metres on bones.\n *\n * @example\n * mirrorPart(['limb', 'thighL', ['off', 'shinL', 0, 0.02, 0], 0.07, 0.06, 'pants']);\n * // ['limb', 'thighR', ['off', 'shinR', 0, -0.02, 0], 0.07, 0.06, 'pants']\n * getBody('body:humanoid').slots.skin; // '#f1c7a0'\n * @see engine/gfx/puppets/grammar.test.ts\n */\nimport { JOINTS, SOCKETS } from '../../anim/skeleton';\nimport { hex } from '../../core/color';\nimport { didYouMean } from '../../core/log';\nimport { galleryField, type Gallery } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport type { Schema } from '../../core/schema';\nimport { HUMANOID_BODY } from './bodies/humanoid';\n\n/** A size or an offset: metres, or `[k, ref]`, k times the head radius, the limb radius or the torso radius. */\nexport type BodyLength = number | readonly [number, 'head' | 'limb' | 'torso'];\n\n/** Where a part's end lies (see the file comment). */\nexport type BodyPoint =\n  | string\n  | readonly [BodyLength, BodyLength, BodyLength]\n  | readonly ['lerp', BodyPoint, BodyPoint, number]\n  | readonly ['off', BodyPoint, BodyLength, BodyLength, BodyLength];\n\n/** A part's options: the bone it rides (a joint, or `'root'`). */\nexport interface PartOptions {\n/**\n * @file The look `look:playground-clean`, the playground's default (docs/PLAYGROUND.md §5.2; the owner's direction of\n * 2026-11-03, ADR-0025 amendment 46): the picture as the scene draws it, unstyled: every material in the set's own\n * lit style (`style` left `''`), lit by the hour's sky (`sky:daylight`, engine/gfx/daylight.ts: the sun, the moon,\n * the ambient and the streetlights at dusk, as the other two looks have them), its dome as the day draws it (no\n * gradient), and edges smoothed (the `aa` filter: the engine's edge smoothing, FXAA unless the view setting `post.aa`\n * names another, engine/gfx/post/aa.ts), with no bands, ink, outline shells, pixels or grade. The engine's own\n * `look:clean` would keep the stage's own lights (a hemisphere and one sun under a plain background,\n * engine/gfx/stageSky.ts), which the hour and the lamps never reach, and smooth nothing.\n *\n * Drawn at the screen's full resolution (`resolution: 'full'`, while `gfx.resolution` is `auto`) with every texture\n * blended (`textures: 'smooth'`: linear filtering, so a floor up close is not a grid of 6 cm squares), the owner's\n * direction of 2026-11-03 (WP 13.30, ADR-0025 amendment 47): the engine's own `pixels` resolution and crisp texels\n * are the pixel look's.\n *\n * Invariants: data only, the kind's fields (`node x describe look`); the sky `sky:daylight`; the scene's own style;\n * every filter it leaves out off. The page draws it by default (labs/playground/main.ts); P steps on to the cel look,\n * then the pixel look.\n *\n * @example\n * look.id; // 'look:playground-clean'\n * look.filters.aa.scope; // 'all': its edges smoothed\n * [look.resolution, look.textures]; // ['full', 'smooth']\n * @see labs/playground/looks/looks.test.ts\n * @see tests/e2e/playground-looks.spec.ts\n */\nimport { defineLook } from '../../../engine';\n\n/** The look `look:playground-clean`: the scene's own lit materials under the hour's sky at full resolution, smoothed. */\nexport const look = defineLook('look:playground-clean', {\n  description:\n    \"The playground clean, its default: the scene's own lit materials under the hour's sky at full resolution, textures and edges smoothed; no bands, ink, outlines or pixels.\",\n  sky: 'sky:daylight',\n  resolution: 'full',\n  textures: 'smooth',\n  filters: { aa: { scope: 'all' } },\n});\nx describe: ok: sky: 8 fields, 6 entries\nSky presets: what surrounds and lights a level (background, dome, backdrop, sun, ambient light, fog, how bright the point lights shine).\nfallback: sky:daylight\nids: sky:dawn, sky:daylight, sky:dusk, sky:hall, sky:night, sky:noon\n  description: string, = \"\": What it looks like, in plain sentences.\n  background: string, = \"#06050b\": The colour behind everything, hex, where neither dome nor backdrop is drawn.\n  pointLights: number, = 1, 0..inf: A multiplier on the light pool's intensities: 1 as the light kinds say, 0 puts them out.\n  dome: object, = {\"show\":false,\"turbidity\":2,\"rayleigh...: The sky dome: three.js's SkyMesh (the Preetham daylight model), lit by the su...\n  sun: object, = {\"color\":\"#fff0d8\",\"intensity\":0,\"azi...: The sun: three.js's DirectionalLight, shining from its azimuth and elevation; ...\n  ambient: object, = {\"sky\":\"#c8d4ff\",\"ground\":\"#4a3f30\",\"...: The ambient light: three.js's HemisphereLight, one colour from above and o...\n  fog: object, = {\"color\":\"#06050b\",\"start\":12,\"end\":7...: Range fog past the focus plus height fog on the floor (engine/gfx/atmosphere.t...\n  backdrop: object, = {\"haze\":\"#c8e4f8\",\"tint\":\"#ffffff\",\"l...: Silhouettes round the horizon, far layers first; no layers draws no backd...\n(a line above is cut short: the whole text is in out/describe/sky/describe.json)\nreport: out/describe/sky/report.json\nx describe: ok: sky \"sky:dusk\": 7 of 8 fields differ from the default\n* description = \"Dusk by the clock: an orange sky, the sun setting in the west.\"\n* background = \"#e09060\"\n  pointLights = 1\n* dome = {\"show\":true,\"turbidity\":6,\"rayleigh\":3,\"mieCoefficient\":0.012,\"mieDirectionalG\":0.85,\"exposure\":...\n* sun = {\"color\":\"#ff9a60\",\"intensity\":1.6,\"azimuth\":0,\"elevation\":0.9}\n* ambient = {\"sky\":\"#e0b0a0\",\"ground\":\"#2e2620\",\"intensity\":1.1}\n* fog = {\"color\":\"#d8a890\",\"start\":30,\"end\":200,\"amount\":0.55,\"floor\":0,\"ceiling\":1.5,\"height\":0}\n* backdrop = {\"haze\":\"#c8e4f8\",\"tint\":\"#d0a088\",\"layers\":[{\"kind\":\"mountains\",\"color\":\"#7a98c8\",\"height\":0.95,...\n(a line above is cut short: the whole text is in out/describe/sky-sky-dusk/describe.json)\nreport: out/describe/sky-sky-dusk/report.json","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015Zrt6W1j4VP5V96tKXZkYr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
