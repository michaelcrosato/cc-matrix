{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TTKfp7WZEuM1Jh1S7UB9Lh","type":"tool_result","content":"1\t/**\n2\t * @file Sessions (PLAN.md §8.4, WP 1.5; doctrines: Reproducible, Agent-operable): `createSession(scene, options)`\n3\t * starts a scene (engine/sim/scene.ts `startScene`) that records its inputs from step 0, the recorder of PLAN.md §8.4.\n4\t * The kernel fixture, the box's scenes and `createHeadless` (WP 1.6) all record through it; engine/sim/replay.ts plays\n5\t * what it records.\n6\t *\n7\t * A session logs, each at the step it happens (merged in play order: set, then dev, then intents), what its intents\n8\t * change (a step the world does not count logs nothing), every non-view setting change (through `set` or its own store,\n9\t * `session.settings`), and its dev actions (`act`: the scene's own, else the engine's, engine/sim/devActions.ts; all or\n10\t * nothing: one that throws is rolled back; an unknown one is `SIM_NO_ACTION`). `record()` returns the replay from step\n11\t * 0; change-points no step has followed yet wait for it.\n12\t * Step, capture and restore through the session, never the world (`SIM_OFF_RECORD`): `session.restore` takes the\n13\t * recording back to the capture's step with the sim, so `record()` replays the run as it stands; it refuses a capture\n14\t * it did not take (`SIM_FOREIGN_CAPTURE`) or one changed since (`SIM_EDITED_CAPTURE`). `Session` says the rest.\n15\t *\n16\t * Invariants: the recording is plain data, from step 0, and replays to the same hashes (engine/sim/replay.ts); view\n17\t * settings are never recorded. Split from scene.ts to keep each under 400 lines (ADR-0014 amendment 16).\n18\t *\n19\t * @example\n20\t * import { createRegistry } from '../core/registry';\n21\t * import { defineScene } from './scene';\n22\t * const reg = createRegistry();\n23\t * defineScene('demo', { description: 'Spawns one.', setup: (w) => w.spawn() }, reg);\n24\t * const live = createSession('demo', { registry: reg });\n25\t * live.step({ move: [0, 1] });\n26\t * live.step({ move: [0, 1], b: ['jump'] });\n27\t * live.record().inputs; // [[0, { move: [0, 1] }], [1, { b: ['jump'] }]]\n28\t * @see engine/sim/scene.test.ts\n29\t */\n30\timport type { EventMap } from '../core/events';\n31\timport { deserialize, hashValue, serialize, type Canonical } from '../core/hash';\n32\timport { codeError, defineCodes, didYouMean } from '../core/log';\n33\timport { registry as sharedRegistry, sameValue } from '../core/registry';\n34\timport { show } from '../core/schema';\n35\timport type { SettingChange, SettingValue } from '../core/settings';\n36\timport { diffIntents, INTENT_KEYS, NO_INTENTS, normalizeIntents, type Intents } from '../input/intents';\n37\timport type { WorldCapture } from './capture';\n38\timport type { InputChange, InputEntry, Replay } from './replay';\n39\timport { changesSim, devArgs, findDevAction, listDevActions } from './devActions';\n40\timport { checkSeed, startScene, type SceneOptions, type SceneRun } from './scene';\n41\timport type { AnyComponents } from './state';\n42\t\n43\t/** The codes this module raises, with their fixes. */\n44\texport const SESSION_CODES = defineCodes('sim', {\n45\t  SIM_NO_ACTION: {\n46\t    template: 'the scene {scene} has no dev action {name} ({suggestion})',\n47\t    fix: \"add it to the scene, defineScene('{scene}', { actions: { {name}(w, args) { … } } }), or to the engine's, defineDevAction('{name}', { help, run }) (engine/sim/devActions.ts); or call one there is\",\n48\t  },\n49\t  SIM_OFF_RECORD: {\n50\t    template: 'the world took {count} steps outside its session, so the recording misses their intents',\n51\t    fix: 'step a recorded scene through session.step(intents), never world.step(); capture and restore it through session.capture() and session.restore(capture), never the world',\n52\t  },\n53\t  SIM_FOREIGN_CAPTURE: {\n54\t    template: 'restore() was given a capture the session of {scene} did not take',\n55\t    fix: \"restore what this session's capture() (__engine.capture()) returned, the object itself: the session knows where its recording stood then; the world's own captures, another session's and copies have no place in it, so reach other state by starting the scene again (__engine.seed(n)) or playing a replay\",\n56\t  },\n57\t  SIM_EDITED_CAPTURE: {\n58\t    template: 'the capture the session of {scene} took at step {step} was changed since (it hashes {now}, not {then})',\n59\t    fix: 'restore it unchanged, then make the change through the session so record() replays it: session.set(path, value) (__engine.set) for a setting, a dev action (session.act(name, args)) for components',\n60\t  },\n61\t});\n62\t\n63\t/**\n64\t * A started scene that records its inputs from step 0, so `record()` returns it as a replay. `step(intents)`\n65\t * normalizes the intents against the step before and logs what changed. Setting changes through the store\n66\t * (`settings`: set, setText, load, fromUrl, reset, override) are logged as `set` points: before each `set`, `act` and\n67\t * `step`, the session compares the store's non-view values with the last ones it saw. `act` captures the world, runs\n68\t * the action inside `w.run` and, if it throws, restores the capture and logs nothing; else it logs it with its args.\n69\t */\n70\texport interface Session<C extends object = AnyComponents, E extends EventMap = EventMap> extends SceneRun<C, E> {\n71\t  /** Steps taken through the session. */\n72\t  readonly steps: number;\n73\t  /** The intents the last step got. */\n74\t  readonly intents: Intents;\n75\t  /** The change-points so far. */\n76\t  readonly inputs: readonly InputEntry[];\n77\t  /** One step with these intents, normalized; recorded once the world counts it. Throws `INPUT_BAD_INTENTS`. */\n78\t  step(intents?: unknown): Intents;\n79\t  /** Sets a setting between steps; a non-view change is recorded at this step (as is any change through `settings`). */\n80\t  set(path: string, value: unknown): SettingChange;\n81\t  /**\n82\t   * Runs the dev action `name` between steps, the scene's own or else the engine's (engine/sim/devActions.ts: its args\n83\t   * checked, its settings set, then its run), all or nothing, then records it. Throws `SIM_NO_ACTION`, or\n84\t   * `CORE_BAD_SPEC` for args its schema refuses.\n85\t   */\n86\t  act(name: string, args?: unknown): void;\n87\t  /** The whole sim, copied (`world.capture()`), with where the recording stands: what `restore` takes. */\n88\t  capture(): WorldCapture;\n89\t  /**\n90\t   * Puts back a capture this session took, unchanged, with its recording (change-points, steps, intents) as it stood\n91\t   * then. Throws `SIM_FOREIGN_CAPTURE` or `SIM_EDITED_CAPTURE` (or the world's `SIM_BAD_CAPTURE`), changing nothing.\n92\t   */\n93\t  restore(capture: WorldCapture): void;\n94\t  /** The replay of every step so far, from step 0, without hashes. Throws `SIM_OFF_RECORD`. */\n95\t  record(): Replay;\n96\t}\n97\t\n98\t/** Where a session's recording stood at a capture (change-points as text: the last may change since) and its digest. */\n99\ttype Mark = { steps: number; inputs: string; last: Intents; seen: Record<string, SettingValue>; hash: string };\n100\t\n101\t/** The digest of a capture's data, or a note when it no longer is plain data. */\n102\tfunction digest(capture: WorldCapture): string {\n103\t  try {\n104\t    return hashValue(capture as unknown as Canonical);\n105\t  } catch {\n106\t    return 'no hash (no longer plain data)';\n107\t  }\n108\t}\n109\t\n110\t/** Starts a scene as a recorded session: `startScene`, plus the recording. */\n111\texport function createSession<C extends object = AnyComponents, E extends EventMap = EventMap>(\n112\t  scene: Parameters<typeof startScene<C, E>>[0],\n113\t  options: SceneOptions = {},\n114\t): Session<C, E> {\n115\t  const run = startScene<C, E>(scene, { ...options, seed: checkSeed(options.seed, 'createSession(scene, { seed })') });\n116\t  const { world, settings } = run;\n117\t  const registry = options.registry ?? sharedRegistry;\n118\t  const viewOf = (path: string) => registry.get('setting', path).view === true;\n119\t  const start = Object.fromEntries(Object.entries(options.settings ?? {}).filter(([path]) => !viewOf(path)));\n120\t  const inputs: InputEntry[] = [];\n121\t  let last: Intents = NO_INTENTS;\n122\t  let steps = 0;\n123\t  let seen = settings.sim.values();\n124\t  const marks = new WeakMap<WorldCapture, Mark>();\n125\t  /** The change-point to write a `what` into at step `at`: the last one when the play order allows, else a new one. */\n126\t  const pointFor = (what: 'set' | 'dev' | 'intents', at = world.tick): InputChange => {\n127\t    const tail = inputs[inputs.length - 1];\n128\t    if (tail && tail[0] === at) {\n129\t      const change = tail[1];\n130\t      const intents = Object.keys(change).some((key) => Object.hasOwn(INTENT_KEYS, key) || key.includes(':'));\n131\t      if (!intents && (what === 'intents' || change.dev === undefined)) return change;\n132\t    }\n133\t    const change: InputChange = {};\n134\t    inputs.push([at, change]);\n135\t    return change;\n136\t  };\n137\t  /** Logs every non-view value the store holds that differs from the last ones seen, as a `set` at this step. */\n138\t  const sync = () => {\n139\t    const now = settings.sim.values();\n140\t    for (const [path, value] of Object.entries(now)) {\n141\t      const before = Object.hasOwn(seen, path) ? seen[path] : registry.get('setting', path).default;\n142\t      if (sameValue(before, value)) continue;\n143\t      const point = pointFor('set');\n144\t      point.set = { ...point.set, [path]: deserialize(serialize(value as Canonical)) as SettingValue };\n145\t    }\n146\t    seen = now;\n147\t  };\n148\t  const session: Session<C, E> = {\n149\t    ...run,\n150\t    get steps() {\n151\t      return steps;\n152\t    },\n153\t    get intents() {\n154\t      return last;\n155\t    },\n156\t    inputs,\n157\t    step(raw = {}) {\n158\t      const next = normalizeIntents(raw, last);\n159\t      sync();\n160\t      const at = world.tick;\n161\t      try {\n162\t        world.step(next);\n163\t      } finally {\n164\t        if (world.tick !== at) {\n165\t          const change = diffIntents(last, next);\n166\t          if (Object.keys(change).length) Object.assign(pointFor('intents', at), change);\n167\t          [last, steps] = [next, steps + 1];\n168\t        }\n169\t      }\n170\t      return next;\n171\t    },\n172\t    set(path, value) {\n173\t      sync();\n174\t      const change = settings.set(path, value);\n175\t      sync();\n176\t      return change;\n177\t    },\n178\t    act(name, args) {\n179\t      const actions = run.scene.actions as Record<string, (w: unknown, a: unknown) => void>;\n180\t      const own = Object.hasOwn(actions, name) && typeof actions[name] === 'function' ? actions[name] : undefined;\n181\t      const engine = own ? undefined : findDevAction(registry, name);\n182\t      if (!own && !engine) {\n183\t        const names = [...new Set([...Object.keys(actions), ...listDevActions(registry).map((a) => a.id)])].sort();\n184\t        const near = didYouMean(name, names).trim().slice(1, -1);\n185\t        const suggestion = near || (names.length ? `its actions: ${names.map(show).join(', ')}` : 'it has none');\n186\t        throw codeError('SIM_NO_ACTION', { scene: run.scene.id, name: show(name), suggestion });\n187\t      }\n188\t      const text = args === undefined ? undefined : serialize(args as Canonical);\n189\t      const given = () => (text === undefined ? undefined : deserialize(text));\n190\t      const checked = engine ? devArgs(engine, given(), name) : {}; // before anything changes\n191\t      sync();\n192\t      const before = world.capture(); // the sim and its recorded settings: a throw puts both back\n193\t      try {\n194\t        for (const [path, value] of Object.entries(engine?.settings(checked) ?? {})) settings.set(path, value);\n195\t        if (own) world.run((w) => own(w, given()));\n196\t        else if (engine && changesSim(engine)) world.run((w) => engine.run(w as never, checked));\n197\t      } catch (error) {\n198\t        world.restore(before);\n199\t        throw error;\n200\t      }\n201\t      sync();\n202\t      if (!own && !changesSim(engine!)) return; // settings alone: recorded as set (view ones never)\n203\t      Object.assign(pointFor('dev'), { dev: name }, text === undefined ? {} : { args: deserialize(text) });\n204\t    },\n205\t    capture() {\n206\t      sync();\n207\t      const capture = world.capture();\n208\t      const text = serialize(inputs as unknown as Canonical);\n209\t      marks.set(capture, { steps, inputs: text, last, seen, hash: digest(capture) });\n210\t      return capture;\n211\t    },\n212\t    restore(capture) {\n213\t      const mark = marks.get(capture);\n214\t      if (!mark) throw codeError('SIM_FOREIGN_CAPTURE', { scene: run.scene.id });\n215\t      const now = digest(capture);\n216\t      if (now !== mark.hash) {\n217\t        throw codeError('SIM_EDITED_CAPTURE', { scene: run.scene.id, step: mark.steps, now, then: mark.hash });\n218\t      }\n219\t      world.restore(capture);\n220\t      inputs.length = 0;\n221\t      for (const entry of deserialize(mark.inputs) as unknown as InputEntry[]) inputs.push(entry);\n222\t      ({ steps, last, seen } = mark);\n223\t    },\n224\t    record() {\n225\t      if (world.tick !== steps) throw codeError('SIM_OFF_RECORD', { count: world.tick - steps });\n226\t      const taken = inputs.filter(([at]) => at < steps);\n227\t      return {\n228\t        format: 'my3dge-replay/1', // REPLAY_FORMAT, checked by its type (importing it would make the modules circular)\n229\t        scene: run.scene.id,\n230\t        settings: deserialize(serialize(start as Canonical)) as Record<string, SettingValue>,\n231\t        seed: world.seed,\n232\t        hz: world.hz,\n233\t        steps,\n234\t        inputs: deserialize(serialize(taken as unknown as Canonical)) as unknown as InputEntry[],\n235\t        hashes: {},\n236\t      };\n237\t    },\n238\t  };\n239\t  return session;\n240\t}\n241\t"}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"063ed794-1579-47ac-a4a8-50869a49445f","timestamp":"2026-11-05T04:34:16.720Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/engine/sim/session.ts","content":"/**\n * @file Sessions (PLAN.md §8.4, WP 1.5; doctrines: Reproducible, Agent-operable): `createSession(scene, options)`\n * starts a scene (engine/sim/scene.ts `startScene`) that records its inputs from step 0, the recorder of PLAN.md §8.4.\n * The kernel fixture, the box's scenes and `createHeadless` (WP 1.6) all record through it; engine/sim/replay.ts plays\n * what it records.\n *\n * A session logs, each at the step it happens (merged in play order: set, then dev, then intents), what its intents\n * change (a step the world does not count logs nothing), every non-view setting change (through `set` or its own store,\n * `session.settings`), and its dev actions (`act`: the scene's own, else the engine's, engine/sim/devActions.ts; all or\n * nothing: one that throws is rolled back; an unknown one is `SIM_NO_ACTION`). `record()` returns the replay from step\n * 0; change-points no step has followed yet wait for it.\n * Step, capture and restore through the session, never the world (`SIM_OFF_RECORD`): `session.restore` takes the\n * recording back to the capture's step with the sim, so `record()` replays the run as it stands; it refuses a capture\n * it did not take (`SIM_FOREIGN_CAPTURE`) or one changed since (`SIM_EDITED_CAPTURE`). `Session` says the rest.\n *\n * Invariants: the recording is plain data, from step 0, and replays to the same hashes (engine/sim/replay.ts); view\n * settings are never recorded. Split from scene.ts to keep each under 400 lines (ADR-0014 amendment 16).\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * import { defineScene } from './scene';\n * const reg = createRegistry();\n * defineScene('demo', { description: 'Spawns one.', setup: (w) => w.spawn() }, reg);\n * const live = createSession('demo', { registry: reg });\n * live.step({ move: [0, 1] });\n * live.step({ move: [0, 1], b: ['jump'] });\n * live.record().inputs; // [[0, { move: [0, 1] }], [1, { b: ['jump'] }]]\n * @see engine/sim/scene.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { deserialize, hashValue, serialize, type Canonical } from '../core/hash';\nimport { codeError, defineCodes, didYouMean } from '../core/log';\nimport { registry as sharedRegistry, sameValue } from '../core/registry';\nimport { show } from '../core/schema';\nimport type { SettingChange, SettingValue } from '../core/settings';\nimport { diffIntents, INTENT_KEYS, NO_INTENTS, normalizeIntents, type Intents } from '../input/intents';\nimport type { WorldCapture } from './capture';\nimport type { InputChange, InputEntry, Replay } from './replay';\nimport { changesSim, devArgs, findDevAction, listDevActions } from './devActions';\nimport { checkSeed, startScene, type SceneOptions, type SceneRun } from './scene';\nimport type { AnyComponents } from './state';\n\n/** The codes this module raises, with their fixes. */\nexport const SESSION_CODES = defineCodes('sim', {\n  SIM_NO_ACTION: {\n    template: 'the scene {scene} has no dev action {name} ({suggestion})',\n    fix: \"add it to the scene, defineScene('{scene}', { actions: { {name}(w, args) { … } } }), or to the engine's, defineDevAction('{name}', { help, run }) (engine/sim/devActions.ts); or call one there is\",\n  },\n  SIM_OFF_RECORD: {\n    template: 'the world took {count} steps outside its session, so the recording misses their intents',\n    fix: 'step a recorded scene through session.step(intents), never world.step(); capture and restore it through session.capture() and session.restore(capture), never the world',\n  },\n  SIM_FOREIGN_CAPTURE: {\n    template: 'restore() was given a capture the session of {scene} did not take',\n    fix: \"restore what this session's capture() (__engine.capture()) returned, the object itself: the session knows where its recording stood then; the world's own captures, another session's and copies have no place in it, so reach other state by starting the scene again (__engine.seed(n)) or playing a replay\",\n  },\n  SIM_EDITED_CAPTURE: {\n    template: 'the capture the session of {scene} took at step {step} was changed since (it hashes {now}, not {then})',\n    fix: 'restore it unchanged, then make the change through the session so record() replays it: session.set(path, value) (__engine.set) for a setting, a dev action (session.act(name, args)) for components',\n  },\n});\n\n/**\n * A started scene that records its inputs from step 0, so `record()` returns it as a replay. `step(intents)`\n * normalizes the intents against the step before and logs what changed. Setting changes through the store\n * (`settings`: set, setText, load, fromUrl, reset, override) are logged as `set` points: before each `set`, `act` and\n * `step`, the session compares the store's non-view values with the last ones it saw. `act` captures the world, runs\n * the action inside `w.run` and, if it throws, restores the capture and logs nothing; else it logs it with its args.\n */\nexport interface Session<C extends object = AnyComponents, E extends EventMap = EventMap> extends SceneRun<C, E> {\n  /** Steps taken through the session. */\n  readonly steps: number;\n  /** The intents the last step got. */\n  readonly intents: Intents;\n  /** The change-points so far. */\n  readonly inputs: readonly InputEntry[];\n  /** One step with these intents, normalized; recorded once the world counts it. Throws `INPUT_BAD_INTENTS`. */\n  step(intents?: unknown): Intents;\n  /** Sets a setting between steps; a non-view change is recorded at this step (as is any change through `settings`). */\n  set(path: string, value: unknown): SettingChange;\n  /**\n   * Runs the dev action `name` between steps, the scene's own or else the engine's (engine/sim/devActions.ts: its args\n   * checked, its settings set, then its run), all or nothing, then records it. Throws `SIM_NO_ACTION`, or\n   * `CORE_BAD_SPEC` for args its schema refuses.\n   */\n  act(name: string, args?: unknown): void;\n  /** The whole sim, copied (`world.capture()`), with where the recording stands: what `restore` takes. */\n  capture(): WorldCapture;\n  /**\n   * Puts back a capture this session took, unchanged, with its recording (change-points, steps, intents) as it stood\n   * then. Throws `SIM_FOREIGN_CAPTURE` or `SIM_EDITED_CAPTURE` (or the world's `SIM_BAD_CAPTURE`), changing nothing.\n   */\n  restore(capture: WorldCapture): void;\n  /** The replay of every step so far, from step 0, without hashes. Throws `SIM_OFF_RECORD`. */\n  record(): Replay;\n}\n\n/** Where a session's recording stood at a capture (change-points as text: the last may change since) and its digest. */\ntype Mark = { steps: number; inputs: string; last: Intents; seen: Record<string, SettingValue>; hash: string };\n\n/** The digest of a capture's data, or a note when it no longer is plain data. */\nfunction digest(capture: WorldCapture): string {\n  try {\n    return hashValue(capture as unknown as Canonical);\n  } catch {\n    return 'no hash (no longer plain data)';\n  }\n}\n\n/** Starts a scene as a recorded session: `startScene`, plus the recording. */\nexport function createSession<C extends object = AnyComponents, E extends EventMap = EventMap>(\n  scene: Parameters<typeof startScene<C, E>>[0],\n  options: SceneOptions = {},\n): Session<C, E> {\n  const run = startScene<C, E>(scene, { ...options, seed: checkSeed(options.seed, 'createSession(scene, { seed })') });\n  const { world, settings } = run;\n  const registry = options.registry ?? sharedRegistry;\n  const viewOf = (path: string) => registry.get('setting', path).view === true;\n  const start = Object.fromEntries(Object.entries(options.settings ?? {}).filter(([path]) => !viewOf(path)));\n  const inputs: InputEntry[] = [];\n  let last: Intents = NO_INTENTS;\n  let steps = 0;\n  let seen = settings.sim.values();\n  const marks = new WeakMap<WorldCapture, Mark>();\n  /** The change-point to write a `what` into at step `at`: the last one when the play order allows, else a new one. */\n  const pointFor = (what: 'set' | 'dev' | 'intents', at = world.tick): InputChange => {\n    const tail = inputs[inputs.length - 1];\n    if (tail && tail[0] === at) {\n      const change = tail[1];\n      const intents = Object.keys(change).some((key) => Object.hasOwn(INTENT_KEYS, key) || key.includes(':'));\n      if (!intents && (what === 'intents' || change.dev === undefined)) return change;\n    }\n    const change: InputChange = {};\n    inputs.push([at, change]);\n    return change;\n  };\n  /** Logs every non-view value the store holds that differs from the last ones seen, as a `set` at this step. */\n  const sync = () => {\n    const now = settings.sim.values();\n    for (const [path, value] of Object.entries(now)) {\n      const before = Object.hasOwn(seen, path) ? seen[path] : registry.get('setting', path).default;\n      if (sameValue(before, value)) continue;\n      const point = pointFor('set');\n      point.set = { ...point.set, [path]: deserialize(serialize(value as Canonical)) as SettingValue };\n    }\n    seen = now;\n  };\n  const session: Session<C, E> = {\n    ...run,\n    get steps() {\n      return steps;\n    },\n    get intents() {\n      return last;\n    },\n    inputs,\n    step(raw = {}) {\n      const next = normalizeIntents(raw, last);\n      sync();\n      const at = world.tick;\n      try {\n        world.step(next);\n      } finally {\n        if (world.tick !== at) {\n          const change = diffIntents(last, next);\n          if (Object.keys(change).length) Object.assign(pointFor('intents', at), change);\n          [last, steps] = [next, steps + 1];\n        }\n      }\n      return next;\n    },\n    set(path, value) {\n      sync();\n      const change = settings.set(path, value);\n      sync();\n      return change;\n    },\n    act(name, args) {\n      const actions = run.scene.actions as Record<string, (w: unknown, a: unknown) => void>;\n      const own = Object.hasOwn(actions, name) && typeof actions[name] === 'function' ? actions[name] : undefined;\n      const engine = own ? undefined : findDevAction(registry, name);\n      if (!own && !engine) {\n        const names = [...new Set([...Object.keys(actions), ...listDevActions(registry).map((a) => a.id)])].sort();\n        const near = didYouMean(name, names).trim().slice(1, -1);\n        const suggestion = near || (names.length ? `its actions: ${names.map(show).join(', ')}` : 'it has none');\n        throw codeError('SIM_NO_ACTION', { scene: run.scene.id, name: show(name), suggestion });\n      }\n      const text = args === undefined ? undefined : serialize(args as Canonical);\n      const given = () => (text === undefined ? undefined : deserialize(text));\n      const checked = engine ? devArgs(engine, given(), name) : {}; // before anything changes\n      sync();\n      const before = world.capture(); // the sim and its recorded settings: a throw puts both back\n      try {\n        for (const [path, value] of Object.entries(engine?.settings(checked) ?? {})) settings.set(path, value);\n        if (own) world.run((w) => own(w, given()));\n        else if (engine && changesSim(engine)) world.run((w) => engine.run(w as never, checked));\n      } catch (error) {\n        world.restore(before);\n        throw error;\n      }\n      sync();\n      if (!own && !changesSim(engine!)) return; // settings alone: recorded as set (view ones never)\n      Object.assign(pointFor('dev'), { dev: name }, text === undefined ? {} : { args: deserialize(text) });\n    },\n    capture() {\n      sync();\n      const capture = world.capture();\n      const text = serialize(inputs as unknown as Canonical);\n      marks.set(capture, { steps, inputs: text, last, seen, hash: digest(capture) });\n      return capture;\n    },\n    restore(capture) {\n      const mark = marks.get(capture);\n      if (!mark) throw codeError('SIM_FOREIGN_CAPTURE', { scene: run.scene.id });\n      const now = digest(capture);\n      if (now !== mark.hash) {\n        throw codeError('SIM_EDITED_CAPTURE', { scene: run.scene.id, step: mark.steps, now, then: mark.hash });\n      }\n      world.restore(capture);\n      inputs.length = 0;\n      for (const entry of deserialize(mark.inputs) as unknown as InputEntry[]) inputs.push(entry);\n      ({ steps, last, seen } = mark);\n    },\n    record() {\n      if (world.tick !== steps) throw codeError('SIM_OFF_RECORD', { count: world.tick - steps });\n      const taken = inputs.filter(([at]) => at < steps);\n      return {\n        format: 'my3dge-replay/1', // REPLAY_FORMAT, checked by its type (importing it would make the modules circular)\n        scene: run.scene.id,\n        settings: deserialize(serialize(start as Canonical)) as Record<string, SettingValue>,\n        seed: world.seed,\n        hz: world.hz,\n        steps,\n        inputs: deserialize(serialize(taken as unknown as Canonical)) as unknown as InputEntry[],\n        hashes: {},\n      };\n    },\n  };\n  return session;\n}\n","numLines":241,"startLine":1,"totalLines":241}},"tool_result_meta":[{"id":"toolu_01TTKfp7WZEuM1Jh1S7UB9Lh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rpaf1syotgx48NuU6me2Wo","type":"tool_result","content":"1\t/**\n2\t * @file What an actor reads of a step's intents (PLAN.md WP 3.2, WP 13.3, WP 13.9; split from engine/sim/actors.ts at\n3\t * its cap, WP 13.16): `intentsOf(actor, intents)` is the step's intents for a player, else its AI's (`actor.intents`,\n4\t * its presses from the edges of the buttons it held, `actor.held`); `motionInput(actor, wants, controls)` is what an\n5\t * actor on a movement model (engine/physics/movement/) takes of them: the sprint, walk and crouch buttons as a player's\n6\t * controls (`input.sprint`, `input.crouch`) say, the use press (unless a use took it, `used`: engine/sim/interact.ts),\n7\t * the view, the keys' frame and what it faces (the aim's point, else the view), whether a melee swings (no mantle\n8\t * then: engine/sim/melee.ts) and whether he aims down a weapon's sights (a walk then: engine/sim/weapons.ts).\n9\t *\n10\t * Invariants: pure but for an AI actor's own button edges, which `intentsOf` keeps in its component.\n11\t *\n12\t * @example\n13\t * // const wants = intentsOf(actor, intents); // a player's: the step's own\n14\t * // const input = motionInput(actor, wants, { holdSprint: false, toggleCrouch: false });\n15\t * @see engine/sim/actors.test.ts\n16\t */\n17\timport { held, normalizeIntents, pressed, type Intents } from '../input/intents';\n18\timport type { CharacterInput } from '../physics/character';\n19\timport type { ActorComponent } from './actors';\n20\t\n21\t/** The intents an actor acts on this step: the step's for a player, else its AI's (with presses from `b`'s edges). */\n22\texport function intentsOf(actor: ActorComponent, intents: Intents): Intents {\n23\t  if (actor.player) return intents;\n24\t  const own = normalizeIntents(actor.intents, normalizeIntents({ b: actor.held }));\n25\t  const { p: _pressed, ...rest } = actor.intents;\n26\t  [actor.held, actor.intents] = [[...(own.b ?? [])], rest];\n27\t  return own;\n28\t}\n29\t\n30\t/** A player's controls (the settings `input.sprint` and `input.crouch`): a held sprint, a toggled crouch. */\n31\texport interface Controls {\n32\t  readonly holdSprint: boolean;\n33\t  readonly toggleCrouch: boolean;\n34\t}\n35\t\n36\t/**\n37\t * The shooter model's input from `wants`: the sprint, walk and crouch buttons, the view, the keys' frame and what it\n38\t * faces; `used`, a use took the step's press (no ride); `swinging`, a melee swings (no mantle: engine/sim/melee.ts);\n39\t * `aiming`, he aims down a weapon's sights, so walks (Apex walks only then: engine/sim/weapons.ts).\n40\t */\n41\texport function motionInput(\n42\t  actor: ActorComponent,\n43\t  wants: Intents,\n44\t  controls: Controls,\n45\t  used = false,\n46\t  swinging = false,\n47\t  aiming = false,\n48\t): CharacterInput {\n49\t  const [aimX, , aimZ] = wants.aim ?? [];\n50\t  const aimed = aimX !== undefined && Math.hypot(aimX - actor.x, aimZ! - actor.z) > 0.05;\n51\t  const face = aimed ? Math.atan2(aimX - actor.x, aimZ! - actor.z) : wants.look?.[0];\n52\t  const frame = wants.cam ?? wants.look?.[0];\n53\t  const toggle = actor.player && controls.toggleCrouch;\n54\t  return {\n55\t    sprint: held(wants, 'sprint'),\n56\t    sprintPressed: pressed(wants, 'sprint'),\n57\t    ...(actor.player && controls.holdSprint ? { sprintHold: true } : {}),\n58\t    walk: held(wants, 'walk') || aiming,\n59\t    crouch: !toggle && held(wants, 'crouch'),\n60\t    crouchToggle: pressed(wants, 'crouchToggle') || (toggle && pressed(wants, 'crouch')),\n61\t    usePressed: pressed(wants, 'interact') && !used, // a use took the press (engine/sim/interact.ts): no ride\n62\t    ...(wants.look ? { view: wants.look[0], pitch: wants.look[1] } : {}),\n63\t    ...(frame !== undefined ? { frame } : {}),\n64\t    ...(face !== undefined ? { face } : {}),\n65\t    ...(swinging ? { swinging } : {}),\n66\t  };\n67\t}\n68\t"}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"7944973c-db2f-4dd3-9e67-e0af22567843","timestamp":"2026-11-05T04:34:16.726Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/engine/sim/actorInput.ts","content":"/**\n * @file What an actor reads of a step's intents (PLAN.md WP 3.2, WP 13.3, WP 13.9; split from engine/sim/actors.ts at\n * its cap, WP 13.16): `intentsOf(actor, intents)` is the step's intents for a player, else its AI's (`actor.intents`,\n * its presses from the edges of the buttons it held, `actor.held`); `motionInput(actor, wants, controls)` is what an\n * actor on a movement model (engine/physics/movement/) takes of them: the sprint, walk and crouch buttons as a player's\n * controls (`input.sprint`, `input.crouch`) say, the use press (unless a use took it, `used`: engine/sim/interact.ts),\n * the view, the keys' frame and what it faces (the aim's point, else the view), whether a melee swings (no mantle\n * then: engine/sim/melee.ts) and whether he aims down a weapon's sights (a walk then: engine/sim/weapons.ts).\n *\n * Invariants: pure but for an AI actor's own button edges, which `intentsOf` keeps in its component.\n *\n * @example\n * // const wants = intentsOf(actor, intents); // a player's: the step's own\n * // const input = motionInput(actor, wants, { holdSprint: false, toggleCrouch: false });\n * @see engine/sim/actors.test.ts\n */\nimport { held, normalizeIntents, pressed, type Intents } from '../input/intents';\nimport type { CharacterInput } from '../physics/character';\nimport type { ActorComponent } from './actors';\n\n/** The intents an actor acts on this step: the step's for a player, else its AI's (with presses from `b`'s edges). */\nexport function intentsOf(actor: ActorComponent, intents: Intents): Intents {\n  if (actor.player) return intents;\n  const own = normalizeIntents(actor.intents, normalizeIntents({ b: actor.held }));\n  const { p: _pressed, ...rest } = actor.intents;\n  [actor.held, actor.intents] = [[...(own.b ?? [])], rest];\n  return own;\n}\n\n/** A player's controls (the settings `input.sprint` and `input.crouch`): a held sprint, a toggled crouch. */\nexport interface Controls {\n  readonly holdSprint: boolean;\n  readonly toggleCrouch: boolean;\n}\n\n/**\n * The shooter model's input from `wants`: the sprint, walk and crouch buttons, the view, the keys' frame and what it\n * faces; `used`, a use took the step's press (no ride); `swinging`, a melee swings (no mantle: engine/sim/melee.ts);\n * `aiming`, he aims down a weapon's sights, so walks (Apex walks only then: engine/sim/weapons.ts).\n */\nexport function motionInput(\n  actor: ActorComponent,\n  wants: Intents,\n  controls: Controls,\n  used = false,\n  swinging = false,\n  aiming = false,\n): CharacterInput {\n  const [aimX, , aimZ] = wants.aim ?? [];\n  const aimed = aimX !== undefined && Math.hypot(aimX - actor.x, aimZ! - actor.z) > 0.05;\n  const face = aimed ? Math.atan2(aimX - actor.x, aimZ! - actor.z) : wants.look?.[0];\n  const frame = wants.cam ?? wants.look?.[0];\n  const toggle = actor.player && controls.toggleCrouch;\n  return {\n    sprint: held(wants, 'sprint'),\n    sprintPressed: pressed(wants, 'sprint'),\n    ...(actor.player && controls.holdSprint ? { sprintHold: true } : {}),\n    walk: held(wants, 'walk') || aiming,\n    crouch: !toggle && held(wants, 'crouch'),\n    crouchToggle: pressed(wants, 'crouchToggle') || (toggle && pressed(wants, 'crouch')),\n    usePressed: pressed(wants, 'interact') && !used, // a use took the press (engine/sim/interact.ts): no ride\n    ...(wants.look ? { view: wants.look[0], pitch: wants.look[1] } : {}),\n    ...(frame !== undefined ? { frame } : {}),\n    ...(face !== undefined ? { face } : {}),\n    ...(swinging ? { swinging } : {}),\n  };\n}\n","numLines":68,"startLine":1,"totalLines":68}},"tool_result_meta":[{"id":"toolu_01Rpaf1syotgx48NuU6me2Wo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013QrF72uPQAxFMwM1KTYVYY","type":"tool_result","content":"1\t/**\n2\t * @file Actors (PLAN.md WP 3.2; WP 3.7 adds the animator): entities that walk, jump and dash through the character\n3\t * controller (engine/physics/character.ts). `spawnActor(w, { at, character, player })` adds a capsule body to the\n4\t * scene's physics world and spawns an entity with the component `actor` (its body, settings, intents, feet and the\n5\t * controller's state), so the sim hashes, captures and restores all of it.\n6\t *\n7\t * The step (shardfall's order): movers set their velocities (`intents`, `ai`), the system `actors` moves every actor in\n8\t * id order (`anim`), the world steps (`physics`), and `actors.readback` copies the feet into `x`, `y`, `z`\n9\t * (`readback`). A player actor reads the step's intents: `move`, `jump` (held, pressed) and `dash` (pressed); any other\n10\t * the intents its AI writes into `actor.intents`, its presses from the edges of `b`. Events: `jump` `{ id, at }`,\n11\t * `land` `{ id, speed, at }`, `dash` `{ id, at }`, `at` its feet as the step began (where it happened, however late a\n12\t * sound map reads it). Gravity: `physics.characterGravity` unless the settings name one; the weight on dynamic floors\n13\t * uses `physics.gravity`. The component `oneWay` makes its body a one-way platform. WP 3.7: `anim` adds the component\n14\t * `animator`, stepped by `actors.anim` after `actors` (its `reactions` first, WP 7.8) and, with `preciseHits`, posed by\n15\t * `actors.pose` after `actors.readback` (engine/sim/actorAnim.ts) (`footstep` `{ id, side, speed, at, gait? }`, the gait its movement model's).\n16\t * WP 8.9: `body` adds the component `puppet` (the body drawn), `clips` the clip layer (engine/sim/actorClips.ts).\n17\t * WP 13.3 and 13.7: an actor on a movement model also holds `motion`, the model's state, and reads its buttons, view\n18\t * and rides (`spawnActor` says which), and tells the move it enters (`move` `{ id, what, at }`, WP 13.22); launchers\n19\t * set off any actor (`launch` `{ id, at }`). WP 13.9: a player's sprint and crouch work as `input.sprint` and\n20\t * `input.crouch` say (held, or toggled by a press); WP 13.10: an animated actor's duck is its animator's pose `crouch`.\n21\t *\n22\t * Invariants: systems are added once per world, on the first (animated) spawn; all an actor remembers is in its\n23\t * components (the sim's animators are loaded from them). Despawning leaves the body; `removeActor` removes both.\n24\t * Carried from shardfall@fa2dab6 (`pavilion-lite/src/character.rs:179-399`: the order of a step, the events).\n25\t * @example\n26\t * import { createCharacter } from '../physics/character';\n27\t * import { physicsOf } from '../physics/binding';\n28\t * import { startScene, defineScene } from './scene';\n29\t * defineScene('walk', {\n30\t *   physics: true,\n31\t *   setup(w) {\n32\t *     physicsOf(w).addBody({ type: 'fixed', colliders: [{ shape: { type: 'box', size: [40, 1, 40] }, position: [0, -0.5, 0] }] });\n33\t *     spawnActor(w, { at: [0, 0, 0], character: createCharacter({ speed: 5 }) });\n34\t *   },\n35\t * });\n36\t * const { world } = startScene('walk');\n37\t * for (let i = 0; i < 60; i++) world.step({ move: [1, 0] });\n38\t * world.query('actor')[0].actor.x; // 4.69: a second's walk east at 5 m/s, from standing\n39\t * @see engine/sim/actors.test.ts\n40\t */\n41\timport { ANIMATOR_FIELDS, type AnimatorData, type AnimatorOptions } from '../anim/character';\n42\timport type { AnimatorInput } from '../anim/states';\n43\timport { codeError } from '../core/log';\n44\timport { registry as sharedRegistry, type Registry } from '../core/registry';\n45\timport { defineSettings } from '../core/settings';\n46\timport { held, pressed, type Intents } from '../input/intents';\n47\timport {\n48\t  addCharacter,\n49\t  bodyAt,\n50\t  CHARACTER_SETTINGS,\n51\t  CHARACTER_STATE_FIELDS,\n52\t  createCharacter,\n53\t  createCharacterState,\n54\t  feetOf,\n55\t  stepCharacter,\n56\t  type Character,\n57\t  type CharacterInput,\n58\t  type CharacterState,\n59\t} from '../physics/character';\n60\timport { matchHull } from '../physics/hull';\n61\timport { hullFor } from '../physics/movement/crouch';\n62\timport { createMotionState, MOTION_FIELDS, type MotionState } from '../physics/movement/model';\n63\timport { MOVEMENT_SETTINGS, movementOverrides, tuneCharacter } from '../physics/movement/settings';\n64\timport { physicsOf } from '../physics/binding';\n65\timport { vec, type Vec3Like } from '../physics/queries';\n66\timport { clipsFor, defineClipKinds, type ClipsSpec } from './actorClips';\n67\timport { poseAnimators, stepAnimators } from './actorAnim';\n68\timport { intentsOf, motionInput } from './actorInput';\n69\timport { defineActionKinds } from './actorActions';\n70\timport { defineReactionKinds } from './reactions';\n71\timport { defineRideKinds, ridesOf } from './rides';\n72\timport { defineComponent } from './state';\n73\timport type { World } from './world';\n74\t\n75\t/** The component `actor`'s own fields, before the controller's state. */\n76\tconst ACTOR_FIELDS = {\n77\t  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world.' },\n78\t  player: { type: 'boolean', default: true, description: 'Whether it reads the step’s intents (else actor.intents).' },\n79\t  character: { type: 'any', default: createCharacter(), description: 'Its settings: what createCharacter returned.' },\n80\t  intents: { type: 'any', default: {}, description: 'What its AI wants this step (move, b, p), when not a player.' },\n81\t  held: { type: 'array', default: [], description: 'The buttons its AI held last step, for presses.' },\n82\t  x: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, east.' },\n83\t  y: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, up.' },\n84\t  z: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, south.' },\n85\t} as const;\n86\t\n87\t/** The component `actor`: an entity the character controller moves. */\n88\texport interface ActorComponent extends CharacterState {\n89\t  body: number;\n90\t  player: boolean;\n91\t  character: Character;\n92\t  intents: Partial<Intents>;\n93\t  held: string[];\n94\t  x: number;\n95\t  y: number;\n96\t  z: number;\n97\t}\n98\t\n99\t/** The component `animator`: an actor's character animator as plain data, and what its game code tells its body. */\n100\texport interface AnimatorComponent extends AnimatorData {\n101\t  /** The body states its game code holds on (a pose, a stance, a flinch…); the controller's join them each step. */\n102\t  states: Partial<AnimatorInput>;\n103\t}\n104\t\n105\t/** The component `puppet`: the body an actor is drawn as (engine/gfx/puppets/actors.ts), when not the humanoid. */\n106\texport interface PuppetComponent {\n107\t  body: string;\n108\t}\n109\t\n110\t/** The components this module reads: `actor`, `animator`, `puppet`, `motion` (the shooter model's) and `oneWay`. */\n111\texport type ActorComponents = {\n112\t  actor: ActorComponent;\n113\t  animator: AnimatorComponent;\n114\t  puppet: PuppetComponent;\n115\t  motion: MotionState;\n116\t  oneWay: { body: number };\n117\t};\n118\t\n119\t/**\n120\t * How a player's sprint and crouch buttons work, as a shooter's options set them (WP 13.9, docs/PLAYGROUND.md §3.3):\n121\t * recorded settings, since they change how the same presses move him, read by the system `actors` for player actors.\n122\t */\n123\texport const CONTROL_SETTING_FIELDS = {\n124\t  'input.sprint': {\n125\t    type: 'string',\n126\t    enum: ['toggle', 'hold'],\n127\t    default: 'toggle',\n128\t    description: \"The sprint button on the shooter model: toggle, Apex's sticky sprint (a press keeps it on while the player moves on); hold, only while held. Recorded: it changes how a player moves.\", // prettier-ignore\n129\t  },\n130\t  'input.crouch': {\n131\t    type: 'string',\n132\t    enum: ['hold', 'toggle'],\n133\t    default: 'hold',\n134\t    description: 'The crouch button on the shooter model: hold, crouched while held; toggle, a press crouches until pressed again (a jump or a sprint stands it up). Recorded: it changes how a player moves.', // prettier-ignore\n135\t  },\n136\t} as const;\n137\t\n138\t/**\n139\t * Declares the components `actor`, `animator`, `puppet`, `clips` (engine/sim/actorClips.ts), `oneWay`, `reactions` and\n140\t * `secondary` (engine/sim/reactions.ts), the setting `physics.characterGravity` and the controls' `input.sprint` and\n141\t * `input.crouch` on `registry`.\n142\t */\n143\texport function defineActorKinds(registry: Registry = sharedRegistry): void {\n144\t  defineReactionKinds(registry);\n145\t  defineActionKinds(registry);\n146\t  defineRideKinds(registry);\n147\t  if (!registry.kinds().includes('setting') || !registry.has('setting', 'physics.characterGravity')) {\n148\t    defineSettings(CHARACTER_SETTINGS, registry);\n149\t  }\n150\t  if (!registry.has('setting', 'movement.turnRate')) defineSettings(MOVEMENT_SETTINGS, registry);\n151\t  if (!registry.has('setting', 'input.sprint')) defineSettings(CONTROL_SETTING_FIELDS, registry);\n152\t  if (!registry.kinds().includes('component') || !registry.has('component', 'animator')) {\n153\t    const states = { type: 'object', default: {}, description: 'The body states its game code holds on.' } as const;\n154\t    const description = 'A character animator (engine/anim/character.ts): what it keeps, and what its body is told.';\n155\t    defineComponent('animator', { description, fields: { ...ANIMATOR_FIELDS, states } }, registry);\n156\t  }\n157\t  defineClipKinds(registry);\n158\t  if (!registry.has('component', 'puppet')) {\n159\t    const body = {\n160\t      type: 'string',\n161\t      default: 'body:humanoid',\n162\t      description: 'Its body’s id (the body grammar’s).',\n163\t    } as const;\n164\t    defineComponent('puppet', { description: 'The body an actor is drawn as, when not the humanoid.', fields: { body } }, registry); // prettier-ignore\n165\t  }\n166\t  if (registry.has('component', 'actor')) return;\n167\t  defineComponent(\n168\t    'actor',\n169\t    {\n170\t      description: 'An entity the character controller moves.',\n171\t      fields: { ...ACTOR_FIELDS, ...CHARACTER_STATE_FIELDS },\n172\t    },\n173\t    registry,\n174\t  );\n175\t  defineComponent(\n176\t    'motion',\n177\t    {\n178\t      description: 'An actor’s state in the shooter movement model (engine/physics/movement/model.ts).',\n179\t      fields: MOTION_FIELDS,\n180\t    },\n181\t    registry,\n182\t  );\n183\t  defineComponent(\n184\t    'oneWay',\n185\t    {\n186\t      description: 'Makes a body a one-way platform: solid only to an actor whose feet are at or above its top.',\n187\t      fields: { body: { type: 'integer', default: -1, minimum: -1, description: 'The platform’s body.' } },\n188\t    },\n189\t    registry,\n190\t  );\n191\t}\n192\tdefineActorKinds();\n193\t\n194\t/** What `spawnActor` takes. */\n195\texport interface ActorSpec {\n196\t  /** Where its feet go: on the ground below them (it starts just above, outside the skin). */\n197\t  at: Vec3Like;\n198\t  /** Its settings (createCharacter). */\n199\t  character: Character;\n200\t  /** Whether it reads the step's intents (true); false: its AI writes `actor.intents`. */\n201\t  player?: boolean;\n202\t  /** Where it faces (rad; forward = (sin yaw, 0, cos yaw)). */\n203\t  yaw?: number;\n204\t  /** Its character animator's make (engine/anim/character.ts); none when absent. */\n205\t  anim?: Pick<AnimatorOptions, 'build' | 'weapon' | 'preciseHits'>;\n206\t  /** The body it is drawn as (`body:mannequin`), with `anim`; the neutral humanoid when absent. */\n207\t  body?: string;\n208\t  /** With `anim`, the clip layer in its animator, playing from these sets (engine/sim/actorClips.ts); none when absent. */\n209\t  clips?: ClipsSpec;\n210\t  /** With a movement model, whether it starts with no weapon out (true: the model's holstered speeds). */\n211\t  holstered?: boolean;\n212\t  /**\n213\t   * Further components it spawns with, by name (its `reactions`, its `secondary`: engine/sim/reactions.ts), so they\n214\t   * are there from its first step, and a page's first warm-up builds what they draw.\n215\t   */\n216\t  components?: Readonly<Record<string, object>>;\n217\t}\n218\t\n219\t/**\n220\t * Spawns an actor in a scene with a physics world: its body, and an entity with the component `actor`. Returns the id.\n221\t * An actor on a movement model (engine/physics/movement/, WP 13.3) also holds `motion`, the model's state (holstered\n222\t * unless spawned `holstered: false`), and reads `sprint` (held, pressed), `walk` and `crouch` (held), `crouchToggle`\n223\t * (pressed), the view from `look`, the keys' frame from `cam` (else `look`) and what it faces from `aim` (else\n224\t * `look`), under the live `movement.*` settings (WP 13.4); WP 13.7: the look's pitch and `interact` (pressed) too,\n225\t * riding the scene's ziplines and ladders (engine/sim/rides.ts); WP 13.9: a player's sprint held only while held with\n226\t * `input.sprint` at `hold`, and his crouch toggled by its press with `input.crouch` at `toggle`.\n227\t */\n228\texport function spawnActor<C extends object>(world: World<C>, spec: ActorSpec): number {\n229\t  const w = world as unknown as World;\n230\t  const physics = physicsOf(w);\n231\t  const body = addCharacter(physics, spec.character, spec.at);\n232\t  const { x, y, z } = feetOf(physics, body, spec.character);\n233\t  const state = { ...createCharacterState(), yaw: spec.yaw ?? 0 };\n234\t  if (!w.systems.has('actors')) {\n235\t    w.systems.add('actors', moveActors, { phase: 'anim' });\n236\t    w.systems.add('actors.readback', readActors, { phase: 'readback' });\n237\t  }\n238\t  const actor = { body, player: spec.player ?? true, character: spec.character, x, y, z, ...state };\n239\t  const motion = spec.character.movement ? { motion: { ...createMotionState(), holstered: spec.holstered ?? true } } : {}; // prettier-ignore\n240\t  if (!spec.anim) return w.spawn({ ...spec.components, ...motion, actor });\n241\t  if (!w.systems.has('actors.anim')) {\n242\t    w.systems.add('actors.anim', stepAnimators, { phase: 'anim' });\n243\t    w.systems.add('actors.pose', poseAnimators, { phase: 'readback' });\n244\t  }\n245\t  const { build = 'build:chibi', weapon = 'none', preciseHits = false } = spec.anim;\n246\t  const animator = { build: typeof build === 'string' ? build : build.id, weapon, preciseHits };\n247\t  const puppet = spec.body !== undefined ? { body: spec.body } : undefined;\n248\t  const clips = spec.clips && (clipsFor(w, spec.clips, animator.build) as unknown as Record<string, unknown>);\n249\t  return w.spawn({ ...spec.components, ...motion, actor, animator, puppet, clips });\n250\t}\n251\t\n252\t/**\n253\t * Puts actor `id` at `at`, its feet on the ground below (just above, outside the skin, as a spawn stands it), facing\n254\t * `yaw` (its own when absent), at rest: no velocity, no jump, dash or landing pending, standing (its hull too); on the\n255\t * shooter model its motion state starts again, holstered as it was, or ducked with `crouch`, its hull crouched from its\n256\t * next step on and kept so until it has headroom, for a place no standing hull fits (a crawlspace). A place where the\n257\t * level (the queries' as of the last step, one-way platforms aside) stands over its feet lower than its hull's top, up\n258\t * its axis, throws `SIM_BAD_ARGUMENT` before it moves anything: the body would sink through the floor. For a scene's dev actions: a feel\n259\t * course places its player where it measures (engine/dev/feel/course.ts).\n260\t */\n261\texport function placeActor<C extends object>(\n262\t  world: World<C>,\n263\t  id: number,\n264\t  at: Vec3Like,\n265\t  yaw?: number,\n266\t  options: { crouch?: boolean } = {},\n267\t): void {\n268\t  const w = world as unknown as World;\n269\t  const e = w.get(id) as Partial<ActorComponents> | undefined;\n270\t  if (!e?.actor) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(w, id)', value: String(id), expected: 'an actor’s id' }); // prettier-ignore\n271\t  const { actor, motion } = e;\n272\t  if (options.crouch && !motion) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(options.crouch)', value: `true for actor ${id}, on no movement model`, expected: 'no crouch: only an actor on a movement model (its component motion) crouches' }); // prettier-ignore\n273\t  const physics = physicsOf(w);\n274\t  const { offset, capsule } = actor.character;\n275\t  const centre = bodyAt(actor.character, at, 'placeActor(at)'); // the standing hull's, its feet just over `at`\n276\t  const middle = motion && options.crouch ? hullFor(actor.character, { ...motion, stance: 'crouch' }) : capsule.height; // prettier-ignore\n277\t  const up = { maxDistance: middle + capsule.radius, exclude: actor.body, groups: 'world' } as const;\n278\t  const ceiling = physics.raycast([centre[0], centre[1] - capsule.height / 2, centre[2]], [0, 1, 0], up); // up its axis\n279\t  if (ceiling && !oneWayOf(w).has(ceiling.body)) {\n280\t    const given = vec(at, 'placeActor(at)');\n281\t    const place = [given.x, given.y, given.z].map((v) => Math.round(v * 100) / 100).join(', ');\n282\t    const [over, tall] = [(offset + capsule.radius + ceiling.distance).toFixed(2), (middle + 2 * capsule.radius).toFixed(2)]; // prettier-ignore\n283\t    throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(at)', value: `[${place}], where a ceiling ${over} m over its feet cuts its ${options.crouch ? 'crouched' : 'standing'} hull, ${tall} m tall (it would sink through the floor)`, expected: motion && !options.crouch ? 'a place with headroom, or { crouch: true } under a low ceiling' : 'a place with headroom' }); // prettier-ignore\n284\t  }\n285\t  matchHull(physics, actor.body, actor.character, capsule.height, { air: false, tuck: false });\n286\t  physics.setBody(actor.body, { position: centre, velocity: [0, 0, 0] });\n287\t  const { x, y, z } = feetOf(physics, actor.body, actor.character);\n288\t  Object.assign(actor, createCharacterState(), { yaw: yaw ?? actor.yaw, x, y, z });\n289\t  if (motion) Object.assign(motion, createMotionState(), { holstered: motion.holstered }, options.crouch ? { stance: 'crouch', duck: 'ducked' } : {}); // prettier-ignore\n290\t}\n291\t\n292\t/** The bodies of the one-way platforms (the component `oneWay`). */\n293\tconst oneWayOf = (w: World) => new Set((w.query('oneWay') as unknown as ActorComponents[]).map((e) => e.oneWay.body));\n294\t\n295\t/** Removes an actor and its body (its ragdoll's parts too, engine/sim/ragdolls.ts). */\n296\texport function removeActor<C extends object>(world: World<C>, id: number): void {\n297\t  const w = world as unknown as World;\n298\t  const actor = (w.get(id) as Partial<ActorComponents> | undefined)?.actor;\n299\t  if (!actor)\n300\t    throw codeError('SIM_BAD_ARGUMENT', { where: 'removeActor(w, id)', value: String(id), expected: 'an actor’s id' });\n301\t  const physics = physicsOf(w);\n302\t  physics.removeBody(actor.body);\n303\t  const parts = (w.get(id) as { ragdoll?: { bodies: number[] } }).ragdoll?.bodies ?? []; // its ragdoll's, if it lies so\n304\t  for (const body of parts) if (physics.hasBody(body)) physics.removeBody(body);\n305\t  w.despawn(id);\n306\t}\n307\t\n308\t/** The system `actors`: every actor's tick, in id order. */\n309\tfunction moveActors(w: World, intents: Intents): void {\n310\t  const physics = physicsOf(w);\n311\t  const gravity = w.settings.get('physics.characterGravity') as number;\n312\t  const worldGravity = w.settings.get('physics.gravity') as number;\n313\t  const oneWay = oneWayOf(w);\n314\t  const tuning = movementOverrides((path) => w.settings.get(path));\n315\t  const rides = ridesOf(w);\n316\t  const controls = { holdSprint: w.settings.get('input.sprint') === 'hold', toggleCrouch: w.settings.get('input.crouch') === 'toggle' }; // prettier-ignore\n317\t  for (const e of w.query('actor') as unknown as (ActorComponents & { id: number })[]) {\n318\t    if ((e as { ragdoll?: unknown }).ragdoll) continue; // its ragdoll moves it (engine/sim/ragdolls.ts)\n319\t    const { actor, motion } = e;\n320\t    const wants = intentsOf(actor, intents);\n321\t    const input: CharacterInput = {\n322\t      move: wants.move,\n323\t      jump: held(wants, 'jump'),\n324\t      jumpPressed: pressed(wants, 'jump'),\n325\t      dashPressed: pressed(wants, 'dash'),\n326\t      ...(motion ? motionInput(actor, wants, controls, (e as { interactor?: { usedAt: number } }).interactor?.usedAt === w.tick, ((e as { melee?: { move: string } }).melee?.move ?? '') !== '', ((e as { weapons?: { slot: number } }).weapons?.slot ?? -1) >= 0 && held(wants, 'aim')) : {}), // prettier-ignore\n327\t    };\n328\t    const character = motion ? tuneCharacter(actor.character, tuning) : actor.character;\n329\t    const step = stepCharacter(physics, actor.body, character, actor, input, { dt: w.dt, gravity, worldGravity, oneWay, rides }, motion); // prettier-ignore\n330\t    const at = [actor.x, actor.y, actor.z]; // its feet as the step began\n331\t    if (step.jumped) w.emit('jump', { id: e.id, at });\n332\t    if (step.landed) w.emit('land', { id: e.id, speed: step.landed, at });\n333\t    if (step.dashed) w.emit('dash', { id: e.id, at });\n334\t    if (step.launched) w.emit('launch', { id: e.id, at });\n335\t    if (step.entered) w.emit('move', { id: e.id, what: step.entered, at });\n336\t  }\n337\t}\n338\t\n339\t/** The system `actors.readback`: where each actor's feet are, after the world stepped. */\n340\tfunction readActors(w: World): void {\n341\t  const physics = physicsOf(w);\n342\t  for (const { actor } of w.query('actor') as unknown as ActorComponents[]) {\n343\t    const feet = feetOf(physics, actor.body, actor.character);\n344\t    [actor.x, actor.y, actor.z] = [feet.x, feet.y, feet.z];\n345\t  }\n346\t}\n347\t"}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"47bd6424-b7f3-4d63-9754-5992a30dd595","timestamp":"2026-11-05T04:34:16.730Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/engine/sim/actors.ts","content":"/**\n * @file Actors (PLAN.md WP 3.2; WP 3.7 adds the animator): entities that walk, jump and dash through the character\n * controller (engine/physics/character.ts). `spawnActor(w, { at, character, player })` adds a capsule body to the\n * scene's physics world and spawns an entity with the component `actor` (its body, settings, intents, feet and the\n * controller's state), so the sim hashes, captures and restores all of it.\n *\n * The step (shardfall's order): movers set their velocities (`intents`, `ai`), the system `actors` moves every actor in\n * id order (`anim`), the world steps (`physics`), and `actors.readback` copies the feet into `x`, `y`, `z`\n * (`readback`). A player actor reads the step's intents: `move`, `jump` (held, pressed) and `dash` (pressed); any other\n * the intents its AI writes into `actor.intents`, its presses from the edges of `b`. Events: `jump` `{ id, at }`,\n * `land` `{ id, speed, at }`, `dash` `{ id, at }`, `at` its feet as the step began (where it happened, however late a\n * sound map reads it). Gravity: `physics.characterGravity` unless the settings name one; the weight on dynamic floors\n * uses `physics.gravity`. The component `oneWay` makes its body a one-way platform. WP 3.7: `anim` adds the component\n * `animator`, stepped by `actors.anim` after `actors` (its `reactions` first, WP 7.8) and, with `preciseHits`, posed by\n * `actors.pose` after `actors.readback` (engine/sim/actorAnim.ts) (`footstep` `{ id, side, speed, at, gait? }`, the gait its movement model's).\n * WP 8.9: `body` adds the component `puppet` (the body drawn), `clips` the clip layer (engine/sim/actorClips.ts).\n * WP 13.3 and 13.7: an actor on a movement model also holds `motion`, the model's state, and reads its buttons, view\n * and rides (`spawnActor` says which), and tells the move it enters (`move` `{ id, what, at }`, WP 13.22); launchers\n * set off any actor (`launch` `{ id, at }`). WP 13.9: a player's sprint and crouch work as `input.sprint` and\n * `input.crouch` say (held, or toggled by a press); WP 13.10: an animated actor's duck is its animator's pose `crouch`.\n *\n * Invariants: systems are added once per world, on the first (animated) spawn; all an actor remembers is in its\n * components (the sim's animators are loaded from them). Despawning leaves the body; `removeActor` removes both.\n * Carried from shardfall@fa2dab6 (`pavilion-lite/src/character.rs:179-399`: the order of a step, the events).\n * @example\n * import { createCharacter } from '../physics/character';\n * import { physicsOf } from '../physics/binding';\n * import { startScene, defineScene } from './scene';\n * defineScene('walk', {\n *   physics: true,\n *   setup(w) {\n *     physicsOf(w).addBody({ type: 'fixed', colliders: [{ shape: { type: 'box', size: [40, 1, 40] }, position: [0, -0.5, 0] }] });\n *     spawnActor(w, { at: [0, 0, 0], character: createCharacter({ speed: 5 }) });\n *   },\n * });\n * const { world } = startScene('walk');\n * for (let i = 0; i < 60; i++) world.step({ move: [1, 0] });\n * world.query('actor')[0].actor.x; // 4.69: a second's walk east at 5 m/s, from standing\n * @see engine/sim/actors.test.ts\n */\nimport { ANIMATOR_FIELDS, type AnimatorData, type AnimatorOptions } from '../anim/character';\nimport type { AnimatorInput } from '../anim/states';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { defineSettings } from '../core/settings';\nimport { held, pressed, type Intents } from '../input/intents';\nimport {\n  addCharacter,\n  bodyAt,\n  CHARACTER_SETTINGS,\n  CHARACTER_STATE_FIELDS,\n  createCharacter,\n  createCharacterState,\n  feetOf,\n  stepCharacter,\n  type Character,\n  type CharacterInput,\n  type CharacterState,\n} from '../physics/character';\nimport { matchHull } from '../physics/hull';\nimport { hullFor } from '../physics/movement/crouch';\nimport { createMotionState, MOTION_FIELDS, type MotionState } from '../physics/movement/model';\nimport { MOVEMENT_SETTINGS, movementOverrides, tuneCharacter } from '../physics/movement/settings';\nimport { physicsOf } from '../physics/binding';\nimport { vec, type Vec3Like } from '../physics/queries';\nimport { clipsFor, defineClipKinds, type ClipsSpec } from './actorClips';\nimport { poseAnimators, stepAnimators } from './actorAnim';\nimport { intentsOf, motionInput } from './actorInput';\nimport { defineActionKinds } from './actorActions';\nimport { defineReactionKinds } from './reactions';\nimport { defineRideKinds, ridesOf } from './rides';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The component `actor`'s own fields, before the controller's state. */\nconst ACTOR_FIELDS = {\n  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world.' },\n  player: { type: 'boolean', default: true, description: 'Whether it reads the step’s intents (else actor.intents).' },\n  character: { type: 'any', default: createCharacter(), description: 'Its settings: what createCharacter returned.' },\n  intents: { type: 'any', default: {}, description: 'What its AI wants this step (move, b, p), when not a player.' },\n  held: { type: 'array', default: [], description: 'The buttons its AI held last step, for presses.' },\n  x: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, east.' },\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, up.' },\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where its feet are, south.' },\n} as const;\n\n/** The component `actor`: an entity the character controller moves. */\nexport interface ActorComponent extends CharacterState {\n  body: number;\n  player: boolean;\n  character: Character;\n  intents: Partial<Intents>;\n  held: string[];\n  x: number;\n  y: number;\n  z: number;\n}\n\n/** The component `animator`: an actor's character animator as plain data, and what its game code tells its body. */\nexport interface AnimatorComponent extends AnimatorData {\n  /** The body states its game code holds on (a pose, a stance, a flinch…); the controller's join them each step. */\n  states: Partial<AnimatorInput>;\n}\n\n/** The component `puppet`: the body an actor is drawn as (engine/gfx/puppets/actors.ts), when not the humanoid. */\nexport interface PuppetComponent {\n  body: string;\n}\n\n/** The components this module reads: `actor`, `animator`, `puppet`, `motion` (the shooter model's) and `oneWay`. */\nexport type ActorComponents = {\n  actor: ActorComponent;\n  animator: AnimatorComponent;\n  puppet: PuppetComponent;\n  motion: MotionState;\n  oneWay: { body: number };\n};\n\n/**\n * How a player's sprint and crouch buttons work, as a shooter's options set them (WP 13.9, docs/PLAYGROUND.md §3.3):\n * recorded settings, since they change how the same presses move him, read by the system `actors` for player actors.\n */\nexport const CONTROL_SETTING_FIELDS = {\n  'input.sprint': {\n    type: 'string',\n    enum: ['toggle', 'hold'],\n    default: 'toggle',\n    description: \"The sprint button on the shooter model: toggle, Apex's sticky sprint (a press keeps it on while the player moves on); hold, only while held. Recorded: it changes how a player moves.\", // prettier-ignore\n  },\n  'input.crouch': {\n    type: 'string',\n    enum: ['hold', 'toggle'],\n    default: 'hold',\n    description: 'The crouch button on the shooter model: hold, crouched while held; toggle, a press crouches until pressed again (a jump or a sprint stands it up). Recorded: it changes how a player moves.', // prettier-ignore\n  },\n} as const;\n\n/**\n * Declares the components `actor`, `animator`, `puppet`, `clips` (engine/sim/actorClips.ts), `oneWay`, `reactions` and\n * `secondary` (engine/sim/reactions.ts), the setting `physics.characterGravity` and the controls' `input.sprint` and\n * `input.crouch` on `registry`.\n */\nexport function defineActorKinds(registry: Registry = sharedRegistry): void {\n  defineReactionKinds(registry);\n  defineActionKinds(registry);\n  defineRideKinds(registry);\n  if (!registry.kinds().includes('setting') || !registry.has('setting', 'physics.characterGravity')) {\n    defineSettings(CHARACTER_SETTINGS, registry);\n  }\n  if (!registry.has('setting', 'movement.turnRate')) defineSettings(MOVEMENT_SETTINGS, registry);\n  if (!registry.has('setting', 'input.sprint')) defineSettings(CONTROL_SETTING_FIELDS, registry);\n  if (!registry.kinds().includes('component') || !registry.has('component', 'animator')) {\n    const states = { type: 'object', default: {}, description: 'The body states its game code holds on.' } as const;\n    const description = 'A character animator (engine/anim/character.ts): what it keeps, and what its body is told.';\n    defineComponent('animator', { description, fields: { ...ANIMATOR_FIELDS, states } }, registry);\n  }\n  defineClipKinds(registry);\n  if (!registry.has('component', 'puppet')) {\n    const body = {\n      type: 'string',\n      default: 'body:humanoid',\n      description: 'Its body’s id (the body grammar’s).',\n    } as const;\n    defineComponent('puppet', { description: 'The body an actor is drawn as, when not the humanoid.', fields: { body } }, registry); // prettier-ignore\n  }\n  if (registry.has('component', 'actor')) return;\n  defineComponent(\n    'actor',\n    {\n      description: 'An entity the character controller moves.',\n      fields: { ...ACTOR_FIELDS, ...CHARACTER_STATE_FIELDS },\n    },\n    registry,\n  );\n  defineComponent(\n    'motion',\n    {\n      description: 'An actor’s state in the shooter movement model (engine/physics/movement/model.ts).',\n      fields: MOTION_FIELDS,\n    },\n    registry,\n  );\n  defineComponent(\n    'oneWay',\n    {\n      description: 'Makes a body a one-way platform: solid only to an actor whose feet are at or above its top.',\n      fields: { body: { type: 'integer', default: -1, minimum: -1, description: 'The platform’s body.' } },\n    },\n    registry,\n  );\n}\ndefineActorKinds();\n\n/** What `spawnActor` takes. */\nexport interface ActorSpec {\n  /** Where its feet go: on the ground below them (it starts just above, outside the skin). */\n  at: Vec3Like;\n  /** Its settings (createCharacter). */\n  character: Character;\n  /** Whether it reads the step's intents (true); false: its AI writes `actor.intents`. */\n  player?: boolean;\n  /** Where it faces (rad; forward = (sin yaw, 0, cos yaw)). */\n  yaw?: number;\n  /** Its character animator's make (engine/anim/character.ts); none when absent. */\n  anim?: Pick<AnimatorOptions, 'build' | 'weapon' | 'preciseHits'>;\n  /** The body it is drawn as (`body:mannequin`), with `anim`; the neutral humanoid when absent. */\n  body?: string;\n  /** With `anim`, the clip layer in its animator, playing from these sets (engine/sim/actorClips.ts); none when absent. */\n  clips?: ClipsSpec;\n  /** With a movement model, whether it starts with no weapon out (true: the model's holstered speeds). */\n  holstered?: boolean;\n  /**\n   * Further components it spawns with, by name (its `reactions`, its `secondary`: engine/sim/reactions.ts), so they\n   * are there from its first step, and a page's first warm-up builds what they draw.\n   */\n  components?: Readonly<Record<string, object>>;\n}\n\n/**\n * Spawns an actor in a scene with a physics world: its body, and an entity with the component `actor`. Returns the id.\n * An actor on a movement model (engine/physics/movement/, WP 13.3) also holds `motion`, the model's state (holstered\n * unless spawned `holstered: false`), and reads `sprint` (held, pressed), `walk` and `crouch` (held), `crouchToggle`\n * (pressed), the view from `look`, the keys' frame from `cam` (else `look`) and what it faces from `aim` (else\n * `look`), under the live `movement.*` settings (WP 13.4); WP 13.7: the look's pitch and `interact` (pressed) too,\n * riding the scene's ziplines and ladders (engine/sim/rides.ts); WP 13.9: a player's sprint held only while held with\n * `input.sprint` at `hold`, and his crouch toggled by its press with `input.crouch` at `toggle`.\n */\nexport function spawnActor<C extends object>(world: World<C>, spec: ActorSpec): number {\n  const w = world as unknown as World;\n  const physics = physicsOf(w);\n  const body = addCharacter(physics, spec.character, spec.at);\n  const { x, y, z } = feetOf(physics, body, spec.character);\n  const state = { ...createCharacterState(), yaw: spec.yaw ?? 0 };\n  if (!w.systems.has('actors')) {\n    w.systems.add('actors', moveActors, { phase: 'anim' });\n    w.systems.add('actors.readback', readActors, { phase: 'readback' });\n  }\n  const actor = { body, player: spec.player ?? true, character: spec.character, x, y, z, ...state };\n  const motion = spec.character.movement ? { motion: { ...createMotionState(), holstered: spec.holstered ?? true } } : {}; // prettier-ignore\n  if (!spec.anim) return w.spawn({ ...spec.components, ...motion, actor });\n  if (!w.systems.has('actors.anim')) {\n    w.systems.add('actors.anim', stepAnimators, { phase: 'anim' });\n    w.systems.add('actors.pose', poseAnimators, { phase: 'readback' });\n  }\n  const { build = 'build:chibi', weapon = 'none', preciseHits = false } = spec.anim;\n  const animator = { build: typeof build === 'string' ? build : build.id, weapon, preciseHits };\n  const puppet = spec.body !== undefined ? { body: spec.body } : undefined;\n  const clips = spec.clips && (clipsFor(w, spec.clips, animator.build) as unknown as Record<string, unknown>);\n  return w.spawn({ ...spec.components, ...motion, actor, animator, puppet, clips });\n}\n\n/**\n * Puts actor `id` at `at`, its feet on the ground below (just above, outside the skin, as a spawn stands it), facing\n * `yaw` (its own when absent), at rest: no velocity, no jump, dash or landing pending, standing (its hull too); on the\n * shooter model its motion state starts again, holstered as it was, or ducked with `crouch`, its hull crouched from its\n * next step on and kept so until it has headroom, for a place no standing hull fits (a crawlspace). A place where the\n * level (the queries' as of the last step, one-way platforms aside) stands over its feet lower than its hull's top, up\n * its axis, throws `SIM_BAD_ARGUMENT` before it moves anything: the body would sink through the floor. For a scene's dev actions: a feel\n * course places its player where it measures (engine/dev/feel/course.ts).\n */\nexport function placeActor<C extends object>(\n  world: World<C>,\n  id: number,\n  at: Vec3Like,\n  yaw?: number,\n  options: { crouch?: boolean } = {},\n): void {\n  const w = world as unknown as World;\n  const e = w.get(id) as Partial<ActorComponents> | undefined;\n  if (!e?.actor) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(w, id)', value: String(id), expected: 'an actor’s id' }); // prettier-ignore\n  const { actor, motion } = e;\n  if (options.crouch && !motion) throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(options.crouch)', value: `true for actor ${id}, on no movement model`, expected: 'no crouch: only an actor on a movement model (its component motion) crouches' }); // prettier-ignore\n  const physics = physicsOf(w);\n  const { offset, capsule } = actor.character;\n  const centre = bodyAt(actor.character, at, 'placeActor(at)'); // the standing hull's, its feet just over `at`\n  const middle = motion && options.crouch ? hullFor(actor.character, { ...motion, stance: 'crouch' }) : capsule.height; // prettier-ignore\n  const up = { maxDistance: middle + capsule.radius, exclude: actor.body, groups: 'world' } as const;\n  const ceiling = physics.raycast([centre[0], centre[1] - capsule.height / 2, centre[2]], [0, 1, 0], up); // up its axis\n  if (ceiling && !oneWayOf(w).has(ceiling.body)) {\n    const given = vec(at, 'placeActor(at)');\n    const place = [given.x, given.y, given.z].map((v) => Math.round(v * 100) / 100).join(', ');\n    const [over, tall] = [(offset + capsule.radius + ceiling.distance).toFixed(2), (middle + 2 * capsule.radius).toFixed(2)]; // prettier-ignore\n    throw codeError('SIM_BAD_ARGUMENT', { where: 'placeActor(at)', value: `[${place}], where a ceiling ${over} m over its feet cuts its ${options.crouch ? 'crouched' : 'standing'} hull, ${tall} m tall (it would sink through the floor)`, expected: motion && !options.crouch ? 'a place with headroom, or { crouch: true } under a low ceiling' : 'a place with headroom' }); // prettier-ignore\n  }\n  matchHull(physics, actor.body, actor.character, capsule.height, { air: false, tuck: false });\n  physics.setBody(actor.body, { position: centre, velocity: [0, 0, 0] });\n  const { x, y, z } = feetOf(physics, actor.body, actor.character);\n  Object.assign(actor, createCharacterState(), { yaw: yaw ?? actor.yaw, x, y, z });\n  if (motion) Object.assign(motion, createMotionState(), { holstered: motion.holstered }, options.crouch ? { stance: 'crouch', duck: 'ducked' } : {}); // prettier-ignore\n}\n\n/** The bodies of the one-way platforms (the component `oneWay`). */\nconst oneWayOf = (w: World) => new Set((w.query('oneWay') as unknown as ActorComponents[]).map((e) => e.oneWay.body));\n\n/** Removes an actor and its body (its ragdoll's parts too, engine/sim/ragdolls.ts). */\nexport function removeActor<C extends object>(world: World<C>, id: number): void {\n  const w = world as unknown as World;\n  const actor = (w.get(id) as Partial<ActorComponents> | undefined)?.actor;\n  if (!actor)\n    throw codeError('SIM_BAD_ARGUMENT', { where: 'removeActor(w, id)', value: String(id), expected: 'an actor’s id' });\n  const physics = physicsOf(w);\n  physics.removeBody(actor.body);\n  const parts = (w.get(id) as { ragdoll?: { bodies: number[] } }).ragdoll?.bodies ?? []; // its ragdoll's, if it lies so\n  for (const body of parts) if (physics.hasBody(body)) physics.removeBody(body);\n  w.despawn(id);\n}\n\n/** The system `actors`: every actor's tick, in id order. */\nfunction moveActors(w: World, intents: Intents): void {\n  const physics = physicsOf(w);\n  const gravity = w.settings.get('physics.characterGravity') as number;\n  const worldGravity = w.settings.get('physics.gravity') as number;\n  const oneWay = oneWayOf(w);\n  const tuning = movementOverrides((path) => w.settings.get(path));\n  const rides = ridesOf(w);\n  const controls = { holdSprint: w.settings.get('input.sprint') === 'hold', toggleCrouch: w.settings.get('input.crouch') === 'toggle' }; // prettier-ignore\n  for (const e of w.query('actor') as unknown as (ActorComponents & { id: number })[]) {\n    if ((e as { ragdoll?: unknown }).ragdoll) continue; // its ragdoll moves it (engine/sim/ragdolls.ts)\n    const { actor, motion } = e;\n    const wants = intentsOf(actor, intents);\n    const input: CharacterInput = {\n      move: wants.move,\n      jump: held(wants, 'jump'),\n      jumpPressed: pressed(wants, 'jump'),\n      dashPressed: pressed(wants, 'dash'),\n      ...(motion ? motionInput(actor, wants, controls, (e as { interactor?: { usedAt: number } }).interactor?.usedAt === w.tick, ((e as { melee?: { move: string } }).melee?.move ?? '') !== '', ((e as { weapons?: { slot: number } }).weapons?.slot ?? -1) >= 0 && held(wants, 'aim')) : {}), // prettier-ignore\n    };\n    const character = motion ? tuneCharacter(actor.character, tuning) : actor.character;\n    const step = stepCharacter(physics, actor.body, character, actor, input, { dt: w.dt, gravity, worldGravity, oneWay, rides }, motion); // prettier-ignore\n    const at = [actor.x, actor.y, actor.z]; // its feet as the step began\n    if (step.jumped) w.emit('jump', { id: e.id, at });\n    if (step.landed) w.emit('land', { id: e.id, speed: step.landed, at });\n    if (step.dashed) w.emit('dash', { id: e.id, at });\n    if (step.launched) w.emit('launch', { id: e.id, at });\n    if (step.entered) w.emit('move', { id: e.id, what: step.entered, at });\n  }\n}\n\n/** The system `actors.readback`: where each actor's feet are, after the world stepped. */\nfunction readActors(w: World): void {\n  const physics = physicsOf(w);\n  for (const { actor } of w.query('actor') as unknown as ActorComponents[]) {\n    const feet = feetOf(physics, actor.body, actor.character);\n    [actor.x, actor.y, actor.z] = [feet.x, feet.y, feet.z];\n  }\n}\n","numLines":347,"startLine":1,"totalLines":347}},"tool_result_meta":[{"id":"toolu_013QrF72uPQAxFMwM1KTYVYY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
