{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XgQ3wLmfCpBjZtTVheuhox","type":"tool_result","content":"/**\n * @file The virtual device (PLAN.md WP 3.3, §8.3; doctrine: Agent-operable): input made by code instead of hands, the\n * one `__engine.input` drives (engine/input/devices/inspector.ts). It works in actions and intents, not codes:\n * `press('jump')` taps an action for the next step, `hold('sprint')` keeps one down, `axis('move', [0, 1])` pushes a\n * virtual stick (`[right, forward]`, turned by the camera as keys are), and `axis('cam' | 'look' | 'aim' | 'game:…',\n * value)` sets that intent outright; `null` lets go.\n *\n * `play(script, step)` runs a script one sim step at a time, each line `<steps> [move=x,y] [look=yaw,pitch] [cam=ψ]\n * [aim=x,y,z] [hold=a,b] [tap=a] [game:key=n]`, `#` comments (engine/input/script.ts): a line holds its values for\n * its steps on top of what the device holds, and taps on its first step. A page's input (engine/input/input.ts)\n * merges the device into every sample, so the same calls drive a running page.\n *\n * Invariants: taps last one step (the next sample or step played), holds and axes until changed. Values are checked\n * when given (`INPUT_BAD_VIRTUAL`): names are non-empty strings, `move` and `look` two finite numbers, `aim` three,\n * `cam` one, a custom key plain data. Intents come out unnormalized; the session normalizes them.\n *\n * @example\n * const pad = createVirtualDevice();\n * pad.axis('move', [0, 1]);\n * pad.press('jump');\n * virtualIntents(pad.take(), Math.PI / 2); // { move: [1, 6.1e-17], b: [], p: ['jump'] }: forward is +X at ψ = π/2\n * const steps: unknown[] = [];\n * playScript(pad, '2 hold=sprint tap=dash\\n1', (intents) => steps.push(intents));\n * steps.length; // 3: the second step holds sprint without the tap, the third holds nothing but the stick\n * @see engine/input/devices/virtual.test.ts\n */\nimport { codeError, defineCodes } from '../../core/log';\nimport { isPlainObject, show } from '../../core/schema';\nimport { fromCamera, type IntentValue } from '../intents';\nimport { names, numbers, parseScript, type ValueReader } from '../script';\n\n/** The codes this module raises, with their fixes. */\nexport const VIRTUAL_CODES = defineCodes('input', {\n  INPUT_BAD_VIRTUAL: {\n    template: '{what}: {problem}',\n    fix: \"press(action) and hold(action) take an action's name; axis takes 'move' or 'look' [x, y], 'aim' [x, y, z], 'cam' (rad) or a 'game:key' with plain data, and null to let go\",\n    doc: 'Raised by the virtual device (engine/input/devices/virtual.ts) and `__engine.input` for an empty action name, an unknown axis, or a value of the wrong shape.',\n  },\n});\n\n/** The axes the device can hold, and how many numbers each takes (0 for a custom key's plain data). */\nconst AXES: Readonly<Record<string, number>> = { move: 2, look: 2, aim: 3, cam: 1 };\n\n/** A namespaced custom intent key. */\nconst CUSTOM = /^[a-z][A-Za-z0-9]*:[A-Za-z0-9_.-]+$/;\n\n/** What the device holds for one step: actions held and tapped, and its axes by name. */\nexport interface VirtualSample {\n  held: string[];\n  taps: string[];\n  axes: Record<string, IntentValue>;\n}\n\n/** The virtual device. */\nexport interface VirtualDevice {\n  /** Taps `action`: pressed in the next step, not held. */\n  press(action: string): void;\n  /** Holds `action` down (`down = false` lets go). */\n  hold(action: string, down?: boolean): void;\n  /** Sets an axis: `move` `[right, forward]`, `look`, `aim`, `cam` or a `game:key`; `null` lets go. */\n  axis(name: string, value: unknown): void;\n  /** What the device holds now, without using up its taps. */\n  peek(): VirtualSample;\n  /** What the device holds for the next step; its taps are used up. */\n  take(): VirtualSample;\n  /** Whether anything was pressed, held or moved since the last `take` (prompts follow the last device used). */\n  readonly touched: boolean;\n  /** Lets go of everything. */\n  clear(): void;\n}\n\n/** Throws `INPUT_BAD_VIRTUAL` unless `name` is an action's name. */\nfunction checkAction(name: unknown, what: string): string {\n  if (typeof name !== 'string' || !name) throw codeError('INPUT_BAD_VIRTUAL', { what, problem: `${show(name)} is no action name` }); // prettier-ignore\n  return name;\n}\n\n/** Makes a virtual device, holding nothing. */\nexport function createVirtualDevice(): VirtualDevice {\n  const held = new Set<string>();\n====ANIMFIND\n--- zombie\nx anim: ok: 18 clips and 5 CMU takes match, the best shown\ncmu/Zombie_Walk_Loop  1.4s loop speed 68  walk zombie — A zombie's shamble: head and shoulders slumped forwar…\nmesh2motion/Zombie_Idle_Crouch  2.958s loop  zombie idle crouch — crouched low and swaying: a zombie at rest\nmesh2motion/Zombie_Walk_2  2.917s loop  zombie walk — a lurching zombie walk, deeply hunched, in place\nquaternius/Zombie_Idle_Loop  1.333s loop  zombie idle — hunched and swaying, arms hanging: a zombie at rest\nquaternius/Zombie_Walk_Fwd_Loop  1.333s loop speed 115  zombie walk — shambling, dragging zombie walk, in pla…\nmesh2motion/Zombie Yell  3.708s once  zombie emote — hunched, rears up and roars with the arms raised, then s…\nmesh2motion/Zombie_Rise  3.375s once  zombie getup — rises from the ground: lying, sits up stiffly and gets u…\nquaternius/Zombie_Scratch  1.8s once  zombie attack — lunges and claws down with both hands, then settles back\nstyle100/Zombie_Walk  1.633s loop speed 51  walk style — Arms in front like zombie\nstyle100_back/Zombie_WalkBack  1.167s loop speed 53  walk back style — Walking backward, zombie style: arms i…\nstyle100_backrun/Zombie_RunBack  0.767s loop speed 106  run back style — Running backward, zombie style: arms…\n--- shamble\nx anim: ok: 1 clip and 0 CMU takes match\ncmu/Zombie_Walk_Loop  1.4s loop speed 68  walk zombie — A zombie's shamble: head and shoulders slumped forwar…\nreport: out/anim/find-shamble/report.json\n--- stagger\nx anim: ok: 4 clips and 0 CMU takes match\nmesh2motion/Death_D  2.167s once  death — staggers back, the knees buckle, and falls onto the side, then lies…\nmesh2motion/Death_A  4.5s once  death — clutches the chest, staggers and sinks down onto the side, and lies s…\nquaternius/Death01  2.4s once  death — staggers and falls flat on the back\nquaternius/Death01_RM  2.4s once  death root-motion — staggers and falls flat on the back (travels)\nreport: out/anim/find-stagger/report.json\n--- kick\nx anim: ok: 32 clips and 31 CMU takes match, the best shown\ncmu/Jump_Kick  2.4s once  attack kick jump — A spinning jump kick (a tornado kick): a run-up, a leap that tur…\ncmu/Front_Kick  6s once  attack kick — A karate front kick (mae-geri): knee up, foot snapped straight ahead, …\ncmu/Roundhouse_Kick  6s once  attack kick — A karate roundhouse kick (mawashi-geri): the leg swings round in …\ncmu/Side_Kick  6s once  attack kick — A karate side kick (yoko-geri): the body turned side on, the heel drive…\nmesh2motion/Kick_Breach  1.833s once  attack unarmed kick interact — kicks a door in with a front kick, then …\nstyle100/Kick_Walk  2.167s loop speed 62  walk style — Kick with every step\nstyle100_back/Kick_WalkBack  2.5s loop speed 37  walk back style — Walking backward, kick style: kick with ev…\nstyle100_backrun/Kick_RunBack  1s loop speed 56  run back style — Running backward, kick style: kick with eve…\nstyle100_idle/Kick_Idle  2.5s loop  idle style — Standing, kick style: kick with every step\nstyle100_run/Kick_Run  0.933s loop speed 119  run style — Running, kick style: kick with every step\nstyle100_side/Kick_SideLeft  2.367s loop speed 21  sidestep left style — Sidestepping to the left, kick style…\n--- roundhouse\nx anim: ok: 2 clips and 0 CMU takes match\ncmu/Roundhouse_Kick  6s once  attack kick — A karate roundhouse kick (mawashi-geri): the leg swings round in …\ncmu/Jump_Kick  2.4s once  attack kick jump — A spinning jump kick (a tornado kick): a run-up, a leap that tur…\nreport: out/anim/find