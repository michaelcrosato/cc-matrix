{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WHe4nTak3GpTHeMvSAtS2k","type":"tool_result","content":"1\t/**\n2\t * @file Writes and checks the one-file playground, `playground.html` (tools/lib/oneFile.ts; ADR-0023 amendment 5): the\n3\t * playground as one self-contained HTML page, the file the engine is distributed and tested as.\n4\t *\n5\t * - `--write` builds it and writes it when it differs; commit it with the change that made it differ.\n6\t * - `--check` (the default) builds it and fails while the committed file differs (`HTML_STALE`, fixed by `--write`) or\n7\t *   loads anything from outside itself (`HTML_EXTERNAL`). The quick gate runs it (tools/cmd/ci.ts).\n8\t *\n9\t * The build takes about 11 s and gives the same bytes every time. The report's metrics give the file's size in bytes.\n10\t *\n11\t * Usage: node x html [--check | --write]. Exit 0 when the file is current (or was written), 1 otherwise, 2 on a\n12\t * usage error.\n13\t *\n14\t * @example\n15\t * // node x html --write   → x html: ok: wrote playground.html (6,912,709 bytes)\n16\t * // node x html --check   → x html: ok: playground.html current (6,912,709 bytes)\n17\t * @see tools/cmd/html.test.ts\n18\t */\n19\timport { existsSync, readFileSync, writeFileSync } from 'node:fs';\n20\timport { join } from 'node:path';\n21\timport { buildOneFile, externalRefs, ONE_FILE } from '../lib/oneFile';\n22\timport type { Finding } from '../lib/report';\n23\timport { UsageError, type Command, type CommandResult } from '../x';\n24\t\n25\t/** Builds the command; tests inject the build. */\n26\texport function createHtmlCommand(build: (root: string) => Promise<string> = buildOneFile): Command {\n27\t  return {\n28\t    usage: 'html [--check | --write]',\n29\t    options: { check: { type: 'boolean' }, write: { type: 'boolean' } },\n30\t    maxPositionals: 0,\n31\t    async run({ values, root }): Promise<CommandResult> {\n32\t      if (values.check && values.write) throw new UsageError('choose --check or --write, not both');\n33\t      const html = await build(root);\n34\t      const path = join(root, ONE_FILE);\n35\t      const current = existsSync(path) && readFileSync(path, 'utf8') === html;\n36\t      const failures: Finding[] = externalRefs(html).map((ref) => ({\n37\t        id: 'HTML_EXTERNAL',\n38\t        message: `the one file loads ${ref}, which a file opened from disk cannot reach: inline it (tools/lib/oneFile.ts) or import it from the page's code`, // prettier-ignore\n39\t        file: ONE_FILE,\n40\t      }));\n41\t      const bytes = Buffer.byteLength(html);\n42\t      const size = `${bytes.toLocaleString('en-US')} bytes`;\n43\t      if (values.write) {\n44\t        if (!current) writeFileSync(path, html);\n45\t        return {\n46\t          ok: failures.length === 0,\n47\t          summary: current ? `${ONE_FILE} was already current (${size})` : `wrote ${ONE_FILE} (${size})`,\n48\t          failures,\n49\t          metrics: { bytes, written: current ? 0 : 1 },\n50\t        };\n51\t      }\n52\t      if (!current) {\n53\t        failures.push({\n54\t          id: 'HTML_STALE',\n55\t          message: `${ONE_FILE} ${existsSync(path) ? 'differs from a build of its sources' : 'is missing'}: run node x html --write and commit it`, // prettier-ignore\n56\t          file: ONE_FILE,\n57\t        });\n58\t      }\n59\t      return {\n60\t        ok: failures.length === 0,\n61\t        summary: current ? `${ONE_FILE} current (${size})` : `${ONE_FILE} stale`,\n62\t        failures,\n63\t        metrics: { bytes, stale: current ? 0 : 1 },\n64\t      };\n65\t    },\n66\t  };\n67\t}\n68\t\n69\texport default createHtmlCommand();\n70\t"}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"b4b9abeb-3ff0-4d80-bf71-02bd2f186c0b","timestamp":"2026-11-05T04:25:54.380Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/my-3dge/tools/cmd/html.ts","content":"/**\n * @file Writes and checks the one-file playground, `playground.html` (tools/lib/oneFile.ts; ADR-0023 amendment 5): the\n * playground as one self-contained HTML page, the file the engine is distributed and tested as.\n *\n * - `--write` builds it and writes it when it differs; commit it with the change that made it differ.\n * - `--check` (the default) builds it and fails while the committed file differs (`HTML_STALE`, fixed by `--write`) or\n *   loads anything from outside itself (`HTML_EXTERNAL`). The quick gate runs it (tools/cmd/ci.ts).\n *\n * The build takes about 11 s and gives the same bytes every time. The report's metrics give the file's size in bytes.\n *\n * Usage: node x html [--check | --write]. Exit 0 when the file is current (or was written), 1 otherwise, 2 on a\n * usage error.\n *\n * @example\n * // node x html --write   → x html: ok: wrote playground.html (6,912,709 bytes)\n * // node x html --check   → x html: ok: playground.html current (6,912,709 bytes)\n * @see tools/cmd/html.test.ts\n */\nimport { existsSync, readFileSync, writeFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { buildOneFile, externalRefs, ONE_FILE } from '../lib/oneFile';\nimport type { Finding } from '../lib/report';\nimport { UsageError, type Command, type CommandResult } from '../x';\n\n/** Builds the command; tests inject the build. */\nexport function createHtmlCommand(build: (root: string) => Promise<string> = buildOneFile): Command {\n  return {\n    usage: 'html [--check | --write]',\n    options: { check: { type: 'boolean' }, write: { type: 'boolean' } },\n    maxPositionals: 0,\n    async run({ values, root }): Promise<CommandResult> {\n      if (values.check && values.write) throw new UsageError('choose --check or --write, not both');\n      const html = await build(root);\n      const path = join(root, ONE_FILE);\n      const current = existsSync(path) && readFileSync(path, 'utf8') === html;\n      const failures: Finding[] = externalRefs(html).map((ref) => ({\n        id: 'HTML_EXTERNAL',\n        message: `the one file loads ${ref}, which a file opened from disk cannot reach: inline it (tools/lib/oneFile.ts) or import it from the page's code`, // prettier-ignore\n        file: ONE_FILE,\n      }));\n      const bytes = Buffer.byteLength(html);\n      const size = `${bytes.toLocaleString('en-US')} bytes`;\n      if (values.write) {\n        if (!current) writeFileSync(path, html);\n        return {\n          ok: failures.length === 0,\n          summary: current ? `${ONE_FILE} was already current (${size})` : `wrote ${ONE_FILE} (${size})`,\n          failures,\n          metrics: { bytes, written: current ? 0 : 1 },\n        };\n      }\n      if (!current) {\n        failures.push({\n          id: 'HTML_STALE',\n          message: `${ONE_FILE} ${existsSync(path) ? 'differs from a build of its sources' : 'is missing'}: run node x html --write and commit it`, // prettier-ignore\n          file: ONE_FILE,\n        });\n      }\n      return {\n        ok: failures.length === 0,\n        summary: current ? `${ONE_FILE} current (${size})` : `${ONE_FILE} stale`,\n        failures,\n        metrics: { bytes, stale: current ? 0 : 1 },\n      };\n    },\n  };\n}\n\nexport default createHtmlCommand();\n","numLines":70,"startLine":1,"totalLines":70}},"tool_result_meta":[{"id":"toolu_01WHe4nTak3GpTHeMvSAtS2k","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LZgDqwde7EUxj1eH4LmEDi","type":"tool_result","content":"/**\n * @file Chromium for the tools and the e2e fixture, through Playwright: the launch options `playwright.config.ts`\n * also uses, the init script every page gets before its own scripts run (a virtual clock, seeded randomness and a\n * WebGPU probe), and the console and the page's errors collected, mapped to `.ts` files and lines\n * (tools/lib/pageErrors.ts) (§8.1, §8.8).\n *\n * Invariants: WebGPU runs on SwiftShader with shardfall's flags (`WEBGPU_FLAGS`), so pages present to their real\n * canvas. The clock only moves on `__clock.tick(n)`, 1/60 s per frame, and `Math.random` and `__clock.rng(name)`\n * are seeded, so a run repeats exactly. `__gpu` counts what WebGPU really did (adapters, devices, configured\n * canvases, queue submits, lost devices); it is measured, never reported by the page. `__gpuIdle()` resolves once\n * every queue the page submitted to has finished its work (the e2e harness waits on it at each test's end).\n *\n * @example\n * import { chromium } from '@playwright/test';\n * const browser = await chromium.launch(launchOptions());\n * const page = await browser.newPage({ viewport: VIEWPORT });\n * const watch = await preparePage(page, { seed: 1 }); // the virtual clock and the console, before the first goto\n * await browser.close();\n * @see tests/e2e/harness.spec.ts\n */\n/// <reference types=\"@webgpu/types\" />\nimport { existsSync } from 'node:fs';\nimport { homedir } from 'node:os';\nimport { join } from 'node:path';\nimport { chromium, type Browser, type LaunchOptions, type Page } from '@playwright/test';\nimport { fnv1a } from './hash';\nimport { mapPageError, type PageError } from './pageErrors';\n\n/** Shardfall's WebGPU flags (PLAN.md §8.8): SwiftShader through Vulkan, presenting to the page's own canvas. */\nexport const WEBGPU_FLAGS: readonly string[] = [\n  '--enable-unsafe-webgpu',\n  '--enable-features=Vulkan',\n  '--use-vulkan=swiftshader',\n  '--use-angle=swiftshader',\n];\n\n/** The container's Chromium (153 since 2026-10-22); `$CHROMIUM_PATH` overrides it. Nothing runs `playwright install`. */\nexport const DEFAULT_CHROMIUM = '/opt/pw-browsers/chromium';\n\n/** The platform's Chromium release (tools/deps.json), which scripts/setup.sh fetches where the container's is absent. */\nexport const CHROMIUM_VERSION = '153.0.8010.12';\n\n/** Where scripts/setup.sh keeps Chrome for Testing `CHROMIUM_VERSION` on a machine without `DEFAULT_CHROMIUM`. */\nexport function cachedChromium(env: Record<string, string | undefined> = process.env): string {\n  return join(env.HOME || homedir(), '.cache', 'my3dge', `chrome-${CHROMIUM_VERSION}`, 'chrome-linux64', 'chrome');\n}\n\n/** The viewport every harness page gets. */\nexport const VIEWPORT = { width: 960, height: 540 } as const;\n\n/**\n * The Chromium executable: `$CHROMIUM_PATH`; else `DEFAULT_CHROMIUM` when it exists; else `cachedChromium()` when it\n * exists (a machine outside the container, after scripts/setup.sh); else `DEFAULT_CHROMIUM`, so the launch error names\n * the platform's path. No shell state is needed, so every worktree resolves the same browser.\n */\nexport function chromiumPath(\n  env: Record<string, string | undefined> = process.env,\n  exists: (path: string) => boolean = existsSync,\n): string {\n  if (env.CHROMIUM_PATH) return env.CHROMIUM_PATH;\n  if (exists(DEFAULT_CHROMIUM)) return DEFAULT_CHROMIUM;\n  const cached = cachedChromium(env);\n  return exists(cached) ? cached : DEFAULT_CHROMIUM;\n}\n\n/** Playwright's launch options for WebGPU on this platform, shared by `playwright.config.ts` and the `x` commands. */\nexport function launchOptions(env: Record<string, string | undefined> = process.env): LaunchOptions {\n  return { executablePath: chromiumPath(env), args: [...WEBGPU_FLAGS] };\n}\n\n/** Launches the platform's Chromium with WebGPU, for `x` commands that open pages. */\nexport function launchBrowser(): Promise<Browser> {\n  return chromium.launch(launchOptions());\n}\n\n/** The browser part of a report's runtime: `153.0.8010.12` → `chromium153`. */\nexport function browserRuntime(version: string): string {\n  return `chromium${version.split('.')[0]}`;\n}\n\n/** The page's virtual clock and seeded streams, installed as `window.__clock`. */\nexport interface VirtualClock {\n  /** The seed of `Math.random`; named streams derive from it. */\n  seed: number;\n  /** Display frames run so far by `tick`. */\n  frames: number;\n  /** The virtual time `performance.now()` returns, in milliseconds (1000 at load). */\n  now(): number;\n  /** Runs `n` display frames: each advances time by 1/60 s, then runs the pending animation-frame callbacks. */\n  tick(n?: number): void;\n----\n/**\n * @file Vite's settings (the dev server and the build) and Vitest's (T1), in one file as Vitest expects (PLAN.md\n * §6.10, WPs 0.2 and 0.12).\n *\n * Invariants: every lab page (`labs/<name>/index.html`) and test page (`tests/pages/<name>.html`) is served as its\n * own page, and a missing page is a 404 (`appType: 'mpa'`). A bare `three` resolves to `three/webgpu`, as three.js's\n * WebGPU examples map it. The runtime dependencies are pre-bundled at startup, so a first page load never\n * re-optimizes and reloads (§4.7). The server listens on 127.0.0.1 and `$PORT` (default 5173). Every test file runs\n * the advice trap first (tests/setup/adviceTrap.ts), and `vitest --changed` reruns everything on the files that\n * tools/lib/tiers.ts's `T1_FULL` names.\n *\n * The build (`npm run build`) writes dist/ from the landing page (the root's\n * `index.html`) and every `labs/<name>/index.html`; test pages never ship (`harness.html` throws on purpose). In a game\n * made from the engine (engine-lock.json at its root, ADR-0024) the box is the worked example: served, never built. A page\n * ships only what it imports, never a `fetch()` of a repository path (§6.3). Nothing here needs the network, a\n * browser, the source checkouts or an `x` command: the build and Vitest both read this file. The one-file\n * playground (playground.html, tools/lib/oneFile.ts) is built apart, with this file's alias. The reference to\n * `vitest/config`, which adds `test` to Vite's config type, is kept in the declaration tsc -b emits (`preserve`), so\n * the tests' project, which sees this file through it, knows `config.test` (Vitest 4's main types no longer add it).\n *\n * @see tools/lib/vite.test.ts\n */\n/// <reference types=\"vitest/config\" preserve=\"true\" />\nimport { existsSync, globSync } from 'node:fs';\nimport { availableParallelism } from 'node:os';\nimport { dirname, join } from 'node:path';\nimport { defineConfig } from 'vite';\nimport { vitestRerunTriggers } from './tools/lib/tiers';\n\n/** The dev server's port: `$PORT` (each ultracode lane sets its own), else 5173. */\nconst PORT = Number(process.env.PORT) || 5173;\n\n/** The repository root: this file's directory. */\nconst ROOT = import.meta.dirname;\n\n/** Whether this is a game made from the engine (tools/game/new-game.mjs), not the engine's own repository. */\nconst GAME = existsSync(join(ROOT, 'engine-lock.json'));\n\n/** The pages a build ships, as absolute paths by entry name: `index` (the landing page), then `labs/<name>`. */\nconst PAGES = Object.fromEntries(\n  ['index.html', ...globSync('labs/*/index.html', { cwd: ROOT }).sort()]\n    .filter((page) => !(GAME && page.startsWith('labs/box/')))\n    .map((page) => [dirname(page) === '.' ? 'index' : dirname(page), join(ROOT, page)]),\n);\n\nexport default defineConfig({\n  appType: 'mpa',\n  resolve: {\n    alias: [{ find: /^three$/, replacement: 'three/webgpu' }],\n  },\n  optimizeDeps: {\n    // The pages Vite scans for imports; the default (every *.html under the root) would crawl .cache/.\n    entries: ['index.html', 'labs/*/index.html', 'tests/pages/*.html'],\n    // Every runtime dependency of package.json, by the entry points pages import (tools/lib/vite.test.ts checks it).\n    include: [\n      'three/webgpu',\n      'three/tsl',\n      '@dimforge/rapier3d-simd-compat',\n      '@stdlib/math-base-special-sin',\n      '@stdlib/math-base-special-cos',\n      '@stdlib/math-base-special-pow',\n    ],\n  },\n  build: {\n    rollupOptions: { input: PAGES },\n    // In KB. Rapier passes its WASM to init() inline, as base64 (PLAN.md §4.8), so a page that imports it gets one\n    // large chunk (about 5.4 MB, 1.86 MB gzipped) and no .wasm file: the default 500 KB would warn on every build.\n    chunkSizeWarningLimit: 8000,\n  },\n  server: {\n    host: '127.0.0.1',\n    port: PORT,\n    strictPort: true,\n    watch: { ignored: ['**/.cache/**', '**/out/**', '**/dist/**', '**/test-results/**', '**/.claude/worktrees/**'] },\n  },\n  test: {\n    environment: 'node',\n    include: ['**/*.test.ts'],\n    exclude: [\n      '**/node_modules/**',\n      '.cache/**',\n      'out/**',\n      'dist/**',\n      'test-results/**',\n      'tests/e2e/**',\n      '.claude/worktrees/**',\n    ],\n    reporters: ['dot', 'json'],\n    outputFile: { json: 'out/test/report.json' },\n    setupFiles: ['tests/setup/adviceTrap.ts'],\n    // Many tool tests spawn node, tsx, git or Chromium; on the 4-core platform with parallel lanes a 5 s default\n    // times out under load while the test itself is sound. Timeouts bound hangs; they assert nothing.\n    testTimeout: 30_000,\n    hookTimeout: 60_000,\n    // One worker per core, not Vitest's default of one fewer: the tool tests wait on the children they spawn, and the\n    // spare core went idle. Measured on the 4-core platform: npm test 41 s with 3 workers, 36 s with 4, 36 s with 5\n    // (ADR-0014 amendment 7).\n    maxWorkers: availableParallelism(),\n    forceRerunTriggers: vitestRerunTriggers(),\n  },\n});\n---\n2: * @file The engine in a page (PLAN.md §6.4, §6.9, §8.3, WP 2.7): `createEngine({ canvas, scenes, levels })` registers\n3: * the levels the page imported as text, reads the page's routes (engine/app/routes.ts: `?scene ?seed ?cam ?replay`,\n5: * scene as a recorded run with its view (engine/app/headless.ts, engine/app/view.ts), publishes the run's inspector\n23: * in real time from step 0 (without `?scene`, in its own scene if the page has it), then hands back to the devices.\n37: * // const engine = await createEngine({ canvas, scenes: ['box:room'] }); // labs/box/main.ts\n109:  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\n110:  scenes: readonly string[];\n112:   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n122:  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n149:  /** The inspector, also `window.__engine`; null when the scene could not start. */\n157:  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\n169:/** Reads the replay `name` of `replays` before the run starts, so its scene can start (see the file comment). */\n221:  const parts: PageParts = { run: null, gfx: null, post: null, look: null, input: null, layer: null, ui: null, numbers: null, governor: createGovernor({ log, memory: governorMemory(options.store, () => routes?.scene) }), cameraInput: options.cameraInput, ready: false }; // prettier-ignore\n277:    routes = parseRoutes(search, { scenes: options.scenes, registry, hash: options.hash ?? location.hash, log });\n280:      const scene = asked.playback?.replay.scene;\n281:      if (scene && !new URLSearchParams(search).has('scene') && options.scenes.includes(scene)) {\n282:        routes = { ...routes, scene };\n287:    const { scene, seed, settings, cam } = routes;\n288:    parts.run = createAppHost({ scene, seed, settings, cam, registry, log, drawing, materials });\n390 engine/app/engine.ts","is_error":false}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"e3d20180-3d88-400a-8de0-7e3aedba604b","timestamp":"2026-11-05T04:25:54.395Z","tool_use_result":{"stdout":"/**\n * @file Chromium for the tools and the e2e fixture, through Playwright: the launch options `playwright.config.ts`\n * also uses, the init script every page gets before its own scripts run (a virtual clock, seeded randomness and a\n * WebGPU probe), and the console and the page's errors collected, mapped to `.ts` files and lines\n * (tools/lib/pageErrors.ts) (§8.1, §8.8).\n *\n * Invariants: WebGPU runs on SwiftShader with shardfall's flags (`WEBGPU_FLAGS`), so pages present to their real\n * canvas. The clock only moves on `__clock.tick(n)`, 1/60 s per frame, and `Math.random` and `__clock.rng(name)`\n * are seeded, so a run repeats exactly. `__gpu` counts what WebGPU really did (adapters, devices, configured\n * canvases, queue submits, lost devices); it is measured, never reported by the page. `__gpuIdle()` resolves once\n * every queue the page submitted to has finished its work (the e2e harness waits on it at each test's end).\n *\n * @example\n * import { chromium } from '@playwright/test';\n * const browser = await chromium.launch(launchOptions());\n * const page = await browser.newPage({ viewport: VIEWPORT });\n * const watch = await preparePage(page, { seed: 1 }); // the virtual clock and the console, before the first goto\n * await browser.close();\n * @see tests/e2e/harness.spec.ts\n */\n/// <reference types=\"@webgpu/types\" />\nimport { existsSync } from 'node:fs';\nimport { homedir } from 'node:os';\nimport { join } from 'node:path';\nimport { chromium, type Browser, type LaunchOptions, type Page } from '@playwright/test';\nimport { fnv1a } from './hash';\nimport { mapPageError, type PageError } from './pageErrors';\n\n/** Shardfall's WebGPU flags (PLAN.md §8.8): SwiftShader through Vulkan, presenting to the page's own canvas. */\nexport const WEBGPU_FLAGS: readonly string[] = [\n  '--enable-unsafe-webgpu',\n  '--enable-features=Vulkan',\n  '--use-vulkan=swiftshader',\n  '--use-angle=swiftshader',\n];\n\n/** The container's Chromium (153 since 2026-10-22); `$CHROMIUM_PATH` overrides it. Nothing runs `playwright install`. */\nexport const DEFAULT_CHROMIUM = '/opt/pw-browsers/chromium';\n\n/** The platform's Chromium release (tools/deps.json), which scripts/setup.sh fetches where the container's is absent. */\nexport const CHROMIUM_VERSION = '153.0.8010.12';\n\n/** Where scripts/setup.sh keeps Chrome for Testing `CHROMIUM_VERSION` on a machine without `DEFAULT_CHROMIUM`. */\nexport function cachedChromium(env: Record<string, string | undefined> = process.env): string {\n  return join(env.HOME || homedir(), '.cache', 'my3dge', `chrome-${CHROMIUM_VERSION}`, 'chrome-linux64', 'chrome');\n}\n\n/** The viewport every harness page gets. */\nexport const VIEWPORT = { width: 960, height: 540 } as const;\n\n/**\n * The Chromium executable: `$CHROMIUM_PATH`; else `DEFAULT_CHROMIUM` when it exists; else `cachedChromium()` when it\n * exists (a machine outside the container, after scripts/setup.sh); else `DEFAULT_CHROMIUM`, so the launch error names\n * the platform's path. No shell state is needed, so every worktree resolves the same browser.\n */\nexport function chromiumPath(\n  env: Record<string, string | undefined> = process.env,\n  exists: (path: string) => boolean = existsSync,\n): string {\n  if (env.CHROMIUM_PATH) return env.CHROMIUM_PATH;\n  if (exists(DEFAULT_CHROMIUM)) return DEFAULT_CHROMIUM;\n  const cached = cachedChromium(env);\n  return exists(cached) ? cached : DEFAULT_CHROMIUM;\n}\n\n/** Playwright's launch options for WebGPU on this platform, shared by `playwright.config.ts` and the `x` commands. */\nexport function launchOptions(env: Record<string, string | undefined> = process.env): LaunchOptions {\n  return { executablePath: chromiumPath(env), args: [...WEBGPU_FLAGS] };\n}\n\n/** Launches the platform's Chromium with WebGPU, for `x` commands that open pages. */\nexport function launchBrowser(): Promise<Browser> {\n  return chromium.launch(launchOptions());\n}\n\n/** The browser part of a report's runtime: `153.0.8010.12` → `chromium153`. */\nexport function browserRuntime(version: string): string {\n  return `chromium${version.split('.')[0]}`;\n}\n\n/** The page's virtual clock and seeded streams, installed as `window.__clock`. */\nexport interface VirtualClock {\n  /** The seed of `Math.random`; named streams derive from it. */\n  seed: number;\n  /** Display frames run so far by `tick`. */\n  frames: number;\n  /** The virtual time `performance.now()` returns, in milliseconds (1000 at load). */\n  now(): number;\n  /** Runs `n` display frames: each advances time by 1/60 s, then runs the pending animation-frame callbacks. */\n  tick(n?: number): void;\n----\n/**\n * @file Vite's settings (the dev server and the build) and Vitest's (T1), in one file as Vitest expects (PLAN.md\n * §6.10, WPs 0.2 and 0.12).\n *\n * Invariants: every lab page (`labs/<name>/index.html`) and test page (`tests/pages/<name>.html`) is served as its\n * own page, and a missing page is a 404 (`appType: 'mpa'`). A bare `three` resolves to `three/webgpu`, as three.js's\n * WebGPU examples map it. The runtime dependencies are pre-bundled at startup, so a first page load never\n * re-optimizes and reloads (§4.7). The server listens on 127.0.0.1 and `$PORT` (default 5173). Every test file runs\n * the advice trap first (tests/setup/adviceTrap.ts), and `vitest --changed` reruns everything on the files that\n * tools/lib/tiers.ts's `T1_FULL` names.\n *\n * The build (`npm run build`) writes dist/ from the landing page (the root's\n * `index.html`) and every `labs/<name>/index.html`; test pages never ship (`harness.html` throws on purpose). In a game\n * made from the engine (engine-lock.json at its root, ADR-0024) the box is the worked example: served, never built. A page\n * ships only what it imports, never a `fetch()` of a repository path (§6.