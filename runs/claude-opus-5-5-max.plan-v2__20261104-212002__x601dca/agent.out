se, type EntryOf, type Schema } from '../../core/schema';\n\n/** One degree, in radians. */\nconst DEG = Math.PI / 180;\n\n/** A number field: its default, range, description and unit. */\nfunction num(value: number, minimum: number, maximum: number, description: string, unit?: string) {\n  return { type: 'number', default: value, minimum, maximum, description, ...(unit ? { unit } : {}) } as const;\n}\n\n/** An object field made of `properties`, defaulting to their defaults. */\nfunction group<const P extends Schema>(description: string, properties: P) {\n  const value = Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\n  return { type: 'object', description, properties, default: value } as const;\n}\n\n/** The model's numbers (see the file comment): what `character.movement` holds. */\nexport const MODEL_FIELDS = defineSchema({\n  gaits: group('Ground speeds by gait, with a weapon out; `holstered` multiplies every one.', {\n    run: num(4.4069, 0, 100, 'The run, the default gait: 173.5 u/s.', 'm/s'),\n    sprint: num(6.604, 0, 100, 'The sprint: 260 u/s.', 'm/s'),\n    sprintSide: num(\n      4.8,\n      0,\n      100,\n      'The sprint with the move 45° off the view (forward and a side key): measured.',\n9: * `MODEL_FIELDS`' defaults are the reference values, so a profile states only what it changes. They are Apex's\n10- * numbers converted from its units (1 u = 0.0254 m, as Respawn's own scripts convert): each description gives the\n11- * source value. Values marked \"ours\" have no source and are starting values for the owner's playtests. The gaits'\n12- * `side` and `back` are 1 in Apex (no strafe or backpedal penalty), there for games that slow either. A move's keys'\n13- * frame is the camera's heading (the intent `cam`), so the lurch tells a new key from a turning view. The crouch (its\n14- * hull and its duck's timing) and the slide are WP 13.5's (engine/physics/movement/crouch.ts).\n15- *\n16- * Invariants: data only; seconds, metres and radians as the fields say, never ticks (steer.ts converts at its step);\n17- * `createMotionState()` is a character at rest on the ground, standing, holstered.\n18- *\n19- * @example\n20- * import { parse } from '../../core/schema';\n21: * parse(MODEL_FIELDS, {}).gaits.sprint; // 6.604: 260 u/s\n22- * createMotionState().gait; // 'idle'\n23- * @see engine/physics/movement/model.test.ts\n24- */\n25-import { defineSchema, parse, type EntryOf, type Schema } from '../../core/schema';\n26-\n27-/** One degree, in radians. */\n28-const DEG = Math.PI / 180;\n29-\n30-/** A number field: its default, range, description and unit. */\n31-function num(value: number, minimum: number, maximum: number, description: string, unit?: string) {\n32-  return { type: 'number', default: value, minimum, maximum, description, ...(unit ? { unit } : {}) } as const;\n33-}\n34-\n35-/** An object field made of `properties`, defaulting to their defaults. */\n36-function group<const P extends Schema>(description: string, properties: P) {\n37-  const value = Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\n38-  return { type: 'object', description, properties, default: value } as const;\n39-}\n40-\n41-/** The model's numbers (see the file comment): what `character.movement` holds. */\n42:export const MODEL_FIELDS = defineSchema({\n43-  gaits: group('Ground speeds by gait, with a weapon out; `holstered` multiplies every one.', {\n44-    run: num(4.4069, 0, 100, 'The run, the default gait: 173.5 u/s.', 'm/s'),\n45-    sprint: num(6.604, 0, 100, 'The sprint: 260 u/s.', 'm/s'),\n46-    sprintSide: num(\n47-      4.8,\n48-      0,\n49-      100,\n50-      'The sprint with the move 45° off the view (forward and a side key): measured.',\n51-      'm/s',\n52-    ),\n53-    walk: num(2.2035, 0, 100, 'The walk, ours: Apex walks only aiming down sights, at the run × 0.5.', 'm/s'),\n54-    crouch: num(2.032, 0, 100, 'The crouch-walk: 80 u/s.', 'm/s'),\n55-    holstered: num(1.15, 0, 10, 'Every gait’s speed times this with no weapon out.'),\n56-    side: num(1, 0, 10, 'A gait’s speed times this moving straight across the view (er-apex’s `speed_scale_side`).'),\n57-    back: num(1, 0, 10, 'A gait’s speed times this moving straight back from the view (`speed_scale_back`).'),\n58-  }),\n59-  accel: group('Ground acceleration toward the wished speed (Apex’s GetAccel), by the speed at the tick’s start.', {\n60-    low: num(63.5, 0, 1e4, 'Below `lowSpeed`: 2,500 u/s².', 'm/s²'),\n61-    lowSpeed: num(3.048, 0, 100, 'Where `low` ends: 120 u/s.', 'm/s'),\n62-    run: num(11.43, 0, 1e4, 'From `lowSpeed` to just below the run (1 u/s): 450 u/s².', 'm/s²'),\n63-    sprint: num(2.54, 0, 1e4, 'Faster than that, toward the sprint: 100 u/s².', 'm/s²'),\n64-    crouch: num(63.5, 0, 1e4, 'Crouched, at every speed: 2,500 u/s².', 'm/s²'),\n65-  }),\n66-  decel: group('Ground deceleration of the velocity’s part the input does not push for (Apex’s Decelerate).', {\n67-    stand: num(31.75, 0, 1e4, 'Standing, at or below the run: 1,250 u/s².', 'm/s²'),\n68-    sprint: num(31.75, 0, 1e4, 'Faster than the run: 1,250 u/s².', 'm/s²'),\n69-    crouch: num(38.1, 0, 1e4, 'Crouched: 0.6 of its acceleration, 1,500 u/s².', 'm/s²'),\n70-  }),\n71-  sprint: group('When it sprints: Apex’s sticky sprint (held, or kept on by a press while it moves on).', {\n72-    angle: num(45 * DEG, 0, Math.PI, 'The most the move may turn from the view and sprint (a dot of 0.707).', 'rad'),\n73-    keep: num(\n74-      135 * DEG,\n75-      0,\n76-      Math.PI,\n77-      'A press keeps the sprint on while the move stays within this of the view.',\n78-      'rad',\n79-    ),\n80-    input: num(0.8, 0, 1, 'The least length of the move that sprints (a stick pushed this far).'),\n81-    sticky: num(3, 0, 60, 'A press starts a sticky sprint within this long, if it can sprint by then.', 's'),\n82-    hold: num(0.1, 0, 5, 'Holding the button keeps that window open this long past each tick.', 's'),\n83-    air: num(0.25, 0, 5, 'It still sprints this long after leaving the ground, unless it jumped.', 's'),\n84-  }),\n85-  air: group('Air control: Quake’s air acceleration with the wished speed capped (air strafing), no air friction.', {\n86-    speed: num(1.524, 0, 100, 'The cap on the speed along the input it accelerates to: 60 u/s.', 'm/s'),\n87-    accel: num(12.7, 0, 1e4, 'Its acceleration: 500 u/s².', 'm/s²'),\n88-    extra: num(0.0508, 0, 1e4, 'Along the input once past the cap, never faster overall: 2 u/s².', 'm/s²'),\n89-  }),\n90-  fatigue: group('Jump fatigue: a jump soon after landing from a jump goes lower.', {\n91-    height: num(0.3, 0, 1, 'The share of the height a jump gets at first.'),\n92-    from: num(0.15, 0, 10, 'It gets that share until this long after landing...', 's'),\n93-    to: num(0.75, 0, 10, '...then more, linearly, the full height from this long after landing.', 's'),\n94-  }),\n95-  hop: group('Bunny hops: a jump soon after landing, faster than `floor`, loses speed.', {\n96-    window: num(1, 0, 10, 'How soon after landing a jump costs speed: 1 s (contested: 0.1 s).', 's'),\n97-    cost: num(2.54, 0, 100, 'The speed it costs: 100 u/s.', 'm/s'),\n98-    floor: num(6.604, 0, 100, 'Never below this speed: the sprint’s.', 'm/s'),\n99-  }),\n100-  lurch: group('Lurch: a new move key just after a jump turns the velocity toward the new direction.', {\n101-    window: num(0.4, 0, 5, 'How long after the take-off a key still lurches (contested: 0.5 s).', 's'),\n102-    full: num(0.2, 0, 5, 'Until this long after the take-off it lurches at full `strength`, then less, to 0.', 's'),\n--\n242:export type MovementModel = EntryOf<typeof MODEL_FIELDS>;\n243-\n244-/** The model's numbers as a profile writes them: any group, and any number in one, left out is Apex's. */\n245-export type MovementModelSpec = {\n246-  [K in keyof MovementModel]?: MovementModel[K] extends object ? Partial<MovementModel[K]> : MovementModel[K];\n247-};\n248-\n249-/** Where a character is in the model: on the ground, in the air, mantling, climbing, on a zipline, on a ladder, skydiving. */ // prettier-ignore\n250-export const MODES = ['ground', 'air', 'mantle', 'climb', 'zipline', 'ladder', 'skydive'] as const;\n251-\n252-/** A mantle's phase: none, the grab up to the lip, hanging from it, the pull over it. */\n253-export const MANTLES = ['none', 'grab', 'hang', 'pull'] as const;\n254-\n255-/** How a character moves on the ground this tick: a slide is a gait. */\n256-export const GAITS = ['idle', 'walk', 'run', 'sprint', 'crouch', 'slide'] as const;\n/**\n * @file The movement profiles every game gets (PLAN.md WP 13.3, docs/PLAYGROUND.md §3.2), registered on the shared\n * registry when this module loads (engine/physics/character.ts loads it):\n * - `movement:apex`, Apex Legends' movement: its medium legends' hull, steps and slopes, gravity, jump and grace period,\n *   and the shooter model at its defaults, which are Apex's numbers (engine/physics/movement/model.ts). Its sources are\n *   er-apex's settings (`umiiii/er-apex`, `deps/er-apex-move/src/params.rs`: Fuse's, a medium legend) and an Apex\n *   console-variable dump (`240hz/ApexConfigs`), converted at 1 u = 0.0254 m.\n * - `movement:platformer`, the Stress Box hero's feel (a dash, a wall jump, a variable jump): the character controller's\n *   own defaults, so a character on it is the one `createCharacter()` makes, down to its hash.\n *\n * Invariants: data only; `movement:platformer` sets nothing.\n *\n * @example\n * import { getMovement } from './profile';\n * getMovement('movement:apex').character; // { capsule: { radius: 0.4064, height: 1.016 }, … }\n * @see engine/physics/movement/profile.test.ts\n */\nimport { registry as sharedRegistry } from '../../core/registry';\nimport { defineMovement, movementKind, type MovementSpec } from './profile';\n\n/** Apex's gravity: 750 u/s². */\nconst GRAVITY = 19.05;\n\n/** The profiles, by id. */\nexport const MOVEMENT_PROFILES: Readonly<Record<string, MovementSpec>> = {\n  'movement:apex': {\n    description:\n      'Apex Legends: run 4.41 m/s, sprint 6.60 (×1.15 holstered), Quake air strafing, a 1.42 m jump with fatigue, the lurch, the bunny-hop cost and the fall stun, on a medium legend’s 1.83 m hull.',\n    character: {\n      capsule: { radius: 0.4064, height: 1.8288 - 2 * 0.4064 }, // 16 u wide, 72 u tall\n      autostep: { height: 0.5588 }, // 22 u\n      stepFrom: 'contact', // a slide or a sprint steps up a stair, never stopping dead at it\n      stayOnGround: true, // over a ramp's crest it keeps to the ground, as Source's StayOnGround snaps it\n      maxSlope: 0.7953988301841436, // acos(0.7): walkable while the floor's normal is at least 0.7 up (45.57°)\n      slideSlope: 0.7953988301841436,\n      characterGravity: GRAVITY,\n      maxFall: 88.9, // 3,500 u/s, Source's sv_maxvelocity: a 20 m fall lands at 28 m/s, so the full stun is reachable\n      speed: 4.4069, // the run, for what reads the platformer fields (the feel meter's top speed)\n      jumpSpeed: Math.sqrt(2 * GRAVITY * 1.4224), // a 56 u jump: 7.36 m/s\n      feel: { coyote: 0.2, variableJump: 1, airControl: 0, dash: { speed: 0 } }, // jump_graceperiod; no cut, no dash\n    },\n    model: {},\n  },\n  'movement:platformer': {\n    description:\n      'The Stress Box hero: run 6 m/s with momentum and a skid, a 1.35 m variable jump with coyote time and a buffer, a dash, under 32 m/s² (the character controller’s defaults).',\n  },\n};\n\nmovementKind(sharedRegistry);\nfor (const [id, spec] of Object.entries(MOVEMENT_PROFILES)) {\n  if (!sharedRegistry.has('movement', id)) defineMovement(id, spec);\n}\nREADME.md\naction\nbody\nbuild\ncamera\ncourse\nemitter\nfeature\ngeometry\ninteractable\nlevel\nlook\nmaterial\nmodule\nmove\nmovement\nprop\nrig\nscene\nsfx\nsong\ntelegraph\ntexture\nthing\nweapon","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01TFoQ4SLkUr9AwbT6d1nuir","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjAc74AQ9zQ6Mftc8SBA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SCQywrNyJhXD58koYvT3cC","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/my-3dge && sed -n 1,70p labs/playground/cast/player.ts | cut -c1-200; sed -n 1,50p labs/playground/bodies/player.ts | cut -c1-200; sed -n 1,40p engine/anim/traversal/hold.ts | cut -c1-200; grep -n \"createCharacter\\|movement\" labs/playground/scenes/site.ts | head -10 | cut -c1-200; sed -n 1,50p labs/playground/ui/hud.ts | cut -c1-200","description":"Read playground player, body and hold-pose examples"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12212,"cache_read_input_tokens":368107,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12212},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"bbaa7af1-3a3b-429a-8038-0b13284a1ece","timestamp":"2026-11-05T04:41:26.290Z","request_id":"req_011CgjAc6pGWyND3kEogbCKk","wire_tool_inputs":{"toolu_01SCQywrNyJhXD58koYvT3cC":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/my-3dge && sed -n 1,70p labs/playground/cast/player.ts | cut -c1-200; sed -n 1,50p labs/playground/bodies/player.ts | cut -c1-200; sed -n 1,40p engine/anim/traversal/hold.ts | cut -c1-200; grep -n \"createCharacter\\|movement\" labs/playground/scenes/site.ts | head -10 | cut -c1-200; sed -n 1,50p labs/playground/ui/hud.ts | cut -c1-200","description":"Read playground player, body and hold-pose examples"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SCQywrNyJhXD58koYvT3cC","type":"tool_result","content":"/**\n * @file The playground's player (docs/PLAYGROUND.md §3, PLAN.md WP 13.1–13.3): the character the keys move, the body\n * it is drawn as, and `spawnPlayer`, which stands it in a scene. It moves as in Apex Legends, on the profile\n * `movement:apex` (engine/physics/movement/profiles.ts): a medium legend's hull (1.83 m tall, 0.41 m in radius), its\n * steps, slopes, gravity and jump, and the shooter model at Apex's numbers (docs/PLAYGROUND.md §3.2). It starts\n * empty-handed, so holstered: every gait 1.15 times faster than with a weapon out. A scene may give it weapons to\n * carry (`weapons`, WP 13.20: the site's the pistol and the rifle, labs/playground/weapons/guns.ts), holstered until\n * drawn. It is drawn as `body:player` (labs/playground/bodies/player.ts, which the page registers) on `build:adult`,\n * 1.80 m standing. The setting `playground.movement` (the settings screen's movement profile, WP 13.25) moves it as the\n * Stress Box hero instead (`movement:platformer`, its feel exactly, untuned); it is read when the scene starts.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter().characterGravity; // 19.05: m/s², Apex's 750 units/s²\n * playerCharacter().movement?.gaits.sprint; // 6.604: m/s with a weapon out, 260 units/s\n * playerCharacter({ speed: 5 }).movement?.gaits.run; // 5\n * @see labs/playground/scenes/gym.test.ts\n */\nimport {\n  createCharacter,\n  defineSettings,\n  getMovement,\n  spawnActor,\n  weaponsFor,\n  type Character,\n  type World,\n} from '../../../engine/sim-api';\n\n/** The profiles the player may move by: Apex's, the default, and the Stress Box hero's. */\nexport const PLAYER_MOVEMENTS = ['movement:apex', 'movement:platformer'] as const;\n\n/** The player's setting (see the file comment). */\nexport const PLAYER_SETTINGS = defineSettings({\n  'playground.movement': {\n    type: 'string',\n    enum: [...PLAYER_MOVEMENTS],\n    default: 'movement:apex',\n    when: 'scene',\n    description:\n      \"The profile the playground's player moves by (labs/playground/cast/player.ts): Apex Legends' movement as tuned, or the Stress Box hero's platformer feel (engine/physics/movement/profiles.ts); r\n  },\n});\n\n/** The profile the player moves by. */\nconst APEX = getMovement('movement:apex');\n\n/** Apex's gravity (m/s²): 750 units/s², an inch a unit (docs/PLAYGROUND.md §3.2). */\nexport const APEX_GRAVITY = APEX.character.characterGravity as number;\n\n/** Apex's jump (m): 56 units. */\nexport const APEX_JUMP = Math.pow(APEX.character.jumpSpeed as number, 2) / (2 * APEX_GRAVITY);\n\n/** Apex's run with a weapon out (m/s): 173.5 units/s; holstered, the player runs 1.15 times as fast. */\nexport const APEX_RUN = APEX.model!.gaits.run;\n\n/** How the player is drawn: `body:player` on the adult build, empty-handed. */\nexport const PLAYER_LOOK = Object.freeze({ body: 'body:player', build: 'build:adult', weapon: 'none' });\n\n/** What a scene may tune: the run with a weapon out (m/s) and the jump's height (m); and the profile, Apex's by default. */\nexport interface PlayerTuning {\n  readonly speed?: number;\n  readonly jump?: number;\n  readonly movement?: (typeof PLAYER_MOVEMENTS)[number];\n}\n\n/**\n * The player's character: `movement:apex`, its run and its jump's height (a take-off of √(2 g h)) as tuned; on\n * another profile, that profile's own character, the tuning unused.\n */\n/**\n * @file The player's body, `body:player` (docs/PLAYGROUND.md §3.1, PLAN.md WP 13.2), in the body grammar\n * (engine/gfx/puppets/grammar.ts), worn on `build:adult` (engine/anim/builds.ts): a jacket with darker upper sleeves\n * and collar, cargo trousers with knee pads and a belt, boots with dark soles, gloves, short hair and a face, and a\n * small pack on the back. Every garment has two tones, so the cel look's bands and the pixel look's palette both read\n * it, and one accent (`accent`: the yoke and its shoulder caps and the pack's top flap; the cuffs, `cuff`, in its\n * colour) marks the player from every camera: the caps and the flap face up, so the isometric and top-down cameras,\n * which draw the player 11 to 15 px tall, still show it (tests/e2e/playground.spec.ts counts it in every camera of both\n * looks).\n *\n * Sizes are an adult's at 1.80 m: limbs in multiples of the body's `limbRadius`, the torso of its `torsoRadius`, the\n * head of the skeleton's head radius. Its slots are what the neighbours vary by seed (docs/PLAYGROUND.md §7.4): the\n * skin, the hair, the jacket's two tones, the trousers', the boots', the accent and the cuffs.\n *\n * Invariants: data only; every slot it names is in `slots` and every slot in `slots` is worn; parts written for the\n * left side are in `mirror`. The page registers it (labs/playground/main.ts); the sim names it by id only.\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts).\n *\n * @example\n * PLAYER_BODY.slots?.accent; // '#ff7f2a'\n * @see labs/playground/bodies/player.test.ts\n */\nimport { defineBody, type BodySpec } from '../../../engine';\n\n/** The player's body (see the file comment). */\nexport const PLAYER_BODY: BodySpec = {\n  description:\n    'The playground player: a teal jacket with an orange yoke, charcoal cargo trousers with knee pads and a belt, boots, gloves, short hair and a pack.',\n  limbRadius: 0.055,\n  torsoRadius: 0.205,\n  build: 'build:adult',\n  slots: {\n    skin: '#e3b48f',\n    hair: '#2b1d16',\n    jacket: '#2f6672',\n    jacketDark: '#1d3f48',\n    accent: '#ff7f2a',\n    cuff: '#ff7f2a',\n    pants: '#41444d',\n    pantsDark: '#2a2c32',\n    boot: '#4d3424',\n    sole: '#1c1a19',\n    glove: '#26282c',\n    pack: '#5d6442',\n    eye: '#141018',\n  },\n  parts: [\n    // the hips\n    ['ball', 'pelvis', [[0.85, 'torso'], [0.6, 'torso'], [0.61, 'torso']], 'pants'], // prettier-ignore\n/**\n * @file Holding and aiming (PLAN.md WP 13.11, docs/PLAYGROUND.md §5.1): the layer that ends the animator's `post` slot,\n * after the traversal plant (engine/anim/traversal/plant.ts), posing what the body does with its look and its weapon\n * from what the view tells it before each pose:\n * - the head and eyes toward the aim (`look`: the heading and pitch the player looks along, from the page's intents;\n *   ADR-0025 amendment 10 sent them here), the neck and the head sharing the turn within their limits\n *   (engine/anim/ik.ts `aim`, its chain without the chest, so the hands on what they hold stay there);\n * - a gun carried (`carry`, as the view says, else the body's weapon `gun`): its stock at the right shoulder, the\n *   right hand on its grip and the left on its handguard (two-hand IK, `handTo`), held low and ready (`HOLD.ready`\n *   below the aim), raised along the aim when aiming down the sights (`aiming`: its sight line through the right eye,\n *   `HOLD.sights`), lowered and turned across the body at a sprint, the hands low (the gait's speed past the run,\n *   `HOLD.sprint`); its barrel follows the aim's pitch and, within `HOLD.yaw` of the body's heading, its yaw, the chest\n *   turning with it (the aim offsets), the hand along the barrel so the muzzle points where the aim does, the left hand\n *   slid back along the handguard to stay in reach (`support`), the gun drawn in past that;\n * - a traversal holding the hands (`busy`: `TraversalPose.weight`), or the traversal plant's hands on a contact\n *   (`contacts`: a hard landing's hand), lowers the hold as far as they hold them, and the head turns half as far.\n * The look comes eased (`LookPose`, stepped once a sim step by whoever draws the body), so the sights take `HOLD.raise`\n * to come up and a look fades as it goes; a gun drawn comes into the hands over `HOLD.draw` by the body's clock, and\n * leaves them as it is holstered (`drawn`; a body that starts with one holds it at once).\n *\n * Invariants: presentation only: it writes the pose and runs FK, never the sim's state; without a look and without a\n * gun it leaves the body as it was.\n *\n * @example\n * import { Animator } from '../character';\n * const hero = new Animator({ build: 'build:adult', weapon: 'gun', clock: 1 });\n * const hold = new HoldPlant().attach(hero);\n * const look = new LookPose(); // once a step: look.update({ yaw: 0, pitch: 0.3, aiming: true }, 1 / 60)\n * hold.look = look.update({ yaw: 0, pitch: 0.3, aiming: true }, 1).look; // fully up: down the sights, 0.3 rad up\n * @see engine/anim/traversal/hold.test.ts\n */\nimport { MathUtils, Matrix4, Quaternion, Vector3 } from '../../core/math';\nimport { B } from '../authoring';\nimport type { Animator } from '../character';\nimport type { Weapon } from '../poseNames';\nimport { forwardKinematics, jointPosition, jointRotation, socketPosition } from '../fk';\nimport { aim, AIM_CHAIN, handTo } from '../ik';\nimport { blendPoses, Pose } from '../pose';\nimport { boneMask, PROPORTIONS } from '../skeleton';\nimport type { AnimLayer } from '../weights';\n/**\n * @file The playground's HUD by camera mode (docs/PLAYGROUND.md §8.3, PLAN.md WP 13.25): what each of the five modes\n * shows over the game (`HUD_MODES`), and `showHud`, which the page (labs/playground/main.ts) runs each drawn frame:\n * - the camera and the look in use, top right, shown for a few seconds after either changes and all through the tour,\n *   then faded (`modeShown`; `data-value` `shown` or `faded`, its text kept for the tests), and where the player is on the block, top left (labs/playground/ui/areas.ts `locationLine`);\n * - the crosshair where the screen's centre aims a gun (first person and the shooter: `showsCrosshair`,\n *   labs/playground/weapons/hud.ts), never in the views that aim with the pointer;\n * - the prompts: what using the thing in reach does, with the key that uses it on the device used last (WP 13.16);\n * - the ammo: the weapon out and its rounds, the range's count (`weaponLine`, WP 13.20);\n * - a hint, bottom left, of the menus' keys (`HINT_LINE`; on a pad its menu button, on touch none: `hintLine`): the\n *   controls sheet (H) holds every other key;\n * - the feel readout (`feelLine`): the player's speed over the ground and how he moves (the movement model's mode or\n *   gait), which the platformer, isometric and top-down show (where the view gives speed away least), and every mode\n *   with the view setting `playground.readout` at `on` (`off` hides it everywhere).\n * Photo mode hides it all (labs/playground/ui/photo.ts). Every line is a `[data-ui=hud]` element with its `data-id`\n * (`mode`, `room`, `use`, `weapon`, `keys`, `readout`), so tests read the HUD as text.\n *\n * Invariants: presentation only: it reads the frame's world and the devices' prompts, never changes the run.\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's own files.\n *\n * @example\n * HUD_MODES.isometric.crosshair; // false: the pointer aims\n * feelLine({ actor: { vx: 3, vz: 4 }, motion: { mode: 'ground', gait: 'sprint' } }); // '5.0 m/s · sprint'\n * feelLine({ actor: { vx: 0, vz: 1 }, motion: { mode: 'air', gait: 'run' } }); // '1.0 m/s · air'\n * @see labs/playground/ui/hud.test.ts\n */\nimport type { Input, Overlay } from '../../../engine';\nimport { defineSettings } from '../../../engine/sim-api';\nimport { showsCrosshair, weaponLine, type WeaponsView } from '../weapons/hud';\nimport { onTouch } from './help';\n\n/** The readout's view setting (see the file comment). */\nexport const HUD_SETTINGS = defineSettings({\n  'playground.readout': {\n    type: 'string',\n    enum: ['auto', 'on', 'off'],\n    default: 'auto',\n    view: true,\n    description:\n      \"The playground HUD's feel readout, the player's speed and how he moves (labs/playground/ui/hud.ts): 'auto' shows it in the platformer, isometric and top-down cameras, 'on' in every camera, 'off\n  },\n});\n\n/** The HUD's hint, bottom left: the keys of the menus (the controls sheet holds the rest, labs/playground/ui/help.ts). */\nexport const HINT_LINE = 'H: controls · M: go to · Esc: menu';\n\n/** The hint on the device used last: the page's keys, a pad's menu button (pause holds the rest), none on touch. */\nexport function hintLine(input: Pick<Input, 'prompt' | 'lastDevice' | 'touch'>): string | null {\n  if (onTouch(input)) return null; // the menu button shows, top right","is_error":false}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"0fe26843-f53c-4642-9e9f-6d920c4a641f","timestamp":"2026-11-05T04:41:26.337Z","tool_use_result":{"stdout":"/**\n * @file The playground's player (docs/PLAYGROUND.md §3, PLAN.md WP 13.1–13.3): the character the keys move, the body\n * it is drawn as, and `spawnPlayer`, which stands it in a scene. It moves as in Apex Legends, on the profile\n * `movement:apex` (engine/physics/movement/profiles.ts): a medium legend's hull (1.83 m tall, 0.41 m in radius), its\n * steps, slopes, gravity and jump, and the shooter model at Apex's numbers (docs/PLAYGROUND.md §3.2). It starts\n * empty-handed, so holstered: every gait 1.15 times faster than with a weapon out. A scene may give it weapons to\n * carry (`weapons`, WP 13.20: the site's the pistol and the rifle, labs/playground/weapons/guns.ts), holstered until\n * drawn. It is drawn as `body:player` (labs/playground/bodies/player.ts, which the page registers) on `build:adult`,\n * 1.80 m standing. The setting `playground.movement` (the settings screen's movement profile, WP 13.25) moves it as the\n * Stress Box hero instead (`movement:platformer`, its feel exactly, untuned); it is read when the scene starts.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter().characterGravity; // 19.05: m/s², Apex's 750 units/s²\n * playerCharacter().movement?.gaits.sprint; // 6.604: m/s with a weapon out, 260 units/s\n * playerCharacter({ speed: 5 }).movement?.gaits.run; // 5\n * @see labs/playground/scenes/gym.test.ts\n */\nimport {\n  createCharacter,\n  defineSettings,\n  getMovement,\n  spawnActor,\n  weaponsFor,\n  type Character,\n  type World,\n} from '../../../engine/sim-api';\n\n/** The profiles the player may move by: Apex's, the default, and the Stress Box hero's. */\nexport const PLAYER_MOVEMENTS = ['movement:apex', 'movement:platformer'] as const;\n\n/** The player's setting (see the file comment). */\nexport const PLAYER_SETTINGS = defineSettings({\n  'playground.movement': {\n    type: 'string',\n    enum: [...PLAYER_MOVEMENTS],\n    default: 'movement:apex',\n    when: 'scene',\n    description:\n      \"The profile the playground's player moves by (labs/playground/cast/player.ts): Apex Legends' movement as tuned, or the Stress Box hero's platformer feel (engine/physics/movement/profiles.ts); r\n  },\n});\n\n/** The profile the player moves by. */\nconst APEX = getMovement('movement:apex');\n\n/** Apex's gravity (m/s²): 750 units/s², an inch a unit (docs/PLAYGROUND.md §3.2). */\nexport const APEX_GRAVITY = APEX.character.characterGravity as number;\n\n/** Apex's jump (m): 56 units. */\nexport const APEX_JUMP = Math.pow(APEX.character.jumpSpeed as number, 2) / (2 * APEX_GRAVITY);\n\n/** Apex's run with a weapon out (m/s): 173.5 units/s; holstered, the player runs 1.15 times as fast. */\nexport const APEX_RUN = APEX.model!.gaits.run;\n\n/** How the player is drawn: `body:player` on the adult build, empty-handed. */\nexport const PLAYER_LOOK = Object.freeze({ body: 'body:player', build: 'build:adult', weapon: 'none' });\n\n/** What a scene may tune: the run with a weapon out (m/s) and the jump's height (m); and the profile, Apex's by default. */\nexport interface PlayerTuning {\n  readonly speed?: number;\n  readonly jump?: number;\n  readonly movement?: (typeof PLAYER_MOVEMENTS)[number];\n}\n\n/**\n * The player's character: `movement:apex`, its run and its jump's height (a take-off of √(2 g h)) as tuned; on\n * another profile, that profile's own character, the tuning unused.\n */\n/**\n * @file The player's body, `body:player` (docs/PLAYGROUND.md §3.1, PLAN.md WP 13.2), in the body grammar\n * (engine/gfx/puppets/grammar.ts), worn on `build:adult` (engine/anim/builds.ts): a jacket with darker upper sleeves\n * and collar, cargo trousers with knee pads and a belt, boots with dark soles, gloves, short hair and a face, and a\n * small pack on the back. Every garment has two tones, so the cel look's bands and the pixel look's palette both read\n * it, and one accent (`accent`: the yoke and its shoulder caps and the pack's top flap; the cuffs, `cuff`, in its\n * colour) marks the player from every camera: the caps and the flap face up, so the isometric and top-down cameras,\n * which draw the player 11 to 15 px tall, still show it (tests/e2e/playground.spec.ts counts it in every camera of both\n * looks).\n *\n * Sizes are an adult's at 1.80 m: limbs in multiples of the body's `limbRadius`, the torso of its `torsoRadius`, the\n * head of the skeleton's head radius. Its slots are what the neighbours vary by seed (docs/PLAYGROUND.md §7.4): the\n * skin, the hair, the jacket's two tones, the trousers', the boots', the accent and the cuffs.\n *\n * Invariants: data only; every slot it names is in `slots` and every slot in `slots` is worn; parts written for the\n * left side are in `mirror`. The page registers it (labs/playground/main.ts); the sim names it by id only.\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts).\n *\n * @example\n * PLAYER_BODY.slots?.accent; // '#ff7f2a'\n * @see labs/playground/bodies/player.test.ts\n */\nimport { defineBody, type BodySpec } from '../../../engine';\n\n/** The player's body (see the file comment). */\nexport const PLAYER_BODY: BodySpec = {\n  description:\n    'The playground player: a teal jacket with an orange yoke, charcoal cargo trousers with knee pads and a belt, boots, gloves, short hair and a pack.',\n  limbRadius: 0.055,\n  torsoRadius: 0.205,\n  build: 'build:adult',\n  slots: {\n    skin: '#e3b48f',\n    hair: '#2b1d16',\n    jacket: '#2f6672',\n    jacketDark: '#1d3f48',\n    accent: '#ff7f2a',\n    cuff: '#ff7f2a',\n    pants: '#41444d',\n    pantsDark: '#2a2c32',\n    boot: '#4d3424',\n    sole: '#1c1a19',\n    glove: '#26282c',\n    pack: '#5d6442',\n    eye: '#141018',\n  },\n  parts: [\n    // the hips\n    ['ball', 'pelvis', [[0.85, 'torso'], [0.6, 'torso'], [0.61, 'torso']], 'pants'], // prettier-ignore\n/**\n * @file Holding and aiming (PLAN.md WP 13.11, docs/PLAYGROUND.md §5.1): the layer that ends the animator's `post` slot,\n * after the traversal plant (engine/anim/traversal/plant.ts), posing what the body does with its look and its weapon\n * from what the view tells it before each pose:\n * - the head and eyes toward the aim (`look`: the heading and pitch the player looks along, from the page's intents;\n *   ADR-0025 amendment 10 sent them here), the neck and the head sharing the turn within their limits\n *   (engine/anim/ik.ts `aim`, its chain without the chest, so the hands on what they hold stay there);\n * - a gun carried (`carry`, as the view says, else the body's weapon `gun`): its stock at the right shoulder, the\n *   right hand on its grip and the left on its handguard (two-hand IK, `handTo`), held low and ready (`HOLD.ready`\n *   below the aim), raised along the aim when aiming down the sights (`aiming`: its sight line through the right eye,\n *   `HOLD.sights`), lowered and turned across the body at a sprint, the hands low (the gait's speed past the run,\n *   `HOLD.sprint`); its barrel follows the aim's pitch and, within `HOLD.yaw` of the body's heading, its yaw, the chest\n *   turning with it (the aim offsets), the hand along the barrel so the muzzle points where the aim does, the left hand\n *   slid back along the handguard to stay in reach (`support`), the gun drawn in past that;\n * - a traversal holding the hands (`busy`: `TraversalPose.weight`), or the traversal plant's hands on a contact\n *   (`contacts`: a hard landing's hand), lowers the hold as far as they hold them, and the head turns half as far.\n * The look comes eased (`LookPose`, stepped once a sim step by whoever draws the body), so the sights take `HOLD.raise`\n * to come up and a look fades as it goes; a gun drawn comes into the hands over `HOLD.draw` by the body's clock, and\n * leaves them as it is holstered (`drawn`; a body that starts with one holds it at once).\n *\n * Invariants: presentation only: it writes the pose and runs FK, never the sim's state; without a look and without a\n * gun it leaves the body as it was.\n *\n * @example\n * import { Animator } from '../character';\n * const hero = new Animator({ build: 'build:adult', weapon: 'gun', clock: 1 });\n * const hold = new HoldPlant().attach(hero);\n * const look = new LookPose(); // once a step: look.update({ yaw: 0, pitch: 0.3, aiming: true }, 1 / 60)\n * hold.look = look.update({ yaw: 0, pitch: 0.3, aiming: true }, 1).look; // fully up: down the sights, 0.3 rad up\n * @see engine/anim/traversal/hold.test.ts\n */\nimport { MathUtils, Matrix4, Quaternion, Vector3 } from '../../core/math';\nimport { B } from '../authoring';\nimport type { Animator } from '../character';\nimport type { Weapon } from '../poseNames';\nimport { forwardKinematics, jointPosition, jointRotation, socketPosition } from '../fk';\nimport { aim, AIM_CHAIN, handTo } from '../ik';\nimport { blendPoses, Pose } from '../pose';\nimport { boneMask, PROPORTIONS } from '../skeleton';\nimport type { AnimLayer } from '../weights';\n/**\n * @file The playground's HUD by camera mode (docs/PLAYGROUND.md §8.3, PLAN.md WP 13.25): what each of the five modes\n * shows over the game (`HUD_MODES`), and `showHud`, which the page (labs/playground/main.ts) runs each drawn frame:\n * - the camera and the look in use, top right, shown for a few seconds after either changes and all through the tour,\n *   then faded (`modeShown`; `data-value` `shown` or `faded`, its text kept for the tests), and where the player is on the block, top left (labs/playground/ui/areas.ts `locationLine`);\n * - the crosshair where the screen's centre aims a gun (first person and the shooter: `showsCrosshair`,\n *   labs/playground/weapons/hud.ts), never in the views that aim with the pointer;\n * - the prompts: what using the thing in reach does, with the key that uses it on the device used last (WP 13.16);\n * - the ammo: the weapon out and its rounds, the range's count (`weaponLine`, WP 13.20);\n * - a hint, bottom left, of the menus' keys (`HINT_LINE`; on a pad its menu button, on touch none: `hintLine`): the\n *   controls sheet (H) holds every other key;\n * - the feel readout (`feelLine`): the player's speed over the ground and how he moves (the movement model's mode or\n *   gait), which the platformer, isometric and top-down show (where the view gives speed away least), and every mode\n *   with the view setting `playground.readout` at `on` (`off` hides it everywhere).\n * Photo mode hides it all (labs/playground/ui/photo.ts). Every line is a `[data-ui=hud]` element with its `data-id`\n * (`mode`, `room`, `use`, `weapon`, `keys`, `readout`), so tests read the HUD as text.\n *\n * Invariants: presentation only: it reads the frame's world and the devices' prompts, never changes the run.\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's own files.\n *\n * @example\n * HUD_MODES.isometric.crosshair; // false: the pointer aims\n * feelLine({ actor: { vx: 3, vz: 4 }, motion: { mode: 'ground', gait: 'sprint' } }); // '5.0 m/s · sprint'\n * feelLine({ actor: { vx: 0, vz: 1 }, motion: { mode: 'air', gait: 'run' } }); // '1.0 m/s · air'\n * @see labs/playground/ui/hud.test.ts\n */\nimport type { Input, Overlay } from '../../../engine';\nimport { defineSettings } from '../../../engine/sim-api';\nimport { showsCrosshair, weaponLine, type WeaponsView } from '../weapons/hud';\nimport { onTouch } from './help';\n\n/** The readout's view setting (see the file comment). */\nexport const HUD_SETTINGS = defineSettings({\n  'playground.readout': {\n    type: 'string',\n    enum: ['auto', 'on', 'off'],\n    default: 'auto',\n    view: true,\n    description:\n      \"The playground HUD's feel readout, the player's speed and how he moves (labs/playground/ui/hud.ts): 'auto' shows it in the platformer, isometric and top-down cameras, 'on' in every camera, 'off\n  },\n});\n\n/** The HUD's hint, bottom left: the keys of the menus (the controls sheet holds the rest, labs/playground/ui/help.ts). */\nexport const HINT_LINE = 'H: controls · M: go to · Esc: menu';\n\n/** The hint on the device used last: the page's keys, a pad's menu button (pause holds the rest), none on touch. */\nexport function hintLine(input: Pick<Input, 'prompt' | 'lastDevice' | 'touch'>): string | null {\n  if (onTouch(input)) return null; // the menu button shows, top right","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SCQywrNyJhXD58koYvT3cC","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
