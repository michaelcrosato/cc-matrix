{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GpGsZ3oYrRFH871yeaDSMr","type":"tool_result","content":"······\n\n Test Files  2 passed (2)\n      Tests  6 passed (6)\n   Start at  21:26:01\n   Duration  9.06s (transform 8.56s, setup 214ms, import 11.03s, tests 3.29s, environment 0ms)\n\nJSON report written to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/out/test/report.json\n\nreal\t0m9.759s\nuser\t0m10.415s\nsys\t0m2.003s\nchromium-1243\nchromium_headless_shell-1243\nffmpeg-1011\nfirefox-1543\nwebkit-2359\nchrome-141.0.7390.37\nnode-v24.22.0-linux-x64\n/home/micha/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome\nPLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64\n/**\n * @file The one-file playground, `playground.html` at the root (ADR-0023 amendment 5, the owner's call of\n * 2026-11-02): the playground (labs/playground/) built as one self-contained HTML page, its script and styles inline\n * and nothing fetched, so it opens from disk (file://) in a WebGPU browser, sent as one file. It is how the engine is\n * distributed and how the owner tests it, in place of the Vercel deployment it replaces.\n *\n * `buildOneFile` runs Vite's build on labs/playground/index.html with vite.config.ts's alias (a bare `three` is\n * `three/webgpu`), every dynamic import folded into the one script (`inlineDynamicImports`) and every asset a data URL;\n * `inlineBuild` then puts the script and the stylesheet into the page. The build gives the same bytes on every machine\n * (no path or time goes in: tools/lib/oneFile.test.ts), so `node x html --check` rebuilds it and compares, and the\n * quick gate runs that check (tools/cmd/ci.ts): the committed file matches its sources at every merge.\n *\n * Invariants: the page fetches nothing (`externalRefs` is empty); a `</script` inside the script is written\n * `<\\/script`, which means the same in a string, a template, a regular expression or a comment, and a `<!--` in it, which\n * no such rewrite makes safe, fails the build. Only the playground is in it: its links to the engine's other pages\n * (the Stress Box, the labs index, the labs) are the dev server's from the file, each saying in plain words to run\n * npm run dev first (labs/playground/ui/pages.ts).\n *\n * @example\n * inlineBuild('<script type=\"module\" crossorigin src=\"./a.js\"></script>', { 'a.js': 'go()' }); // '<script type=\"module\">go()</script>'\n * ONE_FILE; // 'playground.html'\n * @see tools/lib/oneFile.test.ts\n * @see tools/cmd/html.ts\n */\nimport { join } from 'node:path';\nimport type { Rollup } from 'vite';\n\n/** The file, from the repository root. */\nexport const ONE_FILE = 'playground.html';\n\n/** The page it is built from. */\nexport const ONE_FILE_PAGE = 'labs/playground/index.html';\n\n/** The note the file opens its head with. */\nexport const ONE_FILE_NOTE = `<!-- ${ONE_FILE}: the my-3dge playground as one self-contained page (https://github.com/michaelcrosato/my-3dge, MIT; it carries three.js, MIT, Rapier, Apache-2.0, and @stdlib functions, Apache-2.0: see lean/LICENSE). Open it in a browser with WebGPU. Written by node x html --write from ${ONE_FILE_PAGE}; never edit it by hand. -->`; // prettier-ignore\n\n/** A module script or stylesheet Vite's page loads from a file. */\nconst LOADED = /<script type=\"module\" crossorigin src=\"([^\"]+)\"><\\/script>|<link rel=\"stylesheet\" crossorigin href=\"([^\"]+)\">/g; // prettier-ignore\n\n/**\n * The page `html` with each script and stylesheet it loads put inline, from `files` (by file name; a reference\n * matches the file whose name it ends with), and `ONE_FILE_NOTE` after its charset. Throws, naming the file, when a\n * reference has no file or a script holds a `<!--`.\n */\nexport function inlineBuild(html: string, files: Readonly<Record<string, string>>): string {\n  const find = (ref: string): string => {\n    const name = Object.keys(files).find((file) => ref.endsWith(`/${file}`) || ref === file || ref === `./${file}`);\n    if (name === undefined) throw new Error(`${ref} is not in the build: the page loads a file Vite did not write`);\n    return files[name];\n  };\n  const inlined = html.replace(LOADED, (_tag, script?: string, style?: string) => {\n    if (style) return `<style>${find(style)}</style>`;\n    const code = find(script!).replaceAll('</script', '<\\\\/script');\n    if (code.includes('<!--')) {\n      throw new Error(`${script} holds \"<!--\", which an inline script cannot: write it apart ('<' + '!--') in the source`); // prettier-ignore\n    }\n    return `<script type=\"module\">${code}</script>`;\n  });\n  return inlined.replace('<meta charset=\"utf-8\" />', (charset) => `${charset}\\n    ${ONE_FILE_NOTE}`);\n}\n\n/** The `src` and `href` attributes of `html` that load something other than a data URL (none, in the one file). */\nexport function externalRefs(html: string): string[] {\n  const outside = html.replace(/<script type=\"module\">[\\s\\S]*?<\\/script>|<style>[\\s\\S]*?<\\/style>/g, '');\n  return [...outside.matchAll(/\\b(?:src|href)=\"([^\"]*)\"/g)].map((match) => match[1]).filter((ref) => !ref.startsWith('data:')); // prettier-ignore\n}\n\n/** Builds the one file from the repository at `root` and returns its text (about 7 MB; about 11 s). */\nexport async function buildOneFile(root: string): Promise<string> {\n  const { build } = await import('vite');\n  const result = await build({\n    root,\n    configFile: false,\n    logLevel: 'warn',\n    base: './',\n    resolve: { alias: [{ find: /^three$/, replacement: 'three/webgpu' }] },\n    build: {\n      write: false,\n      modulePreload: false,\n      cssCodeSplit: false,\n      assetsInlineLimit: () => true,\n      chunkSizeWarningLimit: Infinity,\n      rollupOptions: { input: { playground: join(root, ONE_FILE_PAGE) }, output: { inlineDynamicImports: true } },\n    },\n  });\n  const outputs = (Array.isArray(result) ? result : [result]) as Rollup.RollupOutput[];\n  const files: Record<string, string> = {};\n  let html: string | undefined;\n  for (const item of outputs.flatMap((output) => output.output)) {\n    const text = item.type === 'chunk' ? item.code : typeof item.source === 'string' ? item.source : new TextDecoder().decode(item.source); // prettier-ignore\n    if (item.fileName.endsWith('.html')) html = text;\n    else files[item.fileName] = text;\n  }\n  if (html === undefined) throw new Error(`Vite wrote no page from ${ONE_FILE_PAGE}: check that it exists`);\n  return inlineBuild(html, files);\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"89460f52-19f9-4bad-882f-19f6ad59aac0","timestamp":"2026-11-05T04:26:10.744Z","tool_use_result":{"stdout":"······\n\n Test Files  2 passed (2)\n      Tests  6 passed (6)\n   Start at  21:26:01\n   Duration  9.06s (transform 8.56s, setup 214ms, import 11.03s, tests 3.29s, environment 0ms)\n\nJSON report written to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/out/test/report.json\n\nreal\t0m9.759s\nuser\t0m10.415s\nsys\t0m2.003s\nchromium-1243\nchromium_headless_shell-1243\nffmpeg-1011\nfirefox-1543\nwebkit-2359\nchrome-141.0.7390.37\nnode-v24.22.0-linux-x64\n/home/micha/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome\nPLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64\n/**\n * @file The one-file playground, `playground.html` at the root (ADR-0023 amendment 5, the owner's call of\n * 2026-11-02): the playground (labs/playground/) built as one self-contained HTML page, its script and styles inline\n * and nothing fetched, so it opens from disk (file://) in a WebGPU browser, sent as one file. It is how the engine is\n * distributed and how the owner tests it, in place of the Vercel deployment it replaces.\n *\n * `buildOneFile` runs Vite's build on labs/playground/index.html with vite.config.ts's alias (a bare `three` is\n * `three/webgpu`), every dynamic import folded into the one script (`inlineDynamicImports`) and every asset a data URL;\n * `inlineBuild` then puts the script and the stylesheet into the page. The build gives the same bytes on every machine\n * (no path or time goes in: tools/lib/oneFile.test.ts), so `node x html --check` rebuilds it and compares, and the\n * quick gate runs that check (tools/cmd/ci.ts): the committed file matches its sources at every merge.\n *\n * Invariants: the page fetches nothing (`externalRefs` is empty); a `</script` inside the script is written\n * `<\\/script`, which means the same in a string, a template, a regular expression or a comment, and a `<!--` in it, which\n * no such rewrite makes safe, fails the build. Only the playground is in it: its links to the engine's other pages\n * (the Stress Box, the labs index, the labs) are the dev server's from the file, each saying in plain words to run\n * npm run dev first (labs/playground/ui/pages.ts).\n *\n * @example\n * inlineBuild('<script type=\"module\" crossorigin src=\"./a.js\"></script>', { 'a.js': 'go()' }); // '<script type=\"module\">go()</script>'\n * ONE_FILE; // 'playground.html'\n * @see tools/lib/oneFile.test.ts\n * @see tools/cmd/html.ts\n */\nimport { join } from 'node:path';\nimport type { Rollup } from 'vite';\n\n/** The file, from the repository root. */\nexport const ONE_FILE = 'playground.html';\n\n/** The page it is built from. */\nexport const ONE_FILE_PAGE = 'labs/playground/index.html';\n\n/** The note the file opens its head with. */\nexport const ONE_FILE_NOTE = `<!-- ${ONE_FILE}: the my-3dge playground as one self-contained page (https://github.com/michaelcrosato/my-3dge, MIT; it carries three.js, MIT, Rapier, Apache-2.0, and @stdlib functions, Apache-2.0: see lean/LICENSE). Open it in a browser with WebGPU. Written by node x html --write from ${ONE_FILE_PAGE}; never edit it by hand. -->`; // prettier-ignore\n\n/** A module script or stylesheet Vite's page loads from a file. */\nconst LOADED = /<script type=\"module\" crossorigin src=\"([^\"]+)\"><\\/script>|<link rel=\"stylesheet\" crossorigin href=\"([^\"]+)\">/g; // prettier-ignore\n\n/**\n * The page `html` with each script and stylesheet it loads put inline, from `files` (by file name; a reference\n * matches the file whose name it ends with), and `ONE_FILE_NOTE` after its charset. Throws, naming the file, when a\n * reference has no file or a script holds a `<!--`.\n */\nexport function inlineBuild(html: string, files: Readonly<Record<string, string>>): string {\n  const find = (ref: string): string => {\n    const name = Object.keys(files).find((file) => ref.endsWith(`/${file}`) || ref === file || ref === `./${file}`);\n    if (name === undefined) throw new Error(`${ref} is not in the build: the page loads a file Vite did not write`);\n    return files[name];\n  };\n  const inlined = html.replace(LOADED, (_tag, script?: string, style?: string) => {\n    if (style) return `<style>${find(style)}</style>`;\n    const code = find(script!).replaceAll('</script', '<\\\\/script');\n    if (code.includes('<!--')) {\n      throw new Error(`${script} holds \"<!--\", which an inline script cannot: write it apart ('<' + '!--') in the source`); // prettier-ignore\n    }\n    return `<script type=\"module\">${code}</script>`;\n  });\n  return inlined.replace('<meta charset=\"utf-8\" />', (charset) => `${charset}\\n    ${ONE_FILE_NOTE}`);\n}\n\n/** The `src` and `href` attributes of `html` that load something other than a data URL (none, in the one file). */\nexport function externalRefs(html: string): string[] {\n  const outside = html.replace(/<script type=\"module\">[\\s\\S]*?<\\/script>|<style>[\\s\\S]*?<\\/style>/g, '');\n  return [...outside.matchAll(/\\b(?:src|href)=\"([^\"]*)\"/g)].map((match) => match[1]).filter((ref) => !ref.startsWith('data:')); // prettier-ignore\n}\n\n/** Builds the one file from the repository at `root` and returns its text (about 7 MB; about 11 s). */\nexport async function buildOneFile(root: string): Promise<string> {\n  const { build } = await import('vite');\n  const result = await build({\n    root,\n    configFile: false,\n    logLevel: 'warn',\n    base: './',\n    resolve: { alias: [{ find: /^three$/, replacement: 'three/webgpu' }] },\n    build: {\n      write: false,\n      modulePreload: false,\n      cssCodeSplit: false,\n      assetsInlineLimit: () => true,\n      chunkSizeWarningLimit: Infinity,\n      rollupOptions: { input: { playground: join(root, ONE_FILE_PAGE) }, output: { inlineDynamicImports: true } },\n    },\n  });\n  const outputs = (Array.isArray(result) ? result : [result]) as Rollup.RollupOutput[];\n  const files: Record<string, string> = {};\n  let html: string | undefined;\n  for (const item of outputs.flatMap((output) => output.output)) {\n    const text = item.type === 'chunk' ? item.code : typeof item.source === 'string' ? item.source : new TextDecoder().decode(item.source); // prettier-ignore\n    if (item.fileName.endsWith('.html')) html = text;\n    else files[item.fileName] = text;\n  }\n  if (html === undefined) throw new Error(`Vite wrote no page from ${ONE_FILE_PAGE}: check that it exists`);\n  return inlineBuild(html, files);\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01GpGsZ3oYrRFH871yeaDSMr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CCxgW9VQWCB7nnsp62BNL5","type":"tool_result","content":"1\t/**\n2\t * @file The engine in a page (PLAN.md §6.4, §6.9, §8.3, WP 2.7): `createEngine({ canvas, scenes, levels })` registers\n3\t * the levels the page imported as text, reads the page's routes (engine/app/routes.ts: `?scene ?seed ?cam ?replay`,\n4\t * settings by path, a gallery link `#gallery/<kind>/<id>` with its driver, engine/dev/galleryShoot.ts), starts the\n5\t * scene as a recorded run with its view (engine/app/headless.ts, engine/app/view.ts), publishes the run's inspector\n6\t * as `window.__engine`, starts the renderer (WebGPU or nothing, engine/gfx/renderer.ts) and the post-processing chain\n7\t * every frame and shot is drawn through (engine/gfx/post/chain.ts: the view settings `post.look`, `post.filters` and\n8\t * `post.show`; the look's sky and style, engine/app/look.ts), warms up every pipeline the view needs (`gfx.warmUp`,\n9\t * engine/gfx/warmup.ts), draws the first frame, then runs the frame loop (engine/app/loop.ts): the devices sampled\n10\t * into intents (engine/input/input.ts; `__engine.input` drives the same session), fixed steps from the clock, the\n11\t * view drawn at the clock's alpha; the map follows the camera, the look the view settings `input.*`, the aim the\n12\t * view, and a click takes the pointer lock where the map's mouse looks (WP 13.9).\n13\t *\n14\t * Ready or error (§8.3): `__engine.ready` turns true once the first frame is done on the GPU, never after a startup\n15\t * error; every failure (a frame that throws stops the loop) is one record in `__engine.errors` (the log's), shown as\n16\t * page text by the error overlay (engine/dev/overlay.ts), so a startup crash is one line, never a hang. Without WebGPU\n17\t * (`GFX_NO_WEBGPU`) the sim still runs, and `__engine` still steps it; only `render` and `shot` throw.\n18\t *\n19\t * Every frame drawn is timed by the run's stats meter, which reads the renderer's counts (`__engine.stats()`,\n20\t * engine/dev/stats.ts), and feeds the performance governor (engine/dev/governor.ts: `auto`'s tier by frame rate). The\n21\t * rendering members (engine/app/viewMembers.ts) draw through the page's drawing (engine/app/drawing.ts: `render(n)`,\n22\t * `shot`, and `replay(text)` drawing a frame after every step, §6.7). `?replay=<name>` plays one of `options.replays`\n23\t * in real time from step 0 (without `?scene`, in its own scene if the page has it), then hands back to the devices.\n24\t * The overlay (engine/ui/overlay.ts, `engine.ui`, WP 6.7) shows the sim's hits as damage numbers\n25\t * (engine/app/damageNumbers.ts); `onFrame` runs a page's own presentation (`EngineFrame`). A page's front end (WP\n26\t * 13.25): `store` keeps the bindings across sessions; while `modal()` holds the page (a menu, a photo mode) the devices\n27\t * still read the system layer, but no intent reaches the run; `cameraInput()` is laid over each frame's camera input.\n28\t *\n29\t * Touch (WP 3.12, ADR-0021: built, not tested): the app wires the touch device (engine/input/devices/touch.ts), the\n30\t * page's chrome, the touch layer from `touchLayout` and swiping (engine/ui/), the quality budget's pixel caps\n31\t * (engine/gfx/quality.ts) and, in touch mode, the loop's 60 fps cap; the menu button pauses, then calls `onMenu`.\n32\t *\n33\t * Invariants: rendering never writes the sim (doctrine: WebGPU only): the loop steps the session only with intents and\n34\t * recorded settings; cameras and view settings never reach the hash; time comes from the frames, never a wall clock.\n35\t *\n36\t * @example\n37\t * // const engine = await createEngine({ canvas, scenes: ['box:room'] }); // labs/box/main.ts\n38\t * // engine.ready; // true once the first frame is drawn\n39\t * @see tests/e2e/box.spec.ts\n40\t */\n41\timport '../dev/members'; // declares the kind inspectorMember before input/devices/inspector registers its members\n42\timport {\n43\t  codeError,\n44\t  codeInfo,\n45\t  defineCodes,\n46\t  log as sharedLog,\n47\t  type CodeValues,\n48\t  type ErrorRecord,\n49\t  type Log,\n50\t} from '../core/log';\n51\timport { registry as sharedRegistry, type Registry } from '../core/registry';\n52\timport type { Settings } from '../core/settings';\n53\timport { createGalleryDriver, type GalleryDriver } from '../dev/galleryShoot';\n54\timport { createOverlay } from '../dev/overlay';\n55\timport { createMaterialLibrary } from '../gfx/materials/library';\n56\timport { createStyleSet } from '../gfx/materials/styles';\n57\timport type { QualitySetting } from '../gfx/quality';\n58\timport { createPost } from '../gfx/post/chain';\n59\timport { definePostSettings } from '../gfx/post/settings';\n60\timport { createRenderer } from '../gfx/renderer';\n61\timport { warmsAsked } from '../gfx/warmup';\n62\timport type { CameraInput } from '../gfx/cameras/pose';\n63\timport { connectVirtualDevice } from '../input/devices/inspector';\n64\timport { createInput, type CameraLike, type Input } from '../input/input';\n65\timport { lookOptions } from '../input/look';\n66\timport type { TouchSetting } from '../input/devices/touch';\n67\timport { createChrome } from '../ui/chrome';\n68\timport { attachSwipes } from '../ui/swipe';\n69\timport { createTouchLayer, getTouchLayout, type TouchLayout } from '../ui/touch';\n70\timport type { Inspector } from '../dev/inspector';\n71\timport { createOverlay as createUi, type Overlay } from '../ui/overlay';\n72\timport { createDamageNumbers } from './damageNumbers';\n73\timport { createPageDrawing, type EngineFrame, type PageParts } from './drawing';\n74\timport { createPageLook } from './look';\n75\timport { createAppHost, type AppRun } from './headless';\n76\timport { createLoop, type Loop } from './loop';\n77\timport { textStorage, type Store } from './store';\n78\timport { createPlayback, type Playback } from './playback';\n79\timport { defineLevel } from '../world/level/level';\n80\timport { parseRoutes, type Routes } from './routes';\n81\timport { createGovernor, governorMemory } from '../dev/governor';\n82\t\n83\t/** The codes this module raises, with their fixes. */\n84\texport const ENGINE_CODES = defineCodes('app', {\n85\t  APP_START: {\n86\t    template: 'the page failed to start: {message}',\n87\t    fix: 'the console names the cause; node x shot <page> reports it headless',\n88\t  },\n89\t  APP_FRAME: {\n90\t    template: 'a frame threw, so the loop stopped: {message}',\n91\t    fix: 'the console names the cause; reload the page to start again, or read __engine.state() to see where the run stands',\n92\t  },\n93\t  APP_NO_REPLAY: {\n94\t    template: 'the page has no replay {name}',\n95\t    fix: 'use one of: {names}',\n96\t  },\n97\t  APP_NO_FRAME: {\n98\t    template: 'no frame was drawn in {tries} tries: the warm-up never finished',\n99\t    fix: 'read __engine.errors for GFX_WARMUP_FAILED; node x shot <page> reports it headless',\n100\t  },\n101\t});\n102\t\n103\texport type { EngineFrame, FrameWorld } from './drawing';\n104\t\n105\t/** How a page starts the engine. */\n106\texport interface EngineOptions {\n107\t  /** The canvas it draws into; the page sizes it with CSS. */\n108\t  canvas: HTMLCanvasElement;\n109\t  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\n110\t  scenes: readonly string[];\n111\t  /**\n112\t   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n113\t   * entry's `materials`); registered unless already.\n114\t   */\n115\t  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n116\t  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\n117\t  replays?: Readonly<Record<string, () => Promise<string>>>;\n118\t  /** The query to read (`location.search`). */\n119\t  search?: string;\n120\t  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\n121\t  hash?: string;\n122\t  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n123\t  registry?: Registry;\n124\t  /** Where errors and advice go (the shared log). */\n125\t  log?: Log;\n126\t  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\n127\t  touchLayout?: string;\n128\t  /**\n129\t   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\n130\t   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\n131\t   */\n132\t  actionMap?: string | ((camera: string) => string);\n133\t  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\n134\t  onView?: (action: string) => void;\n135\t  /** Opens the page's menu, called after the touch menu button has paused the game. */\n136\t  onMenu?: () => void;\n137\t  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\n138\t  onFrame?: (frame: EngineFrame) => void;\n139\t  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\n140\t  store?: Store;\n141\t  /** True while the page's front end holds the devices (a menu, a photo mode): no intent reaches the run. */\n142\t  modal?: () => boolean;\n143\t  /** Camera input laid over the devices' each drawn frame, field by field (a photo mode's fly keys and drag look). */\n144\t  cameraInput?: () => CameraInput | undefined;\n145\t}\n146\t\n147\t/** A started engine. */\n148\texport interface Engine {\n149\t  /** The inspector, also `window.__engine`; null when the scene could not start. */\n150\t  readonly inspector: Inspector | null;\n151\t  /** True once the first frame is drawn; never after a startup error. */\n152\t  readonly ready: boolean;\n153\t  /** What the query asked for; null when it could not be read. */\n154\t  readonly routes: Routes | null;\n155\t  /** The game's HTML/CSS overlay over the canvas (engine/ui/overlay.ts); null until the renderer started. */\n156\t  readonly ui: Overlay | null;\n157\t  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\n158\t  readonly input: Input | null;\n159\t  /** Stops the frame loop. */\n160\t  stop(): void;\n161\t}\n162\t\n163\t/** What `?replay=<name>` asked for: the replay, ready to play, or why there is none (raised once the page is up). */\n164\tinterface Asked {\n165\t  playback?: Playback;\n166\t  error?: unknown;\n167\t}\n168\t\n169\t/** Reads the replay `name` of `replays` before the run starts, so its scene can start (see the file comment). */\n170\tasync function readReplay(name: string, replays: EngineOptions['replays']): Promise<Asked> {\n171\t  const load = replays?.[name];\n172\t  if (!load) {\n173\t    const names = Object.keys(replays ?? {}).sort();\n174\t    return { error: codeError('APP_NO_REPLAY', { name, names: names.join(', ') || 'none' }) };\n175\t  }\n176\t  try {\n177\t    return { playback: createPlayback(JSON.parse(await load())) };\n178\t  } catch (error) {\n179\t    return { error };\n180\t  }\n181\t}\n182\t\n183\t/** A store that reads and writes whichever run's settings are current, for the renderer made once. */\n184\tfunction currentSettings(run: () => AppRun): Settings {\n185\t  return new Proxy({} as Settings, {\n186\t    get(_, key: keyof Settings) {\n187\t      const store = run().session.settings;\n188\t      const value = store[key];\n189\t      return typeof value === 'function' ? (value as (...args: unknown[]) => unknown).bind(store) : value;\n190\t    },\n191\t  });\n192\t}\n193\t\n194\t/**\n195\t * The log record for a thrown value: its own code and values when it is a coded error (a `GfxError` carries only its\n196\t * message, so the values are read back from it through the code's template), else `code` with the message.\n197\t */\n198\texport function recordOf(error: unknown, code: string): [string, CodeValues] {\n199\t  const coded = error as { code?: unknown; values?: CodeValues; message?: unknown };\n200\t  const message = String(coded?.message ?? error);\n201\t  const info = typeof coded?.code === 'string' ? codeInfo(coded.code) : undefined;\n202\t  if (!info) return [code, { message }];\n203\t  if (coded.values) return [info.code, coded.values];\n204\t  const names: string[] = [];\n205\t  const pattern = info.template\n206\t    .split(/\\{(\\w+)\\}/)\n207\t    .map((part, i) => (i % 2 ? (names.push(part), '(.*)') : part.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')))\n208\t    .join('');\n209\t  const found = new RegExp(`^${pattern}$`, 's').exec(message);\n210\t  return [info.code, Object.fromEntries(names.map((name, i) => [name, found?.[i + 1] ?? '?']))];\n211\t}\n212\t\n213\t/** Starts the engine in a page (see the file comment); resolves once it is up or has failed. */\n214\texport async function createEngine(options: EngineOptions): Promise<Engine> {\n215\t  const log = options.log ?? sharedLog;\n216\t  const registry = options.registry ?? sharedRegistry;\n217\t  const overlay = createOverlay(document);\n218\t  overlay.status('Loading…');\n219\t  let routes: Routes | null = null;\n220\t  let loop: Loop | null = null;\n221\t  const parts: PageParts = { run: null, gfx: null, post: null, look: null, input: null, layer: null, ui: null, numbers: null, governor: createGovernor({ log, memory: governorMemory(options.store, () => routes?.scene) }), cameraInput: options.cameraInput, ready: false }; // prettier-ignore\n222\t  const fail = (error: unknown, code = 'APP_START'): ErrorRecord => {\n223\t    const record = log.error(...recordOf(error, code), error);\n224\t    overlay.error(record);\n225\t    return record;\n226\t  };\n227\t  const signals = {\n228\t    get ready() {\n229\t      return false;\n230\t    },\n231\t    get errors() {\n232\t      return log.errors.map((record) => ({ ...record }));\n233\t    },\n234\t    info: () => ({ page: location.pathname, headless: true }),\n235\t  };\n236\t  Object.assign(window, { __engine: signals });\n237\t  const engine: Engine = {\n238\t    get inspector() {\n239\t      return parts.run?.inspector ?? null;\n240\t    },\n241\t    get ready() {\n242\t      return parts.ready;\n243\t    },\n244\t    get routes() {\n245\t      return routes;\n246\t    },\n247\t    get ui() {\n248\t      return parts.ui;\n249\t    },\n250\t    get input() {\n251\t      return parts.input;\n252\t    },\n253\t    stop: () => loop?.stop(),\n254\t  };\n255\t\n256\t  let layout: TouchLayout | null = null;\n257\t  let playback: Playback | null = null;\n258\t  const viewNow = () => parts.run!.view!;\n259\t  const settingsNow = currentSettings(() => parts.run!);\n260\t  const chrome = createChrome(document);\n261\t  let gallery: GalleryDriver | null = null; // a gallery deep link's, fitting its camera and bursting its emitter\n262\t  const onFrame = (shown: EngineFrame) => {\n263\t    gallery?.frame(shown.dt);\n264\t    options.onFrame?.(shown);\n265\t  };\n266\t  const { drawing, frame, settle, warmCameras } = createPageDrawing(parts, { chrome, settings: settingsNow, onFrame }); // prettier-ignore\n267\t  let warming: Promise<void> | null = null;\n268\t  let asked: Asked | null = null;\n269\t  let materials: ReturnType<typeof createMaterialLibrary> | null = null;\n270\t\n271\t  try {\n272\t    definePostSettings(registry);\n273\t    for (const [id, level] of Object.entries(options.levels ?? {})) {\n274\t      if (!registry.has('level', id)) defineLevel(id, level, registry);\n275\t    }\n276\t    const search = options.search ?? location.search;\n277\t    routes = parseRoutes(search, { scenes: options.scenes, registry, hash: options.hash ?? location.hash, log });\n278\t    if (routes.replay !== undefined) {\n279\t      asked = await readReplay(routes.replay, options.replays);\n280\t      const scene = asked.playback?.replay.scene;\n281\t      if (scene && !new URLSearchParams(search).has('scene') && options.scenes.includes(scene)) {\n282\t        routes = { ...routes, scene };\n283\t      }\n284\t    }\n285\t    if (options.touchLayout !== undefined) layout = getTouchLayout(options.touchLayout, registry);\n286\t    materials = createMaterialLibrary({ registry });\n287\t    const { scene, seed, settings, cam } = routes;\n288\t    parts.run = createAppHost({ scene, seed, settings, cam, registry, log, drawing, materials });\n289\t    if (routes.gallery) gallery = createGalleryDriver(routes.gallery, () => parts.run!, registry);\n290\t  } catch (error) {\n291\t    fail(error);\n292\t    return engine;\n293\t  }\n294\t  const started = parts.run;\n295\t  Object.assign(window, { __engine: started.inspector });\n296\t  const onTap = (name: string) => {\n297\t    if (name === 'game') chrome.closeTopPanel();\n298\t    if (name !== 'menu') return;\n299\t    started.clock.pause();\n300\t    options.onMenu?.();\n301\t  };\n302\t  const touchMode = () => settingsNow.get<TouchSetting>('touch');\n303\t  const mapFor = () => {\n304\t    const asked = options.actionMap;\n305\t    return (typeof asked === 'function' ? asked(viewNow().camera.code()) : asked) ?? 'actionMap:thirdPerson';\n306\t  };\n307\t  const declared = (path: string) => registry.kinds().includes('setting') && registry.has('setting', path);\n308\t  const look = () => lookOptions((path) => (declared(path) ? settingsNow.get(path) : undefined));\n309\t  const input = (parts.input = createInput({ window, document, element: options.canvas, registry, log, touchMode, onTap, map: mapFor(), look, onView: options.onView, storage: options.store && textStorage(options.store) })); // prettier-ignore\n310\t  /** The camera the devices read: its heading, its look, and the aim from the view (engine/input/aim.ts). */\n311\t  const camera: CameraLike = {\n312\t    yaw: () => viewNow().camera.yaw(),\n313\t    pose: () => viewNow().camera.pose(),\n314\t    aim: (rule, devices) => viewNow().aim(rule, devices),\n315\t  };\n316\t  /** The map for the camera now, and the pointer lock: a click takes it where the map's mouse looks; pause gives it back. */ // prettier-ignore\n317\t  const sample = (now: number) => {\n318\t    const id = mapFor();\n319\t    if (id !== input.bindings.map.id) input.use(id);\n320\t    if (input.mouse?.locked && (!input.bindings.map.lock || started.clock.paused)) input.mouse.unlock();\n321\t    const intents = input.sample(camera, now);\n322\t    return options.modal?.() ? {} : intents;\n323\t  };\n324\t  options.canvas.addEventListener('click', () => {\n325\t    if (input.bindings.map.lock && !started.clock.paused && !input.mouse?.locked) input.mouse?.lock();\n326\t  });\n327\t  parts.layer = createTouchLayer(document, layout);\n328\t  attachSwipes(document);\n329\t  connectVirtualDevice(started.host, input.virtual);\n330\t  try {\n331\t    parts.gfx = await createRenderer(options.canvas, { settings: currentSettings(() => started), registry, log });\n332\t  } catch (error) {\n333\t    fail(error);\n334\t    return engine;\n335\t  }\n336\t  const gfx = parts.gfx;\n337\t  parts.numbers = createDamageNumbers((parts.ui = createUi({ canvas: options.canvas })));\n338\t  try {\n339\t    gfx.renderer.shadowMap.enabled = true;\n340\t    const styles = createStyleSet({ library: materials!, registry });\n341\t    const post = (parts.post = createPost(gfx, { settings: currentSettings(() => started), registry, log, styles }));\n342\t    const budget = () => parts.governor!.budget(settingsNow.get<QualitySetting>('quality'), input.touch?.active ?? false); // prettier-ignore\n343\t    parts.look = createPageLook({ post, styles, warmup: gfx.warmup, resolution: gfx.resolution, library: materials!, quality: budget, asked: () => warmsAsked(settingsNow) }); // prettier-ignore\n344\t    post.attach(gfx.warmup);\n345\t    viewNow().stage.register(gfx.warmup, gfx.features);\n346\t    await warmCameras();\n347\t    await settle(1, 0);\n348\t  } catch (error) {\n349\t    fail(error);\n350\t    return engine;\n351\t  }\n352\t  const step = (intents: Record<string, unknown>) => {\n353\t    if (playback && !playback.done) {\n354\t      playback.step(started.session);\n355\t      started.stepped(); // its hit-stops reach the clock as in live play\n356\t    } else {\n357\t      playback = null;\n358\t      started.stepOnce(intents);\n359\t    }\n360\t  };\n361\t  loop = createLoop({\n362\t    clock: () => started.clock,\n363\t    sample,\n364\t    step,\n365\t    draw: ({ alpha, dt }) => {\n366\t      // frozen in a reproducible run: a replay playing, or the governor turned off (engine/dev/governor.ts)\n367\t      parts.governor!.freeze((playback !== null && !playback.done) || !settingsNow.get<boolean>('gfx.governor'));\n368\t      if (warming) return;\n369\t      const report = frame(alpha, dt);\n370\t      if (!report.drawn && report.warming) warming = warmCameras().finally(() => (warming = null));\n371\t    },\n372\t    hold: () => started.playing,\n373\t    cap: () => input.touch?.active ?? false,\n374\t    onError: (error) => fail(error, 'APP_FRAME'),\n375\t  });\n376\t  parts.ready = true;\n377\t  overlay.hide();\n378\t  loop.start();\n379\t  const replay = asked?.playback;\n380\t  if (asked && !replay) fail(asked.error);\n381\t  else if (replay) {\n382\t    try {\n383\t      started.begin(replay.replay);\n384\t      playback = replay;\n385\t    } catch (error) {\n386\t      fail(error);\n387\t    }\n388\t  }\n389\t  return engine;\n390\t}\n391\t"}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"d0b5b5de-3d3a-4587-8d61-a20544fc6ebe","timestamp":"2026-11-05T04:26:10.759Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/engine/app/engine.ts","content":"/**\n * @file The engine in a page (PLAN.md §6.4, §6.9, §8.3, WP 2.7): `createEngine({ canvas, scenes, levels })` registers\n * the levels the page imported as text, reads the page's routes (engine/app/routes.ts: `?scene ?seed ?cam ?replay`,\n * settings by path, a gallery link `#gallery/<kind>/<id>` with its driver, engine/dev/galleryShoot.ts), starts the\n * scene as a recorded run with its view (engine/app/headless.ts, engine/app/view.ts), publishes the run's inspector\n * as `window.__engine`, starts the renderer (WebGPU or nothing, engine/gfx/renderer.ts) and the post-processing chain\n * every frame and shot is drawn through (engine/gfx/post/chain.ts: the view settings `post.look`, `post.filters` and\n * `post.show`; the look's sky and style, engine/app/look.ts), warms up every pipeline the view needs (`gfx.warmUp`,\n * engine/gfx/warmup.ts), draws the first frame, then runs the frame loop (engine/app/loop.ts): the devices sampled\n * into intents (engine/input/input.ts; `__engine.input` drives the same session), fixed steps from the clock, the\n * view drawn at the clock's alpha; the map follows the camera, the look the view settings `input.*`, the aim the\n * view, and a click takes the pointer lock where the map's mouse looks (WP 13.9).\n *\n * Ready or error (§8.3): `__engine.ready` turns true once the first frame is done on the GPU, never after a startup\n * error; every failure (a frame that throws stops the loop) is one record in `__engine.errors` (the log's), shown as\n * page text by the error overlay (engine/dev/overlay.ts), so a startup crash is one line, never a hang. Without WebGPU\n * (`GFX_NO_WEBGPU`) the sim still runs, and `__engine` still steps it; only `render` and `shot` throw.\n *\n * Every frame drawn is timed by the run's stats meter, which reads the renderer's counts (`__engine.stats()`,\n * engine/dev/stats.ts), and feeds the performance governor (engine/dev/governor.ts: `auto`'s tier by frame rate). The\n * rendering members (engine/app/viewMembers.ts) draw through the page's drawing (engine/app/drawing.ts: `render(n)`,\n * `shot`, and `replay(text)` drawing a frame after every step, §6.7). `?replay=<name>` plays one of `options.replays`\n * in real time from step 0 (without `?scene`, in its own scene if the page has it), then hands back to the devices.\n * The overlay (engine/ui/overlay.ts, `engine.ui`, WP 6.7) shows the sim's hits as damage numbers\n * (engine/app/damageNumbers.ts); `onFrame` runs a page's own presentation (`EngineFrame`). A page's front end (WP\n * 13.25): `store` keeps the bindings across sessions; while `modal()` holds the page (a menu, a photo mode) the devices\n * still read the system layer, but no intent reaches the run; `cameraInput()` is laid over each frame's camera input.\n *\n * Touch (WP 3.12, ADR-0021: built, not tested): the app wires the touch device (engine/input/devices/touch.ts), the\n * page's chrome, the touch layer from `touchLayout` and swiping (engine/ui/), the quality budget's pixel caps\n * (engine/gfx/quality.ts) and, in touch mode, the loop's 60 fps cap; the menu button pauses, then calls `onMenu`.\n *\n * Invariants: rendering never writes the sim (doctrine: WebGPU only): the loop steps the session only with intents and\n * recorded settings; cameras and view settings never reach the hash; time comes from the frames, never a wall clock.\n *\n * @example\n * // const engine = await createEngine({ canvas, scenes: ['box:room'] }); // labs/box/main.ts\n * // engine.ready; // true once the first frame is drawn\n * @see tests/e2e/box.spec.ts\n */\nimport '../dev/members'; // declares the kind inspectorMember before input/devices/inspector registers its members\nimport {\n  codeError,\n  codeInfo,\n  defineCodes,\n  log as sharedLog,\n  type CodeValues,\n  type ErrorRecord,\n  type Log,\n} from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { Settings } from '../core/settings';\nimport { createGalleryDriver, type GalleryDriver } from '../dev/galleryShoot';\nimport { createOverlay } from '../dev/overlay';\nimport { createMaterialLibrary } from '../gfx/materials/library';\nimport { createStyleSet } from '../gfx/materials/styles';\nimport type { QualitySetting } from '../gfx/quality';\nimport { createPost } from '../gfx/post/chain';\nimport { definePostSettings } from '../gfx/post/settings';\nimport { createRenderer } from '../gfx/renderer';\nimport { warmsAsked } from '../gfx/warmup';\nimport type { CameraInput } from '../gfx/cameras/pose';\nimport { connectVirtualDevice } from '../input/devices/inspector';\nimport { createInput, type CameraLike, type Input } from '../input/input';\nimport { lookOptions } from '../input/look';\nimport type { TouchSetting } from '../input/devices/touch';\nimport { createChrome } from '../ui/chrome';\nimport { attachSwipes } from '../ui/swipe';\nimport { createTouchLayer, getTouchLayout, type TouchLayout } from '../ui/touch';\nimport type { Inspector } from '../dev/inspector';\nimport { createOverlay as createUi, type Overlay } from '../ui/overlay';\nimport { createDamageNumbers } from './damageNumbers';\nimport { createPageDrawing, type EngineFrame, type PageParts } from './drawing';\nimport { createPageLook } from './look';\nimport { createAppHost, type AppRun } from './headless';\nimport { createLoop, type Loop } from './loop';\nimport { textStorage, type Store } from './store';\nimport { createPlayback, type Playback } from './playback';\nimport { defineLevel } from '../world/level/level';\nimport { parseRoutes, type Routes } from './routes';\nimport { createGovernor, governorMemory } from '../dev/governor';\n\n/** The codes this module raises, with their fixes. */\nexport const ENGINE_CODES = defineCodes('app', {\n  APP_START: {\n    template: 'the page failed to start: {message}',\n    fix: 'the console names the cause; node x shot <page> reports it headless',\n  },\n  APP_FRAME: {\n    template: 'a frame threw, so the loop stopped: {message}',\n    fix: 'the console names the cause; reload the page to start again, or read __engine.state() to see where the run stands',\n  },\n  APP_NO_REPLAY: {\n    template: 'the page has no replay {name}',\n    fix: 'use one of: {names}',\n  },\n  APP_NO_FRAME: {\n    template: 'no frame was drawn in {tries} tries: the warm-up never finished',\n    fix: 'read __engine.errors for GFX_WARMUP_FAILED; node x shot <page> reports it headless',\n  },\n});\n\nexport type { EngineFrame, FrameWorld } from './drawing';\n\n/** How a page starts the engine. */\nexport interface EngineOptions {\n  /** The canvas it draws into; the page sizes it with CSS. */\n  canvas: HTMLCanvasElement;\n  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\n  scenes: readonly string[];\n  /**\n   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n   * entry's `materials`); registered unless already.\n   */\n  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\n  replays?: Readonly<Record<string, () => Promise<string>>>;\n  /** The query to read (`location.search`). */\n  search?: string;\n  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\n  hash?: string;\n  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n  registry?: Registry;\n  /** Where errors and advice go (the shared log). */\n  log?: Log;\n  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\n  touchLayout?: string;\n  /**\n   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\n   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\n   */\n  actionMap?: string | ((camera: string) => string);\n  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\n  onView?: (action: string) => void;\n  /** Opens the page's menu, called after the touch menu button has paused the game. */\n  onMenu?: () => void;\n  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\n  onFrame?: (frame: EngineFrame) => void;\n  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\n  store?: Store;\n  /** True while the page's front end holds the devices (a menu, a photo mode): no intent reaches the run. */\n  modal?: () => boolean;\n  /** Camera input laid over the devices' each drawn frame, field by field (a photo mode's fly keys and drag look). */\n  cameraInput?: () => CameraInput | undefined;\n}\n\n/** A started engine. */\nexport interface Engine {\n  /** The inspector, also `window.__engine`; null when the scene could not start. */\n  readonly inspector: Inspector | null;\n  /** True once the first frame is drawn; never after a startup error. */\n  readonly ready: boolean;\n  /** What the query asked for; null when it could not be read. */\n  readonly routes: Routes | null;\n  /** The game's HTML/CSS overlay over the canvas (engine/ui/overlay.ts); null until the renderer started. */\n  readonly ui: Overlay | null;\n  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\n  readonly input: Input | null;\n  /** Stops the frame loop. */\n  stop(): void;\n}\n\n/** What `?replay=<name>` asked for: the replay, ready to play, or why there is none (raised once the page is up). */\ninterface Asked {\n  playback?: Playback;\n  error?: unknown;\n}\n\n/** Reads the replay `name` of `replays` before the run starts, so its scene can start (see the file comment). */\nasync function readReplay(name: string, replays: EngineOptions['replays']): Promise<Asked> {\n  const load = replays?.[name];\n  if (!load) {\n    const names = Object.keys(replays ?? {}).sort();\n    return { error: codeError('APP_NO_REPLAY', { name, names: names.join(', ') || 'none' }) };\n  }\n  try {\n    return { playback: createPlayback(JSON.parse(await load())) };\n  } catch (error) {\n    return { error };\n  }\n}\n\n/** A store that reads and writes whichever run's settings are current, for the renderer made once. */\nfunction currentSettings(run: () => AppRun): Settings {\n  return new Proxy({} as Settings, {\n    get(_, key: keyof Settings) {\n      const store = run().session.settings;\n      const value = store[key];\n      return typeof value === 'function' ? (value as (...args: unknown[]) => unknown).bind(store) : value;\n    },\n  });\n}\n\n/**\n * The log record for a thrown value: its own code and values when it is a coded error (a `GfxError` carries only its\n * message, so the values are read back from it through the code's template), else `code` with the message.\n */\nexport function recordOf(error: unknown, code: string): [string, CodeValues] {\n  const coded = error as { code?: unknown; values?: CodeValues; message?: unknown };\n  const message = String(coded?.message ?? error);\n  const info = typeof coded?.code === 'string' ? codeInfo(coded.code) : undefined;\n  if (!info) return [code, { message }];\n  if (coded.values) return [info.code, coded.values];\n  const names: string[] = [];\n  const pattern = info.template\n    .split(/\\{(\\w+)\\}/)\n    .map((part, i) => (i % 2 ? (names.push(part), '(.*)') : part.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')))\n    .join('');\n  const found = new RegExp(`^${pattern}$`, 's').exec(message);\n  return [info.code, Object.fromEntries(names.map((name, i) => [name, found?.[i + 1] ?? '?']))];\n}\n\n/** Starts the engine in a page (see the file comment); resolves once it is up or has failed. */\nexport async function createEngine(options: EngineOptions): Promise<Engine> {\n  const log = options.log ?? sharedLog;\n  const registry = options.registry ?? sharedRegistry;\n  const overlay = createOverlay(document);\n  overlay.status('Loading…');\n  let routes: Routes | null = null;\n  let loop: Loop | null = null;\n  const parts: PageParts = { run: null, gfx: null, post: null, look: null, input: null, layer: null, ui: null, numbers: null, governor: createGovernor({ log, memory: governorMemory(options.store, () => routes?.scene) }), cameraInput: options.cameraInput, ready: false }; // prettier-ignore\n  const fail = (error: unknown, code = 'APP_START'): ErrorRecord => {\n    const record = log.error(...recordOf(error, code), error);\n    overlay.error(record);\n    return record;\n  };\n  const signals = {\n    get ready() {\n      return false;\n    },\n    get errors() {\n      return log.errors.map((record) => ({ ...record }));\n    },\n    info: () => ({ page: location.pathname, headless: true }),\n  };\n  Object.assign(window, { __engine: signals });\n  const engine: Engine = {\n    get inspector() {\n      return parts.run?.inspector ?? null;\n    },\n    get ready() {\n      return parts.ready;\n    },\n    get routes() {\n      return routes;\n    },\n    get ui() {\n      return parts.ui;\n    },\n    get input() {\n      return parts.input;\n    },\n    stop: () => loop?.stop(),\n  };\n\n  let layout: TouchLayout | null = null;\n  let playback: Playback | null = null;\n  const viewNow = () => parts.run!.view!;\n  const settingsNow = currentSettings(() => parts.run!);\n  const chrome = createChrome(document);\n  let gallery: GalleryDriver | null = null; // a gallery deep link's, fitting its camera and bursting its emitter\n  const onFrame = (shown: EngineFrame) => {\n    gallery?.frame(shown.dt);\n    options.onFrame?.(shown);\n  };\n  const { drawing, frame, settle, warmCameras } = createPageDrawing(parts, { chrome, settings: settingsNow, onFrame }); // prettier-ignore\n  let warming: Promise<void> | null = null;\n  let asked: Asked | null = null;\n  let materials: ReturnType<typeof createMaterialLibrary> | null = null;\n\n  try {\n    definePostSettings(registry);\n    for (const [id, level] of Object.entries(options.levels ?? {})) {\n      if (!registry.has('level', id)) defineLevel(id, level, registry);\n    }\n    const search = options.search ?? location.search;\n    routes = parseRoutes(search, { scenes: options.scenes, registry, hash: options.hash ?? location.hash, log });\n    if (routes.replay !== undefined) {\n      asked = await readReplay(routes.replay, options.replays);\n      const scene = asked.playback?.replay.scene;\n      if (scene && !new URLSearchParams(search).has('scene') && options.scenes.includes(scene)) {\n        routes = { ...routes, scene };\n      }\n    }\n    if (options.touchLayout !== undefined) layout = getTouchLayout(options.touchLayout, registry);\n    materials = createMaterialLibrary({ registry });\n    const { scene, seed, settings, cam } = routes;\n    parts.run = createAppHost({ scene, seed, settings, cam, registry, log, drawing, materials });\n    if (routes.gallery) gallery = createGalleryDriver(routes.gallery, () => parts.run!, registry);\n  } catch (error) {\n    fail(error);\n    return engine;\n  }\n  const started = parts.run;\n  Object.assign(window, { __engine: started.inspector });\n  const onTap = (name: string) => {\n    if (name === 'game') chrome.closeTopPanel();\n    if (name !== 'menu') return;\n    started.clock.pause();\n    options.onMenu?.();\n  };\n  const touchMode = () => settingsNow.get<TouchSetting>('touch');\n  const mapFor = () => {\n    const asked = options.actionMap;\n    return (typeof asked === 'function' ? asked(viewNow().camera.code()) : asked) ?? 'actionMap:thirdPerson';\n  };\n  const declared = (path: string) => registry.kinds().includes('setting') && registry.has('setting', path);\n  const look = () => lookOptions((path) => (declared(path) ? settingsNow.get(path) : undefined));\n  const input = (parts.input = createInput({ window, document, element: options.canvas, registry, log, touchMode, onTap, map: mapFor(), look, onView: options.onView, storage: options.store && textStorage(options.store) })); // prettier-ignore\n  /** The camera the devices read: its heading, its look, and the aim from the view (engine/input/aim.ts). */\n  const camera: CameraLike = {\n    yaw: () => viewNow().camera.yaw(),\n    pose: () => viewNow().camera.pose(),\n    aim: (rule, devices) => viewNow().aim(rule, devices),\n  };\n  /** The map for the camera now, and the pointer lock: a click takes it where the map's mouse looks; pause gives it back. */ // prettier-ignore\n  const sample = (now: number) => {\n    const id = mapFor();\n    if (id !== input.bindings.map.id) input.use(id);\n    if (input.mouse?.locked && (!input.bindings.map.lock || started.clock.paused)) input.mouse.unlock();\n    const intents = input.sample(camera, now);\n    return options.modal?.() ? {} : intents;\n  };\n  options.canvas.addEventListener('click', () => {\n    if (input.bindings.map.lock && !started.clock.paused && !input.mouse?.locked) input.mouse?.lock();\n  });\n  parts.layer = createTouchLayer(document, layout);\n  attachSwipes(document);\n  connectVirtualDevice(started.host, input.virtual);\n  try {\n    parts.gfx = await createRenderer(options.canvas, { settings: currentSettings(() => started), registry, log });\n  } catch (error) {\n    fail(error);\n    return engine;\n  }\n  const gfx = parts.gfx;\n  parts.numbers = createDamageNumbers((parts.ui = createUi({ canvas: options.canvas })));\n  try {\n    gfx.renderer.shadowMap.enabled = true;\n    const styles = createStyleSet({ library: materials!, registry });\n    const post = (parts.post = createPost(gfx, { settings: currentSettings(() => started), registry, log, styles }));\n    const budget = () => parts.governor!.budget(settingsNow.get<QualitySetting>('quality'), input.touch?.active ?? false); // prettier-ignore\n    parts.look = createPageLook({ post, styles, warmup: gfx.warmup, resolution: gfx.resolution, library: materials!, quality: budget, asked: () => warmsAsked(settingsNow) }); // prettier-ignore\n    post.attach(gfx.warmup);\n    viewNow().stage.register(gfx.warmup, gfx.features);\n    await warmCameras();\n    await settle(1, 0);\n  } catch (error) {\n    fail(error);\n    return engine;\n  }\n  const step = (intents: Record<string, unknown>) => {\n    if (playback && !playback.done) {\n      playback.step(started.session);\n      started.stepped(); // its hit-stops reach the clock as in live play\n    } else {\n      playback = null;\n      started.stepOnce(intents);\n    }\n  };\n  loop = createLoop({\n    clock: () => started.clock,\n    sample,\n    step,\n    draw: ({ alpha, dt }) => {\n      // frozen in a reproducible run: a replay playing, or the governor turned off (engine/dev/governor.ts)\n      parts.governor!.freeze((playback !== null && !playback.done) || !settingsNow.get<boolean>('gfx.governor'));\n      if (warming) return;\n      const report = frame(alpha, dt);\n      if (!report.drawn && report.warming) warming = warmCameras().finally(() => (warming = null));\n    },\n    hold: () => started.playing,\n    cap: () => input.touch?.active ?? false,\n    onError: (error) => fail(error, 'APP_FRAME'),\n  });\n  parts.ready = true;\n  overlay.hide();\n  loop.start();\n  const replay = asked?.playback;\n  if (asked && !replay) fail(asked.error);\n  else if (replay) {\n    try {\n      started.begin(replay.replay);\n      playback = replay;\n    } catch (error) {\n      fail(error);\n    }\n  }\n  return engine;\n}\n","numLines":391,"startLine":1,"totalLines":391}},"tool_result_meta":[{"id":"toolu_01CCxgW9VQWCB7nnsp62BNL5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
