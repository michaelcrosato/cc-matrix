{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MT1UfSKUPYjVQtb7PKx4Nz","type":"tool_result","content":"/**\n * @file The animation library on the box page (PLAN.md §10, WP 8.9): `loadLibrary(files)` registers every set of\n * `data/anim/sets/` the page loaded as text (labs/box/clipFiles.ts, one chunk through `import.meta.glob`, never a\n * fetch), each as a\n * `clipset` entry (engine/anim/clip/clipsets.ts: its `_set.json` and its clip files joined, `clipSetFromFiles`), then\n * the mannequin, its build and body, from the Quaternius set (engine/gfx/puppets/bodies/mannequin.ts): what clip mode\n * (labs/box/scenes/clips.ts) plays and draws. The page calls it before it opens clip mode; no other scene loads it.\n * tests/pages/replay.ts calls it too, so clip mode's replays play in the sim page as here; Node registers the same\n * entries through tools/anim/library.ts. The lab pages register through here too (WP 10.8), so no page entry calls a\n * `define…` itself: `loadMannequin(text)`, the mannequin alone from the Quaternius set's `_set.json` text (labs/anim/,\n * labs/index/gallery.ts), and `registerEdit`, a clip's edited text played as a set of its own (labs/library/).\n *\n * Invariants: the sets register sorted by directory, each once (`defineClipSet` keeps a set registered already); the\n * module does nothing at its top level, so tools that import it in Node (`x describe`) load it as it is.\n *\n * Game code, a page's: it imports only engine/index.ts.\n *\n * @example\n * // await loadLibrary((await import('./clipFiles')).CLIP_FILES); // __engine.describe('clipset').ids: ['clipset:cmu', …]\n */\nimport { clipSetFromFiles, defineClipSet, defineMannequin, getClipSet, parseClip } from '../../engine';\n\n/** Registers the sets in `files` (path → its text, loaded on demand), then the mannequin from the Quaternius set. */\nexport async function loadLibrary(files: Readonly<Record<string, () => Promise<string>>>): Promise<string[]> {\n  const dirs: Record<string, Record<string, string>> = {};\n  const read = async ([path, load]: [string, () => Promise<string>]) => {\n    const [dir, file] = path.split('/').slice(-2);\n    (dirs[dir] ??= {})[file] = await load();\n  };\n  await Promise.all(Object.entries(files).map(read));\n  const ids = Object.keys(dirs)\n    .sort()\n    .map((dir) => defineClipSet(clipSetFromFiles(dirs[dir], `data/anim/sets/${dir}`)).id);\n  defineMannequin(getClipSet('clipset:quaternius'));\n  return ids;\n}\n\n/** Registers the mannequin, its build and body, from the Quaternius set's `_set.json` text (the page's `?raw`). */\nexport function loadMannequin(text: string): void {\n  defineMannequin(JSON.parse(text) as Parameters<typeof defineMannequin>[0]);\n}\n\n/**\n * Registers the clip `name` from its edited `text` as the set `set` of its own, with the sources of the set `from`\n * (`clipset:cmu`), and returns the clip's path to play (`lab1/<name>`). Throws what `parseClip` throws for bad text.\n */\nexport function registerEdit(set: string, from: string, name: string, text: string): string {\n  defineClipSet({ set, sources: getClipSet(from).sources, clips: { [name]: parseClip(text, name) } });\n  return `${set.toLowerCase()}/${name}`;\n}\n/**\n * @file Clips on actors (PLAN.md §10.4, WP 8.9): the clip layer (engine/anim/clip/layer.ts) in an actor's animator,\n * as sim data. `spawnActor`'s `clips` (engine/sim/actors.ts), or `addClips(w, id, { sets })` for a live actor, gives\n * an animated actor the component `clips`\n * (clipsets.ts `CLIPS_FIELDS`: the clip sets it plays from, its contact IK and blade, and the layer's state), so the\n * sim hashes, captures and restores what it plays; `playClip(w, id, clip, play?)` and `stopClip(w, id, fade?)` play and\n * stop a clip on it (the layer's `play` and `stop`), `seekClip(w, id, t)` puts the clip on top at a moment (a frame\n * step), `locomoteClips(w, id, loops)` picks loops by ground speed, and `clipLayerOf(w, id)` is the layer itself,\n * loaded from the component, to read. The view poses the layer over the body (engine/gfx/puppets/actors.ts), from the\n * same data.\n *\n * The system `actors.clips` (phase `anim`, after `actors.anim`) steps each layer once a tick at the actor's ground\n * speed (its controller's horizontal velocity) and writes its state back; it emits each of the layer's events as\n * `clip` `{ id, type, clip, name?, side? }`: a clip's own events (`event`, with its name and side), an attack's\n * `hit`, a fall's `landed`, and a one-shot's `end`.\n *\n * Invariants: everything a layer is in the sim is the component; the layers are a pool per world (clipsets.ts\n * `ClipLayerPool`), loaded from the components at every use, so a bake made while the sim steps is the sim's own and\n * the view never shares one. The system is added once per world, with the first actor's clips. The clip sets come from the\n * registry (`defineClipSet`), registered before the scene starts.\n *\n * @example\n * import { createCharacter } from '../physics/character';\n * import { spawnActor } from './actors';\n * // in a scene with a physics world, the sets registered (defineClipSet):\n * // const id = spawnActor(w, { at: [0, 0, 0], character: createCharacter(), anim: { build: 'build:heroic' } });\n * // addClips(w, id, { sets: ['clipset:quaternius'] });\n * // playClip(w, id, 'QUATERNIUS/Wave', { mask: 'upper', walk: true });\n * // w.step(); w.get(id).clips.state.slots[0].clip; // 'QUATERNIUS/Wave'\n * @see engine/sim/actorClips.test.ts\n */\nimport { CLIPS_FIELDS, ClipLayerPool, emptyClipState, type ClipsData } from '../anim/clip/clipsets';\nimport type { Build } from '../anim/builds';\nimport { ClipLayer, type ClipLayerState, type ClipPlay } from '../anim/clip/layer';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { ActorComponents } from './actors';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** Declares the component `clips` on `registry`, once. */\nexport function defineClipKinds(registry: Registry = sharedRegistry): void {\n  if (registry.kinds().includes('component') && registry.has('component', 'clips')) return;\n  const description =\n    'An actor’s clip layer (engine/anim/clip/layer.ts) as plain data: the clip sets it plays from, its contact IK and blade, and what it plays.';\n/**\n * @file Ragdolls in the sim (PLAN.md WP 10.2; I-11): the hand-off from an actor's animation to its ragdoll and back.\n * `handOff(w, id, hit)` gives an actor with an animator over to physics: its body posed where it stands now (its\n * animator's, engine/anim/character.ts), the humanoid's ragdoll of that pose (engine/anim/ragdoll.ts `ragdollOf`) added\n * to the physics world (engine/physics/ragdoll.ts), every part moving as the body did plus the hit's `push` (m/s) and\n * `spin` (rad/s; by default a tip over the push, `RAGDOLL_SIM.tip`), its reactions down for as long as it takes\n * (`knockDown`, or `die` when `dead`) and the component `ragdoll` holding its ids and its parts' poses; event `ragdoll`\n * `{ id, dead }`. A hit on a ragdoll still falling adds its push to every part (a dead one's too); a dying one stays down.\n *\n * The system `ragdolls` (phase `readback`; `addRagdolls(w)` adds it in a scene's setup, so a capture restores into a\n * world of the same schedule, and `handOff` refuses a world without it) reads every ragdoll's parts into its\n * component once the world has stepped (the view lays them on the bones), keeps its actor's capsule under its pelvis\n * (the cameras follow it, and the actor does not move itself meanwhile: engine/sim/actors.ts), and counts the steps its\n * trunk (the pelvis and the chest) has lain still (`RAGDOLL_SIM.speed`): a limb still swinging is laid into the get-up as\n * the ragdoll fades out. Alive, once its trunk has lain still `RAGDOLL_SIM.settle` or it has fallen for\n * `RAGDOLL_SIM.longest`, it gets up: its parts leave the physics world, the actor stands where the humanoid lying as\n * it lies would and faces as it would (`ragdollRest`), and its reactions get up the way its chest lies\n * (`Reactions.getUp`); event `getUp` `{ id, lying }`. The component stays `RAGDOLL_SIM.rise` more, its last poses\n * kept, while the view fades the ragdoll out (engine/gfx/puppets/actors.ts). A dead one lies until it is removed\n * (`removeRagdollOf`; engine/sim/actors.ts `removeActor` takes its parts with the actor) or stood up (`standUp`,\n * which gets any ragdoll up now).\n *\n * Invariants: everything a ragdoll is lives in its component and in Rapier (its parts and joints), so a capture\n * restores it and it steps on exactly; ragdolls step in id order; no random stream (the pose comes from the\n * animator's data, never its entity's stream).\n *\n * @example\n * // in a scene's setup, after its actors: addRagdolls(w);\n * // in a rule, a blow hard enough: handOff(w, target, { push: [0, 1.5, 4] }); // it flies back off its feet\n * // a killing one: handOff(w, target, { push: [0, 0, 3], dead: true });\n * // (w.get(target) as { ragdoll: RagdollState }).ragdoll.rise; // −1 while it falls; the tick it got up after\n * @see engine/sim/ragdolls.test.ts\n */\nimport { AnimatorPool, type AnimatorData } from '../anim/character';\nimport { getBuild } from '../anim/builds';\nimport { RAGDOLL_FADE, ragdollOf, ragdollRest } from '../anim/ragdoll';\nimport { codeError } from '../core/log';\nimport { Vector3 } from '../core/math';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { defineSchema } from '../core/schema';\n4: * airborne, the pose or stance it holds, the move it plays, the part that leaves a trail. `BODY_STATES` gives each\n5- * word the kind of value it takes; `checkBodyStates` warns once for a word outside the vocabulary, naming the closest\n6- * (`ANIM_UNKNOWN_STATE`), and once for a value of the wrong kind (`ANIM_BAD_STATE`), and drops both. `SAMPLE_STATES`\n7- * are named body states (idle, run, dodge…) with how long each is held, for tests, sheets and rig checks.\n8- *\n9- * Invariants:\n10- * - Any behaviour runs on any body: a body reads the words it knows and ignores the others without a warning; only a\n11- *   word outside the vocabulary (a typo) warns. The humanoid (engine/anim/humanoid.ts) reads every word but `trail`,\n12- *   which the animator samples (engine/anim/character.ts).\n13: * - `BODY_STATES` has exactly the keys of `AnimatorInput` (the compiler checks), so the vocabulary and what bodies\n14- *   read cannot drift. Pose and stance names are the body's to check (the humanoid's `ANIM_UNKNOWN_POSE`).\n15- * - Pure: no clock, no random stream; the warnings go through the given log, once per word.\n16- *\n17- * Carried from `my-3d2dge:src/emberdeep/18-characters.js:36-38` (the state bag a body's `update(dt, s)` takes, unknown\n18- * keys ignored) and `:82-88` (`CHAR_STATES`, as `SAMPLE_STATES` in metres, the three moves told as `body`, WP 6.1);\n19- * `src/emberdeep/33-beasts.js:1053-1060` reads the same words on a body that is not a humanoid.\n20- *\n21- * @example\n22- * import { createLog } from '../core/log';\n23- * const quiet = createLog({ console: { warn: () => {}, error: () => {} } });\n24- * checkBodyStates({ pose: 'cheer', dash: true }); // the same object: every word passes\n25- * checkBodyStates({ psoe: 'cheer' }, quiet); // {}, and quiet.advice[0].message is '\"psoe\" is not a body state (did you mean \"pose\"?); it is ignored'\n26- * checkBodyStates({ dash: 1 }, quiet); // {}: ANIM_BAD_STATE, dash takes true or false\n27- * SAMPLE_STATES.dodge.seconds; // 0.15\n28- * @see engine/anim/states.test.ts\n29- */\n30-import { defineCodes, didYouMean, log as engineLog, type Log } from '../core/log';\n31-import { Vector3 } from '../core/math';\n32-import { isPlainObject, show } from '../core/schema';\n33-import type { HumanoidInput } from './humanoid';\n34-\n35-/** The codes this module raises, with their fixes. */\n36-export const STATE_CODES = defineCodes('anim', {\n37-  ANIM_UNKNOWN_STATE: {\n38-    template: '{name} is not a body state{suggestion}; it is ignored',\n39-    fix: 'use one of: {names}',\n40:    doc: 'Raised once per word by the animator (engine/anim/character.ts `step`, through `checkBodyStates`) for a body state outside the vocabulary, usually a typo. Th\n41-  },\n42-  ANIM_BAD_STATE: {\n43-    template: 'body state {name} is {value}, not {expected}{suggestion}; it is ignored',\n44-    fix: 'give {name} {expected}',\n45:    doc: 'Raised once per word by the animator (engine/anim/character.ts `step`, through `checkBodyStates`) for a body state whose value is of the wrong kind: a number\n46-  },\n47-});\n48-\n49-/** The parts that leave a trail, each with the span its ribbon covers. */\n50-export const TRAILS = {\n51-  blade: 'The sword, from near the grip to its tip; another weapon or none trails as `fistR`.',\n52-  fistR: 'The right forearm, elbow to wrist.',\n53-  fistL: 'The left forearm, elbow to wrist.',\n54-  kick: 'The right shin, knee to sole.',\n55-} as const;\n56-\n57-/** A part that leaves a trail. */\n58-export type TrailName = keyof typeof TRAILS;\n59-\n60-/** What a body is told each step: the humanoid's words and the trail. Every word is optional. */\n61-export interface AnimatorInput extends HumanoidInput {\n62-  /** The part that leaves a trail this step (a move's strike sets it, WP 6.1); none when absent. */\n63-  trail?: TrailName;\n64-}\n65-\n66-/** The kind of value a body state takes; a `name` is checked by the body that reads it. */\n67-export type StateKind = 'number' | 'boolean' | 'vector' | 'object' | 'name' | 'trail';\n68-\n69-/** Every body state and the kind of value it takes (`AnimatorInput` documents each word). */\n70:export const BODY_STATES = {\n71-  position: 'vector',\n72-  velocity: 'vector',\n73-  yaw: 'number',","is_error":false}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"ff14d7d8-ff14-4558-b5c0-36f61dfe56c3","timestamp":"2026-11-05T04:41:40.627Z","tool_use_result":{"stdout":"/**\n * @file The animation library on the box page (PLAN.md §10, WP 8.9): `loadLibrary(files)` registers every set of\n * `data/anim/sets/` the page loaded as text (labs/box/clipFiles.ts, one chunk through `import.meta.glob`, never a\n * fetch), each as a\n * `clipset` entry (engine/anim/clip/clipsets.ts: its `_set.json` and its clip files joined, `clipSetFromFiles`), then\n * the mannequin, its build and body, from the Quaternius set (engine/gfx/puppets/bodies/mannequin.ts): what clip mode\n * (labs/box/scenes/clips.ts) plays and draws. The page calls it before it opens clip mode; no other scene loads it.\n * tests/pages/replay.ts calls it too, so clip mode's replays play in the sim page as here; Node registers the same\n * entries through tools/anim/library.ts. The lab pages register through here too (WP 10.8), so no page entry calls a\n * `define…` itself: `loadMannequin(text)`, the mannequin alone from the Quaternius set's `_set.json` text (labs/anim/,\n * labs/index/gallery.ts), and `registerEdit`, a clip's edited text played as a set of its own (labs/library/).\n *\n * Invariants: the sets register sorted by directory, each once (`defineClipSet` keeps a set registered already); the\n * module does nothing at its top level, so tools that import it in Node (`x describe`) load it as it is.\n *\n * Game code, a page's: it imports only engine/index.ts.\n *\n * @example\n * // await loadLibrary((await import('./clipFiles')).CLIP_FILES); // __engine.describe('clipset').ids: ['clipset:cmu', …]\n */\nimport { clipSetFromFiles, defineClipSet, defineMannequin, getClipSet, parseClip } from '../../engine';\n\n/** Registers the sets in `files` (path → its text, loaded on demand), then the mannequin from the Quaternius set. */\nexport async function loadLibrary(files: Readonly<Record<string, () => Promise<string>>>): Promise<string[]> {\n  const dirs: Record<string, Record<string, string>> = {};\n  const read = async ([path, load]: [string, () => Promise<string>]) => {\n    const [dir, file] = path.split('/').slice(-2);\n    (dirs[dir] ??= {})[file] = await load();\n  };\n  await Promise.all(Object.entries(files).map(read));\n  const ids = Object.keys(dirs)\n    .sort()\n    .map((dir) => defineClipSet(clipSetFromFiles(dirs[dir], `data/anim/sets/${dir}`)).id);\n  defineMannequin(getClipSet('clipset:quaternius'));\n  return ids;\n}\n\n/** Registers the mannequin, its build and body, from the Quaternius set's `_set.json` text (the page's `?raw`). */\nexport function loadMannequin(text: string): void {\n  defineMannequin(JSON.parse(text) as Parameters<typeof defineMannequin>[0]);\n}\n\n/**\n * Registers the clip `name` from its edited `text` as the set `set` of its own, with the sources of the set `from`\n * (`clipset:cmu`), and returns the clip's path to play (`lab1/<name>`). Throws what `parseClip` throws for bad text.\n */\nexport function registerEdit(set: string, from: string, name: string, text: string): string {\n  defineClipSet({ set, sources: getClipSet(from).sources, clips: { [name]: parseClip(text, name) } });\n  return `${set.toLowerCase()}/${name}`;\n}\n/**\n * @file Clips on actors (PLAN.md §10.4, WP 8.9): the clip layer (engine/anim/clip/layer.ts) in an actor's animator,\n * as sim data. `spawnActor`'s `clips` (engine/sim/actors.ts), or `addClips(w, id, { sets })` for a live actor, gives\n * an animated actor the component `clips`\n * (clipsets.ts `CLIPS_FIELDS`: the clip sets it plays from, its contact IK and blade, and the layer's state), so the\n * sim hashes, captures and restores what it plays; `playClip(w, id, clip, play?)` and `stopClip(w, id, fade?)` play and\n * stop a clip on it (the layer's `play` and `stop`), `seekClip(w, id, t)` puts the clip on top at a moment (a frame\n * step), `locomoteClips(w, id, loops)` picks loops by ground speed, and `clipLayerOf(w, id)` is the layer itself,\n * loaded from the component, to read. The view poses the layer over the body (engine/gfx/puppets/actors.ts), from the\n * same data.\n *\n * The system `actors.clips` (phase `anim`, after `actors.anim`) steps each layer once a tick at the actor's ground\n * speed (its controller's horizontal velocity) and writes its state back; it emits each of the layer's events as\n * `clip` `{ id, type, clip, name?, side? }`: a clip's own events (`event`, with its name and side), an attack's\n * `hit`, a fall's `landed`, and a one-shot's `end`.\n *\n * Invariants: everything a layer is in the sim is the component; the layers are a pool per world (clipsets.ts\n * `ClipLayerPool`), loaded from the components at every use, so a bake made while the sim steps is the sim's own and\n * the view never shares one. The system is added once per world, with the first actor's clips. The clip sets come from the\n * registry (`defineClipSet`), registered before the scene starts.\n *\n * @example\n * import { createCharacter } from '../physics/character';\n * import { spawnActor } from './actors';\n * // in a scene with a physics world, the sets registered (defineClipSet):\n * // const id = spawnActor(w, { at: [0, 0, 0], character: createCharacter(), anim: { build: 'build:heroic' } });\n * // addClips(w, id, { sets: ['clipset:quaternius'] });\n * // playClip(w, id, 'QUATERNIUS/Wave', { mask: 'upper', walk: true });\n * // w.step(); w.get(id).clips.state.slots[0].clip; // 'QUATERNIUS/Wave'\n * @see engine/sim/actorClips.test.ts\n */\nimport { CLIPS_FIELDS, ClipLayerPool, emptyClipState, type ClipsData } from '../anim/clip/clipsets';\nimport type { Build } from '../anim/builds';\nimport { ClipLayer, type ClipLayerState, type ClipPlay } from '../anim/clip/layer';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { ActorComponents } from './actors';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** Declares the component `clips` on `registry`, once. */\nexport function defineClipKinds(registry: Registry = sharedRegistry): void {\n  if (registry.kinds().includes('component') && registry.has('component', 'clips')) return;\n  const description =\n    'An actor’s clip layer (engine/anim/clip/layer.ts) as plain data: the clip sets it plays from, its contact IK and blade, and what it plays.';\n/**\n * @file Ragdolls in the sim (PLAN.md WP 10.2; I-11): the hand-off from an actor's animation to its ragdoll and back.\n * `handOff(w, id, hit)` gives an actor with an animator over to physics: its body posed where it stands now (its\n * animator's, engine/anim/character.ts), the humanoid's ragdoll of that pose (engine/anim/ragdoll.ts `ragdollOf`) added\n * to the physics world (engine/physics/ragdoll.ts), every part moving as the body did plus the hit's `push` (m/s) and\n * `spin` (rad/s; by default a tip over the push, `RAGDOLL_SIM.tip`), its reactions down for as long as it takes\n * (`knockDown`, or `die` when `dead`) and the component `ragdoll` holding its ids and its parts' poses; event `ragdoll`\n * `{ id, dead }`. A hit on a ragdoll still falling adds its push to every part (a dead one's too); a dying one stays down.\n *\n * The system `ragdolls` (phase `readback`; `addRagdolls(w)` adds it in a scene's setup, so a capture restores into a\n * world of the same schedule, and `handOff` refuses a world without it) reads every ragdoll's parts into its\n * component once the world has stepped (the view lays them on the bones), keeps its actor's capsule under its pelvis\n * (the cameras follow it, and the actor does not move itself meanwhile: engine/sim/actors.ts), and counts the steps its\n * trunk (the pelvis and the chest) has lain still (`RAGDOLL_SIM.speed`): a limb still swinging is laid into the get-up as\n * the ragdoll fades out. Alive, once its trunk has lain still `RAGDOLL_SIM.settle` or it has fallen for\n * `RAGDOLL_SIM.longest`, it gets up: its parts leave the physics world, the actor stands where the humanoid lying as\n * it lies would and faces as it would (`ragdollRest`), and its reactions get up the way its chest lies\n * (`Reactions.getUp`); event `getUp` `{ id, lying }`. The component stays `RAGDOLL_SIM.rise` more, its last poses\n * kept, while the view fades the ragdoll out (engine/gfx/puppets/actors.ts). A dead one lies until it is removed\n * (`removeRagdollOf`; engine/sim/actors.ts `removeActor` takes its parts with the actor) or stood up (`standUp`,\n * which gets any ragdoll up now).\n *\n * Invariants: everything a ragdoll is lives in its component and in Rapier (its parts and joints), so a capture\n * restores it and it steps on exactly; ragdolls step in id order; no random stream (the pose comes from the\n * animator's data, never its entity's stream).\n *\n * @example\n * // in a scene's setup, after its actors: addRagdolls(w);\n * // in a rule, a blow hard enough: handOff(w, target, { push: [0, 1.5, 4] }); // it flies back off its feet\n * // a killing one: handOff(w, target, { push: [0, 0, 3], dead: true });\n * // (w.get(target) as { ragdoll: RagdollState }).ragdoll.rise; // −1 while it falls; the tick it got up after\n * @see engine/sim/ragdolls.test.ts\n */\nimport { AnimatorPool, type AnimatorData } from '../anim/character';\nimport { getBuild } from '../anim/builds';\nimport { RAGDOLL_FADE, ragdollOf, ragdollRest } from '../anim/ragdoll';\nimport { codeError } from '../core/log';\nimport { Vector3 } from '../core/math';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { defineSchema } from '../core/schema';\n4: * airborne, the pose or stance it holds, the move it plays, the part that leaves a trail. `BODY_STATES` gives each\n5- * word the kind of value it takes; `checkBodyStates` warns once for a word outside the vocabulary, naming the closest\n6- * (`ANIM_UNKNOWN_STATE`), and once for a value of the wrong kind (`ANIM_BAD_STATE`), and drops both. `SAMPLE_STATES`\n7- * are named body states (idle, run, dodge…) with how long each is held, for tests, sheets and rig checks.\n8- *\n9- * Invariants:\n10- * - Any behaviour runs on any body: a body reads the words it knows and ignores the others without a warning; only a\n11- *   word outside the vocabulary (a typo) warns. The humanoid (engine/anim/humanoid.ts) reads every word but `trail`,\n12- *   which the animator samples (engine/anim/character.ts).\n13: * - `BODY_STATES` has exactly the keys of `AnimatorInput` (the compiler checks), so the vocabulary and what bodies\n14- *   read cannot drift. Pose and stance names are the body's to check (the humanoid's `ANIM_UNKNOWN_POSE`).\n15- * - Pure: no clock, no random stream; the warnings go through the given log, once per word.\n16- *\n17- * Carried from `my-3d2dge:src/emberdeep/18-characters.js:36-38` (the state bag a body's `update(dt, s)` takes, unknown\n18- * keys ignored) and `:82-88` (`CHAR_STATES`, as `SAMPLE_STATES` in metres, the three moves told as `body`, WP 6.1);\n19- * `src/emberdeep/33-beasts.js:1053-1060` reads the same words on a body that is not a humanoid.\n20- *\n21- * @example\n22- * import { createLog } from '../core/log';\n23- * const quiet = createLog({ console: { warn: () => {}, error: () => {} } });\n24- * checkBodyStates({ pose: 'cheer', dash: true }); // the same object: every word passes\n25- * checkBodyStates({ psoe: 'cheer' }, quiet); // {}, and quiet.advice[0].message is '\"psoe\" is not a body state (did you mean \"pose\"?); it is ignored'\n26- * checkBodyStates({ dash: 1 }, quiet); // {}: ANIM_BAD_STATE, dash takes true or false\n27- * SAMPLE_STATES.dodge.seconds; // 0.15\n28- * @see engine/anim/states.test.ts\n29- */\n30-import { defineCodes, didYouMean, log as engineLog, type Log } from '../core/log';\n31-import { Vector3 } from '../core/math';\n32-import { isPlainObject, show } from '../core/schema';\n33-import type { HumanoidInput } from './humanoid';\n34-\n35-/** The codes this module raises, with their fixes. */\n36-export const STATE_CODES = defineCodes('anim', {\n37-  ANIM_UNKNOWN_STATE: {\n38-    template: '{name} is not a body state{suggestion}; it is ignored',\n39-    fix: 'use one of: {names}',\n40:    doc: 'Raised once per word by the animator (engine/anim/character.ts `step`, through `checkBodyStates`) for a body state outside the vocabulary, usually a typo. Th\n41-  },\n42-  ANIM_BAD_STATE: {\n43-    template: 'body state {name} is {value}, not {expected}{suggestion}; it is ignored',\n44-    fix: 'give {name} {expected}',\n45:    doc: 'Raised once per word by the animator (engine/anim/character.ts `step`, through `checkBodyStates`) for a body state whose value is of the wrong kind: a number\n46-  },\n47-});\n48-\n49-/** The parts that leave a trail, each with the span its ribbon covers. */\n50-export const TRAILS = {\n51-  blade: 'The sword, from near the grip to its tip; another weapon or none trails as `fistR`.',\n52-  fistR: 'The right forearm, elbow to wrist.',\n53-  fistL: 'The left forearm, elbow to wrist.',\n54-  kick: 'The right shin, knee to sole.',\n55-} as const;\n56-\n57-/** A part that leaves a trail. */\n58-export type TrailName = keyof typeof TRAILS;\n59-\n60-/** What a body is told each step: the humanoid's words and the trail. Every word is optional. */\n61-export interface AnimatorInput extends HumanoidInput {\n62-  /** The part that leaves a trail this step (a move's strike sets it, WP 6.1); none when absent. */\n63-  trail?: TrailName;\n64-}\n65-\n66-/** The kind of value a body state takes; a `name` is checked by the body that reads it. */\n67-export type StateKind = 'number' | 'boolean' | 'vector' | 'object' | 'name' | 'trail';\n68-\n69-/** Every body state and the kind of value it takes (`AnimatorInput` documents each word). */\n70:export const BODY_STATES = {\n71-  position: 'vector',\n72-  velocity: 'vector',\n73-  yaw: 'number',","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01MT1UfSKUPYjVQtb7PKx4Nz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
