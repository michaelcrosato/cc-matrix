{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ets8fNAWgy8Zc6WG5GkYZM","type":"tool_result","content":"1\t/**\n2\t * @file Firearms in a scene (PLAN.md WP 13.20; docs/PLAYGROUND.md §7.2): a player carries weapons (the kind `weapon`,\n3\t * engine/world/weapons.ts) in the component `weapons` (`weaponsFor(slots)`, given at spawn: engine/sim/actors.ts's\n4\t * `components`), and the system `weapons` (phase `intents`, after the uses and melee; `addWeapons(w)`, once) plays\n5\t * them, players in id order:\n6\t * - **Drawing and holstering**: `weapon1` and `weapon2` draw a slot, `swap` the other, `holster` puts the weapon away\n7\t *   and draws it again, and the trigger draws one holstered; each takes the weapon's `draw` seconds. Holstered, he\n8\t *   runs on the movement model's holstered speeds (Apex's ×1.15: `motion.holstered`), and his body carries a gun or\n9\t *   nothing (the animator's `weapon`). A melee swing holds the trigger until the hands are back (`MELEE.back`).\n10\t * - **Aiming down the sights** (`aim` held, a weapon out, on foot or in the air): the sights come up over `sights`\n11\t *   seconds (`weapons.aim`), the cone narrowing toward `spread.ads`, and he walks (engine/sim/actorInput.ts).\n12\t * - **Firing** (`fire`: pressed, or held for an automatic one) at the weapon's rate, a round a shot, the magazine's\n13\t *   last bringing the reload on; an empty one clicks (`dry`) and reloads. A shot is hitscan (the physics world's\n14\t *   raycast, `range` long, his own body aside): from his eye toward the step's `aim` when it has a `look` (first\n15\t *   person and the shooter: the crosshair's point), else along the look; without a look, level from his chest toward\n16\t *   the aim (isometric's and top-down's pointer) or where he faces; turned in the aim's own frame (so a cone stays\n17\t *   round at any pitch) by the burst's kick so far and a spread (`spreadOf`) drawn from his stream `weapon`. What it\n18\t *   meets takes it: a person `damage` (engine/sim/damage.ts), a\n19\t *   prop a strike (interact.ts `strikeEntity`, `shot`: a thing a point, a door broken, a pane a point, a dynamic prop\n20\t *   knocked). `shots` and `hits` (a thing standing, a person alive) keep the range's count.\n21\t * - **Reloading** (`reload`, the magazine not full; or at its last round): `reload.tactical` seconds, `reload.empty`\n22\t *   from empty, no shot meanwhile; drawing another or holstering cancels it.\n23\t * - **The kick**: each shot adds its recoil step (`recoilStep`) to `weapons.kick`, degrees up and right, so a burst\n24\t *   climbs; `settle` seconds after the last shot the burst ends and the kick falls away (`recover`, a time constant).\n25\t *   The view tilts the camera by it as it is, so the picture's centre is where the next shot goes.\n26\t *\n27\t * Events: `gunshot` `{ id, weapon, from, to, normal, body, target, hit }` (a miss: `normal` null, `body` and `target`\n28\t * −1, `to` the shot's end), `draw`, `holster`, `reload` and `dry` `{ id, weapon }`.\n29\t *\n30\t * Invariants: everything is in the component (times are the sim's, `w.time`); the spread draws only from\n31\t * `w.rng.entity(id, 'weapon')`; a weapon is asked of its entry. Problems raise `CORE_BAD_SPEC`.\n32\t *\n33\t * @example\n34\t * // defineWeapon('weapon:pistol', { rate: 6, damage: 18, magazine: 12 });\n35\t * // spawnActor(w, { at, character, components: { weapons: weaponsFor(['weapon:pistol']) } }); addWeapons(w);\n36\t * // session.step({ b: ['weapon1'] }); … session.step({ look: [0, 0], b: ['fire'] }); // a `gunshot` event\n37\t * @see engine/sim/weapons.test.ts\n38\t */\n39\timport type { EventMap } from '../core/events';\n40\timport { codeError } from '../core/log';\n41\timport { defineSchema } from '../core/schema';\n42\timport { held, pressed, type Intents } from '../input/intents';\n43\timport { physicsOf } from '../physics/binding';\n44\timport type { GroupName } from '../physics/groups';\n45\timport { getWeapon, recoilStep, spreadOf, type WeaponKind } from '../world/weapons';\n46\timport type { ActorComponents } from './actors';\n47\timport { damage, type Health } from './damage';\n48\timport { EYE, strikeEntity } from './interact';\n49\timport { MELEE, type MeleeState } from './melee';\n50\timport { entityOfBody } from './props';\n51\timport { defineComponent } from './state';\n52\timport type { World } from './world';\n53\t\n54\tconst DEG = Math.PI / 180;\n55\t\n56\t/** The component `weapons`' fields (see the file comment). */\n57\texport const WEAPONS_FIELDS = defineSchema({\n58\t  slots: { type: 'array', items: { type: 'string' }, default: [], description: 'The weapons carried, by id, in slot order.' }, // prettier-ignore\n59\t  slot: { type: 'integer', default: -1, minimum: -1, description: 'The slot out (−1: holstered).' },\n60\t  last: { type: 'integer', default: 0, minimum: 0, description: 'The slot drawn last: what `holster` draws again.' },\n61\t  mags: { type: 'array', items: { type: 'number' }, default: [], description: 'Rounds in each slot’s magazine.' },\n62\t  ready: { type: 'number', default: 0, unit: 's', description: 'When the weapon out is ready to fire: its draw done (a swing holds the trigger apart: MELEE.back).' }, // prettier-ignore\n63\t  next: { type: 'number', default: 0, unit: 's', description: 'When its rate lets it fire again.' },\n64\t  reload: { type: 'number', default: -1, unit: 's', description: 'When the reload under way ends (−1: none).' },\n65\t  burst: { type: 'integer', default: 0, minimum: 0, description: 'Shots in the burst under way.' },\n66\t  kick: { type: 'array', items: { type: 'number' }, default: [0, 0], unit: 'deg', description: 'The burst’s kick so far, [up, right].' }, // prettier-ignore\n67\t  shot: { type: 'number', default: -1, unit: 's', description: 'When it last fired (−1: never).' },\n68\t  shots: { type: 'integer', default: 0, minimum: 0, description: 'Shots fired, all told.' },\n69\t  hits: { type: 'integer', default: 0, minimum: 0, description: 'Shots that struck a target: a thing standing, a person alive.' }, // prettier-ignore\n70\t  aim: { type: 'number', default: 0, minimum: 0, maximum: 1, description: 'How far the sights are up, 0 to 1.' },\n71\t});\n72\t\n73\t/** A player's weapons (`WEAPONS_FIELDS` says what each field means). */\n74\texport interface WeaponsState {\n75\t  slots: string[];\n76\t  slot: number;\n77\t  last: number;\n78\t  mags: number[];\n79\t  ready: number;\n80\t  next: number;\n81\t  reload: number;\n82\t  burst: number;\n83\t  kick: [number, number];\n84\t  shot: number;\n85\t  shots: number;\n86\t  hits: number;\n87\t  aim: number;\n88\t}\n89\t\n90\tdefineComponent('weapons', { description: 'The weapons a player carries and how they stand (WP 13.20).', fields: WEAPONS_FIELDS }); // prettier-ignore\n91\t\n92\t/** A player's weapons component carrying `slots` (weapon ids), each magazine full, holstered unless `drawn`. */\n93\texport function weaponsFor(slots: readonly string[], drawn = -1): WeaponsState {\n94\t  if (!slots.length || drawn < -1 || drawn >= slots.length) throw codeError('CORE_BAD_SPEC', { where: 'weaponsFor(slots, drawn)', problems: `${JSON.stringify(slots)}, ${drawn}: give a weapon or more and a slot of them (−1: holstered)` }); // prettier-ignore\n95\t  const mags = slots.map((id) => getWeapon(id).magazine);\n96\t  return { slots: [...slots], slot: drawn, last: Math.max(0, drawn), mags, ready: 0, next: 0, reload: -1, burst: 0, kick: [0, 0], shot: -1, shots: 0, hits: 0, aim: 0 }; // prettier-ignore\n97\t}\n98\t\n99\t/** Adds the system `weapons` to `w` (once): see the file comment. */\n100\texport function addWeapons<C extends object, E extends EventMap>(world: World<C, E>): void {\n101\t  const w = world as unknown as World;\n102\t  if (!w.systems.has('weapons')) w.systems.add('weapons', stepWeapons, { phase: 'intents' });\n103\t}\n104\t\n105\t/** A player as this module reads him. */\n106\ttype Player = ActorComponents & {\n107\t  id: number;\n108\t  weapons: WeaponsState;\n109\t  melee?: MeleeState;\n110\t  motion?: { mode?: string; stance?: string; holstered?: boolean };\n111\t  animator?: { weapon: string };\n112\t};\n113\t\n114\t/** The groups a shot meets: the level, props, people and crowds. */\n115\tconst SHOT_GROUPS: readonly GroupName[] = ['world', 'prop', 'actor', 'crowd', 'flyer'];\n116\t/**\n117\t * How high a shot leaves the chest without a look (m over the feet; crouched): isometric's, top-down's, the\n118\t * platformer's. The view meets the pointer's ray at this height (engine/app/view.ts), so the pointer over a body aims\n119\t * at it.\n120\t */\n121\texport const CHEST = { stand: 1.3, crouch: 0.75 } as const;\n122\t/** The moves he may fire in: on foot and in the air (his hands are on a ledge, a wall, a rung or the cable otherwise). */\n123\tconst FIRING = new Set(['ground', 'air']);\n124\t\n125\t/** Draws slot `slot` (see the file comment). */\n126\tfunction draw(w: World, e: Player, slot: number): void {\n127\t  const W = e.weapons;\n128\t  const kind = getWeapon(W.slots[slot]);\n129\t  [W.slot, W.last, W.ready, W.reload, W.burst, W.kick] = [slot, slot, w.time + kind.draw, -1, 0, [0, 0]];\n130\t  w.emit('draw', { id: e.id, weapon: kind.id });\n131\t}\n132\t\n133\t/** Puts the weapon out away (see the file comment). */\n134\tfunction holster(w: World, e: Player): void {\n135\t  const W = e.weapons;\n136\t  const kind = getWeapon(W.slots[W.slot]);\n137\t  [W.slot, W.ready, W.reload, W.burst, W.kick, W.aim] = [-1, w.time + kind.draw, -1, 0, [0, 0], 0];\n138\t  w.emit('holster', { id: e.id, weapon: kind.id });\n139\t}\n140\t\n141\t/** Where a shot of `e` leaves and the way it goes before its kick and spread (see the file comment). */\n142\tfunction aimOf(e: Player, intents: Intents): { from: [number, number, number]; yaw: number; pitch: number } {\n143\t  const { x, y, z, yaw } = e.actor;\n144\t  const crouched = e.motion?.stance === 'crouch';\n145\t  const [ax, ay, az] = intents.aim ?? [];\n146\t  if (intents.look) {\n147\t    const from: [number, number, number] = [x, y + (crouched ? EYE.crouch : EYE.stand), z];\n148\t    const [dx, dy, dz] = ax === undefined ? [0, 0, 0] : [ax - from[0], ay! - from[1], az! - from[2]];\n149\t    const flat = Math.hypot(dx, dz);\n150\t    if (Math.hypot(flat, dy) > 0.5) return { from, yaw: Math.atan2(dx, dz), pitch: Math.atan2(dy, flat) };\n151\t    return { from, yaw: intents.look[0], pitch: intents.look[1] };\n152\t  }\n153\t  const from: [number, number, number] = [x, y + (crouched ? CHEST.crouch : CHEST.stand), z];\n154\t  const toward = ax !== undefined && Math.hypot(ax - x, az! - z) > 0.05;\n155\t  return { from, yaw: toward ? Math.atan2(ax - x, az! - z) : yaw, pitch: 0 };\n156\t}\n157\t\n158\t/**\n159\t * The way `up` rad above and `right` rad to the right of the aim (`yaw`, `pitch`) goes, turned in the aim's own frame\n160\t * (its forward, his right, and the up across them), so a cone of offsets stays round at any pitch.\n161\t */\n162\tfunction turned(yaw: number, pitch: number, up: number, right: number): [number, number, number] {\n163\t  const [sy, cy, sp, cp] = [Math.sin(yaw), Math.cos(yaw), Math.sin(pitch), Math.cos(pitch)];\n164\t  const [f, r, u] = [[sy * cp, sp, cy * cp], [-cy, 0, sy], [-sy * sp, cp, -cy * sp]]; // prettier-ignore\n165\t  const t = Math.hypot(up, right);\n166\t  const [c, k] = t < 1e-12 ? [1, 0] : [Math.cos(t), Math.sin(t) / t];\n167\t  return [0, 1, 2].map((i) => f[i] * c + (u[i] * up + r[i] * right) * k) as [number, number, number];\n168\t}\n169\t\n170\t/** Fires one shot of `kind` from `e` (see the file comment). */\n171\tfunction shoot(w: World, e: Player, kind: WeaponKind, intents: Intents): void {\n172\t  const W = e.weapons;\n173\t  const { from, yaw, pitch } = aimOf(e, intents);\n174\t  const spread = spreadOf(kind, W.aim, Math.hypot(e.actor.vx, e.actor.vz) > 0.5);\n175\t  const rng = w.rng.entity(e.id, 'weapon');\n176\t  const [turn, out] = [rng.next() * 2 * Math.PI, spread * Math.sqrt(rng.next())];\n177\t  const dir = turned(yaw, pitch, (W.kick[0] + out * Math.sin(turn)) * DEG, (W.kick[1] + out * Math.cos(turn)) * DEG);\n178\t  const step = recoilStep(kind, W.burst);\n179\t  [W.kick, W.burst, W.shot, W.shots] = [[W.kick[0] + step[0], W.kick[1] + step[1]], W.burst + 1, w.time, W.shots + 1];\n180\t  W.mags[W.slot] -= 1;\n181\t  const hit = physicsOf(w).raycast(from, dir, { maxDistance: kind.range, groups: SHOT_GROUPS, exclude: e.actor.body });\n182\t  const to: [number, number, number] = hit ? [hit.point.x, hit.point.y, hit.point.z] : [from[0] + dir[0] * kind.range, from[1] + dir[1] * kind.range, from[2] + dir[2] * kind.range]; // prettier-ignore\n183\t  const target = hit ? entityOfBody(w, hit.body) : -1;\n184\t  const struck = target >= 0 ? (w.get(target) as unknown as { thing?: { state: string }; health?: Health; sceneProp?: object }) : undefined; // prettier-ignore\n185\t  const counted = !!struck && (struck.thing?.state === 'up' || (!!struck.health && struck.health.hp > 0));\n186\t  if (struck?.sceneProp) strikeEntity(w, target, from, true, 'shot');\n187\t  else if (struck?.health) damage(w, { id: target, health: struck.health }, { amount: kind.damage, from, direction: dir, at: to, source: e.id }); // prettier-ignore\n188\t  if (counted) W.hits += 1;\n189\t  const normal = hit ? [hit.normal.x, hit.normal.y, hit.normal.z] : null;\n190\t  w.emit('gunshot', { id: e.id, weapon: kind.id, from, to, normal, body: hit?.body ?? -1, target, hit: counted });\n191\t}\n192\t\n193\t/** Begins a reload of the weapon out (see the file comment). */\n194\tfunction reload(w: World, e: Player, kind: WeaponKind): void {\n195\t  const W = e.weapons;\n196\t  W.reload = w.time + (W.mags[W.slot] > 0 ? kind.reload.tactical : kind.reload.empty);\n197\t  w.emit('reload', { id: e.id, weapon: kind.id });\n198\t}\n199\t\n200\t/** One step of `e`'s weapons (see the file comment). */\n201\tfunction stepOne(w: World, e: Player, intents: Intents): void {\n202\t  const W = e.weapons;\n203\t  const other = W.slot >= 0 ? (W.slot + 1) % W.slots.length : W.last;\n204\t  const want = pressed(intents, 'weapon1') ? 0 : pressed(intents, 'weapon2') ? 1 : pressed(intents, 'swap') ? other : -1; // prettier-ignore\n205\t  if (want >= 0 && want < W.slots.length && want !== W.slot) draw(w, e, want);\n206\t  else if (pressed(intents, 'holster')) {\n207\t    if (W.slot >= 0) holster(w, e);\n208\t    else draw(w, e, W.last);\n209\t  } else if (W.slot < 0 && pressed(intents, 'fire')) draw(w, e, W.last);\n210\t  if (W.slot < 0) return;\n211\t  const kind = getWeapon(W.slots[W.slot]);\n212\t  if (W.reload >= 0 && w.time >= W.reload - 1e-9) [W.mags[W.slot], W.reload] = [kind.magazine, -1];\n213\t  const up = held(intents, 'aim') && FIRING.has(e.motion?.mode ?? 'ground');\n214\t  W.aim = Math.max(0, Math.min(1, W.aim + (up ? 1 : -1) * (kind.sights > 0 ? w.dt / kind.sights : 1)));\n215\t  if (W.shot >= 0 && w.time - W.shot > kind.settle + 1e-9) {\n216\t    const fall = kind.recover > 0 ? Math.exp(-w.dt / kind.recover) : 0; // the burst over: its kick falls away\n217\t    const kick: [number, number] = [W.kick[0] * fall, W.kick[1] * fall];\n218\t    [W.burst, W.kick] = [0, Math.hypot(kick[0], kick[1]) < 1e-4 ? [0, 0] : kick];\n219\t  }\n220\t  if (pressed(intents, 'reload') && W.reload < 0 && W.mags[W.slot] < kind.magazine) reload(w, e, kind);\n221\t  const trigger = kind.auto ? held(intents, 'fire') : pressed(intents, 'fire');\n222\t  if (!trigger || W.reload >= 0 || w.time < W.ready - 1e-9 || !FIRING.has(e.motion?.mode ?? 'ground')) return;\n223\t  if (e.melee && (e.melee.move !== '' || (e.melee.began >= 0 && (w.tick - e.melee.began) * w.dt < MELEE.back - 1e-9))) return; // prettier-ignore\n224\t  if (W.mags[W.slot] <= 0) {\n225\t    if (pressed(intents, 'fire')) w.emit('dry', { id: e.id, weapon: kind.id });\n226\t    return reload(w, e, kind);\n227\t  }\n228\t  if (w.time < W.next - 1e-9) return;\n229\t  W.next = (kind.auto && w.time - W.next < w.dt ? W.next : w.time) + 1 / kind.rate; // a held trigger keeps the rate\n230\t  shoot(w, e, kind, intents);\n231\t  if (W.mags[W.slot] === 0) reload(w, e, kind); // the last round brings the reload on\n232\t}\n233\t\n234\t/** The system `weapons`: each player's weapons, in id order (see the file comment). */\n235\tfunction stepWeapons(w: World, intents: Intents): void {\n236\t  for (const e of w.query('actor', 'weapons') as unknown as Player[]) {\n237\t    if (!e.actor.player) continue;\n238\t    stepOne(w, e, intents);\n239\t    if (e.motion) e.motion.holstered = e.weapons.slot < 0;\n240\t    if (e.animator) e.animator.weapon = e.weapons.slot >= 0 ? 'gun' : 'none';\n241\t  }\n242\t}\n243\t"}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"02ad4d23-8688-4855-8757-7f5b5003f756","timestamp":"2026-11-05T04:33:49.216Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/engine/sim/weapons.ts","content":"/**\n * @file Firearms in a scene (PLAN.md WP 13.20; docs/PLAYGROUND.md §7.2): a player carries weapons (the kind `weapon`,\n * engine/world/weapons.ts) in the component `weapons` (`weaponsFor(slots)`, given at spawn: engine/sim/actors.ts's\n * `components`), and the system `weapons` (phase `intents`, after the uses and melee; `addWeapons(w)`, once) plays\n * them, players in id order:\n * - **Drawing and holstering**: `weapon1` and `weapon2` draw a slot, `swap` the other, `holster` puts the weapon away\n *   and draws it again, and the trigger draws one holstered; each takes the weapon's `draw` seconds. Holstered, he\n *   runs on the movement model's holstered speeds (Apex's ×1.15: `motion.holstered`), and his body carries a gun or\n *   nothing (the animator's `weapon`). A melee swing holds the trigger until the hands are back (`MELEE.back`).\n * - **Aiming down the sights** (`aim` held, a weapon out, on foot or in the air): the sights come up over `sights`\n *   seconds (`weapons.aim`), the cone narrowing toward `spread.ads`, and he walks (engine/sim/actorInput.ts).\n * - **Firing** (`fire`: pressed, or held for an automatic one) at the weapon's rate, a round a shot, the magazine's\n *   last bringing the reload on; an empty one clicks (`dry`) and reloads. A shot is hitscan (the physics world's\n *   raycast, `range` long, his own body aside): from his eye toward the step's `aim` when it has a `look` (first\n *   person and the shooter: the crosshair's point), else along the look; without a look, level from his chest toward\n *   the aim (isometric's and top-down's pointer) or where he faces; turned in the aim's own frame (so a cone stays\n *   round at any pitch) by the burst's kick so far and a spread (`spreadOf`) drawn from his stream `weapon`. What it\n *   meets takes it: a person `damage` (engine/sim/damage.ts), a\n *   prop a strike (interact.ts `strikeEntity`, `shot`: a thing a point, a door broken, a pane a point, a dynamic prop\n *   knocked). `shots` and `hits` (a thing standing, a person alive) keep the range's count.\n * - **Reloading** (`reload`, the magazine not full; or at its last round): `reload.tactical` seconds, `reload.empty`\n *   from empty, no shot meanwhile; drawing another or holstering cancels it.\n * - **The kick**: each shot adds its recoil step (`recoilStep`) to `weapons.kick`, degrees up and right, so a burst\n *   climbs; `settle` seconds after the last shot the burst ends and the kick falls away (`recover`, a time constant).\n *   The view tilts the camera by it as it is, so the picture's centre is where the next shot goes.\n *\n * Events: `gunshot` `{ id, weapon, from, to, normal, body, target, hit }` (a miss: `normal` null, `body` and `target`\n * −1, `to` the shot's end), `draw`, `holster`, `reload` and `dry` `{ id, weapon }`.\n *\n * Invariants: everything is in the component (times are the sim's, `w.time`); the spread draws only from\n * `w.rng.entity(id, 'weapon')`; a weapon is asked of its entry. Problems raise `CORE_BAD_SPEC`.\n *\n * @example\n * // defineWeapon('weapon:pistol', { rate: 6, damage: 18, magazine: 12 });\n * // spawnActor(w, { at, character, components: { weapons: weaponsFor(['weapon:pistol']) } }); addWeapons(w);\n * // session.step({ b: ['weapon1'] }); … session.step({ look: [0, 0], b: ['fire'] }); // a `gunshot` event\n * @see engine/sim/weapons.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { codeError } from '../core/log';\nimport { defineSchema } from '../core/schema';\nimport { held, pressed, type Intents } from '../input/intents';\nimport { physicsOf } from '../physics/binding';\nimport type { GroupName } from '../physics/groups';\nimport { getWeapon, recoilStep, spreadOf, type WeaponKind } from '../world/weapons';\nimport type { ActorComponents } from './actors';\nimport { damage, type Health } from './damage';\nimport { EYE, strikeEntity } from './interact';\nimport { MELEE, type MeleeState } from './melee';\nimport { entityOfBody } from './props';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\nconst DEG = Math.PI / 180;\n\n/** The component `weapons`' fields (see the file comment). */\nexport const WEAPONS_FIELDS = defineSchema({\n  slots: { type: 'array', items: { type: 'string' }, default: [], description: 'The weapons carried, by id, in slot order.' }, // prettier-ignore\n  slot: { type: 'integer', default: -1, minimum: -1, description: 'The slot out (−1: holstered).' },\n  last: { type: 'integer', default: 0, minimum: 0, description: 'The slot drawn last: what `holster` draws again.' },\n  mags: { type: 'array', items: { type: 'number' }, default: [], description: 'Rounds in each slot’s magazine.' },\n  ready: { type: 'number', default: 0, unit: 's', description: 'When the weapon out is ready to fire: its draw done (a swing holds the trigger apart: MELEE.back).' }, // prettier-ignore\n  next: { type: 'number', default: 0, unit: 's', description: 'When its rate lets it fire again.' },\n  reload: { type: 'number', default: -1, unit: 's', description: 'When the reload under way ends (−1: none).' },\n  burst: { type: 'integer', default: 0, minimum: 0, description: 'Shots in the burst under way.' },\n  kick: { type: 'array', items: { type: 'number' }, default: [0, 0], unit: 'deg', description: 'The burst’s kick so far, [up, right].' }, // prettier-ignore\n  shot: { type: 'number', default: -1, unit: 's', description: 'When it last fired (−1: never).' },\n  shots: { type: 'integer', default: 0, minimum: 0, description: 'Shots fired, all told.' },\n  hits: { type: 'integer', default: 0, minimum: 0, description: 'Shots that struck a target: a thing standing, a person alive.' }, // prettier-ignore\n  aim: { type: 'number', default: 0, minimum: 0, maximum: 1, description: 'How far the sights are up, 0 to 1.' },\n});\n\n/** A player's weapons (`WEAPONS_FIELDS` says what each field means). */\nexport interface WeaponsState {\n  slots: string[];\n  slot: number;\n  last: number;\n  mags: number[];\n  ready: number;\n  next: number;\n  reload: number;\n  burst: number;\n  kick: [number, number];\n  shot: number;\n  shots: number;\n  hits: number;\n  aim: number;\n}\n\ndefineComponent('weapons', { description: 'The weapons a player carries and how they stand (WP 13.20).', fields: WEAPONS_FIELDS }); // prettier-ignore\n\n/** A player's weapons component carrying `slots` (weapon ids), each magazine full, holstered unless `drawn`. */\nexport function weaponsFor(slots: readonly string[], drawn = -1): WeaponsState {\n  if (!slots.length || drawn < -1 || drawn >= slots.length) throw codeError('CORE_BAD_SPEC', { where: 'weaponsFor(slots, drawn)', problems: `${JSON.stringify(slots)}, ${drawn}: give a weapon or more and a slot of them (−1: holstered)` }); // prettier-ignore\n  const mags = slots.map((id) => getWeapon(id).magazine);\n  return { slots: [...slots], slot: drawn, last: Math.max(0, drawn), mags, ready: 0, next: 0, reload: -1, burst: 0, kick: [0, 0], shot: -1, shots: 0, hits: 0, aim: 0 }; // prettier-ignore\n}\n\n/** Adds the system `weapons` to `w` (once): see the file comment. */\nexport function addWeapons<C extends object, E extends EventMap>(world: World<C, E>): void {\n  const w = world as unknown as World;\n  if (!w.systems.has('weapons')) w.systems.add('weapons', stepWeapons, { phase: 'intents' });\n}\n\n/** A player as this module reads him. */\ntype Player = ActorComponents & {\n  id: number;\n  weapons: WeaponsState;\n  melee?: MeleeState;\n  motion?: { mode?: string; stance?: string; holstered?: boolean };\n  animator?: { weapon: string };\n};\n\n/** The groups a shot meets: the level, props, people and crowds. */\nconst SHOT_GROUPS: readonly GroupName[] = ['world', 'prop', 'actor', 'crowd', 'flyer'];\n/**\n * How high a shot leaves the chest without a look (m over the feet; crouched): isometric's, top-down's, the\n * platformer's. The view meets the pointer's ray at this height (engine/app/view.ts), so the pointer over a body aims\n * at it.\n */\nexport const CHEST = { stand: 1.3, crouch: 0.75 } as const;\n/** The moves he may fire in: on foot and in the air (his hands are on a ledge, a wall, a rung or the cable otherwise). */\nconst FIRING = new Set(['ground', 'air']);\n\n/** Draws slot `slot` (see the file comment). */\nfunction draw(w: World, e: Player, slot: number): void {\n  const W = e.weapons;\n  const kind = getWeapon(W.slots[slot]);\n  [W.slot, W.last, W.ready, W.reload, W.burst, W.kick] = [slot, slot, w.time + kind.draw, -1, 0, [0, 0]];\n  w.emit('draw', { id: e.id, weapon: kind.id });\n}\n\n/** Puts the weapon out away (see the file comment). */\nfunction holster(w: World, e: Player): void {\n  const W = e.weapons;\n  const kind = getWeapon(W.slots[W.slot]);\n  [W.slot, W.ready, W.reload, W.burst, W.kick, W.aim] = [-1, w.time + kind.draw, -1, 0, [0, 0], 0];\n  w.emit('holster', { id: e.id, weapon: kind.id });\n}\n\n/** Where a shot of `e` leaves and the way it goes before its kick and spread (see the file comment). */\nfunction aimOf(e: Player, intents: Intents): { from: [number, number, number]; yaw: number; pitch: number } {\n  const { x, y, z, yaw } = e.actor;\n  const crouched = e.motion?.stance === 'crouch';\n  const [ax, ay, az] = intents.aim ?? [];\n  if (intents.look) {\n    const from: [number, number, number] = [x, y + (crouched ? EYE.crouch : EYE.stand), z];\n    const [dx, dy, dz] = ax === undefined ? [0, 0, 0] : [ax - from[0], ay! - from[1], az! - from[2]];\n    const flat = Math.hypot(dx, dz);\n    if (Math.hypot(flat, dy) > 0.5) return { from, yaw: Math.atan2(dx, dz), pitch: Math.atan2(dy, flat) };\n    return { from, yaw: intents.look[0], pitch: intents.look[1] };\n  }\n  const from: [number, number, number] = [x, y + (crouched ? CHEST.crouch : CHEST.stand), z];\n  const toward = ax !== undefined && Math.hypot(ax - x, az! - z) > 0.05;\n  return { from, yaw: toward ? Math.atan2(ax - x, az! - z) : yaw, pitch: 0 };\n}\n\n/**\n * The way `up` rad above and `right` rad to the right of the aim (`yaw`, `pitch`) goes, turned in the aim's own frame\n * (its forward, his right, and the up across them), so a cone of offsets stays round at any pitch.\n */\nfunction turned(yaw: number, pitch: number, up: number, right: number): [number, number, number] {\n  const [sy, cy, sp, cp] = [Math.sin(yaw), Math.cos(yaw), Math.sin(pitch), Math.cos(pitch)];\n  const [f, r, u] = [[sy * cp, sp, cy * cp], [-cy, 0, sy], [-sy * sp, cp, -cy * sp]]; // prettier-ignore\n  const t = Math.hypot(up, right);\n  const [c, k] = t < 1e-12 ? [1, 0] : [Math.cos(t), Math.sin(t) / t];\n  return [0, 1, 2].map((i) => f[i] * c + (u[i] * up + r[i] * right) * k) as [number, number, number];\n}\n\n/** Fires one shot of `kind` from `e` (see the file comment). */\nfunction shoot(w: World, e: Player, kind: WeaponKind, intents: Intents): void {\n  const W = e.weapons;\n  const { from, yaw, pitch } = aimOf(e, intents);\n  const spread = spreadOf(kind, W.aim, Math.hypot(e.actor.vx, e.actor.vz) > 0.5);\n  const rng = w.rng.entity(e.id, 'weapon');\n  const [turn, out] = [rng.next() * 2 * Math.PI, spread * Math.sqrt(rng.next())];\n  const dir = turned(yaw, pitch, (W.kick[0] + out * Math.sin(turn)) * DEG, (W.kick[1] + out * Math.cos(turn)) * DEG);\n  const step = recoilStep(kind, W.burst);\n  [W.kick, W.burst, W.shot, W.shots] = [[W.kick[0] + step[0], W.kick[1] + step[1]], W.burst + 1, w.time, W.shots + 1];\n  W.mags[W.slot] -= 1;\n  const hit = physicsOf(w).raycast(from, dir, { maxDistance: kind.range, groups: SHOT_GROUPS, exclude: e.actor.body });\n  const to: [number, number, number] = hit ? [hit.point.x, hit.point.y, hit.point.z] : [from[0] + dir[0] * kind.range, from[1] + dir[1] * kind.range, from[2] + dir[2] * kind.range]; // prettier-ignore\n  const target = hit ? entityOfBody(w, hit.body) : -1;\n  const struck = target >= 0 ? (w.get(target) as unknown as { thing?: { state: string }; health?: Health; sceneProp?: object }) : undefined; // prettier-ignore\n  const counted = !!struck && (struck.thing?.state === 'up' || (!!struck.health && struck.health.hp > 0));\n  if (struck?.sceneProp) strikeEntity(w, target, from, true, 'shot');\n  else if (struck?.health) damage(w, { id: target, health: struck.health }, { amount: kind.damage, from, direction: dir, at: to, source: e.id }); // prettier-ignore\n  if (counted) W.hits += 1;\n  const normal = hit ? [hit.normal.x, hit.normal.y, hit.normal.z] : null;\n  w.emit('gunshot', { id: e.id, weapon: kind.id, from, to, normal, body: hit?.body ?? -1, target, hit: counted });\n}\n\n/** Begins a reload of the weapon out (see the file comment). */\nfunction reload(w: World, e: Player, kind: WeaponKind): void {\n  const W = e.weapons;\n  W.reload = w.time + (W.mags[W.slot] > 0 ? kind.reload.tactical : kind.reload.empty);\n  w.emit('reload', { id: e.id, weapon: kind.id });\n}\n\n/** One step of `e`'s weapons (see the file comment). */\nfunction stepOne(w: World, e: Player, intents: Intents): void {\n  const W = e.weapons;\n  const other = W.slot >= 0 ? (W.slot + 1) % W.slots.length : W.last;\n  const want = pressed(intents, 'weapon1') ? 0 : pressed(intents, 'weapon2') ? 1 : pressed(intents, 'swap') ? other : -1; // prettier-ignore\n  if (want >= 0 && want < W.slots.length && want !== W.slot) draw(w, e, want);\n  else if (pressed(intents, 'holster')) {\n    if (W.slot >= 0) holster(w, e);\n    else draw(w, e, W.last);\n  } else if (W.slot < 0 && pressed(intents, 'fire')) draw(w, e, W.last);\n  if (W.slot < 0) return;\n  const kind = getWeapon(W.slots[W.slot]);\n  if (W.reload >= 0 && w.time >= W.reload - 1e-9) [W.mags[W.slot], W.reload] = [kind.magazine, -1];\n  const up = held(intents, 'aim') && FIRING.has(e.motion?.mode ?? 'ground');\n  W.aim = Math.max(0, Math.min(1, W.aim + (up ? 1 : -1) * (kind.sights > 0 ? w.dt / kind.sights : 1)));\n  if (W.shot >= 0 && w.time - W.shot > kind.settle + 1e-9) {\n    const fall = kind.recover > 0 ? Math.exp(-w.dt / kind.recover) : 0; // the burst over: its kick falls away\n    const kick: [number, number] = [W.kick[0] * fall, W.kick[1] * fall];\n    [W.burst, W.kick] = [0, Math.hypot(kick[0], kick[1]) < 1e-4 ? [0, 0] : kick];\n  }\n  if (pressed(intents, 'reload') && W.reload < 0 && W.mags[W.slot] < kind.magazine) reload(w, e, kind);\n  const trigger = kind.auto ? held(intents, 'fire') : pressed(intents, 'fire');\n  if (!trigger || W.reload >= 0 || w.time < W.ready - 1e-9 || !FIRING.has(e.motion?.mode ?? 'ground')) return;\n  if (e.melee && (e.melee.move !== '' || (e.melee.began >= 0 && (w.tick - e.melee.began) * w.dt < MELEE.back - 1e-9))) return; // prettier-ignore\n  if (W.mags[W.slot] <= 0) {\n    if (pressed(intents, 'fire')) w.emit('dry', { id: e.id, weapon: kind.id });\n    return reload(w, e, kind);\n  }\n  if (w.time < W.next - 1e-9) return;\n  W.next = (kind.auto && w.time - W.next < w.dt ? W.next : w.time) + 1 / kind.rate; // a held trigger keeps the rate\n  shoot(w, e, kind, intents);\n  if (W.mags[W.slot] === 0) reload(w, e, kind); // the last round brings the reload on\n}\n\n/** The system `weapons`: each player's weapons, in id order (see the file comment). */\nfunction stepWeapons(w: World, intents: Intents): void {\n  for (const e of w.query('actor', 'weapons') as unknown as Player[]) {\n    if (!e.actor.player) continue;\n    stepOne(w, e, intents);\n    if (e.motion) e.motion.holstered = e.weapons.slot < 0;\n    if (e.animator) e.animator.weapon = e.weapons.slot >= 0 ? 'gun' : 'none';\n  }\n}\n","numLines":243,"startLine":1,"totalLines":243}},"tool_result_meta":[{"id":"toolu_01Ets8fNAWgy8Zc6WG5GkYZM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SYMHK7kLF3YNVH776G7J99","type":"tool_result","content":"1\t/**\n2\t * @file Melee (PLAN.md WP 13.19; docs/PLAYGROUND.md §3.2, §7.1, §7.3): a player's punch and kicks, as Apex Legends'\n3\t * melee. `addMelee(w)` (a scene's setup, once, after `addInteraction`) adds the system `melee` (phase `intents`, after\n4\t * the uses, before the actors move). A `melee` press, no use held and nothing carried, swings once the hands are back\n5\t * (`MELEE.back` after the last swing began). It swings at the nearest thing in reach that takes a strike\n6\t * (`meleeTargets`: of the bodies a fan of rays meets across `MELEE.cone` and `MELEE.reach` from the player's axis,\n7\t * turned where the step turns him, toward its aim, else along its look, engine/sim/hits.ts `fanHits`, a prop that\n8\t * takes one, interact.ts `takesStrike`, or an actor with `health`), and picks\n9\t * its move: the target's own (its strikable entry's `move`: a door's kick, `move:breach`), else from a slide the\n10\t * uppercut, in the air the kick, else the punch (`MELEE_MOVES`). The move plays as an `Attack` (engine/anim/attack.ts),\n11\t * its wind drawn out so its hit lands no sooner than `MELEE.lunge` after the press; until then the player lunges at\n12\t * the target, his speed toward it set each step to close the gap to the move's own reach (engine/anim/moves.ts\n13\t * `measureMove`) by then. While its hit window is open the swing strikes once, at the first target in reach (the one\n14\t * it swung at while that is): an actor with `health` takes `MELEE.damage` (engine/sim/damage.ts `damage`), anything\n15\t * else `strikeEntity`, faced only when it was the swing's target as it began (a door bursts open, then breaks: Apex's\n16\t * rule); either asks for a `MELEE.stop` hit-stop. Each step the animator is told the move (`states.body`), so third\n17\t * person shows it and first person's arms and kicking leg follow (engine/gfx/viewmodel/rig.ts); a hit's step\n18\t * (`melee.hitAt`) kicks and shakes the view (engine/gfx/cameras/effects.ts).\n19\t *\n20\t * Events: `melee` `{ id, move, target }` as a swing begins; `strike` `{ id, target, move }` when it lands.\n21\t *\n22\t * Invariants: everything a swing is lives in the component `melee` (its attack's state too), so the hash, captures and\n23\t * restores cover it: one `Attack` per move is loaded from it and saved back each step. Players in id order; rays and\n24\t * candidates in a fixed order; no random stream.\n25\t *\n26\t * @example\n27\t * // in a scene's setup, the player first: spawnPlayer(w, at); addInteraction(w); addMelee(w);\n28\t * // session.step({ b: ['melee'] }); // a door 1.2 m ahead: the door kick; 0.83 s on it bursts open\n29\t * // (session.world.get(1) as { melee: MeleeState }).melee.move; // 'move:breach' while it swings\n30\t * @see engine/sim/melee.test.ts\n31\t */\n32\timport { Attack, type AttackState } from '../anim/attack';\n33\timport { measureMove } from '../anim/moves';\n34\timport { getMove } from '../anim/moves-data';\n35\timport type { AnimatorInput } from '../anim/states';\n36\timport type { EventMap } from '../core/events';\n37\timport { defineSchema } from '../core/schema';\n38\timport { held, pressed, type Intents } from '../input/intents';\n39\timport { physicsOf } from '../physics/binding';\n40\timport type { ActorComponents } from './actors';\n41\timport { damage, requestHitStop, type Health } from './damage';\n42\timport { fanHits } from './hits';\n43\timport { strikeEntity, strikeEntry, takesStrike, type InteractorComponent } from './interact';\n44\timport { entityOfBody, propOfBody, type ScenePropComponents } from './props';\n45\timport { defineComponent } from './state';\n46\timport type { World } from './world';\n47\t\n48\tconst DEG = Math.PI / 180;\n49\t\n50\t/** Apex's melee (docs/PLAYGROUND.md §3.2): damage, reach (m) and cone (rad), the lunge, the hands back and the stop (s). */ // prettier-ignore\n51\texport const MELEE = Object.freeze({\n52\t  damage: 30,\n53\t  reach: 1.52,\n54\t  cone: 30 * DEG,\n55\t  lunge: 0.35,\n56\t  back: 0.75,\n57\t  stop: 0.25,\n58\t  /** Ours: the share of the move's reach the lunge closes to, and its top speed (m/s). */\n59\t  near: 0.9,\n60\t  most: 8,\n61\t  /** Ours: the fan's rays across the cone, and their heights over the feet (m; crouched, scaled to the eye). */\n62\t  rays: 5,\n63\t  heights: Object.freeze([0.4, 0.9, 1.4]),\n64\t});\n65\t\n66\t/** The move of each melee but a target's own: the punch, the kick in the air, the uppercut from a slide. */\n67\texport const MELEE_MOVES = Object.freeze({ punch: 'move:cross', air: 'move:kick', slide: 'move:uppercut' });\n68\t\n69\t/** The component `melee`'s fields (see the file comment). */\n70\texport const MELEE_FIELDS = defineSchema({\n71\t  move: { type: 'string', default: '', description: 'The move swinging, by id (\"\": none).' },\n72\t  attack: { type: 'object', default: {}, description: 'Its attack’s state (engine/anim/attack.ts `AttackState`).' },\n73\t  target: { type: 'integer', default: -1, minimum: -1, description: 'What it swung at as the swing began (it faced it); −1: nothing in reach.' }, // prettier-ignore\n74\t  aim: { type: 'array', items: { type: 'number' }, default: [0, 0, 0], unit: 'm', description: 'Where on the target it swung at, from the target’s place.' }, // prettier-ignore\n75\t  close: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'How near that point the lunge brings its axis: the move’s reach.' }, // prettier-ignore\n76\t  began: { type: 'integer', default: -1, minimum: -1, description: 'The step the swing began; −1: never.' },\n77\t  lands: { type: 'integer', default: -1, minimum: -1, description: 'The step its hit window opens: the lunge’s end.' },\n78\t  struck: { type: 'integer', default: -1, minimum: -1, description: 'What this swing struck; −1: nothing yet.' },\n79\t  hitAt: { type: 'integer', default: -1, minimum: -1, description: 'The step its last hit landed (the view’s kick and shake); −1: never.' }, // prettier-ignore\n80\t});\n81\t\n82\t/** A player's swing (`MELEE_FIELDS` says what each field means). */\n83\texport interface MeleeState {\n84\t  move: string;\n85\t  attack: AttackState | Record<string, never>;\n86\t  target: number;\n87\t  aim: [number, number, number];\n88\t  close: number;\n89\t  began: number;\n90\t  lands: number;\n91\t  struck: number;\n92\t  hitAt: number;\n93\t}\n94\t\n95\tdefineComponent('melee', { description: 'A player’s melee swing (WP 13.19).', fields: MELEE_FIELDS });\n96\t\n97\t/** A player as this module reads him. */\n98\ttype Player = ActorComponents & {\n99\t  id: number;\n100\t  melee?: MeleeState;\n101\t  interactor?: InteractorComponent;\n102\t  motion?: { sliding?: boolean; mode?: string; duck?: string };\n103\t  animator?: { build: string; weapon: string; states: Partial<AnimatorInput> };\n104\t};\n105\t\n106\t/** What a swing may land on: a prop, or an actor with its health. */\n107\ttype Target = Partial<ActorComponents> & Partial<ScenePropComponents> & { health?: Health };\n108\t\n109\t/** Adds the system `melee` to `w` (once): see the file comment. */\n110\texport function addMelee<C extends object, E extends EventMap>(world: World<C, E>): void {\n111\t  const w = world as unknown as World;\n112\t  if (!w.systems.has('melee')) w.systems.add('melee', stepMelee, { phase: 'intents' });\n113\t}\n114\t\n115\t/** One `Attack` per move, its wind drawn out so its hit lands no sooner than `MELEE.lunge` (loaded from each swing). */\n116\tconst attacks = new Map<string, Attack>();\n117\t\n118\t/** The attack playing `move` (see `attacks`). */\n119\tfunction attackFor(move: string): Attack {\n120\t  let attack = attacks.get(move);\n121\t  if (!attack) {\n122\t    const m = getMove(move);\n123\t    const wind = Math.max(m.time.wind, MELEE.lunge - m.hitAt * m.time.active);\n124\t    attacks.set(move, (attack = new Attack(m, { time: { wind } })));\n125\t  }\n126\t  return attack;\n127\t}\n128\t\n129\t/** Where `t` stands (m): an actor's feet, a prop's centre. */\n130\tfunction placeOf(t: Target): [number, number, number] {\n131\t  return t.actor ? [t.actor.x, t.actor.y, t.actor.z] : [t.sceneProp!.x, t.sceneProp!.y, t.sceneProp!.z];\n132\t}\n133\t\n134\t/** What a melee reached: the entity, and the point its ray met (m). */\n135\texport interface MeleeReach {\n136\t  readonly id: number;\n137\t  readonly point: readonly [number, number, number];\n138\t}\n139\t\n140\t/**\n141\t * What the player actor `id` reaches with a melee now, facing `yaw` (rad; his own by default), nearest first (see the\n142\t * file comment): each entity once, a prop that takes a strike or an actor with health, behind no wall.\n143\t */\n144\texport function meleeTargets<C extends object, E extends EventMap>(\n145\t  world: World<C, E>,\n146\t  id: number,\n147\t  yaw?: number,\n148\t): MeleeReach[] {\n149\t  const w = world as unknown as World;\n150\t  const e = w.get(id) as unknown as Player;\n151\t  const { x, y, z, body } = e.actor;\n152\t  const ducked = e.motion?.duck === 'ducked' || e.motion?.duck === 'ducking';\n153\t  const heights = MELEE.heights.map((h) => (ducked ? h * 0.55 : h));\n154\t  const fan = { reach: MELEE.reach, cone: MELEE.cone, rays: MELEE.rays, heights };\n155\t  const found: MeleeReach[] = [];\n156\t  for (const hit of fanHits(physicsOf(w), [x, y, z], yaw ?? e.actor.yaw, fan, { exclude: body })) {\n157\t    const prop = propOfBody(w, hit.body);\n158\t    const other = entityOfBody(w, hit.body);\n159\t    if (other < 0 || found.some((f) => f.id === other)) continue;\n160\t    const health = (w.get(other) as unknown as Target).health;\n161\t    if (prop >= 0 ? takesStrike(w, prop) : !!health && health.hp > 0) found.push({ id: other, point: hit.point });\n162\t  }\n163\t  return found;\n164\t}\n165\t\n166\t/** Whether `melee` may swing at step `tick`: no swing playing, and the hands back from the last. */\n167\tconst ready = (melee: MeleeState, tick: number, dt: number) => melee.move === '' && (melee.began < 0 || (tick - melee.began) * dt >= MELEE.back - 1e-9); // prettier-ignore\n168\t\n169\t/** Begins a swing for the player `e` (see the file comment). */\n170\tfunction begin(w: World, e: Player, melee: MeleeState, yaw: number): void {\n171\t  const target = meleeTargets(w, e.id, yaw)[0];\n172\t  const own = target ? strikeEntry(w, target.id)?.move : '';\n173\t  const move = own || (e.motion?.sliding ? MELEE_MOVES.slide : !e.actor.grounded ? MELEE_MOVES.air : MELEE_MOVES.punch);\n174\t  const attack = attackFor(move);\n175\t  attack.cancel(); // shared by every swing of this move: whatever it last held, it begins afresh\n176\t  attack.start();\n177\t  const { wind, active } = attack.move.time;\n178\t  const place = target ? placeOf(w.get(target.id) as unknown as Target) : null;\n179\t  const look = { build: e.animator?.build ?? 'build:adult', weapon: (e.animator?.weapon ?? 'none') as 'none' };\n180\t  Object.assign(melee, {\n181\t    move,\n182\t    attack: attack.save(),\n183\t    target: target ? target.id : -1,\n184\t    aim:\n185\t      target && place\n186\t        ? [target.point[0] - place[0], target.point[1] - place[1], target.point[2] - place[2]]\n187\t        : [0, 0, 0],\n188\t    close: measureMove(move, look).range * MELEE.near,\n189\t    began: w.tick,\n190\t    lands: w.tick + Math.max(0, Math.ceil((wind + attack.move.hitAt * active) / w.dt - 1e-6) - 1),\n191\t    struck: -1,\n192\t  });\n193\t  w.emit('melee', { id: e.id, move, target: melee.target });\n194\t}\n195\t\n196\t/** Sets the player's speed toward the swing's target to close the gap to its reach by the hit (see the file comment). */\n197\tfunction lunge(w: World, e: Player, melee: MeleeState): void {\n198\t  const target = w.get(melee.target) as unknown as Target | undefined;\n199\t  if (!target || (!target.actor && !target.sceneProp) || w.tick > melee.lands) return;\n200\t  const place = placeOf(target);\n201\t  const [dx, dz] = [place[0] + melee.aim[0] - e.actor.x, place[2] + melee.aim[2] - e.actor.z];\n202\t  const d = Math.hypot(dx, dz);\n203\t  if (d < 1e-6) return;\n204\t  const [ux, uz] = [dx / d, dz / d];\n205\t  const steps = melee.lands - w.tick;\n206\t  const speed = steps > 0 ? Math.min(MELEE.most, Math.max(0, d - melee.close) / (steps * w.dt)) : 0;\n207\t  const along = e.actor.vx * ux + e.actor.vz * uz;\n208\t  [e.actor.vx, e.actor.vz] = [e.actor.vx + (speed - along) * ux, e.actor.vz + (speed - along) * uz];\n209\t}\n210\t\n211\t/** Lands the swing on the first target in reach, the one it swung at while that is (see the file comment). */\n212\tfunction land(w: World, e: Player, melee: MeleeState, yaw: number): void {\n213\t  const reached = meleeTargets(w, e.id, yaw);\n214\t  const hit = reached.find((r) => r.id === melee.target) ?? reached[0];\n215\t  if (!hit) return;\n216\t  const target = w.get(hit.id) as unknown as Target;\n217\t  const from: [number, number, number] = [e.actor.x, e.actor.y + 1, e.actor.z];\n218\t  if (target.sceneProp) {\n219\t    strikeEntity(w, hit.id, from, hit.id === melee.target, 'melee');\n220\t    requestHitStop(w, MELEE.stop);\n221\t  } else damage(w, { id: hit.id, health: target.health }, { amount: MELEE.damage, from, at: hit.point, source: e.id, stop: MELEE.stop }); // prettier-ignore\n222\t  [melee.struck, melee.hitAt] = [hit.id, w.tick];\n223\t  w.emit('strike', { id: e.id, target: hit.id, move: melee.move });\n224\t}\n225\t\n226\t/** Where the player faces this step: toward the aim, else along the look, as the movement model turns him; else his own. */ // prettier-ignore\n227\tfunction facing(e: Player, intents: Intents): number {\n228\t  const [x, , z] = intents.aim ?? [];\n229\t  if (x !== undefined && Math.hypot(x - e.actor.x, z! - e.actor.z) > 0.05) return Math.atan2(x - e.actor.x, z! - e.actor.z); // prettier-ignore\n230\t  return intents.look?.[0] ?? e.actor.yaw;\n231\t}\n232\t\n233\t/** The system `melee`: each player's swing, in id order (see the file comment). */\n234\tfunction stepMelee(w: World, intents: Intents): void {\n235\t  for (const e of w.query('actor') as unknown as Player[]) {\n236\t    if (!e.actor.player) continue;\n237\t    const melee = e.melee ?? (w.add(e.id, 'melee' as never) as unknown as MeleeState);\n238\t    e.melee = melee;\n239\t    const free = !held(intents, 'interact') && (e.interactor?.holding ?? -1) < 0;\n240\t    const footing = !e.motion?.mode || e.motion.mode === 'ground' || e.motion.mode === 'air';\n241\t    const yaw = facing(e, intents);\n242\t    if (pressed(intents, 'melee') && free && footing && ready(melee, w.tick, w.dt)) begin(w, e, melee, yaw);\n243\t    const states = e.animator?.states;\n244\t    if (melee.move === '') {\n245\t      if (states) delete states.body;\n246\t      continue;\n247\t    }\n248\t    const attack = attackFor(melee.move).load(melee.attack as AttackState);\n249\t    attack.update(w.dt);\n250\t    if (melee.struck < 0) lunge(w, e, melee);\n251\t    if (attack.hitOpen && melee.struck < 0) land(w, e, melee, yaw);\n252\t    if (states && attack.busy) states.body = { move: melee.move, phase: attack.phase!, u: attack.u };\n253\t    else if (states) delete states.body;\n254\t    [melee.attack, melee.move] = attack.busy ? [attack.save(), melee.move] : [{}, ''];\n255\t  }\n256\t}\n257\t"}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"e9cc11b6-2d9e-495d-a518-6c0e19f2e395","timestamp":"2026-11-05T04:33:49.219Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/engine/sim/melee.ts","content":"/**\n * @file Melee (PLAN.md WP 13.19; docs/PLAYGROUND.md §3.2, §7.1, §7.3): a player's punch and kicks, as Apex Legends'\n * melee. `addMelee(w)` (a scene's setup, once, after `addInteraction`) adds the system `melee` (phase `intents`, after\n * the uses, before the actors move). A `melee` press, no use held and nothing carried, swings once the hands are back\n * (`MELEE.back` after the last swing began). It swings at the nearest thing in reach that takes a strike\n * (`meleeTargets`: of the bodies a fan of rays meets across `MELEE.cone` and `MELEE.reach` from the player's axis,\n * turned where the step turns him, toward its aim, else along its look, engine/sim/hits.ts `fanHits`, a prop that\n * takes one, interact.ts `takesStrike`, or an actor with `health`), and picks\n * its move: the target's own (its strikable entry's `move`: a door's kick, `move:breach`), else from a slide the\n * uppercut, in the air the kick, else the punch (`MELEE_MOVES`). The move plays as an `Attack` (engine/anim/attack.ts),\n * its wind drawn out so its hit lands no sooner than `MELEE.lunge` after the press; until then the player lunges at\n * the target, his speed toward it set each step to close the gap to the move's own reach (engine/anim/moves.ts\n * `measureMove`) by then. While its hit window is open the swing strikes once, at the first target in reach (the one\n * it swung at while that is): an actor with `health` takes `MELEE.damage` (engine/sim/damage.ts `damage`), anything\n * else `strikeEntity`, faced only when it was the swing's target as it began (a door bursts open, then breaks: Apex's\n * rule); either asks for a `MELEE.stop` hit-stop. Each step the animator is told the move (`states.body`), so third\n * person shows it and first person's arms and kicking leg follow (engine/gfx/viewmodel/rig.ts); a hit's step\n * (`melee.hitAt`) kicks and shakes the view (engine/gfx/cameras/effects.ts).\n *\n * Events: `melee` `{ id, move, target }` as a swing begins; `strike` `{ id, target, move }` when it lands.\n *\n * Invariants: everything a swing is lives in the component `melee` (its attack's state too), so the hash, captures and\n * restores cover it: one `Attack` per move is loaded from it and saved back each step. Players in id order; rays and\n * candidates in a fixed order; no random stream.\n *\n * @example\n * // in a scene's setup, the player first: spawnPlayer(w, at); addInteraction(w); addMelee(w);\n * // session.step({ b: ['melee'] }); // a door 1.2 m ahead: the door kick; 0.83 s on it bursts open\n * // (session.world.get(1) as { melee: MeleeState }).melee.move; // 'move:breach' while it swings\n * @see engine/sim/melee.test.ts\n */\nimport { Attack, type AttackState } from '../anim/attack';\nimport { measureMove } from '../anim/moves';\nimport { getMove } from '../anim/moves-data';\nimport type { AnimatorInput } from '../anim/states';\nimport type { EventMap } from '../core/events';\nimport { defineSchema } from '../core/schema';\nimport { held, pressed, type Intents } from '../input/intents';\nimport { physicsOf } from '../physics/binding';\nimport type { ActorComponents } from './actors';\nimport { damage, requestHitStop, type Health } from './damage';\nimport { fanHits } from './hits';\nimport { strikeEntity, strikeEntry, takesStrike, type InteractorComponent } from './interact';\nimport { entityOfBody, propOfBody, type ScenePropComponents } from './props';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\nconst DEG = Math.PI / 180;\n\n/** Apex's melee (docs/PLAYGROUND.md §3.2): damage, reach (m) and cone (rad), the lunge, the hands back and the stop (s). */ // prettier-ignore\nexport const MELEE = Object.freeze({\n  damage: 30,\n  reach: 1.52,\n  cone: 30 * DEG,\n  lunge: 0.35,\n  back: 0.75,\n  stop: 0.25,\n  /** Ours: the share of the move's reach the lunge closes to, and its top speed (m/s). */\n  near: 0.9,\n  most: 8,\n  /** Ours: the fan's rays across the cone, and their heights over the feet (m; crouched, scaled to the eye). */\n  rays: 5,\n  heights: Object.freeze([0.4, 0.9, 1.4]),\n});\n\n/** The move of each melee but a target's own: the punch, the kick in the air, the uppercut from a slide. */\nexport const MELEE_MOVES = Object.freeze({ punch: 'move:cross', air: 'move:kick', slide: 'move:uppercut' });\n\n/** The component `melee`'s fields (see the file comment). */\nexport const MELEE_FIELDS = defineSchema({\n  move: { type: 'string', default: '', description: 'The move swinging, by id (\"\": none).' },\n  attack: { type: 'object', default: {}, description: 'Its attack’s state (engine/anim/attack.ts `AttackState`).' },\n  target: { type: 'integer', default: -1, minimum: -1, description: 'What it swung at as the swing began (it faced it); −1: nothing in reach.' }, // prettier-ignore\n  aim: { type: 'array', items: { type: 'number' }, default: [0, 0, 0], unit: 'm', description: 'Where on the target it swung at, from the target’s place.' }, // prettier-ignore\n  close: { type: 'number', default: 0, minimum: 0, unit: 'm', description: 'How near that point the lunge brings its axis: the move’s reach.' }, // prettier-ignore\n  began: { type: 'integer', default: -1, minimum: -1, description: 'The step the swing began; −1: never.' },\n  lands: { type: 'integer', default: -1, minimum: -1, description: 'The step its hit window opens: the lunge’s end.' },\n  struck: { type: 'integer', default: -1, minimum: -1, description: 'What this swing struck; −1: nothing yet.' },\n  hitAt: { type: 'integer', default: -1, minimum: -1, description: 'The step its last hit landed (the view’s kick and shake); −1: never.' }, // prettier-ignore\n});\n\n/** A player's swing (`MELEE_FIELDS` says what each field means). */\nexport interface MeleeState {\n  move: string;\n  attack: AttackState | Record<string, never>;\n  target: number;\n  aim: [number, number, number];\n  close: number;\n  began: number;\n  lands: number;\n  struck: number;\n  hitAt: number;\n}\n\ndefineComponent('melee', { description: 'A player’s melee swing (WP 13.19).', fields: MELEE_FIELDS });\n\n/** A player as this module reads him. */\ntype Player = ActorComponents & {\n  id: number;\n  melee?: MeleeState;\n  interactor?: InteractorComponent;\n  motion?: { sliding?: boolean; mode?: string; duck?: string };\n  animator?: { build: string; weapon: string; states: Partial<AnimatorInput> };\n};\n\n/** What a swing may land on: a prop, or an actor with its health. */\ntype Target = Partial<ActorComponents> & Partial<ScenePropComponents> & { health?: Health };\n\n/** Adds the system `melee` to `w` (once): see the file comment. */\nexport function addMelee<C extends object, E extends EventMap>(world: World<C, E>): void {\n  const w = world as unknown as World;\n  if (!w.systems.has('melee')) w.systems.add('melee', stepMelee, { phase: 'intents' });\n}\n\n/** One `Attack` per move, its wind drawn out so its hit lands no sooner than `MELEE.lunge` (loaded from each swing). */\nconst attacks = new Map<string, Attack>();\n\n/** The attack playing `move` (see `attacks`). */\nfunction attackFor(move: string): Attack {\n  let attack = attacks.get(move);\n  if (!attack) {\n    const m = getMove(move);\n    const wind = Math.max(m.time.wind, MELEE.lunge - m.hitAt * m.time.active);\n    attacks.set(move, (attack = new Attack(m, { time: { wind } })));\n  }\n  return attack;\n}\n\n/** Where `t` stands (m): an actor's feet, a prop's centre. */\nfunction placeOf(t: Target): [number, number, number] {\n  return t.actor ? [t.actor.x, t.actor.y, t.actor.z] : [t.sceneProp!.x, t.sceneProp!.y, t.sceneProp!.z];\n}\n\n/** What a melee reached: the entity, and the point its ray met (m). */\nexport interface MeleeReach {\n  readonly id: number;\n  readonly point: readonly [number, number, number];\n}\n\n/**\n * What the player actor `id` reaches with a melee now, facing `yaw` (rad; his own by default), nearest first (see the\n * file comment): each entity once, a prop that takes a strike or an actor with health, behind no wall.\n */\nexport function meleeTargets<C extends object, E extends EventMap>(\n  world: World<C, E>,\n  id: number,\n  yaw?: number,\n): MeleeReach[] {\n  const w = world as unknown as World;\n  const e = w.get(id) as unknown as Player;\n  const { x, y, z, body } = e.actor;\n  const ducked = e.motion?.duck === 'ducked' || e.motion?.duck === 'ducking';\n  const heights = MELEE.heights.map((h) => (ducked ? h * 0.55 : h));\n  const fan = { reach: MELEE.reach, cone: MELEE.cone, rays: MELEE.rays, heights };\n  const found: MeleeReach[] = [];\n  for (const hit of fanHits(physicsOf(w), [x, y, z], yaw ?? e.actor.yaw, fan, { exclude: body })) {\n    const prop = propOfBody(w, hit.body);\n    const other = entityOfBody(w, hit.body);\n    if (other < 0 || found.some((f) => f.id === other)) continue;\n    const health = (w.get(other) as unknown as Target).health;\n    if (prop >= 0 ? takesStrike(w, prop) : !!health && health.hp > 0) found.push({ id: other, point: hit.point });\n  }\n  return found;\n}\n\n/** Whether `melee` may swing at step `tick`: no swing playing, and the hands back from the last. */\nconst ready = (melee: MeleeState, tick: number, dt: number) => melee.move === '' && (melee.began < 0 || (tick - melee.began) * dt >= MELEE.back - 1e-9); // prettier-ignore\n\n/** Begins a swing for the player `e` (see the file comment). */\nfunction begin(w: World, e: Player, melee: MeleeState, yaw: number): void {\n  const target = meleeTargets(w, e.id, yaw)[0];\n  const own = target ? strikeEntry(w, target.id)?.move : '';\n  const move = own || (e.motion?.sliding ? MELEE_MOVES.slide : !e.actor.grounded ? MELEE_MOVES.air : MELEE_MOVES.punch);\n  const attack = attackFor(move);\n  attack.cancel(); // shared by every swing of this move: whatever it last held, it begins afresh\n  attack.start();\n  const { wind, active } = attack.move.time;\n  const place = target ? placeOf(w.get(target.id) as unknown as Target) : null;\n  const look = { build: e.animator?.build ?? 'build:adult', weapon: (e.animator?.weapon ?? 'none') as 'none' };\n  Object.assign(melee, {\n    move,\n    attack: attack.save(),\n    target: target ? target.id : -1,\n    aim:\n      target && place\n        ? [target.point[0] - place[0], target.point[1] - place[1], target.point[2] - place[2]]\n        : [0, 0, 0],\n    close: measureMove(move, look).range * MELEE.near,\n    began: w.tick,\n    lands: w.tick + Math.max(0, Math.ceil((wind + attack.move.hitAt * active) / w.dt - 1e-6) - 1),\n    struck: -1,\n  });\n  w.emit('melee', { id: e.id, move, target: melee.target });\n}\n\n/** Sets the player's speed toward the swing's target to close the gap to its reach by the hit (see the file comment). */\nfunction lunge(w: World, e: Player, melee: MeleeState): void {\n  const target = w.get(melee.target) as unknown as Target | undefined;\n  if (!target || (!target.actor && !target.sceneProp) || w.tick > melee.lands) return;\n  const place = placeOf(target);\n  const [dx, dz] = [place[0] + melee.aim[0] - e.actor.x, place[2] + melee.aim[2] - e.actor.z];\n  const d = Math.hypot(dx, dz);\n  if (d < 1e-6) return;\n  const [ux, uz] = [dx / d, dz / d];\n  const steps = melee.lands - w.tick;\n  const speed = steps > 0 ? Math.min(MELEE.most, Math.max(0, d - melee.close) / (steps * w.dt)) : 0;\n  const along = e.actor.vx * ux + e.actor.vz * uz;\n  [e.actor.vx, e.actor.vz] = [e.actor.vx + (speed - along) * ux, e.actor.vz + (speed - along) * uz];\n}\n\n/** Lands the swing on the first target in reach, the one it swung at while that is (see the file comment). */\nfunction land(w: World, e: Player, melee: MeleeState, yaw: number): void {\n  const reached = meleeTargets(w, e.id, yaw);\n  const hit = reached.find((r) => r.id === melee.target) ?? reached[0];\n  if (!hit) return;\n  const target = w.get(hit.id) as unknown as Target;\n  const from: [number, number, number] = [e.actor.x, e.actor.y + 1, e.actor.z];\n  if (target.sceneProp) {\n    strikeEntity(w, hit.id, from, hit.id === melee.target, 'melee');\n    requestHitStop(w, MELEE.stop);\n  } else damage(w, { id: hit.id, health: target.health }, { amount: MELEE.damage, from, at: hit.point, source: e.id, stop: MELEE.stop }); // prettier-ignore\n  [melee.struck, melee.hitAt] = [hit.id, w.tick];\n  w.emit('strike', { id: e.id, target: hit.id, move: melee.move });\n}\n\n/** Where the player faces this step: toward the aim, else along the look, as the movement model turns him; else his own. */ // prettier-ignore\nfunction facing(e: Player, intents: Intents): number {\n  const [x, , z] = intents.aim ?? [];\n  if (x !== undefined && Math.hypot(x - e.actor.x, z! - e.actor.z) > 0.05) return Math.atan2(x - e.actor.x, z! - e.actor.z); // prettier-ignore\n  return intents.look?.[0] ?? e.actor.yaw;\n}\n\n/** The system `melee`: each player's swing, in id order (see the file comment). */\nfunction stepMelee(w: World, intents: Intents): void {\n  for (const e of w.query('actor') as unknown as Player[]) {\n    if (!e.actor.player) continue;\n    const melee = e.melee ?? (w.add(e.id, 'melee' as never) as unknown as MeleeState);\n    e.melee = melee;\n    const free = !held(intents, 'interact') && (e.interactor?.holding ?? -1) < 0;\n    const footing = !e.motion?.mode || e.motion.mode === 'ground' || e.motion.mode === 'air';\n    const yaw = facing(e, intents);\n    if (pressed(intents, 'melee') && free && footing && ready(melee, w.tick, w.dt)) begin(w, e, melee, yaw);\n    const states = e.animator?.states;\n    if (melee.move === '') {\n      if (states) delete states.body;\n      continue;\n    }\n    const attack = attackFor(melee.move).load(melee.attack as AttackState);\n    attack.update(w.dt);\n    if (melee.struck < 0) lunge(w, e, melee);\n    if (attack.hitOpen && melee.struck < 0) land(w, e, melee, yaw);\n    if (states && attack.busy) states.body = { move: melee.move, phase: attack.phase!, u: attack.u };\n    else if (states) delete states.body;\n    [melee.attack, melee.move] = attack.busy ? [attack.save(), melee.move] : [{}, ''];\n  }\n}\n","numLines":257,"startLine":1,"totalLines":257}},"tool_result_meta":[{"id":"toolu_01SYMHK7kLF3YNVH776G7J99","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X8PgecBpwPVg4VW3DfJx5M","type":"tool_result","content":"1\t/**\n2\t * @file The shooter's camera (PLAN.md WP 13.8 and WP 13.27, docs/PLAYGROUND.md §4; doctrine: Common ground): over the\n3\t * shoulder, as third-person shooters frame it. `stepShoulder` and `shoulderPose` are the pure steps;\n4\t * `createShoulderCamera` wraps them in a camera.\n5\t *\n6\t * The pivot is the hero's eye (`input.eye`, else `SHOULDER.height` above `input.follow`), followed with a time\n7\t * constant of `SHOULDER.lag` real seconds and never more than `SHOULDER.trail` behind it; the shoulder point stands\n8\t * `SHOULDER.right` to its right (to the left once swapped: `side` −1) and `SHOULDER.up` above it, and the camera\n9\t * `SHOULDER.back` behind that along the view, looking along the view (`yaw`, `pitch`), so the screen's centre is\n10\t * where the hero aims and he stands left of it. `input.look` and `input.turn` turn the view, or `input.view` sets it\n11\t * (the sim's look, when no device turns the camera); `input.swap` swaps the shoulder, eased over `SHOULDER.swap`\n12\t * seconds; `input.aim` (0 to 1, how far the sights are raised: engine/gfx/cameras/effects.ts) pulls the arm in to\n13\t * `SHOULDER.aim`. The lens is `input.lens` (the player's field of view, engine/gfx/cameras/rig.ts), else its own.\n14\t *\n15\t * Walls (engine/gfx/cameras/collide.ts, their fixed bodies and shut doors), WP 13.27's rooms: the arm is no\n16\t * longer than the room toward each side (`SHOULDER_ROOM.sides`) plus what it comes in while a turn of the view at\n17\t * `SHOULDER_ROOM.turn` takes it there, nor than the room back from where the shoulder point is going (by his velocity,\n18\t * `input.player`, and its bend, the pitch turning on, `SHOULDER_ROOM.ahead`) plus a share of what it comes in by then;\n19\t * it comes in at up to `COLLIDE_PULL` m/s and goes out eased over `COLLIDE_RETURN`. An arm shorter than\n20\t * `SHOULDER.close` draws the shoulder point in to him by its share and down toward his chest (`SHOULDER.chest` over\n21\t * his feet), letting it out at `SHOULDER.draw` a second. The camera heads for the arm's end as `moveCamera` moves it\n22\t * (`SHOULDER_KEEP`: never through a wall, at its pace, along his trail once out of his sight), carried with the pivot\n23\t * and the view (not with a turn that would carry it into a wall); where his chest stands past `SHOULDER.frame` of the\n24\t * picture's half-height it shifts across the view toward him, its own moves kept to `SHOULDER_ROOM.most` of its pace,\n25\t * under the jump bound. Put elsewhere (the shoulder point further than `COLLIDE_TELEPORT`), it stands at once.\n26\t *\n27\t * Invariants: with `queries` and the eye at least `COLLIDE_RADIUS` from every wall, the camera's ball never ends\n28\t * inside one (shoulder.test.ts); the pitch stays within `SHOULDER_LIMITS.pitch`; the arm reads 28 casts a frame (13\n29\t * sides, 14 ahead, the way) besides `moveCamera`'s. Pure: each step returns a new state.\n30\t *\n31\t * Codes: `cam3=shoulder[,<yaw>,<pitch>,<distance>[,<side>]]` (degrees, metres; side 1 right, −1 left); a bare one\n32\t * looks where the camera before it looked.\n33\t *\n34\t * @example\n35\t * const shoulder = createShoulderCamera();\n36\t * shoulder.update({ follow: [0, 0, 0] }).position; // [-0.5, 1.824, -3.8]: right of and behind his eye, looking along +Z\n37\t * shoulder.code(); // 'cam3=shoulder,0,0,3.8'\n38\t * createShoulderCamera({ side: -1 }).update({ follow: [0, 0, 0] }).position[0]; // 0.5: over his left shoulder\n39\t * @see engine/gfx/cameras/shoulder.test.ts\n40\t */\n41\timport { MathUtils } from '../../core/math';\n42\timport { codeDegrees, codeNumber, followCamera, readCode, type CodePart, type FollowCamera } from './chase';\n43\timport { carry, COLLIDE_PULL, COLLIDE_RADIUS, COLLIDE_RETURN, COLLIDE_SKIN, COLLIDE_TELEPORT, follow, moveCamera, reach, sweep, type CameraBall, type Walls } from './collide'; // prettier-ignore\n44\timport type { CameraPlayer, EffectWeights } from './effects';\n45\timport { approach, makePose, poseForward, poseRight, poseUp, rangeProblems, refuse, wrapAngle, type CameraInput, type CameraPose, type Vec3 } from './pose'; // prettier-ignore\n46\t\n47\tconst DEG = MathUtils.DEG2RAD;\n48\t\n49\t/** The rig's numbers (see the file comment): metres and real seconds; `lens` its own lens, degrees (Apex's 90 at 4:3). */\n50\texport const SHOULDER = Object.freeze({\n51\t  right: 0.5,\n52\t  up: 0.3,\n53\t  back: 3.8,\n54\t  aim: 1.5,\n55\t  height: 1.524,\n56\t  lag: 1 / 20,\n57\t  trail: 0.5,\n58\t  swap: 0.12,\n59\t  close: 1.6,\n60\t  chest: 1.2,\n61\t  draw: 3,\n62\t  frame: 0.6,\n63\t  lens: 73.74,\n64\t});\n65\t/**\n66\t * The room the arm reads (see the file comment): the fastest turn of the view it is ready for, rad/s (a body's own\n67\t * 720°/s, `movement.turnRate`), and the directions it reads either side of straight back, rad; the times ahead it reads\n68\t * along its own way, s (half a second), the share of its pace it comes in by then (room to spare for a way that bends:\n69\t * 3.3 m in all), and the most it carries that way's bend on, m/s² (a fall's, about twice a body's gravity at most).\n70\t */\n71\texport const SHOULDER_ROOM = Object.freeze({\n72\t  turn: 4 * Math.PI,\n73\t  sides: [0, 1, 2, 3, 4, 6, 8].map((k) => (k * Math.PI) / 8),\n74\t  ahead: [1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 18, 22, 26, 30].map((k) => k / 60),\n75\t  pace: 1 / 2,\n76\t  fall: 30,\n77\t  most: 1.5,\n78\t});\n79\t/** How its camera keeps the shoulder point (collide.ts's `moveCamera`): in sight of its own ball, its trail however near. */\n80\texport const SHOULDER_KEEP = Object.freeze({ room: 0, trail: 0 });\n81\t/** The range of the pitch (rad) and of the arm (m). */\n82\texport const SHOULDER_LIMITS = Object.freeze({ pitch: [-1.4, 1.4] as const, distance: [0.5, 20] as const });\n83\t/** Turn rates at full `input.turn`, rad/s: `[right, up]`. */\n84\texport const SHOULDER_TURN_SPEED = Object.freeze([2.2, 1.2] as const);\n85\t/** The effects it takes (engine/gfx/cameras/effects.ts): the lens, the sights, half the roll and the punch. */\n86\texport const SHOULDER_EFFECTS: EffectWeights = Object.freeze({ eye: 0, bob: 0, roll: 0.5, fov: 1, punch: 0.5, aim: 1 }); // prettier-ignore\n87\t\n88\t/** A shoulder camera's input: the devices', the hero's eye and the walls. */\n89\texport interface ShoulderInput extends CameraInput, Walls {\n90\t  /** The hero's eye, m; without it `SHOULDER.height` above `follow`. */\n91\t  readonly eye?: Vec3;\n92\t  /** The view to look along, `[yaw, pitch]` rad, when no device turns the camera (the sim's look). */\n93\t  readonly view?: readonly [number, number];\n94\t  /** Swap the shoulder this frame. */\n95\t  readonly swap?: boolean;\n96\t  /** How far the sights are raised, 0 to 1: the arm pulls in to `SHOULDER.aim`. */\n97\t  readonly aim?: number;\n98\t  /** The lens, vertical degrees: the player's field of view. */\n99\t  readonly lens?: number;\n100\t  /** What he does (engine/gfx/cameras/effects.ts's `cameraPlayer`): his velocity leads the arm's reading ahead. */\n101\t  readonly player?: CameraPlayer | null;\n102\t}\n103\t\n104\t/** A shoulder camera's code as data: without the numbers it looks where the camera before it looked. */\n105\texport interface ShoulderSpec {\n106\t  readonly type: 'shoulder';\n107\t  readonly yaw?: number;\n108\t  readonly pitch?: number;\n109\t  /** The arm when nothing is in the way and the sights are down, m. */\n110\t  readonly distance?: number;\n111\t  /** 1 over the right shoulder, −1 over the left. */\n112\t  readonly side?: number;\n113\t}\n114\t\n115\t/** A shoulder camera's state: plain data, replaced by each step. */\n116\texport interface ShoulderState {\n117\t  readonly yaw: number;\n118\t  readonly pitch: number;\n119\t  readonly distance: number;\n120\t  readonly side: number;\n121\t  /** The side shown, easing toward `side` after a swap. */\n122\t  readonly shown: number;\n123\t  readonly fov: number;\n124\t  /** The pivot, m: the eye with its lag, the walls aside; null until the first follow. */\n125\t  readonly pivot: Vec3 | null;\n126\t  /** The shoulder point after the walls, m. */\n127\t  readonly shoulder: Vec3 | null;\n128\t  /** How far out and up the shoulder point stands, 0 (in at his chest) to 1: a short arm draws it in. */\n129\t  readonly near: number;\n130\t  /** How fast the shoulder point moved over the last frame, m/s; null until it has moved. */\n131\t  readonly went: Vec3 | null;\n132\t  /** The arm now, m: how far back from the shoulder point the camera wants to stand; null until the first follow. */\n133\t  readonly arm: number | null;\n134\t  /** The camera after the walls (collide.ts's `moveCamera`), heading for the arm's end; null until the first follow. */\n135\t  readonly ball: CameraBall | null;\n136\t}\n137\t\n138\t/** Options for a shoulder camera: its code's data, the lens, and the camera before it. */\n139\texport interface ShoulderOptions extends Omit<ShoulderSpec, 'type'> {\n140\t  readonly fov?: number;\n141\t  /** The camera before this one: without a yaw and pitch, it looks the same way. */\n142\t  readonly from?: CameraPose;\n143\t}\n144\t\n145\t/** A checked shoulder state for `options`. Throws `GFX_BAD_CAMERA`. */\n146\texport function shoulderState(options: ShoulderOptions = {}): ShoulderState {\n147\t  const distance = options.distance ?? SHOULDER.back;\n148\t  const side = options.side ?? 1;\n149\t  const state: ShoulderState = {\n150\t    yaw: options.yaw ?? options.from?.yaw ?? 0,\n151\t    pitch: options.pitch ?? options.from?.pitch ?? 0,\n152\t    distance,\n153\t    side,\n154\t    shown: side,\n155\t    fov: options.fov ?? SHOULDER.lens,\n156\t    pivot: null,\n157\t    shoulder: null,\n158\t    near: 1,\n159\t    went: null,\n160\t    arm: null,\n161\t    ball: null,\n162\t  };\n163\t  refuse('the shoulder camera', [\n164\t    ...rangeProblems({\n165\t      yaw: [state.yaw, -1e6, 1e6],\n166\t      pitch: [state.pitch, -Math.PI / 2, Math.PI / 2],\n167\t      distance: [distance, ...SHOULDER_LIMITS.distance],\n168\t      fov: [state.fov, 1, 179],\n169\t    }),\n170\t    ...(side === 1 || side === -1 ? [] : [`side is ${side}; it must be 1 (right) or -1 (left)`]),\n171\t  ]);\n172\t  return { ...state, pitch: MathUtils.clamp(state.pitch, ...SHOULDER_LIMITS.pitch) };\n173\t}\n174\t\n175\t/**\n176\t * The shoulder point for a pivot, a view heading and a side shown: right of and above the pivot, `near` of the way\n177\t * out from his chest (at height `chest`) to there; at the pivot's height above it when no chest is given.\n178\t */\n179\tconst shoulderOf = (pivot: Vec3, yaw: number, shown: number, near = 1, chest = pivot[1]): Vec3 => {\n180\t  const right = poseRight({ yaw });\n181\t  const across = SHOULDER.right * shown * near;\n182\t  const up = chest + (pivot[1] + SHOULDER.up - chest) * near;\n183\t  return [pivot[0] + right[0] * across, up, pivot[2] + right[2] * across];\n184\t};\n185\t\n186\t/** Steps a shoulder camera by one rendered frame (see the file comment). */\n187\texport function stepShoulder(state: ShoulderState, input: ShoulderInput, dt: number): ShoulderState {\n188\t  const right = (input.look?.[0] ?? 0) + (input.turn?.[0] ?? 0) * SHOULDER_TURN_SPEED[0] * dt;\n189\t  const up = (input.look?.[1] ?? 0) + (input.turn?.[1] ?? 0) * SHOULDER_TURN_SPEED[1] * dt;\n190\t  const yaw = input.view ? wrapAngle(input.view[0]) : wrapAngle(state.yaw - right);\n191\t  const pitch = MathUtils.clamp(input.view ? input.view[1] : state.pitch + up, ...SHOULDER_LIMITS.pitch);\n192\t  const side = input.swap ? -state.side : state.side;\n193\t  const shown = side + (state.shown - side) * Math.exp(-dt / SHOULDER.swap);\n194\t  const aim = MathUtils.clamp(input.aim ?? 0, 0, 1);\n195\t  const want = state.distance + (Math.min(SHOULDER.aim, state.distance) - state.distance) * aim;\n196\t  const f = input.follow;\n197\t  const eye: Vec3 | null = input.eye ?? (f ? [f[0], f[1] + SHOULDER.height, f[2]] : null);\n198\t  let pivot = state.pivot;\n199\t  if (eye) {\n200\t    pivot = pivot ? approach(pivot, eye, 1 - Math.exp(-dt / SHOULDER.lag)) : eye;\n201\t    const lag: Vec3 = [pivot[0] - eye[0], pivot[1] - eye[1], pivot[2] - eye[2]];\n202\t    const gap = Math.hypot(...lag);\n203\t    if (gap > SHOULDER.trail) pivot = approach(eye, pivot, SHOULDER.trail / gap); // never more than `trail` behind\n204\t  }\n205\t  if (!pivot) return { ...state, yaw, pitch, side, shown, fov: input.lens ?? state.fov };\n206\t  const held = eye ? sweep(input, eye, pivot) : pivot; // the walls stop the lag; it follows on as it would\n207\t  const fwd = poseForward({ yaw, pitch });\n208\t  const [fx, fy, fz] = fwd;\n209\t  const jumped = !state.shoulder || Math.hypot(...held.map((v, i) => v - state.shoulder![i])) > COLLIDE_TELEPORT;\n210\t  const draw = SHOULDER.draw * dt; // a short arm draws it in, at a pace\n211\t  const back = state.ball && state.shoulder ? Math.max(0, [0, 1, 2].reduce((sum, i) => sum + (state.shoulder![i] - state.ball!.at[i]) * fwd[i], 0)) : null; // prettier-ignore\n212\t  const near = back === null || jumped ? MathUtils.clamp(reach(input, held, [-fwd[0], -fwd[1], -fwd[2]], want) / SHOULDER.close, 0, 1) : Math.min(MathUtils.clamp(Math.min(back, state.arm ?? back) / SHOULDER.close, 0, 1), state.near + draw); // prettier-ignore\n213\t  const chest = (f ? f[1] : held[1] - SHOULDER.height) + SHOULDER.chest;\n214\t  const step = (state.pivot ? Math.hypot(...pivot.map((v, i) => v - state.pivot![i])) : Infinity) + COLLIDE_PULL * dt; // prettier-ignore\n215\t  const shoulder = follow(input, state.shoulder, held, shoulderOf(held, yaw, shown, near, chest), step);\n216\t  // the room the arm will need: back, and each side as far as the view could turn before the arm, coming in, got there\n217\t  let room = want;\n218\t  for (const turn of SHOULDER_ROOM.sides) {\n219\t    for (const sign of turn === 0 ? [1] : [1, -1]) {\n220\t      const [gx, gy, gz] = poseForward({ yaw: yaw + sign * turn, pitch });\n221\t      room = Math.min(room, reach(input, shoulder, [-gx, -gy, -gz], want) + (COLLIDE_PULL * turn) / SHOULDER_ROOM.turn);\n222\t    }\n223\t  }\n224\t  // and back along its own way: from where the shoulder point and the pitch are going (by his velocity where it is\n225\t  // known: the shoulder point follows it a lag behind), as far ahead as the arm, coming in at a share of its pace,\n226\t  // would take to be there (a drop off a ledge, down a hatch, a jamb as he steps past it, a look going up)\n227\t  // (a frame of no time, a page's warm-up or a paused one, reads no way: its rates would divide by 0)\n228\t  const timed = dt > 1e-9;\n229\t  const itself = state.shoulder && timed ? [0, 1, 2].map((i) => (shoulder[i] - state.shoulder![i]) / dt) : null;\n230\t  const went: Vec3 | null = state.shoulder && !jumped && timed ? ((input.player?.velocity ?? itself) as Vec3) : null;\n231\t  if (went) {\n232\t    const bend = state.went ? went.map((v, i) => (v - state.went![i]) / dt) : [0, 0, 0];\n233\t    const most = Math.min(1, SHOULDER_ROOM.fall / Math.max(Math.hypot(...bend), 1e-9));\n234\t    const along = (t: number): Vec3 => [0, 1, 2].map((i) => shoulder[i] + went[i] * t + (bend[i] * most * t * t) / 2) as unknown as Vec3; // prettier-ignore\n235\t    const tilt = (pitch - state.pitch) / dt;\n236\t    const last = SHOULDER_ROOM.ahead[SHOULDER_ROOM.ahead.length - 1];\n237\t    const end = along(last);\n238\t    const way = Math.hypot(...end.map((v, i) => v - shoulder[i]));\n239\t    const open = way > COLLIDE_SKIN ? Math.hypot(...sweep(input, shoulder, end).map((v, i) => v - shoulder[i])) / way : 1; // prettier-ignore\n240\t    for (const t of SHOULDER_ROOM.ahead) {\n241\t      const [gx, gy, gz] = poseForward({ yaw, pitch: MathUtils.clamp(pitch + tilt * t, ...SHOULDER_LIMITS.pitch) });\n242\t      const from = along(Math.min(t, open * last)); // never past what stops it\n243\t      room = Math.min(room, reach(input, from, [-gx, -gy, -gz], want) + COLLIDE_PULL * SHOULDER_ROOM.pace * t);\n244\t    }\n245\t  }\n246\t  const was = state.arm === null || jumped ? room : state.arm;\n247\t  const arm = was > room ? Math.max(room, was - COLLIDE_PULL * dt) : was + (room - was) * (1 - Math.exp(-dt / COLLIDE_RETURN)); // prettier-ignore\n248\t  const end: Vec3 = [shoulder[0] - fx * arm, shoulder[1] - fy * arm, shoulder[2] - fz * arm];\n249\t  // carried with the pivot and the view (with the pivot only where the view's turn would carry it into a wall: a turn\n250\t  // in a corner); what the shoulder point does besides (drawn in, a swap) it follows at its pace\n251\t  const before = state.ball && state.pivot && !jumped ? { base: state.pivot, yaw: state.yaw, pitch: state.pitch } : null; // prettier-ignore\n252\t  const turned = before ? carry(state.ball!.at, before, { base: pivot, yaw, pitch }) : end;\n253\t  const inWall = before !== null && input.queries !== undefined && input.queries.overlap({ type: 'ball', radius: COLLIDE_RADIUS - COLLIDE_SKIN }, turned, { groups: input.groups ?? 'world', exclude: input.exclude, fixed: input.fixed ?? true, also: input.also }).length > 0; // prettier-ignore\n254\t  const carried = inWall ? carry(state.ball!.at, before!, { ...before!, base: pivot }) : turned;\n255\t  const moved = moveCamera(input, before ? state.ball : null, shoulder, carried, end, dt, SHOULDER_KEEP); // never through a wall, at a pace\n256\t  const fov = input.lens ?? state.fov;\n257\t  const own = Math.hypot(...moved.at.map((v, i) => v - carried[i])); // what it moved of itself, besides the carry\n258\t  const spare = Math.max(0, SHOULDER_ROOM.most * COLLIDE_PULL * dt - own);\n259\t  const ball = f ? { ...moved, at: framed(input, moved.at, [f[0], f[1] + SHOULDER.chest, f[2]], { yaw, pitch }, fov, spare) } : moved; // prettier-ignore\n260\t  return { ...state, yaw, pitch, side, shown, fov, pivot, shoulder, near, went, arm, ball };\n261\t}\n262\t\n263\t/**\n264\t * Where a camera at `at` looking along `view` shifts to keep `chest` in its picture (see the file comment): across the\n265\t * view toward it by as much as it stands past `SHOULDER.frame` of the picture's half-height off the middle, up, down or\n266\t * to a side (a square picture: any wider one shows more), at most `most` m, as far as the walls let it.\n267\t */\n268\tfunction framed(\n269\t  walls: Walls,\n270\t  at: Vec3,\n271\t  chest: Vec3,\n272\t  view: { yaw: number; pitch: number },\n273\t  fov: number,\n274\t  most: number,\n275\t): Vec3 {\n276\t  // prettier-ignore\n277\t  const [f, u, r] = [poseForward(view), poseUp(view), poseRight(view)];\n278\t  const rel = [chest[0] - at[0], chest[1] - at[1], chest[2] - at[2]];\n279\t  const along = (axis: Vec3) => rel[0] * axis[0] + rel[1] * axis[1] + rel[2] * axis[2];\n280\t  const half = along(f) * Math.tan((fov * DEG) / 2) * SHOULDER.frame;\n281\t  if (half <= 0) return at; // behind the camera: no shift frames it\n282\t  const off = (v: number) => Math.sign(v) * Math.max(0, Math.abs(v) - half);\n283\t  const [up, across] = [off(along(u)), off(along(r))];\n284\t  const shift = Math.hypot(up, across);\n285\t  if (shift === 0) return at;\n286\t  const k = Math.min(1, most / shift);\n287\t  return sweep(walls, at, [0, 1, 2].map((i) => at[i] + (u[i] * up + r[i] * across) * k) as unknown as Vec3);\n288\t}\n289\t\n290\t/** The shoulder camera's pose: where its ball stands (the arm back from the shoulder point), looking along the view. */\n291\texport function shoulderPose(state: ShoulderState): CameraPose {\n292\t  const at = state.shoulder ?? shoulderOf([0, SHOULDER.height, 0], state.yaw, state.shown);\n293\t  const f = poseForward(state);\n294\t  const position: Vec3 = state.ball?.at ?? [at[0] - f[0] * state.distance, at[1] - f[1] * state.distance, at[2] - f[2] * state.distance]; // prettier-ignore\n295\t  const ahead = (at[0] - position[0]) * f[0] + (at[1] - position[1]) * f[1] + (at[2] - position[2]) * f[2];\n296\t  return makePose({\n297\t    position,\n298\t    yaw: state.yaw,\n299\t    pitch: state.pitch,\n300\t    fov: state.fov,\n301\t    near: 0.05,\n302\t    far: 500,\n303\t    distance: Math.max(ahead, 0.05),\n304\t  });\n305\t}\n306\t\n307\t/** The shoulder camera's code data. */\n308\texport function shoulderSpec(state: ShoulderState): ShoulderSpec {\n309\t  return { type: 'shoulder', yaw: state.yaw, pitch: state.pitch, distance: state.distance, side: state.side };\n310\t}\n311\t\n312\tconst PARTS: readonly CodePart[] = [\n313\t  ['yaw', -1e6, 1e6],\n314\t  ['pitch', SHOULDER_LIMITS.pitch[0] / DEG, SHOULDER_LIMITS.pitch[1] / DEG],\n315\t  ['distance', ...SHOULDER_LIMITS.distance],\n316\t  ['side', -1, 1],\n317\t];\n318\t\n319\t/** Reads a shoulder camera's code: `cam3=shoulder[,<yaw>,<pitch>,<distance>[,<side>]]`. Throws `GFX_BAD_CAMERA_CODE`. */\n320\texport function parseShoulderCode(code: string): ShoulderSpec {\n321\t  const [yaw, pitch, distance, side] = readCode(code, 'shoulder', PARTS, [0, 3, 4]);\n322\t  if (yaw === undefined) return { type: 'shoulder' };\n323\t  const spec: ShoulderSpec = { type: 'shoulder', yaw: yaw * DEG, pitch: pitch * DEG, distance };\n324\t  return side === undefined ? spec : { ...spec, side: side < 0 ? -1 : 1 };\n325\t}\n326\t\n327\t/** The canonical code of a shoulder camera's data (numbers rounded: 0.01°, 0.001 m; the side only when left). */\n328\texport function formatShoulderCode(spec: ShoulderSpec): string {\n329\t  if (spec.yaw === undefined) return 'cam3=shoulder';\n330\t  const parts = [codeDegrees(spec.yaw, true), codeDegrees(spec.pitch ?? 0), codeNumber(spec.distance ?? SHOULDER.back, 3)]; // prettier-ignore\n331\t  return `cam3=shoulder,${parts.join(',')}${spec.side === -1 ? ',-1' : ''}`;\n332\t}\n333\t\n334\t/** A shoulder camera in words. */\n335\texport function describeShoulder(spec: ShoulderSpec, pose: CameraPose): string {\n336\t  const lens = `Shooter camera (perspective, ${codeNumber(pose.fov, 0)}° field of view)`;\n337\t  const where = `over the ${spec.side === -1 ? 'left' : 'right'} shoulder, ${codeNumber(spec.distance ?? SHOULDER.back, 3)} m back`; // prettier-ignore\n338\t  return `${lens}, ${where}, heading ${codeDegrees(pose.yaw, true)}°, pitch ${codeDegrees(pose.pitch)}°`;\n339\t}\n340\t\n341\t/** A shoulder camera: over the hero's shoulder (`input.eye`), turned by the devices, in front of the walls. */\n342\texport function createShoulderCamera(\n343\t  options: ShoulderOptions = {},\n344\t): FollowCamera<'shoulder', ShoulderSpec, ShoulderInput> {\n345\t  const steps = { step: stepShoulder, pose: shoulderPose, spec: shoulderSpec, code: formatShoulderCode, describe: describeShoulder }; // prettier-ignore\n346\t  return followCamera('shoulder', shoulderState(options), steps, { effects: SHOULDER_EFFECTS, fade: true });\n347\t}\n348\t"}]},"parent_tool_use_id":null,"session_id":"ed5deb30-576e-4aa7-93e0-da5eaa4ce63e","uuid":"ad20264a-af1c-43f2-ba64-d8ecbd90fe51","timestamp":"2026-11-05T04:33:49.222Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-212002__x601dca/work/.research/proto/engine/gfx/cameras/shoulder.ts","content":"/**\n * @file The shooter's camera (PLAN.md WP 13.8 and WP 13.27, docs/PLAYGROUND.md §4; doctrine: Common ground): over the\n * shoulder, as third-person shooters frame it. `stepShoulder` and `shoulderPose` are the pure steps;\n * `createShoulderCamera` wraps them in a camera.\n *\n * The pivot is the hero's eye (`input.eye`, else `SHOULDER.height` above `input.follow`), followed with a time\n * constant of `SHOULDER.lag` real seconds and never more than `SHOULDER.trail` behind it; the shoulder point stands\n * `SHOULDER.right` to its right (to the left once swapped: `side` −1) and `SHOULDER.up` above it, and the camera\n * `SHOULDER.back` behind that along the view, looking along the view (`yaw`, `pitch`), so the screen's centre is\n * where the hero aims and he stands left of it. `input.look` and `input.turn` turn the view, or `input.view` sets it\n * (the sim's look, when no device turns the camera); `input.swap` swaps the shoulder, eased over `SHOULDER.swap`\n * seconds; `input.aim` (0 to 1, how far the sights are raised: engine/gfx/cameras/effects.ts) pulls the arm in to\n * `SHOULDER.aim`. The lens is `input.lens` (the player's field of view, engine/gfx/cameras/rig.ts), else its own.\n *\n * Walls (engine/gfx/cameras/collide.ts, their fixed bodies and shut doors), WP 13.27's rooms: the arm is no\n * longer than the room toward each side (`SHOULDER_ROOM.sides`) plus what it comes in while a turn of the view at\n * `SHOULDER_ROOM.turn` takes it there, nor than the room back from where the shoulder point is going (by his velocity,\n * `input.player`, and its bend, the pitch turning on, `SHOULDER_ROOM.ahead`) plus a share of what it comes in by then;\n * it comes in at up to `COLLIDE_PULL` m/s and goes out eased over `COLLIDE_RETURN`. An arm shorter than\n * `SHOULDER.close` draws the shoulder point in to him by its share and down toward his chest (`SHOULDER.chest` over\n * his feet), letting it out at `SHOULDER.draw` a second. The camera heads for the arm's end as `moveCamera` moves it\n * (`SHOULDER_KEEP`: never through a wall, at its pace, along his trail once out of his sight), carried with the pivot\n * and the view (not with a turn that would carry it into a wall); where his chest stands past `SHOULDER.frame` of the\n * picture's half-height it shifts across the view toward him, its own moves kept to `SHOULDER_ROOM.most` of its pace,\n * under the jump bound. Put elsewhere (the shoulder point further than `COLLIDE_TELEPORT`), it stands at once.\n *\n * Invariants: with `queries` and the eye at least `COLLIDE_RADIUS` from every wall, the camera's ball never ends\n * inside one (shoulder.test.ts); the pitch stays within `SHOULDER_LIMITS.pitch`; the arm reads 28 casts a frame (13\n * sides, 14 ahead, the way) besides `moveCamera`'s. Pure: each step returns a new state.\n *\n * Codes: `cam3=shoulder[,<yaw>,<pitch>,<distance>[,<side>]]` (degrees, metres; side 1 right, −1 left); a bare one\n * looks where the camera before it looked.\n *\n * @example\n * const shoulder = createShoulderCamera();\n * shoulder.update({ follow: [0, 0, 0] }).position; // [-0.5, 1.824, -3.8]: right of and behind his eye, looking along +Z\n * shoulder.code(); // 'cam3=shoulder,0,0,3.8'\n * createShoulderCamera({ side: -1 }).update({ follow: [0, 0, 0] }).position[0]; // 0.5: over his left shoulder\n * @see engine/gfx/cameras/shoulder.test.ts\n */\nimport { MathUtils } from '../../core/math';\nimport { codeDegrees, codeNumber, followCamera, readCode, type CodePart, type FollowCamera } from './chase';\nimport { carry, COLLIDE_PULL, COLLIDE_RADIUS, COLLIDE_RETURN, COLLIDE_SKIN, COLLIDE_TELEPORT, follow, moveCamera, reach, sweep, type CameraBall, type Walls } from './collide'; // prettier-ignore\nimport type { CameraPlayer, EffectWeights } from './effects';\nimport { approach, makePose, poseForward, poseRight, poseUp, rangeProblems, refuse, wrapAngle, type CameraInput, type CameraPose, type Vec3 } from './pose'; // prettier-ignore\n\nconst DEG = MathUtils.DEG2RAD;\n\n/** The rig's numbers (see the file comment): metres and real seconds; `lens` its own lens, degrees (Apex's 90 at 4:3). */\nexport const SHOULDER = Object.freeze({\n  right: 0.5,\n  up: 0.3,\n  back: 3.8,\n  aim: 1.5,\n  height: 1.524,\n  lag: 1 / 20,\n  trail: 0.5,\n  swap: 0.12,\n  close: 1.6,\n  chest: 1.2,\n  draw: 3,\n  frame: 0.6,\n  lens: 73.74,\n});\n/**\n * The room the arm reads (see the file comment): the fastest turn of the view it is ready for, rad/s (a body's own\n * 720°/s, `movement.turnRate`), and the directions it reads either side of straight back, rad; the times ahead it reads\n * along its own way, s (half a second), the share of its pace it comes in by then (room to spare for a way that bends:\n * 3.3 m in all), and the most it carries that way's bend on, m/s² (a fall's, about twice a body's gravity at most).\n */\nexport const SHOULDER_ROOM = Object.freeze({\n  turn: 4 * Math.PI,\n  sides: [0, 1, 2, 3, 4, 6, 8].map((k) => (k * Math.PI) / 8),\n  ahead: [1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 18, 22, 26, 30].map((k) => k / 60),\n  pace: 1 / 2,\n  fall: 30,\n  most: 1.5,\n});\n/** How its camera keeps the shoulder point (collide.ts's `moveCamera`): in sight of its own ball, its trail however near. */\nexport const SHOULDER_KEEP = Object.freeze({ room: 0, trail: 0 });\n/** The range of the pitch (rad) and of the arm (m). */\nexport const SHOULDER_LIMITS = Object.freeze({ pitch: [-1.4, 1.4] as const, distance: [0.5, 20] as const });\n/** Turn rates at full `input.turn`, rad/s: `[right, up]`. */\nexport const SHOULDER_TURN_SPEED = Object.freeze([2.2, 1.2] as const);\n/** The effects it takes (engine/gfx/cameras/effects.ts): the lens, the sights, half the roll and the punch. */\nexport const SHOULDER_EFFECTS: EffectWeights = Object.freeze({ eye: 0, bob: 0, roll: 0.5, fov: 1, punch: 0.5, aim: 1 }); // prettier-ignore\n\n/** A shoulder camera's input: the devices', the hero's eye and the walls. */\nexport interface ShoulderInput extends CameraInput, Walls {\n  /** The hero's eye, m; without it `SHOULDER.height` above `follow`. */\n  readonly eye?: Vec3;\n  /** The view to look along, `[yaw, pitch]` rad, when no device turns the camera (the sim's look). */\n  readonly view?: readonly [number, number];\n  /** Swap the shoulder this frame. */\n  readonly swap?: boolean;\n  /** How far the sights are raised, 0 to 1: the arm pulls in to `SHOULDER.aim`. */\n  readonly aim?: number;\n  /** The lens, vertical degrees: the player's field of view. */\n  readonly lens?: number;\n  /** What he does (engine/gfx/cameras/effects.ts's `cameraPlayer`): his velocity leads the arm's reading ahead. */\n  readonly player?: CameraPlayer | null;\n}\n\n/** A shoulder camera's code as data: without the numbers it looks where the camera before it looked. */\nexport interface ShoulderSpec {\n  readonly type: 'shoulder';\n  readonly yaw?: number;\n  readonly pitch?: number;\n  /** The arm when nothing is in the way and the sights are down, m. */\n  readonly distance?: number;\n  /** 1 over the right shoulder, −1 over the left. */\n  readonly side?: number;\n}\n\n/** A shoulder camera's state: plain data, replaced by each step. */\nexport interface ShoulderState {\n  readonly yaw: number;\n  readonly pitch: number;\n  readonly distance: number;\n  readonly side: number;\n  /** The side shown, easing toward `side` after a swap. */\n  readonly shown: number;\n  readonly fov: number;\n  /** The pivot, m: the eye with its lag, the walls aside; null until the first follow. */\n  readonly pivot: Vec3 | null;\n  /** The shoulder point after the walls, m. */\n  readonly shoulder: Vec3 | null;\n  /** How far out and up the shoulder point stands, 0 (in at his chest) to 1: a short arm draws it in. */\n  readonly near: number;\n  /** How fast the shoulder point moved over the last frame, m/s; null until it has moved. */\n  readonly went: Vec3 | null;\n  /** The arm now, m: how far back from the shoulder point the camera wants to stand; null until the first follow. */\n  readonly arm: number | null;\n  /** The camera after the walls (collide.ts's `moveCamera`), heading for the arm's end; null until the first follow. */\n  readonly ball: CameraBall | null;\n}\n\n/** Options for a shoulder camera: its code's data, the lens, and the camera before it. */\nexport interface ShoulderOptions extends Omit<ShoulderSpec, 'type'> {\n  readonly fov?: number;\n  /** The camera before this one: without a yaw and pitch, it looks the same way. */\n  readonly from?: CameraPose;\n}\n\n/** A checked shoulder state for `options`. Throws `GFX_BAD_CAMERA`. */\nexport function shoulderState(options: ShoulderOptions = {}): ShoulderState {\n  const distance = options.distance ?? SHOULDER.back;\n  const side = options.side ?? 1;\n  const state: ShoulderState = {\n    yaw: options.yaw ?? options.from?.yaw ?? 0,\n    pitch: options.pitch ?? options.from?.pitch ?? 0,\n    distance,\n    side,\n    shown: side,\n    fov: options.fov ?? SHOULDER.lens,\n    pivot: null,\n    shoulder: null,\n    near: 1,\n    went: null,\n    arm: null,\n    ball: null,\n  };\n  refuse('the shoulder camera', [\n    ...rangeProblems({\n      yaw: [state.yaw, -1e6, 1e6],\n      pitch: [state.pitch, -Math.PI / 2, Math.PI / 2],\n      distance: [distance, ...SHOULDER_LIMITS.distance],\n      fov: [state.fov, 1, 179],\n    }),\n    ...(side === 1 || side === -1 ? [] : [`side is ${side}; it must be 1 (right) or -1 (left)`]),\n  ]);\n  return { ...state, pitch: MathUtils.clamp(state.pitch, ...SHOULDER_LIMITS.pitch) };\n}\n\n/**\n * The shoulder point for a pivot, a view heading and a side shown: right of and above the pivot, `near` of the way\n * out from his chest (at height `chest`) to there; at the pivot's height above it when no chest is given.\n */\nconst shoulderOf = (pivot: Vec3, yaw: number, shown: number, near = 1, chest = pivot[1]): Vec3 => {\n  const right = poseRight({ yaw });\n  const across = SHOULDER.right * shown * near;\n  const up = chest + (pivot[1] + SHOULDER.up - chest) * near;\n  return [pivot[0] + right[0] * across, up, pivot[2] + right[2] * across];\n};\n\n/** Steps a shoulder camera by one rendered frame (see the file comment). */\nexport function stepShoulder(state: ShoulderState, input: ShoulderInput, dt: number): ShoulderState {\n  const right = (input.look?.[0] ?? 0) + (input.turn?.[0] ?? 0) * SHOULDER_TURN_SPEED[0] * dt;\n  const up = (input.look?.[1] ?? 0) + (input.turn?.[1] ?? 0) * SHOULDER_TURN_SPEED[1] * dt;\n  const yaw = input.view ? wrapAngle(input.view[0]) : wrapAngle(state.yaw - right);\n  const pitch = MathUtils.clamp(input.view ? input.view[1] : state.pitch + up, ...SHOULDER_LIMITS.pitch);\n  const side = input.swap ? -state.side : state.side;\n  const shown = side + (state.shown - side) * Math.exp(-dt / SHOULDER.swap);\n  const aim = MathUtils.clamp(input.aim ?? 0, 0, 1);\n  const want = state.distance + (Math.min(SHOULDER.aim, state.distance) - state.distance) * aim;\n  const f = input.follow;\n  const eye: Vec3 | null = input.eye ?? (f ? [f[0], f[1] + SHOULDER.height, f[2]] : null);\n  let pivot = state.pivot;\n  if (eye) {\n    pivot = pivot ? approach(pivot, eye, 1 - Math.exp(-dt / SHOULDER.lag)) : eye;\n    const lag: Vec3 = [pivot[0] - eye[0], pivot[1] - eye[1], pivot[2] - eye[2]];\n    const gap = Math.hypot(...lag);\n    if (gap > SHOULDER.trail) pivot = approach(eye, pivot, SHOULDER.trail / gap); // never more than `trail` behind\n  }\n  if (!pivot) return { ...state, yaw, pitch, side, shown, fov: input.lens ?? state.fov };\n  const held = eye ? sweep(input, eye, pivot) : pivot; // the walls stop the lag; it follows on as it would\n  const fwd = poseForward({ yaw, pitch });\n  const [fx, fy, fz] = fwd;\n  const jumped = !state.shoulder || Math.hypot(...held.map((v, i) => v - state.shoulder![i])) > COLLIDE_TELEPORT;\n  const draw = SHOULDER.draw * dt; // a short arm draws it in, at a pace\n  const back = state.ball && state.shoulder ? Math.max(0, [0, 1, 2].reduce((sum, i) => sum + (state.shoulder![i] - state.ball!.at[i]) * fwd[i], 0)) : null; // prettier-ignore\n  const near = back === null || jumped ? MathUtils.clamp(reach(input, held, [-fwd[0], -fwd[1], -fwd[2]], want) / SHOULDER.close, 0, 1) : Math.min(MathUtils.clamp(Math.min(back, state.arm ?? back) / SHOULDER.close, 0, 1), state.near + draw); // prettier-ignore\n  const chest = (f ? f[1] : held[1] - SHOULDER.height) + SHOULDER.chest;\n  const step = (state.pivot ? Math.hypot(...pivot.map((v, i) => v - state.pivot![i])) : Infinity) + COLLIDE_PULL * dt; // prettier-ignore\n  const shoulder = follow(input, state.shoulder, held, shoulderOf(held, yaw, shown, near, chest), step);\n  // the room the arm will need: back, and each side as far as the view could turn before the arm, coming in, got there\n  let room = want;\n  for (const turn of SHOULDER_ROOM.sides) {\n    for (const sign of turn === 0 ? [1] : [1, -1]) {\n      const [gx, gy, gz] = poseForward({ yaw: yaw + sign * turn, pitch });\n      room = Math.min(room, reach(input, shoulder, [-gx, -gy, -gz], want) + (COLLIDE_PULL * turn) / SHOULDER_ROOM.turn);\n    }\n  }\n  // and back along its own way: from where the shoulder point and the pitch are going (by his velocity where it is\n  // known: the shoulder point follows it a lag behind), as far ahead as the arm, coming in at a share of its pace,\n  // would take to be there (a drop off a ledge, down a hatch, a jamb as he steps past it, a look going up)\n  // (a frame of no time, a page's warm-up or a paused one, reads no way: its rates would divide by 0)\n  const timed = dt > 1e-9;\n  const itself = state.shoulder && timed ? [0, 1, 2].map((i) => (shoulder[i] - state.shoulder![i]) / dt) : null;\n  const went: Vec3 | null = state.shoulder && !jumped && timed ? ((input.player?.velocity ?? itself) as Vec3) : null;\n  if (went) {\n    const bend = state.went ? went.map((v, i) => (v - state.went![i]) / dt) : [0, 0, 0];\n    const most = Math.min(1, SHOULDER_ROOM.fall / Math.max(Math.hypot(...bend), 1e-9));\n    const along = (t: number): Vec3 => [0, 1, 2].map((i) => shoulder[i] + went[i] * t + (bend[i] * most * t * t) / 2) as unknown as Vec3; // prettier-ignore\n    const tilt = (pitch - state.pitch) / dt;\n    const last = SHOULDER_ROOM.ahead[SHOULDER_ROOM.ahead.length - 1];\n    const end = along(last);\n    const way = Math.hypot(...end.map((v, i) => v - shoulder[i]));\n    const open = way > COLLIDE_SKIN ? Math.hypot(...sweep(input, shoulder, end).map((v, i) => v - shoulder[i])) / way : 1; // prettier-ignore\n    for (const t of SHOULDER_ROOM.ahead) {\n      const [gx, gy, gz] = poseForward({ yaw, pitch: MathUtils.clamp(pitch + tilt * t, ...SHOULDER_LIMITS.pitch) });\n      const from = along(Math.min(t, open * last)); // never past what stops it\n      room = Math.min(room, reach(input, from, [-gx, -gy, -gz], want) + COLLIDE_PULL * SHOULDER_ROOM.pace * t);\n    }\n  }\n  const was = state.arm === null || jumped ? room : state.arm;\n  const arm = was > room ? Math.max(room, was - COLLIDE_PULL * dt) : was + (room - was) * (1 - Math.exp(-dt / COLLIDE_RETURN)); // prettier-ignore\n  const end: Vec3 = [shoulder[0] - fx * arm, shoulder[1] - fy * arm, shoulder[2] - fz * arm];\n  // carried with the pivot and the view (with the pivot only where the view's turn would carry it into a wall: a turn\n  // in a corner); what the shoulder point does besides (drawn in, a swap) it follows at its pace\n  const before = state.ball && state.pivot && !jumped ? { base: state.pivot, yaw: state.yaw, pitch: state.pitch } : null; // prettier-ignore\n  const turned = before ? carry(state.ball!.at, before, { base: pivot, yaw, pitch }) : end;\n  const inWall = before !== null && input.queries !== undefined && input.queries.overlap({ type: 'ball', radius: COLLIDE_RADIUS - COLLIDE_SKIN }, turned, { groups: input.groups ?? 'world', exclude: input.exclude, fixed: input.fixed ?? true, also: input.also }).length > 0; // prettier-ignore\n  const carried = inWall ? carry(state.ball!.at, before!, { ...before!, base: pivot }) : turned;\n  const moved = moveCamera(input, before ? state.ball : null, shoulder, carried, end, dt, SHOULDER_KEEP); // never through a wall, at a pace\n  const fov = input.lens ?? state.fov;\n  const own = Math.hypot(...moved.at.map((v, i) => v - carried[i])); // what it moved of itself, besides the carry\n  const spare = Math.max(0, SHOULDER_ROOM.most * COLLIDE_PULL * dt - own);\n  const ball = f ? { ...moved, at: framed(input, moved.at, [f[0], f[1] + SHOULDER.chest, f[2]], { yaw, pitch }, fov, spare) } : moved; // prettier-ignore\n  return { ...state, yaw, pitch, side, shown, fov, pivot, shoulder, near, went, arm, ball };\n}\n\n/**\n * Where a camera at `at` looking along `view` shifts to keep `chest` in its picture (see the file comment): across the\n * view toward it by as much as it stands past `SHOULDER.frame` of the picture's half-height off the middle, up, down or\n * to a side (a square picture: any wider one shows more), at most `most` m, as far as the walls let it.\n */\nfunction framed(\n  walls: Walls,\n  at: Vec3,\n  chest: Vec3,\n  view: { yaw: number; pitch: number },\n  fov: number,\n  most: number,\n): Vec3 {\n  // prettier-ignore\n  const [f, u, r] = [poseForward(view), poseUp(view), poseRight(view)];\n  const rel = [chest[0] - at[0], chest[1] - at[1], chest[2] - at[2]];\n  const along = (axis: Vec3) => rel[0] * axis[0] + rel[1] * axis[1] + rel[2] * axis[2];\n  const half = along(f) * Math.tan((fov * DEG) / 2) * SHOULDER.frame;\n  if (half <= 0) return at; // behind the camera: no shift frames it\n  const off = (v: number) => Math.sign(v) * Math.max(0, Math.abs(v) - half);\n  const [up, across] = [off(along(u)), off(along(r))];\n  const shift = Math.hypot(up, across);\n  if (shift === 0) return at;\n  const k = Math.min(1, most / shift);\n  return sweep(walls, at, [0, 1, 2].map((i) => at[i] + (u[i] * up + r[i] * across) * k) as unknown as Vec3);\n}\n\n/** The shoulder camera's pose: where its ball stands (the arm back from the shoulder point), looking along the view. */\nexport function shoulderPose(state: ShoulderState): CameraPose {\n  const at = state.shoulder ?? shoulderOf([0, SHOULDER.height, 0], state.yaw, state.shown);\n  const f = poseForward(state);\n  const position: Vec3 = state.ball?.at ?? [at[0] - f[0] * state.distance, at[1] - f[1] * state.distance, at[2] - f[2] * state.distance]; // prettier-ignore\n  const ahead = (at[0] - position[0]) * f[0] + (at[1] - position[1]) * f[1] + (at[2] - position[2]) * f[2];\n  return makePose({\n    position,\n    yaw: state.yaw,\n    pitch: state.pitch,\n    fov: state.fov,\n    near: 0.05,\n    far: 500,\n    distance: Math.max(ahead, 0.05),\n  });\n}\n\n/** The shoulder camera's code data. */\nexport function shoulderSpec(state: ShoulderState): ShoulderSpec {\n  return { type: 'shoulder', yaw: state.yaw, pitch: state.pitch, distance: state.distance, side: state.side };\n}\n\nconst PARTS: readonly CodePart[] = [\n  ['yaw', -1e6, 1e6],\n  ['pitch', SHOULDER_LIMITS.pitch[0] / DEG, SHOULDER_LIMITS.pitch[1] / DEG],\n  ['distance', ...SHOULDER_LIMITS.distance],\n  ['side', -1, 1],\n];\n\n/** Reads a shoulder camera's code: `cam3=shoulder[,<yaw>,<pitch>,<distance>[,<side>]]`. Throws `GFX_BAD_CAMERA_CODE`. */\nexport function parseShoulderCode(code: string): ShoulderSpec {\n  const [yaw, pitch, distance, side] = readCode(code, 'shoulder', PARTS, [0, 3, 4]);\n  if (yaw === undefined) return { type: 'shoulder' };\n  const spec: ShoulderSpec = { type: 'shoulder', yaw: yaw * DEG, pitch: pitch * DEG, distance };\n  return side === undefined ? spec : { ...spec, side: side < 0 ? -1 : 1 };\n}\n\n/** The canonical code of a shoulder camera's data (numbers rounded: 0.01°, 0.001 m; the side only when left). */\nexport function formatShoulderCode(spec: ShoulderSpec): string {\n  if (spec.yaw === undefined) return 'cam3=shoulder';\n  const parts = [codeDegrees(spec.yaw, true), codeDegrees(spec.pitch ?? 0), codeNumber(spec.distance ?? SHOULDER.back, 3)]; // prettier-ignore\n  return `cam3=shoulder,${parts.join(',')}${spec.side === -1 ? ',-1' : ''}`;\n}\n\n/** A shoulder camera in words. */\nexport function describeShoulder(spec: ShoulderSpec, pose: CameraPose): string {\n  const lens = `Shooter camera (perspective, ${codeNumber(pose.fov, 0)}° field of view)`;\n  const where = `over the ${spec.side === -1 ? 'left' : 'right'} shoulder, ${codeNumber(spec.distance ?? SHOULDER.back, 3)} m back`; // prettier-ignore\n  return `${lens}, ${where}, heading ${codeDegrees(pose.yaw, true)}°, pitch ${codeDegrees(pose.pitch)}°`;\n}\n\n/** A shoulder camera: over the hero's shoulder (`input.eye`), turned by the devices, in front of the walls. */\nexport function createShoulderCamera(\n  options: ShoulderOptions = {},\n): FollowCamera<'shoulder', ShoulderSpec, ShoulderInput> {\n  const steps = { step: stepShoulder, pose: shoulderPose, spec: shoulderSpec, code: formatShoulderCode, describe: describeShoulder }; // prettier-ignore\n  return followCamera('shoulder', shoulderState(options), steps, { effects: SHOULDER_EFFECTS, fade: true });\n}\n","numLines":348,"startLine":1,"totalLines":348}},"tool_result_meta":[{"id":"toolu_01X8PgecBpwPVg4VW3DfJx5M","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
