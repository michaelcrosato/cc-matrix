{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmXFh1R2JtGr5JpntYg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0178rmhdpxP6yNhcpbypDqBs","name":"Bash","input":{"command":"sed -i 's/this.camYaw = .42; this.faceYaw = .42;/this.camYaw = .42; this.faceYaw = -.42;/; s/this.game.rig.set(-Math.sin(a) \\* d \\* -1 \\* -1, 1.9,/this.game.rig.set(-Math.sin(a) * d, 1.9,/' src/events/cairn.js\nsed -i 's/this.camYaw = -.3; this.faceYaw = -.3;/this.camYaw = -.3; this.faceYaw = .3;/; s/this.game.rig.set(Math.sin(-.3) \\* d, 1.8,/this.game.rig.set(Math.sin(.3) * d, 1.8,/' src/events/logReps.js\ncat > src/events/plank.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { box, at, cyl, sphere, plankWalk, buoy, lantern, palm, bunting, crate } from '../art/props.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { makeGull } from '../art/gull.js';\nconst SPOTS = [[-.1, 1, 'head'], [.2, .45, 'back'], [-.2, .35, 'back'], [.3, .0, 'feet'], [-.3, .05, 'feet'], [.05, .7, 'back'], [-.08, .55, 'back'], [.12, .22, 'back'], [.04, -.05, 'feet'], [-.14, .85, 'head'], [.14, .9, 'head'], [-.04, .15, 'back'], [.09, .6, 'back'], [-.06, .33, 'back'], [.02, .78, 'back'], [.18, .05, 'feet']];\nexport class Plank extends EventBase {\n  static id = 'plank'; static title = 'Plank & Perch'; static discipline = 'Strength'; static instructor = 'bolster'; static place = 'The Beam, on the pier'; static music = 'strength'; static diagram = 'gull';\n  static sentence = 'Hold a plank. Gulls land on you, each one a steady push. Lean against the push.';\n  static can = 'You can flail them all off. Coach will look at you.'; static cant = \"You can't make Gary leave by asking.\";\n  static verbs = [['lean', 'Counter'], ['flail', 'Shake off']];\n  static tiers = [{ time: 30, every: 5, push: [.2, .4], par: 85 }, { time: 45, every: 4.5, push: [.2, .4], par: 65 }, { time: 60, every: 4, push: [.25, .45], par: 58 }];\n  buildSet() {\n    this.timeLimit = this.tier.time; this.camYaw = 0; this.faceYaw = 0;\n    const walk = plankWalk(18, 5); walk.position.z = 9; this.add(walk);\n    const sand = cyl(2.2, 2.4, .1, '#F0DDB0', 20); this.add(sand, 0, .05, 0); sand.scale.z = 1.6;\n    const beam = box(.5, .12, 2.3, '#B58457'); this.add(beam, 0, .55, 0); for (const z of [-.9, .9]) this.add(at(box(.3, .5, .3, '#7A5A3C'), 0, .25, z));\n    this.add(lantern(), -3, 0, -2); this.add(lantern(), 3, 0, -2); this.add(crate(.8), 3.6, 0, 1); this.add(palm(1.4), -6, -.5, -5); this.add(buoy(), 7, -.4, 2);\n    this.add(bunting(-4, 2.8, -3, 4, 2.8, -3, 12));\n    this.walrus = makeWalrus(); this.add(this.walrus.group, -3, 0, .1); this.walrus.group.rotation.y = 1; this.anim.push(this.walrus);\n    this.gullsOn = []; this.spawnT = 2; this.lastSide = this.r() < .5 ? -1 : 1; this.flyers = [];\n  }\n  placeCamera(snap) { this.game.rig.set(0, 2.1, 7.2, 0, .95, 0, snap); }\n  start() { for (const l of this.lanes) { l.inT = 0; l.outT = 0; l.gulls = []; l.zone = { x: 0, z: 0, r: .28 }; l.sway = .1; l.tremor = .03; l.baseClip = 'plank'; l.doll.rig.play('plank', 0); l.customPose = true; l.flailPenalty = 0; } }\n  land(l) {\n    const r = this.r(); const same = this.r() < .7; const side = same ? this.lastSide : -this.lastSide; this.lastSide = side;\n    const mag = this.tier.push[0] + r * (this.tier.push[1] - this.tier.push[0]);\n    const g = makeGull(); const spot = SPOTS[l.gulls.length % SPOTS.length]; g.rig.play('fly', 0); this.group.add(g.group); this.anim.push(g);\n    const entry = { g, side, mag, spot, t: 0 }; l.gulls.push(entry); g.group.position.set(side * 7, 5, -2);\n    this.game.audio.sfx('squawk'); if (l.kind === 'local' && this.barkT <= 0) this.bark('bolster', 'plank');\n  }\n  shake(l) { for (const e of l.gulls) { e.leaving = true; e.g.rig.play('fly', .05); this.flyers.push(e); } l.gulls = []; }\n  fixedPlay(dt) {\n    this.spawnT -= dt;\n    if (this.spawnT <= 0 && this.playT < this.timeLimit - 1) { this.spawnT = this.tier.every; for (const l of this.lanes) if (l.bal && !l.fallen) this.land(l); }\n    for (const l of this.lanes) {\n      if (!l.bal || l.fallen) continue;\n      let px = 0; for (const e of l.gulls) if (e.t > .8) px += e.side * e.mag; l.extraX += px; l.gullPush = px;\n      const inz = Math.hypot(l.bal.cobX, l.bal.cobZ) <= l.zone.r;\n      if (inz) { l.inT += dt; l.outT = 0; } else { l.outT += dt; if (l.outT > 2 && !this.god) { this.fall(l); l.outT = 0; } }\n      l.score = 100 * l.inT / this.timeLimit + 3 * l.gulls.length - l.flailPenalty; l.form = Math.max(0, Math.min(100, 100 * l.score / this.tier.par));\n    }\n    if (this.playT >= this.timeLimit) this.finish();\n  }\n  onFlail(l) { if (l.gulls.length) { this.shake(l); l.flailPenalty += 8; this.walrus.rig.play('salute', .2, 'bounce'); if (l.kind === 'local') this.game.barkNow('bolster', 'plankFlail'); } }\n  onFall(l) { this.shake(l); l.customPose = false; this.game.audio.sfx('splash', { big: .3 }); this.game.comic('FLOMP', 0, 1.2, 0, '#FFF8EE', .8); if (l.kind === 'local') this.bark('bolster', 'fall'); }\n  onRecover(l) { l.customPose = true; l.doll.rig.play('plank', .1); }\n  frameLane(l, dt) {\n    if (!l.bal || l.fallen) return;\n    const rock = l.bal.leanX * .5, pitch = l.bal.leanZ * .25;\n    l.doll.group.position.set(0, .86, -.72);\n    // Face down along z, rocking side to side.\n    const q = new THREE.Quaternion().setFromEuler(new THREE.Euler(Math.PI / 2 + pitch, 0, -rock * .0, 'XYZ'));\n    const r = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 0, 1), -rock); l.doll.lean.quaternion.copy(r).multiply(q);\n    for (const e of l.gulls) {\n      e.t += dt; const a = Math.min(1, e.t / .8), s = a * a * (3 - 2 * a);\n      const tx = e.spot[0] + Math.sin(rock) * .75, ty = 1.13 + e.spot[0] * Math.sin(rock) * 0, tz = -.65 + e.spot[1] * 1.3;\n      e.g.group.position.set(lane(e.side * 7, tx, s), lane(5, ty, s), lane(-2, tz, s));\n      if (a >= 1 && !e.down) { e.down = true; e.g.rig.play('land', .05, 'stand'); this.game.audio.sfx('fruit'); this.game.rumble(l, .2, .07); }\n    }\n    function lane(a, b, t) { return a + (b - a) * t; }\n  }\n  frame2(dt) {\n    for (let i = this.flyers.length - 1; i >= 0; i--) { const e = this.flyers[i]; e.g.group.position.y += dt * 4; e.g.group.position.x += e.side * dt * 5; if (e.g.group.position.y > 9) { this.group.remove(e.g.group); this.anim.splice(this.anim.indexOf(e.g), 1); this.flyers.splice(i, 1); } }\n    const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(l.gulls.length, 'Gulls'); this.setTime(this.timeLimit - this.playT); }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const G = 9.81 * .75, K = G * 1.45;\n    const push = l.gullPush || 0; const [x, z] = br.correct(dt, l, 0, 0, false);\n    const counter = -push / (K * (18 * Math.PI / 180));\n    const out = Math.hypot(l.bal.cobX, l.bal.cobZ) > .7 && l.outT > 1.2;\n    const wx = x + counter * (skill === 'sharp' ? 1 : skill === 'average' ? .8 : .6);\n    return { x: Math.max(-1, Math.min(1, wx)), z, flail: out };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.gulls.length, label: 'Gulls on you', stats: `In the zone ${Math.round(100 * l.inT / this.timeLimit)}%. Floor Exercises: ${l.falls}` }; }\n  forceThing() { for (const l of this.lanes) if (l.bal && !l.fallen) this.land(l); }\n}\nE\ncat > src/events/tug.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { cyl, box, at, sphere, palm, torus, capsule, rock, bunting, buoy } from '../art/props.js';\nimport { makeDoll } from '../art/doll.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { GUESTS } from '../data/names.js';\nconst CALL = 1.2;\nexport class Tug extends EventBase {\n  static id = 'tug'; static title = 'Tug of Peace'; static discipline = 'Strength'; static instructor = 'bolster'; static place = 'The Beach'; static music = 'strength'; static couch = true; static diagram = 'tug';\n  static sentence = 'On the call, squeeze both feet and lean back. Best of three pulls.';\n  static can = 'You can lean back further for more pull, and pay for it when they ease off.'; static cant = \"You can't pull between calls. Peace has rules.\";\n  static verbs = [['lean', 'Lean back'], ['feet', 'Heave'], ['flail', 'Flail']];\n  static tiers = [{ their: .35, ease: 0 }, { their: .5, ease: 12 }, { their: .54, ease: 9 }];\n  buildSet() {\n    const n = this.opts.laneCount || 1; this.laneSpacing = 2.4;\n    this.add(cyl(14, 15, 1, '#F0DDB0', 32), 0, -.5, 0);\n    for (let i = -5; i <= 5; i++) { const m = box(.08, .02, 1.6, i === 0 ? '#E8443A' : '#C9B488'); this.add(m, i * .8, .012, 0); }\n    this.add(palm(1.6), -9, 0, -6); this.add(palm(1.3), 9, 0, -5); this.add(rock(.7), 7, .1, -7); this.add(buoy(), 3, -.4, -13); this.add(bunting(-7, 3.2, -4, 7, 3.2, -4, 18));\n    this.rope = new THREE.Group(); const line = cyl(.035, .035, 12, '#E9D3AE', 8); line.rotation.z = Math.PI / 2; this.rope.add(at(line, 0, 1.05, 0)); const flag = box(.1, .4, .02, '#E8443A'); this.rope.add(at(flag, 0, .8, 0)); this.add(this.rope);\n    this.walrus = makeWalrus(); this.add(this.walrus.group, 0, 0, -2.6); this.anim.push(this.walrus);\n    this.pos = 0; this.pullsA = 0; this.pullsB = 0; this.pullN = 0; this.callT = 2; this.callIdx = 0; this.easeT = this.tier.ease; this.easing = 0; this.resolveQ = []; this.pullBreak = 0; this.flagShake = 0;\n    this.aiDolls = [];\n  }\n  placeCamera(snap) { this.game.rig.set(0, 2.4, 10.8, 0, 1.1, 0, snap); }\n  laneX(i, n) { const side = i % 2 === 0 ? -1 : 1, rank = Math.floor(i / 2); return side * (2.2 + rank * 1.5); }\n  start() {\n    const anyB = this.lanes.some(l => l.id % 2 === 1 && l.kind !== 'ghost'); this.aiB = !anyB;\n    for (const l of this.lanes) { l.team = l.id % 2 === 0 ? 'A' : 'B'; l.customPose = true; l.baseClip = 'tug'; l.doll.rig.play('tug', 0); l.doll.setFace(l.team === 'A' ? Math.PI / 2 : -Math.PI / 2); l.pressT = -9; l.power = 0; l.err = 0; l.nextPress = null; }\n    // Solo: you and Retired Kevin against Both Sandras.\n    if (this.aiB) {\n      const add = (g, x, face) => { const d = makeDoll({ paint: g.paint, hat: g.hat, skin: g.skin, height: g.height, width: g.width }); d.group.position.set(x, 0, 0); d.setFace(face); d.rig.play('tug', 0); this.group.add(d.group); this.anim.push(d); this.aiDolls.push({ d, face, base: x }); };\n      add(GUESTS[1], -3.7, Math.PI / 2); add(GUESTS[2], 2.2, -Math.PI / 2); add(GUESTS[3], 3.7, -Math.PI / 2);\n    }\n  }\n  teamPower(team) { const list = this.lanes.filter(l => l.team === team && l.kind !== 'ghost'); if (!list.length) return null; let s = 0; for (const l of list) s += l.power; return s / list.length; }\n  fixedPlay(dt) {\n    if (this.pullBreak > 0) { this.pullBreak -= dt; if (this.pullBreak <= 0) { this.pos = 0; this.setMsg(''); this.callT = 1.5; for (const l of this.lanes) l.power = 0; } return; }\n    const their = this.tier.their;\n    // Press detection: both feet squeeze.\n    for (const l of this.lanes) {\n      if (!l.bal) continue;\n      const both = l.in.lf > .5 && l.in.rf > .5 || l.in.hop;\n      if (both && !l.wasBoth && !l.fallen) { const err = Math.min(Math.abs(this.playT - (this.lastCall ?? -9)), Math.abs(this.playT - (this.lastCall ?? -9) - CALL), Math.abs(this.callAt - this.playT)); l.power = Math.max(0, 1 - err / .3) * Math.max(0, l.bal.leanZ / l.bal.maxLeanRad()); l.pressT = this.playT; this.game.audio.sfx('foot'); }\n      l.wasBoth = both;\n      const tension = this.easing > 0 ? 0 : 1; const tp = this.oppPower(l, their);\n      if (!l.fallen) l.extraZ -= (.1 + .3 * tp) * tension;\n    }\n    this.callT -= dt; this.callAt = this.playT + Math.max(0, this.callT);\n    if (this.callT <= 0) {\n      this.callT = CALL; this.lastCall = this.playT; this.game.audio.speak('bolster', 'Heave!'); this.game.audio.sfx('rim'); this.setBig('HEAVE!'); this.game.after(.3, () => { this.setBig(''); });\n      // Resolve shortly after the call so a press just after it still counts.\n      this.game.after(.32, () => this.resolve(their));\n    }\n    if (this.tier.ease) {\n      this.easeT -= dt;\n      if (this.easeT <= 0) { this.easeT = this.tier.ease * (.8 + this.r() * .4); this.easing = .8; this.setMsg('They eased off!'); for (const l of this.lanes) if (l.bal && !l.fallen && l.bal.leanZ / l.bal.maxLeanRad() > .72) { this.gust(l, 0, 3.2, .5); l.overlean = true; } this.game.after(.8, () => this.setMsg('')); }\n      if (this.easing > 0) this.easing -= dt;\n    }\n    if (this.playT > 240) this.finish();\n  }\n  oppPower(l, base) { const opp = l.team === 'A' ? 'B' : 'A'; const p = this.teamPower(opp); return p == null ? base : Math.max(.2, p); }\n  resolve(their) {\n    if (this.phase !== 'play' || this.pullBreak > 0 || this.disposed) return;\n    const a = this.teamPower('A') ?? 0, bReal = this.teamPower('B');\n    const b = bReal == null ? their * (.8 + this.r() * .4) : bReal;\n    this.pos += (a - b) * .33; this.flagShake = 1;\n    for (const l of this.lanes) l.power = 0;\n    if (Math.abs(this.pos) >= 1) {\n      const aWon = this.pos > 0; if (aWon) this.pullsA++; else this.pullsB++; this.pullN++;\n      this.setMsg(`${aWon ? 'Your side' : 'Their side'} took the pull. ${this.pullsA} to ${this.pullsB}`); this.game.audio.sfx('bell'); this.game.audio.sfx('cheer');\n      if (this.pullsA >= 2 || this.pullsB >= 2 || this.pullN >= 3) { this.finish(); this.tally(); return; }\n      this.pullBreak = 2.2;\n    }\n    this.tally();\n  }\n  tally() { for (const l of this.lanes) { const won = l.team === 'A' ? this.pullsA : this.pullsB; l.form = Math.max(0, Math.min(100, 40 + 30 * won - 5 * l.falls)); l.score = won; } }\n  onFall(l) { const d = l.team === 'A' ? -.3 : .3; this.pos += d; l.customPose = false; if (l.kind === 'local') this.game.barkNow('bolster', 'tugSit'); this.tally(); }\n  onRecover(l) { l.customPose = true; l.doll.rig.play('tug', .1); }\n  frameLane(l) {\n    if (!l.bal || l.fallen) return; const dir = l.team === 'A' ? -1 : 1;\n    const back = l.bal.leanZ; l.doll.group.position.set(l.x + this.pos * 1.6, 0, 0); l.doll.setLean(dir * back * 1.2, l.bal.leanX * .4);\n  }\n  frame2() {\n    this.rope.position.x = this.pos * 1.6; if (this.flagShake > 0) this.flagShake = Math.max(0, this.flagShake - .05);\n    for (const a of this.aiDolls) { a.d.group.position.x = a.base + this.pos * 1.6; const dir = a.base < 0 ? -1 : 1; a.d.setLean(dir * (.12 + .1 * Math.max(0, Math.sin(this.t * 5.2 + a.base))), 0); }\n    this.setNum(`${this.pullsA}-${this.pullsB}`, 'Pulls'); this.setTime(null);\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const stick = this.tier.ease ? (this.tierIndex === 2 ? .95 : .85) : .9;\n    const [x, z] = br.correct(dt, l, 0, stick, false, .5);\n    if (l.nextErr === undefined || l.lastCallSeen !== this.lastCall) { l.lastCallSeen = this.lastCall; l.nextErr = br.gauss() * br.s.timing; l.pressed = false; }\n    const toCall = this.callAt - this.playT; const fire = !l.pressed && this.callT > 0 && toCall - l.nextErr < .004 + dt;\n    if (fire) { l.pressed = true; l.pressHold = .06; }\n    const held = (l.pressHold || 0) > 0; if (held) l.pressHold -= dt;\n    return { x, z, lf: held ? 1 : 0, rf: held ? 1 : 0, flail: (l.bal?.angle || 0) > .56 };\n  }\n  laneResult(i) { const l = this.lanes[i]; const won = l.team === 'A' ? this.pullsA : this.pullsB, lost = l.team === 'A' ? this.pullsB : this.pullsA; return { form: l.form, big: `${won}-${lost}`, label: 'Pulls', stats: `Floor Exercises: ${l.falls}. Peace has been achieved, roughly.` }; }\n  forceThing() { this.easeT = 0; }\n}\nE\ncat > src/events/stepClass.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { CHARTS, chartNotes } from '../data/charts.js';\nimport { T } from '../core/tuning.js';\nimport { cyl, box, at, sphere, cone, bunting, lantern, palm, torus, mesh, toon, flat } from '../art/props.js';\nimport { makeDoll, PAINTS, HATS } from '../art/doll.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { el, txt } from '../ui/ui.js';\nconst SYM = { L: 'L', R: 'R', B: 'L+R', '<': '←', '>': '→', '^': '↑', v: '↓' };\nconst COL = { L: '#3B82F6', R: '#E8443A', B: '#F5B700', '<': '#7FD6C8', '>': '#7FD6C8', '^': '#7FD6C8', v: '#7FD6C8' };\nconst DIRS = { '<': [-1, 0], '>': [1, 0], '^': [0, -1], v: [0, 1] };\nexport class StepClass extends EventBase {\n  static id = 'stepClass'; static title = 'Step Class'; static discipline = 'Cardio'; static instructor = 'bolster'; static place = 'The Bandstand'; static music = 'cardio'; static palette = 'dusk'; static couch = true; static session = true; static diagram = 'feet';\n  static sentence = 'Press each foot as its print reaches the line. Lean into the arrows. The class copies you.';\n  static can = 'You can lead lean arrows early: the dot is slow.'; static cant = \"You can't fall in time with the music. You can fall, but not in time.\";\n  static verbs = [['left', 'Left'], ['right', 'Right'], ['hop', 'Both'], ['lean', 'Lean']];\n  static tiers = [{ chart: 'tier1' }, { chart: 'tier2' }, { chart: 'tier3' }];\n  static sessionConfig = { tier: 1, chart: 'session' };\n  buildSet() {\n    this.chart = CHARTS[this.opts.chart || this.tier.chart]; const c = chartNotes(this.chart); this.beat = c.beat; this.length = c.length; this.baseNotes = c.notes; this.timeLimit = c.length + .5; this.chartT = -3; this.combo = 0;\n    const n = this.opts.laneCount || 1, w = 7 + n * 2.5;\n    const stage = cyl(w, w + .3, .5, '#C89B6A', 8); stage.rotation.y = .39; this.add(stage, 0, -.25, -1.5);\n    for (let i = 0; i < 8; i++) { const a = i / 8 * 6.283 + .39; this.add(at(cyl(.12, .14, 4.2, '#FFF8EE'), Math.sin(a) * (w - .4), 2.1, Math.cos(a) * (w - .4) - 1.5)); }\n    const roof = cone(w + 1.2, 2.2, '#2FA7A0', 8); roof.rotation.y = .39; this.add(roof, 0, 5.3, -1.5);\n    this.add(bunting(-w + .5, 3.8, -1.5 + 3, w - .5, 3.8, -1.5 + 3, 18)); this.add(palm(1.7), -w - 2.5, -.5, -3); this.add(palm(1.5), w + 2.5, -.5, -4);\n    this.spots = []; for (const s of [-1, 1]) { const sp = new THREE.Mesh(new THREE.ConeGeometry(1.4, 4.5, 18, 1, true), flat('#FFF2C2', .22)); sp.position.set(s * 2.6, 2.6, .2); sp.visible = false; this.add(sp); this.spots.push(sp); }\n    this.klass = []; const rows = [[-3.4, -2.6], [-1.15, -2.6], [1.15, -2.6], [3.4, -2.6], [-3.4, -4.3], [-1.15, -4.3], [1.15, -4.3], [3.4, -4.3]];\n    rows.forEach(([x, z], i) => { const d = makeDoll({ paint: PAINTS[i % PAINTS.length], hat: HATS[(i * 3) % HATS.length], height: .92 + (i % 3) * .05 }); d.group.position.set(x, 0, z); d.rig.play('idle', 0); d.tripT = 0; this.add(d.group); this.anim.push(d); this.klass.push(d); });\n    this.walrus = makeWalrus(); this.add(this.walrus.group, -5, 0, -.8); this.walrus.group.rotation.y = .6; this.anim.push(this.walrus);\n    this.beatLight = sphere(.25, '#FFD23F'); this.add(this.beatLight, 0, 4.3, -1); this.lastBeat = -1;\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(8, spread); this.game.rig.set(0, 2, d, 0, 1.35, -.5, snap); }\n  setupHud2() { this.rib = el('div', 'ribbon'); this.rib.appendChild(el('div', 'target')); this.hudEl.appendChild(this.rib); this.noteEls = new Map(); this.judgeEl = txt('div', 'hudmsg', ''); }\n  start() {\n    for (const l of this.lanes) {\n      l.notes = this.baseNotes.map(n => ({ ...n, state: 0 })); l.earned = 0; l.maxScore = 0; l.combo = 0; l.bestCombo = 0; l.perfect = 0; l.good = 0; l.ok = 0; l.miss = 0; l.lp = false; l.rp = false; l.ni = 0; l.baseClip = 'idle';\n      if (l.kind === 'bot' || this.game.testBotSkill) l.plan = null;\n    }\n    this.notes0 = this.baseNotes;\n    this.maxPts = this.baseNotes.length;\n  }\n  onPlayStart() {\n    const a = this.game.audio; this.audioRef = null;\n    if (a.running) { const when = a.now() + .05; this.audioRef = when; a.playTrack('cardio', { bpm: this.chart.bpm, startAt: when }); } else a.playTrack('cardio', { bpm: this.chart.bpm });\n    this.chartT = 0;\n  }\n  clock(dt) {\n    this.chartT += dt; const a = this.game.audio;\n    if (this.audioRef != null && a.running && !this.game.manual) {\n      const off = (this.game.settings?.rhythmOffset || 0) / 1000, at = a.now() - this.audioRef - (a.ctx.outputLatency || 0) - off;\n      if (Math.abs(at - this.chartT) > .25) this.audioRef = a.now() - this.chartT - (a.ctx.outputLatency || 0) - off; else this.chartT = at;\n    }\n  }\n  fixedPlay(dt) {\n    this.clock(dt); const t = this.chartT, W = T.rhythmWindow * this.diff.win; const P = .045 * W, G = .09 * W, O = .135 * W, beat = this.beat;\n    const bn = Math.floor(t / beat); if (bn !== this.lastBeat) { this.lastBeat = bn; this.beatPulse = 1; if (bn % 2 === 0) this.game.audio.sfx('tick', { high: bn % 8 === 0 }); this.walrus.rig.play('clap', .1); }\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost' || !l.bal) continue;\n      const I = l.in; const L = I.lf > .5, R = I.rf > .5; const lE = L && !l.lp, rE = R && !l.rp; l.lp = L; l.rp = R;\n      const hop = I.hop;\n      if (!l.fallen) {\n        if (hop || lE || rE) {\n          // Find the nearest unjudged foot note.\n          let best = null, bd = 1; for (let i = l.ni; i < l.notes.length; i++) { const n = l.notes[i]; if (n.t > t + O + .1) break; if (n.state || !'LRB'.includes(n.k)) continue; const d = Math.abs(n.t - t); if (d < bd && d <= O) { const fits = n.k === 'B' ? (hop || lE || rE) : ((n.k === 'L' && (lE || hop)) || (n.k === 'R' && (rE || hop))); if (fits) { bd = d; best = n; } } }\n          if (best) {\n            if (best.k === 'B' && !hop) { if (best.first != null && t - best.first < .12) this.judge(l, best, Math.abs(best.first - best.t), P, G); else best.first = t; if (L && R) this.judge(l, best, Math.abs(t - best.t), P, G); }\n            else this.judge(l, best, bd, P, G);\n          }\n          if (lE) { l.doll.rig.play('stepL', .05, 'idle'); } if (rE) { l.doll.rig.play('stepR', .05, 'idle'); }\n          this.game.audio.sfx('foot', { high: rE });\n        }\n      }\n      // Misses and lean notes\n      for (let i = l.ni; i < l.notes.length; i++) {\n        const n = l.notes[i]; if (n.t > t + 1) break;\n        if (n.state) { if (i === l.ni) l.ni++; continue; }\n        if (DIRS[n.k]) {\n          if (t < n.t - .25 * beat) continue; const [dx, dz] = DIRS[n.k]; const v = l.bal.cobX * dx + l.bal.cobZ * dz, age = t - n.t;\n          if (v >= .25 && age <= 1.5 * beat) { n.state = 1; l.earned += 1; this.hit(l, 'NICE'); }\n          else if (v >= .25 && age <= 2 * beat) { n.state = 1; l.earned += .5; l.ok++; this.hit(l, 'OK'); }\n          else if (age > 2 * beat) { n.state = 2; this.missed(l); }\n        } else if (t - n.t > O) { n.state = 2; this.missed(l); }\n      }\n      l.form = Math.min(100, 100 * l.earned / Math.max(1, this.maxPts)); l.score = l.earned;\n      // Guide the bot's lean ribbon\n      l.leanGoal = this.leanAt(t);\n    }\n    if (t >= this.length) this.finish();\n  }\n  leanAt(t) { for (const n of this.baseNotes) { if (DIRS[n.k] && n.t + this.beat * .9 > t && n.t - this.beat * .9 < t) return DIRS[n.k]; } return null; }\n  judge(l, n, d, P, G) {\n    n.state = 1; let w = .4, word = 'OK'; if (d <= P) { w = 1; word = 'PERFECT'; l.perfect++; } else if (d <= G) { w = .7; word = 'GOOD'; l.good++; } else l.ok++;\n    l.earned += w; this.hit(l, word);\n  }\n  hit(l, word) {\n    l.combo++; l.bestCombo = Math.max(l.bestCombo, l.combo);\n    if (l.kind === 'local') { this.lastWord = word; this.wordT = .4; }\n    if (l.id === 0) { const k = this.klass; const sync = Math.min(8, Math.floor(l.combo / 2)); for (let i = 0; i < sync; i++) { const d = k[i]; if (d.tripT <= 0) d.rig.play(l.combo % 2 ? 'stepL' : 'stepR', .05, 'idle'); } }\n    if (l.combo === 16 && l.id === 0) { for (const s of this.spots) s.visible = true; this.game.particles.confetti(0, 5, -1, 80); this.game.audio.sfx('cheer'); if (!this.attract) this.game.barkNow('bolster', 'step'); }\n  }\n  missed(l) { if (l.combo >= 16 && l.id === 0) for (const s of this.spots) s.visible = false; l.combo = 0; l.miss++; if (l.id === 0) { const d = this.klass[Math.floor(this.r() * 8)]; d.tripT = 1; d.rig.play('flop', .05); this.game.after(.9, () => { if (!this.disposed) { d.tripT = 0; d.rig.play('idle', .2); } }); if (l.kind === 'local' && this.barkT <= 0) this.bark('bolster', 'stepMiss'); } }\n  frame2(dt) {\n    const l = this.localLanes()[0] || this.lanes[0]; if (!l || !l.notes) return;\n    this.setNum(l.combo, 'Combo'); this.setTime(this.phase === 'play' ? this.length - this.chartT : null);\n    if (this.wordT > 0) { this.wordT -= dt; this.setMsg(this.lastWord); } else this.setMsg('');\n    this.beatPulse = (this.beatPulse || 0) * Math.exp(-7 * dt); if (this.beatLight) this.beatLight.scale.setScalar(.25 * (1 + this.beatPulse * .9)); this.beatT = (this.beatT || 0) + dt;\n    for (const s of this.spots) if (s.visible) s.rotation.z = Math.sin(this.t * 1.6 + s.position.x) * .4;\n    if (!this.rib) return;\n    const t = this.chartT, span = 2.6, seen = new Set();\n    for (let i = l.ni; i < l.notes.length; i++) {\n      const n = l.notes[i]; if (n.t > t + span) break; if (n.state) continue; seen.add(n);\n      let e = this.noteEls.get(n); if (!e) { e = el('div', 'note'); e.textContent = SYM[n.k]; e.style.background = COL[n.k]; this.rib.appendChild(e); this.noteEls.set(n, e); }\n      e.style.left = `${10 + (n.t - t) / span * 90}%`;\n    }\n    for (const [n, e] of this.noteEls) if (!seen.has(n)) { e.remove(); this.noteEls.delete(n); }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const ct = this.chartT; if (!l.notes) return {};\n    l.lfT = (l.lfT || 0) - dt; l.rfT = (l.rfT || 0) - dt;\n    if (l.planI === undefined) { l.planI = 0; }\n    const missRate = skill === 'sharp' ? .005 : skill === 'average' ? .02 : .06;\n    while (l.planI < l.notes.length && l.notes[l.planI].t + .2 < ct) l.planI++;\n    for (let k = l.planI; k < l.notes.length; k++) {\n      const n = l.notes[k]; if (n.t > ct + .3) break; if (n.bp) continue; if (!'LRB'.includes(n.k)) { n.bp = true; continue; }\n      if (n.fireAt === undefined) { n.fireAt = n.t + br.gauss() * br.s.timing; n.skip = br.r() < missRate; }\n      if (ct >= n.fireAt) { n.bp = true; if (!n.skip) { if (n.k !== 'R') l.lfT = .05; if (n.k !== 'L') l.rfT = .05; } }\n    }\n    const goal = (() => { for (const n of l.notes) { if (DIRS[n.k] && !n.state && n.t - this.beat * 1.1 < ct && n.t + this.beat * 2 > ct) return DIRS[n.k]; } return [0, 0]; })();\n    const [x, z] = br.correct(dt, l, goal[0] * .6, goal[1] * .6);\n    return { x, z, lf: l.lfT > 0 ? 1 : 0, rf: l.rfT > 0 ? 1 : 0 };\n  }\n  onDispose() { this.game.audio.stopTrack(.4); }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.bestCombo, label: 'Best combo', stats: `Perfect ${l.perfect}, Good ${l.good}, OK ${l.ok}, Missed ${l.miss}` }; }\n  forceThing() { this.game.particles.confetti(0, 5, -1, 80); }\n}\nE\ncat > src/events/plates.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { cyl, box, at, sphere, cone, torus, bunting, tree, toon, plate as plateMesh, mesh, cached } from '../art/props.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { el, txt } from '../ui/ui.js';\nconst BANDS = { L: [3.5, 5, '#3B82F6', .42, 'Large'], M: [6.5, 8, '#22C55E', .32, 'Medium'], S: [9.5, 11, '#E8443A', .23, 'Small'] };\nexport class Plates extends EventBase {\n  static id = 'plates'; static title = 'Plate Spinners'; static discipline = 'Cardio'; static instructor = 'bolster'; static place = 'The Circus Green'; static music = 'cardio'; static couch = true; static session = true; static diagram = 'circle';\n  static sentence = 'Circle the stick to drive the hoop. Large plates want slow, small plates want fast.';\n  static can = 'You can change speed to save another plate. It takes a moment.'; static cant = \"You can't fall in this one. Only the plates can.\";\n  static verbs = [['circle', 'Circle']];\n  static tiers = [{ plates: 'LMS', decay: .11 }, { plates: 'LMMS', decay: .13 }, { plates: 'LLMMSS', decay: .16 }];\n  static sessionConfig = { tier: 0, time: 50 };\n  buildSet() {\n    this.noFall = true; this.timeLimit = this.opts.time || 60; this.flailOk = false; this.showDisc = true;\n    this.add(cyl(11, 11.2, .6, '#7CC568', 40), 0, -.3, 0); this.add(cyl(4.5, 4.5, .02, '#FFF2C2', 40), 0, .012, 0);\n    const tent = cone(3, 2, '#E8443A', 10); this.add(tent, -7, 4.2, -6); this.add(at(cyl(3, 3, 3.2, '#FFF8EE', 10), -7, 1.6, -6)); this.add(tree(1.4), 7.5, 0, -6); this.add(bunting(-6, 4.2, -5.2, 6.5, 4.2, -5.2, 18));\n    this.walrus = makeWalrus(); this.add(this.walrus.group, 4.5, 0, -3.1); this.walrus.group.rotation.y = -.7; this.anim.push(this.walrus);\n    this.shards = [];\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(9, spread); this.game.rig.set(0, 5.3, d, 0, 1, -.3, snap); }\n  setupHud2() { this.gaugeRow = el('div', 'gaugeRow'); this.hudEl.appendChild(this.gaugeRow); const l = this.lanes[0]; this.gauges = (l?.plates || []).map(p => { const a = el('div', 'arc'); a.innerHTML = `<svg viewBox=\"-55 -55 110 70\" width=\"100%\"><path d=\"M-44 8 A44 44 0 0 1 44 8\" fill=\"none\" stroke=\"#1A1420\" stroke-width=\"16\"/><path class=\"v\" d=\"M-44 8 A44 44 0 0 1 44 8\" fill=\"none\" stroke=\"${BANDS[p.kind][2]}\" stroke-width=\"10\" pathLength=\"100\" stroke-dasharray=\"70 100\"/></svg>`; const lb = txt('div', 'gaugeTag', BANDS[p.kind][4]); a.appendChild(lb); this.gaugeRow.appendChild(a); return { v: a.querySelector('.v'), lb }; }); }\n  start() {\n    const kinds = this.tier.plates;\n    for (const l of this.lanes) {\n      l.w = 0; l.hoop = 0; l.phase = 0; l.lastAng = null; l.keyW = 0; l.lastTap = -9; l.lastKey = null; l.alive = 0; l.total = 0; l.crashes = 0; l.baseClip = 'hipCircle'; l.doll.rig.scrub('hipCircle', 0, 0); l.botPh = 0; l.botW = 0; l.sway = .02; l.bandGoal = null;\n      const hoop = torus(.42, .035, '#F5B700'); hoop.rotation.x = Math.PI / 2; hoop.position.y = .72; l.doll.group.add(hoop); l.hoopM = hoop;\n      const ringM = torus(.54, .03, '#FFF8EE'); ringM.rotation.x = Math.PI / 2; ringM.position.y = .03; l.doll.group.add(ringM); l.ringM = ringM;\n      l.plates = [...kinds].map((k, i) => {\n        const n = kinds.length; const a = -Math.PI * .85 + (i + .5) / n * Math.PI * .7 * 2 / 1.4 * .7 * 2; const R = this.lanes.length > 1 ? 1.2 : 2.6, x = l.x + Math.cos(a) * R, z = Math.sin(a) * R - .4;\n        const pole = cyl(.03, .05, 1.9, '#FFF8EE'); pole.position.set(x, .95, z); this.group.add(pole);\n        const grp = new THREE.Group(); grp.position.set(x, 1.95, z); const pm = plateMesh(BANDS[k][3], BANDS[k][2]); grp.add(pm); this.group.add(grp);\n        return { kind: k, energy: .7, x, z, grp, pm, dead: 0, spin: 0 };\n      });\n    }\n  }\n  fixedPlay(dt) {\n    const gain = .45 * T.plateGain, decay = this.tier.decay * T.plateDecay;\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') continue;\n      const I = l.in; const usingKeys = I.dev === 'kbm' && (I.tapA || I.tapD || (this.t - l.lastTap < 1.2));\n      if (I.tapA || I.tapD) { const k = I.tapA ? 'a' : 'd'; if (k !== l.lastKey) { const gap = this.t - l.lastTap; if (gap > .03 && gap < 1.4) l.keyW = Math.PI / gap; l.lastKey = k; l.lastTap = this.t; } }\n      let target;\n      if (usingKeys) { target = l.keyW; if (this.t - l.lastTap > .9) target = 0; }\n      else {\n        const m = Math.hypot(I.x, I.z);\n        if (m > .5) { const a = Math.atan2(I.z, I.x); if (l.lastAng != null) { let d = a - l.lastAng; if (d > Math.PI) d -= 6.283; if (d < -Math.PI) d += 6.283; l.w += (Math.abs(d) / dt - l.w) * (1 - Math.exp(-dt / .12)); } l.lastAng = a; target = l.w; }\n        else { l.w *= Math.exp(-3 * dt); l.lastAng = null; target = l.w; }\n      }\n      l.hoop += (target - l.hoop) * (1 - Math.exp(-dt / .5)); l.phase += l.hoop * dt;\n      for (const p of l.plates) {\n        l.total += dt;\n        if (p.dead > 0) { p.dead -= dt; if (p.dead <= 0) { p.energy = .7; p.grp.visible = true; this.game.audio.sfx('spring'); } continue; }\n        l.alive += dt;\n        const b = BANDS[p.kind]; const inb = l.hoop >= b[0] && l.hoop <= b[1]; p.inBand = inb;\n        p.energy += (inb ? gain - decay * 0 : -decay) * dt; p.energy = Math.min(1, p.energy);\n        if (p.energy <= 0) this.smash(l, p);\n      }\n      l.score = l.total ? l.alive / l.total : 0;\n      l.form = Math.max(0, 200 * l.score - 100);\n    }\n    if (this.playT >= this.timeLimit) this.finish();\n  }\n  smash(l, p) {\n    p.dead = 6; p.grp.visible = false; l.crashes++; this.game.audio.sfx('crash'); this.game.comic('CRASH!', p.x, 2.2, p.z, '#FFD23F', .8); this.game.rumble(l, .6, .2);\n    if (l.kind === 'local' && this.barkT <= 0) this.bark('bolster', 'plates');\n    for (let i = 0; i < 6; i++) {\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x, 1.95, p.z).setLinvel((this.r() - .5) * 4, 1 + this.r() * 3, (this.r() - .5) * 4).setAngvel({ x: this.r() * 8, y: this.r() * 8, z: this.r() * 8 }));\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(.1, .02, .1).setMass(.02).setRestitution(.3).setCollisionGroups(G_PROP(l.id)), body);\n      const m = box(.2, .04, .2, BANDS[p.kind][2]); this.group.add(m); this.shards.push({ body, m, left: 2.2 });\n    }\n  }\n  postPlay(dt) { for (let i = this.shards.length - 1; i >= 0; i--) { const s = this.shards[i]; s.left -= dt; const q = s.body.rotation(), t = s.body.translation(); s.m.position.set(t.x, t.y, t.z); s.m.quaternion.set(q.x, q.y, q.z, q.w); if (s.left <= 0) { this.group.remove(s.m); this.world.removeRigidBody(s.body); this.shards.splice(i, 1); } } }\n  frameLane(l, dt) {\n    if (l.kind === 'ghost') return;\n    l.doll.rig.scrub('hipCircle', (l.phase / 6.283) % 1, 0); if (l.hoopM) { l.hoopM.position.x = Math.cos(l.phase) * .12; l.hoopM.position.z = Math.sin(l.phase) * .12; }\n    let band = null; for (const k in BANDS) if (l.hoop >= BANDS[k][0] && l.hoop <= BANDS[k][1]) band = k; if (l.ringM) l.ringM.material = toon(band ? BANDS[band][2] : '#FFF8EE');\n    for (const p of l.plates) {\n      if (p.dead > 0) continue; const w = (1 - p.energy) * .6; p.spin += (3 + p.energy * 18) * dt; p.grp.rotation.y = p.spin; p.grp.rotation.x = Math.sin(this.t * 7 + p.x) * w; p.grp.rotation.z = Math.cos(this.t * 7 + p.x) * w;\n    }\n  }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (!l) return; this.setNum(`${Math.round(l.score * 100)}%`, 'Alive'); this.setTime(this.timeLimit - this.playT); if (this.gauges) l.plates.forEach((p, i) => { const g = this.gauges[i]; if (g) g.v.setAttribute('stroke-dasharray', `${(p.dead > 0 ? 0 : p.energy) * 100} 100`); }); }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const s = br.s;\n    l.botT = (l.botT || 0) - dt;\n    if (l.botT <= 0) { l.botT = s.lag + .1; let low = null; for (const p of l.plates) if (p.dead <= 0 && (!low || p.energy < low.energy)) low = p; if (low) { const b = BANDS[low.kind]; l.botGoal = (b[0] + b[1]) / 2 + br.gauss() * s.speedErr * .3; } l.botSlip = br.r() < (skill === 'clumsy' ? .08 : skill === 'average' ? .04 : 0); }\n    l.botW += ((l.botGoal || 0) - l.botW) * (1 - Math.exp(-dt / .15)); const w = l.botW + (l.botSlip ? -2 : 0) + Math.sin(this.t * 2.1) * s.speedErr * .45;\n    l.botPh += Math.max(.1, w) * dt;\n    return { x: Math.cos(l.botPh) * .9, z: Math.sin(l.botPh) * .9 };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: `${Math.round(l.score * 100)}%`, label: 'Plates alive', stats: `Crashes: ${l.crashes}` }; }\n  forceThing() { for (const l of this.lanes) { const p = l.plates?.find(q => q.dead <= 0); if (p) this.smash(l, p); } }\n  onDispose() {}\n}\nE\necho ok","description":"Write Plank, Tug, Step Class and Plates events"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26160,"cache_read_input_tokens":230987,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26160},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"a76db97c-f4bb-4247-b579-c52a18c77888","timestamp":"2026-11-05T12:21:07.313Z","request_id":"req_011CgjmXFJgUzLxbqChMs3cU","wire_tool_inputs":{"toolu_0178rmhdpxP6yNhcpbypDqBs":{"command":"sed -i 's/this.camYaw = .42; this.faceYaw = .42;/this.camYaw = .42; this.faceYaw = -.42;/; s/this.game.rig.set(-Math.sin(a) \\* d \\* -1 \\* -1, 1.9,/this.game.rig.set(-Math.sin(a) * d, 1.9,/' src/events/cairn.js\nsed -i 's/this.camYaw = -.3; this.faceYaw = -.3;/this.camYaw = -.3; this.faceYaw = .3;/; s/this.game.rig.set(Math.sin(-.3) \\* d, 1.8,/this.game.rig.set(Math.sin(.3) * d, 1.8,/' src/events/logReps.js\ncat > src/events/plank.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { box, at, cyl, sphere, plankWalk, buoy, lantern, palm, bunting, crate } from '../art/props.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { makeGull } from '../art/gull.js';\nconst SPOTS = [[-.1, 1, 'head'], [.2, .45, 'back'], [-.2, .35, 'back'], [.3, .0, 'feet'], [-.3, .05, 'feet'], [.05, .7, 'back'], [-.08, .55, 'back'], [.12, .22, 'back'], [.04, -.05, 'feet'], [-.14, .85, 'head'], [.14, .9, 'head'], [-.04, .15, 'back'], [.09, .6, 'back'], [-.06, .33, 'back'], [.02, .78, 'back'], [.18, .05, 'feet']];\nexport class Plank extends EventBase {\n  static id = 'plank'; static title = 'Plank & Perch'; static discipline = 'Strength'; static instructor = 'bolster'; static place = 'The Beam, on the pier'; static music = 'strength'; static diagram = 'gull';\n  static sentence = 'Hold a plank. Gulls land on you, each one a steady push. Lean against the push.';\n  static can = 'You can flail them all off. Coach will look at you.'; static cant = \"You can't make Gary leave by asking.\";\n  static verbs = [['lean', 'Counter'], ['flail', 'Shake off']];\n  static tiers = [{ time: 30, every: 5, push: [.2, .4], par: 85 }, { time: 45, every: 4.5, push: [.2, .4], par: 65 }, { time: 60, every: 4, push: [.25, .45], par: 58 }];\n  buildSet() {\n    this.timeLimit = this.tier.time; this.camYaw = 0; this.faceYaw = 0;\n    const walk = plankWalk(18, 5); walk.position.z = 9; this.add(walk);\n    const sand = cyl(2.2, 2.4, .1, '#F0DDB0', 20); this.add(sand, 0, .05, 0); sand.scale.z = 1.6;\n    const beam = box(.5, .12, 2.3, '#B58457'); this.add(beam, 0, .55, 0); for (const z of [-.9, .9]) this.add(at(box(.3, .5, .3, '#7A5A3C'), 0, .25, z));\n    this.add(lantern(), -3, 0, -2); this.add(lantern(), 3, 0, -2); this.add(crate(.8), 3.6, 0, 1); this.add(palm(1.4), -6, -.5, -5); this.add(buoy(), 7, -.4, 2);\n    this.add(bunting(-4, 2.8, -3, 4, 2.8, -3, 12));\n    this.walrus = makeWalrus(); this.add(this.walrus.group, -3, 0, .1); this.walrus.group.rotation.y = 1; this.anim.push(this.walrus);\n    this.gullsOn = []; this.spawnT = 2; this.lastSide = this.r() < .5 ? -1 : 1; this.flyers = [];\n  }\n  placeCamera(snap) { this.game.rig.set(0, 2.1, 7.2, 0, .95, 0, snap); }\n  start() { for (const l of this.lanes) { l.inT = 0; l.outT = 0; l.gulls = []; l.zone = { x: 0, z: 0, r: .28 }; l.sway = .1; l.tremor = .03; l.baseClip = 'plank'; l.doll.rig.play('plank', 0); l.customPose = true; l.flailPenalty = 0; } }\n  land(l) {\n    const r = this.r(); const same = this.r() < .7; const side = same ? this.lastSide : -this.lastSide; this.lastSide = side;\n    const mag = this.tier.push[0] + r * (this.tier.push[1] - this.tier.push[0]);\n    const g = makeGull(); const spot = SPOTS[l.gulls.length % SPOTS.length]; g.rig.play('fly', 0); this.group.add(g.group); this.anim.push(g);\n    const entry = { g, side, mag, spot, t: 0 }; l.gulls.push(entry); g.group.position.set(side * 7, 5, -2);\n    this.game.audio.sfx('squawk'); if (l.kind === 'local' && this.barkT <= 0) this.bark('bolster', 'plank');\n  }\n  shake(l) { for (const e of l.gulls) { e.leaving = true; e.g.rig.play('fly', .05); this.flyers.push(e); } l.gulls = []; }\n  fixedPlay(dt) {\n    this.spawnT -= dt;\n    if (this.spawnT <= 0 && this.playT < this.timeLimit - 1) { this.spawnT = this.tier.every; for (const l of this.lanes) if (l.bal && !l.fallen) this.land(l); }\n    for (const l of this.lanes) {\n      if (!l.bal || l.fallen) continue;\n      let px = 0; for (const e of l.gulls) if (e.t > .8) px += e.side * e.mag; l.extraX += px; l.gullPush = px;\n      const inz = Math.hypot(l.bal.cobX, l.bal.cobZ) <= l.zone.r;\n      if (inz) { l.inT += dt; l.outT = 0; } else { l.outT += dt; if (l.outT > 2 && !this.god) { this.fall(l); l.outT = 0; } }\n      l.score = 100 * l.inT / this.timeLimit + 3 * l.gulls.length - l.flailPenalty; l.form = Math.max(0, Math.min(100, 100 * l.score / this.tier.par));\n    }\n    if (this.playT >= this.timeLimit) this.finish();\n  }\n  onFlail(l) { if (l.gulls.length) { this.shake(l); l.flailPenalty += 8; this.walrus.rig.play('salute', .2, 'bounce'); if (l.kind === 'local') this.game.barkNow('bolster', 'plankFlail'); } }\n  onFall(l) { this.shake(l); l.customPose = false; this.game.audio.sfx('splash', { big: .3 }); this.game.comic('FLOMP', 0, 1.2, 0, '#FFF8EE', .8); if (l.kind === 'local') this.bark('bolster', 'fall'); }\n  onRecover(l) { l.customPose = true; l.doll.rig.play('plank', .1); }\n  frameLane(l, dt) {\n    if (!l.bal || l.fallen) return;\n    const rock = l.bal.leanX * .5, pitch = l.bal.leanZ * .25;\n    l.doll.group.position.set(0, .86, -.72);\n    // Face down along z, rocking side to side.\n    const q = new THREE.Quaternion().setFromEuler(new THREE.Euler(Math.PI / 2 + pitch, 0, -rock * .0, 'XYZ'));\n    const r = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 0, 1), -rock); l.doll.lean.quaternion.copy(r).multiply(q);\n    for (const e of l.gulls) {\n      e.t += dt; const a = Math.min(1, e.t / .8), s = a * a * (3 - 2 * a);\n      const tx = e.spot[0] + Math.sin(rock) * .75, ty = 1.13 + e.spot[0] * Math.sin(rock) * 0, tz = -.65 + e.spot[1] * 1.3;\n      e.g.group.position.set(lane(e.side * 7, tx, s), lane(5, ty, s), lane(-2, tz, s));\n      if (a >= 1 && !e.down) { e.down = true; e.g.rig.play('land', .05, 'stand'); this.game.audio.sfx('fruit'); this.game.rumble(l, .2, .07); }\n    }\n    function lane(a, b, t) { return a + (b - a) * t; }\n  }\n  frame2(dt) {\n    for (let i = this.flyers.length - 1; i >= 0; i--) { const e = this.flyers[i]; e.g.group.position.y += dt * 4; e.g.group.position.x += e.side * dt * 5; if (e.g.group.position.y > 9) { this.group.remove(e.g.group); this.anim.splice(this.anim.indexOf(e.g), 1); this.flyers.splice(i, 1); } }\n    const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(l.gulls.length, 'Gulls'); this.setTime(this.timeLimit - this.playT); }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const G = 9.81 * .75, K = G * 1.45;\n    const push = l.gullPush || 0; const [x, z] = br.correct(dt, l, 0, 0, false);\n    const counter = -push / (K * (18 * Math.PI / 180));\n    const out = Math.hypot(l.bal.cobX, l.bal.cobZ) > .7 && l.outT > 1.2;\n    const wx = x + counter * (skill === 'sharp' ? 1 : skill === 'average' ? .8 : .6);\n    return { x: Math.max(-1, Math.min(1, wx)), z, flail: out };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.gulls.length, label: 'Gulls on you', stats: `In the zone ${Math.round(100 * l.inT / this.timeLimit)}%. Floor Exercises: ${l.falls}` }; }\n  forceThing() { for (const l of this.lanes) if (l.bal && !l.fallen) this.land(l); }\n}\nE\ncat > src/events/tug.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { cyl, box, at, sphere, palm, torus, capsule, rock, bunting, buoy } from '../art/props.js';\nimport { makeDoll } from '../art/doll.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { GUESTS } from '../data/names.js';\nconst CALL = 1.2;\nexport class Tug extends EventBase {\n  static id = 'tug'; static title = 'Tug of Peace'; static discipline = 'Strength'; static instructor = 'bolster'; static place = 'The Beach'; static music = 'strength'; static couch = true; static diagram = 'tug';\n  static sentence = 'On the call, squeeze both feet and lean back. Best of three pulls.';\n  static can = 'You can lean back further for more pull, and pay for it when they ease off.'; static cant = \"You can't pull between calls. Peace has rules.\";\n  static verbs = [['lean', 'Lean back'], ['feet', 'Heave'], ['flail', 'Flail']];\n  static tiers = [{ their: .35, ease: 0 }, { their: .5, ease: 12 }, { their: .54, ease: 9 }];\n  buildSet() {\n    const n = this.opts.laneCount || 1; this.laneSpacing = 2.4;\n    this.add(cyl(14, 15, 1, '#F0DDB0', 32), 0, -.5, 0);\n    for (let i = -5; i <= 5; i++) { const m = box(.08, .02, 1.6, i === 0 ? '#E8443A' : '#C9B488'); this.add(m, i * .8, .012, 0); }\n    this.add(palm(1.6), -9, 0, -6); this.add(palm(1.3), 9, 0, -5); this.add(rock(.7), 7, .1, -7); this.add(buoy(), 3, -.4, -13); this.add(bunting(-7, 3.2, -4, 7, 3.2, -4, 18));\n    this.rope = new THREE.Group(); const line = cyl(.035, .035, 12, '#E9D3AE', 8); line.rotation.z = Math.PI / 2; this.rope.add(at(line, 0, 1.05, 0)); const flag = box(.1, .4, .02, '#E8443A'); this.rope.add(at(flag, 0, .8, 0)); this.add(this.rope);\n    this.walrus = makeWalrus(); this.add(this.walrus.group, 0, 0, -2.6); this.anim.push(this.walrus);\n    this.pos = 0; this.pullsA = 0; this.pullsB = 0; this.pullN = 0; this.callT = 2; this.callIdx = 0; this.easeT = this.tier.ease; this.easing = 0; this.resolveQ = []; this.pullBreak = 0; this.flagShake = 0;\n    this.aiDolls = [];\n  }\n  placeCamera(snap) { this.game.rig.set(0, 2.4, 10.8, 0, 1.1, 0, snap); }\n  laneX(i, n) { const side = i % 2 === 0 ? -1 : 1, rank = Math.floor(i / 2); return side * (2.2 + rank * 1.5); }\n  start() {\n    const anyB = this.lanes.some(l => l.id % 2 === 1 && l.kind !== 'ghost'); this.aiB = !anyB;\n    for (const l of this.lanes) { l.team = l.id % 2 === 0 ? 'A' : 'B'; l.customPose = true; l.baseClip = 'tug'; l.doll.rig.play('tug', 0); l.doll.setFace(l.team === 'A' ? Math.PI / 2 : -Math.PI / 2); l.pressT = -9; l.power = 0; l.err = 0; l.nextPress = null; }\n    // Solo: you and Retired Kevin against Both Sandras.\n    if (this.aiB) {\n      const add = (g, x, face) => { const d = makeDoll({ paint: g.paint, hat: g.hat, skin: g.skin, height: g.height, width: g.width }); d.group.position.set(x, 0, 0); d.setFace(face); d.rig.play('tug', 0); this.group.add(d.group); this.anim.push(d); this.aiDolls.push({ d, face, base: x }); };\n      add(GUESTS[1], -3.7, Math.PI / 2); add(GUESTS[2], 2.2, -Math.PI / 2); add(GUESTS[3], 3.7, -Math.PI / 2);\n    }\n  }\n  teamPower(team) { const list = this.lanes.filter(l => l.team === team && l.kind !== 'ghost'); if (!list.length) return null; let s = 0; for (const l of list) s += l.power; return s / list.length; }\n  fixedPlay(dt) {\n    if (this.pullBreak > 0) { this.pullBreak -= dt; if (this.pullBreak <= 0) { this.pos = 0; this.setMsg(''); this.callT = 1.5; for (const l of this.lanes) l.power = 0; } return; }\n    const their = this.tier.their;\n    // Press detection: both feet squeeze.\n    for (const l of this.lanes) {\n      if (!l.bal) continue;\n      const both = l.in.lf > .5 && l.in.rf > .5 || l.in.hop;\n      if (both && !l.wasBoth && !l.fallen) { const err = Math.min(Math.abs(this.playT - (this.lastCall ?? -9)), Math.abs(this.playT - (this.lastCall ?? -9) - CALL), Math.abs(this.callAt - this.playT)); l.power = Math.max(0, 1 - err / .3) * Math.max(0, l.bal.leanZ / l.bal.maxLeanRad()); l.pressT = this.playT; this.game.audio.sfx('foot'); }\n      l.wasBoth = both;\n      const tension = this.easing > 0 ? 0 : 1; const tp = this.oppPower(l, their);\n      if (!l.fallen) l.extraZ -= (.1 + .3 * tp) * tension;\n    }\n    this.callT -= dt; this.callAt = this.playT + Math.max(0, this.callT);\n    if (this.callT <= 0) {\n      this.callT = CALL; this.lastCall = this.playT; this.game.audio.speak('bolster', 'Heave!'); this.game.audio.sfx('rim'); this.setBig('HEAVE!'); this.game.after(.3, () => { this.setBig(''); });\n      // Resolve shortly after the call so a press just after it still counts.\n      this.game.after(.32, () => this.resolve(their));\n    }\n    if (this.tier.ease) {\n      this.easeT -= dt;\n      if (this.easeT <= 0) { this.easeT = this.tier.ease * (.8 + this.r() * .4); this.easing = .8; this.setMsg('They eased off!'); for (const l of this.lanes) if (l.bal && !l.fallen && l.bal.leanZ / l.bal.maxLeanRad() > .72) { this.gust(l, 0, 3.2, .5); l.overlean = true; } this.game.after(.8, () => this.setMsg('')); }\n      if (this.easing > 0) this.easing -= dt;\n    }\n    if (this.playT > 240) this.finish();\n  }\n  oppPower(l, base) { const opp = l.team === 'A' ? 'B' : 'A'; const p = this.teamPower(opp); return p == null ? base : Math.max(.2, p); }\n  resolve(their) {\n    if (this.phase !== 'play' || this.pullBreak > 0 || this.disposed) return;\n    const a = this.teamPower('A') ?? 0, bReal = this.teamPower('B');\n    const b = bReal == null ? their * (.8 + this.r() * .4) : bReal;\n    this.pos += (a - b) * .33; this.flagShake = 1;\n    for (const l of this.lanes) l.power = 0;\n    if (Math.abs(this.pos) >= 1) {\n      const aWon = this.pos > 0; if (aWon) this.pullsA++; else this.pullsB++; this.pullN++;\n      this.setMsg(`${aWon ? 'Your side' : 'Their side'} took the pull. ${this.pullsA} to ${this.pullsB}`); this.game.audio.sfx('bell'); this.game.audio.sfx('cheer');\n      if (this.pullsA >= 2 || this.pullsB >= 2 || this.pullN >= 3) { this.finish(); this.tally(); return; }\n      this.pullBreak = 2.2;\n    }\n    this.tally();\n  }\n  tally() { for (const l of this.lanes) { const won = l.team === 'A' ? this.pullsA : this.pullsB; l.form = Math.max(0, Math.min(100, 40 + 30 * won - 5 * l.falls)); l.score = won; } }\n  onFall(l) { const d = l.team === 'A' ? -.3 : .3; this.pos += d; l.customPose = false; if (l.kind === 'local') this.game.barkNow('bolster', 'tugSit'); this.tally(); }\n  onRecover(l) { l.customPose = true; l.doll.rig.play('tug', .1); }\n  frameLane(l) {\n    if (!l.bal || l.fallen) return; const dir = l.team === 'A' ? -1 : 1;\n    const back = l.bal.leanZ; l.doll.group.position.set(l.x + this.pos * 1.6, 0, 0); l.doll.setLean(dir * back * 1.2, l.bal.leanX * .4);\n  }\n  frame2() {\n    this.rope.position.x = this.pos * 1.6; if (this.flagShake > 0) this.flagShake = Math.max(0, this.flagShake - .05);\n    for (const a of this.aiDolls) { a.d.group.position.x = a.base + this.pos * 1.6; const dir = a.base < 0 ? -1 : 1; a.d.setLean(dir * (.12 + .1 * Math.max(0, Math.sin(this.t * 5.2 + a.base))), 0); }\n    this.setNum(`${this.pullsA}-${this.pullsB}`, 'Pulls'); this.setTime(null);\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const stick = this.tier.ease ? (this.tierIndex === 2 ? .95 : .85) : .9;\n    const [x, z] = br.correct(dt, l, 0, stick, false, .5);\n    if (l.nextErr === undefined || l.lastCallSeen !== this.lastCall) { l.lastCallSeen = this.lastCall; l.nextErr = br.gauss() * br.s.timing; l.pressed = false; }\n    const toCall = this.callAt - this.playT; const fire = !l.pressed && this.callT > 0 && toCall - l.nextErr < .004 + dt;\n    if (fire) { l.pressed = true; l.pressHold = .06; }\n    const held = (l.pressHold || 0) > 0; if (held) l.pressHold -= dt;\n    return { x, z, lf: held ? 1 : 0, rf: held ? 1 : 0, flail: (l.bal?.angle || 0) > .56 };\n  }\n  laneResult(i) { const l = this.lanes[i]; const won = l.team === 'A' ? this.pullsA : this.pullsB, lost = l.team === 'A' ? this.pullsB : this.pullsA; return { form: l.form, big: `${won}-${lost}`, label: 'Pulls', stats: `Floor Exercises: ${l.falls}. Peace has been achieved, roughly.` }; }\n  forceThing() { this.easeT = 0; }\n}\nE\ncat > src/events/stepClass.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { CHARTS, chartNotes } from '../data/charts.js';\nimport { T } from '../core/tuning.js';\nimport { cyl, box, at, sphere, cone, bunting, lantern, palm, torus, mesh, toon, flat } from '../art/props.js';\nimport { makeDoll, PAINTS, HATS } from '../art/doll.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { el, txt } from '../ui/ui.js';\nconst SYM = { L: 'L', R: 'R', B: 'L+R', '<': '←', '>': '→', '^': '↑', v: '↓' };\nconst COL = { L: '#3B82F6', R: '#E8443A', B: '#F5B700', '<': '#7FD6C8', '>': '#7FD6C8', '^': '#7FD6C8', v: '#7FD6C8' };\nconst DIRS = { '<': [-1, 0], '>': [1, 0], '^': [0, -1], v: [0, 1] };\nexport class StepClass extends EventBase {\n  static id = 'stepClass'; static title = 'Step Class'; static discipline = 'Cardio'; static instructor = 'bolster'; static place = 'The Bandstand'; static music = 'cardio'; static palette = 'dusk'; static couch = true; static session = true; static diagram = 'feet';\n  static sentence = 'Press each foot as its print reaches the line. Lean into the arrows. The class copies you.';\n  static can = 'You can lead lean arrows early: the dot is slow.'; static cant = \"You can't fall in time with the music. You can fall, but not in time.\";\n  static verbs = [['left', 'Left'], ['right', 'Right'], ['hop', 'Both'], ['lean', 'Lean']];\n  static tiers = [{ chart: 'tier1' }, { chart: 'tier2' }, { chart: 'tier3' }];\n  static sessionConfig = { tier: 1, chart: 'session' };\n  buildSet() {\n    this.chart = CHARTS[this.opts.chart || this.tier.chart]; const c = chartNotes(this.chart); this.beat = c.beat; this.length = c.length; this.baseNotes = c.notes; this.timeLimit = c.length + .5; this.chartT = -3; this.combo = 0;\n    const n = this.opts.laneCount || 1, w = 7 + n * 2.5;\n    const stage = cyl(w, w + .3, .5, '#C89B6A', 8); stage.rotation.y = .39; this.add(stage, 0, -.25, -1.5);\n    for (let i = 0; i < 8; i++) { const a = i / 8 * 6.283 + .39; this.add(at(cyl(.12, .14, 4.2, '#FFF8EE'), Math.sin(a) * (w - .4), 2.1, Math.cos(a) * (w - .4) - 1.5)); }\n    const roof = cone(w + 1.2, 2.2, '#2FA7A0', 8); roof.rotation.y = .39; this.add(roof, 0, 5.3, -1.5);\n    this.add(bunting(-w + .5, 3.8, -1.5 + 3, w - .5, 3.8, -1.5 + 3, 18)); this.add(palm(1.7), -w - 2.5, -.5, -3); this.add(palm(1.5), w + 2.5, -.5, -4);\n    this.spots = []; for (const s of [-1, 1]) { const sp = new THREE.Mesh(new THREE.ConeGeometry(1.4, 4.5, 18, 1, true), flat('#FFF2C2', .22)); sp.position.set(s * 2.6, 2.6, .2); sp.visible = false; this.add(sp); this.spots.push(sp); }\n    this.klass = []; const rows = [[-3.4, -2.6], [-1.15, -2.6], [1.15, -2.6], [3.4, -2.6], [-3.4, -4.3], [-1.15, -4.3], [1.15, -4.3], [3.4, -4.3]];\n    rows.forEach(([x, z], i) => { const d = makeDoll({ paint: PAINTS[i % PAINTS.length], hat: HATS[(i * 3) % HATS.length], height: .92 + (i % 3) * .05 }); d.group.position.set(x, 0, z); d.rig.play('idle', 0); d.tripT = 0; this.add(d.group); this.anim.push(d); this.klass.push(d); });\n    this.walrus = makeWalrus(); this.add(this.walrus.group, -5, 0, -.8); this.walrus.group.rotation.y = .6; this.anim.push(this.walrus);\n    this.beatLight = sphere(.25, '#FFD23F'); this.add(this.beatLight, 0, 4.3, -1); this.lastBeat = -1;\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(8, spread); this.game.rig.set(0, 2, d, 0, 1.35, -.5, snap); }\n  setupHud2() { this.rib = el('div', 'ribbon'); this.rib.appendChild(el('div', 'target')); this.hudEl.appendChild(this.rib); this.noteEls = new Map(); this.judgeEl = txt('div', 'hudmsg', ''); }\n  start() {\n    for (const l of this.lanes) {\n      l.notes = this.baseNotes.map(n => ({ ...n, state: 0 })); l.earned = 0; l.maxScore = 0; l.combo = 0; l.bestCombo = 0; l.perfect = 0; l.good = 0; l.ok = 0; l.miss = 0; l.lp = false; l.rp = false; l.ni = 0; l.baseClip = 'idle';\n      if (l.kind === 'bot' || this.game.testBotSkill) l.plan = null;\n    }\n    this.notes0 = this.baseNotes;\n    this.maxPts = this.baseNotes.length;\n  }\n  onPlayStart() {\n    const a = this.game.audio; this.audioRef = null;\n    if (a.running) { const when = a.now() + .05; this.audioRef = when; a.playTrack('cardio', { bpm: this.chart.bpm, startAt: when }); } else a.playTrack('cardio', { bpm: this.chart.bpm });\n    this.chartT = 0;\n  }\n  clock(dt) {\n    this.chartT += dt; const a = this.game.audio;\n    if (this.audioRef != null && a.running && !this.game.manual) {\n      const off = (this.game.settings?.rhythmOffset || 0) / 1000, at = a.now() - this.audioRef - (a.ctx.outputLatency || 0) - off;\n      if (Math.abs(at - this.chartT) > .25) this.audioRef = a.now() - this.chartT - (a.ctx.outputLatency || 0) - off; else this.chartT = at;\n    }\n  }\n  fixedPlay(dt) {\n    this.clock(dt); const t = this.chartT, W = T.rhythmWindow * this.diff.win; const P = .045 * W, G = .09 * W, O = .135 * W, beat = this.beat;\n    const bn = Math.floor(t / beat); if (bn !== this.lastBeat) { this.lastBeat = bn; this.beatPulse = 1; if (bn % 2 === 0) this.game.audio.sfx('tick', { high: bn % 8 === 0 }); this.walrus.rig.play('clap', .1); }\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost' || !l.bal) continue;\n      const I = l.in; const L = I.lf > .5, R = I.rf > .5; const lE = L && !l.lp, rE = R && !l.rp; l.lp = L; l.rp = R;\n      const hop = I.hop;\n      if (!l.fallen) {\n        if (hop || lE || rE) {\n          // Find the nearest unjudged foot note.\n          let best = null, bd = 1; for (let i = l.ni; i < l.notes.length; i++) { const n = l.notes[i]; if (n.t > t + O + .1) break; if (n.state || !'LRB'.includes(n.k)) continue; const d = Math.abs(n.t - t); if (d < bd && d <= O) { const fits = n.k === 'B' ? (hop || lE || rE) : ((n.k === 'L' && (lE || hop)) || (n.k === 'R' && (rE || hop))); if (fits) { bd = d; best = n; } } }\n          if (best) {\n            if (best.k === 'B' && !hop) { if (best.first != null && t - best.first < .12) this.judge(l, best, Math.abs(best.first - best.t), P, G); else best.first = t; if (L && R) this.judge(l, best, Math.abs(t - best.t), P, G); }\n            else this.judge(l, best, bd, P, G);\n          }\n          if (lE) { l.doll.rig.play('stepL', .05, 'idle'); } if (rE) { l.doll.rig.play('stepR', .05, 'idle'); }\n          this.game.audio.sfx('foot', { high: rE });\n        }\n      }\n      // Misses and lean notes\n      for (let i = l.ni; i < l.notes.length; i++) {\n        const n = l.notes[i]; if (n.t > t + 1) break;\n        if (n.state) { if (i === l.ni) l.ni++; continue; }\n        if (DIRS[n.k]) {\n          if (t < n.t - .25 * beat) continue; const [dx, dz] = DIRS[n.k]; const v = l.bal.cobX * dx + l.bal.cobZ * dz, age = t - n.t;\n          if (v >= .25 && age <= 1.5 * beat) { n.state = 1; l.earned += 1; this.hit(l, 'NICE'); }\n          else if (v >= .25 && age <= 2 * beat) { n.state = 1; l.earned += .5; l.ok++; this.hit(l, 'OK'); }\n          else if (age > 2 * beat) { n.state = 2; this.missed(l); }\n        } else if (t - n.t > O) { n.state = 2; this.missed(l); }\n      }\n      l.form = Math.min(100, 100 * l.earned / Math.max(1, this.maxPts)); l.score = l.earned;\n      // Guide the bot's lean ribbon\n      l.leanGoal = this.leanAt(t);\n    }\n    if (t >= this.length) this.finish();\n  }\n  leanAt(t) { for (const n of this.baseNotes) { if (DIRS[n.k] && n.t + this.beat * .9 > t && n.t - this.beat * .9 < t) return DIRS[n.k]; } return null; }\n  judge(l, n, d, P, G) {\n    n.state = 1; let w = .4, word = 'OK'; if (d <= P) { w = 1; word = 'PERFECT'; l.perfect++; } else if (d <= G) { w = .7; word = 'GOOD'; l.good++; } else l.ok++;\n    l.earned += w; this.hit(l, word);\n  }\n  hit(l, word) {\n    l.combo++; l.bestCombo = Math.max(l.bestCombo, l.combo);\n    if (l.kind === 'local') { this.lastWord = word; this.wordT = .4; }\n    if (l.id === 0) { const k = this.klass; const sync = Math.min(8, Math.floor(l.combo / 2)); for (let i = 0; i < sync; i++) { const d = k[i]; if (d.tripT <= 0) d.rig.play(l.combo % 2 ? 'stepL' : 'stepR', .05, 'idle'); } }\n    if (l.combo === 16 && l.id === 0) { for (const s of this.spots) s.visible = true; this.game.particles.confetti(0, 5, -1, 80); this.game.audio.sfx('cheer'); if (!this.attract) this.game.barkNow('bolster', 'step'); }\n  }\n  missed(l) { if (l.combo >= 16 && l.id === 0) for (const s of this.spots) s.visible = false; l.combo = 0; l.miss++; if (l.id === 0) { const d = this.klass[Math.floor(this.r() * 8)]; d.tripT = 1; d.rig.play('flop', .05); this.game.after(.9, () => { if (!this.disposed) { d.tripT = 0; d.rig.play('idle', .2); } }); if (l.kind === 'local' && this.barkT <= 0) this.bark('bolster', 'stepMiss'); } }\n  frame2(dt) {\n    const l = this.localLanes()[0] || this.lanes[0]; if (!l || !l.notes) return;\n    this.setNum(l.combo, 'Combo'); this.setTime(this.phase === 'play' ? this.length - this.chartT : null);\n    if (this.wordT > 0) { this.wordT -= dt; this.setMsg(this.lastWord); } else this.setMsg('');\n    this.beatPulse = (this.beatPulse || 0) * Math.exp(-7 * dt); if (this.beatLight) this.beatLight.scale.setScalar(.25 * (1 + this.beatPulse * .9)); this.beatT = (this.beatT || 0) + dt;\n    for (const s of this.spots) if (s.visible) s.rotation.z = Math.sin(this.t * 1.6 + s.position.x) * .4;\n    if (!this.rib) return;\n    const t = this.chartT, span = 2.6, seen = new Set();\n    for (let i = l.ni; i < l.notes.length; i++) {\n      const n = l.notes[i]; if (n.t > t + span) break; if (n.state) continue; seen.add(n);\n      let e = this.noteEls.get(n); if (!e) { e = el('div', 'note'); e.textContent = SYM[n.k]; e.style.background = COL[n.k]; this.rib.appendChild(e); this.noteEls.set(n, e); }\n      e.style.left = `${10 + (n.t - t) / span * 90}%`;\n    }\n    for (const [n, e] of this.noteEls) if (!seen.has(n)) { e.remove(); this.noteEls.delete(n); }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const ct = this.chartT; if (!l.notes) return {};\n    l.lfT = (l.lfT || 0) - dt; l.rfT = (l.rfT || 0) - dt;\n    if (l.planI === undefined) { l.planI = 0; }\n    const missRate = skill === 'sharp' ? .005 : skill === 'average' ? .02 : .06;\n    while (l.planI < l.notes.length && l.notes[l.planI].t + .2 < ct) l.planI++;\n    for (let k = l.planI; k < l.notes.length; k++) {\n      const n = l.notes[k]; if (n.t > ct + .3) break; if (n.bp) continue; if (!'LRB'.includes(n.k)) { n.bp = true; continue; }\n      if (n.fireAt === undefined) { n.fireAt = n.t + br.gauss() * br.s.timing; n.skip = br.r() < missRate; }\n      if (ct >= n.fireAt) { n.bp = true; if (!n.skip) { if (n.k !== 'R') l.lfT = .05; if (n.k !== 'L') l.rfT = .05; } }\n    }\n    const goal = (() => { for (const n of l.notes) { if (DIRS[n.k] && !n.state && n.t - this.beat * 1.1 < ct && n.t + this.beat * 2 > ct) return DIRS[n.k]; } return [0, 0]; })();\n    const [x, z] = br.correct(dt, l, goal[0] * .6, goal[1] * .6);\n    return { x, z, lf: l.lfT > 0 ? 1 : 0, rf: l.rfT > 0 ? 1 : 0 };\n  }\n  onDispose() { this.game.audio.stopTrack(.4); }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.bestCombo, label: 'Best combo', stats: `Perfect ${l.perfect}, Good ${l.good}, OK ${l.ok}, Missed ${l.miss}` }; }\n  forceThing() { this.game.particles.confetti(0, 5, -1, 80); }\n}\nE\ncat > src/events/plates.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { cyl, box, at, sphere, cone, torus, bunting, tree, toon, plate as plateMesh, mesh, cached } from '../art/props.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { el, txt } from '../ui/ui.js';\nconst BANDS = { L: [3.5, 5, '#3B82F6', .42, 'Large'], M: [6.5, 8, '#22C55E', .32, 'Medium'], S: [9.5, 11, '#E8443A', .23, 'Small'] };\nexport class Plates extends EventBase {\n  static id = 'plates'; static title = 'Plate Spinners'; static discipline = 'Cardio'; static instructor = 'bolster'; static place = 'The Circus Green'; static music = 'cardio'; static couch = true; static session = true; static diagram = 'circle';\n  static sentence = 'Circle the stick to drive the hoop. Large plates want slow, small plates want fast.';\n  static can = 'You can change speed to save another plate. It takes a moment.'; static cant = \"You can't fall in this one. Only the plates can.\";\n  static verbs = [['circle', 'Circle']];\n  static tiers = [{ plates: 'LMS', decay: .11 }, { plates: 'LMMS', decay: .13 }, { plates: 'LLMMSS', decay: .16 }];\n  static sessionConfig = { tier: 0, time: 50 };\n  buildSet() {\n    this.noFall = true; this.timeLimit = this.opts.time || 60; this.flailOk = false; this.showDisc = true;\n    this.add(cyl(11, 11.2, .6, '#7CC568', 40), 0, -.3, 0); this.add(cyl(4.5, 4.5, .02, '#FFF2C2', 40), 0, .012, 0);\n    const tent = cone(3, 2, '#E8443A', 10); this.add(tent, -7, 4.2, -6); this.add(at(cyl(3, 3, 3.2, '#FFF8EE', 10), -7, 1.6, -6)); this.add(tree(1.4), 7.5, 0, -6); this.add(bunting(-6, 4.2, -5.2, 6.5, 4.2, -5.2, 18));\n    this.walrus = makeWalrus(); this.add(this.walrus.group, 4.5, 0, -3.1); this.walrus.group.rotation.y = -.7; this.anim.push(this.walrus);\n    this.shards = [];\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(9, spread); this.game.rig.set(0, 5.3, d, 0, 1, -.3, snap); }\n  setupHud2() { this.gaugeRow = el('div', 'gaugeRow'); this.hudEl.appendChild(this.gaugeRow); const l = this.lanes[0]; this.gauges = (l?.plates || []).map(p => { const a = el('div', 'arc'); a.innerHTML = `<svg viewBox=\"-55 -55 110 70\" width=\"100%\"><path d=\"M-44 8 A44 44 0 0 1 44 8\" fill=\"none\" stroke=\"#1A1420\" stroke-width=\"16\"/><path class=\"v\" d=\"M-44 8 A44 44 0 0 1 44 8\" fill=\"none\" stroke=\"${BANDS[p.kind][2]}\" stroke-width=\"10\" pathLength=\"100\" stroke-dasharray=\"70 100\"/></svg>`; const lb = txt('div', 'gaugeTag', BANDS[p.kind][4]); a.appendChild(lb); this.gaugeRow.appendChild(a); return { v: a.querySelector('.v'), lb }; }); }\n  start() {\n    const kinds = this.tier.plates;\n    for (const l of this.lanes) {\n      l.w = 0; l.hoop = 0; l.phase = 0; l.lastAng = null; l.keyW = 0; l.lastTap = -9; l.lastKey = null; l.alive = 0; l.total = 0; l.crashes = 0; l.baseClip = 'hipCircle'; l.doll.rig.scrub('hipCircle', 0, 0); l.botPh = 0; l.botW = 0; l.sway = .02; l.bandGoal = null;\n      const hoop = torus(.42, .035, '#F5B700'); hoop.rotation.x = Math.PI / 2; hoop.position.y = .72; l.doll.group.add(hoop); l.hoopM = hoop;\n      const ringM = torus(.54, .03, '#FFF8EE'); ringM.rotation.x = Math.PI / 2; ringM.position.y = .03; l.doll.group.add(ringM); l.ringM = ringM;\n      l.plates = [...kinds].map((k, i) => {\n        const n = kinds.length; const a = -Math.PI * .85 + (i + .5) / n * Math.PI * .7 * 2 / 1.4 * .7 * 2; const R = this.lanes.length > 1 ? 1.2 : 2.6, x = l.x + Math.cos(a) * R, z = Math.sin(a) * R - .4;\n        const pole = cyl(.03, .05, 1.9, '#FFF8EE'); pole.position.set(x, .95, z); this.group.add(pole);\n        const grp = new THREE.Group(); grp.position.set(x, 1.95, z); const pm = plateMesh(BANDS[k][3], BANDS[k][2]); grp.add(pm); this.group.add(grp);\n        return { kind: k, energy: .7, x, z, grp, pm, dead: 0, spin: 0 };\n      });\n    }\n  }\n  fixedPlay(dt) {\n    const gain = .45 * T.plateGain, decay = this.tier.decay * T.plateDecay;\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') continue;\n      const I = l.in; const usingKeys = I.dev === 'kbm' && (I.tapA || I.tapD || (this.t - l.lastTap < 1.2));\n      if (I.tapA || I.tapD) { const k = I.tapA ? 'a' : 'd'; if (k !== l.lastKey) { const gap = this.t - l.lastTap; if (gap > .03 && gap < 1.4) l.keyW = Math.PI / gap; l.lastKey = k; l.lastTap = this.t; } }\n      let target;\n      if (usingKeys) { target = l.keyW; if (this.t - l.lastTap > .9) target = 0; }\n      else {\n        const m = Math.hypot(I.x, I.z);\n        if (m > .5) { const a = Math.atan2(I.z, I.x); if (l.lastAng != null) { let d = a - l.lastAng; if (d > Math.PI) d -= 6.283; if (d < -Math.PI) d += 6.283; l.w += (Math.abs(d) / dt - l.w) * (1 - Math.exp(-dt / .12)); } l.lastAng = a; target = l.w; }\n        else { l.w *= Math.exp(-3 * dt); l.lastAng = null; target = l.w; }\n      }\n      l.hoop += (target - l.hoop) * (1 - Math.exp(-dt / .5)); l.phase += l.hoop * dt;\n      for (const p of l.plates) {\n        l.total += dt;\n        if (p.dead > 0) { p.dead -= dt; if (p.dead <= 0) { p.energy = .7; p.grp.visible = true; this.game.audio.sfx('spring'); } continue; }\n        l.alive += dt;\n        const b = BANDS[p.kind]; const inb = l.hoop >= b[0] && l.hoop <= b[1]; p.inBand = inb;\n        p.energy += (inb ? gain - decay * 0 : -decay) * dt; p.energy = Math.min(1, p.energy);\n        if (p.energy <= 0) this.smash(l, p);\n      }\n      l.score = l.total ? l.alive / l.total : 0;\n      l.form = Math.max(0, 200 * l.score - 100);\n    }\n    if (this.playT >= this.timeLimit) this.finish();\n  }\n  smash(l, p) {\n    p.dead = 6; p.grp.visible = false; l.crashes++; this.game.audio.sfx('crash'); this.game.comic('CRASH!', p.x, 2.2, p.z, '#FFD23F', .8); this.game.rumble(l, .6, .2);\n    if (l.kind === 'local' && this.barkT <= 0) this.bark('bolster', 'plates');\n    for (let i = 0; i < 6; i++) {\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x, 1.95, p.z).setLinvel((this.r() - .5) * 4, 1 + this.r() * 3, (this.r() - .5) * 4).setAngvel({ x: this.r() * 8, y: this.r() * 8, z: this.r() * 8 }));\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(.1, .02, .1).setMass(.02).setRestitution(.3).setCollisionGroups(G_PROP(l.id)), body);\n      const m = box(.2, .04, .2, BANDS[p.kind][2]); this.group.add(m); this.shards.push({ body, m, left: 2.2 });\n    }\n  }\n  postPlay(dt) { for (let i = this.shards.length - 1; i >= 0; i--) { const s = this.shards[i]; s.left -= dt; const q = s.body.rotation(), t = s.body.translation(); s.m.position.set(t.x, t.y, t.z); s.m.quaternion.set(q.x, q.y, q.z, q.w); if (s.left <= 0) { this.group.remove(s.m); this.world.removeRigidBody(s.body); this.shards.splice(i, 1); } } }\n  frameLane(l, dt) {\n    if (l.kind === 'ghost') return;\n    l.doll.rig.scrub('hipCircle', (l.phase / 6.283) % 1, 0); if (l.hoopM) { l.hoopM.position.x = Math.cos(l.phase) * .12; l.hoopM.position.z = Math.sin(l.phase) * .12; }\n    let band = null; for (const k in BANDS) if (l.hoop >= BANDS[k][0] && l.hoop <= BANDS[k][1]) band = k; if (l.ringM) l.ringM.material = toon(band ? BANDS[band][2] : '#FFF8EE');\n    for (const p of l.plates) {\n      if (p.dead > 0) continue; const w = (1 - p.energy) * .6; p.spin += (3 + p.energy * 18) * dt; p.grp.rotation.y = p.spin; p.grp.rotation.x = Math.sin(this.t * 7 + p.x) * w; p.grp.rotation.z = Math.cos(this.t * 7 + p.x) * w;\n    }\n  }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (!l) return; this.setNum(`${Math.round(l.score * 100)}%`, 'Alive'); this.setTime(this.timeLimit - this.playT); if (this.gauges) l.plates.forEach((p, i) => { const g = this.gauges[i]; if (g) g.v.setAttribute('stroke-dasharray', `${(p.dead > 0 ? 0 : p.energy) * 100} 100`); }); }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const s = br.s;\n    l.botT = (l.botT || 0) - dt;\n    if (l.botT <= 0) { l.botT = s.lag + .1; let low = null; for (const p of l.plates) if (p.dead <= 0 && (!low || p.energy < low.energy)) low = p; if (low) { const b = BANDS[low.kind]; l.botGoal = (b[0] + b[1]) / 2 + br.gauss() * s.speedErr * .3; } l.botSlip = br.r() < (skill === 'clumsy' ? .08 : skill === 'average' ? .04 : 0); }\n    l.botW += ((l.botGoal || 0) - l.botW) * (1 - Math.exp(-dt / .15)); const w = l.botW + (l.botSlip ? -2 : 0) + Math.sin(this.t * 2.1) * s.speedErr * .45;\n    l.botPh += Math.max(.1, w) * dt;\n    return { x: Math.cos(l.botPh) * .9, z: Math.sin(l.botPh) * .9 };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: `${Math.round(l.score * 100)}%`, label: 'Plates alive', stats: `Crashes: ${l.crashes}` }; }\n  forceThing() { for (const l of this.lanes) { const p = l.plates?.find(q => q.dead <= 0); if (p) this.smash(l, p); } }\n  onDispose() {}\n}\nE\necho ok","description":"Write Plank, Tug, Step Class and Plates events"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0178rmhdpxP6yNhcpbypDqBs","type":"tool_result","content":"ok","is_error":false}]},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"7bfdb64e-e508-4bba-a8d6-e5034d43caa2","timestamp":"2026-11-05T12:21:07.377Z","tool_use_result":{"stdout":"ok","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0178rmhdpxP6yNhcpbypDqBs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmXFh1R2JtGr5JpntYg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01U6ztGdp1h7MVcBJZ42dTLA","name":"Bash","input":{"command":"cat > src/events/roomService.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { box, at, cyl, sphere, cone, plankWalk, buoy, palm, lantern, bunting, bench, flat, mesh, cached } from '../art/props.js';\nimport { makeGull } from '../art/gull.js';\nexport class RoomService extends EventBase {\n  static id = 'roomService'; static title = 'Room Service'; static discipline = 'Balance Play'; static instructor = 'trudy'; static place = 'The Boardwalk'; static music = 'balance'; static couch = true; static diagram = 'tray';\n  static sentence = 'Alternate your feet to walk the tray of glasses to the cabana. Lean early and small when wind comes.';\n  static can = 'You can lean into a gust before it arrives: the disc shows where.'; static cant = \"You can't walk with the same foot twice. That is a stumble.\";\n  static verbs = [['left', 'Left'], ['right', 'Right'], ['lean', 'Lean'], ['flail', 'Flail']];\n  static tiers = [{ length: 30, gust: 1.2, every: 7, gary: false, par: 560 }, { length: 45, gust: 2, every: 6, gary: true, par: 500 }, { length: 60, gust: 2.3, every: 5, gary: true, par: 440 }];\n  balanceOpts() { return { margin: .8, ankleMax: 6, reflex: 5 }; }\n  worldOpts() { return { iterations: 10 }; }\n  buildSet() {\n    this.len = this.tier.length; this.timeLimit = this.len * 3 + 30; const n = this.opts.laneCount || 1;\n    for (let i = 0; i < n; i++) { const w = plankWalk(this.len + 3, 1.6); w.position.set(this.laneX(i, n), 0, 3); this.add(w); for (const s of [-1, 1]) for (let k = 0; k < this.len / 6; k++) this.add(at(cyl(.03, .03, .8, '#E9D3AE', 8), this.laneX(i, n) + s * .82, .4, -k * 6)); }\n    // Far cabana and its table.\n    const z0 = -this.len;\n    const cab = new THREE.Group(); cab.add(at(box(5 + n * 2, .2, 4, '#C89B6A'), 0, -.1, -1)); for (const [x, z] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) cab.add(at(cyl(.08, .1, 2.8, '#FFF8EE'), x * 2, 1.4, z * 1.4 - 1)); cab.add(at(cone(3.8, 1.5, '#2FA7A0', 4), 0, 3.5, -1));\n    cab.add(at(cyl(.5, .5, .06, '#F5F0E0'), 0, .85, -.8)); cab.add(at(cyl(.05, .07, .85, '#7A5A3C'), 0, .42, -.8)); this.add(cab, 0, 0, z0 - 1.5); this.table = cab;\n    this.add(palm(1.3), -5 - n, -.4, z0 - 2); this.add(palm(1.5), 5 + n, -.4, z0 - 1);\n    this.buoys = []; for (let d = 10; d < this.len; d += 10) { this.add(buoy(d % 20 ? '#E8443A' : '#F5F0E0'), -3 - n, -.4, -d); this.add(buoy(d % 20 ? '#F5F0E0' : '#E8443A'), 3 + n, -.4, -d); }\n    this.wobbly = []; if (this.tierIndex >= 1) for (let d = 7; d < this.len - 3; d += 9 - this.tierIndex) this.wobbly.push(d);\n    this.gustT = this.tier.every * .6; this.telegraph = 0; this.gustDir = 1; this.streaks = [];\n    this.sealine = cached('wstreak', () => new THREE.BoxGeometry(1.4, .02, .02)); for (let i = 0; i < 18; i++) { const m = new THREE.Mesh(this.sealine, flat('#1A1420')); m.visible = false; this.add(m); this.streaks.push(m); }\n    this.gary = makeGull(); this.gary.rig.play('fly'); this.gary.group.visible = false; this.add(this.gary.group); this.anim.push(this.gary); this.garyT = 12; this.garyS = null; this.leaderT = null;\n  }\n  placeCamera(snap) { const ls = this.lanes.filter(l => l.bal); if (!ls.length) return; let z = 0, x = 0; for (const l of ls) { z += l.bal.fz; x += l.bal.fx; } z /= ls.length; x /= ls.length; const spread = Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x); const d = this.game.rig.fitDistance(6.2, spread); this.game.rig.set(x, 3.2, z + d, x, 1.1, z - 2.5, snap); }\n  start() {\n    for (const l of this.lanes) {\n      l.baseClip = 'carryTray'; l.doll.rig.play('carryTray', 0); l.steps = 0; l.lastFoot = null; l.lastStepT = -9; l.speed = 0; l.target = 0; l.prog = 0; l.lp = false; l.rp = false; l.glasses = []; l.delivered = false; l.deliv = 0; l.buoyAt = 0; l.rockT = 0; l.offX = 0; l.done = false; l.stumbles = 0; l.finishT = 0; l.sway = .03;\n      if (!l.bal) continue;\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(.3, .02, .3).setTranslation(0, .5, .3).setMass(.04).setFriction(1).setCollisionGroups(G_PROP(l.id)), l.bal.body);\n      const tray = new THREE.Group(); tray.add(box(.6, .04, .6, '#F5F0E0')); tray.position.set(0, 1.25, .3); l.doll.lean.add(tray); l.trayM = tray;\n      l.doll.setFace(Math.PI);\n      this.placeGlasses(l, 5);\n    }\n  }\n  placeGlasses(l, n) {\n    const body = l.bal.body, b = body.translation(), q = new THREE.Quaternion().copy(body.rotation());\n    const spots = [[0, 0], [-.17, -.16], [.17, -.16], [-.17, .16], [.17, .16]];\n    for (let i = 0; i < n; i++) {\n      const v = new THREE.Vector3(spots[i][0], .5 + .02 + .062, .3 + spots[i][1]).applyQuaternion(q);\n      const g = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(b.x + v.x, b.y + v.y, b.z + v.z).setLinearDamping(.1).setAngularDamping(.5).setCanSleep(false));\n      this.world.createCollider(RAPIER.ColliderDesc.cylinder(.06, .05).setMass(.012).setFriction(.9).setRestitution(0).setCollisionGroups(G_PROP(l.id)), g);\n      const m = new THREE.Group(); m.add(cyl(.055, .045, .12, ['#BDF2F2', '#F4A6C0', '#F7E04B', '#B9F26B', '#F5B896'][i % 5], 10)); this.group.add(m); l.glasses.push({ body: g, m, lost: false });\n    }\n  }\n  removeGlass(l, g) { const i = l.glasses.indexOf(g); if (i >= 0) l.glasses.splice(i, 1); this.group.remove(g.m); this.world.removeRigidBody(g.body); }\n  stepFoot(l, foot) {\n    if (l.fallen || l.done) return;\n    if (foot === l.lastFoot) { l.stumbles++; this.gust(l, (this.r() - .5) * 1.2, .5, .18); this.game.audio.sfx('clack', { f: 700 }); this.game.comic('STUMBLE', l.bal.fx, 1.8, l.bal.fz, '#FFF8EE', .55, .6); return; }\n    l.lastFoot = foot; l.steps++; l.lastStepT = this.playT; l.target = .55 / .42;\n    this.gust(l, (foot === 'L' ? -1 : 1) * .2, 0, .18);\n    l.offX += l.bal.leanX * .25 * .55;\n    l.doll.rig.play(foot === 'L' ? 'stepL' : 'stepR', .03, 'carryTray'); this.game.audio.sfx('foot', { high: foot === 'R' });\n    for (const d of this.wobbly) if (Math.abs(l.prog - d) < .4) { this.gust(l, (this.r() - .5) * 1.4, (this.r() - .5) * .9, .25); this.game.audio.sfx('creak', { dur: .4 }); }\n  }\n  fixedPlay(dt) {\n    this.gustT -= dt;\n    if (this.gustT <= 1 && this.telegraph <= 0 && !this.gustFired) { this.gustDir = this.r() < .5 ? -1 : 1; this.telegraph = 1; this.gustFired = true; this.game.audio.sfx('wind', { dur: 1.5 }); if (!this.attract && this.barkT <= 0) this.bark('trudy', 'serviceGust'); }\n    if (this.telegraph > 0) this.telegraph -= dt;\n    if (this.gustT <= 0) { this.gustT = this.tier.every * (.85 + this.r() * .3); this.gustFired = false; for (const l of this.lanes) if (l.bal && !l.done) this.gust(l, this.gustDir * this.tier.gust, 0, .5); }\n    if (this.tier.gary) { this.garyT -= dt; if (this.garyT <= 0 && !this.garyS) { this.garyT = 13; const l = this.lanes.find(q => q.bal && !q.done && q.glasses.length); if (l) { this.garyS = { l, t: 0 }; this.game.audio.sfx('squawk'); } } }\n    let allDone = true;\n    for (const l of this.lanes) {\n      if (!l.bal) continue;\n      const I = l.in; const L = I.lf > .5, R = I.rf > .5; if (L && !l.lp) this.stepFoot(l, 'L'); if (R && !l.rp) this.stepFoot(l, 'R'); l.lp = L; l.rp = R;\n      // Brace zone on the disc.\n      l.brace = this.telegraph > 0 && !l.done ? { x: -this.gustDir * .2 * this.tier.gust * .9, z: 0 } : null;\n      if (this.playT - l.lastStepT > .42 * 1.6) l.target = 0;\n      l.speed += (l.target - l.speed) * (1 - Math.exp(-dt / .5));\n      if (!l.fallen && !l.done) {\n        l.prog += l.speed * dt;\n        const fx = l.x + l.offX, fz = -l.prog; l.bal.moveFoot(fx, 0, fz);\n        if (Math.abs(l.offX) > .8) this.goOverboard(l);\n        for (; l.buoyAt + 10 <= l.prog; l.buoyAt += 10);\n        if (l.prog >= this.len) { l.done = true; l.deliv = l.glasses.length; l.finishT = this.playT; l.target = 0; l.speed = 0; this.game.audio.sfx('bell'); this.game.comic('DELIVERED', fx, 2.2, fz, '#FFD23F', .8); if (l.kind === 'local') this.game.barkNow('trudy', 'serviceDone'); if (this.leaderT == null) this.leaderT = this.playT; }\n      }\n      if (!l.done) allDone = false;\n      const tb = l.bal.body.translation();\n      for (const g of [...l.glasses]) {\n        const p = g.body.translation(); const dy = p.y - tb.y, dx = Math.hypot(p.x - tb.x, p.z - tb.z);\n        if (!g.lost && (dy < -.1 || dx > .95)) { g.lost = true; this.game.audio.sfx('fruit'); if (l.kind === 'local') this.bark('trudy', 'serviceSpill'); this.game.rumble(l, .35, .12); }\n        if (g.lost && (p.y < .1 || dx > 3)) { this.removeGlass(l, g); this.game.particles.burst(p.x, .1, p.z, 6, '#BDF2F2', 1.5, .05, .5, 1); }\n      }\n      this.tally(l);\n    }\n    if (this.garyS) { const s = this.garyS; s.t += dt; if (s.t > 1 && s.l.glasses.length && !s.took) { s.took = true; const g = s.l.glasses.find(q => !q.lost); if (g) { g.lost = true; const p = g.body.translation(); g.body.applyImpulse({ x: .012, y: .02, z: 0 }, true); this.game.comic('MINE', p.x, p.y + .5, p.z, '#FFF8EE', .55, .7); } } if (s.t > 2.4) { this.garyS = null; this.gary.group.visible = false; } }\n    const clock = this.leaderT != null && this.lanes.length > 1 && this.playT - this.leaderT > 15;\n    if (allDone || clock || this.playT > this.timeLimit) { for (const l of this.lanes) if (!l.done) { l.deliv = l.glasses.filter(g => !g.lost).length * (l.prog / this.len > .8 ? 1 : 0); this.tally(l); } this.finish(); }\n  }\n  goOverboard(l) {\n    const p = l.bal.foot.translation(); this.game.audio.sfx('splash', { big: .8 }); this.game.particles.splash(p.x, 0, p.z, 1); this.game.comic('SPLOSH!', p.x, 1.6, p.z, '#BDF2F2'); if (l.kind === 'local') this.game.barkNow('trudy', 'serviceSplash'); l.falls++; if (l.kind === 'local') this.game.addFall();\n    const keep = Math.max(0, l.glasses.filter(g => !g.lost).length - 1);\n    for (const g of [...l.glasses]) this.removeGlass(l, g);\n    l.prog = l.buoyAt; l.offX = 0; l.speed = 0; l.target = 0; l.bal.moveFoot(l.x, 0, -l.prog); l.bal.foot.setTranslation({ x: l.x, y: 0, z: -l.prog }, true); l.bal.fx = l.x; l.bal.fz = -l.prog; l.bal.reset();\n    l.pendingGlass = keep; l.pendT = .05;\n  }\n  postPlay(dt) { for (const l of this.lanes) if (l.pendT > 0) { l.pendT -= dt; if (l.pendT <= 0) { this.placeGlasses(l, l.pendingGlass); } } for (const l of this.lanes) if (l.fallen) { for (const g of l.glasses) g.lost = true; } }\n  tally(l) { const count = l.done ? l.deliv : l.glasses.filter(g => !g.lost).length; const timeBonus = l.done ? Math.max(0, 60 - (l.finishT - this.len * .8)) : 0; l.score = 100 * count + timeBonus; l.form = l.done ? Math.min(100, 100 * l.score / this.tier.par) : Math.min(100, (100 * l.score / this.tier.par) * (l.prog / this.len)); }\n  onFall(l) { if (l.trayM) l.trayM.visible = false; }\n  onRecover(l) { if (l.trayM) l.trayM.visible = true; l.doll.rig.play('carryTray', .1); l.pendingGlass = 0; const keep = Math.max(0, l.glasses.filter(g => !g.lost).length); for (const g of [...l.glasses]) this.removeGlass(l, g); l.pendingGlass = keep; l.pendT = .05; }\n  frameLane(l) {\n    if (!l.bal) return;\n    for (const g of l.glasses) { const p = g.body.translation(), q = g.body.rotation(); g.m.position.set(p.x, p.y, p.z); g.m.quaternion.set(q.x, q.y, q.z, q.w); }\n  }\n  frame2(dt) {\n    const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(l.done ? l.deliv : l.glasses.filter(g => !g.lost).length, 'Glasses'); this.setTime(null); this.setMsg(l.done ? '' : `${Math.max(0, Math.ceil(this.len - l.prog))} m to the cabana`); }\n    const on = this.telegraph > 0 || (this.gustT > this.tier.every - .6); const base = l?.bal ? l.bal.fz : 0;\n    this.streaks.forEach((m, i) => { m.visible = on; if (on) { const sp = (this.t * 9 + i * 1.3) % 11 - 5.5; m.position.set(sp * this.gustDir * -1 + (l?.bal?.fx || 0), .5 + (i % 6) * .4, base - 1 - (i % 5) * 1.5); } });\n    if (this.garyS) { const s = this.garyS, a = s.t / 2.4; this.gary.group.visible = true; const f = s.l.bal; this.gary.group.position.set(f.fx + 6 - a * 12, 1.6 + Math.abs(a - .42) * 8, f.fz + .3); this.gary.group.rotation.y = -Math.PI / 2; }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l);\n    l.stepT = (l.stepT || 0) - dt; l.lfT = (l.lfT || 0) - dt; l.rfT = (l.rfT || 0) - dt;\n    if (l.stepT <= 0 && !l.done) { l.stepT = .42 * (1 + br.gauss() * br.s.cadence * .5); if (l.lastFoot === 'L') l.rfT = .05; else l.lfT = .05; }\n    let gx = -l.offX * .8; const brace = this.telegraph > 0 || this.gustT > this.tier.every - .5 ? -this.gustDir * .2 * this.tier.gust : 0; gx += brace;\n    if (this.opts.botMode === 'nobrace') gx = -l.offX * .8;\n    const [x, z] = br.correct(dt, l, Math.max(-1, Math.min(1, gx)), 0, true);\n    return { x, z, lf: l.lfT > 0 ? 1 : 0, rf: l.rfT > 0 ? 1 : 0 };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.deliv, label: 'Glasses delivered', stats: `${l.steps} steps. Stumbles: ${l.stumbles}. Floor Exercises: ${l.falls}` }; }\n  forceFinish() { for (const l of this.lanes) if (l.bal && !l.done) l.deliv = 0; this.finish(); }\n  forceThing() { this.gustT = 1; }\n}\nE\ncat > src/events/springboard.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { T } from '../core/tuning.js';\nimport { box, at, cyl, sphere, rbox, buoy, palm, bunting, torus } from '../art/props.js';\nimport { makeGull } from '../art/gull.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nconst W = 2 * Math.PI / .9, ZETA = .035, rad = (d) => d * Math.PI / 180;\nexport class Springboard extends EventBase {\n  static id = 'springboard'; static title = 'Springboard'; static discipline = 'Balance Play'; static instructor = 'trudy'; static place = 'The Dive Tower'; static music = 'balance'; static couch = true; static session = true; static diagram = 'dive';\n  static sentence = 'Squeeze both feet as the board goes down. Press Hop to launch. Spin with the stick. Hit the water well.';\n  static can = 'You can win with a clean dive or a perfect belly flop.'; static cant = \"You can't miss the sea. It is very large.\";\n  static verbs = [['feet', 'Pump'], ['hop', 'Launch / Tuck'], ['lean', 'Spin']];\n  static tiers = [{ tower: 5, par: 78 }, { tower: 7, par: 88 }, { tower: 9, par: 96 }];\n  static sessionConfig = { tier: 0, time: 50 };\n  groundY() { return -2.5; }\n  buildSet() {\n    this.noFall = true; this.timeLimit = this.opts.time || 80; this.tower = this.tier.tower; this.faceYaw = Math.PI / 2; this.showDisc = false; this.laneSpacing = 2.2;\n    const h = this.tower, n = this.opts.laneCount || 1, depth = 1.6 + (n - 1) * 2.2;\n    const COL = ['#E8443A', '#F5B700', '#3B82F6', '#22C55E'];\n    let y = 0, i = 0; while (y < h) { const s = Math.min(1.1, h - y); this.add(box(2.2, s, depth + .4, COL[i % 4]), -2.2, y + s / 2, 0); y += s; i++; }\n    this.add(cyl(.3, .4, 3, '#7A5A3C'), -2.2, -1.5, 0);\n    for (let k = 0; k < n; k++) { const b = rbox(2.2, .1, .5, .04, '#F5F0E0'); this.add(b, -.2, h, this.laneX(k, n)); }\n    this.boards = this.group.children.slice(-n);\n    this.add(bunting(-3.2, h + 1.4, -depth / 2, -3.2, h + 1.4, depth / 2, 6)); this.add(at(cyl(.05, .05, 1.5, '#FFF8EE'), -3.2, h + .7, -depth / 2)); this.add(at(cyl(.05, .05, 1.5, '#FFF8EE'), -3.2, h + .7, depth / 2));\n    this.add(buoy(), 8, -.4, -3); this.add(buoy('#F5F0E0'), 12, -.4, 2); this.add(palm(1.5), -7, -.5, -3);\n    this.gary = makeGull(); this.gary.rig.play('fly'); this.add(this.gary.group, 6, h + 3, -1); this.anim.push(this.gary); this.garyDown = false;\n    this.ringG = new THREE.Group(); this.add(this.ringG);\n    this.pool = [];\n  }\n  laneX(i, n) { return 0; }\n  placeCamera(snap) { const l = this.lanes[0]; const h = this.tower; let cx = 3, cy = h * .52, d = 8 + h * 1.1; if (l && l.state === 'air') { const p = l.bal.body.translation(); cy = Math.max(1, (p.y + h * .4) / 1.4); cx = 3.4; } if (this.replay) { const q = this.replay.pos; cx = q.x * .6 + 2; cy = Math.max(1.4, q.y * .7); d = 6.5; } this.game.rig.set(cx, cy + 1, d + (this.lanes.length - 1) * 1.5, cx, cy, 0, snap); }\n  start() { this.lanes.forEach((l, i) => { l.laneZ = this.lanes.length > 1 ? (i - (this.lanes.length - 1) / 2) * 1.8 : 0; l.dives = []; l.diveN = 0; l.state = 'pump'; l.y = 0; l.v = 1.2; l.t0 = 0; l.buf = []; l.best = null; l.best2 = null; l.bestBuf = null; l.baseClip = 'diveReady'; l.customPose = false; if (l.bal) { l.bal.moveFoot(.3, this.tower, l.laneZ); l.bal.foot.setTranslation({ x: .3, y: this.tower, z: l.laneZ }, true); l.bal.fx = .3; l.bal.fy = this.tower; l.bal.fz = l.laneZ; l.bal.reset(); } l.doll.rig.play('diveReady', 0); l.pumpT = 0; l.bobT = 0; l.grace = 0; l.splash = 0; }); }\n  fixedPlay(dt) {\n    let allDone = true;\n    for (const l of this.lanes) {\n      if (!l.bal) continue;\n      if (l.state === 'pump') this.pump(l, dt);\n      else if (l.state === 'air') this.air(l, dt);\n      else if (l.state === 'water') this.water(l, dt);\n      if (l.state !== 'done') allDone = false;\n    }\n    if (allDone && !this.replay) { this.startReplay(); }\n    if (this.replay) { this.replay.t += dt * .25; if (this.replay.t >= this.replay.dur) { this.endReplay(); this.finish(); } else this.playReplay(); }\n    if (this.playT >= this.timeLimit && !this.replay) { this.finish(); }\n  }\n  pump(l, dt) {\n    const I = l.in, pumping = Math.min(I.lf, I.rf) > .5 || (I.dev === 'kbm' && I.lf > .4 && I.rf > .4); const a = -W * W * l.y - 2 * ZETA * W * l.v - (pumping ? T.boardGain : 0);\n    if (pumping && !l.wasPump) { this.game.audio.sfx('pump'); }\n    l.wasPump = pumping; l.v += a * dt; l.y += l.v * dt; l.y = Math.max(-1.3, Math.min(1.3, l.y)); l.pumpT += dt;\n    l.bal.moveFoot(.3, this.tower + l.y, l.laneZ); const b = this.boards?.[l.id]; if (b) { b.position.y = this.tower + l.y; b.rotation.z = l.y * .1; }\n    // Lean stays on-axis during the pump.\n    l.wishX = 0; l.wishZ = 0;\n    if (I.hop || l.pumpT > (this.opts.pumpMax || 9)) this.launch(l, Math.max(3, l.v));\n    if (this.phase === 'play' && l.doll.rig.currentName !== 'diveReady') l.doll.rig.play('diveReady', .1);\n    const d = Math.max(0, Math.min(1, -l.y * 1.1)); l.doll.inner.scale.y = 1 - d * .12;\n  }\n  launch(l, speed) {\n    const b = l.bal; const p = b.body.translation();\n    l.launchV = speed; b.release(); b.body.setTranslation({ x: p.x, y: this.tower + l.y + .75, z: l.laneZ }, true); b.body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true); b.body.setLinvel({ x: 1.1, y: speed, z: 0 }, true); b.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n    b.collider.setEnabled(false);\n    l.state = 'air'; l.maxY = this.tower; l.buf = []; l.angle = 0; l.spin = 0; this.game.audio.sfx('spring'); l.doll.rig.play('splay', .1); l.doll.inner.scale.y = 1; this.game.rumble(l, .4, .1);\n    if (this.boards?.[l.id]) { this.boards[l.id].position.y = this.tower; this.boards[l.id].rotation.z = 0; }\n  }\n  air(l, dt) {\n    const b = l.bal.body; const I = l.in; const tuck = I.hopHeld; const stick = Math.max(-1, Math.min(1, I.x));\n    const target = stick * T.airTorque * (tuck ? 1.8 : 1);\n    l.spin += (target - l.spin) * (1 - Math.exp(-9 * dt)); l.angle += l.spin * dt;\n    // Rotation about z: stick right tips the head toward the sea.\n    const a = l.angle; b.setRotation({ x: 0, y: 0, z: Math.sin(-a / 2), w: Math.cos(-a / 2) }, true); b.setAngvel({ x: 0, y: 0, z: -l.spin }, true);\n    const p = b.translation(); l.maxY = Math.max(l.maxY, p.y - .75);\n    const want = tuck ? 'tuck' : (Math.abs(l.spin) > .3 ? 'pike' : 'splay'); if (l.doll.rig.currentName !== want) l.doll.rig.play(want, .1);\n    l.buf.push({ x: p.x, y: p.y, z: p.z, a }); if (l.buf.length > 240) l.buf.shift();\n    if (p.y <= .55) this.enter(l, a, p);\n  }\n  scoreEntry(l, a) {\n    const deg = ((a * 57.2958 % 360) + 360) % 360; // 0 upright, 90 belly flat, 180 head first, 270 back flat\n    const toUp = Math.min(deg, 360 - deg), toHead = Math.abs(deg - 180), toBelly = Math.abs(deg - 90), height = l.maxY;\n    const h = 1 + (height - 5) / 10; const grace = Math.min(toUp, toHead) <= 12 ? 100 * (1 - Math.min(toUp, toHead) / 12) * h : 0, splash = toBelly <= 20 ? 100 * (1 - toBelly / 20) * h : 0;\n    return { grace, splash, score: Math.max(grace, splash, 8), height, type: splash > grace ? 'splash' : grace > 0 ? 'grace' : 'meh' };\n  }\n  enter(l, a, p) {\n    const s = this.scoreEntry(l, a); l.dives.push(s); l.diveN++;\n    if (s.type === 'splash') { this.game.particles.splash(p.x, 0, p.z, 3); this.game.audio.sfx('splash', { big: 1.6 }); this.game.comic('SPLOSH!', p.x, 2.5, p.z, '#BDF2F2', 1.5); this.game.rig.shake(.25); this.game.hitstop(.08); if (!this.garyDown && l.id === 0) { this.garyDown = true; this.garyF = 1; this.game.audio.sfx('squawk'); } if (l.kind === 'local') this.game.barkNow('trudy', 'springSplash'); }\n    else if (s.type === 'grace') { this.game.particles.splash(p.x, 0, p.z, .25); this.game.audio.sfx('splash', { big: .3 }); this.game.comic('SO CLEAN', p.x, 2, p.z, '#FFF8EE', .8); if (l.kind === 'local') this.game.barkNow('trudy', 'springGrace'); }\n    else { this.game.particles.splash(p.x, 0, p.z, 1); this.game.audio.sfx('splash', { big: .9 }); this.game.comic('TECHNICALLY', p.x, 2, p.z, '#FFF8EE', .8); if (l.kind === 'local') this.game.barkNow('trudy', 'springMeh'); }\n    if (s.score > (l.bestReplayScore || 0)) { l.bestReplayScore = s.score; l.bestBuf = l.buf.slice(); }\n    const v = l.bal.body.linvel();\n    l.bal.setEnabled(false);\n    l.doll.setLean(0, 0); l.doll.lean.quaternion.set(0, 0, Math.sin(-a / 2), Math.cos(-a / 2)); l.doll.group.position.set(p.x - Math.sin(a) * .75, p.y - Math.cos(a) * .75, p.z);\n    l.ragdoll = new Ragdoll(this.world, l.doll, this.group, { x: v.x * .4, y: v.y * .4, z: 0 }, { x: 0, y: .05, z: 0 });\n    l.state = 'water'; l.waterT = 2.2; this.tally(l);\n  }\n  water(l, dt) {\n    l.waterT -= dt;\n    if (l.ragdoll) for (const part of l.ragdoll.parts) { const p = part.body.translation(); if (p.y < -.05) { part.body.applyImpulse({ x: 0, y: (-p.y) * .7 * dt * 9 * part.body.mass(), z: 0 }, true); const w = part.body.linvel(); part.body.setLinvel({ x: w.x * .985, y: w.y * .985, z: w.z * .985 }, true); } }\n    if (l.waterT <= 0) {\n      if (l.ragdoll) { l.ragdoll.remove(); l.ragdoll = null; }\n      if (l.diveN >= 3 || this.playT > this.timeLimit - 9) { l.state = 'done'; l.doll.group.visible = false; return; }\n      const b = l.bal; b.setEnabled(true); b.collider.setEnabled(true); b.moveFoot(.3, this.tower, l.laneZ); b.foot.setTranslation({ x: .3, y: this.tower, z: l.laneZ }, true); b.fx = .3; b.fy = this.tower; b.fz = l.laneZ; b.reattach();\n      l.state = 'pump'; l.y = 0; l.v = 1.2; l.pumpT = 0; l.doll.rig.play('diveReady', .1); this.game.audio.sfx('spring');\n    }\n  }\n  tally(l) { const sorted = l.dives.map(d => d.score).sort((a, b) => b - a); const n = Math.max(2, Math.min(2, sorted.length)); const sum = (sorted[0] || 0) + (sorted[1] || 0); l.score = sum; l.form = Math.min(100, 100 * (sum / n) / this.tier.par); }\n  startReplay() {\n    const l = this.lanes.find(q => q.bestBuf && q.bestBuf.length > 10);\n    if (!l || this.opts.noReplay || this.sessionMode) { this.finish(); return; }\n    const buf = l.bestBuf; this.replay = { l, buf, t: 0, dur: Math.min(1.3, buf.length / 120), pos: { x: 0, y: 5 } }; l.doll.group.visible = true; l.customPose = true; this.setMsg('Slow motion. For science.'); l.doll.rig.play('pike', .1);\n  }\n  playReplay() { const r = this.replay; const f = r.buf[Math.min(r.buf.length - 1, Math.floor((r.t / r.dur) * (r.buf.length - 1)))]; r.pos = f; const q = r.l.doll; q.lean.quaternion.set(0, 0, Math.sin(-f.a / 2), Math.cos(-f.a / 2)); q.group.position.set(f.x - Math.sin(f.a) * .75, f.y - Math.cos(f.a) * .75, f.z); }\n  endReplay() { this.setMsg(''); this.game.audio.sfx('splash', { big: 1.2 }); this.game.particles.splash(this.replay.pos.x, 0, 0, 2.2); this.replay.l.doll.group.visible = false; this.replay = null; }\n  frameLane(l) {\n    if (!l.bal || l.ragdoll || l.customPose) return;\n    if (l.state === 'air') { const p = l.bal.body.translation(), a = l.angle; l.doll.lean.quaternion.set(0, 0, Math.sin(-a / 2), Math.cos(-a / 2)); l.doll.group.position.set(p.x - Math.sin(a) * .75, p.y - Math.cos(a) * .75, p.z); }\n    else if (l.state === 'pump') { l.doll.group.position.set(.3, this.tower + l.y, l.laneZ); }\n  }\n  frame2(dt) {\n    const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(Math.round(l.score || 0), `Dive ${Math.min(3, l.diveN + 1)} of 3`); this.setTime(null); this.setMsg(this.replay ? 'Slow motion. For science.' : l.state === 'pump' ? (l.v < 0 ? 'Squeeze!' : 'Wait...') : ''); }\n    if (this.garyDown) { this.garyF = Math.min(this.garyF, 1); const g = this.gary.group; g.position.y = Math.max(.2, g.position.y - dt * 7); g.rotation.z += dt * 9; if (g.position.y <= .2 && !this.garyS) { this.garyS = true; this.game.particles.splash(g.position.x, 0, g.position.z, .3); } } else { this.gary.group.position.x = 6 + Math.sin(this.t * .6) * 4; this.gary.group.position.z = -1 + Math.cos(this.t * .6) * 2; this.gary.group.rotation.y = this.t * .6 + Math.PI; }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const s = br.s; if (!l.bal) return {};\n    if (l.state === 'pump') {\n      const down = l.v < -.05 && (l.y > -.7), lateS = s.timing * 1.2; const pump = l.v < lateS * 4 && down;\n      const wantT = skill === 'sharp' ? 5.4 : skill === 'average' ? 3.2 : 1.8;\n      const hop = l.pumpT > wantT && l.y > -.2 && l.v > 1 && l.y < .2;\n      return { lf: pump ? 1 : 0, rf: pump ? 1 : 0, hop };\n    }\n    if (l.state === 'air') {\n      if (l.botPlan === undefined || l.planFor !== l.diveN) { l.planFor = l.diveN; l.botPlan = this.opts.botMode === 'grace' ? 180 : 90; l.stopErr = br.gauss() * s.timing * 2.4; }\n      const deg = l.angle * 57.3, stick = l.botPlan === 180 ? 1 : .5, coast = Math.abs(l.spin) * 57.3 * .111 + 3;\n      const stopped = deg + coast + l.spin * 57.3 * l.stopErr >= l.botPlan;\n      return { x: stopped ? 0 : stick };\n    }\n    return {};\n  }\n  laneResult(i) { const l = this.lanes[i]; const bestType = l.dives.reduce((b, d) => (d.score > (b?.score ?? -1) ? d : b), null); return { form: l.form, big: Math.round(l.score), label: 'Best two dives', stats: bestType ? (bestType.type === 'splash' ? 'A perfect belly flop was involved.' : bestType.type === 'grace' ? 'Grace was involved.' : 'Technically a Dive.') : 'No dives. The sea is still waiting.' }; }\n  forceFinish() { for (const l of this.lanes) this.tally(l); this.finish(); }\n  forceThing() { for (const l of this.lanes) if (l.state === 'pump') this.launch(l, 7); }\n}\nE\ncat > src/events/raft.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, makeWorld, G_GROUND, groups, GROUND, G_RAGDOLL } from '../physics/world.js';\nimport { TiltModel } from '../physics/island.js';\nimport { T } from '../core/tuning.js';\nimport { cyl, box, at, torus, buoy, sphere, rock, cone, mesh, toon } from '../art/props.js';\nimport { makeGull } from '../art/gull.js';\nconst rad = (d) => d * Math.PI / 180;\nexport class Raft extends EventBase {\n  static id = 'raft'; static title = 'Tippy Raft'; static discipline = 'Balance Play'; static instructor = 'trudy'; static place = 'A round raft, at sea'; static music = 'balance'; static couch = true; static standing = false; static diagram = 'raft';\n  static sentence = 'Everyone is on one raft, which tilts toward everyone. Shove. Stay on. Last doll standing.';\n  static can = 'You can walk, hop and shove with Flail.'; static cant = \"You can't stand still for long: the raft is getting smaller.\";\n  static verbs = [['walk', 'Walk'], ['flail', 'Shove'], ['hop', 'Hop']];\n  static tiers = [{ shrink: 12, swell: 6 }, { shrink: 10, swell: 5 }, { shrink: 8, swell: 4 }];\n  makeEventWorld() { this.world = makeWorld({ iterations: 6 }); const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, -.5, 0)); this.world.createCollider(RAPIER.ColliderDesc.cylinder(.5, 40).setFriction(.9).setCollisionGroups(G_GROUND), b); }\n  buildSet() {\n    this.moveMode = true; this.flailOk = false;\n    this.raftG = new THREE.Group(); this.add(this.raftG); this.rings = [];\n    for (let r = 6; r >= 2; r--) { const c = cyl(r, r - .1, .24, r % 2 ? '#C89B6A' : '#B58457', 32); c.position.y = -.12 - (6 - r) * .0005; c.userData.r = r; this.raftG.add(c); this.rings.push(c); }\n    const mast = cyl(.09, .1, 2.6, '#7A5A3C'); this.raftG.add(at(mast, 0, 1.3, 0)); const flag = cone(.3, .7, '#E8443A', 3); flag.rotation.z = -1.57; this.raftG.add(at(flag, .36, 2.3, 0));\n    for (let i = 0; i < 12; i++) { const a = i / 12 * 6.283; const barrel = cyl(.3, .3, 1.2, '#7A5A3C', 12); barrel.rotation.x = Math.PI / 2; barrel.rotation.y = -a; this.rings[0].add(at(barrel, Math.cos(a) * 5.75, -.1, Math.sin(a) * 5.75)); }\n    this.add(buoy(), -11, -.4, -6); this.add(buoy('#F5F0E0'), 12, -.4, -2); this.add(rock(2.2), -18, -.4, -18);\n    this.gull = makeGull(); this.gull.rig.play('fly'); this.raftG.add(this.gull.group); this.gull.group.position.set(0, 2.7, 0); this.gull.rig.play('stand'); this.anim.push(this.gull);\n    this.tilt = new TiltModel({ K: 6, C: 3.5, W: 6 * rad(14) / 6 });\n    this.round = 0; this.wins = {}; this.radius = 6; this.shrinkT = this.tier.shrink; this.swellT = this.tier.swell; this.warn = 0; this.roundT = 0; this.between = 0; this.swellDir = 0; this.lanesOut = 0; this.roundLog = []; this.maxRound = 0;\n  }\n  placeCamera(snap) { this.game.rig.set(0, 13, 15, 0, 0, -.2, snap); }\n  laneX(i, n) { const a = i / Math.max(n, 2) * 6.283 + .7; return Math.cos(a) * 3; }\n  start() {\n    for (const l of this.lanes) { l.px = 0; l.pz = 0; l.vx = 0; l.vz = 0; l.out = false; l.shoveCd = 0; l.wins = 0; l.face = 0; l.jump = 0; l.baseClip = 'walk'; l.doll.rig.play('idle', 0); l.customPose = true; l.hopY = 0; l.hopV = 0; l.goalA = this.r() * 6.28; l.sinkT = 0; }\n    this.resetRound();\n  }\n  resetRound() {\n    this.radius = 6; this.shrinkT = this.tier.shrink; this.swellT = this.tier.swell; this.warn = 0; this.roundT = 0; this.between = 0; this.tilt.tx = this.tilt.tz = this.tilt.vx = this.tilt.vz = 0; this.setMsg('');\n    for (const r of this.rings) { r.visible = true; r.position.x = 0; r.position.z = 0; r.userData.drift = 0; }\n    const n = this.lanes.length; this.lanes.forEach((l, i) => {\n      const a = i / n * 6.283 + .7; l.px = Math.cos(a) * 3; l.pz = Math.sin(a) * 3; l.vx = l.vz = 0; l.out = false; l.shoveCd = .5; l.hopY = 0; l.hopV = 0; l.doll.group.visible = true; l.sinkT = 0;\n      if (l.kind !== 'ghost' && !l.body) { const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(l.px, .9, l.pz).lockRotations().setCanSleep(false)); this.world.createCollider(RAPIER.ColliderDesc.capsule(.5, .3).setMass(1).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setCollisionGroups(groups(0x0100 << i, GROUND)), b); l.body = b; }\n      if (l.body) { l.body.setTranslation({ x: l.px, y: .9, z: l.pz }, true); l.body.setLinvel({ x: 0, y: 0, z: 0 }, true); }\n    });\n  }\n  fixedPlay(dt) {\n    if (this.between > 0) { this.between -= dt; if (this.between <= 0) { if (this.round >= 3 || this.lanes.some(l => l.wins >= 2)) { this.tally(); this.finish(); return; } this.resetRound(); } this.stepRaft(dt); return; }\n    this.roundT += dt; this.maxRound = Math.max(this.maxRound, this.roundT);\n    this.shrinkT -= dt; if (this.shrinkT <= 0 && this.radius > 2) { this.shrinkT = this.tier.shrink; this.radius -= 1; const ring = this.rings.find(r => r.userData.r === this.radius + 1); if (ring) ring.userData.drift = 1; this.game.audio.sfx('creak', { dur: .9 }); this.game.comic('CREAK', 0, 2.5, 0, '#FFF8EE', .8, .9); }\n    this.swellT -= dt;\n    if (this.swellT <= 1 && this.warn <= 0 && !this.swellArmed) { this.swellArmed = true; this.warn = 1; this.swellDir = this.r() * 6.283; this.game.audio.sfx('wind', { dur: 1.1 }); this.setMsg('Swell!'); }\n    if (this.warn > 0) this.warn -= dt;\n    if (this.swellT <= 0) { this.swellT = this.tier.swell * (.8 + this.r() * .4); this.swellArmed = false; this.tilt.vx += Math.cos(this.swellDir) * 2.5 * .45; this.tilt.vz += Math.sin(this.swellDir) * 2.5 * .45; this.setMsg(''); this.game.audio.sfx('splash', { big: .4 }); this.game.rig.shake(.1); }\n    if (this.roundT > 80 && this.radius > 1.2) this.radius -= dt * .4; // late rounds always end\n    const alive = this.lanes.filter(l => !l.out);\n    if (alive.length <= 1) this.endRound(alive[0]);\n    this.stepRaft(dt);\n    for (const l of this.lanes) this.stepWalker(l, dt);\n  }\n  stepRaft(dt) {\n    let sx = 0, sz = 0; for (const l of this.lanes) if (!l.out) { sx += l.px; sz += l.pz; }\n    this.tilt.step(dt, sx, sz); this.tilt.applyGravity(this.world, T.gravity); this.tilt.applyGroup(this.raftG);\n  }\n  stepWalker(l, dt) {\n    if (!l.body) return;\n    if (l.out) { l.sinkT += dt; return; }\n    const I = l.in; l.shoveCd = Math.max(0, l.shoveCd - dt);\n    const slopeX = this.tilt.tx * 10, slopeZ = this.tilt.tz * 10;\n    l.vx *= Math.exp(-3 * dt); l.vz *= Math.exp(-3 * dt);\n    const wx = I.x * 3 + l.vx + slopeX, wz = I.z * 3 + l.vz + slopeZ;\n    l.px += wx * dt; l.pz += wz * dt; l.body.setTranslation({ x: l.px, y: .9, z: l.pz }, true); l.body.setLinvel({ x: wx, y: 0, z: wz }, true);\n    if (Math.hypot(I.x, I.z) > .15) l.face = Math.atan2(I.x, I.z);\n    if (I.hop && l.hopY <= 0) { l.hopV = 4; l.doll.rig.play('hop', .05, 'walk'); this.game.audio.sfx('spring'); }\n    if (l.hopY > 0 || l.hopV > 0) { l.hopV -= 12 * dt; l.hopY = Math.max(0, l.hopY + l.hopV * dt); if (l.hopY <= 0) { l.hopV = 0; l.doll.land(); } }\n    if (I.flail && l.shoveCd <= 0) {\n      l.shoveCd = 2; l.doll.rig.play('flail', .05); this.game.after(.35, () => { if (!this.disposed && !l.out) l.doll.rig.play('walk', .15); }); this.game.audio.sfx('shove');\n      for (const o of this.lanes) { if (o === l || o.out) continue; const dx = o.px - l.px, dz = o.pz - l.pz, d = Math.hypot(dx, dz); if (d < 1.3) { const nx = dx / (d || 1), nz = dz / (d || 1); o.vx += nx * 6; o.vz += nz * 6; this.game.comic('SHOVE', o.px, 2, o.pz, '#FFD23F', .6, .6); this.game.rumble(o, .5, .15); } }\n    }\n    const moving = Math.hypot(wx, wz) > .4; const want = moving ? 'walk' : 'idle'; if (l.doll.rig.currentName !== want && l.doll.rig.currentName !== 'flail' && l.doll.rig.currentName !== 'hop') l.doll.rig.play(want, .2);\n    if (Math.hypot(l.px, l.pz) > this.radius + .12 && l.hopY < .5) this.overboard(l);\n  }\n  overboard(l) { l.out = true; l.falls++; if (l.kind === 'local') { this.game.addFall(); this.game.barkNow('trudy', 'raftOut'); } this.game.audio.sfx('splash', { big: .8 }); this.game.particles.splash(l.px, 0, l.pz, 1); this.game.comic('SPLOSH!', l.px, 1.6, l.pz, '#BDF2F2'); this.game.rumble(l, .8, .2); l.doll.rig.play('flop', .05); }\n  endRound(w) {\n    this.round++; this.between = 2.6; if (w) { w.wins++; this.setMsg(`${w.name} stays dry.`); w.doll.rig.play('cheer', .1); this.game.audio.sfx('bell'); if (w.kind === 'local' && !this.attract) this.game.barkNow('trudy', 'raftWin'); } else this.setMsg('Nobody. Everyone is wet.');\n    this.roundLog.push(this.roundT); this.tally();\n  }\n  tally() { for (const l of this.lanes) { l.form = Math.min(100, 40 + 30 * l.wins); l.score = l.wins; } }\n  frameLane(l, dt) {\n    const g = l.doll.group;\n    if (l.out) { g.position.set(l.px * 1.05, -l.sinkT * .9 + .2, l.pz * 1.05); if (l.sinkT > 2) g.visible = false; return; }\n    // Everyone rides the raft's tilt.\n    const up = new THREE.Vector3(l.px, l.hopY, l.pz).applyQuaternion(this.raftG.quaternion); g.position.copy(up); l.doll.setFace(l.face); l.doll.lean.quaternion.copy(this.raftG.quaternion);\n  }\n  frame2(dt) {\n    for (const r of this.rings) if (r.userData.drift) { r.userData.drift += dt; r.position.x += dt * 1.1; r.position.z += dt * .5; r.position.y -= dt * .04; if (r.userData.drift > 6) r.visible = false; else r.scale.setScalar(1); }\n    const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(l.wins, `Round ${Math.min(3, this.round + 1)}`); this.setTime(null); }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l), s = br.s; if (l.out) return {};\n    // Head toward the centre and the high side, with a skill-based lag.\n    const m = Math.hypot(this.tilt.tx, this.tilt.tz) || 1; let gx = -l.px * .28 - this.tilt.tx * 2.4, gz = -l.pz * .28 - this.tilt.tz * 2.4;\n    let near = null, nd = 9; for (const o of this.lanes) { if (o === l || o.out) continue; const d = Math.hypot(o.px - l.px, o.pz - l.pz); if (d < nd) { nd = d; near = o; } }\n    if (near && nd < 3.5 && skill !== 'clumsy') { const k = skill === 'sharp' ? .35 : .22; gx += (near.px - l.px) / nd * k; gz += (near.pz - l.pz) / nd * k; }\n    l.lagG = l.lagG || [0, 0]; const a = 1 - Math.exp(-dt / Math.max(.05, s.lag)); l.lagG[0] += (gx - l.lagG[0]) * a; l.lagG[1] += (gz - l.lagG[1]) * a;\n    let x = l.lagG[0] + s.noise * Math.sin(this.t * 2 + i) * 3, z = l.lagG[1] + s.noise * Math.sin(this.t * 1.7 + i) * 3; const mm = Math.hypot(x, z); if (mm > 1) { x /= mm; z /= mm; }\n    void m;\n    return { x, z, flail: near && nd < 1.25 && l.shoveCd <= 0 && br.r() < .02 * (skill === 'sharp' ? 4 : 2) };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.wins, label: 'Rounds won', stats: `Went overboard ${l.falls} times.` }; }\n  forceFall() { for (const l of this.lanes) if (!l.out) { this.overboard(l); break; } }\n  forceThing() { this.swellT = 1; }\n}\nE\ncat > src/events/islandLoop.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, G_GROUND } from '../physics/world.js';\nimport { makeIslandWorld, TiltModel, restWeight } from '../physics/island.js';\nimport { T } from '../core/tuning.js';\nimport { makeDoll } from '../art/doll.js';\nimport { makeTrudy } from '../art/trudy.js';\nimport { sphere, cone, at, cyl, torus, mesh } from '../art/props.js';\nimport { GUESTS } from '../data/names.js';\nimport { el, txt } from '../ui/ui.js';\nconst rad = (d) => d * Math.PI / 180, R = 19;\nexport class IslandLoop extends EventBase {\n  static id = 'islandLoop'; static title = 'Island Loop'; static discipline = 'Cardio'; static instructor = 'bolster'; static place = 'The ring road'; static music = 'cardio'; static standing = false; static diagram = 'feet';\n  static sentence = 'Alternate your feet to jog two laps behind Kevin. Stay in the pace band and collect shells.';\n  static can = 'You can steer with the stick, and the road goes uphill when the island says so.'; static cant = \"You can't overtake Kevin without being told about it.\";\n  static verbs = [['left', 'Left'], ['right', 'Right'], ['walk', 'Steer']];\n  static tiers = [{ laps: 2, band: .15 }, { laps: 3, band: .12 }, { laps: 4, band: .1 }];\n  makeEventWorld() { this.world = makeIslandWorld(); }\n  buildSet() {\n    this.moveMode = true; this.isl = this.game.island; this.isl.setStage('foreground'); this.isl.group.add(this.group); this.hideGuests = true; this.isl.showGuests(false);\n    const rest = this.game.currentRestTilt?.() ?? 3.6; this.tilt = new TiltModel({ K: 2.2, C: 1.8, W: 2.2 * rad(4) / 22 }); this.tilt.restX = rad(rest) * .8; this.tilt.restZ = rad(rest) * .6; this.tilt.tx = this.tilt.restX; this.tilt.tz = this.tilt.restZ;\n    this.laps = this.tier.laps; this.total = this.laps * 2 * Math.PI * R; this.timeLimit = this.total / 1.6 + 30;\n    this.kevin = makeDoll({ paint: GUESTS[1].paint, hat: GUESTS[1].hat, skin: GUESTS[1].skin, width: 1.08 }); this.kevin.rig.play('jog', 0); this.group.add(this.kevin.group); this.anim.push(this.kevin); this.kevinA = .22;\n    this.trudy = makeTrudy(); this.trudy.group.scale.setScalar(.3); this.anim.push({ tick: (dt) => this.trudy.tick(dt, Math.sin(this.t * 2) * .1) });\n    this.shells = []; const n = 22 * this.laps / 2; for (let i = 0; i < n; i++) { const a = (i + .5) / n * this.laps * 6.283, off = (i % 3 - 1) * 1.1; const m = cone(.14, .22, ['#F4A6C0', '#FFF8EE', '#F5B896'][i % 3], 8); m.position.set(Math.cos(a) * (R + off), .14, Math.sin(a) * (R + off)); this.group.add(m); this.shells.push({ a, m, got: false, off }); }\n    this.askT = 7;\n  }\n  laneX() { return R; }\n  start() {\n    const l = this.lanes[0]; l.a = 0; l.dist = 0; l.lastFoot = null; l.lastStepT = -9; l.cad = 0; l.steps = 0; l.speed = 0; l.inBand = 0; l.ticks = 0; l.shellN = 0; l.px = R; l.pz = 0; l.lp = false; l.rp = false; l.customPose = true; l.face = Math.PI;\n    const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(R, .9, 0).lockRotations().setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.capsule(.5, .3).setMass(1).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setCollisionGroups(G_GROUND), b); l.body = b;\n    l.doll.rig.play('idle', 0); l.doll.group.add(this.trudy.group); this.trudy.group.position.set(.32, 1.35, 0);\n    this.group.add(l.doll.group);\n  }\n  placeCamera(snap) {\n    const l = this.lanes[0]; if (!l || l.px === undefined) return; const q = this.isl.group.quaternion;\n    const tx = -l.pz, tz = l.px, m = Math.hypot(tx, tz) || 1, dirx = tx / m, dirz = tz / m;\n    const p = new THREE.Vector3(l.px - dirx * 8 + l.px / R * 2.5, 4, l.pz - dirz * 8 + l.pz / R * 2.5).applyQuaternion(q), a = new THREE.Vector3(l.px + dirx * 4, 1.4, l.pz + dirz * 4).applyQuaternion(q);\n    this.game.rig.set(p.x, p.y, p.z, a.x, a.y, a.z, snap); this.camYaw = this.game.rig.yaw;\n  }\n  setupHud2() { this.bandEl = el('div', 'hbar'); this.bandEl.style.cssText += 'position:absolute;left:50%;transform:translateX(-50%);bottom:15vh'; this.bandZone = el('div', 'fill'); this.bandMark = el('div', 'mark'); this.bandEl.append(this.bandZone, this.bandMark); this.hudEl.appendChild(this.bandEl); }\n  fixedPlay(dt) {\n    const l = this.lanes[0], I = l.in; const L = I.lf > .5, R0 = I.rf > .5;\n    const step = (foot) => { if (foot === l.lastFoot) { l.speed *= .7; this.game.audio.sfx('clack', { f: 800 }); return; } const gap = this.playT - l.lastStepT; l.lastFoot = foot; l.lastStepT = this.playT; l.steps++; if (gap < 1.2) l.cad += (1 / Math.max(.05, gap) - l.cad) * .5; l.doll.rig.play('jog', .1); this.game.audio.sfx('foot', { high: foot === 'R' }); };\n    if (L && !l.lp) step('L'); if (R0 && !l.rp) step('R'); l.lp = L; l.rp = R0;\n    if (this.playT - l.lastStepT > 1) { l.cad *= Math.exp(-3 * dt); if (l.doll.rig.currentName === 'jog') l.doll.rig.play('idle', .2); }\n    const want = 1.4 * l.cad; l.speed += (want - l.speed) * (1 - Math.exp(-5 * dt));\n    // Direction: along the road, steered by the stick.\n    const r = Math.hypot(l.px, l.pz) || 1; const tx = -l.pz / r, tz = l.px / r, nx = l.px / r, nz = l.pz / r;\n    const steer = (I.x * nx + I.z * nz); const wantR = steer * 2.4; const walk = l.speed; const vx = tx * walk + nx * wantR + this.tilt.tx * 3, vz = tz * walk + nz * wantR + this.tilt.tz * 3;\n    const v = l.body.linvel(); l.body.setLinvel({ x: vx, y: v.y, z: vz }, true);\n    this.tilt.step(dt, l.px, l.pz); this.tilt.applyGravity(this.world, T.gravity); this.tilt.applyGroup(this.isl.group); this.isl.tilt = this.tilt;\n    const p = l.body.translation(); const da = Math.atan2(l.px * p.z - l.pz * p.x, l.px * p.x + l.pz * p.z); l.dist += da * R; l.a += da; l.px = p.x; l.pz = p.z; l.face = Math.atan2(vx, vz);\n    // Pace band\n    const target = 2.5, hw = this.tier.band; l.ticks++; if (l.cad > target * (1 - hw) && l.cad < target * (1 + hw)) l.inBand++;\n    this.kevinA += 3.5 / R * dt; this.kevin.group.position.set(Math.cos(this.kevinA) * R, 0, Math.sin(this.kevinA) * R); this.kevin.setFace(Math.atan2(-Math.sin(this.kevinA), Math.cos(this.kevinA)));\n    for (const s of this.shells) if (!s.got && Math.abs(s.a - l.a) < .08 && Math.hypot(s.m.position.x - p.x, s.m.position.z - p.z) < 1.1) { s.got = true; s.m.visible = false; l.shellN++; this.game.audio.sfx('marble', { r: .6 }); this.game.particles.burst(p.x, 1, p.z, 5, '#F4A6C0', 1.5, .05, .4, 1); }\n    l.form = 100 * (.85 * (l.ticks ? l.inBand / l.ticks : 0) + .15 * l.shellN / this.shells.length) * Math.min(1, l.dist / this.total * 1.02); l.score = l.form;\n    this.askT -= dt; if (this.askT <= 0 && !this.attract) { this.askT = 11; this.game.barkNow('trudy', l.cad > target * 1.2 ? 'loopFast' : l.cad < target * .8 && this.playT > 3 ? 'loopSlow' : 'loopAsk'); }\n    if (l.dist >= this.total || this.playT >= this.timeLimit) this.finish();\n  }\n  frameLane(l) { if (l.px === undefined) return; l.doll.group.position.set(l.px, 0, l.pz); l.doll.setFace(l.face); const a = Math.hypot(this.tilt.tx, this.tilt.tz); l.doll.lean.quaternion.set(0, 0, 0, 1); void a; }\n  frame2() { const l = this.lanes[0]; if (!l || l.px === undefined) return; this.setNum(l.shellN, 'Shells'); this.setTime(null); this.setMsg(`Lap ${Math.min(this.laps, Math.floor(l.dist / (6.283 * R)) + 1)} of ${this.laps}`); if (this.bandEl) { const t = 2.5, hw = this.tier.band, span = 5; this.bandZone.style.left = `${t * (1 - hw) / span * 100}%`; this.bandZone.style.width = `${t * 2 * hw / span * 100}%`; this.bandMark.style.left = `${Math.min(99, l.cad / span * 100)}%`; } }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); l.nextStep = (l.nextStep ?? .1) - dt; l.lfT = (l.lfT || 0) - dt; l.rfT = (l.rfT || 0) - dt;\n    if (l.nextStep <= 0) { l.nextStep = (1 / 2.5) * (1 + br.gauss() * br.s.cadence); if (l.lastFoot === 'L') l.rfT = .05; else l.lfT = .05; }\n    const r = Math.hypot(l.px, l.pz) || 1; const err = R - r, nx = l.px / r, nz = l.pz / r, k = Math.max(-1, Math.min(1, err * .9));\n    // Screen-space: the stick pushes along the road normal. Resist the slope too.\n    return { x: nx * k - this.tilt.tx * .4, z: nz * k - this.tilt.tz * .4, lf: l.lfT > 0 ? 1 : 0, rf: l.rfT > 0 ? 1 : 0 };\n  }\n  onDispose() { if (this.isl) { this.isl.showGuests(true); this.isl.tilt = null; } }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.form), label: 'Form', stats: `In the band ${Math.round(100 * l.inBand / Math.max(1, l.ticks))}%. Shells: ${l.shellN}` }; }\n}\nE\ncat > src/events/grandHold.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, lerp } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { sphere, cyl, box, at, torus, cone, bunting } from '../art/props.js';\nimport { makeHeron } from '../art/heron.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { makeTrudy } from '../art/trudy.js';\nimport { makeGull } from '../art/gull.js';\nconst rad = (d) => d * Math.PI / 180;\nconst PHASES = [{ name: 'A pose, with breath', dur: 20 }, { name: 'Four stones', dur: 20 }, { name: 'The storm', dur: 20 }, { name: 'Step, in the wind', dur: 20 }, { name: 'The last hold', dur: 15 }];\nexport class GrandHold extends EventBase {\n  static id = 'grandHold'; static title = 'The Grand Hold'; static discipline = 'Finale'; static instructor = 'trudy'; static place = 'The lighthouse gallery'; static music = 'level'; static palette = 'golden'; static diagram = 'ring';\n  static sentence = 'Your balance is tied to the island. Everything you lean, it leans. Bring it level.';\n  static can = 'You can fall. The class will catch you with a bedsheet.'; static cant = \"You can't fail this one. It is too late for that.\";\n  static verbs = [['lean', 'Lean'], ['breath', 'Breathe'], ['flail', 'Flail']];\n  static tiers = [{}];\n  worldOpts() { return { iterations: 10 }; }\n  groundY() { return 12; }\n  buildSet() {\n    this.usesBreath = true; this.isl = this.game.island; this.isl.setStage('below');\n    this.add(cyl(2.8, 2.5, .3, '#E9D3AE', 24), 0, 11.85, 0);\n    for (let i = 0; i < 24; i++) { const a = i / 24 * 6.283; this.add(at(cyl(.03, .03, 1, '#1A1420', 6), Math.cos(a) * 2.7, 12.5, Math.sin(a) * 2.7)); }\n    const rail = torus(2.7, .05, '#E8443A'); rail.rotation.x = Math.PI / 2; this.add(rail, 0, 13, 0);\n    const lamp = cyl(.7, .7, 1.8, '#FFF2C2', 16); this.add(lamp, 0, 12.9, -1.5); this.add(cone(1, .9, '#3B82F6', 16), 0, 14.25, -1.5);\n    this.trudy = makeTrudy(); this.add(this.trudy.group, -1.5, 12, .4); this.trudy.group.rotation.y = .6; this.anim.push({ tick: (dt) => this.trudy.tick(dt, this.lanes[0]?.bal ? -this.lanes[0].bal.cobX * .2 : 0) });\n    this.gary = makeGull(); this.gary.group.visible = false; this.add(this.gary.group); this.anim.push(this.gary);\n    this.phaseI = 0; this.pt = 0; this.restarts = 0; this.camA = 0; this.stones = []; this.plate = null; this.tier = {}; this.scoreSum = 0; this.scoreN = 0; this.stormT = 3; this.cue = null; this.lastNotchFrac = 0; this.levelled = false; this.timeLimit = 200; this.cueT = 0;\n    this.ringR = .3; this.flare = 0;\n  }\n  balanceOpts() { return { margin: .8, ankleMax: 6 }; }\n  placeCamera(snap) { this.camA += .0016; const a = Math.sin(this.camA) * 1.0; const d = 7.8; this.game.rig.set(Math.sin(a) * d, 13.8, Math.cos(a) * d, 0, 12.8, 0, snap); this.camYaw = this.game.rig.yaw; for (const l of this.lanes) if (l.doll) l.doll.setFace(a); }\n  start() { for (const l of this.lanes) { l.zone = { x: .3, z: .1, r: .3 }; l.sway = .1; l.tremor = .05; l.baseClip = 'pose_keeper'; l.doll.rig.play('breathe', 0); l.inT = 0; l.lastIn = 0; l.lastT = 0; } this.enterPhase(0, true); if (!this.attract) this.game.barkNow('trudy', 'grandStart'); }\n  enterPhase(i, first) {\n    this.phaseI = i; this.pt = 0; const l = this.lanes[0]; this.setMsg(PHASES[i]?.name || '');\n    this.game.audio.sfx('bell');\n    if (i === 0) { l.zone = { x: .3, z: .1, r: .3 }; l.sway = .1; l.tremor = .05; l.doll.rig.play('pose_keeper', .4); l.baseClip = 'pose_keeper'; }\n    if (i === 1) { l.zone = { x: 0, z: 0, r: .35 }; l.sway = .12; l.doll.rig.play('holdSlab', .3); l.baseClip = 'holdSlab'; this.stoneNext = 1.5; this.stoneN = 0; this.addPlate(l); }\n    if (i === 2) { l.zone = { x: 0, z: 0, r: .4 }; l.sway = .1; this.stormT = 2.5; l.doll.rig.play('breathe', .3); l.baseClip = 'breathe'; this.gary.group.visible = true; this.gary.rig.play('stand'); if (!this.attract) this.game.barkNow('trudy', 'gary'); }\n    if (i === 3) { l.zone = null; l.sway = .1; this.cueT = 1; this.cue = null; l.doll.rig.play('idle', .3); l.baseClip = 'idle'; }\n    if (i === 4) { l.zone = { x: 0, z: 0, r: .3 }; l.sway = .2; this.gary.group.visible = false; l.doll.rig.play('breathe', .3); l.baseClip = 'breathe'; if (!this.attract) this.game.barkNow('stillwater', 'final'); }\n  }\n  addPlate(l) { this.plateCol = this.world.createCollider(RAPIER.ColliderDesc.cuboid(.5, .03, .5).setTranslation(0, .95, 0).setMass(.04).setFriction(1).setCollisionGroups(G_PROP(l.id)), l.bal.body); this.plateM = box(1, .06, 1, '#8F8578'); this.plateM.position.y = 1.7; l.doll.lean.add(this.plateM); }\n  dropStone(l) {\n    const b = l.bal.body.translation(); const q = new THREE.Quaternion().copy(l.bal.body.rotation()); const top = this.stones.length ? this.stones[this.stones.length - 1].body.translation() : null; const hh = .08;\n    const up = new THREE.Vector3(0, .98, 0).applyQuaternion(q); const y = top ? top.y + hh * 2 + .012 : b.y + up.y + hh + .012;\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(top ? top.x : b.x + up.x, y, top ? top.z : b.z + up.z).setRotation(l.bal.body.rotation()).setLinearDamping(.1).setAngularDamping(.6).setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(.2, hh, .2).setMass(.02).setFriction(.95).setRestitution(0).setCollisionGroups(G_PROP(l.id)), body);\n    const m = sphere(.25, '#BDB2A2', 1, .34, .95); this.group.add(m); this.stones.push({ body, m }); this.game.audio.sfx('clack', { f: 500 });\n  }\n  clearStones(thenPlate = false) { for (const s of this.stones) { this.group.remove(s.m); this.world.removeRigidBody(s.body); } this.stones = []; this.plateRemoveNext = thenPlate; }\n  removePlate() { if (this.plateCol) { this.world.removeCollider(this.plateCol, true); this.plateCol = null; } if (this.plateM) { this.plateM.removeFromParent(); this.plateM = null; } }\n  fixedPlay(dt) {\n    const l = this.lanes[0], P = PHASES[this.phaseI]; this.pt += dt;\n    if (this.plateRemoveNext) { this.plateRemoveNext = false; this.removePlate(); }\n    if (this.phaseI === 1 && this.stoneN < 4) { this.stoneNext -= dt; if (this.stoneNext <= 0 && !l.fallen) { this.stoneNext = 4; this.stoneN++; this.dropStone(l); } }\n    if (this.phaseI === 2) { this.stormT -= dt; if (this.stormT <= 1 && !this.warned) { this.warned = true; this.dir = this.r() * 6.283; l.brace = { x: -Math.cos(this.dir) * .6, z: -Math.sin(this.dir) * .6 }; this.game.audio.sfx('wind', { dur: 1.5 }); this.game.rig.shake(.05); } if (this.stormT <= 0) { this.stormT = 5; this.warned = false; if (!l.fallen) this.gust(l, Math.cos(this.dir) * 3, Math.sin(this.dir) * 3, .5); this.game.audio.sfx('splash', { big: .3 }); this.game.after(.6, () => { if (l) l.brace = null; }); } }\n    if (this.phaseI === 3) { this.cueT -= dt; if (this.cueT <= 0) { this.cueT = 3; const d = [[-.55, 0], [.55, 0], [0, -.5], [0, .5]][Math.floor(this.r() * 4)]; this.cue = d; l.zone = { x: d[0], z: d[1], r: .3 }; this.game.audio.sfx('foot', { high: true }); this.game.audio.sfx('tick'); } }\n    if (this.phaseI === 4) { const a = this.pt / P.dur, r = lerp(.3, .08, a); l.zone.r = r; l.sway = lerp(.2, .02, a); l.tremor = lerp(.05, .01, a); this.finalFrac = a; }\n    if (!l.fallen && l.zone) { l.lastT += dt; if (Math.hypot(l.bal.cobX - l.zone.x, l.bal.cobZ - l.zone.z) <= l.zone.r) l.lastIn += dt; }\n    l.form = Math.min(100, 100 * (l.lastIn / Math.max(1, l.lastT)));\n    // The island follows you, and comes up as you hold on.\n    const notch = this.game.preFinalTilt ?? 1.5, rest = this.phaseI >= 4 ? notch * (1 - this.pt / P.dur) : notch;\n    const leanK = (this.phaseI >= 4 ? 1 - this.pt / P.dur : 1) * 2.4;\n    this.isl.setHeld(rad(rest) * .8 + l.bal.leanX * leanK * .35, rad(rest) * .6 + l.bal.leanZ * leanK * .35);\n    this.game.setDetuneDeg(rest);\n    if (this.pt >= P.dur && !l.fallen) {\n      if (this.phaseI === 1) this.clearStones(true);\n      if (this.phaseI === PHASES.length - 1) { this.isl.setHeld(0, 0); this.game.setDetuneDeg(0); this.levelled = true; this.finish(); return; }\n      this.enterPhase(this.phaseI + 1);\n    }\n  }\n  fall(l) { super.fall(l); this.restarts++; this.game.comic('BEDSHEET!', 0, 13.8, 0, '#FFF8EE', 1); }\n  onFall(l) { if (this.phaseI === 1) this.clearStones(true); if (l.kind === 'local') this.game.barkNow('trudy', 'fall'); }\n  onRecover(l) { this.enterPhase(this.phaseI); }\n  frame2() { const l = this.lanes[0]; if (l) { this.setNum(`${this.phaseI + 1}/5`, 'Phase'); this.setTime(PHASES[this.phaseI].dur - this.pt); for (const s of this.stones) { const p = s.body.translation(), q = s.body.rotation(); s.m.position.set(p.x, p.y, p.z); s.m.quaternion.set(q.x, q.y, q.z, q.w); } if (this.gary.group.visible) { this.gary.group.position.set(Math.sin(l.bal?.leanX || 0) * 1.55, 12 + 1.53, Math.sin(l.bal?.leanZ || 0) * 1.55); } } }\n  botInput(i, t, skill, dt) { const l = this.lanes[i], br = this.botBrain(l); const z = l.zone || { x: 0, z: 0 }; let gx = z.x, gz = z.z; if (l.brace) { gx += l.brace.x; gz += l.brace.z; } const load = this.phaseI === 1; const [x, y] = br.correct(dt, l, gx, gz, load); return { x, z: y, breath: (this.t % 8) < 4, flail: (l.bal?.angle || 0) > .56 }; }\n  laneResult(i) { const l = this.lanes[i]; return { form: Math.max(l.form, 40), big: Math.round(l.form), label: 'Form', stats: `Bedsheet catches: ${this.restarts}. Exemplary, I suppose.` }; }\n  onDispose() {}\n  forceFinish() { this.isl.setHeld(0, 0); this.levelled = true; this.finish(); }\n  forceThing() { for (const l of this.lanes) this.gust(l, 3, 0); }\n}\nE\ncat > src/data/events.js <<'E'\nimport { FruitHat } from '../events/fruitHat.js';\nimport { Poses } from '../events/poses.js';\nimport { Cairn } from '../events/cairn.js';\nimport { StillWater } from '../events/stillWater.js';\nimport { LogReps } from '../events/logReps.js';\nimport { Plank } from '../events/plank.js';\nimport { Tug } from '../events/tug.js';\nimport { StepClass } from '../events/stepClass.js';\nimport { Plates } from '../events/plates.js';\nimport { IslandLoop } from '../events/islandLoop.js';\nimport { RoomService } from '../events/roomService.js';\nimport { Springboard } from '../events/springboard.js';\nimport { Raft } from '../events/raft.js';\nimport { GrandHold } from '../events/grandHold.js';\n// The event registry. Removing a line here removes the event: the day table builds from this.\nexport const EVENTS = { poses: Poses, cairn: Cairn, stillWater: StillWater, logReps: LogReps, plank: Plank, tug: Tug, stepClass: StepClass, plates: Plates, islandLoop: IslandLoop, fruitHat: FruitHat, roomService: RoomService, springboard: Springboard, raft: Raft, grandHold: GrandHold };\nexport const FREE_ORDER = ['poses', 'fruitHat', 'logReps', 'stepClass', 'cairn', 'roomService', 'plates', 'plank', 'springboard', 'stillWater', 'islandLoop', 'raft', 'tug', 'grandHold'];\nexport const SESSION_SET = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard'];\n// Island landmark per event: pavilion the player walks to.\nexport const LANDMARK = { poses: 'sunDeck', stillWater: 'lilyPond', cairn: 'quarry', logReps: 'yard', stepClass: 'bandstand', roomService: 'boardwalk', fruitHat: 'pier', plank: 'pier', springboard: 'pier', tug: 'beach', plates: 'circus', islandLoop: 'beach', raft: 'gazebo', grandHold: 'lighthouse' };\nE\npython3 -I - <<'E'\nimport re\ns=open('PROGRESS.md' if False else '../PROGRESS.md').read()\ns+=\"\\n- [x] Written so far: core/, physics/, render/, art/, anim/, input/, audio/, data/, ui/{ui,focus,disc,speech,css}, events/ (all 14 classes), tools/build.mjs\\n- [ ] TODO next: game/ (director, island+hub, checkin, jar, screens, attract, devmode, groupclass, session, ghost, ending), art/island.js, main.js, tools/test.mjs + tests, shots, exit-interview\\n\"\nopen('../PROGRESS.md','w').write(s)\nE\necho ok","description":"Write Room Service, Springboard, Raft, Island Loop, Grand Hold and the registry"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26160,"cache_read_input_tokens":230987,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26160},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"435e4054-5ac4-4ec7-9e2c-b83c1ef218ce","timestamp":"2026-11-05T12:24:51.252Z","request_id":"req_011CgjmXFJgUzLxbqChMs3cU","wire_tool_inputs":{"toolu_01U6ztGdp1h7MVcBJZ42dTLA":{"command":"cat > src/events/roomService.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { box, at, cyl, sphere, cone, plankWalk, buoy, palm, lantern, bunting, bench, flat, mesh, cached } from '../art/props.js';\nimport { makeGull } from '../art/gull.js';\nexport class RoomService extends EventBase {\n  static id = 'roomService'; static title = 'Room Service'; static discipline = 'Balance Play'; static instructor = 'trudy'; static place = 'The Boardwalk'; static music = 'balance'; static couch = true; static diagram = 'tray';\n  static sentence = 'Alternate your feet to walk the tray of glasses to the cabana. Lean early and small when wind comes.';\n  static can = 'You can lean into a gust before it arrives: the disc shows where.'; static cant = \"You can't walk with the same foot twice. That is a stumble.\";\n  static verbs = [['left', 'Left'], ['right', 'Right'], ['lean', 'Lean'], ['flail', 'Flail']];\n  static tiers = [{ length: 30, gust: 1.2, every: 7, gary: false, par: 560 }, { length: 45, gust: 2, every: 6, gary: true, par: 500 }, { length: 60, gust: 2.3, every: 5, gary: true, par: 440 }];\n  balanceOpts() { return { margin: .8, ankleMax: 6, reflex: 5 }; }\n  worldOpts() { return { iterations: 10 }; }\n  buildSet() {\n    this.len = this.tier.length; this.timeLimit = this.len * 3 + 30; const n = this.opts.laneCount || 1;\n    for (let i = 0; i < n; i++) { const w = plankWalk(this.len + 3, 1.6); w.position.set(this.laneX(i, n), 0, 3); this.add(w); for (const s of [-1, 1]) for (let k = 0; k < this.len / 6; k++) this.add(at(cyl(.03, .03, .8, '#E9D3AE', 8), this.laneX(i, n) + s * .82, .4, -k * 6)); }\n    // Far cabana and its table.\n    const z0 = -this.len;\n    const cab = new THREE.Group(); cab.add(at(box(5 + n * 2, .2, 4, '#C89B6A'), 0, -.1, -1)); for (const [x, z] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) cab.add(at(cyl(.08, .1, 2.8, '#FFF8EE'), x * 2, 1.4, z * 1.4 - 1)); cab.add(at(cone(3.8, 1.5, '#2FA7A0', 4), 0, 3.5, -1));\n    cab.add(at(cyl(.5, .5, .06, '#F5F0E0'), 0, .85, -.8)); cab.add(at(cyl(.05, .07, .85, '#7A5A3C'), 0, .42, -.8)); this.add(cab, 0, 0, z0 - 1.5); this.table = cab;\n    this.add(palm(1.3), -5 - n, -.4, z0 - 2); this.add(palm(1.5), 5 + n, -.4, z0 - 1);\n    this.buoys = []; for (let d = 10; d < this.len; d += 10) { this.add(buoy(d % 20 ? '#E8443A' : '#F5F0E0'), -3 - n, -.4, -d); this.add(buoy(d % 20 ? '#F5F0E0' : '#E8443A'), 3 + n, -.4, -d); }\n    this.wobbly = []; if (this.tierIndex >= 1) for (let d = 7; d < this.len - 3; d += 9 - this.tierIndex) this.wobbly.push(d);\n    this.gustT = this.tier.every * .6; this.telegraph = 0; this.gustDir = 1; this.streaks = [];\n    this.sealine = cached('wstreak', () => new THREE.BoxGeometry(1.4, .02, .02)); for (let i = 0; i < 18; i++) { const m = new THREE.Mesh(this.sealine, flat('#1A1420')); m.visible = false; this.add(m); this.streaks.push(m); }\n    this.gary = makeGull(); this.gary.rig.play('fly'); this.gary.group.visible = false; this.add(this.gary.group); this.anim.push(this.gary); this.garyT = 12; this.garyS = null; this.leaderT = null;\n  }\n  placeCamera(snap) { const ls = this.lanes.filter(l => l.bal); if (!ls.length) return; let z = 0, x = 0; for (const l of ls) { z += l.bal.fz; x += l.bal.fx; } z /= ls.length; x /= ls.length; const spread = Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x); const d = this.game.rig.fitDistance(6.2, spread); this.game.rig.set(x, 3.2, z + d, x, 1.1, z - 2.5, snap); }\n  start() {\n    for (const l of this.lanes) {\n      l.baseClip = 'carryTray'; l.doll.rig.play('carryTray', 0); l.steps = 0; l.lastFoot = null; l.lastStepT = -9; l.speed = 0; l.target = 0; l.prog = 0; l.lp = false; l.rp = false; l.glasses = []; l.delivered = false; l.deliv = 0; l.buoyAt = 0; l.rockT = 0; l.offX = 0; l.done = false; l.stumbles = 0; l.finishT = 0; l.sway = .03;\n      if (!l.bal) continue;\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(.3, .02, .3).setTranslation(0, .5, .3).setMass(.04).setFriction(1).setCollisionGroups(G_PROP(l.id)), l.bal.body);\n      const tray = new THREE.Group(); tray.add(box(.6, .04, .6, '#F5F0E0')); tray.position.set(0, 1.25, .3); l.doll.lean.add(tray); l.trayM = tray;\n      l.doll.setFace(Math.PI);\n      this.placeGlasses(l, 5);\n    }\n  }\n  placeGlasses(l, n) {\n    const body = l.bal.body, b = body.translation(), q = new THREE.Quaternion().copy(body.rotation());\n    const spots = [[0, 0], [-.17, -.16], [.17, -.16], [-.17, .16], [.17, .16]];\n    for (let i = 0; i < n; i++) {\n      const v = new THREE.Vector3(spots[i][0], .5 + .02 + .062, .3 + spots[i][1]).applyQuaternion(q);\n      const g = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(b.x + v.x, b.y + v.y, b.z + v.z).setLinearDamping(.1).setAngularDamping(.5).setCanSleep(false));\n      this.world.createCollider(RAPIER.ColliderDesc.cylinder(.06, .05).setMass(.012).setFriction(.9).setRestitution(0).setCollisionGroups(G_PROP(l.id)), g);\n      const m = new THREE.Group(); m.add(cyl(.055, .045, .12, ['#BDF2F2', '#F4A6C0', '#F7E04B', '#B9F26B', '#F5B896'][i % 5], 10)); this.group.add(m); l.glasses.push({ body: g, m, lost: false });\n    }\n  }\n  removeGlass(l, g) { const i = l.glasses.indexOf(g); if (i >= 0) l.glasses.splice(i, 1); this.group.remove(g.m); this.world.removeRigidBody(g.body); }\n  stepFoot(l, foot) {\n    if (l.fallen || l.done) return;\n    if (foot === l.lastFoot) { l.stumbles++; this.gust(l, (this.r() - .5) * 1.2, .5, .18); this.game.audio.sfx('clack', { f: 700 }); this.game.comic('STUMBLE', l.bal.fx, 1.8, l.bal.fz, '#FFF8EE', .55, .6); return; }\n    l.lastFoot = foot; l.steps++; l.lastStepT = this.playT; l.target = .55 / .42;\n    this.gust(l, (foot === 'L' ? -1 : 1) * .2, 0, .18);\n    l.offX += l.bal.leanX * .25 * .55;\n    l.doll.rig.play(foot === 'L' ? 'stepL' : 'stepR', .03, 'carryTray'); this.game.audio.sfx('foot', { high: foot === 'R' });\n    for (const d of this.wobbly) if (Math.abs(l.prog - d) < .4) { this.gust(l, (this.r() - .5) * 1.4, (this.r() - .5) * .9, .25); this.game.audio.sfx('creak', { dur: .4 }); }\n  }\n  fixedPlay(dt) {\n    this.gustT -= dt;\n    if (this.gustT <= 1 && this.telegraph <= 0 && !this.gustFired) { this.gustDir = this.r() < .5 ? -1 : 1; this.telegraph = 1; this.gustFired = true; this.game.audio.sfx('wind', { dur: 1.5 }); if (!this.attract && this.barkT <= 0) this.bark('trudy', 'serviceGust'); }\n    if (this.telegraph > 0) this.telegraph -= dt;\n    if (this.gustT <= 0) { this.gustT = this.tier.every * (.85 + this.r() * .3); this.gustFired = false; for (const l of this.lanes) if (l.bal && !l.done) this.gust(l, this.gustDir * this.tier.gust, 0, .5); }\n    if (this.tier.gary) { this.garyT -= dt; if (this.garyT <= 0 && !this.garyS) { this.garyT = 13; const l = this.lanes.find(q => q.bal && !q.done && q.glasses.length); if (l) { this.garyS = { l, t: 0 }; this.game.audio.sfx('squawk'); } } }\n    let allDone = true;\n    for (const l of this.lanes) {\n      if (!l.bal) continue;\n      const I = l.in; const L = I.lf > .5, R = I.rf > .5; if (L && !l.lp) this.stepFoot(l, 'L'); if (R && !l.rp) this.stepFoot(l, 'R'); l.lp = L; l.rp = R;\n      // Brace zone on the disc.\n      l.brace = this.telegraph > 0 && !l.done ? { x: -this.gustDir * .2 * this.tier.gust * .9, z: 0 } : null;\n      if (this.playT - l.lastStepT > .42 * 1.6) l.target = 0;\n      l.speed += (l.target - l.speed) * (1 - Math.exp(-dt / .5));\n      if (!l.fallen && !l.done) {\n        l.prog += l.speed * dt;\n        const fx = l.x + l.offX, fz = -l.prog; l.bal.moveFoot(fx, 0, fz);\n        if (Math.abs(l.offX) > .8) this.goOverboard(l);\n        for (; l.buoyAt + 10 <= l.prog; l.buoyAt += 10);\n        if (l.prog >= this.len) { l.done = true; l.deliv = l.glasses.length; l.finishT = this.playT; l.target = 0; l.speed = 0; this.game.audio.sfx('bell'); this.game.comic('DELIVERED', fx, 2.2, fz, '#FFD23F', .8); if (l.kind === 'local') this.game.barkNow('trudy', 'serviceDone'); if (this.leaderT == null) this.leaderT = this.playT; }\n      }\n      if (!l.done) allDone = false;\n      const tb = l.bal.body.translation();\n      for (const g of [...l.glasses]) {\n        const p = g.body.translation(); const dy = p.y - tb.y, dx = Math.hypot(p.x - tb.x, p.z - tb.z);\n        if (!g.lost && (dy < -.1 || dx > .95)) { g.lost = true; this.game.audio.sfx('fruit'); if (l.kind === 'local') this.bark('trudy', 'serviceSpill'); this.game.rumble(l, .35, .12); }\n        if (g.lost && (p.y < .1 || dx > 3)) { this.removeGlass(l, g); this.game.particles.burst(p.x, .1, p.z, 6, '#BDF2F2', 1.5, .05, .5, 1); }\n      }\n      this.tally(l);\n    }\n    if (this.garyS) { const s = this.garyS; s.t += dt; if (s.t > 1 && s.l.glasses.length && !s.took) { s.took = true; const g = s.l.glasses.find(q => !q.lost); if (g) { g.lost = true; const p = g.body.translation(); g.body.applyImpulse({ x: .012, y: .02, z: 0 }, true); this.game.comic('MINE', p.x, p.y + .5, p.z, '#FFF8EE', .55, .7); } } if (s.t > 2.4) { this.garyS = null; this.gary.group.visible = false; } }\n    const clock = this.leaderT != null && this.lanes.length > 1 && this.playT - this.leaderT > 15;\n    if (allDone || clock || this.playT > this.timeLimit) { for (const l of this.lanes) if (!l.done) { l.deliv = l.glasses.filter(g => !g.lost).length * (l.prog / this.len > .8 ? 1 : 0); this.tally(l); } this.finish(); }\n  }\n  goOverboard(l) {\n    const p = l.bal.foot.translation(); this.game.audio.sfx('splash', { big: .8 }); this.game.particles.splash(p.x, 0, p.z, 1); this.game.comic('SPLOSH!', p.x, 1.6, p.z, '#BDF2F2'); if (l.kind === 'local') this.game.barkNow('trudy', 'serviceSplash'); l.falls++; if (l.kind === 'local') this.game.addFall();\n    const keep = Math.max(0, l.glasses.filter(g => !g.lost).length - 1);\n    for (const g of [...l.glasses]) this.removeGlass(l, g);\n    l.prog = l.buoyAt; l.offX = 0; l.speed = 0; l.target = 0; l.bal.moveFoot(l.x, 0, -l.prog); l.bal.foot.setTranslation({ x: l.x, y: 0, z: -l.prog }, true); l.bal.fx = l.x; l.bal.fz = -l.prog; l.bal.reset();\n    l.pendingGlass = keep; l.pendT = .05;\n  }\n  postPlay(dt) { for (const l of this.lanes) if (l.pendT > 0) { l.pendT -= dt; if (l.pendT <= 0) { this.placeGlasses(l, l.pendingGlass); } } for (const l of this.lanes) if (l.fallen) { for (const g of l.glasses) g.lost = true; } }\n  tally(l) { const count = l.done ? l.deliv : l.glasses.filter(g => !g.lost).length; const timeBonus = l.done ? Math.max(0, 60 - (l.finishT - this.len * .8)) : 0; l.score = 100 * count + timeBonus; l.form = l.done ? Math.min(100, 100 * l.score / this.tier.par) : Math.min(100, (100 * l.score / this.tier.par) * (l.prog / this.len)); }\n  onFall(l) { if (l.trayM) l.trayM.visible = false; }\n  onRecover(l) { if (l.trayM) l.trayM.visible = true; l.doll.rig.play('carryTray', .1); l.pendingGlass = 0; const keep = Math.max(0, l.glasses.filter(g => !g.lost).length); for (const g of [...l.glasses]) this.removeGlass(l, g); l.pendingGlass = keep; l.pendT = .05; }\n  frameLane(l) {\n    if (!l.bal) return;\n    for (const g of l.glasses) { const p = g.body.translation(), q = g.body.rotation(); g.m.position.set(p.x, p.y, p.z); g.m.quaternion.set(q.x, q.y, q.z, q.w); }\n  }\n  frame2(dt) {\n    const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(l.done ? l.deliv : l.glasses.filter(g => !g.lost).length, 'Glasses'); this.setTime(null); this.setMsg(l.done ? '' : `${Math.max(0, Math.ceil(this.len - l.prog))} m to the cabana`); }\n    const on = this.telegraph > 0 || (this.gustT > this.tier.every - .6); const base = l?.bal ? l.bal.fz : 0;\n    this.streaks.forEach((m, i) => { m.visible = on; if (on) { const sp = (this.t * 9 + i * 1.3) % 11 - 5.5; m.position.set(sp * this.gustDir * -1 + (l?.bal?.fx || 0), .5 + (i % 6) * .4, base - 1 - (i % 5) * 1.5); } });\n    if (this.garyS) { const s = this.garyS, a = s.t / 2.4; this.gary.group.visible = true; const f = s.l.bal; this.gary.group.position.set(f.fx + 6 - a * 12, 1.6 + Math.abs(a - .42) * 8, f.fz + .3); this.gary.group.rotation.y = -Math.PI / 2; }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l);\n    l.stepT = (l.stepT || 0) - dt; l.lfT = (l.lfT || 0) - dt; l.rfT = (l.rfT || 0) - dt;\n    if (l.stepT <= 0 && !l.done) { l.stepT = .42 * (1 + br.gauss() * br.s.cadence * .5); if (l.lastFoot === 'L') l.rfT = .05; else l.lfT = .05; }\n    let gx = -l.offX * .8; const brace = this.telegraph > 0 || this.gustT > this.tier.every - .5 ? -this.gustDir * .2 * this.tier.gust : 0; gx += brace;\n    if (this.opts.botMode === 'nobrace') gx = -l.offX * .8;\n    const [x, z] = br.correct(dt, l, Math.max(-1, Math.min(1, gx)), 0, true);\n    return { x, z, lf: l.lfT > 0 ? 1 : 0, rf: l.rfT > 0 ? 1 : 0 };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.deliv, label: 'Glasses delivered', stats: `${l.steps} steps. Stumbles: ${l.stumbles}. Floor Exercises: ${l.falls}` }; }\n  forceFinish() { for (const l of this.lanes) if (l.bal && !l.done) l.deliv = 0; this.finish(); }\n  forceThing() { this.gustT = 1; }\n}\nE\ncat > src/events/springboard.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { T } from '../core/tuning.js';\nimport { box, at, cyl, sphere, rbox, buoy, palm, bunting, torus } from '../art/props.js';\nimport { makeGull } from '../art/gull.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nconst W = 2 * Math.PI / .9, ZETA = .035, rad = (d) => d * Math.PI / 180;\nexport class Springboard extends EventBase {\n  static id = 'springboard'; static title = 'Springboard'; static discipline = 'Balance Play'; static instructor = 'trudy'; static place = 'The Dive Tower'; static music = 'balance'; static couch = true; static session = true; static diagram = 'dive';\n  static sentence = 'Squeeze both feet as the board goes down. Press Hop to launch. Spin with the stick. Hit the water well.';\n  static can = 'You can win with a clean dive or a perfect belly flop.'; static cant = \"You can't miss the sea. It is very large.\";\n  static verbs = [['feet', 'Pump'], ['hop', 'Launch / Tuck'], ['lean', 'Spin']];\n  static tiers = [{ tower: 5, par: 78 }, { tower: 7, par: 88 }, { tower: 9, par: 96 }];\n  static sessionConfig = { tier: 0, time: 50 };\n  groundY() { return -2.5; }\n  buildSet() {\n    this.noFall = true; this.timeLimit = this.opts.time || 80; this.tower = this.tier.tower; this.faceYaw = Math.PI / 2; this.showDisc = false; this.laneSpacing = 2.2;\n    const h = this.tower, n = this.opts.laneCount || 1, depth = 1.6 + (n - 1) * 2.2;\n    const COL = ['#E8443A', '#F5B700', '#3B82F6', '#22C55E'];\n    let y = 0, i = 0; while (y < h) { const s = Math.min(1.1, h - y); this.add(box(2.2, s, depth + .4, COL[i % 4]), -2.2, y + s / 2, 0); y += s; i++; }\n    this.add(cyl(.3, .4, 3, '#7A5A3C'), -2.2, -1.5, 0);\n    for (let k = 0; k < n; k++) { const b = rbox(2.2, .1, .5, .04, '#F5F0E0'); this.add(b, -.2, h, this.laneX(k, n)); }\n    this.boards = this.group.children.slice(-n);\n    this.add(bunting(-3.2, h + 1.4, -depth / 2, -3.2, h + 1.4, depth / 2, 6)); this.add(at(cyl(.05, .05, 1.5, '#FFF8EE'), -3.2, h + .7, -depth / 2)); this.add(at(cyl(.05, .05, 1.5, '#FFF8EE'), -3.2, h + .7, depth / 2));\n    this.add(buoy(), 8, -.4, -3); this.add(buoy('#F5F0E0'), 12, -.4, 2); this.add(palm(1.5), -7, -.5, -3);\n    this.gary = makeGull(); this.gary.rig.play('fly'); this.add(this.gary.group, 6, h + 3, -1); this.anim.push(this.gary); this.garyDown = false;\n    this.ringG = new THREE.Group(); this.add(this.ringG);\n    this.pool = [];\n  }\n  laneX(i, n) { return 0; }\n  placeCamera(snap) { const l = this.lanes[0]; const h = this.tower; let cx = 3, cy = h * .52, d = 8 + h * 1.1; if (l && l.state === 'air') { const p = l.bal.body.translation(); cy = Math.max(1, (p.y + h * .4) / 1.4); cx = 3.4; } if (this.replay) { const q = this.replay.pos; cx = q.x * .6 + 2; cy = Math.max(1.4, q.y * .7); d = 6.5; } this.game.rig.set(cx, cy + 1, d + (this.lanes.length - 1) * 1.5, cx, cy, 0, snap); }\n  start() { this.lanes.forEach((l, i) => { l.laneZ = this.lanes.length > 1 ? (i - (this.lanes.length - 1) / 2) * 1.8 : 0; l.dives = []; l.diveN = 0; l.state = 'pump'; l.y = 0; l.v = 1.2; l.t0 = 0; l.buf = []; l.best = null; l.best2 = null; l.bestBuf = null; l.baseClip = 'diveReady'; l.customPose = false; if (l.bal) { l.bal.moveFoot(.3, this.tower, l.laneZ); l.bal.foot.setTranslation({ x: .3, y: this.tower, z: l.laneZ }, true); l.bal.fx = .3; l.bal.fy = this.tower; l.bal.fz = l.laneZ; l.bal.reset(); } l.doll.rig.play('diveReady', 0); l.pumpT = 0; l.bobT = 0; l.grace = 0; l.splash = 0; }); }\n  fixedPlay(dt) {\n    let allDone = true;\n    for (const l of this.lanes) {\n      if (!l.bal) continue;\n      if (l.state === 'pump') this.pump(l, dt);\n      else if (l.state === 'air') this.air(l, dt);\n      else if (l.state === 'water') this.water(l, dt);\n      if (l.state !== 'done') allDone = false;\n    }\n    if (allDone && !this.replay) { this.startReplay(); }\n    if (this.replay) { this.replay.t += dt * .25; if (this.replay.t >= this.replay.dur) { this.endReplay(); this.finish(); } else this.playReplay(); }\n    if (this.playT >= this.timeLimit && !this.replay) { this.finish(); }\n  }\n  pump(l, dt) {\n    const I = l.in, pumping = Math.min(I.lf, I.rf) > .5 || (I.dev === 'kbm' && I.lf > .4 && I.rf > .4); const a = -W * W * l.y - 2 * ZETA * W * l.v - (pumping ? T.boardGain : 0);\n    if (pumping && !l.wasPump) { this.game.audio.sfx('pump'); }\n    l.wasPump = pumping; l.v += a * dt; l.y += l.v * dt; l.y = Math.max(-1.3, Math.min(1.3, l.y)); l.pumpT += dt;\n    l.bal.moveFoot(.3, this.tower + l.y, l.laneZ); const b = this.boards?.[l.id]; if (b) { b.position.y = this.tower + l.y; b.rotation.z = l.y * .1; }\n    // Lean stays on-axis during the pump.\n    l.wishX = 0; l.wishZ = 0;\n    if (I.hop || l.pumpT > (this.opts.pumpMax || 9)) this.launch(l, Math.max(3, l.v));\n    if (this.phase === 'play' && l.doll.rig.currentName !== 'diveReady') l.doll.rig.play('diveReady', .1);\n    const d = Math.max(0, Math.min(1, -l.y * 1.1)); l.doll.inner.scale.y = 1 - d * .12;\n  }\n  launch(l, speed) {\n    const b = l.bal; const p = b.body.translation();\n    l.launchV = speed; b.release(); b.body.setTranslation({ x: p.x, y: this.tower + l.y + .75, z: l.laneZ }, true); b.body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true); b.body.setLinvel({ x: 1.1, y: speed, z: 0 }, true); b.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n    b.collider.setEnabled(false);\n    l.state = 'air'; l.maxY = this.tower; l.buf = []; l.angle = 0; l.spin = 0; this.game.audio.sfx('spring'); l.doll.rig.play('splay', .1); l.doll.inner.scale.y = 1; this.game.rumble(l, .4, .1);\n    if (this.boards?.[l.id]) { this.boards[l.id].position.y = this.tower; this.boards[l.id].rotation.z = 0; }\n  }\n  air(l, dt) {\n    const b = l.bal.body; const I = l.in; const tuck = I.hopHeld; const stick = Math.max(-1, Math.min(1, I.x));\n    const target = stick * T.airTorque * (tuck ? 1.8 : 1);\n    l.spin += (target - l.spin) * (1 - Math.exp(-9 * dt)); l.angle += l.spin * dt;\n    // Rotation about z: stick right tips the head toward the sea.\n    const a = l.angle; b.setRotation({ x: 0, y: 0, z: Math.sin(-a / 2), w: Math.cos(-a / 2) }, true); b.setAngvel({ x: 0, y: 0, z: -l.spin }, true);\n    const p = b.translation(); l.maxY = Math.max(l.maxY, p.y - .75);\n    const want = tuck ? 'tuck' : (Math.abs(l.spin) > .3 ? 'pike' : 'splay'); if (l.doll.rig.currentName !== want) l.doll.rig.play(want, .1);\n    l.buf.push({ x: p.x, y: p.y, z: p.z, a }); if (l.buf.length > 240) l.buf.shift();\n    if (p.y <= .55) this.enter(l, a, p);\n  }\n  scoreEntry(l, a) {\n    const deg = ((a * 57.2958 % 360) + 360) % 360; // 0 upright, 90 belly flat, 180 head first, 270 back flat\n    const toUp = Math.min(deg, 360 - deg), toHead = Math.abs(deg - 180), toBelly = Math.abs(deg - 90), height = l.maxY;\n    const h = 1 + (height - 5) / 10; const grace = Math.min(toUp, toHead) <= 12 ? 100 * (1 - Math.min(toUp, toHead) / 12) * h : 0, splash = toBelly <= 20 ? 100 * (1 - toBelly / 20) * h : 0;\n    return { grace, splash, score: Math.max(grace, splash, 8), height, type: splash > grace ? 'splash' : grace > 0 ? 'grace' : 'meh' };\n  }\n  enter(l, a, p) {\n    const s = this.scoreEntry(l, a); l.dives.push(s); l.diveN++;\n    if (s.type === 'splash') { this.game.particles.splash(p.x, 0, p.z, 3); this.game.audio.sfx('splash', { big: 1.6 }); this.game.comic('SPLOSH!', p.x, 2.5, p.z, '#BDF2F2', 1.5); this.game.rig.shake(.25); this.game.hitstop(.08); if (!this.garyDown && l.id === 0) { this.garyDown = true; this.garyF = 1; this.game.audio.sfx('squawk'); } if (l.kind === 'local') this.game.barkNow('trudy', 'springSplash'); }\n    else if (s.type === 'grace') { this.game.particles.splash(p.x, 0, p.z, .25); this.game.audio.sfx('splash', { big: .3 }); this.game.comic('SO CLEAN', p.x, 2, p.z, '#FFF8EE', .8); if (l.kind === 'local') this.game.barkNow('trudy', 'springGrace'); }\n    else { this.game.particles.splash(p.x, 0, p.z, 1); this.game.audio.sfx('splash', { big: .9 }); this.game.comic('TECHNICALLY', p.x, 2, p.z, '#FFF8EE', .8); if (l.kind === 'local') this.game.barkNow('trudy', 'springMeh'); }\n    if (s.score > (l.bestReplayScore || 0)) { l.bestReplayScore = s.score; l.bestBuf = l.buf.slice(); }\n    const v = l.bal.body.linvel();\n    l.bal.setEnabled(false);\n    l.doll.setLean(0, 0); l.doll.lean.quaternion.set(0, 0, Math.sin(-a / 2), Math.cos(-a / 2)); l.doll.group.position.set(p.x - Math.sin(a) * .75, p.y - Math.cos(a) * .75, p.z);\n    l.ragdoll = new Ragdoll(this.world, l.doll, this.group, { x: v.x * .4, y: v.y * .4, z: 0 }, { x: 0, y: .05, z: 0 });\n    l.state = 'water'; l.waterT = 2.2; this.tally(l);\n  }\n  water(l, dt) {\n    l.waterT -= dt;\n    if (l.ragdoll) for (const part of l.ragdoll.parts) { const p = part.body.translation(); if (p.y < -.05) { part.body.applyImpulse({ x: 0, y: (-p.y) * .7 * dt * 9 * part.body.mass(), z: 0 }, true); const w = part.body.linvel(); part.body.setLinvel({ x: w.x * .985, y: w.y * .985, z: w.z * .985 }, true); } }\n    if (l.waterT <= 0) {\n      if (l.ragdoll) { l.ragdoll.remove(); l.ragdoll = null; }\n      if (l.diveN >= 3 || this.playT > this.timeLimit - 9) { l.state = 'done'; l.doll.group.visible = false; return; }\n      const b = l.bal; b.setEnabled(true); b.collider.setEnabled(true); b.moveFoot(.3, this.tower, l.laneZ); b.foot.setTranslation({ x: .3, y: this.tower, z: l.laneZ }, true); b.fx = .3; b.fy = this.tower; b.fz = l.laneZ; b.reattach();\n      l.state = 'pump'; l.y = 0; l.v = 1.2; l.pumpT = 0; l.doll.rig.play('diveReady', .1); this.game.audio.sfx('spring');\n    }\n  }\n  tally(l) { const sorted = l.dives.map(d => d.score).sort((a, b) => b - a); const n = Math.max(2, Math.min(2, sorted.length)); const sum = (sorted[0] || 0) + (sorted[1] || 0); l.score = sum; l.form = Math.min(100, 100 * (sum / n) / this.tier.par); }\n  startReplay() {\n    const l = this.lanes.find(q => q.bestBuf && q.bestBuf.length > 10);\n    if (!l || this.opts.noReplay || this.sessionMode) { this.finish(); return; }\n    const buf = l.bestBuf; this.replay = { l, buf, t: 0, dur: Math.min(1.3, buf.length / 120), pos: { x: 0, y: 5 } }; l.doll.group.visible = true; l.customPose = true; this.setMsg('Slow motion. For science.'); l.doll.rig.play('pike', .1);\n  }\n  playReplay() { const r = this.replay; const f = r.buf[Math.min(r.buf.length - 1, Math.floor((r.t / r.dur) * (r.buf.length - 1)))]; r.pos = f; const q = r.l.doll; q.lean.quaternion.set(0, 0, Math.sin(-f.a / 2), Math.cos(-f.a / 2)); q.group.position.set(f.x - Math.sin(f.a) * .75, f.y - Math.cos(f.a) * .75, f.z); }\n  endReplay() { this.setMsg(''); this.game.audio.sfx('splash', { big: 1.2 }); this.game.particles.splash(this.replay.pos.x, 0, 0, 2.2); this.replay.l.doll.group.visible = false; this.replay = null; }\n  frameLane(l) {\n    if (!l.bal || l.ragdoll || l.customPose) return;\n    if (l.state === 'air') { const p = l.bal.body.translation(), a = l.angle; l.doll.lean.quaternion.set(0, 0, Math.sin(-a / 2), Math.cos(-a / 2)); l.doll.group.position.set(p.x - Math.sin(a) * .75, p.y - Math.cos(a) * .75, p.z); }\n    else if (l.state === 'pump') { l.doll.group.position.set(.3, this.tower + l.y, l.laneZ); }\n  }\n  frame2(dt) {\n    const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(Math.round(l.score || 0), `Dive ${Math.min(3, l.diveN + 1)} of 3`); this.setTime(null); this.setMsg(this.replay ? 'Slow motion. For science.' : l.state === 'pump' ? (l.v < 0 ? 'Squeeze!' : 'Wait...') : ''); }\n    if (this.garyDown) { this.garyF = Math.min(this.garyF, 1); const g = this.gary.group; g.position.y = Math.max(.2, g.position.y - dt * 7); g.rotation.z += dt * 9; if (g.position.y <= .2 && !this.garyS) { this.garyS = true; this.game.particles.splash(g.position.x, 0, g.position.z, .3); } } else { this.gary.group.position.x = 6 + Math.sin(this.t * .6) * 4; this.gary.group.position.z = -1 + Math.cos(this.t * .6) * 2; this.gary.group.rotation.y = this.t * .6 + Math.PI; }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const s = br.s; if (!l.bal) return {};\n    if (l.state === 'pump') {\n      const down = l.v < -.05 && (l.y > -.7), lateS = s.timing * 1.2; const pump = l.v < lateS * 4 && down;\n      const wantT = skill === 'sharp' ? 5.4 : skill === 'average' ? 3.2 : 1.8;\n      const hop = l.pumpT > wantT && l.y > -.2 && l.v > 1 && l.y < .2;\n      return { lf: pump ? 1 : 0, rf: pump ? 1 : 0, hop };\n    }\n    if (l.state === 'air') {\n      if (l.botPlan === undefined || l.planFor !== l.diveN) { l.planFor = l.diveN; l.botPlan = this.opts.botMode === 'grace' ? 180 : 90; l.stopErr = br.gauss() * s.timing * 2.4; }\n      const deg = l.angle * 57.3, stick = l.botPlan === 180 ? 1 : .5, coast = Math.abs(l.spin) * 57.3 * .111 + 3;\n      const stopped = deg + coast + l.spin * 57.3 * l.stopErr >= l.botPlan;\n      return { x: stopped ? 0 : stick };\n    }\n    return {};\n  }\n  laneResult(i) { const l = this.lanes[i]; const bestType = l.dives.reduce((b, d) => (d.score > (b?.score ?? -1) ? d : b), null); return { form: l.form, big: Math.round(l.score), label: 'Best two dives', stats: bestType ? (bestType.type === 'splash' ? 'A perfect belly flop was involved.' : bestType.type === 'grace' ? 'Grace was involved.' : 'Technically a Dive.') : 'No dives. The sea is still waiting.' }; }\n  forceFinish() { for (const l of this.lanes) this.tally(l); this.finish(); }\n  forceThing() { for (const l of this.lanes) if (l.state === 'pump') this.launch(l, 7); }\n}\nE\ncat > src/events/raft.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, makeWorld, G_GROUND, groups, GROUND, G_RAGDOLL } from '../physics/world.js';\nimport { TiltModel } from '../physics/island.js';\nimport { T } from '../core/tuning.js';\nimport { cyl, box, at, torus, buoy, sphere, rock, cone, mesh, toon } from '../art/props.js';\nimport { makeGull } from '../art/gull.js';\nconst rad = (d) => d * Math.PI / 180;\nexport class Raft extends EventBase {\n  static id = 'raft'; static title = 'Tippy Raft'; static discipline = 'Balance Play'; static instructor = 'trudy'; static place = 'A round raft, at sea'; static music = 'balance'; static couch = true; static standing = false; static diagram = 'raft';\n  static sentence = 'Everyone is on one raft, which tilts toward everyone. Shove. Stay on. Last doll standing.';\n  static can = 'You can walk, hop and shove with Flail.'; static cant = \"You can't stand still for long: the raft is getting smaller.\";\n  static verbs = [['walk', 'Walk'], ['flail', 'Shove'], ['hop', 'Hop']];\n  static tiers = [{ shrink: 12, swell: 6 }, { shrink: 10, swell: 5 }, { shrink: 8, swell: 4 }];\n  makeEventWorld() { this.world = makeWorld({ iterations: 6 }); const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, -.5, 0)); this.world.createCollider(RAPIER.ColliderDesc.cylinder(.5, 40).setFriction(.9).setCollisionGroups(G_GROUND), b); }\n  buildSet() {\n    this.moveMode = true; this.flailOk = false;\n    this.raftG = new THREE.Group(); this.add(this.raftG); this.rings = [];\n    for (let r = 6; r >= 2; r--) { const c = cyl(r, r - .1, .24, r % 2 ? '#C89B6A' : '#B58457', 32); c.position.y = -.12 - (6 - r) * .0005; c.userData.r = r; this.raftG.add(c); this.rings.push(c); }\n    const mast = cyl(.09, .1, 2.6, '#7A5A3C'); this.raftG.add(at(mast, 0, 1.3, 0)); const flag = cone(.3, .7, '#E8443A', 3); flag.rotation.z = -1.57; this.raftG.add(at(flag, .36, 2.3, 0));\n    for (let i = 0; i < 12; i++) { const a = i / 12 * 6.283; const barrel = cyl(.3, .3, 1.2, '#7A5A3C', 12); barrel.rotation.x = Math.PI / 2; barrel.rotation.y = -a; this.rings[0].add(at(barrel, Math.cos(a) * 5.75, -.1, Math.sin(a) * 5.75)); }\n    this.add(buoy(), -11, -.4, -6); this.add(buoy('#F5F0E0'), 12, -.4, -2); this.add(rock(2.2), -18, -.4, -18);\n    this.gull = makeGull(); this.gull.rig.play('fly'); this.raftG.add(this.gull.group); this.gull.group.position.set(0, 2.7, 0); this.gull.rig.play('stand'); this.anim.push(this.gull);\n    this.tilt = new TiltModel({ K: 6, C: 3.5, W: 6 * rad(14) / 6 });\n    this.round = 0; this.wins = {}; this.radius = 6; this.shrinkT = this.tier.shrink; this.swellT = this.tier.swell; this.warn = 0; this.roundT = 0; this.between = 0; this.swellDir = 0; this.lanesOut = 0; this.roundLog = []; this.maxRound = 0;\n  }\n  placeCamera(snap) { this.game.rig.set(0, 13, 15, 0, 0, -.2, snap); }\n  laneX(i, n) { const a = i / Math.max(n, 2) * 6.283 + .7; return Math.cos(a) * 3; }\n  start() {\n    for (const l of this.lanes) { l.px = 0; l.pz = 0; l.vx = 0; l.vz = 0; l.out = false; l.shoveCd = 0; l.wins = 0; l.face = 0; l.jump = 0; l.baseClip = 'walk'; l.doll.rig.play('idle', 0); l.customPose = true; l.hopY = 0; l.hopV = 0; l.goalA = this.r() * 6.28; l.sinkT = 0; }\n    this.resetRound();\n  }\n  resetRound() {\n    this.radius = 6; this.shrinkT = this.tier.shrink; this.swellT = this.tier.swell; this.warn = 0; this.roundT = 0; this.between = 0; this.tilt.tx = this.tilt.tz = this.tilt.vx = this.tilt.vz = 0; this.setMsg('');\n    for (const r of this.rings) { r.visible = true; r.position.x = 0; r.position.z = 0; r.userData.drift = 0; }\n    const n = this.lanes.length; this.lanes.forEach((l, i) => {\n      const a = i / n * 6.283 + .7; l.px = Math.cos(a) * 3; l.pz = Math.sin(a) * 3; l.vx = l.vz = 0; l.out = false; l.shoveCd = .5; l.hopY = 0; l.hopV = 0; l.doll.group.visible = true; l.sinkT = 0;\n      if (l.kind !== 'ghost' && !l.body) { const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(l.px, .9, l.pz).lockRotations().setCanSleep(false)); this.world.createCollider(RAPIER.ColliderDesc.capsule(.5, .3).setMass(1).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setCollisionGroups(groups(0x0100 << i, GROUND)), b); l.body = b; }\n      if (l.body) { l.body.setTranslation({ x: l.px, y: .9, z: l.pz }, true); l.body.setLinvel({ x: 0, y: 0, z: 0 }, true); }\n    });\n  }\n  fixedPlay(dt) {\n    if (this.between > 0) { this.between -= dt; if (this.between <= 0) { if (this.round >= 3 || this.lanes.some(l => l.wins >= 2)) { this.tally(); this.finish(); return; } this.resetRound(); } this.stepRaft(dt); return; }\n    this.roundT += dt; this.maxRound = Math.max(this.maxRound, this.roundT);\n    this.shrinkT -= dt; if (this.shrinkT <= 0 && this.radius > 2) { this.shrinkT = this.tier.shrink; this.radius -= 1; const ring = this.rings.find(r => r.userData.r === this.radius + 1); if (ring) ring.userData.drift = 1; this.game.audio.sfx('creak', { dur: .9 }); this.game.comic('CREAK', 0, 2.5, 0, '#FFF8EE', .8, .9); }\n    this.swellT -= dt;\n    if (this.swellT <= 1 && this.warn <= 0 && !this.swellArmed) { this.swellArmed = true; this.warn = 1; this.swellDir = this.r() * 6.283; this.game.audio.sfx('wind', { dur: 1.1 }); this.setMsg('Swell!'); }\n    if (this.warn > 0) this.warn -= dt;\n    if (this.swellT <= 0) { this.swellT = this.tier.swell * (.8 + this.r() * .4); this.swellArmed = false; this.tilt.vx += Math.cos(this.swellDir) * 2.5 * .45; this.tilt.vz += Math.sin(this.swellDir) * 2.5 * .45; this.setMsg(''); this.game.audio.sfx('splash', { big: .4 }); this.game.rig.shake(.1); }\n    if (this.roundT > 80 && this.radius > 1.2) this.radius -= dt * .4; // late rounds always end\n    const alive = this.lanes.filter(l => !l.out);\n    if (alive.length <= 1) this.endRound(alive[0]);\n    this.stepRaft(dt);\n    for (const l of this.lanes) this.stepWalker(l, dt);\n  }\n  stepRaft(dt) {\n    let sx = 0, sz = 0; for (const l of this.lanes) if (!l.out) { sx += l.px; sz += l.pz; }\n    this.tilt.step(dt, sx, sz); this.tilt.applyGravity(this.world, T.gravity); this.tilt.applyGroup(this.raftG);\n  }\n  stepWalker(l, dt) {\n    if (!l.body) return;\n    if (l.out) { l.sinkT += dt; return; }\n    const I = l.in; l.shoveCd = Math.max(0, l.shoveCd - dt);\n    const slopeX = this.tilt.tx * 10, slopeZ = this.tilt.tz * 10;\n    l.vx *= Math.exp(-3 * dt); l.vz *= Math.exp(-3 * dt);\n    const wx = I.x * 3 + l.vx + slopeX, wz = I.z * 3 + l.vz + slopeZ;\n    l.px += wx * dt; l.pz += wz * dt; l.body.setTranslation({ x: l.px, y: .9, z: l.pz }, true); l.body.setLinvel({ x: wx, y: 0, z: wz }, true);\n    if (Math.hypot(I.x, I.z) > .15) l.face = Math.atan2(I.x, I.z);\n    if (I.hop && l.hopY <= 0) { l.hopV = 4; l.doll.rig.play('hop', .05, 'walk'); this.game.audio.sfx('spring'); }\n    if (l.hopY > 0 || l.hopV > 0) { l.hopV -= 12 * dt; l.hopY = Math.max(0, l.hopY + l.hopV * dt); if (l.hopY <= 0) { l.hopV = 0; l.doll.land(); } }\n    if (I.flail && l.shoveCd <= 0) {\n      l.shoveCd = 2; l.doll.rig.play('flail', .05); this.game.after(.35, () => { if (!this.disposed && !l.out) l.doll.rig.play('walk', .15); }); this.game.audio.sfx('shove');\n      for (const o of this.lanes) { if (o === l || o.out) continue; const dx = o.px - l.px, dz = o.pz - l.pz, d = Math.hypot(dx, dz); if (d < 1.3) { const nx = dx / (d || 1), nz = dz / (d || 1); o.vx += nx * 6; o.vz += nz * 6; this.game.comic('SHOVE', o.px, 2, o.pz, '#FFD23F', .6, .6); this.game.rumble(o, .5, .15); } }\n    }\n    const moving = Math.hypot(wx, wz) > .4; const want = moving ? 'walk' : 'idle'; if (l.doll.rig.currentName !== want && l.doll.rig.currentName !== 'flail' && l.doll.rig.currentName !== 'hop') l.doll.rig.play(want, .2);\n    if (Math.hypot(l.px, l.pz) > this.radius + .12 && l.hopY < .5) this.overboard(l);\n  }\n  overboard(l) { l.out = true; l.falls++; if (l.kind === 'local') { this.game.addFall(); this.game.barkNow('trudy', 'raftOut'); } this.game.audio.sfx('splash', { big: .8 }); this.game.particles.splash(l.px, 0, l.pz, 1); this.game.comic('SPLOSH!', l.px, 1.6, l.pz, '#BDF2F2'); this.game.rumble(l, .8, .2); l.doll.rig.play('flop', .05); }\n  endRound(w) {\n    this.round++; this.between = 2.6; if (w) { w.wins++; this.setMsg(`${w.name} stays dry.`); w.doll.rig.play('cheer', .1); this.game.audio.sfx('bell'); if (w.kind === 'local' && !this.attract) this.game.barkNow('trudy', 'raftWin'); } else this.setMsg('Nobody. Everyone is wet.');\n    this.roundLog.push(this.roundT); this.tally();\n  }\n  tally() { for (const l of this.lanes) { l.form = Math.min(100, 40 + 30 * l.wins); l.score = l.wins; } }\n  frameLane(l, dt) {\n    const g = l.doll.group;\n    if (l.out) { g.position.set(l.px * 1.05, -l.sinkT * .9 + .2, l.pz * 1.05); if (l.sinkT > 2) g.visible = false; return; }\n    // Everyone rides the raft's tilt.\n    const up = new THREE.Vector3(l.px, l.hopY, l.pz).applyQuaternion(this.raftG.quaternion); g.position.copy(up); l.doll.setFace(l.face); l.doll.lean.quaternion.copy(this.raftG.quaternion);\n  }\n  frame2(dt) {\n    for (const r of this.rings) if (r.userData.drift) { r.userData.drift += dt; r.position.x += dt * 1.1; r.position.z += dt * .5; r.position.y -= dt * .04; if (r.userData.drift > 6) r.visible = false; else r.scale.setScalar(1); }\n    const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(l.wins, `Round ${Math.min(3, this.round + 1)}`); this.setTime(null); }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l), s = br.s; if (l.out) return {};\n    // Head toward the centre and the high side, with a skill-based lag.\n    const m = Math.hypot(this.tilt.tx, this.tilt.tz) || 1; let gx = -l.px * .28 - this.tilt.tx * 2.4, gz = -l.pz * .28 - this.tilt.tz * 2.4;\n    let near = null, nd = 9; for (const o of this.lanes) { if (o === l || o.out) continue; const d = Math.hypot(o.px - l.px, o.pz - l.pz); if (d < nd) { nd = d; near = o; } }\n    if (near && nd < 3.5 && skill !== 'clumsy') { const k = skill === 'sharp' ? .35 : .22; gx += (near.px - l.px) / nd * k; gz += (near.pz - l.pz) / nd * k; }\n    l.lagG = l.lagG || [0, 0]; const a = 1 - Math.exp(-dt / Math.max(.05, s.lag)); l.lagG[0] += (gx - l.lagG[0]) * a; l.lagG[1] += (gz - l.lagG[1]) * a;\n    let x = l.lagG[0] + s.noise * Math.sin(this.t * 2 + i) * 3, z = l.lagG[1] + s.noise * Math.sin(this.t * 1.7 + i) * 3; const mm = Math.hypot(x, z); if (mm > 1) { x /= mm; z /= mm; }\n    void m;\n    return { x, z, flail: near && nd < 1.25 && l.shoveCd <= 0 && br.r() < .02 * (skill === 'sharp' ? 4 : 2) };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.wins, label: 'Rounds won', stats: `Went overboard ${l.falls} times.` }; }\n  forceFall() { for (const l of this.lanes) if (!l.out) { this.overboard(l); break; } }\n  forceThing() { this.swellT = 1; }\n}\nE\ncat > src/events/islandLoop.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, G_GROUND } from '../physics/world.js';\nimport { makeIslandWorld, TiltModel, restWeight } from '../physics/island.js';\nimport { T } from '../core/tuning.js';\nimport { makeDoll } from '../art/doll.js';\nimport { makeTrudy } from '../art/trudy.js';\nimport { sphere, cone, at, cyl, torus, mesh } from '../art/props.js';\nimport { GUESTS } from '../data/names.js';\nimport { el, txt } from '../ui/ui.js';\nconst rad = (d) => d * Math.PI / 180, R = 19;\nexport class IslandLoop extends EventBase {\n  static id = 'islandLoop'; static title = 'Island Loop'; static discipline = 'Cardio'; static instructor = 'bolster'; static place = 'The ring road'; static music = 'cardio'; static standing = false; static diagram = 'feet';\n  static sentence = 'Alternate your feet to jog two laps behind Kevin. Stay in the pace band and collect shells.';\n  static can = 'You can steer with the stick, and the road goes uphill when the island says so.'; static cant = \"You can't overtake Kevin without being told about it.\";\n  static verbs = [['left', 'Left'], ['right', 'Right'], ['walk', 'Steer']];\n  static tiers = [{ laps: 2, band: .15 }, { laps: 3, band: .12 }, { laps: 4, band: .1 }];\n  makeEventWorld() { this.world = makeIslandWorld(); }\n  buildSet() {\n    this.moveMode = true; this.isl = this.game.island; this.isl.setStage('foreground'); this.isl.group.add(this.group); this.hideGuests = true; this.isl.showGuests(false);\n    const rest = this.game.currentRestTilt?.() ?? 3.6; this.tilt = new TiltModel({ K: 2.2, C: 1.8, W: 2.2 * rad(4) / 22 }); this.tilt.restX = rad(rest) * .8; this.tilt.restZ = rad(rest) * .6; this.tilt.tx = this.tilt.restX; this.tilt.tz = this.tilt.restZ;\n    this.laps = this.tier.laps; this.total = this.laps * 2 * Math.PI * R; this.timeLimit = this.total / 1.6 + 30;\n    this.kevin = makeDoll({ paint: GUESTS[1].paint, hat: GUESTS[1].hat, skin: GUESTS[1].skin, width: 1.08 }); this.kevin.rig.play('jog', 0); this.group.add(this.kevin.group); this.anim.push(this.kevin); this.kevinA = .22;\n    this.trudy = makeTrudy(); this.trudy.group.scale.setScalar(.3); this.anim.push({ tick: (dt) => this.trudy.tick(dt, Math.sin(this.t * 2) * .1) });\n    this.shells = []; const n = 22 * this.laps / 2; for (let i = 0; i < n; i++) { const a = (i + .5) / n * this.laps * 6.283, off = (i % 3 - 1) * 1.1; const m = cone(.14, .22, ['#F4A6C0', '#FFF8EE', '#F5B896'][i % 3], 8); m.position.set(Math.cos(a) * (R + off), .14, Math.sin(a) * (R + off)); this.group.add(m); this.shells.push({ a, m, got: false, off }); }\n    this.askT = 7;\n  }\n  laneX() { return R; }\n  start() {\n    const l = this.lanes[0]; l.a = 0; l.dist = 0; l.lastFoot = null; l.lastStepT = -9; l.cad = 0; l.steps = 0; l.speed = 0; l.inBand = 0; l.ticks = 0; l.shellN = 0; l.px = R; l.pz = 0; l.lp = false; l.rp = false; l.customPose = true; l.face = Math.PI;\n    const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(R, .9, 0).lockRotations().setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.capsule(.5, .3).setMass(1).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setCollisionGroups(G_GROUND), b); l.body = b;\n    l.doll.rig.play('idle', 0); l.doll.group.add(this.trudy.group); this.trudy.group.position.set(.32, 1.35, 0);\n    this.group.add(l.doll.group);\n  }\n  placeCamera(snap) {\n    const l = this.lanes[0]; if (!l || l.px === undefined) return; const q = this.isl.group.quaternion;\n    const tx = -l.pz, tz = l.px, m = Math.hypot(tx, tz) || 1, dirx = tx / m, dirz = tz / m;\n    const p = new THREE.Vector3(l.px - dirx * 8 + l.px / R * 2.5, 4, l.pz - dirz * 8 + l.pz / R * 2.5).applyQuaternion(q), a = new THREE.Vector3(l.px + dirx * 4, 1.4, l.pz + dirz * 4).applyQuaternion(q);\n    this.game.rig.set(p.x, p.y, p.z, a.x, a.y, a.z, snap); this.camYaw = this.game.rig.yaw;\n  }\n  setupHud2() { this.bandEl = el('div', 'hbar'); this.bandEl.style.cssText += 'position:absolute;left:50%;transform:translateX(-50%);bottom:15vh'; this.bandZone = el('div', 'fill'); this.bandMark = el('div', 'mark'); this.bandEl.append(this.bandZone, this.bandMark); this.hudEl.appendChild(this.bandEl); }\n  fixedPlay(dt) {\n    const l = this.lanes[0], I = l.in; const L = I.lf > .5, R0 = I.rf > .5;\n    const step = (foot) => { if (foot === l.lastFoot) { l.speed *= .7; this.game.audio.sfx('clack', { f: 800 }); return; } const gap = this.playT - l.lastStepT; l.lastFoot = foot; l.lastStepT = this.playT; l.steps++; if (gap < 1.2) l.cad += (1 / Math.max(.05, gap) - l.cad) * .5; l.doll.rig.play('jog', .1); this.game.audio.sfx('foot', { high: foot === 'R' }); };\n    if (L && !l.lp) step('L'); if (R0 && !l.rp) step('R'); l.lp = L; l.rp = R0;\n    if (this.playT - l.lastStepT > 1) { l.cad *= Math.exp(-3 * dt); if (l.doll.rig.currentName === 'jog') l.doll.rig.play('idle', .2); }\n    const want = 1.4 * l.cad; l.speed += (want - l.speed) * (1 - Math.exp(-5 * dt));\n    // Direction: along the road, steered by the stick.\n    const r = Math.hypot(l.px, l.pz) || 1; const tx = -l.pz / r, tz = l.px / r, nx = l.px / r, nz = l.pz / r;\n    const steer = (I.x * nx + I.z * nz); const wantR = steer * 2.4; const walk = l.speed; const vx = tx * walk + nx * wantR + this.tilt.tx * 3, vz = tz * walk + nz * wantR + this.tilt.tz * 3;\n    const v = l.body.linvel(); l.body.setLinvel({ x: vx, y: v.y, z: vz }, true);\n    this.tilt.step(dt, l.px, l.pz); this.tilt.applyGravity(this.world, T.gravity); this.tilt.applyGroup(this.isl.group); this.isl.tilt = this.tilt;\n    const p = l.body.translation(); const da = Math.atan2(l.px * p.z - l.pz * p.x, l.px * p.x + l.pz * p.z); l.dist += da * R; l.a += da; l.px = p.x; l.pz = p.z; l.face = Math.atan2(vx, vz);\n    // Pace band\n    const target = 2.5, hw = this.tier.band; l.ticks++; if (l.cad > target * (1 - hw) && l.cad < target * (1 + hw)) l.inBand++;\n    this.kevinA += 3.5 / R * dt; this.kevin.group.position.set(Math.cos(this.kevinA) * R, 0, Math.sin(this.kevinA) * R); this.kevin.setFace(Math.atan2(-Math.sin(this.kevinA), Math.cos(this.kevinA)));\n    for (const s of this.shells) if (!s.got && Math.abs(s.a - l.a) < .08 && Math.hypot(s.m.position.x - p.x, s.m.position.z - p.z) < 1.1) { s.got = true; s.m.visible = false; l.shellN++; this.game.audio.sfx('marble', { r: .6 }); this.game.particles.burst(p.x, 1, p.z, 5, '#F4A6C0', 1.5, .05, .4, 1); }\n    l.form = 100 * (.85 * (l.ticks ? l.inBand / l.ticks : 0) + .15 * l.shellN / this.shells.length) * Math.min(1, l.dist / this.total * 1.02); l.score = l.form;\n    this.askT -= dt; if (this.askT <= 0 && !this.attract) { this.askT = 11; this.game.barkNow('trudy', l.cad > target * 1.2 ? 'loopFast' : l.cad < target * .8 && this.playT > 3 ? 'loopSlow' : 'loopAsk'); }\n    if (l.dist >= this.total || this.playT >= this.timeLimit) this.finish();\n  }\n  frameLane(l) { if (l.px === undefined) return; l.doll.group.position.set(l.px, 0, l.pz); l.doll.setFace(l.face); const a = Math.hypot(this.tilt.tx, this.tilt.tz); l.doll.lean.quaternion.set(0, 0, 0, 1); void a; }\n  frame2() { const l = this.lanes[0]; if (!l || l.px === undefined) return; this.setNum(l.shellN, 'Shells'); this.setTime(null); this.setMsg(`Lap ${Math.min(this.laps, Math.floor(l.dist / (6.283 * R)) + 1)} of ${this.laps}`); if (this.bandEl) { const t = 2.5, hw = this.tier.band, span = 5; this.bandZone.style.left = `${t * (1 - hw) / span * 100}%`; this.bandZone.style.width = `${t * 2 * hw / span * 100}%`; this.bandMark.style.left = `${Math.min(99, l.cad / span * 100)}%`; } }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); l.nextStep = (l.nextStep ?? .1) - dt; l.lfT = (l.lfT || 0) - dt; l.rfT = (l.rfT || 0) - dt;\n    if (l.nextStep <= 0) { l.nextStep = (1 / 2.5) * (1 + br.gauss() * br.s.cadence); if (l.lastFoot === 'L') l.rfT = .05; else l.lfT = .05; }\n    const r = Math.hypot(l.px, l.pz) || 1; const err = R - r, nx = l.px / r, nz = l.pz / r, k = Math.max(-1, Math.min(1, err * .9));\n    // Screen-space: the stick pushes along the road normal. Resist the slope too.\n    return { x: nx * k - this.tilt.tx * .4, z: nz * k - this.tilt.tz * .4, lf: l.lfT > 0 ? 1 : 0, rf: l.rfT > 0 ? 1 : 0 };\n  }\n  onDispose() { if (this.isl) { this.isl.showGuests(true); this.isl.tilt = null; } }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.form), label: 'Form', stats: `In the band ${Math.round(100 * l.inBand / Math.max(1, l.ticks))}%. Shells: ${l.shellN}` }; }\n}\nE\ncat > src/events/grandHold.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, lerp } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { sphere, cyl, box, at, torus, cone, bunting } from '../art/props.js';\nimport { makeHeron } from '../art/heron.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { makeTrudy } from '../art/trudy.js';\nimport { makeGull } from '../art/gull.js';\nconst rad = (d) => d * Math.PI / 180;\nconst PHASES = [{ name: 'A pose, with breath', dur: 20 }, { name: 'Four stones', dur: 20 }, { name: 'The storm', dur: 20 }, { name: 'Step, in the wind', dur: 20 }, { name: 'The last hold', dur: 15 }];\nexport class GrandHold extends EventBase {\n  static id = 'grandHold'; static title = 'The Grand Hold'; static discipline = 'Finale'; static instructor = 'trudy'; static place = 'The lighthouse gallery'; static music = 'level'; static palette = 'golden'; static diagram = 'ring';\n  static sentence = 'Your balance is tied to the island. Everything you lean, it leans. Bring it level.';\n  static can = 'You can fall. The class will catch you with a bedsheet.'; static cant = \"You can't fail this one. It is too late for that.\";\n  static verbs = [['lean', 'Lean'], ['breath', 'Breathe'], ['flail', 'Flail']];\n  static tiers = [{}];\n  worldOpts() { return { iterations: 10 }; }\n  groundY() { return 12; }\n  buildSet() {\n    this.usesBreath = true; this.isl = this.game.island; this.isl.setStage('below');\n    this.add(cyl(2.8, 2.5, .3, '#E9D3AE', 24), 0, 11.85, 0);\n    for (let i = 0; i < 24; i++) { const a = i / 24 * 6.283; this.add(at(cyl(.03, .03, 1, '#1A1420', 6), Math.cos(a) * 2.7, 12.5, Math.sin(a) * 2.7)); }\n    const rail = torus(2.7, .05, '#E8443A'); rail.rotation.x = Math.PI / 2; this.add(rail, 0, 13, 0);\n    const lamp = cyl(.7, .7, 1.8, '#FFF2C2', 16); this.add(lamp, 0, 12.9, -1.5); this.add(cone(1, .9, '#3B82F6', 16), 0, 14.25, -1.5);\n    this.trudy = makeTrudy(); this.add(this.trudy.group, -1.5, 12, .4); this.trudy.group.rotation.y = .6; this.anim.push({ tick: (dt) => this.trudy.tick(dt, this.lanes[0]?.bal ? -this.lanes[0].bal.cobX * .2 : 0) });\n    this.gary = makeGull(); this.gary.group.visible = false; this.add(this.gary.group); this.anim.push(this.gary);\n    this.phaseI = 0; this.pt = 0; this.restarts = 0; this.camA = 0; this.stones = []; this.plate = null; this.tier = {}; this.scoreSum = 0; this.scoreN = 0; this.stormT = 3; this.cue = null; this.lastNotchFrac = 0; this.levelled = false; this.timeLimit = 200; this.cueT = 0;\n    this.ringR = .3; this.flare = 0;\n  }\n  balanceOpts() { return { margin: .8, ankleMax: 6 }; }\n  placeCamera(snap) { this.camA += .0016; const a = Math.sin(this.camA) * 1.0; const d = 7.8; this.game.rig.set(Math.sin(a) * d, 13.8, Math.cos(a) * d, 0, 12.8, 0, snap); this.camYaw = this.game.rig.yaw; for (const l of this.lanes) if (l.doll) l.doll.setFace(a); }\n  start() { for (const l of this.lanes) { l.zone = { x: .3, z: .1, r: .3 }; l.sway = .1; l.tremor = .05; l.baseClip = 'pose_keeper'; l.doll.rig.play('breathe', 0); l.inT = 0; l.lastIn = 0; l.lastT = 0; } this.enterPhase(0, true); if (!this.attract) this.game.barkNow('trudy', 'grandStart'); }\n  enterPhase(i, first) {\n    this.phaseI = i; this.pt = 0; const l = this.lanes[0]; this.setMsg(PHASES[i]?.name || '');\n    this.game.audio.sfx('bell');\n    if (i === 0) { l.zone = { x: .3, z: .1, r: .3 }; l.sway = .1; l.tremor = .05; l.doll.rig.play('pose_keeper', .4); l.baseClip = 'pose_keeper'; }\n    if (i === 1) { l.zone = { x: 0, z: 0, r: .35 }; l.sway = .12; l.doll.rig.play('holdSlab', .3); l.baseClip = 'holdSlab'; this.stoneNext = 1.5; this.stoneN = 0; this.addPlate(l); }\n    if (i === 2) { l.zone = { x: 0, z: 0, r: .4 }; l.sway = .1; this.stormT = 2.5; l.doll.rig.play('breathe', .3); l.baseClip = 'breathe'; this.gary.group.visible = true; this.gary.rig.play('stand'); if (!this.attract) this.game.barkNow('trudy', 'gary'); }\n    if (i === 3) { l.zone = null; l.sway = .1; this.cueT = 1; this.cue = null; l.doll.rig.play('idle', .3); l.baseClip = 'idle'; }\n    if (i === 4) { l.zone = { x: 0, z: 0, r: .3 }; l.sway = .2; this.gary.group.visible = false; l.doll.rig.play('breathe', .3); l.baseClip = 'breathe'; if (!this.attract) this.game.barkNow('stillwater', 'final'); }\n  }\n  addPlate(l) { this.plateCol = this.world.createCollider(RAPIER.ColliderDesc.cuboid(.5, .03, .5).setTranslation(0, .95, 0).setMass(.04).setFriction(1).setCollisionGroups(G_PROP(l.id)), l.bal.body); this.plateM = box(1, .06, 1, '#8F8578'); this.plateM.position.y = 1.7; l.doll.lean.add(this.plateM); }\n  dropStone(l) {\n    const b = l.bal.body.translation(); const q = new THREE.Quaternion().copy(l.bal.body.rotation()); const top = this.stones.length ? this.stones[this.stones.length - 1].body.translation() : null; const hh = .08;\n    const up = new THREE.Vector3(0, .98, 0).applyQuaternion(q); const y = top ? top.y + hh * 2 + .012 : b.y + up.y + hh + .012;\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(top ? top.x : b.x + up.x, y, top ? top.z : b.z + up.z).setRotation(l.bal.body.rotation()).setLinearDamping(.1).setAngularDamping(.6).setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(.2, hh, .2).setMass(.02).setFriction(.95).setRestitution(0).setCollisionGroups(G_PROP(l.id)), body);\n    const m = sphere(.25, '#BDB2A2', 1, .34, .95); this.group.add(m); this.stones.push({ body, m }); this.game.audio.sfx('clack', { f: 500 });\n  }\n  clearStones(thenPlate = false) { for (const s of this.stones) { this.group.remove(s.m); this.world.removeRigidBody(s.body); } this.stones = []; this.plateRemoveNext = thenPlate; }\n  removePlate() { if (this.plateCol) { this.world.removeCollider(this.plateCol, true); this.plateCol = null; } if (this.plateM) { this.plateM.removeFromParent(); this.plateM = null; } }\n  fixedPlay(dt) {\n    const l = this.lanes[0], P = PHASES[this.phaseI]; this.pt += dt;\n    if (this.plateRemoveNext) { this.plateRemoveNext = false; this.removePlate(); }\n    if (this.phaseI === 1 && this.stoneN < 4) { this.stoneNext -= dt; if (this.stoneNext <= 0 && !l.fallen) { this.stoneNext = 4; this.stoneN++; this.dropStone(l); } }\n    if (this.phaseI === 2) { this.stormT -= dt; if (this.stormT <= 1 && !this.warned) { this.warned = true; this.dir = this.r() * 6.283; l.brace = { x: -Math.cos(this.dir) * .6, z: -Math.sin(this.dir) * .6 }; this.game.audio.sfx('wind', { dur: 1.5 }); this.game.rig.shake(.05); } if (this.stormT <= 0) { this.stormT = 5; this.warned = false; if (!l.fallen) this.gust(l, Math.cos(this.dir) * 3, Math.sin(this.dir) * 3, .5); this.game.audio.sfx('splash', { big: .3 }); this.game.after(.6, () => { if (l) l.brace = null; }); } }\n    if (this.phaseI === 3) { this.cueT -= dt; if (this.cueT <= 0) { this.cueT = 3; const d = [[-.55, 0], [.55, 0], [0, -.5], [0, .5]][Math.floor(this.r() * 4)]; this.cue = d; l.zone = { x: d[0], z: d[1], r: .3 }; this.game.audio.sfx('foot', { high: true }); this.game.audio.sfx('tick'); } }\n    if (this.phaseI === 4) { const a = this.pt / P.dur, r = lerp(.3, .08, a); l.zone.r = r; l.sway = lerp(.2, .02, a); l.tremor = lerp(.05, .01, a); this.finalFrac = a; }\n    if (!l.fallen && l.zone) { l.lastT += dt; if (Math.hypot(l.bal.cobX - l.zone.x, l.bal.cobZ - l.zone.z) <= l.zone.r) l.lastIn += dt; }\n    l.form = Math.min(100, 100 * (l.lastIn / Math.max(1, l.lastT)));\n    // The island follows you, and comes up as you hold on.\n    const notch = this.game.preFinalTilt ?? 1.5, rest = this.phaseI >= 4 ? notch * (1 - this.pt / P.dur) : notch;\n    const leanK = (this.phaseI >= 4 ? 1 - this.pt / P.dur : 1) * 2.4;\n    this.isl.setHeld(rad(rest) * .8 + l.bal.leanX * leanK * .35, rad(rest) * .6 + l.bal.leanZ * leanK * .35);\n    this.game.setDetuneDeg(rest);\n    if (this.pt >= P.dur && !l.fallen) {\n      if (this.phaseI === 1) this.clearStones(true);\n      if (this.phaseI === PHASES.length - 1) { this.isl.setHeld(0, 0); this.game.setDetuneDeg(0); this.levelled = true; this.finish(); return; }\n      this.enterPhase(this.phaseI + 1);\n    }\n  }\n  fall(l) { super.fall(l); this.restarts++; this.game.comic('BEDSHEET!', 0, 13.8, 0, '#FFF8EE', 1); }\n  onFall(l) { if (this.phaseI === 1) this.clearStones(true); if (l.kind === 'local') this.game.barkNow('trudy', 'fall'); }\n  onRecover(l) { this.enterPhase(this.phaseI); }\n  frame2() { const l = this.lanes[0]; if (l) { this.setNum(`${this.phaseI + 1}/5`, 'Phase'); this.setTime(PHASES[this.phaseI].dur - this.pt); for (const s of this.stones) { const p = s.body.translation(), q = s.body.rotation(); s.m.position.set(p.x, p.y, p.z); s.m.quaternion.set(q.x, q.y, q.z, q.w); } if (this.gary.group.visible) { this.gary.group.position.set(Math.sin(l.bal?.leanX || 0) * 1.55, 12 + 1.53, Math.sin(l.bal?.leanZ || 0) * 1.55); } } }\n  botInput(i, t, skill, dt) { const l = this.lanes[i], br = this.botBrain(l); const z = l.zone || { x: 0, z: 0 }; let gx = z.x, gz = z.z; if (l.brace) { gx += l.brace.x; gz += l.brace.z; } const load = this.phaseI === 1; const [x, y] = br.correct(dt, l, gx, gz, load); return { x, z: y, breath: (this.t % 8) < 4, flail: (l.bal?.angle || 0) > .56 }; }\n  laneResult(i) { const l = this.lanes[i]; return { form: Math.max(l.form, 40), big: Math.round(l.form), label: 'Form', stats: `Bedsheet catches: ${this.restarts}. Exemplary, I suppose.` }; }\n  onDispose() {}\n  forceFinish() { this.isl.setHeld(0, 0); this.levelled = true; this.finish(); }\n  forceThing() { for (const l of this.lanes) this.gust(l, 3, 0); }\n}\nE\ncat > src/data/events.js <<'E'\nimport { FruitHat } from '../events/fruitHat.js';\nimport { Poses } from '../events/poses.js';\nimport { Cairn } from '../events/cairn.js';\nimport { StillWater } from '../events/stillWater.js';\nimport { LogReps } from '../events/logReps.js';\nimport { Plank } from '../events/plank.js';\nimport { Tug } from '../events/tug.js';\nimport { StepClass } from '../events/stepClass.js';\nimport { Plates } from '../events/plates.js';\nimport { IslandLoop } from '../events/islandLoop.js';\nimport { RoomService } from '../events/roomService.js';\nimport { Springboard } from '../events/springboard.js';\nimport { Raft } from '../events/raft.js';\nimport { GrandHold } from '../events/grandHold.js';\n// The event registry. Removing a line here removes the event: the day table builds from this.\nexport const EVENTS = { poses: Poses, cairn: Cairn, stillWater: StillWater, logReps: LogReps, plank: Plank, tug: Tug, stepClass: StepClass, plates: Plates, islandLoop: IslandLoop, fruitHat: FruitHat, roomService: RoomService, springboard: Springboard, raft: Raft, grandHold: GrandHold };\nexport const FREE_ORDER = ['poses', 'fruitHat', 'logReps', 'stepClass', 'cairn', 'roomService', 'plates', 'plank', 'springboard', 'stillWater', 'islandLoop', 'raft', 'tug', 'grandHold'];\nexport const SESSION_SET = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard'];\n// Island landmark per event: pavilion the player walks to.\nexport const LANDMARK = { poses: 'sunDeck', stillWater: 'lilyPond', cairn: 'quarry', logReps: 'yard', stepClass: 'bandstand', roomService: 'boardwalk', fruitHat: 'pier', plank: 'pier', springboard: 'pier', tug: 'beach', plates: 'circus', islandLoop: 'beach', raft: 'gazebo', grandHold: 'lighthouse' };\nE\npython3 -I - <<'E'\nimport re\ns=open('PROGRESS.md' if False else '../PROGRESS.md').read()\ns+=\"\\n- [x] Written so far: core/, physics/, render/, art/, anim/, input/, audio/, data/, ui/{ui,focus,disc,speech,css}, events/ (all 14 classes), tools/build.mjs\\n- [ ] TODO next: game/ (director, island+hub, checkin, jar, screens, attract, devmode, groupclass, session, ghost, ending), art/island.js, main.js, tools/test.mjs + tests, shots, exit-interview\\n\"\nopen('../PROGRESS.md','w').write(s)\nE\necho ok","description":"Write Room Service, Springboard, Raft, Island Loop, Grand Hold and the registry"}}}
