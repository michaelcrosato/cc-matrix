u shows');\n\"\"\"\nassert marker in s; s=s.replace(marker,add+marker); open('test/coverage.mjs','w').write(s)\ns=open('../exit-interview.json').read(); a=\"29 real issues, logged\"; assert a in s; open('../exit-interview.json','w').write(s.replace(a,\"30 real issues, logged\"))\nE\nnode tools/build.mjs | tail -1; node tools/shots.mjs prep results dev raft stepClass springboard journal 2>&1 | grep -vE ' webgpu alive ' | cut -c1-200 | head -4; cd notes/shots; magick montage results.png dev.png raft.png stepClass.png springboard.png journal.png -tile 3x2 -geometry 640x360+2+2 art6.png 2>/dev/null; cd ../..","description":"Apply the art-pass fixes and re-render those scenes","timeout":300000}}}
