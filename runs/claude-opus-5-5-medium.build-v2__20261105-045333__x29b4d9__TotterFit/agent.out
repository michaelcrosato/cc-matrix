{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjkuEttHfy7yAtrXDuxU","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14846,"cache_read_input_tokens":181959,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14846},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"2c316e06-5454-463c-bb04-814d96fa42ec","timestamp":"2026-11-05T12:10:42.299Z","request_id":"req_011CgjkuEP87hBvBocVBWycW","thinking_duration_ms":9113,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjkuEttHfy7yAtrXDuxU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NkgVLei9792PFerTrqhVjG","name":"Bash","input":{"command":"cat > audio/instruments.js <<'E'\n// Every instrument takes ctx, so the same code runs on AudioContext and OfflineAudioContext.\nexport const mtof = (m) => 440 * Math.pow(2, (m - 69) / 12);\nfunction env(ctx, g, t, a, peak, d, sustain = 0, rel = .02) {\n  const p = g.gain; p.setValueAtTime(0.00001, t); p.linearRampToValueAtTime(peak, t + a); p.exponentialRampToValueAtTime(Math.max(.00001, sustain || .00001), t + a + d); if (sustain) p.setValueAtTime(sustain, t + a + d); p.setTargetAtTime(0, t + a + d + .001, rel);\n}\nconst noiseCache = new WeakMap();\nexport function noiseBuffer(ctx) {\n  if (noiseCache.has(ctx)) return noiseCache.get(ctx);\n  const b = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate), d = b.getChannelData(0); let s = 22222;\n  for (let i = 0; i < d.length; i++) { s = (s * 1664525 + 1013904223) >>> 0; d[i] = s / 2147483648 - 1; }\n  noiseCache.set(ctx, b); return b;\n}\nexport function noise(ctx, t, dur) { const n = ctx.createBufferSource(); n.buffer = noiseBuffer(ctx); n.loop = true; n.start(t, (t * 7.3) % 1.9); n.stop(t + dur + .05); return n; }\nconst osc = (ctx, type, f, t, dur, det = 0) => { const o = ctx.createOscillator(); o.type = type; o.frequency.setValueAtTime(f, t); o.detune.setValueAtTime(det, t); o.start(t); o.stop(t + dur + .05); return o; };\nconst gainN = (ctx, v = 1) => { const g = ctx.createGain(); g.gain.value = v; return g; };\nconst filt = (ctx, type, f, q = 1) => { const b = ctx.createBiquadFilter(); b.type = type; b.frequency.value = f; b.Q.value = q; return b; };\nexport const INST = {\n  epiano(ctx, out, t, m, dur, v = .5, det = 0) { // sine carrier with a 14:1 tine and a 1:1 body, fast index decay\n    const f = mtof(m), c = osc(ctx, 'sine', f, t, dur + .4, det), g = gainN(ctx, 0); env(ctx, g, t, .004, v * .5, Math.max(.2, dur), .0001, .08); c.connect(g).connect(out);\n    for (const [ratio, idx, dec] of [[14, f * .55, .09], [1, f * .9, .5]]) { const mod = osc(ctx, 'sine', f * ratio, t, dur + .4, det), mg = gainN(ctx, 0); mg.gain.setValueAtTime(idx * v, t); mg.gain.exponentialRampToValueAtTime(.01, t + dec); mod.connect(mg).connect(c.frequency); }\n  },\n  bass(ctx, out, t, m, dur, v = .6, det = 0) { // saw through an enveloped low-pass plus a click\n    const o = osc(ctx, 'sawtooth', mtof(m), t, dur + .1, det), lp = filt(ctx, 'lowpass', 900, 5), g = gainN(ctx, 0); lp.frequency.setValueAtTime(1600, t); lp.frequency.exponentialRampToValueAtTime(180, t + .18); env(ctx, g, t, .004, v * .55, dur, .0001, .03); o.connect(lp).connect(g).connect(out);\n    const cl = noise(ctx, t, .02), cg = gainN(ctx, 0); env(ctx, cg, t, .001, v * .15, .012); cl.connect(cg).connect(out);\n  },\n  softBass(ctx, out, t, m, dur, v = .6, det = 0) { const o = osc(ctx, 'triangle', mtof(m), t, dur + .1, det), g = gainN(ctx, 0); env(ctx, g, t, .01, v * .7, Math.max(.15, dur), .0001, .04); o.connect(g).connect(out); },\n  tuba(ctx, out, t, m, dur, v = .6, det = 0) { const o = osc(ctx, 'sawtooth', mtof(m), t, dur + .1, det), lp = filt(ctx, 'lowpass', 420, 2), g = gainN(ctx, 0); env(ctx, g, t, .03, v * .7, dur * .9, .0001, .04); o.connect(lp).connect(g).connect(out); },\n  marimba(ctx, out, t, m, dur, v = .5, det = 0) { const f = mtof(m); for (const [r, a, d] of [[1, 1, .3], [4, .35, .07]]) { const o = osc(ctx, 'sine', f * r, t, .5, det), g = gainN(ctx, 0); env(ctx, g, t, .002, v * a * .6, d); o.connect(g).connect(out); } },\n  pizz(ctx, out, t, m, dur, v = .5, det = 0) { const o = osc(ctx, 'triangle', mtof(m), t, .3, det), lp = filt(ctx, 'lowpass', 2200, 1), g = gainN(ctx, 0); env(ctx, g, t, .002, v * .55, .13); o.connect(lp).connect(g).connect(out); },\n  vibes(ctx, out, t, m, dur, v = .5, det = 0) { const f = mtof(m), trem = osc(ctx, 'sine', 5.2, t, dur + 1), tg = gainN(ctx, .18), mix = gainN(ctx, 1); trem.connect(tg).connect(mix.gain); for (const [r, a, d] of [[1, 1, Math.max(.6, dur)], [4, .22, .16]]) { const o = osc(ctx, 'sine', f * r, t, dur + 1, det), g = gainN(ctx, 0); env(ctx, g, t, .002, v * a * .5, d); o.connect(g).connect(mix); } mix.connect(out); },\n  pad(ctx, out, t, m, dur, v = .4, det = 0) { const lp = filt(ctx, 'lowpass', 1100, .7), g = gainN(ctx, 0); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(v * .2, t + Math.min(1.2, dur * .4)); g.gain.setValueAtTime(v * .2, t + Math.max(.01, dur * .7)); g.gain.linearRampToValueAtTime(0, t + dur + .5); for (const d of [-7, 0, 8]) osc(ctx, 'sawtooth', mtof(m), t, dur + .5, det + d).connect(lp); lp.connect(g).connect(out); },\n  brass(ctx, out, t, m, dur, v = .5, det = 0) { const f = mtof(m), c = osc(ctx, 'sine', f, t, dur + .1, det), mod = osc(ctx, 'sine', f, t, dur + .1, det), mg = gainN(ctx, 0), g = gainN(ctx, 0); mg.gain.setValueAtTime(0, t); mg.gain.linearRampToValueAtTime(f * 2.4, t + .05); mg.gain.exponentialRampToValueAtTime(f * .4, t + dur); mod.connect(mg).connect(c.frequency); env(ctx, g, t, .02, v * .4, dur, .0001, .03); c.connect(g).connect(out); },\n  flute(ctx, out, t, m, dur, v = .4, det = 0) { const f = mtof(m), o = osc(ctx, 'sine', f, t, dur + .2, det), g = gainN(ctx, 0); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(v * .4, t + .09); g.gain.setValueAtTime(v * .36, t + Math.max(.1, dur - .1)); g.gain.linearRampToValueAtTime(0, t + dur + .1); o.connect(g).connect(out); const n = noise(ctx, t, dur + .1), bp = filt(ctx, 'bandpass', f, 6), ng = gainN(ctx, v * .25); n.connect(bp).connect(ng).connect(g); },\n  clav(ctx, out, t, m, dur, v = .5, det = 0) { const o = osc(ctx, 'square', mtof(m), t, .2, det), hp = filt(ctx, 'bandpass', 1600, 1.4), g = gainN(ctx, 0); env(ctx, g, t, .002, v * .28, .09); o.connect(hp).connect(g).connect(out); },\n  kick(ctx, out, t, m, dur, v = .8) { const o = osc(ctx, 'sine', 120, t, .3), g = gainN(ctx, 0); o.frequency.setValueAtTime(120, t); o.frequency.exponentialRampToValueAtTime(45, t + .09); env(ctx, g, t, .002, v, .2); o.connect(g).connect(out); },\n  snare(ctx, out, t, m, dur, v = .6) { const n = noise(ctx, t, .2), bp = filt(ctx, 'highpass', 900, .7), g = gainN(ctx, 0); env(ctx, g, t, .001, v * .55, .13); n.connect(bp).connect(g).connect(out); const o = osc(ctx, 'triangle', 190, t, .1), og = gainN(ctx, 0); env(ctx, og, t, .001, v * .3, .07); o.connect(og).connect(out); },\n  brush(ctx, out, t, m, dur, v = .4) { const n = noise(ctx, t, .12), f = filt(ctx, 'bandpass', 5200, .6), g = gainN(ctx, 0); env(ctx, g, t, .012, v * .2, .09); n.connect(f).connect(g).connect(out); },\n  shaker(ctx, out, t, m, dur, v = .4) { const n = noise(ctx, t, .06), f = filt(ctx, 'highpass', 6500, .8), g = gainN(ctx, 0); env(ctx, g, t, .004, v * .16, .04); n.connect(f).connect(g).connect(out); },\n  wood(ctx, out, t, m, dur, v = .5) { const o = osc(ctx, 'sine', mtof(m || 79), t, .1), g = gainN(ctx, 0); env(ctx, g, t, .001, v * .55, .05); o.connect(g).connect(out); },\n  rim(ctx, out, t, m, dur, v = .5) { const o = osc(ctx, 'square', 1700, t, .03), bp = filt(ctx, 'bandpass', 1700, 6), g = gainN(ctx, 0); env(ctx, g, t, .001, v * .5, .02); o.connect(bp).connect(g).connect(out); },\n  bell(ctx, out, t, m, dur, v = .4, det = 0) { const f = mtof(m); for (const [r, a, d] of [[1, 1, 1.8], [2.76, .4, .7], [5.4, .18, .3]]) { const o = osc(ctx, 'sine', f * r, t, 2, det), g = gainN(ctx, 0); env(ctx, g, t, .002, v * a * .35, d); o.connect(g).connect(out); } },\n};\nexport function makeImpulse(ctx, sec = 1.6, decay = 2.6) {\n  const n = Math.floor(ctx.sampleRate * sec), b = ctx.createBuffer(2, n, ctx.sampleRate); let s = 9137;\n  for (let c = 0; c < 2; c++) { const d = b.getChannelData(c); for (let i = 0; i < n; i++) { s = (s * 1664525 + 1013904223) >>> 0; d[i] = (s / 2147483648 - 1) * Math.pow(1 - i / n, decay); } }\n  return b;\n}\nE\ncat > audio/tracks.js <<'E'\n// Tracks are data: bpm, swing, chords per bar, parts. 16 steps to a bar.\nconst N = { Dbmaj9: [49, 65, 68, 72, 75], Bbm9: [46, 61, 65, 68, 72], Ebm9: [51, 61, 66, 70, 77], Ab13: [44, 66, 72, 77, 82], Gbmaj9: [42, 65, 68, 70, 73], Fm7: [41, 63, 68, 72, 75], Ab13sus: [44, 66, 73, 77, 82],\n  Fmaj7: [41, 64, 67, 69, 72], Am7: [45, 64, 67, 69, 72], Bbmaj7: [46, 62, 65, 69, 70], C9: [48, 64, 67, 70, 74], Dm9: [50, 65, 69, 72, 76], Gm9: [43, 65, 69, 70, 74], C13: [48, 64, 70, 74, 81],\n  Dmaj9: [38, 66, 69, 73, 76], Emaj9D: [38, 68, 71, 75, 78], Em9: [40, 62, 66, 67, 71], A13: [45, 61, 66, 67, 71], Dbmaj7: [49, 65, 68, 72, 77], Cm7: [48, 63, 67, 70, 75], Bbm7: [46, 61, 65, 68, 73], Ebsus: [51, 61, 65, 68, 70], C6: [48, 64, 67, 69, 72], Dm7: [50, 65, 69, 72, 77], G7: [43, 65, 67, 71, 74], Am7b: [45, 64, 67, 72, 76] };\nconst seq = (...names) => names.map(n => N[n]);\nconst MOTIF = [\n  [[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]],\n  [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]],\n  [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]],\n  [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]],\n];\nconst MOTIF_LOOP = [...MOTIF, ...MOTIF, [[0, 73, 4], [6, 72, 2], [8, 70, 8]], [[0, 68, 8]], [[0, 66, 4], [8, 68, 4]], [[0, 75, 8]]];\nconst levelBars = seq('Dbmaj9', 'Bbm9', 'Ebm9', 'Ab13', 'Dbmaj9', 'Bbm9', 'Ebm9', 'Ab13', 'Gbmaj9', 'Fm7', 'Ebm9', 'Ab13sus');\nexport const TRACKS = {\n  levelBest: { bpm: 92, swing: .14, bars: levelBars, parts: [\n    { inst: 'vibes', motif: MOTIF_LOOP, vel: .55 },\n    { inst: 'epiano', chord: [[0, 3], [6, 2], [10, 3]], vel: .3 },\n    { inst: 'softBass', bass: [[0, 0, 4], [6, 0, 2], [8, 7, 4], [14, 0, 2]], oct: 0, vel: .55 },\n    { inst: 'brush', hits: [0, 2, 4, 6, 8, 10, 12, 14], vel: .5 }, { inst: 'rim', hits: [4, 12], vel: .25 },\n  ] },\n  island: { bpm: 84, swing: .06, bars: seq('Fmaj7', 'Am7', 'Bbmaj7', 'C9', 'Fmaj7', 'Dm9', 'Gm9', 'C13'), parts: [\n    { inst: 'marimba', arp: [[0, 1], [3, 3], [6, 2], [8, 4], [11, 3], [14, 2]], vel: .45 },\n    { inst: 'softBass', bass: [[0, 0, 3], [3, 7, 1], [8, 7, 3], [11, 0, 1]], vel: .55 },\n    { inst: 'shaker', hits: [0, 2, 3, 4, 6, 7, 8, 10, 11, 12, 14, 15], vel: .6 }, { inst: 'rim', hits: [3, 6, 10, 13], vel: .25 },\n  ] },\n  stillness: { bpm: 60, swing: 0, bars: seq('Dmaj9', 'Dmaj9', 'Emaj9D', 'Emaj9D'), parts: [\n    { inst: 'pad', chord: [[0, 16]], vel: .5 }, { inst: 'bell', motif: [[[0, 81, 8]], [[8, 85, 8]], [[0, 80, 8]], [[8, 83, 8]]], vel: .4 },\n    { inst: 'flute', motif: [[], [[0, 76, 6], [8, 78, 6]], [], [[0, 80, 6], [8, 76, 8]]], vel: .5 },\n  ] },\n  strength: { bpm: 100, swing: .04, bars: seq('Em9', 'A13'), parts: [\n    { inst: 'bass', bass: [[0, 0, 2], [3, 0, 1], [6, 12, 1], [8, 0, 1], [10, 10, 2], [14, 7, 2]], vel: .7 }, { inst: 'clav', chord: [[2, 1], [5, 1], [10, 1], [13, 1]], vel: .5 },\n    { inst: 'brass', chord: [[12, 2]], every: 2, vel: .5 }, { inst: 'kick', hits: [0, 6, 8, 11], vel: .7 }, { inst: 'snare', hits: [4, 12], vel: .6 }, { inst: 'shaker', hits: [0, 2, 4, 6, 8, 10, 12, 14], vel: .5 },\n  ] },\n  cardio: { bpm: 112, swing: 0, bars: seq('Dbmaj7', 'Cm7', 'Bbm7', 'Ebsus'), parts: [\n    { inst: 'bass', bass: [[0, 0, 1], [2, 12, 1], [4, 0, 1], [6, 12, 1], [8, 0, 1], [10, 12, 1], [12, 0, 1], [14, 12, 1]], vel: .65 }, { inst: 'epiano', chord: [[2, 1], [6, 1], [10, 1], [14, 1]], vel: .32 },\n    { inst: 'brass', chord: [[0, 2], [7, 1]], every: 4, vel: .5 }, { inst: 'kick', hits: [0, 4, 8, 12], vel: .75 }, { inst: 'snare', hits: [4, 12], vel: .6 }, { inst: 'shaker', hits: [2, 6, 10, 14], vel: .7 },\n  ] },\n  balance: { bpm: 118, swing: .05, bars: seq('C6', 'Am7', 'Dm7', 'G7'), parts: [\n    { inst: 'marimba', arp: [[0, 1], [2, 2], [4, 3], [6, 2], [8, 4], [10, 3], [12, 2], [14, 3]], vel: .42 }, { inst: 'pizz', chord: [[4, 1], [12, 1]], vel: .4 },\n    { inst: 'tuba', bass: [[0, 0, 3], [8, 7, 3]], vel: .7 }, { inst: 'wood', hits: [4, 7, 12, 15], note: 84, vel: .4 }, { inst: 'shaker', hits: [2, 6, 10, 14], vel: .35 },\n  ] },\n  level: { bpm: 76, swing: .1, bars: levelBars, parts: [\n    { inst: 'epiano', motif: MOTIF_LOOP, vel: .6 }, { inst: 'vibes', motif: MOTIF_LOOP, from: 8, vel: .35 }, { inst: 'pad', chord: [[0, 16]], from: 4, vel: .35 },\n    { inst: 'softBass', bass: [[0, 0, 6], [8, 7, 6]], from: 4, vel: .5 }, { inst: 'brush', hits: [0, 4, 8, 12], from: 8, vel: .5 }, { inst: 'flute', motif: [[], [], [], [], [], [], [], [], [[0, 80, 8]], [[0, 77, 8]], [[0, 75, 8]], [[0, 80, 12]]], from: 12, vel: .5 },\n  ] },\n};\nexport const STINGS = {\n  attended: [['wood', 0, 72, .2], ['wood', .18, 72, .2], ['marimba', .36, 67, .5]],\n  adequate: [['marimba', 0, 72, .3], ['marimba', .14, 76, .3], ['marimba', .28, 79, .5]],\n  pleasant: [['vibes', 0, 72, .4], ['vibes', .14, 76, .4], ['vibes', .28, 79, .4], ['vibes', .42, 84, .9]],\n  exemplary: [['brass', 0, 72, .25], ['brass', .14, 76, .25], ['brass', .28, 79, .25], ['brass', .42, 84, .9], ['bell', .42, 96, 1]],\n  suspicious: [['brass', 0, 60, .3], ['brass', .3, 66, .3], ['vibes', .6, 84, .8], ['vibes', .75, 78, .8], ['bell', 1.1, 90, 1.5]],\n  reveal: [['brass', 0, 69, .2], ['brass', 0, 73, .2], ['brass', 0, 76, .2], ['kick', 0, 0, .2], ['bell', .1, 88, 1.4]],\n  unlock: [['vibes', 0, 79, .2], ['vibes', .1, 83, .2], ['vibes', .2, 86, .2], ['vibes', .3, 91, .8]],\n  notch: [['marimba', 0, 60, .2], ['marimba', .12, 64, .2], ['marimba', .24, 67, .4]],\n  fanfare: [['brass', 0, 65, .2], ['brass', .2, 65, .1], ['brass', .32, 70, .4], ['brass', .75, 74, .9], ['snare', 0, 0, .1], ['kick', .75, 0, .1], ['bell', .75, 86, 1.2]],\n};\nE\ncat > audio/sequencer.js <<'E'\nimport { INST } from './instruments.js';\nimport { TRACKS } from './tracks.js';\n// Schedules one 16th-note step of a track.\nexport function scheduleStep(ctx, out, track, stepN, t, detuneAt) {\n  const bar = Math.floor(stepN / 16), step = stepN % 16, chord = track.bars[bar % track.bars.length], s16 = 15 / track.bpm;\n  for (const p of track.parts) {\n    if (p.from && bar < p.from) continue;\n    if (p.every && bar % p.every !== 0) continue;\n    const fn = INST[p.inst]; const v = p.vel ?? .5, det = detuneAt(t);\n    if (p.hits) { if (p.hits.includes(step)) fn(ctx, out, t, p.note || 0, .1, v); continue; }\n    if (p.motif) { const b = p.motif[bar % p.motif.length]; for (const [st, n, l] of b) if (st === step) fn(ctx, out, t, n, l * s16, v, det); continue; }\n    if (p.chord) { for (const [st, l] of p.chord) if (st === step) for (let i = 1; i < chord.length; i++) fn(ctx, out, t, chord[i], l * s16, v * .7, det + (i - 2) * 1.5); continue; }\n    if (p.arp) { for (const [st, i] of p.arp) if (st === step) fn(ctx, out, t, chord[i], s16 * 2, v, det); continue; }\n    if (p.bass) { for (const [st, off, l] of p.bass) if (st === step) fn(ctx, out, t, chord[0] + off, l * s16, v, det); continue; }\n  }\n}\nexport class Sequencer {\n  constructor(audio) { this.audio = audio; this.track = null; this.name = null; this.step = 0; this.next = 0; this.gain = null; }\n  play(name, { bpm, startAt } = {}) {\n    if (this.name === name && !bpm && !startAt) return;\n    this.stop(.6);\n    const a = this.audio; if (!a.ctx) { this.name = name; return; }\n    const t = TRACKS[name]; if (!t) return;\n    this.track = bpm ? { ...t, bpm } : t; this.name = name; this.step = 0;\n    this.next = startAt ?? a.ctx.currentTime + .08;\n    this.gain = a.ctx.createGain(); this.gain.gain.value = 1; this.gain.connect(a.reverbSend);\n    this.tick();\n  }\n  stop(fade = .4) { const a = this.audio; if (this.gain && a.ctx) { const g = this.gain; g.gain.setTargetAtTime(0, a.ctx.currentTime, Math.max(.01, fade / 3)); setTimeout(() => { try { g.disconnect(); } catch { /* it had already gone */ } }, (fade + 1) * 1000); } this.gain = null; this.track = null; this.name = null; }\n  tick() {\n    const a = this.audio; if (!this.track || !a.ctx || a.ctx.state !== 'running') { if (a.ctx && this.track) this.next = a.ctx.currentTime + .05; return; }\n    if (this.next < a.ctx.currentTime - .5) this.next = a.ctx.currentTime + .03;\n    const s16 = 15 / this.track.bpm; const horizon = a.ctx.currentTime + .25;\n    while (this.next < horizon) {\n      const swing = (this.step % 2 === 1) ? s16 * this.track.swing : 0;\n      scheduleStep(a.ctx, this.gain, this.track, this.step, this.next + swing, a.detuneAt);\n      this.step++; this.next += s16; this.lastPlayed = a.ctx.currentTime;\n    }\n  }\n}\nE\ncat > audio/sfx.js <<'E'\nimport { INST, noise } from './instruments.js';\nconst G = (ctx, v) => { const g = ctx.createGain(); g.gain.value = v; return g; };\nconst F = (ctx, type, f, q = 1) => { const b = ctx.createBiquadFilter(); b.type = type; b.frequency.value = f; b.Q.value = q; return b; };\nconst burst = (ctx, out, t, f, q, v, dec) => { const n = noise(ctx, t, dec + .05), bp = F(ctx, 'bandpass', f, q), g = G(ctx, 0); g.gain.setValueAtTime(v, t); g.gain.exponentialRampToValueAtTime(.0001, t + dec); n.connect(bp).connect(g).connect(out); };\nconst tone = (ctx, out, t, type, f0, f1, dur, v) => { const o = ctx.createOscillator(); o.type = type; o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), t + dur); const g = G(ctx, 0); g.gain.setValueAtTime(v, t); g.gain.exponentialRampToValueAtTime(.0001, t + dur); o.connect(g).connect(out); o.start(t); o.stop(t + dur + .02); };\nexport const SFX = {\n  clack(c, o, t, p = {}) { const b = p.f || 1100; for (let i = 0; i < 3; i++) burst(c, o, t + i * (.05 + i * .02), b * (1 + i * .22), 12, .9, .06); },\n  clatter(c, o, t) { for (let i = 0; i < 9; i++) burst(c, o, t + i * .055 + (i * 7 % 3) * .012, 700 + (i * 137) % 1100, 11, .9 - i * .06, .07); },\n  spring(c, o, t) { const g = G(c, .35), d = c.createOscillator(); d.type = 'sine'; d.frequency.value = 24; const dg = G(c, 60); d.connect(dg); const s = c.createOscillator(); s.type = 'sine'; s.frequency.setValueAtTime(220, t); s.frequency.exponentialRampToValueAtTime(900, t + .32); dg.connect(s.frequency); g.gain.setValueAtTime(.35, t); g.gain.exponentialRampToValueAtTime(.0001, t + .42); s.connect(g).connect(o); s.start(t); d.start(t); s.stop(t + .45); d.stop(t + .45); },\n  splash(c, o, t, p = {}) { const big = p.big ?? 1, n = noise(c, t, .9 * big), lp = F(c, 'lowpass', 5000 * Math.min(1.2, big)), g = G(c, 0); lp.frequency.setValueAtTime(6000, t); lp.frequency.exponentialRampToValueAtTime(400, t + .75 * big); g.gain.setValueAtTime(.8 * Math.min(1.1, big), t); g.gain.exponentialRampToValueAtTime(.0001, t + .85 * big); n.connect(lp).connect(g).connect(o); },\n  marble(c, o, t, p = {}) { const f = (p.f || 1800) * (1 + (p.r ?? .5) * .5); tone(c, o, t, 'sine', f, f * .98, .08, .32); tone(c, o, t + .012, 'sine', f * 2.7, f * 2.6, .03, .1); },\n  roll(c, o, t) { const n = noise(c, t, .5), bp = F(c, 'bandpass', 2600, 4), g = G(c, 0); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.09, t + .1); g.gain.exponentialRampToValueAtTime(.0001, t + .45); n.connect(bp).connect(g).connect(o); },\n  plateHum(c, o, t, p = {}) { const f = p.f || 300; tone(c, o, t, 'sine', f, f * 1.02, .22, .08); },\n  crash(c, o, t) { burst(c, o, t, 3600, 1.5, .9, .35); for (let i = 0; i < 6; i++) burst(c, o, t + .03 + i * .04, 4200 + i * 500, 15, .5, .05); },\n  fruit(c, o, t) { tone(c, o, t, 'sine', 220, 90, .09, .7); burst(c, o, t, 500, 2, .3, .03); },\n  spike(c, o, t) { tone(c, o, t, 'sawtooth', 1400, 500, .12, .4); burst(c, o, t, 3000, 6, .5, .05); },\n  whistle(c, o, t) { const s = c.createOscillator(); s.type = 'sine'; s.frequency.setValueAtTime(2300, t); const v = c.createOscillator(); v.frequency.value = 42; const vg = G(c, 80); v.connect(vg).connect(s.frequency); const g = G(c, 0); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.35, t + .03); g.gain.setValueAtTime(.35, t + .4); g.gain.exponentialRampToValueAtTime(.0001, t + .55); s.connect(g).connect(o); s.start(t); v.start(t); s.stop(t + .6); v.stop(t + .6); },\n  bell(c, o, t) { INST.bell(c, o, t, 84, 1, .9); },\n  breathIn(c, o, t) { const n = noise(c, t, 1.6), bp = F(c, 'bandpass', 900, 1), g = G(c, 0); bp.frequency.setValueAtTime(600, t); bp.frequency.linearRampToValueAtTime(1800, t + 1.4); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.09, t + .9); g.gain.linearRampToValueAtTime(.001, t + 1.5); n.connect(bp).connect(g).connect(o); },\n  breathOut(c, o, t) { const n = noise(c, t, 1.6), bp = F(c, 'bandpass', 1500, 1), g = G(c, 0); bp.frequency.setValueAtTime(1600, t); bp.frequency.linearRampToValueAtTime(500, t + 1.4); g.gain.setValueAtTime(.09, t); g.gain.linearRampToValueAtTime(.001, t + 1.5); n.connect(bp).connect(g).connect(o); },\n  wind(c, o, t, p = {}) { const d = p.dur || 1.5, n = noise(c, t, d), bp = F(c, 'bandpass', 500, 2), g = G(c, 0); bp.frequency.setValueAtTime(350, t); bp.frequency.linearRampToValueAtTime(1500, t + d * .7); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.5, t + d * .7); g.gain.linearRampToValueAtTime(.001, t + d); n.connect(bp).connect(g).connect(o); },\n  creak(c, o, t, p = {}) { const d = p.dur || 1.5, s = c.createOscillator(); s.type = 'sawtooth'; s.frequency.setValueAtTime(58, t); s.frequency.linearRampToValueAtTime(74, t + d * .5); s.frequency.linearRampToValueAtTime(52, t + d); const r = F(c, 'bandpass', 640, 14), g = G(c, 0); r.frequency.setValueAtTime(420, t); r.frequency.linearRampToValueAtTime(980, t + d); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.8, t + .25); g.gain.linearRampToValueAtTime(.001, t + d); s.connect(r).connect(g).connect(o); s.start(t); s.stop(t + d + .02); },\n  move(c, o, t) { INST.wood(c, o, t, 76, .1, .5); }, ok(c, o, t) { INST.wood(c, o, t, 84, .1, .7); INST.wood(c, o, t + .06, 91, .1, .55); }, back(c, o, t) { INST.wood(c, o, t, 72, .1, .6); INST.wood(c, o, t + .06, 65, .1, .5); },\n  stamp(c, o, t) { tone(c, o, t, 'sine', 140, 40, .18, 1); burst(c, o, t, 800, 1, .7, .05); },\n  drum(c, o, t, p = {}) { const d = p.dur || 2.2; for (let i = 0, q = t; q < t + d; i++, q += Math.max(.05, .1 - i * .002)) INST.snare(c, o, q, 0, .06, .1 + .35 * (q - t) / d); },\n  foot(c, o, t, p = {}) { tone(c, o, t, 'sine', p.high ? 1500 : 1050, 500, .05, 1); burst(c, o, t, 3200, 3, .6, .018); },\n  tick(c, o, t, p = {}) { tone(c, o, t, 'square', p.high ? 1500 : 1000, 900, .03, .7); },\n  shove(c, o, t) { tone(c, o, t, 'sine', 180, 70, .14, .8); burst(c, o, t, 900, 2, .5, .05); },\n  pump(c, o, t) { tone(c, o, t, 'triangle', 110, 170, .14, .55); },\n  squawk(c, o, t) { const s = c.createOscillator(); s.type = 'sawtooth'; s.frequency.setValueAtTime(980, t); s.frequency.exponentialRampToValueAtTime(520, t + .28); const m = c.createOscillator(); m.frequency.value = 340; const mg = G(c, 500); m.connect(mg).connect(s.frequency); const g = G(c, 0); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.3, t + .02); g.gain.exponentialRampToValueAtTime(.0001, t + .3); s.connect(g).connect(o); s.start(t); m.start(t); s.stop(t + .32); m.stop(t + .32); },\n  sneeze(c, o, t) { burst(c, o, t, 3000, 1, .8, .22); tone(c, o, t, 'sawtooth', 500, 120, .16, .3); },\n  cheer(c, o, t) { for (let i = 0; i < 12; i++) { const f = 300 + (i * 173) % 500, s = t + i * .03; tone(c, o, s, 'sawtooth', f, f * 1.25, .35, .05); } burst(c, o, t, 2400, .7, .4, .7); },\n};\nexport function playSting(ctx, out, def, t) { for (const [inst, off, m, d] of def) INST[inst](ctx, out, t + off, m, d, .8); return Math.max(...def.map(x => x[1] + x[3])); }\nE\ncat > audio/voice.js <<'E'\n// Animalese-style gibberish, spoken from each line's own text.\nimport { noise } from './instruments.js';\nexport const FORMANTS = { a: [800, 1200], e: [500, 1900], i: [320, 2300], o: [500, 900], u: [350, 700] };\nexport const VOICES = {\n  trudy: { pitch: 420, rate: 16, wave: 'square', gain: .16, fmul: 1.35, breath: 0, drift: 40 },\n  stillwater: { pitch: 170, rate: 7, wave: 'sawtooth', gain: 2.6, fmul: .9, breath: .55, drift: 8, gap: true },\n  bolster: { pitch: 95, rate: 11, wave: 'sawtooth', gain: 1.5, fmul: .8, breath: 0, drift: 12, burst: true },\n  margaret: { pitch: 300, rate: 12, wave: 'square', gain: .55, fmul: 1.1, breath: .1, drift: 22 },\n  kevin: { pitch: 200, rate: 12, wave: 'sawtooth', gain: .9, fmul: .9, breath: 0, drift: 12 },\n  sandra: { pitch: 260, rate: 12, wave: 'square', gain: .55, fmul: 1, breath: 0, drift: 10 },\n  paul: { pitch: 230, rate: 12, wave: 'sawtooth', gain: .9, fmul: 1, breath: 0, drift: 50 },\n  gerald: { pitch: 320, rate: 12, wave: 'square', gain: .55, fmul: 1.05, breath: .2, drift: 30 },\n};\nexport const EXCLAIM = ['Wobba-la!', 'Oof-ah.', 'Nee nee!', 'Sulla bip?', 'Dag-a-doo.'];\nconst hash = (s) => { let h = 7; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h; };\n/** Schedules a line. Returns [duration, blipCount]. */\nexport function speakLine(ctx, out, who, text, t0) {\n  const V = VOICES[who] || VOICES.kevin; let r = hash(text); const rnd = () => { r = (r * 1664525 + 1013904223) >>> 0; return r / 4294967296; };\n  const bus = ctx.createGain(); bus.gain.value = V.gain; bus.connect(out);\n  const step = 1 / V.rate; let t = t0, blips = 0; const words = text.split(/\\s+/);\n  words.forEach((w, wi) => {\n    const clean = w.toLowerCase().replace(/[^a-z!?.,]/g, '');\n    const isQ = clean.endsWith('?'), isX = clean.endsWith('!'), isEnd = /[.!?]$/.test(clean);\n    const letters = clean.replace(/[^a-z]/g, ''); let vowelSeen = false;\n    for (let i = 0; i < letters.length; i++) {\n      const ch = letters[i], vowel = 'aeiou'.includes(ch);\n      if (!vowel && !(i === letters.length - 1 && !vowelSeen)) { if (i % 2 === 0) { const n = noise(ctx, t, .02), g = ctx.createGain(); g.gain.setValueAtTime(.05 * V.gain, t); g.gain.exponentialRampToValueAtTime(.0001, t + .012); n.connect(g).connect(out); t += step * .35; } continue; }\n      vowelSeen = true;\n      const f = FORMANTS[vowel ? ch : 'e']; let p = V.pitch * (1 + (rnd() - .5) * V.drift / V.pitch);\n      const last = i >= letters.length - 2;\n      if (isQ && last) p *= 1.34; else if (isX && last) p *= 1.5; else if (isEnd && last) p *= .8;\n      const o = ctx.createOscillator(); o.type = V.wave; o.frequency.setValueAtTime(p, t);\n      const g = ctx.createGain(); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(1, t + .008); g.gain.exponentialRampToValueAtTime(.001, t + .06);\n      const b1 = ctx.createBiquadFilter(); b1.type = 'bandpass'; b1.frequency.value = f[0] * V.fmul; b1.Q.value = 5;\n      const b2 = ctx.createBiquadFilter(); b2.type = 'bandpass'; b2.frequency.value = f[1] * V.fmul; b2.Q.value = 7;\n      o.connect(b1).connect(g); o.connect(b2).connect(g); g.connect(bus); o.start(t); o.stop(t + .07);\n      if (V.breath) { const n = noise(ctx, t, .07), ng = ctx.createGain(), bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f[1]; bp.Q.value = 2; ng.gain.setValueAtTime(.04 * V.breath, t); ng.gain.exponentialRampToValueAtTime(.0005, t + .06); n.connect(bp).connect(ng).connect(g); }\n      blips++; t += step;\n    }\n    t += step * (isEnd ? (V.gap ? 4 : 2.4) : (V.burst && wi % 4 === 3 ? 1.6 : .55));\n  });\n  return [t - t0, blips];\n}\nE\ncat > audio/engine.js <<'E'\nimport { makeImpulse, INST } from './instruments.js';\nimport { Sequencer, scheduleStep } from './sequencer.js';\nimport { TRACKS, STINGS } from './tracks.js';\nimport { SFX, playSting } from './sfx.js';\nimport { speakLine } from './voice.js';\nexport class AudioEngine {\n  constructor() {\n    this.ctx = null; this.settings = { music: 10, sfx: 80, voice: 80 }; this.tiltDeg = 9; this.seq = new Sequencer(this); this.stopped = false; this.levels = { music: 0, sfx: 0, voice: 0 };\n    this.detuneAt = (t) => this.tiltDeg * 1.6 * Math.sin(t * .7);\n    const AC = window.AudioContext || window.webkitAudioContext;\n    if (AC) { try { this.ctx = new AC(); this.build(this.ctx); this.timer = setInterval(() => this.seq.tick(), 25); } catch { this.ctx = null; } }\n  }\n  build(ctx) {\n    this.master = ctx.createDynamicsCompressor(); this.master.threshold.value = -10; this.master.ratio.value = 6; this.master.connect(ctx.destination);\n    this.music = ctx.createGain(); this.sfxBus = ctx.createGain(); this.voice = ctx.createGain();\n    this.music.connect(this.master); this.sfxBus.connect(this.master); this.voice.connect(this.master);\n    this.reverbSend = ctx.createGain(); const dry = ctx.createGain(); dry.gain.value = .86; const wet = ctx.createGain(); wet.gain.value = .22; const conv = ctx.createConvolver(); conv.buffer = makeImpulse(ctx);\n    this.reverbSend.connect(dry).connect(this.music); this.reverbSend.connect(conv).connect(wet).connect(this.music);\n    this.an = {}; for (const b of ['music', 'sfxBus', 'voice']) { const a = ctx.createAnalyser(); a.fftSize = 1024; this[b].connect(a); this.an[b] = a; }\n    this.applyVolumes();\n  }\n  applyVolumes() { if (!this.ctx) return; this.music.gain.value = this.settings.music / 100; this.sfxBus.gain.value = this.settings.sfx / 100; this.voice.gain.value = this.settings.voice / 100; }\n  setVolume(k, v) { this.settings[k] = v; this.applyVolumes(); }\n  resume() { if (this.ctx && this.ctx.state === 'suspended' && !this.stopped) { const p = this.ctx.resume(); if (p && p.catch) p.catch(() => {}); } }\n  get running() { return !!this.ctx && this.ctx.state === 'running'; }\n  now() { return this.ctx ? this.ctx.currentTime : 0; }\n  playTrack(name, o) { if (this.stopped) return; this.seq.play(name, o); }\n  stopTrack(fade) { this.seq.stop(fade); }\n  sfx(name, p) { if (!this.running || this.stopped) return; const f = SFX[name]; if (f) f(this.ctx, this.sfxBus, this.ctx.currentTime + .002, p); }\n  sting(name) { if (!this.running || this.stopped) return; const d = STINGS[name]; if (d) playSting(this.ctx, this.sfxBus, d, this.ctx.currentTime + .01); }\n  speak(who, text) { if (!this.running || this.stopped) return 0; if (!this.voiceGate) this.newVoiceGate(); return speakLine(this.ctx, this.voiceGate, who, text, this.ctx.currentTime + .02)[0]; }\n  newVoiceGate() { this.voiceGate = this.ctx.createGain(); this.voiceGate.connect(this.voice); }\n  hushVoice() { if (this.voiceGate) { const g = this.voiceGate; g.gain.setTargetAtTime(0, this.ctx.currentTime, .02); this.voiceGate = null; setTimeout(() => { try { g.disconnect(); } catch { /* already gone */ } }, 500); } }\n  level(bus) { const a = this.an?.[bus]; if (!a) return 0; const d = new Float32Array(a.fftSize); a.getFloatTimeDomainData(d); let s = 0; for (const v of d) s += v * v; return Math.sqrt(s / d.length); }\n  /** Session end: stop all sound. */\n  silence() { this.stopped = true; this.seq.stop(.05); if (this.timer) clearInterval(this.timer); if (this.ctx) { try { this.ctx.suspend(); } catch { /* already closed */ } } }\n}\n/** Offline render for tests. kind: track | sting | sfx | voice | click */\nexport async function renderOffline(kind, name, seconds = 4, opts = {}) {\n  const sr = 22050, ctx = new OfflineAudioContext(2, Math.floor(sr * seconds), sr);\n  const comp = ctx.createDynamicsCompressor(); comp.connect(ctx.destination); const out = ctx.createGain(); out.gain.value = opts.gain ?? 1; out.connect(comp);\n  let blips = 0;\n  if (kind === 'track') { const tr = TRACKS[name]; const s16 = 15 / tr.bpm; const det = () => 0; let st = 0; for (let t = .01; t < seconds; t += s16) { scheduleStep(ctx, out, tr, st++, t + (st % 2 === 0 ? s16 * tr.swing : 0), det); } }\n  else if (kind === 'sting') playSting(ctx, out, STINGS[name], .01);\n  else if (kind === 'sfx') SFX[name](ctx, out, .01, opts.params);\n  else if (kind === 'voice') { const r = speakLine(ctx, out, name, opts.text || 'Please step on. Not on me. On the island!', .01); blips = r[1]; }\n  else if (kind === 'inst') INST[name](ctx, out, .01, 60, .5, .7);\n  const buf = await ctx.startRendering(); const d = buf.getChannelData(0); let s = 0, peak = 0, bad = false;\n  for (const v of d) { if (!Number.isFinite(v)) bad = true; s += v * v; peak = Math.max(peak, Math.abs(v)); }\n  return { rms: Math.sqrt(s / d.length), peak, finite: !bad, blips };\n}\nE\ncd .. && cat > tools/build.mjs <<'E'\nimport { build } from 'esbuild'; import { readFileSync, writeFileSync, existsSync } from 'node:fs'; import { createHash } from 'node:crypto'; import { dirname, join } from 'node:path'; import { fileURLToPath } from 'node:url';\nconst here = dirname(dirname(fileURLToPath(import.meta.url))); process.chdir(here);\nconst NAME = here.split('/').pop(); const OUT = join(here, '..', `${NAME}.html`); const EXIT = join(here, '..', 'exit-interview.json');\nconst session = readFileSync('vendor/session.js', 'utf8').replace(/\\r\\n/g, '\\n');\nconst END = \"})(typeof window !== 'undefined' ? window : globalThis);\";\nconst hash = createHash('sha256').update(session.slice(session.indexOf('/*! aihub-session '), session.indexOf(END) + END.length)).digest('hex');\nif (hash !== '529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a') throw new Error('not the released hub client');\n// One source of truth: the exit-interview file feeds the About screen.\nconst exit = existsSync(EXIT) ? readFileSync(EXIT, 'utf8') : 'null'; JSON.parse(exit);\nwriteFileSync('src/data/about.js', `// Written by tools/build.mjs from exit-interview.json.\\nexport const EXIT = ${exit.trim()};\\nexport const SOURCE = 'Wii Fit';\\n`);\nconst title = /TITLE = '([^']+)'/.exec(readFileSync('src/data/config.js', 'utf8'))[1];\nconst r = await build({ entryPoints: ['src/main.js'], bundle: true, format: 'iife', target: 'es2022', minify: true, write: false, legalComments: 'none', loader: { '.css': 'text' }, logLevel: 'warning', keepNames: false });\nconst js = r.outputFiles[0].text.replace(/<\\/script/gi, '<\\\\/script');\nconst font = (w) => readFileSync(`node_modules/@fontsource/fredoka/files/fredoka-latin-${w}-normal.woff2`).toString('base64');\nconst face = (w) => `@font-face{font-family:Fredoka;font-weight:${w};font-display:swap;src:url(data:font/woff2;base64,${font(w)}) format(\"woff2\")}`;\nconst metas = [['hub:session', '1'], ['hub:session-players', '1-4'], ['hub:session-mode', 'ghost'], ['hub:session-minutes', '3'], ['hub:session-goal', 'Stay balanced through the class: highest score wins'], ['hub:session-howto', 'Lean: stick, WASD or mouse. Feet: L2 R2, Q E or clicks. Flail: Square or F'], ['hub:type', 'Game'], ['hub:players', '1-4'], ['hub:source', 'Wii Fit']].map(([n, c]) => `<meta name=\"${n}\" content=\"${c}\">`).join('');\nwriteFileSync(OUT, ['<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>', session, '</script>', metas, `<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>${title}</title><style>`, face(500), face(600), face(700), '</style></head><body>', '<script>', js, '</script></body></html>'].join(''));\nconsole.log(`built ${(js.length / 1e6).toFixed(2)} MB`);\nE\necho ok","description":"Write audio engine, tracks, sfx, voices and the build tool"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14846,"cache_read_input_tokens":181959,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14846},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"4e3cd44a-1f9c-43cb-a2c2-40c359697291","timestamp":"2026-11-05T12:13:00.857Z","request_id":"req_011CgjkuEP87hBvBocVBWycW","wire_tool_inputs":{"toolu_01NkgVLei9792PFerTrqhVjG":{"command":"cat > audio/instruments.js <<'E'\n// Every instrument takes ctx, so the same code runs on AudioContext and OfflineAudioContext.\nexport const mtof = (m) => 440 * Math.pow(2, (m - 69) / 12);\nfunction env(ctx, g, t, a, peak, d, sustain = 0, rel = .02) {\n  const p = g.gain; p.setValueAtTime(0.00001, t); p.linearRampToValueAtTime(peak, t + a); p.exponentialRampToValueAtTime(Math.max(.00001, sustain || .00001), t + a + d); if (sustain) p.setValueAtTime(sustain, t + a + d); p.setTargetAtTime(0, t + a + d + .001, rel);\n}\nconst noiseCache = new WeakMap();\nexport function noiseBuffer(ctx) {\n  if (noiseCache.has(ctx)) return noiseCache.get(ctx);\n  const b = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate), d = b.getChannelData(0); let s = 22222;\n  for (let i = 0; i < d.length; i++) { s = (s * 1664525 + 1013904223) >>> 0; d[i] = s / 2147483648 - 1; }\n  noiseCache.set(ctx, b); return b;\n}\nexport function noise(ctx, t, dur) { const n = ctx.createBufferSource(); n.buffer = noiseBuffer(ctx); n.loop = true; n.start(t, (t * 7.3) % 1.9); n.stop(t + dur + .05); return n; }\nconst osc = (ctx, type, f, t, dur, det = 0) => { const o = ctx.createOscillator(); o.type = type; o.frequency.setValueAtTime(f, t); o.detune.setValueAtTime(det, t); o.start(t); o.stop(t + dur + .05); return o; };\nconst gainN = (ctx, v = 1) => { const g = ctx.createGain(); g.gain.value = v; return g; };\nconst filt = (ctx, type, f, q = 1) => { const b = ctx.createBiquadFilter(); b.type = type; b.frequency.value = f; b.Q.value = q; return b; };\nexport const INST = {\n  epiano(ctx, out, t, m, dur, v = .5, det = 0) { // sine carrier with a 14:1 tine and a 1:1 body, fast index decay\n    const f = mtof(m), c = osc(ctx, 'sine', f, t, dur + .4, det), g = gainN(ctx, 0); env(ctx, g, t, .004, v * .5, Math.max(.2, dur), .0001, .08); c.connect(g).connect(out);\n    for (const [ratio, idx, dec] of [[14, f * .55, .09], [1, f * .9, .5]]) { const mod = osc(ctx, 'sine', f * ratio, t, dur + .4, det), mg = gainN(ctx, 0); mg.gain.setValueAtTime(idx * v, t); mg.gain.exponentialRampToValueAtTime(.01, t + dec); mod.connect(mg).connect(c.frequency); }\n  },\n  bass(ctx, out, t, m, dur, v = .6, det = 0) { // saw through an enveloped low-pass plus a click\n    const o = osc(ctx, 'sawtooth', mtof(m), t, dur + .1, det), lp = filt(ctx, 'lowpass', 900, 5), g = gainN(ctx, 0); lp.frequency.setValueAtTime(1600, t); lp.frequency.exponentialRampToValueAtTime(180, t + .18); env(ctx, g, t, .004, v * .55, dur, .0001, .03); o.connect(lp).connect(g).connect(out);\n    const cl = noise(ctx, t, .02), cg = gainN(ctx, 0); env(ctx, cg, t, .001, v * .15, .012); cl.connect(cg).connect(out);\n  },\n  softBass(ctx, out, t, m, dur, v = .6, det = 0) { const o = osc(ctx, 'triangle', mtof(m), t, dur + .1, det), g = gainN(ctx, 0); env(ctx, g, t, .01, v * .7, Math.max(.15, dur), .0001, .04); o.connect(g).connect(out); },\n  tuba(ctx, out, t, m, dur, v = .6, det = 0) { const o = osc(ctx, 'sawtooth', mtof(m), t, dur + .1, det), lp = filt(ctx, 'lowpass', 420, 2), g = gainN(ctx, 0); env(ctx, g, t, .03, v * .7, dur * .9, .0001, .04); o.connect(lp).connect(g).connect(out); },\n  marimba(ctx, out, t, m, dur, v = .5, det = 0) { const f = mtof(m); for (const [r, a, d] of [[1, 1, .3], [4, .35, .07]]) { const o = osc(ctx, 'sine', f * r, t, .5, det), g = gainN(ctx, 0); env(ctx, g, t, .002, v * a * .6, d); o.connect(g).connect(out); } },\n  pizz(ctx, out, t, m, dur, v = .5, det = 0) { const o = osc(ctx, 'triangle', mtof(m), t, .3, det), lp = filt(ctx, 'lowpass', 2200, 1), g = gainN(ctx, 0); env(ctx, g, t, .002, v * .55, .13); o.connect(lp).connect(g).connect(out); },\n  vibes(ctx, out, t, m, dur, v = .5, det = 0) { const f = mtof(m), trem = osc(ctx, 'sine', 5.2, t, dur + 1), tg = gainN(ctx, .18), mix = gainN(ctx, 1); trem.connect(tg).connect(mix.gain); for (const [r, a, d] of [[1, 1, Math.max(.6, dur)], [4, .22, .16]]) { const o = osc(ctx, 'sine', f * r, t, dur + 1, det), g = gainN(ctx, 0); env(ctx, g, t, .002, v * a * .5, d); o.connect(g).connect(mix); } mix.connect(out); },\n  pad(ctx, out, t, m, dur, v = .4, det = 0) { const lp = filt(ctx, 'lowpass', 1100, .7), g = gainN(ctx, 0); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(v * .2, t + Math.min(1.2, dur * .4)); g.gain.setValueAtTime(v * .2, t + Math.max(.01, dur * .7)); g.gain.linearRampToValueAtTime(0, t + dur + .5); for (const d of [-7, 0, 8]) osc(ctx, 'sawtooth', mtof(m), t, dur + .5, det + d).connect(lp); lp.connect(g).connect(out); },\n  brass(ctx, out, t, m, dur, v = .5, det = 0) { const f = mtof(m), c = osc(ctx, 'sine', f, t, dur + .1, det), mod = osc(ctx, 'sine', f, t, dur + .1, det), mg = gainN(ctx, 0), g = gainN(ctx, 0); mg.gain.setValueAtTime(0, t); mg.gain.linearRampToValueAtTime(f * 2.4, t + .05); mg.gain.exponentialRampToValueAtTime(f * .4, t + dur); mod.connect(mg).connect(c.frequency); env(ctx, g, t, .02, v * .4, dur, .0001, .03); c.connect(g).connect(out); },\n  flute(ctx, out, t, m, dur, v = .4, det = 0) { const f = mtof(m), o = osc(ctx, 'sine', f, t, dur + .2, det), g = gainN(ctx, 0); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(v * .4, t + .09); g.gain.setValueAtTime(v * .36, t + Math.max(.1, dur - .1)); g.gain.linearRampToValueAtTime(0, t + dur + .1); o.connect(g).connect(out); const n = noise(ctx, t, dur + .1), bp = filt(ctx, 'bandpass', f, 6), ng = gainN(ctx, v * .25); n.connect(bp).connect(ng).connect(g); },\n  clav(ctx, out, t, m, dur, v = .5, det = 0) { const o = osc(ctx, 'square', mtof(m), t, .2, det), hp = filt(ctx, 'bandpass', 1600, 1.4), g = gainN(ctx, 0); env(ctx, g, t, .002, v * .28, .09); o.connect(hp).connect(g).connect(out); },\n  kick(ctx, out, t, m, dur, v = .8) { const o = osc(ctx, 'sine', 120, t, .3), g = gainN(ctx, 0); o.frequency.setValueAtTime(120, t); o.frequency.exponentialRampToValueAtTime(45, t + .09); env(ctx, g, t, .002, v, .2); o.connect(g).connect(out); },\n  snare(ctx, out, t, m, dur, v = .6) { const n = noise(ctx, t, .2), bp = filt(ctx, 'highpass', 900, .7), g = gainN(ctx, 0); env(ctx, g, t, .001, v * .55, .13); n.connect(bp).connect(g).connect(out); const o = osc(ctx, 'triangle', 190, t, .1), og = gainN(ctx, 0); env(ctx, og, t, .001, v * .3, .07); o.connect(og).connect(out); },\n  brush(ctx, out, t, m, dur, v = .4) { const n = noise(ctx, t, .12), f = filt(ctx, 'bandpass', 5200, .6), g = gainN(ctx, 0); env(ctx, g, t, .012, v * .2, .09); n.connect(f).connect(g).connect(out); },\n  shaker(ctx, out, t, m, dur, v = .4) { const n = noise(ctx, t, .06), f = filt(ctx, 'highpass', 6500, .8), g = gainN(ctx, 0); env(ctx, g, t, .004, v * .16, .04); n.connect(f).connect(g).connect(out); },\n  wood(ctx, out, t, m, dur, v = .5) { const o = osc(ctx, 'sine', mtof(m || 79), t, .1), g = gainN(ctx, 0); env(ctx, g, t, .001, v * .55, .05); o.connect(g).connect(out); },\n  rim(ctx, out, t, m, dur, v = .5) { const o = osc(ctx, 'square', 1700, t, .03), bp = filt(ctx, 'bandpass', 1700, 6), g = gainN(ctx, 0); env(ctx, g, t, .001, v * .5, .02); o.connect(bp).connect(g).connect(out); },\n  bell(ctx, out, t, m, dur, v = .4, det = 0) { const f = mtof(m); for (const [r, a, d] of [[1, 1, 1.8], [2.76, .4, .7], [5.4, .18, .3]]) { const o = osc(ctx, 'sine', f * r, t, 2, det), g = gainN(ctx, 0); env(ctx, g, t, .002, v * a * .35, d); o.connect(g).connect(out); } },\n};\nexport function makeImpulse(ctx, sec = 1.6, decay = 2.6) {\n  const n = Math.floor(ctx.sampleRate * sec), b = ctx.createBuffer(2, n, ctx.sampleRate); let s = 9137;\n  for (let c = 0; c < 2; c++) { const d = b.getChannelData(c); for (let i = 0; i < n; i++) { s = (s * 1664525 + 1013904223) >>> 0; d[i] = (s / 2147483648 - 1) * Math.pow(1 - i / n, decay); } }\n  return b;\n}\nE\ncat > audio/tracks.js <<'E'\n// Tracks are data: bpm, swing, chords per bar, parts. 16 steps to a bar.\nconst N = { Dbmaj9: [49, 65, 68, 72, 75], Bbm9: [46, 61, 65, 68, 72], Ebm9: [51, 61, 66, 70, 77], Ab13: [44, 66, 72, 77, 82], Gbmaj9: [42, 65, 68, 70, 73], Fm7: [41, 63, 68, 72, 75], Ab13sus: [44, 66, 73, 77, 82],\n  Fmaj7: [41, 64, 67, 69, 72], Am7: [45, 64, 67, 69, 72], Bbmaj7: [46, 62, 65, 69, 70], C9: [48, 64, 67, 70, 74], Dm9: [50, 65, 69, 72, 76], Gm9: [43, 65, 69, 70, 74], C13: [48, 64, 70, 74, 81],\n  Dmaj9: [38, 66, 69, 73, 76], Emaj9D: [38, 68, 71, 75, 78], Em9: [40, 62, 66, 67, 71], A13: [45, 61, 66, 67, 71], Dbmaj7: [49, 65, 68, 72, 77], Cm7: [48, 63, 67, 70, 75], Bbm7: [46, 61, 65, 68, 73], Ebsus: [51, 61, 65, 68, 70], C6: [48, 64, 67, 69, 72], Dm7: [50, 65, 69, 72, 77], G7: [43, 65, 67, 71, 74], Am7b: [45, 64, 67, 72, 76] };\nconst seq = (...names) => names.map(n => N[n]);\nconst MOTIF = [\n  [[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]],\n  [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]],\n  [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]],\n  [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]],\n];\nconst MOTIF_LOOP = [...MOTIF, ...MOTIF, [[0, 73, 4], [6, 72, 2], [8, 70, 8]], [[0, 68, 8]], [[0, 66, 4], [8, 68, 4]], [[0, 75, 8]]];\nconst levelBars = seq('Dbmaj9', 'Bbm9', 'Ebm9', 'Ab13', 'Dbmaj9', 'Bbm9', 'Ebm9', 'Ab13', 'Gbmaj9', 'Fm7', 'Ebm9', 'Ab13sus');\nexport const TRACKS = {\n  levelBest: { bpm: 92, swing: .14, bars: levelBars, parts: [\n    { inst: 'vibes', motif: MOTIF_LOOP, vel: .55 },\n    { inst: 'epiano', chord: [[0, 3], [6, 2], [10, 3]], vel: .3 },\n    { inst: 'softBass', bass: [[0, 0, 4], [6, 0, 2], [8, 7, 4], [14, 0, 2]], oct: 0, vel: .55 },\n    { inst: 'brush', hits: [0, 2, 4, 6, 8, 10, 12, 14], vel: .5 }, { inst: 'rim', hits: [4, 12], vel: .25 },\n  ] },\n  island: { bpm: 84, swing: .06, bars: seq('Fmaj7', 'Am7', 'Bbmaj7', 'C9', 'Fmaj7', 'Dm9', 'Gm9', 'C13'), parts: [\n    { inst: 'marimba', arp: [[0, 1], [3, 3], [6, 2], [8, 4], [11, 3], [14, 2]], vel: .45 },\n    { inst: 'softBass', bass: [[0, 0, 3], [3, 7, 1], [8, 7, 3], [11, 0, 1]], vel: .55 },\n    { inst: 'shaker', hits: [0, 2, 3, 4, 6, 7, 8, 10, 11, 12, 14, 15], vel: .6 }, { inst: 'rim', hits: [3, 6, 10, 13], vel: .25 },\n  ] },\n  stillness: { bpm: 60, swing: 0, bars: seq('Dmaj9', 'Dmaj9', 'Emaj9D', 'Emaj9D'), parts: [\n    { inst: 'pad', chord: [[0, 16]], vel: .5 }, { inst: 'bell', motif: [[[0, 81, 8]], [[8, 85, 8]], [[0, 80, 8]], [[8, 83, 8]]], vel: .4 },\n    { inst: 'flute', motif: [[], [[0, 76, 6], [8, 78, 6]], [], [[0, 80, 6], [8, 76, 8]]], vel: .5 },\n  ] },\n  strength: { bpm: 100, swing: .04, bars: seq('Em9', 'A13'), parts: [\n    { inst: 'bass', bass: [[0, 0, 2], [3, 0, 1], [6, 12, 1], [8, 0, 1], [10, 10, 2], [14, 7, 2]], vel: .7 }, { inst: 'clav', chord: [[2, 1], [5, 1], [10, 1], [13, 1]], vel: .5 },\n    { inst: 'brass', chord: [[12, 2]], every: 2, vel: .5 }, { inst: 'kick', hits: [0, 6, 8, 11], vel: .7 }, { inst: 'snare', hits: [4, 12], vel: .6 }, { inst: 'shaker', hits: [0, 2, 4, 6, 8, 10, 12, 14], vel: .5 },\n  ] },\n  cardio: { bpm: 112, swing: 0, bars: seq('Dbmaj7', 'Cm7', 'Bbm7', 'Ebsus'), parts: [\n    { inst: 'bass', bass: [[0, 0, 1], [2, 12, 1], [4, 0, 1], [6, 12, 1], [8, 0, 1], [10, 12, 1], [12, 0, 1], [14, 12, 1]], vel: .65 }, { inst: 'epiano', chord: [[2, 1], [6, 1], [10, 1], [14, 1]], vel: .32 },\n    { inst: 'brass', chord: [[0, 2], [7, 1]], every: 4, vel: .5 }, { inst: 'kick', hits: [0, 4, 8, 12], vel: .75 }, { inst: 'snare', hits: [4, 12], vel: .6 }, { inst: 'shaker', hits: [2, 6, 10, 14], vel: .7 },\n  ] },\n  balance: { bpm: 118, swing: .05, bars: seq('C6', 'Am7', 'Dm7', 'G7'), parts: [\n    { inst: 'marimba', arp: [[0, 1], [2, 2], [4, 3], [6, 2], [8, 4], [10, 3], [12, 2], [14, 3]], vel: .42 }, { inst: 'pizz', chord: [[4, 1], [12, 1]], vel: .4 },\n    { inst: 'tuba', bass: [[0, 0, 3], [8, 7, 3]], vel: .7 }, { inst: 'wood', hits: [4, 7, 12, 15], note: 84, vel: .4 }, { inst: 'shaker', hits: [2, 6, 10, 14], vel: .35 },\n  ] },\n  level: { bpm: 76, swing: .1, bars: levelBars, parts: [\n    { inst: 'epiano', motif: MOTIF_LOOP, vel: .6 }, { inst: 'vibes', motif: MOTIF_LOOP, from: 8, vel: .35 }, { inst: 'pad', chord: [[0, 16]], from: 4, vel: .35 },\n    { inst: 'softBass', bass: [[0, 0, 6], [8, 7, 6]], from: 4, vel: .5 }, { inst: 'brush', hits: [0, 4, 8, 12], from: 8, vel: .5 }, { inst: 'flute', motif: [[], [], [], [], [], [], [], [], [[0, 80, 8]], [[0, 77, 8]], [[0, 75, 8]], [[0, 80, 12]]], from: 12, vel: .5 },\n  ] },\n};\nexport const STINGS = {\n  attended: [['wood', 0, 72, .2], ['wood', .18, 72, .2], ['marimba', .36, 67, .5]],\n  adequate: [['marimba', 0, 72, .3], ['marimba', .14, 76, .3], ['marimba', .28, 79, .5]],\n  pleasant: [['vibes', 0, 72, .4], ['vibes', .14, 76, .4], ['vibes', .28, 79, .4], ['vibes', .42, 84, .9]],\n  exemplary: [['brass', 0, 72, .25], ['brass', .14, 76, .25], ['brass', .28, 79, .25], ['brass', .42, 84, .9], ['bell', .42, 96, 1]],\n  suspicious: [['brass', 0, 60, .3], ['brass', .3, 66, .3], ['vibes', .6, 84, .8], ['vibes', .75, 78, .8], ['bell', 1.1, 90, 1.5]],\n  reveal: [['brass', 0, 69, .2], ['brass', 0, 73, .2], ['brass', 0, 76, .2], ['kick', 0, 0, .2], ['bell', .1, 88, 1.4]],\n  unlock: [['vibes', 0, 79, .2], ['vibes', .1, 83, .2], ['vibes', .2, 86, .2], ['vibes', .3, 91, .8]],\n  notch: [['marimba', 0, 60, .2], ['marimba', .12, 64, .2], ['marimba', .24, 67, .4]],\n  fanfare: [['brass', 0, 65, .2], ['brass', .2, 65, .1], ['brass', .32, 70, .4], ['brass', .75, 74, .9], ['snare', 0, 0, .1], ['kick', .75, 0, .1], ['bell', .75, 86, 1.2]],\n};\nE\ncat > audio/sequencer.js <<'E'\nimport { INST } from './instruments.js';\nimport { TRACKS } from './tracks.js';\n// Schedules one 16th-note step of a track.\nexport function scheduleStep(ctx, out, track, stepN, t, detuneAt) {\n  const bar = Math.floor(stepN / 16), step = stepN % 16, chord = track.bars[bar % track.bars.length], s16 = 15 / track.bpm;\n  for (const p of track.parts) {\n    if (p.from && bar < p.from) continue;\n    if (p.every && bar % p.every !== 0) continue;\n    const fn = INST[p.inst]; const v = p.vel ?? .5, det = detuneAt(t);\n    if (p.hits) { if (p.hits.includes(step)) fn(ctx, out, t, p.note || 0, .1, v); continue; }\n    if (p.motif) { const b = p.motif[bar % p.motif.length]; for (const [st, n, l] of b) if (st === step) fn(ctx, out, t, n, l * s16, v, det); continue; }\n    if (p.chord) { for (const [st, l] of p.chord) if (st === step) for (let i = 1; i < chord.length; i++) fn(ctx, out, t, chord[i], l * s16, v * .7, det + (i - 2) * 1.5); continue; }\n    if (p.arp) { for (const [st, i] of p.arp) if (st === step) fn(ctx, out, t, chord[i], s16 * 2, v, det); continue; }\n    if (p.bass) { for (const [st, off, l] of p.bass) if (st === step) fn(ctx, out, t, chord[0] + off, l * s16, v, det); continue; }\n  }\n}\nexport class Sequencer {\n  constructor(audio) { this.audio = audio; this.track = null; this.name = null; this.step = 0; this.next = 0; this.gain = null; }\n  play(name, { bpm, startAt } = {}) {\n    if (this.name === name && !bpm && !startAt) return;\n    this.stop(.6);\n    const a = this.audio; if (!a.ctx) { this.name = name; return; }\n    const t = TRACKS[name]; if (!t) return;\n    this.track = bpm ? { ...t, bpm } : t; this.name = name; this.step = 0;\n    this.next = startAt ?? a.ctx.currentTime + .08;\n    this.gain = a.ctx.createGain(); this.gain.gain.value = 1; this.gain.connect(a.reverbSend);\n    this.tick();\n  }\n  stop(fade = .4) { const a = this.audio; if (this.gain && a.ctx) { const g = this.gain; g.gain.setTargetAtTime(0, a.ctx.currentTime, Math.max(.01, fade / 3)); setTimeout(() => { try { g.disconnect(); } catch { /* it had already gone */ } }, (fade + 1) * 1000); } this.gain = null; this.track = null; this.name = null; }\n  tick() {\n    const a = this.audio; if (!this.track || !a.ctx || a.ctx.state !== 'running') { if (a.ctx && this.track) this.next = a.ctx.currentTime + .05; return; }\n    if (this.next < a.ctx.currentTime - .5) this.next = a.ctx.currentTime + .03;\n    const s16 = 15 / this.track.bpm; const horizon = a.ctx.currentTime + .25;\n    while (this.next < horizon) {\n      const swing = (this.step % 2 === 1) ? s16 * this.track.swing : 0;\n      scheduleStep(a.ctx, this.gain, this.track, this.step, this.next + swing, a.detuneAt);\n      this.step++; this.next += s16; this.lastPlayed = a.ctx.currentTime;\n    }\n  }\n}\nE\ncat > audio/sfx.js <<'E'\nimport { INST, noise } from './instruments.js';\nconst G = (ctx, v) => { const g = ctx.createGain(); g.gain.value = v; return g; };\nconst F = (ctx, type, f, q = 1) => { const b = ctx.createBiquadFilter(); b.type = type; b.frequency.value = f; b.Q.value = q; return b; };\nconst burst = (ctx, out, t, f, q, v, dec) => { const n = noise(ctx, t, dec + .05), bp = F(ctx, 'bandpass', f, q), g = G(ctx, 0); g.gain.setValueAtTime(v, t); g.gain.exponentialRampToValueAtTime(.0001, t + dec); n.connect(bp).connect(g).connect(out); };\nconst tone = (ctx, out, t, type, f0, f1, dur, v) => { const o = ctx.createOscillator(); o.type = type; o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), t + dur); const g = G(ctx, 0); g.gain.setValueAtTime(v, t); g.gain.exponentialRampToValueAtTime(.0001, t + dur); o.connect(g).connect(out); o.start(t); o.stop(t + dur + .02); };\nexport const SFX = {\n  clack(c, o, t, p = {}) { const b = p.f || 1100; for (let i = 0; i < 3; i++) burst(c, o, t + i * (.05 + i * .02), b * (1 + i * .22), 12, .9, .06); },\n  clatter(c, o, t) { for (let i = 0; i < 9; i++) burst(c, o, t + i * .055 + (i * 7 % 3) * .012, 700 + (i * 137) % 1100, 11, .9 - i * .06, .07); },\n  spring(c, o, t) { const g = G(c, .35), d = c.createOscillator(); d.type = 'sine'; d.frequency.value = 24; const dg = G(c, 60); d.connect(dg); const s = c.createOscillator(); s.type = 'sine'; s.frequency.setValueAtTime(220, t); s.frequency.exponentialRampToValueAtTime(900, t + .32); dg.connect(s.frequency); g.gain.setValueAtTime(.35, t); g.gain.exponentialRampToValueAtTime(.0001, t + .42); s.connect(g).connect(o); s.start(t); d.start(t); s.stop(t + .45); d.stop(t + .45); },\n  splash(c, o, t, p = {}) { const big = p.big ?? 1, n = noise(c, t, .9 * big), lp = F(c, 'lowpass', 5000 * Math.min(1.2, big)), g = G(c, 0); lp.frequency.setValueAtTime(6000, t); lp.frequency.exponentialRampToValueAtTime(400, t + .75 * big); g.gain.setValueAtTime(.8 * Math.min(1.1, big), t); g.gain.exponentialRampToValueAtTime(.0001, t + .85 * big); n.connect(lp).connect(g).connect(o); },\n  marble(c, o, t, p = {}) { const f = (p.f || 1800) * (1 + (p.r ?? .5) * .5); tone(c, o, t, 'sine', f, f * .98, .08, .32); tone(c, o, t + .012, 'sine', f * 2.7, f * 2.6, .03, .1); },\n  roll(c, o, t) { const n = noise(c, t, .5), bp = F(c, 'bandpass', 2600, 4), g = G(c, 0); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.09, t + .1); g.gain.exponentialRampToValueAtTime(.0001, t + .45); n.connect(bp).connect(g).connect(o); },\n  plateHum(c, o, t, p = {}) { const f = p.f || 300; tone(c, o, t, 'sine', f, f * 1.02, .22, .08); },\n  crash(c, o, t) { burst(c, o, t, 3600, 1.5, .9, .35); for (let i = 0; i < 6; i++) burst(c, o, t + .03 + i * .04, 4200 + i * 500, 15, .5, .05); },\n  fruit(c, o, t) { tone(c, o, t, 'sine', 220, 90, .09, .7); burst(c, o, t, 500, 2, .3, .03); },\n  spike(c, o, t) { tone(c, o, t, 'sawtooth', 1400, 500, .12, .4); burst(c, o, t, 3000, 6, .5, .05); },\n  whistle(c, o, t) { const s = c.createOscillator(); s.type = 'sine'; s.frequency.setValueAtTime(2300, t); const v = c.createOscillator(); v.frequency.value = 42; const vg = G(c, 80); v.connect(vg).connect(s.frequency); const g = G(c, 0); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.35, t + .03); g.gain.setValueAtTime(.35, t + .4); g.gain.exponentialRampToValueAtTime(.0001, t + .55); s.connect(g).connect(o); s.start(t); v.start(t); s.stop(t + .6); v.stop(t + .6); },\n  bell(c, o, t) { INST.bell(c, o, t, 84, 1, .9); },\n  breathIn(c, o, t) { const n = noise(c, t, 1.6), bp = F(c, 'bandpass', 900, 1), g = G(c, 0); bp.frequency.setValueAtTime(600, t); bp.frequency.linearRampToValueAtTime(1800, t + 1.4); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.09, t + .9); g.gain.linearRampToValueAtTime(.001, t + 1.5); n.connect(bp).connect(g).connect(o); },\n  breathOut(c, o, t) { const n = noise(c, t, 1.6), bp = F(c, 'bandpass', 1500, 1), g = G(c, 0); bp.frequency.setValueAtTime(1600, t); bp.frequency.linearRampToValueAtTime(500, t + 1.4); g.gain.setValueAtTime(.09, t); g.gain.linearRampToValueAtTime(.001, t + 1.5); n.connect(bp).connect(g).connect(o); },\n  wind(c, o, t, p = {}) { const d = p.dur || 1.5, n = noise(c, t, d), bp = F(c, 'bandpass', 500, 2), g = G(c, 0); bp.frequency.setValueAtTime(350, t); bp.frequency.linearRampToValueAtTime(1500, t + d * .7); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.5, t + d * .7); g.gain.linearRampToValueAtTime(.001, t + d); n.connect(bp).connect(g).connect(o); },\n  creak(c, o, t, p = {}) { const d = p.dur || 1.5, s = c.createOscillator(); s.type = 'sawtooth'; s.frequency.setValueAtTime(58, t); s.frequency.linearRampToValueAtTime(74, t + d * .5); s.frequency.linearRampToValueAtTime(52, t + d); const r = F(c, 'bandpass', 640, 14), g = G(c, 0); r.frequency.setValueAtTime(420, t); r.frequency.linearRampToValueAtTime(980, t + d); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.8, t + .25); g.gain.linearRampToValueAtTime(.001, t + d); s.connect(r).connect(g).connect(o); s.start(t); s.stop(t + d + .02); },\n  move(c, o, t) { INST.wood(c, o, t, 76, .1, .5); }, ok(c, o, t) { INST.wood(c, o, t, 84, .1, .7); INST.wood(c, o, t + .06, 91, .1, .55); }, back(c, o, t) { INST.wood(c, o, t, 72, .1, .6); INST.wood(c, o, t + .06, 65, .1, .5); },\n  stamp(c, o, t) { tone(c, o, t, 'sine', 140, 40, .18, 1); burst(c, o, t, 800, 1, .7, .05); },\n  drum(c, o, t, p = {}) { const d = p.dur || 2.2; for (let i = 0, q = t; q < t + d; i++, q += Math.max(.05, .1 - i * .002)) INST.snare(c, o, q, 0, .06, .1 + .35 * (q - t) / d); },\n  foot(c, o, t, p = {}) { tone(c, o, t, 'sine', p.high ? 1500 : 1050, 500, .05, 1); burst(c, o, t, 3200, 3, .6, .018); },\n  tick(c, o, t, p = {}) { tone(c, o, t, 'square', p.high ? 1500 : 1000, 900, .03, .7); },\n  shove(c, o, t) { tone(c, o, t, 'sine', 180, 70, .14, .8); burst(c, o, t, 900, 2, .5, .05); },\n  pump(c, o, t) { tone(c, o, t, 'triangle', 110, 170, .14, .55); },\n  squawk(c, o, t) { const s = c.createOscillator(); s.type = 'sawtooth'; s.frequency.setValueAtTime(980, t); s.frequency.exponentialRampToValueAtTime(520, t + .28); const m = c.createOscillator(); m.frequency.value = 340; const mg = G(c, 500); m.connect(mg).connect(s.frequency); const g = G(c, 0); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(.3, t + .02); g.gain.exponentialRampToValueAtTime(.0001, t + .3); s.connect(g).connect(o); s.start(t); m.start(t); s.stop(t + .32); m.stop(t + .32); },\n  sneeze(c, o, t) { burst(c, o, t, 3000, 1, .8, .22); tone(c, o, t, 'sawtooth', 500, 120, .16, .3); },\n  cheer(c, o, t) { for (let i = 0; i < 12; i++) { const f = 300 + (i * 173) % 500, s = t + i * .03; tone(c, o, s, 'sawtooth', f, f * 1.25, .35, .05); } burst(c, o, t, 2400, .7, .4, .7); },\n};\nexport function playSting(ctx, out, def, t) { for (const [inst, off, m, d] of def) INST[inst](ctx, out, t + off, m, d, .8); return Math.max(...def.map(x => x[1] + x[3])); }\nE\ncat > audio/voice.js <<'E'\n// Animalese-style gibberish, spoken from each line's own text.\nimport { noise } from './instruments.js';\nexport const FORMANTS = { a: [800, 1200], e: [500, 1900], i: [320, 2300], o: [500, 900], u: [350, 700] };\nexport const VOICES = {\n  trudy: { pitch: 420, rate: 16, wave: 'square', gain: .16, fmul: 1.35, breath: 0, drift: 40 },\n  stillwater: { pitch: 170, rate: 7, wave: 'sawtooth', gain: 2.6, fmul: .9, breath: .55, drift: 8, gap: true },\n  bolster: { pitch: 95, rate: 11, wave: 'sawtooth', gain: 1.5, fmul: .8, breath: 0, drift: 12, burst: true },\n  margaret: { pitch: 300, rate: 12, wave: 'square', gain: .55, fmul: 1.1, breath: .1, drift: 22 },\n  kevin: { pitch: 200, rate: 12, wave: 'sawtooth', gain: .9, fmul: .9, breath: 0, drift: 12 },\n  sandra: { pitch: 260, rate: 12, wave: 'square', gain: .55, fmul: 1, breath: 0, drift: 10 },\n  paul: { pitch: 230, rate: 12, wave: 'sawtooth', gain: .9, fmul: 1, breath: 0, drift: 50 },\n  gerald: { pitch: 320, rate: 12, wave: 'square', gain: .55, fmul: 1.05, breath: .2, drift: 30 },\n};\nexport const EXCLAIM = ['Wobba-la!', 'Oof-ah.', 'Nee nee!', 'Sulla bip?', 'Dag-a-doo.'];\nconst hash = (s) => { let h = 7; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h; };\n/** Schedules a line. Returns [duration, blipCount]. */\nexport function speakLine(ctx, out, who, text, t0) {\n  const V = VOICES[who] || VOICES.kevin; let r = hash(text); const rnd = () => { r = (r * 1664525 + 1013904223) >>> 0; return r / 4294967296; };\n  const bus = ctx.createGain(); bus.gain.value = V.gain; bus.connect(out);\n  const step = 1 / V.rate; let t = t0, blips = 0; const words = text.split(/\\s+/);\n  words.forEach((w, wi) => {\n    const clean = w.toLowerCase().replace(/[^a-z!?.,]/g, '');\n    const isQ = clean.endsWith('?'), isX = clean.endsWith('!'), isEnd = /[.!?]$/.test(clean);\n    const letters = clean.replace(/[^a-z]/g, ''); let vowelSeen = false;\n    for (let i = 0; i < letters.length; i++) {\n      const ch = letters[i], vowel = 'aeiou'.includes(ch);\n      if (!vowel && !(i === letters.length - 1 && !vowelSeen)) { if (i % 2 === 0) { const n = noise(ctx, t, .02), g = ctx.createGain(); g.gain.setValueAtTime(.05 * V.gain, t); g.gain.exponentialRampToValueAtTime(.0001, t + .012); n.connect(g).connect(out); t += step * .35; } continue; }\n      vowelSeen = true;\n      const f = FORMANTS[vowel ? ch : 'e']; let p = V.pitch * (1 + (rnd() - .5) * V.drift / V.pitch);\n      const last = i >= letters.length - 2;\n      if (isQ && last) p *= 1.34; else if (isX && last) p *= 1.5; else if (isEnd && last) p *= .8;\n      const o = ctx.createOscillator(); o.type = V.wave; o.frequency.setValueAtTime(p, t);\n      const g = ctx.createGain(); g.gain.setValueAtTime(.001, t); g.gain.linearRampToValueAtTime(1, t + .008); g.gain.exponentialRampToValueAtTime(.001, t + .06);\n      const b1 = ctx.createBiquadFilter(); b1.type = 'bandpass'; b1.frequency.value = f[0] * V.fmul; b1.Q.value = 5;\n      const b2 = ctx.createBiquadFilter(); b2.type = 'bandpass'; b2.frequency.value = f[1] * V.fmul; b2.Q.value = 7;\n      o.connect(b1).connect(g); o.connect(b2).connect(g); g.connect(bus); o.start(t); o.stop(t + .07);\n      if (V.breath) { const n = noise(ctx, t, .07), ng = ctx.createGain(), bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f[1]; bp.Q.value = 2; ng.gain.setValueAtTime(.04 * V.breath, t); ng.gain.exponentialRampToValueAtTime(.0005, t + .06); n.connect(bp).connect(ng).connect(g); }\n      blips++; t += step;\n    }\n    t += step * (isEnd ? (V.gap ? 4 : 2.4) : (V.burst && wi % 4 === 3 ? 1.6 : .55));\n  });\n  return [t - t0, blips];\n}\nE\ncat > audio/engine.js <<'E'\nimport { makeImpulse, INST } from './instruments.js';\nimport { Sequencer, scheduleStep } from './sequencer.js';\nimport { TRACKS, STINGS } from './tracks.js';\nimport { SFX, playSting } from './sfx.js';\nimport { speakLine } from './voice.js';\nexport class AudioEngine {\n  constructor() {\n    this.ctx = null; this.settings = { music: 10, sfx: 80, voice: 80 }; this.tiltDeg = 9; this.seq = new Sequencer(this); this.stopped = false; this.levels = { music: 0, sfx: 0, voice: 0 };\n    this.detuneAt = (t) => this.tiltDeg * 1.6 * Math.sin(t * .7);\n    const AC = window.AudioContext || window.webkitAudioContext;\n    if (AC) { try { this.ctx = new AC(); this.build(this.ctx); this.timer = setInterval(() => this.seq.tick(), 25); } catch { this.ctx = null; } }\n  }\n  build(ctx) {\n    this.master = ctx.createDynamicsCompressor(); this.master.threshold.value = -10; this.master.ratio.value = 6; this.master.connect(ctx.destination);\n    this.music = ctx.createGain(); this.sfxBus = ctx.createGain(); this.voice = ctx.createGain();\n    this.music.connect(this.master); this.sfxBus.connect(this.master); this.voice.connect(this.master);\n    this.reverbSend = ctx.createGain(); const dry = ctx.createGain(); dry.gain.value = .86; const wet = ctx.createGain(); wet.gain.value = .22; const conv = ctx.createConvolver(); conv.buffer = makeImpulse(ctx);\n    this.reverbSend.connect(dry).connect(this.music); this.reverbSend.connect(conv).connect(wet).connect(this.music);\n    this.an = {}; for (const b of ['music', 'sfxBus', 'voice']) { const a = ctx.createAnalyser(); a.fftSize = 1024; this[b].connect(a); this.an[b] = a; }\n    this.applyVolumes();\n  }\n  applyVolumes() { if (!this.ctx) return; this.music.gain.value = this.settings.music / 100; this.sfxBus.gain.value = this.settings.sfx / 100; this.voice.gain.value = this.settings.voice / 100; }\n  setVolume(k, v) { this.settings[k] = v; this.applyVolumes(); }\n  resume() { if (this.ctx && this.ctx.state === 'suspended' && !this.stopped) { const p = this.ctx.resume(); if (p && p.catch) p.catch(() => {}); } }\n  get running() { return !!this.ctx && this.ctx.state === 'running'; }\n  now() { return this.ctx ? this.ctx.currentTime : 0; }\n  playTrack(name, o) { if (this.stopped) return; this.seq.play(name, o); }\n  stopTrack(fade) { this.seq.stop(fade); }\n  sfx(name, p) { if (!this.running || this.stopped) return; const f = SFX[name]; if (f) f(this.ctx, this.sfxBus, this.ctx.currentTime + .002, p); }\n  sting(name) { if (!this.running || this.stopped) return; const d = STINGS[name]; if (d) playSting(this.ctx, this.sfxBus, d, this.ctx.currentTime + .01); }\n  speak(who, text) { if (!this.running || this.stopped) return 0; if (!this.voiceGate) this.newVoiceGate(); return speakLine(this.ctx, this.voiceGate, who, text, this.ctx.currentTime + .02)[0]; }\n  newVoiceGate() { this.voiceGate = this.ctx.createGain(); this.voiceGate.connect(this.voice); }\n  hushVoice() { if (this.voiceGate) { const g = this.voiceGate; g.gain.setTargetAtTime(0, this.ctx.currentTime, .02); this.voiceGate = null; setTimeout(() => { try { g.disconnect(); } catch { /* already gone */ } }, 500); } }\n  level(bus) { const a = this.an?.[bus]; if (!a) return 0; const d = new Float32Array(a.fftSize); a.getFloatTimeDomainData(d); let s = 0; for (const v of d) s += v * v; return Math.sqrt(s / d.length); }\n  /** Session end: stop all sound. */\n  silence() { this.stopped = true; this.seq.stop(.05); if (this.timer) clearInterval(this.timer); if (this.ctx) { try { this.ctx.suspend(); } catch { /* already closed */ } } }\n}\n/** Offline render for tests. kind: track | sting | sfx | voice | click */\nexport async function renderOffline(kind, name, seconds = 4, opts = {}) {\n  const sr = 22050, ctx = new OfflineAudioContext(2, Math.floor(sr * seconds), sr);\n  const comp = ctx.createDynamicsCompressor(); comp.connect(ctx.destination); const out = ctx.createGain(); out.gain.value = opts.gain ?? 1; out.connect(comp);\n  let blips = 0;\n  if (kind === 'track') { const tr = TRACKS[name]; const s16 = 15 / tr.bpm; const det = () => 0; let st = 0; for (let t = .01; t < seconds; t += s16) { scheduleStep(ctx, out, tr, st++, t + (st % 2 === 0 ? s16 * tr.swing : 0), det); } }\n  else if (kind === 'sting') playSting(ctx, out, STINGS[name], .01);\n  else if (kind === 'sfx') SFX[name](ctx, out, .01, opts.params);\n  else if (kind === 'voice') { const r = speakLine(ctx, out, name, opts.text || 'Please step on. Not on me. On the island!', .01); blips = r[1]; }\n  else if (kind === 'inst') INST[name](ctx, out, .01, 60, .5, .7);\n  const buf = await ctx.startRendering(); const d = buf.getChannelData(0); let s = 0, peak = 0, bad = false;\n  for (const v of d) { if (!Number.isFinite(v)) bad = true; s += v * v; peak = Math.max(peak, Math.abs(v)); }\n  return { rms: Math.sqrt(s / d.length), peak, finite: !bad, blips };\n}\nE\ncd .. && cat > tools/build.mjs <<'E'\nimport { build } from 'esbuild'; import { readFileSync, writeFileSync, existsSync } from 'node:fs'; import { createHash } from 'node:crypto'; import { dirname, join } from 'node:path'; import { fileURLToPath } from 'node:url';\nconst here = dirname(dirname(fileURLToPath(import.meta.url))); process.chdir(here);\nconst NAME = here.split('/').pop(); const OUT = join(here, '..', `${NAME}.html`); const EXIT = join(here, '..', 'exit-interview.json');\nconst session = readFileSync('vendor/session.js', 'utf8').replace(/\\r\\n/g, '\\n');\nconst END = \"})(typeof window !== 'undefined' ? window : globalThis);\";\nconst hash = createHash('sha256').update(session.slice(session.indexOf('/*! aihub-session '), session.indexOf(END) + END.length)).digest('hex');\nif (hash !== '529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a') throw new Error('not the released hub client');\n// One source of truth: the exit-interview file feeds the About screen.\nconst exit = existsSync(EXIT) ? readFileSync(EXIT, 'utf8') : 'null'; JSON.parse(exit);\nwriteFileSync('src/data/about.js', `// Written by tools/build.mjs from exit-interview.json.\\nexport const EXIT = ${exit.trim()};\\nexport const SOURCE = 'Wii Fit';\\n`);\nconst title = /TITLE = '([^']+)'/.exec(readFileSync('src/data/config.js', 'utf8'))[1];\nconst r = await build({ entryPoints: ['src/main.js'], bundle: true, format: 'iife', target: 'es2022', minify: true, write: false, legalComments: 'none', loader: { '.css': 'text' }, logLevel: 'warning', keepNames: false });\nconst js = r.outputFiles[0].text.replace(/<\\/script/gi, '<\\\\/script');\nconst font = (w) => readFileSync(`node_modules/@fontsource/fredoka/files/fredoka-latin-${w}-normal.woff2`).toString('base64');\nconst face = (w) => `@font-face{font-family:Fredoka;font-weight:${w};font-display:swap;src:url(data:font/woff2;base64,${font(w)}) format(\"woff2\")}`;\nconst metas = [['hub:session', '1'], ['hub:session-players', '1-4'], ['hub:session-mode', 'ghost'], ['hub:session-minutes', '3'], ['hub:session-goal', 'Stay balanced through the class: highest score wins'], ['hub:session-howto', 'Lean: stick, WASD or mouse. Feet: L2 R2, Q E or clicks. Flail: Square or F'], ['hub:type', 'Game'], ['hub:players', '1-4'], ['hub:source', 'Wii Fit']].map(([n, c]) => `<meta name=\"${n}\" content=\"${c}\">`).join('');\nwriteFileSync(OUT, ['<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>', session, '</script>', metas, `<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>${title}</title><style>`, face(500), face(600), face(700), '</style></head><body>', '<script>', js, '</script></body></html>'].join(''));\nconsole.log(`built ${(js.length / 1e6).toFixed(2)} MB`);\nE\necho ok","description":"Write audio engine, tracks, sfx, voices and the build tool"}}}
