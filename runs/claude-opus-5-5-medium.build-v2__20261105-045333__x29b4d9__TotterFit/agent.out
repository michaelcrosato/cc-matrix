iveShadow = false; out.add(c);\n  });\n  return out;\n}\nexport const at = (m, x, y, z)\"\"\")\nsub('src/art/materials.js',\"import * as THREE from 'three/webgpu';\",\"import * as THREE from 'three/webgpu';\\nimport { positionLocal, normalLocal } from 'three/tsl';\")\ns=open('src/art/island.js').read()\nold=\"put = (o, k, dx = 0, dz = 0) => { o.position.x = L[k].x + dx; o.position.z = L[k].z + dz; W.add(o); return o; };\"\nassert old in s\ns=s.replace(old,\"put = (o, k, dx = 0, dz = 0) => { o.position.x = L[k].x + dx; o.position.z = L[k].z + dz; W.add(o); (this.lmParts[k] ||= []).push(o); return o; };\")\ns=s.replace(\"  buildLandmarks() {\\n\",\"  buildLandmarks() {\\n    this.lmParts = { jar: [] }; this.outlines = {};\\n\")\ns=s.replace(\"  setRest(deg) { this.restDeg = deg; }\",\"\"\"  /** Thick outline on one landmark, built the first time it is hovered. */\n  setOutline(id) {\n    if (this.outlineId === id) return; if (this.outlineId && this.outlines[this.outlineId]) this.outlines[this.outlineId].visible = false; this.outlineId = id; if (!id) return;\n    if (!this.outlines[id]) { const parts = id === 'jar' ? [this.jarGroup] : (this.lmParts[id] || []); const g = new THREE.Group(); for (const p of parts) { const o = outlineOf(p); p.getWorldPosition(new THREE.Vector3()); o.position.copy(p.position); o.quaternion.copy(p.quaternion); o.scale.copy(p.scale); g.add(o); } this.world.add(g); this.outlines[id] = g; }\n    this.outlines[id].visible = true;\n  }\n  setRest(deg) { this.restDeg = deg; }\"\"\")\ns=s.replace(\"import { sphere, cyl, cone, box, torus, at, capsule, toon, glass, flat, mesh, cached } from './materials.js';\",\"import { sphere, cyl, cone, box, torus, at, capsule, toon, glass, flat, mesh, cached, outlineOf } from './materials.js';\")\nopen('src/art/island.js','w').write(s)\ns=open('src/game/hub.js').read()\nold=\"this.ring.scale.setScalar((show.r || 2) / 1.4 * (1 + Math.sin(performance.now() * .006) * .04)); } else { this.label.style.display = 'none'