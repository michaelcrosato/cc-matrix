{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjjpVbumyTsNHuFz7KFJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WyQ1rfVTmn5qeVYPsNujUw","name":"Bash","input":{"command":"cd src\ncat > data/config.js <<'E'\n// The one place the game's title lives. Nothing in the fiction depends on it.\nexport const TITLE = 'Totter Fit';\nexport const TAGLINE = 'Lean a little. Straighten an island.';\nexport const RESORT = 'Level Best Retreat';\nexport const SAVE_KEY = 'totterfit.save';\nexport const SAVE_VERSION = 3;\nexport const SEATS = ['#E8443A', '#3B82F6', '#22C55E', '#F5B700'];\nexport const INK = '#1A1420';\nE\ncat > core/rng.js <<'E'\n// The only file allowed to touch randomness.\nconst streams = new Map();\nfunction hashLabel(s) { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }\nexport function mulberry32(a) {\n  return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };\n}\nlet baseSeed = 12345;\nexport function setSeed(s) { baseSeed = s >>> 0; streams.clear(); }\nexport function freshSeed() { return (Date.now() ^ (performance.now() * 1000)) >>> 0; }\n/** A gameplay stream. In a session it comes from the hub so all copies agree. */\nexport function rng(label) {\n  const hub = globalThis.AIHub;\n  if (hub && hub.active && hub.rng) { try { return hub.rng(label); } catch { /* falls through before connect */ } }\n  if (!streams.has(label)) streams.set(label, mulberry32(baseSeed ^ hashLabel(label)));\n  return streams.get(label);\n}\n/** A repeatable stream that doesn't advance a shared one: same label+n gives same numbers. */\nexport function seeded(label, n = 0) { return mulberry32((baseSeed + n * 7919) ^ hashLabel(label)); }\nconst cos = mulberry32(freshSeed());\n/** Looks only. Never affects the game. */\nexport const cosmetic = () => cos();\nexport const cosRange = (a, b) => a + (b - a) * cos();\nexport const pick = (arr, r = cos) => arr[Math.floor(r() * arr.length) % arr.length];\nexport const range = (r, a, b) => a + (b - a) * r();\nE\ncat > core/script.js <<'E'\n// Generator scripts on sim time. yield seconds | yield () => bool | yield generator.\nexport class Scripts {\n  constructor() { this.list = []; this.after = []; this.time = 0; }\n  run(gen, tag) { const s = { stack: [gen], wait: 0, until: null, tag }; this.list.push(s); return s; }\n  killTag(tag) { this.list = this.list.filter(s => s.tag !== tag); }\n  kill(s) { const i = this.list.indexOf(s); if (i >= 0) this.list.splice(i, 1); }\n  clear() { this.list.length = 0; this.after.length = 0; }\n  later(sec, fn) { this.after.push({ at: this.time + sec, fn }); }\n  tick(dt) {\n    this.time += dt;\n    for (let i = this.after.length - 1; i >= 0; i--) if (this.after[i].at <= this.time) { const a = this.after[i]; this.after.splice(i, 1); a.fn(); }\n    for (const s of [...this.list]) this.step(s, dt);\n  }\n  step(s, dt) {\n    if (s.wait > 0) { s.wait -= dt; if (s.wait > 0) return; s.wait = 0; }\n    if (s.until) { if (!s.until()) return; s.until = null; }\n    for (let guard = 0; guard < 64; guard++) {\n      const top = s.stack[s.stack.length - 1];\n      if (!top) { this.kill(s); return; }\n      const r = top.next();\n      if (!this.list.includes(s)) return;\n      if (r.done) { s.stack.pop(); continue; }\n      const v = r.value;\n      if (typeof v === 'number') { if (v > 0) { s.wait = v; return; } continue; }\n      if (typeof v === 'function') { if (v()) continue; s.until = v; return; }\n      if (v && typeof v.next === 'function') { s.stack.push(v); continue; }\n      return; // a bare yield waits one tick\n    }\n  }\n}\nE\ncat > core/save.js <<'E'\nimport { SAVE_KEY, SAVE_VERSION } from '../data/config.js';\nconst blank = () => ({ v: SAVE_VERSION, profiles: [null, null, null, null], current: -1, settings: {} });\nlet mem = null, storageOk = true;\nexport function parseSave(text) {\n  try {\n    const d = JSON.parse(text);\n    if (!d || typeof d !== 'object' || d.v !== SAVE_VERSION || !Array.isArray(d.profiles)) return blank();\n    d.settings = d.settings && typeof d.settings === 'object' ? d.settings : {};\n    while (d.profiles.length < 4) d.profiles.push(null);\n    return d;\n  } catch { return blank(); }\n}\nexport function loadSave() {\n  if (mem) return mem;\n  let text = null;\n  try { text = localStorage.getItem(SAVE_KEY); } catch { storageOk = false; }\n  mem = text ? parseSave(text) : blank();\n  return mem;\n}\nexport function writeSave() {\n  if (!mem) return;\n  try { localStorage.setItem(SAVE_KEY, JSON.stringify(mem)); } catch { storageOk = false; }\n}\nexport function wipeSave() { mem = blank(); try { localStorage.removeItem(SAVE_KEY); } catch { storageOk = false; } return mem; }\nexport const storageAvailable = () => storageOk;\nexport const blankSave = blank;\nE\ncat > data/tuning.js <<'E'\n// Every entry is a live slider in Dev Mode. The whole game reads these through T.\nexport const TUNING = {\n  maxLean:      { group: 'Balance', label: 'Max lean (deg)', min: 6, max: 30, step: 1, default: 18 },\n  margin:       { group: 'Balance', label: 'Stiffness margin', min: .1, max: 1.5, step: .05, default: .45 },\n  zeta:         { group: 'Balance', label: 'Damping', min: .1, max: 1.2, step: .05, default: .4 },\n  ankleMax:     { group: 'Balance', label: 'Ankle strength', min: 2, max: 10, step: .1, default: 4.6 },\n  fallAngle:    { group: 'Balance', label: 'Fall angle (deg)', min: 25, max: 75, step: 1, default: 45 },\n  reflex:       { group: 'Balance', label: 'Reflex', min: 2, max: 20, step: .5, default: 10 },\n  flailBoost:   { group: 'Balance', label: 'Flail boost', min: 1, max: 3, step: .1, default: 1.9 },\n  flailCooldown:{ group: 'Balance', label: 'Flail cooldown', min: .2, max: 6, step: .1, default: 2 },\n  swayScale:    { group: 'Balance', label: 'Sway scale', min: 0, max: 3, step: .05, default: 1 },\n  tremorScale:  { group: 'Balance', label: 'Tremor scale', min: 0, max: 3, step: .05, default: 1 },\n  recoverTime:  { group: 'Balance', label: 'Recover time', min: .5, max: 6, step: .1, default: 2.2 },\n  gravity:      { group: 'World', label: 'Gravity', min: 2, max: 20, step: .1, default: 9.81 },\n  islandWeight: { group: 'World', label: 'Island weight (deg at rim)', min: 0, max: 12, step: .5, default: 4 },\n  restTiltAdd:  { group: 'World', label: 'Rest tilt offset (deg)', min: -9, max: 9, step: .5, default: 0 },\n  islandSpring: { group: 'World', label: 'Island spring', min: .5, max: 8, step: .1, default: 2.2 },\n  walkSpeed:    { group: 'World', label: 'Walk speed', min: 1, max: 9, step: .1, default: 4 },\n  fruitMass:    { group: 'Events', label: 'Fruit mass scale', min: .3, max: 3, step: .05, default: 1 },\n  fruitInterval:{ group: 'Events', label: 'Fruit interval scale', min: .3, max: 3, step: .05, default: 1 },\n  landingRadius:{ group: 'Events', label: 'Landing radius scale', min: .3, max: 2, step: .05, default: 1 },\n  stoneMass:    { group: 'Events', label: 'Stone mass scale', min: .3, max: 3, step: .05, default: 1 },\n  stoneInterval:{ group: 'Events', label: 'Stone interval scale', min: .3, max: 3, step: .05, default: 1 },\n  ringEnd:      { group: 'Events', label: 'Ring size at end scale', min: .4, max: 2, step: .05, default: 1 },\n  gustForce:    { group: 'Events', label: 'Gust force scale', min: 0, max: 2, step: .05, default: 1 },\n  plateDecay:   { group: 'Events', label: 'Plate decay scale', min: .2, max: 3, step: .05, default: 1 },\n  plateGain:    { group: 'Events', label: 'Plate gain scale', min: .2, max: 3, step: .05, default: 1 },\n  rhythmWindow: { group: 'Events', label: 'Rhythm window scale', min: .4, max: 2, step: .05, default: 1 },\n  repTempo:     { group: 'Events', label: 'Rep tempo scale', min: .5, max: 2, step: .05, default: 1 },\n  boardGain:    { group: 'Events', label: 'Board gain', min: 2, max: 16, step: .5, default: 8 },\n  airTorque:    { group: 'Events', label: 'Air spin (rad/s)', min: 1, max: 7, step: .1, default: 3.4 },\n  marblesPerMin:{ group: 'Rewards', label: 'Marbles per minute', min: 0, max: 6, step: .5, default: 2 },\n  medalScale:   { group: 'Rewards', label: 'Medal scale', min: .5, max: 1.5, step: .05, default: 1 },\n  inkHull:      { group: 'Ink', label: 'Hull', min: 0, max: .008, step: .0002, default: .0028 },\n  inkWidth:     { group: 'Ink', label: 'Line width', min: 0, max: 4, step: .1, default: 1.4 },\n  inkBoil:      { group: 'Ink', label: 'Boil', min: 0, max: 1.5, step: .05, default: .5 },\n  inkGrain:     { group: 'Ink', label: 'Grain', min: 0, max: .08, step: .005, default: .02 },\n};\nE\ncat > core/tuning.js <<'E'\nimport { TUNING } from '../data/tuning.js';\nexport const T = {};\nexport function resetTuning() { for (const k in TUNING) T[k] = TUNING[k].default; }\nresetTuning();\nexport const tuningGroups = () => { const g = {}; for (const k in TUNING) (g[TUNING[k].group] ||= []).push(k); return g; };\nexport const tuningJSON = () => JSON.stringify(T, null, 1);\nE\ncat > core/loop.js <<'E'\n// Fixed 1/120 s simulation. Real time is capped at 0.25 s a frame, which keeps the\n// game on real time down to 4 fps.\nexport const FIXED = 1 / 120;\nexport class Loop {\n  constructor(game) { this.game = game; this.acc = 0; this.timeScale = 1; this.last = 0; this.running = false; this.singleStep = false; this.paused = false; }\n  start() { this.running = true; this.last = performance.now(); const f = () => { if (!this.running) return; requestAnimationFrame(f); const n = performance.now(); this.frame((n - this.last) / 1000); this.last = n; }; requestAnimationFrame(f); }\n  frame(real) {\n    const r = Math.min(real, .25);\n    if (!this.paused) this.acc += r * this.timeScale;\n    else if (this.singleStep) { this.acc += FIXED; this.singleStep = false; }\n    let n = 0;\n    while (this.acc >= FIXED && n < 30 * Math.max(1, Math.ceil(this.timeScale))) { this.game.fixed(FIXED); this.acc -= FIXED; n++; }\n    if (this.acc > FIXED * 4) this.acc = 0;\n    this.game.frame(r);\n    this.game.draw();\n  }\n  /** Tests: run sim time without rendering or waiting. */\n  advance(sec) { const n = Math.round(sec / FIXED); for (let i = 0; i < n; i++) { this.game.fixed(FIXED); if (i % 2 === 1) this.game.frame(FIXED * 2); } }\n}\nE\ncat > physics/world.js <<'E'\nimport RAPIER from '@dimforge/rapier3d-compat';\nexport { RAPIER };\nexport const GROUND = 0x0001, RAGDOLL = 0x1000;\nexport const PROP = (l) => 0x0010 << l, DOLL = (l) => 0x0100 << l;\nexport const groups = (m, f) => ((m & 0xffff) << 16) | (f & 0xffff);\nexport const G_GROUND = groups(GROUND, 0xffff);\nexport const G_DOLL = (l) => groups(DOLL(l), PROP(l));\nexport const G_PROP = (l) => groups(PROP(l), DOLL(l) | PROP(l) | GROUND);\nexport const G_RAGDOLL = groups(RAGDOLL, GROUND);\nlet live = 0;\nexport const liveWorlds = () => live;\nexport function makeWorld({ gravity = 9.81, iterations = 8 } = {}) {\n  const world = new RAPIER.World({ x: 0, y: -gravity, z: 0 });\n  world.timestep = 1 / 120;\n  world.integrationParameters.numSolverIterations = iterations;\n  live++;\n  const free = world.free.bind(world);\n  world.free = () => { live--; free(); };\n  return world;\n}\nexport function addGroundPlane(world, y = 0, half = 80, friction = .8) {\n  const b = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, y - .5, 0));\n  world.createCollider(RAPIER.ColliderDesc.cuboid(half, .5, half).setFriction(friction).setCollisionGroups(G_GROUND), b);\n  return b;\n}\nE\ncat > physics/balancer.js <<'E'\n// The balance core: one dynamic body on a ball joint at the foot. Everything that stands uses it.\nimport { RAPIER, G_DOLL } from './world.js';\nimport { T } from '../core/tuning.js';\nconst rad = (d) => d * Math.PI / 180;\nexport class Balancer {\n  constructor(world, lane, fx, fy, fz, opts = {}) {\n    this.world = world; this.lane = lane; this.opts = opts;\n    this.fx = fx; this.fy = fy; this.fz = fz;\n    this.foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(fx, fy, fz));\n    this.body = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(fx, fy + .75, fz).setCanSleep(false).setAdditionalSolverIterations(4));\n    this.collider = world.createCollider(RAPIER.ColliderDesc.capsule(.5, .25).setMass(1).setCollisionGroups(G_DOLL(lane)), this.body);\n    this.makeJoint();\n    this.wx = 0; this.wz = 0; this.leanX = 0; this.leanZ = 0; this.nx = 0; this.nz = 0;\n    this.flailLeft = 0; this.flailCool = 0; this.enabled = true; this.free = false;\n    this.mods = { ankle: 1, margin: null, zeta: null, reflex: null, maxLean: null };\n    this.t = 0;\n  }\n  makeJoint() {\n    this.joint = this.world.createImpulseJoint(RAPIER.JointData.spherical({ x: 0, y: 0, z: 0 }, { x: 0, y: -.75, z: 0 }), this.foot, this.body, true);\n    this.joint.setContactsEnabled(false);\n  }\n  maxLeanRad() { return rad(this.opts.maxLean ?? T.maxLean); }\n  margin() { return this.mods.margin ?? this.opts.margin ?? T.margin; }\n  ankle() { return (this.opts.ankleMax ?? T.ankleMax) * this.mods.ankle; }\n  /** Call before world.step(). wish is on the unit disc, in world x/z. */\n  step(dt, wishX, wishZ) {\n    this.t += dt;\n    if (this.flailLeft > 0) this.flailLeft -= dt;\n    if (this.flailCool > 0) this.flailCool -= dt;\n    if (!this.enabled || this.free) { this.readLean(); return; }\n    const G = T.gravity * .75, I = .75 * .75 + .06;\n    const margin = this.margin();\n    const K = G * (1 + margin), wn = Math.sqrt(Math.max(.01, K - G) / I);\n    const zeta = this.mods.zeta ?? this.opts.zeta ?? T.zeta;\n    const D = 2 * zeta * wn * I;\n    const reflex = this.mods.reflex ?? this.opts.reflex ?? T.reflex;\n    const r = 1 - Math.exp(-reflex * dt);\n    this.wx += (wishX - this.wx) * r; this.wz += (wishZ - this.wz) * r;\n    const maxLean = this.maxLeanRad();\n    const tx = this.wx * maxLean, tz = this.wz * maxLean;\n    this.readLean();\n    const w = this.body.angvel();\n    let Tx = -(G * Math.sin(tx) + K * (this.leanX - tx)) + D * w.z;\n    let Tz = -(G * Math.sin(tz) + K * (this.leanZ - tz)) - D * w.x;\n    const limit = this.ankle() * (this.flailLeft > 0 ? T.flailBoost : 1);\n    const m = Math.hypot(Tx, Tz); if (m > limit) { Tx *= limit / m; Tz *= limit / m; }\n    this.body.resetTorques(true);\n    this.body.addTorque({ x: Tz + this.nz, y: -w.y * .6, z: -(Tx + this.nx) }, true);\n  }\n  readLean() {\n    const q = this.body.rotation();\n    const ux = 2 * (q.x * q.y - q.w * q.z), uy = 1 - 2 * (q.x * q.x + q.z * q.z), uz = 2 * (q.y * q.z + q.w * q.x);\n    this.leanX = Math.atan2(ux, uy); this.leanZ = Math.atan2(uz, uy);\n    this.angle = Math.atan2(Math.hypot(ux, uz), uy);\n  }\n  get cobX() { return this.leanX / this.maxLeanRad(); }\n  get cobZ() { return this.leanZ / this.maxLeanRad(); }\n  flail() { if (this.flailCool > 0) return false; this.flailLeft = .35; this.flailCool = T.flailCooldown; return true; }\n  moveFoot(x, y, z) { this.fx = x; this.fy = y; this.fz = z; this.foot.setNextKinematicTranslation({ x, y, z }); }\n  /** Reset to upright, including the cached lean: a stale lean falls again at once, for ever. */\n  reset() {\n    this.body.setTranslation({ x: this.fx, y: this.fy + .75, z: this.fz }, true);\n    this.body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true);\n    this.body.setLinvel({ x: 0, y: 0, z: 0 }, true); this.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n    this.body.resetTorques(true);\n    this.leanX = 0; this.leanZ = 0; this.angle = 0; this.wx = 0; this.wz = 0;\n  }\n  setEnabled(on) { this.enabled = on; this.body.setEnabled(on); this.collider.setEnabled(on); }\n  /** Springboard: free flight. Removes the foot joint. */\n  release() { if (this.joint) { this.world.removeImpulseJoint(this.joint, true); this.joint = null; } this.free = true; }\n  reattach() { this.free = false; this.reset(); this.makeJoint(); }\n}\nE\ncat > physics/ragdoll.js <<'E'\n// Ragdoll from the rig: one body per segment, built at the segment's world transform.\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, G_RAGDOLL } from './world.js';\nconst SEG = [\n  // joint, kind parent, hh, r, mass, collider offset y\n  ['hips', null, .2, .22, .45, .28],\n  ['head', 'hips', .02, .2, .15, .22],\n  ['shoulderL', 'hips', .1, .07, .05, -.16],\n  ['elbowL', 'shoulderL', .1, .07, .04, -.14],\n  ['shoulderR', 'hips', .1, .07, .05, -.16],\n  ['elbowR', 'shoulderR', .1, .07, .04, -.14],\n  ['hipL', 'hips', .13, .09, .08, -.12],\n  ['kneeL', 'hipL', .13, .08, .06, -.14],\n  ['hipR', 'hips', .13, .09, .08, -.12],\n  ['kneeR', 'hipR', .13, .08, .06, -.14],\n];\nconst v = new THREE.Vector3(), q = new THREE.Quaternion(), v2 = new THREE.Vector3(), q2 = new THREE.Quaternion();\nexport class Ragdoll {\n  constructor(world, doll, parentGroup, vel = { x: 0, y: 0, z: 0 }, kick = { x: 0, y: 0, z: 0 }) {\n    this.world = world; this.doll = doll; this.parent = parentGroup; this.parts = []; this.joints = [];\n    doll.group.updateWorldMatrix(true, true);\n    const P = parentGroup; P.updateWorldMatrix(true, false);\n    const invP = new THREE.Matrix4().copy(P.matrixWorld).invert();\n    const m = new THREE.Matrix4(), s = new THREE.Vector3();\n    const byName = {};\n    const worlds = {};\n    for (const [name] of SEG) { const j = doll.joints[name]; m.multiplyMatrices(invP, j.matrixWorld); const p = new THREE.Vector3(), r = new THREE.Quaternion(); m.decompose(p, r, s); worlds[name] = { p, r }; }\n    for (const [name, par, hh, rad, mass, off] of SEG) {\n      const j = doll.joints[name], w = worlds[name];\n      const body = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(w.p.x, w.p.y, w.p.z).setRotation({ x: w.r.x, y: w.r.y, z: w.r.z, w: w.r.w })\n        .setLinearDamping(.05).setAngularDamping(.6).setLinvel(vel.x, vel.y, vel.z));\n      world.createCollider(RAPIER.ColliderDesc.capsule(hh, rad).setTranslation(0, off, 0).setMass(mass).setFriction(.7).setRestitution(.15).setCollisionGroups(G_RAGDOLL), body);\n      const rec = { name, j, body, homeParent: j.parent, homePos: j.position.clone(), homeQuat: j.quaternion.clone() };\n      this.parts.push(rec); byName[name] = rec;\n      if (par) {\n        const pw = worlds[par];\n        v.copy(w.p).sub(pw.p).applyQuaternion(q.copy(pw.r).invert());\n        const joint = world.createImpulseJoint(RAPIER.JointData.spherical({ x: v.x, y: v.y, z: v.z }, { x: 0, y: 0, z: 0 }), byName[par].body, body, true);\n        joint.setContactsEnabled(false);\n        this.joints.push(joint);\n      }\n    }\n    byName.head.body.applyImpulse(kick, true);\n    for (const r of this.parts) parentGroup.attach(r.j);\n    this.head = byName.head;\n    this.t = 0;\n  }\n  sync() {\n    for (const r of this.parts) {\n      const p = r.body.translation(), o = r.body.rotation();\n      r.j.position.set(p.x, p.y, p.z); r.j.quaternion.set(o.x, o.y, o.z, o.w);\n    }\n  }\n  headPos() { return this.parts[0].body.translation(); }\n  remove() {\n    for (let i = this.parts.length - 1; i >= 0; i--) {\n      const r = this.parts[i];\n      r.homeParent.add(r.j); r.j.position.copy(r.homePos); r.j.quaternion.copy(r.homeQuat);\n    }\n    for (const j of this.joints) this.world.removeImpulseJoint(j, true);\n    for (const r of this.parts) this.world.removeRigidBody(r.body);\n    this.parts = []; this.joints = [];\n  }\n}\nE\ncat > physics/island.js <<'E'\n// Do not move the island. Tilt gravity. Rapier sees a fixed flat disc.\nimport { RAPIER, G_GROUND, G_PROP, makeWorld, groups, GROUND } from './world.js';\nimport { T } from '../core/tuning.js';\nconst rad = (d) => d * Math.PI / 180;\nexport class TiltModel {\n  constructor({ K, C, W, clamp = rad(26) }) { this.K = K; this.C = C; this.W = W; this.clamp = clamp; this.tx = 0; this.tz = 0; this.vx = 0; this.vz = 0; this.restX = 0; this.restZ = 0; }\n  step(dt, sumX, sumZ, K = this.K, W = this.W) {\n    this.vx += (K * this.restX + W * sumX - K * this.tx - this.C * this.vx) * dt; this.tx += this.vx * dt;\n    this.vz += (K * this.restZ + W * sumZ - K * this.tz - this.C * this.vz) * dt; this.tz += this.vz * dt;\n    const m = Math.hypot(this.tx, this.tz); if (m > this.clamp) { this.tx *= this.clamp / m; this.tz *= this.clamp / m; }\n  }\n  applyGravity(world, g = T.gravity) { world.gravity = { x: g * Math.sin(this.tx), y: -g * Math.cos(Math.hypot(this.tx, this.tz)), z: g * Math.sin(this.tz) }; }\n  applyGroup(group) {\n    const a = Math.hypot(this.tx, this.tz) || 1e-9, s = Math.sin(a / 2);\n    group.quaternion.set(this.tz / a * s, 0, -this.tx / a * s, Math.cos(a / 2));\n  }\n}\nexport function makeIslandWorld() {\n  const world = makeWorld({ iterations: 6 });\n  const base = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, -.5, 0));\n  world.createCollider(RAPIER.ColliderDesc.cylinder(.5, 22).setFriction(.9).setCollisionGroups(groups(GROUND, 0xffff)), base);\n  const n = 40;\n  for (let i = 0; i < n; i++) {\n    const a = i / n * Math.PI * 2;\n    const b = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(Math.cos(a) * 22.1, 1, Math.sin(a) * 22.1).setRotation({ x: 0, y: Math.sin(-a / 2 + Math.PI / 4 * 0), z: 0, w: Math.cos(-a / 2) }));\n    world.createCollider(RAPIER.ColliderDesc.cuboid(.15, 1, 1.9).setCollisionGroups(groups(GROUND, 0xffff)), b);\n  }\n  return world;\n}\nexport function restWeight() { return T.islandSpring * rad(T.islandWeight) / 22; }\nexport { G_GROUND, G_PROP };\nE\ncd ..; cat >> notes/issues.md <<'E'\n# Issues testing caught (one line each, as they happen)\nE\nsed -i 's/- \\[ \\] M0 skeleton/- [ ] M0 skeleton (core, physics, data started)/' ../PROGRESS.md","description":"Write core, tuning, save, script and physics modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8016,"cache_read_input_tokens":90166,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8016},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"28035a9b-e184-444a-94f5-a859b8026005","timestamp":"2026-11-05T11:59:12.530Z","request_id":"req_011CgjjpVMmdjJoeuX7Di2YL","wire_tool_inputs":{"toolu_01WyQ1rfVTmn5qeVYPsNujUw":{"command":"cd src\ncat > data/config.js <<'E'\n// The one place the game's title lives. Nothing in the fiction depends on it.\nexport const TITLE = 'Totter Fit';\nexport const TAGLINE = 'Lean a little. Straighten an island.';\nexport const RESORT = 'Level Best Retreat';\nexport const SAVE_KEY = 'totterfit.save';\nexport const SAVE_VERSION = 3;\nexport const SEATS = ['#E8443A', '#3B82F6', '#22C55E', '#F5B700'];\nexport const INK = '#1A1420';\nE\ncat > core/rng.js <<'E'\n// The only file allowed to touch randomness.\nconst streams = new Map();\nfunction hashLabel(s) { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }\nexport function mulberry32(a) {\n  return function () { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };\n}\nlet baseSeed = 12345;\nexport function setSeed(s) { baseSeed = s >>> 0; streams.clear(); }\nexport function freshSeed() { return (Date.now() ^ (performance.now() * 1000)) >>> 0; }\n/** A gameplay stream. In a session it comes from the hub so all copies agree. */\nexport function rng(label) {\n  const hub = globalThis.AIHub;\n  if (hub && hub.active && hub.rng) { try { return hub.rng(label); } catch { /* falls through before connect */ } }\n  if (!streams.has(label)) streams.set(label, mulberry32(baseSeed ^ hashLabel(label)));\n  return streams.get(label);\n}\n/** A repeatable stream that doesn't advance a shared one: same label+n gives same numbers. */\nexport function seeded(label, n = 0) { return mulberry32((baseSeed + n * 7919) ^ hashLabel(label)); }\nconst cos = mulberry32(freshSeed());\n/** Looks only. Never affects the game. */\nexport const cosmetic = () => cos();\nexport const cosRange = (a, b) => a + (b - a) * cos();\nexport const pick = (arr, r = cos) => arr[Math.floor(r() * arr.length) % arr.length];\nexport const range = (r, a, b) => a + (b - a) * r();\nE\ncat > core/script.js <<'E'\n// Generator scripts on sim time. yield seconds | yield () => bool | yield generator.\nexport class Scripts {\n  constructor() { this.list = []; this.after = []; this.time = 0; }\n  run(gen, tag) { const s = { stack: [gen], wait: 0, until: null, tag }; this.list.push(s); return s; }\n  killTag(tag) { this.list = this.list.filter(s => s.tag !== tag); }\n  kill(s) { const i = this.list.indexOf(s); if (i >= 0) this.list.splice(i, 1); }\n  clear() { this.list.length = 0; this.after.length = 0; }\n  later(sec, fn) { this.after.push({ at: this.time + sec, fn }); }\n  tick(dt) {\n    this.time += dt;\n    for (let i = this.after.length - 1; i >= 0; i--) if (this.after[i].at <= this.time) { const a = this.after[i]; this.after.splice(i, 1); a.fn(); }\n    for (const s of [...this.list]) this.step(s, dt);\n  }\n  step(s, dt) {\n    if (s.wait > 0) { s.wait -= dt; if (s.wait > 0) return; s.wait = 0; }\n    if (s.until) { if (!s.until()) return; s.until = null; }\n    for (let guard = 0; guard < 64; guard++) {\n      const top = s.stack[s.stack.length - 1];\n      if (!top) { this.kill(s); return; }\n      const r = top.next();\n      if (!this.list.includes(s)) return;\n      if (r.done) { s.stack.pop(); continue; }\n      const v = r.value;\n      if (typeof v === 'number') { if (v > 0) { s.wait = v; return; } continue; }\n      if (typeof v === 'function') { if (v()) continue; s.until = v; return; }\n      if (v && typeof v.next === 'function') { s.stack.push(v); continue; }\n      return; // a bare yield waits one tick\n    }\n  }\n}\nE\ncat > core/save.js <<'E'\nimport { SAVE_KEY, SAVE_VERSION } from '../data/config.js';\nconst blank = () => ({ v: SAVE_VERSION, profiles: [null, null, null, null], current: -1, settings: {} });\nlet mem = null, storageOk = true;\nexport function parseSave(text) {\n  try {\n    const d = JSON.parse(text);\n    if (!d || typeof d !== 'object' || d.v !== SAVE_VERSION || !Array.isArray(d.profiles)) return blank();\n    d.settings = d.settings && typeof d.settings === 'object' ? d.settings : {};\n    while (d.profiles.length < 4) d.profiles.push(null);\n    return d;\n  } catch { return blank(); }\n}\nexport function loadSave() {\n  if (mem) return mem;\n  let text = null;\n  try { text = localStorage.getItem(SAVE_KEY); } catch { storageOk = false; }\n  mem = text ? parseSave(text) : blank();\n  return mem;\n}\nexport function writeSave() {\n  if (!mem) return;\n  try { localStorage.setItem(SAVE_KEY, JSON.stringify(mem)); } catch { storageOk = false; }\n}\nexport function wipeSave() { mem = blank(); try { localStorage.removeItem(SAVE_KEY); } catch { storageOk = false; } return mem; }\nexport const storageAvailable = () => storageOk;\nexport const blankSave = blank;\nE\ncat > data/tuning.js <<'E'\n// Every entry is a live slider in Dev Mode. The whole game reads these through T.\nexport const TUNING = {\n  maxLean:      { group: 'Balance', label: 'Max lean (deg)', min: 6, max: 30, step: 1, default: 18 },\n  margin:       { group: 'Balance', label: 'Stiffness margin', min: .1, max: 1.5, step: .05, default: .45 },\n  zeta:         { group: 'Balance', label: 'Damping', min: .1, max: 1.2, step: .05, default: .4 },\n  ankleMax:     { group: 'Balance', label: 'Ankle strength', min: 2, max: 10, step: .1, default: 4.6 },\n  fallAngle:    { group: 'Balance', label: 'Fall angle (deg)', min: 25, max: 75, step: 1, default: 45 },\n  reflex:       { group: 'Balance', label: 'Reflex', min: 2, max: 20, step: .5, default: 10 },\n  flailBoost:   { group: 'Balance', label: 'Flail boost', min: 1, max: 3, step: .1, default: 1.9 },\n  flailCooldown:{ group: 'Balance', label: 'Flail cooldown', min: .2, max: 6, step: .1, default: 2 },\n  swayScale:    { group: 'Balance', label: 'Sway scale', min: 0, max: 3, step: .05, default: 1 },\n  tremorScale:  { group: 'Balance', label: 'Tremor scale', min: 0, max: 3, step: .05, default: 1 },\n  recoverTime:  { group: 'Balance', label: 'Recover time', min: .5, max: 6, step: .1, default: 2.2 },\n  gravity:      { group: 'World', label: 'Gravity', min: 2, max: 20, step: .1, default: 9.81 },\n  islandWeight: { group: 'World', label: 'Island weight (deg at rim)', min: 0, max: 12, step: .5, default: 4 },\n  restTiltAdd:  { group: 'World', label: 'Rest tilt offset (deg)', min: -9, max: 9, step: .5, default: 0 },\n  islandSpring: { group: 'World', label: 'Island spring', min: .5, max: 8, step: .1, default: 2.2 },\n  walkSpeed:    { group: 'World', label: 'Walk speed', min: 1, max: 9, step: .1, default: 4 },\n  fruitMass:    { group: 'Events', label: 'Fruit mass scale', min: .3, max: 3, step: .05, default: 1 },\n  fruitInterval:{ group: 'Events', label: 'Fruit interval scale', min: .3, max: 3, step: .05, default: 1 },\n  landingRadius:{ group: 'Events', label: 'Landing radius scale', min: .3, max: 2, step: .05, default: 1 },\n  stoneMass:    { group: 'Events', label: 'Stone mass scale', min: .3, max: 3, step: .05, default: 1 },\n  stoneInterval:{ group: 'Events', label: 'Stone interval scale', min: .3, max: 3, step: .05, default: 1 },\n  ringEnd:      { group: 'Events', label: 'Ring size at end scale', min: .4, max: 2, step: .05, default: 1 },\n  gustForce:    { group: 'Events', label: 'Gust force scale', min: 0, max: 2, step: .05, default: 1 },\n  plateDecay:   { group: 'Events', label: 'Plate decay scale', min: .2, max: 3, step: .05, default: 1 },\n  plateGain:    { group: 'Events', label: 'Plate gain scale', min: .2, max: 3, step: .05, default: 1 },\n  rhythmWindow: { group: 'Events', label: 'Rhythm window scale', min: .4, max: 2, step: .05, default: 1 },\n  repTempo:     { group: 'Events', label: 'Rep tempo scale', min: .5, max: 2, step: .05, default: 1 },\n  boardGain:    { group: 'Events', label: 'Board gain', min: 2, max: 16, step: .5, default: 8 },\n  airTorque:    { group: 'Events', label: 'Air spin (rad/s)', min: 1, max: 7, step: .1, default: 3.4 },\n  marblesPerMin:{ group: 'Rewards', label: 'Marbles per minute', min: 0, max: 6, step: .5, default: 2 },\n  medalScale:   { group: 'Rewards', label: 'Medal scale', min: .5, max: 1.5, step: .05, default: 1 },\n  inkHull:      { group: 'Ink', label: 'Hull', min: 0, max: .008, step: .0002, default: .0028 },\n  inkWidth:     { group: 'Ink', label: 'Line width', min: 0, max: 4, step: .1, default: 1.4 },\n  inkBoil:      { group: 'Ink', label: 'Boil', min: 0, max: 1.5, step: .05, default: .5 },\n  inkGrain:     { group: 'Ink', label: 'Grain', min: 0, max: .08, step: .005, default: .02 },\n};\nE\ncat > core/tuning.js <<'E'\nimport { TUNING } from '../data/tuning.js';\nexport const T = {};\nexport function resetTuning() { for (const k in TUNING) T[k] = TUNING[k].default; }\nresetTuning();\nexport const tuningGroups = () => { const g = {}; for (const k in TUNING) (g[TUNING[k].group] ||= []).push(k); return g; };\nexport const tuningJSON = () => JSON.stringify(T, null, 1);\nE\ncat > core/loop.js <<'E'\n// Fixed 1/120 s simulation. Real time is capped at 0.25 s a frame, which keeps the\n// game on real time down to 4 fps.\nexport const FIXED = 1 / 120;\nexport class Loop {\n  constructor(game) { this.game = game; this.acc = 0; this.timeScale = 1; this.last = 0; this.running = false; this.singleStep = false; this.paused = false; }\n  start() { this.running = true; this.last = performance.now(); const f = () => { if (!this.running) return; requestAnimationFrame(f); const n = performance.now(); this.frame((n - this.last) / 1000); this.last = n; }; requestAnimationFrame(f); }\n  frame(real) {\n    const r = Math.min(real, .25);\n    if (!this.paused) this.acc += r * this.timeScale;\n    else if (this.singleStep) { this.acc += FIXED; this.singleStep = false; }\n    let n = 0;\n    while (this.acc >= FIXED && n < 30 * Math.max(1, Math.ceil(this.timeScale))) { this.game.fixed(FIXED); this.acc -= FIXED; n++; }\n    if (this.acc > FIXED * 4) this.acc = 0;\n    this.game.frame(r);\n    this.game.draw();\n  }\n  /** Tests: run sim time without rendering or waiting. */\n  advance(sec) { const n = Math.round(sec / FIXED); for (let i = 0; i < n; i++) { this.game.fixed(FIXED); if (i % 2 === 1) this.game.frame(FIXED * 2); } }\n}\nE\ncat > physics/world.js <<'E'\nimport RAPIER from '@dimforge/rapier3d-compat';\nexport { RAPIER };\nexport const GROUND = 0x0001, RAGDOLL = 0x1000;\nexport const PROP = (l) => 0x0010 << l, DOLL = (l) => 0x0100 << l;\nexport const groups = (m, f) => ((m & 0xffff) << 16) | (f & 0xffff);\nexport const G_GROUND = groups(GROUND, 0xffff);\nexport const G_DOLL = (l) => groups(DOLL(l), PROP(l));\nexport const G_PROP = (l) => groups(PROP(l), DOLL(l) | PROP(l) | GROUND);\nexport const G_RAGDOLL = groups(RAGDOLL, GROUND);\nlet live = 0;\nexport const liveWorlds = () => live;\nexport function makeWorld({ gravity = 9.81, iterations = 8 } = {}) {\n  const world = new RAPIER.World({ x: 0, y: -gravity, z: 0 });\n  world.timestep = 1 / 120;\n  world.integrationParameters.numSolverIterations = iterations;\n  live++;\n  const free = world.free.bind(world);\n  world.free = () => { live--; free(); };\n  return world;\n}\nexport function addGroundPlane(world, y = 0, half = 80, friction = .8) {\n  const b = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, y - .5, 0));\n  world.createCollider(RAPIER.ColliderDesc.cuboid(half, .5, half).setFriction(friction).setCollisionGroups(G_GROUND), b);\n  return b;\n}\nE\ncat > physics/balancer.js <<'E'\n// The balance core: one dynamic body on a ball joint at the foot. Everything that stands uses it.\nimport { RAPIER, G_DOLL } from './world.js';\nimport { T } from '../core/tuning.js';\nconst rad = (d) => d * Math.PI / 180;\nexport class Balancer {\n  constructor(world, lane, fx, fy, fz, opts = {}) {\n    this.world = world; this.lane = lane; this.opts = opts;\n    this.fx = fx; this.fy = fy; this.fz = fz;\n    this.foot = world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(fx, fy, fz));\n    this.body = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(fx, fy + .75, fz).setCanSleep(false).setAdditionalSolverIterations(4));\n    this.collider = world.createCollider(RAPIER.ColliderDesc.capsule(.5, .25).setMass(1).setCollisionGroups(G_DOLL(lane)), this.body);\n    this.makeJoint();\n    this.wx = 0; this.wz = 0; this.leanX = 0; this.leanZ = 0; this.nx = 0; this.nz = 0;\n    this.flailLeft = 0; this.flailCool = 0; this.enabled = true; this.free = false;\n    this.mods = { ankle: 1, margin: null, zeta: null, reflex: null, maxLean: null };\n    this.t = 0;\n  }\n  makeJoint() {\n    this.joint = this.world.createImpulseJoint(RAPIER.JointData.spherical({ x: 0, y: 0, z: 0 }, { x: 0, y: -.75, z: 0 }), this.foot, this.body, true);\n    this.joint.setContactsEnabled(false);\n  }\n  maxLeanRad() { return rad(this.opts.maxLean ?? T.maxLean); }\n  margin() { return this.mods.margin ?? this.opts.margin ?? T.margin; }\n  ankle() { return (this.opts.ankleMax ?? T.ankleMax) * this.mods.ankle; }\n  /** Call before world.step(). wish is on the unit disc, in world x/z. */\n  step(dt, wishX, wishZ) {\n    this.t += dt;\n    if (this.flailLeft > 0) this.flailLeft -= dt;\n    if (this.flailCool > 0) this.flailCool -= dt;\n    if (!this.enabled || this.free) { this.readLean(); return; }\n    const G = T.gravity * .75, I = .75 * .75 + .06;\n    const margin = this.margin();\n    const K = G * (1 + margin), wn = Math.sqrt(Math.max(.01, K - G) / I);\n    const zeta = this.mods.zeta ?? this.opts.zeta ?? T.zeta;\n    const D = 2 * zeta * wn * I;\n    const reflex = this.mods.reflex ?? this.opts.reflex ?? T.reflex;\n    const r = 1 - Math.exp(-reflex * dt);\n    this.wx += (wishX - this.wx) * r; this.wz += (wishZ - this.wz) * r;\n    const maxLean = this.maxLeanRad();\n    const tx = this.wx * maxLean, tz = this.wz * maxLean;\n    this.readLean();\n    const w = this.body.angvel();\n    let Tx = -(G * Math.sin(tx) + K * (this.leanX - tx)) + D * w.z;\n    let Tz = -(G * Math.sin(tz) + K * (this.leanZ - tz)) - D * w.x;\n    const limit = this.ankle() * (this.flailLeft > 0 ? T.flailBoost : 1);\n    const m = Math.hypot(Tx, Tz); if (m > limit) { Tx *= limit / m; Tz *= limit / m; }\n    this.body.resetTorques(true);\n    this.body.addTorque({ x: Tz + this.nz, y: -w.y * .6, z: -(Tx + this.nx) }, true);\n  }\n  readLean() {\n    const q = this.body.rotation();\n    const ux = 2 * (q.x * q.y - q.w * q.z), uy = 1 - 2 * (q.x * q.x + q.z * q.z), uz = 2 * (q.y * q.z + q.w * q.x);\n    this.leanX = Math.atan2(ux, uy); this.leanZ = Math.atan2(uz, uy);\n    this.angle = Math.atan2(Math.hypot(ux, uz), uy);\n  }\n  get cobX() { return this.leanX / this.maxLeanRad(); }\n  get cobZ() { return this.leanZ / this.maxLeanRad(); }\n  flail() { if (this.flailCool > 0) return false; this.flailLeft = .35; this.flailCool = T.flailCooldown; return true; }\n  moveFoot(x, y, z) { this.fx = x; this.fy = y; this.fz = z; this.foot.setNextKinematicTranslation({ x, y, z }); }\n  /** Reset to upright, including the cached lean: a stale lean falls again at once, for ever. */\n  reset() {\n    this.body.setTranslation({ x: this.fx, y: this.fy + .75, z: this.fz }, true);\n    this.body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true);\n    this.body.setLinvel({ x: 0, y: 0, z: 0 }, true); this.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n    this.body.resetTorques(true);\n    this.leanX = 0; this.leanZ = 0; this.angle = 0; this.wx = 0; this.wz = 0;\n  }\n  setEnabled(on) { this.enabled = on; this.body.setEnabled(on); this.collider.setEnabled(on); }\n  /** Springboard: free flight. Removes the foot joint. */\n  release() { if (this.joint) { this.world.removeImpulseJoint(this.joint, true); this.joint = null; } this.free = true; }\n  reattach() { this.free = false; this.reset(); this.makeJoint(); }\n}\nE\ncat > physics/ragdoll.js <<'E'\n// Ragdoll from the rig: one body per segment, built at the segment's world transform.\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, G_RAGDOLL } from './world.js';\nconst SEG = [\n  // joint, kind parent, hh, r, mass, collider offset y\n  ['hips', null, .2, .22, .45, .28],\n  ['head', 'hips', .02, .2, .15, .22],\n  ['shoulderL', 'hips', .1, .07, .05, -.16],\n  ['elbowL', 'shoulderL', .1, .07, .04, -.14],\n  ['shoulderR', 'hips', .1, .07, .05, -.16],\n  ['elbowR', 'shoulderR', .1, .07, .04, -.14],\n  ['hipL', 'hips', .13, .09, .08, -.12],\n  ['kneeL', 'hipL', .13, .08, .06, -.14],\n  ['hipR', 'hips', .13, .09, .08, -.12],\n  ['kneeR', 'hipR', .13, .08, .06, -.14],\n];\nconst v = new THREE.Vector3(), q = new THREE.Quaternion(), v2 = new THREE.Vector3(), q2 = new THREE.Quaternion();\nexport class Ragdoll {\n  constructor(world, doll, parentGroup, vel = { x: 0, y: 0, z: 0 }, kick = { x: 0, y: 0, z: 0 }) {\n    this.world = world; this.doll = doll; this.parent = parentGroup; this.parts = []; this.joints = [];\n    doll.group.updateWorldMatrix(true, true);\n    const P = parentGroup; P.updateWorldMatrix(true, false);\n    const invP = new THREE.Matrix4().copy(P.matrixWorld).invert();\n    const m = new THREE.Matrix4(), s = new THREE.Vector3();\n    const byName = {};\n    const worlds = {};\n    for (const [name] of SEG) { const j = doll.joints[name]; m.multiplyMatrices(invP, j.matrixWorld); const p = new THREE.Vector3(), r = new THREE.Quaternion(); m.decompose(p, r, s); worlds[name] = { p, r }; }\n    for (const [name, par, hh, rad, mass, off] of SEG) {\n      const j = doll.joints[name], w = worlds[name];\n      const body = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(w.p.x, w.p.y, w.p.z).setRotation({ x: w.r.x, y: w.r.y, z: w.r.z, w: w.r.w })\n        .setLinearDamping(.05).setAngularDamping(.6).setLinvel(vel.x, vel.y, vel.z));\n      world.createCollider(RAPIER.ColliderDesc.capsule(hh, rad).setTranslation(0, off, 0).setMass(mass).setFriction(.7).setRestitution(.15).setCollisionGroups(G_RAGDOLL), body);\n      const rec = { name, j, body, homeParent: j.parent, homePos: j.position.clone(), homeQuat: j.quaternion.clone() };\n      this.parts.push(rec); byName[name] = rec;\n      if (par) {\n        const pw = worlds[par];\n        v.copy(w.p).sub(pw.p).applyQuaternion(q.copy(pw.r).invert());\n        const joint = world.createImpulseJoint(RAPIER.JointData.spherical({ x: v.x, y: v.y, z: v.z }, { x: 0, y: 0, z: 0 }), byName[par].body, body, true);\n        joint.setContactsEnabled(false);\n        this.joints.push(joint);\n      }\n    }\n    byName.head.body.applyImpulse(kick, true);\n    for (const r of this.parts) parentGroup.attach(r.j);\n    this.head = byName.head;\n    this.t = 0;\n  }\n  sync() {\n    for (const r of this.parts) {\n      const p = r.body.translation(), o = r.body.rotation();\n      r.j.position.set(p.x, p.y, p.z); r.j.quaternion.set(o.x, o.y, o.z, o.w);\n    }\n  }\n  headPos() { return this.parts[0].body.translation(); }\n  remove() {\n    for (let i = this.parts.length - 1; i >= 0; i--) {\n      const r = this.parts[i];\n      r.homeParent.add(r.j); r.j.position.copy(r.homePos); r.j.quaternion.copy(r.homeQuat);\n    }\n    for (const j of this.joints) this.world.removeImpulseJoint(j, true);\n    for (const r of this.parts) this.world.removeRigidBody(r.body);\n    this.parts = []; this.joints = [];\n  }\n}\nE\ncat > physics/island.js <<'E'\n// Do not move the island. Tilt gravity. Rapier sees a fixed flat disc.\nimport { RAPIER, G_GROUND, G_PROP, makeWorld, groups, GROUND } from './world.js';\nimport { T } from '../core/tuning.js';\nconst rad = (d) => d * Math.PI / 180;\nexport class TiltModel {\n  constructor({ K, C, W, clamp = rad(26) }) { this.K = K; this.C = C; this.W = W; this.clamp = clamp; this.tx = 0; this.tz = 0; this.vx = 0; this.vz = 0; this.restX = 0; this.restZ = 0; }\n  step(dt, sumX, sumZ, K = this.K, W = this.W) {\n    this.vx += (K * this.restX + W * sumX - K * this.tx - this.C * this.vx) * dt; this.tx += this.vx * dt;\n    this.vz += (K * this.restZ + W * sumZ - K * this.tz - this.C * this.vz) * dt; this.tz += this.vz * dt;\n    const m = Math.hypot(this.tx, this.tz); if (m > this.clamp) { this.tx *= this.clamp / m; this.tz *= this.clamp / m; }\n  }\n  applyGravity(world, g = T.gravity) { world.gravity = { x: g * Math.sin(this.tx), y: -g * Math.cos(Math.hypot(this.tx, this.tz)), z: g * Math.sin(this.tz) }; }\n  applyGroup(group) {\n    const a = Math.hypot(this.tx, this.tz) || 1e-9, s = Math.sin(a / 2);\n    group.quaternion.set(this.tz / a * s, 0, -this.tx / a * s, Math.cos(a / 2));\n  }\n}\nexport function makeIslandWorld() {\n  const world = makeWorld({ iterations: 6 });\n  const base = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(0, -.5, 0));\n  world.createCollider(RAPIER.ColliderDesc.cylinder(.5, 22).setFriction(.9).setCollisionGroups(groups(GROUND, 0xffff)), base);\n  const n = 40;\n  for (let i = 0; i < n; i++) {\n    const a = i / n * Math.PI * 2;\n    const b = world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(Math.cos(a) * 22.1, 1, Math.sin(a) * 22.1).setRotation({ x: 0, y: Math.sin(-a / 2 + Math.PI / 4 * 0), z: 0, w: Math.cos(-a / 2) }));\n    world.createCollider(RAPIER.ColliderDesc.cuboid(.15, 1, 1.9).setCollisionGroups(groups(GROUND, 0xffff)), b);\n  }\n  return world;\n}\nexport function restWeight() { return T.islandSpring * rad(T.islandWeight) / 22; }\nexport { G_GROUND, G_PROP };\nE\ncd ..; cat >> notes/issues.md <<'E'\n# Issues testing caught (one line each, as they happen)\nE\nsed -i 's/- \\[ \\] M0 skeleton/- [ ] M0 skeleton (core, physics, data started)/' ../PROGRESS.md","description":"Write core, tuning, save, script and physics modules"}}}
