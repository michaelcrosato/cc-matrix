 === 'free' || this.groupRun) { this.groupRun = false; this.goTitle(true); return; }\n    this.startHub(); this.hub.locked = false; if (!p.checkinDone) this.scripts.run(this.dayFlow(), 'flow'); else this.hubResume();\n  }\"\"\")\n# ending flare\ns=s.replace(\"\"\"    yield 1.5; this.particles.confetti(0, 12, 0, 120); this.audio.sfx('cheer'); this.audio.sting('fanfare');\"\"\",\"\"\"    yield 1.5; this.island.lightLamp(true); { const q = this.island.jarGroup.getWorldPosition(new THREE.Vector3()); this.particles.burst(q.x, q.y + 2.4, q.z, 70, ['#F5B700', '#FFF8EE', '#7FD6C8', '#C8D4DF'], 5, .14, 1.6, 6); } this.particles.confetti(0, 12, 0, 120); this.audio.sfx('cheer'); this.audio.sting('fanfare');\"\"\")\ns=s.replace(\"\"\"  goTitle(skipFade) { this.clearMode(); this.ui.closeAll(); this.speech.clear(); setWipe(0);\"\"\",\"\"\"  goTitle(skipFade) { this.clearMode(); this.ui.closeAll(); this.speech.clear(); setWipe(0); this.classKind = null;\"\"\")\nopen('src/game/director.js','w').write(s)\n\ns=open('src/game/hub.js').read()\ns=s.replace(\"  setTiltRest(deg) {\",\"  /** The notch: start from the old tilt, and the spring brings the island up, props shuffling. */\\n  startFromTilt(deg) { const r = deg * Math.PI / 180; this.tiltM.tx = r * .8; this.tiltM.tz = r * .6; this.tiltM.vx = 0; this.tiltM.vz = 0; }\\n  setTiltRest(deg) {\")\ns=s.replace(\"    if (I.ask) { this.game.bark('trudy', 'ask');\",\"    if (this.idleT > 24) { this.idleT = 0; this.game.bark('trudy', 'idle'); }\\n    if (I.ask) { this.game.bark('trudy', 'ask');\")\nopen('src/game/hub.js','w').write(s)\n\ns=open('src/art/island.js').read()\ns=s.replace(\"  setRest(deg) { this.restDeg = deg; }\",\"\"\"  lightLamp(on) { this.lhLamp.material = toon(on ? '#FFE96B' : '#FFF2C2'); if (on && !this.lampLight) { this.lampLight = new THREE.PointLight(0xfff0a0, 90, 40, 1.2); this.lampLight.position.set(0, 12.6, 0); this.lighthouse.add(this.lampLight); } if (this.lampLight) this.lampLight.visible = on; }\n  setRest(deg) {