{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjm6DHCcPYvduaD6GCYk","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HdoicNoygjuXzQn9iqa7vg","name":"Bash","input":{"command":"cat > src/events/base.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { makeWorld, addGroundPlane } from '../physics/world.js';\nimport { Balancer } from '../physics/balancer.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nimport { makeDoll } from '../art/doll.js';\nimport { T } from '../core/tuning.js';\nimport { rng, cosRange } from '../core/rng.js';\nimport { Brain } from '../input/bot.js';\nimport { screenToWorld, worldToScreen } from '../render/cameraRig.js';\nimport { Disc } from '../ui/disc.js';\nimport { el, txt } from '../ui/ui.js';\nimport { D } from '../data/dialogue.js';\nimport { SEATS } from '../data/config.js';\nexport const DIFFICULTY = { gentle: { ankle: 1.25, dist: .65, win: 1.4 }, standard: { ankle: 1, dist: 1, win: 1 }, honest: { ankle: .9, dist: 1.2, win: .8 } };\nconst rad = (d) => d * Math.PI / 180;\nexport const lerp = (a, b, t) => a + (b - a) * Math.max(0, Math.min(1, t));\nexport class EventBase {\n  static id = 'base'; static title = ''; static discipline = ''; static instructor = 'trudy'; static place = ''; static sentence = ''; static can = ''; static cant = ''; static verbs = [['lean', 'Lean']]; static couch = false; static session = false; static tiers = [{}, {}, {}]; static music = 'balance'; static palette = null; static standing = true; static diagram = 'lean';\n  constructor(game, opts = {}) {\n    this.game = game; this.opts = opts; this.cls = this.constructor; this.tierIndex = opts.tier || 0; this.tier = this.cls.tiers[Math.min(this.tierIndex, this.cls.tiers.length - 1)];\n    this.god = !!opts.god; this.sessionMode = !!opts.session; this.attract = !!opts.attract;\n    this.phase = 'countdown'; this.t = 0; this.playT = 0; this.count = 3; this.lanes = []; this.disposed = false; this.timeLimit = 60; this.usesBreath = false; this.stepping = true;\n    this.diff = DIFFICULTY[game.settings?.difficulty || 'standard'] || DIFFICULTY.standard;\n    this.group = new THREE.Group(); this.world = null; this.objects = []; this.gulls = []; this.widgets = {}; this.anim = []; this.laneSpacing = 3.2; this.camYaw = 0;\n    this.r = rng(`event-${this.cls.id}`); this.barkT = 4; this.falls = 0; this.gustQueue = []; this.tickers = [];\n  }\n  worldOpts() { return { iterations: 8 }; }\n  balanceOpts() { return {}; }\n  groundY() { return 0; }\n  build(laneSpecs) {\n    this.world = makeWorld({ ...this.worldOpts(), gravity: T.gravity });\n    this.ground = addGroundPlane(this.world, this.groundY());\n    this.game.scene.add(this.group);\n    this.buildSet();\n    laneSpecs.forEach((s, i) => this.addLane(s, i, laneSpecs.length));\n    this.start();\n    this.setupHud();\n    this.placeCamera(true);\n  }\n  buildSet() {} start() {} fixedPlay() {} frameLane() {} preStep() {} onFall() {} onRecover() {} onFlail() {} setupHud2() {}\n  placeCamera() {}\n  laneX(i, n) { return (i - (n - 1) / 2) * this.laneSpacing; }\n  addLane(spec, i, n) {\n    const lane = { id: i, kind: spec.kind || 'local', ctrl: spec.ctrl || null, seat: spec.seat ?? i, name: spec.name || `Player ${i + 1}`, colour: spec.colour || SEATS[i % 4], fallen: false, score: 0, form: 0, props: [], skill: spec.skill || 'average', x: this.laneX(i, n), z: 0, sway: 0, tremor: 0, gusts: [], wishX: 0, wishZ: 0, in: { x: 0, z: 0, lf: 0, rf: 0, hop: false, hopHeld: false, flail: false, breath: false }, breathHist: [], breathSync: false, ph: this.r() * 6.28, baseClip: 'idle', falls: 0, flailN: 0, zone: null, brace: null, extraX: 0, extraZ: 0, medalForm: 0 };\n    lane.doll = makeDoll({ paint: lane.colour, hat: spec.hat || 'none', skin: spec.skin, width: spec.width || 1, height: spec.height || 1 });\n    lane.doll.group.position.set(lane.x, this.groundY(), lane.z); this.group.add(lane.doll.group);\n    lane.doll.setFace(this.faceYaw ?? 0);\n    if (lane.kind === 'bot') lane.brain = new Brain(lane.skill, i + 1);\n    if (lane.kind !== 'ghost' && this.cls.standing !== false) { lane.bal = new Balancer(this.world, i, lane.x, this.groundY(), lane.z, this.balanceOpts()); lane.bal.mods.ankle = this.diff.ankle * (this.god ? 3 : 1); }\n    this.lanes.push(lane); return lane;\n  }\n  localLanes() { return this.lanes.filter(l => l.kind === 'local'); }\n  setupHud() {\n    const hud = this.game.ui.hud; hud.innerHTML = '';\n    if (this.opts.noHud) return;\n    this.hudEl = el('div'); hud.appendChild(this.hudEl);\n    const wrap = el('div', 'discwrap'); this.hudEl.appendChild(wrap);\n    const n = this.lanes.filter(l => l.kind === 'local' || (this.attract && l.id === 0));\n    if (this.showDisc !== false) for (const l of n) l.disc = new Disc(wrap, n.length > 1 ? 14 : 22, n.length > 1 ? l.name : null, l.colour);\n    this.bigEl = txt('div', 'hudbig', ''); this.timeEl = txt('div', 'hudtime', ''); this.numEl = el('div', 'hudnum'); this.msgEl = el('div', 'hudmsg'); this.widgetEl = el('div', 'widget');\n    this.hudEl.append(this.timeEl, this.numEl, this.msgEl, this.bigEl, this.widgetEl);\n    if (this.usesBreath) { this.breathEl = el('div', 'breathring'); this.breathEl.innerHTML = `<svg viewBox=\"-60 -60 120 120\" width=\"${innerHeight * .13}\" height=\"${innerHeight * .13}\"><circle r=\"50\" fill=\"#FFF8EE\" stroke=\"#1A1420\" stroke-width=\"5\"/><circle class=\"br\" r=\"20\" fill=\"#7FD6C8\" stroke=\"#1A1420\" stroke-width=\"4\"/></svg>`; this.brEl = this.breathEl.querySelector('.br'); const lbl = el('div', 'gaugeTag'); this.breathLbl = lbl; this.breathEl.appendChild(lbl); this.hudEl.appendChild(this.breathEl); }\n    if (!this.attract) { const pb = this.game.ui.bottom(this.cls.verbs); this.hudEl.appendChild(pb); }\n    this.setupHud2();\n    this.game.ui.refreshGlyphs(this.hudEl);\n  }\n  setMsg(t) { if (!this.msgEl) return; if (this._msg === t) return; this._msg = t; this.msgEl.innerHTML = ''; if (t) this.msgEl.appendChild(txt('span', '', t)); }\n  setBig(t) { if (this.bigEl && this._big !== t) { this._big = t; this.bigEl.textContent = t; } }\n  setNum(v, label = '') { if (this.numEl) { const s = `${v}|${label}`; if (this._num === s) return; this._num = s; this.numEl.textContent = String(v); if (label) this.numEl.appendChild(txt('small', '', label)); } }\n  setTime(sec) { if (this.timeEl) { const s = sec == null ? '' : String(Math.max(0, Math.ceil(sec))); if (s !== this._time) { this._time = s; this.timeEl.textContent = s; this.timeEl.style.display = s ? '' : 'none'; } } }\n  // ---------- lane input ----------\n  readInput(lane, dt) {\n    const I = lane.in;\n    if (lane.kind === 'local') {\n      const c = lane.ctrl || this.game.input.merged;\n      const [x, z] = screenToWorld(this.moveMode ? c.moveX : c.x, this.moveMode ? c.moveZ : c.z, this.camYaw);\n      I.x = x; I.z = z; I.lf = c.lf; I.rf = c.rf; I.hop = c.hop; I.hopHeld = c.hopHeld; I.flail = c.flail; I.breath = c.breath; I.tapA = c.tapA; I.tapD = c.tapD; I.keys = c.keysDown; I.dev = c.activeDevice || c.device; I.rawX = c.x; I.rawZ = c.z;\n    } else if (lane.kind === 'bot') {\n      const b = this.botInput(lane.id, this.playT, lane.skill, dt) || {};\n      I.x = b.x || 0; I.z = b.z || 0; I.lf = b.lf || 0; I.rf = b.rf || 0; I.hop = !!b.hop; I.hopHeld = !!b.hopHeld; I.flail = !!b.flail; I.breath = !!b.breath; I.tapA = false; I.tapD = false; I.keys = false; I.dev = 'pad';\n    }\n    lane.wishX = I.x; lane.wishZ = I.z;\n  }\n  botBrain(lane) { return lane.brain || (lane.brain = new Brain(this.game.testBotSkill || lane.skill, lane.id + 1)); }\n  botInput() { return { x: 0, z: 0 }; }\n  /** Dev and test: the bot playing a local lane, in screen space for a stub pad. */\n  botPad(i, skill, dt) { const lane = this.lanes[i]; if (!lane) return null; if (!lane.brain || lane.brain.name !== skill) lane.brain = new Brain(skill, i + 1); if (this.phase !== 'play') return { x: 0, z: 0 }; const b = this.botInput(i, this.playT, skill, dt) || {}; const [sx, sz] = worldToScreen(b.x || 0, b.z || 0, this.camYaw); return { ...b, x: sx, z: sz }; }\n  // ---------- fixed step ----------\n  fixed(dt) {\n    if (this.disposed) return;\n    this.t += dt;\n    if (this.phase === 'countdown') {\n      const was = Math.ceil(this.count); this.count -= dt; const now = Math.ceil(this.count);\n      if (was !== now && now > 0) this.game.audio.sfx('tick', { high: false });\n      this.setBig(now > 0 ? String(now) : '');\n      if (this.count <= 0) { this.phase = 'play'; this.playT = 0; this.game.audio.sfx('whistle'); this.setBig(''); this.onPlayStart?.(); }\n    } else if (this.phase === 'play') this.playT += dt;\n    for (const lane of this.lanes) if (lane.kind !== 'ghost') this.readInput(lane, dt);\n    if (this.phase === 'play') this.fixedPlay(dt);\n    for (const lane of this.lanes) this.stepLane(lane, dt);\n    if (this.stepping && this.world) this.world.step();\n    for (const lane of this.lanes) this.postLane(lane, dt);\n    if (this.phase === 'play') this.postPlay?.(dt);\n    for (const f of this.tickers) f(dt);\n    if (this.barkT > 0) this.barkT -= dt;\n  }\n  stepLane(lane, dt) {\n    if (!lane.bal) return;\n    const b = lane.bal;\n    if (lane.fallen) { b.step(dt, 0, 0); return; }\n    if (lane.in.flail && this.flailOk !== false) { if (b.flail()) { lane.flailN++; lane.flailT = .35; lane.doll.rig.play('flail', .05); this.game.audio.sfx('clack', { f: 1600 }); this.onFlail(lane); } }\n    if (lane.flailT > 0) { lane.flailT -= dt; if (lane.flailT <= 0) lane.doll.rig.play(lane.baseClip, .15); }\n    this.breathTick(lane, dt);\n    // Slow forcing the player has to see and counter by hand.\n    const t = b.t, ph = lane.ph, mult = (lane.breathSync ? .6 : 1) * this.diff.dist;\n    const sway = lane.sway * T.swayScale * mult, tr = lane.tremor * T.tremorScale * mult;\n    let nx = sway * (Math.sin(t * .9 + ph) * .6 + Math.sin(t * 1.73 + ph * 2.1) * .4) + tr * (Math.sin(t * 8.2 + 1.1) * .6 + Math.sin(t * 18.3) * .4);\n    let nz = sway * (Math.sin(t * .77 + ph * 1.7) * .6 + Math.sin(t * 1.51 + ph * .6) * .4) + tr * (Math.sin(t * 7.1 + 2.3) * .6 + Math.sin(t * 15.7 + .7) * .4);\n    for (let i = lane.gusts.length - 1; i >= 0; i--) { const g = lane.gusts[i]; if (g.delay > 0) { g.delay -= dt; continue; } nx += g.x * this.diff.dist; nz += g.z * this.diff.dist; g.left -= dt; if (g.left <= 0) lane.gusts.splice(i, 1); }\n    b.nx = nx + lane.extraX; b.nz = nz + lane.extraZ;\n    lane.extraX = 0; lane.extraZ = 0;\n    this.preStep(lane, dt);\n    b.step(dt, lane.wishX, lane.wishZ);\n  }\n  breathTick(lane, dt) {\n    if (!this.usesBreath) return;\n    const phase = (this.t % 8) / 8, growing = phase < .5, auto = this.game.settings?.autoBreathe;\n    const inSync = auto || (growing ? !!lane.in.breath : !lane.in.breath);\n    lane.breathHist.push(inSync ? 1 : 0); const N = 960; if (lane.breathHist.length > N) lane.breathHist.shift();\n    if (lane.breathHist.length % 30 === 0 || lane.breathHist.length === N) { let s = 0; for (const v of lane.breathHist) s += v; lane.breathSync = lane.breathHist.length >= 480 && s / lane.breathHist.length >= .7; }\n  }\n  postLane(lane, dt) {\n    if (!lane.bal) return;\n    const b = lane.bal;\n    if (lane.fallen) {\n      lane.recover -= dt;\n      if (lane.recover <= 0) this.recover(lane);\n      return;\n    }\n    if (!b.free && (b.angle || 0) > rad(T.fallAngle)) {\n      if (this.god) b.reset(); else this.fall(lane);\n    } else if ((b.angle || 0) > rad(T.fallAngle * .72) && lane.nearCd !== true) { lane.nearCd = true; this.game.rumble(lane, .4, .2); if (lane.kind === 'local' && this.barkT <= 0) this.bark('trudy', 'nearFall'); }\n    else if ((b.angle || 0) < rad(18)) lane.nearCd = false;\n  }\n  fall(lane) {\n    if (lane.fallen) return;\n    lane.fallen = true; lane.recover = T.recoverTime; lane.falls++; this.falls++;\n    const b = lane.bal, v = b.body.linvel();\n    b.setEnabled(false);\n    lane.ragdoll = new Ragdoll(this.world, lane.doll, this.group, v, { x: (b.leanX > 0 ? .08 : -.08), y: .05, z: (b.leanZ > 0 ? .08 : -.08) });\n    this.game.audio.sfx('clatter'); this.game.comic('CLACK!', lane.x, 1.4 + this.groundY(), lane.z); this.game.rumble(lane, 1, .35); this.game.hitstop(.05); this.game.rig.shake(.08);\n    this.onFall(lane);\n    if (lane.kind === 'local') { this.game.addFall(); this.bark(this.cls.instructor === 'trudy' ? 'trudy' : (this.r() < .5 ? 'trudy' : this.cls.instructor), 'fall'); }\n  }\n  recover(lane) {\n    if (!lane.fallen) return;\n    lane.fallen = false;\n    if (lane.ragdoll) { lane.ragdoll.remove(); lane.ragdoll = null; }\n    lane.bal.setEnabled(true); lane.bal.reset();\n    lane.doll.rig.play(lane.baseClip, .1); lane.doll.land(); this.game.audio.sfx('spring');\n    this.onRecover(lane);\n  }\n  bark(who, key, vars) { if (this.attract || this.sessionMode && false) return; if (this.barkT > 0) return; this.barkT = 5; this.game.bark(who, key, vars); }\n  gust(lane, x, z, dur = .5, delay = 0) { lane.gusts.push({ x: x * T.gustForce, z: z * T.gustForce, left: dur, delay }); }\n  forceGust(mag = 3) { for (const l of this.lanes) if (l.bal) this.gust(l, mag, 0); }\n  forceFall() { for (const l of this.lanes) if (l.bal && !l.fallen && l.kind !== 'ghost') this.fall(l); }\n  forceThing() {}\n  // ---------- frame ----------\n  frame(dt) {\n    if (this.disposed) return;\n    for (const lane of this.lanes) {\n      if (lane.ragdoll) lane.ragdoll.sync();\n      lane.doll.tick(dt);\n      if (lane.ragdoll) lane.ragdoll.sync();\n      if (lane.bal && !lane.fallen && !lane.customPose) { const f = lane.bal.foot.translation(); lane.doll.group.position.set(f.x, f.y, f.z); lane.doll.setLeanFromQuat(lane.bal.body.rotation()); }\n      this.frameLane(lane, dt);\n      if (lane.disc && lane.bal) {\n        const [cx, cz] = worldToScreen(lane.bal.cobX, lane.bal.cobZ, this.camYaw), [wx, wz] = worldToScreen(lane.wishX, lane.wishZ, this.camYaw);\n        let zone = lane.zone; if (zone && this.camYaw) { const [zx, zz] = worldToScreen(zone.x, zone.z, this.camYaw); zone = { x: zx, z: zz, r: zone.r }; }\n        let br = lane.brace; if (br && this.camYaw) { const [zx, zz] = worldToScreen(br.x, br.z, this.camYaw); br = { x: zx, z: zz }; }\n        lane.disc.update(dt, cx, cz, wx, wz, zone, br);\n      }\n    }\n    for (const a of this.anim) a.tick(dt);\n    if (this.brEl) {\n      const phase = (this.t % 8) / 8, g = phase < .5 ? phase * 2 : (1 - phase) * 2;\n      this.brEl.setAttribute('r', (14 + g * 34).toFixed(1));\n      const l = this.lanes[0]; this.brEl.setAttribute('fill', l && l.breathSync ? '#8FE07A' : '#7FD6C8');\n      const w = phase < .5 ? 'In' : 'Out'; if (this.breathLbl.textContent !== w) { this.breathLbl.textContent = w; this.game.audio.sfx(phase < .5 ? 'breathIn' : 'breathOut'); }\n    }\n    this.placeCamera(false);\n    this.frame2?.(dt);\n  }\n  // ---------- result ----------\n  finish() { if (this.phase === 'done') return; this.phase = 'done'; this.game.audio.sfx('whistle'); for (const l of this.lanes) { if (l.kind !== 'ghost' && !l.fallen) l.doll.rig.play(this.winClip || 'cheer', .2); } this.setBig(''); }\n  forceFinish() { this.finish(); }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.form), label: 'Form', stats: `Floor Exercises: ${l.falls}` }; }\n  /** Current session-score estimate. */\n  liveForm(i) { return this.lanes[i]?.form || 0; }\n  dispose() {\n    if (this.disposed) return; this.disposed = true;\n    for (const l of this.lanes) { if (l.ragdoll) { l.ragdoll = null; } if (l.disc) l.disc.remove(); l.brain = null; }\n    this.game.scene.remove(this.group);\n    this.group.traverse?.((o) => { if (o.isSprite && o.material) o.material.dispose(); });\n    this.onDispose?.();\n    if (this.world) { this.world.free(); this.world = null; }\n    this.game.ui.hud.innerHTML = '';\n  }\n  bodyCount() { return this.world ? this.world.bodies.len() : 0; }\n  hasNaN() { if (!this.world) return false; let bad = false; this.world.bodies.forEach((b) => { const p = b.translation(); if (!Number.isFinite(p.x + p.y + p.z)) bad = true; }); return bad; }\n  crowd(list, spec = {}) { // non-physics spectators\n    for (const g of list) { const d = makeDoll({ paint: g.paint, hat: g.hat, skin: g.skin, height: g.height || 1, width: g.width || 1 }); d.group.position.set(g.x, g.y ?? this.groundY(), g.z); d.setFace(g.yaw ?? 0); d.rig.play(g.clip || spec.clip || 'clap', 0); d.rig.mixer.setTime(cosRange(0, 1)); this.group.add(d.group); this.anim.push(d); }\n  }\n  add(o, x, y, z) { if (x !== undefined) o.position.set(x, y, z); this.group.add(o); return o; }\n}\nexport const pickLine = (who, key) => D[who]?.[key];\nE\ncat > src/events/fruitHat.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { fruitMesh, plankWalk, crate, buoy, bunting, cyl, box, at, sphere, torus, cone, mesh, toon, lantern } from '../art/props.js';\nimport { cached } from '../art/materials.js';\nimport { makeGull } from '../art/gull.js';\nconst VAL = { orange: 1, lemon: 1, plum: 1, boot: 0, pineapple: 5, urchin: -1 };\nexport class FruitHat extends EventBase {\n  static id = 'fruitHat'; static title = 'Fruit Hat'; static discipline = 'Balance Play'; static instructor = 'trudy'; static place = 'End of the pier'; static music = 'balance'; static couch = true; static session = true; static diagram = 'hat';\n  static sentence = 'A barge fires fruit. Lean to catch it in your hat, then toss it in the crate.';\n  static can = 'You can get greedy: bigger banks pay more.'; static cant = \"You can't keep fruit you haven't banked if you fall.\";\n  static verbs = [['lean', 'Lean'], ['hop', 'Bank'], ['flail', 'Flail']];\n  static tiers = [\n    { radius: .45, every: 1.6, mass: .015, ankle: 4.6, margin: .45, par: 52, time: 60 },\n    { radius: .55, every: 1.3, mass: .012, ankle: 5, margin: .6, par: 62, time: 60 },\n    { radius: .65, every: 1, mass: .012, ankle: 5, margin: .6, par: 70, time: 60 },\n  ];\n  static sessionConfig = { tier: 0, time: 50 };\n  balanceOpts() { return { ankleMax: this.tier.ankle, margin: this.tier.margin }; }\n  worldOpts() { return { iterations: 10 }; }\n  buildSet() {\n    this.faceYaw = 0; this.timeLimit = this.opts.time || this.tier.time;\n    const n = this.opts.laneCount || 1;\n    const pier = new THREE.Group(); for (let i = 0; i < 3; i++) { const pw = plankWalk(16, 3.4 + (n - 1) * 3.2); pw.position.z = 7 - i * 0; pier.add(pw); break; }\n    pier.position.y = 0; this.add(pier);\n    this.add(bunting(-4 - n, 2.6, -6, 4 + n, 2.6, -6, 14));\n    for (const s of [-1, 1]) { this.add(lantern(), s * (2 + n * 1.6), 0, -3); this.add(lantern('#F58A5C'), s * (2 + n * 1.6), 0, -7); }\n    this.add(buoy(), -7, -.4, 4); this.add(buoy('#F5F0E0'), 8, -.4, 1);\n    // Barge offshore, firing fruit toward the pier.\n    const barge = new THREE.Group(); barge.add(at(box(6, 1, 3, '#B0533A'), 0, 0, 0)); barge.add(at(box(6.4, .2, 3.3, '#7A3A28'), 0, .55, 0));\n    const cannon = cyl(.3, .4, 1.6, '#3B3550'); cannon.rotation.x = 1; barge.add(at(cannon, 0, 1.2, .3)); barge.add(at(sphere(.5, '#F58A2E'), 1.8, .95, 0)); barge.add(at(sphere(.4, '#F7E04B'), 1.1, .9, -.6)); barge.add(at(cyl(.05, .05, 2.6, '#7A5A3C'), -2.2, 1.8, 0));\n    const flag = cone(.3, .7, '#E8443A', 3); flag.rotation.z = -1.57; barge.add(at(flag, -1.85, 2.8, 0));\n    this.barge = barge; this.add(barge, 0, -.1, -22);\n    this.gull = makeGull(); this.gull.rig.play('stand'); this.add(this.gull.group, 3.2, .0, -4); this.anim.push(this.gull);\n    this.fruits = []; this.spawnT = 2; this.seq = 0;\n    this.shadowGeo = cached('shadowRing', () => new THREE.RingGeometry(.12, .2, 24));\n  }\n  placeCamera(snap) {\n    const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0;\n    const d = this.game.rig.fitDistance(5.6, spread);\n    this.game.rig.set(0, 1.5, d, 0, 1.25, -1, snap);\n  }\n  start() {\n    for (const l of this.lanes) {\n      l.score = 0; l.bankScore = 0; l.hatFruit = []; l.banks = 0; l.bankCd = 0; l.spilled = 0; l.bankedN = 0; l.baseClip = 'holdHat'; l.doll.rig.play('holdHat', 0); l.tossT = 0; l.nextBank = 7;\n      if (l.kind === 'ghost') continue;\n      const b = l.bal.body;\n      const cfg = (d, y) => RAPIER.ColliderDesc.cylinder(.02, .36).setTranslation(0, y, 0).setMass(d).setFriction(.9).setCollisionGroups(G_PROP(l.id));\n      this.world.createCollider(cfg(.01, .75), b);\n      for (let i = 0; i < 8; i++) {\n        const a = i / 8 * 6.283, s = Math.sin(-a / 2), c = Math.cos(-a / 2);\n        this.world.createCollider(RAPIER.ColliderDesc.cuboid(.02, .1, .16).setTranslation(Math.cos(a) * .36, .85, Math.sin(a) * .36).setRotation({ x: 0, y: s, z: 0, w: c }).setMass(.001).setFriction(.9).setCollisionGroups(G_PROP(l.id)), b);\n      }\n      // Visible hat on the doll: wide wicker bowl.\n      const hat = new THREE.Group();\n      const bowl = mesh(cached('hatBowl', () => new THREE.CylinderGeometry(.38, .34, .06, 24)), '#D9A86C'); hat.add(at(bowl, 0, .0, 0));\n      const rim = torus(.37, .035, '#B58457'); rim.rotation.x = Math.PI / 2; hat.add(at(rim, 0, .1, 0));\n      for (let i = 0; i < 12; i++) { const a = i / 12 * 6.283; hat.add(at(box(.03, .13, .03, '#C89B6A'), Math.cos(a) * .36, .05, Math.sin(a) * .36)); }\n      hat.position.set(0, 1.5, 0); l.doll.lean.add(hat); l.hatMesh = hat;\n      // Crate at the foot.\n      l.crate = crate(.6); l.crate.position.set(l.x + .75, 0, l.z + .1); this.group.add(l.crate);\n      l.crateCount = 0;\n    }\n  }\n  pickKind() {\n    const r = this.r(); this.seq++;\n    if (this.seq % 13 === 0) return 'pineapple';\n    if (this.seq % 11 === 0) return 'boot';\n    if (this.seq % 7 === 0) return 'urchin';\n    return r < .4 ? 'orange' : r < .7 ? 'lemon' : 'plum';\n  }\n  launch(lane, kind) {\n    const tier = this.tier, R = tier.radius * T.landingRadius;\n    const a = this.r() * 6.283, d = Math.sqrt(this.r()) * R, lx = lane.x + Math.cos(a) * d, lz = lane.z + Math.sin(a) * d;\n    const sx = lane.x + (this.r() - .5) * 3, sz = -7, sy = .5;\n    const FLY = 1.5, g = T.gravity, ty = 1.75;\n    const vx = (lx - sx) / FLY, vz = (lz - sz) / FLY, vy = (ty - sy + .5 * g * FLY * FLY) / FLY;\n    const mass = (kind === 'pineapple' ? .03 : kind === 'boot' ? .028 : kind === 'urchin' ? .012 : tier.mass) * T.fruitMass;\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(sx, sy, sz).setLinvel(vx, vy, vz).setCcdEnabled(true).setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.ball(.075).setMass(mass).setFriction(.8).setRestitution(.1).setCollisionGroups(G_PROP(lane.id)), body);\n    const m = fruitMesh(kind); this.group.add(m);\n    const ring = new THREE.Mesh(this.shadowGeo, toon(kind === 'urchin' ? '#E8443A' : '#1A1420')); ring.rotation.x = -Math.PI / 2; ring.position.set(lx, .02, lz); ring.scale.setScalar(1.6); this.group.add(ring);\n    const f = { body, m, ring, kind, lane, t: 0, fly: FLY, lx, lz, inHat: false, value: VAL[kind], landed: false };\n    this.fruits.push(f); this.game.audio.sfx('pump');\n    return f;\n  }\n  removeFruit(f) {\n    const i = this.fruits.indexOf(f); if (i >= 0) this.fruits.splice(i, 1);\n    const hi = f.lane.hatFruit.indexOf(f); if (hi >= 0) f.lane.hatFruit.splice(hi, 1);\n    this.group.remove(f.m); if (f.ring) this.group.remove(f.ring);\n    this.world.removeRigidBody(f.body);\n  }\n  bank(lane) {\n    const list = lane.hatFruit.filter(f => f.kind !== 'urchin');\n    const n = list.length; if (!n || lane.bankCd > 0 || lane.fallen) return;\n    let value = 0; for (const f of list) value += f.value;\n    const gain = value * (1 + .1 * (n - 1));\n    lane.bankScore += gain; lane.banks++; lane.bankedN += n; lane.bankCd = 1;\n    for (const f of [...lane.hatFruit]) this.removeFruit(f);\n    lane.doll.rig.play('hop', .05, lane.baseClip); lane.doll.land();\n    this.game.audio.sfx('fruit'); this.game.audio.sfx('clack', { f: 900 });\n    this.game.comic(`+${gain.toFixed(1)}`, lane.x + .8, 1.3, lane.z, '#FFD23F', .8);\n    if (lane.kind === 'local') this.bark('trudy', 'fruitBank');\n    lane.crateCount += n;\n  }\n  fixedPlay(dt) {\n    const every = this.tier.every * T.fruitInterval;\n    this.spawnT -= dt;\n    if (this.spawnT <= 0 && this.playT < this.timeLimit - 1.5) { this.spawnT = every; const kind = this.pickKind(); for (const l of this.lanes) if (l.kind !== 'ghost') this.launch(l, kind); }\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') continue;\n      l.bankCd = Math.max(0, l.bankCd - dt);\n      if (l.in.hop) this.bank(l);\n    }\n    if (this.playT >= this.timeLimit) this.finish();\n  }\n  preStep(l, dt) { // shake the top item off with a flail\n    if (l.flailT > .3 && l.hatFruit.length) { const f = l.hatFruit[l.hatFruit.length - 1]; f.body.applyImpulse({ x: (this.r() - .5) * .02, y: .03, z: (this.r() - .5) * .02 }, true); }\n  }\n  postPlay(dt) {\n    for (const f of [...this.fruits]) {\n      f.t += dt; const p = f.body.translation(), l = f.lane;\n      f.m.position.set(p.x, p.y, p.z);\n      if (!f.landed) {\n        const dhat = Math.hypot(p.x - (l.x + (l.bal?.cobX || 0) * .35), p.z - (l.z + (l.bal?.cobZ || 0) * .35));\n        if (f.t > f.fly - .08 && p.y < 2.2) {\n          const onHat = dhat < .4 && p.y > 1.35 && !l.fallen;\n          if (onHat) {\n            f.landed = true; f.inHat = true; l.hatFruit.push(f); if (f.ring) { this.group.remove(f.ring); f.ring = null; }\n            this.game.audio.sfx(f.kind === 'urchin' ? 'spike' : 'fruit'); this.game.rumble(l, .25, .08); this.game.hitstop(.016);\n            if (f.kind === 'urchin') { l.bankScore = Math.max(0, l.bankScore - 2); this.gust(l, (this.r() - .5) * 1.4, (this.r() - .5) * 1.4, .25); this.game.comic('OW!', l.x, 2, l.z, '#E8443A', .7); if (l.kind === 'local') this.bark('trudy', 'urchin'); }\n            if (f.kind === 'boot' && l.kind === 'local') this.bark('trudy', 'boot');\n            if (f.kind === 'pineapple' && l.kind === 'local') this.bark('trudy', 'golden');\n            if (l.hatFruit.length >= 8 && l.kind === 'local') this.bark('trudy', 'fruitGreedy');\n          }\n        }\n      }\n      if (f.inHat && (p.y < 1.0 || Math.hypot(p.x - l.x, p.z - l.z) > 1.2)) { f.inHat = false; const i = l.hatFruit.indexOf(f); if (i >= 0) l.hatFruit.splice(i, 1); this.game.audio.sfx('fruit'); }\n      if (f.t > f.fly + .2 && f.ring) { this.group.remove(f.ring); f.ring = null; }\n      if (p.y < -1 || f.t > 12 && !f.inHat) this.removeFruit(f);\n      else if (!f.inHat && f.t > f.fly + .5 && p.y < .15) { this.removeFruit(f); }\n    }\n    for (const l of this.lanes) if (l.kind !== 'ghost') { l.score = l.bankScore + this.unbanked(l) * .5; l.form = Math.min(100, 100 * l.score / this.tier.par); }\n  }\n  unbanked(l) { let v = 0; for (const f of l.hatFruit) if (f.kind !== 'urchin') v += f.value; const n = l.hatFruit.length; return n ? v * (1 + .1 * (n - 1)) : 0; }\n  onFall(l) { const n = l.hatFruit.length; if (n) { l.spilled += n; if (l.kind === 'local' && n > 3) this.game.bark('trudy', 'fruitSpill'); } for (const f of [...l.hatFruit]) { f.inHat = false; f.body.setLinvel({ x: (this.r() - .5) * 2, y: 1.5, z: (this.r() - .5) * 2 }, true); } l.hatFruit.length = 0; if (l.hatMesh) l.hatMesh.visible = false; }\n  onRecover(l) { if (l.hatMesh) l.hatMesh.visible = true; }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(l.score.toFixed(0), `Hat: ${l.hatFruit?.length || 0}`); this.setTime(this.timeLimit - this.playT); } if (this.barge) this.barge.position.y = -.1 + Math.sin(this.t * .9) * .08; }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); br.s = br.s;\n    // Lean only for a fruit in its last 0.95 s of flight.\n    let best = null, bt = 99; for (const f of this.fruits) { if (f.lane !== l || f.landed) continue; const left = f.fly - f.t; if (left > 0 && left < .95 - br.s.lag * .2 && left < bt) { bt = left; best = f; } }\n    let gx = 0, gz = 0; if (best && best.kind !== 'urchin') { gx = (best.lx - l.x) / .36; gz = (best.lz - l.z) / .36; const m = Math.hypot(gx, gz); if (m > 1) { gx /= m; gz /= m; } }\n    const [x, z] = br.correct(dt, l, gx, gz, l.hatFruit.length > 3);\n    const bankAt = l.bankAt ?? this.opts.bankAt ?? (skill === 'sharp' ? 7 : 5);\n    const hop = !!(bankAt < 99 && l.hatFruit.length >= bankAt && l.bankCd <= 0);\n    const flail = (l.bal?.angle || 0) > .55;\n    return { x, z, hop, flail };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.score), label: 'Fruit banked', stats: `${l.bankedN} fruit in ${l.banks} banks. Floor Exercises: ${l.falls}` }; }\n  forceThing() { const kind = 'pineapple'; for (const l of this.lanes) if (l.kind !== 'ghost') this.launch(l, kind); }\n}\nE\necho ok","description":"Write the event base class and Fruit Hat"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19700,"cache_read_input_tokens":196805,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19700},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"c216f3c2-4163-43fa-bd32-56e661ed731f","timestamp":"2026-11-05T12:14:52.017Z","request_id":"req_011Cgjm6CxrLjW1C6zBjujx5","wire_tool_inputs":{"toolu_01HdoicNoygjuXzQn9iqa7vg":{"command":"cat > src/events/base.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { makeWorld, addGroundPlane } from '../physics/world.js';\nimport { Balancer } from '../physics/balancer.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nimport { makeDoll } from '../art/doll.js';\nimport { T } from '../core/tuning.js';\nimport { rng, cosRange } from '../core/rng.js';\nimport { Brain } from '../input/bot.js';\nimport { screenToWorld, worldToScreen } from '../render/cameraRig.js';\nimport { Disc } from '../ui/disc.js';\nimport { el, txt } from '../ui/ui.js';\nimport { D } from '../data/dialogue.js';\nimport { SEATS } from '../data/config.js';\nexport const DIFFICULTY = { gentle: { ankle: 1.25, dist: .65, win: 1.4 }, standard: { ankle: 1, dist: 1, win: 1 }, honest: { ankle: .9, dist: 1.2, win: .8 } };\nconst rad = (d) => d * Math.PI / 180;\nexport const lerp = (a, b, t) => a + (b - a) * Math.max(0, Math.min(1, t));\nexport class EventBase {\n  static id = 'base'; static title = ''; static discipline = ''; static instructor = 'trudy'; static place = ''; static sentence = ''; static can = ''; static cant = ''; static verbs = [['lean', 'Lean']]; static couch = false; static session = false; static tiers = [{}, {}, {}]; static music = 'balance'; static palette = null; static standing = true; static diagram = 'lean';\n  constructor(game, opts = {}) {\n    this.game = game; this.opts = opts; this.cls = this.constructor; this.tierIndex = opts.tier || 0; this.tier = this.cls.tiers[Math.min(this.tierIndex, this.cls.tiers.length - 1)];\n    this.god = !!opts.god; this.sessionMode = !!opts.session; this.attract = !!opts.attract;\n    this.phase = 'countdown'; this.t = 0; this.playT = 0; this.count = 3; this.lanes = []; this.disposed = false; this.timeLimit = 60; this.usesBreath = false; this.stepping = true;\n    this.diff = DIFFICULTY[game.settings?.difficulty || 'standard'] || DIFFICULTY.standard;\n    this.group = new THREE.Group(); this.world = null; this.objects = []; this.gulls = []; this.widgets = {}; this.anim = []; this.laneSpacing = 3.2; this.camYaw = 0;\n    this.r = rng(`event-${this.cls.id}`); this.barkT = 4; this.falls = 0; this.gustQueue = []; this.tickers = [];\n  }\n  worldOpts() { return { iterations: 8 }; }\n  balanceOpts() { return {}; }\n  groundY() { return 0; }\n  build(laneSpecs) {\n    this.world = makeWorld({ ...this.worldOpts(), gravity: T.gravity });\n    this.ground = addGroundPlane(this.world, this.groundY());\n    this.game.scene.add(this.group);\n    this.buildSet();\n    laneSpecs.forEach((s, i) => this.addLane(s, i, laneSpecs.length));\n    this.start();\n    this.setupHud();\n    this.placeCamera(true);\n  }\n  buildSet() {} start() {} fixedPlay() {} frameLane() {} preStep() {} onFall() {} onRecover() {} onFlail() {} setupHud2() {}\n  placeCamera() {}\n  laneX(i, n) { return (i - (n - 1) / 2) * this.laneSpacing; }\n  addLane(spec, i, n) {\n    const lane = { id: i, kind: spec.kind || 'local', ctrl: spec.ctrl || null, seat: spec.seat ?? i, name: spec.name || `Player ${i + 1}`, colour: spec.colour || SEATS[i % 4], fallen: false, score: 0, form: 0, props: [], skill: spec.skill || 'average', x: this.laneX(i, n), z: 0, sway: 0, tremor: 0, gusts: [], wishX: 0, wishZ: 0, in: { x: 0, z: 0, lf: 0, rf: 0, hop: false, hopHeld: false, flail: false, breath: false }, breathHist: [], breathSync: false, ph: this.r() * 6.28, baseClip: 'idle', falls: 0, flailN: 0, zone: null, brace: null, extraX: 0, extraZ: 0, medalForm: 0 };\n    lane.doll = makeDoll({ paint: lane.colour, hat: spec.hat || 'none', skin: spec.skin, width: spec.width || 1, height: spec.height || 1 });\n    lane.doll.group.position.set(lane.x, this.groundY(), lane.z); this.group.add(lane.doll.group);\n    lane.doll.setFace(this.faceYaw ?? 0);\n    if (lane.kind === 'bot') lane.brain = new Brain(lane.skill, i + 1);\n    if (lane.kind !== 'ghost' && this.cls.standing !== false) { lane.bal = new Balancer(this.world, i, lane.x, this.groundY(), lane.z, this.balanceOpts()); lane.bal.mods.ankle = this.diff.ankle * (this.god ? 3 : 1); }\n    this.lanes.push(lane); return lane;\n  }\n  localLanes() { return this.lanes.filter(l => l.kind === 'local'); }\n  setupHud() {\n    const hud = this.game.ui.hud; hud.innerHTML = '';\n    if (this.opts.noHud) return;\n    this.hudEl = el('div'); hud.appendChild(this.hudEl);\n    const wrap = el('div', 'discwrap'); this.hudEl.appendChild(wrap);\n    const n = this.lanes.filter(l => l.kind === 'local' || (this.attract && l.id === 0));\n    if (this.showDisc !== false) for (const l of n) l.disc = new Disc(wrap, n.length > 1 ? 14 : 22, n.length > 1 ? l.name : null, l.colour);\n    this.bigEl = txt('div', 'hudbig', ''); this.timeEl = txt('div', 'hudtime', ''); this.numEl = el('div', 'hudnum'); this.msgEl = el('div', 'hudmsg'); this.widgetEl = el('div', 'widget');\n    this.hudEl.append(this.timeEl, this.numEl, this.msgEl, this.bigEl, this.widgetEl);\n    if (this.usesBreath) { this.breathEl = el('div', 'breathring'); this.breathEl.innerHTML = `<svg viewBox=\"-60 -60 120 120\" width=\"${innerHeight * .13}\" height=\"${innerHeight * .13}\"><circle r=\"50\" fill=\"#FFF8EE\" stroke=\"#1A1420\" stroke-width=\"5\"/><circle class=\"br\" r=\"20\" fill=\"#7FD6C8\" stroke=\"#1A1420\" stroke-width=\"4\"/></svg>`; this.brEl = this.breathEl.querySelector('.br'); const lbl = el('div', 'gaugeTag'); this.breathLbl = lbl; this.breathEl.appendChild(lbl); this.hudEl.appendChild(this.breathEl); }\n    if (!this.attract) { const pb = this.game.ui.bottom(this.cls.verbs); this.hudEl.appendChild(pb); }\n    this.setupHud2();\n    this.game.ui.refreshGlyphs(this.hudEl);\n  }\n  setMsg(t) { if (!this.msgEl) return; if (this._msg === t) return; this._msg = t; this.msgEl.innerHTML = ''; if (t) this.msgEl.appendChild(txt('span', '', t)); }\n  setBig(t) { if (this.bigEl && this._big !== t) { this._big = t; this.bigEl.textContent = t; } }\n  setNum(v, label = '') { if (this.numEl) { const s = `${v}|${label}`; if (this._num === s) return; this._num = s; this.numEl.textContent = String(v); if (label) this.numEl.appendChild(txt('small', '', label)); } }\n  setTime(sec) { if (this.timeEl) { const s = sec == null ? '' : String(Math.max(0, Math.ceil(sec))); if (s !== this._time) { this._time = s; this.timeEl.textContent = s; this.timeEl.style.display = s ? '' : 'none'; } } }\n  // ---------- lane input ----------\n  readInput(lane, dt) {\n    const I = lane.in;\n    if (lane.kind === 'local') {\n      const c = lane.ctrl || this.game.input.merged;\n      const [x, z] = screenToWorld(this.moveMode ? c.moveX : c.x, this.moveMode ? c.moveZ : c.z, this.camYaw);\n      I.x = x; I.z = z; I.lf = c.lf; I.rf = c.rf; I.hop = c.hop; I.hopHeld = c.hopHeld; I.flail = c.flail; I.breath = c.breath; I.tapA = c.tapA; I.tapD = c.tapD; I.keys = c.keysDown; I.dev = c.activeDevice || c.device; I.rawX = c.x; I.rawZ = c.z;\n    } else if (lane.kind === 'bot') {\n      const b = this.botInput(lane.id, this.playT, lane.skill, dt) || {};\n      I.x = b.x || 0; I.z = b.z || 0; I.lf = b.lf || 0; I.rf = b.rf || 0; I.hop = !!b.hop; I.hopHeld = !!b.hopHeld; I.flail = !!b.flail; I.breath = !!b.breath; I.tapA = false; I.tapD = false; I.keys = false; I.dev = 'pad';\n    }\n    lane.wishX = I.x; lane.wishZ = I.z;\n  }\n  botBrain(lane) { return lane.brain || (lane.brain = new Brain(this.game.testBotSkill || lane.skill, lane.id + 1)); }\n  botInput() { return { x: 0, z: 0 }; }\n  /** Dev and test: the bot playing a local lane, in screen space for a stub pad. */\n  botPad(i, skill, dt) { const lane = this.lanes[i]; if (!lane) return null; if (!lane.brain || lane.brain.name !== skill) lane.brain = new Brain(skill, i + 1); if (this.phase !== 'play') return { x: 0, z: 0 }; const b = this.botInput(i, this.playT, skill, dt) || {}; const [sx, sz] = worldToScreen(b.x || 0, b.z || 0, this.camYaw); return { ...b, x: sx, z: sz }; }\n  // ---------- fixed step ----------\n  fixed(dt) {\n    if (this.disposed) return;\n    this.t += dt;\n    if (this.phase === 'countdown') {\n      const was = Math.ceil(this.count); this.count -= dt; const now = Math.ceil(this.count);\n      if (was !== now && now > 0) this.game.audio.sfx('tick', { high: false });\n      this.setBig(now > 0 ? String(now) : '');\n      if (this.count <= 0) { this.phase = 'play'; this.playT = 0; this.game.audio.sfx('whistle'); this.setBig(''); this.onPlayStart?.(); }\n    } else if (this.phase === 'play') this.playT += dt;\n    for (const lane of this.lanes) if (lane.kind !== 'ghost') this.readInput(lane, dt);\n    if (this.phase === 'play') this.fixedPlay(dt);\n    for (const lane of this.lanes) this.stepLane(lane, dt);\n    if (this.stepping && this.world) this.world.step();\n    for (const lane of this.lanes) this.postLane(lane, dt);\n    if (this.phase === 'play') this.postPlay?.(dt);\n    for (const f of this.tickers) f(dt);\n    if (this.barkT > 0) this.barkT -= dt;\n  }\n  stepLane(lane, dt) {\n    if (!lane.bal) return;\n    const b = lane.bal;\n    if (lane.fallen) { b.step(dt, 0, 0); return; }\n    if (lane.in.flail && this.flailOk !== false) { if (b.flail()) { lane.flailN++; lane.flailT = .35; lane.doll.rig.play('flail', .05); this.game.audio.sfx('clack', { f: 1600 }); this.onFlail(lane); } }\n    if (lane.flailT > 0) { lane.flailT -= dt; if (lane.flailT <= 0) lane.doll.rig.play(lane.baseClip, .15); }\n    this.breathTick(lane, dt);\n    // Slow forcing the player has to see and counter by hand.\n    const t = b.t, ph = lane.ph, mult = (lane.breathSync ? .6 : 1) * this.diff.dist;\n    const sway = lane.sway * T.swayScale * mult, tr = lane.tremor * T.tremorScale * mult;\n    let nx = sway * (Math.sin(t * .9 + ph) * .6 + Math.sin(t * 1.73 + ph * 2.1) * .4) + tr * (Math.sin(t * 8.2 + 1.1) * .6 + Math.sin(t * 18.3) * .4);\n    let nz = sway * (Math.sin(t * .77 + ph * 1.7) * .6 + Math.sin(t * 1.51 + ph * .6) * .4) + tr * (Math.sin(t * 7.1 + 2.3) * .6 + Math.sin(t * 15.7 + .7) * .4);\n    for (let i = lane.gusts.length - 1; i >= 0; i--) { const g = lane.gusts[i]; if (g.delay > 0) { g.delay -= dt; continue; } nx += g.x * this.diff.dist; nz += g.z * this.diff.dist; g.left -= dt; if (g.left <= 0) lane.gusts.splice(i, 1); }\n    b.nx = nx + lane.extraX; b.nz = nz + lane.extraZ;\n    lane.extraX = 0; lane.extraZ = 0;\n    this.preStep(lane, dt);\n    b.step(dt, lane.wishX, lane.wishZ);\n  }\n  breathTick(lane, dt) {\n    if (!this.usesBreath) return;\n    const phase = (this.t % 8) / 8, growing = phase < .5, auto = this.game.settings?.autoBreathe;\n    const inSync = auto || (growing ? !!lane.in.breath : !lane.in.breath);\n    lane.breathHist.push(inSync ? 1 : 0); const N = 960; if (lane.breathHist.length > N) lane.breathHist.shift();\n    if (lane.breathHist.length % 30 === 0 || lane.breathHist.length === N) { let s = 0; for (const v of lane.breathHist) s += v; lane.breathSync = lane.breathHist.length >= 480 && s / lane.breathHist.length >= .7; }\n  }\n  postLane(lane, dt) {\n    if (!lane.bal) return;\n    const b = lane.bal;\n    if (lane.fallen) {\n      lane.recover -= dt;\n      if (lane.recover <= 0) this.recover(lane);\n      return;\n    }\n    if (!b.free && (b.angle || 0) > rad(T.fallAngle)) {\n      if (this.god) b.reset(); else this.fall(lane);\n    } else if ((b.angle || 0) > rad(T.fallAngle * .72) && lane.nearCd !== true) { lane.nearCd = true; this.game.rumble(lane, .4, .2); if (lane.kind === 'local' && this.barkT <= 0) this.bark('trudy', 'nearFall'); }\n    else if ((b.angle || 0) < rad(18)) lane.nearCd = false;\n  }\n  fall(lane) {\n    if (lane.fallen) return;\n    lane.fallen = true; lane.recover = T.recoverTime; lane.falls++; this.falls++;\n    const b = lane.bal, v = b.body.linvel();\n    b.setEnabled(false);\n    lane.ragdoll = new Ragdoll(this.world, lane.doll, this.group, v, { x: (b.leanX > 0 ? .08 : -.08), y: .05, z: (b.leanZ > 0 ? .08 : -.08) });\n    this.game.audio.sfx('clatter'); this.game.comic('CLACK!', lane.x, 1.4 + this.groundY(), lane.z); this.game.rumble(lane, 1, .35); this.game.hitstop(.05); this.game.rig.shake(.08);\n    this.onFall(lane);\n    if (lane.kind === 'local') { this.game.addFall(); this.bark(this.cls.instructor === 'trudy' ? 'trudy' : (this.r() < .5 ? 'trudy' : this.cls.instructor), 'fall'); }\n  }\n  recover(lane) {\n    if (!lane.fallen) return;\n    lane.fallen = false;\n    if (lane.ragdoll) { lane.ragdoll.remove(); lane.ragdoll = null; }\n    lane.bal.setEnabled(true); lane.bal.reset();\n    lane.doll.rig.play(lane.baseClip, .1); lane.doll.land(); this.game.audio.sfx('spring');\n    this.onRecover(lane);\n  }\n  bark(who, key, vars) { if (this.attract || this.sessionMode && false) return; if (this.barkT > 0) return; this.barkT = 5; this.game.bark(who, key, vars); }\n  gust(lane, x, z, dur = .5, delay = 0) { lane.gusts.push({ x: x * T.gustForce, z: z * T.gustForce, left: dur, delay }); }\n  forceGust(mag = 3) { for (const l of this.lanes) if (l.bal) this.gust(l, mag, 0); }\n  forceFall() { for (const l of this.lanes) if (l.bal && !l.fallen && l.kind !== 'ghost') this.fall(l); }\n  forceThing() {}\n  // ---------- frame ----------\n  frame(dt) {\n    if (this.disposed) return;\n    for (const lane of this.lanes) {\n      if (lane.ragdoll) lane.ragdoll.sync();\n      lane.doll.tick(dt);\n      if (lane.ragdoll) lane.ragdoll.sync();\n      if (lane.bal && !lane.fallen && !lane.customPose) { const f = lane.bal.foot.translation(); lane.doll.group.position.set(f.x, f.y, f.z); lane.doll.setLeanFromQuat(lane.bal.body.rotation()); }\n      this.frameLane(lane, dt);\n      if (lane.disc && lane.bal) {\n        const [cx, cz] = worldToScreen(lane.bal.cobX, lane.bal.cobZ, this.camYaw), [wx, wz] = worldToScreen(lane.wishX, lane.wishZ, this.camYaw);\n        let zone = lane.zone; if (zone && this.camYaw) { const [zx, zz] = worldToScreen(zone.x, zone.z, this.camYaw); zone = { x: zx, z: zz, r: zone.r }; }\n        let br = lane.brace; if (br && this.camYaw) { const [zx, zz] = worldToScreen(br.x, br.z, this.camYaw); br = { x: zx, z: zz }; }\n        lane.disc.update(dt, cx, cz, wx, wz, zone, br);\n      }\n    }\n    for (const a of this.anim) a.tick(dt);\n    if (this.brEl) {\n      const phase = (this.t % 8) / 8, g = phase < .5 ? phase * 2 : (1 - phase) * 2;\n      this.brEl.setAttribute('r', (14 + g * 34).toFixed(1));\n      const l = this.lanes[0]; this.brEl.setAttribute('fill', l && l.breathSync ? '#8FE07A' : '#7FD6C8');\n      const w = phase < .5 ? 'In' : 'Out'; if (this.breathLbl.textContent !== w) { this.breathLbl.textContent = w; this.game.audio.sfx(phase < .5 ? 'breathIn' : 'breathOut'); }\n    }\n    this.placeCamera(false);\n    this.frame2?.(dt);\n  }\n  // ---------- result ----------\n  finish() { if (this.phase === 'done') return; this.phase = 'done'; this.game.audio.sfx('whistle'); for (const l of this.lanes) { if (l.kind !== 'ghost' && !l.fallen) l.doll.rig.play(this.winClip || 'cheer', .2); } this.setBig(''); }\n  forceFinish() { this.finish(); }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.form), label: 'Form', stats: `Floor Exercises: ${l.falls}` }; }\n  /** Current session-score estimate. */\n  liveForm(i) { return this.lanes[i]?.form || 0; }\n  dispose() {\n    if (this.disposed) return; this.disposed = true;\n    for (const l of this.lanes) { if (l.ragdoll) { l.ragdoll = null; } if (l.disc) l.disc.remove(); l.brain = null; }\n    this.game.scene.remove(this.group);\n    this.group.traverse?.((o) => { if (o.isSprite && o.material) o.material.dispose(); });\n    this.onDispose?.();\n    if (this.world) { this.world.free(); this.world = null; }\n    this.game.ui.hud.innerHTML = '';\n  }\n  bodyCount() { return this.world ? this.world.bodies.len() : 0; }\n  hasNaN() { if (!this.world) return false; let bad = false; this.world.bodies.forEach((b) => { const p = b.translation(); if (!Number.isFinite(p.x + p.y + p.z)) bad = true; }); return bad; }\n  crowd(list, spec = {}) { // non-physics spectators\n    for (const g of list) { const d = makeDoll({ paint: g.paint, hat: g.hat, skin: g.skin, height: g.height || 1, width: g.width || 1 }); d.group.position.set(g.x, g.y ?? this.groundY(), g.z); d.setFace(g.yaw ?? 0); d.rig.play(g.clip || spec.clip || 'clap', 0); d.rig.mixer.setTime(cosRange(0, 1)); this.group.add(d.group); this.anim.push(d); }\n  }\n  add(o, x, y, z) { if (x !== undefined) o.position.set(x, y, z); this.group.add(o); return o; }\n}\nexport const pickLine = (who, key) => D[who]?.[key];\nE\ncat > src/events/fruitHat.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { fruitMesh, plankWalk, crate, buoy, bunting, cyl, box, at, sphere, torus, cone, mesh, toon, lantern } from '../art/props.js';\nimport { cached } from '../art/materials.js';\nimport { makeGull } from '../art/gull.js';\nconst VAL = { orange: 1, lemon: 1, plum: 1, boot: 0, pineapple: 5, urchin: -1 };\nexport class FruitHat extends EventBase {\n  static id = 'fruitHat'; static title = 'Fruit Hat'; static discipline = 'Balance Play'; static instructor = 'trudy'; static place = 'End of the pier'; static music = 'balance'; static couch = true; static session = true; static diagram = 'hat';\n  static sentence = 'A barge fires fruit. Lean to catch it in your hat, then toss it in the crate.';\n  static can = 'You can get greedy: bigger banks pay more.'; static cant = \"You can't keep fruit you haven't banked if you fall.\";\n  static verbs = [['lean', 'Lean'], ['hop', 'Bank'], ['flail', 'Flail']];\n  static tiers = [\n    { radius: .45, every: 1.6, mass: .015, ankle: 4.6, margin: .45, par: 52, time: 60 },\n    { radius: .55, every: 1.3, mass: .012, ankle: 5, margin: .6, par: 62, time: 60 },\n    { radius: .65, every: 1, mass: .012, ankle: 5, margin: .6, par: 70, time: 60 },\n  ];\n  static sessionConfig = { tier: 0, time: 50 };\n  balanceOpts() { return { ankleMax: this.tier.ankle, margin: this.tier.margin }; }\n  worldOpts() { return { iterations: 10 }; }\n  buildSet() {\n    this.faceYaw = 0; this.timeLimit = this.opts.time || this.tier.time;\n    const n = this.opts.laneCount || 1;\n    const pier = new THREE.Group(); for (let i = 0; i < 3; i++) { const pw = plankWalk(16, 3.4 + (n - 1) * 3.2); pw.position.z = 7 - i * 0; pier.add(pw); break; }\n    pier.position.y = 0; this.add(pier);\n    this.add(bunting(-4 - n, 2.6, -6, 4 + n, 2.6, -6, 14));\n    for (const s of [-1, 1]) { this.add(lantern(), s * (2 + n * 1.6), 0, -3); this.add(lantern('#F58A5C'), s * (2 + n * 1.6), 0, -7); }\n    this.add(buoy(), -7, -.4, 4); this.add(buoy('#F5F0E0'), 8, -.4, 1);\n    // Barge offshore, firing fruit toward the pier.\n    const barge = new THREE.Group(); barge.add(at(box(6, 1, 3, '#B0533A'), 0, 0, 0)); barge.add(at(box(6.4, .2, 3.3, '#7A3A28'), 0, .55, 0));\n    const cannon = cyl(.3, .4, 1.6, '#3B3550'); cannon.rotation.x = 1; barge.add(at(cannon, 0, 1.2, .3)); barge.add(at(sphere(.5, '#F58A2E'), 1.8, .95, 0)); barge.add(at(sphere(.4, '#F7E04B'), 1.1, .9, -.6)); barge.add(at(cyl(.05, .05, 2.6, '#7A5A3C'), -2.2, 1.8, 0));\n    const flag = cone(.3, .7, '#E8443A', 3); flag.rotation.z = -1.57; barge.add(at(flag, -1.85, 2.8, 0));\n    this.barge = barge; this.add(barge, 0, -.1, -22);\n    this.gull = makeGull(); this.gull.rig.play('stand'); this.add(this.gull.group, 3.2, .0, -4); this.anim.push(this.gull);\n    this.fruits = []; this.spawnT = 2; this.seq = 0;\n    this.shadowGeo = cached('shadowRing', () => new THREE.RingGeometry(.12, .2, 24));\n  }\n  placeCamera(snap) {\n    const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0;\n    const d = this.game.rig.fitDistance(5.6, spread);\n    this.game.rig.set(0, 1.5, d, 0, 1.25, -1, snap);\n  }\n  start() {\n    for (const l of this.lanes) {\n      l.score = 0; l.bankScore = 0; l.hatFruit = []; l.banks = 0; l.bankCd = 0; l.spilled = 0; l.bankedN = 0; l.baseClip = 'holdHat'; l.doll.rig.play('holdHat', 0); l.tossT = 0; l.nextBank = 7;\n      if (l.kind === 'ghost') continue;\n      const b = l.bal.body;\n      const cfg = (d, y) => RAPIER.ColliderDesc.cylinder(.02, .36).setTranslation(0, y, 0).setMass(d).setFriction(.9).setCollisionGroups(G_PROP(l.id));\n      this.world.createCollider(cfg(.01, .75), b);\n      for (let i = 0; i < 8; i++) {\n        const a = i / 8 * 6.283, s = Math.sin(-a / 2), c = Math.cos(-a / 2);\n        this.world.createCollider(RAPIER.ColliderDesc.cuboid(.02, .1, .16).setTranslation(Math.cos(a) * .36, .85, Math.sin(a) * .36).setRotation({ x: 0, y: s, z: 0, w: c }).setMass(.001).setFriction(.9).setCollisionGroups(G_PROP(l.id)), b);\n      }\n      // Visible hat on the doll: wide wicker bowl.\n      const hat = new THREE.Group();\n      const bowl = mesh(cached('hatBowl', () => new THREE.CylinderGeometry(.38, .34, .06, 24)), '#D9A86C'); hat.add(at(bowl, 0, .0, 0));\n      const rim = torus(.37, .035, '#B58457'); rim.rotation.x = Math.PI / 2; hat.add(at(rim, 0, .1, 0));\n      for (let i = 0; i < 12; i++) { const a = i / 12 * 6.283; hat.add(at(box(.03, .13, .03, '#C89B6A'), Math.cos(a) * .36, .05, Math.sin(a) * .36)); }\n      hat.position.set(0, 1.5, 0); l.doll.lean.add(hat); l.hatMesh = hat;\n      // Crate at the foot.\n      l.crate = crate(.6); l.crate.position.set(l.x + .75, 0, l.z + .1); this.group.add(l.crate);\n      l.crateCount = 0;\n    }\n  }\n  pickKind() {\n    const r = this.r(); this.seq++;\n    if (this.seq % 13 === 0) return 'pineapple';\n    if (this.seq % 11 === 0) return 'boot';\n    if (this.seq % 7 === 0) return 'urchin';\n    return r < .4 ? 'orange' : r < .7 ? 'lemon' : 'plum';\n  }\n  launch(lane, kind) {\n    const tier = this.tier, R = tier.radius * T.landingRadius;\n    const a = this.r() * 6.283, d = Math.sqrt(this.r()) * R, lx = lane.x + Math.cos(a) * d, lz = lane.z + Math.sin(a) * d;\n    const sx = lane.x + (this.r() - .5) * 3, sz = -7, sy = .5;\n    const FLY = 1.5, g = T.gravity, ty = 1.75;\n    const vx = (lx - sx) / FLY, vz = (lz - sz) / FLY, vy = (ty - sy + .5 * g * FLY * FLY) / FLY;\n    const mass = (kind === 'pineapple' ? .03 : kind === 'boot' ? .028 : kind === 'urchin' ? .012 : tier.mass) * T.fruitMass;\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(sx, sy, sz).setLinvel(vx, vy, vz).setCcdEnabled(true).setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.ball(.075).setMass(mass).setFriction(.8).setRestitution(.1).setCollisionGroups(G_PROP(lane.id)), body);\n    const m = fruitMesh(kind); this.group.add(m);\n    const ring = new THREE.Mesh(this.shadowGeo, toon(kind === 'urchin' ? '#E8443A' : '#1A1420')); ring.rotation.x = -Math.PI / 2; ring.position.set(lx, .02, lz); ring.scale.setScalar(1.6); this.group.add(ring);\n    const f = { body, m, ring, kind, lane, t: 0, fly: FLY, lx, lz, inHat: false, value: VAL[kind], landed: false };\n    this.fruits.push(f); this.game.audio.sfx('pump');\n    return f;\n  }\n  removeFruit(f) {\n    const i = this.fruits.indexOf(f); if (i >= 0) this.fruits.splice(i, 1);\n    const hi = f.lane.hatFruit.indexOf(f); if (hi >= 0) f.lane.hatFruit.splice(hi, 1);\n    this.group.remove(f.m); if (f.ring) this.group.remove(f.ring);\n    this.world.removeRigidBody(f.body);\n  }\n  bank(lane) {\n    const list = lane.hatFruit.filter(f => f.kind !== 'urchin');\n    const n = list.length; if (!n || lane.bankCd > 0 || lane.fallen) return;\n    let value = 0; for (const f of list) value += f.value;\n    const gain = value * (1 + .1 * (n - 1));\n    lane.bankScore += gain; lane.banks++; lane.bankedN += n; lane.bankCd = 1;\n    for (const f of [...lane.hatFruit]) this.removeFruit(f);\n    lane.doll.rig.play('hop', .05, lane.baseClip); lane.doll.land();\n    this.game.audio.sfx('fruit'); this.game.audio.sfx('clack', { f: 900 });\n    this.game.comic(`+${gain.toFixed(1)}`, lane.x + .8, 1.3, lane.z, '#FFD23F', .8);\n    if (lane.kind === 'local') this.bark('trudy', 'fruitBank');\n    lane.crateCount += n;\n  }\n  fixedPlay(dt) {\n    const every = this.tier.every * T.fruitInterval;\n    this.spawnT -= dt;\n    if (this.spawnT <= 0 && this.playT < this.timeLimit - 1.5) { this.spawnT = every; const kind = this.pickKind(); for (const l of this.lanes) if (l.kind !== 'ghost') this.launch(l, kind); }\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') continue;\n      l.bankCd = Math.max(0, l.bankCd - dt);\n      if (l.in.hop) this.bank(l);\n    }\n    if (this.playT >= this.timeLimit) this.finish();\n  }\n  preStep(l, dt) { // shake the top item off with a flail\n    if (l.flailT > .3 && l.hatFruit.length) { const f = l.hatFruit[l.hatFruit.length - 1]; f.body.applyImpulse({ x: (this.r() - .5) * .02, y: .03, z: (this.r() - .5) * .02 }, true); }\n  }\n  postPlay(dt) {\n    for (const f of [...this.fruits]) {\n      f.t += dt; const p = f.body.translation(), l = f.lane;\n      f.m.position.set(p.x, p.y, p.z);\n      if (!f.landed) {\n        const dhat = Math.hypot(p.x - (l.x + (l.bal?.cobX || 0) * .35), p.z - (l.z + (l.bal?.cobZ || 0) * .35));\n        if (f.t > f.fly - .08 && p.y < 2.2) {\n          const onHat = dhat < .4 && p.y > 1.35 && !l.fallen;\n          if (onHat) {\n            f.landed = true; f.inHat = true; l.hatFruit.push(f); if (f.ring) { this.group.remove(f.ring); f.ring = null; }\n            this.game.audio.sfx(f.kind === 'urchin' ? 'spike' : 'fruit'); this.game.rumble(l, .25, .08); this.game.hitstop(.016);\n            if (f.kind === 'urchin') { l.bankScore = Math.max(0, l.bankScore - 2); this.gust(l, (this.r() - .5) * 1.4, (this.r() - .5) * 1.4, .25); this.game.comic('OW!', l.x, 2, l.z, '#E8443A', .7); if (l.kind === 'local') this.bark('trudy', 'urchin'); }\n            if (f.kind === 'boot' && l.kind === 'local') this.bark('trudy', 'boot');\n            if (f.kind === 'pineapple' && l.kind === 'local') this.bark('trudy', 'golden');\n            if (l.hatFruit.length >= 8 && l.kind === 'local') this.bark('trudy', 'fruitGreedy');\n          }\n        }\n      }\n      if (f.inHat && (p.y < 1.0 || Math.hypot(p.x - l.x, p.z - l.z) > 1.2)) { f.inHat = false; const i = l.hatFruit.indexOf(f); if (i >= 0) l.hatFruit.splice(i, 1); this.game.audio.sfx('fruit'); }\n      if (f.t > f.fly + .2 && f.ring) { this.group.remove(f.ring); f.ring = null; }\n      if (p.y < -1 || f.t > 12 && !f.inHat) this.removeFruit(f);\n      else if (!f.inHat && f.t > f.fly + .5 && p.y < .15) { this.removeFruit(f); }\n    }\n    for (const l of this.lanes) if (l.kind !== 'ghost') { l.score = l.bankScore + this.unbanked(l) * .5; l.form = Math.min(100, 100 * l.score / this.tier.par); }\n  }\n  unbanked(l) { let v = 0; for (const f of l.hatFruit) if (f.kind !== 'urchin') v += f.value; const n = l.hatFruit.length; return n ? v * (1 + .1 * (n - 1)) : 0; }\n  onFall(l) { const n = l.hatFruit.length; if (n) { l.spilled += n; if (l.kind === 'local' && n > 3) this.game.bark('trudy', 'fruitSpill'); } for (const f of [...l.hatFruit]) { f.inHat = false; f.body.setLinvel({ x: (this.r() - .5) * 2, y: 1.5, z: (this.r() - .5) * 2 }, true); } l.hatFruit.length = 0; if (l.hatMesh) l.hatMesh.visible = false; }\n  onRecover(l) { if (l.hatMesh) l.hatMesh.visible = true; }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(l.score.toFixed(0), `Hat: ${l.hatFruit?.length || 0}`); this.setTime(this.timeLimit - this.playT); } if (this.barge) this.barge.position.y = -.1 + Math.sin(this.t * .9) * .08; }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); br.s = br.s;\n    // Lean only for a fruit in its last 0.95 s of flight.\n    let best = null, bt = 99; for (const f of this.fruits) { if (f.lane !== l || f.landed) continue; const left = f.fly - f.t; if (left > 0 && left < .95 - br.s.lag * .2 && left < bt) { bt = left; best = f; } }\n    let gx = 0, gz = 0; if (best && best.kind !== 'urchin') { gx = (best.lx - l.x) / .36; gz = (best.lz - l.z) / .36; const m = Math.hypot(gx, gz); if (m > 1) { gx /= m; gz /= m; } }\n    const [x, z] = br.correct(dt, l, gx, gz, l.hatFruit.length > 3);\n    const bankAt = l.bankAt ?? this.opts.bankAt ?? (skill === 'sharp' ? 7 : 5);\n    const hop = !!(bankAt < 99 && l.hatFruit.length >= bankAt && l.bankCd <= 0);\n    const flail = (l.bal?.angle || 0) > .55;\n    return { x, z, hop, flail };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.score), label: 'Fruit banked', stats: `${l.bankedN} fruit in ${l.banks} banks. Floor Exercises: ${l.falls}` }; }\n  forceThing() { const kind = 'pineapple'; for (const l of this.lanes) if (l.kind !== 'ghost') this.launch(l, kind); }\n}\nE\necho ok","description":"Write the event base class and Fruit Hat"}}}
