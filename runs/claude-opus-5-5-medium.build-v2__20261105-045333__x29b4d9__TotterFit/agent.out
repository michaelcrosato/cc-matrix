{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjk3CC1nSTe7y85g5EUw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KwhYvF8LWdCZo1RaKk3hrU","name":"Bash","input":{"command":"cd src\nsed -i 's/Math.sin(-a \\/ 2 + Math.PI \\/ 4 \\* 0)/Math.sin(-a \\/ 2)/' physics/island.js\ncat > data/palettes.js <<'E'\nexport const PALETTES = {\n  dawn:   { skyTop: '#8FB4E0', skyMid: '#F6CFD8', skyLow: '#FFE3B5', sea: '#3E8FB5', seaHi: '#A9E3E4', sun: '#FFE6D8', sunI: 2.6, hemiSky: '#FCE8F0', hemiGround: '#7C8BB5', hemiI: 1.35 },\n  noon:   { skyTop: '#6FC3E8', skyMid: '#BFE9F0', skyLow: '#FFF2D0', sea: '#16A8B0', seaHi: '#8CF0DD', sun: '#FFFBE8', sunI: 3.2, hemiSky: '#FFFFFF', hemiGround: '#A09080', hemiI: 1.35 },\n  golden: { skyTop: '#7FB7C9', skyMid: '#F7D9A6', skyLow: '#F59E6C', sea: '#1F9EA3', seaHi: '#71DCCB', sun: '#FFF0D0', sunI: 3.1, hemiSky: '#FFF4E0', hemiGround: '#8A7FA0', hemiI: 1.25 },\n  dusk:   { skyTop: '#2B2F6B', skyMid: '#A8558F', skyLow: '#F58A5C', sea: '#24406F', seaHi: '#C26A8C', sun: '#FFB98A', sunI: 2.4, hemiSky: '#B48AD0', hemiGround: '#2B2F5F', hemiI: 1.1 },\n};\nexport const PALETTE_ORDER = ['dawn', 'noon', 'golden', 'dusk'];\nE\ncat > render/ink.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { mrt, output, normalView, toonOutlinePass, color, float, vec2, vec4, uv, screenSize, Fn, abs, max,\n  smoothstep, mix, uniform, perspectiveDepthToViewZ, time, length, hash, floor, oneMinus, sin, add } from 'three/tsl';\nexport const INK = 0x1a1420;\nexport function makeInk(renderer, scene, camera) {\n  const u = { hull: uniform(.0028), width: uniform(1.4), boil: uniform(.5), fadeNear: uniform(30), fadeFar: uniform(90),\n    grain: uniform(.02), near: uniform(camera.near), far: uniform(camera.far), ink: uniform(new THREE.Color(INK)), wipe: uniform(0), on: uniform(1) };\n  const scenePass = toonOutlinePass(scene, camera, color(INK), u.hull, float(1));\n  scenePass.setMRT(mrt({ output, normal: normalView }));\n  const colorTex = scenePass.getTextureNode('output'), normalTex = scenePass.getTextureNode('normal'), depthTex = scenePass.getTextureNode('depth');\n  const post = new THREE.PostProcessing(renderer);\n  post.outputNode = Fn(() => {\n    const cell = floor(uv().mul(vec2(40, 23)));\n    const wob = hash(floor(time.mul(8)).add(cell.x).add(cell.y.mul(17))).sub(.5).mul(u.boil);\n    const px = u.width.add(wob).div(screenSize);\n    const viewZ = (o) => perspectiveDepthToViewZ(depthTex.sample(uv().add(o)).r, u.near, u.far);\n    const n = (o) => normalTex.sample(uv().add(o)).xyz;\n    const dx = vec2(px.x, 0), dy = vec2(0, px.y);\n    const z0 = viewZ(vec2(0, 0)).abs();\n    const dz = max(abs(viewZ(dx).sub(viewZ(dx.negate()))), abs(viewZ(dy).sub(viewZ(dy.negate())))).div(z0.max(.5));\n    const dn = max(length(n(dx).sub(n(dx.negate()))), length(n(dy).sub(n(dy.negate()))));\n    const e = max(smoothstep(.05, .12, dz), smoothstep(.7, 1.1, dn)).mul(oneMinus(smoothstep(u.fadeNear, u.fadeFar, z0))).mul(u.on);\n    const c = mix(colorTex.rgb, u.ink, e);\n    const p = floor(uv().mul(screenSize));\n    const g = hash(p.x.add(p.y.mul(1571))).sub(.5).mul(u.grain);\n    const base = c.add(g).mul(oneMinus(length(uv().sub(.5)).mul(.62).pow(2.2)));\n    // Ink-blot wipe: blobby noise from layered sines, inked where it falls below the wipe uniform.\n    const q = uv().mul(vec2(16, 9));\n    const blot = sin(q.x.mul(1.3).add(sin(q.y.mul(1.7)))).mul(.25).add(sin(q.y.mul(1.1).add(sin(q.x.mul(.9)).mul(1.6))).mul(.25)).add(.5);\n    const w = smoothstep(blot.sub(.02), blot.add(.02), u.wipe.mul(1.3).sub(.15));\n    return vec4(mix(base, u.ink, w), 1);\n  })();\n  return { post, u };\n}\nE\ncat > render/renderer.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { makeInk } from './ink.js';\nimport { T } from '../core/tuning.js';\nexport const R = { renderer: null, ink: null, backend: 'none', lost: null, frames: 0, sun: null, hemi: null };\nexport function makeScene() {\n  const scene = new THREE.Scene();\n  const camera = new THREE.PerspectiveCamera(38, innerWidth / Math.max(1, innerHeight), .1, 1500);\n  const hemi = new THREE.HemisphereLight(0xffffff, 0xa09080, 1.35); scene.add(hemi);\n  const sun = new THREE.DirectionalLight(0xffffff, 3); sun.position.set(24, 42, 18); sun.castShadow = true;\n  sun.shadow.mapSize.set(2048, 2048); sun.shadow.bias = -.0006; sun.shadow.normalBias = .035;\n  const c = sun.shadow.camera; c.left = -34; c.right = 34; c.top = 34; c.bottom = -34; c.near = 1; c.far = 140; scene.add(sun); scene.add(sun.target);\n  R.sun = sun; R.hemi = hemi;\n  return { scene, camera };\n}\nexport async function startRenderer(scene, camera) {\n  const canvas = document.createElement('canvas'); canvas.id = 'game'; document.body.prepend(canvas);\n  const renderer = new THREE.WebGPURenderer({ antialias: true, canvas });\n  await renderer.init();\n  renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));\n  renderer.setSize(innerWidth, innerHeight);\n  renderer.toneMapping = THREE.NoToneMapping;\n  renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFShadowMap;\n  R.renderer = renderer;\n  R.backend = renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\n  const dev = renderer.backend.device;\n  if (dev && dev.lost) dev.lost.then((i) => { R.lost = i.message || i.reason || 'device lost'; });\n  R.ink = makeInk(renderer, scene, camera);\n  addEventListener('resize', () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / Math.max(1, innerHeight); camera.updateProjectionMatrix(); });\n  return renderer;\n}\nexport function draw() {\n  if (!R.renderer) return;\n  const u = R.ink.u;\n  u.hull.value = T.inkHull * R.inkScale(); u.width.value = T.inkWidth * R.inkScale(); u.boil.value = T.inkBoil; u.grain.value = T.inkGrain;\n  R.ink.post.render(); R.frames++;\n}\nR.inkStrength = 1; R.inkOn = true;\nR.inkScale = () => (R.inkOn ? R.inkStrength : 0);\nexport function setWipe(v) { R.wipe = v; if (R.ink) R.ink.u.wipe.value = v; }\nR.wipe = 0;\nE\ncat > render/palette.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { uniform } from 'three/tsl';\nimport { PALETTES } from '../data/palettes.js';\nimport { R } from './renderer.js';\nconst c = (h) => new THREE.Color(h);\nexport const PU = { skyTop: uniform(c('#6FC3E8')), skyMid: uniform(c('#BFE9F0')), skyLow: uniform(c('#FFF2D0')), sea: uniform(c('#16A8B0')), seaHi: uniform(c('#8CF0DD')) };\nconst cur = { name: 'noon', from: null, to: null, t: 1 };\nconst KEYS = ['skyTop', 'skyMid', 'skyLow', 'sea', 'seaHi'];\nfunction snapshot(p) { const o = {}; for (const k of KEYS) o[k] = c(p[k]); o.sun = c(p.sun); o.hs = c(p.hemiSky); o.hg = c(p.hemiGround); o.sunI = p.sunI; o.hemiI = p.hemiI; return o; }\nlet live = snapshot(PALETTES.noon);\nexport function setPalette(name, instant = false) {\n  if (!PALETTES[name]) return;\n  cur.name = name; cur.to = snapshot(PALETTES[name]); cur.from = { ...live, ...Object.fromEntries(Object.entries(live).map(([k, v]) => [k, v.clone ? v.clone() : v])) };\n  cur.t = instant ? 1 : 0; apply(cur.t);\n}\nexport const paletteName = () => cur.name;\nfunction apply(a) {\n  const f = cur.from, t = cur.to; if (!t) return;\n  for (const k of KEYS) { live[k].copy(f[k]).lerp(t[k], a); PU[k].value.copy(live[k]); }\n  live.sun.copy(f.sun).lerp(t.sun, a); live.hs.copy(f.hs).lerp(t.hs, a); live.hg.copy(f.hg).lerp(t.hg, a);\n  live.sunI = f.sunI + (t.sunI - f.sunI) * a; live.hemiI = f.hemiI + (t.hemiI - f.hemiI) * a;\n  if (R.sun) { R.sun.color.copy(live.sun); R.sun.intensity = live.sunI; R.hemi.color.copy(live.hs); R.hemi.groundColor.copy(live.hg); R.hemi.intensity = live.hemiI; }\n}\nexport function tickPalette(dt) { if (cur.t < 1) { cur.t = Math.min(1, cur.t + dt / 3); apply(cur.t); } }\nE\ncat > render/sky.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { Fn, mix, smoothstep, normalize, positionWorld, cameraPosition } from 'three/tsl';\nimport { PU } from './palette.js';\nimport { toon } from '../art/materials.js';\nimport { cosRange } from '../core/rng.js';\nexport function makeSky(scene) {\n  const m = new THREE.MeshBasicNodeMaterial({ side: THREE.BackSide, depthWrite: false });\n  m.colorNode = Fn(() => {\n    const y = normalize(positionWorld.sub(cameraPosition)).y;\n    return mix(mix(PU.skyLow, PU.skyMid, smoothstep(0, .14, y)), PU.skyTop, smoothstep(.1, .5, y));\n  })();\n  const sky = new THREE.Mesh(new THREE.SphereGeometry(600, 32, 20), m); sky.frustumCulled = false; scene.add(sky);\n  const clouds = new THREE.Group(); scene.add(clouds);\n  const cm = toon('#FFF8EE'); const g = new THREE.SphereGeometry(1, 14, 10);\n  const list = [];\n  for (let i = 0; i < 16; i++) {\n    const c = new THREE.Group(); const a = cosRange(0, Math.PI * 2), d = cosRange(120, 300);\n    c.position.set(Math.cos(a) * d, cosRange(40, 95), Math.sin(a) * d);\n    for (let k = 0; k < 4; k++) { const b = new THREE.Mesh(g, cm); b.position.set(cosRange(-14, 14), cosRange(-1, 2), cosRange(-5, 5)); b.scale.set(cosRange(8, 16), cosRange(2.5, 4.5), cosRange(5, 8)); c.add(b); }\n    clouds.add(c); list.push(c);\n  }\n  return { tick(dt, camera) { sky.position.copy(camera.position); for (const c of list) { c.position.x += dt * .9; if (c.position.x > 320) c.position.x = -320; } } };\n}\nE\ncat > render/sea.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { Fn, mix, step, length, sin, time, smoothstep, positionWorld, cameraPosition, float, uniform, vec2 } from 'three/tsl';\nimport { PU } from './palette.js';\nexport const seaU = { cx: uniform(0), cz: uniform(0), foam: uniform(1), tiltX: uniform(0), tiltZ: uniform(0) };\nexport function makeSea(scene) {\n  const m = new THREE.MeshBasicNodeMaterial();\n  m.colorNode = Fn(() => {\n    const p = positionWorld.xz;\n    const warp = sin(p.x.mul(.09).add(time.mul(.3))).mul(4).add(sin(p.y.mul(.07).sub(time.mul(.22))).mul(4));\n    const wave = sin(length(p).mul(.55).add(warp).sub(time.mul(.7))).mul(.5).add(.5);\n    const c0 = mix(PU.sea, PU.seaHi, step(.86, wave));\n    const d = length(p.sub(vec2(seaU.cx, seaU.cz)));\n    // Foam near the island, plus rings that follow the tilt.\n    const bias = p.x.sub(seaU.cx).mul(seaU.tiltX).add(p.y.sub(seaU.cz).mul(seaU.tiltZ)).mul(.35);\n    const foam = step(d.add(bias), float(25)).mul(seaU.foam).add(step(.93, sin(d.add(bias).mul(1.3).sub(time.mul(1.2))).mul(.5).add(.5)).mul(oneMinusSm(d, 25, 40)).mul(seaU.foam));\n    const c1 = mix(c0, PU.seaHi, foam.clamp(0, 1).mul(.85));\n    const far = length(positionWorld.sub(cameraPosition));\n    return mix(c1, PU.skyLow, smoothstep(60, 260, far));\n  })();\n  const sea = new THREE.Mesh(new THREE.CircleGeometry(590, 72), m); sea.rotation.x = -Math.PI / 2; sea.position.y = -.6; sea.frustumCulled = false; scene.add(sea);\n  return sea;\n}\nfunction oneMinusSm(d, a, b) { return float(1).sub(smoothstep(a, b, d)); }\nE\ncat > render/cameraRig.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { cosRange } from '../core/rng.js';\nexport class CameraRig {\n  constructor(camera) { this.camera = camera; this.pos = new THREE.Vector3(0, 6, 20); this.look = new THREE.Vector3(0, 1, 0); this.wantPos = this.pos.clone(); this.wantLook = this.look.clone(); this.damp = 4; this.shakeAmt = 0; this.reduceShake = false; this.free = false; this.freeYaw = 0; this.freePitch = -.3; this.fov = 38; this.wantFov = 38; }\n  set(px, py, pz, lx, ly, lz, snap = false, fov = null) { this.wantPos.set(px, py, pz); this.wantLook.set(lx, ly, lz); if (fov) this.wantFov = fov; if (snap) { this.pos.copy(this.wantPos); this.look.copy(this.wantLook); if (fov) this.fov = fov; } }\n  /** Pull back to fit lanes: d = max(base, (spread/2 + 2.5) / tan(hfov/2)) */\n  fitDistance(base, spread) { const hf = 2 * Math.atan(Math.tan(this.fov * Math.PI / 360) * this.camera.aspect); return Math.max(base, (spread / 2 + 2.5) / Math.tan(hf / 2)); }\n  get yaw() { const dx = this.wantLook.x - this.wantPos.x, dz = this.wantLook.z - this.wantPos.z; return Math.atan2(dx, -dz); }\n  shake(a) { if (!this.reduceShake) this.shakeAmt = Math.max(this.shakeAmt, a); }\n  tick(dt) {\n    const k = 1 - Math.exp(-this.damp * dt);\n    this.pos.lerp(this.wantPos, k); this.look.lerp(this.wantLook, k);\n    this.fov += (this.wantFov - this.fov) * k;\n    this.camera.position.copy(this.pos);\n    if (this.shakeAmt > .001) { this.camera.position.x += cosRange(-1, 1) * this.shakeAmt; this.camera.position.y += cosRange(-1, 1) * this.shakeAmt; this.shakeAmt *= Math.exp(-7 * dt); }\n    if (this.camera.fov !== this.fov) { this.camera.fov = this.fov; this.camera.updateProjectionMatrix(); }\n    this.camera.lookAt(this.look);\n    if (this.free) { this.camera.position.copy(this.pos); this.camera.rotation.set(this.freePitch, this.freeYaw, 0, 'YXZ'); }\n  }\n}\n/** Screen-relative stick to world: up is away from the camera. */\nexport function screenToWorld(x, z, yaw) { const c = Math.cos(yaw), s = Math.sin(yaw); return [x * c - z * s, x * s + z * c]; }\nexport function worldToScreen(x, z, yaw) { const c = Math.cos(yaw), s = Math.sin(yaw); return [x * c + z * s, -x * s + z * c]; }\nE\ncat > render/particles.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { toon } from '../art/materials.js';\nimport { cosRange } from '../core/rng.js';\n// CPU-driven instances only: compute nodes would break the WebGL2 fallback.\nconst N = 700;\nconst m4 = new THREE.Matrix4(), col = new THREE.Color();\nexport class Particles {\n  constructor(scene) {\n    this.mesh = new THREE.InstancedMesh(new THREE.SphereGeometry(1, 8, 6), toon('#ffffff'), N); this.mesh.frustumCulled = false; this.mesh.castShadow = false;\n    for (let i = 0; i < N; i++) { this.mesh.setMatrixAt(i, m4.makeScale(0, 0, 0)); this.mesh.setColorAt(i, col.set('#ffffff')); }\n    scene.add(this.mesh); this.p = new Array(N).fill(null); this.next = 0; this.active = 0;\n  }\n  spawn(x, y, z, vx, vy, vz, size, life, color, g = 9) {\n    const i = this.next; this.next = (i + 1) % N;\n    this.p[i] = { x, y, z, vx, vy, vz, size, life, max: life, g };\n    this.mesh.setColorAt(i, col.set(color)); this.mesh.instanceColor.needsUpdate = true;\n  }\n  burst(x, y, z, n, color, speed = 3, size = .08, life = .8, up = 2) {\n    for (let k = 0; k < n; k++) { const a = cosRange(0, 6.283), s = cosRange(.3, 1) * speed; this.spawn(x, y, z, Math.cos(a) * s, up + cosRange(0, speed), Math.sin(a) * s, size * cosRange(.6, 1.3), life * cosRange(.7, 1.2), Array.isArray(color) ? color[k % color.length] : color); }\n  }\n  splash(x, y, z, big = 1) { this.burst(x, y, z, Math.floor(26 * big), ['#FFFFFF', '#BDF2F2', '#8CE0E8'], 3.2 * big, .13 * Math.sqrt(big), 1, 3 + 3.5 * big); }\n  confetti(x, y, z, n = 60) { for (let k = 0; k < n; k++) this.spawn(x + cosRange(-5, 5), y + cosRange(0, 3), z + cosRange(-3, 3), cosRange(-.6, .6), cosRange(-1, 0), cosRange(-.6, .6), .07, cosRange(2, 3.5), ['#E8443A', '#3B82F6', '#22C55E', '#F5B700', '#F58A5C'][k % 5], .8); }\n  tick(dt) {\n    let a = 0;\n    for (let i = 0; i < N; i++) {\n      const p = this.p[i]; if (!p) continue; a++;\n      p.life -= dt;\n      if (p.life <= 0) { this.p[i] = null; this.mesh.setMatrixAt(i, m4.makeScale(0, 0, 0)); continue; }\n      p.vy -= p.g * dt; p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt;\n      const s = p.size * Math.min(1, p.life / p.max * 2.5);\n      m4.makeScale(s, s, s); m4.setPosition(p.x, p.y, p.z); this.mesh.setMatrixAt(i, m4);\n    }\n    this.active = a; this.mesh.instanceMatrix.needsUpdate = true;\n  }\n  clear() { for (let i = 0; i < N; i++) if (this.p[i]) { this.p[i] = null; this.mesh.setMatrixAt(i, m4.makeScale(0, 0, 0)); } this.mesh.instanceMatrix.needsUpdate = true; }\n}\nE\ncat > render/comicText.js <<'E'\nimport * as THREE from 'three/webgpu';\n// Inked world-space words. Canvas-texture sprites that pop and fade.\nconst cache = new Map();\nfunction tex(word, color) {\n  const key = word + color; if (cache.has(key)) return cache.get(key);\n  const c = document.createElement('canvas'); c.width = 512; c.height = 180; const x = c.getContext('2d');\n  if (x) {\n    x.font = '700 110px Fredoka, sans-serif'; x.textAlign = 'center'; x.textBaseline = 'middle'; x.lineJoin = 'round';\n    x.lineWidth = 24; x.strokeStyle = '#1A1420'; x.strokeText(word, 256, 92); x.fillStyle = color; x.fillText(word, 256, 92);\n  }\n  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; cache.set(key, t); return t;\n}\nexport class ComicText {\n  constructor(scene) { this.scene = scene; this.list = []; }\n  pop(word, x, y, z, color = '#FFD23F', scale = 1, life = 1.1) {\n    const mat = new THREE.SpriteNodeMaterial({ map: tex(word, color), transparent: true, depthTest: false, depthWrite: false });\n    const s = new THREE.Sprite(mat); s.position.set(x, y, z); s.renderOrder = 10; s.center.set(.5, .5); this.scene.add(s);\n    this.list.push({ s, t: 0, life, scale, rot: 0 });\n  }\n  tick(dt) {\n    for (let i = this.list.length - 1; i >= 0; i--) {\n      const o = this.list[i]; o.t += dt; const a = o.t / o.life;\n      const pop = Math.min(1, o.t / .12); const sc = o.scale * (pop < 1 ? pop * 1.25 : 1.25 - .25 * Math.min(1, (o.t - .12) / .15));\n      o.s.scale.set(2.6 * sc, .91 * sc, 1); o.s.position.y += dt * .4; o.s.material.opacity = a > .7 ? 1 - (a - .7) / .3 : 1;\n      if (a >= 1) { this.scene.remove(o.s); o.s.material.dispose(); this.list.splice(i, 1); }\n    }\n  }\n  clear() { for (const o of this.list) { this.scene.remove(o.s); o.s.material.dispose(); } this.list.length = 0; }\n}\nE\ncat > art/materials.js <<'E'\nimport * as THREE from 'three/webgpu';\nconst ramp = new THREE.DataTexture(new Uint8Array([96, 178, 255]), 3, 1, THREE.RedFormat);\nramp.minFilter = THREE.NearestFilter; ramp.magFilter = THREE.NearestFilter; ramp.colorSpace = THREE.NoColorSpace; ramp.needsUpdate = true;\nconst cache = new Map();\nexport function toon(color) {\n  const k = String(color);\n  if (!cache.has(k)) cache.set(k, new THREE.MeshToonNodeMaterial({ color, gradientMap: ramp }));\n  return cache.get(k);\n}\nexport const glass = () => new THREE.MeshBasicNodeMaterial({ color: 0xe8fbff, transparent: true, opacity: .16, side: THREE.DoubleSide, depthWrite: false });\nexport const flat = (color, opacity = 1) => new THREE.MeshBasicNodeMaterial({ color, transparent: opacity < 1, opacity, depthWrite: opacity >= 1 });\nconst geo = new Map();\nexport function cached(key, make) { if (!geo.has(key)) geo.set(key, make()); return geo.get(key); }\nexport function mesh(g, color, shadow = true) { const m = new THREE.Mesh(g, typeof color === 'object' ? color : toon(color)); m.castShadow = shadow; m.receiveShadow = shadow; return m; }\nexport const sphere = (r, color, sx = 1, sy = 1, sz = 1) => { const m = mesh(cached('s', () => new THREE.SphereGeometry(1, 20, 14)), color); m.scale.set(r * sx, r * sy, r * sz); return m; };\nexport const capsule = (r, len, color) => mesh(cached(`c${r}_${len}`, () => new THREE.CapsuleGeometry(r, len, 6, 14)), color);\nexport const cyl = (rt, rb, h, color, seg = 18) => mesh(cached(`y${rt}_${rb}_${h}_${seg}`, () => new THREE.CylinderGeometry(rt, rb, h, seg)), color);\nexport const cone = (r, h, color, seg = 14) => mesh(cached(`k${r}_${h}_${seg}`, () => new THREE.ConeGeometry(r, h, seg)), color);\nexport const torus = (r, t, color, arc = Math.PI * 2) => mesh(cached(`t${r}_${t}_${arc}`, () => new THREE.TorusGeometry(r, t, 10, 28, arc)), color);\nexport const box = (x, y, z, color) => mesh(cached(`b${x}_${y}_${z}`, () => new THREE.BoxGeometry(x, y, z)), color);\nexport const at = (m, x, y, z) => { m.position.set(x, y, z); return m; };\nE\ncat > art/props.js <<'E'\n// Generic builders for sets and scenery.\nimport * as THREE from 'three/webgpu';\nimport { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';\nimport { toon, cached, mesh, sphere, cyl, cone, box, at, torus, capsule } from './materials.js';\nimport { cosmetic, cosRange, pick } from '../core/rng.js';\nexport const rbox = (x, y, z, r, color) => mesh(cached(`rb${x}_${y}_${z}_${r}`, () => new RoundedBoxGeometry(x, y, z, 3, r)), color);\nexport function tree(scale = 1, top = '#6FBF5A') {\n  const g = new THREE.Group();\n  g.add(at(cyl(.14, .2, 1.3, '#B58457'), 0, .65, 0));\n  g.add(at(sphere(.85, top), 0, 1.75, 0));\n  g.add(at(sphere(.5, top), .45, 1.45, .2));\n  g.scale.setScalar(scale); return g;\n}\nexport function palm(scale = 1) {\n  const g = new THREE.Group();\n  for (let i = 0; i < 5; i++) { const c = at(cyl(.11 - i * .012, .13 - i * .012, .55, i % 2 ? '#B58457' : '#9C7048'), i * i * .018, .27 + i * .52, 0); c.rotation.z = -i * .05; g.add(c); }\n  for (let i = 0; i < 6; i++) { const a = i / 6 * 6.283; const l = sphere(.72, '#3FA66B', 1, .1, .24); l.position.set(.3 + Math.cos(a) * .55, 2.75, Math.sin(a) * .55); l.rotation.y = -a; l.rotation.z = -.5; g.add(l); }\n  g.scale.setScalar(scale); return g;\n}\nexport function bunting(ax, ay, az, bx, by, bz, n = 10) {\n  const g = new THREE.Group(); const cols = ['#E8443A', '#F5B700', '#3B82F6', '#22C55E', '#F58A5C'];\n  const curve = new THREE.QuadraticBezierCurve3(new THREE.Vector3(ax, ay, az), new THREE.Vector3((ax + bx) / 2, Math.min(ay, by) - .6, (az + bz) / 2), new THREE.Vector3(bx, by, bz));\n  g.add(mesh(new THREE.TubeGeometry(curve, 12, .012, 5), '#1A1420', false));\n  for (let i = 1; i < n; i++) { const p = curve.getPoint(i / n); const f = cone(.11, .24, cols[i % 5], 3); f.position.copy(p); f.position.y -= .13; f.rotation.x = Math.PI; g.add(f); }\n  return g;\n}\nexport function pavilion(w = 3, d = 3, h = 2.4, roof = '#2FA7A0', post = '#E9D3AE') {\n  const g = new THREE.Group();\n  for (const [x, z] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) g.add(at(box(.24, h, .24, post), x * w / 2, h / 2, z * d / 2));\n  g.add(at(rbox(w + .9, .3, d + .9, .12, roof), 0, h + .15, 0));\n  g.add(at(rbox(w * .6, .24, d * .6, .1, '#F58A5C'), 0, h + .42, 0));\n  g.add(at(rbox(w + .2, .14, d + .2, .05, '#D9B98A'), 0, .07, 0));\n  return g;\n}\nexport function deck(radius = 3, color = '#C89B6A', stilts = true, y = 0) {\n  const g = new THREE.Group();\n  const t = cyl(radius, radius, .2, color, 28); t.position.y = y - .1; g.add(t);\n  for (let i = 0; i < 8; i++) { const a = i / 8 * 6.283; const line = box(radius * 2 * .94 * Math.abs(Math.cos(0)), .01, .03, '#9C7048'); line.position.set(0, y + .002, -radius * .8 + i * radius * .23); line.scale.x = Math.sqrt(Math.max(.02, 1 - Math.pow((-.8 + i * .23), 2))); g.add(line); void a; }\n  if (stilts) for (let i = 0; i < 6; i++) { const a = i / 6 * 6.283; g.add(at(cyl(.12, .14, 4, '#7A5A3C'), Math.cos(a) * radius * .85, y - 2.1, Math.sin(a) * radius * .85)); }\n  return g;\n}\nexport function plankWalk(len, width, color = '#C89B6A', y = 0) {\n  const g = new THREE.Group(); const n = Math.floor(len / .55);\n  for (let i = 0; i < n; i++) { const p = box(width, .1, .49, i % 3 === 0 ? '#BE9160' : color); p.position.set(0, y - .05, -i * .55 - .27); g.add(p); }\n  for (let i = 0; i <= Math.floor(len / 5); i++) for (const s of [-1, 1]) g.add(at(cyl(.09, .11, 3.4, '#7A5A3C'), s * (width / 2 + .05), y - 1.3, -i * 5));\n  return g;\n}\nexport function buoy(color = '#E8443A') { const g = new THREE.Group(); g.add(at(sphere(.3, color, 1, .8, 1), 0, -.25, 0)); g.add(at(cyl(.03, .03, .5, '#F5F0E0'), 0, .15, 0)); g.add(at(sphere(.06, '#F5B700'), 0, .42, 0)); return g; }\nexport function crate(s = .6, color = '#C89B6A') { const g = new THREE.Group(); g.add(at(box(s, s * .7, s, color), 0, s * .35, 0)); g.add(at(box(s + .03, .05, s + .03, '#8F6A42'), 0, s * .7, 0)); g.add(at(box(s + .03, .05, s + .03, '#8F6A42'), 0, .03, 0)); return g; }\nexport function lantern(color = '#F5B700') { const g = new THREE.Group(); g.add(at(cyl(.04, .05, 2, '#7A5A3C'), 0, 1, 0)); g.add(at(sphere(.17, color), 0, 2.1, 0)); return g; }\nexport function rock(s = 1, color = '#A69A8C') { const m = sphere(s, color, 1.2, .7, 1); m.rotation.y = cosmetic() * 6; return m; }\nexport function grassPatch(r, color = '#7CC568') { const c = cyl(r, r, .04, color, 24); return c; }\nexport function stoneStack(n = 3) { const g = new THREE.Group(); let y = 0; for (let i = 0; i < n; i++) { const r = .3 - i * .07, h = .1; const s = sphere(r, ['#A69A8C', '#BDB2A2', '#8F8578'][i % 3], 1, .4, .85); y += h; s.position.y = y; y += h * .6; g.add(s); } return g; }\nexport function bench() { const g = new THREE.Group(); g.add(at(box(1.5, .08, .4, '#E9D3AE'), 0, .45, 0)); g.add(at(box(.1, .45, .35, '#7A5A3C'), -.6, .22, 0)); g.add(at(box(.1, .45, .35, '#7A5A3C'), .6, .22, 0)); return g; }\nexport function fruitMesh(kind) {\n  switch (kind) {\n    case 'urchin': { const g = new THREE.Group(); g.add(sphere(.075, '#3B2A55')); for (let i = 0; i < 10; i++) { const s = cone(.015, .09, '#3B2A55', 5); const a = i * 2.4, b = (i / 10) * Math.PI; s.position.set(Math.sin(b) * Math.cos(a) * .09, Math.cos(b) * .09, Math.sin(b) * Math.sin(a) * .09); s.lookAt(s.position.clone().multiplyScalar(2)); s.rotateX(Math.PI / 2); g.add(s); } return g; }\n    case 'boot': { const g = new THREE.Group(); g.add(at(box(.1, .14, .1, '#6B4A2F'), 0, .02, -.02)); g.add(at(box(.1, .06, .19, '#54381F'), 0, -.06, .02)); return g; }\n    case 'pineapple': { const g = new THREE.Group(); g.add(sphere(.085, '#F5B700', 1, 1.25, 1)); const c = cone(.05, .1, '#3FA66B', 6); c.position.y = .13; g.add(c); return g; }\n    case 'lemon': return sphere(.075, '#F7E04B', 1, .88, .88);\n    case 'plum': return sphere(.075, '#8B3F8F');\n    default: return sphere(.075, '#F58A2E');\n  }\n}\nexport function plate(r, color) { const g = new THREE.Group(); const c = cyl(r, r * .6, .05, color, 20); g.add(c); g.add(at(torus(r, .018, '#1A1420'), 0, .02, 0)).children[1].rotation.x = Math.PI / 2; return g; }\nexport { sphere, cyl, cone, box, at, torus, capsule, cached, mesh, toon, pick, cosRange };\nE\necho done","description":"Write render, palette, sky, sea, particle and prop modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19465,"cache_read_input_tokens":98182,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19465},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"fd309b0d-5969-4e65-9897-f700edf2849c","timestamp":"2026-11-05T12:00:56.459Z","request_id":"req_011Cgjk3BrvhCWKN4KFf4bYz","wire_tool_inputs":{"toolu_01KwhYvF8LWdCZo1RaKk3hrU":{"command":"cd src\nsed -i 's/Math.sin(-a \\/ 2 + Math.PI \\/ 4 \\* 0)/Math.sin(-a \\/ 2)/' physics/island.js\ncat > data/palettes.js <<'E'\nexport const PALETTES = {\n  dawn:   { skyTop: '#8FB4E0', skyMid: '#F6CFD8', skyLow: '#FFE3B5', sea: '#3E8FB5', seaHi: '#A9E3E4', sun: '#FFE6D8', sunI: 2.6, hemiSky: '#FCE8F0', hemiGround: '#7C8BB5', hemiI: 1.35 },\n  noon:   { skyTop: '#6FC3E8', skyMid: '#BFE9F0', skyLow: '#FFF2D0', sea: '#16A8B0', seaHi: '#8CF0DD', sun: '#FFFBE8', sunI: 3.2, hemiSky: '#FFFFFF', hemiGround: '#A09080', hemiI: 1.35 },\n  golden: { skyTop: '#7FB7C9', skyMid: '#F7D9A6', skyLow: '#F59E6C', sea: '#1F9EA3', seaHi: '#71DCCB', sun: '#FFF0D0', sunI: 3.1, hemiSky: '#FFF4E0', hemiGround: '#8A7FA0', hemiI: 1.25 },\n  dusk:   { skyTop: '#2B2F6B', skyMid: '#A8558F', skyLow: '#F58A5C', sea: '#24406F', seaHi: '#C26A8C', sun: '#FFB98A', sunI: 2.4, hemiSky: '#B48AD0', hemiGround: '#2B2F5F', hemiI: 1.1 },\n};\nexport const PALETTE_ORDER = ['dawn', 'noon', 'golden', 'dusk'];\nE\ncat > render/ink.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { mrt, output, normalView, toonOutlinePass, color, float, vec2, vec4, uv, screenSize, Fn, abs, max,\n  smoothstep, mix, uniform, perspectiveDepthToViewZ, time, length, hash, floor, oneMinus, sin, add } from 'three/tsl';\nexport const INK = 0x1a1420;\nexport function makeInk(renderer, scene, camera) {\n  const u = { hull: uniform(.0028), width: uniform(1.4), boil: uniform(.5), fadeNear: uniform(30), fadeFar: uniform(90),\n    grain: uniform(.02), near: uniform(camera.near), far: uniform(camera.far), ink: uniform(new THREE.Color(INK)), wipe: uniform(0), on: uniform(1) };\n  const scenePass = toonOutlinePass(scene, camera, color(INK), u.hull, float(1));\n  scenePass.setMRT(mrt({ output, normal: normalView }));\n  const colorTex = scenePass.getTextureNode('output'), normalTex = scenePass.getTextureNode('normal'), depthTex = scenePass.getTextureNode('depth');\n  const post = new THREE.PostProcessing(renderer);\n  post.outputNode = Fn(() => {\n    const cell = floor(uv().mul(vec2(40, 23)));\n    const wob = hash(floor(time.mul(8)).add(cell.x).add(cell.y.mul(17))).sub(.5).mul(u.boil);\n    const px = u.width.add(wob).div(screenSize);\n    const viewZ = (o) => perspectiveDepthToViewZ(depthTex.sample(uv().add(o)).r, u.near, u.far);\n    const n = (o) => normalTex.sample(uv().add(o)).xyz;\n    const dx = vec2(px.x, 0), dy = vec2(0, px.y);\n    const z0 = viewZ(vec2(0, 0)).abs();\n    const dz = max(abs(viewZ(dx).sub(viewZ(dx.negate()))), abs(viewZ(dy).sub(viewZ(dy.negate())))).div(z0.max(.5));\n    const dn = max(length(n(dx).sub(n(dx.negate()))), length(n(dy).sub(n(dy.negate()))));\n    const e = max(smoothstep(.05, .12, dz), smoothstep(.7, 1.1, dn)).mul(oneMinus(smoothstep(u.fadeNear, u.fadeFar, z0))).mul(u.on);\n    const c = mix(colorTex.rgb, u.ink, e);\n    const p = floor(uv().mul(screenSize));\n    const g = hash(p.x.add(p.y.mul(1571))).sub(.5).mul(u.grain);\n    const base = c.add(g).mul(oneMinus(length(uv().sub(.5)).mul(.62).pow(2.2)));\n    // Ink-blot wipe: blobby noise from layered sines, inked where it falls below the wipe uniform.\n    const q = uv().mul(vec2(16, 9));\n    const blot = sin(q.x.mul(1.3).add(sin(q.y.mul(1.7)))).mul(.25).add(sin(q.y.mul(1.1).add(sin(q.x.mul(.9)).mul(1.6))).mul(.25)).add(.5);\n    const w = smoothstep(blot.sub(.02), blot.add(.02), u.wipe.mul(1.3).sub(.15));\n    return vec4(mix(base, u.ink, w), 1);\n  })();\n  return { post, u };\n}\nE\ncat > render/renderer.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { makeInk } from './ink.js';\nimport { T } from '../core/tuning.js';\nexport const R = { renderer: null, ink: null, backend: 'none', lost: null, frames: 0, sun: null, hemi: null };\nexport function makeScene() {\n  const scene = new THREE.Scene();\n  const camera = new THREE.PerspectiveCamera(38, innerWidth / Math.max(1, innerHeight), .1, 1500);\n  const hemi = new THREE.HemisphereLight(0xffffff, 0xa09080, 1.35); scene.add(hemi);\n  const sun = new THREE.DirectionalLight(0xffffff, 3); sun.position.set(24, 42, 18); sun.castShadow = true;\n  sun.shadow.mapSize.set(2048, 2048); sun.shadow.bias = -.0006; sun.shadow.normalBias = .035;\n  const c = sun.shadow.camera; c.left = -34; c.right = 34; c.top = 34; c.bottom = -34; c.near = 1; c.far = 140; scene.add(sun); scene.add(sun.target);\n  R.sun = sun; R.hemi = hemi;\n  return { scene, camera };\n}\nexport async function startRenderer(scene, camera) {\n  const canvas = document.createElement('canvas'); canvas.id = 'game'; document.body.prepend(canvas);\n  const renderer = new THREE.WebGPURenderer({ antialias: true, canvas });\n  await renderer.init();\n  renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));\n  renderer.setSize(innerWidth, innerHeight);\n  renderer.toneMapping = THREE.NoToneMapping;\n  renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFShadowMap;\n  R.renderer = renderer;\n  R.backend = renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\n  const dev = renderer.backend.device;\n  if (dev && dev.lost) dev.lost.then((i) => { R.lost = i.message || i.reason || 'device lost'; });\n  R.ink = makeInk(renderer, scene, camera);\n  addEventListener('resize', () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / Math.max(1, innerHeight); camera.updateProjectionMatrix(); });\n  return renderer;\n}\nexport function draw() {\n  if (!R.renderer) return;\n  const u = R.ink.u;\n  u.hull.value = T.inkHull * R.inkScale(); u.width.value = T.inkWidth * R.inkScale(); u.boil.value = T.inkBoil; u.grain.value = T.inkGrain;\n  R.ink.post.render(); R.frames++;\n}\nR.inkStrength = 1; R.inkOn = true;\nR.inkScale = () => (R.inkOn ? R.inkStrength : 0);\nexport function setWipe(v) { R.wipe = v; if (R.ink) R.ink.u.wipe.value = v; }\nR.wipe = 0;\nE\ncat > render/palette.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { uniform } from 'three/tsl';\nimport { PALETTES } from '../data/palettes.js';\nimport { R } from './renderer.js';\nconst c = (h) => new THREE.Color(h);\nexport const PU = { skyTop: uniform(c('#6FC3E8')), skyMid: uniform(c('#BFE9F0')), skyLow: uniform(c('#FFF2D0')), sea: uniform(c('#16A8B0')), seaHi: uniform(c('#8CF0DD')) };\nconst cur = { name: 'noon', from: null, to: null, t: 1 };\nconst KEYS = ['skyTop', 'skyMid', 'skyLow', 'sea', 'seaHi'];\nfunction snapshot(p) { const o = {}; for (const k of KEYS) o[k] = c(p[k]); o.sun = c(p.sun); o.hs = c(p.hemiSky); o.hg = c(p.hemiGround); o.sunI = p.sunI; o.hemiI = p.hemiI; return o; }\nlet live = snapshot(PALETTES.noon);\nexport function setPalette(name, instant = false) {\n  if (!PALETTES[name]) return;\n  cur.name = name; cur.to = snapshot(PALETTES[name]); cur.from = { ...live, ...Object.fromEntries(Object.entries(live).map(([k, v]) => [k, v.clone ? v.clone() : v])) };\n  cur.t = instant ? 1 : 0; apply(cur.t);\n}\nexport const paletteName = () => cur.name;\nfunction apply(a) {\n  const f = cur.from, t = cur.to; if (!t) return;\n  for (const k of KEYS) { live[k].copy(f[k]).lerp(t[k], a); PU[k].value.copy(live[k]); }\n  live.sun.copy(f.sun).lerp(t.sun, a); live.hs.copy(f.hs).lerp(t.hs, a); live.hg.copy(f.hg).lerp(t.hg, a);\n  live.sunI = f.sunI + (t.sunI - f.sunI) * a; live.hemiI = f.hemiI + (t.hemiI - f.hemiI) * a;\n  if (R.sun) { R.sun.color.copy(live.sun); R.sun.intensity = live.sunI; R.hemi.color.copy(live.hs); R.hemi.groundColor.copy(live.hg); R.hemi.intensity = live.hemiI; }\n}\nexport function tickPalette(dt) { if (cur.t < 1) { cur.t = Math.min(1, cur.t + dt / 3); apply(cur.t); } }\nE\ncat > render/sky.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { Fn, mix, smoothstep, normalize, positionWorld, cameraPosition } from 'three/tsl';\nimport { PU } from './palette.js';\nimport { toon } from '../art/materials.js';\nimport { cosRange } from '../core/rng.js';\nexport function makeSky(scene) {\n  const m = new THREE.MeshBasicNodeMaterial({ side: THREE.BackSide, depthWrite: false });\n  m.colorNode = Fn(() => {\n    const y = normalize(positionWorld.sub(cameraPosition)).y;\n    return mix(mix(PU.skyLow, PU.skyMid, smoothstep(0, .14, y)), PU.skyTop, smoothstep(.1, .5, y));\n  })();\n  const sky = new THREE.Mesh(new THREE.SphereGeometry(600, 32, 20), m); sky.frustumCulled = false; scene.add(sky);\n  const clouds = new THREE.Group(); scene.add(clouds);\n  const cm = toon('#FFF8EE'); const g = new THREE.SphereGeometry(1, 14, 10);\n  const list = [];\n  for (let i = 0; i < 16; i++) {\n    const c = new THREE.Group(); const a = cosRange(0, Math.PI * 2), d = cosRange(120, 300);\n    c.position.set(Math.cos(a) * d, cosRange(40, 95), Math.sin(a) * d);\n    for (let k = 0; k < 4; k++) { const b = new THREE.Mesh(g, cm); b.position.set(cosRange(-14, 14), cosRange(-1, 2), cosRange(-5, 5)); b.scale.set(cosRange(8, 16), cosRange(2.5, 4.5), cosRange(5, 8)); c.add(b); }\n    clouds.add(c); list.push(c);\n  }\n  return { tick(dt, camera) { sky.position.copy(camera.position); for (const c of list) { c.position.x += dt * .9; if (c.position.x > 320) c.position.x = -320; } } };\n}\nE\ncat > render/sea.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { Fn, mix, step, length, sin, time, smoothstep, positionWorld, cameraPosition, float, uniform, vec2 } from 'three/tsl';\nimport { PU } from './palette.js';\nexport const seaU = { cx: uniform(0), cz: uniform(0), foam: uniform(1), tiltX: uniform(0), tiltZ: uniform(0) };\nexport function makeSea(scene) {\n  const m = new THREE.MeshBasicNodeMaterial();\n  m.colorNode = Fn(() => {\n    const p = positionWorld.xz;\n    const warp = sin(p.x.mul(.09).add(time.mul(.3))).mul(4).add(sin(p.y.mul(.07).sub(time.mul(.22))).mul(4));\n    const wave = sin(length(p).mul(.55).add(warp).sub(time.mul(.7))).mul(.5).add(.5);\n    const c0 = mix(PU.sea, PU.seaHi, step(.86, wave));\n    const d = length(p.sub(vec2(seaU.cx, seaU.cz)));\n    // Foam near the island, plus rings that follow the tilt.\n    const bias = p.x.sub(seaU.cx).mul(seaU.tiltX).add(p.y.sub(seaU.cz).mul(seaU.tiltZ)).mul(.35);\n    const foam = step(d.add(bias), float(25)).mul(seaU.foam).add(step(.93, sin(d.add(bias).mul(1.3).sub(time.mul(1.2))).mul(.5).add(.5)).mul(oneMinusSm(d, 25, 40)).mul(seaU.foam));\n    const c1 = mix(c0, PU.seaHi, foam.clamp(0, 1).mul(.85));\n    const far = length(positionWorld.sub(cameraPosition));\n    return mix(c1, PU.skyLow, smoothstep(60, 260, far));\n  })();\n  const sea = new THREE.Mesh(new THREE.CircleGeometry(590, 72), m); sea.rotation.x = -Math.PI / 2; sea.position.y = -.6; sea.frustumCulled = false; scene.add(sea);\n  return sea;\n}\nfunction oneMinusSm(d, a, b) { return float(1).sub(smoothstep(a, b, d)); }\nE\ncat > render/cameraRig.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { cosRange } from '../core/rng.js';\nexport class CameraRig {\n  constructor(camera) { this.camera = camera; this.pos = new THREE.Vector3(0, 6, 20); this.look = new THREE.Vector3(0, 1, 0); this.wantPos = this.pos.clone(); this.wantLook = this.look.clone(); this.damp = 4; this.shakeAmt = 0; this.reduceShake = false; this.free = false; this.freeYaw = 0; this.freePitch = -.3; this.fov = 38; this.wantFov = 38; }\n  set(px, py, pz, lx, ly, lz, snap = false, fov = null) { this.wantPos.set(px, py, pz); this.wantLook.set(lx, ly, lz); if (fov) this.wantFov = fov; if (snap) { this.pos.copy(this.wantPos); this.look.copy(this.wantLook); if (fov) this.fov = fov; } }\n  /** Pull back to fit lanes: d = max(base, (spread/2 + 2.5) / tan(hfov/2)) */\n  fitDistance(base, spread) { const hf = 2 * Math.atan(Math.tan(this.fov * Math.PI / 360) * this.camera.aspect); return Math.max(base, (spread / 2 + 2.5) / Math.tan(hf / 2)); }\n  get yaw() { const dx = this.wantLook.x - this.wantPos.x, dz = this.wantLook.z - this.wantPos.z; return Math.atan2(dx, -dz); }\n  shake(a) { if (!this.reduceShake) this.shakeAmt = Math.max(this.shakeAmt, a); }\n  tick(dt) {\n    const k = 1 - Math.exp(-this.damp * dt);\n    this.pos.lerp(this.wantPos, k); this.look.lerp(this.wantLook, k);\n    this.fov += (this.wantFov - this.fov) * k;\n    this.camera.position.copy(this.pos);\n    if (this.shakeAmt > .001) { this.camera.position.x += cosRange(-1, 1) * this.shakeAmt; this.camera.position.y += cosRange(-1, 1) * this.shakeAmt; this.shakeAmt *= Math.exp(-7 * dt); }\n    if (this.camera.fov !== this.fov) { this.camera.fov = this.fov; this.camera.updateProjectionMatrix(); }\n    this.camera.lookAt(this.look);\n    if (this.free) { this.camera.position.copy(this.pos); this.camera.rotation.set(this.freePitch, this.freeYaw, 0, 'YXZ'); }\n  }\n}\n/** Screen-relative stick to world: up is away from the camera. */\nexport function screenToWorld(x, z, yaw) { const c = Math.cos(yaw), s = Math.sin(yaw); return [x * c - z * s, x * s + z * c]; }\nexport function worldToScreen(x, z, yaw) { const c = Math.cos(yaw), s = Math.sin(yaw); return [x * c + z * s, -x * s + z * c]; }\nE\ncat > render/particles.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { toon } from '../art/materials.js';\nimport { cosRange } from '../core/rng.js';\n// CPU-driven instances only: compute nodes would break the WebGL2 fallback.\nconst N = 700;\nconst m4 = new THREE.Matrix4(), col = new THREE.Color();\nexport class Particles {\n  constructor(scene) {\n    this.mesh = new THREE.InstancedMesh(new THREE.SphereGeometry(1, 8, 6), toon('#ffffff'), N); this.mesh.frustumCulled = false; this.mesh.castShadow = false;\n    for (let i = 0; i < N; i++) { this.mesh.setMatrixAt(i, m4.makeScale(0, 0, 0)); this.mesh.setColorAt(i, col.set('#ffffff')); }\n    scene.add(this.mesh); this.p = new Array(N).fill(null); this.next = 0; this.active = 0;\n  }\n  spawn(x, y, z, vx, vy, vz, size, life, color, g = 9) {\n    const i = this.next; this.next = (i + 1) % N;\n    this.p[i] = { x, y, z, vx, vy, vz, size, life, max: life, g };\n    this.mesh.setColorAt(i, col.set(color)); this.mesh.instanceColor.needsUpdate = true;\n  }\n  burst(x, y, z, n, color, speed = 3, size = .08, life = .8, up = 2) {\n    for (let k = 0; k < n; k++) { const a = cosRange(0, 6.283), s = cosRange(.3, 1) * speed; this.spawn(x, y, z, Math.cos(a) * s, up + cosRange(0, speed), Math.sin(a) * s, size * cosRange(.6, 1.3), life * cosRange(.7, 1.2), Array.isArray(color) ? color[k % color.length] : color); }\n  }\n  splash(x, y, z, big = 1) { this.burst(x, y, z, Math.floor(26 * big), ['#FFFFFF', '#BDF2F2', '#8CE0E8'], 3.2 * big, .13 * Math.sqrt(big), 1, 3 + 3.5 * big); }\n  confetti(x, y, z, n = 60) { for (let k = 0; k < n; k++) this.spawn(x + cosRange(-5, 5), y + cosRange(0, 3), z + cosRange(-3, 3), cosRange(-.6, .6), cosRange(-1, 0), cosRange(-.6, .6), .07, cosRange(2, 3.5), ['#E8443A', '#3B82F6', '#22C55E', '#F5B700', '#F58A5C'][k % 5], .8); }\n  tick(dt) {\n    let a = 0;\n    for (let i = 0; i < N; i++) {\n      const p = this.p[i]; if (!p) continue; a++;\n      p.life -= dt;\n      if (p.life <= 0) { this.p[i] = null; this.mesh.setMatrixAt(i, m4.makeScale(0, 0, 0)); continue; }\n      p.vy -= p.g * dt; p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt;\n      const s = p.size * Math.min(1, p.life / p.max * 2.5);\n      m4.makeScale(s, s, s); m4.setPosition(p.x, p.y, p.z); this.mesh.setMatrixAt(i, m4);\n    }\n    this.active = a; this.mesh.instanceMatrix.needsUpdate = true;\n  }\n  clear() { for (let i = 0; i < N; i++) if (this.p[i]) { this.p[i] = null; this.mesh.setMatrixAt(i, m4.makeScale(0, 0, 0)); } this.mesh.instanceMatrix.needsUpdate = true; }\n}\nE\ncat > render/comicText.js <<'E'\nimport * as THREE from 'three/webgpu';\n// Inked world-space words. Canvas-texture sprites that pop and fade.\nconst cache = new Map();\nfunction tex(word, color) {\n  const key = word + color; if (cache.has(key)) return cache.get(key);\n  const c = document.createElement('canvas'); c.width = 512; c.height = 180; const x = c.getContext('2d');\n  if (x) {\n    x.font = '700 110px Fredoka, sans-serif'; x.textAlign = 'center'; x.textBaseline = 'middle'; x.lineJoin = 'round';\n    x.lineWidth = 24; x.strokeStyle = '#1A1420'; x.strokeText(word, 256, 92); x.fillStyle = color; x.fillText(word, 256, 92);\n  }\n  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; cache.set(key, t); return t;\n}\nexport class ComicText {\n  constructor(scene) { this.scene = scene; this.list = []; }\n  pop(word, x, y, z, color = '#FFD23F', scale = 1, life = 1.1) {\n    const mat = new THREE.SpriteNodeMaterial({ map: tex(word, color), transparent: true, depthTest: false, depthWrite: false });\n    const s = new THREE.Sprite(mat); s.position.set(x, y, z); s.renderOrder = 10; s.center.set(.5, .5); this.scene.add(s);\n    this.list.push({ s, t: 0, life, scale, rot: 0 });\n  }\n  tick(dt) {\n    for (let i = this.list.length - 1; i >= 0; i--) {\n      const o = this.list[i]; o.t += dt; const a = o.t / o.life;\n      const pop = Math.min(1, o.t / .12); const sc = o.scale * (pop < 1 ? pop * 1.25 : 1.25 - .25 * Math.min(1, (o.t - .12) / .15));\n      o.s.scale.set(2.6 * sc, .91 * sc, 1); o.s.position.y += dt * .4; o.s.material.opacity = a > .7 ? 1 - (a - .7) / .3 : 1;\n      if (a >= 1) { this.scene.remove(o.s); o.s.material.dispose(); this.list.splice(i, 1); }\n    }\n  }\n  clear() { for (const o of this.list) { this.scene.remove(o.s); o.s.material.dispose(); } this.list.length = 0; }\n}\nE\ncat > art/materials.js <<'E'\nimport * as THREE from 'three/webgpu';\nconst ramp = new THREE.DataTexture(new Uint8Array([96, 178, 255]), 3, 1, THREE.RedFormat);\nramp.minFilter = THREE.NearestFilter; ramp.magFilter = THREE.NearestFilter; ramp.colorSpace = THREE.NoColorSpace; ramp.needsUpdate = true;\nconst cache = new Map();\nexport function toon(color) {\n  const k = String(color);\n  if (!cache.has(k)) cache.set(k, new THREE.MeshToonNodeMaterial({ color, gradientMap: ramp }));\n  return cache.get(k);\n}\nexport const glass = () => new THREE.MeshBasicNodeMaterial({ color: 0xe8fbff, transparent: true, opacity: .16, side: THREE.DoubleSide, depthWrite: false });\nexport const flat = (color, opacity = 1) => new THREE.MeshBasicNodeMaterial({ color, transparent: opacity < 1, opacity, depthWrite: opacity >= 1 });\nconst geo = new Map();\nexport function cached(key, make) { if (!geo.has(key)) geo.set(key, make()); return geo.get(key); }\nexport function mesh(g, color, shadow = true) { const m = new THREE.Mesh(g, typeof color === 'object' ? color : toon(color)); m.castShadow = shadow; m.receiveShadow = shadow; return m; }\nexport const sphere = (r, color, sx = 1, sy = 1, sz = 1) => { const m = mesh(cached('s', () => new THREE.SphereGeometry(1, 20, 14)), color); m.scale.set(r * sx, r * sy, r * sz); return m; };\nexport const capsule = (r, len, color) => mesh(cached(`c${r}_${len}`, () => new THREE.CapsuleGeometry(r, len, 6, 14)), color);\nexport const cyl = (rt, rb, h, color, seg = 18) => mesh(cached(`y${rt}_${rb}_${h}_${seg}`, () => new THREE.CylinderGeometry(rt, rb, h, seg)), color);\nexport const cone = (r, h, color, seg = 14) => mesh(cached(`k${r}_${h}_${seg}`, () => new THREE.ConeGeometry(r, h, seg)), color);\nexport const torus = (r, t, color, arc = Math.PI * 2) => mesh(cached(`t${r}_${t}_${arc}`, () => new THREE.TorusGeometry(r, t, 10, 28, arc)), color);\nexport const box = (x, y, z, color) => mesh(cached(`b${x}_${y}_${z}`, () => new THREE.BoxGeometry(x, y, z)), color);\nexport const at = (m, x, y, z) => { m.position.set(x, y, z); return m; };\nE\ncat > art/props.js <<'E'\n// Generic builders for sets and scenery.\nimport * as THREE from 'three/webgpu';\nimport { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';\nimport { toon, cached, mesh, sphere, cyl, cone, box, at, torus, capsule } from './materials.js';\nimport { cosmetic, cosRange, pick } from '../core/rng.js';\nexport const rbox = (x, y, z, r, color) => mesh(cached(`rb${x}_${y}_${z}_${r}`, () => new RoundedBoxGeometry(x, y, z, 3, r)), color);\nexport function tree(scale = 1, top = '#6FBF5A') {\n  const g = new THREE.Group();\n  g.add(at(cyl(.14, .2, 1.3, '#B58457'), 0, .65, 0));\n  g.add(at(sphere(.85, top), 0, 1.75, 0));\n  g.add(at(sphere(.5, top), .45, 1.45, .2));\n  g.scale.setScalar(scale); return g;\n}\nexport function palm(scale = 1) {\n  const g = new THREE.Group();\n  for (let i = 0; i < 5; i++) { const c = at(cyl(.11 - i * .012, .13 - i * .012, .55, i % 2 ? '#B58457' : '#9C7048'), i * i * .018, .27 + i * .52, 0); c.rotation.z = -i * .05; g.add(c); }\n  for (let i = 0; i < 6; i++) { const a = i / 6 * 6.283; const l = sphere(.72, '#3FA66B', 1, .1, .24); l.position.set(.3 + Math.cos(a) * .55, 2.75, Math.sin(a) * .55); l.rotation.y = -a; l.rotation.z = -.5; g.add(l); }\n  g.scale.setScalar(scale); return g;\n}\nexport function bunting(ax, ay, az, bx, by, bz, n = 10) {\n  const g = new THREE.Group(); const cols = ['#E8443A', '#F5B700', '#3B82F6', '#22C55E', '#F58A5C'];\n  const curve = new THREE.QuadraticBezierCurve3(new THREE.Vector3(ax, ay, az), new THREE.Vector3((ax + bx) / 2, Math.min(ay, by) - .6, (az + bz) / 2), new THREE.Vector3(bx, by, bz));\n  g.add(mesh(new THREE.TubeGeometry(curve, 12, .012, 5), '#1A1420', false));\n  for (let i = 1; i < n; i++) { const p = curve.getPoint(i / n); const f = cone(.11, .24, cols[i % 5], 3); f.position.copy(p); f.position.y -= .13; f.rotation.x = Math.PI; g.add(f); }\n  return g;\n}\nexport function pavilion(w = 3, d = 3, h = 2.4, roof = '#2FA7A0', post = '#E9D3AE') {\n  const g = new THREE.Group();\n  for (const [x, z] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) g.add(at(box(.24, h, .24, post), x * w / 2, h / 2, z * d / 2));\n  g.add(at(rbox(w + .9, .3, d + .9, .12, roof), 0, h + .15, 0));\n  g.add(at(rbox(w * .6, .24, d * .6, .1, '#F58A5C'), 0, h + .42, 0));\n  g.add(at(rbox(w + .2, .14, d + .2, .05, '#D9B98A'), 0, .07, 0));\n  return g;\n}\nexport function deck(radius = 3, color = '#C89B6A', stilts = true, y = 0) {\n  const g = new THREE.Group();\n  const t = cyl(radius, radius, .2, color, 28); t.position.y = y - .1; g.add(t);\n  for (let i = 0; i < 8; i++) { const a = i / 8 * 6.283; const line = box(radius * 2 * .94 * Math.abs(Math.cos(0)), .01, .03, '#9C7048'); line.position.set(0, y + .002, -radius * .8 + i * radius * .23); line.scale.x = Math.sqrt(Math.max(.02, 1 - Math.pow((-.8 + i * .23), 2))); g.add(line); void a; }\n  if (stilts) for (let i = 0; i < 6; i++) { const a = i / 6 * 6.283; g.add(at(cyl(.12, .14, 4, '#7A5A3C'), Math.cos(a) * radius * .85, y - 2.1, Math.sin(a) * radius * .85)); }\n  return g;\n}\nexport function plankWalk(len, width, color = '#C89B6A', y = 0) {\n  const g = new THREE.Group(); const n = Math.floor(len / .55);\n  for (let i = 0; i < n; i++) { const p = box(width, .1, .49, i % 3 === 0 ? '#BE9160' : color); p.position.set(0, y - .05, -i * .55 - .27); g.add(p); }\n  for (let i = 0; i <= Math.floor(len / 5); i++) for (const s of [-1, 1]) g.add(at(cyl(.09, .11, 3.4, '#7A5A3C'), s * (width / 2 + .05), y - 1.3, -i * 5));\n  return g;\n}\nexport function buoy(color = '#E8443A') { const g = new THREE.Group(); g.add(at(sphere(.3, color, 1, .8, 1), 0, -.25, 0)); g.add(at(cyl(.03, .03, .5, '#F5F0E0'), 0, .15, 0)); g.add(at(sphere(.06, '#F5B700'), 0, .42, 0)); return g; }\nexport function crate(s = .6, color = '#C89B6A') { const g = new THREE.Group(); g.add(at(box(s, s * .7, s, color), 0, s * .35, 0)); g.add(at(box(s + .03, .05, s + .03, '#8F6A42'), 0, s * .7, 0)); g.add(at(box(s + .03, .05, s + .03, '#8F6A42'), 0, .03, 0)); return g; }\nexport function lantern(color = '#F5B700') { const g = new THREE.Group(); g.add(at(cyl(.04, .05, 2, '#7A5A3C'), 0, 1, 0)); g.add(at(sphere(.17, color), 0, 2.1, 0)); return g; }\nexport function rock(s = 1, color = '#A69A8C') { const m = sphere(s, color, 1.2, .7, 1); m.rotation.y = cosmetic() * 6; return m; }\nexport function grassPatch(r, color = '#7CC568') { const c = cyl(r, r, .04, color, 24); return c; }\nexport function stoneStack(n = 3) { const g = new THREE.Group(); let y = 0; for (let i = 0; i < n; i++) { const r = .3 - i * .07, h = .1; const s = sphere(r, ['#A69A8C', '#BDB2A2', '#8F8578'][i % 3], 1, .4, .85); y += h; s.position.y = y; y += h * .6; g.add(s); } return g; }\nexport function bench() { const g = new THREE.Group(); g.add(at(box(1.5, .08, .4, '#E9D3AE'), 0, .45, 0)); g.add(at(box(.1, .45, .35, '#7A5A3C'), -.6, .22, 0)); g.add(at(box(.1, .45, .35, '#7A5A3C'), .6, .22, 0)); return g; }\nexport function fruitMesh(kind) {\n  switch (kind) {\n    case 'urchin': { const g = new THREE.Group(); g.add(sphere(.075, '#3B2A55')); for (let i = 0; i < 10; i++) { const s = cone(.015, .09, '#3B2A55', 5); const a = i * 2.4, b = (i / 10) * Math.PI; s.position.set(Math.sin(b) * Math.cos(a) * .09, Math.cos(b) * .09, Math.sin(b) * Math.sin(a) * .09); s.lookAt(s.position.clone().multiplyScalar(2)); s.rotateX(Math.PI / 2); g.add(s); } return g; }\n    case 'boot': { const g = new THREE.Group(); g.add(at(box(.1, .14, .1, '#6B4A2F'), 0, .02, -.02)); g.add(at(box(.1, .06, .19, '#54381F'), 0, -.06, .02)); return g; }\n    case 'pineapple': { const g = new THREE.Group(); g.add(sphere(.085, '#F5B700', 1, 1.25, 1)); const c = cone(.05, .1, '#3FA66B', 6); c.position.y = .13; g.add(c); return g; }\n    case 'lemon': return sphere(.075, '#F7E04B', 1, .88, .88);\n    case 'plum': return sphere(.075, '#8B3F8F');\n    default: return sphere(.075, '#F58A2E');\n  }\n}\nexport function plate(r, color) { const g = new THREE.Group(); const c = cyl(r, r * .6, .05, color, 20); g.add(c); g.add(at(torus(r, .018, '#1A1420'), 0, .02, 0)).children[1].rotation.x = Math.PI / 2; return g; }\nexport { sphere, cyl, cone, box, at, torus, capsule, cached, mesh, toon, pick, cosRange };\nE\necho done","description":"Write render, palette, sky, sea, particle and prop modules"}}}
