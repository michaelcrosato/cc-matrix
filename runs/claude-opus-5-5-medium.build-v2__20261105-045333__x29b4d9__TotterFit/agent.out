{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjkAp9S8GjuHcsQ7K9FD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018HZVH1q1eXcS34GkJRxd3c","name":"Bash","input":{"command":"cat > anim/clips.js <<'E'\n// poseClip compiles { t, pose: { joint: [x,y,z deg] } } keyframes into quaternion tracks.\nimport * as THREE from 'three/webgpu';\nconst e = new THREE.Euler(), q = new THREE.Quaternion(), D = Math.PI / 180;\nexport function poseClip(name, duration, keys, loop = true) {\n  const joints = new Set(); for (const k of keys) for (const j in k.pose) joints.add(j);\n  const tracks = [];\n  for (const j of joints) {\n    const times = [], vals = []; let last = [0, 0, 0];\n    for (const k of keys) {\n      const a = k.pose[j] || (k.keep ? last : [0, 0, 0]); last = a;\n      e.set(a[0] * D, a[1] * D, a[2] * D); q.setFromEuler(e); times.push(k.t); vals.push(q.x, q.y, q.z, q.w);\n    }\n    tracks.push(new THREE.QuaternionKeyframeTrack(`${j}.quaternion`, times, vals));\n  }\n  const c = new THREE.AnimationClip(name, duration, tracks); c.userData = { loop }; return c;\n}\nconst A = (o) => o; // readability\nconst armsDown = { shoulderL: [0, 0, -8], shoulderR: [0, 0, 8] };\nfunction hold(name, pose) { return poseClip(name, 1, [{ t: 0, pose }, { t: 1, pose }]); }\nconst loopKeys = (name, dur, poses) => poseClip(name, dur, poses.map((pose, i) => ({ t: i / (poses.length - 1) * dur, pose })));\nexport const DOLL_CLIPS = () => [\n  loopKeys('idle', 2.4, [A({ ...armsDown, spine: [2, 0, 0], head: [-2, 0, 0] }), A({ shoulderL: [0, 0, -11], shoulderR: [0, 0, 11], spine: [-1, 0, 0], head: [2, 4, 0] }), A({ ...armsDown, spine: [2, 0, 0], head: [-2, 0, 0] })]),\n  loopKeys('breathe', 4, [A({ ...armsDown, spine: [0, 0, 0] }), A({ shoulderL: [0, 0, -24], shoulderR: [0, 0, 24], spine: [-4, 0, 0], head: [-6, 0, 0] }), A({ ...armsDown, spine: [0, 0, 0] })]),\n  loopKeys('walk', .7, [\n    A({ hipL: [-26, 0, 0], kneeL: [8, 0, 0], hipR: [26, 0, 0], kneeR: [28, 0, 0], shoulderL: [24, 0, -6], shoulderR: [-24, 0, 6], elbowL: [-14, 0, 0], elbowR: [-20, 0, 0] }),\n    A({ hipL: [26, 0, 0], kneeL: [28, 0, 0], hipR: [-26, 0, 0], kneeR: [8, 0, 0], shoulderL: [-24, 0, -6], shoulderR: [24, 0, 6], elbowL: [-20, 0, 0], elbowR: [-14, 0, 0] }),\n    A({ hipL: [-26, 0, 0], kneeL: [8, 0, 0], hipR: [26, 0, 0], kneeR: [28, 0, 0], shoulderL: [24, 0, -6], shoulderR: [-24, 0, 6], elbowL: [-14, 0, 0], elbowR: [-20, 0, 0] })]),\n  loopKeys('jog', .48, [\n    A({ hipL: [-44, 0, 0], kneeL: [20, 0, 0], hipR: [34, 0, 0], kneeR: [62, 0, 0], shoulderL: [40, 0, -10], shoulderR: [-40, 0, 10], elbowL: [-70, 0, 0], elbowR: [-70, 0, 0], spine: [8, 0, 0] }),\n    A({ hipL: [34, 0, 0], kneeL: [62, 0, 0], hipR: [-44, 0, 0], kneeR: [20, 0, 0], shoulderL: [-40, 0, -10], shoulderR: [40, 0, 10], elbowL: [-70, 0, 0], elbowR: [-70, 0, 0], spine: [8, 0, 0] }),\n    A({ hipL: [-44, 0, 0], kneeL: [20, 0, 0], hipR: [34, 0, 0], kneeR: [62, 0, 0], shoulderL: [40, 0, -10], shoulderR: [-40, 0, 10], elbowL: [-70, 0, 0], elbowR: [-70, 0, 0], spine: [8, 0, 0] })]),\n  poseClip('hop', .4, [{ t: 0, pose: { hipL: [-30, 0, 0], kneeL: [50, 0, 0], hipR: [-30, 0, 0], kneeR: [50, 0, 0], shoulderL: [40, 0, -30], shoulderR: [40, 0, 30] } }, { t: .15, pose: { hipL: [10, 0, 0], kneeL: [10, 0, 0], hipR: [10, 0, 0], kneeR: [10, 0, 0], shoulderL: [-20, 0, -130], shoulderR: [-20, 0, 130] } }, { t: .4, pose: { hipL: [-10, 0, 0], kneeL: [20, 0, 0], hipR: [-10, 0, 0], kneeR: [20, 0, 0], shoulderL: [0, 0, -40], shoulderR: [0, 0, 40] } }], false),\n  poseClip('land', .3, [{ t: 0, pose: { hipL: [-40, 0, 0], kneeL: [70, 0, 0], hipR: [-40, 0, 0], kneeR: [70, 0, 0], spine: [24, 0, 0], shoulderL: [0, 0, -60], shoulderR: [0, 0, 60] } }, { t: .3, pose: { spine: [0, 0, 0], ...armsDown } }], false),\n  loopKeys('cheer', .6, [A({ shoulderL: [0, 0, -150], shoulderR: [0, 0, 150], elbowL: [0, 0, -10], elbowR: [0, 0, 10], head: [-8, 0, 0] }), A({ shoulderL: [0, 0, -170], shoulderR: [0, 0, 170], elbowL: [-30, 0, 0], elbowR: [-30, 0, 0], head: [4, 0, 0], spine: [-6, 0, 0] }), A({ shoulderL: [0, 0, -150], shoulderR: [0, 0, 150], elbowL: [0, 0, -10], elbowR: [0, 0, 10], head: [-8, 0, 0] })]),\n  loopKeys('clap', .4, [A({ shoulderL: [-60, 30, -6], shoulderR: [-60, -30, 6], elbowL: [-50, 0, 0], elbowR: [-50, 0, 0] }), A({ shoulderL: [-60, 6, -6], shoulderR: [-60, -6, 6], elbowL: [-60, 0, 0], elbowR: [-60, 0, 0], head: [6, 0, 0] }), A({ shoulderL: [-60, 30, -6], shoulderR: [-60, -30, 6], elbowL: [-50, 0, 0], elbowR: [-50, 0, 0] })]),\n  poseClip('shrug', .8, [{ t: 0, pose: { ...armsDown } }, { t: .3, pose: { shoulderL: [0, 0, -52], shoulderR: [0, 0, 52], elbowL: [-80, 0, 0], elbowR: [-80, 0, 0], head: [0, 0, 12] } }, { t: .8, pose: { ...armsDown } }], false),\n  poseClip('bow', 1, [{ t: 0, pose: { spine: [0, 0, 0] } }, { t: .4, pose: { spine: [52, 0, 0], head: [14, 0, 0], ...armsDown } }, { t: 1, pose: { spine: [0, 0, 0] } }], false),\n  loopKeys('flail', .22, [A({ shoulderL: [120, 0, -100], shoulderR: [-120, 0, 100], elbowL: [-40, 0, 0], elbowR: [-40, 0, 0], head: [0, 0, 10] }), A({ shoulderL: [-120, 0, -100], shoulderR: [120, 0, 100], elbowL: [-40, 0, 0], elbowR: [-40, 0, 0], head: [0, 0, -10] }), A({ shoulderL: [120, 0, -100], shoulderR: [-120, 0, 100], elbowL: [-40, 0, 0], elbowR: [-40, 0, 0], head: [0, 0, 10] })]),\n  hold('sleep', { spine: [20, 0, 0], head: [32, 0, 16], ...armsDown }),\n  hold('flop', { spine: [70, 0, 0], head: [20, 0, 0], shoulderL: [-160, 0, -20], shoulderR: [-160, 0, 20], hipL: [10, 0, 6], hipR: [10, 0, -6] }),\n  // The eight poses (src/data/poses.js).\n  hold('pose_heron', { hipR: [-70, 0, 0], kneeR: [100, 0, 0], shoulderL: [0, 0, -92], shoulderR: [0, 0, 92], head: [6, 0, 0] }),\n  hold('pose_pine', { shoulderL: [0, 0, -170], shoulderR: [0, 0, 170], spine: [-10, 0, 0], head: [22, 0, 0], hipL: [0, 0, -4], hipR: [0, 0, 4] }),\n  hold('pose_chair', { hipL: [-68, 0, 0], kneeL: [80, 0, 0], hipR: [-68, 0, 0], kneeR: [80, 0, 0], spine: [34, 0, 0], shoulderL: [-90, 0, -10], shoulderR: [-90, 0, 10] }),\n  hold('pose_keeper', { shoulderL: [-175, 0, -6], shoulderR: [0, 0, 62], elbowR: [-110, 0, 0], head: [-14, 30, 0], hipL: [0, 0, -14] }),\n  hold('pose_flamingo', { hipL: [-20, 0, -40], kneeL: [100, 0, 0], shoulderL: [-30, 0, -120], shoulderR: [-30, 0, 120], elbowL: [-60, 0, 0], elbowR: [-60, 0, 0], head: [-12, 0, 8] }),\n  hold('pose_goodbye', { hipR: [40, 0, 0], kneeR: [20, 0, 0], shoulderL: [-160, 0, -30], spine: [20, 0, 0], shoulderR: [30, 0, 10], head: [-20, 0, 0] }),\n  hold('pose_umbrella', { shoulderL: [0, 0, -40], shoulderR: [-170, 0, 12], elbowR: [-30, 0, 0], spine: [0, 0, -12], head: [0, 0, -16], hipL: [0, 0, -12], hipR: [0, 0, 12] }),\n  hold('pose_regret', { spine: [46, 0, 12], head: [30, 0, 0], shoulderL: [-40, 0, -10], shoulderR: [-40, 0, 10], elbowL: [-80, 0, 0], elbowR: [-80, 0, 0], hipL: [-14, 0, 0], kneeL: [28, 0, 0] }),\n  // Scrubbed.\n  poseClip('squat', 1, [{ t: 0, pose: { hipL: [0, 0, 0], kneeL: [0, 0, 0], ankleL: [0, 0, 0], hipR: [0, 0, 0], kneeR: [0, 0, 0], ankleR: [0, 0, 0], spine: [0, 0, 0], shoulderL: [0, 0, -150], shoulderR: [0, 0, 150], elbowL: [-120, 0, 0], elbowR: [-120, 0, 0] } }, { t: 1, pose: { hipL: [-96, 0, 0], kneeL: [120, 0, 0], ankleL: [-24, 0, 0], hipR: [-96, 0, 0], kneeR: [120, 0, 0], ankleR: [-24, 0, 0], spine: [28, 0, 0], shoulderL: [0, 0, -150], shoulderR: [0, 0, 150], elbowL: [-120, 0, 0], elbowR: [-120, 0, 0] } }]),\n  hold('plank', { spine: [0, 0, 0], head: [-50, 0, 0], shoulderL: [-90, 0, 0], shoulderR: [-90, 0, 0], hipL: [0, 0, 0], hipR: [0, 0, 0] }),\n  hold('sit', { hipL: [-90, 30, -30], kneeL: [130, 0, 0], hipR: [-90, -30, 30], kneeR: [130, 0, 0], shoulderL: [-30, 0, -14], shoulderR: [-30, 0, 14], elbowL: [-50, 0, 0], elbowR: [-50, 0, 0] }),\n  hold('tug', { spine: [-16, 0, 0], hipL: [-46, 0, 0], kneeL: [46, 0, 0], hipR: [-20, 0, 0], kneeR: [14, 0, 0], shoulderL: [-84, 16, 0], shoulderR: [-84, -16, 0], elbowL: [-12, 0, 0], elbowR: [-12, 0, 0] }),\n  poseClip('hipCircle', 1, [{ t: 0, pose: { hips: [0, 0, 10], spine: [0, 0, -10], shoulderL: [0, 0, -60], shoulderR: [0, 0, 60], elbowL: [-60, 0, 0], elbowR: [-60, 0, 0] } }, { t: .25, pose: { hips: [10, 0, 0], spine: [-10, 0, 0], shoulderL: [0, 0, -60], shoulderR: [0, 0, 60], elbowL: [-60, 0, 0], elbowR: [-60, 0, 0] } }, { t: .5, pose: { hips: [0, 0, -10], spine: [0, 0, 10], shoulderL: [0, 0, -60], shoulderR: [0, 0, 60], elbowL: [-60, 0, 0], elbowR: [-60, 0, 0] } }, { t: .75, pose: { hips: [-10, 0, 0], spine: [10, 0, 0], shoulderL: [0, 0, -60], shoulderR: [0, 0, 60], elbowL: [-60, 0, 0], elbowR: [-60, 0, 0] } }, { t: 1, pose: { hips: [0, 0, 10], spine: [0, 0, -10], shoulderL: [0, 0, -60], shoulderR: [0, 0, 60], elbowL: [-60, 0, 0], elbowR: [-60, 0, 0] } }]),\n  poseClip('stepL', .35, [{ t: 0, pose: { hipL: [-48, 0, 0], kneeL: [70, 0, 0], shoulderR: [30, 0, 10], shoulderL: [-20, 0, -10] } }, { t: .35, pose: { ...armsDown } }], false),\n  poseClip('stepR', .35, [{ t: 0, pose: { hipR: [-48, 0, 0], kneeR: [70, 0, 0], shoulderL: [30, 0, -10], shoulderR: [-20, 0, 10] } }, { t: .35, pose: { ...armsDown } }], false),\n  hold('carryTray', { shoulderL: [-78, 14, 0], shoulderR: [-78, -14, 0], elbowL: [-26, 0, 0], elbowR: [-26, 0, 0], head: [8, 0, 0] }),\n  hold('holdSlab', { shoulderL: [0, 0, -170], shoulderR: [0, 0, 170], elbowL: [0, 0, 8], elbowR: [0, 0, -8], head: [-16, 0, 0] }),\n  hold('holdHat', { shoulderL: [0, 0, -40], shoulderR: [0, 0, 40], elbowL: [-40, 0, 0], elbowR: [-40, 0, 0] }),\n  hold('tuck', { hipL: [-120, 0, 0], kneeL: [130, 0, 0], hipR: [-120, 0, 0], kneeR: [130, 0, 0], spine: [40, 0, 0], head: [20, 0, 0], shoulderL: [-80, 0, 0], shoulderR: [-80, 0, 0], elbowL: [-100, 0, 0], elbowR: [-100, 0, 0] }),\n  hold('pike', { hipL: [-100, 0, 0], hipR: [-100, 0, 0], spine: [20, 0, 0], shoulderL: [-100, 0, 0], shoulderR: [-100, 0, 0] }),\n  hold('diveReady', { shoulderL: [-170, 0, -6], shoulderR: [-170, 0, 6], head: [-8, 0, 0] }),\n  hold('splay', { shoulderL: [0, 0, -95], shoulderR: [0, 0, 95], hipL: [0, 0, -34], hipR: [0, 0, 34] }),\n];\nE\ncat > anim/rig.js <<'E'\nimport * as THREE from 'three/webgpu';\n// Wraps an AnimationMixer with named clips and crossfades.\nconst libCache = new Map();\nexport class Rig {\n  constructor(root, clipsFactory, key) {\n    this.mixer = new THREE.AnimationMixer(root);\n    if (!libCache.has(key)) libCache.set(key, clipsFactory());\n    this.clips = {}; for (const c of libCache.get(key)) this.clips[c.name] = c;\n    this.actions = {}; this.current = null; this.time = 0;\n  }\n  action(name) {\n    if (!this.actions[name]) { const c = this.clips[name]; if (!c) return null; const a = this.mixer.clipAction(c); this.actions[name] = a; a.setLoop(c.userData?.loop === false ? THREE.LoopOnce : THREE.LoopRepeat); a.clampWhenFinished = true; }\n    return this.actions[name];\n  }\n  play(name, fade = .15, then = null) {\n    const a = this.action(name); if (!a) return;\n    if (this.currentName === name && a.isRunning() && !then && a.loop !== THREE.LoopOnce) return;\n    a.reset(); a.paused = false; a.timeScale = 1; a.enabled = true; a.setEffectiveWeight(1); a.play();\n    if (this.current && this.current !== a) this.current.crossFadeTo(a, fade, false);\n    this.current = a; this.currentName = name; this.then = then; this.thenAt = then ? a.getClip().duration : 0;\n  }\n  scrub(name, t, fade = .15) { if (this.currentName !== name) this.play(name, fade); const a = this.action(name); a.paused = true; a.time = t * a.getClip().duration; }\n  update(dt) { this.time += dt; this.mixer.update(dt); if (this.then) { this.thenAt -= dt; if (this.thenAt <= 0) { const n = this.then; this.then = null; this.play(n, .2); } } }\n}\nE\ncat > art/doll.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { sphere, capsule, torus, cone, cyl, at, box, toon } from './materials.js';\nimport { Rig } from '../anim/rig.js';\nimport { DOLL_CLIPS } from '../anim/clips.js';\nexport const PAINTS = ['#E8443A', '#3B82F6', '#22C55E', '#F5B700', '#E77BB0', '#8E6BD8', '#2FA7A0', '#F58A2E'];\nexport const SKINS = ['#F2D3A8', '#E2B48A', '#C98F62', '#9A6A45', '#F7E0C2'];\nexport const HATS = ['none', 'visor', 'beret', 'bucket', 'perm', 'wizard', 'crown'];\nfunction J(name, parent, x = 0, y = 0, z = 0) { const g = new THREE.Group(); g.name = name; g.position.set(x, y, z); parent.add(g); return g; }\nexport function makeHat(kind, c = '#3B82F6') {\n  const g = new THREE.Group();\n  switch (kind) {\n    case 'visor': { g.add(at(torus(.21, .03, c), 0, .1, 0)).children[0].rotation.x = Math.PI / 2; const b = sphere(.17, c, 1, .12, 1); b.position.set(0, .1, .2); g.add(b); break; }\n    case 'beret': { const b = sphere(.25, c, 1.05, .32, 1.05); b.position.set(.03, .2, 0); b.rotation.z = -.2; g.add(b); break; }\n    case 'bucket': { g.add(at(cyl(.2, .23, .17, c), 0, .21, 0)); g.add(at(cyl(.32, .32, .025, c), 0, .13, 0)); break; }\n    case 'perm': { for (let i = 0; i < 14; i++) { const a = i * 2.399, r = .09 + (i % 5) * .03; g.add(at(sphere(.095, '#D8D3E8'), Math.cos(a) * r, .15 + (i % 3) * .05, Math.sin(a) * r - .02)); } break; }\n    case 'wizard': { g.add(at(cone(.2, .55, '#5B4BB5'), 0, .42, 0)); g.add(at(cyl(.3, .3, .025, '#5B4BB5'), 0, .15, 0)); g.add(at(sphere(.035, '#F5B700'), .06, .42, .13)); break; }\n    case 'crown': { g.add(at(cyl(.12, .1, .07, '#F5B700'), 0, .24, 0)); for (let i = 0; i < 5; i++) { const a = i / 5 * 6.283; g.add(at(cone(.03, .08, '#F5B700', 6), Math.cos(a) * .1, .3, Math.sin(a) * .1)); } break; }\n    default: break;\n  }\n  return g;\n}\nexport function makeDoll({ paint = '#E8443A', shorts = '#2B4A6F', skin = '#F2D3A8', hat = 'none', hatColor = null, height = 1, width = 1 } = {}) {\n  const group = new THREE.Group(); // position in the world\n  const lean = new THREE.Group(); group.add(lean); // physics rotation, world aligned\n  const root = J('root', lean); // facing\n  const inner = new THREE.Group(); inner.scale.set(width, height, width); root.add(inner);\n  const hips = J('hips', inner, 0, .46, 0);\n  const spine = J('spine', hips, 0, .08, 0);\n  const head = J('head', spine, 0, .54, 0);\n  const shoulderL = J('shoulderL', spine, -.26, .42, 0), shoulderR = J('shoulderR', spine, .26, .42, 0);\n  const elbowL = J('elbowL', shoulderL, 0, -.2, 0), elbowR = J('elbowR', shoulderR, 0, -.2, 0);\n  const hipL = J('hipL', hips, -.12, -.02, 0), hipR = J('hipR', hips, .12, -.02, 0);\n  const kneeL = J('kneeL', hipL, 0, -.2, 0), kneeR = J('kneeR', hipR, 0, -.2, 0);\n  const ankleL = J('ankleL', kneeL, 0, -.2, 0), ankleR = J('ankleR', kneeR, 0, -.2, 0);\n  const JOINT = '#D9A86C';\n  // Body\n  const sh = capsule(.2, .06, shorts); sh.scale.set(1.05, 1, .85); hips.add(at(sh, 0, .02, 0));\n  const shirt = capsule(.21, .24, paint); shirt.scale.z = .82; spine.add(at(shirt, 0, .24, 0));\n  // Head\n  head.add(at(sphere(.23, skin), 0, .2, 0));\n  const hb = torus(.228, .022, paint); hb.rotation.x = Math.PI / 2 + .1; head.add(at(hb, 0, .3, 0));\n  head.add(at(sphere(.024, '#1A1420'), -.08, .23, .205)); head.add(at(sphere(.024, '#1A1420'), .08, .23, .205));\n  head.add(at(sphere(.045, '#F4A6A0', 1, .6, .4), -.13, .15, .185)); head.add(at(sphere(.045, '#F4A6A0', 1, .6, .4), .13, .15, .185));\n  const mouth = torus(.04, .008, '#1A1420', Math.PI); mouth.rotation.z = Math.PI; head.add(at(mouth, 0, .13, .222));\n  const hatG = new THREE.Group(); hatG.position.y = .2; head.add(hatG);\n  // Arms: ball joints, skin capsules, mittens\n  for (const [s, e, x] of [[shoulderL, elbowL, -1], [shoulderR, elbowR, 1]]) {\n    s.add(sphere(.075, JOINT)); s.add(at(capsule(.055, .12, skin), 0, -.1, 0));\n    e.add(sphere(.06, JOINT)); e.add(at(capsule(.05, .1, skin), 0, -.1, 0)); e.add(at(sphere(.07, '#FFFFFF'), 0, -.22, 0)); void x;\n  }\n  // Legs\n  for (const [h, k, a] of [[hipL, kneeL, ankleL], [hipR, kneeR, ankleR]]) {\n    h.add(at(capsule(.08, .1, skin), 0, -.1, 0)); k.add(sphere(.065, JOINT)); k.add(at(capsule(.07, .1, skin), 0, -.1, 0));\n    a.add(at(sphere(.1, '#FFFFFF', 1, .55, 1.5), 0, -.005, .05));\n  }\n  const joints = { root, hips, spine, head, shoulderL, shoulderR, elbowL, elbowR, hipL, hipR, kneeL, kneeR, ankleL, ankleR };\n  const rig = new Rig(root, DOLL_CLIPS, 'doll');\n  const doll = { group, lean, root, joints, rig, hatG, paint, hat, flailT: 0, bobble: 0, bob: 0, faceYaw: 0, squash: 0, inner,\n    setHat(kind, c = hatColor || paint) { while (hatG.children.length) hatG.remove(hatG.children[0]); hatG.add(makeHat(kind, c)); this.hat = kind; },\n    setPaint(c) { shirt.material = toon(c); hb.material = toon(c); this.paint = c; },\n    setFace(y) { root.rotation.y = y; this.faceYaw = y; },\n    setLeanFromQuat(q) { lean.quaternion.set(q.x, q.y, q.z, q.w); },\n    setLean(x, z) { // lean toward +x and +z, radians\n      const a = Math.hypot(x, z) || 1e-9, s = Math.sin(a / 2); lean.quaternion.set(z / a * s, 0, -x / a * s, Math.cos(a / 2)); },\n    tick(dt) {\n      rig.update(dt);\n      if (this.squash > 0) { this.squash = Math.max(0, this.squash - dt * 3); const v = Math.sin(this.squash * Math.PI) * .22; inner.scale.set(width * (1 + v), height * (1 - v), width * (1 + v)); }\n    },\n    land() { this.squash = 1; },\n  };\n  doll.setHat(hat, hatColor || paint);\n  rig.play('idle', 0);\n  return doll;\n}\nE\ncat > art/trudy.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { rbox } from './props.js';\nimport { box, capsule, sphere, cyl, torus, at, toon } from './materials.js';\nimport { Rig } from '../anim/rig.js';\nimport { poseClip } from '../anim/clips.js';\nconst clips = () => [\n  poseClip('idle', 2, [{ t: 0, pose: { body: [0, 0, -2] } }, { t: 1, pose: { body: [0, 0, 2] } }, { t: 2, pose: { body: [0, 0, -2] } }]),\n  poseClip('hop', .4, [{ t: 0, pose: { body: [10, 0, 0], pegL: [-30, 0, 0], pegR: [-30, 0, 0] } }, { t: .2, pose: { body: [-8, 0, 0], pegL: [24, 0, 0], pegR: [24, 0, 0] } }, { t: .4, pose: { body: [10, 0, 0], pegL: [-30, 0, 0], pegR: [-30, 0, 0] } }]),\n  poseClip('gasp', .5, [{ t: 0, pose: { body: [0, 0, 0] } }, { t: .15, pose: { body: [-22, 0, 0] } }, { t: .5, pose: { body: [-14, 0, 0] } }], false),\n  poseClip('sulk', 1, [{ t: 0, pose: { body: [14, 26, 0] } }, { t: 1, pose: { body: [16, 22, 2] } }]),\n  poseClip('faint', 1, [{ t: 0, pose: { body: [0, 0, 0] } }, { t: .5, pose: { body: [-20, 0, 12] } }, { t: 1, pose: { body: [-82, 0, 6] } }], false),\n  poseClip('read', 1.6, [{ t: 0, pose: { body: [12, 0, 0] } }, { t: .8, pose: { body: [18, 8, 0] } }, { t: 1.6, pose: { body: [12, 0, 0] } }]),\n];\nexport function makeTrudy() {\n  const group = new THREE.Group(); const body = new THREE.Group(); body.name = 'body'; body.position.y = .32; group.add(body);\n  const pegL = new THREE.Group(); pegL.name = 'pegL'; pegL.position.set(-.3, .32, 0); group.add(pegL); pegL.add(at(cyl(.07, .09, .32, '#8F6A42'), 0, -.16, 0));\n  const pegR = new THREE.Group(); pegR.name = 'pegR'; pegR.position.set(.3, .32, 0); group.add(pegR); pegR.add(at(cyl(.07, .09, .32, '#8F6A42'), 0, -.16, 0));\n  body.add(at(rbox(1.1, .42, .26, .1, '#F5B700'), 0, .21, 0));\n  body.add(at(box(.56, .2, .05, '#2A2233'), 0, .23, .125));\n  const vial = capsule(.075, .36, '#B9F26B'); vial.rotation.z = Math.PI / 2; body.add(at(vial, 0, .23, .15));\n  const bubble = sphere(.058, '#FFFFFF', 1.25, .9, .7); bubble.position.set(0, .23, .21); body.add(bubble);\n  const pupil = sphere(.024, '#1A1420'); pupil.position.set(0, 0, .85); bubble.add(pupil); pupil.scale.set(.42, .6, .42);\n  for (const x of [-.07, .07]) body.add(at(box(.012, .13, .02, '#1A1420'), x, .23, .225));\n  for (const x of [-.42, .42]) { body.add(at(sphere(.075, '#B9F26B', 1, 1, .4), x, .23, .125)); }\n  const mouth = torus(.05, .012, '#1A1420', Math.PI); mouth.rotation.z = Math.PI; body.add(at(mouth, 0, .075, .135));\n  const rig = new Rig(group, clips, 'trudy'); rig.play('idle', 0);\n  const t = { group, body, rig, bubble, bubbleX: 0, hopT: 0, squash: 0, wantX: 0,\n    tick(dt, feelX = 0) {\n      rig.update(dt);\n      this.wantX = Math.max(-.2, Math.min(.2, feelX));\n      this.bubbleX += (this.wantX - this.bubbleX) * (1 - Math.exp(-5 * dt));\n      bubble.position.x = this.bubbleX;\n      if (this.squash > 0) { this.squash = Math.max(0, this.squash - dt * 4); const v = Math.sin(this.squash * Math.PI) * .2; body.scale.set(1 + v, 1 - v, 1); }\n    },\n    hop() { this.squash = 1; rig.play('hop', .1, 'idle'); },\n  };\n  return t;\n}\nE\ncat > art/heron.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { sphere, cyl, cone, torus, at, cached, mesh } from './materials.js';\nimport { Rig } from '../anim/rig.js';\nimport { poseClip } from '../anim/clips.js';\nconst clips = () => [\n  poseClip('stand', 4, [{ t: 0, pose: { body: [0, 0, 0], neck1: [0, 0, 0], headJ: [0, 0, 0] } }, { t: 2, pose: { body: [1, 0, 1], neck1: [2, 0, 0], headJ: [0, 6, 0] } }, { t: 4, pose: { body: [0, 0, 0], neck1: [0, 0, 0], headJ: [0, 0, 0] } }]),\n  poseClip('bow', 2, [{ t: 0, pose: { neck1: [0, 0, 0], neck2: [0, 0, 0], neck3: [0, 0, 0] } }, { t: 1, pose: { neck1: [26, 0, 0], neck2: [20, 0, 0], neck3: [24, 0, 0], headJ: [20, 0, 0] } }, { t: 2, pose: { neck1: [0, 0, 0], neck2: [0, 0, 0], neck3: [0, 0, 0] } }], false),\n  poseClip('turn', 3, [{ t: 0, pose: { headJ: [0, 0, 0] } }, { t: 1.5, pose: { headJ: [0, 50, 6] } }, { t: 3, pose: { headJ: [0, 0, 0] } }], false),\n  poseClip('pat', 1, [{ t: 0, pose: { wingR: [0, 0, 0], neck3: [10, 0, 0] } }, { t: .5, pose: { wingR: [0, 0, 70], neck3: [24, 0, 0] } }, { t: 1, pose: { wingR: [0, 0, 0], neck3: [10, 0, 0] } }]),\n  poseClip('demo', 3, [{ t: 0, pose: { body: [0, 0, 0], wingL: [0, 0, 0], wingR: [0, 0, 0] } }, { t: 1.5, pose: { body: [8, 0, 6], wingL: [0, 0, -46], wingR: [0, 0, 46], neck1: [10, 0, -6] } }, { t: 3, pose: { body: [0, 0, 0], wingL: [0, 0, 0], wingR: [0, 0, 0] } }]),\n  poseClip('peck', .8, [{ t: 0, pose: { neck1: [0, 0, 0], neck2: [0, 0, 0], neck3: [0, 0, 0] } }, { t: .4, pose: { neck1: [40, 0, 0], neck2: [40, 0, 0], neck3: [30, 0, 0], headJ: [24, 0, 0] } }, { t: .8, pose: { neck1: [0, 0, 0], neck2: [0, 0, 0], neck3: [0, 0, 0] } }], false),\n];\nexport function makeHeron() {\n  const group = new THREE.Group();\n  group.add(at(cyl(.025, .025, 1.05, '#F58A2E'), 0, .525, 0));\n  group.add(at(sphere(.08, '#F58A2E', 1.8, .3, 1.2), 0, .02, .05));\n  const body = new THREE.Group(); body.name = 'body'; body.position.y = 1.2; group.add(body);\n  body.add(sphere(.34, '#A9C2D4', .8, .92, 1.35));\n  const tucked = cyl(.022, .022, .4, '#F58A2E'); tucked.rotation.x = 1.1; body.add(at(tucked, .1, -.28, -.08));\n  const wingL = new THREE.Group(); wingL.name = 'wingL'; wingL.position.set(-.26, .08, 0); body.add(wingL); wingL.add(at(sphere(.3, '#7E9CB4', .18, .78, 1.3), -.02, -.1, -.05));\n  const wingR = new THREE.Group(); wingR.name = 'wingR'; wingR.position.set(.26, .08, 0); body.add(wingR); wingR.add(at(sphere(.3, '#7E9CB4', .18, .78, 1.3), .02, -.1, -.05));\n  const scarf = torus(.13, .05, '#C24D6A'); scarf.rotation.x = Math.PI / 2 - .3; body.add(at(scarf, 0, .24, .24));\n  let p = body; const segs = [[0, .24, .26], [0, .2, .02], [0, .18, -.05], [0, .18, .03], [0, .16, .06]];\n  segs.forEach((s, i) => {\n    const j = new THREE.Group(); j.name = `neck${i + 1}`; j.position.set(s[0], s[1], s[2]); p.add(j);\n    j.add(at(sphere(.062, '#D6E3EC', 1, 1.8, 1), 0, .07, 0)); p = j;\n  });\n  const headJ = new THREE.Group(); headJ.name = 'headJ'; headJ.position.set(0, .16, 0); p.add(headJ);\n  headJ.add(sphere(.115, '#D6E3EC', 1, .95, 1.2));\n  const beak = cone(.05, .34, '#F5C542'); beak.rotation.x = Math.PI / 2; headJ.add(at(beak, 0, -.01, .28));\n  const crest = cone(.03, .28, '#1A1420', 8); crest.rotation.x = -2.2; headJ.add(at(crest, 0, .1, -.14));\n  for (const x of [-1, 1]) { const e = torus(.03, .009, '#1A1420', Math.PI); e.rotation.y = x * Math.PI / 2; headJ.add(at(e, x * .1, .02, .06)); }\n  const rig = new Rig(group, clips, 'heron'); rig.play('stand', 0);\n  return { group, rig, tick(dt) { rig.update(dt); } };\n}\nE\ncat > art/walrus.js <<'E'\ni