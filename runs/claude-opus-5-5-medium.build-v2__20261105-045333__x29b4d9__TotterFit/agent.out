, 'the outline leaves with the pointer');\n  // Heron demonstrates each pose; every sound in the table is reachable; bark exclamations stay on screen.\n  await reset(); const dm = await page.evaluate(() => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); e.count = .01; const seen = new Set(); for (let i = 0; i < 120 * 34; i++) { g.fixed(1 / 120); seen.add(e.heron.rig.currentName); } return [...seen]; }); T.ok(dm.filter(n => n.startsWith('demo_')).length >= 3, `heron demonstrates each pose: ${dm}`);\n  const xc = await page.evaluate(() => { const g = __TEST__.g; let found = 0; const was = g.audio.speak; let same = true; g.audio.speak = () => 0; for (let i = 0; i < 200; i++) { g.speech.clear(); const r = g.speech.bark('trudy', 'Hello.'); if (r && r.text !== 'Hello.') { found++; if (!r.text.endsWith('Hello.')) same = false; } } g.speech.clear(); g.audio.speak = was; return { found, same }; }); T.ok(xc.found > 5 && xc.same, `exclamations appear, in the on-screen text ${JSON.stringify(xc)}`);\n  // Session card: the class lined up with Trudy; ghosts carry their clip.\n  await reset(); const sc = await page.evaluate(() => { const g = __TEST__.g, H = globalThis.AIHub; const keep = {}; for (const k of ['on', 'answer', 'progress', 'result', 'send', 'time', 'rng']) keep[k] = H[k]; const sent = []; const on = {}; Object.assign(H, { on: (e, f) => { on[e] = f; }, answer() {}, progress() {}, result() {}, send: (m) => { sent.push(m); return true; }, time: () => 7000, rng: () => () => .3 }); g.clearMode(); const s = new __TEST__.Session(g, { me: 0, players: [{ id: 0, name: 'Ann', color: '#e8443a' }, { id: 1, name: 'Bo', color: '#3b82f6' }, { id: 2, name: 'Cy', color: '#22c55e' }], mode: 'ghost', round: 1, limitMs: 270000, seed: 1 }); const dolls = s.ev.anim.length; const onCard = !!document.querySelector('[data-screen=sessioncard]'); for (let i = 0; i < 60; i++) { s.fixed(1 / 120); g.fixed(1 / 120); } on.message({ t: 'g', a: s.slot, x: 3.2, z: 0, lx: 0, lz: 0, c: 13, f: 0, s: 0 }, 1); for (let i = 0; i < 12; i++) { s.fixed(1 / 120); g.frame(1 / 120); } const gh = s.ghosts.get(1); const clip = gh.doll.rig.currentName; const c = sent.at(-1).c; for (const gg of s.ghosts.values()) gg.remove(); g.session = null; g.ui.closeAll(); g.clearMode(); g.input.poll = g.input.constructor.prototype.poll; Object.assign(H, keep); return { dolls, onCard, clip, c }; }); T.ok(sc.onCard, 'the session has its own card'); T.ok(sc.dolls >= 4, `class and Trudy line up on the card: ${sc.dolls}`); T.eq(sc.clip, 'flail', 'a ghost plays the clip it was sent'); T.ok(Number.isInteger(sc.c), 'ghost messages carry a clip');\n  // Dev stats show step time; Play a line can choose any line's situation.\n  await reset(); const stT = await page.evaluate(() => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let i = 0; i < 60; i++) g.fixed(1 / 120); __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); g.ui.focus.activate(g.ui.focus.items().find(x => x.textContent === '›')); g.ui.focus.activate(g.ui.focus.items().find(i => /^Stats/.test(i.textContent))); g.frame(1 / 60); const t = g.statsEl.textContent; g.ui.focus.activate(g.ui.focus.items().find(i => /^Stats/.test(i.textContent))); g.ui.closeAll(); g.simPaused = false; return t; }); T.ok(/step [\\d.]+ ms/.test(stT) && /bodies/.test(stT) && /draws/.test(stT) && /fps/.test(stT), `stats ${stT}`);\n\"\"\"\nmarker=\"  T.ok(!page.errors.length, `coverage errors\"\nassert marker in s\ns=s.replace(marker,add+marker)\nopen('test/coverage.mjs','w').write(s)\n# balance on keys: a person-like bot pressing real keys\ns=open('test/balance.mjs').read()\nadd=r\"\"\"\n  // On keys: a bot pressing real keys through the real input path. The ring stays where you leave it.\n  const KEYBOT = (id, skill, seed) => page.evaluate(([i, sk, sd]) => { __TEST__.seed(sd); const g = __TEST__.g; g.ui.closeAll(); g.scripts.clear(); g.clearMode(); g.speech.clear(); g.testBotSkill = null; g.input.keys.clear(); g.input.ringX = 0; g.input.ringZ = 0;\n    const ev = g.startEventMode(__TEST__.EVENTS[i], { tier: 0 }, [{ kind: 'local', name: 'K', colour: '#E8443A' }]); ev.count = .01; g.input.setDevice('kbm'); g.input.pointerActive = false;\n    const send = (type, code) => window.dispatchEvent(new KeyboardEvent(type, { code })); const held = new Set(); const hold = (code, on) => { if (on && !held.has(code)) { held.add(code); send('keydown', code); } else if (!on && held.has(code)) { held.delete(code); send('keyup', code); } };\n    const lane = ev.lanes[0]; let t = 0; const dt = 1 / 120; const rEdge = { hop: false, flail: false }; const tol = .05;\n    while (ev.phase !== 'done' && t < 400) { const b = ev.phase === 'play' ? (ev.botPad(0, sk, dt) || {}) : {}; const [wx, wz] = [b.x || 0, b.z || 0], rx = g.input.ringX, rz = g.input.ringZ; hold('KeyD', wx - rx > tol); hold('KeyA', rx - wx > tol); hold('KeyS', wz - rz > tol); hold('KeyW', rz - wz > tol); hold('KeyQ', (b.lf || 0) > .5); hold('KeyE', (b.rf || 0) > .5); hold('ShiftLeft', !!b.breath); if (b.hop && !rEdge.hop) { send('keydown', 'Space'); send('keyup', 'Space'); } rEdge.hop = !!b.hop; if (b.flail && !rEdge.flail) { send('keydown', 'KeyF'); send('keyup', 'KeyF'); } rEdge.flail = !!b.flail; g.fixed(dt); t += dt; if (Math.round(t * 120) % 4 === 0) g.frame(dt * 4); }\n    for (const c of [...held]) hold(c, false); const r = ev.laneResult(0); const out = { form: r.form, falls: lane.falls, big: r.big, done: ev.phase === 'done' }; g.clearMode(); return out; }, [id, skill, seed]);\n  for (const id of ['poses', 'stillWater', 'fruitHat', 'roomService', 'cairn', 'stepClass']) { const res = {}; for (const s of SK) res[s] = await KEYBOT(id, s, 41); T.note(`keys ${id.padEnd(12)} ${SK.map(s => `${s} ${res[s].form.toFixed(0)} (${res[s].falls})`).join('  ')}`); T.ok(res.sharp.done, `keys ${id} finishes`); T.ok(res.sharp.form >= 40 && res.average.form >= 40 && res.clumsy.form >= 40, `keys ${id}: playable on keys ${SK.map(s => res[s].form.toFixed(0))}`); }\n  const rs2 = await KEYBOT('roomService', 'sharp', 41); T.ok(rs2.big >= 4, `keys: Room Service T1 delivers ${rs2.big}`);\n  const fh2 = await KEYBOT('fruitHat', 'sharp', 41); T.eq(fh2.falls, 0, 'keys: Fruit Hat sharp bot does not fall');\n  // Plate Spinners on keys: tapping A and D. Sharp must beat clumsy by 15 points of share, as on the stick.\n  const PK = (skill) => page.evaluate((sk) => { __TEST__.seed(77); const g = __TEST__.g; g.ui.closeAll(); g.clearMode(); const ev = g.startEventMode(__TEST__.EVENTS.plates, { tier: 0 }, [{ kind: 'local', name: 'K' }]); ev.count = .01; g.input.setDevice('kbm'); const S = { sharp: [.12, .05, 0], average: [.28, .13, .05], clumsy: [.5, .24, .16] }[sk]; const BAND = { L: 4.25, M: 7.25, S: 10.25 }; const l = ev.lanes[0]; let t = 0, next = 0, k = 0, target = null, think = 0, seed = 11; const rnd = () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; }; const dt = 1 / 120; while (ev.phase !== 'done' && t < 80) { think -= dt; if (think <= 0) { think = S[0] + .1; if (!target || target.dead > 0 || target.energy > .85) { let low = null; for (const p of l.plates || []) if (p.dead <= 0 && (!low || p.energy < low.energy)) low = p; target = low; } } if (target && t >= next) { const w = BAND[target.kind] * (1 + (rnd() - .5) * 2 * S[1]); next = t + (rnd() < S[2] ? .5 : Math.PI / w); const code = (k++ % 2) ? 'KeyD' : 'KeyA'; window.dispatchEvent(new KeyboardEvent('keydown', { code })); window.dispatchEvent(new KeyboardEvent('keyup', { code })); } g.fixed(dt); t += dt; } const share = l.score; g.clearMode(); return share; }, skill);\n  const ps = { sharp: await PK('sharp'), average: await PK('average'), clumsy: await PK('clumsy') }; T.note(`keys plates ${JSON.stringify(ps)}`); T.ok(ps.sharp - ps.clumsy >= .15, `keys plates must separate the bots by 15 points: ${JSON.stringify(ps)}`);\n\"\"\"\nmarker=\"  T.ok(!page.errors.length, `balance page errors\"\nassert marker in s\ns=s.replace(marker,add+marker)\ns=s.replace(\"T.ok(pl.sharp - pl.clumsy >= .1,\",\"T.ok(pl.sharp - pl.clumsy >= .15,\")\nopen('test/balance.mjs','w').write(s)\nE\nnode tools/build.mjs | tail -1; V=1 timeout 280 node tools/test.mjs balance coverage 2>&1 | grep -E '^FAIL|passed|^keys|crashed' | cut -c1-300","description":"Implement the remaining plan details and add keyboard-bot and coverage tests","timeout":300000}}}
