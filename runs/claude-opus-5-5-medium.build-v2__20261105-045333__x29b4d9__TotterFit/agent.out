 { writeSave(); }\\n  openPlan() { Screens.openPlan(this); }\")\ns=s.replace(\"\"\"    else if (!p.planShown) { p.planShown = true; this.persist(); this.scripts.run(function* (g) { yield* g.say('trudy', p.day === 1 ? 'tutorialClass' : 'planIntro'); Screens.openPlan(g); }(this), 'flow'); }\"\"\",\"\"\"    else if (!p.planShown) { p.planShown = true; this.persist(); this.scripts.run(function* (g) { yield* g.say('trudy', p.day === 1 ? 'tutorialClass' : 'planIntro'); if (!g.ui.top()) Screens.openPlan(g); }(this), 'flow'); }\"\"\")\nopen('src/game/director.js','w').write(s)\ns=open('src/data/dialogue.js').read()\ns=s.replace(\"export function linesCount()\",\"\"\"// Guests are addressed by their own key.\nfor (const k of ['margaret', 'kevin', 'sandra', 'paul', 'gerald']) D[k] = { [k]: D.guests[k] };\nexport function linesCount()\"\"\")\ns=s.replace(\"for (const who in D) { c[who] = 0;\",\"for (const who of ['trudy', 'stillwater', 'bolster', 'guests']) { c[who] = 0;\")\nopen('src/data/dialogue.js','w').write(s)\ns=open('src/core/testhooks.js').read()\ns=s.replace(\"remaining: p ? g.remaining() : [],\",\"remaining: p ? g.remaining() : [], locked: g.hub ? g.hub.locked : null,\")\nopen('src/core/testhooks.js','w').write(s)\ns=open('test/flow.mjs').read()\ns=s.replace(\"case 'island': { if (!q.remaining.length) {\",\"case 'island': { if (q.locked) { await adv(.25); break; } if (!q.remaining.length) {\")\ns=s.replace(\"await press(TRI); await page.evaluate(() => __TEST__.Menus.openPlan(__TEST__.g)); await adv(.2);\",\"await press(TRI); await adv(.2); T.ok(['plan','island'].includes((await st()).screen), 'triangle opens plan');\")\nopen('test/flow.mjs','w').write(s)\nE\nnode tools/build.mjs | tail -1; timeout 580 node tools/test.mjs flow 2>&1 | cut -c1-300 | grep -v '^ *at ' | tail -22","description":"Wire Ask/Plan, fix Esc pause, rerun playthrough","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage