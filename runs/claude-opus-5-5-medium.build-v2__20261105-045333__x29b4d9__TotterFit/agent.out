is.barkNow('trudy', k); } else if (Cls.instructor === 'stillwater') this.barkNow('stillwater', 'intro'); else this.barkNow('bolster', Cls.id === 'tug' ? 'tug' : Cls.id === 'plates' ? 'plates' : Cls.id === 'islandLoop' ? 'loop' : 'intro'); }\n  lanesFor(Cls) { const specs = this.localLaneSpec(); if (Cls.id === 'raft') { const names = [['Gentle Margaret', '#E77BB0', 'sharp'], ['Retired Kevin', '#2FA7A0', 'average'], ['Unsteady Paul', '#F58A2E', 'clumsy']]; for (const [name, colour, skill] of names) specs.push({ kind: 'bot', name, colour, skill }); } return specs; }\n  restartEvent() { if (this.onRestart) this.onRestart(); }\n  refreshHubSpots() {\n    const hub = this.hub; if (!hub) return; const p = this.profile; const list = []; const rem = this.remaining();\n    const spot = (lm, label, useText, act, marked = false) => { const L = LANDMARKS[lm]; list.push({ x: L.x, z: L.z, r: L.r, label, useText, act, marked, id: lm }); };\n    const plan = this.planFor();\n    const byLm = {}; for (const c of plan) { (byLm[LANDMARK[c]] ||= []).push(c); }\n    const opened = new Set(p.met); for (const c of plan) opened.add(c);\n    const lmEvents = {}; for (const id of Object.keys(EVENTS)) { if (!opened.has(id)) continue; (lmEvents[LANDMARK[id]] ||= []).push(id); }\n    for (const lm in lmEvents) { const evs = lmEvents[lm]; const todo = evs.find(e => rem.includes(e)); if (lm === 'gazebo') continue; const ev = todo || evs[0]; spot(lm, EVENTS[ev].title + (evs.length > 1 && !todo ? '...' : ''), 'Go to class', () => { if (todo || evs.length === 1) this.playClass(ev, todo ? 'programme' : { kind: 'hub-free', tier: this.tierFor(ev) }); else Screens.openLandmarkPick(this, evs); }, !!todo); }\n    spot('jar', 'The Jar', 'Look at the marbles', () => this.scripts.run(this.lookAtJar(), 'flow'));\n    spot('board', \"Today's Plan\", 'Read', () => Screens.openPlan(this));\n    spot('bedHut', 'The Bed Hut', 'Go to bed', () => this.tryBed(), !rem.length);\n    if (p.day >= 3) spot('mirror', 'The Mirror', 'Look', () => Screens.openMirror(this));\n    if (p.day >= 4 || p.levelled) spot('gazebo', rem.includes('raft') ? 'Tippy Raft' : 'The Gazebo', rem.includes('raft') ? 'Go to class' : 'Group Class', () => { if (rem.includes('raft')) this.playClass('raft', 'programme'); else Screens.openGroup(this); }, rem.includes('raft'));\n    hub.setSpots(list);\n  }\n  *lookAtJar() { const hub = this.hub; if (!hub) return; hub.locked = true; const jp = this.island.jarGroup.getWorldPosition(new THREE.Vector3()); const old = hub.placeCam; hub.placeCam = () => {}; this.rig.set(jp.x + 1, jp.y + 2.2, jp.z + 6, jp.x, jp.y + 1.1, jp.z); yield* this.sayText('trudy', `There are ${this.profile.marbles} marbles in the jar. I do not count them. There are ${this.profile.marbles}.`); hub.placeCam = old; hub.locked = false; }\n  tryBed() {\n    if (this.remaining().length) { this.scripts.run(this.say('trudy', 'bedEarly'), 'flow'); return; }\n    this.scripts.run(this.goToBed(), 'flow');\n  }\n  *goToBed() {\n    const p = this.profile; const hub = this.hub; if (hub) hub.locked = true; yield* this.say('trudy', 'bed');\n    yield* this.wipe(() => { p.day += 1; p.doneToday = []; p.checkinDone = false; p.bedReady = false; p.planShown = false; p.stamps.push(new Date().toISOString().slice(0, 10)); this.persist(); this.audio.sfx('stamp'); this.startHub({ x: LANDMARKS.bedHut.x, z: LANDMARKS.bedHut.z + 3 }); this.hub.locked = true; setPalette('dawn', true); });\n    yield* Play.stampCard(this);\n    yield* this.dayFlow();\n  }\n  *ending() {\n    const p = this.profile; p.levelled = true; p.steps = this.stepsTotal(); this.persist();\n    document.body.classList.remove('hidecursor');\n    yield* this.wipe(() => { this.clearMode(); this.island.setStage('hub'); this.island.setRest(0); this.island.tx = 0; this.island.tz = 0; this.detuneOverride = 0; setPalette('golden', true); this.startHub({ x: 0, z: 10 }); this.hub.locked = true; this.hub.setTiltRest(0); this.hub.tiltM.tx = 0; this.hub.tiltM.tz = 0; this.hub.tiltM.vx = 0; this.hub.tiltM.vz = 0; });\n    this.audio.playTrack('level');\n    const hub = this.hub; yield 1.2; hub.trudy.bubble.position.x = 0; yield* this.sayText('trudy', D.trudy.grandEnd[0]); yield* this.sayText('trudy', D.trudy.grandEnd[1]);\n    yield 1.5; this.particles.confetti(0, 12, 0, 120); this.audio.sfx('cheer'); this.audio.sting('fanfare');\n    yield* Play.credits(this); yield* this.sayText('trudy', D.trudy.grandAfter[0]); yield* this.sayText('trudy', D.trudy.grandAfter[1]);\n    for (const id of Object.keys(EVENTS)) if (!p.met.includes(id)) p.met.push(id);\n    p.bedReady = true; this.persist(); hub.locked = false; this.refreshHubSpots();\n  }\n}\nE\ncat > src/game/attract.js <<'E'\n// Attract mode: bot-played vignettes of the real events, god mode on.\nimport { EVENTS } from '../data/events.js';\nimport { CheckIn } from './checkin.js';\nimport { Hub } from './hub.js';\nimport { newProfile } from './programme.js';\nimport { setPalette } from '../render/palette.js';\nimport { el, txt } from '../ui/ui.js';\nconst VIGNETTES = [\n  { id: 'island' }, { id: 'fruitHat', god: false, bankAt: 99, skill: 'average' }, { id: 'cairn', god: true }, { id: 'stepClass', god: true, tier: 1 }, { id: 'plates', god: true }, { id: 'springboard', god: true, pumpMax: 3.5, palette: 'noon' }, { id: 'raft', four: true }, { id: 'roomService', god: true }, { id: 'poses', god: true },\n];\nexport function overlay(g) {\n  let o = document.getElementById('attractOv'); if (o) return o;\n  o = el('div'); o.id = 'attractOv'; o.className = 'bottomprompts'; const bar = el('div', 'promptbar'); const pp = el('span', 'prompt'); const gl = el('span', 'pg'); gl.dataset.verb = 'use'; pp.append(txt('span', '', 'Totter Fit  ·  DEMO  ·  Press any button')); pp.append(gl); bar.appendChild(pp); o.appendChild(bar); o.style.position = 'fixed'; o.style.zIndex = 5; document.body.appendChild(o); g.ui.refreshGlyphs(o); return o;\n}\nexport function* attractScript(g) {\n  const anyInput = () => g.input.anyInput;\n  g.ui.closeAll(); document.getElementById('attractOv')?.remove();\n  const hud = overlay(g); g.attractVisited = g.attractVisited || [];\n  const exit = () => { hud.remove(); g.stopAttract(); };\n  g.input.anyInput = false;\n  for (;;) {\n    for (const v of VIGNETTES) {\n      g.clearMode(); hud.style.display = '';\n      if (v.id === 'island') {\n        const p = newProfile('Demo', '#E8443A'); p.tutorial = true; p.checkinDone = true; const hub = new Hub(g, p); g.mode = hub; g.audio.playTrack('island'); setPalette('golden', true); hub.locked = true; hub.teleport(-10, 2); g.attractVisited.push('island');\n        let t = 0, ph = 0; while (t < 18) { t += 1 / 120; ph += 1 / 120; const ang = ph * .4; hub.walkTarget = null; const vx = Math.cos(ang) * 4, vz = Math.sin(ang) * 4; hub.face = Math.atan2(vx, vz); hub.walking = true; const b = hub.body, c = b.linvel(); b.setLinvel({ x: vx + hub.tiltM.tx * 3, y: c.y, z: vz + hub.tiltM.tz * 3 }, true); if (anyInput()) { exit(); return; } yield; }\n      } else {\n        const Cls = EVENTS[v.id]; const specs = [{ kind: 'bot', skill: v.skill || 'sharp', colour: '#E8443A', name: 'Demo' }]; if (v.four) { specs.push({ kind: 'bot', skill: 'average', colour: '#3B82F6', name: 'Kevin' }, { kind: 'bot', skill: 'average', colour: '#22C55E', name: 'Paul' }, { kind: 'bot', skill: 'sharp', colour: '#F5B700', name: 'Gerald' }); }\n        const ev = g.startEventMode(Cls, { tier: v.tier || 0, god: v.god ?? false, attract: true, bankAt: v.bankAt, pumpMax: v.pumpMax, noReplay: false, palette: v.palette || 'noon' }, specs); g.attractVisited.push(v.id); ev.count = .5; document.body.classList.remove('hidecursor');\n        let t = 0; while (t < 18 && ev.phase !== 'done') { t += 1 / 120; if (anyInput()) { exit(); return; } yield; }\n      }\n    }\n    // Back to the title for 5 s between passes.\n    g.clearMode(); hud.style.display = 'none'; g.titleMode = null;\n    { let t = 0; g.island.setStage('hub'); g.island.setRest(9); g.rig.set(10, 15, 58, 0, 3, 0, true); setPalette('dawn'); g.audio.playTrack('levelBest'); const mode = { screen: 'title', frame: (dt) => g.island.tick(dt) }; g.mode = mode; g.showAttractTitle?.(); while (t < 5) { t += 1 / 120; if (anyInput()) { exit(); return; } yield; } g.hideAttractTitle?.(); }\n  }\n}\nE\nmkdir -p src/ui/screens\ncat > src/ui/screens/play.js <<'E'\n// Intro cards, results, the age reveal, credits.\nimport { el, txt } from '../ui.js';\nimport { TIER_NAMES } from '../../data/programme.js';\nimport { FIXED } from '../../core/loop.js';\nimport { EVENTS } from '../../data/events.js';\nimport { TITLE } from '../../data/config.js';\nimport { EXIT } from '../../data/about.js';\nconst DIAGRAMS = {\n  lean: 'M-40 20 L0 -30 L40 20', hat: 'M-44 -4 H44 M-30 -4 L-22 18 H22 L30 -4 M0 -46 v26', ring: 'M-40 0 a40 40 0 1 0 80 0 a40 40 0 1 0 -80 0 M-18 0 a18 18 0 1 0 36 0 a18 18 0 1 0 -36 0', stack: 'M-44 30 H44 M-34 18 H34 V30 H-34 Z M-26 6 H26 V18 H-26 Z M-16 -6 H16 V6 H-16 Z',\n  feet: 'M-34 30 q-10 -28 8 -36 q16 4 8 36 z M26 30 q-16 -28 0 -36 q18 8 10 36 z', gull: 'M-40 -10 q20 -22 40 0 q20 -22 40 0 M-40 28 H40', tug: 'M-46 0 H46 M-46 -14 V14 M46 -14 V14 M0 -20 V20', circle: 'M36 0 a36 36 0 1 1 -8 -22 M28 -22 l-2 -18 M28 -22 l-18 2', tray: 'M-40 10 H40 M-28 10 V-14 H-16 V10 M-6 10 V-14 H6 V10 M16 10 V-14 H28 V10', dive: 'M-46 -30 H-6 M-6 -30 q26 -24 40 30 M34 0 l6 26 M-46 28 q14 -8 28 0 t28 0 t28 0 t28 0', raft: 'M-44 14 q44 -30 88 0 M-28 8 V-12 M0 0 V-22 M28 8 V-12',\n};\nexport function diagram(kind) { const d = DIAGRAMS[kind] || DIAGRAMS.lean; return `<svg viewBox=\"-60 -60 120 120\" height=\"${Math.round(innerHeight * .2)}\" aria-hidden=\"true\"><circle r=\"56\" fill=\"#F7E7CC\" stroke=\"#1A1420\" stroke-width=\"5\"/><path d=\"${d}\" fill=\"none\" stroke=\"#1A1420\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>`; }\nexport function openIntro(g, Cls, tier, cb) {\n  const ui = g.ui;\n  ui.open('intro', (e) => {\n    e.classList.add('dim'); const c = el('div', 'bigcard'); c.appendChild(txt('div', 'title-h', Cls.title)); c.appendChild(txt('div', 'small', `${Cls.discipline} · ${Cls.place} · ${TIER_NAMES[tier] || 'Gentle'}`));\n    const r = el('div', 'row'); const dg = el('div'); dg.innerHTML = diagram(Cls.diagram); const col = el('div', 'col'); col.style.maxWidth = '54vw'; col.append(txt('div', 'line', Cls.sentence), txt('div', 'line', Cls.can), txt('div', 'line', Cls.cant)); r.append(dg, col); c.appendChild(r);\n    c.appendChild(ui.promptBar(Cls.verbs)); e.appendChild(c);\n    const row = el('div', 'row'); const go = ui.btn('Begin', () => cb('go'), { def: true }); row.appendChild(go); e.appendChild(row);\n    e.appendChild(ui.bottom([['use', 'Begin'], ['back', 'Back']]));\n  }, { onBack: () => cb('back') });\n}\nexport function openResults(g, Cls, res, medal, tier, cb, kind) {\n  const ui = g.ui; g.audio.sting(medal.id); g.audio.sfx('stamp');\n  g.speech.clear();\n  const key = medal.id === 'attended' ? 'attended' : medal.id === 'exemplary' ? 'exemplary' : medal.id === 'suspicious' ? 'suspicious' : 'results';\n  const who = Cls.instructor; const line = who !== 'trudy' && g.rngFlow() < .6 ? g.line(who, 'done') : g.line('trudy', key);\n  ui.open('results', (e) => {\n    e.classList.add('dim'); e.appendChild(txt('div', 'title-h', Cls.title));\n    const mid = el('div', 'row'); const st = el('div', 'medalstamp'); st.style.background = medal.colour; st.textContent = medal.name; mid.appendChild(st);\n    const col = el('div', 'col'); const big = el('div', 'hudnum'); big.style.position = 'static'; big.textContent = String(res.big); big.appendChild(txt('small', '', res.label)); col.append(big, txt('div', 'gaugeTag', res.stats || `Form ${Math.round(res.form)}`)); mid.appendChild(col); e.appendChild(mid);\n    const c = el('div', 'bigcard'); c.appendChild(txt('div', 'line', line || 'Thank you for attending.')); e.appendChild(c);\n    const row = el('div', 'row'); row.append(ui.btn('Continue', () => cb('go'), { def: true }), ui.btn('Try Again', () => cb('retry'))); e.appendChild(row);\n    e.appendChild(ui.bottom([['use', 'Choose'], ['move', 'Move']]));\n  }, {});\n}\nexport function* ageReveal(g, age, prev) {\n  const ui = g.ui; g.clearMode?.call; let done = false;\n  const layer = ui.open('agereveal', (e) => { e.classList.add('dim'); e.style.background = 'rgba(26,20,32,.76)'; e.appendChild(txt('div', 'title-h', 'Your Wobble Age is')); const c = el('div', 'counter'); c.id = 'ageC'; for (let i = 0; i < 2; i++) c.appendChild(txt('div', 'wheel', '0')); e.appendChild(c); const sp = el('div', 'grow'); e.appendChild(sp); }, {});\n  g.audio.sfx('drum', { dur: 2.2 }); const W = layer.el.querySelectorAll('.wheel'); let t = 0;\n  while (t < 2.4) { t += FIXED; if (Math.floor(t * 120) % 4 === 0) { W[0].textContent = String(Math.floor(g.rngFlow() * 10)); W[1].textContent = String(Math.floor(g.rngFlow() * 10)); } yield; }\n  W[0].textContent = String(Math.floor(age / 10)); W[1].textContent = String(age % 10); g.audio.sting('reveal'); g.rig.shake(.1);\n  let line; if (prev != null && age < prev) line = g.line('trudy', 'ageDown', { age, prev, diff: prev - age }); else if (prev != null && age > prev) line = g.line('trudy', 'ageUp', { age, prev }); else line = g.line('trudy', age >= 62 ? 'ageHigh' : age >= 40 ? 'ageMid' : 'ageLow', { age });\n  yield .6; yield* g.sayText('trudy', line); ui.close();\n}\nexport function* stampCard(g) {\n  const p = g.profile, ui = g.ui; const def = g.dayDef();\n  const layer = ui.open('daycard', (e) => { e.classList.add('dim'); e.appendChild(el('div', 'grow')); const c = el('div', 'bigcard'); c.appendChild(txt('div', 'title-h', `Day ${p.day}`)); c.appendChild(txt('div', 'line', def ? def.name : 'Maintenance')); e.appendChild(c); e.appendChild(el('div', 'grow')); }, {});\n  g.audio.sfx('stamp'); yield 2; ui.close(); void layer;\n}\nexport function* credits(g) {\n  const ui = g.ui, lines = [TITLE, 'Fredoka, by Milena Brandão and Hafontia (SIL OFL)', 'Three.js r180 · Rapier 0.19.3', 'Every line, note and marble made in code', 'Ms. Stillwater, as herself', 'Coach Bolster, loudly', 'Gary, without permission', 'Thank you for leaning.'];\n  const hub = g.hub; const old = hub?.placeCam; let t = 0; if (hub) hub.placeCam = () => { const a = t * .2; g.rig.set(Math.sin(a) * 40, 16, Math.cos(a) * 40, 0, 2, 0); };\n  for (const l of lines) { const layer = ui.open('credits', (e) => { e.appendChild(el('div', 'grow')); e.appendChild(txt('div', 'title-h', l)); e.appendChild(el('div', 'grow')); }, {}); let w = 0, adv = false; while (w < 3.2 && !adv) { w += FIXED; t += FIXED; if (w > .6 && g.input.merged.use) adv = true; yield; } ui.close(); void layer; }\n  if (hub) hub.placeCam = old;\n}\nexport { EVENTS, EXIT };\nE\necho ok","description":"Write the director, attract script and play screens"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":23882,"cache_read_input_tokens":306349,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":23882},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"7b90b962-1355-492f-9ae6-428e50dedeb8","timestamp":"2026-11-05T12:30:25.885Z","request_id":"req_011CgjnEsZA8vxqZLcmgqesH","wire_tool_inputs":{"toolu_015UXRBayE8UMMvUFY5vtRh6":{"command":"cat > src/game/director.js <<'E'\n// The game: modes, sim-time scripts, the programme's flow.\nimport * as THREE from 'three/webgpu';\nimport { Input } from '../input/input.js';\nimport { UI, el, txt } from '../ui/ui.js';\nimport { Speech } from '../ui/speech.js';\nimport { Scripts } from '../core/script.js';\nimport { Loop, FIXED } from '../core/loop.js';\nimport { T } from '../core/tuning.js';\nimport { loadSave, writeSave } from '../core/save.js';\nimport { cosmetic, pick, freshSeed, setSeed, seeded, rng } from '../core/rng.js';\nimport { makeScene, R, setWipe, draw } from '../render/renderer.js';\nimport { setPalette, tickPalette, paletteName } from '../render/palette.js';\nimport { makeSky } from '../render/sky.js';\nimport { makeSea, seaU } from '../render/sea.js';\nimport { CameraRig } from '../render/cameraRig.js';\nimport { Particles } from '../render/particles.js';\nimport { ComicText } from '../render/comicText.js';\nimport { AudioEngine } from '../audio/engine.js';\nimport { Island, LANDMARKS } from '../art/island.js';\nimport { D, QUESTIONS } from '../data/dialogue.js';\nimport { DAYS, ALL_TESTS, MARBLE_COLOUR, MAINTENANCE } from '../data/programme.js';\nimport { EVENTS, LANDMARK } from '../data/events.js';\nimport { UNLOCKS } from '../data/unlocks.js';\nimport { wobbleAge, medalFor, marblesFor, tierOpen, highestTier, liveDays, totalSteps, restTilt, bestTests, newProfile } from './programme.js';\nimport { Hub } from './hub.js';\nimport { JarMode } from './jar.js';\nimport { CheckIn } from './checkin.js';\nimport { setGlyphStyle } from '../input/glyphs.js';\nimport * as Screens from '../ui/screens/menus.js';\nimport * as Play from '../ui/screens/play.js';\nimport { attractScript } from './attract.js';\nexport class Game {\n  constructor(params) {\n    this.params = params; this.manual = params.manual; this.save = loadSave();\n    const d = { music: 10, sfx: 80, voice: 80, glyph: 'ps', rumble: true, autoBreathe: false, rhythmOffset: 0, uiScale: 1, ink: 1, reduceShake: false, difficulty: 'standard' };\n    this.settings = Object.assign(d, this.save.settings); this.save.settings = this.settings;\n    const { scene, camera } = makeScene(); this.scene = scene; this.camera = camera;\n    this.input = new Input(); this.audio = new AudioEngine(); this.audio.settings = { music: this.settings.music, sfx: this.settings.sfx, voice: this.settings.voice }; this.audio.applyVolumes();\n    this.ui = new UI(this.input, (k) => this.audio.sfx(k)); this.speech = new Speech(this.ui, this.input, this.audio); this.scripts = new Scripts();\n    this.rig = new CameraRig(camera); this.rig.reduceShake = this.settings.reduceShake;\n    this.loop = new Loop(this); this.mode = null; this.simPaused = false; this.hitstopT = 0; this.idle = 0; this.attractOn = false; this.errors = []; this.testBotSkill = null; this.barkPool = new Map(); this.fps = 0; this.lastBarkAt = 0;\n    this.rngFlow = seeded('flow', freshSeed() & 0xffff); this.god = false; this.sessionInfo = null; this.freeCam = false; this.statT = 0;\n    this.input.onDevice = () => { this.ui.refreshGlyphs(); };\n    this.input.onGesture = () => { this.audio.resume(); };\n    this.applySettings();\n  }\n  buildWorld() {\n    this.sky = makeSky(this.scene); this.sea = makeSea(this.scene); this.particles = new Particles(this.scene); this.comicText = new ComicText(this.scene); this.island = new Island(this.scene);\n    setPalette('dawn', true); this.island.setRest(9);\n  }\n  applySettings() {\n    const s = this.settings; this.audio.settings.music = s.music; this.audio.settings.sfx = s.sfx; this.audio.settings.voice = s.voice; this.audio.applyVolumes(); setGlyphStyle(s.glyph); this.ui.setScale(s.uiScale); R.inkStrength = s.ink; this.rig.reduceShake = s.reduceShake; this.ui.refreshGlyphs();\n  }\n  persist() { writeSave(); }\n  get profile() { const i = this.save.current; return i >= 0 ? this.save.profiles[i] : null; }\n  // ------- the main tick --------\n  fixed(dt) {\n    try {\n      this.input.poll(dt);\n      if (this.testBotSkill && this.mode && this.mode.event) this.writeBotPad(dt);\n      if (this.session) this.session.fixed(dt);\n      this.checkPause();\n      this.watchAudioUnlock(dt);\n      if (this.hitstopT > 0) { this.hitstopT -= dt; this.ui.tick(dt); return; }\n      if (!this.simPaused) {\n        this.scripts.tick(dt);\n        if (this.mode && this.mode.fixed) this.mode.fixed(dt);\n        this.speech.tick(dt, this.ui.top());\n        this.checkAttract(dt);\n        if (this.audio.settings) this.audio.tiltDeg = this.detuneOverride ?? this.currentTilt();\n      }\n      this.ui.tick(dt);\n      this.input.anyInput = false;\n    } catch (e) { this.fatal(e); }\n  }\n  fatal(e) {\n    const m = String(e && e.stack || e); this.errors.push(m); console.error(m);\n    if (/unreachable|RuntimeError/.test(m)) { if (globalThis.AIHub?.active) globalThis.AIHub.fail(m.slice(0, 200)); else { this.loop.running = false; this.persist(); if (!this.params.test) location.reload(); } }\n  }\n  frame(real) {\n    try {\n      this.fps += (1 / Math.max(.001, real) - this.fps) * .05;\n      if (!this.simPaused) { tickPalette(real); if (this.mode && this.mode.frame) this.mode.frame(real); }\n      if (!this.simPaused || this.freeCam) this.rig.tick(real);\n      this.sky.tick(real, this.camera); this.particles.tick(this.simPaused ? 0 : real); this.comicText.tick(this.simPaused ? 0 : real);\n      this.updateSea(); this.sunFollow();\n      if (this.devFrame) this.devFrame(real);\n      if (this.titleBeam) this.titleBeam(real);\n    } catch (e) { this.fatal(e); }\n  }\n  draw() { try { draw(); } catch (e) { this.fatal(e); } }\n  updateSea() { const g = this.island.group; seaU.cx.value = g.position.x; seaU.cz.value = g.position.z; seaU.foam.value = g.visible && this.island.stage !== 'hidden' ? 1 : 0; seaU.tiltX.value = this.island.tx; seaU.tiltZ.value = this.island.tz; }\n  sunFollow() { if (R.sun) { const l = this.rig.look; R.sun.target.position.set(l.x, 0, l.z); R.sun.position.set(l.x + 24, 42, l.z + 18); } }\n  writeBotPad(dt) {\n    const ev = this.mode.event, pads = window.__pads; if (!pads || !pads[0]) return; const p = pads[0]; const b = ev.botPad(0, this.testBotSkill, dt) || {};\n    if (ev.phase !== 'play') { p.axes[0] = 0; p.axes[1] = 0; p.buttons[6] = { pressed: false, value: 0 }; p.buttons[7] = { pressed: false, value: 0 }; p.buttons[0] = { pressed: false, value: 0 }; p.button