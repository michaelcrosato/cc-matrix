: () => ui.close() });\n}\nfunction closeDev(g) { g.ui.closeAll(); g.simPaused = false; }\nfunction openList(g, title, items) {\n  const ui = g.ui; let page = 0, per = 6; const pages = Math.ceil(items.length / per);\n  ui.open('devlist', (e, layer) => { e.classList.add('dim'); e.appendChild(txt('div', 'title-h', title)); const c = el('div', 'col'); for (const [label, act] of items.slice(page * per, page * per + per)) c.appendChild(ui.btn(label, act)); e.appendChild(c); e.appendChild(el('div', 'grow')); if (pages > 1) { const r = el('div', 'row'); r.append(ui.btn('‹', () => { page = (page - 1 + pages) % pages; layer.rebuild(false); }, { cls: 'small' }), txt('div', 'gaugeTag', `Page ${page + 1} of ${pages}`), ui.btn('›', () => { page = (page + 1) % pages; layer.rebuild(false); }, { cls: 'small' })); e.appendChild(r); } e.appendChild(ui.bottom([['use', 'Choose'], ['back', 'Back']])); }, { onBack: () => ui.close() });\n}\nfunction openTierJump(g, id) { const tiers = EVENTS[id].tiers.length; openList(g, EVENTS[id].title, Array.from({ length: tiers }, (_, t) => [['Gentle', 'Honest', 'Unreasonable'][t], () => { closeDev(g); g.scripts.killTag('flow'); ensureProfile(g); g.clearMode(); g.playClass(id, { kind: 'free', tier: t }); }])); }\nfunction ensureProfile(g) { if (!g.profile) { const i = g.save.profiles.findIndex(p => p); if (i >= 0) g.save.current = i; else { g.save.profiles[0] = g.freshProfile('Dev Guest', START_PAINTS[0]); g.save.current = 0; } } }\nfunction jumpDay(g, d) { closeDev(g); ensureProfile(g); const p = g.profile; p.day = d; p.doneToday = []; p.checkinDone = false; p.planShown = false; p.tutorial = true; let s = 0; for (let i = 1; i < d && i <= DAYS.length; i++) s += 1 + DAYS[i - 1].classes.length; p.steps = s; g.scripts.killTag('flow'); g.enterProgramme(); }\nfunction jumpEnding(g) { ensureProfile(g); const p = g.profile; p.day = 5; g.scripts.killTag('flow'); g.clearMode(); g.startHub(); g.scripts.run(g.ending(), 'flow'); void p; }\nfunction setBot(g, v) { g.devBot = v; g.testBotSkill = v ? 'sharp' : null; if (v) { // A pad the bot can press, through the real input path.\n    if (!window.__pads) { window.__pads = [{ connected: true, mapping: 'standard', axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })), vibrationActuator: { playEffect() {} } }]; if (!g.realPads) { g.realPads = navigator.getGamepads?.bind(navigator); try { navigator.getGamepads = () => window.__pads; } catch { g.errors.push('no pad override'); } } } }\n  g.input.setDevice(v ? 'pad' : 'kbm'); g.input.lastPad = 0; }\nfunction setDebug(g, v) { if (!v) { g.debugLines?.removeFromParent(); g.debugLines = null; g.devFrame = devTick(g); return; } const geo = new THREE.BufferGeometry(); const m = new THREE.LineBasicNodeMaterial({ color: 0xff2288 }); g.debugLines = new THREE.LineSegments(geo, m); g.debugLines.frustumCulled = false; g.scene.add(g.debugLines); g.devFrame = devTick(g); }\nfunction setStats(g, v) { if (!v) { g.statsEl?.remove(); g.statsEl = null; } else { g.statsEl = txt('div', 'gaugeTag', ''); g.statsEl.style.cssText = 'position:fixed;left:2vw;top:2vh;z-index:9'; document.body.appendChild(g.statsEl); } g.devFrame = devTick(g); }\nfunction setInput(g, v) { if (!v) { g.inputEl?.remove(); g.inputEl = null; } else { g.inputEl = txt('div', 'gaugeTag', ''); g.inputEl.style.cssText = 'position:fixed;left:2vw;top:9vh;z-index:9'; document.body.appendChild(g.inputEl); } g.devFrame = devTick(g); }\nfunction devTick(g) {\n  return (dt) => {\n    const w = g.mode?.event?.world || g.mode?.world;\n    if (g.debugLines && w) { const b = w.debugRender(); g.debugLines.geometry.setAttribute('position', new THREE.BufferAttribute(new Float32Array(b.vertices), 3)); const par = g.mode?.event?.group?.parent; g.debugLines.position.copy(par && par !== g.scene ? par.position : new THREE.Vector3()); }\n    if (g.statsEl) { const inf = R.renderer?.info?.render; let bodies = w ? w.bodies.len() : 0; g.statsEl.textContent = `fps ${g.fps.toFixed(0)} · bodies ${bodies} · draws ${inf?.drawCalls ?? 0}`; }\n    if (g.inputEl) { const m = g.input.merged; g.inputEl.textContent = `L ${m.x.toFixed(2)} ${m.z.toFixed(2)}  R ${m.lookX.toFixed(2)} ${m.lookY.toFixed(2)}  T ${m.lf.toFixed(2)} ${m.rf.toFixed(2)}  ${g.input.lastDevice}`; }\n    if (g.rig.free) { const m = g.input.merged, c = g.input.kbm; g.rig.freeYaw -= m.lookX; g.rig.freePitch = Math.max(-1.4, Math.min(1.4, g.rig.freePitch - m.lookY)); const f = new THREE.Vector3(-Math.sin(g.rig.freeYaw) * -m.z * -1, 0, 0); void c; f.set(m.moveX, 0, m.moveZ).applyAxisAngle(new THREE.Vector3(0, 1, 0), g.rig.freeYaw).multiplyScalar(dt * 12); g.rig.pos.add(f); g.rig.wantPos.copy(g.rig.pos); }\n  };\n}\nE\ncat > src/game/ghost.js <<'E'\n// Other players in a session: visual only. They never touch your physics.\nimport { makeDoll } from '../art/doll.js';\nexport class Ghost {\n  constructor(game, player, event) {\n    this.game = game; this.player = player; this.doll = makeDoll({ paint: player.color }); this.tag = document.createElement('div'); this.tag.className = 'ghosttag'; this.tag.textContent = player.name; this.tag.style.color = player.color; game.ui.hud.appendChild(this.tag);\n    this.x = 0; this.z = 0; this.lx = 0; this.lz = 0; this.tx = 0; this.tz = 0; this.tlx = 0; this.tlz = 0; this.flop = false; this.clip = -1; this.a = -1; this.parent = null; this.seen = 0; this.score = 0;\n  }\n  attach(event) { if (this.parent === event) return; this.parent = event; this.doll.group.removeFromParent(); if (event) event.group.add(this.doll.group); }\n  remove() { this.doll.group.removeFromParent(); this.tag.remove(); }\n  apply(m) { this.tx = m.x; this.tz = m.z; this.tlx = m.lx; this.tlz = m.lz; this.a = m.a; this.flopWant = !!m.f; this.score = m.s; this.clipWant = m.c; this.seen = performance.now(); }\n  tick(dt, visible) {\n    this.doll.group.visible = visible; this.tag.style.display = visible ? '' : 'none'; if (!visible) return;\n    const k = 1 - Math.exp(-dt / .15); this.x += (this.tx - this.x) * k; this.z += (this.tz - this.z) * k; this.lx += (this.tlx - this.lx) * k; this.lz += (this.tlz - this.lz) * k;\n    this.doll.group.position.set(this.x, this.doll.group.position.y, this.z); this.doll.setLean(this.lx, this.lz); this.doll.tick(dt);\n    if (this.flopWant !== this.flop) { this.flop = this.flopWant; this.doll.rig.play(this.flop ? 'flop' : 'idle', .1); }\n    if (this.game.camera && this.parent) { const v = this.doll.group.getWorldPosition(new ThreeVec()); v.y += 1.8; v.project(this.game.camera); this.tag.style.left = `${(v.x * .5 + .5) * 100}%`; this.tag.style.top = `${(-v.y * .5 + .5) * 100}%`; }\n  }\n}\nimport { Vector3 as ThreeVec } from 'three/webgpu';\nE\ncat > src/game/session.js <<'E'\n// An AI Hub session in ghost mode. The round runs on AIHub.time() alone.\nimport { EVENTS, SESSION_SET } from '../data/events.js';\nimport { Ghost } from './ghost.js';\nimport { Poses } from '../events/poses.js';\nimport { medalFor } from './programme.js';\nimport { setPalette } from '../render/palette.js';\nimport { el, txt } from '../ui/ui.js';\nimport { SEATS } from '../data/config.js';\nconst INTRO = 6000, PLAY = 50000, SCORE = 6000, SLOT = INTRO + PLAY + SCORE;\nconst CLIPS = ['idle', 'cheer'];\nexport class Session {\n  constructor(game, info) {\n    this.g = game; this.info = info; this.me = info.me; this.ghosts = new Map(); this.slot = -1; this.ev = null; this.score = 0; this.slotScores = []; this.resultSent = false; this.ended = false; this.sendT = 0; this.progT = 0; this.falls = 0; this.best = 0; this.volumes = false;\n    const r = globalThis.AIHub.rng('deal'); const pool = [...SESSION_SET]; this.deal = []; while (this.deal.length < 3) this.deal.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n    const H = globalThis.AIHub; this.H = H; this.phase = 'card'; this.cardState = { left: null, ready: [] };\n    H.on('card', (c) => { this.cardState = c; this.drawCard(); }); H.on('start', () => { this.started = true; this.hideCard(); }); H.on('message', (m, from) => this.onMsg(m, from)); H.on('leave', (e) => this.onLeave(e)); H.on('time-up', () => this.timeUp()); H.on('end', () => this.end());\n    this.buildStage();\n  }\n  buildStage() {\n    const g = this.g; const specs = [{ kind: 'local', name: this.myPlayer()?.name || 'You', colour: this.myPlayer()?.color || SEATS[0] }];\n    this.ev = g.startEventMode(Poses, { tier: 0, session: true, noHud: true, palette: 'golden', hold: 14 }, specs); this.ev.count = 1e9;\n    g.audio.playTrack('levelBest'); this.drawCardOnce();\n  }\n  myPlayer() { return this.info.players.find(p => p.id === this.me); }\n  drawCardOnce() {\n    const ui = this.g.ui; ui.open('sessioncard', (e) => {\n      e.appendChild(txt('div', 'title-h', 'Totter Fit')); const c = el('div', 'bigcard'); c.appendChild(txt('div', 'line', 'Stay balanced through the class: highest score wins.')); this.playersEl = el('div', 'row'); c.appendChild(this.playersEl); c.appendChild(ui.promptBar([['lean', 'Lean'], ['feet', 'Feet'], ['flail', 'Flail']])); this.leftEl = txt('div', 'sub-h', 'Starting...'); c.appendChild(this.leftEl); e.appendChild(c);\n      e.appendChild(el('div', 'grow')); const row = el('div', 'row'); this.readyBtn = ui.btn('Ready', () => this.H.answer('ready'), { def: true }); this.moreBtn = ui.btn('More time', () => this.H.answer('more')); const g1 = el('span'); g1.dataset.verb = 'use'; this.readyBtn.appendChild(g1); const g2 = el('span'); g2.dataset.verb = 'more'; this.moreBtn.appendChild(g2); row.append(this.readyBtn, this.moreBtn); e.appendChild(row);\n    }, { onMore: () => this.H.answer('more') }); this.drawCard();\n  }\n  drawCard() {\n    const c = this.cardState; if (!this.playersEl) return; this.playersEl.textContent = '';\n    for (const p of this.info.players) { const t = el('div', 'gaugeTag'); t.style.color = p.color; t.textContent = `${p.name}${(c.ready || []).includes(p.id) ? ' ✓' : ''}`; this.playersEl.appendChild(t); }\n    this.leftEl.textContent = c.starting ? 'Starting...' : c.paused ? 'Paused' : c.left == null ? 'Starting...' : `${Math.ceil(c.left / 1000)} seconds`;\n    this.moreBtn.firstChild.textContent = c.asked ? 'Take it back' : 'More time';\n  }\n  hideCard() { if (this.g.ui.has('sessioncard')) { this.g.ui.closeTo('sessioncard'); this.g.ui.close(); } this.playersEl = null; }\n  onMsg(m, from) {\n    if (!m || m.t !== 'g') return; let gh = this.ghosts.get(from);\n    if (!gh) { const p = this.info.players.find(q => q.id === from); if (!p) return; gh = new Ghost(this.g, p); this.ghosts.set(from, gh); gh.slotPos = this.seatX(from); }\n    gh.apply(m);\n  }\n  onLeave(e) { const gh = this.ghosts.get(e.id); if (gh) { gh.remove(); this.ghosts.delete(e.id); } }\n  seatX(id) { const n = this.info.players.length; return (this.info.players.findIndex(p => p.id === id) - (n - 1) / 2) * 3.2; }\n  toggleVolumes() {\n    const ui = this.g.ui; if (ui.has('sessionvol')) { ui.closeTo('sessionvol'); ui.close(); return; }\n    const S = this.g.settings; ui.open('sessionvol', (e) => { e.classList.add('dim'); e.appendChild(txt('div', 'title-h', 'Volumes')); const c = el('div', 'col'); const save = () => this.g.applySettings(); c.append(ui.slider('Music', () => S.music, (v) => { S.music = v; save(); }, 0, 100, 5), ui.slider('Sound', () => S.sfx, (v) => { S.sfx = v; save(); }, 0, 100, 5), ui.slider('Voice', () => S.voice, (v) => { S.voice = v; save(); }, 0, 100, 5)); e.appendChild(c); }, { onBack: () => this.toggleVolumes() });\n  }\n  fixed(dt) {\n    if (this.ended) return; const t = this.H.time(); if (!Number.isFinite(t)) return;\n    if (t < 0) { if (this.ev && this.slot === -1) { const n = Math.ceil(-t / 1000); this.ev.setBig?.(String(n)); } return; }\n    const s = Math.floor(t / SLOT); const within = t - s * SLOT;\n    if (s >= 3) { this.finishRound(); }\n    else if (s !== this.slot) this.enterSlot(s);\n    if (this.ev && s < 3) {\n      const inPlay = within >= INTRO && within < INTRO + PLAY;\n      if (inPlay && this.slotStage !== 'play') { this.slotStage = 'play'; this.g.ui.closeAll(); this.ev.count = 0; }\n      if (within >= INTRO + PLAY && this.slotStage !== 'score') { this.slotStage = 'score'; this.closeSlot(); }\n      if (this.slotStage === 'intro') { const left = Math.ceil((INTRO - within) / 1000); this.ev.setBig?.(left <= 3 ? String(left) : ''); }\n      if (this.slotStage === 'play' && this.ev.phase === 'done' && !this.earlyTag) { this.earlyTag = true; this.ev.setMsg('Nicely done. Waiting for the others.'); }\n    }\n    this.sendT -= dt; this.progT -= dt;\n    if (this.sendT <= 0) { this.sendT = .1; this.sendGhost(s); }\n    if (this.progT <= 0) { this.progT = 1; const live = this.slotScore(); this.H.progress({ score: this.score + live, label: this.ev && this.deal[s] ? `${EVENTS[this.deal[s]].title} ${this.score + live}` : `Class ${this.score}` }); }\n    for (const [id, gh] of this.ghosts) { const vis = gh.a === this.slot && !!this.ev && this.slotStage !== 'done'; if (vis && this.ev) { gh.attach(this.ev); } gh.tick(dt, vis); }\n  }\n  slotScore() { if (!this.ev || this.slot < 0 || this.slotClosed) return 0; const f = this.ev.liveForm ? this.ev.lanes[0]?.form || 0 : 0; return Math.round(f * 10); }\n  sendGhost(s) {\n    const ev = this.ev, l = ev && ev.lanes[0]; const body = l?.bal; const lx = body ? body.leanX : 0, lz = body ? body.leanZ : 0;\n    this.H.send({ t: 'g', a: Math.min(s, 2), x: +(l ? this.seatX(this.me) : 0).toFixed(2), z: 0, lx: +lx.toFixed(3), lz: +lz.toFixed(3), c: 0, f: l?.fallen ? 1 : 0, s: this.score + this.slotScore() }, { reliable: false });\n  }\n  enterSlot(s) {\n    const g = this.g; this.slot = s; this.slotClosed = false; this.earlyTag = false; this.slotStage = 'intro'; const id = this.deal[s], Cls = EVENTS[id]; const cfg = Cls.sessionConfig || {};\n    g.ui.closeAll(); for (const gh of this.ghosts.values()) gh.attach(null);\n    // Own lane sits at its seat so everyone lines up the same on every copy.\n    const specs = [{ kind: 'local