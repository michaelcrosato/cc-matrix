evaluate(() => __TEST__.g.hub.px); await page.keyboard.down('KeyD'); await adv(.5); await page.keyboard.up('KeyD'); await adv(.05); T.ok(await page.evaluate((a) => Math.abs(__TEST__.g.hub.px - a) > .5 || true, px0), 'keys walk'); const moved = await page.evaluate((a) => __TEST__.g.hub.px - a, px0); T.ok(Math.abs(moved) > .5, `D walks, moved ${moved}`);\n  const yaw0 = await page.evaluate(() => __TEST__.g.hub.camYawO); await page.mouse.move(500, 500); await page.mouse.down({ button: 'right' }); await page.mouse.move(700, 500, { steps: 4 }); await adv(.05); await page.mouse.up({ button: 'right' }); const yaw1 = await page.evaluate(() => __TEST__.g.hub.camYawO); T.ok(yaw0 !== yaw1, 'right-drag looks'); const d0 = await page.evaluate(() => __TEST__.g.hub.camDist); await page.mouse.wheel(0, 200); await page.waitForTimeout(50); await adv(.05); T.ok(await page.evaluate((a) => __TEST__.g.hub.camDist !== a, d0), 'wheel zooms');\n  await page.evaluate(() => { const p = window.__pads[0]; p.axes[2] = .9; }); await adv(.2); await page.evaluate(() => { window.__pads[0].axes[2] = 0; }); T.ok(yaw1 !== await page.evaluate(() => __TEST__.g.hub.camYawO), 'right stick looks');\n  // Xbox glyph option.\"\"\")\nopen('test/input.mjs','w').write(s)\nE\ntimeout 300 node tools/test.mjs input 2>&1 | cut -c1-300 | grep -v '^ *at ' | tail -8","description":"Add island mouse and look tests and run them","timeout":320000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2366,"cache_read_input_tokens":511184,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2366},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"8a072f9b-0514-49a4-8d3e-a288455729b4","timestamp":"2026