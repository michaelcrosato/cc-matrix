{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjmzah1DDKm1drG2vwqi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016L7opBL4rR9r8VSJmoAMCk","name":"Bash","input":{"command":"cat > src/art/island.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { rbox, tree, palm, bunting, pavilion, plankWalk, bench, crate, lantern, rock, stoneStack, buoy, deck, grassPatch } from './props.js';\nimport { sphere, cyl, cone, box, torus, at, capsule, toon, glass, flat, mesh, cached } from './materials.js';\nimport { makeDoll } from './doll.js';\nimport { GUESTS } from '../data/names.js';\nimport { cosRange, cosmetic, pick } from '../core/rng.js';\nexport const LANDMARKS = {\n  lighthouse: { x: 2, z: -9, label: 'The Lighthouse', r: 3.2 }, jar: { x: -3, z: -4, label: 'The Jar', r: 2.4 }, circus: { x: 0, z: 2, label: 'Circus Green', r: 2.6 }, sunDeck: { x: -16, z: -3, label: 'The Sun Deck', r: 3.4 }, lilyPond: { x: -13, z: 7, label: 'The Lily Pond', r: 3.4 }, quarry: { x: -9, z: -13, label: 'Quarry Terrace', r: 3 }, yard: { x: -7, z: 14, label: 'The Yard', r: 3 }, gazebo: { x: 14, z: -11, label: 'The Gazebo', r: 3 }, bandstand: { x: 15, z: -3, label: 'The Bandstand', r: 3.2 }, boardwalk: { x: 19, z: 3, label: 'The Boardwalk', r: 2.6 }, pier: { x: 15, z: 12, label: 'The Pier', r: 2.8 }, beach: { x: 5, z: 17, label: 'The Beach', r: 3 }, board: { x: 1, z: 9, label: 'The Notice Board', r: 2.2 }, bedHut: { x: 8, z: 8, label: 'The Bed Hut', r: 2.6 }, mirror: { x: 9, z: -14, label: 'The Mirror', r: 2.6 },\n};\nexport const JAR_POS = { x: -3, z: -4 };\nexport class Island {\n  constructor(scene) {\n    this.scene = scene; this.group = new THREE.Group(); scene.add(this.group); this.world = new THREE.Group(); this.group.add(this.world);\n    this.tx = 0; this.tz = 0; this.vt = 0; this.tilt = null; this.heldX = null; this.anim = []; this.guests = []; this.mixTick = 0; this.restDeg = 9; this.stage = 'hub';\n    this.buildGround(); this.buildLandmarks(); this.buildScatter(); this.buildJar(); this.buildGuests();\n  }\n  buildGround() {\n    const W = this.world;\n    const sand = cyl(22, 22, .3, '#F0DDB0', 64); W.add(at(sand, 0, -.16, 0));\n    const grass = cyl(15, 15, .3, '#8FD06F', 48); W.add(at(grass, 0, -.149, 0));\n    const road = torus(19, .55, '#E3CFA3'); road.rotation.x = Math.PI / 2; road.scale.z = .02; W.add(at(road, 0, -.003, 0));\n    const rockM = cone(21, 20, '#8F8578', 32); rockM.rotation.x = Math.PI; W.add(at(rockM, 0, -10.3, 0));\n    for (let i = 0; i < 40; i++) { const a = i / 40 * 6.283; const f = box(.14, .72, 1.5, i % 2 ? '#E9D3AE' : '#FFF8EE'); f.rotation.y = -a; f.position.set(Math.cos(a) * 22, .36, Math.sin(a) * 22); W.add(f); }\n    this.pivot = new THREE.Group(); const piv = sphere(5, '#6F665C', 1.15, .8, 1.1); this.pivot.add(at(piv, 0, -24, 0)); this.scene.add(this.pivot);\n  }\n  buildLandmarks() {\n    const W = this.world, L = LANDMARKS, put = (o, k, dx = 0, dz = 0) => { o.position.x = L[k].x + dx; o.position.z = L[k].z + dz; W.add(o); return o; };\n    // Lighthouse: stacked red and cream rings, a lamp, a blue cap.\n    const lh = new THREE.Group(); let y = 0; const rings = 9; for (let i = 0; i < rings; i++) { const rb = 2 - i * .1, rt = rb - .1, h = 1.3; lh.add(at(cyl(rt, rb, h, i % 2 ? '#FFF8EE' : '#E8443A', 24), 0, y + h / 2, 0)); y += h; }\n    lh.add(at(cyl(1.5, 1.3, .3, '#1A1420', 24), 0, y + .15, 0)); this.lhLamp = cyl(.72, .72, 1.2, '#FFF2C2', 16); lh.add(at(this.lhLamp, 0, y + .9, 0)); lh.add(at(cone(1.05, 1, '#3B82F6', 16), 0, y + 2, 0)); lh.add(at(box(.8, 1.4, .1, '#7A5A3C'), 0, .7, 2)); put(lh, 'lighthouse'); this.lighthouse = lh;\n    // Sun Deck\n    const sd = deck(3.6, '#C89B6A', false, .12); put(sd, 'sunDeck'); const sdp = pavilion(3, 3, 2.3, '#F58A5C'); sdp.position.y = .12; put(sdp, 'sunDeck', -.3, -.3);\n    // Lily pond\n    const pond = cyl(3.6, 3.6, .04, '#57B8A8', 32); put(at(pond, 0, .012, 0), 'lilyPond'); for (let i = 0; i < 7; i++) { const a = i * 1.7, r = .7 + i * .38; put(at(cyl(.4, .38, .04, '#4FB56A', 12), 0, .05, 0), 'lilyPond', Math.cos(a) * r, Math.sin(a) * r); } const rim = torus(3.6, .18, '#BDB2A2'); rim.rotation.x = Math.PI / 2; put(at(rim, 0, .05, 0), 'lilyPond');\n    // Quarry terrace\n    const q = cyl(3.2, 3.5, .3, '#D8CDBB', 10); put(at(q, 0, .1, 0), 'quarry'); put(stoneStack(5), 'quarry', -.8, .4); put(stoneStack(3), 'quarry', 1, -.8); put(rock(.9), 'quarry', -2, -1.8); put(rock(.65), 'quarry', 2.3, .9);\n    // Yard\n    put(at(box(3.4, .04, 3.4, '#D9694F'), 0, .02, 0), 'yard'); const lg = cyl(.16, .16, 2, '#9C7048'); lg.rotation.z = 1.57; put(at(lg, 0, 1.2, 0), 'yard'); for (const s of [-1, 1]) put(at(cyl(.09, .1, 1.2, '#7A5A3C'), 0, .6, 0), 'yard', s, 0); put(bench(), 'yard', 0, -2.2);\n    // Bandstand\n    const bs = new THREE.Group(); bs.add(at(cyl(3.2, 3.3, .3, '#C89B6A', 8), 0, .15, 0)); for (let i = 0; i < 8; i++) { const a = i / 8 * 6.283 + .39; bs.add(at(cyl(.09, .1, 2.8, '#FFF8EE'), Math.cos(a) * 2.9, 1.6, Math.sin(a) * 2.9)); } bs.add(at(cone(3.8, 1.5, '#2FA7A0', 8), 0, 3.7, 0)); put(bs, 'bandstand');\n    // Circus Green\n    const cg = cyl(2.8, 2.8, .03, '#FFF2C2', 32); put(at(cg, 0, .015, 0), 'circus'); for (let i = 0; i < 5; i++) { const a = i / 5 * 6.283; put(at(cyl(.03, .04, 1.8, '#FFF8EE'), 0, .9, 0), 'circus', Math.cos(a) * 2.2, Math.sin(a) * 2.2); put(at(cyl(.28, .18, .05, ['#3B82F6', '#22C55E', '#E8443A'][i % 3]), 0, 1.84, 0), 'circus', Math.cos(a) * 2.2, Math.sin(a) * 2.2); }\n    // Pier, running out to sea.\n    const pier = plankWalk(18, 3); pier.rotation.y = -Math.PI / 4 * 3; pier.position.set(L.pier.x - 1, 0, L.pier.z - 1); W.add(pier);\n    const tower = new THREE.Group(); const COL = ['#E8443A', '#F5B700', '#3B82F6', '#22C55E']; for (let i = 0; i < 5; i++) tower.add(at(box(2, 1, 2, COL[i % 4]), 0, i + .5, 0)); tower.position.set(L.pier.x + 12, 0, L.pier.z + 12); W.add(tower);\n    // Boardwalk gate\n    const bg = new THREE.Group(); for (const s of [-1, 1]) bg.add(at(cyl(.12, .14, 2.8, '#FFF8EE'), 0, 1.4, s * 1)); bg.add(at(box(.2, .5, 2.8, '#2FA7A0'), 0, 2.8, 0)); put(bg, 'boardwalk'); const bw = plankWalk(14, 1.6); bw.rotation.y = -Math.PI / 2; bw.position.set(L.boardwalk.x, 0, L.boardwalk.z); W.add(bw);\n    // Beach\n    put(palm(1.4), 'beach', -3, 1); put(palm(1.2), 'beach', 3.2, .4); const bb = sphere(.4, '#FFF8EE'); put(at(bb, 0, .35, 0), 'beach', 1, 2); const tugRope = cyl(.03, .03, 5, '#E9D3AE', 6); tugRope.rotation.z = 1.57; put(at(tugRope, 0, .05, 0), 'beach');\n    // Notice board\n    const nb = new THREE.Group(); for (const s of [-1, 1]) nb.add(at(cyl(.08, .09, 2, '#7A5A3C'), s * .9, 1, 0)); nb.add(at(box(2.3, 1.2, .12, '#C89B6A'), 0, 1.5, 0)); nb.add(at(box(.8, .6, .02, '#FFF8EE'), -.4, 1.5, .07)); nb.add(at(box(.7, .8, .02, '#F7E08A'), .55, 1.45, .07)); put(nb, 'board');\n    // Bed hut\n    const bh = new THREE.Group(); bh.add(at(rbox(3, 2.1, 2.6, .12, '#E9D3AE'), 0, 1.05, 0)); bh.add(at(cone(2.5, 1.3, '#F58A5C', 4), 0, 2.75, 0)); bh.children[1].rotation.y = .785; bh.add(at(box(.8, 1.5, .08, '#7A5A3C'), 0, .75, 1.3)); bh.add(at(sphere(.1, '#F5B700'), .28, .75, 1.36)); put(bh, 'bedHut');\n    // Mirror pavilion\n    const mp = pavilion(2.6, 2.6, 2.2, '#8E6BD8'); put(mp, 'mirror'); const fr = torus(.8, .08, '#F5B700'); fr.scale.y = 1.25; put(at(fr, 0, 1.2, 0), 'mirror'); const mg = new THREE.Mesh(new THREE.CircleGeometry(.76, 24), flat('#BDE7F4')); mg.scale.y = 1.25; put(at(mg, 0, 1.2, .01), 'mirror');\n    // Gazebo with a dock\n    const gz = pavilion(3, 3, 2.4, '#2FA7A0'); put(gz, 'gazebo'); put(crate(.7), 'gazebo', 2.4, 0);\n    for (const k of Object.keys(L)) { /* signposts */ if (['board', 'jar', 'lighthouse'].includes(k)) continue; const s = new THREE.Group(); s.add(at(cyl(.05, .06, 1.3, '#7A5A3C'), 0, .65, 0)); s.add(at(rbox(.8, .3, .06, .03, '#FFF8EE'), 0, 1.2, 0)); s.rotation.y = -Math.atan2(L[k].z, L[k].x) - 1.57; put(s, k, -Math.cos(Math.atan2(L[k].z, L[k].x)) * (L[k].r + .6), -Math.sin(Math.atan2(L[k].z, L[k].x)) * (L[k].r + .6)); }\n  }\n  buildScatter() {\n    const W = this.world, spots = Object.values(LANDMARKS);\n    const clear = (x, z, r) => spots.every(s => Math.hypot(s.x - x, s.z - z) > s.r + r) && Math.abs(Math.hypot(x, z) - 19) > 1.3;\n    let placed = 0, tries = 0; while (placed < 34 && tries++ < 500) { const a = cosRange(0, 6.283), d = cosRange(4, 21), x = Math.cos(a) * d, z = Math.sin(a) * d; if (!clear(x, z, 1.1)) continue; const t = d > 15 ? palm(cosRange(.8, 1.3)) : tree(cosRange(.8, 1.4), pick(['#6FBF5A', '#7CC568', '#F4A6C0', '#5EAE64', '#FFD08A'])); t.position.set(x, 0, z); W.add(t); placed++; }\n    for (let i = 0; i < 60; i++) { const a = cosRange(0, 6.283), d = cosRange(2, 14.5), x = Math.cos(a) * d, z = Math.sin(a) * d; if (!clear(x, z, .2)) continue; const f = sphere(.07, pick(['#F4A6C0', '#FFF8EE', '#F7E04B', '#B4CCF4']), 1, .7, 1); W.add(at(f, x, .06, z)); }\n    for (let i = 0; i < 12; i++) { const a = i / 12 * 6.283 + .2, r = 20.8; W.add(at(lantern(i % 2 ? '#F5B700' : '#F58A5C'), Math.cos(a) * r, 0, Math.sin(a) * r)); }\n    W.add(bunting(LANDMARKS.lighthouse.x, 8, LANDMARKS.lighthouse.z, LANDMARKS.circus.x, 3, LANDMARKS.circus.z - 1, 22));\n    W.add(bunting(LANDMARKS.bedHut.x, 3, LANDMARKS.bedHut.z, LANDMARKS.board.x + 1, 2.2, LANDMARKS.board.z, 10));\n  }\n  buildJar() {\n    const g = new THREE.Group(); g.position.set(JAR_POS.x, .08, JAR_POS.z); this.jarGroup = g; this.world.add(g);\n    const pts = [[.01, 0], [1, .02], [1.08, .12], [1.08, 1.9], [.86, 2.2], [.86, 2.45], [.95, 2.5]].map(p => new THREE.Vector2(p[0], p[1]));\n    const jar = new THREE.Mesh(new THREE.LatheGeometry(pts, 32), glass()); jar.renderOrder = 5; g.add(jar);\n    for (const [r, y] of [[1.08, .12], [1.08, 1.9], [.86, 2.2], [.95, 2.5]]) { const t = torus(r, .022, '#1A1420'); t.rotation.x = Math.PI / 2; t.position.y = y; g.add(t); }\n    for (const a of [.6, .9]) { const s = new THREE.Mesh(new THREE.BoxGeometry(.05, a === .6 ? 1.2 : .7, .01), flat('#FFFFFF', .75)); s.position.set(Math.sin(a) * 1.07 - .4, 1, Math.cos(a) * 1.07); g.add(s); }\n    g.add(at(cyl(1.3, 1.4, .1, '#C89B6A', 24), 0, -.04, 0));\n    this.marbles = new THREE.InstancedMesh(new THREE.SphereGeometry(.14, 12, 9), toon('#ffffff'), 420); this.marbles.frustumCulled = false; this.marbles.count = 0; g.add(this.marbles);\n  }\n  /** Rest layout: packed rings from the bottom, repeatable from the index. */\n  marbleRest(i) { const perLayer = 28, layer = Math.floor(i / perLayer), k = i % perLayer; const ring = k < 1 ? 0 : k < 7 ? 1 : k < 17 ? 2 : 3; const counts = [1, 6, 10, 11], starts = [0, 1, 7, 17]; const a = (k - starts[ring]) / counts[ring] * 6.283 + layer * .7; const r = [0, .28, .56, .84][ring]; return [Math.cos(a) * r, .17 + layer * .25 + (ring % 2) * .05, Math.sin(a) * r]; }\n  setMarbles(list) { const n = Math.min(list.length, 420); const m = new THREE.Matrix4(), c = new THREE.Color(); this.marbles.count = n; for (let i = 0; i < n; i++) { const p = this.marbleRest(i); m.makeTranslation(p[0], p[1], p[2]); this.marbles.setMatrixAt(i, m); this.marbles.setColorAt(i, c.set(list[i])); } this.marbles.instanceMatrix.needsUpdate = true; if (this.marbles.instanceColor) this.marbles.instanceColor.needsUpdate = true; }\n  buildGuests() {\n    const W = this.world, spots = Object.values(LANDMARKS);\n    GUESTS.forEach((g, i) => { for (let n = 0; n < 2; n++) {\n      const d = makeDoll({ paint: g.paint, hat: g.hat, skin: g.skin, height: g.height, width: g.width }); const s = spots[(i * 3 + n * 5) % spots.length];\n      d.group.position.set(s.x + 2, 0, s.z + 2); d.rig.play('walk', 0); d.rig.mixer.setTime(cosmetic()); W.add(d.group);\n      this.guests.push({ d, name: g.name, target: pick(spots), wait: cosRange(0, 3), speed: cosRange(.7, 1.1), key: ['margaret', 'kevin', 'sandra', 'sandra', 'paul', 'gerald'][i] });\n    } });\n  }\n  showGuests(on) { for (const g of this.guests) g.d.group.visible = on; }\n  tickGuests(dt) {\n    const spots = Object.values(LANDMARKS);\n    for (const g of this.guests) {\n      if (!g.d.group.visible) continue; g.d.tick(dt); const p = g.d.group.position;\n      if (g.wait > 0) { g.wait -= dt; if (g.wait <= 0) { g.target = pick(spots); g.d.rig.play('walk', .2); } continue; }\n      const dx = g.target.x - p.x, dz = g.target.z - p.z, d = Math.hypot(dx, dz);\n      if (d < g.target.r + 1) { g.wait = cosRange(2, 8); g.d.rig.play(pick(['idle', 'clap', 'breathe', 'idle']), .25); continue; }\n      p.x += dx / d * g.speed * dt; p.z += dz / d * g.speed * dt; g.d.setFace(Math.atan2(dx, dz));\n    }\n  }\n  nearestGuest(x, z, within = 2.2) { let best = null, bd = within; for (const g of this.guests) { if (!g.d.group.visible) continue; const d = Math.hypot(g.d.group.position.x - x, g.d.group.position.z - z); if (d < bd) { bd = d; best = g; } } return best; }\n  setStage(stage) {\n    this.stage = stage; this.heldX = null;\n    this.group.visible = true; this.group.position.set(0, 0, 0); this.group.scale.setScalar(1);\n    if (stage === 'backdrop') this.group.position.set(55, -.4, -95);\n    if (stage === 'below') this.group.position.set(-2, 0, 9);\n    this.pivot.position.copy(this.group.position);\n    if (stage === 'hidden') this.group.visible = false; this.pivot.visible = this.group.visible;\n  }\n  setRest(deg) { this.restDeg = deg; }\n  restVec() { const r = this.restDeg * Math.PI / 180; return [r * .8, r * .6]; }\n  setHeld(tx, tz) { this.heldX = tx; this.heldZ = tz; }\n  tick(dt) {\n    if (!this.group.visible) return;\n    if (!this.tilt) {\n      const [rx, rz] = this.restVec(); const tx = this.heldX ?? rx, tz = this.heldZ ?? rz; const k = 1 - Math.exp(-2.2 * dt);\n      this.tx += (tx - this.tx) * k; this.tz += (tz - this.tz) * k;\n      const a = Math.hypot(this.tx, this.tz) || 1e-9, s = Math.sin(a / 2); this.group.quaternion.set(this.tz / a * s, 0, -this.tx / a * s, Math.cos(a / 2));\n    } else { this.tx = this.tilt.tx; this.tz = this.tilt.tz; }\n    this.tickGuests(dt);\n  }\n}\nE\ncat > src/game/hub.js <<'E'\n// The island: tilt physics, the walker, loose props, Trudy, hotspots.\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, groups, GROUND } from '../physics/world.js';\nimport { makeIslandWorld, TiltModel, restWeight } from '../physics/island.js';\nimport { LANDMARKS, JAR_POS } from '../art/island.js';\nimport { makeDoll } from '../art/doll.js';\nimport { makeTrudy } from '../art/trudy.js';\nimport { sphere, box, torus, cone, at, cyl, toon } from '../art/materials.js';\nimport { T } from '../core/tuning.js';\nimport { screenToWorld } from '../render/cameraRig.js';\nimport { cosRange } from '../core/rng.js';\nimport { el, txt } from '../ui/ui.js';\nconst rad = (d) => d * Math.PI / 180;\nconst PROP_G = groups(0x0010, 0xffff & ~0x0100 | GROUND | 0x0010);\nexport class Hub {\n  constructor(game, profile) {\n    this.game = game; this.screen = 'island'; this.p = profile; this.world = makeIslandWorld(); this.tiltM = new TiltModel({ K: 2.2, C: 1.8, W: restWeight() }); this.isl = game.island; this.isl.setStage('hub'); this.isl.tilt = this.tiltM;\n    const [rx, rz] = this.isl.restVec(); this.tiltM.restX = rx; this.tiltM.restZ = rz; this.tiltM.tx = rx; this.tiltM.tz = rz;\n    this.group = new THREE.Group(); this.isl.group.add(this.group);\n    this.doll = makeDoll({ paint: profile.paint, hat: profile.hat, skin: profile.skin }); this.group.add(this.doll.group);\n    this.body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, .9, 10).lockRotations().setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.capsule(.5, .3).setMass(1).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setCollisionGroups(groups(0x0100, GROUND | 0x0010)), this.body);\n    this.px = 0; this.pz = 10; this.camYawO = 0; this.camPitch = .45; this.camDist = 11; this.face = Math.PI; this.locked = false; this.walkTarget = null; this.walking = false; this.leanMode = false; this.leanX = 0; this.leanZ = 0; this.hover = null; this.focusSpot = null; this.idleT = 0; this.trudyGoal = { x: 2, z: 12 };\n    this.trudy = makeTrudy(); this.trudy.group.position.set(2, 0, 11); this.group.add(this.trudy.group); this.trudyHop = 0;\n    this.props = []; this.addProps();\n    this.spots = []; this.buildMarkers();\n    this.labelRoot = el('div'); this.game.ui.hud.innerHTML = ''; this.game.ui.hud.appendChild(this.labelRoot); this.label = el('div', 'hoverlabel'); this.label.style.display = 'none'; this.labelRoot.appendChild(this.label);\n    this.useTag = el('div', 'bottomprompts'); this.labelRoot.appendChild(this.useTag); this.useText = null;\n    this.rig = game.rig; this.placeCam(true); this.hudDirty = true;\n    this.game.ui.onWorldClick = (e) => this.worldClick(e);\n    this.props.forEach(() => {}); this.creakT = 0;\n  }\n  setSpots(list) { this.spots = list; this.markers.forEach((m, i) => { const s = list[i]; m.visible = !!(s && s.marked); if (s) m.position.set(s.x, 2.6, s.z); }); }\n  buildMarkers() { this.markers = []; for (let i = 0; i < 10; i++) { const a = cone(.28, .5, '#FFD23F'); a.rotation.x = Math.PI; a.visible = false; this.group.add(a); this.markers.push(a); } this.ring = torus(1.4, .08, '#FFD23F'); this.ring.rotation.x = Math.PI / 2; this.ring.visible = false; this.ring.position.y = .06; this.group.add(this.ring); }\n  addProps() {\n    const add = (mesh, collider, x, y, z, mass) => { const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, y, z).setCanSleep(false).setLinearDamping(.25).setAngularDamping(.4)); this.world.createCollider(collider.setMass(mass).setFriction(.5).setRestitution(.2).setCollisionGroups(groups(0x0010, GROUND | 0x0010 | 0x0100)), b); this.group.add(mesh); this.props.push({ b, m: mesh }); };\n    for (let i = 0; i < 30; i++) { const a = i * 2.4, r = 1.5 + i * .55; add(sphere(.2, i % 5 === 0 ? '#F7E04B' : '#F58A2E'), RAPIER.ColliderDesc.ball(.2), Math.cos(a) * r, .3, Math.sin(a) * r, .2); }\n    for (let i = 0; i < 6; i++) { const a = i * 1.1 + .6, r = 7 + i * 1.6; add(box(.6, .5, .6, '#C89B6A'), RAPIER.ColliderDesc.cuboid(.3, .25, .3), Math.cos(a) * r, .4, Math.sin(a) * r, .6); }\n    for (let i = 0; i < 4; i++) { const a = i * 1.57 + .3, r = 13; add(sphere(.42, ['#E8443A', '#3B82F6', '#22C55E', '#FFF8EE'][i]), RAPIER.ColliderDesc.ball(.42), Math.cos(a) * r, .6, Math.sin(a) * r, .3); }\n  }\n  setTiltRest(deg) { this.isl.setRest(deg); const [rx, rz] = this.isl.restVec(); this.tiltM.restX = rx; this.tiltM.restZ = rz; }\n  teleport(x, z, faceAway = true) { this.px = x; this.pz = z; this.body.setTranslation({ x, y: .9, z }, true); this.body.setLinvel({ x: 0, y: 0, z: 0 }, true); this.walkTarget = null; this.trudy.group.position.set(x + 1.6, 0, z + 1.2); this.placeCam(true); }\n  dropIn() { this.body.setTranslation({ x: 0, y: 9, z: 10 }, true); this.drop = true; this.doll.rig.play('splay', 0); }\n  placeCam(snap) {\n    const y = this.camYawO, p = this.camPitch, d = this.camDist; const q = this.isl.group.quaternion; const a = new THREE.Vector3(this.px, 1.1, this.pz);\n    const c = new THREE.Vector3(this.px + Math.sin(y) * Math.cos(p) * d, 1.1 + Math.sin(p) * d, this.pz + Math.cos(y) * Math.cos(p) * d);\n    a.applyQuaternion(q); c.applyQuaternion(q); c.y = Math.max(c.y, 1.2);\n    this.rig.set(c.x, c.y, c.z, a.x, a.y, a.z, snap); this.rig.damp = 6;\n  }\n  fixed(dt) {\n    const I = this.game.input.merged, ks = this.game.input; const yaw = this.camYawO;\n    if (!this.locked) {\n      this.camYawO -= I.lookX * (I.activeDevice === 'kbm' ? 1 : 1); this.camPitch = Math.max(.15, Math.min(1.1, this.camPitch + I.lookY)); const w = ks.takeWheel(); if (w) this.camDist = Math.max(6, Math.min(22, this.camDist + w * 1.1));\n    }\n    let mx = 0, mz = 0, speed = T.walkSpeed;\n    if (!this.locked && !this.leanMode && !this.drop) {\n      const raw = Math.hypot(I.walkX, I.walkZ);\n      if (raw > .1) { this.walkTarget = null; [mx, mz] = screenToWorld(I.walkX, I.walkZ, -yaw); }\n      else if (this.walkTarget) { const dx = this.walkTarget.x - this.px, dz = this.walkTarget.z - this.pz, d = Math.hypot(dx, dz); if (d < (this.walkTarget.r || 1)) { const t = this.walkTarget; this.walkTarget = null; if (t.act) t.act(); } else { mx = dx / d; mz = dz / d; } }\n    }\n    const v = this.body.linvel(); this.body.setLinvel({ x: mx * speed + this.tiltM.tx * 3, y: v.y, z: mz * speed + this.tiltM.tz * 3 }, true);\n    const p = this.body.translation(); this.px = p.x; this.pz = p.z;\n    if (this.drop && p.y < 1) { this.drop = false; this.game.audio.sfx('clatter'); this.game.audio.sfx('spring'); this.doll.land(); this.doll.rig.play('land', .05, 'idle'); this.game.comicIsland('CLACK!', p.x, 1.4, p.z); this.game.rig.shake(.1); this.dropped = true; }\n    this.walking = Math.hypot(mx, mz) > .1;\n    if (this.walking) { this.face = Math.atan2(mx, mz); this.idleT = 0; } else this.idleT += dt;\n    // Tilt: your position leans the island; in the first lesson the stick does it directly.\n    const addX = this.leanMode ? I.x * rad(7) : 0, addZ = this.leanMode ? I.z * rad(7) : 0; this.leanX = I.x; this.leanZ = I.z;\n    const rx = this.tiltM.restX, rz = this.tiltM.restZ; this.tiltM.restX = rx + addX; this.tiltM.restZ = rz + addZ;\n    this.tiltM.W = restWeight(); this.tiltM.step(dt, this.px, this.pz, T.islandSpring, this.tiltM.W); this.tiltM.restX = rx; this.tiltM.restZ = rz;\n    this.tiltM.applyGravity(this.world, T.gravity); this.tiltM.applyGroup(this.isl.group);\n    this.world.step();\n    if (p.y < -5 || !Number.isFinite(p.x)) this.teleport(0, 10);\n    this.updateFocus();\n    // Trudy follows, and hops\n    const tp = this.trudy.group.position; const gx = this.px + 1.7 * Math.cos(this.face + 1.2), gz = this.pz - 1.7 * Math.sin(this.face + 1.2); const dd = Math.hypot(gx - tp.x, gz - tp.z);\n    if (dd > 1.1) { const sp = Math.min(T.walkSpeed * 1.1, dd * 1.4); tp.x += (gx - tp.x) / dd * sp * dt; tp.z += (gz - tp.z) / dd * sp * dt; this.trudyHop += dt * 7; this.trudy.group.rotation.y = Math.atan2(this.px - tp.x, this.pz - tp.z); tp.y = Math.abs(Math.sin(this.trudyHop)) * .22; } else { tp.y = 0; this.trudy.group.rotation.y = Math.atan2(this.px - tp.x, this.pz - tp.z); }\n  }\n  updateFocus() {\n    let best = null, bd = 1e9; for (const s of this.spots) { const d = Math.hypot(s.x - this.px, s.z - this.pz); if (d < (s.r || 2.2) + .6 && d < bd) { bd = d; best = s; } }\n    this.focusSpot = best;\n    const I = this.game.input.merged; if (this.locked || this.leanMode || this.game.ui.top() || this.game.speech.busy) return;\n    if ((I.use || (I.hop && best)) && best) { this.game.audio.sfx('ok'); this.useSpot(best); }\n    else if (I.hop && !best) this.hopDoll();\n  }\n  useSpot(s) { s.act(); }\n  hopDoll() { if (this.hopY > 0) return; this.hopV = 4.2; this.hopY = .001; this.doll.rig.play('hop', .05, 'idle'); this.game.audio.sfx('spring'); }\n  hoverAt(x, y) {\n    const cam = this.game.camera; cam.updateMatrixWorld(); const v = new THREE.Vector3(); let best = null, bd = 90 * (innerHeight / 1080);\n    this.isl.group.updateMatrixWorld();\n    for (const s of this.spots) { v.set(s.x, 1.4, s.z).applyMatrix4(this.isl.group.matrixWorld).project(cam); if (v.z > 1) continue; const sx = (v.x * .5 + .5) * innerWidth, sy = (-v.y * .5 + .5) * innerHeight, d = Math.hypot(sx - x, sy - y); if (d < bd) { bd = d; best = s; } }\n    return best;\n  }\n  worldClick(e) { if (this.locked || this.leanMode || this.game.mode !== this) return; const s = this.hoverAt(e.clientX, e.clientY); if (s) { this.walkTarget = { x: s.x, z: s.z, r: Math.max(1.2, (s.r || 2) - .2), act: s.act }; this.game.audio.sfx('move'); } }\n  frame(dt) {\n    const p = this.body.translation();\n    if (this.hopY > 0) { this.hopV -= 12 * dt; this.hopY += this.hopV * dt; if (this.hopY <= 0) { this.hopY = 0; this.doll.land(); } }\n    this.doll.group.position.set(p.x, p.y - .9 + (this.hopY || 0) - .0, p.z); this.doll.setFace(this.face);\n    const want = this.drop ? 'splay' : this.walking ? 'walk' : (this.doll.rig.currentName === 'land' || this.doll.rig.currentName === 'hop' ? this.doll.rig.currentName : 'idle');\n    if (this.doll.rig.currentName !== want && !this.doll.rig.then) this.doll.rig.play(want, .15);\n    // Stay visually upright: counter-rotate most of the tilt.\n    const q = this.isl.group.quaternion; this.doll.lean.quaternion.set(-q.x * .7, 0, -q.z * .7, q.w).normalize();\n    if (this.leanMode) { const m = rad(16); const ax = this.leanX * m, az = this.leanZ * m; const a = Math.hypot(ax, az) || 1e-9, s = Math.sin(a / 2); this.doll.lean.quaternion.set(az / a * s, 0, -ax / a * s, Math.cos(a / 2)); }\n    this.doll.tick(dt);\n    for (const o of this.props) { const t = o.b.translation(), r = o.b.rotation(); o.m.position.set(t.x, t.y, t.z); o.m.quaternion.set(r.x, r.y, r.z, r.w); }\n    this.trudy.tick(dt, this.tiltM.tx * -1.2 + (this.leanMode ? -this.leanX * .2 : 0));\n    this.placeCam(false);\n    // Hover and prompts\n    const inp = this.game.input; let hov = null; if (inp.lastDevice === 'kbm' && !this.game.ui.top()) hov = this.hoverAt(inp.px, inp.py);\n    const show = hov || this.focusSpot;\n    if (show && !this.locked && !this.game.ui.top() && !this.game.speech.busy) { const v = new THREE.Vector3(show.x, 2.8, show.z).applyMatrix4(this.isl.group.matrixWorld).project(this.game.camera); this.label.style.display = ''; if (this.label.textContent !== show.label) this.label.textContent = show.label; this.label.style.left = `${(v.x * .5 + .5) * 100}%`; this.label.style.top = `${(-v.y * .5 + .5) * 100}%`; this.ring.visible = true; this.ring.position.x = show.x; this.ring.position.z = show.z; this.ring.scale.setScalar((show.r || 2) / 1.4 * (1 + Math.sin(performance.now() * .006) * .04)); } else { this.label.style.display = 'none'; this.ring.visible = false; }\n    const uk = this.locked || this.game.ui.top() ? '' : (this.focusSpot ? `use:${this.focusSpot.useText || 'Use'}` : 'free');\n    if (uk !== this.useText) { this.useText = uk; this.useTag.innerHTML = ''; if (uk) { const list = uk === 'free' ? [['walk', 'Walk'], ['look', 'Look'], ['hop', 'Hop'], ['ask', 'Ask Trudy']] : [['walk', 'Walk'], ['useIsl', uk.slice(4)], ['ask', 'Ask Trudy']]; this.useTag.appendChild(this.game.ui.promptBar(list)); this.game.ui.refreshGlyphs(this.useTag); } }\n    this.isl.tick(dt);\n  }\n  dispose() {\n    this.game.ui.onWorldClick = null; this.isl.tilt = null; this.isl.tx = this.tiltM.tx; this.isl.tz = this.tiltM.tz;\n    this.group.removeFromParent(); this.world.free(); this.world = null; this.labelRoot.remove();\n  }\n}\nE\ncat > src/game/jar.js <<'E'\n// Marbles pour into the jar on the island, as real Rapier balls.\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, makeWorld, groups } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { JAR_POS } from '../art/island.js';\nimport { cosRange } from '../core/rng.js';\nimport { el, txt } from '../ui/ui.js';\nconst G = groups(1, 1);\nexport class JarMode {\n  constructor(game, old, adds) {\n    this.game = game; this.screen = 'jar'; this.isl = game.island; this.isl.setStage('hub'); this.old = old.slice(-400); this.adds = adds; this.added = 0; this.dynamic = []; this.t = 0; this.spawnT = .3; this.done = false;\n    this.world = makeWorld({ iterations: 6 });\n    const base = this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed()); this.world.createCollider(RAPIER.ColliderDesc.cylinder(.1, 1.1).setTranslation(0, -.05, 0).setFriction(.5).setCollisionGroups(G), base);\n    for (let i = 0; i < 16; i++) { const a = i / 16 * 6.283; const w = this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(Math.cos(a) * 1.13, 1.3, Math.sin(a) * 1.13).setRotation({ x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) })); this.world.createCollider(RAPIER.ColliderDesc.cuboid(.05, 1.4, .24).setFriction(.3).setCollisionGroups(G), w); }\n    // Old marbles settle as a heap of fixed balls; new ones pour on top.\n    this.statics = []; old.slice(-400).forEach((c, i) => { const p = this.isl.marbleRest(i); const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(p[0], p[1], p[2])); this.world.createCollider(RAPIER.ColliderDesc.ball(.14).setFriction(.4).setCollisionGroups(G), b); });\n    this.mesh = this.isl.marbles; this.isl.setMarbles(this.old); this.count = this.old.length; this.c = new THREE.Color(); this.m = new THREE.Matrix4();\n    const q = this.isl.jarGroup; const pos = new THREE.Vector3(); q.getWorldPosition(pos); game.rig.set(pos.x + 1, pos.y + 2.2, pos.z + 6.6, pos.x, pos.y + 1.15, pos.z, true); game.rig.damp = 5;\n    const hud = game.ui.hud; hud.innerHTML = ''; this.num = el('div', 'hudnum'); hud.appendChild(this.num); this.tot = old.length; this.setNum(); this.isl.setStage('hub');\n  }\n  setNum() { this.num.textContent = String(this.tot); this.num.appendChild(txt('small', '', 'Marbles')); }\n  fixed(dt) {\n    this.t += dt; this.spawnT -= dt;\n    if (this.added < this.adds.length && this.spawnT <= 0) {\n      this.spawnT = Math.max(.04, .16 - this.adds.length * .002);\n      const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(cosRange(-.18, .18), 3.1, cosRange(-.18, .18)).setLinvel(cosRange(-.3, .3), -1, cosRange(-.3, .3)).setCcdEnabled(true));\n      this.world.createCollider(RAPIER.ColliderDesc.ball(.14).setRestitution(.35).setFriction(.4).setMass(.05).setCollisionGroups(G), b);\n      const i = this.count + this.added; this.mesh.count = Math.min(420, i + 1); this.c.set(this.adds[this.added]); if (i < 420) this.mesh.setColorAt(i, this.c); if (this.mesh.instanceColor) this.mesh.instanceColor.needsUpdate = true;\n      this.dynamic.push({ b, i, hit: false }); this.added++; this.tot++; this.setNum();\n    }\n    this.world.step();\n    for (const d of this.dynamic) { const p = d.b.translation(); if (d.i < 420) { this.m.makeTranslation(p.x, p.y, p.z); this.mesh.setMatrixAt(d.i, this.m); } if (!d.hit && p.y < 1.9 && d.b.linvel().y > -3.5) { d.hit = true; this.game.audio.sfx('marble', { r: cosRange(0, 1), f: 1500 + this.tot * 3 }); } }\n    this.mesh.instanceMatrix.needsUpdate = true;\n    if (this.added >= this.adds.length && this.t > this.adds.length * .16 + 1.6) this.done = true;\n  }\n  frame(dt) { this.isl.tick(dt); }\n  dispose() { this.world.free(); this.world = null; this.game.ui.hud.innerHTML = ''; }\n}\nE\ncat > src/game/checkin.js <<'E'\n// The Check-In: a round mat, Trudy, and three short tests.\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from '../events/base.js';\nimport { TEST_NAMES } from '../data/programme.js';\nimport { makeTrudy } from '../art/trudy.js';\nimport { cyl, torus, at, sphere, box, lantern, palm } from '../art/props.js';\nimport { el, txt } from '../ui/ui.js';\nconst clamp01 = (v) => Math.max(0, Math.min(1, v));\nconst DUR = { standStill: 10, leanMatch: 18, stepTime: 16, quickLean: 15, oneFoot: 12 };\nexport class CheckIn extends EventBase {\n  static id = 'checkin'; static title = 'The Check-In'; static discipline = 'Check-In'; static instructor = 'trudy'; static place = 'The mat'; static music = 'island';\n  static sentence = 'Three short tests. Then I tell you your Wobble Age.'; static can = 'You can only do your best.'; static cant = \"You can't lose this. You can only do it badly.\";\n  static verbs = [['lean', 'Lean'], ['left', 'Left'], ['right', 'Right']];\n  static tiers = [{}];\n  buildSet() {\n    this.tests = this.opts.tests || ['standStill', 'leanMatch', 'stepTime']; this.ti = 0; this.st = -2.4; this.results = [];\n    this.add(cyl(13, 13.2, .4, '#8FD06F', 40), 0, -.2, 0); this.add(cyl(2.3, 2.3, .05, '#E77BB0', 40), 0, .025, 0); const r = torus(2.1, .05, '#FFF8EE'); r.rotation.x = Math.PI / 2; this.add(r, 0, .055, 0); const r2 = torus(1.1, .04, '#FFF8EE'); r2.rotation.x = Math.PI / 2; this.add(r2, 0, .055, 0);\n    this.add(palm(1.6), -5, 0, -4); this.add(palm(1.3), 5.4, 0, -5); this.add(lantern(), -3.2, 0, -2); this.add(lantern(), 3.2, 0, -2);\n    this.trudy = makeTrudy(); this.add(this.trudy.group, -1.9, 0, .5); this.trudy.group.rotation.y = .6; this.anim.push({ tick: (dt) => this.trudy.tick(dt, this.lanes[0]?.bal ? -this.lanes[0].bal.cobX * .2 : 0) });\n    this.quads = null;\n  }\n  placeCamera(snap) { this.game.rig.set(0, 1.5, 6.4, 0, 1.05, 0, snap); }\n  setupHud2() { this.hbar = el('div', 'hbar'); this.hbarFill = el('div', 'fill'); this.hbarMark = el('div', 'mark'); this.hbar.append(this.hbarFill, this.hbarMark); this.hbar.style.cssText += 'position:absolute;left:50%;transform:translateX(-50%);bottom:15vh;display:none'; this.hudEl.appendChild(this.hbar); }\n  start() { const l = this.lanes[0]; l.zone = null; l.score = 0; this.begin(); }\n  cur() { return this.tests[this.ti]; }\n  begin() {\n    const id = this.cur(), l = this.lanes[0]; this.st = -2.4; l.errSum = 0; l.errN = 0; l.lp = false; l.rp = false; this.sub = { n: 0, last: null }; l.zone = null; l.sway = 0; l.tremor = 0; l.bal.mods.margin = null; if (this.hbar) this.hbar.style.display = 'none';\n    this.setMsg(TEST_NAMES[id]); if (!this.attract) this.game.barkNow('trudy', id); this.game.audio.sfx('bell');\n    this.trudy.rig.play('read', .3);\n    if (id === 'stepTime') { this.beat = 60 / 96; this.nextBeat = 1; }\n    if (id === 'quickLean') { this.prompts = 6; this.pI = -1; this.pGap = 2.2; this.pT = .5; this.reacts = []; }\n    if (id === 'leanMatch') { this.targets = [[-.7, 0, '70% left'], [.5, 0, '50% right'], [0, -.6, '60% forward']]; if (this.r() < .5) this.targets[1] = [.8, 0, '80% right']; }\n  }\n  fixedPlay(dt) {\n    const l = this.lanes[0]; this.st += dt; if (this.st < 0) return;\n    const id = this.cur(), dur = DUR[id], b = l.bal;\n    if (id === 'standStill' || id === 'oneFoot') {\n      l.sway = .1; l.tremor = .06; l.zone = { x: 0, z: 0, r: .25 };\n      if (id === 'oneFoot') { const good = l.in.rf > .5 && l.in.lf < .5; b.mods.margin = good ? .225 : .45; this.setBig(''); this.setMsg(good ? 'Good. Stay on that foot.' : 'Hold your right foot, let the left one go'); if (!good) { l.errSum += .25 * dt * 120 / 120; } }\n      else this.setMsg('Keep the dot in the middle');\n      l.errSum += Math.min(1, Math.hypot(b.cobX, b.cobZ)); l.errN++;\n    } else if (id === 'leanMatch') {\n      l.sway = .04; const k = Math.min(2, Math.floor(this.st / 6)), tg = this.targets[k], into = this.st - k * 6; l.zone = { x: tg[0], z: tg[1], r: .12 }; this.setMsg(`Lean ${tg[2]}`);\n      if (into > 1.5) { l.errSum += Math.hypot(b.cobX - tg[0], b.cobZ - tg[1]); l.errN++; }\n      if (this.hbar) { this.hbar.style.display = ''; const pct = Math.min(1, Math.hypot(b.cobX, b.cobZ)); this.hbarFill.style.width = `${pct * 100}%`; this.hbarMark.style.left = `${Math.hypot(tg[0], tg[1]) * 100}%`; }\n    } else if (id === 'stepTime') {\n      l.sway = .02; this.setMsg('Alternate your feet on the tick');\n      if (this.st >= this.nextBeat) { this.nextBeat += this.beat; this.game.audio.sfx('tick', { high: true }); this.trudy.hop(); }\n      const L = l.in.lf > .5, R = l.in.rf > .5, lE = L && !l.lp, rE = R && !l.rp; l.lp = L; l.rp = R;\n      if (lE || rE) { const foot = lE ? 'L' : 'R'; const near = Math.abs(this.st - (this.nextBeat - this.beat)) < Math.abs(this.st - this.nextBeat) ? this.nextBeat - this.beat : this.nextBeat; let err = Math.abs(this.st - near); if (foot === this.sub.last) err = .12; this.sub.last = foot; l.errSum += Math.min(.12, err); l.errN++; l.doll.rig.play(foot === 'L' ? 'stepL' : 'stepR', .03, 'idle'); this.game.audio.sfx('foot', { high: foot === 'R' }); }\n    } else if (id === 'quickLean') {\n      l.sway = .02; this.pT -= dt;\n      if (this.pT <= 0 && !this.active && this.pI < this.prompts - 1) { this.pI++; const d = [[-1, 0, 'left'], [1, 0, 'right'], [0, -1, 'forward'], [0, 1, 'back']][Math.floor(this.r() * 4)]; this.active = { d, t: 0 }; l.zone = { x: d[0] * .55, z: d[1] * .55, r: .3 }; this.setMsg(`Lean ${d[2]}!`); this.game.audio.sfx('foot', { high: true }); }\n      if (this.active) { this.active.t += dt; if (b.cobX * this.active.d[0] + b.cobZ * this.active.d[1] > .4) { this.reacts.push(this.active.t); this.active = null; l.zone = null; this.setMsg('Back to the middle'); this.pT = 1; this.game.audio.sfx('marble', { r: .5 }); } else if (this.active.t > 1.9) { this.reacts.push(1.9); this.active = null; l.zone = null; this.pT = .6; } }\n      if (this.pI >= this.prompts - 1 && !this.active && this.pT <= 0) { this.st = dur; }\n    }\n    if (this.st >= dur) this.endTest();\n  }\n  score(id) {\n    const l = this.lanes[0], mean = l.errN ? l.errSum / l.errN : 1;\n    if (id === 'standStill' || id === 'oneFoot') return clamp01(1 - mean / .25);\n    if (id === 'leanMatch') return clamp01(1 - mean / .4);\n    if (id === 'stepTime') return l.errN >= 8 ? clamp01(1 - mean / .12) : 0;\n    if (id === 'quickLean') { const r = this.reacts; const m = r.length ? r.reduce((a, c) => a + c, 0) / r.length : 1.9; return clamp01(1 - (m - .35) / .9); }\n    return 0;\n  }\n  endTest() {\n    const id = this.cur(), s = this.score(id); this.results.push({ id, score: s }); this.game.audio.sfx('stamp'); this.game.comic(`${Math.round(s * 100)}`, 0, 2.3, 0, '#FFD23F', 1.1);\n    if (!this.attract) this.game.barkNow('trudy', s > .55 ? 'testGood' : 'testBad');\n    this.ti++; if (this.ti >= this.tests.length) { this.lanes[0].form = 100 * this.results.reduce((a, r) => a + r.score, 0) / this.results.length; this.finish(); return; }\n    this.begin();\n  }\n  frame2() { const l = this.lanes[0]; if (!l) return; this.setNum(`${Math.min(this.ti + 1, this.tests.length)}/${this.tests.length}`, 'Test'); const id = this.cur(); this.setTime(id ? (this.st < 0 ? null : DUR[id] - this.st) : null); }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l), id = this.cur(); if (!id || this.st < 0) return { x: 0, z: 0 };\n    let gx = 0, gz = 0, load = false, lf = 0, rf = 0; if (l.zone && (id === 'leanMatch' || id === 'quickLean')) { gx = l.zone.x; gz = l.zone.z; load = id === 'leanMatch'; }\n    if (id === 'oneFoot') rf = 1;\n    if (id === 'stepTime') {\n      l.bq = l.bq || { next: null, foot: 'L', tL: 0, tR: 0 }; const q = l.bq; if (q.next === null || q.for !== this.nextBeat) { q.for = this.nextBeat; q.next = this.nextBeat + br.gauss() * br.s.timing; }\n      if (this.st >= q.next && !q.fired) { q.fired = true; if (q.foot === 'L') { q.tL = .05; q.foot = 'R'; } else { q.tR = .05; q.foot = 'L'; } } if (this.st < q.next) q.fired = false;\n      q.tL -= dt; q.tR -= dt; lf = q.tL > 0 ? 1 : 0; rf = q.tR > 0 ? 1 : 0;\n    }\n    const [x, z] = br.correct(dt, l, gx, gz, load);\n    return { x, z, lf, rf };\n  }\n  laneResult() { return { form: this.lanes[0].form, big: Math.round(this.lanes[0].form), label: 'Check-In', stats: '' }; }\n  forceFinish() { while (this.results.length < this.tests.length) { const id = this.tests[this.results.length]; this.results.push({ id, score: .5 }); } this.lanes[0].form = 50; this.finish(); }\n}\nE\necho ok","description":"Write island art, hub, jar and Check-In"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":49202,"cache_read_input_tokens":257147,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":49202},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"ec47e075-9a09-4b44-ab56-5cfa82247e6c","timestamp":"2026-11-05T12:28:05.288Z","request_id":"req_011CgjmzaJCYsa4wBf9BVsLA","wire_tool_inputs":{"toolu_016L7opBL4rR9r8VSJmoAMCk":{"command":"cat > src/art/island.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { rbox, tree, palm, bunting, pavilion, plankWalk, bench, crate, lantern, rock, stoneStack, buoy, deck, grassPatch } from './props.js';\nimport { sphere, cyl, cone, box, torus, at, capsule, toon, glass, flat, mesh, cached } from './materials.js';\nimport { makeDoll } from './doll.js';\nimport { GUESTS } from '../data/names.js';\nimport { cosRange, cosmetic, pick } from '../core/rng.js';\nexport const LANDMARKS = {\n  lighthouse: { x: 2, z: -9, label: 'The Lighthouse', r: 3.2 }, jar: { x: -3, z: -4, label: 'The Jar', r: 2.4 }, circus: { x: 0, z: 2, label: 'Circus Green', r: 2.6 }, sunDeck: { x: -16, z: -3, label: 'The Sun Deck', r: 3.4 }, lilyPond: { x: -13, z: 7, label: 'The Lily Pond', r: 3.4 }, quarry: { x: -9, z: -13, label: 'Quarry Terrace', r: 3 }, yard: { x: -7, z: 14, label: 'The Yard', r: 3 }, gazebo: { x: 14, z: -11, label: 'The Gazebo', r: 3 }, bandstand: { x: 15, z: -3, label: 'The Bandstand', r: 3.2 }, boardwalk: { x: 19, z: 3, label: 'The Boardwalk', r: 2.6 }, pier: { x: 15, z: 12, label: 'The Pier', r: 2.8 }, beach: { x: 5, z: 17, label: 'The Beach', r: 3 }, board: { x: 1, z: 9, label: 'The Notice Board', r: 2.2 }, bedHut: { x: 8, z: 8, label: 'The Bed Hut', r: 2.6 }, mirror: { x: 9, z: -14, label: 'The Mirror', r: 2.6 },\n};\nexport const JAR_POS = { x: -3, z: -4 };\nexport class Island {\n  constructor(scene) {\n    this.scene = scene; this.group = new THREE.Group(); scene.add(this.group); this.world = new THREE.Group(); this.group.add(this.world);\n    this.tx = 0; this.tz = 0; this.vt = 0; this.tilt = null; this.heldX = null; this.anim = []; this.guests = []; this.mixTick = 0; this.restDeg = 9; this.stage = 'hub';\n    this.buildGround(); this.buildLandmarks(); this.buildScatter(); this.buildJar(); this.buildGuests();\n  }\n  buildGround() {\n    const W = this.world;\n    const sand = cyl(22, 22, .3, '#F0DDB0', 64); W.add(at(sand, 0, -.16, 0));\n    const grass = cyl(15, 15, .3, '#8FD06F', 48); W.add(at(grass, 0, -.149, 0));\n    const road = torus(19, .55, '#E3CFA3'); road.rotation.x = Math.PI / 2; road.scale.z = .02; W.add(at(road, 0, -.003, 0));\n    const rockM = cone(21, 20, '#8F8578', 32); rockM.rotation.x = Math.PI; W.add(at(rockM, 0, -10.3, 0));\n    for (let i = 0; i < 40; i++) { const a = i / 40 * 6.283; const f = box(.14, .72, 1.5, i % 2 ? '#E9D3AE' : '#FFF8EE'); f.rotation.y = -a; f.position.set(Math.cos(a) * 22, .36, Math.sin(a) * 22); W.add(f); }\n    this.pivot = new THREE.Group(); const piv = sphere(5, '#6F665C', 1.15, .8, 1.1); this.pivot.add(at(piv, 0, -24, 0)); this.scene.add(this.pivot);\n  }\n  buildLandmarks() {\n    const W = this.world, L = LANDMARKS, put = (o, k, dx = 0, dz = 0) => { o.position.x = L[k].x + dx; o.position.z = L[k].z + dz; W.add(o); return o; };\n    // Lighthouse: stacked red and cream rings, a lamp, a blue cap.\n    const lh = new THREE.Group(); let y = 0; const rings = 9; for (let i = 0; i < rings; i++) { const rb = 2 - i * .1, rt = rb - .1, h = 1.3; lh.add(at(cyl(rt, rb, h, i % 2 ? '#FFF8EE' : '#E8443A', 24), 0, y + h / 2, 0)); y += h; }\n    lh.add(at(cyl(1.5, 1.3, .3, '#1A1420', 24), 0, y + .15, 0)); this.lhLamp = cyl(.72, .72, 1.2, '#FFF2C2', 16); lh.add(at(this.lhLamp, 0, y + .9, 0)); lh.add(at(cone(1.05, 1, '#3B82F6', 16), 0, y + 2, 0)); lh.add(at(box(.8, 1.4, .1, '#7A5A3C'), 0, .7, 2)); put(lh, 'lighthouse'); this.lighthouse = lh;\n    // Sun Deck\n    const sd = deck(3.6, '#C89B6A', false, .12); put(sd, 'sunDeck'); const sdp = pavilion(3, 3, 2.3, '#F58A5C'); sdp.position.y = .12; put(sdp, 'sunDeck', -.3, -.3);\n    // Lily pond\n    const pond = cyl(3.6, 3.6, .04, '#57B8A8', 32); put(at(pond, 0, .012, 0), 'lilyPond'); for (let i = 0; i < 7; i++) { const a = i * 1.7, r = .7 + i * .38; put(at(cyl(.4, .38, .04, '#4FB56A', 12), 0, .05, 0), 'lilyPond', Math.cos(a) * r, Math.sin(a) * r); } const rim = torus(3.6, .18, '#BDB2A2'); rim.rotation.x = Math.PI / 2; put(at(rim, 0, .05, 0), 'lilyPond');\n    // Quarry terrace\n    const q = cyl(3.2, 3.5, .3, '#D8CDBB', 10); put(at(q, 0, .1, 0), 'quarry'); put(stoneStack(5), 'quarry', -.8, .4); put(stoneStack(3), 'quarry', 1, -.8); put(rock(.9), 'quarry', -2, -1.8); put(rock(.65), 'quarry', 2.3, .9);\n    // Yard\n    put(at(box(3.4, .04, 3.4, '#D9694F'), 0, .02, 0), 'yard'); const lg = cyl(.16, .16, 2, '#9C7048'); lg.rotation.z = 1.57; put(at(lg, 0, 1.2, 0), 'yard'); for (const s of [-1, 1]) put(at(cyl(.09, .1, 1.2, '#7A5A3C'), 0, .6, 0), 'yard', s, 0); put(bench(), 'yard', 0, -2.2);\n    // Bandstand\n    const bs = new THREE.Group(); bs.add(at(cyl(3.2, 3.3, .3, '#C89B6A', 8), 0, .15, 0)); for (let i = 0; i < 8; i++) { const a = i / 8 * 6.283 + .39; bs.add(at(cyl(.09, .1, 2.8, '#FFF8EE'), Math.cos(a) * 2.9, 1.6, Math.sin(a) * 2.9)); } bs.add(at(cone(3.8, 1.5, '#2FA7A0', 8), 0, 3.7, 0)); put(bs, 'bandstand');\n    // Circus Green\n    const cg = cyl(2.8, 2.8, .03, '#FFF2C2', 32); put(at(cg, 0, .015, 0), 'circus'); for (let i = 0; i < 5; i++) { const a = i / 5 * 6.283; put(at(cyl(.03, .04, 1.8, '#FFF8EE'), 0, .9, 0), 'circus', Math.cos(a) * 2.2, Math.sin(a) * 2.2); put(at(cyl(.28, .18, .05, ['#3B82F6', '#22C55E', '#E8443A'][i % 3]), 0, 1.84, 0), 'circus', Math.cos(a) * 2.2, Math.sin(a) * 2.2); }\n    // Pier, running out to sea.\n    const pier = plankWalk(18, 3); pier.rotation.y = -Math.PI / 4 * 3; pier.position.set(L.pier.x - 1, 0, L.pier.z - 1); W.add(pier);\n    const tower = new THREE.Group(); const COL = ['#E8443A', '#F5B700', '#3B82F6', '#22C55E']; for (let i = 0; i < 5; i++) tower.add(at(box(2, 1, 2, COL[i % 4]), 0, i + .5, 0)); tower.position.set(L.pier.x + 12, 0, L.pier.z + 12); W.add(tower);\n    // Boardwalk gate\n    const bg = new THREE.Group(); for (const s of [-1, 1]) bg.add(at(cyl(.12, .14, 2.8, '#FFF8EE'), 0, 1.4, s * 1)); bg.add(at(box(.2, .5, 2.8, '#2FA7A0'), 0, 2.8, 0)); put(bg, 'boardwalk'); const bw = plankWalk(14, 1.6); bw.rotation.y = -Math.PI / 2; bw.position.set(L.boardwalk.x, 0, L.boardwalk.z); W.add(bw);\n    // Beach\n    put(palm(1.4), 'beach', -3, 1); put(palm(1.2), 'beach', 3.2, .4); const bb = sphere(.4, '#FFF8EE'); put(at(bb, 0, .35, 0), 'beach', 1, 2); const tugRope = cyl(.03, .03, 5, '#E9D3AE', 6); tugRope.rotation.z = 1.57; put(at(tugRope, 0, .05, 0), 'beach');\n    // Notice board\n    const nb = new THREE.Group(); for (const s of [-1, 1]) nb.add(at(cyl(.08, .09, 2, '#7A5A3C'), s * .9, 1, 0)); nb.add(at(box(2.3, 1.2, .12, '#C89B6A'), 0, 1.5, 0)); nb.add(at(box(.8, .6, .02, '#FFF8EE'), -.4, 1.5, .07)); nb.add(at(box(.7, .8, .02, '#F7E08A'), .55, 1.45, .07)); put(nb, 'board');\n    // Bed hut\n    const bh = new THREE.Group(); bh.add(at(rbox(3, 2.1, 2.6, .12, '#E9D3AE'), 0, 1.05, 0)); bh.add(at(cone(2.5, 1.3, '#F58A5C', 4), 0, 2.75, 0)); bh.children[1].rotation.y = .785; bh.add(at(box(.8, 1.5, .08, '#7A5A3C'), 0, .75, 1.3)); bh.add(at(sphere(.1, '#F5B700'), .28, .75, 1.36)); put(bh, 'bedHut');\n    // Mirror pavilion\n    const mp = pavilion(2.6, 2.6, 2.2, '#8E6BD8'); put(mp, 'mirror'); const fr = torus(.8, .08, '#F5B700'); fr.scale.y = 1.25; put(at(fr, 0, 1.2, 0), 'mirror'); const mg = new THREE.Mesh(new THREE.CircleGeometry(.76, 24), flat('#BDE7F4')); mg.scale.y = 1.25; put(at(mg, 0, 1.2, .01), 'mirror');\n    // Gazebo with a dock\n    const gz = pavilion(3, 3, 2.4, '#2FA7A0'); put(gz, 'gazebo'); put(crate(.7), 'gazebo', 2.4, 0);\n    for (const k of Object.keys(L)) { /* signposts */ if (['board', 'jar', 'lighthouse'].includes(k)) continue; const s = new THREE.Group(); s.add(at(cyl(.05, .06, 1.3, '#7A5A3C'), 0, .65, 0)); s.add(at(rbox(.8, .3, .06, .03, '#FFF8EE'), 0, 1.2, 0)); s.rotation.y = -Math.atan2(L[k].z, L[k].x) - 1.57; put(s, k, -Math.cos(Math.atan2(L[k].z, L[k].x)) * (L[k].r + .6), -Math.sin(Math.atan2(L[k].z, L[k].x)) * (L[k].r + .6)); }\n  }\n  buildScatter() {\n    const W = this.world, spots = Object.values(LANDMARKS);\n    const clear = (x, z, r) => spots.every(s => Math.hypot(s.x - x, s.z - z) > s.r + r) && Math.abs(Math.hypot(x, z) - 19) > 1.3;\n    let placed = 0, tries = 0; while (placed < 34 && tries++ < 500) { const a = cosRange(0, 6.283), d = cosRange(4, 21), x = Math.cos(a) * d, z = Math.sin(a) * d; if (!clear(x, z, 1.1)) continue; const t = d > 15 ? palm(cosRange(.8, 1.3)) : tree(cosRange(.8, 1.4), pick(['#6FBF5A', '#7CC568', '#F4A6C0', '#5EAE64', '#FFD08A'])); t.position.set(x, 0, z); W.add(t); placed++; }\n    for (let i = 0; i < 60; i++) { const a = cosRange(0, 6.283), d = cosRange(2, 14.5), x = Math.cos(a) * d, z = Math.sin(a) * d; if (!clear(x, z, .2)) continue; const f = sphere(.07, pick(['#F4A6C0', '#FFF8EE', '#F7E04B', '#B4CCF4']), 1, .7, 1); W.add(at(f, x, .06, z)); }\n    for (let i = 0; i < 12; i++) { const a = i / 12 * 6.283 + .2, r = 20.8; W.add(at(lantern(i % 2 ? '#F5B700' : '#F58A5C'), Math.cos(a) * r, 0, Math.sin(a) * r)); }\n    W.add(bunting(LANDMARKS.lighthouse.x, 8, LANDMARKS.lighthouse.z, LANDMARKS.circus.x, 3, LANDMARKS.circus.z - 1, 22));\n    W.add(bunting(LANDMARKS.bedHut.x, 3, LANDMARKS.bedHut.z, LANDMARKS.board.x + 1, 2.2, LANDMARKS.board.z, 10));\n  }\n  buildJar() {\n    const g = new THREE.Group(); g.position.set(JAR_POS.x, .08, JAR_POS.z); this.jarGroup = g; this.world.add(g);\n    const pts = [[.01, 0], [1, .02], [1.08, .12], [1.08, 1.9], [.86, 2.2], [.86, 2.45], [.95, 2.5]].map(p => new THREE.Vector2(p[0], p[1]));\n    const jar = new THREE.Mesh(new THREE.LatheGeometry(pts, 32), glass()); jar.renderOrder = 5; g.add(jar);\n    for (const [r, y] of [[1.08, .12], [1.08, 1.9], [.86, 2.2], [.95, 2.5]]) { const t = torus(r, .022, '#1A1420'); t.rotation.x = Math.PI / 2; t.position.y = y; g.add(t); }\n    for (const a of [.6, .9]) { const s = new THREE.Mesh(new THREE.BoxGeometry(.05, a === .6 ? 1.2 : .7, .01), flat('#FFFFFF', .75)); s.position.set(Math.sin(a) * 1.07 - .4, 1, Math.cos(a) * 1.07); g.add(s); }\n    g.add(at(cyl(1.3, 1.4, .1, '#C89B6A', 24), 0, -.04, 0));\n    this.marbles = new THREE.InstancedMesh(new THREE.SphereGeometry(.14, 12, 9), toon('#ffffff'), 420); this.marbles.frustumCulled = false; this.marbles.count = 0; g.add(this.marbles);\n  }\n  /** Rest layout: packed rings from the bottom, repeatable from the index. */\n  marbleRest(i) { const perLayer = 28, layer = Math.floor(i / perLayer), k = i % perLayer; const ring = k < 1 ? 0 : k < 7 ? 1 : k < 17 ? 2 : 3; const counts = [1, 6, 10, 11], starts = [0, 1, 7, 17]; const a = (k - starts[ring]) / counts[ring] * 6.283 + layer * .7; const r = [0, .28, .56, .84][ring]; return [Math.cos(a) * r, .17 + layer * .25 + (ring % 2) * .05, Math.sin(a) * r]; }\n  setMarbles(list) { const n = Math.min(list.length, 420); const m = new THREE.Matrix4(), c = new THREE.Color(); this.marbles.count = n; for (let i = 0; i < n; i++) { const p = this.marbleRest(i); m.makeTranslation(p[0], p[1], p[2]); this.marbles.setMatrixAt(i, m); this.marbles.setColorAt(i, c.set(list[i])); } this.marbles.instanceMatrix.needsUpdate = true; if (this.marbles.instanceColor) this.marbles.instanceColor.needsUpdate = true; }\n  buildGuests() {\n    const W = this.world, spots = Object.values(LANDMARKS);\n    GUESTS.forEach((g, i) => { for (let n = 0; n < 2; n++) {\n      const d = makeDoll({ paint: g.paint, hat: g.hat, skin: g.skin, height: g.height, width: g.width }); const s = spots[(i * 3 + n * 5) % spots.length];\n      d.group.position.set(s.x + 2, 0, s.z + 2); d.rig.play('walk', 0); d.rig.mixer.setTime(cosmetic()); W.add(d.group);\n      this.guests.push({ d, name: g.name, target: pick(spots), wait: cosRange(0, 3), speed: cosRange(.7, 1.1), key: ['margaret', 'kevin', 'sandra', 'sandra', 'paul', 'gerald'][i] });\n    } });\n  }\n  showGuests(on) { for (const g of this.guests) g.d.group.visible = on; }\n  tickGuests(dt) {\n    const spots = Object.values(LANDMARKS);\n    for (const g of this.guests) {\n      if (!g.d.group.visible) continue; g.d.tick(dt); const p = g.d.group.position;\n      if (g.wait > 0) { g.wait -= dt; if (g.wait <= 0) { g.target = pick(spots); g.d.rig.play('walk', .2); } continue; }\n      const dx = g.target.x - p.x, dz = g.target.z - p.z, d = Math.hypot(dx, dz);\n      if (d < g.target.r + 1) { g.wait = cosRange(2, 8); g.d.rig.play(pick(['idle', 'clap', 'breathe', 'idle']), .25); continue; }\n      p.x += dx / d * g.speed * dt; p.z += dz / d * g.speed * dt; g.d.setFace(Math.atan2(dx, dz));\n    }\n  }\n  nearestGuest(x, z, within = 2.2) { let best = null, bd = within; for (const g of this.guests) { if (!g.d.group.visible) continue; const d = Math.hypot(g.d.group.position.x - x, g.d.group.position.z - z); if (d < bd) { bd = d; best = g; } } return best; }\n  setStage(stage) {\n    this.stage = stage; this.heldX = null;\n    this.group.visible = true; this.group.position.set(0, 0, 0); this.group.scale.setScalar(1);\n    if (stage === 'backdrop') this.group.position.set(55, -.4, -95);\n    if (stage === 'below') this.group.position.set(-2, 0, 9);\n    this.pivot.position.copy(this.group.position);\n    if (stage === 'hidden') this.group.visible = false; this.pivot.visible = this.group.visible;\n  }\n  setRest(deg) { this.restDeg = deg; }\n  restVec() { const r = this.restDeg * Math.PI / 180; return [r * .8, r * .6]; }\n  setHeld(tx, tz) { this.heldX = tx; this.heldZ = tz; }\n  tick(dt) {\n    if (!this.group.visible) return;\n    if (!this.tilt) {\n      const [rx, rz] = this.restVec(); const tx = this.heldX ?? rx, tz = this.heldZ ?? rz; const k = 1 - Math.exp(-2.2 * dt);\n      this.tx += (tx - this.tx) * k; this.tz += (tz - this.tz) * k;\n      const a = Math.hypot(this.tx, this.tz) || 1e-9, s = Math.sin(a / 2); this.group.quaternion.set(this.tz / a * s, 0, -this.tx / a * s, Math.cos(a / 2));\n    } else { this.tx = this.tilt.tx; this.tz = this.tilt.tz; }\n    this.tickGuests(dt);\n  }\n}\nE\ncat > src/game/hub.js <<'E'\n// The island: tilt physics, the walker, loose props, Trudy, hotspots.\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, groups, GROUND } from '../physics/world.js';\nimport { makeIslandWorld, TiltModel, restWeight } from '../physics/island.js';\nimport { LANDMARKS, JAR_POS } from '../art/island.js';\nimport { makeDoll } from '../art/doll.js';\nimport { makeTrudy } from '../art/trudy.js';\nimport { sphere, box, torus, cone, at, cyl, toon } from '../art/materials.js';\nimport { T } from '../core/tuning.js';\nimport { screenToWorld } from '../render/cameraRig.js';\nimport { cosRange } from '../core/rng.js';\nimport { el, txt } from '../ui/ui.js';\nconst rad = (d) => d * Math.PI / 180;\nconst PROP_G = groups(0x0010, 0xffff & ~0x0100 | GROUND | 0x0010);\nexport class Hub {\n  constructor(game, profile) {\n    this.game = game; this.screen = 'island'; this.p = profile; this.world = makeIslandWorld(); this.tiltM = new TiltModel({ K: 2.2, C: 1.8, W: restWeight() }); this.isl = game.island; this.isl.setStage('hub'); this.isl.tilt = this.tiltM;\n    const [rx, rz] = this.isl.restVec(); this.tiltM.restX = rx; this.tiltM.restZ = rz; this.tiltM.tx = rx; this.tiltM.tz = rz;\n    this.group = new THREE.Group(); this.isl.group.add(this.group);\n    this.doll = makeDoll({ paint: profile.paint, hat: profile.hat, skin: profile.skin }); this.group.add(this.doll.group);\n    this.body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, .9, 10).lockRotations().setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.capsule(.5, .3).setMass(1).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setCollisionGroups(groups(0x0100, GROUND | 0x0010)), this.body);\n    this.px = 0; this.pz = 10; this.camYawO = 0; this.camPitch = .45; this.camDist = 11; this.face = Math.PI; this.locked = false; this.walkTarget = null; this.walking = false; this.leanMode = false; this.leanX = 0; this.leanZ = 0; this.hover = null; this.focusSpot = null; this.idleT = 0; this.trudyGoal = { x: 2, z: 12 };\n    this.trudy = makeTrudy(); this.trudy.group.position.set(2, 0, 11); this.group.add(this.trudy.group); this.trudyHop = 0;\n    this.props = []; this.addProps();\n    this.spots = []; this.buildMarkers();\n    this.labelRoot = el('div'); this.game.ui.hud.innerHTML = ''; this.game.ui.hud.appendChild(this.labelRoot); this.label = el('div', 'hoverlabel'); this.label.style.display = 'none'; this.labelRoot.appendChild(this.label);\n    this.useTag = el('div', 'bottomprompts'); this.labelRoot.appendChild(this.useTag); this.useText = null;\n    this.rig = game.rig; this.placeCam(true); this.hudDirty = true;\n    this.game.ui.onWorldClick = (e) => this.worldClick(e);\n    this.props.forEach(() => {}); this.creakT = 0;\n  }\n  setSpots(list) { this.spots = list; this.markers.forEach((m, i) => { const s = list[i]; m.visible = !!(s && s.marked); if (s) m.position.set(s.x, 2.6, s.z); }); }\n  buildMarkers() { this.markers = []; for (let i = 0; i < 10; i++) { const a = cone(.28, .5, '#FFD23F'); a.rotation.x = Math.PI; a.visible = false; this.group.add(a); this.markers.push(a); } this.ring = torus(1.4, .08, '#FFD23F'); this.ring.rotation.x = Math.PI / 2; this.ring.visible = false; this.ring.position.y = .06; this.group.add(this.ring); }\n  addProps() {\n    const add = (mesh, collider, x, y, z, mass) => { const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, y, z).setCanSleep(false).setLinearDamping(.25).setAngularDamping(.4)); this.world.createCollider(collider.setMass(mass).setFriction(.5).setRestitution(.2).setCollisionGroups(groups(0x0010, GROUND | 0x0010 | 0x0100)), b); this.group.add(mesh); this.props.push({ b, m: mesh }); };\n    for (let i = 0; i < 30; i++) { const a = i * 2.4, r = 1.5 + i * .55; add(sphere(.2, i % 5 === 0 ? '#F7E04B' : '#F58A2E'), RAPIER.ColliderDesc.ball(.2), Math.cos(a) * r, .3, Math.sin(a) * r, .2); }\n    for (let i = 0; i < 6; i++) { const a = i * 1.1 + .6, r = 7 + i * 1.6; add(box(.6, .5, .6, '#C89B6A'), RAPIER.ColliderDesc.cuboid(.3, .25, .3), Math.cos(a) * r, .4, Math.sin(a) * r, .6); }\n    for (let i = 0; i < 4; i++) { const a = i * 1.57 + .3, r = 13; add(sphere(.42, ['#E8443A', '#3B82F6', '#22C55E', '#FFF8EE'][i]), RAPIER.ColliderDesc.ball(.42), Math.cos(a) * r, .6, Math.sin(a) * r, .3); }\n  }\n  setTiltRest(deg) { this.isl.setRest(deg); const [rx, rz] = this.isl.restVec(); this.tiltM.restX = rx; this.tiltM.restZ = rz; }\n  teleport(x, z, faceAway = true) { this.px = x; this.pz = z; this.body.setTranslation({ x, y: .9, z }, true); this.body.setLinvel({ x: 0, y: 0, z: 0 }, true); this.walkTarget = null; this.trudy.group.position.set(x + 1.6, 0, z + 1.2); this.placeCam(true); }\n  dropIn() { this.body.setTranslation({ x: 0, y: 9, z: 10 }, true); this.drop = true; this.doll.rig.play('splay', 0); }\n  placeCam(snap) {\n    const y = this.camYawO, p = this.camPitch, d = this.camDist; const q = this.isl.group.quaternion; const a = new THREE.Vector3(this.px, 1.1, this.pz);\n    const c = new THREE.Vector3(this.px + Math.sin(y) * Math.cos(p) * d, 1.1 + Math.sin(p) * d, this.pz + Math.cos(y) * Math.cos(p) * d);\n    a.applyQuaternion(q); c.applyQuaternion(q); c.y = Math.max(c.y, 1.2);\n    this.rig.set(c.x, c.y, c.z, a.x, a.y, a.z, snap); this.rig.damp = 6;\n  }\n  fixed(dt) {\n    const I = this.game.input.merged, ks = this.game.input; const yaw = this.camYawO;\n    if (!this.locked) {\n      this.camYawO -= I.lookX * (I.activeDevice === 'kbm' ? 1 : 1); this.camPitch = Math.max(.15, Math.min(1.1, this.camPitch + I.lookY)); const w = ks.takeWheel(); if (w) this.camDist = Math.max(6, Math.min(22, this.camDist + w * 1.1));\n    }\n    let mx = 0, mz = 0, speed = T.walkSpeed;\n    if (!this.locked && !this.leanMode && !this.drop) {\n      const raw = Math.hypot(I.walkX, I.walkZ);\n      if (raw > .1) { this.walkTarget = null; [mx, mz] = screenToWorld(I.walkX, I.walkZ, -yaw); }\n      else if (this.walkTarget) { const dx = this.walkTarget.x - this.px, dz = this.walkTarget.z - this.pz, d = Math.hypot(dx, dz); if (d < (this.walkTarget.r || 1)) { const t = this.walkTarget; this.walkTarget = null; if (t.act) t.act(); } else { mx = dx / d; mz = dz / d; } }\n    }\n    const v = this.body.linvel(); this.body.setLinvel({ x: mx * speed + this.tiltM.tx * 3, y: v.y, z: mz * speed + this.tiltM.tz * 3 }, true);\n    const p = this.body.translation(); this.px = p.x; this.pz = p.z;\n    if (this.drop && p.y < 1) { this.drop = false; this.game.audio.sfx('clatter'); this.game.audio.sfx('spring'); this.doll.land(); this.doll.rig.play('land', .05, 'idle'); this.game.comicIsland('CLACK!', p.x, 1.4, p.z); this.game.rig.shake(.1); this.dropped = true; }\n    this.walking = Math.hypot(mx, mz) > .1;\n    if (this.walking) { this.face = Math.atan2(mx, mz); this.idleT = 0; } else this.idleT += dt;\n    // Tilt: your position leans the island; in the first lesson the stick does it directly.\n    const addX = this.leanMode ? I.x * rad(7) : 0, addZ = this.leanMode ? I.z * rad(7) : 0; this.leanX = I.x; this.leanZ = I.z;\n    const rx = this.tiltM.restX, rz = this.tiltM.restZ; this.tiltM.restX = rx + addX; this.tiltM.restZ = rz + addZ;\n    this.tiltM.W = restWeight(); this.tiltM.step(dt, this.px, this.pz, T.islandSpring, this.tiltM.W); this.tiltM.restX = rx; this.tiltM.restZ = rz;\n    this.tiltM.applyGravity(this.world, T.gravity); this.tiltM.applyGroup(this.isl.group);\n    this.world.step();\n    if (p.y < -5 || !Number.isFinite(p.x)) this.teleport(0, 10);\n    this.updateFocus();\n    // Trudy follows, and hops\n    const tp = this.trudy.group.position; const gx = this.px + 1.7 * Math.cos(this.face + 1.2), gz = this.pz - 1.7 * Math.sin(this.face + 1.2); const dd = Math.hypot(gx - tp.x, gz - tp.z);\n    if (dd > 1.1) { const sp = Math.min(T.walkSpeed * 1.1, dd * 1.4); tp.x += (gx - tp.x) / dd * sp * dt; tp.z += (gz - tp.z) / dd * sp * dt; this.trudyHop += dt * 7; this.trudy.group.rotation.y = Math.atan2(this.px - tp.x, this.pz - tp.z); tp.y = Math.abs(Math.sin(this.trudyHop)) * .22; } else { tp.y = 0; this.trudy.group.rotation.y = Math.atan2(this.px - tp.x, this.pz - tp.z); }\n  }\n  updateFocus() {\n    let best = null, bd = 1e9; for (const s of this.spots) { const d = Math.hypot(s.x - this.px, s.z - this.pz); if (d < (s.r || 2.2) + .6 && d < bd) { bd = d; best = s; } }\n    this.focusSpot = best;\n    const I = this.game.input.merged; if (this.locked || this.leanMode || this.game.ui.top() || this.game.speech.busy) return;\n    if ((I.use || (I.hop && best)) && best) { this.game.audio.sfx('ok'); this.useSpot(best); }\n    else if (I.hop && !best) this.hopDoll();\n  }\n  useSpot(s) { s.act(); }\n  hopDoll() { if (this.hopY > 0) return; this.hopV = 4.2; this.hopY = .001; this.doll.rig.play('hop', .05, 'idle'); this.game.audio.sfx('spring'); }\n  hoverAt(x, y) {\n    const cam = this.game.camera; cam.updateMatrixWorld(); const v = new THREE.Vector3(); let best = null, bd = 90 * (innerHeight / 1080);\n    this.isl.group.updateMatrixWorld();\n    for (const s of this.spots) { v.set(s.x, 1.4, s.z).applyMatrix4(this.isl.group.matrixWorld).project(cam); if (v.z > 1) continue; const sx = (v.x * .5 + .5) * innerWidth, sy = (-v.y * .5 + .5) * innerHeight, d = Math.hypot(sx - x, sy - y); if (d < bd) { bd = d; best = s; } }\n    return best;\n  }\n  worldClick(e) { if (this.locked || this.leanMode || this.game.mode !== this) return; const s = this.hoverAt(e.clientX, e.clientY); if (s) { this.walkTarget = { x: s.x, z: s.z, r: Math.max(1.2, (s.r || 2) - .2), act: s.act }; this.game.audio.sfx('move'); } }\n  frame(dt) {\n    const p = this.body.translation();\n    if (this.hopY > 0) { this.hopV -= 12 * dt; this.hopY += this.hopV * dt; if (this.hopY <= 0) { this.hopY = 0; this.doll.land(); } }\n    this.doll.group.position.set(p.x, p.y - .9 + (this.hopY || 0) - .0, p.z); this.doll.setFace(this.face);\n    const want = this.drop ? 'splay' : this.walking ? 'walk' : (this.doll.rig.currentName === 'land' || this.doll.rig.currentName === 'hop' ? this.doll.rig.currentName : 'idle');\n    if (this.doll.rig.currentName !== want && !this.doll.rig.then) this.doll.rig.play(want, .15);\n    // Stay visually upright: counter-rotate most of the tilt.\n    const q = this.isl.group.quaternion; this.doll.lean.quaternion.set(-q.x * .7, 0, -q.z * .7, q.w).normalize();\n    if (this.leanMode) { const m = rad(16); const ax = this.leanX * m, az = this.leanZ * m; const a = Math.hypot(ax, az) || 1e-9, s = Math.sin(a / 2); this.doll.lean.quaternion.set(az / a * s, 0, -ax / a * s, Math.cos(a / 2)); }\n    this.doll.tick(dt);\n    for (const o of this.props) { const t = o.b.translation(), r = o.b.rotation(); o.m.position.set(t.x, t.y, t.z); o.m.quaternion.set(r.x, r.y, r.z, r.w); }\n    this.trudy.tick(dt, this.tiltM.tx * -1.2 + (this.leanMode ? -this.leanX * .2 : 0));\n    this.placeCam(false);\n    // Hover and prompts\n    const inp = this.game.input; let hov = null; if (inp.lastDevice === 'kbm' && !this.game.ui.top()) hov = this.hoverAt(inp.px, inp.py);\n    const show = hov || this.focusSpot;\n    if (show && !this.locked && !this.game.ui.top() && !this.game.speech.busy) { const v = new THREE.Vector3(show.x, 2.8, show.z).applyMatrix4(this.isl.group.matrixWorld).project(this.game.camera); this.label.style.display = ''; if (this.label.textContent !== show.label) this.label.textContent = show.label; this.label.style.left = `${(v.x * .5 + .5) * 100}%`; this.label.style.top = `${(-v.y * .5 + .5) * 100}%`; this.ring.visible = true; this.ring.position.x = show.x; this.ring.position.z = show.z; this.ring.scale.setScalar((show.r || 2) / 1.4 * (1 + Math.sin(performance.now() * .006) * .04)); } else { this.label.style.display = 'none'; this.ring.visible = false; }\n    const uk = this.locked || this.game.ui.top() ? '' : (this.focusSpot ? `use:${this.focusSpot.useText || 'Use'}` : 'free');\n    if (uk !== this.useText) { this.useText = uk; this.useTag.innerHTML = ''; if (uk) { const list = uk === 'free' ? [['walk', 'Walk'], ['look', 'Look'], ['hop', 'Hop'], ['ask', 'Ask Trudy']] : [['walk', 'Walk'], ['useIsl', uk.slice(4)], ['ask', 'Ask Trudy']]; this.useTag.appendChild(this.game.ui.promptBar(list)); this.game.ui.refreshGlyphs(this.useTag); } }\n    this.isl.tick(dt);\n  }\n  dispose() {\n    this.game.ui.onWorldClick = null; this.isl.tilt = null; this.isl.tx = this.tiltM.tx; this.isl.tz = this.tiltM.tz;\n    this.group.removeFromParent(); this.world.free(); this.world = null; this.labelRoot.remove();\n  }\n}\nE\ncat > src/game/jar.js <<'E'\n// Marbles pour into the jar on the island, as real Rapier balls.\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, makeWorld, groups } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { JAR_POS } from '../art/island.js';\nimport { cosRange } from '../core/rng.js';\nimport { el, txt } from '../ui/ui.js';\nconst G = groups(1, 1);\nexport class JarMode {\n  constructor(game, old, adds) {\n    this.game = game; this.screen = 'jar'; this.isl = game.island; this.isl.setStage('hub'); this.old = old.slice(-400); this.adds = adds; this.added = 0; this.dynamic = []; this.t = 0; this.spawnT = .3; this.done = false;\n    this.world = makeWorld({ iterations: 6 });\n    const base = this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed()); this.world.createCollider(RAPIER.ColliderDesc.cylinder(.1, 1.1).setTranslation(0, -.05, 0).setFriction(.5).setCollisionGroups(G), base);\n    for (let i = 0; i < 16; i++) { const a = i / 16 * 6.283; const w = this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(Math.cos(a) * 1.13, 1.3, Math.sin(a) * 1.13).setRotation({ x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) })); this.world.createCollider(RAPIER.ColliderDesc.cuboid(.05, 1.4, .24).setFriction(.3).setCollisionGroups(G), w); }\n    // Old marbles settle as a heap of fixed balls; new ones pour on top.\n    this.statics = []; old.slice(-400).forEach((c, i) => { const p = this.isl.marbleRest(i); const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(p[0], p[1], p[2])); this.world.createCollider(RAPIER.ColliderDesc.ball(.14).setFriction(.4).setCollisionGroups(G), b); });\n    this.mesh = this.isl.marbles; this.isl.setMarbles(this.old); this.count = this.old.length; this.c = new THREE.Color(); this.m = new THREE.Matrix4();\n    const q = this.isl.jarGroup; const pos = new THREE.Vector3(); q.getWorldPosition(pos); game.rig.set(pos.x + 1, pos.y + 2.2, pos.z + 6.6, pos.x, pos.y + 1.15, pos.z, true); game.rig.damp = 5;\n    const hud = game.ui.hud; hud.innerHTML = ''; this.num = el('div', 'hudnum'); hud.appendChild(this.num); this.tot = old.length; this.setNum(); this.isl.setStage('hub');\n  }\n  setNum() { this.num.textContent = String(this.tot); this.num.appendChild(txt('small', '', 'Marbles')); }\n  fixed(dt) {\n    this.t += dt; this.spawnT -= dt;\n    if (this.added < this.adds.length && this.spawnT <= 0) {\n      this.spawnT = Math.max(.04, .16 - this.adds.length * .002);\n      const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(cosRange(-.18, .18), 3.1, cosRange(-.18, .18)).setLinvel(cosRange(-.3, .3), -1, cosRange(-.3, .3)).setCcdEnabled(true));\n      this.world.createCollider(RAPIER.ColliderDesc.ball(.14).setRestitution(.35).setFriction(.4).setMass(.05).setCollisionGroups(G), b);\n      const i = this.count + this.added; this.mesh.count = Math.min(420, i + 1); this.c.set(this.adds[this.added]); if (i < 420) this.mesh.setColorAt(i, this.c); if (this.mesh.instanceColor) this.mesh.instanceColor.needsUpdate = true;\n      this.dynamic.push({ b, i, hit: false }); this.added++; this.tot++; this.setNum();\n    }\n    this.world.step();\n    for (const d of this.dynamic) { const p = d.b.translation(); if (d.i < 420) { this.m.makeTranslation(p.x, p.y, p.z); this.mesh.setMatrixAt(d.i, this.m); } if (!d.hit && p.y < 1.9 && d.b.linvel().y > -3.5) { d.hit = true; this.game.audio.sfx('marble', { r: cosRange(0, 1), f: 1500 + this.tot * 3 }); } }\n    this.mesh.instanceMatrix.needsUpdate = true;\n    if (this.added >= this.adds.length && this.t > this.adds.length * .16 + 1.6) this.done = true;\n  }\n  frame(dt) { this.isl.tick(dt); }\n  dispose() { this.world.free(); this.world = null; this.game.ui.hud.innerHTML = ''; }\n}\nE\ncat > src/game/checkin.js <<'E'\n// The Check-In: a round mat, Trudy, and three short tests.\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from '../events/base.js';\nimport { TEST_NAMES } from '../data/programme.js';\nimport { makeTrudy } from '../art/trudy.js';\nimport { cyl, torus, at, sphere, box, lantern, palm } from '../art/props.js';\nimport { el, txt } from '../ui/ui.js';\nconst clamp01 = (v) => Math.max(0, Math.min(1, v));\nconst DUR = { standStill: 10, leanMatch: 18, stepTime: 16, quickLean: 15, oneFoot: 12 };\nexport class CheckIn extends EventBase {\n  static id = 'checkin'; static title = 'The Check-In'; static discipline = 'Check-In'; static instructor = 'trudy'; static place = 'The mat'; static music = 'island';\n  static sentence = 'Three short tests. Then I tell you your Wobble Age.'; static can = 'You can only do your best.'; static cant = \"You can't lose this. You can only do it badly.\";\n  static verbs = [['lean', 'Lean'], ['left', 'Left'], ['right', 'Right']];\n  static tiers = [{}];\n  buildSet() {\n    this.tests = this.opts.tests || ['standStill', 'leanMatch', 'stepTime']; this.ti = 0; this.st = -2.4; this.results = [];\n    this.add(cyl(13, 13.2, .4, '#8FD06F', 40), 0, -.2, 0); this.add(cyl(2.3, 2.3, .05, '#E77BB0', 40), 0, .025, 0); const r = torus(2.1, .05, '#FFF8EE'); r.rotation.x = Math.PI / 2; this.add(r, 0, .055, 0); const r2 = torus(1.1, .04, '#FFF8EE'); r2.rotation.x = Math.PI / 2; this.add(r2, 0, .055, 0);\n    this.add(palm(1.6), -5, 0, -4); this.add(palm(1.3), 5.4, 0, -5); this.add(lantern(), -3.2, 0, -2); this.add(lantern(), 3.2, 0, -2);\n    this.trudy = makeTrudy(); this.add(this.trudy.group, -1.9, 0, .5); this.trudy.group.rotation.y = .6; this.anim.push({ tick: (dt) => this.trudy.tick(dt, this.lanes[0]?.bal ? -this.lanes[0].bal.cobX * .2 : 0) });\n    this.quads = null;\n  }\n  placeCamera(snap) { this.game.rig.set(0, 1.5, 6.4, 0, 1.05, 0, snap); }\n  setupHud2() { this.hbar = el('div', 'hbar'); this.hbarFill = el('div', 'fill'); this.hbarMark = el('div', 'mark'); this.hbar.append(this.hbarFill, this.hbarMark); this.hbar.style.cssText += 'position:absolute;left:50%;transform:translateX(-50%);bottom:15vh;display:none'; this.hudEl.appendChild(this.hbar); }\n  start() { const l = this.lanes[0]; l.zone = null; l.score = 0; this.begin(); }\n  cur() { return this.tests[this.ti]; }\n  begin() {\n    const id = this.cur(), l = this.lanes[0]; this.st = -2.4; l.errSum = 0; l.errN = 0; l.lp = false; l.rp = false; this.sub = { n: 0, last: null }; l.zone = null; l.sway = 0; l.tremor = 0; l.bal.mods.margin = null; if (this.hbar) this.hbar.style.display = 'none';\n    this.setMsg(TEST_NAMES[id]); if (!this.attract) this.game.barkNow('trudy', id); this.game.audio.sfx('bell');\n    this.trudy.rig.play('read', .3);\n    if (id === 'stepTime') { this.beat = 60 / 96; this.nextBeat = 1; }\n    if (id === 'quickLean') { this.prompts = 6; this.pI = -1; this.pGap = 2.2; this.pT = .5; this.reacts = []; }\n    if (id === 'leanMatch') { this.targets = [[-.7, 0, '70% left'], [.5, 0, '50% right'], [0, -.6, '60% forward']]; if (this.r() < .5) this.targets[1] = [.8, 0, '80% right']; }\n  }\n  fixedPlay(dt) {\n    const l = this.lanes[0]; this.st += dt; if (this.st < 0) return;\n    const id = this.cur(), dur = DUR[id], b = l.bal;\n    if (id === 'standStill' || id === 'oneFoot') {\n      l.sway = .1; l.tremor = .06; l.zone = { x: 0, z: 0, r: .25 };\n      if (id === 'oneFoot') { const good = l.in.rf > .5 && l.in.lf < .5; b.mods.margin = good ? .225 : .45; this.setBig(''); this.setMsg(good ? 'Good. Stay on that foot.' : 'Hold your right foot, let the left one go'); if (!good) { l.errSum += .25 * dt * 120 / 120; } }\n      else this.setMsg('Keep the dot in the middle');\n      l.errSum += Math.min(1, Math.hypot(b.cobX, b.cobZ)); l.errN++;\n    } else if (id === 'leanMatch') {\n      l.sway = .04; const k = Math.min(2, Math.floor(this.st / 6)), tg = this.targets[k], into = this.st - k * 6; l.zone = { x: tg[0], z: tg[1], r: .12 }; this.setMsg(`Lean ${tg[2]}`);\n      if (into > 1.5) { l.errSum += Math.hypot(b.cobX - tg[0], b.cobZ - tg[1]); l.errN++; }\n      if (this.hbar) { this.hbar.style.display = ''; const pct = Math.min(1, Math.hypot(b.cobX, b.cobZ)); this.hbarFill.style.width = `${pct * 100}%`; this.hbarMark.style.left = `${Math.hypot(tg[0], tg[1]) * 100}%`; }\n    } else if (id === 'stepTime') {\n      l.sway = .02; this.setMsg('Alternate your feet on the tick');\n      if (this.st >= this.nextBeat) { this.nextBeat += this.beat; this.game.audio.sfx('tick', { high: true }); this.trudy.hop(); }\n      const L = l.in.lf > .5, R = l.in.rf > .5, lE = L && !l.lp, rE = R && !l.rp; l.lp = L; l.rp = R;\n      if (lE || rE) { const foot = lE ? 'L' : 'R'; const near = Math.abs(this.st - (this.nextBeat - this.beat)) < Math.abs(this.st - this.nextBeat) ? this.nextBeat - this.beat : this.nextBeat; let err = Math.abs(this.st - near); if (foot === this.sub.last) err = .12; this.sub.last = foot; l.errSum += Math.min(.12, err); l.errN++; l.doll.rig.play(foot === 'L' ? 'stepL' : 'stepR', .03, 'idle'); this.game.audio.sfx('foot', { high: foot === 'R' }); }\n    } else if (id === 'quickLean') {\n      l.sway = .02; this.pT -= dt;\n      if (this.pT <= 0 && !this.active && this.pI < this.prompts - 1) { this.pI++; const d = [[-1, 0, 'left'], [1, 0, 'right'], [0, -1, 'forward'], [0, 1, 'back']][Math.floor(this.r() * 4)]; this.active = { d, t: 0 }; l.zone = { x: d[0] * .55, z: d[1] * .55, r: .3 }; this.setMsg(`Lean ${d[2]}!`); this.game.audio.sfx('foot', { high: true }); }\n      if (this.active) { this.active.t += dt; if (b.cobX * this.active.d[0] + b.cobZ * this.active.d[1] > .4) { this.reacts.push(this.active.t); this.active = null; l.zone = null; this.setMsg('Back to the middle'); this.pT = 1; this.game.audio.sfx('marble', { r: .5 }); } else if (this.active.t > 1.9) { this.reacts.push(1.9); this.active = null; l.zone = null; this.pT = .6; } }\n      if (this.pI >= this.prompts - 1 && !this.active && this.pT <= 0) { this.st = dur; }\n    }\n    if (this.st >= dur) this.endTest();\n  }\n  score(id) {\n    const l = this.lanes[0], mean = l.errN ? l.errSum / l.errN : 1;\n    if (id === 'standStill' || id === 'oneFoot') return clamp01(1 - mean / .25);\n    if (id === 'leanMatch') return clamp01(1 - mean / .4);\n    if (id === 'stepTime') return l.errN >= 8 ? clamp01(1 - mean / .12) : 0;\n    if (id === 'quickLean') { const r = this.reacts; const m = r.length ? r.reduce((a, c) => a + c, 0) / r.length : 1.9; return clamp01(1 - (m - .35) / .9); }\n    return 0;\n  }\n  endTest() {\n    const id = this.cur(), s = this.score(id); this.results.push({ id, score: s }); this.game.audio.sfx('stamp'); this.game.comic(`${Math.round(s * 100)}`, 0, 2.3, 0, '#FFD23F', 1.1);\n    if (!this.attract) this.game.barkNow('trudy', s > .55 ? 'testGood' : 'testBad');\n    this.ti++; if (this.ti >= this.tests.length) { this.lanes[0].form = 100 * this.results.reduce((a, r) => a + r.score, 0) / this.results.length; this.finish(); return; }\n    this.begin();\n  }\n  frame2() { const l = this.lanes[0]; if (!l) return; this.setNum(`${Math.min(this.ti + 1, this.tests.length)}/${this.tests.length}`, 'Test'); const id = this.cur(); this.setTime(id ? (this.st < 0 ? null : DUR[id] - this.st) : null); }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l), id = this.cur(); if (!id || this.st < 0) return { x: 0, z: 0 };\n    let gx = 0, gz = 0, load = false, lf = 0, rf = 0; if (l.zone && (id === 'leanMatch' || id === 'quickLean')) { gx = l.zone.x; gz = l.zone.z; load = id === 'leanMatch'; }\n    if (id === 'oneFoot') rf = 1;\n    if (id === 'stepTime') {\n      l.bq = l.bq || { next: null, foot: 'L', tL: 0, tR: 0 }; const q = l.bq; if (q.next === null || q.for !== this.nextBeat) { q.for = this.nextBeat; q.next = this.nextBeat + br.gauss() * br.s.timing; }\n      if (this.st >= q.next && !q.fired) { q.fired = true; if (q.foot === 'L') { q.tL = .05; q.foot = 'R'; } else { q.tR = .05; q.foot = 'L'; } } if (this.st < q.next) q.fired = false;\n      q.tL -= dt; q.tR -= dt; lf = q.tL > 0 ? 1 : 0; rf = q.tR > 0 ? 1 : 0;\n    }\n    const [x, z] = br.correct(dt, l, gx, gz, load);\n    return { x, z, lf, rf };\n  }\n  laneResult() { return { form: this.lanes[0].form, big: Math.round(this.lanes[0].form), label: 'Check-In', stats: '' }; }\n  forceFinish() { while (this.results.length < this.tests.length) { const id = this.tests[this.results.length]; this.results.push({ id, score: .5 }); } this.lanes[0].form = 50; this.finish(); }\n}\nE\necho ok","description":"Write island art, hub, jar and Check-In"}}}
