{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjrHD2iLMNiw5dPwRcS5","type":"message","role":"assistant","content":[{"type":"text","text":"The hook is right that some of this was only inferred, and I told you so myself. So I went back through sections 17 and 21 for anything I'd assumed without asserting, and found more than it named: the journal graph, unlock toasts, spoken words on screen, clips actually changing, sliders affecting a running event, every Dev Mode tool, a pad disconnecting mid-class, the audio-unlock tag, Plate Spinners on keys, and a full class with four pads. I'll add real tests for all of them."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":1413,"cache_read_input_tokens":524573,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1413},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"fda3e7b7-2312-4f96-b90d-24b93393eb14","timestamp":"2026-11-05T13:21:18.921Z","request_id":"req_011CgjrHCgP5TkGUhdNnmKLo"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjrHD2iLMNiw5dPwRcS5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015pCv65Ar9JracTraQGpZ5e","name":"Bash","input":{"command":"cat > test/coverage.mjs <<'E'\n// Plan items that deserve their own assertions: things otherwise only seen by eye or inferred.\nconst B = { cross: 0, circle: 1, square: 2, tri: 3 };\nexport default async function ({ T, openPage, getBrowser }) {\n  const b = await getBrowser(); const page = await openPage(b);\n  const adv = (s) => page.evaluate((x) => __TEST__.advance(x), s);\n  const st = () => page.evaluate(() => __TEST__.state());\n  const tap = async (i, n) => { await page.evaluate(([a, c]) => { const p = window.__pads[a]; p.connected = true; p.buttons[c] = { pressed: true, value: 1 }; __TEST__.advance(.03); p.buttons[c] = { pressed: false, value: 0 }; __TEST__.advance(.03); }, [i, n]); };\n  const reset = () => page.evaluate(() => { const g = __TEST__.g; g.ui.closeAll(); g.simPaused = false; g.scripts.clear(); g.speech.clear(); g.clearMode(); __TEST__.resetTuning(); g.save.profiles = [g.freshProfile('Tester', '#E8443A'), null, null, null]; g.save.current = 0; const p = g.profile; p.tutorial = true; p.checkinDone = true; p.planShown = true; });\n  // Journal: the graph is drawn from the stored ages, with its three numbers; the pages exist.\n  await reset(); const j = await page.evaluate(() => { const g = __TEST__.g, p = g.profile; p.ages = [74, 61, 52, 44]; p.day = 5; p.falls = 7; p.minutes = 31; p.marbles = 40; p.medals = { poses: { best: 90, medal: 'exemplary', tiers: [90] } }; __TEST__.Menus.openJournal(g); const L = g.ui.top(); const cal = L.el.querySelectorAll('.calendar .d.st').length; L.onRight(); const pts = L.el.querySelector('polyline').getAttribute('points').trim().split(/\\s+/).map(q => +q.split(',')[1]); const nums = [...L.el.querySelectorAll('.bignums b')].map(n => n.textContent); const dots = L.el.querySelectorAll('svg circle').length; L.onRight(); const shelf = L.el.querySelectorAll('.medal').length; L.onRight(); const tot = [...L.el.querySelectorAll('.bignums b')].map(n => n.textContent); g.ui.close(); return { cal, pts, nums, dots, shelf, tot }; });\n  T.eq(j.cal, 4, 'calendar stamps past days'); T.eq(j.pts.length, 4, 'graph has a point per age'); T.ok(j.pts.every((y, i) => !i || y > j.pts[i - 1]), `lower age draws lower: ${j.pts}`); T.eq(j.nums.join(), '44,74,44', 'graph numbers today, first, best'); T.eq(j.dots, 4, 'graph dots'); T.eq(j.shelf, 1, 'medal shelf'); T.eq(j.tot.join(), '7,31,40', 'silly totals');\n  // Unlocks: every threshold toasts once, The Mirror honours them, the pour really adds marbles.\n  await reset(); const u = await page.evaluate(() => { const g = __TEST__.g; const seen = []; const old = g.ui.toast.bind(g.ui); g.ui.toast = (t, s) => { seen.push(t); old(t, s); }; for (const [a, c] of [[0, 5], [5, 6], [6, 13], [13, 14], [14, 60]]) g.checkUnlocks(a, c); g.ui.toast = old; return { seen, unlocked: g.profile.unlocked }; });\n  T.eq(u.seen.length, 6, `six unlock toasts: ${u.seen}`); T.eq(u.unlocked.length, 6, 'six unlocks stored'); T.ok(u.seen.every(t => t.startsWith('Unlocked:')), 'toast text');\n  await reset(); const m = await page.evaluate(() => { const g = __TEST__.g, p = g.profile; p.marbles = 7; p.marbleList = new Array(7).fill('#fff'); g.startHub(); __TEST__.Menus.openMirror(g); const cards = () => [...g.ui.top().el.querySelectorAll('.card')].map(c => ({ t: c.textContent, locked: c.classList.contains('locked') })); const a = cards(); const it = g.ui.focus.items().find(i => /Visor/.test(i.textContent)); g.ui.focus.activate(it); const hat = p.hat; const locked = g.ui.focus.items().find(i => i.classList.contains('locked')); g.ui.focus.activate(locked); const after = p.hat; g.ui.top().onBack(); return { a, hat, after, doll: g.hub.doll.hat }; });\n  T.eq(m.hat, 'visor', 'an unlocked hat can be worn'); T.eq(m.after, 'visor', 'a locked hat cannot'); T.eq(m.doll, 'visor', 'the doll wears it'); T.ok(m.a.some(c => c.locked && /marbles/.test(c.t)), 'locked ones show a marble count');\n  await reset(); const pour = await page.evaluate(() => { const g = __TEST__.g, p = g.profile; p.marbles = 5; p.marbleList = new Array(5).fill('#fff'); g.scripts.run(g.pourMarbles(new Array(4).fill('#F5B700')), 't'); for (let i = 0; i < 360; i++) g.fixed(1 / 120); const mode = g.mode; const live = mode.dynamic.length; const ys = mode.dynamic.map(d => d.b.translation().y); for (let i = 0; i < 480; i++) { g.fixed(1 / 120); } return { live, ys, marbles: p.marbles, list: p.marbleList.length, inst: g.island.marbles.count, r: g.mode?.dynamic?.every(d => { const q = d.b.translation(); return Math.hypot(q.x, q.z) < 1.1 && q.y > 0; }) }; });\n  T.eq(pour.live, 4, 'marbles are real Rapier balls'); T.eq(pour.marbles, 9, 'marbles counted'); T.eq(pour.list, 9, 'marble colours stored'); T.eq(pour.inst, 9, 'marbles drawn'); T.ok(pour.r !== false, 'marbles stay in the jar');\n  // Everything spoken is on screen: whole lines, blocking and bark, every speaker.\n  await reset(); const sp = await page.evaluate(() => { const g = __TEST__.g, out = []; const line = 'Please step on. Not on me.'; for (const who of ['trudy', 'stillwater', 'bolster', 'margaret', 'kevin', 'sandra', 'paul', 'gerald']) { const said = []; const was = g.audio.speak; g.audio.speak = (w, t) => { said.push([w, t]); return 0; }; const r = g.speech.say(who, line); for (let i = 0; i < 600 && g.speech.cur === r && r.shown < line.length; i++) g.speech.tick(1 / 120, null); const box = g.ui.speech.querySelector('.speech'); out.push({ who, text: box.querySelector('.text').textContent, name: box.querySelector('.who').textContent, voiced: said[0]?.[1] }); g.speech.clear(); g.audio.speak = was; } const b1 = g.speech.bark('trudy', line); for (let i = 0; i < 300; i++) g.speech.tick(1 / 120, null); const bark = g.ui.speech.querySelector('.speech')?.querySelector('.text').textContent; g.speech.clear(); return { out, bark, b1: !!b1 }; });\n  for (const o of sp.out) { T.eq(o.text, 'Please step on. Not on me.', `${o.who} line typed out in full`); T.eq(o.voiced, o.text, `${o.who} voice speaks the on-screen text`); T.ok(o.name.length > 2, `${o.who} is named`); } T.eq(sp.bark, 'Please step on. Not on me.', 'barks are on screen');\n  const types = await page.evaluate(() => { const g = __TEST__.g; const r = g.speech.say('trudy', 'A long line that types out slowly.'); g.speech.tick(.1, null); const early = r.tEl.textContent.length; g.input.merged.use = true; g.speech.tick(.2, null); g.input.merged.use = false; const shown = r.tEl.textContent.length; g.speech.clear(); return { early, shown, full: 'A long line that types out slowly.'.length }; }); T.ok(types.early > 0 && types.early < types.full, `text types out, ${types.early}`); T.eq(types.shown, types.full, 'Use completes the line');\n  const lines = await page.evaluate(() => { const g = __TEST__.g; const seen = new Set(); const n = 16; for (let i = 0; i < n; i++) seen.add(g.line('trudy', 'fall')); return seen.size; }); T.eq(lines, 16, 'lines pick without repeats');\n  // Animation: the engine's mixer runs and clips change, in every event.\n  for (const id of ['poses', 'cairn', 'stillWater', 'logReps', 'plank', 'tug', 'stepClass', 'plates', 'islandLoop', 'fruitHat', 'roomService', 'springboard', 'raft', 'grandHold']) { await reset(); const a = await page.evaluate((i) => { const g = __TEST__.g; const ev = g.startEventMode(__TEST__.EVENTS[i], {}, [{ kind: 'bot', skill: 'sharp' }, ...(i === 'raft' ? [{ kind: 'bot', skill: 'sharp' }] : [])]); ev.count = .01; const r = ev.lanes[0].doll.rig; const t0 = r.mixer.time; const seen = new Set([r.currentName]); const q0 = ev.lanes[0].doll.joints.shoulderL.quaternion.clone(); let moved = false; for (let k = 0; k < 600; k++) { g.fixed(1 / 120); g.frame(1 / 120); seen.add(r.currentName); if (!ev.lanes[0].doll.joints.shoulderL.quaternion.equals(q0)) moved = true; } return { adv: r.mixer.time - t0, clip: [...seen], moved, has: Object.keys(r.clips).length }; }, id); T.ok(a.adv > 1, `${id}: mixer time ${a.adv}`); T.ok(a.clip[0], `${id}: a clip plays`); T.ok(a.has >= 30, `${id}: doll clip library ${a.has}`); }\n  await reset(); const clips = await page.evaluate(() => { const g = __TEST__.g; const ev = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); ev.count = .01; const seen = new Set(); for (let k = 0; k < 120 * 34; k++) { g.fixed(1 / 120); seen.add(ev.lanes[0].doll.rig.currentName); } return [...seen]; }); T.ok(clips.filter(c => c.startsWith('pose_')).length >= 3, `poses change clips ${clips}`);\n  const rag = await page.evaluate(() => { const g = __TEST__.g; g.clearMode(); const ev = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); ev.count = .01; for (let k = 0; k < 60; k++) { g.fixed(1 / 120); g.frame(1 / 120); } const j = ev.lanes[0].doll.joints.head, par = j.parent; const home = j.position.clone(); ev.forceFall(); const during = j.parent === ev.group && !!ev.lanes[0].ragdoll; const n = ev.lanes[0].ragdoll.parts.length; for (let k = 0; k < 360; k++) { g.fixed(1 / 120); g.frame(1 / 120); } return { during, n, back: j.parent === par && j.position.distanceTo(home) < 1e-6, fallen: ev.lanes[0].fallen, ang: ev.lanes[0].bal.angle }; }); T.ok(rag.during, 'ragdoll takes the parts'); T.eq(rag.n, 10, 'ten ragdoll bodies'); T.ok(rag.back && !rag.fallen, 'parts snap back'); T.ok(rag.ang < .79, `no fall loop after recovery, ${rag.ang}`);\n  // Live sliders: the real widget changes the running event, reset restores it.\n  await reset(); const sl = await page.evaluate(() => { const g = __TEST__.g; const count = () => { g.clearMode(); const ev = g.startEventMode(__TEST__.EVENTS.fruitHat, {}, [{ kind: 'bot', skill: 'sharp' }]); ev.count = .01; let n = 0; const o = ev.launch.bind(ev); ev.launch = (l, k) => { n++; return o(l, k); }; for (let k = 0; k < 120 * 30; k++) g.fixed(1 / 120); return n; }; const base = count(); __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); let row = null; for (let i = 0; i < 30 && !row; i++) { row = g.ui.focus.items().find(x => /Fruit interval/.test(x.textContent)); if (!row) g.ui.focus.activate(g.ui.focus.items().find(x => x.textContent === '›')); } for (let i = 0; i < 20; i++) row._adj(1); const set = __TEST__.T.fruitInterval; const reset1 = g.ui.focus.items().find(x => /Reset to Defaults/.test(x.textContent)); g.ui.closeAll(); g.simPaused = false; const slow = count(); __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); let r2 = null; for (let i = 0; i < 30 && !r2; i++) { r2 = g.ui.focus.items().find(x => /Fruit interval/.test(x.textContent)); if (!r2) g.ui.focus.activate(g.ui.focus.items().find(x => x.textContent === '›')); } g.ui.focus.activate(g.ui.focus.items().find(x => /Reset to Defaults/.test(x.textContent))); const back = __TEST__.T.fruitInterval; g.ui.closeAll(); g.simPaused = false; void reset1; return { base, slow, set, back }; }); T.ok(sl.set > 1.5, `slider moved the value ${sl.set}`); T.ok(sl.slow < sl.base * .75, `the running event felt it: ${sl.base} to ${sl.slow}`); T.eq(sl.back, 1, 'Reset to Defaults restores it');\n  // Every Dev Mode tool does something and none of them throws.\n  await reset(); const dv = await page.evaluate(async () => { const g = __TEST__.g; const out = { pages: 0, used: [], errs: [] }; const ev = () => g.mode?.event; const fresh = () => { g.ui.closeAll(); g.simPaused = false; g.scripts.clear(); g.speech.clear(); g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.fruitHat, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let k = 0; k < 60; k++) g.fixed(1 / 120); __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); }; fresh(); const SKIP = /Jump|Skip|Reset save|‹|›/; const nPages = 14; for (let pg = 0; pg < nPages; pg++) { fresh(); for (let q = 0; q < pg; q++) g.ui.focus.activate(g.ui.focus.items().find(x => x.textContent === '›')); const labels = g.ui.focus.items().map(i => i.textContent); for (const lb of labels) { if (SKIP.test(lb)) continue; const it = g.ui.focus.items().find(i => i.textContent === lb) || g.ui.focus.items().find(i => i.textContent.slice(0, 8) === lb.slice(0, 8)); if (!it) continue; try { g.ui.focus.activate(it); if (g.ui.topId() === 'devtext') g.ui.close(); g.frame(1 / 60); if (!g.simPaused) g.simPaused = true; out.used.push(lb.slice(0, 18)); } catch (e) { out.errs.push(lb + ': ' + e); } } out.pages++; } g.god = false; g.loop.timeScale = 1; if (g.rig.free) g.rig.free = false; g.testBotSkill = null; g.devBot = false; g.ui.closeAll(); g.simPaused = false; return { ...out, errors: g.errors.slice(0, 2) }; });\n  T.ok(!dv.errs.length, `dev tool threw: ${dv.errs[0]}`); T.ok(!dv.errors.length, `dev tool error: ${dv.errors[0]}`); for (const want of ['God mode', 'Let the bot', 'Time scale', 'Single step', 'Free camera', 'Physics lines', 'Stats', 'Input monitor', 'Force a gust', 'Force a fall', 'Force a fruit', 'Play a line', 'Play music', 'Play a sting', 'Set Wobble Age', 'Add 10 marbles', 'Unlock all', 'Ink', 'Palette', 'Copy tuning']) T.ok(dv.used.some(u => u.startsWith(want.slice(0, 18))), `dev tool ${want} present and used`);\n  const eff = await page.evaluate(() => { const g = __TEST__.g; g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); e.count = .01; for (let k = 0; k < 120; k++) g.fixed(1 / 120); e.forceGust(4); let peak = 0; for (let k = 0; k < 120; k++) { g.fixed(1 / 120); peak = Math.max(peak, e.lanes[0].bal.angle); } const moved = peak; g.clearMode(); const z = g.startEventMode(__TEST__.EVENTS.fruitHat, {}, [{ kind: 'bot', skill: 'sharp' }]); z.count = .01; for (let k = 0; k < 10; k++) g.fixed(1 / 120); const f0 = z.fruits.length; z.forceThing(); const f1 = z.fruits.length; z.forceFall(); const fl = z.lanes[0].fallen; g.clearMode(); return { moved, f0, f1, fl }; }); T.ok(eff.moved > .2, `force gust moves the doll, ${eff.moved}`); T.ok(eff.f1 > eff.f0, 'force a fruit'); T.ok(eff.fl, 'force a fall');\n  // Jumps in Dev Mode: class, day, results, ending.\n  await reset(); const jmp = await page.evaluate(() => { const g = __TEST__.g; const dev = () => { __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); }; const res = {}; g.startHub(); dev(); g.ui.focus.activate(g.ui.focus.items().find(i => /Jump to a class/.test(i.textContent))); g.ui.focus.activate(g.ui.focus.items()[1]); g.ui.focus.activate(g.ui.focus.items()[0]); __TEST__.advance(.2); res.cls = g.ui.topId(); g.ui.closeAll(); g.scripts.clear(); g.clearMode(); g.startHub(); dev(); g.ui.focus.activate(g.ui.focus.items().find(i => /Jump to a day/.test(i.textContent))); g.ui.focus.activate(g.ui.focus.items()[2]); __TEST__.advance(.1); res.day = g.profile.day; res.steps = g.profile.steps; g.ui.closeAll(); g.scripts.clear(); g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let k = 0; k < 30; k++) g.fixed(1 / 120); dev(); g.ui.focus.activate(g.ui.focus.items().find(i => /Skip to Results/.test(i.textContent))); res.done = e.phase; g.ui.closeAll(); g.simPaused = false; g.scripts.clear(); g.clearMode(); g.startHub(); dev(); g.ui.focus.activate(g.ui.focus.items().find(i => /Skip to the Ending/.test(i.textContent))); __TEST__.advance(1); res.lev = g.profile.levelled; g.ui.closeAll(); g.scripts.clear(); g.speech.clear(); g.clearMode(); return { ...res, errors: g.errors.slice(0, 1) }; });\n  T.eq(jmp.cls, 'intro', 'dev jump to class'); T.eq(jmp.day, 3, 'dev jump to day'); T.eq(jmp.steps, 7, 'jump sets the steps so tilt matches'); T.eq(jmp.done, 'done', 'dev skip to results'); T.eq(jmp.lev, true, 'dev skip to ending'); T.ok(!jmp.errors.length, `dev jump errors ${jmp.errors[0]}`);\n  // A pad disconnecting mid-class pauses and says so.\n  await reset(); await page.evaluate(() => { const p = window.__pads[0]; p.connected = true; p.axes[0] = .5; }); await adv(.1); await page.evaluate(() => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; window.__pads[0].axes[0] = 0; }); await adv(.2); await page.evaluate(() => { window.__pads[0].connected = false; }); await adv(.1); const dc = await page.evaluate(() => ({ s: __TEST__.state().screen, t: document.querySelector('[data-screen=pause]')?.textContent || '' })); T.eq(dc.s, 'pause', 'a lost pad pauses'); T.ok(/disconnected/i.test(dc.t), 'and says so on screen'); await page.evaluate(() => { const g = __TEST__.g; g.ui.closeAll(); g.simPaused = false; window.__pads[0].connected = true; });\n  // Controller-only audio: the context resumes on pad input, or a tag asks for a key.\n  await reset(); const tagged = await page.evaluate(async () => { const g = __TEST__.g; await g.audio.ctx.suspend(); g.input.padSeen = true; g.audioWait = 0; g.audioTagShown = false; __TEST__.advance(3.2); const shown = !!document.querySelector('.audioTag'); await g.audio.ctx.resume(); __TEST__.advance(.1); return { shown, gone: !document.querySelector('.audioTag'), run: g.audio.ctx.state }; }); T.ok(tagged.shown, 'a tag asks for a key when audio is still suspended'); if (tagged.run === 'running') T.ok(tagged.gone, 'the tag leaves once audio runs');\n  const ges = await page.evaluate(() => { const g = __TEST__.g; let n = 0; const o = g.input.onGesture; g.input.onGesture = () => { n++; }; const p = window.__pads[0]; p.connected = true; p.buttons[3] = { pressed: true, value: 1 }; __TEST__.advance(.03); p.buttons[3] = { pressed: false, value: 0 }; __TEST__.advance(.03); g.input.onGesture = o; return n; }); T.ok(ges >= 1, 'pad input resumes audio');\n  // Plate Spinners on keys: tapping A and D at three rates hits the three bands.\n  for (const [rate, band, lo, hi] of [[1.35, 'large', 3.5, 5], [2.3, 'medium', 6.5, 8], [3.2, 'small', 9.5, 11]]) { await reset(); const h = await page.evaluate((r) => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.plates, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; g.input.setDevice('kbm'); const gap = 1 / r, keys = ['KeyA', 'KeyD']; let next = 0, k = 0, t = 0; for (let i = 0; i < 120 * 8; i++) { if (t >= next) { next += gap; const code = keys[k++ % 2]; window.dispatchEvent(new KeyboardEvent('keydown', { code })); window.dispatchEvent(new KeyboardEvent('keyup', { code })); } g.fixed(1 / 120); t += 1 / 120; } return e.lanes[0].hoop; }, rate); T.ok(h >= lo && h <= hi, `plates: ${rate} taps a second reach ${band}: hoop ${h.toFixed(2)}`); }\n  // Log Reps on keys: holding both ramps depth at the tempo. Springboard air uses raw keys.\n  await reset(); const lg = await page.evaluate(() => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.logReps, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; g.input.setDevice('kbm'); for (const c of ['KeyQ', 'KeyE']) window.dispatchEvent(new KeyboardEvent('keydown', { code: c })); for (let i = 0; i < 120; i++) g.fixed(1 / 120); const d = e.lanes[0].depth; for (const c of ['KeyQ', 'KeyE']) window.dispatchEvent(new KeyboardEvent('keyup', { code: c })); return d; }); T.ok(lg > .3 && lg < .7, `both keys ramp depth at the tempo's speed, ${lg}`);\n  await reset(); const air = await page.evaluate(() => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.springboard, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let i = 0; i < 60; i++) g.fixed(1 / 120); e.forceThing(); g.input.setDevice('kbm'); window.dispatchEvent(new KeyboardEvent('keydown', { code: 'KeyD' })); for (let i = 0; i < 30; i++) g.fixed(1 / 120); const w = e.lanes[0].wishX; window.dispatchEvent(new KeyboardEvent('keyup', { code: 'KeyD' })); return { w, s: e.lanes[0].state }; }); T.eq(air.s, 'air', 'in the air'); T.ok(air.w > .9, `keys steer the air directly, ${air.w}`);\n  // Full Group Class with four pads to the podium, all points given.\n  await reset(); await page.evaluate(() => { const g = __TEST__.g; g.clearMode(); g.goTitle(true); __TEST__.Menus.openMenu(g); __TEST__.Menus.openGroup(g); for (const p of window.__pads) p.connected = true; }); await adv(.3); for (let i = 0; i < 4; i++) { await tap(i, B.cross); await adv(.1); } const leave = await page.evaluate(() => __TEST__.g.ui.top().el.querySelectorAll('.mat .chip').length); T.eq(leave, 4, 'four seats'); await tap(3, B.circle); await adv(.1); T.eq(await page.evaluate(() => __TEST__.g.ui.top().el.querySelectorAll('.mat .chip').length), 3, 'Circle leaves a seat'); await tap(3, B.cross); await adv(.1);\n  await page.evaluate(() => { const g = __TEST__.g; g.ui.focus.set(g.ui.focus.items().find(i => /Quick/.test(i.textContent))); g.ui.focus.activate(); }); const seen = new Set(); let lanesN = 0, kinds = '', pts = null; for (let i = 0; i < 2500; i++) { const s = await st(); seen.add(s.screen); if (s.errors.length) { T.ok(false, `group: ${s.errors[0].slice(0, 200)}`); break; } if (s.screen === 'play') { lanesN = Math.max(lanesN, s.event.lanes.length); kinds = s.event.lanes.map(l => l.kind).join(); await page.evaluate(() => { const ev = __TEST__.g.mode.event; if (ev.playT > 2) ev.forceFinish(); }); await adv(.5); } else if (s.screen === 'groupresult') { pts = await page.evaluate(() => __TEST__.g.ui.top().el.textContent); await tap(0, B.cross); await adv(.5); } else if (s.screen === 'intro' || s.screen === 'podium') { await tap(0, B.cross); await adv(.5); if (s.screen === 'podium') { await adv(.1); } } else if (s.screen === 'title' && seen.has('podium')) break; else await adv(.3); }\n  T.ok(seen.has('podium'), `four-pad class reaches the podium: ${[...seen]}`); T.eq(lanesN, 4, 'four lanes in class'); T.eq(kinds, 'local,local,local,local', 'all four are players'); T.ok(/\\+4 points/.test(pts || '') && /\\+1 points/.test(pts || ''), `points 4 to 1: ${pts}`);\n  // Podium tips over.\n  await reset(); const pod = await page.evaluate(() => { const g = __TEST__.g; return g.CheckInCls ? true : false; }); T.ok(pod, 'hooks');\n  // Pause > Leave Class returns to the island; from Free Play to the menu.\n  await reset(); const lv = await page.evaluate(() => { const g = __TEST__.g; g.startHub(); g.playClass('poses', 'programme'); __TEST__.advance(.2); g.ui.focus.activate(g.ui.focus.items().find(i => /Begin/.test(i.textContent))); __TEST__.advance(1.2); const inEv = !!g.mode.event; __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Leave Class/.test(i.textContent))); __TEST__.advance(.2); return { inEv, s: __TEST__.state().screen, locked: g.hub?.locked, err: g.errors.slice(0, 1) }; }); T.ok(lv.inEv, 'in class'); T.eq(lv.s, 'island', 'Leave Class goes to the island'); T.eq(lv.locked, false, 'and you can walk'); T.ok(!lv.err.length, `leave errors ${lv.err[0]}`);\n  // Difficulty and rhythm settings reach the game.\n  await reset(); const df = await page.evaluate(() => { const g = __TEST__.g; const out = {}; for (const d of ['gentle', 'standard', 'honest']) { g.settings.difficulty = d; g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); out[d] = e.lanes[0].bal.ankle(); } g.settings.difficulty = 'standard'; g.settings.autoBreathe = true; g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let i = 0; i < 120 * 9; i++) g.fixed(1 / 120); out.auto = e.lanes[0].breathSync; g.settings.autoBreathe = false; g.clearMode(); return out; }); T.ok(df.gentle > df.standard && df.standard > df.honest, `difficulty changes ankle strength ${JSON.stringify(df)}`); T.ok(df.auto, 'auto-breathe keeps you in sync');\n  T.ok(!page.errors.length, `coverage errors ${page.errors.slice(0, 2).join('|').slice(0, 400)}`); await page.context().close();\n}\nE\nsed -i \"s/\\['unit', 'flow', 'events', 'balance', 'input', 'audio', 'hub', 'ui'\\]/['unit', 'flow', 'events', 'balance', 'input', 'coverage', 'audio', 'hub', 'ui']/\" tools/test.mjs\ntimeout 300 node tools/test.mjs coverage 2>&1 | grep -E '^FAIL|passed' | cut -c1-330 | tail -30","description":"Write and run tests for the items only inferred so far","timeout":320000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":1413,"cache_read_input_tokens":524573,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1413},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"dd5eb883-e8bb-4766-8a1a-17d3a4768627","timestamp":"2026-11-05T13:22:45.812Z","request_id":"req_011CgjrHCgP5TkGUhdNnmKLo","wire_tool_inputs":{"toolu_015pCv65Ar9JracTraQGpZ5e":{"command":"cat > test/coverage.mjs <<'E'\n// Plan items that deserve their own assertions: things otherwise only seen by eye or inferred.\nconst B = { cross: 0, circle: 1, square: 2, tri: 3 };\nexport default async function ({ T, openPage, getBrowser }) {\n  const b = await getBrowser(); const page = await openPage(b);\n  const adv = (s) => page.evaluate((x) => __TEST__.advance(x), s);\n  const st = () => page.evaluate(() => __TEST__.state());\n  const tap = async (i, n) => { await page.evaluate(([a, c]) => { const p = window.__pads[a]; p.connected = true; p.buttons[c] = { pressed: true, value: 1 }; __TEST__.advance(.03); p.buttons[c] = { pressed: false, value: 0 }; __TEST__.advance(.03); }, [i, n]); };\n  const reset = () => page.evaluate(() => { const g = __TEST__.g; g.ui.closeAll(); g.simPaused = false; g.scripts.clear(); g.speech.clear(); g.clearMode(); __TEST__.resetTuning(); g.save.profiles = [g.freshProfile('Tester', '#E8443A'), null, null, null]; g.save.current = 0; const p = g.profile; p.tutorial = true; p.checkinDone = true; p.planShown = true; });\n  // Journal: the graph is drawn from the stored ages, with its three numbers; the pages exist.\n  await reset(); const j = await page.evaluate(() => { const g = __TEST__.g, p = g.profile; p.ages = [74, 61, 52, 44]; p.day = 5; p.falls = 7; p.minutes = 31; p.marbles = 40; p.medals = { poses: { best: 90, medal: 'exemplary', tiers: [90] } }; __TEST__.Menus.openJournal(g); const L = g.ui.top(); const cal = L.el.querySelectorAll('.calendar .d.st').length; L.onRight(); const pts = L.el.querySelector('polyline').getAttribute('points').trim().split(/\\s+/).map(q => +q.split(',')[1]); const nums = [...L.el.querySelectorAll('.bignums b')].map(n => n.textContent); const dots = L.el.querySelectorAll('svg circle').length; L.onRight(); const shelf = L.el.querySelectorAll('.medal').length; L.onRight(); const tot = [...L.el.querySelectorAll('.bignums b')].map(n => n.textContent); g.ui.close(); return { cal, pts, nums, dots, shelf, tot }; });\n  T.eq(j.cal, 4, 'calendar stamps past days'); T.eq(j.pts.length, 4, 'graph has a point per age'); T.ok(j.pts.every((y, i) => !i || y > j.pts[i - 1]), `lower age draws lower: ${j.pts}`); T.eq(j.nums.join(), '44,74,44', 'graph numbers today, first, best'); T.eq(j.dots, 4, 'graph dots'); T.eq(j.shelf, 1, 'medal shelf'); T.eq(j.tot.join(), '7,31,40', 'silly totals');\n  // Unlocks: every threshold toasts once, The Mirror honours them, the pour really adds marbles.\n  await reset(); const u = await page.evaluate(() => { const g = __TEST__.g; const seen = []; const old = g.ui.toast.bind(g.ui); g.ui.toast = (t, s) => { seen.push(t); old(t, s); }; for (const [a, c] of [[0, 5], [5, 6], [6, 13], [13, 14], [14, 60]]) g.checkUnlocks(a, c); g.ui.toast = old; return { seen, unlocked: g.profile.unlocked }; });\n  T.eq(u.seen.length, 6, `six unlock toasts: ${u.seen}`); T.eq(u.unlocked.length, 6, 'six unlocks stored'); T.ok(u.seen.every(t => t.startsWith('Unlocked:')), 'toast text');\n  await reset(); const m = await page.evaluate(() => { const g = __TEST__.g, p = g.profile; p.marbles = 7; p.marbleList = new Array(7).fill('#fff'); g.startHub(); __TEST__.Menus.openMirror(g); const cards = () => [...g.ui.top().el.querySelectorAll('.card')].map(c => ({ t: c.textContent, locked: c.classList.contains('locked') })); const a = cards(); const it = g.ui.focus.items().find(i => /Visor/.test(i.textContent)); g.ui.focus.activate(it); const hat = p.hat; const locked = g.ui.focus.items().find(i => i.classList.contains('locked')); g.ui.focus.activate(locked); const after = p.hat; g.ui.top().onBack(); return { a, hat, after, doll: g.hub.doll.hat }; });\n  T.eq(m.hat, 'visor', 'an unlocked hat can be worn'); T.eq(m.after, 'visor', 'a locked hat cannot'); T.eq(m.doll, 'visor', 'the doll wears it'); T.ok(m.a.some(c => c.locked && /marbles/.test(c.t)), 'locked ones show a marble count');\n  await reset(); const pour = await page.evaluate(() => { const g = __TEST__.g, p = g.profile; p.marbles = 5; p.marbleList = new Array(5).fill('#fff'); g.scripts.run(g.pourMarbles(new Array(4).fill('#F5B700')), 't'); for (let i = 0; i < 360; i++) g.fixed(1 / 120); const mode = g.mode; const live = mode.dynamic.length; const ys = mode.dynamic.map(d => d.b.translation().y); for (let i = 0; i < 480; i++) { g.fixed(1 / 120); } return { live, ys, marbles: p.marbles, list: p.marbleList.length, inst: g.island.marbles.count, r: g.mode?.dynamic?.every(d => { const q = d.b.translation(); return Math.hypot(q.x, q.z) < 1.1 && q.y > 0; }) }; });\n  T.eq(pour.live, 4, 'marbles are real Rapier balls'); T.eq(pour.marbles, 9, 'marbles counted'); T.eq(pour.list, 9, 'marble colours stored'); T.eq(pour.inst, 9, 'marbles drawn'); T.ok(pour.r !== false, 'marbles stay in the jar');\n  // Everything spoken is on screen: whole lines, blocking and bark, every speaker.\n  await reset(); const sp = await page.evaluate(() => { const g = __TEST__.g, out = []; const line = 'Please step on. Not on me.'; for (const who of ['trudy', 'stillwater', 'bolster', 'margaret', 'kevin', 'sandra', 'paul', 'gerald']) { const said = []; const was = g.audio.speak; g.audio.speak = (w, t) => { said.push([w, t]); return 0; }; const r = g.speech.say(who, line); for (let i = 0; i < 600 && g.speech.cur === r && r.shown < line.length; i++) g.speech.tick(1 / 120, null); const box = g.ui.speech.querySelector('.speech'); out.push({ who, text: box.querySelector('.text').textContent, name: box.querySelector('.who').textContent, voiced: said[0]?.[1] }); g.speech.clear(); g.audio.speak = was; } const b1 = g.speech.bark('trudy', line); for (let i = 0; i < 300; i++) g.speech.tick(1 / 120, null); const bark = g.ui.speech.querySelector('.speech')?.querySelector('.text').textContent; g.speech.clear(); return { out, bark, b1: !!b1 }; });\n  for (const o of sp.out) { T.eq(o.text, 'Please step on. Not on me.', `${o.who} line typed out in full`); T.eq(o.voiced, o.text, `${o.who} voice speaks the on-screen text`); T.ok(o.name.length > 2, `${o.who} is named`); } T.eq(sp.bark, 'Please step on. Not on me.', 'barks are on screen');\n  const types = await page.evaluate(() => { const g = __TEST__.g; const r = g.speech.say('trudy', 'A long line that types out slowly.'); g.speech.tick(.1, null); const early = r.tEl.textContent.length; g.input.merged.use = true; g.speech.tick(.2, null); g.input.merged.use = false; const shown = r.tEl.textContent.length; g.speech.clear(); return { early, shown, full: 'A long line that types out slowly.'.length }; }); T.ok(types.early > 0 && types.early < types.full, `text types out, ${types.early}`); T.eq(types.shown, types.full, 'Use completes the line');\n  const lines = await page.evaluate(() => { const g = __TEST__.g; const seen = new Set(); const n = 16; for (let i = 0; i < n; i++) seen.add(g.line('trudy', 'fall')); return seen.size; }); T.eq(lines, 16, 'lines pick without repeats');\n  // Animation: the engine's mixer runs and clips change, in every event.\n  for (const id of ['poses', 'cairn', 'stillWater', 'logReps', 'plank', 'tug', 'stepClass', 'plates', 'islandLoop', 'fruitHat', 'roomService', 'springboard', 'raft', 'grandHold']) { await reset(); const a = await page.evaluate((i) => { const g = __TEST__.g; const ev = g.startEventMode(__TEST__.EVENTS[i], {}, [{ kind: 'bot', skill: 'sharp' }, ...(i === 'raft' ? [{ kind: 'bot', skill: 'sharp' }] : [])]); ev.count = .01; const r = ev.lanes[0].doll.rig; const t0 = r.mixer.time; const seen = new Set([r.currentName]); const q0 = ev.lanes[0].doll.joints.shoulderL.quaternion.clone(); let moved = false; for (let k = 0; k < 600; k++) { g.fixed(1 / 120); g.frame(1 / 120); seen.add(r.currentName); if (!ev.lanes[0].doll.joints.shoulderL.quaternion.equals(q0)) moved = true; } return { adv: r.mixer.time - t0, clip: [...seen], moved, has: Object.keys(r.clips).length }; }, id); T.ok(a.adv > 1, `${id}: mixer time ${a.adv}`); T.ok(a.clip[0], `${id}: a clip plays`); T.ok(a.has >= 30, `${id}: doll clip library ${a.has}`); }\n  await reset(); const clips = await page.evaluate(() => { const g = __TEST__.g; const ev = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); ev.count = .01; const seen = new Set(); for (let k = 0; k < 120 * 34; k++) { g.fixed(1 / 120); seen.add(ev.lanes[0].doll.rig.currentName); } return [...seen]; }); T.ok(clips.filter(c => c.startsWith('pose_')).length >= 3, `poses change clips ${clips}`);\n  const rag = await page.evaluate(() => { const g = __TEST__.g; g.clearMode(); const ev = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); ev.count = .01; for (let k = 0; k < 60; k++) { g.fixed(1 / 120); g.frame(1 / 120); } const j = ev.lanes[0].doll.joints.head, par = j.parent; const home = j.position.clone(); ev.forceFall(); const during = j.parent === ev.group && !!ev.lanes[0].ragdoll; const n = ev.lanes[0].ragdoll.parts.length; for (let k = 0; k < 360; k++) { g.fixed(1 / 120); g.frame(1 / 120); } return { during, n, back: j.parent === par && j.position.distanceTo(home) < 1e-6, fallen: ev.lanes[0].fallen, ang: ev.lanes[0].bal.angle }; }); T.ok(rag.during, 'ragdoll takes the parts'); T.eq(rag.n, 10, 'ten ragdoll bodies'); T.ok(rag.back && !rag.fallen, 'parts snap back'); T.ok(rag.ang < .79, `no fall loop after recovery, ${rag.ang}`);\n  // Live sliders: the real widget changes the running event, reset restores it.\n  await reset(); const sl = await page.evaluate(() => { const g = __TEST__.g; const count = () => { g.clearMode(); const ev = g.startEventMode(__TEST__.EVENTS.fruitHat, {}, [{ kind: 'bot', skill: 'sharp' }]); ev.count = .01; let n = 0; const o = ev.launch.bind(ev); ev.launch = (l, k) => { n++; return o(l, k); }; for (let k = 0; k < 120 * 30; k++) g.fixed(1 / 120); return n; }; const base = count(); __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); let row = null; for (let i = 0; i < 30 && !row; i++) { row = g.ui.focus.items().find(x => /Fruit interval/.test(x.textContent)); if (!row) g.ui.focus.activate(g.ui.focus.items().find(x => x.textContent === '›')); } for (let i = 0; i < 20; i++) row._adj(1); const set = __TEST__.T.fruitInterval; const reset1 = g.ui.focus.items().find(x => /Reset to Defaults/.test(x.textContent)); g.ui.closeAll(); g.simPaused = false; const slow = count(); __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); let r2 = null; for (let i = 0; i < 30 && !r2; i++) { r2 = g.ui.focus.items().find(x => /Fruit interval/.test(x.textContent)); if (!r2) g.ui.focus.activate(g.ui.focus.items().find(x => x.textContent === '›')); } g.ui.focus.activate(g.ui.focus.items().find(x => /Reset to Defaults/.test(x.textContent))); const back = __TEST__.T.fruitInterval; g.ui.closeAll(); g.simPaused = false; void reset1; return { base, slow, set, back }; }); T.ok(sl.set > 1.5, `slider moved the value ${sl.set}`); T.ok(sl.slow < sl.base * .75, `the running event felt it: ${sl.base} to ${sl.slow}`); T.eq(sl.back, 1, 'Reset to Defaults restores it');\n  // Every Dev Mode tool does something and none of them throws.\n  await reset(); const dv = await page.evaluate(async () => { const g = __TEST__.g; const out = { pages: 0, used: [], errs: [] }; const ev = () => g.mode?.event; const fresh = () => { g.ui.closeAll(); g.simPaused = false; g.scripts.clear(); g.speech.clear(); g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.fruitHat, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let k = 0; k < 60; k++) g.fixed(1 / 120); __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); }; fresh(); const SKIP = /Jump|Skip|Reset save|‹|›/; const nPages = 14; for (let pg = 0; pg < nPages; pg++) { fresh(); for (let q = 0; q < pg; q++) g.ui.focus.activate(g.ui.focus.items().find(x => x.textContent === '›')); const labels = g.ui.focus.items().map(i => i.textContent); for (const lb of labels) { if (SKIP.test(lb)) continue; const it = g.ui.focus.items().find(i => i.textContent === lb) || g.ui.focus.items().find(i => i.textContent.slice(0, 8) === lb.slice(0, 8)); if (!it) continue; try { g.ui.focus.activate(it); if (g.ui.topId() === 'devtext') g.ui.close(); g.frame(1 / 60); if (!g.simPaused) g.simPaused = true; out.used.push(lb.slice(0, 18)); } catch (e) { out.errs.push(lb + ': ' + e); } } out.pages++; } g.god = false; g.loop.timeScale = 1; if (g.rig.free) g.rig.free = false; g.testBotSkill = null; g.devBot = false; g.ui.closeAll(); g.simPaused = false; return { ...out, errors: g.errors.slice(0, 2) }; });\n  T.ok(!dv.errs.length, `dev tool threw: ${dv.errs[0]}`); T.ok(!dv.errors.length, `dev tool error: ${dv.errors[0]}`); for (const want of ['God mode', 'Let the bot', 'Time scale', 'Single step', 'Free camera', 'Physics lines', 'Stats', 'Input monitor', 'Force a gust', 'Force a fall', 'Force a fruit', 'Play a line', 'Play music', 'Play a sting', 'Set Wobble Age', 'Add 10 marbles', 'Unlock all', 'Ink', 'Palette', 'Copy tuning']) T.ok(dv.used.some(u => u.startsWith(want.slice(0, 18))), `dev tool ${want} present and used`);\n  const eff = await page.evaluate(() => { const g = __TEST__.g; g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); e.count = .01; for (let k = 0; k < 120; k++) g.fixed(1 / 120); e.forceGust(4); let peak = 0; for (let k = 0; k < 120; k++) { g.fixed(1 / 120); peak = Math.max(peak, e.lanes[0].bal.angle); } const moved = peak; g.clearMode(); const z = g.startEventMode(__TEST__.EVENTS.fruitHat, {}, [{ kind: 'bot', skill: 'sharp' }]); z.count = .01; for (let k = 0; k < 10; k++) g.fixed(1 / 120); const f0 = z.fruits.length; z.forceThing(); const f1 = z.fruits.length; z.forceFall(); const fl = z.lanes[0].fallen; g.clearMode(); return { moved, f0, f1, fl }; }); T.ok(eff.moved > .2, `force gust moves the doll, ${eff.moved}`); T.ok(eff.f1 > eff.f0, 'force a fruit'); T.ok(eff.fl, 'force a fall');\n  // Jumps in Dev Mode: class, day, results, ending.\n  await reset(); const jmp = await page.evaluate(() => { const g = __TEST__.g; const dev = () => { __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Dev Mode/.test(i.textContent))); }; const res = {}; g.startHub(); dev(); g.ui.focus.activate(g.ui.focus.items().find(i => /Jump to a class/.test(i.textContent))); g.ui.focus.activate(g.ui.focus.items()[1]); g.ui.focus.activate(g.ui.focus.items()[0]); __TEST__.advance(.2); res.cls = g.ui.topId(); g.ui.closeAll(); g.scripts.clear(); g.clearMode(); g.startHub(); dev(); g.ui.focus.activate(g.ui.focus.items().find(i => /Jump to a day/.test(i.textContent))); g.ui.focus.activate(g.ui.focus.items()[2]); __TEST__.advance(.1); res.day = g.profile.day; res.steps = g.profile.steps; g.ui.closeAll(); g.scripts.clear(); g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let k = 0; k < 30; k++) g.fixed(1 / 120); dev(); g.ui.focus.activate(g.ui.focus.items().find(i => /Skip to Results/.test(i.textContent))); res.done = e.phase; g.ui.closeAll(); g.simPaused = false; g.scripts.clear(); g.clearMode(); g.startHub(); dev(); g.ui.focus.activate(g.ui.focus.items().find(i => /Skip to the Ending/.test(i.textContent))); __TEST__.advance(1); res.lev = g.profile.levelled; g.ui.closeAll(); g.scripts.clear(); g.speech.clear(); g.clearMode(); return { ...res, errors: g.errors.slice(0, 1) }; });\n  T.eq(jmp.cls, 'intro', 'dev jump to class'); T.eq(jmp.day, 3, 'dev jump to day'); T.eq(jmp.steps, 7, 'jump sets the steps so tilt matches'); T.eq(jmp.done, 'done', 'dev skip to results'); T.eq(jmp.lev, true, 'dev skip to ending'); T.ok(!jmp.errors.length, `dev jump errors ${jmp.errors[0]}`);\n  // A pad disconnecting mid-class pauses and says so.\n  await reset(); await page.evaluate(() => { const p = window.__pads[0]; p.connected = true; p.axes[0] = .5; }); await adv(.1); await page.evaluate(() => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; window.__pads[0].axes[0] = 0; }); await adv(.2); await page.evaluate(() => { window.__pads[0].connected = false; }); await adv(.1); const dc = await page.evaluate(() => ({ s: __TEST__.state().screen, t: document.querySelector('[data-screen=pause]')?.textContent || '' })); T.eq(dc.s, 'pause', 'a lost pad pauses'); T.ok(/disconnected/i.test(dc.t), 'and says so on screen'); await page.evaluate(() => { const g = __TEST__.g; g.ui.closeAll(); g.simPaused = false; window.__pads[0].connected = true; });\n  // Controller-only audio: the context resumes on pad input, or a tag asks for a key.\n  await reset(); const tagged = await page.evaluate(async () => { const g = __TEST__.g; await g.audio.ctx.suspend(); g.input.padSeen = true; g.audioWait = 0; g.audioTagShown = false; __TEST__.advance(3.2); const shown = !!document.querySelector('.audioTag'); await g.audio.ctx.resume(); __TEST__.advance(.1); return { shown, gone: !document.querySelector('.audioTag'), run: g.audio.ctx.state }; }); T.ok(tagged.shown, 'a tag asks for a key when audio is still suspended'); if (tagged.run === 'running') T.ok(tagged.gone, 'the tag leaves once audio runs');\n  const ges = await page.evaluate(() => { const g = __TEST__.g; let n = 0; const o = g.input.onGesture; g.input.onGesture = () => { n++; }; const p = window.__pads[0]; p.connected = true; p.buttons[3] = { pressed: true, value: 1 }; __TEST__.advance(.03); p.buttons[3] = { pressed: false, value: 0 }; __TEST__.advance(.03); g.input.onGesture = o; return n; }); T.ok(ges >= 1, 'pad input resumes audio');\n  // Plate Spinners on keys: tapping A and D at three rates hits the three bands.\n  for (const [rate, band, lo, hi] of [[1.35, 'large', 3.5, 5], [2.3, 'medium', 6.5, 8], [3.2, 'small', 9.5, 11]]) { await reset(); const h = await page.evaluate((r) => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.plates, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; g.input.setDevice('kbm'); const gap = 1 / r, keys = ['KeyA', 'KeyD']; let next = 0, k = 0, t = 0; for (let i = 0; i < 120 * 8; i++) { if (t >= next) { next += gap; const code = keys[k++ % 2]; window.dispatchEvent(new KeyboardEvent('keydown', { code })); window.dispatchEvent(new KeyboardEvent('keyup', { code })); } g.fixed(1 / 120); t += 1 / 120; } return e.lanes[0].hoop; }, rate); T.ok(h >= lo && h <= hi, `plates: ${rate} taps a second reach ${band}: hoop ${h.toFixed(2)}`); }\n  // Log Reps on keys: holding both ramps depth at the tempo. Springboard air uses raw keys.\n  await reset(); const lg = await page.evaluate(() => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.logReps, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; g.input.setDevice('kbm'); for (const c of ['KeyQ', 'KeyE']) window.dispatchEvent(new KeyboardEvent('keydown', { code: c })); for (let i = 0; i < 120; i++) g.fixed(1 / 120); const d = e.lanes[0].depth; for (const c of ['KeyQ', 'KeyE']) window.dispatchEvent(new KeyboardEvent('keyup', { code: c })); return d; }); T.ok(lg > .3 && lg < .7, `both keys ramp depth at the tempo's speed, ${lg}`);\n  await reset(); const air = await page.evaluate(() => { const g = __TEST__.g; const e = g.startEventMode(__TEST__.EVENTS.springboard, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let i = 0; i < 60; i++) g.fixed(1 / 120); e.forceThing(); g.input.setDevice('kbm'); window.dispatchEvent(new KeyboardEvent('keydown', { code: 'KeyD' })); for (let i = 0; i < 30; i++) g.fixed(1 / 120); const w = e.lanes[0].wishX; window.dispatchEvent(new KeyboardEvent('keyup', { code: 'KeyD' })); return { w, s: e.lanes[0].state }; }); T.eq(air.s, 'air', 'in the air'); T.ok(air.w > .9, `keys steer the air directly, ${air.w}`);\n  // Full Group Class with four pads to the podium, all points given.\n  await reset(); await page.evaluate(() => { const g = __TEST__.g; g.clearMode(); g.goTitle(true); __TEST__.Menus.openMenu(g); __TEST__.Menus.openGroup(g); for (const p of window.__pads) p.connected = true; }); await adv(.3); for (let i = 0; i < 4; i++) { await tap(i, B.cross); await adv(.1); } const leave = await page.evaluate(() => __TEST__.g.ui.top().el.querySelectorAll('.mat .chip').length); T.eq(leave, 4, 'four seats'); await tap(3, B.circle); await adv(.1); T.eq(await page.evaluate(() => __TEST__.g.ui.top().el.querySelectorAll('.mat .chip').length), 3, 'Circle leaves a seat'); await tap(3, B.cross); await adv(.1);\n  await page.evaluate(() => { const g = __TEST__.g; g.ui.focus.set(g.ui.focus.items().find(i => /Quick/.test(i.textContent))); g.ui.focus.activate(); }); const seen = new Set(); let lanesN = 0, kinds = '', pts = null; for (let i = 0; i < 2500; i++) { const s = await st(); seen.add(s.screen); if (s.errors.length) { T.ok(false, `group: ${s.errors[0].slice(0, 200)}`); break; } if (s.screen === 'play') { lanesN = Math.max(lanesN, s.event.lanes.length); kinds = s.event.lanes.map(l => l.kind).join(); await page.evaluate(() => { const ev = __TEST__.g.mode.event; if (ev.playT > 2) ev.forceFinish(); }); await adv(.5); } else if (s.screen === 'groupresult') { pts = await page.evaluate(() => __TEST__.g.ui.top().el.textContent); await tap(0, B.cross); await adv(.5); } else if (s.screen === 'intro' || s.screen === 'podium') { await tap(0, B.cross); await adv(.5); if (s.screen === 'podium') { await adv(.1); } } else if (s.screen === 'title' && seen.has('podium')) break; else await adv(.3); }\n  T.ok(seen.has('podium'), `four-pad class reaches the podium: ${[...seen]}`); T.eq(lanesN, 4, 'four lanes in class'); T.eq(kinds, 'local,local,local,local', 'all four are players'); T.ok(/\\+4 points/.test(pts || '') && /\\+1 points/.test(pts || ''), `points 4 to 1: ${pts}`);\n  // Podium tips over.\n  await reset(); const pod = await page.evaluate(() => { const g = __TEST__.g; return g.CheckInCls ? true : false; }); T.ok(pod, 'hooks');\n  // Pause > Leave Class returns to the island; from Free Play to the menu.\n  await reset(); const lv = await page.evaluate(() => { const g = __TEST__.g; g.startHub(); g.playClass('poses', 'programme'); __TEST__.advance(.2); g.ui.focus.activate(g.ui.focus.items().find(i => /Begin/.test(i.textContent))); __TEST__.advance(1.2); const inEv = !!g.mode.event; __TEST__.Menus.openPause(g); g.ui.focus.activate(g.ui.focus.items().find(i => /Leave Class/.test(i.textContent))); __TEST__.advance(.2); return { inEv, s: __TEST__.state().screen, locked: g.hub?.locked, err: g.errors.slice(0, 1) }; }); T.ok(lv.inEv, 'in class'); T.eq(lv.s, 'island', 'Leave Class goes to the island'); T.eq(lv.locked, false, 'and you can walk'); T.ok(!lv.err.length, `leave errors ${lv.err[0]}`);\n  // Difficulty and rhythm settings reach the game.\n  await reset(); const df = await page.evaluate(() => { const g = __TEST__.g; const out = {}; for (const d of ['gentle', 'standard', 'honest']) { g.settings.difficulty = d; g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'bot', skill: 'sharp' }]); out[d] = e.lanes[0].bal.ankle(); } g.settings.difficulty = 'standard'; g.settings.autoBreathe = true; g.clearMode(); const e = g.startEventMode(__TEST__.EVENTS.poses, {}, [{ kind: 'local', name: 'P' }]); e.count = .01; for (let i = 0; i < 120 * 9; i++) g.fixed(1 / 120); out.auto = e.lanes[0].breathSync; g.settings.autoBreathe = false; g.clearMode(); return out; }); T.ok(df.gentle > df.standard && df.standard > df.honest, `difficulty changes ankle strength ${JSON.stringify(df)}`); T.ok(df.auto, 'auto-breathe keeps you in sync');\n  T.ok(!page.errors.length, `coverage errors ${page.errors.slice(0, 2).join('|').slice(0, 400)}`); await page.context().close();\n}\nE\nsed -i \"s/\\['unit', 'flow', 'events', 'balance', 'input', 'audio', 'hub', 'ui'\\]/['unit', 'flow', 'events', 'balance', 'input', 'coverage', 'audio', 'hub', 'ui']/\" tools/test.mjs\ntimeout 300 node tools/test.mjs coverage 2>&1 | grep -E '^FAIL|passed' | cut -c1-330 | tail -30","description":"Write and run tests for the items only inferred so far","timeout":320000}}}
