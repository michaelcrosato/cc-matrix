{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmEQ8Hrmq9ZwCvZDZYp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019ocbbu1Fu9GqNsU8wKqqvQ","name":"Bash","input":{"command":"python3 -I - <<'E'\ns=open('src/events/base.js').read()\ns=s.replace(\"\"\"    this.world = makeWorld({ ...this.worldOpts(), gravity: T.gravity });\n    this.ground = addGroundPlane(this.world, this.groundY());\n    this.game.scene.add(this.group);\"\"\",\"\"\"    this.makeEventWorld();\n    this.game.scene.add(this.group);\"\"\")\ns=s.replace(\"\"\"  buildSet() {} start() {}\"\"\",\"\"\"  makeEventWorld() { this.world = makeWorld({ ...this.worldOpts(), gravity: T.gravity }); this.ground = addGroundPlane(this.world, this.groundY()); }\n  buildSet() {} start() {}\"\"\")\ns=s.replace(\"\"\"if (this.god) b.reset(); else this.fall(lane);\"\"\",\"\"\"if (this.god || this.noFall) b.reset(); else this.fall(lane);\"\"\")\ns=s.replace(\"\"\"    this.game.scene.remove(this.group);\n    this.group.traverse\"\"\",\"\"\"    this.group.removeFromParent();\n    this.group.traverse\"\"\")\nopen('src/events/base.js','w').write(s)\ns=open('src/events/fruitHat.js').read()\ns=s.replace(\"const dhat = Math.hypot(p.x - (l.x + (l.bal?.cobX || 0) * .35), p.z - (l.z + (l.bal?.cobZ || 0) * .35));\",\"const dhat = Math.hypot(p.x - (l.x + Math.sin(l.bal?.leanX || 0) * 1.5), p.z - (l.z + Math.sin(l.bal?.leanZ || 0) * 1.5));\")\ns=s.replace(\"gx = (best.lx - l.x) / .36; gz = (best.lz - l.z) / .36;\",\"gx = (best.lx - l.x) / .46; gz = (best.lz - l.z) / .46;\")\nopen('src/events/fruitHat.js','w').write(s)\nE\ncat > src/events/poses.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, lerp } from './base.js';\nimport { POSES } from '../data/poses.js';\nimport { T } from '../core/tuning.js';\nimport { deck, box, at, cyl, sphere, lantern, bunting, palm, torus, toon, flat, cached } from '../art/props.js';\nimport { makeHeron } from '../art/heron.js';\nimport { GUESTS } from '../data/names.js';\nexport class Poses extends EventBase {\n  static id = 'poses'; static title = 'Poses'; static discipline = 'Stillness'; static instructor = 'stillwater'; static place = 'The Sun Deck'; static music = 'stillness'; static couch = true; static session = true; static diagram = 'ring';\n  static sentence = 'Follow the green ring across the disc, then hold still while it shrinks.';\n  static can = 'You can breathe with the ring for a steadier body.'; static cant = \"Your feet don't matter here.\";\n  static verbs = [['lean', 'Lean'], ['breath', 'Breathe'], ['flail', 'Flail']];\n  static tiers = [\n    { poses: 3, hold: 8, ringEnd: .16, sway: [.08, .22], tremor: [.08, .2] },\n    { poses: 4, hold: 10, ringEnd: .13, sway: [.12, .3], tremor: [.1, .3] },\n    { poses: 5, hold: 12, ringEnd: .1, sway: [.15, .38], tremor: [.15, .4] },\n  ];\n  static sessionConfig = { tier: 0, hold: 13.6, poses: 3 };\n  balanceOpts() { return { maxLean: 14 }; }\n  buildSet() {\n    this.usesBreath = true; this.faceYaw = 0; this.nPoses = this.opts.poses || this.tier.poses; this.hold = this.opts.hold || this.tier.hold;\n    const n = this.opts.laneCount || 1; const R = 5.4 + n * 1.3;\n    this.add(deck(R, '#C89B6A'), 0, 0, -.5);\n    for (let i = 0; i < 16; i++) { const a = i / 16 * 6.283; if (Math.abs(Math.sin(a)) < .3 && Math.cos(a) > 0) continue; this.add(at(cyl(.05, .06, 1, '#E9D3AE'), Math.cos(a) * (R - .15), .5, Math.sin(a) * (R - .15) - .5)); }\n    const rail = torus(R - .15, .06, '#E9D3AE'); rail.rotation.x = Math.PI / 2; this.add(rail, 0, 1, -.5);\n    this.add(palm(1.5), -R - 2, -.5, -3); this.add(palm(1.2), R + 2.4, -.5, -4); this.add(lantern(), -R + .6, 0, -2.5); this.add(lantern(), R - .6, 0, -2.5);\n    this.add(bunting(-R + .6, 2.1, -2.5, R - .6, 2.1, -2.5, 14));\n    this.heron = makeHeron(); this.heron.group.scale.setScalar(1.1); this.add(this.heron.group, -2.4 - (n - 1) * 1.6, 0, -1.7); this.heron.group.rotation.y = .5; this.anim.push(this.heron);\n    this.crowd([{ ...GUESTS[0], x: 3.4 + n, z: -3.1, yaw: -.5, clip: 'breathe' }, { ...GUESTS[3], x: 2 + n, z: -3.7, yaw: -.2, clip: 'breathe' }]);\n    // A soft floor ring under the doll shows the target too, for the room.\n    this.floorRings = [];\n    this.order = []; const pool = [...POSES]; for (let i = 0; i < this.nPoses; i++) this.order.push(pool.splice(Math.floor(this.r() * pool.length), 1)[0] || POSES[i]);\n    this.stage = 'glide'; this.st = 0; this.poseI = 0;\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(6.8, spread); this.game.rig.set(0, 1.25, d, 0, 1, 0, snap); }\n  start() { for (const l of this.lanes) { l.earned = 0; l.maxEarn = 0; l.zone = { x: 0, z: 0, r: .3 }; l.baseClip = 'idle'; if (l.kind !== 'ghost') { const ring = new THREE.Mesh(cached('fr', () => new THREE.RingGeometry(.9, 1, 40)), flat('#2E8B57')); ring.rotation.x = -Math.PI / 2; ring.position.set(l.x, .03, 0); this.group.add(ring); l.floorRing = ring; } } this.announce(); }\n  announce() { const p = this.order[this.poseI]; if (!p) return; this.setMsg(p.name); for (const l of this.lanes) { l.baseClip = p.clip; if (!l.fallen) l.doll.rig.play(p.clip, .6); } this.heron.rig.play('demo', .4); if (!this.attract) this.game.barkNow('stillwater', 'pose', { pose: p.name }); }\n  fixedPlay(dt) {\n    this.st += dt; const p = this.order[this.poseI];\n    if (this.stage === 'glide') {\n      const a = Math.min(1, this.st / 3), s = a * a * (3 - 2 * a);\n      for (const l of this.lanes) { l.zone.x = (l.fromX ?? 0) + (p.x - (l.fromX ?? 0)) * s; l.zone.z = (l.fromZ ?? 0) + (p.z - (l.fromZ ?? 0)) * s; l.zone.r = .3; l.sway = this.tier.sway[0]; l.tremor = this.tier.tremor[0]; }\n      if (this.st >= 3) { this.stage = 'hold'; this.st = 0; this.heron.rig.play('stand', .5); }\n    } else {\n      const a = Math.min(1, this.st / this.hold);\n      const r = lerp(.3, this.tier.ringEnd * T.ringEnd, a);\n      for (const l of this.lanes) {\n        l.zone.r = r; l.sway = lerp(this.tier.sway[0], this.tier.sway[1], a); l.tremor = lerp(this.tier.tremor[0], this.tier.tremor[1], a);\n        if (l.kind === 'ghost' || !l.bal) continue;\n        const earn = .3 / r; l.maxEarn += earn * dt;\n        if (!l.fallen && Math.hypot(l.bal.cobX - l.zone.x, l.bal.cobZ - l.zone.z) <= r) l.earned += earn * dt * (l.breathSync ? 1.25 : 1);\n        l.form = Math.min(100, 100 * l.earned / Math.max(.001, this.maxTotal()));\n      }\n      if (this.st >= this.hold) {\n        this.poseI++; this.st = 0; this.game.audio.sfx('bell');\n        if (this.poseI >= this.nPoses) { this.finish(); return; }\n        const q = this.order[this.poseI - 1]; for (const l of this.lanes) { l.fromX = q.x; l.fromZ = q.z; } this.stage = 'glide'; this.announce();\n      }\n    }\n  }\n  maxTotal() { // integral of .3/r over a hold, exact share of the maximum over the whole class so far\n    const done = this.poseI + (this.stage === 'hold' ? Math.min(1, this.st / this.hold) : 0);\n    const R0 = .3, R1 = this.tier.ringEnd * T.ringEnd; const full = this.hold * .3 * Math.log(R0 / R1) / (R0 - R1);\n    return Math.max(.001, full * done);\n  }\n  onFlail(l) { l.earned = Math.max(0, l.earned - .4); if (l.kind === 'local') this.bark('stillwater', 'flail'); }\n  frameLane(l) { if (l.floorRing && l.bal) { const r = l.zone.r * 1.1 + .05; l.floorRing.scale.setScalar(r); l.floorRing.position.x = l.x + l.zone.x * .9; l.floorRing.position.z = l.zone.z * .9; } }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (l) this.setNum(Math.round(l.form), 'Form'); this.setTime(this.stage === 'hold' ? this.hold - this.st : 3 - this.st); if (this.barkT <= 0 && l && l.kind === 'local') this.bark('stillwater', 'calm'); }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l);\n    const mode = this.opts.botMode;\n    const breath = mode === 'nobreath' || mode === 'park' ? false : (this.t % 8) < 4;\n    if (mode === 'park') return { x: l.zone.x, z: l.zone.z, breath };\n    const [x, z] = br.correct(dt, l, l.zone.x, l.zone.z);\n    return { x, z, breath };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.form), label: 'Form', stats: `${this.poseI} poses held. Floor Exercises: ${l.falls}` }; }\n  forceThing() { this.forceGust(2); }\n}\nE\ncat > src/events/cairn.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, lerp } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { sphere, box, at, cyl, rock, stoneStack, palm, mesh, tree } from '../art/props.js';\nimport { makeHeron } from '../art/heron.js';\nconst NORMAL = [[.26, .09], [.24, .085], [.22, .08], [.2, .078], [.18, .074], [.165, .07], [.15, .066], [.14, .062], [.125, .058], [.11, .054]];\nconst WIDE = [[.28, .09], [.27, .085], [.26, .08], [.25, .078], [.24, .074], [.23, .07], [.22, .066], [.21, .062], [.2, .058], [.19, .054]];\nconst COLS = ['#A69A8C', '#BDB2A2', '#8F8578', '#C7BBA9', '#9C9184', '#B3A794'];\nexport class Cairn extends EventBase {\n  static id = 'cairn'; static title = 'The Cairn'; static discipline = 'Stillness'; static instructor = 'stillwater'; static place = 'Quarry Terrace'; static music = 'stillness'; static couch = true; static session = true; static diagram = 'stack';\n  static sentence = 'Hold the slab overhead. Ms. Stillwater adds stones. Keep it level as the stack comes alive.';\n  static can = 'You can breathe with the ring, and it helps enormously.'; static cant = \"You can't catch a stone once it has left.\";\n  static verbs = [['lean', 'Lean'], ['breath', 'Breathe'], ['flail', 'Flail']];\n  static tiers = [\n    { stones: 6, every: 5.5, hold: 8, sway: [.1, .3], tremor: [.05, .15], offset: .015, set: NORMAL, par: 750 },\n    { stones: 8, every: 5, hold: 10, sway: [.15, .4], tremor: [.08, .2], offset: .02, set: NORMAL, par: 980 },\n    { stones: 10, every: 4.5, hold: 10, sway: [.15, .4], tremor: [.08, .2], offset: .02, set: WIDE, par: 1210 },\n  ];\n  static sessionConfig = { tier: 0, every: 6.5, hold: 11 };\n  balanceOpts() { return { margin: .8, ankleMax: 6 }; }\n  worldOpts() { return { iterations: 10 }; }\n  buildSet() {\n    this.usesBreath = true; this.camYaw = .42; this.faceYaw = .42;\n    this.nStones = this.tier.stones; this.every = this.opts.every || this.tier.every; this.holdEnd = this.opts.hold || this.tier.hold;\n    const floor = cyl(10, 10.5, 2.4, '#D8CDBB', 28); this.add(floor, 0, -1.2, 0);\n    for (let i = 0; i < 9; i++) { const a = i * 2.4 + 1, d = 6 + (i % 3) * 1.1; this.add(rock(.4 + (i % 3) * .28), Math.cos(a) * d, .15, Math.sin(a) * d - 2); }\n    this.add(stoneStack(4), -5.5, 0, -3); this.add(stoneStack(3), 4.8, 0, -4.6); this.add(palm(1.2), -7, 0, -5);\n    const cliff = cyl(7, 9, 7, '#C7BBA9', 12); this.add(cliff, 3, -3.5, -14);\n    this.heron = makeHeron(); this.heron.group.scale.setScalar(1.25); this.add(this.heron.group, -2.1 - (this.opts.laneCount || 1) * .9, 0, -.8); this.heron.group.rotation.y = 1.1; this.anim.push(this.heron);\n    this.nextT = 1.5; this.placed = 0; this.ended = false;\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(7.6, spread); const a = .42; this.game.rig.set(-Math.sin(a) * d * -1 * -1, 1.9, Math.cos(a) * d, 0, 1.45, 0, snap); }\n  start() {\n    for (const l of this.lanes) {\n      l.stones = []; l.baseClip = 'holdSlab'; l.doll.rig.play('holdSlab', 0); l.distSum = 0; l.distN = 0; l.dropped = 0;\n      if (l.kind === 'ghost') continue;\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(.55, .03, .55).setTranslation(0, .95, 0).setMass(.05).setFriction(1).setCollisionGroups(G_PROP(l.id)), l.bal.body);\n      const slab = box(1.1, .06, 1.1, '#8F8578'); slab.position.y = 1.7; l.doll.lean.add(slab); l.slab = slab; l.sway = this.tier.sway[0]; l.tremor = this.tier.tremor[0];\n    }\n  }\n  bodyPoint(l, y) { const b = l.bal.body.translation(), q = l.bal.body.rotation(); const v = new THREE.Vector3(0, y, 0).applyQuaternion(new THREE.Quaternion(q.x, q.y, q.z, q.w)); return { x: b.x + v.x, y: b.y + v.y, z: b.z + v.z }; }\n  dropStone(l, idx) {\n    if (l.fallen) return;\n    const [r, hh] = this.tier.set[idx % this.tier.set.length];\n    const top = l.stones.length ? l.stones[l.stones.length - 1] : null;\n    let p; const off = this.tier.offset;\n    if (top && !top.gone) { const tp = top.body.translation(); p = { x: tp.x + (this.r() - .5) * 2 * off, y: tp.y + top.hh + hh + .012, z: tp.z + (this.r() - .5) * 2 * off }; }\n    else { const s = this.bodyPoint(l, .98); p = { x: s.x + (this.r() - .5) * 2 * off, y: s.y + hh + .012, z: s.z + (this.r() - .5) * 2 * off }; }\n    const v = l.bal.body.linvel();\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x, p.y, p.z).setRotation(l.bal.body.rotation()).setLinvel(v.x * .5, 0, v.z * .5).setLinearDamping(.1).setAngularDamping(.6).setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(r * .8, hh, r * .8).setMass(.02 * T.stoneMass).setFriction(.95).setRestitution(0).setCollisionGroups(G_PROP(l.id)), body);\n    const m = sphere(r, COLS[idx % COLS.length], 1, hh / r * 1.25, .92); this.group.add(m);\n    l.stones.push({ body, m, r, hh, gone: false });\n    this.game.audio.sfx('clack', { f: 500 });\n  }\n  fixedPlay(dt) {\n    const prog = Math.min(1, this.playT / (this.nStones * this.every + this.holdEnd));\n    const interval = this.every * T.stoneInterval;\n    for (const l of this.lanes) { l.sway = lerp(this.tier.sway[0], this.tier.sway[1], prog); l.tremor = lerp(this.tier.tremor[0], this.tier.tremor[1], prog); }\n    if (this.placed < this.nStones && this.playT >= this.nextT) {\n      for (const l of this.lanes) if (l.kind !== 'ghost') this.dropStone(l, this.placed);\n      this.placed++; this.nextT += interval; this.heron.rig.play('peck', .2, 'stand');\n      if (this.barkT <= 0 && !this.attract) this.bark('stillwater', 'stone');\n      if (this.placed === this.nStones) this.holdStart = this.playT;\n    }\n    for (const l of this.lanes) { if (l.kind === 'ghost' || !l.bal || l.fallen) continue; l.distSum += Math.hypot(l.bal.cobX, l.bal.cobZ); l.distN++; }\n    if (this.placed >= this.nStones && this.playT >= this.holdStart + this.holdEnd) { this.tally(); this.finish(); }\n  }\n  count(l) { if (l.fallen || !l.bal) return 0; const s = this.bodyPoint(l, .95); let n = 0; for (const st of l.stones) { if (st.gone) continue; const p = st.body.translation(); if (p.y > s.y - .1 && Math.hypot(p.x - s.x, p.z - s.z) < 1) n++; } return n; }\n  postPlay() {\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') continue;\n      for (const st of l.stones) { if (st.gone) continue; const p = st.body.translation(), q = st.body.rotation(); st.m.position.set(p.x, p.y, p.z); st.m.quaternion.set(q.x, q.y, q.z, q.w); if (!st.fellOff && l.bal && p.y < .5) { st.fellOff = true; l.dropped++; this.game.audio.sfx('clack', { f: 420 }); this.game.comic('CLONK', p.x, .8, p.z, '#FFF8EE', .55, .7); if (l.kind === 'local') this.bark('stillwater', 'stoneDrop'); } }\n      l.onSlab = this.count(l);\n      const steady = l.distN ? Math.max(0, 1 - (l.distSum / l.distN) / .5) : 0;\n      l.score = 100 * l.onSlab + 10 * l.onSlab + 50 * steady;\n      l.form = Math.min(100, 100 * l.score / this.tier.par);\n    }\n  }\n  tally() {}\n  frameLane() {}\n  onFall(l) { if (l.slab) l.slab.visible = false; }\n  onRecover(l) { if (l.slab) l.slab.visible = true; for (const st of l.stones) if (!st.fellOff) { st.fellOff = true; l.dropped++; } }\n  onFlail(l) { if (l.kind === 'local') this.bark('stillwater', 'flail'); }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (l) this.setNum(l.onSlab ?? 0, 'Stones up'); this.setTime(this.placed < this.nStones ? this.nextT - this.playT : this.holdStart + this.holdEnd - this.playT); }\n  botInput(i, t, skill, dt) { const l = this.lanes[i], br = this.botBrain(l); const [x, z] = br.correct(dt, l, 0, 0, true); return { x, z, breath: this.opts.botMode === 'nobreath' ? false : (this.t % 8) < 4 }; }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.onSlab ?? 0, label: 'Stones standing', stats: `${l.dropped} dropped. Floor Exercises: ${l.falls}` }; }\n  forceThing() { for (const l of this.lanes) if (l.kind !== 'ghost') this.dropStone(l, this.placed % this.tier.set.length); }\n}\nE\ncat > src/events/stillWater.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { Fn, uniform, length, sin, mix, positionWorld, time, vec2, smoothstep, vec3, step, float } from 'three/tsl';\nimport { EventBase, lerp } from './base.js';\nimport { sphere, box, at, cyl, cone, torus, palm, tree, mesh, cached, rock } from '../art/props.js';\nimport { makeHeron } from '../art/heron.js';\nimport { makeGull } from '../art/gull.js';\nimport { PU } from '../render/palette.js';\nconst CREATURES = ['Dragonfly', 'Frog', 'Koi', 'Turtle', 'Ms. Stillwater'];\nexport class StillWater extends EventBase {\n  static id = 'stillWater'; static title = 'Still Water'; static discipline = 'Stillness'; static instructor = 'stillwater'; static place = 'The Lily Pond'; static music = 'stillness'; static diagram = 'ring';\n  static sentence = 'Sit on a lily pad. Stay in the calm zone. Creatures come if you are boring enough.';\n  static can = 'You can stifle a sneeze with Flail, when you hear it coming.'; static cant = \"You can't fall in this one. You can only be disappointing.\";\n  static verbs = [['lean', 'Lean'], ['breath', 'Breathe'], ['flail', 'Stifle']];\n  static tiers = [{ zone: .15, sway: [.07, .18], tremor: .05, sneezes: 2 }, { zone: .12, sway: [.1, .22], tremor: .05, sneezes: 3 }, { zone: .1, sway: [.12, .26], tremor: .05, sneezes: 4 }];\n  buildSet() {\n    this.usesBreath = true; this.noFall = true; this.timeLimit = 60; this.flailOk = true;\n    this.uRipple = uniform(0);\n    const m = new THREE.MeshBasicNodeMaterial();\n    const rip = this.uRipple;\n    m.colorNode = Fn(() => {\n      const d = length(positionWorld.xz.sub(vec2(0, 0)));\n      const w = sin(d.mul(6).sub(time.mul(2.2))).mul(.5).add(.5);\n      const rings = step(float(.78).sub(rip.mul(.5)), w).mul(smoothstep(float(2).add(rip.mul(10)), float(.5), d).mul(rip.mul(.92).add(.08)));\n      const base = mix(vec3(.25, .55, .5), PU.seaHi, sin(positionWorld.x.mul(.8).add(time.mul(.2))).mul(sin(positionWorld.z.mul(.7))).mul(.14).add(.12));\n      return mix(base, vec3(1, 1, .95), rings);\n    })();\n    const pond = new THREE.Mesh(new THREE.CircleGeometry(9, 56), m); pond.rotation.x = -Math.PI / 2; pond.position.y = .02; this.add(pond);\n    const bank = torus(9.5, .9, '#9CC97A'); bank.rotation.x = Math.PI / 2; this.add(bank, 0, -.2, 0);\n    const pad = cyl(.95, .9, .07, '#4FB56A', 28); this.add(pad, 0, .03, 0); this.pad = pad;\n    for (let i = 0; i < 12; i++) { const a = i * 2.3 + .4, d = 3 + (i % 4) * 1.2; const p = cyl(.45 + (i % 3) * .15, .4, .04, i % 2 ? '#4FB56A' : '#67C47D', 16); this.add(p, Math.cos(a) * d, .04, Math.sin(a) * d); if (i % 3 === 0) { const f = sphere(.13, '#F4A6C0', 1, .7, 1); this.add(f, Math.cos(a) * d, .14, Math.sin(a) * d); } }\n    for (let i = 0; i < 8; i++) { const a = i * .8; this.add(at(cyl(.03, .04, 1.4, '#6FA84F', 6), Math.cos(a) * 9.1, .6, Math.sin(a) * 9.1 - .2)); }\n    this.add(palm(1.5), -9, 0, -7); this.add(tree(1.4), 8.6, 0, -6); this.add(rock(.8), 6, .1, -7);\n    // Creatures\n    const fly = new THREE.Group(); fly.add(at(sphere(.03, '#2FA7A0', 1, 1, 2.6), 0, 0, 0)); for (const s of [-1, 1]) { const w = sphere(.06, '#BDF2F2', 1.5, .1, .5); fly.add(at(w, s * .08, .01, 0)); } this.dragonfly = fly; fly.visible = false; this.add(fly);\n    const frog = new THREE.Group(); frog.add(sphere(.12, '#5BB04D', 1.1, .8, 1.2)); for (const s of [-1, 1]) frog.add(at(sphere(.04, '#1A1420'), s * .07, .09, .08)); this.frog = frog; frog.visible = false; this.add(frog);\n    const koi = new THREE.Group(); koi.add(sphere(.16, '#F58A2E', .6, .4, 1.5)); koi.add(at(sphere(.06, '#FFF8EE', 1, .6, 1), 0, .05, .08)); const tail = cone(.09, .2, '#F58A2E', 4); tail.rotation.x = -1.57; koi.add(at(tail, 0, 0, -.28)); this.koi = koi; koi.visible = false; this.add(koi);\n    const turtle = new THREE.Group(); turtle.add(sphere(.22, '#4F8A5B', 1, .55, 1.15)); turtle.add(at(sphere(.07, '#8DBA76'), 0, .02, .28)); this.turtle = turtle; turtle.visible = false; this.add(turtle, -1.4, .06, .4);\n    this.heron = makeHeron(); this.heron.group.scale.setScalar(1.1); this.add(this.heron.group, -5.5, .03, -3.5); this.heron.group.rotation.y = .9; this.anim.push(this.heron); this.heronT = 0;\n    this.sneezeAt = []; const n = this.tier.sneezes; for (let i = 0; i < n; i++) this.sneezeAt.push(10 + (i + .2 + this.r() * .6) * (46 / n)); this.sneezeState = null;\n    this.whisperT = 8; this.reached = 0;\n  }\n  placeCamera(snap) { this.game.rig.set(0, 5.4, 6.8, 0, .55, 0, snap); }\n  start() { for (const l of this.lanes) { l.calm = 0; l.inT = 0; l.totalT = 0; l.baseClip = 'sit'; l.doll.rig.play('sit', 0); l.customPose = true; l.zone = { x: 0, z: 0, r: this.tier.zone }; l.sway = this.tier.sway[0]; l.tremor = this.tier.tremor; l.peak = 0; l.motion = 0; } }\n  fixedPlay(dt) {\n    const a = this.playT / this.timeLimit; const l = this.lanes[0];\n    for (const la of this.lanes) la.sway = lerp(this.tier.sway[0], this.tier.sway[1], a);\n    if (this.sneezeAt.length && this.playT > this.sneezeAt[0] && !this.sneezeState) { this.sneezeAt.shift(); this.sneezeState = { left: 1.2 }; this.setMsg('Ah... ah...'); this.game.audio.speak('kevin', 'Ah... ah...'); for (const la of this.lanes) la.stifled = false; }\n    if (this.sneezeState) {\n      this.sneezeState.left -= dt;\n      for (const la of this.lanes) if (la.in.flail) la.stifled = true;\n      if (this.sneezeState.left <= 0) { this.setMsg(''); for (const la of this.lanes) if (!la.stifled && la.bal) { const ang = this.r() * 6.283; this.gust(la, Math.cos(ang) * 2.2, Math.sin(ang) * 2.2, .3); this.game.audio.sfx('sneeze'); this.game.comic('ACHOO!', la.x, 1.6, 0, '#FFF8EE', .9); } this.sneezeState = null; }\n    }\n    this.whisperT -= dt; if (this.whisperT <= 0 && !this.attract) { this.whisperT = 13; this.game.barkNow(this.r() < .5 ? 'stillwater' : 'stillwater', 'pond'); }\n    for (const la of this.lanes) {\n      if (!la.bal) continue;\n      const d = Math.hypot(la.bal.cobX, la.bal.cobZ), inz = d <= la.zone.r; la.totalT += dt; if (inz) la.inT += dt;\n      const was = la.calm; la.calm = Math.max(0, Math.min(1, la.calm + (inz ? dt / 30 : -dt / 8) * (la.breathSync ? 1.25 : 1))); la.peak = Math.max(la.peak, la.calm);\n      la.form = 100 * ((la.inT / Math.max(.01, this.timeLimit)) + la.calm) / 2;\n      if (la.kind === 'local') for (let k = 1; k <= 5; k++) { const th = k * .2; if (was < th && la.calm >= th) { this.game.audio.sfx('marble', { r: k * .1 }); this.game.ui.toast(`${CREATURES[k - 1]} has arrived.`); this.bark('stillwater', k === 5 ? 'pat' : 'creature'); } if (was >= th && la.calm < th && k === 1) { this.bark('stillwater', 'scatter'); } }\n      const w = la.bal.body.angvel(); la.motion += (Math.min(1, Math.hypot(w.x, w.z) * 1.2) - la.motion) * .03;\n    }\n    if (this.playT >= this.timeLimit) this.finish();\n  }\n  frameLane(l, dt) {\n    if (!l.bal) return;\n    const lx = l.bal.leanX * .55, lz = l.bal.leanZ * .55;\n    l.doll.group.position.set(0, .07, 0); l.doll.setLean(lx, lz);\n    l.doll.inner.position.y = -.27;\n    if (this.pad) this.pad.rotation.set(lz * .3, 0, -lx * .3);\n    if (l.id !== 0) return;\n    this.uRipple.value = l.motion;\n    const c = l.calm, t = this.t;\n    this.dragonfly.visible = c >= .2; if (c >= .2) { this.dragonfly.position.set(Math.sin(lx) * 1.3, 1.17, .3 + Math.sin(lz) * 1.3); this.dragonfly.rotation.y = Math.sin(t) * .3; }\n    this.frog.visible = c >= .4; if (c >= .4) this.frog.position.set(Math.sin(lx) * 1.4, 1.42, Math.sin(lz) * 1.4);\n    this.koi.visible = c >= .6; if (c >= .6) { this.koi.position.set(Math.cos(t * .6) * 2.2, .1, Math.sin(t * .6) * 2.2); this.koi.rotation.y = -t * .6; }\n    this.turtle.visible = c >= .8;\n    const wantH = c >= 1 ? 1 : 0; this.heronT += (wantH - this.heronT) * .01;\n    this.heron.group.position.set(lerp(-5.5, -1.1, this.heronT), .03, lerp(-3.5, -.6, this.heronT));\n    if (wantH && this.heronT > .9 && this.heron.rig.currentName !== 'pat') this.heron.rig.play('pat', .3);\n  }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(`${Math.round(l.calm * 100)}%`, 'Calm'); this.setTime(this.timeLimit - this.playT); } }\n  botInput(i, t, skill, dt) { const l = this.lanes[i], br = this.botBrain(l); const [x, z] = br.correct(dt, l, 0, 0); return { x, z, breath: (this.t % 8) < 4, flail: !!this.sneezeState && this.sneezeState.left < .9 && this.sneezeState.left > .8 }; }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: `${Math.round(l.peak * 100)}%`, label: 'Peak calm', stats: `Time in the zone: ${Math.round(100 * l.inT / Math.max(1, l.totalT))}%` }; }\n  forceThing() { this.sneezeState = { left: 1.2 }; this.setMsg('Ah... ah...'); for (const la of this.lanes) la.stifled = false; }\n}\nE\ncat > src/events/logReps.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, lerp } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { cyl, box, at, sphere, bench, crate, tree, bunting, cone, torus } from '../art/props.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { el, txt } from '../ui/ui.js';\nexport class LogReps extends EventBase {\n  static id = 'logReps'; static title = 'Log Reps'; static discipline = 'Strength'; static instructor = 'bolster'; static place = 'The Yard'; static music = 'strength'; static couch = true; static session = true; static diagram = 'feet';\n  static sentence = 'Squeeze both feet to sink with the ribbon, rise with it, and keep the dot in the ring.';\n  static can = 'You can let the log slide. Coach will catch it. That rep is lost.'; static cant = \"You can't rush: the ribbon decides the tempo.\";\n  static verbs = [['lean', 'Lean'], ['feet', 'Sink'], ['flail', 'Flail']];\n  static tiers = [\n    { reps: 6, sway: [.08, .22], tremor: [.04, .12], tight: 0 },\n    { reps: 9, sway: [.12, .3], tremor: [.06, .16], tight: .02 },\n    { reps: 12, sway: [.15, .38], tremor: [.08, .2], tight: .04 },\n  ];\n  static sessionConfig = { tier: 0, reps: 8 };\n  balanceOpts() { return { margin: .8, ankleMax: 6 }; }\n  buildSet() {\n    this.camYaw = -.3; this.faceYaw = -.3; this.nReps = (this.opts.reps || this.tier.reps) + 2;\n    const n = this.opts.laneCount || 1;\n    const ground = cyl(12, 12.3, 1, '#E3CFA3', 32); this.add(ground, 0, -.5, 0);\n    const mat = box(2.2 + (n - 1) * 3.2, .04, 2.2, '#D9694F'); this.add(mat, 0, .02, 0);\n    for (let i = 0; i < 6; i++) { const a = i / 6 * 3.1 + 3.3; const log = cyl(.16, .16, 1.9, '#9C7048'); log.rotation.z = 1.57; log.rotation.y = i; this.add(log, Math.cos(a) * 6.5, .17, Math.sin(a) * 6.5); }\n    this.add(bench(), -5, 0, -2); this.add(bench(), 5, 0, -3); this.add(crate(.8), 6, 0, -.5); this.add(tree(1.5, '#7CC568'), -7, 0, -5); this.add(tree(1.2, '#F4A6C0'), 7, 0, -6);\n    this.add(bunting(-6, 3, -4, 6, 3, -4, 16));\n    // A rack of dumb bells made of toy blocks.\n    const rack = box(2.4, .1, .5, '#7A5A3C'); this.add(rack, -3.2, .8, -3.6); this.add(at(box(.1, .8, .5, '#7A5A3C'), -4.3, .4, -3.6)); this.add(at(box(.1, .8, .5, '#7A5A3C'), -2.1, .4, -3.6));\n    this.walrus = makeWalrus(); this.add(this.walrus.group, -2.7 - (n - 1) * 1.6, 0, -.3); this.walrus.group.rotation.y = .75; this.anim.push(this.walrus);\n    this.falling = [];\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(6.5, spread); this.game.rig.set(Math.sin(-.3) * d, 1.8, Math.cos(.3) * d, 0, 1, 0, snap); }\n  setupHud2() { this.bar = el('div', 'vbar'); this.band = el('div', 'band'); this.mark = el('div', 'mark'); this.bar.append(this.band, this.mark); this.hudEl.appendChild(this.bar); }\n  start() {\n    for (const l of this.lanes) {\n      l.depth = 0; l.rep = 0; l.inBand = 0; l.inZone = 0; l.ticks = 0; l.repScores = []; l.logOffset = 0; l.zone = { x: 0, z: 0, r: .3 }; l.baseClip = 'squat'; l.logDown = false; l.lost = false; l.err = 0; l.errT = 0;\n      l.doll.rig.scrub('squat', 0, 0);\n      const log = cyl(.12, .12, 2, '#9C7048'); log.rotation.z = Math.PI / 2; log.position.y = 1.3; l.doll.lean.add(log); l.log = log; for (const s of [-1, 1]) { const end = sphere(.125, '#D9B98A', .2, 1, 1); log.add(at(end, 0, s * 1, 0)); end.rotation.z = 1.57; }\n    }\n    this.period = 5; this.repT = 0; this.gag = false;\n  }\n  ribbon(t) { const p = this.period * T.repTempo, a = (t % p) / p * 5; if (a < 2) return a / 2; if (a < 2.5) return 1; if (a < 4.5) return 1 - (a - 2.5) / 2; return 0; }\n  halfWidth() { const f = Math.min(1, this.repN() / Math.max(1, this.nReps - 1)); return Math.max(.05, lerp(.16, .1, f) - this.tier.tight); }\n  repN() { return Math.floor(this.playT / (this.period * T.repTempo)); }\n  fixedPlay(dt) {\n    const prog = this.playT / (this.nReps * this.period * T.repTempo), rib = this.ribbon(this.playT), hw = this.halfWidth(), rn = this.repN();\n    if (rn !== this.lastRn) {\n      if (this.lastRn !== undefined) { for (const l of this.lanes) this.closeRep(l); this.game.audio.sfx('tick'); if (this.barkT <= 0) this.bark('bolster', rn > this.nReps * .6 ? 'tired' : 'rep'); }\n      this.lastRn = rn;\n      if (rn === this.nReps - 2 && !this.attract) { this.game.barkNow('bolster', 'last'); this.walrus.rig.play('clap', .2); }\n    }\n    if (rn >= this.nReps) { this.finish(); return; }\n    this.rib = rib; this.hw = hw;\n    for (const l of this.lanes) {\n      l.sway = lerp(this.tier.sway[0], this.tier.sway[1], prog); l.tremor = lerp(this.tier.tremor[0], this.tier.tremor[1], prog);\n      if (l.kind === 'ghost' || !l.bal) continue;\n      const I = l.in; let want;\n      if (I.dev === 'kbm' || (l.ctrl && l.ctrl.device === 'kbm')) { const both = I.lf > .5 && I.rf > .5; l.kd = Math.max(0, Math.min(1, (l.kd || 0) + (both ? dt : -dt) / (2 * T.repTempo))); want = l.kd; }\n      else want = (I.lf + I.rf) / 2;\n      const shake = lerp(.015, .07, prog) * Math.sin(this.t * 31 + l.id);\n      l.depth += (want + shake - l.depth) * (1 - Math.exp(-14 * dt));\n      l.ticks++; if (Math.abs(l.depth - rib) <= hw) l.inBand++;\n      if (Math.hypot(l.bal.cobX, l.bal.cobZ) <= l.zone.r && !l.fallen) l.inZone++;\n      if (!l.logDown && !l.fallen) {\n        const leanDeg = l.bal.leanX * 57.3;\n        if (Math.abs(leanDeg) > 6) l.logOffset += .05 * (Math.abs(leanDeg) - 6) * Math.sign(leanDeg) * dt;\n        else l.logOffset += -Math.sign(l.logOffset) * Math.min(Math.abs(l.logOffset), .02 * dt);\n        l.extraX += .06 * 9.81 * l.logOffset;\n        if (Math.abs(l.logOffset) >= .5) this.dropLog(l);\n      }\n    }\n  }\n  closeRep(l) {\n    if (l.kind === 'ghost' || !l.bal) return;\n    const s = l.ticks ? (l.inBand / l.ticks) * (.5 + .5 * (l.inZone / l.ticks)) : 0;\n    const bonus = l.repScores.length >= this.nReps - 2; l.repScores.push(l.lost ? 0 : s); if (bonus) l.repScores.push(l.lost ? 0 : s);\n    l.lost = false; l.inBand = 0; l.inZone = 0; l.ticks = 0; l.rep++;\n    l.form = 100 * l.repScores.reduce((a, b) => a + b, 0) / Math.max(1, l.repScores.length);\n    if (l.kind === 'local') this.game.audio.sfx('foot', { high: s > .6 });\n    if (s > .75) this.game.comic(s > .9 ? 'NICE!' : 'REP!', l.x, 2.3, 0, '#FFD23F', .55, .6);\n    this.game.rumble(l, .1 + .3 * this.repN() / this.nReps, .1);\n  }\n  dropLog(l) {\n    l.logDown = true; l.lost = true; l.log.visible = false; const x = l.x + Math.sign(l.logOffset) * .7;\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, 1.3, 0).setAngvel({ x: 0, y: 0, z: Math.sign(l.logOffset) * -2 }));\n    this.world.createCollider(RAPIER.ColliderDesc.cylinder(1, .12).setRotation({ x: 0, y: 0, z: .7071, w: .7071 }).setMass(.3).setCollisionGroups(G_PROP(l.id)), body);\n    const m = cyl(.12, .12, 2, '#9C7048'); m.rotation.z = 0; const holder = new THREE.Group(); holder.add(m); m.rotation.z = Math.PI / 2; this.group.add(holder);\n    this.falling.push({ body, m: holder, l, left: 1.4 });\n    this.game.audio.sfx('clack', { f: 300 }); this.walrus.rig.play('catch', .1, 'bounce'); if (l.kind === 'local') this.game.barkNow('bolster', 'log');\n  }\n  postPlay(dt) {\n    for (let i = this.falling.length - 1; i >= 0; i--) {\n      const f = this.falling[i]; f.left -= dt; const p = f.body.translation(), q = f.body.rotation(); f.m.position.set(p.x, p.y, p.z); f.m.quaternion.set(q.x, q.y, q.z, q.w);\n      if (f.left <= 0) { this.group.remove(f.m); this.world.removeRigidBody(f.body); this.falling.splice(i, 1); f.l.logOffset = 0; f.l.logDown = false; f.l.log.visible = true; this.game.audio.sfx('spring'); }\n    }\n  }\n  frameLane(l) {\n    if (l.kind === 'ghost') return;\n    if (!l.fallen) { l.doll.rig.scrub('squat', Math.max(0, Math.min(1, l.depth)), 0); l.doll.inner.position.y = -Math.max(0, Math.min(1, l.depth)) * .32; }\n    if (l.log) { l.log.position.y = 1.3 - l.depth * .32; l.log.position.x = l.logOffset; }\n  }\n  onFall(l) { if (l.log) l.log.visible = false; l.lost = true; l.doll.inner.position.y = 0; }\n  onRecover(l) { if (l.log && !l.logDown) l.log.visible = true; l.logOffset = 0; }\n  frame2() {\n    const l = this.localLanes()[0] || this.lanes[0];\n    if (!l) return; this.setNum(Math.min(this.repN() + 1, this.nReps), 'Rep'); this.setTime(null);\n    if (this.bar && this.rib != null) { const h = this.hw * 100; this.band.style.top = `${(this.rib * 100 - h)}%`; this.band.style.height = `${h * 2}%`; this.mark.style.top = `${l.depth * 100}%`; }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const [x, z] = br.correct(dt, l, 0, 0, true);\n    l.errT -= dt; if (l.errT <= 0) { l.errT = .4; l.err = br.gauss() * br.s.trackErr; }\n    const d = Math.max(0, Math.min(1, this.ribbon(t + .06 - br.s.delay * .3) + l.err));\n    return { x, z, lf: d, rf: d };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.form), label: 'Form', stats: `${l.rep} reps. Floor Exercises: ${l.falls}` }; }\n  forceThing() { for (const l of this.lanes) if (l.bal && !l.logDown) { l.logOffset = .5; this.dropLog(l); } }\n  forceFinish() { for (const l of this.lanes) if (l.ticks > 30) this.closeRep(l); this.finish(); }\n}\nE\necho ok","description":"Write Poses, Cairn, Still Water and Log Reps events"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14482,"cache_read_input_tokens":216505,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14482},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c3cb271-fa3a-4db7-9b9c-5b70edc7a0c6","uuid":"9cefb131-b2ad-4833-b571-1bd82eb69437","timestamp":"2026-11-05T12:18:40.543Z","request_id":"req_011CgjmEPrf21VSjCtaRjkH7","wire_tool_inputs":{"toolu_019ocbbu1Fu9GqNsU8wKqqvQ":{"command":"python3 -I - <<'E'\ns=open('src/events/base.js').read()\ns=s.replace(\"\"\"    this.world = makeWorld({ ...this.worldOpts(), gravity: T.gravity });\n    this.ground = addGroundPlane(this.world, this.groundY());\n    this.game.scene.add(this.group);\"\"\",\"\"\"    this.makeEventWorld();\n    this.game.scene.add(this.group);\"\"\")\ns=s.replace(\"\"\"  buildSet() {} start() {}\"\"\",\"\"\"  makeEventWorld() { this.world = makeWorld({ ...this.worldOpts(), gravity: T.gravity }); this.ground = addGroundPlane(this.world, this.groundY()); }\n  buildSet() {} start() {}\"\"\")\ns=s.replace(\"\"\"if (this.god) b.reset(); else this.fall(lane);\"\"\",\"\"\"if (this.god || this.noFall) b.reset(); else this.fall(lane);\"\"\")\ns=s.replace(\"\"\"    this.game.scene.remove(this.group);\n    this.group.traverse\"\"\",\"\"\"    this.group.removeFromParent();\n    this.group.traverse\"\"\")\nopen('src/events/base.js','w').write(s)\ns=open('src/events/fruitHat.js').read()\ns=s.replace(\"const dhat = Math.hypot(p.x - (l.x + (l.bal?.cobX || 0) * .35), p.z - (l.z + (l.bal?.cobZ || 0) * .35));\",\"const dhat = Math.hypot(p.x - (l.x + Math.sin(l.bal?.leanX || 0) * 1.5), p.z - (l.z + Math.sin(l.bal?.leanZ || 0) * 1.5));\")\ns=s.replace(\"gx = (best.lx - l.x) / .36; gz = (best.lz - l.z) / .36;\",\"gx = (best.lx - l.x) / .46; gz = (best.lz - l.z) / .46;\")\nopen('src/events/fruitHat.js','w').write(s)\nE\ncat > src/events/poses.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, lerp } from './base.js';\nimport { POSES } from '../data/poses.js';\nimport { T } from '../core/tuning.js';\nimport { deck, box, at, cyl, sphere, lantern, bunting, palm, torus, toon, flat, cached } from '../art/props.js';\nimport { makeHeron } from '../art/heron.js';\nimport { GUESTS } from '../data/names.js';\nexport class Poses extends EventBase {\n  static id = 'poses'; static title = 'Poses'; static discipline = 'Stillness'; static instructor = 'stillwater'; static place = 'The Sun Deck'; static music = 'stillness'; static couch = true; static session = true; static diagram = 'ring';\n  static sentence = 'Follow the green ring across the disc, then hold still while it shrinks.';\n  static can = 'You can breathe with the ring for a steadier body.'; static cant = \"Your feet don't matter here.\";\n  static verbs = [['lean', 'Lean'], ['breath', 'Breathe'], ['flail', 'Flail']];\n  static tiers = [\n    { poses: 3, hold: 8, ringEnd: .16, sway: [.08, .22], tremor: [.08, .2] },\n    { poses: 4, hold: 10, ringEnd: .13, sway: [.12, .3], tremor: [.1, .3] },\n    { poses: 5, hold: 12, ringEnd: .1, sway: [.15, .38], tremor: [.15, .4] },\n  ];\n  static sessionConfig = { tier: 0, hold: 13.6, poses: 3 };\n  balanceOpts() { return { maxLean: 14 }; }\n  buildSet() {\n    this.usesBreath = true; this.faceYaw = 0; this.nPoses = this.opts.poses || this.tier.poses; this.hold = this.opts.hold || this.tier.hold;\n    const n = this.opts.laneCount || 1; const R = 5.4 + n * 1.3;\n    this.add(deck(R, '#C89B6A'), 0, 0, -.5);\n    for (let i = 0; i < 16; i++) { const a = i / 16 * 6.283; if (Math.abs(Math.sin(a)) < .3 && Math.cos(a) > 0) continue; this.add(at(cyl(.05, .06, 1, '#E9D3AE'), Math.cos(a) * (R - .15), .5, Math.sin(a) * (R - .15) - .5)); }\n    const rail = torus(R - .15, .06, '#E9D3AE'); rail.rotation.x = Math.PI / 2; this.add(rail, 0, 1, -.5);\n    this.add(palm(1.5), -R - 2, -.5, -3); this.add(palm(1.2), R + 2.4, -.5, -4); this.add(lantern(), -R + .6, 0, -2.5); this.add(lantern(), R - .6, 0, -2.5);\n    this.add(bunting(-R + .6, 2.1, -2.5, R - .6, 2.1, -2.5, 14));\n    this.heron = makeHeron(); this.heron.group.scale.setScalar(1.1); this.add(this.heron.group, -2.4 - (n - 1) * 1.6, 0, -1.7); this.heron.group.rotation.y = .5; this.anim.push(this.heron);\n    this.crowd([{ ...GUESTS[0], x: 3.4 + n, z: -3.1, yaw: -.5, clip: 'breathe' }, { ...GUESTS[3], x: 2 + n, z: -3.7, yaw: -.2, clip: 'breathe' }]);\n    // A soft floor ring under the doll shows the target too, for the room.\n    this.floorRings = [];\n    this.order = []; const pool = [...POSES]; for (let i = 0; i < this.nPoses; i++) this.order.push(pool.splice(Math.floor(this.r() * pool.length), 1)[0] || POSES[i]);\n    this.stage = 'glide'; this.st = 0; this.poseI = 0;\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(6.8, spread); this.game.rig.set(0, 1.25, d, 0, 1, 0, snap); }\n  start() { for (const l of this.lanes) { l.earned = 0; l.maxEarn = 0; l.zone = { x: 0, z: 0, r: .3 }; l.baseClip = 'idle'; if (l.kind !== 'ghost') { const ring = new THREE.Mesh(cached('fr', () => new THREE.RingGeometry(.9, 1, 40)), flat('#2E8B57')); ring.rotation.x = -Math.PI / 2; ring.position.set(l.x, .03, 0); this.group.add(ring); l.floorRing = ring; } } this.announce(); }\n  announce() { const p = this.order[this.poseI]; if (!p) return; this.setMsg(p.name); for (const l of this.lanes) { l.baseClip = p.clip; if (!l.fallen) l.doll.rig.play(p.clip, .6); } this.heron.rig.play('demo', .4); if (!this.attract) this.game.barkNow('stillwater', 'pose', { pose: p.name }); }\n  fixedPlay(dt) {\n    this.st += dt; const p = this.order[this.poseI];\n    if (this.stage === 'glide') {\n      const a = Math.min(1, this.st / 3), s = a * a * (3 - 2 * a);\n      for (const l of this.lanes) { l.zone.x = (l.fromX ?? 0) + (p.x - (l.fromX ?? 0)) * s; l.zone.z = (l.fromZ ?? 0) + (p.z - (l.fromZ ?? 0)) * s; l.zone.r = .3; l.sway = this.tier.sway[0]; l.tremor = this.tier.tremor[0]; }\n      if (this.st >= 3) { this.stage = 'hold'; this.st = 0; this.heron.rig.play('stand', .5); }\n    } else {\n      const a = Math.min(1, this.st / this.hold);\n      const r = lerp(.3, this.tier.ringEnd * T.ringEnd, a);\n      for (const l of this.lanes) {\n        l.zone.r = r; l.sway = lerp(this.tier.sway[0], this.tier.sway[1], a); l.tremor = lerp(this.tier.tremor[0], this.tier.tremor[1], a);\n        if (l.kind === 'ghost' || !l.bal) continue;\n        const earn = .3 / r; l.maxEarn += earn * dt;\n        if (!l.fallen && Math.hypot(l.bal.cobX - l.zone.x, l.bal.cobZ - l.zone.z) <= r) l.earned += earn * dt * (l.breathSync ? 1.25 : 1);\n        l.form = Math.min(100, 100 * l.earned / Math.max(.001, this.maxTotal()));\n      }\n      if (this.st >= this.hold) {\n        this.poseI++; this.st = 0; this.game.audio.sfx('bell');\n        if (this.poseI >= this.nPoses) { this.finish(); return; }\n        const q = this.order[this.poseI - 1]; for (const l of this.lanes) { l.fromX = q.x; l.fromZ = q.z; } this.stage = 'glide'; this.announce();\n      }\n    }\n  }\n  maxTotal() { // integral of .3/r over a hold, exact share of the maximum over the whole class so far\n    const done = this.poseI + (this.stage === 'hold' ? Math.min(1, this.st / this.hold) : 0);\n    const R0 = .3, R1 = this.tier.ringEnd * T.ringEnd; const full = this.hold * .3 * Math.log(R0 / R1) / (R0 - R1);\n    return Math.max(.001, full * done);\n  }\n  onFlail(l) { l.earned = Math.max(0, l.earned - .4); if (l.kind === 'local') this.bark('stillwater', 'flail'); }\n  frameLane(l) { if (l.floorRing && l.bal) { const r = l.zone.r * 1.1 + .05; l.floorRing.scale.setScalar(r); l.floorRing.position.x = l.x + l.zone.x * .9; l.floorRing.position.z = l.zone.z * .9; } }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (l) this.setNum(Math.round(l.form), 'Form'); this.setTime(this.stage === 'hold' ? this.hold - this.st : 3 - this.st); if (this.barkT <= 0 && l && l.kind === 'local') this.bark('stillwater', 'calm'); }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l);\n    const mode = this.opts.botMode;\n    const breath = mode === 'nobreath' || mode === 'park' ? false : (this.t % 8) < 4;\n    if (mode === 'park') return { x: l.zone.x, z: l.zone.z, breath };\n    const [x, z] = br.correct(dt, l, l.zone.x, l.zone.z);\n    return { x, z, breath };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.form), label: 'Form', stats: `${this.poseI} poses held. Floor Exercises: ${l.falls}` }; }\n  forceThing() { this.forceGust(2); }\n}\nE\ncat > src/events/cairn.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, lerp } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { sphere, box, at, cyl, rock, stoneStack, palm, mesh, tree } from '../art/props.js';\nimport { makeHeron } from '../art/heron.js';\nconst NORMAL = [[.26, .09], [.24, .085], [.22, .08], [.2, .078], [.18, .074], [.165, .07], [.15, .066], [.14, .062], [.125, .058], [.11, .054]];\nconst WIDE = [[.28, .09], [.27, .085], [.26, .08], [.25, .078], [.24, .074], [.23, .07], [.22, .066], [.21, .062], [.2, .058], [.19, .054]];\nconst COLS = ['#A69A8C', '#BDB2A2', '#8F8578', '#C7BBA9', '#9C9184', '#B3A794'];\nexport class Cairn extends EventBase {\n  static id = 'cairn'; static title = 'The Cairn'; static discipline = 'Stillness'; static instructor = 'stillwater'; static place = 'Quarry Terrace'; static music = 'stillness'; static couch = true; static session = true; static diagram = 'stack';\n  static sentence = 'Hold the slab overhead. Ms. Stillwater adds stones. Keep it level as the stack comes alive.';\n  static can = 'You can breathe with the ring, and it helps enormously.'; static cant = \"You can't catch a stone once it has left.\";\n  static verbs = [['lean', 'Lean'], ['breath', 'Breathe'], ['flail', 'Flail']];\n  static tiers = [\n    { stones: 6, every: 5.5, hold: 8, sway: [.1, .3], tremor: [.05, .15], offset: .015, set: NORMAL, par: 750 },\n    { stones: 8, every: 5, hold: 10, sway: [.15, .4], tremor: [.08, .2], offset: .02, set: NORMAL, par: 980 },\n    { stones: 10, every: 4.5, hold: 10, sway: [.15, .4], tremor: [.08, .2], offset: .02, set: WIDE, par: 1210 },\n  ];\n  static sessionConfig = { tier: 0, every: 6.5, hold: 11 };\n  balanceOpts() { return { margin: .8, ankleMax: 6 }; }\n  worldOpts() { return { iterations: 10 }; }\n  buildSet() {\n    this.usesBreath = true; this.camYaw = .42; this.faceYaw = .42;\n    this.nStones = this.tier.stones; this.every = this.opts.every || this.tier.every; this.holdEnd = this.opts.hold || this.tier.hold;\n    const floor = cyl(10, 10.5, 2.4, '#D8CDBB', 28); this.add(floor, 0, -1.2, 0);\n    for (let i = 0; i < 9; i++) { const a = i * 2.4 + 1, d = 6 + (i % 3) * 1.1; this.add(rock(.4 + (i % 3) * .28), Math.cos(a) * d, .15, Math.sin(a) * d - 2); }\n    this.add(stoneStack(4), -5.5, 0, -3); this.add(stoneStack(3), 4.8, 0, -4.6); this.add(palm(1.2), -7, 0, -5);\n    const cliff = cyl(7, 9, 7, '#C7BBA9', 12); this.add(cliff, 3, -3.5, -14);\n    this.heron = makeHeron(); this.heron.group.scale.setScalar(1.25); this.add(this.heron.group, -2.1 - (this.opts.laneCount || 1) * .9, 0, -.8); this.heron.group.rotation.y = 1.1; this.anim.push(this.heron);\n    this.nextT = 1.5; this.placed = 0; this.ended = false;\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(7.6, spread); const a = .42; this.game.rig.set(-Math.sin(a) * d * -1 * -1, 1.9, Math.cos(a) * d, 0, 1.45, 0, snap); }\n  start() {\n    for (const l of this.lanes) {\n      l.stones = []; l.baseClip = 'holdSlab'; l.doll.rig.play('holdSlab', 0); l.distSum = 0; l.distN = 0; l.dropped = 0;\n      if (l.kind === 'ghost') continue;\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(.55, .03, .55).setTranslation(0, .95, 0).setMass(.05).setFriction(1).setCollisionGroups(G_PROP(l.id)), l.bal.body);\n      const slab = box(1.1, .06, 1.1, '#8F8578'); slab.position.y = 1.7; l.doll.lean.add(slab); l.slab = slab; l.sway = this.tier.sway[0]; l.tremor = this.tier.tremor[0];\n    }\n  }\n  bodyPoint(l, y) { const b = l.bal.body.translation(), q = l.bal.body.rotation(); const v = new THREE.Vector3(0, y, 0).applyQuaternion(new THREE.Quaternion(q.x, q.y, q.z, q.w)); return { x: b.x + v.x, y: b.y + v.y, z: b.z + v.z }; }\n  dropStone(l, idx) {\n    if (l.fallen) return;\n    const [r, hh] = this.tier.set[idx % this.tier.set.length];\n    const top = l.stones.length ? l.stones[l.stones.length - 1] : null;\n    let p; const off = this.tier.offset;\n    if (top && !top.gone) { const tp = top.body.translation(); p = { x: tp.x + (this.r() - .5) * 2 * off, y: tp.y + top.hh + hh + .012, z: tp.z + (this.r() - .5) * 2 * off }; }\n    else { const s = this.bodyPoint(l, .98); p = { x: s.x + (this.r() - .5) * 2 * off, y: s.y + hh + .012, z: s.z + (this.r() - .5) * 2 * off }; }\n    const v = l.bal.body.linvel();\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(p.x, p.y, p.z).setRotation(l.bal.body.rotation()).setLinvel(v.x * .5, 0, v.z * .5).setLinearDamping(.1).setAngularDamping(.6).setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(r * .8, hh, r * .8).setMass(.02 * T.stoneMass).setFriction(.95).setRestitution(0).setCollisionGroups(G_PROP(l.id)), body);\n    const m = sphere(r, COLS[idx % COLS.length], 1, hh / r * 1.25, .92); this.group.add(m);\n    l.stones.push({ body, m, r, hh, gone: false });\n    this.game.audio.sfx('clack', { f: 500 });\n  }\n  fixedPlay(dt) {\n    const prog = Math.min(1, this.playT / (this.nStones * this.every + this.holdEnd));\n    const interval = this.every * T.stoneInterval;\n    for (const l of this.lanes) { l.sway = lerp(this.tier.sway[0], this.tier.sway[1], prog); l.tremor = lerp(this.tier.tremor[0], this.tier.tremor[1], prog); }\n    if (this.placed < this.nStones && this.playT >= this.nextT) {\n      for (const l of this.lanes) if (l.kind !== 'ghost') this.dropStone(l, this.placed);\n      this.placed++; this.nextT += interval; this.heron.rig.play('peck', .2, 'stand');\n      if (this.barkT <= 0 && !this.attract) this.bark('stillwater', 'stone');\n      if (this.placed === this.nStones) this.holdStart = this.playT;\n    }\n    for (const l of this.lanes) { if (l.kind === 'ghost' || !l.bal || l.fallen) continue; l.distSum += Math.hypot(l.bal.cobX, l.bal.cobZ); l.distN++; }\n    if (this.placed >= this.nStones && this.playT >= this.holdStart + this.holdEnd) { this.tally(); this.finish(); }\n  }\n  count(l) { if (l.fallen || !l.bal) return 0; const s = this.bodyPoint(l, .95); let n = 0; for (const st of l.stones) { if (st.gone) continue; const p = st.body.translation(); if (p.y > s.y - .1 && Math.hypot(p.x - s.x, p.z - s.z) < 1) n++; } return n; }\n  postPlay() {\n    for (const l of this.lanes) {\n      if (l.kind === 'ghost') continue;\n      for (const st of l.stones) { if (st.gone) continue; const p = st.body.translation(), q = st.body.rotation(); st.m.position.set(p.x, p.y, p.z); st.m.quaternion.set(q.x, q.y, q.z, q.w); if (!st.fellOff && l.bal && p.y < .5) { st.fellOff = true; l.dropped++; this.game.audio.sfx('clack', { f: 420 }); this.game.comic('CLONK', p.x, .8, p.z, '#FFF8EE', .55, .7); if (l.kind === 'local') this.bark('stillwater', 'stoneDrop'); } }\n      l.onSlab = this.count(l);\n      const steady = l.distN ? Math.max(0, 1 - (l.distSum / l.distN) / .5) : 0;\n      l.score = 100 * l.onSlab + 10 * l.onSlab + 50 * steady;\n      l.form = Math.min(100, 100 * l.score / this.tier.par);\n    }\n  }\n  tally() {}\n  frameLane() {}\n  onFall(l) { if (l.slab) l.slab.visible = false; }\n  onRecover(l) { if (l.slab) l.slab.visible = true; for (const st of l.stones) if (!st.fellOff) { st.fellOff = true; l.dropped++; } }\n  onFlail(l) { if (l.kind === 'local') this.bark('stillwater', 'flail'); }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (l) this.setNum(l.onSlab ?? 0, 'Stones up'); this.setTime(this.placed < this.nStones ? this.nextT - this.playT : this.holdStart + this.holdEnd - this.playT); }\n  botInput(i, t, skill, dt) { const l = this.lanes[i], br = this.botBrain(l); const [x, z] = br.correct(dt, l, 0, 0, true); return { x, z, breath: this.opts.botMode === 'nobreath' ? false : (this.t % 8) < 4 }; }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: l.onSlab ?? 0, label: 'Stones standing', stats: `${l.dropped} dropped. Floor Exercises: ${l.falls}` }; }\n  forceThing() { for (const l of this.lanes) if (l.kind !== 'ghost') this.dropStone(l, this.placed % this.tier.set.length); }\n}\nE\ncat > src/events/stillWater.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { Fn, uniform, length, sin, mix, positionWorld, time, vec2, smoothstep, vec3, step, float } from 'three/tsl';\nimport { EventBase, lerp } from './base.js';\nimport { sphere, box, at, cyl, cone, torus, palm, tree, mesh, cached, rock } from '../art/props.js';\nimport { makeHeron } from '../art/heron.js';\nimport { makeGull } from '../art/gull.js';\nimport { PU } from '../render/palette.js';\nconst CREATURES = ['Dragonfly', 'Frog', 'Koi', 'Turtle', 'Ms. Stillwater'];\nexport class StillWater extends EventBase {\n  static id = 'stillWater'; static title = 'Still Water'; static discipline = 'Stillness'; static instructor = 'stillwater'; static place = 'The Lily Pond'; static music = 'stillness'; static diagram = 'ring';\n  static sentence = 'Sit on a lily pad. Stay in the calm zone. Creatures come if you are boring enough.';\n  static can = 'You can stifle a sneeze with Flail, when you hear it coming.'; static cant = \"You can't fall in this one. You can only be disappointing.\";\n  static verbs = [['lean', 'Lean'], ['breath', 'Breathe'], ['flail', 'Stifle']];\n  static tiers = [{ zone: .15, sway: [.07, .18], tremor: .05, sneezes: 2 }, { zone: .12, sway: [.1, .22], tremor: .05, sneezes: 3 }, { zone: .1, sway: [.12, .26], tremor: .05, sneezes: 4 }];\n  buildSet() {\n    this.usesBreath = true; this.noFall = true; this.timeLimit = 60; this.flailOk = true;\n    this.uRipple = uniform(0);\n    const m = new THREE.MeshBasicNodeMaterial();\n    const rip = this.uRipple;\n    m.colorNode = Fn(() => {\n      const d = length(positionWorld.xz.sub(vec2(0, 0)));\n      const w = sin(d.mul(6).sub(time.mul(2.2))).mul(.5).add(.5);\n      const rings = step(float(.78).sub(rip.mul(.5)), w).mul(smoothstep(float(2).add(rip.mul(10)), float(.5), d).mul(rip.mul(.92).add(.08)));\n      const base = mix(vec3(.25, .55, .5), PU.seaHi, sin(positionWorld.x.mul(.8).add(time.mul(.2))).mul(sin(positionWorld.z.mul(.7))).mul(.14).add(.12));\n      return mix(base, vec3(1, 1, .95), rings);\n    })();\n    const pond = new THREE.Mesh(new THREE.CircleGeometry(9, 56), m); pond.rotation.x = -Math.PI / 2; pond.position.y = .02; this.add(pond);\n    const bank = torus(9.5, .9, '#9CC97A'); bank.rotation.x = Math.PI / 2; this.add(bank, 0, -.2, 0);\n    const pad = cyl(.95, .9, .07, '#4FB56A', 28); this.add(pad, 0, .03, 0); this.pad = pad;\n    for (let i = 0; i < 12; i++) { const a = i * 2.3 + .4, d = 3 + (i % 4) * 1.2; const p = cyl(.45 + (i % 3) * .15, .4, .04, i % 2 ? '#4FB56A' : '#67C47D', 16); this.add(p, Math.cos(a) * d, .04, Math.sin(a) * d); if (i % 3 === 0) { const f = sphere(.13, '#F4A6C0', 1, .7, 1); this.add(f, Math.cos(a) * d, .14, Math.sin(a) * d); } }\n    for (let i = 0; i < 8; i++) { const a = i * .8; this.add(at(cyl(.03, .04, 1.4, '#6FA84F', 6), Math.cos(a) * 9.1, .6, Math.sin(a) * 9.1 - .2)); }\n    this.add(palm(1.5), -9, 0, -7); this.add(tree(1.4), 8.6, 0, -6); this.add(rock(.8), 6, .1, -7);\n    // Creatures\n    const fly = new THREE.Group(); fly.add(at(sphere(.03, '#2FA7A0', 1, 1, 2.6), 0, 0, 0)); for (const s of [-1, 1]) { const w = sphere(.06, '#BDF2F2', 1.5, .1, .5); fly.add(at(w, s * .08, .01, 0)); } this.dragonfly = fly; fly.visible = false; this.add(fly);\n    const frog = new THREE.Group(); frog.add(sphere(.12, '#5BB04D', 1.1, .8, 1.2)); for (const s of [-1, 1]) frog.add(at(sphere(.04, '#1A1420'), s * .07, .09, .08)); this.frog = frog; frog.visible = false; this.add(frog);\n    const koi = new THREE.Group(); koi.add(sphere(.16, '#F58A2E', .6, .4, 1.5)); koi.add(at(sphere(.06, '#FFF8EE', 1, .6, 1), 0, .05, .08)); const tail = cone(.09, .2, '#F58A2E', 4); tail.rotation.x = -1.57; koi.add(at(tail, 0, 0, -.28)); this.koi = koi; koi.visible = false; this.add(koi);\n    const turtle = new THREE.Group(); turtle.add(sphere(.22, '#4F8A5B', 1, .55, 1.15)); turtle.add(at(sphere(.07, '#8DBA76'), 0, .02, .28)); this.turtle = turtle; turtle.visible = false; this.add(turtle, -1.4, .06, .4);\n    this.heron = makeHeron(); this.heron.group.scale.setScalar(1.1); this.add(this.heron.group, -5.5, .03, -3.5); this.heron.group.rotation.y = .9; this.anim.push(this.heron); this.heronT = 0;\n    this.sneezeAt = []; const n = this.tier.sneezes; for (let i = 0; i < n; i++) this.sneezeAt.push(10 + (i + .2 + this.r() * .6) * (46 / n)); this.sneezeState = null;\n    this.whisperT = 8; this.reached = 0;\n  }\n  placeCamera(snap) { this.game.rig.set(0, 5.4, 6.8, 0, .55, 0, snap); }\n  start() { for (const l of this.lanes) { l.calm = 0; l.inT = 0; l.totalT = 0; l.baseClip = 'sit'; l.doll.rig.play('sit', 0); l.customPose = true; l.zone = { x: 0, z: 0, r: this.tier.zone }; l.sway = this.tier.sway[0]; l.tremor = this.tier.tremor; l.peak = 0; l.motion = 0; } }\n  fixedPlay(dt) {\n    const a = this.playT / this.timeLimit; const l = this.lanes[0];\n    for (const la of this.lanes) la.sway = lerp(this.tier.sway[0], this.tier.sway[1], a);\n    if (this.sneezeAt.length && this.playT > this.sneezeAt[0] && !this.sneezeState) { this.sneezeAt.shift(); this.sneezeState = { left: 1.2 }; this.setMsg('Ah... ah...'); this.game.audio.speak('kevin', 'Ah... ah...'); for (const la of this.lanes) la.stifled = false; }\n    if (this.sneezeState) {\n      this.sneezeState.left -= dt;\n      for (const la of this.lanes) if (la.in.flail) la.stifled = true;\n      if (this.sneezeState.left <= 0) { this.setMsg(''); for (const la of this.lanes) if (!la.stifled && la.bal) { const ang = this.r() * 6.283; this.gust(la, Math.cos(ang) * 2.2, Math.sin(ang) * 2.2, .3); this.game.audio.sfx('sneeze'); this.game.comic('ACHOO!', la.x, 1.6, 0, '#FFF8EE', .9); } this.sneezeState = null; }\n    }\n    this.whisperT -= dt; if (this.whisperT <= 0 && !this.attract) { this.whisperT = 13; this.game.barkNow(this.r() < .5 ? 'stillwater' : 'stillwater', 'pond'); }\n    for (const la of this.lanes) {\n      if (!la.bal) continue;\n      const d = Math.hypot(la.bal.cobX, la.bal.cobZ), inz = d <= la.zone.r; la.totalT += dt; if (inz) la.inT += dt;\n      const was = la.calm; la.calm = Math.max(0, Math.min(1, la.calm + (inz ? dt / 30 : -dt / 8) * (la.breathSync ? 1.25 : 1))); la.peak = Math.max(la.peak, la.calm);\n      la.form = 100 * ((la.inT / Math.max(.01, this.timeLimit)) + la.calm) / 2;\n      if (la.kind === 'local') for (let k = 1; k <= 5; k++) { const th = k * .2; if (was < th && la.calm >= th) { this.game.audio.sfx('marble', { r: k * .1 }); this.game.ui.toast(`${CREATURES[k - 1]} has arrived.`); this.bark('stillwater', k === 5 ? 'pat' : 'creature'); } if (was >= th && la.calm < th && k === 1) { this.bark('stillwater', 'scatter'); } }\n      const w = la.bal.body.angvel(); la.motion += (Math.min(1, Math.hypot(w.x, w.z) * 1.2) - la.motion) * .03;\n    }\n    if (this.playT >= this.timeLimit) this.finish();\n  }\n  frameLane(l, dt) {\n    if (!l.bal) return;\n    const lx = l.bal.leanX * .55, lz = l.bal.leanZ * .55;\n    l.doll.group.position.set(0, .07, 0); l.doll.setLean(lx, lz);\n    l.doll.inner.position.y = -.27;\n    if (this.pad) this.pad.rotation.set(lz * .3, 0, -lx * .3);\n    if (l.id !== 0) return;\n    this.uRipple.value = l.motion;\n    const c = l.calm, t = this.t;\n    this.dragonfly.visible = c >= .2; if (c >= .2) { this.dragonfly.position.set(Math.sin(lx) * 1.3, 1.17, .3 + Math.sin(lz) * 1.3); this.dragonfly.rotation.y = Math.sin(t) * .3; }\n    this.frog.visible = c >= .4; if (c >= .4) this.frog.position.set(Math.sin(lx) * 1.4, 1.42, Math.sin(lz) * 1.4);\n    this.koi.visible = c >= .6; if (c >= .6) { this.koi.position.set(Math.cos(t * .6) * 2.2, .1, Math.sin(t * .6) * 2.2); this.koi.rotation.y = -t * .6; }\n    this.turtle.visible = c >= .8;\n    const wantH = c >= 1 ? 1 : 0; this.heronT += (wantH - this.heronT) * .01;\n    this.heron.group.position.set(lerp(-5.5, -1.1, this.heronT), .03, lerp(-3.5, -.6, this.heronT));\n    if (wantH && this.heronT > .9 && this.heron.rig.currentName !== 'pat') this.heron.rig.play('pat', .3);\n  }\n  frame2() { const l = this.localLanes()[0] || this.lanes[0]; if (l) { this.setNum(`${Math.round(l.calm * 100)}%`, 'Calm'); this.setTime(this.timeLimit - this.playT); } }\n  botInput(i, t, skill, dt) { const l = this.lanes[i], br = this.botBrain(l); const [x, z] = br.correct(dt, l, 0, 0); return { x, z, breath: (this.t % 8) < 4, flail: !!this.sneezeState && this.sneezeState.left < .9 && this.sneezeState.left > .8 }; }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: `${Math.round(l.peak * 100)}%`, label: 'Peak calm', stats: `Time in the zone: ${Math.round(100 * l.inT / Math.max(1, l.totalT))}%` }; }\n  forceThing() { this.sneezeState = { left: 1.2 }; this.setMsg('Ah... ah...'); for (const la of this.lanes) la.stifled = false; }\n}\nE\ncat > src/events/logReps.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, lerp } from './base.js';\nimport { RAPIER, G_PROP } from '../physics/world.js';\nimport { T } from '../core/tuning.js';\nimport { cyl, box, at, sphere, bench, crate, tree, bunting, cone, torus } from '../art/props.js';\nimport { makeWalrus } from '../art/walrus.js';\nimport { el, txt } from '../ui/ui.js';\nexport class LogReps extends EventBase {\n  static id = 'logReps'; static title = 'Log Reps'; static discipline = 'Strength'; static instructor = 'bolster'; static place = 'The Yard'; static music = 'strength'; static couch = true; static session = true; static diagram = 'feet';\n  static sentence = 'Squeeze both feet to sink with the ribbon, rise with it, and keep the dot in the ring.';\n  static can = 'You can let the log slide. Coach will catch it. That rep is lost.'; static cant = \"You can't rush: the ribbon decides the tempo.\";\n  static verbs = [['lean', 'Lean'], ['feet', 'Sink'], ['flail', 'Flail']];\n  static tiers = [\n    { reps: 6, sway: [.08, .22], tremor: [.04, .12], tight: 0 },\n    { reps: 9, sway: [.12, .3], tremor: [.06, .16], tight: .02 },\n    { reps: 12, sway: [.15, .38], tremor: [.08, .2], tight: .04 },\n  ];\n  static sessionConfig = { tier: 0, reps: 8 };\n  balanceOpts() { return { margin: .8, ankleMax: 6 }; }\n  buildSet() {\n    this.camYaw = -.3; this.faceYaw = -.3; this.nReps = (this.opts.reps || this.tier.reps) + 2;\n    const n = this.opts.laneCount || 1;\n    const ground = cyl(12, 12.3, 1, '#E3CFA3', 32); this.add(ground, 0, -.5, 0);\n    const mat = box(2.2 + (n - 1) * 3.2, .04, 2.2, '#D9694F'); this.add(mat, 0, .02, 0);\n    for (let i = 0; i < 6; i++) { const a = i / 6 * 3.1 + 3.3; const log = cyl(.16, .16, 1.9, '#9C7048'); log.rotation.z = 1.57; log.rotation.y = i; this.add(log, Math.cos(a) * 6.5, .17, Math.sin(a) * 6.5); }\n    this.add(bench(), -5, 0, -2); this.add(bench(), 5, 0, -3); this.add(crate(.8), 6, 0, -.5); this.add(tree(1.5, '#7CC568'), -7, 0, -5); this.add(tree(1.2, '#F4A6C0'), 7, 0, -6);\n    this.add(bunting(-6, 3, -4, 6, 3, -4, 16));\n    // A rack of dumb bells made of toy blocks.\n    const rack = box(2.4, .1, .5, '#7A5A3C'); this.add(rack, -3.2, .8, -3.6); this.add(at(box(.1, .8, .5, '#7A5A3C'), -4.3, .4, -3.6)); this.add(at(box(.1, .8, .5, '#7A5A3C'), -2.1, .4, -3.6));\n    this.walrus = makeWalrus(); this.add(this.walrus.group, -2.7 - (n - 1) * 1.6, 0, -.3); this.walrus.group.rotation.y = .75; this.anim.push(this.walrus);\n    this.falling = [];\n  }\n  placeCamera(snap) { const spread = this.lanes.length ? Math.abs(this.lanes[this.lanes.length - 1].x - this.lanes[0].x) : 0; const d = this.game.rig.fitDistance(6.5, spread); this.game.rig.set(Math.sin(-.3) * d, 1.8, Math.cos(.3) * d, 0, 1, 0, snap); }\n  setupHud2() { this.bar = el('div', 'vbar'); this.band = el('div', 'band'); this.mark = el('div', 'mark'); this.bar.append(this.band, this.mark); this.hudEl.appendChild(this.bar); }\n  start() {\n    for (const l of this.lanes) {\n      l.depth = 0; l.rep = 0; l.inBand = 0; l.inZone = 0; l.ticks = 0; l.repScores = []; l.logOffset = 0; l.zone = { x: 0, z: 0, r: .3 }; l.baseClip = 'squat'; l.logDown = false; l.lost = false; l.err = 0; l.errT = 0;\n      l.doll.rig.scrub('squat', 0, 0);\n      const log = cyl(.12, .12, 2, '#9C7048'); log.rotation.z = Math.PI / 2; log.position.y = 1.3; l.doll.lean.add(log); l.log = log; for (const s of [-1, 1]) { const end = sphere(.125, '#D9B98A', .2, 1, 1); log.add(at(end, 0, s * 1, 0)); end.rotation.z = 1.57; }\n    }\n    this.period = 5; this.repT = 0; this.gag = false;\n  }\n  ribbon(t) { const p = this.period * T.repTempo, a = (t % p) / p * 5; if (a < 2) return a / 2; if (a < 2.5) return 1; if (a < 4.5) return 1 - (a - 2.5) / 2; return 0; }\n  halfWidth() { const f = Math.min(1, this.repN() / Math.max(1, this.nReps - 1)); return Math.max(.05, lerp(.16, .1, f) - this.tier.tight); }\n  repN() { return Math.floor(this.playT / (this.period * T.repTempo)); }\n  fixedPlay(dt) {\n    const prog = this.playT / (this.nReps * this.period * T.repTempo), rib = this.ribbon(this.playT), hw = this.halfWidth(), rn = this.repN();\n    if (rn !== this.lastRn) {\n      if (this.lastRn !== undefined) { for (const l of this.lanes) this.closeRep(l); this.game.audio.sfx('tick'); if (this.barkT <= 0) this.bark('bolster', rn > this.nReps * .6 ? 'tired' : 'rep'); }\n      this.lastRn = rn;\n      if (rn === this.nReps - 2 && !this.attract) { this.game.barkNow('bolster', 'last'); this.walrus.rig.play('clap', .2); }\n    }\n    if (rn >= this.nReps) { this.finish(); return; }\n    this.rib = rib; this.hw = hw;\n    for (const l of this.lanes) {\n      l.sway = lerp(this.tier.sway[0], this.tier.sway[1], prog); l.tremor = lerp(this.tier.tremor[0], this.tier.tremor[1], prog);\n      if (l.kind === 'ghost' || !l.bal) continue;\n      const I = l.in; let want;\n      if (I.dev === 'kbm' || (l.ctrl && l.ctrl.device === 'kbm')) { const both = I.lf > .5 && I.rf > .5; l.kd = Math.max(0, Math.min(1, (l.kd || 0) + (both ? dt : -dt) / (2 * T.repTempo))); want = l.kd; }\n      else want = (I.lf + I.rf) / 2;\n      const shake = lerp(.015, .07, prog) * Math.sin(this.t * 31 + l.id);\n      l.depth += (want + shake - l.depth) * (1 - Math.exp(-14 * dt));\n      l.ticks++; if (Math.abs(l.depth - rib) <= hw) l.inBand++;\n      if (Math.hypot(l.bal.cobX, l.bal.cobZ) <= l.zone.r && !l.fallen) l.inZone++;\n      if (!l.logDown && !l.fallen) {\n        const leanDeg = l.bal.leanX * 57.3;\n        if (Math.abs(leanDeg) > 6) l.logOffset += .05 * (Math.abs(leanDeg) - 6) * Math.sign(leanDeg) * dt;\n        else l.logOffset += -Math.sign(l.logOffset) * Math.min(Math.abs(l.logOffset), .02 * dt);\n        l.extraX += .06 * 9.81 * l.logOffset;\n        if (Math.abs(l.logOffset) >= .5) this.dropLog(l);\n      }\n    }\n  }\n  closeRep(l) {\n    if (l.kind === 'ghost' || !l.bal) return;\n    const s = l.ticks ? (l.inBand / l.ticks) * (.5 + .5 * (l.inZone / l.ticks)) : 0;\n    const bonus = l.repScores.length >= this.nReps - 2; l.repScores.push(l.lost ? 0 : s); if (bonus) l.repScores.push(l.lost ? 0 : s);\n    l.lost = false; l.inBand = 0; l.inZone = 0; l.ticks = 0; l.rep++;\n    l.form = 100 * l.repScores.reduce((a, b) => a + b, 0) / Math.max(1, l.repScores.length);\n    if (l.kind === 'local') this.game.audio.sfx('foot', { high: s > .6 });\n    if (s > .75) this.game.comic(s > .9 ? 'NICE!' : 'REP!', l.x, 2.3, 0, '#FFD23F', .55, .6);\n    this.game.rumble(l, .1 + .3 * this.repN() / this.nReps, .1);\n  }\n  dropLog(l) {\n    l.logDown = true; l.lost = true; l.log.visible = false; const x = l.x + Math.sign(l.logOffset) * .7;\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, 1.3, 0).setAngvel({ x: 0, y: 0, z: Math.sign(l.logOffset) * -2 }));\n    this.world.createCollider(RAPIER.ColliderDesc.cylinder(1, .12).setRotation({ x: 0, y: 0, z: .7071, w: .7071 }).setMass(.3).setCollisionGroups(G_PROP(l.id)), body);\n    const m = cyl(.12, .12, 2, '#9C7048'); m.rotation.z = 0; const holder = new THREE.Group(); holder.add(m); m.rotation.z = Math.PI / 2; this.group.add(holder);\n    this.falling.push({ body, m: holder, l, left: 1.4 });\n    this.game.audio.sfx('clack', { f: 300 }); this.walrus.rig.play('catch', .1, 'bounce'); if (l.kind === 'local') this.game.barkNow('bolster', 'log');\n  }\n  postPlay(dt) {\n    for (let i = this.falling.length - 1; i >= 0; i--) {\n      const f = this.falling[i]; f.left -= dt; const p = f.body.translation(), q = f.body.rotation(); f.m.position.set(p.x, p.y, p.z); f.m.quaternion.set(q.x, q.y, q.z, q.w);\n      if (f.left <= 0) { this.group.remove(f.m); this.world.removeRigidBody(f.body); this.falling.splice(i, 1); f.l.logOffset = 0; f.l.logDown = false; f.l.log.visible = true; this.game.audio.sfx('spring'); }\n    }\n  }\n  frameLane(l) {\n    if (l.kind === 'ghost') return;\n    if (!l.fallen) { l.doll.rig.scrub('squat', Math.max(0, Math.min(1, l.depth)), 0); l.doll.inner.position.y = -Math.max(0, Math.min(1, l.depth)) * .32; }\n    if (l.log) { l.log.position.y = 1.3 - l.depth * .32; l.log.position.x = l.logOffset; }\n  }\n  onFall(l) { if (l.log) l.log.visible = false; l.lost = true; l.doll.inner.position.y = 0; }\n  onRecover(l) { if (l.log && !l.logDown) l.log.visible = true; l.logOffset = 0; }\n  frame2() {\n    const l = this.localLanes()[0] || this.lanes[0];\n    if (!l) return; this.setNum(Math.min(this.repN() + 1, this.nReps), 'Rep'); this.setTime(null);\n    if (this.bar && this.rib != null) { const h = this.hw * 100; this.band.style.top = `${(this.rib * 100 - h)}%`; this.band.style.height = `${h * 2}%`; this.mark.style.top = `${l.depth * 100}%`; }\n  }\n  botInput(i, t, skill, dt) {\n    const l = this.lanes[i], br = this.botBrain(l); const [x, z] = br.correct(dt, l, 0, 0, true);\n    l.errT -= dt; if (l.errT <= 0) { l.errT = .4; l.err = br.gauss() * br.s.trackErr; }\n    const d = Math.max(0, Math.min(1, this.ribbon(t + .06 - br.s.delay * .3) + l.err));\n    return { x, z, lf: d, rf: d };\n  }\n  laneResult(i) { const l = this.lanes[i]; return { form: l.form, big: Math.round(l.form), label: 'Form', stats: `${l.rep} reps. Floor Exercises: ${l.falls}` }; }\n  forceThing() { for (const l of this.lanes) if (l.bal && !l.logDown) { l.logOffset = .5; this.dropLog(l); } }\n  forceFinish() { for (const l of this.lanes) if (l.ticks > 30) this.closeRep(l); this.finish(); }\n}\nE\necho ok","description":"Write Poses, Cairn, Still Water and Log Reps events"}}}
