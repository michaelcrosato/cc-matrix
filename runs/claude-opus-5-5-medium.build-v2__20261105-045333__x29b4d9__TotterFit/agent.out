[0], P[1], P[0], P[2]], t1b = [P[1], P[2], P[4], P[1]];\nconst t2a = [P[1], P[3], P[2], P[5]], t2b = [P[3], P[5], P[2], P[4]];\nconst t3a = [P[7], P[3], P[8], P[5]], t3b = [P[9], P[7], P[6], P[8]];\nexport const CHARTS = {\n  tier1: { bpm: 104, bars: [...section(4, [E]), ...section(8, t1a), ...section(8, t1b), ...section(8, [P[1], P[0], P[2], P[1]]), ...section(4, [P[4]]), ...section(8, [P[2], P[4], P[1], P[2]]), ...section(4, [E])] },\n  tier2: { bpm: 116, bars: [...section(4, [E]), ...section(8, t2a), ...section(8, t2b), ...section(8, [P[3], P[1], P[5], P[2]]), ...section(4, [P[4], P[6]]), ...section(8, [P[5], P[3], P[2], P[4]]), ...section(4, [E])] },\n  tier3: { bpm: 124, bars: [...section(4, [E]), ...section(8, t3a), ...section(8, t3b), ...section(8, [P[8], P[9], P[5], P[7]]), ...section(4, [P[4], P[6]]), ...section(8, [P[9], P[8], P[7], P[6]]), ...section(4, [E])] },\n  session: { bpm: 116, bars: [...section(2, [E]), ...section(10, [P[1], P[2], P[3], P[1]]), ...section(4, [P[4], P[6]]), ...section(10, [P[2], P[3], P[1], P[5]])].slice(0, 24) },\n  finale: { bpm: 96, bars: [E, P[0], P[1], P[4], P[2], P[4], P[1], P[6]] },\n};\nexport function chartNotes(chart) {\n  const beat = 60 / chart.bpm, cell = beat / 2, notes = [];\n  chart.bars.forEach((bar, b) => { for (let c = 0; c < 8; c++) { const ch = bar[c]; if (ch && ch !== '.') notes.push({ t: (b * 8 + c) * cell, k: ch }); } });\n  return { notes, beat, cell, length: chart.bars.length * 8 * cell };\n}\nE\ncat > data/names.js <<'E'\nconst FIRST = ['Gentle', 'Patient', 'Earnest', 'Retired', 'Punctual', 'Modest', 'Tentative', 'Sensible', 'Young', 'Quiet', 'Hopeful', 'Reasonable', 'Upright', 'Sturdy', 'Careful', 'Former'];\nconst LAST = ['Margaret', 'Kevin', 'Sandra', 'Paul', 'Gerald', 'Doreen', 'Clive', 'Maureen', 'Howard', 'Yvonne', 'Trevor', 'Bernice', 'Nigel', 'Agnes', 'Desmond', 'Priya', 'Hiro', 'Marisol', 'Tunde', 'Ingrid'];\nexport function genName(r) { return `${FIRST[Math.floor(r() * FIRST.length)]} ${LAST[Math.floor(r() * LAST.length)]}`; }\nexport const GUESTS = [\n  { name: 'Gentle Margaret', paint: '#E77BB0', hat: 'perm', height: .96, width: 1.02, skin: '#F2D3A8' },\n  { name: 'Retired Kevin', paint: '#2FA7A0', hat: 'bucket', height: 1.02, width: 1.08, skin: '#E2B48A' },\n  { name: 'Sandra', paint: '#8E6BD8', hat: 'beret', height: .98, width: .96, skin: '#C98F62' },\n  { name: 'Other Sandra', paint: '#8E6BD8', hat: 'beret', height: .98, width: .96, skin: '#F7E0C2' },\n  { name: 'Unsteady Paul', paint: '#F58A2E', hat: 'visor', height: 1.06, width: .92, skin: '#9A6A45' },\n  { name: 'Young Gerald', paint: '#22C55E', hat: 'wizard', height: .9, width: .96, skin: '#F7E0C2' },\n];\nE\ncat > data/unlocks.js <<'E'\n// Marble thresholds. Each unlock is a hat or paint in The Mirror.\nexport const UNLOCKS = [\n  { at: 6, kind: 'hat', id: 'visor', name: 'A Sensible Visor' },\n  { at: 14, kind: 'paint', id: '#8E6BD8', name: 'Quiet Purple' },\n  { at: 24, kind: 'hat', id: 'beret', name: 'A Thoughtful Beret' },\n  { at: 36, kind: 'hat', id: 'bucket', name: 'A Bucket, For Your Head' },\n  { at: 50, kind: 'hat', id: 'perm', name: 'The Perm' },\n  { at: 60, kind: 'hat', id: 'crown', name: 'A Very Small Crown' },\n];\nexport const START_PAINTS = ['#E8443A', '#3B82F6', '#22C55E', '#F5B700', '#E77BB0', '#2FA7A0'];\nexport const BONUS_HAT = { hat: 'wizard', needs: 'levelled', name: 'A Wizard Hat, For Finishing' };\nE\ncat > data/programme.js <<'E'\n// Day table. Build from the event registry: a cut event is skipped and everything still works.\nexport const DAYS = [\n  { day: 1, name: 'Arrival', tests: ['standStill', 'leanMatch', 'stepTime'], classes: ['poses', 'fruitHat'], palette: ['dawn', 'noon', 'golden'], teach: 'Lean, flail, breath, the jar' },\n  { day: 2, name: 'The Second Day, Which Is Harder', tests: ['standStill', 'leanMatch', 'quickLean'], classes: ['logReps', 'stepClass', 'cairn'], palette: ['dawn', 'noon', 'golden', 'dusk'], teach: 'Feet, rhythm, stacking' },\n  { day: 3, na