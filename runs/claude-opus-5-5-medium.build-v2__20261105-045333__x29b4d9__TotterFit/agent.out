{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjnRF6VV5Dt8ACnrR83D","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014dCaRx5bnUgpbWC6tagzqd","name":"Bash","input":{"command":"cat > src/ui/screens/menus.js <<'E'\n// Menus. All follow the 10-foot rules: at most six choices, big tags, never a web form.\nimport { el, txt } from '../ui.js';\nimport { TITLE, SEATS } from '../../data/config.js';\nimport { EVENTS, FREE_ORDER } from '../../data/events.js';\nimport { TIER_NAMES, DAYS, MEDALS, TEST_NAMES } from '../../data/programme.js';\nimport { tierOpen, highestTier, medalFor, newProfile, liveDays } from '../../game/programme.js';\nimport { genName } from '../../data/names.js';\nimport { START_PAINTS, UNLOCKS } from '../../data/unlocks.js';\nimport { HATS } from '../../art/doll.js';\nimport { cosmetic } from '../../core/rng.js';\nimport { wipeSave } from '../../core/save.js';\nimport { openDev } from '../../game/devmode.js';\nimport { openGroupLobby } from '../../game/groupclass.js';\nimport { aboutPages } from '../../game/ending.js';\nimport { resetTuning, T } from '../../core/tuning.js';\nconst hdr = (e, t) => e.appendChild(txt('div', 'title-h', t));\nconst pager = (ui, e, page, n, set) => { if (n <= 1) return; const row = el('div', 'row'); row.append(ui.btn('‹', () => set(page - 1), { cls: `small ${page > 0 ? '' : 'locked'}` }), txt('div', 'gaugeTag', `Page ${page + 1} of ${n}`), ui.btn('›', () => set(page + 1), { cls: `small ${page < n - 1 ? '' : 'locked'}` })); e.appendChild(row); };\nexport function openTitle(g) {\n  const ui = g.ui;\n  if (ui.has('title')) return;\n  const touch = g.input.touchOnly && !g.input.padSeen && !g.touchCleared;\n  ui.open('title', (e) => {\n    const beam = el('div', 'beam'); const letters = el('div', 'letters'); const spans = []; for (const ch of TITLE) { const s = txt('span', 'l', ch === ' ' ? ' ' : ch); letters.appendChild(s); spans.push(s); } beam.appendChild(letters); e.appendChild(beam);\n    e.appendChild(el('div', 'grow'));\n    g.titleBeam = (dt) => { if (!beam.isConnected) { g.titleBeam = null; return; } const a = -g.island.tx * 57.3 * .9; beam.style.transform = `rotate(${a.toFixed(2)}deg)`; const t = performance.now() * .001; spans.forEach((s, i) => { s.style.transform = `translateX(${(a * 1.1 + Math.sin(t * .8 + i) * 2).toFixed(1)}px) translateY(${Math.abs(a) * .1}px) rotate(${(a * .6).toFixed(1)}deg)`; }); };\n    const wrap = el('div', 'titlepress');\n    if (touch) {\n      const col = el('div', 'col'); col.append(txt('div', 'warn', 'Controller or keyboard required'), ui.btn('Settings', () => openSettings(g), { def: true })); wrap.appendChild(col); e.appendChild(wrap); e.dataset.touch = '1';\n    } else { const b = ui.btn('Press', () => openMenu(g), { def: true, cls: 'wood' }); const gl = el('span'); gl.dataset.verb = 'use'; b.appendChild(gl); wrap.appendChild(b); e.appendChild(wrap); }\n  }, { tick: touch ? () => { if (g.input.padSeen || g.input.anyKey) { g.touchCleared = true; ui.closeAll(); openTitle(g); } } : undefined });\n  if (touch) { const once = (ev) => { if (ev.type === 'keydown') { removeEventListener('keydown', once); g.touchCleared = true; g.input.swallow(); ui.closeAll(); openTitle(g); } }; addEventListener('keydown', once); }\n}\nexport function openMenu(g) {\n  const ui = g.ui; const hasP = g.save.profiles.some(Boolean);\n  ui.open('menu', (e) => {\n    e.appendChild(el('div', 'grow'));\n    const c = el('div', 'col');\n    c.append(ui.btn(hasP ? 'Continue' : 'Programme', () => openWho(g, () => g.enterProgramme()), { def: true }), ui.btn('Group Class', () => openGroupLobby(g)), ui.btn('Free Play', () => openWho(g, () => openFreePlay(g))), ui.btn('Journal', () => openWho(g, () => openJournal(g))), ui.btn('Settings', () => openSettings(g)), ui.btn('About / Credits', () => openAbout(g)));\n    e.appendChild(c); e.appendChild(ui.bottom([['move', 'Move'], ['use', 'Choose'], ['back', 'Back']]));\n  }, { onBack: () => ui.close() });\n}\nexport function openWho(g, then) {\n  const ui = g.ui;\n  ui.open('who', (e, layer) => {\n    hdr(e, \"Who's here today?\"); const mats = el('div', 'mats');\n    g.save.profiles.forEach((p, i) => {\n      const m = ui.cardBtn('mat', () => { if (p) { g.save.current = i; g.persist(); ui.close(); then(); } else openNewProfile(g, i, then); }, (b) => { if (p) { const ch = el('div', 'chip'); ch.style.background = p.paint; b.append(ch, txt('div', '', p.name), txt('div', 'small', p.day > DAYS.length ? 'Maintenance' : `Day ${p.day}`), txt('div', 'small', `${p.marbles} marbles`)); } else { b.append(txt('div', '', 'Empty mat'), txt('div', 'small', 'Step on')); } });\n      if (i === Math.max(0, g.save.current)) m.dataset.default = '1'; mats.appendChild(m);\n    });\n    e.appendChild(mats); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['move', 'Move'], ['use', 'Step on'], ['back', 'Back']]));\n  }, { onBack: () => ui.close() });\n}\nexport function openNewProfile(g, slot, then) {\n  const ui = g.ui; let name = genName(cosmetic), paint = START_PAINTS[Math.floor(cosmetic() * 4)];\n  ui.open('newprofile', (e, layer) => {\n    hdr(e, 'A new guest'); const c = el('div', 'bigcard'); c.append(txt('div', 'title-h', name)); e.appendChild(c);\n    const rr = el('div', 'row'); const reroll = ui.btn('Another name', () => { name = genName(cosmetic); layer.rebuild(); }); rr.appendChild(reroll); e.appendChild(rr);\n    const sw = el('div', 'swatches'); for (const col of START_PAINTS) { const s = el('div', `swatch ${col === paint ? 'sel' : ''}`); s.style.background = col; s.dataset.focus = '1'; s._act = () => { paint = col; layer.rebuild(); }; sw.appendChild(s); } e.appendChild(sw);\n    const ok = ui.btn('That is me', () => { const p = newProfile(name, paint); g.save.profiles[slot] = p; g.save.current = slot; g.persist(); ui.closeTo('who'); ui.close(); then(); }, { def: true }); const row = el('div', 'row'); row.appendChild(ok); e.appendChild(row); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['use', 'Choose'], ['back', 'Back']]));\n  }, { onBack: () => ui.close() });\n}\nexport function openQuestion(g, q, cb) {\n  const ui = g.ui;\n  ui.open('question', (e) => {\n    e.appendChild(el('div', 'grow')); const c = el('div', 'bigcard'); c.append(txt('div', 'small', 'Trudy would like to know'), txt('div', 'title-h', q.q)); c.querySelector('.title-h').style.color = '#1A1420'; c.querySelector('.title-h').style.webkitTextStroke = '0'; c.querySelector('.title-h').style.textShadow = 'none'; e.appendChild(c);\n    const row = el('div', 'row'); row.append(ui.btn(q.a, () => cb('a'), { def: true }), ui.btn(q.b, () => cb('b'))); e.appendChild(row); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['move', 'Move'], ['use', 'Answer']]));\n  }, {});\n  g.audio.speak('trudy', q.q);\n}\nexport function openPlan(g) {\n  const ui = g.ui; const p = g.profile, plan = g.planFor(), def = g.dayDef();\n  if (ui.has('plan')) return;\n  ui.open('plan', (e) => {\n    e.classList.add('dim'); hdr(e, `Day ${p.day}: ${def ? def.name : 'Maintenance'}`); const row = el('div', 'row');\n    for (const id of plan) {\n      const C = EVENTS[id]; const done = p.doneToday.includes(id);\n      const card = ui.cardBtn('card', () => { ui.close(); if (!done) g.playClass(id, 'programme'); else g.playClass(id, { kind: 'hub-free', tier: g.tierFor(id) }); }, (b) => { b.append(txt('div', 'big', C.title), txt('div', '', C.discipline), txt('div', 'small', C.place)); if (done) b.appendChild(txt('div', 'stamp', 'DONE')); });\n      if (!done && !row.querySelector('[data-default]')) card.dataset.default = '1';\n      row.appendChild(card);\n    }\n    e.appendChild(row); const rem = g.remaining().length; e.appendChild(txt('div', 'sub-h', rem ? `${rem} left today. Walk there, or pick a card.` : 'All done. The Bed Hut is open.'));\n    const r2 = el('div', 'row'); r2.append(ui.btn('Back to the island', () => ui.close(), { cls: 'small' }), ui.btn('Journal', () => openJournal(g), { cls: 'small' })); if (!rem) r2.appendChild(ui.btn('Go to bed', () => { ui.close(); g.tryBed(); }, { cls: 'small', def: true })); e.appendChild(r2);\n    e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['move', 'Move'], ['use', 'Go'], ['back', 'Back']]));\n  }, { onBack: () => ui.close() });\n}\nexport function openLandmarkPick(g, evs) {\n  const ui = g.ui;\n  ui.open('landmark', (e) => { e.classList.add('dim'); hdr(e, 'Which class?'); const row = el('div', 'row'); for (const id of evs) row.appendChild(ui.cardBtn('card', () => { ui.close(); openTierPick(g, id, 'hub-free'); }, (b) => b.append(txt('div', 'big', EVENTS[id].title), txt('div', 'small', EVENTS[id].place)))); e.appendChild(row); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['use', 'Go'], ['back', 'Back']])); }, { onBack: () => ui.close() });\n}\nexport function openTierPick(g, id, kind) {\n  const ui = g.ui, p = g.profile; const best = p?.medals[id]?.tiers; const C = EVENTS[id]; const tiers = C.tiers.length;\n  const open = [0, 1, 2].slice(0, tiers).filter(i => tierOpen(best, i) || (p && p.allOpen));\n  if (open.length <= 1) { g.playClass(id, { kind, tier: 0 }); return; }\n  ui.open('tierpick', (e) => { e.classList.add('dim'); hdr(e, C.title); const row = el('div', 'row'); for (const t of open) row.appendChild(ui.cardBtn('card', () => { ui.closeAll(); g.playClass(id, { kind, tier: t }); }, (b) => b.append(txt('div', 'big', TIER_NAMES[t]), txt('div', 'small', best?.[t] != null ? `Best form ${Math.round(best[t])}` : 'Not tried yet')))); e.appendChild(row); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['use', 'Go'], ['back', 'Back']])); }, { onBack: () => ui.close() });\n}\nexport function openFreePlay(g) {\n  const ui = g.ui, p = g.profile; let page = 0; const list = FREE_ORDER.filter(id => EVENTS[id]); const per = 6, pages = Math.ceil(list.length / per);\n  ui.open('freeplay', (e, layer) => {\n    e.classList.add('dim'); hdr(e, 'Free Play'); const row = el('div', 'row');\n    for (const id of list.slice(page * per, page * per + per)) { const met = p?.met.includes(id) || p?.levelled; const C = EVENTS[id]; const rec = p?.medals[id]; row.appendChild(ui.cardBtn(`card ${met ? '' : 'locked'}`, () => { if (!met) { g.audio.sfx('back'); ui.toast('You have not met this class yet.'); return; } openTierPick(g, id, 'free'); }, (b) => { b.append(txt('div', 'big', met ? C.title : '???'), txt('div', 'small', met ? (rec ? medalFor(rec.best).name : 'Not done yet') : 'Not met yet')); })); }\n    e.appendChild(row); pager(ui, e, page, pages, (n) => { page = Math.max(0, Math.min(pages - 1, n)); layer.rebuild(false); }); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['move', 'Move'], ['use', 'Go'], ['back', 'Back']]));\n  }, { onBack: () => ui.close(), onLeft: () => {}, onRight: () => {} });\n}\nexport function openMirror(g) {\n  const ui = g.ui, p = g.profile; const hub = g.hub;\n  const hats = [['none', 0, 'No hat'], ...UNLOCKS.filter(u => u.kind === 'hat').map(u => [u.id, u.at, u.name])]; if (p.levelled) hats.push(['wizard', 0, 'A Wizard Hat, For Finishing']);\n  const paints = [...START_PAINTS, ...UNLOCKS.filter(u => u.kind === 'paint').map(u => u.id)];\n  if (hub) { hub.locked = true; hub.doll.setPaint(p.paint); }\n  let page = 0, per = 5, pages = Math.ceil(hats.length / per);\n  ui.open('mirror', (e, layer) => {\n    hdr(e, 'The Mirror'); const row = el('div', 'row');\n    for (const [id, at, name] of hats.slice(page * per, page * per + per)) { const ok = p.marbles >= at; row.appendChild(ui.cardBtn(`card ${ok ? '' : 'locked'}`, () => { if (!ok) { g.audio.sfx('back'); return; } p.hat = id; hub?.doll.setHat(id); g.persist(); layer.rebuild(); }, (b) => { b.append(txt('div', '', ok ? name : '???'), txt('div', 'small', ok ? (p.hat === id ? 'Wearing' : 'Try it') : `${at} marbles`)); })); }\n    e.appendChild(row); pager(ui, e, page, pages, (n) => { page = Math.max(0, Math.min(pages - 1, n)); layer.rebuild(false); });\n    const sw = el('div', 'swatches'); for (const col of paints) { const un = START_PAINTS.includes(col) || p.marbles >= (UNLOCKS.find(u => u.id === col)?.at ?? 0); const s = el('div', `swatch ${col === p.paint ? 'sel' : ''}`); s.style.background = un ? col : '#999'; s.dataset.focus = '1'; s._act = () => { if (!un) return; p.paint = col; hub?.doll.setPaint(col); g.persist(); layer.rebuild(); }; sw.appendChild(s); } e.appendChild(sw); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['move', 'Move'], ['use', 'Choose'], ['back', 'Back']]));\n  }, { onBack: () => { ui.close(); if (hub) hub.locked = false; }, tick: (dt) => { if (hub) hub.face += dt * .9; } });\n}\nexport function openJournal(g) {\n  const ui = g.ui, p = g.profile; let page = 0;\n  const medalIds = Object.keys(p.medals); const medalPages = Math.max(1, Math.ceil(medalIds.length / 8)); const total = 2 + medalPages + 1;\n  ui.open('journal', (e, layer) => {\n    e.classList.add('solid');\n    if (page === 0) { hdr(e, 'The Calendar'); const c = el('div', 'calendar'); const n = Math.max(14, p.day + 2); for (let i = 1; i <= Math.min(14, n); i++) { const d = el('div', `d ${i < p.day ? 'st' : ''}`); d.textContent = String(i); c.appendChild(d); } e.appendChild(c); e.appendChild(txt('div', 'sub-h', `You are on Day ${p.day}. It has been noticed.`)); }\n    else if (page === 1) {\n      hdr(e, 'Your Wobble Age'); const ages = p.ages.length ? p.ages : [0]; const W = 1000, H = 300, n = ages.slice(-12); const pts = n.map((a, i) => `${60 + i / Math.max(1, n.length - 1) * (W - 120)},${H - 20 - (a - 18) / 81 * (H - 40)}`).join(' ');\n      const g2 = el('div'); g2.innerHTML = `<svg viewBox=\"0 0 ${W} ${H}\" width=\"${Math.round(innerWidth * .62)}\" style=\"background:#FFF8EE;border:6px solid #1A1420;border-radius:18px\"><polyline points=\"${pts}\" fill=\"none\" stroke=\"#1A1420\" stroke-width=\"10\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>${n.map((a, i) => `<circle cx=\"${60 + i / Math.max(1, n.length - 1) * (W - 120)}\" cy=\"${H - 20 - (a - 18) / 81 * (H - 40)}\" r=\"14\" fill=\"#E8443A\" stroke=\"#1A1420\" stroke-width=\"5\"/>`).join('')}</svg>`; e.appendChild(g2);\n      const nums = el('div', 'bignums'); const big = (lb, v) => { const d = el('div', 'n'); d.appendChild(txt('b', '', String(v))); d.appendChild(document.createTextNode(lb)); return d; }; nums.append(big('Today', p.ages.at(-1) ?? '—'), big('First', p.ages[0] ?? '—'), big('Best', p.ages.length ? Math.min(...p.ages) : '—')); e.appendChild(nums);\n    } else if (page < 2 + medalPages) {\n      hdr(e, 'The Medal Shelf'); const sh = el('div', 'shelf'); const off = (page - 2) * 8; for (const id of medalIds.slice(off, off + 8)) { const r = p.medals[id], M = MEDALS.find(m => m.id === r.medal) || MEDALS[4]; const d = el('div', 'medal'); const b = el('div', 'blob'); b.style.background = M.colour; d.append(b, txt('div', '', EVENTS[id]?.title || id), txt('div', '', M.name)); sh.appendChild(d); } if (!medalIds.length) sh.appendChild(txt('div', 'sub-h', 'Nothing yet. The shelf is very patient.')); e.appendChild(sh);\n    } else {\n      hdr(e, 'Silly Totals'); const nums = el('div', 'bignums'); const big = (lb, v) => { const d = el('div', 'n'); d.appendChild(txt('b', '', String(v))); d.appendChild(document.createTextNode(lb)); return d; }; nums.append(big('Floor Exercises', p.falls), big('Minutes', Math.round(p.minutes)), big('Marbles', p.marbles)); e.appendChild(nums); e.appendChild(txt('div', 'sub-h', 'I was not counting. Those are just the numbers.'));\n    }\n    e.appendChild(el('div', 'grow')); pager(ui, e, page, total, (n) => { page = Math.max(0, Math.min(total - 1, n)); layer.rebuild(false); }); e.appendChild(ui.bottom([['move', 'Turn the page'], ['back', 'Back']]));\n  }, { onBack: () => ui.close(), onLeft: () => { page = Math.max(0, page - 1); ui.top().rebuild(false); }, onRight: () => { page = Math.min(total - 1, page + 1); ui.top().rebuild(false); } });\n}\nexport function openPause(g, msg) {\n  const ui = g.ui; g.simPaused = true; document.body.classList.remove('hidecursor'); const ev = g.mode?.event;\n  const resume = () => { ui.closeTo('pause'); ui.close(); g.simPaused = false; if (ev && !g.attractOn) document.body.classList.add('hidecursor'); };\n  ui.open('pause', (e) => {\n    e.classList.add('dim'); hdr(e, 'Paused'); if (msg) e.appendChild(txt('div', 'warn', msg)); else e.appendChild(txt('div', 'sub-h', g.line('trudy', 'pauseTip') || ''));\n    const c = el('div', 'col'); c.append(ui.btn('Resume', resume, { def: true }));\n    if (ev) c.appendChild(ui.btn('Restart', () => { resume(); if (g.onRestart) g.onRestart(); }));\n    c.append(ui.btn('How to Play', () => openHowTo(g)), ui.btn('Settings', () => openSettings(g)), ui.btn('Dev Mode', () => openDev(g)));\n    c.appendChild(ui.btn(ev ? 'Leave Class' : 'Main Menu', () => { ui.closeAll(); g.simPaused = false; g.speech.clear(); document.body.classList.remove('hidecursor'); if (ev && g.profile && g.leaveClass) { g.leaveClass(); } else { g.scripts.killTag('flow'); g.goTitle(true); } }));\n    e.appendChild(c); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['move', 'Move'], ['use', 'Choose'], ['back', 'Resume']]));\n  }, { onBack: resume });\n}\nexport function openHowTo(g) {\n  const ui = g.ui; const C = g.mode?.event?.cls;\n  const pages = [\n    C ? { t: C.title, body: [C.sentence, C.can, C.cant], verbs: C.verbs } : { t: 'The Island', body: ['Walk to the classes, or pick them from the plan. Then go to bed.', 'Every class puts marbles in the jar, and the island comes up.', \"You can't get stuck. The island cares about attendance, not skill.\"], verbs: [['walk', 'Walk'], ['useIsl', 'Use'], ['ask', 'Ask Trudy'], ['look', 'Look']] },\n    { t: 'Your Weight', body: ['The dot is where you are leaning. The ring is where you are asking to go.', 'The dot is slow. Ask early and small. Whip it and you will fall.', 'Falling costs you only the current hold. It is also very funny.'], verbs: [['lean', 'Lean'], ['recentre', 'Recentre']] },\n    { t: 'Flail', body: ['Flail makes your ankles briefly heroic. It lasts a moment, then rests for two seconds.', 'Use it as you pass the point of no return. Too early, and it wears off.'], verbs: [['flail', 'Flail']] },\n    { t: 'Breathe', body: ['In stillness classes, hold Breathe while the ring grows and let go while it shrinks.', 'In time with it, your body settles and your form counts for more.'], verbs: [['breath', 'Breathe']] },\n  ]; let page = 0;\n  ui.open('howto', (e, layer) => { e.classList.add('dim'); const P = pages[page]; hdr(e, P.t); const c = el('div', 'bigcard'); for (const b of P.body) c.appendChild(txt('div', 'line', b)); c.appendChild(ui.promptBar(P.verbs)); e.appendChild(c); e.appendChild(el('div', 'grow')); pager(ui, e, page, pages.length, (n) => { page = Math.max(0, Math.min(pages.length - 1, n)); layer.rebuild(false); }); e.appendChild(ui.bottom([['back', 'Back']])); }, { onBack: () => ui.close(), onLeft: () => { page = Math.max(0, page - 1); ui.top().rebuild(false); }, onRight: () => { page = Math.min(pages.length - 1, page + 1); ui.top().rebuild(false); } });\n}\nexport function openSettings(g) {\n  const ui = g.ui, S = g.settings; let page = 0; const save = () => { g.applySettings(); g.persist(); }; const names = ['Sound', 'Controls', 'Display', 'Game'];\n  ui.open('settings', (e, layer) => {\n    e.classList.add('dim'); hdr(e, `Settings: ${names[page]}`); const c = el('div', 'col');\n    if (page === 0) { c.append(ui.slider('Music', () => S.music, (v) => { S.music = v; save(); }, 0, 100, 5), ui.slider('Sound', () => S.sfx, (v) => { S.sfx = v; save(); g.audio.sfx('move'); }, 0, 100, 5), ui.slider('Voice', () => S.voice, (v) => { S.voice = v; save(); }, 0, 100, 5)); }\n    if (page === 1) { c.append(ui.choice('Controller glyphs', [['ps', 'PlayStation'], ['xbox', 'Xbox']], () => S.glyph, (v) => { S.glyph = v; save(); }), ui.toggle('Rumble', () => S.rumble, (v) => { S.rumble = v; save(); }), ui.toggle('Auto-breathe', () => S.autoBreathe, (v) => { S.autoBreathe = v; save(); }), ui.slider('Rhythm offset (ms)', () => S.rhythmOffset, (v) => { S.rhythmOffset = v; save(); }, -200, 200, 10)); }\n    if (page === 2) { c.append(ui.slider('UI scale', () => S.uiScale, (v) => { S.uiScale = v; save(); }, 1, 1.3, .05, (v) => `${Math.round(v * 100)}%`), ui.slider('Ink strength', () => S.ink, (v) => { S.ink = v; save(); }, 0, 2, .1), ui.toggle('Reduce shake', () => S.reduceShake, (v) => { S.reduceShake = v; save(); }), ui.toggle('Fullscreen', () => !!document.fullscreenElement, (v) => { try { if (v) document.documentElement.requestFullscreen?.(); else document.exitFullscreen?.(); } catch { g.errors.length = g.errors.length; } })); }\n    if (page === 3) { c.append(ui.choice('Difficulty', [['gentle', 'Gentle'], ['standard', 'Standard'], ['honest', 'Honest']], () => S.difficulty, (v) => { S.difficulty = v; save(); }), ui.btn('Reset save', () => openConfirm(g, 'Erase every guest and every marble?', () => { const s = wipeSave(); g.save = s; s.settings = S; g.scripts.killTag('flow'); ui.closeAll(); g.simPaused = false; g.goTitle(true); }))); }\n    e.appendChild(c); e.appendChild(el('div', 'grow')); pager(ui, e, page, 4, (n) => { page = Math.max(0, Math.min(3, n)); layer.rebuild(false); }); e.appendChild(ui.bottom([['move', 'Move and adjust'], ['back', 'Back']]));\n  }, { onBack: () => ui.close() });\n}\nexport function openConfirm(g, text, yes) { const ui = g.ui; ui.open('confirmbox', (e) => { e.classList.add('dim'); e.appendChild(el('div', 'grow')); const c = el('div', 'bigcard'); c.appendChild(txt('div', 'line', text)); e.appendChild(c); const r = el('div', 'row'); r.append(ui.btn('No', () => ui.close(), { def: true }), ui.btn('Yes', () => { ui.close(); yes(); })); e.appendChild(r); e.appendChild(el('div', 'grow')); }, { onBack: () => ui.close() }); }\nexport function openAbout(g) {\n  const ui = g.ui; const pages = aboutPages(); let page = 0;\n  ui.open('about', (e, layer) => {\n    e.classList.add('solid'); const P = pages[page]; const c = el('div', 'about'); c.appendChild(txt('div', 'sub-h', P.title)); for (const [k, v] of P.rows) { const d = el('div'); if (k) { d.appendChild(txt('b', '', `${k}: `)); } d.appendChild(document.createTextNode(v)); c.appendChild(d); } e.appendChild(c); e.appendChild(el('div', 'grow')); pager(ui, e, page, pages.length, (n) => { page = Math.max(0, Math.min(pages.length - 1, n)); layer.rebuild(false); }); e.appendChild(ui.bottom([['move', 'Turn the page'], ['back', 'Back']]));\n  }, { onBack: () => ui.close(), onLeft: () => { page = Math.max(0, page - 1); ui.top().rebuild(false); }, onRight: () => { page = Math.min(pages.length - 1, page + 1); ui.top().rebuild(false); } });\n}\nexport const openGroup = (g) => openGroupLobby(g);\nexport { resetTuning, T, liveDays, SEATS, highestTier, TEST_NAMES, HATS };\nE\ncat > src/game/ending.js <<'E'\n// About/Credits pages. Fed by the exit-interview file: one source of truth.\nimport { EXIT, SOURCE } from '../data/about.js';\nimport { TITLE } from '../data/config.js';\nconst Q = {\n  testing: ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'],\n  engine: ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why? (none if nothing)', 'If you could change one thing about the engine, what would it be?'],\n  prompt: ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'],\n};\nconst unk = 'unknown';\n/** Long answers split across pages rather than shrink. */\nfunction paged(title, rows, maxChars = 900) { const out = []; let cur = [], n = 0; for (const r of rows) { const l = r[0].length + r[1].length + 40; if (cur.length && n + l > maxChars) { out.push({ title, rows: cur }); cur = []; n = 0; } cur.push(r); n += l; } if (cur.length) out.push({ title, rows: cur }); return out; }\nexport function aboutPages() {\n  const E = EXIT || { sourceInformation: {}, testingFeedback: [], engineFeedback: [], promptFeedback: [] }, S = E.sourceInformation, v = (k) => S[k] ?? unk;\n  const qa = (qs, ans) => qs.map((q, i) => [q, ans[i] ?? unk]);\n  return [\n    ...paged('Source Information', [['Date', v('date')], ['Source', v('source') === unk ? SOURCE : v('source')], ['Plan', v('plan')], ['Genre', v('genre')], ['Perspective', v('perspective')]]),\n    ...paged('Source Information', [['Tech', v('tech')], ['Art Direction', v('artDirection')], ['Animation', v('animation')]]),\n    ...paged('Source Information', [['Audio', v('audio')], ['Online', v('online')], ['Testing', v('testing')]]),\n    ...paged('Source Information', [['Research', v('research')], ['Environment', v('environment')], ['Model', v('model')], ['Usage', v('usage')]]),\n    ...paged('Testing Feedback', qa(Q.testing, E.testingFeedback)),\n    ...paged('Engine Feedback', qa(Q.engine, E.engineFeedback)),\n    ...paged('Prompt Feedback', qa(Q.prompt, E.promptFeedback)),\n    { title: 'Credits', rows: [['Title', TITLE], ['Font', 'Fredoka, SIL Open Font License 1.1'], ['Engine', 'Three.js r180, MIT licence'], ['Physics', 'Rapier 0.19.3 by Dimforge, Apache 2.0'], ['Everything else', 'All art, music, sound, voices and words were made in code for this game']] },\n  ];\n}\nE\ncat > src/game/groupclass.js <<'E'\n// Group Class: 1-4 on one TV.\nimport { el, txt } from '../ui/ui.js';\nimport { SEATS } from '../data/config.js';\nimport { EVENTS } from '../data/events.js';\nimport { pick } from '../core/rng.js';\nimport { setPalette } from '../render/palette.js';\nimport { box, at, cyl } from '../art/materials.js';\nimport * as Play from '../ui/screens/play.js';\nconst COUCH = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard', 'raft', 'tug', 'roomService'];\nexport function openGroupLobby(g) {\n  const ui = g.ui, inp = g.input; const seats = [];\n  const already = (d) => seats.some(s => s.dev === d);\n  const add = (dev, ctrl) => { if (already(dev) || seats.length >= 4) return; seats.push({ dev, ctrl, colour: SEATS[seats.length], name: `Seat ${seats.length + 1}` }); g.audio.sfx('ok'); lay.rebuild(); };\n  let lay = null; let keyJoinGuard = 0;\n  lay = ui.open('group', (e, layer) => {\n    e.classList.add('dim'); e.appendChild(txt('div', 'title-h', 'Group Class'));\n    const mats = el('div', 'mats'); for (let i = 0; i < 4; i++) { const s = seats[i]; const m = el('div', 'mat'); m.style.minHeight = '34vh'; if (s) { const c = el('div', 'chip'); c.style.background = s.colour; m.append(c, txt('div', '', s.name), txt('div', 'small', s.dev === 'kbm' ? 'Keys and mouse' : `Controller ${s.ctrl.index + 1}`)); } else m.append(txt('div', '', 'Empty mat'), txt('div', 'small', 'Press to join')); mats.appendChild(m); } e.appendChild(mats);\n    const r = el('div', 'row'); if (seats.length) { r.append(ui.btn('Quick Class', () => { ui.close(); runGroup(g, seats, quick(g)); }, { def: true }), ui.btn('Pick Three', () => openPick(g, seats))); } else { const b = ui.btn('Waiting for someone', () => {}, { cls: 'locked' }); r.appendChild(b); } e.appendChild(r);\n    e.appendChild(el('div', 'grow')); const bar = ui.bottom([['use', 'Join'], ['back', 'Leave']]); e.appendChild(bar);\n  }, {\n    onBack: () => { if (seats.length) { seats.pop(); seats.forEach((s, i) => { s.colour = SEATS[i]; s.name = `Seat ${i + 1}`; }); lay.rebuild(); } else ui.close(); },\n    tick: (dt) => {\n      keyJoinGuard += dt; if (ui.top() !== lay || keyJoinGuard < .2) return;\n      for (const c of inp.pads) if (c.connected && c.hop && !already(`pad${c.index}`)) { add(`pad${c.index}`, c); inp.menu.confirm = false; }\n      if ((inp.kbm.use || inp.kbm.hop) && !already('kbm')) { add('kbm', inp.kbm); inp.menu.confirm = false; }\n    },\n  });\n  // Clicking a mat joins keyboard and mouse.\n  lay.el.addEventListener('click', (e) => { if (e.target.closest('.mat') && !already('kbm')) add('kbm', inp.kbm); });\n}\nfunction quick(g) { const pool = [...COUCH].filter(e => EVENTS[e]); const out = []; while (out.length < 3) out.push(pool.splice(Math.floor(g.rngFlow() * pool.length), 1)[0]); return out; }\nfunction openPick(g, seats) {\n  const ui = g.ui, chosen = []; let page = 0; const per = 5, list = COUCH.filter(e => EVENTS[e]), pages = Math.ceil(list.length / per);\n  ui.open('grouppick', (e, layer) => {\n    e.classList.add('dim'); e.appendChild(txt('div', 'title-h', `Pick three (${chosen.length} of 3)`)); const row = el('div', 'row');\n    for (const id of list.slice(page * per, page * per + per)) row.appendChild(ui.cardBtn('card', () => { if (chosen.includes(id)) chosen.splice(chosen.indexOf(id), 1); else chosen.push(id); if (chosen.length === 3) { ui.closeTo('group'); ui.close(); runGroup(g, seats, chosen); } else layer.rebuild(); }, (b) => { b.append(txt('div', 'big', EVENTS[id].title)); if (chosen.includes(id)) b.appendChild(txt('div', 'stamp', 'YES')); }));\n    e.appendChild(row); const pr = el('div', 'row'); pr.appendChild(ui.btn('More classes', () => { page = (page + 1) % pages; layer.rebuild(false); }, { cls: 'small' })); e.appendChild(pr); e.appendChild(el('div', 'grow')); e.appendChild(ui.bottom([['use', 'Choose'], ['back', 'Back']]));\n  }, { onBack: () => ui.close() });\n}\nexport function runGroup(g, seats, list) { g.ui.closeAll(); g.scripts.run(groupFlow(g, seats, list), 'flow'); g.groupRun = true; }\nfunction* groupFlow(g, seats, list) {\n  const pts = seats.map(() => 0);\n  for (const id of list) {\n    const Cls = EVENTS[id]; let go = null; Play.openIntro(g, Cls, 0, (v) => { go = v; }); yield () => go !== null; g.ui.close(); if (go === 'back') break;\n    yield* g.wipe(() => { const specs = seats.map((s, i) => ({ kind: 'local', ctrl: s.ctrl, name: s.name, colour: s.colour, seat: i })); if (id === 'raft' && specs.length < 2) specs.push({ kind: 'bot', skill: 'average', name: 'Retired Kevin', colour: '#2FA7A0' }); g.startEventMode(Cls, { tier: 0, group: true, palette: 'noon' }, specs); });\n    const ev = g.mode.event; yield () => ev.phase === 'done'; yield 1.1;\n    const order = seats.map((_, i) => i).sort((a, b) => ev.laneResult(b).form - ev.laneResult(a).form); order.forEach((s, rank) => { pts[s] += 4 - rank; }); document.body.classList.remove('hidecursor');\n    let cont = false; g.ui.open('groupresult', (e) => { e.classList.add('dim'); e.appendChild(txt('div', 'title-h', Cls.title)); const row = el('div', 'row'); order.forEach((s, rank) => { const c = el('div', 'card'); c.style.borderColor = seats[s].colour; c.append(txt('div', 'big', `${rank + 1}`), txt('div', '', seats[s].name), txt('div', 'small', `+${4 - rank} points. Total ${pts[s]}`)); row.appendChild(c); }); e.appendChild(row); e.appendChild(el('div', 'grow')); const r2 = el('div', 'row'); r2.appendChild(g.ui.btn('Next', () => { cont = true; }, { def: true })); e.appendChild(r2); }, {}); g.audio.sting('pleasant'); yield () => cont; g.ui.close();\n  }\n  // Final podium: a toy-block podium, winners on top, and it tips over.\n  const order = seats.map((_, i) => i).sort((a, b) => pts[b] - pts[a]);\n  yield* g.wipe(() => { g.clearMode(); setPalette('golden'); const m = podiumMode(g, seats, order); g.mode = m; });\n  g.audio.sting('fanfare'); g.audio.sfx('cheer'); let cont = false;\n  g.ui.open('podium', (e) => { e.appendChild(txt('div', 'title-h', `${seats[order[0]].name} wins`)); const row = el('div', 'row'); order.forEach((s, r) => { const c = el('div', 'gaugeTag'); c.textContent = `${r + 1}. ${seats[s].name}: ${pts[s]}`; row.appendChild(c); }); e.appendChild(row); e.appendChild(el('div', 'grow')); const r2 = el('div', 'row'); r2.appendChild(g.ui.btn('Finish', () => { cont = true; }, { def: true })); e.appendChild(r2); }, {});\n  yield () => cont; g.ui.closeAll(); g.groupRun = false;\n  yield* g.wipe(() => g.goTitle(true));\n}\nimport * as THREE from 'three/webgpu';\nimport { makeDoll } from '../art/doll.js';\nimport { RAPIER, makeWorld, addGroundPlane, groups } from '../physics/world.js';\nfunction podiumMode(g, seats, order) {\n  const group = new THREE.Group(); g.scene.add(group); g.island.setStage('backdrop'); const world = makeWorld({ iterations: 8 }); addGroundPlane(world, 0); const G = groups(1, 0xffff);\n  group.add(at(cyl(9, 9.3, .4, '#8FD06F', 32), 0, -.2, 0));\n  const H = [1.8, 1.2, .7, .35], X = [0, -1.9, 1.9, 3.8], blocks = [], dolls = [], cols = ['#F5B700', '#B8C4CF', '#C98F62', '#E8DCC8'];\n  order.forEach((s, r) => { const h = H[r], x = X[r]; const b = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, h / 2, 0).setCanSleep(false)); world.createCollider(RAPIER.ColliderDesc.cuboid(.9, h / 2, .9).setMass(1).setFriction(.6).setCollisionGroups(G), b); const m = box(1.8, h, 1.8, cols[r]); group.add(m); blocks.push({ b, m, h });\n    const d = makeDoll({ paint: seats[s].colour }); d.rig.play('cheer', 0); group.add(d.group); d.group.position.set(x, h, 0); const db = world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, h + .75, 0).setCanSleep(false)); world.createCollider(RAPIER.ColliderDesc.capsule(.5, .25).setMass(.4).setFriction(.7).setCollisionGroups(G), db); dolls.push({ d, db }); });\n  g.rig.set(1, 3, 10, 1, 1.4, 0, true); let t = 0, tipped = false;\n  return { screen: 'podium', fixed(dt) { t += dt; if (t > 3 && !tipped) { tipped = true; blocks[0].b.applyImpulse({ x: 3.2, y: 0, z: .4 }, true); g.audio.sfx('creak', { dur: 1 }); g.after(.8, () => g.audio.sfx('clatter')); } world.step(); for (const o of blocks) { const p = o.b.translation(), q = o.b.rotation(); o.m.position.set(p.x, p.y, p.z); o.m.quaternion.set(q.x, q.y, q.z, q.w); } },\n    frame(dt) { for (const o of dolls) { const p = o.db.translation(), q = o.db.rotation(); o.d.group.position.set(p.x, p.y - .75, p.z); o.d.lean.quaternion.set(q.x, q.y, q.z, q.w); o.d.tick(dt); } g.island.tick(dt); }, dispose() { group.removeFromParent(); world.free(); } };\n}\nvoid pick;\nE\ncat > src/game/devmode.js <<'E'\n// Dev Mode: pages of big controls, reachable from Pause, off in a session.\nimport * as THREE from 'three/webgpu';\nimport { el, txt } from '../ui/ui.js';\nimport { T, resetTuning, tuningGroups, tuningJSON } from '../core/tuning.js';\nimport { TUNING } from '../data/tuning.js';\nimport { EVENTS, FREE_ORDER } from '../data/events.js';\nimport { TRACKS, STINGS } from '../audio/tracks.js';\nimport { D } from '../data/dialogue.js';\nimport { PALETTE_ORDER } from '../data/palettes.js';\nimport { setPalette } from '../render/palette.js';\nimport { R } from '../render/renderer.js';\nimport { UNLOCKS, START_PAINTS } from '../data/unlocks.js';\nimport { DAYS } from '../data/programme.js';\nimport { wipeSave } from '../core/save.js';\nconst SCALES = [.1, .25, .5, 1, 2, 4];\nexport function openDev(g) {\n  const ui = g.ui; if (g.session) return;\n  const groups = tuningGroups(); const pagesDef = [];\n  pagesDef.push({ t: 'Jump', build: (c) => { c.append(ui.btn('Jump to a class', () => openList(g, 'Class', FREE_ORDER.filter(i => EVENTS[i]).map(id => [EVENTS[id].title, () => openTierJump(g, id)]))), ui.btn('Jump to a day', () => openList(g, 'Day', DAYS.map(d => [`Day ${d.day}: ${d.name}`, () => jumpDay(g, d.day)]).concat([['Day 6: Maintenance', () => jumpDay(g, 6)]]))), ui.btn('Skip to Results', () => { closeDev(g); g.mode?.event?.forceFinish(); }), ui.btn('Skip to the Ending', () => { closeDev(g); jumpEnding(g); }), ui.toggle('God mode (no falls)', () => g.god, (v) => { g.god = v; const ev = g.mode?.event; if (ev) { ev.god = v; for (const l of ev.lanes) if (l.bal) l.bal.mods.ankle = ev.diff.ankle * (v ? 3 : 1); } }), ui.toggle('Let the bot play', () => !!g.devBot, (v) => setBot(g, v))); } });\n  pagesDef.push({ t: 'Time and view', build: (c) => { c.append(ui.choice('Time scale', SCALES.map(s => [s, `${s}x`]), () => g.loop.timeScale, (v) => { g.loop.timeScale = v; }), ui.btn('Single step', () => { g.simPaused = false; g.fixed(1 / 120); g.frame(1 / 120); g.simPaused = true; }), ui.toggle('Free camera', () => g.rig.free, (v) => { g.rig.free = v; g.freeCam = v; g.rig.freeYaw = 0; g.rig.freePitch = -.3; }), ui.toggle('Physics lines', () => !!g.debugLines, (v) => setDebug(g, v)), ui.toggle('Stats', () => !!g.statsEl, (v) => setStats(g, v)), ui.toggle('Input monitor', () => !!g.inputEl, (v) => setInput(g, v))); } });\n  pagesDef.push({ t: 'Force', build: (c) => { const ev = () => g.mode?.event; c.append(ui.btn('Force a gust', () => { ev()?.forceGust(3); }), ui.btn('Force a fall', () => { ev()?.forceFall(); }), ui.btn('Force a fruit or stone', () => { ev()?.forceThing(); }), ui.btn('Play a line', () => { const ks = Object.keys(D.trudy); const k = ks[Math.floor(g.rngFlow() * ks.length)]; g.simPaused = false; g.barkNow('trudy', k, { age: 50, prev: 60, diff: 10, pose: 'The Apologetic Pine' }); g.speech.tick(.01); g.simPaused = true; }), ui.choice('Play music', Object.keys(TRACKS).map(k => [k, k]), () => g.audio.seq.name, (v) => g.audio.playTrack(v)), ui.choice('Play a sting', Object.keys(STINGS).map(k => [k, k]), () => g.devSting || 'fanfare', (v) => { g.devSting = v; g.audio.sting(v); })); } });\n  pagesDef.push({ t: 'Save', build: (c) => { const P = () => g.profile; c.append(ui.slider('Set Wobble Age', () => P()?.ages.at(-1) ?? 50, (v) => { if (P()) { P().ages.push(v); P().ages = P().ages.slice(-30); } }, 18, 99, 1), ui.btn('Add 10 marbles', () => { if (P()) { for (let i = 0; i < 10; i++) P().marbleList.push('#F5B700'); P().marbles += 10; g.island.setMarbles(P().marbleList); g.persist(); } }), ui.btn('Unlock all', () => { if (P()) { P().marbles = Math.max(P().marbles, 60); P().allOpen = true; P().levelled = true; P().met = Object.keys(EVENTS); g.persist(); ui.toast('Everything is open.'); } }), ui.toggle('Ink', () => R.inkOn, (v) => { R