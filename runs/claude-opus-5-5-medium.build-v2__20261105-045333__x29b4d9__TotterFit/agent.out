s.falls >= 3) awards.push({ title: 'Very Consistent', detail: `${this.falls} Floor Exercises.` });\n    this.H.result({ score: this.score, stats: { 'Floor Exercises': this.falls, 'Best medal': m.name }, awards });\n  }\n  timeUp() { if (this.ev && !this.slotClosed && this.slot >= 0) { const r = this.ev.laneResult(0); this.score += Math.round(Math.max(0, r.form) * 10); this.slotClosed = true; } this.sendResult(); }\n  end() { this.ended = true; this.g.audio.silence(); this.g.simPaused = true; for (const gh of this.ghosts.values()) gh.tag.remove(); this.g.input.poll = () => {}; }\n}\nE\ncat > src/main.js <<'E'\nimport * as THREE from 'three/webgpu';\nimport cssText from './ui/ui.css';\nimport { RAPIER } from './physics/world.js';\nimport { Game } from './game/director.js';\nimport { startRenderer, R } from './render/renderer.js';\nimport { Session } from './game/session.js';\nimport { installTestHooks } from './core/testhooks.js';\nimport { newProfile } from './game/programme.js';\nimport { setSeed, freshSeed } from './core/rng.js';\nimport { Poses } from './events/poses.js';\nconst q = new URLSearchParams(location.search);\nconst params = { test: q.get('test') === '1', render: q.get('render') !== '0', manual: q.get('manual') === '1', seed: q.get('seed') };\nconst AIHub = globalThis.AIHub;\nfunction style() { const s = document.createElement('style'); s.textContent = cssText; document.head.appendChild(s); }\nfunction bootCard() { const b = document.createElement('div'); b.className = 'bootmsg'; b.id = 'boot'; b.innerHTML = '<div class=\"wob\"></div><div>Stretching...</div>'; document.body.appendChild(b); return b; }\nlet game = null;\nasync function bootEngine() {\n  style(); const b = bootCard();\n  setSeed(params.seed != null ? +params.seed : freshSeed());\n  await RAPIER.init();\n  game = new Game(params); game.freshProfile = newProfile;\n  game.buildWorld();\n  if (params.render) { await startRenderer(game.scene, game.camera); if (R.renderer && R.renderer.backend && R.backend === 'none') R.backend = 'webgl2'; }\n  if (params.test) installTestHooks(game, RAPIER, THREE);\n  b.remove();\n  return game;\n}\nfunction runStandalone() {\n  game.goTitle(true);\n  if (!params.manual) game.loop.start();\n  // A controller-only device: the first attract and audio still work.\n}\nfunction runSession(info) {\n  game.island.setStage('backdrop');\n  const s = new Session(game, info); game.session = s;\n  if (params.test) { window.__SESSION__ = s; }\n  AIHub.ready();\n  game.loop.start();\n}\nasync function main() {\n  if (AIHub && AIHub.active) {\n    const pConnect = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n    await bootEngine();\n    const info = await pConnect;\n    if (info) runSession(info); else runStandalone();\n  } else { await bootEngine(); runStandalone(); }\n}\nfunction showBootFailure(e) {\n  const m = String(e && e.message || e);\n  const b = document.getElementById('boot') || bootCard(); b.innerHTML = `<div>This game needs WebGPU or WebGL2.</div><div style=\"font-size:30px\">${m.replace(/[<&]/g, '')}</div>`;\n  if (AIHub && AIHub.active) AIHub.fail(m);\n  if (params.test) window.__BOOTERR__ = m;\n}\nmain().catch(showBootFailure);\nvoid Poses;\nE\ncat > src/core/testhooks.js <<'E'\n// ?test=1 exposes window.__TEST__. Everything a test needs, through the real game.\nimport { renderOffline } from '../audio/engine.js';\nimport { TRACKS, STINGS } from '../audio/tracks.js';\nimport { SFX } from '../audio/sfx.js';\nimport { INST } from '../audio/instruments.js';\nimport { VOICES } from '../audio/voice.js';\nimport { T, resetTuning } from './tuning.js';\nimport { R } from '../render/renderer.js';\nimport { liveWorlds } from '../physics/world.js';\nimport { EVENTS } from '../data/events.js';\nimport { DAYS } from '../data/programme.js';\nimport { D, linesCount } from '../data/dialogue.js';\nimport { aboutPages } from '../game/ending.js';\nimport { setSeed } from './rng.js';\nimport * as Menus from '../ui/screens/menus.js';\nexport function installTestHooks(g, RAPIER, THREE) {\n  window.__TEST__ = {\n    g, T, EVENTS, DAYS, Menus,\n    state() {\n      const ev = g.mode?.event, p = g.profile;\n      return { screen: g.ui.topId() || g.mode?.screen || null, attract: g.attractOn, day: p?.day ?? null, step: p?.steps ?? null, profile: p ? p.name : null, marbles: p?.marbles ?? 0, tilt: g.island.restDeg, liveTilt: Math.hypot(g.island.tx, g.island.tz) * 57.3, wobbleAge: p?.ages?.at(-1) ?? null, ages: p?.ages ?? [], done: p?.doneToday ?? [], levelled: p?.levelled ?? false, stamps: p?.stamps?.length ?? 0, speech: g.speech.cur ? g.speech.cur.text : null, speechBusy: g.speech.busy, remaining: p ? g.remaining() : [],\n        event: ev ? { id: ev.cls.id, tier: ev.tierIndex, phase: ev.phase, t: ev.playT, score: ev.lanes[0]?.score ?? 0, bodies: ev.bodyCount(), lanes: ev.lanes.map(l => ({ kind: l.kind, leanX: l.bal?.leanX ?? 0, leanZ: l.bal?.leanZ ?? 0, cob: l.bal ? [l.bal.cobX, l.bal.cobZ] : null, fallen: l.fallen, form: l.form, falls: l.falls, props: l.props?.length ?? 0, wishX: l.wishX, wishZ: l.wishZ })) } : null,\n        input: { lastDevice: g.input.lastDevice, glyphSet: g.settings.glyph }, audio: { state: g.audio.ctx?.state ?? 'none', music: g.audio.settings.music, sfx: g.audio.settings.sfx, voice: g.audio.settings.voice, musicGain: g.audio.music?.gain.value, track: g.audio.seq.name, detune: g.audio.detuneAt(1.5707 / .7), tiltDeg: g.audio.tiltDeg }, render: { backend: R.backend, frames: R.frames, lost: R.lost }, errors: g.errors.slice(), rapier: RAPIER.version?.(), three: THREE.REVISION, worlds: liveWorlds(), focus: g.ui.focus.cur ? g.ui.focus.cur.textContent.slice(0, 40) : null, items: g.ui.top() ? g.ui.focus.items().map(i => i.textContent.slice(0, 40)) : [] };\n    },\n    advance(sec) { g.loop.advance(sec); return true; },\n    bot(skill) { g.testBotSkill = skill; if (!skill && window.__pads) for (const p of window.__pads) { if (!p) continue; p.axes.fill(0); p.buttons.forEach((b, i) => { p.buttons[i] = { pressed: false, value: 0 }; }); } },\n    settings: g.settings, tuning: T, resetTuning, seed: setSeed,\n    /** Runs one event to the end headless with bots on chosen lanes. Returns the result. */\n    runEvent(id, { tier = 0, skills = ['sharp'], opts = {}, maxSec = 400, keepBot = false } = {}) {\n      g.ui.closeAll(); g.clearMode(); g.scripts.clear(); g.speech.clear();\n      const specs = skills.map((s, i) => ({ kind: 'bot', skill: s, name: s, colour: '#E8443A' }));\n      const ev = g.startEventMode(EVENTS[id], { tier, ...opts }, specs); ev.count = .01; let t = 0, nan = false, peak = 0;\n      const base = ev.bodyCount();\n      while (ev.phase !== 'done' && t < maxSec) { g.fixed(1 / 120); t += 1 / 120; if (Math.round(t * 120) % 2 === 0) g.frame(1 / 60); if (Math.round(t * 120) % 120 === 0 && ev.hasNaN()) nan = true; }\n      const res = skills.map((_, i) => ({ ...ev.laneResult(i), falls: ev.lanes[i].falls, raw: ev.lanes[i].score, extra: ev.lanes[i].inT })); const out = { res, t, done: ev.phase === 'done', nan, playT: ev.playT, base, bodiesEnd: ev.bodyCount(), restarts: ev.restarts, maxRound: ev.maxRound };\n      if (!keepBot) { g.clearMode(); }\n      return out;\n    },\n    audioRender: renderOffline, audioLists: () => ({ tracks: Object.keys(TRACKS), stings: Object.keys(STINGS), sfx: Object.keys(SFX), inst: Object.keys(INST), voices: Object.keys(VOICES) }), lines: linesCount, about: aboutPages,\n    clearSave() { g.save.profiles = [null, null, null, null]; g.save.current = -1; g.persist(); },\n  };\n}\nE\ncd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-045333__x29b4d9/work/TotterFit-WiiFit-claude-opus-5-5-medium-20261105-045333 && node tools/build.mjs 2>&1 | tail -30","description":"Write menus, group class, dev mode, session, main and run first build","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache