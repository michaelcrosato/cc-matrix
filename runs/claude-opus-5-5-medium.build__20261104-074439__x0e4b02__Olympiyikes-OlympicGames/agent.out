et; console.log('end scene', game.sceneName, 'medals', m && JSON.stringify(m.medals), 'errors', game.errors.map(e => e.where + ': ' + e.message + ' | ' + (e.stack || '').split('\\n').slice(1, 3).join(' ')));\nEOF\ntimeout 600 node .tmp/play.mjs 2>&1 | tail -30","description":"Run a scripted Games playthrough headless"}}}
