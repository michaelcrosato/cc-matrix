DBACK', lines: ['Liked most:', ...(X.promptFeedback || []).slice(0, 1), 'Confusing:', ...(X.promptFeedback || []).slice(1, 2), 'Hardest:', ...(X.promptFeedback || []).slice(2, 3), 'Would change:', ...(X.promptFeedback || []).slice(3, 4)] },\n      { title: 'CREDITS & ENGINE CHANGES', lines: ['Planned by claude-opus-5-5 (max effort, PLAN.md); built by claude-opus-5-5 (medium effort).', 'Engine: my-3D2dge ' + E.version + ' handoff (full engine: road, rhythm modules used), modified. AI Hub session client 1.4.0, unmodified.',\n        'Engine changes (marked // OLY: in the engine source):', '1. E.HOOKS exported: the hub Create+Options guard, any-input detection, the dev key.', '2. Cosmetic randomness (particles, rig blink/phase, hit-number jitter) off Math.random onto its own stream: deterministic tests and hub cards.',\n        '3. ✕ ○ □ △ glyphs added to the 5x7 and 3x5 pixel fonts.', '4. Button symbols default to PlayStation.', '5. A pose hook (rig.post) and whole-body rotation (rig.bodyPitch / bodyRoll about rig.pivot): swims, dives, ski flight, spins.', '6. A voice bus with its own volume (Settings, Sound, Voices) for the gibberish voices.',\n        'Fictional nations, athletes, venues and mascot; no real emblems, anthems or broadcast themes. All art, music, sound and voices are made in code.'] },\n      { title: 'CONTROLS', controls: true, lines: [] }\n    ];\n  }\n};\n})();\nEOF\npython3 - <<'EOF'\np='index.html'; s=open(p).read()\ns=s.replace('<script src=\"src/31-ev-hockey.js\"></script>','<script src=\"src/31-ev-hockey.js\"></script>\\n<script src=\"src/40-sc-title.js\"></script>\\n<script src=\"src/41-sc-games.js\"></script>\\n<script src=\"src/42-sc-misc.js\"></script>\\n<script src=\"src/43-dev.js\"></script>\\n<script src=\"src/44-hub.js\"></script>\\n<script src=\"src/45-about.js\"></script>\\n<script src=\"src/99-main.js\"></script>')\nopen(p,'w').write(s)\nEOF\ncat > .tmp/boot.mjs <<'EOF'\nimport { boot } from '../tests/harness.mjs';\nconst c = boot({ 