ed; screens: { pause: false } leaves it out)\n9458:    else add(this._el('h2', '', v(s.title) || { pause: this._game._players && this._game._players.length > 1 && this._game.pausedBy ? 'Paused by P' + this._game.pausedBy : 'Paused', settings: 'Settings', controls: 'Controls', help: 'Help', map: 'Map' }[name] || ''));   // (several players: who paused)\n9543:  /** each step (the game calls it after reading input): follow game.paused, time out the toast and the card, and while a\n9548:    if (pause && g.paused && !this._stack.length) this.show('pause');\n9549:    if (!g.paused && this._stack.length && (this._ownPause || (pause && this._stack.some(t => t.name === 'pause')))) { this._stack.length = 0; this._ownPause = false; this._capEnd(); this._render(); }   // resumed from code\n....\n1022:  repeat(a, delay = .3, rate = .08) {\n1023-    if (this.pressed(a)) return true;\n1024-    if (!this.down(a) || this._pt[a] === undefined) return false;\n1025-    const t = this.clock - this._pt[a]; if (t < delay) return false;\n1026-    const k = Math.floor((t - delay) / rate); if (k !== this._rk[a]) { this._rk[a] = k; return true; }\n1053:  anyPressed() { return this._now.size > 0; }\n1054-  /** movement intent in screen directions: x right, y down, length <= 1 */\n1055-  move() {\n1056-    let x = (this.down('right') ? 1 : 0) - (this.down('left') ? 1 : 0), y = (this.down('down') ? 1 : 0) - (this.down('up') ? 1 : 0);\n--\n10464:    if (I.anyPressed() || clicked(I)) { this._idle = 0; this.phase = 'title'; return 'title'; }\n10465-    this._idle += dt;\n10466-    const next = this.phase === 'title' ? (this._idle >= o.idle ? 'demo' : null) : this.phase === 'demo' ? (this._idle >= o.demo ? 'scores' : null) : this._idle >= o.scores ? 'title' : null;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HrPQ4aLEkQpDdjrBGvNX41","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
