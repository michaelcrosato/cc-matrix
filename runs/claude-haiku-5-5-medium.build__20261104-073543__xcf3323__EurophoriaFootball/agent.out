X0 : X1;   // where side s shoots (side 0 attacks the right end)"]},{"oldStart":130,"oldLines":77,"newStart":135,"newLines":71,"lines":["   const h = E.hash2(c * 3 + dx, R * 7 + 1), side = c < ND + (FW + 2) / 2 ? 0 : 1;","   CROWD.push({ x: c * T + dx, y: R * T + 9, z: [54, 44, 34][R], side, v: h, skin: ['#e0b090', '#a87050', '#6a4028', '#f0c8a8'][(h * 50 | 0) % 4], ph: h * 9 });"," }","+const BALL = E.sprite(['.www.', 'wwkww', 'wkkkw', 'wwkww', '.www.'], { w: '#f4f4f0', k: '#2a2a30' });","+const BALL2 = E.sprite(['.www.', 'wkwkw', 'wwwww', 'wkwkw', '.www.'], { w: '#f4f4f0', k: '#2a2a30' });"," ","-let mode = 'menu', home = 'kip', away = 'hoo', TEAMS = [CLUBS.kip, CLUBS.hoo];","+/* ---------- the state ---------- */","+let mode = 'menu', home = 'kip', away = 'hoo', TEAMS = [CLUBS.kip, CLUBS.hoo], devReturn = 'menu';"," let all = [], team = [[], []], ball = null, owner = null, last = null, clock = 0, half = 1, score = [0, 0], kickT = 0, t = 0;","-let stats = null, curlT = 0, golden = false, restartBy = 0, over = false, kickHold = 0, demo = false, vs = false;","-let eu = [0, 0], europhoria = [0, 0], superT = 0, idle = 0, cup = null, card = null, toast = '', toastT = 0, devSel = 0, devRepeat = 0, lastBeat = 0;","+let stats = null, curlT = 0, golden = false, restartBy = 0, over = false, kickHold = 0, demo = false, vs = false, demoN = 0;","+let eu = [0, 0], europhoria = [0, 0], superT = 0, idle = 0, cup = null, card = null, toast = '', toastT = 0, devSel = 0;"," const mmss = s => Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');"," ","-/* commentary: a radio box with the commentator's line (the same call, the same shape, in every mode) */","+/* commentary: a radio box with the commentator's line */"," const talk = new E.Dialog(game, { lines: 2, place: 'bottom', border: '#e8c070' });"," const VOICE = new E.Humanoid({ weapon: null, hat: 'band', colors: { cloth: '#3a3a4a', hair: '#5a3a2a', skin: '#e0b090', hat: '#2a2a30' } });","-const say = text => { 