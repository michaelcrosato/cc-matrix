ic('title'); idle = 0; menuMain.i = 0; }","-function startCup() { cup = { round: 0, lost: 0 }; roundCard(); }"," function pickClub() { mode = 'pick'; menuPick.i = 0; }"," function kickAbout() { cup = null; TEAMS = [CLUBS[home], CLUBS[away]]; startMatch(false); }","-function versusStart() { cup = null; vs = true; mode = 'join'; game.allowJoin({ max: MAXP }); A.sfx('select'); }","-function startAgain() { if (cup) return cupRetry(); return kickAbout(); }","-function restartFromPause() { if (cup) return cupRetry(); kickAbout(); }","-function openDevFromPause() { openDev('pause'); }","-function openDev(from) { mode = 'dev'; devFrom = from; devSel = 0; }","-let devFrom = 'menu';","-","-/** the cup: the back page of the round, and the round's match after it */","+function versusStart() { cup = null; mode = 'join'; game.allowJoin({ max: MAXP }); A.sfx('select'); }","+function restartMatch() { if (cup) return roundCard(); kickAbout(); }","+function startCup() { cup = { round: 0, lost: 0, won: false }; roundCard(); }","+/** the cup's back page for the round: the headline, the set-up, the commentator's line */"," function roundCard() {","   const R = ROUNDS[cup.round], c = CLUBS[R.club];","-  card = { kind: 'pre', head: R.pre, body: [R.name + ' AT ' + R.venue, R.preBody, R.ref + '. Kipperton v ' + c.full + '.'], cue: 'PRESS ' + game.input.label('confirm') + ' FOR THE TEAM TALK' };","+  card = { kind: 'pre', head: R.pre, body: [R.name + ': ' + R.venue + '. ' + R.ref + '.', R.preBody, 'Kipperton v ' + c.full + '.'], cue: 'PRESS ' + game.input.label('confirm') + ' FOR THE TEAM TALK' };","   mode = 'card'; A.music(ANTHEM);"," }","-function cupRetry() { roundCard(); }"," function startRound() { home = 'kip'; away = ROUNDS[cup.round].club; TEAMS = [CLUBS.kip, CLUBS[away]]; startMatch(false); }"," function startDemo() {","-  demo = true; mode = 'attract'; const pr = DEMO_PAIRS[(demo.n = ((demo.n || 0) + 1)) % DEMO_PAIRS.length];","-  home = pr[0]; away = pr[1]; TEAMS = [CLUBS[home], 