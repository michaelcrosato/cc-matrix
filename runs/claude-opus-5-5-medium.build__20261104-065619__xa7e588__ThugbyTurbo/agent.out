oth); px.rect(g, pcx + pw - 2, gy - 8, 4, 8, m.kits[0].cloth);\n  const rx = Math.round(clamp(cx + (ph.aim + (hu ? ph.sway : 0)) * sc, x0 + 6, x0 + bw - 6)), ry = barY - 14;\n  px.rect(g, rx - 5, ry, 11, 1, '#ff4040'); px.rect(g, rx, ry - 5, 1, 11, '#ff4040'); px.rect(g, rx - 2, ry - 2, 5, 5, '#ff8080');\n\"\"\"+s[j:]\ns=s.replace(\"if (TT.mouse && s === 'aim') TT.mouse.kickBox = [x0, y0, bw, bh, sc * 1.2];\",\"if (TT.mouse && s === 'aim') TT.mouse.kickBox = [x0, y0, bw, bh, sc];\")\nopen('src/31-hud.js','w').write(s)\ned('src/50-dev.js',\"      TT.prompt(g, this.frozen ? '{b:l1}{b:r1} TABS  {b:x} PICK  {b:sq} RESET  {b:tri} LIVE  {b:ci} CLOSE' : '{b:tri} FREEZE  {b:ci} CLOSE  MOUSE: DRAG', x0 + pw / 2, H - 14, TT.game.input);\",\n\"      if (this.frozen) { TT.prompt(g, '{b:l1}{b:r1} TABS  {b:x} PICK  {b:sq} RESET', x0 + pw / 2, H - 26, TT.game.input); TT.prompt(g, '{b:tri} GO LIVE  {b:ci} CLOSE', x0 + pw / 2, H - 13, TT.game.input); }\\n      else TT.prompt(g, '{b:tri} FREEZE  {b:ci} CLOSE  MOUSE DRAGS', x0 + pw / 2, H - 13, TT.game.input);\")\ned('src/50-dev.js',\"vis = Math.max(6, Math.floor((H - 70) / 15))\",\"vis = Math.max(6, Math.floor((H - 80) / 15))\")\ned('src/42-modes.js',\"{ y: 150, w: 200, rowH: 20, scale: 1,\",\"{ y: 126, w: 200, rowH: 17, scale: 1,\")\ned('src/42-modes.js',\"E.ui.box(g, x, y, cw, 104, {\",\"E.ui.box(g, x, y, cw, 88, {\")\ned('src/42-modes.js',\"E.font.text(g, TT.venueById(c.venue).name, x + cw / 2, y + 62,\",\"E.font.text(g, TT.venueById(c.venue).name, x + cw / 2, y + 58,\")\ned('src/42-modes.js',\"next ? 'NEXT' : 'LOCKED', x + cw / 2, y + 86,\",\"next ? 'NEXT' : 'LOCKED', x + cw / 2, y + 74,\")\ned('src/42-modes.js',\"TT.prompt(g, '{b:confirm} NEXT  {b:tri} SKIP', r.W - 60, 5, TT.game.input);\",\"TT.prompt(g, '{b:confirm} NEXT  {b:tri} SKIP', 52, 5, TT.game.input);\")\ned('src/42-modes.js',\"    else { r.prop('banner', 60, 20, 30, { color: '#4aa0e0' });\",\"    else { for (const py of [130, 190]) r.queue(160, py * .5 + 40, 0, g => { 