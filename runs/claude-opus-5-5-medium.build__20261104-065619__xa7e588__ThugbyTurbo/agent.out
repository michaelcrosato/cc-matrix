n\"  let mx = it.mx || 0, my = it.my || 0;\\n  if (p.superK === 'hurricane') { const h = holder(); if (h && h.team !== p.team) { const dx = h.x - p.x, dy = h.y - p.y, dd = Math.hypot(dx, dy) || 1; mx = dx / dd; my = dy / dd; } }\\n  const m = Math.hypot(mx, my); if (m > 1) { mx /= m; my /= m; }\",1)\nopen(p,'w').write(s)\np='12-setpieces.js'; s=open(p).read()\nold=s[s.index(\"    for (const it of H) {\\n      const v = (it.my || 0) * (d > 0 ? 1 : 1);\"):s.index(\"      if (it.wheel)\")]\ns=s.replace(old,\"    for (const it of H) {\\n      if (Math.abs(it.mx) > .3) ph.dist = clamp(ph.dist - it.mx * d * 140 * dt, 51, 400);\\n      if (Math.abs(it.my) > .3) ph.dist = clamp(ph.dist - it.my * 140 * dt, 51, 400);\\n\",1)\ns=s.replace(\"        else ph.aim = clamp(ph.aim + (it.mx || 0) * -d * 0 + (it.mx || 0) * 70 * dt, -60, 60);\",\"        else ph.aim = clamp(ph.aim + (it.mx || 0) * 70 * dt, -60, 60);\",1)\ns=s.replace(\"  const a = base + Math.atan2(ph.aim + ph.sway * (cpu ? 0 : 1), D) * -dirOf(team) * 0 + Math.atan2((ph.aim + (cpu ? 0 : ph.sway)), D) + hook;\",\"  const a = base + Math.atan2(ph.aim + (cpu ? 0 : ph.sway), D) + hook;\",1)\ns=s.replace(\"    if (ended) { M.ph.ended = true; setTimeoutSim(1.6, fullTime); }\",\"    if (ended && M.phase === 'setkick') M.ph.ended = true;\",1)\ns=s.replace(\"  if (s === 'result' && st > 1.6) {\\n\",\"  if (s === 'result' && st > 1.6) {\\n    if (ph.ended) return fullTime();\\n\",1)\nopen(p,'w').write(s)\nEOF\ngrep -n \"goalFlight(prevX)\\|isFree(p) && !hold\\|hurricane') { const h\\|ph.ended) return\" *.js | head","description":"Apply integration fixes to sim files"}}}
