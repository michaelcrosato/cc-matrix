', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']], apply: (g, v) => { g.input.glyphs = v; } },\n3656: *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\n3670: *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /) */\n3671:Input.halfKeys = (preset, side) => {\n3678:const _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\n3700:  const I = P[0]; if (q.half && !I.half) { I._full = I.preset; I.half = 'left'; I.use(Input.halfKeys(I._full, 'left')); }   // player 1 moves to the left half\n3774:  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\n8873:class Dialog {\n9029:class Menu {\n10389:class Arcade {","is_error":false}]},"parent_tool_use_id":null,"session_id":"0b392508-0a9c-4851-a1e8-b9fce2e4b886","uuid":"fdd6d74c-aad1-432b-be40-523e27fc31a5","timestamp":"2026-11-04T13:57:32.029Z","tool_use_result":{"stdout":"3:7519:  blip: { wave: 'square', freq: 1200, dur: .025, vol: .1 }\n12:8874:  /** new E.Dialog(game, { speed, lines, place, color, nameColor, voice, bg, border, vars }): a dialog box that types\n13:8880:     *  text's color; nameColor: the speaker's name's color; voice: the sound effect each letter blips ('text'; null\n15:8931:    this.name = o.name || null; this.onDone = o.onDone || null; this.choices = o.choices || null; this.onChoice = o.onChoice || null; this._blip = 0;\n16:8956:    if (this.voice && Math.floor(this.shown) > prev && (this._blip++ % 2 === 0)) this.game.audio.sfx(this.voice);\n17:10482:      const turn = d => { e.name[e.i] = (e.name[e.i] + d + LETTERS.length) % LETTERS.length; this.game.audio.sfx('blip'); };\n789:    /** glyphs: the gamepad's button symbols for label(): 'auto' (from the