s }, place: 'Brightwater', level: hero.lv });   // what a save holds\n *      game.saves.read = save => { hero = save.data.hero; ... };                                    // what a load does\n *      game.saves.save(0); game.saves.load(0); game.saves.copy(0, 1); game.saves.erase(1); game.saves.autosave();\n *      game.saves.list()   // the slots, autosave first: [{ slot: 'auto' | 0 | 1 | 2, empty, place, level, time, at, damaged, newer }]\n *    new E.Game({ menu: { saves: true } }) puts Save (while saves.canSave: a JRPG sets it at a save point) and Load in\n *    the pause menu, each opening the standard screen (the slots with their place, level and time; save, load, copy and\n *    erase, asking before a save is lost); game.saves.show('save' | 'load') opens it from a game's own menu or title.\n *    menu: { saves: { slots: 3, version: 2, migrate(data, from) { ...; return data; } } } sets them.\n * ============================================================================= */\nconst SAVE_FORMAT = 1;   // the record's own shape: { v, version, data, place, level, time, at }\nclass Saves {\n  /** game.saves (made when first read): o is menu.saves ({ slots, version, migrate, write, read }) */\n  constructor(game, o) {\nclass Renderer {\n  /** the r handed to draw(r), made by the game */\n  constructor(game) {\n    /** game: its game; items: this frame's queue (sorted by depth when the frame ends) */\n    this.game = game; this._items = []; this._decals = []; this._overlays = [];\n    this._aCv = mkCanvas(AS, AS); this._aG = ctx2d(this._aCv);\n    // track what each actor actually draws, so outlines, tints and rim light only touch that rectangle\n    const aG = this._aG, bb = this._bb = [AS, AS, 0, 0], fr = aG.fillRect.bind(aG), di = aG.drawImage.bind(aG);\n    const grow = (x, y, w, h) => { if (x < bb[0]) bb[0] = x; if (y < bb[1]) bb[1] = y; if (x + w > bb[2]) bb[2] = x + w; if (y + h > bb[3]) bb[3] = y + h; };\n    aG.fillRect = (x, y, w, h) => { grow(x, y, w, h); fr(x, y, w, h); };\n    aG.drawImage = (img, ...a) => { if (a.length >= 8) grow(a[4], a[5], a[6], a[7]); else if (a.length >= 4) grow(a[0], a[1], a[2], a[3]); else grow(a[0], a[1], img.width, img.height); di(img, ...a); };\n    for (const m of ['fill', 'stroke', 'fillText', 'strokeText', 'putImageData']) { const f = aG[m].bind(aG); aG[m] = (...a) => { grow(0, 0, AS, AS); return f(...a); }; }\n    this._R = [0, 0, AS, AS];\n    this._mCv = mkCanvas(AS, AS); this._mG = ctx2d(this._mCv);\n    this._rCv = mkCanvas(AS, AS); this._rG = ctx2d(this._rCv);\n    this._xCv = mkCanvas(8, 8); this._xG = ctx2d(this._xCv); this._xoCv = mkCanvas(8, 8); this._xoG = ctx2d(this._xoCv);   // x-ray silhouettes (checkered fill) and their solid outlines\n    this._oCv = mkCanvas(8, 8); this._oG = ctx2d(this._oCv);\n    this._eCv = mkCanvas(8, 8); this._eG = ctx2d(this._eCv); this._sCv = mkCanvas(8, 8); this._sG = ctx2d(this._sCv);   // canvas lighting: the glow mask, a scratch layer\n    this._ghostPool = Array.from({ length: 10 }, () => { const c = mkCanvas(AS, AS); return { cv: c, g: ctx2d(c) }; });\n    /** ghosts: the afterimages fading out (actor option ghost) */\n    this._ghostIdx = 0; this._ghosts = [];\n    const ck = mkCanvas(2, 2), cg = ck.getContext('2d'); cg.fillStyle = '#000'; cg.fillRect(0, 0, 1, 1); cg.fillRect(1, 1, 1, 1);\n    /** checker: a 2 x 2 checkerboard canvas (a pattern for x-ray and dithered fills) */\n    this._checker = ck;\n    /** outline: the color of the 1-pixel outline round every actor; rim: the rim light's color on actors' lit edges;\n     *  rimAlpha: its strength 0..1; xrayColor: the default color of x-ray silhouettes; xrayOutline: the default 1-px\n     *  outline round a silhouette's hidden part (null for none); glowMask: false lets emissive\n     *  glows show over everything under canvas lighting (cheaper: the default keeps walls and bodies in front of a glow\n     *  dark) */\n    this.outline = '#140c1c'; this.rim = '#ffe2b8'; this.rimAlpha = .28; this.xrayColor = '#8fe3ff'; this.xrayOutline = '#e8fdff'; this.glowMask = true;\n    // GPU mode: a hidden \"info\" image (height, surface type, glow) and an unlit overlay image\n    this._iCv = mkCanvas(8, 8); this._iG = this._iCv.getContext('2d'); this._iG._info = true; this._iG._r = this; this._iG._mat = '#000';\n    /** gpu: true during a frame drawn with GPU lighting (draw code can check r.gpu) */\n    this._vCv = mkCanvas(8, 8); this._vG = ctx2d(this._vCv); this.gpu = false; this._tg = null;\n  }\n  /** current draw target for ground helpers (switches during GPU info and overlay passes) */\n  get tgt() { return this._tg || this.ctx; }\n  /** the low-resolution buffer's 2D context: draw on it with E.px */\n  get ctx() { return this.game.screen.ctx; }\n  /** the view this frame is drawn in (the game's, with zoom and turn) */\n  get view() { return this.game.view; }\n  /** pixels per world unit on the ground here: the view's scale times the zoom (iso 1.41, the others 1.5, overhead 1, at\n   *  zoom 1). Rigs, maps and props grow with it; a sprite's pixel is a screen pixel at zoom 1 unless drawn with world: true */\n  get ppu() { return (this.view.scale || 1) * (this.view.zoom || 1); }\n  /** the screen's width in game pixels */\n  get W() { return this.game.screen.W; }\n  /** the screen's height in game pixels */\n  get H() { return this.game.screen.H; }\n  /** the buffer's width (W + 2: a pixel of margin each side for the sub-pixel camera) */\n  get bw() { return this.game.screen.buf.width; }\n  /** the buffer's height (H + 2) */\n  get bh() { return this.game.screen.buf.height; }\n  /** start a frame with the camera at (cx, cy) projected pixels (the game calls it before your draw) */\n  _begin(cx, cy, vp) {\n    const sc = this.game.screen; this._frameNo = (this._frameNo || 0) + 1;   // (kept actor images count frames drawn)\n    sc._begin(cx, cy, this.game.o.bg, vp); this._vp = vp || null;\n    if (vp) { const g = this.ctx; g.save(); g.beginPath(); g.rect(vp.x, vp.y, vp.w, vp.h); g.clip(); }   // (a viewport: the scene drawn inside it, the floor too)\n    /** ix, iy: the camera's whole-pixel offset this frame (a world point is at r.w(x, y, z) on the buffer) */\n    this.ix = sc.ix; this.iy = sc.iy; this._items.length = 0; this._decals.length = 0; this._overlays.length = 0; this._map = null; (this._emis || (this._emis = [])).length = 0;\n    const st = this.game.stats; st.actors = 0; st.culled = 0;\n    if (this._xCv.width !== this.bw || this._xCv.height !== this.bh) { this._xCv.width = this._xoCv.width = this._oCv.width = this._eCv.width = this._sCv.width = this.bw; this._xCv.height = this._xoCv.height = this._oCv.height = this._eCv.height = this._sCv.height = this.bh; }\n * to a hex color; '.' and ' ' are transparent. scale (whole number) enlarges each pixel.\n *   const COIN = E.sprite(['.yy.', 'yYYy', 'yYYy', '.yy.'], { y: '#f0b020', Y: '#fff0a0' });\n * Draw it with r.sprite(x, y, z, COIN) (depth sorted) or px.sprite(g, COIN, sx, sy).\n */\nfunction sprite(rows, colors = {}, scale = 1) {\n  if (typeof rows === 'string') rows = rows.split('\\n');\n  rows = rows.map(s => String(s));\n  const s = Math.max(1, Math.round(scale)), w = Math.max(1, ...rows.map(r => r.length)) * s, h = Math.max(1, rows.length) * s;\n  const cv = mkCanvas(w, h), g = ctx2d(cv), fl = mkCanvas(w, h), fg = ctx2d(fl), runs = [];\n  rows.forEach((row, y) => {\n    for (let x = 0; x < row.length;) {\n      const ch = row[x];\n      if (ch === '.' || ch === ' ') { x++; continue; }\n      let n = 1; while (x + n < row.length && row[x + n] === ch) n++;\n      const c = colors[ch];\n      if (!c) warn('sprite:' + ch, 'sprite character \"' + ch + '\" has no color in the colors map (drawn magenta)');\n      g.fillStyle = c || '#ff00ff'; g.fillRect(x * s, y * s, n * s, s);\n      fg.fillStyle = c || '#ff00ff'; fg.fillRect(w - (x + n) * s, y * s, n * s, s);\n      runs.push([x * s, y * s, n * s, s]);\n      x += n;\n    }\n  });\n  return { w, h, cv, fl, runs, isSprite: true, _src: [rows, colors, s] };\n}\nE.sprite = sprite;\n/** draw a sprite with its top-left corner at buffer pixel (x, y). flip mirrors it left-right; or o: { flip, rot (radians,\n3054:  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n3059:  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n3060:  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n13136:  ahead), voice: { wave: 'square', vol: .2, dur: .09 } (the call notes' sound), on: { judge(j, note), fail(rh),\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"mkdir -p 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tools'\ncat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/package.json' <<'EOF'\n{\\\"name\\\":\\\"orbit-invadettes\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node tools/build.mjs\\\",\\\"test\\\":\\\"node tools/test.mjs\\\"}}\nEOF\ncat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tools/build.mjs' <<'EOF'\nimport {readFile,writeFile} from 'node:fs/promises';\nimport {execFileSync} from 'node:child_process';\nimport {fileURLToPath} from 'node:url';\nimport path from 'node:path';\nconst root=fileURLToPath(new URL('..',import.meta.url));\nconst cfg=JSON.parse(await readFile(path.join(root,'../build-config.json'),'utf8'));\nexecFileSync('bun',['build','./src/app.js','--target','browser','--outfile','./game.bundle.js'],{cwd:root,stdio:'pipe'});\nconst get=f=>readFile(path.join(root,f),'utf8');\nconst [hub,engine,game,css]=await Promise.all(['vendor/session.js','vendor/my-3d2dge.js','game.bundle.js','src/style.css'].map(get));\nif (/<\\\\/script/i.test(hub)) throw Error('Pristine Hub client contains a closing script; embedding requires inspection');\nconst safe=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst html=\"'`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>${hub}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Orbit Invadettes</title>\n<meta name=\"theme-color\" content=\"#07141e\">\n<meta name=\"description\" content=\"Cut a lane. Catch the scrap. Keep your planet. A complete solo and co-op planetary defense arcade game.\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-mode\" content=\"shared-world\"><meta name=\"hub:session-players\" content=\"1-2\">\n<meta name=\"hub:session-goal\" content=\"Defend three outposts through six formations, then break the hostile flagship. Share cover and repair it with salvage.\">\n<meta name=\"hub:session-howto\" content=\"Move: stick, D-pad, A/D or arrows. Hold R2/Cross, Space or left mouse to fire. L1/Square, Q or right mouse repairs. Options/Escape opens local settings.\">\n<meta name=\"hub:session-minutes\" content=\"12\">\n<style>${css}</style></head><body>\n<canvas id=\"screen\" aria-label=\"Orbit Invadettes planetary defense playfield\"></canvas>\n<div id=\"ui\" aria-live=\"polite\"></div>\n<div id=\"play-ui\"><button id=\"pause-button\" aria-label=\"Pause or local options\">Ⅱ</button><button id=\"repair-button\">REPAIR <span>Q</span></button></div>\n<div id=\"notice\" role=\"status\"></div>\n<script>${safe(engine)}</script><script>${safe(game)}</script>\n</body></html>`;\nawait writeFile(path.join(root,'\"'../',cfg.html),html);\nawait writeFile(path.join(root,'index.html'),html);\nconsole.log(cfg.html);\nEOF\ncat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/style.css' <<'EOF'\n:root{color-scheme:dark;--ink:#08151f;--navy:#102735;--mint:#b4f5cf;--bright:#e6f9de;--muted:#90aaa9;--coral:#ff997e;--gold:#ffdc8b;--line:#52736c}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#07131c;color:var(--bright);font-family:\\\"Trebuchet MS\\\",Arial,sans-serif}button,input{font:inherit}button{cursor:pointer}canvas{display:block;width:100%;height:100%;image-rendering:pixelated;touch-action:none}#ui{position:fixed;inset:0;pointer-events:none;display:flex;align-items:center;justify-content:center;padding:clamp(20px,4vw,68px);z-index:10}#ui>*{pointer-events:auto}.screen{width:min(1160px,94vw);max-height:94dvh;position:relative;animation:arrive .2s ease-out}.menu-screen{width:min(720px,92vw);padding:32px 42px;background:linear-gradient(145deg,#0b202cf5,#0a1723f8);border:1px solid #5c887a;box-shadow:0 18px 90px #0009,inset 0 0 0 5px #15313a}.title-screen{width:min(1480px,94vw);display:grid;grid-template-columns:1.3fr 1fr;gap:6%;align-items:center}.eyebrow{text-transform:uppercase;letter-spacing:.27em;font-size:clamp(12px,1vw,19px);font-weight:bold;color:var(--mint);margin:0 0 18px}.logo{font-size:clamp(52px,6.8vw,126px);line-height:.82;letter-spacing:-.075em;font-weight:1000;text-transform:uppercase;margin:0;color:var(--mint);text-shadow:0 5px 0 #337f78,0 9px 0 #102f38;transform:rotate(-3deg);font-family:Impact,\\\"Arial Black\\\",sans-serif}.logo span{display:block;color:var(--coral);margin-left:3%;text-shadow:0 5px 0 #a3424c,0 9px 0 #391f32}.tagline{font-size:clamp(17px,1.55vw,28px);line-height:1.5;margin:32px 0 0;max-width:570px;color:#d7e3d1}.edition{font-size:clamp(11px,.9vw,17px);letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-top:32px}.menu-card{background:#091e2bdb;padding:32px;border:1px solid #57877b;box-shadow:8px 8px 0 #020d1680}.menu-title{font-size:clamp(24px,2.4vw,42px);margin:0 0 12px;letter-spacing:-.03em}.sub{font-size:clamp(15px,1.25vw,24px);line-height:1.45;color:var(--muted);margin:0 0 22px}.actions{display:flex;flex-direction:column;gap:9px}.action{border:1px solid #446a65;background:#16303a;color:#e4efdb;text-align:left;padding:13px 20px;font-size:clamp(18px,1.5vw,28px);font-weight:bold;min-height:50px;position:relative;transition:background .1s,transform .1s;outline:none}.action small{display:block;font-size:.6em;font-weight:normal;color:#a3bab0;line-height:1.4;margin-top:4px}.action.focused,.action:focus-visible{color:var(--ink);background:var(--mint);border-color:#e4ffce;transform:translateX(4px);box-shadow:-5px 0 0 var(--coral)}.action.focused small{color:#285347}.action:disabled{opacity:.5;cursor:default}.action.secondary{background:transparent;border-color:#34534f;font-size:clamp(16px,1.2vw,23px);padding:10px 20px}.action.secondary.focused{background:var(--mint)}.foot{font-size:clamp(12px,1vw,18px);color:var(--muted);margin-top:20px;line-height:1.5}.accent{color:var(--gold)}.pill{display:inline-block;padding:6px 10px;border:1px solid #6c8977;color:var(--mint);font-size:clamp(12px,.95vw,17px);letter-spacing:.08em;margin-bottom:20px}.control-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0}.control-grid div{background:#173139;border-left:3px solid var(--coral);padding:14px;font-size:clamp(14px,1.2vw,21px);line-height:1.5}.control-grid strong{display:block;font-size:1.1em;color:var(--mint)}.setting-row{display:grid;grid-template-columns:1fr auto;gap:8px 18px;align-items:center;border:1px solid #3c5b57;padding:10px 16px;font-size:clamp(15px,1.2vw,22px);background:#143039}.setting-row.focused{border-color:var(--mint);box-shadow:-4px 0 var(--coral)}.setting-row input[type=range]{accent-color:var(--mint);width:180px;max-width:35vw}.setting-row .value{color:var(--gold);font-variant-numeric:tabular-nums;font-size:.85em}.setting-row small{grid-column:1/-1;color:var(--muted);font-size:.68em;line-height:1.3}.setting-row select,.seed{color:var(--bright);background:#071823;border:1px solid #658d7d;padding:8px;max-width:200px}.page-number{color:var(--coral);font-size:.55em;float:right;letter-spacing:.1em;margin-top:10px}.report-screen{width:min(1050px,94vw)}.report-body{font-size:clamp(14px,1.25vw,23px);line-height:1.45;color:#c7d8ce;max-height:52dvh;overflow-y:auto;padding-right:10px}.report-body p{margin:0 0 16px}.report-body strong{color:var(--mint)}.report-body a{color:var(--gold)}.page-actions{display:flex;gap:12px;margin-top:22px}.page-actions .action{flex:1;text-align:center}.score{font-size:clamp(44px,5vw,90px);font-weight:bold;color:var(--gold);line-height:1;margin:20px 0}.contributions{display:flex;gap:30px;font-size:clamp(16px,1.4vw,25px);line-height:1.6;margin-bottom:20px}.record-row{display:grid;grid-template-columns:1fr auto;gap:18px;padding:12px 0;border-bottom:1px solid #36544e;font-size:clamp(16px,1.4vw,25px)}.record-row small{color:var(--muted);font-size:.7em}.demo-banner{position:fixed;top:5%;left:50%;transform:translateX(-50%);background:#071823e8;border:1px solid var(--mint);padding:16px 30px;text-align:center;pointer-events:none\"'!important}.demo-banner strong{font-size:clamp(20px,2.2vw,40px);letter-spacing:.16em}.demo-banner p{margin:8px 0 0;color:var(--gold);font-size:clamp(14px,1.2vw,22px)}#play-ui{position:fixed;inset:0;pointer-events:none;z-index:11}#play-ui button{pointer-events:auto;position:absolute;background:#0d2935d9;color:var(--mint);border:1px solid #8ebda5;padding:12px 18px;font-weight:bold;min-width:48px;min-height:48px;display:none;touch-action:none}#pause-button{right:max(14px,env(safe-area-inset-right));top:max(14px,env(safe-area-inset-top));font-size:20px}#repair-button{right:5%;bottom:8%;font-size:17px}#repair-button span{color:var(--gold)}#notice{position:fixed;left:50%;bottom:5%;transform:translateX(-50%);max-width:90%;background:#0b2635f5;border:1px solid #719782;color:var(--gold);padding:12px 24px;font-size:clamp(16px,1.3vw,25px);text-align:center;pointer-events:none;z-index:20;opacity:0;transition:opacity .1s}.dev-screen{width:min(1000px,95vw)}.dev-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.dev-summary{font-family:monospace;color:var(--gold);font-size:clamp(13px,1vw,19px);padding:12px;background:#061720;white-space:pre-wrap;margin:12px 0}.dev-screen .actions{gap:7px}.dev-screen .action{font-size:clamp(14px,1.1vw,21px);padding:9px 14px;min-height:42px}.local-live{color:var(--coral);font-weight:bold}\n@keyframes arrive{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n@media (max-width:700px),(max-aspect-ratio:4/5){#ui{padding:16px}.title-screen{display:flex;flex-direction:column;gap:26px;width:min(520px,92vw)}.title-art{width:100%;text-align:center}.logo{font-size:clamp(48px,13vw,90px);line-height:.82}.tagline{font-size:17px;line-height:1.35;margin:24px auto 0;max-width:330px}.eyebrow{font-size:11px;margin-bottom:15px}.edition{display:none}.menu-card{padding:18px;width:100%}.menu-title{font-size:26px}.sub{font-size:16px;margin-bottom:15px}.action{font-size:20px;min-height:46px;padding:10px 15px}.action.secondary{font-size:17px;padding:8px 15px}.actions{gap:7px}.foot{font-size:12px;margin-top:14px}.menu-screen{padding:24px;width:94vw;max-height:94dvh;overflow:auto}.control-grid{grid-template-columns:1fr;gap:8px}.control-grid div{font-size:15px;padding:9px}.setting-row{font-size:16px;padding:9px 12px}.setting-row input[type=range]{width:125px}.report-body{font-size:16px;max-height:53dvh}.dev-grid{grid-template-columns:1fr}.dev-summary{font-size:11px}.page-actions{gap:8px}.page-actions .action{font-size:15px}.contributions{font-size:16px;gap:20px}.demo-banner{top:10%}#repair-button{bottom:14%;right:5%}}\n@media (max-height:560px) and (min-aspect-ratio:4/3){.screen{max-height:96dvh}.menu-screen{padding:18px 26px;overflow:auto}.menu-title{font-size:26px;margin-bottom:6px}.sub{font-size:15px;margin-bottom:12px}.menu-card{padding:20px}.action{font-size:18px;min-height:36px;padding:8px 15px}.action.secondary{font-size:15px;padding:6px 15px}.actions{gap:5px}.foot{font-size:11px;margin-top:10px}.tagline{font-size:17px;margin-top:25px}.eyebrow{font-size:10px}.edition{font-size:10px;margin-top:15px}.report-body{font-size:15px;max-height:47dvh}.setting-row{font-size:15px;padding:6px 12px}.control-grid{gap:8px;margin:10px 0}.control-grid div{font-size:14px;padding:9px}.page-actions{margin-top:14px}.dev-screen .action{font-size:13px;padding:6px 12px;min-height:30px}.score{font-size:50px;margin:10px 0}.contributions{font-size:14px;margin-bottom:12px}}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"mkdir -p 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tools'\ncat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/package.json' <<'EOF'\n{\\\"name\\\":\\\"orbit-invadettes\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node tools/build.mjs\\\",\\\"test\\\":\\\"node tools/test.mjs\\\"}}\nEOF\ncat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tools/build.mjs' <<'EOF'\nimport {readFile,writeFile} from 'node:fs/promises';\nimport {execFileSync} from 'node:child_process';\nimport {fileURLToPath} from 'node:url';\nimport path from 'node:path';\nconst root=fileURLToPath(new URL('..',import.meta.url));\nconst cfg=JSON.parse(await readFile(path.join(root,'../build-config.json'),'utf8'));\nexecFileSync('bun',['build','./src/app.js','--target','browser','--outfile','./game.bundle.js'],{cwd:root,stdio:'pipe'});\nconst get=f=>readFile(path.join(root,f),'utf8');\nconst [hub,engine,game,css]=await Promise.all(['vendor/session.js','vendor/my-3d2dge.js','game.bundle.js','src/style.css'].map(get));\nif (/<\\\\/script/i.test(hub)) throw Error('Pristine Hub client contains a closing script; embedding requires inspection');\nconst safe=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nconst html=\"'`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<script>${hub}</script>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>Orbit Invadettes</title>\n<meta name=\"theme-color\" content=\"#07141e\">\n<meta name=\"description\" content=\"Cut a lane. Catch the scrap. Keep your planet. A complete solo and co-op planetary defense arcade game.\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-mode\" content=\"shared-world\"><meta name=\"hub:session-players\" content=\"1-2\">\n<meta name=\"hub:session-goal\" content=\"Defend three outposts through six formations, then break the hostile flagship. Share cover and repair it with salvage.\">\n<meta name=\"hub:session-howto\" content=\"Move: stick, D-pad, A/D or arrows. Hold R2/Cross, Space or left mouse to fire. L1/Square, Q or right mouse repairs. Options/Escape opens local settings.\">\n<meta name=\"hub:session-minutes\" content=\"12\">\n<style>${css}</style></head><body>\n<canvas id=\"screen\" aria-label=\"Orbit Invadettes planetary defense playfield\"></canvas>\n<div id=\"ui\" aria-live=\"polite\"></div>\n<div id=\"play-ui\"><button id=\"pause-button\" aria-label=\"Pause or local options\">Ⅱ</button><button id=\"repair-button\">REPAIR <span>Q</span></button></div>\n<div id=\"notice\" role=\"status\"></div>\n<script>${safe(engine)}</script><script>${safe(game)}</script>\n</body></html>`;\nawait writeFile(path.join(root,'\"'../',cfg.html),html);\nawait writeFile(path.join(root,'index.html'),html);\nconsole.log(cfg.html);\nEOF\ncat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/style.css' <<'EOF'\n:root{color-scheme:dark;--ink:#08151f;--navy:#102735;--mint:#b4f5cf;--bright:#e6f9de;--muted:#90aaa9;--coral:#ff997e;--gold:#ffdc8b;--line:#52736c}\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#07131c;color:var(--bright);font-family:\\\"Trebuchet MS\\\",Arial,sans-serif}button,input{font:inherit}button{cursor:pointer}canvas{display:block;width:100%;height:100%;image-rendering:pixelated;touch-action:none}#ui{position:fixed;inset:0;pointer-events:none;display:flex;align-items:center;justify-content:center;padding:clamp(20px,4vw,68px);z-index:10}#ui>*{pointer-events:auto}.screen{width:min(1160px,94vw);max-height:94dvh;position:relative;animation:arrive .2s ease-out}.menu-screen{width:min(720px,92vw);padding:32px 42px;background:linear-gradient(145deg,#0b202cf5,#0a1723f8);border:1px solid #5c887a;box-shadow:0 18px 90px #0009,inset 0 0 0 5px #15313a}.title-screen{width:min(1480px,94vw);display:grid;grid-template-columns:1.3fr 1fr;gap:6%;align-items:center}.eyebrow{text-transform:uppercase;letter-spacing:.27em;font-size:clamp(12px,1vw,19px);font-weight:bold;color:var(--mint);margin:0 0 18px}.logo{font-size:clamp(52px,6.8vw,126px);line-height:.82;letter-spacing:-.075em;font-weight:1000;text-transform:uppercase;margin:0;color:var(--mint);text-shadow:0 5px 0 #337f78,0 9px 0 #102f38;transform:rotate(-3deg);font-family:Impact,\\\"Arial Black\\\",sans-serif}.logo span{display:block;color:var(--coral);margin-left:3%;text-shadow:0 5px 0 #a3424c,0 9px 0 #391f32}.tagline{font-size:clamp(17px,1.55vw,28px);line-height:1.5;margin:32px 0 0;max-width:570px;color:#d7e3d1}.edition{font-size:clamp(11px,.9vw,17px);letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-top:32px}.menu-card{background:#091e2bdb;padding:32px;border:1px solid #57877b;box-shadow:8px 8px 0 #020d1680}.menu-title{font-size:clamp(24px,2.4vw,42px);margin:0 0 12px;letter-spacing:-.03em}.sub{font-size:clamp(15px,1.25vw,24px);line-height:1.45;color:var(--muted);margin:0 0 22px}.actions{display:flex;flex-direction:column;gap:9px}.action{border:1px solid #446a65;background:#16303a;color:#e4efdb;text-align:left;padding:13px 20px;font-size:clamp(18px,1.5vw,28px);font-weight:bold;min-height:50px;position:relative;transition:background .1s,transform .1s;outline:none}.action small{display:block;font-size:.6em;font-weight:normal;color:#a3bab0;line-height:1.4;margin-top:4px}.action.focused,.action:focus-visible{color:var(--ink);background:var(--mint);border-color:#e4ffce;transform:translateX(4px);box-shadow:-5px 0 0 var(--coral)}.action.focused small{color:#285347}.action:disabled{opacity:.5;cursor:default}.action.secondary{background:transparent;border-color:#34534f;font-size:clamp(16px,1.2vw,23px);padding:10px 20px}.action.secondary.focused{background:var(--mint)}.foot{font-size:clamp(12px,1vw,18px);color:var(--muted);margin-top:20px;line-height:1.5}.accent{color:var(--gold)}.pill{display:inline-block;padding:6px 10px;border:1px solid #6c8977;color:var(--mint);font-size:clamp(12px,.95vw,17px);letter-spacing:.08em;margin-bottom:20px}.control-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:20px 0}.control-grid div{background:#173139;border-left:3px solid var(--coral);padding:14px;font-size:clamp(14px,1.2vw,21px);line-height:1.5}.control-grid strong{display:block;font-size:1.1em;color:var(--mint)}.setting-row{display:grid;grid-template-columns:1fr auto;gap:8px 18px;align-items:center;border:1px solid #3c5b57;padding:10px 16px;font-size:clamp(15px,1.2vw,22px);background:#143039}.setting-row.focused{border-color:var(--mint);box-shadow:-4px 0 var(--coral)}.setting-row input[type=range]{accent-color:var(--mint);width:180px;max-width:35vw}.setting-row .value{color:var(--gold);font-variant-numeric:tabular-nums;font-size:.85em}.setting-row small{grid-column:1/-1;color:var(--muted);font-size:.68em;line-height:1.3}.setting-row select,.seed{color:var(--bright);background:#071823;border:1px solid #658d7d;padding:8px;max-width:200px}.page-number{color:var(--coral);font-size:.55em;float:right;letter-spacing:.1em;margin-top:10px}.report-screen{width:min(1050px,94vw)}.report-body{font-size:clamp(14px,1.25vw,23px);line-height:1.45;color:#c7d8ce;max-height:52dvh;overflow-y:auto;padding-right:10px}.report-body p{margin:0 0 16px}.report-body strong{color:var(--mint)}.report-body a{color:var(--gold)}.page-actions{display:flex;gap:12px;margin-top:22px}.page-actions .action{flex:1;text-align:center}.score{font-size:clamp(44px,5vw,90px);font-weight:bold;color:var(--gold);line-height:1;margin:20px 0}.contributions{display:flex;gap:30px;font-size:clamp(16px,1.4vw,25px);line-height:1.6;margin-bottom:20px}.record-row{display:grid;grid-template-columns:1fr auto;gap:18px;padding:12px 0;border-bottom:1px solid #36544e;font-size:clamp(16px,1.4vw,25px)}.record-row small{color:var(--muted);font-size:.7em}.demo-banner{position:fixed;top:5%;left:50%;transform:translateX(-50%);background:#071823e8;border:1px solid var(--mint);padding:16px 30px;text-align:center;pointer-events:none\"'!important}.demo-banner strong{font-size:clamp(20px,2.2vw,40px);letter-spacing:.16em}.demo-banner p{margin:8px 0 0;color:var(--gold);font-size:clamp(14px,1.2vw,22px)}#play-ui{position:fixed;inset:0;pointer-events:none;z-index:11}#play-ui button{pointer-events:auto;position:absolute;background:#0d2935d9;color:var(--mint);border:1px solid #8ebda5;padding:12px 18px;font-weight:bold;min-width:48px;min-height:48px;display:none;touch-action:none}#pause-button{right:max(14px,env(safe-area-inset-right));top:max(14px,env(safe-area-inset-top));font-size:20px}#repair-button{right:5%;bottom:8%;font-size:17px}#repair-button span{color:var(--gold)}#notice{position:fixed;left:50%;bottom:5%;transform:translateX(-50%);max-width:90%;background:#0b2635f5;border:1px solid #719782;color:var(--gold);padding:12px 24px;font-size:clamp(16px,1.3vw,25px);text-align:center;pointer-events:none;z-index:20;opacity:0;transition:opacity .1s}.dev-screen{width:min(1000px,95vw)}.dev-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.dev-summary{font-family:monospace;color:var(--gold);font-size:clamp(13px,1vw,19px);padding:12px;background:#061720;white-space:pre-wrap;margin:12px 0}.dev-screen .actions{gap:7px}.dev-screen .action{font-size:clamp(14px,1.1vw,21px);padding:9px 14px;min-height:42px}.local-live{color:var(--coral);font-weight:bold}\n@keyframes arrive{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\n@media (max-width:700px),(max-aspect-ratio:4/5){#ui{padding:16px}.title-screen{display:flex;flex-direction:column;gap:26px;width:min(520px,92vw)}.title-art{width:100%;text-align:center}.logo{font-size:clamp(48px,13vw,90px);line-height:.82}.tagline{font-size:17px;line-height:1.35;margin:24px auto 0;max-width:330px}.eyebrow{font-size:11px;margin-bottom:15px}.edition{display:none}.menu-card{padding:18px;width:100%}.menu-title{font-size:26px}.sub{font-size:16px;margin-bottom:15px}.action{font-size:20px;min-height:46px;padding:10px 15px}.action.secondary{font-size:17px;padding:8px 15px}.actions{gap:7px}.foot{font-size:12px;margin-top:14px}.menu-screen{padding:24px;width:94vw;max-height:94dvh;overflow:auto}.control-grid{grid-template-columns:1fr;gap:8px}.control-grid div{font-size:15px;padding:9px}.setting-row{font-size:16px;padding:9px 12px}.setting-row input[type=range]{width:125px}.report-body{font-size:16px;max-height:53dvh}.dev-grid{grid-template-columns:1fr}.dev-summary{font-size:11px}.page-actions{gap:8px}.page-actions .action{font-size:15px}.contributions{font-size:16px;gap:20px}.demo-banner{top:10%}#repair-button{bottom:14%;right:5%}}\n@media (max-height:560px) and (min-aspect-ratio:4/3){.screen{max-height:96dvh}.menu-screen{padding:18px 26px;overflow:auto}.menu-title{font-size:26px;margin-bottom:6px}.sub{font-size:15px;margin-bottom:12px}.menu-card{padding:20px}.action{font-size:18px;min-height:36px;padding:8px 15px}.action.secondary{font-size:15px;padding:6px 15px}.actions{gap:5px}.foot{font-size:11px;margin-top:10px}.tagline{font-size:17px;margin-top:25px}.eyebrow{font-size:10px}.edition{font-size:10px;margin-top:15px}.report-body{font-size:15px;max-height:47dvh}.setting-row{font-size:15px;padding:6px 12px}.control-grid{gap:8px;margin:10px 0}.control-grid div{font-size:14px;padding:9px}.page-actions{margin-top:14px}.dev-screen .action{font-size:13px;padding:6px 12px;min-height:30px}.score{font-size:50px;margin:10px 0}.contributions{font-size:14px;margin-bottom:12px}}\n@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/view.js' <<'EOF'\nimport {repairPreview} from './sim.js';\nimport {WAVES,LOCATIONS} from './content.js';\n\nexport function createView(E,game,assets){\n  const {px}=E;\n  const rand=E.rng(92411);\n  const stars=Array.from({length:180},()=>({x:rand(),y:rand(),size:rand()>.94?2:1,t:rand()*7}));\n  const palettes=[\n    {sky:['#06151f','#102937','#254344'],planet:'#8bbcb2',rim:'#c9dbc1',land:'#344f50',ground:'#192f38',bunker:'#81bda7',accent:'#f1ad83'},\n    {sky:['#141327','#292b47','#554658'],planet:'#b8a4cc',rim:'#e6d1ca',land:'#51425c',ground:'#2c293f',bunker:'#ad9ab7',accent:'#e3bc83'},\n    {sky:['#071b29','#15394b','#376168'],planet:'#d7b892',rim:'#ffdda5',land:'#786162',ground:'#23404b',bunker:'#73a8ad',accent:'#ff9c82'}\n  ];\n  let fx=[];\n  function events(list){\n    for(const e of list){\n      if(['kill','armour','loss','repair','erode','pickup','victory','extra'].includes(e.type)){\n        const count=e.type==='loss'?20:e.type==='kill'?9:e.type==='repair'?8:e.type==='erode'?3:6;\n        for(let i=0;i<count;i++){\n          const a=rand()*Math.PI*2,s=10+rand()*40;\n          fx.push({x:e.x??240,y:e.y??140,vx:Math.cos(a)*s,vy:Math.sin(a)*s-10,life:.25+rand()*.45,max:.7,type:e.type,c:Math.floor(rand()*3)});\n        }\n      }\n    }\n    if(fx.length>400)fx=fx.slice(-400);\n  }\n  function update(dt){\n    for(const p of fx){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=65*dt;}\n    fx=fx.filter(p=>p.life>0);\n  }\n  function text(g,s,x,y,c='#e6f9de',opts={}){\n    E.font.text(g,s,Math.round(x),Math.round(y),c,{outline:false,shadow:'#07141e',...opts});\n  }\n  function border(g,x,y,w,h,c){px.line(g,x,y,x+w,y,c);px.line(g,x,y+h,x+w,y+h,c);px.line(g,x,y,x,y+h,c);px.line(g,x+w,y,x+w,y+h,c);}\n  function planet(g,cx,cy,r,p,t){\n    const ramp=E.ramp(p.planet,7);\n    px.disc(g,cx,cy,r+3,p.rim);\n    px.disc(g,cx+1,cy+1,r+1,p.land);\n    for(let yy=-r;yy<=r;yy+=2){\n      const half=Math.sqrt(Math.max(0,r*r-yy*yy));\n      for(let xx=-half;xx<half;xx+=3){\n        const light=(1-(xx/r)*.5-(yy/r)*.32);\n        const zone=Math.max(0,Math.min(6,Math.floor(light*4)));\n        const cloud=Math.sin((xx+yy*.55)*.079)+Math.cos(yy*.18+xx*.021);\n        const c=cloud>.8?ramp[Math.min(6,zone+1)]:cloud<-.7?ramp[Math.max(0,zone-2)]:ramp[zone];\n        px.rect(g,cx+xx,cy+yy,Math.min(3,half-xx),2,c);\n      }\n    }\n    px.poly(g,[[cx+r*.2,cy-r*.91],[cx+r*.78,cy-r*.62],[cx+r*.99,cy],[cx+r*.75,cy+r*.65],[cx+r*.07,cy+r*.99],[cx+r*.58,cy+r*.2]],p.land);\n  }\n  function background(r,world,front=false){\n    const p=palettes[world?.location??0],t=game.real;\n    r.sky(p.sky);\n    r.decal(g=>{\n      const [ox,oy]=r.w(0,0,0);\n      for(let i=0;i<stars.length;i++){\n        const s=stars[i],sx=s.x*r.W,sy=s.y*r.H;\n        const twinkle=Math.sin(t*.8+s.t)>-.35;\n        px.rect(g,sx,sy,s.size,s.size,twinkle?'#638c8e':'#2e505f');\n        if(s.size===2){px.rect(g,sx-2,sy+1,6,1,'#315663');px.rect(g,sx+1,sy-2,1,6,'#315663');}\n      }\n      // A distant planet, rasterized in stepped hue-shifted bands.\n      const pr=front?88:59;\n      planet(g,ox+(front?349:370),oy+(front?96:107),pr,p,t);\n      px.line(g,ox+282,oy+94,ox+457,oy+163,p.land,2);\n      px.line(g,ox+274,oy+98,ox+451,oy+168,p.rim);\n      // Orbital dust and a tiny high-altitude relay.\n      px.rect(g,ox+44,oy+57,16,2,'#456a72');\n      px.rect(g,ox+50,oy+51,4,13,'#819a91');\n      px.rect(g,ox+38,oy+53,8,9,'#233e50');px.rect(g,ox+59,oy+53,8,9,'#233e50');\n      // Extra display area is scenery, never additional combat space.\n      const floor=oy+254;\n      px.rect(g,0,floor,r.W,r.H-floor+2,p.ground);\n      for(let i=0;i<r.W;i+=22)px.line(g,i,floor,i+(i-r.W/2)*.8,r.H,'#304c53');\n      for(let y=floor+8;y<r.H;y+=18)px.line(g,0,y,r.W,y,'#29444d');\n      const horizon=oy+192;\n      for(let x=0;x<r.W;x+=13){\n        const h=5+Math.sin(x*.17)*4+Math.sin(x*.047)*8;\n        px.rect(g,x,horizon-h,14,Math.max(1,floor-horizon+h),p.land);\n        px.rect(g,x+2,horizon-h,3,2,'#486b69');\n      }\n      // The central combat sky stays dark enough for every shot silhouette.\n      px.rect(g,ox+9,oy+27,462,164,'#091d29');\n      for(const s of stars.slice(0,75)){\n        const x=ox+16+s.x*448,y=oy+31+s.y*155;\n        px.dot(g,x,y,s.size===2?'#456977':'#263f50');\n      }\n      px.line(g,ox+15,oy+31,ox+465,oy+31,'#40646a');\n      px.line(g,ox+15,oy+31,ox+15,oy+248,'#31525e');\n      px.line(g,ox+465,oy+31,ox+465,oy+248,'#31525e');\n      // Foreground apron and original-footprint plinths.\n      px.rect(g,ox+15,oy+229,450,25,'#1b3641');\n      for(let x=20;x<461;x+=12)px.rect(g,ox+x,oy+251,7,2,p.accent);\n      for(let x=16;x<465;x+=8)px.line(g,ox+x,oy+230,ox+x+3,oy+230,'#d87877');\n      text(g,'BREACH',ox+16,oy+219,'#b76a77',{font:'tiny'});\n      for(const b of world?.bunkers||[]){\n        px.rect(g,ox+b.x-2,oy+b.y+b.rows*b.cell, b.cols*b.cell+4,4,'#0a1e29');\n        px.line(g,ox+b.x-2,oy+b.y+b.rows*b.cell,ox+b.x+b.cols*b.cell+2,oy+b.y+b.rows*b.cell,'#53706d');\n      }\n      if(r.H>400){\n        const y=oy+308;\n        text(g,'PLANETARY DEFENSE NETWORK',r.W/2,y,'#78998d',{align:'center',scale:2});\n        text(g,'CUT A LANE. CATCH THE SCRAP. KEEP YOUR PLANET.',r.W/2,y+25,'#54796e',{align:'center'});\n        border(g,ox+68,y+55,344,70,'#345958');\n        for(let j=0;j<8;j++){\n          px.rect(g,ox+80+j*41,y+68,31,6,j<4?'#699b8d':'#b07f70');\n          px.rect(g,ox+80+j*41,y+80,31,29,'#102c38');\n          px.line(g,ox+84+j*41,y+101,ox+104+j*41,y+87,'#3a6a69');\n        }\n      }\n    });\n    return p;\n  }\n  function drawBoss(r,w,p){\n    const b=w.boss;if(\"'!b)return;\n    const body=assets.flagship;\n    if(body)r.sprite(b.x,b.y,0,body,{anchor:'\"'center',t:b.age,glow:.25});\n    else r.actor(b.x,b.y,0,(g,x,y)=>{\n      px.poly(g,[[x-68,y-2],[x-48,y-17],[x-17,y-22],[x,y-28],[x+17,y-22],[x+48,y-17],[x+68,y-2],[x+49,y+13],[x-49,y+13]],'#574361');\n      px.poly(g,[[x-62,y-3],[x-45,y-13],[x+45,y-13],[x+62,y-3],[x+38,y+6],[x-38,y+6]],'#9b7a98');\n      px.line(g,x-43,y-14,x+43,y-14,'#f5bcaa',2);\n      for(let i=-2;i<=2;i++)px.rect(g,x+i*18-3,y-10,6,3,'#c7dcd0');\n    });\n    for(const e of b.emitters||[]){\n      r.actor(e.x,e.y,0,(g,x,y)=>{\n        const open=e.open&&e.hp>0;\n        px.rect(g,x-9,y-9,18,18,e.hp>0?'#233c50':'#101c2b');\n        border(g,x-9,y-9,18,18,e.hp>0?'#e2a087':'#52636b');\n        if(e.hp>0){\n          px.disc(g,x,y,open?5:3,open?'#ffdd8b':'#9f7184');\n          if(\"'!open){px.line(g,x-7,y-4,x+7,y-4,'\"'#d2c0b8',2);px.line(g,x-7,y+4,x+7,y+4,'#776f86',2);}\n          for(let k=0;k<e.maxHp;k++)px.rect(g,x-8+k*(16/e.maxHp),y+13,Math.max(1,16/e.maxHp-1),2,k<e.hp?'#ffc797':'#30404e');\n        }\n        if(e.telegraph>0){border(g,x-13,y-13,26,26,'#ff9f85');px.line(g,x,y+15,x,y+25,'#ffd28e');}\n      },{emissive:true});\n    }\n    r.actor(b.x,b.y+3,0,(g,x,y)=>{\n      if(b.phase===2){\n        const open=b.open;\n        px.disc(g,x,y,11,'#112c40');px.disc(g,x,y,8,open?'#f5c47e':'#57697a');\n        if(open){px.disc(g,x-1,y-2,4,'#fff4cc');}\n        else{px.rect(g,x-10,y-2,20,4,'#b9a6b6');}\n      }\n    },{emissive:true});\n    if(b.phase===2&&b.telegraph>0){\n      r.overlay(g=>{\n        const safe=typeof b.safeLane==='number'?b.safeLane:240;\n        const [sx,sy]=r.w(safe,234,0);\n        border(g,sx-22,sy-14,44,22,'#b4f5cf');text(g,'SAFE',sx,sy-10,'#d3ffd4',{align:'center'});\n      });\n    }\n    r.text(b.phase===1?'BREAK BOTH EMITTERS':'EXPOSED CORE',r.W/2,(r.H-270)/2+38,'#ffcf96',{align:'center'});\n  }\n  function drawWorld(r,w,{front=false,attract=false,overlays=false}={}){\n    const p=background(r,w,front);\n    if(\"'!w)return;\n    const preview=w.players.filter(s=>s.active&&s.alive&&s.charges>0).map(s=>({seat:s.seat,...repairPreview(w,s.seat)}));\n    for(const b of w.bunkers){\n      const bi=w.bunkers.indexOf(b),ramp=E.ramp(p.bunker,5);\n      r.actor(b.center,b.y+b.rows*b.cell,0,(g,x,y)=>{\n        const left=x-b.cols*b.cell/2,top=y-b.rows*b.cell;\n        for(let i=0;i<b.mask.length;i++)if(b.mask[i]){\n          const col=i%b.cols,row=Math.floor(i/b.cols),xx=left+col*b.cell,yy=top+row*b.cell;\n          const shade=(col+row*3)%7===0?2:row<2?3:2;\n          px.rect(g,xx,yy,b.cell,b.cell,ramp[shade]);\n          px.rect(g,xx,yy,b.cell,1,ramp[Math.min(4,shade+1)]);\n          px.rect(g,xx+b.cell-1,yy+1,1,b.cell-1,ramp[1]);\n        }\n        for(const q of preview)if(q.bunker===bi&&q.usable){\n          border(g,left-2,top-2,b.cols*b.cell+4,b.rows*b.cell+4,q.seat===0?'\"'#a1d4bb':'#d6a2aa');\n          for(const i of q.cells.slice(0,24)){const xx=left+(i%b.cols)*b.cell,yy=top+Math.floor(i/b.cols)*b.cell;px.dot(g,xx+1,yy+1,'#dbf4c9');}\n        }\n      });\n    }\n    const march=w.formation?.beat||0;\n    for(const e of w.enemies){\n      const spr=e.type==='bombardier'?assets.bombardier:assets.enemies[e.row%4];\n      if(e.telegraph>0)r.actor(e.x,e.y,0,(g,x,y)=>{\n        px.line(g,x-9,y+10,x+9,y+10,'#ffd68e');\n        px.line(g,x-9,y+8,x-9,y+12,'#ffd68e');px.line(g,x+9,y+8,x+9,y+12,'#ffd68e');\n        for(let yy=y+15;yy<y+42;yy+=5)px.dot(g,x,yy,'#ce8e82');\n      },{emissive:true});\n      if(spr)r.sprite(e.x,e.y,0,spr,{anchor:'center',t:march*.125,flash:e.flash>0?'#fff4c9':undefined,glow:.2});\n      if(e.type==='armour'&&e.hp>1){\n        if(assets.armour)r.sprite(e.x,e.y,0,assets.armour,{anchor:'center',t:march*.125});\n        else r.actor(e.x,e.y,0,(g,x,y)=>{px.line(g,x-9,y-6,x+9,y-6,'#e6d8ac',2);px.line(g,x-10,y-5,x-10,y+4,'#8c9bac',2);px.line(g,x+10,y-5,x+10,y+4,'#8c9bac',2);});\n      }\n      if(overlays)r.actor(e.x,e.y,0,(g,x,y)=>border(g,x-7,y-5,14,10,'#ff6d90'),{emissive:true});\n    }\n    if(w.saucer){\n      r.sprite(w.saucer.x,w.saucer.y??43,0,assets.saucer,{anchor:'center',t:w.time,glow:.4});\n      r.textAt(w.saucer.x,(w.saucer.y??43)-15,0,'SCRAP BONUS','#ffcc95',{font:'tiny'});\n    }\n    if(w.boss)drawBoss(r,w,p);\n    for(const b of w.bullets)r.actor(b.x,b.y,0,(g,x,y)=>{\n      if(b.owner>=0){\n        px.rect(g,x-1,y-4,3,8,b.owner===0?'#dffff1':'#ffe3d4');px.rect(g,x,y-5,1,5,b.owner===0?'#a4f5cf':'#ffb69a');px.rect(g,x,y+4,1,3,'#3c787f');\n      }else if(b.kind==='heavy'){\n        px.poly(g,[[x,y-6],[x+5,y-2],[x+5,y+3],[x,y+7],[x-5,y+3],[x-5,y-2]],'#ff997e');\n        px.rect(g,x-2,y-2,4,4,'#fff1c8');px.line(g,x-3,y-8,x+3,y-8,'#d37a83');\n      }else{\n        px.rect(g,x-2,y-4,4,8,'#ff937c');px.rect(g,x-1,y,2,4,'#ffedb7');px.dot(g,x+1,y-6,'#d07883');\n      }\n    },{emissive:true});\n    for(const q of w.pickups){\n      r.sprite(q.x,q.y,0,assets.salvage,{anchor:'center',t:w.time,glow:.8});\n      r.actor(q.x,q.y,0,(g,x,y)=>{px.dot(g,x-7,y-5,'#e4ffd2');px.dot(g,x+6,y+4,'#7dc6b3');},{emissive:true});\n    }\n    for(const s of w.players){\n      if(\"'!s.active)continue;\n      if(!s.alive){\n        if(s.respawn>0)r.textAt(s.x,s.y-15,0,'\"'REDEPLOY','#b4d9c6',{font:'tiny'});\n        continue;\n      }\n      const spr=assets.ships[s.seat%2];\n      r.shadow(s.x,s.y+5,11,.5);\n      if(spr)r.sprite(s.x,s.y+(s.recovery>.2?1:0),0,spr,{anchor:'center',t:w.time,glow:.25,alpha:s.protected>0&&Math.floor(w.time*7)%2?.55:1});\n      r.actor(s.x,s.y,0,(g,x,y)=>{\n        const count=w.bullets.filter(b=>b.owner===s.seat).length;\n        px.rect(g,x-1,y-9,3,2,s.recovery<=0&&count<2?'#eaffd3':'#4a6876');\n        if(s.protected>0)border(g,x-12,y-11,24,20,s.seat===0?'#b4edcd':'#ffbb9e');\n      },{emissive:true});\n      game.lights.add(s.x,s.y,0,28,.22,{color:s.seat===0?'#96dfc0':'#ffb399'});\n    }\n    r.overlay(g=>{\n      for(const q of fx){\n        const [x,y]=r.w(q.x,q.y,0);\n        const colors=q.type==='repair'||q.type==='pickup'?['#d7ffd2','#a0dfba','#65ac9f']:q.type==='armour'?['#fff0bb','#a5b7ba','#718895']:['#ffdd9e','#f29c82','#b36f88'];\n        px.rect(g,x,y,q.c===0?2:1,q.c===0?2:1,colors[q.c]);\n      }\n      const [ox,oy]=r.w(0,0,0);\n      px.rect(g,ox+13,oy+5,454,23,'#0a202b');\n      text(g,'TEAM',ox+20,oy+9,'#86ada2',{font:'tiny'});\n      text(g,String(w.score).padStart(6,'0'),ox+20,oy+16,'#ecfbd8',{scale:1});\n      const stage=w.encounter===6?'FLAGSHIP':('WAVE '+(w.encounter+1)+' / 6');\n      text(g,stage,ox+240,oy+9,'#f9c58e',{align:'center'});\n      const loc=LOCATIONS[w.location];\n      text(g,(typeof loc==='string'?loc:loc?.name)||['LAGOON RELAY','DUSK QUARRY','POLAR ARRAY'][w.location],ox+240,oy+20,'#8fafa4',{font:'tiny',align:'center'});\n      text(g,'RESERVE '+w.reserve,ox+458,oy+11,'#cde5cd',{align:'right'});\n      if(w.assisted&&\"'!attract)text(g,'\"'ASSISTED',ox+458,oy+22,'#dca68f',{align:'right',font:'tiny'});\n      for(const s of w.players){\n        if(\"'!s.active)continue;\n        const left=s.seat===0?21:310;\n        text(g,'\"'P'+(s.seat+1),ox+left,oy+260,s.seat===0?'#b4f5cf':'#ffb297');\n        for(let i=0;i<3;i++){\n          px.rect(g,ox+left+17+i*7,oy+261,5,5,i<s.charges?(s.seat===0?'#b4f5cf':'#ffb297'):'#37535e');\n          if(i<s.charges)px.dot(g,ox+left+18+i*7,oy+262,'#f5ffd7');\n        }\n        text(g,s.alive?'REPAIR':s.respawn>0?'RETURNING':'SPECTATING',ox+left+42,oy+261,'#8faea0',{font:'tiny'});\n      }\n      if(w.status==='transition'){\n        px.rect(g,ox+85,oy+112,310,43,'#0c2634');\n        text(g,w.nextEncounter===6?'HOSTILE FLAGSHIP INBOUND':(w.nextEncounter%2===0?'NEXT OUTPOST SECURED':'FORMATION CLEARED'),ox+240,oy+120,'#ffdaa0',{align:'center',scale:2});\n        text(g,'CATCH YOUR BREATH. REPAIR YOUR COVER.',ox+240,oy+144,'#b6d6be',{align:'center'});\n      }\n      if(w.encounter===0&&w.encounterTime<40&&\"'!front&&!attract){\n        let hint;\n        if(!w.intro?.moved)hint='\"'MOVE TO CHOOSE YOUR FIRING LANE';\n        else if(\"'!w.intro?.fired)hint='\"'HOLD FIRE TO CUT THROUGH YOUR OWN COVER';\n        else if(\"'!w.intro?.repaired)hint=w.players.some(s=>s.charges)?'\"'REPAIR NEAR A BUNKER  -  KEEP YOUR BARREL LANE':'CATCH THE DIAMOND SALVAGE';\n        if(hint){px.rect(g,ox+85,oy+174,310,15,'#112c38');text(g,hint,ox+240,oy+178,'#ffe0a3',{align:'center'});}\n      }\n      if(overlays){\n        text(g,'TICK '+w.tick+'  EPOCH '+w.epoch,ox+20,oy+36,'#ebbe9e',{font:'tiny'});\n        for(const s of w.players)if(s.alive){const [x,y]=r.w(s.x,s.y,0);border(g,x-5,y-4,10,8,'#ff6d90');}\n      }\n    });\n  }\n  return {drawWorld,background,events,update,reset(){fx=[];}};\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/view.js' <<'EOF'\nimport {repairPreview} from './sim.js';\nimport {WAVES,LOCATIONS} from './content.js';\n\nexport function createView(E,game,assets){\n  const {px}=E;\n  const rand=E.rng(92411);\n  const stars=Array.from({length:180},()=>({x:rand(),y:rand(),size:rand()>.94?2:1,t:rand()*7}));\n  const palettes=[\n    {sky:['#06151f','#102937','#254344'],planet:'#8bbcb2',rim:'#c9dbc1',land:'#344f50',ground:'#192f38',bunker:'#81bda7',accent:'#f1ad83'},\n    {sky:['#141327','#292b47','#554658'],planet:'#b8a4cc',rim:'#e6d1ca',land:'#51425c',ground:'#2c293f',bunker:'#ad9ab7',accent:'#e3bc83'},\n    {sky:['#071b29','#15394b','#376168'],planet:'#d7b892',rim:'#ffdda5',land:'#786162',ground:'#23404b',bunker:'#73a8ad',accent:'#ff9c82'}\n  ];\n  let fx=[];\n  function events(list){\n    for(const e of list){\n      if(['kill','armour','loss','repair','erode','pickup','victory','extra'].includes(e.type)){\n        const count=e.type==='loss'?20:e.type==='kill'?9:e.type==='repair'?8:e.type==='erode'?3:6;\n        for(let i=0;i<count;i++){\n          const a=rand()*Math.PI*2,s=10+rand()*40;\n          fx.push({x:e.x??240,y:e.y??140,vx:Math.cos(a)*s,vy:Math.sin(a)*s-10,life:.25+rand()*.45,max:.7,type:e.type,c:Math.floor(rand()*3)});\n        }\n      }\n    }\n    if(fx.length>400)fx=fx.slice(-400);\n  }\n  function update(dt){\n    for(const p of fx){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=65*dt;}\n    fx=fx.filter(p=>p.life>0);\n  }\n  function text(g,s,x,y,c='#e6f9de',opts={}){\n    E.font.text(g,s,Math.round(x),Math.round(y),c,{outline:false,shadow:'#07141e',...opts});\n  }\n  function border(g,x,y,w,h,c){px.line(g,x,y,x+w,y,c);px.line(g,x,y+h,x+w,y+h,c);px.line(g,x,y,x,y+h,c);px.line(g,x+w,y,x+w,y+h,c);}\n  function planet(g,cx,cy,r,p,t){\n    const ramp=E.ramp(p.planet,7);\n    px.disc(g,cx,cy,r+3,p.rim);\n    px.disc(g,cx+1,cy+1,r+1,p.land);\n    for(let yy=-r;yy<=r;yy+=2){\n      const half=Math.sqrt(Math.max(0,r*r-yy*yy));\n      for(let xx=-half;xx<half;xx+=3){\n        const light=(1-(xx/r)*.5-(yy/r)*.32);\n        const zone=Math.max(0,Math.min(6,Math.floor(light*4)));\n        const cloud=Math.sin((xx+yy*.55)*.079)+Math.cos(yy*.18+xx*.021);\n        const c=cloud>.8?ramp[Math.min(6,zone+1)]:cloud<-.7?ramp[Math.max(0,zone-2)]:ramp[zone];\n        px.rect(g,cx+xx,cy+yy,Math.min(3,half-xx),2,c);\n      }\n    }\n    px.poly(g,[[cx+r*.2,cy-r*.91],[cx+r*.78,cy-r*.62],[cx+r*.99,cy],[cx+r*.75,cy+r*.65],[cx+r*.07,cy+r*.99],[cx+r*.58,cy+r*.2]],p.land);\n  }\n  function background(r,world,front=false){\n    const p=palettes[world?.location??0],t=game.real;\n    r.sky(p.sky);\n    r.decal(g=>{\n      const [ox,oy]=r.w(0,0,0);\n      for(let i=0;i<stars.length;i++){\n        const s=stars[i],sx=s.x*r.W,sy=s.y*r.H;\n        const twinkle=Math.sin(t*.8+s.t)>-.35;\n        px.rect(g,sx,sy,s.size,s.size,twinkle?'#638c8e':'#2e505f');\n        if(s.size===2){px.rect(g,sx-2,sy+1,6,1,'#315663');px.rect(g,sx+1,sy-2,1,6,'#315663');}\n      }\n      // A distant planet, rasterized in stepped hue-shifted bands.\n      const pr=front?88:59;\n      planet(g,ox+(front?349:370),oy+(front?96:107),pr,p,t);\n      px.line(g,ox+282,oy+94,ox+457,oy+163,p.land,2);\n      px.line(g,ox+274,oy+98,ox+451,oy+168,p.rim);\n      // Orbital dust and a tiny high-altitude relay.\n      px.rect(g,ox+44,oy+57,16,2,'#456a72');\n      px.rect(g,ox+50,oy+51,4,13,'#819a91');\n      px.rect(g,ox+38,oy+53,8,9,'#233e50');px.rect(g,ox+59,oy+53,8,9,'#233e50');\n      // Extra display area is scenery, never additional combat space.\n      const floor=oy+254;\n      px.rect(g,0,floor,r.W,r.H-floor+2,p.ground);\n      for(let i=0;i<r.W;i+=22)px.line(g,i,floor,i+(i-r.W/2)*.8,r.H,'#304c53');\n      for(let y=floor+8;y<r.H;y+=18)px.line(g,0,y,r.W,y,'#29444d');\n      const horizon=oy+192;\n      for(let x=0;x<r.W;x+=13){\n        const h=5+Math.sin(x*.17)*4+Math.sin(x*.047)*8;\n        px.rect(g,x,horizon-h,14,Math.max(1,floor-horizon+h),p.land);\n        px.rect(g,x+2,horizon-h,3,2,'#486b69');\n      }\n      // The central combat sky stays dark enough for every shot silhouette.\n      px.rect(g,ox+9,oy+27,462,164,'#091d29');\n      for(const s of stars.slice(0,75)){\n        const x=ox+16+s.x*448,y=oy+31+s.y*155;\n        px.dot(g,x,y,s.size===2?'#456977':'#263f50');\n      }\n      px.line(g,ox+15,oy+31,ox+465,oy+31,'#40646a');\n      px.line(g,ox+15,oy+31,ox+15,oy+248,'#31525e');\n      px.line(g,ox+465,oy+31,ox+465,oy+248,'#31525e');\n      // Foreground apron and original-footprint plinths.\n      px.rect(g,ox+15,oy+229,450,25,'#1b3641');\n      for(let x=20;x<461;x+=12)px.rect(g,ox+x,oy+251,7,2,p.accent);\n      for(let x=16;x<465;x+=8)px.line(g,ox+x,oy+230,ox+x+3,oy+230,'#d87877');\n      text(g,'BREACH',ox+16,oy+219,'#b76a77',{font:'tiny'});\n      for(const b of world?.bunkers||[]){\n        px.rect(g,ox+b.x-2,oy+b.y+b.rows*b.cell, b.cols*b.cell+4,4,'#0a1e29');\n        px.line(g,ox+b.x-2,oy+b.y+b.rows*b.cell,ox+b.x+b.cols*b.cell+2,oy+b.y+b.rows*b.cell,'#53706d');\n      }\n      if(r.H>400){\n        const y=oy+308;\n        text(g,'PLANETARY DEFENSE NETWORK',r.W/2,y,'#78998d',{align:'center',scale:2});\n        text(g,'CUT A LANE. CATCH THE SCRAP. KEEP YOUR PLANET.',r.W/2,y+25,'#54796e',{align:'center'});\n        border(g,ox+68,y+55,344,70,'#345958');\n        for(let j=0;j<8;j++){\n          px.rect(g,ox+80+j*41,y+68,31,6,j<4?'#699b8d':'#b07f70');\n          px.rect(g,ox+80+j*41,y+80,31,29,'#102c38');\n          px.line(g,ox+84+j*41,y+101,ox+104+j*41,y+87,'#3a6a69');\n        }\n      }\n    });\n    return p;\n  }\n  function drawBoss(r,w,p){\n    const b=w.boss;if(\"'!b)return;\n    const body=assets.flagship;\n    if(body)r.sprite(b.x,b.y,0,body,{anchor:'\"'center',t:b.age,glow:.25});\n    else r.actor(b.x,b.y,0,(g,x,y)=>{\n      px.poly(g,[[x-68,y-2],[x-48,y-17],[x-17,y-22],[x,y-28],[x+17,y-22],[x+48,y-17],[x+68,y-2],[x+49,y+13],[x-49,y+13]],'#574361');\n      px.poly(g,[[x-62,y-3],[x-45,y-13],[x+45,y-13],[x+62,y-3],[x+38,y+6],[x-38,y+6]],'#9b7a98');\n      px.line(g,x-43,y-14,x+43,y-14,'#f5bcaa',2);\n      for(let i=-2;i<=2;i++)px.rect(g,x+i*18-3,y-10,6,3,'#c7dcd0');\n    });\n    for(const e of b.emitters||[]){\n      r.actor(e.x,e.y,0,(g,x,y)=>{\n        const open=e.open&&e.hp>0;\n        px.rect(g,x-9,y-9,18,18,e.hp>0?'#233c50':'#101c2b');\n        border(g,x-9,y-9,18,18,e.hp>0?'#e2a087':'#52636b');\n        if(e.hp>0){\n          px.disc(g,x,y,open?5:3,open?'#ffdd8b':'#9f7184');\n          if(\"'!open){px.line(g,x-7,y-4,x+7,y-4,'\"'#d2c0b8',2);px.line(g,x-7,y+4,x+7,y+4,'#776f86',2);}\n          for(let k=0;k<e.maxHp;k++)px.rect(g,x-8+k*(16/e.maxHp),y+13,Math.max(1,16/e.maxHp-1),2,k<e.hp?'#ffc797':'#30404e');\n        }\n        if(e.telegraph>0){border(g,x-13,y-13,26,26,'#ff9f85');px.line(g,x,y+15,x,y+25,'#ffd28e');}\n      },{emissive:true});\n    }\n    r.actor(b.x,b.y+3,0,(g,x,y)=>{\n      if(b.phase===2){\n        const open=b.open;\n        px.disc(g,x,y,11,'#112c40');px.disc(g,x,y,8,open?'#f5c47e':'#57697a');\n        if(open){px.disc(g,x-1,y-2,4,'#fff4cc');}\n        else{px.rect(g,x-10,y-2,20,4,'#b9a6b6');}\n      }\n    },{emissive:true});\n    if(b.phase===2&&b.telegraph>0){\n      r.overlay(g=>{\n        const safe=typeof b.safeLane==='number'?b.safeLane:240;\n        const [sx,sy]=r.w(safe,234,0);\n        border(g,sx-22,sy-14,44,22,'#b4f5cf');text(g,'SAFE',sx,sy-10,'#d3ffd4',{align:'center'});\n      });\n    }\n    r.text(b.phase===1?'BREAK BOTH EMITTERS':'EXPOSED CORE',r.W/2,(r.H-270)/2+38,'#ffcf96',{align:'center'});\n  }\n  function drawWorld(r,w,{front=false,attract=false,overlays=false}={}){\n    const p=background(r,w,front);\n    if(\"'!w)return;\n    const preview=w.players.filter(s=>s.active&&s.alive&&s.charges>0).map(s=>({seat:s.seat,...repairPreview(w,s.seat)}));\n    for(const b of w.bunkers){\n      const bi=w.bunkers.indexOf(b),ramp=E.ramp(p.bunker,5);\n      r.actor(b.center,b.y+b.rows*b.cell,0,(g,x,y)=>{\n        const left=x-b.cols*b.cell/2,top=y-b.rows*b.cell;\n        for(let i=0;i<b.mask.length;i++)if(b.mask[i]){\n          const col=i%b.cols,row=Math.floor(i/b.cols),xx=left+col*b.cell,yy=top+row*b.cell;\n          const shade=(col+row*3)%7===0?2:row<2?3:2;\n          px.rect(g,xx,yy,b.cell,b.cell,ramp[shade]);\n          px.rect(g,xx,yy,b.cell,1,ramp[Math.min(4,shade+1)]);\n          px.rect(g,xx+b.cell-1,yy+1,1,b.cell-1,ramp[1]);\n        }\n        for(const q of preview)if(q.bunker===bi&&q.usable){\n          border(g,left-2,top-2,b.cols*b.cell+4,b.rows*b.cell+4,q.seat===0?'\"'#a1d4bb':'#d6a2aa');\n          for(const i of q.cells.slice(0,24)){const xx=left+(i%b.cols)*b.cell,yy=top+Math.floor(i/b.cols)*b.cell;px.dot(g,xx+1,yy+1,'#dbf4c9');}\n        }\n      });\n    }\n    const march=w.formation?.beat||0;\n    for(const e of w.enemies){\n      const spr=e.type==='bombardier'?assets.bombardier:assets.enemies[e.row%4];\n      if(e.telegraph>0)r.actor(e.x,e.y,0,(g,x,y)=>{\n        px.line(g,x-9,y+10,x+9,y+10,'#ffd68e');\n        px.line(g,x-9,y+8,x-9,y+12,'#ffd68e');px.line(g,x+9,y+8,x+9,y+12,'#ffd68e');\n        for(let yy=y+15;yy<y+42;yy+=5)px.dot(g,x,yy,'#ce8e82');\n      },{emissive:true});\n      if(spr)r.sprite(e.x,e.y,0,spr,{anchor:'center',t:march*.125,flash:e.flash>0?'#fff4c9':undefined,glow:.2});\n      if(e.type==='armour'&&e.hp>1){\n        if(assets.armour)r.sprite(e.x,e.y,0,assets.armour,{anchor:'center',t:march*.125});\n        else r.actor(e.x,e.y,0,(g,x,y)=>{px.line(g,x-9,y-6,x+9,y-6,'#e6d8ac',2);px.line(g,x-10,y-5,x-10,y+4,'#8c9bac',2);px.line(g,x+10,y-5,x+10,y+4,'#8c9bac',2);});\n      }\n      if(overlays)r.actor(e.x,e.y,0,(g,x,y)=>border(g,x-7,y-5,14,10,'#ff6d90'),{emissive:true});\n    }\n    if(w.saucer){\n      r.sprite(w.saucer.x,w.saucer.y??43,0,assets.saucer,{anchor:'center',t:w.time,glow:.4});\n      r.textAt(w.saucer.x,(w.saucer.y??43)-15,0,'SCRAP BONUS','#ffcc95',{font:'tiny'});\n    }\n    if(w.boss)drawBoss(r,w,p);\n    for(const b of w.bullets)r.actor(b.x,b.y,0,(g,x,y)=>{\n      if(b.owner>=0){\n        px.rect(g,x-1,y-4,3,8,b.owner===0?'#dffff1':'#ffe3d4');px.rect(g,x,y-5,1,5,b.owner===0?'#a4f5cf':'#ffb69a');px.rect(g,x,y+4,1,3,'#3c787f');\n      }else if(b.kind==='heavy'){\n        px.poly(g,[[x,y-6],[x+5,y-2],[x+5,y+3],[x,y+7],[x-5,y+3],[x-5,y-2]],'#ff997e');\n        px.rect(g,x-2,y-2,4,4,'#fff1c8');px.line(g,x-3,y-8,x+3,y-8,'#d37a83');\n      }else{\n        px.rect(g,x-2,y-4,4,8,'#ff937c');px.rect(g,x-1,y,2,4,'#ffedb7');px.dot(g,x+1,y-6,'#d07883');\n      }\n    },{emissive:true});\n    for(const q of w.pickups){\n      r.sprite(q.x,q.y,0,assets.salvage,{anchor:'center',t:w.time,glow:.8});\n      r.actor(q.x,q.y,0,(g,x,y)=>{px.dot(g,x-7,y-5,'#e4ffd2');px.dot(g,x+6,y+4,'#7dc6b3');},{emissive:true});\n    }\n    for(const s of w.players){\n      if(\"'!s.active)continue;\n      if(!s.alive){\n        if(s.respawn>0)r.textAt(s.x,s.y-15,0,'\"'REDEPLOY','#b4d9c6',{font:'tiny'});\n        continue;\n      }\n      const spr=assets.ships[s.seat%2];\n      r.shadow(s.x,s.y+5,11,.5);\n      if(spr)r.sprite(s.x,s.y+(s.recovery>.2?1:0),0,spr,{anchor:'center',t:w.time,glow:.25,alpha:s.protected>0&&Math.floor(w.time*7)%2?.55:1});\n      r.actor(s.x,s.y,0,(g,x,y)=>{\n        const count=w.bullets.filter(b=>b.owner===s.seat).length;\n        px.rect(g,x-1,y-9,3,2,s.recovery<=0&&count<2?'#eaffd3':'#4a6876');\n        if(s.protected>0)border(g,x-12,y-11,24,20,s.seat===0?'#b4edcd':'#ffbb9e');\n      },{emissive:true});\n      game.lights.add(s.x,s.y,0,28,.22,{color:s.seat===0?'#96dfc0':'#ffb399'});\n    }\n    r.overlay(g=>{\n      for(const q of fx){\n        const [x,y]=r.w(q.x,q.y,0);\n        const colors=q.type==='repair'||q.type==='pickup'?['#d7ffd2','#a0dfba','#65ac9f']:q.type==='armour'?['#fff0bb','#a5b7ba','#718895']:['#ffdd9e','#f29c82','#b36f88'];\n        px.rect(g,x,y,q.c===0?2:1,q.c===0?2:1,colors[q.c]);\n      }\n      const [ox,oy]=r.w(0,0,0);\n      px.rect(g,ox+13,oy+5,454,23,'#0a202b');\n      text(g,'TEAM',ox+20,oy+9,'#86ada2',{font:'tiny'});\n      text(g,String(w.score).padStart(6,'0'),ox+20,oy+16,'#ecfbd8',{scale:1});\n      const stage=w.encounter===6?'FLAGSHIP':('WAVE '+(w.encounter+1)+' / 6');\n      text(g,stage,ox+240,oy+9,'#f9c58e',{align:'center'});\n      const loc=LOCATIONS[w.location];\n      text(g,(typeof loc==='string'?loc:loc?.name)||['LAGOON RELAY','DUSK QUARRY','POLAR ARRAY'][w.location],ox+240,oy+20,'#8fafa4',{font:'tiny',align:'center'});\n      text(g,'RESERVE '+w.reserve,ox+458,oy+11,'#cde5cd',{align:'right'});\n      if(w.assisted&&\"'!attract)text(g,'\"'ASSISTED',ox+458,oy+22,'#dca68f',{align:'right',font:'tiny'});\n      for(const s of w.players){\n        if(\"'!s.active)continue;\n        const left=s.seat===0?21:310;\n        text(g,'\"'P'+(s.seat+1),ox+left,oy+260,s.seat===0?'#b4f5cf':'#ffb297');\n        for(let i=0;i<3;i++){\n          px.rect(g,ox+left+17+i*7,oy+261,5,5,i<s.charges?(s.seat===0?'#b4f5cf':'#ffb297'):'#37535e');\n          if(i<s.charges)px.dot(g,ox+left+18+i*7,oy+262,'#f5ffd7');\n        }\n        text(g,s.alive?'REPAIR':s.respawn>0?'RETURNING':'SPECTATING',ox+left+42,oy+261,'#8faea0',{font:'tiny'});\n      }\n      if(w.status==='transition'){\n        px.rect(g,ox+85,oy+112,310,43,'#0c2634');\n        text(g,w.nextEncounter===6?'HOSTILE FLAGSHIP INBOUND':(w.nextEncounter%2===0?'NEXT OUTPOST SECURED':'FORMATION CLEARED'),ox+240,oy+120,'#ffdaa0',{align:'center',scale:2});\n        text(g,'CATCH YOUR BREATH. REPAIR YOUR COVER.',ox+240,oy+144,'#b6d6be',{align:'center'});\n      }\n      if(w.encounter===0&&w.encounterTime<40&&\"'!front&&!attract){\n        let hint;\n        if(!w.intro?.moved)hint='\"'MOVE TO CHOOSE YOUR FIRING LANE';\n        else if(\"'!w.intro?.fired)hint='\"'HOLD FIRE TO CUT THROUGH YOUR OWN COVER';\n        else if(\"'!w.intro?.repaired)hint=w.players.some(s=>s.charges)?'\"'REPAIR NEAR A BUNKER  -  KEEP YOUR BARREL LANE':'CATCH THE DIAMOND SALVAGE';\n        if(hint){px.rect(g,ox+85,oy+174,310,15,'#112c38');text(g,hint,ox+240,oy+178,'#ffe0a3',{align:'center'});}\n      }\n      if(overlays){\n        text(g,'TICK '+w.tick+'  EPOCH '+w.epoch,ox+20,oy+36,'#ebbe9e',{font:'tiny'});\n        for(const s of w.players)if(s.alive){const [x,y]=r.w(s.x,s.y,0);border(g,x-5,y-4,10,8,'#ff6d90');}\n      }\n    });\n  }\n  return {drawWorld,background,events,update,reset(){fx=[];}};\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"agent_message","text":"The main systems are now taking shape: shared bunker masks, lane-preserving repair, six authored formations and the flagship’s two phases. The original alien sprites are ready. I’m building the controls and menus around that world, including controller focus, touch assistance and developer tools.\n"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"cat 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/content.js'; sed -n '1,125p' 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/sim.js'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"cat 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/content.js'; sed -n '1,125p' 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/sim.js'\"","aggregated_output":"/** Original authored campaign content. Source values are distinguished from additions. */\nexport const FIELD = Object.freeze({ width:480,height:270,left:18,right:462,top:30,bottom:258,breach:230,shipY:246 });\nexport const TUNING = Object.freeze([\n {key:'playerSpeed',label:'Cannon speed',min:70,max:280,step:5,default:155,description:'Horizontal cannon movement, logical pixels per second.'},\n {key:'shotRecovery',label:'Shot recovery',min:0.1,max:0.8,step:0.02,default:0.28,description:'Seconds between launches; two missiles per cannon remain the limit.'},\n {key:'marchInterval',label:'March interval',min:0.12,max:1.2,step:0.02,default:0.66,description:'Opening beat length; surviving troops accelerate from this value.'},\n {key:'descent',label:'Reversal descent',min:2,max:16,step:1,default:7,description:'Pixels descended whenever the living formation reverses.'},\n {key:'fireInterval',label:'Volley interval',min:0.8,max:5,step:0.1,default:2.8,description:'Seconds between enemy attack orders; authored recovery windows still apply.'},\n {key:'playerShotSpeed',label:'Missile speed',min:100,max:400,step:10,default:195,description:'Upward missile speed; applies to all missiles immediately.'},\n {key:'bombSpeed',label:'Enemy bomb speed',min:35,max:160,step:5,default:67,description:'Falling bomb speed; broad bombs are a little slower. Applies immediately.'},\n {key:'salvageEvery',label:'Salvage cadence',min:1,max:8,step:1,default:4,description:'Every N ordinary formation kills releases guaranteed salvage.'},\n {key:'repairYield',label:'Repair cells',min:8,max:64,step:2,default:26,description:'Maximum missing bunker cells restored by one charge.'},\n {key:'bossHealth',label:'Flagship core health',min:8,max:60,step:2,default:26,description:'Core maximum health. Live change preserves its damaged proportion; emitters use one third.'}\n]);\nexport const DIFFICULTIES = Object.freeze([\n {name:'CADET',description:'Broad recovery windows. The full campaign.',march:1.2,fire:1.3,bomb:0.83,descent:0.8,boss:0.77},\n {name:'STANDARD',description:'The intended planetary defense.',march:1,fire:1,bomb:1,descent:1,boss:1},\n {name:'VETERAN',description:'A more impatient sky.',march:0.85,fire:0.84,bomb:1.12,descent:1.12,boss:1.15},\n {name:'PANIC',description:'Keep a lane. Keep your nerve.',march:0.72,fire:0.7,bomb:1.24,descent:1.28,boss:1.3}\n]);\nexport const LOCATIONS = Object.freeze([\n {name:'TIDAL OUTPOST',short:'01 / TIDAL OUTPOST',palette:['#08192d','#193a50','#54e5d1','#f8b86d'],alert:'KEEP THE SKY OFF OUR BEACH.'},\n {name:'EMBER FOUNDRY',short:'02 / EMBER FOUNDRY',palette:['#201128','#52263e','#ffa76b','#e464b6'],alert:'HOT METAL. COOL HEADS.'},\n {name:'AURORA CITADEL',short:'03 / AURORA CITADEL',palette:['#141831','#343455','#b7a3ff','#7ef5d9'],alert:'LAST WALL. BIG ATTITUDE.'}\n]);\n// 0 ordinary, A armour, B bombardier, . intentional gap; values remain row-based.\nexport const WAVES = Object.freeze([\n {name:'THE DOORBELL',location:0,startY:46,spacingX:40,spacingY:20,rows:['00000000','00000000','00000000','00000000'],march:1,fire:1.2,volley:1,telegraph:0.8,saucerAt:999,recoveryEvery:4,recoveryFor:2.1,alert:'MOVE. FIRE. CUT YOUR OWN FIRING LANE.'},\n {name:'CHEEKY VISITORS',location:0,startY:50,spacingX:40,spacingY:20,rows:['00000000','00.00.00','00000000','00000000'],march:0.95,fire:1.08,volley:2,telegraph:0.78,saucerAt:8,recoveryEvery:4,recoveryFor:2,alert:'BONUS SAUCER INBOUND. RISK THE OPEN SKY?'},\n {name:'TIN HATS',location:1,startY:54,spacingX:40,spacingY:20,rows:['00A00A00','00000000','0A0000A0','00000000'],march:0.92,fire:1,volley:2,telegraph:0.78,saucerAt:15,recoveryEvery:4,recoveryFor:2,alert:'ARMOURED CONTACTS. CRACK, THEN ZAP.'},\n {name:'RAIN CHECK',location:1,startY:58,spacingX:40,spacingY:20,rows:['0B0000B0','00A00A00','00000000','0B0000B0'],march:0.88,fire:0.95,volley:2,telegraph:0.92,saucerAt:13,recoveryEvery:3,recoveryFor:2.4,alert:'BROAD BOMBS. REPAIR BEFORE THE RAIN.'},\n {name:'RUDE COMPANY',location:2,startY:64,spacingX:40,spacingY:20,rows:['A0B00B0A','0A.00.A0','0B0AA0B0','00000000'],march:0.84,fire:0.92,volley:3,telegraph:0.88,saucerAt:11,recoveryEvery:3,recoveryFor:2.8,alert:'PICK YOUR TARGET. KEEP YOUR COVER.'},\n {name:'THE LAST WORD',location:2,startY:70,spacingX:40,spacingY:20,rows:['AB0AA0BA','0B0AA0B0','AA0000AA','0B0000B0'],march:0.8,fire:0.88,volley:3,telegraph:0.9,saucerAt:9,recoveryEvery:3,recoveryFor:2.8,alert:'HOLD THE BREACH. MAKE EVERY REPAIR COUNT.'}\n]);\nexport function tuningForDifficulty(index=1) {\n const d=DIFFICULTIES[Math.max(0,Math.min(3,Math.trunc(index)))];\n const t=Object.fromEntries(TUNING.map(v=>[v.key,v.default]));\n t.marchInterval*=d.march; t.fireInterval*=d.fire; t.bombSpeed*=d.bomb; t.descent*=d.descent; t.bossHealth=Math.round(t.bossHealth*d.boss);\n return t;\n}\nexport function validateContent() {\n if(WAVES.length!==6) throw new Error('Campaign requires six formations.');\n WAVES.forEach((w,i)=>{\n  if(w.rows.length!==4||w.rows.some(row=>row.length!==8||/[^0AB.]/.test(row))) throw new Error(`Formation ${i+1}: expected four eight-character rows using 0/A/B/.`);\n  if(!LOCATIONS[w.location]||!Number.isFinite(w.startY)||w.startY<32||w.startY>100) throw new Error(`Formation ${i+1}: invalid location or starting height.`);\n });\n TUNING.forEach(t=>{if(!(t.min<t.max&&t.default>=t.min&&t.default<=t.max&&t.step>0)) throw new Error(`Invalid tuning bounds: ${t.key}`);});\n return true;\n}\nvalidateContent();\nimport { FIELD,TUNING,WAVES,tuningForDifficulty } from './content.js';\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst finite=(v,d=0)=>Number.isFinite(v)?v:d;\nconst clone=v=>JSON.parse(JSON.stringify(v));\nexport function random(world) {\n world.rng=(world.rng+0x6d2b79f5)>>>0;\n let t=world.rng; t=Math.imul(t^(t>>>15),t|1);t^=t+Math.imul(t^(t>>>7),t|61);\n return ((t^(t>>>14))>>>0)/4294967296;\n}\nfunction event(w,type,more={}) { const e={id:++w.eventSeq,tick:w.tick,type,...more};w.events.push(e);return e; }\nfunction makeBunker(center,index) {\n const cols=16,rows=8,cell=3,original=[];\n for(let row=0;row<rows;row++) for(let col=0;col<cols;col++) original.push((row===0&&(col<3||col>12))||(row===1&&(col<1||col>14))||(row>=5&&col>=6&&col<=9)?0:1);\n return {id:index,x:center-cols*cell/2,y:202,center,cols,rows,cell,original,mask:original.slice(),growth:[]};\n}\nexport function createWorld({seed=0x49a71,players=1,difficulty=1,ids}={}) {\n difficulty=clamp(Math.trunc(finite(difficulty,1)),0,3);players=clamp(Math.trunc(finite(players,1)),1,2);\n seed=finite(seed,0x49a71)>>>0;\n const w={version:1,tick:0,time:0,seed,rng:seed,epoch:0,entitySeq:0,eventSeq:0,encounter:0,location:0,status:'playing',reason:'',score:0,reserve:players*2,extraAwarded:false,assisted:false,difficulty,tuning:tuningForDifficulty(difficulty),players:[],enemies:[],bullets:[],pickups:[],bunkers:[80,186,294,400].map(makeBunker),formation:null,boss:null,saucer:null,events:[],encounterTime:0,transitionTime:0,nextEncounter:null,killCount:0,fireTimer:3.6,volleyCount:0,saucerTimer:0,bossDropTimer:0,invulnerable:false,intro:{moved:false,fired:false,eroded:false,collected:false,repaired:false},stats:{shots:0,hits:0,losses:0,armourHits:0,bombsStopped:0,cellsLost:0,cellsRepaired:0,salvageCaught:0,saucers:0,phases:[],encounters:[]}};\n for(let seat=0;seat<players;seat++) w.players.push({seat,id:ids?.[seat]??`p${seat+1}`,x:players===1?240:seat===0?186:294,y:FIELD.shipY,alive:true,active:true,gone:false,respawn:0,protected:2.4,charges:0,score:0,kills:0,repairs:0,recovery:0,recoil:0,feedback:'',feedbackTime:0,deploymentPaid:false});\n startEncounter(w,0);return w;\n}\nexport function serialize(w){return JSON.stringify(w);}\nexport function deserialize(data){const w=typeof data==='string'?JSON.parse(data):clone(data);if(w.version!==1||!Array.isArray(w.players)||!Array.isArray(w.bunkers))throw new Error('Unsupported world snapshot.');return w;}\nfunction positions(w) {\n for(const e of w.enemies){e.x=w.formation.startX+e.col*w.formation.spacingX+w.formation.x;e.y=w.formation.y+e.row*w.formation.spacingY;}\n}\nexport function startEncounter(w,index) {\n index=clamp(Math.trunc(finite(index)),0,6);w.epoch++;w.encounter=index;w.location=Math.min(2,Math.floor(index/2));w.encounterTime=0;w.transitionTime=0;w.nextEncounter=null;w.status='playing';w.reason='';w.enemies=[];w.bullets=[];w.boss=null;w.saucer=null;w.fireTimer=index===0?4.5:3.4;w.volleyCount=0;w.saucerTimer=index<6?WAVES[index].saucerAt:12;w.bossDropTimer=6;\n for(const p of w.players){p.protected=Math.max(p.protected,p.alive?2.4:0);p.recovery=0;}\n if(index<6){const d=WAVES[index];w.formation={x:0,y:d.startY,dir:1,timer:0,beat:0,initial:0,interval:w.tuning.marchInterval*d.march,startX:100,spacingX:d.spacingX,spacingY:d.spacingY};\n  d.rows.forEach((row,r)=>[...row].forEach((type,col)=>{if(type!=='.')w.enemies.push({id:++w.entitySeq,row:r,col,x:0,y:0,type:type==='A'?'armour':type==='B'?'bombardier':'ordinary',hp:type==='A'?2:1,maxHp:type==='A'?2:1,telegraph:0,flash:0,shotPending:false,attackKind:'bomb'});}));\n  w.formation.initial=w.enemies.length;positions(w);\n }else{const hp=w.tuning.bossHealth,ehp=Math.max(3,Math.round(hp/3));w.formation=null;w.boss={x:240,y:68,phase:1,emitters:[{x:192,y:76,hp:ehp,maxHp:ehp,open:true,telegraph:0},{x:288,y:76,hp:ehp,maxHp:ehp,open:false,telegraph:0}],hp,maxHp:hp,open:false,cycle:0,safeLane:240,safeWidth:82,telegraph:0,age:0,phaseTime:0,hit:0,attackTimer:4.5,attackPending:false};}\n if(!w.stats.encounters.includes(index))w.stats.encounters.push(index);\n event(w,'stage',{encounter:index,location:w.location});return w;\n}\nexport function setTuning(w,key,value) {\n const t=TUNING.find(t=>t.key===key);if(!t||!Number.isFinite(value))return false;\n value=clamp(value,t.min,t.max);if(t.step>=1)value=Math.round(value);\n const old=w.tuning[key];w.tuning[key]=value;w.assisted=true;\n if(key==='bossHealth'&&w.boss){const b=w.boss;b.hp=Math.max(0,Math.ceil(b.hp/Math.max(1,b.maxHp)*value));b.maxHp=value;const ehp=Math.max(3,Math.round(value/3));for(const e of b.emitters){e.hp=Math.max(0,Math.ceil(e.hp/Math.max(1,e.maxHp)*ehp));e.maxHp=ehp;}}\n return old!==value;\n}\nexport function resetTuning(w){w.tuning=tuningForDifficulty(w.difficulty);w.assisted=true;return w.tuning;}\nfunction playerFeedback(w,p,text){p.feedback=text;p.feedbackTime=1.2;event(w,'feedback',{seat:p.seat,x:p.x,y:p.y,text});}\nfunction apertureColumns(w,b) {\n const cols=[];for(const p of w.players)if(p.active&&p.alive&&p.x>=b.x&&p.x<b.x+b.cols*b.cell)cols.push(Math.floor((p.x-b.x)/b.cell));return cols;\n}\nexport function repairPreview(w,seat) {\n const p=w.players[seat];if(!p||!p.active||!p.alive)return {bunker:-1,cells:[],usable:false,reason:'NO CANNON'};\n let bi=0;for(let i=1;i<w.bunkers.length;i++)if(Math.abs(w.bunkers[i].center-p.x)<Math.abs(w.bunkers[bi].center-p.x))bi=i;\n const b=w.bunkers[bi],apertures=apertureColumns(w,b),cells=[];\n for(let i=0;i<b.mask.length;i++)if(b.original[i]&&!b.mask[i]&&!apertures.includes(i%b.cols))cells.push(i);\n cells.sort((a,z)=>{\n  const ac=a%b.cols,zc=z%b.cols,ar=Math.floor(a/b.cols),zr=Math.floor(z/b.cols);\n  const da=Math.abs(b.x+(ac+0.5)*b.cell-p.x)+Math.abs(ar-3.5)*1.8,dz=Math.abs(b.x+(zc+0.5)*b.cell-p.x)+Math.abs(zr-3.5)*1.8;\n  return da-dz||a-z;\n });\n const bounded=cells.slice(0,Math.round(w.tuning.repairYield));\n return {bunker:bi,cells:bounded,usable:p.charges>0&&bounded.length>0,reason:p.charges<=0?'CATCH SALVAGE':bounded.length?'REPAIR READY':b.mask.some((v,i)=>b.original[i]&&!v)?'FIRING LANE KEPT OPEN':'COVER INTACT'};\n}\nexport function repair(w,seat) {\n const p=w.players[seat],target=repairPreview(w,seat);if(!p)return false;\n if(!target.usable){playerFeedback(w,p,target.reason);return false;}\n const b=w.bunkers[target.bunker];p.charges--;p.repairs++;w.intro.repaired=true;\n for(const i of target.cells){b.mask[i]=1;b.growth.push({cell:i,time:0.4});}\n w.stats.cellsRepaired+=target.cells.length;event(w,'repair',{x:b.center,y:b.y+10,seat,cells:target.cells.length,bunker:target.bunker});return true;\n}\nexport function clearShot(w,x) {\n for(const b of w.bunkers)if(x>=b.x-1&&x<=b.x+b.cols*b.cell+1){const c=Math.floor((x-b.x)/b.cell);for(let r=0;r<b.rows;r++)if(c>=0&&c<b.cols&&b.mask[r*b.cols+c])return false;}\n return true;\n}\nfunction award(w,seat,value) {\n w.score+=value;const p=w.players[seat];if(p)p.score+=value;\n if(!w.extraAwarded&&w.score>=1000){w.extraAwarded=true;w.reserve++;event(w,'extra',{x:240,y:36,value:1});}\n}\nfunction pickup(w,x,y,reason='kill') { w.pickups.push({id:++w.entitySeq,x:clamp(x,FIELD.left+5,FIELD.right-5),y,life:9,reason});event(w,'drop',{x,y,reason}); }\nfunction enemyKilled(w,e,owner) {\n const i=w.enemies.indexOf(e);if(i<0)return;\n w.enemies.splice(i,1);const value=(4-e.row)*10;award(w,owner,value);w.killCount++;const p=w.players[owner];if(p){p.kills++;}w.stats.hits++;event(w,'kill',{x:e.x,y:e.y,seat:owner,enemyType:e.type,row:e.row,value});\n if(w.killCount%Math.round(w.tuning.salvageEvery)===0)pickup(w,e.x,e.y);\n}\nexport function killPlayer(w,seat) {\n const p=w.players[seat];if(!p||!p.active||!p.alive||p.protected>0||w.invulnerable)return false;\n p.alive=false;p.respawn=0;p.recovery=0;p.recoil=0;p.deploymentPaid=false;w.stats.losses++;event(w,'loss',{x:p.x,y:p.y,seat});\n return true;\n}\nfunction scheduleRespawns(w) {\n for(const p of w.players)if(p.active&&!p.alive&&p.respawn<=0&&w.reserve>0){w.reserve--;p.respawn=1.05;p.deploymentPaid=true;}\n}\nexport function leaveSeat(w,seat) {\n const p=w.players[seat];if(!p)return false;\n p.active=false;p.gone=true;p.alive=false;p.respawn=0;p.deploymentPaid=false;event(w,'leave',{seat,x:p.x,y:p.y});return true;\n}\nfunction updatePlayers(w,commands,dt) {\n for(const p of w.players){p.protected=Math.max(0,p.protected-dt);p.recovery=Math.max(0,p.recovery-dt);p.recoil=Math.max(0,p.recoil-dt);p.feedbackTime=Math.max(0,p.feedbackTime-dt);\n  if(!p.active)continue;\n  if(!p.alive){if(p.respawn>0){p.respawn=Math.max(0,p.respawn-dt);if(p.respawn===0){p.alive=true;p.protected=2.2;p.recovery=0;p.deploymentPaid=false;event(w,'respawn',{x:p.x,y:p.y,seat:p.seat});}}continue;}\n  const c=commands[p.seat]||{},start=p.x;let move=clamp(finite(c.move),-1,1);\n  if(Math.abs(move)<0.03&&Number.isFinite(c.targetX)){const delta=clamp(c.targetX,FIELD.left,FIELD.right)-p.x;move=clamp(delta/(w.tuning.playerSpeed*dt),-1,1);}\n  p.x=clamp(p.x+move*w.tuning.playerSpeed*dt,FIELD.left,FIELD.right);if(Math.abs(p.x-start)>0.1)w.intro.moved=true;\n  if(c.fire&&w.status==='playing'&&p.recovery<=0&&w.bullets.filter(b=>b.owner===p.seat).length<2){w.bullets.push({id:++w.entitySeq,x:p.x,y:p.y-9,vy:-w.tuning.playerShotSpeed,owner:p.seat,kind:'shot',r:0.8});p.recovery=w.tuning.shotRecovery;p.recoil=0.12;w.intro.fired=true;w.stats.shots++;event(w,'shot',{x:p.x,y:p.y-8,seat:p.seat});}\n }\n}\nfunction updateRepairs(w,commands){for(const p of w.players)if(p.active&&p.alive&&commands[p.seat]?.repair)repair(w,p.seat);}\nfunction formationStep(w,dt) {\n const f=w.formation;if(!f||!w.enemies.length)return;\n const d=WAVES[w.encounter],ratio=w.enemies.length/f.initial;f.interval=Math.max(0.085,w.tuning.marchInterval*d.march*(0.19+0.81*ratio));f.timer+=dt;\n while(f.timer>=f.interval){f.timer-=f.interval;f.beat++;\n  const left=Math.min(...w.enemies.map(e=>e.x-7)),right=Math.max(...w.enemies.map(e=>e.x+7)),step=4;\n  if((f.dir>0&&right+step>FIELD.right-2)||(f.dir<0&&left-step<FIELD.left+2)){f.dir*=-1;f.y+=w.tuning.descent;event(w,'reverse',{x:f.x,y:f.y});}\n  else f.x+=f.dir*step;\n  positions(w);event(w,'march',{beat:f.beat,remaining:w.enemies.length});\n  if(w.enemies.some(e=>e.y+6>=FIELD.breach)){w.status='defeat';w.reason='BREACH — THE SKY CROSSED THE LINE';event(w,'defeat',{reason:'breach'});return;}\n }\n}\nfunction exposedEnemies(w) {\n const exposed=[];for(let col=0;col<8;col++){const es=w.enemies.filter(e=>e.col===col);if(es.length)exposed.push(es.reduce((a,b)=>a.y>b.y?a:b));}return exposed;\n}\nfunction addBomb(w,x,y,kind='bomb') {\n if(w.bullets.filter(b=>b.owner<0).length>=12)return;\n w.bullets.push({id:++w.entitySeq,x,y,vy:w.tuning.bombSpeed*(kind==='heavy'?0.8:1),owner:-1,kind,r:kind==='heavy'?3.6:1.7});event(w,'volley',{x,y,kind});\n}\nfunction enemyAttacks(w,dt) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/ui.js' <<'EOF'\nimport {DIFFICULTIES,TUNING} from './content.js';\n\nconst escape=s=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst btn=(id,label,sub='',secondary=false,disabled=false)=>\"'`<button class=\"action ${secondary?'\"'secondary':''}\\\" data-action=\\\"\"'${id}\" ${disabled?'\"'disabled':''}>\"'${escape(label)}${sub?`<small>${escape(sub)}</small>`:'\"''}</button>\"'`;\nconst TEST_Q=['\"'How many issues did testing catch?','How many were critical or game breaking?','Most helpful test','Least helpful test'];\nconst ENGINE_Q=['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important system built','Hardest part of using the engine','Engine changes and reasons','One suggested engine change'];\nconst PROMPT_Q=['What worked best in the prompt?','What was confusing?','What was hardest?','One suggested prompt change'];\n\nexport class Interface{\n  constructor(app,report){\n    this.app=app;this.game=app.game;this.report=report;this.root=typeof document==='undefined'?null:document.getElementById('ui');\n    this.screen='title';this.page=0;this.focus=0;this.memory={};this.parent='title';this.rows=[];this.lock=.2;this.devPage=0;\n    this.pages=this.reportPages();\n  }\n  reportPages(){\n    const pages=[{title:'About Orbit Invadettes',body:[\n      ['ORIGINAL GAME','Cut a lane. Catch the scrap. Keep your planet. Six formations across three outposts, then an original hostile flagship. Solo or simultaneous local co-op; shared-world online co-op when launched by AI Hub.'],\n      ['CREDITS','Game design, programming, original pixel art and procedural music: OpenAI gpt-6.1-sol. Built on Michael Crosato’s my-3D2dge. AI Hub session client by Michael Crosato. No commercial game assets, ROMs or recorded audio.'],\n      ['SOURCE INTERPRETATION','Inspired by Bally’s Astrocade Space Invaders, subsequently called Astro Battle. The supplied combined source wording is interpreted this way; it is not a newly established release-history claim. Repair salvage, specialists, co-op and the flagship are original additions.']\n    ]},{title:'Research & licenses',body:[\n      ['WHAT WAS EXAMINED','Archived manual scan, manual transcription, Video Games October 1982 comparison, and sampled archive-linked Nice and Games Astro Battle footage at 90/120 seconds with a sequential filmstrip. Source sound was not listened to; exact audio is unknown.'],\n      ['PRIMARY SOURCES','Bally Alley manual archive: ballyalley.com/cart_manuals/html_manuals/astro_battle.htm · gameplay archive: ballyalley.com/astrocade_videos/cartridge_videos/cartridge_videos.html. Detailed observations and retained references are in research/RESEARCH.md.'],\n      ['LICENSES','my-3D2dge © 2026 Michael Crosato, MIT License. Permission is granted, free of charge, to use, copy, modify, merge, publish, distribute, sublicense and/or sell copies, subject to retaining the copyright and permission notice. Software is provided “AS IS”, without warranty. Full MIT notice is retained in this HTML.']\n    ]}];\n    const fields=Object.entries(this.report.sourceInformation);\n    for(let i=0;i<fields.length;i+=3)pages.push({title:'Source information',body:fields.slice(i,i+3).map(([k,v])=>[k.replace(/([A-Z])/g,' \"'$1'\"').toUpperCase(),v])});\n    for(const [title,questions,answers] of [['Testing feedback',TEST_Q,this.report.testingFeedback],['Engine feedback',ENGINE_Q,this.report.engineFeedback],['Prompt feedback',PROMPT_Q,this.report.promptFeedback]]){\n      for(let i=0;i<answers.length;i+=2)pages.push({title,body:answers.slice(i,i+2).map((v,j)=>[questions[i+j],v])});\n    }\n    return pages;\n  }\n  show(screen,opts={}){\n    this.memory[this.screen]=this.focus;\n    if(opts.parent)this.parent=opts.parent;\n    this.screen=screen;this.focus=this.memory[screen]??0;this.lock=.18;\n    this.app.clearInput();\n    this.render();\n  }\n  focusAt(n,{dom=true}={}){\n    if(\"'!this.rows.length)return;\n    this.focus=(n+this.rows.length)%this.rows.length;\n    this.rows.forEach((el,i)=>{\n      const row=el.closest('\"'.setting-row')||el;\n      row.classList.toggle('focused',i===this.focus);\n    });\n    if(dom&&this.rows[this.focus])this.rows[this.focus].focus({preventScroll:true});\n  }\n  frame(title,sub,body,extra=''){\n    return \"'`<section class=\"screen menu-screen ${extra}\" aria-label=\"${escape(title)}\"><p class=\"eyebrow\">ORBIT INVADETTES / DEFENSE NETWORK</p><h1 class=\"menu-title\">${title}</h1>${sub?`<p class=\"sub\">${sub}</p>`:'\"''}\"'${body}</section>`;\n  }\n  render(){\n    if(!this.root)return;\n    const a=this.app,w=a.world,s=this.screen,hub=!!a.session;\n    if(s==='\"'play'||s==='hub-wait'){this.root.innerHTML='';this.rows=[];return;}\n    if(s==='attract'){\n      this.root.innerHTML='<div class=\\\"demo-banner\\\"><strong>ATTRACT PLAY</strong><p>AI demonstration · any input returns to title</p></div>';this.rows=[];return;\n    }\n    let html='';\n    if(s==='title'){\n      html=\"'`<section class=\"screen title-screen\" aria-label=\"Title\"><div class=\"title-art\"><p class=\"eyebrow\">A small planet. A very large problem.</p><h1 class=\"logo\">Orbit<span>Invadettes</span></h1><p class=\"tagline\">Cut a lane. Catch the scrap.<br>Keep your planet.</p><p class=\"edition\">PLANETARY DEFENSE / EST. 1979 · REBUILT 2026</p></div><div class=\"menu-card\"><span class=\"pill\">1–2 PLAYERS / SIX WAVES + FLAGSHIP</span><div class=\"actions\">${btn('\"'launch','Deploy cannons','Solo or simultaneous local co-op')}\"'${btn('\"'controls','How to defend')}\"'${btn('\"'settings','Settings','',true)}\"'${btn('\"'records','Local records','',true)}\"'${btn('\"'about','About & credits','',true)}</div><p class=\\\"foot\\\">\"'${escape(a.menuPrompt())}<br>Online co-op is available through AI Hub.<br>Idle 10 seconds for a demonstration.</p></div></section>`;\n    }else if(s==='\"'launch'){\n      const d=DIFFICULTIES[a.difficulty],name=typeof d==='string'?d:d.name;\n      html=this.frame('Choose your defense','The entire campaign is available at every difficulty.',\"'`<div class=\"actions\">${btn('\"'players','Players: '+(a.playerCount===1?'Solo':'Two-player co-op'),a.playerCount===1?'3 deployments, including your first cannon.':'6 shared deployments. Two pads, keyboard + pad, or split keyboard.')}\"'${btn('\"'difficulty','Difficulty: '+name,(d.description||d.help||'Adjust with Left / Right.'))}\"'${btn('\"'start','Launch defense','Hold fire. Collect salvage. Repair the nearest bunker.')}\"'${btn('\"'back','Back','',true)}</div><p class=\\\"foot\\\">P1: A/D · Space · Q. P2 on a shared keyboard: arrows · . · /.<br>Local roster locks at launch. A returning pad reclaims its seat.</p>\"'`);\n    }else if(s==='\"'controls'){\n      const t=a.primary==='touch';\n      html=this.frame('Two actions. One planet.',hub?'Your Options overlay is local. The team’s world keeps moving.':'Six formations. Three outposts. One hostile flagship.',\"'`<div class=\"control-grid\"><div><strong>MOVE</strong>${t?'\"'Drag horizontally in the lower play area. Movement is relative to your thumb.':'Left stick / D-pad · A/D or arrows. Move the mouse inside the field to set a horizontal target.'}</div><div><strong>FIRE</strong>\"'${t?'\"'Clear lanes fire automatically. A second finger fires through cover to cut a new lane.':'Hold R2 or Cross · Space or left mouse. Two missiles at a time. Your shots cut your bunkers.'}</div><div><strong>REPAIR</strong>\"'${t?'\"'Tap the temporary REPAIR button while moving. It appears when salvage can restore cover.':'L1 or Square · Q or right mouse. One charge restores a cluster in the nearest bunker.'}</div><div><strong>READ THE SKY</strong>Gold brackets announce enemy fire. Mint diamonds are salvage. Keep aliens above the striped breach line.</div></div><div class=\\\"actions\\\">\"'${btn('\"'back','Ready','',false)}</div><p class=\\\"foot\\\">\"'${t?'\"'Use two simultaneous contacts to deliberately cut cover.':'P2 shared keyboard: arrows · . to fire · / to repair.'}<br>Options / Escape: \"'${hub?'\"'local options':'pause'}. Xbox button names are available in Settings.</p>\"'`);\n    }else if(s==='\"'settings'){\n      const page=this.page%2;const S=this.game.settings;\n      const slider=(key,label,help='')=>\"'`<label class=\"setting-row\"><span>${label} <span class=\"value\" data-value=\"${key}\">${Math.round(S[key]*100)}%</span></span><input aria-label=\"${label}\" data-setting=\"${key}\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${S[key]}\">${help?`<small>${help}</small>`:'\"''}</label>\"'`;\n      const toggle=(id,label,value,help='\"'')=>btn(id,label+': '+(value?'On':'Off'),help);\n      let body=page===0?[\n        slider('volume','Master'),slider('music','Music','Default 10%. All sound is generated in code.'),slider('sfx','Effects'),slider('voice','Alien voices'),toggle('mute','Mute all',S.mute),\n      ].join(''):[\n        btn('glyphs','Controller labels: '+(S.glyphs==='xbox'?'Xbox A / B / X / Y':'PlayStation Cross / Circle')),\n        toggle('motion','Reduced motion',S.reduceMotion),toggle('flash','Reduced flashes',S.flashes===0),toggle('touchAssist','Touch auto-fire',S.touchAssist,'Clear upward lanes fire automatically; two fingers intentionally cut cover.'),\n        btn('fullscreen','Full screen','Requires a browser gesture; availability depends on the browser.')\n      ].join('');\n      html=this.frame('Settings <span class=\\\"page-number\\\">'+(page+1)+' / 2</span>',hub?'Local preferences only. The shared world continues.':'Your preferences persist when browser storage is available.',\"'`<div class=\"actions\">${body}${btn('\"'settingsPage',page===0?'Controls & accessibility →':'← Sound settings','',true)}\"'${btn('\"'resetSettings','Reset preferences','Music returns to 10%. Records are kept.',true)}\"'${btn('\"'back','Back','',true)}</div>\"'`);\n    }else if(s==='\"'pause'){\n      html=this.frame(hub?'Local options':'Defense paused',hub?'<span class=\\\"local-live\\\">TEAM WORLD IS LIVE</span>':'Your cannons are holding position.',\"'`<div class=\"actions\">${btn('\"'resume','Return to defense')}\"'${btn('\"'settings','Settings')}\"'${btn('\"'controls','Controls','',true)}\"'${btn('\"'dev','Developer tools','Diagnostics and live balance controls',true)}\"'${hub?'\"'':btn('restart','Restart campaign','A fresh run with the same roster and difficulty.',true)+btn('title','Return to title','',true)}</div><p class=\\\"foot\\\">\"'${hub?'\"'Your seat is neutral while this overlay is open.':'Pause from either player affects the whole local team.'}</p>\"'`);\n    }else if(s==='\"'dev'){\n      const disabled=hub;\n      const pg=this.devPage;let body='';\n      if(pg===0){\n        body=\"'`<div class=\"dev-grid\"><div class=\"actions\">${btn('\"'invincible','Invulnerability: '+(a.invulnerable?'On':'Off'),'Marks the run assisted.',false,disabled)}\"'${btn('\"'reserve','Add a deployment','Shared reserve +1',false,disabled)}\"'${btn('\"'charges','Fill repair charges','Each active player receives 3.',false,disabled)}\"'${btn('\"'encounter','Encounter: '+(w.encounter===6?'Flagship':w.encounter+1),'Left / Right selects, then restarts.',false,disabled)}\"'${btn('\"'phase','Flagship phase: '+(w.boss?.phase??'—'),'Starts the selected boss phase.',false,disabled)}</div><div class=\\\"actions\\\">\"'${btn('\"'restartEncounter','Restart encounter','Keeps score and cover; assisted.',false,disabled)}\"'${btn('\"'spawnType','Spawn selection: '+a.spawnType,'Left / Right chooses enemy or saucer.',false,disabled)}\"'${btn('\"'spawn','Spawn selected','Adds the selected attacker / bonus.',false,disabled)}\"'${btn('\"'overlay','Collision & telegraphs: '+(a.overlays?'On':'Off'))}\"'${btn('\"'time','Time: '+a.speed+'×','Live when the overlay is closed.',false,disabled)}\"'${btn('\"'step','Single step','One fixed 1/120 second step while this screen is open.',false,disabled)}</div></div><label class=\\\"setting-row\\\"><span>Deterministic seed</span><input class=\\\"seed\\\" id=\\\"seed-input\\\" aria-label=\\\"Deterministic seed\\\" type=\\\"text\\\" inputmode=\\\"numeric\\\" value=\\\"\"'${w.seed}\" ${disabled?'\"'disabled':''}><small>Use “Restart from seed” to begin an assisted campaign.</small></label>\"'${btn('\"'seed','Restart from seed','',true,disabled)}\"'`;\n      }else{\n        const list=TUNING.slice((pg-1)*5,pg*5);\n        body='\"'<div class=\\\"actions\\\">'+list.map(t=>\"'`<label class=\"setting-row\"><span>${escape(t.label)} <span class=\"value\" data-tune-value=\"${t.key}\">${Number(w.tuning[t.key]).toFixed(t.step<1?2:0)}</span></span><input type=\"range\" data-tuning=\"${t.key}\" aria-label=\"${escape(t.label)}\" min=\"${t.min}\" max=\"${t.max}\" step=\"${t.step}\" value=\"${w.tuning[t.key]}\" ${disabled?'\"'disabled':''}><small>\"'${escape(t.description)} Bounds ${t.min}–${t.max}.</small></label>`).join('\"'')+btn('resetTuning','Reset difficulty tuning','Restores values from this difficulty’s preset.',true,disabled)+'</div>';\n      }\n      html=this.frame('Developer tools <span class=\\\"page-number\\\">'+(pg+1)+' / 3</span>',hub?'World changes are disabled in AI Hub sessions. Local diagnostics remain available.':'Changing the world marks this run ASSISTED and separates its records.',body+\"'`<div class=\"dev-summary\" id=\"dev-summary\">${escape(a.stateSummary())}</div><div class=\"page-actions\">${btn('\"'devPage','Next page')}\"'${btn('\"'resume','Play / observe')}\"'${btn('\"'back','Back','',true)}</div>\"'`,'\"'dev-screen');\n    }else if(s==='results'){\n      const won=w.status==='victory';\n      const minutes=Math.floor(w.time/60),seconds=Math.floor(w.time%60);\n      html=this.frame(won?'PLANET KEPT.':'DEFENSE LOST.',won?'The Invadettes have somewhere else to be.':(w.reason==='breach'?'An invader crossed the breach line.':w.reason==='time-expired'?'Time expired before the flagship fell.':'All deployments were exhausted.'),\"'`<p class=\"pill\">${escape((DIFFICULTIES[w.difficulty]?.name||'\"'Standard')+' · '+(w.players.length>1?'Co-op':'Solo')+(w.assisted?' · Assisted':''))}</p><p class=\\\"score\\\">\"'${String(w.score).padStart(6,'\"'0')}</p><div class=\\\"contributions\\\">\"'${w.players.map(s=>`<div><strong>P${s.seat+1} · ${s.score} pts</strong><br>${s.kills} targets · ${s.repairs} repairs</div>`).join('\"'')}</div><p class=\\\"sub\\\">\"'${minutes}:${String(seconds).padStart(2,'\"'0')} · \"'${won?'\"'Six formations and the flagship cleared.':'Wave '+Math.min(6,w.encounter+1)+' reached.'}</p><div class=\\\"actions\\\">\"'${hub?btn('\"'resultsWait','AI Hub handles the next round','Waiting for the Hub result card.',false,true):btn('restart','Deploy again')+btn('settings','Settings','',true)+btn('title','Title','',true)}</div>\"'`);\n    }else if(s==='\"'records'){\n      const records=a.records.slice().sort((x,y)=>y.score-x.score).slice(0,7);\n      html=this.frame('Local records','Scores stay on this browser. Assisted runs are labelled.',\"'`<div>${records.length?records.map((r,i)=>`<div class=\"record-row\"><span>${i+1}. ${escape(r.mode)}<br><small>${escape(r.difficulty)} · ${r.assisted?'\"'ASSISTED':'STANDARD RULES'} · \"'${r.won?'\"'VICTORY':'DEFEAT'}</small></span><strong>\"'${r.score}</strong></div>`).join('\"''):'<p class=\\\"sub\\\">A clean slate. Your planet awaits.</p>'}</div><div class=\\\"actions\\\" style=\\\"margin-top:20px\\\">\"'${btn('\"'back','Back')}</div>\"'`);\n    }else if(s==='\"'about'){\n      const pg=this.pages[this.page%this.pages.length];\n      html=this.frame(escape(pg.title)+' <span class=\\\"page-number\\\">'+(this.page+1)+' / '+this.pages.length+'</span>','Credits, provenance and honest build feedback.',\"'`<div class=\"report-body\">${pg.body.map(([k,v])=>`<p><strong>${escape(k)}</strong><br>${escape(v)}</p>`).join('\"'')}</div><div class=\\\"page-actions\\\">\"'${btn('\"'previous','← Previous')}\"'${btn('\"'next','Next →')}\"'${btn('\"'back','Back','',true)}</div>\"'`,'\"'report-screen');\n    }\n    this.root.innerHTML=html;\n    this.rows=Array.from(this.root.querySelectorAll('button:not(:disabled),input:not(:disabled),select:not(:disabled)'));\n    this.rows.forEach((el,i)=>{\n      el.addEventListener('pointerenter',()=>this.focusAt(i,{dom:false}));\n      el.addEventListener('focus',()=>this.focusAt(i,{dom:false}));\n      if(el.dataset.action)el.addEventListener('click',e=>{if(performance.now()<a.wakeUntil){e.preventDefault();return;}a.activity('pointer');this.activate(el.dataset.action);});\n      if(el.dataset.setting)el.addEventListener('input',()=>{\n        a.activity('keyboard');this.game.settings.set(el.dataset.setting,Number(el.value));\n        this.root.querySelector('[data-value=\\\"'+el.dataset.setting+'\\\"]').textContent=Math.round(el.value*100)+'%';\n      });\n      if(el.dataset.tuning)el.addEventListener('input',()=>{\n        a.tune(el.dataset.tuning,Number(el.value));this.root.querySelector('[data-tune-value=\\\"'+el.dataset.tuning+'\\\"]').textContent=Number(el.value).toFixed(2);\n      });\n    });\n    this.focusAt(Math.min(this.focus,this.rows.length-1),{dom:false});\n  }\n  activate(id,dir=1){\n    const a=this.app,s=this.screen;\n    if(id==='back'){\n      if(s==='pause'||s==='dev'){this.show(s==='dev'?'pause':'play');return;}\n      this.show(this.parent||'title');return;\n    }\n    if(id==='settings'||id==='controls'||id==='dev'||id==='about'||id==='records'||id==='launch'){\n      this.page=0;if(id==='dev')this.devPage=0;\n      this.show(id,{parent:s});return;\n    }\n    if(id==='players'){a.playerCount=a.playerCount===1?2:1;this.render();return;}\n    if(id==='difficulty'){a.difficulty=(a.difficulty+dir+4)%4;this.render();return;}\n    if(id==='settingsPage'){this.page=(this.page+1)%2;this.render();return;}\n    if(id==='previous'||id==='next'){this.page=(this.page+(id==='next'?1:-1)+this.pages.length)%this.pages.length;this.render();return;}\n    if(id==='devPage'){this.devPage=(this.devPage+1)%3;this.render();return;}\n    if(id==='start'||id==='restart'){a.startRun();return;}\n    if(id==='resume'){this.show('play');return;}\n    if(id==='title'){a.toTitle();return;}\n    if(id==='glyphs'){this.game.settings.set('glyphs',this.game.settings.glyphs==='xbox'?'playstation':'xbox');this.render();return;}\n    if(id==='mute'){this.game.settings.set('mute',\"'!this.game.settings.mute);this.render();return;}\n    if(id==='\"'motion'){this.game.settings.set('reduceMotion',\"'!this.game.settings.reduceMotion);this.render();return;}\n    if(id==='\"'flash'){this.game.settings.set('flashes',this.game.settings.flashes===0?1:0);this.render();return;}\n    if(id==='touchAssist'){this.game.settings.set('touchAssist',\"'!this.game.settings.touchAssist);this.render();return;}\n    if(id==='\"'resetSettings'){a.resetSettings();this.render();return;}\n    if(id==='fullscreen'){a.fullscreen();return;}\n    a.devAction(id,dir);this.render();\n  }\n  update(dt){\n    this.lock=Math.max(0,this.lock-dt);\n    if(['play','attract','hub-wait'].includes(this.screen))return;\n    for(const I of this.game.players){\n      if(this.lock>0)continue;\n      if(I.repeat('down',.32,.12)){this.focusAt(this.focus+1);this.app.activity(I.lastDevice);}\n      if(I.repeat('up',.32,.12)){this.focusAt(this.focus-1);this.app.activity(I.lastDevice);}\n      const el=this.rows[this.focus];\n      if(\"'!el)continue;\n      if(el.tagName==='\"'INPUT'&&el.type==='text')continue;\n      let dir=0;\n      if(I.repeat('left',.32,.12))dir=-1;\n      if(I.repeat('right',.32,.12))dir=1;\n      if(dir){\n        this.app.activity(I.lastDevice);\n        if(el.type==='range'){\n          el.value=Math.max(Number(el.min),Math.min(Number(el.max),Number(el.value)+Number(el.step||1)*dir));\n          el.dispatchEvent(new Event('input',{bubbles:true}));\n        }else if(['players','difficulty','encounter','phase','spawnType','time','glyphs'].includes(el.dataset.action))this.activate(el.dataset.action,dir);\n      }\n      if(I.pressed('confirm')||I.pressed('start')){\n        this.app.activity(I.lastDevice);\n        if(el.dataset.action)this.activate(el.dataset.action);\n        I.consumeAll();break;\n      }\n      if(I.pressed('cancel')||I.pressed('pause')){\n        this.app.activity(I.lastDevice);\n        this.activate('back');I.consumeAll();break;\n      }\n    }\n    if(this.screen==='dev'){\n      const el=this.root?.querySelector('#dev-summary');if(el)el.textContent=this.app.stateSummary();\n    }\n  }\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/ui.js' <<'EOF'\nimport {DIFFICULTIES,TUNING} from './content.js';\n\nconst escape=s=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst btn=(id,label,sub='',secondary=false,disabled=false)=>\"'`<button class=\"action ${secondary?'\"'secondary':''}\\\" data-action=\\\"\"'${id}\" ${disabled?'\"'disabled':''}>\"'${escape(label)}${sub?`<small>${escape(sub)}</small>`:'\"''}</button>\"'`;\nconst TEST_Q=['\"'How many issues did testing catch?','How many were critical or game breaking?','Most helpful test','Least helpful test'];\nconst ENGINE_Q=['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important system built','Hardest part of using the engine','Engine changes and reasons','One suggested engine change'];\nconst PROMPT_Q=['What worked best in the prompt?','What was confusing?','What was hardest?','One suggested prompt change'];\n\nexport class Interface{\n  constructor(app,report){\n    this.app=app;this.game=app.game;this.report=report;this.root=typeof document==='undefined'?null:document.getElementById('ui');\n    this.screen='title';this.page=0;this.focus=0;this.memory={};this.parent='title';this.rows=[];this.lock=.2;this.devPage=0;\n    this.pages=this.reportPages();\n  }\n  reportPages(){\n    const pages=[{title:'About Orbit Invadettes',body:[\n      ['ORIGINAL GAME','Cut a lane. Catch the scrap. Keep your planet. Six formations across three outposts, then an original hostile flagship. Solo or simultaneous local co-op; shared-world online co-op when launched by AI Hub.'],\n      ['CREDITS','Game design, programming, original pixel art and procedural music: OpenAI gpt-6.1-sol. Built on Michael Crosato’s my-3D2dge. AI Hub session client by Michael Crosato. No commercial game assets, ROMs or recorded audio.'],\n      ['SOURCE INTERPRETATION','Inspired by Bally’s Astrocade Space Invaders, subsequently called Astro Battle. The supplied combined source wording is interpreted this way; it is not a newly established release-history claim. Repair salvage, specialists, co-op and the flagship are original additions.']\n    ]},{title:'Research & licenses',body:[\n      ['WHAT WAS EXAMINED','Archived manual scan, manual transcription, Video Games October 1982 comparison, and sampled archive-linked Nice and Games Astro Battle footage at 90/120 seconds with a sequential filmstrip. Source sound was not listened to; exact audio is unknown.'],\n      ['PRIMARY SOURCES','Bally Alley manual archive: ballyalley.com/cart_manuals/html_manuals/astro_battle.htm · gameplay archive: ballyalley.com/astrocade_videos/cartridge_videos/cartridge_videos.html. Detailed observations and retained references are in research/RESEARCH.md.'],\n      ['LICENSES','my-3D2dge © 2026 Michael Crosato, MIT License. Permission is granted, free of charge, to use, copy, modify, merge, publish, distribute, sublicense and/or sell copies, subject to retaining the copyright and permission notice. Software is provided “AS IS”, without warranty. Full MIT notice is retained in this HTML.']\n    ]}];\n    const fields=Object.entries(this.report.sourceInformation);\n    for(let i=0;i<fields.length;i+=3)pages.push({title:'Source information',body:fields.slice(i,i+3).map(([k,v])=>[k.replace(/([A-Z])/g,' \"'$1'\"').toUpperCase(),v])});\n    for(const [title,questions,answers] of [['Testing feedback',TEST_Q,this.report.testingFeedback],['Engine feedback',ENGINE_Q,this.report.engineFeedback],['Prompt feedback',PROMPT_Q,this.report.promptFeedback]]){\n      for(let i=0;i<answers.length;i+=2)pages.push({title,body:answers.slice(i,i+2).map((v,j)=>[questions[i+j],v])});\n    }\n    return pages;\n  }\n  show(screen,opts={}){\n    this.memory[this.screen]=this.focus;\n    if(opts.parent)this.parent=opts.parent;\n    this.screen=screen;this.focus=this.memory[screen]??0;this.lock=.18;\n    this.app.clearInput();\n    this.render();\n  }\n  focusAt(n,{dom=true}={}){\n    if(\"'!this.rows.length)return;\n    this.focus=(n+this.rows.length)%this.rows.length;\n    this.rows.forEach((el,i)=>{\n      const row=el.closest('\"'.setting-row')||el;\n      row.classList.toggle('focused',i===this.focus);\n    });\n    if(dom&&this.rows[this.focus])this.rows[this.focus].focus({preventScroll:true});\n  }\n  frame(title,sub,body,extra=''){\n    return \"'`<section class=\"screen menu-screen ${extra}\" aria-label=\"${escape(title)}\"><p class=\"eyebrow\">ORBIT INVADETTES / DEFENSE NETWORK</p><h1 class=\"menu-title\">${title}</h1>${sub?`<p class=\"sub\">${sub}</p>`:'\"''}\"'${body}</section>`;\n  }\n  render(){\n    if(!this.root)return;\n    const a=this.app,w=a.world,s=this.screen,hub=!!a.session;\n    if(s==='\"'play'||s==='hub-wait'){this.root.innerHTML='';this.rows=[];return;}\n    if(s==='attract'){\n      this.root.innerHTML='<div class=\\\"demo-banner\\\"><strong>ATTRACT PLAY</strong><p>AI demonstration · any input returns to title</p></div>';this.rows=[];return;\n    }\n    let html='';\n    if(s==='title'){\n      html=\"'`<section class=\"screen title-screen\" aria-label=\"Title\"><div class=\"title-art\"><p class=\"eyebrow\">A small planet. A very large problem.</p><h1 class=\"logo\">Orbit<span>Invadettes</span></h1><p class=\"tagline\">Cut a lane. Catch the scrap.<br>Keep your planet.</p><p class=\"edition\">PLANETARY DEFENSE / EST. 1979 · REBUILT 2026</p></div><div class=\"menu-card\"><span class=\"pill\">1–2 PLAYERS / SIX WAVES + FLAGSHIP</span><div class=\"actions\">${btn('\"'launch','Deploy cannons','Solo or simultaneous local co-op')}\"'${btn('\"'controls','How to defend')}\"'${btn('\"'settings','Settings','',true)}\"'${btn('\"'records','Local records','',true)}\"'${btn('\"'about','About & credits','',true)}</div><p class=\\\"foot\\\">\"'${escape(a.menuPrompt())}<br>Online co-op is available through AI Hub.<br>Idle 10 seconds for a demonstration.</p></div></section>`;\n    }else if(s==='\"'launch'){\n      const d=DIFFICULTIES[a.difficulty],name=typeof d==='string'?d:d.name;\n      html=this.frame('Choose your defense','The entire campaign is available at every difficulty.',\"'`<div class=\"actions\">${btn('\"'players','Players: '+(a.playerCount===1?'Solo':'Two-player co-op'),a.playerCount===1?'3 deployments, including your first cannon.':'6 shared deployments. Two pads, keyboard + pad, or split keyboard.')}\"'${btn('\"'difficulty','Difficulty: '+name,(d.description||d.help||'Adjust with Left / Right.'))}\"'${btn('\"'start','Launch defense','Hold fire. Collect salvage. Repair the nearest bunker.')}\"'${btn('\"'back','Back','',true)}</div><p class=\\\"foot\\\">P1: A/D · Space · Q. P2 on a shared keyboard: arrows · . · /.<br>Local roster locks at launch. A returning pad reclaims its seat.</p>\"'`);\n    }else if(s==='\"'controls'){\n      const t=a.primary==='touch';\n      html=this.frame('Two actions. One planet.',hub?'Your Options overlay is local. The team’s world keeps moving.':'Six formations. Three outposts. One hostile flagship.',\"'`<div class=\"control-grid\"><div><strong>MOVE</strong>${t?'\"'Drag horizontally in the lower play area. Movement is relative to your thumb.':'Left stick / D-pad · A/D or arrows. Move the mouse inside the field to set a horizontal target.'}</div><div><strong>FIRE</strong>\"'${t?'\"'Clear lanes fire automatically. A second finger fires through cover to cut a new lane.':'Hold R2 or Cross · Space or left mouse. Two missiles at a time. Your shots cut your bunkers.'}</div><div><strong>REPAIR</strong>\"'${t?'\"'Tap the temporary REPAIR button while moving. It appears when salvage can restore cover.':'L1 or Square · Q or right mouse. One charge restores a cluster in the nearest bunker.'}</div><div><strong>READ THE SKY</strong>Gold brackets announce enemy fire. Mint diamonds are salvage. Keep aliens above the striped breach line.</div></div><div class=\\\"actions\\\">\"'${btn('\"'back','Ready','',false)}</div><p class=\\\"foot\\\">\"'${t?'\"'Use two simultaneous contacts to deliberately cut cover.':'P2 shared keyboard: arrows · . to fire · / to repair.'}<br>Options / Escape: \"'${hub?'\"'local options':'pause'}. Xbox button names are available in Settings.</p>\"'`);\n    }else if(s==='\"'settings'){\n      const page=this.page%2;const S=this.game.settings;\n      const slider=(key,label,help='')=>\"'`<label class=\"setting-row\"><span>${label} <span class=\"value\" data-value=\"${key}\">${Math.round(S[key]*100)}%</span></span><input aria-label=\"${label}\" data-setting=\"${key}\" type=\"range\" min=\"0\" max=\"1\" step=\".05\" value=\"${S[key]}\">${help?`<small>${help}</small>`:'\"''}</label>\"'`;\n      const toggle=(id,label,value,help='\"'')=>btn(id,label+': '+(value?'On':'Off'),help);\n      let body=page===0?[\n        slider('volume','Master'),slider('music','Music','Default 10%. All sound is generated in code.'),slider('sfx','Effects'),slider('voice','Alien voices'),toggle('mute','Mute all',S.mute),\n      ].join(''):[\n        btn('glyphs','Controller labels: '+(S.glyphs==='xbox'?'Xbox A / B / X / Y':'PlayStation Cross / Circle')),\n        toggle('motion','Reduced motion',S.reduceMotion),toggle('flash','Reduced flashes',S.flashes===0),toggle('touchAssist','Touch auto-fire',S.touchAssist,'Clear upward lanes fire automatically; two fingers intentionally cut cover.'),\n        btn('fullscreen','Full screen','Requires a browser gesture; availability depends on the browser.')\n      ].join('');\n      html=this.frame('Settings <span class=\\\"page-number\\\">'+(page+1)+' / 2</span>',hub?'Local preferences only. The shared world continues.':'Your preferences persist when browser storage is available.',\"'`<div class=\"actions\">${body}${btn('\"'settingsPage',page===0?'Controls & accessibility →':'← Sound settings','',true)}\"'${btn('\"'resetSettings','Reset preferences','Music returns to 10%. Records are kept.',true)}\"'${btn('\"'back','Back','',true)}</div>\"'`);\n    }else if(s==='\"'pause'){\n      html=this.frame(hub?'Local options':'Defense paused',hub?'<span class=\\\"local-live\\\">TEAM WORLD IS LIVE</span>':'Your cannons are holding position.',\"'`<div class=\"actions\">${btn('\"'resume','Return to defense')}\"'${btn('\"'settings','Settings')}\"'${btn('\"'controls','Controls','',true)}\"'${btn('\"'dev','Developer tools','Diagnostics and live balance controls',true)}\"'${hub?'\"'':btn('restart','Restart campaign','A fresh run with the same roster and difficulty.',true)+btn('title','Return to title','',true)}</div><p class=\\\"foot\\\">\"'${hub?'\"'Your seat is neutral while this overlay is open.':'Pause from either player affects the whole local team.'}</p>\"'`);\n    }else if(s==='\"'dev'){\n      const disabled=hub;\n      const pg=this.devPage;let body='';\n      if(pg===0){\n        body=\"'`<div class=\"dev-grid\"><div class=\"actions\">${btn('\"'invincible','Invulnerability: '+(a.invulnerable?'On':'Off'),'Marks the run assisted.',false,disabled)}\"'${btn('\"'reserve','Add a deployment','Shared reserve +1',false,disabled)}\"'${btn('\"'charges','Fill repair charges','Each active player receives 3.',false,disabled)}\"'${btn('\"'encounter','Encounter: '+(w.encounter===6?'Flagship':w.encounter+1),'Left / Right selects, then restarts.',false,disabled)}\"'${btn('\"'phase','Flagship phase: '+(w.boss?.phase??'—'),'Starts the selected boss phase.',false,disabled)}</div><div class=\\\"actions\\\">\"'${btn('\"'restartEncounter','Restart encounter','Keeps score and cover; assisted.',false,disabled)}\"'${btn('\"'spawnType','Spawn selection: '+a.spawnType,'Left / Right chooses enemy or saucer.',false,disabled)}\"'${btn('\"'spawn','Spawn selected','Adds the selected attacker / bonus.',false,disabled)}\"'${btn('\"'overlay','Collision & telegraphs: '+(a.overlays?'On':'Off'))}\"'${btn('\"'time','Time: '+a.speed+'×','Live when the overlay is closed.',false,disabled)}\"'${btn('\"'step','Single step','One fixed 1/120 second step while this screen is open.',false,disabled)}</div></div><label class=\\\"setting-row\\\"><span>Deterministic seed</span><input class=\\\"seed\\\" id=\\\"seed-input\\\" aria-label=\\\"Deterministic seed\\\" type=\\\"text\\\" inputmode=\\\"numeric\\\" value=\\\"\"'${w.seed}\" ${disabled?'\"'disabled':''}><small>Use “Restart from seed” to begin an assisted campaign.</small></label>\"'${btn('\"'seed','Restart from seed','',true,disabled)}\"'`;\n      }else{\n        const list=TUNING.slice((pg-1)*5,pg*5);\n        body='\"'<div class=\\\"actions\\\">'+list.map(t=>\"'`<label class=\"setting-row\"><span>${escape(t.label)} <span class=\"value\" data-tune-value=\"${t.key}\">${Number(w.tuning[t.key]).toFixed(t.step<1?2:0)}</span></span><input type=\"range\" data-tuning=\"${t.key}\" aria-label=\"${escape(t.label)}\" min=\"${t.min}\" max=\"${t.max}\" step=\"${t.step}\" value=\"${w.tuning[t.key]}\" ${disabled?'\"'disabled':''}><small>\"'${escape(t.description)} Bounds ${t.min}–${t.max}.</small></label>`).join('\"'')+btn('resetTuning','Reset difficulty tuning','Restores values from this difficulty’s preset.',true,disabled)+'</div>';\n      }\n      html=this.frame('Developer tools <span class=\\\"page-number\\\">'+(pg+1)+' / 3</span>',hub?'World changes are disabled in AI Hub sessions. Local diagnostics remain available.':'Changing the world marks this run ASSISTED and separates its records.',body+\"'`<div class=\"dev-summary\" id=\"dev-summary\">${escape(a.stateSummary())}</div><div class=\"page-actions\">${btn('\"'devPage','Next page')}\"'${btn('\"'resume','Play / observe')}\"'${btn('\"'back','Back','',true)}</div>\"'`,'\"'dev-screen');\n    }else if(s==='results'){\n      const won=w.status==='victory';\n      const minutes=Math.floor(w.time/60),seconds=Math.floor(w.time%60);\n      html=this.frame(won?'PLANET KEPT.':'DEFENSE LOST.',won?'The Invadettes have somewhere else to be.':(w.reason==='breach'?'An invader crossed the breach line.':w.reason==='time-expired'?'Time expired before the flagship fell.':'All deployments were exhausted.'),\"'`<p class=\"pill\">${escape((DIFFICULTIES[w.difficulty]?.name||'\"'Standard')+' · '+(w.players.length>1?'Co-op':'Solo')+(w.assisted?' · Assisted':''))}</p><p class=\\\"score\\\">\"'${String(w.score).padStart(6,'\"'0')}</p><div class=\\\"contributions\\\">\"'${w.players.map(s=>`<div><strong>P${s.seat+1} · ${s.score} pts</strong><br>${s.kills} targets · ${s.repairs} repairs</div>`).join('\"'')}</div><p class=\\\"sub\\\">\"'${minutes}:${String(seconds).padStart(2,'\"'0')} · \"'${won?'\"'Six formations and the flagship cleared.':'Wave '+Math.min(6,w.encounter+1)+' reached.'}</p><div class=\\\"actions\\\">\"'${hub?btn('\"'resultsWait','AI Hub handles the next round','Waiting for the Hub result card.',false,true):btn('restart','Deploy again')+btn('settings','Settings','',true)+btn('title','Title','',true)}</div>\"'`);\n    }else if(s==='\"'records'){\n      const records=a.records.slice().sort((x,y)=>y.score-x.score).slice(0,7);\n      html=this.frame('Local records','Scores stay on this browser. Assisted runs are labelled.',\"'`<div>${records.length?records.map((r,i)=>`<div class=\"record-row\"><span>${i+1}. ${escape(r.mode)}<br><small>${escape(r.difficulty)} · ${r.assisted?'\"'ASSISTED':'STANDARD RULES'} · \"'${r.won?'\"'VICTORY':'DEFEAT'}</small></span><strong>\"'${r.score}</strong></div>`).join('\"''):'<p class=\\\"sub\\\">A clean slate. Your planet awaits.</p>'}</div><div class=\\\"actions\\\" style=\\\"margin-top:20px\\\">\"'${btn('\"'back','Back')}</div>\"'`);\n    }else if(s==='\"'about'){\n      const pg=this.pages[this.page%this.pages.length];\n      html=this.frame(escape(pg.title)+' <span class=\\\"page-number\\\">'+(this.page+1)+' / '+this.pages.length+'</span>','Credits, provenance and honest build feedback.',\"'`<div class=\"report-body\">${pg.body.map(([k,v])=>`<p><strong>${escape(k)}</strong><br>${escape(v)}</p>`).join('\"'')}</div><div class=\\\"page-actions\\\">\"'${btn('\"'previous','← Previous')}\"'${btn('\"'next','Next →')}\"'${btn('\"'back','Back','',true)}</div>\"'`,'\"'report-screen');\n    }\n    this.root.innerHTML=html;\n    this.rows=Array.from(this.root.querySelectorAll('button:not(:disabled),input:not(:disabled),select:not(:disabled)'));\n    this.rows.forEach((el,i)=>{\n      el.addEventListener('pointerenter',()=>this.focusAt(i,{dom:false}));\n      el.addEventListener('focus',()=>this.focusAt(i,{dom:false}));\n      if(el.dataset.action)el.addEventListener('click',e=>{if(performance.now()<a.wakeUntil){e.preventDefault();return;}a.activity('pointer');this.activate(el.dataset.action);});\n      if(el.dataset.setting)el.addEventListener('input',()=>{\n        a.activity('keyboard');this.game.settings.set(el.dataset.setting,Number(el.value));\n        this.root.querySelector('[data-value=\\\"'+el.dataset.setting+'\\\"]').textContent=Math.round(el.value*100)+'%';\n      });\n      if(el.dataset.tuning)el.addEventListener('input',()=>{\n        a.tune(el.dataset.tuning,Number(el.value));this.root.querySelector('[data-tune-value=\\\"'+el.dataset.tuning+'\\\"]').textContent=Number(el.value).toFixed(2);\n      });\n    });\n    this.focusAt(Math.min(this.focus,this.rows.length-1),{dom:false});\n  }\n  activate(id,dir=1){\n    const a=this.app,s=this.screen;\n    if(id==='back'){\n      if(s==='pause'||s==='dev'){this.show(s==='dev'?'pause':'play');return;}\n      this.show(this.parent||'title');return;\n    }\n    if(id==='settings'||id==='controls'||id==='dev'||id==='about'||id==='records'||id==='launch'){\n      this.page=0;if(id==='dev')this.devPage=0;\n      this.show(id,{parent:s});return;\n    }\n    if(id==='players'){a.playerCount=a.playerCount===1?2:1;this.render();return;}\n    if(id==='difficulty'){a.difficulty=(a.difficulty+dir+4)%4;this.render();return;}\n    if(id==='settingsPage'){this.page=(this.page+1)%2;this.render();return;}\n    if(id==='previous'||id==='next'){this.page=(this.page+(id==='next'?1:-1)+this.pages.length)%this.pages.length;this.render();return;}\n    if(id==='devPage'){this.devPage=(this.devPage+1)%3;this.render();return;}\n    if(id==='start'||id==='restart'){a.startRun();return;}\n    if(id==='resume'){this.show('play');return;}\n    if(id==='title'){a.toTitle();return;}\n    if(id==='glyphs'){this.game.settings.set('glyphs',this.game.settings.glyphs==='xbox'?'playstation':'xbox');this.render();return;}\n    if(id==='mute'){this.game.settings.set('mute',\"'!this.game.settings.mute);this.render();return;}\n    if(id==='\"'motion'){this.game.settings.set('reduceMotion',\"'!this.game.settings.reduceMotion);this.render();return;}\n    if(id==='\"'flash'){this.game.settings.set('flashes',this.game.settings.flashes===0?1:0);this.render();return;}\n    if(id==='touchAssist'){this.game.settings.set('touchAssist',\"'!this.game.settings.touchAssist);this.render();return;}\n    if(id==='\"'resetSettings'){a.resetSettings();this.render();return;}\n    if(id==='fullscreen'){a.fullscreen();return;}\n    a.devAction(id,dir);this.render();\n  }\n  update(dt){\n    this.lock=Math.max(0,this.lock-dt);\n    if(['play','attract','hub-wait'].includes(this.screen))return;\n    for(const I of this.game.players){\n      if(this.lock>0)continue;\n      if(I.repeat('down',.32,.12)){this.focusAt(this.focus+1);this.app.activity(I.lastDevice);}\n      if(I.repeat('up',.32,.12)){this.focusAt(this.focus-1);this.app.activity(I.lastDevice);}\n      const el=this.rows[this.focus];\n      if(\"'!el)continue;\n      if(el.tagName==='\"'INPUT'&&el.type==='text')continue;\n      let dir=0;\n      if(I.repeat('left',.32,.12))dir=-1;\n      if(I.repeat('right',.32,.12))dir=1;\n      if(dir){\n        this.app.activity(I.lastDevice);\n        if(el.type==='range'){\n          el.value=Math.max(Number(el.min),Math.min(Number(el.max),Number(el.value)+Number(el.step||1)*dir));\n          el.dispatchEvent(new Event('input',{bubbles:true}));\n        }else if(['players','difficulty','encounter','phase','spawnType','time','glyphs'].includes(el.dataset.action))this.activate(el.dataset.action,dir);\n      }\n      if(I.pressed('confirm')||I.pressed('start')){\n        this.app.activity(I.lastDevice);\n        if(el.dataset.action)this.activate(el.dataset.action);\n        I.consumeAll();break;\n      }\n      if(I.pressed('cancel')||I.pressed('pause')){\n        this.app.activity(I.lastDevice);\n        this.activate('back');I.consumeAll();break;\n      }\n    }\n    if(this.screen==='dev'){\n      const el=this.root?.querySelector('#dev-summary');if(el)el.textContent=this.app.stateSummary();\n    }\n  }\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"cat 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/ASSET-CONTRACT.md'; sed -n '1,100p' 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/session.js'; sed -n '1,80p' 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/audio.js'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"cat 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/ASSET-CONTRACT.md'; sed -n '1,100p' 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/session.js'; sed -n '1,80p' 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/audio.js'\"","aggregated_output":"# Native asset and sound contract\n\n`createAssets(E)` from assets.js returns original native `E.sprite` / `E.anim` objects. No external files, image decoding or commercial extracted material are used.\n\n- `ships[seat]`: 18×14 static upward cannon sprites. Turquoise P1 has a long central barrel; warm peach P2 has additional side fins. The renderer supplies recoil/ready light from the simulation, keeping collision authoritative.\n- `enemies[row]`: four two-frame native animations. Rows are mint crowned saucers, coral peepers, lilac jellies, gold crabs. Frame lists are 16×12; silhouettes differ independently of color. Select with `.frame(formation.beat / 2)` or `.frames[formation.beat % 2]` to align poses to the march. Passing ordinary world time gives the default 2fps cycle.\n- `armour`: complete 16×12 armored alien; `armourShell`: matching shell overlay; `armourAnim`: animation-compatible complete shell. Use ordinary identity after the shell breaks.\n- `bombardier`: two-frame 16×12 animation, orange with a visible underslung bomb.\n- `saucer`: 24×12, 5fps bonus ship; use world clock and a restrained renderer wobble. Its pink silhouette differs from the hostile flagship.\n- `salvage`: 9×9, 8fps spinning mint diamond. Friendly white central pixel and diamond outline distinguish it from warm enemy projectiles.\n- `flagship` and `flagshipOpen`: 70×30. Purple crescent hull, twin heavy emitters, cyan bridge and dark/bright central iris. Renderer may draw telegraphs, emitter damage and opening interpolation above these native sprites.\n- `repair`, `bomb`, `heavyBomb`: pixel icons/projectile sprites.\n- `hues`, `ramps`: identity colors and their `E.tones` values. `bunkerRamps[location]` contains six colors from `E.ramp`. Bunker occupancy remains simulation mask data, never these sprite rows.\n\nDraw native animations using `r.sprite(x,y,z,anim,{t})`, or select `.frame(t)` and draw through `E.px.sprite` inside an overlay. Static sprites expose `.w,.h,.runs,._src`; the engine retains these in headless mode.\n\n## Audio\n\n`createAudio(game)` from audio.js returns:\n\n- `unlock()`: invoke only from a real key/pointer/touch/controller gesture. It creates/resumes engine audio buses and applies the most recently requested soundtrack. Repeated unlocks resume suspended audio without restarting music. Headless invocation safely returns false.\n- `events(eventArray, world)`: call once for each simulation step before the next step clears events. Accepts `shot,kill,armour,erode,repair,pickup,loss,respawn,march,volley,saucer,boss,stage,victory,defeat,extra`. Each event is `{type,x?}`. `march` emits a bass note synchronized to the actual formation step. Erosion/volley sounds are rate limited so multi-cell impacts do not overwhelm the mix. No event changes gameplay state or triggers engine shake/freeze.\n- `location(world)`: selects one of three original sparse location tunes or the flagship theme, then one-shot victory/defeat songs. It is idempotent; pass encounter/location/status changes, or call freely each frame. It stays silent until `unlock`.\n- `effect(name,x)`: menu sounds `select`, `confirm`, `denied`, or the named combat effects.\n- `bark('command'|'alien')`: brief formant-filtered oscillator gibberish through the native voice bus, with at least 3.5 seconds between barks. Necessary information belongs to the renderer's short alert subtitles, never speech.\n- `stop()`: immediately stops authored oscillator sources, retained SFX handles, and music; resets soundtrack/event counters needed for replay. Does not destroy the engine or revoke the audio gesture.\n- `diagnostics()`: unlock/readiness, active custom oscillator count, event/effect/bark/throttle totals, music selection and actual bus values.\n- `renderProbe(OfflineAudioContextConstructor,{muted,bus})`: renders the exact authored glass-instrument generator at bounded gain and returns `{finite,peak,rms,samples,bus,muted}`. Music probe uses the required 0.10 gain. This establishes generated signal and muted silence, never human taste.\n\nMusic, SFX and voice use native engine buses. `createAudio` preserves settings; the app owns initial/persisted music volume and must apply 0.10 on first use and reset. No encoded samples, audio fetches or pre-gesture initialization occur here. All oscillator sources stop after finite envelopes; active custom nodes are explicitly tracked and disconnected.\n\n## Evidence\n\n`tests/assets.mjs` exports `checkAssets()` for the root one-command suite. It validates every authored sprite/animation/palette, distinct row silhouettes, native headless `E.Game({headless:true,draw:true})` rendering, no engine errors/warnings, and safe silent headless audio. Direct invocation prints one-line success or failures.\n\n`evidence/asset-sheet.png` was generated from the exact native sprite row data and visually inspected: four readable comic silhouettes, distinct cannons, bonus/flagship distinction, and bright closed/open flagship core. `research/RESEARCH.md` records actual source scan, article and sampled-video inspection and unknowns.\n/**\n * Orbit Invadettes — AI Hub Session Protocol v1 shared authority.\n * Upstream session.js remains pristine and is embedded before this module.\n * Host: complete, lossless compact snapshots, reliable at 10 Hz.\n * Guests: bounded actions, unreliable at 10 Hz, monotonically acknowledged\n * repair edges. No participant predicts damage, inventory or score.\n */\nconst STEP = 1 / 120;\nconst HEARTBEAT_MS = 100;\nconst STALE_MS = 650;\nconst MAX_BYTES = 16_000;\nconst MAX_PRESENTATION_EVENTS = 64;\nconst KEYS = (\n  'tick time seed rng epoch encounter status reason score reserve extraAwarded assisted players enemies bullets pickups bunkers formation boss saucer events tuning difficulty location encounterTime transitionTime nextEncounter killCount stats intro eventSeq ' +\n  'seat id x y alive respawn protected charges kills repairs recovery active gone mask original cols rows cell center row col type hp maxHp telegraph flash vy owner kind r life dir timer beat initial interval ' +\n  'phase emitters open cycle safeLane age hit playerSpeed shotRecovery marchInterval descent fireInterval playerShotSpeed bombSpeed salvageEvery repairYield bossHealth ' +\n  'shotTimer fireTimer saucerTimer bossTimer nextId shots hits lost deployed earned missed caught spent repaired totalKills lastDamage moved fired repairedCover info delay duration ' +\n  'fireColumn fireCycle volleyTimer nextSaucer repairCount shield introMoved introFire introRepair name value count bossPhase breach enemyKills spawnTimer safe transition'\n).trim().split(/\\s+/);\nconst KEY_INDEX = new Map(KEYS.map((key, index) => [key, '~' + index.toString(36)]));\nconst KEY_REVERSE = new Map([...KEY_INDEX].map(([key, value]) => [value, key]));\nconst clamp = (value, low, high) => Math.max(low, Math.min(high, value));\nconst finite = (value) => typeof value === 'number' && Number.isFinite(value);\nconst neutral = () => ({ move: 0, fire: false, repair: false });\nconst clone = (value) => JSON.parse(JSON.stringify(value));\nconst byteLength = (value) => new TextEncoder().encode(JSON.stringify(value)).length;\n\n/** Preserve every state field; bit masks and repeated object keys are packed. */\nexport function packWorld(value) {\n  if (Array.isArray(value)) {\n    if (value.length >= 32 && value.every((item) => item === 0 || item === 1)) {\n      let hex = '';\n      for (let i = 0; i < value.length; i += 4) {\n        let nibble = 0;\n        for (let j = 0; j < 4; j++) if (value[i + j]) nibble |= 1 << j;\n        hex += nibble.toString(16);\n      }\n      return ['$bits', value.length, hex];\n    }\n    return value.map(packWorld);\n  }\n  if (!value || typeof value !== 'object') return value;\n  const packed = {};\n  for (const [key, child] of Object.entries(value)) {\n    if (key === '__proto__' || key === 'constructor' || key === 'prototype') continue;\n    const compact = KEY_INDEX.get(key) ?? (key.startsWith('~') ? '~' + key : key);\n    packed[compact] = packWorld(child);\n  }\n  return packed;\n}\n\nexport function unpackWorld(value) {\n  if (Array.isArray(value)) {\n    if (value[0] === '$bits' && Number.isInteger(value[1]) && value[1] >= 0 &&\n        value[1] <= 4096 && typeof value[2] === 'string') {\n      const result = [];\n      for (let i = 0; i < value[1]; i++) result.push((parseInt(value[2][i >> 2], 16) >> (i & 3)) & 1);\n      return result;\n    }\n    return value.map(unpackWorld);\n  }\n  if (!value || typeof value !== 'object') return value;\n  const unpacked = {};\n  for (const [key, child] of Object.entries(value)) {\n    const original = KEY_REVERSE.get(key) ?? (key.startsWith('~~') ? key.slice(1) : key);\n    if (original === '__proto__' || original === 'constructor' || original === 'prototype') continue;\n    unpacked[original] = unpackWorld(child);\n  }\n  return unpacked;\n}\n\nfunction cleanCommand(command = {}) {\n  const result = {\n    move: finite(command.move) ? clamp(command.move, -1, 1) : 0,\n    fire: command.fire === true,\n    repair: command.repair === true,\n  };\n  if (finite(command.targetX)) result.targetX = clamp(command.targetX, 18, 462);\n  return result;\n}\n\n/** Connect only through the actual Hub client; null means ordinary standalone. */\nexport async function connectSession(options) {\n  const hub = options.hub ?? globalThis.AIHub;\n  if (!hub?.connect) return null;\n  const info = await hub.connect({ mode: 'shared-world', seats: [1, 2] });\n  if (!info) return null;\n  return createSessionController(info, { ...options, hub });\n}\n\n/** Exported separately for deterministic protocol tests with a fake Hub clock. */\nexport function createSessionController(info, {\n  hub = globalThis.AIHub,\n  createWorld,\n  stepWorld,\n  leaveSeat,\n  onWorld = () => {},\n  onEvents = () => {},\n  onEnd = () => {},\n  onStart = () => {},\n/** Every sound is synthesized. Nothing is decoded, fetched or sampled. */\nexport function createAudio(game) {\n\tconst audio = game.audio;\n\tconst active = new Set();\n\tconst handles = new Set();\n\tlet unlocked = false,\n\t\tcurrent = \"\",\n\t\twanted = null,\n\t\tvoiceUntil = -Infinity,\n\t\tmarch = 0;\n\tconst counts = {\n\t\tevents: 0,\n\t\teffects: 0,\n\t\tbarks: 0,\n\t\tthrottled: 0,\n\t\tmaximumActive: 0,\n\t};\n\tconst last = new Map();\n\tconst now = () => Number(game.real || game.time || 0);\n\n\tfunction track(src, gain, end, context) {\n\t\tconst node = { src, gain, context };\n\t\tactive.add(node);\n\t\tcounts.maximumActive = Math.max(counts.maximumActive, active.size);\n\t\tsrc.onended = () => {\n\t\t\tactive.delete(node);\n\t\t\ttry {\n\t\t\t\tsrc.disconnect();\n\t\t\t\tgain.disconnect();\n\t\t\t} catch (_) {\n\t\t\t\t/* already disconnected */\n\t\t\t}\n\t\t};\n\t\tsrc.stop(end + 0.015);\n\t\treturn node;\n\t}\n\tfunction synth(kind, ctx, bus, time, freq, duration, volume) {\n\t\tconst t = Math.max(ctx.currentTime, Number(time) || 0),\n\t\t\tdur = Math.min(2, Math.max(0.025, Number(duration) || 0.1));\n\t\tconst f = Math.max(35, Math.min(6000, Number(freq) || 440)),\n\t\t\tvol = Math.min(0.4, Math.max(0, Number(volume) || 0));\n\t\tconst osc = ctx.createOscillator(),\n\t\t\tg = ctx.createGain();\n\t\tosc.type =\n\t\t\tkind === \"bass\" ? \"triangle\" : kind === \"reed\" ? \"square\" : \"sine\";\n\t\tosc.frequency.setValueAtTime(f, t);\n\t\tif (kind === \"bass\")\n\t\t\tosc.frequency.exponentialRampToValueAtTime(\n\t\t\t\tMath.max(30, f * 0.65),\n\t\t\t\tt + dur,\n\t\t\t);\n\t\tif (kind === \"pluck\")\n\t\t\tosc.frequency.exponentialRampToValueAtTime(f * 0.985, t + dur);\n\t\tg.gain.setValueAtTime(0, t);\n\t\tg.gain.linearRampToValueAtTime(vol, t + 0.006);\n\t\tg.gain.exponentialRampToValueAtTime(0.00001, t + dur);\n\t\tosc.connect(g);\n\t\tg.connect(bus);\n\t\tosc.start(t);\n\t\ttrack(osc, g, t + dur, ctx);\n\t\tif (kind === \"glass\") {\n\t\t\tconst overtone = ctx.createOscillator(),\n\t\t\t\tog = ctx.createGain();\n\t\t\tovertone.type = \"sine\";\n\t\t\tovertone.frequency.value = f * 2.01;\n\t\t\tog.gain.setValueAtTime(vol * 0.23, t);\n\t\t\tog.gain.exponentialRampToValueAtTime(0.00001, t + dur * 0.55);\n\t\t\tovertone.connect(og);\n\t\t\tog.connect(bus);\n\t\t\tovertone.start(t);\n\t\t\ttrack(overtone, og, t + dur * 0.55, ctx);\n\t\t}\n\t}\n\tfor (const [name, kind] of [\n\t\t[\"orbitPluck\", \"pluck\"],\n\t\t[\"orbitGlass\", \"glass\"],\n\t\t[\"orbitBass\", \"bass\"],\n\t\t[\"orbitReed\", \"reed\"],\n\t]) {\n\t\taudio.instrument(name, (ctx, bus, time, freq, dur, vol) =>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/report.json' <<'EOF'\n{\n  \\\"sourceInformation\\\":{\n    \\\"date\\\":\\\"2026-11-06 02:27:09\\\",\n    \\\"source\\\":\\\"Astro Battle / Space Invaders — Bally Astrocade; the supplied 1979 combined source wording is interpreted this way. The renamed manual bears a 1981 copyright.\\\",\n    \\\"plan\\\":\\\"PLAN.md\\\",\n    \\\"genre\\\":\\\"Shooter / arcade planetary defense\\\",\n    \\\"perspective\\\":\\\"Fixed-screen overhead; screen-aligned horizontal cannon and upward fire.\\\",\n    \\\"tech\\\":\\\"JavaScript ES modules, Canvas2D and Web Audio; my-3D2dge handoff 0.89.1 at 8ecc2f62353761187bdfe226f327b7ea5d2eb691; AI Hub Session Protocol v1 client 1.4.0 at 35a1047f2067b2af3de3943f0fe452f39105d869. Bun bundles development modules; the final HTML is self-contained.\\\",\n    \\\"artDirection\\\":\\\"Original shaded pixel silhouettes, hue-shifted ramps, three planetary outpost palettes, native procedural lighting and a crisp retro-modern cabinet presentation.\\\",\n    \\\"animation\\\":\\\"Native E.anim march poses, cannon recoil/readiness, armor break, bunker debris and repair growth, saucer wobble, flagship emitters and core windows; native engine fixed clocks and tweens.\\\",\n    \\\"audio\\\":\\\"Original runtime oscillator instruments, generated noise, three sparse location themes, flagship music, result stingers, event effects and filtered gibberish voice bus. No audio files. Music defaults to 10%.\\\",\n    \\\"online\\\":\\\"AI Hub host-authoritative shared-world co-op for 1–2 roster seats, reliable complete snapshots and acknowledged action heartbeats. Standalone supports solo and simultaneous local co-op.\\\",\n    \\\"testing\\\":\\\"Headless simulation and native engine draw checks, ordinary-input complete solo/co-op campaigns, browser automation with emulated pads/touch, synthesized audio probes and pinned Hub harness. No performance target. Physical controller feel, human listening, TV distance and real iOS behavior remain unverified.\\\",\n    \\\"research\\\":\\\"Examined archived manual transcription and PDF scan, contemporary Video Games October 1982 comparison, and archive-linked Nice and Games footage at 90/120 seconds plus sequential filmstrip. Exact source sound unknown: no human listening. Sources: ballyalley.com/cart_manuals/html_manuals/astro_battle.htm; ballyalley.com/astrocade_videos/cartridge_videos/cartridge_videos.html. Detailed evidence in research/RESEARCH.md.\\\",\n    \\\"environment\\\":\\\"Codex CLI (headless); Linux / Ubuntu 26.04.1 LTS on WSL2; Node 24.21.0; Python Playwright 1.63.0.\\\",\n    \\\"model\\\":\\\"OpenAI, gpt-6.1-sol, reasoning effort ultra\\\",\n    \\\"usage\\\":\\\"added on import\\\"\n  },\n  \\\"testingFeedback\\\":[\n    \\\"unknown — final acceptance is in progress.\\\",\n    \\\"unknown — final acceptance is in progress.\\\",\n    \\\"Ordinary-input full-campaign simulation tests demonstrate six formations and both flagship phases without invulnerability, wave jumps or altered tuning.\\\",\n    \\\"unknown — final acceptance is in progress.\\\"\n  ],\n  \\\"engineFeedback\\\":[\n    \\\"The readable native sprite, animation, hue-ramp, synthesized-audio and deterministic advance APIs give this small arcade game a coherent foundation.\\\",\n    \\\"The arcade helper is alternating-turn multiplayer, so simultaneous co-op uses an explicit shared simulation. Projectile helpers do endpoint overlap, so this game resolves swept first hits itself.\\\",\n    \\\"The serializable deterministic combat world: shared erodible bunker masks, lane-preserving repair, deployment accounting and host authority.\\\",\n    \\\"Keeping fixed combat bounds, local overlays and device ownership coherent across native rendering, menus and Hub lifecycle.\\\",\n    \\\"None. The full pinned engine remains intact; the application uses its supported custom-menu and autoPause:false options.\\\",\n    \\\"A documented serializable simulation/event adapter for small host-authoritative shared worlds would reduce integration work.\\\"\n  ],\n  \\\"promptFeedback\\\":[\n    \\\"The source-specific spatial decision, finite campaign and explicit acceptance paths made a clear game to build.\\\",\n    \\\"The two similar source names require an explicit interpretation; generic engine defaults also need reconciliation with the fixed-screen and co-op contracts.\\\",\n    \\\"Proving ordinary campaign completion while keeping standalone, local co-op, touch and Hub authority on the same rules.\\\",\n    \\\"Keep required behavior and deliverables separate from suggested file organization so acceptance is faster to audit.\\\"\n  ],\n  \\\"aiHub\\\":{\n    \\\"name\\\":\\\"Orbit Invadettes\\\",\n    \\\"tagline\\\":\\\"Cut a lane. Catch the scrap. Keep your planet.\\\",\n    \\\"description\\\":\\\"Six marching alien formations threaten three planetary outposts. Cut firing lanes through your bunkers, catch salvage to repair them, and bring down an original hostile flagship alone or together.\\\",\n    \\\"type\\\":\\\"Game\\\",\\\"genre\\\":\\\"Shooter\\\",\n    \\\"source\\\":\\\"Astro Battle / Space Invaders — Bally Astrocade\\\",\n    \\\"series\\\":\\\"\\\",\\\"players\\\":\\\"1–2\\\",\n    \\\"controls\\\":\\\"Move: stick/D-pad, A/D/arrows or mouse; fire: R2/Cross, Space/left mouse; repair: L1/Square, Q/right mouse; pause/options: Options/Escape. Touch: relative drag, assisted fire, second-contact lane cutting and contextual repair.\\\",\n    \\\"tags\\\":[\\\"2d\\\",\\\"arcade\\\",\\\"co-op\\\",\\\"pixel art\\\",\\\"sci-fi\\\",\\\"boss fights\\\"]\n  }\n}\nEOF\ncat > 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/src/app.js' <<'EOF'\nimport {createWorld,stepWorld,repairPreview,startEncounter,setTuning,resetTuning,spawnEnemy,spawnSaucer,leaveSeat,clearShot} from './sim.js';\nimport {DIFFICULTIES,TUNING,tuningForDifficulty} from './content.js';\nimport {createAssets} from './assets.js';\nimport {createAudio} from './audio.js';\nimport {createView} from './view.js';\nimport {Interface} from './ui.js';\nimport {connectSession} from './session.js';\nimport REPORT from '../report.json';\n\nconst E=globalThis.My3D2dge;\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst keymap={\n up:['KeyW','ArrowUp','Pad12','PadAxisUp'],down:['KeyS','ArrowDown','Pad13','PadAxisDown'],\n left:['KeyA','ArrowLeft','Pad14','PadAxisLeft'],right:['KeyD','ArrowRight','Pad15','PadAxisRight'],\n fire:['Space','Mouse0','Pad0','Pad7'],repair:['KeyQ','Mouse2','Pad4','Pad2'],\n confirm:['Enter','Space','Pad0'],cancel:['Escape','Backspace','Pad1'],start:['Enter','Pad9'],pause:['Escape','Pad9'],\n halves:{left:{fire:['Space'],repair:['KeyQ'],confirm:['Enter'],start:['Enter'],pause:['Escape'],cancel:['Escape']},right:{fire:['Period','Numpad1'],repair:['Slash','Numpad2'],pause:['Backspace'],start:['Digit2'],confirm:['Enter','NumpadEnter'],cancel:['Backspace']}}\n};\nexport class App{\n constructor(){\n  this.report=REPORT;this.playerCount=1;this.difficulty=1;this.primary='keyboard';this.idle=0;this.speed=1;this.invulnerable=false;this.overlays=false;this.spawnType='ordinary';this.drain=0;this.wakeUntil=0;this.noticeTime=0;this.pointerTarget=null;this.touchContacts=new Map();this.padHistory=new Map();this.padWakeBlocked=false;this.activeRun=false;this.session=null;this.attractAge=0;this.attractSegment=-1;this.recorded=false;this.lobby=false;this.silenced=false;\n  this.game=new E.Game({id:'orbit-invadettes-v1',canvas:'screen',res:[480,270],expand:true,view:'overhead',views:['overhead'],input:keymap,menu:false,corner:false,fullscreen:false,autoPause:false,backGesture:false,bg:'#07141e',draw:true});\n  this.game.cam.smooth=0;this.game.focus(240,135,0);this.game.input.touchEnabled=false;this.game.input.touchButtons([]);\n  const S=this.game.settings;\n  for(const [key,value] of [['music',.1],['glyphs','playstation']])S.define({...S.spec(key),key,value});\n  S.define({key:'touchAssist',label:'Touch auto-fire',group:'Touch',value:true});\n  this.world=createWorld({seed:101});this.titleWorld=createWorld({seed:101});this.world=this.titleWorld;\n  for(const t of TUNING)S.define({key:'dev_'+t.key,label:t.label,group:'Balance',type:'slider',value:t.default,min:t.min,max:t.max,step:t.step,help:t.description,apply:(_g,v)=>{if(this.ui?.screen==='dev'&&\"'!this._syncTuning&&!this.session)setTuning(this.world,t.key,v);}});\n  this.assets=createAssets(E);this.audio=createAudio(this.game);this.view=createView(E,this.game,this.assets);\n  this.records=this.loadRecords();this.ui=new Interface(this,REPORT);this.ui.render();\n  this.bindEvents();\n  this.game.debug={snapshot:()=>({scene:this.ui.screen,world:JSON.parse(JSON.stringify(this.world)),primary:this.primary,session:this.session?.diagnostics(),idle:this.idle,records:this.records.length}),state:()=>this.world};\n  this.game.start({scene:'\"'cabinet',scenes:{cabinet:{pausable:false,camera:{zoom:false},update:dt=>this.update(dt),draw:r=>this.draw(r),back:()=>{if(this.ui.screen\"'!=='\"'play')this.ui.activate('back');else this.openPause();return true;}}}});\n  this.game.fadeTime=0;\n  globalThis.__OI=this;globalThis.__game=this.game;\n }\n async connect(){\n  this.session=await connectSession({\n   createWorld,stepWorld,leaveSeat,\n   onWorld:w=>{this.world=w;this.activeRun=true;this.game.allowJoin(false);},\n   onEvents:events=>this.present(events),\n   onStart:()=>{this.activeRun=true;this.ui.show('play');this.clearInput();},\n   onEnd:({reason,world})=>{if(world)this.world=world;this.silenced=true;this.audio.stop();this.touchContacts.clear();this.ui.show('results');this.notify(reason==='host-left'?'HOST DEPARTED · ROUND VOID':reason==='time-up'?'TIME EXPIRED':'ROUND COMPLETE');}\n  });\n  if(this.session){\n   this.activeRun=true;this.ui.show(this.session.phase==='playing'?'play':'hub-wait');this.idle=0;this.clearInput();\n  }\n }\n loadRecords(){\n  try{\n   const r=JSON.parse(localStorage.getItem('orbit-invadettes-records-v1')||'null');\n   if(r?.version===1&&Array.isArray(r.records))return r.records.filter(x=>x&&Number.isFinite(x.score)&&x.score>=0&&typeof x.mode==='string'&&typeof x.difficulty==='string').slice(0,60);\n  }catch(_){}\n  return [];\n }\n saveRecord(){\n  if(this.recorded||this.session||this.ui.screen==='attract')return;\n  this.recorded=true;const w=this.world;\n  this.records.push({score:w.score,mode:w.players.length>1?'Co-op':'Solo',difficulty:DIFFICULTIES[w.difficulty].name,assisted:\"'!!w.assisted,won:w.status==='\"'victory',time:Math.round(w.time)});\n  this.records.sort((a,b)=>b.score-a.score);this.records=this.records.slice(0,60);\n  try{localStorage.setItem('orbit-invadettes-records-v1',JSON.stringify({version:1,records:this.records}));}catch(_){}\n }\n menuPrompt(){\n  return this.primary==='gamepad'?(this.game.settings.glyphs==='xbox'?'D-pad + A select · B back':'D-pad + Cross select · Circle back'):this.primary==='touch'?'Tap to choose · drag to defend':'Arrows + Enter · mouse to choose';\n }\n clearInput(){\n  for(const I of this.game.players)I.clear();\n  this.pointerTarget=null;this.touchContacts.clear();this.drain=.16;this.repairQueued=false;\n }\n activity(device){\n  this.idle=0;\n  if(device&&['keyboard','gamepad','touch','pointer','mouse'].includes(device)){\n   const newDevice=device==='mouse'?'pointer':device;\n   if(newDevice\"'!==this.primary){this.primary=newDevice;}\n  }\n  if(this.ui?.screen==='\"'attract'){\n   this.wakeUntil=performance.now()+450;this.padWakeBlocked=device==='gamepad';this.toTitle();this.ui.lock=.45;return true;\n  }\n  return false;\n }\n notify(message){\n  this.notice=message;this.noticeTime=2.6;\n  if(typeof document\"'!=='\"'undefined'){const n=document.getElementById('notice');n.textContent=message;n.style.opacity='1';}\n }\n point(e){\n  const rect=this.game.screen.canvas.getBoundingClientRect();\n  return {x:(e.clientX-rect.left)/rect.width*this.game.W-(this.game.W-480)/2,y:(e.clientY-rect.top)/rect.height*this.game.H-(this.game.H-270)/2};\n }\n bindEvents(){\n  if(typeof window==='undefined')return;\n  const c=this.game.screen.canvas;\n  const actual=(e,device)=>{\n   if(\"'!e.isTrusted&&!e.__testReal)return false;\n   const woke=this.activity(device);\n   if(!this.silenced)this.audio.unlock();\n   if(woke){e.preventDefault();e.stopImmediatePropagation();return true;}\n   return false;\n  };\n  window.addEventListener('\"'keydown',e=>{\n   if(actual(e,'keyboard'))return;\n   if(e.code==='Tab'){this.idle=0;return;}\n   if(e.target.tagName==='INPUT')return;\n   if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space','Enter','Escape','Backspace'].includes(e.code))e.preventDefault();\n   if(e.code==='KeyA'||e.code==='KeyD'||e.code==='ArrowLeft'||e.code==='ArrowRight')this.pointerTarget=null;\n  },{capture:true});\n  window.addEventListener('pointerdown',e=>{\n   if(actual(e,e.pointerType==='touch'?'touch':'pointer'))return;\n  },{capture:true});\n  window.addEventListener('pointermove',e=>{\n   if(e.movementX||e.movementY)actual(e,e.pointerType==='touch'?'touch':'pointer');\n  },{capture:true});\n  c.addEventListener('contextmenu',e=>e.preventDefault());\n  c.addEventListener('pointermove',e=>{\n   if(this.ui.screen\"'!=='\"'play'||performance.now()<this.wakeUntil)return;\n   const pt=this.point(e);\n   if(e.pointerType==='touch'){\n    const q=this.touchContacts.get(e.pointerId);if(q){q.x=pt.x;q.y=pt.y;if(q.role==='move')this.pointerTarget=clamp(q.shipX+pt.x-q.startX,18,462);}\n   }else if(pt.x>=16&&pt.x<=464&&pt.y>=30&&pt.y<=258&&(e.movementX||e.movementY))this.pointerTarget=pt.x;\n  });\n  c.addEventListener('pointerdown',e=>{\n   if(this.ui.screen\"'!=='\"'play'||performance.now()<this.wakeUntil)return;\n   const pt=this.point(e);\n   if(e.pointerType==='touch'){\n    e.preventDefault();try{c.setPointerCapture(e.pointerId);}catch(_){}\n    const seat=this.session?.seat??0,ship=this.world.players[seat];\n    const role=this.touchContacts.size===0?'move':'fire';\n    this.touchContacts.set(e.pointerId,{role,startX:pt.x,x:pt.x,y:pt.y,shipX:ship?.x??240});\n   }\n  });\n  const release=e=>{\n   if(e.pointerType==='touch'){const role=this.touchContacts.get(e.pointerId)?.role;this.touchContacts.delete(e.pointerId);if(role==='move')this.pointerTarget=null;try{c.releasePointerCapture(e.pointerId);}catch(_){}}\n  };\n  c.addEventListener('pointerup',release);c.addEventListener('pointercancel',release);c.addEventListener('lostpointercapture',release);\n  const pb=document.getElementById('pause-button'),rb=document.getElementById('repair-button');\n  pb.addEventListener('click',e=>{e.stopPropagation();if(performance.now()>=this.wakeUntil)this.openPause();});\n  rb.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();this.activity(e.pointerType==='touch'?'touch':'pointer');this.repairQueued=true;});\n  window.addEventListener('blur',()=>{this.clearInput();if(\"'!this.session&&this.ui.screen==='\"'play')this.openPause();});\n  document.addEventListener('visibilitychange',()=>{if(document.hidden){this.clearInput();if(\"'!this.session&&this.ui.screen==='\"'play')this.openPause();}});\n  window.addEventListener('resize',()=>{this.touchContacts.clear();this.pointerTarget=null;});\n }\n pollPads(){\n  let pads=[];try{pads=Array.from(navigator.getGamepads?.()||[]);}catch(_){}\n  let neutral=true;\n  for(const p of pads){\n   if(\"'!p||p.connected===false)continue;\n   const vals=[...p.axes,...p.buttons.map(b=>b.value??(b.pressed?1:0))];\n   const old=this.padHistory.get(p.index)||vals.map(()=>0);\n   const significant=vals.some((v,i)=>Math.abs(v)>.26&&Math.abs(v-(old[i]??0))>.16);\n   if(vals.some(v=>Math.abs(v)>.24))neutral=false;\n   if(significant){this.activity('\"'gamepad');if(\"'!this.silenced)this.audio.unlock();}\n   this.padHistory.set(p.index,vals);\n