{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"tail -32 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tests/sim.test.mjs'; head -32 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tests/engine.test.mjs'; rg -n '\"'^(def|async def)|__OI|mute|reduceMotion|sfx|voice|sleep|wait_for_timeout'\"' 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tests/browser.py' | head -65; tail -35 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tests/hub_browser.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"tail -32 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tests/sim.test.mjs'; head -32 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tests/engine.test.mjs'; rg -n '\"'^(def|async def)|__OI|mute|reduceMotion|sfx|voice|sleep|wait_for_timeout'\"' 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tests/browser.py' | head -65; tail -35 'Orbit-Invadettes-Astro-Battle-Space-Invaders-1979-gpt-6.1-sol-ultra-20261106-022709/tests/hub_browser.py'\"","aggregated_output":" test('destroyed-mask holes allow the next missile through',()=>{const w=isolate(createWorld());w.bunkers[0].mask.fill(0);const e=w.enemies[0];e.x=80;e.y=190;w.tuning.playerShotSpeed=400;shot(w,80,235);stepWorld(w,[],.1);assert.equal(w.enemies.length,0);assert.equal(w.status,'transition');});\n test('enemy bombs crater cover and broad bombs remove more cells',()=>{let lost=[];for(const kind of ['bomb','heavy']){const w=isolate(createWorld());const before=maskCount(w.bunkers[0]);shot(w,80,199,-1,kind);stepWorld(w,[],.1);lost.push(before-maskCount(w.bunkers[0]));assert(w.players[0].alive);assert.equal(w.bullets.length,0);}assert(lost[1]>lost[0]);});\n test('stable nearest-bunker tie and fully demolished footprint rebuild',()=>{const w=createWorld();const p=w.players[0];p.x=133;p.charges=1;w.bunkers.forEach(b=>b.mask.fill(0));const preview=repairPreview(w,0);assert.equal(preview.bunker,0);assert(preview.usable);assert(repair(w,0));assert.equal(p.charges,0);assert.equal(maskCount(w.bunkers[0]),w.tuning.repairYield);assert(w.bunkers.every(b=>b.mask.every((v,i)=>!v||b.original[i])));});\n test('repair preserves both active teammate firing apertures',()=>{const w=createWorld({players:2}),b=w.bunkers[1];w.players[0].x=b.center-5;w.players[1].x=b.center+5;w.players[0].charges=1;b.mask.fill(0);assert(repair(w,0));for(const p of w.players){const col=Math.floor((p.x-b.x)/b.cell);for(let row=0;row<b.rows;row++)assert.equal(b.mask[row*b.cols+col],0);}assert(maskCount(b)>0);});\n test('repair leaves missile clearance at a cannon between two cell columns',()=>{const w=createWorld(),b=w.bunkers[1],p=w.players[0];p.x=b.x+5*b.cell;p.charges=1;b.mask.fill(0);assert(repair(w,0));const left=4,right=5;for(let row=0;row<b.rows;row++){assert.equal(b.mask[row*b.cols+left],0);assert.equal(b.mask[row*b.cols+right],0);}});\n test('repair does not spend at intact cover or without charges',()=>{const w=createWorld();w.players[0].charges=2;assert.equal(repair(w,0),false);assert.equal(w.players[0].charges,2);w.bunkers[1].mask.fill(0);w.players[0].x=186;w.players[0].charges=0;assert.equal(repair(w,0),false);assert.equal(maskCount(w.bunkers[1]),0);});\n test('every fourth formation kill guarantees one salvage pickup',()=>{const w=createWorld();w.fireTimer=1000;w.enemies=w.enemies.slice(0,5);for(let k=0;k<4;k++){const e=w.enemies[0];e.x=240;e.y=100;shot(w,240,107);stepWorld(w,[]);}assert.equal(w.killCount,4);assert.equal(w.pickups.length,1);assert.equal(w.pickups[0].reason,'kill');});\n test('salvage passes masks, catcher owns it and capacity stays three',()=>{const w=createWorld({players:2});w.players[0].x=80;w.players[0].charges=2;w.players[1].x=400;w.pickups=[{id:10000,x:80,y:205,life:9,reason:'fixture'}];steps(w,130);assert.equal(w.players[0].charges,3);assert.equal(w.players[1].charges,0);w.pickups=[{id:10001,x:80,y:245,life:9,reason:'fixture'}];stepWorld(w,[]);assert.equal(w.players[0].charges,3);assert.equal(w.pickups.length,0);});\n test('missed salvage expires visibly',()=>{const w=createWorld();w.pickups=[{id:10000,x:80,y:265.9,life:9}];stepWorld(w,[]);assert.equal(w.pickups.length,0);assert(w.events.some(e=>e.type==='pickup-expire'));});\n test('solo deployments include active ship and reserve consumes once per respawn',()=>{const w=createWorld();assert.equal(w.reserve,2);w.players[0].protected=0;assert(killPlayer(w,0));stepWorld(w,[]);assert.equal(w.reserve,1);assert.equal(w.status,'playing');steps(w,150);assert(w.players[0].alive);assert(w.players[0].protected>0);assert.equal(w.reserve,1);assert.equal(w.stats.losses,1);});\n test('simultaneous co-op deaths with one reserve keep a valid pending team alive',()=>{const w=createWorld({players:2});w.reserve=1;w.players.forEach(p=>p.protected=0);killPlayer(w,0);killPlayer(w,1);stepWorld(w,[]);assert.equal(w.reserve,0);assert(w.players[0].respawn>0);assert.equal(w.players[1].respawn,0);assert.equal(w.status,'playing');steps(w,150);assert(w.players[0].alive);assert.equal(w.players[1].alive,false);});\n test('protected respawn cannot be immediately damaged',()=>{const w=createWorld();w.players[0].protected=1;shot(w,240,240,-1);steps(w,2);assert(w.players[0].alive);assert.equal(w.stats.losses,0);});\n test('extra deployment awarded once at source threshold and revives spectator',()=>{const w=createWorld({players:2});w.score=990;w.extraAwarded=false;w.reserve=0;w.players[1].alive=false;w.players[1].respawn=0;const e=w.enemies.at(-1);e.x=240;e.y=100;shot(w,240,107);stepWorld(w,[]);assert.equal(w.score,1000);assert(w.extraAwarded);assert(w.players[1].respawn>0);assert.equal(w.reserve,0);const e2=w.enemies.at(-1);e2.x=240;e2.y=100;shot(w,240,107);stepWorld(w,[]);assert.equal(w.reserve,0);});\n test('depleted deployments defeat distinctly from breach',()=>{const w=createWorld();w.reserve=0;w.players[0].protected=0;killPlayer(w,0);stepWorld(w,[]);assert.equal(w.status,'defeat');assert.equal(w.reason,'DEPLOYMENTS DEPLETED');});\n test('armour first hit peels shell and second hit destroys',()=>{const w=createWorld();startEncounter(w,2);w.fireTimer=1000;const e=w.enemies.find(e=>e.type==='armour');e.x=240;e.y=100;shot(w,240,107);stepWorld(w,[]);assert.equal(e.hp,1);assert(w.enemies.includes(e));assert.equal(w.stats.armourHits,1);shot(w,240,107);stepWorld(w,[]);assert(!w.enemies.includes(e));});\n test('bonus saucer is nonattacking and provides score family and salvage',()=>{const w=createWorld();startEncounter(w,1);spawnSaucer(w);w.saucer.x=240;w.saucer.y=28;const score=w.saucer.value;assert([100,200,300].includes(score));shot(w,240,34);stepWorld(w,[]);assert.equal(w.score,score);assert.equal(w.pickups.length,1);assert.equal(w.saucer,null);});\n test('location-pair cover damage carries and travel restores a partial baseline',()=>{const w=createWorld();w.bunkers.forEach(b=>b.mask.fill(0));w.enemies=[];stepWorld(w,[]);assert.equal(w.status,'transition');steps(w,300);assert.equal(w.encounter,1);assert(w.bunkers.every(b=>maskCount(b)===0));w.enemies=[];stepWorld(w,[]);steps(w,500);assert.equal(w.encounter,2);assert(w.bunkers.every(b=>maskCount(b)>0&&maskCount(b)<b.original.reduce((a,b)=>a+b,0)));assert.equal(w.bullets.filter(b=>b.owner<0).length,0);});\n test('flagship closed armour blocks shots and both phases expose damage windows',()=>{const w=createWorld();startEncounter(w,6);w.boss.emitters[0].open=false;w.boss.phaseTime=3.8;const e=w.boss.emitters[0],hp=e.hp;shot(w,e.x,e.y+10);stepWorld(w,[]);assert.equal(e.hp,hp);assert(w.events.some(e=>e.type==='blocked'));w.boss.emitters.forEach(e=>e.hp=0);stepWorld(w,[]);assert.equal(w.boss.phase,2);assert.equal(w.boss.open,false);w.boss.phaseTime=2;const h=w.boss.hp;shot(w,w.boss.x,w.boss.y+16);stepWorld(w,[]);assert(w.boss.open);assert.equal(w.boss.hp,h-1);});\n test('flagship supplies repair salvage without arriving resources',()=>{const w=createWorld();startEncounter(w,6);steps(w,730);assert(w.pickups.length>0);assert(w.pickups.some(i=>i.reason==='flagship'));});\n test('live tuning validates bounds and applies missile/core changes immediately',()=>{const w=createWorld();assert.equal(setTuning(w,'unknown',3),false);assert.equal(setTuning(w,'playerSpeed',NaN),false);setTuning(w,'playerSpeed',999);assert.equal(w.tuning.playerSpeed,280);assert(w.assisted);startEncounter(w,6);const b=w.boss;b.hp=b.maxHp/2;setTuning(w,'bossHealth',40);assert.equal(b.maxHp,40);assert.equal(b.hp,20);});\n test('departure preserves score/seat and grants no deployment',()=>{const w=createWorld({players:2,ids:['roster-a','roster-b']});w.players[1].score=30;const before=w.reserve;leaveSeat(w,1);stepWorld(w,[]);assert.equal(w.players[1].id,'roster-b');assert.equal(w.players[1].score,30);assert.equal(w.players[1].active,false);assert.equal(w.players[1].alive,false);assert.equal(w.reserve,before);});\n test('swept primitive detects crossings and misses horizontally separate cells',()=>{assert.equal(sweepY(10,100,0,1,9,20,11,30),.69);assert.equal(sweepY(20,100,0,1,9,20,11,30),null);assert.equal(sweepY(10,25,40,1,9,20,11,30),0);});\n test('clear-shot assistance uses the same bunker mask',()=>{const w=createWorld();assert.equal(clearShot(w,80),false);w.bunkers[0].mask.fill(0);assert.equal(clearShot(w,80),true);assert.equal(clearShot(w,240),true);});\n for(const players of [1,2])test(`ordinary-input STANDARD ${players===1?'solo':'co-op'} full six-wave and two-phase campaign`,()=>{\n  const w=createWorld({seed:137,players,difficulty:1});let maxSnapshotBytes=0;\n  for(let i=0;i<120*1200&&['playing','transition'].includes(w.status);i++){stepWorld(w,botCommands(w));if(i%120===0)maxSnapshotBytes=Math.max(maxSnapshotBytes,serialize(w).length);}\n  assert.equal(w.status,'victory',`${w.reason}; reached ${w.encounter}, boss ${w.boss?.phase}/${w.boss?.hp}`);assert.equal(w.assisted,false);assert.equal(w.invulnerable,false);assert.equal(w.stats.encounters.length,7);assert(w.stats.phases.includes(2));assert(w.stats.armourHits>0);assert(w.stats.cellsRepaired>0);assert(w.stats.saucers>0);assert.equal(w.score,w.players.reduce((a,p)=>a+p.score,0));assert(maxSnapshotBytes<16384);assert.deepEqual(w.tuning,tuningForDifficulty(1));\n  campaigns.push({players,seed:137,difficulty:'STANDARD',seconds:Number(w.time.toFixed(2)),result:w.status,score:w.score,losses:w.stats.losses,repairs:w.stats.cellsRepaired,armourHits:w.stats.armourHits,saucers:w.stats.saucers,maxSnapshotBytes,assisted:w.assisted});\n });\n return {passed:results.filter(r=>r.pass).length,failed:results.filter(r=>!r.pass).length,results,campaigns};\n}\nif(process.argv[1]&&import.meta.url===pathToFileURL(process.argv[1]).href){const report=runSimulationTests();for(const r of report.results)if(!r.pass)console.error(`FAIL ${r.name}\\n${r.error}`);console.log(`${report.passed} passed, ${report.failed} failed`);process.exitCode=report.failed?1:0;}\n/** Native engine + actual bundled app, using the supported DOM-free draw stand-in. */\nimport assert from 'node:assert/strict';\nimport vm from 'node:vm';\nimport {readFileSync} from 'node:fs';\nimport {webcrypto} from 'node:crypto';\nimport {pathToFileURL} from 'node:url';\nconst root=new URL('../',import.meta.url);\nconst plain=value=>JSON.parse(JSON.stringify(value));\nfunction virtualAction(action){return {tagName:'BUTTON',dataset:{action},closest:()=>null,classList:{toggle(){}},focus(){}};}\nexport async function runEngineTests(){\n const results=[],logs=[],warnings=[];\n const test=async(name,fn)=>{try{await fn();results.push({name,pass:true});}catch(error){results.push({name,pass:false,error:error.stack||String(error)});}};\n const ctx={\n  console:{log:(...v)=>logs.push(v.join(' ')),warn:(...v)=>warnings.push(v.join(' ')),error:(...v)=>warnings.push(v.join(' '))},\n  navigator:{getGamepads:()=>[]},crypto:webcrypto,performance,setTimeout,clearTimeout,setInterval,clearInterval,TextEncoder,TextDecoder,\n };\n vm.createContext(ctx);\n let app,game;\n await test('native engine and actual shipped classic-script bundle boot headlessly',async()=>{\n  vm.runInContext(readFileSync(new URL('vendor/my-3d2dge.js',root),'utf8'),ctx,{filename:'vendor/my-3d2dge.js'});\n  // Do not transform the bundle here: a stray ESM export must fail just as it does in the exported HTML.\n  vm.runInContext(readFileSync(new URL('game.bundle.js',root),'utf8'),ctx,{filename:'game.bundle.js'});\n  await Promise.resolve();await Promise.resolve();app=ctx.__OI;game=app.game;game.advance(.5);\n  assert(app);assert(game.headless);assert.equal(game.o.draw,true);assert.equal(app.ui.screen,'title');assert.equal(game.sceneName,'cabinet');assert.equal(game.errors.length,0);\n });\n if(!app){return {passed:0,failed:results.length,results,logs,warnings};}\n try{\n  await test('native input confirms launch and starts a clean campaign',()=>{\n   // DOM menu rows are replaced only by focus-target stand-ins. The real Interface.update and native Input route confirm.\n   app.ui.rows=[virtualAction('launch')];game.input.tap('confirm');game.advance(.025);assert.equal(app.ui.screen,'launch');\n   app.ui.rows=[virtualAction('start')];game.advance(.25);game.input.tap('confirm');game.advance(.025);assert.equal(app.ui.screen,'play');assert(app.activeRun);assert.equal(app.world.assisted,false);assert.equal(app.world.players.length,1);assert.equal(app.world.score,0);\n  });\n69:        page.wait_for_function(\"window.__OI && window.__OI.ui && window.__OI.game\")\n70:        page.wait_for_function(\"window.__OI.ui.screen === 'title'\")\n89:        page.evaluate(\"seconds => window.__OI.game.advance(seconds,{draw:true})\", seconds)\n93:        return page.evaluate(\"window.__OI.ui.screen\")\n97:        page.wait_for_function(\"__OI.ui.screen === 'launch'\")\n101:        page.wait_for_function(\"__OI.ui.screen === 'play' && __OI.world && __OI.world.status === 'playing'\")\n114:            self.verify(\"isolated export starts standalone\", page.evaluate(\"!__OI.session\"))\n115:            self.verify(\"initial music is ten percent\", page.evaluate(\"__OI.game.settings.music === .1 && __OI.game.audio.musicVolume === .1\"))\n116:            self.verify(\"no pre-gesture audio context\", page.evaluate(\"!__OI.game.audio.ctx\"))\n123:            page.wait_for_function(\"__OI.ui.screen==='settings'\")\n124:            self.verify(\"settings hit targets exist before draw\", page.evaluate(\"__OI.ui.rows.length >= 8\"))\n128:            changed = page.evaluate(\"__OI.game.settings.music\")\n131:            page.wait_for_function(\"window.__OI && __OI.ui.screen==='title'\")\n132:            self.verify(\"preferences survive reload\", page.evaluate(\"__OI.game.settings.music\") == changed)\n135:            self.verify(\"reset returns music to ten percent\", page.evaluate(\"__OI.game.settings.music === .1 && __OI.game.audio.musicVolume === .1\"))\n136:            self.click(page, \"mute\")\n137:            self.verify(\"mute setting reaches master bus\", page.evaluate(\"__OI.game.audio.muted\"))\n138:            self.click(page, \"mute\")\n141:            self.verify(\"Xbox labels selectable\", page.evaluate(\"__OI.game.settings.glyphs === 'xbox'\"))\n144:            self.verify(\"accessibility settings applied\", page.evaluate(\"__OI.game.settings.motion && __OI.game.settings.flashes===0\"))\n151:            pages = page.evaluate(\"__OI.ui.pages.length\")\n167:            self.verify(\"isolated export engine reports no errors\", page.evaluate(\"__OI.game.errors.length\") == 0)\n178:            page.wait_for_function(\"__OI.ui.screen==='launch'\")\n184:            self.verify(\"keyboard focus reaches launch\", page.evaluate(\"__OI.ui.rows[__OI.ui.focus].dataset.action==='start'\"))\n186:            page.wait_for_function(\"__OI.ui.screen==='play'\")\n188:            self.verify(\"menu confirm does not fire\", page.evaluate(\"__OI.world.stats.shots===0\"))\n189:            self.verify(\"standard solo initial deployments\", page.evaluate(\"__OI.world.players.length===1 && __OI.world.reserve===2 && !__OI.world.assisted\"))\n190:            x = page.evaluate(\"__OI.world.players[0].x\")\n194:            self.verify(\"keyboard horizontal motion\", page.evaluate(\"__OI.world.players[0].x\") > x + 15)\n198:            self.verify(\"held fire uses repeat and two-shot cap\", page.evaluate(\"__OI.world.stats.shots>=1 && __OI.world.bullets.filter(b=>b.owner===0).length<=2\"))\n200:            old_tick = page.evaluate(\"__OI.world.tick\")\n202:            page.wait_for_function(\"__OI.ui.screen==='pause'\")\n204:            self.verify(\"local pause freezes combat\", page.evaluate(\"__OI.world.tick\") <= old_tick + 5)\n211:            self.verify(\"resume continues world\", page.evaluate(\"__OI.world.tick\") > old_tick + 5)\n214:            before = page.evaluate(\"__OI.world.players[0].x\")\n216:            after = page.evaluate(\"__OI.world.players[0].x\")\n221:            x = page.evaluate(\"__OI.world.players[0].x\")\n223:            self.verify(\"keyboard cancels passive pointer target\", abs(page.evaluate(\"__OI.world.players[0].x\") - x) < 2)\n226:            page.wait_for_function(\"__OI.ui.screen==='results'\")\n227:            self.verify(\"ordinary loss reaches results\", page.evaluate(\"__OI.world.status==='defeat' && !__OI.world.assisted\"))\n230:            page.wait_for_function(\"__OI.ui.screen==='play'\")\n231:            self.verify(\"replay fully resets run ownership\", page.evaluate(\"__OI.world.score===0 && __OI.world.encounter===0 && __OI.world.reserve===2 && !__OI.world.assisted && !__OI.invulnerable &&  [... omitted end of long line]\n232:            self.verify(\"native play engine errors absent\", page.evaluate(\"__OI.game.errors.length===0\"))\n242:            page.wait_for_function(\"__OI.game.audio.ready\", timeout=10000)\n245:              for(const bus of ['music','sfx','voice']) for(const muted of [false,true]) out.push(await __OI.audio.renderProbe(window.OfflineAudioContext||window.webkitOfflineAudioContext,{bus,muted}) [... omitted end of long line]\n249:            self.verify(\"all unmuted buses produce nonzero signal\", all(p[\"rms\"] > .00001 and p[\"peak\"] < 1 for p in probes if not p[\"muted\"]), json.dumps(probes))\n250:            self.verify(\"all muted probes are silent\", all(p[\"rms\"] == 0 and p[\"peak\"] == 0 for p in probes if p[\"muted\"]))\n252:              const a=__OI.game.audio, node=a.ctx.createAnalyser();node.fftSize=1024;a._master.connect(node);\n253:              __OI.audio.effect('repair');\n256:              a.mute(true);__OI.audio.effect('repair');await new Promise(r=>setTimeout(r,150));node.getFloatTimeDomainData(d);let muted=0;for(const x of d)muted=Math.max(muted,Math.abs(x));a.mute(fals [... omitted end of long line]\n257:              return {peak,muted,music:a.musicVolume};\n260:            self.verify(\"real master mute is silent\", master[\"muted\"] < .00001, str(master))\n261:            page.evaluate(\"__OI.audio.stop()\")\n262:            self.verify(\"audio stop clears authored voices\", page.evaluate(\"__OI.audio.diagnostics().active===0\"))\n272:            device = page.evaluate(\"__OI.primary\")\n275:            self.verify(\"stick drift keeps current glyph family\", page.evaluate(\"__OI.primary\") == device)\n283:            self.verify(\"two-pad roster locks to two ships\", page.evaluate(\"__OI.world.players.length===2 && __OI.world.reserve===4\"))\n284:            old = page.evaluate(\"__OI.world.players.map(p=>p.x)\")\n287:            new = page.evaluate(\"__OI.world.players.map(p=>p.x)\")\n291:            self.verify(\"both pads fire independently\", page.evaluate(\"__OI.world.bullets.some(b=>b.owner===0) && __OI.world.bullets.some(b=>b.owner===1)\"))\n294:            self.verify(\"pad removal preserves roster identity\", page.evaluate(\"__OI.world.players.length===2 && __OI.world.players[1].id==='p2'\"))\n297:            old = page.evaluate(\"__OI.world.players[1].x\")\n300:            self.verify(\"returning pad reclaims prior seat\", page.evaluate(\"__OI.world.players[1].x\") < old - 10 and page.evaluate(\"__OI.world.players.length===2\"))\n302:            self.verify(\"gamepad activity selects controller prompts\", page.evaluate(\"__OI.primary==='gamepad'\"))\n311:            before = page.evaluate(\"JSON.stringify(__OI.records)\")\n\n\ndef main():\n    artifact = ROOT / CONFIG[\"html\"]\n    if not artifact.is_file():\n        print(\"FAIL Hub: final HTML is missing: \" + str(artifact))\n        print(\"0 Hub checks, 1 failure\")\n        return 1\n    handler = functools.partial(QuietHandler, directory=str(ROOT))\n    server = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    server_thread = threading.Thread(target=server.serve_forever, daemon=True)\n    server_thread.start()\n    base_url = \"http://127.0.0.1:\" + str(server.server_address[1])\n    try:\n        with urllib.request.urlopen(base_url + \"/\" + urllib.parse.quote(CONFIG[\"html\"])) as response:\n            body = response.read().decode()\n        assert \"Orbit Invadettes\" in body, \"served page is not this game\"\n        with sync_playwright() as playwright:\n            browser = playwright.chromium.launch(headless=True)\n            try:\n                checks, failures = run_hub_checks(browser, base_url)\n            finally:\n                browser.close()\n    finally:\n        server.shutdown()\n        server.server_close()\n        server_thread.join(timeout=2)\n    for failure in failures:\n        print(\"FAIL \" + failure)\n    print(f\"{checks} Hub checks, {len(failures)} failures\")\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path(json.loads(Path('build-config.json').read_text())['folder'])\nf=p/'src/ui.js';s=f.read_text().replace(\\\"if(dom&&this.rows[this.focus])this.rows[this.focus].focus({preventScroll:true});\\\", \\\"if(dom&&this.rows[this.focus]){this.rows[this.focus].focus({preventScroll:true});this.rows[this.focus].scrollIntoView?.({block:'nearest',inline:'nearest',behavior:'instant'});}\\\")\nf.write_text(s)\nf=p/'src/view.js';s=f.read_text().replace(\\\"if(body)r.sprite(b.x,b.y,0,b.phase===2&&b.open?assets.flagshipOpen:body,{anchor:'center',t:b.age,scale:2,glow:.25});\\\", \\\"\\\"\\\"if(body){\n      r.actor(b.x,b.y-1,0,(g,x,y)=>{\n        px.poly(g,[[x-74,y-3],[x-54,y-14],[x-25,y-17],[x+25,y-17],[x+54,y-14],[x+74,y-3],[x+60,y+11],[x-60,y+11]],'#4a3e5d');\n        px.poly(g,[[x-69,y-4],[x-52,y-11],[x+52,y-11],[x+69,y-4],[x+55,y+4],[x-55,y+4]],'#91768e');\n        px.line(g,x-51,y-12,x+51,y-12,'#eeb3a1',2);\n        px.line(g,x-67,y+2,x-30,y+2,'#c6979a');px.line(g,x+30,y+2,x+67,y+2,'#c6979a');\n      });\n      r.sprite(b.x,b.y,0,b.phase===2&&b.open?assets.flagshipOpen:body,{anchor:'center',t:b.age,glow:.25});\n    }\\\"\\\"\\\")\nf.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
