{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path(json.loads(Path('build-config.json').read_text())['folder'])\nf=p/'src/app.js';s=f.read_text().replace(\\\"onEnd:({reason,world})=>{if(world)this.world=world;\\\", \\\"onEnd:({reason,world})=>{this.sessionEndReason=reason;if(world)this.world=world;\\\")\nf.write_text(s)\nf=p/'src/ui.js';s=f.read_text().replace(\\\"const won=w.status==='victory';\\\", \\\"const won=w.status==='victory',interrupted=hub&&\"'!['\"'victory','defeat'].includes(w.status);\\\\n      const interruptedText=a.sessionEndReason==='host-left'?'The host departed. This round is void.':a.sessionEndReason==='sat-out'?'This seat is sitting out the round.':'AI Hub closed this round before a team outcome.';\\\")\ns=s.replace(\\\"html=this.frame(won?'PLANET KEPT.':'DEFENSE LOST.',won?'The Invadettes have somewhere else to be.':\\\", \\\"html=this.frame(interrupted?(a.sessionEndReason==='host-left'?'ROUND VOID.':'ROUND CLOSED.'):(won?'PLANET KEPT.':'DEFENSE LOST.'),interrupted?interruptedText:won?'The Invadettes have somewhere else to be.':\\\")\ns=s.replace(\\\"\"'${won?'\"'Six formations and the flagship cleared.':'Wave '+Math.min(6,w.encounter+1)+' reached.'}\\\", \\\"\"'${interrupted?'\"'No completed team outcome.':won?'Six formations and the flagship cleared.':'Wave '+Math.min(6,w.encounter+1)+' reached.'}\\\")\nf.write_text(s)\nf=p/'evidence/ISSUES.md';s=f.read_text().replace('Total: 23 unique issues', '24. **Moderate / fixed** — A void or interrupted Hub round used a depleted-deployments result caption after its temporary end notice expired. Caught by: Hub lifecycle UI audit; fixed persistent round-void/closed captions using the actual end reason.\\\\n\\\\nTotal: 24 unique issues');f.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
