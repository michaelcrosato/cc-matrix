{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pathlib,json,urllib.request,concurrent.futures\np=pathlib.Path(json.loads(pathlib.Path('build-config.json').read_text())['folder'])/'vendor'; base='https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/8ecc2f62353761187bdfe226f327b7ea5d2eb691/'\nfiles={'my-3d2dge.js':'dist/handoff/my-3d2dge.js','API.md':'dist/handoff/API.md','API-INDEX.md':'dist/handoff/API-INDEX.md','AI_GUIDE.md':'dist/handoff/AI_GUIDE.md','arcade.js':'dist/handoff/kits/arcade.js','headless-test.mjs':'dist/handoff/game/test.mjs','ASSETS.md':'dist/handoff/docs/ASSETS.md','LICENSE':'LICENSE'}\ndef dl(x):\n k,u=x\n try:\n  d=urllib.request.urlopen(base+u).read();(p/k).write_bytes(d);return k,len(d)\n except Exception as e:return k,str(e)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=5) as e:\n for x in e.map(dl,files.items()):print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
