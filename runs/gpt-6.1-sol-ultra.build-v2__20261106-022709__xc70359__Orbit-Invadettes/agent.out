{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path(json.loads(Path('build-config.json').read_text())['folder'])\nf=p/'src/app.js';s=f.read_text().replace('this.recorded=false;this.lobby=false;', 'this.recorded=false;this.resultDelay=null;this.lobby=false;')\ns=s.replace('this.activeRun=true;this.recorded=false;this.titleWorld=null;', 'this.activeRun=true;this.recorded=false;this.resultDelay=null;this.titleWorld=null;')\ns=s.replace('this.pollPads();this.game.focus', 'if(\"'!this.session?.server)this.pollPads();this.game.focus'\"')\ns=s.replace(\\\"const commands=this.drain>0||\"'!playing?[]:\", \"const commands=this.session?.server||this.drain>0||!playing?[]:\")\ns=s.replace(\"this.saveRecord();this.ui.show('\"'results');\\\", \\\"if(this.world.status==='victory'){if(this.resultDelay===null)this.resultDelay=2.4;else this.resultDelay-=dt;}\\\\n   if(this.world.status==='defeat'||this.resultDelay<=0){this.saveRecord();this.ui.show('results');}\\\")\nf.write_text(s)\nf=p/'src/view.js';s=f.read_text().replace('let fx=[];', 'let fx=[],celebration=0,celebrationBeat=0;')\ns=s.replace(\\\"if(['kill','armour','loss','repair','erode','pickup','victory','extra'].includes(e.type))\\\", \\\"if(e.type==='victory'){celebration=3;celebrationBeat=0;}\\\\n      if(['kill','armour','loss','repair','erode','pickup','victory','extra','boss-hit','boss-phase','emitter-break','saucer-hit','pickup-expire'].includes(e.type))\\\")\ns=s.replace(\\\"const count=e.type==='loss'?20:\\\", \\\"const count=e.type==='victory'?80:e.type==='emitter-break'?28:e.type==='boss-phase'?24:e.type==='boss-hit'?7:e.type==='saucer-hit'?20:e.type==='pickup-expire'?6:e.type==='loss'?20:\\\")\ns=s.replace(\\\"function update(dt){\\\", \\\"function update(dt){\\\\n    if(celebration>0){celebration-=dt;celebrationBeat-=dt;if(celebrationBeat<=0){celebrationBeat=.24;const x=70+rand()*340,y=65+rand()*115;for(let i=0;i<18;i++){const a=i*Math.PI/9;fx.push({x,y,vx:Math.cos(a)*38,vy:Math.sin(a)*38,life:.7,max:.7,type:'pickup',c:i%3});}}}\\\")\ns=s.replace(\\\"if(w.boss)drawBoss(r,w,p);\\\", \\\"if(w.boss&&w.status\"'!=='\"'victory')drawBoss(r,w,p);\\\")\ns=s.replace(\\\"for(const q of w.pickups){\\\\n      r.sprite\\\", \\\"for(const q of w.pickups){\\\\n      if(q.life<2&&game.settings.flashes>0&&Math.floor(w.time*6)%2===0)continue;\\\\n      r.sprite\\\")\ns=s.replace(\\\"r.actor(q.x,q.y,0,(g,x,y)=>{px.dot(g,x-7,y-5,'#e4ffd2');px.dot(g,x+6,y+4,'#7dc6b3');}\\\", \\\"r.actor(q.x,q.y,0,(g,x,y)=>{px.dot(g,x-7,y-5,'#e4ffd2');px.dot(g,x+6,y+4,'#7dc6b3');if(q.life<2){px.rect(g,x-7,y+8,14,2,'#30505a');px.rect(g,x-7,y+8,14*Math.max(0,q.life/2),2,'#c8edbe');}}\\\")\ns=s.replace(\\\"const [ox,oy]=r.w(0,0,0);\\\\n      px.rect(g,ox+13\\\", \\\"const [ox,oy]=r.w(0,0,0);\\\\n      if(w.status==='victory'){planet(g,ox+240,oy+126,66,p,game.real);text(g,'PLANET KEPT\"'!'\"',ox+240,oy+198,'#e6ffd0',{align:'center',scale:3});text(g,'ALL OUTPOSTS REPORT: STILL HERE.',ox+240,oy+225,'#b4f5cf',{align:'center'});}\\\\n      px.rect(g,ox+13\\\")\ns=s.replace('reset(){fx=[];}', 'reset(){fx=[];celebration=0;celebrationBeat=0;}')\nf.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
