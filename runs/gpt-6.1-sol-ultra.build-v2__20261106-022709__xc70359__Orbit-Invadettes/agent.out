{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport pathlib,json,urllib.request,concurrent.futures\np=pathlib.Path(json.loads(pathlib.Path('build-config.json').read_text())['folder'])/'vendor'\nurls={'engine-README.md':'https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/8ecc2f62353761187bdfe226f327b7ea5d2eb691/dist/handoff/README.md','hub-README.md':'https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/lib/hub/README.md','session.js':'https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/lib/hub/session.js','arena.html':'https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/lib/hub/examples/arena.html','harness.html':'https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/lib/hub/harness.html','bridge.js':'https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/lib/hub/bridge.js','round.js':'https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/lib/hub/round.js'}\ndef dl(x):\n k,u=x; data=urllib.request.urlopen(u).read(); (p/k).write_bytes(data); return k,len(data)\nwith concurrent.futures.ThreadPoolExecutor(max_workers=5) as e:\n for x in e.map(dl,urls.items()): print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
