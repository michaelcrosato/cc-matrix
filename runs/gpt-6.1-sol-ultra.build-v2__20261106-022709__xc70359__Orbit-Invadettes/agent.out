equired report groups rendered\",\n                all(\n                    token in all_text.lower()\n                    for token in [\n                        \"usage\",\n                        \"added on import\",\n                        \"testing\",\n                        \"engine\",\n                        \"prompt\",\n                        \"gpt-6.1-sol\",\n                    ]\n                ),\n            )\n            self.click(page, \"back\")\n            self.click(page, \"records\")\n            self.verify(\n                \"empty records screen controllable\",\n                page.locator('[data-action=\"back\"]').is_visible(),\n            )\n            self.click(page, \"back\")\n            self.verify(\n                \"isolated export engine reports no errors\",\n\t\t\tformant.Q.value = 2.8;\n\t\t\tgain.gain.setValueAtTime(0, t);\n\t\t\tgain.gain.linearRampToValueAtTime(0.095, t + 0.006);\n\t\t\tgain.gain.exponentialRampToValueAtTime(0.00001, end);\n\t\t\tosc.connect(formant);\n\t\t\tformant.connect(gain);\n\t\t\tgain.connect(bus);\n\t\t\tosc.start(t);\n\t\t\ttrack(osc, gain, end, ctx);\n\t\t\tosc.addEventListener(\n\t\t\t\t\"ended\",\n\t\t\t\t() => {\n\t\t\t\t\ttry {\n\t\t\t\t\t\tformant.disconnect();\n\t\t\t\t\t} catch (_) {\n\t\t\t\t\t\t/* closed */\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t\t{ once: true },\n\t\t\t);\n\t\t});\n\t\tvoiceUntil = now() + 3.5;\n\t\tcounts.barks++;\n\t}\n\tfunction location(world) {\n\t\twanted = world;\n\t\tif (!world || !unlocked) return;\n\t\tconst state = world.status;\n\t\tlet key;\n\t\tif (state === \"victory\" || state === \"defeat\") key = state;\n\t\telse\n\t\t\tkey =\n\t\t\t\tworld.encounter === 6 || world.boss\n\t\t\t\t\t? \"boss\"\n\t\t\t\t\t: \"location\" + Math.min(2, Math.max(0, Number(world.location) || 0));\n\t\tif (key === current) return;\n\t\tcurrent = key;\n\t\tif (key === \"victory\" || key === \"defeat\") {\n\t\t\taudio.music(key === \"victory\" ? victory : defeat, {\n\t\t\t\tsync: 