;\n    for (const a of actions) {\n      const b = this._touchBtns[a] = document.createElement('button'); b.dataset.act = a; b.setAttribute('aria-label', a);\n      b.style.cssText = 'width:' + size + 'px;height:' + size + 'px;border-radius:50%;border:2px solid rgba(255,255,255,.45);background:rgba(20,16,40,.55);color:#fff;font:600 ' + Math.round(size / 5) + 'px system-ui,sans-serif;touch-action:none;user-select:none;-webkit-user-select:none;overflow:hidden;padding:0';\n      this._touchLook(b, a); box.appendChild(b);\n    }\n    if (getComputedStyle(host).position === 'static') host.style.position = 'relative';\n    host.appendChild(box); this.bindButtons(box); this._touchEl = box;\n    if (!this._cornerMenu) {   // START: the corner's menu button is it; without the corner, a button of its own in the same place\n      const st = this._startEl = document.createElement('div'), b = document.createElement('button'); st.dataset.sys = 'touch';\n      st.style.cssText = 'position:fixed;top:calc(8px + env(safe-area-inset-top,0px));right:calc(8px + env(safe-area-inset-right,0px));z-index:4;touch-action:none;opacity:' + clamp(+S.touchOpacity || .8, .2, 1);\n      b.dataset.act = 'menu'; b.textContent = 'START'; b.setAttribute('aria-label', 'Start or menu');\n      b.style.cssText = 'min-width:44px;height:44px;padding:0 10px;border-radius:10px;border:1px solid rgba(255,255,255,.4);background:rgba(20,16,40,.55);color:#fff;font:600 11px system-ui,sans-serif;touch-action:none';\n      st.appendChild(b); document.body.appendChild(st); this.bindButtons(st);\n    }\n    return box;\n  }\n  /** press a key or button code ('KeyJ', 'Mouse0', 'Pad0', 'Act:attack') as if the person did: scripted input,\n   *  tests, bots */\n  press(code) {\n    if (this.held.has(code) || (code === 'Pad9' && this.held.has('Pad8'))) return;   // (Create + Options is the host's: the AI Hub opens its bar on it, so Options while Create is held is no press)\n    this.held.add(code); this._freshCodes.add(code);\n    };\n    if (this.game.pause('menu')) sh._ownPause = true;\n    page(); return true;\n  }\n}\n/** game.saves: the save slots (section 10k), made when first read */\nObject.defineProperty(Game.prototype, 'saves', { configurable: true, get() { return this._saves || (this._saves = new Saves(this, this.o.menu && this.o.menu.saves)); } });\nE.Saves = Saves;\nHOOKS.step.push((game, dt) => { const s = game._saves, sc = game.scene; if (s && sc && (sc.pausable || game.sceneName === 'main')) s.played += dt; });   // time played: the game's scenes, not its titles\nHOOKS.pause = (sh, acts) => {   // the pause menu's Save and Load, with menu: { saves }\n  const g = sh._game; if (!(g.o.menu && g.o.menu.saves)) return;\n  if (g.saves.canSave) acts.push(['Save', () => g.saves.show('save')]);\n  acts.push(['Load', () => g.saves.show('load')]);\n};\n\n/* =============================================================================\n * 10l. MORE INPUT  input.value(a) (how far an action is pressed: a trigger's travel, a stick's push), game.hook (a\n *    game's own function on the engine's clock), and the notice a game made with touch: 'never' shows on a phone. In a\n *    section of its own: a kit whose game calls none of them leaves it out\n * ============================================================================= */\n/** how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's\n *  direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1 */\nInput.prototype.value = function (a) {\n  const m = this.map[a]; if (!m) { this._check(a); return 0; } if (this._suppressed.has(a)) return 0;\n  const PV = this.padValues || [], mv = this.padMove || [0, 0], st = this.stickOn ? this.stick : [0, 0], push = { up: [1, -1], down: [1, 1], left: [0, -1], right: [0, 1] };\n  let v = 0;\n  for (const c of m) {\n    const k = /^Pad(\\d+)$/.exec(c), ax = /^Pad(R?)Axis(Up|Down|Left|Right)$/.exec(c), pv = k ? PV[+k[1]] || 0 : 0;\n    if (k) v = Math.max(v, pv);\n    if (ax) { const [i, s] = push[ax[2].toLowerCase()], q = ax[1] ? this.padAim || [0, 0] : mv; v = Math.max(v, clamp(q[i] * s, 0, 1)); }\n    else if (this.held.has(c)) v = Math.max(v, k && pv > 0 ? pv : 1);\n  }\n  if (push[a]) { const [i, s] = push[a]; v = Math.max(v, clamp(st[i] * s, 0, 1)); }\n  return v;\n};\n/** a function of the game's own on the engine's clock: kind 'input' fn(dt) every step, paused or not, after the input\n *  is read (a host's guard, an idle timer); 'step' fn(dt) every update step in play, before the scene's update (an\n *  attract mode's watcher); 'enter' fn(name, data) as a scene starts. Returns a function that removes it */\nGame.prototype.hook = function (kind, fn) {\n  const L = (this._own || (this._own = { input: [], step: [], enter: [] }))[kind];\n  if (!L) throw new Error('game.hook(\"' + kind + '\"): the hooks are input, step and enter');\n  L.push(fn); return () => { const i = L.indexOf(fn); if (i >= 0) L.splice(i, 1); };\n};\n/** touch: 'never' on a device with touch alone: \"Controller or keyboard required\", with Settings, until a controller\n *  is connected or a key pressed */\nGame.prototype._needSync = function () {\n  const fine = window.matchMedia && matchMedia('(any-pointer: fine)').matches, coarse = window.matchMedia && matchMedia('(pointer: coarse)').matches;\n  const need = coarse && !fine && !this._keyed && this.input.padIndex === null, el = this._needEl;\n  if (!need) { if (el) el.style.display = 'none'; return; }\n  if (!el) {\n    const d = this._needEl = document.createElement('div'); d.setAttribute('data-sys', 'need'); d.setAttribute('role', 'alert');\n    d.style.cssText = 'position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;background:rgba(5,3,12,.88);color:#f4f0ff;font:600 17px/1.45 system-ui,sans-serif';\n    d.innerHTML = '<div><div style=\"font-size:21px;margin-bottom:8px\">Controller or keyboard required</div><div style=\"opacity:.8;margin-bottom:18px\">This game plays with a controller or a keyboard. Connect one, then press any button.</div><button type=\"button\" style=\"font:inherit;padding:10px 22px;border-radius:10px;border:2px solid #b8a8ff;background:#2a2050;color:#fff;min-width:44px;min-height:44px\">Settings</button></div>';\n    d.querySelector('button').onclick = () => this.menu('settings');\n    (this.screen.canvas.parentElement || document.body).appendChild(d);\n  }\n  this._needEl.style.display = this.shell && this.shell.screen ? 'none' : 'flex';   // (Settings open over it: hidden while it is)\n};\n/* =============================================================================\n * 11. HUMANOID RIG\n *    Local frame: f = forward, r = right, z = up. The rig poses itself every step\n *    from movement, attacks and state, then projects through any view.\n *    Attack specs (angles relative to facing, + = toward the right hand):\n *      { a0, a1, z0, z1, reach, blade, spin }   e.g. horizontal slash a0: 1.7 -> a1: -1.9\n","exit_code":0,"status":"completed"}}
