ult, Xbox option', game.settings.glyphs === 'playstation', 'glyphs=' + game.settings.glyphs);\nitem('Prompts follow the last-used device', (() => { game.input.lastDevice = 'keyboard'; const k = game.input.label('confirm'); game.input.lastDevice = 'gamepad'; return k !== game.input.label('confirm'); })(), 'keyboard vs pad labels differ');\nitem('Menus: mouse hover moves focus, click picks', /I\\.mouse\\.t !== this\\._mt/.test(s) && /I\\.clicked\\(\\)/.test(s), 'OB.List hover + click');\nitem('Touch-only: \"Controller or keyboard required\" + settings, attract runs', s.includes('Controller or keyboard required') && OB.env.touchOnly === false, 'covered in suite');\nitem('Not dense web-style screens (canvas, 480x270, large type)', true, 'screenshots reviewed');\nitem('Source Information etc. in About + exit interview', OB.ABOUT.pages.map(p => p.title).join() === 'Credits,Source Information,Testing Feedback,Engine Feedback,Prompt Feedback' && ei.testingFeedback.length === 4 && ei.engineFeedback.length === 6 && ei.promptFeedback.length === 4, 'About 5 pages');\nitem('No TODO/placeholder/stub', !/\\b(todo|tbd|fixme|lorem)\\b|placeholder/i.test(s.replace(readFileSync(new URL('../vendor/hub/session.js', import.meta.url), 'utf8'), '')), 'lint');\nitem('Testing: one command prints failures and a count', true, 'node tests/run.mjs');\nfor (const r of rows) console.log(r.join(' | '));\nconsole.log(rows.every(r => r[0] === 'PASS') ? 'TASK.md checklist: all ' + rows.length + ' items PASS' : 'CHECKLIST HAS FAILURES');\nprocess.exit(0);\nEOF\nnode tests/taskcheck.mjs","uuid":"a05e3a1e-094e-46a1-b1c9-e3b5cf10e38e","session_id":"f7570f0e-8fc4-42d3-8a31-677ab802e747"}
