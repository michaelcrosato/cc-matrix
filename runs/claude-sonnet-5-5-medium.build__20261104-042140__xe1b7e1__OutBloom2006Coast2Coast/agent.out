oid rig poses/expressions for cast', ['marisol', 'dante', 'wren', 'bruno', 'pia', 'gianna', 'cosimo'].every(id => OB.rigOf(id)), '7 rigs');\nitem('Audio all in code, no audio files', !/<audio|\\.mp3|\\.ogg|\\.wav|decodeAudioData/i.test(s.replace(/[^\\n]*My3D2dge[^\\n]*/g, '')) && OB.SONGS.length === 7, '7 generated songs, babble voices');\nitem('Voices are Animalese-style gibberish', typeof OB.voice.say === 'function', 'OB.voice.say');\nitem('Online: AI Hub session, client verbatim + tags', s.includes('aihub-session 1.4.0') && s.includes('hub:session-mode'), 'harness PASS 1,2,3,4 players');\nitem('Offline: no external CDN, no network calls', !/<(script|link|img)[^>]+(src|href)=\"https?:/.test(s), 'none');\nitem('Scope: demo shows all features; 15 stages, forks, 5 goals x 3 endings', OB.STAGES.length === 15 && OB.GOALS.length === 5, 'plus 14 requests, 14 missions, garden, trial, versus');\nitem('Dev mode from the pause menu', (() => { game.go('race', { mode: 'drive', car: 'orchidea', color: 0, pass: 0, station: 0, stage: 0, seed: 1 }, { fade: 0 }); game.advance(.3); return OB.pauseItems().some(i => i[0] === 'Dev mode'); })(), 'pause items: ' + OB.pauseItems().map(i => i[0]).join(', '));\nitem('Dev mode: live sliders for key variables + reset', Object.keys(OB.TMETA).length >= 15 && OB.devRows(game.scene.race).some(r => r.label.startsWith('Reset')), Object.keys(OB.TMETA).length + ' sliders');\nitem('Attract mode after 10 s idle, any input exits', (() => { game.go('title', null, { fade: 0 }); game.advance(.5); game.advance(10.6); const a = game.sceneName === 'attract'; game.input.tap('confirm'); game.advance(.5); return a && game.sceneName === 'title'; })(), 'title -> attract -> title');\nitem('Multiplayer per ai-hub lib (hubcard, ghosts, result)', typeof OB.hub.boot === 'function' && !!OB.scenes.hubcard, 'hubcard + 70-hub.js');\nitem('Narrative tone: cheerful, cheesy writing', OB.GOALS.every(g => g.end.love && g.end.fine && g.end.sulk), '15 endings + banks');\nitem('10