1, 4], card: true });\n  if (!info) { H.active = false; return false; }\n  H.info = info;\n  Hub.on('card', c => { H.card = c; });\n  Hub.on('start', e => { H.started = true; H.locked = false; H.sendT = 0; H.t0 = Date.now(); });\n  Hub.on('message', (data, from) => {\n    if (!data || typeof data !== 'object') return;\n    if (data.t === 'g') { let g = ghosts.get(from); if (!g) { const idx = (Hub.players || []).findIndex(p => p.id === from); g = { area: data.area, z: data.z, x: data.x, tz: data.z, tx: data.x, p: 0, prog: 0, car: OB.ghostCar(SEAT[(idx < 0 ? ghosts.size + 1 : idx) % 4], ((Hub.players || []).find(p => p.id === from) || {}).name ? String(((Hub.players || []).find(p => p.id === from)).name).slice(0, 8).toUpperCase().replace(/[^A-Z0-9 ]/g, '?') : 'P') }; ghosts.set(from, g); } if (g.area !== data.area) { g.z = data.z; g.x = data.x; } g.area = data.area; g.tz = data.z; g.tx = data.x; g.p = clamp01(((data.area === 0 ? 0 : data.area === 1 ? 1 : 2) + data.z / 180000) / 3); }\n  });\n  Hub.on('leave', ({ id }) => { ghosts.delete(id); });\n  Hub.on('time-up', () => { const R = H.race; if (R && R.mode === 'hub' && !H.finishedSent) { H.finishedSent = true; Hub.result({ score: Math.round((R.route.length - 1) * 180000 + R.z) }); } });\n  Hub.on('end', () => { H.ended = true; H.frozen = true; OB.stopMusic(); try { game.audio.mute && !game.audio.muted && game.audio.mute(); } catch (e) { /* audio gone */ } });\n  Hub.probe(() => ({ scene: game.sceneName, world: H.race ? H.race.snapshot() : null, menu: null, input: game.input.lastDevice }));\n  Hub.ready();\n  return true;\n};\n})();\nEOF\necho ok"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7398,"cache_read_input_tokens":204676,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7398},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"inpu