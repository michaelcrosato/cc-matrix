{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d363","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":2060,"recorded_at":1780531400004115,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"{\n  \"chunk_id\": \"exec-25-1\",\n  \"command\": \"cd \\\"WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235\\\"\\ncat > tests/probe.mjs << 'EOF'\\nimport { spawn } from 'node:child_process';\\nimport { join, dirname } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nconst root = join(dirname(fileURLToPath(import.meta.url)), '..');\\nconst srv = spawn('python3', ['-u','-m','http.server','0','--bind','127.0.0.1'], { cwd: join(root,'tests/hub') });\\nlet port=0;\\nawait new Promise(res=>{const on=d=>{const m=String(d).match(/port (\\\\d+)/); if(m){port=+m[1];res();}}; srv.stderr.on('data',on); srv.stdout.on('data',on); setTimeout(res,4000);});\\nconsole.log('port',port);\\nconst pw = await import('playwright');\\nconst browser = await pw.chromium.launch();\\nconst hp = await browser.newPage();\\nhp.on('console', m=>console.log('[console]', m.type(), m.text().slice(0,200)));\\nhp.on('pageerror', e=>console.log('[pageerror]', String(e).slice(0,300)));\\nawait hp.goto('http://127.0.0.1:'+port+'/harness.html?game=game.html&players=1&auto=1');\\nawait hp.waitForTimeout(20000);\\nconst state = await hp.evaluate(()=>({ complete: document.body.dataset.complete, check: window.__hubCheck ? {pass: window.__hubCheck.pass, checks: window.__hubCheck.checks} : null, round: document.querySelector('#round')?.textContent?.slice(0,500), checksText: document.querySelector('#checks')?.textContent?.slice(0,1500), log: document.querySelector('#log')?.textContent?.slice(-1500) }));\\nconsole.log(JSON.stringify(state,null,1).slice(0,4000));\\nawait browser.close();\\nsrv.kill('SIGTERM');\\nEOF\\ntimeout 90 node tests/probe.mjs 2>&1 | head -n 60\",\n  \"description\": \"Probe hub harness failures in detail\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"port 41661\\n[console] warning Unrecognized feature: 'pointer-lock'.\\n{\\n \\\"complete\\\": \\\"true\\\",\\n \\\"check\\\": {\\n  \\\"pass\\\": false,\\n  \\\"checks\\\": [\\n   {\\n    \\\"name\\\": \\\"head metas\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"hub:session=1 mode=ghost\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"hub:session-players is a range within 1–4\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"hub:session-players=1-4\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"hub:session-minutes, when given, is a number\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"hub:session-minutes=3\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"every copy says hello\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"hello names protocol 1 and the mode\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"{\\\\\\\"v\\\\\\\":1,\\\\\\\"client\\\\\\\":\\\\\\\"1.4.0\\\\\\\",\\\\\\\"mode\\\\\\\":\\\\\\\"ghost\\\\\\\",\\\\\\\"seats\\\\\\\":[1,4],\\\\\\\"card\\\\\\\":true}\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"hello seats cover this player count\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"[1,4]\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"ready without a key press (the card asks the players)\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"its own card: Enter answers Ready\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"the round starts when the card ends\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"countdown\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"ghost: Math.random is seeded, the same on every copy\\\",\\n    \\\"pass\\\": true,\\n    \\\"detail\\\": \\\"p0: client 1.4.0 seeded true\\\"\\n   },\\n   {\\n    \\\"name\\\": \\\"ghost: every copy sends its player\\\",\\n    \\\"pass\\\": true,\\n\",\n  \"original_output_bytes\": 1376,\n  \"original_output_tokens\": 344,\n  \"truncated\": false\n}","final_result":true,"kind":"output","task_id":"01a1aa21-aefe-73f3-90f5-a8217200d8d5"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa21-aefe-73f3-90f5-a8217200d8d5","task_stream":{"id":"01a1aa21-aefe-73f3-90f5-a8217200d8d5","kind":"task"}}}
