{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d751","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":2563,"recorded_at":1780531400005121,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"{\n  \"chunk_id\": \"exec-34-1\",\n  \"command\": \"cd \\\"WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235\\\"\\ncat > tests/probe-attract.mjs << 'EOF'\\nimport { join, dirname } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nconst root = join(dirname(fileURLToPath(import.meta.url)), '..');\\nconst built = join(root, '..', 'WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235.html');\\nconst pw = await import('playwright');\\nconst browser = await pw.chromium.launch();\\nconst page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\\nawait page.goto('file://' + built);\\nfor (let i = 0; i < 4; i++) {\\n  await page.waitForTimeout(4000);\\n  console.log(i, JSON.stringify(await page.evaluate(() => ({ real: window.G.game.real, idle: window.G.idleSeconds(), snap: window.G.game.debug.snapshot(), paused: window.G.game.paused }))));\\n}\\nawait page.keyboard.press('a');\\nawait page.waitForTimeout(1200);\\nconsole.log('after key', JSON.stringify(await page.evaluate(() => window.G.game.debug.snapshot())));\\nawait browser.close();\\nEOF\\ntimeout 60 node tests/probe-attract.mjs 2>&1 | tail -6\",\n  \"description\": \"Probe attract idle timing\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"0 {\\\"real\\\":3.9499999999999886,\\\"idle\\\":3.9499999999999886,\\\"snap\\\":{\\\"scene\\\":\\\"title\\\",\\\"title\\\":\\\"Willy Fit\\\",\\\"spineAge\\\":71,\\\"minutes\\\":0,\\\"day\\\":1,\\\"hash\\\":\\\"c715174b\\\"},\\\"paused\\\":false}\\n1 {\\\"real\\\":7.966666666666852,\\\"idle\\\":7.966