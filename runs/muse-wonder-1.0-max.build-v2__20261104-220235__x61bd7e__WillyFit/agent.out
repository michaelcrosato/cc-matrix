{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d4b7","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":2230,"recorded_at":1780531400004455,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"{\n  \"chunk_id\": \"exec-29-1\",\n  \"command\": \"cd \\\"WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235\\\"\\ncat > tests/probe2.mjs << 'EOF'\\nimport { spawn } from 'node:child_process';\\nimport { join, dirname } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nconst root = join(dirname(fileURLToPath(import.meta.url)), '..');\\nconst srv = spawn('python3', ['-u','-m','http.server','0','--bind','127.0.0.1'], { cwd: join(root,'tests/hub') });\\nlet port=0;\\nawait new Promise(res=>{const on=d=>{const m=String(d).match(/port (\\\\d+)/); if(m){port=+m[1];res();}}; srv.stderr.on('data',on); srv.stdout.on('data',on); setTimeout(res,4000);});\\nconst pw = await import('playwright');\\nconst browser = await pw.chromium.launch();\\nconst cases = ['players=2&auto=1','players=4&latency=150&jitter=50&loss=5&auto=1','players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave'];\\nfor (const q of cases) {\\n  const hp = await browser.newPage();\\n  await hp.goto('http://127.0.0.1:'+port+'/harness.html?game=game.html&'+q);\\n  await hp.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 120000 }).catch(()=>{});\\n  const r = await hp.evaluate(()=>({ pass: !!(window.__hubCheck && window.__hubCheck.pass), bad: (window.__hubCheck?.checks||[]).filter(c=>!c.pass).map(c=>c.name+': '+(c.detail||'').slice(0,80)) }));\\n  console.log(q, '=>', r.pass ? 'PASS' : 'FAIL', JSON.stringify(r.bad).slice(0,300));\\n  await hp.close();\\n}\\nawait browser.close(); srv.kill('SIGTERM');\\nEOF\\ntimeout 280 node tests/probe2.mjs 2>&1 | tail -6\",\n  \"description\": \"Test hub 2p 4p host-leave variants\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"players=2&auto=1 => FAIL [\\\"ghost: every copy sends its player: p0 ↑0 p1 ↑0\\\"]\\nplayers=4&latency=150&jitter=50&loss=5&auto=1 => FAIL [\\\"ghost: every copy sends its player: p0 ↑0 p1 ↑0 p2 ↑0\\\"]\\nplayers=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave => FAIL [\\\"ghost: every copy sends its player: p1 ↑0 p2 ↑0 p3 ↑0\\\"]\\n\",\n  \"original_output_bytes\": 337,\n  \"original_output_tokens\": 85,\n  \"truncated\": false\n}","final_result":true,"kind":"output","task_id":"01a1aa23-58e1-7d63-96b7-16628cfca71a"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa23-58e1-7d63-96b7-16628cfca71a","task_stream":{"id":"01a1aa23-58e1-7d63-96b7-16628cfca71a","kind":"task"}}}
