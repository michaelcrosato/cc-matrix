{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d84f","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":2690,"recorded_at":1780531400005375,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"edited\nchanged lines: lines 203-208\n--- original\n+++ updated\n@@\n-        // harness 1 player auto (best effort, long)\n-        const hp = await browser.newPage();\n-        await hp.goto('http://127.0.0.1:' + port + '/harness.html?game=game.html&players=1&auto=1');\n-        await hp.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 90000 }).catch(() => {});\n-        const passH = await hp.evaluate(() => !!(window.__hubCheck && window.__hubCheck.pass));\n-        check('hub harness 1p passes', passH, '');\n+        // harness at every planned setting\n+        const cases = ['players=1&auto=1', 'players=2&auto=1', 'players=3&latency=150&jitter=50&loss=5&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave'];\n+        for (const q of cases) {\n+          const hp = await browser.newPage();\n+          await hp.goto('http://127.0.0.1:' + port + '/harness.html?game=game.html&' + q);\n+          await hp.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 120000 }).catch(() => {});\n+          const r = await hp.evaluate(() => ({ pass: !!(window.__hubCheck && window.__hubCheck.pass), bad: (window.__hubCheck && window.__hubCheck.checks || []).filter(c => !c.pass).map(c => c.name) }));\n+          check('hub harness ' + q + ' passes', r.pass, (r.bad || []).join(', ').slice(0, 160));\n+          await hp.close();\n+        }\n","final_result":true,"kind":"output","task_id":"01a1aa27-80a1-7380-b1b5-e675bf75c101"},