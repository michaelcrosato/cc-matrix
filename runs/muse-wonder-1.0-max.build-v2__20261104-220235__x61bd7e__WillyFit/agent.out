{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d3c7","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":2110,"recorded_at":1780531400004215,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"{\n  \"chunk_id\": \"exec-27-1\",\n  \"command\": \"cd \\\"WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235\\\" && timeout 90 node tests/probe.mjs > tests/probe-out.txt 2>&1; python3 - << 'PY'\\nimport json,re\\nt=open('tests/probe-out.txt').read()\\ni=t.find('{')\\n# find JSON object start of state print\\nj=t.find('{\\\\n \\\"complete\\\"')\\ns=t[j:]\\n# strip trailing non-json\\ntry:\\n  d=json.loads(s)\\nexcept Exception as e:\\n  print(\\\"parse fail\\\",e); print(s[:2000]); raise SystemExit\\nfor c in d['check']['checks']:\\n  print(('PASS' if c['pass'] else 'FAIL'), c['name'], '|', (c.get('detail') or '')[:160])\\nprint('ROUND:', d.get('round'))\\nprint('LOG tail:', (d.get('log') or '')[-800:])\\nPY\",\n  \"description\": \"List all hub check results\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"PASS head metas | hub:session=1 mode=ghost\\nPASS hub:session-players is a range within 1–4 | hub:session-players=1-4\\nPASS hub:session-minutes, when given, is a number | hub:session-minutes=3\\nPASS every copy says hello | \\nPASS hello names protocol 1 and the mode | {\\\"v\\\":1,\\\"client\\\":\\\"1.4.0\\\",\\\"mode\\\":\\\"ghost\\\",\\\"seats\\\":[1,4],\\\"card\\\":true}\\nPASS hello seats cover this player count | [1,4]\\nPASS ready without a key press (the card asks the players) | \\nPASS its own card: Enter answers Ready | \\nPASS the round starts when the card ends | countdown\\nPASS ghost: Math.random is seeded, the same on every copy | p0: client 1.4.0 seeded true\\nPASS ghost: every copy sends its p