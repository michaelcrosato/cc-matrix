{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d5e9","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":2383,"recorded_at":1780531400004761,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"{\n  \"chunk_id\": \"exec-32-1\",\n  \"command\": \"cd \\\"WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235\\\"\\ncat > tests/shots.mjs << 'EOF'\\nimport { join, dirname } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nconst root = join(dirname(fileURLToPath(import.meta.url)), '..');\\nconst built = join(root, '..', 'WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235.html');\\nconst pw = await import('playwright');\\nconst browser = await pw.chromium.launch();\\nasync function shot(url, file, keys, waitMs) {\\n  const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });\\n  const errs=[]; page.on('pageerror', e=>errs.push(String(e).slice(0,200)));\\n  await page.goto(url); await page.waitForTimeout(3000);\\n  if (keys) { for (const k of keys) { await page.keyboard.press(k); await page.waitForTimeout(600); } }\\n  await page.waitForTimeout(waitMs || 1000);\\n  await page.screenshot({ path: join(root, 'shots', file) });\\n  console.log(file, JSON.stringify(await page.evaluate(()=>window.G.game.debug.snapshot())), 'errs', JSON.stringify(errs).slice(0,200));\\n  await page.close();\\n}\\nawait shot('file://' + built + '#act/stork/1', 'stork-card.png', null, 500);\\nawait shot('file://' + built + '#act/stork/1', 'stork-play.png', ['Enter'], 8000);\\nawait shot('file://' + built + '#island', 'island2.png', null, 500);\\nawait browser.close();\\nEOF\\ntimeout 90 node tests/shots.mjs 2>&1 | tail -5\",\n  \"description\": \"Recapture session and island screenshots\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"stork-card.png {\\\"scene\\\":\\\"session\\\",\\\"title\\\":\\\"Willy Fit\\\",\\\"activity\\\":\\\"stork\\\",\\\"tier\\\":1,\\\"pct\\\":0,\\\"spineAge\\\":71,\\\"minutes\\\":0,\\\"day\\\":1,\\\"hash\\\":\\\"ece9fb98\\\"} errs []\\nstork-play.png {\\\"scene\\\":\\\"session\\\",\\\"title\\\":\\\"Willy Fit\\\",\\\"activity\\\":\\\"stork\\\",\\\"tier\\\":1,\\\"pct\\\":0,\\\"spineAge\\\":71,\\\"minutes\\\":0,\\\"day\\\":1,\\\"hash\\\":\\\"02330098\\\"} errs []\\nisland2.png {\\\"scene\\\":\\\"island\\\",\\\"title\\\":\\\"Willy Fit\\\",\\\"day\\\":1,\\\"spineAge\\\":71,\\\"minutes\\\":0,\\\"hash\\\":\\\"e810ffd2\\\"} errs []\\n\",\n  \"original_output_bytes\": 413,\n  \"original_output_tokens\": 104,\n  \"truncated\": false\n}","final_result":true,"kind":"output","task_id":"01a1aa24-c57e-7752-a153-801a08fa1fea"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa24-c57e-7752-a153-801a08fa1fea","task_stream":{"id":"01a1aa24-c57e-7752-a153-801a08fa1fea","kind":"task"}}}
