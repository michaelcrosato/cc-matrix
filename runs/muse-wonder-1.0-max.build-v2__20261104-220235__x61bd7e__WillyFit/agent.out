owser.close();\\nEOF\\ntimeout 90 node tests/shots.mjs 2>&1 | tail -5\",\n  \"description\": \"Recapture session and island screenshots\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"stork-card.png {\\\"scene\\\":\\\"session\\\",\\\"title\\\":\\\"Willy Fit\\\",\\\"activity\\\":\\\"stork\\\",\\\"tier\\\":1,\\\"pct\\\":0,\\\"spineAge\\\":71,\\\"minutes\\\":0,\\\"day\\\":1,\\\"hash\\\":\\\"ece9fb98\\\"} errs []\\nstork-play.png {\\\"scene\\\":\\\"session\\\",\\\"title\\\":\\\"Willy Fit\\\",\\\"activity\\\":\\\"stork\\\",\\\"tier\\\":1,\\\"pct\\\":0,\\\"spineAge\\\":71,\\\"minutes\\\":0,\\\"day\\\":1,\\\"hash\\\":\\\"02330098\\\"} errs []\\nisland2.png {\\\"scene\\\":\\\"island\\\",\\\"title\\\":\\\"Willy Fit\\\",\\\"day\\\":1,\\\"spineAge\\\":71,\\\"minutes\\\":0,\\\"hash\\\":\\\"e810ffd2\\\"} errs []\\n\",\n  \"original_output_bytes\": 413,\n  \"original_output_tokens\": 104,\n  \"truncated\": false\n}"}}
