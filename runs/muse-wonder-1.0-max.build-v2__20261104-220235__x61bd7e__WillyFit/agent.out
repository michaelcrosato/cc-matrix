{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6af","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":434,"recorded_at":1780531400000863,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"Read text file `WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235/engine/my-3d2dge.js`.\n(557 line(s) above)\n558|class View {\n559|  /** new E.View(id, label, yaw, pitch, scale, zBoost): an orthographic camera (degrees; scale = screen pixels per\n560|   *  world unit; zBoost stretches heights). id: its name ('iso', or yours); label: its name for people ('Isometric') */\n561|  constructor(id, label, yaw, pitch, scale = 1, zBoost = 1) { this.id = id; this.label = label; this.set(yaw, pitch, scale, zBoost); }\n562|  /** change the angles and scale in place (game.setView and rotateView use their own copies); returns the view */\n563|  set(yaw, pitch, scale = 1, zBoost = 1) {\n564|    /** yawDeg: the turn about the up axis, degrees (0: north is up the screen; iso is 45); pitchDeg: the tilt, 0\n565|     *  side view to 90 straight down; scale: screen pixels per world unit; zBoost: how much heights are stretched on\n566|     *  screen (1 = true) */\n567|    this.yawDeg = yaw; this.pitchDeg = pitch; this.scale = scale; this.zBoost = zBoost;\n568|    const w = yaw * DEG, p = pitch * DEG, cw = Math.cos(w), sw = Math.sin(w), cp = Math.cos(p), sp = Math.sin(p);\n569|    /** yaw, pitch: the same angles in radians */\n570|    this.yaw = w; this.pitch = p;\n571|    /** ax, ay: screen x = ax * x + ay * y (the projection's first row) */\n572|    this.ax = scale * cw; this.ay = -scale * sw;\n573|    /** bx, by, bz: screen y = bx * x + by * y + bz * z (the second row; bz < 0 lifts things up the screen) */\n574|    this.bx = scale * sp * sw; this.by = scale * sp * cw; this.bz = -scale * cp * zBoost;\n575|    /** dx, dy, dz: the direction toward the camera, for true depth (view.depth); bigger is nearer */\n576|    this.dx = sw * cp; this.dy = cw * cp; this.dz = sp;   // true camera depth (bigger = nearer)\n577|    /** fx, fy: the ground direction that points at the camera (the front of a wall faces it) */\n578|    this.fx = sw; this.fy = cw;                           // ground direction that points at the camera\n579|    /** isTop: looking straight down (pitch 89 or more); isSide: a side view (pitch 1 or less: x right, z up, y is\n580|     *  depth) */\n581|    this.isTop = pitch >= 89; this.isSide = pitch <= 1;\n582|    const det = this.ax * this.by - this.ay * this.bx;\n583|    /** inv: the inverse of the ground projection (screen -> ground at z 0), null in side views */\n584|    this.inv = Math.abs(det) > 1e-6 && pitch > 5 ? [this.by / det, -this.ay / det, -this.bx / det, this.ax / det] : null;\n585|    return this;\n586|  }\n587|  /** world -> projected screen pixels (not yet camera-relative) */\n588|  p(x, y, z = 0) { return [this.ax * x + this.ay * y, this.bx * x + this.by * y + this.bz * z]; }\n589|  /** true camera depth: use it to sort parts inside one object */\n590|  depth(x, y, z = 0) { return this.dx * x + this.dy * y + this.dz * z; }\n591|  /** painter's order for whole objects standing on the ground */\n592|  order(x, y, z = 0) { return this.isTop ? z + (this.bx * x + this.by * y) * 1e-3 : this.fx * x + this.fy * y + z * 1e-3; }\n593|  /** projected screen point -> ground point (z = 0). null in side view */\n594|  toGround(sx, sy) { const i = this.inv; return i ? [i[0] * sx + i[1] * sy, i[2] * sx + i[3] * sy] : null; }\n595|  /** a direction the player pushed on screen (x right, y down) -> normalized ground direction */\n596|  screenDirToGround(dx, dy) {\n597|    if (!dx && !dy) return [0, 0];\n598|    let g = this.inv ? [this.inv[0] * dx + this.inv[1] * dy, this.inv[2] * dx + this.inv[3] * dy] : [dx, dy];\n599|    const l = Math.hypot(g[0], g[1]) || 1, m = Math.min(1, Math.hypot(dx, dy));\n600|    return [g[0] / l * m, g[1] / l * m];\n601|  }\n602|}\n603|E.View = View;\n604|/** the ready-made views: iso (yaw 45, pitch 30), threequarter (pitch 55), topdown (80), brawler (25), side (0) and\n605| *  overhead (90, scale 1: world x/y = screen pixels); new E.Game({ view: 'iso' }) and game.setView('side') take\n606| *  their names */\n607|E.VIEWS = {\n608|  iso: new View('iso', 'Isometric', 45, 30, Math.SQRT2, 1),                 // Diablo, Bastion (2:1 pixel iso)\n609|  threequarter: new View('threequarter', 'Three-quarter', 0, 55, 1.5, 1.35), // Zelda, Stardew, Enter the Gungeon\n610|  topdown: new View('topdown', 'Top-down', 0, 80, 1.5, 1.3),                 // Hotline Miami, GTA 1\n611|  brawler: new View('brawler', 'Brawler', 0, 25, 1.5, 1),                    // Streets of Rage, Castle Crashers\n612|  side: new View('side', 'Side', 0, 0, 1.5, 1),                              // Mega Man, platformers\n613|  overhead: new View('overhead', 'Overhead', 0, 90, 1, 1)                    // 1942, puzzles: world x/y = screen pixels\n614|};\n615|/** the order game.nextView() cycles through when a game doesn't set game.views ('overhead' is left out) */\n616|E.VIEW_ORDER = ['iso', 'threequarter', 'topdown', 'brawler', 'side'];   // 'overhead' is left out: it is for flat games\n617|/**\n618| * The classic SNES RPG cheat: in steep ground views (pitch 40-70, like threequarter) characters are drawn from a lower,\n619| * sprite-like angle so their faces show, at the same height on screen. Humanoid and Blob do this by themselves\n620| * (option charView: false turns it off for one rig, E.style.charPitch = false for all). E.charView(view) gives that view.\n621| */\n622|/** the view a rig in `view` is drawn from (the sprite-like angle above; the view itself outside pitch 40-89) */\n623|function charView(view) {\n624|  const P = E.style.charPitch;\n625|  if (P === false || view.pitchDeg < 40 || view.pitchDeg >= 89) return view;\n626|  const cp = P || 30, key = view.yawDeg + ':' + view.pitchDeg + ':' + view.scale + ':' + view.zBoost + ':' + cp;\n627|  let v = _cviews.get(key);\n628|  // height on screen: kept as the view has it up to 70 degrees; steeper (top-down) views draw upright sprites as tall as three-quarter ones\n629|  const h = view.pitchDeg <= 70 ? view.zBoost * Math.cos(view.pitchDeg * DEG) : .78;\n630|  if (!v) { v = new View(view.id, view.label, view.yawDeg, cp, view.scale, h / Math.cos(cp * DEG)); _cviews.set(key, v); }\n631|  return v;\n632|}\n633|const _cviews = new Map();\n634|E.charView = charView;\n635|\n636|/* =============================================================================\n637| * 4. SCREEN  low-res buffer, whole-number upscale, sub-pixel camera on present\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1aa17-7f9b-73b3-9a05-7dfaa49146fa"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa17-7f9b-73b3-9a05-7dfaa49146fa","task_stream":{"id":"01a1aa17-7f9b-73b3-9a05-7dfaa49146fa","kind":"task"}}}
