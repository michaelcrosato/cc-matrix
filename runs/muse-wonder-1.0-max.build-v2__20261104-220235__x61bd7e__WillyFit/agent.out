{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c673","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":404,"recorded_at":1780531400000803,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.started","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"kind":"started","span_id":"ce0769e364d0ffab","task_id":"01a1aa17-74a1-7591-be39-42c998ddc6fa"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa17-74a1-7591-be39-42c998ddc6fa","task_stream":{"id":"01a1aa17-74a1-7591-be39-42c998ddc6fa","kind":"task"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c675","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":405,"recorded_at":1780531400000805,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"Read text file `WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235/engine/my-3d2dge.js`.\n(9224 line(s) above)\n9225|    r.overlay(g => {\n9226|      const d = this._dims(), ui = E.ui;\n9227|      ui.box(g, d.x, d.y, d.w, d.h, { bg: this.bg, border: this.border, alpha: this._alpha });\n9228|      if (this.portrait) {\n9229|        const px0 = d.x + 5, py0 = d.y + Math.round((d.h - d.P) / 2);\n9230|        if (typeof this.portrait === 'function') this.portrait(g, px0, py0, d.P);\n9231|        else { this.portrait._talk = this.typing; this.portrait.drawPortrait(g, px0, py0, d.P, Object.assign({ bg: shade(Array.isArray(this.bg) ? this.bg[0] : this.bg, .12), border: this.border, shadow: false }, this._pOpts)); this.portrait._talk = false; }   // the mouth moves while the text types\n9232|      }\n9233|      if (this.name) { const nw = E.font.width(this.name) + 12, nx = d.x + (this.portrait ? d.tx - 6 : 4); ui.box(g, nx, d.y - 12, nw, 14, { bg: this.bg, border: this.border }); E.font.text(g, this.name, nx + 6, d.y - 9, this.nameColor, { outline: false, shadow: '#05040a' }); }\n9234|      let left = Math.floor(this.shown);\n9235|      const mk = this._fx && this._fx[this.i], o = { outline: false, shadow: '#05040a' };\n9236|      if (!mk) this._page.forEach((line, k) => { const s = line.slice(0, Math.max(0, left)); left -= line.length; if (s) E.font.text(g, s, d.x + d.tx, d.y + 5 + k * d.lh, this.color, o); });\n9237|      else {   // markup: runs of one look drawn together, trembling and bobbing letters one by one\n9238|        let n0 = 0; const t = this.game.real;\n9239|        this._page.forEach((line, k) => {\n9240|          const shown = Math.min(line.length, Math.max(0, left)), y = d.y + 5 + k * d.lh; left -= line.length;\n9241|          for (let j = 0; j < shown;) {\n9242|            const f = mk.fx[n0 + j] || {}, one = f.shake || f.wave; let e = j + 1;\n9243|            if (!one) while (e < shown && mk.fx[n0 + e] === f) e++;\n9244|            const n = n0 + j, x = d.x + d.tx + (j ? E.font.width(line.slice(0, j)) + 1 : 0);\n9245|            const ox = f.shake ? Math.round(hash2(n, Math.floor(t * 24)) * 2 - 1) : 0, oy = (f.shake ? Math.round(hash2(n + 50, Math.floor(t * 24)) * 2 - 1) : 0) + (f.wave ? Math.round(Math.sin(t * 8 - n * .7) * 1.5) : 0);\n9246|            E.font.text(g, line.slice(j, e), x + ox, y + oy, f.c || this.color, o); j = e;\n9247|          }\n9248|          n0 += line.length;\n9249|        });\n9250|      }\n9251|      const blink = Math.floor(this.game.real * 3) % 2 === 0, last = this.i >= this.pages.length - 1;\n9252|      if (!this.typing && !(last && this.choices) && blink) px.poly(g, [[d.x + d.w - 10, d.y + d.h - 6], [d.x + d.w - 5, d.y + d.h - 6], [d.x + d.w - 7.5, d.y + d.h - 3]], this.color);\n9253|      if (last && this.choices && !this.typing) {\n9254|        const { x: cx, y: cy, w: cw, h: ch } = this._cbox(d);\n9255|        ui.box(g, cx, cy, cw, ch, { bg: this.bg, border: this.border });\n9256|        this.choices.forEach((c, k) => { E.font.text(g, c, cx + 13, cy + 4 + k * d.lh, k === this.choice ? this.nameColor : this.color, { outline: false, shadow: '#05040a' }); if (k === this.choice && blink) E.font.text(g, '▸', cx + 5, cy + 4 + k * d.lh, this.nameColor, false); });\n9257|      }\n9258|    });\n9259|  }\n9260|}\n9261|E.Dialog = Dialog;\n9262|\n9263|/**\n9264| * Menu with a cursor (title screens, pause menus, shops, battle commands).\n9265| *   const menu = new E.Menu(game, ['START', 'OPTIONS', { label: 'CONTINUE', disabled: !save }], { onPick(i, item) {...}, onCancel() {...} });\n9266| *   update: menu.update(dt)      draw: menu.draw(r)\n9267| * opts: { x: 'center' | px, y: 'center' | px, title, box: true, color, pick: '#ffd36a', columns: 1 }\n9268| */\n9269|class Menu {\n9270|  constructor(game, items, o = {}) {\n9271|    /** game: its game; items: the entries (strings, or { label, disabled }); i: the one under the cursor; active:\n9272|     *  false stops it reading input */\n9273|    this.game = game; this.items = items || []; this.i = 0; this.active = true;\n9274|    /** x, y: where it sits, 'center' or pixels; title: a heading, or null; box: draw a window round it; color: the\n(more lines below)","final_result":true,"kind":"output","task_id":"01a1aa17-7456-7ff2-8134-1ca7ab32f2a5"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa17-7456-7ff2-8134-1ca7ab32f2a5","task_stream":{"id":"01a1aa17-7456-7ff2-8134-1ca7ab32f2a5","kind":"task"}}}
