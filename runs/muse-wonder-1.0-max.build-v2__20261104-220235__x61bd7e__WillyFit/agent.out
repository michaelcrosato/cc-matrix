d.tx, d.y + 5 + k * d.lh, this.color, o); });\n9237|      else {   // markup: runs of one look drawn together, trembling and bobbing letters one by one\n9238|        let n0 = 0; const t = this.game.real;\n9239|        this._page.forEach((line, k) => {\n9240|          const shown = Math.min(line.length, Math.max(0, left)), y = d.y + 5 + k * d.lh; left -= line.length;\n9241|          for (let j = 0; j < shown;) {\n9242|            const f = mk.fx[n0 + j] || {}, one = f.shake || f.wave; let e = j + 1;\n9243|            if (!one) while (e < shown && mk.fx[n0 + e] === f) e++;\n9244|            const n = n0 + j, x = d.x + d.tx + (j ? E.font.width(line.slice(0, j)) + 1 : 0);\n9245|            const ox = f.shake ? Math.round(hash2(n, Math.floor(t * 24)) * 2 - 1) : 0, oy = (f.shake ? Math.round(hash2(n + 50, Math.floor(t * 24)) * 2 - 1) : 0) + (f.wave ? Math.round(Math.sin(t * 8 - n * .7) * 1.5) : 0);\n9246|            E.font.text(g, line.slice(j, e), x + ox, y + oy, f.c || this.color, o); j = e;\n9247|          }\n9248|          n0 += line.length;\n9249|        });\n9250|      }\n9251|      const blink = Math.floor(this.game.real * 3) % 2 === 0, last = this.i >= this.pages.length - 1;\n9252|      if (!this.typing && !(last && this.choices) && blink) px.poly(g, [[d.x + d.w - 10, d.y + d.h - 6], [d.x + d.w - 5, d.y + d.h - 6], [d.x + d.w - 7.5, d.y + d.h - 3]], this.color);\n9253|      if (last && this.choices && !this.typing) {\n9254|        const { x: cx, y: cy, w: cw, h: ch } = this._cbox(d);\n9255|        ui.box(g, cx, cy, cw, ch, { bg: this.bg, border: this.border });\n9256|        this.choices.forEach((c, k) => { E.font.text(g, c, cx + 13, cy + 4 + k * d.lh, k === this.choice ? this.nameColor : this.color, { outline: false, shadow: '#05040a' }); if (k === this.choice && blink) E.font.text(g, '▸', cx + 5, cy + 4 + k * d.lh, this.nameColor, false); });\n9257|      }\n9258|    });\n9259|  }\n9260|}\n9261|E.Dialog = Dialog;\n9262|\n9263|/**\n9264| * Menu with a cursor (title screens, pause menus, shops, battle commands).\n9265| *   const menu = new E.Menu(game, ['START', 'OPTIONS', { label: 'CONTINUE', disabled: !save }], { onPick(i, item) {...}, onCancel() {...} });\n9266| *   update: menu.update(dt)      draw: menu.draw(r)\n9267| * opts: { x: 'center' | px, y: 'center' | px, title, box: true, color, pick: '#ffd36a', columns: 1 }\n9268| */\n9269|class Menu {\n9270|  constructor(game, items, o = {}) {\n9271|    /** game: its game; items: the entries (strings, or { label, disabled }); i: the one under the cursor; active:\n9272|     *  false stops it reading input */\n9273|    this.game = game; this.items = items || []; this.i = 0; this.active = true;\n9274|    /** x, y: where it sits, 'center' or pixels; title: a heading, or null; box: draw a window round it; color: the\n(more lines below)"}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c681","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":411,"recorded_at":1780531400000817,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a1aa176e9972afb7ded90a185468fd","command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","correlation_facts":{"outcome":"success","tool_name":"bash"},"kind":"tool_result","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"text":"{\n  \"chunk_id\": \"exec-9-1\",\n  \"command\": \"cd \\\"WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235\\\"\\ngrep -n \\\"class Game\\\" -A 5 engine/my-3d2dge.js | head\\ngrep -n \\\"saves\\\\|allowJoin\\\\|cornerArea\\\\|debug\\\\|advance\\\\|hook(\\\" engine/my-3d2dge.js | head -n 30\\necho \\\"---rhythm kit head---\\\"\\nhead -n 80 engine/kits/rhythm.js\\necho \\\"---sports join---\\\"\\ngrep -n \\\"allowJoin\\\\|halfKeys\\\\|PLAYER_COLORS\\\" engine/my-3d2dge.js | head\",\n  \"description\": \"Check Dialog and Game APIs\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"2308:class Game {\\n2309-  /**\\n2310-   * new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu,\\n2311-   * fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features\\n2312-   * (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\\n2313-   * - res: a fixed resolution ('ps1' or [w, h]), whole pixels\\n42: *    {...}) (21d). Save slots: game.saves (10k).\\n47: *    new E.Game({ menu: { items, settings, controls, quit, saves } }), or leave them out (menu: false, fullscreen: false,\\n57: *    inputs, the random seed, the screen and the save. E.session.share() saves it as a file; node tools/replay.mjs\\n59: * 11. TESTS. new E.Game({ headless: true }) (the default in Node) runs with no screen: game.advance(1) runs 120 fixed\\n60: *    steps at once, game.input.tap('jump') and hold('right') script input, game.debug = { snapshot() { ... } } is\\n807:     *  game's menu.controls); onBindings(b): called with the player's new bindings (the game saves and applies them) */\\n914:  _setBindings(b) { if (this._onBindings) this._onBindings(b); else this.bindings = b; }   // (the game saves them in its settings)\\n1164:  /** advance input by one step: read the gamepad and turn presses since the last step into this step's pressed() and\\n2319:   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\\n2320:   * - draw: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\\n2321:   * - loop: false makes a game in a page that runs only by advance()\\n2410:    /** a game's own handle for tools and tests: game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }.\\n2412:    this.debug = null;\\n2493:  /** the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an\\n2607:  cornerArea() {\\n2713:   * by advance().\\n2838:   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\\n2839:   * with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test\\n2842:  advance(seconds = this.o.step, o = {}) {\\n2843:    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\\n3136:  /** put a group's settings (or all of them) back to their defaults; a game's saves are not touched */\\n3509:  /** draw it over the scene to see it (debugging): a line, and a dot at each of its points */\\n3724: *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\\n3755: *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\\n3756:Game.prototype.allowJoin = function (o = {}) {\\n3776:  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\\n3864: * 10k. SAVE SLOTS  game.saves: three slots and an autosave, each holding the game's own data with its place, time\\n3867: *    on with the saves kept for the visit (a headless game keeps them in memory only).\\n3868: *      game.saves.write = () => ({ data: { hero, flags }, place: 'Brightwater', level: hero.lv });   // what a save holds\\n3869: *      game.saves.read = save => { hero = save.data.hero; ... };                                    // what a load does\\n---rhythm kit head---\\n// The RHYTHM kit's game (four lanes on the music clock: two songs, notes, jumps, holds, a rapping teacher to answer, a dancer and a crowd on the beat, grades, the audio offset), readable: the starter's shell (src/starter/00-shell.js), then\\n// the slice from line 159 (src/starter/37-rhythm.js: its header says what it plays and how), then the start (90-start.js), as the\\n// single-file kit holds them between GAME START and GAME END. rhythm.html plays it; node kits/test.mjs rhythm runs it headless.\\n/* ============================== GAME START ==============================\\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\\n * ======================================================================== */\\n(() => {\\n'use strict';\\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\\n\\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\\nconst P = game.particles, L = game.lights, A = game.audio;\\nconst scenes = {};\\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\\nconst SLICES = [\\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\\n];\\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\\nconst camOpt = () => (game.scene && game.scene.camera) || {};\\naddEventListener('keydown', e => {\\n  if (e.repeat) return;\\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\\n  else if (e.code === 'KeyM') A.mute();\\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\\n});\\n\\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\\nconst titleBg = new E.Backdrop('castle-night');\\nconst HEROES = [   // six heroes, each dressed with the HD rig options\\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\\n];\\n---sports join---\\n874:      if (!Array.isArray(map[a])) continue;   // (a preset's halves: Input.halfKeys)\\n2297:E.PLAYER_COLORS = ['#4a8aff', '#ff4a4a', '#4ad860', '#ffd040'];\\n2493:  /** the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an\\n2494:   *  input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input] */\\n2495:  get players() { if (!this._players) { const I = this.input; Object.assign(I, { player: 1, name: 'P1', color: E.PLAYER_COLORS[0] }); this._players = [I]; } return this._players; }\\n3723: *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\\n3724: *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\\n3737: *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /).\\n3740:Input.halfKeys = (preset, side) => {\\n3747:const _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\\n\",\n  \"original_output_bytes\": 12766,\n  \"original_output_tokens\": 3192,\n  \"truncated\": false\n}"}}
