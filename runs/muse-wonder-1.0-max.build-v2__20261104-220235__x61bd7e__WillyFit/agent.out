{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d7b5","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":2613,"recorded_at":1780531400005221,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"{\n  \"chunk_id\": \"exec-36-1\",\n  \"command\": \"cd \\\"WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235\\\"\\ncat > tests/probe-attract3.mjs << 'EOF'\\nimport { join, dirname } from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\nconst root = join(dirname(fileURLToPath(import.meta.url)), '..');\\nconst built = join(root, '..', 'WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235.html');\\nconst pw = await import('playwright');\\nconst browser = await pw.chromium.launch();\\nconst page = await browser.newPage({ viewport: { width: 1280, height: 720 } });\\npage.on('pageerror', e=>console.log('PAGEERR', String(e).slice(0,300)));\\npage.on('console', m=>{ if (m.type()==='error'||m.type()==='warning') console.log('CONSOLE', m.type(), m.text().slice(0,300)); });\\nawait page.goto('file://' + built);\\nawait page.waitForTimeout(11500);\\nconsole.log(JSON.stringify(await page.evaluate(() => ({ snap: window.G.game.debug.snapshot(), errors: (window.G.game.errors||[]).map(e=>({where:e.where, message:String(e.message||e).slice(0,300)})), sceneName: window.G.game.sceneName, hasAttract: !!window.G.scenes.attract })), null, 1).slice(0,2000));\\nawait browser.close();\\nEOF\\ntimeout 60 node tests/probe-attract3.mjs 2>&1 | tail -20\",\n  \"description\": \"Inspect errors blocking attract switch\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"CONSOLE warning The AudioContext was not allowed to start. It must be resumed (or created) after a user gesture on the page. https://developer.chrome.com/blog/autoplay/#web_audio\\n{\\n \\\"snap\\\": {\\n  \\\"scene\\\": \\\"title\\\",\\n  \\\"title\\\": \\\"Willy Fit\\\",\\n  \\\"spineAge\\\": 71,\\n  \\\"minutes\\\": 0,\\n  \\\"day\\\": 1,\\n  \\\"hash\\\": \\\"3dc8c092\\\"\\n },\\n \\\"errors\\\": [],\\n \\\"sceneName\\\": \\\"attract\\\",\\n \\\"hasAttract\\\": true\\n}\\n\",\n  \"original_output_bytes\": 369,\n  \"original_output_tokens\": 93,\n  \"truncated\": false\n}","final_result":true,"kind":"output","task_id":"01a1aa26-cdee-78c2-82eb-1dada1652ae1"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa26-cdee-78c2-82eb-1dada1652ae1","task_stream":{"id":"01a1aa26-cdee-78c2-82eb-1dada1652ae1","kind":"task"}}}
