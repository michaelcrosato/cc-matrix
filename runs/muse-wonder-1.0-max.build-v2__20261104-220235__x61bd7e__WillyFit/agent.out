{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9b1","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":819,"recorded_at":1780531400001633,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"tool.result","payload_schema_version":1,"payload":{"call_id":"call_01a1aa19211673fda111a77a6811f10f","command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","correlation_facts":{"outcome":"success","tool_name":"bash"},"kind":"tool_result","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"text":"{\n  \"chunk_id\": \"exec-12-1\",\n  \"command\": \"node - << 'JS'\\n// quick lean sim replicating balance.js\\nfunction makeNoise(rng,f){const ph=[rng()*6.28,rng()*6.28,rng()*6.28];return t=>(Math.sin(t*f+ph[0])+.6*Math.sin(t*f*1.73+ph[1])+.35*Math.sin(t*f*2.61+ph[2]))/1.3;}\\nfunction rng(seed){let s=seed>>>0;return()=>{s=(Math.imul(s,1664525)+1013904223)>>>0;return s/4294967296;};}\\nfunction sim(params, skill, seed){\\n  const r=rng(seed); const nx=makeNoise(r,params.nf), ny=makeNoise(r,params.nf*0.9);\\n  let px=0,py=0,vx=0,vy=0,t=0, falls=0, inR=0, steps=0, stumble=0;\\n  const BOTS={passive:{tau:9,gain:0,damp:0,noise:0},poor:{tau:.34,gain:1.1,damp:.22,noise:.16},average:{tau:.25,gain:1.4,damp:.30,noise:.08},good:{tau:.18,gain:1.8,damp:.36,noise:.04},expert:{tau:.14,gain:2.2,damp:.42,noise:.02}};\\n  const cfg=BOTS[skill]; const br=rng(seed+99); const bnx=makeNoise(br,0.7), bny=makeNoise(br,0.6);\\n  const hist=[]; let ux=0,uy=0; const dt=1/120, ring={x:0,y:0};\\n  for(let i=0;i<45/dt;i++){\\n    t+=dt;\\n    hist.push({px,py,vx,vy,t}); while(hist.length&&hist[0].t<t-cfg.tau-0.2)hist.shift();\\n    let seen=hist[0]||{px,py,vx,vy,t};\\n    for(const h of hist) if(Math.abs(h.t-(t-cfg.tau))<Math.abs(seen.t-(t-cfg.tau))) seen=h;\\n    let tx=ring.x+(-cfg.gain*(seen.px-ring.x)-cfg.damp*seen.vx)*0.6+cfg.noise*bnx(t);\\n    let ty=ring.y+(-cfg.gain*(seen.py-ring.y)-cfg.damp*seen.vy)*0.6+cfg.noise*bny(t);\\n    if(skill==='passive'){tx=0;ty=0;}\\n    ux+=(tx-ux)*Math.min(1,dt*16); uy+=(ty-uy)*Math.min(1,dt*16);\\n    const l=Math.hypot(ux,uy); if(l>1){ux/=l;uy/=l;}\\n    if(stumble>0){stumble-=dt; px+=(0-px)*Math.min(1,dt*4); py+=(0-py)*Math.min(1,dt*4); vx=0;vy=0;}\\n    else{\\n      const ax=params.k*(ux-px)-params.c*vx+params.s*px+params.A*nx(t);\\n      const ay=params.k*(uy-py)-params.c*vy+params.s*py+params.A*ny(t);\\n      vx+=ax*dt; vy+=ay*dt; px+=vx*dt; py+=vy*dt;\\n      if(Math.hypot(px,py)>=1){stumble=1;falls++;px*=0.3;py*=0.3;vx=0;vy=0;}\\n    }\\n    steps++; if(Math.hypot(px-ring.x,py-ring.y)<=params.R) inR++;\\n  }\\n  return {steady:+(inR/steps).toFixed(3), falls};\\n}\\nconst sets={BodyCheck:{k:14,c:7,s:4,A:3,nf:1.1,R:.20},Stork1:{k:12,c:5,s:13,A:3,nf:1.5,R:.24},SunFlow:{k:12,c:6,s:6,A:3.2,nf:1.3,R:.28}};\\nfor(const n in sets){ for(const sk of ['passive','poor','average','good']){ const rs=[1,2,3].map(s=>sim(sets[n],sk,s*7)); console.log(n,sk, rs.map(r=>r.steady+'/'+r.falls).join(' ')); } }\\nJS\",\n  \"description\": \"Simulate lean bands quickly\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"BodyCheck passive 0.465/0 0.508/0 0.436/0\\nBodyCheck poor 0.615/0 0.738/0 0.639/0\\nBodyCheck average 0.853/0 0.943/0 0.872/0\\nBodyCheck good 0.984/0 0.996/0 0.982/0\\nStork1 passive 0.319/5 0.225/5 0.275/4\\nStork1 poor 0.246/0 0.26/0 0.195/1\\nStork1 average 0.438/0 0.423/0 0.392/0\\nStork1 good 0.616/0 0.62/0 0.607/0\\nSunFlow passive 0.46/0 0.498/0 0.446/0\\nSunFlow poor 0.654/0 0.597/0 0.717/0\\nSunFlow average 0.912/0 0.863/0 0.915/0\\nSunFlow good 0.993/0 0.991/0 0.988/0\\n\",\n  \"original_output_bytes\": 463,\n  \"original_output_tokens\": 116,\n  \"truncated\": false\n}"}}
