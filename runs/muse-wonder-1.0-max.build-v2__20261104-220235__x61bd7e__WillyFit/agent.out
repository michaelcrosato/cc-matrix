{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb99","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":1063,"recorded_at":1780531400002121,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"Read text file `WillyFit-WiiFit-muse-wonder-1.0-max-20261104-220235/game/activities/rep.js`.\n(83 line(s) above)\n84|        // instructor mirrors bead\n85|        if (ctx.instructorRig) {\n86|          const bead = self.beadAt(ctx, ctx.contestants[0]);\n87|          if (self.horizontal) { ctx.instructorRig.body = G.sideLungeBody(bead * 2 - 1); ctx.instructorRig.mocap = null; }\n88|          else if (self.clipInfo) {\n89|            const c2 = G.clip(self.clipInfo.clip); const L = G.getLib();\n90|            if (c2 && L) { const tt = self.clipInfo.t0 + (self.clipInfo.t1 - self.clipInfo.t0) * bead; try { ctx.instructorRig.mocap = L.sample(c2, tt); } catch (e) {} }\n91|          }\n92|        }\n93|      },\n94|      result(ctx) {\n95|        const c = ctx.contestants[0];\n96|        const mean = c.scores.length ? c.scores.reduce((a, b) => a + b, 0) / c.scores.length : 0;\n97|        const form = c.formN ? c.formSum / c.formN : 0;\n98|        let pct = mean * (1 - Math.min(0.3, form * 0.5));\n99|        if (c.bot) pct = mean; // bots judged on rep score directly\n100|        return { pct: clamp(pct, 0, 1), detail: c.scores.length + ' reps · form ' + Math.round((1 - Math.min(1, form)) * 100) + '%' };\n101|      },\n102|      ghost(ctx) { const c = ctx.contestants[0]; return { l: [c.bal.p.x, c.bal.p.y], s: Math.round((c._depth || 0) * 100) }; }\n103|    };\n104|  }\n105|  G.activity(repActivity('squat', 'Squat Rail', 'Lean down to squat, up to stand. Follow the bead. Your lean is your body.', 'down', { clip: '22_14', t0: 1.1, t1: 1.72 }, 8, 12, false));\n106|  G.activity(repActivity('pushup', 'Push-Up', 'Lean down low, push back up. Follow the bead. The floor is patient.', 'down', { clip: 'Pushup', frac: 0.5 }, 6, 10, false));\n107|  G.activity(repActivity('lunge', 'Side Lunge', 'Lean left and right along the rail. Feet stay. Pride wobbles.', 'side', null, 8, 12, true));\n108|})();","final_result":true,"kind":"output","task_id":"01a1aa1a-0b87-78e2-8ed9-ba017e464b99"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa1a-0b87-78e2-8ed9-ba017e464b99","task_stream":{"id":"01a1aa1a-0b87-78e2-8ed9-ba017e464b99","kind":"task"}}}
