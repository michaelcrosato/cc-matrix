e.log(q, '=>', r.pass ? 'PASS' : 'FAIL', JSON.stringify(r.bad).slice(0,300));\\n  await hp.close();\\n}\\nawait browser.close(); srv.kill('SIGTERM');\\nEOF\\ntimeout 280 node tests/probe2.mjs 2>&1 | tail -6\",\n  \"description\": \"Test hub 2p 4p host-leave variants\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"players=2&auto=1 => FAIL [\\\"ghost: every copy sends its player: p0 ↑0 p1 ↑0\\\"]\\nplayers=4&latency=150&jitter=50&loss=5&auto=1 => FAIL [\\\"ghost: every copy sends its player: p0 ↑0 p1 ↑0 p2 ↑0\\\"]\\nplayers=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave => FAIL [\\\"ghost: every copy sends its player: p1 ↑0 p2 ↑0 p3 ↑0\\\"]\\n\",\n  \"original_output_bytes\": 337,\n  \"original_output_tokens\": 85,\n  \"truncated\": false\n}"}}
