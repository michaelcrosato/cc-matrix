{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9df","stream":{"kind":"session","id":"01a1aa16-6120-7543-8e87-aff60485fd0b"},"sequence":842,"recorded_at":1780531400001679,"record_type":"event","durability":"durable","causation_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","event":{"chunk":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"node - << 'JS'\\nfunction makeNoise(rng,f){const ph=[rng()*6.28,rng()*6.28,rng()*6.28];return t=>(Math.sin(t*f+ph[0])+.6*Math.sin(t*f*1.73+ph[1])+.35*Math.sin(t*f*2.61+ph[2]))/1.3;}\\nfunction rng(seed){let s=seed>>>0;return()=>{s=(Math.imul(s,1664525)+1013904223)>>>0;return s/4294967296;};}\\nfunction sim(params, skill, seed, F){\\n  const r=rng(seed); const nx=makeNoise(r,params.nf), ny=makeNoise(r,params.nf*0.9);\\n  let px=0,py=0,vx=0,vy=0,t=0, falls=0, inR=0, steps=0, stumble=0;\\n  const BOTS={passive:{tau:9,gain:0,damp:0,noise:0},poor:{tau:.34,gain:1.1,damp:.22,noise:.16},average:{tau:.25,gain:1.4,damp:.30,noise:.08},good:{tau:.18,gain:1.8,damp:.36,noise:.04},expert:{tau:.14,gain:2.2,damp:.42,noise:.02}};\\n  const cfg=BOTS[skill]; const br=rng(seed+99); const bnx=makeNoise(br,0.7), bny=makeNoise(br,0.6);\\n  const hist=[]; let ux=0,uy=0; const dt=1/120, ring={x:0,y:0};\\n  for(let i=0;i<45/dt;i++){\\n    t+=dt;\\n    hist.push({px,py,vx,vy,t}); while(hist.length&&hist[0].t<t-cfg.tau-0.2)hist.shift();\\n    let seen=hist[0]||{px,py,vx,vy,t};\\n    for(const h of hist) if(Math.abs(h.t-(t-cfg.tau))<Math.abs(seen.t-(t-cfg.tau))) seen=h;\\n    let tx=ring.x+(-cfg.gain*(seen.px-ring.x)-cfg.damp*seen.vx)*F+cfg.noise*bnx(t);\\n    let ty=ring.y+(-cfg.gain*(seen.py-ring.y)-cfg.damp*seen.vy)*F+cfg.noise*bny(t);\\n    if(skill==='passive'){tx=0;ty=0;}\\n    ux+=(tx-ux)*Math.min(1,dt*16); uy+=(ty-uy)*Math.min(1,dt*16);\\n    const l=Math.hypot(ux,uy); if(l>1){ux/=l;uy/=l;}\\n    if(stumble>0){stumble-=dt; px+=(0-px)*Math.min(1,dt*4); py+=(0-py)*Math.min(1,dt*4); vx=0;vy=0;}\\n    else{\\n      const ax=params.k*(ux-px)-params.c*vx+params.s*px+params.A*nx(t);\\n      const ay=params.k*(uy-py)-params.c*vy+params.s*py+params.A*ny(t);\\n      vx+=ax*dt; vy+=ay*dt; px+=vx*dt; py+=vy*dt;\\n      if(Math.hypot(px,py)>=1){stumble=1;falls++;px*=0.3;py*=0.3;vx=0;vy=0;}\\n    }\\n    steps++; if(Math.hypot(px-ring.x,py-ring.y)<=params.R) inR++;\\n  }\\n  return {steady:+(inR/steps).toFixed(3), falls, pct:+((inR/steps)-.05*falls).toFixed(3)};\\n}\\nconst sets={Stork1:{k:12,c:5,s:13,A:3,nf:1.5,R:.24},Stork2:{k:11,c:4.5,s:15,A:3.6,nf:1.7,R:.22},Candle:{k:10,c:5,s:11,A:1.4,nf:.8,R:.20},Laundry:{k:10,c:3.5,s:16,A:3.5,nf:1.2,R:.40}};\\nfor(const F of [1.0]){\\n for(const n in sets){ for(const sk of ['passive','average','good','expert']){ const rs=[1,2,3].map(s=>sim(sets[n],sk,s*7,F)); console.log('F'+F,n,sk, rs.map(r=>r.pct+'/'+r.falls).join(' ')); } }\\n}\\nJS\",\n  \"description\": \"Retest bots full authority\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"F1 Stork1 passive 0.069/5 -0.025/5 0.075/4\\nF1 Stork1 average 0.702/0 0.706/0 0.734/0\\nF1 Stork1 good 0.959/0 0.956/0 0.962/0\\nF1 Stork1 expert 1/0 1/0 1/0\\nF1 Stork2 passive -0.25/16 -0.216/16 -0.27/16\\nF1 Stork2 average 0.311/0 0.309/0 0.287/0\\nF1 Stork2 good 0.521/0 0.556/0 0.493/0\\nF1 Stork2 expert 0.763/0 0.791/0 0.805/0\\nF1 Candle passive 0.016/6 -0.03/7 -0.007/5\\nF1 Candle average 0.934/0 0.965/0 0.958/0\\nF1 Candle good 1/0 1/0 1/0\\nF1 Candle expert 1/0 1/0 1/0\\nF1 Laundry passive -0.24/21 -0.244/21 -0.251/21\\nF1 Laundry average 0.399/2 0.393/2 0.33/2\\nF1 Laundry good 0.8/0 0.821/0 0.811/0\\nF1 Laundry expert 1/0 1/0 0.99/0\\n\",\n  \"original_output_bytes\": 623,\n  \"original_output_tokens\": 156,\n  \"truncated\": false\n}","final_result":true,"kind":"output","task_id":"01a1aa19-455a-76a0-a252-aacd96949b91"},"kind":"task_lifecycle","run_stream":{"id":"01a1aa16-642f-7fb0-a5fe-8d2aa3acfb85","kind":"run"},"task_id":"01a1aa19-455a-76a0-a252-aacd96949b91","task_stream":{"id":"01a1aa19-455a-76a0-a252-aacd96949b91","kind":"task"}}}
