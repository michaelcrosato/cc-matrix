ist/${game}`, players: n, latency: 150, jitter: 50, loss: 5, auto: 1, scenario, play: 8000 });\n  const t0 = Date.now();\n  await page.goto(`${base}/harness.html?${q}`);\n  const done = await page.waitForSelector('body[data-complete=\"true\"]', { timeout: 280000 }).then(() => true, () => false);\n  const rep = await page.evaluate(() => window.__hubCheck).catch(() => null);\n  const ev = await page.evaluate(() => [...document.querySelectorAll('iframe')].map((f) => { try { const s = f.contentWindow.__sess; const sp = f.contentWindow.__spike; return { events: s?.events, sent: s?.sent, got: s?.got, backend: sp?.backend, frames: sp?.frames, gpuErr: sp?.gpuErrors?.length, lost: sp?.deviceLost }; } catch (e) { return String(e); } })).catch(() => []);\n  const failed = (rep?.checks || []).filter((c) => !c.pass);\n  allPass &&= done && rep?.pass && !warns.length;\n  console.log(`${rep?.pass ? 'PASS' : 'FAIL'} players=${n} ${scenario} in ${Math.round((Date.now() - t0) / 1000)}s done=${done} warns=${warns.length}`);\n  for (const c of failed) console.log('   ✗', c.name, '—', String(c.detail).slice(0, 300));\n  if (process.env.VERBOSE) for (const c of rep?.checks || []) console.log('   ', c.pass ? '✓' : '✗', c.name);\n  console.log('   copies:', JSON.stringify(ev).slice(0, 1500));\n  await ctx.close();\n}\nawait browser.close();\nserver.close();\nconsole.log(allPass ? 'ALL PASS' : 'SOME FAILED');\n"}}}
