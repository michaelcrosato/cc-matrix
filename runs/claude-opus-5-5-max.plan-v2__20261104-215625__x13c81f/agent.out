{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013NXXRnHyqxJ3WtCj37PrDN","type":"tool_result","content":"#!/usr/bin/env node\n/**\n * hub-check.mjs — does a game keep the AI Hub Session Protocol?\n *\n * Runs lib/hub/harness.html?auto=1 against each game, at the player counts its\n * hub:session-players allows: hello, ready under the hub's card with no key\n * press, the start, traffic, a player leaving, time-up and a valid result. Then\n * once more with the host leaving. Then the game on its own, outside a session:\n * it opens, Enter and Space are pressed, and it must draw its screen with no\n * errors, the session client inactive and Math.random left alone. Before any\n * game script runs, every frame in session mode gets alert, confirm, prompt,\n * window.open and socket constructors wrapped, so calling them is caught.\n * Needs Playwright, which is not a dependency (see shots.mjs).\n *\n * Parallel is played at 1 and 2 players: nothing is shared, so more copies\n * prove nothing more. Its checks expect Math.random seeded the same on every\n * copy, progress from every copy, and no game traffic.\n *\n * Ghost and shared world are played at 2, 3 and 4 players on a poor network\n * (150 ± 50 ms, 5% loss). Ghost is checked like parallel, except that every\n * copy sends its player. A shared world wants traffic both ways, and is\n * played once more at 2 players with its world hosted by one more copy that\n * has no player of its own, as a dedicated server would host it (README,\n * \"Shared world\"). That run is reported like any; --record does not hold it\n * against a game, since no server runs yet.\n *\n * --retrofit is for an existing game upgraded to parallel: it is played once,\n * at 2 players with one of them leaving. With --original <path>, errors the\n * original page already had are forgiven when it is opened on its own.\n * --draws-only does only that last part, for any page: the retrofit runs it on\n * a game before spending a model on it, since a page this browser cannot run\n * cannot be checked here. A WebGPU-only game without WebGPU is caught even\n * when its title screen shows: it asked for an adapter, got none, and drew\n * nothing with WebGL or a 2D canvas instead. --browser-args passes flags to\n * Chromium; on a machine without a GPU, SwiftShader gives such games a\n * software adapter:\n *   --browser-args \"--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader\"\n *\n * Every game's pasted client is also read from disk and must be exactly a\n * released one (scripts/lib/hub-client.mjs).\n *\n * --record writes the outcome into data/overrides.json, which is how the hub\n * keeps a failing game out of sessions: a game that fails gets \"session\": \"0\"\n * (it overrides the game's own hub:session meta, so Random Mode never deals\n * it) and a sessionNote naming what failed; a game that passes loses both.\n *\n * Usage:  node scripts/hub-check.mjs [game paths…] [--players 2,3,4] [--base URL] [--json] [--no-solo]\n *                                    [--retrofit [--original <path>]] [--draws-only] [--record] [--browser-args \"<flags>\"]\n *         (games default to the three examples in lib/hub/examples/)\n */\n\nimport { createServer } from 'node:http';\nimport { createRequire } from 'node:module';\nimport { mkdir, readdir, readFile, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { staticHandler } from './lib/serve.mjs';\nimport { modeOf, SELF_REPORTED } from '../lib/hub/round.js';\nimport { findClients } from './lib/hub-client.mjs';\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst EXAMPLES = ['/lib/hub/examples/arena.html', '/lib/hub/examples/ghost.html', '/lib/hub/examples/parallel.html'];\nconst PAGE_MS = 300_000;\n\nconst args = process.argv.slice(2);\nconst option = (name, fallback) => {\n  const at = args.indexOf(`--${name}`);\n  if (at === -1) return fallback;\n  const [value] = args.splice(at, 2).slice(1);\n  return value;\n};\nconst asked = option('players', null);\nlet base = option('base', null);\nconst original = option('original', null);\nconst asJson = args.includes('--json');\nconst solo = !args.includes('--no-solo');\nconst retrofit = args.includes('--retrofit');\nconst drawsOnly = args.includes('--draws-only');\nconst record = args.includes('--record');\n/** Extra flags for the browser, e.g. the ones that give it WebGPU where the machine can (lib/kit/README.md). */\nconst browserArgs = (option('browser-args', '') || '').split(/\\s+/).filter(Boolean);\nconst asPath = (g) => (g.startsWith('/') || /^https?:/.test(g) ? g : `/${g}`);\nconst games = args.filter((a) => !a.startsWith('--')).map(asPath);\nif (!games.length) games.push(...EXAMPLES);\n\n/**\n * The player counts to try: as asked, or by the game's mode, within the seats\n * the game takes. Parallel shares nothing, so 1 and 2 say it all.\n */\nfunction countsFor(mode, [least, most]) {\n  const list = asked ?? (mode === 'parallel' ? '1,2' : '2,3,4');\n  return list.split(',').map(Number).filter((n) => n >= 1 && n <= 4 && (asked || (n >= least && n <= most)));\n}\n\n/** The game's session mode (older tags read as today's) and its seats, from its head. */\nasync function headOf(game) {\n  try {\n    const html = await (await fetch(/^https?:/.test(game) ? game : `${base}${game}`)).text();\n    const meta = (name) => html.match(new RegExp(`<meta\\\\s+name=[\"']${name}[\"']\\\\s+content=[\"']([^\"']+)[\"']`, 'i'))?.[1] ?? null;\n    const [least = 1, most = least] = (meta('hub:session-players')?.match(/\\d+/g) ?? []).map(Number);\n    return { mode: modeOf(meta('hub:session-mode')), seats: [least, most] };\n  } catch {\n    return { mode: null, seats: [1, 4] };\n  }\n}\n\nlet chromium;\ntry {\n  ({ chromium } = createRequire(import.meta.url)('playwright'));\n} catch {\n  console.error('hub-check needs Playwright: pnpm add -D playwright && pnpm exec playwright install chromium');\n  process.exit(2);\n}\n\n/**\n * Runs in every frame before its own scripts: it notes what the page asks of\n * the graphics stack, and session-mode pages are watched for dialogs and sockets.\n */\nfunction watch() {\n  // What the page asked of the graphics stack: a WebGPU adapter it never got, and\n  // no WebGL drawing instead, means this browser cannot run it (a title screen may still show).\n  const gfx = (window.__gfx = { askedForWebGPU: false, gotAdapter: false, webgl: false, twoD: false });\n  if (navigator.gpu?.requestAdapter) {\n    const ask = navigator.gpu.requestAdapter.bind(navigator.gpu);\n    Object.defineProperty(navigator.gpu, 'requestAdapter', {\n      configurable: true,\n      writable: true,\n      value: async (...a) => {\n        gfx.askedForWebGPU = true;\n        const adapter = await ask(...a);\n        if (adapter) gfx.gotAdapter = true;\n        return adapter;\n      },\n    });\n  }\n  for (const Canvas of [window.HTMLCanvasElement, window.OffscreenCanvas].filter(Boolean)) {\n    const getContext = Canvas.prototype.getContext;\n    Canvas.prototype.getContext = function (type, ...rest) {\n      const context = getContext.call(this, type, ...rest);\n      if (context && /^(webgl2?|experimental-webgl)$/.test(type)) gfx.webgl = true;\n      if (context && type === '2d') gfx.twoD = true;\n      return context;\n    };\n  }\n\n  if (!/[?&]aihub=/.test(location.search)) return;\n  const seen = (window.__hubViolations = []);\n  for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n    window[name] = () => {\n      seen.push(`${name}() called`);\n      return name === 'confirm' ? false : null;\n    };\n  }\n  for (const name of ['WebSocket', 'RTCPeerConnection', 'EventSource']) {\n    const Original = window[name];\n    if (!Original) continue;\n    window[name] = function (...a) {\n      seen.push(`${name} opened in a session (${String(a[0]).slice(0, 80)})`);\n      return new Original(...a);\n    };\n  }\n  addEventListener('error', (e) => seen.push(`error: ${e.message}`));\n  addEventListener('unhandledrejection', (e) => seen.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n}\n\nlet server = null;\nif (!base) {\n  server = createServer(staticHandler(ROOT));\n  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));\n  base = `http://127.0.0.1:${server.address().port}`;\n}\n\nconst browser = await chromium.launch({ headless: true, executablePath: process.env.CHROMIUM_PATH, args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required', ...browserArgs] });\nconst runs = [];\ntry {\n  for (const game of games) {\n    if (drawsOnly) {\n      const report = await stillWorks(game, null, { bare: true });\n      runs.push({ game, players: 1, scenario: 'draws', pass: report.pass, checks: report.checks });\n      if (!asJson) console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  draws on its own`);\n      continue;\n    }\n    const client = await clientCheck(game);\n    if (client) {\n      runs.push({ game, players: 0, scenario: 'static', pass: client.pass, checks: [client] });\n      if (!asJson && !client.pass) console.log(`FAIL  ${game}  ✗ ${client.name} — ${client.detail}`);\n    }\n    const { mode, seats } = await headOf(game);\n    const counts = countsFor(mode, seats);\n    // A retrofit is played once, at 2 players with one leaving: nothing is shared, so that says it all.\n    const plan = retrofit && !asked ? [] : counts.map((n) => ({ n, scenario: 'standard' }));\n    const leaving = retrofit && !asked ? 2 : Math.max(2, Math.min(3, Math.max(...counts, 0)));\n    if (asked || leaving <= seats[1]) plan.push({ n: leaving, scenario: 'host-leave' });\n    // A shared world must also run on a copy with no player of its own, as a server would run it.\n    if (!retrofit && mode && !SELF_REPORTED.includes(mode) && (asked || (seats[0] <= 2 && seats[1] >= 2))) plan.push({ n: 2, scenario: 'server' });\n    for (const { n, scenario } of plan) {\n      const context = await browser.newContext({ viewport: { width: 1280, height: 860 } });\n      await context.addInitScript(watch);\n      const page = await context.newPage();","is_error":false}]},"parent_tool_use_id":null,"session_id":"9db0da04-284f-40b5-8e80-2e3f7ed2ab1c","uuid":"e3f3e94b-b42e-4c33-bf54-ba9903b47079","timestamp":"2026-11-05T05:00:11.574Z","tool_use_result":{"stdout":"#!/usr/bin/env node\n/**\n * hub-check.mjs — does a game keep the AI Hub Session Protocol?\n *\n * Runs lib/hub/harness.html?auto=1 against each game, at the player counts its\n * hub:session-players allows: hello, ready under the hub's card with no key\n * press, the start, traffic, a player leaving, time-up and a valid result. Then\n * once more with the host leaving. Then the game on its own, outside a session:\n * it opens, Enter and Space are pressed, and it must draw its screen with no\n * errors, the session client inactive and Math.random left alone. Before any\n * game script runs, every frame in session mode gets alert, confirm, prompt,\n * window.open and socket constructors wrapped, so calling them is caught.\n * Needs Playwright, which is not a dependency (see shots.mjs).\n *\n * Parallel is played at 1 and 2 players: nothing is shared, so more copies\n * prove nothing more. Its checks expect Math.random seeded the same on every\n * copy, progress from every copy, and no game traffic.\n *\n * Ghost and shared world are played at 2, 3 and 4 players on a poor network\n * (150 ± 50 ms, 5% loss). Ghost is checked like parallel, except that every\n * copy sends its player. A shared world wants traffic both ways, and is\n * played once more at 2 players with its world hosted by one more copy that\n * has no player of its own, as a dedicated server would host it (README,\n * \"Shared world\"). That run is reported like any; --record does not hold it\n * against a game, since no server runs yet.\n *\n * --retrofit is for an existing game upgraded to parallel: it is played once,\n * at 2 players with one of them leaving. With --original <path>, errors the\n * original page already had are forgiven when it is opened on its own.\n * --draws-only does only that last part, for any page: the retrofit runs it on\n * a game before spending a model on it, since a page this browser cannot run\n * cannot be checked here. A WebGPU-only game without WebGPU is caught even\n * when its title screen shows: it asked for an adapter, got none, and drew\n * nothing with WebGL or a 2D canvas instead. --browser-args passes flags to\n * Chromium; on a machine without a GPU, SwiftShader gives such games a\n * software adapter:\n *   --browser-args \"--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader\"\n *\n * Every game's pasted client is also read from disk and must be exactly a\n * released one (scripts/lib/hub-client.mjs).\n *\n * --record writes the outcome into data/overrides.json, which is how the hub\n * keeps a failing game out of sessions: a game that fails gets \"session\": \"0\"\n * (it overrides the game's own hub:session meta, so Random Mode never deals\n * it) and a sessionNote naming what failed; a game that passes loses both.\n *\n * Usage:  node scripts/hub-check.mjs [game paths…] [--players 2,3,4] [--base URL] [--json] [--no-solo]\n *                                    [--retrofit [--original <path>]] [--draws-only] [--record] [--browser-args \"<flags>\"]\n *         (games default to the three examples in lib/hub/examples/)\n */\n\nimport { createServer } from 'node:http';\nimport { createRequire } from 'node:module';\nimport { mkdir, readdir, readFile, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { staticHandler } from './lib/serve.mjs';\nimport { modeOf, SELF_REPORTED } from '../lib/hub/round.js';\nimport { findClients } from './lib/hub-client.mjs';\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst EXAMPLES = ['/lib/hub/examples/arena.html', '/lib/hub/examples/ghost.html', '/lib/hub/examples/parallel.html'];\nconst PAGE_MS = 300_000;\n\nconst args = process.argv.slice(2);\nconst option = (name, fallback) => {\n  const at = args.indexOf(`--${name}`);\n  if (at === -1) return fallback;\n  const [value] = args.splice(at, 2).slice(1);\n  return value;\n};\nconst asked = option('players', null);\nlet base = option('base', null);\nconst original = option('original', null);\nconst asJson = args.includes('--json');\nconst solo = !args.includes('--no-solo');\nconst retrofit = args.includes('--retrofit');\nconst drawsOnly = args.includes('--draws-only');\nconst record = args.includes('--record');\n/** Extra flags for the browser, e.g. the ones that give it WebGPU where the machine can (lib/kit/README.md). */\nconst browserArgs = (option('browser-args', '') || '').split(/\\s+/).filter(Boolean);\nconst asPath = (g) => (g.startsWith('/') || /^https?:/.test(g) ? g : `/${g}`);\nconst games = args.filter((a) => !a.startsWith('--')).map(asPath);\nif (!games.length) games.push(...EXAMPLES);\n\n/**\n * The player counts to try: as asked, or by the game's mode, within the seats\n * the game takes. Parallel shares nothing, so 1 and 2 say it all.\n */\nfunction countsFor(mode, [least, most]) {\n  const list = asked ?? (mode === 'parallel' ? '1,2' : '2,3,4');\n  return list.split(',').map(Number).filter((n) => n >= 1 && n <= 4 && (asked || (n >= least && n <= most)));\n}\n\n/** The game's session mode (older tags read as today's) and its seats, from its head. */\nasync function headOf(game) {\n  try {\n    const html = await (await fetch(/^https?:/.test(game) ? game : `${base}${game}`)).text();\n    const meta = (name) => html.match(new RegExp(`<meta\\\\s+name=[\"']${name}[\"']\\\\s+content=[\"']([^\"']+)[\"']`, 'i'))?.[1] ?? null;\n    const [least = 1, most = least] = (meta('hub:session-players')?.match(/\\d+/g) ?? []).map(Number);\n    return { mode: modeOf(meta('hub:session-mode')), seats: [least, most] };\n  } catch {\n    return { mode: null, seats: [1, 4] };\n  }\n}\n\nlet chromium;\ntry {\n  ({ chromium } = createRequire(import.meta.url)('playwright'));\n} catch {\n  console.error('hub-check needs Playwright: pnpm add -D playwright && pnpm exec playwright install chromium');\n  process.exit(2);\n}\n\n/**\n * Runs in every frame before its own scripts: it notes what the page asks of\n * the graphics stack, and session-mode pages are watched for dialogs and sockets.\n */\nfunction watch() {\n  // What the page asked of the graphics stack: a WebGPU adapter it never got, and\n  // no WebGL drawing instead, means this browser cannot run it (a title screen may still show).\n  const gfx = (window.__gfx = { askedForWebGPU: false, gotAdapter: false, webgl: false, twoD: false });\n  if (navigator.gpu?.requestAdapter) {\n    const ask = navigator.gpu.requestAdapter.bind(navigator.gpu);\n    Object.defineProperty(navigator.gpu, 'requestAdapter', {\n      configurable: true,\n      writable: true,\n      value: async (...a) => {\n        gfx.askedForWebGPU = true;\n        const adapter = await ask(...a);\n        if (adapter) gfx.gotAdapter = true;\n        return adapter;\n      },\n    });\n  }\n  for (const Canvas of [window.HTMLCanvasElement, window.OffscreenCanvas].filter(Boolean)) {\n    const getContext = Canvas.prototype.getContext;\n    Canvas.prototype.getContext = function (type, ...rest) {\n      const context = getContext.call(this, type, ...rest);\n      if (context && /^(webgl2?|experimental-webgl)$/.test(type)) gfx.webgl = true;\n      if (context && type === '2d') gfx.twoD = true;\n      return context;\n    };\n  }\n\n  if (!/[?&]aihub=/.test(location.search)) return;\n  const seen = (window.__hubViolations = []);\n  for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n    window[name] = () => {\n      seen.push(`${name}() called`);\n      return name === 'confirm' ? false : null;\n    };\n  }\n  for (const name of ['WebSocket', 'RTCPeerConnection', 'EventSource']) {\n    const Original = window[name];\n    if (!Original) continue;\n    window[name] = function (...a) {\n      seen.push(`${name} opened in a session (${String(a[0]).slice(0, 80)})`);\n      return new Original(...a);\n    };\n  }\n  addEventListener('error', (e) => seen.push(`error: ${e.message}`));\n  addEventListener('unhandledrejection', (e) => seen.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n}\n\nlet server = null;\nif (!base) {\n  server = createServer(staticHandler(ROOT));\n  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));\n  base = `http://127.0.0.1:${server.address().port}`;\n}\n\nconst browser = await chromium.launch({ headless: true, executablePath: process.env.CHROMIUM_PATH, args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required', ...browserArgs] });\nconst runs = [];\ntry {\n  for (const game of games) {\n    if (drawsOnly) {\n      const report = await stillWorks(game, null, { bare: true });\n      runs.push({ game, players: 1, scenario: 'draws', pass: report.pass, checks: report.checks });\n      if (!asJson) console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  draws on its own`);\n      continue;\n    }\n    const client = await clientCheck(game);\n    if (client) {\n      runs.push({ game, players: 0, scenario: 'static', pass: client.pass, checks: [client] });\n      if (!asJson && !client.pass) console.log(`FAIL  ${game}  ✗ ${client.name} — ${client.detail}`);\n    }\n    const { mode, seats } = await headOf(game);\n    const counts = countsFor(mode, seats);\n    // A retrofit is played once, at 2 players with one leaving: nothing is shared, so that says it all.\n    const plan = retrofit && !asked ? [] : counts.map((n) => ({ n, scenario: 'standard' }));\n    const leaving = retrofit && !asked ? 2 : Math.max(2, Math.min(3, Math.max(...counts, 0)));\n    if (asked || leaving <= seats[1]) plan.push({ n: leaving, scenario: 'host-leave' });\n    // A shared world must also run on a copy with no player of its own, as a server would run it.\n    if (!retrofit && mode && !SELF_REPORTED.includes(mode) && (asked || (seats[0] <= 2 && seats[1] >= 2))) plan.push({ n: 2, scenario: 'server' });\n    for (const { n, scenario } of plan) {\n      const context = await browser.newContext({ viewport: { width: 1280, height: 860 } });\n      await context.addInitScript(watch);\n      const page = await context.newPage();","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013NXXRnHyqxJ3WtCj37PrDN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjC1iMhQwPVBfpvYvB3X","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GK7LTGzmyZy8g4rgUk6Bq2","name":"Bash","input":{"command":"gh api repos/michaelcrosato/ai-hub/contents/lib/hub/harness.html --jq '.content' | base64 -d | sed -n '60,200p'","description":"Read the harness setup, timings and instrumentation"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13652,"cache_read_input_tokens":56871,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13652},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9db0da04-284f-40b5-8e80-2e3f7ed2ab1c","uuid":"e5fae522-0a10-4521-ac83-b83a4c8fd519","timestamp":"2026-11-05T05:00:11.961Z","request_id":"req_011CgjC1i6KjvwLkawuRCA3S","wire_tool_inputs":{"toolu_01GK7LTGzmyZy8g4rgUk6Bq2":{"command":"gh api repos/michaelcrosato/ai-hub/contents/lib/hub/harness.html --jq '.content' | base64 -d | sed -n '60,200p'","description":"Read the harness setup, timings and instrumentation"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GK7LTGzmyZy8g4rgUk6Bq2","type":"tool_result","content":"    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n  Object.assign(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n  }\n  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n  const metas = await metasOf(game);\n  const mode = modeOf(metas?.mode);\n  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n  const seed = params.has('seed') ? Number(params.get('seed')) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];\n  const round = ++roundNo;\n  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n  const hubEnd = net.endpoint('hub');\n  const grid = $('grid');\n  grid.replaceChildren();\n  const copies = n + (serverMode ? 1 : 0);\n  grid.style.gridTemplateColumns = copies > 1 ? '1fr 1fr' : '1fr';\n  grid.style.gridTemplateRows = `repeat(${Math.ceil(copies / (copies > 1 ? 2 : 1))}, 1fr)`;\n\n  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(), more: new Set() } };\n  current = state;\n  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n\n  state.coordinator = createRound({\n    round,\n    players,\n    hostKey: 'p0',\n    serverKey: serverMode ? 'server' : null,\n    mode,\n    seed,\n    limitMs,\n    gate: true,\n    deliver: (key, m) => hubEnd.send(key, { k: 'h', r: round, m }),\n    onStatus: (s) => { state.status = s; render(state); },\n    onEnd: (record) => {\n      state.record = record;\n      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n      render(state);\n    },","is_error":false}]},"parent_tool_use_id":null,"session_id":"9db0da04-284f-40b5-8e80-2e3f7ed2ab1c","uuid":"d32be95a-0447-4b6c-8f7a-5c8cfb1e4e78","timestamp":"2026-11-05T05:00:12.421Z","tool_use_result":{"stdout":"    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log'