'=> pass:', await page.evaluate(() => window.__hubCheck && window.__hubCheck.pass)); await b.close();\nEOF\nfor q in 'players=2&auto=1' 'players=4&latency=150&jitter=50&loss=5&auto=1' 'players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave'; do node tools/hubcheck.mjs $PORT \"$q\" 90; done; kill $SP\nH=../Bentou2-Tenchu2-claude-sonnet-5-5-medium-20261103-183530.html; sed -i \"s#../pw#../pw#\" tools/eval.mjs 2>/dev/null; cd ..; rm -rf Bentou2-*/hubcheck Bentou2-*/pw Bentou2-*/tmp Bentou2-*/shots; python3 -c \"import json;json.load(open('exit-interview.json'));print('json ok')\""}}}
