t},\n\t\t\t\t\t{ y: Math.round(game.H / 2 - 10) },\n\t\t\t\t);\n\t\t\t},\n\t\t\tupdate(dt) {\n\t\t\t\tpainter.fit();\n\t\t\t\tpainter.update(null, dt);\n\t\t\t\tif (game.input.anyPressed() || Math.hypot(...game.input.move()) > 0.25)\n\t\t\t\t\tidle = game.real;\n\t\t\t\tif (!peerPanel && !game.shell.screen) {\n\t\t\t\t\tmenu.update(dt);\n\t\t\t\t\tif (game.real - idle >= 10) game.go(\"attract\", null, { fade: 0 });\n\t\t\t\t}\n\t\t\t},\n\t\t\tback() {\n\t\t\t\ttoTitle();\n\t\t\t\treturn true;\n\t\t\t},\n\t\t\tdraw(r) {\n\t\t\t\tpainter.floor(r, null);\n\t\t\t\tr.overlay((g) => {\n\t\t\t\t\tPANEL(g, r.W / 2 - 224, r.H / 2 - 100, 448, 235);\n\t\t\t\t\tE.font.title(g, \"BETTER TOGETHER\", r.W / 2, r.H / 2 - 76, {\n\t\t\t\t\t\tscale: 3,\n\t\t\t\t\t\talign: \"center\",\n\t\t\t\t\t\tcolors: [\"#f7edcf\", \"#edc66f\"],\n\t\t\t\t\t});\n\t\t\t\t\tpaint.text(\n\t\t\t\t\t\tg,\n\t\t\t\t\t\t\"Two pads, or WASD + arrows on one keyboard.\",\n\t\t\t\t});\n\t\t\t}\n\t\t\tfor (const f of this.fx) {\n\t\t\t\tconst [x, y] = r.w(f.x || 0, f.y || 0, 0),\n\t\t\t\t\tu = f.life,\n\t\t\t\t\tmotion = this.game.reduceMotion ? 0.25 : 1;\n\t\t\t\tif (f.type === \"ray\" && u < 0.35) {\n\t\t\t\t\tr.overlay((ctx) => {\n\t\t\t\t\t\tconst a = r.w(0, f.y, 0),\n\t\t\t\t\t\t\tb = r.w(384, f.y, 0);\n\t\t\t\t\t\tP.blend(\n\t\t\t\t\t\t\tctx,\n\t\t\t\t\t\t\t(1 - u / 0.35) *\n\t\t\t\t\t\t\t\tMath.max(0.18, this.game.settings.flashes) *\n\t\t\t\t\t\t\t\t(this.game.reduceMotion ? 0.65 : 1),\n\t\t\t\t\t\t\t\"add\",\n\t\t\t\t\t\t\t() => {\n\t\t\t\t\t\t\t\tP.rect(\n\t\t\t\t\t\t\t\t\tctx,\n\t\t\t\t\t\t\t\t\ta[0],\n\t\t\t\t\t\t\t\t\ty - ((w.tuning.rayWidth || 12) * z) / 2,\n\t\t\t\t\t\t\t\t\tb[0] - a[0],\n\t\t\t\t\t\t\t\t\t(w.tuning.rayWidth || 12) * z,\n\t\t\t\t\t\t\t\t\t\"#99844c\",\n\t\t\t\t\t\t\t\t);\n\t\t\t\t\t\t\t\tP.rect(ctx, a[0], y - z, b[0] - a[0], 2 * z, \"#fff5c7\");\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t);\n","exit_code":0,"status":"completed"}}
