ls)\n\t\t\t\t\t\t\ttext(ctx, q.stage, ...r.w(q.x, q.y + 15, 0), \"#eee0fa\", {\n\t\t\t\t\t\t\t\talign: \"center\",\n\t\t\t\t\t\t\t});\n\t\t\t\t});\n\t\t\t}\n\t\t}\n\t\thud(r, w, attract = false) {\n\t\t\tconst g = this.game,\n\t\t\t\tst = NightContent.stages[w.stage],\n\t\t\t\tz = r.view.zoom || 1,\n\t\t\t\t[x, y] = r.w(0, 0, 0),\n\t\t\t\t[x1, y1] = r.w(384, 240, 0);\n\t\t\tr.overlay((ctx) => {\n\t\t\t\tconst compact = r.W < 520;\n\t\t\t\tP.rect(ctx, 0, 0, r.W, compact ? 77 : 45, \"#081c22\");\n\t\t\t\tP.line(\n\t\t\t\t\tctx,\n\t\t\t\t\t16,\n\t\t\t\t\tcompact ? 76 : 44,\n","exit_code":0,"status":"completed"}}
