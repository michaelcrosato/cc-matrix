e></head><body><canvas id=\\\"screen\\\" aria-label=\\\"\"'${meta.title} game\"></canvas><noscript>This game needs JavaScript.</noscript>${scripts}</body></html>`;\nfs.writeFileSync(path.join(root,'\"'index.html'),html);\nfs.writeFileSync(path.join(root,'..',meta.slug+'.html'),html);\nconsole.log(\"'`Built ${meta.slug}.html (${Math.round(Buffer.byteLength(html)/1024)} KiB)`);\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
