{"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"rg -n 'createDataChannel|onDeviceLost|results\\\\(\\\\)|peerPacket|action === \\\"play\\\"|peer-start' src/network.js src/game.js && sed -n '735,805p' src/game.js && sed -n '872,900p' src/game.js\"","aggregated_output":"src/game.js:78:      (d) => this.peerPacket(d),\nsrc/game.js:128:    this.renderer.onDeviceLost = (info) => this.recoverRenderer(info);\nsrc/game.js:500:    if (action === \"play\") {\nsrc/game.js:585:    else if (action === \"peer-start\" && this.peer.connected && this.peer.host) {\nsrc/game.js:650:        `<span class=\"eyebrow accent\">THE LONG-DISTANCE EXPEDITION</span><h2>Send a trail marker.</h2><p>Host: make an invitation and send it to your friend. Friend: paste it below and make a reply. H [... omitted end of long line]\nsrc/game.js:725:    if (this.runners.length === 1 || this.runners.every((r) => r.finished)) this.results();\nsrc/game.js:728:  results() {\nsrc/game.js:874:  peerPacket(d) {\nsrc/game.js:884:      if (this.runners[0]?.finished) this.results();\nsrc/network.js:68:      pc.createDataChannel(\"jungle-jinks\", {\n            : r.relicCount >= 3\n              ? \"B\"\n              : \"C\";\n    this.mode = \"results\";\n    this.modal = \"results\";\n    this.modalBack = \"title\";\n    try {\n      if (!this.best || r.score > this.best.score) {\n        this.best = { score: r.score, time: r.elapsed, relics: r.relicCount };\n        localStorage.setItem(\"jungle-jinks-best\", JSON.stringify(this.best));\n      }\n    } catch {}\n    let race = \"\";\n    if (this.runners.length > 1) {\n      const winner = [...this.runners].sort((a, b) => a.elapsed - b.elapsed)[0];\n      race = `<p class=\"accent\">Explorer ${winner.index + 1} wins the couch race!</p>`;\n    } else if (this.peer.connected) {\n      const other = this.ghosts.get(\"peer\");\n      race = `<p class=\"accent\">${other?.data.finished ? (r.elapsed <= other.data.elapsed ? \"You win the race!\" : \"Your rival wins the race!\") : \"Your rival is still on the trail.\"}</p>`;\n    }\n    this.panel(\n      `<div class=\"result-seal\">${rank}</div><span class=\"eyebrow accent\">EXPEDITION COMPLETE</span><h2>Friend found.<br>Shortcut declined.</h2><p>“Next time,” says Pip, “we take the path.”<br>You both know you won’t.</p>${race}<div class=\"result-grid\"><div class=\"result-stat\"><small>TRAIL TIME</small><b>${timeText(r.elapsed)}</b></div><div class=\"result-stat\"><small>TREASURE</small><b>${r.score.toLocaleString()}</b></div><div class=\"result-stat\"><small>GOLD RELICS</small><b>${r.relicCount} / 12</b></div><div class=\"result-stat\"><small>VINES SWUNG</small><b>${r.swings}</b></div></div><div class=\"menu\"><button class=\"big-btn\" data-action=\"play\">One more questionable shortcut <span>↗</span></button><button class=\"big-btn secondary\" data-action=\"title\">Back to the trailhead <span>←</span></button></div>`,\n    );\n  }\n  showHubWait() {\n    show(\"#titleScreen\", false);\n    show(\"#hubWait\");\n    this.mode = \"hubwaiting\";\n    this.titleAvatar.root.visible = true;\n  }\n  hubEnd() {\n    this.mode = \"hubended\";\n    this.modal = null;\n    show(\"#modalRoot\", false);\n    show(\"#stageBanner\", false);\n    show(\"#hubWait\", false);\n    show(\"#countdown\", false);\n    show(\"#touchUI\", false);\n    this.audio.stop();\n    this.input.enabled = false;\n  }\n  receiveGhost(d, id, info) {\n    if (\n      !Number.isInteger(d.stage) ||\n      d.stage < 0 ||\n      d.stage > 3 ||\n      !Number.isFinite(d.x) ||\n      !Number.isFinite(d.y)\n    )\n      return;\n    let g = this.ghosts.get(id);\n    if (!g) {\n      const color = info?.color || \"#78bbcf\";\n      g = {\n        avatar: makeAvatar(new THREE.Color(color).getHex(), true),\n        data: d,\n        id,\n        name: info?.name || \"Rival\",\n        last: this.time,\n      };\n      this.ghosts.set(id, g);\n    }\n    if (g.data.stage !== d.stage || !g.avatar.root.parent) this.stages[d.stage].scene.add(g.avatar.root);\n    g.data = d;\n    g.last = this.time;\n    g.avatar.root.scale.x = d.face || 1;\n    g.avatar.setAnim(\n      [\"idle\", \"run\", \"jump\", \"hang\", \"swim\", \"duck\", \"cheer\"].includes(d.anim) ? d.anim : \"run\",\n    );\n  }\n  removeGhost(id) {\n    this.mode = \"peerwaiting\";\n  }\n  peerPacket(d) {\n    if (d?.type === \"start\" && Number.isFinite(d.at)) this.startPeer(d.at);\n    else if (d?.type === \"ghost\") this.receiveGhost(d, \"peer\");\n    else if (d?.type === \"finished\") {\n      const g = this.ghosts.get(\"peer\");\n      if (g) {\n        g.data.finished = true;\n        g.data.elapsed = d.elapsed;\n      }\n      this.toast(\"Your rival has rescued Pip!\", 5);\n      if (this.runners[0]?.finished) this.results();\n    }\n  }\n  tick(dt, provided = null) {\n    this.time += dt;\n    const active = new Set(this.runners.map((r) => r.stageIndex));\n    for (const i of active)\n      updateStage(\n        this.stages[i],\n        this.time,\n        dt,\n        this.runners.find((r) => r.stageIndex === i && r.swing),\n      );\n    for (const r of this.runners) {\n      const inp =\n        provided?.[r.index] || (r.bot ? r.botInput(dt) : this.stepInputs?.[r.index] || emptyInput());\n      if (this.input.kind === \"touch\" && this.settings.assist && r.index === 0) {\n","exit_code":0,"status":"completed"}}
