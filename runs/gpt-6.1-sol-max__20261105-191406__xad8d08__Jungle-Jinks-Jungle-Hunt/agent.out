{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os, signal\ncwd=Path.cwd()\nfor p in Path('/proc').iterdir():\n    if not p.name.isdigit(): continue\n    try:\n        args=(p/'cmdline').read_bytes().split(b'\\\\0')\n        if args[:4]==[b'python3',b'-m',b'http.server',b'0'] and (p/'cwd').resolve()==cwd:\n            os.kill(int(p.name),signal.SIGTERM)\n            print('Stopped my initial buffered server',p.name)\n    except (FileNotFoundError,PermissionError,ProcessLookupError): pass\nPY\npython3 -u -m http.server 0 --bind 127.0.0.1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
