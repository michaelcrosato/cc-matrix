{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"cat artifacts/gpu-render-proof.json && tail -n 40 artifacts/playthrough.json && rg --files node_modules/three node_modules/@dimforge/rapier3d-compat -g '*LICENSE*'\"","aggregated_output":"{\n  \"min\": 4,\n  \"max\": 254,\n  \"colors\": 85\n}    \"winches\": [\n      true,\n      false,\n      false\n    ],\n    \"finished\": false,\n    \"down\": false,\n    \"stuns\": 13,\n    \"damage\": 7,\n    \"rocks\": 0\n  },\n  {\n    \"stage\": 3,\n    \"x\": 83.079345703125,\n    \"y\": 0.9486902356147766,\n    \"health\": 5,\n    \"score\": 12608,\n    \"elapsed\": 66.6499999999975,\n    \"oxygen\": 18,\n    \"relics\": 10,\n    \"checkpoint\": 3,\n    \"swing\": false,\n    \"theta\": null,\n    \"omega\": null,\n    \"swings\": 4,\n    \"swimming\": false,\n    \"grounded\": true,\n    \"ducking\": false,\n    \"winches\": [\n      true,\n      true,\n      true\n    ],\n    \"finished\": true,\n    \"down\": false,\n    \"stuns\": 15,\n    \"damage\": 8,\n    \"rocks\": 0\n  }\n]node_modules/three/LICENSE\nnode_modules/three/examples/fonts/LICENSE\n","exit_code":0,"status":"completed"}}
