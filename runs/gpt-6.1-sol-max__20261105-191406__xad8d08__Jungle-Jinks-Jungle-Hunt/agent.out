{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc 'gh api repos/michaelcrosato/ai-hub/contents/lib/hub'","aggregated_output":"[{\"name\":\"README.md\",\"path\":\"lib/hub/README.md\",\"sha\":\"714853a0da07a707eb0feffb172d010baabc70b4\",\"size\":17739,\"url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/README.md?ref=main\",\"html_url\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/README.md\",\"git_url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/714853a0da07a707eb0feffb172d010baabc70b4\",\"download_url\":\"https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\",\"type\":\"file\",\"_links\":{\"self\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/README.md?ref=main\",\"git\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/714853a0da07a707eb0feffb172d010baabc70b4\",\"html\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/README.md\"}},{\"name\":\"bridge.js\",\"path\":\"lib/hub/bridge.js\",\"sha\":\"5386b0f9578ccb38ebc34ed41109399c031d8125\",\"size\":13624,\"url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/bridge.js?ref=main\",\"html_url\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/bridge.js\",\"git_url\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/5386b0f9578ccb38ebc34ed41109399c031d8125\",\"download_url\":\"https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\",\"type\":\"file\",\"_links\":{\"self\":\"https://api.github.com/repos/michaelcrosato/ai-hub/contents/lib/hub/bridge.js?ref=main\",\"git\":\"https://api.github.com/repos/michaelcrosato/ai-hub/git/blobs/5386b0f9578ccb38ebc34ed41109399c031d8125\",\"html\":\"https://github.com/michaelcrosato/ai-hub/blob/main/lib/hub/bridge.js\"}},{\"name\":\"examples\",\"path\":\"lib/hub/examples\",\"sha\":\"e14acb070e492eb9b98138adc8fe7d8c1a1e81f4\",\"size\":0