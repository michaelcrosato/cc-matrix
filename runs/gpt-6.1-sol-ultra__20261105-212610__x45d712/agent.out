{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/hub.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/hub.js\"","aggregated_output":"/** Dodge Riot networking: AI Hub Protocol v1 plus standalone direct peer co-op.\n * The official, unmodified session client is embedded separately in <head>.\n * All game networking uses the Hub while a Hub session is active.\n */\nexport class HubLink {\n  constructor(callbacks = {}) {\n    this.callbacks = callbacks;\n    this.hubActive = !!globalThis.AIHub?.active;\n    this.mode = this.hubActive ? 'hub' : 'offline';\n    this.connected = false;\n    this.isHost = true;\n    this.server = false;\n    this.me = 0;\n    this.host = 0;\n    this.players = [{ id: 0, name: 'Driver 1', color: '#ffcf50' }];\n    this.ended = false;\n    this.started = false;\n    this.peer = null;\n    this.channel = null;\n    this._off = [];\n    this._lastInput = -Infinity;\n    this._lastSnapshot = -Infinity;\n    this._inputSequence = 0;\n    this._snapshotSequence = 0;\n    this._seenInput = new Map();\n    this._seenSnapshot = -1;\n    this._goAt = null;\n    this.stats = { inputsSent: 0, inputsReceived: 0, snapshotsSent: 0, snapshotsReceived: 0 };\n  }\n  get active() { return this.mode !== 'offline'; }\n  _emit(name, ...args) { this.callbacks[name]?.(...args); }\n  _status(message) { this._emit('onStatus', message); }\n  async connect() {\n    const hub = globalThis.AIHub;\n    if (!hub || !hub.active) return null;\n    this._off.push(\n      hub.on('start', event => {\n        this.started = true;\n        this._emit('onStart', { ...this.info(), in: event.in });\n      }),\n      hub.on('message', (data, from) => this._receive(data, from)),\n      hub.on('leave', ({ id }) => {\n        this.players = hub.players.slice();\n        this._seenInput.delete(id);\n        this._emit('onLeave', id);\n      }),\n      hub.on('time-up', event => this._emit('onTimeUp', event)),\n      hub.on('end', event => {\n        this.ended = true;\n        this.started = false;\n        this._emit('onEnd', event.reason, event);\n      })\n    );\n    const info = await hub.connect({ mode: 'shared-world', seats: [1, 2] });\n    if (!info) {\n      this.hubActive = false;\n      this.mode = 'offline';\n      this._status('Solo / couch play');\n      return null;\n    }\n    this.mode = 'hub';\n    this.connected = true;\n    this.me = info.me;\n    this.host = info.host;\n    this.isHost = info.isHost;\n    this.server = !!info.server;\n    this.players = info.players.slice();\n    this._status(this.server ? 'AI Hub simulation host' : `AI Hub · driver ${this.me + 1}`);\n    return info;\n  }\n  info() {\n    return { mode: this.mode, me: this.me, host: this.host, isHost: this.isHost,\n      server: this.server, players: this.players.slice(), in: 3000 };\n  }\n  ready() {\n    if (this.hubActive && this.connected && !this.ended) globalThis.AIHub.ready();\n  }\n  time() {\n    if (this.hubActive) return globalThis.AIHub.time();\n    return this._goAt === null ? -Infinity : performance.now() - this._goAt;\n  }\n  _send(packet, to) {\n    if (!this.connected || this.ended) return false;\n    try {\n      const text = JSON.stringify(packet);\n      if (text.length > 16000) return false;\n      if (this.hubActive) return globalThis.AIHub.send(packet, { to, reliable: true });\n      if (this.channel?.readyState !== 'open' || this.channel.bufferedAmount > 128000) return false;\n      this.channel.send(text);\n      return true;\n    } catch (_) { return false; }\n  }\n  sendInput(input) {\n    if (!this.active || this.isHost || !this.started || this.ended) return false;\n    const now = performance.now();\n    if (now - this._lastInput < 1000 / 15) return false;\n    if (!this._send({ riot: 1, type: 'input', seq: ++this._inputSequence, input }, this.host)) return false;\n    this._lastInput = now;\n    this.stats.inputsSent++;\n    return true;\n  }\n  sendSnapshot(snapshot) {\n    if (!this.active || !this.isHost || !this.started || this.ended) return false;\n    const now = performance.now();\n    if (now - this._lastSnapshot < 1000 / 15) return false;\n    if (!this._send({ riot: 1, type: 'snapshot', seq: ++this._snapshotSequence, snapshot })) return false;\n    this._lastSnapshot = now;\n    this.stats.snapshotsSent++;\n    return true;\n  }\n  _receive(packet, from) {\n    if (!packet || packet.riot !== 1 || this.ended) return;\n    if (packet.type === 'input' && this.isHost) {\n      if (!this.players.some(player => player.id === from) || from === this.me) return;\n      if (!Number.isSafeInteger(packet.seq) || packet.seq <= (this._seenInput.get(from) ?? -1)) return;\n      const input = packet.input;\n      if (!input || typeof input !== 'object' || Array.isArray(input)) return;\n      this._seenInput.set(from, packet.seq);\n      this.stats.inputsReceived++;\n      this._emit('onInput', input, from);\n    } else if (packet.type === 'snapshot' && !this.isHost && from === this.host) {\n      if (!Number.isSafeInteger(packet.seq) || packet.seq <= this._seenSnapshot) return;\n      if (!packet.snapshot || typeof packet.snapshot !== 'object') return;\n      this._seenSnapshot = packet.seq;\n      this.stats.snapshotsReceived++;\n      this._emit('onSnapshot', packet.snapshot);\n    } else if (!this.hubActive && packet.type === 'start' && !this.isHost && !this.started) {\n      this.started = true;\n      this._goAt = performance.now() + 3000;\n      this._emit('onStart', { ...this.info(), in: 3000 });\n    } else if (!this.hubActive && packet.type === 'end' && !this.isHost && from === this.host) {\n      this.ended = true;\n      this.started = false;\n      this._emit('onEnd', 'finished', packet.outcome);\n    }\n  }\n  finish(outcome = {}) {\n    if (!this.active || !this.isHost || !this.connected || this.ended || this._finished) return false;\n    this._finished = true;\n    const ids = this.players.map(player => player.id);\n    const score = Number.isFinite(outcome.score) ? outcome.score : 0;\n    const result = {\n      standings: [ids], scores: Object.fromEntries(ids.map(id => [id, score])),\n      won: !!outcome.won,\n      stats: Object.fromEntries(ids.map(id => [id, outcome.stats || {}]))\n    };\n    if (this.hubActive) globalThis.AIHub.finish(result);\n    else {\n      this._send({ riot: 1, type: 'end', outcome: { ...result, ...outcome } });\n      this.ended = true;\n      this.started = false;\n      this._emit('onEnd', 'finished', { ...result, ...outcome });\n    }\n    return true;\n  }\n  fail(message) {\n    if (this.hubActive) globalThis.AIHub.fail(message);\n    else this._status(String(message));\n  }\n  async _newPeer(host) {\n    if (this.hubActive || globalThis.AIHub?.active) throw new Error('AI Hub manages this connection.');\n    if (!globalThis.RTCPeerConnection) throw new Error('Direct co-op needs a browser with WebRTC.');\n    this.disconnect();\n    this.mode = 'direct';\n    this.isHost = host;\n    this.me = host ? 0 : 1;\n    this.host = 0;\n    this.players = [\n      { id: 0, name: 'Driver 1', color: '#ffcf50' },\n      { id: 1, name: 'Driver 2', color: '#4ce3cc' }\n    ];\n    this.peer = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });\n    this.peer.onconnectionstatechange = () => {\n      const state = this.peer?.connectionState;\n      if (state === 'failed') this._status('Connection failed. Make fresh connection codes and try again.');\n      if (state === 'disconnected' || state === 'failed') {\n        this.connected = false;\n        if (this.started && !this.ended) {\n          this.ended = true;\n          this._emit('onLeave', host ? 1 : 0);\n          this._emit('onEnd', 'peer-disconnected');\n        }\n      }\n    };\n    this.peer.ondatachannel = event => this._attachChannel(event.channel);\n    if (host) this._attachChannel(this.peer.createDataChannel('dodge-riot', { ordered: true }));\n    return this.peer;\n  }\n  _attachChannel(channel) {\n    this.channel = channel;\n    channel.onmessage = event => {\n      try { this._receive(JSON.parse(event.data), this.isHost ? 1 : 0); } catch (_) { /* Ignore malformed peer packets. */ }\n    };\n    channel.onopen = () => {\n      this.connected = true;\n      this._status('Direct co-op connected');\n      if (this.isHost) {\n        this.started = true;\n        this._goAt = performance.now() + 3000;\n        this._send({ riot: 1, type: 'start' });\n        this._emit('onStart', { ...this.info(), in: 3000 });\n      }\n    };\n    channel.onclose = () => {\n      if (!this.connected || this.ended) return;\n      this.connected = false;\n      this.ended = true;\n      this.started = false;\n      this._status('Partner disconnected');\n      this._emit('onLeave', this.isHost ? 1 : 0);\n      this._emit('onEnd', 'peer-disconnected');\n    };\n  }\n  async _gather() {\n    const peer = this.peer;\n    if (peer.iceGatheringState === 'complete') return;\n    await new Promise(resolve => {\n      const done = () => {\n        clearTimeout(timer);\n        peer.removeEventListener('icegatheringstatechange', check);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/test_game.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/test_game.py\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"One-command regression checks. Prints only failures and a one-line count.\n\nRun with the workstation's Playwright interpreter:\n/home/micha/.local/share/pipx/venvs/playwright/bin/python <this file>\n\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport http.server\nimport json\nimport os\nimport sys\nimport tempfile\nimport threading\nimport traceback\nfrom pathlib import Path\n\nHERE = Path(__file__).resolve().parent\nROOT = HERE.parent\nSTEM = HERE.name\nARTIFACTS = HERE / \"test-artifacts\"\nARTIFACTS.mkdir(exist_ok=True)\nTEMP = ARTIFACTS / \"tmp\"\nTEMP.mkdir(exist_ok=True)\nos.environ[\"TMPDIR\"] = str(TEMP)\ntempfile.tempdir = str(TEMP)\n\nfrom playwright.sync_api import sync_playwright\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\nclass Checks:\n    def __init__(self):\n        self.passed = 0\n        self.failures = []\n        self.details = {}\n\n    def run(self, name, fn):\n        try:\n            result = fn()\n            self.passed += 1\n            if result is not None:\n                self.details[name] = result\n        except Exception as exc:  # noqa: BLE001 - isolate and report every regression\n            text = f\"FAIL {name}: {type(exc).__name__}: {exc}\"\n            self.failures.append(text)\n            print(text)\n            self.details[name] = {\n                \"error\": str(exc),\n                \"traceback\": traceback.format_exc(),\n            }\n\n\ndef require(ok, message):\n    if not ok:\n        raise AssertionError(message)\n\n\nPAD_SCRIPT = \"\"\"(() => {\n    window.__testPad = null;\n    Object.defineProperty(navigator, 'getGamepads', {\n      configurable:true, value:()=>window.__testPad ? [window.__testPad] : []\n    });\n    window.__makeTestPad = () => {\n      window.__testPad = {\n        id:'DualSense standard test controller', index:0, connected:true,\n        mapping:'standard', timestamp:performance.now(), axes:[0,0,0,0],\n        buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),\n        vibrationActuator:{type:'dual-rumble',playEffect:()=>Promise.resolve('complete')}\n      };\n      window.dispatchEvent(new Event('gamepadconnected'));\n    };\n})();\"\"\"\n\n\ndef main():\n    checks = Checks()\n    html = ROOT / f\"{STEM}.html\"\n    if not html.exists():\n        print(f\"FAIL package: missing {html.name}\")\n        print(\"0 passed, 1 failed\")\n        return 1\n\n    server = http.server.ThreadingHTTPServer(\n        (\"127.0.0.1\", 0), functools.partial(QuietHandler, directory=str(ROOT))\n    )\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    origin = f\"http://127.0.0.1:{server.server_address[1]}\"\n    url = f\"{origin}/{STEM}.html?test=1\"\n    errors = []\n    console_errors = []\n    try:\n        with sync_playwright() as playwright:\n            browser = playwright.chromium.launch(\n                headless=True,\n                args=[\n                    \"--enable-unsafe-webgpu\",\n                    \"--enable-features=Vulkan\",\n                    \"--use-webgpu-adapter=swiftshader\",\n                    \"--autoplay-policy=no-user-gesture-required\",\n                ],\n            )\n            context = browser.new_context(\n                viewport={\"width\": 1920, \"height\": 1080},\n                device_scale_factor=1,\n                ignore_https_errors=True,\n            )\n            context.add_init_script(PAD_SCRIPT)\n            page = context.new_page()\n            page.on(\"pageerror\", lambda err: errors.append(str(err)))\n            page.on(\n                \"console\",\n                lambda message: (\n                    console_errors.append(message.text)\n                    if message.type == \"error\"\n                    else None\n                ),\n            )\n            page.goto(url, wait_until=\"domcontentloaded\", timeout=90000)\n            page.wait_for_function(\n                \"window.__game && typeof window.__game.snapshot === 'function'\",\n                timeout=120000,\n            )\n\n            def snap():\n                return page.evaluate(\"window.__game.snapshot()\")\n\n            def act(name, arg=None):\n                return page.evaluate(\n                    \"([n,a]) => window.__game.action(n,a)\", [name, arg]\n                )\n\n            def step(seconds):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/main.js <<'EOF'\nconst \"'$=s=>document.querySelector(s);\nconst escapeHTML=s=>String(s).replace(/[&<>\"'\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst settings={music:.1,effects:.7,glyphs:'ps',touchAssist:true,reducedMotion:false};\ntry{Object.assign(settings,JSON.parse(localStorage.getItem('dodge-riot-settings')||'{}'));}catch{}\nconst audio=new AudioDirector();audio.setMusic(settings.music);audio.setEffects(settings.effects);\nlet scene,sim,network,screen='title',previousScreen='title',inputType='keyboard',idle=0,attract=false,devOpen=false,autopilot=false,ready=false,gameEnded=false,netCountdown=false,netStatus='',notice='',noticeUntil=0,lastTime=0,accumulator=0,lastHud='',lastToast='',count=1,highScore=0,gamepadTime=0;\nlet keys=new Set(),pending=[0,0],padStates=new Map(),remoteInputs=new Map(),touchBoost=false,touchBrake=false,touchLane=0,menuFocus=0,heldMenu='',heldMenuTime=0,networkLaneSeq=0,lastRemoteSeq=new Map();\ntry{highScore=Number(localStorage.getItem('dodge-riot-best')||0);}catch{}\nconst dom={screens:\"'$('\"'#screens'),hud:\"'$('\"'#hud'),toast:\"'$('\"'#toast'),loading:\"'$('\"'#loading'),touchMenu:\"'$('\"'#touch-menu'),touchBoost:\"'$('\"'#touch-boost')};\nconst glyph=(kind)=>inputType==='gamepad'?({confirm:settings.glyphs==='ps'?'✕':'A',back:settings.glyphs==='ps'?'○':'B',boost:settings.glyphs==='ps'?'R2':'RT',pause:'☰',lane:'◀ ▶'}[kind]):({confirm:'ENTER',back:'ESC',boost:'SPACE',pause:'ESC',lane:'← →'}[kind]);\nfunction saveSettings(){try{localStorage.setItem('dodge-riot-settings',JSON.stringify(settings));}catch{}}\nfunction button(label,action,primary=false,tail='↗'){return \"'`<button class=\"menu-button${primary?'\"' primary':''}\\\" data-action=\\\"\"'${action}\"><span>${label}</span><span class=\"glyph\">${tail}</span></button>`;}\nfunction panel(title,body,wide=false,kicker='\"'RIOT MOTOR CLUB'){return \"'`<div class=\"overlay\"><section class=\"panel${wide?'\"' wide':''}\\\" aria-label=\\\"\"'${title}\"><button class=\"panel-close\" data-action=\"back\" aria-label=\"Back\">×</button><span class=\"eyebrow\">${kicker}</span><h2>${title}</h2>${body}</section></div>`;}\nfunction showNotice(text,seconds=3){notice=text;noticeUntil=performance.now()+seconds*1000;document.querySelector('\"'.toast-small')?.remove();const m=document.createElement('div');m.className='toast-small';m.textContent=text;document.body.append(m);setTimeout(()=>m.remove(),seconds*1000);}\nfunction focusMenu(index=0){const els=[...dom.screens.querySelectorAll('button:not(:disabled),input,textarea')].filter(e=>e.offsetParent\"'!==null);if(!els.length)return;menuFocus=mod(index,els.length);els.forEach((e,i)=>e.classList.toggle('\"'focused',i===menuFocus));els[menuFocus].focus({preventScroll:true});els[menuFocus].scrollIntoView({block:'nearest',behavior:'instant'});}\nfunction setScreen(next){screen=next;lastHud='';lastToast='';renderScreen();}\nfunction renderScreen(){dom.hud.hidden=\"'!(screen==='\"'play'||(attract&&screen==='title'));dom.touchMenu.hidden=\"'!(inputType==='\"'touch'&&screen==='play');dom.touchBoost.hidden=\"'!(inputType==='\"'touch'&&screen==='play');\n if(screen==='title'){\n dom.screens.innerHTML=\"'`<section class=\"title-screen\"><div class=\"club-kicker eyebrow\">RIOT MOTOR CLUB · EST. 1980-ISH</div><h1>DODGE<span>RIOT</span></h1><p class=\"tagline\">Four lanes.<br>A full tank of trouble.</p><nav class=\"title-menu\">${button('\"'SOLO RUN','solo',true,glyph('confirm'))}\"'${button('\"'COUCH CO-OP','coop',false,'1 + 2')}\"'${button('\"'ONLINE CO-OP','online',false,'↔')}</nav><div class=\\\"small-buttons\\\"><button data-action=\\\"guide\\\">DRIVE 101</button><button data-action=\\\"settings\\\">SETTINGS</button><button data-action=\\\"about\\\">CREDITS</button></div><p class=\\\"attract-note\\\">\"'${highScore?'\"'CLUB RECORD '+highScore.toLocaleString():'NO REVERSE. NO REGRETS.'} &nbsp; / &nbsp; INSERT YOUR NERVE.</p><div class=\\\"title-edition\\\">THREE ROUNDS · ONE CLEAN GETAWAY</div><div class=\\\"title-stamp\\\"><strong>↗ ↗</strong><span>COLLECT THE LOT.<br>DODGE THE REST.</span></div></section>\"'${attract?'\"'<div class=\\\"demo-banner\\\">AUTO PILOT · PRESS ANYTHING TO TAKE THE WHEEL</div>':''}\"'`;\n }else if(screen==='\"'play'){dom.screens.innerHTML=network.active?\"'`<div class=\"network-indicator\">${network.hubActive?'\"'AI HUB':'DIRECT CO-OP'} · \"'${network.server?'\"'SIMULATION HOST':\"'`DRIVER ${network.me+1}`}</div>`:'\"'';\n }else if(screen==='paused'){\n dom.screens.innerHTML=panel('PIT STOP',\"'`<p>The road can wait a minute.</p>${button('\"'BACK TO THE RIOT','resume',true,glyph('confirm'))}\"'${button('\"'SETTINGS','settings')}\"'${button('\"'DEV GARAGE','dev')}\"'${button('\"'ABOUT & CREDITS','about')}\"'${button('\"'PARK IT / TITLE','title',false,glyph('back'))}\"'`);\n }else if(screen==='\"'guide'){\n dom.screens.innerHTML=panel('DRIVE 101',\"'`<div class=\"rule-card\"><div class=\"rule-icon\">•</div><div><strong>MAKE A CLEAN SWEEP</strong><span>Collect all 96 golden fares to clear a round. Complete three rounds to join the club. Your car drives clockwise; rivals come the other way.</span></div></div><div class=\"rule-card\"><div class=\"rule-icon\">⇄</div><div><strong>CHANGE AT THE CROSSINGS</strong><span>${inputType==='\"'gamepad'?'D-pad or left stick':inputType==='touch'?'Drag your left thumb up or down':'← / A inward. → / D outward.'} Pick a lane near any yellow crossing. An early turn waits for the next crossing.</span></div></div><div class=\\\"rule-card\\\"><div class=\\\"rule-icon\\\">ϟ</div><div><strong>ZIP. SLIP. RECHARGE.</strong><span>Hold \"'${glyph('\"'boost')} for a burst of speed and a brief half-second collision shield when it starts. Release to recharge. \"'${inputType==='\"'gamepad'?'L2 / LT':inputType==='touch'?'Hold the left side':'↓ / S'} brakes. Mint diamonds protect you for five seconds.</span></div></div><div class=\\\"rule-card\\\"><div class=\\\"rule-icon\\\">♥</div><div><strong>BRING A PAL</strong><span>Co-op shares four bumpers and one score. P1: arrows + Space. P2: A / D + W to zip, S to brake. Two pads work too. Touch adds steering assistance.</span></div></div>\"'${button('\"'GOT IT. LET’S ROLL.','back',true)}\"'`,false,'\"'READ THE ROAD');\n }else if(screen==='settings'){\n dom.screens.innerHTML=panel('TUNE UP',\"'`<div class=\"settings-row\"><label for=\"music\">MUSIC <output>${Math.round(settings.music*100)}%</output></label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${settings.music}\"></div><div class=\"settings-row\"><label for=\"effects\">SOUND & VOICES <output>${Math.round(settings.effects*100)}%</output></label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${settings.effects}\"></div><div class=\"settings-row\"><button class=\"toggle-button\" data-action=\"glyphs\">CONTROLLER GLYPHS <span style=\"float:right\">${settings.glyphs==='\"'ps'?'PLAYSTATION  ✕ ○':'XBOX  A B'}</span></button></div><div class=\\\"settings-row\\\"><button class=\\\"toggle-button\\\" data-action=\\\"assist\\\">TOUCH STEERING ASSIST <span style=\\\"float:right\\\">\"'${settings.touchAssist?'\"'ON':'OFF'}</span></button></div><div class=\\\"settings-row\\\"><button class=\\\"toggle-button\\\" data-action=\\\"motion\\\">REDUCED SCREEN SHAKE <span style=\\\"float:right\\\">\"'${settings.reducedMotion?'\"'ON':'OFF'}</span></button></div><p class=\\\"help\\\">Music starts at 10%. Audio wakes up on your first button press. Controls follow the input you use.</p>\"'${button('\"'BACK ON THE ROAD','back',true,glyph('back'))}\"'`);\n }else if(screen==='\"'dev'){\n const slider=(key,label,min,max,step=1)=>\"'`<div class=\"settings-row\"><label for=\"dev-${key}\">${label}<output>${sim.config[key]}</output></label><input id=\"dev-${key}\" data-config=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${sim.config[key]}\"></div>`;\n dom.screens.innerHTML=panel('\"'DEV GARAGE',\"'`<p class=\"help\">Live tuning. Changes apply immediately. Practice tools keep this run out of the club record.</p><div class=\"dev-grid\">${slider('\"'speed','DRIVER SPEED',6,25,.2)}\"'${slider('\"'trafficSpeed','TRAFFIC SPEED',4,24,.2)}\"'${slider('\"'boostPower','ZIP MULTIPLIER',1.2,3,.05)}\"'${slider('\"'recharge','BATTERY RECHARGE',0,35,.5)}\"'${slider('\"'gateWindow','CROSSING FORGIVENESS',.5,5,.1)}\"'${slider('\"'lives','STARTING BUMPERS',1,9,1)}</div><div class=\\\"button-row\\\"><button class=\\\"toggle-button\\\" data-action=\\\"invincible\\\">INVINCIBLE: \"'${sim.config.invincible?'\"'ON':'OFF'}</button><button class=\\\"toggle-button\\\" data-action=\\\"autopilot\\\">AUTO DRIVE: \"'${autopilot?'\"'ON':'OFF'}</button></div><div class=\\\"button-row\\\">\"'${button('\"'REFILL','refill')}\"'${button('\"'CLEAR ROUND','collectAll')}\"'${button('\"'NEXT ROUND','nextRound')}</div><div class=\\\"button-row\\\">\"'${button('\"'RESET DEFAULTS','resetConfig')}\"'${button('\"'BACK TO PIT','back',true)}</div>\"'`,true,'\"'PRACTICE / LIVE BALANCE');\n }else if(screen==='about'){\n const info=METADATA.sourceInformation;const labels={date:'Date',source:'Source',plan:'Plan',genre:'Genre',perspective:'Perspective',tech:'Tech',artDirection:'Art direction',animation:'Animation',audio:'Audio',online:'Online',testing:'Testing',research:'Research',environment:'Environment',model:'Model',usage:'Usage'};\n let body=\"'`<p>A little car with a very big evening. Original game design, procedural models, music and voices made for this demo. Inspired by the lane-chasing spirit of Dodge Em (1980).</p><div class=\"feedback-title\">Source Information</div><dl class=\"credits-grid\">${Object.entries(info).map(([k,v])=>`<dt>${labels[k]||k}</dt><dd>${escapeHTML(v)}</dd>`).join('\"'')}</dl>\"'`;\n for(const [key,label] of [['\"'testingFeedback','Testing Feedback'],['engineFeedback','Engine Feedback'],['promptFeedback','Prompt Feedback']])body+=\"'`<div class=\"feedback-title\">${label}</div><ol class=\"feedback-list\">${METADATA[key].map(v=>`<li>${escapeHTML(v)}</li>`).join('\"'')}</ol>\"'`;\n body+=`<p class=\"help\">Three.js © its contributors, MIT. Rapier © Dimforge, Apache-2.0. AI Hub session client by michaelcrosato. All visuals and sound are generated in code. No external art or sound assets.</p>${button('\"'BACK','back',true)}\"'`;dom.screens.innerHTML=panel('\"'CLUB CREDITS',body,true,'SOURCE / MAKING OF');\n }else if(screen==='lobby'){\n dom.screens.innerHTML=panel('LONG-DISTANCE<br>DOUBLE TROUBLE',\"'`<p>Two drivers. One circuit. Share a connection code with a friend. For automatic rooms, launch from AI Hub.</p><div class=\"status-bar\" id=\"network-status\">${escapeHTML(netStatus||'\"'Choose a seat. No account needed.')}</div><div class=\\\"button-row\\\">\"'${button('\"'HOST A RUN','host',true)}\"'${button('\"'JOIN A RUN','join')}</div><div id=\\\"lobby-codes\\\"></div><p class=\\\"help\\\">Direct co-op uses an encrypted WebRTC connection. Swap invite and reply codes using your preferred messenger. Network firewalls may require an AI Hub room.</p>\"'${button('\"'BACK','back',false,glyph('back'))}\"'`,false,'\"'ONLINE CO-OP / TWO DRIVERS');\n }else if(screen==='results'){\n const won=sim.phase==='won';dom.screens.innerHTML=panel(won?'NICE DRIVING,<br>TROUBLEMAKER.':'END OF<br>THE ROAD.',\"'`<p>${gameEnded&&network.active?'\"'The shared run has ended.':won?'Three clean circuits. The club is impressed. Don’t let it go to your head.':'The bumpers have left the chat. Get back out there.'}</p><span class=\\\"eyebrow\\\">\"'${won?'\"'CLUB-APPROVED SCORE':'FINAL FARE'}</span><div class=\\\"results-score\\\">\"'${sim.score.toLocaleString()}</div><div class=\"results-stats\"><div><strong>${sim.stats.dots}</strong><small>FARES</small></div><div><strong>${sim.stats.closeCalls}</strong><small>CLOSE CALLS</small></div><div><strong>${sim.stats.boosts}</strong><small>ZIPS</small></div></div>${network.hubActive?'\"'<p class=\\\"help\\\">Your score has been returned to AI Hub. The host can start the next session.</p>':button('ONE MORE RUN','restart',true,glyph('confirm'))}\"'${network.hubActive?'\"'':button('BACK TO THE CLUB','title',false,glyph('back'))}\"'`);\n }else if(screen==='\"'hubwait')dom.screens.innerHTML=\"'`<div class=\"hub-wait\"><div><span class=\"eyebrow\">AI HUB · DODGE RIOT</span><h2>ENGINES READY.</h2><p>Waiting for the rest of the motor club.</p></div></div>`;\n if(screen!=='\"'play')focusMenu(0);updateHud();updateToast();\n}\nfunction startGame(players=1,isAttract=false){attract=isAttract;count=players;gameEnded=false;remoteInputs.clear();lastRemoteSeq.clear();sim.start(players,isAttract);sim.players.forEach(p=>p.ai=isAttract||autopilot);setScreen(isAttract?'title':'play');audio.setMode('play');if(\"'!isAttract)audio.sfx('\"'start');idle=0;clearInputs();}\nfunction toTitle(){if(network.active&&\"'!network.hubActive)network.disconnect();attract=false;gameEnded=false;autopilot=false;sim.start(1,true);sim.phase='\"'running';sim.attract=false;sim.players[0].ai=true;setScreen('title');audio.setMode('title');idle=0;clearInputs();}\nfunction pause(){if(screen\"'!=='\"'play'||attract)return;clearInputs();setScreen('paused');audio.setMode('pause');}\nfunction resume(){setScreen('play');clearInputs();audio.setMode('play');}\nfunction back(){if(screen==='settings'||screen==='about'||screen==='guide'){setScreen(previousScreen);return;}if(screen==='dev'){setScreen('paused');return;}if(screen==='lobby'){network.disconnect();toTitle();return;}if(screen==='paused')resume();else if(screen==='results'&&\"'!network.hubActive)toTitle();}\nfunction clearInputs(){keys.clear();pending=[0,0];touchBoost=false;touchBrake=false;}\nasync function perform(name,arg){\n if(!ready)return;audio.unlock();audio.sfx('\"'ui');idle=0;\n switch(name){\n case 'solo':startGame(1);break;case 'coop':startGame(2);break;case 'start':startGame(arg?.players||1);break;\n case 'pause':pause();break;case 'resume':resume();break;case 'back':back();break;\n case 'settings':case 'about':case 'guide':previousScreen=screen;setScreen(name);break;\n case 'online':netStatus='';setScreen('lobby');break;\n case 'dev':devOpen=true;setScreen('dev');break;\n case 'title':toTitle();break;case 'restart':if(network.active)network.disconnect();startGame(count);break;\n case 'glyphs':settings.glyphs=settings.glyphs==='ps'?'xbox':'ps';saveSettings();renderScreen();break;\n case 'assist':settings.touchAssist=\"'!settings.touchAssist;saveSettings();renderScreen();break;\n case '\"'motion':settings.reducedMotion=\"'!settings.reducedMotion;saveSettings();renderScreen();break;\n case '\"'setConfig':if(arg&&arg.key in sim.config){sim.config[arg.key]=arg.value;devOpen=true;}break;\n case 'resetConfig':Object.assign(sim.config,DEFAULTS);autopilot=false;sim.players.forEach(p=>p.ai=attract);if(screen==='dev')renderScreen();break;\n case 'invincible':sim.config.invincible=\"'!sim.config.invincible;renderScreen();break;\n case '\"'autopilot':autopilot=typeof arg==='boolean'?arg:\"'!autopilot;sim.players.forEach(p=>p.ai=autopilot||attract);if(screen==='\"'dev')renderScreen();break;\n case 'refill':sim.lives=Math.round(sim.config.lives);sim.players.forEach(p=>{p.charge=100;p.invuln=5;});showNotice('BUMPER TO BUMPER. GOOD AS NEW.');break;\n case 'collectAll':sim.collectAll();if(screen==='dev')resume();break;\n case 'nextRound':sim.loadRound(sim.round%3+1);sim.players.forEach(p=>p.ai=autopilot);resume();break;\n case 'warpRound':sim.loadRound(Number(arg)||1);sim.players.forEach(p=>p.ai=autopilot);setScreen('play');break;\n case 'hit':sim.hit();break;case 'charge':sim.players.forEach(p=>p.charge=Number(arg)||100);break;\n case 'attract':startGame(1,true);break;case 'finish':sim.phase='won';onEvent('win');break;\n case 'host':await hostRoom();break;case 'join':joinRoomUI();break;case 'sendInvite':await answerInvite();break;case 'sendReply':await acceptReply();break;\n case 'copy':copyCode();break;\n }\n updateHud();updateToast();\n}\nfunction onEvent(name,data={}){if(\"'!ready&&name!=='\"'round')return;\n if(name==='dot'){if(\"'!attract)audio.sfx(data.mult>1&&sim.combo%12===0?'\"'combo':'dot');const p=trackPoint(data.lane,data.progress);scene?.burst(p.x,p.z,data.shield?'#91dfba':'#f3cf6a',3);}\n else if(name==='lane'){if(\"'!attract)audio.sfx('\"'lane');}\n else if(name==='boost'){if(\"'!attract)audio.sfx('\"'boost');}\n else if(name==='shield'){audio.sfx('shield');flash('BUMPER BUBBLE\"'!'\"');}\n else if(name==='close'){if(\"'!attract){audio.sfx('\"'combo');flash('CLOSE CALL +25');}}\n else if(name==='hit'){audio.sfx('hit');if(\"'!settings.reducedMotion)scene.shake=1;const p=carPoint(sim.players[data.player||0]);scene.burst(p.x,p.z,'\"'#f37c43',24);flash('THAT’LL BUFF OUT.');rumble(.8,350);}\n else if(name==='go'){if(\"'!attract)audio.sfx('\"'start');}\n else if(name==='clear'){audio.sfx('clear');audio.sfx('voice');for(let i=0;i<14;i++)scene.burst((Math.random()-.5)*25,(Math.random()-.5)*18,i%2?'#f5cc61':'#91dfba',6);rumble(.3,200);}\n else if(name==='win'||name==='lose'){\n if(attract){sim.countdown=5;return;}\n if(network.active&&network.isHost)network.finish({score:sim.score,won:name==='win',stats:sim.stats});\n audio.sfx(name==='win'?'clear':'over');audio.setMode(name==='win'?'win':'pause');\n if(\"'!devOpen&&sim.score>highScore){highScore=sim.score;try{localStorage.setItem('\"'dodge-riot-best',highScore);}catch{}}\n setScreen('results');clearInputs();\n }\n}\nlet flashText='',flashUntil=0;\nfunction flash(text){flashText=text;flashUntil=performance.now()+1100;}\nfunction rumble(power,duration){for(const pad of navigator.getGamepads?.()||[])if(pad?.vibrationActuator)pad.vibrationActuator.playEffect('dual-rumble',{duration,strongMagnitude:power,weakMagnitude:power*.6}).catch(()=>{});}\nfunction updateHud(){if(\"'!sim.players.length)return;const s=sim;const dots=s.dots.filter(d=>!d.collected).length;let html=`<div class=\"hud\"><div class=\"hud-top\"><div class=\"hud-block\"><span class=\"eyebrow\">CIRCUIT ${String(s.round).padStart(2,'\"'0')} / 03</span><div class=\\\"hud-value\\\">\"'${dots} <span style=\"font-size:.48em;letter-spacing:1px\">TO GO</span></div><div class=\"dots-progress\"><i style=\"width:${(96-dots)/96*100}%\"></i></div><div class=\"round-name\">${ROUND_INFO[s.round-1].name}</div></div><div class=\"hud-block hud-score\"><span class=\"eyebrow\">${s.combo>=12?`FARE STREAK ×${1+Math.min(4,Math.floor(s.combo/12))}`:'\"'CLUB SCORE'}</span><div class=\\\"hud-value\\\">\"'${String(s.score).padStart(6,'\"'0')}</div></div><div class=\\\"hud-right\\\"><div class=\\\"hud-block\\\"><span class=\\\"eyebrow\\\">\"'${s.players.length>1?'\"'SHARED BUMPERS':'BUMPER BUDGET'}</span><div class=\\\"hud-value hearts\\\">\"'${'\"'♥'.repeat(Math.max(0,Math.min(9,s.lives)))}\"'${'\"'♡'.repeat(Math.max(0,Math.min(4,Math.round(s.config.lives))-s.lives))}</div></div><button class=\\\"hud-pause\\\" data-action=\\\"pause\\\" aria-label=\\\"Pause\\\">Ⅱ</button></div></div><div class=\\\"hud-bottom\\\">\"'`;\n const card=(p,i)=>`<div class=\"driver-card ${i?'\"'p2':''}\\\"><div class=\\\"driver-head\\\"><span>\"'${i?'\"'MINT / DRIVER 2':'TANGERINE / DRIVER 1'}</span><span>\"'${p.invuln>.1?'\"'◈':p.boosting?'ZIP\"'!'\"':Math.round(p.charge)+'%'}</span></div><div class=\\\"charge-track\\\"><div class=\\\"charge-fill\\\" style=\\\"width:\"'${Math.round(p.charge)}%\"></div></div><div class=\"driver-foot\"><span>${p.queued?(p.queued<0?'\"'← IN':'OUT →')+' AT CROSSING':p.invuln>0?'BUMPER BUBBLE':p.braking?'TAKING IT EASY':'READY TO ZIP'}</span><span>\"'${i?(inputType==='\"'gamepad'?glyph('boost'):'W'):glyph('boost')}</span></div></div>\"'`;\n html+=card(s.players[0],0);html+=`<div class=\"controls-strip\">${inputType==='\"'touch'?'LEFT THUMB ↕ STEER · ZIP ON THE RIGHT':inputType==='gamepad'?'<span class=\\\"key\\\">◀</span> IN &nbsp; <span class=\\\"key\\\">▶</span> OUT &nbsp; <span class=\\\"key\\\">'+glyph('boost')+'</span> ZIP &nbsp; <span class=\\\"key\\\">L2</span> BRAKE':'<span class=\\\"key\\\">←</span> IN &nbsp; <span class=\\\"key\\\">→</span> OUT &nbsp; <span class=\\\"key\\\">SPACE</span> ZIP &nbsp; <span class=\\\"key\\\">↓</span> BRAKE'}<br><span style=\\\"font-size:.83em;opacity:.8\\\">SWITCH LANES AT THE FOUR YELLOW CROSSINGS</span></div>\"'`;if(s.players[1])html+=card(s.players[1],1);else html+='\"'<div style=\\\"width:245px\\\" class=\\\"hud-spacer\\\"></div>';html+='</div></div>';\n if(html\"'!==lastHud){dom.hud.innerHTML=html;lastHud=html;}\n dom.hud.hidden=!(screen==='\"'play'||(attract&&screen==='title'));\n}\nfunction updateToast(){let html='';if(screen==='play'||attract){if(netCountdown&&network.time()<0){html=\"'`<div class=\"big-call\">${Math.max(1,Math.ceil(-network.time()/1000))}</div><div class=\"call-sub\">DRIVERS READY</div>`;}else if(sim.phase==='\"'countdown'){html=\"'`<div class=\"big-call\">${Math.max(1,Math.ceil(sim.countdown))}</div><div class=\"call-sub\">${ROUND_INFO[sim.round-1].name}</div>`;}else if(sim.phase==='\"'clear')html=\"'`<div class=\"big-call\">CIRCUIT<br>CLEAN!</div><div class=\"call-sub\">${sim.round<3?'\"'NEXT STOP: '+ROUND_INFO[sim.round].name:'WELCOME TO THE CLUB'}</div>\"'`;else if(sim.phase==='\"'running'&&sim.roundTime<1)html='<div class=\\\"big-call\\\" style=\\\"color:#f49a47\\\">LET’S ZIP\"'!</div>'\"';else if(performance.now()<flashUntil)html=\"'`<div class=\"floating-message\">${flashText}</div>`;}\n if(html!==lastToast){dom.toast.innerHTML=html;lastToast=html;}}\nfunction inputActivity(type){if(type)inputType=type;idle=0;if(attract){attract=false;toTitle();return true;}return false;}\nfunction keyboardLane(key){if(count===2&&!network.active){if(key==='\"'ArrowLeft')pending[0]=-1;if(key==='ArrowRight')pending[0]=1;if(key==='a')pending[1]=-1;if(key==='d')pending[1]=1;}else{if(key==='ArrowLeft'||key==='a')pending[0]=-1;if(key==='ArrowRight'||key==='d')pending[0]=1;}}\nwindow.addEventListener('keydown',e=>{\n if(e.target.matches('textarea'))return;\n if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' ','Tab'].includes(e.key))e.preventDefault();\n if(inputActivity('keyboard')){e.preventDefault();return;}audio.unlock();const key=e.key.length===1?e.key.toLowerCase():e.key;keys.add(key);\n if(e.repeat)return;\n if(screen==='play'){if(key==='Escape'||key==='p')pause();else keyboardLane(key);}\n else if(key==='Escape'||key==='p')back();else if(['ArrowDown','s','Tab'].includes(key))focusMenu(menuFocus+1);else if(['ArrowUp','w'].includes(key))focusMenu(menuFocus-1);else if(key==='Enter'||key===' '){const target=document.activeElement;if(target?.matches('button'))target.click();}else if(['ArrowLeft','ArrowRight','a','d'].includes(key))adjustFocused(key==='ArrowLeft'||key==='a'?-1:1);\n});\nwindow.addEventListener('keyup',e=>keys.delete(e.key.length===1?e.key.toLowerCase():e.key));\nwindow.addEventListener('blur',()=>{clearInputs();if(screen==='play'&&\"'!network.active)pause();});\nfunction adjustFocused(direction){const el=document.activeElement;if(el?.matches('\"'input[type=range]')){el.value=clamp(Number(el.value)+direction*Number(el.step||1),Number(el.min),Number(el.max));el.dispatchEvent(new Event('input',{bubbles:true}));}else if(el?.matches('.toggle-button'))el.click();}\ndocument.addEventListener('click',e=>{const target=e.target.closest('[data-action]');if(target){if(inputActivity(inputType==='touch'?'touch':inputType==='gamepad'?'gamepad':'keyboard'))return;perform(target.dataset.action);}});\ndocument.addEventListener('pointerover',e=>{if(e.pointerType==='touch')return;const target=e.target.closest('button,input,textarea');if(target&&dom.screens.contains(target)){const els=[...dom.screens.querySelectorAll('button:not(:disabled),input,textarea')];els.forEach(x=>x.classList.remove('focused'));target.classList.add('focused');menuFocus=els.indexOf(target);target.focus({preventScroll:true});}});\ndocument.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&(e.movementX||e.movementY)){inputActivity('keyboard');}});\ndocument.addEventListener('input',e=>{const el=e.target;if(el.dataset.setting){const k=el.dataset.setting;settings[k]=Number(el.value);if(k==='music')audio.setMusic(settings.music);else audio.setEffects(settings.effects);el.previousElementSibling?.querySelector('output')?.replaceChildren(document.createTextNode(Math.round(settings[k]*100)+'%'));saveSettings();}if(el.dataset.config){sim.config[el.dataset.config]=Number(el.value);devOpen=true;el.previousElementSibling?.querySelector('output')?.replaceChildren(document.createTextNode(el.value));}});\nconst pointers=new Map();\n\"'$('\"'#game-canvas').addEventListener('pointerdown',e=>{const wasAttract=inputActivity(e.pointerType==='touch'?'touch':'keyboard');audio.unlock();if(wasAttract||screen\"'!=='\"'play')return;e.preventDefault();if(e.pointerType==='touch'){pointers.set(e.pointerId,{x:e.clientX,y:e.clientY,lastY:e.clientY,left:e.clientX<innerWidth*.55});e.target.setPointerCapture(e.pointerId);if(e.clientX>innerWidth*.55)touchBoost=true;}else{const ndc=new THREE.Vector2(e.clientX/innerWidth*2-1,1-e.clientY/innerHeight*2);const ray=new THREE.Raycaster();ray.setFromCamera(ndc,scene.camera);const at=new THREE.Vector3();if(ray.ray.intersectPlane(new THREE.Plane(new THREE.Vector3(0,1,0),0),at)){const p=sim.players[network.active?Math.min(network.me,sim.players.length-1):0];let best=p.lane,dist=Infinity;for(let l=0;l<4;l++){for(let i=0;i<100;i++){const q=trackPoint(l,i/100);const d=Math.hypot(q.x-at.x,q.z-at.z);if(d<dist){dist=d;best=l;}}}pending[0]=Math.sign(best-p.lane);}}});\n\"'$('\"'#game-canvas').addEventListener('pointermove',e=>{const p=pointers.get(e.pointerId);if(\"'!p||!p.left)return;if(Math.abs(e.clientY-p.lastY)>24){pending[0]=e.clientY<p.lastY?-1:1;p.lastY=e.clientY;touchBrake=false;}else touchBrake=performance.now()%1000<0;});\nfunction endPointer(e){pointers.delete(e.pointerId);touchBoost=[...pointers.values()].some(p=>!p.left);touchBrake=false;}\nwindow.addEventListener('\"'pointerup',endPointer);window.addEventListener('pointercancel',endPointer);\ndom.touchBoost.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();inputActivity('touch');touchBoost=true;e.target.setPointerCapture(e.pointerId);});dom.touchBoost.addEventListener('pointerup',()=>touchBoost=false);dom.touchBoost.addEventListener('pointercancel',()=>touchBoost=false);\nwindow.addEventListener('touchstart',()=>{inputType='touch';if(screen==='play'){dom.touchMenu.hidden=false;dom.touchBoost.hidden=false;}},{passive:true});\nfunction pollPads(dt){const pads=Array.from(navigator.getGamepads?.()||[]).filter(p=>p?.connected);const out=[{},{}];pads.slice(0,2).forEach((p,index)=>{const old=padStates.get(p.index)||{};const down=i=>p.buttons[i]?.pressed;const axis=Math.abs(p.axes[0]||0)>.45?(p.axes[0]>0?1:-1):0;const vertical=Math.abs(p.axes[1]||0)>.55?(p.axes[1]>0?1:-1):0;const lane=down(14)?-1:down(15)?1:axis;const nav=down(12)?-1:down(13)?1:vertical;const any=p.buttons.some(b=>b.pressed)||axis||vertical;\n if(any){const switched=inputType\"'!=='\"'gamepad';if(inputActivity('gamepad')){padStates.set(p.index,{lane,nav,confirm:down(0),back:down(1),pause:down(9)});return;}if(switched&&screen\"'!=='\"'play')renderScreen();audio.unlock();}\n if(screen==='play'){if(down(9)&&\"'!old.pause)pause();out[index]={boost:!!(down(7)||down(0)),brake:!!(down(6)||down(2)),lane:lane&&lane!==old.lane?lane:0};}\n else if(index===0){if(down(0)&&!old.confirm)document.activeElement?.click();if((down(1)&&!old.back)||(down(9)&&!old.pause))back();if(nav&&(nav!==old.nav||gamepadTime-old.repeat>.2)){focusMenu(menuFocus+nav);old.repeat=gamepadTime;}if(lane&&lane!==old.lane)adjustFocused(lane);}\n padStates.set(p.index,{...old,lane,nav,confirm:down(0),back:down(1),pause:down(9)});\n });gamepadTime+=dt;return out;}\nfunction readInputs(pads){const p1={lane:pending[0]||pads[0].lane||0,boost:!!(keys.has('\"' ')||keys.has('ArrowUp')||keys.has('w')&&count===1||touchBoost||pads[0].boost),brake:\"'!!(keys.has('\"'ArrowDown')||keys.has('s')&&count===1||touchBrake||pads[0].brake),assist:inputType==='touch'&&settings.touchAssist};const p2={lane:pending[1]||pads[1].lane||0,boost:\"'!!(keys.has('\"'w')||pads[1].boost),brake:\"'!!(keys.has('\"'s')||pads[1].brake)};return[p1,p2];}\nfunction tick(dt,inputs){\n if(screen==='title'){idle+=dt;if(\"'!attract&&idle>=10){startGame(1,true);}if(attract&&(sim.phase==='\"'won'||sim.phase==='lost')){sim.countdown-=dt;if(sim.countdown<=0)startGame(1,true);}}\n const playing=screen==='play'||attract||(screen==='title'&&\"'!attract);\n if(playing&&!gameEnded){\n if(network.active){\n if(netCountdown){if(network.time()<0)return;netCountdown=false;sim.phase='\"'running';sim.countdown=0;}\n const local=inputs[0];if(network.isHost){const inputsByPlayer=network.players.map((p,i)=>{if(\"'!network.server&&p.id===network.me)return local;const remote=remoteInputs.get(p.id);if(!remote)return{};if(performance.now()-remote.received>600)return{};const clean={...remote.value};const last=lastRemoteSeq.get(p.id);if(clean.laneSeq===last)clean.lane=0;else lastRemoteSeq.set(p.id,clean.laneSeq);return clean;});if(screen!=='\"'play')inputsByPlayer.forEach(x=>{x.boost=false;x.brake=false;x.lane=0;});sim.tick(dt,inputsByPlayer);network.sendSnapshot(sim.snapshot());}\n else {network.sendInput({...local,laneSeq:networkLaneSeq});}\n }else {sim.tick(dt,inputs);}\n }\n}\nfunction advance(seconds){const max=Math.min(650,Math.max(0,seconds));const empty=[{},{}];for(let t=0;t<max;t+=1/60)tick(Math.min(1/60,max-t),empty);scene.update(0,sim,screen);updateHud();updateToast();return snapshot();}\nfunction frame(now){const dt=Math.min(.06,(now-lastTime)/1000||.016);lastTime=now;const pads=pollPads(dt);const inputs=readInputs(pads);if(inputs[0].lane)networkLaneSeq++;\n accumulator+=dt;let first=true;while(accumulator>=1/60){tick(1/60,first?inputs:inputs.map(p=>({...p,lane:0})));first=false;accumulator-=1/60;}if(\"'!first)pending=[0,0];\n if(ready){audio.tick(dt,sim.players.some(p=>p.boosting)?1.5:1);scene.update(dt,sim,screen);scene.render();if(Math.floor(now/75)!==Math.floor((now-dt*1000)/75))updateHud();updateToast();}\n requestAnimationFrame(frame);}\nasync function hostRoom(){try{netStatus='\"'Making an invite…';\"'$('\"'#network-status').textContent=netStatus;const code=await network.createOffer();if(screen\"'!=='\"'lobby')return;\"'$('\"'#lobby-codes').innerHTML=\"'`<p class=\"help\">1. Send this invite to your friend.</p><textarea id=\"connection-code\" class=\"code-box\" readonly aria-label=\"Invite code\">${code}</textarea>${button('\"'COPY INVITE','copy')}<p class=\\\"help\\\">2. Paste their reply here.</p><textarea id=\\\"connection-reply\\\" class=\\\"code-box\\\" aria-label=\\\"Reply code\\\" placeholder=\\\"Paste reply code\\\"></textarea>\"'${button('\"'CONNECT & DRIVE','sendReply',true)}\"'`;$('\"'#network-status').textContent='Invite ready. Waiting for your friend’s reply.';focusMenu(2);}catch(e){\"'$('\"'#network-status').textContent=e.message;}}\nfunction joinRoomUI(){\"'$('\"'#lobby-codes').innerHTML=\"'`<p class=\"help\">1. Paste the host’s invite.</p><textarea id=\"connection-reply\" class=\"code-box\" aria-label=\"Invite code\" placeholder=\"Paste invite code\"></textarea>${button('\"'MAKE MY REPLY','sendInvite',true)}\"'`;$('\"'#network-status').textContent='Ask the host for an invite code.';\"'$('\"'#connection-reply').focus();}\nasync function answerInvite(){try{const code=await network.joinOffer(\"'$('\"'#connection-reply').value);if(screen\"'!=='\"'lobby')return;\"'$('\"'#lobby-codes').innerHTML=\"'`<p class=\"help\">2. Send this reply to the host. The run starts when they connect.</p><textarea id=\"connection-code\" class=\"code-box\" readonly aria-label=\"Reply code\">${code}</textarea>${button('\"'COPY REPLY','copy',true)}\"'`;$('\"'#network-status').textContent='Reply ready. Keep this page open.';}catch(e){\"'$('\"'#network-status').textContent=e.message;}}\nasync function acceptReply(){try{await network.acceptAnswer(\"'$('\"'#connection-reply').value);if(\"'$('\"'#network-status'))\"'$('\"'#network-status').textContent='Connecting engines…';}catch(e){\"'$('\"'#network-status').textContent=e.message;}}\nasync function copyCode(){const field=\"'$('\"'#connection-code');try{await navigator.clipboard.writeText(field.value);showNotice('CODE COPIED. PASS IT ON.');}catch{field.select();document.execCommand('copy');showNotice('CODE SELECTED. COPY AND PASS IT ON.');}}\nfunction networkStart(info){count=info.players.length||2;startGame(count);netCountdown=true;sim.phase='countdown';sim.countdown=3;audio.unlock();setScreen('play');}\nfunction networkEnd(reason){gameEnded=true;clearInputs();audio.setMode('pause');if(reason==='host-left'||reason==='peer-disconnected')showNotice('YOUR CO-DRIVER LEFT THE CIRCUIT.');if(screen\"'!=='\"'results')setScreen('results');}\nfunction snapshot(){return{...sim.snapshot(),screen,paused:['paused','dev','settings','about','guide'].includes(screen),attract,renderer:scene.backend,rapier:\"'!!sim.world,config:{...sim.config},inputType,audio:audio.stats,network:{mode:network.mode,connected:network.connected,started:network.started,isHost:network.isHost,server:network.server,stats:{...network.stats}},music:settings.music,settings:{...settings}};}\nasync function boot(){try{\n $('\"'#loading-status').textContent='Starting Rapier 0.19.3…';await RAPIER.init();\n sim=new RiotSimulation(RAPIER,onEvent);scene=new RiotScene(\"'$('\"'#game-canvas'));\n \"'$('\"'#loading-status').textContent='Inking the WebGPU circuit…';await scene.init();\n network=new HubLink({onStatus:s=>{netStatus=s;const el=\"'$('\"'#network-status');if(el)el.textContent=s;},onStart:networkStart,onInput:(input,id)=>remoteInputs.set(id,{value:input,received:performance.now()}),onSnapshot:s=>{const oldPhase=sim.phase;sim.apply(s);if((s.phase==='won'||s.phase==='lost')&&oldPhase\"'!==s.phase&&!gameEnded){audio.sfx(s.phase==='\"'won'?'clear':'over');}},onEnd:networkEnd,onLeave:id=>{remoteInputs.delete(id);const idx=network.players.findIndex(p=>p.id===id);if(idx>=0&&sim.players[idx])sim.players[idx].ai=true;},onTimeUp:()=>{if(network.isHost)network.finish({score:sim.score,won:sim.phase==='won',stats:sim.stats});}});\n const hubInfo=await network.connect();\n sim.start(1,true);sim.phase='running';sim.attract=false;sim.players[0].ai=true;\n ready=true;dom.loading.hidden=true;audio.setMode('title');\n if(hubInfo){setScreen('hubwait');network.ready();}else setScreen('title');\n window.__game={snapshot,action:perform,step:advance,config:sim.config,input:keys,audio,network,sim,scene,metadata:METADATA};\n window.addEventListener('resize',()=>{scene.resize();lastHud='';updateHud();});\n requestAnimationFrame(frame);\n }catch(e){console.error(e);\"'$('\"'#loading').innerHTML=\"'`<div class=\"error-screen\"><span class=\"eyebrow\">ENGINE TROUBLE</span><h2>We couldn’t start this engine.</h2><p>${escapeHTML(e.message)}</p><p>Use a current browser with WebGPU or WebGL 2. The pinned Three.js and Rapier libraries need an internet connection on first load.</p><button class=\"menu-button\" onclick=\"location.reload()\">TRY AGAIN ↗</button></div>`;}}\nboot();\nEOF\ncat > Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/build.mjs <<'\"'EOF'\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {dirname,resolve} from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst dir=dirname(fileURLToPath(import.meta.url));\nconst stem=dir.split('/').pop();\nconst read=n=>readFileSync(resolve(dir,n),'utf8');\nconst metadata=JSON.parse(readFileSync(resolve(dir,'../exit-interview.json'),'utf8'));\nconst files=['sim.js','audio.js','hub.js','scene.js','main.js'];\nconst code=\\\"import * as THREE from 'three';\\\\nimport RAPIER from 'rapier';\\\\nconst METADATA=\\\"+JSON.stringify(metadata).replaceAll('<','\\\\\\\\u003c')+';\\\\n'+files.map(f=>read(f).replace(/export (?=class|function|const)/g,'')).join('\\\\n');\nlet html=read('index.template.html').replace('<\"'!--HUB_SESSION-->'\"','<script>\\\\n'+read('hub-reference/session.js')+'\\\\n</script>').replace('/*STYLE*/',read('style.css')).replace('/*MODULE*/',code);\nwriteFileSync(resolve(dir,'../'+stem+'.html'),html);\nconsole.log('Built '+stem+'.html ('+Math.round(Buffer.byteLength(html)/1024)+' KiB)');\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/main.js <<'EOF'\nconst \"'$=s=>document.querySelector(s);\nconst escapeHTML=s=>String(s).replace(/[&<>\"'\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst settings={music:.1,effects:.7,glyphs:'ps',touchAssist:true,reducedMotion:false};\ntry{Object.assign(settings,JSON.parse(localStorage.getItem('dodge-riot-settings')||'{}'));}catch{}\nconst audio=new AudioDirector();audio.setMusic(settings.music);audio.setEffects(settings.effects);\nlet scene,sim,network,screen='title',previousScreen='title',inputType='keyboard',idle=0,attract=false,devOpen=false,autopilot=false,ready=false,gameEnded=false,netCountdown=false,netStatus='',notice='',noticeUntil=0,lastTime=0,accumulator=0,lastHud='',lastToast='',count=1,highScore=0,gamepadTime=0;\nlet keys=new Set(),pending=[0,0],padStates=new Map(),remoteInputs=new Map(),touchBoost=false,touchBrake=false,touchLane=0,menuFocus=0,heldMenu='',heldMenuTime=0,networkLaneSeq=0,lastRemoteSeq=new Map();\ntry{highScore=Number(localStorage.getItem('dodge-riot-best')||0);}catch{}\nconst dom={screens:\"'$('\"'#screens'),hud:\"'$('\"'#hud'),toast:\"'$('\"'#toast'),loading:\"'$('\"'#loading'),touchMenu:\"'$('\"'#touch-menu'),touchBoost:\"'$('\"'#touch-boost')};\nconst glyph=(kind)=>inputType==='gamepad'?({confirm:settings.glyphs==='ps'?'✕':'A',back:settings.glyphs==='ps'?'○':'B',boost:settings.glyphs==='ps'?'R2':'RT',pause:'☰',lane:'◀ ▶'}[kind]):({confirm:'ENTER',back:'ESC',boost:'SPACE',pause:'ESC',lane:'← →'}[kind]);\nfunction saveSettings(){try{localStorage.setItem('dodge-riot-settings',JSON.stringify(settings));}catch{}}\nfunction button(label,action,primary=false,tail='↗'){return \"'`<button class=\"menu-button${primary?'\"' primary':''}\\\" data-action=\\\"\"'${action}\"><span>${label}</span><span class=\"glyph\">${tail}</span></button>`;}\nfunction panel(title,body,wide=false,kicker='\"'RIOT MOTOR CLUB'){return \"'`<div class=\"overlay\"><section class=\"panel${wide?'\"' wide':''}\\\" aria-label=\\\"\"'${title}\"><button class=\"panel-close\" data-action=\"back\" aria-label=\"Back\">×</button><span class=\"eyebrow\">${kicker}</span><h2>${title}</h2>${body}</section></div>`;}\nfunction showNotice(text,seconds=3){notice=text;noticeUntil=performance.now()+seconds*1000;document.querySelector('\"'.toast-small')?.remove();const m=document.createElement('div');m.className='toast-small';m.textContent=text;document.body.append(m);setTimeout(()=>m.remove(),seconds*1000);}\nfunction focusMenu(index=0){const els=[...dom.screens.querySelectorAll('button:not(:disabled),input,textarea')].filter(e=>e.offsetParent\"'!==null);if(!els.length)return;menuFocus=mod(index,els.length);els.forEach((e,i)=>e.classList.toggle('\"'focused',i===menuFocus));els[menuFocus].focus({preventScroll:true});els[menuFocus].scrollIntoView({block:'nearest',behavior:'instant'});}\nfunction setScreen(next){screen=next;lastHud='';lastToast='';renderScreen();}\nfunction renderScreen(){dom.hud.hidden=\"'!(screen==='\"'play'||(attract&&screen==='title'));dom.touchMenu.hidden=\"'!(inputType==='\"'touch'&&screen==='play');dom.touchBoost.hidden=\"'!(inputType==='\"'touch'&&screen==='play');\n if(screen==='title'){\n dom.screens.innerHTML=\"'`<section class=\"title-screen\"><div class=\"club-kicker eyebrow\">RIOT MOTOR CLUB · EST. 1980-ISH</div><h1>DODGE<span>RIOT</span></h1><p class=\"tagline\">Four lanes.<br>A full tank of trouble.</p><nav class=\"title-menu\">${button('\"'SOLO RUN','solo',true,glyph('confirm'))}\"'${button('\"'COUCH CO-OP','coop',false,'1 + 2')}\"'${button('\"'ONLINE CO-OP','online',false,'↔')}</nav><div class=\\\"small-buttons\\\"><button data-action=\\\"guide\\\">DRIVE 101</button><button data-action=\\\"settings\\\">SETTINGS</button><button data-action=\\\"about\\\">CREDITS</button></div><p class=\\\"attract-note\\\">\"'${highScore?'\"'CLUB RECORD '+highScore.toLocaleString():'NO REVERSE. NO REGRETS.'} &nbsp; / &nbsp; INSERT YOUR NERVE.</p><div class=\\\"title-edition\\\">THREE ROUNDS · ONE CLEAN GETAWAY</div><div class=\\\"title-stamp\\\"><strong>↗ ↗</strong><span>COLLECT THE LOT.<br>DODGE THE REST.</span></div></section>\"'${attract?'\"'<div class=\\\"demo-banner\\\">AUTO PILOT · PRESS ANYTHING TO TAKE THE WHEEL</div>':''}\"'`;\n }else if(screen==='\"'play'){dom.screens.innerHTML=network.active?\"'`<div class=\"network-indicator\">${network.hubActive?'\"'AI HUB':'DIRECT CO-OP'} · \"'${network.server?'\"'SIMULATION HOST':\"'`DRIVER ${network.me+1}`}</div>`:'\"'';\n }else if(screen==='paused'){\n dom.screens.innerHTML=panel('PIT STOP',\"'`<p>The road can wait a minute.</p>${button('\"'BACK TO THE RIOT','resume',true,glyph('confirm'))}\"'${button('\"'SETTINGS','settings')}\"'${button('\"'DEV GARAGE','dev')}\"'${button('\"'ABOUT & CREDITS','about')}\"'${button('\"'PARK IT / TITLE','title',false,glyph('back'))}\"'`);\n }else if(screen==='\"'guide'){\n dom.screens.innerHTML=panel('DRIVE 101',\"'`<div class=\"rule-card\"><div class=\"rule-icon\">•</div><div><strong>MAKE A CLEAN SWEEP</strong><span>Collect all 96 golden fares to clear a round. Complete three rounds to join the club. Your car drives clockwise; rivals come the other way.</span></div></div><div class=\"rule-card\"><div class=\"rule-icon\">⇄</div><div><strong>CHANGE AT THE CROSSINGS</strong><span>${inputType==='\"'gamepad'?'D-pad or left stick':inputType==='touch'?'Drag your left thumb up or down':'← / A inward. → / D outward.'} Pick a lane near any yellow crossing. An early turn waits for the next crossing.</span></div></div><div class=\\\"rule-card\\\"><div class=\\\"rule-icon\\\">ϟ</div><div><strong>ZIP. SLIP. RECHARGE.</strong><span>Hold \"'${glyph('\"'boost')} for a burst of speed and a brief half-second collision shield when it starts. Release to recharge. \"'${inputType==='\"'gamepad'?'L2 / LT':inputType==='touch'?'Hold the left side':'↓ / S'} brakes. Mint diamonds protect you for five seconds.</span></div></div><div class=\\\"rule-card\\\"><div class=\\\"rule-icon\\\">♥</div><div><strong>BRING A PAL</strong><span>Co-op shares four bumpers and one score. P1: arrows + Space. P2: A / D + W to zip, S to brake. Two pads work too. Touch adds steering assistance.</span></div></div>\"'${button('\"'GOT IT. LET’S ROLL.','back',true)}\"'`,false,'\"'READ THE ROAD');\n }else if(screen==='settings'){\n dom.screens.innerHTML=panel('TUNE UP',\"'`<div class=\"settings-row\"><label for=\"music\">MUSIC <output>${Math.round(settings.music*100)}%</output></label><input id=\"music\" data-setting=\"music\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${settings.music}\"></div><div class=\"settings-row\"><label for=\"effects\">SOUND & VOICES <output>${Math.round(settings.effects*100)}%</output></label><input id=\"effects\" data-setting=\"effects\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${settings.effects}\"></div><div class=\"settings-row\"><button class=\"toggle-button\" data-action=\"glyphs\">CONTROLLER GLYPHS <span style=\"float:right\">${settings.glyphs==='\"'ps'?'PLAYSTATION  ✕ ○':'XBOX  A B'}</span></button></div><div class=\\\"settings-row\\\"><button class=\\\"toggle-button\\\" data-action=\\\"assist\\\">TOUCH STEERING ASSIST <span style=\\\"float:right\\\">\"'${settings.touchAssist?'\"'ON':'OFF'}</span></button></div><div class=\\\"settings-row\\\"><button class=\\\"toggle-button\\\" data-action=\\\"motion\\\">REDUCED SCREEN SHAKE <span style=\\\"float:right\\\">\"'${settings.reducedMotion?'\"'ON':'OFF'}</span></button></div><p class=\\\"help\\\">Music starts at 10%. Audio wakes up on your first button press. Controls follow the input you use.</p>\"'${button('\"'BACK ON THE ROAD','back',true,glyph('back'))}\"'`);\n }else if(screen==='\"'dev'){\n const slider=(key,label,min,max,step=1)=>\"'`<div class=\"settings-row\"><label for=\"dev-${key}\">${label}<output>${sim.config[key]}</output></label><input id=\"dev-${key}\" data-config=\"${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${sim.config[key]}\"></div>`;\n dom.screens.innerHTML=panel('\"'DEV GARAGE',\"'`<p class=\"help\">Live tuning. Changes apply immediately. Practice tools keep this run out of the club record.</p><div class=\"dev-grid\">${slider('\"'speed','DRIVER SPEED',6,25,.2)}\"'${slider('\"'trafficSpeed','TRAFFIC SPEED',4,24,.2)}\"'${slider('\"'boostPower','ZIP MULTIPLIER',1.2,3,.05)}\"'${slider('\"'recharge','BATTERY RECHARGE',0,35,.5)}\"'${slider('\"'gateWindow','CROSSING FORGIVENESS',.5,5,.1)}\"'${slider('\"'lives','STARTING BUMPERS',1,9,1)}</div><div class=\\\"button-row\\\"><button class=\\\"toggle-button\\\" data-action=\\\"invincible\\\">INVINCIBLE: \"'${sim.config.invincible?'\"'ON':'OFF'}</button><button class=\\\"toggle-button\\\" data-action=\\\"autopilot\\\">AUTO DRIVE: \"'${autopilot?'\"'ON':'OFF'}</button></div><div class=\\\"button-row\\\">\"'${button('\"'REFILL','refill')}\"'${button('\"'CLEAR ROUND','collectAll')}\"'${button('\"'NEXT ROUND','nextRound')}</div><div class=\\\"button-row\\\">\"'${button('\"'RESET DEFAULTS','resetConfig')}\"'${button('\"'BACK TO PIT','back',true)}</div>\"'`,true,'\"'PRACTICE / LIVE BALANCE');\n }else if(screen==='about'){\n const info=METADATA.sourceInformation;const labels={date:'Date',source:'Source',plan:'Plan',genre:'Genre',perspective:'Perspective',tech:'Tech',artDirection:'Art direction',animation:'Animation',audio:'Audio',online:'Online',testing:'Testing',research:'Research',environment:'Environment',model:'Model',usage:'Usage'};\n let body=\"'`<p>A little car with a very big evening. Original game design, procedural models, music and voices made for this demo. Inspired by the lane-chasing spirit of Dodge Em (1980).</p><div class=\"feedback-title\">Source Information</div><dl class=\"credits-grid\">${Object.entries(info).map(([k,v])=>`<dt>${labels[k]||k}</dt><dd>${escapeHTML(v)}</dd>`).join('\"'')}</dl>\"'`;\n for(const [key,label] of [['\"'testingFeedback','Testing Feedback'],['engineFeedback','Engine Feedback'],['promptFeedback','Prompt Feedback']])body+=\"'`<div class=\"feedback-title\">${label}</div><ol class=\"feedback-list\">${METADATA[key].map(v=>`<li>${escapeHTML(v)}</li>`).join('\"'')}</ol>\"'`;\n body+=`<p class=\"help\">Three.js © its contributors, MIT. Rapier © Dimforge, Apache-2.0. AI Hub session client by michaelcrosato. All visuals and sound are generated in code. No external art or sound assets.</p>${button('\"'BACK','back',true)}\"'`;dom.screens.innerHTML=panel('\"'CLUB CREDITS',body,true,'SOURCE / MAKING OF');\n }else if(screen==='lobby'){\n dom.screens.innerHTML=panel('LONG-DISTANCE<br>DOUBLE TROUBLE',\"'`<p>Two drivers. One circuit. Share a connection code with a friend. For automatic rooms, launch from AI Hub.</p><div class=\"status-bar\" id=\"network-status\">${escapeHTML(netStatus||'\"'Choose a seat. No account needed.')}</div><div class=\\\"button-row\\\">\"'${button('\"'HOST A RUN','host',true)}\"'${button('\"'JOIN A RUN','join')}</div><div id=\\\"lobby-codes\\\"></div><p class=\\\"help\\\">Direct co-op uses an encrypted WebRTC connection. Swap invite and reply codes using your preferred messenger. Network firewalls may require an AI Hub room.</p>\"'${button('\"'BACK','back',false,glyph('back'))}\"'`,false,'\"'ONLINE CO-OP / TWO DRIVERS');\n }else if(screen==='results'){\n const won=sim.phase==='won';dom.screens.innerHTML=panel(won?'NICE DRIVING,<br>TROUBLEMAKER.':'END OF<br>THE ROAD.',\"'`<p>${gameEnded&&network.active?'\"'The shared run has ended.':won?'Three clean circuits. The club is impressed. Don’t let it go to your head.':'The bumpers have left the chat. Get back out there.'}</p><span class=\\\"eyebrow\\\">\"'${won?'\"'CLUB-APPROVED SCORE':'FINAL FARE'}</span><div class=\\\"results-score\\\">\"'${sim.score.toLocaleString()}</div><div class=\"results-stats\"><div><strong>${sim.stats.dots}</strong><small>FARES</small></div><div><strong>${sim.stats.closeCalls}</strong><small>CLOSE CALLS</small></div><div><strong>${sim.stats.boosts}</strong><small>ZIPS</small></div></div>${network.hubActive?'\"'<p class=\\\"help\\\">Your score has been returned to AI Hub. The host can start the next session.</p>':button('ONE MORE RUN','restart',true,glyph('confirm'))}\"'${network.hubActive?'\"'':button('BACK TO THE CLUB','title',false,glyph('back'))}\"'`);\n }else if(screen==='\"'hubwait')dom.screens.innerHTML=\"'`<div class=\"hub-wait\"><div><span class=\"eyebrow\">AI HUB · DODGE RIOT</span><h2>ENGINES READY.</h2><p>Waiting for the rest of the motor club.</p></div></div>`;\n if(screen!=='\"'play')focusMenu(0);updateHud();updateToast();\n}\nfunction startGame(players=1,isAttract=false){attract=isAttract;count=players;gameEnded=false;remoteInputs.clear();lastRemoteSeq.clear();sim.start(players,isAttract);sim.players.forEach(p=>p.ai=isAttract||autopilot);setScreen(isAttract?'title':'play');audio.setMode('play');if(\"'!isAttract)audio.sfx('\"'start');idle=0;clearInputs();}\nfunction toTitle(){if(network.active&&\"'!network.hubActive)network.disconnect();attract=false;gameEnded=false;autopilot=false;sim.start(1,true);sim.phase='\"'running';sim.attract=false;sim.players[0].ai=true;setScreen('title');audio.setMode('title');idle=0;clearInputs();}\nfunction pause(){if(screen\"'!=='\"'play'||attract)return;clearInputs();setScreen('paused');audio.setMode('pause');}\nfunction resume(){setScreen('play');clearInputs();audio.setMode('play');}\nfunction back(){if(screen==='settings'||screen==='about'||screen==='guide'){setScreen(previousScreen);return;}if(screen==='dev'){setScreen('paused');return;}if(screen==='lobby'){network.disconnect();toTitle();return;}if(screen==='paused')resume();else if(screen==='results'&&\"'!network.hubActive)toTitle();}\nfunction clearInputs(){keys.clear();pending=[0,0];touchBoost=false;touchBrake=false;}\nasync function perform(name,arg){\n if(!ready)return;audio.unlock();audio.sfx('\"'ui');idle=0;\n switch(name){\n case 'solo':startGame(1);break;case 'coop':startGame(2);break;case 'start':startGame(arg?.players||1);break;\n case 'pause':pause();break;case 'resume':resume();break;case 'back':back();break;\n case 'settings':case 'about':case 'guide':previousScreen=screen;setScreen(name);break;\n case 'online':netStatus='';setScreen('lobby');break;\n case 'dev':devOpen=true;setScreen('dev');break;\n case 'title':toTitle();break;case 'restart':if(network.active)network.disconnect();startGame(count);break;\n case 'glyphs':settings.glyphs=settings.glyphs==='ps'?'xbox':'ps';saveSettings();renderScreen();break;\n case 'assist':settings.touchAssist=\"'!settings.touchAssist;saveSettings();renderScreen();break;\n case '\"'motion':settings.reducedMotion=\"'!settings.reducedMotion;saveSettings();renderScreen();break;\n case '\"'setConfig':if(arg&&arg.key in sim.config){sim.config[arg.key]=arg.value;devOpen=true;}break;\n case 'resetConfig':Object.assign(sim.config,DEFAULTS);autopilot=false;sim.players.forEach(p=>p.ai=attract);if(screen==='dev')renderScreen();break;\n case 'invincible':sim.config.invincible=\"'!sim.config.invincible;renderScreen();break;\n case '\"'autopilot':autopilot=typeof arg==='boolean'?arg:\"'!autopilot;sim.players.forEach(p=>p.ai=autopilot||attract);if(screen==='\"'dev')renderScreen();break;\n case 'refill':sim.lives=Math.round(sim.config.lives);sim.players.forEach(p=>{p.charge=100;p.invuln=5;});showNotice('BUMPER TO BUMPER. GOOD AS NEW.');break;\n case 'collectAll':sim.collectAll();if(screen==='dev')resume();break;\n case 'nextRound':sim.loadRound(sim.round%3+1);sim.players.forEach(p=>p.ai=autopilot);resume();break;\n case 'warpRound':sim.loadRound(Number(arg)||1);sim.players.forEach(p=>p.ai=autopilot);setScreen('play');break;\n case 'hit':sim.hit();break;case 'charge':sim.players.forEach(p=>p.charge=Number(arg)||100);break;\n case 'attract':startGame(1,true);break;case 'finish':sim.phase='won';onEvent('win');break;\n case 'host':await hostRoom();break;case 'join':joinRoomUI();break;case 'sendInvite':await answerInvite();break;case 'sendReply':await acceptReply();break;\n case 'copy':copyCode();break;\n }\n updateHud();updateToast();\n}\nfunction onEvent(name,data={}){if(\"'!ready&&name!=='\"'round')return;\n if(name==='dot'){if(\"'!attract)audio.sfx(data.mult>1&&sim.combo%12===0?'\"'combo':'dot');const p=trackPoint(data.lane,data.progress);scene?.burst(p.x,p.z,data.shield?'#91dfba':'#f3cf6a',3);}\n else if(name==='lane'){if(\"'!attract)audio.sfx('\"'lane');}\n else if(name==='boost'){if(\"'!attract)audio.sfx('\"'boost');}\n else if(name==='shield'){audio.sfx('shield');flash('BUMPER BUBBLE\"'!'\"');}\n else if(name==='close'){if(\"'!attract){audio.sfx('\"'combo');flash('CLOSE CALL +25');}}\n else if(name==='hit'){audio.sfx('hit');if(\"'!settings.reducedMotion)scene.shake=1;const p=carPoint(sim.players[data.player||0]);scene.burst(p.x,p.z,'\"'#f37c43',24);flash('THAT’LL BUFF OUT.');rumble(.8,350);}\n else if(name==='go'){if(\"'!attract)audio.sfx('\"'start');}\n else if(name==='clear'){audio.sfx('clear');audio.sfx('voice');for(let i=0;i<14;i++)scene.burst((Math.random()-.5)*25,(Math.random()-.5)*18,i%2?'#f5cc61':'#91dfba',6);rumble(.3,200);}\n else if(name==='win'||name==='lose'){\n if(attract){sim.countdown=5;return;}\n if(network.active&&network.isHost)network.finish({score:sim.score,won:name==='win',stats:sim.stats});\n audio.sfx(name==='win'?'clear':'over');audio.setMode(name==='win'?'win':'pause');\n if(\"'!devOpen&&sim.score>highScore){highScore=sim.score;try{localStorage.setItem('\"'dodge-riot-best',highScore);}catch{}}\n setScreen('results');clearInputs();\n }\n}\nlet flashText='',flashUntil=0;\nfunction flash(text){flashText=text;flashUntil=performance.now()+1100;}\nfunction rumble(power,duration){for(const pad of navigator.getGamepads?.()||[])if(pad?.vibrationActuator)pad.vibrationActuator.playEffect('dual-rumble',{duration,strongMagnitude:power,weakMagnitude:power*.6}).catch(()=>{});}\nfunction updateHud(){if(\"'!sim.players.length)return;const s=sim;const dots=s.dots.filter(d=>!d.collected).length;let html=`<div class=\"hud\"><div class=\"hud-top\"><div class=\"hud-block\"><span class=\"eyebrow\">CIRCUIT ${String(s.round).padStart(2,'\"'0')} / 03</span><div class=\\\"hud-value\\\">\"'${dots} <span style=\"font-size:.48em;letter-spacing:1px\">TO GO</span></div><div class=\"dots-progress\"><i style=\"width:${(96-dots)/96*100}%\"></i></div><div class=\"round-name\">${ROUND_INFO[s.round-1].name}</div></div><div class=\"hud-block hud-score\"><span class=\"eyebrow\">${s.combo>=12?`FARE STREAK ×${1+Math.min(4,Math.floor(s.combo/12))}`:'\"'CLUB SCORE'}</span><div class=\\\"hud-value\\\">\"'${String(s.score).padStart(6,'\"'0')}</div></div><div class=\\\"hud-right\\\"><div class=\\\"hud-block\\\"><span class=\\\"eyebrow\\\">\"'${s.players.length>1?'\"'SHARED BUMPERS':'BUMPER BUDGET'}</span><div class=\\\"hud-value hearts\\\">\"'${'\"'♥'.repeat(Math.max(0,Math.min(9,s.lives)))}\"'${'\"'♡'.repeat(Math.max(0,Math.min(4,Math.round(s.config.lives))-s.lives))}</div></div><button class=\\\"hud-pause\\\" data-action=\\\"pause\\\" aria-label=\\\"Pause\\\">Ⅱ</button></div></div><div class=\\\"hud-bottom\\\">\"'`;\n const card=(p,i)=>`<div class=\"driver-card ${i?'\"'p2':''}\\\"><div class=\\\"driver-head\\\"><span>\"'${i?'\"'MINT / DRIVER 2':'TANGERINE / DRIVER 1'}</span><span>\"'${p.invuln>.1?'\"'◈':p.boosting?'ZIP\"'!'\"':Math.round(p.charge)+'%'}</span></div><div class=\\\"charge-track\\\"><div class=\\\"charge-fill\\\" style=\\\"width:\"'${Math.round(p.charge)}%\"></div></div><div class=\"driver-foot\"><span>${p.queued?(p.queued<0?'\"'← IN':'OUT →')+' AT CROSSING':p.invuln>0?'BUMPER BUBBLE':p.braking?'TAKING IT EASY':'READY TO ZIP'}</span><span>\"'${i?(inputType==='\"'gamepad'?glyph('boost'):'W'):glyph('boost')}</span></div></div>\"'`;\n html+=card(s.players[0],0);html+=`<div class=\"controls-strip\">${inputType==='\"'touch'?'LEFT THUMB ↕ STEER · ZIP ON THE RIGHT':inputType==='gamepad'?'<span class=\\\"key\\\">◀</span> IN &nbsp; <span class=\\\"key\\\">▶</span> OUT &nbsp; <span class=\\\"key\\\">'+glyph('boost')+'</span> ZIP &nbsp; <span class=\\\"key\\\">L2</span> BRAKE':'<span class=\\\"key\\\">←</span> IN &nbsp; <span class=\\\"key\\\">→</span> OUT &nbsp; <span class=\\\"key\\\">SPACE</span> ZIP &nbsp; <span class=\\\"key\\\">↓</span> BRAKE'}<br><span style=\\\"font-size:.83em;opacity:.8\\\">SWITCH LANES AT THE FOUR YELLOW CROSSINGS</span></div>\"'`;if(s.players[1])html+=card(s.players[1],1);else html+='\"'<div style=\\\"width:245px\\\" class=\\\"hud-spacer\\\"></div>';html+='</div></div>';\n if(html\"'!==lastHud){dom.hud.innerHTML=html;lastHud=html;}\n dom.hud.hidden=!(screen==='\"'play'||(attract&&screen==='title'));\n}\nfunction updateToast(){let html='';if(screen==='play'||attract){if(netCountdown&&network.time()<0){html=\"'`<div class=\"big-call\">${Math.max(1,Math.ceil(-network.time()/1000))}</div><div class=\"call-sub\">DRIVERS READY</div>`;}else if(sim.phase==='\"'countdown'){html=\"'`<div class=\"big-call\">${Math.max(1,Math.ceil(sim.countdown))}</div><div class=\"call-sub\">${ROUND_INFO[sim.round-1].name}</div>`;}else if(sim.phase==='\"'clear')html=\"'`<div class=\"big-call\">CIRCUIT<br>CLEAN!</div><div class=\"call-sub\">${sim.round<3?'\"'NEXT STOP: '+ROUND_INFO[sim.round].name:'WELCOME TO THE CLUB'}</div>\"'`;else if(sim.phase==='\"'running'&&sim.roundTime<1)html='<div class=\\\"big-call\\\" style=\\\"color:#f49a47\\\">LET’S ZIP\"'!</div>'\"';else if(performance.now()<flashUntil)html=\"'`<div class=\"floating-message\">${flashText}</div>`;}\n if(html!==lastToast){dom.toast.innerHTML=html;lastToast=html;}}\nfunction inputActivity(type){if(type)inputType=type;idle=0;if(attract){attract=false;toTitle();return true;}return false;}\nfunction keyboardLane(key){if(count===2&&!network.active){if(key==='\"'ArrowLeft')pending[0]=-1;if(key==='ArrowRight')pending[0]=1;if(key==='a')pending[1]=-1;if(key==='d')pending[1]=1;}else{if(key==='ArrowLeft'||key==='a')pending[0]=-1;if(key==='ArrowRight'||key==='d')pending[0]=1;}}\nwindow.addEventListener('keydown',e=>{\n if(e.target.matches('textarea'))return;\n if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' ','Tab'].includes(e.key))e.preventDefault();\n if(inputActivity('keyboard')){e.preventDefault();return;}audio.unlock();const key=e.key.length===1?e.key.toLowerCase():e.key;keys.add(key);\n if(e.repeat)return;\n if(screen==='play'){if(key==='Escape'||key==='p')pause();else keyboardLane(key);}\n else if(key==='Escape'||key==='p')back();else if(['ArrowDown','s','Tab'].includes(key))focusMenu(menuFocus+1);else if(['ArrowUp','w'].includes(key))focusMenu(menuFocus-1);else if(key==='Enter'||key===' '){const target=document.activeElement;if(target?.matches('button'))target.click();}else if(['ArrowLeft','ArrowRight','a','d'].includes(key))adjustFocused(key==='ArrowLeft'||key==='a'?-1:1);\n});\nwindow.addEventListener('keyup',e=>keys.delete(e.key.length===1?e.key.toLowerCase():e.key));\nwindow.addEventListener('blur',()=>{clearInputs();if(screen==='play'&&\"'!network.active)pause();});\nfunction adjustFocused(direction){const el=document.activeElement;if(el?.matches('\"'input[type=range]')){el.value=clamp(Number(el.value)+direction*Number(el.step||1),Number(el.min),Number(el.max));el.dispatchEvent(new Event('input',{bubbles:true}));}else if(el?.matches('.toggle-button'))el.click();}\ndocument.addEventListener('click',e=>{const target=e.target.closest('[data-action]');if(target){if(inputActivity(inputType==='touch'?'touch':inputType==='gamepad'?'gamepad':'keyboard'))return;perform(target.dataset.action);}});\ndocument.addEventListener('pointerover',e=>{if(e.pointerType==='touch')return;const target=e.target.closest('button,input,textarea');if(target&&dom.screens.contains(target)){const els=[...dom.screens.querySelectorAll('button:not(:disabled),input,textarea')];els.forEach(x=>x.classList.remove('focused'));target.classList.add('focused');menuFocus=els.indexOf(target);target.focus({preventScroll:true});}});\ndocument.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&(e.movementX||e.movementY)){inputActivity('keyboard');}});\ndocument.addEventListener('input',e=>{const el=e.target;if(el.dataset.setting){const k=el.dataset.setting;settings[k]=Number(el.value);if(k==='music')audio.setMusic(settings.music);else audio.setEffects(settings.effects);el.previousElementSibling?.querySelector('output')?.replaceChildren(document.createTextNode(Math.round(settings[k]*100)+'%'));saveSettings();}if(el.dataset.config){sim.config[el.dataset.config]=Number(el.value);devOpen=true;el.previousElementSibling?.querySelector('output')?.replaceChildren(document.createTextNode(el.value));}});\nconst pointers=new Map();\n\"'$('\"'#game-canvas').addEventListener('pointerdown',e=>{const wasAttract=inputActivity(e.pointerType==='touch'?'touch':'keyboard');audio.unlock();if(wasAttract||screen\"'!=='\"'play')return;e.preventDefault();if(e.pointerType==='touch'){pointers.set(e.pointerId,{x:e.clientX,y:e.clientY,lastY:e.clientY,left:e.clientX<innerWidth*.55});e.target.setPointerCapture(e.pointerId);if(e.clientX>innerWidth*.55)touchBoost=true;}else{const ndc=new THREE.Vector2(e.clientX/innerWidth*2-1,1-e.clientY/innerHeight*2);const ray=new THREE.Raycaster();ray.setFromCamera(ndc,scene.camera);const at=new THREE.Vector3();if(ray.ray.intersectPlane(new THREE.Plane(new THREE.Vector3(0,1,0),0),at)){const p=sim.players[network.active?Math.min(network.me,sim.players.length-1):0];let best=p.lane,dist=Infinity;for(let l=0;l<4;l++){for(let i=0;i<100;i++){const q=trackPoint(l,i/100);const d=Math.hypot(q.x-at.x,q.z-at.z);if(d<dist){dist=d;best=l;}}}pending[0]=Math.sign(best-p.lane);}}});\n\"'$('\"'#game-canvas').addEventListener('pointermove',e=>{const p=pointers.get(e.pointerId);if(\"'!p||!p.left)return;if(Math.abs(e.clientY-p.lastY)>24){pending[0]=e.clientY<p.lastY?-1:1;p.lastY=e.clientY;touchBrake=false;}else touchBrake=performance.now()%1000<0;});\nfunction endPointer(e){pointers.delete(e.pointerId);touchBoost=[...pointers.values()].some(p=>!p.left);touchBrake=false;}\nwindow.addEventListener('\"'pointerup',endPointer);window.addEventListener('pointercancel',endPointer);\ndom.touchBoost.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();inputActivity('touch');touchBoost=true;e.target.setPointerCapture(e.pointerId);});dom.touchBoost.addEventListener('pointerup',()=>touchBoost=false);dom.touchBoost.addEventListener('pointercancel',()=>touchBoost=false);\nwindow.addEventListener('touchstart',()=>{inputType='touch';if(screen==='play'){dom.touchMenu.hidden=false;dom.touchBoost.hidden=false;}},{passive:true});\nfunction pollPads(dt){const pads=Array.from(navigator.getGamepads?.()||[]).filter(p=>p?.connected);const out=[{},{}];pads.slice(0,2).forEach((p,index)=>{const old=padStates.get(p.index)||{};const down=i=>p.buttons[i]?.pressed;const axis=Math.abs(p.axes[0]||0)>.45?(p.axes[0]>0?1:-1):0;const vertical=Math.abs(p.axes[1]||0)>.55?(p.axes[1]>0?1:-1):0;const lane=down(14)?-1:down(15)?1:axis;const nav=down(12)?-1:down(13)?1:vertical;const any=p.buttons.some(b=>b.pressed)||axis||vertical;\n if(any){const switched=inputType\"'!=='\"'gamepad';if(inputActivity('gamepad')){padStates.set(p.index,{lane,nav,confirm:down(0),back:down(1),pause:down(9)});return;}if(switched&&screen\"'!=='\"'play')renderScreen();audio.unlock();}\n if(screen==='play'){if(down(9)&&\"'!old.pause)pause();out[index]={boost:!!(down(7)||down(0)),brake:!!(down(6)||down(2)),lane:lane&&lane!==old.lane?lane:0};}\n else if(index===0){if(down(0)&&!old.confirm)document.activeElement?.click();if((down(1)&&!old.back)||(down(9)&&!old.pause))back();if(nav&&(nav!==old.nav||gamepadTime-old.repeat>.2)){focusMenu(menuFocus+nav);old.repeat=gamepadTime;}if(lane&&lane!==old.lane)adjustFocused(lane);}\n padStates.set(p.index,{...old,lane,nav,confirm:down(0),back:down(1),pause:down(9)});\n });gamepadTime+=dt;return out;}\nfunction readInputs(pads){const p1={lane:pending[0]||pads[0].lane||0,boost:!!(keys.has('\"' ')||keys.has('ArrowUp')||keys.has('w')&&count===1||touchBoost||pads[0].boost),brake:\"'!!(keys.has('\"'ArrowDown')||keys.has('s')&&count===1||touchBrake||pads[0].brake),assist:inputType==='touch'&&settings.touchAssist};const p2={lane:pending[1]||pads[1].lane||0,boost:\"'!!(keys.has('\"'w')||pads[1].boost),brake:\"'!!(keys.has('\"'s')||pads[1].brake)};return[p1,p2];}\nfunction tick(dt,inputs){\n if(screen==='title'){idle+=dt;if(\"'!attract&&idle>=10){startGame(1,true);}if(attract&&(sim.phase==='\"'won'||sim.phase==='lost')){sim.countdown-=dt;if(sim.countdown<=0)startGame(1,true);}}\n const playing=screen==='play'||attract||(screen==='title'&&\"'!attract);\n if(playing&&!gameEnded){\n if(network.active){\n if(netCountdown){if(network.time()<0)return;netCountdown=false;sim.phase='\"'running';sim.countdown=0;}\n const local=inputs[0];if(network.isHost){const inputsByPlayer=network.players.map((p,i)=>{if(\"'!network.server&&p.id===network.me)return local;const remote=remoteInputs.get(p.id);if(!remote)return{};if(performance.now()-remote.received>600)return{};const clean={...remote.value};const last=lastRemoteSeq.get(p.id);if(clean.laneSeq===last)clean.lane=0;else lastRemoteSeq.set(p.id,clean.laneSeq);return clean;});if(screen!=='\"'play')inputsByPlayer.forEach(x=>{x.boost=false;x.brake=false;x.lane=0;});sim.tick(dt,inputsByPlayer);network.sendSnapshot(sim.snapshot());}\n else {network.sendInput({...local,laneSeq:networkLaneSeq});}\n }else {sim.tick(dt,inputs);}\n }\n}\nfunction advance(seconds){const max=Math.min(650,Math.max(0,seconds));const empty=[{},{}];for(let t=0;t<max;t+=1/60)tick(Math.min(1/60,max-t),empty);scene.update(0,sim,screen);updateHud();updateToast();return snapshot();}\nfunction frame(now){const dt=Math.min(.06,(now-lastTime)/1000||.016);lastTime=now;const pads=pollPads(dt);const inputs=readInputs(pads);if(inputs[0].lane)networkLaneSeq++;\n accumulator+=dt;let first=true;while(accumulator>=1/60){tick(1/60,first?inputs:inputs.map(p=>({...p,lane:0})));first=false;accumulator-=1/60;}if(\"'!first)pending=[0,0];\n if(ready){audio.tick(dt,sim.players.some(p=>p.boosting)?1.5:1);scene.update(dt,sim,screen);scene.render();if(Math.floor(now/75)!==Math.floor((now-dt*1000)/75))updateHud();updateToast();}\n requestAnimationFrame(frame);}\nasync function hostRoom(){try{netStatus='\"'Making an invite…';\"'$('\"'#network-status').textContent=netStatus;const code=await network.createOffer();if(screen\"'!=='\"'lobby')return;\"'$('\"'#lobby-codes').innerHTML=\"'`<p class=\"help\">1. Send this invite to your friend.</p><textarea id=\"connection-code\" class=\"code-box\" readonly aria-label=\"Invite code\">${code}</textarea>${button('\"'COPY INVITE','copy')}<p class=\\\"help\\\">2. Paste their reply here.</p><textarea id=\\\"connection-reply\\\" class=\\\"code-box\\\" aria-label=\\\"Reply code\\\" placeholder=\\\"Paste reply code\\\"></textarea>\"'${button('\"'CONNECT & DRIVE','sendReply',true)}\"'`;$('\"'#network-status').textContent='Invite ready. Waiting for your friend’s reply.';focusMenu(2);}catch(e){\"'$('\"'#network-status').textContent=e.message;}}\nfunction joinRoomUI(){\"'$('\"'#lobby-codes').innerHTML=\"'`<p class=\"help\">1. Paste the host’s invite.</p><textarea id=\"connection-reply\" class=\"code-box\" aria-label=\"Invite code\" placeholder=\"Paste invite code\"></textarea>${button('\"'MAKE MY REPLY','sendInvite',true)}\"'`;$('\"'#network-status').textContent='Ask the host for an invite code.';\"'$('\"'#connection-reply').focus();}\nasync function answerInvite(){try{const code=await network.joinOffer(\"'$('\"'#connection-reply').value);if(screen\"'!=='\"'lobby')return;\"'$('\"'#lobby-codes').innerHTML=\"'`<p class=\"help\">2. Send this reply to the host. The run starts when they connect.</p><textarea id=\"connection-code\" class=\"code-box\" readonly aria-label=\"Reply code\">${code}</textarea>${button('\"'COPY REPLY','copy',true)}\"'`;$('\"'#network-status').textContent='Reply ready. Keep this page open.';}catch(e){\"'$('\"'#network-status').textContent=e.message;}}\nasync function acceptReply(){try{await network.acceptAnswer(\"'$('\"'#connection-reply').value);if(\"'$('\"'#network-status'))\"'$('\"'#network-status').textContent='Connecting engines…';}catch(e){\"'$('\"'#network-status').textContent=e.message;}}\nasync function copyCode(){const field=\"'$('\"'#connection-code');try{await navigator.clipboard.writeText(field.value);showNotice('CODE COPIED. PASS IT ON.');}catch{field.select();document.execCommand('copy');showNotice('CODE SELECTED. COPY AND PASS IT ON.');}}\nfunction networkStart(info){count=info.players.length||2;startGame(count);netCountdown=true;sim.phase='countdown';sim.countdown=3;audio.unlock();setScreen('play');}\nfunction networkEnd(reason){gameEnded=true;clearInputs();audio.setMode('pause');if(reason==='host-left'||reason==='peer-disconnected')showNotice('YOUR CO-DRIVER LEFT THE CIRCUIT.');if(screen\"'!=='\"'results')setScreen('results');}\nfunction snapshot(){return{...sim.snapshot(),screen,paused:['paused','dev','settings','about','guide'].includes(screen),attract,renderer:scene.backend,rapier:\"'!!sim.world,config:{...sim.config},inputType,audio:audio.stats,network:{mode:network.mode,connected:network.connected,started:network.started,isHost:network.isHost,server:network.server,stats:{...network.stats}},music:settings.music,settings:{...settings}};}\nasync function boot(){try{\n $('\"'#loading-status').textContent='Starting Rapier 0.19.3…';await RAPIER.init();\n sim=new RiotSimulation(RAPIER,onEvent);scene=new RiotScene(\"'$('\"'#game-canvas'));\n \"'$('\"'#loading-status').textContent='Inking the WebGPU circuit…';await scene.init();\n network=new HubLink({onStatus:s=>{netStatus=s;const el=\"'$('\"'#network-status');if(el)el.textContent=s;},onStart:networkStart,onInput:(input,id)=>remoteInputs.set(id,{value:input,received:performance.now()}),onSnapshot:s=>{const oldPhase=sim.phase;sim.apply(s);if((s.phase==='won'||s.phase==='lost')&&oldPhase\"'!==s.phase&&!gameEnded){audio.sfx(s.phase==='\"'won'?'clear':'over');}},onEnd:networkEnd,onLeave:id=>{remoteInputs.delete(id);const idx=network.players.findIndex(p=>p.id===id);if(idx>=0&&sim.players[idx])sim.players[idx].ai=true;},onTimeUp:()=>{if(network.isHost)network.finish({score:sim.score,won:sim.phase==='won',stats:sim.stats});}});\n const hubInfo=await network.connect();\n sim.start(1,true);sim.phase='running';sim.attract=false;sim.players[0].ai=true;\n ready=true;dom.loading.hidden=true;audio.setMode('title');\n if(hubInfo){setScreen('hubwait');network.ready();}else setScreen('title');\n window.__game={snapshot,action:perform,step:advance,config:sim.config,input:keys,audio,network,sim,scene,metadata:METADATA};\n window.addEventListener('resize',()=>{scene.resize();lastHud='';updateHud();});\n requestAnimationFrame(frame);\n }catch(e){console.error(e);\"'$('\"'#loading').innerHTML=\"'`<div class=\"error-screen\"><span class=\"eyebrow\">ENGINE TROUBLE</span><h2>We couldn’t start this engine.</h2><p>${escapeHTML(e.message)}</p><p>Use a current browser with WebGPU or WebGL 2. The pinned Three.js and Rapier libraries need an internet connection on first load.</p><button class=\"menu-button\" onclick=\"location.reload()\">TRY AGAIN ↗</button></div>`;}}\nboot();\nEOF\ncat > Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/build.mjs <<'\"'EOF'\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {dirname,resolve} from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst dir=dirname(fileURLToPath(import.meta.url));\nconst stem=dir.split('/').pop();\nconst read=n=>readFileSync(resolve(dir,n),'utf8');\nconst metadata=JSON.parse(readFileSync(resolve(dir,'../exit-interview.json'),'utf8'));\nconst files=['sim.js','audio.js','hub.js','scene.js','main.js'];\nconst code=\\\"import * as THREE from 'three';\\\\nimport RAPIER from 'rapier';\\\\nconst METADATA=\\\"+JSON.stringi