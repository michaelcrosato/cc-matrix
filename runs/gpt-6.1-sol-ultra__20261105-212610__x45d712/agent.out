of this.enemies){if(this.world.intersectionPair(p.collider,e.collider)){if(p.invuln<=0&&p.boostGrace<=0&&\"'!this.attract&&!this.config.invincible)this.hit(p);else if(e.nearCooldown<=0){e.nearCooldown=2;this.stats.closeCalls++;this.score+=50;this.emit('\"'close',{player:p.id});}}\n else if(\"'!e.nearCooldown&&Math.hypot(carPoint(p).x-carPoint(e).x,carPoint(p).z-carPoint(e).z)<2.8){e.nearCooldown=2;this.score+=25;this.stats.closeCalls++;this.emit('\"'close',{player:p.id});}}\n });\n if(this.dots.every(d=>d.collected)&&this.phase==='running'){this.phase='clear';this.countdown=3.2;this.score+=500+Math.max(0,Math.floor(120-this.roundTime))*5;this.emit('clear',{round:this.round});}\n }\n hit(p=this.players[0]){if(this.phase\"'!=='\"'running')return;this.lives--;this.stats.hits++;this.combo=0;p.invuln=3.5;p.charge=Math.max(p.charge,35);this.emit('hit',{player:p.id});if(this.lives<=0){this.phase='lost';this.emit('lose');}}\n collectAll(){for(const d of this.dots)if(\"'!d.collected){d.collected=true;d.collider.setEnabled(false);this.stats.dots++;this.score+=10;}if(this.phase==='\"'countdown')this.phase='running';this.tick(1/60,[]);}\n snapshot(){return{phase:this.phase,round:this.round,roundTime:this.roundTime,score:this.score,lives:this.lives,time:this.time,countdown:this.countdown,combo:this.combo,serial:this.serial,attract:this.attract,players:this.players.map(({id,lane,progress,direction,charge,invuln,boosting,queued,change,braking,boostGrace})=>({id,lane,progress,direction,charge,invuln,boosting,queued,change:change?{...change}:null,braking,boostGrace})),enemies:this.enemies.map(({id,lane,progress,direction,change})=>({id,lane,progress,direction,change:change?{...change}:null})),dots:this.dots.map(d=>d.collected?1:0),dotsLeft:this.dots.filter(d=>\"'!d.collected).length,stats:{...this.stats}};}\n apply(s){if(this.round!==s.round||!this.world||this.players.length!==s.players.length){this.count=s.players.length;this.loadRound(s.round);}for(const key of ['\"'phase','round','roundTime','score','lives','time','countdown','combo','attract','stats'])this[key]=s[key];s.players.forEach((p,i)=>Object.assign(this.players[i],p));s.enemies.forEach((e,i)=>this.enemies[i]&&Object.assign(this.enemies[i],e));s.dots.forEach((d,i)=>this.dots[i].collected=\"'!!d);}\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/scene.js <<'EOF'\nclass RiotScene {\n constructor(canvas){this.canvas=canvas;this.scene=new THREE.Scene();this.scene.background=new THREE.Color('#ddbd87');this.camera=new THREE.OrthographicCamera(-25,25,16,-16,.1,150);this.camera.position.set(0,38,28);this.camera.lookAt(0,0,0);this.root=new THREE.Group();this.scene.add(this.root);this.effects=[];this.cars=[];this.dotMeshes=[];this.materials={};this.serial=-1;this.clock=0;this.shake=0;this.ready=false;}\n async init(){this.renderer=new THREE.WebGPURenderer({canvas:this.canvas,antialias:true,alpha:false});this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.outputColorSpace=THREE.SRGBColorSpace;await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2 fallback';this.scene.add(new THREE.HemisphereLight(0xfff4cf,0x263e44,2.3));const light=new THREE.DirectionalLight(0xfff2c6,3.2);light.position.set(-10,30,12);this.scene.add(light);this.buildWorld();this.resize();this.ready=true;}\n mat(color,unlit=false){const key=color+unlit;if(\"'!this.materials[key])this.materials[key]=unlit?new THREE.MeshBasicMaterial({color}):new THREE.MeshToonMaterial({color,gradientMap:this.gradient()});return this.materials[key];}\n gradient(){if(this.grad)return this.grad;const data=new Uint8Array([75,155,255]);this.grad=new THREE.DataTexture(data,3,1,THREE.RedFormat);this.grad.minFilter=THREE.NearestFilter;this.grad.magFilter=THREE.NearestFilter;this.grad.needsUpdate=true;return this.grad;}\n mesh(geo,color,parent=this.root,ink=false){const m=new THREE.Mesh(geo,this.mat(color));parent.add(m);if(ink){const l=new THREE.LineSegments(new THREE.EdgesGeometry(geo,25),new THREE.LineBasicMaterial({color:0x142a2d}));m.add(l);}return m;}\n box(w,h,d,color,x,y,z,parent=this.root,ink=true){const m=this.mesh(new THREE.BoxGeometry(w,h,d),color,parent,ink);m.position.set(x,y,z);return m;}\n ringShape(w,h,r){const s=new THREE.Shape();s.moveTo(-w+r,-h);s.lineTo(w-r,-h);s.quadraticCurveTo(w,-h,w,-h+r);s.lineTo(w,h-r);s.quadraticCurveTo(w,h,w-r,h);s.lineTo(-w+r,h);s.quadraticCurveTo(-w,h,-w,h-r);s.lineTo(-w,-h+r);s.quadraticCurveTo(-w,-h,-w+r,-h);return s;}\n linePath(lane,offset,y,color,width=1){const l=LANES[lane];const shape=this.ringShape(l.w+offset,l.h+offset,l.r+offset);const points=shape.getPoints(80).map(p=>new THREE.Vector3(p.x,y,p.y));const line=new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(points),new THREE.LineBasicMaterial({color,linewidth:width}));this.root.add(line);return line;}\n ribbon(w,h,r,thick,y,color){const outer=this.ringShape(w+thick/2,h+thick/2,r+thick/2);const inner=this.ringShape(w-thick/2,h-thick/2,r-thick/2);outer.holes.push(new THREE.Path(inner.getPoints(80).reverse()));const m=this.mesh(new THREE.ShapeGeometry(outer,64),color);m.rotation.x=Math.PI/2;m.position.y=y; m.material.side=THREE.DoubleSide;return m;}\n textTexture(text,bg='\"'#e9dfbd',fg='#183435',w=1024,h=256){const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d');g.fillStyle=bg;g.fillRect(0,0,w,h);g.fillStyle=fg;g.textAlign='center';g.textBaseline='middle';g.font=\"'`900 ${h*.72}px Arial, sans-serif`;g.fillText(text,w/2,h*.55,w*.92);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t;}\n sign(text,w,h,x,y,z,bg,fg,parent=this.root){const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshBasicMaterial({map:this.textTexture(text,bg,fg),side:THREE.DoubleSide}));m.position.set(x,y,z);parent.add(m);return m;}\n buildWorld(){\n const ground=this.box(200,.3,200,'\"'#ddbd87',0,-1.25,0,this.scene,false);\n for(let i=0;i<45;i++){const x=((i*59.7)%77)-38,z=((i*31.3)%62)-31;if(Math.abs(x)<17&&Math.abs(z)<13)continue;const dash=this.box(1.8,.02,.065,i%3?'#bc9c71':'#e8cfa4',x,-1.08,z,this.scene,false);dash.rotation.y=-.5;}\n const base=this.mesh(new THREE.ExtrudeGeometry(this.ringShape(15.7,12,6),{depth:.7,bevelEnabled:true,bevelSize:.2,bevelThickness:.12,steps:1,curveSegments:32}),'#173b3e',this.root,true);base.rotation.x=Math.PI/2;base.position.y=-.1;\n const outer=this.ringShape(15.45,11.8,6);const inner=this.ringShape(6.18,2.53,1.18);outer.holes.push(new THREE.Path(inner.getPoints(80).reverse()));const road=this.mesh(new THREE.ShapeGeometry(outer,64),'#2d4848');road.rotation.x=Math.PI/2;road.position.y=.03;road.material.side=THREE.DoubleSide;\n this.ribbon(15.36,11.71,5.94,.15,.06,'#0c262c');this.ribbon(15.16,11.51,5.74,.13,.075,'#f5e3b3');this.ribbon(6.25,2.6,1.3,.2,.08,'#f2dfb3');\n for(let l=0;l<3;l++){const a=LANES[l],b=LANES[l+1];this.ribbon((a.w+b.w)/2,(a.h+b.h)/2,(a.r+b.r)/2,.1,.08,'#809d8c');}\n for(let g=0;g<4;g++){const p=trackPoint(3,g*.25);const gate=new THREE.Group();gate.position.set(p.x,.1,p.z);gate.rotation.y=g%2?Math.PI/2:0;this.root.add(gate);for(let i=0;i<6;i++)this.box(.48,.025,.22,'#e5d3a4',-1.45+i*.58,.01,0,gate,false);}\n // Small breaks across every dividing rail mark the four lane-change junctions.\n for(let l=0;l<3;l++)for(let g=0;g<4;g++){const p1=trackPoint(l,g*.25),p2=trackPoint(l+1,g*.25);this.box(g%2?2.4:3.6,.025,g%2?3.6:2.4,'#2d4848',(p1.x+p2.x)/2,.11,(p1.z+p2.z)/2,this.root,false);}\n for(let g=0;g<4;g++){const p=trackPoint(3,g*.25);const orient=g*Math.PI/2;const marker=this.box(g%2?.17:2.8,.025,g%2?2.8:.17,'#f1bf54',p.x,.15,p.z);marker.rotation.y=0;}\n // Start/finish stripe.\n for(let l=0;l<4;l++)for(let a=0;a<4;a++)for(let b=0;b<2;b++){const p=trackPoint(l,0);this.box(.34,.025,.48,(a+b)%2?'#f7e5ba':'#193638',p.x+(a-1.5)*.34,.16,p.z+(b-.5)*.48,this.root,false);}\n const island=this.mesh(new THREE.ExtrudeGeometry(this.ringShape(5.95,2.25,1.1),{depth:.28,bevelEnabled:false,curveSegments:20}),'#447468',this.root,true);island.rotation.x=Math.PI/2;island.position.y=.2;\n this.box(5.8,1.5,2.15,'#e9d7a4',-.8,1,0);\n this.box(6.15,.28,2.55,'#f16d3e',-.8,1.91,0);\n for(let i=0;i<3;i++){this.box(1.45,.9,.045,'#173b3e',-2.65+i*1.8,1.07,1.09);this.box(1.2,.055,.06,'#a7c7ac',-2.65+i*1.8,1.1,1.13);}\n this.sign('RIOT',4.5,.95,-.8,2.5,.08,'#f2ce68','#173b3e');\n this.box(.1,1.5,.1,'#142e34',-2.8,1.9,0);this.box(.1,1.5,.1,'#142e34',1.2,1.9,0);\n const roof=this.sign('MOTOR CLUB',4.7,.6,-.8,2.08,0,'#f16d3e','#173b3e');roof.rotation.x=-Math.PI/2;\n // Service props: pump, spare wheels, cones, pennants.\n for(let i=0;i<2;i++){this.box(.55,1.25,.6,i?'#93d4af':'#f1bf54',3.6+i*.85,.83,.55);this.box(.4,.34,.62,'#173b3e',3.6+i*.85,1.04,.55);}\n for(let i=0;i<3;i++){const t=this.mesh(new THREE.TorusGeometry(.32,.12,8,16),'#142e34');t.rotation.x=Math.PI/2;t.position.set(-4.75,.43+i*.22,.5);}\n for(let i=0;i<5;i++){const cone=this.mesh(new THREE.ConeGeometry(.2,.55,5),'#f67a40');cone.position.set(-3+i*1.5,.5,-1.7);}\n for(let side of [-1,1])for(let i=0;i<5;i++){const x=side*15.5,z=-4+i*2;this.box(.25,.6,.65,i%2?'#f1dfb4':'#f47c43',x,.35,z);}\n const pennant=new THREE.Group();pennant.position.set(4.7,0,-.9);this.root.add(pennant);this.box(.06,3.2,.06,'#142e34',0,1.5,0,pennant);const flag=this.mesh(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,2.9,0),new THREE.Vector3(1,2.65,0),new THREE.Vector3(0,2.4,0)]),'#f2be54',pennant);flag.geometry.setIndex([0,1,2]);flag.geometry.computeVertexNormals();flag.material.side=THREE.DoubleSide;\n const clip=new THREE.AnimationClip('Club flag',2,[new THREE.NumberKeyframeTrack('.rotation[y]',[0,1,2],[-.13,.13,-.13])]);this.flagMixer=new THREE.AnimationMixer(pennant);this.flagMixer.clipAction(clip).play();\n // Decorative club lettering beyond the curb.\n const a=this.sign('KEEP IT MOVING',12,1.1,0,-.75,13.7,'#ddbd87','#31544b');a.rotation.x=-Math.PI/2;\n }\n makeCar(color,enemy=false){const root=new THREE.Group();this.root.add(root);const model=new THREE.Group();model.name='body';root.add(model);\n this.box(1.22,.32,1.95,color,0,.48,0,model);this.box(1.3,.13,2,'#152d31',0,.28,0,model);this.box(1.02,.43,.86,color,0,.83,-.17,model);\n this.box(.88,.3,.035,'#173a40',0,.87,.28,model);this.box(.88,.24,.035,'#173a40',0,.87,-.62,model);\n this.box(.035,.23,.65,'#173a40',.53,.87,-.17,model);this.box(.035,.23,.65,'#173a40',-.53,.87,-.17,model);\n this.box(.2,.02,.53,'#f9e7be',0,.655,.62,model,false);this.box(.2,.02,.3,'#f9e7be',0,1.055,-.13,model,false);\n for(const x of [-.4,.4]){this.box(.23,.12,.05,enemy?'#f8ab75':'#fff4bc',x,.5,1,model,false);this.box(.25,.09,.05,'#ef6645',x,.5,-1,model,false);}\n const wheels=[];for(const x of [-.67,.67])for(const z of [-.61,.61]){const tire=this.mesh(new THREE.CylinderGeometry(.27,.27,.2,12),'#122e34',model,true);tire.rotation.z=Math.PI/2;tire.position.set(x,.3,z);tire.name='wheel'+wheels.length;wheels.push(tire);const hub=this.mesh(new THREE.CylinderGeometry(.115,.115,.215,10),'#e5d6b1',tire);}\n if(enemy){const brow=this.box(.78,.07,.055,'#f47a41',0,1.05,.31,model,false);brow.rotation.z=.1;this.box(1.35,.07,.25,'#142e34',0,.92,-.88,model);}\n const glow=new THREE.Mesh(new THREE.RingGeometry(.8,1.05,36),new THREE.MeshBasicMaterial({color,transparent:true,opacity:.4,side:THREE.DoubleSide}));glow.rotation.x=-Math.PI/2;glow.position.y=.18;root.add(glow);\n const mixer=new THREE.AnimationMixer(model);const tracks=[new THREE.NumberKeyframeTrack('.position[y]',[0,.13,.26],[0,.035,0])];wheels.forEach(w=>tracks.push(new THREE.NumberKeyframeTrack(w.name+'.rotation[x]',[0,.35],[0,Math.PI*2])));mixer.clipAction(new THREE.AnimationClip('Engine and wheel cycle',.35,tracks)).play();\n return {root,model,mixer,glow,enemy};}\n syncRound(sim){if(this.serial===sim.serial)return;this.serial=sim.serial;for(const c of this.cars){this.root.remove(c.root);}this.cars=[...sim.players.map((p,i)=>this.makeCar(i?'#91dfba':'#fa9a45')),...sim.enemies.map((e,i)=>this.makeCar(['#ca8eab','#d78d57','#a4b3da'][i],true))];for(const m of this.dotMeshes)this.root.remove(m);this.dotMeshes=[];\n sim.dots.forEach(d=>{const geo=d.shield?new THREE.OctahedronGeometry(.43):new THREE.SphereGeometry(.19,8,5);const m=new THREE.Mesh(geo,this.mat(d.shield?'#91e7ca':'#f7ce68',true));m.position.set(d.x,.4,d.z);this.root.add(m);this.dotMeshes.push(m);});}\n burst(x,z,color,count=12){for(let i=0;i<count;i++){const m=this.mesh(new THREE.BoxGeometry(.12,.12,.23),color);m.position.set(x,.6,z);const a=Math.random()*Math.PI*2;this.effects.push({m,vx:Math.cos(a)*(2+Math.random()*3),vz:Math.sin(a)*(2+Math.random()*3),vy:2+Math.random()*4,life:.45+Math.random()*.45,max:1});}}\n update(dt,sim,screen){this.clock+=dt;if(\"'!this.ready)return;this.syncRound(sim);this.flagMixer.update(dt);const title=screen==='\"'title'||sim.attract;const targetX=title&&innerWidth>850?6.7:0;this.root.position.x=lerp(this.root.position.x,targetX,Math.min(1,dt*3));this.root.rotation.y=lerp(this.root.rotation.y,title?-.12:0,Math.min(1,dt*2));\n const all=[...sim.players,...sim.enemies];all.forEach((c,i)=>{const m=this.cars[i];if(\"'!m)return;const p=carPoint(c);m.root.position.set(p.x,0,p.z);m.root.rotation.y=carHeading(c);m.model.rotation.z=lerp(m.model.rotation.z,c.change?.13*Math.sin(c.change.t*Math.PI):0,.15);m.mixer.timeScale=c.boosting?2.8:c.braking?.7:1.5;m.mixer.update(dt);m.glow.visible=!m.enemy&&(c.invuln>0||c.boosting);m.glow.scale.setScalar(c.boosting?1.35:1+Math.sin(this.clock*8)*.1);m.model.visible=!(!m.enemy&&c.invuln>0&&Math.floor(this.clock*14)%2===0);if(c.boosting&&Math.random()<.5){const behind=trackPoint(c.lane,c.progress-.012);this.burst(behind.x,behind.z,'\"'#f8cd67',1);}});\n this.dotMeshes.forEach((m,i)=>{m.visible=\"'!sim.dots[i]?.collected;if(sim.dots[i]?.shield){m.rotation.y+=dt*2;m.position.y=.55+Math.sin(this.clock*4)*.12;}});\n this.effects=this.effects.filter(e=>{e.life-=dt;if(e.life<=0){this.root.remove(e.m);e.m.geometry.dispose();return false;}e.m.position.x+=e.vx*dt;e.m.position.z+=e.vz*dt;e.m.position.y+=e.vy*dt;e.vy-=14*dt;e.m.rotation.x+=dt*8;e.m.rotation.z+=dt*5;e.m.scale.setScalar(Math.min(1,e.life*3));return true;});\n this.shake=Math.max(0,this.shake-dt*3);this.camera.position.x=(Math.random()-.5)*this.shake*.5;this.camera.position.y=38;this.camera.lookAt(0,0,0);\n }\n resize(){if(!this.renderer)return;const w=innerWidth,h=innerHeight,a=w/h;const span=a>1?31:34/a;this.camera.left=-span*a/2;this.camera.right=span*a/2;this.camera.top=span/2;this.camera.bottom=-span/2;this.camera.updateProjectionMatrix();this.renderer.setSize(w,h);}\n render(){if(this.ready)this.renderer.render(this.scene,this.camera);}\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > Dodge-Riot-Dodge-Em-1980-gpt-6.1-sol-ultra-20261105-212610/scene.js <<'EOF'\nclass RiotScene {\n constructor(canvas){this.canvas=canvas;this.scene=new THREE.Scene();this.scene.background=new THREE.Color('#ddbd87');this.camera=new THREE.OrthographicCamera(-25,25,16,-16,.1,150);this.camera.position.set(0,38,28);this.camera.lookAt(0,0,0);this.root=new THREE.Group();this.scene.add(this.root);this.effects=[];this.cars=[];this.dotMeshes=[];this.materials={};this.serial=-1;this.clock=0;this.shake=0;this.ready=false;}\n async init(){this.renderer=new THREE.WebGPURenderer({canvas:this.canvas,antialias:true,alpha:false});this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.outputColorSpace=THREE.SRGBColorSpace;await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2 fallback';this.scene.add(new THREE.HemisphereLight(0xfff4cf,0x263e44,2.3));const light=new THREE.DirectionalLight(0xfff2c6,3.2);light.position.set(-10,30,12);this.scene.add(light);this.buildWorld();this.resize();this.ready=true;}\n mat(color,unlit=false){const key=color+unlit;if(\"'!this.materials[key])this.materials[key]=unlit?new THREE.MeshBasicMaterial({color}):new THREE.MeshToonMaterial({color,gradientMap:this.gradient()});return this.materials[key];}\n gradient(){if(this.grad)return this.grad;const data=new Uint8Array([75,155,255]);this.grad=new THREE.DataTexture(data,3,1,THREE.RedFormat);this.grad.minFilter=THREE.NearestFilter;this.grad.magFilter=THREE.NearestFilter;this.grad.needsUpdate=true;return this.grad;}\n mesh(geo,color,parent=this.root,ink=false){const m=new THREE.Mesh(geo,this.mat(color));parent.add(m);if(ink){const l=new THREE.LineSegments(new THREE.EdgesGeometry(geo,25),new THREE.LineBasicMaterial({color:0x142a2d}));m.add(l);}return m;}\n box(w,h,d,color,x,y,z,parent=this.root,ink=true){const m=this.mesh(new THREE.BoxGeometry(w,h,d),color,parent,ink);m.position.set(x,y,z);return m;}\n ringShape(w,h,r){const s=new THREE.Shape();s.moveTo(-w+r,-h);s.lineTo(w-r,-h);s.quadraticCurveTo(w,-h,w,-h+r);s.lineTo(w,h-r);s.quadraticCurveTo(w,h,w-r,h);s.lineTo(-w+r,h);s.quadraticCurveTo(-w,h,-w,h-r);s.lineTo(-w,-h+r);s.quadraticCurveTo(-w,-h,-w+r,-h);return s;}\n linePath(lane,offset,y,color,width=1){const l=LANES[lane];const shape=this.ringShape(l.w+offset,l.h+offset,l.r+offset);const points=shape.getPoints(80).map(p=>new THREE.Vector3(p.x,y,p.y));const line=new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(points),new THREE.LineBasicMaterial({color,linewidth:width}));this.root.add(line);return line;}\n ribbon(w,h,r,thick,y,color){const outer=this.ringShape(w+thick/2,h+thick/2,r+thick/2);const inner=this.ringShape(w-thick/2,h-thick/2,r-thick/2);outer.holes.push(new THREE.Path(inner.getPoints(80).reverse()));const m=this.mesh(new THREE.ShapeGeometry(outer,64),color);m.rotation.x=Math.PI/2;m.position.y=y; m.material.side=THREE.DoubleSide;return m;}\n textTexture(text,bg='\"'#e9dfbd',fg='#183435',w=1024,h=256){const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d');g.fillStyle=bg;g.fillRect(0,0,w,h);g.fillStyle=fg;g.textAlign='center';g.textBaseline='middle';g.font=\"'`900 ${h*.72}px Arial, sans-serif`;g.fillText(text,w/2,h*.55,w*.92);const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;return t;}\n sign(text,w,h,x,y,z,bg,fg,parent=this.root){const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshBasicMaterial({map:this.textTexture(text,bg,fg),side:THREE.DoubleSide}));m.position.set(x,y,z);parent.add(m);return m;}\n buildWorld(){\n const ground=this.box(200,.3,200,'\"'#ddbd87',0,-1.25,0,this.scene,false);\n for(let i=0;i<45;i++){const x=((i*59.7)%77)-38,z=((i*31.3)%62)-31;if(Math.abs(x)<17&&Math.abs(z)<13)continue;const dash=this.box(1.8,.02,.065,i%3?'#bc9c71':'#e8cfa4',x,-1.08,z,this.scene,false);dash.rotation.y=-.5;}\n const base=this.mesh(new THREE.ExtrudeGeometry(this.ringShape(15.7,12,6),{depth:.7,bevelEnabled:true,bevelSize:.2,bevelThickness:.12,steps:1,curveSegments:32}),'#173b3e',this.root,true);base.rotation.x=Math.PI/2;base.position.y=-.1;\n const outer=this.ringShape(15.45,11.8,6);const inner=this.ringShape(6.18,2.53,1.18);outer.holes.push(new THREE.Path(inner.getPoints(80).reverse()));const road=this.mesh(new THREE.ShapeGeometry(outer,64),'#2d4848');road.rotation.x=Math.PI/2;road.position.y=.03;road.material.side=THREE.DoubleSide;\n this.ribbon(15.36,11.71,5.94,.15,.06,'#0c262c');this.ribbon(15.16,11.51,5.74,.13,.075,'#f5e3b3');this.ribbon(6.25,2.6,1.3,.2,.08,'#f2dfb3');\n for(let l=0;l<3;l++){const a=LANES[l],b=LANES[l+1];this.ribbon((a.w+b.w)/2,(a.h+b.h)/2,(a.r+b.r)/2,.1,.08,'#809d8c');}\n for(let g=0;g<4;g++){const p=trackPoint(3,g*.25);const gate=new THREE.Group();gate.position.set(p.x,.1,p.z);gate.rotation.y=g%2?Math.PI/2:0;this.root.add(gate);for(let i=0;i<6;i++)this.box(.48,.025,.22,'#e5d3a4',-1.45+i*.58,.01,0,gate,false);}\n // Small breaks across every dividing rail mark the four lane-change junctions.\n for(let l=0;l<3;l++)for(let g=0;g<4;g++){const p1=trackPoint(l,g*.25),p2=trackPoint(l+1,g*.25);this.box(g%2?2.4:3.6,.025,g%2?3.6:2.4,'#2d4848',(p1.x+p2.x)/2,.11,(p1.z+p2.z)/2,this.root,false);}\n for(let g=0;g<4;g++){const p=trackPoint(3,g*.25);const orient=g*Math.PI/2;const marker=this.box(g%2?.17:2.8,.025,g%2?2.8:.17,'#f1bf54',p.x,.15,p.z);marker.rotation.y=0;}\n // Start/finish stripe.\n for(let l=0;l<4;l++)for(let a=0;a<4;a++)for(let b=0;b<2;b++){const p=trackPoint(l,0);this.box(.34,.025,.48,(a+b)%2?'#f7e5ba':'#193638',p.x+(a-1.5)*.34,.16,p.z+(b-.5)*.48,this.root,false);}\n const island=this.mesh(new THREE.ExtrudeGeometry(this.ringShape(5.95,2.25,1.1),{depth:.28,bevelEnabled:false,curveSegments:20}),'#447468',this.root,true);island.rotation.x=Math.PI/2;island.position.y=.2;\n this.box(5.8,1.5,2.15,'#e9d7a4',-.8,1,0);\n this.box(6.15,.28,2.55,'#f16d3e',-.8,1.91,0);\n for(let i=0;i<3;i++){this.box(1.45,.9,.045,'#173b3e',-2.65+i*1.8,1.07,1.09);this.box(1.2,.055,.06,'#a7c7ac',-2.65+i*1.8,1.1,1.13);}\n this.sign('RIOT',4.5,.95,-.8,2.5,.08,'#f2ce68','#173b3e');\n this.box(.1,1.5,.1,'#142e34',-2.8,1.9,0);this.box(.1,1.5,.1,'#142e34',1.2,1.9,0);\n const roof=this.sign('MOTOR CLUB',4.7,.6,-.8,2.08,0,'#f16d3e','#173b3e');roof.rotation.x=-Math.PI/2;\n // Service props: pump, spare wheels, cones, pennants.\n for(let i=0;i<2;i++){this.box(.55,1.25,.6,i?'#93d4af':'#f1bf54',3.6+i*.85,.83,.55);this.box(.4,.34,.62,'#173b3e',3.6+i*.85,1.04,.55);}\n for(let i=0;i<3;i++){const t=this.mesh(new THREE.TorusGeometry(.32,.12,8,16),'#142e34');t.rotation.x=Math.PI/2;t.position.set(-4.75,.43+i*.22,.5);}\n for(let i=0;i<5;i++){const cone=this.mesh(new THREE.ConeGeometry(.2,.55,5),'#f67a40');cone.position.set(-3+i*1.5,.5,-1.7);}\n for(let side of [-1,1])for(let i=0;i<5;i++){const x=side*15.5,z=-4+i*2;this.box(.25,.6,.65,i%2?'#f1dfb4':'#f47c43',x,.35,z);}\n const pennant=new THREE.Group();pennant.position.set(4.7,0,-.9);this.root.add(pennant);this.box(.06,3.2,.06,'#142e34',0,1.5,0,pennant);const flag=this.mesh(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,2.9,0),new THREE.Vector3(1,2.65,0),new THREE.Vector3(0,2.4,0)]),'#f2be54',pennant);flag.geometry.setIndex([0,1,2]);flag.geometry.computeVertexNormals();flag.material.side=THREE.DoubleSide;\n const clip=new THREE.AnimationClip('Club flag',2,[new THREE.NumberKeyframeTrack('.rotation[y]',[0,1,2],[-.13,.13,-.13])]);this.flagMixer=new THREE.AnimationMixer(pennant);this.flagMixer.clipAction(clip).play();\n // Decorative club lettering beyond the curb.\n const a=this.sign('KEEP IT MOVING',12,1.1,0,-.75,13.7,'#ddbd87','#31544b');a.rotation.x=-Math.PI/2;\n }\n makeCar(color,enemy=false){const root=new THREE.Group();this.root.add(root);const model=new THREE.Group();model.name='body';root.add(model);\n this.box(1.22,.32,1.95,color,0,.48,0,model);this.box(1.3,.13,2,'#152d31',0,.28,0,model);this.box(1.02,.43,.86,color,0,.83,-.17,model);\n this.box(.88,.3,.035,'#173a40',0,.87,.28,model);this.box(.88,.24,.035,'#173a40',0,.87,-.62,model);\n this.box(.035,.23,.65,'#173a40',.53,.87,-.17,model);this.box(.035,.23,.65,'#173a40',-.53,.87,-.17,model);\n this.box(.2,.02,.53,'#f9e7be',0,.655,.62,model,false);this.box(.2,.02,.3,'#f9e7be',0,1.055,-.13,model,false);\n for(const x of [-.4,.4]){this.box(.23,.12,.05,enemy?'#f8ab75':'#fff4bc',x,.5,1,model,false);this.box(.25,.09,.05,'#ef6645',x,.5,-1,model,false);}\n const wheels=[];for(const x of [-.67,.67])for(const z of [-.61,.61]){const tire=this.mesh(new THREE.CylinderGeometry(.27,.27,.2,12),'#122e34',model,true);tire.rotation.z=Math.PI/2;tire.position.set(x,.3,z);tire.name='wheel'+wheels.length;wheels.push(tire);const hub=this.mesh(new THREE.CylinderGeometry(.115,.115,.215,10),'#e5d6b1',tire);}\n if(enemy){const brow=this.box(.78,.07,.055,'#f47a41',0,1.05,.31,model,false);brow.rotation.z=.1;this.box(1.35,.07,.25,'#142e34',0,.92,-.88,model);}\n const glow=new THREE.Mesh(new THREE.RingGeometry(.8,1.05,36),new THREE.MeshBasicMaterial({color,transparent:true,opacity:.4,side:THREE.DoubleSide}));glow.rotation.x=-Math.PI/2;glow.position.y=.18;root.add(glow);\n const mixer=new THREE.AnimationMixer(model);const tracks=[new THREE.NumberKeyframeTrack('.position[y]',[0,.13,.26],[0,.035,0])];wheels.forEach(w=>tracks.push(new THREE.NumberKeyframeTrack(w.name+'.rotation[x]',[0,.35],[0,Math.PI*2])));mixer.clipAction(new THREE.AnimationClip('Engine and wheel cycle',.35,tracks)).play();\n return {root,model,mixer,glow,enemy};}\n syncRound(sim){if(this.serial===sim.serial)return;this.serial=sim.serial;for(const c of this.cars){this.root.remove(c.root);}this.cars=[...sim.players.map((p,i)=>this.makeCar(i?'#91dfba':'#fa9a45')),...sim.enemies.map((e,i)=>this.makeCar(['#ca8eab','#d78d57','#a4b3da'][i],true))];for(const m of this.dotMeshes)this.root.remove(m);this.dotMeshes=[];\n sim.dots.forEach(d=>{const geo=d.shield?new THREE.OctahedronGeometry(.43):new THREE.