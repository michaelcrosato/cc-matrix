estroy', 66), 'm5: held 60 s'); b.to(sit[0], sit[1] - 8); b.waitFor(() => M.step?.do === 'destroy', 3); const pump = W.destructibles.find((d) => d.tag === 'pump'); W.destroy(pump, P); ok(b.waitFor(() => M.step?.do === 'report', 5), 'm5: pump gone'); const sb = P.stones; b.talkTo('vance'); ok(g.story.done.m5 && !g.story.threeWellsEmpty, 'm5: the village stays'); ok(P.stones - sb === 10, `m5: paid 10 instead of 20 (${P.stones - sb})`);\n  M = take('m7'); ok(M.altTaken && g.buddies.followers.length > 0, 'm7: a friend comes'); g.cheats.god = false; for (const v of [...g.vehicles.list]) g.vehicles.remove(v); g.actors.clear(); g.buddies.followers.length = 0; g.missions.active = null; g.warOn = false; ok(e.errors.length === 0, `alternate plans clean ${e.errors[0]}`); }\n// Touch gate.\n\"\"\",1)\nopen('tests/suites/systems.mjs','w').write(s)\nEOF\ntimeout 500 node tests/suites/systems.mjs 2>&1 | cut -c1-300 | grep -E '^FAIL|Error|passed|at file' | head -14","description":"Test every alternate plan","timeout":560000}}}
