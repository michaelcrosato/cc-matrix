{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkeBgzeQRA5S2TnokuMC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01A9ecKoNSY1tMZRqs8drARU","name":"Bash","input":{"command":"cat > src/content/tuning-defaults.js <<'EOF'\n// Every balance number that dev mode can touch. Systems read TUNING.x at the moment of use.\nexport const SLIDERS = [\n  { key: 'playerSpeed', label: 'PLAYER SPEED', def: 1, min: 0.5, max: 2, step: 0.05 },\n  { key: 'playerDamageTaken', label: 'DAMAGE TAKEN', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'weaponDamage', label: 'WEAPON DAMAGE', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'enemyHealth', label: 'ENEMY HEALTH', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'enemyAccuracy', label: 'ENEMY ACCURACY', def: 1, min: 0.25, max: 3, step: 0.05 },\n  { key: 'enemyVision', label: 'ENEMY VISION M', def: 90, min: 20, max: 200, step: 5 },\n  { key: 'enemyReaction', label: 'ENEMY REACTION S', def: 0.45, min: 0.1, max: 2, step: 0.05 },\n  { key: 'wearRate', label: 'WEAR RATE', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'jamRate', label: 'JAM RATE', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'fireSpread', label: 'FIRE SPREAD', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'fireDamage', label: 'FIRE DAMAGE HP/S', def: 8, min: 0, max: 30, step: 1 },\n  { key: 'windEffect', label: 'WIND EFFECT', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'feverMinutes', label: 'FEVER MINUTES', def: 12, min: 2, max: 40, step: 1 },\n  { key: 'vehicleTopSpeed', label: 'VEHICLE TOP SPEED', def: 26, min: 10, max: 45, step: 1 },\n  { key: 'vehicleToughness', label: 'VEHICLE TOUGHNESS', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'stonesReward', label: 'STONES REWARD', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'buddyWoundChance', label: 'BUDDY WOUND CHANCE', def: 0.15, min: 0, max: 1, step: 0.05 },\n  { key: 'dayMinutes', label: 'DAY MINUTES', def: 30, min: 2, max: 120, step: 1 },\n  { key: 'postRemanHours', label: 'POST REMAN HOURS', def: 24, min: 1, max: 96, step: 1 },\n  { key: 'regrowHours', label: 'REGROW HOURS', def: 48, min: 1, max: 200, step: 1 },\n];\nexport const TUNING_DEFAULTS = Object.fromEntries(SLIDERS.map((s) => [s.key, s.def]));\nEOF\ncat > src/core/tuning.js <<'EOF'\nimport { TUNING_DEFAULTS } from '../content/tuning-defaults.js';\n/** The live numbers: sliders write here, systems read at the moment of use. */\nexport const TUNING = { ...TUNING_DEFAULTS };\nexport const resetTuning = (key) => { if (key) TUNING[key] = TUNING_DEFAULTS[key]; else Object.assign(TUNING, TUNING_DEFAULTS); };\nEOF\ncat > src/core/look.js <<'EOF'\n// The first-person view: the engine rig's step replaced so E/Q stay free and the view can be overridden.\nexport function installLook(ctx, cam) {\n  const rig = ctx.camera;\n  if (rig.preset !== 'first') return;\n  rig.camera.rotation.order = 'YXZ';\n  rig.camera.far = 1400;\n  rig.camera.updateProjectionMatrix();\n  rig.step = function (u) {\n    if (cam.override) {\n      this.camera.position.set(...cam.override.position);\n      this.camera.lookAt(...cam.override.target);\n      this.focus.copy(this.camera.position);\n      return;\n    }\n    const k = cam.enabled ? 1 : 0;\n    this.yaw -= u.input.mouseDelta.x * 0.0025 * cam.sensX * k;\n    this.pitch = Math.max(-1.45, Math.min(1.45, this.pitch - u.input.mouseDelta.y * 0.0025 * cam.sensY * (cam.invertY ? -1 : 1) * k));\n    this.focus.copy(u.target);\n    this.camera.position.copy(u.eye);\n    this.camera.rotation.set(this.pitch + (cam.kickPitch || 0), this.yaw + (cam.kickYaw || 0), cam.roll || 0);\n  };\n}\nEOF\ncat > src/core/actions.js <<'EOF'\n// Actions, not keys. All gameplay asks for an action; this table is the only place that knows codes.\nexport const PAD_BUTTONS = { 0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle', 4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2', 8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3', 12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight' };\nexport const ACTIONS = {\n  fire: { pad: 'PadR2', kbm: ['MouseLeft'], verb: 'FIRE' },\n  aim: { pad: 'PadL2', kbm: ['MouseRight'], verb: 'AIM' },\n  use: { pad: 'PadSquare', kbm: ['KeyE'], verb: 'USE' },\n  reload: { pad: 'PadSquare', kbm: ['KeyR'], verb: 'RELOAD' },\n  jump: { pad: 'PadCross', kbm: ['Space'], verb: 'JUMP' },\n  crouch: { pad: 'PadCircle', kbm: ['KeyC'], verb: 'CROUCH' },\n  sprint: { pad: 'PadL3', kbm: ['ShiftLeft', 'ShiftRight'], verb: 'SPRINT' },\n  melee: { pad: 'PadR3', kbm: ['KeyF'], verb: 'MELEE' },\n  next: { pad: 'PadTriangle', kbm: [], verb: 'NEXT WEAPON' },\n  throw: { pad: 'PadR1', kbm: ['KeyG'], verb: 'THROW' },\n  heal: { pad: 'PadL1', kbm: ['KeyQ'], verb: 'SYRETTE' },\n  map: { pad: 'PadUp', kbm: ['KeyM', 'Tab'], verb: 'MAP' },\n  tablet: { pad: 'PadDown', kbm: ['KeyH'], verb: 'TABLET' },\n  tracker: { pad: 'PadLeft', kbm: ['KeyT'], verb: 'TRACKER' },\n  monocular: { pad: 'PadRight', kbm: ['KeyV'], verb: 'MONOCULAR' },\n  pause: { pad: 'PadOptions', kbm: ['Escape'], verb: 'PAUSE' },\n  ledger: { pad: 'PadCreate', kbm: ['KeyJ'], verb: 'LEDGER' },\n  walk: { pad: null, kbm: ['CapsLock'], verb: 'WALK' },\n  // In a vehicle\n  gas: { pad: 'PadR2', kbm: ['KeyW', 'ArrowUp'], verb: 'GAS' },\n  brake: { pad: 'PadL2', kbm: ['KeyS', 'ArrowDown'], verb: 'BRAKE' },\n  handbrake: { pad: 'PadCross', kbm: ['Space'], verb: 'HANDBRAKE' },\n  exit: { pad: 'PadSquare', kbm: ['KeyE'], verb: 'GET OUT' },\n  swap: { pad: 'PadTriangle', kbm: ['KeyF'], verb: 'SWAP TO GUN' },\n  chase: { pad: 'PadR3', kbm: ['KeyC'], verb: 'CHASE CAMERA' },\n  // On the map\n  mark: { pad: 'PadSquare', kbm: ['MouseLeft'], verb: 'SET WAYPOINT' },\n  zoom: { pad: 'PadTriangle', kbm: ['KeyZ'], verb: 'ZOOM' },\n  // A second choice beside a syrette\n  finish: { pad: 'PadTriangle', kbm: ['KeyF'], verb: 'FINISH IT' },\n  // Menus\n  up: { pad: 'PadUp', kbm: ['ArrowUp', 'KeyW'], verb: 'UP' },\n  down: { pad: 'PadDown', kbm: ['ArrowDown', 'KeyS'], verb: 'DOWN' },\n  left: { pad: 'PadLeft', kbm: ['ArrowLeft', 'KeyA'], verb: 'LEFT' },\n  right: { pad: 'PadRight', kbm: ['ArrowRight', 'KeyD'], verb: 'RIGHT' },\n  confirm: { pad: 'PadCross', kbm: ['Enter', 'Space'], verb: 'OK' },\n  back: { pad: 'PadCircle', kbm: ['Escape'], verb: 'BACK' },\n  tabL: { pad: 'PadL1', kbm: ['KeyQ'], verb: 'PREV' },\n  tabR: { pad: 'PadR1', kbm: ['KeyE'], verb: 'NEXT' },\n  resetOne: { pad: 'PadSquare', kbm: ['KeyR'], verb: 'RESET' },\n};\nconst codes = {};\nfor (const [k, a] of Object.entries(ACTIONS)) codes[k] = a.pad ? [a.pad, ...a.kbm] : [...a.kbm];\nexport const CODES = codes;\nexport const held = (input, a) => input.anyDown(codes[a]);\nexport const pressedFixed = (input, a) => input.consumeAny(codes[a]);\nexport const pressed = (input, a) => input.wasPressed(...codes[a]);\nexport const ALL_CODES = [...new Set(Object.values(codes).flat())];\nexport const PREVENT = ['Tab', 'CapsLock', 'KeyM', 'Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'F1'];\nEOF\ncat > src/core/events.js <<'EOF'\nexport class Events {\n  map = new Map();\n  on(name, fn) { (this.map.get(name) ?? this.map.set(name, []).get(name)).push(fn); return () => { const l = this.map.get(name); l.splice(l.indexOf(fn), 1); }; }\n  emit(name, ...a) { const l = this.map.get(name); if (l) for (const f of [...l]) f(...a); }\n}\nEOF\ncat > src/content/roads.js <<'EOF'\n// Road, rail and river polylines as data: [x, z]. +x east, -z north.\nexport const ROADS = {\n  north: [[0, 40], [40, -30], [90, -80], [60, -130], [40, -170], [130, -205], [280, -210], [255, -270], [190, -300], [150, -300]],\n  west: [[0, 40], [-100, 35], [-200, 30], [-250, 120], [-260, 240], [-300, 320], [-330, 395]],\n  fort: [[-200, 30], [-320, -90], [-430, -180], [-360, -270], [-260, -300]],\n  east: [[0, 40], [90, 75], [170, 90], [250, 80], [300, 70], [350, 170], [400, 280]],\n  siding: [[300, 70], [380, 10], [430, -60], [455, -120], [470, -180]],\n  salt: [[400, 280], [360, 340], [300, 390], [250, 440], [200, 470], [110, 470], [120, 400], [200, 400], [300, 390]],\n  back: [[0, 40], [60, 150], [120, 230], [200, 320], [300, 390]],\n  pass: [[-260, -300], [-400, -350], [-500, -420], [-590, -430]],\n  observatory: [[150, -300], [60, -350], [40, -420], [-40, -430], [-60, -490], [-130, -520]],\n  shed: [[0, 40], [-60, 110], [-120, 150], [-90, 230], [-60, 300], [-100, 350]],\n};\nexport const RAILWAY = [[-640, 110], [-300, 100], [0, 70], [200, 40], [270, -5], [430, -60], [640, -110]];\nexport const RAIL_SPUR = [[200, 40], [190, -120], [170, -250]];\nexport const RIVER = [[600, -640], [420, -320], [300, -120], [250, 80], [120, 230], [-60, 300], [-240, 380], [-420, 430], [-640, 470]];\nexport const BRIDGES = [{ at: [250, 80], rail: false }, { at: [120, 230], rail: false }, { at: [270, -5], rail: true }];\nexport const FORD = [-60, 300];\n// The arc. The plot of the game is that these three lines are one line.\nexport const STRIPS = {\n  A: { points: [[430, -60], [360, -130], [270, -210], [190, -270]], width: 34 },\n  C: { points: [[190, -270], [150, -300], [80, -318]], width: 40 },\n  B: { points: [[80, -318], [-60, -335], [-260, -300], [-400, -350], [-520, -420]], width: 34 },\n};\nexport const HALTS = [\n  { id: 'west-cutting', name: 'WEST CUTTING', at: [-400, 103], line: 'bakr.halt.west' },\n  { id: 'mile-forty', name: 'MILE FORTY', at: [0, 62], line: 'bakr.halt.mile' },\n  { id: 'east-siding', name: 'EAST SIDING', at: [418, -64], line: 'bakr.halt.east' },\n  { id: 'cut-spur', name: 'CUT SPUR', at: [178, -240], line: 'bakr.halt.cut' },\n];\nEOF\npython3 - <<'EOF' 2>/dev/null\nEOF\nnode -e \"import('./pixel-engine.js').then(P=>{console.log(Object.entries(P.PALETTE).map(([k,v])=>k+':'+v.toString(16)).join(' '));const hud=P.LIBRARY;console.log(typeof P.MODEL_LIBRARY.all, P.MODEL_LIBRARY.all().filter(d=>/acacia|tree|bush|well|reed|rock|boulder|stone-wall|battlement|sack|crate|barrel|table|chair|\\bbed\\b|stool|signpost|notice|market-stall|lamp-post|campfire|rubble|mine-rail|shovel|dead/.test(d.id)).map(d=>d.id).join(' ').slice(0,900))}).catch(e=>console.log(String(e).slice(0,300)))\" 2>&1 | cut -c1-1200","description":"Write tuning, look, actions, road data; print palette and library ids"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6746,"cache_read_input_tokens":192169,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6746},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"0c4c2754-0928-4b13-b67c-830d9c9cea31","timestamp":"2026-11-05T23:25:26.834Z","request_id":"req_011CgkeBgi2tLoEs8ZGMkcPF","wire_tool_inputs":{"toolu_01A9ecKoNSY1tMZRqs8drARU":{"command":"cat > src/content/tuning-defaults.js <<'EOF'\n// Every balance number that dev mode can touch. Systems read TUNING.x at the moment of use.\nexport const SLIDERS = [\n  { key: 'playerSpeed', label: 'PLAYER SPEED', def: 1, min: 0.5, max: 2, step: 0.05 },\n  { key: 'playerDamageTaken', label: 'DAMAGE TAKEN', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'weaponDamage', label: 'WEAPON DAMAGE', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'enemyHealth', label: 'ENEMY HEALTH', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'enemyAccuracy', label: 'ENEMY ACCURACY', def: 1, min: 0.25, max: 3, step: 0.05 },\n  { key: 'enemyVision', label: 'ENEMY VISION M', def: 90, min: 20, max: 200, step: 5 },\n  { key: 'enemyReaction', label: 'ENEMY REACTION S', def: 0.45, min: 0.1, max: 2, step: 0.05 },\n  { key: 'wearRate', label: 'WEAR RATE', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'jamRate', label: 'JAM RATE', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'fireSpread', label: 'FIRE SPREAD', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'fireDamage', label: 'FIRE DAMAGE HP/S', def: 8, min: 0, max: 30, step: 1 },\n  { key: 'windEffect', label: 'WIND EFFECT', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'feverMinutes', label: 'FEVER MINUTES', def: 12, min: 2, max: 40, step: 1 },\n  { key: 'vehicleTopSpeed', label: 'VEHICLE TOP SPEED', def: 26, min: 10, max: 45, step: 1 },\n  { key: 'vehicleToughness', label: 'VEHICLE TOUGHNESS', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'stonesReward', label: 'STONES REWARD', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'buddyWoundChance', label: 'BUDDY WOUND CHANCE', def: 0.15, min: 0, max: 1, step: 0.05 },\n  { key: 'dayMinutes', label: 'DAY MINUTES', def: 30, min: 2, max: 120, step: 1 },\n  { key: 'postRemanHours', label: 'POST REMAN HOURS', def: 24, min: 1, max: 96, step: 1 },\n  { key: 'regrowHours', label: 'REGROW HOURS', def: 48, min: 1, max: 200, step: 1 },\n];\nexport const TUNING_DEFAULTS = Object.fromEntries(SLIDERS.map((s) => [s.key, s.def]));\nEOF\ncat > src/core/tuning.js <<'EOF'\nimport { TUNING_DEFAULTS } from '../content/tuning-defaults.js';\n/** The live numbers: sliders write here, systems read at the moment of use. */\nexport const TUNING = { ...TUNING_DEFAULTS };\nexport const resetTuning = (key) => { if (key) TUNING[key] = TUNING_DEFAULTS[key]; else Object.assign(TUNING, TUNING_DEFAULTS); };\nEOF\ncat > src/core/look.js <<'EOF'\n// The first-person view: the engine rig's step replaced so E/Q stay free and the view can be overridden.\nexport function installLook(ctx, cam) {\n  const rig = ctx.camera;\n  if (rig.preset !== 'first') return;\n  rig.camera.rotation.order = 'YXZ';\n  rig.camera.far = 1400;\n  rig.camera.updateProjectionMatrix();\n  rig.step = function (u) {\n    if (cam.override) {\n      this.camera.position.set(...cam.override.position);\n      this.camera.lookAt(...cam.override.target);\n      this.focus.copy(this.camera.position);\n      return;\n    }\n    const k = cam.enabled ? 1 : 0;\n    this.yaw -= u.input.mouseDelta.x * 0.0025 * cam.sensX * k;\n    this.pitch = Math.max(-1.45, Math.min(1.45, this.pitch - u.input.mouseDelta.y * 0.0025 * cam.sensY * (cam.invertY ? -1 : 1) * k));\n    this.focus.copy(u.target);\n    this.camera.position.copy(u.eye);\n    this.camera.rotation.set(this.pitch + (cam.kickPitch || 0), this.yaw + (cam.kickYaw || 0), cam.roll || 0);\n  };\n}\nEOF\ncat > src/core/actions.js <<'EOF'\n// Actions, not keys. All gameplay asks for an action; this table is the only place that knows codes.\nexport const PAD_BUTTONS = { 0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle', 4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2', 8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3', 12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight' };\nexport const ACTIONS = {\n  fire: { pad: 'PadR2', kbm: ['MouseLeft'], verb: 'FIRE' },\n  aim: { pad: 'PadL2', kbm: ['MouseRight'], verb: 'AIM' },\n  use: { pad: 'PadSquare', kbm: ['KeyE'], verb: 'USE' },\n  reload: { pad: 'PadSquare', kbm: ['KeyR'], verb: 'RELOAD' },\n  jump: { pad: 'PadCross', kbm: ['Space'], verb: 'JUMP' },\n  crouch: { pad: 'PadCircle', kbm: ['KeyC'], verb: 'CROUCH' },\n  sprint: { pad: 'PadL3', kbm: ['ShiftLeft', 'ShiftRight'], verb: 'SPRINT' },\n  melee: { pad: 'PadR3', kbm: ['KeyF'], verb: 'MELEE' },\n  next: { pad: 'PadTriangle', kbm: [], verb: 'NEXT WEAPON' },\n  throw: { pad: 'PadR1', kbm: ['KeyG'], verb: 'THROW' },\n  heal: { pad: 'PadL1', kbm: ['KeyQ'], verb: 'SYRETTE' },\n  map: { pad: 'PadUp', kbm: ['KeyM', 'Tab'], verb: 'MAP' },\n  tablet: { pad: 'PadDown', kbm: ['KeyH'], verb: 'TABLET' },\n  tracker: { pad: 'PadLeft', kbm: ['KeyT'], verb: 'TRACKER' },\n  monocular: { pad: 'PadRight', kbm: ['KeyV'], verb: 'MONOCULAR' },\n  pause: { pad: 'PadOptions', kbm: ['Escape'], verb: 'PAUSE' },\n  ledger: { pad: 'PadCreate', kbm: ['KeyJ'], verb: 'LEDGER' },\n  walk: { pad: null, kbm: ['CapsLock'], verb: 'WALK' },\n  // In a vehicle\n  gas: { pad: 'PadR2', kbm: ['KeyW', 'ArrowUp'], verb: 'GAS' },\n  brake: { pad: 'PadL2', kbm: ['KeyS', 'ArrowDown'], verb: 'BRAKE' },\n  handbrake: { pad: 'PadCross', kbm: ['Space'], verb: 'HANDBRAKE' },\n  exit: { pad: 'PadSquare', kbm: ['KeyE'], verb: 'GET OUT' },\n  swap: { pad: 'PadTriangle', kbm: ['KeyF'], verb: 'SWAP TO GUN' },\n  chase: { pad: 'PadR3', kbm: ['KeyC'], verb: 'CHASE CAMERA' },\n  // On the map\n  mark: { pad: 'PadSquare', kbm: ['MouseLeft'], verb: 'SET WAYPOINT' },\n  zoom: { pad: 'PadTriangle', kbm: ['KeyZ'], verb: 'ZOOM' },\n  // A second choice beside a syrette\n  finish: { pad: 'PadTriangle', kbm: ['KeyF'], verb: 'FINISH IT' },\n  // Menus\n  up: { pad: 'PadUp', kbm: ['ArrowUp', 'KeyW'], verb: 'UP' },\n  down: { pad: 'PadDown', kbm: ['ArrowDown', 'KeyS'], verb: 'DOWN' },\n  left: { pad: 'PadLeft', kbm: ['ArrowLeft', 'KeyA'], verb: 'LEFT' },\n  right: { pad: 'PadRight', kbm: ['ArrowRight', 'KeyD'], verb: 'RIGHT' },\n  confirm: { pad: 'PadCross', kbm: ['Enter', 'Space'], verb: 'OK' },\n  back: { pad: 'PadCircle', kbm: ['Escape'], verb: 'BACK' },\n  tabL: { pad: 'PadL1', kbm: ['KeyQ'], verb: 'PREV' },\n  tabR: { pad: 'PadR1', kbm: ['KeyE'], verb: 'NEXT' },\n  resetOne: { pad: 'PadSquare', kbm: ['KeyR'], verb: 'RESET' },\n};\nconst codes = {};\nfor (const [k, a] of Object.entries(ACTIONS)) codes[k] = a.pad ? [a.pad, ...a.kbm] : [...a.kbm];\nexport const CODES = codes;\nexport const held = (input, a) => input.anyDown(codes[a]);\nexport const pressedFixed = (input, a) => input.consumeAny(codes[a]);\nexport const pressed = (input, a) => input.wasPressed(...codes[a]);\nexport const ALL_CODES = [...new Set(Object.values(codes).flat())];\nexport const PREVENT = ['Tab', 'CapsLock', 'KeyM', 'Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'F1'];\nEOF\ncat > src/core/events.js <<'EOF'\nexport class Events {\n  map = new Map();\n  on(name, fn) { (this.map.get(name) ?? this.map.set(name, []).get(name)).push(fn); return () => { const l = this.map.get(name); l.splice(l.indexOf(fn), 1); }; }\n  emit(name, ...a) { const l = this.map.get(name); if (l) for (const f of [...l]) f(...a); }\n}\nEOF\ncat > src/content/roads.js <<'EOF'\n// Road, rail and river polylines as data: [x, z]. +x east, -z north.\nexport const ROADS = {\n  north: [[0, 40], [40, -30], [90, -80], [60, -130], [40, -170], [130, -205], [280, -210], [255, -270], [190, -300], [150, -300]],\n  west: [[0, 40], [-100, 35], [-200, 30], [-250, 120], [-260, 240], [-300, 320], [-330, 395]],\n  fort: [[-200, 30], [-320, -90], [-430, -180], [-360, -270], [-260, -300]],\n  east: [[0, 40], [90, 75], [170, 90], [250, 80], [300, 70], [350, 170], [400, 280]],\n  siding: [[300, 70], [380, 10], [430, -60], [455, -120], [470, -180]],\n  salt: [[400, 280], [360, 340], [300, 390], [250, 440], [200, 470], [110, 470], [120, 400], [200, 400], [300, 390]],\n  back: [[0, 40], [60, 150], [120, 230], [200, 320], [300, 390]],\n  pass: [[-260, -300], [-400, -350], [-500, -420], [-590, -430]],\n  observatory: [[150, -300], [60, -350], [40, -420], [-40, -430], [-60, -490], [-130, -520]],\n  shed: [[0, 40], [-60, 110], [-120, 150], [-90, 230], [-60, 300], [-100, 350]],\n};\nexport const RAILWAY = [[-640, 110], [-300, 100], [0, 70], [200, 40], [270, -5], [430, -60], [640, -110]];\nexport const RAIL_SPUR = [[200, 40], [190, -120], [170, -250]];\nexport const RIVER = [[600, -640], [420, -320], [300, -120], [250, 80], [120, 230], [-60, 300], [-240, 380], [-420, 430], [-640, 470]];\nexport const BRIDGES = [{ at: [250, 80], rail: false }, { at: [120, 230], rail: false }, { at: [270, -5], rail: true }];\nexport const FORD = [-60, 300];\n// The arc. The plot of the game is that these three lines are one line.\nexport const STRIPS = {\n  A: { points: [[430, -60], [360, -130], [270, -210], [190, -270]], width: 34 },\n  C: { points: [[190, -270], [150, -300], [80, -318]], width: 40 },\n  B: { points: [[80, -318], [-60, -335], [-260, -300], [-400, -350], [-520, -420]], width: 34 },\n};\nexport const HALTS = [\n  { id: 'west-cutting', name: 'WEST CUTTING', at: [-400, 103], line: 'bakr.halt.west' },\n  { id: 'mile-forty', name: 'MILE FORTY', at: [0, 62], line: 'bakr.halt.mile' },\n  { id: 'east-siding', name: 'EAST SIDING', at: [418, -64], line: 'bakr.halt.east' },\n  { id: 'cut-spur', name: 'CUT SPUR', at: [178, -240], line: 'bakr.halt.cut' },\n];\nEOF\npython3 - <<'EOF' 2>/dev/null\nEOF\nnode -e \"import('./pixel-engine.js').then(P=>{console.log(Object.entries(P.PALETTE).map(([k,v])=>k+':'+v.toString(16)).join(' '));const hud=P.LIBRARY;console.log(typeof P.MODEL_LIBRARY.all, P.MODEL_LIBRARY.all().filter(d=>/acacia|tree|bush|well|reed|rock|boulder|stone-wall|battlement|sack|crate|barrel|table|chair|\\bbed\\b|stool|signpost|notice|market-stall|lamp-post|campfire|rubble|mine-rail|shovel|dead/.test(d.id)).map(d=>d.id).join(' ').slice(0,900))}).catch(e=>console.log(String(e).slice(0,300)))\" 2>&1 | cut -c1-1200","description":"Write tuning, look, actions, road data; print palette and library ids"}}}
