? 3) - dt;\n      if (this.st.shellT <= 0) { this.st.shellT = this.rng.range(5, 10); const a = this.rng.range(0, 6.283), r = this.rng.range(22, 48), x = at[0] + Math.cos(a) * r, z = at[1] + Math.sin(a) * r; g.audio.play('bullet-whip', { volume: 0.6 }); g.combat.explode(x, g.world.land.heightAt(x, z) + 0.5, z, 6, 60, null, { fire: 3, big: true, shell: true }); this.st.shells = (this.st.shells ?? 0) + 1; g.story.shellsFell = (g.story.shellsFell ?? 0) + 1; }\n    }\n    g.hud.holdTimer = inside ? this.st.left : null;\"\"\")\n# Lines\nsub('src/content/dialogue.js',\"  'm7.alt': L(\",\"  'm7.arrive': L('radio', 'ALL UNITS TO THE MINE. THE TRUCE IS A MATTER FOR HISTORIANS.', 'HARVEST ON THE NORTH TERRACE. CONCORD ON THE HEADFRAME.', 'WHOEVER HAS THE SLUICE HOUSE HAS THE STONES. NOBODY HAS IT.'),\\n  'm7.alt': L(\")\nsub('src/content/dialogue.js',\"  'm8.bakr': L(\",\"  'm8.hold': L('odile', 'Two hundred and twelve aboard. Keep them off the rails.', 'Ninety left. They are carrying the ones who cannot walk.', 'Forty. Do not count them for me. I am counting.'),\\n  'm8.bakr': L(\")\nsub('src/content/dialogue.js',\"  'end.ines': L(\",\"  'end.stand': L('radio', 'CONTACT AT THE PASS. CONCORD AND HARVEST BOTH.', 'THEY AGREE ON SOMETHING AT LAST. IT IS YOU.', 'THE RAIN HAS STOPPED. THE GRASS BEYOND THE SCAR IS DRY.'),\\n  'end.ines': L(\")\nsub('src/content/missions.js',\"{ do: 'goto', site: 'the-cut', r: 160, text: 'REACH THE CUT' }\",\"{ do: 'goto', site: 'the-cut', r: 160, text: 'REACH THE CUT', lines: 'm7.arrive' }\")\nsub('src/content/missions.js',\"waves: 'both', at: [0, 62], text: 'HOLD THE PLATFORM WHILE THEY BOARD' }\",\"waves: 'both', at: [0, 62], text: 'HOLD THE PLATFORM WHILE THEY BOARD', lines: 'm8.hold' }\")\nsub('src/content/missions.js',\"{ do: 'script', script: 'endStand', text: 'HOLD' }\",\"{ do: 'script', script: 'endStand', text: 'HOLD', lines: 'end.stand' }\")\n# Tests\nsub('tests/suites/static.mjs',\"for (const m of ['m0', 'm1',\",\"for (const id of ['m0', 