n    this.whipFoot = new Vector3(-t.size[0] * 0.9, t.size[1] + 0.35, t.size[2] * 0.55);\n    this.whipBits = Array.from({ length: WHIP_SEGMENTS }, () => { const m = new THREE.Mesh(WHIP, toonMaterial(0x1b1b2a)); m.castShadow = false; m.frustumCulled = false; setLookLayer(m, 'actors'); ctx.scene.add(m); return m; });\n    this.whipBasis = [[], [], []]; this.squash = new Squash(); this.squash.amount = 0.5;\"\"\")\nsub('src/vehicles/vehicle.js',\"this.game.audio.at('hit-metal', this.x, this.y, this.z, 40);\",\"this.squash.kick(-9); this.game.audio.at('hit-metal', this.x, this.y, this.z, 40);\")\nsub('src/vehicles/vehicle.js',\"  update(dt) {\\n    for (let i = 0; i < 4; i++) { this.v.wheelPose\",\"\"\"  updateWhip(dt) {\n    if (!this.whipBits.length) return;\n    const foot = A.copy(this.whipFoot).applyMatrix4(this.object.matrixWorld).toArray(), first = !this.whipSet;\n    columns(this.object.quaternion, this.whipBasis);\n    if (first) { this.whip.reset(foot, this.whipBasis); this.whipSet = true; } else this.whip.update(dt, foot, this.whipBasis);\n    const pts = this.whip.points;\n    this.whipBits.forEach((m, i) => { A.fromArray(pts[i]); B.fromArray(pts[i + 1]); m.position.copy(A).add(B).multiplyScalar(0.5); m.scale.z = A.distanceTo(B) || 0.01; m.quaternion.setFromUnitVectors(Z, B.sub(A).normalize()); });\n  }\n  dropWhip() { for (const m of this.whipBits) { this.ctx.scene.remove(m); m.material.dispose(); } this.whipBits = []; }\n  update(dt) {\n    this.squash.update(dt); const [h, v] = this.squash.scale(); this.object.scale.set(h, v, h);\n    this.updateWhip(dt);\n    for (let i = 0; i < 4; i++) { this.v.wheelPose\"\"\")\nsub('src/vehicles/vehicle.js',\"  wreck() { if (this.driverView)\",\"  wreck() { this.dropWhip(); if (this.driverView)\")\nsub('src/vehicles/vehicle.js',\"this.ctx.physics.unbind(this.object); this.ctx.scene.remove(this.object); this.v.dispose();\",\"this.dropWhip(); this.ctx.physics.unbind(this.object); this.ctx.scene.remove(this.object); this.v.dispose();\")\n\n# ---- twoBoneIK: your arms reach the wheel\ns=rd('src/art/viewmodels.js')\na=\"\"\",\n      { box: [0.08, 0.07, 0.1], at: [0.17, 0.02, -0.03], c: 'skin' }, { box: [0.08, 0.07, 0.1], at: [-0.17, 0.02, -0.03], c: 'skin' }, { box: [0.08, 0.08, 0.5], at: [0.2, -0.05, -0.28], rot: [14, 0, 0], c: 'sleeve' }, { box: [0.08, 0.08, 0.5], at: [-0.2, -0.05, -0.28], rot: [14, 0, 0], c: 'sleeve' }]),\"\"\"\nassert a in s; s=s.replace(a,\"]),\"); wr('src/art/viewmodels.js',s)\nsub('src/combat/viewmodel.js',\"this.wheelY = this.wheelNode.position.y;\",\"\"\"this.wheelY = this.wheelNode.position.y;\n    // Your arms, solved each frame: the hands stay on the rim as it turns, the elbows follow.\n    this.arms = [1, -1].map((side) => { const bit = (w, l, c) => { const g = new THREE.BoxGeometry(w, w, l), m = new Mesh(g, toonMaterial(c)); m.castShadow = false; m.frustumCulled = false; this.dash.add(m); return m; }; return { side, upper: bit(0.085, UPPER_ARM, PALETTE.sand), fore: bit(0.08, FORE_ARM, PALETTE.sand), hand: bit(0.085, 0.11, PALETTE.orange) }; });\"\"\")\nsub('src/combat/viewmodel.js',\"this.wheelNode.rotation.z = (st.wheel ?? 0) * 1.5; this.arrowNode.rotation.y = st.arrowYaw ?? 0; }\",\"this.wheelNode.rotation.z = (st.wheel ?? 0) * 1.5; this.arrowNode.rotation.y = st.arrowYaw ?? 0; this.poseArms(); }\")\ns=rd('src/combat/viewmodel.js')\ni=s.index(\"  update(dt, st) {\") if \"  update(dt, st) {\" in s else None\nassert i is not None\ns=s[:i]+\"\"\"  poseArms() {\n    const w = this.wheelNode, c = Math.cos(w.rotation.z), n = Math.sin(w.rotation.z);\n    for (const a of this.arms) {\n      const rx = a.side * 0.17, ry = 0.02, hand = [w.position.x + rx * c - ry * n, w.position.y + rx * n + ry * c, w.position.z - 0.03], shoulder = [a.side * 0.27, -0.72, -0.12];\n      const elbow = twoBoneIK(shoulder, hand, UPPER_ARM, FORE_ARM, [a.side * 0.9, -1.2, 0.2], ELBOW);\n      const span = (m, p, q) => { A.fromArray(p); B.fromArray(q); m.position.copy(A).add(B).multiplyScalar(0.5); m.quaternion.setFromUnitVectors(Z_AXIS, B.sub(A).normalize()); };\n      span(a.upper, shoulder, elbow); span(a.fore, elbow, hand); a.hand.position.fromArray(hand); a.hand.quaternion.copy(a.fore.quaternion);\n    }\n  }\n\"\"\"+s[i:]\nwr('src/combat/viewmodel.js',s)\np='tests/ISSUES.md'; s=rd(p).rstrip('\\n')+\"\\n- In the driving seat the arms turned rigidly around the wheel's centre with it, like spokes, rather than reaching for the rim; they are now solved with twoBoneIK (reading the plan's animation base list again). Not critical.\\n\"; wr(p,s)\nEOF\nsed -n 1,9p src/combat/viewmodel.js | cut -c1-200; grep -n \"  update(\" src/combat/viewmodel.js | head -2 | cut -c1-100; grep -n \"^import.*\\bpixel-engine\" src/combat/viewmodel.js | cut -c1-200","description":"Split standalone modules, add the engine features"}}}
