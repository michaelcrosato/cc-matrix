 which: hub, solo, and two windows on one computer.\nconst COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nexport function hubSession(info) {\n12:  pickup: { model: 'pickup', size: [0.95, 0.45, 2.2], mass: 12, power: 160, topK: 1, seat: [0.42, 0.95, 0.1] },\n13:  technical: { model: 'technical', size: [0.95, 0.45, 2.2], mass: 13, power: 160, topK: 0.95, seat: [0.42, 0.95, 0.1], gun: [0, 1.75, -1.5] },\nsrc/main.js:4:import { hubSession } from './net/session.js';\nsrc/game.js:3:import { Attract } from './attract/director.js';\nsrc/game.js:36:import { aboutScreen, bedScreen, boardScreen, endingScreen, gameOverScreen, lockerScreen, mainScreen, pauseScreen, pressScreen, rackScreen, touchGateScreen\nsrc/game.js:37:import { Train, Vehicles } from './vehicles/vehicle.js';\nsrc/game.js:42:import { linkSession, soloSession } from './net/session.js';\nsrc/net/round.js:10:import { resultsScreen } from '../ui/screens.js';\ntests/lib/checklist.mjs:28:const { aboutScreen } = await import('../../src/ui/screens.js');\ntests/suites/lines.mjs:14:import { settingsScreen } from '../../src/ui/screens.js';\ntests/suites/systems.mjs:149:{ const S2 = await import('../../src/ui/screens.js'), D2 = await import('../../src/dev/devmode.js'); g.dev_startMission('m3'); e.step(2); g.m","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014ZJ8Cg6gU8RL41weBosJcv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
