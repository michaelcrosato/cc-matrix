f (auto) this.newGame(); }\")\ns=s.replace(\"\"\"  setHutsDark(dark) { const s = this.world.sites['three-wells']; s.dark = dark; for (const e of s.extras) if (e.tag === 'hut') e.object.traverse((o) => { if (o.isMesh) o.visible = !dark || !o.material?.name; }); s.calm = dark; }\"\"\",\"\"\"  /** Three Wells emptied: the huts go dark. */\n  setHutsDark(dark) { const s = this.world.sites['three-wells']; s.dark = dark; s.calm = dark; for (const e of s.extras) if (e.tag === 'hut') { if (dark && !e.darkObject) { const b = buildModel('hut', { catalog: CATALOG, palette: { wall: 'night', roof: 'slate', roof2: 'ink', frame: 'ink' } }); b.object.position.copy(e.object.position); b.object.rotation.copy(e.object.rotation); this.ctx.scene.add(b.object); e.darkObject = b.object; } e.object.visible = !dark; if (e.darkObject) e.darkObject.visible = dark; } }\"\"\")\ns=s.replace(\"c.object.visible = false; const n = Math.round(c.stones * TUNING.stonesReward);\",\"c.object.visible = false; const n = Math.round((c.stones + 2) * TUNING.stonesReward);\")\nopen(p,'w').write(s)\np='tests/suites/systems.mjs'; s=open(p).read()\ns=s.replace(\"// Tracker rate, trig note,\",\"\"\"// The map on foot: click marks, the map stops a shot; a save between missions picks the story back up.\n{ b.to(-180, 200); b.key('KeyM'); e.step(3); ok(P.mapUp, 'map up on foot'); const w0 = g.waypoint, m0 = g.combat.current().mag; b.key('MouseLeft', 1); e.step(2); ok(g.waypoint !== w0, 'click on the map marks it, on foot'); ok(g.combat.current().mag === m0, 'and fires nothing'); b.key('KeyM'); }\n// Tracker rate, trig note,\"\"\")\ns=s.replace(\"// Pause.\\n\",\"\"\"// An auto mission resumes from a save made just before it.\n{ g.dev_startMission('m8'); e.step(2); g.missions.active = null; g.story.done.m8 = false; g.save.write(); const j = g.save.read(); g.save.apply(j); e.step(2); ok(S().mission === 'm8', 'the story resumes after a load'); }\n// Pause.\n\"\"\")\nopen(p,'w').write(s)\nEOF\ncat >> tests/ISSUES.md <<'E