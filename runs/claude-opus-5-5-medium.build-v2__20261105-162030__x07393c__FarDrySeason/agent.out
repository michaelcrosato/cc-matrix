{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgidpkYbeXpVZrNHN8T","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019atBQV9CCTjQ1KWNQWDvu3","name":"Bash","input":{"command":"cat > src/ui/glyphs.js <<'EOF'\n// Prompts follow the input used last. PlayStation shapes, Xbox letters, key caps and mouse buttons, as pixel art.\nimport { ACTIONS } from '../core/actions.js';\nconst R = (s) => s.trim().split('\\n').map((l) => l.trim());\nexport const SPRITES = {\n  cross: R(`\n...ooooo...\n..o.....o..\n.o.w...w.o.\no...w.w...o\no....w....o\no...w.w...o\n.o.w...w.o.\n..o.....o..\n...ooooo...`),\n  circle: R(`\n...ooooo...\n..o.....o..\n.o..rrr..o.\no..r...r..o\no..r...r..o\no..r...r..o\n.o..rrr..o.\n..o.....o..\n...ooooo...`),\n  square: R(`\n...ooooo...\n..o.....o..\n.o.sssss.o.\no..s...s..o\no..s...s..o\no..s...s..o\n.o.sssss.o.\n..o.....o..\n...ooooo...`),\n  triangle: R(`\n...ooooo...\n..o..g..o..\n.o..g.g..o.\no...g.g...o\no..g...g..o\no..g...g..o\n.o.ggggg.o.\n..o.....o..\n...ooooo...`),\n  dpadU: R(`\n...www...\n...www...\n...www...\n.ooo.ooo.\n.ooo.ooo.\n.ooo.ooo.\n...ooo...\n...ooo...\n...ooo...`),\n  dpadD: R(`\n...ooo...\n...ooo...\n...ooo...\n.ooo.ooo.\n.ooo.ooo.\n.ooo.ooo.\n...www...\n...www...\n...www...`),\n  dpadL: R(`\n...ooo...\n...ooo...\n...ooo...\n.www.ooo.\n.www.ooo.\n.www.ooo.\n...ooo...\n...ooo...\n...ooo...`),\n  dpadR: R(`\n...ooo...\n...ooo...\n...ooo...\n.ooo.www.\n.ooo.www.\n.ooo.www.\n...ooo...\n...ooo...\n...ooo...`),\n  options: R(`\n.ooooooo.\n.o.www.o.\n.o.....o.\n.o.www.o.\n.o.....o.\n.o.www.o.\n.ooooooo.`),\n  create: R(`\n.ooooooo.\n.o..w..o.\n.o.www.o.\n.o..w..o.\n.o..w..o.\n.ooooooo.`),\n  lmb: R(`\n..ooooo..\n.owwoooo.\n.owwo..o.\n.owwo..o.\n.ooooooo.\n.o.....o.\n.o.....o.\n.o.....o.\n..ooooo..`),\n  rmb: R(`\n..ooooo..\n.oooowwo.\n.o..owwo.\n.o..owwo.\n.ooooooo.\n.o.....o.\n.o.....o.\n.o.....o.\n..ooooo..`),\n  mmb: R(`\n..ooooo..\n.o..w..o.\n.o..w..o.\n.o..w..o.\n.ooooooo.\n.o.....o.\n.o.....o.\n.o.....o.\n..ooooo..`),\n  wheel: R(`\n..ooooo..\n.o.www.o.\n.o.www.o.\n.o.www.o.\n.ooooooo.\n.o.....o.\n.o.....o.\n.o.....o.\n..ooooo..`),\n};\nconst COLORS = { o: 'mist', w: 'white', r: 'red', s: 'orange', g: 'lime' };\nconst PS = { PadCross: 'cross', PadCircle: 'circle', PadSquare: 'square', PadTriangle: 'triangle', PadUp: 'dpadU', PadDown: 'dpadD', PadLeft: 'dpadL', PadRight: 'dpadR', PadOptions: 'options', PadCreate: 'create' };\nconst PS_CAP = { PadL1: 'L1', PadR1: 'R1', PadL2: 'L2', PadR2: 'R2', PadL3: 'L3', PadR3: 'R3' };\nconst XB_CAP = { PadCross: 'A', PadCircle: 'B', PadSquare: 'X', PadTriangle: 'Y', PadL1: 'LB', PadR1: 'RB', PadL2: 'LT', PadR2: 'RT', PadL3: 'LS', PadR3: 'RS', PadOptions: 'MENU', PadCreate: 'VIEW' };\nconst KEY = { MouseLeft: 'lmb', MouseRight: 'rmb', MouseMiddle: 'mmb' };\nconst KEY_TEXT = { Space: 'SPACE', ShiftLeft: 'SHIFT', ShiftRight: 'SHIFT', Escape: 'ESC', Enter: 'ENTER', Tab: 'TAB', CapsLock: 'CAPS', ArrowUp: 'UP', ArrowDown: 'DOWN', ArrowLeft: 'LEFT', ArrowRight: 'RIGHT' };\nconst XB_COLOR = { A: 'lime', B: 'red', X: 'sky', Y: 'sand' };\n/** What to draw for an action: { sprite } or { cap, color }, and a name tests can read. */\nexport function glyphOf(action, device, xbox) {\n  const a = ACTIONS[action]; if (!a) return { cap: '?', name: '?' };\n  if (device === 'pad' && a.pad) {\n    if (xbox) { const c = XB_CAP[a.pad]; if (c) return { cap: c, color: XB_COLOR[c] ?? 'white', name: c }; }\n    if (PS[a.pad]) return { sprite: PS[a.pad], name: PS[a.pad].toUpperCase() };\n    return { cap: PS_CAP[a.pad] ?? a.pad.replace('Pad', ''), color: 'white', name: PS_CAP[a.pad] ?? a.pad };\n  }\n  const code = a.kbm?.[0] ?? a.pad;\n  if (KEY[code]) return { sprite: KEY[code], name: KEY[code].toUpperCase() };\n  const text = KEY_TEXT[code] ?? String(code).replace('Key', '').replace('Digit', '');\n  return { cap: text, color: 'white', name: text };\n}\nexport function glyphWidth(g) { if (g.sprite) return SPRITES[g.sprite][0].length; return g.cap.length * 6 + 3; }\n/** Draw at (x, y) top-left. */\nexport function drawGlyph(hud, x, y, g) {\n  if (g.sprite) { hud.sprite(x, y, SPRITES[g.sprite], COLORS); return glyphWidth(g); }\n  const w = glyphWidth(g);\n  hud.rect(x, y, w, 10, 'ink'); hud.rect(x, y, w, 1, 'mist'); hud.rect(x, y + 9, w, 1, 'mist'); hud.rect(x, y, 1, 10, 'mist'); hud.rect(x + w - 1, y, 1, 10, 'mist');\n  hud.text(x + 2, y + 2, g.cap, { color: g.color ?? 'white', shadow: false });\n  return w;\n}\nEOF\ncat > src/ui/hud.js <<'EOF'\n// Everything drawn with ctx.hud. The HUD in play is minimal and hides six seconds after it last changed.\nimport { THREE } from '../../pixel-engine.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { siteById } from '../content/sites.js';\nimport { clamp } from '../world/geom.js';\nimport { drawGlyph, glyphOf, glyphWidth } from './glyphs.js';\nimport { wrap } from './pixfont.js';\nconst { Vector3 } = THREE;\nconst v = new Vector3();\nconst GUN_ICON = { sidearm: ['oooo..', 'oooooo', '.oo...', '.oo...'], main: ['oo.........', 'ooooooooooo', 'ooo.o......', '....o......'], special: ['.oooooooo.', 'oooooooooo', '.oooooooo.', '...oo.....'], melee: ['......oo', '....oo..', '..oo....', 'oo......'], mounted: ['oo.........', 'ooooooooooo', '...oo......', '..oooo.....'] };\nexport class Hud {\n  hudT = 6; prompts = []; noticeT = 0; noticeText = null; holdTimer = null; blackoutT = 0; blackoutText = ''; bloodT = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.h = ctx.hud; }\n  touch() { this.hudT = 6; }\n  get xbox() { return this.game.settings.glyphs === 'xbox'; }\n  glyph(action) { return glyphOf(action, this.game.device, this.xbox); }\n  /** A prompt: glyph plus verb, centred at the bottom. */\n  promptLine(actions, text, y) {\n    const h = this.h, list = Array.isArray(actions) ? actions : [actions], gs = list.map((a) => this.glyph(a));\n    const tw = text.length * 6, w = gs.reduce((s, g) => s + glyphWidth(g) + 3, 0) + tw;\n    let x = Math.round((h.width - w) / 2);\n    h.rect(x - 4, y - 2, w + 8, 14, 'ink');\n    for (const g of gs) { drawGlyph(h, x, y, g); x += glyphWidth(g) + 3; }\n    h.text(x, y + 2, text, { color: 'white' });\n    this.prompts.push(`[${gs.map((g) => g.name).join('+')}] ${text}`);\n  }\n  promptAt(x, y, action, text, color = 'white') { const g = this.glyph(action); drawGlyph(this.h, x, y, g); this.h.text(x + glyphWidth(g) + 3, y + 2, text, { color }); this.prompts.push(`[${g.name}] ${text}`); return glyphWidth(g) + 3 + text.length * 6; }\n  footer(items) { // Bottom-row prompts for menus.\n    const h = this.h; let x = 24; const y = h.height - 26;\n    for (const [action, text] of items) { x += this.promptAt(x, y, action, text) + 12; }\n  }\n  world(x, y, z) { v.set(x, y, z).project(this.ctx.camera.camera); if (v.z > 1) return null; return [((v.x + 1) / 2) * this.h.width, ((1 - v.y) / 2) * this.h.height]; }\n  // ----- In play -----\n  drawPlay(dt) {\n    const g = this.game, h = this.h, p = g.player;\n    this.hudT = Math.max(0, this.hudT - dt);\n    const sw = h.width, sh = h.height;\n    const scoped = g.isScoped();\n    if (scoped) this.scopeMask();\n    if (g.monocularUp) this.monocularMask();\n    this.effects(dt);\n    // Reticle.\n    if (!scoped && !p.vehicle && !p.mapUp && !g.cam.override && !g.monocularUp) { const cx = sw >> 1, cy = sh >> 1; h.rect(cx - 1 + (p.mounted ? 0 : 0), cy - 1, 2, 2, g.gunSlung() ? 'slate' : 'white'); if (g.combat.hitMark > 0) for (let k = 3; k < 7; k++) for (const [a, b] of [[1, 1], [-1, 1], [1, -1], [-1, -1]]) h.rect(cx + a * k, cy + b * k, 1, 1, 'white'); }\n    if (p.mounted) { const heat = g.combat.heat / WEAPONS.mg.overheat; h.rect((sw >> 1) - 20, (sh >> 1) + 16, 40, 2, 'ink'); h.rect((sw >> 1) - 20, (sh >> 1) + 16, Math.round(40 * heat), 2, g.combat.overheated ? 'red' : 'orange'); }\n    // Overheads: the only detection UI.\n    for (const a of g.actors.overheads()) { const s = this.world(a.x, a.y + 2.05, a.z); if (s) h.text(Math.round(s[0]) - 3, Math.round(s[1]) - 8, a.state === 'alert' ? '!' : '?', { color: a.state === 'alert' ? 'red' : 'sand' }); }\n    // Downed buddy marker.\n    const d = g.buddies.down; if (d) { const s = this.world(d.a.x, d.a.y + 1.5, d.a.z); if (s) { const cx = Math.round(s[0]), cy = Math.round(s[1]); h.rect(cx - 1, cy - 5, 3, 11, 'lime'); h.rect(cx - 5, cy - 1, 11, 3, 'lime'); h.text(cx - 6, cy + 8, String(Math.ceil(d.a.downT)), { color: 'lime' }); } }\n    // Stats.\n    if (this.hudT > 0 || p.hp < 60 || g.body.feverActive) {\n      const seg = 5, sx = 24, sy = sh - 22;\n      for (let i = 0; i < seg; i++) { const top = (i + 1) * 20, fill = clamp((p.hp - i * 20) / 20, 0, 1); h.rect(sx + i * 17, sy, 15, 6, 'ink'); h.rect(sx + i * 17, sy, Math.round(15 * fill), 6, p.hp < 20 ? 'red' : top <= g.body.segmentTop() ? 'white' : 'mist'); }\n      h.text(sx, sy + 8, `SYRETTE ${p.syrettes}`, { color: 'white' }); h.text(sx + 66, sy + 8, `TABLET ${p.tablets}`, { color: g.body.feverActive ? 'red' : 'white' });\n      if (p.stones || this.hudT > 0) h.text(24, sh - 34, `STONES ${p.stones}`, { color: 'sand' });\n      if (p.carrying) h.text(24, sh - 46, 'CARRYING A CASE', { color: 'sand' });\n    }\n    if ((this.hudT > 0 || g.combat.current()?.jammed) && !p.vehicle) {\n      const gun = g.combat.current();\n      if (gun) {\n        const w = WEAPONS[gun.id], x = sw - 24;\n        if (!w.melee && gun.id !== 'mg') h.text(x, sh - 14, `${gun.mag}/${gun.reserve}`, { anchor: 'top-left', color: 'white', ...{} , scale: 1 }) ;\n        const col = gun.jammed ? 'red' : gun.cond >= 60 ? 'white' : gun.cond >= 30 ? 'orange' : 'red';\n        const icon = GUN_ICON[w.slot] ?? GUN_ICON.main;\n        h.sprite(sw - 24 - icon[0].length, sh - 24, icon, { o: col });\n        h.text(sw - 24 - w.name.length * 6, sh - 34, w.name, { color: 'mist' });\n        if (p.molotovs) h.text(sw - 90, sh - 24, `BOTTLE ${p.molotovs}`, { color: 'white' });\n        if (p.charges || p.planted.length) h.text(sw - 90, sh - 14, `CHARGE ${p.charges}${p.planted.length ? '*' : ''}`, { color: p.planted.length ? 'red' : 'white' });\n      }\n    }\n    // Vehicle state.\n    if (p.vehicle && !p.mounted) { const veh = p.vehicle; h.text(sw - 24 - 60, sh - 14, `${Math.round(Math.abs(veh.v.speed) * 3.6)} KM/H`, { color: 'white' }); if (veh.hp < 35) h.text(sw - 24 - 66, sh - 24, veh.stalled ? 'ENGINE DEAD' : 'ENGINE HOT', { color: 'red' }); }\n    // Mission step at the top for five seconds.\n    const M = g.missions; if (M.textT > 0 && M.textStr) { const lines = wrap(M.textStr, 60); lines.forEach((l, i) => h.text(0, 16 + i * 10, l, { anchor: 'top', color: 'sand' })); }\n    if (this.holdTimer !== null) h.text(0, 40, `HOLD ${Math.ceil(this.holdTimer)}`, { anchor: 'top', color: 'orange', scale: 2 });\n    if (g.side) h.text(0, 40, `CRATE: ${Math.ceil(g.side.t)} S`, { anchor: 'top', color: g.side.t < 60 ? 'red' : 'sand' });\n    if (this.noticeT > 0) { this.noticeT -= dt; h.text(0, 62, this.noticeText, { anchor: 'top', color: 'white' }); }\n    // Subtitles.\n    this.subtitle();\n    // Prompts.\n    this.drawPrompts();\n    // The tracker's small readout sits on its own device, and the wind on the GPS.\n    if (g.tracker.up) { const near = g.tracker.nearestD; h.text(0, 24, near < 60 ? 'SIGNAL' : 'NO SIGNAL', { anchor: 'top', color: near < 60 ? 'lime' : 'slate' }); }\n    if (g.ledgerUp) this.ledgerSheet();\n    if (g.demoTag) { h.rect(0, 0, 46, 14, 'red', 'top-left'); h.text(6, 4, 'DEMO', { color: 'white' }); this.promptAt(sw - 90, 4, 'confirm', 'PRESS'); }\n  }\n  drawPrompts() {\n    const g = this.game, h = this.h, P = g.prompt, p = g.player, baseY = h.height - 44;\n    let y = baseY;\n    const line = (a, t) => { this.promptLine(a, t, y); y -= 14; };\n    if (p.mapUp) { line('mark', 'SET WAYPOINT'); line('zoom', 'ZOOM'); line('map', 'PUT IT AWAY'); return; }\n    if (P.choice) { const c = P.choice, x0 = Math.round(h.width / 2) - 100; h.rect(x0 - 6, y - 4, 212, 16, 'ink'); let x = x0; if (c.use) x += this.promptAt(x, y, 'use', c.use, 'lime') + 14; else { h.text(x, y + 2, 'NO SYRETTES', { color: 'slate' }); x += 80; } this.promptAt(x, y, 'finish', c.finish, c.radio ? 'mist' : 'red'); y -= 16; }\n    if (p.surgery) return;\n    if (P.current) {\n      const c = P.current;\n      if (c.passive) { if (this.hudT > 3) line('exit', c.label); }\n      else {\n        line('use', c.label);\n        if (c.hold) { const k = clamp(P.holdT / c.hold, 0, 1), W = 80; h.rect((h.width - W) >> 1, y + 12, W, 3, 'ink'); h.rect((h.width - W) >> 1, y + 12, Math.round(W * k), 3, 'orange'); }\n      }\n    }\n    const veh = p.vehicle;\n    if (veh && this.hudT > 3) { if (p.mounted) line('swap', 'BACK TO THE WHEEL'); else if (veh.t.gun) line('swap', 'SWAP TO GUN'); }\n    if (g.body.feverActive && g.story.feverOn || g.body.feverActive && g.missions.step?.script === 'm1Wake') line('tablet', 'TABLET');\n    if (p.hp < 20 && p.hp > 0 && !p.vehicle) line('heal', 'FIELD SURGERY');\n    if (P.flashT > 0 && P.flashText) line(P.flashAction, P.flashText);\n    const gun = g.combat.current();\n    if (gun?.jammed && !(P.flashT > 0)) line('reload', `CLEAR THE JAM x${gun.jamLeft}`);\n    if (p.planted.length && !p.vehicle) line('throw', 'DETONATE');\n  }\n  subtitle() {\n    const s = this.game.talk.subtitle(), h = this.h, scale = this.game.settings.subtitle === 'large' ? 2 : 1;\n    const base = h.height - 60 - (scale - 1) * 20;\n    if (s) {\n      const cols = scale === 2 ? 38 : 72, lines = wrap(s.text, cols), lh = scale * 10;\n      const topY = base - lines.length * lh;\n      if (s.who) h.text(0, topY - lh + scale, s.who, { anchor: 'top', color: s.color, scale: 1 });\n      lines.forEach((l, i) => h.text(0, topY + i * lh + scale, l, { anchor: 'top', color: 'white', shadow: 'ink', scale }));\n    } else if (this.game.talk.barkText && this.game.talk.barkT > 0) h.text(0, base - 10, this.game.talk.barkText, { anchor: 'top', color: 'mist' });\n  }\n  effects(dt) {\n    const g = this.game, h = this.h, p = g.player;\n    if (p.burning > 0) { const r = g.world.look; for (let i = 0; i < 26; i++) { const e = r.next(), x = r.next() * h.width, k = r.next(); const y = e < 0.5 ? h.height - k * 40 : r.next() * h.height, X = e < 0.5 ? x : (e < 0.75 ? k * 30 : h.width - k * 30); h.rect(X | 0, y | 0, 3, 3, r.pick(['orange', 'red', 'sand'])); } }\n    if (g.flashBlood > 0) { g.flashBlood -= dt; for (let y = 0; y < h.height; y += 3) { h.rect(0, y, 16, 1, 'red'); h.rect(h.width - 16, y, 16, 1, 'red'); } }\n    if (this.blackoutT > 0) { this.blackoutT -= dt; h.rect(0, 0, h.width, h.height, 'ink'); if (this.blackoutText) { wrap(this.blackoutText, 60).forEach((l, i) => h.text(0, 110 + i * 12, l, { anchor: 'top', color: 'sand' })); } }\n    if (g.body.fever > 0.75 && !g.settings.feverReduced) { const k = (g.body.fever - 0.75) * 4 * 16; for (let y = 0; y < h.height; y += 4) { h.rect(0, y, Math.round(k), 2, 'ink'); h.rect(h.width - Math.round(k), y, Math.round(k), 2, 'ink'); } }\n    if (p.mapUp && g.cam.override) { /* the chase camera gives way to the map */ }\n  }\n  scopeMask() {\n    const h = this.h, cx = h.width >> 1, cy = h.height >> 1, R2 = 118;\n    for (let y = 0; y < h.height; y++) { const d = y - cy, w = d * d < R2 * R2 ? Math.round(Math.sqrt(R2 * R2 - d * d)) : 0; if (!w) h.rect(0, y, h.width, 1, 'ink'); else { h.rect(0, y, cx - w, 1, 'ink'); h.rect(cx + w, y, h.width - cx - w, 1, 'ink'); } }\n    h.rect(cx - R2, cy, R2 * 2, 1, 'ink'); h.rect(cx, cy - R2, 1, R2 * 2, 'ink');\n  }\n  monocularMask() {\n    const h = this.h, cx = h.width >> 1, cy = h.height >> 1, R2 = 110;\n    for (let y = 0; y < h.height; y++) { const d = y - cy, w = d * d < R2 * R2 ? Math.round(Math.sqrt(R2 * R2 - d * d)) : 0; if (!w) h.rect(0, y, h.width, 1, 'ink'); else { h.rect(0, y, cx - w, 1, 'ink'); h.rect(cx + w, y, h.width - cx - w, 1, 'ink'); } }\n    for (let k = -3; k <= 3; k++) h.rect(cx + k * 20, cy + 40, 1, k % 2 ? 3 : 6, 'lime');\n  }\n  ledgerSheet() {\n    const g = this.game, h = this.h, l = g.ledgerNow(); const W = 290, x = (h.width - W) >> 1, y = 44;\n    h.rect(x, y, W, 150, 'sand'); h.rect(x + 2, y + 2, W - 4, 146, 'ink');\n    h.text(x + 12, y + 10, 'THE LEDGER, IN HIS HAND', { color: 'sand' });\n    g.ledgerLines(l).forEach(([k, val], i) => { h.text(x + 12, y + 30 + i * 22, k, { color: 'mist' }); h.text(x + W - 14 - val.length * 12, y + 26 + i * 22, val, { color: 'white', scale: 2 }); });\n    this.promptAt(x + 12, y + 134, 'ledger', 'CLOSE');\n  }\n  // Scene buttons (two at most).\n  choiceRects(n) { const w = this.h.width, W = 180, gap = 12, total = n * W + (n - 1) * gap; return Array.from({ length: n }, (_, i) => ({ x: ((w - total) >> 1) + i * (W + gap), y: this.h.height - 60, w: W, h: 20 })); }\n  drawScene() {\n    const g = this.game, s = g.talk.scene, h = this.h; if (!s) return;\n    const bars = 22; h.rect(0, 0, h.width, bars, 'ink'); h.rect(0, h.height - bars, h.width, bars, 'ink');\n    this.subtitle();\n    if (s.choosing) {\n      this.choiceRects(s.choices.length).forEach((r, i) => { const f = i === s.focusI; h.rect(r.x, r.y, r.w, r.h, f ? 'orange' : 'night'); h.text(r.x + r.w / 2 - (s.choices[i].text.length * 3), r.y + 6, s.choices[i].text, { color: f ? 'ink' : 'white', shadow: false }); });\n      this.footer([['confirm', 'CHOOSE']]);\n      this.prompts.push(...s.choices.map((c) => `[CHOICE] ${c.text}`));\n    } else if (s.skippable) this.promptAt(h.width - 90, h.height - 18, 'confirm', 'SKIP');\n  }\n  pointer() { const p = this.ctx.input.pointer; return [((p.x + 1) / 2) * this.h.width, ((1 - p.y) / 2) * this.h.height]; }\n  choiceHit(s, n) { const g = this.game; if (!g.mouseMoved) return null; const [x, y] = this.pointer(); const rects = this.choiceRects(n); for (let i = 0; i < n; i++) { const r = rects[i]; if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) return i; } return null; }\n  clicked(s, n) { for (const e of this.ctx.input.buttonEvents) if (!e.down && (e.code === 'MouseLeft' || e.code === 'Touch')) { const X = ((e.x + 1) / 2) * this.h.width, Y = ((1 - e.y) / 2) * this.h.height, rects = this.choiceRects(n); for (let i = 0; i < n; i++) { const r = rects[i]; if (X >= r.x && X < r.x + r.w && Y >= r.y && Y < r.y + r.h) { s.focusI = i; return true; } } } return false; }\n}\nexport { siteById };\nEOF\ncat > src/ui/menu.js <<'EOF'\n// Menus: at most six items, one idea per screen. Pad, keyboard and mouse, all native. No DOM.\nimport { pressed } from '../core/actions.js';\nimport { clamp } from '../world/geom.js';\nimport { wrap } from './pixfont.js';\nconst PAGE = 6, ROW = 22, TOP = 70;\nexport class UI {\n  stack = []; repeatT = 0; repeatDir = 0; dragging = null;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.h = ctx.hud; }\n  get top() { return this.stack[this.stack.length - 1] ?? null; }\n  push(s) { s.focus ??= 0; s.page ??= 0; this.stack.push(s); s.onShow?.(s); this.skipFrame = true; return s; }\n  pop() { const s = this.stack.pop(); s?.onClose?.(s); this.game.audio.play('ui-back'); this.skipFrame = true; return s; }\n  replace(s) { this.stack.pop(); return this.push(s); }\n  clear() { this.stack.length = 0; }\n  items(s) { return typeof s.items === 'function' ? s.items(s) : s.items ?? []; }\n  /** Movement from pad, stick or keys, with key repeat on holding. */\n  nav() {\n    const input = this.ctx.input;\n    let dir = 0;\n    if (pressed(input, 'up')) dir = -1; else if (pressed(input, 'down')) dir = 1;\n    let lr = 0;\n    if (pressed(input, 'left')) lr = -1; else if (pressed(input, 'right')) lr = 1;\n    const ax = input.padAxis;\n    const held = input.anyDown(['ArrowUp', 'KeyW', 'PadUp']) ? -1 : input.anyDown(['ArrowDown', 'KeyS', 'PadDown']) ? 1 : Math.abs(ax.y) > 0.5 ? -Math.sign(ax.y) : 0;\n    const heldLR = input.anyDown(['ArrowLeft', 'KeyA', 'PadLeft']) ? -1 : input.anyDown(['ArrowRight', 'KeyD', 'PadRight']) ? 1 : Math.abs(ax.x) > 0.5 ? Math.sign(ax.x) : 0;\n    const key = held * 10 + heldLR;\n    if (key !== this.repeatDir) { this.repeatDir = key; this.repeatT = 0.34; if (key && Math.abs(ax.y) + Math.abs(ax.x) > 0.5 && !dir && !lr) { dir = held; lr = heldLR; } }\n    else if (key) { this.repeatT -= 1 / 60; if (this.repeatT <= 0) { this.repeatT = 0.09; this.accel = (this.accel ?? 0) + 1; dir = held; lr = heldLR; } } else this.accel = 0;\n    return { dir, lr };\n  }\n  update() {\n    const s = this.top; if (!s) return;\n    if (this.skipFrame) { this.skipFrame = false; return; }\n    const input = this.ctx.input, g = this.game, items = this.items(s);\n    s.update?.(s);\n    if (this.top !== s) return;\n    const { dir, lr } = this.nav();\n    if (s.paged) { // A paged reader.\n      const n = s.pages.length;\n      if (lr || dir || input.wheel) { const d = lr || dir || Math.sign(input.wheel); const was = s.page; s.page = clamp(s.page + d, 0, n - 1); if (was !== s.page) g.audio.play('ui-move'); }\n      if (pressed(input, 'tabR')) s.page = Math.min(n - 1, s.page + 1); if (pressed(input, 'tabL')) s.page = Math.max(0, s.page - 1);\n      if (pressed(input, 'back') || pressed(input, 'confirm') || this.clickedAnywhere()) { if (s.back) s.back(s); else this.pop(); }\n      return;\n    }\n    if (s.tabs) {\n      if (pressed(input, 'tabL')) { s.tab = (s.tab + s.tabs.length - 1) % s.tabs.length; s.focus = 0; g.audio.play('ui-move'); }\n      if (pressed(input, 'tabR')) { s.tab = (s.tab + 1) % s.tabs.length; s.focus = 0; g.audio.play('ui-move'); }\n    }\n    if (items.length) {\n      if (dir) { let f = s.focus; for (let k = 0; k < items.length; k++) { f = (f + dir + items.length) % items.length; if (!items[f].disabled?.()) break; } if (f !== s.focus) { s.focus = f; g.audio.play('ui-move'); } }\n      s.focus = clamp(s.focus, 0, items.length - 1);\n      this.mouse(s, items);\n      const it = items[s.focus];\n      if (lr && it?.adjust) { it.adjust(lr * (1 + Math.min(8, (this.accel ?? 0) >> 2))); g.audio.play('ui-move', { volume: 0.6 }); }\n      if (input.wheel && items.length > PAGE) { s.focus = clamp(s.focus + Math.sign(input.wheel) * PAGE, 0, items.length - 1); }\n      if (it?.resetOne && pressed(input, 'resetOne')) { it.resetOne(); g.audio.play('ui-back'); }\n      if (pressed(input, 'confirm') && it && !it.disabled?.()) { if (it.action) { g.audio.play('ui-confirm'); it.action(); return; } if (it.adjust) it.adjust(1); }\n    }\n    s.extra?.(s);\n    if (this.top !== s) return;\n    if (pressed(input, 'back')) { if (s.back === null) return; if (s.back) s.back(s); else this.pop(); }\n  }\n  clickedAnywhere() { return this.ctx.input.buttonEvents.some((e) => !e.down && (e.code === 'MouseLeft' || e.code === 'Touch')); }\n  pointerXY(e) { return [((e.x + 1) / 2) * this.h.width, ((1 - e.y) / 2) * this.h.height]; }\n  rowRect(s, i) { const p = Math.floor(i / PAGE), y = (s.top ?? TOP) + (i - p * PAGE) * ROW; return { x: 0, y, w: this.h.width, h: ROW - 2, page: p }; }\n  mouse(s, items) {\n    const input = this.ctx.input, g = this.game, ptr = input.pointer, page = Math.floor(s.focus / PAGE);\n    const [px, py] = this.pointerXY(ptr);\n    if (g.mouseMoved && ptr.over !== false) for (let i = page * PAGE; i < Math.min(items.length, (page + 1) * PAGE); i++) { const r = this.rowRect(s, i); if (py >= r.y && py < r.y + r.h && !items[i].disabled?.()) { if (s.focus !== i) { s.focus = i; g.audio.play('ui-move', { volume: 0.5 }); } break; } }\n    for (const e of input.buttonEvents) {\n      const [x, y] = this.pointerXY(e);\n      if (e.down && (e.code === 'MouseLeft' || e.code === 'Touch')) for (let i = page * PAGE; i < Math.min(items.length, (page + 1) * PAGE); i++) { const r = this.rowRect(s, i); if (y >= r.y && y < r.y + r.h && !items[i].disabled?.()) { s.focus = i; if (items[i].set) this.dragging = items[i]; this.pressRow = i; } }\n      if (!e.down && (e.code === 'MouseLeft' || e.code === 'Touch')) {\n        this.dragging = null;\n        const pressRow = this.pressRow; this.pressRow = null;\n        if (pressRow !== undefined && pressRow !== null) { const r = this.rowRect(s, pressRow); if (y >= r.y && y < r.y + r.h) { const it = items[pressRow]; if (it?.action) { g.audio.play('ui-confirm'); it.action(); return; } if (it?.adjust && !it.set) it.adjust(x > this.h.width / 2 ? 1 : -1); } }\n      }\n      void x;\n    }\n    if (this.dragging && input.isDown('MouseLeft', 'Touch')) { const X = this.pointerXY(ptr)[0], W = this.h.width; this.dragging.set(clamp((X - (W - 124)) / 100, 0, 1)); }\n  }\n  /** Draw the top screen. */\n  draw() {\n    const s = this.top; if (!s) return;\n    const h = this.h, hud = this.game.hud, W = h.width, H = h.height;\n    if (s.cover) { h.rect(0, 0, W, H, s.cover === true ? 'ink' : s.cover); } else if (s.dim !== false) { for (let y = 0; y < H; y += 2) h.rect(0, y, W, 1, 'ink'); }\n    if (s.title) { const scale = s.titleScale ?? 2; h.text(0, s.titleY ?? 32, s.title, { anchor: 'top', scale, color: s.titleColor ?? 'sand' }); }\n    if (s.sub) wrap(s.sub, 70).forEach((l, i) => h.text(0, (s.titleY ?? 32) + 22 + i * 10, l, { anchor: 'top', color: 'mist' }));\n    if (s.tabs) { let x = 24; hud.promptAt(x, 8, 'tabL', ''); x += 22; s.tabs.forEach((t, i) => { const f = i === s.tab; if (f) h.rect(x - 2, 6, t.length * 6 + 4, 12, 'orange'); h.text(x, 9, t, { color: f ? 'ink' : 'white', shadow: false }); x += t.length * 6 + 9; }); hud.promptAt(x, 8, 'tabR', ''); }\n    if (s.paged) {\n      const page = s.pages[s.page] ?? [];\n      page.forEach((l, i) => { const big = l.big; const text = big ? l.big : l; h.text(s.pageX ?? 24, (s.pageY ?? 56) + i * 10, text, { color: big ? 'sand' : 'white' }); });\n      h.text(0, H - 40, `${s.page + 1} / ${s.pages.length}`, { anchor: 'top', color: 'mist' });\n      hud.footer([['left', 'PAGE'], ['back', 'BACK']]);\n      s.draw?.(s); return;\n    }\n    const items = this.items(s), page = Math.floor(s.focus / PAGE);\n    for (let i = page * PAGE; i < Math.min(items.length, (page + 1) * PAGE); i++) {\n      const it = items[i], r = this.rowRect(s, i), f = i === s.focus, dis = it.disabled?.();\n      if (f) { h.rect(0, r.y, W, r.h, 'orange'); h.rect(16, r.y + 5, 6, 10, 'ink'); }\n      const colour = f ? 'ink' : dis ? 'slate' : 'white';\n      h.text(28, r.y + 3, it.label, { scale: it.small ? 1 : 2, color: colour, shadow: f ? false : 'ink' });\n      const val = it.value?.();\n      if (val !== undefined && val !== null) {\n        if (typeof val === 'number') { const X = W - 124; h.rect(X, r.y + 6, 100, 8, f ? 'plum' : 'night'); h.rect(X, r.y + 6, Math.round(100 * clamp(val, 0, 1)), 8, f ? 'ink' : 'sand'); if (it.valueText) h.text(X - 4 - it.valueText().length * 6, r.y + 6, it.valueText(), { color: colour, shadow: false }); }\n        else h.text(W - 28 - val.length * 12, r.y + 3, val, { scale: 2, color: colour, shadow: f ? false : 'ink' });\n      }\n    }\n    if (items.length > PAGE) h.text(0, TOP + PAGE * ROW + 2, `PAGE ${page + 1}/${Math.ceil(items.length / PAGE)}`, { anchor: 'top', color: 'mist' });\n    s.draw?.(s);\n    if (s.footer !== false) hud.footer(s.footer ?? [['confirm', 'OK'], ...(s.back === null ? [] : [['back', 'BACK']])]);\n    this.game.hud.prompts.push(...items.map((i) => `[ITEM] ${i.label}`));\n  }\n}\nEOF\necho ok","description":"Write glyphs, HUD and menu system"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20376,"cache_read_input_tokens":444721,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20376},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"4e1b4a35-83d3-4f7a-b000-6f0ac3bb1175","timestamp":"2026-11-05T23:58:43.172Z","request_id":"req_011CgkgidW9yVS8FTEhkkA2E","wire_tool_inputs":{"toolu_019atBQV9CCTjQ1KWNQWDvu3":{"command":"cat > src/ui/glyphs.js <<'EOF'\n// Prompts follow the input used last. PlayStation shapes, Xbox letters, key caps and mouse buttons, as pixel art.\nimport { ACTIONS } from '../core/actions.js';\nconst R = (s) => s.trim().split('\\n').map((l) => l.trim());\nexport const SPRITES = {\n  cross: R(`\n...ooooo...\n..o.....o..\n.o.w...w.o.\no...w.w...o\no....w....o\no...w.w...o\n.o.w...w.o.\n..o.....o..\n...ooooo...`),\n  circle: R(`\n...ooooo...\n..o.....o..\n.o..rrr..o.\no..r...r..o\no..r...r..o\no..r...r..o\n.o..rrr..o.\n..o.....o..\n...ooooo...`),\n  square: R(`\n...ooooo...\n..o.....o..\n.o.sssss.o.\no..s...s..o\no..s...s..o\no..s...s..o\n.o.sssss.o.\n..o.....o..\n...ooooo...`),\n  triangle: R(`\n...ooooo...\n..o..g..o..\n.o..g.g..o.\no...g.g...o\no..g...g..o\no..g...g..o\n.o.ggggg.o.\n..o.....o..\n...ooooo...`),\n  dpadU: R(`\n...www...\n...www...\n...www...\n.ooo.ooo.\n.ooo.ooo.\n.ooo.ooo.\n...ooo...\n...ooo...\n...ooo...`),\n  dpadD: R(`\n...ooo...\n...ooo...\n...ooo...\n.ooo.ooo.\n.ooo.ooo.\n.ooo.ooo.\n...www...\n...www...\n...www...`),\n  dpadL: R(`\n...ooo...\n...ooo...\n...ooo...\n.www.ooo.\n.www.ooo.\n.www.ooo.\n...ooo...\n...ooo...\n...ooo...`),\n  dpadR: R(`\n...ooo...\n...ooo...\n...ooo...\n.ooo.www.\n.ooo.www.\n.ooo.www.\n...ooo...\n...ooo...\n...ooo...`),\n  options: R(`\n.ooooooo.\n.o.www.o.\n.o.....o.\n.o.www.o.\n.o.....o.\n.o.www.o.\n.ooooooo.`),\n  create: R(`\n.ooooooo.\n.o..w..o.\n.o.www.o.\n.o..w..o.\n.o..w..o.\n.ooooooo.`),\n  lmb: R(`\n..ooooo..\n.owwoooo.\n.owwo..o.\n.owwo..o.\n.ooooooo.\n.o.....o.\n.o.....o.\n.o.....o.\n..ooooo..`),\n  rmb: R(`\n..ooooo..\n.oooowwo.\n.o..owwo.\n.o..owwo.\n.ooooooo.\n.o.....o.\n.o.....o.\n.o.....o.\n..ooooo..`),\n  mmb: R(`\n..ooooo..\n.o..w..o.\n.o..w..o.\n.o..w..o.\n.ooooooo.\n.o.....o.\n.o.....o.\n.o.....o.\n..ooooo..`),\n  wheel: R(`\n..ooooo..\n.o.www.o.\n.o.www.o.\n.o.www.o.\n.ooooooo.\n.o.....o.\n.o.....o.\n.o.....o.\n..ooooo..`),\n};\nconst COLORS = { o: 'mist', w: 'white', r: 'red', s: 'orange', g: 'lime' };\nconst PS = { PadCross: 'cross', PadCircle: 'circle', PadSquare: 'square', PadTriangle: 'triangle', PadUp: 'dpadU', PadDown: 'dpadD', PadLeft: 'dpadL', PadRight: 'dpadR', PadOptions: 'options', PadCreate: 'create' };\nconst PS_CAP = { PadL1: 'L1', PadR1: 'R1', PadL2: 'L2', PadR2: 'R2', PadL3: 'L3', PadR3: 'R3' };\nconst XB_CAP = { PadCross: 'A', PadCircle: 'B', PadSquare: 'X', PadTriangle: 'Y', PadL1: 'LB', PadR1: 'RB', PadL2: 'LT', PadR2: 'RT', PadL3: 'LS', PadR3: 'RS', PadOptions: 'MENU', PadCreate: 'VIEW' };\nconst KEY = { MouseLeft: 'lmb', MouseRight: 'rmb', MouseMiddle: 'mmb' };\nconst KEY_TEXT = { Space: 'SPACE', ShiftLeft: 'SHIFT', ShiftRight: 'SHIFT', Escape: 'ESC', Enter: 'ENTER', Tab: 'TAB', CapsLock: 'CAPS', ArrowUp: 'UP', ArrowDown: 'DOWN', ArrowLeft: 'LEFT', ArrowRight: 'RIGHT' };\nconst XB_COLOR = { A: 'lime', B: 'red', X: 'sky', Y: 'sand' };\n/** What to draw for an action: { sprite } or { cap, color }, and a name tests can read. */\nexport function glyphOf(action, device, xbox) {\n  const a = ACTIONS[action]; if (!a) return { cap: '?', name: '?' };\n  if (device === 'pad' && a.pad) {\n    if (xbox) { const c = XB_CAP[a.pad]; if (c) return { cap: c, color: XB_COLOR[c] ?? 'white', name: c }; }\n    if (PS[a.pad]) return { sprite: PS[a.pad], name: PS[a.pad].toUpperCase() };\n    return { cap: PS_CAP[a.pad] ?? a.pad.replace('Pad', ''), color: 'white', name: PS_CAP[a.pad] ?? a.pad };\n  }\n  const code = a.kbm?.[0] ?? a.pad;\n  if (KEY[code]) return { sprite: KEY[code], name: KEY[code].toUpperCase() };\n  const text = KEY_TEXT[code] ?? String(code).replace('Key', '').replace('Digit', '');\n  return { cap: text, color: 'white', name: text };\n}\nexport function glyphWidth(g) { if (g.sprite) return SPRITES[g.sprite][0].length; return g.cap.length * 6 + 3; }\n/** Draw at (x, y) top-left. */\nexport function drawGlyph(hud, x, y, g) {\n  if (g.sprite) { hud.sprite(x, y, SPRITES[g.sprite], COLORS); return glyphWidth(g); }\n  const w = glyphWidth(g);\n  hud.rect(x, y, w, 10, 'ink'); hud.rect(x, y, w, 1, 'mist'); hud.rect(x, y + 9, w, 1, 'mist'); hud.rect(x, y, 1, 10, 'mist'); hud.rect(x + w - 1, y, 1, 10, 'mist');\n  hud.text(x + 2, y + 2, g.cap, { color: g.color ?? 'white', shadow: false });\n  return w;\n}\nEOF\ncat > src/ui/hud.js <<'EOF'\n// Everything drawn with ctx.hud. The HUD in play is minimal and hides six seconds after it last changed.\nimport { THREE } from '../../pixel-engine.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { siteById } from '../content/sites.js';\nimport { clamp } from '../world/geom.js';\nimport { drawGlyph, glyphOf, glyphWidth } from './glyphs.js';\nimport { wrap } from './pixfont.js';\nconst { Vector3 } = THREE;\nconst v = new Vector3();\nconst GUN_ICON = { sidearm: ['oooo..', 'oooooo', '.oo...', '.oo...'], main: ['oo.........', 'ooooooooooo', 'ooo.o......', '....o......'], special: ['.oooooooo.', 'oooooooooo', '.oooooooo.', '...oo.....'], melee: ['......oo', '....oo..', '..oo....', 'oo......'], mounted: ['oo.........', 'ooooooooooo', '...oo......', '..oooo.....'] };\nexport class Hud {\n  hudT = 6; prompts = []; noticeT = 0; noticeText = null; holdTimer = null; blackoutT = 0; blackoutText = ''; bloodT = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.h = ctx.hud; }\n  touch() { this.hudT = 6; }\n  get xbox() { return this.game.settings.glyphs === 'xbox'; }\n  glyph(action) { return glyphOf(action, this.game.device, this.xbox); }\n  /** A prompt: glyph plus verb, centred at the bottom. */\n  promptLine(actions, text, y) {\n    const h = this.h, list = Array.isArray(actions) ? actions : [actions], gs = list.map((a) => this.glyph(a));\n    const tw = text.length * 6, w = gs.reduce((s, g) => s + glyphWidth(g) + 3, 0) + tw;\n    let x = Math.round((h.width - w) / 2);\n    h.rect(x - 4, y - 2, w + 8, 14, 'ink');\n    for (const g of gs) { drawGlyph(h, x, y, g); x += glyphWidth(g) + 3; }\n    h.text(x, y + 2, text, { color: 'white' });\n    this.prompts.push(`[${gs.map((g) => g.name).join('+')}] ${text}`);\n  }\n  promptAt(x, y, action, text, color = 'white') { const g = this.glyph(action); drawGlyph(this.h, x, y, g); this.h.text(x + glyphWidth(g) + 3, y + 2, text, { color }); this.prompts.push(`[${g.name}] ${text}`); return glyphWidth(g) + 3 + text.length * 6; }\n  footer(items) { // Bottom-row prompts for menus.\n    const h = this.h; let x = 24; const y = h.height - 26;\n    for (const [action, text] of items) { x += this.promptAt(x, y, action, text) + 12; }\n  }\n  world(x, y, z) { v.set(x, y, z).project(this.ctx.camera.camera); if (v.z > 1) return null; return [((v.x + 1) / 2) * this.h.width, ((1 - v.y) / 2) * this.h.height]; }\n  // ----- In play -----\n  drawPlay(dt) {\n    const g = this.game, h = this.h, p = g.player;\n    this.hudT = Math.max(0, this.hudT - dt);\n    const sw = h.width, sh = h.height;\n    const scoped = g.isScoped();\n    if (scoped) this.scopeMask();\n    if (g.monocularUp) this.monocularMask();\n    this.effects(dt);\n    // Reticle.\n    if (!scoped && !p.vehicle && !p.mapUp && !g.cam.override && !g.monocularUp) { const cx = sw >> 1, cy = sh >> 1; h.rect(cx - 1 + (p.mounted ? 0 : 0), cy - 1, 2, 2, g.gunSlung() ? 'slate' : 'white'); if (g.combat.hitMark > 0) for (let k = 3; k < 7; k++) for (const [a, b] of [[1, 1], [-1, 1], [1, -1], [-1, -1]]) h.rect(cx + a * k, cy + b * k, 1, 1, 'white'); }\n    if (p.mounted) { const heat = g.combat.heat / WEAPONS.mg.overheat; h.rect((sw >> 1) - 20, (sh >> 1) + 16, 40, 2, 'ink'); h.rect((sw >> 1) - 20, (sh >> 1) + 16, Math.round(40 * heat), 2, g.combat.overheated ? 'red' : 'orange'); }\n    // Overheads: the only detection UI.\n    for (const a of g.actors.overheads()) { const s = this.world(a.x, a.y + 2.05, a.z); if (s) h.text(Math.round(s[0]) - 3, Math.round(s[1]) - 8, a.state === 'alert' ? '!' : '?', { color: a.state === 'alert' ? 'red' : 'sand' }); }\n    // Downed buddy marker.\n    const d = g.buddies.down; if (d) { const s = this.world(d.a.x, d.a.y + 1.5, d.a.z); if (s) { const cx = Math.round(s[0]), cy = Math.round(s[1]); h.rect(cx - 1, cy - 5, 3, 11, 'lime'); h.rect(cx - 5, cy - 1, 11, 3, 'lime'); h.text(cx - 6, cy + 8, String(Math.ceil(d.a.downT)), { color: 'lime' }); } }\n    // Stats.\n    if (this.hudT > 0 || p.hp < 60 || g.body.feverActive) {\n      const seg = 5, sx = 24, sy = sh - 22;\n      for (let i = 0; i < seg; i++) { const top = (i + 1) * 20, fill = clamp((p.hp - i * 20) / 20, 0, 1); h.rect(sx + i * 17, sy, 15, 6, 'ink'); h.rect(sx + i * 17, sy, Math.round(15 * fill), 6, p.hp < 20 ? 'red' : top <= g.body.segmentTop() ? 'white' : 'mist'); }\n      h.text(sx, sy + 8, `SYRETTE ${p.syrettes}`, { color: 'white' }); h.text(sx + 66, sy + 8, `TABLET ${p.tablets}`, { color: g.body.feverActive ? 'red' : 'white' });\n      if (p.stones || this.hudT > 0) h.text(24, sh - 34, `STONES ${p.stones}`, { color: 'sand' });\n      if (p.carrying) h.text(24, sh - 46, 'CARRYING A CASE', { color: 'sand' });\n    }\n    if ((this.hudT > 0 || g.combat.current()?.jammed) && !p.vehicle) {\n      const gun = g.combat.current();\n      if (gun) {\n        const w = WEAPONS[gun.id], x = sw - 24;\n        if (!w.melee && gun.id !== 'mg') h.text(x, sh - 14, `${gun.mag}/${gun.reserve}`, { anchor: 'top-left', color: 'white', ...{} , scale: 1 }) ;\n        const col = gun.jammed ? 'red' : gun.cond >= 60 ? 'white' : gun.cond >= 30 ? 'orange' : 'red';\n        const icon = GUN_ICON[w.slot] ?? GUN_ICON.main;\n        h.sprite(sw - 24 - icon[0].length, sh - 24, icon, { o: col });\n        h.text(sw - 24 - w.name.length * 6, sh - 34, w.name, { color: 'mist' });\n        if (p.molotovs) h.text(sw - 90, sh - 24, `BOTTLE ${p.molotovs}`, { color: 'white' });\n        if (p.charges || p.planted.length) h.text(sw - 90, sh - 14, `CHARGE ${p.charges}${p.planted.length ? '*' : ''}`, { color: p.planted.length ? 'red' : 'white' });\n      }\n    }\n    // Vehicle state.\n    if (p.vehicle && !p.mounted) { const veh = p.vehicle; h.text(sw - 24 - 60, sh - 14, `${Math.round(Math.abs(veh.v.speed) * 3.6)} KM/H`, { color: 'white' }); if (veh.hp < 35) h.text(sw - 24 - 66, sh - 24, veh.stalled ? 'ENGINE DEAD' : 'ENGINE HOT', { color: 'red' }); }\n    // Mission step at the top for five seconds.\n    const M = g.missions; if (M.textT > 0 && M.textStr) { const lines = wrap(M.textStr, 60); lines.forEach((l, i) => h.text(0, 16 + i * 10, l, { anchor: 'top', color: 'sand' })); }\n    if (this.holdTimer !== null) h.text(0, 40, `HOLD ${Math.ceil(this.holdTimer)}`, { anchor: 'top', color: 'orange', scale: 2 });\n    if (g.side) h.text(0, 40, `CRATE: ${Math.ceil(g.side.t)} S`, { anchor: 'top', color: g.side.t < 60 ? 'red' : 'sand' });\n    if (this.noticeT > 0) { this.noticeT -= dt; h.text(0, 62, this.noticeText, { anchor: 'top', color: 'white' }); }\n    // Subtitles.\n    this.subtitle();\n    // Prompts.\n    this.drawPrompts();\n    // The tracker's small readout sits on its own device, and the wind on the GPS.\n    if (g.tracker.up) { const near = g.tracker.nearestD; h.text(0, 24, near < 60 ? 'SIGNAL' : 'NO SIGNAL', { anchor: 'top', color: near < 60 ? 'lime' : 'slate' }); }\n    if (g.ledgerUp) this.ledgerSheet();\n    if (g.demoTag) { h.rect(0, 0, 46, 14, 'red', 'top-left'); h.text(6, 4, 'DEMO', { color: 'white' }); this.promptAt(sw - 90, 4, 'confirm', 'PRESS'); }\n  }\n  drawPrompts() {\n    const g = this.game, h = this.h, P = g.prompt, p = g.player, baseY = h.height - 44;\n    let y = baseY;\n    const line = (a, t) => { this.promptLine(a, t, y); y -= 14; };\n    if (p.mapUp) { line('mark', 'SET WAYPOINT'); line('zoom', 'ZOOM'); line('map', 'PUT IT AWAY'); return; }\n    if (P.choice) { const c = P.choice, x0 = Math.round(h.width / 2) - 100; h.rect(x0 - 6, y - 4, 212, 16, 'ink'); let x = x0; if (c.use) x += this.promptAt(x, y, 'use', c.use, 'lime') + 14; else { h.text(x, y + 2, 'NO SYRETTES', { color: 'slate' }); x += 80; } this.promptAt(x, y, 'finish', c.finish, c.radio ? 'mist' : 'red'); y -= 16; }\n    if (p.surgery) return;\n    if (P.current) {\n      const c = P.current;\n      if (c.passive) { if (this.hudT > 3) line('exit', c.label); }\n      else {\n        line('use', c.label);\n        if (c.hold) { const k = clamp(P.holdT / c.hold, 0, 1), W = 80; h.rect((h.width - W) >> 1, y + 12, W, 3, 'ink'); h.rect((h.width - W) >> 1, y + 12, Math.round(W * k), 3, 'orange'); }\n      }\n    }\n    const veh = p.vehicle;\n    if (veh && this.hudT > 3) { if (p.mounted) line('swap', 'BACK TO THE WHEEL'); else if (veh.t.gun) line('swap', 'SWAP TO GUN'); }\n    if (g.body.feverActive && g.story.feverOn || g.body.feverActive && g.missions.step?.script === 'm1Wake') line('tablet', 'TABLET');\n    if (p.hp < 20 && p.hp > 0 && !p.vehicle) line('heal', 'FIELD SURGERY');\n    if (P.flashT > 0 && P.flashText) line(P.flashAction, P.flashText);\n    const gun = g.combat.current();\n    if (gun?.jammed && !(P.flashT > 0)) line('reload', `CLEAR THE JAM x${gun.jamLeft}`);\n    if (p.planted.length && !p.vehicle) line('throw', 'DETONATE');\n  }\n  subtitle() {\n    const s = this.game.talk.subtitle(), h = this.h, scale = this.game.settings.subtitle === 'large' ? 2 : 1;\n    const base = h.height - 60 - (scale - 1) * 20;\n    if (s) {\n      const cols = scale === 2 ? 38 : 72, lines = wrap(s.text, cols), lh = scale * 10;\n      const topY = base - lines.length * lh;\n      if (s.who) h.text(0, topY - lh + scale, s.who, { anchor: 'top', color: s.color, scale: 1 });\n      lines.forEach((l, i) => h.text(0, topY + i * lh + scale, l, { anchor: 'top', color: 'white', shadow: 'ink', scale }));\n    } else if (this.game.talk.barkText && this.game.talk.barkT > 0) h.text(0, base - 10, this.game.talk.barkText, { anchor: 'top', color: 'mist' });\n  }\n  effects(dt) {\n    const g = this.game, h = this.h, p = g.player;\n    if (p.burning > 0) { const r = g.world.look; for (let i = 0; i < 26; i++) { const e = r.next(), x = r.next() * h.width, k = r.next(); const y = e < 0.5 ? h.height - k * 40 : r.next() * h.height, X = e < 0.5 ? x : (e < 0.75 ? k * 30 : h.width - k * 30); h.rect(X | 0, y | 0, 3, 3, r.pick(['orange', 'red', 'sand'])); } }\n    if (g.flashBlood > 0) { g.flashBlood -= dt; for (let y = 0; y < h.height; y += 3) { h.rect(0, y, 16, 1, 'red'); h.rect(h.width - 16, y, 16, 1, 'red'); } }\n    if (this.blackoutT > 0) { this.blackoutT -= dt; h.rect(0, 0, h.width, h.height, 'ink'); if (this.blackoutText) { wrap(this.blackoutText, 60).forEach((l, i) => h.text(0, 110 + i * 12, l, { anchor: 'top', color: 'sand' })); } }\n    if (g.body.fever > 0.75 && !g.settings.feverReduced) { const k = (g.body.fever - 0.75) * 4 * 16; for (let y = 0; y < h.height; y += 4) { h.rect(0, y, Math.round(k), 2, 'ink'); h.rect(h.width - Math.round(k), y, Math.round(k), 2, 'ink'); } }\n    if (p.mapUp && g.cam.override) { /* the chase camera gives way to the map */ }\n  }\n  scopeMask() {\n    const h = this.h, cx = h.width >> 1, cy = h.height >> 1, R2 = 118;\n    for (let y = 0; y < h.height; y++) { const d = y - cy, w = d * d < R2 * R2 ? Math.round(Math.sqrt(R2 * R2 - d * d)) : 0; if (!w) h.rect(0, y, h.width, 1, 'ink'); else { h.rect(0, y, cx - w, 1, 'ink'); h.rect(cx + w, y, h.width - cx - w, 1, 'ink'); } }\n    h.rect(cx - R2, cy, R2 * 2, 1, 'ink'); h.rect(cx, cy - R2, 1, R2 * 2, 'ink');\n  }\n  monocularMask() {\n    const h = this.h, cx = h.width >> 1, cy = h.height >> 1, R2 = 110;\n    for (let y = 0; y < h.height; y++) { const d = y - cy, w = d * d < R2 * R2 ? Math.round(Math.sqrt(R2 * R2 - d * d)) : 0; if (!w) h.rect(0, y, h.width, 1, 'ink'); else { h.rect(0, y, cx - w, 1, 'ink'); h.rect(cx + w, y, h.width - cx - w, 1, 'ink'); } }\n    for (let k = -3; k <= 3; k++) h.rect(cx + k * 20, cy + 40, 1, k % 2 ? 3 : 6, 'lime');\n  }\n  ledgerSheet() {\n    const g = this.game, h = this.h, l = g.ledgerNow(); const W = 290, x = (h.width - W) >> 1, y = 44;\n    h.rect(x, y, W, 150, 'sand'); h.rect(x + 2, y + 2, W - 4, 146, 'ink');\n    h.text(x + 12, y + 10, 'THE LEDGER, IN HIS HAND', { color: 'sand' });\n    g.ledgerLines(l).forEach(([k, val], i) => { h.text(x + 12, y + 30 + i * 22, k, { color: 'mist' }); h.text(x + W - 14 - val.length * 12, y + 26 + i * 22, val, { color: 'white', scale: 2 }); });\n    this.promptAt(x + 12, y + 134, 'ledger', 'CLOSE');\n  }\n  // Scene buttons (two at most).\n  choiceRects(n) { const w = this.h.width, W = 180, gap = 12, total = n * W + (n - 1) * gap; return Array.from({ length: n }, (_, i) => ({ x: ((w - total) >> 1) + i * (W + gap), y: this.h.height - 60, w: W, h: 20 })); }\n  drawScene() {\n    const g = this.game, s = g.talk.scene, h = this.h; if (!s) return;\n    const bars = 22; h.rect(0, 0, h.width, bars, 'ink'); h.rect(0, h.height - bars, h.width, bars, 'ink');\n    this.subtitle();\n    if (s.choosing) {\n      this.choiceRects(s.choices.length).forEach((r, i) => { const f = i === s.focusI; h.rect(r.x, r.y, r.w, r.h, f ? 'orange' : 'night'); h.text(r.x + r.w / 2 - (s.choices[i].text.length * 3), r.y + 6, s.choices[i].text, { color: f ? 'ink' : 'white', shadow: false }); });\n      this.footer([['confirm', 'CHOOSE']]);\n      this.prompts.push(...s.choices.map((c) => `[CHOICE] ${c.text}`));\n    } else if (s.skippable) this.promptAt(h.width - 90, h.height - 18, 'confirm', 'SKIP');\n  }\n  pointer() { const p = this.ctx.input.pointer; return [((p.x + 1) / 2) * this.h.width, ((1 - p.y) / 2) * this.h.height]; }\n  choiceHit(s, n) { const g = this.game; if (!g.mouseMoved) return null; const [x, y] = this.pointer(); const rects = this.choiceRects(n); for (let i = 0; i < n; i++) { const r = rects[i]; if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) return i; } return null; }\n  clicked(s, n) { for (const e of this.ctx.input.buttonEvents) if (!e.down && (e.code === 'MouseLeft' || e.code === 'Touch')) { const X = ((e.x + 1) / 2) * this.h.width, Y = ((1 - e.y) / 2) * this.h.height, rects = this.choiceRects(n); for (let i = 0; i < n; i++) { const r = rects[i]; if (X >= r.x && X < r.x + r.w && Y >= r.y && Y < r.y + r.h) { s.focusI = i; return true; } } } return false; }\n}\nexport { siteById };\nEOF\ncat > src/ui/menu.js <<'EOF'\n// Menus: at most six items, one idea per screen. Pad, keyboard and mouse, all native. No DOM.\nimport { pressed } from '../core/actions.js';\nimport { clamp } from '../world/geom.js';\nimport { wrap } from './pixfont.js';\nconst PAGE = 6, ROW = 22, TOP = 70;\nexport class UI {\n  stack = []; repeatT = 0; repeatDir = 0; dragging = null;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.h = ctx.hud; }\n  get top() { return this.stack[this.stack.length - 1] ?? null; }\n  push(s) { s.focus ??= 0; s.page ??= 0; this.stack.push(s); s.onShow?.(s); this.skipFrame = true; return s; }\n  pop() { const s = this.stack.pop(); s?.onClose?.(s); this.game.audio.play('ui-back'); this.skipFrame = true; return s; }\n  replace(s) { this.stack.pop(); return this.push(s); }\n  clear() { this.stack.length = 0; }\n  items(s) { return typeof s.items === 'function' ? s.items(s) : s.items ?? []; }\n  /** Movement from pad, stick or keys, with key repeat on holding. */\n  nav() {\n    const input = this.ctx.input;\n    let dir = 0;\n    if (pressed(input, 'up')) dir = -1; else if (pressed(input, 'down')) dir = 1;\n    let lr = 0;\n    if (pressed(input, 'left')) lr = -1; else if (pressed(input, 'right')) lr = 1;\n    const ax = input.padAxis;\n    const held = input.anyDown(['ArrowUp', 'KeyW', 'PadUp']) ? -1 : input.anyDown(['ArrowDown', 'KeyS', 'PadDown']) ? 1 : Math.abs(ax.y) > 0.5 ? -Math.sign(ax.y) : 0;\n    const heldLR = input.anyDown(['ArrowLeft', 'KeyA', 'PadLeft']) ? -1 : input.anyDown(['ArrowRight', 'KeyD', 'PadRight']) ? 1 : Math.abs(ax.x) > 0.5 ? Math.sign(ax.x) : 0;\n    const key = held * 10 + heldLR;\n    if (key !== this.repeatDir) { this.repeatDir = key; this.repeatT = 0.34; if (key && Math.abs(ax.y) + Math.abs(ax.x) > 0.5 && !dir && !lr) { dir = held; lr = heldLR; } }\n    else if (key) { this.repeatT -= 1 / 60; if (this.repeatT <= 0) { this.repeatT = 0.09; this.accel = (this.accel ?? 0) + 1; dir = held; lr = heldLR; } } else this.accel = 0;\n    return { dir, lr };\n  }\n  update() {\n    const s = this.top; if (!s) return;\n    if (this.skipFrame) { this.skipFrame = false; return; }\n    const input = this.ctx.input, g = this.game, items = this.items(s);\n    s.update?.(s);\n    if (this.top !== s) return;\n    const { dir, lr } = this.nav();\n    if (s.paged) { // A paged reader.\n      const n = s.pages.length;\n      if (lr || dir || input.wheel) { const d = lr || dir || Math.sign(input.wheel); const was = s.page; s.page = clamp(s.page + d, 0, n - 1); if (was !== s.page) g.audio.play('ui-move'); }\n      if (pressed(input, 'tabR')) s.page = Math.min(n - 1, s.page + 1); if (pressed(input, 'tabL')) s.page = Math.max(0, s.page - 1);\n      if (pressed(input, 'back') || pressed(input, 'confirm') || this.clickedAnywhere()) { if (s.back) s.back(s); else this.pop(); }\n      return;\n    }\n    if (s.tabs) {\n      if (pressed(input, 'tabL')) { s.tab = (s.tab + s.tabs.length - 1) % s.tabs.length; s.focus = 0; g.audio.play('ui-move'); }\n      if (pressed(input, 'tabR')) { s.tab = (s.tab + 1) % s.tabs.length; s.focus = 0; g.audio.play('ui-move'); }\n    }\n    if (items.length) {\n      if (dir) { let f = s.focus; for (let k = 0; k < items.length; k++) { f = (f + dir + items.length) % items.length; if (!items[f].disabled?.()) break; } if (f !== s.focus) { s.focus = f; g.audio.play('ui-move'); } }\n      s.focus = clamp(s.focus, 0, items.length - 1);\n      this.mouse(s, items);\n      const it = items[s.focus];\n      if (lr && it?.adjust) { it.adjust(lr * (1 + Math.min(8, (this.accel ?? 0) >> 2))); g.audio.play('ui-move', { volume: 0.6 }); }\n      if (input.wheel && items.length > PAGE) { s.focus = clamp(s.focus + Math.sign(input.wheel) * PAGE, 0, items.length - 1); }\n      if (it?.resetOne && pressed(input, 'resetOne')) { it.resetOne(); g.audio.play('ui-back'); }\n      if (pressed(input, 'confirm') && it && !it.disabled?.()) { if (it.action) { g.audio.play('ui-confirm'); it.action(); return; } if (it.adjust) it.adjust(1); }\n    }\n    s.extra?.(s);\n    if (this.top !== s) return;\n    if (pressed(input, 'back')) { if (s.back === null) return; if (s.back) s.back(s); else this.pop(); }\n  }\n  clickedAnywhere() { return this.ctx.input.buttonEvents.some((e) => !e.down && (e.code === 'MouseLeft' || e.code === 'Touch')); }\n  pointerXY(e) { return [((e.x + 1) / 2) * this.h.width, ((1 - e.y) / 2) * this.h.height]; }\n  rowRect(s, i) { const p = Math.floor(i / PAGE), y = (s.top ?? TOP) + (i - p * PAGE) * ROW; return { x: 0, y, w: this.h.width, h: ROW - 2, page: p }; }\n  mouse(s, items) {\n    const input = this.ctx.input, g = this.game, ptr = input.pointer, page = Math.floor(s.focus / PAGE);\n    const [px, py] = this.pointerXY(ptr);\n    if (g.mouseMoved && ptr.over !== false) for (let i = page * PAGE; i < Math.min(items.length, (page + 1) * PAGE); i++) { const r = this.rowRect(s, i); if (py >= r.y && py < r.y + r.h && !items[i].disabled?.()) { if (s.focus !== i) { s.focus = i; g.audio.play('ui-move', { volume: 0.5 }); } break; } }\n    for (const e of input.buttonEvents) {\n      const [x, y] = this.pointerXY(e);\n      if (e.down && (e.code === 'MouseLeft' || e.code === 'Touch')) for (let i = page * PAGE; i < Math.min(items.length, (page + 1) * PAGE); i++) { const r = this.rowRect(s, i); if (y >= r.y && y < r.y + r.h && !items[i].disabled?.()) { s.focus = i; if (items[i].set) this.dragging = items[i]; this.pressRow = i; } }\n      if (!e.down && (e.code === 'MouseLeft' || e.code === 'Touch')) {\n        this.dragging = null;\n        const pressRow = this.pressRow; this.pressRow = null;\n        if (pressRow !== undefined && pressRow !== null) { const r = this.rowRect(s, pressRow); if (y >= r.y && y < r.y + r.h) { const it = items[pressRow]; if (it?.action) { g.audio.play('ui-confirm'); it.action(); return; } if (it?.adjust && !it.set) it.adjust(x > this.h.width / 2 ? 1 : -1); } }\n      }\n      void x;\n    }\n    if (this.dragging && input.isDown('MouseLeft', 'Touch')) { const X = this.pointerXY(ptr)[0], W = this.h.width; this.dragging.set(clamp((X - (W - 124)) / 100, 0, 1)); }\n  }\n  /** Draw the top screen. */\n  draw() {\n    const s = this.top; if (!s) return;\n    const h = this.h, hud = this.game.hud, W = h.width, H = h.height;\n    if (s.cover) { h.rect(0, 0, W, H, s.cover === true ? 'ink' : s.cover); } else if (s.dim !== false) { for (let y = 0; y < H; y += 2) h.rect(0, y, W, 1, 'ink'); }\n    if (s.title) { const scale = s.titleScale ?? 2; h.text(0, s.titleY ?? 32, s.title, { anchor: 'top', scale, color: s.titleColor ?? 'sand' }); }\n    if (s.sub) wrap(s.sub, 70).forEach((l, i) => h.text(0, (s.titleY ?? 32) + 22 + i * 10, l, { anchor: 'top', color: 'mist' }));\n    if (s.tabs) { let x = 24; hud.promptAt(x, 8, 'tabL', ''); x += 22; s.tabs.forEach((t, i) => { const f = i === s.tab; if (f) h.rect(x - 2, 6, t.length * 6 + 4, 12, 'orange'); h.text(x, 9, t, { color: f ? 'ink' : 'white', shadow: false }); x += t.length * 6 + 9; }); hud.promptAt(x, 8, 'tabR', ''); }\n    if (s.paged) {\n      const page = s.pages[s.page] ?? [];\n      page.forEach((l, i) => { const big = l.big; const text = big ? l.big : l; h.text(s.pageX ?? 24, (s.pageY ?? 56) + i * 10, text, { color: big ? 'sand' : 'white' }); });\n      h.text(0, H - 40, `${s.page + 1} / ${s.pages.length}`, { anchor: 'top', color: 'mist' });\n      hud.footer([['left', 'PAGE'], ['back', 'BACK']]);\n      s.draw?.(s); return;\n    }\n    const items = this.items(s), page = Math.floor(s.focus / PAGE);\n    for (let i = page * PAGE; i < Math.min(items.length, (page + 1) * PAGE); i++) {\n      const it = items[i], r = this.rowRect(s, i), f = i === s.focus, dis = it.disabled?.();\n      if (f) { h.rect(0, r.y, W, r.h, 'orange'); h.rect(16, r.y + 5, 6, 10, 'ink'); }\n      const colour = f ? 'ink' : dis ? 'slate' : 'white';\n      h.text(28, r.y + 3, it.label, { scale: it.small ? 1 : 2, color: colour, shadow: f ? false : 'ink' });\n      const val = it.value?.();\n      if (val !== undefined && val !== null) {\n        if (typeof val === 'number') { const X = W - 124; h.rect(X, r.y + 6, 100, 8, f ? 'plum' : 'night'); h.rect(X, r.y + 6, Math.round(100 * clamp(val, 0, 1)), 8, f ? 'ink' : 'sand'); if (it.valueText) h.text(X - 4 - it.valueText().length * 6, r.y + 6, it.valueText(), { color: colour, shadow: false }); }\n        else h.text(W - 28 - val.length * 12, r.y + 3, val, { scale: 2, color: colour, shadow: f ? false : 'ink' });\n      }\n    }\n    if (items.length > PAGE) h.text(0, TOP + PAGE * ROW + 2, `PAGE ${page + 1}/${Math.ceil(items.length / PAGE)}`, { anchor: 'top', color: 'mist' });\n    s.draw?.(s);\n    if (s.footer !== false) hud.footer(s.footer ?? [['confirm', 'OK'], ...(s.back === null ? [] : [['back', 'BACK']])]);\n    this.game.hud.prompts.push(...items.map((i) => `[ITEM] ${i.label}`));\n  }\n}\nEOF\necho ok","description":"Write glyphs, HUD and menu system"}}}
