, z: P.z + 40, duty: 'guard', tag: 'test', yaw: Math.PI }); e.step(3); g.story.pass = null; g.world.setHour(12, true); const seen2 = () => { a.suspicion = 0; a.state = 'idle'; a.provokedBy = false; P.crouched = false; }; seen2(); for (let k = 0; k < 30; k++) g.actors.perceive(a, 0.1); ok(a.state === 'alert', 'seen by day at 40 m');\n  seen2(); P.crouched = true; a.x = P.x; a.z = P.z + 60; a.ctrl.teleport([a.x, W.land.heightAt(a.x, a.z), a.z]); e.step(2); for (let k = 0; k < 30; k++) g.actors.perceive(a, 0.1); ok(a.state === 'idle', 'crouched at 60 m: unseen'); P.crouched = false;\n  seen2(); g.world.setHour(0, true); for (let k = 0; k < 30; k++) g.actors.perceive(a, 0.1); ok(a.state === 'idle', 'at night: unseen at 60 m'); g.world.setHour(12, true);\n  seen2(); g.story.pass = 'harvest'; for (let k = 0; k < 30; k++) g.actors.perceive(a, 0.1); ok(a.state === 'idle', 'the contract is a pass'); g.story.pass = null;\n  // Soldier burn panic.\n  a.burning = 5; a.state = 'burning'; const hp0 = a.hp; for (let k = 0; k < 60 && a.alive; k++) e.step(6); ok(!a.alive || a.hp < hp0, 'a burning soldier panics and dies'); W.fire.extinguish(); if (a.alive) g.actors.remove(a); }\n// Truce: slung guns.\n{ b.to(0, 20); e.step(5); ok(g.gunSlung(), 'gun slung at Mile Forty'); const gun = g.combat.current(), m = gun.mag; b.hold('MouseLeft', 0.3); ok(gun.mag === m, \"it won't fire\"); b.to(-180, 200); }\n// Vehicles.\n{ const v = g.vehicles.spawn('pickup', P.x + 6, P.z, 0, 'test'); e.step(40); const [dx, dz] = v.door(); b.to(dx, dz); b.look(v.x, v.y + 1, v.z); e.step(12); ok(S().prompts.some((x) => /GET IN/.test(x)) || g.prompt.current?.label === 'GET IN', 'door prompt'); b.key('KeyE'); ok(P.vehicle === v, 'get in'); const p0 = [v.x, v.z]; b.hold('KeyW', 3); ok(Math.hypot(v.x - p0[0], v.z - p0[1]) > 15, 'drives'); ok(Math.abs(v.v.speed) > 6, 'speed');\n  b.key('KeyM'); e.step(5); ok(P.mapUp, 'map up while driving'); b.hold('KeyW', 1); ok(Math.abs(v.v.speed) > 3, 'the world goes on'); input