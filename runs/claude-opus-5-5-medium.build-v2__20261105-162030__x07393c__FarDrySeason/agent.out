 for (let k = 0; k < 20; k++) { e.step(1); low = Math.min(low, v.object.scale.y); } ok(21, 'a knock squashes the body', low < 0.97, low.toFixed(3)); e.step(120); ok(21, 'and it springs back', Math.abs(v.object.scale.y - 1) < 0.01, v.object.scale.y.toFixed(3));\n    g.vehicles.exit(true); const bits = v.whipBits[0]; g.vehicles.remove(v); ok(21, 'removing a truck removes its whip', bits.parent === null); }\n  ok(0, 'no errors in all of the above',\"\"\")\nsub('tests/suites/lines.mjs',\"import { SCRIPTS } from\",\"import { clipNames } from '../../src/actors/rig.js';\\nimport { SCRIPTS } from\")\nEOF\ntimeout 590 node tests/suites/lines.mjs 2>&1 | cut -c1-280 | tail -12","description":"Add imports and check the new animation features","timeout":598000}}}
