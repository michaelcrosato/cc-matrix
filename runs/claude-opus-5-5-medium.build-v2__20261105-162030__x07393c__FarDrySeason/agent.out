ef sub(p,a,b):\n    s=open(p).read(); assert a in s,(p,a[:60]); s=s.replace(a,b,1); open(p,'w').write(s)\nsub('src/missions/scripts.js',\"      const usesBridge = g.story.altTaken?.m4;\\n\",\"      for (const v of [...g.vehicles.list]) if (v.tag === 'payroll' || v.tag === 'escort') g.vehicles.remove(v); // Taking Dov's plan reroutes the convoy.\\n      st.off?.();\\n      const usesBridge = g.story.altTaken?.m4;\\n\")\nsub('src/missions/runner.js',\"    g.events.emit('altAccepted', m);\\n    this.beginStep();\",\"    g.events.emit('altAccepted', m);\\n    if (a.steps.length) this.beginStep();\")\nEOF\necho \"- Taking Dov's plan in M4 left a second convoy driving; found by testing every alternate plan (systems). CRITICAL for that path.\" >> tests/ISSUES.md\ntimeout 500 node tests/suites/systems.mjs 2>&1 | cut -c1-300 | grep -E '^FAIL|Error|passed' | head -8; node tools/finish.mjs | cut -c1-40; node tools/build.mjs | cut -c1-40","description":"Fix duplicate convoy, retest, rebuild","timeout":560000}}}
