e {\n    try { await Engine.start(createGame({ session }), { ...OPTIONS(), seed: info.seed }); } catch (e) { hub.fail(String(e?.message ?? e)); }\n  }\n} else {\n  await Engine.start(createGame(), OPTIONS());\n}\nEOF\ncat > src/net/session.js <<'EOF'\n// One interface, three implementations, so round code never knows which: hub, solo, and two windows on one computer.\nconst COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nexport function hubSession(info) {\n  const H = window.AIHub, handlers = new Map();\n  const on = (ev, fn) => H.on(ev, fn);\n  return {\n    kind: 'hub', me: info.me, players: info.players, host: info.host, isHost: info.isHost, server: !!info.server, seed: info.seed,\n    time: () => H.time(), rng: (label) => H.rng(label), send: (data, o) => H.send(data, o), on, ready: () => H.ready(), answer: (w) => H.answer(w), finish: (o) => H.finish(o), fail: (m) => H.fail(m), handlers,\n  };\n}\n/** A tiny seeded generator for sessions outside the hub. */\nconst rngOf = (seed, label) => { let h = seed >>> 0; for (const c of String(label)) h = (Math.imul(h ^ c.charCodeAt(0), 16777619)) >>> 0; return () => { h = (h + 0x6d2b79f5) >>> 0; let t = h; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; };\nfunction Emitter() { const m = new Map(); return { on(ev, fn) { (m.get(ev) ?? m.set(ev, []).get(ev)).push(fn); return () => { const l = m.get(ev); l.splice(l.indexOf(fn), 1); }; }, emit(ev, ...a) { for (const f of [...(m.get(ev) ?? [])]) f(...a); } }; }\n/** On your own: you host, the other seats are AI mercs. */\nexport function soloSession(game, { seed = 7, seats = 4 } = {}) {\n  const e = Emitter(); let t0 = null, clock = 0;\n  const players = Array.from({ length: seats }, (_, i) => ({ id: i, name: i === 0 ? 'YOU' : ['INES', 'DOV', 'MAGS'][i - 1], color: COLORS[i], ai: i > 0 }));\n  return { kind: 'solo', me: 0, players, host: 0, isHost: true, server: false, seed, time: () => (t0 === null ? -Infinity : clock - t0), rng: (l) => rngOf(seed, l), send: () => true, on: e.on, ready() { t0 = 3000; clock = 0; e.emit('start', { in: 3000 }); }, answer() {}, finish(o) { e.emit('end', { reason: 'finished', standings: o.standings }); }, fail() {}, tick(ms) { clock += ms; }, emit: e.emit };\n}\n/** On your own with a friend on one computer: BroadcastChannel between two windows. */\nexport function linkSession({ host: isHost, name }) {\n  const e = Emitter(), ch = new BroadcastChannel('game-link-v1'), me = isHost ? 0 : 1;\n  const s = { kind: 'link', me, players: [{ id: 0, name: 'HOST', color: COLORS[0] }, { id: 1, name: 'GUEST', color: COLORS[1] }], host: 0, isHost, server: false, seed: 11, base: null, joined: false, started: false,\n    time: () => (s.base === null ? -Infinity : Date.now() - s.base), rng: (l) => rngOf(s.seed, l),\n    send(data, o = {}) { ch.postMessage({ t: 'd', from: me, to: o.to ?? null, data }); return true; }, on: e.on, ready() {}, answer() {}, fail() {},\n    finish(o) { ch.postMessage({ t: 'end', standings: o.standings, scores: o.scores }); e.emit('end', { reason: 'finished', standings: o.standings, scores: o.scores }); },\n    start() { if (!isHost || s.started) return; s.started = true; s.base = Date.now() + 3000; ch.postMessage({ t: 'start', base: s.base, seed: s.seed }); e.emit('start', { in: 3000 }); },\n    close() { ch.postMessage({ t: 'bye', from: me }); ch.close(); }, emit: e.emit };\n  ch.onmessage = (ev) => {\n    const m = ev.data;\n    if (m.t === 'hello' && isHost) { s.joined = true; ch.postMessage({ t: 'welcome' }); e.emit('joined'); }\n    if (m.t === 'welcome' && !isHost) { s.joined = true; e.emit('joined'); }\n    if (m.t === 'start') { s.base = m.base; s.seed = m.seed; s.started = true; e.emit('start', { in: m.base - Date.now() }); }\n    if (m.t === 'd' && m.from !== me && (m.to === null || m.to === me)) e.emit('message', m.data, m.from);\n    if (m.t === 'bye') e.emit('leave', { id: m.from, reason: 'left' })