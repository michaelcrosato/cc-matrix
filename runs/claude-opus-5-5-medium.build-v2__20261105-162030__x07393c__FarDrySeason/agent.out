R: { r: [76, 0, 0], p: [0.12, -0.36, 0.2] }, ArmL: { r: [60, 0, 0], p: [-0.12, -0.3, 0.2] } }], [40, off, 'in']]),\n  seq('Detonate', 22, [[0, { ArmR: { r: [10, 0, 0], p: [0.1, -0.1, 0] }, ArmL: off.ArmL }], [8, { ArmR: { r: [-16, 0, 0], p: [0.12, 0.1, 0] }, ArmL: off.ArmL }, 'out'], [12, { ArmR: { r: [-16, 0, 0], p: [0.12, 0.08, 0] }, HandR: { r: [-16, 0, 0] }, ArmL: off.ArmL }], [22, off, 'in']]),\n  // One shot. Your sidearm's animation, slower than you'd like.\n  seq('Finish', 70, [[0, off], [24, { ArmR: { r: [14, 0, 0], p: [0.12, 0.04, 0.0] }, HandR: { r: [24, 0, 0] }, ArmL: off.ArmL }, 'inOut'], [46, { ArmR: { r: [20, 0, 0], p: [0.12, 0.02, 0.04] }, HandR: { r: [34, 0, 0] }, ArmL: off.ArmL }], [50, { ArmR: { r: [10, 0, 0], p: [0.12, 0.08, 0.0] }, HandR: { r: [10, 0, 0] }, ArmL: off.ArmL }, 'out'], [70, off, 'in']]),\n];\n// Gazelle and vulture, on their own rigs.\nexport const GAZELLE_RIG = { joints: ['Body', 'Neck', 'LegFR', 'LegFL', 'LegBR', 'LegBL'], root: 'Body', mirror: {}, soles: [], trace: [], limits: {}, fps: 30 };\nexport const GAZELLE_CLIPS = [\n  { name: 'Graze', frames: 80, loop: true, keys: [K(0, { Neck: [50, 0, 0] }), K(40, { Neck: [60, 8, 0] }, 'inOut'), K(70, { Neck: [20, -6, 0] }, 'inOut'), K(80, { Neck: [50, 0, 0] })] },\n  { name: 'Run', frames: 14, loop: true, fast: true, keys: [K(0, { Body: { r: [-8, 0, 0], p: [0, 0.1, 0] }, Neck: [-8, 0, 0], LegFR: [-60, 0, 0], LegFL: [-44, 0, 0], LegBR: [54, 0, 0], LegBL: [40, 0, 0] }), K(7, { Body: { r: [8, 0, 0], p: [0, 0, 0] }, Neck: [10, 0, 0], LegFR: [40, 0, 0], LegFL: [54, 0, 0], LegBR: [-50, 0, 0], LegBL: [-64, 0, 0] }), K(14, { Body: { r: [-8, 0, 0], p: [0, 0.1, 0] }, Neck: [-8, 0, 0], LegFR: [-60, 0, 0], LegFL: [-44, 0, 0], LegBR: [54, 0, 0], LegBL: [40, 0, 0] })] },\n];\nexport const VULTURE_RIG = { joints: ['WingL', 'WingR'], root: 'WingL', mirror: {}, soles: [], trace: [], limits: {}, fps: 30 };\nexport const VULTURE_CLIPS = [{ name: 'Flap', frames: 26, loop: true, keys: [K(0, { WingL: [0, 0, 16], WingR: [0, 0, -16] }), K(13, { WingL: [0, 0, -20], WingR: [0, 0, 20] }, 'inOut'), K(26, { WingL: [0, 0, 16], WingR: [0, 0, -16] })] }];\nEOF\nsed -i \"s/c: 'red' === 0 ? 'wood' : 'wood'/c: 'wood'/\" src/art/viewmodels.js\nmkdir -p tests/lib; cat > tests/lib/artcheck.mjs <<'EOF'\nimport { buildModel, compileClips, checkModel, HERO_RIG, THREE, validateClip } from '../../pixel-engine.js';\nimport { CATALOG, soldierBeret } from '../../src/art/models.js';\nimport { VIEWMODELS, GUN_VIEWMODELS, GUN_RIG, TOOL_RIG, vmTools, handsMap } from '../../src/art/viewmodels.js';\nimport { GUN_CLIPS, TOOL_CLIPS, PEOPLE_CLIPS } from '../../src/art/clips.js';\nlet bad = 0;\nfor (const d of [...VIEWMODELS, handsMap]) { const r = checkModel(d, { catalog: CATALOG }); if (r.problems.length) { bad++; console.log(d.id, r.problems.map(String).join(' | ').slice(0, 300)); } }\nconst warn = console.warn; let warned = new Set(); console.warn = (...a) => warned.add(String(a[0]).slice(0, 120));\nfor (const [id, def] of Object.entries(GUN_VIEWMODELS)) { const b = buildModel(def, { catalog: CATALOG }); const clips = compileClips(GUN_CLIPS[id], GUN_RIG, b.object); if (!clips.length) console.log('noclip', id); }\nconst t = buildModel(vmTools, { catalog: CATALOG }); console.log('tool clips', compileClips(TOOL_CLIPS, TOOL_RIG, t.object).length);\nconst s = buildModel(soldierBeret, { catalog: CATALOG }); console.log('people clips', compileClips(PEOPLE_CLIPS, { ...HERO_RIG, spine: undefined }, s.object).map((c) => c.name).length);\nfor (const c of PEOPLE_CLIPS) { try { const r = validateClip(c, HERO_RIG); const e = r.filter?.((x) => x.level === 'error') ?? []; if (e.length) console.log(c.name, JSON.stringify(e).slice(0, 200)); } catch (e) { console.log(c.name, String(e).slice(0, 200)); } }\nconsole.log('warned', [...warned].slice(0, 8)); console.log('bad', bad);\nEOF\ntimeout 110 node tests/lib/artcheck.mjs 2>&1 | cut -c1-320 | head -30","description":"Write viewmodels and animation clips and check them"}}}
