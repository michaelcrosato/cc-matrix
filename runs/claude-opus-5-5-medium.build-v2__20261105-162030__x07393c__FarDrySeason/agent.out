game.cam.override = c; }\n  finish() {\n    const o = this.o; this.tl = null; this.o = null;\n    if (o.shots) this.game.cam.override = null;\n    o.onEnd?.(this.aborted);\n  }\n  /** Called once per fixed step. */\n  update(dt) {\n    if (!this.tl) return;\n    this.t += dt;\n    if (this.skippable && this.t > 0.15 && this.game.skipPressed()) { this.tl.skip(); return; }\n    this.tl.update(dt);\n    if (!this.tl) return;\n    this.o.tick?.(dt, this.tl.time);\n    this.applyCamera();\n  }\n  line() { return this.tl ? this.tl.line() : null; }\n  bars() { return this.tl ? this.tl.bars() : 0; }\n  /** Ended from outside, by a restart or a jump to another mission. */\n  clear() { if (!this.tl) return; this.aborted = true; this.tl.skip(); this.aborted = false; }\n}\nEOF\npython3 - <<'EOF'\nimport re\ndef sub(p,a,b,n=1):\n    s=open(p).read(); assert a in s, a; s=s.replace(a,b,n); open(p,'w').write(s)\n# game wiring\nsub('src/game.js',\"import { aboutScreen,\",\"import { ScenePlayer } from './ui/scenes.js';\\nimport { aboutScreen,\")\ns=open('src/game.js').read(); m=re.search(r\"this\\.world = new World\\(this\\);\",s); assert m\ns=s[:m.start()]+\"this.scenes = new ScenePlayer(this); \"+s[m.start():]; open('src/game.js','w').write(s)\nsub('src/game.js',\"    this.events.emit('fixed', dt);\\n\",\"    this.events.emit('fixed', dt);\\n    this.scenes.update(dt);\\n\")\nsub('src/game.js',\"    if (this.talk.scene) return;\",\"    if (this.talk.scene || this.scenes.locks) return;\")\nsub('src/game.js',\"const looking = !this.ui.top && !this.talk.scene &&\",\"const looking = !this.ui.top && !this.talk.scene && !this.scenes.locks &&\")\nsub('src/game.js',\"if (!this.talk.scene && (!this.ui.top ||\",\"if (!this.talk.scene && !this.scenes.locks && (!this.ui.top ||\")\nsub('src/game.js',\"else if (this.talk.scene) { this.hud.drawScene(); this.hud.effects(realDt); }\",\"else if (this.talk.scene) { this.hud.drawScene(); this.hud.effects(realDt); }\\n      else if (this.scenes.locks &