{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkguSJkoxTTdfMhjghXV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016y8jbecZiJBLsEWfXVdReD","name":"Bash","input":{"command":"cat > src/content/about.js <<'EOF'\n// About and Credits. The brief marks this as critical; the same text goes in the exit interview and the final reply.\nexport const ABOUT = {\n  source: [\n    ['DATE', '2026-11-05 16:20:30'],\n    ['SOURCE', 'Far Cry 2'],\n    ['PLAN', 'PLAN.md'],\n    ['GENRE', 'Open-world first-person shooter with survival pressure and systemic fire'],\n    ['PERSPECTIVE', 'First person on foot, at the wheel and in scenes; optional chase camera in vehicles'],\n    ['TECH', 'Pixel Engine 0.46.0 (riftlight kit), three.js r186, Rapier 0.20, WebGPU, JavaScript modules bundled with esbuild 0.28 into one HTML file; AI Hub session client 1.4.0'],\n    ['ART DIRECTION', \"The engine's native 3D-as-pixel-art at 480x270, toon materials, 16-colour palette; about 90 new models as data, plus library props\"],\n    ['ANIMATION', \"The engine's ClipDef system, compileClips and AnimationMixer; hero clips reused, new people clips, a hands rig with surgery scenes; Ragdoll on death; procedural sway\"],\n    ['AUDIO', 'All in code: SoundDef effects, Song music (7 pieces, music 10% by default), Animalese-style gibberish voices, spatial ambience. No audio files'],\n    ['ONLINE', 'AI Hub Session Protocol v1, shared-world, 1 to 4 players; on its own: solo with AI mercs and two windows on one computer'],\n    ['TESTING', 'Headless Node suites, scripted playthrough, Playwright Chromium on file://, pad stub, phone profile, the hub harness; one command; few screenshots'],\n    ['RESEARCH', \"None beyond the plan, the engine kit's docs and the hub's README\"],\n    ['ENVIRONMENT', 'Claude Code CLI (headless); Linux'],\n    ['MODEL', 'Anthropic, claude-opus-5-5, reasoning effort medium'],\n    ['USAGE', 'added on import'],\n  ],\n  testing: [\n    ['HOW MANY ISSUES DID TESTING CATCH?', 'See FEEDBACK_TESTING_1'],\n    ['HOW MANY WOULD BE CRITICAL OR GAME BREAKING?', 'See FEEDBACK_TESTING_2'],\n    ['WHAT WAS THE MOST HELPFUL TEST?', 'See FEEDBACK_TESTING_3'],\n    ['WHAT WAS THE LEAST HELPFUL TEST?', 'See FEEDBACK_TESTING_4'],\n  ],\n  engine: [\n    ['WHAT DID YOU LIKE MOST ABOUT THE ENGINE?', ''], ['DID YOU GET STUCK OR GUESS WRONG?', ''], ['MOST IMPORTANT THING YOU BUILT YOURSELF?', ''], ['HARDEST PART OF USING THE ENGINE?', ''], ['WHAT DID YOU CHANGE IN THE ENGINE, AND WHY?', ''], ['ONE THING YOU WOULD CHANGE?', ''],\n  ],\n  prompt: [\n    ['WHAT DID YOU LIKE MOST ABOUT THIS PROMPT?', ''], ['WHAT WAS CONFUSING?', ''], ['WHAT WAS THE HARDEST THING TO DO?', ''], ['WHAT WOULD YOU CHANGE IN THIS PROMPT?', ''],\n  ],\n  credits: ['PIXEL ENGINE (MIT)', 'THREE.JS (MIT)', 'RAPIER (APACHE-2.0)', 'THE AI HUB SESSION CLIENT', '', 'INSPIRED BY FAR CRY 2; NOT AFFILIATED.', '', 'WRITTEN AND BUILT BY CLAUDE (ANTHROPIC).'],\n};\nEOF\ncat > src/ui/screens.js <<'EOF'\n// Every screen: title, main, pause, settings, about, ledger, game over, endings, bed, locker, rack, board.\nimport { ABOUT } from '../content/about.js';\nimport { EPIGRAPHS, ENDINGS, NOTES } from '../content/dialogue.js';\nimport { GAME_TITLE } from '../content/title.js';\nimport { SHOP_ORDER, THROWABLES, UPGRADES, WEAPONS } from '../content/weapons.js';\nimport { clamp } from '../world/geom.js';\nimport { wrap } from './pixfont.js';\nimport { devScreen } from '../dev/devmode.js';\nexport function pressScreen(g) {\n  return { id: 'press', cover: false, dim: false, footer: false, back: null, items: [], update() { if (g.anyMenuPress()) { g.ui.replace(mainScreen(g)); g.audio.play('ui-confirm'); } },\n    draw() { const h = g.ctx.hud; g.drawTitle(); const y = h.height - 58, gl = g.hud.glyph('confirm'); h.text(0, y, 'PRESS', { anchor: 'top', color: 'white' }); g.hud.promptAt((h.width >> 1) - 16, y + 12, 'confirm', 'START'); void gl; } };\n}\nexport function mainScreen(g) {\n  const items = () => [\n    ...(g.save.exists() ? [{ label: 'CONTINUE', action: () => g.continueGame() }] : []),\n    { label: 'NEW GAME', action: () => g.newGame() },\n    { label: 'CASH RUN', action: () => g.ui.push(cashRunScreen(g)) },\n    { label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) },\n    { label: 'ABOUT AND CREDITS', action: () => g.ui.push(aboutScreen(g)) },\n  ];\n  return { id: 'main', top: 112, dim: false, items, back: () => g.ui.replace(pressScreen(g)), draw() { g.drawTitle(true); } };\n}\nexport function touchGateScreen(g) {\n  return { id: 'touch-gate', top: 150, dim: false, back: null, footer: false, items: [{ label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) }], draw() { g.drawTitle(true); const h = g.ctx.hud; h.text(0, 118, 'CONTROLLER OR KEYBOARD REQUIRED', { anchor: 'top', color: 'white' }); } };\n}\nexport function pauseScreen(g) {\n  const hub = !!g.session;\n  const items = hub ? [{ label: 'RESUME', action: () => g.resume() }, { label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) }] : [\n    { label: 'RESUME', action: () => g.resume() },\n    { label: 'LEDGER', action: () => g.ui.push(ledgerScreen(g)) },\n    { label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) },\n    { label: 'DEV MODE', action: () => g.ui.push(devScreen(g)) },\n    { label: 'ABOUT AND CREDITS', action: () => g.ui.push(aboutScreen(g)) },\n    { label: 'QUIT TO TITLE', action: () => g.toTitle() },\n  ];\n  return { id: 'pause', title: 'PAUSED', cover: 'ink', top: 70, items, back: () => g.resume() };\n}\nconst pct = (v) => `${Math.round(v * 100)}%`;\nfunction slider(label, get, set, step = 0.05) { return { label, value: () => get(), valueText: () => pct(get()), adjust: (d) => set(clamp(get() + d * step, 0, 1)), set }; }\nconst toggle = (label, get, set, on = 'ON', off = 'OFF') => ({ label, value: () => (get() ? on : off), adjust: () => set(!get()), action: () => set(!get()) });\nexport function settingsScreen(g) {\n  const s = g.settings, a = g.ctx.audio;\n  const put = () => g.saveSettings();\n  return { id: 'settings', title: 'SETTINGS', cover: 'ink', items: [\n    { label: 'SOUND', action: () => g.ui.push({ id: 'settings-sound', title: 'SOUND', cover: 'ink', items: [slider('MUSIC', () => a.volume.music, (v) => { a.setVolume('music', v); put(); }), slider('EFFECTS', () => a.volume.sfx, (v) => { a.setVolume('sfx', v); put(); }), slider('VOICES', () => s.voices, (v) => { s.voices = v; put(); })] }) },\n    { label: 'CONTROLS', action: () => g.ui.push({ id: 'settings-controls', title: 'CONTROLS', cover: 'ink', items: [slider('LOOK: PAD', () => s.padSens / 2, (v) => { s.padSens = v * 2; put(); }), slider('LOOK: MOUSE', () => s.mouseSens / 2, (v) => { s.mouseSens = v * 2; put(); }), toggle('INVERT Y', () => s.invertY, (v) => { s.invertY = v; put(); }), toggle('AIM ASSIST', () => s.aimAssist, (v) => { s.aimAssist = v; put(); }), toggle('RUMBLE', () => s.rumble, (v) => { s.rumble = v; put(); }), toggle('GLYPHS', () => s.glyphs === 'xbox', (v) => { s.glyphs = v ? 'xbox' : 'playstation'; put(); }, 'XBOX', 'PLAYSTATION')] }) },\n    { label: 'PICTURE', action: () => g.ui.push({ id: 'settings-picture', title: 'PICTURE', cover: 'ink', items: [toggle('FULLSCREEN', () => g.isFullscreen(), (v) => g.setFullscreen(v)), toggle('PIXEL SIZE', () => s.pixel === 'chunky', (v) => { s.pixel = v ? 'chunky' : 'fine'; g.ctx.engine.settings.set({ pixelSize: s.pixel }); put(); }, 'CHUNKY', 'FINE'), { label: 'QUALITY', value: () => s.quality.toUpperCase(), adjust: (d) => { const q = ['low', 'medium', 'high'], i = (q.indexOf(s.quality) + Math.sign(d) + 3) % 3; s.quality = q[i]; g.ctx.engine.setQuality(q[i]); put(); }, action() { this.adjust(1); } }, { label: 'FIELD OF VIEW', value: () => (s.fov - 50) / 40, valueText: () => String(s.fov), adjust: (d) => { s.fov = clamp(s.fov + d * 2, 50, 90); put(); }, set: (v) => { s.fov = Math.round(50 + v * 40); put(); } }] }) },\n    { label: 'COMFORT', action: () => g.ui.push({ id: 'settings-comfort', title: 'COMFORT', cover: 'ink', items: [toggle('SUBTITLE SIZE', () => s.subtitle === 'large', (v) => { s.subtitle = v ? 'large' : 'normal'; put(); }, 'LARGE', 'NORMAL'), toggle('REDUCE FLASHES', () => s.reduceFlashes, (v) => { s.reduceFlashes = v; put(); }), toggle('FEVER EFFECTS', () => s.feverReduced, (v) => { s.feverReduced = v; put(); }, 'REDUCED', 'FULL')] }) },\n    { label: 'RESET TO DEFAULTS', action: () => { g.resetSettings(); g.notice('SETTINGS RESET'); } },\n  ] };\n}\nexport function pagesFromRows(rows, perPage = 15, cols = 72) {\n  const lines = [];\n  for (const [k, v] of rows) { lines.push({ big: k }); if (v) for (const l of wrap(v, cols)) lines.push(l); }\n  const pages = []; for (let i = 0; i < lines.length; i += perPage) pages.push(lines.slice(i, i + perPage));\n  return pages;\n}\nexport function aboutScreen(g) {\n  const pages = [\n    ...pagesFromRows(ABOUT.source), ...pagesFromRows(ABOUT.testing, 15), ...pagesFromRows(ABOUT.engine, 15), ...pagesFromRows(ABOUT.prompt, 15),\n    [...ABOUT.credits, '', `${GAME_TITLE.toUpperCase()}`],\n  ];\n  return { id: 'about', title: 'ABOUT AND CREDITS', titleY: 14, cover: 'ink', paged: true, pages, page: 0, pageY: 40 };\n}\nexport function ledgerScreen(g) {\n  return { id: 'ledger', cover: 'ink', footer: [['back', 'BACK']], items: [], draw() { const h = g.ctx.hud, l = g.ledgerNow(); h.text(0, 30, 'THE LEDGER', { anchor: 'top', scale: 2, color: 'sand' }); h.text(0, 50, 'IN HIS HAND, NOT YOURS', { anchor: 'top', color: 'mist' }); g.ledgerLines(l).forEach(([k, v], i) => { h.text(40, 76 + i * 26, k, { color: 'mist' }); h.text(h.width - 40 - v.length * 12, 72 + i * 26, v, { scale: 2, color: 'white' }); }); } };\n}\nexport function gameOverScreen(g, text) {\n  return { id: 'game-over', cover: 'ink', back: null, sub: text, title: 'THE PAPERWORK', titleColor: 'red', top: 120, items: [...(g.save.exists() ? [{ label: 'CONTINUE', action: () => g.continueGame() }] : []), { label: 'TITLE', action: () => g.toTitle() }] };\n}\nexport function endingScreen(g) {\n  const text = ENDINGS[g.story.ending ?? 'walk'];\n  return { id: 'ending', cover: 'ink', back: null, footer: [['confirm', 'THE LEDGER']], items: [{ label: '', small: true, action: () => g.ui.replace(finalLedger(g)) }], top: 200, draw() { const h = g.ctx.hud; wrap(text.toUpperCase(), 52).forEach((l, i) => h.text(0, 70 + i * 16, l, { anchor: 'top', color: 'white' })); } };\n}\nexport function finalLedger(g) { const s = ledgerScreen(g); s.id = 'final-ledger'; s.items = [{ label: '', small: true, action: () => g.ui.replace(creditsScreen(g)) }]; s.footer = [['confirm', 'CREDITS']]; s.back = null; s.top = 220; return s; }\nexport function creditsScreen(g) {\n  return { id: 'credits', cover: 'ink', back: null, top: 215, footer: false, items: [{ label: 'TO THE TITLE', action: () => g.afterCredits() }], draw() { const h = g.ctx.hud; h.text(0, 30, GAME_TITLE.toUpperCase(), { anchor: 'top', scale: 3, color: 'sand' }); h.text(0, 66, 'A MAP IS A PROMISE MADE BY SOMEONE WHO HAS ALREADY LEFT.', { anchor: 'top', color: 'mist' }); ABOUT.credits.forEach((c, i) => h.text(0, 90 + i * 12, c, { anchor: 'top', color: 'white' })); } };\n}\nexport function bedScreen(g) {\n  const sleep = (hour) => { g.sleepTo(hour); g.ui.pop(); };\n  return { id: 'bed', title: 'SLEEP UNTIL', dim: true, items: [{ label: 'DAWN', action: () => sleep(5.5) }, { label: 'NOON', action: () => sleep(12) }, { label: 'DUSK', action: () => sleep(18.5) }, { label: 'MIDNIGHT', action: () => sleep(0) }, { label: 'LEAVE', action: () => g.ui.pop() }] };\n}\nexport function lockerScreen(g) {\n  const p = g.player;\n  const row = (slot, label) => {\n    const opts = () => g.lockerOptions(slot);\n    return { label, value: () => { const cur = p.guns[slot]; return cur ? WEAPONS[cur.id].name.replaceAll('\"', '').split(' ').pop() : 'NOTHING'; }, adjust: (d) => { const list = opts(); if (!list.length) return; const cur = p.guns[slot]?.id ?? null, i = list.indexOf(cur), next = list[(i + Math.sign(d) + list.length) % list.length]; if (next && next !== cur) g.combat.give(next, 100, false); g.audio.play('magazine'); } };\n  };\n  return { id: 'locker', title: 'LOCKER', dim: true, items: [row('sidearm', 'SIDEARM'), row('main', 'MAIN'), row('special', 'SPECIAL'), { label: 'LEAVE', action: () => g.ui.pop() }], footer: [['left', 'CHANGE'], ['back', 'BACK']], draw() { const n = Object.keys(g.story.trigs ?? {}).length; if (n >= 6) g.ctx.hud.text(0, 200, 'A CLEAN OLD EMPIRE LEANS IN THE LOCKER. A NOTE SAYS WHY.', { anchor: 'top', color: 'sand' }); } };\n}\nexport function rackScreen(g) {\n  const stock = [...SHOP_ORDER.map((id) => ({ kind: 'gun', id })), { kind: 'throw', id: 'molotov' }, { kind: 'throw', id: 'charge' }, ...UPGRADES.map((u) => ({ kind: 'up', id: u.id }))];\n  const s = { id: 'rack', dim: false, i: 0, back: undefined, footer: false, focus: 0, items: [], onShow() { g.showRackGun(stock[s.i]); }, onClose() { g.showRackGun(null); },\n    update() {\n      const input = g.ctx.input, { pressed } = g;\n      if (pressed('left')) { s.i = (s.i + stock.length - 1) % stock.length; g.audio.play('ui-move'); g.showRackGun(stock[s.i]); }\n      if (pressed('right')) { s.i = (s.i + 1) % stock.length; g.audio.play('ui-move'); g.showRackGun(stock[s.i]); }\n      if (input.wheel) { s.i = (s.i + Math.sign(input.wheel) + stock.length) % stock.length; g.showRackGun(stock[s.i]); }\n      const clicked = g.ui.clickedAnywhere();\n      if (pressed('confirm') || clicked) g.buy(stock[s.i]);\n    },\n    draw() {\n      const h = g.ctx.hud, it = stock[s.i]; const W = h.width;\n      h.rect(0, 180, W, 90, 'ink');\n      if (it.kind === 'gun') {\n        const w = WEAPONS[it.id], own = g.player.unlocked[it.id];\n        h.text(0, 190, w.name, { anchor: 'top', scale: 2, color: 'sand' });\n        const dmg = (w.damage * (w.pellets ?? 1)) / 100, rng = Math.min(1, w.range / 320), rel = w.reliability / 10;\n        [['DAMAGE', dmg], ['RANGE', rng], ['RELIABILITY', rel]].forEach(([k, v], i) => { const y = 208 + i * 10; h.text(120, y, k, { color: 'mist' }); h.rect(200, y, 120, 6, 'night'); h.rect(200, y, Math.round(120 * clamp(v, 0, 1)), 6, 'orange'); });\n        h.text(344, 208, own ? 'TAKEN' : `${w.price} STONES`, { color: own ? 'lime' : 'white' });\n      } else if (it.kind === 'throw') {\n        const t = THROWABLES[it.id]; h.text(0, 190, t.name, { anchor: 'top', scale: 2, color: 'sand' }); h.text(0, 212, `${t.price} STONE EACH, CARRY ${t.carry}`, { anchor: 'top' });\n      } else { const u = UPGRADES.find((x) => x.id === it.id); h.text(0, 190, u.name, { anchor: 'top', scale: 2, color: 'sand' }); h.text(0, 212, u.about, { anchor: 'top' }); h.text(0, 224, g.player.upgrades[it.id] ? 'TAKEN' : `${u.price} STONES`, { anchor: 'top', color: g.player.upgrades[it.id] ? 'lime' : 'white' }); }\n      h.text(24, 14, `STONES ${g.player.stones}`, { color: 'sand' });\n      g.hud.footer([['left', 'LOOK'], ['confirm', 'BUY OR TAKE'], ['back', 'LEAVE']]);\n    } };\n  return s;\n}\nexport function boardScreen(g) {\n  const items = () => { const a = g.missions.available().map((m) => ({ label: m.title, small: true, action: () => { g.ui.pop(); g.offerMission(m); } })); if (!a.length) a.push({ label: 'NOTHING TODAY', small: true, action: () => g.ui.pop() }); return a; };\n  return { id: 'board', title: 'THE NOTICE BOARD', dim: true, items };\n}\nexport function loadingEpigraph(g) { return EPIGRAPHS[g.ctx.random.fork('epigraph').int(0, EPIGRAPHS.length - 1)]; }\nexport function cashRunScreen(g) {\n  return { id: 'cash-run', title: 'CASH RUN', cover: 'ink', top: 84, sub: 'SIX MINUTES. CARRY THE MOST CASES TO THE TRUCK. FRIENDS ONLINE PLAY THROUGH AI HUB.', items: [\n    { label: 'SOLO WITH HIRED GUNS', action: () => g.startCashRun('solo') },\n    { label: 'HOST ON THIS COMPUTER', action: () => g.startCashRun('host') },\n    { label: 'JOIN ON THIS COMPUTER', action: () => g.startCashRun('join') },\n  ] };\n}\nexport function resultsScreen(g, rows) {\n  return { id: 'results', cover: 'ink', title: 'THE COUNT', top: 210, back: null, footer: false, items: [{ label: 'TO THE TITLE', action: () => g.toTitle() }], draw() { const h = g.ctx.hud; rows.forEach((r, i) => { h.text(60, 70 + i * 22, `${i + 1}. ${r.name}`, { scale: 2, color: r.color ?? 'white' }); h.text(h.width - 60 - String(r.score).length * 12, 70 + i * 22, String(r.score), { scale: 2, color: 'sand' }); }); } };\n}\nexport const NOTE_PAGES = NOTES;\nEOF\ncat > src/dev/devmode.js <<'EOF'\n// Dev mode: from the pause menu. Tabs, world visible behind, playing or frozen by a toggle.\nimport { SLIDERS } from '../content/tuning-defaults.js';\nimport { CASES, POSTS, siteById, SITES } from '../content/sites.js';\nimport { MISSIONS } from '../content/missions.js';\nimport { SHOP_ORDER } from '../content/weapons.js';\nimport { resetTuning, TUNING } from '../core/tuning.js';\nimport { clamp } from '../world/geom.js';\nconst toggle = (label, get, set) => ({ label, small: true, value: () => (get() ? 'ON' : 'OFF'), adjust: () => set(!get()), action: () => set(!get()) });\nconst act = (label, action) => ({ label, small: true, action });\nexport function devTabs(g) {\n  const c = g.cheats, dev = g.dev, w = g.world, p = g.player;\n  const sitesList = [...SITES.map((s) => act(s.name, () => dev.teleport(s.at[0] + 6, s.at[1] + 6))), ...CASES.map((k) => act(`CASE ${k.id.toUpperCase()}`, () => dev.teleport(k.at[0] + 1.5, k.at[1] + 1.5))), act('THE CROSSHAIR POINT', () => dev.teleportCrosshair())];\n  return {\n    CHEATS: [toggle('GOD MODE', () => c.god, (v) => { c.god = v; }), toggle('INFINITE AMMO', () => c.infiniteAmmo, (v) => { c.infiniteAmmo = v; }), toggle('NO JAMS', () => c.noJams, (v) => { c.noJams = v; }), toggle('NO FEVER', () => c.noFever, (v) => { c.noFever = v; }), toggle('INVISIBLE TO AI', () => c.invisible, (v) => { c.invisible = v; }), toggle('NOCLIP FLY', () => c.noclip, (v) => { c.noclip = v; }), toggle('WORLD PLAYS BEHIND', () => dev.playing, (v) => { dev.playing = v; g.ctx.engine.timeScale = v ? 1 : 0; })],\n    TELEPORT: sitesList,\n    SPAWN: [act('SQUAD: CONCORD', () => dev.squad('concord')), act('SQUAD: HARVEST', () => dev.squad('harvest')), act('PICKUP', () => dev.vehicle('pickup')), act('TECHNICAL', () => dev.vehicle('technical')), act('TRUCK', () => dev.vehicle('cargo-truck')), act('STONE CASE', () => g.spawnStonePickup(p.x + 3, p.z, 'dev-case', 5)), act('A BUDDY', () => dev.buddy())],\n    WORLD: [\n      { label: 'HOUR', small: true, value: () => w.hour / 24, valueText: () => w.hour.toFixed(1), adjust: (d) => w.setHour((w.hour + d * 0.5 + 24) % 24), set: (v) => w.setHour(v * 23.9) },\n      { label: 'WIND DIRECTION', small: true, value: () => (Math.atan2(w.wind.z, w.wind.x) + Math.PI) / 6.283, valueText: () => `${Math.round((Math.atan2(w.wind.z, w.wind.x) * 180) / Math.PI)}`, adjust: (d) => { const a = Math.atan2(w.wind.z, w.wind.x) + d * 0.2; w.wind.x = Math.cos(a); w.wind.z = Math.sin(a); }, set: (v) => { const a = v * 6.283 - Math.PI; w.wind.x = Math.cos(a); w.wind.z = Math.sin(a); } },\n      { label: 'WIND SPEED', small: true, value: () => w.wind.speed / 8, valueText: () => w.wind.speed.toFixed(1), adjust: (d) => { w.wind.speed = clamp(w.wind.speed + d * 0.5, 0, 8); }, set: (v) => { w.wind.speed = v * 8; } },\n      { label: 'WEATHER', small: true, value: () => w.weather.toUpperCase(), adjust: (d) => { const l = ['clear', 'dust', 'storm'], i = (l.indexOf(w.weather) + Math.sign(d) + 3) % 3; w.setWeather(l[i]); }, action() { this.adjust(1); } },\n      act('IGNITE AT THE CROSSHAIR', () => dev.igniteCrosshair()), act('EXTINGUISH ALL', () => w.fire.extinguish()), act('REGROW ALL', () => { w.fire.regrowAll(); w.land.paintAll(); w.burnDirty = true; }), act('SLEEP 6 HOURS', () => w.advanceHours(6)),\n    ],\n    MISSION: [\n      ...MISSIONS.map((m) => act(`START ${m.id.toUpperCase()}: ${m.title}`, () => dev.startMission(m.id))),\n      act('COMPLETE CURRENT STEP', () => dev.completeStep()), act('SET STORY FLAGS: ALL FRIENDS MET', () => { for (const k of Object.keys(g.buddies.state)) g.buddies.state[k].met = true; g.people.showFriends(); }),\n      act('GIVE 50 STONES', () => { p.stones += 50; }), act('GIVE 3 TABLETS', () => { p.tablets += 3; }), act('GIVE 3 SYRETTES', () => { p.syrettes += 3; }), act('ALL GUNS', () => dev.allGuns()), act('BREAK GUN', () => dev.breakGun()), act('FORCE JAM', () => dev.forceJam()), act('FORCE FEVER', () => g.body.onset()), act('DOWN A BUDDY', () => dev.downBuddy()),\n    ],\n    BALANCE: [...SLIDERS.map((s) => ({ label: s.label, small: true, value: () => (TUNING[s.key] - s.min) / (s.max - s.min), valueText: () => String(Math.round(TUNING[s.key] * 100) / 100), adjust: (d) => { TUNING[s.key] = clamp(Math.round((TUNING[s.key] + d * s.step) * 1000) / 1000, s.min, s.max); }, set: (v) => { TUNING[s.key] = s.min + v * (s.max - s.min); }, resetOne: () => resetTuning(s.key) })), act('RESET ALL TO DEFAULTS', () => resetTuning())],\n    DEBUG: [toggle('FIRE-GRID OVERLAY', () => dev.fireOverlay, (v) => { dev.fireOverlay = v; }), toggle('NAV OVERLAY', () => dev.navOverlay, (v) => { dev.navOverlay = v; }), toggle('AI STATE OVER HEADS', () => dev.aiText, (v) => { dev.aiText = v; }), toggle('COUNTS', () => dev.counts, (v) => { dev.counts = v; }), toggle('CROSSHAIR COORDS', () => dev.coords, (v) => { dev.coords = v; }), toggle('ENGINE DEBUG PANEL', () => g.ctx.engine.debugShown, (v) => g.ctx.engine.showDebug(v)), toggle('FREE CAMERA', () => dev.freeCam, (v) => dev.setFreeCam(v)), act('QUICK SAVE', () => dev.quickSave()), act('QUICK LOAD', () => dev.quickLoad()), toggle('SHOW STATUS LINE', () => dev.statusLine, (v) => { dev.statusLine = v; })],\n  };\n}\nexport function devScreen(g) {\n  const tabs = devTabs(g), names = Object.keys(tabs);\n  return { id: 'dev', cover: false, dim: false, top: 30, tabs: names, tab: 0, items: (s) => tabs[names[s.tab]], footer: [['tabL', 'TAB'], ['resetOne', 'RESET ONE'], ['back', 'BACK']], onShow() { g.dev.open = true; }, onClose() { g.dev.open = false; g.ctx.engine.timeScale = 0; g.dev.playing = false; }, draw() { g.dev.drawOverlays(); } };\n}\nexport class Dev {\n  playing = false; open = false; fireOverlay = false; navOverlay = false; aiText = false; counts = false; coords = false; freeCam = false; statusLine = false;\n  constructor(game) { this.game = game; }\n  teleport(x, z) { const g = this.game; g.player.teleport(x, z); g.world.focusX = x; g.world.focusZ = z; g.world.updateBubble?.(); }\n  crosshair() { const g = this.game, e = g.combat.eye(), v = g.ctx.camera.camera.position.clone(), dir = v.clone().set(...e.dir); const hit = g.ctx.physics.castRay(v.set(e.x, e.y, e.z), dir, 800, undefined, g.player.ctrl?.body); return hit ? [hit.point.x, hit.point.y, hit.point.z] : [e.x + e.dir[0] * 30, e.y, e.z + e.dir[2] * 30]; }\n  teleportCrosshair() { const c = this.crosshair(); this.teleport(c[0], c[2]); }\n  igniteCrosshair() { const c = this.crosshair(); this.game.world.fire.ignite(c[0], c[2], 5); }\n  squad(f) { const p = this.game.player; this.game.spawnSquad(f, p.x + 26, p.z + 10, 4, 'dev'); }\n  vehicle(t) { const p = this.game.player; this.game.vehicles.spawn(t, p.x + 7, p.z, 0, 'dev'); }\n  buddy() { const g = this.game, id = g.buddies.alive()[0] ?? 'ines'; g.buddies.state[id].met = true; g.buddies.spawnFollower(id, g.player.x + 3, g.player.z + 3); }\n  allGuns() { const g = this.game; for (const id of SHOP_ORDER) { g.player.unlocked[id] = true; } g.combat.give('tractor', 100, false); g.combat.give('tube', 100, false); g.story.hasFlare = true; g.story.hasTracker = true; g.player.molotovs = 3; g.player.charges = 2; }\n  breakGun() { const g = this.game.combat.current(); if (g) { g.cond = 1; this.game.vm.setCondition(g.id, 1); } }\n  forceJam() { const c = this.game.combat, g = c.current(); if (g && g.id !== 'mg' && g.id !== 'cane') c.jam(g); }\n  downBuddy() { const g = this.game; let a = g.buddies.followers.find((f) => f.alive && !f.down); if (!a) { this.buddy(); a = g.buddies.followers.at(-1); } g.actors.goDown(a, {}); }\n  completeStep() { const m = this.game.missions; if (m.active) m.next(); }\n  startMission(id) { this.game.dev_startMission(id); }\n  quickSave() { const s = this.game.save; this.quick = JSON.stringify(s.serialize()); this.game.notice('QUICK SAVED'); }\n  quickLoad() { if (this.quick) this.game.ctx.input.send({ load: this.quick }); }\n  setFreeCam(v) { const e = this.game.ctx.engine; this.freeCam = v; e.setCamera(v ? { preset: 'free' } : { preset: 'first', fov: 62 }, { syncUrl: false }); }\n  drawOverlays() {\n    const g = this.game, h = g.ctx.hud;\n    if (this.fireOverlay) { const f = g.world.fire, S = 128; h.rect(h.width - S - 8, 28, S, S, 'ink'); for (const i of f.burning) { const x = i % 256, z = (i / 256) | 0; h.rect(h.width - S - 8 + (x >> 1), 28 + (z >> 1), 1, 1, 'orange'); } for (const i of f.burntList) { const x = i % 256, z = (i / 256) | 0; h.rect(h.width - S - 8 + (x >> 1), 28 + (z >> 1), 1, 1, 'slate'); } h.text(h.width - S - 8, 158, `${f.burning.length} BURNING ${f.burntCount} BURNT`, { color: 'orange' }); }\n    if (this.navOverlay && g.nav) { const n = g.nav, S = 120; h.rect(8, 28, S, S, 'ink'); for (let z = 0; z < S; z++) for (let x = 0; x < S; x++) if (!n.isOpen(Math.floor((x / S) * 640), Math.floor((z / S) * 640))) h.rect(8 + x, 28 + z, 1, 1, 'plum'); }\n    if (this.aiText) for (const a of g.actors.list) { const s = g.hud.world(a.x, a.y + 2.2, a.z); if (s) h.text(Math.round(s[0]) - 18, Math.round(s[1]) - 14, `${a.state} ${Math.round(a.hp)}`, { color: 'lime' }); }\n    if (this.counts) { const st = g.ctx.engine.state(); h.text(10, h.height - 46, `ACTORS ${g.actors.list.length} VEH ${g.vehicles.list.length} FIRE ${g.world.fire.burning.length} DRAWS ${st.renderer?.calls ?? st.draws ?? '?'}`, { color: 'lime' }); }\n    if (this.coords) { const c = this.crosshair(); h.text(10, h.height - 58, `CROSSHAIR ${c[0].toFixed(1)} ${c[1].toFixed(1)} ${c[2].toFixed(1)}`, { color: 'lime' }); }\n    if (this.statusLine) h.text(10, h.height - 70, g.status(), { color: 'lime' });\n  }\n}\nexport { POSTS, siteById };\nEOF\ncat > src/attract/director.js <<'EOF'\n// Attract mode. A director with a list of beats, the real game with cheats. Its only job is to show the demo.\nimport { siteById } from '../content/sites.js';\nconst site = (id) => siteById[id].at;\nexport const BEATS = [\n  { id: 'map-at-wheel', hour: 18.4, run(g, b) { const at = [40, -30]; g.player.teleport(at[0], at[1]); const v = g.vehicles.spawn('technical', 44, -26, 2.5, 'attract'); g.vehicles.enter(v); b.v = v; b.tick = (t) => { g.bot.drive = { throttle: 0.7, steer: Math.sin(t * 0.4) * 0.2 }; if (t > 3) g.player.mapUp = true; }; } },\n  { id: 'checkpoint-jam', hour: 16.2, run(g, b) { const a = site('p2'); g.player.teleport(a[0] + 30, a[1] + 8); g.player.lookAt(a[0], g.world.land.heightAt(a[0], a[1]) + 1.2, a[1]); g.combat.give('tractor', 34, true); const gun = g.player.guns.main; gun.scriptedJam = 12; b.tick = (t) => { g.bot.fire = !gun.jammed && t > 1; if (gun.jammed && Math.floor(t * 2) % 2 === 0) g.bot.press('KeyR'); }; } },\n  { id: 'flare-grass', hour: 17, run(g, b) { const a = site('p1'); g.world.pinWind({ dir: [1, 0.2], speed: 6 }); g.player.teleport(a[0] - 70, a[1] - 8); g.player.lookAt(a[0] - 30, g.world.land.heightAt(a[0] - 30, a[1]) + 6, a[1]); g.combat.give('flare', 100, true); b.tick = (t) => { if (t > 1 && !b.shot) { b.shot = true; g.bot.press('MouseLeft'); } }; } },\n  { id: 'night-field', hour: 23, camera: true, run(g, b) { const a = site('long-field'); g.world.setHour(23, true); g.world.pinWind({ dir: [0, -1], speed: 5 }); g.world.fire.ignite(a[0], a[1] + 30, 14); g.world.fire.ignite(a[0] + 60, a[1], 14); b.tick = (t) => { const y = g.world.land.heightAt(a[0], a[1]) + 9, k = t * 0.09; g.cam.override = { position: [a[0] - 100 + t * 9, y, a[1] + 66], target: [a[0] + Math.sin(k) * 30, y - 6, a[1]] }; }; } },\n  { id: 'fever', hour: 13, run(g, b) { const a = [-100, 60]; g.player.teleport(a[0], a[1]); g.player.setYaw(0.4, 0.05); g.player.tablets = 3; g.body.fever = 0; g.body.feverActive = true; g.body.feverIgnored = -1e9; g.story.feverOn = true; b.tick = (t) => { if (t > 5) g.bot.hold = 'KeyH'; }; b.end = () => { g.story.feverOn = false; g.body.feverActive = false; g.body.fever = 0; }; } },\n  { id: 'surgery', hour: 11, run(g, b) { g.player.teleport(-110, 90); g.player.hp = 15; g.player.setYaw(1.2, -0.25); b.tick = (t) => { if (t > 1 && !b.s) { b.s = true; g.body.startSurgery(); } }; b.end = () => { g.player.surgery = null; g.vm.endTool(); g.player.hp = 100; }; } },\n  { id: 'scope', hour: 12, run(g, b) { const a = site('p4'); g.player.teleport(a[0] + 110, a[1] + 60); g.player.lookAt(a[0], g.world.land.heightAt(a[0], a[1]) + 1.2, a[1]); g.combat.give('empire', 80, true); b.tick = (t) => { g.bot.aim = true; if (t > 3 && Math.floor(t) % 3 === 0 && !b.f?.[Math.floor(t)]) { (b.f ??= {})[Math.floor(t)] = 1; g.bot.press('MouseLeft'); } }; } },\n  { id: 'dragged', hour: 16, run(g, b) { const st = g.buddies.state.mags; st.met = true; st.alive = true; st.spentUntil = -1; g.player.teleport(-300, 150); g.player.setYaw(2, 0); g.buddies.rescue('mags'); b.tick = (t) => { if (t > 8 && !b.x) { b.x = true; const a = g.buddies.followers[0]; if (a) { g.player.teleport(a.x + 1.4, a.z + 1); g.player.lookAt(a.x, a.y + 0.6, a.z); g.actors.goDown(a, { fire: true }); } } }; b.end = () => { g.buddies.clear(); g.player.downT = 0; g.cam.override = null; g.frozen = false; g.player.hp = 100; g.prompt.setChoice(null); }; } },\n  { id: 'tracker', hour: 15, run(g, b) { const c = g.world.cases[0]; g.story.hasTracker = true; g.player.teleport(c.at[0] + 22, c.at[1] + 4); g.player.lookAt(c.at[0], g.world.land.heightAt(c.at[0], c.at[1]) + 0.5, c.at[1]); g.tracker.setUp(true); g.world.fire.burnStrip([[c.at[0] - 10, c.at[1]], [c.at[0] + 20, c.at[1]]], 20); b.tick = () => { g.bot.forward = 0.55; }; b.end = () => g.tracker.setUp(false); } },\n  { id: 'train-mg', hour: 15, run(g, b) { const t = g.train; t.setAt(-200, 104); t.topSpeed = 12; t.goal = t.sToward(200, 40); g.setRiding(t, true); g.player.setYaw(Math.PI / 2, -0.04); g.spawnSquad('harvest', -120, 130, 4, 'attract'); b.tick = (tt) => { g.bot.fire = tt > 2 && Math.sin(tt * 2) > -0.3; }; b.end = () => g.setRiding(null); } },\n  { id: 'tibor', hour: 10, run(g, b) { const n = g.people.npcs.tibor; g.player.teleport(n.x - 2, n.z - 5); g.talk.startScene({ speaker: 'tibor', lines: ['tibor.idle', 'm2.brief'], skippable: false }); b.end = () => { if (g.talk.scene) { g.talk.scene.onDone = null; g.talk.endScene(); } g.talk.clear(); }; } },\n  { id: 'table-map', hour: 22, camera: true, run(g, b) { const a = site('observatory'), y = g.world.land.heightAt(a[0], a[1]) + 0.8, at = [a[0], y, a[1] + 0.8]; g.world.burnStrip('A'); g.world.burnStrip('B'); g.world.burnStrip('C'); g.mapTex.arc = true; g.showTableMap(at); b.tick = (t) => { g.cam.override = { position: [at[0] + Math.sin(t * 0.2) * 0.4, y + 0.75, at[2] + 0.42], target: at }; }; b.end = () => { g.mapTex.arc = false; g.showTableMap(null); }; } },\n  { id: 'title', hour: 18.4, camera: true, run(g, b) { g.titleCamera(); g.titleBanner = true; b.end = () => { g.titleBanner = false; }; } },\n];\nexport class Attract {\n  active = false; i = 0; t = 0; dur = 12; transitioning = false; loops = 0; order = BEATS;\n  constructor(game) { this.game = game; }\n  start() {\n    const g = this.game;\n    this.active = true; this.i = -1; this.loops = 0; this.returnTo = g.ui.top?.id ?? 'press';\n    g.ui.clear(); g.mode = 'attract'; g.save.disabled = true; g.demoTag = true; g.ctx.engine.timeScale = 1;\n    Object.assign(g.cheats, { god: true, infiniteAmmo: true, noFever: false, noJams: false, invisible: false, noclip: false });\n    g.resetCampaignStateForDemo();\n    g.events.emit('attractStart');\n    this.next();\n  }\n  /** One step on; a transition joins the beats. */\n  next() {\n    const g = this.game, prev = BEATS[this.i];\n    prev?.end?.(g); this.current = null;\n    this.i = (this.i + 1) % BEATS.length; if (this.i === 0) this.loops++;\n    this.cleanse();\n    const b = { ...BEATS[this.i] }; this.current = b; this.t = 0; this.dur = 12;\n    g.world.setHour(b.hour, true);\n    b.run(g, b);\n    g.screenReveal?.();\n    this.beatsSeen = (this.beatsSeen ?? 0) + 1;\n  }\n  cleanse() {\n    const g = this.game;\n    g.bot.reset(); g.talk.clear(); g.cam.override = null; g.world.fire.regrowAll?.(); g.world.land.paintAll(); g.world.burnDirty = true; g.world.pinWind(null); g.world.setWeather('clear');\n    g.setRiding(null); if (g.player.vehicle) g.vehicles.exit(true); g.vehicles.clear(); g.actors.clear(); g.buddies.clear(); g.combat.clear(); g.projectiles.clear(); g.player.mapUp = false; g.tracker.setUp(false); g.body.feverActive = false; g.body.fever = 0;\n    for (const s of Object.values(g.world.sites)) { s.live = false; s.actors = []; }\n    g.player.hp = 100; g.player.burning = 0; g.player.surgery = null; g.player.downT = 0;\n  }\n  fixed(dt) {\n    if (!this.active) return; this.t += dt;\n    this.current?.tick?.(this.t);\n    if (this.t >= this.dur && !this.transitioning) this.next();\n  }\n  stop() {\n    const g = this.game; if (!this.active) return;\n    BEATS[this.i]?.end?.(g); this.active = false; this.cleanse();\n    g.demoTag = false; g.save.disabled = false; Object.assign(g.cheats, { god: false, infiniteAmmo: false, noFever: false, noJams: false });\n    g.world.reset();\n    g.enterTitle(this.returnTo === 'main' ? 'main' : 'press');\n  }\n}\nEOF\necho ok","description":"Write screens, about content, dev mode and attract director"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18033,"cache_read_input_tokens":465097,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18033},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"2836b4ba-517c-4129-ba5c-24731c8dcb1c","timestamp":"2026-11-06T00:00:48.507Z","request_id":"req_011CgkguS4PA1LAvk8kbY9tV","wire_tool_inputs":{"toolu_016y8jbecZiJBLsEWfXVdReD":{"command":"cat > src/content/about.js <<'EOF'\n// About and Credits. The brief marks this as critical; the same text goes in the exit interview and the final reply.\nexport const ABOUT = {\n  source: [\n    ['DATE', '2026-11-05 16:20:30'],\n    ['SOURCE', 'Far Cry 2'],\n    ['PLAN', 'PLAN.md'],\n    ['GENRE', 'Open-world first-person shooter with survival pressure and systemic fire'],\n    ['PERSPECTIVE', 'First person on foot, at the wheel and in scenes; optional chase camera in vehicles'],\n    ['TECH', 'Pixel Engine 0.46.0 (riftlight kit), three.js r186, Rapier 0.20, WebGPU, JavaScript modules bundled with esbuild 0.28 into one HTML file; AI Hub session client 1.4.0'],\n    ['ART DIRECTION', \"The engine's native 3D-as-pixel-art at 480x270, toon materials, 16-colour palette; about 90 new models as data, plus library props\"],\n    ['ANIMATION', \"The engine's ClipDef system, compileClips and AnimationMixer; hero clips reused, new people clips, a hands rig with surgery scenes; Ragdoll on death; procedural sway\"],\n    ['AUDIO', 'All in code: SoundDef effects, Song music (7 pieces, music 10% by default), Animalese-style gibberish voices, spatial ambience. No audio files'],\n    ['ONLINE', 'AI Hub Session Protocol v1, shared-world, 1 to 4 players; on its own: solo with AI mercs and two windows on one computer'],\n    ['TESTING', 'Headless Node suites, scripted playthrough, Playwright Chromium on file://, pad stub, phone profile, the hub harness; one command; few screenshots'],\n    ['RESEARCH', \"None beyond the plan, the engine kit's docs and the hub's README\"],\n    ['ENVIRONMENT', 'Claude Code CLI (headless); Linux'],\n    ['MODEL', 'Anthropic, claude-opus-5-5, reasoning effort medium'],\n    ['USAGE', 'added on import'],\n  ],\n  testing: [\n    ['HOW MANY ISSUES DID TESTING CATCH?', 'See FEEDBACK_TESTING_1'],\n    ['HOW MANY WOULD BE CRITICAL OR GAME BREAKING?', 'See FEEDBACK_TESTING_2'],\n    ['WHAT WAS THE MOST HELPFUL TEST?', 'See FEEDBACK_TESTING_3'],\n    ['WHAT WAS THE LEAST HELPFUL TEST?', 'See FEEDBACK_TESTING_4'],\n  ],\n  engine: [\n    ['WHAT DID YOU LIKE MOST ABOUT THE ENGINE?', ''], ['DID YOU GET STUCK OR GUESS WRONG?', ''], ['MOST IMPORTANT THING YOU BUILT YOURSELF?', ''], ['HARDEST PART OF USING THE ENGINE?', ''], ['WHAT DID YOU CHANGE IN THE ENGINE, AND WHY?', ''], ['ONE THING YOU WOULD CHANGE?', ''],\n  ],\n  prompt: [\n    ['WHAT DID YOU LIKE MOST ABOUT THIS PROMPT?', ''], ['WHAT WAS CONFUSING?', ''], ['WHAT WAS THE HARDEST THING TO DO?', ''], ['WHAT WOULD YOU CHANGE IN THIS PROMPT?', ''],\n  ],\n  credits: ['PIXEL ENGINE (MIT)', 'THREE.JS (MIT)', 'RAPIER (APACHE-2.0)', 'THE AI HUB SESSION CLIENT', '', 'INSPIRED BY FAR CRY 2; NOT AFFILIATED.', '', 'WRITTEN AND BUILT BY CLAUDE (ANTHROPIC).'],\n};\nEOF\ncat > src/ui/screens.js <<'EOF'\n// Every screen: title, main, pause, settings, about, ledger, game over, endings, bed, locker, rack, board.\nimport { ABOUT } from '../content/about.js';\nimport { EPIGRAPHS, ENDINGS, NOTES } from '../content/dialogue.js';\nimport { GAME_TITLE } from '../content/title.js';\nimport { SHOP_ORDER, THROWABLES, UPGRADES, WEAPONS } from '../content/weapons.js';\nimport { clamp } from '../world/geom.js';\nimport { wrap } from './pixfont.js';\nimport { devScreen } from '../dev/devmode.js';\nexport function pressScreen(g) {\n  return { id: 'press', cover: false, dim: false, footer: false, back: null, items: [], update() { if (g.anyMenuPress()) { g.ui.replace(mainScreen(g)); g.audio.play('ui-confirm'); } },\n    draw() { const h = g.ctx.hud; g.drawTitle(); const y = h.height - 58, gl = g.hud.glyph('confirm'); h.text(0, y, 'PRESS', { anchor: 'top', color: 'white' }); g.hud.promptAt((h.width >> 1) - 16, y + 12, 'confirm', 'START'); void gl; } };\n}\nexport function mainScreen(g) {\n  const items = () => [\n    ...(g.save.exists() ? [{ label: 'CONTINUE', action: () => g.continueGame() }] : []),\n    { label: 'NEW GAME', action: () => g.newGame() },\n    { label: 'CASH RUN', action: () => g.ui.push(cashRunScreen(g)) },\n    { label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) },\n    { label: 'ABOUT AND CREDITS', action: () => g.ui.push(aboutScreen(g)) },\n  ];\n  return { id: 'main', top: 112, dim: false, items, back: () => g.ui.replace(pressScreen(g)), draw() { g.drawTitle(true); } };\n}\nexport function touchGateScreen(g) {\n  return { id: 'touch-gate', top: 150, dim: false, back: null, footer: false, items: [{ label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) }], draw() { g.drawTitle(true); const h = g.ctx.hud; h.text(0, 118, 'CONTROLLER OR KEYBOARD REQUIRED', { anchor: 'top', color: 'white' }); } };\n}\nexport function pauseScreen(g) {\n  const hub = !!g.session;\n  const items = hub ? [{ label: 'RESUME', action: () => g.resume() }, { label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) }] : [\n    { label: 'RESUME', action: () => g.resume() },\n    { label: 'LEDGER', action: () => g.ui.push(ledgerScreen(g)) },\n    { label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) },\n    { label: 'DEV MODE', action: () => g.ui.push(devScreen(g)) },\n    { label: 'ABOUT AND CREDITS', action: () => g.ui.push(aboutScreen(g)) },\n    { label: 'QUIT TO TITLE', action: () => g.toTitle() },\n  ];\n  return { id: 'pause', title: 'PAUSED', cover: 'ink', top: 70, items, back: () => g.resume() };\n}\nconst pct = (v) => `${Math.round(v * 100)}%`;\nfunction slider(label, get, set, step = 0.05) { return { label, value: () => get(), valueText: () => pct(get()), adjust: (d) => set(clamp(get() + d * step, 0, 1)), set }; }\nconst toggle = (label, get, set, on = 'ON', off = 'OFF') => ({ label, value: () => (get() ? on : off), adjust: () => set(!get()), action: () => set(!get()) });\nexport function settingsScreen(g) {\n  const s = g.settings, a = g.ctx.audio;\n  const put = () => g.saveSettings();\n  return { id: 'settings', title: 'SETTINGS', cover: 'ink', items: [\n    { label: 'SOUND', action: () => g.ui.push({ id: 'settings-sound', title: 'SOUND', cover: 'ink', items: [slider('MUSIC', () => a.volume.music, (v) => { a.setVolume('music', v); put(); }), slider('EFFECTS', () => a.volume.sfx, (v) => { a.setVolume('sfx', v); put(); }), slider('VOICES', () => s.voices, (v) => { s.voices = v; put(); })] }) },\n    { label: 'CONTROLS', action: () => g.ui.push({ id: 'settings-controls', title: 'CONTROLS', cover: 'ink', items: [slider('LOOK: PAD', () => s.padSens / 2, (v) => { s.padSens = v * 2; put(); }), slider('LOOK: MOUSE', () => s.mouseSens / 2, (v) => { s.mouseSens = v * 2; put(); }), toggle('INVERT Y', () => s.invertY, (v) => { s.invertY = v; put(); }), toggle('AIM ASSIST', () => s.aimAssist, (v) => { s.aimAssist = v; put(); }), toggle('RUMBLE', () => s.rumble, (v) => { s.rumble = v; put(); }), toggle('GLYPHS', () => s.glyphs === 'xbox', (v) => { s.glyphs = v ? 'xbox' : 'playstation'; put(); }, 'XBOX', 'PLAYSTATION')] }) },\n    { label: 'PICTURE', action: () => g.ui.push({ id: 'settings-picture', title: 'PICTURE', cover: 'ink', items: [toggle('FULLSCREEN', () => g.isFullscreen(), (v) => g.setFullscreen(v)), toggle('PIXEL SIZE', () => s.pixel === 'chunky', (v) => { s.pixel = v ? 'chunky' : 'fine'; g.ctx.engine.settings.set({ pixelSize: s.pixel }); put(); }, 'CHUNKY', 'FINE'), { label: 'QUALITY', value: () => s.quality.toUpperCase(), adjust: (d) => { const q = ['low', 'medium', 'high'], i = (q.indexOf(s.quality) + Math.sign(d) + 3) % 3; s.quality = q[i]; g.ctx.engine.setQuality(q[i]); put(); }, action() { this.adjust(1); } }, { label: 'FIELD OF VIEW', value: () => (s.fov - 50) / 40, valueText: () => String(s.fov), adjust: (d) => { s.fov = clamp(s.fov + d * 2, 50, 90); put(); }, set: (v) => { s.fov = Math.round(50 + v * 40); put(); } }] }) },\n    { label: 'COMFORT', action: () => g.ui.push({ id: 'settings-comfort', title: 'COMFORT', cover: 'ink', items: [toggle('SUBTITLE SIZE', () => s.subtitle === 'large', (v) => { s.subtitle = v ? 'large' : 'normal'; put(); }, 'LARGE', 'NORMAL'), toggle('REDUCE FLASHES', () => s.reduceFlashes, (v) => { s.reduceFlashes = v; put(); }), toggle('FEVER EFFECTS', () => s.feverReduced, (v) => { s.feverReduced = v; put(); }, 'REDUCED', 'FULL')] }) },\n    { label: 'RESET TO DEFAULTS', action: () => { g.resetSettings(); g.notice('SETTINGS RESET'); } },\n  ] };\n}\nexport function pagesFromRows(rows, perPage = 15, cols = 72) {\n  const lines = [];\n  for (const [k, v] of rows) { lines.push({ big: k }); if (v) for (const l of wrap(v, cols)) lines.push(l); }\n  const pages = []; for (let i = 0; i < lines.length; i += perPage) pages.push(lines.slice(i, i + perPage));\n  return pages;\n}\nexport function aboutScreen(g) {\n  const pages = [\n    ...pagesFromRows(ABOUT.source), ...pagesFromRows(ABOUT.testing, 15), ...pagesFromRows(ABOUT.engine, 15), ...pagesFromRows(ABOUT.prompt, 15),\n    [...ABOUT.credits, '', `${GAME_TITLE.toUpperCase()}`],\n  ];\n  return { id: 'about', title: 'ABOUT AND CREDITS', titleY: 14, cover: 'ink', paged: true, pages, page: 0, pageY: 40 };\n}\nexport function ledgerScreen(g) {\n  return { id: 'ledger', cover: 'ink', footer: [['back', 'BACK']], items: [], draw() { const h = g.ctx.hud, l = g.ledgerNow(); h.text(0, 30, 'THE LEDGER', { anchor: 'top', scale: 2, color: 'sand' }); h.text(0, 50, 'IN HIS HAND, NOT YOURS', { anchor: 'top', color: 'mist' }); g.ledgerLines(l).forEach(([k, v], i) => { h.text(40, 76 + i * 26, k, { color: 'mist' }); h.text(h.width - 40 - v.length * 12, 72 + i * 26, v, { scale: 2, color: 'white' }); }); } };\n}\nexport function gameOverScreen(g, text) {\n  return { id: 'game-over', cover: 'ink', back: null, sub: text, title: 'THE PAPERWORK', titleColor: 'red', top: 120, items: [...(g.save.exists() ? [{ label: 'CONTINUE', action: () => g.continueGame() }] : []), { label: 'TITLE', action: () => g.toTitle() }] };\n}\nexport function endingScreen(g) {\n  const text = ENDINGS[g.story.ending ?? 'walk'];\n  return { id: 'ending', cover: 'ink', back: null, footer: [['confirm', 'THE LEDGER']], items: [{ label: '', small: true, action: () => g.ui.replace(finalLedger(g)) }], top: 200, draw() { const h = g.ctx.hud; wrap(text.toUpperCase(), 52).forEach((l, i) => h.text(0, 70 + i * 16, l, { anchor: 'top', color: 'white' })); } };\n}\nexport function finalLedger(g) { const s = ledgerScreen(g); s.id = 'final-ledger'; s.items = [{ label: '', small: true, action: () => g.ui.replace(creditsScreen(g)) }]; s.footer = [['confirm', 'CREDITS']]; s.back = null; s.top = 220; return s; }\nexport function creditsScreen(g) {\n  return { id: 'credits', cover: 'ink', back: null, top: 215, footer: false, items: [{ label: 'TO THE TITLE', action: () => g.afterCredits() }], draw() { const h = g.ctx.hud; h.text(0, 30, GAME_TITLE.toUpperCase(), { anchor: 'top', scale: 3, color: 'sand' }); h.text(0, 66, 'A MAP IS A PROMISE MADE BY SOMEONE WHO HAS ALREADY LEFT.', { anchor: 'top', color: 'mist' }); ABOUT.credits.forEach((c, i) => h.text(0, 90 + i * 12, c, { anchor: 'top', color: 'white' })); } };\n}\nexport function bedScreen(g) {\n  const sleep = (hour) => { g.sleepTo(hour); g.ui.pop(); };\n  return { id: 'bed', title: 'SLEEP UNTIL', dim: true, items: [{ label: 'DAWN', action: () => sleep(5.5) }, { label: 'NOON', action: () => sleep(12) }, { label: 'DUSK', action: () => sleep(18.5) }, { label: 'MIDNIGHT', action: () => sleep(0) }, { label: 'LEAVE', action: () => g.ui.pop() }] };\n}\nexport function lockerScreen(g) {\n  const p = g.player;\n  const row = (slot, label) => {\n    const opts = () => g.lockerOptions(slot);\n    return { label, value: () => { const cur = p.guns[slot]; return cur ? WEAPONS[cur.id].name.replaceAll('\"', '').split(' ').pop() : 'NOTHING'; }, adjust: (d) => { const list = opts(); if (!list.length) return; const cur = p.guns[slot]?.id ?? null, i = list.indexOf(cur), next = list[(i + Math.sign(d) + list.length) % list.length]; if (next && next !== cur) g.combat.give(next, 100, false); g.audio.play('magazine'); } };\n  };\n  return { id: 'locker', title: 'LOCKER', dim: true, items: [row('sidearm', 'SIDEARM'), row('main', 'MAIN'), row('special', 'SPECIAL'), { label: 'LEAVE', action: () => g.ui.pop() }], footer: [['left', 'CHANGE'], ['back', 'BACK']], draw() { const n = Object.keys(g.story.trigs ?? {}).length; if (n >= 6) g.ctx.hud.text(0, 200, 'A CLEAN OLD EMPIRE LEANS IN THE LOCKER. A NOTE SAYS WHY.', { anchor: 'top', color: 'sand' }); } };\n}\nexport function rackScreen(g) {\n  const stock = [...SHOP_ORDER.map((id) => ({ kind: 'gun', id })), { kind: 'throw', id: 'molotov' }, { kind: 'throw', id: 'charge' }, ...UPGRADES.map((u) => ({ kind: 'up', id: u.id }))];\n  const s = { id: 'rack', dim: false, i: 0, back: undefined, footer: false, focus: 0, items: [], onShow() { g.showRackGun(stock[s.i]); }, onClose() { g.showRackGun(null); },\n    update() {\n      const input = g.ctx.input, { pressed } = g;\n      if (pressed('left')) { s.i = (s.i + stock.length - 1) % stock.length; g.audio.play('ui-move'); g.showRackGun(stock[s.i]); }\n      if (pressed('right')) { s.i = (s.i + 1) % stock.length; g.audio.play('ui-move'); g.showRackGun(stock[s.i]); }\n      if (input.wheel) { s.i = (s.i + Math.sign(input.wheel) + stock.length) % stock.length; g.showRackGun(stock[s.i]); }\n      const clicked = g.ui.clickedAnywhere();\n      if (pressed('confirm') || clicked) g.buy(stock[s.i]);\n    },\n    draw() {\n      const h = g.ctx.hud, it = stock[s.i]; const W = h.width;\n      h.rect(0, 180, W, 90, 'ink');\n      if (it.kind === 'gun') {\n        const w = WEAPONS[it.id], own = g.player.unlocked[it.id];\n        h.text(0, 190, w.name, { anchor: 'top', scale: 2, color: 'sand' });\n        const dmg = (w.damage * (w.pellets ?? 1)) / 100, rng = Math.min(1, w.range / 320), rel = w.reliability / 10;\n        [['DAMAGE', dmg], ['RANGE', rng], ['RELIABILITY', rel]].forEach(([k, v], i) => { const y = 208 + i * 10; h.text(120, y, k, { color: 'mist' }); h.rect(200, y, 120, 6, 'night'); h.rect(200, y, Math.round(120 * clamp(v, 0, 1)), 6, 'orange'); });\n        h.text(344, 208, own ? 'TAKEN' : `${w.price} STONES`, { color: own ? 'lime' : 'white' });\n      } else if (it.kind === 'throw') {\n        const t = THROWABLES[it.id]; h.text(0, 190, t.name, { anchor: 'top', scale: 2, color: 'sand' }); h.text(0, 212, `${t.price} STONE EACH, CARRY ${t.carry}`, { anchor: 'top' });\n      } else { const u = UPGRADES.find((x) => x.id === it.id); h.text(0, 190, u.name, { anchor: 'top', scale: 2, color: 'sand' }); h.text(0, 212, u.about, { anchor: 'top' }); h.text(0, 224, g.player.upgrades[it.id] ? 'TAKEN' : `${u.price} STONES`, { anchor: 'top', color: g.player.upgrades[it.id] ? 'lime' : 'white' }); }\n      h.text(24, 14, `STONES ${g.player.stones}`, { color: 'sand' });\n      g.hud.footer([['left', 'LOOK'], ['confirm', 'BUY OR TAKE'], ['back', 'LEAVE']]);\n    } };\n  return s;\n}\nexport function boardScreen(g) {\n  const items = () => { const a = g.missions.available().map((m) => ({ label: m.title, small: true, action: () => { g.ui.pop(); g.offerMission(m); } })); if (!a.length) a.push({ label: 'NOTHING TODAY', small: true, action: () => g.ui.pop() }); return a; };\n  return { id: 'board', title: 'THE NOTICE BOARD', dim: true, items };\n}\nexport function loadingEpigraph(g) { return EPIGRAPHS[g.ctx.random.fork('epigraph').int(0, EPIGRAPHS.length - 1)]; }\nexport function cashRunScreen(g) {\n  return { id: 'cash-run', title: 'CASH RUN', cover: 'ink', top: 84, sub: 'SIX MINUTES. CARRY THE MOST CASES TO THE TRUCK. FRIENDS ONLINE PLAY THROUGH AI HUB.', items: [\n    { label: 'SOLO WITH HIRED GUNS', action: () => g.startCashRun('solo') },\n    { label: 'HOST ON THIS COMPUTER', action: () => g.startCashRun('host') },\n    { label: 'JOIN ON THIS COMPUTER', action: () => g.startCashRun('join') },\n  ] };\n}\nexport function resultsScreen(g, rows) {\n  return { id: 'results', cover: 'ink', title: 'THE COUNT', top: 210, back: null, footer: false, items: [{ label: 'TO THE TITLE', action: () => g.toTitle() }], draw() { const h = g.ctx.hud; rows.forEach((r, i) => { h.text(60, 70 + i * 22, `${i + 1}. ${r.name}`, { scale: 2, color: r.color ?? 'white' }); h.text(h.width - 60 - String(r.score).length * 12, 70 + i * 22, String(r.score), { scale: 2, color: 'sand' }); }); } };\n}\nexport const NOTE_PAGES = NOTES;\nEOF\ncat > src/dev/devmode.js <<'EOF'\n// Dev mode: from the pause menu. Tabs, world visible behind, playing or frozen by a toggle.\nimport { SLIDERS } from '../content/tuning-defaults.js';\nimport { CASES, POSTS, siteById, SITES } from '../content/sites.js';\nimport { MISSIONS } from '../content/missions.js';\nimport { SHOP_ORDER } from '../content/weapons.js';\nimport { resetTuning, TUNING } from '../core/tuning.js';\nimport { clamp } from '../world/geom.js';\nconst toggle = (label, get, set) => ({ label, small: true, value: () => (get() ? 'ON' : 'OFF'), adjust: () => set(!get()), action: () => set(!get()) });\nconst act = (label, action) => ({ label, small: true, action });\nexport function devTabs(g) {\n  const c = g.cheats, dev = g.dev, w = g.world, p = g.player;\n  const sitesList = [...SITES.map((s) => act(s.name, () => dev.teleport(s.at[0] + 6, s.at[1] + 6))), ...CASES.map((k) => act(`CASE ${k.id.toUpperCase()}`, () => dev.teleport(k.at[0] + 1.5, k.at[1] + 1.5))), act('THE CROSSHAIR POINT', () => dev.teleportCrosshair())];\n  return {\n    CHEATS: [toggle('GOD MODE', () => c.god, (v) => { c.god = v; }), toggle('INFINITE AMMO', () => c.infiniteAmmo, (v) => { c.infiniteAmmo = v; }), toggle('NO JAMS', () => c.noJams, (v) => { c.noJams = v; }), toggle('NO FEVER', () => c.noFever, (v) => { c.noFever = v; }), toggle('INVISIBLE TO AI', () => c.invisible, (v) => { c.invisible = v; }), toggle('NOCLIP FLY', () => c.noclip, (v) => { c.noclip = v; }), toggle('WORLD PLAYS BEHIND', () => dev.playing, (v) => { dev.playing = v; g.ctx.engine.timeScale = v ? 1 : 0; })],\n    TELEPORT: sitesList,\n    SPAWN: [act('SQUAD: CONCORD', () => dev.squad('concord')), act('SQUAD: HARVEST', () => dev.squad('harvest')), act('PICKUP', () => dev.vehicle('pickup')), act('TECHNICAL', () => dev.vehicle('technical')), act('TRUCK', () => dev.vehicle('cargo-truck')), act('STONE CASE', () => g.spawnStonePickup(p.x + 3, p.z, 'dev-case', 5)), act('A BUDDY', () => dev.buddy())],\n    WORLD: [\n      { label: 'HOUR', small: true, value: () => w.hour / 24, valueText: () => w.hour.toFixed(1), adjust: (d) => w.setHour((w.hour + d * 0.5 + 24) % 24), set: (v) => w.setHour(v * 23.9) },\n      { label: 'WIND DIRECTION', small: true, value: () => (Math.atan2(w.wind.z, w.wind.x) + Math.PI) / 6.283, valueText: () => `${Math.round((Math.atan2(w.wind.z, w.wind.x) * 180) / Math.PI)}`, adjust: (d) => { const a = Math.atan2(w.wind.z, w.wind.x) + d * 0.2; w.wind.x = Math.cos(a); w.wind.z = Math.sin(a); }, set: (v) => { const a = v * 6.283 - Math.PI; w.wind.x = Math.cos(a); w.wind.z = Math.sin(a); } },\n      { label: 'WIND SPEED', small: true, value: () => w.wind.speed / 8, valueText: () => w.wind.speed.toFixed(1), adjust: (d) => { w.wind.speed = clamp(w.wind.speed + d * 0.5, 0, 8); }, set: (v) => { w.wind.speed = v * 8; } },\n      { label: 'WEATHER', small: true, value: () => w.weather.toUpperCase(), adjust: (d) => { const l = ['clear', 'dust', 'storm'], i = (l.indexOf(w.weather) + Math.sign(d) + 3) % 3; w.setWeather(l[i]); }, action() { this.adjust(1); } },\n      act('IGNITE AT THE CROSSHAIR', () => dev.igniteCrosshair()), act('EXTINGUISH ALL', () => w.fire.extinguish()), act('REGROW ALL', () => { w.fire.regrowAll(); w.land.paintAll(); w.burnDirty = true; }), act('SLEEP 6 HOURS', () => w.advanceHours(6)),\n    ],\n    MISSION: [\n      ...MISSIONS.map((m) => act(`START ${m.id.toUpperCase()}: ${m.title}`, () => dev.startMission(m.id))),\n      act('COMPLETE CURRENT STEP', () => dev.completeStep()), act('SET STORY FLAGS: ALL FRIENDS MET', () => { for (const k of Object.keys(g.buddies.state)) g.buddies.state[k].met = true; g.people.showFriends(); }),\n      act('GIVE 50 STONES', () => { p.stones += 50; }), act('GIVE 3 TABLETS', () => { p.tablets += 3; }), act('GIVE 3 SYRETTES', () => { p.syrettes += 3; }), act('ALL GUNS', () => dev.allGuns()), act('BREAK GUN', () => dev.breakGun()), act('FORCE JAM', () => dev.forceJam()), act('FORCE FEVER', () => g.body.onset()), act('DOWN A BUDDY', () => dev.downBuddy()),\n    ],\n    BALANCE: [...SLIDERS.map((s) => ({ label: s.label, small: true, value: () => (TUNING[s.key] - s.min) / (s.max - s.min), valueText: () => String(Math.round(TUNING[s.key] * 100) / 100), adjust: (d) => { TUNING[s.key] = clamp(Math.round((TUNING[s.key] + d * s.step) * 1000) / 1000, s.min, s.max); }, set: (v) => { TUNING[s.key] = s.min + v * (s.max - s.min); }, resetOne: () => resetTuning(s.key) })), act('RESET ALL TO DEFAULTS', () => resetTuning())],\n    DEBUG: [toggle('FIRE-GRID OVERLAY', () => dev.fireOverlay, (v) => { dev.fireOverlay = v; }), toggle('NAV OVERLAY', () => dev.navOverlay, (v) => { dev.navOverlay = v; }), toggle('AI STATE OVER HEADS', () => dev.aiText, (v) => { dev.aiText = v; }), toggle('COUNTS', () => dev.counts, (v) => { dev.counts = v; }), toggle('CROSSHAIR COORDS', () => dev.coords, (v) => { dev.coords = v; }), toggle('ENGINE DEBUG PANEL', () => g.ctx.engine.debugShown, (v) => g.ctx.engine.showDebug(v)), toggle('FREE CAMERA', () => dev.freeCam, (v) => dev.setFreeCam(v)), act('QUICK SAVE', () => dev.quickSave()), act('QUICK LOAD', () => dev.quickLoad()), toggle('SHOW STATUS LINE', () => dev.statusLine, (v) => { dev.statusLine = v; })],\n  };\n}\nexport function devScreen(g) {\n  const tabs = devTabs(g), names = Object.keys(tabs);\n  return { id: 'dev', cover: false, dim: false, top: 30, tabs: names, tab: 0, items: (s) => tabs[names[s.tab]], footer: [['tabL', 'TAB'], ['resetOne', 'RESET ONE'], ['back', 'BACK']], onShow() { g.dev.open = true; }, onClose() { g.dev.open = false; g.ctx.engine.timeScale = 0; g.dev.playing = false; }, draw() { g.dev.drawOverlays(); } };\n}\nexport class Dev {\n  playing = false; open = false; fireOverlay = false; navOverlay = false; aiText = false; counts = false; coords = false; freeCam = false; statusLine = false;\n  constructor(game) { this.game = game; }\n  teleport(x, z) { const g = this.game; g.player.teleport(x, z); g.world.focusX = x; g.world.focusZ = z; g.world.updateBubble?.(); }\n  crosshair() { const g = this.game, e = g.combat.eye(), v = g.ctx.camera.camera.position.clone(), dir = v.clone().set(...e.dir); const hit = g.ctx.physics.castRay(v.set(e.x, e.y, e.z), dir, 800, undefined, g.player.ctrl?.body); return hit ? [hit.point.x, hit.point.y, hit.point.z] : [e.x + e.dir[0] * 30, e.y, e.z + e.dir[2] * 30]; }\n  teleportCrosshair() { const c = this.crosshair(); this.teleport(c[0], c[2]); }\n  igniteCrosshair() { const c = this.crosshair(); this.game.world.fire.ignite(c[0], c[2], 5); }\n  squad(f) { const p = this.game.player; this.game.spawnSquad(f, p.x + 26, p.z + 10, 4, 'dev'); }\n  vehicle(t) { const p = this.game.player; this.game.vehicles.spawn(t, p.x + 7, p.z, 0, 'dev'); }\n  buddy() { const g = this.game, id = g.buddies.alive()[0] ?? 'ines'; g.buddies.state[id].met = true; g.buddies.spawnFollower(id, g.player.x + 3, g.player.z + 3); }\n  allGuns() { const g = this.game; for (const id of SHOP_ORDER) { g.player.unlocked[id] = true; } g.combat.give('tractor', 100, false); g.combat.give('tube', 100, false); g.story.hasFlare = true; g.story.hasTracker = true; g.player.molotovs = 3; g.player.charges = 2; }\n  breakGun() { const g = this.game.combat.current(); if (g) { g.cond = 1; this.game.vm.setCondition(g.id, 1); } }\n  forceJam() { const c = this.game.combat, g = c.current(); if (g && g.id !== 'mg' && g.id !== 'cane') c.jam(g); }\n  downBuddy() { const g = this.game; let a = g.buddies.followers.find((f) => f.alive && !f.down); if (!a) { this.buddy(); a = g.buddies.followers.at(-1); } g.actors.goDown(a, {}); }\n  completeStep() { const m = this.game.missions; if (m.active) m.next(); }\n  startMission(id) { this.game.dev_startMission(id); }\n  quickSave() { const s = this.game.save; this.quick = JSON.stringify(s.serialize()); this.game.notice('QUICK SAVED'); }\n  quickLoad() { if (this.quick) this.game.ctx.input.send({ load: this.quick }); }\n  setFreeCam(v) { const e = this.game.ctx.engine; this.freeCam = v; e.setCamera(v ? { preset: 'free' } : { preset: 'first', fov: 62 }, { syncUrl: false }); }\n  drawOverlays() {\n    const g = this.game, h = g.ctx.hud;\n    if (this.fireOverlay) { const f = g.world.fire, S = 128; h.rect(h.width - S - 8, 28, S, S, 'ink'); for (const i of f.burning) { const x = i % 256, z = (i / 256) | 0; h.rect(h.width - S - 8 + (x >> 1), 28 + (z >> 1), 1, 1, 'orange'); } for (const i of f.burntList) { const x = i % 256, z = (i / 256) | 0; h.rect(h.width - S - 8 + (x >> 1), 28 + (z >> 1), 1, 1, 'slate'); } h.text(h.width - S - 8, 158, `${f.burning.length} BURNING ${f.burntCount} BURNT`, { color: 'orange' }); }\n    if (this.navOverlay && g.nav) { const n = g.nav, S = 120; h.rect(8, 28, S, S, 'ink'); for (let z = 0; z < S; z++) for (let x = 0; x < S; x++) if (!n.isOpen(Math.floor((x / S) * 640), Math.floor((z / S) * 640))) h.rect(8 + x, 28 + z, 1, 1, 'plum'); }\n    if (this.aiText) for (const a of g.actors.list) { const s = g.hud.world(a.x, a.y + 2.2, a.z); if (s) h.text(Math.round(s[0]) - 18, Math.round(s[1]) - 14, `${a.state} ${Math.round(a.hp)}`, { color: 'lime' }); }\n    if (this.counts) { const st = g.ctx.engine.state(); h.text(10, h.height - 46, `ACTORS ${g.actors.list.length} VEH ${g.vehicles.list.length} FIRE ${g.world.fire.burning.length} DRAWS ${st.renderer?.calls ?? st.draws ?? '?'}`, { color: 'lime' }); }\n    if (this.coords) { const c = this.crosshair(); h.text(10, h.height - 58, `CROSSHAIR ${c[0].toFixed(1)} ${c[1].toFixed(1)} ${c[2].toFixed(1)}`, { color: 'lime' }); }\n    if (this.statusLine) h.text(10, h.height - 70, g.status(), { color: 'lime' });\n  }\n}\nexport { POSTS, siteById };\nEOF\ncat > src/attract/director.js <<'EOF'\n// Attract mode. A director with a list of beats, the real game with cheats. Its only job is to show the demo.\nimport { siteById } from '../content/sites.js';\nconst site = (id) => siteById[id].at;\nexport const BEATS = [\n  { id: 'map-at-wheel', hour: 18.4, run(g, b) { const at = [40, -30]; g.player.teleport(at[0], at[1]); const v = g.vehicles.spawn('technical', 44, -26, 2.5, 'attract'); g.vehicles.enter(v); b.v = v; b.tick = (t) => { g.bot.drive = { throttle: 0.7, steer: Math.sin(t * 0.4) * 0.2 }; if (t > 3) g.player.mapUp = true; }; } },\n  { id: 'checkpoint-jam', hour: 16.2, run(g, b) { const a = site('p2'); g.player.teleport(a[0] + 30, a[1] + 8); g.player.lookAt(a[0], g.world.land.heightAt(a[0], a[1]) + 1.2, a[1]); g.combat.give('tractor', 34, true); const gun = g.player.guns.main; gun.scriptedJam = 12; b.tick = (t) => { g.bot.fire = !gun.jammed && t > 1; if (gun.jammed && Math.floor(t * 2) % 2 === 0) g.bot.press('KeyR'); }; } },\n  { id: 'flare-grass', hour: 17, run(g, b) { const a = site('p1'); g.world.pinWind({ dir: [1, 0.2], speed: 6 }); g.player.teleport(a[0] - 70, a[1] - 8); g.player.lookAt(a[0] - 30, g.world.land.heightAt(a[0] - 30, a[1]) + 6, a[1]); g.combat.give('flare', 100, true); b.tick = (t) => { if (t > 1 && !b.shot) { b.shot = true; g.bot.press('MouseLeft'); } }; } },\n  { id: 'night-field', hour: 23, camera: true, run(g, b) { const a = site('long-field'); g.world.setHour(23, true); g.world.pinWind({ dir: [0, -1], speed: 5 }); g.world.fire.ignite(a[0], a[1] + 30, 14); g.world.fire.ignite(a[0] + 60, a[1], 14); b.tick = (t) => { const y = g.world.land.heightAt(a[0], a[1]) + 9, k = t * 0.09; g.cam.override = { position: [a[0] - 100 + t * 9, y, a[1] + 66], target: [a[0] + Math.sin(k) * 30, y - 6, a[1]] }; }; } },\n  { id: 'fever', hour: 13, run(g, b) { const a = [-100, 60]; g.player.teleport(a[0], a[1]); g.player.setYaw(0.4, 0.05); g.player.tablets = 3; g.body.fever = 0; g.body.feverActive = true; g.body.feverIgnored = -1e9; g.story.feverOn = true; b.tick = (t) => { if (t > 5) g.bot.hold = 'KeyH'; }; b.end = () => { g.story.feverOn = false; g.body.feverActive = false; g.body.fever = 0; }; } },\n  { id: 'surgery', hour: 11, run(g, b) { g.player.teleport(-110, 90); g.player.hp = 15; g.player.setYaw(1.2, -0.25); b.tick = (t) => { if (t > 1 && !b.s) { b.s = true; g.body.startSurgery(); } }; b.end = () => { g.player.surgery = null; g.vm.endTool(); g.player.hp = 100; }; } },\n  { id: 'scope', hour: 12, run(g, b) { const a = site('p4'); g.player.teleport(a[0] + 110, a[1] + 60); g.player.lookAt(a[0], g.world.land.heightAt(a[0], a[1]) + 1.2, a[1]); g.combat.give('empire', 80, true); b.tick = (t) => { g.bot.aim = true; if (t > 3 && Math.floor(t) % 3 === 0 && !b.f?.[Math.floor(t)]) { (b.f ??= {})[Math.floor(t)] = 1; g.bot.press('MouseLeft'); } }; } },\n  { id: 'dragged', hour: 16, run(g, b) { const st = g.buddies.state.mags; st.met = true; st.alive = true; st.spentUntil = -1; g.player.teleport(-300, 150); g.player.setYaw(2, 0); g.buddies.rescue('mags'); b.tick = (t) => { if (t > 8 && !b.x) { b.x = true; const a = g.buddies.followers[0]; if (a) { g.player.teleport(a.x + 1.4, a.z + 1); g.player.lookAt(a.x, a.y + 0.6, a.z); g.actors.goDown(a, { fire: true }); } } }; b.end = () => { g.buddies.clear(); g.player.downT = 0; g.cam.override = null; g.frozen = false; g.player.hp = 100; g.prompt.setChoice(null); }; } },\n  { id: 'tracker', hour: 15, run(g, b) { const c = g.world.cases[0]; g.story.hasTracker = true; g.player.teleport(c.at[0] + 22, c.at[1] + 4); g.player.lookAt(c.at[0], g.world.land.heightAt(c.at[0], c.at[1]) + 0.5, c.at[1]); g.tracker.setUp(true); g.world.fire.burnStrip([[c.at[0] - 10, c.at[1]], [c.at[0] + 20, c.at[1]]], 20); b.tick = () => { g.bot.forward = 0.55; }; b.end = () => g.tracker.setUp(false); } },\n  { id: 'train-mg', hour: 15, run(g, b) { const t = g.train; t.setAt(-200, 104); t.topSpeed = 12; t.goal = t.sToward(200, 40); g.setRiding(t, true); g.player.setYaw(Math.PI / 2, -0.04); g.spawnSquad('harvest', -120, 130, 4, 'attract'); b.tick = (tt) => { g.bot.fire = tt > 2 && Math.sin(tt * 2) > -0.3; }; b.end = () => g.setRiding(null); } },\n  { id: 'tibor', hour: 10, run(g, b) { const n = g.people.npcs.tibor; g.player.teleport(n.x - 2, n.z - 5); g.talk.startScene({ speaker: 'tibor', lines: ['tibor.idle', 'm2.brief'], skippable: false }); b.end = () => { if (g.talk.scene) { g.talk.scene.onDone = null; g.talk.endScene(); } g.talk.clear(); }; } },\n  { id: 'table-map', hour: 22, camera: true, run(g, b) { const a = site('observatory'), y = g.world.land.heightAt(a[0], a[1]) + 0.8, at = [a[0], y, a[1] + 0.8]; g.world.burnStrip('A'); g.world.burnStrip('B'); g.world.burnStrip('C'); g.mapTex.arc = true; g.showTableMap(at); b.tick = (t) => { g.cam.override = { position: [at[0] + Math.sin(t * 0.2) * 0.4, y + 0.75, at[2] + 0.42], target: at }; }; b.end = () => { g.mapTex.arc = false; g.showTableMap(null); }; } },\n  { id: 'title', hour: 18.4, camera: true, run(g, b) { g.titleCamera(); g.titleBanner = true; b.end = () => { g.titleBanner = false; }; } },\n];\nexport class Attract {\n  active = false; i = 0; t = 0; dur = 12; transitioning = false; loops = 0; order = BEATS;\n  constructor(game) { this.game = game; }\n  start() {\n    const g = this.game;\n    this.active = true; this.i = -1; this.loops = 0; this.returnTo = g.ui.top?.id ?? 'press';\n    g.ui.clear(); g.mode = 'attract'; g.save.disabled = true; g.demoTag = true; g.ctx.engine.timeScale = 1;\n    Object.assign(g.cheats, { god: true, infiniteAmmo: true, noFever: false, noJams: false, invisible: false, noclip: false });\n    g.resetCampaignStateForDemo();\n    g.events.emit('attractStart');\n    this.next();\n  }\n  /** One step on; a transition joins the beats. */\n  next() {\n    const g = this.game, prev = BEATS[this.i];\n    prev?.end?.(g); this.current = null;\n    this.i = (this.i + 1) % BEATS.length; if (this.i === 0) this.loops++;\n    this.cleanse();\n    const b = { ...BEATS[this.i] }; this.current = b; this.t = 0; this.dur = 12;\n    g.world.setHour(b.hour, true);\n    b.run(g, b);\n    g.screenReveal?.();\n    this.beatsSeen = (this.beatsSeen ?? 0) + 1;\n  }\n  cleanse() {\n    const g = this.game;\n    g.bot.reset(); g.talk.clear(); g.cam.override = null; g.world.fire.regrowAll?.(); g.world.land.paintAll(); g.world.burnDirty = true; g.world.pinWind(null); g.world.setWeather('clear');\n    g.setRiding(null); if (g.player.vehicle) g.vehicles.exit(true); g.vehicles.clear(); g.actors.clear(); g.buddies.clear(); g.combat.clear(); g.projectiles.clear(); g.player.mapUp = false; g.tracker.setUp(false); g.body.feverActive = false; g.body.fever = 0;\n    for (const s of Object.values(g.world.sites)) { s.live = false; s.actors = []; }\n    g.player.hp = 100; g.player.burning = 0; g.player.surgery = null; g.player.downT = 0;\n  }\n  fixed(dt) {\n    if (!this.active) return; this.t += dt;\n    this.current?.tick?.(this.t);\n    if (this.t >= this.dur && !this.transitioning) this.next();\n  }\n  stop() {\n    const g = this.game; if (!this.active) return;\n    BEATS[this.i]?.end?.(g); this.active = false; this.cleanse();\n    g.demoTag = false; g.save.disabled = false; Object.assign(g.cheats, { god: false, infiniteAmmo: false, noFever: false, noJams: false });\n    g.world.reset();\n    g.enterTitle(this.returnTo === 'main' ? 'main' : 'press');\n  }\n}\nEOF\necho ok","description":"Write screens, about content, dev mode and attract director"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016y8jbecZiJBLsEWfXVdReD","type":"tool_result","content":"ok","is_error":false}]},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"d7122d1d-36da-4f3d-a9f1-d4f8ab0b6a0c","timestamp":"2026-11-06T00:00:48.533Z","tool_use_result":{"stdout":"ok","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016y8jbecZiJBLsEWfXVdReD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
