', palette: { steel: 'slate', steel2: 'night', handle: 'sand' }, parts: [{ box: [1, 2, 0.6], at: [0, 1, 0], c: 'steel' }, { box: [0.04, 1.9, 0.02], at: [0, 1, 0.31], c: 'steel2' }, { box: [0.06, 0.2, 0.04], at: [0.1, 1.1, 0.32], c: 'handle' }] });\nexport const clothPost = model({ id: 'cloth-post', about: 'A post that carries a strip of red cloth for the wind', tags: ['prop'], collider: 'none', palette: { post: 'night' }, parts: [{ box: [0.1, 4, 0.1], at: [0, 2, 0], c: 'post' }] });\nexport const mineSign = model({ id: 'mine-sign', about: 'A skull-less hand-painted mine warning', tags: ['prop'], collider: 'none', palette: { post: 'plum', board: 'red', mark: 'white' }, parts: [{ box: [0.1, 1.2, 0.1], at: [0, 0.6, 0], c: 'post' }, { box: [0.7, 0.5, 0.04], at: [0, 1.15, 0.06], c: 'board' }, { box: [0.4, 0.08, 0.02], at: [0, 1.2, 0.09], c: 'mark' }, { box: [0.4, 0.08, 0.02], at: [0, 1.08, 0.09], c: 'mark' }] });\nexport const cistern = model({ id: 'cistern', about: 'A concrete village cistern', tags: ['prop'], collider: 'cyl', palette: { wall: 'mist', wall2: 'slate', water: 'teal' }, parts: [{ cyl: [7, 1.8, 7], at: [0, 0.9, 0], seg: 10, c: 'wall' }, { cyl: [6.2, 0.1, 6.2], at: [0, 1.76, 0], seg: 10, c: 'water' }, { cyl: [7.2, 0.14, 7.2], at: [0, 1.2, 0], seg: 10, c: 'wall2' }] });\nconst stoneW = { stone: 'mist', stone2: 'slate', mortar: 'night', dressed: 'sand', slit: 'ink' };\nexport const fortWall = model({ id: 'fort-wall', about: 'A length of colonial fort wall with merlons', tags: ['building'], collider: 'parts', palette: stoneW, parts: [{ box: [64, 4.5, 1.4], at: [0, 2.25, 0], c: 'stone' }, { box: [64.2, 0.3, 1.6], at: [0, 2, 0], c: 'stone2', collide: false }, ...rowOf([{ box: [1.6, 0.9, 1.4], at: [0, 4.95, 0], c: 'stone2', collide: false }], { n: 15, step: [4.4, 0, 0], at: [-30.8, 0, 0] })] });\nexport const fortGate = model({ id: 'fort-wall-gate', about: 'The fort\\'s front wall, a gate in its middle', tags: ['building'], collider: 'parts', palette: stoneW, parts: [{ mirror: [{ box: [28, 4.5, 1.4], at: [18, 2.25, 0], c: 'stone' }, { box: [2.4, 6.2, 2], at: [4.4, 3.1, 0], c: 'stone2' }], axis: 'x' }, { box: [8, 1.6, 1.4], at: [0, 5.4, 0], c: 'dressed', collide: false }] });\nexport const bridgeRoad = model({ id: 'bridge-road', about: 'A timber road bridge on iron trestles', tags: ['building'], collider: 'parts', palette: { deck: 'orange', deck2: 'red', iron: 'night' }, parts: [{ box: [7, 0.4, 38], at: [0, 0, 0], c: 'deck' }, { mirror: [{ box: [0.2, 0.9, 38], at: [3.5, 0.6, 0], c: 'deck2' }], axis: 'x' }, ...rowOf([{ box: [6.4, 4, 0.5], at: [0, -2.2, 0], c: 'iron' }], { n: 3, step: [0, 0, 10], at: [0, 0, -10] })] , floats: true });\nexport const bridgeRail = model({ id: 'bridge-rail', about: 'A plate-girder rail bridge', tags: ['building'], collider: 'parts', floats: true, palette: { iron: 'night', iron2: 'slate', deck: 'plum' }, parts: [{ box: [4.2, 0.5, 38], at: [0, 0, 0], c: 'deck' }, { mirror: [{ box: [0.3, 1.4, 38], at: [2.1, 0.8, 0], c: 'iron2' }], axis: 'x' }, ...rowOf([{ box: [3.6, 4, 0.6], at: [0, -2.2, 0], c: 'iron' }], { n: 3, step: [0, 0, 10], at: [0, 0, -10] })] });\nexport const stoneCase = model({ id: 'stone-case', about: 'A small steel case of rough stones', tags: ['pickup'], floats: true, collider: 'none', palette: { steel: 'mist', band: 'night', clasp: 'sand' }, parts: [{ box: [0.5, 0.26, 0.34], at: [0, 0.13, 0], c: 'steel' }, { box: [0.52, 0.06, 0.36], at: [0, 0.14, 0], c: 'band' }, { box: [0.08, 0.1, 0.03], at: [0, 0.18, 0.18], c: 'clasp' }, { box: [0.2, 0.04, 0.04], at: [0, 0.29, 0], c: 'band' }] });\nexport const medCrate = model({ id: 'med-crate', about: 'A white medicine crate with a green cross', tags: ['pickup'], collider: 'none', palette: { box: 'white', cross: 'green', band: 'mist' }, parts: [{ box: [0.8, 0.5, 0.5], at: [0, 0.25, 0], c: 'box' }, { box: [0.3, 0.1, 0.02], at: [0, 0.27, 0.26], c: 'cross' }, { box: [0.1, 0.3, 0.02], at: [0, 0.27, 0.26], c: 'cross' }, { box: [0.82, 0.06, 0.52], at: [0, 0.46, 0], c: 'band' }] });\nexport const chargeWorld = model({ id: 'charge-world', about: 'A remote charge with a blinking lamp', tags: ['prop'], floats: true, collider: 'none', palette: { block: 'sand', band: 'ink', lamp: 'red' }, parts: [{ box: [0.3, 0.18, 0.2], at: [0, 0.09, 0], c: 'block' }, { box: [0.32, 0.04, 0.22], at: [0, 0.09, 0], c: 'band' }, { box: [0.05, 0.05, 0.05], at: [0.08, 0.2, 0], c: 'lamp', glow: true }] });\nexport const pickupGun = model({ id: 'pickup-gun', about: 'A gun lying on the ground', tags: ['pickup'], floats: true, collider: 'none', palette: { wood: 'red', iron: 'ink' }, parts: [{ box: [0.72, 0.08, 0.05], at: [0, 0.05, 0], c: 'iron' }, { box: [0.24, 0.1, 0.06], at: [-0.32, 0.05, 0], c: 'wood' }] });\nexport const projectile = model({ id: 'projectile', about: 'A bottle or rocket in flight', tags: ['fx'], floats: true, collider: 'none', palette: { body: 'teal', tip: 'orange' }, parts: [{ cyl: [0.12, 0.34, 0.12], at: [0, 0, 0], rot: [90, 0, 0], c: 'body' }, { box: [0.06, 0.06, 0.14], at: [0, 0, 0.22], c: 'tip', glow: true }] });\nexport const wreck = model({ id: 'wreck', about: 'A burnt-out truck left where it died', tags: ['prop'], collider: 'box', palette: { paint: 'ink', paint2: 'night', glass: 'ink', iron: 'plum', lamp: 'ink', accent: 'night' }, parts: [{ group: [...cab(), ...nose(), ...bed()], at: [0, 0.45, 0], rot: [0, 0, 4] }] });\nexport const hollowTree = model({ id: 'hollow-tree', about: 'A fat bottle tree with a hollow', tags: ['nature'], collider: 'cyl', palette: { bark: 'plum', bark2: 'red', hole: 'ink', leaf: 'green' }, parts: [{ cyl: [2.4, 5, 2.4], at: [0, 2.5, 0], top: 0.6, seg: 8, c: 'bark' }, { box: [0.9, 1.2, 0.3], at: [0, 1.1, 1.1], c: 'hole' }, ...around([{ box: [0.3, 1.8, 0.3], at: [0, 5.5, 0.7], rot: [24, 0, 0], c: 'bark2' }], { n: 5 }), { lump: [3, 0.8, 3], at: [0, 6.6, 0], seed: 2, c: 'leaf' }] });\n\n// ---------- Nature. Trees are instanced: keep them small in parts ----------\nconst acaciaCrown = (w, h, y, x = 0, z = 0) => ({ lump: [w, h, w], at: [x, y, z], seed: Math.round(w * 7), c: 'leaf' });\nexport const acaciaA = model({ id: 'acacia-a', about: 'Flat-topped acacia', tags: ['nature'], collider: 'none', palette: { bark: 'plum', leaf: 'green', leaf2: 'teal' }, parts: [{ cyl: [0.5, 4, 0.5], at: [0, 2, 0], top: 0.6, c: 'bark' }, { box: [0.22, 2.4, 0.22], at: [0.8, 4.4, 0], rot: [0, 0, -35], c: 'bark' }, { box: [0.22, 2.4, 0.22], at: [-0.8, 4.2, 0.2], rot: [10, 0, 35], c: 'bark' }, acaciaCrown(7, 1.2, 5.6), { lump: [4.5, 0.8, 4.5], at: [1.2, 6.1, 0.4], seed: 5, c: 'leaf2' }] });\nexport const acaciaB = model({ id: 'acacia-b', about: 'Wide, leaning acacia', tags: ['nature'], collider: 'none', palette: { bark: 'plum', leaf: 'lime', leaf2: 'green' }, parts: [{ cyl: [0.6, 3.4, 0.6], at: [0.3, 1.7, 0], rot: [0, 0, -10], top: 0.5, c: 'bark' }, { box: [0.2, 3, 0.2], at: [1.6, 3.8, 0], rot: [0, 0, -55], c: 'bark' }, acaciaCrown(5.5, 1, 4.6, 2.4), { lump: [4.5, 0.9, 4], at: [-0.5, 4.3, 0.3], seed: 8, c: 'leaf2' }] });\nexport const acaciaC = model({ id: 'acacia-c', about: 'Young umbrella thorn', tags: ['nature'], collider: 'none', palette: { bark: 'red', leaf: 'green', leaf2: 'lime' }, parts: [{ cyl: [0.3, 2.6, 0.3], at: [0, 1.3, 0], top: 0.6, c: 'bark' }, acaciaCrown(3.8, 0.8, 3), { lump: [2.2, 0.5, 2.2], at: [0.3, 3.4, 0], seed: 6, c: 'leaf2' }] });\nexport const bottleTree = model({ id: 'bottle-tree', about: 'Fat bottle tree', tags: ['nature'], collider: 'none', palette: { bark: 'plum', bark2: 'red', leaf: 'green' }, parts: [{ cyl: [2.2, 4.4, 2.2], at: [0, 2.2, 0], top: 0.55, seg: 8, c: 'bark' }, ...around([{ box: [0.26, 1.7, 0.26], at: [0, 4.9, 0.6], rot: [24, 0, 0], c: 'bark2' }], { n: 5 }), { lump: [3, 0.8, 3], at: [0, 6, 0], seed: 4, c: 'leaf' }] });\nexport const scorchedA = model({ id: 'scorched-a', about: 'A burnt black trunk with two arms', tags: ['nature'], collider: 'none', palette: { char: 'ink', char2: 'night' }, parts: [{ cyl: [0.5, 4, 0.5], at: [0, 2, 0], top: 0.5, c: 'char' }, { box: [0.2, 2.4, 0.2], at: [0.8, 4.4, 0], rot: [0, 0, -35], c: 'char2' }, { box: [0.2, 2, 0.2], at: [-0.7, 4.1, 0.2], rot: [10, 0, 35], c: 'char' }] });\nexport const scorchedB = model({ id: 'scorched-b', about: 'A burnt bottle tree', tags: ['nature'], collider: 'none', palette: { char: 'ink', char2: 'night' }, parts: [{ cyl: [2, 4.2, 2], at: [0, 2.1, 0], top: 0.5, seg: 8, c: 'char' }, { box: [0.26, 1.2, 0.26], at: [0.3, 4.6, 0], rot: [0, 0, -20], c: 'char2' }] });\nexport const cropClump = model({ id: 'crop-clump', about: 'A clump of tall dry crop', tags: ['nature'], collider: 'none', palette: { stalk: 'sand', stalk2: 'orange', head: 'red' }, parts: [...around([{ box: [0.08, 1.8, 0.08], at: [0, 0.9, 0.2], rot: [4, 0, 0], c: 'stalk' }], { n: 5 }), { box: [0.08, 2.2, 0.08], at: [0, 1.1, 0], c: 'stalk2' }, { box: [0.12, 0.3, 0.12], at: [0, 2.3, 0], c: 'head' }] });\nexport const gazelle = model({ id: 'gazelle', about: 'A small gazelle on its own rig', tags: ['actor'], floats: true, collider: 'none', palette: { hide: 'orange', belly: 'white', horn: 'ink', leg: 'plum' }, parts: [{ group: [{ box: [0.26, 0.28, 0.72], at: [0, 0, 0], c: 'hide' }, { box: [0.24, 0.08, 0.6], at: [0, -0.15, 0], c: 'belly' }, { group: [{ box: [0.12, 0.34, 0.12], at: [0, 0.15, 0.04], rot: [20, 0, 0], c: 'hide' }, { box: [0.12, 0.13, 0.26], at: [0, 0.32, 0.14], c: 'hide' }, { mirror: [{ box: [0.03, 0.26, 0.03], at: [0.05, 0.5, 0.04], rot: [-20, 0, 0], c: 'horn' }], axis: 'x' }], at: [0, 0.14, 0.34], pivot: true, name: 'Neck' }, ...[['LegFR', 0.1, 0.28], ['LegFL', -0.1, 0.28], ['LegBR', 0.1, -0.28], ['LegBL', -0.1, -0.28]].map(([name, x, z]) => ({ group: [{ box: [0.06, 0.5, 0.06], at: [0, -0.25, 0], c: 'leg' }], at: [x, -0.12, z], pivot: true, name }))], at: [0, 0.62, 0], pivot: true, name: 'Body' }] });\nexport const vulture = model({ id: 'vulture', about: 'A vulture with flapping wings', tags: ['actor'], floats: true, collider: 'none', palette: { body: 'ink', wing: 'night', head: 'red' }, parts: [{ box: [0.26, 0.2, 0.6], at: [0, 0, 0], c: 'body' }, { box: [0.1, 0.1, 0.14], at: [0, 0.03, 0.36], c: 'head' }, { group: [{ box: [1, 0.05, 0.4], at: [0.5, 0, 0], c: 'wing' }], at: [0.12, 0.04, 0], pivot: true, name: 'WingL' }, { group: [{ box: [1, 0.05, 0.4], at: [-0.5, 0, 0], c: 'wing' }], at: [-0.12, 0.04, 0], pivot: true, name: 'WingR' }] });\n\nexport const grassFlame = textureDef({\n  id: 'grass-flame', about: 'Licking grass flame', tags: ['fx'], size: [40, 14], frames: 4, palette: { a: 'red', b: 'orange', c: 'sand', d: 'white' },\n  layers: [\n    ['...aa.....', '...aba....', '..abba....', '..abba.a..', '.abbbaab..', '.abcbbabb.', 'abccbbbba.', 'abcccbcba.', 'abccdcbba.', 'abcddcbba.', 'abcddccba.', '.abcdcbba.', '.abccbbba.', '..aabbaa..'],\n    ['......a...', '.....aa...', '.a...aba..', '.aa.abba..', '.aba.abba.', 'abba.abbba', 'abbbabcba.', 'abcbbccba.', 'abccccdcba', '.abcddcba.', '.abcddcbba', '.abcdccba.', '..abccbba.', '...aabaa..'],\n    ['....a.....', '...aa.....', '...aba.a..', '..abba.a..', '..abbaaba.', '.abcbbabba', '.abccbbcba', 'abcccbcba.', 'abcdccdcba', 'abcddddcba', '.abcddcbba', '.abcdccba.', '.abbccbba.', '..aabbaa..'],\n    ['.......a..', '.a....aa..', '.aa...aba.', '.aba.abba.', 'abba.abbba', 'abbaabcbba', '.abbbbccba', '.abcbccba.', 'abccccdba.', 'abcdddcba.', 'abcddccba.', '.abcdcbba.', '..abcbbaa.', '...aabaa..'],\n  ].map((rows, i) => ({ at: [i * 10, 0], pixels: rows, legend: { a: 'a', b: 'b', c: 'c', d: 'd' } })),\n});\n\nexport const WORLD_MODELS = [soldierBeret, soldierHelmet, soldierCloth, ines, dov, mags, odile, tibor, vance, ansa, harrow, bakr, civilian, rifleNpc, wheel, pickup, technical, cargoTruck, tanker, locomotive, flatcar, boxcar, handcar, shack, hut, barracks, office, schoolroom, bunker, watchtower, sandbags, boomGate, fuelTank, oilDrum, silo, waterTower, pumpStation, bypassValve, clinicTent, platformM, signalMast, trigPillar, trigPillarBig, radioMast, headframe, sluiceHouse, spoilHeap, cage, termiteMound, obsDome, rail, gunRack, locker, clothPost, mineSign, cistern, fortWall, fortGate, bridgeRoad, bridgeRail, stoneCase, medCrate, chargeWorld, pickupGun, projectile, wreck, hollowTree, acaciaA, acaciaB, acaciaC, bottleTree, scorchedA, scorchedB, cropClump, gazelle, vulture];\nexport const CATALOG = new ModelCatalog([...MODEL_LIBRARY.all(), ...WORLD_MODELS]);\nEOF\ntimeout 110 node check.mjs --sheets src/art/models.js 2>&1 | grep -v '^$' | cut -c1-170 | grep -iv 'hidden inside\\|coplanar\\|too close in lightness\\|floating more\\|over 40%' | head -50","description":"Write world models and run the sheet checker"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10916,"cache_read_input_tokens":255632,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10916},"output_tokens":10,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"f3aa3aa9-e15a-4d74-9b2a-1039285b43b5","timestamp":"2026-11-05T23:33:58.973Z","request_id":"req_011CgkemS5RBEVUS3bkMtBq3","wire_tool_inputs":{"toolu_01Qjr9oqWirQNCaXrdacEY2Y":{"command":"sed -i \"s/bands: \\[{ top: 1000, color: 0xef7d57 }\\]/bands: [{ below: 1000, color: 0xef7d57 }]/\" src/world/terrain.js\ncat > src/art/models.js <<'EOF'\n// World art, as plain data (ASSETS.md). `node check.mjs --sheets src/art/models.js` draws all of it.\nimport { model, MODEL_LIBRARY, ModelCatalog, rowOf, around, textureDef } from '../../pixel-engine.js';\n\n// ---------- People, all on the hero rig ----------\nconst limb = (name, len, w, c, kids = [], at = [0, 0, 0]) => ({ group: [{ box: [w, len, w], at: [0, -len / 2, 0], c }, ...kids], at, pivot: true, name });\nconst foot = (name) => ({ group: [{ box: [0.12, 0.1, 0.26], at: [0, -0.05, 0.05], c: 'boot' }], at: [0, -0.22, 0], pivot: true, name });\nconst PEOPLE_PAL = { cloth: 'slate', dark: 'night', skin: 'plum', boot: 'ink', hat: 'navy', strap: 'white', acc: 'sand' };\nexport function person(id, about, { head = [], torso = [], hipParts = [], palette = {}, armW = 0.11 } = {}) {\n  return model({\n    id, about, tags: ['actor'], floats: true, collider: 'none',\n    palette: { ...PEOPLE_PAL, ...palette },\n    parts: [{\n      group: [\n        { box: [0.34, 0.2, 0.2], at: [0, 0.06, 0], c: 'dark' },\n        ...hipParts,\n        { group: [\n          { box: [0.38, 0.5, 0.22], at: [0, 0.25, 0], c: 'cloth' },\n          ...torso,\n          { group: [{ box: [0.2, 0.22, 0.2], at: [0, 0.11, 0], c: 'skin' }, ...head], at: [0, 0.52, 0], pivot: true, name: 'Head' },\n          limb('ArmR', 0.25, armW, 'cloth', [limb('ForearmR', 0.16, 0.09, 'cloth', [limb('HandR', 0.08, 0.08, 'skin', [], [0, -0.16, 0])], [0, -0.25, 0])], [-0.25, 0.47, 0]),\n          limb('ArmL', 0.25, armW, 'cloth', [limb('ForearmL', 0.16, 0.09, 'cloth', [limb('HandL', 0.08, 0.08, 'skin', [], [0, -0.16, 0])], [0, -0.25, 0])], [0.25, 0.47, 0]),\n        ], at: [0, 0.04, 0], pivot: true, name: 'Torso' },\n        limb('LegR', 0.3, 0.13, 'dark', [limb('ShinR', 0.22, 0.11, 'dark', [foot('FootR')], [0, -0.3, 0])], [-0.14, 0, 0]),\n        limb('LegL', 0.3, 0.13, 'dark', [limb('ShinL', 0.22, 0.11, 'dark', [foot('FootL')], [0, -0.3, 0])], [0.14, 0, 0]),\n      ], at: [0, 0.62, 0], pivot: true, name: 'Pelvis',\n    }],\n  });\n}\nconst strap = { box: [0.06, 0.56, 0.24], at: [0.1, 0.25, 0], rot: [0, 0, 28], c: 'strap' };\nconst armband = { box: [0.13, 0.05, 0.13], at: [0.25, 0.36, 0], c: 'strap' };\nconst beret = [{ box: [0.24, 0.07, 0.24], at: [0.01, 0.25, 0], rot: [0, 0, -8], c: 'hat' }];\nconst helmet = [{ ball: [0.28, 0.16, 0.28], at: [0, 0.25, 0], half: true, c: 'hat' }];\nconst headcloth = [{ box: [0.23, 0.1, 0.23], at: [0, 0.2, 0], c: 'hat' }, { box: [0.12, 0.16, 0.05], at: [0, 0.1, -0.12], c: 'hat' }];\nexport const soldierBeret = person('soldier-beret', 'Soldier, beret', { head: beret, torso: [strap, armband] });\nexport const soldierHelmet = person('soldier-helmet', 'Soldier, steel helmet', { head: helmet, torso: [strap, armband] });\nexport const soldierCloth = person('soldier-cloth', 'Soldier, headcloth', { head: headcloth, torso: [strap] });\nexport const FACTION_PALETTES = {\n  concord: { cloth: 'slate', dark: 'night', hat: 'navy', strap: 'white', boot: 'ink' },\n  harvest: { cloth: 'sand', dark: 'orange', hat: 'red', strap: 'red', boot: 'plum' },\n  deserter: { cloth: 'mist', dark: 'plum', hat: 'night', strap: 'slate', boot: 'ink' },\n};\nexport const SKINS = ['plum', 'orange', 'red', 'sand'];\nexport const ines = person('ines', 'Ines: flight cap, sunglasses, sand jacket', { palette: { cloth: 'sand', dark: 'teal', skin: 'orange', hat: 'night', acc: 'ink' }, head: [{ box: [0.24, 0.08, 0.22], at: [0, 0.25, 0], c: 'hat' }, { box: [0.2, 0.05, 0.06], at: [0, 0.14, 0.1], c: 'acc' }], torso: [{ box: [0.4, 0.14, 0.24], at: [0, 0.44, 0], c: 'hat' }] });\nexport const dov = person('dov', 'Dov: bald, bandoliers, bad left hand', { palette: { cloth: 'night', dark: 'slate', skin: 'sand', strap: 'orange', acc: 'red' }, torso: [{ box: [0.07, 0.56, 0.24], at: [0.1, 0.25, 0], rot: [0, 0, 28], c: 'strap' }, { box: [0.07, 0.56, 0.24], at: [-0.1, 0.25, 0], rot: [0, 0, -28], c: 'strap' }, { box: [0.3, 0.1, 0.24], at: [0, 0.1, 0], c: 'acc' }] });\nexport const mags = person('mags', 'Mags: braids, olive vest, satchel with a green cross', { palette: { cloth: 'green', dark: 'night', skin: 'plum', hat: 'ink', strap: 'sand', acc: 'white' }, head: [{ box: [0.22, 0.08, 0.22], at: [0, 0.22, 0], c: 'hat' }, { box: [0.07, 0.24, 0.07], at: [0.1, 0.05, -0.08], c: 'hat' }, { box: [0.07, 0.24, 0.07], at: [-0.1, 0.05, -0.08], c: 'hat' }], hipParts: [{ box: [0.16, 0.2, 0.08], at: [0.22, 0.05, 0], c: 'acc' }], torso: [strap] });\nexport const odile = person('odile', 'Sister Odile: veil and cigarette', { palette: { cloth: 'white', dark: 'mist', skin: 'sand', hat: 'navy', acc: 'green', strap: 'green' }, head: [{ box: [0.26, 0.26, 0.26], at: [0, 0.1, -0.03], c: 'hat' }, { box: [0.2, 0.2, 0.05], at: [0, 0.11, 0.105], c: 'skin' }, { box: [0.1, 0.02, 0.1], at: [0.03, 0.05, 0.16], c: 'cloth' }], torso: [{ box: [0.14, 0.04, 0.03], at: [0, 0.36, 0.12], c: 'acc' }, { box: [0.04, 0.14, 0.03], at: [0, 0.36, 0.12], c: 'acc' }] });\nexport const tibor = person('tibor', 'Tibor the gun seller: leather apron', { palette: { cloth: 'mist', dark: 'night', skin: 'orange', acc: 'plum' }, torso: [{ box: [0.34, 0.54, 0.05], at: [0, 0.24, 0.12], c: 'acc' }], hipParts: [{ box: [0.3, 0.22, 0.05], at: [0, -0.06, 0.12], c: 'acc' }] });\nexport const vance = person('vance', 'Colonel Vance: peaked cap and medals', { palette: { cloth: 'navy', dark: 'night', skin: 'sand', hat: 'navy', strap: 'white', acc: 'orange' }, head: [{ box: [0.26, 0.06, 0.3], at: [0, 0.24, 0.03], c: 'dark' }, { box: [0.22, 0.09, 0.22], at: [0, 0.29, 0], c: 'hat' }], torso: [{ box: [0.12, 0.05, 0.03], at: [0.09, 0.38, 0.12], c: 'acc' }, { box: [0.12, 0.05, 0.03], at: [0.09, 0.31, 0.12], c: 'strap' }] });\nexport const ansa = person('ansa', 'Mother Ansa: headscarf and spectacles', { palette: { cloth: 'orange', dark: 'red', skin: 'plum', hat: 'red', acc: 'white' }, head: [{ box: [0.24, 0.14, 0.24], at: [0, 0.2, -0.01], c: 'hat' }, { box: [0.18, 0.04, 0.03], at: [0, 0.12, 0.11], c: 'acc' }], hipParts: [{ box: [0.38, 0.24, 0.26], at: [0, -0.12, 0], c: 'dark' }] });\nexport const harrow = person('harrow', 'Emil Harrow: blanket and wide hat', { palette: { cloth: 'plum', dark: 'night', skin: 'mist', hat: 'ink', acc: 'red' }, head: [{ cyl: [0.5, 0.05, 0.5], at: [0, 0.22, 0], c: 'hat' }, { cyl: [0.22, 0.12, 0.22], at: [0, 0.28, 0], c: 'hat' }], torso: [{ box: [0.46, 0.46, 0.3], at: [0, 0.28, 0], c: 'cloth' }, { box: [0.47, 0.06, 0.31], at: [0, 0.3, 0], c: 'acc' }] });\nexport const bakr = person('bakr', 'Old Bakr the driver: cap and waistcoat', { palette: { cloth: 'teal', dark: 'navy', skin: 'plum', hat: 'navy', acc: 'sand' }, head: [{ cyl: [0.26, 0.09, 0.26], at: [0, 0.26, 0], c: 'hat' }, { box: [0.16, 0.06, 0.03], at: [0, 0.05, 0.1], c: 'acc' }], torso: [{ box: [0.4, 0.34, 0.24], at: [0, 0.3, 0], c: 'dark' }] });\nexport const civilian = person('civilian', 'A civilian of the Kettle', { palette: { cloth: 'sand', dark: 'plum', skin: 'plum', hat: 'orange', boot: 'night' }, head: [{ box: [0.22, 0.05, 0.22], at: [0, 0.23, 0], c: 'hat' }] });\nexport const CIV_PALETTES = [{ cloth: 'sand', dark: 'plum', hat: 'orange', skin: 'plum' }, { cloth: 'teal', dark: 'night', hat: 'white', skin: 'orange' }, { cloth: 'red', dark: 'slate', hat: 'sand', skin: 'plum' }, { cloth: 'mist', dark: 'navy', hat: 'teal', skin: 'red' }];\n\n// NPC gear\nexport const rifleNpc = model({ id: 'rifle-npc', about: 'A soldier\\'s rifle, seen at a distance', tags: ['prop'], floats: true, collider: 'none', palette: { wood: 'red', iron: 'ink' }, parts: [{ box: [0.05, 0.08, 0.72], at: [0, 0, 0.2], c: 'iron' }, { box: [0.06, 0.1, 0.24], at: [0, -0.01, -0.12], c: 'wood' }, { box: [0.05, 0.16, 0.07], at: [0, -0.11, 0.14], rot: [12, 0, 0], c: 'iron' }] });\nexport const wheel = model({ id: 'wheel', about: 'A truck wheel', tags: ['vehicle'], floats: true, collider: 'none', palette: { tyre: 'ink', hub: 'mist' }, parts: [{ cyl: [0.84, 0.26, 0.84], at: [0, 0, 0], rot: [0, 0, 90], c: 'tyre' }, { cyl: [0.4, 0.28, 0.4], at: [0, 0, 0], rot: [0, 0, 90], c: 'hub' }] });\n\n// ---------- Vehicles. +Z is the front, origin at the chassis centre ----------\nconst cab = (y = 0.45) => [\n  { box: [1.74, 0.5, 1.5], at: [0, y + 0.15, 0.3], c: 'paint' },\n  { box: [1.6, 0.56, 1.1], at: [0, y + 0.66, 0.1], c: 'paint2' },\n  { box: [1.5, 0.4, 0.06], at: [0, y + 0.68, 0.66], rot: [-10, 0, 0], c: 'glass' },\n  { box: [1.64, 0.3, 0.9], at: [0, y + 0.72, 0.05], c: 'glass' },\n  { box: [1.66, 0.08, 1.16], at: [0, y + 0.98, 0.1], c: 'paint' },\n];\nconst nose = (y = 0.45) => [\n  { box: [1.74, 0.56, 1.1], at: [0, y - 0.08, 1.5], c: 'paint' },\n  { box: [1.5, 0.1, 0.95], at: [0, y + 0.24, 1.46], c: 'paint2', name: 'bonnet' },\n  { box: [1.76, 0.2, 0.1], at: [0, y - 0.28, 2.1], c: 'iron' },\n  { box: [1.2, 0.34, 0.06], at: [0, y - 0.04, 2.06], c: 'iron' },\n  { mirror: [{ box: [0.2, 0.2, 0.06], at: [0.66, y + 0.02, 2.07], c: 'lamp', glow: true }], axis: 'x' },\n];\nconst bed = () => [{ box: [1.8, 0.46, 2.2], at: [0, 0.05, -1.2], c: 'paint' }, { box: [1.9, 0.5, 0.08], at: [0, 0.5, -2.27], c: 'paint2' }, { mirror: [{ box: [0.08, 0.44, 2.2], at: [0.91, 0.47, -1.2], c: 'paint2' }], axis: 'x' }, { box: [1.74, 0.06, 2.1], at: [0, 0.3, -1.2], c: 'iron' }];\nconst axles = [{ box: [2.0, 0.14, 0.14], at: [0, -0.32, 1.4], c: 'iron' }, { box: [2.0, 0.14, 0.14], at: [0, -0.32, -1.4], c: 'iron' }, { box: [0.8, 0.2, 4.2], at: [0, -0.26, 0], c: 'iron' }];\nconst VEH_PAL = { paint: 'sand', paint2: 'orange', glass: 'night', iron: 'ink', lamp: 'white', accent: 'red', hub: 'mist' };\nexport const pickup = model({ id: 'pickup', about: 'A worn pickup, bed open, paint gone', tags: ['vehicle'], floats: true, collider: 'none', palette: VEH_PAL, parts: [...cab(), ...nose(), ...bed(), ...axles] });\nexport const technical = model({ id: 'technical', about: 'A pickup with a machine gun on a pintle', tags: ['vehicle'], floats: true, collider: 'none', palette: { ...VEH_PAL, paint: 'slate', paint2: 'night' }, parts: [...cab(), ...nose(), ...bed(), ...axles, { cyl: [0.14, 1.1, 0.14], at: [0, 0.9, -1.1], c: 'iron' }, { group: [{ box: [0.14, 0.2, 0.6], at: [0, 0, 0], c: 'iron' }, { box: [0.08, 0.08, 1.2], at: [0, 0.02, 0.8], c: 'iron' }, { box: [0.3, 0.3, 0.26], at: [0.2, -0.06, 0.04], c: 'accent' }], at: [0, 1.5, -1.1], pivot: true, name: 'Gun' }] });\nexport const cargoTruck = model({ id: 'cargo-truck', about: 'A heavy flatbed truck with slatted sides', tags: ['vehicle'], floats: true, collider: 'none', palette: { ...VEH_PAL, paint: 'teal', paint2: 'mist' }, parts: [...cab(0.6), ...nose(0.6), { box: [2.0, 0.2, 3.6], at: [0, 0.34, -1.5], c: 'iron' }, { mirror: [{ box: [0.08, 0.9, 3.6], at: [0.98, 0.9, -1.5], c: 'paint2' }], axis: 'x' }, { box: [2.04, 0.9, 0.08], at: [0, 0.9, -3.3], c: 'paint2' }, ...rowOf([{ box: [1.9, 0.1, 0.1], at: [0, 1.4, 0], c: 'iron' }], { n: 4, step: [0, 0, -1.1], at: [0, 0, -0.4] }), ...axles] });\nexport const tanker = model({ id: 'tanker', about: 'A fuel tanker: a long drum on a truck', tags: ['vehicle'], floats: true, collider: 'none', palette: { ...VEH_PAL, paint: 'red', paint2: 'mist' }, parts: [...cab(0.6), ...nose(0.6), { cyl: [1.8, 3.6, 1.8], at: [0, 1.24, -1.6], rot: [90, 0, 0], c: 'paint2' }, { box: [0.3, 0.12, 0.3], at: [0, 2.16, -1.6], c: 'iron' }, { box: [1.86, 0.26, 0.5], at: [0, 1.28, -1.6], c: 'accent' }, ...axles] });\nexport const WRECK_PAL = { paint: 'ink', paint2: 'night', glass: 'ink', iron: 'night', lamp: 'ink', accent: 'night' };\nexport const locomotive = model({ id: 'locomotive', about: 'An old goods diesel, flat nose, one lamp', tags: ['vehicle'], floats: true, collider: 'none', palette: { body: 'navy', trim: 'sand', iron: 'ink', glass: 'cyan', lamp: 'white' }, parts: [{ box: [2.5, 0.5, 10], at: [0, 1.1, 0], c: 'iron' }, { box: [2.0, 1.7, 5.6], at: [0, 2.2, 1.6], c: 'body' }, { box: [2.5, 2.3, 2.8], at: [0, 2.5, -2.6], c: 'body' }, { box: [2.56, 0.2, 2.86], at: [0, 3.7, -2.6], c: 'trim' }, { box: [2.56, 0.7, 2.0], at: [0, 2.9, -2.6], c: 'glass' }, { cyl: [0.5, 0.8, 0.5], at: [0, 3.4, 2.6], c: 'iron' }, { box: [0.5, 0.3, 0.08], at: [0, 2.7, 4.42], c: 'lamp', glow: true }, { box: [2.56, 0.2, 10.04], at: [0, 1.4, 0], c: 'trim' }, ...rowOf([{ box: [2.4, 0.5, 0.9], at: [0, 0.5, 0], c: 'iron' }], { n: 3, step: [0, 0, 3.4], at: [0, 0, -3.4] })] });\nexport const flatcar = model({ id: 'flatcar', about: 'A goods flatcar with stake sides', tags: ['vehicle'], floats: true, collider: 'none', palette: { deck: 'orange', iron: 'ink', stake: 'red' }, parts: [{ box: [2.5, 0.28, 8], at: [0, 1.15, 0], c: 'deck' }, { box: [2.2, 0.4, 7.4], at: [0, 0.85, 0], c: 'iron' }, ...rowOf([{ box: [2.4, 0.5, 0.9], at: [0, 0.4, 0], c: 'iron' }], { n: 2, step: [0, 0, 5.4], at: [0, 0, -2.7] }), { mirror: rowOf([{ box: [0.1, 0.8, 0.1], at: [1.2, 1.7, 0], c: 'stake' }], { n: 4, step: [0, 0, 2.2], at: [0, 0, -3.3] }), axis: 'x' }] });\nexport const boxcar = model({ id: 'boxcar', about: 'A rust-red boxcar with a sliding door', tags: ['vehicle'], floats: true, collider: 'none', palette: { body: 'red', roof: 'night', iron: 'ink', door: 'plum' }, parts: [{ box: [2.4, 2.4, 8], at: [0, 2.3, 0], c: 'body' }, { box: [2.6, 0.14, 8.1], at: [0, 3.56, 0], c: 'roof' }, { box: [2.44, 1.8, 1.9], at: [0, 2.2, 0], c: 'door' }, { box: [2.2, 0.4, 7.4], at: [0, 0.9, 0], c: 'iron' }, ...rowOf([{ box: [2.4, 0.5, 0.9], at: [0, 0.4, 0], c: 'iron' }], { n: 2, step: [0, 0, 5.4], at: [0, 0, -2.7] })] });\nexport const handcar = model({ id: 'handcar', about: 'A rail handcar abandoned at a halt', tags: ['vehicle'], palette: { deck: 'red', iron: 'ink' }, parts: [{ box: [1.5, 0.15, 2], at: [0, 0.5, 0], c: 'deck' }, { box: [0.14, 0.9, 0.14], at: [0, 1, 0], c: 'iron' }, { box: [1.3, 0.1, 0.1], at: [0, 1.46, 0], rot: [0, 90, 12], c: 'iron' }, ...rowOf([{ box: [1.5, 0.3, 0.3], at: [0, 0.2, 0], c: 'iron' }], { n: 2, step: [0, 0, 1.3], at: [0, 0, -0.65] })] });\n\n// ---------- Buildings and props ----------\nconst TIN = { wall: 'slate', wall2: 'night', roof: 'mist', roof2: 'plum', frame: 'ink', accent: 'red' };\nconst wallsOpen = ({ w, d, h, door = 1.3, t = 0.14, c = 'wall' }) => [\n  { box: [w, h, t], at: [0, h / 2, -d / 2], c },\n  { mirror: [{ box: [t, h, d], at: [w / 2, h / 2, 0], c }], axis: 'x' },\n  { box: [(w - door) / 2, h, t], at: [(w + door) / 4, h / 2, d / 2], c },\n  { box: [(w - door) / 2, h, t], at: [-(w + door) / 4, h / 2, d / 2], c },\n  { box: [door + 0.1, 0.5, t], at: [0, h - 0.25, d / 2], c, collide: false },\n];\nconst tinRoof = (w, d, y) => [{ box: [w + 0.5, 0.1, d + 0.5], at: [0, y, 0], rot: [4, 0, 0], c: 'roof' }, ...rowOf([{ box: [0.1, 0.06, d + 0.5], at: [0, y + 0.07, 0], rot: [4, 0, 0], c: 'roof2' }], { n: 5, step: [(w + 0.4) / 4, 0, 0], at: [-(w + 0.4) / 2, 0, 0] })];\nexport const shack = model({ id: 'shack', about: 'Tin-roofed shack with an open doorway', tags: ['building'], collider: 'parts', palette: TIN, parts: [...wallsOpen({ w: 6, d: 5, h: 2.5 }), ...tinRoof(6, 5, 2.56), { box: [1.0, 0.7, 0.05], at: [-2, 1.5, 2.54], c: 'frame', collide: false }] });\nexport const hut = model({ id: 'hut', about: 'Round thatched village hut', tags: ['building'], collider: 'cyl', palette: { wall: 'orange', roof: 'sand', roof2: 'red', frame: 'ink' }, parts: [{ cyl: [3.6, 2, 3.6], at: [0, 1, 0], seg: 10, c: 'wall' }, { cone: [4.6, 1.8, 4.6], at: [0, 2.9, 0], seg: 10, c: 'roof' }, { box: [0.8, 1.5, 0.05], at: [0, 0.75, 1.8], c: 'frame' }] });\nexport const barracks = model({ id: 'barracks', about: 'Long concrete barracks with a tin roof', tags: ['building'], collider: 'parts', palette: { wall: 'mist', wall2: 'slate', roof: 'slate', roof2: 'night', frame: 'ink' }, parts: [...wallsOpen({ w: 14, d: 6, h: 3, door: 1.6 }), ...tinRoof(14, 6, 3.06), { box: [14.1, 0.5, 6.1], at: [0, 0.25, 0], c: 'wall2', collide: false }, ...rowOf([{ box: [1.2, 0.8, 0.05], at: [0, 1.9, 3.06], c: 'frame', collide: false }], { n: 2, step: [8, 0, 0], at: [-4, 0, 0] })] });\nexport const office = model({ id: 'office', about: 'The Colonel\\'s colonial office with a veranda', tags: ['building'], collider: 'parts', palette: { wall: 'white', wall2: 'mist', roof: 'red', roof2: 'plum', frame: 'night', wood: 'orange' }, parts: [...wallsOpen({ w: 9, d: 7, h: 3.2, door: 1.6 }), ...tinRoof(11, 9, 3.3), ...rowOf([{ box: [0.2, 3.2, 0.2], at: [0, 1.6, 4.4], c: 'frame' }], { n: 4, step: [3.2, 0, 0], at: [-4.8, 0, 0] }), { box: [2.6, 0.82, 1.1], at: [0, 0.41, 1.8], c: 'wood' }] });\nexport const schoolroom = model({ id: 'schoolroom', about: 'Ansa\\'s schoolroom: blackboard, tin roof', tags: ['building'], collider: 'parts', palette: { wall: 'orange', wall2: 'red', roof: 'mist', roof2: 'slate', frame: 'ink', board: 'night', chalk: 'white' }, parts: [...wallsOpen({ w: 8, d: 6, h: 2.8, door: 1.5 }), ...tinRoof(8, 6, 2.86), { box: [3, 1.2, 0.08], at: [0, 1.6, -2.88], c: 'board', collide: false }, { box: [1.4, 0.05, 0.02], at: [-0.2, 1.8, -2.82], c: 'chalk', collide: false }, ...rowOf([{ box: [1, 0.5, 0.5], at: [0, 0.25, 0], c: 'frame' }], { n: 3, step: [1.8, 0, 0], at: [-1.8, 0, -0.4] })] });\nexport const bunker = model({ id: 'bunker', about: 'Concrete ammo bunker half sunk in the earth', tags: ['building'], collider: 'box', palette: { wall: 'slate', wall2: 'night', frame: 'ink', mark: 'sand' }, parts: [{ box: [8, 2.4, 6], at: [0, 1.2, 0], c: 'wall' }, { box: [8.4, 0.4, 6.4], at: [0, 2.6, 0], c: 'wall2' }, { box: [1.8, 1.8, 0.1], at: [0, 0.9, 3.02], c: 'frame' }, { box: [2.6, 0.3, 0.1], at: [0, 2.0, 3.04], c: 'mark' }] });\nexport const watchtower = model({ id: 'watchtower', about: 'Timber watchtower with a tin hat', tags: ['building'], collider: 'parts', palette: { wood: 'red', wood2: 'plum', roof: 'mist', sand: 'sand' }, parts: [{ mirror: [{ box: [0.2, 5, 0.2], at: [1.2, 2.5, 1.2], c: 'wood' }, { box: [0.2, 5, 0.2], at: [1.2, 2.5, -1.2], c: 'wood' }], axis: 'x' }, { box: [3.2, 0.2, 3.2], at: [0, 5, 0], c: 'wood2' }, { box: [3.2, 0.8, 0.1], at: [0, 5.5, 1.55], c: 'sand' }, { box: [3.2, 0.8, 0.1], at: [0, 5.5, -1.55], c: 'wood2' }, { mirror: [{ box: [0.1, 0.8, 3.2], at: [1.55, 5.5, 0], c: 'wood2' }], axis: 'x' }, { mirror: [{ box: [0.14, 1.8, 0.14], at: [1.4, 6.9, 1.4], c: 'wood' }, { box: [0.14, 1.8, 0.14], at: [1.4, 6.9, -1.4], c: 'wood' }], axis: 'x' }, { box: [3.8, 0.12, 3.8], at: [0, 7.85, 0], rot: [4, 0, 0], c: 'roof' }, { box: [3.3, 0.1, 0.1], at: [0, 2.5, 1.2], rot: [0, 0, 40], c: 'wood2', collide: false }, { box: [3.3, 0.1, 0.1], at: [0, 2.5, -1.2], rot: [0, 0, -40], c: 'wood2', collide: false }] });\nexport const sandbags = model({ id: 'sandbags', about: 'A run of stacked sandbags', tags: ['prop', 'cover'], collider: 'box', palette: { bag: 'sand', bag2: 'orange' }, parts: [...rowOf([{ box: [0.74, 0.3, 0.46], at: [0, 0.15, 0], c: 'bag' }], { n: 5, step: [0.76, 0, 0], at: [-1.52, 0, 0] }), ...rowOf([{ box: [0.74, 0.3, 0.46], at: [0, 0.46, 0], c: 'bag2' }], { n: 4, step: [0.76, 0, 0], at: [-1.14, 0, 0] }), ...rowOf([{ box: [0.74, 0.3, 0.46], at: [0, 0.77, 0], c: 'bag' }], { n: 3, step: [0.76, 0, 0], at: [-0.76, 0, 0] })] });\nexport const boomGate = model({ id: 'boom-gate', about: 'A red and white checkpoint barrier', tags: ['prop'], collider: 'none', palette: { post: 'night', arm: 'white', band: 'red', weight: 'ink' }, parts: [{ box: [0.4, 1.2, 0.4], at: [-4.2, 0.6, 0], c: 'post' }, { box: [8, 0.14, 0.14], at: [0, 1.15, 0], c: 'arm' }, ...rowOf([{ box: [0.8, 0.16, 0.16], at: [0, 1.15, 0], c: 'band' }], { n: 4, step: [1.8, 0, 0], at: [-2.4, 0, 0] }), { box: [0.8, 0.4, 0.3], at: [-4.9, 1.15, 0], c: 'weight' }] });\nexport const fuelTank = model({ id: 'fuel-tank', about: 'A big riveted fuel tank on legs', tags: ['prop'], collider: 'cyl', palette: { tank: 'mist', tank2: 'slate', band: 'red', leg: 'ink', pipe: 'night' }, parts: [{ cyl: [6, 5, 6], at: [0, 3.3, 0], seg: 12, c: 'tank' }, { cyl: [6.1, 0.3, 6.1], at: [0, 3.4, 0], seg: 12, c: 'band' }, { cone: [6, 0.8, 6], at: [0, 6.2, 0], seg: 12, c: 'tank2' }, ...around([{ box: [0.4, 1.0, 0.4], at: [0, 0.5, 2.2], c: 'leg' }], { n: 4 }), { box: [0.2, 0.2, 2], at: [0, 0.8, 3.6], c: 'pipe' }] });\nexport const oilDrum = model({ id: 'oil-drum', about: 'A dented red oil drum', tags: ['prop'], collider: 'cyl', palette: { drum: 'red', band: 'orange', top: 'night' }, parts: [{ cyl: [0.62, 0.9, 0.62], at: [0, 0.45, 0], c: 'drum' }, { cyl: [0.66, 0.06, 0.66], at: [0, 0.3, 0], c: 'band' }, { cyl: [0.66, 0.06, 0.66], at: [0, 0.6, 0], c: 'band' }, { cyl: [0.56, 0.02, 0.56], at: [0, 0.91, 0], c: 'top' }] });\nexport const silo = model({ id: 'silo', about: 'A grain silo with a cone hat', tags: ['building'], collider: 'cyl', palette: { wall: 'mist', wall2: 'slate', roof: 'night', band: 'orange' }, parts: [{ cyl: [7, 11, 7], at: [0, 5.5, 0], seg: 12, c: 'wall' }, { cyl: [7.1, 0.3, 7.1], at: [0, 3.5, 0], seg: 12, c: 'wall2' }, { cyl: [7.1, 0.3, 7.1], at: [0, 7.5, 0], seg: 12, c: 'band' }, { cone: [7.5, 1.8, 7.5], at: [0, 11.9, 0], seg: 12, c: 'roof' }] });\nexport const waterTower = model({ id: 'water-tower', about: 'An iron water tower on four legs', tags: ['building'], collider: 'parts', palette: { iron: 'night', tank: 'teal', tank2: 'slate', rust: 'red' }, parts: [{ mirror: [{ box: [0.3, 12, 0.3], at: [2.4, 6, 2.4], c: 'iron' }, { box: [0.3, 12, 0.3], at: [2.4, 6, -2.4], c: 'iron' }], axis: 'x' }, { box: [5.4, 0.14, 0.14], at: [0, 6, 2.4], c: 'iron', collide: false }, { box: [5.4, 0.14, 0.14], at: [0, 6, -2.4], c: 'iron', collide: false }, { cyl: [7, 4, 7], at: [0, 14, 0], seg: 12, c: 'tank' }, { cyl: [7.1, 0.3, 7.1], at: [0, 13.2, 0], seg: 12, c: 'rust' }, { cone: [7.4, 1, 7.4], at: [0, 16.5, 0], seg: 12, c: 'tank2' }] });\nexport const pumpStation = model({ id: 'pump-station', about: 'A brick pump house over a fat pipe', tags: ['building'], collider: 'box', palette: { wall: 'red', wall2: 'plum', roof: 'slate', pipe: 'teal', iron: 'ink' }, parts: [{ box: [8, 4, 6], at: [0, 2, 0], c: 'wall' }, { box: [8.6, 0.3, 6.6], at: [0, 4.15, 0], c: 'roof' }, { box: [1.6, 2.2, 0.1], at: [0, 1.1, -3.02], c: 'iron' }, { cyl: [1.2, 8, 1.2], at: [-6, 0.8, 0], rot: [0, 0, 90], c: 'pipe' }, { box: [1.4, 1.8, 1.4], at: [-3.8, 0.9, -3.4], c: 'wall2' }] });\nexport const bypassValve = model({ id: 'bypass-valve', about: 'A red hand wheel on a bypass pipe', tags: ['prop'], collider: 'none', palette: { pipe: 'teal', wheel: 'red' }, parts: [{ cyl: [0.4, 1.2, 0.4], at: [0, 0.6, 0], c: 'pipe' }, { torus: [0.8, 0.1, 0.8], at: [0, 1.25, 0], c: 'wheel' }] });\nexport const clinicTent = model({ id: 'clinic-tent', about: 'A long canvas clinic tent with a green cross', tags: ['building'], collider: 'parts', palette: { canvas: 'white', canvas2: 'mist', cross: 'green', pole: 'night' }, parts: [{ wedge: [7, 1.3, 2.5], at: [0, 2.25, -1.25], rot: [0, 180, 0], c: 'canvas', collide: false }, { wedge: [7, 1.3, 2.5], at: [0, 2.25, 1.25], c: 'canvas2', collide: false }, { box: [7, 1.6, 0.1], at: [0, 0.8, -2.5], c: 'canvas2' }, { box: [0.1, 1.6, 5], at: [-3.5, 0.8, 0], c: 'canvas2' }, { box: [0.1, 1.6, 2], at: [3.5, 0.8, -1.5], c: 'canvas2' }, { box: [1.3, 0.34, 0.06], at: [-1.6, 2.2, 1.28], rot: [-28, 0, 0], c: 'cross', collide: false }, { box: [0.34, 0.06, 1.3], at: [-1.6, 2.2, 1.28], rot: [-28, 0, 0], c: 'cross', collide: false }, { box: [0.1, 2.9, 0.1], at: [0, 1.45, 0], c: 'pole' }] });\nexport const platformM = model({ id: 'platform', about: 'A long concrete station platform', tags: ['building'], collider: 'box', palette: { top: 'mist', side: 'slate', edge: 'sand' }, parts: [{ box: [36, 0.8, 4.5], at: [0, 0.4, 0], c: 'side' }, { box: [36, 0.08, 4.6], at: [0, 0.82, 0], c: 'top' }, { box: [36, 0.03, 0.3], at: [0, 0.87, 2.1], c: 'edge' }] });\nexport const signalMast = model({ id: 'signal-mast', about: 'A railway signal with a lit lamp', tags: ['prop'], collider: 'none', palette: { mast: 'night', arm: 'white', band: 'red', lamp: 'lime' }, parts: [{ box: [0.2, 6, 0.2], at: [0, 3, 0], c: 'mast' }, { box: [1.4, 0.3, 0.08], at: [0.7, 5.5, 0], c: 'arm' }, { box: [0.3, 0.32, 0.1], at: [1.1, 5.5, 0], c: 'band' }, { box: [0.2, 0.2, 0.2], at: [0, 6.1, 0], c: 'lamp', glow: true }] });\nexport const trigPillar = model({ id: 'trig-pillar', about: 'A white stone survey pillar on a hilltop', tags: ['prop'], collider: 'box', palette: { stone: 'white', stone2: 'mist', brass: 'sand', base: 'slate' }, parts: [{ box: [1.1, 0.3, 1.1], at: [0, 0.15, 0], c: 'base' }, { cyl: [0.7, 1.2, 0.7], at: [0, 0.9, 0], top: 0.7, seg: 4, c: 'stone' }, { box: [0.32, 0.08, 0.32], at: [0, 1.54, 0], c: 'brass' }, { box: [0.3, 0.3, 0.04], at: [0, 0.9, 0.3], c: 'stone2' }] });\nexport const trigPillarBig = model({ id: 'trig-pillar-big', about: 'Harrow\\'s great survey pillar', tags: ['prop'], collider: 'box', palette: { stone: 'white', stone2: 'mist', brass: 'sand', base: 'slate' }, parts: [{ box: [2, 0.5, 2], at: [0, 0.25, 0], c: 'base' }, { cyl: [1.2, 2.8, 1.2], at: [0, 1.9, 0], top: 0.6, seg: 4, c: 'stone' }, { box: [0.5, 0.14, 0.5], at: [0, 3.36, 0], c: 'brass' }] });\nexport const radioMast = model({ id: 'radio-mast', about: 'A guyed radio mast', tags: ['prop'], collider: 'none', palette: { iron: 'night', tip: 'red' }, parts: [{ cyl: [0.2, 12, 0.2], at: [0, 6, 0], c: 'iron' }, { box: [1.6, 0.08, 0.08], at: [0, 9, 0], c: 'iron' }, { box: [1.1, 0.08, 0.08], at: [0, 10.5, 0], c: 'iron' }, { box: [0.2, 0.3, 0.2], at: [0, 12.1, 0], c: 'tip', glow: true }] });\nexport const headframe = model({ id: 'headframe', about: 'A mine headframe of black iron', tags: ['building'], collider: 'parts', palette: { iron: 'night', iron2: 'ink', wheel: 'red', roof: 'slate' }, parts: [{ mirror: [{ box: [0.5, 16, 0.5], at: [3, 8, 3], rot: [8, 0, -10], c: 'iron' }, { box: [0.5, 16, 0.5], at: [3, 8, -3], rot: [-8, 0, -10], c: 'iron' }], axis: 'x' }, ...rowOf([{ box: [5.2, 0.3, 0.3], at: [0, 0, 2.4], c: 'iron2', collide: false }], { n: 3, step: [0, 4, 0], at: [0, 4, 0] }), { box: [3.4, 0.5, 3.4], at: [0, 16, 0], c: 'roof' }, { torus: [3, 0.3, 3], at: [0, 17.6, 0], rot: [90, 0, 0], c: 'wheel', collide: false }] });\nexport const sluiceHouse = model({ id: 'sluice-house', about: 'The long tin sluice house at the mine', tags: ['building'], collider: 'parts', palette: { wall: 'teal', wall2: 'slate', roof: 'mist', roof2: 'night', frame: 'ink', wood: 'orange' }, parts: [...wallsOpen({ w: 12, d: 7, h: 3.4, door: 1.8 }), ...tinRoof(12, 7, 3.46), { box: [4, 0.8, 1], at: [0, 0.4, -1], c: 'wood' }, { box: [0.6, 3, 7], at: [10, 2, 0], rot: [0, 0, -30], c: 'wall2' }] });\nexport const spoilHeap = model({ id: 'spoil-heap', about: 'A heap of mine spoil', tags: ['prop'], collider: 'hull', palette: { dirt: 'plum', dirt2: 'red' }, parts: [{ lump: [14, 6, 12], at: [0, 3, 0], seed: 3, c: 'dirt' }, { lump: [9, 3.4, 8], at: [2, 5, 1], seed: 5, c: 'dirt2' }] });\nexport const cage = model({ id: 'cage', about: 'A chain-link and pipe prisoner cage', tags: ['prop'], collider: 'none', palette: { bar: 'night', roof: 'slate', floor: 'red', door: 'sand' }, parts: [{ box: [3, 0.1, 3], at: [0, 0.05, 0], c: 'floor' }, { box: [3.1, 0.08, 3.1], at: [0, 2.3, 0], c: 'roof' }, ...rowOf([{ box: [0.07, 2.3, 0.07], at: [0, 1.15, -1.5], c: 'bar' }], { n: 7, step: [0.5, 0, 0], at: [-1.5, 0, 0] }), { mirror: rowOf([{ box: [0.07, 2.3, 0.07], at: [1.5, 1.15, 0], c: 'bar' }], { n: 6, step: [0, 0, 0.5], at: [0, 0, -1.25] }), axis: 'x' }, { group: rowOf([{ box: [0.07, 2.3, 0.07], at: [0, 1.15, 0], c: 'door' }], { n: 7, step: [0.5, 0, 0], at: [-1.5, 0, 0] }), at: [0, 0, 1.5], pivot: true, name: 'Door' }] });\nexport const termiteMound = model({ id: 'termite-mound', about: 'A red termite mound taller than a man', tags: ['nature'], collider: 'cyl', palette: { mud: 'red', mud2: 'plum' }, parts: [{ cone: [2.2, 3.2, 2.2], at: [0, 1.6, 0], seg: 7, c: 'mud' }, { cone: [1, 1.8, 1], at: [0.5, 1, 0.6], seg: 6, c: 'mud2' }, { cone: [0.8, 1.2, 0.8], at: [-0.7, 0.6, -0.2], seg: 5, c: 'mud2' }] });\nexport const obsDome = model({ id: 'obs-dome', about: 'Harrow\\'s domed trig station, one wall open to the view', tags: ['building'], collider: 'parts', palette: { wall: 'white', wall2: 'mist', dome: 'slate', frame: 'night' }, parts: [{ box: [8, 3, 0.3], at: [0, 1.5, -4], c: 'wall' }, { mirror: [{ box: [0.3, 3, 8], at: [4, 1.5, 0], c: 'wall2' }], axis: 'x' }, { mirror: [{ box: [2.4, 3, 0.3], at: [2.8, 1.5, 4], c: 'wall' }], axis: 'x' }, { ball: [9, 3.4, 9], at: [0, 4.6, 0], half: true, c: 'dome', collide: false }, { box: [1.6, 3.6, 0.2], at: [0, 5.2, 3.6], rot: [-30, 0, 0], c: 'frame', collide: false }] });\nexport const rail = model({ id: 'rail-shed', about: 'Tibor\\'s rail shed, open on one sid