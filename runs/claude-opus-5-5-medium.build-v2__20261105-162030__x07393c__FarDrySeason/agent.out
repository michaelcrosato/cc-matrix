=\"Stick/WASD move, R2/mouse fire, Square/E use, carry cases to the truck\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"icon\" href=\"data:,\">\n<title>${title}</title>\n<style>html,body{margin:0;height:100%;background:#0d0b14}#app{position:fixed;inset:0}</style>\n</head><body><div id=\"app\"></div><script type=\"module\">%BUNDLE%</script></body></html>\n`;\nconst js = execFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--target=esnext', '--legal-comments=inline', '--log-level=warning'], { maxBuffer: 1 << 29 }).toString();\nconst session = readFileSync('vendor/session.js', 'utf8');\nconst credits = readFileSync('CREDITS.md', 'utf8');\nconst licences = credits.slice(Math.max(0, credits.search(/three\\.js/i))).replace(/--/g, '- -');\nconst html = TEMPLATE.replace('%SESSION%', () => session.replace(/<\\/script/gi, '<\\\\/script')).replace('%BUNDLE%', () => js.replace(/<\\/script/gi, '<\\\\/script'))\n  + `<!--\\nLicences (Pixel Engine MIT; three.js MIT; Rapier Apache-2.0), from the kit's CREDITS.md:\\n${licences}\\n-->\\n`;\nwriteFileSync(OUT, html);\nconsole.log(`${OUT.split('/').pop()}: ${(html.length / 1048576).toFixed(1)} MB`);\nEOF\ngrep -n 'three.js\\|Rapier\\|^#' CREDITS.md | head -20; grep -n \"class FirstPersonRig\\|step(\" pixel-engine.js | head -3 | cut -c1-120; grep -o 'class [A-Za-z0-9_$]*[^{]*{[^{]\\{0,80\\}preset=\"first\"[^;]*;.\\{0,1400\\}' pixel-engine.js | head -1 | cut -c1-1800","description":"Scaffold dev folder, install Playwright, inspect first-person rig"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16253,"cache_read_input_tokens":173509,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16253},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_managemen