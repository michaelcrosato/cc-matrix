{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkfmLEnpC2fTxCFmaRBz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014wucpLTCEsKCTqgCrPbEtM","name":"Bash","input":{"command":"cat > src/actors/rig.js <<'EOF'\n// A person's view: model on the hero rig, shared compiled clips, layered upper and lower body, ragdoll on death.\nimport { buildModel, compileClips, HERO_CLIPS, HERO_RAGDOLL, HERO_RIG, Ragdoll, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { CATALOG } from '../art/models.js';\nimport { PEOPLE_CLIPS } from '../art/clips.js';\nconst { AnimationClip, AnimationMixer, LoopOnce, LoopRepeat } = THREE;\nlet CLIPS = null, LOWER = null, UPPER = null;\nconst LEGS = /^(Pelvis|Leg|Shin|Foot)/;\nconst KEEP = ['Idle', 'IdleLook', 'Walk', 'Run', 'Crouch', 'CrouchWalk', 'Crawl', 'Sit', 'SitDown', 'StandUp', 'LieIdle', 'Sleep', 'Hurt', 'HitReact', 'Death', 'Wave', 'Shout', 'Push', 'Climb'];\nexport const RIG = { ...HERO_RIG, spine: undefined };\nfunction compile(object) {\n  if (CLIPS) return;\n  const defs = [...HERO_CLIPS.filter((c) => KEEP.includes(c.name)), ...PEOPLE_CLIPS];\n  const all = compileClips(defs, RIG, object);\n  CLIPS = {}; LOWER = {}; UPPER = {};\n  for (const c of all) {\n    CLIPS[c.name] = c;\n    LOWER[c.name] = new AnimationClip(`${c.name}:L`, c.duration, c.tracks.filter((t) => LEGS.test(t.name)));\n    UPPER[c.name] = new AnimationClip(`${c.name}:U`, c.duration, c.tracks.filter((t) => !LEGS.test(t.name)));\n  }\n}\nexport const clipNames = () => Object.keys(CLIPS ?? {});\nexport class PersonView {\n  constructor(ctx, modelId, palette, { gun = false } = {}) {\n    this.ctx = ctx;\n    const b = buildModel(modelId, { catalog: CATALOG, palette });\n    this.object = b.object;\n    compile(b.object);\n    setLookLayer(this.object, 'actors');\n    b.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.frustumCulled = false; } });\n    ctx.scene.add(this.object);\n    this.mixer = new AnimationMixer(this.object);\n    this.lower = null; this.upper = null; this.full = null;\n    if (gun) { const r = buildModel('rifle-npc', { catalog: CATALOG }); const hand = this.object.getObjectByName('HandR'); r.object.position.set(0, -0.06, 0.04); r.object.rotation.x = -0.3; r.object.traverse((o) => { if (o.isMesh) o.castShadow = false; }); hand.add(r.object); this.gun = r.object; }\n  }\n  action(table, name) { return this.mixer.clipAction(table[name]); }\n  setLower(name, speed = 1) { if (this.lowerName === name) { if (this.lower) this.lower.timeScale = speed; return; } this.stopFull(); const a = this.action(LOWER, name); a.reset().setLoop(LoopRepeat, Infinity).fadeIn(0.15).play(); a.timeScale = speed; this.lower?.fadeOut(0.15); this.lower = a; this.lowerName = name; }\n  setUpper(name) { if (this.upperName === name) return; this.stopFull(); const a = this.action(UPPER, name); a.reset().setLoop(LoopRepeat, Infinity).fadeIn(0.15).play(); this.upper?.fadeOut(0.15); this.upper = a; this.upperName = name; }\n  /** One-shot on the upper body (recoil, reload, swear). */\n  flashUpper(name, duration = 0) { const a = this.action(UPPER, name); a.reset().setLoop(LoopOnce, 1).setEffectiveWeight(1).play(); a.clampWhenFinished = false; if (duration) a.timeScale = a.getClip().duration / duration; return a; }\n  /** A whole-body clip, looped or once. */\n  setFull(name, once = false) {\n    if (this.fullName === name) return;\n    this.lower?.fadeOut(0.15); this.upper?.fadeOut(0.15); this.lower = this.upper = null; this.lowerName = this.upperName = null;\n    const a = this.action(CLIPS, name);\n    a.reset().setLoop(once ? LoopOnce : LoopRepeat, once ? 1 : Infinity); a.clampWhenFinished = once; a.fadeIn(0.15).play();\n    this.full?.fadeOut(0.15); this.full = a; this.fullName = name;\n  }\n  stopFull() { if (this.full) { this.full.fadeOut(0.15); this.full = null; this.fullName = null; } }\n  place(x, y, z, yaw) { this.object.position.set(x, y, z); this.object.rotation.y = yaw; }\n  update(dt) { if (!this.doll?.active) this.mixer.update(dt); else this.doll.sync(); }\n  ragdoll(velocity) {\n    if (this.doll) return;\n    this.mixer.stopAllAction();\n    this.object.updateMatrixWorld(true);\n    try { this.doll = new Ragdoll(this.ctx.physics, this.object, HERO_RAGDOLL); this.doll.enable({ velocity }); } catch { this.doll = null; this.setFull('Death', true); }\n  }\n  freeze() { if (this.doll?.active) this.doll.disable(); }\n  dispose() { this.freeze(); this.mixer.stopAllAction(); this.ctx.scene.remove(this.object); }\n}\nEOF\ncat > src/actors/soldier.js <<'EOF'\n// Soldiers, friends and puppets. Sim and view apart: a soldier is data plus an optional view.\nimport { BehaviorTree, bt, CharacterController, THREE } from '../../pixel-engine.js';\nimport { FACTION_PALETTES, SKINS } from '../art/models.js';\nimport { BARKS } from '../content/dialogue.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp, dist2 } from '../world/geom.js';\nimport { KIND, WATER_Y } from '../world/terrain.js';\nimport { PersonView } from './rig.js';\nconst { Vector3 } = THREE;\nconst HATS = { concord: ['soldier-beret', 'soldier-helmet'], harvest: ['soldier-cloth', 'soldier-helmet'], deserter: ['soldier-cloth', 'soldier-beret'] };\nconst ROLE = { rifle: { hp: 60, speed: 4.2, burst: [3, 5], rate: 7, range: 90 }, mg: { hp: 90, speed: 3.2, burst: [6, 10], rate: 9, range: 100 }, sniper: { hp: 50, speed: 3.4, burst: [1, 1], rate: 0.6, range: 220, accuracy: 2.2 }, rocket: { hp: 70, speed: 3.6, burst: [1, 1], rate: 0.2, range: 110 }, driver: { hp: 55, speed: 4.2, burst: [3, 5], rate: 7, range: 90 } };\nconst from = new Vector3(), dirV = new Vector3(), moveV = new Vector3();\nlet nextId = 1;\nexport class Actors {\n  list = []; byId = new Map(); pathBudget = 0; dropped = []; corpses = [];\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('actors'); this.barkClock = 0; }\n  /** A soldier in the world. `def`: { faction, role, x, z, duty, site, tag, friendly, name, modelId, palette, hp } */\n  spawn(def) {\n    const game = this.game, ctx = this.ctx, role = ROLE[def.role] ?? ROLE.rifle, r = this.rng;\n    const y = game.world.land.heightAt(def.x, def.z) + (def.y ?? 0);\n    const a = {\n      id: nextId++, kind: def.kind ?? 'soldier', faction: def.faction, role: def.role ?? 'rifle', spec: role, site: def.site ?? null, tag: def.tag ?? null,\n      x: def.x, y, z: def.z, yaw: def.yaw ?? r.range(0, 6.28), homeX: def.x, homeZ: def.z, duty: def.duty ?? 'guard', friendly: !!def.friendly, buddy: def.buddy ?? null,\n      hp: (def.hp ?? role.hp) * (def.friendly ? 1 : TUNING.enemyHealth), maxHp: 0, alive: true, state: 'idle', suspicion: 0, reaction: 0, burning: 0, burnPanic: 0, lastKnown: null, searchT: 0,\n      burstLeft: 0, nextShot: 0, repositionT: r.range(1, 4), cond: r.range(20, 70), jamT: 0, moveTo: null, path: null, pathI: 0, speedWanted: 0, fireAt: null, lookAtYaw: null, target: null, panicDir: null, down: false, downT: 0, flank: false, dodgeT: 0, stationary: def.duty === 'tower', y0: def.y ?? 0, barkT: 0,\n    };\n    a.maxHp = a.hp;\n    if (!def.puppet) {\n      a.ctrl = new CharacterController(ctx.physics, { position: [def.x, y + (def.y ?? 0) * 0 + 0.05, def.z], radius: 0.3, halfHeight: 0.55, speed: role.speed, jumpSpeed: 0, gravity: def.y ? 0 : -24 });\n      if (def.y) a.ctrl.body.setTranslation({ x: def.x, y: y + 0.85, z: def.z }, true);\n      ctx.physics.tag(a.ctrl.collider, 'npc');\n      game.world.own(a.ctrl.collider, 'actor', a);\n      a.tree = this.makeTree(a);\n      a.brainPhase = (a.id * 7) % 6;\n    }\n    const pal = def.palette ?? { ...FACTION_PALETTES[def.faction], skin: r.pick(SKINS) };\n    a.view = new PersonView(ctx, def.modelId ?? r.pick(HATS[def.faction] ?? HATS.concord), pal, { gun: !def.unarmed });\n    a.view.place(a.x, y + (def.y ?? 0) * 0, a.z, a.yaw);\n    a.view.setLower('Idle'); a.view.setUpper(a.duty === 'sit' ? 'Idle' : 'AimIdle');\n    if (a.duty === 'sit') a.view.setFull('Sit');\n    this.list.push(a); this.byId.set(a.id, a);\n    return a;\n  }\n  makeTree(a) {\n    const A = (n, f) => bt.action(n, f), C = (n, f) => bt.condition(n, f);\n    return new BehaviorTree(bt.selector('soldier',\n      bt.sequence('burning', C('on fire?', (s) => s.burning > 0), A('panic', (s, dt) => this.doPanic(s, dt))),\n      bt.sequence('fire near', C('fire upwind?', (s) => this.fireNear(s)), A('flee crosswind', (s) => this.doFleeFire(s))),\n      bt.sequence('blast near', C('dodge?', (s) => s.dodgeT > 0), A('dodge', (s, dt) => this.doDodge(s, dt))),\n      bt.sequence('combat', C('target?', (s) => s.state === 'alert'), A('fight', (s, dt) => this.doCombat(s, dt))),\n      bt.sequence('search', C('searching?', (s) => s.state === 'searching'), A('search', (s, dt) => this.doSearch(s, dt))),\n      A('duty', (s, dt) => this.doDuty(s, dt)),\n    ), a);\n  }\n  /** Is this actor allowed to shoot at that target right now? */\n  hostileTo(a, t) {\n    if (t.kind === 'player') return this.game.isHostileToPlayer(a, t);\n    if (a.friendly) return !t.friendly && t.faction !== 'none';\n    if (t.friendly) return true;\n    return this.game.warOn && t.faction !== a.faction;\n  }\n  targetsOf(a) { return this.game.targetsFor(a); }\n  perceive(a, dt) {\n    if (a.burning > 0) return;\n    const game = this.game, night = game.world.isNight();\n    let best = null, bestD = 1e9, seen = 0;\n    for (const t of this.targetsOf(a)) {\n      if (!this.hostileTo(a, t) || t.hidden) continue;\n      const d = Math.hypot(t.x - a.x, t.z - a.z);\n      let range = TUNING.enemyVision * (a.role === 'sniper' ? 1.6 : 1);\n      if (t.kind === 'player') {\n        range *= t.crouched ? 0.55 : 1;\n        if (game.world.tallGrassAt(t.x, t.z) && t.crouched) range *= 0.6 / 0.55;\n        if (night && !t.lit) range *= 0.45; else if (night && t.lit) range *= 0.9;\n      } else if (night) range *= 0.6;\n      if (d > range) continue;\n      const toYaw = Math.atan2(t.x - a.x, t.z - a.z);\n      let dy = toYaw - a.yaw; dy = Math.atan2(Math.sin(dy), Math.cos(dy));\n      if (Math.abs(dy) > (60 * Math.PI) / 180 && d > 6 && a.state !== 'alert') continue;\n      if (!this.los(a, t)) continue;\n      if (d < bestD) { bestD = d; best = t; seen = 1 - d / range; }\n    }\n    a.target = best;\n    if (best) {\n      a.lastKnown = [best.x, best.z];\n      a.suspicion = clamp(a.suspicion + dt * (0.45 + seen * 1.4) * (a.state === 'alert' ? 4 : 1), 0, 1.2);\n      a.seenT = 0;\n      if (a.suspicion >= 1 && a.state !== 'alert') this.alert(a, best);\n      else if (a.suspicion > 0.2 && a.state === 'idle') a.state = 'suspicious';\n    } else {\n      a.seenT = (a.seenT ?? 0) + dt;\n      a.suspicion = Math.max(0, a.suspicion - dt * 0.25);\n      if (a.state === 'alert' && a.seenT > 5) { a.state = 'searching'; a.searchT = 20; this.bark(a, 'lost'); }\n      if (a.state === 'suspicious' && a.suspicion <= 0) a.state = 'idle';\n    }\n  }\n  alert(a, t) {\n    a.state = 'alert'; a.suspicion = 1.2; a.reaction = TUNING.enemyReaction;\n    if (t) a.lastKnown = [t.x, t.z];\n    this.bark(a, 'spotted');\n    // Squad members share the last known position.\n    for (const o of this.list) if (o !== a && o.alive && o.ctrl && o.faction === a.faction && Math.hypot(o.x - a.x, o.z - a.z) < 60 && o.state !== 'alert' && o.burning <= 0) { o.state = 'alert'; o.reaction = TUNING.enemyReaction + 0.3; o.lastKnown = a.lastKnown; o.suspicion = 1; }\n    this.game.onAlert?.(a);\n  }\n  los(a, t) {\n    from.set(a.x, a.y + 1.5, a.z);\n    const ty = t.y + (t.crouched ? 0.7 : 1.3);\n    dirV.set(t.x - a.x, ty - from.y, t.z - a.z);\n    const d = dirV.length(); dirV.divideScalar(d || 1);\n    const hit = this.ctx.physics.castRay(from, dirV, d, undefined, a.ctrl?.body);\n    if (!hit) return true;\n    if (hit.distance >= d - 0.6) return true;\n    const owner = this.game.world.owners.get(hit.collider.handle);\n    if (owner?.type === 'player' || owner?.ref === t) return true;\n    return owner?.type === 'vehicle' && t.vehicle === owner.ref;\n  }\n  hearShot(x, z, radius, faction) {\n    for (const a of this.list) {\n      if (!a.alive || !a.ctrl || a.friendly || a.burning > 0) continue;\n      if (a.state === 'alert') continue;\n      if (Math.hypot(a.x - x, a.z - z) < radius) { a.lastKnown = [x, z]; if (a.state === 'idle' || a.state === 'suspicious') { a.state = 'searching'; a.searchT = 20; } }\n    }\n    void faction;\n  }\n  fireNear(a) {\n    const f = this.game.world.fire, w = this.game.world.wind;\n    if (f.burning.length === 0) return false;\n    if (f.isBurning(a.x, a.z)) return true;\n    for (let d = 5; d <= 15; d += 5) if (f.isBurning(a.x - w.x * d, a.z - w.z * d)) return true;\n    return false;\n  }\n  doFleeFire(a) { const w = this.game.world.wind, side = a.id % 2 ? 1 : -1; a.moveTo = [a.x - w.z * side * 14 + w.x * -6, a.z + w.x * side * 14 + w.z * -6]; a.path = null; a.speedWanted = 1.25; a.fireAt = null; a.fleeingFire = 1; if (this.rng.next() < 0.02) this.bark(a, 'fire'); return 'running'; }\n  doPanic(a, dt) {\n    a.burning -= dt; a.fireAt = null;\n    if (!a.panicDir || this.rng.next() < dt * 2) { const k = this.rng.range(0, 6.28); a.panicDir = [Math.cos(k), Math.sin(k)]; }\n    a.moveTo = [a.x + a.panicDir[0] * 6, a.z + a.panicDir[1] * 6]; a.speedWanted = 1.3; a.path = null;\n    this.game.world.fire.ignite(a.x, a.z, 1);\n    this.damage(a, (a.maxHp / 5) * dt, { fire: true, by: a.burnBy, silent: true });\n    return 'running';\n  }\n  doDodge(a, dt) { a.dodgeT -= dt; a.speedWanted = 1.2; a.fireAt = null; return 'running'; }\n  doCombat(a, dt) {\n    const t = a.target;\n    a.reaction = Math.max(0, a.reaction - dt);\n    if (a.jamT > 0) { a.jamT -= dt; a.fireAt = null; a.speedWanted = 0; return 'running'; }\n    if (t) {\n      a.lookAtYaw = Math.atan2(t.x - a.x, t.z - a.z);\n      if (a.reaction <= 0 && !a.stationaryLock) {\n        const d = Math.hypot(t.x - a.x, t.z - a.z);\n        if (d < a.spec.range) { a.fireAt = t; if (a.burstLeft <= 0 && a.nextBurst <= 0) { a.burstLeft = this.rng.int(a.spec.burst[0], a.spec.burst[1]); a.nextBurst = this.rng.range(0.7, 1.8); } }\n      }\n    } else a.fireAt = null;\n    a.nextBurst = (a.nextBurst ?? 0) - dt;\n    if (a.stationary) { a.speedWanted = 0; return 'running'; }\n    a.repositionT -= dt;\n    if (a.repositionT <= 0 || (!a.moveTo && !t)) {\n      a.repositionT = this.rng.range(4, 8);\n      const lk = t ? [t.x, t.z] : a.lastKnown ?? [a.x, a.z];\n      const cover = this.findCover(a, lk);\n      if (cover) this.goTo(a, cover[0], cover[1]);\n      else if (a.id % 3 === 0) { const side = a.id % 2 ? 1 : -1, ang = Math.atan2(lk[1] - a.z, lk[0] - a.x) + side * 1.1; this.goTo(a, lk[0] - Math.cos(ang) * 22, lk[1] - Math.sin(ang) * 22); } // the flanker\n      else this.goTo(a, a.x + this.rng.range(-8, 8) + (lk[0] - a.x) * 0.25, a.z + this.rng.range(-8, 8) + (lk[1] - a.z) * 0.25);\n      a.speedWanted = 1;\n    }\n    return 'running';\n  }\n  findCover(a, threat) {\n    const site = a.site ? this.game.world.sites[a.site] : null; if (!site) return null;\n    const cover = site.coverPoints ??= (site.def.props ?? []).filter((p) => ['sandbags', 'crate', 'crate-stack', 'oil-drum', 'barrel', 'shack'].includes(p[0])).map((p) => [site.def.at[0] + p[1], site.def.at[1] + p[2]]);\n    let best = null, bd = 1e9;\n    for (const c of cover) { const d = dist2(c[0], c[1], a.x, a.z); if (d < 14 && d < bd) { const l = Math.hypot(c[0] - threat[0], c[1] - threat[1]) || 1; best = [c[0] + ((c[0] - threat[0]) / l) * 1.3, c[1] + ((c[1] - threat[1]) / l) * 1.3]; bd = d; } }\n    return best;\n  }\n  doSearch(a, dt) {\n    a.fireAt = null; a.searchT -= dt;\n    if (a.lastKnown && !a.stationary && (!a.moveTo || a.searchGo !== a.lastKnown)) { a.searchGo = a.lastKnown; this.goTo(a, a.lastKnown[0] + this.rng.range(-4, 4), a.lastKnown[1] + this.rng.range(-4, 4)); }\n    a.speedWanted = 0.7;\n    if (a.searchT <= 0) { a.state = 'idle'; a.lastKnown = null; a.moveTo = null; a.path = null; }\n    return 'running';\n  }\n  doDuty(a, dt) {\n    a.fireAt = null;\n    const night = this.game.world.isNight();\n    if (a.duty === 'patrol') {\n      a.speedWanted = 0.45;\n      if (!a.moveTo) { a.waitT = (a.waitT ?? 0) - dt; if (a.waitT <= 0) { const R = 16; this.goTo(a, a.homeX + this.rng.range(-R, R), a.homeZ + this.rng.range(-R, R)); a.waitT = this.rng.range(2, 6); } }\n    } else if (a.duty === 'follow') {\n      const p = this.game.player;\n      if (dist2(a.x, a.z, p.x, p.z) > 8) { a.moveTo = [p.x + 3, p.z + 3]; a.path = null; a.speedWanted = 1.2; } else a.moveTo = null;\n    } else if (a.duty === 'walkTo' && a.goal) { this.goTo(a, a.goal[0], a.goal[1]); a.speedWanted = a.goalSpeed ?? 1; } else { a.speedWanted = 0; }\n    a.asleep = night && a.duty === 'sit';\n    return 'running';\n  }\n  goTo(a, x, z) { a.moveTo = [x, z]; a.path = null; a.pathI = 0; a.wantPath = true; }\n  fixed(dt) {\n    const game = this.game; this.pathBudget = 2;\n    const stepPhase = game.world.stepCount % 6;\n    for (const a of this.list) {\n      if (!a.alive) continue;\n      if (a.down) { this.fixedDown(a, dt); continue; }\n      if (!a.ctrl) continue;\n      if (a.brainPhase === stepPhase) { this.perceive(a, 0.1); a.tree.tick(0.1); }\n      // Fire on this cell lights people.\n      if (a.burning <= 0 && !a.fireproof && game.world.fire.isBurning(a.x, a.z)) { a.burning = 5; a.burnPanic = 1; a.state = 'burning'; this.bark(a, 'fire', true); game.audio.scream(a); }\n      this.move(a, dt);\n      this.shoot(a, dt);\n      a.barkT -= dt;\n    }\n    for (let i = this.corpses.length - 1; i >= 0; i--) { const c = this.corpses[i]; c.t -= dt; if (c.t < 34 && !c.frozen) { c.frozen = true; c.view.freeze(); } if (c.t <= 0) { c.view.dispose(); this.corpses.splice(i, 1); } }\n  }\n  move(a, dt) {\n    const ctrl = a.ctrl; let mx = 0, mz = 0;\n    if (a.wantPath && this.pathBudget > 0 && this.game.nav && a.moveTo) {\n      a.wantPath = false; this.pathBudget--;\n      if (dist2(a.x, a.z, a.moveTo[0], a.moveTo[1]) > 14) { const p = this.game.nav.path([a.x, 0, a.z], [a.moveTo[0], 0, a.moveTo[1]]); if (p?.length) { a.path = p; a.pathI = 0; } }\n    }\n    let gx = null, gz = null;\n    if (a.path && a.pathI < a.path.length) { gx = a.path[a.pathI][0]; gz = a.path[a.pathI][2]; if (dist2(a.x, a.z, gx, gz) < 1.4) { a.pathI++; if (a.pathI >= a.path.length) { a.path = null; a.moveTo = null; gx = gz = null; } } }\n    else if (a.moveTo) { gx = a.moveTo[0]; gz = a.moveTo[1]; if (dist2(a.x, a.z, gx, gz) < 1.0) { a.moveTo = null; gx = gz = null; } }\n    const speed = a.speedWanted ?? 0;\n    if (gx !== null && speed > 0) {\n      const dx = gx - a.x, dz = gz - a.z, l = Math.hypot(dx, dz) || 1;\n      mx = (dx / l) * Math.min(1, speed); mz = (dz / l) * Math.min(1, speed);\n      if (!a.fireAt && a.lookAtYaw === null) a.yawGoal = Math.atan2(dx, dz);\n      else a.yawGoal = a.lookAtYaw ?? Math.atan2(dx, dz);\n    } else if (a.lookAtYaw !== null) a.yawGoal = a.lookAtYaw;\n    a.lookAtYaw = null;\n    ctrl.speed = a.spec.speed * Math.max(1, speed) * (this.game.world.land.waterDepth(a.x, a.z) > 0.3 ? 0.6 : 1);\n    if (!a.stationary) { moveV.set(mx, 0, mz); ctrl.setInput(moveV, false, false); ctrl.fixedUpdate(dt); }\n    const f = a.stationary ? null : ctrl.feet;\n    if (f) { a.x = f.x; a.y = f.y; a.z = f.z; }\n    a.moving = Math.hypot(mx, mz) > 0.05;\n    if (a.yawGoal !== undefined) { let d = a.yawGoal - a.yaw; d = Math.atan2(Math.sin(d), Math.cos(d)); a.yaw += clamp(d, -5 * dt, 5 * dt); }\n    a.runFrac = speed;\n  }\n  shoot(a, dt) {\n    a.nextShot -= dt;\n    const t = a.fireAt;\n    if (!t || a.burstLeft <= 0 || a.nextShot > 0 || a.burning > 0) return;\n    a.nextShot = 1 / a.spec.rate; a.burstLeft--;\n    // Their guns jam too. That is an opening.\n    a.cond = Math.max(0, a.cond - 0.15);\n    const jam = TUNING.jamRate * 0.12 * (1 - a.cond / 100) ** 2 * 0.2;\n    if (this.rng.next() < jam) { a.jamT = 3; a.burstLeft = 0; a.view?.flashUpper('UnjamSwear'); this.bark(a, 'jammed', true); this.game.audio.at('jam-click', a.x, a.y + 1, a.z, 40); return; }\n    this.game.combat.npcShot(a, t);\n    if (a.view) a.view.flashUpper('FireRecoil');\n  }\n  /** Damage. `o`: { by, fire, zone, silent, push } */\n  damage(a, dmg, o = {}) {\n    if (!a.alive || a.down) return;\n    if (a.invulnerable) return;\n    a.hp -= dmg;\n    if (a.ctrl && o.by && o.by.kind === 'player') { a.lastKnown = [o.by.x, o.by.z]; if (a.state !== 'alert' && !a.friendly) { this.alert(a, o.by); } a.provokedBy = true; }\n    if (a.hp <= 0) { if (a.buddy) this.goDown(a, o); else this.kill(a, o); return; }\n    if (!o.silent && a.view) { a.view.flashUpper('HitReact'); }\n  }\n  goDown(a, o = {}) {\n    a.hp = 0; a.down = true; a.downT = 40; a.burningDown = !!o.fire; a.moveTo = null; a.fireAt = null;\n    a.view?.setFull('WoundedSit');\n    this.game.buddies.onDown(a, o);\n  }\n  fixedDown(a, dt) { a.downT -= dt; if (a.downT <= 0) { a.down = false; this.kill(a, { silent: true, bledOut: true }); } }\n  kill(a, o = {}) {\n    if (!a.alive) return;\n    a.alive = false; a.state = 'dead';\n    if (a.ctrl) { this.game.world.owners.delete(a.ctrl.collider.handle); this.ctx.physics.remove(a.ctrl.body); a.ctrl = null; }\n    const game = this.game;\n    game.events.emit('actorDied', a, o);\n    if (!o.silent) this.barkNearby(a, 'down');\n    if (a.view) {\n      if (o.fire || !o.push || Math.hypot(a.x - game.player.x, a.z - game.player.z) > 70) a.view.setFull('Death', true);\n      else a.view.ragdoll(o.push);\n      this.corpses.push({ view: a.view, t: 40 });\n      if (this.corpses.length > 30) { const c = this.corpses.shift(); c.view.dispose(); }\n      a.view = null;\n    }\n    this.byId.delete(a.id);\n    const i = this.list.indexOf(a); if (i >= 0) this.list.splice(i, 1);\n    if (a.site) { const s = game.world.sites[a.site]; if (s) { s.actors = s.actors.filter((x) => x !== a); game.onSiteCheck?.(s); } }\n  }\n  remove(a) { if (a.ctrl) { this.game.world.owners.delete(a.ctrl.collider.handle); this.ctx.physics.remove(a.ctrl.body); a.ctrl = null; } a.view?.dispose(); a.view = null; a.alive = false; this.byId.delete(a.id); const i = this.list.indexOf(a); if (i >= 0) this.list.splice(i, 1); }\n  clear() { for (const a of [...this.list]) this.remove(a); for (const c of this.corpses) c.view.dispose(); this.corpses.length = 0; }\n  bark(a, kind, force) {\n    if (a.friendly && !a.buddy) return; const set = BARKS[a.faction]?.[kind] ?? BARKS.concord[kind]; if (!set) return;\n    if (!force && a.barkT > 0) return; a.barkT = 5;\n    if (this.rng.next() > 0.65 && !force) return;\n    if (a.buddy) return;\n    const p = this.game.player, d = Math.hypot(a.x - p.x, a.z - p.z); if (d > 70) return;\n    const text = this.rng.pick(set);\n    this.game.audio.voiceAt('soldier', text, a, a.id);\n    if (d < 40) this.game.talk.bark('SOLDIER', text);\n  }\n  barkNearby(a, kind) { for (const o of this.list) if (o.alive && o.faction === a.faction && Math.hypot(o.x - a.x, o.z - a.z) < 30) { this.bark(o, kind); break; } }\n  update(dt) {\n    const camX = this.game.camX ?? 0, camZ = this.game.camZ ?? 0;\n    for (const a of this.list) {\n      if (!a.view) continue;\n      const dist = Math.hypot(a.x - camX, a.z - camZ);\n      a.view.object.visible = dist < 400;\n      if (dist > 400) continue;\n      const v = a.view;\n      if (a.down) { v.place(a.x, a.y, a.z, a.yaw); v.update(dt); continue; }\n      v.place(a.x, a.stationary ? this.game.world.land.heightAt(a.x, a.z) + (a.y0 ?? 0) : a.y, a.z, a.yaw);\n      if (a.burning > 0) v.setFull('BurnPanic');\n      else if (a.asleep && a.state === 'idle') v.setFull('Sleep');\n      else if (a.duty === 'sit' && a.state === 'idle') v.setFull('Sit');\n      else {\n        const run = a.moving && a.runFrac > 0.8, walk = a.moving;\n        v.setLower(run ? 'Run' : walk ? 'Walk' : 'Idle', run ? 1.1 : 1);\n        v.setUpper(a.state === 'alert' || a.state === 'searching' || a.state === 'suspicious' ? (walk ? 'AimWalk' : 'AimIdle') : 'AimIdle');\n      }\n      v.update(dt);\n    }\n    for (const c of this.corpses) c.view.update(dt);\n  }\n  /** Projected ? and ! over heads, close by. */\n  overheads() { return this.list.filter((a) => a.alive && !a.friendly && a.ctrl && (a.state === 'suspicious' || a.state === 'alert') && Math.hypot(a.x - this.game.player.x, a.z - this.game.player.z) < 45); }\n}\nexport { KIND, WATER_Y };\nEOF\ncat > src/combat/projectiles.js <<'EOF'\n// Things that fly: flares, bottles, rockets. A ray per fixed step.\nimport { buildModel, THREE, setLookLayer } from '../../pixel-engine.js';\nimport { CATALOG } from '../art/models.js';\nconst { Vector3 } = THREE;\nconst dir = new Vector3(), from = new Vector3();\nconst KINDS = {\n  flare: { speed: 34, gravity: 12, palette: { body: 'orange', tip: 'white' }, scale: 0.7, light: 0xffa050, life: 7 },\n  bottle: { speed: 18, gravity: 14, palette: { body: 'green', tip: 'orange' }, scale: 1.1, life: 6 },\n  rocket: { speed: 62, gravity: 0.6, palette: { body: 'night', tip: 'white' }, scale: 1.4, light: 0xffe0a0, life: 5 },\n};\nexport class Projectiles {\n  list = [];\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; }\n  spawn(kind, x, y, z, dx, dy, dz, by) {\n    const k = KINDS[kind], b = buildModel('projectile', { catalog: CATALOG, palette: k.palette });\n    b.object.scale.setScalar(k.scale); setLookLayer(b.object, 'actors'); b.object.position.set(x, y, z);\n    this.ctx.scene.add(b.object);\n    const p = { kind, x, y, z, vx: dx * k.speed, vy: dy * k.speed, vz: dz * k.speed, life: k.life, by, object: b.object, g: k.gravity };\n    if (k.light) p.light = this.ctx.lights.request({ follow: b.object, color: k.light, intensity: 12, radius: 24, flicker: 'torch', priority: 3 });\n    this.list.push(p);\n    return p;\n  }\n  fixed(dt) {\n    const ph = this.ctx.physics;\n    for (let i = this.list.length - 1; i >= 0; i--) {\n      const p = this.list[i];\n      p.vy -= p.g * dt; p.life -= dt;\n      const sp = Math.hypot(p.vx, p.vy, p.vz), step = sp * dt;\n      from.set(p.x, p.y, p.z); dir.set(p.vx / sp, p.vy / sp, p.vz / sp);\n      const hit = ph.castRay(from, dir, step, undefined, this.game.player.ctrl?.body);\n      if (hit || p.life <= 0 || p.y < -10) { const q = hit ? hit.point : from; this.impact(p, q.x, q.y, q.z, hit); this.ctx.scene.remove(p.object); p.light?.release(); this.list.splice(i, 1); continue; }\n      p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt;\n    }\n  }\n  update() { for (const p of this.list) { p.object.position.set(p.x, p.y, p.z); p.object.lookAt(p.x + p.vx, p.y + p.vy, p.z + p.vz); if (p.kind !== 'bottle') this.ctx.particles.burst('gun-smoke', [p.x, p.y, p.z], { count: 1 }); } }\n  impact(p, x, y, z, hit) {\n    const combat = this.game.combat;\n    if (p.kind === 'flare') combat.flareImpact(x, y, z, hit, p.by);\n    else if (p.kind === 'bottle') combat.bottleImpact(x, y, z, hit, p.by);\n    else combat.rocketImpact(x, y, z, hit, p.by);\n  }\n  clear() { for (const p of this.list) { this.ctx.scene.remove(p.object); p.light?.release(); } this.list.length = 0; }\n}\nEOF\ncat > src/combat/viewmodel.js <<'EOF'\n// Everything you see in your own hands. Attached to the camera; one rig per gun, one for tools, one for the map.\nimport { buildModel, compileClips, setLookLayer, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { CATALOG } from '../art/models.js';\nimport { GUN_CLIPS, TOOL_CLIPS } from '../art/clips.js';\nimport { GUN_RIG, GUN_VIEWMODELS, handsMap, TOOL_RIG, vmDash, vmMg, vmTools } from '../art/viewmodels.js';\nimport { clamp, lerp } from '../world/geom.js';\nconst { AnimationMixer, Group, LoopOnce, LoopRepeat, Mesh, PlaneGeometry } = THREE;\nconst TOOL_ITEMS = ['tool-syrette', 'tool-pliers', 'tool-knife', 'tool-lighter', 'tool-wrench', 'tool-detonator', 'tool-bottle', 'tool-charge', 'tool-tablet', 'tool-revolver', 'tool-tablets', 'tool-tracker', 'tool-monocular', 'prop-forearm', 'prop-thigh', 'prop-burn'];\nexport class ViewModel {\n  rigs = {}; current = null; raise = 0; adsK = 0; bobT = 0; lower = 0; lowerGoal = 0; mapUp = 0; toolName = null; toolT = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.ctx = ctx;\n    const cam = ctx.camera.camera;\n    ctx.scene.add(cam);\n    this.group = new Group(); cam.add(this.group); setLookLayer(this.group, 'actors');\n    const make = (def, clips, rig) => {\n      const b = buildModel(def, { catalog: CATALOG });\n      b.object.rotation.y = Math.PI;\n      b.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.receiveShadow = false; o.frustumCulled = false; } });\n      b.object.visible = false;\n      this.group.add(b.object);\n      const mixer = new AnimationMixer(b.object), compiled = compileClips(clips, rig, b.object);\n      const actions = Object.fromEntries(compiled.map((c) => [c.name, mixer.clipAction(c)]));\n      return { object: b.object, mixer, actions, cur: null, rust: b.object.getObjectByName('Rust'), tape: b.object.getObjectByName('Tape') };\n    };\n    for (const [id, def] of Object.entries(GUN_VIEWMODELS)) this.rigs[id] = make(def, GUN_CLIPS[id], GUN_RIG);\n    this.rigs.mg = make(vmMg, GUN_CLIPS.mg, GUN_RIG);\n    this.tools = make(vmTools, TOOL_CLIPS, TOOL_RIG);\n    this.items = Object.fromEntries(TOOL_ITEMS.map((n) => [n, this.tools.object.getObjectByName(n)]));\n    this.finger = this.tools.object.getObjectByName('Finger');\n    this.led = this.tools.object.getObjectByName('tracker-led');\n    for (const it of Object.values(this.items)) it.visible = false;\n    // The wheel and dash are drawn with the truck you sit in.\n    const dash = buildModel(vmDash, { catalog: CATALOG });\n    this.dash = dash.object; this.dash.rotation.y = Math.PI; this.dash.visible = false; this.dash.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n    this.group.add(this.dash); this.wheelNode = this.dash.getObjectByName('Wheel'); this.arrowNode = this.dash.getObjectByName('Arrow');\n    // The map in your hands.\n    const hands = buildModel(handsMap, { catalog: CATALOG }); hands.object.rotation.y = Math.PI; hands.object.position.set(0, -0.2, -0.43); hands.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n    this.mapGroup = new Group(); this.mapGroup.visible = false; this.group.add(this.mapGroup); this.mapGroup.add(hands.object);\n    this.mapPlane = new Mesh(new PlaneGeometry(0.5, 0.375), toonMaterial(0xffffff, { map: this.game.mapTex.texture }));\n    this.mapPlane.position.set(0, -0.015, -0.42); this.mapPlane.rotation.x = -0.14; this.mapPlane.castShadow = false; this.mapPlane.frustumCulled = false;\n    this.mapGroup.add(this.mapPlane);\n  }\n  show(id) {\n    if (this.current === id) return;\n    const cur = this.rigs[this.current]; if (cur) { cur.object.visible = false; }\n    this.current = id;\n    const next = this.rigs[id]; if (!next) return;\n    next.object.visible = !this.hideGun;\n    this.playGun('Equip', true); this.queueIdle = true;\n  }\n  playGun(name, once, fade = 0.04) {\n    const r = this.rigs[this.current]; if (!r) return 0; const a = r.actions[name]; if (!a) return 0;\n    if (r.cur && r.cur !== a) r.cur.fadeOut(fade);\n    a.reset().setLoop(once ? LoopOnce : LoopRepeat, once ? 1 : Infinity); a.clampWhenFinished = once; a.fadeIn(fade).play(); r.cur = a; r.curOnce = once; r.curName = name;\n    return a.getClip().duration;\n  }\n  /** Rust and tape show on the gun itself. No numbers. */\n  setCondition(id, cond) { const r = this.rigs[id]; if (!r) return; if (r.rust) r.rust.visible = cond < 60; if (r.tape) r.tape.visible = cond < 30; }\n  /** A tool clip: items shown, the gun lowered away. */\n  playTool(clip, items = [], { hideGun = true, loop = false } = {}) {\n    for (const it of Object.values(this.items)) it.visible = false;\n    for (const n of items) if (this.items[n]) this.items[n].visible = true;\n    const t = this.tools; t.object.visible = true;\n    const a = t.actions[clip]; if (!a) return 0;\n    if (t.cur && t.cur !== a) t.cur.fadeOut(0.06);\n    a.reset().setLoop(loop ? LoopRepeat : LoopOnce, loop ? Infinity : 1); a.clampWhenFinished = !loop; a.fadeIn(0.06).play(); t.cur = a; t.curName = clip;\n    this.toolName = clip; this.toolT = loop ? Infinity : a.getClip().duration;\n    this.hideGun = hideGun; const r = this.rigs[this.current]; if (r) r.object.visible = !hideGun;\n    return a.getClip().duration;\n  }\n  endTool() { this.toolName = null; this.toolT = 0; this.tools.object.visible = false; this.hideGun = false; const r = this.rigs[this.current]; if (r) r.object.visible = !this.allHidden; }\n  update(dt, st) {\n    const g = this.game, r = this.rigs[this.current];\n    this.bobT += dt * (st.speed > 0.2 ? 6 + st.speed * 1.2 : 1.2);\n    const swayX = Math.sin(this.bobT) * 0.006 * clamp(st.speed / 5, 0.15, 1.4), swayY = Math.abs(Math.cos(this.bobT)) * 0.01 * clamp(st.speed / 5, 0.1, 1.4);\n    this.adsK = lerp(this.adsK, st.ads ? 1 : 0, clamp(dt * 14, 0, 1));\n    this.lower = lerp(this.lower, st.lowered ? 1 : 0, clamp(dt * 8, 0, 1));\n    const feverSway = st.fever * 0.03;\n    const gx = lerp(swayX, 0.127, this.adsK) + Math.sin(this.bobT * 0.31) * feverSway, gy = lerp(-swayY, 0.09, this.adsK) - this.lower * 0.34 + (st.landDip ?? 0) + Math.cos(this.bobT * 0.23) * feverSway;\n    this.group.position.set(gx, gy + (st.crouchDip ?? 0), lerp(0, 0.1, this.adsK) + (st.kick ?? 0));\n    this.group.rotation.x = st.scoped ? 0 : this.lower * -0.6;\n    this.group.visible = !st.hidden;\n    if (r) { r.object.visible = !this.hideGun && !st.hideGun && !st.scoped; r.mixer.update(dt); if (r.curOnce && r.cur && !r.cur.isRunning()) { const id = r.actions.Idle; if (id) { r.cur.fadeOut(0.1); id.reset().setLoop(LoopRepeat, Infinity).fadeIn(0.1).play(); r.cur = id; r.curOnce = false; r.curName = 'Idle'; } } }\n    if (this.tools.object.visible) { this.tools.mixer.update(dt); this.toolT -= dt; if (this.toolT <= 0 && this.toolName) { this.endTool(); g.events.emit('toolEnd'); } }\n    // The map rises and falls in 0.4 s.\n    const up = st.mapUp ? 1 : 0;\n    this.mapUp = clamp(this.mapUp + Math.sign(up - this.mapUp) * dt / 0.4, 0, 1);\n    const e = this.mapUp * this.mapUp * (3 - 2 * this.mapUp);\n    this.mapGroup.visible = e > 0.01; this.mapGroup.position.set(0, -0.5 * (1 - e) - this.group.position.y - (st.crouchDip ?? 0), 0.02);\n    this.mapGroup.rotation.x = -(1 - e) * 0.8 + st.fever * 0.04 * Math.sin(this.bobT * 0.4);\n    this.mapPlane.material.color?.setScalar(1);\n    this.dash.visible = !!st.dash;\n    if (st.dash) { this.dash.position.set(0, -0.0 - this.group.position.y + 0.04, 0.04); this.wheelNode.rotation.z = (st.wheel ?? 0) * 1.5; this.arrowNode.rotation.y = st.arrowYaw ?? 0; }\n  }\n}\nEOF\ncat > src/combat/weapons.js <<'EOF'\n// Guns, wear, jams, shots, blasts. The source's spirit made precise (section 8).\nimport { THREE } from '../../pixel-engine.js';\nimport { THROWABLES, WEAPONS } from '../content/weapons.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp, dist2 } from '../world/geom.js';\nconst { Vector3 } = THREE;\nconst from = new Vector3(), dir = new Vector3(), v = new Vector3(), right = new Vector3(), up = new Vector3();\nexport const jamChance = (cond) => TUNING.jamRate * 0.12 * (1 - cond / 100) ** 2;\nexport class Combat {\n  fireTimer = 0; busy = 0; busyKind = null; heat = 0; overheated = false; shotsFired = 0; hitMark = 0; tracerN = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('combat'); this.tracerRng = ctx.random.fork('tracers'); this.tracers = []; ctx.audio; }\n  get p() { return this.game.player; }\n  newGun(id, cond = 100) { const w = WEAPONS[id]; const belt = this.p.upgrades?.belt ? 1.5 : 1; return { id, cond, mag: w.mag ?? 0, reserve: Math.round((w.reserve ?? 0) * belt), jammed: false, jamLeft: 0 }; }\n  give(id, cond = 100, select = true) {\n    const p = this.p, w = WEAPONS[id]; if (!w) return;\n    const g = this.newGun(id, cond);\n    p.guns[w.slot] = g;\n    if (select) this.select(w.slot, true);\n    this.game.vm.setCondition(id, cond);\n    return g;\n  }\n  select(slot, force) {\n    const p = this.p; if (!p.guns[slot] && !force) return;\n    if (!p.guns[slot]) return;\n    p.slot = slot; const g = p.guns[slot]; this.busy = Math.max(this.busy, 0.3); this.busyKind = 'equip';\n    this.game.vm.show(g.id); this.game.vm.setCondition(g.id, g.cond);\n    this.game.audio.play('magazine', { volume: 0.4 });\n    this.game.hud.touch();\n  }\n  nextWeapon(dirn = 1) {\n    const order = ['main', 'sidearm', 'special', 'melee'], p = this.p; const i = order.indexOf(p.slot);\n    for (let k = 1; k <= 4; k++) { const s = order[(i + k * dirn + 8) % 4]; if (p.guns[s]) { this.select(s); return; } }\n  }\n  current() { const p = this.p; if (p.mounted) return p.mountGun; return p.guns[p.slot] ?? p.guns.melee; }\n  /** One fixed step of the player's weapon. */\n  fixed(dt) {\n    const p = this.p, input = this.ctx.input, game = this.game;\n    this.fireTimer -= dt; this.busy = Math.max(0, this.busy - dt);\n    this.hitMark = Math.max(0, this.hitMark - dt);\n    if (this.heat > 0) { this.heat = Math.max(0, this.heat - (dt * WEAPONS.mg.overheat) / WEAPONS.mg.cool); if (this.overheated && this.heat <= 0) this.overheated = false; }\n    if (!p.canAct()) return;\n    const g = this.current(); if (!g) return;\n    const w = WEAPONS[g.id];\n    p.ads = held(input, 'aim') && !p.sprinting && !p.toolBusy && !p.mapUp && !w.melee;\n    if (p.vehicle && !p.mounted) return;\n    const slung = game.gunSlung();\n    // Reload or unjam.\n    if (!p.mapUp && !game.prompt.has() && input.consumeAny(['KeyR', 'PadSquare'])) this.reloadPress(g, w);\n    else if (!p.mapUp && input.consumePress('KeyR')) this.reloadPress(g, w);\n    if (!p.mounted) {\n      if (pressedFixed(input, 'next')) { if (!p.mapUp) this.nextWeapon(); }\n      if (input.consumePress('Digit1')) this.select('main'); if (input.consumePress('Digit2')) this.select('sidearm'); if (input.consumePress('Digit3')) this.select('special'); if (input.consumePress('Digit4')) this.select('melee');\n      if (!p.mapUp && pressedFixed(input, 'melee')) this.meleeSwing();\n      if (!p.mapUp && pressedFixed(input, 'throw')) this.throwPress();\n    }\n    if (slung || p.mapUp || p.toolBusy || p.sprinting) { input.clearQueued('MouseLeft', 'PadR2'); return; }\n    if (this.busy > 0) return;\n    const fireHeld = held(input, 'fire'), firePress = pressedFixed(input, 'fire');\n    const wantFire = w.auto || w.stream ? fireHeld : firePress;\n    if (wantFire && this.fireTimer <= 0) this.tryFire(g, w, dt);\n    if (w.stream && !fireHeld) this.stopStream();\n    if (w.pump && g.needsPump && this.fireTimer <= 0.5 && !this.busy) { g.needsPump = false; game.vm.playGun('Pump', true); game.audio.play('rack', { volume: 0.6 }); }\n  }\n  reloadPress(g, w) {\n    const game = this.game;\n    if (g.jammed) { // Slap and rack: 2 to 4 presses, seeded.\n      if (this.busy > 0.1) return;\n      g.jamLeft--; game.vm.playGun('Unjam', true); game.audio.play('slap'); this.ctx.tweens.call(0.2, () => game.audio.play('rack'));\n      this.busy = 0.75; this.busyKind = 'unjam'; game.rumble(0.3, 0.1);\n      if (g.jamLeft <= 0) { g.jammed = false; game.events.emit('unjam', g); }\n      game.hud.touch();\n      return;\n    }\n    if (w.melee || g.id === 'mg' || this.busy > 0 || g.mag >= w.mag || g.reserve <= 0) return;\n    this.busy = w.reloadT; this.busyKind = 'reload'; game.vm.playGun('Reload', true);\n    game.audio.play(w.stream ? 'fuel-slosh' : g.id === 'm38' ? 'cylinder' : g.id === 'mule' ? 'shell' : 'magazine', { volume: 0.7 });\n    this.ctx.tweens.call(w.reloadT * 0.7, () => game.audio.play(g.id === 'm38' ? 'cylinder' : 'rack', { volume: 0.6 }));\n    this.pendingReload = { g, w, t: w.reloadT };\n    this.ctx.tweens.call(w.reloadT, () => { if (this.pendingReload?.g !== g) return; const need = w.mag - g.mag, take = Math.min(need, g.reserve); g.mag += take; g.reserve -= take; this.pendingReload = null; game.hud.touch(); });\n  }\n  tryFire(g, w, dt) {\n    const p = this.p, game = this.game;\n    if (w.melee) { this.meleeSwing(); return; }\n    if (g.id === 'mg') { if (this.overheated) { game.audio.play('jam-click', { volume: 0.3 }); this.fireTimer = 0.2; return; } this.heat += 1 / w.rate; if (this.heat >= w.overheat) { this.overheated = true; game.audio.play('hiss'); } }\n    else {\n      if (g.jammed) { game.audio.play('jam-click'); this.fireTimer = 0.25; game.prompt.flash('reload', 'CLEAR THE JAM'); return; }\n      if (!game.cheats.infiniteAmmo && g.mag <= 0 && !w.stream) { game.audio.play('jam-click', { volume: 0.5 }); this.fireTimer = 0.25; if (g.reserve > 0) this.reloadPress(g, w); return; }\n      if (w.stream && g.mag <= 0 && !game.cheats.infiniteAmmo) { this.stopStream(); return; }\n    }\n    this.fireTimer = 1 / w.rate;\n    if (g.id !== 'mg') {\n      // Wear. Thresholds appear on the gun itself.\n      const before = g.cond;\n      g.cond = Math.max(0, g.cond - w.wear * TUNING.wearRate * (p.upgrades.cleaning ? 0.6 : 1) * (w.stream ? 1 / 1 : 1));\n      if (Math.floor(before / 30) !== Math.floor(g.cond / 30) || before >= 60 !== g.cond >= 60) game.vm.setCondition(g.id, g.cond);\n      if (!game.cheats.infiniteAmmo) g.mag -= 1;\n      if (g.scriptedJam && --g.scriptedJam === 0) { this.jam(g); return; }\n      if (!game.cheats.noJams && !w.stream && !w.melee && this.rng.next() < jamChance(g.cond)) { this.jam(g); return; }\n      if (g.cond <= 0 && w.wear > 0) { this.fallApart(g, w); return; }\n    }\n    this.shotsFired++;\n    game.hud.touch();\n    game.lastShotT = game.world.time;\n    p.litT = 0.5;\n    this.ctx.engine.shake.add(w.kick ? Math.min(0.5, w.kick * 3.5) : 0.03);\n    game.rumble(w.kick ? Math.min(0.8, w.kick * 8) : 0.2, 0.06);\n    if (w.noise) this.game.actors.hearShot(p.x, p.z, w.noise, null);\n    game.world.shout(p.x, p.z);\n    const eye = this.eye();\n    if (w.stream) { this.stream(g, w, dt, eye); game.vm.playGun('Idle', false, 0); return; }\n    game.vm.playGun('Fire', true, 0.01);\n    if (p.mounted) { game.cam.kickPitch = (game.cam.kickPitch || 0) + 0.003; } else game.cam.kickPitch = (game.cam.kickPitch || 0) + (w.kick ?? 0.01) * 0.9;\n    if (w.sound) game.audio.play(w.sound, { pitch: this.tracerRng.range(-0.6, 0.6) });\n    this.muzzle(eye);\n    if (g.cond < 30 && g.id !== 'mg') { this.ctx.particles.burst('gun-smoke', this.muzzlePos(eye)); if (g.cond < 10 && this.rng.next() < 0.3) game.audio.play('rattle'); }\n    if (w.projectile) {\n      const [dx, dy, dz] = eye.dir;\n      game.projectiles.spawn(w.projectile, eye.x + dx * 0.6, eye.y + dy * 0.6 - 0.1, eye.z + dz * 0.6, dx, dy + (w.projectile === 'flare' ? 0.12 : 0), dz, p);\n      if (w.pump) g.needsPump = true;\n      return;\n    }\n    const pellets = w.pellets ?? 1;\n    const spreadDeg = p.ads ? (w.adsSpread ?? 0.4) : (w.spread ?? 1.4) * (p.speed2 > 4 ? 1.3 : 1);\n    for (let i = 0; i < pellets; i++) this.hitscan(g, w, eye, spreadDeg, i === 0 && (++this.tracerN % 3 === 0 || pellets > 1));\n    if (w.pump) g.needsPump = true;\n  }\n  eye() {\n    const c = this.ctx.camera.camera, p = this.p;\n    if (this.game.cam.override) { c.getWorldDirection(dir); return { x: c.position.x, y: c.position.y, z: c.position.z, dir: [dir.x, dir.y, dir.z] }; }\n    const cy = Math.cos(this.ctx.camera.pitch), d = [-Math.sin(this.ctx.camera.yaw) * cy, Math.sin(this.ctx.camera.pitch), -Math.cos(this.ctx.camera.yaw) * cy];\n    const e = p.eyeNow();\n    return { x: e.x, y: e.y, z: e.z, dir: d };\n  }\n  muzzlePos(e) { return [e.x + e.dir[0] * 0.9, e.y + e.dir[1] * 0.9 - 0.14, e.z + e.dir[2] * 0.9]; }\n  muzzle(e) { const at = this.muzzlePos(e); this.ctx.lights.request({ position: at, color: 0xffd090, intensity: 18, radius: 16, lifetime: 0.06, fadeIn: 0, fadeOut: 0.04, priority: 4 }); }\n  hitscan(g, w, eye, spreadDeg, tracer) {\n    const a = this.rng.range(0, 6.283), r = Math.sqrt(this.rng.next()) * (spreadDeg * Math.PI) / 180;\n    from.set(eye.x, eye.y, eye.z); dir.set(...eye.dir);\n    right.set(dir.z, 0, -dir.x).normalize(); up.crossVectors(dir, right);\n    dir.addScaledVector(right, Math.cos(a) * r).addScaledVector(up, Math.sin(a) * r).normalize();\n    this.lastHit = this.ctx.physics.castRay(from, dir, w.range, undefined, this.p.vehicle ? this.p.vehicle.v.body : this.p.ctrl?.body);\n    const hit = this.lastHit;\n    if (tracer) this.tracer(eye, hit ? hit.point : { x: from.x + dir.x * w.range, y: from.y + dir.y * w.range, z: from.z + dir.z * w.range });\n    if (!hit) return;\n    this.applyHit(hit, w.damage * TUNING.weaponDamage, this.p, { dir, weapon: w, from });\n  }\n  /** A bullet arriving. `by` is whoever fired it. */\n  applyHit(hit, dmg, by, o = {}) {\n    const game = this.game, owner = game.world.owners.get(hit.collider.handle), P = hit.point, particles = this.ctx.particles;\n    if (owner?.type === 'actor') {\n      const a = owner.ref, rel = P.y - a.y;\n      const k = rel > 1.45 ? 2.5 : rel < 0.75 ? 0.7 : 1;\n      if (!a.alive) return;\n      particles.burst('blood', [P.x, P.y, P.z]);\n      game.audio.at('hit-flesh', P.x, P.y, P.z, 40);\n      if (by?.kind === 'player') { this.hitMark = 0.18; this.ctx.engine.hitstop(0.02); }\n      const dmgNow = dmg * k;\n      const push = o.dir ? [o.dir.x * 5, 2 + o.dir.y * 5, o.dir.z * 5] : [0, 3, 0];\n      game.damageActor(a, dmgNow, { by, push, zone: k });\n      return;\n    }\n    if (owner?.type === 'player') { game.damagePlayer(dmg, { by, dirFrom: o.from, player: owner.ref }); return; }\n    if (owner?.type === 'prop') { particles.burst('sparks', [P.x, P.y, P.z]); game.audio.at('hit-metal', P.x, P.y, P.z, 40); game.world.hitProp(owner.ref, dmg, by); return; }\n    if (owner?.type === 'vehicle') { particles.burst('sparks', [P.x, P.y, P.z]); game.audio.at('hit-metal', P.x, P.y, P.z, 50); owner.ref.damage(dmg * 0.25, by); return; }\n    if (owner?.type === 'train') { particles.burst('sparks', [P.x, P.y, P.z]); game.audio.at('hit-metal', P.x, P.y, P.z, 50); return; }\n    particles.burst('mud', [P.x, P.y, P.z]); if (this.tracerRng.next() < 0.22) game.audio.at('ricochet', P.x, P.y, P.z, 40);\n  }\n  tracer(eye, to) {\n    const m = this.muzzlePos(eye);\n    this.game.tracers?.add(m[0], m[1], m[2], to.x, to.y, to.z);\n    if (this.game.mountedTracerFire && this.rng.next() < 0.06) this.game.world.fire.ignite(to.x, to.z, 1);\n  }\n  stream(g, w, dt, eye) {\n    const game = this.game, p = this.p;\n    if (!this.roar) this.roar = game.audio.loopSfx('flame-roar', 0.5);\n    this.streamT = 0.15;\n    // Lights everything in its cone.\n    const [dx, dy, dz] = eye.dir;\n    for (let d = 3; d <= w.range; d += 3) game.world.fire.ignite(eye.x + dx * d, eye.z + dz * d, 2, p);\n    this.ctx.particles.burst('blast', [eye.x + dx * 2, eye.y - 0.3 + dy * 2, eye.z + dz * 2], { count: 8, direction: [dx, dy, dz] });\n    this.ctx.lights.request({ position: [eye.x + dx * 4, eye.y, eye.z + dz * 4], color: 0xff8030, intensity: 22, radius: 20, lifetime: 0.1, priority: 3 });\n    for (const a of [...game.actors.list]) { if (!a.alive) continue; const vx = a.x - eye.x, vz = a.z - eye.z, d = Math.hypot(vx, vz); if (d > w.range) continue; const c = (vx * dx + vz * dz) / (d * Math.hypot(dx, dz) || 1); if (c > 0.9) { game.damageActor(a, (w.damage * TUNING.weaponDamage) / w.rate, { by: p, fire: true, silent: true }); if (a.burning <= 0 && !a.friendly) { a.burning = 5; a.burnBy = p; } } }\n    for (const dd of game.world.destructibles) if (!dd.destroyed && dist2(dd.x, dd.z, eye.x, eye.z) < w.range) { const vx = dd.x - eye.x, vz = dd.z - eye.z, l = Math.hypot(vx, vz) || 1; if ((vx * dx + vz * dz) / (l * Math.hypot(dx, dz) || 1) > 0.9) dd.fuse = dd.fuse < 0 ? 0.8 : dd.fuse; }\n    // Below condition 20 it can leak and light you.\n    if (g.cond < 20 && this.rng.next() < 0.004) { p.catchFire(); game.talk.say('you', 'THE TANK IS LEAKING.'); }\n  }\n  stopStream() { if (this.roar) { this.roar.stop(); this.roar = null; } }\n  jam(g) { g.jammed = true; g.jamLeft = this.rng.int(2, 4); this.game.audio.play('jam-click'); this.game.prompt.flash('reload', 'JAMMED'); this.game.events.emit('jam', g); this.game.hud.touch(); this.fireTimer = 0.4; }\n  fallApart(g, w) {\n    const game = this.game, p = this.p;\n    this.stopStream();\n    game.vm.playGun('FallApart', true); game.audio.play('fall-apart');\n    game.talk.say('you', `THE ${w.name.replaceAll('\"', '')} COMES APART IN YOUR HANDS.`);\n    this.busy = 1.1; this.busyKind = 'broken';\n    this.ctx.tweens.call(1.1, () => { p.guns[w.slot] = null; this.nextWeapon(); });\n    game.events.emit('fallApart', g);\n  }\n  meleeSwing() {\n    const game = this.game, p = this.p; if (this.busy > 0 || game.gunSlung() || p.toolBusy) return;\n    const prev = p.slot; const w = WEAPONS.cane;\n    this.select('melee'); game.vm.playGun('Swing', true); this.busy = 1 / w.rate; this.busyKind = 'melee';\n    game.audio.play('whoosh', { volume: 0.5 });\n    const eye = this.eye();\n    this.ctx.tweens.call(0.2, () => {\n      let best = null, bd = 1e9;\n      for (const a of game.actors.list) { if (!a.alive || a.friendly) continue; const d = Math.hypot(a.x - eye.x, a.z - eye.z); if (d > w.range) continue; const c = ((a.x - eye.x) * eye.dir[0] + (a.z - eye.z) * eye.dir[2]) / (d * Math.hypot(eye.dir[0], eye.dir[2]) || 1); if (c > 0.5 && d < bd) { best = a; bd = d; } }\n      if (best) {\n        // Kills from behind, quietly.\n        let dy = Math.atan2(eye.x - best.x, eye.z - best.z) - best.yaw; dy = Math.atan2(Math.sin(dy), Math.cos(dy));\n        const behind = Math.abs(dy) > 1.9;\n        game.damageActor(best, behind && best.state !== 'alert' ? 9999 : w.damage * TUNING.weaponDamage, { by: p, zone: 1, quiet: behind, push: [eye.dir[0] * 3, 1, eye.dir[2] * 3] });\n        game.audio.play('hit-flesh'); this.hitMark = 0.18; this.ctx.particles.burst('blood', [best.x, best.y + 1.2, best.z]);\n      }\n      if (prev !== 'melee') this.ctx.tweens.call(0.35, () => { if (p.guns[prev] && p.slot === 'melee') this.select(prev); });\n    });\n  }\n  throwPress() {\n    const game = this.game, p = this.p;\n    // A planted charge goes off on a second press.\n    if (p.planted.length) { game.vm.playTool('Detonate', ['tool-detonator'], { hideGun: true }); p.toolBusy = 0.7; game.audio.play('click'); const list = [...p.planted]; p.planted.length = 0; this.ctx.tweens.call(0.35, () => { for (const c of list) this.detonate(c); }); return; }\n    if (this.busy > 0 || game.gunSlung() || p.toolBusy) return;\n    if (p.charges > 0 && (p.molotovs <= 0 || game.prompt.chargePreferred())) { this.plant(); return; }\n    if (p.molotovs <= 0 && !game.cheats.infiniteAmmo) { game.prompt.flash('throw', 'NOTHING TO THROW'); return; }\n    if (!game.cheats.infiniteAmmo) p.molotovs--;\n    game.vm.playTool('Throw', ['tool-bottle']); p.toolBusy = 0.75; game.hud.touch();\n    game.audio.play('whoosh', { volume: 0.5 });\n    const eye = this.eye();\n    this.ctx.tweens.call(0.45, () => game.projectiles.spawn('bottle', eye.x + eye.dir[0], eye.y + eye.dir[1], eye.z + eye.dir[2], eye.dir[0], eye.dir[1] + 0.25, eye.dir[2], p));\n  }\n  plant() {\n    const game = this.game, p = this.p; p.charges--;\n    game.vm.playTool('Plant', ['tool-charge']); p.toolBusy = 1.3; game.audio.play('click');\n    const eye = this.eye(), x = eye.x + eye.dir[0] * 1.1, z = eye.z + eye.dir[2] * 1.1, y = game.world.land.heightAt(x, z);\n    const c = game.spawnCharge(x, y, z); p.planted.push(c); game.hud.touch();\n    game.events.emit('planted', c);\n  }\n  detonate(c) { this.game.removeCharge(c); this.explode(c.x, c.y + 0.3, c.z, THROWABLES.charge.blast, THROWABLES.charge.damage * TUNING.weaponDamage, this.p, { fire: 5, big: true, charge: true }); }\n  /** Bang. Everything near takes damage, grass lights, things shake. */\n  explode(x, y, z, r, dmg, by, o = {}) {\n    const game = this.game, ctx = this.ctx;\n    game.world.fire.ignite(x, z, o.fire ?? r * 0.7, by);\n    ctx.physics.explode([x, y, z], { radius: r * 2, impulse: 24 });\n    if (!game.settings.reduceFlashes || !o.big) ctx.engine.screen.shockwave([x, y, z], { radius: o.big ? 0.45 : 0.25, strength: o.big ? 1 : 0.6 });\n    ctx.particles.burst('blast', [x, y, z]); if (o.big) ctx.particles.burst('blast', [x, y + 2, z], { count: 40 });\n    ctx.lights.request({ position: [x, y + 2, z], color: 0xffa040, intensity: o.big ? 70 : 34, radius: o.big ? 70 : 34, lifetime: 0.4, priority: 5 });\n    game.world.decals.add('scorch', { x, y: game.world.land.heightAt(x, z) + 0.05, z }, { x: 0, y: 1, z: 0 }, { size: r });\n    const p = this.p, dp = Math.hypot(x - p.x, y - p.y, z - p.z);\n    game.audio.at(o.big ? 'explosion' : 'explosion-small', x, y, z, 500, 1);\n    ctx.engine.shake.add(clamp(1.2 - dp / (r * 8), 0, 0.9));\n    game.rumble(clamp(1 - dp / 60, 0.1, 1), 0.3);\n    for (const a of [...game.actors.list]) { if (!a.alive) continue; const d = Math.hypot(a.x - x, a.z - z, a.y + 1 - y); if (d < r) { const push = [(a.x - x) / (d || 1) * 7, 5, (a.z - z) / (d || 1) * 7]; game.damageActor(a, dmg * (1 - d / r * 0.7), { by, push, blast: true }); } else if (d < r * 2.5 && a.ctrl) a.dodgeT = 1; }\n    if (dp < r) game.damagePlayer(dmg * 0.6 * (1 - dp / r * 0.7), { by, blast: true, at: [x, y, z] });\n    for (const vh of game.vehicles.list) { const d = Math.hypot(vh.x - x, vh.z - z); if (d < r * 1.3) vh.damage(dmg * (1 - d / (r * 1.3) * 0.5), by, true); }\n    for (const d of game.world.destructibles) if (!d.destroyed && d.fuse < 0 && Math.hypot(d.x - x, d.z - z) < r + 1) { if (d.tag === 'pump' || d.tag === 'ammo-bunker' || d.tag === 'fuel-tank') game.world.hitProp(d, dmg * 0.8, by); else d.fuse = 0.2 + this.rng.range(0, 0.4); }\n    game.events.emit('explosion', x, y, z, r, by, o);\n    if (game.net) game.net.onExplosion?.(x, y, z, r, o);\n    game.actors.hearShot(x, z, 200, null);\n    game.world.shout(x, z);\n  }\n  flareImpact(x, y, z, hit, by) {\n    const game = this.game, owner = hit ? game.world.owners.get(hit.collider.handle) : null;\n    game.audio.at('flare-hiss', x, y, z, 60);\n    game.world.fire.ignite(x, z, 3, by);\n    this.ctx.particles.burst('sparks', [x, y, z], { count: 12 });\n    this.ctx.lights.request({ position: [x, y + 1, z], color: 0xff8030, intensity: 26, radius: 30, lifetime: 3, flicker: 'torch', priority: 3 });\n    if (owner?.type === 'actor' && owner.ref.alive) { game.damageActor(owner.ref, WEAPONS.flare.damage * TUNING.weaponDamage, { by, silent: true }); if (!owner.ref.friendly) { owner.ref.burning = 5; owner.ref.burnBy = by; } }\n    if (owner?.type === 'prop') owner.ref.fuse = owner.ref.fuse < 0 ? 0.5 : owner.ref.fuse;\n    if (game.net) game.net.onIgnite?.(x, z, 3, by);\n  }\n  bottleImpact(x, y, z, hit, by) {\n    const game = this.game, owner = hit ? game.world.owners.get(hit.collider.handle) : null;\n    game.audio.at('bottle-smash', x, y, z, 60);\n    game.world.fire.ignite(x, z, THROWABLES.molotov.ignite + 2, by);\n    this.ctx.particles.burst('blast', [x, y + 0.5, z], { count: 18 });\n    for (const a of game.actors.list) if (a.alive && Math.hypot(a.x - x, a.z - z) < 3.5 && !a.friendly) { a.burning = 5; a.burnBy = by; } else if (a.alive && a.ctrl && Math.hypot(a.x - x, a.z - z) < 10) a.dodgeT = 1;\n    for (const d of game.world.destructibles) if (!d.destroyed && Math.hypot(d.x - x, d.z - z) < d.spec.r * 0.6 + 2) d.fuse = d.fuse < 0 ? 1 : d.fuse;\n    void owner;\n    if (game.net) game.net.onIgnite?.(x, z, 4, by);\n  }\n  rocketImpact(x, y, z, hit, by) { const w = WEAPONS.tube; this.explode(x, y, z, w.blast, w.damage * TUNING.weaponDamage, by, { fire: 5, big: true, rocket: true }); void hit; }\n  /** A soldier fires at something. */\n  npcShot(a, t) {\n    const game = this.game, ph = this.ctx.physics, dx0 = t.x - a.x, dz0 = t.z - a.z, dist = Math.hypot(dx0, dz0);\n    let err = (1.2 + (5 - 1.2) * clamp(dist / 80, 0, 1)) / (TUNING.enemyAccuracy * (a.spec.accuracy ?? 1));\n    if (t.kind === 'player' && (t.speed2 ?? 0) > 4.8) err *= 1.4;\n    const e = (err * Math.PI) / 180, ax = this.rng.gaussian(0, e * 0.6), ay = this.rng.gaussian(0, e * 0.6);\n    from.set(a.x, a.y + 1.45, a.z);\n    const ty = t.y + (t.crouched ? 0.7 : 1.15);\n    dir.set(dx0, ty - from.y, dz0).normalize();\n    right.set(dir.z, 0, -dir.x).normalize(); up.crossVectors(dir, right);\n    dir.addScaledVector(right, ax).addScaledVector(up, ay).normalize();\n    const hit = ph.castRay(from, dir, a.spec.range * 1.2, undefined, a.ctrl?.body);\n    game.audio.at(a.role === 'mg' ? 'gun-mg' : a.role === 'sniper' ? 'gun-bolt' : 'gun-rifle', a.x, a.y + 1.4, a.z, 350, 0.75);\n    this.ctx.lights.request({ position: [a.x, a.y + 1.5, a.z], color: 0xffd090, intensity: 8, radius: 10, lifetime: 0.05, fadeIn: 0, fadeOut: 0.03 });\n    if (this.tracerRng.next() < 0.3) { const to = hit ? hit.point : v.set(from.x + dir.x * 120, from.y + dir.y * 120, from.z + dir.z * 120); game.tracers?.add(from.x, from.y, from.z, to.x, to.y, to.z); }\n    // Bullet whip when it passes close.\n    if (t.kind === 'player' && dist > 8 && this.tracerRng.next() < 0.35) game.audio.play('bullet-whip', { volume: 0.5, pan: this.tracerRng.range(-0.5, 0.5) });\n    if (!hit) return;\n    this.applyHit(hit, a.spec.damage ?? 9, a, { dir, from });\n  }\n  clear() { this.stopStream(); this.pendingReload = null; this.busy = 0; }\n}\nEOF\necho done","description":"Write rig, soldier AI, projectiles, viewmodel and weapons"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18160,"cache_read_input_tokens":349514,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18160},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"51adde36-d35e-455d-b051-efb1caee1011","timestamp":"2026-11-05T23:47:22.417Z","request_id":"req_011CgkfmKyv6yQq2ugW7qida","wire_tool_inputs":{"toolu_014wucpLTCEsKCTqgCrPbEtM":{"command":"cat > src/actors/rig.js <<'EOF'\n// A person's view: model on the hero rig, shared compiled clips, layered upper and lower body, ragdoll on death.\nimport { buildModel, compileClips, HERO_CLIPS, HERO_RAGDOLL, HERO_RIG, Ragdoll, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { CATALOG } from '../art/models.js';\nimport { PEOPLE_CLIPS } from '../art/clips.js';\nconst { AnimationClip, AnimationMixer, LoopOnce, LoopRepeat } = THREE;\nlet CLIPS = null, LOWER = null, UPPER = null;\nconst LEGS = /^(Pelvis|Leg|Shin|Foot)/;\nconst KEEP = ['Idle', 'IdleLook', 'Walk', 'Run', 'Crouch', 'CrouchWalk', 'Crawl', 'Sit', 'SitDown', 'StandUp', 'LieIdle', 'Sleep', 'Hurt', 'HitReact', 'Death', 'Wave', 'Shout', 'Push', 'Climb'];\nexport const RIG = { ...HERO_RIG, spine: undefined };\nfunction compile(object) {\n  if (CLIPS) return;\n  const defs = [...HERO_CLIPS.filter((c) => KEEP.includes(c.name)), ...PEOPLE_CLIPS];\n  const all = compileClips(defs, RIG, object);\n  CLIPS = {}; LOWER = {}; UPPER = {};\n  for (const c of all) {\n    CLIPS[c.name] = c;\n    LOWER[c.name] = new AnimationClip(`${c.name}:L`, c.duration, c.tracks.filter((t) => LEGS.test(t.name)));\n    UPPER[c.name] = new AnimationClip(`${c.name}:U`, c.duration, c.tracks.filter((t) => !LEGS.test(t.name)));\n  }\n}\nexport const clipNames = () => Object.keys(CLIPS ?? {});\nexport class PersonView {\n  constructor(ctx, modelId, palette, { gun = false } = {}) {\n    this.ctx = ctx;\n    const b = buildModel(modelId, { catalog: CATALOG, palette });\n    this.object = b.object;\n    compile(b.object);\n    setLookLayer(this.object, 'actors');\n    b.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.frustumCulled = false; } });\n    ctx.scene.add(this.object);\n    this.mixer = new AnimationMixer(this.object);\n    this.lower = null; this.upper = null; this.full = null;\n    if (gun) { const r = buildModel('rifle-npc', { catalog: CATALOG }); const hand = this.object.getObjectByName('HandR'); r.object.position.set(0, -0.06, 0.04); r.object.rotation.x = -0.3; r.object.traverse((o) => { if (o.isMesh) o.castShadow = false; }); hand.add(r.object); this.gun = r.object; }\n  }\n  action(table, name) { return this.mixer.clipAction(table[name]); }\n  setLower(name, speed = 1) { if (this.lowerName === name) { if (this.lower) this.lower.timeScale = speed; return; } this.stopFull(); const a = this.action(LOWER, name); a.reset().setLoop(LoopRepeat, Infinity).fadeIn(0.15).play(); a.timeScale = speed; this.lower?.fadeOut(0.15); this.lower = a; this.lowerName = name; }\n  setUpper(name) { if (this.upperName === name) return; this.stopFull(); const a = this.action(UPPER, name); a.reset().setLoop(LoopRepeat, Infinity).fadeIn(0.15).play(); this.upper?.fadeOut(0.15); this.upper = a; this.upperName = name; }\n  /** One-shot on the upper body (recoil, reload, swear). */\n  flashUpper(name, duration = 0) { const a = this.action(UPPER, name); a.reset().setLoop(LoopOnce, 1).setEffectiveWeight(1).play(); a.clampWhenFinished = false; if (duration) a.timeScale = a.getClip().duration / duration; return a; }\n  /** A whole-body clip, looped or once. */\n  setFull(name, once = false) {\n    if (this.fullName === name) return;\n    this.lower?.fadeOut(0.15); this.upper?.fadeOut(0.15); this.lower = this.upper = null; this.lowerName = this.upperName = null;\n    const a = this.action(CLIPS, name);\n    a.reset().setLoop(once ? LoopOnce : LoopRepeat, once ? 1 : Infinity); a.clampWhenFinished = once; a.fadeIn(0.15).play();\n    this.full?.fadeOut(0.15); this.full = a; this.fullName = name;\n  }\n  stopFull() { if (this.full) { this.full.fadeOut(0.15); this.full = null; this.fullName = null; } }\n  place(x, y, z, yaw) { this.object.position.set(x, y, z); this.object.rotation.y = yaw; }\n  update(dt) { if (!this.doll?.active) this.mixer.update(dt); else this.doll.sync(); }\n  ragdoll(velocity) {\n    if (this.doll) return;\n    this.mixer.stopAllAction();\n    this.object.updateMatrixWorld(true);\n    try { this.doll = new Ragdoll(this.ctx.physics, this.object, HERO_RAGDOLL); this.doll.enable({ velocity }); } catch { this.doll = null; this.setFull('Death', true); }\n  }\n  freeze() { if (this.doll?.active) this.doll.disable(); }\n  dispose() { this.freeze(); this.mixer.stopAllAction(); this.ctx.scene.remove(this.object); }\n}\nEOF\ncat > src/actors/soldier.js <<'EOF'\n// Soldiers, friends and puppets. Sim and view apart: a soldier is data plus an optional view.\nimport { BehaviorTree, bt, CharacterController, THREE } from '../../pixel-engine.js';\nimport { FACTION_PALETTES, SKINS } from '../art/models.js';\nimport { BARKS } from '../content/dialogue.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp, dist2 } from '../world/geom.js';\nimport { KIND, WATER_Y } from '../world/terrain.js';\nimport { PersonView } from './rig.js';\nconst { Vector3 } = THREE;\nconst HATS = { concord: ['soldier-beret', 'soldier-helmet'], harvest: ['soldier-cloth', 'soldier-helmet'], deserter: ['soldier-cloth', 'soldier-beret'] };\nconst ROLE = { rifle: { hp: 60, speed: 4.2, burst: [3, 5], rate: 7, range: 90 }, mg: { hp: 90, speed: 3.2, burst: [6, 10], rate: 9, range: 100 }, sniper: { hp: 50, speed: 3.4, burst: [1, 1], rate: 0.6, range: 220, accuracy: 2.2 }, rocket: { hp: 70, speed: 3.6, burst: [1, 1], rate: 0.2, range: 110 }, driver: { hp: 55, speed: 4.2, burst: [3, 5], rate: 7, range: 90 } };\nconst from = new Vector3(), dirV = new Vector3(), moveV = new Vector3();\nlet nextId = 1;\nexport class Actors {\n  list = []; byId = new Map(); pathBudget = 0; dropped = []; corpses = [];\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('actors'); this.barkClock = 0; }\n  /** A soldier in the world. `def`: { faction, role, x, z, duty, site, tag, friendly, name, modelId, palette, hp } */\n  spawn(def) {\n    const game = this.game, ctx = this.ctx, role = ROLE[def.role] ?? ROLE.rifle, r = this.rng;\n    const y = game.world.land.heightAt(def.x, def.z) + (def.y ?? 0);\n    const a = {\n      id: nextId++, kind: def.kind ?? 'soldier', faction: def.faction, role: def.role ?? 'rifle', spec: role, site: def.site ?? null, tag: def.tag ?? null,\n      x: def.x, y, z: def.z, yaw: def.yaw ?? r.range(0, 6.28), homeX: def.x, homeZ: def.z, duty: def.duty ?? 'guard', friendly: !!def.friendly, buddy: def.buddy ?? null,\n      hp: (def.hp ?? role.hp) * (def.friendly ? 1 : TUNING.enemyHealth), maxHp: 0, alive: true, state: 'idle', suspicion: 0, reaction: 0, burning: 0, burnPanic: 0, lastKnown: null, searchT: 0,\n      burstLeft: 0, nextShot: 0, repositionT: r.range(1, 4), cond: r.range(20, 70), jamT: 0, moveTo: null, path: null, pathI: 0, speedWanted: 0, fireAt: null, lookAtYaw: null, target: null, panicDir: null, down: false, downT: 0, flank: false, dodgeT: 0, stationary: def.duty === 'tower', y0: def.y ?? 0, barkT: 0,\n    };\n    a.maxHp = a.hp;\n    if (!def.puppet) {\n      a.ctrl = new CharacterController(ctx.physics, { position: [def.x, y + (def.y ?? 0) * 0 + 0.05, def.z], radius: 0.3, halfHeight: 0.55, speed: role.speed, jumpSpeed: 0, gravity: def.y ? 0 : -24 });\n      if (def.y) a.ctrl.body.setTranslation({ x: def.x, y: y + 0.85, z: def.z }, true);\n      ctx.physics.tag(a.ctrl.collider, 'npc');\n      game.world.own(a.ctrl.collider, 'actor', a);\n      a.tree = this.makeTree(a);\n      a.brainPhase = (a.id * 7) % 6;\n    }\n    const pal = def.palette ?? { ...FACTION_PALETTES[def.faction], skin: r.pick(SKINS) };\n    a.view = new PersonView(ctx, def.modelId ?? r.pick(HATS[def.faction] ?? HATS.concord), pal, { gun: !def.unarmed });\n    a.view.place(a.x, y + (def.y ?? 0) * 0, a.z, a.yaw);\n    a.view.setLower('Idle'); a.view.setUpper(a.duty === 'sit' ? 'Idle' : 'AimIdle');\n    if (a.duty === 'sit') a.view.setFull('Sit');\n    this.list.push(a); this.byId.set(a.id, a);\n    return a;\n  }\n  makeTree(a) {\n    const A = (n, f) => bt.action(n, f), C = (n, f) => bt.condition(n, f);\n    return new BehaviorTree(bt.selector('soldier',\n      bt.sequence('burning', C('on fire?', (s) => s.burning > 0), A('panic', (s, dt) => this.doPanic(s, dt))),\n      bt.sequence('fire near', C('fire upwind?', (s) => this.fireNear(s)), A('flee crosswind', (s) => this.doFleeFire(s))),\n      bt.sequence('blast near', C('dodge?', (s) => s.dodgeT > 0), A('dodge', (s, dt) => this.doDodge(s, dt))),\n      bt.sequence('combat', C('target?', (s) => s.state === 'alert'), A('fight', (s, dt) => this.doCombat(s, dt))),\n      bt.sequence('search', C('searching?', (s) => s.state === 'searching'), A('search', (s, dt) => this.doSearch(s, dt))),\n      A('duty', (s, dt) => this.doDuty(s, dt)),\n    ), a);\n  }\n  /** Is this actor allowed to shoot at that target right now? */\n  hostileTo(a, t) {\n    if (t.kind === 'player') return this.game.isHostileToPlayer(a, t);\n    if (a.friendly) return !t.friendly && t.faction !== 'none';\n    if (t.friendly) return true;\n    return this.game.warOn && t.faction !== a.faction;\n  }\n  targetsOf(a) { return this.game.targetsFor(a); }\n  perceive(a, dt) {\n    if (a.burning > 0) return;\n    const game = this.game, night = game.world.isNight();\n    let best = null, bestD = 1e9, seen = 0;\n    for (const t of this.targetsOf(a)) {\n      if (!this.hostileTo(a, t) || t.hidden) continue;\n      const d = Math.hypot(t.x - a.x, t.z - a.z);\n      let range = TUNING.enemyVision * (a.role === 'sniper' ? 1.6 : 1);\n      if (t.kind === 'player') {\n        range *= t.crouched ? 0.55 : 1;\n        if (game.world.tallGrassAt(t.x, t.z) && t.crouched) range *= 0.6 / 0.55;\n        if (night && !t.lit) range *= 0.45; else if (night && t.lit) range *= 0.9;\n      } else if (night) range *= 0.6;\n      if (d > range) continue;\n      const toYaw = Math.atan2(t.x - a.x, t.z - a.z);\n      let dy = toYaw - a.yaw; dy = Math.atan2(Math.sin(dy), Math.cos(dy));\n      if (Math.abs(dy) > (60 * Math.PI) / 180 && d > 6 && a.state !== 'alert') continue;\n      if (!this.los(a, t)) continue;\n      if (d < bestD) { bestD = d; best = t; seen = 1 - d / range; }\n    }\n    a.target = best;\n    if (best) {\n      a.lastKnown = [best.x, best.z];\n      a.suspicion = clamp(a.suspicion + dt * (0.45 + seen * 1.4) * (a.state === 'alert' ? 4 : 1), 0, 1.2);\n      a.seenT = 0;\n      if (a.suspicion >= 1 && a.state !== 'alert') this.alert(a, best);\n      else if (a.suspicion > 0.2 && a.state === 'idle') a.state = 'suspicious';\n    } else {\n      a.seenT = (a.seenT ?? 0) + dt;\n      a.suspicion = Math.max(0, a.suspicion - dt * 0.25);\n      if (a.state === 'alert' && a.seenT > 5) { a.state = 'searching'; a.searchT = 20; this.bark(a, 'lost'); }\n      if (a.state === 'suspicious' && a.suspicion <= 0) a.state = 'idle';\n    }\n  }\n  alert(a, t) {\n    a.state = 'alert'; a.suspicion = 1.2; a.reaction = TUNING.enemyReaction;\n    if (t) a.lastKnown = [t.x, t.z];\n    this.bark(a, 'spotted');\n    // Squad members share the last known position.\n    for (const o of this.list) if (o !== a && o.alive && o.ctrl && o.faction === a.faction && Math.hypot(o.x - a.x, o.z - a.z) < 60 && o.state !== 'alert' && o.burning <= 0) { o.state = 'alert'; o.reaction = TUNING.enemyReaction + 0.3; o.lastKnown = a.lastKnown; o.suspicion = 1; }\n    this.game.onAlert?.(a);\n  }\n  los(a, t) {\n    from.set(a.x, a.y + 1.5, a.z);\n    const ty = t.y + (t.crouched ? 0.7 : 1.3);\n    dirV.set(t.x - a.x, ty - from.y, t.z - a.z);\n    const d = dirV.length(); dirV.divideScalar(d || 1);\n    const hit = this.ctx.physics.castRay(from, dirV, d, undefined, a.ctrl?.body);\n    if (!hit) return true;\n    if (hit.distance >= d - 0.6) return true;\n    const owner = this.game.world.owners.get(hit.collider.handle);\n    if (owner?.type === 'player' || owner?.ref === t) return true;\n    return owner?.type === 'vehicle' && t.vehicle === owner.ref;\n  }\n  hearShot(x, z, radius, faction) {\n    for (const a of this.list) {\n      if (!a.alive || !a.ctrl || a.friendly || a.burning > 0) continue;\n      if (a.state === 'alert') continue;\n      if (Math.hypot(a.x - x, a.z - z) < radius) { a.lastKnown = [x, z]; if (a.state === 'idle' || a.state === 'suspicious') { a.state = 'searching'; a.searchT = 20; } }\n    }\n    void faction;\n  }\n  fireNear(a) {\n    const f = this.game.world.fire, w = this.game.world.wind;\n    if (f.burning.length === 0) return false;\n    if (f.isBurning(a.x, a.z)) return true;\n    for (let d = 5; d <= 15; d += 5) if (f.isBurning(a.x - w.x * d, a.z - w.z * d)) return true;\n    return false;\n  }\n  doFleeFire(a) { const w = this.game.world.wind, side = a.id % 2 ? 1 : -1; a.moveTo = [a.x - w.z * side * 14 + w.x * -6, a.z + w.x * side * 14 + w.z * -6]; a.path = null; a.speedWanted = 1.25; a.fireAt = null; a.fleeingFire = 1; if (this.rng.next() < 0.02) this.bark(a, 'fire'); return 'running'; }\n  doPanic(a, dt) {\n    a.burning -= dt; a.fireAt = null;\n    if (!a.panicDir || this.rng.next() < dt * 2) { const k = this.rng.range(0, 6.28); a.panicDir = [Math.cos(k), Math.sin(k)]; }\n    a.moveTo = [a.x + a.panicDir[0] * 6, a.z + a.panicDir[1] * 6]; a.speedWanted = 1.3; a.path = null;\n    this.game.world.fire.ignite(a.x, a.z, 1);\n    this.damage(a, (a.maxHp / 5) * dt, { fire: true, by: a.burnBy, silent: true });\n    return 'running';\n  }\n  doDodge(a, dt) { a.dodgeT -= dt; a.speedWanted = 1.2; a.fireAt = null; return 'running'; }\n  doCombat(a, dt) {\n    const t = a.target;\n    a.reaction = Math.max(0, a.reaction - dt);\n    if (a.jamT > 0) { a.jamT -= dt; a.fireAt = null; a.speedWanted = 0; return 'running'; }\n    if (t) {\n      a.lookAtYaw = Math.atan2(t.x - a.x, t.z - a.z);\n      if (a.reaction <= 0 && !a.stationaryLock) {\n        const d = Math.hypot(t.x - a.x, t.z - a.z);\n        if (d < a.spec.range) { a.fireAt = t; if (a.burstLeft <= 0 && a.nextBurst <= 0) { a.burstLeft = this.rng.int(a.spec.burst[0], a.spec.burst[1]); a.nextBurst = this.rng.range(0.7, 1.8); } }\n      }\n    } else a.fireAt = null;\n    a.nextBurst = (a.nextBurst ?? 0) - dt;\n    if (a.stationary) { a.speedWanted = 0; return 'running'; }\n    a.repositionT -= dt;\n    if (a.repositionT <= 0 || (!a.moveTo && !t)) {\n      a.repositionT = this.rng.range(4, 8);\n      const lk = t ? [t.x, t.z] : a.lastKnown ?? [a.x, a.z];\n      const cover = this.findCover(a, lk);\n      if (cover) this.goTo(a, cover[0], cover[1]);\n      else if (a.id % 3 === 0) { const side = a.id % 2 ? 1 : -1, ang = Math.atan2(lk[1] - a.z, lk[0] - a.x) + side * 1.1; this.goTo(a, lk[0] - Math.cos(ang) * 22, lk[1] - Math.sin(ang) * 22); } // the flanker\n      else this.goTo(a, a.x + this.rng.range(-8, 8) + (lk[0] - a.x) * 0.25, a.z + this.rng.range(-8, 8) + (lk[1] - a.z) * 0.25);\n      a.speedWanted = 1;\n    }\n    return 'running';\n  }\n  findCover(a, threat) {\n    const site = a.site ? this.game.world.sites[a.site] : null; if (!site) return null;\n    const cover = site.coverPoints ??= (site.def.props ?? []).filter((p) => ['sandbags', 'crate', 'crate-stack', 'oil-drum', 'barrel', 'shack'].includes(p[0])).map((p) => [site.def.at[0] + p[1], site.def.at[1] + p[2]]);\n    let best = null, bd = 1e9;\n    for (const c of cover) { const d = dist2(c[0], c[1], a.x, a.z); if (d < 14 && d < bd) { const l = Math.hypot(c[0] - threat[0], c[1] - threat[1]) || 1; best = [c[0] + ((c[0] - threat[0]) / l) * 1.3, c[1] + ((c[1] - threat[1]) / l) * 1.3]; bd = d; } }\n    return best;\n  }\n  doSearch(a, dt) {\n    a.fireAt = null; a.searchT -= dt;\n    if (a.lastKnown && !a.stationary && (!a.moveTo || a.searchGo !== a.lastKnown)) { a.searchGo = a.lastKnown; this.goTo(a, a.lastKnown[0] + this.rng.range(-4, 4), a.lastKnown[1] + this.rng.range(-4, 4)); }\n    a.speedWanted = 0.7;\n    if (a.searchT <= 0) { a.state = 'idle'; a.lastKnown = null; a.moveTo = null; a.path = null; }\n    return 'running';\n  }\n  doDuty(a, dt) {\n    a.fireAt = null;\n    const night = this.game.world.isNight();\n    if (a.duty === 'patrol') {\n      a.speedWanted = 0.45;\n      if (!a.moveTo) { a.waitT = (a.waitT ?? 0) - dt; if (a.waitT <= 0) { const R = 16; this.goTo(a, a.homeX + this.rng.range(-R, R), a.homeZ + this.rng.range(-R, R)); a.waitT = this.rng.range(2, 6); } }\n    } else if (a.duty === 'follow') {\n      const p = this.game.player;\n      if (dist2(a.x, a.z, p.x, p.z) > 8) { a.moveTo = [p.x + 3, p.z + 3]; a.path = null; a.speedWanted = 1.2; } else a.moveTo = null;\n    } else if (a.duty === 'walkTo' && a.goal) { this.goTo(a, a.goal[0], a.goal[1]); a.speedWanted = a.goalSpeed ?? 1; } else { a.speedWanted = 0; }\n    a.asleep = night && a.duty === 'sit';\n    return 'running';\n  }\n  goTo(a, x, z) { a.moveTo = [x, z]; a.path = null; a.pathI = 0; a.wantPath = true; }\n  fixed(dt) {\n    const game = this.game; this.pathBudget = 2;\n    const stepPhase = game.world.stepCount % 6;\n    for (const a of this.list) {\n      if (!a.alive) continue;\n      if (a.down) { this.fixedDown(a, dt); continue; }\n      if (!a.ctrl) continue;\n      if (a.brainPhase === stepPhase) { this.perceive(a, 0.1); a.tree.tick(0.1); }\n      // Fire on this cell lights people.\n      if (a.burning <= 0 && !a.fireproof && game.world.fire.isBurning(a.x, a.z)) { a.burning = 5; a.burnPanic = 1; a.state = 'burning'; this.bark(a, 'fire', true); game.audio.scream(a); }\n      this.move(a, dt);\n      this.shoot(a, dt);\n      a.barkT -= dt;\n    }\n    for (let i = this.corpses.length - 1; i >= 0; i--) { const c = this.corpses[i]; c.t -= dt; if (c.t < 34 && !c.frozen) { c.frozen = true; c.view.freeze(); } if (c.t <= 0) { c.view.dispose(); this.corpses.splice(i, 1); } }\n  }\n  move(a, dt) {\n    const ctrl = a.ctrl; let mx = 0, mz = 0;\n    if (a.wantPath && this.pathBudget > 0 && this.game.nav && a.moveTo) {\n      a.wantPath = false; this.pathBudget--;\n      if (dist2(a.x, a.z, a.moveTo[0], a.moveTo[1]) > 14) { const p = this.game.nav.path([a.x, 0, a.z], [a.moveTo[0], 0, a.moveTo[1]]); if (p?.length) { a.path = p; a.pathI = 0; } }\n    }\n    let gx = null, gz = null;\n    if (a.path && a.pathI < a.path.length) { gx = a.path[a.pathI][0]; gz = a.path[a.pathI][2]; if (dist2(a.x, a.z, gx, gz) < 1.4) { a.pathI++; if (a.pathI >= a.path.length) { a.path = null; a.moveTo = null; gx = gz = null; } } }\n    else if (a.moveTo) { gx = a.moveTo[0]; gz = a.moveTo[1]; if (dist2(a.x, a.z, gx, gz) < 1.0) { a.moveTo = null; gx = gz = null; } }\n    const speed = a.speedWanted ?? 0;\n    if (gx !== null && speed > 0) {\n      const dx = gx - a.x, dz = gz - a.z, l = Math.hypot(dx, dz) || 1;\n      mx = (dx / l) * Math.min(1, speed); mz = (dz / l) * Math.min(1, speed);\n      if (!a.fireAt && a.lookAtYaw === null) a.yawGoal = Math.atan2(dx, dz);\n      else a.yawGoal = a.lookAtYaw ?? Math.atan2(dx, dz);\n    } else if (a.lookAtYaw !== null) a.yawGoal = a.lookAtYaw;\n    a.lookAtYaw = null;\n    ctrl.speed = a.spec.speed * Math.max(1, speed) * (this.game.world.land.waterDepth(a.x, a.z) > 0.3 ? 0.6 : 1);\n    if (!a.stationary) { moveV.set(mx, 0, mz); ctrl.setInput(moveV, false, false); ctrl.fixedUpdate(dt); }\n    const f = a.stationary ? null : ctrl.feet;\n    if (f) { a.x = f.x; a.y = f.y; a.z = f.z; }\n    a.moving = Math.hypot(mx, mz) > 0.05;\n    if (a.yawGoal !== undefined) { let d = a.yawGoal - a.yaw; d = Math.atan2(Math.sin(d), Math.cos(d)); a.yaw += clamp(d, -5 * dt, 5 * dt); }\n    a.runFrac = speed;\n  }\n  shoot(a, dt) {\n    a.nextShot -= dt;\n    const t = a.fireAt;\n    if (!t || a.burstLeft <= 0 || a.nextShot > 0 || a.burning > 0) return;\n    a.nextShot = 1 / a.spec.rate; a.burstLeft--;\n    // Their guns jam too. That is an opening.\n    a.cond = Math.max(0, a.cond - 0.15);\n    const jam = TUNING.jamRate * 0.12 * (1 - a.cond / 100) ** 2 * 0.2;\n    if (this.rng.next() < jam) { a.jamT = 3; a.burstLeft = 0; a.view?.flashUpper('UnjamSwear'); this.bark(a, 'jammed', true); this.game.audio.at('jam-click', a.x, a.y + 1, a.z, 40); return; }\n    this.game.combat.npcShot(a, t);\n    if (a.view) a.view.flashUpper('FireRecoil');\n  }\n  /** Damage. `o`: { by, fire, zone, silent, push } */\n  damage(a, dmg, o = {}) {\n    if (!a.alive || a.down) return;\n    if (a.invulnerable) return;\n    a.hp -= dmg;\n    if (a.ctrl && o.by && o.by.kind === 'player') { a.lastKnown = [o.by.x, o.by.z]; if (a.state !== 'alert' && !a.friendly) { this.alert(a, o.by); } a.provokedBy = true; }\n    if (a.hp <= 0) { if (a.buddy) this.goDown(a, o); else this.kill(a, o); return; }\n    if (!o.silent && a.view) { a.view.flashUpper('HitReact'); }\n  }\n  goDown(a, o = {}) {\n    a.hp = 0; a.down = true; a.downT = 40; a.burningDown = !!o.fire; a.moveTo = null; a.fireAt = null;\n    a.view?.setFull('WoundedSit');\n    this.game.buddies.onDown(a, o);\n  }\n  fixedDown(a, dt) { a.downT -= dt; if (a.downT <= 0) { a.down = false; this.kill(a, { silent: true, bledOut: true }); } }\n  kill(a, o = {}) {\n    if (!a.alive) return;\n    a.alive = false; a.state = 'dead';\n    if (a.ctrl) { this.game.world.owners.delete(a.ctrl.collider.handle); this.ctx.physics.remove(a.ctrl.body); a.ctrl = null; }\n    const game = this.game;\n    game.events.emit('actorDied', a, o);\n    if (!o.silent) this.barkNearby(a, 'down');\n    if (a.view) {\n      if (o.fire || !o.push || Math.hypot(a.x - game.player.x, a.z - game.player.z) > 70) a.view.setFull('Death', true);\n      else a.view.ragdoll(o.push);\n      this.corpses.push({ view: a.view, t: 40 });\n      if (this.corpses.length > 30) { const c = this.corpses.shift(); c.view.dispose(); }\n      a.view = null;\n    }\n    this.byId.delete(a.id);\n    const i = this.list.indexOf(a); if (i >= 0) this.list.splice(i, 1);\n    if (a.site) { const s = game.world.sites[a.site]; if (s) { s.actors = s.actors.filter((x) => x !== a); game.onSiteCheck?.(s); } }\n  }\n  remove(a) { if (a.ctrl) { this.game.world.owners.delete(a.ctrl.collider.handle); this.ctx.physics.remove(a.ctrl.body); a.ctrl = null; } a.view?.dispose(); a.view = null; a.alive = false; this.byId.delete(a.id); const i = this.list.indexOf(a); if (i >= 0) this.list.splice(i, 1); }\n  clear() { for (const a of [...this.list]) this.remove(a); for (const c of this.corpses) c.view.dispose(); this.corpses.length = 0; }\n  bark(a, kind, force) {\n    if (a.friendly && !a.buddy) return; const set = BARKS[a.faction]?.[kind] ?? BARKS.concord[kind]; if (!set) return;\n    if (!force && a.barkT > 0) return; a.barkT = 5;\n    if (this.rng.next() > 0.65 && !force) return;\n    if (a.buddy) return;\n    const p = this.game.player, d = Math.hypot(a.x - p.x, a.z - p.z); if (d > 70) return;\n    const text = this.rng.pick(set);\n    this.game.audio.voiceAt('soldier', text, a, a.id);\n    if (d < 40) this.game.talk.bark('SOLDIER', text);\n  }\n  barkNearby(a, kind) { for (const o of this.list) if (o.alive && o.faction === a.faction && Math.hypot(o.x - a.x, o.z - a.z) < 30) { this.bark(o, kind); break; } }\n  update(dt) {\n    const camX = this.game.camX ?? 0, camZ = this.game.camZ ?? 0;\n    for (const a of this.list) {\n      if (!a.view) continue;\n      const dist = Math.hypot(a.x - camX, a.z - camZ);\n      a.view.object.visible = dist < 400;\n      if (dist > 400) continue;\n      const v = a.view;\n      if (a.down) { v.place(a.x, a.y, a.z, a.yaw); v.update(dt); continue; }\n      v.place(a.x, a.stationary ? this.game.world.land.heightAt(a.x, a.z) + (a.y0 ?? 0) : a.y, a.z, a.yaw);\n      if (a.burning > 0) v.setFull('BurnPanic');\n      else if (a.asleep && a.state === 'idle') v.setFull('Sleep');\n      else if (a.duty === 'sit' && a.state === 'idle') v.setFull('Sit');\n      else {\n        const run = a.moving && a.runFrac > 0.8, walk = a.moving;\n        v.setLower(run ? 'Run' : walk ? 'Walk' : 'Idle', run ? 1.1 : 1);\n        v.setUpper(a.state === 'alert' || a.state === 'searching' || a.state === 'suspicious' ? (walk ? 'AimWalk' : 'AimIdle') : 'AimIdle');\n      }\n      v.update(dt);\n    }\n    for (const c of this.corpses) c.view.update(dt);\n  }\n  /** Projected ? and ! over heads, close by. */\n  overheads() { return this.list.filter((a) => a.alive && !a.friendly && a.ctrl && (a.state === 'suspicious' || a.state === 'alert') && Math.hypot(a.x - this.game.player.x, a.z - this.game.player.z) < 45); }\n}\nexport { KIND, WATER_Y };\nEOF\ncat > src/combat/projectiles.js <<'EOF'\n// Things that fly: flares, bottles, rockets. A ray per fixed step.\nimport { buildModel, THREE, setLookLayer } from '../../pixel-engine.js';\nimport { CATALOG } from '../art/models.js';\nconst { Vector3 } = THREE;\nconst dir = new Vector3(), from = new Vector3();\nconst KINDS = {\n  flare: { speed: 34, gravity: 12, palette: { body: 'orange', tip: 'white' }, scale: 0.7, light: 0xffa050, life: 7 },\n  bottle: { speed: 18, gravity: 14, palette: { body: 'green', tip: 'orange' }, scale: 1.1, life: 6 },\n  rocket: { speed: 62, gravity: 0.6, palette: { body: 'night', tip: 'white' }, scale: 1.4, light: 0xffe0a0, life: 5 },\n};\nexport class Projectiles {\n  list = [];\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; }\n  spawn(kind, x, y, z, dx, dy, dz, by) {\n    const k = KINDS[kind], b = buildModel('projectile', { catalog: CATALOG, palette: k.palette });\n    b.object.scale.setScalar(k.scale); setLookLayer(b.object, 'actors'); b.object.position.set(x, y, z);\n    this.ctx.scene.add(b.object);\n    const p = { kind, x, y, z, vx: dx * k.speed, vy: dy * k.speed, vz: dz * k.speed, life: k.life, by, object: b.object, g: k.gravity };\n    if (k.light) p.light = this.ctx.lights.request({ follow: b.object, color: k.light, intensity: 12, radius: 24, flicker: 'torch', priority: 3 });\n    this.list.push(p);\n    return p;\n  }\n  fixed(dt) {\n    const ph = this.ctx.physics;\n    for (let i = this.list.length - 1; i >= 0; i--) {\n      const p = this.list[i];\n      p.vy -= p.g * dt; p.life -= dt;\n      const sp = Math.hypot(p.vx, p.vy, p.vz), step = sp * dt;\n      from.set(p.x, p.y, p.z); dir.set(p.vx / sp, p.vy / sp, p.vz / sp);\n      const hit = ph.castRay(from, dir, step, undefined, this.game.player.ctrl?.body);\n      if (hit || p.life <= 0 || p.y < -10) { const q = hit ? hit.point : from; this.impact(p, q.x, q.y, q.z, hit); this.ctx.scene.remove(p.object); p.light?.release(); this.list.splice(i, 1); continue; }\n      p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt;\n    }\n  }\n  update() { for (const p of this.list) { p.object.position.set(p.x, p.y, p.z); p.object.lookAt(p.x + p.vx, p.y + p.vy, p.z + p.vz); if (p.kind !== 'bottle') this.ctx.particles.burst('gun-smoke', [p.x, p.y, p.z], { count: 1 }); } }\n  impact(p, x, y, z, hit) {\n    const combat = this.game.combat;\n    if (p.kind === 'flare') combat.flareImpact(x, y, z, hit, p.by);\n    else if (p.kind === 'bottle') combat.bottleImpact(x, y, z, hit, p.by);\n    else combat.rocketImpact(x, y, z, hit, p.by);\n  }\n  clear() { for (const p of this.list) { this.ctx.scene.remove(p.object); p.light?.release(); } this.list.length = 0; }\n}\nEOF\ncat > src/combat/viewmodel.js <<'EOF'\n// Everything you see in your own hands. Attached to the camera; one rig per gun, one for tools, one for the map.\nimport { buildModel, compileClips, setLookLayer, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { CATALOG } from '../art/models.js';\nimport { GUN_CLIPS, TOOL_CLIPS } from '../art/clips.js';\nimport { GUN_RIG, GUN_VIEWMODELS, handsMap, TOOL_RIG, vmDash, vmMg, vmTools } from '../art/viewmodels.js';\nimport { clamp, lerp } from '../world/geom.js';\nconst { AnimationMixer, Group, LoopOnce, LoopRepeat, Mesh, PlaneGeometry } = THREE;\nconst TOOL_ITEMS = ['tool-syrette', 'tool-pliers', 'tool-knife', 'tool-lighter', 'tool-wrench', 'tool-detonator', 'tool-bottle', 'tool-charge', 'tool-tablet', 'tool-revolver', 'tool-tablets', 'tool-tracker', 'tool-monocular', 'prop-forearm', 'prop-thigh', 'prop-burn'];\nexport class ViewModel {\n  rigs = {}; current = null; raise = 0; adsK = 0; bobT = 0; lower = 0; lowerGoal = 0; mapUp = 0; toolName = null; toolT = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.ctx = ctx;\n    const cam = ctx.camera.camera;\n    ctx.scene.add(cam);\n    this.group = new Group(); cam.add(this.group); setLookLayer(this.group, 'actors');\n    const make = (def, clips, rig) => {\n      const b = buildModel(def, { catalog: CATALOG });\n      b.object.rotation.y = Math.PI;\n      b.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.receiveShadow = false; o.frustumCulled = false; } });\n      b.object.visible = false;\n      this.group.add(b.object);\n      const mixer = new AnimationMixer(b.object), compiled = compileClips(clips, rig, b.object);\n      const actions = Object.fromEntries(compiled.map((c) => [c.name, mixer.clipAction(c)]));\n      return { object: b.object, mixer, actions, cur: null, rust: b.object.getObjectByName('Rust'), tape: b.object.getObjectByName('Tape') };\n    };\n    for (const [id, def] of Object.entries(GUN_VIEWMODELS)) this.rigs[id] = make(def, GUN_CLIPS[id], GUN_RIG);\n    this.rigs.mg = make(vmMg, GUN_CLIPS.mg, GUN_RIG);\n    this.tools = make(vmTools, TOOL_CLIPS, TOOL_RIG);\n    this.items = Object.fromEntries(TOOL_ITEMS.map((n) => [n, this.tools.object.getObjectByName(n)]));\n    this.finger = this.tools.object.getObjectByName('Finger');\n    this.led = this.tools.object.getObjectByName('tracker-led');\n    for (const it of Object.values(this.items)) it.visible = false;\n    // The wheel and dash are drawn with the truck you sit in.\n    const dash = buildModel(vmDash, { catalog: CATALOG });\n    this.dash = dash.object; this.dash.rotation.y = Math.PI; this.dash.visible = false; this.dash.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n    this.group.add(this.dash); this.wheelNode = this.dash.getObjectByName('Wheel'); this.arrowNode = this.dash.getObjectByName('Arrow');\n    // The map in your hands.\n    const hands = buildModel(handsMap, { catalog: CATALOG }); hands.object.rotation.y = Math.PI; hands.object.position.set(0, -0.2, -0.43); hands.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n    this.mapGroup = new Group(); this.mapGroup.visible = false; this.group.add(this.mapGroup); this.mapGroup.add(hands.object);\n    this.mapPlane = new Mesh(new PlaneGeometry(0.5, 0.375), toonMaterial(0xffffff, { map: this.game.mapTex.texture }));\n    this.mapPlane.position.set(0, -0.015, -0.42); this.mapPlane.rotation.x = -0.14; this.mapPlane.castShadow = false; this.mapPlane.frustumCulled = false;\n    this.mapGroup.add(this.mapPlane);\n  }\n  show(id) {\n    if (this.current === id) return;\n    const cur = this.rigs[this.current]; if (cur) { cur.object.visible = false; }\n    this.current = id;\n    const next = this.rigs[id]; if (!next) return;\n    next.object.visible = !this.hideGun;\n    this.playGun('Equip', true); this.queueIdle = true;\n  }\n  playGun(name, once, fade = 0.04) {\n    const r = this.rigs[this.current]; if (!r) return 0; const a = r.actions[name]; if (!a) return 0;\n    if (r.cur && r.cur !== a) r.cur.fadeOut(fade);\n    a.reset().setLoop(once ? LoopOnce : LoopRepeat, once ? 1 : Infinity); a.clampWhenFinished = once; a.fadeIn(fade).play(); r.cur = a; r.curOnce = once; r.curName = name;\n    return a.getClip().duration;\n  }\n  /** Rust and tape show on the gun itself. No numbers. */\n  setCondition(id, cond) { const r = this.rigs[id]; if (!r) return; if (r.rust) r.rust.visible = cond < 60; if (r.tape) r.tape.visible = cond < 30; }\n  /** A tool clip: items shown, the gun lowered away. */\n  playTool(clip, items = [], { hideGun = true, loop = false } = {}) {\n    for (const it of Object.values(this.items)) it.visible = false;\n    for (const n of items) if (this.items[n]) this.items[n].visible = true;\n    const t = this.tools; t.object.visible = true;\n    const a = t.actions[clip]; if (!a) return 0;\n    if (t.cur && t.cur !== a) t.cur.fadeOut(0.06);\n    a.reset().setLoop(loop ? LoopRepeat : LoopOnce, loop ? Infinity : 1); a.clampWhenFinished = !loop; a.fadeIn(0.06).play(); t.cur = a; t.curName = clip;\n    this.toolName = clip; this.toolT = loop ? Infinity : a.getClip().duration;\n    this.hideGun = hideGun; const r = this.rigs[this.current]; if (r) r.object.visible = !hideGun;\n    return a.getClip().duration;\n  }\n  endTool() { this.toolName = null; this.toolT = 0; this.tools.object.visible = false; this.hideGun = false; const r = this.rigs[this.current]; if (r) r.object.visible = !this.allHidden; }\n  update(dt, st) {\n    const g = this.game, r = this.rigs[this.current];\n    this.bobT += dt * (st.speed > 0.2 ? 6 + st.speed * 1.2 : 1.2);\n    const swayX = Math.sin(this.bobT) * 0.006 * clamp(st.speed / 5, 0.15, 1.4), swayY = Math.abs(Math.cos(this.bobT)) * 0.01 * clamp(st.speed / 5, 0.1, 1.4);\n    this.adsK = lerp(this.adsK, st.ads ? 1 : 0, clamp(dt * 14, 0, 1));\n    this.lower = lerp(this.lower, st.lowered ? 1 : 0, clamp(dt * 8, 0, 1));\n    const feverSway = st.fever * 0.03;\n    const gx = lerp(swayX, 0.127, this.adsK) + Math.sin(this.bobT * 0.31) * feverSway, gy = lerp(-swayY, 0.09, this.adsK) - this.lower * 0.34 + (st.landDip ?? 0) + Math.cos(this.bobT * 0.23) * feverSway;\n    this.group.position.set(gx, gy + (st.crouchDip ?? 0), lerp(0, 0.1, this.adsK) + (st.kick ?? 0));\n    this.group.rotation.x = st.scoped ? 0 : this.lower * -0.6;\n    this.group.visible = !st.hidden;\n    if (r) { r.object.visible = !this.hideGun && !st.hideGun && !st.scoped; r.mixer.update(dt); if (r.curOnce && r.cur && !r.cur.isRunning()) { const id = r.actions.Idle; if (id) { r.cur.fadeOut(0.1); id.reset().setLoop(LoopRepeat, Infinity).fadeIn(0.1).play(); r.cur = id; r.curOnce = false; r.curName = 'Idle'; } } }\n    if (this.tools.object.visible) { this.tools.mixer.update(dt); this.toolT -= dt; if (this.toolT <= 0 && this.toolName) { this.endTool(); g.events.emit('toolEnd'); } }\n    // The map rises and falls in 0.4 s.\n    const up = st.mapUp ? 1 : 0;\n    this.mapUp = clamp(this.mapUp + Math.sign(up - this.mapUp) * dt / 0.4, 0, 1);\n    const e = this.mapUp * this.mapUp * (3 - 2 * this.mapUp);\n    this.mapGroup.visible = e > 0.01; this.mapGroup.position.set(0, -0.5 * (1 - e) - this.group.position.y - (st.crouchDip ?? 0), 0.02);\n    this.mapGroup.rotation.x = -(1 - e) * 0.8 + st.fever * 0.04 * Math.sin(this.bobT * 0.4);\n    this.mapPlane.material.color?.setScalar(1);\n    this.dash.visible = !!st.dash;\n    if (st.dash) { this.dash.position.set(0, -0.0 - this.group.position.y + 0.04, 0.04); this.wheelNode.rotation.z = (st.wheel ?? 0) * 1.5; this.arrowNode.rotation.y = st.arrowYaw ?? 0; }\n  }\n}\nEOF\ncat > src/combat/weapons.js <<'EOF'\n// Guns, wear, jams, shots, blasts. The source's spirit made precise (section 8).\nimport { THREE } from '../../pixel-engine.js';\nimport { THROWABLES, WEAPONS } from '../content/weapons.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp, dist2 } from '../world/geom.js';\nconst { Vector3 } = THREE;\nconst from = new Vector3(), dir = new Vector3(), v = new Vector3(), right = new Vector3(), up = new Vector3();\nexport const jamChance = (cond) => TUNING.jamRate * 0.12 * (1 - cond / 100) ** 2;\nexport class Combat {\n  fireTimer = 0; busy = 0; busyKind = null; heat = 0; overheated = false; shotsFired = 0; hitMark = 0; tracerN = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('combat'); this.tracerRng = ctx.random.fork('tracers'); this.tracers = []; ctx.audio; }\n  get p() { return this.game.player; }\n  newGun(id, cond = 100) { const w = WEAPONS[id]; const belt = this.p.upgrades?.belt ? 1.5 : 1; return { id, cond, mag: w.mag ?? 0, reserve: Math.round((w.reserve ?? 0) * belt), jammed: false, jamLeft: 0 }; }\n  give(id, cond = 100, select = true) {\n    const p = this.p, w = WEAPONS[id]; if (!w) return;\n    const g = this.newGun(id, cond);\n    p.guns[w.slot] = g;\n    if (select) this.select(w.slot, true);\n    this.game.vm.setCondition(id, cond);\n    return g;\n  }\n  select(slot, force) {\n    const p = this.p; if (!p.guns[slot] && !force) return;\n    if (!p.guns[slot]) return;\n    p.slot = slot; const g = p.guns[slot]; this.busy = Math.max(this.busy, 0.3); this.busyKind = 'equip';\n    this.game.vm.show(g.id); this.game.vm.setCondition(g.id, g.cond);\n    this.game.audio.play('magazine', { volume: 0.4 });\n    this.game.hud.touch();\n  }\n  nextWeapon(dirn = 1) {\n    const order = ['main', 'sidearm', 'special', 'melee'], p = this.p; const i = order.indexOf(p.slot);\n    for (let k = 1; k <= 4; k++) { const s = order[(i + k * dirn + 8) % 4]; if (p.guns[s]) { this.select(s); return; } }\n  }\n  current() { const p = this.p; if (p.mounted) return p.mountGun; return p.guns[p.slot] ?? p.guns.melee; }\n  /** One fixed step of the player's weapon. */\n  fixed(dt) {\n    const p = this.p, input = this.ctx.input, game = this.game;\n    this.fireTimer -= dt; this.busy = Math.max(0, this.busy - dt);\n    this.hitMark = Math.max(0, this.hitMark - dt);\n    if (this.heat > 0) { this.heat = Math.max(0, this.heat - (dt * WEAPONS.mg.overheat) / WEAPONS.mg.cool); if (this.overheated && this.heat <= 0) this.overheated = false; }\n    if (!p.canAct()) return;\n    const g = this.current(); if (!g) return;\n    const w = WEAPONS[g.id];\n    p.ads = held(input, 'aim') && !p.sprinting && !p.toolBusy && !p.mapUp && !w.melee;\n    if (p.vehicle && !p.mounted) return;\n    const slung = game.gunSlung();\n    // Reload or unjam.\n    if (!p.mapUp && !game.prompt.has() && input.consumeAny(['KeyR', 'PadSquare'])) this.reloadPress(g, w);\n    else if (!p.mapUp && input.consumePress('KeyR')) this.reloadPress(g, w);\n    if (!p.mounted) {\n      if (pressedFixed(input, 'next')) { if (!p.mapUp) this.nextWeapon(); }\n      if (input.consumePress('Digit1')) this.select('main'); if (input.consumePress('Digit2')) this.select('sidearm'); if (input.consumePress('Digit3')) this.select('special'); if (input.consumePress('Digit4')) this.select('melee');\n      if (!p.mapUp && pressedFixed(input, 'melee')) this.meleeSwing();\n      if (!p.mapUp && pressedFixed(input, 'throw')) this.throwPress();\n    }\n    if (slung || p.mapUp || p.toolBusy || p.sprinting) { input.clearQueued('MouseLeft', 'PadR2'); return; }\n    if (this.busy > 0) return;\n    const fireHeld = held(input, 'fire'), firePress = pressedFixed(input, 'fire');\n    const wantFire = w.auto || w.stream ? fireHeld : firePress;\n    if (wantFire && this.fireTimer <= 0) this.tryFire(g, w, dt);\n    if (w.stream && !fireHeld) this.stopStream();\n    if (w.pump && g.needsPump && this.fireTimer <= 0.5 && !this.busy) { g.needsPump = false; game.vm.playGun('Pump', true); game.audio.play('rack', { volume: 0.6 }); }\n  }\n  reloadPress(g, w) {\n    const game = this.game;\n    if (g.jammed) { // Slap and rack: 2 to 4 presses, seeded.\n      if (this.busy > 0.1) return;\n      g.jamLeft--; game.vm.playGun('Unjam', true); game.audio.play('slap'); this.ctx.tweens.call(0.2, () => game.audio.play('rack'));\n      this.busy = 0.75; this.busyKind = 'unjam'; game.rumble(0.3, 0.1);\n      if (g.jamLeft <= 0) { g.jammed = false; game.events.emit('unjam', g); }\n      game.hud.touch();\n      return;\n    }\n    if (w.melee || g.id === 'mg' || this.busy > 0 || g.mag >= w.mag || g.reserve <= 0) return;\n    this.busy = w.reloadT; this.busyKind = 'reload'; game.vm.playGun('Reload', true);\n    game.audio.play(w.stream ? 'fuel-slosh' : g.id === 'm38' ? 'cylinder' : g.id === 'mule' ? 'shell' : 'magazine', { volume: 0.7 });\n    this.ctx.tweens.call(w.reloadT * 0.7, () => game.audio.play(g.id === 'm38' ? 'cylinder' : 'rack', { volume: 0.6 }));\n    this.pendingReload = { g, w, t: w.reloadT };\n    this.ctx.tweens.call(w.reloadT, () => { if (this.pendingReload?.g !== g) return; const need = w.mag - g.mag, take = Math.min(need, g.reserve); g.mag += take; g.reserve -= take; this.pendingReload = null; game.hud.touch(); });\n  }\n  tryFire(g, w, dt) {\n    const p = this.p, game = this.game;\n    if (w.melee) { this.meleeSwing(); return; }\n    if (g.id === 'mg') { if (this.overheated) { game.audio.play('jam-click', { volume: 0.3 }); this.fireTimer = 0.2; return; } this.heat += 1 / w.rate; if (this.heat >= w.overheat) { this.overheated = true; game.audio.play('hiss'); } }\n    else {\n      if (g.jammed) { game.audio.play('jam-click'); this.fireTimer = 0.25; game.prompt.flash('reload', 'CLEAR THE JAM'); return; }\n      if (!game.cheats.infiniteAmmo && g.mag <= 0 && !w.stream) { game.audio.play('jam-click', { volume: 0.5 }); this.fireTimer = 0.25; if (g.reserve > 0) this.reloadPress(g, w); return; }\n      if (w.stream && g.mag <= 0 && !game.cheats.infiniteAmmo) { this.stopStream(); return; }\n    }\n    this.fireTimer = 1 / w.rate;\n    if (g.id !== 'mg') {\n      // Wear. Thresholds appear on the gun itself.\n      const before = g.cond;\n      g.cond = Math.max(0, g.cond - w.wear * TUNING.wearRate * (p.upgrades.cleaning ? 0.6 : 1) * (w.stream ? 1 / 1 : 1));\n      if (Math.floor(before / 30) !== Math.floor(g.cond / 30) || before >= 60 !== g.cond >= 60) game.vm.setCondition(g.id, g.cond);\n      if (!game.cheats.infiniteAmmo) g.mag -= 1;\n      if (g.scriptedJam && --g.scriptedJam === 0) { this.jam(g); return; }\n      if (!game.cheats.noJams && !w.stream && !w.melee && this.rng.next() < jamChance(g.cond)) { this.jam(g); return; }\n      if (g.cond <= 0 && w.wear > 0) { this.fallApart(g, w); return; }\n    }\n    this.shotsFired++;\n    game.hud.touch();\n    game.lastShotT = game.world.time;\n    p.litT = 0.5;\n    this.ctx.engine.shake.add(w.kick ? Math.min(0.5, w.kick * 3.5) : 0.03);\n    game.rumble(w.kick ? Math.min(0.8, w.kick * 8) : 0.2, 0.06);\n    if (w.noise) this.game.actors.hearShot(p.x, p.z, w.noise, null);\n    game.world.shout(p.x, p.z);\n    const eye = this.eye();\n    if (w.stream) { this.stream(g, w, dt, eye); game.vm.playGun('Idle', false, 0); return; }\n    game.vm.playGun('Fire', true, 0.01);\n    if (p.mounted) { game.cam.kickPitch = (game.cam.kickPitch || 0) + 0.003; } else game.cam.kickPitch = (game.cam.kickPitch || 0) + (w.kick ?? 0.01) * 0.9;\n    if (w.sound) game.audio.play(w.sound, { pitch: this.tracerRng.range(-0.6, 0.6) });\n    this.muzzle(eye);\n    if (g.cond < 30 && g.id !== 'mg') { this.ctx.particles.burst('gun-smoke', this.muzzlePos(eye)); if (g.cond < 10 && this.rng.next() < 0.3) game.audio.play('rattle'); }\n    if (w.projectile) {\n      const [dx, dy, dz] = eye.dir;\n      game.projectiles.spawn(w.projectile, eye.x + dx * 0.6, eye.y + dy * 0.6 - 0.1, eye.z + dz * 0.6, dx, dy + (w.projectile === 'flare' ? 0.12 : 0), dz, p);\n      if (w.pump) g.needsPump = true;\n      return;\n    }\n    const pellets = w.pellets ?? 1;\n    const spreadDeg = p.ads ? (w.adsSpread ?? 0.4) : (w.spread ?? 1.4) * (p.speed2 > 4 ? 1.3 : 1);\n    for (let i = 0; i < pellets; i++) this.hitscan(g, w, eye, spreadDeg, i === 0 && (++this.tracerN % 3 === 0 || pellets > 1));\n    if (w.pump) g.needsPump = true;\n  }\n  eye() {\n    const c = this.ctx.camera.camera, p = this.p;\n    if (this.game.cam.override) { c.getWorldDirection(dir); return { x: c.position.x, y: c.position.y, z: c.position.z, dir: [dir.x, dir.y, dir.z] }; }\n    const cy = Math.cos(this.ctx.camera.pitch), d = [-Math.sin(this.ctx.camera.yaw) * cy, Math.sin(this.ctx.camera.pitch), -Math.cos(this.ctx.camera.yaw) * cy];\n    const e = p.eyeNow();\n    return { x: e.x, y: e.y, z: e.z, dir: d };\n  }\n  muzzlePos(e) { return [e.x + e.dir[0] * 0.9, e.y + e.dir[1] * 0.9 - 0.14, e.z + e.dir[2] * 0.9]; }\n  muzzle(e) { const at = this.muzzlePos(e); this.ctx.lights.request({ position: at, color: 0xffd090, intensity: 18, radius: 16, lifetime: 0.06, fadeIn: 0, fadeOut: 0.04, priority: 4 }); }\n  hitscan(g, w, eye, spreadDeg, tracer) {\n    const a = this.rng.range(0, 6.283), r = Math.sqrt(this.rng.next()) * (spreadDeg * Math.PI) / 180;\n    from.set(eye.x, eye.y, eye.z); dir.set(...eye.dir);\n    right.set(dir.z, 0, -dir.x).normalize(); up.crossVectors(dir, right);\n    dir.addScaledVector(right, Math.cos(a) * r).addScaledVector(up, Math.sin(a) * r).normalize();\n    this.lastHit = this.ctx.physics.castRay(from, dir, w.range, undefined, this.p.vehicle ? this.p.vehicle.v.body : this.p.ctrl?.body);\n    const hit = this.lastHit;\n    if (tracer) this.tracer(eye, hit ? hit.point : { x: from.x + dir.x * w.range, y: from.y + dir.y * w.range, z: from.z + dir.z * w.range });\n    if (!hit) return;\n    this.applyHit(hit, w.damage * TUNING.weaponDamage, this.p, { dir, weapon: w, from });\n  }\n  /** A bullet arriving. `by` is whoever fired it. */\n  applyHit(hit, dmg, by, o = {}) {\n    const game = this.game, owner = game.world.owners.get(hit.collider.handle), P = hit.point, particles = this.ctx.particles;\n    if (owner?.type === 'actor') {\n      const a = owner.ref, rel = P.y - a.y;\n      const k = rel > 1.45 ? 2.5 : rel < 0.75 ? 0.7 : 1;\n      if (!a.alive) return;\n      particles.burst('blood', [P.x, P.y, P.z]);\n      game.audio.at('hit-flesh', P.x, P.y, P.z, 40);\n      if (by?.kind === 'player') { this.hitMark = 0.18; this.ctx.engine.hitstop(0.02); }\n      const dmgNow = dmg * k;\n      const push = o.dir ? [o.dir.x * 5, 2 + o.dir.y * 5, o.dir.z * 5] : [0, 3, 0];\n      game.damageActor(a, dmgNow, { by, push, zone: k });\n      return;\n    }\n    if (owner?.type === 'player') { game.damagePlayer(dmg, { by, dirFrom: o.from, player: owner.ref }); return; }\n    if (owner?.type === 'prop') { particles.burst('sparks', [P.x, P.y, P.z]); game.audio.at('hit-metal', P.x, P.y, P.z, 40); game.world.hitProp(owner.ref, dmg, by); return; }\n    if (owner?.type === 'vehicle') { particles.burst('sparks', [P.x, P.y, P.z]); game.audio.at('hit-metal', P.x, P.y, P.z, 50); owner.ref.damage(dmg * 0.25, by); return; }\n    if (owner?.type === 'train') { particles.burst('sparks', [P.x, P.y, P.z]); game.audio.at('hit-metal', P.x, P.y, P.z, 50); return; }\n    particles.burst('mud', [P.x, P.y, P.z]); if (this.tracerRng.next() < 0.22) game.audio.at('ricochet', P.x, P.y, P.z, 40);\n  }\n  tracer(eye, to) {\n    const m = this.muzzlePos(eye);\n    this.game.tracers?.add(m[0], m[1], m[2], to.x, to.y, to.z);\n    if (this.game.mountedTracerFire && this.rng.next() < 0.06) this.game.world.fire.ignite(to.x, to.z, 1);\n  }\n  stream(g, w, dt, eye) {\n    const game = this.game, p = this.p;\n    if (!this.roar) this.roar = game.audio.loopSfx('flame-roar', 0.5);\n    this.streamT = 0.15;\n    // Lights everything in its cone.\n    const [dx, dy, dz] = eye.dir;\n    for (let d = 3; d <= w.range; d += 3) game.world.fire.ignite(eye.x + dx * d, eye.z + dz * d, 2, p);\n    this.ctx.particles.burst('blast', [eye.x + dx * 2, eye.y - 0.3 + dy * 2, eye.z + dz * 2], { count: 8, direction: [dx, dy, dz] });\n    this.ctx.lights.request({ position: [eye.x + dx * 4, eye.y, eye.z + dz * 4], color: 0xff8030, intensity: 22, radius: 20, lifetime: 0.1, priority: 3 });\n    for (const a of [...game.actors.list]) { if (!a.alive) continue; const vx = a.x - eye.x, vz = a.z - eye.z, d = Math.hypot(vx, vz); if (d > w.range) continue; const c = (vx * dx + vz * dz) / (d * Math.hypot(dx, dz) || 1); if (c > 0.9) { game.damageActor(a, (w.damage * TUNING.weaponDamage) / w.rate, { by: p, fire: true, silent: true }); if (a.burning <= 0 && !a.friendly) { a.burning = 5; a.burnBy = p; } } }\n    for (const dd of game.world.destructibles) if (!dd.destroyed && dist2(dd.x, dd.z, eye.x, eye.z) < w.range) { const vx = dd.x - eye.x, vz = dd.z - eye.z, l = Math.hypot(vx, vz) || 1; if ((vx * dx + vz * dz) / (l * Math.hypot(dx, dz) || 1) > 0.9) dd.fuse = dd.fuse < 0 ? 0.8 : dd.fuse; }\n    // Below condition 20 it can leak and light you.\n    if (g.cond < 20 && this.rng.next() < 0.004) { p.catchFire(); game.talk.say('you', 'THE TANK IS LEAKING.'); }\n  }\n  stopStream() { if (this.roar) { this.roar.stop(); this.roar = null; } }\n  jam(g) { g.jammed = true; g.jamLeft = this.rng.int(2, 4); this.game.audio.play('jam-click'); this.game.prompt.flash('reload', 'JAMMED'); this.game.events.emit('jam', g); this.game.hud.touch(); this.fireTimer = 0.4; }\n  fallApart(g, w) {\n    const game = this.game, p = this.p;\n    this.stopStream();\n    game.vm.playGun('FallApart', true); game.audio.play('fall-apart');\n    game.talk.say('you', `THE ${w.name.replaceAll('\"', '')} COMES APART IN YOUR HANDS.`);\n    this.busy = 1.1; this.busyKind = 'broken';\n    this.ctx.tweens.call(1.1, () => { p.guns[w.slot] = null; this.nextWeapon(); });\n    game.events.emit('fallApart', g);\n  }\n  meleeSwing() {\n    const game = this.game, p = this.p; if (this.busy > 0 || game.gunSlung() || p.toolBusy) return;\n    const prev = p.slot; const w = WEAPONS.cane;\n    this.select('melee'); game.vm.playGun('Swing', true); this.busy = 1 / w.rate; this.busyKind = 'melee';\n    game.audio.play('whoosh', { volume: 0.5 });\n    const eye = this.eye();\n    this.ctx.tweens.call(0.2, () => {\n      let best = null, bd = 1e9;\n      for (const a of game.actors.list) { if (!a.alive || a.friendly) continue; const d = Math.hypot(a.x - eye.x, a.z - eye.z); if (d > w.range) continue; const c = ((a.x - eye.x) * eye.dir[0] + (a.z - eye.z) * eye.dir[2]) / (d * Math.hypot(eye.dir[0], eye.dir[2]) || 1); if (c > 0.5 && d < bd) { best = a; bd = d; } }\n      if (best) {\n        // Kills from behind, quietly.\n        let dy = Math.atan2(eye.x - best.x, eye.z - best.z) - best.yaw; dy = Math.atan2(Math.sin(dy), Math.cos(dy));\n        const behind = Math.abs(dy) > 1.9;\n        game.damageActor(best, behind && best.state !== 'alert' ? 9999 : w.damage * TUNING.weaponDamage, { by: p, zone: 1, quiet: behind, push: [eye.dir[0] * 3, 1, eye.dir[2] * 3] });\n        game.audio.play('hit-flesh'); this.hitMark = 0.18; this.ctx.particles.burst('blood', [best.x, best.y + 1.2, best.z]);\n      }\n      if (prev !== 'melee') this.ctx.tweens.call(0.35, () => { if (p.guns[prev] && p.slot === 'melee') this.select(prev); });\n    });\n  }\n  throwPress() {\n    const game = this.game, p = this.p;\n    // A planted charge goes off on a second press.\n    if (p.planted.length) { game.vm.playTool('Detonate', ['tool-detonator'], { hideGun: true }); p.toolBusy = 0.7; game.audio.play('click'); const list = [...p.planted]; p.planted.length = 0; this.ctx.tweens.call(0.35, () => { for (const c of list) this.detonate(c); }); return; }\n    if (this.busy > 0 || game.gunSlung() || p.toolBusy) return;\n    if (p.charges > 0 && (p.molotovs <= 0 || game.prompt.chargePreferred())) { this.plant(); return; }\n    if (p.molotovs <= 0 && !game.cheats.infiniteAmmo) { game.prompt.flash('throw', 'NOTHING TO THROW'); return; }\n    if (!game.cheats.infiniteAmmo) p.molotovs--;\n    game.vm.playTool('Throw', ['tool-bottle']); p.toolBusy = 0.75; game.hud.touch();\n    game.audio.play('whoosh', { volume: 0.5 });\n    const eye = this.eye();\n    this.ctx.tweens.call(0.45, () => game.projectiles.spawn('bottle', eye.x + eye.dir[0], eye.y + eye.dir[1], eye.z + eye.dir[2], eye.dir[0], eye.dir[1] + 0.25, eye.dir[2], p));\n  }\n  plant() {\n    const game = this.game, p = this.p; p.charges--;\n    game.vm.playTool('Plant', ['tool-charge']); p.toolBusy = 1.3; game.audio.play('click');\n    const eye = this.eye(), x = eye.x + eye.dir[0] * 1.1, z = eye.z + eye.dir[2] * 1.1, y = game.world.land.heightAt(x, z);\n    const c = game.spawnCharge(x, y, z); p.planted.push(c); game.hud.touch();\n    game.events.emit('planted', c);\n  }\n  detonate(c) { this.game.removeCharge(c); this.explode(c.x, c.y + 0.3, c.z, THROWABLES.charge.blast, THROWABLES.charge.damage * TUNING.weaponDamage, this.p, { fire: 5, big: true, charge: true }); }\n  /** Bang. Everything near takes damage, grass lights, things shake. */\n  explode(x, y, z, r, dmg, by, o = {}) {\n    const game = this.game, ctx = this.ctx;\n    game.world.fire.ignite(x, z, o.fire ?? r * 0.7, by);\n    ctx.physics.explode([x, y, z], { radius: r * 2, impulse: 24 });\n    if (!game.settings.reduceFlashes || !o.big) ctx.engine.screen.shockwave([x, y, z], { radius: o.big ? 0.45 : 0.25, strength: o.big ? 1 : 0.6 });\n    ctx.particles.burst('blast', [x, y, z]); if (o.big) ctx.particles.burst('blast', [x, y + 2, z], { count: 40 });\n    ctx.lights.request({ position: [x, y + 2, z], color: 0xffa040, intensity: o.big ? 70 : 34, radius: o.big ? 70 : 34, lifetime: 0.4, priority: 5 });\n    game.world.decals.add('scorch', { x, y: game.world.land.heightAt(x, z) + 0.05, z }, { x: 0, y: 1, z: 0 }, { size: r });\n    const p = this.p, dp = Math.hypot(x - p.x, y - p.y, z - p.z);\n    game.audio.at(o.big ? 'explosion' : 'explosion-small', x, y, z, 500, 1);\n    ctx.engine.shake.add(clamp(1.2 - dp / (r * 8), 0, 0.9));\n    game.rumble(clamp(1 - dp / 60, 0.1, 1), 0.3);\n    for (const a of [...game.actors.list]) { if (!a.alive) continue; const d = Math.hypot(a.x - x, a.z - z, a.y + 1 - y); if (d < r) { const push = [(a.x - x) / (d || 1) * 7, 5, (a.z - z) / (d || 1) * 7]; game.damageActor(a, dmg * (1 - d / r * 0.7), { by, push, blast: true }); } else if (d < r * 2.5 && a.ctrl) a.dodgeT = 1; }\n    if (dp < r) game.damagePlayer(dmg * 0.6 * (1 - dp / r * 0.7), { by, blast: true, at: [x, y, z] });\n    for (const vh of game.vehicles.list) { const d = Math.hypot(vh.x - x, vh.z - z); if (d < r * 1.3) vh.damage(dmg * (1 - d / (r * 1.3) * 0.5), by, true); }\n    for (const d of game.world.destructibles) if (!d.destroyed && d.fuse < 0 && Math.hypot(d.x - x, d.z - z) < r + 1) { if (d.tag === 'pump' || d.tag === 'ammo-bunker' || d.tag === 'fuel-tank') game.world.hitProp(d, dmg * 0.8, by); else d.fuse = 0.2 + this.rng.range(0, 0.4); }\n    game.events.emit('explosion', x, y, z, r, by, o);\n    if (game.net) game.net.onExplosion?.(x, y, z, r, o);\n    game.actors.hearShot(x, z, 200, null);\n    game.world.shout(x, z);\n  }\n  flareImpact(x, y, z, hit, by) {\n    const game = this.game, owner = hit ? game.world.owners.get(hit.collider.handle) : null;\n    game.audio.at('flare-hiss', x, y, z, 60);\n    game.world.fire.ignite(x, z, 3, by);\n    this.ctx.particles.burst('sparks', [x, y, z], { count: 12 });\n    this.ctx.lights.request({ position: [x, y + 1, z], color: 0xff8030, intensity: 26, radius: 30, lifetime: 3, flicker: 'torch', priority: 3 });\n    if (owner?.type === 'actor' && owner.ref.alive) { game.damageActor(owner.ref, WEAPONS.flare.damage * TUNING.weaponDamage, { by, silent: true }); if (!owner.ref.friendly) { owner.ref.burning = 5; owner.ref.burnBy = by; } }\n    if (owner?.type === 'prop') owner.ref.fuse = owner.ref.fuse < 0 ? 0.5 : owner.ref.fuse;\n    if (game.net) game.net.onIgnite?.(x, z, 3, by);\n  }\n  bottleImpact(x, y, z, hit, by) {\n    const game = this.game, owner = hit ? game.world.owners.get(hit.collider.handle) : null;\n    game.audio.at('bottle-smash', x, y, z, 60);\n    game.world.fire.ignite(x, z, THROWABLES.molotov.ignite + 2, by);\n    this.ctx.particles.burst('blast', [x, y + 0.5, z], { count: 18 });\n    for (const a of game.actors.list) if (a.alive && Math.hypot(a.x - x, a.z - z) < 3.5 && !a.friendly) { a.burning = 5; a.burnBy = by; } else if (a.alive && a.ctrl && Math.hypot(a.x - x, a.z - z) < 10) a.dodgeT = 1;\n    for (const d of game.world.destructibles) if (!d.destroyed && Math.hypot(d.x - x, d.z - z) < d.spec.r * 0.6 + 2) d.fuse = d.fuse < 0 ? 1 : d.fuse;\n    void owner;\n    if (game.net) game.net.onIgnite?.(x, z, 4, by);\n  }\n  rocketImpact(x, y, z, hit, by) { const w = WEAPONS.tube; this.explode(x, y, z, w.blast, w.damage * TUNING.weaponDamage, by, { fire: 5, big: true, rocket: true }); void hit; }\n  /** A soldier fires at something. */\n  npcShot(a, t) {\n    const game = this.game, ph = this.ctx.physics, dx0 = t.x - a.x, dz0 = t.z - a.z, dist = Math.hypot(dx0, dz0);\n    let err = (1.2 + (5 - 1.2) * clamp(dist / 80, 0, 1)) / (TUNING.enemyAccuracy * (a.spec.accuracy ?? 1));\n    if (t.kind === 'player' && (t.speed2 ?? 0) > 4.8) err *= 1.4;\n    const e = (err * Math.PI) / 180, ax = this.rng.gaussian(0, e * 0.6), ay = this.rng.gaussian(0, e * 0.6);\n    from.set(a.x, a.y + 1.45, a.z);\n    const ty = t.y + (t.crouched ? 0.7 : 1.15);\n    dir.set(dx0, ty - from.y, dz0).normalize();\n    right.set(dir.z, 0, -dir.x).normalize(); up.crossVectors(dir, right);\n    dir.addScaledVector(right, ax).addScaledVector(up, ay).normalize();\n    const hit = ph.castRay(from, dir, a.spec.range * 1.2, undefined, a.ctrl?.body);\n    game.audio.at(a.role === 'mg' ? 'gun-mg' : a.role === 'sniper' ? 'gun-bolt' : 'gun-rifle', a.x, a.y + 1.4, a.z, 350, 0.75);\n    this.ctx.lights.request({ position: [a.x, a.y + 1.5, a.z], color: 0xffd090, intensity: 8, radius: 10, lifetime: 0.05, fadeIn: 0, fadeOut: 0.03 });\n    if (this.tracerRng.next() < 0.3) { const to = hit ? hit.point : v.set(from.x + dir.x * 120, from.y + dir.y * 120, from.z + dir.z * 120); game.tracers?.add(from.x, from.y, from.z, to.x, to.y, to.z); }\n    // Bullet whip when it passes close.\n    if (t.kind === 'player' && dist > 8 && this.tracerRng.next() < 0.35) game.audio.play('bullet-whip', { volume: 0.5, pan: this.tracerRng.range(-0.5, 0.5) });\n    if (!hit) return;\n    this.applyHit(hit, a.spec.damage ?? 9, a, { dir, from });\n  }\n  clear() { this.stopStream(); this.pendingReload = null; this.busy = 0; }\n}\nEOF\necho done","description":"Write rig, soldier AI, projectiles, viewmodel and weapons"}}}
