{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkf7o81MHnn8VG9XU5Qm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DYAnzW8GHU3SRqVCnSkTW9","name":"Bash","input":{"command":"sed -i \"s/^import { model, MODEL_LIBRARY, ModelCatalog, rowOf, around, textureDef } from '..\\/..\\/pixel-engine.js';/import { model, MODEL_LIBRARY, ModelCatalog, textureDef } from '..\\/..\\/pixel-engine.js';\\n\\nconst rowOf = (parts, { n, step, at = [0, 0, 0] }) => Array.from({ length: n }, (_, i) => ({ at: [at[0] + step[0] * i, at[1] + step[1] * i, at[2] + step[2] * i], group: parts }));\\nconst around = (parts, { n }) => Array.from({ length: n }, (_, i) => ({ rot: [0, (360 * i) \\/ n, 0], group: parts }));/\" src/art/models.js\nsed -i \"s/{ cyl: \\[0.6, 3.4, 0.6\\], at: \\[0.3, 1.7, 0\\], rot: \\[0, 0, -10\\]/{ cyl: [0.6, 3.4, 0.6], at: [0.3, 1.76, 0], rot: [0, 0, -10]/\" src/art/models.js\nsed -i \"s/{ lump: \\[3, 0.8, 3\\], at: \\[0, 6, 0\\], seed: 4, c: 'leaf' }/{ lump: [3, 1.4, 3], at: [0, 5.4, 0], seed: 4, c: 'leaf' }/\" src/art/models.js\ncat > src/art/viewmodels.js <<'EOF'\n// First-person art: arms and every thing held in them, on a small custom rig. Each gun is its own rig instance.\nimport { model } from '../../pixel-engine.js';\nexport const GUN_RIG = { joints: ['Root', 'Weapon', 'Mag', 'Bolt', 'ArmR', 'HandR', 'ArmL', 'HandL'], root: 'Root', mirror: {}, soles: [], trace: [], limits: {}, fps: 30 };\nexport const TOOL_RIG = { joints: ['Root', 'ArmR', 'HandR', 'ArmL', 'HandL', 'Item', 'ItemL', 'Finger'], root: 'Root', mirror: {}, soles: [], trace: [], limits: {}, fps: 30 };\nconst PAL = { sleeve: 'sand', skin: 'orange', iron: 'night', iron2: 'ink', wood: 'red', wood2: 'plum', rust: 'red', rust2: 'plum', tape: 'mist', brass: 'sand', cuff: 'slate', accent: 'orange', glass: 'cyan', tank: 'green' };\nconst pivot = (name, at, group, rot) => ({ group, at, pivot: true, name, ...(rot ? { rot } : {}) });\nconst hand = (w = 0.1) => [{ box: [w, 0.09, 0.14], at: [0, 0, 0.02], c: 'skin' }, { box: [0.03, 0.03, 0.09], at: [w / 2 - 0.01, 0.03, 0.08], c: 'skin' }];\nconst armR = (hx, hy, hz) => pivot('ArmR', [hx, hy, hz], [{ box: [0.1, 0.1, 0.56], at: [-0.02, -0.04, -0.33], rot: [12, 8, 0], c: 'sleeve' }, { box: [0.11, 0.11, 0.05], at: [-0.01, -0.02, -0.08], c: 'cuff' }, pivot('HandR', [0, 0, 0], hand())]);\nconst armL = (hx, hy, hz) => pivot('ArmL', [hx, hy, hz], [{ box: [0.1, 0.1, 0.6], at: [0.05, -0.05, -0.35], rot: [10, -12, 0], c: 'sleeve' }, { box: [0.11, 0.11, 0.05], at: [0.01, -0.02, -0.08], c: 'cuff' }, pivot('HandL', [0, 0, 0], hand())]);\nconst rusty = (parts) => pivot('Rust', [0, 0, 0], parts);\nconst taped = (parts) => pivot('Tape', [0, 0, 0], parts);\nconst gunModel = (id, about, parts, { mag = [], magAt = [0, -0.06, 0.1], bolt = [], boltAt = [0, 0.04, 0], rust = [], tape = [], gripR = [0, -0.07, -0.08], gripL = [0, -0.04, 0.26], at = [-0.13, -0.17, -0.02] } = {}) => model({\n  id: `vm-${id}`, about, tags: ['viewmodel'], floats: true, collider: 'none', palette: PAL,\n  parts: [pivot('Root', [0, 0, 0], [pivot('Weapon', at, [...parts, pivot('Mag', magAt, mag.length ? mag : [{ box: [0.01, 0.01, 0.01], at: [0, 0, 0], c: 'iron2' }]), pivot('Bolt', boltAt, bolt.length ? bolt : [{ box: [0.01, 0.01, 0.01], at: [0, 0, 0], c: 'iron2' }]), rusty(rust.length ? rust : [{ box: [0.01, 0.01, 0.01], at: [0, 0, 0], c: 'rust' }]), taped(tape.length ? tape : [{ box: [0.01, 0.01, 0.01], at: [0, 0, 0], c: 'tape' }]), armR(...gripR), armL(...gripL)])])],\n});\nconst rustBar = (x, y, z, l) => ({ box: [0.052, 0.03, l], at: [x, y, z], c: 'rust' });\nconst tapeBand = (z, w = 0.07, h = 0.08) => ({ box: [w, h, 0.05], at: [0, 0, z], c: 'tape' });\nexport const vmTractor = gunModel('tractor', 'The Tractor rifle: every soldier has one, mostly rusted', [\n  { box: [0.05, 0.08, 0.34], at: [0, 0, 0.04], c: 'iron' }, { box: [0.05, 0.05, 0.4], at: [0, 0.025, 0.4], c: 'iron2' }, { box: [0.06, 0.09, 0.22], at: [0, -0.01, 0.3], c: 'wood' },\n  { box: [0.06, 0.1, 0.24], at: [0, -0.015, -0.24], c: 'wood' }, { box: [0.05, 0.13, 0.05], at: [0, -0.09, -0.08], rot: [20, 0, 0], c: 'wood2' }, { box: [0.02, 0.03, 0.02], at: [0, 0.07, 0.56], c: 'iron2' }, { box: [0.03, 0.02, 0.05], at: [0, 0.055, 0.0], c: 'iron2' },\n], { mag: [{ box: [0.04, 0.17, 0.08], at: [0, -0.08, 0.02], rot: [-16, 0, 0], c: 'iron2' }], magAt: [0, -0.04, 0.1], bolt: [{ box: [0.03, 0.03, 0.08], at: [0.02, 0.0, 0], c: 'iron2' }], boltAt: [0.02, 0.045, 0.05], rust: [rustBar(0, 0.03, 0.07, 0.2), rustBar(0, -0.02, -0.04, 0.1), rustBar(0, 0.048, 0.42, 0.16)], tape: [tapeBand(0.3, 0.075, 0.1), tapeBand(0.16, 0.06, 0.1)] });\nexport const vmM38 = gunModel('m38', 'The service revolver: dependable', [\n  { box: [0.04, 0.05, 0.22], at: [0, 0.02, 0.14], c: 'iron' }, { cyl: [0.08, 0.07, 0.08], at: [0, 0, 0.0], rot: [90, 0, 0], c: 'iron2' }, { box: [0.045, 0.14, 0.06], at: [0, -0.07, -0.08], rot: [24, 0, 0], c: 'wood' }, { box: [0.02, 0.02, 0.02], at: [0, 0.05, 0.24], c: 'iron2' },\n], { at: [-0.12, -0.14, 0.04], gripR: [0, -0.07, -0.07], gripL: [0.03, -0.09, -0.02], rust: [rustBar(0, 0.03, 0.14, 0.14)], tape: [{ box: [0.05, 0.05, 0.07], at: [0, -0.06, -0.08], rot: [24, 0, 0], c: 'tape' }], mag: [{ box: [0.05, 0.05, 0.03], at: [0, 0, -0.04], c: 'brass' }], magAt: [0, 0, 0] });\nexport const vmFlare = gunModel('flare', 'A fat brass flare pistol', [\n  { cyl: [0.08, 0.26, 0.08], at: [0, 0.01, 0.1], rot: [90, 0, 0], c: 'accent' }, { box: [0.05, 0.05, 0.08], at: [0, 0, -0.06], c: 'iron' }, { box: [0.045, 0.13, 0.06], at: [0, -0.07, -0.09], rot: [24, 0, 0], c: 'wood2' },\n], { at: [-0.12, -0.14, 0.04], gripR: [0, -0.07, -0.08], gripL: [0.03, -0.09, -0.02], rust: [rustBar(0, 0.05, 0.1, 0.14)], mag: [{ cyl: [0.06, 0.1, 0.06], at: [0, 0, 0], rot: [90, 0, 0], c: 'brass' }], magAt: [0, 0.01, 0.1] });\nexport const vmMule = gunModel('mule', 'The Mule pump gun', [\n  { box: [0.05, 0.08, 0.26], at: [0, 0, 0.02], c: 'iron' }, { cyl: [0.05, 0.56, 0.05], at: [0, 0.025, 0.42], rot: [90, 0, 0], c: 'iron2' }, { cyl: [0.04, 0.46, 0.04], at: [0, -0.03, 0.38], rot: [90, 0, 0], c: 'iron' }, { box: [0.06, 0.11, 0.26], at: [0, -0.02, -0.24], c: 'wood2' },\n], { bolt: [{ box: [0.07, 0.07, 0.16], at: [0, 0, 0], c: 'wood' }], boltAt: [0, -0.035, 0.36], gripL: [0, -0.07, 0.36], mag: [{ box: [0.03, 0.03, 0.08], at: [0, 0, 0], c: 'red' === 0 ? 'wood' : 'wood' }], magAt: [0, -0.06, 0.05], rust: [rustBar(0, 0.03, 0.02, 0.2), rustBar(0, 0.05, 0.4, 0.2)], tape: [tapeBand(-0.12, 0.07, 0.12)] });\nexport const vmEmpire = gunModel('empire', 'The Old Empire bolt rifle with its long scope', [\n  { box: [0.05, 0.07, 0.4], at: [0, 0, 0.02], c: 'wood' }, { box: [0.04, 0.04, 0.54], at: [0, 0.03, 0.46], c: 'iron2' }, { box: [0.06, 0.1, 0.3], at: [0, -0.02, -0.3], c: 'wood' }, { cyl: [0.07, 0.3, 0.07], at: [0, 0.12, 0.08], rot: [90, 0, 0], c: 'iron2' }, { box: [0.02, 0.05, 0.04], at: [0, 0.07, 0.0], c: 'iron' }, { box: [0.06, 0.06, 0.01], at: [0, 0.12, 0.235], c: 'glass' },\n], { bolt: [{ box: [0.1, 0.025, 0.025], at: [0.04, 0, 0], c: 'iron' }, { box: [0.04, 0.04, 0.04], at: [0.1, 0, 0], c: 'iron2' }], boltAt: [0.02, 0.03, -0.08], mag: [{ box: [0.03, 0.03, 0.08], at: [0, 0, 0], c: 'brass' }], magAt: [0, 0.05, 0.05], gripL: [0, -0.04, 0.32], rust: [rustBar(0, 0.048, 0.5, 0.22), rustBar(0, 0.03, -0.06, 0.1)], tape: [tapeBand(0.3, 0.06, 0.08)] });\nexport const vmWeed = gunModel('weed', 'The Weed Burner: wand, hose and a tank at your hip', [\n  { box: [0.06, 0.09, 0.3], at: [0, 0, 0.02], c: 'iron' }, { cyl: [0.05, 0.5, 0.05], at: [0, 0.02, 0.4], rot: [90, 0, 0], c: 'iron2' }, { cyl: [0.08, 0.1, 0.08], at: [0, 0.02, 0.68], rot: [90, 0, 0], c: 'accent' }, { box: [0.05, 0.13, 0.05], at: [0, -0.09, -0.06], rot: [20, 0, 0], c: 'wood2' }, { cyl: [0.16, 0.34, 0.16], at: [0.02, -0.22, -0.22], rot: [90, 0, 0], c: 'tank' }, { box: [0.04, 0.04, 0.3], at: [0.02, -0.12, -0.02], rot: [20, 0, 0], c: 'iron2' },\n], { gripL: [0, -0.03, 0.34], mag: [{ box: [0.02, 0.05, 0.02], at: [0, 0, 0], c: 'accent', glow: true }], magAt: [0, 0.02, 0.73], rust: [rustBar(0, 0.05, 0.1, 0.14), { box: [0.17, 0.05, 0.1], at: [0.02, -0.17, -0.22], c: 'rust' }], tape: [tapeBand(0.28, 0.07, 0.07)] });\nexport const vmTube = gunModel('tube', 'The Long Tube rocket launcher, on the shoulder', [\n  { cyl: [0.13, 1.0, 0.13], at: [0.02, 0.1, 0.16], rot: [90, 0, 0], c: 'tank' }, { box: [0.05, 0.14, 0.06], at: [0, -0.06, -0.06], rot: [20, 0, 0], c: 'iron' }, { box: [0.05, 0.14, 0.06], at: [0, -0.06, 0.26], rot: [10, 0, 0], c: 'iron' }, { cyl: [0.17, 0.08, 0.17], at: [0.02, 0.1, 0.66], rot: [90, 0, 0], c: 'iron2' }, { box: [0.02, 0.07, 0.05], at: [0.02, 0.2, 0.1], c: 'iron2' },\n], { at: [-0.12, -0.2, 0.02], gripR: [0, -0.1, -0.06], gripL: [0, -0.1, 0.26], mag: [{ cone: [0.12, 0.24, 0.12], at: [0, 0, 0], rot: [90, 0, 0], c: 'accent' }], magAt: [0.02, 0.1, 0.7], rust: [{ box: [0.14, 0.03, 0.3], at: [0.02, 0.17, 0.3], c: 'rust' }], tape: [{ box: [0.15, 0.15, 0.06], at: [0.02, 0.1, 0.4], c: 'tape' }] });\nexport const vmCane = gunModel('cane', 'A cane knife, chipped along its edge', [\n  { box: [0.03, 0.03, 0.14], at: [0, 0, -0.02], c: 'wood' }, { box: [0.012, 0.07, 0.46], at: [0, 0.015, 0.28], c: 'iron' }, { box: [0.014, 0.024, 0.46], at: [0, 0.055, 0.28], c: 'tape' },\n], { at: [-0.14, -0.18, 0.06], gripR: [0, 0, -0.02], gripL: [0.2, -0.28, -0.08] });\nexport const GUN_VIEWMODELS = { tractor: vmTractor, m38: vmM38, flare: vmFlare, mule: vmMule, empire: vmEmpire, weed: vmWeed, tube: vmTube, cane: vmCane };\n// The mounted gun has handles only, and the arms grip them.\nexport const vmMg = gunModel('mg', 'A mounted machine gun, seen from behind its spade grips', [\n  { box: [0.1, 0.12, 0.5], at: [0, 0, 0.2], c: 'iron' }, { cyl: [0.06, 0.8, 0.06], at: [0, 0.01, 0.8], rot: [90, 0, 0], c: 'iron2' }, { box: [0.22, 0.04, 0.04], at: [0, 0, -0.07], c: 'iron2' }, { box: [0.13, 0.16, 0.24], at: [0.11, -0.06, 0.2], c: 'tank' }, { box: [0.02, 0.05, 0.02], at: [0, 0.09, 0.4], c: 'iron2' },\n], { at: [0, -0.18, 0.0], gripR: [-0.1, 0, -0.08], gripL: [0.1, 0, -0.08] });\n\n// ---------- Hand tools ----------\nconst item = (name, parts) => pivot(name, [0, 0, 0], parts);\nconst armToolR = pivot('ArmR', [-0.16, -0.22, 0.22], [{ box: [0.1, 0.1, 0.6], at: [-0.03, -0.05, -0.33], rot: [12, 8, 0], c: 'sleeve' }, { box: [0.11, 0.11, 0.05], at: [-0.01, -0.02, -0.06], c: 'cuff' }, pivot('HandR', [0, 0, 0], [...hand(), pivot('Item', [0, 0.01, 0.06], [\n  { box: [0.005, 0.005, 0.005], at: [0, 0, 0], c: 'iron2' },\n  item('tool-syrette', [{ cyl: [0.03, 0.14, 0.03], at: [0, 0.02, 0.06], rot: [90, 0, 0], c: 'tape' }, { box: [0.008, 0.008, 0.08], at: [0, 0.02, 0.17], c: 'iron' }, { box: [0.03, 0.03, 0.03], at: [0, 0.02, 0], c: 'tank' }]),\n  item('tool-pliers', [{ box: [0.018, 0.018, 0.12], at: [0.012, 0, 0.02], rot: [0, 6, 0], c: 'accent' }, { box: [0.018, 0.018, 0.12], at: [-0.012, 0, 0.02], rot: [0, -6, 0], c: 'accent' }, { box: [0.02, 0.02, 0.08], at: [0, 0, 0.12], c: 'iron' }]),\n  item('tool-knife', [{ box: [0.025, 0.025, 0.1], at: [0, 0, 0], c: 'wood' }, { box: [0.01, 0.03, 0.14], at: [0, 0.005, 0.12], c: 'tape' }]),\n  item('tool-lighter', [{ box: [0.03, 0.05, 0.02], at: [0, 0.02, 0.02], c: 'brass' }, { box: [0.018, 0.04, 0.012], at: [0, 0.065, 0.02], c: 'accent', glow: true }]),\n  item('tool-wrench', [{ box: [0.03, 0.015, 0.22], at: [0, 0, 0.08], c: 'iron' }, { box: [0.06, 0.02, 0.05], at: [0, 0, 0.2], c: 'iron2' }]),\n  item('tool-detonator', [{ box: [0.06, 0.09, 0.05], at: [0, 0.03, 0.03], c: 'iron' }, { box: [0.02, 0.03, 0.02], at: [0, 0.09, 0.03], c: 'accent' }, { box: [0.012, 0.1, 0.012], at: [0.02, 0.12, 0.03], c: 'iron2' }]),\n  item('tool-bottle', [{ cyl: [0.07, 0.18, 0.07], at: [0, 0.07, 0.02], c: 'tank' }, { cyl: [0.03, 0.07, 0.03], at: [0, 0.19, 0.02], c: 'tank' }, { box: [0.02, 0.05, 0.02], at: [0, 0.25, 0.02], c: 'accent', glow: true }]),\n  item('tool-charge', [{ box: [0.15, 0.09, 0.1], at: [0, 0.04, 0.05], c: 'brass' }, { box: [0.16, 0.02, 0.11], at: [0, 0.04, 0.05], c: 'iron2' }]),\n  item('tool-tablet', [{ box: [0.022, 0.012, 0.022], at: [0, 0.03, 0.05], c: 'tape' }]),\n  item('tool-revolver', [{ box: [0.04, 0.05, 0.22], at: [0, 0.03, 0.12], c: 'iron' }, { cyl: [0.08, 0.07, 0.08], at: [0, 0.01, 0.02], rot: [90, 0, 0], c: 'iron2' }]),\n])])]);\nconst armToolL = pivot('ArmL', [0.16, -0.22, 0.22], [{ box: [0.1, 0.1, 0.6], at: [0.03, -0.05, -0.33], rot: [12, -8, 0], c: 'sleeve' }, { box: [0.11, 0.11, 0.05], at: [0.01, -0.02, -0.06], c: 'cuff' }, pivot('HandL', [0, 0, 0], [...hand(), pivot('Finger', [0.03, 0.03, 0.09], [{ box: [0.025, 0.025, 0.08], at: [0, 0, 0.03], c: 'skin' }]), pivot('ItemL', [0, 0.01, 0.06], [\n  { box: [0.005, 0.005, 0.005], at: [0, 0, 0], c: 'iron2' },\n  item('tool-tablets', [{ cyl: [0.06, 0.1, 0.06], at: [0, 0.05, 0.02], c: 'accent' }, { cyl: [0.065, 0.03, 0.065], at: [0, 0.11, 0.02], c: 'tape' }, { box: [0.062, 0.05, 0.062], at: [0, 0.05, 0.02], c: 'tape' }]),\n  item('tool-tracker', [{ box: [0.08, 0.14, 0.03], at: [0, 0.07, 0.04], c: 'iron' }, { box: [0.05, 0.05, 0.01], at: [0, 0.1, 0.057], c: 'iron2' }, pivot('tracker-led', [0, 0.135, 0.057], [{ box: [0.022, 0.022, 0.012], at: [0, 0, 0], c: 'tank', glow: true }]), { box: [0.012, 0.09, 0.012], at: [0.03, 0.18, 0.04], c: 'iron2' }]),\n  item('tool-monocular', [{ cyl: [0.06, 0.16, 0.06], at: [0, 0.03, 0.08], rot: [90, 0, 0], c: 'iron2' }, { cyl: [0.07, 0.03, 0.07], at: [0, 0.03, 0.17], rot: [90, 0, 0], c: 'iron' }]),\n])])]);\nexport const vmTools = model({\n  id: 'vm-tools', about: 'Bare arms and the small things they carry: syrette, pliers, knife, lighter, tablets, tracker', tags: ['viewmodel'], floats: true, collider: 'none', palette: PAL,\n  parts: [pivot('Root', [0, 0, 0], [\n    armToolR, armToolL,\n    // Your own body, for field surgery. Hidden until a scene wants it.\n    pivot('prop-forearm', [0.04, -0.26, 0.36], [{ box: [0.1, 0.09, 0.42], at: [0, 0, -0.04], rot: [0, -30, 0], c: 'skin' }, { box: [0.05, 0.02, 0.06], at: [0.03, 0.05, 0.02], c: 'rust' }, { box: [0.11, 0.1, 0.05], at: [0.1, 0, -0.2], rot: [0, -30, 0], c: 'cuff' }]),\n    pivot('prop-thigh', [0.02, -0.55, 0.36], [{ box: [0.2, 0.17, 0.6], at: [0, 0, 0], rot: [-20, 0, 0], c: 'cuff' }, { box: [0.07, 0.01, 0.1], at: [0.02, 0.1, 0.02], rot: [-20, 0, 0], c: 'rust' }]),\n    pivot('prop-burn', [0, -0.3, 0.38], [{ box: [0.1, 0.09, 0.42], at: [0, 0, 0], rot: [0, 25, 0], c: 'skin' }, { box: [0.08, 0.02, 0.14], at: [0, 0.05, 0.04], rot: [0, 25, 0], c: 'iron2' }]),\n  ])],\n});\n// The wheel and dash, a separate object so it can be parented to the truck's seat.\nexport const vmDash = model({ id: 'vm-dash', about: 'A steering wheel, a dash, a small waypoint arrow', tags: ['viewmodel'], floats: true, collider: 'none', palette: { dash: 'night', wheel: 'ink', arrow: 'orange', hood: 'slate', skin: 'orange', sleeve: 'sand' },\n  parts: [{ box: [1.6, 0.22, 0.5], at: [-0.42, -0.36, 0.58], c: 'dash' }, { box: [1.76, 0.1, 1.0], at: [-0.42, -0.44, 1.32], c: 'hood' },\n    pivot('Wheel', [0, -0.34, 0.36], [{ torus: [0.36, 0.035, 0.36], at: [0, 0, 0], rot: [90, 0, 0], c: 'wheel' }, { box: [0.34, 0.03, 0.03], at: [0, 0, 0], c: 'wheel' }, { box: [0.03, 0.17, 0.03], at: [0, -0.09, 0], c: 'wheel' },\n      { box: [0.08, 0.07, 0.1], at: [0.17, 0.02, -0.03], c: 'skin' }, { box: [0.08, 0.07, 0.1], at: [-0.17, 0.02, -0.03], c: 'skin' }, { box: [0.08, 0.08, 0.5], at: [0.2, -0.05, -0.28], rot: [14, 0, 0], c: 'sleeve' }, { box: [0.08, 0.08, 0.5], at: [-0.2, -0.05, -0.28], rot: [14, 0, 0], c: 'sleeve' }]),\n    pivot('Arrow', [-0.42, -0.23, 0.56], [{ box: [0.03, 0.02, 0.1], at: [0, 0, 0], c: 'arrow', glow: true }, { box: [0.08, 0.02, 0.03], at: [0, 0, 0.04], c: 'arrow', glow: true }])] });\nexport const VIEWMODELS = [...Object.values(GUN_VIEWMODELS), vmMg, vmTools, vmDash];\nexport const handsMap = model({ id: 'vm-maphands', about: 'Two hands holding the edges of a paper map', tags: ['viewmodel'], floats: true, collider: 'none', palette: PAL, parts: [{ mirror: [{ box: [0.08, 0.05, 0.13], at: [0.27, 0, 0.0], c: 'skin' }, { box: [0.08, 0.08, 0.5], at: [0.3, -0.07, -0.3], rot: [12, -6, 0], c: 'sleeve' }], axis: 'x' }, { box: [0.1, 0.03, 0.14], at: [0.13, 0.2, 0.02], c: 'iron' }, { box: [0.08, 0.016, 0.1], at: [0.13, 0.22, 0.02], c: 'tank' }] });\nEOF\ncat > src/art/clips.js <<'EOF'\n// New animation, as ClipDef data on the engine's system. People clips use the hero rig; hands clips use GUN_RIG / TOOL_RIG.\nconst K = (f, pose, e) => (e ? [f, pose, e] : [f, pose]);\n// Held-rifle upper-body pose shared by the armed clips.\nconst AIM = { Torso: [4, -14, 0], Head: [0, 14, 0], ArmR: [-62, -14, -8], ForearmR: [-52, 0, 0], HandR: [0, 0, 0], ArmL: [-68, 28, 8], ForearmL: [-62, 12, 0] };\nconst merge = (a, b) => ({ ...a, ...b });\nexport const PEOPLE_CLIPS = [\n  { name: 'AimIdle', frames: 60, loop: true, keys: [K(0, AIM), K(30, merge(AIM, { Torso: [6, -14, 0] }), 'inOut'), K(60, AIM)] },\n  { name: 'AimWalk', frames: 24, loop: true, keys: [K(0, merge(AIM, { Torso: [8, -16, 2] })), K(12, merge(AIM, { Torso: [8, -12, -2] })), K(24, merge(AIM, { Torso: [8, -16, 2] }))] },\n  { name: 'FireRecoil', frames: 6, fast: true, keys: [K(0, merge(AIM, { Torso: [1, -14, 0], ArmR: [-70, -14, -8] })), K(3, merge(AIM, { Torso: [-2, -14, 0], ArmR: [-74, -14, -8] }), 'out'), K(6, AIM)] },\n  { name: 'Reload', frames: 50, keys: [K(0, AIM), K(10, merge(AIM, { ArmL: [-30, 20, 14], ForearmL: [-80, 0, 0] })), K(25, merge(AIM, { ArmL: [-20, 10, 20], ForearmL: [-40, 0, 0] })), K(38, merge(AIM, { ArmL: [-52, 24, 8], ForearmL: [-80, 12, 0] })), K(50, AIM)] },\n  { name: 'ThrowBottle', frames: 26, fast: true, keys: [K(0, { ArmR: [-20, 0, -10], ForearmR: [-40, 0, 0], Torso: [0, 10, 0] }), K(10, { ArmR: [-170, 0, -20], ForearmR: [-70, 0, 0], Torso: [-10, 26, 0] }, 'inOut'), K(16, { ArmR: [-70, 0, -10], ForearmR: [-10, 0, 0], Torso: [14, -20, 0] }, 'out'), K(26, { ArmR: [-20, 0, -8], ForearmR: [-20, 0, 0], Torso: [0, 0, 0] })] },\n  { name: 'BurnPanic', frames: 20, loop: true, fast: true, keys: [\n    K(0, { Pelvis: { r: [14, 8, 4], p: [0, -0.06, 0] }, Torso: [18, -16, 8], Head: [-20, 14, 0], ArmR: [-150, 0, -40], ForearmR: [-90, 0, 0], ArmL: [-40, 0, 60], ForearmL: [-70, 0, 0], LegR: [-46, 0, 0], ShinR: [40, 0, 0], LegL: [24, 0, 0], ShinL: [60, 0, 0] }),\n    K(10, { Pelvis: { r: [14, -8, -4], p: [0, -0.02, 0] }, Torso: [18, 16, -8], Head: [-10, -14, 0], ArmR: [-40, 0, -60], ForearmR: [-70, 0, 0], ArmL: [-150, 0, 40], ForearmL: [-90, 0, 0], LegR: [24, 0, 0], ShinR: [60, 0, 0], LegL: [-46, 0, 0], ShinL: [40, 0, 0] }),\n    K(20, { Pelvis: { r: [14, 8, 4], p: [0, -0.06, 0] }, Torso: [18, -16, 8], Head: [-20, 14, 0], ArmR: [-150, 0, -40], ForearmR: [-90, 0, 0], ArmL: [-40, 0, 60], ForearmL: [-70, 0, 0], LegR: [-46, 0, 0], ShinR: [40, 0, 0], LegL: [24, 0, 0], ShinL: [60, 0, 0] }),\n  ] },\n  { name: 'Beg', frames: 40, loop: true, keys: [K(0, { Pelvis: { r: [0, 0, 0], p: [0, -0.34, 0] }, LegR: [-90, 0, 0], ShinR: [90, 0, 0], LegL: [-90, 0, 0], ShinL: [90, 0, 0], Torso: [14, 0, 0], ArmR: [-110, 0, -6], ForearmR: [-40, 0, 0], ArmL: [-110, 0, 6], ForearmL: [-40, 0, 0], Head: [-10, 0, 0] }), K(20, { Pelvis: { r: [0, 0, 0], p: [0, -0.34, 0] }, LegR: [-90, 0, 0], ShinR: [90, 0, 0], LegL: [-90, 0, 0], ShinL: [90, 0, 0], Torso: [24, 0, 0], ArmR: [-90, 0, -6], ForearmR: [-50, 0, 0], ArmL: [-90, 0, 6], ForearmL: [-50, 0, 0], Head: [6, 0, 0] }, 'inOut'), K(40, { Pelvis: { r: [0, 0, 0], p: [0, -0.34, 0] }, LegR: [-90, 0, 0], ShinR: [90, 0, 0], LegL: [-90, 0, 0], ShinL: [90, 0, 0], Torso: [14, 0, 0], ArmR: [-110, 0, -6], ForearmR: [-40, 0, 0], ArmL: [-110, 0, 6], ForearmL: [-40, 0, 0], Head: [-10, 0, 0] })] },\n  { name: 'Surrender', frames: 40, loop: true, keys: [K(0, { ArmR: [-170, 0, -14], ForearmR: [-24, 0, 0], ArmL: [-170, 0, 14], ForearmL: [-24, 0, 0], Head: [8, 0, 0] }), K(20, { ArmR: [-176, 0, -14], ForearmR: [-14, 0, 0], ArmL: [-176, 0, 14], ForearmL: [-14, 0, 0], Head: [12, 0, 0] }, 'inOut'), K(40, { ArmR: [-170, 0, -14], ForearmR: [-24, 0, 0], ArmL: [-170, 0, 14], ForearmL: [-24, 0, 0], Head: [8, 0, 0] })] },\n  { name: 'WoundedSit', frames: 60, loop: true, keys: [K(0, { Pelvis: { r: [-24, 0, 0], p: [0, -0.5, 0] }, LegR: [-80, 10, 0], ShinR: [40, 0, 0], LegL: [-50, -14, 0], ShinL: [70, 0, 0], Torso: [10, 0, 8], Head: [20, 10, 0], ArmR: [-40, 0, 10], ForearmR: [-90, 0, 0], ArmL: [20, 0, 24], ForearmL: [-10, 0, 0] }), K(30, { Pelvis: { r: [-22, 0, 0], p: [0, -0.5, 0] }, LegR: [-80, 10, 0], ShinR: [40, 0, 0], LegL: [-50, -14, 0], ShinL: [70, 0, 0], Torso: [16, 0, 8], Head: [24, 10, 0], ArmR: [-44, 0, 10], ForearmR: [-96, 0, 0], ArmL: [20, 0, 24], ForearmL: [-10, 0, 0] }, 'inOut'), K(60, { Pelvis: { r: [-24, 0, 0], p: [0, -0.5, 0] }, LegR: [-80, 10, 0], ShinR: [40, 0, 0], LegL: [-50, -14, 0], ShinL: [70, 0, 0], Torso: [10, 0, 8], Head: [20, 10, 0], ArmR: [-40, 0, 10], ForearmR: [-90, 0, 0], ArmL: [20, 0, 24], ForearmL: [-10, 0, 0] })] },\n  { name: 'DragBackward', frames: 30, loop: true, keys: [K(0, { Pelvis: { r: [28, 0, 0], p: [0, -0.14, 0] }, Torso: [24, 0, 0], ArmR: [-70, 0, -10], ForearmR: [-14, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-14, 0, 0], LegR: [-40, 0, 0], ShinR: [50, 0, 0], LegL: [10, 0, 0], ShinL: [20, 0, 0] }), K(15, { Pelvis: { r: [24, 0, 0], p: [0, -0.1, 0] }, Torso: [28, 0, 0], ArmR: [-60, 0, -10], ForearmR: [-24, 0, 0], ArmL: [-60, 0, 10], ForearmL: [-24, 0, 0], LegR: [10, 0, 0], ShinR: [20, 0, 0], LegL: [-40, 0, 0], ShinL: [50, 0, 0] }), K(30, { Pelvis: { r: [28, 0, 0], p: [0, -0.14, 0] }, Torso: [24, 0, 0], ArmR: [-70, 0, -10], ForearmR: [-14, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-14, 0, 0], LegR: [-40, 0, 0], ShinR: [50, 0, 0], LegL: [10, 0, 0], ShinL: [20, 0, 0] })] },\n  { name: 'CarryOver', frames: 30, loop: true, keys: [K(0, { Pelvis: { r: [78, 0, 0], p: [0, 0.54, 0] }, Torso: [24, 0, 0], Head: [30, 0, 0], ArmR: [-20, 0, 0], ForearmR: [-20, 0, 0], ArmL: [-14, 0, 0], ForearmL: [-20, 0, 0], LegR: [-20, 0, 0], ShinR: [34, 0, 0], LegL: [-10, 0, 0], ShinL: [30, 0, 0] }), K(15, { Pelvis: { r: [80, 0, 0], p: [0, 0.56, 0] }, Torso: [26, 0, 0], Head: [34, 0, 0], ArmR: [-8, 0, 0], ForearmR: [-30, 0, 0], ArmL: [-24, 0, 0], ForearmL: [-14, 0, 0], LegR: [-14, 0, 0], ShinR: [40, 0, 0], LegL: [-16, 0, 0], ShinL: [24, 0, 0] }), K(30, { Pelvis: { r: [78, 0, 0], p: [0, 0.54, 0] }, Torso: [24, 0, 0], Head: [30, 0, 0], ArmR: [-20, 0, 0], ForearmR: [-20, 0, 0], ArmL: [-14, 0, 0], ForearmL: [-20, 0, 0], LegR: [-20, 0, 0], ShinR: [34, 0, 0], LegL: [-10, 0, 0], ShinL: [30, 0, 0] })] },\n  { name: 'DriveSit', frames: 40, loop: true, keys: [K(0, { Pelvis: { r: [-6, 0, 0], p: [0, -0.3, 0] }, LegR: [-84, 0, 0], ShinR: [84, 0, 0], LegL: [-84, 0, 0], ShinL: [84, 0, 0], ArmR: [-60, 0, -6], ForearmR: [-30, 0, 0], ArmL: [-60, 0, 6], ForearmL: [-30, 0, 0] }), K(40, { Pelvis: { r: [-6, 0, 0], p: [0, -0.3, 0] }, LegR: [-84, 0, 0], ShinR: [84, 0, 0], LegL: [-84, 0, 0], ShinL: [84, 0, 0], ArmR: [-60, 0, -6], ForearmR: [-30, 0, 0], ArmL: [-60, 0, 6], ForearmL: [-30, 0, 0] })] },\n  { name: 'UnjamSwear', frames: 54, keys: [K(0, AIM), K(8, merge(AIM, { Torso: [18, -14, 0], Head: [24, 14, 0], ArmL: [-40, 10, 12] }), 'out'), K(16, merge(AIM, { ArmL: [-60, 14, 10], ForearmL: [-90, 0, 0], Torso: [20, -14, 0], Head: [28, 14, 0] })), K(22, merge(AIM, { ArmL: [-40, 14, 14], ForearmL: [-60, 0, 0], Torso: [18, -14, 0], Head: [24, 14, 0] }), 'out'), K(30, merge(AIM, { ArmL: [-62, 14, 10], ForearmL: [-90, 0, 0], Torso: [20, -14, 0], Head: [28, 14, 0] })), K(42, merge(AIM, { Head: [-16, 6, 0], Torso: [-6, -14, 0] })), K(54, AIM)] },\n  { name: 'WalkHandsTied', frames: 24, loop: true, keys: [K(0, { Pelvis: { r: [4, 0, 0] }, LegR: [-22, 0, 0], ShinR: [8, 0, 0], LegL: [14, 0, 0], ShinL: [24, 0, 0], ArmR: [18, 8, 8], ForearmR: [-30, 20, 0], ArmL: [18, -8, -8], ForearmL: [-30, -20, 0], Head: [18, 0, 0] }), K(12, { Pelvis: { r: [4, 0, 0] }, LegR: [14, 0, 0], ShinR: [24, 0, 0], LegL: [-22, 0, 0], ShinL: [8, 0, 0], ArmR: [18, 8, 8], ForearmR: [-30, 20, 0], ArmL: [18, -8, -8], ForearmL: [-30, -20, 0], Head: [18, 0, 0] }), K(24, { Pelvis: { r: [4, 0, 0] }, LegR: [-22, 0, 0], ShinR: [8, 0, 0], LegL: [14, 0, 0], ShinL: [24, 0, 0], ArmR: [18, 8, 8], ForearmR: [-30, 20, 0], ArmL: [18, -8, -8], ForearmL: [-30, -20, 0], Head: [18, 0, 0] })] },\n  { name: 'Shrug', frames: 80, loop: true, keys: [K(0, { Head: [0, 0, 0], ArmR: [-10, 0, -6], ForearmR: [-60, 0, 0], ArmL: [-10, 0, 6], ForearmL: [-60, 0, 0] }), K(30, { Head: [0, 0, 0], ArmR: [-10, 0, -6], ForearmR: [-60, 0, 0], ArmL: [-10, 0, 6], ForearmL: [-60, 0, 0] }), K(40, { Head: [6, 0, 10], Torso: [0, 0, 0], ArmR: [-24, 0, -34], ForearmR: [-90, 0, 0], ArmL: [-24, 0, 34], ForearmL: [-90, 0, 0] }, 'out'), K(54, { Head: [6, 0, 10], ArmR: [-24, 0, -34], ForearmR: [-90, 0, 0], ArmL: [-24, 0, 34], ForearmL: [-90, 0, 0] }), K(80, { Head: [0, 0, 0], ArmR: [-10, 0, -6], ForearmR: [-60, 0, 0], ArmL: [-10, 0, 6], ForearmL: [-60, 0, 0] })] },\n  { name: 'SmokeIdle', frames: 120, loop: true, keys: [K(0, { ArmL: [-10, 0, 8], ForearmL: [-96, -30, 0], ArmR: [10, 0, -4], ForearmR: [-10, 0, 0] }), K(50, { ArmL: [-10, 0, 8], ForearmL: [-96, -30, 0], ArmR: [10, 0, -4], ForearmR: [-10, 0, 0] }), K(66, { ArmR: [-40, 16, -4], ForearmR: [-120, 0, 0], ArmL: [-10, 0, 8], ForearmL: [-96, -30, 0], Head: [-8, 0, 0] }, 'inOut'), K(82, { ArmR: [-40, 16, -4], ForearmR: [-120, 0, 0], ArmL: [-10, 0, 8], ForearmL: [-96, -30, 0], Head: [-8, 0, 0] }), K(100, { ArmL: [-10, 0, 8], ForearmL: [-96, -30, 0], ArmR: [10, 0, -4], ForearmR: [-10, 0, 0] }), K(120, { ArmL: [-10, 0, 8], ForearmL: [-96, -30, 0], ArmR: [10, 0, -4], ForearmR: [-10, 0, 0] })] },\n  { name: 'CleanRifleIdle', frames: 60, loop: true, keys: [K(0, { Head: [24, 0, 0], Torso: [6, 0, 0], ArmR: [-44, 0, 0], ForearmR: [-50, 0, 0], ArmL: [-40, 14, 0], ForearmL: [-80, 0, 0] }), K(30, { Head: [24, 0, 0], Torso: [6, 0, 0], ArmR: [-52, 0, 0], ForearmR: [-40, 0, 0], ArmL: [-40, 14, 0], ForearmL: [-80, 0, 0] }, 'inOut'), K(60, { Head: [24, 0, 0], Torso: [6, 0, 0], ArmR: [-44, 0, 0], ForearmR: [-50, 0, 0], ArmL: [-40, 14, 0], ForearmL: [-80, 0, 0] })] },\n  { name: 'WriteAtDesk', frames: 50, loop: true, keys: [K(0, { Pelvis: { r: [0, 0, 0], p: [0, -0.26, 0] }, LegR: [-84, 0, 0], ShinR: [84, 0, 0], LegL: [-84, 0, 0], ShinL: [84, 0, 0], Torso: [16, 0, 0], Head: [22, 0, 0], ArmR: [-46, 0, 0], ForearmR: [-64, 0, 0], ArmL: [-40, 10, 0], ForearmL: [-70, 0, 0] }), K(25, { Pelvis: { r: [0, 0, 0], p: [0, -0.26, 0] }, LegR: [-84, 0, 0], ShinR: [84, 0, 0], LegL: [-84, 0, 0], ShinL: [84, 0, 0], Torso: [18, 0, 0], Head: [26, 0, 0], ArmR: [-50, 14, 0], ForearmR: [-60, 0, 0], ArmL: [-40, 10, 0], ForearmL: [-70, 0, 0] }, 'inOut'), K(50, { Pelvis: { r: [0, 0, 0], p: [0, -0.26, 0] }, LegR: [-84, 0, 0], ShinR: [84, 0, 0], LegL: [-84, 0, 0], ShinL: [84, 0, 0], Torso: [16, 0, 0], Head: [22, 0, 0], ArmR: [-46, 0, 0], ForearmR: [-64, 0, 0], ArmL: [-40, 10, 0], ForearmL: [-70, 0, 0] })] },\n  { name: 'TeachPoint', frames: 70, loop: true, keys: [K(0, { ArmR: [-110, 20, -20], ForearmR: [-14, 0, 0], ArmL: [-14, 0, 6], ForearmL: [-70, 0, 0], Head: [-4, 14, 0] }), K(20, { ArmR: [-126, 20, -20], ForearmR: [-40, 0, 0], ArmL: [-14, 0, 6], ForearmL: [-70, 0, 0], Head: [-4, 14, 0] }, 'inOut'), K(35, { ArmR: [-110, 20, -20], ForearmR: [-14, 0, 0], ArmL: [-14, 0, 6], ForearmL: [-70, 0, 0], Head: [4, -10, 0] }), K(70, { ArmR: [-110, 20, -20], ForearmR: [-14, 0, 0], ArmL: [-14, 0, 6], ForearmL: [-70, 0, 0], Head: [-4, 14, 0] })] },\n];\n\n// ---------- Hands ----------\nconst J = (r, p) => (p ? { r, p } : { r });\nconst gunRest = {};\nfunction gunClips({ fireKick = 0.03, fireRise = 5, reload = 60, kind = 'mag' } = {}) {\n  const clips = [\n    { name: 'Idle', frames: 60, loop: true, keys: [K(0, { Weapon: J([0, 0, 0]) }), K(30, { Weapon: J([0.5, 0, 0], [0, 0.002, 0]) }, 'inOut'), K(60, { Weapon: J([0, 0, 0]) })] },\n    { name: 'Fire', frames: 6, fast: true, keys: [K(0, { Weapon: J([0, 0, 0]) }), K(1, { Weapon: J([-fireRise, 0, 0], [0, 0.006, -fireKick]), Bolt: { p: [0, 0, -0.05] } }, 'out'), K(6, { Weapon: J([0, 0, 0]), Bolt: { p: [0, 0, 0] } })] },\n    { name: 'Equip', frames: 14, fast: true, keys: [K(0, { Weapon: J([50, 10, 0], [0, -0.3, -0.05]) }), K(14, { Weapon: J([0, 0, 0]) }, 'out')] },\n    { name: 'Holster', frames: 10, fast: true, keys: [K(0, { Weapon: J([0, 0, 0]) }), K(10, { Weapon: J([50, 10, 0], [0, -0.3, -0.05]) }, 'in')] },\n    // Slap and rack: the heart of pillar one.\n    { name: 'Unjam', frames: 24, fast: true, keys: [K(0, { Weapon: J([0, 0, 0]) }), K(5, { Weapon: J([8, -20, -35], [-0.05, 0.06, 0.05]), ArmL: { r: [0, 0, 0], p: [0.02, -0.08, -0.06] } }, 'out'), K(8, { Weapon: J([10, -24, -40], [-0.06, 0.04, 0.05]), ArmL: { r: [-20, 0, 0], p: [-0.02, -0.02, -0.18] } }, 'in'), K(13, { Weapon: J([4, -12, -22], [-0.03, 0.05, 0.03]), Bolt: { p: [0, 0, -0.08] }, ArmL: { r: [0, 0, 0], p: [0.05, -0.03, -0.26] } }, 'out'), K(17, { Weapon: J([2, -6, -8], [-0.01, 0.02, 0.01]), Bolt: { p: [0, 0, 0] }, ArmL: { r: [0, 0, 0], p: [0.02, -0.02, -0.12] } }), K(24, { Weapon: J([0, 0, 0]), ArmL: { r: [0, 0, 0], p: [0, 0, 0] } }, 'out')] },\n    // The gun comes apart in your hands.\n    { name: 'FallApart', frames: 34, keys: [K(0, { Weapon: J([0, 0, 0]) }), K(8, { Weapon: J([14, 20, -40], [-0.04, 0.03, 0.02]), Bolt: { p: [0.03, 0.04, 0] } }, 'inOut'), K(16, { Weapon: J([28, 24, -50], [-0.05, -0.08, 0.02]), Mag: { p: [0, -0.4, 0] }, Bolt: { p: [0.08, 0.1, 0.1] } }), K(34, { Weapon: J([70, 40, -60], [-0.1, -0.7, 0.05]), Mag: { p: [0, -0.9, 0] }, Bolt: { p: [0.2, -0.5, 0.2] } }, 'in')] },\n    { name: 'Swing', frames: 16, fast: true, keys: [K(0, { Weapon: J([0, 0, 0]) }), K(5, { Weapon: J([-50, 40, 20], [0.08, 0.14, -0.1]) }, 'out'), K(9, { Weapon: J([50, -60, -30], [0.2, -0.06, 0.2]) }, 'in'), K(16, { Weapon: J([0, 0, 0]) }, 'out')] },\n  ];\n  const R = reload;\n  if (kind === 'mag') clips.push({ name: 'Reload', frames: R, keys: [K(0, { Weapon: J([0, 0, 0]) }), K(R * 0.15, { Weapon: J([6, -14, -24], [-0.03, 0.05, 0.04]), ArmL: { r: [0, 0