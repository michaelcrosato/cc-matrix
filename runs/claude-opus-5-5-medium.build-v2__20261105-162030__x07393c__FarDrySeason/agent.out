otalHours);\n    // Things in the fire.\n    for (const d of this.destructibles) if (d.fuse >= 0 && !d.destroyed) { d.fuse -= dt; if (d.fuse <= 0) this.destroy(d, null); }\n    // Cloth.\n    if (this.stepCount % 2 === 0) for (const c of this.cloths) if (dist2(c.x, c.z, this.focusX ?? 0, this.focusZ ?? 0) < 120) { c.body.wind = [this.wind.x * this.wind.speed * 1.4, 0, this.wind.z * this.wind.speed * 1.4]; c.body.step(dt * 2); }\n    // Lightning.\n    if (this.weather === 'storm') { this.lightningT -= dt; if (this.lightningT <= 0) { this.lightningT = this.rng.range(6, 15); if (!this.game.settings.reduceFlashes) this.ctx.engine.screen.flash('white', { duration: 0.15, strength: 0.5 }); this.ctx.audio.play('thunder', { volume: 0.7 * this.game.sfxK() }); } }\n    this.fauna(dt);\n  }\n  fauna(dt) {\n    if (this.game.session) return;\n    const fx = this.focusX ?? 0, fz = this.focusZ ?? 0;\n    for (const h of this.herd) {\n      const near = dist2(h.x, h.z, fx, fz);\n      if (near > 180) continue;\n      if (this.startle && dist2(h.x, h.z, this.startle[0], this.startle[1]) < 120 && h.flee <= 0) { h.flee = 7; const a = Math.atan2(h.z - this.startle[1], h.x - this.startle[0]) + this.rng.range(-0.5, 0.5); h.vx = Math.cos(a) * 11; h.vz = Math.sin(a) * 11; }\n      if (this.stepCount % 30 === 0 && this.fire.isBurning(h.x + h.vx, h.z + h.vz) && h.flee <= 0) { h.flee = 5; h.vx = -this.wind.z * 10; h.vz = this.wind.x * 10; }\n      if (h.flee > 0) { h.flee -= dt; h.x += h.vx * dt; h.z += h.vz * dt; h.yaw = Math.atan2(h.vx, h.vz); }\n    }\n    if (this.startle) this.startle = null;\n  }\n  shout(x, z) { this.startle = [x, z]; }\n  /** Blow up a destructible. */\n  destroy(d, by) {\n    if (d.destroyed) return; d.destroyed = true;\n    d.object.visible = false;\n    for (const c of d.colliders) { this.owners.delete(c.handle); if (this.ctx.physics.isAlive(c)) this.ctx.physics.remove(c); }\n    d.colliders = [];\n    this.game.events.emit('destroyed', d, by);\n    this.game.comb