 = true; s.base = Date.now() + 3000; ch.postMessage({ t: 'start', base: s.base, see\n    close() { ch.postMessage({ t: 'bye', from: me }); ch.close(); }, emit: e.emit };\n  ch.onmessage = (ev) => {\n    const m = ev.data;\n    if (m.t === 'hello' && isHost) { s.joined = true; ch.postMessage({ t: 'welcome' }); e.emit('joined'); }\n    if (m.t === 'welcome' && !isHost) { s.joined = true; e.emit('joined'); }\n    if (m.t === 'start') { s.base = m.base; s.seed = m.seed; s.started = true; e.emit('start', { in: m.base - Date.now() }); }\n    if (m.t === 'd' && m.from !== me && (m.to === null || m.to === me)) e.emit('message', m.data, m.from);\n    if (m.t === 'bye') e.emit('leave', { id: m.from, reason: 'left' });\n    if (m.t === 'end') e.emit('end', { reason: 'finished', standings: m.standings, scores: m.scores });\n  };\n  if (!isHost) { const hi = setInterval(() => { if (s.joined) clearInterval(hi); else ch.postMessage({ t: 'hello', name }); }, 300); }\n  return s;\n}\n// Every screen: title, main, pause, settings, about, ledger, game over, endings, bed, locker, rack, board.\nimport { ABOUT } from '../content/about.js';\nimport { EPIGRAPHS, ENDINGS, NOTES } from '../content/dialogue.js';\nimport { GAME_TITLE } from '../content/title.js';\nimport { SHOP_ORDER, THROWABLES, UPGRADES, WEAPONS } from '../content/weapons.js';\nimport { clamp } from '../world/geom.js';\nimport { wrap } from './pixfont.js';\nimport { devScreen } from '../dev/devmode.js';\nexport function touchGateScreen(g) {\n  return { id: 'touch-gate', top: 150, dim: false, back: null, footer: false, items: [{ label: 'SETTINGS', action: () => g.ui.push(settingsScreen(g)) }], draw() { g.drawTitle(true); const h = g.ctx.hud; h.text(0, 118, 'CONTROLLER OR KEYBOARD REQUIRED', { ancho\n}\nexport function pagesFromRows(rows, perPage = 15, cols = 72) {\n  // A question and its answer stay on one page.\n  const pages = []; let cur = [];\n  for (const [k, v] of rows) {\n    const entry = [{ big: k }, ...(v ? wrap(v,