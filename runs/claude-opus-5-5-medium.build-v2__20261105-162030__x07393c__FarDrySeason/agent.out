{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgBH5i1dcjhEzHiomXP","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BqDTDa1Nhg39g6oZLd69qx","name":"Bash","input":{"command":"cat > src/actors/buddy.js <<'EOF'\n// Three hired friends. They rescue you, offer better plans and die for real (section 12).\nimport { TUNING } from '../core/tuning.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { dist2 } from '../world/geom.js';\nconst DEFS = { ines: { model: 'ines', rescueLine: 'rescue.ines', hp: 40, range: 500 }, dov: { model: 'dov', rescueLine: 'rescue.dov', hp: 40, range: 260 }, mags: { model: 'mags', rescueLine: 'rescue.mags', hp: 60, range: 260 }, pell: { model: 'soldier-cloth', hp: 40, range: 0 } };\nexport const fresh = () => ({ ines: { met: false, alive: true, trust: 1, spentUntil: -1, gun: 'tractor' }, dov: { met: false, alive: true, trust: 1, spentUntil: -1, gun: 'mule' }, mags: { met: false, alive: true, trust: 1, spentUntil: -1, gun: 'm38' } });\nexport class Buddies {\n  state = fresh(); followers = []; down = null; finishT = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('buddies'); }\n  reset() { this.state = fresh(); this.clear(); }\n  clear() { for (const a of this.followers) this.game.actors.remove(a); this.followers.length = 0; this.down = null; }\n  ready(id) { const s = this.state[id]; return s && s.met && s.alive && s.spentUntil <= this.game.world.totalHours; }\n  alive() { return Object.keys(this.state).filter((k) => this.state[k].met && this.state[k].alive); }\n  available() { return this.alive().filter((k) => this.ready(k)).length > 0; }\n  /** The friend who comes for you. Ines drives from further away. */\n  rescuer() { const list = this.alive().filter((k) => this.ready(k)); if (!list.length) return null; return list.sort((a, b) => this.state[b].trust - this.state[a].trust)[0]; }\n  highestTrust() { const list = this.alive(); return list.length ? list.sort((a, b) => this.state[b].trust - this.state[a].trust)[0] : null; }\n  spawnFollower(id, x, z, o = {}) {\n    const g = this.game, def = DEFS[id];\n    const a = g.actors.spawn({ kind: 'buddy', faction: 'friend', friendly: true, buddy: id, modelId: def.model, palette: id === 'pell' ? { cloth: 'orange', dark: 'plum', hat: 'red', strap: 'sand', skin: 'plum' } : undefined, role: 'rifle', duty: o.duty ?? 'follow', x, z, hp: 200 });\n    a.hp = 200; a.maxHp = 200; a.fireproof = true;\n    this.followers.push(a);\n    return a;\n  }\n  addTrust(id, n = 1) { const s = this.state[id]; if (s) s.trust += n; }\n  /** A friend at zero: forty seconds and a choice. */\n  onDown(a, o) {\n    const g = this.game;\n    this.down = { a, fire: !!o.fire };\n    g.talk.say(a.buddy === 'pell' ? 'pell' : a.buddy, o.fire ? \"Don't let it be the fire. Please. Not the fire.\" : 'Get over here. Get over here.', 5);\n    g.audio.voiceAt(g.talk.voiceOf(a.buddy), 'Please. Not like this.', a, a.id);\n    g.events.emit('buddyDown', a);\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player, input = this.ctx.input;\n    this.finishT = Math.max(0, this.finishT - dt);\n    // Followers stay close.\n    for (const a of this.followers) if (a.alive && !a.down && a.duty === 'follow' && dist2(a.x, a.z, p.x, p.z) > 160) { a.ctrl?.teleport([p.x + 4, g.world.land.heightAt(p.x + 4, p.z + 4) + 0.1, p.z + 4]); }\n    const d = this.down; if (!d) return;\n    if (!d.a.alive) { this.lost(d.a, 'bled'); return; }\n    if (d.a.hp > 0 && !d.a.down) { this.down = null; return; }\n    if (p.vehicle || dist2(d.a.x, d.a.z, p.x, p.z) > 2.8) { g.prompt.setChoice(null); return; }\n    g.prompt.setChoice({ use: p.syrettes > 0 ? 'SYRETTE' : null, finish: 'FINISH IT' });\n    if (p.syrettes > 0 && pressedFixed(input, 'use')) { p.syrettes--; d.a.hp = 100; d.a.down = false; d.a.view?.setFull('Idle'); this.ctx.tweens.call(0.1, () => d.a.view?.stopFull()); g.audio.play('syrette'); this.addTrust(d.a.buddy, 1); this.down = null; g.prompt.setChoice(null); g.hud.touch(); g.vm.playTool('Syrette', ['tool-syrette']); g.events.emit('buddySaved', d.a); return; }\n    if (pressedFixed(input, 'finish') && !this.finishT) {\n      this.finishT = 3; g.prompt.setChoice(null); const a = d.a; this.down = null;\n      g.vm.playTool('Finish', ['tool-revolver']); g.frozen = true;\n      this.ctx.tweens.call(1.55, () => { g.audio.play('gun-revolver'); this.ctx.lights.request({ position: [a.x, a.y + 1, a.z], color: 0xffd090, intensity: 14, radius: 10, lifetime: 0.08 }); a.down = false; g.actors.kill(a, { silent: true, finished: true }); this.lost(a, 'finished'); });\n      this.ctx.tweens.call(2.4, () => { g.frozen = false; });\n    }\n  }\n  lost(a, how) {\n    const g = this.game, id = a.buddy;\n    this.down = null; g.prompt.setChoice(null);\n    const i = this.followers.indexOf(a); if (i >= 0) this.followers.splice(i, 1);\n    if (this.state[id]) { this.state[id].alive = false; (g.story.wall ??= []).push(id); }\n    if (id !== 'pell') g.story.ledger.friends++;\n    g.talk.say('you', how === 'finished' ? 'ONE SHOT.' : 'YOU WERE TOO LATE.', 4);\n    g.events.emit('buddyDead', a, how);\n    g.hud.touch();\n  }\n  /** Dragged backward, low, while they swear at you. */\n  rescue(id) {\n    const g = this.game, p = g.player, def = DEFS[id], s = this.state[id];\n    p.downT = 6.5; p.hp = 1; g.combat.stopStream(); if (p.vehicle) g.vehicles.exit(true);\n    s.spentUntil = g.world.totalHours + 24;\n    if (this.rng.next() < TUNING.buddyWoundChance) { s.spentUntil = g.world.totalHours + 48; g.story.woundNote = id; }\n    this.addTrust(id, 0);\n    let a = this.followers.find((f) => f.buddy === id && f.alive);\n    if (!a) a = this.spawnFollower(id, p.x + 1.4, p.z - 1.2, { duty: 'guard' });\n    a.invulnerable = true; a.dragging = true; a.view?.setFull('DragBackward');\n    const yaw = this.ctx.camera.yaw, dirx = Math.sin(yaw), dirz = Math.cos(yaw);\n    let t = 0;\n    const tick = g.events.on('fixed', (dt) => {\n      t += dt;\n      p.x += dirx * dt * 1.2; p.z += dirz * dt * 1.2; p.ctrl.teleport([p.x, g.world.land.heightAt(p.x, p.z) + 0.05, p.z]);\n      if (a.ctrl) a.ctrl.teleport([p.x + dirx * 1.2, g.world.land.heightAt(p.x, p.z) + 0.05, p.z + dirz * 1.2]); a.x = p.x + dirx * 1.2; a.z = p.z + dirz * 1.2; a.y = g.world.land.heightAt(a.x, a.z); a.yaw = yaw;\n      const eyeY = p.y + 0.42, wob = Math.sin(t * 7) * 0.05;\n      g.cam.override = { position: [p.x, eyeY + wob, p.z], target: [a.x, a.y + 1.1 + Math.sin(t * 2) * 0.2, a.z] };\n      if (t > 6.2) {\n        tick(); g.cam.override = null; p.downT = 0; p.hp = def.hp; a.invulnerable = false; a.dragging = false; a.view?.stopFull(); a.duty = 'follow'; g.frozen = false; g.body.regenT = 0; g.hud.touch();\n        if (g.story.woundNote === id) { g.talk.say(id, 'I took one for that. Two days. You owe me.', 5); g.story.woundNote = null; }\n        g.events.emit('rescued', id);\n        this.ctx.tweens.call(25, () => { if (a.alive && !a.down && !g.missions.active && this.followers.includes(a)) { const k = this.followers.indexOf(a); this.followers.splice(k, 1); g.actors.remove(a); } });\n      }\n    });\n    g.talk.playLines(def.rescueLine);\n    g.events.emit('rescueStart', id);\n    g.story.rescues = (g.story.rescues ?? 0) + 1;\n    void held;\n  }\n}\nEOF\ncat > src/actors/civilian.js <<'EOF'\n// People who live here, and people who used to. Civilians can't be shot: they flee, and the Ledger counts them.\nimport { CIV_PALETTES } from '../art/models.js';\nimport { STRIPS } from '../content/roads.js';\nimport { siteById, SITES } from '../content/sites.js';\nimport { dist2, polyLength, polyPoint } from '../world/geom.js';\nimport { PersonView } from './rig.js';\nconst NPC_CLIP = { odile: 'SmokeIdle', tibor: 'Shrug', vance: 'CleanRifleIdle', ansa: 'TeachPoint', harrow: 'WriteAtDesk', bakr: 'Idle', ines: 'Idle', dov: 'Idle', mags: 'Idle' };\nexport class People {\n  npcs = {}; civs = []; column = null; refugees = [];\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.ctx = ctx; this.rng = ctx.random.fork('people');\n    for (const def of SITES) for (const [id, dx, dz, yaw] of def.npcs ?? []) {\n      const x = def.at[0] + dx, z = def.at[1] + dz, y = this.game.world.land.heightAt(x, z);\n      const view = new PersonView(ctx, id, undefined, { gun: false });\n      view.place(x, y, z, (yaw * Math.PI) / 180); view.setFull(NPC_CLIP[id]);\n      this.npcs[id] = { id, view, x, y, z, yaw: (yaw * Math.PI) / 180, site: def.id };\n    }\n    // Friends wait at Mile Forty's bar once you've met them.\n    for (const [id, dx, dz] of [['ines', -25, 13], ['dov', -20, 18], ['mags', -19, -38]]) {\n      const x = dx, z = 40 + dz, y = this.game.world.land.heightAt(x, z), view = new PersonView(ctx, id, undefined, { gun: false });\n      view.place(x, y, z, 2.6); view.setFull('Idle'); view.object.visible = false;\n      this.npcs[id] = { id, view, x, y, z, yaw: 2.6, site: 'mile-forty', hidden: true };\n    }\n    for (const def of SITES) if (def.civilians) for (let i = 0; i < def.civilians; i++) this.spawnCiv(def, i);\n  }\n  spawnCiv(def, i) {\n    const a = this.rng.range(0, 6.28), r = this.rng.range(6, def.r * 0.45), x = def.at[0] + Math.cos(a) * r, z = def.at[1] + Math.sin(a) * r;\n    const view = new PersonView(this.ctx, 'civilian', CIV_PALETTES[i % 4], { gun: false });\n    view.setLower('Idle'); view.setUpper('Idle');\n    const c = { def, view, x, z, y: this.game.world.land.heightAt(x, z), yaw: a, gx: x, gz: z, wait: this.rng.range(0, 5), flee: 0, sp: 0 };\n    this.civs.push(c);\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player;\n    for (const c of this.civs) {\n      const near = dist2(c.x, c.z, p.x, p.z) < 200;\n      if (!near) continue;\n      if (c.flee > 0) c.flee -= dt;\n      if (c.flee <= 0 && g.world.time - (g.lastShotT ?? -99) < 2 && dist2(c.x, c.z, p.x, p.z) < 60 && !g.world.sites[c.def.id].calm) { c.flee = 6; const a = Math.atan2(c.z - p.z, c.x - p.x) + this.rng.range(-0.8, 0.8); c.gx = c.def.at[0] + Math.cos(a) * c.def.r * 0.7; c.gz = c.def.at[1] + Math.sin(a) * c.def.r * 0.7; }\n      if (g.world.fire.isBurning(c.x + g.world.wind.x * 8, c.z + g.world.wind.z * 8)) { c.flee = 6; c.gx = c.x - g.world.wind.x * 30; c.gz = c.z - g.world.wind.z * 30; }\n      const dx = c.gx - c.x, dz = c.gz - c.z, l = Math.hypot(dx, dz);\n      if (l < 0.6) { c.sp = 0; c.wait -= dt; if (c.wait <= 0) { c.wait = this.rng.range(3, 9); const a = this.rng.range(0, 6.28), r = this.rng.range(4, c.def.r * 0.5); c.gx = c.def.at[0] + Math.cos(a) * r; c.gz = c.def.at[1] + Math.sin(a) * r; } }\n      else { const sp = c.flee > 0 ? 4.2 : 1.2; c.sp = sp; c.x += (dx / l) * sp * dt; c.z += (dz / l) * sp * dt; c.yaw = Math.atan2(dx, dz); c.y = g.world.land.heightAt(c.x, c.z); }\n    }\n    if (this.column) {\n      const col = this.column; col.s += dt * 1.1;\n      for (const w of col.walkers) { const q = polyPoint(col.path, Math.max(0, Math.min(col.L, col.s + w.off))); w.x = q.x + w.side; w.z = q.z; w.yaw = q.yaw; }\n    }\n    for (const r of this.refugees) { const q = polyPoint(r.path, Math.min(r.L, (r.s += dt * 1.1))); r.x = q.x + r.side; r.z = q.z + r.side * 0.5; r.yaw = q.yaw; }\n  }\n  /** Three Wells empties. */\n  emptyThreeWells() {\n    const def = siteById['three-wells'], keep = [];\n    for (const c of this.civs) if (c.def === def) { c.view.dispose(); } else keep.push(c);\n    this.civs = keep;\n    const path = [def.at, [-200, 30], [-100, 35], [-20, 15]], L = polyLength(path);\n    for (let i = 0; i < 14; i++) { const view = new PersonView(this.ctx, 'civilian', CIV_PALETTES[i % 4], { gun: false }); view.setLower('Walk', 0.5); view.setUpper('Idle'); this.refugees.push({ view, path, L, s: -i * 3, side: (i % 3) - 1, x: def.at[0], z: def.at[1], yaw: 0 }); }\n  }\n  /** The column walks the scar. */\n  startColumn() {\n    if (this.column) return;\n    const arc = [...STRIPS.A.points, ...STRIPS.C.points.slice(1), ...STRIPS.B.points.slice(1), [-590, -430]], L = polyLength(arc), walkers = [];\n    for (let i = 0; i < 18; i++) { const view = new PersonView(this.ctx, 'civilian', CIV_PALETTES[i % 4], { gun: false }); view.setLower('Walk', 0.5); view.setUpper('Idle'); walkers.push({ view, off: -i * 3.5, side: ((i * 7) % 5) - 2, x: arc[0][0], z: arc[0][1], yaw: 0 }); }\n    this.column = { path: arc, L, s: 60, walkers };\n  }\n  clearDynamic() {\n    if (this.column) { for (const w of this.column.walkers) w.view.dispose(); this.column = null; }\n    for (const r of this.refugees) r.view.dispose(); this.refugees = [];\n    if (!this.civs.some((c) => c.def.id === 'three-wells')) for (let i = 0; i < siteById['three-wells'].civilians; i++) this.spawnCiv(siteById['three-wells'], i);\n  }\n  showFriends() { const st = this.game.buddies.state; for (const id of ['ines', 'dov', 'mags']) { const n = this.npcs[id]; n.hidden = !(st[id].met && st[id].alive) || this.game.buddies.followers.some((f) => f.buddy === id); } }\n  update(dt) {\n    const g = this.game, cx = g.camX ?? 0, cz = g.camZ ?? 0;\n    for (const n of Object.values(this.npcs)) { const near = dist2(n.x, n.z, cx, cz) < 200 && !n.hidden && !n.gone; n.view.object.visible = near; if (near) { n.view.place(n.x, n.y, n.z, n.yaw); n.view.update(dt); } }\n    for (const c of this.civs) { const near = dist2(c.x, c.z, cx, cz) < 170; c.view.object.visible = near; if (!near) continue; c.view.place(c.x, c.y, c.z, c.yaw); c.view.setLower(c.sp > 2 ? 'Run' : c.sp > 0 ? 'Walk' : 'Idle', c.sp > 2 ? 1 : 0.6); c.view.update(dt); }\n    const walkers = [...(this.column?.walkers ?? []), ...this.refugees];\n    for (const w of walkers) { const near = dist2(w.x, w.z, cx, cz) < 300; w.view.object.visible = near; if (near) { w.view.place(w.x, g.world.land.heightAt(w.x, w.z), w.z, w.yaw); w.view.update(dt); } }\n  }\n}\nEOF\ncat > src/ui/dialogue.js <<'EOF'\n// Subtitles, voices and the short first-person scenes: the camera holds on the speaker, two buttons at most.\nimport { LINES, SPEAKERS } from '../content/dialogue.js';\nimport { pressed } from '../core/actions.js';\nexport class Talk {\n  queue = []; current = null; scene = null; barkText = null; barkT = 0;\n  constructor(game) { this.game = game; }\n  voiceOf(id) { return SPEAKERS[id]?.voice ?? 'soldier'; }\n  say(who, text, secs) { const t = text.toUpperCase(); const line = { who, text: t, secs: secs ?? Math.max(1.6, t.length * 0.062) }; if (this.current?.text === t || this.queue.some((l) => l.text === t)) return; this.queue.push(line); }\n  linesOf(id) { const l = LINES[id]; return l ?? []; }\n  /** Play a named set of lines as subtitles, no lock. */\n  playLines(id, speaker) { for (const [who, text] of this.linesOf(id)) this.say(speaker ?? who, text); }\n  bark(name, text) { this.barkText = `${name}: ${text.toUpperCase()}`; this.barkT = 2.4; }\n  clear() { this.queue.length = 0; this.current = null; this.scene = null; this.barkText = null; }\n  locksPlayer() { return !!this.scene; }\n  /** A scene: the camera holds on `at` (a speaker's head), lines play, optional choices end it. */\n  startScene({ lines = [], speaker, at, camera, choices, onDone, skippable = true }) {\n    const g = this.game, npc = speaker ? g.people.npcs[speaker] : null;\n    const focus = at ?? (npc ? [npc.x, npc.y + 1.55, npc.z] : null);\n    const items = lines.flatMap((id) => (typeof id === 'string' ? this.linesOf(id) : [id]));\n    this.scene = { items, i: -1, t: 0, focus, camera, choices, onDone, skippable, choosing: false, focusI: 0, npc };\n    if (focus && !camera) {\n      const p = g.player, e = p.eyeNow().clone(); const dx = focus[0] - e.x, dz = focus[2] - e.z, l = Math.hypot(dx, dz) || 1;\n      const dist = Math.min(l, 1.8); this.scene.camera = { position: [focus[0] - (dx / l) * dist, focus[1] + 0.02, focus[2] - (dz / l) * dist], target: focus };\n    }\n    if (this.scene.camera) g.cam.override = this.scene.camera;\n    this.queue.length = 0; this.current = null;\n    if (npc) { const k = Math.atan2(g.player.x - npc.x, g.player.z - npc.z); npc.turned = npc.yaw; npc.yaw = k; }\n    this.nextLine();\n  }\n  nextLine() {\n    const s = this.scene; if (!s) return;\n    s.i++; s.t = 0;\n    if (s.i >= s.items.length) {\n      if (s.choices) { s.choosing = true; this.current = null; return; }\n      this.endScene(); return;\n    }\n    const [who, text] = s.items[s.i], tx = text.toUpperCase();\n    s.dur = Math.max(1.8, tx.length * 0.07);\n    this.current = { who, text: tx, secs: 1e9 };\n    this.game.audio.voice(this.voiceOf(who), tx);\n  }\n  endScene(choice) {\n    const s = this.scene, g = this.game; this.scene = null; this.current = null;\n    if (s.camera) g.cam.override = null;\n    if (s.npc && s.npc.turned !== undefined) { s.npc.yaw = s.npc.turned; }\n    s.onDone?.(choice);\n  }\n  /** In update(): menus and scenes live here, with dt that may be zero. */\n  update(dt, realDt) {\n    const g = this.game, input = g.ctx.input;\n    if (this.barkT > 0) this.barkT -= realDt;\n    const s = this.scene;\n    if (s) {\n      if (s.choosing) {\n        const n = s.choices.length;\n        if (pressed(input, 'left') || pressed(input, 'up')) { s.focusI = (s.focusI + n - 1) % n; g.audio.play('ui-move'); }\n        if (pressed(input, 'right') || pressed(input, 'down')) { s.focusI = (s.focusI + 1) % n; g.audio.play('ui-move'); }\n        const hit = g.hud.choiceHit(s, n);\n        if (hit !== null) s.focusI = hit;\n        if (pressed(input, 'confirm') || g.hud.clicked(s, n)) { g.audio.play('ui-confirm'); const c = s.choices[s.focusI]; this.endScene(c); c.fn?.(); }\n        return;\n      }\n      s.t += realDt;\n      if (s.t >= s.dur || (s.skippable && s.t > 0.15 && pressed(input, 'confirm'))) this.nextLine();\n      return;\n    }\n    if (this.current) { this.current.secs -= realDt; if (this.current.secs <= 0) this.current = null; }\n    if (!this.current && this.queue.length) { this.current = this.queue.shift(); const v = this.voiceOf(this.current.who); if (v !== 'none') g.audio.voice(v, this.current.text); }\n  }\n  subtitle() { return this.current ? { who: SPEAKERS[this.current.who]?.name ?? '', color: SPEAKERS[this.current.who]?.color ?? 'white', text: this.current.text } : null; }\n}\nEOF\ncat > src/ui/prompts.js <<'EOF'\n// One usable thing at a time: glyph plus verb, sometimes a ring that fills.\nimport { held, pressedFixed } from '../core/actions.js';\nimport { CASES as _C, siteById, TRIGS } from '../content/sites.js';\nimport { HALTS } from '../content/roads.js';\nimport { NOTES, NOTE_REWARD } from '../content/dialogue.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { angleDiff, dist2 } from '../world/geom.js';\nexport class Prompt {\n  current = null; holdT = 0; flashT = 0; flashText = null; flashAction = null; choice = null; extra = []; scanClock = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.pickups = []; this.missionUse = []; }\n  has() { return !!this.current; }\n  jumpBlocked() { return false; }\n  chargePreferred() { return this.game.missions.wantsCharge?.() ?? false; }\n  setChoice(c) { this.choice = c; }\n  flash(action, text) { this.flashAction = action; this.flashText = text; this.flashT = 1.6; }\n  addPickup(p) { this.pickups.push(p); return p; }\n  removePickup(p) { const i = this.pickups.indexOf(p); if (i >= 0) this.pickups.splice(i, 1); if (p.object) this.ctx.scene.remove(p.object); }\n  clearDynamic() { for (const p of [...this.pickups]) this.removePickup(p); this.missionUse.length = 0; this.current = null; }\n  /** All things near enough to use. */\n  candidates() {\n    const g = this.game, p = g.player, out = [], px = p.x, pz = p.z;\n    const near = (x, z, r = 2.5) => Math.abs(x - px) < r && Math.abs(z - pz) < r && dist2(x, z, px, pz) < r;\n    const add = (o) => out.push(o);\n    if (p.vehicle) { // Only what a driver can do.\n      for (const u of this.missionUse) if (u.driveIn && near(u.x, u.z, 8)) add(u);\n      if (!p.mounted) add({ x: p.vehicle.x, z: p.vehicle.z, y: p.y + 1, label: 'GET OUT', silent: true, action: 'exit', passive: true });\n      return out;\n    }\n    for (const u of this.missionUse) if (near(u.x, u.z, u.r ?? 2.5)) add(u);\n    for (const q of this.pickups) if (near(q.x, q.z, 2.5)) add({ ...q, fn: () => q.use() });\n    for (const v of g.vehicles.list) {\n      if (v.dead || !near(v.x, v.z, 5.5)) continue;\n      const [bx, bz] = v.bonnet(), [dx, dz] = v.door();\n      if (v.hp < 50 && !v.dead && near(bx, bz, 2)) add({ x: bx, z: bz, y: v.y + 0.6, label: 'OPEN THE BONNET', hold: p.upgrades.vehicle ? 1.5 : 3, fn: () => g.repair(v), holdClip: 'wrench', vehicle: v });\n      if (near(dx, dz, 2.2) && !v.aiRoad && !v.stalled) add({ x: dx, z: dz, y: v.y + 1, label: 'GET IN', fn: () => g.vehicles.enter(v) });\n      else if (near(dx, dz, 2.2) && v.stalled && v.hp > 0) add({ x: dx, z: dz, y: v.y + 1, label: 'GET IN', fn: () => g.vehicles.enter(v) });\n    }\n    for (const s of Object.values(g.world.sites)) {\n      if (!s.def.usables || dist2(s.def.at[0], s.def.at[1], px, pz) > s.def.r + 8) continue;\n      for (const u of s.def.usables) {\n        const x = s.def.at[0] + u.at[0], z = s.def.at[1] + u.at[1];\n        if (!near(x, z, 3)) continue;\n        if (u.needs === 'cleared' && !s.cleared && !g.story.flags[s.id]) continue;\n        const o = g.usableFor(u, s); if (o) add({ x, z, y: g.world.land.heightAt(x, z) + 1, ...o });\n      }\n    }\n    for (const n of Object.values(g.people.npcs)) { if (n.hidden || n.gone || !near(n.x, n.z, 2.8)) continue; const o = g.talkTo(n.id); if (o) add({ x: n.x, z: n.z, y: n.y + 1.5, ...o }); }\n    for (const c of g.world.cases) if (!c.taken && near(c.at[0], c.at[1], 2.6)) add({ x: c.at[0], z: c.at[1], y: g.world.land.heightAt(c.at[0], c.at[1]) + 0.3, label: 'TAKE THE CASE', fn: () => g.takeCase(c) });\n    for (const t of TRIGS) if (near(t.at[0], t.at[1], 3)) { if (!g.story.trigs?.[t.id]) add({ x: t.at[0], z: t.at[1], y: t.y + 1.2, label: 'SIGHT THE PILLAR', hold: 1, fn: () => g.useTrig(t) }); }\n    for (const h of HALTS) if (near(h.at[0], h.at[1], 4)) add({ x: h.at[0], z: h.at[1], y: g.world.land.heightAt(h.at[0], h.at[1]) + 1, label: g.story.halts?.[h.id] ? 'RIDE THE GOODS LINE' : 'MARK THIS HALT', fn: () => g.useHalt(h) });\n    return out;\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player, input = this.ctx.input;\n    this.flashT = Math.max(0, this.flashT - dt);\n    if (g.ui.top || p.mapUp || !p.canAct()) { this.current = null; this.holdT = 0; return; }\n    this.scanClock -= dt;\n    if (this.scanClock <= 0) {\n      this.scanClock = 0.1;\n      const yaw = this.ctx.camera.yaw;\n      let best = null, bs = 1e9;\n      for (const c of this.candidates()) {\n        if (c.passive) { if (!best) { best = c; bs = 1e8; } continue; }\n        const a = Math.atan2(-(c.x - p.x), -(c.z - p.z)), off = Math.abs(angleDiff(a, yaw)), d = dist2(c.x, c.z, p.x, p.z);\n        if (off > (40 * Math.PI) / 180 && d > 1.1 && !c.anyAngle) continue;\n        const score = off * 2 + d * 0.3;\n        if (score < bs) { bs = score; best = c; }\n      }\n      this.current = best;\n    }\n    const c = this.current;\n    if (!c || c.passive) { this.holdT = 0; return; }\n    if (c.hold) {\n      if (held(input, 'use')) {\n        if (this.holdT === 0 && c.holdClip === 'wrench') { g.vm.playTool('Wrench', ['tool-wrench'], { loop: true }); this.toolLoop = true; }\n        this.holdT += dt;\n        if (c.holdClip === 'wrench' && g.world.stepCount % 20 === 0) { this.ctx.particles.burst('sparks', [c.x, c.y, c.z], { count: 4 }); g.audio.play('wrench'); }\n        if (this.holdT >= c.hold) { this.holdT = 0; if (this.toolLoop) { g.vm.endTool(); this.toolLoop = false; } input.clearQueued('PadSquare', 'KeyE'); c.fn(); this.current = null; }\n      } else { if (this.holdT > 0 && this.toolLoop) { g.vm.endTool(); this.toolLoop = false; } this.holdT = 0; input.clearQueued('PadSquare', 'KeyE'); }\n    } else if (pressedFixed(input, 'use')) { c.fn(); this.current = null; g.audio.play('ui-confirm', { volume: 0.4 }); }\n  }\n}\nexport { _C, siteById, NOTES, NOTE_REWARD, WEAPONS };\nEOF\ncat > src/missions/ledger.js <<'EOF'\nexport const freshLedger = () => ({ moved: 0, killed: 0, friends: 0, stones: 0, hectares: 0, harrow: null });\nEOF\ncat > src/missions/runner.js <<'EOF'\n// The mission runner. Steps are data; the runner gives each type its meaning. Bots drive these same steps.\nimport { missionById, MISSIONS } from '../content/missions.js';\nimport { siteById } from '../content/sites.js';\nimport { TUNING } from '../core/tuning.js';\nimport { dist2 } from '../world/geom.js';\nimport { SCRIPTS } from './scripts.js';\nexport class Missions {\n  active = null; stepI = 0; steps = []; st = {}; altPending = null; altT = 0; textT = 0; textStr = '';\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('missions'); const g = this.game; g.events.on('destroyed', (d) => this.onDestroyed(d)); g.events.on('actorDied', (a, o) => { if (a.tag) this.st.killed = (this.st.killed ?? 0) + 1; void o; }); }\n  done(id) { return !!this.game.story.done[id]; }\n  /** The next contract this giver has for you. */\n  availableFor(giver) { if (this.active) return null; return MISSIONS.find((m) => m.giver === giver && !this.done(m.id) && !m.auto && m.requires.every((r) => this.done(r))) ?? null; }\n  available() { if (this.active) return []; return MISSIONS.filter((m) => !this.done(m.id) && !m.auto && m.requires.every((r) => this.done(r))); }\n  start(id) {\n    const m = missionById[id], g = this.game;\n    this.active = m; this.stepI = 0; this.st = {}; this.altTaken = false; this.altPending = null;\n    this.steps = [...m.steps];\n    g.story.current = id;\n    if (m.act) g.story.act = m.act;\n    if (m.hour !== undefined && (m.forceHour || m.auto)) g.world.setHour(m.hour, true);\n    if (m.weather) g.world.setWeather(m.weather);\n    g.world.pinWind(m.wind);\n    g.story.pass = m.pass ?? null;\n    if (m.give?.flare && !g.player.guns.sidearm?.id?.includes('flare')) { g.story.hasFlare = true; g.combat.give('flare', 100, false); g.player.flareAmmo = 8; }\n    if (m.give?.tracker) { g.story.hasTracker = true; g.talk.say('you', 'THE TRACKER IS IN YOUR LEFT POCKET.', 3); }\n    if (m.spawnAt) g.player.teleport(m.spawnAt[0], m.spawnAt[1]);\n    if (m.alt && this.altEligible(m)) { this.altPending = m.alt; this.altT = 6; }\n    g.events.emit('missionStart', m);\n    this.beginStep();\n  }\n  altEligible(m) { const b = this.game.buddies, id = m.alt.buddy; if (id === 'any') return b.alive().length > 0; if (m.alt.always) return b.state[id].alive; return b.state[id].met && b.state[id].alive; }\n  acceptAlt() {\n    const a = this.altPending, m = this.active, g = this.game; if (!a) return;\n    this.altPending = null; this.altTaken = true; g.prompt.setChoice(null);\n    const steps = this.steps.slice(), at = this.stepI;\n    steps.splice(at, 0, ...a.steps); this.steps = steps;\n    let buddy = a.buddy === 'any' ? g.buddies.highestTrust() : a.buddy;\n    g.story.altTaken = g.story.altTaken ?? {}; g.story.altTaken[m.id] = true;\n    if (a.buddy === 'dov') g.buddies.state.dov.met = true;\n    g.buddies.addTrust(buddy, 1);\n    if (!g.buddies.followers.some((f) => f.buddy === buddy && f.alive)) g.buddies.spawnFollower(buddy, g.player.x + 3, g.player.z + 3);\n    g.audio.play('radio');\n    g.events.emit('altAccepted', m);\n    this.beginStep();\n  }\n  ignoreAlt() { this.altPending = null; this.game.prompt.setChoice(null); }\n  get step() { return this.steps[this.stepI] ?? null; }\n  beginStep() {\n    const g = this.game, s = this.step; this.st.t = 0; this.st.killed = 0; this.st.done = false; this.st.deliverT = 0;\n    if (!s) return;\n    this.textStr = s.text; this.textT = 5;\n    g.hud.touch(); g.audio.play('map-paper', { volume: 0.2 });\n    if (s.spawn) this.spawnFor(s.spawn);\n    if (s.do === 'destroy') { this.st.destroyed = g.world.destructibles.filter((d) => d.tag === s.tag && d.destroyed && (!s.site || d.site === s.site)).length; if (s.givesCharges) { g.player.charges = Math.max(g.player.charges, s.givesCharges); g.talk.say('you', 'THE COLONEL SENT CHARGES. HOLD THROW TO PLANT.', 4); } }\n    if (s.do === 'use') this.addUse(s);\n    if (s.do === 'hold') { this.st.left = s.seconds; this.st.waveT = 2; }\n    if (s.do === 'ride' || s.do === 'script' || s.do === 'choice') { const sc = SCRIPTS[s.script]; if (sc?.start) sc.start(g, s, this.st); }\n    if (s.lines && s.do !== 'talk' && s.do !== 'report' && s.do !== 'use' && s.do !== 'deliver') g.talk.playLines(s.lines);\n    g.autoWaypoint();\n    g.events.emit('stepStart', s);\n  }\n  addUse(s) {\n    const g = this.game; let x, z;\n    if (s.at.length === 3) { const site = siteById[s.at[2]]; x = site.at[0] + s.at[0]; z = site.at[1] + s.at[1]; } else { x = s.at[0]; z = s.at[1]; }\n    const u = { x, z, y: g.world.land.heightAt(x, z) + 1, label: s.label, hold: s.hold ?? 0, r: 3.2, anyAngle: true, tag: s.tag, fn: () => { g.prompt.missionUse = g.prompt.missionUse.filter((o) => o !== u); if (s.onDone) SCRIPTS[s.onDone]?.run?.(g, s); this.st.used = true; } };\n    g.prompt.missionUse.push(u);\n  }\n  spawnFor(sp) {\n    const g = this.game;\n    if (sp.vehicle) { if (!g.vehicles.list.some((v) => v.tag === sp.tag)) g.vehicles.spawn(sp.vehicle, sp.at[0], sp.at[1], (sp.yaw * Math.PI) / 180, sp.tag); }\n    if (sp.pickup === 'gun') g.spawnGunPickup(sp.gun, sp.cond, sp.at[0], sp.at[1], sp.tag);\n  }\n  /** Where the current step wants you. */\n  target() {\n    const s = this.step; if (!s) return null;\n    const g = this.game;\n    if (s.at && s.at.length === 3) { const site = siteById[s.at[2]]; return [site.at[0] + s.at[0], site.at[1] + s.at[1]]; }\n    if (s.at) return s.at;\n    if (s.to && g.people.npcs[s.to]) return [g.people.npcs[s.to].x, g.people.npcs[s.to].z];\n    if (s.site) return siteById[s.site].at;\n    if (s.do === 'steal') { const v = g.vehicles.list.find((o) => o.tag === s.tag); if (v) return [v.x, v.z]; }\n    if (s.do === 'collect') { const q = g.prompt.pickups.find((o) => o.tag === s.tag); if (q) return s.tag === 'payroll-case' ? null : [q.x, q.z]; }\n    return this.st.target ?? null;\n  }\n  onDestroyed(d) { const s = this.step; if (s?.do === 'destroy' && d.tag === s.tag && (!s.site || d.site === s.site)) { this.st.destroyed = (this.st.destroyed ?? 0) + 1; } }\n  next() {\n    const s = this.step; this.stepI++;\n    if (s?.do === 'script') SCRIPTS[s.script]?.end?.(this.game, s, this.st);\n    if (this.stepI >= this.steps.length) this.complete(); else this.beginStep();\n  }\n  complete() {\n    const m = this.active, g = this.game;\n    this.active = null; g.story.done[m.id] = true; g.story.current = null; g.story.pass = null;\n    g.world.pinWind(null); g.world.setWeather('clear');\n    const alt = this.altTaken ? (m.alt?.bonus ?? 0) : 0;\n    const pay = Math.round(Math.max(0, (m.pay ?? 0) + alt) * TUNING.stonesReward);\n    if (pay) { g.player.stones += pay; g.story.ledger.stones += pay; g.notice(`+${pay} STONES`); }\n    for (const a of m.onDone ?? []) {\n      if (a.give?.tablets) { g.player.tablets += a.give.tablets; g.notice(`+${a.give.tablets} TABLETS`); g.story.feverOn = true; g.body.resetFever(); }\n      if (a.flag) g.story.flags[a.flag] = true;\n      if (a.burnStrip) g.world.burnStrip(a.burnStrip);\n      if (a.script) SCRIPTS[a.script]?.run?.(g, m);\n      if (a.smoke) g.story.smoke = { at: a.smoke, until: g.world.totalHours + 24 };\n      if (a.line) g.talk.playLines(a.line);\n      if (a.ledger?.paid) g.story.ledger.paidFor = (g.story.ledger.paidFor ?? 0) + 0;\n    }\n    if (m.id === 'm4') g.buddies.state.dov.met = true;\n    g.buddies.clear();\n    g.people.showFriends();\n    g.events.emit('missionDone', m);\n    g.prompt.missionUse.length = 0;\n    g.save.write();\n    const nx = (m.onDone ?? []).find((a) => a.start);\n    if (nx) this.start(nx.start);\n    else if (this.available().length === 1 && this.available()[0].id === 'm7') g.talk.say('you', 'THERE IS A NOTE AT YOUR SAFEHOUSE.', 4);\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player, s = this.step;\n    if (this.textT > 0) this.textT -= dt;\n    if (!this.active || !s || g.ui.top || g.talk.locksPlayer()) return;\n    this.st.t += dt;\n    // The buddy's call.\n    if (this.altPending) {\n      this.altT -= dt;\n      if (this.altT <= 0 && !this.altCalled) { this.altCalled = true; g.audio.play('radio'); g.talk.playLines(this.altPending.call); this.st.altWindow = 16; }\n      if (this.altCalled) { this.st.altWindow -= dt; g.prompt.setChoice({ use: 'TAKE THE PLAN', finish: 'NOT THIS TIME', radio: true }); }\n      if (this.altCalled && (this.ctx.input.consumeAny(['PadSquare', 'KeyE']))) { this.altCalled = false; this.acceptAlt(); return; }\n      if (this.altCalled && (this.ctx.input.consumeAny(['PadTriangle', 'KeyF']) || this.st.altWindow <= 0)) { this.altCalled = false; this.ignoreAlt(); }\n    }\n    const site = s.site ? siteById[s.site] : null;\n    const dTo = (at) => dist2(at[0], at[1], p.x, p.z);\n    let ok = false;\n    switch (s.do) {\n      case 'goto': ok = dTo(s.at ?? site.at) < (s.r ?? 20); break;\n      case 'leave': ok = dTo(site.at) > s.r; break;\n      case 'talk': case 'report': this.ensureTalk(s); ok = !!this.st.talked; break;\n      case 'use': ok = !!this.st.used; if (ok && s.lines) { const l = s.lines; this.st.used = false; g.talk.startScene({ lines: [l], at: [p.x, p.y + 1.5, p.z + 2], onDone: () => this.next() }); return; } break;\n      case 'deliver': ok = dTo(s.at) < s.r; if (ok && s.lines) g.talk.playLines(s.lines); break;\n      case 'destroy': ok = (this.st.destroyed ?? 0) >= s.n; break;\n      case 'kill': ok = (this.st.killed ?? 0) >= s.n; break;\n      case 'collect': ok = !!g.story.collected?.[s.tag]; break;\n      case 'steal': ok = p.vehicle?.tag === s.tag; break;\n      case 'hold': ok = this.tickHold(s, dt); break;\n      case 'ride': case 'script': case 'choice': { const sc = SCRIPTS[s.script]; ok = sc?.tick ? sc.tick(g, s, this.st, dt) : true; break; }\n      case 'timer': ok = this.st.t >= s.seconds; break;\n      case 'escort': { const a = this.st.escort; ok = a && dist2(a.x, a.z, s.to[0], s.to[1]) < 8; break; }\n    }\n    if (ok) this.next();\n  }\n  tickHold(s, dt) {\n    const g = this.game, site = siteById[s.site], at = s.at ?? site.at, p = g.player;\n    const inside = dist2(at[0], at[1], p.x, p.z) < s.r;\n    if (inside) this.st.left -= dt;\n    this.st.waveT -= dt;\n    if (this.st.waveT <= 0) { this.st.waveT = 16; g.spawnWave(at, s.waves); }\n    g.hud.holdTimer = inside ? this.st.left : null;\n    if (this.st.left <= 0) { g.hud.holdTimer = null; return true; }\n    return false;\n  }\n  ensureTalk(s) {\n    const g = this.game;\n    if (this.st.talkAdded) return; this.st.talkAdded = true;\n    this.st.talkFn = () => { const alt = this.altTaken && s.linesAlt ? s.linesAlt : s.lines; g.talk.startScene({ lines: [alt], speaker: s.to, onDone: () => { this.st.talked = true; } }); };\n  }\n  /** The talk step's prompt, if this is the npc it wants. */\n  talkStep(id) { const s = this.step; if (s && (s.do === 'talk' || s.do === 'report') && s.to === id && this.st.talkFn) return { label: `TALK TO ${g2(id)}`, fn: this.st.talkFn }; return null; }\n}\nconst g2 = (id) => ({ odile: 'SISTER ODILE', tibor: 'TIBOR', vance: 'COL. VANCE', ansa: 'MOTHER ANSA', harrow: 'HARROW', bakr: 'OLD BAKR' })[id] ?? id.toUpperCase();\nexport const npcTitle = g2;\nEOF\ncat > src/missions/scripts.js <<'EOF'\n// The scripted beats of the story. Everything else in missions.js is plain data.\nimport { LINES } from '../content/dialogue.js';\nimport { RAILWAY, ROADS } from '../content/roads.js';\nimport { siteById } from '../content/sites.js';\nimport { TUNING } from '../core/tuning.js';\nimport { dist2, polyPoint } from '../world/geom.js';\nimport { BURNING, BURNT, cellX, cellZ, FIRE_N } from '../world/fire.js';\nconst fieldProgress = (g) => { const f = g.world.fire, site = siteById['long-field']; let tot = 0, lit = 0; const x0 = site.at[0] - 90, z0 = site.at[1] - 60; for (let z = z0; z < z0 + 120; z += 5) for (let x = x0; x < x0 + 180; x += 5) { const i = Math.floor((x + 640) / 5) + Math.floor((z + 640) / 5) * FIRE_N; tot++; if (f.state[i] === BURNING || f.state[i] === BURNT) lit++; } return lit / tot; };\nexport const SCRIPTS = {\n  // ----- M0 -----\n  m0Ride: {\n    start(g, s, st) {\n      const t = g.train, q = {}; polyPoint(RAILWAY, 0, q);\n      t.s = t.sToward(-520, 106); t.topSpeed = 13; t.goal = t.sToward(14, 68); t.place();\n      g.setRiding(t); g.world.setHour(18.2, true); g.world.sites['p2'].dormant = true;\n      g.player.setYaw(Math.PI * 0.5 + Math.PI, -0.05);\n      st.skip = false; g.player.items.map = true;\n    },\n    tick(g, s, st) { if (g.skipPressed()) st.skip = true; return st.skip || st.t >= s.seconds; },\n  },\n  m0Map: {\n    start(g, s, st) { st.upT = 0; g.story.marginNote = 'MIND THE FEVER. YOU ARE LATE ALREADY. E.H.'; g.prompt.flash('map', 'RAISE YOUR MAP'); st.nag = 0; },\n    tick(g, s, st, dt) { st.nag -= dt; if (st.nag <= 0 && !g.player.mapUp) { st.nag = 2; g.prompt.flash('map', 'RAISE YOUR MAP'); } if (g.player.mapUp) st.upT += dt; if (st.upT > 3) { return true; } return g.skipPressed(); },\n  },\n  m0Fever: {\n    start(g, s, st) { st.phase = 0; st.left = 14; g.body.fever = 0; g.body.feverActive = true; g.body.feverIgnored = -1e9; g.train.setAt(10, 70); g.setRiding(null); g.player.teleport(3, 63); g.player.mapUp = false; g.prompt.flash('jump', 'GET OFF THE TRAIN'); },\n    tick(g, s, st, dt) { st.left -= dt; if (st.left <= 0 || g.skipPressed()) return true; return false; },\n    end(g) { g.body.feverActive = false; g.body.fever = 0; g.body.feverNext = 1e9; g.world.sites['p2'].dormant = false; g.blackout('', null, 1.2); },\n  },\n  // ----- M1 -----\n  m1Wake: {\n    start(g, s, st) { g.body.fever = 0.8; g.body.feverActive = true; g.body.feverIgnored = -1e9; g.player.tablets = Math.max(1, g.player.tablets); st.taken = false; st.off = g.events.on('tablet', () => { st.taken = true; }); g.prompt.flash('tablet', 'TAKE THE TABLET'); st.nag = 3; g.autoWaypoint(); },\n    tick(g, s, st, dt) { st.nag -= dt; if (st.nag <= 0 && !st.taken) { st.nag = 3; g.prompt.flash('tablet', 'HOLD TO TAKE THE TABLET'); } return st.taken; },\n    end(g, s, st) { st.off?.(); },\n  },\n  m1Ambush: {\n    start(g, s, st) { st.unjam = false; st.off = g.events.on('unjam', () => { st.unjam = true; }); const gun = g.player.guns.main; if (gun) gun.scriptedJam = 5; st.target = [-200, 30]; g.world.sites.p2.dormant = false; g.world.sites.p2.cleared = false; g.world.sites.p2.clearedAt = -1e9; },\n    tick(g, s, st) {\n      const p = g.player, d = dist2(p.x, p.z, -200, 30), v = g.vehicles.list.find((o) => o.tag === 'clinic-truck');\n      if (d < 55 && v && !v.stalled && p.vehicle === v) { v.hp = 0; v.stalled = true; g.audio.at('stall', v.x, v.y, v.z, 50); g.talk.playLines('m1.stall'); }\n      if (st.unjam) return true;\n      const gun = p.guns.main; if (gun?.jammed) g.prompt.flash('reload', 'CLEAR THE JAM');\n      const cleared = g.world.sites.p2.cleared || d > 300;\n      if (d < 55 && cleared && !gun?.scriptedJam) return true;\n      if (d < 70 && !gun?.jammed && gun && !gun.scriptedJam && gun.cond === 45) gun.scriptedJam = 5;\n      return false;\n    },\n    end(g, s, st) { st.off?.(); },\n  },\n  m1Repair: {\n    start(g, s, st) { const v = g.vehicles.list.find((o) => o.tag === 'clinic-truck'); st.v = v; if (v) { if (g.player.vehicle === v) g.vehicles.exit(true); v.stalled = true; v.hp = 0; st.target = [v.x, v.z]; } },\n    tick(g, s, st) { const v = st.v; if (!v) return true; if (!v.stalled) return true; return false; },\n  },\n  m1Syrette: {\n    start(g, s, st) { st.taken = false; st.off = g.events.on('syrette', () => { st.taken = true; }); if (g.player.hp > 70) g.player.hp = 62; g.player.syrettes = Math.max(1, g.player.syrettes); g.prompt.flash('heal', 'USE A SYRETTE'); st.nag = 3; },\n    tick(g, s, st, dt) { st.nag -= dt; if (st.nag <= 0 && !st.taken) { st.nag = 3; g.prompt.flash('heal', 'HOLD TO USE A SYRETTE'); } return st.taken; },\n    end(g, s, st) { st.off?.(); },\n  },\n  // ----- M2 -----\n  freeInes: { run(g) { const site = g.world.sites['ranger-post'], door = site.cage?.object.getObjectByName('Door'); if (door) door.rotation.y = -1.9; g.audio.play('door'); g.buddies.state.ines.met = true; const a = g.buddies.spawnFollower('ines', siteById['ranger-post'].at[0] + 9, siteById['ranger-post'].at[1] + 7); a.state = 'alert'; } },\n  m2Clear: {\n    start(g, s, st) { st.target = siteById['ranger-post'].at; },\n    tick(g, s, st) { const site = g.world.sites['ranger-post']; return site.cleared || dist2(g.player.x, g.player.z, site.def.at[0], site.def.at[1]) > 140; },\n    end(g) { g.world.sites['ranger-post'].cleared = true; g.world.sites['ranger-post'].clearedAt = 1e9; },\n  },\n  // ----- M4 -----\n  plantBridge: { run(g) { const c = g.spawnCharge(120, g.world.bridgeY?.(120, 244) ?? g.world.land.heightAt(120, 244) + 0.1, 244); g.player.planted.push(c); g.missions.st.bridgePlanted = true; g.story.bridgeCharge = c; g.notice('PRESS THROW TO DETONATE'); } },\n  m4Convoy: {\n    start(g, s, st) {\n      const usesBridge = g.story.altTaken?.m4;\n      const road = usesBridge ? ROADS.back.slice().reverse() : ROADS.salt.slice(4).concat(ROADS.salt.slice(4, 5));\n      const start = road[0];\n      st.target = usesBridge ? [120, 230] : siteById['salt-pan'].at;\n      st.convoy = [];\n      const specs = [['technical', 0], ['cargo-truck', 1], ['technical', 2]];\n      for (const [type, i] of specs) { const v = g.vehicles.spawn(type, start[0] + (usesBridge ? 8 * i : -8 * i), start[1] - 4 * i, Math.atan2(road[1][0] - start[0], road[1][1] - start[1]), i === 1 ? 'payroll' : 'escort'); v.aiRoad = road; v.aiLoop = !usesBridge; v.aiSpeed = 10; v.aiS = 0; v.hostile = 'concord'; st.convoy.push(v); }\n      st.truck = st.convoy[1];\n      st.off = g.events.on('stalled', (v) => { if (v.hostile) g.spawnCrew(v); });\n    },\n    tick(g, s, st) { const t = st.truck; if (!t) return true; if (t.dead || t.stalled) { const x = t.x + 18, z = t.z - 14; g.spawnStonePickup(x, z, 'payroll-case', g.story.bridgeCharge ? 6 : 8); g.talk.say('you', 'THE CASE WENT FLYING. RAISE THE TRACKER.', 4); g.story.caseAt = [x, z]; return true; } return false; },\n    end(g, s, st) { st.off?.(); },\n  },\n  // ----- M5 -----\n  openBypass: { run(g) { g.audio.play('wrench'); g.story.bypassOpen = true; g.notice('THE CISTERN IS FILLING'); } },\n  m5Consequence: { run(g) { const alt = g.story.altTaken?.m5 && g.story.bypassOpen; if (!alt) { g.story.threeWellsEmpty = true; g.story.ledger.moved += 104; g.story.odileRefuses = true; g.people.emptyThreeWells(); g.setHutsDark(true); g.talk.playLines('m5.empty'); } } },\n  // ----- M6 -----\n  m6Partner: {\n    start(g, s, st) { g.world.setHour(23, true); st.target = [-260, -180]; const id = g.buddies.highestTrust() ?? 'pell'; st.id = id; g.story.m6Partner = id; const p = g.player; const a = g.buddies.spawnFollower(id, p.x + 3, p.z + 3); st.a = a; g.missions.st.partner = a; g.talk.say(id, id === 'pell' ? 'I am Pell. The Mother sent me. I do not know why.' : 'So we burn a farm. I have burned worse for less.', 5); },\n    tick() { return true; },\n    end(g, s, st) { g.story.m6PartnerActor = st.a; },\n  },\n  m6Burn: {\n    start(g, s, st) { st.target = [-260, -240]; st.bunker = false; st.off = g.events.on('destroyed', (d) => { if (d.tag === 'ammo-bunker') st.bunker = true; }); },\n    tick(g, s, st) { const k = fieldProgress(g); st.progress = k; return k > 0.45 || (st.bunker && k > 0.1); },\n    end(g, s, st) { st.off?.(); },\n  },\n  m6Turn: {\n    start(g, s, st) { st.t2 = 0; g.world.pinWind({ dir: [0, 1], speed: 7.5 }); g.talk.playLines('m6.turn'); const a = g.story.m6PartnerActor; if (a) a.duty = 'guard'; },\n    tick(g, s, st, dt) { st.t2 += dt; const a = g.story.m6PartnerActor; if (!a || !a.alive) return true; if (st.t2 > 4 && !a.down) { a.invulnerable = false; g.world.fire.ignite(a.x, a.z, 4); g.actors.goDown(a, { fire: true }); } return a.down || st.t2 > 8; },\n  },\n  m6Choice: {\n    start(g, s, st) { const a = g.story.m6PartnerActor; if (a) st.target = [a.x, a.z]; },\n    tick(g, s, st) { const a = g.story.m6PartnerActor; if (!a) return true; if (a.down) { st.target = [a.x, a.z]; a.downT = Math.max(a.downT, 3); } return !a.down || !a.alive; },\n    end(g) { g.story.ledger.hardLine = true; },\n  },\n  // ----- M7 -----\n  m7Note: { start(g, s, st) { st.t3 = 0; }, tick(g, s, st, dt) { st.t3 += dt; return st.t3 > 2.5; } },\n  m7Fight: {\n    start(g, s, st) {\n      g.warOn = true; st.target = [104, -322]; const at = siteById['the-cut'].at;\n      g.spawnSquad('concord', at[0] + 60, at[1] + 50, 6, 'm7'); g.spawnSquad('harvest', at[0] - 40, at[1] + 60, 6, 'm7'); g.spawnSquad('harvest', at[0] + 70, at[1] - 30, 4, 'm7');\n      g.world.fire.ignite(at[0] + 110, at[1] + 40, 8); g.world.fire.ignite(at[0] - 96, at[1] + 30, 8);\n      if (g.missions.altTaken) { const b = g.buddies.followers[0]; if (b) { b.duty = 'guard'; b.ctrl?.teleport([at[0] + 96, g.world.land.heightAt(at[0] + 96, at[1]) + 0.1, at[1]]); } g.world.fire.extinguishNear?.(at[0], at[1]); }\n      const tech = g.vehicles.spawn('technical', at[0] + 60, at[1] + 80, 3.1, 'm7-tech'); st.tech = tech;\n    },\n    tick(g, s, st) { return dist2(g.player.x, g.player.z, 104, -322) < 16; },\n  },\n  m7Consequence: { run(g) { const st = g.story; st.truceOver = true; st.act = 3; g.warOn = false; for (const id of ['tractor', 'mule', 'empire', 'weed', 'tube']) if (st.bought?.[id]) st.lockerAll = true; st.lockerAll = true; g.world.sites['mile-forty'].truceOver = true; g.vehicles.list.filter((v) => v.tag === 'm7-tech').forEach((v) => { v.tag = null; }); } },\n  // ----- M8 -----\n  m8Ride: {\n    start(g, s, st) {\n      const t = g.train; t.setAt(10, 70); t.topSpeed = 11; t.goal = t.sToward(416, -64);\n      g.setRiding(t, true); st.t4 = 0; st.spawnT = 3; g.player.setYaw(-Math.PI / 2 + Math.PI, 0); g.talk.playLines('m8.bakr');\n    },\n    tick(g, s, st, dt) { st.t4 += dt; st.spawnT -= dt; if (st.spawnT <= 0) { st.spawnT = 7; const t = g.train, q = {}; polyPoint(RAILWAY, Math.min(t.L, t.s + 70), q); g.spawnSquad(g.combat.rng.next() < 0.5 ? 'concord' : 'harvest', q.x + 18, q.z + 22, 3, 'm8'); } if (g.skipPressed()) return true; return st.t4 >= s.seconds; },\n    end(g) { g.setRiding(null); g.player.teleport(418, -68); },\n  },\n  m8End: { start(g, s, st) { st.t5 = 0; g.people.startColumn(); g.story.ledger.moved += 306; g.notice('THE COLUMN IS ON YOUR MAP'); }, tick(g, s, st, dt) { st.t5 += dt; return st.t5 > 8 || g.skipPressed(); } },\n  // ----- M9 -----\n  m9Scene: {\n    start(g, s, st) {\n      st.done = false; const site = siteById.observatory, table = [site.at[0], g.world.land.heightAt(site.at[0], site.at[1]) + 0.8, site.at[1] + 0.8];\n      g.mapTex.arc = true; g.showTableMap(table);\n      g.talk.startScene({ lines: [s.lines], camera: { position: [table[0], table[1] + 0.7, table[2] + 0.5], target: table }, onDone: () => { st.done = true; g.showTableMap(null); } });\n    },\n    tick(g, s, st) { return st.done; },\n  },\n  m9Finish: {\n    start(g, s, st) {\n      st.done = false;\n      g.talk.startScene({ speaker: 'harrow', lines: [], choices: [{ text: 'FINISH YOUR CONTRACT', fn: () => { const n = g.people.npcs.harrow; g.vm.playTool('Finish', ['tool-revolver']); g.ctx.tweens.call(1.5, () => { g.audio.play('gun-revolver'); n.view.setFull('Death', true); g.story.ledger.harrow = 'shot'; g.story.ledger.killed += 1; }); g.ctx.tweens.call(1.8, () => g.talk.playLines('m9.shot')); g.ctx.tweens.call(3.2, () => { st.done = true; }); } }, { text: 'LEAVE HIM TO THE FEVER', fn: () => { g.story.ledger.harrow = 'spared'; g.talk.playLines('m9.spared'); g.ctx.tweens.call(2.4, () => { st.done = true; }); } }] });\n    },\n    tick(g, s, st) { return st.done; },\n  },\n  m9Sheet: {\n    start(g, s, st) {\n      st.done = false;\n      g.talk.startScene({ at: [g.player.x, g.player.y + 1.3, g.player.z + 3], lines: [], choices: [{ text: 'WALK OUT WITH THE SHEET', fn: () => { g.story.ending = 'walk'; st.done = true; } }, { text: 'GIVE IT TO THE COLUMN', fn: () => { g.story.ending = 'column'; st.done = true; } }] });\n    },\n    tick(g, s, st) { return st.done; },\n    end(g) { const n = g.people.npcs.harrow; if (g.story.ledger.harrow === 'spared') n.gone = true; },\n  },\n  // ----- The Pass -----\n  endGo: {\n    start(g, s, st) { st.d = false; g.world.setWeather('clear'); g.blackout('', () => { g.world.setHour(5.4, true); g.player.teleport(-500, -420); g.player.setYaw(Math.PI / 2, 0); st.target = [-590, -430]; g.talk.playLines(g.story.ending === 'walk' ? 'end.walk' : 'end.column'); if (g.story.ending === 'column') g.people.column && (g.people.column.s = g.people.column.L - 80); st.d = true; }, 1.2); st.target = [-590, -430]; },\n    tick(g, s, st) { return st.d && dist2(g.player.x, g.player.z, -590, -430) < 60; },\n  },\n  endStand: {\n    start(g, s, st) { st.left = 40; st.wave = 1; g.hud.holdTimer = st.left; },\n    tick(g, s, st, dt) { st.left -= dt; st.wave -= dt; g.hud.holdTimer = st.left; if (st.wave <= 0) { st.wave = 12; const a = g.combat.rng.range(-0.8, 0.8); g.spawnSquad(g.combat.rng.next() < 0.5 ? 'concord' : 'harvest', -590 + Math.cos(a) * 60, -430 + Math.sin(a) * 60, 3, 'pass'); } if (st.left <= 0) { g.hud.holdTimer = null; return true; } return false; },\n  },\n  endBuddies: {\n    start(g, s, st) {\n      st.list = []; const alive = g.buddies.alive(); st.done = alive.length === 0;\n      g.warOn = false; g.actors.list.filter((a) => a.tag === 'pass').forEach((a) => { a.state = 'searching'; });\n      const spawn = () => { alive.forEach((id, i) => { const a = g.actors.spawn({ kind: 'soldier', faction: 'friends-end', role: 'rifle', tag: 'end-buddy', modelId: id, x: g.player.x + 16 + i * 4, z: g.player.z + 12 - i * 5, hp: 200, duty: 'guard' }); a.hp = 200; a.maxHp = 200; a.state = 'alert'; a.reaction = 2; st.list.push(a); g.talk.playLines(`end.${id}`); }); };\n      const high = alive.some((id) => g.buddies.state[id].trust >= 3);\n      if (high && alive.length) g.talk.startScene({ lines: ['end.split'], at: [g.player.x + 8, g.player.y + 1.4, g.player.z + 8], choices: [{ text: 'SPLIT IT', fn: () => { g.notice('THEY DRAW ANYWAY'); g.story.ledger.stones = Math.floor(g.story.ledger.stones * 0.7); spawn(); } }, { text: 'NO', fn: spawn }] });\n      else if (alive.length) spawn();\n    },\n    tick(g, s, st) { return st.done || (st.list.length > 0 && st.list.every((a) => !a.alive)); },\n    end(g, s, st) { for (const a of st.list) if (a.buddy) a.buddy = null; for (const id of g.buddies.alive()) { g.buddies.state[id].alive = false; g.story.ledger.friends++; } },\n  },\n  endLight: {\n    start(g, s, st) { st.used = false; const u = { x: g.player.x + 2, z: g.player.z + 2, y: g.player.y + 0.5, label: 'LIGHT THE GRASS', r: 200, anyAngle: true, hold: 1, fn: () => { st.used = true; g.world.fire.ignite(g.player.x + 6, g.player.z + 6, 6); g.audio.play('lighter'); g.world.pinWind({ dir: [1, 0.3], speed: 6 }); } }; g.prompt.missionUse.push(u); },\n    tick(g, s, st, dt) { if (st.used) { st.after = (st.after ?? 0) + dt; return st.after > 9; } return false; },\n  },\n  endFinish: { run(g) { g.finishGame(); } },\n};\nexport { LINES, TUNING, cellX, cellZ };\nEOF\nsed -i \"s/^import { BURNING, BURNT, cellX, cellZ, FIRE_N } from/import { BURNING, BURNT, cellX, cellZ, FIRE_N } from/\" src/missions/scripts.js\necho ok; cat >> ../PROGRESS.md <<'EOF'\nWritten (untested): src/world/world.js, actors/{rig,soldier,player,buddy,civilian}.js, combat/{projectiles,viewmodel,weapons}.js, body/health.js, vehicles/vehicle.js, ui/{dialogue,prompts}.js, missions/{runner,scripts,ledger}.js, content/{weapons,dialogue,missions}.js.\nRemaining: world/map-texture.js, core/save.js, ui/{hud,glyphs,menu,screens,pixfont,about}.js, dev, attract, audio, net, game.js, main.js, tests, DESIGNERS.md.\nEOF","description":"Write buddies, civilians, dialogue, prompts, mission runner and scripts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14398,"cache_read_input_tokens":396842,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14398},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"3011055a-b889-4c5a-9fbf-ea1935116bfa","timestamp":"2026-11-05T23:53:47.965Z","request_id":"req_011CgkgBGobXTefz2UP1DF1E","wire_tool_inputs":{"toolu_01BqDTDa1Nhg39g6oZLd69qx":{"command":"cat > src/actors/buddy.js <<'EOF'\n// Three hired friends. They rescue you, offer better plans and die for real (section 12).\nimport { TUNING } from '../core/tuning.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { dist2 } from '../world/geom.js';\nconst DEFS = { ines: { model: 'ines', rescueLine: 'rescue.ines', hp: 40, range: 500 }, dov: { model: 'dov', rescueLine: 'rescue.dov', hp: 40, range: 260 }, mags: { model: 'mags', rescueLine: 'rescue.mags', hp: 60, range: 260 }, pell: { model: 'soldier-cloth', hp: 40, range: 0 } };\nexport const fresh = () => ({ ines: { met: false, alive: true, trust: 1, spentUntil: -1, gun: 'tractor' }, dov: { met: false, alive: true, trust: 1, spentUntil: -1, gun: 'mule' }, mags: { met: false, alive: true, trust: 1, spentUntil: -1, gun: 'm38' } });\nexport class Buddies {\n  state = fresh(); followers = []; down = null; finishT = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('buddies'); }\n  reset() { this.state = fresh(); this.clear(); }\n  clear() { for (const a of this.followers) this.game.actors.remove(a); this.followers.length = 0; this.down = null; }\n  ready(id) { const s = this.state[id]; return s && s.met && s.alive && s.spentUntil <= this.game.world.totalHours; }\n  alive() { return Object.keys(this.state).filter((k) => this.state[k].met && this.state[k].alive); }\n  available() { return this.alive().filter((k) => this.ready(k)).length > 0; }\n  /** The friend who comes for you. Ines drives from further away. */\n  rescuer() { const list = this.alive().filter((k) => this.ready(k)); if (!list.length) return null; return list.sort((a, b) => this.state[b].trust - this.state[a].trust)[0]; }\n  highestTrust() { const list = this.alive(); return list.length ? list.sort((a, b) => this.state[b].trust - this.state[a].trust)[0] : null; }\n  spawnFollower(id, x, z, o = {}) {\n    const g = this.game, def = DEFS[id];\n    const a = g.actors.spawn({ kind: 'buddy', faction: 'friend', friendly: true, buddy: id, modelId: def.model, palette: id === 'pell' ? { cloth: 'orange', dark: 'plum', hat: 'red', strap: 'sand', skin: 'plum' } : undefined, role: 'rifle', duty: o.duty ?? 'follow', x, z, hp: 200 });\n    a.hp = 200; a.maxHp = 200; a.fireproof = true;\n    this.followers.push(a);\n    return a;\n  }\n  addTrust(id, n = 1) { const s = this.state[id]; if (s) s.trust += n; }\n  /** A friend at zero: forty seconds and a choice. */\n  onDown(a, o) {\n    const g = this.game;\n    this.down = { a, fire: !!o.fire };\n    g.talk.say(a.buddy === 'pell' ? 'pell' : a.buddy, o.fire ? \"Don't let it be the fire. Please. Not the fire.\" : 'Get over here. Get over here.', 5);\n    g.audio.voiceAt(g.talk.voiceOf(a.buddy), 'Please. Not like this.', a, a.id);\n    g.events.emit('buddyDown', a);\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player, input = this.ctx.input;\n    this.finishT = Math.max(0, this.finishT - dt);\n    // Followers stay close.\n    for (const a of this.followers) if (a.alive && !a.down && a.duty === 'follow' && dist2(a.x, a.z, p.x, p.z) > 160) { a.ctrl?.teleport([p.x + 4, g.world.land.heightAt(p.x + 4, p.z + 4) + 0.1, p.z + 4]); }\n    const d = this.down; if (!d) return;\n    if (!d.a.alive) { this.lost(d.a, 'bled'); return; }\n    if (d.a.hp > 0 && !d.a.down) { this.down = null; return; }\n    if (p.vehicle || dist2(d.a.x, d.a.z, p.x, p.z) > 2.8) { g.prompt.setChoice(null); return; }\n    g.prompt.setChoice({ use: p.syrettes > 0 ? 'SYRETTE' : null, finish: 'FINISH IT' });\n    if (p.syrettes > 0 && pressedFixed(input, 'use')) { p.syrettes--; d.a.hp = 100; d.a.down = false; d.a.view?.setFull('Idle'); this.ctx.tweens.call(0.1, () => d.a.view?.stopFull()); g.audio.play('syrette'); this.addTrust(d.a.buddy, 1); this.down = null; g.prompt.setChoice(null); g.hud.touch(); g.vm.playTool('Syrette', ['tool-syrette']); g.events.emit('buddySaved', d.a); return; }\n    if (pressedFixed(input, 'finish') && !this.finishT) {\n      this.finishT = 3; g.prompt.setChoice(null); const a = d.a; this.down = null;\n      g.vm.playTool('Finish', ['tool-revolver']); g.frozen = true;\n      this.ctx.tweens.call(1.55, () => { g.audio.play('gun-revolver'); this.ctx.lights.request({ position: [a.x, a.y + 1, a.z], color: 0xffd090, intensity: 14, radius: 10, lifetime: 0.08 }); a.down = false; g.actors.kill(a, { silent: true, finished: true }); this.lost(a, 'finished'); });\n      this.ctx.tweens.call(2.4, () => { g.frozen = false; });\n    }\n  }\n  lost(a, how) {\n    const g = this.game, id = a.buddy;\n    this.down = null; g.prompt.setChoice(null);\n    const i = this.followers.indexOf(a); if (i >= 0) this.followers.splice(i, 1);\n    if (this.state[id]) { this.state[id].alive = false; (g.story.wall ??= []).push(id); }\n    if (id !== 'pell') g.story.ledger.friends++;\n    g.talk.say('you', how === 'finished' ? 'ONE SHOT.' : 'YOU WERE TOO LATE.', 4);\n    g.events.emit('buddyDead', a, how);\n    g.hud.touch();\n  }\n  /** Dragged backward, low, while they swear at you. */\n  rescue(id) {\n    const g = this.game, p = g.player, def = DEFS[id], s = this.state[id];\n    p.downT = 6.5; p.hp = 1; g.combat.stopStream(); if (p.vehicle) g.vehicles.exit(true);\n    s.spentUntil = g.world.totalHours + 24;\n    if (this.rng.next() < TUNING.buddyWoundChance) { s.spentUntil = g.world.totalHours + 48; g.story.woundNote = id; }\n    this.addTrust(id, 0);\n    let a = this.followers.find((f) => f.buddy === id && f.alive);\n    if (!a) a = this.spawnFollower(id, p.x + 1.4, p.z - 1.2, { duty: 'guard' });\n    a.invulnerable = true; a.dragging = true; a.view?.setFull('DragBackward');\n    const yaw = this.ctx.camera.yaw, dirx = Math.sin(yaw), dirz = Math.cos(yaw);\n    let t = 0;\n    const tick = g.events.on('fixed', (dt) => {\n      t += dt;\n      p.x += dirx * dt * 1.2; p.z += dirz * dt * 1.2; p.ctrl.teleport([p.x, g.world.land.heightAt(p.x, p.z) + 0.05, p.z]);\n      if (a.ctrl) a.ctrl.teleport([p.x + dirx * 1.2, g.world.land.heightAt(p.x, p.z) + 0.05, p.z + dirz * 1.2]); a.x = p.x + dirx * 1.2; a.z = p.z + dirz * 1.2; a.y = g.world.land.heightAt(a.x, a.z); a.yaw = yaw;\n      const eyeY = p.y + 0.42, wob = Math.sin(t * 7) * 0.05;\n      g.cam.override = { position: [p.x, eyeY + wob, p.z], target: [a.x, a.y + 1.1 + Math.sin(t * 2) * 0.2, a.z] };\n      if (t > 6.2) {\n        tick(); g.cam.override = null; p.downT = 0; p.hp = def.hp; a.invulnerable = false; a.dragging = false; a.view?.stopFull(); a.duty = 'follow'; g.frozen = false; g.body.regenT = 0; g.hud.touch();\n        if (g.story.woundNote === id) { g.talk.say(id, 'I took one for that. Two days. You owe me.', 5); g.story.woundNote = null; }\n        g.events.emit('rescued', id);\n        this.ctx.tweens.call(25, () => { if (a.alive && !a.down && !g.missions.active && this.followers.includes(a)) { const k = this.followers.indexOf(a); this.followers.splice(k, 1); g.actors.remove(a); } });\n      }\n    });\n    g.talk.playLines(def.rescueLine);\n    g.events.emit('rescueStart', id);\n    g.story.rescues = (g.story.rescues ?? 0) + 1;\n    void held;\n  }\n}\nEOF\ncat > src/actors/civilian.js <<'EOF'\n// People who live here, and people who used to. Civilians can't be shot: they flee, and the Ledger counts them.\nimport { CIV_PALETTES } from '../art/models.js';\nimport { STRIPS } from '../content/roads.js';\nimport { siteById, SITES } from '../content/sites.js';\nimport { dist2, polyLength, polyPoint } from '../world/geom.js';\nimport { PersonView } from './rig.js';\nconst NPC_CLIP = { odile: 'SmokeIdle', tibor: 'Shrug', vance: 'CleanRifleIdle', ansa: 'TeachPoint', harrow: 'WriteAtDesk', bakr: 'Idle', ines: 'Idle', dov: 'Idle', mags: 'Idle' };\nexport class People {\n  npcs = {}; civs = []; column = null; refugees = [];\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.ctx = ctx; this.rng = ctx.random.fork('people');\n    for (const def of SITES) for (const [id, dx, dz, yaw] of def.npcs ?? []) {\n      const x = def.at[0] + dx, z = def.at[1] + dz, y = this.game.world.land.heightAt(x, z);\n      const view = new PersonView(ctx, id, undefined, { gun: false });\n      view.place(x, y, z, (yaw * Math.PI) / 180); view.setFull(NPC_CLIP[id]);\n      this.npcs[id] = { id, view, x, y, z, yaw: (yaw * Math.PI) / 180, site: def.id };\n    }\n    // Friends wait at Mile Forty's bar once you've met them.\n    for (const [id, dx, dz] of [['ines', -25, 13], ['dov', -20, 18], ['mags', -19, -38]]) {\n      const x = dx, z = 40 + dz, y = this.game.world.land.heightAt(x, z), view = new PersonView(ctx, id, undefined, { gun: false });\n      view.place(x, y, z, 2.6); view.setFull('Idle'); view.object.visible = false;\n      this.npcs[id] = { id, view, x, y, z, yaw: 2.6, site: 'mile-forty', hidden: true };\n    }\n    for (const def of SITES) if (def.civilians) for (let i = 0; i < def.civilians; i++) this.spawnCiv(def, i);\n  }\n  spawnCiv(def, i) {\n    const a = this.rng.range(0, 6.28), r = this.rng.range(6, def.r * 0.45), x = def.at[0] + Math.cos(a) * r, z = def.at[1] + Math.sin(a) * r;\n    const view = new PersonView(this.ctx, 'civilian', CIV_PALETTES[i % 4], { gun: false });\n    view.setLower('Idle'); view.setUpper('Idle');\n    const c = { def, view, x, z, y: this.game.world.land.heightAt(x, z), yaw: a, gx: x, gz: z, wait: this.rng.range(0, 5), flee: 0, sp: 0 };\n    this.civs.push(c);\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player;\n    for (const c of this.civs) {\n      const near = dist2(c.x, c.z, p.x, p.z) < 200;\n      if (!near) continue;\n      if (c.flee > 0) c.flee -= dt;\n      if (c.flee <= 0 && g.world.time - (g.lastShotT ?? -99) < 2 && dist2(c.x, c.z, p.x, p.z) < 60 && !g.world.sites[c.def.id].calm) { c.flee = 6; const a = Math.atan2(c.z - p.z, c.x - p.x) + this.rng.range(-0.8, 0.8); c.gx = c.def.at[0] + Math.cos(a) * c.def.r * 0.7; c.gz = c.def.at[1] + Math.sin(a) * c.def.r * 0.7; }\n      if (g.world.fire.isBurning(c.x + g.world.wind.x * 8, c.z + g.world.wind.z * 8)) { c.flee = 6; c.gx = c.x - g.world.wind.x * 30; c.gz = c.z - g.world.wind.z * 30; }\n      const dx = c.gx - c.x, dz = c.gz - c.z, l = Math.hypot(dx, dz);\n      if (l < 0.6) { c.sp = 0; c.wait -= dt; if (c.wait <= 0) { c.wait = this.rng.range(3, 9); const a = this.rng.range(0, 6.28), r = this.rng.range(4, c.def.r * 0.5); c.gx = c.def.at[0] + Math.cos(a) * r; c.gz = c.def.at[1] + Math.sin(a) * r; } }\n      else { const sp = c.flee > 0 ? 4.2 : 1.2; c.sp = sp; c.x += (dx / l) * sp * dt; c.z += (dz / l) * sp * dt; c.yaw = Math.atan2(dx, dz); c.y = g.world.land.heightAt(c.x, c.z); }\n    }\n    if (this.column) {\n      const col = this.column; col.s += dt * 1.1;\n      for (const w of col.walkers) { const q = polyPoint(col.path, Math.max(0, Math.min(col.L, col.s + w.off))); w.x = q.x + w.side; w.z = q.z; w.yaw = q.yaw; }\n    }\n    for (const r of this.refugees) { const q = polyPoint(r.path, Math.min(r.L, (r.s += dt * 1.1))); r.x = q.x + r.side; r.z = q.z + r.side * 0.5; r.yaw = q.yaw; }\n  }\n  /** Three Wells empties. */\n  emptyThreeWells() {\n    const def = siteById['three-wells'], keep = [];\n    for (const c of this.civs) if (c.def === def) { c.view.dispose(); } else keep.push(c);\n    this.civs = keep;\n    const path = [def.at, [-200, 30], [-100, 35], [-20, 15]], L = polyLength(path);\n    for (let i = 0; i < 14; i++) { const view = new PersonView(this.ctx, 'civilian', CIV_PALETTES[i % 4], { gun: false }); view.setLower('Walk', 0.5); view.setUpper('Idle'); this.refugees.push({ view, path, L, s: -i * 3, side: (i % 3) - 1, x: def.at[0], z: def.at[1], yaw: 0 }); }\n  }\n  /** The column walks the scar. */\n  startColumn() {\n    if (this.column) return;\n    const arc = [...STRIPS.A.points, ...STRIPS.C.points.slice(1), ...STRIPS.B.points.slice(1), [-590, -430]], L = polyLength(arc), walkers = [];\n    for (let i = 0; i < 18; i++) { const view = new PersonView(this.ctx, 'civilian', CIV_PALETTES[i % 4], { gun: false }); view.setLower('Walk', 0.5); view.setUpper('Idle'); walkers.push({ view, off: -i * 3.5, side: ((i * 7) % 5) - 2, x: arc[0][0], z: arc[0][1], yaw: 0 }); }\n    this.column = { path: arc, L, s: 60, walkers };\n  }\n  clearDynamic() {\n    if (this.column) { for (const w of this.column.walkers) w.view.dispose(); this.column = null; }\n    for (const r of this.refugees) r.view.dispose(); this.refugees = [];\n    if (!this.civs.some((c) => c.def.id === 'three-wells')) for (let i = 0; i < siteById['three-wells'].civilians; i++) this.spawnCiv(siteById['three-wells'], i);\n  }\n  showFriends() { const st = this.game.buddies.state; for (const id of ['ines', 'dov', 'mags']) { const n = this.npcs[id]; n.hidden = !(st[id].met && st[id].alive) || this.game.buddies.followers.some((f) => f.buddy === id); } }\n  update(dt) {\n    const g = this.game, cx = g.camX ?? 0, cz = g.camZ ?? 0;\n    for (const n of Object.values(this.npcs)) { const near = dist2(n.x, n.z, cx, cz) < 200 && !n.hidden && !n.gone; n.view.object.visible = near; if (near) { n.view.place(n.x, n.y, n.z, n.yaw); n.view.update(dt); } }\n    for (const c of this.civs) { const near = dist2(c.x, c.z, cx, cz) < 170; c.view.object.visible = near; if (!near) continue; c.view.place(c.x, c.y, c.z, c.yaw); c.view.setLower(c.sp > 2 ? 'Run' : c.sp > 0 ? 'Walk' : 'Idle', c.sp > 2 ? 1 : 0.6); c.view.update(dt); }\n    const walkers = [...(this.column?.walkers ?? []), ...this.refugees];\n    for (const w of walkers) { const near = dist2(w.x, w.z, cx, cz) < 300; w.view.object.visible = near; if (near) { w.view.place(w.x, g.world.land.heightAt(w.x, w.z), w.z, w.yaw); w.view.update(dt); } }\n  }\n}\nEOF\ncat > src/ui/dialogue.js <<'EOF'\n// Subtitles, voices and the short first-person scenes: the camera holds on the speaker, two buttons at most.\nimport { LINES, SPEAKERS } from '../content/dialogue.js';\nimport { pressed } from '../core/actions.js';\nexport class Talk {\n  queue = []; current = null; scene = null; barkText = null; barkT = 0;\n  constructor(game) { this.game = game; }\n  voiceOf(id) { return SPEAKERS[id]?.voice ?? 'soldier'; }\n  say(who, text, secs) { const t = text.toUpperCase(); const line = { who, text: t, secs: secs ?? Math.max(1.6, t.length * 0.062) }; if (this.current?.text === t || this.queue.some((l) => l.text === t)) return; this.queue.push(line); }\n  linesOf(id) { const l = LINES[id]; return l ?? []; }\n  /** Play a named set of lines as subtitles, no lock. */\n  playLines(id, speaker) { for (const [who, text] of this.linesOf(id)) this.say(speaker ?? who, text); }\n  bark(name, text) { this.barkText = `${name}: ${text.toUpperCase()}`; this.barkT = 2.4; }\n  clear() { this.queue.length = 0; this.current = null; this.scene = null; this.barkText = null; }\n  locksPlayer() { return !!this.scene; }\n  /** A scene: the camera holds on `at` (a speaker's head), lines play, optional choices end it. */\n  startScene({ lines = [], speaker, at, camera, choices, onDone, skippable = true }) {\n    const g = this.game, npc = speaker ? g.people.npcs[speaker] : null;\n    const focus = at ?? (npc ? [npc.x, npc.y + 1.55, npc.z] : null);\n    const items = lines.flatMap((id) => (typeof id === 'string' ? this.linesOf(id) : [id]));\n    this.scene = { items, i: -1, t: 0, focus, camera, choices, onDone, skippable, choosing: false, focusI: 0, npc };\n    if (focus && !camera) {\n      const p = g.player, e = p.eyeNow().clone(); const dx = focus[0] - e.x, dz = focus[2] - e.z, l = Math.hypot(dx, dz) || 1;\n      const dist = Math.min(l, 1.8); this.scene.camera = { position: [focus[0] - (dx / l) * dist, focus[1] + 0.02, focus[2] - (dz / l) * dist], target: focus };\n    }\n    if (this.scene.camera) g.cam.override = this.scene.camera;\n    this.queue.length = 0; this.current = null;\n    if (npc) { const k = Math.atan2(g.player.x - npc.x, g.player.z - npc.z); npc.turned = npc.yaw; npc.yaw = k; }\n    this.nextLine();\n  }\n  nextLine() {\n    const s = this.scene; if (!s) return;\n    s.i++; s.t = 0;\n    if (s.i >= s.items.length) {\n      if (s.choices) { s.choosing = true; this.current = null; return; }\n      this.endScene(); return;\n    }\n    const [who, text] = s.items[s.i], tx = text.toUpperCase();\n    s.dur = Math.max(1.8, tx.length * 0.07);\n    this.current = { who, text: tx, secs: 1e9 };\n    this.game.audio.voice(this.voiceOf(who), tx);\n  }\n  endScene(choice) {\n    const s = this.scene, g = this.game; this.scene = null; this.current = null;\n    if (s.camera) g.cam.override = null;\n    if (s.npc && s.npc.turned !== undefined) { s.npc.yaw = s.npc.turned; }\n    s.onDone?.(choice);\n  }\n  /** In update(): menus and scenes live here, with dt that may be zero. */\n  update(dt, realDt) {\n    const g = this.game, input = g.ctx.input;\n    if (this.barkT > 0) this.barkT -= realDt;\n    const s = this.scene;\n    if (s) {\n      if (s.choosing) {\n        const n = s.choices.length;\n        if (pressed(input, 'left') || pressed(input, 'up')) { s.focusI = (s.focusI + n - 1) % n; g.audio.play('ui-move'); }\n        if (pressed(input, 'right') || pressed(input, 'down')) { s.focusI = (s.focusI + 1) % n; g.audio.play('ui-move'); }\n        const hit = g.hud.choiceHit(s, n);\n        if (hit !== null) s.focusI = hit;\n        if (pressed(input, 'confirm') || g.hud.clicked(s, n)) { g.audio.play('ui-confirm'); const c = s.choices[s.focusI]; this.endScene(c); c.fn?.(); }\n        return;\n      }\n      s.t += realDt;\n      if (s.t >= s.dur || (s.skippable && s.t > 0.15 && pressed(input, 'confirm'))) this.nextLine();\n      return;\n    }\n    if (this.current) { this.current.secs -= realDt; if (this.current.secs <= 0) this.current = null; }\n    if (!this.current && this.queue.length) { this.current = this.queue.shift(); const v = this.voiceOf(this.current.who); if (v !== 'none') g.audio.voice(v, this.current.text); }\n  }\n  subtitle() { return this.current ? { who: SPEAKERS[this.current.who]?.name ?? '', color: SPEAKERS[this.current.who]?.color ?? 'white', text: this.current.text } : null; }\n}\nEOF\ncat > src/ui/prompts.js <<'EOF'\n// One usable thing at a time: glyph plus verb, sometimes a ring that fills.\nimport { held, pressedFixed } from '../core/actions.js';\nimport { CASES as _C, siteById, TRIGS } from '../content/sites.js';\nimport { HALTS } from '../content/roads.js';\nimport { NOTES, NOTE_REWARD } from '../content/dialogue.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { angleDiff, dist2 } from '../world/geom.js';\nexport class Prompt {\n  current = null; holdT = 0; flashT = 0; flashText = null; flashAction = null; choice = null; extra = []; scanClock = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.pickups = []; this.missionUse = []; }\n  has() { return !!this.current; }\n  jumpBlocked() { return false; }\n  chargePreferred() { return this.game.missions.wantsCharge?.() ?? false; }\n  setChoice(c) { this.choice = c; }\n  flash(action, text) { this.flashAction = action; this.flashText = text; this.flashT = 1.6; }\n  addPickup(p) { this.pickups.push(p); return p; }\n  removePickup(p) { const i = this.pickups.indexOf(p); if (i >= 0) this.pickups.splice(i, 1); if (p.object) this.ctx.scene.remove(p.object); }\n  clearDynamic() { for (const p of [...this.pickups]) this.removePickup(p); this.missionUse.length = 0; this.current = null; }\n  /** All things near enough to use. */\n  candidates() {\n    const g = this.game, p = g.player, out = [], px = p.x, pz = p.z;\n    const near = (x, z, r = 2.5) => Math.abs(x - px) < r && Math.abs(z - pz) < r && dist2(x, z, px, pz) < r;\n    const add = (o) => out.push(o);\n    if (p.vehicle) { // Only what a driver can do.\n      for (const u of this.missionUse) if (u.driveIn && near(u.x, u.z, 8)) add(u);\n      if (!p.mounted) add({ x: p.vehicle.x, z: p.vehicle.z, y: p.y + 1, label: 'GET OUT', silent: true, action: 'exit', passive: true });\n      return out;\n    }\n    for (const u of this.missionUse) if (near(u.x, u.z, u.r ?? 2.5)) add(u);\n    for (const q of this.pickups) if (near(q.x, q.z, 2.5)) add({ ...q, fn: () => q.use() });\n    for (const v of g.vehicles.list) {\n      if (v.dead || !near(v.x, v.z, 5.5)) continue;\n      const [bx, bz] = v.bonnet(), [dx, dz] = v.door();\n      if (v.hp < 50 && !v.dead && near(bx, bz, 2)) add({ x: bx, z: bz, y: v.y + 0.6, label: 'OPEN THE BONNET', hold: p.upgrades.vehicle ? 1.5 : 3, fn: () => g.repair(v), holdClip: 'wrench', vehicle: v });\n      if (near(dx, dz, 2.2) && !v.aiRoad && !v.stalled) add({ x: dx, z: dz, y: v.y + 1, label: 'GET IN', fn: () => g.vehicles.enter(v) });\n      else if (near(dx, dz, 2.2) && v.stalled && v.hp > 0) add({ x: dx, z: dz, y: v.y + 1, label: 'GET IN', fn: () => g.vehicles.enter(v) });\n    }\n    for (const s of Object.values(g.world.sites)) {\n      if (!s.def.usables || dist2(s.def.at[0], s.def.at[1], px, pz) > s.def.r + 8) continue;\n      for (const u of s.def.usables) {\n        const x = s.def.at[0] + u.at[0], z = s.def.at[1] + u.at[1];\n        if (!near(x, z, 3)) continue;\n        if (u.needs === 'cleared' && !s.cleared && !g.story.flags[s.id]) continue;\n        const o = g.usableFor(u, s); if (o) add({ x, z, y: g.world.land.heightAt(x, z) + 1, ...o });\n      }\n    }\n    for (const n of Object.values(g.people.npcs)) { if (n.hidden || n.gone || !near(n.x, n.z, 2.8)) continue; const o = g.talkTo(n.id); if (o) add({ x: n.x, z: n.z, y: n.y + 1.5, ...o }); }\n    for (const c of g.world.cases) if (!c.taken && near(c.at[0], c.at[1], 2.6)) add({ x: c.at[0], z: c.at[1], y: g.world.land.heightAt(c.at[0], c.at[1]) + 0.3, label: 'TAKE THE CASE', fn: () => g.takeCase(c) });\n    for (const t of TRIGS) if (near(t.at[0], t.at[1], 3)) { if (!g.story.trigs?.[t.id]) add({ x: t.at[0], z: t.at[1], y: t.y + 1.2, label: 'SIGHT THE PILLAR', hold: 1, fn: () => g.useTrig(t) }); }\n    for (const h of HALTS) if (near(h.at[0], h.at[1], 4)) add({ x: h.at[0], z: h.at[1], y: g.world.land.heightAt(h.at[0], h.at[1]) + 1, label: g.story.halts?.[h.id] ? 'RIDE THE GOODS LINE' : 'MARK THIS HALT', fn: () => g.useHalt(h) });\n    return out;\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player, input = this.ctx.input;\n    this.flashT = Math.max(0, this.flashT - dt);\n    if (g.ui.top || p.mapUp || !p.canAct()) { this.current = null; this.holdT = 0; return; }\n    this.scanClock -= dt;\n    if (this.scanClock <= 0) {\n      this.scanClock = 0.1;\n      const yaw = this.ctx.camera.yaw;\n      let best = null, bs = 1e9;\n      for (const c of this.candidates()) {\n        if (c.passive) { if (!best) { best = c; bs = 1e8; } continue; }\n        const a = Math.atan2(-(c.x - p.x), -(c.z - p.z)), off = Math.abs(angleDiff(a, yaw)), d = dist2(c.x, c.z, p.x, p.z);\n        if (off > (40 * Math.PI) / 180 && d > 1.1 && !c.anyAngle) continue;\n        const score = off * 2 + d * 0.3;\n        if (score < bs) { bs = score; best = c; }\n      }\n      this.current = best;\n    }\n    const c = this.current;\n    if (!c || c.passive) { this.holdT = 0; return; }\n    if (c.hold) {\n      if (held(input, 'use')) {\n        if (this.holdT === 0 && c.holdClip === 'wrench') { g.vm.playTool('Wrench', ['tool-wrench'], { loop: true }); this.toolLoop = true; }\n        this.holdT += dt;\n        if (c.holdClip === 'wrench' && g.world.stepCount % 20 === 0) { this.ctx.particles.burst('sparks', [c.x, c.y, c.z], { count: 4 }); g.audio.play('wrench'); }\n        if (this.holdT >= c.hold) { this.holdT = 0; if (this.toolLoop) { g.vm.endTool(); this.toolLoop = false; } input.clearQueued('PadSquare', 'KeyE'); c.fn(); this.current = null; }\n      } else { if (this.holdT > 0 && this.toolLoop) { g.vm.endTool(); this.toolLoop = false; } this.holdT = 0; input.clearQueued('PadSquare', 'KeyE'); }\n    } else if (pressedFixed(input, 'use')) { c.fn(); this.current = null; g.audio.play('ui-confirm', { volume: 0.4 }); }\n  }\n}\nexport { _C, siteById, NOTES, NOTE_REWARD, WEAPONS };\nEOF\ncat > src/missions/ledger.js <<'EOF'\nexport const freshLedger = () => ({ moved: 0, killed: 0, friends: 0, stones: 0, hectares: 0, harrow: null });\nEOF\ncat > src/missions/runner.js <<'EOF'\n// The mission runner. Steps are data; the runner gives each type its meaning. Bots drive these same steps.\nimport { missionById, MISSIONS } from '../content/missions.js';\nimport { siteById } from '../content/sites.js';\nimport { TUNING } from '../core/tuning.js';\nimport { dist2 } from '../world/geom.js';\nimport { SCRIPTS } from './scripts.js';\nexport class Missions {\n  active = null; stepI = 0; steps = []; st = {}; altPending = null; altT = 0; textT = 0; textStr = '';\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('missions'); const g = this.game; g.events.on('destroyed', (d) => this.onDestroyed(d)); g.events.on('actorDied', (a, o) => { if (a.tag) this.st.killed = (this.st.killed ?? 0) + 1; void o; }); }\n  done(id) { return !!this.game.story.done[id]; }\n  /** The next contract this giver has for you. */\n  availableFor(giver) { if (this.active) return null; return MISSIONS.find((m) => m.giver === giver && !this.done(m.id) && !m.auto && m.requires.every((r) => this.done(r))) ?? null; }\n  available() { if (this.active) return []; return MISSIONS.filter((m) => !this.done(m.id) && !m.auto && m.requires.every((r) => this.done(r))); }\n  start(id) {\n    const m = missionById[id], g = this.game;\n    this.active = m; this.stepI = 0; this.st = {}; this.altTaken = false; this.altPending = null;\n    this.steps = [...m.steps];\n    g.story.current = id;\n    if (m.act) g.story.act = m.act;\n    if (m.hour !== undefined && (m.forceHour || m.auto)) g.world.setHour(m.hour, true);\n    if (m.weather) g.world.setWeather(m.weather);\n    g.world.pinWind(m.wind);\n    g.story.pass = m.pass ?? null;\n    if (m.give?.flare && !g.player.guns.sidearm?.id?.includes('flare')) { g.story.hasFlare = true; g.combat.give('flare', 100, false); g.player.flareAmmo = 8; }\n    if (m.give?.tracker) { g.story.hasTracker = true; g.talk.say('you', 'THE TRACKER IS IN YOUR LEFT POCKET.', 3); }\n    if (m.spawnAt) g.player.teleport(m.spawnAt[0], m.spawnAt[1]);\n    if (m.alt && this.altEligible(m)) { this.altPending = m.alt; this.altT = 6; }\n    g.events.emit('missionStart', m);\n    this.beginStep();\n  }\n  altEligible(m) { const b = this.game.buddies, id = m.alt.buddy; if (id === 'any') return b.alive().length > 0; if (m.alt.always) return b.state[id].alive; return b.state[id].met && b.state[id].alive; }\n  acceptAlt() {\n    const a = this.altPending, m = this.active, g = this.game; if (!a) return;\n    this.altPending = null; this.altTaken = true; g.prompt.setChoice(null);\n    const steps = this.steps.slice(), at = this.stepI;\n    steps.splice(at, 0, ...a.steps); this.steps = steps;\n    let buddy = a.buddy === 'any' ? g.buddies.highestTrust() : a.buddy;\n    g.story.altTaken = g.story.altTaken ?? {}; g.story.altTaken[m.id] = true;\n    if (a.buddy === 'dov') g.buddies.state.dov.met = true;\n    g.buddies.addTrust(buddy, 1);\n    if (!g.buddies.followers.some((f) => f.buddy === buddy && f.alive)) g.buddies.spawnFollower(buddy, g.player.x + 3, g.player.z + 3);\n    g.audio.play('radio');\n    g.events.emit('altAccepted', m);\n    this.beginStep();\n  }\n  ignoreAlt() { this.altPending = null; this.game.prompt.setChoice(null); }\n  get step() { return this.steps[this.stepI] ?? null; }\n  beginStep() {\n    const g = this.game, s = this.step; this.st.t = 0; this.st.killed = 0; this.st.done = false; this.st.deliverT = 0;\n    if (!s) return;\n    this.textStr = s.text; this.textT = 5;\n    g.hud.touch(); g.audio.play('map-paper', { volume: 0.2 });\n    if (s.spawn) this.spawnFor(s.spawn);\n    if (s.do === 'destroy') { this.st.destroyed = g.world.destructibles.filter((d) => d.tag === s.tag && d.destroyed && (!s.site || d.site === s.site)).length; if (s.givesCharges) { g.player.charges = Math.max(g.player.charges, s.givesCharges); g.talk.say('you', 'THE COLONEL SENT CHARGES. HOLD THROW TO PLANT.', 4); } }\n    if (s.do === 'use') this.addUse(s);\n    if (s.do === 'hold') { this.st.left = s.seconds; this.st.waveT = 2; }\n    if (s.do === 'ride' || s.do === 'script' || s.do === 'choice') { const sc = SCRIPTS[s.script]; if (sc?.start) sc.start(g, s, this.st); }\n    if (s.lines && s.do !== 'talk' && s.do !== 'report' && s.do !== 'use' && s.do !== 'deliver') g.talk.playLines(s.lines);\n    g.autoWaypoint();\n    g.events.emit('stepStart', s);\n  }\n  addUse(s) {\n    const g = this.game; let x, z;\n    if (s.at.length === 3) { const site = siteById[s.at[2]]; x = site.at[0] + s.at[0]; z = site.at[1] + s.at[1]; } else { x = s.at[0]; z = s.at[1]; }\n    const u = { x, z, y: g.world.land.heightAt(x, z) + 1, label: s.label, hold: s.hold ?? 0, r: 3.2, anyAngle: true, tag: s.tag, fn: () => { g.prompt.missionUse = g.prompt.missionUse.filter((o) => o !== u); if (s.onDone) SCRIPTS[s.onDone]?.run?.(g, s); this.st.used = true; } };\n    g.prompt.missionUse.push(u);\n  }\n  spawnFor(sp) {\n    const g = this.game;\n    if (sp.vehicle) { if (!g.vehicles.list.some((v) => v.tag === sp.tag)) g.vehicles.spawn(sp.vehicle, sp.at[0], sp.at[1], (sp.yaw * Math.PI) / 180, sp.tag); }\n    if (sp.pickup === 'gun') g.spawnGunPickup(sp.gun, sp.cond, sp.at[0], sp.at[1], sp.tag);\n  }\n  /** Where the current step wants you. */\n  target() {\n    const s = this.step; if (!s) return null;\n    const g = this.game;\n    if (s.at && s.at.length === 3) { const site = siteById[s.at[2]]; return [site.at[0] + s.at[0], site.at[1] + s.at[1]]; }\n    if (s.at) return s.at;\n    if (s.to && g.people.npcs[s.to]) return [g.people.npcs[s.to].x, g.people.npcs[s.to].z];\n    if (s.site) return siteById[s.site].at;\n    if (s.do === 'steal') { const v = g.vehicles.list.find((o) => o.tag === s.tag); if (v) return [v.x, v.z]; }\n    if (s.do === 'collect') { const q = g.prompt.pickups.find((o) => o.tag === s.tag); if (q) return s.tag === 'payroll-case' ? null : [q.x, q.z]; }\n    return this.st.target ?? null;\n  }\n  onDestroyed(d) { const s = this.step; if (s?.do === 'destroy' && d.tag === s.tag && (!s.site || d.site === s.site)) { this.st.destroyed = (this.st.destroyed ?? 0) + 1; } }\n  next() {\n    const s = this.step; this.stepI++;\n    if (s?.do === 'script') SCRIPTS[s.script]?.end?.(this.game, s, this.st);\n    if (this.stepI >= this.steps.length) this.complete(); else this.beginStep();\n  }\n  complete() {\n    const m = this.active, g = this.game;\n    this.active = null; g.story.done[m.id] = true; g.story.current = null; g.story.pass = null;\n    g.world.pinWind(null); g.world.setWeather('clear');\n    const alt = this.altTaken ? (m.alt?.bonus ?? 0) : 0;\n    const pay = Math.round(Math.max(0, (m.pay ?? 0) + alt) * TUNING.stonesReward);\n    if (pay) { g.player.stones += pay; g.story.ledger.stones += pay; g.notice(`+${pay} STONES`); }\n    for (const a of m.onDone ?? []) {\n      if (a.give?.tablets) { g.player.tablets += a.give.tablets; g.notice(`+${a.give.tablets} TABLETS`); g.story.feverOn = true; g.body.resetFever(); }\n      if (a.flag) g.story.flags[a.flag] = true;\n      if (a.burnStrip) g.world.burnStrip(a.burnStrip);\n      if (a.script) SCRIPTS[a.script]?.run?.(g, m);\n      if (a.smoke) g.story.smoke = { at: a.smoke, until: g.world.totalHours + 24 };\n      if (a.line) g.talk.playLines(a.line);\n      if (a.ledger?.paid) g.story.ledger.paidFor = (g.story.ledger.paidFor ?? 0) + 0;\n    }\n    if (m.id === 'm4') g.buddies.state.dov.met = true;\n    g.buddies.clear();\n    g.people.showFriends();\n    g.events.emit('missionDone', m);\n    g.prompt.missionUse.length = 0;\n    g.save.write();\n    const nx = (m.onDone ?? []).find((a) => a.start);\n    if (nx) this.start(nx.start);\n    else if (this.available().length === 1 && this.available()[0].id === 'm7') g.talk.say('you', 'THERE IS A NOTE AT YOUR SAFEHOUSE.', 4);\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player, s = this.step;\n    if (this.textT > 0) this.textT -= dt;\n    if (!this.active || !s || g.ui.top || g.talk.locksPlayer()) return;\n    this.st.t += dt;\n    // The buddy's call.\n    if (this.altPending) {\n      this.altT -= dt;\n      if (this.altT <= 0 && !this.altCalled) { this.altCalled = true; g.audio.play('radio'); g.talk.playLines(this.altPending.call); this.st.altWindow = 16; }\n      if (this.altCalled) { this.st.altWindow -= dt; g.prompt.setChoice({ use: 'TAKE THE PLAN', finish: 'NOT THIS TIME', radio: true }); }\n      if (this.altCalled && (this.ctx.input.consumeAny(['PadSquare', 'KeyE']))) { this.altCalled = false; this.acceptAlt(); return; }\n      if (this.altCalled && (this.ctx.input.consumeAny(['PadTriangle', 'KeyF']) || this.st.altWindow <= 0)) { this.altCalled = false; this.ignoreAlt(); }\n    }\n    const site = s.site ? siteById[s.site] : null;\n    const dTo = (at) => dist2(at[0], at[1], p.x, p.z);\n    let ok = false;\n    switch (s.do) {\n      case 'goto': ok = dTo(s.at ?? site.at) < (s.r ?? 20); break;\n      case 'leave': ok = dTo(site.at) > s.r; break;\n      case 'talk': case 'report': this.ensureTalk(s); ok = !!this.st.talked; break;\n      case 'use': ok = !!this.st.used; if (ok && s.lines) { const l = s.lines; this.st.used = false; g.talk.startScene({ lines: [l], at: [p.x, p.y + 1.5, p.z + 2], onDone: () => this.next() }); return; } break;\n      case 'deliver': ok = dTo(s.at) < s.r; if (ok && s.lines) g.talk.playLines(s.lines); break;\n      case 'destroy': ok = (this.st.destroyed ?? 0) >= s.n; break;\n      case 'kill': ok = (this.st.killed ?? 0) >= s.n; break;\n      case 'collect': ok = !!g.story.collected?.[s.tag]; break;\n      case 'steal': ok = p.vehicle?.tag === s.tag; break;\n      case 'hold': ok = this.tickHold(s, dt); break;\n      case 'ride': case 'script': case 'choice': { const sc = SCRIPTS[s.script]; ok = sc?.tick ? sc.tick(g, s, this.st, dt) : true; break; }\n      case 'timer': ok = this.st.t >= s.seconds; break;\n      case 'escort': { const a = this.st.escort; ok = a && dist2(a.x, a.z, s.to[0], s.to[1]) < 8; break; }\n    }\n    if (ok) this.next();\n  }\n  tickHold(s, dt) {\n    const g = this.game, site = siteById[s.site], at = s.at ?? site.at, p = g.player;\n    const inside = dist2(at[0], at[1], p.x, p.z) < s.r;\n    if (inside) this.st.left -= dt;\n    this.st.waveT -= dt;\n    if (this.st.waveT <= 0) { this.st.waveT = 16; g.spawnWave(at, s.waves); }\n    g.hud.holdTimer = inside ? this.st.left : null;\n    if (this.st.left <= 0) { g.hud.holdTimer = null; return true; }\n    return false;\n  }\n  ensureTalk(s) {\n    const g = this.game;\n    if (this.st.talkAdded) return; this.st.talkAdded = true;\n    this.st.talkFn = () => { const alt = this.altTaken && s.linesAlt ? s.linesAlt : s.lines; g.talk.startScene({ lines: [alt], speaker: s.to, onDone: () => { this.st.talked = true; } }); };\n  }\n  /** The talk step's prompt, if this is the npc it wants. */\n  talkStep(id) { const s = this.step; if (s && (s.do === 'talk' || s.do === 'report') && s.to === id && this.st.talkFn) return { label: `TALK TO ${g2(id)}`, fn: this.st.talkFn }; return null; }\n}\nconst g2 = (id) => ({ odile: 'SISTER ODILE', tibor: 'TIBOR', vance: 'COL. VANCE', ansa: 'MOTHER ANSA', harrow: 'HARROW', bakr: 'OLD BAKR' })[id] ?? id.toUpperCase();\nexport const npcTitle = g2;\nEOF\ncat > src/missions/scripts.js <<'EOF'\n// The scripted beats of the story. Everything else in missions.js is plain data.\nimport { LINES } from '../content/dialogue.js';\nimport { RAILWAY, ROADS } from '../content/roads.js';\nimport { siteById } from '../content/sites.js';\nimport { TUNING } from '../core/tuning.js';\nimport { dist2, polyPoint } from '../world/geom.js';\nimport { BURNING, BURNT, cellX, cellZ, FIRE_N } from '../world/fire.js';\nconst fieldProgress = (g) => { const f = g.world.fire, site = siteById['long-field']; let tot = 0, lit = 0; const x0 = site.at[0] - 90, z0 = site.at[1] - 60; for (let z = z0; z < z0 + 120; z += 5) for (let x = x0; x < x0 + 180; x += 5) { const i = Math.floor((x + 640) / 5) + Math.floor((z + 640) / 5) * FIRE_N; tot++; if (f.state[i] === BURNING || f.state[i] === BURNT) lit++; } return lit / tot; };\nexport const SCRIPTS = {\n  // ----- M0 -----\n  m0Ride: {\n    start(g, s, st) {\n      const t = g.train, q = {}; polyPoint(RAILWAY, 0, q);\n      t.s = t.sToward(-520, 106); t.topSpeed = 13; t.goal = t.sToward(14, 68); t.place();\n      g.setRiding(t); g.world.setHour(18.2, true); g.world.sites['p2'].dormant = true;\n      g.player.setYaw(Math.PI * 0.5 + Math.PI, -0.05);\n      st.skip = false; g.player.items.map = true;\n    },\n    tick(g, s, st) { if (g.skipPressed()) st.skip = true; return st.skip || st.t >= s.seconds; },\n  },\n  m0Map: {\n    start(g, s, st) { st.upT = 0; g.story.marginNote = 'MIND THE FEVER. YOU ARE LATE ALREADY. E.H.'; g.prompt.flash('map', 'RAISE YOUR MAP'); st.nag = 0; },\n    tick(g, s, st, dt) { st.nag -= dt; if (st.nag <= 0 && !g.player.mapUp) { st.nag = 2; g.prompt.flash('map', 'RAISE YOUR MAP'); } if (g.player.mapUp) st.upT += dt; if (st.upT > 3) { return true; } return g.skipPressed(); },\n  },\n  m0Fever: {\n    start(g, s, st) { st.phase = 0; st.left = 14; g.body.fever = 0; g.body.feverActive = true; g.body.feverIgnored = -1e9; g.train.setAt(10, 70); g.setRiding(null); g.player.teleport(3, 63); g.player.mapUp = false; g.prompt.flash('jump', 'GET OFF THE TRAIN'); },\n    tick(g, s, st, dt) { st.left -= dt; if (st.left <= 0 || g.skipPressed()) return true; return false; },\n    end(g) { g.body.feverActive = false; g.body.fever = 0; g.body.feverNext = 1e9; g.world.sites['p2'].dormant = false; g.blackout('', null, 1.2); },\n  },\n  // ----- M1 -----\n  m1Wake: {\n    start(g, s, st) { g.body.fever = 0.8; g.body.feverActive = true; g.body.feverIgnored = -1e9; g.player.tablets = Math.max(1, g.player.tablets); st.taken = false; st.off = g.events.on('tablet', () => { st.taken = true; }); g.prompt.flash('tablet', 'TAKE THE TABLET'); st.nag = 3; g.autoWaypoint(); },\n    tick(g, s, st, dt) { st.nag -= dt; if (st.nag <= 0 && !st.taken) { st.nag = 3; g.prompt.flash('tablet', 'HOLD TO TAKE THE TABLET'); } return st.taken; },\n    end(g, s, st) { st.off?.(); },\n  },\n  m1Ambush: {\n    start(g, s, st) { st.unjam = false; st.off = g.events.on('unjam', () => { st.unjam = true; }); const gun = g.player.guns.main; if (gun) gun.scriptedJam = 5; st.target = [-200, 30]; g.world.sites.p2.dormant = false; g.world.sites.p2.cleared = false; g.world.sites.p2.clearedAt = -1e9; },\n    tick(g, s, st) {\n      const p = g.player, d = dist2(p.x, p.z, -200, 30), v = g.vehicles.list.find((o) => o.tag === 'clinic-truck');\n      if (d < 55 && v && !v.stalled && p.vehicle === v) { v.hp = 0; v.stalled = true; g.audio.at('stall', v.x, v.y, v.z, 50); g.talk.playLines('m1.stall'); }\n      if (st.unjam) return true;\n      const gun = p.guns.main; if (gun?.jammed) g.prompt.flash('reload', 'CLEAR THE JAM');\n      const cleared = g.world.sites.p2.cleared || d > 300;\n      if (d < 55 && cleared && !gun?.scriptedJam) return true;\n      if (d < 70 && !gun?.jammed && gun && !gun.scriptedJam && gun.cond === 45) gun.scriptedJam = 5;\n      return false;\n    },\n    end(g, s, st) { st.off?.(); },\n  },\n  m1Repair: {\n    start(g, s, st) { const v = g.vehicles.list.find((o) => o.tag === 'clinic-truck'); st.v = v; if (v) { if (g.player.vehicle === v) g.vehicles.exit(true); v.stalled = true; v.hp = 0; st.target = [v.x, v.z]; } },\n    tick(g, s, st) { const v = st.v; if (!v) return true; if (!v.stalled) return true; return false; },\n  },\n  m1Syrette: {\n    start(g, s, st) { st.taken = false; st.off = g.events.on('syrette', () => { st.taken = true; }); if (g.player.hp > 70) g.player.hp = 62; g.player.syrettes = Math.max(1, g.player.syrettes); g.prompt.flash('heal', 'USE A SYRETTE'); st.nag = 3; },\n    tick(g, s, st, dt) { st.nag -= dt; if (st.nag <= 0 && !st.taken) { st.nag = 3; g.prompt.flash('heal', 'HOLD TO USE A SYRETTE'); } return st.taken; },\n    end(g, s, st) { st.off?.(); },\n  },\n  // ----- M2 -----\n  freeInes: { run(g) { const site = g.world.sites['ranger-post'], door = site.cage?.object.getObjectByName('Door'); if (door) door.rotation.y = -1.9; g.audio.play('door'); g.buddies.state.ines.met = true; const a = g.buddies.spawnFollower('ines', siteById['ranger-post'].at[0] + 9, siteById['ranger-post'].at[1] + 7); a.state = 'alert'; } },\n  m2Clear: {\n    start(g, s, st) { st.target = siteById['ranger-post'].at; },\n    tick(g, s, st) { const site = g.world.sites['ranger-post']; return site.cleared || dist2(g.player.x, g.player.z, site.def.at[0], site.def.at[1]) > 140; },\n    end(g) { g.world.sites['ranger-post'].cleared = true; g.world.sites['ranger-post'].clearedAt = 1e9; },\n  },\n  // ----- M4 -----\n  plantBridge: { run(g) { const c = g.spawnCharge(120, g.world.bridgeY?.(120, 244) ?? g.world.land.heightAt(120, 244) + 0.1, 244); g.player.planted.push(c); g.missions.st.bridgePlanted = true; g.story.bridgeCharge = c; g.notice('PRESS THROW TO DETONATE'); } },\n  m4Convoy: {\n    start(g, s, st) {\n      const usesBridge = g.story.altTaken?.m4;\n      const road = usesBridge ? ROADS.back.slice().reverse() : ROADS.salt.slice(4).concat(ROADS.salt.slice(4, 5));\n      const start = road[0];\n      st.target = usesBridge ? [120, 230] : siteById['salt-pan'].at;\n      st.convoy = [];\n      const specs = [['technical', 0], ['cargo-truck', 1], ['technical', 2]];\n      for (const [type, i] of specs) { const v = g.vehicles.spawn(type, start[0] + (usesBridge ? 8 * i : -8 * i), start[1] - 4 * i, Math.atan2(road[1][0] - start[0], road[1][1] - start[1]), i === 1 ? 'payroll' : 'escort'); v.aiRoad = road; v.aiLoop = !usesBridge; v.aiSpeed = 10; v.aiS = 0; v.hostile = 'concord'; st.convoy.push(v); }\n      st.truck = st.convoy[1];\n      st.off = g.events.on('stalled', (v) => { if (v.hostile) g.spawnCrew(v); });\n    },\n    tick(g, s, st) { const t = st.truck; if (!t) return true; if (t.dead || t.stalled) { const x = t.x + 18, z = t.z - 14; g.spawnStonePickup(x, z, 'payroll-case', g.story.bridgeCharge ? 6 : 8); g.talk.say('you', 'THE CASE WENT FLYING. RAISE THE TRACKER.', 4); g.story.caseAt = [x, z]; return true; } return false; },\n    end(g, s, st) { st.off?.(); },\n  },\n  // ----- M5 -----\n  openBypass: { run(g) { g.audio.play('wrench'); g.story.bypassOpen = true; g.notice('THE CISTERN IS FILLING'); } },\n  m5Consequence: { run(g) { const alt = g.story.altTaken?.m5 && g.story.bypassOpen; if (!alt) { g.story.threeWellsEmpty = true; g.story.ledger.moved += 104; g.story.odileRefuses = true; g.people.emptyThreeWells(); g.setHutsDark(true); g.talk.playLines('m5.empty'); } } },\n  // ----- M6 -----\n  m6Partner: {\n    start(g, s, st) { g.world.setHour(23, true); st.target = [-260, -180]; const id = g.buddies.highestTrust() ?? 'pell'; st.id = id; g.story.m6Partner = id; const p = g.player; const a = g.buddies.spawnFollower(id, p.x + 3, p.z + 3); st.a = a; g.missions.st.partner = a; g.talk.say(id, id === 'pell' ? 'I am Pell. The Mother sent me. I do not know why.' : 'So we burn a farm. I have burned worse for less.', 5); },\n    tick() { return true; },\n    end(g, s, st) { g.story.m6PartnerActor = st.a; },\n  },\n  m6Burn: {\n    start(g, s, st) { st.target = [-260, -240]; st.bunker = false; st.off = g.events.on('destroyed', (d) => { if (d.tag === 'ammo-bunker') st.bunker = true; }); },\n    tick(g, s, st) { const k = fieldProgress(g); st.progress = k; return k > 0.45 || (st.bunker && k > 0.1); },\n    end(g, s, st) { st.off?.(); },\n  },\n  m6Turn: {\n    start(g, s, st) { st.t2 = 0; g.world.pinWind({ dir: [0, 1], speed: 7.5 }); g.talk.playLines('m6.turn'); const a = g.story.m6PartnerActor; if (a) a.duty = 'guard'; },\n    tick(g, s, st, dt) { st.t2 += dt; const a = g.story.m6PartnerActor; if (!a || !a.alive) return true; if (st.t2 > 4 && !a.down) { a.invulnerable = false; g.world.fire.ignite(a.x, a.z, 4); g.actors.goDown(a, { fire: true }); } return a.down || st.t2 > 8; },\n  },\n  m6Choice: {\n    start(g, s, st) { const a = g.story.m6PartnerActor; if (a) st.target = [a.x, a.z]; },\n    tick(g, s, st) { const a = g.story.m6PartnerActor; if (!a) return true; if (a.down) { st.target = [a.x, a.z]; a.downT = Math.max(a.downT, 3); } return !a.down || !a.alive; },\n    end(g) { g.story.ledger.hardLine = true; },\n  },\n  // ----- M7 -----\n  m7Note: { start(g, s, st) { st.t3 = 0; }, tick(g, s, st, dt) { st.t3 += dt; return st.t3 > 2.5; } },\n  m7Fight: {\n    start(g, s, st) {\n      g.warOn = true; st.target = [104, -322]; const at = siteById['the-cut'].at;\n      g.spawnSquad('concord', at[0] + 60, at[1] + 50, 6, 'm7'); g.spawnSquad('harvest', at[0] - 40, at[1] + 60, 6, 'm7'); g.spawnSquad('harvest', at[0] + 70, at[1] - 30, 4, 'm7');\n      g.world.fire.ignite(at[0] + 110, at[1] + 40, 8); g.world.fire.ignite(at[0] - 96, at[1] + 30, 8);\n      if (g.missions.altTaken) { const b = g.buddies.followers[0]; if (b) { b.duty = 'guard'; b.ctrl?.teleport([at[0] + 96, g.world.land.heightAt(at[0] + 96, at[1]) + 0.1, at[1]]); } g.world.fire.extinguishNear?.(at[0], at[1]); }\n      const tech = g.vehicles.spawn('technical', at[0] + 60, at[1] + 80, 3.1, 'm7-tech'); st.tech = tech;\n    },\n    tick(g, s, st) { return dist2(g.player.x, g.player.z, 104, -322) < 16; },\n  },\n  m7Consequence: { run(g) { const st = g.story; st.truceOver = true; st.act = 3; g.warOn = false; for (const id of ['tractor', 'mule', 'empire', 'weed', 'tube']) if (st.bought?.[id]) st.lockerAll = true; st.lockerAll = true; g.world.sites['mile-forty'].truceOver = true; g.vehicles.list.filter((v) => v.tag === 'm7-tech').forEach((v) => { v.tag = null; }); } },\n  // ----- M8 -----\n  m8Ride: {\n    start(g, s, st) {\n      const t = g.train; t.setAt(10, 70); t.topSpeed = 11; t.goal = t.sToward(416, -64);\n      g.setRiding(t, true); st.t4 = 0; st.spawnT = 3; g.player.setYaw(-Math.PI / 2 + Math.PI, 0); g.talk.playLines('m8.bakr');\n    },\n    tick(g, s, st, dt) { st.t4 += dt; st.spawnT -= dt; if (st.spawnT <= 0) { st.spawnT = 7; const t = g.train, q = {}; polyPoint(RAILWAY, Math.min(t.L, t.s + 70), q); g.spawnSquad(g.combat.rng.next() < 0.5 ? 'concord' : 'harvest', q.x + 18, q.z + 22, 3, 'm8'); } if (g.skipPressed()) return true; return st.t4 >= s.seconds; },\n    end(g) { g.setRiding(null); g.player.teleport(418, -68); },\n  },\n  m8End: { start(g, s, st) { st.t5 = 0; g.people.startColumn(); g.story.ledger.moved += 306; g.notice('THE COLUMN IS ON YOUR MAP'); }, tick(g, s, st, dt) { st.t5 += dt; return st.t5 > 8 || g.skipPressed(); } },\n  // ----- M9 -----\n  m9Scene: {\n    start(g, s, st) {\n      st.done = false; const site = siteById.observatory, table = [site.at[0], g.world.land.heightAt(site.at[0], site.at[1]) + 0.8, site.at[1] + 0.8];\n      g.mapTex.arc = true; g.showTableMap(table);\n      g.talk.startScene({ lines: [s.lines], camera: { position: [table[0], table[1] + 0.7, table[2] + 0.5], target: table }, onDone: () => { st.done = true; g.showTableMap(null); } });\n    },\n    tick(g, s, st) { return st.done; },\n  },\n  m9Finish: {\n    start(g, s, st) {\n      st.done = false;\n      g.talk.startScene({ speaker: 'harrow', lines: [], choices: [{ text: 'FINISH YOUR CONTRACT', fn: () => { const n = g.people.npcs.harrow; g.vm.playTool('Finish', ['tool-revolver']); g.ctx.tweens.call(1.5, () => { g.audio.play('gun-revolver'); n.view.setFull('Death', true); g.story.ledger.harrow = 'shot'; g.story.ledger.killed += 1; }); g.ctx.tweens.call(1.8, () => g.talk.playLines('m9.shot')); g.ctx.tweens.call(3.2, () => { st.done = true; }); } }, { text: 'LEAVE HIM TO THE FEVER', fn: () => { g.story.ledger.harrow = 'spared'; g.talk.playLines('m9.spared'); g.ctx.tweens.call(2.4, () => { st.done = true; }); } }] });\n    },\n    tick(g, s, st) { return st.done; },\n  },\n  m9Sheet: {\n    start(g, s, st) {\n      st.done = false;\n      g.talk.startScene({ at: [g.player.x, g.player.y + 1.3, g.player.z + 3], lines: [], choices: [{ text: 'WALK OUT WITH THE SHEET', fn: () => { g.story.ending = 'walk'; st.done = true; } }, { text: 'GIVE IT TO THE COLUMN', fn: () => { g.story.ending = 'column'; st.done = true; } }] });\n    },\n    tick(g, s, st) { return st.done; },\n    end(g) { const n = g.people.npcs.harrow; if (g.story.ledger.harrow === 'spared') n.gone = true; },\n  },\n  // ----- The Pass -----\n  endGo: {\n    start(g, s, st) { st.d = false; g.world.setWeather('clear'); g.blackout('', () => { g.world.setHour(5.4, true); g.player.teleport(-500, -420); g.player.setYaw(Math.PI / 2, 0); st.target = [-590, -430]; g.talk.playLines(g.story.ending === 'walk' ? 'end.walk' : 'end.column'); if (g.story.ending === 'column') g.people.column && (g.people.column.s = g.people.column.L - 80); st.d = true; }, 1.2); st.target = [-590, -430]; },\n    tick(g, s, st) { return st.d && dist2(g.player.x, g.player.z, -590, -430) < 60; },\n  },\n  endStand: {\n    start(g, s, st) { st.left = 40; st.wave = 1; g.hud.holdTimer = st.left; },\n    tick(g, s, st, dt) { st.left -= dt; st.wave -= dt; g.hud.holdTimer = st.left; if (st.wave <= 0) { st.wave = 12; const a = g.combat.rng.range(-0.8, 0.8); g.spawnSquad(g.combat.rng.next() < 0.5 ? 'concord' : 'harvest', -590 + Math.cos(a) * 60, -430 + Math.sin(a) * 60, 3, 'pass'); } if (st.left <= 0) { g.hud.holdTimer = null; return true; } return false; },\n  },\n  endBuddies: {\n    start(g, s, st) {\n      st.list = []; const alive = g.buddies.alive(); st.done = alive.length === 0;\n      g.warOn = false; g.actors.list.filter((a) => a.tag === 'pass').forEach((a) => { a.state = 'searching'; });\n      const spawn = () => { alive.forEach((id, i) => { const a = g.actors.spawn({ kind: 'soldier', faction: 'friends-end', role: 'rifle', tag: 'end-buddy', modelId: id, x: g.player.x + 16 + i * 4, z: g.player.z + 12 - i * 5, hp: 200, duty: 'guard' }); a.hp = 200; a.maxHp = 200; a.state = 'alert'; a.reaction = 2; st.list.push(a); g.talk.playLines(`end.${id}`); }); };\n      const high = alive.some((id) => g.buddies.state[id].trust >= 3);\n      if (high && alive.length) g.talk.startScene({ lines: ['end.split'], at: [g.player.x + 8, g.player.y + 1.4, g.player.z + 8], choices: [{ text: 'SPLIT IT', fn: () => { g.notice('THEY DRAW ANYWAY'); g.story.ledger.stones = Math.floor(g.story.ledger.stones * 0.7); spawn(); } }, { text: 'NO', fn: spawn }] });\n      else if (alive.length) spawn();\n    },\n    tick(g, s, st) { return st.done || (st.list.length > 0 && st.list.every((a) => !a.alive)); },\n    end(g, s, st) { for (const a of st.list) if (a.buddy) a.buddy = null; for (const id of g.buddies.alive()) { g.buddies.state[id].alive = false; g.story.ledger.friends++; } },\n  },\n  endLight: {\n    start(g, s, st) { st.used = false; const u = { x: g.player.x + 2, z: g.player.z + 2, y: g.player.y + 0.5, label: 'LIGHT THE GRASS', r: 200, anyAngle: true, hold: 1, fn: () => { st.used = true; g.world.fire.ignite(g.player.x + 6, g.player.z + 6, 6); g.audio.play('lighter'); g.world.pinWind({ dir: [1, 0.3], speed: 6 }); } }; g.prompt.missionUse.push(u); },\n    tick(g, s, st, dt) { if (st.used) { st.after = (st.after ?? 0) + dt; return st.after > 9; } return false; },\n  },\n  endFinish: { run(g) { g.finishGame(); } },\n};\nexport { LINES, TUNING, cellX, cellZ };\nEOF\nsed -i \"s/^import { BURNING, BURNT, cellX, cellZ, FIRE_N } from/import { BURNING, BURNT, cellX, cellZ, FIRE_N } from/\" src/missions/scripts.js\necho ok; cat >> ../PROGRESS.md <<'EOF'\nWritten (untested): src/world/world.js, actors/{rig,soldier,player,buddy,civilian}.js, combat/{projectiles,viewmodel,weapons}.js, body/health.js, vehicles/vehicle.js, ui/{dialogue,prompts}.js, missions/{runner,scripts,ledger}.js, content/{weapons,dialogue,missions}.js.\nRemaining: world/map-texture.js, core/save.js, ui/{hud,glyphs,menu,screens,pixfont,about}.js, dev, attract, audio, net, game.js, main.js, tests, DESIGNERS.md.\nEOF","description":"Write buddies, civilians, dialogue, prompts, mission runner and scripts"}}}
