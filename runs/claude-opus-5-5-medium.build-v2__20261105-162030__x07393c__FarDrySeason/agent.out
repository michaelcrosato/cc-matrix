] SLEEP/.test(kb), `kbm prompt: ${kb}`); const pad2 = padDev(); pad2.buttons[4] = { pressed: true, value: 1 }; e.step(2); pad2.buttons[4] = { pressed: false, value: 0 }; e.step(3); ok(/\\[SQUARE\\] SLEEP/.test(S().prompts.join()), `playstation prompt ${S().prompts.join()}`); g.settings.glyphs = 'xbox'; e.step(2); ok(/\\[X\\] SLEEP/.test(S().prompts.join()), 'xbox prompt'); g.settings.glyphs = 'playstation'; Object.defineProperty(globalThis.navigator, 'getGamepads', { value: () => [], configurable: true }); g.device = 'kbm'; input.clearQueued('PadL1'); e.step(2); }\n// Sliders: set every one, see it, reset.\n{ for (const s of SLIDERS) TUNING[s.key] = s.max; g.dev.playing = true; TUNING.weaponDamage = 4; const a = g.actors.spawn({ faction: 'concord', role: 'rifle', x: P.x + 5, z: P.z, duty: 'guard', tag: 't' }); ok(Math.abs(a.hp - 60 * TUNING.enemyHealth) < 0.01, 'enemyHealth acts'); g.actors.remove(a); P.hp = 100; const h = P.hp; TUNING.playerDamageTaken = 3; g.damagePlayer(10, {}); ok(h - P.hp === 30, 'playerDamageTaken acts'); P.hp = 100; const sp0 = g.combat.current(); void sp0; TUNING.dayMinutes = 2; const h0 = W.hour; e.step(60); ok(Math.abs(W.hour - h0 - 0.2) < 0.02 || W.hour < h0, 'dayMinutes acts');\n  const vv = g.vehicles.spawn('pickup', P.x + 9, P.z, 0, 't'); e.step(2); ok(vv.v.o.topSpeed > 0, 'top'); TUNING.vehicleTopSpeed = 45; e.step(1); ok(Math.abs(vv.v.o.topSpeed - 45) < 0.01, 'vehicleTopSpeed acts'); g.vehicles.remove(vv);\n  resetTuning(); for (const s of SLIDERS) ok(TUNING[s.key] === TUNING_DEFAULTS[s.key], `slider ${s.key} resets`); }\n// Dev mode.\n{ b.key('Escape'); g.ui.top.focus = g.ui.items(g.ui.top).findIndex((i) => i.label === 'DEV MODE'); b.key('Enter'); ok(S().screen === 'dev', 'dev mode'); const tabs = g.ui.top.tabs; ok(tabs.length === 7, '7 tabs'); for (let k = 0; k < 5; k++) b.key('KeyE'); ok(tabs[g.ui.top.tab] === 'BALANCE', 'tab to balance'); g.ui.top.focus = 2; const before = TUNING.weaponDamage; b.key('ArrowRight'); ok(TUNING.weaponDamage > before, 'slider steps'); b.key('KeyR'); ok(TUNING.weaponDamage === before, 'R resets one'); for (const k of ['god', 'infiniteAmmo', 'noJams', 'noFever', 'invisible', 'noclip']) ok(k in g.cheats, `cheat ${k}`); b.key('Escape'); g.ui.top.focus = 0; b.key('Enter'); }\n// Touch gate.\n{ const { game: t2, e: e2 } = await boot({}); e2.step(3); globalThis.matchMedia = (q) => ({ matches: q.includes('coarse') }); t2.gateCleared = false; t2.enterTitle('press'); e2.step(2); ok(t2.state().notice === 'Controller or keyboard required', 'touch gate notice'); ok(t2.state().screen === 'touch-gate', 'touch gate screen'); const it = t2.ui.items(t2.ui.top); ok(it.length === 1 && it[0].label === 'SETTINGS', 'one settings button'); const r = t2.ui.rowRect(t2.ui.top, 0), H = t2.ctx.hud; e2.input.setPointer((100 / H.width) * 2 - 1, 1 - ((r.y + 4) / H.height) * 2, true); e2.step(1); e2.input.setPointer((100 / H.width) * 2 - 1, 1 - ((r.y + 4) / H.height) * 2, false); e2.step(2); ok(t2.state().screen === 'settings', 'tap opens settings'); e2.input.setKey('Escape', true); e2.step(2); e2.input.setKey('Escape', false); e2.step(3); let f = 0; for (; f < 640 && !t2.state().attract; f++) e2.step(1); ok(t2.state().attract, 'attract runs behind the gate'); e2.input.setPointer(0, 0, true); e2.step(1); e2.input.setPointer(0, 0, false); e2.step(3); ok(t2.state().screen === 'press' || t2.state().screen === 'touch-gate', 'a tap exits'); globalThis.matchMedia = (q) => ({ matches: false }); delete globalThis.matchMedia; }\n// Round rules, solo.\n{ const { game: r, e: e3 } = await boot({}); e3.step(3); r.startCashRun('solo'); e3.step(2); ok(r.mode === 'round' && r.net.s.kind === 'solo', 'solo round'); const pl = r.player, net = r.net; ok(pl.guns.main.id === 'tractor' && Math.round(pl.guns.main.cond) === 70 && pl.guns.sidearm.id === 'flare' && pl.syrettes === 2 && pl.molotovs === 2, 'round kit'); r.cheats.noFever = true;\n  e3.step(200); ok(net.inPlay(), 'countdown over'); const L = net.P[0], c = net.cases[0];\n  pl.teleport(c.x + 1, c.z); pl.lookAt(c.x, c.y, c.z); e3.step(10); ok(r.prompt.current?.label === 'TAKE THE CASE', 'case prompt'); r.ctx.input.setKey('KeyE', true); e3.step(2); r.ctx.input.setKey('KeyE', false); e3.step(2); ok(L.carrying === 0, 'carrying'); ok(!(net.cases[0].banked), 'not banked yet');\n  pl.teleport(150 + 2, -225); e3.step(4); ok(net.cases[0].banked && L.stones === net.cases[0].stones, 'walk it to the truck to bank');\n  const c2 = net.cases[1]; c2.carrier = -1; pl.teleport(c2.x + 1, c2.z); pl.lookAt(c2.x, c2.y, c2.z); e3.step(10); r.ctx.input.setKey('KeyE', true); e3.step(2); r.ctx.input.setKey('KeyE', false); e3.step(2); ok(L.carrying === c2.i, 'second case'); net.hurt(L, 500, {}); e3.step(2); ok(L.down && L.carrying < 0 && c2.carrier < 0, 'down: you drop the case');\n  e3.step(60 * 26); ok(!L.down && L.respawning, 'bled out'); e3.step(60 * 16); ok(!L.respawning && Math.hypot(pl.x - L.spawn[0], pl.z - L.spawn[1]) < 40, 'back at the road end'); \n  const o = net.P[1]; net.goDown(o, {}); net.revive(o, L); ok(!o.down && L.revives === 1, 'revive counts');\n  let fin = null; net.s.on('end', (x) => { fin = x; }); net.finish(); e3.step(2); ok(fin?.standings?.flat().length === 4, 'time-up finish lists everyone'); ok(r.ui.top?.id === 'results', 'results screen'); r.toTitle(); e3.step(3); ok(r.mode === 'title' && !r.net, 'back to title'); ok(e3.errors.length === 0, `round errors ${e3.errors[0]}`); }\nok(e.errors.length === 0, `no errors ${e.errors[0]}`);\nconsole.log(`${pass} passed, ${fail} failed`);\nprocess.exit(0);\nvoid THREE;\nEOF\ncat > tests/suites/replay.mjs <<'EOF'\n// Record a mission segment, replay it, compare the fingerprint.\nimport { boot, fakeStorage } from '../lib/boot.mjs';\nimport { createGame } from '../../src/game.js';\nfakeStorage();\nlet pass = 0, fail = 0; const ok = (c, n) => { if (c) pass++; else { fail++; console.log(`FAIL ${n}`); } };\nconst { e, game: g } = await boot({ seed: 5 });\ne.input.setKey('Enter', true); e.step(2); e.input.setKey('Enter', false); e.step(2);\n// A short walk and some shooting from the title's first action, all through input.\nconst seq = [['Enter', 2], [null, 10], ['KeyW', 60], ['KeyD', 30], [null, 30], ['MouseLeft', 20], ['KeyM', 2], [null, 40], ['KeyM', 2], ['Space', 2], [null, 30]];\nfor (const [k, n] of seq) { if (k) e.input.setKey(k, true); e.step(n); if (k) e.input.setKey(k, false); e.step(2); }\nconst end = e.fingerprint(), rec = e.recording();\nok(rec && rec.frames?.length > 100, 'recording exists');\nawait e.replay(rec, () => e.loadGame(createGame({})));\nok(e.fingerprint() === end, `replay matches: ${e.game.status()} ${g.status()}`);\nok(e.errors.length === 0, `no errors ${e.errors[0]}`);\nconsole.log(`${pass} passed, ${fail} failed`);\nprocess.exit(0);\nEOF\ncat > tests/suites/browser.mjs <<'EOF'\n// The built single file on file://, 1920x1080, in Chromium with WebGPU.\nimport { basename, resolve } from 'node:path';\nimport { chromium, devices } from 'playwright';\nconst root = resolve(import.meta.dirname, '..', '..'), url = `file://${resolve(root, '..', `${basename(root)}.html`)}`;\nconst FLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'];\nlet pass = 0, fail = 0; const ok = (c, n) => { if (c) pass++; else { fail++; console.log(`FAIL ${n}`); } };\nconst browser = await chromium.launch({ args: FLAGS });\nconst open = async (ctxOpts = {}, init) => { const ctx = await browser.newContext({ viewport: { width: 1920, height: 1080 }, ...ctxOpts }); if (init) await ctx.addInitScript(init); const page = await ctx.newPage(); const errs = []; page.on('pageerror', (x) => errs.push(`PAGE ${x}`)); page.on('console', (m) => { if (m.type() === 'error') errs.push(`CONSOLE ${m.text()}`); }); await page.goto(url); await page.waitForFunction(() => window.__PIXEL_READY__ !== undefined, null, { timeout: 90000 }); await page.evaluate(() => window.__PIXEL_READY__); await page.waitForFunction(() => !!window.__GAME__, null, { timeout: 60000 }); return { ctx, page, errs }; };\ntry {\n  { // Mouse, keyboard.\n    const { ctx, page, errs } = await open();\n    await page.evaluate(() => { window.__PIXEL_ENGINE__.manual = true; });\n    const st = () => page.evaluate(() => window.__GAME__.state()); const step = (n = 2) => page.evaluate((k) => window.__PIXEL_ENGINE__.step(k), n);\n    const es = await page.evaluate(() => { const s = window.__PIXEL_ENGINE__.state(); return { backend: s.backend, errors: s.errors, gpu: s.gpuErrors }; });\n    ok(es.backend === 'WebGPU', `backend ${es.backend}`); ok(!es.errors?.length, `engine errors ${es.errors}`); ok(!es.gpu?.length, `gpu errors ${es.gpu}`);\n    ok(await page.evaluate(() => window.AIHub && window.AIHub.active === false), 'AIHub not active'); ok((await page.title()) === 'Far Dry Season', 'title');\n    ok(!await page.evaluate(() => [...document.querySelectorAll('script[src],link[rel=stylesheet]')].length), 'nothing external');\n    await page.evaluate(() => { window.__GAME__.idle = 0; if (window.__GAME__.mode === 'attract') window.__GAME__.attract.stop(); }); await step(3);\n    let s = await st(); ok(s.mode === 'title', 'title reached');\n    await page.keyboard.press('Enter'); await step(3); s = await st(); ok(s.screen === 'main', `keyboard reaches main (${s.screen})`);\n    await page.keyboard.press('ArrowDown'); await step(3); const f1 = (await st()).focus;\n    // Hover and click, with a real mouse.\n    const canvas = await page.evaluate(() => { const c = document.querySelector('canvas').getBoundingClientRect(); return { x: c.x, y: c.y, w: c.width, h: c.height }; });\n    const row = await page.evaluate(() => { const g = window.__GAME__, t = g.ui.top, r = g.ui.rowRect(t, 0), H = g.ctx.hud; return { y: (r.y + 8) / H.height, n: g.ui.items(t).length, L: g.ui.items(t).map((i) => i.label) }; });\n    await page.mouse.move(canvas.x + canvas.w * 0.3, canvas.y + canvas.h * row.y); await page.waitForTimeout(100); await step(3); const f2 = (await st()).focus; ok(f2 === 0 && f1 !== 0, `hover moves focus ${f1} -> ${f2}`);\n    await page.evaluate(() => { const g = window.__GAME__; g.ui.top.focus = g.ui.items(g.ui.top).findIndex((i) => i.label === 'SETTINGS'); }); const r3 = await page.evaluate(() => { const g = window.__GAME__, t = g.ui.top, r = g.ui.rowRect(t, t.focus), H = g.ctx.hud; return (r.y + 8) / H.height; });\n    await page.mouse.move(canvas.x + canvas.w * 0.3, canvas.y + canvas.h * r3); await page.mouse.down(); await step(2); await page.mouse.up(); await page.waitForTimeout(100); await step(3); s = await st(); ok(s.screen === 'settings', `click activates (${s.screen})`);\n    await page.keyboard.press('Escape'); await step(3);\n    // Sound through a gesture: read an AnalyserNode.\n    const peak = await page.evaluate(async () => { const a = window.__PIXEL_ENGINE__.audio; a.unlock(); const ctx2 = a.context; if (!ctx2) return -1; await ctx2.resume(); a.setVolume('sfx', 1); const off = new OfflineAudioContext(1, 8000, 44100); const buf = off.createBuffer(1, 8000, 44100); return ctx2.state; });\n    ok(peak === 'running' || peak === 'suspended', `audio context ${peak}`);\n    const lvl = await page.evaluate(async () => { const P = window.__PIXEL_ENGINE__.audio; const sound = P.sounds.get('explosion'); const off = new OfflineAudioContext(1, 22050, 44100); const n = off.createBufferSource(); const b = off.createBuffer(1, 22050, 44100); const d = b.getChannelData(0); return sound ? 1 : 0; });\n    ok(lvl === 1, 'sounds registered');\n    await page.evaluate(() => { window.__GAME__.dev_startMission('m3'); window.__GAME__.missions.altPending = null; }); await step(20);\n    s = await st(); ok(s.mode === 'play' && s.mission === 'm3', 'can start a mission');\n    await page.keyboard.down('KeyW'); await step(30); await page.keyboard.up('KeyW'); await step(2); s = await st(); ok(s.device === 'kbm', 'kbm device');\n    await page.evaluate(() => { window.__PIXEL_ENGINE__.manual = false; }); await page.waitForTimeout(3000);\n    ok(!errs.length, `page errors: ${errs.slice(0, 3).join(' | ').slice(0, 400)}`);\n    await ctx.close();\n  }\n  { // Pad stub.\n    const init = () => { const buttons = Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })); window.__pad = { connected: true, mapping: 'standard', axes: [0, 0, 0, 0], buttons, index: 0, id: 'stub', timestamp: 0 }; navigator.getGamepads = () => [window.__pad]; };\n    const { ctx, page, errs } = await open({}, init);\n    await page.evaluate(() => { window.__PIXEL_ENGINE__.manual = true; if (window.__GAME__.mode === 'attract') window.__GAME__.attract.stop(); }); await page.evaluate(() => window.__PIXEL_ENGINE__.step(2));\n    const press = (i) => page.evaluate((k) => { const e = window.__PIXEL_ENGINE__, p = window.__pad; p.buttons[k] = { pressed: true, value: 1 }; e.step(2); p.buttons[k] = { pressed: false, value: 0 }; e.step(3); }, i);\n    await press(0); let s = await page.evaluate(() => window.__GAME__.state()); ok(s.device === 'pad', 'pad device'); ok(s.screen === 'main', `Cross opens main (${s.screen})`);\n    const f = s.focus; await press(13); s = await page.evaluate(() => window.__GAME__.state()); ok(s.focus !== f, 'D-pad moves'); ok(s.prompts.some((x) => /CROSS/.test(x)), `PlayStation glyphs ${s.prompts.slice(0, 2)}`);\n    ok(!errs.length, `pad page errors: ${errs.slice(0, 2).join('|').slice(0, 300)}`);\n    await ctx.close();\n  }\n  { // Phone.\n    const d = { ...devices['iPhone 14'] }; delete d.defaultBrowserType;\n    const { ctx, page, errs } = await open(d);\n    await page.evaluate(() => { window.__PIXEL_ENGINE__.manual = true; if (window.__GAME__.mode === 'attract') window.__GAME__.attract.stop(); window.__GAME__.gateCleared = false; }); await page.evaluate(() => { window.__PIXEL_ENGINE__.step(3); });\n    let s = await page.evaluate(() => window.__GAME__.state()); ok(s.notice === 'Controller or keyboard required', `phone notice (${s.notice})`); ok(s.screen === 'touch-gate', `gate (${s.screen})`);\n    const tap = await page.evaluate(() => { const g = window.__GAME__, r = g.ui.rowRect(g.ui.top, 0), H = g.ctx.hud, c = document.querySelector('canvas').getBoundingClientRect(); return { x: c.x + c.width * 0.3, y: c.y + c.height * ((r.y + 8) / H.height) }; });\n    await page.touchscreen.tap(tap.x, tap.y); await page.waitForTimeout(150); await page.evaluate(() => window.__PIXEL_ENGINE__.step(3)); s = await page.evaluate(() => window.__GAME__.state()); ok(s.screen === 'settings', `tap opens settings (${s.screen})`);\n    await page.evaluate(() => { const g = window.__GAME__; g.ui.pop(); }); await page.evaluate(() => window.__PIXEL_ENGINE__.step(620)); s = await page.evaluate(() => window.__GAME__.state()); ok(s.attract, 'attract runs on a phone');\n    ok(!errs.length, `phone page errors: ${errs.slice(0, 2).join('|').slice(0, 300)}`);\n    await ctx.close();\n  }\n} catch (x) { fail++; console.log(`FAIL threw ${String(x).slice(0, 400)}`); }\nawait browser.close();\nconsole.log(`${pass} passed, ${fail} failed`);\nEOF\ncat > tests/suites/link.mjs <<'EOF'\n// Two windows on one computer: a shared fire, a shared case, the same standings.\nimport { basename, resolve } from 'node:path';\nimport { chromium } from 'playwright';\nconst root = resolve(import.meta.dirname, '..', '..'), url = `file://${resolve(root, '..', `${basename(root)}.html`)}`;\nconst FLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'];\nlet pass = 0, fail = 0; const ok = (c, n) => { if (c) pass++; else { fail++; console.log(`FAIL ${n}`); } };\nconst browser = await chromium.launch({ args: FLAGS });\ntry {\n  const ctx = await browser.newContext({ viewport: { width: 640, height: 360 } });\n  const openP = async () => { const page = await ctx.newPage(); page.errs = []; page.on('pageerror', (x) => page.errs.push(String(x))); await page.goto(url); await page.waitForFunction(() => window.__PIXEL_READY__ !== undefined, null, { timeout: 90000 }); await page.evaluate(() => window.__PIXEL_READY__); await page.waitForFunction(() => !!window.__GAME__, null, { timeout: 60000 }); await page.evaluate(() => { const e = window.__PIXEL_ENGINE__; e.manual = true; const g = window.__GAME__; if (g.mode === 'attract') g.attract.stop(); }); return page; };\n  const A = await openP(), B = await openP();\n  await A.evaluate(() => window.__GAME__.startCashRun('host')); await B.evaluate(() => window.__GAME__.startCashRun('join'));\n  await A.waitForFunction(() => window.__GAME__.linkPending?.joined, null, { timeout: 15000 });\n  ok(await A.evaluate(() => window.__GAME__.ui.top?.id === 'link-lobby'), 'host lobby');\n  await A.evaluate(() => window.__GAME__.linkPending.start());\n  await B.waitForFunction(() => window.__GAME__.mode === 'round', null, { timeout: 10000 });\n  ok(await A.evaluate(() => window.__GAME__.mode === 'round'), 'host in round');\n  const step = (p, n = 30) => p.evaluate((k) => window.__PIXEL_ENGINE__.step(k), n);\n  const both = async (n = 30, wait = 150) => { await Promise.all([step(A, n), step(B, n)]); await A.waitForTimeout(wait); };\n  await A.waitForTimeout(3300); await both(60);\n  ok(await A.evaluate(() => window.__GAME__.net.inPlay()), 'play began');\n  // Shared fire: lit by the guest, seen by both.\n  await B.evaluate(() => { const g = window.__GAME__; g.net.queueEv(['i', 60, -320, 5]); });\n  await A.waitForTimeout(500); for (let k = 0; k < 6; k++) await both(30, 300);\n  const fa = await A.evaluate(() => window.__GAME__.world.fire.burning.length + window.__GAME__.world.fire.burntCount), fb = await B.evaluate(() => window.__GAME__.world.fire.burning.length + window.__GAME__.world.fire.burntCount);\n  ok(fa > 0, `host fire ${fa}`); ok(fb > 0, `client sees the fire ${fb}`);\n  // Guest walks to a case and takes it, banks it.\n  const cs = await B.evaluate(() => { const g = window.__GAME__, c = g.net.cases[3]; g.player.teleport(c.x + 1, c.z); g.player.lookAt(c.x, c.y, c.z); return c.i; });\n  await both(30, 400); await B.evaluate((i) => { window.__GAME__.net.queueEv(['p', i]); }, cs); for (let k = 0; k < 3; k++) await both(30, 400);\n  ok(await A.evaluate((i) => window.__GAME__.net.cases[i].carrier === 1, cs), 'host gives the guest the case');\n  ok(await B.evaluate((i) => window.__GAME__.net.cases[i].carrier === 1, cs), 'guest knows it carries the case');\n  await B.evaluate(() => window.__GAME__.player.teleport(152, -225)); for (let k = 0; k < 4; k++) await both(30, 400);\n  const sa = await A.evaluate(() => window.__GAME__.net.P[1].stones), sb = await B.evaluate(() => window.__GAME__.net.P[1].stones); ok(sa > 0, `banked ${sa}`); ok(sa === sb, `same stones on both ${sa} ${sb}`);\n  await A.evaluate(() => window.__GAME__.net.finish()); await A.waitForTimeout(600); await both(10);\n  const ra = await A.evaluate(() => window.__GAME__.ui.top?.id), rb = await B.evaluate(() => window.__GAME__.ui.top?.id); ok(ra === 'results', `host results ${ra}`); ok(rb === 'results', `guest results ${rb}`);\n  ok(!A.errs.length && !B.errs.length, `page errors ${[...A.errs, ...B.errs].slice(0, 2).join('|').slice(0, 300)}`);\n  await ctx.close();\n} catch (x) { fail++; console.log(`FAIL threw ${String(x).slice(0, 500)}`); }\nawait browser.close();\nconsole.log(`${pass} passed, ${fail} failed`);\nEOF\ntimeout 200 node tests/suites/static.mjs 2>&1 | cut -c1-220 | sort | uniq -c | sort -rn | head -16; timeout 360 node tests/suites/systems.mjs 2>&1 | cut -c1-300 | tail -28","description":"Write remaining suites; run static and systems","timeout":570000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":637,"cache_read_input_tokens":617214,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":637},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"b4fcdd5f-0f8b-42d4-891b-8aa39a43c66d","timestamp":"2026-11-06T00:33:19.423Z","request_id":"req_011CgkjK44wcHW64JYUUzhX8","wire_tool_inputs":{"toolu_01U2jpnJvaSVRHpryfhJoakA":{"command":"cat >> ../PROGRESS.md <<'EOF'\nPlaythrough suite passes (269 checks, both endings). Next: suites static, systems, replay, browser, link; full hub; visuals pass; DESIGNERS.md; ABOUT feedback; exit-interview.json.\nEOF\ncat > tests/suites/static.mjs <<'EOF'\n// Nothing here runs the game: it reads the source and the content.\nimport { createHash } from 'node:crypto';\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nimport { execFileSync } from 'node:child_process';\nimport { checkModel, parseSong, renderSound, validateClip, validateTexture, HERO_RIG } from '../../pixel-engine.js';\nimport { CATALOG, grassFlame, WORLD_MODELS } from '../../src/art/models.js';\nimport { VIEWMODELS, handsMap } from '../../src/art/viewmodels.js';\nimport { PEOPLE_CLIPS } from '../../src/art/clips.js';\nimport { SFX_DEFS } from '../../src/audio/sfx.js';\nimport { SONGS } from '../../src/audio/music.js';\nimport { speak, VOICES } from '../../src/audio/voice.js';\nimport { ABOUT } from '../../src/content/about.js';\nimport { BARKS, ENDINGS, EPIGRAPHS, FEVER_LINES, LINES, NOTES, SPEAKERS } from '../../src/content/dialogue.js';\nimport { missionById, MISSIONS } from '../../src/content/missions.js';\nimport { CASES, siteById, SITES, TRIGS } from '../../src/content/sites.js';\nimport { SLIDERS, TUNING_DEFAULTS } from '../../src/content/tuning-defaults.js';\nimport { THROWABLES, UPGRADES, WEAPONS } from '../../src/content/weapons.js';\nimport { SCRIPTS } from '../../src/missions/scripts.js';\nconst root = resolve(import.meta.dirname, '..', '..'); process.chdir(root);\nlet pass = 0, fail = 0; const ok = (c, n) => { if (c) pass++; else { fail++; console.log(`FAIL ${n}`); } };\nconst walk = (d) => readdirSync(d).flatMap((f) => { const p = join(d, f); return statSync(p).isDirectory() ? walk(p) : [p]; });\nfor (const f of walk('src')) {\n  const t = readFileSync(f, 'utf8');\n  ok(!/Math\\.random/.test(t), `${f}: Math.random`);\n  ok(!/\\b(TODO|FIXME|coming soon)\\b/i.test(t), `${f}: TODO text`);\n  ok(!/\\bplaceholder\\b/i.test(t) && !/\\bstub\\b/i.test(t), `${f}: stub word`);\n}\n// Font: A-Z 0-9 space . , : ; ! ? ' \" - + = / ( ) [ ] { } % _ # & * @ < > | \\ ~ ^ $ ` ° · and curly quotes\nconst FONT = /^[A-Za-z0-9 .,:;!?'\"\\-+=/()[\\]{}%_#&*@<>|\\\\~^$`°·\\u2018\\u2019\\u201c\\u201d]*$/;\nconst text = (s, n) => { ok(FONT.test(s), `font: ${n}: ${s}`); };\nfor (const [id, list] of Object.entries(LINES)) for (const [who, t] of list) { text(t, id); ok(SPEAKERS[who], `speaker ${who} in ${id}`); ok(t.length <= 90, `long line ${id}: ${t}`); }\nfor (const [f, set] of Object.entries(BARKS)) for (const [k, l] of Object.entries(set)) for (const t of l) text(t, `${f}.${k}`);\nfor (const t of [...NOTES, ...EPIGRAPHS, ...FEVER_LINES, ...Object.values(ENDINGS)]) text(t, 'notes');\nfor (const m of MISSIONS) { text(m.title, m.id); for (const s of m.steps) { text(s.text, `${m.id}.step`); if (s.label) text(s.label, m.id); } }\nfor (const r of [...ABOUT.source, ...ABOUT.testing, ...ABOUT.engine, ...ABOUT.prompt]) { text(r[0], 'about'); text(r[1], `about ${r[0]}`); }\nfor (const w of Object.values(WEAPONS)) text(w.name, w.id);\nok(BARKS.concord.spotted.length + BARKS.concord.lost.length + BARKS.concord.grenade.length + BARKS.concord.jammed.length + BARKS.concord.fire.length + BARKS.concord.down.length >= 15, '15 barks concord');\nok(BARKS.harvest.spotted.length + BARKS.harvest.lost.length + BARKS.harvest.grenade.length + BARKS.harvest.jammed.length + BARKS.harvest.fire.length + BARKS.harvest.down.length >= 15, '15 barks harvest');\nok(EPIGRAPHS.length === 12, '12 epigraphs'); ok(NOTES.length === 6, '6 notes'); ok(CASES.length === 12, '12 cases'); ok(TRIGS.length === 6, '6 trigs');\n// Models, textures, clips.\nfor (const d of [...WORLD_MODELS, ...VIEWMODELS, handsMap]) { const r = checkModel(d, { catalog: CATALOG }); ok(!r.problems.length, `model ${d.id}: ${r.problems.join('; ').slice(0, 200)}`); }\nok(!validateTexture(grassFlame).problems.length, 'grass-flame');\nfor (const c of PEOPLE_CLIPS) { const r = validateClip(c, HERO_RIG); const bad = Array.isArray(r) ? r.filter((x) => x.level === 'error' || x.severity === 'error') : []; ok(!bad.length, `clip ${c.name}`); }\n// Sound.\nfor (const [n, d] of Object.entries(SFX_DEFS)) { const s = renderSound(d, 8000); ok(s.some((v) => Math.abs(v) > 0.002), `sound silent: ${n}`); }\nconst REQUIRED = ['gun-rifle', 'gun-revolver', 'gun-shotgun', 'gun-bolt', 'jam-click', 'slap', 'rack', 'magazine', 'shell', 'cylinder', 'flare-pop', 'flare-hiss', 'flame-roar', 'bottle-smash', 'rocket', 'explosion', 'ricochet', 'bullet-whip', 'hit-flesh', 'hit-metal', 'fall-apart', 'step-dirt', 'step-grass', 'step-road', 'step-wood', 'step-water', 'breath', 'heartbeat', 'syrette', 'pliers', 'knife', 'finger-snap', 'lighter', 'tablet-bottle', 'grunt', 'fire-loop', 'wind-loop', 'insects-loop', 'birds-loop', 'engine', 'gravel', 'brakes', 'door', 'horn', 'starter', 'wrench', 'train-clack', 'train-whistle', 'map-paper', 'tracker-beep', 'radio', 'thunder', 'rain-loop', 'distant-gunfire', 'ui-move', 'ui-confirm', 'ui-back'];\nfor (const n of REQUIRED) ok(SFX_DEFS[n], `required sound ${n}`);\nok(Object.keys(SONGS).length >= 6, '6 songs');\nfor (const [n, s] of Object.entries(SONGS)) { try { ok(parseSong(s), `song ${n}`); } catch (e) { ok(false, `song ${n}: ${e}`); } }\nfor (const id of Object.keys(VOICES)) { const v = speak(id, 'Sixty-one beds, forty blankets?'); ok(v.list.length > 5 && renderSound(v.list[0].def, 8000).some((x) => Math.abs(x) > 0.01), `voice ${id}`); }\nconst a = speak('odile', 'blankets'), b = speak('odile', 'blankets'); ok(JSON.stringify(a) === JSON.stringify(b), 'a word always sounds the same');\n// Missions resolve.\nfor (const m of MISSIONS) for (const s of [...m.steps, ...(m.alt?.steps ?? [])]) {\n  if (s.site) ok(siteById[s.site], `${m.id} site ${s.site}`);\n  if (s.script) ok(SCRIPTS[s.script], `${m.id} script ${s.script}`);\n  if (s.onDone) ok(SCRIPTS[s.onDone], `${m.id} onDone ${s.onDone}`);\n  if (s.lines) ok(LINES[s.lines], `${m.id} lines ${s.lines}`);\n  if (s.to) ok(SITES.some((x) => x.npcs?.some((n) => n[0] === s.to)), `${m.id} npc ${s.to}`);\n}\nfor (const m of MISSIONS) { if (m.brief) ok(LINES[m.brief], `${m.id} brief`); if (m.alt?.call) ok(LINES[m.alt.call], `${m.id} alt`); for (const r of m.requires) ok(missionById[r], `${m.id} requires ${r}`); }\nfor (const m of ['m0', 'm1', 'm2', 'm3', 'm4', 'm5', 'm6', 'm7', 'm8', 'm9', 'end']) ok(missionById[m], `mission ${m}`);\nfor (const k of Object.keys(TUNING_DEFAULTS)) ok(SLIDERS.some((s) => s.key === k), `tuning ${k} has a slider`);\nok(SLIDERS.length === 20, '20 sliders'); ok(UPGRADES.length === 4, '4 upgrades'); ok(THROWABLES.molotov && THROWABLES.charge, 'throwables');\n// Every About answer is filled in.\nfor (const r of [...ABOUT.testing, ...ABOUT.engine, ...ABOUT.prompt]) ok(r[1] && !/^See /.test(r[1]), `about answer: ${r[0]}`);\n// The engine is byte-identical to the kit.\nconst h = (b2) => createHash('sha1').update(b2).digest('hex');\nconst inZip = execFileSync('unzip', ['-p', 'vendor/pixel-engine.zip', 'pixel-engine/pixel-engine.js'], { maxBuffer: 1 << 28 });\nok(h(inZip) === h(readFileSync('pixel-engine.js')), 'pixel-engine.js byte-identical to the kit');\nconsole.log(`${pass} passed, ${fail} failed`);\nEOF\ncat > tests/suites/systems.mjs <<'EOF'\n// Every system, in Node at many times real speed.\nimport { boot, fakeStorage } from '../lib/boot.mjs';\nimport { Bot } from '../lib/bot.mjs';\nimport { TUNING, resetTuning } from '../../src/core/tuning.js';\nimport { SLIDERS, TUNING_DEFAULTS } from '../../src/content/tuning-defaults.js';\nimport { FireGrid, FIRE_N, fireIndex, BURNT, FRESH, REGROWING } from '../../src/world/fire.js';\nimport { jamChance } from '../../src/combat/weapons.js';\nimport { siteById } from '../../src/content/sites.js';\nimport { THREE } from '../../pixel-engine.js';\nconst store = fakeStorage();\nlet pass = 0, fail = 0; const ok = (c, n) => { if (c) pass++; else { fail++; console.log(`FAIL ${n}`); } };\nclass R { s = 77; next() { this.s = (this.s * 1664525 + 1013904223) >>> 0; return this.s / 4294967296; } range(a, b) { return a + (b - a) * this.next(); } }\n// ---- Fire, on a plain grid ----\n{\n  const g = new FireGrid(new R()); g.fuel.fill(1); g.baseFuel.fill(1); g.wind = { x: 1, z: 0, speed: 5 }; g.ignite(0, 0, 3);\n  for (let k = 0; k < 80; k++) g.tick(0.25, 0);\n  let east = 0, west = 0, north = 0; for (let i = 0; i < g.state.length; i++) if (g.state[i]) { const x = (i % FIRE_N) * 5 - 640, z = Math.floor(i / FIRE_N) * 5 - 640; east = Math.max(east, x); west = Math.min(west, x); north = Math.max(north, z); }\n  const head = east / 20, flank = north / 20, back = -west / 20;\n  ok(head >= 2 && head <= 5, `head of the fire ${head} m/s at 5 m/s of wind`); ok(flank < head, 'flanks slower'); ok(back < flank, 'backing fire slowest');\n  // A road stops it without strong wind.\n  const r = new FireGrid(new R()); r.fuel.fill(1); r.wind = { x: 1, z: 0, speed: 3 }; for (let i = 0; i < FIRE_N; i++) { r.fuel[130 + i * FIRE_N] = 0; r.fuel[131 + i * FIRE_N] = 0; r.fuel[132 + i * FIRE_N] = 0; } r.ignite(5 * 2, 0, 3);\n  for (let k = 0; k < 400; k++) r.tick(0.25, 0);\n  let beyond = 0; for (let i = 0; i < r.state.length; i++) if (r.state[i] && i % FIRE_N > 132) beyond++; ok(beyond === 0, 'a road stops fire below strong wind');\n  const e2 = new FireGrid(new R()); e2.fuel.fill(1); e2.wind = { x: 1, z: 0, speed: 8 }; for (let i = 0; i < FIRE_N; i++) { e2.fuel[130 + i * FIRE_N] = 0; e2.fuel[131 + i * FIRE_N] = 0; } for (let z = -40; z <= 40; z += 5) e2.ignite(0, z, 1); for (let k = 0; k < 600; k++) e2.tick(0.25, 0); let b2 = 0; for (let i = 0; i < e2.state.length; i++) if (e2.state[i] && i % FIRE_N > 131) b2++; ok(b2 > 0, 'embers cross a road in strong wind');\n  // Burnt can't re-burn; regrowth; round trip.\n  const i0 = fireIndex(0, 0), b = new FireGrid(new R()); b.fuel.fill(1); b.baseFuel.fill(1); b.light(i0); for (let k = 0; k < 100; k++) b.tick(0.25, 0); b.wind = { x: 0, z: 0, speed: 0 };\n  const s0 = b.state[i0]; ok(s0 === BURNT, 'cell burnt'); ok(!b.light(i0), 'burnt land cannot burn again');\n  const rle = b.encode(), c = new FireGrid(new R()); c.fuel.fill(1); c.baseFuel.fill(1); c.decode(rle, 0); let same = true; for (let i = 0; i < c.state.length; i++) if (c.state[i] !== b.state[i]) same = false; ok(same && c.burntCount === b.burntCount, 'save round-trip of the grid');\n  b.tick(0.25, TUNING.regrowHours + 1); for (let k = 0; k < 20; k++) b.tick(0.25, TUNING.regrowHours + 1); ok(b.state[i0] === REGROWING, 'regrows after regrowHours'); b.rollRegrowth(); ok(b.state[i0] === FRESH, 'new growth is fuel again');\n}\n// ---- Wear math ----\nok(Math.abs(1 / jamChance(90) - 833) < 60, 'jam 1 in 800 at 90'); ok(Math.abs(1 / jamChance(50) - 33) < 2, 'jam 1 in 33 at 50'); ok(Math.abs(1 / jamChance(30) - 17) < 1, 'jam 1 in 17 at 30');\nconst { e, game: g } = await boot(), b = new Bot(e, g), S = () => g.state(), input = e.input;\nconst play = (m = 'm3') => { g.dev_startMission(m); e.step(2); g.missions.altPending = null; g.prompt.setChoice(null); g.cheats.god = false; };\n// ---- Title, attract, menus ----\ne.step(30);\nok(S().music === 0.1, 'music at 10% on clean storage'); ok(S().screen === 'press', 'press screen');\n{ let f = 0; for (; f < 700 && !S().attract; f++) e.step(1); ok(S().attract, 'attract starts'); ok(Math.abs(f + 30 - 601) <= 1 || f + 30 >= 600, `attract at frame ~601 (${f + 30})`); }\nconst noSave = g.save.exists();\ne.step(120); ok(S().mode === 'attract' && e.errors.length === 0, 'attract runs');\nconst seen = new Set(); for (let f = 0; f < 60 * 12 * 15; f += 60) { e.step(60); seen.add(g.attract.current?.id); } ok(seen.size >= 13, `attract shows all beats (${seen.size})`); ok(e.errors.length === 0, `attract loop clean ${e.errors[0]}`); ok(g.save.exists() === noSave, 'attract leaves saves alone');\nb.key('KeyX'); e.step(2); ok(!S().attract && S().mode === 'title', 'any input exits attract');\ne.step(2); ok(S().screen === 'press', 'back at title');\nfor (let k = 0; k < 2; k++) { for (let f = 0; f < 610 && !S().attract; f++) e.step(1); ok(S().attract, 're-enters attract'); e.step(k ? 1 : 30); if (k) { input.setPointer(0.2, 0.2, true); e.step(1); input.setPointer(0.2, 0.2, false); e.step(2); } else { const pad = { connected: true, mapping: 'standard', axes: [0, 0, 0.9, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })) }; globalThis.navigator = globalThis.navigator ?? {}; const nav = globalThis.navigator; const was = nav.getGamepads; Object.defineProperty(nav, 'getGamepads', { value: () => [pad], configurable: true }); e.step(2); Object.defineProperty(nav, 'getGamepads', { value: was ?? (() => []), configurable: true }); } e.step(2); ok(!S().attract, k ? 'a click exits attract' : 'a stick exits attract'); }\n// Menu by keyboard.\nif (S().screen !== 'main') b.key('Enter'); ok(S().screen === 'main', 'keyboard opens main');\nconst f0 = S().focus; b.key('ArrowDown'); ok(S().focus !== f0, 'arrow moves focus');\n// Menu by mouse hover and click.\nconst top = g.ui.top, r2 = g.ui.rowRect(top, 1), hudH = g.ctx.hud.height, hudW = g.ctx.hud.width; const ndc = (x, y) => [(x / hudW) * 2 - 1, 1 - (y / hudH) * 2];\n{ const [nx, ny] = ndc(100, r2.y + 4); input.setPointer(nx, ny, false); e.step(2); ok(S().focus === 1, 'hover moves focus'); ok(S().device === 'kbm', 'mouse keeps kbm device'); }\n{ const items = g.ui.items(g.ui.top), i = items.findIndex((x) => x.label === 'SETTINGS'), r = g.ui.rowRect(g.ui.top, i), [nx, ny] = ndc(100, r.y + 4); input.setPointer(nx, ny, false); e.step(2); input.setPointer(nx, ny, true); e.step(1); input.setPointer(nx, ny, false); e.step(2); ok(S().screen === 'settings', 'click activates'); }\n// Settings: music slider, persisted; Xbox glyphs; reset to 0.1.\ng.ui.top.focus = 0; b.key('Enter'); ok(S().screen === 'settings-sound', 'sound page'); g.ui.top.focus = 0; b.key('ArrowRight'); ok(Math.abs(g.ctx.audio.volume.music - 0.15) < 0.001, 'music slider moves'); b.key('Escape'); b.key('Escape');\nok(S().screen === 'main', 'esc goes back');\nok(JSON.parse(store.get('far-dry-season-settings')).music > 0.14, 'settings persisted');\ng.resetSettings(); ok(S().music === 0.1, 'settings reset returns music to 10%');\n// Pad flows and glyphs.\nconst padDev = () => { const pad = { connected: true, mapping: 'standard', axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })) }; Object.defineProperty(globalThis.navigator, 'getGamepads', { value: () => [pad], configurable: true }); return pad; };\nconst pad = padDev();\nconst padPress = (i, frames = 2) => { pad.buttons[i] = { pressed: true, value: 1 }; e.step(frames); pad.buttons[i] = { pressed: false, value: 0 }; e.step(2); };\npadPress(13); ok(S().device === 'pad', 'pad button flips device'); const pf = S().focus; padPress(13); ok(S().focus !== pf, 'd-pad moves focus');\ng.ui.top.focus = g.ui.items(g.ui.top).findIndex((x) => x.label === 'SETTINGS'); padPress(0); ok(S().screen === 'settings', 'Cross confirms'); padPress(1); ok(S().screen === 'main', 'Circle goes back');\n// Into play.\nObject.defineProperty(globalThis.navigator, 'getGamepads', { value: () => [], configurable: true });\nplay('m3');\nconst P = g.player, W = g.world;\nb.to(-180, 200); e.step(5);\n// Wear and jams.\n{ const gun = g.combat.current(); gun.cond = 100; const before = gun.cond; g.cheats.noJams = true; g.combat.select('main'); e.step(40); b.look(P.x, P.y - 20, P.z + 40); b.hold('MouseLeft', 0.5); ok(gun.cond < before, 'firing wears the gun'); ok(Math.abs(before - gun.cond - (Math.round((before - gun.cond) / 0.35) * 0.35)) < 0.01, 'wear per shot'); g.cheats.noJams = false;\n  gun.mag = 30; g.dev.forceJam(); ok(gun.jammed, 'jam'); const m0 = gun.mag; b.hold('MouseLeft', 0.3); ok(gun.mag === m0, 'a jam blocks fire'); let n = 0; while (gun.jammed && n++ < 6) { b.key('KeyR', 1); e.step(50); } ok(!gun.jammed && n >= 2 && n <= 4, `reload clears a jam in 2 to 4 presses (${n})`);\n  gun.cond = 0.2; gun.mag = 10; b.look(P.x, P.y - 20, P.z + 40); e.step(5); g.cheats.noJams = true; b.hold('MouseLeft', 0.4); e.step(90); ok(P.guns.main === null, 'gun falls apart at 0'); g.cheats.noJams = false; g.combat.give('tractor', 90, true); e.step(30); }\n// Rust parts.\n{ const rig = g.vm.rigs.tractor; g.vm.setCondition('tractor', 90); ok(!rig.rust.visible && !rig.tape.visible, 'clean gun'); g.vm.setCondition('tractor', 40); ok(rig.rust.visible && !rig.tape.visible, 'rust at 40'); g.vm.setCondition('tractor', 20); ok(rig.tape.visible, 'tape below 30'); g.vm.setCondition('tractor', 90); }\n// Hit zones.\n{ const a = g.actors.spawn({ faction: 'concord', role: 'rifle', x: P.x + 8, z: P.z, duty: 'guard', tag: 'test' }); a.hp = 1000; e.step(3); const hitAt = (y) => { const h0 = a.hp; g.combat.applyHit({ collider: a.ctrl.collider, point: { x: a.x, y, z: a.z } }, 10, P, {}); return h0 - a.hp; }; ok(Math.abs(hitAt(a.y + 1.6) - 25) < 0.01, 'head x2.5'); ok(Math.abs(hitAt(a.y + 0.4) - 7) < 0.01, 'legs x0.7'); ok(Math.abs(hitAt(a.y + 1.1) - 10) < 0.01, 'torso x1'); g.actors.remove(a); }\n// Syrette, surgery.\nP.hp = 50; P.syrettes = 2; e.step(2); b.hold('KeyQ', 1); ok(P.hp >= 90 && P.syrettes === 1, 'syrette +40'); e.step(50);\nP.hp = 15; b.hold('KeyQ', 0.2); ok(P.surgery, 'surgery begins below 20'); const lbl = P.surgery?.scene.label; e.step(60 * 4.2); ok(!P.surgery && P.hp >= 40, 'surgery leaves you at 40'); ok(lbl, 'a scene played');\n{ const seenS = new Set(); for (let k = 0; k < 4; k++) { P.hp = 15; if (k === 3) g.body.lastDamageKind = 'fire'; b.hold('KeyQ', 0.2); seenS.add(P.surgery?.scene.label); e.step(60 * 4.2); } ok(seenS.size >= 4, `all four surgery scenes (${[...seenS]})`); g.body.lastDamageKind = 'bullet'; }\nP.hp = 100; const hit = () => { P.hp = 15; b.hold('KeyQ', 0.2); const was = !!P.surgery; g.damagePlayer(1, {}); return was && !P.surgery; }; ok(hit(), 'a hit interrupts surgery'); P.hp = 100; g.vm.endTool();\n// Regenerates to the segment top only.\nP.hp = 47; g.body.regenT = 6; e.step(240); ok(Math.abs(P.hp - 60) < 0.01, 'regen stops at the segment top');\nP.hp = 100;\n// Burning.\n{ b.to(-180, 200); W.fire.ignite(P.x, P.z, 3); e.step(30); ok(P.burning > 0, 'fire lights you'); const h = P.hp; e.step(30); ok(P.hp < h, 'burning hurts'); P.burning = 0; P.hp = 100; W.fire.extinguish(); e.step(5); }\n// Down without a buddy, down with.\n{ P.hp = 1; g.damagePlayer(50, {}); e.step(2); ok(S().screen === 'game-over', 'down with no friend: game over'); g.ui.clear(); e.step(1); g.ctx.engine.timeScale = 1; P.hp = 100; P.downT = 0; g.audio.setMusic('day');\n  g.buddies.state.ines.met = true; P.hp = 1; g.damagePlayer(50, {}); e.step(5); ok(P.downT > 0 && g.cam.override, 'rescue drags you'); e.step(60 * 7); ok(P.hp >= 40 && !P.downT && !g.cam.override, 'rescue leaves you up at 40'); ok(!g.buddies.ready('ines'), 'the friend is spent'); g.buddies.clear(); g.buddies.state.ines.spentUntil = -1; }\n// Fever.\n{ g.story.feverOn = true; P.tablets = 2; g.body.onset(); ok(g.body.feverActive, 'fever onset'); e.step(90); ok(g.body.fever > 0.3, 'view swims'); ok(S().prompts.some((x) => /TABLET/.test(x)), 'tablet prompt'); b.hold('KeyH', 1.1); ok(!g.body.feverActive && P.tablets === 1, 'tablet clears it'); e.step(60 * 6); ok(g.body.fever < 0.05, 'clears over five seconds');\n  g.body.onset(); P.stones = 50; P.tablets = 0; g.buddies.state.ines.met = false; e.step(60 * 26); ok(!g.body.feverActive && P.stones === 40, 'ignoring it collapses you and costs 20% of your stones'); e.step