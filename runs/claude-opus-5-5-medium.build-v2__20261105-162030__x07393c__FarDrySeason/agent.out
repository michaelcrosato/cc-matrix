{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkg3GHN6fZtwJYrwUNHg","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":29168,"cache_read_input_tokens":367674,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":29168},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"ead61bd2-0fe4-4947-8fa8-f489b3ac7614","timestamp":"2026-11-05T23:47:26.030Z","request_id":"req_011Cgkg3Fg9TfyH8u982E7ht","thinking_duration_ms":1947,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkg3GHN6fZtwJYrwUNHg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015bVAZY5k6sBLmzFsEy8cL5","name":"Bash","input":{"command":"cat > src/actors/player.js <<'EOF'\n// Aster: a capsule, two hands, and no visible body.\nimport { CharacterController, THREE } from '../../pixel-engine.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp } from '../world/geom.js';\nimport { WATER_Y } from '../world/terrain.js';\nconst { Vector3 } = THREE;\nconst moveV = new Vector3(), eye = new Vector3();\nexport class Player {\n  kind = 'player'; faction = 'player'; id = 'me';\n  x = 0; y = 40; z = 0; hp = 100; stamina = 6; crouched = false; walkToggle = false; sprinting = false; ads = false; mapUp = false; vehicle = null; mounted = false; mountGun = null;\n  guns = { melee: null, sidearm: null, main: null, special: null }; slot = 'sidearm';\n  syrettes = 3; tablets = 0; stones = 0; molotovs = 0; charges = 0; planted = []; upgrades = {}; unlocked = {}; items = {}; carrying = null; toolBusy = 0; litT = 0; speed2 = 0;\n  surgery = null; syretteT = 0; tabletT = 0; holdT = 0; downT = 0; landDip = 0; crouchDip = 0; airborne = 0; fallFrom = 0; bleeding = 0; burning = 0; burnClear = 0; stepT = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.ctx = ctx;\n    this.ctrl = new CharacterController(ctx.physics, { position: [0, 60, 0], radius: 0.32, halfHeight: 0.56, speed: 5.4, jumpSpeed: 8, gravity: -24 });\n    ctx.physics.tag(this.ctrl.collider, 'player');\n    this.game.world.own(this.ctrl.collider, 'player', this);\n  }\n  teleport(x, z, yFeet) {\n    const y = yFeet ?? this.game.world.land.heightAt(x, z) + 0.1;\n    if (this.vehicle) this.game.vehicles.exit(true);\n    this.ctrl.teleport([x, y, z]); this.ctrl.velocity.set(0, 0, 0);\n    this.x = x; this.y = y; this.z = z; this.game.grounded = false; this.game.world.focusX = x; this.game.world.focusZ = z;\n    this.prevY = y;\n  }\n  setYaw(yaw, pitch = 0) { this.ctx.camera.yaw = yaw; this.ctx.camera.pitch = pitch; }\n  lookAt(x, y, z) { const e = this.eyeNow(), dx = x - e.x, dz = z - e.z; this.setYaw(Math.atan2(-dx, -dz), Math.atan2(y - e.y, Math.hypot(dx, dz))); }\n  canMove() { const g = this.game; return !g.frozen && !this.surgery && !this.downT && !g.talk.locksPlayer(); }\n  canAct() { const g = this.game; return this.canMove() && !g.ui.top; }\n  eyeNow() {\n    if (this.vehicle && !this.mounted) { const v = this.vehicle; return v.seatWorld(eye); }\n    if (this.mounted && this.vehicle) return this.vehicle.gunWorld(eye);\n    if (this.mounted && this.railGun) return eye.copy(this.railGun);\n    return eye.set(this.x, this.y + (this.crouched ? 0.95 : 1.55), this.z);\n  }\n  fixed(dt) {\n    const game = this.game, input = this.ctx.input;\n    this.toolBusy = Math.max(0, this.toolBusy - dt); this.litT = Math.max(0, this.litT - dt); this.landDip *= 0.9;\n    if (game.cheats.noclip && !this.vehicle) { this.noclipMove(dt); return; }\n    if (this.vehicle || this.mounted) { this.x = this.vehicle ? this.vehicle.x : this.x; this.z = this.vehicle ? this.vehicle.z : this.z; if (this.vehicle) this.y = this.vehicle.y; return; }\n    if (this.riding) { this.x = this.riding.x; this.y = this.riding.y; this.z = this.riding.z; return; }\n    const canMove = this.canMove() && !game.ui.top;\n    const axis = canMove ? input.moveAxis() : { x: 0, y: 0 };\n    const tilt = clamp(Math.hypot(axis.x, axis.y), 0, 1);\n    if (canMove && input.consumeAny(['CapsLock'])) this.walkToggle = !this.walkToggle;\n    if (canMove && pressedFixed(input, 'crouch')) { this.crouched = !this.crouched; game.audio.play('cloth', { volume: 0.4 }); }\n    // Speed.\n    const deep = game.world.land.waterDepth(this.x, this.z) > 0.25;\n    const sprintHeld = held(input, 'sprint');\n    const forward = axis.y > 0.3;\n    if (sprintHeld && canMove && forward && !this.crouched && !deep && !this.carrying && this.stamina > 0.1 && !this.mapUp) { this.sprinting = true; this.stamina = Math.max(0, this.stamina - dt); } else { this.sprinting = false; this.stamina = Math.min(6, this.stamina + (dt * 6) / 8); }\n    if (this.stamina <= 0.1) this.exhausted = true; if (this.stamina > 1.5) this.exhausted = false;\n    if (this.exhausted) this.sprinting = false;\n    const walking = this.walkToggle || (game.device === 'pad' && tilt < 0.55);\n    let sp = this.sprinting ? 7.4 : walking ? 3.6 : 5.4;\n    if (this.crouched) sp = 2;\n    if (deep) sp = Math.min(sp, 2.7);\n    if (this.carrying) sp *= 0.85;\n    if (this.ads) sp = Math.min(sp, 3);\n    sp *= TUNING.playerSpeed;\n    this.ctrl.speed = sp;\n    const basisYaw = this.ctx.camera.yaw;\n    const fx = -Math.sin(basisYaw), fz = -Math.cos(basisYaw), rx = -fz, rz = fx;\n    moveV.set(rx * axis.x + fx * axis.y, 0, rz * axis.x + fz * axis.y);\n    if (moveV.lengthSq() > 1) moveV.normalize();\n    const jump = canMove && !this.crouched && pressedFixed(input, 'jump') && !game.prompt.jumpBlocked();\n    this.ctrl.setInput(moveV, jump, held(input, 'jump'));\n    if (jump && this.ctrl.grounded) game.audio.play('cloth', { volume: 0.5 });\n    const wasGrounded = this.ctrl.grounded, vy = this.ctrl.velocity.y;\n    this.ctrl.fixedUpdate(dt);\n    const f = this.ctrl.feet;\n    this.speed2 = Math.hypot(f.x - this.x, f.z - this.z) / dt;\n    this.x = f.x; this.y = f.y; this.z = f.z;\n    if (!this.ctrl.grounded) this.fallPeak = Math.max(this.fallPeak ?? f.y, f.y);\n    if (this.ctrl.grounded && !wasGrounded) {\n      const fell = (this.fallPeak ?? f.y) - f.y; this.fallPeak = undefined;\n      this.landDip = Math.min(0.12, -vy * 0.008);\n      if (fell > 6 && !game.cheats.god) { game.damagePlayer((fell - 6) * 8, { fall: true }); game.audio.play('grunt'); }\n      if (fell > 0.5) game.audio.play('step-dirt', { volume: 0.5 });\n    }\n    // Steps, by surface.\n    if (this.ctrl.grounded && this.speed2 > 1) {\n      this.stepT -= dt * this.speed2;\n      if (this.stepT <= 0) {\n        this.stepT = 2.6;\n        const k = game.world.land.kindAt(this.x, this.z);\n        const name = deep ? 'step-water' : k === 7 || k === 1 ? 'step-road' : k === 0 || k === 5 || k === 8 ? 'step-grass' : 'step-dirt';\n        game.audio.play(name, { volume: this.crouched || walking ? 0.2 : 0.45, pitch: game.combat.tracerRng.range(-1, 1) });\n        const noise = this.sprinting ? 40 : !this.crouched && !walking ? 25 : 0;\n        if (noise && game.world.stepCount % 4 === 0) game.actors.hearShot(this.x, this.z, noise * 0.5, null);\n      }\n    }\n    this.crouchDip += ((this.crouched ? -0.03 : 0) - this.crouchDip) * 0.2;\n  }\n  noclipMove(dt) {\n    const input = this.ctx.input, axis = input.moveAxis(), yaw = this.ctx.camera.yaw, p = this.ctx.camera.pitch, sp = held(input, 'sprint') ? 60 : 22;\n    const fx = -Math.sin(yaw), fz = -Math.cos(yaw);\n    this.x += (fx * axis.y - fz * axis.x * -1 * -1) * sp * dt; this.z += (fz * axis.y + fx * axis.x) * sp * dt; this.y += Math.sin(p) * axis.y * sp * dt;\n    this.ctrl.teleport([this.x, this.y, this.z]);\n  }\n  catchFire() { if (this.burning <= 0 && !this.game.cheats.god) { this.burning = 1; this.burnClear = 0; this.game.audio.play('grunt'); this.game.events.emit('caughtFire'); } }\n}\nexport { WATER_Y };\nEOF\ncat > src/body/health.js <<'EOF'\n// The body: health segments, syrettes, field surgery, burns, going down, and blackwater fever (section 9).\nimport { TUNING } from '../core/tuning.js';\nimport { FEVER_LINES, LOSS_LINES } from '../content/dialogue.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { clamp } from '../world/geom.js';\nconst SCENES = [\n  { clip: 'SurgeryPliers', items: ['tool-pliers', 'prop-forearm'], sounds: [[0.6, 'pliers'], [1.7, 'pliers'], [2.3, 'knife'], [2.5, 'grunt']], blood: [2.3], label: 'PLIERS' },\n  { clip: 'SurgeryKnife', items: ['tool-knife', 'prop-thigh'], sounds: [[0.8, 'knife'], [1.6, 'grunt'], [2.2, 'knife']], blood: [1.4, 2.2], label: 'KNIFE' },\n  { clip: 'SurgeryFinger', items: [], sounds: [[1.9, 'finger-snap'], [2.1, 'grunt']], blood: [], label: 'FINGER' },\n  { clip: 'SurgeryLighter', items: ['tool-lighter', 'prop-burn'], sounds: [[0.3, 'lighter'], [1.2, 'hiss'], [2.2, 'grunt']], blood: [], label: 'LIGHTER' },\n];\nexport class Body {\n  segments = 5; regenT = 0; lastDamageKind = 'bullet'; heartVoice = null;\n  fever = 0; feverActive = false; feverT = 0; feverIgnored = 0; feverNext = 720; feverClear = 0; attacks = 0; tabletHold = 0; syretteHold = 0; surgeryN = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('body'); this.resetFever(); }\n  get p() { return this.game.player; }\n  resetFever() { this.feverActive = false; this.fever = 0; this.feverNext = this.nextInterval(); this.feverIgnored = 0; }\n  nextInterval() { const act = this.game.story?.act ?? 1; return Math.max(1, TUNING.feverMinutes - (act - 1) + this.rng.range(-2, 2)) * 60; }\n  /** The segment top: health regenerates only to here. */\n  segmentTop() { const hp = this.p.hp; return Math.min(100, Math.ceil(hp / 20 - 1e-6) * 20); }\n  fixed(dt) {\n    const p = this.p, game = this.game, input = this.ctx.input;\n    if (game.mode !== 'play' && game.mode !== 'round' && game.mode !== 'attract') return;\n    this.regenT += dt;\n    if (!p.surgery && !p.downT && this.regenT > 5 && p.hp > 0 && p.hp < this.segmentTop()) p.hp = Math.min(this.segmentTop(), p.hp + dt * 8);\n    // Burns.\n    const inFire = game.world.fire.isBurning(p.x, p.z);\n    if (inFire && !p.vehicle && !game.cheats.god) p.catchFire();\n    if (p.burning > 0) {\n      p.burnClear = inFire ? 0 : p.burnClear + dt;\n      if (p.burnClear > 2 || game.world.land.waterDepth(p.x, p.z) > 0.25 || game.cheats.god) { p.burning = 0; }\n      else { game.damagePlayer(TUNING.fireDamage * dt, { fire: true }); }\n    }\n    // Scene of surgery.\n    if (p.surgery) {\n      const s = p.surgery; s.t += dt;\n      for (const [at, name] of s.scene.sounds) if (!s.played?.[at] && s.t >= at) { (s.played ??= {})[at] = 1; game.audio.play(name); if (name === 'grunt') this.ctx.engine.shake.add(0.15); }\n      for (const at of s.scene.blood) if (!s.bled?.[at] && s.t >= at) { (s.bled ??= {})[at] = 1; const e = p.eyeNow(); this.ctx.particles.burst('blood', [e.x, e.y - 0.5, e.z], { count: 12 }); game.flashBlood = 0.4; }\n      if (s.t >= 4) { p.surgery = null; p.hp = Math.max(p.hp, 40); game.vm.endTool(); this.regenT = 0; game.hud.touch(); game.events.emit('surgeryDone', s.scene.label); }\n      return;\n    }\n    if (!p.canAct() || game.gunSlungOnlyLocked?.()) { this.feverTick(dt); return; }\n    // Syrette or surgery.\n    if (held(input, 'heal') && !game.ui.top) {\n      if (p.hp < 20 && !p.vehicle) { this.startSurgery(); input.clearQueued('PadL1', 'KeyQ'); }\n      else if (p.syrettes > 0 && p.hp < 100 && !p.vehicle) {\n        if (this.syretteHold === 0) { game.vm.playTool('Syrette', ['tool-syrette']); game.audio.play('cloth', { volume: 0.4 }); }\n        this.syretteHold += dt;\n        if (this.syretteHold >= 0.8) { this.syretteHold = -1e9; p.syrettes--; p.hp = Math.min(100, p.hp + 40); game.audio.play('syrette'); this.regenT = 0; game.hud.touch(); game.events.emit('syrette'); }\n      }\n    } else { if (this.syretteHold > 0 && this.syretteHold < 0.8) game.vm.endTool(); this.syretteHold = 0; }\n    // Tablet.\n    if (held(input, 'tablet') && !game.ui.top && p.tablets > 0) {\n      if (this.tabletHold === 0) { game.vm.playTool('Tablet', ['tool-tablets', 'tool-tablet']); game.audio.play('tablet-bottle'); }\n      this.tabletHold += dt;\n      if (this.tabletHold >= 1 && this.tabletHold < 1e6) { this.tabletHold = 1e7; this.takeTablet(); }\n    } else { if (this.tabletHold > 0 && this.tabletHold < 1) game.vm.endTool(); this.tabletHold = 0; }\n    this.feverTick(dt);\n    void pressedFixed;\n  }\n  takeTablet() { const p = this.p, game = this.game; if (p.tablets <= 0) return false; p.tablets--; this.feverClear = 5; this.feverActive = false; this.feverNext = this.nextInterval(); this.feverIgnored = 0; game.hud.touch(); game.audio.play('tablet-bottle'); game.events.emit('tablet'); return true; }\n  startSurgery() {\n    const p = this.p, game = this.game, idx = this.lastDamageKind === 'fire' ? 3 : (this.surgeryN++ % 3), scene = SCENES[idx];\n    p.surgery = { t: 0, scene };\n    game.vm.playTool(scene.clip, scene.items);\n    game.events.emit('surgeryStart', scene.label);\n  }\n  feverTick(dt) {\n    const game = this.game, p = this.p;\n    if (game.mode === 'round') return;\n    if (game.cheats.noFever && !game.attract?.active) { this.fever = 0; this.feverActive = false; return; }\n    if (this.feverClear > 0) { this.feverClear -= dt; this.fever = Math.max(0, this.fever - dt / 5); }\n    if (!game.story?.feverOn) return;\n    if (this.feverActive) {\n      this.fever = clamp(this.fever + dt / 3, 0, 1);\n      this.feverIgnored += dt;\n      if (this.feverIgnored > 25 && !game.attract?.active) this.collapse();\n    } else if (this.feverClear <= 0) {\n      this.feverNext -= dt;\n      if (this.feverNext <= 0) this.onset();\n    }\n    void p;\n  }\n  onset() {\n    const game = this.game;\n    this.feverActive = true; this.feverIgnored = 0; this.attacks++;\n    game.talk.say('you', this.rng.pick(FEVER_LINES), 5);\n    game.audio.play('heartbeat');\n    game.events.emit('fever');\n  }\n  collapse() {\n    const game = this.game, p = this.p;\n    this.feverActive = false; this.fever = 0; this.feverNext = this.nextInterval();\n    const loss = Math.floor(p.stones * 0.2); p.stones -= loss;\n    game.events.emit('collapse', loss);\n    game.blackout('YOU WAKE SOME HOURS LATER, LIGHTER BY ' + loss + ' STONES.', () => {\n      game.world.advanceHours(6);\n      const near = game.nearestRecovery();\n      p.teleport(near[0], near[1]);\n      p.hp = Math.max(p.hp, 50);\n      if (game.buddies.available()) game.talk.playLines('buddy.carry'); else game.talk.playLines('fever.collapse');\n    });\n  }\n  /** Reaching zero. A friend comes, or the paperwork does. */\n  down() {\n    const game = this.game, p = this.p;\n    if (p.downT || game.mode === 'attract') return;\n    game.events.emit('playerDown');\n    if (game.mode === 'round') return;\n    game.combat.stopStream();\n    const buddy = game.buddies.rescuer();\n    if (buddy) { game.buddies.rescue(buddy); return; }\n    game.gameOver(LOSS_LINES.died);\n  }\n  update(dt) {\n    const p = this.p, game = this.game;\n    const dying = p.hp < 20 && p.hp > 0 && game.mode === 'play';\n    if (dying !== this.dying) this.dying = dying;\n    this.beatT = (this.beatT ?? 0) - dt;\n    if ((dying || this.feverActive) && this.beatT <= 0) { game.audio.play('heartbeat', { volume: dying ? 0.8 : 0.5 }); this.beatT = dying ? 0.8 : 1.15; }\n    void clamp;\n  }\n}\nEOF\ncat > src/vehicles/vehicle.js <<'EOF'\n// Trucks that die. Three bodies on the engine's Vehicle, a train on rails.\nimport { buildModel, setLookLayer, THREE, Vehicle } from '../../pixel-engine.js';\nimport { CATALOG, WRECK_PAL } from '../art/models.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { RAILWAY, ROADS } from '../content/roads.js';\nimport { TUNING } from '../core/tuning.js';\nimport { angleDiff, clamp, polyLength, polyPoint } from '../world/geom.js';\nconst { Quaternion, Vector3 } = THREE;\nconst P = new Vector3(), R = new Quaternion(), T = new Vector3();\nconst TYPES = {\n  pickup: { model: 'pickup', size: [0.95, 0.45, 2.2], mass: 12, power: 160, topK: 1, seat: [0.42, 0.95, 0.1] },\n  technical: { model: 'technical', size: [0.95, 0.45, 2.2], mass: 13, power: 160, topK: 0.95, seat: [0.42, 0.95, 0.1], gun: [0, 1.75, -1.5] },\n  'cargo-truck': { model: 'cargo-truck', size: [1.05, 0.6, 2.9], mass: 20, power: 220, topK: 0.72, seat: [0.42, 1.2, 0.2], wheelR: 0.5 },\n  tanker: { model: 'tanker', size: [1.05, 0.6, 2.9], mass: 24, power: 240, topK: 0.68, seat: [0.42, 1.2, 0.2], wheelR: 0.5 },\n};\nexport class GameVehicle {\n  hp = 100; seated = false; stalled = false; onFire = 0; cough = 0; aiRoad = null; aiS = 0; repairT = 0; dead = false; driverless = 0;\n  constructor(game, ctx, type, x, z, yaw, tag) {\n    this.game = game; this.ctx = ctx; this.type = type; this.tag = tag ?? null;\n    const t = TYPES[type]; this.t = t;\n    const y = game.world.land.heightAt(x, z) + 1.4;\n    this.v = new Vehicle(ctx.physics, { at: [x, y, z], yaw, size: t.size, mass: t.mass, power: t.power, topSpeed: TUNING.vehicleTopSpeed * t.topK, wheelRadius: t.wheelR ?? 0.42, suspension: 0.45, stiffness: 30, grip: 2.6 });\n    this.x = x; this.y = y; this.z = z; this.yaw = yaw;\n    const b = buildModel(t.model, { catalog: CATALOG });\n    this.object = b.object; setLookLayer(this.object, 'actors');\n    this.object.traverse((o) => { if (o.isMesh) o.frustumCulled = false; });\n    ctx.scene.add(this.object); ctx.physics.bind(this.v.body, this.object);\n    this.gunNode = this.object.getObjectByName('Gun');\n    this.wheels = [0, 1, 2, 3].map(() => { const w = buildModel('wheel', { catalog: CATALOG, params: {} }); if (t.wheelR) w.object.scale.setScalar(t.wheelR / 0.42); this.object.add(w.object); return w.object; });\n    for (let i = 0; i < this.v.body.numColliders(); i++) game.world.own(this.v.body.collider(i), 'vehicle', this);\n    this.body = this.v.body;\n    this.engineVoice = null;\n  }\n  fixed(dt, input = null) {\n    const t = this.v.body.translation(); this.x = t.x; this.y = t.y; this.z = t.z; this.yaw = this.v.yaw;\n    this.v.o.topSpeed = TUNING.vehicleTopSpeed * this.t.topK;\n    if (this.game.world.fire.isBurning(this.x, this.z)) this.damage(6 * dt);\n    if (this.onFire > 0) { this.onFire -= dt; if (this.onFire <= 0 && !this.dead) this.explode(); }\n    this.cough = Math.max(0, this.cough - dt);\n    let drive = input ?? { throttle: 0, steer: 0, handbrake: !this.seated && !this.aiRoad };\n    const deep = this.game.world.land.waterDepth(this.x, this.z) > 0.45;\n    let k = 1;\n    if (this.hp < 35) k *= 0.6;\n    if (this.cough > 0 && Math.sin(this.cough * 30) > 0.2) k *= 0.1;\n    if (deep) k *= 0.08;\n    if (this.stalled || this.dead) k = 0;\n    this.v.drive({ ...drive, throttle: drive.throttle * k, brake: drive.brake || (this.stalled && !this.seated) }, dt);\n    // Collisions over 8 m/s hurt.\n    const sp = Math.abs(this.v.speed);\n    if ((this.lastSp ?? 0) - sp > 8) { this.damage(((this.lastSp - sp) - 8) * 6); this.game.audio.at('hit-metal', this.x, this.y, this.z, 40); this.ctx.engine.shake.add(this.seated ? 0.5 : 0); }\n    this.lastSp = sp;\n  }\n  damage(n, by, blast) {\n    if (this.dead) return;\n    const g = this.game;\n    this.hp -= n / TUNING.vehicleToughness;\n    if (this.seated) g.hud.touch();\n    if (this.hp < 10 && this.hp > -999 && this.onFire <= 0 && !this.dead) { this.onFire = 8; if (this.seated) g.talk.say('you', 'SHE IS ON FIRE. GET OUT.', 3); }\n    if (this.hp <= 0 && blast) this.explode(by);\n    else if (this.hp <= 0 && !this.stalled) { this.stalled = true; this.hp = 0; g.audio.at('stall', this.x, this.y, this.z, 50); g.events.emit('stalled', this); }\n  }\n  explode(by) {\n    if (this.dead) return; this.dead = true; this.hp = 0; this.stalled = true; this.onFire = 0;\n    const g = this.game;\n    g.events.emit('vehicleDestroyed', this, by);\n    if (this.seated) g.vehicles.exit(true);\n    g.combat.explode(this.x, this.y + 0.5, this.z, 8, 90, by, { fire: 8, big: true });\n    this.wreck();\n  }\n  wreck() { const b = buildModel(this.t.model, { catalog: CATALOG, palette: WRECK_PAL }); this.ctx.physics.unbind(this.object); const at = this.object.position.clone(), q = this.object.quaternion.clone(); for (const w of this.wheels) this.object.remove(w); this.ctx.scene.remove(this.object); this.object = b.object; this.object.position.copy(at); this.object.quaternion.copy(q); setLookLayer(this.object, 'actors'); this.ctx.scene.add(this.object); this.ctx.physics.bind(this.v.body, this.object); }\n  update(dt) {\n    for (let i = 0; i < 4; i++) { this.v.wheelPose(i, P, R, true); this.wheels[i].position.copy(P); this.wheels[i].quaternion.copy(R); }\n    if (this.hp < 35 && !this.dead && this.game.world.look.next() < dt * 8) this.ctx.particles.burst('fire-smoke', [this.x + Math.sin(this.yaw) * 1.5, this.y + 0.8, this.z + Math.cos(this.yaw) * 1.5], { count: 1 });\n    if (this.onFire > 0 && this.game.world.look.next() < dt * 30) this.ctx.particles.burst('ember', [this.x + Math.sin(this.yaw) * 1.5, this.y + 0.8, this.z + Math.cos(this.yaw) * 1.5]);\n    if (this.dead && this.game.world.look.next() < dt * 3) this.ctx.particles.burst('fire-smoke', [this.x, this.y + 1, this.z], { count: 1 });\n    if (this.gunNode && this.game.player.mounted && this.seated) { const q = this.object.quaternion, yaw = this.ctx.camera.yaw; void q; this.gunNode.rotation.set(-this.ctx.camera.pitch, yaw - this.yaw + Math.PI, 0); }\n  }\n  seatWorld(out) { out.set(...this.t.seat).applyQuaternion(this.object.quaternion); out.add(this.object.position); return out; }\n  gunWorld(out) { out.set(...(this.t.gun ?? this.t.seat)).applyQuaternion(this.object.quaternion); out.add(this.object.position); return out; }\n  bonnet() { return [this.x + Math.sin(this.yaw) * (this.t.size[2] + 0.9), this.z + Math.cos(this.yaw) * (this.t.size[2] + 0.9)]; }\n  door() { const a = this.yaw + Math.PI / 2; return [this.x + Math.sin(a) * 1.8, this.z + Math.cos(a) * 1.8]; }\n  dispose() {\n    for (let i = 0; i < this.v.body.numColliders(); i++) this.game.world.owners.delete(this.v.body.collider(i).handle);\n    this.ctx.physics.unbind(this.object); this.ctx.scene.remove(this.object); this.v.dispose(); this.ctx.physics.remove(this.v.body);\n  }\n}\nexport class Vehicles {\n  list = []; chase = false; repairing = null; stationary = [];\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('veh'); }\n  spawn(type, x, z, yaw = 0, tag) { const v = new GameVehicle(this.game, this.ctx, type, x, z, yaw, tag); this.list.push(v); return v; }\n  remove(v) { if (v.seated) this.exit(true); v.dispose(); this.list.splice(this.list.indexOf(v), 1); }\n  clear() { for (const v of [...this.list]) this.remove(v); }\n  enter(v) {\n    const g = this.game, p = g.player;\n    if (v.dead) return;\n    v.seated = true; p.vehicle = v; p.mounted = false; p.ads = false;\n    p.ctrl.collider.setEnabled(false); p.ctrl.body.setEnabled?.(false);\n    g.audio.play('door');\n    g.audio.play('starter', { volume: 0.7 }); v.cough = 0.6;\n    g.events.emit('enterVehicle', v);\n    g.vm.allHidden = true; this.relYaw = 0; this.lastYaw = v.yaw;\n    this.engine ??= g.audio.loopSfx('engine', 0);\n  }\n  exit(force) {\n    const g = this.game, p = g.player, v = p.vehicle; if (!v) return;\n    v.seated = false; p.vehicle = null; p.mounted = false; p.mountGun = null; this.chase = false; g.cam.override = null;\n    p.ctrl.body.setEnabled?.(true); p.ctrl.collider.setEnabled(true);\n    const [dx, dz] = v.door();\n    const y = g.world.land.heightAt(dx, dz) + 0.15;\n    p.ctrl.teleport([dx, Math.max(y, v.y), dz]); p.x = dx; p.z = dz; p.y = Math.max(y, v.y);\n    g.vm.allHidden = false; g.vm.show(p.guns[p.slot]?.id ?? 'cane');\n    g.audio.play('door');\n    if (this.engine) this.engine.set({ volume: 0 });\n    g.events.emit('exitVehicle', v); void force;\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player, input = this.ctx.input;\n    for (const v of this.list) {\n      if (v === p.vehicle) continue;\n      if (v.aiRoad && !v.dead) v.fixed(dt, this.aiDrive(v, dt));\n      else v.fixed(dt);\n    }\n    const v = p.vehicle; if (!v) return;\n    let throttle = 0, steer = 0, handbrake = false;\n    if (!g.ui.top && !g.talk.locksPlayer() && !p.mounted) {\n      const axis = input.moveAxis(); steer = g.device === 'pad' ? axis.x : (input.isDown('KeyD', 'ArrowRight') ? 1 : 0) - (input.isDown('KeyA', 'ArrowLeft') ? 1 : 0);\n      const r2 = g.analog[1] > 0.02 ? g.analog[1] : held(input, 'gas') ? 1 : 0, l2 = g.analog[0] > 0.02 ? g.analog[0] : held(input, 'brake') ? 1 : 0;\n      throttle = r2 - l2; handbrake = held(input, 'handbrake');\n      if (pressedFixed(input, 'chase')) { this.chase = !this.chase; if (!this.chase) g.cam.override = null; }\n      if (!p.mapUp && pressedFixed(input, 'exit') && !g.prompt.has()) { this.exit(); return; }\n      if (pressedFixed(input, 'swap') && v.t.gun) this.mount(v);\n    } else if (p.mounted && !g.ui.top) {\n      if (pressedFixed(input, 'swap') || pressedFixed(input, 'exit')) this.dismount(v);\n    }\n    v.fixed(dt, { throttle, steer, handbrake });\n    // Keep the view turning with the truck.\n    const dy = angleDiff(v.yaw, this.lastYaw ?? v.yaw); this.lastYaw = v.yaw; this.ctx.camera.yaw += dy;\n    p.speed2 = Math.abs(v.v.speed);\n    if (this.engine) this.engine.set({ volume: v.stalled ? 0 : 0.35 * g.sfxK(), pitch: clamp(Math.abs(v.v.speed) * 0.5 - 2, -4, 12) });\n  }\n  mount(v) { const p = this.game.player; p.mounted = true; p.mountGun = { id: 'mg', cond: 100, mag: 999, reserve: 0, jammed: false }; this.game.vm.allHidden = false; this.game.vm.show('mg'); this.game.audio.play('rack'); this.game.mountedTracerFire = true; void v; }\n  dismount(v) { const p = this.game.player; p.mounted = false; p.mountGun = null; this.game.vm.allHidden = true; this.game.mountedTracerFire = false; void v; }\n  aiDrive(v, dt) {\n    const pts = v.aiRoad, L = v.aiLen ??= polyLength(pts);\n    // A PD steering controller along the polyline.\n    const ahead = polyPoint(pts, Math.min(L, (v.aiS ?? 0) + 12));\n    let nearest = v.aiS ?? 0; for (let s = nearest; s < nearest + 24; s += 2) { const q = polyPoint(pts, Math.min(L, s)); if (Math.hypot(q.x - v.x, q.z - v.z) < Math.hypot(polyPoint(pts, Math.min(L, nearest)).x - v.x, polyPoint(pts, Math.min(L, nearest)).z - v.z)) nearest = s; }\n    v.aiS = nearest;\n    const want = Math.atan2(ahead.x - v.x, ahead.z - v.z), err = angleDiff(want, v.yaw);\n    const steer = clamp(-err * 1.6, -1, 1);\n    const speedGoal = v.aiSpeed ?? 12, throttle = clamp((speedGoal - v.v.speed) * 0.4, -0.3, 1);\n    if (v.aiLoop && nearest > L - 14) v.aiS = 0;\n    else if (!v.aiLoop && nearest > L - 6) { v.aiRoad = null; v.onRoadEnd?.(); }\n    void dt; return { throttle, steer, handbrake: false };\n  }\n  update(dt) {\n    const g = this.game, p = g.player;\n    for (const v of this.list) v.update(dt);\n    const v = p.vehicle;\n    if (v && this.chase && !p.mapUp) {\n      const fx = Math.sin(v.yaw), fz = Math.cos(v.yaw);\n      g.cam.override = { position: [v.x - fx * 8, v.y + 3.4, v.z - fz * 8], target: [v.x + fx * 4, v.y + 1, v.z + fz * 4] };\n    }\n  }\n}\n// ----- The goods train -----\nexport class Train {\n  s = 900; speed = 0; goal = null; riding = false; x = 0; y = 40; z = 0; yaw = 0; visible = true; cars = [];\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.ctx = ctx; const g = this.game;\n    this.L = polyLength(RAILWAY);\n    const mk = (id, off) => { const b = buildModel(id, { catalog: CATALOG }); setLookLayer(b.object, 'actors'); b.object.traverse((o) => { if (o.isMesh) o.frustumCulled = false; }); ctx.scene.add(b.object); return { object: b.object, off, id }; };\n    this.cars = [mk('locomotive', 0), mk('flatcar', -11), mk('boxcar', -20), mk('flatcar', -29)];\n    this.gunMount = buildModel('rifle-npc', { catalog: CATALOG }).object;\n    this.place();\n    void g;\n  }\n  place() {\n    const g = this.game, q = {};\n    for (const c of this.cars) { polyPoint(RAILWAY, clamp(this.s + c.off, 0, this.L), q); const y = g.world.railY(q.x, q.z) + 0.18; c.object.position.set(q.x, y, q.z); c.object.rotation.y = q.yaw; c.x = q.x; c.y = y; c.z = q.z; c.yaw = q.yaw; }\n    const head = this.cars[0]; this.x = head.x; this.y = head.y; this.z = head.z; this.yaw = head.yaw;\n  }\n  /** Where a rider stands on a flatcar (world). */\n  riderPos(out) { const c = this.cars[1]; out.set(c.x, c.y + 1.3 + 1.55, c.z); return out; }\n  sToward(x, z) { let best = 0, bd = 1e9; const q = {}; for (let s = 0; s < this.L; s += 5) { polyPoint(RAILWAY, s, q); const d = Math.hypot(q.x - x, q.z - z); if (d < bd) { bd = d; best = s; } } return best; }\n  setAt(x, z) { this.s = this.sToward(x, z); this.speed = 0; this.goal = null; this.place(); }\n  fixed(dt) {\n    if (this.goal !== null) { const d = this.goal - this.s, stop = Math.abs(d) < 4; const want = stop ? 0 : Math.sign(d) * Math.min(this.topSpeed ?? 13, Math.abs(d) * 0.4 + 2); this.speed += clamp(want - this.speed, -5 * dt, 5 * dt); if (stop) { this.speed = 0; this.goal = null; this.game.events.emit('trainStopped'); } }\n    if (this.speed) { this.s = clamp(this.s + this.speed * dt, 12, this.L - 2); this.place(); this.clack = (this.clack ?? 0) - Math.abs(this.speed) * dt; if (this.clack <= 0) { this.clack = 9; this.game.audio.at('train-clack', this.x, this.y + 1, this.z, 180); } }\n  }\n}\nvoid ROADS; void T;\nEOF\necho ok","description":"Write player, body, vehicles and train"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":29168,"cache_read_input_tokens":367674,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":29168},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"6398f803-106a-4cb9-b257-0bbd1fd28911","timestamp":"2026-11-05T23:49:11.229Z","request_id":"req_011Cgkg3Fg9TfyH8u982E7ht","wire_tool_inputs":{"toolu_015bVAZY5k6sBLmzFsEy8cL5":{"command":"cat > src/actors/player.js <<'EOF'\n// Aster: a capsule, two hands, and no visible body.\nimport { CharacterController, THREE } from '../../pixel-engine.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp } from '../world/geom.js';\nimport { WATER_Y } from '../world/terrain.js';\nconst { Vector3 } = THREE;\nconst moveV = new Vector3(), eye = new Vector3();\nexport class Player {\n  kind = 'player'; faction = 'player'; id = 'me';\n  x = 0; y = 40; z = 0; hp = 100; stamina = 6; crouched = false; walkToggle = false; sprinting = false; ads = false; mapUp = false; vehicle = null; mounted = false; mountGun = null;\n  guns = { melee: null, sidearm: null, main: null, special: null }; slot = 'sidearm';\n  syrettes = 3; tablets = 0; stones = 0; molotovs = 0; charges = 0; planted = []; upgrades = {}; unlocked = {}; items = {}; carrying = null; toolBusy = 0; litT = 0; speed2 = 0;\n  surgery = null; syretteT = 0; tabletT = 0; holdT = 0; downT = 0; landDip = 0; crouchDip = 0; airborne = 0; fallFrom = 0; bleeding = 0; burning = 0; burnClear = 0; stepT = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.ctx = ctx;\n    this.ctrl = new CharacterController(ctx.physics, { position: [0, 60, 0], radius: 0.32, halfHeight: 0.56, speed: 5.4, jumpSpeed: 8, gravity: -24 });\n    ctx.physics.tag(this.ctrl.collider, 'player');\n    this.game.world.own(this.ctrl.collider, 'player', this);\n  }\n  teleport(x, z, yFeet) {\n    const y = yFeet ?? this.game.world.land.heightAt(x, z) + 0.1;\n    if (this.vehicle) this.game.vehicles.exit(true);\n    this.ctrl.teleport([x, y, z]); this.ctrl.velocity.set(0, 0, 0);\n    this.x = x; this.y = y; this.z = z; this.game.grounded = false; this.game.world.focusX = x; this.game.world.focusZ = z;\n    this.prevY = y;\n  }\n  setYaw(yaw, pitch = 0) { this.ctx.camera.yaw = yaw; this.ctx.camera.pitch = pitch; }\n  lookAt(x, y, z) { const e = this.eyeNow(), dx = x - e.x, dz = z - e.z; this.setYaw(Math.atan2(-dx, -dz), Math.atan2(y - e.y, Math.hypot(dx, dz))); }\n  canMove() { const g = this.game; return !g.frozen && !this.surgery && !this.downT && !g.talk.locksPlayer(); }\n  canAct() { const g = this.game; return this.canMove() && !g.ui.top; }\n  eyeNow() {\n    if (this.vehicle && !this.mounted) { const v = this.vehicle; return v.seatWorld(eye); }\n    if (this.mounted && this.vehicle) return this.vehicle.gunWorld(eye);\n    if (this.mounted && this.railGun) return eye.copy(this.railGun);\n    return eye.set(this.x, this.y + (this.crouched ? 0.95 : 1.55), this.z);\n  }\n  fixed(dt) {\n    const game = this.game, input = this.ctx.input;\n    this.toolBusy = Math.max(0, this.toolBusy - dt); this.litT = Math.max(0, this.litT - dt); this.landDip *= 0.9;\n    if (game.cheats.noclip && !this.vehicle) { this.noclipMove(dt); return; }\n    if (this.vehicle || this.mounted) { this.x = this.vehicle ? this.vehicle.x : this.x; this.z = this.vehicle ? this.vehicle.z : this.z; if (this.vehicle) this.y = this.vehicle.y; return; }\n    if (this.riding) { this.x = this.riding.x; this.y = this.riding.y; this.z = this.riding.z; return; }\n    const canMove = this.canMove() && !game.ui.top;\n    const axis = canMove ? input.moveAxis() : { x: 0, y: 0 };\n    const tilt = clamp(Math.hypot(axis.x, axis.y), 0, 1);\n    if (canMove && input.consumeAny(['CapsLock'])) this.walkToggle = !this.walkToggle;\n    if (canMove && pressedFixed(input, 'crouch')) { this.crouched = !this.crouched; game.audio.play('cloth', { volume: 0.4 }); }\n    // Speed.\n    const deep = game.world.land.waterDepth(this.x, this.z) > 0.25;\n    const sprintHeld = held(input, 'sprint');\n    const forward = axis.y > 0.3;\n    if (sprintHeld && canMove && forward && !this.crouched && !deep && !this.carrying && this.stamina > 0.1 && !this.mapUp) { this.sprinting = true; this.stamina = Math.max(0, this.stamina - dt); } else { this.sprinting = false; this.stamina = Math.min(6, this.stamina + (dt * 6) / 8); }\n    if (this.stamina <= 0.1) this.exhausted = true; if (this.stamina > 1.5) this.exhausted = false;\n    if (this.exhausted) this.sprinting = false;\n    const walking = this.walkToggle || (game.device === 'pad' && tilt < 0.55);\n    let sp = this.sprinting ? 7.4 : walking ? 3.6 : 5.4;\n    if (this.crouched) sp = 2;\n    if (deep) sp = Math.min(sp, 2.7);\n    if (this.carrying) sp *= 0.85;\n    if (this.ads) sp = Math.min(sp, 3);\n    sp *= TUNING.playerSpeed;\n    this.ctrl.speed = sp;\n    const basisYaw = this.ctx.camera.yaw;\n    const fx = -Math.sin(basisYaw), fz = -Math.cos(basisYaw), rx = -fz, rz = fx;\n    moveV.set(rx * axis.x + fx * axis.y, 0, rz * axis.x + fz * axis.y);\n    if (moveV.lengthSq() > 1) moveV.normalize();\n    const jump = canMove && !this.crouched && pressedFixed(input, 'jump') && !game.prompt.jumpBlocked();\n    this.ctrl.setInput(moveV, jump, held(input, 'jump'));\n    if (jump && this.ctrl.grounded) game.audio.play('cloth', { volume: 0.5 });\n    const wasGrounded = this.ctrl.grounded, vy = this.ctrl.velocity.y;\n    this.ctrl.fixedUpdate(dt);\n    const f = this.ctrl.feet;\n    this.speed2 = Math.hypot(f.x - this.x, f.z - this.z) / dt;\n    this.x = f.x; this.y = f.y; this.z = f.z;\n    if (!this.ctrl.grounded) this.fallPeak = Math.max(this.fallPeak ?? f.y, f.y);\n    if (this.ctrl.grounded && !wasGrounded) {\n      const fell = (this.fallPeak ?? f.y) - f.y; this.fallPeak = undefined;\n      this.landDip = Math.min(0.12, -vy * 0.008);\n      if (fell > 6 && !game.cheats.god) { game.damagePlayer((fell - 6) * 8, { fall: true }); game.audio.play('grunt'); }\n      if (fell > 0.5) game.audio.play('step-dirt', { volume: 0.5 });\n    }\n    // Steps, by surface.\n    if (this.ctrl.grounded && this.speed2 > 1) {\n      this.stepT -= dt * this.speed2;\n      if (this.stepT <= 0) {\n        this.stepT = 2.6;\n        const k = game.world.land.kindAt(this.x, this.z);\n        const name = deep ? 'step-water' : k === 7 || k === 1 ? 'step-road' : k === 0 || k === 5 || k === 8 ? 'step-grass' : 'step-dirt';\n        game.audio.play(name, { volume: this.crouched || walking ? 0.2 : 0.45, pitch: game.combat.tracerRng.range(-1, 1) });\n        const noise = this.sprinting ? 40 : !this.crouched && !walking ? 25 : 0;\n        if (noise && game.world.stepCount % 4 === 0) game.actors.hearShot(this.x, this.z, noise * 0.5, null);\n      }\n    }\n    this.crouchDip += ((this.crouched ? -0.03 : 0) - this.crouchDip) * 0.2;\n  }\n  noclipMove(dt) {\n    const input = this.ctx.input, axis = input.moveAxis(), yaw = this.ctx.camera.yaw, p = this.ctx.camera.pitch, sp = held(input, 'sprint') ? 60 : 22;\n    const fx = -Math.sin(yaw), fz = -Math.cos(yaw);\n    this.x += (fx * axis.y - fz * axis.x * -1 * -1) * sp * dt; this.z += (fz * axis.y + fx * axis.x) * sp * dt; this.y += Math.sin(p) * axis.y * sp * dt;\n    this.ctrl.teleport([this.x, this.y, this.z]);\n  }\n  catchFire() { if (this.burning <= 0 && !this.game.cheats.god) { this.burning = 1; this.burnClear = 0; this.game.audio.play('grunt'); this.game.events.emit('caughtFire'); } }\n}\nexport { WATER_Y };\nEOF\ncat > src/body/health.js <<'EOF'\n// The body: health segments, syrettes, field surgery, burns, going down, and blackwater fever (section 9).\nimport { TUNING } from '../core/tuning.js';\nimport { FEVER_LINES, LOSS_LINES } from '../content/dialogue.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { clamp } from '../world/geom.js';\nconst SCENES = [\n  { clip: 'SurgeryPliers', items: ['tool-pliers', 'prop-forearm'], sounds: [[0.6, 'pliers'], [1.7, 'pliers'], [2.3, 'knife'], [2.5, 'grunt']], blood: [2.3], label: 'PLIERS' },\n  { clip: 'SurgeryKnife', items: ['tool-knife', 'prop-thigh'], sounds: [[0.8, 'knife'], [1.6, 'grunt'], [2.2, 'knife']], blood: [1.4, 2.2], label: 'KNIFE' },\n  { clip: 'SurgeryFinger', items: [], sounds: [[1.9, 'finger-snap'], [2.1, 'grunt']], blood: [], label: 'FINGER' },\n  { clip: 'SurgeryLighter', items: ['tool-lighter', 'prop-burn'], sounds: [[0.3, 'lighter'], [1.2, 'hiss'], [2.2, 'grunt']], blood: [], label: 'LIGHTER' },\n];\nexport class Body {\n  segments = 5; regenT = 0; lastDamageKind = 'bullet'; heartVoice = null;\n  fever = 0; feverActive = false; feverT = 0; feverIgnored = 0; feverNext = 720; feverClear = 0; attacks = 0; tabletHold = 0; syretteHold = 0; surgeryN = 0;\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('body'); this.resetFever(); }\n  get p() { return this.game.player; }\n  resetFever() { this.feverActive = false; this.fever = 0; this.feverNext = this.nextInterval(); this.feverIgnored = 0; }\n  nextInterval() { const act = this.game.story?.act ?? 1; return Math.max(1, TUNING.feverMinutes - (act - 1) + this.rng.range(-2, 2)) * 60; }\n  /** The segment top: health regenerates only to here. */\n  segmentTop() { const hp = this.p.hp; return Math.min(100, Math.ceil(hp / 20 - 1e-6) * 20); }\n  fixed(dt) {\n    const p = this.p, game = this.game, input = this.ctx.input;\n    if (game.mode !== 'play' && game.mode !== 'round' && game.mode !== 'attract') return;\n    this.regenT += dt;\n    if (!p.surgery && !p.downT && this.regenT > 5 && p.hp > 0 && p.hp < this.segmentTop()) p.hp = Math.min(this.segmentTop(), p.hp + dt * 8);\n    // Burns.\n    const inFire = game.world.fire.isBurning(p.x, p.z);\n    if (inFire && !p.vehicle && !game.cheats.god) p.catchFire();\n    if (p.burning > 0) {\n      p.burnClear = inFire ? 0 : p.burnClear + dt;\n      if (p.burnClear > 2 || game.world.land.waterDepth(p.x, p.z) > 0.25 || game.cheats.god) { p.burning = 0; }\n      else { game.damagePlayer(TUNING.fireDamage * dt, { fire: true }); }\n    }\n    // Scene of surgery.\n    if (p.surgery) {\n      const s = p.surgery; s.t += dt;\n      for (const [at, name] of s.scene.sounds) if (!s.played?.[at] && s.t >= at) { (s.played ??= {})[at] = 1; game.audio.play(name); if (name === 'grunt') this.ctx.engine.shake.add(0.15); }\n      for (const at of s.scene.blood) if (!s.bled?.[at] && s.t >= at) { (s.bled ??= {})[at] = 1; const e = p.eyeNow(); this.ctx.particles.burst('blood', [e.x, e.y - 0.5, e.z], { count: 12 }); game.flashBlood = 0.4; }\n      if (s.t >= 4) { p.surgery = null; p.hp = Math.max(p.hp, 40); game.vm.endTool(); this.regenT = 0; game.hud.touch(); game.events.emit('surgeryDone', s.scene.label); }\n      return;\n    }\n    if (!p.canAct() || game.gunSlungOnlyLocked?.()) { this.feverTick(dt); return; }\n    // Syrette or surgery.\n    if (held(input, 'heal') && !game.ui.top) {\n      if (p.hp < 20 && !p.vehicle) { this.startSurgery(); input.clearQueued('PadL1', 'KeyQ'); }\n      else if (p.syrettes > 0 && p.hp < 100 && !p.vehicle) {\n        if (this.syretteHold === 0) { game.vm.playTool('Syrette', ['tool-syrette']); game.audio.play('cloth', { volume: 0.4 }); }\n        this.syretteHold += dt;\n        if (this.syretteHold >= 0.8) { this.syretteHold = -1e9; p.syrettes--; p.hp = Math.min(100, p.hp + 40); game.audio.play('syrette'); this.regenT = 0; game.hud.touch(); game.events.emit('syrette'); }\n      }\n    } else { if (this.syretteHold > 0 && this.syretteHold < 0.8) game.vm.endTool(); this.syretteHold = 0; }\n    // Tablet.\n    if (held(input, 'tablet') && !game.ui.top && p.tablets > 0) {\n      if (this.tabletHold === 0) { game.vm.playTool('Tablet', ['tool-tablets', 'tool-tablet']); game.audio.play('tablet-bottle'); }\n      this.tabletHold += dt;\n      if (this.tabletHold >= 1 && this.tabletHold < 1e6) { this.tabletHold = 1e7; this.takeTablet(); }\n    } else { if (this.tabletHold > 0 && this.tabletHold < 1) game.vm.endTool(); this.tabletHold = 0; }\n    this.feverTick(dt);\n    void pressedFixed;\n  }\n  takeTablet() { const p = this.p, game = this.game; if (p.tablets <= 0) return false; p.tablets--; this.feverClear = 5; this.feverActive = false; this.feverNext = this.nextInterval(); this.feverIgnored = 0; game.hud.touch(); game.audio.play('tablet-bottle'); game.events.emit('tablet'); return true; }\n  startSurgery() {\n    const p = this.p, game = this.game, idx = this.lastDamageKind === 'fire' ? 3 : (this.surgeryN++ % 3), scene = SCENES[idx];\n    p.surgery = { t: 0, scene };\n    game.vm.playTool(scene.clip, scene.items);\n    game.events.emit('surgeryStart', scene.label);\n  }\n  feverTick(dt) {\n    const game = this.game, p = this.p;\n    if (game.mode === 'round') return;\n    if (game.cheats.noFever && !game.attract?.active) { this.fever = 0; this.feverActive = false; return; }\n    if (this.feverClear > 0) { this.feverClear -= dt; this.fever = Math.max(0, this.fever - dt / 5); }\n    if (!game.story?.feverOn) return;\n    if (this.feverActive) {\n      this.fever = clamp(this.fever + dt / 3, 0, 1);\n      this.feverIgnored += dt;\n      if (this.feverIgnored > 25 && !game.attract?.active) this.collapse();\n    } else if (this.feverClear <= 0) {\n      this.feverNext -= dt;\n      if (this.feverNext <= 0) this.onset();\n    }\n    void p;\n  }\n  onset() {\n    const game = this.game;\n    this.feverActive = true; this.feverIgnored = 0; this.attacks++;\n    game.talk.say('you', this.rng.pick(FEVER_LINES), 5);\n    game.audio.play('heartbeat');\n    game.events.emit('fever');\n  }\n  collapse() {\n    const game = this.game, p = this.p;\n    this.feverActive = false; this.fever = 0; this.feverNext = this.nextInterval();\n    const loss = Math.floor(p.stones * 0.2); p.stones -= loss;\n    game.events.emit('collapse', loss);\n    game.blackout('YOU WAKE SOME HOURS LATER, LIGHTER BY ' + loss + ' STONES.', () => {\n      game.world.advanceHours(6);\n      const near = game.nearestRecovery();\n      p.teleport(near[0], near[1]);\n      p.hp = Math.max(p.hp, 50);\n      if (game.buddies.available()) game.talk.playLines('buddy.carry'); else game.talk.playLines('fever.collapse');\n    });\n  }\n  /** Reaching zero. A friend comes, or the paperwork does. */\n  down() {\n    const game = this.game, p = this.p;\n    if (p.downT || game.mode === 'attract') return;\n    game.events.emit('playerDown');\n    if (game.mode === 'round') return;\n    game.combat.stopStream();\n    const buddy = game.buddies.rescuer();\n    if (buddy) { game.buddies.rescue(buddy); return; }\n    game.gameOver(LOSS_LINES.died);\n  }\n  update(dt) {\n    const p = this.p, game = this.game;\n    const dying = p.hp < 20 && p.hp > 0 && game.mode === 'play';\n    if (dying !== this.dying) this.dying = dying;\n    this.beatT = (this.beatT ?? 0) - dt;\n    if ((dying || this.feverActive) && this.beatT <= 0) { game.audio.play('heartbeat', { volume: dying ? 0.8 : 0.5 }); this.beatT = dying ? 0.8 : 1.15; }\n    void clamp;\n  }\n}\nEOF\ncat > src/vehicles/vehicle.js <<'EOF'\n// Trucks that die. Three bodies on the engine's Vehicle, a train on rails.\nimport { buildModel, setLookLayer, THREE, Vehicle } from '../../pixel-engine.js';\nimport { CATALOG, WRECK_PAL } from '../art/models.js';\nimport { held, pressedFixed } from '../core/actions.js';\nimport { RAILWAY, ROADS } from '../content/roads.js';\nimport { TUNING } from '../core/tuning.js';\nimport { angleDiff, clamp, polyLength, polyPoint } from '../world/geom.js';\nconst { Quaternion, Vector3 } = THREE;\nconst P = new Vector3(), R = new Quaternion(), T = new Vector3();\nconst TYPES = {\n  pickup: { model: 'pickup', size: [0.95, 0.45, 2.2], mass: 12, power: 160, topK: 1, seat: [0.42, 0.95, 0.1] },\n  technical: { model: 'technical', size: [0.95, 0.45, 2.2], mass: 13, power: 160, topK: 0.95, seat: [0.42, 0.95, 0.1], gun: [0, 1.75, -1.5] },\n  'cargo-truck': { model: 'cargo-truck', size: [1.05, 0.6, 2.9], mass: 20, power: 220, topK: 0.72, seat: [0.42, 1.2, 0.2], wheelR: 0.5 },\n  tanker: { model: 'tanker', size: [1.05, 0.6, 2.9], mass: 24, power: 240, topK: 0.68, seat: [0.42, 1.2, 0.2], wheelR: 0.5 },\n};\nexport class GameVehicle {\n  hp = 100; seated = false; stalled = false; onFire = 0; cough = 0; aiRoad = null; aiS = 0; repairT = 0; dead = false; driverless = 0;\n  constructor(game, ctx, type, x, z, yaw, tag) {\n    this.game = game; this.ctx = ctx; this.type = type; this.tag = tag ?? null;\n    const t = TYPES[type]; this.t = t;\n    const y = game.world.land.heightAt(x, z) + 1.4;\n    this.v = new Vehicle(ctx.physics, { at: [x, y, z], yaw, size: t.size, mass: t.mass, power: t.power, topSpeed: TUNING.vehicleTopSpeed * t.topK, wheelRadius: t.wheelR ?? 0.42, suspension: 0.45, stiffness: 30, grip: 2.6 });\n    this.x = x; this.y = y; this.z = z; this.yaw = yaw;\n    const b = buildModel(t.model, { catalog: CATALOG });\n    this.object = b.object; setLookLayer(this.object, 'actors');\n    this.object.traverse((o) => { if (o.isMesh) o.frustumCulled = false; });\n    ctx.scene.add(this.object); ctx.physics.bind(this.v.body, this.object);\n    this.gunNode = this.object.getObjectByName('Gun');\n    this.wheels = [0, 1, 2, 3].map(() => { const w = buildModel('wheel', { catalog: CATALOG, params: {} }); if (t.wheelR) w.object.scale.setScalar(t.wheelR / 0.42); this.object.add(w.object); return w.object; });\n    for (let i = 0; i < this.v.body.numColliders(); i++) game.world.own(this.v.body.collider(i), 'vehicle', this);\n    this.body = this.v.body;\n    this.engineVoice = null;\n  }\n  fixed(dt, input = null) {\n    const t = this.v.body.translation(); this.x = t.x; this.y = t.y; this.z = t.z; this.yaw = this.v.yaw;\n    this.v.o.topSpeed = TUNING.vehicleTopSpeed * this.t.topK;\n    if (this.game.world.fire.isBurning(this.x, this.z)) this.damage(6 * dt);\n    if (this.onFire > 0) { this.onFire -= dt; if (this.onFire <= 0 && !this.dead) this.explode(); }\n    this.cough = Math.max(0, this.cough - dt);\n    let drive = input ?? { throttle: 0, steer: 0, handbrake: !this.seated && !this.aiRoad };\n    const deep = this.game.world.land.waterDepth(this.x, this.z) > 0.45;\n    let k = 1;\n    if (this.hp < 35) k *= 0.6;\n    if (this.cough > 0 && Math.sin(this.cough * 30) > 0.2) k *= 0.1;\n    if (deep) k *= 0.08;\n    if (this.stalled || this.dead) k = 0;\n    this.v.drive({ ...drive, throttle: drive.throttle * k, brake: drive.brake || (this.stalled && !this.seated) }, dt);\n    // Collisions over 8 m/s hurt.\n    const sp = Math.abs(this.v.speed);\n    if ((this.lastSp ?? 0) - sp > 8) { this.damage(((this.lastSp - sp) - 8) * 6); this.game.audio.at('hit-metal', this.x, this.y, this.z, 40); this.ctx.engine.shake.add(this.seated ? 0.5 : 0); }\n    this.lastSp = sp;\n  }\n  damage(n, by, blast) {\n    if (this.dead) return;\n    const g = this.game;\n    this.hp -= n / TUNING.vehicleToughness;\n    if (this.seated) g.hud.touch();\n    if (this.hp < 10 && this.hp > -999 && this.onFire <= 0 && !this.dead) { this.onFire = 8; if (this.seated) g.talk.say('you', 'SHE IS ON FIRE. GET OUT.', 3); }\n    if (this.hp <= 0 && blast) this.explode(by);\n    else if (this.hp <= 0 && !this.stalled) { this.stalled = true; this.hp = 0; g.audio.at('stall', this.x, this.y, this.z, 50); g.events.emit('stalled', this); }\n  }\n  explode(by) {\n    if (this.dead) return; this.dead = true; this.hp = 0; this.stalled = true; this.onFire = 0;\n    const g = this.game;\n    g.events.emit('vehicleDestroyed', this, by);\n    if (this.seated) g.vehicles.exit(true);\n    g.combat.explode(this.x, this.y + 0.5, this.z, 8, 90, by, { fire: 8, big: true });\n    this.wreck();\n  }\n  wreck() { const b = buildModel(this.t.model, { catalog: CATALOG, palette: WRECK_PAL }); this.ctx.physics.unbind(this.object); const at = this.object.position.clone(), q = this.object.quaternion.clone(); for (const w of this.wheels) this.object.remove(w); this.ctx.scene.remove(this.object); this.object = b.object; this.object.position.copy(at); this.object.quaternion.copy(q); setLookLayer(this.object, 'actors'); this.ctx.scene.add(this.object); this.ctx.physics.bind(this.v.body, this.object); }\n  update(dt) {\n    for (let i = 0; i < 4; i++) { this.v.wheelPose(i, P, R, true); this.wheels[i].position.copy(P); this.wheels[i].quaternion.copy(R); }\n    if (this.hp < 35 && !this.dead && this.game.world.look.next() < dt * 8) this.ctx.particles.burst('fire-smoke', [this.x + Math.sin(this.yaw) * 1.5, this.y + 0.8, this.z + Math.cos(this.yaw) * 1.5], { count: 1 });\n    if (this.onFire > 0 && this.game.world.look.next() < dt * 30) this.ctx.particles.burst('ember', [this.x + Math.sin(this.yaw) * 1.5, this.y + 0.8, this.z + Math.cos(this.yaw) * 1.5]);\n    if (this.dead && this.game.world.look.next() < dt * 3) this.ctx.particles.burst('fire-smoke', [this.x, this.y + 1, this.z], { count: 1 });\n    if (this.gunNode && this.game.player.mounted && this.seated) { const q = this.object.quaternion, yaw = this.ctx.camera.yaw; void q; this.gunNode.rotation.set(-this.ctx.camera.pitch, yaw - this.yaw + Math.PI, 0); }\n  }\n  seatWorld(out) { out.set(...this.t.seat).applyQuaternion(this.object.quaternion); out.add(this.object.position); return out; }\n  gunWorld(out) { out.set(...(this.t.gun ?? this.t.seat)).applyQuaternion(this.object.quaternion); out.add(this.object.position); return out; }\n  bonnet() { return [this.x + Math.sin(this.yaw) * (this.t.size[2] + 0.9), this.z + Math.cos(this.yaw) * (this.t.size[2] + 0.9)]; }\n  door() { const a = this.yaw + Math.PI / 2; return [this.x + Math.sin(a) * 1.8, this.z + Math.cos(a) * 1.8]; }\n  dispose() {\n    for (let i = 0; i < this.v.body.numColliders(); i++) this.game.world.owners.delete(this.v.body.collider(i).handle);\n    this.ctx.physics.unbind(this.object); this.ctx.scene.remove(this.object); this.v.dispose(); this.ctx.physics.remove(this.v.body);\n  }\n}\nexport class Vehicles {\n  list = []; chase = false; repairing = null; stationary = [];\n  constructor(game) { this.game = game; }\n  build(ctx) { this.ctx = ctx; this.rng = ctx.random.fork('veh'); }\n  spawn(type, x, z, yaw = 0, tag) { const v = new GameVehicle(this.game, this.ctx, type, x, z, yaw, tag); this.list.push(v); return v; }\n  remove(v) { if (v.seated) this.exit(true); v.dispose(); this.list.splice(this.list.indexOf(v), 1); }\n  clear() { for (const v of [...this.list]) this.remove(v); }\n  enter(v) {\n    const g = this.game, p = g.player;\n    if (v.dead) return;\n    v.seated = true; p.vehicle = v; p.mounted = false; p.ads = false;\n    p.ctrl.collider.setEnabled(false); p.ctrl.body.setEnabled?.(false);\n    g.audio.play('door');\n    g.audio.play('starter', { volume: 0.7 }); v.cough = 0.6;\n    g.events.emit('enterVehicle', v);\n    g.vm.allHidden = true; this.relYaw = 0; this.lastYaw = v.yaw;\n    this.engine ??= g.audio.loopSfx('engine', 0);\n  }\n  exit(force) {\n    const g = this.game, p = g.player, v = p.vehicle; if (!v) return;\n    v.seated = false; p.vehicle = null; p.mounted = false; p.mountGun = null; this.chase = false; g.cam.override = null;\n    p.ctrl.body.setEnabled?.(true); p.ctrl.collider.setEnabled(true);\n    const [dx, dz] = v.door();\n    const y = g.world.land.heightAt(dx, dz) + 0.15;\n    p.ctrl.teleport([dx, Math.max(y, v.y), dz]); p.x = dx; p.z = dz; p.y = Math.max(y, v.y);\n    g.vm.allHidden = false; g.vm.show(p.guns[p.slot]?.id ?? 'cane');\n    g.audio.play('door');\n    if (this.engine) this.engine.set({ volume: 0 });\n    g.events.emit('exitVehicle', v); void force;\n  }\n  fixed(dt) {\n    const g = this.game, p = g.player, input = this.ctx.input;\n    for (const v of this.list) {\n      if (v === p.vehicle) continue;\n      if (v.aiRoad && !v.dead) v.fixed(dt, this.aiDrive(v, dt));\n      else v.fixed(dt);\n    }\n    const v = p.vehicle; if (!v) return;\n    let throttle = 0, steer = 0, handbrake = false;\n    if (!g.ui.top && !g.talk.locksPlayer() && !p.mounted) {\n      const axis = input.moveAxis(); steer = g.device === 'pad' ? axis.x : (input.isDown('KeyD', 'ArrowRight') ? 1 : 0) - (input.isDown('KeyA', 'ArrowLeft') ? 1 : 0);\n      const r2 = g.analog[1] > 0.02 ? g.analog[1] : held(input, 'gas') ? 1 : 0, l2 = g.analog[0] > 0.02 ? g.analog[0] : held(input, 'brake') ? 1 : 0;\n      throttle = r2 - l2; handbrake = held(input, 'handbrake');\n      if (pressedFixed(input, 'chase')) { this.chase = !this.chase; if (!this.chase) g.cam.override = null; }\n      if (!p.mapUp && pressedFixed(input, 'exit') && !g.prompt.has()) { this.exit(); return; }\n      if (pressedFixed(input, 'swap') && v.t.gun) this.mount(v);\n    } else if (p.mounted && !g.ui.top) {\n      if (pressedFixed(input, 'swap') || pressedFixed(input, 'exit')) this.dismount(v);\n    }\n    v.fixed(dt, { throttle, steer, handbrake });\n    // Keep the view turning with the truck.\n    const dy = angleDiff(v.yaw, this.lastYaw ?? v.yaw); this.lastYaw = v.yaw; this.ctx.camera.yaw += dy;\n    p.speed2 = Math.abs(v.v.speed);\n    if (this.engine) this.engine.set({ volume: v.stalled ? 0 : 0.35 * g.sfxK(), pitch: clamp(Math.abs(v.v.speed) * 0.5 - 2, -4, 12) });\n  }\n  mount(v) { const p = this.game.player; p.mounted = true; p.mountGun = { id: 'mg', cond: 100, mag: 999, reserve: 0, jammed: false }; this.game.vm.allHidden = false; this.game.vm.show('mg'); this.game.audio.play('rack'); this.game.mountedTracerFire = true; void v; }\n  dismount(v) { const p = this.game.player; p.mounted = false; p.mountGun = null; this.game.vm.allHidden = true; this.game.mountedTracerFire = false; void v; }\n  aiDrive(v, dt) {\n    const pts = v.aiRoad, L = v.aiLen ??= polyLength(pts);\n    // A PD steering controller along the polyline.\n    const ahead = polyPoint(pts, Math.min(L, (v.aiS ?? 0) + 12));\n    let nearest = v.aiS ?? 0; for (let s = nearest; s < nearest + 24; s += 2) { const q = polyPoint(pts, Math.min(L, s)); if (Math.hypot(q.x - v.x, q.z - v.z) < Math.hypot(polyPoint(pts, Math.min(L, nearest)).x - v.x, polyPoint(pts, Math.min(L, nearest)).z - v.z)) nearest = s; }\n    v.aiS = nearest;\n    const want = Math.atan2(ahead.x - v.x, ahead.z - v.z), err = angleDiff(want, v.yaw);\n    const steer = clamp(-err * 1.6, -1, 1);\n    const speedGoal = v.aiSpeed ?? 12, throttle = clamp((speedGoal - v.v.speed) * 0.4, -0.3, 1);\n    if (v.aiLoop && nearest > L - 14) v.aiS = 0;\n    else if (!v.aiLoop && nearest > L - 6) { v.aiRoad = null; v.onRoadEnd?.(); }\n    void dt; return { throttle, steer, handbrake: false };\n  }\n  update(dt) {\n    const g = this.game, p = g.player;\n    for (const v of this.list) v.update(dt);\n    const v = p.vehicle;\n    if (v && this.chase && !p.mapUp) {\n      const fx = Math.sin(v.yaw), fz = Math.cos(v.yaw);\n      g.cam.override = { position: [v.x - fx * 8, v.y + 3.4, v.z - fz * 8], target: [v.x + fx * 4, v.y + 1, v.z + fz * 4] };\n    }\n  }\n}\n// ----- The goods train -----\nexport class Train {\n  s = 900; speed = 0; goal = null; riding = false; x = 0; y = 40; z = 0; yaw = 0; visible = true; cars = [];\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.ctx = ctx; const g = this.game;\n    this.L = polyLength(RAILWAY);\n    const mk = (id, off) => { const b = buildModel(id, { catalog: CATALOG }); setLookLayer(b.object, 'actors'); b.object.traverse((o) => { if (o.isMesh) o.frustumCulled = false; }); ctx.scene.add(b.object); return { object: b.object, off, id }; };\n    this.cars = [mk('locomotive', 0), mk('flatcar', -11), mk('boxcar', -20), mk('flatcar', -29)];\n    this.gunMount = buildModel('rifle-npc', { catalog: CATALOG }).object;\n    this.place();\n    void g;\n  }\n  place() {\n    const g = this.game, q = {};\n    for (const c of this.cars) { polyPoint(RAILWAY, clamp(this.s + c.off, 0, this.L), q); const y = g.world.railY(q.x, q.z) + 0.18; c.object.position.set(q.x, y, q.z); c.object.rotation.y = q.yaw; c.x = q.x; c.y = y; c.z = q.z; c.yaw = q.yaw; }\n    const head = this.cars[0]; this.x = head.x; this.y = head.y; this.z = head.z; this.yaw = head.yaw;\n  }\n  /** Where a rider stands on a flatcar (world). */\n  riderPos(out) { const c = this.cars[1]; out.set(c.x, c.y + 1.3 + 1.55, c.z); return out; }\n  sToward(x, z) { let best = 0, bd = 1e9; const q = {}; for (let s = 0; s < this.L; s += 5) { polyPoint(RAILWAY, s, q); const d = Math.hypot(q.x - x, q.z - z); if (d < bd) { bd = d; best = s; } } return best; }\n  setAt(x, z) { this.s = this.sToward(x, z); this.speed = 0; this.goal = null; this.place(); }\n  fixed(dt) {\n    if (this.goal !== null) { const d = this.goal - this.s, stop = Math.abs(d) < 4; const want = stop ? 0 : Math.sign(d) * Math.min(this.topSpeed ?? 13, Math.abs(d) * 0.4 + 2); this.speed += clamp(want - this.speed, -5 * dt, 5 * dt); if (stop) { this.speed = 0; this.goal = null; this.game.events.emit('trainStopped'); } }\n    if (this.speed) { this.s = clamp(this.s + this.speed * dt, 12, this.L - 2); this.place(); this.clack = (this.clack ?? 0) - Math.abs(this.speed) * dt; if (this.clack <= 0) { this.clack = 9; this.game.audio.at('train-clack', this.x, this.y + 1, this.z, 180); } }\n  }\n}\nvoid ROADS; void T;\nEOF\necho ok","description":"Write player, body, vehicles and train"}}}
