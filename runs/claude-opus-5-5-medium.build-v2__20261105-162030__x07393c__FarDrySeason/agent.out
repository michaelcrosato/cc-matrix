 this.world.wind.z * 0.4] }); } }\n    // Music by state, with a dwell.\"\"\")\nopen(p,'w').write(s)\np='src/ui/hud.js'; s=open(p).read()\ns=s.replace(\"\"\"    if (this.blackoutT > 0) { this.blackoutT -= dt; h.rect(0, 0, h.width, h.height, 'ink'); if (this.blackoutText) { wrap(this.blackoutText, 60).forEach((l, i) => h.text(0, 110 + i * 12, l, { anchor: 'top', color: 'sand' })); } }\n\"\"\",\"\")\ns=s.replace(\"\"\"  scopeMask() {\"\"\",\"\"\"  drawBlackout(dt) { const h = this.h; if (this.blackoutT > 0) { this.blackoutT -= dt; h.rect(0, 0, h.width, h.height, 'ink'); if (this.blackoutText) wrap(this.blackoutText.toUpperCase(), 58).forEach((l, i) => h.text(0, 110 + i * 12, l, { anchor: 'top', color: 'sand' })); } }\n  scopeMask() {\"\"\")\nopen(p,'w').write(s)\np='src/missions/scripts.js'; s=open(p).read()\ns=s.replace(\"\"\"  freeInes: { run(g) { const site = g.world.sites['ranger-post'], door = site.cage?.object.getObjectByName('Door'); if (door) door.rotation.y = -1.9;\"\"\",\"\"\"  freeInes: { run(g) { const site = g.world.sites['ranger-post'], door = site.cage?.object.getObjectByName('Door'); if (door) door.rotation.y = -1.9; g.people.leaveCage();\"\"\")\nopen(p,'w').write(s)\np='src/actors/civilian.js'; s=open(p).read()\ns=s.replace(\"\"\"  showFriends() {\"\"\",\"\"\"  /** Ines sits in the cage at Ranger Post until you open it. */\n  showInCage() { const n = this.npcs.ines, s = siteById['ranger-post'].at; n.x = s[0] + 8; n.z = s[1] + 8; n.y = this.game.world.land.heightAt(n.x, n.z); n.caged = true; n.hidden = false; n.view.setFull('Beg'); }\n  leaveCage() { const n = this.npcs.ines; n.caged = false; n.hidden = true; n.x = -25; n.z = 53; n.y = this.game.world.land.heightAt(n.x, n.z); n.view.setFull('Idle'); }\n  showFriends() {\"\"\")\ns=s.replace(\"n.hidden = !(st[id].met && st[id].alive) || this.game.buddies.followers.some((f) => f.buddy === id); } }\",\"if (n.caged) continue; n.hidden = !(st[id].met && st[id].alive) || this.game.buddies.followers.some((f) => f.buddy === id); } }\")\nopen(p,'w').write(s)\np='src/missions/runner.js'; s=open(p).read()\ns=s.replace(\"    if (m.spawnAt) g.player.teleport(m.spawnAt[0], m.spawnAt[1]);\",\"    if (m.spawnAt) g.player.teleport(m.spawnAt[0], m.spawnAt[1]);\\n    if (id === 'm2') g.people.showInCage();\")\nopen(p,'w').write(s)\np='src/ui/prompts.js'; s=open(p).read()\ns=s.replace(\"for (const n of Object.values(g.people.npcs)) { if (n.hidden || n.gone ||\",\"for (const n of Object.values(g.people.npcs)) { if (n.hidden || n.gone || n.caged ||\")\nopen(p,'w').write(s)\np='src/actors/buddy.js'; s=open(p).read()\ns=s.replace(\"  rescuer() { const list = this.alive().filter((k) => this.ready(k)); if (!list.length) return null;\",\"  rescuer() { const g = this.game, p = g.player, home = g.nearestRecovery(), d = dist2(home[0], home[1], p.x, p.z), list = this.alive().filter((k) => this.ready(k) && (d < DEFS[k].range || this.followers.some((f) => f.buddy === k && f.alive))); if (!list.length) return null;\")\ns=s.replace(\"    if (id !== 'pell') g.story.ledger.friends++;\",\"\"\"    if (id !== 'pell') g.story.ledger.friends++;\n    // Their name on the wall, their gun leaning under it.\n    if (id !== 'pell' && this.state[id]) { const shed = g.world.sites['pump-shed'].def, gun = this.state[id].gun; g.spawnGunPickup(gun, 40, shed.at[0] - 1 + (g.story.wall.length - 1) * 0.5, shed.at[1] + 2.2, null); g.people.showFriends(); }\"\"\")\nopen(p,'w').write(s)\np='src/vehicles/vehicle.js'; s=open(p).read()\ns=s.replace(\"\"\"    v.fixed(dt, { throttle, steer, handbrake });\n    // Keep the view turning with the truck.\"\"\",\"\"\"    v.fixed(dt, { throttle, steer, handbrake });\n    // The road under you.\n    const sp = Math.abs(v.v.speed); this.gravT = (this.gravT ?? 0) - dt;\n    if (this.gravT <= 0 && sp > 4 && !p.mounted) { this.gravT = 0.5; const k = g.world.land.kindAt(v.x, v.z); if (k !== 7) g.audio.play('gravel', { volume: Math.min(0.5, sp / 40) }); }\n    if (throttle < -0.3 && v.v.speed > 8 && (this.brakeT = (this.brakeT ?? 0) - dt) <= 0) { this.brakeT = 1.2; g.audio.play('brakes', { volume: 0.5 }); }\n    // Keep the view turning with the truck.\"\"\")\ns=s.replace(\"\"\"  aiDrive(v, dt) {\n    const pts = v.aiRoad,\"\"\",\"\"\"  aiDrive(v, dt) {\n    if (!v.driverView) { const view = new PersonView(this.ctx, v.hostile === 'harvest' ? 'soldier-cloth' : 'soldier-beret', { ...FACTION_PALETTES[v.hostile ?? 'concord'], skin: 'plum' }, { gun: false }); view.setFull('DriveSit'); view.object.position.set(v.t.seat[0], v.t.seat[1] - 1.05, v.t.seat[2]); v.object.add(view.object); v.driverView = view; }\n    v.driverView.update(dt);\n    const gp = this.game.player; if (dist2(v.x, v.z, gp.x, gp.z) < 18 && (v.hornT = (v.hornT ?? 0) - dt) <= 0) { v.hornT = 6; this.game.audio.at('horn', v.x, v.y, v.z, 80); }\n    const pts = v.aiRoad,\"\"\")\ns=s.replace(\"import { CATALOG, WRECK_PAL } from '../art/models.js';\",\"import { CATALOG, FACTION_PALETTES, WRECK_PAL } from '../art/models.js';\\nimport { PersonView } from '../actors/rig.js';\")\ns=s.replace(\"import { angleDiff, clamp, polyLength, polyPoint } from '../world/geom.js';\",\"import { angleDiff, clamp, dist2, polyLength, polyPoint } from '../world/geom.js';\")\ns=s.replace(\"  wreck() { const b =\",\"  wreck() { if (this.driverView) { this.object.remove(this.driverView.object); this.driverView = null; } const b =\")\nopen(p,'w').write(s)\np='src/actors/player.js'; s=open(p).read()\ns=s.replace(\"    if (this.exhausted) this.sprinting = false;\",\"    if (this.exhausted) { this.sprinting = false; if (!this.wasOut) { this.wasOut = true; game.audio.play('breath'); } } else this.wasOut = false;\")\nopen(p,'w').write(s)\np='src/missions/scripts.js'; s=open(p).read()\ns=s.replace(\"st.skip = false; g.player.items.map = true;\",\"st.skip = false; g.player.items.map = true; g.audio.play('train-whistle', { volume: 0.6 });\")\ns=s.replace(\"g.setRiding(t, true); st.t4 = 0;\",\"g.setRiding(t, true); g.audio.play('train-whistle', { volume: 0.7 }); st.t4 = 0;\")\nopen(p,'w').write(s)\nEOF\ncat > DESIGNERS.md <<'EOF'\n# Building out Far Dry Season, without touching code\n\nEverything a designer adds is plain data in `src/content/` and `src/art/`. After any change: `node tools/build.mjs`, then `node tests/run.mjs`.\n\n| To add | Edit | Notes |\n| --- | --- | --- |\n| A weapon | `src/content/weapons.js` (table), `src/art/viewmodels.js` (`gunModel(...)`), `src/art/clips.js` (`GUN_CLIPS`) | Reload kinds: `mag revolver break pump bolt fuel`. List it in `SHOP_ORDER` to sell it. |\n| A site or post | `src/content/sites.js` | `props: [modelId, dx, dz, yawDeg, { tag, palette }]`, `soldiers: [role, dx, dz, duty]`, `usables`, `npcs`. Stand in the game with dev mode's Debug > Crosshair Coords to read positions. |\n| A road | `src/content/roads.js` | Polylines; the ground flattens and paints itself. |\n| A mission | `src/content/missions.js` | Steps: `goto leave talk report use deliver destroy kill collect steal hold escort ride timer choice script`. Anything truly bespoke is one named entry in `src/missions/scripts.js`. |\n| A line of dialogue | `src/content/dialogue.js` | Keep to the HUD font's characters, under 60 characters; split long sentences. `static` checks every string. |\n| A model | `src/art/models.js`, add to `WORLD_MODELS` | `node check.mjs --sheets src/art/models.js`, open the PNGs. |\n| An animation | `src/art/clips.js` | People: the hero rig. Hands: `GUN_RIG` or `TOOL_RIG`. |\n| A sound or song | `src/audio/sfx.js`, `src/audio/music.js` | Data only. No audio files. |\n| A balance number | `src/content/tuning-defaults.js` | Each entry becomes a live slider in dev mode's Balance tab. |\n\n**Dev mode** is in the pause menu: cheats, teleports, spawns, hour and wind, start any mission, sliders with reset, overlays, quick save.\nEOF\nsleep 1; echo ok","description":"Add remaining plan details and DESIGNERS.md"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_