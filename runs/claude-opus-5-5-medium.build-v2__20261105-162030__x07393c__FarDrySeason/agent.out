{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LMN7rkNxDvYSGdmCgGFHY6","type":"tool_result","content":"    if (id !== 'pell' && this.state[id]) { const shed = g.world.sites['pump-shed'].def, gun = this.state[id].gun; g.spawnGunPickup(gun, 40, shed.at[0] - 1 + (g.story.wall.length - 1) * 0.5, shed.at[1] + 2.2, null); g.peo\n    g.talk.say('you', how === 'finished' ? 'ONE SHOT.' : 'YOU WERE TOO LATE.', 4);\n    g.events.emit('buddyDead', a, how);\n    g.hud.touch();\n  }\n  /** Dragged backward, low, while they swear at you. */\n  rescue(id) {\n    const g = this.game, p = g.player, def = DEFS[id], s = this.state[id];\n    p.downT = 6.5; p.hp = 1; g.combat.stopStream(); if (p.vehicle) g.vehicles.exit(true);\n    s.spentUntil = g.world.totalHours + 24;\n    if (this.rng.next() < TUNING.buddyWoundChance) { s.spentUntil = g.world.totalHours + 48; g.story.woundNote = id; }\n    this.addTrust(id, 0);\n    let a = this.followers.find((f) => f.buddy === id && f.alive);\n    if (!a) a = this.spawnFollower(id, p.x + 1.4, p.z - 1.2, { duty: 'guard' });\n    a.invulnerable = true; a.dragging = true; a.view?.setFull('DragBackward');\n    const yaw = this.ctx.camera.yaw, dirx = Math.sin(yaw), dirz = Math.cos(yaw);\n    let t = 0;\n    const tick = g.events.on('fixed', (dt) => {\n      t += dt;\n      p.x += dirx * dt * 1.2; p.z += dirz * dt * 1.2; p.ctrl.teleport([p.x, g.world.land.heightAt(p.x, p.z) + 0.05, p.z]);\n      if (a.ctrl) a.ctrl.teleport([p.x + dirx * 1.2, g.world.land.heightAt(p.x, p.z) + 0.05, p.z + dirz * 1.2]); a.x = p.x + dirx * 1.2; a.z = p.z + dirz * 1.2; a.y = g.world.land.heightAt(a.x, a.z); a.yaw = yaw;\n      const eyeY = p.y + 0.42, wob = Math.sin(t * 7) * 0.05;\n      g.cam.override = { position: [p.x, eyeY + wob, p.z], target: [a.x, a.y + 1.1 + Math.sin(t * 2) * 0.2, a.z] };\n      if (t > 6.2) {\n        tick(); g.cam.override = null; p.downT = 0; p.hp = def.hp; a.invulnerable = false; a.dragging = false; a.view?.stopFull(); a.duty = 'follow'; g.frozen = false; g.body.regenT = 0; g.hud.touch();\n        if (g.story.woundNote === id) { g.talk.say(id, 'I took one for that. Two days. You owe me.', 5); g.story.woundNote = null; }\n        g.events.emit('rescued', id);\n        this.ctx.tweens.call(25, () => { if (a.alive && !a.down && !g.missions.active && this.followers.includes(a)) { const k = this.followers.indexOf(a); this.followers.splice(k, 1); g.actors.remove(a); } });\n      }\n    });\n    g.talk.playLines(def.rescueLine);\n    g.events.emit('rescueStart', id);\n    g.story.rescues = (g.story.rescues ?? 0) + 1;\n    void held;\n  }\n}\n    if (g.id === 'mg') { if (this.overheated) { game.audio.play('jam-click', { volume: 0.3 }); this.fireTimer = 0.2; return; } this.heat += 1 / w.rate; if (this.heat >= w.overheat) { this.overheated = true; game.audio.play('hiss'); } }\n      p.teleport(near[0], near[1]);\n      p.hp = Math.max(p.hp, 50);\n      if (game.buddies.available()) game.talk.playLines('buddy.carry'); else game.talk.playLines('fever.collapse');\n    });\n  }\n  /** Reaching zero. A friend comes, or the paperwork does. */\n  down() {\n    const game = this.game, p = this.p;\n    if (p.downT || game.mode === 'attract') return;\n    game.events.emit('playerDown');\n    if (game.mode === 'round') return;\n    game.combat.stopStream();\n    const buddy = game.buddies.rescuer();\n    if (buddy) { game.buddies.rescue(buddy); return; }\n    game.gameOver(LOSS_LINES.died);\n  }\n  update(dt) {\n    const p = this.p, game = this.game;\n    const dying = p.hp < 20 && p.hp > 0 && game.mode === 'play';\n    if (dying !== this.dying) this.dying = dying;\n    this.beatT = (this.beatT ?? 0) - dt;\n    if ((dying || this.feverActive) && this.beatT <= 0) { game.audio.play('heartbeat', { volume: dying ? 0.8 : 0.5 }); this.beatT = dying ? 0.8 : 1.15; }\n    void clamp;\n  }\n}\n11:  mg: { id: 'mg', name: 'MOUNTED MG', slot: 'mounted', rate: 10, damage: 20, range: 180, wear: 0, noise: 140, auto: 