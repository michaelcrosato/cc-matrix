;\")\nopen(p,'w').write(s)\np='src/combat/weapons.js'; s=open(p).read()\ns=s.replace(\"\"\"    const hit = this.lastHit;\n    if (tracer)\"\"\",\"\"\"    const hit = this.lastHit;\n    if (this.game.net && !this.game.net.isHost) { // A client: its shot is decided by the host.\n      this.game.net.queueShot(from, dir, w.id);\n      if (tracer) this.tracer(eye, hit ? hit.point : { x: from.x + dir.x * w.range, y: from.y + dir.y * w.range, z: from.z + dir.z * w.range });\n      if (hit) this.ctx.particles.burst('mud', [hit.point.x, hit.point.y, hit.point.z]);\n      return;\n    }\n    if (tracer)\"\"\")\ns=s.replace(\"\"\"  flareImpact(x, y, z, hit, by) {\n    const game = this.game, owner\"\"\",\"\"\"  flareImpact(x, y, z, hit, by) {\n    if (this.game.net && !this.game.net.isHost) { this.game.net.queueEv(['i', Math.round(x), Math.round(z), 3]); this.ctx.particles.burst('sparks', [x, y, z], { count: 12 }); this.game.audio.at('flare-hiss', x, y, z, 60); return; }\n    const game = this.game, owner\"\"\")\ns=s.replace(\"\"\"  bottleImpact(x, y, z, hit, by) {\n    const game = this.game, owner\"\"\",\"\"\"  bottleImpact(x, y, z, hit, by) {\n    if (this.game.net && !this.game.net.isHost) { this.game.net.queueEv(['i', Math.round(x), Math.round(z), 6]); this.ctx.particles.burst('blast', [x, y + 0.5, z], { count: 18 }); this.game.audio.at('bottle-smash', x, y, z, 60); return; }\n    const game = this.game, owner\"\"\")\ns=s.replace(\"\"\"    if (game.net) game.net.onIgnite?.(x, z, 3, by);\n\"\"\",\"\").replace(\"\"\"    if (game.net) game.net.onIgnite?.(x, z, 4, by);\n\"\"\",\"\")\nopen(p,'w').write(s)\np='src/actors/soldier.js'; s=open(p).read()\ns=s.replace(\"\"\"    for (const t of this.targetsOf(a)) {\n      if (!this.hostileTo(a, t) || t.hidden) continue;\"\"\",\"\"\"    for (const t of this.targetsOf(a)) {\n      if (t.actor === a || !this.hostileTo(a, t) || t.hidden || t.down) continue;\"\"\")\ns=s.replace(\"\"\"      a.ctrl = new CharacterController(ctx.physics, { position: [def.x, y + (def.y ?? 0) * 0 + 0.05, def.z]\"\"\",\"\"\"      a.ctrl = new CharacterController(ctx.physics, { position: [def.x, y + 0.05, def.z]\"\"\")\ns=s.replace(\"\"\"if (Math.hypot(a.x - x, a.z - z) < radius) { a.lastKnown = [x, z];\"\"\",\"\"\"if (Math.hypot(a.x - x, a.z - z) < radius) { if (radius >= 30 && Math.hypot(a.x - x, a.z - z) < radius * 0.4) a.provokedBy = true; a.lastKnown = [x, z];\"\"\")\nopen(p,'w').write(s)\np='src/game.js'; s=open(p).read()\ns=s.replace(\"\"\"  ready(ctx) { if (typeof window !== 'undefined') window.__GAME__ = this; this.pageHooks(ctx); }\"\"\",\"\"\"  ready(ctx) { if (typeof window !== 'undefined') window.__GAME__ = this; this.pageHooks(ctx); this.net?.onEngineReady(); }\n  /** Cash Run outside a hub session: solo with hired guns, or two windows on one computer. */\n  startCashRun(kind) {\n    this.ui.clear();\n    if (kind === 'solo') { this.beginRoundFrom(soloSession(this)); return; }\n    const session = linkSession({ host: kind === 'host', name: kind === 'host' ? 'HOST' : 'GUEST' });\n    this.linkPending = session;\n    this.ui.push({ id: 'link-lobby', cover: 'ink', title: 'CASH RUN', sub: kind === 'host' ? 'WAITING FOR THE OTHER WINDOW. OPEN THIS GAME AGAIN AND CHOOSE JOIN.' : 'LOOKING FOR THE OTHER WINDOW.', top: 120, footer: [['back', 'BACK']], items: kind === 'host' ? [{ label: 'START', disabled: () => !session.joined, action: () => session.start() }] : [], back: () => { session.close(); this.linkPending = null; this.ui.pop(); } });\n    session.on('start', () => { this.ui.clear(); this.linkPending = null; this.beginRoundFrom(session); });\n  }\n  beginRoundFrom(session) { this.beginCampaignState(); this.session = session; this.net = new Round(this, session); this.mode = 'round'; this.net.begin(); this.net.onEngineReady(); this.requestLock(); }\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/net/round.js <<'EOF'\n// Cash Run: six minutes, four mercs, one burning valley. The host runs the world; each copy moves its own player.\nimport { buildModel, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { CATALOG } from '../art/models.js';\nimport { PersonView } from '../actors/rig.js';\nimport { FIRE_N, BURNING, BURNT } from '../world/fire.js';\nimport { dist2 } from '../world/geom.js';\nimport { GAME_TITLE } from '../content/title.js';\nimport { TUNING } from '../core/tuning.js';\nimport { held } from '../core/actions.js';\nimport { resultsScreen } from '../ui/screens.js';\nconst { Vector3 } = THREE;\nexport const ROUND_MS = 360000;\nconst SPAWNS = [[60, -350], [255, -270], [130, -205], [40, -170]];\nconst CASE_SPOTS = [[210, -280], [90, -322], [278, -216], [36, -164], [150, -310], [190, -250]];\nexport const TRUCK = [150, -225];\nconst LIVE = new Set(['the-cut', 'p5', 'ranger-post']);\nconst SAFE = (s) => String(s ?? 'MERC').toUpperCase().replace(/[^A-Z0-9 .,:;!?'\"\\-+=/()%_#&*@]/g, '').slice(0, 14) || 'MERC';\nconst STATE_CODE = { idle: 0, suspicious: 1, alert: 2, searching: 3, burning: 4 };\nconst FACTIONS = ['concord', 'harvest', 'deserter'];\nconst from = new Vector3(), dir = new Vector3();\nexport class Round {\n  P = {}; order = []; cases = []; ended = false; started = false; evQ = []; wQ = { f: [], x: [], d: [], b: [] }; puppets = new Map(); snaps = []; banks = 0; tSend = {}; card = null; hasReady = false;\n  constructor(game, session) { this.game = game; this.s = session; this.isHost = session.isHost; this.me = session.me; this.server = !!session.server; }\n  simulating() { return true; }\n  async begin() {\n    const g = this.game, s = this.s, w = g.world, p = g.player;\n    g.cheats.god = false; g.mode = 'round';\n    this.rng = s.rng('round');\n    for (const c of w.cases) { c.taken = true; c.object.visible = false; }\n    w.fire.visualOnly = !this.isHost;\n    w.setHour(16.2, true); w.pinWind({ dir: [Math.cos(this.rng() * 6.28), Math.sin(this.rng() * 6.28)], speed: 4.5 }); w.windPin = null;\n    w.sites['the-cut'].dormant = false;\n    for (const site of Object.values(w.sites)) { site.dormant = !LIVE.has(site.id); site.cleared = false; }\n    for (const c of Object.values(g.people.npcs)) c.hidden = true;\n    for (const c of g.people.civs) c.view.object.visible = false;\n    g.story.feverOn = false;\n    // The truck you bank at.\n    const ty = w.land.heightAt(TRUCK[0], TRUCK[1]), truck = buildModel('cargo-truck', { catalog: CATALOG });\n    truck.object.position.set(TRUCK[0], ty + 1.1, TRUCK[1]); truck.object.rotation.y = 1.5; setLookLayer(truck.object, 'actors'); g.ctx.scene.add(truck.object); this.truck = truck.object;\n    // Players.\n    this.order = s.players.map((q) => q.id);\n    for (const q of s.players) {\n      const spawn = SPAWNS[q.id % 4], color = q.color;\n      const P = { id: q.id, name: SAFE(q.name), color, kind: 'player', x: spawn[0], y: w.land.heightAt(spawn[0], spawn[1]) + 0.1, z: spawn[1], yaw: 0, pitch: 0, hp: 100, stance: 0, crouched: false, lit: false, stones: 0, kills: 0, downs: 0, revives: 0, cellsLit: 0, carrying: -1, down: false, downT: 0, respawnT: 0, spawn, left: false, ai: !!q.ai, speed2: 0, burning: 0 };\n      this.P[q.id] = P;\n      if (q.id === this.me && !this.server) { P.local = true; continue; }\n      if (q.ai) { this.spawnMerc(P); continue; }\n      P.view = new PersonView(g.ctx, 'soldier-cloth', { cloth: colorName(color), dark: 'night', hat: colorName(color), strap: 'sand', boot: 'ink', skin: 'orange' }, { gun: true });\n      P.view.place(P.x, P.y, P.z, 0); P.view.setLower('Idle'); P.view.setUpper('AimIdle');\n      if (this.isHost) { P.collider = g.ctx.physics.addStaticCylinder([P.x, P.y + 0.85, P.z], 0.85, 0.34); g.world.own(P.collider, 'player', P); }\n      P.gx = P.x; P.gy = P.y; P.gz = P.z;\n    }\n    // Your kit.\n    if (!this.server) {\n      const L = this.P[this.me];\n      p.guns = { melee: null, sidearm: null, main: null, special: null };\n      g.combat.give('cane', 100, false); g.combat.give('flare', 100, false); g.combat.give('tractor', 70, true);\n      p.syrettes = 2; p.molotovs = 2; p.hp = 100; p.teleport(L.x, L.z); p.setYaw(Math.atan2(-(TRUCK[0] - L.x), -(TRUCK[1] - L.z)), 0); g.story.hasTracker = true;\n    } else { p.teleport(0, 40); p.ctrl.collider.setEnabled(false); }\n    // Cases.\n    this.cases = CASE_SPOTS.map(([x, z], i) => { const b = buildModel('stone-case', { catalog: CATALOG }); const y = w.land.heightAt(x, z); b.object.position.set(x, y + 0.03, z); b.object.scale.setScalar(1.4); setLookLayer(b.object, 'actors'); g.ctx.scene.add(b.object); return { i, x, z, y, stones: 3 + Math.floor(this.rng() * 5), carrier: -1, banked: false, burned: false, object: b.object, burnT: 0 }; });\n    s.on('message', (d, f) => this.onMessage(d, f));\n    s.on('leave', (e) => this.onLeave(e));\n    s.on('time-up', () => { if (this.isHost) this.finish(); });\n    s.on('end', (e) => this.onEnd(e));\n    s.on('start', () => { this.started = true; this.card = null; });\n    s.on('card', (c) => { this.card = c; });\n    if (s.kind === 'hub') { this.ownCard = true; if (typeof window !== 'undefined') { this.keyL = (e) => { if (this.started) return; if (e.code === 'Enter') { s.answer('ready'); this.answered = true; } if (e.code === 'KeyM') s.answer('more'); }; window.addEventListener('keydown', this.keyL); } }\n    if (this.server) { /* main.js says ready */ }\n    if (this.isHost) w.fire.onLit = null;\n    this.prevCell = w.fire.onChange;\n    if (this.isHost) w.fire.onChange = (i, st, was) => { this.prevCell(i, st, was); if (st === BURNING || st === BURNT) { this.wQ.f.push(i, st); } };\n    // Drive sends from a timer, not the render loop: a slow copy's traffic must still flow.\n    if (typeof setInterval !== 'undefined' && (s.kind === 'hub' || s.kind === 'link')) this.timer = setInterval(() => this.netTick(), 50);\n    g.audio.setMusic('title');\n  }\n  onEngineReady() { if (this.hasReady || this.server) return; this.hasReady = true; if (this.s.kind === 'hub') this.s.ready(); else if (this.s.kind === 'solo') this.s.ready(); }\n  time() { return this.s.time(); }\n  inPlay() { const t = this.time(); return this.started && t >= 0; }\n  // ----- AI mercs (solo) -----\n  spawnMerc(P) {\n    const g = this.game, a = g.actors.spawn({ kind: 'merc', faction: 'merc', role: 'rifle', x: P.x, z: P.z, duty: 'walkTo', modelId: 'soldier-cloth', palette: { cloth: colorName(P.color), dark: 'night', hat: colorName(P.color), strap: 'sand', boot: 'ink', skin: 'plum' }, hp: 140 });\n    a.hp = 140; a.maxHp = 140; a.merc = P; a.fireproof = false; P.actor = a; a.provokedBy = true; a.state = 'idle'; a.spec = { ...a.spec, speed: 5 };\n  }\n  mercBrain(P, dt) {\n    const a = P.actor; if (!a?.alive) return;\n    P.x = a.x; P.y = a.y; P.z = a.z; P.yaw = a.yaw; P.hp = (a.hp / a.maxHp) * 100;\n    P.brainT = (P.brainT ?? 0) - dt; if (P.brainT > 0) return; P.brainT = 0.5;\n    if (P.carrying >= 0) { a.goal = TRUCK; }\n    else { let best = null, bd = 1e9; for (const c of this.cases) if (!c.banked && !c.burned && c.carrier < 0) { const d = dist2(c.x, c.z, a.x, a.z); if (d < bd) { bd = d; best = c; } } if (best) { a.goal = [best.x, best.z]; if (bd < 2.6) this.pick(P, best); } else a.goal = TRUCK; }\n    a.goalSpeed = 1;\n  }\n  // ----- Host: the world's messages -----\n  onMessage(d, from) {\n    if (this.ended) return;\n    if (d.t === 'me' && this.isHost) { const P = this.P[from]; if (!P || P.left) return; if (P.seq !== undefined && d.q < P.seq) return; P.seq = d.q; P.gx = d.x / 10; P.gy = d.y / 10; P.gz = d.z / 10; P.yaw = d.w / 100; P.pitch = d.h / 100; P.crouched = !!d.c; P.lit = !!d.l; P.speed2 = d.v ?? 0; }\n    if (d.t === 'ev' && this.isHost) for (const e of d.e) this.onEvent(e, from);\n    if (d.t === 's' && !this.isHost) this.onSnapshot(d);\n    if (d.t === 'w' && !this.isHost) this.onWorld(d);\n  }\n  onEvent(e, id) {\n    const P = this.P[id], g = this.game; if (!P || P.left) return;\n    switch (e[0]) {\n      case 's': { // a shot\n        const w = e[1] === 'tractor' ? 24 : e[1] === 'm38' ? 34 : e[1] === 'cane' ? 55 : 24;\n        from.set(e[2] / 100, e[3] / 100, e[4] / 100); dir.set(e[5] / 1000, e[6] / 1000, e[7] / 1000).normalize();\n        const hit = g.ctx.physics.castRay(from, dir, 120, undefined, P.colliderBody);\n        if (hit) { const owner = g.world.owners.get(hit.collider.handle); if (owner?.ref === P) break; g.combat.applyHit(hit, w * TUNING.weaponDamage, P, { dir, from }); }\n        g.actors.hearShot(from.x, from.z, 120, null);\n        break;\n      }\n      case 'i': g.world.fire.ignite(e[1], e[2], e[3], P); P.cellsLit += 3; break;\n      case 'p': { const c = this.cases[e[1]]; if (c) this.pick(P, c); break; }\n      case 'h': P.hp = Math.min(100, P.hp + 40); break;\n      case 'r': { const o = this.P[e[1]]; if (o?.down && dist2(o.x, o.z, P.x, P.z) < 4) this.revive(o, P); break; }\n    }\n  }\n  pick(P, c) { if (c.carrier >= 0 || c.banked || c.burned || P.carrying >= 0 || P.down || dist2(c.x, c.z, P.x, P.z) > 4) return; c.carrier = P.id; P.carrying = c.i; c.burnT = 0; }\n  revive(o, by) { o.down = false; o.hp = 40; o.downT = 0; by.revives++; this.wQ.d.push(['up', o.id]); if (o.local) this.upLocal(); }\n  upLocal() { const p = this.game.player; p.downT = 0; this.game.cam.override = null; p.hp = 40; }\n  drop(P) { if (P.carrying >= 0) { const c = this.cases[P.carrying]; c.carrier = -1; c.x = P.x; c.z = P.z; c.y = this.game.world.land.heightAt(P.x, P.z); P.carrying = -1; } }\n  damageLocal(dmg, o) { this.hurt(this.P[this.me], dmg, o); }\n  damageRemote(ref, dmg, o) { this.hurt(ref, dmg, o); }\n  hurt(P, dmg, o = {}) {\n    if (!P || P.down || P.left || !this.inPlay()) return;\n    P.hp -= dmg * TUNING.playerDamageTaken; P.regenT = 0;\n    if (P.local) { const g = this.game; g.player.hp = P.hp; g.body.regenT = 0; g.hud.touch(); g.flashBlood = 0.2; g.ctx.engine.shake.add(0.25); g.audio.play('hit-flesh'); }\n    if (P.hp <= 0) this.goDown(P, o);\n  }\n  goDown(P, o) {\n    P.hp = 0; P.down = true; P.downT = 25; P.downs++; this.drop(P);\n    if (o?.by?.kind === 'player' && o.by !== P) o.by.kills = (o.by.kills ?? 0) + 0;\n    this.wQ.d.push(['down', P.id]);\n    if (P.local) this.downLocal();\n  }\n  downLocal() { const g = this.game, p = g.player; p.downT = 1e9; p.mapUp = false; g.combat.stopStream(); g.talk.say('you', 'YOU ARE BLEEDING OUT. SOMEONE MAY COME. SOMEONE MAY TAKE THE CASE.', 5); }\n  onKill(a, o) { if (a.kind === 'merc') return; if (o.by?.kind === 'player') o.by.kills = (o.by.kills ?? 0) + 1; else { const P = this.P[this.me]; if (P) P.kills++; } }\n  onActorHit() {}\n  targets(out) { for (const id of this.order) { const P = this.P[id]; if (!P.left && !P.down && !P.respawning) out.push(P); } }\n  siteDist(def) { let best = 1e9; for (const id of this.order) { const P = this.P[id]; if (!P.left) best = Math.min(best, dist2(P.x, P.z, def.at[0], def.at[1])); } return best; }\n  siteLive(def) { return this.isHost && LIVE.has(def.id); }\n  // ----- One fixed step -----\n  fixed(dt) {\n    const g = this.game, p = g.player;\n    if (this.ended) return;\n    if (this.s.tick) this.s.tick(dt * 1000);\n    if (this.s.kind === 'solo') { this.started = this.started || this.s.time() > -Infinity; }\n    if (!this.server) {\n      const L = this.P[this.me];\n      if (!L.left) { L.x = p.x; L.y = p.y; L.z = p.z; L.yaw = g.ctx.camera.yaw; L.pitch = g.ctx.camera.pitch; L.crouched = p.crouched; L.lit = p.lit; L.speed2 = p.speed2; p.carrying = L.carrying >= 0; }\n      // Syrette, here on the client; the host knows.\n      if (held(g.ctx.input, 'heal') && p.syrettes > 0 && L.hp < 100 && !L.down) { this.healT = (this.healT ?? 0) + dt; if (this.healT >= 0.8) { this.healT = -1e6; p.syrettes--; g.audio.play('syrette'); if (this.isHost) L.hp = Math.min(100, L.hp + 40); else this.queueEv(['h']); } } else this.healT = 0;\n      p.hp = L.hp;\n    }\n    if (!this.inPlay()) { if (p.ctrl && !this.server) { /* the 3-2-1: stand where you are */ } this.frozenCount(); }\n    if (this.isHost) this.hostFixed(dt);\n    else this.clientFixed(dt);\n    if (this.s.kind === 'solo') this.netTick(dt);\n  }\n  frozenCount() { const g = this.game; g.frozen = !this.inPlay(); }\n  hostFixed(dt) {\n    const g = this.game, f = g.world.fire;\n    if (!this.inPlay()) return;\n    g.frozen = false;\n    for (const id of this.order) {\n      const P = this.P[id]; if (P.left) continue;\n      if (P.actor) this.mercBrain(P, dt);\n      if (!P.local && !P.ai) { // A remote player: their puppet and collider follow their own report.\n        if (P.gx !== undefined) { P.x = P.gx; P.y = P.gy; P.z = P.gz; }\n        if (P.collider) { P.collider.setTranslation?.({ x: P.x, y: P.y + 0.85, z: P.z }); }\n      }\n      if (P.down) { P.downT -= dt; if (P.downT <= 0) { P.down = false; P.respawning = true; P.respawnT = 15; this.wQ.d.push(['gone', P.id]); } continue; }\n      if (P.respawning) { P.respawnT -= dt; if (P.respawnT <= 0) { P.respawning = false; P.hp = 100; this.wQ.d.push(['back', P.id]); if (P.local) { g.player.teleport(P.spawn[0], P.spawn[1]); g.player.downT = 0; g.player.hp = 100; } if (P.ai) { this.spawnMerc(P); } } continue; }\n      // Fire.\n      if (!P.ai && f.isBurning(P.x, P.z)) { P.burning = 2; }\n      if (P.burning > 0) { P.burning -= dt; this.hurt(P, TUNING.fireDamage * dt, { fire: true }); }\n      // Regenerate to the segment top.\n      P.regenT = (P.regenT ?? 0) + dt;\n      if (P.regenT > 5 && P.hp < Math.ceil(P.hp / 20 - 1e-6) * 20) P.hp = Math.min(100, P.hp + dt * 8);\n      // Bank.\n      if (P.carrying >= 0 && dist2(P.x, P.z, TRUCK[0], TRUCK[1]) < 6) this.bank(P);\n    }\n    for (const c of this.cases) {\n      if (c.banked || c.burned) continue;\n      if (c.carrier >= 0) { const P = this.P[c.carrier]; c.x = P.x; c.z = P.z; c.y = P.y; continue; }\n      if (f.isBurning(c.x, c.z)) { c.burnT += dt; if (c.burnT > 6) { c.burned = true; this.wQ.b.push(['burn', c.i]); g.audio.at('explosion-small', c.x, c.y, c.z, 80); } }\n    }\n    if (this.cases.every((c) => c.banked || c.burned) || (this.time() >= ROUND_MS)) this.finish();\n  }\n  bank(P) { const c = this.cases[P.carrying]; c.banked = true; c.carrier = -1; P.carrying = -1; P.stones += c.stones; this.wQ.b.push(['bank', c.i, P.id, c.stones]); if (P.local) { this.game.audio.play('stone'); this.game.notice(`+${c.stones} STONES`); } else this.game.audio.at('stone', c.x, c.y, c.z, 40); }\n  clientFixed(dt) {\n    const g = this.game; if (this.inPlay()) g.frozen = false;\n    const L = this.P[this.me];\n    if (L.down) g.player.downT = 1e9; else if (g.player.downT > 1e6) g.player.downT = 0;\n    void dt;\n  }\n  // ----- The network tick (a timer, or the fixed step for solo) -----\n  netTick() {\n    if (this.ended) return;\n    const now = this.s.time(); if (now === -Infinity) return;\n    const t = this.nowMs = typeof performance !== 'undefined' ? performance.now() : 0;\n    if (this.s.kind === 'solo') return;\n    const due = (k, ms) => { if (t - (this.tSend[k] ?? -1e9) >= ms) { this.tSend[k] = t; return true; } return false; };\n    if (this.isHost) {\n      if (due('s', 100)) this.s.send(this.snapshot(), { reliable: false });\n      if (due('w', 250) && (this.wQ.f.length || this.wQ.x.length || this.wQ.d.length || this.wQ.b.length)) { this.s.send({ t: 'w', ...this.wQ }, { reliable: true }); this.wQ = { f: [], x: [], d: [], b: [] }; }\n    } else {\n      if (due('me', 83)) { const L = this.P[this.me]; this.seq = (this.seq ?? 0) + 1; if (L) this.s.send({ t: 'me', q: this.seq, x: Math.round(L.x * 10), y: Math.round(L.y * 10), z: Math.round(L.z * 10), w: Math.round((L.yaw ?? 0) * 100), h: Math.round((L.pitch ?? 0) * 100), c: L.crouched ? 1 : 0, l: L.lit ? 1 : 0, v: Math.round(L.speed2 ?? 0) }, { to: this.s.host, reliable: false }); }\n      if (due('ev', 200) && this.evQ.length) { this.s.send({ t: 'ev', e: this.evQ.splice(0, 40) }, { to: this.s.host, reliable: true }); }\n    }\n  }\n  snapshot() {\n    const g = this.game, p = this.order.map((id) => { const P = this.P[id]; const flags = (P.down ? 1 : 0) | (P.left ? 2 : 0) | (P.respawning ? 4 : 0) | (P.crouched ? 8 : 0); return [id, Math.round(P.x * 10), Math.round(P.y * 10), Math.round(P.z * 10), Math.round((P.yaw ?? 0) * 100), Math.round(P.hp), flags, P.stones, P.carrying]; });\n    const a = g.actors.list.filter((x) => x.ctrl && x.kind !== 'merc').slice(0, 26).map((x) => [x.id, Math.round(x.x * 10), Math.round(x.z * 10), Math.round(x.yaw * 10), (STATE_CODE[x.state] ?? 0) + 10 * Math.max(0, FACTIONS.indexOf(x.faction)), Math.round(x.hp)]);\n    const c = this.cases.map((k) => [k.i, Math.round(k.x), Math.round(k.z), k.carrier, k.banked ? 1 : k.burned ? 2 : 0]);\n    return { t: 's', at: Math.round(this.s.time()), p, a, c };\n  }\n  onSnapshot(d) {\n    if (d.at < (this.lastAt ?? -1e12)) return; this.lastAt = d.at;\n    const g = this.game;\n    for (const row of d.p) {\n      const P = this.P[row[0]]; if (!P) continue;\n      const flags = row[6];\n      P.left = !!(flags & 2); P.hp = row[5]; P.stones = row[7]; P.carrying = row[8];\n      if (P.local) {\n        const wasDown = P.down; P.down = !!(flags & 1); P.respawning = !!(flags & 4);\n        if (P.down && !wasDown) this.downLocal();\n        if (wasDown && !P.down && !P.respawning) this.upLocal();\n        if (!P.down && this.wasRespawn && !P.respawning) { g.player.teleport(P.spawn[0], P.spawn[1]); g.player.downT = 0; }\n        this.wasRespawn = P.respawning;\n        continue;\n      }\n      P.down = !!(flags & 1); P.respawning = !!(flags & 4); P.crouched = !!(flags & 8);\n      P.tx = row[1] / 10; P.ty = row[2] / 10; P.tz = row[3] / 10; P.tyaw = row[4] / 100;\n    }\n    // Soldiers are puppets, interpolated 150 ms behind.\n    const seen = new Set();\n    for (const r of d.a) {\n      seen.add(r[0]);\n      let a = this.puppets.get(r[0]);\n      const faction = FACTIONS[Math.floor(r[4] / 10)] ?? 'concord';\n      if (!a) { a = g.actors.spawn({ faction, role: 'rifle', x: r[1] / 10, z: r[2] / 10, puppet: true, duty: 'guard', yaw: r[3] / 10 }); a.tx = a.x; a.tz = a.z; this.puppets.set(r[0], a); }\n      a.px = a.tx; a.pz = a.tz; a.tx = r[1] / 10; a.tz = r[2] / 10; a.tyaw = r[3] / 10; a.lerpT = 0;\n      const code = r[4] % 10; a.state = ['idle', 'suspicious', 'alert', 'searching', 'burning'][code]; a.burning = code === 4 ? 1 : 0; a.hp = r[5];\n    }\n    for (const [id, a] of this.puppets) if (!seen.has(id)) { g.actors.kill(a, { silent: true }); this.puppets.delete(id); }\n    for (const r of d.c) { const k = this.cases[r[0]]; if (!k) continue; k.x = r[1]; k.z = r[2]; k.carrier = r[3]; k.banked = r[4] === 1; k.burned = r[4] === 2; k.y = g.world.land.heightAt(k.x, k.z); }\n    if (d.fx) for (const f of d.fx) this.fxExplode(f);\n  }\n  onWorld(d) {\n    const fire = this.game.world.fire;\n    for (let k = 0; k + 1 < d.f.length; k += 2) { const i = d.f[k], st = d.f[k + 1]; if (st === BURNING) { fire.setCell(i, BURNING); fire.burning.push(i); fire.litCount++; } else { const n = fire.burning.indexOf(i); if (n >= 0) fire.burning.splice(n, 1); fire.setCell(i, BURNT); } }\n    for (const x of d.x) this.fxExplode(x);\n    for (const e of d.d) { if (e[0] === 'up' && e[1] === this.me) this.upLocal(); }\n    for (const e of d.b) if (e[0] === 'bank' && e[2] === this.me) { this.game.audio.play('stone'); this.game.notice(`+${e[3]} STONES`); }\n  }\n  onExplosion(x, y, z, r, o) { if (this.isHost) this.wQ.x.push([Math.round(x), Math.round(y), Math.round(z), Math.round(r), o?.big ? 1 : 0]); }\n  fxExplode([x, y, z, r, big]) { const g = this.game, ctx = g.ctx; ctx.particles.burst('blast', [x, y, z]); ctx.lights.request({ position: [x, y + 2, z], color: 0xffa040, intensity: big ? 70 : 34, radius: big ? 70 : 34, lifetime: 0.4, priority: 5 }); g.audio.at(big ? 'explosion' : 'explosion-small', x, y, z, 500, 1); ctx.engine.shake.add(0.3); void r; }\n  queueEv(e) { this.evQ.push(e); }\n  queueShot(f, d, w) { this.evQ.push(['s', w, Math.round(f.x * 100), Math.round(f.y * 100), Math.round(f.z * 100), Math.round(d.x * 1000), Math.round(d.y * 1000), Math.round(d.z * 1000)]); }\n  /** What this player can use near here. */\n  candidates() {\n    const g = this.game, p = g.player, L = this.P[this.me], out = []; if (!L || L.down || L.respawning || !this.inPlay()) return out;\n    const near = (x, z, r) => dist2(x, z, p.x, p.z) < r;\n    if (L.carrying < 0) for (const c of this.cases) if (c.carrier < 0 && !c.banked && !c.burned && near(c.x, c.z, 2.8)) out.push({ x: c.x, z: c.z, y: c.y + 0.3, label: 'TAKE THE CASE', anyAngle: true, fn: () => { if (this.isHost) this.pick(L, c); else this.queueEv(['p', c.i]); } });\n    for (const id of this.order) { const o = this.P[id]; if (o !== L && o.down && near(o.x, o.z, 3)) out.push({ x: o.x, z: o.z, y: o.y + 0.5, label: `BRING UP ${o.name}`, hold: 3, anyAngle: true, fn: () => { if (this.isHost) this.revive(o, L); else this.queueEv(['r', o.id]); } }); }\n    return out;\n  }\n  onLeave(e) {\n    const P = this.P[e.id]; if (!P) return; P.left = true; this.drop(P);\n    if (P.view) { P.view.dispose(); P.view = null; }\n    if (P.collider) { this.game.world.owners.delete(P.collider.handle); this.game.ctx.physics.remove(P.collider); P.collider = null; }\n    if (this.isHost && this.order.every((id) => this.P[id].left || this.P[id].ai)) this.finish();\n  }\n  standings() {\n    const list = this.order.map((id) => this.P[id]).filter((P) => !P.left).sort((a, b) => b.stones - a.stones), groups = [];\n    for (const P of list) { const last = groups[groups.length - 1]; if (last && last.s === P.stones) last.ids.push(P.id); else groups.push({ s: P.stones, ids: [P.id] }); }\n    return groups.map((g) => g.ids);\n  }\n  /** Most stones wins. Called directly from the event handler so it is never late. */\n  finish() {\n    if (this.finished) return; this.finished = true;\n    const present = this.order.map((id) => this.P[id]).filter((P) => !P.left);\n    const scores = {}, stats = {}; for (const P of present) { scores[P.id] = P.stones; stats[P.id] = { Stones: P.stones, Downs: P.downs, Revives: P.revives, Kills: P.kills ?? 0 }; }\n    const awards = [], most = (key) => present.reduce((a, b) => ((b[key] ?? 0) > (a?.[key] ?? 0) ? b : a), null);\n    const m1 = most('revives'), m2 = most('stones'), m3 = most('cellsLit');\n    if (m1?.revives > 0) awards.push({ id: m1.id, title: 'Last Friend', detail: `${m1.revives} brought up` });\n    if (m2?.stones > 0) awards.push({ id: m2.id, title: 'Paid in Full', detail: `${m2.stones} stones` });\n    if (m3?.cellsLit > 0) awards.push({ id: m3.id, title: 'Arsonist', detail: `${m3.cellsLit} cells lit` });\n    this.s.finish({ standings: this.standings(), scores, stats, awards: awards.slice(0, 3) });\n    if (this.s.kind === 'link') this.s.send({ t: 'w', f: [], x: [], d: [], b: [] });\n  }\n  onEnd(e) {\n    if (this.ended) return; this.ended = true;\n    if (this.timer) clearInterval(this.timer);\n    if (this.keyL && typeof window !== 'undefined') window.removeEventListener('keydown', this.keyL);\n    const g = this.game; g.frozen = true;\n    if (this.s.kind === 'hub') { g.audio.silence(); g.ctx.audio.setMuted(true); return; }\n    // On its own, show our own results.\n    const rows = this.order.map((id) => this.P[id]).filter((P) => !P.left).sort((a, b) => b.stones - a.stones).map((P) => ({ name: P.name, score: P.stones }));\n    g.ctx.engine.timeScale = 0; g.releaseLock(); g.ui.push(resultsScreen(g, rows)); void e;\n  }\n  /** Back to the title, outside a hub. */\n  leave() {\n    const g = this.game; this.ended = true; if (this.timer) clearInterval(this.timer);\n    for (const id of this.order) { const P = this.P[id]; P.view?.dispose(); if (P.collider) { g.world.owners.delete(P.collider.handle); g.ctx.physics.remove(P.collider); } }\n    for (const c of this.cases) g.ctx.scene.remove(c.object); g.ctx.scene.remove(this.truck);\n    g.world.fire.visualOnly = false; if (this.prevCell) g.world.fire.onChange = this.prevCell;\n    this.s.close?.();\n    for (const c of Object.values(g.people.npcs)) c.hidden = false; g.people.showFriends();\n    for (const c of g.world.cases) { c.taken = false; c.object.visible = true; }\n    for (const s of Object.values(g.world.sites)) s.dormant = false;\n    g.net = null; g.session = null; g.ctx.engine.timeScale = 1;\n  }\n  // ----- Per frame -----\n  update(dt, realDt) {\n    const g = this.game;\n    if (this.ended) return;\n    if (!this.started && this.ownCard) this.padCard();\n    for (const id of this.order) {\n      const P = this.P[id]; if (P.local || P.ai || P.left || !P.view) continue;\n      if (P.tx !== undefined && !this.isHost) { const k = Math.min(1, realDt * 8); P.x += (P.tx - P.x) * k; P.y += (P.ty - P.y) * k; P.z += (P.tz - P.z) * k; P.yaw = P.tyaw; }\n      const moving = Math.hypot((P.tx ?? P.x) - P.x, (P.tz ?? P.z) - P.z) > 0.05 || (P.speed2 ?? 0) > 0.5;\n      P.view.object.visible = !P.respawning;\n      P.view.place(P.x, P.y, P.z, P.yaw + Math.PI);\n      if (P.down) P.view.setFull('WoundedSit'); else { P.view.setLower(moving ? 'Run' : 'Idle'); P.view.setUpper('AimIdle'); }\n      P.view.update(realDt);\n    }\n    if (!this.isHost) for (const a of this.puppets.values()) { a.lerpT = Math.min(1, (a.lerpT ?? 0) + realDt / 0.1); const px = a.px ?? a.tx, pz = a.pz ?? a.tz; const nx = px + (a.tx - px) * a.lerpT, nz = pz + (a.tz - pz) * a.lerpT; a.moving = Math.hypot(nx - a.x, nz - a.z) > 0.002; a.runFrac = 0.5; a.x = nx; a.z = nz; a.y = g.world.land.heightAt(nx, nz); a.yaw = a.tyaw; }\n    for (const c of this.cases) { const show = !c.banked && !c.burned; c.object.visible = show; if (show) { if (c.carrier === this.me) c.object.visible = false; c.object.position.set(c.x, (c.carrier >= 0 ? c.y + 1.1 : c.y + 0.03), c.z); } }\n    void dt;\n  }\n  padCard() {\n    const g = this.game, input = g.ctx.input;\n    if (input.wasPressed('PadCross')) this.s.answer('ready');\n    if (input.wasPressed('PadTriangle')) this.s.answer('more');\n    for (const e of input.buttonEvents) if (!e.down) { const [x, y] = g.ui.pointerXY(e); if (y > g.ctx.hud.height - 56 && y < g.ctx.hud.height - 30) this.s.answer(x < g.ctx.hud.width / 2 ? 'ready' : 'more'); }\n  }\n  drawHud(realDt) {\n    const g = this.game, h = g.ctx.hud, t = this.time();\n    if (!this.started && this.ownCard) { this.drawCard(); return; }\n    g.hud.drawPlay(realDt);\n    if (this.ended) return;\n    const L = this.P[this.me];\n    if (t < 0 && t > -Infinity) { h.text(0, 110, String(Math.ceil(-t / 1000)), { anchor: 'top', scale: 4, color: 'sand' }); }\n    const left = Math.max(0, ROUND_MS - t), mm = Math.floor(left / 60000), ss = Math.floor(left / 1000) % 60;\n    if (t >= 0) h.text(0, 6, `${mm}:${String(ss).padStart(2, '0')}`, { anchor: 'top', color: 'white' });\n    let y = 18; for (const id of [...this.order].sort((a, b) => this.P[b].stones - this.P[a].stones)) { const P = this.P[id]; if (P.left) continue; h.rect(8, y, 6, 7, colorName(P.color)); h.text(18, y, `${P.name} ${P.stones}${P.carrying >= 0 ? ' *' : ''}${P.down ? ' DOWN' : ''}`, { color: P.local ? 'sand' : 'white' }); y += 10; }\n    // Cases show as a marker when close.\n    if (L) for (const c of this.cases) if (!c.banked && !c.burned && c.carrier < 0 && dist2(c.x, c.z, L.x, L.z) < 40) { const s = g.hud.world(c.x, c.y + 1.2, c.z); if (s) h.text(Math.round(s[0]) - 3, Math.round(s[1]), 'v', { color: 'sand' }); }\n    if (L?.carrying >= 0) { const s = g.hud.world(TRUCK[0], g.world.land.heightAt(TRUCK[0], TRUCK[1]) + 3, TRUCK[1]); if (s) h.text(Math.round(s[0]) - 12, Math.round(s[1]), 'BANK', { color: 'lime' }); }\n    if (L?.down) h.text(0, 100, `BLEEDING: ${Math.ceil(L.downT)}`, { anchor: 'top', scale: 2, color: 'red' });\n    if (L?.respawning) h.text(0, 100, 'BACK AT THE ROAD SOON', { anchor: 'top', scale: 2, color: 'mist' });\n    for (const id of this.order) { const P = this.P[id]; if (P.local || P.left || !P.down) continue; const s = g.hud.world(P.x, P.y + 1.4, P.z); if (s) { h.rect(Math.round(s[0]) - 1, Math.round(s[1]) - 5, 3, 11, 'lime'); h.rect(Math.round(s[0]) - 5, Math.round(s[1]) - 1, 11, 3, 'lime'); } }\n  }\n  drawCard() {\n    const g = this.game, h = g.ctx.hud, c = this.card, W = h.width;\n    h.rect(0, 0, W, 34, 'ink'); h.rect(0, h.height - 96, W, 96, 'ink');\n    h.text(0, 8, GAME_TITLE.toUpperCase(), { anchor: 'top', scale: 2, color: 'sand' });\n    let x = 24; for (const id of this.order) { const P = this.P[id], ready = c?.ready?.includes(id); h.rect(x, 40, 6, 7, colorName(P.color)); h.text(x + 9, 40, `${P.name}${ready ? ' READY' : ''}`, { color: ready ? 'lime' : 'white' }); x += 100; }\n    h.text(0, h.height - 90, 'CARRY THE MOST DIAMOND CASES OUT OF THE BURNING MINE.', { anchor: 'top', color: 'white' });\n    h.text(0, h.height - 78, 'ONE CASE AT A TIME, TO THE TRUCK SOUTH OF THE PIT. FRIENDLY FIRE IS ON.', { anchor: 'top', color: 'mist' });\n    let px = 24; const y = h.height - 64; for (const [a, t] of [['fire', 'FIRE'], ['aim', 'AIM'], ['use', 'USE'], ['throw', 'BOTTLE'], ['heal', 'SYRETTE']]) px += g.hud.promptAt(px, y, a, t) + 12;\n    if (c) { const left = c.left === null ? (c.paused ? 'HELD' : 'STARTING') : `${Math.ceil(c.left / 1000)}`; h.text(0, 40, left, { anchor: 'top-right', color: 'sand' }); }\n    h.rect(40, h.height - 46, 150, 18, c?.ready?.includes(this.me) ? 'green' : 'orange'); g.hud.promptAt(50, h.height - 42, 'confirm', 'READY');\n    h.rect(W - 190, h.height - 46, 150, 18, 'night'); const more = g.device === 'pad' ? 'zoom' : null; if (more) g.hud.promptAt(W - 180, h.height - 42, 'zoom', 'MORE TIME'); else { h.text(W - 180, h.height - 40, '[M] MORE TIME', { color: 'white' }); g.hud.prompts.push('[M] MORE TIME'); }\n    h.text(0, h.height - 22, c?.asking ? `${c.asking} ASKED FOR MORE TIME` : '', { anchor: 'top', color: 'mist' });\n  }\n  summary() { return { players: this.order.map((id) => ({ id, stones: this.P[id].stones, down: this.P[id].down, hp: this.P[id].hp, carrying: this.P[id].carrying })), cases: this.cases.map((c) => ({ banked: c.banked, burned: c.burned, carrier: c.carrier })), started: this.started, finished: !!this.finished, ended: this.ended, time: this.time() }; }\n}\nfunction colorName(hex) { return { '#e8443a': 'red', '#3b82f6': 'blue', '#22c55e': 'green', '#f5b700': 'sand' }[hex] ?? 'mist'; }\nvoid FIRE_N;\nEOF\nmkdir -p tests/suites; cat > tests/run.mjs <<'EOF'\n// One command: prints only failures and a one-line count. `--all` ignores stamps; `--only <suite>` runs one.\nimport { execFile } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nconst root = resolve(import.meta.dirname, '..'); process.chdir(root);\nconst argv = process.argv.slice(2), all = argv.includes('--all'), only = argv.includes('--only') ? argv[argv.indexOf('--only') + 1] : null;\nconst walk = (d) => readdirSync(d).flatMap((f) => { const p = join(d, f); return statSync(p).isDirectory() ? walk(p) : [p]; });\nconst SRC = () => walk('src').concat(['tools/build.mjs']);\nconst SUITES = [\n  { id: 'static', run: 'tests/suites/static.mjs', covers: () => [...SRC(), 'tests/suites/static.mjs'] },\n  { id: 'systems', run: 'tests/suites/systems.mjs', covers: () => [...SRC(), 'tests/suites/systems.mjs', 'tests/lib/boot.mjs'] },\n  { id: 'playthrough', run: 'tests/suites/playthrough.mjs', covers: () => [...SRC(), 'tests/suites/playthrough.mjs', 'tests/lib/bot.mjs'] },\n  { id: 'replay', run: 'tests/suites/replay.mjs', covers: () => [...SRC(), 'tests/suites/replay.mjs'] },\n  { id: 'browser', run: 'tests/suites/browser.mjs', covers: () => [...SRC(), 'tests/suites/browser.mjs'] },\n  { id: 'hub', run: 'tests/suites/hub.mjs', covers: () => [...SRC(), 'tests/suites/hub.mjs', 'vendor/session.js'] },\n  { id: 'link', run: 'tests/suites/link.mjs', covers: () => [...SRC(), 'tests/suites/link.mjs'] },\n];\nconst hash = (files) => { const h = createHash('sha1'); for (const f of files) h.update(readFileSync(f)); return h.digest('hex'); };\nconst stampsFile = 'tests/.stamps.json', stamps = existsSync(stampsFile) ? JSON.parse(readFileSync(stampsFile, 'utf8')) : {};\nlet passed = 0, failed = 0, skipped = 0, built = false;\nconst runOne = (s) => new Promise((res) => { execFile('node', [s.run], { maxBuffer: 1 << 28, timeout: 3000000 }, (err, stdout, stderr) => res({ err, stdout, stderr })); });\nfor (const s of SUITES) {\n  if (only && s.id !== only) continue;\n  if (!existsSync(s.run)) continue;\n  const h = hash(s.covers().filter(existsSync));\n  if (!all && !only && stamps[s.id] === h) { skipped++; continue; }\n  if (['browser', 'hub', 'link'].includes(s.id) && !built) { const r = await new Promise((res) => execFile('node', ['tools/build.mjs'], (e, o, er) => res({ e, er }))); if (r.e) { console.log('BUILD FAILED', String(r.er).slice(0, 2000)); process.exit(1); } built = true; }\n  const { err, stdout, stderr } = await runOne(s);\n  const m = /(\\d+) passed, (\\d+) failed/.exec(stdout);\n  if (m) { passed += +m[1]; failed += +m[2]; }\n  const lines = stdout.split('\\n').filter((l) => l.startsWith('FAIL'));\n  for (const l of lines) console.log(`[${s.id}] ${l}`);\n  if (!m || err) { failed++; console.log(`[${s.id}] CRASHED: ${String(err?.message ?? '').slice(0, 300)}\\n${stderr.slice(-1500)}`); }\n  else if (+m[2] === 0) stamps[s.id] = h; else delete stamps[s.id];\n  writeFileSync(stampsFile, JSON.stringify(stamps));\n}\nconsole.log(`${passed} passed, ${failed} failed, ${skipped} suites unchanged`);\nprocess.exit(failed ? 1 : 0);\nEOF\ncat > tests/suites/hub.mjs <<'EOF'\n// All four scenarios the hub uses, against the built file, one at a time.\nimport { spawn } from 'node:child_process';\nimport { copyFileSync, mkdirSync } from 'node:fs';\nimport { basename, resolve } from 'node:path';\nimport { chromium } from 'playwright';\nconst root = resolve(import.meta.dirname, '..', '..'), site = resolve(root, 'tests/.site');\nmkdirSync(site, { recursive: true });\ncopyFileSync(resolve(root, '..', `${basename(root)}.html`), resolve(site, 'game.html'));\nfor (const f of ['harness.html', 'bridge.js', 'round.js']) copyFileSync(resolve(root, 'vendor/hub', f), resolve(site, f));\nconst server = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: site, stdio: ['ignore', 'pipe', 'pipe'] });\nconst port = await new Promise((res) => { let b = ''; const on = (d) => { b += d; const m = /port (\\d+)/.exec(b); if (m) res(+m[1]); }; server.stdout.on('data', on); server.stderr.on('data', on); });\nconst FLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'];\nlet pass = 0, fail = 0;\nconst only = process.env.HUB_ONLY;\nconst SCEN = ['players=2&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave', 'players=2&auto=1&scenario=server'];\nconst browser = await chromium.launch({ args: FLAGS });\ntry {\n  const ctx0 = await browser.newContext(); const p0 = await ctx0.newPage(); await p0.goto(`http://127.0.0.1:${port}/game.html?notgame=1`, { waitUntil: 'commit' }); const title = await p0.title().catch(() => ''); await ctx0.close();\n  if (!/Far Dry Season/.test(title)) { console.log(`FAIL page title is ${title}`); fail++; }\n  for (const sc of SCEN) {\n    if (only && !sc.includes(only)) continue;\n    const ctx = await browser.newContext({ viewport: { width: 1280, height: 720 } }), page = await ctx.newPage();\n    await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${sc}`);\n    try {\n      await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 280000 });\n      const r = await page.evaluate(() => window.__hubCheck);\n      if (r.pass) pass++; else { fail++; for (const c of r.checks.filter((k) => !k.ok && !k.pass)) console.log(`FAIL ${sc}: ${c.name}: ${String(c.detail ?? '').slice(0, 240)}`); }\n    } catch (e) { fail++; const r = await page.evaluate(() => JSON.stringify(window.__hubCheck?.checks?.slice?.(-6) ?? null)).catch(() => ''); console.log(`FAIL ${sc}: timed out ${String(e).slice(0, 80)} ${String(r).slice(0, 500)}`); }\n    await ctx.close();\n  }\n} finally { await browser.close(); server.kill(); }\nconsole.log(`${pass} passed, ${fail} failed`);\nEOF\ngrep -n \"__hubCheck\\s*=\" -A4 vendor/hub/harness.html | cut -c1-200 | head; grep -n \"function check\" -A3 vendor/hub/harness.html | cut -c1-200; node tools/build.mjs 2>&1 | tail -2 | cut -c1-300; timeout 280 node tests/lib/smoke.mjs 2>&1 | tail -2 | cut -c1-200; HUB_ONLY='players=2&auto=1' timeout 280 node tests/suites/hub.mjs 2>&1 | cut -c1-700 | tail -14","description":"Write netcode, test runner and hub suite; run first hub scenario","timeout":590000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":876,"cache_read_input_tokens":552624,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":876},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"98060110-4ead-4574-964f-daef0a492581","uuid":"1f10e64e-604b-45c3-8070-4bcae188a2ca","timestamp":"2026-11-06T00:17:56.928Z","request_id":"req_011Cgki6XWiEeeRN7cwpi6kG","wire_tool_inputs":{"toolu_01XEkkisryF5JmSLaLRYf69H":{"command":"python3 - <<'EOF'\np='src/world/sky.js'; s=open(p).read()\ns=s.replace(\"groundFog({ color: 0xd98a4e, top: -60, amount: 0.55, near: 200, far: 950 })\",\"groundFog({ color: 0xd98a4e, top: 0.01, amount: 0.8, near: 160, far: 950 })\")\ns=s.replace(\"clamp(0.55 + this.dust * 0.3 + this.storm * 0.25, 0, 0.95)\",\"clamp(0.8 + this.dust * 0.5 + this.storm * 0.4, 0, 1.6)\")\nopen(p,'w').write(s)\np='src/combat/viewmodel.js'; s=open(p).read()\ns=s.replace(\"\"\"const make = (def, clips, rig) => {\n      const b = buildModel(def, { catalog: CATALOG });\n      b.object.rotation.y = Math.PI;\"\"\",\"\"\"const make = (def, clips, rig, z = 0) => {\n      const b = buildModel(def, { catalog: CATALOG });\n      b.object.rotation.y = Math.PI; b.object.position.z = z;\"\"\")\ns=s.replace(\"this.rigs[id] = make(def, GUN_CLIPS[id], GUN_RIG);\",\"this.rigs[id] = make(def, GUN_CLIPS[id], GUN_RIG, -0.3);\")\ns=s.replace(\"this.rigs.mg = make(vmMg, GUN_CLIPS.mg, GUN_RIG);\",\"this.rigs.mg = make(vmMg, GUN_CLIPS.mg, GUN_RIG, -0.3);\")\ns=s.replace(\"lerp(swayX, 0.127, this.adsK)\",\"lerp(swayX, -0.127, this.adsK)\")\ns=s.replace(\"lerp(0, 0.1, this.adsK) + (st.kick ?? 0)\",\"lerp(0, 0.06, this.adsK) + (st.kick ?? 0)\")\nopen(p,'w').write(s)\np='src/ui/prompts.js'; s=open(p).read()\ns=s.replace(\"\"\"  candidates() {\n    const g = this.game, p = g.player, out = [], px = p.x, pz = p.z;\"\"\",\"\"\"  candidates() {\n    const g = this.game, p = g.player, out = [], px = p.x, pz = p.z;\n    if (g.net) return g.net.candidates();\"\"\")\nopen(p,'w').write(s)\np='src/world/fire.js'; s=open(p).read()\ns=s.replace(\"if (i < 0 || this.state[i] !== FRESH || !this.fuel[i]) return false;\",\"if (this.visualOnly || i < 0 || this.state[i] !== FRESH || !this.fuel[i]) return false;\")\nopen(p,'w').write(s)\np='src/combat/weapons.js'; s=open(p).read()\ns=s.replace(\"\"\"    const hit = this.lastHit;\n    if (tracer)\"\"\",\"\"\"    const hit = this.lastHit;\n    if (this.game.net && !this.game.net.isHost) { // A client: its shot is decided by the host.\n      this.game.net.queueShot(from, dir, w.id);\n      if (tracer) this.tracer(eye, hit ? hit.point : { x: from.x + dir.x * w.range, y: from.y + dir.y * w.range, z: from.z + dir.z * w.range });\n      if (hit) this.ctx.particles.burst('mud', [hit.point.x, hit.point.y, hit.point.z]);\n      return;\n    }\n    if (tracer)\"\"\")\ns=s.replace(\"\"\"  flareImpact(x, y, z, hit, by) {\n    const game = this.game, owner\"\"\",\"\"\"  flareImpact(x, y, z, hit, by) {\n    if (this.game.net && !this.game.net.isHost) { this.game.net.queueEv(['i', Math.round(x), Math.round(z), 3]); this.ctx.particles.burst('sparks', [x, y, z], { count: 12 }); this.game.audio.at('flare-hiss', x, y, z, 60); return; }\n    const game = this.game, owner\"\"\")\ns=s.replace(\"\"\"  bottleImpact(x, y, z, hit, by) {\n    const game = this.game, owner\"\"\",\"\"\"  bottleImpact(x, y, z, hit, by) {\n    if (this.game.net && !this.game.net.isHost) { this.game.net.queueEv(['i', Math.round(x), Math.round(z), 6]); this.ctx.particles.burst('blast', [x, y + 0.5, z], { count: 18 }); this.game.audio.at('bottle-smash', x, y, z, 60); return; }\n    const game = this.game, owner\"\"\")\ns=s.replace(\"\"\"    if (game.net) game.net.onIgnite?.(x, z, 3, by);\n\"\"\",\"\").replace(\"\"\"    if (game.net) game.net.onIgnite?.(x, z, 4, by);\n\"\"\",\"\")\nopen(p,'w').write(s)\np='src/actors/soldier.js'; s=open(p).read()\ns=s.replace(\"\"\"    for (const t of this.targetsOf(a)) {\n      if (!this.hostileTo(a, t) || t.hidden) continue;\"\"\",\"\"\"    for (const t of this.targetsOf(a)) {\n      if (t.actor === a || !this.hostileTo(a, t) || t.hidden || t.down) continue;\"\"\")\ns=s.replace(\"\"\"      a.ctrl = new CharacterController(ctx.physics, { position: [def.x, y + (def.y ?? 0) * 0 + 0.05, def.z]\"\"\",\"\"\"      a.ctrl = new CharacterController(ctx.physics, { position: [def.x, y + 0.05, def.z]\"\"\")\ns=s.replace(\"\"\"if (Math.hypot(a.x - x, a.z - z) < radius) { a.lastKnown = [x, z];\"\"\",\"\"\"if (Math.hypot(a.x - x, a.z - z) < radius) { if (radius >= 30 && Math.hypot(a.x - x, a.z - z) < radius * 0.4) a.provokedBy = true; a.lastKnown = [x, z];\"\"\")\nopen(p,'w').write(s)\np='src/game.js'; s=open(p).read()\ns=s.replace(\"\"\"  ready(ctx) { if (typeof window !== 'undefined') window.__GAME__ = this; this.pageHooks(ctx); }\"\"\",\"\"\"  ready(ctx) { if (typeof window !== 'undefined') window.__GAME__ = this; this.pageHooks(ctx); this.net?.onEngineReady(); }\n  /** Cash Run outside a hub session: solo with hired guns, or two windows on one computer. */\n  startCashRun(kind) {\n    this.ui.clear();\n    if (kind === 'solo') { this.beginRoundFrom(soloSession(this)); return; }\n    const session = linkSession({ host: kind === 'host', name: kind === 'host' ? 'HOST' : 'GUEST' });\n    this.linkPending = session;\n    this.ui.push({ id: 'link-lobby', cover: 'ink', title: 'CASH RUN', sub: kind === 'host' ? 'WAITING FOR THE OTHER WINDOW. OPEN THIS GAME AGAIN AND CHOOSE JOIN.' : 'LOOKING FOR THE OTHER WINDOW.', top: 120, footer: [['back', 'BACK']], items: kind === 'host' ? [{ label: 'START', disabled: () => !session.joined, action: () => session.start() }] : [], back: () => { session.close(); this.linkPending = null; this.ui.pop(); } });\n    session.on('start', () => { this.ui.clear(); this.linkPending = null; this.beginRoundFrom(session); });\n  }\n  beginRoundFrom(session) { this.beginCampaignState(); this.session = session; this.net = new Round(this, session); this.mode = 'round'; this.net.begin(); this.net.onEngineReady(); this.requestLock(); }\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/net/round.js <<'EOF'\n// Cash Run: six minutes, four mercs, one burning valley. The host runs the world; each copy moves its own player.\nimport { buildModel, setLookLayer, THREE } from '../../pixel-engine.js';\nimport { CATALOG } from '../art/models.js';\nimport { PersonView } from '../actors/rig.js';\nimport { FIRE_N, BURNING, BURNT } from '../world/fire.js';\nimport { dist2 } from '../world/geom.js';\nimport { GAME_TITLE } from '../content/title.js';\nimport { TUNING } from '../core/tuning.js';\nimport { held } from '../core/actions.js';\nimport { resultsScreen } from '../ui/screens.js';\nconst { Vector3 } = THREE;\nexport const ROUND_MS = 360000;\nconst SPAWNS = [[60, -350], [255, -270], [130, -205], [40, -170]];\nconst CASE_SPOTS = [[210, -280], [90, -322], [278, -216], [36, -164], [150, -310], [190, -250]];\nexport const TRUCK = [150, -225];\nconst LIVE = new Set(['the-cut', 'p5', 'ranger-post']);\nconst SAFE = (s) => String(s ?? 'MERC').toUpperCase().replace(/[^A-Z0-9 .,:;!?'\"\\-+=/()%_#&*@]/g, '').slice(0, 14) || 'MERC';\nconst STATE_CODE = { idle: 0, suspicious: 1, alert: 2, searching: 3, burning: 4 };\nconst FACTIONS = ['concord', 'harvest', 'deserter'];\nconst from = new Vector3(), dir = new Vector3();\nexport class Round {\n  P = {}; order = []; cases = []; ended = false; started = false; evQ = []; wQ = { f: [], x: [], d: [], b: [] }; puppets = new Map(); snaps = []; banks = 0; tSend = {}; card = null; hasReady = false;\n  constructor(game, session) { this.game = game; this.s = session; this.isHost = session.isHost; this.me = session.me; this.server = !!session.server; }\n  simulating() { return true; }\n  async begin() {\n    const g = this.game, s = this.s, w = g.world, p = g.player;\n    g.cheats.god = false; g.mode = 'round';\n    this.rng = s.rng('round');\n    for (const c of w.cases) { c.taken = true; c.object.visible = false; }\n    w.fire.visualOnly = !this.isHost;\n    w.setHour(16.2, true); w.pinWind({ dir: [Math.cos(this.rng() * 6.28), Math.sin(this.rng() * 6.28)], speed: 4.5 }); w.windPin = null;\n    w.sites['the-cut'].dormant = false;\n    for (const site of Object.values(w.sites)) { site.dormant = !LIVE.has(site.id); site.cleared = false; }\n    for (const c of Object.values(g.people.npcs)) c.hidden = true;\n    for (const c of g.people.civs) c.view.object.visible = false;\n    g.story.feverOn = false;\n    // The truck you bank at.\n    const ty = w.land.heightAt(TRUCK[0], TRUCK[1]), truck = buildModel('cargo-truck', { catalog: CATALOG });\n    truck.object.position.set(TRUCK[0], ty + 1.1, TRUCK[1]); truck.object.rotation.y = 1.5; setLookLayer(truck.object, 'actors'); g.ctx.scene.add(truck.object); this.truck = truck.object;\n    // Players.\n    this.order = s.players.map((q) => q.id);\n    for (const q of s.players) {\n      const spawn = SPAWNS[q.id % 4], color = q.color;\n      const P = { id: q.id, name: SAFE(q.name), color, kind: 'player', x: spawn[0], y: w.land.heightAt(spawn[0], spawn[1]) + 0.1, z: spawn[1], yaw: 0, pitch: 0, hp: 100, stance: 0, crouched: false, lit: false, stones: 0, kills: 0, downs: 0, revives: 0, cellsLit: 0, carrying: -1, down: false, downT: 0, respawnT: 0, spawn, left: false, ai: !!q.ai, speed2: 0, burning: 0 };\n      this.P[q.id] = P;\n      if (q.id === this.me && !this.server) { P.local = true; continue; }\n      if (q.ai) { this.spawnMerc(P); continue; }\n      P.view = new PersonView(g.ctx, 'soldier-cloth', { cloth: colorName(color), dark: 'night', hat: colorName(color), strap: 'sand', boot: 'ink', skin: 'orange' }, { gun: true });\n      P.view.place(P.x, P.y, P.z, 0); P.view.setLower('Idle'); P.view.setUpper('AimIdle');\n      if (this.isHost) { P.collider = g.ctx.physics.addStaticCylinder([P.x, P.y + 0.85, P.z], 0.85, 0.34); g.world.own(P.collider, 'player', P); }\n      P.gx = P.x; P.gy = P.y; P.gz = P.z;\n    }\n    // Your kit.\n    if (!this.server) {\n      const L = this.P[this.me];\n      p.guns = { melee: null, sidearm: null, main: null, special: null };\n      g.combat.give('cane', 100, false); g.combat.give('flare', 100, false); g.combat.give('tractor', 70, true);\n      p.syrettes = 2; p.molotovs = 2; p.hp = 100; p.teleport(L.x, L.z); p.setYaw(Math.atan2(-(TRUCK[0] - L.x), -(TRUCK[1] - L.z)), 0); g.story.hasTracker = true;\n    } else { p.teleport(0, 40); p.ctrl.collider.setEnabled(false); }\n    // Cases.\n    this.cases = CASE_SPOTS.map(([x, z], i) => { const b = buildModel('stone-case', { catalog: CATALOG }); const y = w.land.heightAt(x, z); b.object.position.set(x, y + 0.03, z); b.object.scale.setScalar(1.4); setLookLayer(b.object, 'actors'); g.ctx.scene.add(b.object); return { i, x, z, y, stones: 3 + Math.floor(this.rng() * 5), carrier: -1, banked: false, burned: false, object: b.object, burnT: 0 }; });\n    s.on('message', (d, f) => this.onMessage(d, f));\n    s.on('leave', (e) => this.onLeave(e));\n    s.on('time-up', () => { if (this.isHost) this.finish(); });\n    s.on('end', (e) => this.onEnd(e));\n    s.on('start', () => { this.started = true; this.card = null; });\n    s.on('card', (c) => { this.card = c; });\n    if (s.kind === 'hub') { this.ownCard = true; if (typeof window !== 'undefined') { this.keyL = (e) => { if (this.started) return; if (e.code === 'Enter') { s.answer('ready'); this.answered = true; } if (e.code === 'KeyM') s.answer('more'); }; window.addEventListener('keydown', this.keyL); } }\n    if (this.server) { /* main.js says ready */ }\n    if (this.isHost) w.fire.onLit = null;\n    this.prevCell = w.fire.onChange;\n    if (this.isHost) w.fire.onChange = (i, st, was) => { this.prevCell(i, st, was); if (st === BURNING || st === BURNT) { this.wQ.f.push(i, st); } };\n    // Drive sends from a timer, not the render loop: a slow copy's traffic must still flow.\n    if (typeof setInterval !== 'undefined' && (s.kind === 'hub' || s.kind === 'link')) this.timer = setInterval(() => this.netTick(), 50);\n    g.audio.setMusic('title');\n  }\n  onEngineReady() { if (this.hasReady || this.server) return; this.hasReady = true; if (this.s.kind === 'hub') this.s.ready(); else if (this.s.kind === 'solo') this.s.ready(); }\n  time() { return this.s.time(); }\n  inPlay() { const t = this.time(); return this.started && t >= 0; }\n  // ----- AI mercs (solo) -----\n  spawnMerc(P) {\n    const g = this.game, a = g.actors.spawn({ kind: 'merc', faction: 'merc', role: 'rifle', x: P.x, z: P.z, duty: 'walkTo', modelId: 'soldier-cloth', palette: { cloth: colorName(P.color), dark: 'night', hat: colorName(P.color), strap: 'sand', boot: 'ink', skin: 'plum' }, hp: 140 });\n    a.hp = 140; a.maxHp = 140; a.merc = P; a.fireproof = false; P.actor = a; a.provokedBy = true; a.state = 'idle'; a.spec = { ...a.spec, speed: 5 };\n  }\n  mercBrain(P, dt) {\n    const a = P.actor; if (!a?.alive) return;\n    P.x = a.x; P.y = a.y; P.z = a.z; P.yaw = a.yaw; P.hp = (a.hp / a.maxHp) * 100;\n    P.brainT = (P.brainT ?? 0) - dt; if (P.brainT > 0) return; P.brainT = 0.5;\n    if (P.carrying >= 0) { a.goal = TRUCK; }\n    else { let best = null, bd = 1e9; for (const c of this.cases) if (!c.banked && !c.burned && c.carrier < 0) { const d = dist2(c.x, c.z, a.x, a.z); if (d < bd) { bd = d; best = c; } } if (best) { a.goal = [best.x, best.z]; if (bd < 2.6) this.pick(P, best); } else a.goal = TRUCK; }\n    a.goalSpeed = 1;\n  }\n  // ----- Host: the world's messages -----\n  onMessage(d, from) {\n    if (this.ended) return;\n    if (d.t === 'me' && this.isHost) { const P = this.P[from]; if (!P || P.left) return; if (P.seq !== undefined && d.q < P.seq) return; P.seq = d.q; P.gx = d.x / 10; P.gy = d.y / 10; P.gz = d.z / 10; P.yaw = d.w / 100; P.pitch = d.h / 100; P.crouched = !!d.c; P.lit = !!d.l; P.speed2 = d.v ?? 0; }\n    if (d.t === 'ev' && this.isHost) for (const e of d.e) this.onEvent(e, from);\n    if (d.t === 's' && !this.isHost) this.onSnapshot(d);\n    if (d.t === 'w' && !this.isHost) this.onWorld(d);\n  }\n  onEvent(e, id) {\n    const P = this.P[id], g = this.game; if (!P || P.left) return;\n    switch (e[0]) {\n      case 's': { // a shot\n        const w = e[1] === 'tractor' ? 24 : e[1] === 'm38' ? 34 : e[1] === 'cane' ? 55 : 24;\n        from.set(e[2] / 100, e[3] / 100, e[4] / 100); dir.set(e[5] / 1000, e[6] / 1000, e[7] / 1000).normalize();\n        const hit = g.ctx.physics.castRay(from, dir, 120, undefined, P.colliderBody);\n        if (hit) { const owner = g.world.owners.get(hit.collider.handle); if (owner?.ref === P) break; g.combat.applyHit(hit, w * TUNING.weaponDamage, P, { dir, from }); }\n        g.actors.hearShot(from.x, from.z, 120, null);\n        break;\n      }\n      case 'i': g.world.fire.ignite(e[1], e[2], e[3], P); P.cellsLit += 3; break;\n      case 'p': { const c = this.cases[e[1]]; if (c) this.pick(P, c); break; }\n      case 'h': P.hp = Math.min(100, P.hp + 40); break;\n      case 'r': { const o = this.P[e[1]]; if (o?.down && dist2(o.x, o.z, P.x, P.z) < 4) this.revive(o, P); break; }\n    }\n  }\n  pick(P, c) { if (c.carrier >= 0 || c.banked || c.burned || P.carrying >= 0 || P.down || dist2(c.x, c.z, P.x, P.z) > 4) return; c.carrier = P.id; P.carrying = c.i; c.burnT = 0; }\n  revive(o, by) { o.down = false; o.hp = 40; o.downT = 0; by.revives++; this.wQ.d.push(['up', o.id]); if (o.local) this.upLocal(); }\n  upLocal() { const p = this.game.player; p.downT = 0; this.game.cam.override = null; p.hp = 40; }\n  drop(P) { if (P.carrying >= 0) { const c = this.cases[P.carrying]; c.carrier = -1; c.x = P.x; c.z = P.z; c.y = this.game.world.land.heightAt(P.x, P.z); P.carrying = -1; } }\n  damageLocal(dmg, o) { this.hurt(this.P[this.me], dmg, o); }\n  damageRemote(ref, dmg, o) { this.hurt(ref, dmg, o); }\n  hurt(P, dmg, o = {}) {\n    if (!P || P.down || P.left || !this.inPlay()) return;\n    P.hp -= dmg * TUNING.playerDamageTaken; P.regenT = 0;\n    if (P.local) { const g = this.game; g.player.hp = P.hp; g.body.regenT = 0; g.hud.touch(); g.flashBlood = 0.2; g.ctx.engine.shake.add(0.25); g.audio.play('hit-flesh'); }\n    if (P.hp <= 0) this.goDown(P, o);\n  }\n  goDown(P, o) {\n    P.hp = 0; P.down = true; P.downT = 25; P.downs++; this.drop(P);\n    if (o?.by?.kind === 'player' && o.by !== P) o.by.kills = (o.by.kills ?? 0) + 0;\n    this.wQ.d.push(['down', P.id]);\n    if (P.local) this.downLocal();\n  }\n  downLocal() { const g = this.game, p = g.player; p.downT = 1e9; p.mapUp = false; g.combat.stopStream(); g.talk.say('you', 'YOU ARE BLEEDING OUT. SOMEONE MAY COME. SOMEONE MAY TAKE THE CASE.', 5); }\n  onKill(a, o) { if (a.kind === 'merc') return; if (o.by?.kind === 'player') o.by.kills = (o.by.kills ?? 0) + 1; else { const P = this.P[this.me]; if (P) P.kills++; } }\n  onActorHit() {}\n  targets(out) { for (const id of this.order) { const P = this.P[id]; if (!P.left && !P.down && !P.respawning) out.push(P); } }\n  siteDist(def) { let best = 1e9; for (const id of this.order) { const P = this.P[id]; if (!P.left) best = Math.min(best, dist2(P.x, P.z, def.at[0], def.at[1])); } return best; }\n  siteLive(def) { return this.isHost && LIVE.has(def.id); }\n  // ----- One fixed step -----\n  fixed(dt) {\n    const g = this.game, p = g.player;\n    if (this.ended) return;\n    if (this.s.tick) this.s.tick(dt * 1000);\n    if (this.s.kind === 'solo') { this.started = this.started || this.s.time() > -Infinity; }\n    if (!this.server) {\n      const L = this.P[this.me];\n      if (!L.left) { L.x = p.x; L.y = p.y; L.z = p.z; L.yaw = g.ctx.camera.yaw; L.pitch = g.ctx.camera.pitch; L.crouched = p.crouched; L.lit = p.lit; L.speed2 = p.speed2; p.carrying = L.carrying >= 0; }\n      // Syrette, here on the client; the host knows.\n      if (held(g.ctx.input, 'heal') && p.syrettes > 0 && L.hp < 100 && !L.down) { this.healT = (this.healT ?? 0) + dt; if (this.healT >= 0.8) { this.healT = -1e6; p.syrettes--; g.audio.play('syrette'); if (this.isHost) L.hp = Math.min(100, L.hp + 40); else this.queueEv(['h']); } } else this.healT = 0;\n      p.hp = L.hp;\n    }\n    if (!this.inPlay()) { if (p.ctrl && !this.server) { /* the 3-2-1: stand where you are */ } this.frozenCount(); }\n    if (this.isHost) this.hostFixed(dt);\n    else this.clientFixed(dt);\n    if (this.s.kind === 'solo') this.netTick(dt);\n  }\n  frozenCount() { const g = this.game; g.frozen = !this.inPlay(); }\n  hostFixed(dt) {\n    const g = this.game, f = g.world.fire;\n    if (!this.inPlay()) return;\n    g.frozen = false;\n    for (const id of this.order) {\n      const P = this.P[id]; if (P.left) continue;\n      if (P.actor) this.mercBrain(P, dt);\n      if (!P.local && !P.ai) { // A remote player: their puppet and collider follow their own report.\n        if (P.gx !== undefined) { P.x = P.gx; P.y = P.gy; P.z = P.gz; }\n        if (P.collider) { P.collider.setTranslation?.({ x: P.x, y: P.y + 0.85, z: P.z }); }\n      }\n      if (P.down) { P.downT -= dt; if (P.downT <= 0) { P.down = false; P.respawning = true; P.respawnT = 15; this.wQ.d.push(['gone', P.id]); } continue; }\n      if (P.respawning) { P.respawnT -= dt; if (P.respawnT <= 0) { P.respawning = false; P.hp = 100; this.wQ.d.push(['back', P.id]); if (P.local) { g.player.teleport(P.spawn[0], P.spawn[1]); g.player.downT = 0; g.player.hp = 100; } if (P.ai) { this.spawnMerc(P); } } continue; }\n      // Fire.\n      if (!P.ai && f.isBurning(P.x, P.z)) { P.burning = 2; }\n      if (P.burning > 0) { P.burning -= dt; this.hurt(P, TUNING.fireDamage * dt, { fire: true }); }\n      // Regenerate to the segment top.\n      P.regenT = (P.regenT ?? 0) + dt;\n      if (P.regenT > 5 && P.hp < Math.ceil(P.hp / 20 - 1e-6) * 20) P.hp = Math.min(100, P.hp + dt * 8);\n      // Bank.\n      if (P.carrying >= 0 && dist2(P.x, P.z, TRUCK[0], TRUCK[1]) < 6) this.bank(P);\n    }\n    for (const c of this.cases) {\n      if (c.banked || c.burned) continue;\n      if (c.carrier >= 0) { const P = this.P[c.carrier]; c.x = P.x; c.z = P.z; c.y = P.y; continue; }\n      if (f.isBurning(c.x, c.z)) { c.burnT += dt; if (c.burnT > 6) { c.burned = true; this.wQ.b.push(['burn', c.i]); g.audio.at('explosion-small', c.x, c.y, c.z, 80); } }\n    }\n    if (this.cases.every((c) => c.banked || c.burned) || (this.time() >= ROUND_MS)) this.finish();\n  }\n  bank(P) { const c = this.cases[P.carrying]; c.banked = true; c.carrier = -1; P.carrying = -1; P.stones += c.stones; this.wQ.b.push(['bank', c.i, P.id, c.stones]); if (P.local) { this.game.audio.play('stone'); this.game.notice(`+${c.stones} STONES`); } else this.game.audio.at('stone', c.x, c.y, c.z, 40); }\n  clientFixed(dt) {\n    const g = this.game; if (this.inPlay()) g.frozen = false;\n    const L = this.P[this.me];\n    if (L.down) g.player.downT = 1e9; else if (g.player.downT > 1e6) g.player.downT = 0;\n    void dt;\n  }\n  // ----- The network tick (a timer, or the fixed step for solo) -----\n  netTick() {\n    if (this.ended) return;\n    const now = this.s.time(); if (now === -Infinity) return;\n    const t = this.nowMs = typeof performance !== 'undefined' ? performance.now() : 0;\n    if (this.s.kind === 'solo') return;\n    const due = (k, ms) => { if (t - (this.tSend[k] ?? -1e9) >= ms) { this.tSend[k] = t; return true; } return false; };\n    if (this.isHost) {\n      if (due('s', 100)) this.s.send(this.snapshot(), { reliable: false });\n      if (due('w', 250) && (this.wQ.f.length || this.wQ.x.length || this.wQ.d.length || this.wQ.b.length)) { this.s.send({ t: 'w', ...this.wQ }, { reliable: true }); this.wQ = { f: [], x: [], d: [], b: [] }; }\n    } else {\n      if (due('me', 83)) { const L = this.P[this.me]; this.seq = (this.seq ?? 0) + 1; if (L) this.s.send({ t: 'me', q: this.seq, x: Math.round(L.x * 10), y: Math.round(L.y * 10), z: Math.round(L.z * 10), w: Math.round((L.yaw ?? 0) * 100), h: Math.round((L.pitch ?? 0) * 100), c: L.crouched ? 1 : 0, l: L.lit ? 1 : 0, v: Math.round(L.speed2 ?? 0) }, { to: this.s.host, reliable: false }); }\n      if (due('ev', 200) && this.evQ.length) { this.s.send({ t: 'ev', e: this.evQ.splice(0, 40) }, { to: this.s.host, reliable: true }); }\n    }\n  }\n  snapshot() {\n    const g = this.game, p = this.order.map((id) => { const P = this.P[id]; const flags = (P.down ? 1 : 0) | (P.left ? 2 : 0) | (P.respawning ? 4 : 0) | (P.crouched ? 8 : 0); return [id, Math.round(P.x * 10), Math.round(P.y * 10), Math.round(P.z * 10), Math.round((P.yaw ?? 0) * 100), Math.round(P.hp), flags, P.stones, P.carrying]; });\n    const a = g.actors.list.filter((x) => x.ctrl && x.kind !== 'merc').slice(0, 26).map((x) => [x.id, Math.round(x.x * 10), Math.round(x.z * 10), Math.round(x.yaw * 10), (STATE_CODE[x.state] ?? 0) + 10 * Math.max(0, FACTIONS.indexOf(x.faction)), Math.round(x.hp)]);\n    const c = this.cases.map((k) => [k.i, Math.round(k.x), Math.round(k.z), k.carrier, k.banked ? 1 : k.burned ? 2 : 0]);\n    return { t: 's', at: Math.round(this.s.time()), p, a, c };\n  }\n  onSnapshot(d) {\n    if (d.at < (this.lastAt ?? -1e12)) return; this.lastAt = d.at;\n    const g = this.game;\n    for (const row of d.p) {\n      const P = this.P[row[0]]; if (!P) continue;\n      const flags = row[6];\n      P.left = !!(flags & 2); P.hp = row[5]; P.stones = row[7]; P.carrying = row[8];\n      if (P.local) {\n        const wasDown = P.down; P.down = !!(flags & 1); P.respawning = !!(flags & 4);\n        if (P.down && !wasDown) this.downLocal();\n        if (wasDown && !P.down && !P.respawning) this.upLocal();\n        if (!P.down && this.wasRespawn && !P.respawning) { g.player.teleport(P.spawn[0], P.spawn[1]); g.player.downT = 0; }\n        this.wasRespawn = P.respawning;\n        continue;\n      }\n      P.down = !!(flags & 1); P.respawning = !!(flags & 4); P.crouched = !!(flags & 8);\n      P.tx = row[1] / 10; P.ty = row[2] / 10; P.tz = row[3] / 10; P.tyaw = row[4] / 100;\n    }\n    // Soldiers are puppets, interpolated 150 ms behind.\n    const seen = new Set();\n    for (const r of d.a) {\n      seen.add(r[0]);\n      let a = this.puppets.get(r[0]);\n      const faction = FACTIONS[Math.floor(r[4] / 10)] ?? 'concord';\n      if (!a) { a = g.actors.spawn({ faction, role: 'rifle', x: r[1] / 10, z: r[2] / 10, puppet: true, duty: 'guard', yaw: r[3] / 10 }); a.tx = a.x; a.tz = a.z; this.puppets.set(r[0], a); }\n      a.px = a.tx; a.pz = a.tz; a.tx = r[1] / 10; a.tz = r[2] / 10; a.tyaw = r[3] / 10; a.lerpT = 0;\n      const code = r[4] % 10; a.state = ['idle', 'suspicious', 'alert', 'searching', 'burning'][code]; a.burning = code === 4 ? 1 : 0; a.hp = r[5];\n    }\n    for (const [id, a] of this.puppets) if (!seen.has(id)) { g.actors.kill(a, { silent: true }); this.puppets.delete(id); }\n    for (const r of d.c) { const k = this.cases[r[0]]; if (!k) continue; k.x = r[1]; k.z = r[2]; k.carrier = r[3]; k.banked = r[4] === 1; k.burned = r[4] === 2; k.y = g.world.land.heightAt(k.x, k.z); }\n    if (d.fx) for (const f of d.fx) this.fxExplode(f);\n  }\n  onWorld(d) {\n    const fire = this.game.world.fire;\n    for (let k = 0; k + 1 < d.f.length; k += 2) { const i = d.f[k], st = d.f[k + 1]; if (st === BURNING) { fire.setCell(i, BURNING); fire.burning.push(i); fire.litCount++; } else { const n = fire.burning.indexOf(i); if (n >= 0) fire.burning.splice(n, 1); fire.setCell(i, BURNT); } }\n    for (const x of d.x) this.fxExplode(x);\n    for (const e of d.d) { if (e[0] === 'up' && e[1] === this.me) this.upLocal(); }\n    for (const e of d.b) if (e[0] === 'bank' && e[2] === this.me) { this.game.audio.play('stone'); this.game.notice(`+${e[3]} STONES`); }\n  }\n  onExplosion(x, y, z, r, o) { if (this.isHost) this.wQ.x.push([Math.round(x), Math.round(y), Math.round(z), Math.round(r), o?.big ? 1 : 0]); }\n  fxExplode([x, y, z, r, big]) { const g = this.game, ctx = g.ctx; ctx.particles.burst('blast', [x, y, z]); ctx.lights.request({ position: [x, y + 2, z], color: 0xffa040, intensity: big ? 70 : 34, radius: big ? 70 : 34, lifetime: 0.4, priority: 5 }); g.audio.at(big ? 'explosion' : 'explosion-small', x, y, z, 500, 1); ctx.engine.shake.add(0.3); void r; }\n  queueEv(e) { this.evQ.push(e); }\n  queueShot(f, d, w) { this.evQ.push(['s', w, Math.round(f.x * 100), Math.round(f.y * 100), Math.round(f.z * 100), Math.round(d.x * 1000), Math.round(d.y * 1000), Math.round(d.z * 1000)]); }\n  /** What this player can use near here. */\n  candidates() {\n    const g = this.game, p = g.player, L = this.P[this.me], out = []; if (!L || L.down || L.respawning || !this.inPlay()) return out;\n    const near = (x, z, r) => dist2(x, z, p.x, p.z) < r;\n    if (L.carrying < 0) for (const c of this.cases) if (c.carrier < 0 && !c.banked && !c.burned && near(c.x, c.z, 2.8)) out.push({ x: c.x, z: c.z, y: c.y + 0.3, label: 'TAKE THE CASE', anyAngle: true, fn: () => { if (this.isHost) this.pick(L, c); else this.queueEv(['p', c.i]); } });\n    for (const id of this.order) { const o = this.P[id]; if (o !== L && o.down && near(o.x, o.z, 3)) out.push({ x: o.x, z: o.z, y: o.y + 0.5, label: `BRING UP ${o.name}`, hold: 3, anyAngle: true, fn: () => { if (this.isHost) this.revive(o, L); else this.queueEv(['r', o.id]); } }); }\n    return out;\n  }\n  onLeave(e) {\n    const P = this.P[e.id]; if (!P) return; P.left = true; this.drop(P);\n    if (P.view) { P.view.dispose(); P.view = null; }\n    if (P.collider) { this.game.world.owners.delete(P.collider.handle); this.game.ctx.physics.remove(P.collider); P.collider = null; }\n    if (this.isHost && this.order.every((id) => this.P[id].left || this.P[id].ai)) this.finish();\n  }\n  standings() {\n    const list = this.order.map((id) => this.P[id]).filter((P) => !P.left).sort((a, b) => b.stones - a.stones), groups = [];\n    for (const P of list) { const last = groups[groups.length - 1]; if (last && last.s === P.stones) last.ids.push(P.id); else groups.push({ s: P.stones, ids: [P.id] }); }\n    return groups.map((g) => g.ids);\n  }\n  /** Most stones wins. Called directly from the event handler so it is never late. */\n  finish() {\n    if (this.finished) return; this.finished = true;\n    const present = this.order.map((id) => this.P[id]).filter((P) => !P.left);\n    const scores = {}, stats = {}; for (const P of present) { scores[P.id] = P.stones; stats[P.id] = { Stones: P.stones, Downs: P.downs, Revives: P.revives, Kills: P.kills ?? 0 }; }\n    const awards = [], most = (key) => present.reduce((a, b) => ((b[key] ?? 0) > (a?.[key] ?? 0) ? b : a), null);\n    const m1 = most('revives'), m2 = most('stones'), m3 = most('cellsLit');\n    if (m1?.revives > 0) awards.push({ id: m1.id, title: 'Last Friend', detail: `${m1.revives} brought up` });\n    if (m2?.stones > 0) awards.push({ id: m2.id, title: 'Paid in Full', detail: `${m2.stones} stones` });\n    if (m3?.cellsLit > 0) awards.push({ id: m3.id, title: 'Arsonist', detail: `${m3.cellsLit} cells lit` });\n    this.s.finish({ standings: this.standings(), scores, stats, awards: awards.slice(0, 3) });\n    if (this.s.kind === 'link') this.s.send({ t: 'w', f: [], x: [], d: [], b: [] });\n  }\n  onEnd(e) {\n    if (this.ended) return; this.ended = true;\n    if (this.timer) clearInterval(this.timer);\n    if (this.keyL && typeof window !== 'undefined') window.removeEventListener('keydown', this.keyL);\n    const g = this.game; g.frozen = true;\n    if (this.s.kind === 'hub') { g.audio.silence(); g.ctx.audio.setMuted(true); return; }\n    // On its own, show our own results.\n    const rows = this.order.map((id) => this.P[id]).filter((P) => !P.left).sort((a, b) => b.stones - a.stones).map((P) => ({ name: P.name, score: P.stones }));\n    g.ctx.engine.timeScale = 0; g.releaseLock(); g.ui.push(resultsScreen(g, rows)); void e;\n  }\n  /** Back to the title, outside a hub. */\n  leave() {\n    const g = this.game; this.ended = true; if (this.timer) clearInterval(this.timer);\n    for (const id of this.order) { const P = this.P[id]; P.view?.dispose(); if (P.collider) { g.world.owners.delete(P.collider.handle); g.ctx.physics.remove(P.collider); } }\n    for (const c of this.cases) g.ctx.scene.remove(c.object); g.ctx.scene.remove(this.truck);\n    g.world.fire.visualOnly = false; if (this.prevCell) g.world.fire.onChange = this.prevCell;\n    this.s.close?.();\n    for (const c of Object.values(g.people.npcs)) c.hidden = false; g.people.showFriends();\n    for (const c of g.world.cases) { c.taken = false; c.object.visible = true; }\n    for (const s of Object.values(g.world.sites)) s.dormant = false;\n    g.net = null; g.session = null; g.ctx.engine.timeScale = 1;\n  }\n  // ----- Per frame -----\n  update(dt, realDt) {\n    const g = this.game;\n    if (this.ended) return;\n    if (!this.started && this.ownCard) this.padCard();\n    for (const id of this.order) {\n      const P = this.P[id]; if (P.local || P.ai || P.left || !P.view) continue;\n      if (P.tx !== undefined && !this.isHost) { const k = Math.min(1, realDt * 8); P.x += (P.tx - P.x) * k; P.y += (P.ty - P.y) * k; P.z += (P.tz - P.z) * k; P.yaw = P.tyaw; }\n      const moving = Math.hypot((P.tx ?? P.x) - P.x, (P.tz ?? P.z) - P.z) > 0.05 || (P.speed2 ?? 0) > 0.5;\n      P.view.object.visible = !P.respawning;\n      P.view.place(P.x, P.y, P.z, P.yaw + Math.PI);\n      if (P.down) P.view.setFull('WoundedSit'); else { P.view.setLower(moving ? 'Run' : 'Idle'); P.view.setUpper('AimIdle'); }\n      P.view.update(realDt);\n    }\n    if (!this.isHost) for (const a of this.puppets.values()) { a.lerpT = Math.min(1, (a.lerpT ?? 0) + realDt / 0.1); const px = a.px ?? a.tx, pz = a.pz ?? a.tz; const nx = px + (a.tx - px) * a.lerpT, nz = pz + (a.tz - pz) * a.lerpT; a.moving = Math.hypot(nx - a.x, nz - a.z) > 0.002; a.runFrac = 0.5; a.x = nx; a.z = nz; a.y = g.world.land.heightAt(nx, nz); a.yaw = a.tyaw; }\n    for (const c of this.cases) { const show = !c.banked && !c.burned; c.object.visible = show; if (show) { if (c.carrier === this.me) c.object.visible = false; c.object.position.set(c.x, (c.carrier >= 0 ? c.y + 1.1 : c.y + 0.03), c.z); } }\n    void dt;\n  }\n  padCard() {\n    const g = this.game, input = g.ctx.input;\n    if (input.wasPressed('PadCross')) this.s.answer('ready');\n    if (input.wasPressed('PadTriangle')) this.s.answer('more');\n    for (const e of input.buttonEvents) if (!e.down) { const [x, y] = g.ui.pointerXY(e); if (y > g.ctx.hud.height - 56 && y < g.ctx.hud.height - 30) this.s.answer(x < g.ctx.hud.width / 2 ? 'ready' : 'more'); }\n  }\n  drawHud(realDt) {\n    const g = this.game, h = g.ctx.hud, t = this.time();\n    if (!this.started && this.ownCard) { this.drawCard(); return; }\n    g.hud.drawPlay(realDt);\n    if (this.ended) return;\n    const L = this.P[this.me];\n    if (t < 0 && t > -Infinity) { h.text(0, 110, String(Math.ceil(-t / 1000)), { anchor: 'top', scale: 4, color: 'sand' }); }\n    const left = Math.max(0, ROUND_MS - t), mm = Math.floor(left / 60000), ss = Math.floor(left / 1000) % 60;\n    if (t >= 0) h.text(0, 6, `${mm}:${String(ss).padStart(2, '0')}`, { anchor: 'top', color: 'white' });\n    let y = 18; for (const id of [...this.order].sort((a, b) => this.P[b].stones - this.P[a].stones)) { const P = this.P[id]; if (P.left) continue; h.rect(8, y, 6, 7, colorName(P.color)); h.text(18, y, `${P.name} ${P.stones}${P.carrying >= 0 ? ' *' : ''}${P.down ? ' DOWN' : ''}`, { color: P.local ? 'sand' : 'white' }); y += 10; }\n    // Cases show as a marker when close.\n    if (L) for (const c of this.cases) if (!c.banked && !c.burned && c.carrier < 0 && dist2(c.x, c.z, L.x, L.z) < 40) { const s = g.hud.world(c.x, c.y + 1.2, c.z); if (s) h.text(Math.round(s[0]) - 3, Math.round(s[1]), 'v', { color: 'sand' }); }\n    if (L?.carrying >= 0) { const s = g.hud.world(TRUCK[0], g.world.land.heightAt(TRUCK[0], TRUCK[1]) + 3, TRUCK[1]); if (s) h.text(Math.round(s[0]) - 12, Math.round(s[1]), 'BANK', { color: 'lime' }); }\n    if (L?.down) h.text(0, 100, `BLEEDING: ${Math.ceil(L.downT)}`, { anchor: 'top', scale: 2, color: 'red' });\n    if (L?.respawning) h.text(0, 100, 'BACK AT THE ROAD SOON', { anchor: 'top', scale: 2, color: 'mist' });\n    for (const id of this.order) { const P = this.P[id]; if (P.local || P.left || !P.down) continue; const s = g.hud.world(P.x, P.y + 1.4, P.z); if (s) { h.rect(Math.round(s[0]) - 1, Math.round(s[1]) - 5, 3, 11, 'lime'); h.rect(Math.round(s[0]) - 5, Math.round(s[1]) - 1, 11, 3, 'lime'); } }\n  }\n  drawCard() {\n    const g = this.game, h = g.ctx.hud, c = this.card, W = h.width;\n    h.rect(0, 0, W, 34, 'ink'); h.rect(0, h.height - 96, W, 96, 'ink');\n    h.text(0, 8, GAME_TITLE.toUpperCase(), { anchor: 'top', scale: 2, color: 'sand' });\n    let x = 24; for (const id of this.order) { const P = this.P[id], ready = c?.ready?.includes(id); h.rect(x, 40, 6, 7, colorName(P.color)); h.text(x + 9, 40, `${P.name}${ready ? ' READY' : ''}`, { color: ready ? 'lime' : 'white' }); x += 100; }\n    h.text(0, h.height - 90, 'CARRY THE MOST DIAMOND CASES OUT OF THE BURNING MINE.', { anchor: 'top', color: 'white' });\n    h.text(0, h.height - 78, 'ONE CASE AT A TIME, TO THE TRUCK SOUTH OF THE PIT. FRIENDLY FIRE IS ON.', { anchor: 'top', color: 'mist' });\n    let px = 24; const y = h.height - 64; for (const [a, t] of [['fire', 'FIRE'], ['aim', 'AIM'], ['use', 'USE'], ['throw', 'BOTTLE'], ['heal', 'SYRETTE']]) px += g.hud.promptAt(px, y, a, t) + 12;\n    if (c) { const left = c.left === null ? (c.paused ? 'HELD' : 'STARTING') : `${Math.ceil(c.left / 1000)}`; h.text(0, 40, left, { anchor: 'top-right', color: 'sand' }); }\n    h.rect(40, h.height - 46, 150, 18, c?.ready?.includes(this.me) ? 'green' : 'orange'); g.hud.promptAt(50, h.height - 42, 'confirm', 'READY');\n    h.rect(W - 190, h.height - 46, 150, 18, 'night'); const more = g.device === 'pad' ? 'zoom' : null; if (more) g.hud.promptAt(W - 180, h.height - 42, 'zoom', 'MORE TIME'); else { h.text(W - 180, h.height - 40, '[M] MORE TIME', { color: 'white' }); g.hud.prompts.push('[M] MORE TIME'); }\n    h.text(0, h.height - 22, c?.asking ? `${c.asking} ASKED FOR MORE TIME` : '', { anchor: 'top', color: 'mist' });\n  }\n  summary() { return { players: this.order.map((id) => ({ id, stones: this.P[id].stones, down: this.P[id].down, hp: this.P[id].hp, carrying: this.P[id].carrying })), cases: this.cases.map((c) => ({ banked: c.banked, burned: c.burned, carrier: c.carrier })), started: this.started, finished: !!this.finished, ended: this.ended, time: this.time() }; }\n}\nfunction colorName(hex) { return { '#e8443a': 'red', '#3b82f6': 'blue', '#22c55e': 'green', '#f5b700': 'sand' }[hex] ?? 'mist'; }\nvoid FIRE_N;\nEOF\nmkdir -p tests/suites; cat > tests/run.mjs <<'EOF'\n// One command: prints only failures and a one-line count. `--all` ignores stamps; `--only <suite>` runs one.\nimport { execFile } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nconst root = resolve(import.meta.dirname, '..'); process.chdir(root);\nconst argv = process.argv.slice(2), all = argv.includes('--all'), only = argv.includes('--only') ? argv[argv.indexOf('--only') + 1] : null;\nconst walk = (d) => readdirSync(d).flatMap((f) => { const p = join(d, f); return statSync(p).isDirectory() ? walk(p) : [p]; });\nconst SRC = () => walk('src').concat(['tools/build.mjs']);\nconst SUITES = [\n  { id: 'static', run: 'tests/suites/static.mjs', covers: () => [...SRC(), 'tests/suites/static.mjs'] },\n  { id: 'systems', run: 'tests/suites/systems.mjs', covers: () => [...SRC(), 'tests/suites/systems.mjs', 'tests/lib/boot.mjs'] },\n  { id: 'playthrough', run: 'tests/suites/playthrough.mjs', covers: () => [...SRC(), 'tests/suites/playthrough.mjs', 'tests/lib/bot.mjs'] },\n  { id: 'replay', run: 'tests/suites/replay.mjs', covers: () => [...SRC(), 'tests/suites/replay.mjs'] },\n  { id: 'browser', run: 'tests/suites/browser.mjs', covers: () => [...SRC(), 'tests/suites/browser.mjs'] },\n  { id: 'hub', run: 'tests/suites/hub.mjs', covers: () => [...SRC(), 'tests/suites/hub.mjs', 'vendor/session.js'] },\n  { id: 'link', run: 'tests/suites/link.mjs', covers: () => [...SRC(), 'tests/suites/link.mjs'] },\n];\nconst hash = (files) => { const h = createHash('sha1'); for (const f of files) h.update(readFileSync(f)); return h.digest('hex'); };\nconst stampsFile = 'tests/.stamps.json', stamps = existsSync(stampsFile) ? JSON.parse(readFileSync(stampsFile, 'utf8')) : {};\nlet passed = 0, failed = 0, skipped = 0, built = false;\nconst runOne = (s) => new Promise((res) => { execFile('node', [s.run], { maxBuffer: 1 << 28, timeout: 3000000 }, (err, stdout, stderr) => res({ err, stdout, stderr })); });\nfor (const s of SUITES) {\n  if (only && s.id !== only) continue;\n  if (!existsSync(s.run)) continue;\n  const h = hash(s.covers().filter(existsSync));\n  if (!all && !only && stamps[s.id] === h) { skipped++; continue; }\n  if (['browser', 'hub', 'link'].includes(s.id) && !built) { const r = await new Promise((res) => execFile('node', ['tools/build.mjs'], (e, o, er) => res({ e, er }))); if (r.e) { console.log('BUILD FAILED', String(r.er).slice(0, 2000)); process.exit(1); } built = true; }\n  const { err, stdout, stderr } = await runOne(s);\n  const m = /(\\d+) passed, (\\d+) failed/.exec(stdout);\n  if (m) { passed += +m[1]; failed += +m[2]; }\n  const lines = stdout.split('\\n').filter((l) => l.startsWith('FAIL'));\n  for (const l of lines) console.log(`[${s.id}] ${l}`);\n  if (!m || err) { failed++; console.log(`[${s.id}] CRASHED: ${String(err?.message ?? '').slice(0, 300)}\\n${stderr.slice(-1500)}`); }\n  else if (+m[2] === 0) stamps[s.id] = h; else delete stamps[s.id];\n  writeFileSync(stampsFile, JSON.stringify(stamps));\n}\nconsole.log(`${passed} passed, ${failed} failed, ${skipped} suites unchanged`);\nprocess.exit(failed ? 1 : 0);\nEOF\ncat > tests/suites/hub.mjs <<'EOF'\n// All four scenarios the hub uses, against the built file, one at a time.\nimport { spawn } from 'node:child_process';\nimport { copyFileSync, mkdirSync } from 'node:fs';\nimport { basename, resolve } from 'node:path';\nimport { chromium } from 'playwright';\nconst root = resolve(import.meta.dirname, '..', '..'), site = resolve(root, 'tests/.site');\nmkdirSync(site, { recursive: true });\ncopyFileSync(resolve(root, '..', `${basename(root)}.html`), resolve(site, 'game.html'));\nfor (const f of ['harness.html', 'bridge.js', 'round.js']) copyFileSync(resolve(root, 'vendor/hub', f), resolve(site, f));\nconst server = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: site, stdio: ['ignore', 'pipe', 'pipe'] });\nconst port = await new Promise((res) => { let b = ''; const on = (d) => { b += d; const m = /port (\\d+)/.exec(b); if (m) res(+m[1]); }; server.stdout.on('data', on); server.stderr.on('data', on); });\nconst FLAGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'];\nlet pass = 0, fail = 0;\nconst only = process.env.HUB_ONLY;\nconst SCEN = ['players=2&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1', 'players=4&latency=150&jitter=50&loss=5&auto=1&scenario=host-leave', 'players=2&auto=1&scenario=server'];\nconst browser = await chromium.launch({ args: FLAGS });\ntry {\n  const ctx0 = await browser.newContext(); const p0 = await ctx0.newPage(); await p0.goto(`http://127.0.0.1:${port}/game.html?notgame=1`, { waitUntil: 'commit' }); const title = await p0.title().catch(() => ''); await ctx0.close();\n  if (!/Far Dry Season/.test(title)) { console.log(`FAIL page title is ${title}`); fail++; }\n  for (const sc of SCEN) {\n    if (only && !sc.includes(only)) continue;\n    const ctx = await browser.newContext({ viewport: { width: 1280, height: 720 } }), page = await ctx.newPage();\n    await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&${sc}`);\n    try {\n      await page.waitForFunction(() => document.body.dataset.complete === 'true', null, { timeout: 280000 });\n      const r = await page.evaluate(() => window.__hubCheck);\n      if (r.pass) pass++; else { fail++; for (const c of r.checks.filter((k) => !k.ok && !k.pass)) console.log(`FAIL ${sc}: ${c.name}: ${String(c.detail ?? '').slice(0, 240)}`); }\n    } catch (e) { fail++; const r = await page.evaluate(() => JSON.stringify(window.__hubCheck?.checks?.slice?.(-6) ?? null)).catch(() => ''); console.log(`FAIL ${sc}: timed out ${String(e).slice(0, 80)} ${String(r).slice(0, 500)}`); }\n    await ctx.close();\n  }\n} finally { await browser.close(); server.kill(); }\nconsole.log(`${pass} passed, ${fail} failed`);\nEOF\ngrep -n \"__hubCheck\\s*=\" -A4 vendor/hub/harness.html | cut -c1-200 | head; grep -n \"function check\" -A3 vendor/hub/harness.html | cut -c1-200; node tools/build.mjs 2>&1 | tail -2 | cut -c1-300; timeout 280 node tests/lib/smoke.mjs 2>&1 | tail -2 | cut -c1-200; HUB_ONLY='players=2&auto=1' timeout 280 node tests/suites/hub.mjs 2>&1 | cut -c1-700 | tail -14","description":"Write netcode, test runner and hub suite; run first hub scenario","timeout":590000}}}
