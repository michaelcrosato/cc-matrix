ds.object.rotation.y = Math.PI; hands.object.position.set(0, -0.2, -0.43); hands.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n    this.mapGroup = new Group(); this.mapGroup.visible = false; this.group.add(this.mapGroup); this.mapGroup.add(hands.object);\n31:    for (let i = 0; i < this.v.body.numColliders(); i++) game.world.own(this.v.body.collider(i), 'vehicle', this);\n38:    if (this.game.world.fire.isBurning(this.x, this.z)) this.damage(6 * dt);\n51:    if ((this.lastSp ?? 0) - sp > 8) { this.damage(((this.lastSp - sp) - 8) * 6); this.game.audio.at('hit-metal', this.x, this.y, this.z, 40); this.ctx.engine.shake.add(this.seated ? 0.5 : 0); }\n54:  damage(n, by, blast) {\n84:    for (let i = 0; i < this.v.body.numColliders(); i++) this.game.world.owners.delete(this.v.body.collider(i).handle);\n99:    p.ctrl.collider.setEnabled(false); p.ctrl.body.setEnabled?.(false);\n109:    p.ctrl.body.setEnabled?.(true); p.ctrl.collider.setEnabled(true);\n141:    if (throttle < -0.3 && v.v.speed > 8 && (this.brakeT = (this.brakeT ?? 0) - dt) <= 0) { this.brakeT = 1.2; g.audio.play('brakes', { volume: 0.5 }); }\n  }\n  wreck() { if (this.driverView) { this.object.remove(this.driverView.object); this.driverView = null; } const b = buildModel(this.t.model, { catalog: CATALOG, palette: WRECK_PAL }); this.ctx.physics.unbind(this.object); const at = this.object.position.clone()\n  update(dt) {\n    for (let i = 0; i < 4; i++) { this.v.wheelPose(i, P, R, true); this.wheels[i].position.copy(P); this.wheels[i].quaternion.copy(R); }\n    if (this.hp < 35 && !this.dead && this.game.world.look.next() < dt * 8) this.ctx.particles.burst('fire-smoke', [this.x + Math.sin(this.yaw) * 1.5, this.y + 0.8, this.z + Math.cos(this.yaw) * 1.5], { count: 1 });\n    if (this.onFire > 0 && this.game.world.look.next() < dt * 30) this.ctx.particles.burst('ember', [this.x + Math.sin(this.yaw) * 1.5, this.y + 0.8, this.z + Math.cos(this.yaw) * 1.5]);\n    if 