 = SCENES[n]\n        pg.evaluate(\"(()=>{\" + js + \"})()\")\n        time.sleep(wait)\n        pg.screenshot(path=f'{root}/tests/shots/{n}.png')\n        print(n, errs[:2], pg.evaluate('window.__GAME__.status()'), pg.evaluate('window.__PIXEL_ENGINE__.errors.slice(0,2)'))\n        pg.close()\n    b.close()\nEOF\npython3 - <<'EOF'\np='src/game.js'; s=open(p).read()\ns=s.replace(\"  ready(ctx) { if (typeof window !== 'undefined') window.__GAME__ = this; this.pageHooks(ctx); this.net?.onEngineReady(); }\",\"  ready(ctx) { if (typeof window !== 'undefined') { window.__GAME__ = this; window.__rack = rackScreen; window.__dev = devScreen; window.__end = endingScreen; } this.pageHooks(ctx); this.net?.onEngineReady(); }\")\ns=s.replace(\"import { Dev } from './dev/devmode.js';\",\"import { Dev, devScreen } from './dev/devmode.js';\")\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs >/dev/null 2>&1; timeout 280 python3 tests/lib/shots.py day fight fire map 2>&1 | cut -c1-300","description":"Write a screenshot tool and take four scenes","timeout":300000}}}
