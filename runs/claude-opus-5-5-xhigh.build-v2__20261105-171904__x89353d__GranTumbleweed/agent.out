nclude=*.js | grep -v \"wheelGun\\|wheelMesh\\|about.gen\\|Wheel\\|wheels\\|w.wheel\\|wheel\\.\\|'wheel\\|wheel:\" | cut -c1-200; echo ----; grep -n \"unlocked\\|PRESS A KEY\" -r src/game --include=*.js | grep -v about.gen | cut -c1-240; echo ----; grep -n \"skyHour\\|skyFor\\|progressHour\\|hourFor\\|applySky\" -r src/game/scenes/menu.js src/game/render/sets.js src/game/render/sky.js | cut -c1-240 | head","description":"Read input API, licence rules, director, mix and related code"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EqotrkpAW7ZcZaoBDT26zh","type":"tool_result","content":"- `readonly buttons: readonly { readonly pressed: boolean; readonly value?: number }[]`\n\n### class Input\n\nKeyboard + pointer + gamepad input.\n- Keys: held state, per-frame presses (`wasPressed`) and queued presses for fixed-step\n  code (`consumePress`). Queued presses expire after `pressWindow` s of game time.\n- Gamepads (standard mapping): the left stick feeds `moveAxis()` (radial deadzone), the\n  right stick feeds the pointer delta (camera look), buttons press key codes\n  (`gamepadButtons`). Polled once per frame by the engine (`beginFrame`).\n- Pointer: accumulated movement per frame (while a button is held or the pointer is\n  locked), wheel delta per frame, optional pointer lock (first-person). Mouse buttons on\n  the canvas are keys too (`MOUSE_BUTTONS`: `MouseLeft`, `MouseRight`, `MouseMiddle`), and a\n  finger is `Touch` (`TOUCH_KEY`), held and pressed like any other, so a click shorter than\n  a frame is not lost.\n- Commands (`send`): data from outside the canvas, delivered to the game…\n\n- `new Input(target: Window | null = window)`\n- `readonly mouseDelta: { x: number; y: number; }`: Pointer movement this frame, in CSS pixels (drag or pointer lock).\n- `readonly pointer: { x: number; y: number; over: boolean; touch: boolean; }`: Where the pointer last was over the canvas, in normalised device coordinates (−1..1, y up:\n- `wheel: number`: Wheel ticks this frame (+1 = scroll down / zoom out).\n- `wantsPointerLock: boolean`: When true, clicking the canvas requests pointer lock (first-person / free camera).\n- `readonly analog: { x: number; y: number; }`: Touch joystick, -1..1 per axis; overrides keys when active.\n- `readonly padAxis: { x: number; y: number; }`: Gamepad left stick after the deadzone, -1..1 (y = forward).\n- `gamepadConnected: boolean`: True while any gamepad is connected.\n- `readonly preventKeys: Set<string>`: Extra key codes whose browser default is blocked (arrows and Space always are): a game's own F1 / F2 / Tab panels, so the browser's\n- `gamepadButtons: Record<number, string>`: Gamepad button index → key code (defaults: GAMEPAD_BUTTONS).\n- `gamepadDeadzone: number`: Stick deadzone (radial, 0..1).\n- `gamepadLookSpeed: number`: Right stick look speed: pointer pixels per second at full tilt.\n- `now: number`: Game time (s) of the current frame; set by the engine through `beginFrame`.\n- `get playing: boolean`: True while a replay drives input (`engine.replay()`): keyboard, pointer and wheel events, `setKey` / `setPointer` / `setButtons` / `addPointer` \n- `pressWindow: number`: Queued presses older than this many seconds of game time are dropped.\n- `attachPointer(el: HTMLElement): void`: Listen for pointer input on the game canvas. Only pointers that went down on the canvas drive the camera (so a touch joystick do\n- `dispose(): void`: Remove every listener this Input added (window and canvas).\n- `release(): void`: Let go of everything held (keys, gamepad buttons, sticks, pointer buttons); queued presses stay.\n- `reset(): void`: Forget held keys, presses, sticks and pointer movement (e.g. when a level loads).\n- `beginFrame(now: number, dt: number, pads?: readonly (GamepadLike | null)[]): void`: Engine: begin a frame at game time `now` (seconds). Polls gamepads and drops expire\n- `get pointerLocked: boolean`\n- `isDown(...codes: string[]): boolean`\n- `anyDown(codes: readonly string[]): boolean`: `isDown` for a list of codes, without building a rest-argument array (fixed-step code).\n- `wasPressed(...codes: string[]): boolean`: True once per physical key press (valid for the current render frame).\n- `consumePress(...codes: string[]): boolean`: True once per physical key press, kept until consumed or until it is older than `pressWindow` (150 ms of game time). Use fr\n- `consumeAny(codes: readonly string[]): boolean`: `consumePress` for a list of codes, without building a rest-argument array.\n- `state(): InputState`: Held keys, queued presses and the pointer as data (`engine.snapshot()`), between frames.\n- `setState(s: InputState, now: number): void`: Back to `state()` at game time `now` (a restore): held keys are those the snapshot held, live ones let go.\n- `get queuedPresses: string[]`: Presses waiting to be consumed (tooling / tests).\n- `clearQueued(...codes: string[]): void`: Drop queued presses (e.g. when a menu or mode swallows input).\n- `moveAxis(): { x: number; y: number }`: -1..1 on each axis (x = right, y = forward): the touch joystick or a gamepad's left stick (whichever is tilted further), else WA\n- `endFrame(): void`: Call at the end of each rendered frame.\n- `setKey(code: string, down: boolean): void`: Test hook: simulate a key being held (true) or released (false).\n- `setPointer(x: number, y: number, down?: boolean): void`: Test hook: put the pointer at (x, y) in normalised device coordinates, pressed or not.\n- `setButtons(bits: number): void`: Test hook: hold mouse buttons (`PointerEvent.buttons` bits: 1 left, 2 right, 4 middle) as the canvas would.\n- `get mouseButtons: number`: Buttons held, as `PointerEvent.buttons` bits (1 left, 2 right, 4 middle; a finger is left): the same keys as `isDown('MouseLeft')`.\n- `get buttonEvents: readonly ButtonEvent[]`: This frame's pointer button presses and releases, in order, each with where the pointer was: a drag shorter than a frame (a \n- `send(command: unknown): void`: Hand the game data from outside the canvas: a DOM widget's value, a file the player picked, a save read from storage, anything a game wo\n- `get commands: readonly unknown[]`: This frame's commands (`send`), oldest first; empty on most frames. They last one rendered frame: read them in `update` (`fixedUpdat\n- `deliver(): void`: Engine: a live frame begins to run: what was sent since the last one becomes its `commands`.\n- `addPointer(dx: number, dy: number, wheel = 0): void`: Test hook: inject pointer movement / wheel for the next frame.\n- `snapshot(dt: number, last?: SnapshotMemory): InputFrame`: This frame's input as data (after `beginFrame`), for a recording. `last` is the frame before: unchanged held \n- `playBefore(f: InputFrame): void`: Replay, before the engine's `beginFrame`: the frame's held keys and presses (presses queue at the time they would have arrived, the f\n- `playAfter(f: InputFrame): void`: Replay, after `beginFrame` (which polled no gamepads): sticks, pointer, wheel, gamepad connection.\n----\n// Licence tests: the setup for a test, the judge that watches an attempt, and the demonstration's brain.\nimport { aiDrive } from './sim.js';\nimport { indexOfS, loadTrack, RaceSim, trackPoint, wrapS } from './race.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { fullInstall } from './tuning.js';\n\nexport function placeS(tr, at) { return wrapS(tr, at.s !== undefined ? at.s : tr.cornerS[at.c] + (at.off ?? 0)); }\nexport const legCount = (test) => test.legs?.length ?? 1;\nexport const legCar = (test, leg) => test.legs?.[leg] ?? test.carId;\nexport function testSetup(test, leg = 0, assists = {}, player = 0) {\n  const carId = legCar(test, leg), { tr } = loadTrack(test.track);\n  const startS = placeS(tr, test.start);\n  return {\n    kind: 'licence', track: test.track, laps: 0, hour: test.hour ?? TRACKS[test.track].hour, start: test.standing ? 'standing' : 'flying', startS, startSpeed: test.startSpeed ?? 0, contact: false,\n    wear: 0, fuel: 0, cars: [{ carId, install: null, name: 'YOU', paint: null, player, assists: { abs: true, tcs: 5, asm: 5, auto: true, ...assists, ...(test.assists ?? {}) } }],\n    test: test.id, leg,\n  };\n}\n// Watches one attempt. status: running, pass, fail. time counts per the plan's rules; penalties are added at the end.\nexport class Judge {\n  constructor(test, sim) {\n    this.test = test; this.sim = sim; const tr = sim.tr;\n    this.status = 'running'; this.reason = ''; this.time = 0; this.running = !test.standing && test.kind !== 'lap'; this.penalty = 0; this.offT = 0; this.startProgress = 0; this.lastRel = 0;\n    this.startS = placeS(tr, test.start);\n    this.distance = test.kind === 'lap' ? tr.length + wrapRel(tr, 0 - this.startS) : test.end ? wrapS(tr, placeS(tr, test.end) - this.startS) : 0;\n    if (test.kind === 'lap') this.lineAt = wrapS(tr, 0 - this.startS);\n    this.travelled = 0; this.lastS = sim.cars[0].c.loc.s;\n    if (test.box) { this.boxFrom = wrapS(tr, test.box.s - this.startS) - test.box.len / 2; this.boxTo = this.boxFrom + test.box.len; this.limit = this.boxTo + 40; }\n    if (test.cones) {\n      this.cones = [];\n      for (let k = 0; k < test.cones.count; k++) { const s = test.cones.from + k * test.cones.spacing, pt = trackPoint(tr, s, 0); this.cones.push({ s, rel: wrapS(tr, s - this.startS), x: pt.x, y: pt.y, z: pt.z, yaw: pt.yaw, side: k % 2 ? -1 : 1, hit: false, passed: false, tumble: 0 }); }\n    }\n    this.coneHits = 0;\n    this.timeLimit = (test.medals?.bronze ?? 120) * 2.2 + 15;\n  }\n  fail(reason) { if (this.status === 'running') { this.status = 'fail'; this.reason = reason; this.sim.events.push({ type: 'testFail', reason }); } }\n  pass() { if (this.status === 'running') { this.status = 'pass'; this.sim.events.push({ type: 'testPass', time: this.total }); } }\n  get total() { return this.time + this.penalty; }\n  get totalWithBase() { return this.total + (this.base ?? 0); }\n  step(dt) {\n    if (this.status !== 'running') return;\n    const sim = this.sim, tr = sim.tr, e = sim.cars[0], c = e.c, test = this.test;\n    let ds = c.loc.s - this.lastS; if (ds > tr.length / 2) ds -= tr.length; else if (ds < -tr.length / 2) ds += tr.length;\n    this.travelled += ds; this.lastS = c.loc.s;\n    if (!this.running) {\n      if (test.kind === 'lap') { if (this.travelled >= this.lineAt) { this.running = true; this.lapFrom = this.travelled; } }\n      else if (Math.hypot(c.vx, c.vz) > 0.5) this.running = true;\n    }\n    if (this.running) this.time += dt;\n    // Limits\n    if (!c.onTrack) { this.offT += dt; if (this.offT > 0.6 && !test.allowOff) return this.fail('OFF THE ROAD'); } else this.offT = 0;\n    if (test.noMargin && c.wallHits > 0) return this.fail('THE WALL WAS TOUCHED');\n    if (e.recoveries > 0) return this.fail('RECOVERY ENDS THE ATTEMPT');\n    if (this.time > this.timeLimit) return this.fail('THE EXAMINER HAS GONE HOME');\n    if (e.wrongWay) return this.fail('THAT IS THE WRONG WAY');\n    if (test.kind === 'stop') {\n      const v = Math.hypot(c.vx, c.vz);\n      if (this.travelled > this.boxTo + 4) return this.fail('PAST THE BOX');\n      if (this.running && v < 0.25 && this.travelled > 5) { if (this.travelled >= this.boxFrom - 1 && this.travelled <= this.boxTo + 1) return this.pass(); return this.fail('STOPPED OUTSIDE THE BOX'); }\n    } else if (test.kind === 'lap') {\n      if (this.running && this.travelled - this.lapFrom >= tr.length) return this.pass();\n    } else {\n      if (test.cones) for (const k of this.cones) {\n        if (!k.hit && Math.hypot(c.x - k.x, c.z - k.z) < 1.5) { k.hit = true; k.tumble = 1; this.penalty += 1; this.coneHits++; sim.events.push({ type: 'cone', hit: true }); }\n        if (!k.passed && this.travelled >= k.rel) { k.passed = true; if (!k.hit && Math.sign(c.loc.t) !== k.side) { this.penalty += 1; k.missed = true; this.coneHits++; sim.events.push({ type: 'cone', hit: false }); } }\n      }\n      if (this.travelled >= this.distance) return this.pass();\n    }\n  }\n}\n----\n// The replay director: camera posts every ~280 m beside the road, some authored shots, and a cut every 4 to 8 s toward what is interesting.\nimport { THREE } from '../../pixel-engine.js';\nimport { trackPoint, wrapS } from '../sim/race.js';\nconst { Vector3 } = THREE;\nexport class TvDirector {\n  constructor(tr, field, seed = 7) {\n    this.tr = tr; this.posts = []; this.shot = null; this.cutT = 0; this.pos = new Vector3(); this.look = new Vector3(); let s = 0, a = seed;\n    const rnd = () => { a = (a * 1664525 + 1013904223) >>> 0; return a / 4294967296; };\n    while (s < tr.length) {\n      const side = rnd() > 0.5 ? 1 : -1, i = Math.round(s / tr.ds) % tr.N, wall = side > 0 ? tr.wallR[i] : tr.wallL[i], off = tr.width[i] / 2 + Math.max(wall + 2, 15 + rnd() * 10), x = tr.x[i] - tr.tz[i] * off * side, z = tr.z[i] + tr.tx[i] * off * side;\n      this.posts.push({ s, x, y: tr.y[i] + 3 + rnd() * 5 + (tr.surface === 'dirt' ? 3 : 0), z, fov: 18 + rnd() * 12 });\n      s += 240 + rnd() * 80;\n    }\n    // Authored: low at the start line, a helicopter on the straight, the gantry.\n    const a0 = trackPoint(tr, 6, tr.width[0] / 2 + 2.2); this.posts.push({ s: 0, x: a0.x, y: a0.y + 0.7, z: a0.z, fov: 32, low: true });\n    const h = trackPoint(tr, -200, 0); this.heli = { s: -200, x: h.x, y: h.y + 42, z: h.z, fov: 24, heli: true };\n    const g = trackPoint(tr, 3, 0); this.posts.push({ s: 40, x: g.x, y: g.y + 8.6, z: g.z, fov: 40, gantry: true });\n    this.posts.sort((p, q) => p.s - q.s);\n  }\n  // The next post ahead of the focus.\n  pick(s) {\n    const tr = this.tr; let best = this.posts[0], bd = Infinity;\n    for (const p of this.posts) { const d = wrapS(tr, p.s - s - 50); if (d < bd && p !== this.shot) { bd = d; best = p; } }\n    return best;\n  }\n  force() { this.cutT = 0; }\n  // focus: { x, y, z, s }. Returns true on a cut.\n  update(dt, focus, cam, { busy = false } = {}) {\n    this.cutT -= dt; let cut = false;\n    const shot = this.shot;\n    const dist = shot ? Math.hypot(shot.x - focus.x, shot.z - focus.z) : 1e9, behind = shot ? wrapS(this.tr, focus.s - shot.s) : 0;\n    if (!shot || this.cutT <= 0 || dist > 170 || (behind < this.tr.length / 2 && behind > 110 && !shot.heli)) {\n      this.shot = this.pick(focus.s); this.cutT = 4 + (Math.abs(Math.sin(focus.s * 13.1)) * 4) - (busy ? 1.5 : 0); cut = true;\n      if (Math.abs(Math.sin(focus.s * 3.3)) > 0.93 && this.heli) { this.shot = this.heli; this.heli.x = focus.x + 20; this.heli.z = focus.z - 34; this.heli.y = focus.y + 36; }\n    }\n    const S = this.shot;\n    this.pos.set(S.x, S.y, S.z);\n    if (S.heli) { S.x += (focus.x + 16 - S.x) * Math.min(1, dt * 0.8); S.z += (focus.z - 30 - S.z) * Math.min(1, dt * 0.8); }\n    this.look.set(focus.x, focus.y + 0.7, focus.z);\n    cam.position.copy(this.pos); cam.lookAt(this.look);\n----\n    if (s) { s.synth.dispose(); }\n    const synth = new EngineSynth(this.ctx, this.master, engineData(carId, p), { noise: this.noise });\n    this.synths[slot] = { key: carKey, synth };\n    return synth;\n  }\n  // list: [{ key, carId, p, rpm, throttle, spool, gain, pan }]. Slot 0 is the driver's own.\n  engines(list, dt) {\n    this.volumes(); this.lastEngines = list;\n    if (!this.built && !this.ensure()) return;\n    for (let i = 0; i < 4; i++) { const it = list[i], s = it ? this.synthFor(i, it.key, it.carId, it.p) : this.synths[i]?.synth; if (!s) continue; if (it) s.set({ rpm: it.rpm, throttle: it.throttle, spool: it.spool, gain: it.gain, pan: it.pan, dt }); else s.si\n  }\n  // The nearest other cars: looping voices placed in the world, pitched by their rpm. list: [{ x, y, z, rpm }].\n  others(list, listener) {\n    if (!this.audio || this.silent) return;\n    this.loopVoices ??= [];\n    for (let i = 0; i < 3; i++) {\n      const it = list[i]; let v = this.loopVoices[i];\n      if (!it) { v?.set({ volume: 0 }); continue; }\n      if (!v || v.stopped) v = this.loopVoices[i] = this.audio.loop('carLoop', { volume: 0 });\n      const s = spatialize(listener, it, { ref: 6, max: 110 });\n      v.set({ volume: s.gain * 0.5, pan: s.pan, pitch: 12 * Math.log2(Math.max(0.25, it.rpm / 3000)) });\n    }\n  }\n  // state: { tyre, wind, gravel, rain, kerb, crowd }: gains 0..1.\n  world(st) {\n    if (!this.built) return;\n    const t = this.ctx.currentTime, k = 0.05;\n    this.tyre.g.gain.setTargetAtTime((st.tyre ?? 0) * 0.14, t, k); this.tyre.f.frequency.setTargetAtTime(1900 + (st.tyrePitch ?? 0) * 900, t, k);\n    this.wind.g.gain.setTargetAtTime((st.wind ?? 0) * 0.18, t, k); this.wind.f.frequency.setTargetAtTime(500 + (st.wind ?? 0) * 1600, t, k);\n    this.gravel.g.gain.setTargetAtTime((st.gravel ?? 0) * 0.28, t, k); this.rain.g.gain.setTargetAtTime((st.rain ?? 0) * 0.07, t, 0.2); this.crowd.g.gain.setTargetAtTime((st.crowd ?? 0) * 0.08, t, 0.25);\n    this.kerb.g.gain.setTargetAtTime((st.kerb ?? 0) * 0.08, t, 0.02); this.kerb.o.frequency.setTargetAtTime(20 + (st.kerbRate ?? 0) * 3, t, 0.03);\n  }\n  quiet() {\n    if (!this.built) return;\n    for (const s of this.synths) s?.synth.silence();\n    this.world({});\n  }\n  clearCars() { for (const s of this.synths) { try { s?.synth.dispose(); } catch { /* gone */ } } this.synths = []; for (const v of this.loopVoices ?? []) v?.stop(); this.loopVoices = []; if (this.built) this.world({}); }\n  // Stops everything, for the hub's `end`.\n  stopAll() { this.silent = true; this.stopVoice(); this.clearCars(); this.audio?.playMusic(null); this.song = null; if (this.built) { this.master.gain.value = 0; this.voices.gain.value = 0; } }\n  testHooks() { return { EngineSynthClass: EngineSynth, speak, noiseBuffer }; }\n  level() { if (!this.analyser) return 0; const a = new Float32Array(this.analyser.fftSize); this.analyser.getFloatTimeDomainData(a); let m = 0; for (const v of a) m = Math.max(m, Math.abs(v)); return m; }\n}\n----\nsrc/game/ui/ui.js:120:    if (a.wheel && now.slider) this.nudge(now, -Math.sign(a.wheel));\nsrc/game/input/actions.js:26:    const p = input.pointer, wheel = input.wheel ?? 0;\nsrc/game/input/actions.js:34:    if (this.clicked || this.rclicked || wheel) { this.anyInput = true; if (!touchNow) { this.lastDevice = 'mouse'; this.mouseIdle = 0; } }\nsrc/game/input/actions.js:36:    this.wheel = wheel;\nsrc/game/sim/sim.js:82:  const L = d.wheelbase, powerW = d.powerPS * 735.5, omega = (d.rpmPeak * 2 * Math.PI) / 60;\nsrc/game/sim/sim.js:83:  return { ...d, mass: d.massKg, L, a: L * (1 - d.frontWeight)