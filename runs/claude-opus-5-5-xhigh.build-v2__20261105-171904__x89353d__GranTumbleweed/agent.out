{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjBhYiVZhB4CYBzgeF2","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19874,"cache_read_input_tokens":196721,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19874},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"a7046a80-ca32-4949-a1b8-1f27b258266e","timestamp":"2026-11-06T00:30:08.705Z","request_id":"req_011CgkjBhJq2q8y8QXBZcg1f","thinking_duration_ms":90196,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjBhYiVZhB4CYBzgeF2","type":"message","role":"assistant","content":[{"type":"text","text":"Now the pure rules layer: tuning, career, the race simulation, licence judging and replay recording. None of it touches the engine, so all of it can be tested in Node."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19874,"cache_read_input_tokens":196721,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19874},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"317508ab-1e96-4266-af7f-52d3402b67b2","timestamp":"2026-11-06T00:30:08.710Z","request_id":"req_011CgkjBhJq2q8y8QXBZcg1f"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjBhYiVZhB4CYBzgeF2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01D1rUYrVjygtFum4vgb6Gmw","name":"Bash","input":{"command":"cat > src/game/sim/tuning.js <<'EOF'\n// tunedParams(carId, install): a car's physics row, with the player's parts applied, ready for stepCar.\nimport { carParams } from './sim.js';\nimport { PHYSICS } from '../data/cars.js';\nimport { TYRES } from '../data/tyres.js';\nimport { PARTS, SETUP_SLIDERS } from '../data/parts.js';\n\nexport const emptyInstall = () => ({ owned: [], on: {}, tyre: null, tyres: [], paint: null, rims: 0, setup: {} });\nexport const hasPart = (install, id) => {\n  if (!install) return false;\n  const g = PARTS[id]?.group;\n  return g ? install.on?.[g] === id : (install.owned ?? []).includes(id);\n};\nexport function fullInstall(parts = [], tyre = null) { // an install from a plain list, for AI tunes and tests\n  const inst = emptyInstall();\n  for (const id of parts) { inst.owned.push(id); const g = PARTS[id]?.group; if (g) inst.on[g] = id; }\n  if (tyre) { inst.tyre = tyre; inst.tyres.push(tyre); }\n  return inst;\n}\nexport function setupValue(install, id) {\n  const def = SETUP_SLIDERS.find((s) => s.id === id);\n  return install?.setup?.[id] ?? def.def;\n}\nexport const sliderAvailable = (install, slider) => slider.needs.some((id) => hasPart(install, id));\nexport function tunedRow(carId, install) {\n  const base = PHYSICS[carId], d = { ...base, tyreTable: { ...(base.tyreTable ?? {}) } };\n  d.cgH = base.cgH ?? 0.5;\n  if (!install) return d;\n  const has = (id) => hasPart(install, id);\n  let power = 1;\n  if (has('exhaust')) { power *= 1.04; d.sportExhaust = true; }\n  if (has('intake')) power *= 1.06;\n  const stage = has('stage3') ? 3 : has('stage2') ? 2 : has('stage1') ? 1 : 0;\n  if (stage) { power *= [1, 1.1, 1.2, 1.35][stage]; d.rpmPeak += [0, 0, 200, 400][stage]; d.redline += [0, 0, 200, 500][stage]; d.upshift += [0, 0, 200, 500][stage]; }\n  const turbo = has('turbo2') ? 2 : has('turbo1') ? 1 : 0;\n  if (turbo) {\n    if (base.turbo) power *= [1, 1.15, 1.35][turbo];\n    else { power *= [1, 1.25, 1.5][turbo]; d.turbo = true; d.turboLag = 0.8; }\n  }\n  d.powerPS = base.powerPS * power;\n  const weight = has('weight3') ? 3 : has('weight2') ? 2 : has('weight1') ? 1 : 0;\n  if (weight) { d.massKg = base.massKg * [1, 0.95, 0.9, 0.85][weight]; d.cgH *= [1, 0.99, 0.98, 0.96][weight]; }\n  if (has('clutch')) d.shiftTime = 0.11;\n  if (has('gearbox')) { d.shiftTime = 0.08; d.final = base.final * setupValue(install, 'gearing'); }\n  if (has('lsd')) d.lsd = setupValue(install, 'lsd');\n  if (has('suspSport')) { d.loadK = 0.085; d.cgH *= 0.96; d.rollF = setupValue(install, 'balance'); }\n  if (has('suspRace')) { d.loadK = 0.07; d.cgH *= 0.92 * setupValue(install, 'ride'); d.rollF = setupValue(install, 'balance'); d.lowRide = setupValue(install, 'ride') < 0.94; }\n  if (has('brakeSport')) d.brakeG = (base.brakeG ?? 1.25) + 0.15;\n  if (has('brakeRace')) { d.brakeG = (base.brakeG ?? 1.25) + 0.4; d.brakeF = setupValue(install, 'brakeF'); }\n  const baseCl = base.clA ?? 0.1, baseCd = base.cdA ?? 0.7;\n  if (has('aeroStreet')) { d.clA = baseCl + 0.15; d.cdA = baseCd + 0.02; }\n  if (has('aeroWing')) { d.clA = (baseCl + 0.5) * setupValue(install, 'downforce'); d.cdA = baseCd + 0.06; }\n  if (install.tyre) { const t = TYRES[install.tyre]; d.tyreMu = t.tyreMu; d.alphaP = t.alphaP; d.wearX = t.wearX; d.tyreTable = { dirt: t.dirt, gravel: t.dirt }; }\n  return d;\n}\nexport const tunedParams = (carId, install) => carParams(tunedRow(carId, install));\n\n// Oil: fresh gives +2% for 100 km, then level until 200 km; each 40 km after that takes 0.5%, down to -8%.\nexport function oilFactor(km, changed = false) {\n  if (changed && km < 100) return 1.02;\n  if (km <= 200) return 1;\n  return Math.max(0.92, 1 - 0.005 * Math.floor((km - 200) / 40));\n}\n// Numbers a card may show (at most six).\nexport function specOf(carId, install) {\n  const d = tunedRow(carId, install);\n  return { ps: Math.round(d.powerPS), kg: Math.round(d.massKg), layout: d.layout, turbo: !!d.turbo, tyreMu: d.tyreMu ?? 1, clA: d.clA ?? 0.1, brakeG: d.brakeG ?? 1.25, shift: d.shiftTime ?? 0.16, redline: d.redline, rpmPeak: d.rpmPeak };\n}\n// The power curve for the dyno: { rpm, ps } points.\nexport function dynoCurve(carId, install, steps = 40) {\n  const p = tunedParams(carId, install), pts = [];\n  for (let i = 0; i <= steps; i++) {\n    const rpm = 1500 + ((p.redline - 1500) * i) / steps, x = rpm / p.rpmPeak, low = p.turbo ? 0.5 : 0.62, rise = Math.min(1, low + (1 - low) * Math.min(1, x / 0.7)), fall = x <= 1 ? 1 - 0.14 * Math.max(0, (x - 0.7) / 0.3) : 0.86 - 0.9 * (x - 1), shape = Math.max(0.05, rise * fall), tq = p.Tpeak * shape;\n    pts.push({ rpm, ps: (tq * (rpm * 2 * Math.PI / 60)) / 735.5 });\n  }\n  return pts;\n}\nEOF\ncat > src/game/sim/career.js <<'EOF'\n// The career's rules, as pure functions over a plain profile. No engine, no DOM, no storage.\nimport { SAVE_VERSION, START_CREDITS } from '../data/meta.js';\nimport { CAR_INFO, DRIVER_NAMES, PHYSICS } from '../data/cars.js';\nimport { AI_TUNES, EVENTS, EVENT_IDS, POINTS, PRIZE_RATIO } from '../data/events.js';\nimport { LICENCES, TESTS } from '../data/licences.js';\nimport { PARTS, PAINT_PRICE, RIM_PRICE, SETUP_SLIDERS } from '../data/parts.js';\nimport { TYRES } from '../data/tyres.js';\nimport { emptyInstall, fullInstall, hasPart, oilFactor, specOf, tunedRow } from './tuning.js';\n\nexport const OIL_PRICE = 250, WASH_PRICE = 50, SELL_RATIO = 0.5;\nexport function newProfile() {\n  return { version: SAVE_VERSION, credits: START_CREDITS, day: 1, licences: {}, tests: {}, cars: [], current: null, nextUid: 1, events: {}, trophies: [], stats: { km: 0, wins: 0, gold: 0, races: 0, lapsLed: 0 }, seen: {}, records: {}, ghosts: {}, replays: [null, null, null], greeted: false, ended: false };\n}\n// Migrations: every old version steps up to the next.\nexport function migrate(raw) {\n  if (!raw || typeof raw !== 'object') return newProfile();\n  const p = { ...raw };\n  p.version = p.version ?? 1;\n  if (p.version < 2) { // version 1 kept one current car id and no ghosts or replay slots\n    p.ghosts = p.ghosts ?? {}; p.replays = p.replays ?? [null, null, null]; p.seen = p.seen ?? {};\n    for (const c of p.cars ?? []) { c.install = { ...emptyInstall(), ...(c.install ?? {}) }; c.dirt = c.dirt ?? 0; c.oilChanged = c.oilChanged ?? false; }\n    p.version = 2;\n  }\n  return p;\n}\nexport const carEntry = (profile, uid = profile.current) => profile.cars.find((c) => c.uid === uid) ?? null;\nexport function addCar(profile, carId, { prize = false, paint = null } = {}) {\n  const car = { uid: profile.nextUid++, carId, install: emptyInstall(), km: 0, kmOil: 0, oilChanged: false, dirt: 0, prize, wash: 0 };\n  car.install.paint = paint ?? CAR_INFO[carId].paint;\n  profile.cars.push(car); profile.seen[carId] = true;\n  if (profile.current === null) profile.current = car.uid;\n  return car;\n}\nexport function carPriceOpen(profile, carId) {\n  const i = CAR_INFO[carId];\n  if (!i.price) return false;\n  if (i.after && !profile.licences[i.after]) return false;\n  return true;\n}\nexport function buyCar(profile, carId) {\n  const i = CAR_INFO[carId];\n  if (!carPriceOpen(profile, carId)) return { ok: false, why: i.after ? 'licence' : 'prize' };\n  if (profile.credits < i.price) return { ok: false, why: 'money' };\n  profile.credits -= i.price;\n  const car = addCar(profile, carId, { paint: i.paint });\n  profile.current = car.uid;\n  return { ok: true, car };\n}\nexport const sellValue = (car) => Math.round((CAR_INFO[car.carId].price || 0) * SELL_RATIO);\nexport function sellCar(profile, uid) {\n  const car = carEntry(profile, uid);\n  if (!car) return { ok: false, why: 'none' };\n  if (car.prize) return { ok: false, why: 'prize' };\n  if (profile.cars.length <= 1) return { ok: false, why: 'last' };\n  profile.credits += sellValue(car);\n  profile.cars = profile.cars.filter((c) => c.uid !== uid);\n  if (profile.current === uid) profile.current = profile.cars[0].uid;\n  return { ok: true };\n}\nexport function setCurrent(profile, uid) { if (carEntry(profile, uid)) profile.current = uid; }\n\n// ---- Tuning Street ----\nexport function partState(car, partId) {\n  const owned = car.install.owned.includes(partId);\n  return { owned, on: hasPart(car.install, partId) };\n}\nexport function buyPart(profile, car, partId) {\n  const part = PARTS[partId];\n  if (!part) return { ok: false, why: 'none' };\n  if (car.install.owned.includes(partId)) {\n    if (!part.group) return { ok: false, why: 'owned' };\n    car.install.on[part.group] = car.install.on[part.group] === partId ? null : partId; // owned: a free swap, or back to stock\n    return { ok: true, swapped: true };\n  }\n  if (profile.credits < part.price) return { ok: false, why: 'money' };\n  profile.credits -= part.price;\n  car.install.owned.push(partId);\n  if (part.group) car.install.on[part.group] = partId;\n  return { ok: true };\n}\nexport function buyTyre(profile, car, tyreId) {\n  const t = TYRES[tyreId];\n  if (!t) return { ok: false, why: 'none' };\n  if (car.install.tyres.includes(tyreId)) { car.install.tyre = car.install.tyre === tyreId ? null : tyreId; return { ok: true, swapped: true }; }\n  if (profile.credits < t.price) return { ok: false, why: 'money' };\n  profile.credits -= t.price;\n  car.install.tyres.push(tyreId); car.install.tyre = tyreId;\n  return { ok: true };\n}\nexport function buyPaint(profile, car, colour) {\n  if (car.install.paint === colour) return { ok: false, why: 'owned' };\n  if (profile.credits < PAINT_PRICE) return { ok: false, why: 'money' };\n  profile.credits -= PAINT_PRICE; car.install.paint = colour;\n  return { ok: true };\n}\nexport function buyRims(profile, car, style) {\n  if (car.install.rims === style) return { ok: false, why: 'owned' };\n  if (profile.credits < RIM_PRICE) return { ok: false, why: 'money' };\n  profile.credits -= RIM_PRICE; car.install.rims = style;\n  return { ok: true };\n}\nexport function setSetup(car, id, value) {\n  const s = SETUP_SLIDERS.find((x) => x.id === id);\n  car.install.setup[id] = Math.max(s.min, Math.min(s.max, Math.round(value / s.step) * s.step));\n}\n// ---- Service Bay ----\nexport const oilOf = (car) => oilFactor(car.kmOil, car.oilChanged);\nexport function changeOil(profile, car) {\n  if (profile.credits < OIL_PRICE) return { ok: false, why: 'money' };\n  profile.credits -= OIL_PRICE; car.kmOil = 0; car.oilChanged = true;\n  return { ok: true };\n}\nexport function washCar(profile, car) {\n  if (profile.credits < WASH_PRICE) return { ok: false, why: 'money' };\n  profile.credits -= WASH_PRICE; car.dirt = 0; car.wash = (car.wash ?? 0) + 1;\n  return { ok: true };\n}\nexport function driveCar(profile, car, metres, dirtMetres = 0) {\n  const km = metres / 1000;\n  car.km += km; car.kmOil += km; profile.stats.km += km;\n  car.dirt = Math.min(1, car.dirt + (dirtMetres / 1000) * 0.2);\n}\n// ---- Licences ----\nexport const MEDAL_RANK = { gold: 3, silver: 2, bronze: 1 };\nexport function medalFor(test, time) {\n  const m = test.medals;\n  if (!m) return null;\n  return time <= m.gold ? 'gold' : time <= m.silver ? 'silver' : time <= m.bronze ? 'bronze' : null;\n}\nexport function licenceOpen(profile, licId) { const l = LICENCES[licId]; return !l.needs || !!profile.licences[l.needs]; }\nexport function testRecord(profile, id) { return (profile.tests[id] ??= { medal: null, best: null, fails: 0 }); }\nexport function recordFailure(profile, id) { const r = testRecord(profile, id); r.fails++; return r.fails; }\n// A finished attempt. Returns what changed: { medal, improved, licenceWon, allGold, reward }.\nexport function recordTest(profile, id, time) {\n  const test = TESTS[id], rec = testRecord(profile, id), medal = medalFor(test, time), out = { medal, improved: false, licenceWon: false, allGold: false, reward: 0 };\n  if (rec.best === null || time < rec.best) rec.best = time;\n  if (!medal) { rec.fails++; return out; }\n  rec.fails = 0;\n  if ((MEDAL_RANK[medal] ?? 0) > (MEDAL_RANK[rec.medal] ?? 0)) {\n    if (medal === 'gold') profile.stats.gold++;\n    rec.medal = medal; out.improved = true;\n  }\n  const lic = LICENCES[test.licence], medals = lic.tests.map((t) => profile.tests[t]?.medal);\n  if (!profile.licences[lic.id] && medals.every(Boolean)) {\n    profile.licences[lic.id] = true; profile.credits += lic.reward; out.licenceWon = true; out.reward = lic.reward;\n    profile.trophies.push({ kind: 'licence', id: lic.id });\n  }\n  const goldKey = `gold${lic.id}`;\n  if (medals.every((m) => m === 'gold') && !profile[goldKey]) {\n    profile[goldKey] = true; out.allGold = true;\n    if (lic.allGold.car) { const c = addCar(profile, lic.allGold.car, { prize: true }); out.prizeCar = c.carId; }\n    if (lic.allGold.credits) { profile.credits += lic.allGold.credits; out.reward += lic.allGold.credits; }\n    if (lic.allGold.helmet) profile.trophies.push({ kind: 'helmet', id: lic.id });\n  }\n  return out;\n}\nexport const licenceTier = (profile) => (profile.licences.A ? 'A' : profile.licences.B ? 'B' : profile.licences.C ? 'C' : null);\n// ---- Events ----\nexport function eventState(profile, id) { return (profile.events[id] ??= { round: 0, points: {}, legs: 0, done: false, won: false, wins: 0 }); }\nexport function eventOpen(profile, id) {\n  const e = EVENTS[id], missing = e.needs.find((l) => !profile.licences[l]);\n  if (missing) return { ok: false, why: `NEEDS THE ${LICENCES[missing].name} LICENCE` };\n  if (e.needsAny && !e.needsAny.some((x) => profile.events[x]?.won)) return { ok: false, why: `WIN ${e.needsAny.map((x) => EVENTS[x].name).join(' OR ')} FIRST` };\n  return { ok: true };\n}\nexport function eligible(event, carId, install) {\n  const s = specOf(carId, install), l = event.limit ?? {};\n  if (l.maxPS && s.ps > l.maxPS) return { ok: false, why: `${s.ps} PS. THE LIMIT IS ${l.maxPS}` };\n  if (l.maxKg && s.kg > l.maxKg) return { ok: false, why: `${s.kg} KG. THE LIMIT IS ${l.maxKg}` };\n  if (l.layout && !l.layout.includes(s.layout)) return { ok: false, why: `THIS EVENT WANTS ${l.layout.join(' OR ')}` };\n  return { ok: true };\n}\n// The roster stays the same for all of an event's rounds. Skills rise from the front of the grid.\nexport function eventRoster(id) {\n  const e = EVENTS[id], out = [], n = e.field - 1;\n  let hash = 0; for (const ch of id) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;\n  for (let i = 0; i < n; i++) {\n    const pick = e.pool[(hash + i) % e.pool.length], [carId, tune] = Array.isArray(pick) ? pick : [pick, null];\n    out.push({ name: DRIVER_NAMES[(hash + i * 3) % DRIVER_NAMES.length], carId, tune, skill: n > 1 ? e.pace[0] + ((e.pace[1] - e.pace[0]) * i) / (n - 1) : e.pace[1] });\n  }\n  return out;\n}\nexport const aiInstall = (tune) => (tune ? fullInstall(AI_TUNES[tune].parts, AI_TUNES[tune].tyre) : null);\n// A rally round: one rival per leg, faster each leg.\nexport function rallyRival(id, round) {\n  const e = EVENTS[id], rivals = e.pool, pick = rivals[Math.min(round, rivals.length - 1)], t = e.rounds.length > 1 ? round / (e.rounds.length - 1) : 1;\n  return { name: DRIVER_NAMES[(5 + round * 3) % DRIVER_NAMES.length], carId: Array.isArray(pick) ? pick[0] : pick, tune: null, skill: e.pace[0] + (e.pace[1] - e.pace[0]) * t };\n}\n// One finished round. order: names from first to last, playerName among them. Returns what was paid.\nexport function recordRound(profile, id, order, playerName = 'YOU', mult = 1) {\n  const e = EVENTS[id], st = eventState(profile, id), pos = order.indexOf(playerName), prize = pos >= 0 && pos < PRIZE_RATIO.length ? Math.round(e.prize * PRIZE_RATIO[pos] * mult) : 0, out = { pos: pos + 1, prize, points: 0, seriesDone: false, seriesWon: false, bonus: 0, prizeCar: null, ending: false };\n  order.forEach((name, i) => { st.points[name] = (st.points[name] ?? 0) + (POINTS[i] ?? 0); });\n  out.points = POINTS[pos] ?? 0;\n  profile.credits += prize; profile.day++; profile.stats.races++;\n  if (pos === 0) { profile.stats.wins++; st.wins++; }\n  if (e.rally && pos === 0) st.legs++;\n  st.round++;\n  if (st.round >= e.rounds.length) {\n    out.seriesDone = true;\n    const mine = st.points[playerName] ?? 0, won = e.rally ? st.legs >= Math.ceil(e.rounds.length / 2) + (e.rounds.length % 2 ? 0 : 1) - 0 : Object.entries(st.points).every(([n, v]) => n === playerName || v <= mine);\n    out.seriesWon = won;\n    st.done = true;\n    if (won) {\n      const first = !st.won;\n      st.won = true;\n      if (first) {\n        profile.credits += Math.round(e.bonus * mult); out.bonus = Math.round(e.bonus * mult);\n        if (e.prizeCar) { const c = addCar(profile, e.prizeCar, { prize: true }); out.prizeCar = c.carId; }\n        profile.trophies.push({ kind: 'cup', id });\n        if (e.ending) { profile.ended = true; out.ending = true; }\n      }\n    }\n    st.round = 0; st.points = {}; st.legs = 0; // the event may be run again\n  }\n  return out;\n}\nexport const standingsOf = (profile, id) => Object.entries(eventState(profile, id).points).sort((a, b) => b[1] - a[1]);\n// Records: a lap time per track, kept per profile.\nexport function recordLap(profile, trackId, seconds, carId) {\n  const r = profile.records[trackId];\n  if (!r || seconds < r.lap) { profile.records[trackId] = { lap: seconds, carId, day: profile.day }; return true; }\n  return false;\n}\nexport function collectedShare(profile) {\n  const ids = new Set(profile.cars.map((c) => c.carId));\n  return Math.round((ids.size / Object.keys(CAR_INFO).length) * 100);\n}\n// What to try next: one line for the Map.\nexport function nudge(profile) {\n  if (!profile.cars.length) return { to: 'dealer', text: 'DEALER ROW HAS THREE USED CARS YOU CAN AFFORD.' };\n  if (!profile.licences.C) {\n    const next = LICENCES.C.tests.find((t) => !profile.tests[t]?.medal);\n    return { to: 'licence', text: `THE LICENCE CENTRE IS EXPECTING YOU. TEST ${next}.` };\n  }\n  const dawn = profile.events.dawn;\n  if (!dawn?.won && !dawn?.round) return { to: 'events', text: 'THE DAWN PATROL CUP IS OPEN. IT IS YOUR FIRST RACE.' };\n  const cur = EVENT_IDS.find((id) => profile.events[id]?.round > 0);\n  if (cur) return { to: 'events', text: `${EVENTS[cur].name}: ROUND ${profile.events[cur].round + 1} OF ${EVENTS[cur].rounds.length} AWAITS.` };\n  const car = carEntry(profile);\n  if (car && car.kmOil > 240) return { to: 'service', text: 'BENNO HAS BEEN ASKING ABOUT YOUR OIL.' };\n  if (!profile.licences.B) return { to: 'licence', text: 'THE CLUB LICENCE OPENS FOUR MORE EVENTS.' };\n  if (!profile.events.clay?.won) return { to: 'events', text: 'THE RED CLAY RALLY IS OPEN. THE PRIZE IS A CAR.' };\n  if (!profile.licences.A) return { to: 'licence', text: 'THE NATIONAL LICENCE IS THE LAST ONE.' };\n  if (!profile.events.h200?.won && !profile.events.touring?.won) return { to: 'events', text: 'THE TOURING TROPHY AND THE HARBOUR LIGHTS 200 ARE OPEN.' };\n  if (!profile.ended) return { to: 'events', text: 'THE HALCYON GRAND PRIX IS OPEN. THE PENINSULA IS CLOSED FOR IT.' };\n  return { to: 'garage', text: 'YOU MAY KEEP DRIVING. MOST PEOPLE DO.' };\n}\nEOF\ncat > src/game/sim/replaydata.js <<'EOF'\n// Replay recording: every car at 30 Hz into Float32Arrays. Playback interpolates; replays never re-simulate.\nexport const FIELDS = 12; // x y z yaw pitch roll steer rpm throttle gear flags u\nexport const F_BRAKE = 1, F_SLIDE = 2, F_AIR = 4, F_PIT = 8, F_LOCK = 16, F_HEAD = 32;\nexport class Recording {\n  constructor(meta) { this.meta = meta; this.hz = 30; this.frames = 0; this.cap = 1024; this.cars = meta.cars.map(() => new Float32Array(this.cap * FIELDS)); this.marks = []; }\n  add(i, vals) { // vals is an array of FIELDS numbers for car i at the current frame\n    this.cars[i].set(vals, this.frames * FIELDS);\n  }\n  push() { // call once all cars are in: moves to the next frame, growing if needed\n    this.frames++;\n    if (this.frames >= this.cap) { this.cap *= 2; this.cars = this.cars.map((a) => { const b = new Float32Array(this.cap * FIELDS); b.set(a); return b; }); }\n  }\n  get duration() { return this.frames / this.hz; }\n  // Interpolated pose of car i at time t, written into out.\n  sample(i, t, out) {\n    const a = this.cars[i], f = Math.max(0, Math.min(this.frames - 1.001, t * this.hz)), k = Math.floor(f), u = f - k, p = k * FIELDS, q = (k + 1) * FIELDS;\n    const L = (n) => a[p + n] + (a[q + n] - a[p + n]) * u;\n    let dy = a[q + 3] - a[p + 3]; while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI;\n    out.x = L(0); out.y = L(1); out.z = L(2); out.yaw = a[p + 3] + dy * u; out.pitch = L(4); out.roll = L(5); out.steer = L(6); out.rpm = L(7); out.throttle = L(8); out.gear = a[p + 9]; out.flags = a[p + 10]; out.u = L(11);\n    return out;\n  }\n  // 10 Hz, Int16 quantised, base64: what goes to storage.\n  compress() {\n    const step = 3, frames = Math.floor(this.frames / step), carN = this.cars.length, buf = new Int16Array(frames * carN * 9), scale = [10, 50, 10, 5000, 5000, 5000, 10000, 1, 100]; let o = 0;\n    for (let f = 0; f < frames; f++) for (let c = 0; c < carN; c++) {\n      const a = this.cars[c], p = f * step * FIELDS;\n      const y = a[p + 3];\n      const v = [a[p], a[p + 1], a[p + 2], Math.atan2(Math.sin(y), Math.cos(y)), a[p + 4], a[p + 5], a[p + 6], a[p + 7] / 2, a[p + 11]];\n      for (let n = 0; n < 9; n++) buf[o++] = Math.max(-32768, Math.min(32767, Math.round(v[n] * (n === 7 ? 1 : scale[n]))));\n    }\n    const bytes = new Uint8Array(buf.buffer); let s = ''; for (let i = 0; i < bytes.length; i += 8192) s += String.fromCharCode.apply(null, bytes.subarray(i, i + 8192));\n    return { meta: this.meta, frames, carN, data: btoa(s) };\n  }\n  static fromCompressed(z) {\n    const bin = atob(z.data), bytes = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    const buf = new Int16Array(bytes.buffer), r = new Recording(z.meta), step = 3, scale = [10, 50, 10, 5000, 5000, 5000, 10000, 1, 100];\n    r.cap = z.frames * step + 2; r.cars = z.meta.cars.map(() => new Float32Array(r.cap * FIELDS)); r.frames = (z.frames - 1) * step + 1;\n    let o = 0; const vals = [];\n    for (let f = 0; f < z.frames; f++) for (let c = 0; c < z.carN; c++) {\n      for (let n = 0; n < 9; n++) vals[n] = buf[o++] / scale[n];\n      const a = r.cars[c], p = f * step * FIELDS;\n      a[p] = vals[0]; a[p + 1] = vals[1]; a[p + 2] = vals[2]; a[p + 3] = vals[3]; a[p + 4] = vals[4]; a[p + 5] = vals[5]; a[p + 6] = vals[6]; a[p + 7] = vals[7] * 2; a[p + 8] = 1; a[p + 9] = 3; a[p + 10] = 0; a[p + 11] = vals[8];\n      if (f > 0) for (let k = 1; k < step; k++) { const u = k / step, b = (f - 1) * step * FIELDS, m = (((f - 1) * step) + k) * FIELDS; for (let n = 0; n < FIELDS; n++) { let d = a[p + n] - a[b + n]; if (n === 3) { while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; } a[m + n] = a[b + n] + d * u; } }\n    }\n    return r;\n  }\n}\n// A ghost is one car's lap: x, y, z, yaw at 10 Hz.\nexport class GhostTrace {\n  constructor() { this.hz = 10; this.pts = []; }\n  add(x, y, z, yaw) { this.pts.push(Math.round(x * 10), Math.round(y * 20), Math.round(z * 10), Math.round(Math.atan2(Math.sin(yaw), Math.cos(yaw)) * 5000)); }\n  get duration() { return this.pts.length / 4 / this.hz; }\n  toData(time, carId) { return { time, carId, pts: this.pts }; }\n}\nexport function ghostSample(data, t, out) {\n  const n = data.pts.length / 4, f = Math.max(0, Math.min(n - 1.001, t * 10)), k = Math.floor(f), u = f - k, p = data.pts, a = k * 4, b = a + 4;\n  out.x = (p[a] + (p[b] - p[a]) * u) / 10; out.y = (p[a + 1] + (p[b + 1] - p[a + 1]) * u) / 20; out.z = (p[a + 2] + (p[b + 2] - p[a + 2]) * u) / 10;\n  let dy = (p[b + 3] - p[a + 3]) / 5000; while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI;\n  out.yaw = p[a + 3] / 5000 + dy * u; out.done = t * 10 >= n - 1;\n  return out;\n}\nEOF\ncat > src/game/sim/race.js <<'EOF'\n// RaceSim: the field, laps, flags, starts, pit lane, slipstream, results, replay feed and events. Plain JS, no engine.\nimport { aiDrive, buildTrack, collideCars, G, newCar, racingLine, speedProfile, stepCar } from './sim.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { tunedParams } from './tuning.js';\nimport { F_AIR, F_BRAKE, F_HEAD, F_LOCK, F_PIT, F_SLIDE, FIELDS, GhostTrace, Recording } from './replaydata.js';\n\nexport const PIT_WIDTH = 8, PIT_SPEED = 60 / 3.6;\nconst lineCache = new Map(), profileCache = new Map();\nexport function loadTrack(id, { rain = false } = {}) {\n  const tr = buildTrack(TRACKS[id]);\n  tr.id = id; tr.name = TRACKS[id].name; tr.pit = TRACKS[id].pit ?? null;\n  if (rain) tr.muScale = 0.78;\n  if (!lineCache.has(id)) lineCache.set(id, racingLine(tr));\n  if (tr.pit) forPit(tr, (i) => { tr.wallR[i] = PIT_WIDTH + 2; });\n  return { tr, line: lineCache.get(id) };\n}\nexport const wrapS = (tr, s) => ((s % tr.length) + tr.length) % tr.length;\nconst rel = (tr, s) => { let d = wrapS(tr, s); if (d > tr.length / 2) d -= tr.length; return d; };\nfunction forPit(tr, fn) { for (let i = 0; i < tr.N; i++) { const d = rel(tr, i * tr.ds); if (d >= tr.pit.in && d <= tr.pit.out) fn(i, d); } }\nexport function trackPoint(tr, s, t, out = {}) {\n  const S = wrapS(tr, s), f = S / tr.ds, i = Math.floor(f) % tr.N, j = (i + 1) % tr.N, u = f - Math.floor(f), L = (a) => a[i] + (a[j] - a[i]) * u, tx = L(tr.tx), tz = L(tr.tz), bk = L(tr.bank);\n  out.x = L(tr.x) - tz * t; out.z = L(tr.z) + tx * t; out.y = L(tr.y) - t * Math.sin(bk); out.yaw = Math.atan2(tx, tz); out.i = i; out.tx = tx; out.tz = tz; out.width = L(tr.width); out.bank = bk; out.slope = tr.slope[i];\n  return out;\n}\nexport function indexOfS(tr, s) { return Math.round(wrapS(tr, s) / tr.ds) % tr.N; }\nfunction mulberry(seed) { let a = seed >>> 0; return () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nexport function carProfile(tr, line, p, carId, installKey) {\n  const key = `${tr.id}|${carId}|${installKey}|${tr.muScale}`;\n  let v = profileCache.get(key);\n  if (!v) { const surf = (tr.surface === 'dirt' ? (p.tyreTable?.dirt ?? 0.62) : 1) * tr.muScale; v = speedProfile(tr, line, p, surf); profileCache.set(key, v); }\n  return v;\n}\nexport const defaultEnv = () => ({ gripScale: 1, powerScale: 1, brakeScale: 1, aeroScale: 1, wearScale: 1, fuelScale: 1, wallLoss: 1, stability: 1, traction: 1, rubber: 0, slip: 0.65, aiPace: null, god: false, steerRate: 3 });\nconst BASE_WEAR = 0.0012, BASE_FUEL = 0.0018;\nexport class RaceSim {\n  // setup: { kind, track, laps, rain, start, startS, startSpeed, contact, wear, fuel, cars: [{ carId, install, oil, name, paint, skill, player, assists, seat }], seed, stagger }\n  constructor(setup) {\n    this.setup = setup; this.kind = setup.kind ?? 'race'; this.laps = setup.laps ?? 1; this.rng = mulberry(setup.seed ?? 1);\n    const { tr, line } = loadTrack(setup.track, { rain: setup.rain }); this.tr = tr; this.line = line;\n    this.contact = setup.contact !== false; this.wearMul = setup.wear ?? 1; this.fuelMul = setup.fuel ?? 1; this.env = setup.env ?? defaultEnv();\n    this.frame = 0; this.time = 0; this.greenAt = null; this.phase = 'grid'; this.lights = 0; this.lightT = 0; this.events = []; this.order = []; this.done = false; this.leaderFinishedAt = null; this.hold = !!setup.hold; this.subEnv = {}; this.flaggedAt = null; this.hourNow = setup.hour ?? TRACKS[setup.track].hour; this.cool = false;\n    this.cars = setup.cars.map((d, i) => this.makeEntry(d, i));\n    this.placeGrid();\n    this.players = this.cars.filter((e) => e.player !== null && e.player !== undefined);\n    this.order = this.cars.slice();\n    this.rec = setup.record === false ? null : new Recording({ track: setup.track, hour: this.hourNow, hourEnd: setup.hourEnd ?? null, rain: !!setup.rain, cars: this.cars.map((e) => ({ carId: e.carId, install: e.install, name: e.name, paint: e.paint, player: e.player ?? null })) });\n    this.recVals = new Array(FIELDS).fill(0);\n    this.updateOrder();\n  }\n  makeEntry(d, i) {\n    const p = tunedParams(d.carId, d.install), tr = this.tr, c = newCar(p, tr, 0, 0), installKey = d.install ? JSON.stringify(d.install) : '';\n    c.oil = d.oil ?? 1;\n    const e = { i, carId: d.carId, install: d.install ?? null, name: d.name ?? `CAR ${i + 1}`, paint: d.paint ?? null, player: d.player ?? null, seat: d.seat ?? null, c, p, installKey, speeds: carProfile(tr, this.line, p, d.carId, installKey), skill: d.skill ?? 0.9, assists: d.assists ?? null, lap: 0, lastS: 0, lapStart: null, lastLap: null, bestLap: null, finished: false, finishTime: null, retired: false, progress: 0, pit: null, noContact: 0, stopped: 0, recoveries: 0, walls: 0, topSpeed: 0, wrongWay: false, reverse: false, brakeHold: 0, dirt: 0, dirtM: 0, metres: 0, lapse: 0, lapseAt: 0.2 + 0.6 * this.rng(), phase: this.rng() * 6.28, slip: false, autoDrive: false, wantPit: false, pits: 0, startDelay: d.startDelay ?? 0, ownStart: null, splits: [], lastSurface: null, lastGear: 1, lastWalls: 0, lastAir: false, airT: 0, lockT: 0, onLapDirty: false, flagged: false, input: null, laneNow: 0 };\n    return e;\n  }\n  placeGrid() {\n    const s = this.setup, tr = this.tr, n = this.cars.length;\n    const place = (e, S, t, speed) => { const i = indexOfS(tr, S), pt = trackPoint(tr, S, t), c = e.c; c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.loc.i = i; c.loc.s = wrapS(tr, S); c.loc.t = t; c.vx = Math.sin(pt.yaw) * speed; c.vz = Math.cos(pt.yaw) * speed; c.u = speed; e.lastS = wrapS(tr, S); c.laneNow = t - this.line.off[i]; e.gridT = t; };\n    const kind = s.start ?? 'standing';\n    if (kind === 'rolling') {\n      this.phase = 'rolling';\n      this.cars.forEach((e, k) => place(e, -150 - Math.floor(k / 2) * 12, k % 2 ? 2.6 : -2.6, 80 / 3.6));\n    } else if (kind === 'flying') {\n      this.phase = 'green'; this.greenAt = 0;\n      const S = s.startS ?? -220;\n      this.cars.forEach((e, k) => { place(e, S - k * 12, 0, (s.startSpeed ?? 120) / 3.6); e.ownStart = 0; });\n    } else { // standing, and rally's stagger\n      this.phase = 'grid';\n      const S0 = s.startS ?? -12;\n      this.cars.forEach((e, k) => {\n        const row = Math.floor(k / 2), staggered = kind === 'stagger';\n        place(e, staggered ? S0 : S0 - row * 9, staggered ? 0 : k % 2 ? 2.6 : -2.6, 0);\n      });\n    }\n    this.updateProgressAll();\n  }\n  updateProgressAll() { for (const e of this.cars) e.progress = this.progressOf(e); }\n  progressOf(e) { return (e.lap - 1) * this.tr.length + (e.lap === 0 ? wrapS(this.tr, e.c.loc.s) : e.c.loc.s); }\n  go() { if (this.phase === 'grid') { this.hold = false; this.green(); } }\n  green() { this.phase = 'green'; this.greenAt = this.time; for (const e of this.cars) if (e.startDelay === 0) e.ownStart = this.time; this.events.push({ type: 'flag', kind: 'green' }); }\n  emit(type, car, extra) { this.events.push({ type, car: car?.i ?? -1, ...extra }); }\n  drainEvents() { const ev = this.events; this.events = []; return ev; }\n  envFor(e) {\n    const v = this.env, god = v.god && e.player !== null, se = this.subEnv;\n    se.gripScale = v.gripScale; se.powerScale = v.powerScale; se.brakeScale = v.brakeScale; se.aeroScale = v.aeroScale;\n    se.wearRate = god ? 0 : BASE_WEAR * this.wearMul * v.wearScale; se.fuelRate = god ? 0 : BASE_FUEL * this.fuelMul * v.fuelScale; se.wallLoss = god ? 0 : v.wallLoss;\n    return se;\n  }\n  aiInput(e, skillMul = 1) {\n    const c = e.c, tr = this.tr, u = Math.hypot(c.vx, c.vz);\n    let skill = (this.env.aiPace ?? e.skill) * skillMul;\n    if (e.lapse > 0) { skill -= 0.04; e.lapse -= 1 / 60; }\n    if (this.env.rubber > 0 && this.players.length) { const lead = this.players[0].progress - e.progress; skill += Math.max(-1, Math.min(1, lead / 150)) * this.env.rubber; }\n    let lane = Math.sin(e.phase + this.time * 0.3) * 0.6;\n    if (this.phase === 'rolling') { lane = (e.gridT ?? 0) - this.line.off[c.loc.i]; }\n    const field = this.contact && !e.finished ? this.cars : null;\n    const inp = aiDrive(c, tr, this.line, e.speeds, { skill, lane }, field);\n    if (this.phase === 'rolling') { const err = 88 / 3.6 - u; inp.throttle = err > 0 ? Math.min(1, err) : 0; inp.brake = err < -1 ? 0.3 : 0; }\n    if (tr.surface === 'dirt') inp.asm = (inp.asm ?? 0.6) * 0.5;\n    return inp;\n  }\n  driverInput(e, raw) {\n    // raw: { steer, throttle, brake, handbrake, up, down } from the input layer. Assists come from the profile.\n    const c = e.c, a = e.assists ?? {}, env = this.env, inp = e.input ?? (e.input = {});\n    let throttle = raw.throttle ?? 0, brake = raw.brake ?? 0;\n    const speed = c.u;\n    // Reverse: hold the brake at a standstill for 0.4 s. Any throttle returns to first.\n    if (e.reverse) { if (throttle > 0.05) { e.reverse = false; c.gear = 1; } else { throttle = brake; brake = 0; } }\n    else if (brake > 0.2 && throttle < 0.05 && Math.abs(speed) < 0.5) { e.brakeHold += 1 / 60; if (e.brakeHold > 0.4) { e.reverse = true; e.brakeHold = 0; c.gear = 1; } } else e.brakeHold = 0;\n    inp.steer = raw.steer ?? 0; inp.throttle = throttle; inp.brake = brake; inp.handbrake = !!raw.handbrake; inp.reverse = e.reverse;\n    inp.abs = a.abs !== false; inp.auto = a.auto !== false; inp.up = !!raw.up; inp.down = !!raw.down;\n    inp.tcs = Math.min(1, ((a.tcs ?? 5) / 10) * env.traction); inp.asm = Math.min(1, ((a.asm ?? 5) / 10) * env.stability * (this.tr.surface === 'dirt' ? 0.5 : 1)); inp.steerRate = env.steerRate;\n    if (this.phase === 'rolling') { if (c.u > 25) { inp.throttle = 0; if (c.u > 26) inp.brake = Math.max(inp.brake, 0.3); } }\n    if (this.phase === 'grid') { inp.throttle = 0; inp.brake = 1; inp.handbrake = false; inp.reverse = false; }\n    if (e.ownStart === null && this.phase !== 'rolling') { inp.throttle = 0; inp.brake = 1; }\n    return inp;\n  }\n  step(inputs = []) {\n    const dt = 1 / 60;\n    this.frame++; this.time += dt;\n    const setupStart = this.setup.start;\n    if (this.phase === 'grid' && !this.hold) {\n      this.lightT += dt;\n      const lit = Math.min(5, Math.floor(this.lightT / 0.6));\n      if (lit !== this.lights) { this.lights = lit; this.events.push({ type: 'flag', kind: 'lights', n: lit }); }\n      if (this.lightT > 3.4) this.green();\n    }\n    if (this.phase === 'rolling') {\n      const leader = this.cars.reduce((a, b) => (this.progressOf(a) > this.progressOf(b) ? a : b));\n      if (this.progressOf(leader) >= 0 && leader.lap >= 1) { this.green(); }\n    }\n    for (const e of this.cars) {\n      if (e.ownStart === null && this.phase === 'green' && this.time - this.greenAt >= e.startDelay) { e.ownStart = this.time; if (e.player !== null) this.events.push({ type: 'flag', kind: 'green', own: true }); }\n    }\n    this.slipstream();\n    for (const e of this.cars) {\n      const human = e.player !== null && !e.autoDrive && !e.finished && !e.retired;\n      if (e.pit) { e.inp = null; continue; }\n      if (human) e.inp = this.driverInput(e, inputs[e.player] ?? {});\n      else {\n        const held = (this.phase === 'grid') || (e.ownStart === null && this.phase !== 'rolling');\n        e.inp = held ? { steer: 0, throttle: 0, brake: 1, abs: true, auto: true, tcs: 0, asm: 0 } : this.aiInput(e, e.finished ? 0.82 : 1);\n        if (e.wantPit && e.c.loc.t < 0 && false) e.inp.steer += 0;\n      }\n    }\n    const contactCars = this.contact ? this.cars.filter((e) => !e.pit && e.noContact <= 0 && !e.ghost).map((e) => e.c) : null;\n    for (let sub = 0; sub < 4; sub++) {\n      for (const e of this.cars) {\n        if (e.pit) continue;\n        const inp = e.inp;\n        if (sub > 0 && inp.up) { inp.up = false; }\n        if (sub > 0 && inp.down) { inp.down = false; }\n        stepCar(e.c, inp, 1 / 240, this.tr, this.envFor(e));\n      }\n      if (contactCars) collideCars(contactCars);\n    }\n    for (const e of this.cars) this.post(e, dt);\n    if (this.setup.hourEnd !== undefined && this.setup.hourEnd !== null && this.laps > 0) {\n      const lead = Math.max(0, Math.max(...this.cars.map((e) => e.progress))) / (this.laps * this.tr.length);\n      this.hourNow = (this.setup.hour ?? 18.5) + (this.setup.hourEnd - (this.setup.hour ?? 18.5)) * Math.min(1, lead);\n    }\n    this.updateOrder();\n    this.checkFinish();\n    if (this.rec && this.frame % 2 === 0) this.record();\n    void setupStart;\n  }\n  slipstream() {\n    const tr = this.tr, slip = this.env.slip;\n    for (const e of this.cars) {\n      e.slip = false; e.c.dragScale = 1;\n      if (Math.abs(e.c.u) < 100 / 3.6 || e.pit) continue;\n      for (const b of this.cars) {\n        if (b === e || b.pit) continue;\n        let gap = (b.c.loc.s - e.c.loc.s + tr.length) % tr.length;\n        if (gap > 0.5 && gap < 25 && Math.abs(b.c.loc.t - e.c.loc.t) < 2) { e.c.dragScale = slip; e.slip = true; break; }\n      }\n    }\n  }\n  post(e, dt) {\n    const c = e.c, tr = this.tr;\n    if (e.pit) this.stepPit(e, dt);\n    if (e.noContact > 0) e.noContact -= dt;\n    // Lap count: s wraps from past 90% to under 10% going forward.\n    const s = c.loc.s, L = tr.length;\n    if (e.lastS > L * 0.9 && s < L * 0.1) this.crossLine(e);\n    else if (e.lastS < L * 0.1 && s > L * 0.9) { if (e.lap > 0) e.lap--; }\n    const moved = Math.min(5, Math.abs(wrapDelta(s, e.lastS, L)));\n    e.metres += moved;\n    if (c.surface === 'dirt' || c.surface === 'gravel') { e.dirtM += moved; e.dirt = Math.min(1, e.dirt + moved * 0.0002); }\n    e.lastS = s;\n    e.progress = this.progressOf(e);\n    e.topSpeed = Math.max(e.topSpeed, Math.abs(c.u));\n    const sp = Math.hypot(c.vx, c.vz);\n    // Wrong way\n    const dot = Math.sin(c.yaw) * tr.tx[c.loc.i] + Math.cos(c.yaw) * tr.tz[c.loc.i];\n    e.wrongWay = !e.pit && dot < 0 && sp > 5;\n    // Events\n    if (c.gear !== e.lastGear) { this.emit('shift', e, { up: c.gear > e.lastGear, gear: c.gear }); e.lastGear = c.gear; }\n    if (c.surface !== e.lastSurface) { if (c.surface === 'kerb' && sp > 8) this.emit('kerb', e); e.lastSurface = c.surface; }\n    if (c.wallHits !== e.lastWalls) { e.walls += c.wallHits - e.lastWalls; if (c.contact > 0.6) this.emit('wallHit', e, { v: c.contact }); e.lastWalls = c.wallHits; }\n    else if (c.touching) { if (c.contact > 0.6) this.emit('carHit', e, { v: c.contact }); }\n    c.touching = null; c.contact = 0;\n    if (c.locked) { e.lockT += dt; if (e.lockT > 0.08 && !e.lockedNow) { e.lockedNow = true; this.emit('lockup', e); } } else { e.lockT = 0; e.lockedNow = false; }\n    if (c.airborne !== e.lastAir) { if (e.lastAir && e.airT > 0.12) this.emit('land', e, { air: e.airT, v: Math.abs(c.vy) }); e.lastAir = c.airborne; e.airT = 0; }\n    if (c.airborne) e.airT += dt;\n    // Pit entry\n    if (tr.pit && !e.pit && !e.finished) {\n      const d = rel(tr, s);\n      if (d > tr.pit.in - 4 && d < tr.pit.in + 8) {\n        const human = e.player !== null && !e.autoDrive;\n        const inLane = human ? c.loc.t > tr.width[c.loc.i] / 2 - 1 : false;\n        if ((human && inLane && c.u > 1) || (!human && (e.wantPit || (this.setup.fuel ?? 1) > 0 && this.needsPit(e)))) this.enterPit(e);\n      }\n    }\n    // AI: wants a stop; and AI that stops gets itself back on the road.\n    const isAi = e.player === null || e.autoDrive;\n    if (isAi && !e.pit) {\n      if (this.needsPit(e)) e.wantPit = true;\n      if (sp < 1 && this.phase === 'green' && e.ownStart !== null) { e.stopped += dt; if (e.stopped > 3) this.recover(e.i); } else e.stopped = 0;\n      if (e.skill < 0.93 && e.lapse <= 0 && e.lapseAt >= 0) { const f = s / L; if (Math.abs(f - e.lapseAt) < 0.004 && !e.lapsedThisLap) { e.lapse = 2; e.lapsedThisLap = true; } }\n    }\n    // Splits: the time at each 20 m, for gap readouts between staggered cars.\n    if (e.ownStart !== null) { const k = Math.floor(Math.max(0, e.progress) / 20); if (k >= e.splits.length) { for (let n = e.splits.length; n <= k; n++) e.splits[n] = this.time - e.ownStart; } }\n  }\n  needsPit(e) { if (!e.p) return false; const mean = (e.c.wear[0] + e.c.wear[1] + e.c.wear[2] + e.c.wear[3]) / 4; return !!this.tr.pit && (mean < 0.3 || e.c.fuel < 0.12) && !e.finished && this.laps > 3; }\n  crossLine(e) {\n    e.lap++; e.lapsedThisLap = false;\n    const now = this.time;\n    if (e.lapStart !== null && !e.finished) {\n      const t = now - e.lapStart; e.lastLap = t; if (e.bestLap === null || t < e.bestLap) { e.bestLap = t; }\n      this.emit('lap', e, { time: t, lap: e.lap });\n    } else if (e.lap === 1) this.emit('lap', e, { time: null, lap: 1 });\n    e.lapStart = now;\n    if (!e.finished && this.laps > 0 && e.lap > this.laps && this.phase !== 'rolling') {\n      e.finished = true; e.finishTime = e.ownStart !== null ? now - e.ownStart : now;\n      this.emit('flag', e, { kind: 'finish', own: e.player !== null });\n      if (this.leaderFinishedAt === null) this.leaderFinishedAt = now;\n      if (e.player !== null) e.autoDrive = true;\n    } else if (!e.finished && this.laps > 0 && e.lap === this.laps && e.player !== null) this.emit('flag', e, { kind: 'finalLap' });\n  }\n  enterPit(e) {\n    const c = e.c, tr = this.tr, halfW = tr.width[c.loc.i] / 2;\n    e.pit = { phase: 'in', s: rel(tr, c.loc.s), t: c.loc.t, speed: Math.min(Math.abs(c.u), 45), box: tr.pit.box + (e.i - this.cars.length / 2) * 12, laneT: halfW + 3.6, boxT: halfW + 5.6, svc: 0, tyres: 0, fuel: 0, skipTyres: false, startedAt: this.time };\n    c.inPit = true; e.wantPit = false; e.pits++; c.dragScale = 1;\n    this.emit('pitIn', e);\n  }\n  stepPit(e, dt) {\n    const c = e.c, tr = this.tr, P = e.pit, A = 14;\n    if (P.phase === 'in') {\n      const dist = P.box - P.s, stopV = Math.sqrt(Math.max(0, 2 * 7 * dist));\n      const want = Math.min(PIT_SPEED, stopV);\n      P.speed = P.speed > want ? Math.max(want, P.speed - A * dt) : Math.min(want, P.speed + 8 * dt);\n      P.s += P.speed * dt;\n      P.t += (P.laneT - P.t) * Math.min(1, dt * 1.8);\n      if (dist < 28) P.t += (P.boxT - P.t) * Math.min(1, dt * 2.2);\n      if (dist < 0.3 || (P.speed < 0.3 && dist < 3)) {\n        P.phase = 'box'; P.speed = 0;\n        const mean = (c.wear[0] + c.wear[1] + c.wear[2] + c.wear[3]) / 4;\n        P.tyres = mean < 0.7 ? 4 : 0;\n        P.fuel = (1 - c.fuel) * 100 * 0.1;\n        P.total = Math.max(P.tyres, P.fuel);\n        this.emit('pitBox', e, { tyres: P.tyres > 0, fuel: P.fuel });\n      }\n    } else if (P.phase === 'box') {\n      P.svc += dt;\n      if (P.fuel > 0) c.fuel = Math.min(1, c.fuel + (dt / 0.1) / 100);\n      if (P.skipTyres) P.tyres = 0;\n      if (P.svc >= Math.max(P.tyres, P.fuel)) {\n        if (P.tyres > 0) { c.wear[0] = c.wear[1] = c.wear[2] = c.wear[3] = 1; }\n        P.phase = 'out'; this.emit('pitGo', e, { time: P.svc });\n      }\n    } else if (P.phase === 'out') {\n      P.speed = Math.min(PIT_SPEED, P.speed + 9 * dt);\n      P.s += P.speed * dt;\n      const halfW = tr.width[c.loc.i] / 2, remain = tr.pit.out - P.s;\n      if (remain > 90) P.t += (P.laneT - P.t) * Math.min(1, dt * 1.5); else P.t += (halfW - 1.8 - P.t) * Math.min(1, dt * 0.9);\n      if (remain <= 0) {\n        const pt = trackPoint(tr, P.s, P.t); c.vx = Math.sin(pt.yaw) * P.speed; c.vz = Math.cos(pt.yaw) * P.speed; c.inPit = false; e.pit = null; e.noContact = 1.5; c.delta = 0; c.r = 0;\n        this.emit('pitOut', e);\n        return;\n      }\n    }\n    const pt = trackPoint(tr, P.s, P.t);\n    c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.vy = 0; c.vx = Math.sin(pt.yaw) * P.speed; c.vz = Math.cos(pt.yaw) * P.speed; c.u = P.speed; c.w = 0; c.r = 0; c.delta *= 0.9; c.ax = 0; c.ay = 0;\n    c.rpm = c.p.idle + P.speed * 120; c.gear = 1; c.sliding = false; c.locked = false; c.airborne = false; c.surface = 'apron';\n    c.loc.i = pt.i; c.loc.s = wrapS(tr, P.s); c.loc.t = P.t;\n  }\n  skipTyres(i) { const P = this.cars[i]?.pit; if (P && P.phase === 'box') P.skipTyres = true; }\n  recover(i) {\n    const e = this.cars[i], c = e.c, tr = this.tr, line = this.line;\n    if (e.pit) return false;\n    const k = c.loc.i, x = line.px[k], z = line.pz[k], yaw = Math.atan2(tr.tx[k], tr.tz[k]);\n    c.x = x; c.z = z; c.y = tr.y[k]; c.vy = 0; c.yaw = yaw; c.vx = 0; c.vz = 0; c.r = 0; c.delta = 0; c.gear = 1; c.ax = 0; c.ay = 0; c.shift = 0; c.loc.t = line.off[k]; c.u = 0; c.w = 0; c.laneNow = 0;\n    e.noContact = 2; e.reverse = false; e.stopped = 0; e.recoveries++;\n    this.emit('recover', e);\n    return true;\n  }\n  retire(i) { const e = this.cars[i]; e.retired = true; e.autoDrive = true; e.finished = true; e.finishTime = null; }\n  updateOrder() {\n    const score = (e) => (e.retired ? -1e9 : e.finished && e.finishTime !== null ? 1e9 - e.finishTime : e.progress);\n    this.order = this.cars.slice().sort((a, b) => score(b) - score(a));\n    this.order.forEach((e, k) => { e.pos = k + 1; });\n  }\n  checkFinish() {\n    // After the leader flag, a player gets a while to finish; then they are flagged where they are.\n    if (this.leaderFinishedAt !== null && !this.done) {\n      const best = this.cars.reduce((a, e) => (e.bestLap && (!a || e.bestLap < a) ? e.bestLap : a), null) ?? 90;\n      if (this.time - this.leaderFinishedAt > Math.max(60, best * 1.25)) {\n        for (const e of this.cars) if (!e.finished && !e.flagged) { e.flagged = true; if (e.player !== null) { e.finished = true; e.finishTime = null; e.autoDrive = true; this.emit('flag', e, { kind: 'finish', own: true, flagged: true }); } }\n      }\n    }\n    if (!this.done && this.players.length && this.players.every((e) => e.finished)) { this.done = true; this.doneAt = this.time; }\n  }\n  // Times shown to the player: leader's time, gaps for the rest.\n  results() {\n    const rows = this.order.map((e) => ({ i: e.i, name: e.name, carId: e.carId, player: e.player, pos: e.pos, time: e.finishTime, finished: e.finished && !e.retired && e.finishTime !== null, retired: e.retired, best: e.bestLap, progress: e.progress }));\n    const leader = rows[0], lapLen = this.tr.length;\n    for (const r of rows) {\n      if (r === leader) { r.text = r.finished ? formatTime(r.time) : '--:--'; continue; }\n      if (r.finished) r.text = `+${(r.time - leader.time).toFixed(2)}`;\n      else if (r.retired) r.text = 'RETIRED';\n      else { const laps = Math.max(0, Math.floor((leader.progress - r.progress) / lapLen)); r.text = laps >= 1 ? `+${laps} LAP` : 'RUNNING'; }\n    }\n    return rows;\n  }\n  gapAhead(e) {\n    const k = this.order.indexOf(e); if (k <= 0) return null;\n    const a = this.order[k - 1], d = a.progress - e.progress, v = Math.max(8, Math.abs(e.c.u));\n    return d / v;\n  }\n  gapBehind(e) {\n    const k = this.order.indexOf(e); if (k < 0 || k >= this.order.length - 1) return null;\n    const b = this.order[k + 1], d = e.progress - b.progress, v = Math.max(8, Math.abs(b.c.u));\n    return d / v;\n  }\n  // Rally: how far ahead on the clock, comparing our time now to the rival's time at this same place.\n  clockGap(e, rival) {\n    if (e.ownStart === null || rival.ownStart === null) return null;\n    const k = Math.floor(Math.max(0, e.progress) / 20);\n    const theirs = rival.splits[k], mine = this.time - e.ownStart;\n    if (theirs !== undefined) return mine - theirs; // positive: we are behind\n    const k2 = Math.floor(Math.max(0, rival.progress) / 20), mineThere = e.splits[k2], theirNow = this.time - rival.ownStart;\n    return mineThere !== undefined ? mineThere - theirNow : null;\n  }\n  record() {\n    const v = this.recVals;\n    for (const e of this.cars) {\n      const c = e.c, inp = e.inp, br = inp ? inp.brake > 0.05 : e.pit?.phase === 'in';\n      v[0] = c.x; v[1] = c.y; v[2] = c.z; v[3] = c.yaw; v[4] = this.bodyPitch(e); v[5] = this.bodyRoll(e); v[6] = c.delta; v[7] = c.rpm; v[8] = inp ? inp.throttle : 0.2; v[9] = c.gear;\n      v[10] = (br ? F_BRAKE : 0) | (c.sliding ? F_SLIDE : 0) | (c.airborne ? F_AIR : 0) | (e.pit ? F_PIT : 0) | (c.locked ? F_LOCK : 0) | F_HEAD; v[11] = c.u;\n      this.rec.add(e.i, v);\n    }\n    this.rec.push();\n  }\n  bodyPitch(e) { const c = e.c, tr = this.tr; return -c.ax * 0.004 - Math.atan(tr.slope[c.loc.i] * Math.sign(c.u || 1)) * (Math.cos(c.yaw - Math.atan2(tr.tx[c.loc.i], tr.tz[c.loc.i])) > 0 ? 1 : -1); }\n  bodyRoll(e) { const c = e.c, tr = this.tr; return c.ay * 0.008 + tr.bank[c.loc.i]; }\n  fingerprint() {\n    let h = 2166136261 >>> 0;\n    const mix = (v) => { h ^= v | 0; h = Math.imul(h, 16777619) >>> 0; };\n    for (const e of this.cars) { mix(Math.round(e.c.x * 100)); mix(Math.round(e.c.z * 100)); mix(e.lap); mix(Math.round(e.c.wear[0] * 10000)); mix(Math.round(e.c.fuel * 10000)); }\n    return h.toString(16);\n  }\n  // Dev mode's save state: the sim as JSON, without its references.\n  saveState() {\n    return JSON.stringify({ time: this.time, frame: this.frame, phase: this.phase, greenAt: this.greenAt, cars: this.cars.map((e) => { const { p, touching, ...c } = e.c; return { c, lap: e.lap, lastS: e.lastS, lapStart: e.lapStart, bestLap: e.bestLap, lastLap: e.lastLap, finished: e.finished, finishTime: e.finishTime, ownStart: e.ownStart, autoDrive: e.autoDrive, pit: e.pit, metres: e.metres }; }), done: this.done, leaderFinishedAt: this.leaderFinishedAt });\n  }\n  loadState(json) {\n    const s = JSON.parse(json);\n    this.time = s.time; this.frame = s.frame; this.phase = s.phase; this.greenAt = s.greenAt; this.done = s.done; this.leaderFinishedAt = s.leaderFinishedAt;\n    s.cars.forEach((d, i) => { const e = this.cars[i]; Object.assign(e.c, d.c); e.lap = d.lap; e.lastS = d.lastS; e.lapStart = d.lapStart; e.bestLap = d.bestLap; e.lastLap = d.lastLap; e.finished = d.finished; e.finishTime = d.finishTime; e.ownStart = d.ownStart; e.autoDrive = d.autoDrive; e.pit = d.pit; e.metres = d.metres; e.progress = this.progressOf(e); });\n    this.updateOrder();\n  }\n  teleport(i, s) { const e = this.cars[i], tr = this.tr, c = e.c, pt = trackPoint(tr, s, 0); c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.loc.i = pt.i; c.loc.s = wrapS(tr, s); c.loc.t = 0; c.vx = 0; c.vz = 0; c.r = 0; c.delta = 0; c.vy = 0; e.lastS = c.loc.s; e.progress = this.progressOf(e); }\n  // Dev: finish now in position n (1-based).\n  finishNow(i, n = 1) {\n    const e = this.cars[i], others = this.cars.filter((x) => x !== e), base = this.time;\n    others.forEach((o, k) => { const ahead = k < n - 1; if (!o.finished) { o.finished = true; o.finishTime = base + (ahead ? -5 + k : 5 + k) - (o.ownStart ?? 0); } });\n    if (!e.finished) { e.finished = true; e.finishTime = base - (e.ownStart ?? 0); e.autoDrive = e.player !== null; }\n    this.leaderFinishedAt = this.leaderFinishedAt ?? base;\n    this.updateOrder(); this.checkFinish();\n    this.emit('flag', e, { kind: 'finish', own: true });\n  }\n}\nfunction wrapDelta(a, b, L) { let d = a - b; if (d > L / 2) d -= L; else if (d < -L / 2) d += L; return d; }\nexport function formatTime(t) {\n  if (t === null || t === undefined || !Number.isFinite(t)) return '--:--.-';\n  const m = Math.floor(t / 60), s = t - m * 60;\n  return `${m}:${s < 10 ? '0' : ''}${s.toFixed(2)}`;\n}\nexport { GhostTrace, G };\nEOF\ncat > src/game/sim/licence.js <<'EOF'\n// Licence tests: the setup for a test, the judge that watches an attempt, and the demonstration's brain.\nimport { aiDrive } from './sim.js';\nimport { indexOfS, RaceSim, trackPoint, wrapS } from './race.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { fullInstall } from './tuning.js';\n\nexport function placeS(tr, at) { return wrapS(tr, at.s !== undefined ? at.s : tr.cornerS[at.c] + (at.off ?? 0)); }\nexport const legCount = (test) => test.legs?.length ?? 1;\nexport const legCar = (test, leg) => test.legs?.[leg] ?? test.carId;\nexport function testSetup(test, leg = 0, assists = {}, player = 0) {\n  const carId = legCar(test, leg), dummy = new RaceSim({ track: test.track, cars: [], record: false }), tr = dummy.tr;\n  const startS = placeS(tr, test.start);\n  return {\n    kind: 'licence', track: test.track, laps: 0, hour: test.hour ?? TRACKS[test.track].hour, start: 'flying', startS, startSpeed: test.startSpeed ?? 0, contact: false,\n    wear: 0, fuel: 0, cars: [{ carId, install: null, name: 'YOU', paint: null, player, assists: { abs: true, tcs: 5, asm: 5, auto: true, ...assists, ...(test.assists ?? {}) } }],\n    test: test.id, leg,\n  };\n}\n// Watches one attempt. status: running, pass, fail. time counts per the plan's rules; penalties are added at the end.\nexport class Judge {\n  constructor(test, sim) {\n    this.test = test; this.sim = sim; const tr = sim.tr;\n    this.status = 'running'; this.reason = ''; this.time = 0; this.running = !test.standing && test.kind !== 'lap'; this.penalty = 0; this.offT = 0; this.startProgress = 0; this.lastRel = 0;\n    this.startS = placeS(tr, test.start);\n    this.distance = test.kind === 'lap' ? tr.length + wrapRel(tr, 0 - this.startS) : test.end ? wrapS(tr, placeS(tr, test.end) - this.startS) : 0;\n    if (test.kind === 'lap') this.lineAt = wrapS(tr, 0 - this.startS);\n    this.travelled = 0; this.lastS = sim.cars[0].c.loc.s;\n    if (test.box) { this.boxFrom = wrapS(tr, test.box.s - this.startS) - test.box.len / 2; this.boxTo = this.boxFrom + test.box.len; this.limit = this.boxTo + 40; }\n    if (test.cones) {\n      this.cones = [];\n      for (let k = 0; k < test.cones.count; k++) { const s = test.cones.from + k * test.cones.spacing, pt = trackPoint(tr, s, 0); this.cones.push({ s, rel: wrapS(tr, s - this.startS), x: pt.x, y: pt.y, z: pt.z, yaw: pt.yaw, side: k % 2 ? -1 : 1, hit: false, passed: false, tumble: 0 }); }\n    }\n    this.coneHits = 0;\n    this.timeLimit = (test.medals?.bronze ?? 120) * 2.2 + 15;\n  }\n  fail(reason) { if (this.status === 'running') { this.status = 'fail'; this.reason = reason; this.sim.events.push({ type: 'testFail', reason }); } }\n  pass() { if (this.status === 'running') { this.status = 'pass'; this.sim.events.push({ type: 'testPass', time: this.total }); } }\n  get total() { return this.time + this.penalty; }\n  step(dt) {\n    if (this.status !== 'running') return;\n    const sim = this.sim, tr = sim.tr, e = sim.cars[0], c = e.c, test = this.test;\n    let ds = c.loc.s - this.lastS; if (ds > tr.length / 2) ds -= tr.length; else if (ds < -tr.length / 2) ds += tr.length;\n    this.travelled += ds; this.lastS = c.loc.s;\n    if (!this.running) {\n      if (test.kind === 'lap') { if (this.travelled >= this.lineAt) { this.running = true; this.lapFrom = this.travelled; } }\n      else if (Math.hypot(c.vx, c.vz) > 0.5) this.running = true;\n    }\n    if (this.running) this.time += dt;\n    // Limits\n    if (!c.onTrack) { this.offT += dt; if (this.offT > 0.6 && !test.allowOff) return this.fail('OFF THE ROAD'); } else this.offT = 0;\n    if (test.noMargin && c.wallHits > 0) return this.fail('THE WALL WAS TOUCHED');\n    if (e.recoveries > 0) return this.fail('RECOVERY ENDS THE ATTEMPT');\n    if (this.time > this.timeLimit) return this.fail('THE EXAMINER HAS GONE HOME');\n    if (e.wrongWay) return this.fail('THAT IS THE WRONG WAY');\n    if (test.kind === 'stop') {\n      const v = Math.hypot(c.vx, c.vz);\n      if (this.travelled > this.boxTo + 4) return this.fail('PAST THE BOX');\n      if (this.running && v < 0.25 && this.travelled > 5) { if (this.travelled >= this.boxFrom - 1 && this.travelled <= this.boxTo + 1) return this.pass(); return this.fail('STOPPED OUTSIDE THE BOX'); }\n    } else if (test.kind === 'lap') {\n      if (this.running && this.travelled - this.lapFrom >= tr.length) return this.pass();\n    } else {\n      if (test.cones) for (const k of this.cones) {\n        if (!k.hit && Math.hypot(c.x - k.x, c.z - k.z) < 1.5) { k.hit = true; k.tumble = 1; this.penalty += 1; this.coneHits++; sim.events.push({ type: 'cone', hit: true }); }\n        if (!k.passed && this.travelled >= k.rel) { k.passed = true; if (!k.hit && Math.sign(c.loc.t) !== k.side) { this.penalty += 1; k.missed = true; this.coneHits++; sim.events.push({ type: 'cone', hit: false }); } }\n      }\n      if (this.travelled >= this.distance) return this.pass();\n    }\n  }\n}\nfunction wrapRel(tr, s) { return wrapS(tr, s); }\n// The examiner's brain. Pure pursuit from aiDrive, with a stop or a weave on top. Used by Demonstration and by medals.mjs.\nexport class DemoBrain {\n  constructor(test, sim, judge, { skill = 0.97 } = {}) { this.test = test; this.sim = sim; this.judge = judge; this.skill = skill; const e = sim.cars[0]; this.speeds = e.speeds; this.decel = Math.min(1.25, (e.p.brakeG ?? 1.25)) * 9.81 * e.p.tyreMu * 0.78; }\n  input() {\n    const sim = this.sim, e = sim.cars[0], c = e.c, tr = sim.tr, line = sim.line, j = this.judge, test = this.test, u = Math.hypot(c.vx, c.vz);\n    let lane = 0, speeds = this.speeds;\n    if (test.cones) {\n      const k = j.cones.find((x) => !x.passed);\n      if (k) lane = k.side * 3.1 - line.off[c.loc.i]; else lane = -line.off[c.loc.i];\n    } else if (test.kind === 'stop') lane = -line.off[c.loc.i];\n    const inp = aiDrive(c, tr, line, speeds, { skill: this.skill, lane, tcs: 0.7, asm: 0.6 });\n    if (test.kind === 'stop') {\n      const target = (j.boxFrom + j.boxTo) / 2, d = target - j.travelled, vStop = Math.sqrt(Math.max(0, 2 * this.decel * Math.max(0, d)));\n      if (u > vStop + 0.3 || d < 0.5) { inp.throttle = 0; inp.brake = 1; } else if (u > vStop - 2) { inp.throttle = 0; inp.brake = 0.5; } else { inp.throttle = 1; inp.brake = 0; }\n    } else if (test.cones) { const limit = 62 / 3.6; if (u > limit) { inp.throttle = 0; inp.brake = 0.4; } else { inp.throttle = 1; inp.brake = 0; } }\n    return inp;\n  }\n}\nexport function runHeadless(test, { skill = 0.97, steps = 60 * 400 } = {}) { // a whole attempt in Node: returns the demonstration's time\n  let total = 0, status = 'pass', reason = '';\n  for (let leg = 0; leg < legCount(test); leg++) {\n    const sim = new RaceSim({ ...testSetup(test, leg), record: false, seed: 1 }), judge = new Judge(test, sim), brain = new DemoBrain(test, sim, judge, { skill });\n    sim.cars[0].player = null; sim.cars[0].autoDrive = true;\n    sim.aiInput = () => brain.input();\n    for (let i = 0; i < steps && judge.status === 'running'; i++) { sim.step([]); sim.drainEvents(); judge.step(1 / 60); }\n    if (judge.status !== 'pass') { status = 'fail'; reason = `${legCar(test, leg)}: ${judge.reason || 'ran out of time'} at ${judge.travelled.toFixed(0)} m`; break; }\n    total += judge.total;\n  }\n  return { time: total, status, reason };\n}\nvoid indexOfS; void fullInstall;\nEOF\ncat > tools/medals.mjs <<'EOF'\n// node tools/medals.mjs: runs each licence test's AI demonstration at 97% pace, and freezes the medal times.\n// gold = T x 1.03, silver = T x 1.09, bronze = T x 1.18.\nimport { writeFileSync } from 'node:fs';\nimport { TESTS, TEST_IDS } from '../src/game/data/licences.js';\nimport { runHeadless } from '../src/game/sim/licence.js';\nconst out = {}; const lines = [];\nfor (const id of TEST_IDS) {\n  const r = runHeadless(TESTS[id]);\n  if (r.status !== 'pass') { console.log(`${id}: demonstration FAILED: ${r.reason}`); process.exitCode = 1; continue; }\n  const T = r.time, f = (x) => Math.round(T * x * 100) / 100;\n  out[id] = { demo: Math.round(T * 100) / 100, gold: f(1.03), silver: f(1.09), bronze: f(1.18) };\n  lines.push(`  '${id}': ${JSON.stringify(out[id])},`);\n  console.log(id, T.toFixed(2));\n}\nif (!process.exitCode) writeFileSync(new URL('../src/game/data/medals.js', import.meta.url), `// Written by tools/medals.mjs from the AI demonstrations (gold T x 1.03, silver x 1.09, bronze x 1.18). Frozen here.\\nexport const MEDALS = {\\n${lines.join('\\n')}\\n};\\n`);\nEOF\nnode tools/medals.mjs 2>&1 | tail -20","description":"Write tuning, career, replay, race and licence modules, run medals tool","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19874,"cache_read_input_tokens":196721,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19874},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"27aaea62-7f97-44eb-98e1-d18eb389f03c","timestamp":"2026-11-06T00:33:41.685Z","request_id":"req_011CgkjBhJq2q8y8QXBZcg1f","wire_tool_inputs":{"toolu_01D1rUYrVjygtFum4vgb6Gmw":{"command":"cat > src/game/sim/tuning.js <<'EOF'\n// tunedParams(carId, install): a car's physics row, with the player's parts applied, ready for stepCar.\nimport { carParams } from './sim.js';\nimport { PHYSICS } from '../data/cars.js';\nimport { TYRES } from '../data/tyres.js';\nimport { PARTS, SETUP_SLIDERS } from '../data/parts.js';\n\nexport const emptyInstall = () => ({ owned: [], on: {}, tyre: null, tyres: [], paint: null, rims: 0, setup: {} });\nexport const hasPart = (install, id) => {\n  if (!install) return false;\n  const g = PARTS[id]?.group;\n  return g ? install.on?.[g] === id : (install.owned ?? []).includes(id);\n};\nexport function fullInstall(parts = [], tyre = null) { // an install from a plain list, for AI tunes and tests\n  const inst = emptyInstall();\n  for (const id of parts) { inst.owned.push(id); const g = PARTS[id]?.group; if (g) inst.on[g] = id; }\n  if (tyre) { inst.tyre = tyre; inst.tyres.push(tyre); }\n  return inst;\n}\nexport function setupValue(install, id) {\n  const def = SETUP_SLIDERS.find((s) => s.id === id);\n  return install?.setup?.[id] ?? def.def;\n}\nexport const sliderAvailable = (install, slider) => slider.needs.some((id) => hasPart(install, id));\nexport function tunedRow(carId, install) {\n  const base = PHYSICS[carId], d = { ...base, tyreTable: { ...(base.tyreTable ?? {}) } };\n  d.cgH = base.cgH ?? 0.5;\n  if (!install) return d;\n  const has = (id) => hasPart(install, id);\n  let power = 1;\n  if (has('exhaust')) { power *= 1.04; d.sportExhaust = true; }\n  if (has('intake')) power *= 1.06;\n  const stage = has('stage3') ? 3 : has('stage2') ? 2 : has('stage1') ? 1 : 0;\n  if (stage) { power *= [1, 1.1, 1.2, 1.35][stage]; d.rpmPeak += [0, 0, 200, 400][stage]; d.redline += [0, 0, 200, 500][stage]; d.upshift += [0, 0, 200, 500][stage]; }\n  const turbo = has('turbo2') ? 2 : has('turbo1') ? 1 : 0;\n  if (turbo) {\n    if (base.turbo) power *= [1, 1.15, 1.35][turbo];\n    else { power *= [1, 1.25, 1.5][turbo]; d.turbo = true; d.turboLag = 0.8; }\n  }\n  d.powerPS = base.powerPS * power;\n  const weight = has('weight3') ? 3 : has('weight2') ? 2 : has('weight1') ? 1 : 0;\n  if (weight) { d.massKg = base.massKg * [1, 0.95, 0.9, 0.85][weight]; d.cgH *= [1, 0.99, 0.98, 0.96][weight]; }\n  if (has('clutch')) d.shiftTime = 0.11;\n  if (has('gearbox')) { d.shiftTime = 0.08; d.final = base.final * setupValue(install, 'gearing'); }\n  if (has('lsd')) d.lsd = setupValue(install, 'lsd');\n  if (has('suspSport')) { d.loadK = 0.085; d.cgH *= 0.96; d.rollF = setupValue(install, 'balance'); }\n  if (has('suspRace')) { d.loadK = 0.07; d.cgH *= 0.92 * setupValue(install, 'ride'); d.rollF = setupValue(install, 'balance'); d.lowRide = setupValue(install, 'ride') < 0.94; }\n  if (has('brakeSport')) d.brakeG = (base.brakeG ?? 1.25) + 0.15;\n  if (has('brakeRace')) { d.brakeG = (base.brakeG ?? 1.25) + 0.4; d.brakeF = setupValue(install, 'brakeF'); }\n  const baseCl = base.clA ?? 0.1, baseCd = base.cdA ?? 0.7;\n  if (has('aeroStreet')) { d.clA = baseCl + 0.15; d.cdA = baseCd + 0.02; }\n  if (has('aeroWing')) { d.clA = (baseCl + 0.5) * setupValue(install, 'downforce'); d.cdA = baseCd + 0.06; }\n  if (install.tyre) { const t = TYRES[install.tyre]; d.tyreMu = t.tyreMu; d.alphaP = t.alphaP; d.wearX = t.wearX; d.tyreTable = { dirt: t.dirt, gravel: t.dirt }; }\n  return d;\n}\nexport const tunedParams = (carId, install) => carParams(tunedRow(carId, install));\n\n// Oil: fresh gives +2% for 100 km, then level until 200 km; each 40 km after that takes 0.5%, down to -8%.\nexport function oilFactor(km, changed = false) {\n  if (changed && km < 100) return 1.02;\n  if (km <= 200) return 1;\n  return Math.max(0.92, 1 - 0.005 * Math.floor((km - 200) / 40));\n}\n// Numbers a card may show (at most six).\nexport function specOf(carId, install) {\n  const d = tunedRow(carId, install);\n  return { ps: Math.round(d.powerPS), kg: Math.round(d.massKg), layout: d.layout, turbo: !!d.turbo, tyreMu: d.tyreMu ?? 1, clA: d.clA ?? 0.1, brakeG: d.brakeG ?? 1.25, shift: d.shiftTime ?? 0.16, redline: d.redline, rpmPeak: d.rpmPeak };\n}\n// The power curve for the dyno: { rpm, ps } points.\nexport function dynoCurve(carId, install, steps = 40) {\n  const p = tunedParams(carId, install), pts = [];\n  for (let i = 0; i <= steps; i++) {\n    const rpm = 1500 + ((p.redline - 1500) * i) / steps, x = rpm / p.rpmPeak, low = p.turbo ? 0.5 : 0.62, rise = Math.min(1, low + (1 - low) * Math.min(1, x / 0.7)), fall = x <= 1 ? 1 - 0.14 * Math.max(0, (x - 0.7) / 0.3) : 0.86 - 0.9 * (x - 1), shape = Math.max(0.05, rise * fall), tq = p.Tpeak * shape;\n    pts.push({ rpm, ps: (tq * (rpm * 2 * Math.PI / 60)) / 735.5 });\n  }\n  return pts;\n}\nEOF\ncat > src/game/sim/career.js <<'EOF'\n// The career's rules, as pure functions over a plain profile. No engine, no DOM, no storage.\nimport { SAVE_VERSION, START_CREDITS } from '../data/meta.js';\nimport { CAR_INFO, DRIVER_NAMES, PHYSICS } from '../data/cars.js';\nimport { AI_TUNES, EVENTS, EVENT_IDS, POINTS, PRIZE_RATIO } from '../data/events.js';\nimport { LICENCES, TESTS } from '../data/licences.js';\nimport { PARTS, PAINT_PRICE, RIM_PRICE, SETUP_SLIDERS } from '../data/parts.js';\nimport { TYRES } from '../data/tyres.js';\nimport { emptyInstall, fullInstall, hasPart, oilFactor, specOf, tunedRow } from './tuning.js';\n\nexport const OIL_PRICE = 250, WASH_PRICE = 50, SELL_RATIO = 0.5;\nexport function newProfile() {\n  return { version: SAVE_VERSION, credits: START_CREDITS, day: 1, licences: {}, tests: {}, cars: [], current: null, nextUid: 1, events: {}, trophies: [], stats: { km: 0, wins: 0, gold: 0, races: 0, lapsLed: 0 }, seen: {}, records: {}, ghosts: {}, replays: [null, null, null], greeted: false, ended: false };\n}\n// Migrations: every old version steps up to the next.\nexport function migrate(raw) {\n  if (!raw || typeof raw !== 'object') return newProfile();\n  const p = { ...raw };\n  p.version = p.version ?? 1;\n  if (p.version < 2) { // version 1 kept one current car id and no ghosts or replay slots\n    p.ghosts = p.ghosts ?? {}; p.replays = p.replays ?? [null, null, null]; p.seen = p.seen ?? {};\n    for (const c of p.cars ?? []) { c.install = { ...emptyInstall(), ...(c.install ?? {}) }; c.dirt = c.dirt ?? 0; c.oilChanged = c.oilChanged ?? false; }\n    p.version = 2;\n  }\n  return p;\n}\nexport const carEntry = (profile, uid = profile.current) => profile.cars.find((c) => c.uid === uid) ?? null;\nexport function addCar(profile, carId, { prize = false, paint = null } = {}) {\n  const car = { uid: profile.nextUid++, carId, install: emptyInstall(), km: 0, kmOil: 0, oilChanged: false, dirt: 0, prize, wash: 0 };\n  car.install.paint = paint ?? CAR_INFO[carId].paint;\n  profile.cars.push(car); profile.seen[carId] = true;\n  if (profile.current === null) profile.current = car.uid;\n  return car;\n}\nexport function carPriceOpen(profile, carId) {\n  const i = CAR_INFO[carId];\n  if (!i.price) return false;\n  if (i.after && !profile.licences[i.after]) return false;\n  return true;\n}\nexport function buyCar(profile, carId) {\n  const i = CAR_INFO[carId];\n  if (!carPriceOpen(profile, carId)) return { ok: false, why: i.after ? 'licence' : 'prize' };\n  if (profile.credits < i.price) return { ok: false, why: 'money' };\n  profile.credits -= i.price;\n  const car = addCar(profile, carId, { paint: i.paint });\n  profile.current = car.uid;\n  return { ok: true, car };\n}\nexport const sellValue = (car) => Math.round((CAR_INFO[car.carId].price || 0) * SELL_RATIO);\nexport function sellCar(profile, uid) {\n  const car = carEntry(profile, uid);\n  if (!car) return { ok: false, why: 'none' };\n  if (car.prize) return { ok: false, why: 'prize' };\n  if (profile.cars.length <= 1) return { ok: false, why: 'last' };\n  profile.credits += sellValue(car);\n  profile.cars = profile.cars.filter((c) => c.uid !== uid);\n  if (profile.current === uid) profile.current = profile.cars[0].uid;\n  return { ok: true };\n}\nexport function setCurrent(profile, uid) { if (carEntry(profile, uid)) profile.current = uid; }\n\n// ---- Tuning Street ----\nexport function partState(car, partId) {\n  const owned = car.install.owned.includes(partId);\n  return { owned, on: hasPart(car.install, partId) };\n}\nexport function buyPart(profile, car, partId) {\n  const part = PARTS[partId];\n  if (!part) return { ok: false, why: 'none' };\n  if (car.install.owned.includes(partId)) {\n    if (!part.group) return { ok: false, why: 'owned' };\n    car.install.on[part.group] = car.install.on[part.group] === partId ? null : partId; // owned: a free swap, or back to stock\n    return { ok: true, swapped: true };\n  }\n  if (profile.credits < part.price) return { ok: false, why: 'money' };\n  profile.credits -= part.price;\n  car.install.owned.push(partId);\n  if (part.group) car.install.on[part.group] = partId;\n  return { ok: true };\n}\nexport function buyTyre(profile, car, tyreId) {\n  const t = TYRES[tyreId];\n  if (!t) return { ok: false, why: 'none' };\n  if (car.install.tyres.includes(tyreId)) { car.install.tyre = car.install.tyre === tyreId ? null : tyreId; return { ok: true, swapped: true }; }\n  if (profile.credits < t.price) return { ok: false, why: 'money' };\n  profile.credits -= t.price;\n  car.install.tyres.push(tyreId); car.install.tyre = tyreId;\n  return { ok: true };\n}\nexport function buyPaint(profile, car, colour) {\n  if (car.install.paint === colour) return { ok: false, why: 'owned' };\n  if (profile.credits < PAINT_PRICE) return { ok: false, why: 'money' };\n  profile.credits -= PAINT_PRICE; car.install.paint = colour;\n  return { ok: true };\n}\nexport function buyRims(profile, car, style) {\n  if (car.install.rims === style) return { ok: false, why: 'owned' };\n  if (profile.credits < RIM_PRICE) return { ok: false, why: 'money' };\n  profile.credits -= RIM_PRICE; car.install.rims = style;\n  return { ok: true };\n}\nexport function setSetup(car, id, value) {\n  const s = SETUP_SLIDERS.find((x) => x.id === id);\n  car.install.setup[id] = Math.max(s.min, Math.min(s.max, Math.round(value / s.step) * s.step));\n}\n// ---- Service Bay ----\nexport const oilOf = (car) => oilFactor(car.kmOil, car.oilChanged);\nexport function changeOil(profile, car) {\n  if (profile.credits < OIL_PRICE) return { ok: false, why: 'money' };\n  profile.credits -= OIL_PRICE; car.kmOil = 0; car.oilChanged = true;\n  return { ok: true };\n}\nexport function washCar(profile, car) {\n  if (profile.credits < WASH_PRICE) return { ok: false, why: 'money' };\n  profile.credits -= WASH_PRICE; car.dirt = 0; car.wash = (car.wash ?? 0) + 1;\n  return { ok: true };\n}\nexport function driveCar(profile, car, metres, dirtMetres = 0) {\n  const km = metres / 1000;\n  car.km += km; car.kmOil += km; profile.stats.km += km;\n  car.dirt = Math.min(1, car.dirt + (dirtMetres / 1000) * 0.2);\n}\n// ---- Licences ----\nexport const MEDAL_RANK = { gold: 3, silver: 2, bronze: 1 };\nexport function medalFor(test, time) {\n  const m = test.medals;\n  if (!m) return null;\n  return time <= m.gold ? 'gold' : time <= m.silver ? 'silver' : time <= m.bronze ? 'bronze' : null;\n}\nexport function licenceOpen(profile, licId) { const l = LICENCES[licId]; return !l.needs || !!profile.licences[l.needs]; }\nexport function testRecord(profile, id) { return (profile.tests[id] ??= { medal: null, best: null, fails: 0 }); }\nexport function recordFailure(profile, id) { const r = testRecord(profile, id); r.fails++; return r.fails; }\n// A finished attempt. Returns what changed: { medal, improved, licenceWon, allGold, reward }.\nexport function recordTest(profile, id, time) {\n  const test = TESTS[id], rec = testRecord(profile, id), medal = medalFor(test, time), out = { medal, improved: false, licenceWon: false, allGold: false, reward: 0 };\n  if (rec.best === null || time < rec.best) rec.best = time;\n  if (!medal) { rec.fails++; return out; }\n  rec.fails = 0;\n  if ((MEDAL_RANK[medal] ?? 0) > (MEDAL_RANK[rec.medal] ?? 0)) {\n    if (medal === 'gold') profile.stats.gold++;\n    rec.medal = medal; out.improved = true;\n  }\n  const lic = LICENCES[test.licence], medals = lic.tests.map((t) => profile.tests[t]?.medal);\n  if (!profile.licences[lic.id] && medals.every(Boolean)) {\n    profile.licences[lic.id] = true; profile.credits += lic.reward; out.licenceWon = true; out.reward = lic.reward;\n    profile.trophies.push({ kind: 'licence', id: lic.id });\n  }\n  const goldKey = `gold${lic.id}`;\n  if (medals.every((m) => m === 'gold') && !profile[goldKey]) {\n    profile[goldKey] = true; out.allGold = true;\n    if (lic.allGold.car) { const c = addCar(profile, lic.allGold.car, { prize: true }); out.prizeCar = c.carId; }\n    if (lic.allGold.credits) { profile.credits += lic.allGold.credits; out.reward += lic.allGold.credits; }\n    if (lic.allGold.helmet) profile.trophies.push({ kind: 'helmet', id: lic.id });\n  }\n  return out;\n}\nexport const licenceTier = (profile) => (profile.licences.A ? 'A' : profile.licences.B ? 'B' : profile.licences.C ? 'C' : null);\n// ---- Events ----\nexport function eventState(profile, id) { return (profile.events[id] ??= { round: 0, points: {}, legs: 0, done: false, won: false, wins: 0 }); }\nexport function eventOpen(profile, id) {\n  const e = EVENTS[id], missing = e.needs.find((l) => !profile.licences[l]);\n  if (missing) return { ok: false, why: `NEEDS THE ${LICENCES[missing].name} LICENCE` };\n  if (e.needsAny && !e.needsAny.some((x) => profile.events[x]?.won)) return { ok: false, why: `WIN ${e.needsAny.map((x) => EVENTS[x].name).join(' OR ')} FIRST` };\n  return { ok: true };\n}\nexport function eligible(event, carId, install) {\n  const s = specOf(carId, install), l = event.limit ?? {};\n  if (l.maxPS && s.ps > l.maxPS) return { ok: false, why: `${s.ps} PS. THE LIMIT IS ${l.maxPS}` };\n  if (l.maxKg && s.kg > l.maxKg) return { ok: false, why: `${s.kg} KG. THE LIMIT IS ${l.maxKg}` };\n  if (l.layout && !l.layout.includes(s.layout)) return { ok: false, why: `THIS EVENT WANTS ${l.layout.join(' OR ')}` };\n  return { ok: true };\n}\n// The roster stays the same for all of an event's rounds. Skills rise from the front of the grid.\nexport function eventRoster(id) {\n  const e = EVENTS[id], out = [], n = e.field - 1;\n  let hash = 0; for (const ch of id) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;\n  for (let i = 0; i < n; i++) {\n    const pick = e.pool[(hash + i) % e.pool.length], [carId, tune] = Array.isArray(pick) ? pick : [pick, null];\n    out.push({ name: DRIVER_NAMES[(hash + i * 3) % DRIVER_NAMES.length], carId, tune, skill: n > 1 ? e.pace[0] + ((e.pace[1] - e.pace[0]) * i) / (n - 1) : e.pace[1] });\n  }\n  return out;\n}\nexport const aiInstall = (tune) => (tune ? fullInstall(AI_TUNES[tune].parts, AI_TUNES[tune].tyre) : null);\n// A rally round: one rival per leg, faster each leg.\nexport function rallyRival(id, round) {\n  const e = EVENTS[id], rivals = e.pool, pick = rivals[Math.min(round, rivals.length - 1)], t = e.rounds.length > 1 ? round / (e.rounds.length - 1) : 1;\n  return { name: DRIVER_NAMES[(5 + round * 3) % DRIVER_NAMES.length], carId: Array.isArray(pick) ? pick[0] : pick, tune: null, skill: e.pace[0] + (e.pace[1] - e.pace[0]) * t };\n}\n// One finished round. order: names from first to last, playerName among them. Returns what was paid.\nexport function recordRound(profile, id, order, playerName = 'YOU', mult = 1) {\n  const e = EVENTS[id], st = eventState(profile, id), pos = order.indexOf(playerName), prize = pos >= 0 && pos < PRIZE_RATIO.length ? Math.round(e.prize * PRIZE_RATIO[pos] * mult) : 0, out = { pos: pos + 1, prize, points: 0, seriesDone: false, seriesWon: false, bonus: 0, prizeCar: null, ending: false };\n  order.forEach((name, i) => { st.points[name] = (st.points[name] ?? 0) + (POINTS[i] ?? 0); });\n  out.points = POINTS[pos] ?? 0;\n  profile.credits += prize; profile.day++; profile.stats.races++;\n  if (pos === 0) { profile.stats.wins++; st.wins++; }\n  if (e.rally && pos === 0) st.legs++;\n  st.round++;\n  if (st.round >= e.rounds.length) {\n    out.seriesDone = true;\n    const mine = st.points[playerName] ?? 0, won = e.rally ? st.legs >= Math.ceil(e.rounds.length / 2) + (e.rounds.length % 2 ? 0 : 1) - 0 : Object.entries(st.points).every(([n, v]) => n === playerName || v <= mine);\n    out.seriesWon = won;\n    st.done = true;\n    if (won) {\n      const first = !st.won;\n      st.won = true;\n      if (first) {\n        profile.credits += Math.round(e.bonus * mult); out.bonus = Math.round(e.bonus * mult);\n        if (e.prizeCar) { const c = addCar(profile, e.prizeCar, { prize: true }); out.prizeCar = c.carId; }\n        profile.trophies.push({ kind: 'cup', id });\n        if (e.ending) { profile.ended = true; out.ending = true; }\n      }\n    }\n    st.round = 0; st.points = {}; st.legs = 0; // the event may be run again\n  }\n  return out;\n}\nexport const standingsOf = (profile, id) => Object.entries(eventState(profile, id).points).sort((a, b) => b[1] - a[1]);\n// Records: a lap time per track, kept per profile.\nexport function recordLap(profile, trackId, seconds, carId) {\n  const r = profile.records[trackId];\n  if (!r || seconds < r.lap) { profile.records[trackId] = { lap: seconds, carId, day: profile.day }; return true; }\n  return false;\n}\nexport function collectedShare(profile) {\n  const ids = new Set(profile.cars.map((c) => c.carId));\n  return Math.round((ids.size / Object.keys(CAR_INFO).length) * 100);\n}\n// What to try next: one line for the Map.\nexport function nudge(profile) {\n  if (!profile.cars.length) return { to: 'dealer', text: 'DEALER ROW HAS THREE USED CARS YOU CAN AFFORD.' };\n  if (!profile.licences.C) {\n    const next = LICENCES.C.tests.find((t) => !profile.tests[t]?.medal);\n    return { to: 'licence', text: `THE LICENCE CENTRE IS EXPECTING YOU. TEST ${next}.` };\n  }\n  const dawn = profile.events.dawn;\n  if (!dawn?.won && !dawn?.round) return { to: 'events', text: 'THE DAWN PATROL CUP IS OPEN. IT IS YOUR FIRST RACE.' };\n  const cur = EVENT_IDS.find((id) => profile.events[id]?.round > 0);\n  if (cur) return { to: 'events', text: `${EVENTS[cur].name}: ROUND ${profile.events[cur].round + 1} OF ${EVENTS[cur].rounds.length} AWAITS.` };\n  const car = carEntry(profile);\n  if (car && car.kmOil > 240) return { to: 'service', text: 'BENNO HAS BEEN ASKING ABOUT YOUR OIL.' };\n  if (!profile.licences.B) return { to: 'licence', text: 'THE CLUB LICENCE OPENS FOUR MORE EVENTS.' };\n  if (!profile.events.clay?.won) return { to: 'events', text: 'THE RED CLAY RALLY IS OPEN. THE PRIZE IS A CAR.' };\n  if (!profile.licences.A) return { to: 'licence', text: 'THE NATIONAL LICENCE IS THE LAST ONE.' };\n  if (!profile.events.h200?.won && !profile.events.touring?.won) return { to: 'events', text: 'THE TOURING TROPHY AND THE HARBOUR LIGHTS 200 ARE OPEN.' };\n  if (!profile.ended) return { to: 'events', text: 'THE HALCYON GRAND PRIX IS OPEN. THE PENINSULA IS CLOSED FOR IT.' };\n  return { to: 'garage', text: 'YOU MAY KEEP DRIVING. MOST PEOPLE DO.' };\n}\nEOF\ncat > src/game/sim/replaydata.js <<'EOF'\n// Replay recording: every car at 30 Hz into Float32Arrays. Playback interpolates; replays never re-simulate.\nexport const FIELDS = 12; // x y z yaw pitch roll steer rpm throttle gear flags u\nexport const F_BRAKE = 1, F_SLIDE = 2, F_AIR = 4, F_PIT = 8, F_LOCK = 16, F_HEAD = 32;\nexport class Recording {\n  constructor(meta) { this.meta = meta; this.hz = 30; this.frames = 0; this.cap = 1024; this.cars = meta.cars.map(() => new Float32Array(this.cap * FIELDS)); this.marks = []; }\n  add(i, vals) { // vals is an array of FIELDS numbers for car i at the current frame\n    this.cars[i].set(vals, this.frames * FIELDS);\n  }\n  push() { // call once all cars are in: moves to the next frame, growing if needed\n    this.frames++;\n    if (this.frames >= this.cap) { this.cap *= 2; this.cars = this.cars.map((a) => { const b = new Float32Array(this.cap * FIELDS); b.set(a); return b; }); }\n  }\n  get duration() { return this.frames / this.hz; }\n  // Interpolated pose of car i at time t, written into out.\n  sample(i, t, out) {\n    const a = this.cars[i], f = Math.max(0, Math.min(this.frames - 1.001, t * this.hz)), k = Math.floor(f), u = f - k, p = k * FIELDS, q = (k + 1) * FIELDS;\n    const L = (n) => a[p + n] + (a[q + n] - a[p + n]) * u;\n    let dy = a[q + 3] - a[p + 3]; while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI;\n    out.x = L(0); out.y = L(1); out.z = L(2); out.yaw = a[p + 3] + dy * u; out.pitch = L(4); out.roll = L(5); out.steer = L(6); out.rpm = L(7); out.throttle = L(8); out.gear = a[p + 9]; out.flags = a[p + 10]; out.u = L(11);\n    return out;\n  }\n  // 10 Hz, Int16 quantised, base64: what goes to storage.\n  compress() {\n    const step = 3, frames = Math.floor(this.frames / step), carN = this.cars.length, buf = new Int16Array(frames * carN * 9), scale = [10, 50, 10, 5000, 5000, 5000, 10000, 1, 100]; let o = 0;\n    for (let f = 0; f < frames; f++) for (let c = 0; c < carN; c++) {\n      const a = this.cars[c], p = f * step * FIELDS;\n      const y = a[p + 3];\n      const v = [a[p], a[p + 1], a[p + 2], Math.atan2(Math.sin(y), Math.cos(y)), a[p + 4], a[p + 5], a[p + 6], a[p + 7] / 2, a[p + 11]];\n      for (let n = 0; n < 9; n++) buf[o++] = Math.max(-32768, Math.min(32767, Math.round(v[n] * (n === 7 ? 1 : scale[n]))));\n    }\n    const bytes = new Uint8Array(buf.buffer); let s = ''; for (let i = 0; i < bytes.length; i += 8192) s += String.fromCharCode.apply(null, bytes.subarray(i, i + 8192));\n    return { meta: this.meta, frames, carN, data: btoa(s) };\n  }\n  static fromCompressed(z) {\n    const bin = atob(z.data), bytes = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    const buf = new Int16Array(bytes.buffer), r = new Recording(z.meta), step = 3, scale = [10, 50, 10, 5000, 5000, 5000, 10000, 1, 100];\n    r.cap = z.frames * step + 2; r.cars = z.meta.cars.map(() => new Float32Array(r.cap * FIELDS)); r.frames = (z.frames - 1) * step + 1;\n    let o = 0; const vals = [];\n    for (let f = 0; f < z.frames; f++) for (let c = 0; c < z.carN; c++) {\n      for (let n = 0; n < 9; n++) vals[n] = buf[o++] / scale[n];\n      const a = r.cars[c], p = f * step * FIELDS;\n      a[p] = vals[0]; a[p + 1] = vals[1]; a[p + 2] = vals[2]; a[p + 3] = vals[3]; a[p + 4] = vals[4]; a[p + 5] = vals[5]; a[p + 6] = vals[6]; a[p + 7] = vals[7] * 2; a[p + 8] = 1; a[p + 9] = 3; a[p + 10] = 0; a[p + 11] = vals[8];\n      if (f > 0) for (let k = 1; k < step; k++) { const u = k / step, b = (f - 1) * step * FIELDS, m = (((f - 1) * step) + k) * FIELDS; for (let n = 0; n < FIELDS; n++) { let d = a[p + n] - a[b + n]; if (n === 3) { while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; } a[m + n] = a[b + n] + d * u; } }\n    }\n    return r;\n  }\n}\n// A ghost is one car's lap: x, y, z, yaw at 10 Hz.\nexport class GhostTrace {\n  constructor() { this.hz = 10; this.pts = []; }\n  add(x, y, z, yaw) { this.pts.push(Math.round(x * 10), Math.round(y * 20), Math.round(z * 10), Math.round(Math.atan2(Math.sin(yaw), Math.cos(yaw)) * 5000)); }\n  get duration() { return this.pts.length / 4 / this.hz; }\n  toData(time, carId) { return { time, carId, pts: this.pts }; }\n}\nexport function ghostSample(data, t, out) {\n  const n = data.pts.length / 4, f = Math.max(0, Math.min(n - 1.001, t * 10)), k = Math.floor(f), u = f - k, p = data.pts, a = k * 4, b = a + 4;\n  out.x = (p[a] + (p[b] - p[a]) * u) / 10; out.y = (p[a + 1] + (p[b + 1] - p[a + 1]) * u) / 20; out.z = (p[a + 2] + (p[b + 2] - p[a + 2]) * u) / 10;\n  let dy = (p[b + 3] - p[a + 3]) / 5000; while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI;\n  out.yaw = p[a + 3] / 5000 + dy * u; out.done = t * 10 >= n - 1;\n  return out;\n}\nEOF\ncat > src/game/sim/race.js <<'EOF'\n// RaceSim: the field, laps, flags, starts, pit lane, slipstream, results, replay feed and events. Plain JS, no engine.\nimport { aiDrive, buildTrack, collideCars, G, newCar, racingLine, speedProfile, stepCar } from './sim.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { tunedParams } from './tuning.js';\nimport { F_AIR, F_BRAKE, F_HEAD, F_LOCK, F_PIT, F_SLIDE, FIELDS, GhostTrace, Recording } from './replaydata.js';\n\nexport const PIT_WIDTH = 8, PIT_SPEED = 60 / 3.6;\nconst lineCache = new Map(), profileCache = new Map();\nexport function loadTrack(id, { rain = false } = {}) {\n  const tr = buildTrack(TRACKS[id]);\n  tr.id = id; tr.name = TRACKS[id].name; tr.pit = TRACKS[id].pit ?? null;\n  if (rain) tr.muScale = 0.78;\n  if (!lineCache.has(id)) lineCache.set(id, racingLine(tr));\n  if (tr.pit) forPit(tr, (i) => { tr.wallR[i] = PIT_WIDTH + 2; });\n  return { tr, line: lineCache.get(id) };\n}\nexport const wrapS = (tr, s) => ((s % tr.length) + tr.length) % tr.length;\nconst rel = (tr, s) => { let d = wrapS(tr, s); if (d > tr.length / 2) d -= tr.length; return d; };\nfunction forPit(tr, fn) { for (let i = 0; i < tr.N; i++) { const d = rel(tr, i * tr.ds); if (d >= tr.pit.in && d <= tr.pit.out) fn(i, d); } }\nexport function trackPoint(tr, s, t, out = {}) {\n  const S = wrapS(tr, s), f = S / tr.ds, i = Math.floor(f) % tr.N, j = (i + 1) % tr.N, u = f - Math.floor(f), L = (a) => a[i] + (a[j] - a[i]) * u, tx = L(tr.tx), tz = L(tr.tz), bk = L(tr.bank);\n  out.x = L(tr.x) - tz * t; out.z = L(tr.z) + tx * t; out.y = L(tr.y) - t * Math.sin(bk); out.yaw = Math.atan2(tx, tz); out.i = i; out.tx = tx; out.tz = tz; out.width = L(tr.width); out.bank = bk; out.slope = tr.slope[i];\n  return out;\n}\nexport function indexOfS(tr, s) { return Math.round(wrapS(tr, s) / tr.ds) % tr.N; }\nfunction mulberry(seed) { let a = seed >>> 0; return () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nexport function carProfile(tr, line, p, carId, installKey) {\n  const key = `${tr.id}|${carId}|${installKey}|${tr.muScale}`;\n  let v = profileCache.get(key);\n  if (!v) { const surf = (tr.surface === 'dirt' ? (p.tyreTable?.dirt ?? 0.62) : 1) * tr.muScale; v = speedProfile(tr, line, p, surf); profileCache.set(key, v); }\n  return v;\n}\nexport const defaultEnv = () => ({ gripScale: 1, powerScale: 1, brakeScale: 1, aeroScale: 1, wearScale: 1, fuelScale: 1, wallLoss: 1, stability: 1, traction: 1, rubber: 0, slip: 0.65, aiPace: null, god: false, steerRate: 3 });\nconst BASE_WEAR = 0.0012, BASE_FUEL = 0.0018;\nexport class RaceSim {\n  // setup: { kind, track, laps, rain, start, startS, startSpeed, contact, wear, fuel, cars: [{ carId, install, oil, name, paint, skill, player, assists, seat }], seed, stagger }\n  constructor(setup) {\n    this.setup = setup; this.kind = setup.kind ?? 'race'; this.laps = setup.laps ?? 1; this.rng = mulberry(setup.seed ?? 1);\n    const { tr, line } = loadTrack(setup.track, { rain: setup.rain }); this.tr = tr; this.line = line;\n    this.contact = setup.contact !== false; this.wearMul = setup.wear ?? 1; this.fuelMul = setup.fuel ?? 1; this.env = setup.env ?? defaultEnv();\n    this.frame = 0; this.time = 0; this.greenAt = null; this.phase = 'grid'; this.lights = 0; this.lightT = 0; this.events = []; this.order = []; this.done = false; this.leaderFinishedAt = null; this.hold = !!setup.hold; this.subEnv = {}; this.flaggedAt = null; this.hourNow = setup.hour ?? TRACKS[setup.track].hour; this.cool = false;\n    this.cars = setup.cars.map((d, i) => this.makeEntry(d, i));\n    this.placeGrid();\n    this.players = this.cars.filter((e) => e.player !== null && e.player !== undefined);\n    this.order = this.cars.slice();\n    this.rec = setup.record === false ? null : new Recording({ track: setup.track, hour: this.hourNow, hourEnd: setup.hourEnd ?? null, rain: !!setup.rain, cars: this.cars.map((e) => ({ carId: e.carId, install: e.install, name: e.name, paint: e.paint, player: e.player ?? null })) });\n    this.recVals = new Array(FIELDS).fill(0);\n    this.updateOrder();\n  }\n  makeEntry(d, i) {\n    const p = tunedParams(d.carId, d.install), tr = this.tr, c = newCar(p, tr, 0, 0), installKey = d.install ? JSON.stringify(d.install) : '';\n    c.oil = d.oil ?? 1;\n    const e = { i, carId: d.carId, install: d.install ?? null, name: d.name ?? `CAR ${i + 1}`, paint: d.paint ?? null, player: d.player ?? null, seat: d.seat ?? null, c, p, installKey, speeds: carProfile(tr, this.line, p, d.carId, installKey), skill: d.skill ?? 0.9, assists: d.assists ?? null, lap: 0, lastS: 0, lapStart: null, lastLap: null, bestLap: null, finished: false, finishTime: null, retired: false, progress: 0, pit: null, noContact: 0, stopped: 0, recoveries: 0, walls: 0, topSpeed: 0, wrongWay: false, reverse: false, brakeHold: 0, dirt: 0, dirtM: 0, metres: 0, lapse: 0, lapseAt: 0.2 + 0.6 * this.rng(), phase: this.rng() * 6.28, slip: false, autoDrive: false, wantPit: false, pits: 0, startDelay: d.startDelay ?? 0, ownStart: null, splits: [], lastSurface: null, lastGear: 1, lastWalls: 0, lastAir: false, airT: 0, lockT: 0, onLapDirty: false, flagged: false, input: null, laneNow: 0 };\n    return e;\n  }\n  placeGrid() {\n    const s = this.setup, tr = this.tr, n = this.cars.length;\n    const place = (e, S, t, speed) => { const i = indexOfS(tr, S), pt = trackPoint(tr, S, t), c = e.c; c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.loc.i = i; c.loc.s = wrapS(tr, S); c.loc.t = t; c.vx = Math.sin(pt.yaw) * speed; c.vz = Math.cos(pt.yaw) * speed; c.u = speed; e.lastS = wrapS(tr, S); c.laneNow = t - this.line.off[i]; e.gridT = t; };\n    const kind = s.start ?? 'standing';\n    if (kind === 'rolling') {\n      this.phase = 'rolling';\n      this.cars.forEach((e, k) => place(e, -150 - Math.floor(k / 2) * 12, k % 2 ? 2.6 : -2.6, 80 / 3.6));\n    } else if (kind === 'flying') {\n      this.phase = 'green'; this.greenAt = 0;\n      const S = s.startS ?? -220;\n      this.cars.forEach((e, k) => { place(e, S - k * 12, 0, (s.startSpeed ?? 120) / 3.6); e.ownStart = 0; });\n    } else { // standing, and rally's stagger\n      this.phase = 'grid';\n      const S0 = s.startS ?? -12;\n      this.cars.forEach((e, k) => {\n        const row = Math.floor(k / 2), staggered = kind === 'stagger';\n        place(e, staggered ? S0 : S0 - row * 9, staggered ? 0 : k % 2 ? 2.6 : -2.6, 0);\n      });\n    }\n    this.updateProgressAll();\n  }\n  updateProgressAll() { for (const e of this.cars) e.progress = this.progressOf(e); }\n  progressOf(e) { return (e.lap - 1) * this.tr.length + (e.lap === 0 ? wrapS(this.tr, e.c.loc.s) : e.c.loc.s); }\n  go() { if (this.phase === 'grid') { this.hold = false; this.green(); } }\n  green() { this.phase = 'green'; this.greenAt = this.time; for (const e of this.cars) if (e.startDelay === 0) e.ownStart = this.time; this.events.push({ type: 'flag', kind: 'green' }); }\n  emit(type, car, extra) { this.events.push({ type, car: car?.i ?? -1, ...extra }); }\n  drainEvents() { const ev = this.events; this.events = []; return ev; }\n  envFor(e) {\n    const v = this.env, god = v.god && e.player !== null, se = this.subEnv;\n    se.gripScale = v.gripScale; se.powerScale = v.powerScale; se.brakeScale = v.brakeScale; se.aeroScale = v.aeroScale;\n    se.wearRate = god ? 0 : BASE_WEAR * this.wearMul * v.wearScale; se.fuelRate = god ? 0 : BASE_FUEL * this.fuelMul * v.fuelScale; se.wallLoss = god ? 0 : v.wallLoss;\n    return se;\n  }\n  aiInput(e, skillMul = 1) {\n    const c = e.c, tr = this.tr, u = Math.hypot(c.vx, c.vz);\n    let skill = (this.env.aiPace ?? e.skill) * skillMul;\n    if (e.lapse > 0) { skill -= 0.04; e.lapse -= 1 / 60; }\n    if (this.env.rubber > 0 && this.players.length) { const lead = this.players[0].progress - e.progress; skill += Math.max(-1, Math.min(1, lead / 150)) * this.env.rubber; }\n    let lane = Math.sin(e.phase + this.time * 0.3) * 0.6;\n    if (this.phase === 'rolling') { lane = (e.gridT ?? 0) - this.line.off[c.loc.i]; }\n    const field = this.contact && !e.finished ? this.cars : null;\n    const inp = aiDrive(c, tr, this.line, e.speeds, { skill, lane }, field);\n    if (this.phase === 'rolling') { const err = 88 / 3.6 - u; inp.throttle = err > 0 ? Math.min(1, err) : 0; inp.brake = err < -1 ? 0.3 : 0; }\n    if (tr.surface === 'dirt') inp.asm = (inp.asm ?? 0.6) * 0.5;\n    return inp;\n  }\n  driverInput(e, raw) {\n    // raw: { steer, throttle, brake, handbrake, up, down } from the input layer. Assists come from the profile.\n    const c = e.c, a = e.assists ?? {}, env = this.env, inp = e.input ?? (e.input = {});\n    let throttle = raw.throttle ?? 0, brake = raw.brake ?? 0;\n    const speed = c.u;\n    // Reverse: hold the brake at a standstill for 0.4 s. Any throttle returns to first.\n    if (e.reverse) { if (throttle > 0.05) { e.reverse = false; c.gear = 1; } else { throttle = brake; brake = 0; } }\n    else if (brake > 0.2 && throttle < 0.05 && Math.abs(speed) < 0.5) { e.brakeHold += 1 / 60; if (e.brakeHold > 0.4) { e.reverse = true; e.brakeHold = 0; c.gear = 1; } } else e.brakeHold = 0;\n    inp.steer = raw.steer ?? 0; inp.throttle = throttle; inp.brake = brake; inp.handbrake = !!raw.handbrake; inp.reverse = e.reverse;\n    inp.abs = a.abs !== false; inp.auto = a.auto !== false; inp.up = !!raw.up; inp.down = !!raw.down;\n    inp.tcs = Math.min(1, ((a.tcs ?? 5) / 10) * env.traction); inp.asm = Math.min(1, ((a.asm ?? 5) / 10) * env.stability * (this.tr.surface === 'dirt' ? 0.5 : 1)); inp.steerRate = env.steerRate;\n    if (this.phase === 'rolling') { if (c.u > 25) { inp.throttle = 0; if (c.u > 26) inp.brake = Math.max(inp.brake, 0.3); } }\n    if (this.phase === 'grid') { inp.throttle = 0; inp.brake = 1; inp.handbrake = false; inp.reverse = false; }\n    if (e.ownStart === null && this.phase !== 'rolling') { inp.throttle = 0; inp.brake = 1; }\n    return inp;\n  }\n  step(inputs = []) {\n    const dt = 1 / 60;\n    this.frame++; this.time += dt;\n    const setupStart = this.setup.start;\n    if (this.phase === 'grid' && !this.hold) {\n      this.lightT += dt;\n      const lit = Math.min(5, Math.floor(this.lightT / 0.6));\n      if (lit !== this.lights) { this.lights = lit; this.events.push({ type: 'flag', kind: 'lights', n: lit }); }\n      if (this.lightT > 3.4) this.green();\n    }\n    if (this.phase === 'rolling') {\n      const leader = this.cars.reduce((a, b) => (this.progressOf(a) > this.progressOf(b) ? a : b));\n      if (this.progressOf(leader) >= 0 && leader.lap >= 1) { this.green(); }\n    }\n    for (const e of this.cars) {\n      if (e.ownStart === null && this.phase === 'green' && this.time - this.greenAt >= e.startDelay) { e.ownStart = this.time; if (e.player !== null) this.events.push({ type: 'flag', kind: 'green', own: true }); }\n    }\n    this.slipstream();\n    for (const e of this.cars) {\n      const human = e.player !== null && !e.autoDrive && !e.finished && !e.retired;\n      if (e.pit) { e.inp = null; continue; }\n      if (human) e.inp = this.driverInput(e, inputs[e.player] ?? {});\n      else {\n        const held = (this.phase === 'grid') || (e.ownStart === null && this.phase !== 'rolling');\n        e.inp = held ? { steer: 0, throttle: 0, brake: 1, abs: true, auto: true, tcs: 0, asm: 0 } : this.aiInput(e, e.finished ? 0.82 : 1);\n        if (e.wantPit && e.c.loc.t < 0 && false) e.inp.steer += 0;\n      }\n    }\n    const contactCars = this.contact ? this.cars.filter((e) => !e.pit && e.noContact <= 0 && !e.ghost).map((e) => e.c) : null;\n    for (let sub = 0; sub < 4; sub++) {\n      for (const e of this.cars) {\n        if (e.pit) continue;\n        const inp = e.inp;\n        if (sub > 0 && inp.up) { inp.up = false; }\n        if (sub > 0 && inp.down) { inp.down = false; }\n        stepCar(e.c, inp, 1 / 240, this.tr, this.envFor(e));\n      }\n      if (contactCars) collideCars(contactCars);\n    }\n    for (const e of this.cars) this.post(e, dt);\n    if (this.setup.hourEnd !== undefined && this.setup.hourEnd !== null && this.laps > 0) {\n      const lead = Math.max(0, Math.max(...this.cars.map((e) => e.progress))) / (this.laps * this.tr.length);\n      this.hourNow = (this.setup.hour ?? 18.5) + (this.setup.hourEnd - (this.setup.hour ?? 18.5)) * Math.min(1, lead);\n    }\n    this.updateOrder();\n    this.checkFinish();\n    if (this.rec && this.frame % 2 === 0) this.record();\n    void setupStart;\n  }\n  slipstream() {\n    const tr = this.tr, slip = this.env.slip;\n    for (const e of this.cars) {\n      e.slip = false; e.c.dragScale = 1;\n      if (Math.abs(e.c.u) < 100 / 3.6 || e.pit) continue;\n      for (const b of this.cars) {\n        if (b === e || b.pit) continue;\n        let gap = (b.c.loc.s - e.c.loc.s + tr.length) % tr.length;\n        if (gap > 0.5 && gap < 25 && Math.abs(b.c.loc.t - e.c.loc.t) < 2) { e.c.dragScale = slip; e.slip = true; break; }\n      }\n    }\n  }\n  post(e, dt) {\n    const c = e.c, tr = this.tr;\n    if (e.pit) this.stepPit(e, dt);\n    if (e.noContact > 0) e.noContact -= dt;\n    // Lap count: s wraps from past 90% to under 10% going forward.\n    const s = c.loc.s, L = tr.length;\n    if (e.lastS > L * 0.9 && s < L * 0.1) this.crossLine(e);\n    else if (e.lastS < L * 0.1 && s > L * 0.9) { if (e.lap > 0) e.lap--; }\n    const moved = Math.min(5, Math.abs(wrapDelta(s, e.lastS, L)));\n    e.metres += moved;\n    if (c.surface === 'dirt' || c.surface === 'gravel') { e.dirtM += moved; e.dirt = Math.min(1, e.dirt + moved * 0.0002); }\n    e.lastS = s;\n    e.progress = this.progressOf(e);\n    e.topSpeed = Math.max(e.topSpeed, Math.abs(c.u));\n    const sp = Math.hypot(c.vx, c.vz);\n    // Wrong way\n    const dot = Math.sin(c.yaw) * tr.tx[c.loc.i] + Math.cos(c.yaw) * tr.tz[c.loc.i];\n    e.wrongWay = !e.pit && dot < 0 && sp > 5;\n    // Events\n    if (c.gear !== e.lastGear) { this.emit('shift', e, { up: c.gear > e.lastGear, gear: c.gear }); e.lastGear = c.gear; }\n    if (c.surface !== e.lastSurface) { if (c.surface === 'kerb' && sp > 8) this.emit('kerb', e); e.lastSurface = c.surface; }\n    if (c.wallHits !== e.lastWalls) { e.walls += c.wallHits - e.lastWalls; if (c.contact > 0.6) this.emit('wallHit', e, { v: c.contact }); e.lastWalls = c.wallHits; }\n    else if (c.touching) { if (c.contact > 0.6) this.emit('carHit', e, { v: c.contact }); }\n    c.touching = null; c.contact = 0;\n    if (c.locked) { e.lockT += dt; if (e.lockT > 0.08 && !e.lockedNow) { e.lockedNow = true; this.emit('lockup', e); } } else { e.lockT = 0; e.lockedNow = false; }\n    if (c.airborne !== e.lastAir) { if (e.lastAir && e.airT > 0.12) this.emit('land', e, { air: e.airT, v: Math.abs(c.vy) }); e.lastAir = c.airborne; e.airT = 0; }\n    if (c.airborne) e.airT += dt;\n    // Pit entry\n    if (tr.pit && !e.pit && !e.finished) {\n      const d = rel(tr, s);\n      if (d > tr.pit.in - 4 && d < tr.pit.in + 8) {\n        const human = e.player !== null && !e.autoDrive;\n        const inLane = human ? c.loc.t > tr.width[c.loc.i] / 2 - 1 : false;\n        if ((human && inLane && c.u > 1) || (!human && (e.wantPit || (this.setup.fuel ?? 1) > 0 && this.needsPit(e)))) this.enterPit(e);\n      }\n    }\n    // AI: wants a stop; and AI that stops gets itself back on the road.\n    const isAi = e.player === null || e.autoDrive;\n    if (isAi && !e.pit) {\n      if (this.needsPit(e)) e.wantPit = true;\n      if (sp < 1 && this.phase === 'green' && e.ownStart !== null) { e.stopped += dt; if (e.stopped > 3) this.recover(e.i); } else e.stopped = 0;\n      if (e.skill < 0.93 && e.lapse <= 0 && e.lapseAt >= 0) { const f = s / L; if (Math.abs(f - e.lapseAt) < 0.004 && !e.lapsedThisLap) { e.lapse = 2; e.lapsedThisLap = true; } }\n    }\n    // Splits: the time at each 20 m, for gap readouts between staggered cars.\n    if (e.ownStart !== null) { const k = Math.floor(Math.max(0, e.progress) / 20); if (k >= e.splits.length) { for (let n = e.splits.length; n <= k; n++) e.splits[n] = this.time - e.ownStart; } }\n  }\n  needsPit(e) { if (!e.p) return false; const mean = (e.c.wear[0] + e.c.wear[1] + e.c.wear[2] + e.c.wear[3]) / 4; return !!this.tr.pit && (mean < 0.3 || e.c.fuel < 0.12) && !e.finished && this.laps > 3; }\n  crossLine(e) {\n    e.lap++; e.lapsedThisLap = false;\n    const now = this.time;\n    if (e.lapStart !== null && !e.finished) {\n      const t = now - e.lapStart; e.lastLap = t; if (e.bestLap === null || t < e.bestLap) { e.bestLap = t; }\n      this.emit('lap', e, { time: t, lap: e.lap });\n    } else if (e.lap === 1) this.emit('lap', e, { time: null, lap: 1 });\n    e.lapStart = now;\n    if (!e.finished && this.laps > 0 && e.lap > this.laps && this.phase !== 'rolling') {\n      e.finished = true; e.finishTime = e.ownStart !== null ? now - e.ownStart : now;\n      this.emit('flag', e, { kind: 'finish', own: e.player !== null });\n      if (this.leaderFinishedAt === null) this.leaderFinishedAt = now;\n      if (e.player !== null) e.autoDrive = true;\n    } else if (!e.finished && this.laps > 0 && e.lap === this.laps && e.player !== null) this.emit('flag', e, { kind: 'finalLap' });\n  }\n  enterPit(e) {\n    const c = e.c, tr = this.tr, halfW = tr.width[c.loc.i] / 2;\n    e.pit = { phase: 'in', s: rel(tr, c.loc.s), t: c.loc.t, speed: Math.min(Math.abs(c.u), 45), box: tr.pit.box + (e.i - this.cars.length / 2) * 12, laneT: halfW + 3.6, boxT: halfW + 5.6, svc: 0, tyres: 0, fuel: 0, skipTyres: false, startedAt: this.time };\n    c.inPit = true; e.wantPit = false; e.pits++; c.dragScale = 1;\n    this.emit('pitIn', e);\n  }\n  stepPit(e, dt) {\n    const c = e.c, tr = this.tr, P = e.pit, A = 14;\n    if (P.phase === 'in') {\n      const dist = P.box - P.s, stopV = Math.sqrt(Math.max(0, 2 * 7 * dist));\n      const want = Math.min(PIT_SPEED, stopV);\n      P.speed = P.speed > want ? Math.max(want, P.speed - A * dt) : Math.min(want, P.speed + 8 * dt);\n      P.s += P.speed * dt;\n      P.t += (P.laneT - P.t) * Math.min(1, dt * 1.8);\n      if (dist < 28) P.t += (P.boxT - P.t) * Math.min(1, dt * 2.2);\n      if (dist < 0.3 || (P.speed < 0.3 && dist < 3)) {\n        P.phase = 'box'; P.speed = 0;\n        const mean = (c.wear[0] + c.wear[1] + c.wear[2] + c.wear[3]) / 4;\n        P.tyres = mean < 0.7 ? 4 : 0;\n        P.fuel = (1 - c.fuel) * 100 * 0.1;\n        P.total = Math.max(P.tyres, P.fuel);\n        this.emit('pitBox', e, { tyres: P.tyres > 0, fuel: P.fuel });\n      }\n    } else if (P.phase === 'box') {\n      P.svc += dt;\n      if (P.fuel > 0) c.fuel = Math.min(1, c.fuel + (dt / 0.1) / 100);\n      if (P.skipTyres) P.tyres = 0;\n      if (P.svc >= Math.max(P.tyres, P.fuel)) {\n        if (P.tyres > 0) { c.wear[0] = c.wear[1] = c.wear[2] = c.wear[3] = 1; }\n        P.phase = 'out'; this.emit('pitGo', e, { time: P.svc });\n      }\n    } else if (P.phase === 'out') {\n      P.speed = Math.min(PIT_SPEED, P.speed + 9 * dt);\n      P.s += P.speed * dt;\n      const halfW = tr.width[c.loc.i] / 2, remain = tr.pit.out - P.s;\n      if (remain > 90) P.t += (P.laneT - P.t) * Math.min(1, dt * 1.5); else P.t += (halfW - 1.8 - P.t) * Math.min(1, dt * 0.9);\n      if (remain <= 0) {\n        const pt = trackPoint(tr, P.s, P.t); c.vx = Math.sin(pt.yaw) * P.speed; c.vz = Math.cos(pt.yaw) * P.speed; c.inPit = false; e.pit = null; e.noContact = 1.5; c.delta = 0; c.r = 0;\n        this.emit('pitOut', e);\n        return;\n      }\n    }\n    const pt = trackPoint(tr, P.s, P.t);\n    c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.vy = 0; c.vx = Math.sin(pt.yaw) * P.speed; c.vz = Math.cos(pt.yaw) * P.speed; c.u = P.speed; c.w = 0; c.r = 0; c.delta *= 0.9; c.ax = 0; c.ay = 0;\n    c.rpm = c.p.idle + P.speed * 120; c.gear = 1; c.sliding = false; c.locked = false; c.airborne = false; c.surface = 'apron';\n    c.loc.i = pt.i; c.loc.s = wrapS(tr, P.s); c.loc.t = P.t;\n  }\n  skipTyres(i) { const P = this.cars[i]?.pit; if (P && P.phase === 'box') P.skipTyres = true; }\n  recover(i) {\n    const e = this.cars[i], c = e.c, tr = this.tr, line = this.line;\n    if (e.pit) return false;\n    const k = c.loc.i, x = line.px[k], z = line.pz[k], yaw = Math.atan2(tr.tx[k], tr.tz[k]);\n    c.x = x; c.z = z; c.y = tr.y[k]; c.vy = 0; c.yaw = yaw; c.vx = 0; c.vz = 0; c.r = 0; c.delta = 0; c.gear = 1; c.ax = 0; c.ay = 0; c.shift = 0; c.loc.t = line.off[k]; c.u = 0; c.w = 0; c.laneNow = 0;\n    e.noContact = 2; e.reverse = false; e.stopped = 0; e.recoveries++;\n    this.emit('recover', e);\n    return true;\n  }\n  retire(i) { const e = this.cars[i]; e.retired = true; e.autoDrive = true; e.finished = true; e.finishTime = null; }\n  updateOrder() {\n    const score = (e) => (e.retired ? -1e9 : e.finished && e.finishTime !== null ? 1e9 - e.finishTime : e.progress);\n    this.order = this.cars.slice().sort((a, b) => score(b) - score(a));\n    this.order.forEach((e, k) => { e.pos = k + 1; });\n  }\n  checkFinish() {\n    // After the leader flag, a player gets a while to finish; then they are flagged where they are.\n    if (this.leaderFinishedAt !== null && !this.done) {\n      const best = this.cars.reduce((a, e) => (e.bestLap && (!a || e.bestLap < a) ? e.bestLap : a), null) ?? 90;\n      if (this.time - this.leaderFinishedAt > Math.max(60, best * 1.25)) {\n        for (const e of this.cars) if (!e.finished && !e.flagged) { e.flagged = true; if (e.player !== null) { e.finished = true; e.finishTime = null; e.autoDrive = true; this.emit('flag', e, { kind: 'finish', own: true, flagged: true }); } }\n      }\n    }\n    if (!this.done && this.players.length && this.players.every((e) => e.finished)) { this.done = true; this.doneAt = this.time; }\n  }\n  // Times shown to the player: leader's time, gaps for the rest.\n  results() {\n    const rows = this.order.map((e) => ({ i: e.i, name: e.name, carId: e.carId, player: e.player, pos: e.pos, time: e.finishTime, finished: e.finished && !e.retired && e.finishTime !== null, retired: e.retired, best: e.bestLap, progress: e.progress }));\n    const leader = rows[0], lapLen = this.tr.length;\n    for (const r of rows) {\n      if (r === leader) { r.text = r.finished ? formatTime(r.time) : '--:--'; continue; }\n      if (r.finished) r.text = `+${(r.time - leader.time).toFixed(2)}`;\n      else if (r.retired) r.text = 'RETIRED';\n      else { const laps = Math.max(0, Math.floor((leader.progress - r.progress) / lapLen)); r.text = laps >= 1 ? `+${laps} LAP` : 'RUNNING'; }\n    }\n    return rows;\n  }\n  gapAhead(e) {\n    const k = this.order.indexOf(e); if (k <= 0) return null;\n    const a = this.order[k - 1], d = a.progress - e.progress, v = Math.max(8, Math.abs(e.c.u));\n    return d / v;\n  }\n  gapBehind(e) {\n    const k = this.order.indexOf(e); if (k < 0 || k >= this.order.length - 1) return null;\n    const b = this.order[k + 1], d = e.progress - b.progress, v = Math.max(8, Math.abs(b.c.u));\n    return d / v;\n  }\n  // Rally: how far ahead on the clock, comparing our time now to the rival's time at this same place.\n  clockGap(e, rival) {\n    if (e.ownStart === null || rival.ownStart === null) return null;\n    const k = Math.floor(Math.max(0, e.progress) / 20);\n    const theirs = rival.splits[k], mine = this.time - e.ownStart;\n    if (theirs !== undefined) return mine - theirs; // positive: we are behind\n    const k2 = Math.floor(Math.max(0, rival.progress) / 20), mineThere = e.splits[k2], theirNow = this.time - rival.ownStart;\n    return mineThere !== undefined ? mineThere - theirNow : null;\n  }\n  record() {\n    const v = this.recVals;\n    for (const e of this.cars) {\n      const c = e.c, inp = e.inp, br = inp ? inp.brake > 0.05 : e.pit?.phase === 'in';\n      v[0] = c.x; v[1] = c.y; v[2] = c.z; v[3] = c.yaw; v[4] = this.bodyPitch(e); v[5] = this.bodyRoll(e); v[6] = c.delta; v[7] = c.rpm; v[8] = inp ? inp.throttle : 0.2; v[9] = c.gear;\n      v[10] = (br ? F_BRAKE : 0) | (c.sliding ? F_SLIDE : 0) | (c.airborne ? F_AIR : 0) | (e.pit ? F_PIT : 0) | (c.locked ? F_LOCK : 0) | F_HEAD; v[11] = c.u;\n      this.rec.add(e.i, v);\n    }\n    this.rec.push();\n  }\n  bodyPitch(e) { const c = e.c, tr = this.tr; return -c.ax * 0.004 - Math.atan(tr.slope[c.loc.i] * Math.sign(c.u || 1)) * (Math.cos(c.yaw - Math.atan2(tr.tx[c.loc.i], tr.tz[c.loc.i])) > 0 ? 1 : -1); }\n  bodyRoll(e) { const c = e.c, tr = this.tr; return c.ay * 0.008 + tr.bank[c.loc.i]; }\n  fingerprint() {\n    let h = 2166136261 >>> 0;\n    const mix = (v) => { h ^= v | 0; h = Math.imul(h, 16777619) >>> 0; };\n    for (const e of this.cars) { mix(Math.round(e.c.x * 100)); mix(Math.round(e.c.z * 100)); mix(e.lap); mix(Math.round(e.c.wear[0] * 10000)); mix(Math.round(e.c.fuel * 10000)); }\n    return h.toString(16);\n  }\n  // Dev mode's save state: the sim as JSON, without its references.\n  saveState() {\n    return JSON.stringify({ time: this.time, frame: this.frame, phase: this.phase, greenAt: this.greenAt, cars: this.cars.map((e) => { const { p, touching, ...c } = e.c; return { c, lap: e.lap, lastS: e.lastS, lapStart: e.lapStart, bestLap: e.bestLap, lastLap: e.lastLap, finished: e.finished, finishTime: e.finishTime, ownStart: e.ownStart, autoDrive: e.autoDrive, pit: e.pit, metres: e.metres }; }), done: this.done, leaderFinishedAt: this.leaderFinishedAt });\n  }\n  loadState(json) {\n    const s = JSON.parse(json);\n    this.time = s.time; this.frame = s.frame; this.phase = s.phase; this.greenAt = s.greenAt; this.done = s.done; this.leaderFinishedAt = s.leaderFinishedAt;\n    s.cars.forEach((d, i) => { const e = this.cars[i]; Object.assign(e.c, d.c); e.lap = d.lap; e.lastS = d.lastS; e.lapStart = d.lapStart; e.bestLap = d.bestLap; e.lastLap = d.lastLap; e.finished = d.finished; e.finishTime = d.finishTime; e.ownStart = d.ownStart; e.autoDrive = d.autoDrive; e.pit = d.pit; e.metres = d.metres; e.progress = this.progressOf(e); });\n    this.updateOrder();\n  }\n  teleport(i, s) { const e = this.cars[i], tr = this.tr, c = e.c, pt = trackPoint(tr, s, 0); c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.loc.i = pt.i; c.loc.s = wrapS(tr, s); c.loc.t = 0; c.vx = 0; c.vz = 0; c.r = 0; c.delta = 0; c.vy = 0; e.lastS = c.loc.s; e.progress = this.progressOf(e); }\n  // Dev: finish now in position n (1-based).\n  finishNow(i, n = 1) {\n    const e = this.cars[i], others = this.cars.filter((x) => x !== e), base = this.time;\n    others.forEach((o, k) => { const ahead = k < n - 1; if (!o.finished) { o.finished = true; o.finishTime = base + (ahead ? -5 + k : 5 + k) - (o.ownStart ?? 0); } });\n    if (!e.finished) { e.finished = true; e.finishTime = base - (e.ownStart ?? 0); e.autoDrive = e.player !== null; }\n    this.leaderFinishedAt = this.leaderFinishedAt ?? base;\n    this.updateOrder(); this.checkFinish();\n    this.emit('flag', e, { kind: 'finish', own: true });\n  }\n}\nfunction wrapDelta(a, b, L) { let d = a - b; if (d > L / 2) d -= L; else if (d < -L / 2) d += L; return d; }\nexport function formatTime(t) {\n  if (t === null || t === undefined || !Number.isFinite(t)) return '--:--.-';\n  const m = Math.floor(t / 60), s = t - m * 60;\n  return `${m}:${s < 10 ? '0' : ''}${s.toFixed(2)}`;\n}\nexport { GhostTrace, G };\nEOF\ncat > src/game/sim/licence.js <<'EOF'\n// Licence tests: the setup for a test, the judge that watches an attempt, and the demonstration's brain.\nimport { aiDrive } from './sim.js';\nimport { indexOfS, RaceSim, trackPoint, wrapS } from './race.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { fullInstall } from './tuning.js';\n\nexport function placeS(tr, at) { return wrapS(tr, at.s !== undefined ? at.s : tr.cornerS[at.c] + (at.off ?? 0)); }\nexport const legCount = (test) => test.legs?.length ?? 1;\nexport const legCar = (test, leg) => test.legs?.[leg] ?? test.carId;\nexport function testSetup(test, leg = 0, assists = {}, player = 0) {\n  const carId = legCar(test, leg), dummy = new RaceSim({ track: test.track, cars: [], record: false }), tr = dummy.tr;\n  const startS = placeS(tr, test.start);\n  return {\n    kind: 'licence', track: test.track, laps: 0, hour: test.hour ?? TRACKS[test.track].hour, start: 'flying', startS, startSpeed: test.startSpeed ?? 0, contact: false,\n    wear: 0, fuel: 0, cars: [{ carId, install: null, name: 'YOU', paint: null, player, assists: { abs: true, tcs: 5, asm: 5, auto: true, ...assists, ...(test.assists ?? {}) } }],\n    test: test.id, leg,\n  };\n}\n// Watches one attempt. status: running, pass, fail. time counts per the plan's rules; penalties are added at the end.\nexport class Judge {\n  constructor(test, sim) {\n    this.test = test; this.sim = sim; const tr = sim.tr;\n    this.status = 'running'; this.reason = ''; this.time = 0; this.running = !test.standing && test.kind !== 'lap'; this.penalty = 0; this.offT = 0; this.startProgress = 0; this.lastRel = 0;\n    this.startS = placeS(tr, test.start);\n    this.distance = test.kind === 'lap' ? tr.length + wrapRel(tr, 0 - this.startS) : test.end ? wrapS(tr, placeS(tr, test.end) - this.startS) : 0;\n    if (test.kind === 'lap') this.lineAt = wrapS(tr, 0 - this.startS);\n    this.travelled = 0; this.lastS = sim.cars[0].c.loc.s;\n    if (test.box) { this.boxFrom = wrapS(tr, test.box.s - this.startS) - test.box.len / 2; this.boxTo = this.boxFrom + test.box.len; this.limit = this.boxTo + 40; }\n    if (test.cones) {\n      this.cones = [];\n      for (let k = 0; k < test.cones.count; k++) { const s = test.cones.from + k * test.cones.spacing, pt = trackPoint(tr, s, 0); this.cones.push({ s, rel: wrapS(tr, s - this.startS), x: pt.x, y: pt.y, z: pt.z, yaw: pt.yaw, side: k % 2 ? -1 : 1, hit: false, passed: false, tumble: 0 }); }\n    }\n    this.coneHits = 0;\n    this.timeLimit = (test.medals?.bronze ?? 120) * 2.2 + 15;\n  }\n  fail(reason) { if (this.status === 'running') { this.status = 'fail'; this.reason = reason; this.sim.events.push({ type: 'testFail', reason }); } }\n  pass() { if (this.status === 'running') { this.status = 'pass'; this.sim.events.push({ type: 'testPass', time: this.total }); } }\n  get total() { return this.time + this.penalty; }\n  step(dt) {\n    if (this.status !== 'running') return;\n    const sim = this.sim, tr = sim.tr, e = sim.cars[0], c = e.c, test = this.test;\n    let ds = c.loc.s - this.lastS; if (ds > tr.length / 2) ds -= tr.length; else if (ds < -tr.length / 2) ds += tr.length;\n    this.travelled += ds; this.lastS = c.loc.s;\n    if (!this.running) {\n      if (test.kind === 'lap') { if (this.travelled >= this.lineAt) { this.running = true; this.lapFrom = this.travelled; } }\n      else if (Math.hypot(c.vx, c.vz) > 0.5) this.running = true;\n    }\n    if (this.running) this.time += dt;\n    // Limits\n    if (!c.onTrack) { this.offT += dt; if (this.offT > 0.6 && !test.allowOff) return this.fail('OFF THE ROAD'); } else this.offT = 0;\n    if (test.noMargin && c.wallHits > 0) return this.fail('THE WALL WAS TOUCHED');\n    if (e.recoveries > 0) return this.fail('RECOVERY ENDS THE ATTEMPT');\n    if (this.time > this.timeLimit) return this.fail('THE EXAMINER HAS GONE HOME');\n    if (e.wrongWay) return this.fail('THAT IS THE WRONG WAY');\n    if (test.kind === 'stop') {\n      const v = Math.hypot(c.vx, c.vz);\n      if (this.travelled > this.boxTo + 4) return this.fail('PAST THE BOX');\n      if (this.running && v < 0.25 && this.travelled > 5) { if (this.travelled >= this.boxFrom - 1 && this.travelled <= this.boxTo + 1) return this.pass(); return this.fail('STOPPED OUTSIDE THE BOX'); }\n    } else if (test.kind === 'lap') {\n      if (this.running && this.travelled - this.lapFrom >= tr.length) return this.pass();\n    } else {\n      if (test.cones) for (const k of this.cones) {\n        if (!k.hit && Math.hypot(c.x - k.x, c.z - k.z) < 1.5) { k.hit = true; k.tumble = 1; this.penalty += 1; this.coneHits++; sim.events.push({ type: 'cone', hit: true }); }\n        if (!k.passed && this.travelled >= k.rel) { k.passed = true; if (!k.hit && Math.sign(c.loc.t) !== k.side) { this.penalty += 1; k.missed = true; this.coneHits++; sim.events.push({ type: 'cone', hit: false }); } }\n      }\n      if (this.travelled >= this.distance) return this.pass();\n    }\n  }\n}\nfunction wrapRel(tr, s) { return wrapS(tr, s); }\n// The examiner's brain. Pure pursuit from aiDrive, with a stop or a weave on top. Used by Demonstration and by medals.mjs.\nexport class DemoBrain {\n  constructor(test, sim, judge, { skill = 0.97 } = {}) { this.test = test; this.sim = sim; this.judge = judge; this.skill = skill; const e = sim.cars[0]; this.speeds = e.speeds; this.decel = Math.min(1.25, (e.p.brakeG ?? 1.25)) * 9.81 * e.p.tyreMu * 0.78; }\n  input() {\n    const sim = this.sim, e = sim.cars[0], c = e.c, tr = sim.tr, line = sim.line, j = this.judge, test = this.test, u = Math.hypot(c.vx, c.vz);\n    let lane = 0, speeds = this.speeds;\n    if (test.cones) {\n      const k = j.cones.find((x) => !x.passed);\n      if (k) lane = k.side * 3.1 - line.off[c.loc.i]; else lane = -line.off[c.loc.i];\n    } else if (test.kind === 'stop') lane = -line.off[c.loc.i];\n    const inp = aiDrive(c, tr, line, speeds, { skill: this.skill, lane, tcs: 0.7, asm: 0.6 });\n    if (test.kind === 'stop') {\n      const target = (j.boxFrom + j.boxTo) / 2, d = target - j.travelled, vStop = Math.sqrt(Math.max(0, 2 * this.decel * Math.max(0, d)));\n      if (u > vStop + 0.3 || d < 0.5) { inp.throttle = 0; inp.brake = 1; } else if (u > vStop - 2) { inp.throttle = 0; inp.brake = 0.5; } else { inp.throttle = 1; inp.brake = 0; }\n    } else if (test.cones) { const limit = 62 / 3.6; if (u > limit) { inp.throttle = 0; inp.brake = 0.4; } else { inp.throttle = 1; inp.brake = 0; } }\n    return inp;\n  }\n}\nexport function runHeadless(test, { skill = 0.97, steps = 60 * 400 } = {}) { // a whole attempt in Node: returns the demonstration's time\n  let total = 0, status = 'pass', reason = '';\n  for (let leg = 0; leg < legCount(test); leg++) {\n    const sim = new RaceSim({ ...testSetup(test, leg), record: false, seed: 1 }), judge = new Judge(test, sim), brain = new DemoBrain(test, sim, judge, { skill });\n    sim.cars[0].player = null; sim.cars[0].autoDrive = true;\n    sim.aiInput = () => brain.input();\n    for (let i = 0; i < steps && judge.status === 'running'; i++) { sim.step([]); sim.drainEvents(); judge.step(1 / 60); }\n    if (judge.status !== 'pass') { status = 'fail'; reason = `${legCar(test, leg)}: ${judge.reason || 'ran out of time'} at ${judge.travelled.toFixed(0)} m`; break; }\n    total += judge.total;\n  }\n  return { time: total, status, reason };\n}\nvoid indexOfS; void fullInstall;\nEOF\ncat > tools/medals.mjs <<'EOF'\n// node tools/medals.mjs: runs each licence test's AI demonstration at 97% pace, and freezes the medal times.\n// gold = T x 1.03, silver = T x 1.09, bronze = T x 1.18.\nimport { writeFileSync } from 'node:fs';\nimport { TESTS, TEST_IDS } from '../src/game/data/licences.js';\nimport { runHeadless } from '../src/game/sim/licence.js';\nconst out = {}; const lines = [];\nfor (const id of TEST_IDS) {\n  const r = runHeadless(TESTS[id]);\n  if (r.status !== 'pass') { console.log(`${id}: demonstration FAILED: ${r.reason}`); process.exitCode = 1; continue; }\n  const T = r.time, f = (x) => Math.round(T * x * 100) / 100;\n  out[id] = { demo: Math.round(T * 100) / 100, gold: f(1.03), silver: f(1.09), bronze: f(1.18) };\n  lines.push(`  '${id}': ${JSON.stringify(out[id])},`);\n  console.log(id, T.toFixed(2));\n}\nif (!process.exitCode) writeFileSync(new URL('../src/game/data/medals.js', import.meta.url), `// Written by tools/medals.mjs from the AI demonstrations (gold T x 1.03, silver x 1.09, bronze x 1.18). Frozen here.\\nexport const MEDALS = {\\n${lines.join('\\n')}\\n};\\n`);\nEOF\nnode tools/medals.mjs 2>&1 | tail -20","description":"Write tuning, career, replay, race and licence modules, run medals tool","timeout":120000}}}
