treet']) });\")\ns=s.replace(\"t.ok(count(new CarView('ryuRally').object) > count(new CarView('ryu').object), 'a rally car has mud flaps and a roof vent');\",\"const tris = (o) => { let n = 0; o.traverse((m) => { if (m.isMesh) n += (m.geometry.index?.count ?? m.geometry.attributes.position.count) / 3; }); return n; }; t.ok(tris(new CarView('ryuRally').object) > tris(new CarView('ryu').object), 'a rally car has mud flaps and a roof vent');\")\n# director\na=s.index(\"  const cam = new THREE.PerspectiveCamera(), f = { x: tr.x[0], y: tr.y[0], z: tr.z[0], s: 0 };\")\nb=s.index(\"// ---- Scenes, by real input ----\")\ns=s[:a]+'''  for (const id of ['kestrel', 'cedar', 'harbour', 'saltline', 'redclay', 'proving']) for (const v of [30, 50, 75]) {\n    const T2 = loadTrack(id).tr, D = new TvDirector(T2, null, 11), cam = new THREE.PerspectiveCamera(); let s = 0, time = 0, last = null, worst = 0; const ints = [];\n    for (let i = 0; i < 3600; i++) { s = (s + v / 60) % T2.length; const k = Math.round(s / T2.ds) % T2.N, f = { x: T2.x[k], y: T2.y[k], z: T2.z[k], s }; time += 1 / 60; const cut = D.update(1 / 60, f, cam, {}); if (cut) { if (last !== null) ints.push(time - last); last = time; worst = Math.max(worst, Math.hypot(D.shot.x - f.x, D.shot.z - f.z)); } }\n    t.ok(ints.length >= 6 && ints.every((d) => d >= 3.2 && d <= 8.1), `${id} at ${v} m/s: a cut every 4 to 8 s: ${ints.map((d) => d.toFixed(1)).join(',')}`); t.ok(worst < 260, `${id} at ${v} m/s: a new shot can see the car: ${worst.toFixed(0)} m`);\n  }\n  { const cam = new THREE.PerspectiveCamera(), T2 = loadTrack('kestrel').tr, D = new TvDirector(T2, null, 11), f = { x: T2.x[0], y: T2.y[0], z: T2.z[0], s: 0 }; let time = 0, last = null; const ints = []; for (let i = 0; i < 3600; i++) { time += 1 / 60; if (D.update(1 / 60, f, cam, {})) { if (last !== null) ints.push(time - last); last = time; } } t.ok(ints.length >= 6 && ints.every((d) => d >= 3.9 && d <= 8.1), `a stopped car: a cut every 4 to 8 s: ${ints.map((d) => d.