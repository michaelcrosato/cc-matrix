 = solo({ track: 'proving', startS: 0, startSpeed: 120, env: { ...defaultEnv(), ...env } }), e = q.cars[0]; const a = e.metres; for (let i = 0; i < 400 && e.c.u > 1; i++) q.step([{ brake: 1 }]); return e.metres - a; };\\n  t.ok(brake({ brakeScale: 0.5 }) > brake({}) + 5, 'Brake strength: weak brakes stop longer');\")\ns=s.replace(\"const z = s.rec.compress(), r2 = Recording.fromCompressed(z); t.near(r2.frames, 100, 2, 'the compressed copy holds 10 a second');\",\"const z = s.rec.compress(), r2 = Recording.fromCompressed(z); t.near(z.frames, 100, 2, 'the compressed copy holds 10 a second'); t.ok(Math.abs(atob(z.data).length - z.frames * z.carN * 9 * 2) < 4, 'quantised to 16 bits, 9 numbers a car');\")\n# models\ns=s.replace(\"wing = new CarView('ginga', { install: { parts: ['aeroWing'], paint: null, rims: 0, tyre: null, setup: {} } }), lip = new CarView('ginga', { install: { parts: ['aeroStreet'], paint: null, rims: 0, tyre: null, setup: {} } });\",\"wing = new CarView('ginga', { install: fullInstall(['aeroWing']) }), lip = new CarView('ginga', { install: fullInstall(['aeroStreet']) });\")\ns=s.replace(\"t.ok(count(new CarView('ryuRally').object) > count(new CarView('ryu').object), 'a rally car has mud flaps and a roof vent');\",\"const tris = (o) => { let n = 0; o.traverse((m) => { if (m.isMesh) n += (m.geometry.index?.count ?? m.geometry.attributes.position.count) / 3; }); return n; }; t.ok(tris(new CarView('ryuRally').object) > tris(new CarView('ryu').object), 'a rally car has mud flaps and a roof vent');\")\n# director\na=s.index(\"  const cam = new THREE.PerspectiveCamera(), f = { x: tr.x[0], y: tr.y[0], z: tr.z[0], s: 0 };\")\nb=s.index(\"// ---- Scenes, by real input ----\")\ns=s[:a]+'''  for (const id of ['kestrel', 'cedar', 'harbour', 'saltline', 'redclay', 'proving']) for (const v of [30, 50, 75]) {\n    const T2 = loadTrack(id).tr, D = new TvDirector(T2, null, 11), cam = new THREE.PerspectiveCamera(); let s = 0, time = 0, last = null, worst = 0; const ints = [];\n    for (let i = 0; i < 3600; i++) { s = (s + v / 60) % T2.length; const k = Math.round(s / T2.ds) % T2.N, f = { x: T2.x[k], y: T2.y[k], z: T2.z[k], s }; time += 1 / 60; const cut = D.update(1 / 60, f, cam, {}); if (cut) { if (last !== null) ints.push(time - last); last = time; worst = Math.max(worst, Math.hypot(D.shot.x - f.x, D.shot.z - f.z)); } }\n    t.ok(ints.length >= 6 && ints.every((d) => d >= 3.2 && d <= 8.1), `${id} at ${v} m/s: a cut every 4 to 8 s: ${ints.map((d) => d.toFixed(1)).join(',')}`); t.ok(worst < 260, `${id} at ${v} m/s: a new shot can see the car: ${worst.toFixed(0)} m`);\n  }\n  { const cam = new THREE.PerspectiveCamera(), T2 = loadTrack('kestrel').tr, D = new TvDirector(T2, null, 11), f = { x: T2.x[0], y: T2.y[0], z: T2.z[0], s: 0 }; let time = 0, last = null; const ints = []; for (let i = 0; i < 3600; i++) { time += 1 / 60; if (D.update(1 / 60, f, cam, {})) { if (last !== null) ints.push(time - last); last = time; } } t.ok(ints.length >= 6 && ints.every((d) => d >= 3.9 && d <= 8.1), `a stopped car: a cut every 4 to 8 s: ${ints.map((d) => d.toFixed(1)).join(',')}`); }\n}\n'''+s[b:]\n# HUD: camera checks before the wrong way flip\nold=\"  me.c.yaw += Math.PI; t.ok(await shows('WRONG WAY'), 'HUD: wrong way'); me.c.yaw -= Math.PI;\\n\"\ns=s.replace(old,\"\")\nmarker=\"  // Camera key.\\n\"\ns=s.replace(marker,\"  me.c.yaw += Math.PI; t.ok(await shows('WRONG WAY'), 'HUD: wrong way'); me.c.yaw -= Math.PI; s.sim.recover(me.i); await b.frames(4);\\n\"+marker)\n# replay's slide test, with a control\na=s.index(\"{ // The director prefers a slide.\")\nb=s.index(\"{ // Dev tools: finish in a position\")\ns=s[:a]+'''{ // The director prefers a slide. Hand-made recordings: two cars far apart; with and without the second one sliding throughout.\n  const make = (slide) => { const rec = new Recording({ track: 'kestrel', hour: 12, hourEnd: null, rain: false, cars: [{ carId: 'kite', install: null, name: 'A', paint: null, player: 0 }, { carId: 'kite', install: null, name: 'B', paint: null, player: null }] }), { tr } = loadTrack('kestrel'), v = new Array(FIELDS).fill(0); for (let n = 0; n < 900; n++) { for (const i of [0, 1]) { const k = (i * 80 + n) % tr.N; v[0] = tr.x[k]; v[1] = tr.y[k]; v[2] = tr.z[k]; v[3] = 0; v[7] = 5000; v[10] = i === 1 && slide ? F_SLIDE : 0; v[11] = 30; rec.add(i, v); } rec.push(); } return rec; };\n  await app.go(() => new ReplayScene(app, make(false), {})); await b.settle(); let r = app.scene; t.eq(r.home, 0, 'the replay is about the player'); await b.frames(600); t.eq(r.focus, 0, 'with nothing happening it stays on the player');\n  await app.go(() => new ReplayScene(app, make(true), {})); await b.settle(); r = app.scene; t.ok(await b.until(() => r.focus === 1, 800), 'the director cuts to the car that slides'); await app.toTitle(); await b.settle();\n}\n'''+s[b:]\n# attract: wait out its 0.1 s grace\ns=s.replace(\"t.ok(app.attract.active, 'start attract now'); app.actions.inject('confirm'); app.actions.domInput = true;\",\"t.ok(app.attract.active, 'start attract now'); await b.frames(12); app.actions.inject('confirm'); await b.frames(1); app.actions.domInput = true;\")\n# museum uses the real id order\ns=s.replace(\"if (['pico', 'kite', 'ginga', 'moth', 'ryu', 'longhorn', 'brandt32', 'heck', 'libeccio', 'kiteCup', 'ryuRally', 'works', 'corsa', 'type9'][m.car] === id) return;\",\"if (CAR_IDS[m.car] === id) return;\")\nopen(p,'w').write(s)\nEOF\nrm -f tools/.dbg.mjs; timeout 290 node tools/tests/behave.mjs > tools/.behave.log 2>&1; python3 tools/.show.py tools/.behave.log | cut -c1-340","description":"Fix the director, replay focus and steering, correct the tests, rerun","timeout":300000}}}
