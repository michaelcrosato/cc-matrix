{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CRzdDm73iTbPPQWwvcdWfo","type":"tool_result","content":"1\t// Dev mode: a pad-friendly panel over the running game. Live sliders, tools, overlays. Sliders stay for the session; Reset clears them.\n2\timport { CAR_IDS, CAR_INFO } from '../data/cars.js';\n3\timport { EVENT_IDS, EVENTS } from '../data/events.js';\n4\timport { TEST_IDS, TESTS, LICENCE_ORDER, LICENCES } from '../data/licences.js';\n5\timport { addCar, carEntry, eventState, newProfile, recordRound, recordTest } from '../sim/career.js';\n6\timport { defaultEnv, trackPoint } from '../sim/race.js';\n7\timport { THREE } from '../../pixel-engine.js';\n8\tconst { Vector3 } = THREE;\n9\texport const SLIDERS = [\n10\t  { id: 'gripScale', name: 'GRIP', def: 1, min: 0.5, max: 1.5, step: 0.05, get: (a) => a.env.gripScale, set: (a, v) => { a.env.gripScale = v; } },\n11\t  { id: 'powerScale', name: 'POWER', def: 1, min: 0.5, max: 2, step: 0.05, get: (a) => a.env.powerScale, set: (a, v) => { a.env.powerScale = v; } },\n12\t  { id: 'brakeScale', name: 'BRAKE STRENGTH', def: 1, min: 0.5, max: 1.5, step: 0.05, get: (a) => a.env.brakeScale, set: (a, v) => { a.env.brakeScale = v; } },\n13\t  { id: 'aeroScale', name: 'DOWNFORCE', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.aeroScale, set: (a, v) => { a.env.aeroScale = v; } },\n14\t  { id: 'wearScale', name: 'TYRE WEAR', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.env.wearScale, set: (a, v) => { a.env.wearScale = v; } },\n15\t  { id: 'fuelScale', name: 'FUEL USE', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.env.fuelScale, set: (a, v) => { a.env.fuelScale = v; } },\n16\t  { id: 'steerRate', name: 'STEERING RATE', def: 3, min: 1, max: 8, step: 0.25, get: (a) => a.env.steerRate, set: (a, v) => { a.env.steerRate = v; } },\n17\t  { id: 'stability', name: 'STABILITY STRENGTH', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.stability, set: (a, v) => { a.env.stability = v; } },\n18\t  { id: 'traction', name: 'TRACTION STRENGTH', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.traction, set: (a, v) => { a.env.traction = v; } },\n19\t  { id: 'aiPace', name: 'AI PACE', def: 0, min: 0, max: 1.05, step: 0.01, get: (a) => a.env.aiPace ?? 0, set: (a, v) => { a.env.aiPace = v < 0.7 ? null : v; }, fmt: (v) => (v < 0.7 ? 'EVENT' : v.toFixed(2)) },\n20\t  { id: 'rubber', name: 'AI RUBBER BAND', def: 0, min: 0, max: 0.03, step: 0.002, get: (a) => a.env.rubber, set: (a, v) => { a.env.rubber = v; }, fmt: (v) => v.toFixed(3) },\n21\t  { id: 'wallLoss', name: 'WALL SPEED LOSS', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.wallLoss, set: (a, v) => { a.env.wallLoss = v; } },\n22\t  { id: 'slip', name: 'SLIPSTREAM', def: 0.65, min: 0.4, max: 1, step: 0.05, get: (a) => a.env.slip, set: (a, v) => { a.env.slip = v; } },\n23\t  { id: 'prize', name: 'PRIZE MONEY', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.prizeMult ?? 1, set: (a, v) => { a.prizeMult = v; } },\n24\t  { id: 'chase', name: 'CHASE DISTANCE', def: 8.5, min: 4, max: 14, step: 0.5, get: (a) => a.devSliders?.chase ?? 8.5, set: (a, v) => { (a.devSliders ??= { fov: 58 }).chase = v; if (a.scene?.chase) a.scene.chase.distance = v; } },\n25\t  { id: 'fov', name: 'CHASE FOV', def: 58, min: 40, max: 90, step: 2, get: (a) => a.devSliders?.fov ?? 58, set: (a, v) => { (a.devSliders ??= { chase: 8.5 }).fov = v; if (a.scene?.chase) a.scene.chase.fovBase = v; }, fmt: (v) => v.toFixed(0) },\n26\t];\n27\tconst PER = 7;\n28\tconst TABS = ['SLIDERS', 'RACE', 'VIEW', 'WEATHER', 'CAREER', 'JUMP'];\n29\tconst SCALES = [0.25, 0.5, 1, 2, 4];\n30\texport const newDevState = () => ({ overlays: { line: false, load: false, surface: false, circles: false, ai: false, telemetry: false }, freeCam: false, tele: [], savedState: null });\n31\texport function devDirty(app) { for (const s of SLIDERS) { const v = s.get(app); if (Math.abs(v - s.def) > 1e-6) return true; } return !!app.env.god; }\n32\texport class DevPanel {\n33\t  constructor(app, scene) { this.id = 'dev'; this.app = app; this.scene = scene; this.tab = 0; this.page = 0; app.dev = app.dev ?? newDevState(); }\n34\t  draw(ui) {\n35\t    const app = this.app, w = Math.min(ui.w - 12, 380), x = Math.round(ui.cx - w / 2), h = ui.h - 22;\n36\t    ui.panel(x, 3, w, h, { color: 'ink', border: 'red', scan: false });\n37\t    ui.text(x + 6, 7, 'DEV MODE', { color: 'red' }); if (devDirty(app)) ui.text(x + w - 6, 7, 'RECORDS ARE OFF', { align: 'right', color: 'orange' });\n38\t    ui.tabs('t', x + 3, 17, w - 6, TABS, this.tab, (i) => { this.tab = i; this.focus = null; this.page = 0; ui.box.ready = false; });\n39\t    const fn = [this.sliders, this.race, this.view, this.weather, this.career, this.jump][this.tab]; fn.call(this, ui, x + 5, 33, w - 10);\n40\t  }\n41\t  btn(ui, id, x, y, w, label, fn, o = {}) { ui.button(id, x, y, w, 15, label, { ...o, confirm: fn }); }\n42\t  sliders(ui, x, y, w) {\n43\t    const app = this.app, pages = Math.ceil(SLIDERS.length / PER), list = SLIDERS.slice(this.page * PER, this.page * PER + PER);\n44\t    list.forEach((s, k) => ui.slider(s.id, x, y + k * 18, w, 15, s.name, s.get(app), s.min, s.max, { step: s.step, set: (v) => { s.set(app, Math.round(v / s.step) * s.step); app.devDirty = devDirty(app); }, reset: () => { s.set(app, s.def); app.devDirty = devDirty(app); }, format: s.fmt ?? ((v) => v.toFixed(2)) }));\n45\t    const by = y + PER * 18 + 2, bw = (w - 6) / 2;\n46\t    this.btn(ui, 'pageNext', x, by, bw, `MORE SLIDERS ${this.page + 1}/${pages}`, () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; });\n47\t    this.btn(ui, 'resetAll', x + bw + 6, by, bw, 'RESET ALL', () => this.resetAll());\n48\t    ui.prompts([['moveX', 'ADJUST'], ['confirm', 'RESET ONE'], ['info', 'RESET ALL'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n49\t  }\n50\t  onInfo() { if (this.tab === 0) this.resetAll(); }\n51\t  resetAll() { const app = this.app, d = defaultEnv(); Object.assign(app.env, d); app.prizeMult = 1; app.devSliders = null; if (app.scene?.chase) { app.scene.chase.distance = null; app.scene.chase.fovBase = 58; } app.devDirty = false; app.ui.note('ALL SLIDERS AT THEIR DEFAULTS.'); }\n52\t  race(ui, x, y, w) {\n53\t    const app = this.app, s = app.scene, sim = s?.sim, bw = (w - 6) / 2;\n54\t    if (!sim) { ui.lines(x + 2, y + 2, 'THESE TOOLS WORK DURING A DRIVE. OPEN DEV MODE FROM THE PAUSE MENU.', { chars: 50, color: 'mist' }); this.btn(ui, 'quick', x, y + 26, w, 'START A TEST RACE NOW', () => app.startQuick({ track: 'kestrel', carId: 'ginga', laps: 2, field: 6, difficulty: 'normal' })); ui.prompts([['confirm', 'CHOOSE'], ['tabs', 'TAB'], ['back', 'CLOSE']]); return; }\n55\t    const me = s.focusE ?? sim.cars[0], L = sim.tr.length;\n56\t    const f = ui.item('teleport', x, y, w, 15, { onX: (d) => { const k = (me.c.loc.s + d * 80 + L) % L; sim.teleport(me.i, k); s.chase?.snap(); app.mix.sfx('tick'); }, confirm: () => sim.teleport(me.i, 0) }); ui.rect(x, y, w, 15, f ? 'navy' : 'night'); ui.text(x + 6, y + 4, 'TELEPORT ALONG THE TRACK', { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 4, `< ${Math.round(me.c.loc.s)} M >`, { align: 'right', color: 'sand' });\n57\t    const pos = this.finishPos ?? 1;\n58\t    const f2 = ui.item('finish', x, y + 18, w, 15, { onX: (d) => { this.finishPos = Math.max(1, Math.min(sim.cars.length, pos + d)); }, confirm: () => { ui.pop(); ui.pop(); sim.finishNow(me.i, pos); } }); ui.rect(x, y + 18, w, 15, f2 ? 'navy' : 'night'); ui.text(x + 6, y + 22, 'FINISH NOW IN POSITION', { color: f2 ? 'white' : 'mist' }); ui.text(x + w - 6, y + 22, `< ${pos} >`, { align: 'right', color: 'sand' });\n59\t    this.btn(ui, 'end', x, y + 36, bw, 'END RACE', () => { ui.pop(); ui.pop(); sim.finishNow(me.i, sim.cars.length); });\n60\t    this.btn(ui, 'restart', x + bw + 6, y + 36, bw, 'RESTART', () => app.restartRun(s));\n61\t    this.btn(ui, 'reset', x, y + 54, bw, 'RESET CAR', () => sim.recover(me.i));\n62\t    this.btn(ui, 'god', x + bw + 6, y + 54, bw, `GOD MODE: ${app.env.god ? 'ON' : 'OFF'}`, () => { app.env.god = !app.env.god; app.devDirty = devDirty(app); });\n63\t    const cur = SCALES.indexOf(app.engine.timeScale);\n64\t    const f3 = ui.item('scale', x, y + 72, w, 15, { onX: (d) => { const n = SCALES[Math.max(0, Math.min(SCALES.length - 1, (cur < 0 ? 2 : cur) + d))]; app.engine.timeScale = n; }, confirm: () => { app.engine.timeScale = 1; } }); ui.rect(x, y + 72, w, 15, f3 ? 'navy' : 'night'); ui.text(x + 6, y + 76, 'TIME SCALE', { color: f3 ? 'white' : 'mist' }); ui.text(x + w - 6, y + 76, `< ${app.engine.timeScale} >`, { align: 'right', color: 'sand' });\n65\t    this.btn(ui, 'frame', x, y + 90, bw, 'STEP ONE FRAME', () => { s.stepFrames = 1; });\n66\t    this.btn(ui, 'saveState', x + bw + 6, y + 90, bw, 'SAVE STATE', () => { app.dev.savedState = sim.saveState(); ui.note('STATE SAVED.'); });\n67\t    this.btn(ui, 'loadState', x, y + 108, bw, 'LOAD STATE', () => { if (app.dev.savedState) { sim.loadState(app.dev.savedState); s.chase?.snap(); ui.note('STATE LOADED.'); } else ui.note('NOTHING SAVED YET.'); });\n68\t    this.btn(ui, 'changeCar', x + bw + 6, y + 108, bw, 'CHANGE CAR', () => { const d = s.data, i = d.cars.findIndex((c) => c.player === 0); if (i < 0) return; const n = CAR_IDS[(CAR_IDS.indexOf(d.cars[i].carId) + 1) % CAR_IDS.length], patch = { ...d, cars: d.cars.map((c, k) => (k === i ? { ...c, carId: n, install: null } : c)) }; app.restartWith(s, patch); });\n69\t    ui.prompts([['confirm', 'DO IT'], ['moveX', 'ADJUST'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n70\t  }\n71\t  view(ui, x, y, w) {\n72\t    const app = this.app, o = app.dev.overlays, bw = (w - 6) / 2, tog = (id, label, on, fn, i) => this.btn(ui, id, x + (i % 2) * (bw + 6), y + Math.floor(i / 2) * 18, bw, `${label}: ${on ? 'ON' : 'OFF'}`, fn);\n73\t    [['line', 'RACING LINE'], ['load', 'WHEEL LOAD, SLIP'], ['surface', 'SURFACE TINT'], ['circles', 'COLLISION CIRCLES'], ['ai', 'AI TARGETS'], ['telemetry', 'TELEMETRY']].forEach(([k, label], i) => tog(k, label, o[k], () => { o[k] = !o[k]; if (k === 'line' && app.scene) app.scene.lineOn = o[k]; }, i));\n74\t    tog('freeCam', 'FREE CAMERA', app.dev.freeCam, () => { app.dev.freeCam = !app.dev.freeCam; if (app.dev.freeCam) app.dev.driveFreeCam = driveFreeCam; }, 6);\n75\t    tog('panel', 'ENGINE DEBUG PANEL', !!app.engine.debugShown, () => app.engine.showDebug(!app.engine.debugShown), 7);\n76\t    ui.prompts([['confirm', 'TOGGLE'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n77\t  }\n78\t  weather(ui, x, y, w) {\n79\t    const app = this.app, s = app.scene, d = s?.data, bw = (w - 6) / 2;\n80\t    if (!d) { ui.lines(x + 2, y + 2, 'THE WEATHER CHANGES ONLY ON THE CIRCUIT. IT IS ALWAYS SOMETHING ON THE PENINSULA.', { chars: 50, color: 'mist' }); ui.prompts([['tabs', 'TAB'], ['back', 'CLOSE']]); this.btn(ui, 'attract', x, y + 28, w, 'START ATTRACT MODE NOW', () => app.attract?.start()); return; }\n81\t    this.hour = this.hour ?? d.hour ?? 12;\n82\t    const f = ui.item('hour', x, y, w, 15, { onX: (k) => { this.hour = (this.hour + k + 24) % 24; s.world?.setHourIf(this.hour); }, confirm: () => app.restartWith(s, { ...d, hour: this.hour }) }); ui.rect(x, y, w, 15, f ? 'navy' : 'night'); ui.text(x + 6, y + 4, 'HOUR OF DAY (CONFIRM RESTARTS WITH LAMPS)', { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 4, `< ${this.hour} >`, { align: 'right', color: 'sand' });\n83\t    this.btn(ui, 'rain', x, y + 18, bw, `RAIN: ${d.rain ? 'ON' : 'OFF'}`, () => app.restartWith(s, { ...d, rain: !d.rain }));\n84\t    const n = d.cars.length;\n85\t    const f2 = ui.item('fieldSize', x + bw + 6, y + 18, bw, 15, { onX: (k) => { this.field = Math.max(1, Math.min(8, (this.field ?? n) + k)); }, confirm: () => { const m = this.field ?? n, me = d.cars.filter((c) => c.player !== null && c.player !== undefined), others = d.cars.filter((c) => c.player === null || c.player === undefined); const pool = others.length ? others : [{ carId: me[0]?.carId ?? 'ginga', name: 'T. HOLLIS', skill: 0.9 }]; const list = []; for (let i = 0; i < m - me.length; i++) list.push({ ...pool[i % pool.length], name: `AI ${i + 1}` }); app.restartWith(s, { ...d, cars: [...list, ...me] }); } }); ui.rect(x + bw + 6, y + 18, bw, 15, f2 ? 'navy' : 'night'); ui.text(x + bw + 12, y + 22, `FIELD < ${this.field ?? n} >`, { color: f2 ? 'white' : 'mist' });\n86\t    this.btn(ui, 'attract', x, y + 36, w, 'START ATTRACT MODE NOW', () => app.attract?.start());\n87\t    ui.prompts([['confirm', 'APPLY'], ['moveX', 'ADJUST'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n88\t  }\n89\t  career(ui, x, y, w) {\n90\t    const app = this.app, p = app.profile, bw = (w - 6) / 2;\n91\t    this.btn(ui, 'credits', x, y, bw, 'GIVE 100,000 CR', () => { p.credits += 100000; app.save(); ui.note('100,000 CR GIVEN.'); });\n92\t    this.btn(ui, 'cars', x + bw + 6, y, bw, 'UNLOCK ALL CARS', () => { for (const id of CAR_IDS) if (!p.cars.some((c) => c.carId === id)) addCar(p, id, { prize: CAR_INFO[id].where === 'prize' }); if (p.current === null) p.current = p.cars[0].uid; app.save(); ui.note('ALL FOURTEEN IN THE GARAGE.'); });\n93\t    this.btn(ui, 'gold', x, y + 18, bw, 'ALL TESTS AT GOLD', () => { for (const id of TEST_IDS) recordTest(p, id, TESTS[id].medals.gold - 0.01); app.save(); ui.note('EVERY LICENCE HELD, AT GOLD.'); });\n94\t    this.btn(ui, 'winEvent', x + bw + 6, y + 18, bw, 'WIN THE CURRENT EVENT', () => { const id = app.scene?.data?.event ?? EVENT_IDS.find((k) => !p.events[k]?.won) ?? 'gp', e = EVENTS[id]; let last = null; const st = eventState(p, id); for (let i = st.round; i < e.rounds.length; i++) last = recordRound(p, id, ['YOU', 'R. OKADA'], 'YOU'); app.save(); ui.note(`${e.name} WON${last?.prizeCar ? `: ${CAR_INFO[last.prizeCar].short}` : ''}.`); });\n95\t    this.btn(ui, 'resetSave', x, y + 36, w, 'RESET THE SAVE', () => { app.profile = newProfile(); app.save(); if (app.profile && app.toTitle) app.toTitle(); });\n96\t    ui.text(x + 2, y + 56, `CREDITS ${p.credits.toLocaleString('en-US')}`, { color: 'mist' }); ui.text(x + 2, y + 66, `CURRENT CAR ${carEntry(p) ? CAR_INFO[carEntry(p).carId].short : 'NONE'}`, { color: 'mist' });\n97\t    ui.prompts([['confirm', 'DO IT'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n98\t    void LICENCE_ORDER; void LICENCES;\n99\t  }\n100\t  jump(ui, x, y, w) {\n101\t    const app = this.app; const list = [...EVENT_IDS.map((id) => ({ id: `ev-${id}`, label: `EVENT: ${EVENTS[id].name}`, go: () => app.startEventRound(id) })), ...TEST_IDS.map((id) => ({ id: `t-${id}`, label: `TEST ${id}: ${TESTS[id].title}`, go: () => app.startTest(id) })), ...['map', 'dealer', 'tuning', 'service', 'garage', 'museum', 'theatre', 'arcade'].map((id) => ({ id: `m-${id}`, label: `MENU: ${id.toUpperCase()}`, go: () => app.jumpMenu(id) }))];\n102\t    const pages = Math.ceil(list.length / PER); list.slice(this.page * PER, this.page * PER + PER).forEach((it, k) => this.btn(ui, it.id, x, y + k * 18, w, it.label, () => { if (app.profile.cars.length === 0 && !it.id.startsWith('m-')) addCar(app.profile, 'kite'); ui.clear(); it.go(); }, { left: true }));\n103\t    this.btn(ui, 'pageNext', x, y + PER * 18 + 2, w, `MORE ${this.page + 1}/${pages}`, () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; });\n104\t    ui.prompts([['confirm', 'GO'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n105\t  }\n106\t}\n107\tconst FV = new Vector3();\n108\tfunction driveFreeCam(ctx, dt, cam) { // WASD or the left stick moves, the right stick or a right drag looks\n109\t  const input = ctx.input, a = FV; this._y = this._y ?? 0;\n110\t  let mx = 0, mz = 0, my = 0, lx = 0, ly = 0;\n111\t  if (input.isDown('KeyW') || input.isDown('ArrowUp')) mz += 1; if (input.isDown('KeyS') || input.isDown('ArrowDown')) mz -= 1; if (input.isDown('KeyA') || input.isDown('ArrowLeft')) mx -= 1; if (input.isDown('KeyD') || input.isDown('ArrowRight')) mx += 1; if (input.isDown('KeyE')) my += 1; if (input.isDown('KeyQ')) my -= 1;\n112\t  const app = ctx.engine.game?.app; for (const p of app?.actions.pads ?? []) { mx += p.axes[0]; mz -= p.axes[1]; lx += p.axes[2]; ly += p.axes[3]; }\n113\t  if (input.isDown('MouseRight')) { lx += (input.mouseDelta.x ?? 0) * 0.3; ly += (input.mouseDelta.y ?? 0) * 0.3; }\n114\t  cam.rotation.order = 'YXZ'; cam.rotation.y -= lx * dt * 2; cam.rotation.x = Math.max(-1.4, Math.min(1.4, cam.rotation.x - ly * dt * 2));\n115\t  a.set(mx, my, -mz).multiplyScalar(dt * 24).applyEuler(cam.rotation); cam.position.add(a);\n116\t}\n117\tconst P = new Vector3();\n118\t// Overlays, drawn over the HUD.\n119\texport function drawOverlays(ui, app, scene) {\n120\t  const dev = app.dev; if (!dev) return; const o = dev.overlays, sim = scene.sim, cam = scene.cam, me = scene.focusE; if (!sim || !me) return;\n121\t  const project = (x, y, z) => { P.set(x, y, z).project(cam); return P.z < 1 ? [(P.x + 1) * 0.5 * ui.w, (1 - P.y) * 0.5 * ui.h] : null; };\n122\t  const c = me.c;\n123\t  if (o.load) { const bx = ui.w - 96, by = 60; ui.panel(bx - 3, by - 3, 96, 52, { color: 'ink', border: false, scan: true }); for (let i = 0; i < 4; i++) { const load = c.fz[i] / (c.p.mass * 9.81 * 0.5), slip = Math.min(1.6, c.use[i]) / 1.6; ui.text(bx, by + i * 12, ['FL', 'FR', 'RL', 'RR'][i], { color: 'mist' }); ui.bar(bx + 16, by + i * 12, 34, 4, load, 'sky', 'night'); ui.bar(bx + 54, by + i * 12, 34, 4, slip, slip > 0.8 ? 'red' : 'lime', 'night'); } }\n124\t  if (o.surface) { const col = { asphalt: 'slate', kerb: 'red', grass: 'green', gravel: 'orange', dirt: 'orange', apron: 'mist' }[c.surface] ?? 'white'; ui.rect(0, 0, ui.w, 2, col); ui.rect(0, ui.h - 2, ui.w, 2, col); ui.text(ui.cx, 8, `SURFACE: ${c.surface.toUpperCase()}`, { align: 'center', color: col }); }\n125\t  if (o.circles) for (const e of sim.cars) { for (const off of [-1.35, 0, 1.35]) { const cx = e.c.x + Math.sin(e.c.yaw) * off, cz = e.c.z + Math.cos(e.c.yaw) * off; for (let a = 0; a < 12; a++) { const t = (a / 12) * 6.283, q = project(cx + Math.sin(t) * 0.875, e.c.y + 0.3, cz + Math.cos(t) * 0.875); if (q) ui.rect(q[0], q[1], 1, 1, e === me ? 'lime' : 'red'); } } }\n126\t  if (o.ai) for (const e of sim.cars) { if (e.player !== null && !e.autoDrive) continue; const u = Math.hypot(e.c.vx, e.c.vz), idx = (e.c.loc.i + Math.round(Math.max(7, u * 0.62) / sim.tr.ds)) % sim.tr.N, tr = sim.tr, rx = -tr.tz[idx], rz = tr.tx[idx], lane = e.c.laneNow ?? 0, q = project(sim.line.px[idx] + rx * lane, tr.y[idx] + 0.3, sim.line.pz[idx] + rz * lane); if (q) { ui.rect(q[0] - 1, q[1] - 1, 3, 3, 'cyan'); } const n = project(e.c.x, e.c.y + 1.7, e.c.z); if (n) ui.text(n[0], n[1] - 8, `${(e.speeds[e.c.loc.i] * 3.6).toFixed(0)}`, { align: 'center', color: 'cyan' }); }\n127\t  if (o.line) { const i = c.loc.i; ui.text(ui.cx, 16, `LINE WANTS ${(me.speeds[i] * 3.6).toFixed(0)} KM/H`, { align: 'center', color: 'lime' }); }\n128\t  if (o.telemetry) {\n129\t    const T = dev.tele; T.push([Math.abs(c.u) / 90, me.inp?.throttle ?? 0, me.inp?.brake ?? 0, 0.5 + c.ax / 40, 0.5 + c.ay / 40]); if (T.length > 200) T.shift();\n130\t    const x0 = ui.cx - 100, y0 = ui.h - 52, H = 26; ui.panel(x0 - 2, y0 - 2, 204, H + 4, { color: 'ink', border: false }); const cols = ['white', 'lime', 'red', 'sky', 'sand']; T.forEach((v, k) => { for (let n = 0; n < 5; n++) ui.rect(x0 + k, y0 + H - Math.round(Math.max(0, Math.min(1, v[n])) * H), 1, 1, cols[n]); });\n131\t    ui.text(x0, y0 - 10, 'SPD THR BRK AX AY', { color: 'mist' });\n132\t  }\n133\t  void trackPoint;\n134\t}\n135\t"}]},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"48b5a6b9-2dcd-458c-be0f-741f08523ca3","timestamp":"2026-11-06T04:15:22.085Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-171904__x89353d/work/GranTumbleweed-GranTurismo3ASpec-claude-opus-5-5-xhigh-20261105-171904/src/game/dev/devmode.js","content":"// Dev mode: a pad-friendly panel over the running game. Live sliders, tools, overlays. Sliders stay for the session; Reset clears them.\nimport { CAR_IDS, CAR_INFO } from '../data/cars.js';\nimport { EVENT_IDS, EVENTS } from '../data/events.js';\nimport { TEST_IDS, TESTS, LICENCE_ORDER, LICENCES } from '../data/licences.js';\nimport { addCar, carEntry, eventState, newProfile, recordRound, recordTest } from '../sim/career.js';\nimport { defaultEnv, trackPoint } from '../sim/race.js';\nimport { THREE } from '../../pixel-engine.js';\nconst { Vector3 } = THREE;\nexport const SLIDERS = [\n  { id: 'gripScale', name: 'GRIP', def: 1, min: 0.5, max: 1.5, step: 0.05, get: (a) => a.env.gripScale, set: (a, v) => { a.env.gripScale = v; } },\n  { id: 'powerScale', name: 'POWER', def: 1, min: 0.5, max: 2, step: 0.05, get: (a) => a.env.powerScale, set: (a, v) => { a.env.powerScale = v; } },\n  { id: 'brakeScale', name: 'BRAKE STRENGTH', def: 1, min: 0.5, max: 1.5, step: 0.05, get: (a) => a.env.brakeScale, set: (a, v) => { a.env.brakeScale = v; } },\n  { id: 'aeroScale', name: 'DOWNFORCE', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.aeroScale, set: (a, v) => { a.env.aeroScale = v; } },\n  { id: 'wearScale', name: 'TYRE WEAR', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.env.wearScale, set: (a, v) => { a.env.wearScale = v; } },\n  { id: 'fuelScale', name: 'FUEL USE', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.env.fuelScale, set: (a, v) => { a.env.fuelScale = v; } },\n  { id: 'steerRate', name: 'STEERING RATE', def: 3, min: 1, max: 8, step: 0.25, get: (a) => a.env.steerRate, set: (a, v) => { a.env.steerRate = v; } },\n  { id: 'stability', name: 'STABILITY STRENGTH', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.stability, set: (a, v) => { a.env.stability = v; } },\n  { id: 'traction', name: 'TRACTION STRENGTH', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.traction, set: (a, v) => { a.env.traction = v; } },\n  { id: 'aiPace', name: 'AI PACE', def: 0, min: 0, max: 1.05, step: 0.01, get: (a) => a.env.aiPace ?? 0, set: (a, v) => { a.env.aiPace = v < 0.7 ? null : v; }, fmt: (v) => (v < 0.7 ? 'EVENT' : v.toFixed(2)) },\n  { id: 'rubber', name: 'AI RUBBER BAND', def: 0, min: 0, max: 0.03, step: 0.002, get: (a) => a.env.rubber, set: (a, v) => { a.env.rubber = v; }, fmt: (v) => v.toFixed(3) },\n  { id: 'wallLoss', name: 'WALL SPEED LOSS', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.wallLoss, set: (a, v) => { a.env.wallLoss = v; } },\n  { id: 'slip', name: 'SLIPSTREAM', def: 0.65, min: 0.4, max: 1, step: 0.05, get: (a) => a.env.slip, set: (a, v) => { a.env.slip = v; } },\n  { id: 'prize', name: 'PRIZE MONEY', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.prizeMult ?? 1, set: (a, v) => { a.prizeMult = v; } },\n  { id: 'chase', name: 'CHASE DISTANCE', def: 8.5, min: 4, max: 14, step: 0.5, get: (a) => a.devSliders?.chase ?? 8.5, set: (a, v) => { (a.devSliders ??= { fov: 58 }).chase = v; if (a.scene?.chase) a.scene.chase.distance = v; } },\n  { id: 'fov', name: 'CHASE FOV', def: 58, min: 40, max: 90, step: 2, get: (a) => a.devSliders?.fov ?? 58, set: (a, v) => { (a.devSliders ??= { chase: 8.5 }).fov = v; if (a.scene?.chase) a.scene.chase.fovBase = v; }, fmt: (v) => v.toFixed(0) },\n];\nconst PER = 7;\nconst TABS = ['SLIDERS', 'RACE', 'VIEW', 'WEATHER', 'CAREER', 'JUMP'];\nconst SCALES = [0.25, 0.5, 1, 2, 4];\nexport const newDevState = () => ({ overlays: { line: false, load: false, surface: false, circles: false, ai: false, telemetry: false }, freeCam: false, tele: [], savedState: null });\nexport function devDirty(app) { for (const s of SLIDERS) { const v = s.get(app); if (Math.abs(v - s.def) > 1e-6) return true; } return !!app.env.god; }\nexport class DevPanel {\n  constructor(app, scene) { this.id = 'dev'; this.app = app; this.scene = scene; this.tab = 0; this.page = 0; app.dev = app.dev ?? newDevState(); }\n  draw(ui) {\n    const app = this.app, w = Math.min(ui.w - 12, 380), x = Math.round(ui.cx - w / 2), h = ui.h - 22;\n    ui.panel(x, 3, w, h, { color: 'ink', border: 'red', scan: false });\n    ui.text(x + 6, 7, 'DEV MODE', { color: 'red' }); if (devDirty(app)) ui.text(x + w - 6, 7, 'RECORDS ARE OFF', { align: 'right', color: 'orange' });\n    ui.tabs('t', x + 3, 17, w - 6, TABS, this.tab, (i) => { this.tab = i; this.focus = null; this.page = 0; ui.box.ready = false; });\n    const fn = [this.sliders, this.race, this.view, this.weather, this.career, this.jump][this.tab]; fn.call(this, ui, x + 5, 33, w - 10);\n  }\n  btn(ui, id, x, y, w, label, fn, o = {}) { ui.button(id, x, y, w, 15, label, { ...o, confirm: fn }); }\n  sliders(ui, x, y, w) {\n    const app = this.app, pages = Math.ceil(SLIDERS.length / PER), list = SLIDERS.slice(this.page * PER, this.page * PER + PER);\n    list.forEach((s, k) => ui.slider(s.id, x, y + k * 18, w, 15, s.name, s.get(app), s.min, s.max, { step: s.step, set: (v) => { s.set(app, Math.round(v / s.step) * s.step); app.devDirty = devDirty(app); }, reset: () => { s.set(app, s.def); app.devDirty = devDirty(app); }, format: s.fmt ?? ((v) => v.toFixed(2)) }));\n    const by = y + PER * 18 + 2, bw = (w - 6) / 2;\n    this.btn(ui, 'pageNext', x, by, bw, `MORE SLIDERS ${this.page + 1}/${pages}`, () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; });\n    this.btn(ui, 'resetAll', x + bw + 6, by, bw, 'RESET ALL', () => this.resetAll());\n    ui.prompts([['moveX', 'ADJUST'], ['confirm', 'RESET ONE'], ['info', 'RESET ALL'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  onInfo() { if (this.tab === 0) this.resetAll(); }\n  resetAll() { const app = this.app, d = defaultEnv(); Object.assign(app.env, d); app.prizeMult = 1; app.devSliders = null; if (app.scene?.chase) { app.scene.chase.distance = null; app.scene.chase.fovBase = 58; } app.devDirty = false; app.ui.note('ALL SLIDERS AT THEIR DEFAULTS.'); }\n  race(ui, x, y, w) {\n    const app = this.app, s = app.scene, sim = s?.sim, bw = (w - 6) / 2;\n    if (!sim) { ui.lines(x + 2, y + 2, 'THESE TOOLS WORK DURING A DRIVE. OPEN DEV MODE FROM THE PAUSE MENU.', { chars: 50, color: 'mist' }); this.btn(ui, 'quick', x, y + 26, w, 'START A TEST RACE NOW', () => app.startQuick({ track: 'kestrel', carId: 'ginga', laps: 2, field: 6, difficulty: 'normal' })); ui.prompts([['confirm', 'CHOOSE'], ['tabs', 'TAB'], ['back', 'CLOSE']]); return; }\n    const me = s.focusE ?? sim.cars[0], L = sim.tr.length;\n    const f = ui.item('teleport', x, y, w, 15, { onX: (d) => { const k = (me.c.loc.s + d * 80 + L) % L; sim.teleport(me.i, k); s.chase?.snap(); app.mix.sfx('tick'); }, confirm: () => sim.teleport(me.i, 0) }); ui.rect(x, y, w, 15, f ? 'navy' : 'night'); ui.text(x + 6, y + 4, 'TELEPORT ALONG THE TRACK', { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 4, `< ${Math.round(me.c.loc.s)} M >`, { align: 'right', color: 'sand' });\n    const pos = this.finishPos ?? 1;\n    const f2 = ui.item('finish', x, y + 18, w, 15, { onX: (d) => { this.finishPos = Math.max(1, Math.min(sim.cars.length, pos + d)); }, confirm: () => { ui.pop(); ui.pop(); sim.finishNow(me.i, pos); } }); ui.rect(x, y + 18, w, 15, f2 ? 'navy' : 'night'); ui.text(x + 6, y + 22, 'FINISH NOW IN POSITION', { color: f2 ? 'white' : 'mist' }); ui.text(x + w - 6, y + 22, `< ${pos} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'end', x, y + 36, bw, 'END RACE', () => { ui.pop(); ui.pop(); sim.finishNow(me.i, sim.cars.length); });\n    this.btn(ui, 'restart', x + bw + 6, y + 36, bw, 'RESTART', () => app.restartRun(s));\n    this.btn(ui, 'reset', x, y + 54, bw, 'RESET CAR', () => sim.recover(me.i));\n    this.btn(ui, 'god', x + bw + 6, y + 54, bw, `GOD MODE: ${app.env.god ? 'ON' : 'OFF'}`, () => { app.env.god = !app.env.god; app.devDirty = devDirty(app); });\n    const cur = SCALES.indexOf(app.engine.timeScale);\n    const f3 = ui.item('scale', x, y + 72, w, 15, { onX: (d) => { const n = SCALES[Math.max(0, Math.min(SCALES.length - 1, (cur < 0 ? 2 : cur) + d))]; app.engine.timeScale = n; }, confirm: () => { app.engine.timeScale = 1; } }); ui.rect(x, y + 72, w, 15, f3 ? 'navy' : 'night'); ui.text(x + 6, y + 76, 'TIME SCALE', { color: f3 ? 'white' : 'mist' }); ui.text(x + w - 6, y + 76, `< ${app.engine.timeScale} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'frame', x, y + 90, bw, 'STEP ONE FRAME', () => { s.stepFrames = 1; });\n    this.btn(ui, 'saveState', x + bw + 6, y + 90, bw, 'SAVE STATE', () => { app.dev.savedState = sim.saveState(); ui.note('STATE SAVED.'); });\n    this.btn(ui, 'loadState', x, y + 108, bw, 'LOAD STATE', () => { if (app.dev.savedState) { sim.loadState(app.dev.savedState); s.chase?.snap(); ui.note('STATE LOADED.'); } else ui.note('NOTHING SAVED YET.'); });\n    this.btn(ui, 'changeCar', x + bw + 6, y + 108, bw, 'CHANGE CAR', () => { const d = s.data, i = d.cars.findIndex((c) => c.player === 0); if (i < 0) return; const n = CAR_IDS[(CAR_IDS.indexOf(d.cars[i].carId) + 1) % CAR_IDS.length], patch = { ...d, cars: d.cars.map((c, k) => (k === i ? { ...c, carId: n, install: null } : c)) }; app.restartWith(s, patch); });\n    ui.prompts([['confirm', 'DO IT'], ['moveX', 'ADJUST'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  view(ui, x, y, w) {\n    const app = this.app, o = app.dev.overlays, bw = (w - 6) / 2, tog = (id, label, on, fn, i) => this.btn(ui, id, x + (i % 2) * (bw + 6), y + Math.floor(i / 2) * 18, bw, `${label}: ${on ? 'ON' : 'OFF'}`, fn);\n    [['line', 'RACING LINE'], ['load', 'WHEEL LOAD, SLIP'], ['surface', 'SURFACE TINT'], ['circles', 'COLLISION CIRCLES'], ['ai', 'AI TARGETS'], ['telemetry', 'TELEMETRY']].forEach(([k, label], i) => tog(k, label, o[k], () => { o[k] = !o[k]; if (k === 'line' && app.scene) app.scene.lineOn = o[k]; }, i));\n    tog('freeCam', 'FREE CAMERA', app.dev.freeCam, () => { app.dev.freeCam = !app.dev.freeCam; if (app.dev.freeCam) app.dev.driveFreeCam = driveFreeCam; }, 6);\n    tog('panel', 'ENGINE DEBUG PANEL', !!app.engine.debugShown, () => app.engine.showDebug(!app.engine.debugShown), 7);\n    ui.prompts([['confirm', 'TOGGLE'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  weather(ui, x, y, w) {\n    const app = this.app, s = app.scene, d = s?.data, bw = (w - 6) / 2;\n    if (!d) { ui.lines(x + 2, y + 2, 'THE WEATHER CHANGES ONLY ON THE CIRCUIT. IT IS ALWAYS SOMETHING ON THE PENINSULA.', { chars: 50, color: 'mist' }); ui.prompts([['tabs', 'TAB'], ['back', 'CLOSE']]); this.btn(ui, 'attract', x, y + 28, w, 'START ATTRACT MODE NOW', () => app.attract?.start()); return; }\n    this.hour = this.hour ?? d.hour ?? 12;\n    const f = ui.item('hour', x, y, w, 15, { onX: (k) => { this.hour = (this.hour + k + 24) % 24; s.world?.setHourIf(this.hour); }, confirm: () => app.restartWith(s, { ...d, hour: this.hour }) }); ui.rect(x, y, w, 15, f ? 'navy' : 'night'); ui.text(x + 6, y + 4, 'HOUR OF DAY (CONFIRM RESTARTS WITH LAMPS)', { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 4, `< ${this.hour} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'rain', x, y + 18, bw, `RAIN: ${d.rain ? 'ON' : 'OFF'}`, () => app.restartWith(s, { ...d, rain: !d.rain }));\n    const n = d.cars.length;\n    const f2 = ui.item('fieldSize', x + bw + 6, y + 18, bw, 15, { onX: (k) => { this.field = Math.max(1, Math.min(8, (this.field ?? n) + k)); }, confirm: () => { const m = this.field ?? n, me = d.cars.filter((c) => c.player !== null && c.player !== undefined), others = d.cars.filter((c) => c.player === null || c.player === undefined); const pool = others.length ? others : [{ carId: me[0]?.carId ?? 'ginga', name: 'T. HOLLIS', skill: 0.9 }]; const list = []; for (let i = 0; i < m - me.length; i++) list.push({ ...pool[i % pool.length], name: `AI ${i + 1}` }); app.restartWith(s, { ...d, cars: [...list, ...me] }); } }); ui.rect(x + bw + 6, y + 18, bw, 15, f2 ? 'navy' : 'night'); ui.text(x + bw + 12, y + 22, `FIELD < ${this.field ?? n} >`, { color: f2 ? 'white' : 'mist' });\n    this.btn(ui, 'attract', x, y + 36, w, 'START ATTRACT MODE NOW', () => app.attract?.start());\n    ui.prompts([['confirm', 'APPLY'], ['moveX', 'ADJUST'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  career(ui, x, y, w) {\n    const app = this.app, p = app.profile, bw = (w - 6) / 2;\n    this.btn(ui, 'credits', x, y, bw, 'GIVE 100,000 CR', () => { p.credits += 100000; app.save(); ui.note('100,000 CR GIVEN.'); });\n    this.btn(ui, 'cars', x + bw + 6, y, bw, 'UNLOCK ALL CARS', () => { for (const id of CAR_IDS) if (!p.cars.some((c) => c.carId === id)) addCar(p, id, { prize: CAR_INFO[id].where === 'prize' }); if (p.current === null) p.current = p.cars[0].uid; app.save(); ui.note('ALL FOURTEEN IN THE GARAGE.'); });\n    this.btn(ui, 'gold', x, y + 18, bw, 'ALL TESTS AT GOLD', () => { for (const id of TEST_IDS) recordTest(p, id, TESTS[id].medals.gold - 0.01); app.save(); ui.note('EVERY LICENCE HELD, AT GOLD.'); });\n    this.btn(ui, 'winEvent', x + bw + 6, y + 18, bw, 'WIN THE CURRENT EVENT', () => { const id = app.scene?.data?.event ?? EVENT_IDS.find((k) => !p.events[k]?.won) ?? 'gp', e = EVENTS[id]; let last = null; const st = eventState(p, id); for (let i = st.round; i < e.rounds.length; i++) last = recordRound(p, id, ['YOU', 'R. OKADA'], 'YOU'); app.save(); ui.note(`${e.name} WON${last?.prizeCar ? `: ${CAR_INFO[last.prizeCar].short}` : ''}.`); });\n    this.btn(ui, 'resetSave', x, y + 36, w, 'RESET THE SAVE', () => { app.profile = newProfile(); app.save(); if (app.profile && app.toTitle) app.toTitle(); });\n    ui.text(x + 2, y + 56, `CREDITS ${p.credits.toLocaleString('en-US')}`, { color: 'mist' }); ui.text(x + 2, y + 66, `CURRENT CAR ${carEntry(p) ? CAR_INFO[carEntry(p).carId].short : 'NONE'}`, { color: 'mist' });\n    ui.prompts([['confirm', 'DO IT'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n    void LICENCE_ORDER; void LICENCES;\n  }\n  jump(ui, x, y, w) {\n    const app = this.app; const list = [...EVENT_IDS.map((id) => ({ id: `ev-${id}`, label: `EVENT: ${EVENTS[id].name}`, go: () => app.startEventRound(id) })), ...TEST_IDS.map((id) => ({ id: `t-${id}`, label: `TEST ${id}: ${TESTS[id].title}`, go: () => app.startTest(id) })), ...['map', 'dealer', 'tuning', 'service', 'garage', 'museum', 'theatre', 'arcade'].map((id) => ({ id: `m-${id}`, label: `MENU: ${id.toUpperCase()}`, go: () => app.jumpMenu(id) }))];\n    const pages = Math.ceil(list.length / PER); list.slice(this.page * PER, this.page * PER + PER).forEach((it, k) => this.btn(ui, it.id, x, y + k * 18, w, it.label, () => { if (app.profile.cars.length === 0 && !it.id.startsWith('m-')) addCar(app.profile, 'kite'); ui.clear(); it.go(); }, { left: true }));\n    this.btn(ui, 'pageNext', x, y + PER * 18 + 2, w, `MORE ${this.page + 1}/${pages}`, () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; });\n    ui.prompts([['confirm', 'GO'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n}\nconst FV = new Vector3();\nfunction driveFreeCam(ctx, dt, cam) { // WASD or the left stick moves, the right stick or a right drag looks\n  const input = ctx.input, a = FV; this._y = this._y ?? 0;\n  let mx = 0, mz = 0, my = 0, lx = 0, ly = 0;\n  if (input.isDown('KeyW') || input.isDown('ArrowUp')) mz += 1; if (input.isDown('KeyS') || input.isDown('ArrowDown')) mz -= 1; if (input.isDown('KeyA') || input.isDown('ArrowLeft')) mx -= 1; if (input.isDown('KeyD') || input.isDown('ArrowRight')) mx += 1; if (input.isDown('KeyE')) my += 1; if (input.isDown('KeyQ')) my -= 1;\n  const app = ctx.engine.game?.app; for (const p of app?.actions.pads ?? []) { mx += p.axes[0]; mz -= p.axes[1]; lx += p.axes[2]; ly += p.axes[3]; }\n  if (input.isDown('MouseRight')) { lx += (input.mouseDelta.x ?? 0) * 0.3; ly += (input.mouseDelta.y ?? 0) * 0.3; }\n  cam.rotation.order = 'YXZ'; cam.rotation.y -= lx * dt * 2; cam.rotation.x = Math.max(-1.4, Math.min(1.4, cam.rotation.x - ly * dt * 2));\n  a.set(mx, my, -mz).multiplyScalar(dt * 24).applyEuler(cam.rotation); cam.position.add(a);\n}\nconst P = new Vector3();\n// Overlays, drawn over the HUD.\nexport function drawOverlays(ui, app, scene) {\n  const dev = app.dev; if (!dev) return; const o = dev.overlays, sim = scene.sim, cam = scene.cam, me = scene.focusE; if (!sim || !me) return;\n  const project = (x, y, z) => { P.set(x, y, z).project(cam); return P.z < 1 ? [(P.x + 1) * 0.5 * ui.w, (1 - P.y) * 0.5 * ui.h] : null; };\n  const c = me.c;\n  if (o.load) { const bx = ui.w - 96, by = 60; ui.panel(bx - 3, by - 3, 96, 52, { color: 'ink', border: false, scan: true }); for (let i = 0; i < 4; i++) { const load = c.fz[i] / (c.p.mass * 9.81 * 0.5), slip = Math.min(1.6, c.use[i]) / 1.6; ui.text(bx, by + i * 12, ['FL', 'FR', 'RL', 'RR'][i], { color: 'mist' }); ui.bar(bx + 16, by + i * 12, 34, 4, load, 'sky', 'night'); ui.bar(bx + 54, by + i * 12, 34, 4, slip, slip > 0.8 ? 'red' : 'lime', 'night'); } }\n  if (o.surface) { const col = { asphalt: 'slate', kerb: 'red', grass: 'green', gravel: 'orange', dirt: 'orange', apron: 'mist' }[c.surface] ?? 'white'; ui.rect(0, 0, ui.w, 2, col); ui.rect(0, ui.h - 2, ui.w, 2, col); ui.text(ui.cx, 8, `SURFACE: ${c.surface.toUpperCase()}`, { align: 'center', color: col }); }\n  if (o.circles) for (const e of sim.cars) { for (const off of [-1.35, 0, 1.35]) { const cx = e.c.x + Math.sin(e.c.yaw) * off, cz = e.c.z + Math.cos(e.c.yaw) * off; for (let a = 0; a < 12; a++) { const t = (a / 12) * 6.283, q = project(cx + Math.sin(t) * 0.875, e.c.y + 0.3, cz + Math.cos(t) * 0.875); if (q) ui.rect(q[0], q[1], 1, 1, e === me ? 'lime' : 'red'); } } }\n  if (o.ai) for (const e of sim.cars) { if (e.player !== null && !e.autoDrive) continue; const u = Math.hypot(e.c.vx, e.c.vz), idx = (e.c.loc.i + Math.round(Math.max(7, u * 0.62) / sim.tr.ds)) % sim.tr.N, tr = sim.tr, rx = -tr.tz[idx], rz = tr.tx[idx], lane = e.c.laneNow ?? 0, q = project(sim.line.px[idx] + rx * lane, tr.y[idx] + 0.3, sim.line.pz[idx] + rz * lane); if (q) { ui.rect(q[0] - 1, q[1] - 1, 3, 3, 'cyan'); } const n = project(e.c.x, e.c.y + 1.7, e.c.z); if (n) ui.text(n[0], n[1] - 8, `${(e.speeds[e.c.loc.i] * 3.6).toFixed(0)}`, { align: 'center', color: 'cyan' }); }\n  if (o.line) { const i = c.loc.i; ui.text(ui.cx, 16, `LINE WANTS ${(me.speeds[i] * 3.6).toFixed(0)} KM/H`, { align: 'center', color: 'lime' }); }\n  if (o.telemetry) {\n    const T = dev.tele; T.push([Math.abs(c.u) / 90, me.inp?.throttle ?? 0, me.inp?.brake ?? 0, 0.5 + c.ax / 40, 0.5 + c.ay / 40]); if (T.length > 200) T.shift();\n    const x0 = ui.cx - 100, y0 = ui.h - 52, H = 26; ui.panel(x0 - 2, y0 - 2, 204, H + 4, { color: 'ink', border: false }); const cols = ['white', 'lime', 'red', 'sky', 'sand']; T.forEach((v, k) => { for (let n = 0; n < 5; n++) ui.rect(x0 + k, y0 + H - Math.round(Math.max(0, Math.min(1, v[n])) * H), 1, 1, cols[n]); });\n    ui.text(x0, y0 - 10, 'SPD THR BRK AX AY', { color: 'mist' });\n  }\n  void trackPoint;\n}\n","numLines":135,"startLine":1,"totalLines":135}},"tool_result_meta":[{"id":"toolu_01CRzdDm73iTbPPQWwvcdWfo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
