{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmZyqrTJJPSPJRqyEMw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015zkAxLFREECNgz4DCCpzHi","name":"Bash","input":{"command":"head -3 src/LICENSE; sed -i \"s/'PIXEL ENGINE 0.46.0, BY MICHAEL CROSATO AND CONTRIBUTORS (MIT).'/'PIXEL ENGINE 0.46.0, THE RIFTLIGHT ENGINE KIT. SEE ITS LICENCE IN THE KIT CREDITS.'/\" src/game/data/about.js\ncat > src/game/ui/screens/licence.js <<'EOF'\n// The Licence Centre: three licences, four tests each, a card for each test, and a result after each attempt.\nimport { LICENCE_ORDER, LICENCES, TESTS } from '../../data/licences.js';\nimport { CAR_INFO } from '../../data/cars.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { LINES } from '../../data/text.js';\nimport { licenceOpen, testRecord } from '../../sim/career.js';\nimport { formatTime } from '../../sim/race.js';\nimport { cr, MEDAL_NAME, medalIcon, statusStrip } from './common.js';\nconst stageIt = (app) => { const s = app.scene; s?.stage?.('licence', { person: 'arai', personClip: 'ExaminerClipboard', personAt: [-3.4, 0, -0.6], personYaw: 0.6, orbit: false, angle: 0.25, radius: 11, height: 3, lookX: -2.2, lookY: 1.2, lookZ: -1 }); app.mix.music('exam'); };\nexport class LicenceListScreen {\n  constructor(app) { this.id = 'licenceList'; this.app = app; }\n  enter(ui) { stageIt(this.app); if (!this.app.profile.tests['C-1']) ui.say('arai', LINES.arai.idle); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, p = app.profile; statusStrip(ui, app); ui.text(10, 20, 'LICENCE CENTRE', { scale: 2, color: 'sand' });\n    const w = Math.min(ui.w - 20, 220), x = ui.w - w - 10;\n    LICENCE_ORDER.forEach((id, k) => {\n      const l = LICENCES[id], open = licenceOpen(p, id), medals = l.tests.map((t) => p.tests[t]?.medal), y = 44 + k * 58, h = 52;\n      const f = ui.item(id, x, y, w, h, open ? { confirm: () => ui.push(new TestListScreen(app, id)) } : { denied: () => ui.note(`THE ${LICENCES[l.needs].name} LICENCE COMES FIRST.`) });\n      ui.rect(x, y, w, h, open ? (f ? 'navy' : 'night') : 'ink');\n      ui.text(x + 8, y + 6, `${id}: ${l.name}`, { color: open ? 'sand' : 'slate' }); ui.text(x + 8, y + 17, l.line, { color: open ? 'white' : 'slate' });\n      medals.forEach((m, i) => medalIcon(ui, x + 8 + i * 13, y + 30, m));\n      ui.text(x + w - 8, y + 32, p.licences[id] ? 'HELD' : `REWARD ${cr(l.reward)}`, { align: 'right', color: p.licences[id] ? 'lime' : 'mist' });\n    });\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'MAP']]);\n  }\n}\nexport class TestListScreen {\n  constructor(app, lic) { this.id = 'testList'; this.app = app; this.lic = lic; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, l = LICENCES[this.lic], p = app.profile; statusStrip(ui, app);\n    ui.text(10, 20, `LICENCE ${l.id}`, { scale: 2, color: 'sand' }); ui.text(10, 38, l.name, { color: 'mist' });\n    const w = Math.min(ui.w - 20, 230), x = ui.w - w - 10;\n    l.tests.forEach((id, k) => {\n      const t = TESTS[id], rec = p.tests[id], y = 34 + k * 44, h = 39, f = ui.item(id, x, y, w, h, { confirm: () => ui.push(new TestCardScreen(app, id)) });\n      ui.rect(x, y, w, h, f ? 'navy' : 'night'); medalIcon(ui, x + 7, y + 6, rec?.medal);\n      ui.text(x + 22, y + 6, `${id} ${t.title}`, { color: 'white' }); ui.text(x + 22, y + 17, t.lesson, { color: 'mist' });\n      ui.text(x + 22, y + 27, rec?.best ? `BEST ${formatTime(rec.best)}` : 'NOT ATTEMPTED', { color: rec?.best ? 'sand' : 'slate' });\n    });\n    if (l.allGold) { ui.text(10, ui.h - 42, 'ALL GOLD:', { color: 'sand' }); ui.text(10, ui.h - 32, l.allGold.text.slice(0, 40), { color: 'mist' }); }\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\nexport class TestCardScreen {\n  constructor(app, id) { this.id = 'testCard'; this.app = app; this.test = TESTS[id]; }\n  enter(ui) { stageIt(this.app); ui.say('arai', this.test.brief.join(' '), 8); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, t = this.test, rec = app.profile.tests[t.id], m = t.medals, w = Math.min(ui.w - 20, 300), x = ui.w - w - 10, y = 18, offer = (rec?.fails ?? 0) >= 3;\n    ui.panel(x, y, w, 196, { color: 'ink', border: 'slate' });\n    ui.text(x + 8, y + 6, t.id, { color: 'slate' }); ui.text(x + 8, y + 15, t.title, { scale: 2, color: 'sand' });\n    ui.text(x + 8, y + 36, `${t.legs ? t.legs.map((c) => CAR_INFO[c].short).join(', ') : CAR_INFO[t.carId].name}`, { color: 'white' }); ui.text(x + 8, y + 46, TRACKS[t.track].name.toUpperCase(), { color: 'mist' });\n    ui.lines(x + 8, y + 60, t.brief, { gap: 10 });\n    const my = y + 96; for (const [k, name, col] of [[0, 'gold', 'sand'], [1, 'silver', 'mist'], [2, 'bronze', 'orange']]) { medalIcon(ui, x + 8, my + k * 11 - 1, name); ui.text(x + 22, my + k * 11, formatTime(m[name]), { color: col }); }\n    ui.text(x + w - 8, my, 'YOUR BEST', { align: 'right', color: 'slate' }); ui.text(x + w - 8, my + 11, rec?.best ? formatTime(rec.best) : '--', { align: 'right' }); if (rec?.medal) ui.text(x + w - 8, my + 22, MEDAL_NAME[rec.medal], { align: 'right', color: 'sand' });\n    if (t.assists) ui.text(x + 8, my + 34, Object.entries(t.assists).map(([k, v]) => `${k.toUpperCase()} ${v === false || v === 0 ? 'OFF' : v}`).join('  '), { color: 'red' });\n    if (offer) ui.text(x + 8, my + 44, LINES.arai.offerLine.slice(0, 50), { color: 'lime' });\n    const by = y + 170, bw = Math.floor((w - 22) / 3);\n    ui.button('start', x + 6, by, bw, 18, 'BEGIN', { confirm: () => app.startTest(t.id) });\n    ui.button('demo', x + 11 + bw, by, bw, 18, 'DEMONSTRATION', { confirm: () => app.startTest(t.id, { demo: true }) });\n    ui.button('line', x + 16 + bw * 2, by, bw, 18, app.options.assists.line || this.line ? 'LINE: ON' : 'LINE: OFF', { confirm: () => { this.line = !this.line; app.lineForTest = this.line; }, disabled: !offer && !app.options.assists.line, denied: offer ? null : () => ui.note('THE EXAMINER WILL OFFER THIS AFTER THREE ATTEMPTS.') });\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\n// After each attempt: medal, time, gap to the next medal; Retry, Watch your replay, Demonstration, Back.\nexport class TestResultScreen {\n  constructor(app, o) { this.id = 'testResult'; this.app = app; this.o = o; this.t = 0; }\n  enter(ui) { const o = this.o, lines = LINES.arai, list = o.failed ? lines.fail : (lines[o.medal] ?? lines.fail); ui.say('arai', list[(o.time ? Math.round(o.time * 7) : 3) % list.length]); this.app.mix.sfx(o.medal ? 'medal' : 'denied'); if (o.licenceWon) this.app.mix.sfx('fanfare2'); }\n  draw(ui, dt) {\n    const app = this.app, o = this.o, t = o.test, w = Math.min(ui.w - 40, 280), h = 140, x = Math.round(ui.cx - w / 2), y = 40; this.t += dt;\n    ui.panel(x, y, w, h, { color: 'ink', border: o.medal ? 'sand' : 'red' });\n    ui.text(ui.cx, y + 7, `${t.id} ${t.title}`, { align: 'center', color: 'mist' });\n    if (o.failed) { ui.text(ui.cx, y + 22, 'NOT PASSED', { align: 'center', scale: 2, color: 'red' }); ui.text(ui.cx, y + 44, o.reason, { align: 'center' }); }\n    else {\n      if (o.medal) { medalIcon(ui, ui.cx - 4, y + 19, o.medal); ui.text(ui.cx, y + 31, MEDAL_NAME[o.medal], { align: 'center', scale: 2, color: 'sand' }); }\n      else ui.text(ui.cx, y + 22, 'NO MEDAL', { align: 'center', scale: 2, color: 'red' });\n      ui.text(ui.cx, y + 50, formatTime(o.time), { align: 'center', scale: 2 });\n      if (o.next) ui.text(ui.cx, y + 70, `${(o.time - t.medals[o.next]).toFixed(2)} S FROM ${MEDAL_NAME[o.next]}`, { align: 'center', color: 'mist' });\n    }\n    if (o.licenceWon) ui.text(ui.cx, y + 82, `LICENCE ${LICENCES[t.licence].name} EARNED. +${cr(o.reward)}`, { align: 'center', color: 'lime' });\n    else if (o.prizeCar) ui.text(ui.cx, y + 82, `ALL GOLD. PRIZE: ${CAR_INFO[o.prizeCar].name}`, { align: 'center', color: 'lime' });\n    else if (o.notSaved) ui.text(ui.cx, y + 82, 'NOT RECORDED: DEV SLIDERS ARE OFF THEIR DEFAULTS', { align: 'center', color: 'red' });\n    const by = y + h - 40, bw = Math.floor((w - 18) / 2);\n    ui.button('retry', x + 6, by, bw, 15, 'RETRY', { confirm: () => app.startTest(t.id) });\n    ui.button('replay', x + 12 + bw, by, bw, 15, 'WATCH YOUR REPLAY', { confirm: () => app.watchReplay({ after: () => app.afterTestReplay(this.o) }) });\n    ui.button('demo', x + 6, by + 18, bw, 15, 'DEMONSTRATION', { confirm: () => app.startTest(t.id, { demo: true }) });\n    ui.button('backTo', x + 12 + bw, by + 18, bw, 15, 'BACK', { confirm: () => app.backToTests(t.id, this.o) });\n    if (!this.focus) this.focus = o.medal && !o.failed ? 'backTo' : 'retry';\n    ui.prompts([['confirm', 'CHOOSE']]);\n  }\n  onBack() { this.app.backToTests(this.o.test.id, this.o); return true; }\n}\nvoid testRecord;\nEOF\ncat > src/game/ui/screens/events.js <<'EOF'\n// The Event Hall: events by licence tier, a card for each event, a card for each round, then the green light.\nimport { EVENT_IDS, EVENTS, TIERS } from '../../data/events.js';\nimport { LICENCES } from '../../data/licences.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { CAR_INFO } from '../../data/cars.js';\nimport { carEntry, eligible, eventOpen, eventState, standingsOf } from '../../sim/career.js';\nimport { cr, miniMap, statusStrip } from './common.js';\nconst stageIt = (app) => { app.scene?.stage?.('events', { orbit: false, angle: -0.25, radius: 13, height: 4, lookY: 2, lookX: -2, lookZ: -3, sun: 0.7 }); app.mix.music('lounge'); };\nexport class EventListScreen {\n  constructor(app) { this.id = 'eventList'; this.app = app; this.tab = app.profile.licences.A ? 2 : app.profile.licences.B ? 1 : 0; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, p = app.profile; statusStrip(ui, app); ui.text(10, 20, 'EVENT HALL', { scale: 2, color: 'sand' });\n    const w = Math.min(ui.w - 20, 270), x = ui.w - w - 10;\n    ui.tabs('tier', x, 20, w, TIERS.map((t) => LICENCES[t].name), this.tab, (i) => { this.tab = i; this.focus = null; ui.box.ready = false; });\n    const tier = TIERS[this.tab], list = EVENT_IDS.filter((id) => EVENTS[id].needs[0] === tier);\n    list.forEach((id, k) => {\n      const e = EVENTS[id], st = p.events[id], open = eventOpen(p, id), y = 38 + k * 44, h = 39, f = ui.item(id, x, y, w, h, open.ok ? { confirm: () => ui.push(new EventCardScreen(app, id)) } : { denied: () => ui.note(open.why) });\n      ui.rect(x, y, w, h, open.ok ? (f ? 'navy' : 'night') : 'ink');\n      ui.text(x + 7, y + 6, e.name, { color: open.ok ? 'white' : 'slate' });\n      ui.text(x + 7, y + 17, open.ok ? e.restriction : open.why, { color: open.ok ? 'mist' : 'red' });\n      ui.text(x + 7, y + 28, st?.won ? 'WON' : st?.round ? `ROUND ${st.round + 1}/${e.rounds.length}` : `${e.rounds.length} ROUND${e.rounds.length > 1 ? 'S' : ''}`, { color: st?.won ? 'lime' : st?.round ? 'sand' : 'slate' });\n      ui.text(x + w - 7, y + 28, e.prizeCar ? CAR_INFO[e.prizeCar].short : cr(e.bonus), { align: 'right', color: 'sand' });\n    });\n    ui.prompts([['confirm', 'CHOOSE'], ['tabs', 'TIER'], ['back', 'MAP']]);\n  }\n}\nexport class EventCardScreen {\n  constructor(app, id) { this.id = 'eventCard'; this.app = app; this.eventId = id; this.event = EVENTS[id]; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, e = this.event, p = app.profile, st = eventState(p, this.eventId), car = carEntry(p), ok = car ? eligible(e, car.carId, car.install) : { ok: false, why: 'YOU HAVE NO CAR' }, w = Math.min(ui.w - 20, 340), x = Math.round(ui.cx - w / 2);\n    statusStrip(ui, app); ui.panel(x, 19, w, 204, { color: 'ink', border: 'slate' });\n    ui.text(x + 8, 24, e.name, { color: 'sand' }); ui.lines(x + 8, 35, e.intro, { chars: Math.floor((w - 16) / 6), gap: 9, color: 'mist' });\n    ui.text(x + 8, 57, `RESTRICTION: ${e.restriction}`);\n    ui.text(x + 8, 67, `1ST PRIZE ${cr(e.prize)}`, { color: 'mist' }); ui.text(x + w - 8, 67, e.prizeCar ? `SERIES: ${CAR_INFO[e.prizeCar].short}` : `SERIES: ${cr(e.bonus)}`, { align: 'right', color: 'sand' });\n    // Rounds with mini-maps.\n    const n = e.rounds.length, cw = Math.floor((w - 16) / n);\n    e.rounds.forEach((r, k) => { const cx = x + 8 + k * cw, next = k === st.round; ui.rect(cx, 80, cw - 3, 56, next ? 'navy' : 'night'); miniMap(ui, cx + 3, 83, r.track, 30, next ? 'sand' : 'mist'); ui.text(cx + 3, 118, `${TRACKS[r.track].name.split(' ')[0].toUpperCase().slice(0, Math.floor((cw - 8) / 6))}`, { color: 'white' }); ui.text(cx + 3, 127, `${r.laps} LAPS${r.rain ? ' RAIN' : r.hourEnd ? ' NIGHT' : ''}`, { color: 'mist' }); });\n    const stand = standingsOf(p, this.eventId); if (stand.length) { const pos = stand.findIndex(([n2]) => n2 === 'YOU') + 1; ui.text(x + 8, 140, `STANDINGS: YOU ARE ${pos} OF ${stand.length} WITH ${stand[pos - 1]?.[1] ?? 0} POINTS.`, { color: 'sand' }); }\n    ui.text(x + 8, 152, `YOUR CAR: ${car ? CAR_INFO[car.carId].short : 'NONE'}`); if (!ok.ok) ui.text(x + 8, 162, `IT DOES NOT QUALIFY: ${ok.why}`, { color: 'red' }); else if (e.rally && car && car.install.tyre !== 'rally') ui.text(x + 8, 162, 'DIRT TYRES ARE ADVISED. TUNING STREET HAS THEM.', { color: 'orange' }); else ui.text(x + 8, 162, 'IT QUALIFIES.', { color: 'lime' });\n    const by = 186, bw = Math.floor((w - 22) / 3);\n    ui.button('start', x + 6, by, bw, 18, st.round ? `ROUND ${st.round + 1}` : 'ENTER', { confirm: () => ui.push(new RoundCardScreen(app, this.eventId)), denied: ok.ok ? null : () => ui.note(`THE CAR DOES NOT QUALIFY. ${ok.why}`) });\n    ui.button('garage', x + 11 + bw, by, bw, 18, 'CHANGE CAR', { confirm: () => app.openGarageFromEvent(ui) });\n    ui.button('tune', x + 16 + bw * 2, by, bw, 18, 'TUNING STREET', { confirm: () => app.openTuningFromEvent(ui) });\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\nexport class RoundCardScreen {\n  constructor(app, id) { this.id = 'roundCard'; this.app = app; this.eventId = id; this.event = EVENTS[id]; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, e = this.event, st = eventState(app.profile, this.eventId), r = e.rounds[st.round], def = TRACKS[r.track], w = Math.min(ui.w - 20, 300), x = Math.round(ui.cx - w / 2), hour = r.hour ?? def.hour;\n    ui.panel(x, 30, w, 160, { color: 'ink', border: 'sand' });\n    ui.text(ui.cx, 36, `ROUND ${st.round + 1} OF ${e.rounds.length}`, { align: 'center', color: 'mist' });\n    ui.text(ui.cx, 47, def.name.toUpperCase(), { align: 'center', scale: 2, color: 'sand' });\n    const m = miniMap(ui, x + 12, 72, r.track, 72, 'white');\n    ui.text(x + 100, 74, `${r.laps} LAPS`); ui.text(x + 100, 85, `${(m.length / 1000).toFixed(2)} KM`, { color: 'mist' }); ui.text(x + 100, 96, `${m.corners} CORNERS`, { color: 'mist' }); ui.text(x + 100, 107, `${String(Math.floor(hour)).padStart(2, '0')}:${hour % 1 ? '30' : '00'}${r.rain ? ', RAIN' : ''}`, { color: r.rain ? 'sky' : 'mist' }); ui.text(x + 100, 118, e.rally ? 'ONE RIVAL. THE CLOCK DECIDES.' : `FIELD OF ${e.field}. ROLLING START.`, { color: 'mist' });\n    if (e.endurance) ui.text(x + 100, 129, 'ONE STOP NEEDED. KEEP RIGHT TO PIT.', { color: 'sand' });\n    ui.button('go', ui.cx - 60, 164, 120, 18, 'TO THE START', { confirm: () => app.startEventRound(this.eventId) });\n    ui.prompts([['confirm', 'RACE'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/game/ui/screens/dealer.js <<'EOF'\n// Dealer Row: the used lot and three showrooms. Turntable under lamps, slow orbit, the attendant's voice.\nimport { CAR_INFO, MARQUES, SHOWROOMS } from '../../data/cars.js';\nimport { LINES } from '../../data/text.js';\nimport { buyCar, carPriceOpen } from '../../sim/career.js';\nimport { cr, specCard, statusStrip } from './common.js';\nexport class DealerScreen {\n  constructor(app, o = {}) { this.id = 'dealer'; this.app = app; this.room = 0; this.car = 0; this.o = o; this.brochure = false; this.noBack = !!o.first; }\n  enter(ui) { this.show(); this.app.mix.music('catalogue'); ui.say('fenn', LINES.fenn.hello); }\n  resume() { this.show(); this.app.mix.music('catalogue'); }\n  get list() { return SHOWROOMS[this.room].cars; }\n  show(sound = false) { const app = this.app, id = this.list[this.car % this.list.length]; app.scene?.stage?.('showroom', { showroom: this.room, car: { carId: id, install: null }, person: 'fenn', personClip: 'DealerPresent', personAt: [-4.6, 0, 1.8], personYaw: 1.1, radius: 7.8, height: 2.5 }); this.brochure = false; if (sound) { app.mix.sfx('whirr'); const line = CAR_INFO[id].fenn; app.ui.say('fenn', line); app.profile.seen[id] = true; } }\n  next(d) { this.car = (this.car + d + this.list.length) % this.list.length; this.show(true); }\n  nextRoom(d) { this.room = (this.room + d + SHOWROOMS.length) % SHOWROOMS.length; this.car = 0; this.show(true); }\n  draw(ui) {\n    const app = this.app, p = app.profile, room = SHOWROOMS[this.room], id = this.list[this.car % this.list.length], i = CAR_INFO[id], open = carPriceOpen(p, id), can = open && p.credits >= i.price, owned = p.cars.some((c) => c.carId === id);\n    statusStrip(ui, app); ui.text(10, 19, room.name, { color: 'sand', scale: 2 }); ui.text(10, 37, room.line, { color: 'mist' });\n    const w = 150, x = ui.w - w - 8; let y = 20;\n    const foot = open ? cr(i.price) : i.after ? `AFTER LICENCE ${i.after}` : 'NOT FOR SALE';\n    y += specCard(ui, x, y, w, id, null, { foot, footColor: can ? 'sand' : 'red' }) + 4;\n    if (owned) ui.text(x + w, y, 'YOU OWN ONE', { align: 'right', color: 'lime' });\n    if (this.brochure) { const lines = i.text, bw = Math.min(ui.w - 16, 340), bx = 8, by = ui.h - 36 - 16 - lines.length * 10; ui.panel(bx, by, bw, 14 + lines.length * 10 + 2, { color: 'ink', border: 'sand' }); ui.text(bx + 6, by + 3, MARQUES[i.marque].name, { color: 'sand' }); lines.forEach((l, k) => ui.text(bx + 6, by + 13 + k * 10, l)); }\n    // A dot per car.\n    this.list.forEach((c, k) => ui.rect(10 + k * 8, 48, 6, 3, k === this.car ? 'sand' : 'slate'));\n    const by = ui.h - 36;\n    const buy = () => { const r = buyCar(p, id); if (!r.ok) { app.mix.sfx('denied'); ui.say('fenn', r.why === 'money' ? LINES.fenn.poor : LINES.fenn.lowLicence); return; } app.save(); app.mix.sfx('register'); ui.say('fenn', LINES.fenn.bought); if (app.scene?.car) app.scene.car.settle = 0.16; if (this.o.first) { this.o.first = false; this.noBack = false; ui.note('A CAR. THE MAP IS OPEN.'); } };\n    ui.item('car', 8, by, 110, 16, { noBox: false, confirm: buy, onX: (d) => this.next(d), denied: can ? null : () => { app.mix.sfx('denied'); ui.say('fenn', open ? LINES.fenn.poor : LINES.fenn.lowLicence); } });\n    ui.rect(8, by, 110, 16, ui.focused('car') ? 'navy' : 'night'); ui.text(63, by + 5, can ? `BUY FOR ${cr(i.price)}` : open ? 'TOO DEAR FOR NOW' : 'NOT YET', { align: 'center', color: can ? 'white' : 'slate' });\n    ui.prompts([['confirm', 'BUY'], ['moveX', 'NEXT CAR'], ['tabs', 'SHOWROOM'], ['info', 'BROCHURE'], ['alt', 'TEST DRIVE'], ['back', 'MAP']]);\n    if (app.actions.pressed('tabL')) this.nextRoom(-1); if (app.actions.pressed('tabR')) this.nextRoom(1);\n  }\n  onInfo() { this.brochure = !this.brochure; this.app.mix.sfx('tick'); }\n  onAlt() { const id = this.list[this.car % this.list.length]; this.app.startTestDrive(id, null, { from: 'dealer', room: this.room, car: this.car, first: this.o.first }); }\n  onBack(ui) { if (this.o.first && !this.app.profile.cars.length) { this.app.mix.sfx('denied'); ui.note('YOU WILL NEED A CAR FIRST.'); return false; } ui.pop(); return true; }\n}\nEOF\ncat > src/game/ui/screens/tuning.js <<'EOF'\n// Tuning Street: eight tiles, four to a page; then the parts in a tile, with an effect in plain words and a before/after number.\n// A Setup tab holds the sliders for what you own. Buying an engine part shows a dyno pull.\nimport { CAR_INFO } from '../../data/cars.js';\nimport { PAINT_PRICE, PART_IDS, PARTS, RIM_PRICE, SETUP_SLIDERS, TILES } from '../../data/parts.js';\nimport { LINES } from '../../data/text.js';\nimport { TYRE_IDS, TYRES } from '../../data/tyres.js';\nimport { PAINTS, RIM_STYLES } from '../../data/meta.js';\nimport { buyPaint, buyPart, buyRims, buyTyre, carEntry, setSetup } from '../../sim/career.js';\nimport { dynoCurve, hasPart, setupValue, sliderAvailable, specOf } from '../../sim/tuning.js';\nimport { engineData } from '../../audio/mix.js';\nimport { cr, specCard, statusStrip } from './common.js';\nconst stageIt = (app, car) => { app.scene?.stage?.('bay', { car: { carId: car.carId, install: car.install, dirt: car.dirt, y: 0.08 }, person: 'benno', personClip: 'MechanicWipe', personAt: [4.6, 0, 0.8], personYaw: -1.2, radius: 7.8, height: 2.3, sun: 0.7 }); app.mix.music('socket'); };\nconst SAY = { engine: 'engine', weight: 'weight', tyres: 'tyres', brakes: 'brakes', suspension: 'susp', drivetrain: 'drive', body: 'body' };\nexport class TuningScreen {\n  constructor(app) { this.id = 'tuning'; this.app = app; this.tab = 0; this.page = 0; }\n  enter(ui) { const c = carEntry(this.app.profile); stageIt(this.app, c); ui.say('benno', LINES.benno.hello); }\n  resume() { stageIt(this.app, carEntry(this.app.profile)); }\n  draw(ui) {\n    const app = this.app, car = carEntry(app.profile); statusStrip(ui, app);\n    ui.text(10, 19, 'TUNING STREET', { scale: 2, color: 'sand' });\n    const w = 150, x = ui.w - w - 8; specCard(ui, x, 20, w, car.carId, car.install, { extra: [['GRIP', (specOf(car.carId, car.install).tyreMu).toFixed(2)], ['DOWNFORCE', (specOf(car.carId, car.install).clA).toFixed(2)]] });\n    const lw = Math.min(ui.w - w - 26, 170), lx = 8;\n    ui.tabs('t', lx, 38, lw, ['PARTS', 'SETUP'], this.tab, (i) => { this.tab = i; this.focus = null; ui.box.ready = false; });\n    if (this.tab === 0) {\n      const pages = 2, list = TILES.slice(this.page * 4, this.page * 4 + 4);\n      list.forEach((t, k) => { const tw = (lw - 4) / 2, xx = lx + (k % 2) * (tw + 4), yy = 54 + Math.floor(k / 2) * 52, f = ui.item(t.id, xx, yy, tw, 48, { confirm: () => ui.push(new PartsScreen(app, t.id)) }); ui.rect(xx, yy, tw, 48, f ? 'navy' : 'night'); ui.text(xx + 5, yy + 6, t.name, { color: f ? 'sand' : 'white' }); ui.lines(xx + 5, yy + 17, t.line, { chars: Math.floor((tw - 10) / 6), gap: 9, color: 'mist' }); });\n      const nav = (d) => { this.page = (this.page + d + pages) % pages; this.focus = null; ui.box.ready = false; };\n      ui.button('more', lx, 160, lw, 14, this.page === 0 ? 'MORE: TILES 5 TO 8' : 'BACK TO TILES 1 TO 4', { confirm: () => nav(1) });\n    } else {\n      const sliders = SETUP_SLIDERS.filter((s) => sliderAvailable(car.install, s));\n      if (!sliders.length) ui.lines(lx + 4, 60, 'NOTHING TO SET YET. BUY A RACE GEARBOX, AN LSD, SUSPENSION, RACE BRAKES OR A WING, AND THE SETTING APPEARS HERE.', { chars: Math.floor((lw - 8) / 6), gap: 10, color: 'mist' });\n      sliders.forEach((s, k) => { const y = 54 + k * 22; ui.slider(s.id, lx, y, lw, 13, s.name, setupValue(car.install, s.id), s.min, s.max, { step: s.step * (s.step < 0.02 ? 2 : 1), barW: 48, valueW: 26, set: (v) => { setSetup(car, s.id, v); app.save(); }, reset: () => { setSetup(car, s.id, s.def); app.save(); }, format: (v) => v.toFixed(2) }); if (ui.focused(s.id)) { ui.text(lx + 2, y + 14, `${s.low} TO ${s.high}`, { color: 'sand' }); this.help = s.line; } });\n      if (this.help && sliders.length) ui.lines(lx, Math.min(ui.h - 62, 54 + sliders.length * 22 + 6), this.help, { chars: Math.floor(lw / 6), gap: 9, color: 'mist' });\n    }\n    ui.prompts([['confirm', 'CHOOSE'], ['tabs', 'TAB'], ['alt', 'TEST DRIVE'], ['back', 'MAP']]);\n  }\n  onAlt() { const c = carEntry(this.app.profile); this.app.startTestDrive(c.carId, c.install, { from: 'tuning', uid: c.uid }); }\n}\nconst PER_PAGE = 5;\nexport class PartsScreen {\n  constructor(app, tile) { this.id = 'parts'; this.app = app; this.tile = tile; this.page = 0; }\n  resume() { stageIt(this.app, carEntry(this.app.profile)); }\n  items(car) {\n    if (this.tile === 'tyres') return TYRE_IDS.map((id) => { const t = TYRES[id]; return { id, name: t.name, line: t.line, price: t.price, owned: car.install.tyres.includes(id), on: car.install.tyre === id, kind: 'tyre', after: `GRIP ${t.tyreMu.toFixed(2)}`, before: `GRIP ${specOf(car.carId, car.install).tyreMu.toFixed(2)}` }; });\n    if (this.tile === 'body') return [{ id: 'paint', name: 'PAINT', line: 'ANY OF THE SIXTEEN COLOURS. LEFT AND RIGHT TO CHOOSE.', price: PAINT_PRICE, kind: 'paint', value: car.install.paint }, { id: 'rims', name: 'RIMS', line: 'FOUR STYLES. LEFT AND RIGHT TO CHOOSE.', price: RIM_PRICE, kind: 'rims', value: RIM_STYLES[car.install.rims] }];\n    return PART_IDS.filter((id) => PARTS[id].cat === this.tile).map((id) => { const P = PARTS[id], s0 = specOf(car.carId, car.install), tmp = { ...car.install, owned: [...new Set([...car.install.owned, id])], on: P.group ? { ...car.install.on, [P.group]: id } : car.install.on }, s1 = specOf(car.carId, tmp); const change = (a, b, u) => (a !== b ? `${a} TO ${b} ${u}` : null); return { id, name: P.name, line: P.line, price: P.price, owned: car.install.owned.includes(id), on: hasPart(car.install, id), kind: 'part', group: P.group, delta: change(s0.ps, s1.ps, 'PS') ?? change(s0.kg, s1.kg, 'KG') ?? (s1.clA !== s0.clA ? `DOWNFORCE ${s1.clA.toFixed(2)}` : s1.brakeG !== s0.brakeG ? `BRAKES ${s1.brakeG.toFixed(2)} G` : s1.shift !== s0.shift ? `SHIFT ${s1.shift.toFixed(2)} S` : null) }; });\n  }\n  draw(ui) {\n    const app = this.app, car = carEntry(app.profile), all = this.items(car), pages = Math.max(1, Math.ceil(all.length / PER_PAGE)), list = all.slice(this.page * PER_PAGE, this.page * PER_PAGE + PER_PAGE), tile = TILES.find((t) => t.id === this.tile), w = Math.min(ui.w - 18, 300), x = 8;\n    statusStrip(ui, app); ui.text(x, 19, tile.name, { scale: 2, color: 'sand' }); if (pages > 1) ui.text(x + w, 25, `PAGE ${this.page + 1}/${pages}`, { align: 'right', color: 'slate' });\n    list.forEach((it, k) => {\n      const y = 38 + k * 34, h = 30;\n      const onX = it.kind === 'paint' ? (d) => { const n = PAINTS.indexOf(this.paintPick ?? car.install.paint), v = PAINTS[(n + d + PAINTS.length) % PAINTS.length]; this.paintPick = v; app.scene?.showCar(car.carId, car.install, { paint: v, y: 0.08 }); } : it.kind === 'rims' ? (d) => { this.rimPick = ((this.rimPick ?? car.install.rims) + d + RIM_STYLES.length) % RIM_STYLES.length; } : null;\n      const confirm = () => this.buy(ui, car, it), f = ui.item(it.id, x, y, w, h, { confirm, onX, quiet: true });\n      ui.rect(x, y, w, h, f ? 'navy' : 'night');\n      ui.text(x + 6, y + 5, it.name, { color: it.on ? 'lime' : f ? 'white' : 'mist' }); ui.text(x + 6, y + 16, it.line, { color: 'slate' });\n      if (it.kind === 'paint') { const v = this.paintPick ?? car.install.paint; ui.text(x + w - 6, y + 5, `< ${v.toUpperCase()} >`, { align: 'right', color: v === car.install.paint ? 'lime' : 'sand' }); }\n      else if (it.kind === 'rims') { const v = this.rimPick ?? car.install.rims; ui.text(x + w - 6, y + 5, `< ${RIM_STYLES[v]} >`, { align: 'right', color: v === car.install.rims ? 'lime' : 'sand' }); }\n      else ui.text(x + w - 6, y + 5, it.on ? 'FITTED' : it.owned ? 'OWNED' : cr(it.price), { align: 'right', color: it.on ? 'lime' : it.owned ? 'sky' : app.profile.credits >= it.price ? 'sand' : 'red' });\n      if (f && it.delta) ui.text(x + w - 6, y + 16, it.delta, { align: 'right', color: 'white' });\n    });\n    if (pages > 1) ui.button('morePage', x, 38 + PER_PAGE * 34, w, 13, 'NEXT PAGE', { confirm: () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; } });\n    ui.prompts([['confirm', 'FIT'], ['moveX', 'CHOOSE'], ['alt', 'TEST DRIVE'], ['back', 'BACK']]);\n  }\n  buy(ui, car, it) {\n    const app = this.app, p = app.profile; let r;\n    if (it.kind === 'tyre') r = buyTyre(p, car, it.id); else if (it.kind === 'part') r = buyPart(p, car, it.id); else if (it.kind === 'paint') r = buyPaint(p, car, this.paintPick ?? car.install.paint); else r = buyRims(p, car, this.rimPick ?? car.install.rims);\n    if (!r.ok) { app.mix.sfx('denied'); if (r.why === 'money') ui.note('NOT ENOUGH CREDITS.'); return; }\n    app.save(); app.mix.sfx(r.swapped ? 'confirm' : 'register');\n    const s = app.scene; s?.showCar(car.carId, car.install, { y: 0.08, dirt: car.dirt });\n    if (r.swapped) return;\n    if (this.tile === 'aero' && it.id === 'aeroWing') ui.say('benno', LINES.benno.wing); else if (SAY[this.tile]) ui.say('benno', LINES.benno[SAY[this.tile]]);\n    if (this.tile === 'engine') { const before = this.prevInstall(car, it.id); ui.push(new DynoScreen(app, car, before)); }\n  }\n  prevInstall(car, id) { const P = PARTS[id], i = { ...car.install, owned: car.install.owned.filter((x) => x !== id), on: { ...car.install.on } }; if (P.group) i.on[P.group] = null; return i; }\n  onAlt() { const c = carEntry(this.app.profile); this.app.startTestDrive(c.carId, c.install, { from: 'parts', tile: this.tile, uid: c.uid }); }\n}\n// The dyno: the car on rollers, wheels spinning, the curve drawn live, the exhaust shaking, the engine rising.\nexport class DynoScreen {\n  constructor(app, car, before, o = {}) { this.id = 'dyno'; this.app = app; this.car = car; this.t = 0; this.curveA = dynoCurve(car.carId, before); this.curveB = dynoCurve(car.carId, car.install); this.max = Math.max(...this.curveB.map((p) => p.ps), ...this.curveA.map((p) => p.ps)); this.o = o; this.p = { turbo: specOf(car.carId, car.install).turbo, redline: specOf(car.carId, car.install).redline, idle: 900 }; }\n  enter() { const a = this.app, s = a.scene; s.stageOpts = { ...s.stageOpts, carFixed: true, carX: 0, carZ: 0, carYaw: Math.PI / 2 + 0.3 }; s.camPos.set(s.base.x - 5.6, 1.9, s.base.z + 5.4); s.wantPos.copy(s.camPos); s.orbitOn = false; s.radius = 7.8; s.orbit = -0.8; s.height = 1.9; a.mix.sfx('confirm'); }\n  exit() { const a = this.app, s = a.scene; a.mix.clearCars(); if (s?.stageOpts) { s.stageOpts.carFixed = false; s.orbitOn = true; s.carSpin = 0; if (s.car) s.car.shake = 0; } }\n  draw(ui, dt) {\n    const app = this.app, s = app.scene, dur = 5.5; this.t += dt; const f = Math.min(1, this.t / dur), n = this.curveB.length - 1, k = Math.round(f * n), pt = this.curveB[k];\n    if (s?.car) { s.carSpin = 14 + f * 70; s.car.shake = f < 1 ? 0.006 : 0; if (Math.floor(this.t * 6) !== Math.floor((this.t - dt) * 6) && f < 1) app.ctx.particles.burst('exhaustPop', [s.car.object.position.x - 2, 0.4, s.car.object.position.z - 0.6]); }\n    const w = Math.min(ui.w - 30, 300), h = 120, x = Math.round(ui.cx - w / 2), y = 24;\n    ui.panel(x, y, w, h + 22, { color: 'ink', border: 'sand' }); ui.text(x + 6, y + 4, `DYNO: ${CAR_INFO[this.car.carId].short}`, { color: 'sand' }); ui.text(x + w - 6, y + 4, `${Math.round(pt.ps)} PS`, { align: 'right', scale: 1 });\n    const plotX = x + 8, plotY = y + 15, pw = w - 16, ph = h - 6, redlineX = 1;\n    for (let g = 0; g <= 4; g++) ui.rect(plotX, plotY + (g * ph) / 4, pw, 1, 'night');\n    const P = (c, i) => [plotX + Math.round((i / n) * pw), plotY + ph - Math.round((c.ps / this.max) * ph * 0.95)];\n    for (let i = 0; i <= n; i++) { const [a, b] = P(this.curveA[i], i); ui.rect(a, b, 2, 2, 'slate'); }\n    for (let i = 0; i <= k; i++) { const [a, b] = P(this.curveB[i], i); ui.rect(a, b, 2, 2, 'lime'); }\n    ui.text(plotX, y + h + 8, 'BEFORE', { color: 'slate' }); ui.text(plotX + 44, y + h + 8, 'AFTER', { color: 'lime' }); ui.text(x + w - 6, y + h + 8, `${Math.round(pt.rpm)} RPM`, { align: 'right', color: 'mist' });\n    app.mix.engines([{ key: 'dyno', carId: this.car.carId, p: { ...this.p, sportExhaust: this.car.install.owned.includes('exhaust') }, rpm: f < 1 ? pt.rpm : 900, throttle: f < 1 ? 1 : 0.05, spool: f, gain: 1, pan: 0 }], dt);\n    ui.button('done', ui.cx - 40, ui.h - 36, 80, 14, f < 1 ? 'WAIT' : 'THANK YOU', { confirm: () => ui.pop() });\n    ui.prompts([['confirm', 'CLOSE']]);\n    void redlineX;\n  }\n}\nEOF\ncat > src/game/ui/screens/service.js <<'EOF'\n// The Service Bay: oil and soap, with short animations and a word from Benno.\nimport { CAR_INFO } from '../../data/cars.js';\nimport { LINES } from '../../data/text.js';\nimport { carEntry, changeOil, oilOf, OIL_PRICE, WASH_PRICE, washCar } from '../../sim/career.js';\nimport { PALETTE, THREE, toonMaterial } from '../../../pixel-engine.js';\nimport { cr, statusStrip } from './common.js';\nconst { CylinderGeometry, Mesh } = THREE;\nexport class ServiceScreen {\n  constructor(app) { this.id = 'service'; this.app = app; this.anim = null; }\n  stageIt() { const a = this.app, c = carEntry(a.profile); a.scene?.stage?.('service', { car: { carId: c.carId, install: c.install, dirt: c.dirt, y: 0 }, carFixed: true, carYaw: 0, person: 'benno', personClip: 'MechanicWipe', personAt: [4.4, 0, 2.4], personYaw: -1.0, orbit: false, angle: 0.55, radius: 9, height: 2.8, sun: 0.75 }); a.mix.music('socket'); }\n  enter(ui) { this.stageIt(); const c = carEntry(this.app.profile), o = oilOf(c); ui.say('benno', o < 1 ? LINES.benno.oilTired : LINES.benno.oilFresh); }\n  resume() { this.stageIt(); }\n  exit() { this.removeBrushes(); }\n  removeBrushes() { if (this.brushes) { for (const b of this.brushes) b.removeFromParent(); this.brushes = null; } }\n  draw(ui, dt) {\n    const app = this.app, p = app.profile, car = carEntry(p), oil = oilOf(car), w = Math.min(ui.w - 18, 190), x = 8;\n    statusStrip(ui, app); ui.text(x, 19, 'SERVICE BAY', { scale: 2, color: 'sand' }); ui.text(x, 37, CAR_INFO[car.carId].short, { color: 'mist' });\n    const oilText = oil > 1 ? 'FRESH: +2% POWER' : oil === 1 ? `FINE. ${Math.round(car.kmOil)} KM SINCE A CHANGE` : `TIRED: ${Math.round((oil - 1) * 100)}% POWER`, dirtText = car.dirt > 0.02 ? `${Math.round(car.dirt * 100)}% MUD` : 'CLEAN';\n    const A = [['oil', 'OIL CHANGE', OIL_PRICE, oilText, oil < 1 ? 'red' : 'lime'], ['wash', 'CAR WASH', WASH_PRICE, dirtText, car.dirt > 0.02 ? 'orange' : 'lime']];\n    A.forEach(([id, name, price, info, col], k) => { const y = 52 + k * 42, h = 37, f = ui.item(id, x, y, w, h, { confirm: () => this.act(ui, id, car), quiet: true }); ui.rect(x, y, w, h, f ? 'navy' : 'night'); ui.text(x + 6, y + 5, name, { color: f ? 'sand' : 'white' }); ui.text(x + w - 6, y + 5, cr(price), { align: 'right', color: p.credits >= price ? 'sand' : 'red' }); ui.text(x + 6, y + 16, info, { color: col }); if (id === 'wash') ui.text(x + 6, y + 26, 'NO EFFECT ON PERFORMANCE.', { color: 'slate' }); else ui.text(x + 6, y + 26, `${Math.round(car.km)} KM ON THE CLOCK`, { color: 'slate' }); });\n    ui.prompts([['confirm', 'DO IT'], ['back', 'MAP']]);\n    if (this.anim) this.anim(dt);\n  }\n  act(ui, id, car) {\n    const app = this.app, p = app.profile;\n    if (this.anim) return;\n    if (id === 'oil') { const before = oilOf(car), r = changeOil(p, car); if (!r.ok) { app.mix.sfx('denied'); ui.note('NOT ENOUGH CREDITS.'); return; } app.save(); app.mix.sfx('register'); ui.say('benno', LINES.benno.oilDone); this.dripAnim(before); return; }\n    const had = car.dirt, r = washCar(p, { ...car, dirt: car.dirt, wash: 0, install: car.install }); if (!r.ok) { app.mix.sfx('denied'); ui.note('NOT ENOUGH CREDITS.'); return; }\n    ui.say('benno', had > 0.02 ? LINES.benno.wash : LINES.benno.washClean); app.mix.sfx('register'); this.washAnim(car, had);\n  }\n  dripAnim() { const app = this.app, s = app.scene, ctx = app.ctx; let t = 0; this.anim = (dt) => { t += dt; if (s?.car && t < 1.4) { s.car.jack = Math.min(0.5, t) * 0.8; ctx.particles.burst({ count: [1, 1], life: [0.25, 0.4], speed: [0, 0], gravity: 10, size: [1, 1], colors: ['ink', 'plum'] }, [s.base.x, 0.45, s.base.z + 0.8]); } else if (s?.car) { s.car.jack = Math.max(0, s.car.jack - dt); if (s.car.jack <= 0) this.anim = null; } else this.anim = null; }; }\n  washAnim(car, had) {\n    // Spinning brushes travel the car, foam flies, and the mud dissolves pixel by pixel.\n    const app = this.app, s = app.scene, ctx = app.ctx, base = s.base;\n    this.removeBrushes(); this.brushes = [-1.3, 1.3].map((sx) => { const m = new Mesh(new CylinderGeometry(0.4, 0.4, 2.2, 8), toonMaterial(PALETTE.lime)); m.position.set(base.x + sx, 1.1, base.z - 3.6); ctx.scene.add(m); return m; });\n    let t = 0; const dur = 4;\n    app.mix.sfx('splash');\n    this.anim = (dt) => {\n      t += dt; const f = Math.min(1, t / dur), z = base.z - 3.6 + 7.2 * (f < 0.5 ? f * 2 : 2 - f * 2);\n      for (const b of this.brushes) { b.position.z = z; b.rotation.y += dt * 12; ctx.particles.burst('foam', [b.position.x, 0.4 + Math.random() * 1.2, z]); }\n      if (Math.floor(t * 3) !== Math.floor((t - dt) * 3)) app.mix.sfx('brush');\n      if (s?.car) s.car.setDirt(had * (1 - f));\n      if (f >= 1) { car.dirt = 0; car.wash = (car.wash ?? 0) + 1; app.save(); this.removeBrushes(); this.anim = null; }\n    };\n  }\n}\nEOF\ncat > src/game/ui/screens/garage.js <<'EOF'\n// The Home Garage: your cars on a turntable with mileage, oil and setup; choose your ride; sell. A trophy shelf and your statistics.\nimport { CAR_INFO } from '../../data/cars.js';\nimport { EVENTS } from '../../data/events.js';\nimport { LICENCES } from '../../data/licences.js';\nimport { LAST_CAR, LINES, PRIZE_SELL } from '../../data/text.js';\nimport { collectedShare, oilOf, sellCar, sellValue, setCurrent } from '../../sim/career.js';\nimport { PALETTE, THREE, toonMaterial } from '../../../pixel-engine.js';\nimport { GeoBatch } from '../../render/geo.js';\nimport { cr, Dialog, num, specCard, statusStrip } from './common.js';\nconst { Group } = THREE;\nexport class GarageScreen {\n  constructor(app, o = {}) { this.id = 'garage'; this.app = app; this.tab = 0; this.index = 0; this.o = o; }\n  enter() { this.index = Math.max(0, this.app.profile.cars.findIndex((c) => c.uid === this.app.profile.current)); this.show(); this.app.mix.music('lounge'); }\n  resume() { this.show(); }\n  exit() { this.shelf?.removeFromParent(); }\n  show() {\n    const app = this.app, cars = app.profile.cars, c = cars[Math.min(this.index, cars.length - 1)], s = app.scene; if (!c) return;\n    s?.stage?.('garage', { car: { carId: c.carId, install: c.install, dirt: c.dirt, y: 0.18 }, radius: 8, height: 2.6, angle: 0.4 });\n    this.buildShelf();\n  }\n  buildShelf() { // A 3D cup or medal for every win.\n    const app = this.app, s = app.scene; this.shelf?.removeFromParent(); const list = app.profile.trophies; if (!s?.base) return;\n    const b = new GeoBatch(); list.slice(0, 27).forEach((t, k) => { const x = -9 + (k % 9) * 2.2, row = Math.floor(k / 9), y = 1.3 + row * 2, z = -11.2; if (t.kind === 'cup') { b.cone(x, y, z, 0.3, 0.15, 6, 'slate', 0.3); b.cone(x, y + 0.15, z, 0.08, 0.3, 6, 'sand', 0.08); b.cone(x, y + 0.45, z, 0.14, 0.5, 8, 'sand', 0.34); } else if (t.kind === 'helmet') { b.ball(x, y + 0.34, z, 0.34, 'sand', 8, 0.9); b.box(x, y + 0.26, z + 0.18, 0.46, 0.16, 0.2, 'ink'); } else { b.box(x, y, z, 0.5, 0.06, 0.3, 'slate'); b.box(x, y + 0.06, z, 0.4, 0.55, 0.06, t.id === 'A' ? 'sand' : t.id === 'B' ? 'mist' : 'orange'); } });\n    if (b.triangles) { this.shelf = new Group(); this.shelf.add(b.mesh({ cast: true, receive: false })); this.shelf.position.copy(s.base); s.sets.root.add(this.shelf); }\n    void toonMaterial; void PALETTE;\n  }\n  draw(ui) {\n    const app = this.app, p = app.profile; statusStrip(ui, app); ui.text(8, 19, 'HOME GARAGE', { scale: 2, color: 'sand' });\n    ui.tabs('t', 8, 38, 170, ['CARS', 'TROPHIES', 'STATISTICS'], this.tab, (i) => { this.tab = i; this.focus = null; ui.box.ready = false; });\n    if (this.tab === 0) this.cars(ui, p); else if (this.tab === 1) this.trophies(ui, p); else this.stats(ui, p);\n  }\n  cars(ui, p) {\n    const app = this.app, cars = p.cars; if (this.index >= cars.length) this.index = cars.length - 1; const c = cars[this.index], cur = p.current === c.uid, w = 150, x = ui.w - w - 8, o = oilOf(c);\n    specCard(ui, x, 20, w, c.carId, c.install, { extra: [['ODOMETER', `${num(c.km)} KM`], ['OIL', o > 1 ? 'FRESH' : o === 1 ? 'FINE' : `${Math.round((o - 1) * 100)}%`]], foot: `${this.index + 1} OF ${cars.length}`, footColor: 'slate' });\n    const nav = (d) => { this.index = (this.index + d + cars.length) % cars.length; this.show(); app.mix.sfx('whirr'); }, by = 56;\n    ui.button('drive', 8, by, 170, 18, cur ? 'THIS IS YOUR RIDE' : 'CHOOSE THIS CAR', { confirm: () => { setCurrent(p, c.uid); app.save(); if (this.o.onChoose) this.o.onChoose(ui); }, onX: nav, color: cur ? 'lime' : 'white', right: null });\n    ui.button('sell', 8, by + 22, 170, 15, c.prize ? 'NOT FOR SALE' : `SELL FOR ${cr(sellValue(c))}`, { confirm: () => this.sell(ui, c), onX: nav });\n    ui.text(8, by + 42, '< > NEXT CAR', { color: 'slate' });\n    ui.prompts([['confirm', 'CHOOSE'], ['moveX', 'NEXT CAR'], ['tabs', 'TAB'], ['back', 'BACK']]);\n  }\n  sell(ui, c) {\n    const app = this.app, p = app.profile;\n    if (c.prize) { ui.note(PRIZE_SELL); app.mix.sfx('denied'); return; }\n    if (p.cars.length <= 1) { ui.note(LAST_CAR); app.mix.sfx('denied'); return; }\n    const d = new Dialog(app, `SELL THE ${CAR_INFO[c.carId].short}?`, [`YOU WILL RECEIVE ${cr(sellValue(c))}.`], [['no', 'KEEP', () => ui.pop()], ['yes', 'SELL', () => { sellCar(p, c.uid); app.save(); app.mix.sfx('register'); ui.pop(); this.index = 0; this.show(); ui.say('fenn', LINES.fenn.sold); }]]); d.under = this; d.focus = 'no'; ui.push(d);\n  }\n  trophies(ui, p) {\n    const names = p.trophies.map((t) => (t.kind === 'cup' ? EVENTS[t.id].name : t.kind === 'helmet' ? 'THE GOLD HELMET' : `${LICENCES[t.id].name} LICENCE`)), w = Math.min(ui.w - 16, 260);\n    if (!names.length) ui.lines(8, 58, 'THE SHELF IS EMPTY. IT HAS BEEN DUSTED ANYWAY.', { chars: 40, color: 'mist' });\n    ui.panel(8, 56, w, 12 + Math.min(14, names.length) * 10, { color: 'ink', border: false, scan: true });\n    names.slice(0, 14).forEach((n, k) => ui.text(14, 60 + k * 10, n, { color: 'sand' }));\n    ui.prompts([['tabs', 'TAB'], ['back', 'BACK']]);\n  }\n  stats(ui, p) {\n    const rows = [['DAYS', num(p.day)], ['KILOMETRES', num(p.stats.km)], ['RACES', num(p.stats.races)], ['WINS', num(p.stats.wins)], ['GOLD MEDALS', num(p.stats.gold)], ['CARS COLLECTED', `${collectedShare(p)}%`]], x = 8, w = 170;\n    ui.panel(x, 56, w, 10 + rows.length * 12, { color: 'ink', border: 'slate' });\n    rows.forEach(([k, v], i) => { ui.text(x + 6, 62 + i * 12, k, { color: 'mist' }); ui.text(x + w - 6, 62 + i * 12, v, { align: 'right', color: 'white' }); });\n    ui.prompts([['tabs', 'TAB'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/game/ui/screens/museum.js <<'EOF'\n// The Museum: all fourteen cars with their brochure text and silhouette, and a page per track.\nimport { CAR_IDS, CAR_INFO, MARQUES } from '../../data/cars.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { formatTime } from '../../sim/race.js';\nimport { miniMap, specCard, statusStrip } from './common.js';\nconst TRACK_IDS = Object.keys(TRACKS);\nexport class MuseumScreen {\n  constructor(app) { this.id = 'museum'; this.app = app; this.tab = 0; this.car = 0; this.track = 0; }\n  enter() { this.show(); this.app.mix.music('catalogue'); }\n  resume() { this.show(); this.app.mix.music('catalogue'); }\n  seen(id) { const p = this.app.profile; return !!p.seen[id] || p.cars.some((c) => c.carId === id); }\n  show() { const id = CAR_IDS[this.car], s = this.app.scene; s?.stage?.('museum', this.tab === 0 ? { car: { carId: id, install: null, silhouette: !this.seen(id), y: 0.2 }, radius: 8.2, height: 2.6 } : { orbit: true, radius: 13, height: 5, lookY: 2 }); }\n  draw(ui) {\n    const app = this.app, p = app.profile, a = app.actions; statusStrip(ui, app); ui.text(8, 19, 'MUSEUM', { scale: 2, color: 'sand' });\n    ui.tabs('t', 8, 38, 120, ['CARS', 'CIRCUITS'], this.tab, (i) => { this.tab = i; this.show(); });\n    ui.item('page', 0, 0, 0, 0, { noBox: true, onX: (d) => { if (this.tab === 0) { this.car = (this.car + d + CAR_IDS.length) % CAR_IDS.length; this.show(); } else this.track = (this.track + d + TRACK_IDS.length) % TRACK_IDS.length; app.mix.sfx('tick'); }, confirm: () => { this.brochure = !this.brochure; }, onY: () => {} });\n    if (this.tab === 0) {\n      const id = CAR_IDS[this.car], i = CAR_INFO[id], seen = this.seen(id), w = 150, x = ui.w - w - 8;\n      if (seen) specCard(ui, x, 20, w, id, null, { foot: `${this.car + 1} OF ${CAR_IDS.length}`, footColor: 'slate' });\n      else { ui.panel(x, 20, w, 44, { color: 'ink', border: 'slate' }); ui.text(x + 6, 26, 'NOT YET MET', { color: 'slate' }); ui.text(x + 6, 36, MARQUES[i.marque].name, { color: 'mist' }); ui.text(x + w - 6, 52, `${this.car + 1} OF ${CAR_IDS.length}`, { align: 'right', color: 'slate' }); }\n      if (seen) { const lines = i.text, bw = Math.min(ui.w - 16, 340), by = ui.h - 36 - 16 - lines.length * 10; ui.panel(8, by, bw, 15 + lines.length * 10, { color: 'ink', border: 'slate' }); ui.text(14, by + 3, `${MARQUES[i.marque].name}: ${MARQUES[i.marque].line}`, { color: 'sand' }); lines.forEach((l, k) => ui.text(14, by + 13 + k * 10, l)); }\n      ui.prompts([['moveX', 'NEXT CAR'], ['tabs', 'TAB'], ['back', 'MAP']]);\n    } else {\n      const id = TRACK_IDS[this.track], def = TRACKS[id], rec = p.records[id], w = Math.min(ui.w - 16, 320), x = Math.round(ui.cx - w / 2);\n      ui.panel(x, 54, w, 150, { color: 'ink', border: 'slate' });\n      ui.text(x + 8, 60, def.name.toUpperCase(), { scale: 2, color: 'sand' });\n      const m = miniMap(ui, x + 10, 86, id, 100, 'white');\n      ui.text(x + 124, 90, `LENGTH ${(m.length / 1000).toFixed(2)} KM`); ui.text(x + 124, 102, `${m.corners} CORNERS`); ui.text(x + 124, 114, def.surface === 'dirt' ? 'DIRT' : 'ASPHALT', { color: 'mist' }); ui.text(x + 124, 126, def.pit ? 'PIT LANE' : 'NO PITS', { color: 'mist' });\n      ui.text(x + 124, 144, 'RECORD', { color: 'slate' }); ui.text(x + 124, 154, rec ? formatTime(rec.lap) : 'NONE YET', { color: rec ? 'sand' : 'slate' }); if (rec) ui.text(x + 124, 164, CAR_INFO[rec.carId].short, { color: 'mist' });\n      ui.text(x + w - 8, 192, `${this.track + 1} OF ${TRACK_IDS.length}`, { align: 'right', color: 'slate' });\n      ui.prompts([['moveX', 'NEXT CIRCUIT'], ['tabs', 'TAB'], ['back', 'MAP']]);\n    }\n    void a;\n  }\n}\nEOF\ncat > src/game/ui/screens/theatre.js <<'EOF'\n// The Theatre: the last race, and three slots for keeping one.\nimport { TRACKS } from '../../data/tracks.js';\nimport { Dialog, statusStrip } from './common.js';\nexport class TheatreScreen {\n  constructor(app) { this.id = 'theatre'; this.app = app; }\n  stageIt() { this.app.scene?.stage?.('theatre', { orbit: false, angle: 0.05, radius: 14, height: 3, lookY: 3, lookZ: -5, sun: 0.4, ambient: 0.8 }); this.app.mix.music('longDrive'); }\n  enter() { this.stageIt(); }\n  resume() { this.stageIt(); }\n  label(rec) { return rec ? `${TRACKS[rec.meta.track].name.toUpperCase()}` : 'EMPTY'; }\n  draw(ui) {\n    const app = this.app, p = app.profile, w = Math.min(ui.w - 16, 260), x = Math.round(ui.cx - w / 2); statusStrip(ui, app); ui.text(ui.cx, 20, 'THE THEATRE', { align: 'center', scale: 2, color: 'sand' });\n    const last = app.lastRace;\n    ui.button('last', x, 44, w, 20, `LAST RACE: ${last ? this.label(last) : 'NONE YET'}`, { left: true, confirm: () => (last ? app.watchRecording(last, { after: 'theatre' }) : null), denied: last ? null : () => ui.note('DRIVE SOMETHING FIRST. IT IS WORTH WATCHING.') });\n    if (last && app.lastRaceSlot !== undefined) ui.text(x, 66, '', {});\n    p.replays.forEach((z, k) => {\n      const y = 72 + k * 26;\n      ui.button(`slot${k}`, x, y, w, 22, `SLOT ${k + 1}: ${z ? this.label(z) : 'EMPTY'}`, { left: true, confirm: () => (z ? app.watchSaved(k, { after: 'theatre' }) : null), denied: z ? null : () => ui.note('THIS SLOT IS EMPTY. SAVE A REPLAY FROM A RESULTS SCREEN.'), right: z ? `DAY ${z.day ?? '-'}` : null });\n    });\n    ui.prompts([['confirm', 'WATCH'], ['alt', 'CLEAR SLOT'], ['back', 'MAP']]);\n  }\n  onAlt(ui) { const m = /^slot(\\d)$/.exec(this.focus ?? ''); if (!m) return; const k = +m[1], p = this.app.profile; if (!p.replays[k]) return; const d = new Dialog(this.app, 'CLEAR THIS SLOT?', ['THE REPLAY WILL BE GONE. THE RACE STILL HAPPENED.'], [['no', 'KEEP', () => ui.pop()], ['yes', 'CLEAR', () => { p.replays[k] = null; this.app.save(); ui.pop(); }]]); d.under = this; d.focus = 'no'; ui.push(d); }\n}\nEOF\ncat > src/game/ui/screens/arcade.js <<'EOF'\n// The Arcade Gate: Quick Race, Time Trial, Couch Duel as big tiles, then two or three simple picker screens. Every car and track is open.\nimport { CAR_IDS, CAR_INFO } from '../../data/cars.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { miniMap, specCard, statusStrip } from './common.js';\nconst TRACK_IDS = Object.keys(TRACKS);\nconst stageIt = (app, car) => { app.scene?.stage?.('arcade', { car: car ? { carId: car, install: null, y: 0.18 } : undefined, radius: 8, height: 2.6, sun: 0.4, ambient: 0.9 }); app.mix.music('city'); };\nexport class ArcadeScreen {\n  constructor(app) { this.id = 'arcade'; this.app = app; }\n  enter() { stageIt(this.app, 'libeccio'); }\n  resume() { stageIt(this.app, 'libeccio'); }\n  draw(ui) {\n    const app = this.app; statusStrip(ui, app); ui.text(ui.cx, 20, 'ARCADE GATE', { align: 'center', scale: 2, color: 'cyan' }); ui.text(ui.cx, 37, 'NO LICENCE REQUIRED. NO MONEY EITHER.', { align: 'center', color: 'mist' });\n    const tiles = [['quick', 'QUICK RACE', 'ANY CAR, ANY CIRCUIT, A FIELD OF RIVALS.'], ['trial', 'TIME TRIAL', 'YOU, THE CLOCK, AND THE GHOST OF YOUR BEST.'], ['couch', 'COUCH DUEL', 'TWO PLAYERS, ONE TELEVISION, REAL CONTACT.']], w = Math.min(Math.floor((ui.w - 24) / 3), 150), x0 = Math.round(ui.cx - (w * 3 + 8) / 2);\n    tiles.forEach(([id, name, line], k) => { const x = x0 + k * (w + 4), f = ui.item(id, x, 150, w, 66, { confirm: () => ui.push(new PickTrack(app, { mode: id })) }); ui.rect(x, 150, w, 66, f ? 'navy' : 'ink'); ui.text(x + w / 2, 157, name, { align: 'center', color: f ? 'cyan' : 'white' }); ui.lines(x + 6, 171, line, { chars: Math.floor((w - 12) / 6), gap: 10, color: 'mist' }); });\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'MAP']]);\n  }\n}\nclass PickTrack {\n  constructor(app, o) { this.id = 'pickTrack'; this.app = app; this.o = o; this.i = 0; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, id = TRACK_IDS[this.i], def = TRACKS[id], w = Math.min(ui.w - 40, 280), x = Math.round(ui.cx - w / 2); ui.text(ui.cx, 12, 'CHOOSE A CIRCUIT', { align: 'center', scale: 2, color: 'cyan' });\n    const f = ui.item('track', x, 34, w, 150, { onX: (d) => { this.i = (this.i + d + TRACK_IDS.length) % TRACK_IDS.length; app.mix.sfx('tick'); }, confirm: () => ui.push(new PickCar(app, { ...this.o, track: id })) });\n    ui.rect(x, 34, w, 150, f ? 'navy' : 'ink'); ui.text(ui.cx, 40, `< ${def.name.toUpperCase()} >`, { align: 'center', color: 'sand' }); const m = miniMap(ui, Math.round(ui.cx - 55), 54, id, 110, 'white'); ui.text(ui.cx, 170, `${(m.length / 1000).toFixed(2)} KM, ${m.corners} CORNERS`, { align: 'center', color: 'mist' });\n    ui.prompts([['moveX', 'CHANGE'], ['confirm', 'NEXT'], ['back', 'BACK']]);\n  }\n}\nclass PickCar {\n  constructor(app, o) { this.id = 'pickCar'; this.app = app; this.o = o; this.i = 1; this.player = 0; this.first = null; }\n  show() { stageIt(this.app, CAR_IDS[this.i]); }\n  enter() { this.show(); }\n  resume() { this.show(); }\n  draw(ui) {\n    const app = this.app, id = CAR_IDS[this.i], w = 150, x = ui.w - w - 8, couch = this.o.mode === 'couch';\n    ui.text(8, 10, couch ? `PLAYER ${this.player + 1}: CHOOSE A CAR` : 'CHOOSE A CAR', { scale: 1, color: 'cyan' });\n    specCard(ui, x, 8, w, id, null, { foot: `${this.i + 1} OF ${CAR_IDS.length}`, footColor: 'slate' });\n    ui.item('car', 8, ui.h - 44, 120, 18, { onX: (d) => { this.i = (this.i + d + CAR_IDS.length) % CAR_IDS.length; this.show(); app.mix.sfx('whirr'); }, confirm: () => this.choose(ui, id) });\n    ui.rect(8, ui.h - 44, 120, 18, ui.focused('car') ? 'navy' : 'ink'); ui.text(68, ui.h - 38, `< ${CAR_INFO[id].short} >`, { align: 'center', color: 'sand' });\n    ui.prompts([['moveX', 'CHANGE'], ['confirm', 'NEXT'], ['back', 'BACK']]);\n  }\n  choose(ui, id) {\n    const app = this.app, o = this.o;\n    if (o.mode === 'trial') return app.startTimeTrial({ track: o.track, carId: id });\n    if (o.mode === 'couch' && this.player === 0) { this.first = id; this.player = 1; this.i = (this.i + 3) % CAR_IDS.length; this.show(); return; }\n    ui.push(new PickRace(app, { ...o, carId: o.mode === 'couch' ? this.first : id, carB: id }));\n  }\n}\nconst HOURS = [['TRACK\\'S OWN', null], ['MORNING', 9], ['AFTERNOON', 15], ['DUSK', 18.5], ['NIGHT', 21]], DIFF = [['EASY', 'easy'], ['NORMAL', 'normal'], ['HARD', 'hard']];\nclass PickRace {\n  constructor(app, o) { this.id = 'pickRace'; this.app = app; this.o = o; this.laps = 3; this.field = o.mode === 'couch' ? 2 : 6; this.diff = 1; this.hour = 0; this.rain = false; }\n  enter() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, o = this.o, w = Math.min(ui.w - 40, 280), x = Math.round(ui.cx - w / 2), couch = o.mode === 'couch'; ui.text(ui.cx, 12, couch ? 'THE DUEL' : 'THE RACE', { align: 'center', scale: 2, color: 'cyan' });\n    let y = 34; const row = (id, label, val, onX) => { const f = ui.item(id, x, y, w, 18, { onX: (d) => { onX(d); app.mix.sfx('tick'); }, confirm: () => onX(1) }); ui.rect(x, y, w, 18, f ? 'navy' : 'ink'); ui.text(x + 8, y + 6, label, { color: f ? 'white' : 'mist' }); ui.text(x + w - 8, y + 6, `< ${val} >`, { align: 'right', color: f ? 'sand' : 'mist' }); y += 22; };\n    row('laps', 'LAPS', String(this.laps), (d) => { this.laps = Math.max(1, Math.min(12, this.laps + d)); });\n    if (couch) row('field', 'AI CARS', String(this.field - 2), (d) => { this.field = Math.max(2, Math.min(6, this.field + d)); });\n    else row('field', 'FIELD', String(this.field), (d) => { this.field = Math.max(1, Math.min(8, this.field + d)); });\n    if (!couch) row('diff', 'PACE', DIFF[this.diff][0], (d) => { this.diff = (this.diff + d + 3) % 3; });\n    row('hour', 'HOUR', HOURS[this.hour][0], (d) => { this.hour = (this.hour + d + HOURS.length) % HOURS.length; });\n    row('rain', 'RAIN', this.rain ? 'YES' : 'NO', () => { this.rain = !this.rain; });\n    ui.button('go', ui.cx - 60, y + 6, 120, 18, 'START', { confirm: () => { const hour = HOURS[this.hour][1] ?? undefined; if (couch) app.startCouch({ track: o.track, carA: o.carId, carB: o.carB, laps: this.laps, ai: this.field - 2, hour, rain: this.rain }); else app.startQuick({ track: o.track, carId: o.carId, laps: this.laps, field: this.field, difficulty: DIFF[this.diff][1], hour, rain: this.rain }); } });\n    ui.prompts([['moveX', 'CHANGE'], ['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\nEOF\necho ok","description":"Write licence, event, dealer, tuning, service, garage, museum, theatre, arcade screens"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20161,"cache_read_input_tokens":438487,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20161},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"526a90f8-488e-4161-8630-2187ce95c2c4","timestamp":"2026-11-06T01:03:20.698Z","request_id":"req_011CgkmZyXFgNyMwf5vW29xs","wire_tool_inputs":{"toolu_015zkAxLFREECNgz4DCCpzHi":{"command":"head -3 src/LICENSE; sed -i \"s/'PIXEL ENGINE 0.46.0, BY MICHAEL CROSATO AND CONTRIBUTORS (MIT).'/'PIXEL ENGINE 0.46.0, THE RIFTLIGHT ENGINE KIT. SEE ITS LICENCE IN THE KIT CREDITS.'/\" src/game/data/about.js\ncat > src/game/ui/screens/licence.js <<'EOF'\n// The Licence Centre: three licences, four tests each, a card for each test, and a result after each attempt.\nimport { LICENCE_ORDER, LICENCES, TESTS } from '../../data/licences.js';\nimport { CAR_INFO } from '../../data/cars.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { LINES } from '../../data/text.js';\nimport { licenceOpen, testRecord } from '../../sim/career.js';\nimport { formatTime } from '../../sim/race.js';\nimport { cr, MEDAL_NAME, medalIcon, statusStrip } from './common.js';\nconst stageIt = (app) => { const s = app.scene; s?.stage?.('licence', { person: 'arai', personClip: 'ExaminerClipboard', personAt: [-3.4, 0, -0.6], personYaw: 0.6, orbit: false, angle: 0.25, radius: 11, height: 3, lookX: -2.2, lookY: 1.2, lookZ: -1 }); app.mix.music('exam'); };\nexport class LicenceListScreen {\n  constructor(app) { this.id = 'licenceList'; this.app = app; }\n  enter(ui) { stageIt(this.app); if (!this.app.profile.tests['C-1']) ui.say('arai', LINES.arai.idle); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, p = app.profile; statusStrip(ui, app); ui.text(10, 20, 'LICENCE CENTRE', { scale: 2, color: 'sand' });\n    const w = Math.min(ui.w - 20, 220), x = ui.w - w - 10;\n    LICENCE_ORDER.forEach((id, k) => {\n      const l = LICENCES[id], open = licenceOpen(p, id), medals = l.tests.map((t) => p.tests[t]?.medal), y = 44 + k * 58, h = 52;\n      const f = ui.item(id, x, y, w, h, open ? { confirm: () => ui.push(new TestListScreen(app, id)) } : { denied: () => ui.note(`THE ${LICENCES[l.needs].name} LICENCE COMES FIRST.`) });\n      ui.rect(x, y, w, h, open ? (f ? 'navy' : 'night') : 'ink');\n      ui.text(x + 8, y + 6, `${id}: ${l.name}`, { color: open ? 'sand' : 'slate' }); ui.text(x + 8, y + 17, l.line, { color: open ? 'white' : 'slate' });\n      medals.forEach((m, i) => medalIcon(ui, x + 8 + i * 13, y + 30, m));\n      ui.text(x + w - 8, y + 32, p.licences[id] ? 'HELD' : `REWARD ${cr(l.reward)}`, { align: 'right', color: p.licences[id] ? 'lime' : 'mist' });\n    });\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'MAP']]);\n  }\n}\nexport class TestListScreen {\n  constructor(app, lic) { this.id = 'testList'; this.app = app; this.lic = lic; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, l = LICENCES[this.lic], p = app.profile; statusStrip(ui, app);\n    ui.text(10, 20, `LICENCE ${l.id}`, { scale: 2, color: 'sand' }); ui.text(10, 38, l.name, { color: 'mist' });\n    const w = Math.min(ui.w - 20, 230), x = ui.w - w - 10;\n    l.tests.forEach((id, k) => {\n      const t = TESTS[id], rec = p.tests[id], y = 34 + k * 44, h = 39, f = ui.item(id, x, y, w, h, { confirm: () => ui.push(new TestCardScreen(app, id)) });\n      ui.rect(x, y, w, h, f ? 'navy' : 'night'); medalIcon(ui, x + 7, y + 6, rec?.medal);\n      ui.text(x + 22, y + 6, `${id} ${t.title}`, { color: 'white' }); ui.text(x + 22, y + 17, t.lesson, { color: 'mist' });\n      ui.text(x + 22, y + 27, rec?.best ? `BEST ${formatTime(rec.best)}` : 'NOT ATTEMPTED', { color: rec?.best ? 'sand' : 'slate' });\n    });\n    if (l.allGold) { ui.text(10, ui.h - 42, 'ALL GOLD:', { color: 'sand' }); ui.text(10, ui.h - 32, l.allGold.text.slice(0, 40), { color: 'mist' }); }\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\nexport class TestCardScreen {\n  constructor(app, id) { this.id = 'testCard'; this.app = app; this.test = TESTS[id]; }\n  enter(ui) { stageIt(this.app); ui.say('arai', this.test.brief.join(' '), 8); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, t = this.test, rec = app.profile.tests[t.id], m = t.medals, w = Math.min(ui.w - 20, 300), x = ui.w - w - 10, y = 18, offer = (rec?.fails ?? 0) >= 3;\n    ui.panel(x, y, w, 196, { color: 'ink', border: 'slate' });\n    ui.text(x + 8, y + 6, t.id, { color: 'slate' }); ui.text(x + 8, y + 15, t.title, { scale: 2, color: 'sand' });\n    ui.text(x + 8, y + 36, `${t.legs ? t.legs.map((c) => CAR_INFO[c].short).join(', ') : CAR_INFO[t.carId].name}`, { color: 'white' }); ui.text(x + 8, y + 46, TRACKS[t.track].name.toUpperCase(), { color: 'mist' });\n    ui.lines(x + 8, y + 60, t.brief, { gap: 10 });\n    const my = y + 96; for (const [k, name, col] of [[0, 'gold', 'sand'], [1, 'silver', 'mist'], [2, 'bronze', 'orange']]) { medalIcon(ui, x + 8, my + k * 11 - 1, name); ui.text(x + 22, my + k * 11, formatTime(m[name]), { color: col }); }\n    ui.text(x + w - 8, my, 'YOUR BEST', { align: 'right', color: 'slate' }); ui.text(x + w - 8, my + 11, rec?.best ? formatTime(rec.best) : '--', { align: 'right' }); if (rec?.medal) ui.text(x + w - 8, my + 22, MEDAL_NAME[rec.medal], { align: 'right', color: 'sand' });\n    if (t.assists) ui.text(x + 8, my + 34, Object.entries(t.assists).map(([k, v]) => `${k.toUpperCase()} ${v === false || v === 0 ? 'OFF' : v}`).join('  '), { color: 'red' });\n    if (offer) ui.text(x + 8, my + 44, LINES.arai.offerLine.slice(0, 50), { color: 'lime' });\n    const by = y + 170, bw = Math.floor((w - 22) / 3);\n    ui.button('start', x + 6, by, bw, 18, 'BEGIN', { confirm: () => app.startTest(t.id) });\n    ui.button('demo', x + 11 + bw, by, bw, 18, 'DEMONSTRATION', { confirm: () => app.startTest(t.id, { demo: true }) });\n    ui.button('line', x + 16 + bw * 2, by, bw, 18, app.options.assists.line || this.line ? 'LINE: ON' : 'LINE: OFF', { confirm: () => { this.line = !this.line; app.lineForTest = this.line; }, disabled: !offer && !app.options.assists.line, denied: offer ? null : () => ui.note('THE EXAMINER WILL OFFER THIS AFTER THREE ATTEMPTS.') });\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\n// After each attempt: medal, time, gap to the next medal; Retry, Watch your replay, Demonstration, Back.\nexport class TestResultScreen {\n  constructor(app, o) { this.id = 'testResult'; this.app = app; this.o = o; this.t = 0; }\n  enter(ui) { const o = this.o, lines = LINES.arai, list = o.failed ? lines.fail : (lines[o.medal] ?? lines.fail); ui.say('arai', list[(o.time ? Math.round(o.time * 7) : 3) % list.length]); this.app.mix.sfx(o.medal ? 'medal' : 'denied'); if (o.licenceWon) this.app.mix.sfx('fanfare2'); }\n  draw(ui, dt) {\n    const app = this.app, o = this.o, t = o.test, w = Math.min(ui.w - 40, 280), h = 140, x = Math.round(ui.cx - w / 2), y = 40; this.t += dt;\n    ui.panel(x, y, w, h, { color: 'ink', border: o.medal ? 'sand' : 'red' });\n    ui.text(ui.cx, y + 7, `${t.id} ${t.title}`, { align: 'center', color: 'mist' });\n    if (o.failed) { ui.text(ui.cx, y + 22, 'NOT PASSED', { align: 'center', scale: 2, color: 'red' }); ui.text(ui.cx, y + 44, o.reason, { align: 'center' }); }\n    else {\n      if (o.medal) { medalIcon(ui, ui.cx - 4, y + 19, o.medal); ui.text(ui.cx, y + 31, MEDAL_NAME[o.medal], { align: 'center', scale: 2, color: 'sand' }); }\n      else ui.text(ui.cx, y + 22, 'NO MEDAL', { align: 'center', scale: 2, color: 'red' });\n      ui.text(ui.cx, y + 50, formatTime(o.time), { align: 'center', scale: 2 });\n      if (o.next) ui.text(ui.cx, y + 70, `${(o.time - t.medals[o.next]).toFixed(2)} S FROM ${MEDAL_NAME[o.next]}`, { align: 'center', color: 'mist' });\n    }\n    if (o.licenceWon) ui.text(ui.cx, y + 82, `LICENCE ${LICENCES[t.licence].name} EARNED. +${cr(o.reward)}`, { align: 'center', color: 'lime' });\n    else if (o.prizeCar) ui.text(ui.cx, y + 82, `ALL GOLD. PRIZE: ${CAR_INFO[o.prizeCar].name}`, { align: 'center', color: 'lime' });\n    else if (o.notSaved) ui.text(ui.cx, y + 82, 'NOT RECORDED: DEV SLIDERS ARE OFF THEIR DEFAULTS', { align: 'center', color: 'red' });\n    const by = y + h - 40, bw = Math.floor((w - 18) / 2);\n    ui.button('retry', x + 6, by, bw, 15, 'RETRY', { confirm: () => app.startTest(t.id) });\n    ui.button('replay', x + 12 + bw, by, bw, 15, 'WATCH YOUR REPLAY', { confirm: () => app.watchReplay({ after: () => app.afterTestReplay(this.o) }) });\n    ui.button('demo', x + 6, by + 18, bw, 15, 'DEMONSTRATION', { confirm: () => app.startTest(t.id, { demo: true }) });\n    ui.button('backTo', x + 12 + bw, by + 18, bw, 15, 'BACK', { confirm: () => app.backToTests(t.id, this.o) });\n    if (!this.focus) this.focus = o.medal && !o.failed ? 'backTo' : 'retry';\n    ui.prompts([['confirm', 'CHOOSE']]);\n  }\n  onBack() { this.app.backToTests(this.o.test.id, this.o); return true; }\n}\nvoid testRecord;\nEOF\ncat > src/game/ui/screens/events.js <<'EOF'\n// The Event Hall: events by licence tier, a card for each event, a card for each round, then the green light.\nimport { EVENT_IDS, EVENTS, TIERS } from '../../data/events.js';\nimport { LICENCES } from '../../data/licences.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { CAR_INFO } from '../../data/cars.js';\nimport { carEntry, eligible, eventOpen, eventState, standingsOf } from '../../sim/career.js';\nimport { cr, miniMap, statusStrip } from './common.js';\nconst stageIt = (app) => { app.scene?.stage?.('events', { orbit: false, angle: -0.25, radius: 13, height: 4, lookY: 2, lookX: -2, lookZ: -3, sun: 0.7 }); app.mix.music('lounge'); };\nexport class EventListScreen {\n  constructor(app) { this.id = 'eventList'; this.app = app; this.tab = app.profile.licences.A ? 2 : app.profile.licences.B ? 1 : 0; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, p = app.profile; statusStrip(ui, app); ui.text(10, 20, 'EVENT HALL', { scale: 2, color: 'sand' });\n    const w = Math.min(ui.w - 20, 270), x = ui.w - w - 10;\n    ui.tabs('tier', x, 20, w, TIERS.map((t) => LICENCES[t].name), this.tab, (i) => { this.tab = i; this.focus = null; ui.box.ready = false; });\n    const tier = TIERS[this.tab], list = EVENT_IDS.filter((id) => EVENTS[id].needs[0] === tier);\n    list.forEach((id, k) => {\n      const e = EVENTS[id], st = p.events[id], open = eventOpen(p, id), y = 38 + k * 44, h = 39, f = ui.item(id, x, y, w, h, open.ok ? { confirm: () => ui.push(new EventCardScreen(app, id)) } : { denied: () => ui.note(open.why) });\n      ui.rect(x, y, w, h, open.ok ? (f ? 'navy' : 'night') : 'ink');\n      ui.text(x + 7, y + 6, e.name, { color: open.ok ? 'white' : 'slate' });\n      ui.text(x + 7, y + 17, open.ok ? e.restriction : open.why, { color: open.ok ? 'mist' : 'red' });\n      ui.text(x + 7, y + 28, st?.won ? 'WON' : st?.round ? `ROUND ${st.round + 1}/${e.rounds.length}` : `${e.rounds.length} ROUND${e.rounds.length > 1 ? 'S' : ''}`, { color: st?.won ? 'lime' : st?.round ? 'sand' : 'slate' });\n      ui.text(x + w - 7, y + 28, e.prizeCar ? CAR_INFO[e.prizeCar].short : cr(e.bonus), { align: 'right', color: 'sand' });\n    });\n    ui.prompts([['confirm', 'CHOOSE'], ['tabs', 'TIER'], ['back', 'MAP']]);\n  }\n}\nexport class EventCardScreen {\n  constructor(app, id) { this.id = 'eventCard'; this.app = app; this.eventId = id; this.event = EVENTS[id]; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, e = this.event, p = app.profile, st = eventState(p, this.eventId), car = carEntry(p), ok = car ? eligible(e, car.carId, car.install) : { ok: false, why: 'YOU HAVE NO CAR' }, w = Math.min(ui.w - 20, 340), x = Math.round(ui.cx - w / 2);\n    statusStrip(ui, app); ui.panel(x, 19, w, 204, { color: 'ink', border: 'slate' });\n    ui.text(x + 8, 24, e.name, { color: 'sand' }); ui.lines(x + 8, 35, e.intro, { chars: Math.floor((w - 16) / 6), gap: 9, color: 'mist' });\n    ui.text(x + 8, 57, `RESTRICTION: ${e.restriction}`);\n    ui.text(x + 8, 67, `1ST PRIZE ${cr(e.prize)}`, { color: 'mist' }); ui.text(x + w - 8, 67, e.prizeCar ? `SERIES: ${CAR_INFO[e.prizeCar].short}` : `SERIES: ${cr(e.bonus)}`, { align: 'right', color: 'sand' });\n    // Rounds with mini-maps.\n    const n = e.rounds.length, cw = Math.floor((w - 16) / n);\n    e.rounds.forEach((r, k) => { const cx = x + 8 + k * cw, next = k === st.round; ui.rect(cx, 80, cw - 3, 56, next ? 'navy' : 'night'); miniMap(ui, cx + 3, 83, r.track, 30, next ? 'sand' : 'mist'); ui.text(cx + 3, 118, `${TRACKS[r.track].name.split(' ')[0].toUpperCase().slice(0, Math.floor((cw - 8) / 6))}`, { color: 'white' }); ui.text(cx + 3, 127, `${r.laps} LAPS${r.rain ? ' RAIN' : r.hourEnd ? ' NIGHT' : ''}`, { color: 'mist' }); });\n    const stand = standingsOf(p, this.eventId); if (stand.length) { const pos = stand.findIndex(([n2]) => n2 === 'YOU') + 1; ui.text(x + 8, 140, `STANDINGS: YOU ARE ${pos} OF ${stand.length} WITH ${stand[pos - 1]?.[1] ?? 0} POINTS.`, { color: 'sand' }); }\n    ui.text(x + 8, 152, `YOUR CAR: ${car ? CAR_INFO[car.carId].short : 'NONE'}`); if (!ok.ok) ui.text(x + 8, 162, `IT DOES NOT QUALIFY: ${ok.why}`, { color: 'red' }); else if (e.rally && car && car.install.tyre !== 'rally') ui.text(x + 8, 162, 'DIRT TYRES ARE ADVISED. TUNING STREET HAS THEM.', { color: 'orange' }); else ui.text(x + 8, 162, 'IT QUALIFIES.', { color: 'lime' });\n    const by = 186, bw = Math.floor((w - 22) / 3);\n    ui.button('start', x + 6, by, bw, 18, st.round ? `ROUND ${st.round + 1}` : 'ENTER', { confirm: () => ui.push(new RoundCardScreen(app, this.eventId)), denied: ok.ok ? null : () => ui.note(`THE CAR DOES NOT QUALIFY. ${ok.why}`) });\n    ui.button('garage', x + 11 + bw, by, bw, 18, 'CHANGE CAR', { confirm: () => app.openGarageFromEvent(ui) });\n    ui.button('tune', x + 16 + bw * 2, by, bw, 18, 'TUNING STREET', { confirm: () => app.openTuningFromEvent(ui) });\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\nexport class RoundCardScreen {\n  constructor(app, id) { this.id = 'roundCard'; this.app = app; this.eventId = id; this.event = EVENTS[id]; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, e = this.event, st = eventState(app.profile, this.eventId), r = e.rounds[st.round], def = TRACKS[r.track], w = Math.min(ui.w - 20, 300), x = Math.round(ui.cx - w / 2), hour = r.hour ?? def.hour;\n    ui.panel(x, 30, w, 160, { color: 'ink', border: 'sand' });\n    ui.text(ui.cx, 36, `ROUND ${st.round + 1} OF ${e.rounds.length}`, { align: 'center', color: 'mist' });\n    ui.text(ui.cx, 47, def.name.toUpperCase(), { align: 'center', scale: 2, color: 'sand' });\n    const m = miniMap(ui, x + 12, 72, r.track, 72, 'white');\n    ui.text(x + 100, 74, `${r.laps} LAPS`); ui.text(x + 100, 85, `${(m.length / 1000).toFixed(2)} KM`, { color: 'mist' }); ui.text(x + 100, 96, `${m.corners} CORNERS`, { color: 'mist' }); ui.text(x + 100, 107, `${String(Math.floor(hour)).padStart(2, '0')}:${hour % 1 ? '30' : '00'}${r.rain ? ', RAIN' : ''}`, { color: r.rain ? 'sky' : 'mist' }); ui.text(x + 100, 118, e.rally ? 'ONE RIVAL. THE CLOCK DECIDES.' : `FIELD OF ${e.field}. ROLLING START.`, { color: 'mist' });\n    if (e.endurance) ui.text(x + 100, 129, 'ONE STOP NEEDED. KEEP RIGHT TO PIT.', { color: 'sand' });\n    ui.button('go', ui.cx - 60, 164, 120, 18, 'TO THE START', { confirm: () => app.startEventRound(this.eventId) });\n    ui.prompts([['confirm', 'RACE'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/game/ui/screens/dealer.js <<'EOF'\n// Dealer Row: the used lot and three showrooms. Turntable under lamps, slow orbit, the attendant's voice.\nimport { CAR_INFO, MARQUES, SHOWROOMS } from '../../data/cars.js';\nimport { LINES } from '../../data/text.js';\nimport { buyCar, carPriceOpen } from '../../sim/career.js';\nimport { cr, specCard, statusStrip } from './common.js';\nexport class DealerScreen {\n  constructor(app, o = {}) { this.id = 'dealer'; this.app = app; this.room = 0; this.car = 0; this.o = o; this.brochure = false; this.noBack = !!o.first; }\n  enter(ui) { this.show(); this.app.mix.music('catalogue'); ui.say('fenn', LINES.fenn.hello); }\n  resume() { this.show(); this.app.mix.music('catalogue'); }\n  get list() { return SHOWROOMS[this.room].cars; }\n  show(sound = false) { const app = this.app, id = this.list[this.car % this.list.length]; app.scene?.stage?.('showroom', { showroom: this.room, car: { carId: id, install: null }, person: 'fenn', personClip: 'DealerPresent', personAt: [-4.6, 0, 1.8], personYaw: 1.1, radius: 7.8, height: 2.5 }); this.brochure = false; if (sound) { app.mix.sfx('whirr'); const line = CAR_INFO[id].fenn; app.ui.say('fenn', line); app.profile.seen[id] = true; } }\n  next(d) { this.car = (this.car + d + this.list.length) % this.list.length; this.show(true); }\n  nextRoom(d) { this.room = (this.room + d + SHOWROOMS.length) % SHOWROOMS.length; this.car = 0; this.show(true); }\n  draw(ui) {\n    const app = this.app, p = app.profile, room = SHOWROOMS[this.room], id = this.list[this.car % this.list.length], i = CAR_INFO[id], open = carPriceOpen(p, id), can = open && p.credits >= i.price, owned = p.cars.some((c) => c.carId === id);\n    statusStrip(ui, app); ui.text(10, 19, room.name, { color: 'sand', scale: 2 }); ui.text(10, 37, room.line, { color: 'mist' });\n    const w = 150, x = ui.w - w - 8; let y = 20;\n    const foot = open ? cr(i.price) : i.after ? `AFTER LICENCE ${i.after}` : 'NOT FOR SALE';\n    y += specCard(ui, x, y, w, id, null, { foot, footColor: can ? 'sand' : 'red' }) + 4;\n    if (owned) ui.text(x + w, y, 'YOU OWN ONE', { align: 'right', color: 'lime' });\n    if (this.brochure) { const lines = i.text, bw = Math.min(ui.w - 16, 340), bx = 8, by = ui.h - 36 - 16 - lines.length * 10; ui.panel(bx, by, bw, 14 + lines.length * 10 + 2, { color: 'ink', border: 'sand' }); ui.text(bx + 6, by + 3, MARQUES[i.marque].name, { color: 'sand' }); lines.forEach((l, k) => ui.text(bx + 6, by + 13 + k * 10, l)); }\n    // A dot per car.\n    this.list.forEach((c, k) => ui.rect(10 + k * 8, 48, 6, 3, k === this.car ? 'sand' : 'slate'));\n    const by = ui.h - 36;\n    const buy = () => { const r = buyCar(p, id); if (!r.ok) { app.mix.sfx('denied'); ui.say('fenn', r.why === 'money' ? LINES.fenn.poor : LINES.fenn.lowLicence); return; } app.save(); app.mix.sfx('register'); ui.say('fenn', LINES.fenn.bought); if (app.scene?.car) app.scene.car.settle = 0.16; if (this.o.first) { this.o.first = false; this.noBack = false; ui.note('A CAR. THE MAP IS OPEN.'); } };\n    ui.item('car', 8, by, 110, 16, { noBox: false, confirm: buy, onX: (d) => this.next(d), denied: can ? null : () => { app.mix.sfx('denied'); ui.say('fenn', open ? LINES.fenn.poor : LINES.fenn.lowLicence); } });\n    ui.rect(8, by, 110, 16, ui.focused('car') ? 'navy' : 'night'); ui.text(63, by + 5, can ? `BUY FOR ${cr(i.price)}` : open ? 'TOO DEAR FOR NOW' : 'NOT YET', { align: 'center', color: can ? 'white' : 'slate' });\n    ui.prompts([['confirm', 'BUY'], ['moveX', 'NEXT CAR'], ['tabs', 'SHOWROOM'], ['info', 'BROCHURE'], ['alt', 'TEST DRIVE'], ['back', 'MAP']]);\n    if (app.actions.pressed('tabL')) this.nextRoom(-1); if (app.actions.pressed('tabR')) this.nextRoom(1);\n  }\n  onInfo() { this.brochure = !this.brochure; this.app.mix.sfx('tick'); }\n  onAlt() { const id = this.list[this.car % this.list.length]; this.app.startTestDrive(id, null, { from: 'dealer', room: this.room, car: this.car, first: this.o.first }); }\n  onBack(ui) { if (this.o.first && !this.app.profile.cars.length) { this.app.mix.sfx('denied'); ui.note('YOU WILL NEED A CAR FIRST.'); return false; } ui.pop(); return true; }\n}\nEOF\ncat > src/game/ui/screens/tuning.js <<'EOF'\n// Tuning Street: eight tiles, four to a page; then the parts in a tile, with an effect in plain words and a before/after number.\n// A Setup tab holds the sliders for what you own. Buying an engine part shows a dyno pull.\nimport { CAR_INFO } from '../../data/cars.js';\nimport { PAINT_PRICE, PART_IDS, PARTS, RIM_PRICE, SETUP_SLIDERS, TILES } from '../../data/parts.js';\nimport { LINES } from '../../data/text.js';\nimport { TYRE_IDS, TYRES } from '../../data/tyres.js';\nimport { PAINTS, RIM_STYLES } from '../../data/meta.js';\nimport { buyPaint, buyPart, buyRims, buyTyre, carEntry, setSetup } from '../../sim/career.js';\nimport { dynoCurve, hasPart, setupValue, sliderAvailable, specOf } from '../../sim/tuning.js';\nimport { engineData } from '../../audio/mix.js';\nimport { cr, specCard, statusStrip } from './common.js';\nconst stageIt = (app, car) => { app.scene?.stage?.('bay', { car: { carId: car.carId, install: car.install, dirt: car.dirt, y: 0.08 }, person: 'benno', personClip: 'MechanicWipe', personAt: [4.6, 0, 0.8], personYaw: -1.2, radius: 7.8, height: 2.3, sun: 0.7 }); app.mix.music('socket'); };\nconst SAY = { engine: 'engine', weight: 'weight', tyres: 'tyres', brakes: 'brakes', suspension: 'susp', drivetrain: 'drive', body: 'body' };\nexport class TuningScreen {\n  constructor(app) { this.id = 'tuning'; this.app = app; this.tab = 0; this.page = 0; }\n  enter(ui) { const c = carEntry(this.app.profile); stageIt(this.app, c); ui.say('benno', LINES.benno.hello); }\n  resume() { stageIt(this.app, carEntry(this.app.profile)); }\n  draw(ui) {\n    const app = this.app, car = carEntry(app.profile); statusStrip(ui, app);\n    ui.text(10, 19, 'TUNING STREET', { scale: 2, color: 'sand' });\n    const w = 150, x = ui.w - w - 8; specCard(ui, x, 20, w, car.carId, car.install, { extra: [['GRIP', (specOf(car.carId, car.install).tyreMu).toFixed(2)], ['DOWNFORCE', (specOf(car.carId, car.install).clA).toFixed(2)]] });\n    const lw = Math.min(ui.w - w - 26, 170), lx = 8;\n    ui.tabs('t', lx, 38, lw, ['PARTS', 'SETUP'], this.tab, (i) => { this.tab = i; this.focus = null; ui.box.ready = false; });\n    if (this.tab === 0) {\n      const pages = 2, list = TILES.slice(this.page * 4, this.page * 4 + 4);\n      list.forEach((t, k) => { const tw = (lw - 4) / 2, xx = lx + (k % 2) * (tw + 4), yy = 54 + Math.floor(k / 2) * 52, f = ui.item(t.id, xx, yy, tw, 48, { confirm: () => ui.push(new PartsScreen(app, t.id)) }); ui.rect(xx, yy, tw, 48, f ? 'navy' : 'night'); ui.text(xx + 5, yy + 6, t.name, { color: f ? 'sand' : 'white' }); ui.lines(xx + 5, yy + 17, t.line, { chars: Math.floor((tw - 10) / 6), gap: 9, color: 'mist' }); });\n      const nav = (d) => { this.page = (this.page + d + pages) % pages; this.focus = null; ui.box.ready = false; };\n      ui.button('more', lx, 160, lw, 14, this.page === 0 ? 'MORE: TILES 5 TO 8' : 'BACK TO TILES 1 TO 4', { confirm: () => nav(1) });\n    } else {\n      const sliders = SETUP_SLIDERS.filter((s) => sliderAvailable(car.install, s));\n      if (!sliders.length) ui.lines(lx + 4, 60, 'NOTHING TO SET YET. BUY A RACE GEARBOX, AN LSD, SUSPENSION, RACE BRAKES OR A WING, AND THE SETTING APPEARS HERE.', { chars: Math.floor((lw - 8) / 6), gap: 10, color: 'mist' });\n      sliders.forEach((s, k) => { const y = 54 + k * 22; ui.slider(s.id, lx, y, lw, 13, s.name, setupValue(car.install, s.id), s.min, s.max, { step: s.step * (s.step < 0.02 ? 2 : 1), barW: 48, valueW: 26, set: (v) => { setSetup(car, s.id, v); app.save(); }, reset: () => { setSetup(car, s.id, s.def); app.save(); }, format: (v) => v.toFixed(2) }); if (ui.focused(s.id)) { ui.text(lx + 2, y + 14, `${s.low} TO ${s.high}`, { color: 'sand' }); this.help = s.line; } });\n      if (this.help && sliders.length) ui.lines(lx, Math.min(ui.h - 62, 54 + sliders.length * 22 + 6), this.help, { chars: Math.floor(lw / 6), gap: 9, color: 'mist' });\n    }\n    ui.prompts([['confirm', 'CHOOSE'], ['tabs', 'TAB'], ['alt', 'TEST DRIVE'], ['back', 'MAP']]);\n  }\n  onAlt() { const c = carEntry(this.app.profile); this.app.startTestDrive(c.carId, c.install, { from: 'tuning', uid: c.uid }); }\n}\nconst PER_PAGE = 5;\nexport class PartsScreen {\n  constructor(app, tile) { this.id = 'parts'; this.app = app; this.tile = tile; this.page = 0; }\n  resume() { stageIt(this.app, carEntry(this.app.profile)); }\n  items(car) {\n    if (this.tile === 'tyres') return TYRE_IDS.map((id) => { const t = TYRES[id]; return { id, name: t.name, line: t.line, price: t.price, owned: car.install.tyres.includes(id), on: car.install.tyre === id, kind: 'tyre', after: `GRIP ${t.tyreMu.toFixed(2)}`, before: `GRIP ${specOf(car.carId, car.install).tyreMu.toFixed(2)}` }; });\n    if (this.tile === 'body') return [{ id: 'paint', name: 'PAINT', line: 'ANY OF THE SIXTEEN COLOURS. LEFT AND RIGHT TO CHOOSE.', price: PAINT_PRICE, kind: 'paint', value: car.install.paint }, { id: 'rims', name: 'RIMS', line: 'FOUR STYLES. LEFT AND RIGHT TO CHOOSE.', price: RIM_PRICE, kind: 'rims', value: RIM_STYLES[car.install.rims] }];\n    return PART_IDS.filter((id) => PARTS[id].cat === this.tile).map((id) => { const P = PARTS[id], s0 = specOf(car.carId, car.install), tmp = { ...car.install, owned: [...new Set([...car.install.owned, id])], on: P.group ? { ...car.install.on, [P.group]: id } : car.install.on }, s1 = specOf(car.carId, tmp); const change = (a, b, u) => (a !== b ? `${a} TO ${b} ${u}` : null); return { id, name: P.name, line: P.line, price: P.price, owned: car.install.owned.includes(id), on: hasPart(car.install, id), kind: 'part', group: P.group, delta: change(s0.ps, s1.ps, 'PS') ?? change(s0.kg, s1.kg, 'KG') ?? (s1.clA !== s0.clA ? `DOWNFORCE ${s1.clA.toFixed(2)}` : s1.brakeG !== s0.brakeG ? `BRAKES ${s1.brakeG.toFixed(2)} G` : s1.shift !== s0.shift ? `SHIFT ${s1.shift.toFixed(2)} S` : null) }; });\n  }\n  draw(ui) {\n    const app = this.app, car = carEntry(app.profile), all = this.items(car), pages = Math.max(1, Math.ceil(all.length / PER_PAGE)), list = all.slice(this.page * PER_PAGE, this.page * PER_PAGE + PER_PAGE), tile = TILES.find((t) => t.id === this.tile), w = Math.min(ui.w - 18, 300), x = 8;\n    statusStrip(ui, app); ui.text(x, 19, tile.name, { scale: 2, color: 'sand' }); if (pages > 1) ui.text(x + w, 25, `PAGE ${this.page + 1}/${pages}`, { align: 'right', color: 'slate' });\n    list.forEach((it, k) => {\n      const y = 38 + k * 34, h = 30;\n      const onX = it.kind === 'paint' ? (d) => { const n = PAINTS.indexOf(this.paintPick ?? car.install.paint), v = PAINTS[(n + d + PAINTS.length) % PAINTS.length]; this.paintPick = v; app.scene?.showCar(car.carId, car.install, { paint: v, y: 0.08 }); } : it.kind === 'rims' ? (d) => { this.rimPick = ((this.rimPick ?? car.install.rims) + d + RIM_STYLES.length) % RIM_STYLES.length; } : null;\n      const confirm = () => this.buy(ui, car, it), f = ui.item(it.id, x, y, w, h, { confirm, onX, quiet: true });\n      ui.rect(x, y, w, h, f ? 'navy' : 'night');\n      ui.text(x + 6, y + 5, it.name, { color: it.on ? 'lime' : f ? 'white' : 'mist' }); ui.text(x + 6, y + 16, it.line, { color: 'slate' });\n      if (it.kind === 'paint') { const v = this.paintPick ?? car.install.paint; ui.text(x + w - 6, y + 5, `< ${v.toUpperCase()} >`, { align: 'right', color: v === car.install.paint ? 'lime' : 'sand' }); }\n      else if (it.kind === 'rims') { const v = this.rimPick ?? car.install.rims; ui.text(x + w - 6, y + 5, `< ${RIM_STYLES[v]} >`, { align: 'right', color: v === car.install.rims ? 'lime' : 'sand' }); }\n      else ui.text(x + w - 6, y + 5, it.on ? 'FITTED' : it.owned ? 'OWNED' : cr(it.price), { align: 'right', color: it.on ? 'lime' : it.owned ? 'sky' : app.profile.credits >= it.price ? 'sand' : 'red' });\n      if (f && it.delta) ui.text(x + w - 6, y + 16, it.delta, { align: 'right', color: 'white' });\n    });\n    if (pages > 1) ui.button('morePage', x, 38 + PER_PAGE * 34, w, 13, 'NEXT PAGE', { confirm: () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; } });\n    ui.prompts([['confirm', 'FIT'], ['moveX', 'CHOOSE'], ['alt', 'TEST DRIVE'], ['back', 'BACK']]);\n  }\n  buy(ui, car, it) {\n    const app = this.app, p = app.profile; let r;\n    if (it.kind === 'tyre') r = buyTyre(p, car, it.id); else if (it.kind === 'part') r = buyPart(p, car, it.id); else if (it.kind === 'paint') r = buyPaint(p, car, this.paintPick ?? car.install.paint); else r = buyRims(p, car, this.rimPick ?? car.install.rims);\n    if (!r.ok) { app.mix.sfx('denied'); if (r.why === 'money') ui.note('NOT ENOUGH CREDITS.'); return; }\n    app.save(); app.mix.sfx(r.swapped ? 'confirm' : 'register');\n    const s = app.scene; s?.showCar(car.carId, car.install, { y: 0.08, dirt: car.dirt });\n    if (r.swapped) return;\n    if (this.tile === 'aero' && it.id === 'aeroWing') ui.say('benno', LINES.benno.wing); else if (SAY[this.tile]) ui.say('benno', LINES.benno[SAY[this.tile]]);\n    if (this.tile === 'engine') { const before = this.prevInstall(car, it.id); ui.push(new DynoScreen(app, car, before)); }\n  }\n  prevInstall(car, id) { const P = PARTS[id], i = { ...car.install, owned: car.install.owned.filter((x) => x !== id), on: { ...car.install.on } }; if (P.group) i.on[P.group] = null; return i; }\n  onAlt() { const c = carEntry(this.app.profile); this.app.startTestDrive(c.carId, c.install, { from: 'parts', tile: this.tile, uid: c.uid }); }\n}\n// The dyno: the car on rollers, wheels spinning, the curve drawn live, the exhaust shaking, the engine rising.\nexport class DynoScreen {\n  constructor(app, car, before, o = {}) { this.id = 'dyno'; this.app = app; this.car = car; this.t = 0; this.curveA = dynoCurve(car.carId, before); this.curveB = dynoCurve(car.carId, car.install); this.max = Math.max(...this.curveB.map((p) => p.ps), ...this.curveA.map((p) => p.ps)); this.o = o; this.p = { turbo: specOf(car.carId, car.install).turbo, redline: specOf(car.carId, car.install).redline, idle: 900 }; }\n  enter() { const a = this.app, s = a.scene; s.stageOpts = { ...s.stageOpts, carFixed: true, carX: 0, carZ: 0, carYaw: Math.PI / 2 + 0.3 }; s.camPos.set(s.base.x - 5.6, 1.9, s.base.z + 5.4); s.wantPos.copy(s.camPos); s.orbitOn = false; s.radius = 7.8; s.orbit = -0.8; s.height = 1.9; a.mix.sfx('confirm'); }\n  exit() { const a = this.app, s = a.scene; a.mix.clearCars(); if (s?.stageOpts) { s.stageOpts.carFixed = false; s.orbitOn = true; s.carSpin = 0; if (s.car) s.car.shake = 0; } }\n  draw(ui, dt) {\n    const app = this.app, s = app.scene, dur = 5.5; this.t += dt; const f = Math.min(1, this.t / dur), n = this.curveB.length - 1, k = Math.round(f * n), pt = this.curveB[k];\n    if (s?.car) { s.carSpin = 14 + f * 70; s.car.shake = f < 1 ? 0.006 : 0; if (Math.floor(this.t * 6) !== Math.floor((this.t - dt) * 6) && f < 1) app.ctx.particles.burst('exhaustPop', [s.car.object.position.x - 2, 0.4, s.car.object.position.z - 0.6]); }\n    const w = Math.min(ui.w - 30, 300), h = 120, x = Math.round(ui.cx - w / 2), y = 24;\n    ui.panel(x, y, w, h + 22, { color: 'ink', border: 'sand' }); ui.text(x + 6, y + 4, `DYNO: ${CAR_INFO[this.car.carId].short}`, { color: 'sand' }); ui.text(x + w - 6, y + 4, `${Math.round(pt.ps)} PS`, { align: 'right', scale: 1 });\n    const plotX = x + 8, plotY = y + 15, pw = w - 16, ph = h - 6, redlineX = 1;\n    for (let g = 0; g <= 4; g++) ui.rect(plotX, plotY + (g * ph) / 4, pw, 1, 'night');\n    const P = (c, i) => [plotX + Math.round((i / n) * pw), plotY + ph - Math.round((c.ps / this.max) * ph * 0.95)];\n    for (let i = 0; i <= n; i++) { const [a, b] = P(this.curveA[i], i); ui.rect(a, b, 2, 2, 'slate'); }\n    for (let i = 0; i <= k; i++) { const [a, b] = P(this.curveB[i], i); ui.rect(a, b, 2, 2, 'lime'); }\n    ui.text(plotX, y + h + 8, 'BEFORE', { color: 'slate' }); ui.text(plotX + 44, y + h + 8, 'AFTER', { color: 'lime' }); ui.text(x + w - 6, y + h + 8, `${Math.round(pt.rpm)} RPM`, { align: 'right', color: 'mist' });\n    app.mix.engines([{ key: 'dyno', carId: this.car.carId, p: { ...this.p, sportExhaust: this.car.install.owned.includes('exhaust') }, rpm: f < 1 ? pt.rpm : 900, throttle: f < 1 ? 1 : 0.05, spool: f, gain: 1, pan: 0 }], dt);\n    ui.button('done', ui.cx - 40, ui.h - 36, 80, 14, f < 1 ? 'WAIT' : 'THANK YOU', { confirm: () => ui.pop() });\n    ui.prompts([['confirm', 'CLOSE']]);\n    void redlineX;\n  }\n}\nEOF\ncat > src/game/ui/screens/service.js <<'EOF'\n// The Service Bay: oil and soap, with short animations and a word from Benno.\nimport { CAR_INFO } from '../../data/cars.js';\nimport { LINES } from '../../data/text.js';\nimport { carEntry, changeOil, oilOf, OIL_PRICE, WASH_PRICE, washCar } from '../../sim/career.js';\nimport { PALETTE, THREE, toonMaterial } from '../../../pixel-engine.js';\nimport { cr, statusStrip } from './common.js';\nconst { CylinderGeometry, Mesh } = THREE;\nexport class ServiceScreen {\n  constructor(app) { this.id = 'service'; this.app = app; this.anim = null; }\n  stageIt() { const a = this.app, c = carEntry(a.profile); a.scene?.stage?.('service', { car: { carId: c.carId, install: c.install, dirt: c.dirt, y: 0 }, carFixed: true, carYaw: 0, person: 'benno', personClip: 'MechanicWipe', personAt: [4.4, 0, 2.4], personYaw: -1.0, orbit: false, angle: 0.55, radius: 9, height: 2.8, sun: 0.75 }); a.mix.music('socket'); }\n  enter(ui) { this.stageIt(); const c = carEntry(this.app.profile), o = oilOf(c); ui.say('benno', o < 1 ? LINES.benno.oilTired : LINES.benno.oilFresh); }\n  resume() { this.stageIt(); }\n  exit() { this.removeBrushes(); }\n  removeBrushes() { if (this.brushes) { for (const b of this.brushes) b.removeFromParent(); this.brushes = null; } }\n  draw(ui, dt) {\n    const app = this.app, p = app.profile, car = carEntry(p), oil = oilOf(car), w = Math.min(ui.w - 18, 190), x = 8;\n    statusStrip(ui, app); ui.text(x, 19, 'SERVICE BAY', { scale: 2, color: 'sand' }); ui.text(x, 37, CAR_INFO[car.carId].short, { color: 'mist' });\n    const oilText = oil > 1 ? 'FRESH: +2% POWER' : oil === 1 ? `FINE. ${Math.round(car.kmOil)} KM SINCE A CHANGE` : `TIRED: ${Math.round((oil - 1) * 100)}% POWER`, dirtText = car.dirt > 0.02 ? `${Math.round(car.dirt * 100)}% MUD` : 'CLEAN';\n    const A = [['oil', 'OIL CHANGE', OIL_PRICE, oilText, oil < 1 ? 'red' : 'lime'], ['wash', 'CAR WASH', WASH_PRICE, dirtText, car.dirt > 0.02 ? 'orange' : 'lime']];\n    A.forEach(([id, name, price, info, col], k) => { const y = 52 + k * 42, h = 37, f = ui.item(id, x, y, w, h, { confirm: () => this.act(ui, id, car), quiet: true }); ui.rect(x, y, w, h, f ? 'navy' : 'night'); ui.text(x + 6, y + 5, name, { color: f ? 'sand' : 'white' }); ui.text(x + w - 6, y + 5, cr(price), { align: 'right', color: p.credits >= price ? 'sand' : 'red' }); ui.text(x + 6, y + 16, info, { color: col }); if (id === 'wash') ui.text(x + 6, y + 26, 'NO EFFECT ON PERFORMANCE.', { color: 'slate' }); else ui.text(x + 6, y + 26, `${Math.round(car.km)} KM ON THE CLOCK`, { color: 'slate' }); });\n    ui.prompts([['confirm', 'DO IT'], ['back', 'MAP']]);\n    if (this.anim) this.anim(dt);\n  }\n  act(ui, id, car) {\n    const app = this.app, p = app.profile;\n    if (this.anim) return;\n    if (id === 'oil') { const before = oilOf(car), r = changeOil(p, car); if (!r.ok) { app.mix.sfx('denied'); ui.note('NOT ENOUGH CREDITS.'); return; } app.save(); app.mix.sfx('register'); ui.say('benno', LINES.benno.oilDone); this.dripAnim(before); return; }\n    const had = car.dirt, r = washCar(p, { ...car, dirt: car.dirt, wash: 0, install: car.install }); if (!r.ok) { app.mix.sfx('denied'); ui.note('NOT ENOUGH CREDITS.'); return; }\n    ui.say('benno', had > 0.02 ? LINES.benno.wash : LINES.benno.washClean); app.mix.sfx('register'); this.washAnim(car, had);\n  }\n  dripAnim() { const app = this.app, s = app.scene, ctx = app.ctx; let t = 0; this.anim = (dt) => { t += dt; if (s?.car && t < 1.4) { s.car.jack = Math.min(0.5, t) * 0.8; ctx.particles.burst({ count: [1, 1], life: [0.25, 0.4], speed: [0, 0], gravity: 10, size: [1, 1], colors: ['ink', 'plum'] }, [s.base.x, 0.45, s.base.z + 0.8]); } else if (s?.car) { s.car.jack = Math.max(0, s.car.jack - dt); if (s.car.jack <= 0) this.anim = null; } else this.anim = null; }; }\n  washAnim(car, had) {\n    // Spinning brushes travel the car, foam flies, and the mud dissolves pixel by pixel.\n    const app = this.app, s = app.scene, ctx = app.ctx, base = s.base;\n    this.removeBrushes(); this.brushes = [-1.3, 1.3].map((sx) => { const m = new Mesh(new CylinderGeometry(0.4, 0.4, 2.2, 8), toonMaterial(PALETTE.lime)); m.position.set(base.x + sx, 1.1, base.z - 3.6); ctx.scene.add(m); return m; });\n    let t = 0; const dur = 4;\n    app.mix.sfx('splash');\n    this.anim = (dt) => {\n      t += dt; const f = Math.min(1, t / dur), z = base.z - 3.6 + 7.2 * (f < 0.5 ? f * 2 : 2 - f * 2);\n      for (const b of this.brushes) { b.position.z = z; b.rotation.y += dt * 12; ctx.particles.burst('foam', [b.position.x, 0.4 + Math.random() * 1.2, z]); }\n      if (Math.floor(t * 3) !== Math.floor((t - dt) * 3)) app.mix.sfx('brush');\n      if (s?.car) s.car.setDirt(had * (1 - f));\n      if (f >= 1) { car.dirt = 0; car.wash = (car.wash ?? 0) + 1; app.save(); this.removeBrushes(); this.anim = null; }\n    };\n  }\n}\nEOF\ncat > src/game/ui/screens/garage.js <<'EOF'\n// The Home Garage: your cars on a turntable with mileage, oil and setup; choose your ride; sell. A trophy shelf and your statistics.\nimport { CAR_INFO } from '../../data/cars.js';\nimport { EVENTS } from '../../data/events.js';\nimport { LICENCES } from '../../data/licences.js';\nimport { LAST_CAR, LINES, PRIZE_SELL } from '../../data/text.js';\nimport { collectedShare, oilOf, sellCar, sellValue, setCurrent } from '../../sim/career.js';\nimport { PALETTE, THREE, toonMaterial } from '../../../pixel-engine.js';\nimport { GeoBatch } from '../../render/geo.js';\nimport { cr, Dialog, num, specCard, statusStrip } from './common.js';\nconst { Group } = THREE;\nexport class GarageScreen {\n  constructor(app, o = {}) { this.id = 'garage'; this.app = app; this.tab = 0; this.index = 0; this.o = o; }\n  enter() { this.index = Math.max(0, this.app.profile.cars.findIndex((c) => c.uid === this.app.profile.current)); this.show(); this.app.mix.music('lounge'); }\n  resume() { this.show(); }\n  exit() { this.shelf?.removeFromParent(); }\n  show() {\n    const app = this.app, cars = app.profile.cars, c = cars[Math.min(this.index, cars.length - 1)], s = app.scene; if (!c) return;\n    s?.stage?.('garage', { car: { carId: c.carId, install: c.install, dirt: c.dirt, y: 0.18 }, radius: 8, height: 2.6, angle: 0.4 });\n    this.buildShelf();\n  }\n  buildShelf() { // A 3D cup or medal for every win.\n    const app = this.app, s = app.scene; this.shelf?.removeFromParent(); const list = app.profile.trophies; if (!s?.base) return;\n    const b = new GeoBatch(); list.slice(0, 27).forEach((t, k) => { const x = -9 + (k % 9) * 2.2, row = Math.floor(k / 9), y = 1.3 + row * 2, z = -11.2; if (t.kind === 'cup') { b.cone(x, y, z, 0.3, 0.15, 6, 'slate', 0.3); b.cone(x, y + 0.15, z, 0.08, 0.3, 6, 'sand', 0.08); b.cone(x, y + 0.45, z, 0.14, 0.5, 8, 'sand', 0.34); } else if (t.kind === 'helmet') { b.ball(x, y + 0.34, z, 0.34, 'sand', 8, 0.9); b.box(x, y + 0.26, z + 0.18, 0.46, 0.16, 0.2, 'ink'); } else { b.box(x, y, z, 0.5, 0.06, 0.3, 'slate'); b.box(x, y + 0.06, z, 0.4, 0.55, 0.06, t.id === 'A' ? 'sand' : t.id === 'B' ? 'mist' : 'orange'); } });\n    if (b.triangles) { this.shelf = new Group(); this.shelf.add(b.mesh({ cast: true, receive: false })); this.shelf.position.copy(s.base); s.sets.root.add(this.shelf); }\n    void toonMaterial; void PALETTE;\n  }\n  draw(ui) {\n    const app = this.app, p = app.profile; statusStrip(ui, app); ui.text(8, 19, 'HOME GARAGE', { scale: 2, color: 'sand' });\n    ui.tabs('t', 8, 38, 170, ['CARS', 'TROPHIES', 'STATISTICS'], this.tab, (i) => { this.tab = i; this.focus = null; ui.box.ready = false; });\n    if (this.tab === 0) this.cars(ui, p); else if (this.tab === 1) this.trophies(ui, p); else this.stats(ui, p);\n  }\n  cars(ui, p) {\n    const app = this.app, cars = p.cars; if (this.index >= cars.length) this.index = cars.length - 1; const c = cars[this.index], cur = p.current === c.uid, w = 150, x = ui.w - w - 8, o = oilOf(c);\n    specCard(ui, x, 20, w, c.carId, c.install, { extra: [['ODOMETER', `${num(c.km)} KM`], ['OIL', o > 1 ? 'FRESH' : o === 1 ? 'FINE' : `${Math.round((o - 1) * 100)}%`]], foot: `${this.index + 1} OF ${cars.length}`, footColor: 'slate' });\n    const nav = (d) => { this.index = (this.index + d + cars.length) % cars.length; this.show(); app.mix.sfx('whirr'); }, by = 56;\n    ui.button('drive', 8, by, 170, 18, cur ? 'THIS IS YOUR RIDE' : 'CHOOSE THIS CAR', { confirm: () => { setCurrent(p, c.uid); app.save(); if (this.o.onChoose) this.o.onChoose(ui); }, onX: nav, color: cur ? 'lime' : 'white', right: null });\n    ui.button('sell', 8, by + 22, 170, 15, c.prize ? 'NOT FOR SALE' : `SELL FOR ${cr(sellValue(c))}`, { confirm: () => this.sell(ui, c), onX: nav });\n    ui.text(8, by + 42, '< > NEXT CAR', { color: 'slate' });\n    ui.prompts([['confirm', 'CHOOSE'], ['moveX', 'NEXT CAR'], ['tabs', 'TAB'], ['back', 'BACK']]);\n  }\n  sell(ui, c) {\n    const app = this.app, p = app.profile;\n    if (c.prize) { ui.note(PRIZE_SELL); app.mix.sfx('denied'); return; }\n    if (p.cars.length <= 1) { ui.note(LAST_CAR); app.mix.sfx('denied'); return; }\n    const d = new Dialog(app, `SELL THE ${CAR_INFO[c.carId].short}?`, [`YOU WILL RECEIVE ${cr(sellValue(c))}.`], [['no', 'KEEP', () => ui.pop()], ['yes', 'SELL', () => { sellCar(p, c.uid); app.save(); app.mix.sfx('register'); ui.pop(); this.index = 0; this.show(); ui.say('fenn', LINES.fenn.sold); }]]); d.under = this; d.focus = 'no'; ui.push(d);\n  }\n  trophies(ui, p) {\n    const names = p.trophies.map((t) => (t.kind === 'cup' ? EVENTS[t.id].name : t.kind === 'helmet' ? 'THE GOLD HELMET' : `${LICENCES[t.id].name} LICENCE`)), w = Math.min(ui.w - 16, 260);\n    if (!names.length) ui.lines(8, 58, 'THE SHELF IS EMPTY. IT HAS BEEN DUSTED ANYWAY.', { chars: 40, color: 'mist' });\n    ui.panel(8, 56, w, 12 + Math.min(14, names.length) * 10, { color: 'ink', border: false, scan: true });\n    names.slice(0, 14).forEach((n, k) => ui.text(14, 60 + k * 10, n, { color: 'sand' }));\n    ui.prompts([['tabs', 'TAB'], ['back', 'BACK']]);\n  }\n  stats(ui, p) {\n    const rows = [['DAYS', num(p.day)], ['KILOMETRES', num(p.stats.km)], ['RACES', num(p.stats.races)], ['WINS', num(p.stats.wins)], ['GOLD MEDALS', num(p.stats.gold)], ['CARS COLLECTED', `${collectedShare(p)}%`]], x = 8, w = 170;\n    ui.panel(x, 56, w, 10 + rows.length * 12, { color: 'ink', border: 'slate' });\n    rows.forEach(([k, v], i) => { ui.text(x + 6, 62 + i * 12, k, { color: 'mist' }); ui.text(x + w - 6, 62 + i * 12, v, { align: 'right', color: 'white' }); });\n    ui.prompts([['tabs', 'TAB'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/game/ui/screens/museum.js <<'EOF'\n// The Museum: all fourteen cars with their brochure text and silhouette, and a page per track.\nimport { CAR_IDS, CAR_INFO, MARQUES } from '../../data/cars.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { formatTime } from '../../sim/race.js';\nimport { miniMap, specCard, statusStrip } from './common.js';\nconst TRACK_IDS = Object.keys(TRACKS);\nexport class MuseumScreen {\n  constructor(app) { this.id = 'museum'; this.app = app; this.tab = 0; this.car = 0; this.track = 0; }\n  enter() { this.show(); this.app.mix.music('catalogue'); }\n  resume() { this.show(); this.app.mix.music('catalogue'); }\n  seen(id) { const p = this.app.profile; return !!p.seen[id] || p.cars.some((c) => c.carId === id); }\n  show() { const id = CAR_IDS[this.car], s = this.app.scene; s?.stage?.('museum', this.tab === 0 ? { car: { carId: id, install: null, silhouette: !this.seen(id), y: 0.2 }, radius: 8.2, height: 2.6 } : { orbit: true, radius: 13, height: 5, lookY: 2 }); }\n  draw(ui) {\n    const app = this.app, p = app.profile, a = app.actions; statusStrip(ui, app); ui.text(8, 19, 'MUSEUM', { scale: 2, color: 'sand' });\n    ui.tabs('t', 8, 38, 120, ['CARS', 'CIRCUITS'], this.tab, (i) => { this.tab = i; this.show(); });\n    ui.item('page', 0, 0, 0, 0, { noBox: true, onX: (d) => { if (this.tab === 0) { this.car = (this.car + d + CAR_IDS.length) % CAR_IDS.length; this.show(); } else this.track = (this.track + d + TRACK_IDS.length) % TRACK_IDS.length; app.mix.sfx('tick'); }, confirm: () => { this.brochure = !this.brochure; }, onY: () => {} });\n    if (this.tab === 0) {\n      const id = CAR_IDS[this.car], i = CAR_INFO[id], seen = this.seen(id), w = 150, x = ui.w - w - 8;\n      if (seen) specCard(ui, x, 20, w, id, null, { foot: `${this.car + 1} OF ${CAR_IDS.length}`, footColor: 'slate' });\n      else { ui.panel(x, 20, w, 44, { color: 'ink', border: 'slate' }); ui.text(x + 6, 26, 'NOT YET MET', { color: 'slate' }); ui.text(x + 6, 36, MARQUES[i.marque].name, { color: 'mist' }); ui.text(x + w - 6, 52, `${this.car + 1} OF ${CAR_IDS.length}`, { align: 'right', color: 'slate' }); }\n      if (seen) { const lines = i.text, bw = Math.min(ui.w - 16, 340), by = ui.h - 36 - 16 - lines.length * 10; ui.panel(8, by, bw, 15 + lines.length * 10, { color: 'ink', border: 'slate' }); ui.text(14, by + 3, `${MARQUES[i.marque].name}: ${MARQUES[i.marque].line}`, { color: 'sand' }); lines.forEach((l, k) => ui.text(14, by + 13 + k * 10, l)); }\n      ui.prompts([['moveX', 'NEXT CAR'], ['tabs', 'TAB'], ['back', 'MAP']]);\n    } else {\n      const id = TRACK_IDS[this.track], def = TRACKS[id], rec = p.records[id], w = Math.min(ui.w - 16, 320), x = Math.round(ui.cx - w / 2);\n      ui.panel(x, 54, w, 150, { color: 'ink', border: 'slate' });\n      ui.text(x + 8, 60, def.name.toUpperCase(), { scale: 2, color: 'sand' });\n      const m = miniMap(ui, x + 10, 86, id, 100, 'white');\n      ui.text(x + 124, 90, `LENGTH ${(m.length / 1000).toFixed(2)} KM`); ui.text(x + 124, 102, `${m.corners} CORNERS`); ui.text(x + 124, 114, def.surface === 'dirt' ? 'DIRT' : 'ASPHALT', { color: 'mist' }); ui.text(x + 124, 126, def.pit ? 'PIT LANE' : 'NO PITS', { color: 'mist' });\n      ui.text(x + 124, 144, 'RECORD', { color: 'slate' }); ui.text(x + 124, 154, rec ? formatTime(rec.lap) : 'NONE YET', { color: rec ? 'sand' : 'slate' }); if (rec) ui.text(x + 124, 164, CAR_INFO[rec.carId].short, { color: 'mist' });\n      ui.text(x + w - 8, 192, `${this.track + 1} OF ${TRACK_IDS.length}`, { align: 'right', color: 'slate' });\n      ui.prompts([['moveX', 'NEXT CIRCUIT'], ['tabs', 'TAB'], ['back', 'MAP']]);\n    }\n    void a;\n  }\n}\nEOF\ncat > src/game/ui/screens/theatre.js <<'EOF'\n// The Theatre: the last race, and three slots for keeping one.\nimport { TRACKS } from '../../data/tracks.js';\nimport { Dialog, statusStrip } from './common.js';\nexport class TheatreScreen {\n  constructor(app) { this.id = 'theatre'; this.app = app; }\n  stageIt() { this.app.scene?.stage?.('theatre', { orbit: false, angle: 0.05, radius: 14, height: 3, lookY: 3, lookZ: -5, sun: 0.4, ambient: 0.8 }); this.app.mix.music('longDrive'); }\n  enter() { this.stageIt(); }\n  resume() { this.stageIt(); }\n  label(rec) { return rec ? `${TRACKS[rec.meta.track].name.toUpperCase()}` : 'EMPTY'; }\n  draw(ui) {\n    const app = this.app, p = app.profile, w = Math.min(ui.w - 16, 260), x = Math.round(ui.cx - w / 2); statusStrip(ui, app); ui.text(ui.cx, 20, 'THE THEATRE', { align: 'center', scale: 2, color: 'sand' });\n    const last = app.lastRace;\n    ui.button('last', x, 44, w, 20, `LAST RACE: ${last ? this.label(last) : 'NONE YET'}`, { left: true, confirm: () => (last ? app.watchRecording(last, { after: 'theatre' }) : null), denied: last ? null : () => ui.note('DRIVE SOMETHING FIRST. IT IS WORTH WATCHING.') });\n    if (last && app.lastRaceSlot !== undefined) ui.text(x, 66, '', {});\n    p.replays.forEach((z, k) => {\n      const y = 72 + k * 26;\n      ui.button(`slot${k}`, x, y, w, 22, `SLOT ${k + 1}: ${z ? this.label(z) : 'EMPTY'}`, { left: true, confirm: () => (z ? app.watchSaved(k, { after: 'theatre' }) : null), denied: z ? null : () => ui.note('THIS SLOT IS EMPTY. SAVE A REPLAY FROM A RESULTS SCREEN.'), right: z ? `DAY ${z.day ?? '-'}` : null });\n    });\n    ui.prompts([['confirm', 'WATCH'], ['alt', 'CLEAR SLOT'], ['back', 'MAP']]);\n  }\n  onAlt(ui) { const m = /^slot(\\d)$/.exec(this.focus ?? ''); if (!m) return; const k = +m[1], p = this.app.profile; if (!p.replays[k]) return; const d = new Dialog(this.app, 'CLEAR THIS SLOT?', ['THE REPLAY WILL BE GONE. THE RACE STILL HAPPENED.'], [['no', 'KEEP', () => ui.pop()], ['yes', 'CLEAR', () => { p.replays[k] = null; this.app.save(); ui.pop(); }]]); d.under = this; d.focus = 'no'; ui.push(d); }\n}\nEOF\ncat > src/game/ui/screens/arcade.js <<'EOF'\n// The Arcade Gate: Quick Race, Time Trial, Couch Duel as big tiles, then two or three simple picker screens. Every car and track is open.\nimport { CAR_IDS, CAR_INFO } from '../../data/cars.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { miniMap, specCard, statusStrip } from './common.js';\nconst TRACK_IDS = Object.keys(TRACKS);\nconst stageIt = (app, car) => { app.scene?.stage?.('arcade', { car: car ? { carId: car, install: null, y: 0.18 } : undefined, radius: 8, height: 2.6, sun: 0.4, ambient: 0.9 }); app.mix.music('city'); };\nexport class ArcadeScreen {\n  constructor(app) { this.id = 'arcade'; this.app = app; }\n  enter() { stageIt(this.app, 'libeccio'); }\n  resume() { stageIt(this.app, 'libeccio'); }\n  draw(ui) {\n    const app = this.app; statusStrip(ui, app); ui.text(ui.cx, 20, 'ARCADE GATE', { align: 'center', scale: 2, color: 'cyan' }); ui.text(ui.cx, 37, 'NO LICENCE REQUIRED. NO MONEY EITHER.', { align: 'center', color: 'mist' });\n    const tiles = [['quick', 'QUICK RACE', 'ANY CAR, ANY CIRCUIT, A FIELD OF RIVALS.'], ['trial', 'TIME TRIAL', 'YOU, THE CLOCK, AND THE GHOST OF YOUR BEST.'], ['couch', 'COUCH DUEL', 'TWO PLAYERS, ONE TELEVISION, REAL CONTACT.']], w = Math.min(Math.floor((ui.w - 24) / 3), 150), x0 = Math.round(ui.cx - (w * 3 + 8) / 2);\n    tiles.forEach(([id, name, line], k) => { const x = x0 + k * (w + 4), f = ui.item(id, x, 150, w, 66, { confirm: () => ui.push(new PickTrack(app, { mode: id })) }); ui.rect(x, 150, w, 66, f ? 'navy' : 'ink'); ui.text(x + w / 2, 157, name, { align: 'center', color: f ? 'cyan' : 'white' }); ui.lines(x + 6, 171, line, { chars: Math.floor((w - 12) / 6), gap: 10, color: 'mist' }); });\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'MAP']]);\n  }\n}\nclass PickTrack {\n  constructor(app, o) { this.id = 'pickTrack'; this.app = app; this.o = o; this.i = 0; }\n  enter() { stageIt(this.app); }\n  resume() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, id = TRACK_IDS[this.i], def = TRACKS[id], w = Math.min(ui.w - 40, 280), x = Math.round(ui.cx - w / 2); ui.text(ui.cx, 12, 'CHOOSE A CIRCUIT', { align: 'center', scale: 2, color: 'cyan' });\n    const f = ui.item('track', x, 34, w, 150, { onX: (d) => { this.i = (this.i + d + TRACK_IDS.length) % TRACK_IDS.length; app.mix.sfx('tick'); }, confirm: () => ui.push(new PickCar(app, { ...this.o, track: id })) });\n    ui.rect(x, 34, w, 150, f ? 'navy' : 'ink'); ui.text(ui.cx, 40, `< ${def.name.toUpperCase()} >`, { align: 'center', color: 'sand' }); const m = miniMap(ui, Math.round(ui.cx - 55), 54, id, 110, 'white'); ui.text(ui.cx, 170, `${(m.length / 1000).toFixed(2)} KM, ${m.corners} CORNERS`, { align: 'center', color: 'mist' });\n    ui.prompts([['moveX', 'CHANGE'], ['confirm', 'NEXT'], ['back', 'BACK']]);\n  }\n}\nclass PickCar {\n  constructor(app, o) { this.id = 'pickCar'; this.app = app; this.o = o; this.i = 1; this.player = 0; this.first = null; }\n  show() { stageIt(this.app, CAR_IDS[this.i]); }\n  enter() { this.show(); }\n  resume() { this.show(); }\n  draw(ui) {\n    const app = this.app, id = CAR_IDS[this.i], w = 150, x = ui.w - w - 8, couch = this.o.mode === 'couch';\n    ui.text(8, 10, couch ? `PLAYER ${this.player + 1}: CHOOSE A CAR` : 'CHOOSE A CAR', { scale: 1, color: 'cyan' });\n    specCard(ui, x, 8, w, id, null, { foot: `${this.i + 1} OF ${CAR_IDS.length}`, footColor: 'slate' });\n    ui.item('car', 8, ui.h - 44, 120, 18, { onX: (d) => { this.i = (this.i + d + CAR_IDS.length) % CAR_IDS.length; this.show(); app.mix.sfx('whirr'); }, confirm: () => this.choose(ui, id) });\n    ui.rect(8, ui.h - 44, 120, 18, ui.focused('car') ? 'navy' : 'ink'); ui.text(68, ui.h - 38, `< ${CAR_INFO[id].short} >`, { align: 'center', color: 'sand' });\n    ui.prompts([['moveX', 'CHANGE'], ['confirm', 'NEXT'], ['back', 'BACK']]);\n  }\n  choose(ui, id) {\n    const app = this.app, o = this.o;\n    if (o.mode === 'trial') return app.startTimeTrial({ track: o.track, carId: id });\n    if (o.mode === 'couch' && this.player === 0) { this.first = id; this.player = 1; this.i = (this.i + 3) % CAR_IDS.length; this.show(); return; }\n    ui.push(new PickRace(app, { ...o, carId: o.mode === 'couch' ? this.first : id, carB: id }));\n  }\n}\nconst HOURS = [['TRACK\\'S OWN', null], ['MORNING', 9], ['AFTERNOON', 15], ['DUSK', 18.5], ['NIGHT', 21]], DIFF = [['EASY', 'easy'], ['NORMAL', 'normal'], ['HARD', 'hard']];\nclass PickRace {\n  constructor(app, o) { this.id = 'pickRace'; this.app = app; this.o = o; this.laps = 3; this.field = o.mode === 'couch' ? 2 : 6; this.diff = 1; this.hour = 0; this.rain = false; }\n  enter() { stageIt(this.app); }\n  draw(ui) {\n    const app = this.app, o = this.o, w = Math.min(ui.w - 40, 280), x = Math.round(ui.cx - w / 2), couch = o.mode === 'couch'; ui.text(ui.cx, 12, couch ? 'THE DUEL' : 'THE RACE', { align: 'center', scale: 2, color: 'cyan' });\n    let y = 34; const row = (id, label, val, onX) => { const f = ui.item(id, x, y, w, 18, { onX: (d) => { onX(d); app.mix.sfx('tick'); }, confirm: () => onX(1) }); ui.rect(x, y, w, 18, f ? 'navy' : 'ink'); ui.text(x + 8, y + 6, label, { color: f ? 'white' : 'mist' }); ui.text(x + w - 8, y + 6, `< ${val} >`, { align: 'right', color: f ? 'sand' : 'mist' }); y += 22; };\n    row('laps', 'LAPS', String(this.laps), (d) => { this.laps = Math.max(1, Math.min(12, this.laps + d)); });\n    if (couch) row('field', 'AI CARS', String(this.field - 2), (d) => { this.field = Math.max(2, Math.min(6, this.field + d)); });\n    else row('field', 'FIELD', String(this.field), (d) => { this.field = Math.max(1, Math.min(8, this.field + d)); });\n    if (!couch) row('diff', 'PACE', DIFF[this.diff][0], (d) => { this.diff = (this.diff + d + 3) % 3; });\n    row('hour', 'HOUR', HOURS[this.hour][0], (d) => { this.hour = (this.hour + d + HOURS.length) % HOURS.length; });\n    row('rain', 'RAIN', this.rain ? 'YES' : 'NO', () => { this.rain = !this.rain; });\n    ui.button('go', ui.cx - 60, y + 6, 120, 18, 'START', { confirm: () => { const hour = HOURS[this.hour][1] ?? undefined; if (couch) app.startCouch({ track: o.track, carA: o.carId, carB: o.carB, laps: this.laps, ai: this.field - 2, hour, rain: this.rain }); else app.startQuick({ track: o.track, carId: o.carId, laps: this.laps, field: this.field, difficulty: DIFF[this.diff][1], hour, rain: this.rain }); } });\n    ui.prompts([['moveX', 'CHANGE'], ['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\nEOF\necho ok","description":"Write licence, event, dealer, tuning, service, garage, museum, theatre, arcade screens"}}}
