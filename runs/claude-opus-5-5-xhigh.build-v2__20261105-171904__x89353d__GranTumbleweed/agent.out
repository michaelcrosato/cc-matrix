{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015PHd3Dy466RmQA28yC2eE2","type":"tool_result","content":"1\t// Turns keys, mouse and latched pad state into actions. Tracks the last device (for prompts) and idle time (for attract mode).\n2\timport { BTN, padsKey, readPads, rumble } from './pad.js';\n3\tconst MENU_BUTTONS = { confirm: BTN.cross, back: BTN.circle, alt: BTN.square, info: BTN.triangle, tabL: BTN.l1, tabR: BTN.r1, pause: BTN.options };\n4\tconst KEYS = { confirm: ['Enter'], back: ['Escape', 'Backspace'], alt: ['KeyT'], info: ['KeyI'], tabL: ['KeyQ'], tabR: ['KeyE', 'Tab'], pause: ['Escape'] };\n5\tconst PRESSED = Object.keys(MENU_BUTTONS);\n6\texport class Actions {\n7\t  constructor() {\n8\t    this.pads = []; this.prevButtons = []; this.frame = -1; this.lastDevice = 'key'; this.idle = 0; this.padKey = ''; this.pressedNow = new Set(); this.injected = []; this.moveTimer = { x: 0, y: 0 }; this.moveDir = { x: 0, y: 0 }; this.mx = 0; this.my = 0; this.lastPointer = null; this.driver = [mkDriver(), mkDriver()]; this.couch = false; this.touchSeen = false; this.anyInput = false; this.padEverSeen = false; this.keySeen = false; this.vibration = true; this.steerCurve = 1.4; this.mouseSteer = false; this.enabled = true; this.movedThisFrame = { x: 0, y: 0 }; this.lastPadSent = ''; this.clicked = false; this.rclicked = false; this.create = false; this.mouseIdle = 0;\n9\t  }\n10\t  // Once per frame, from whichever hook runs first (engine fact 8).\n11\t  latch(ctx) {\n12\t    const f = ctx.engine.frame;\n13\t    if (f === this.frame) return;\n14\t    this.frame = f;\n15\t    const input = ctx.input, dt = this.lastDt ?? 1 / 60;\n16\t    for (const cmd of input.commands) if (cmd && cmd.pads) { this.pads = cmd.pads; }\n17\t    this.anyInput = false; this.pressedNow.clear(); this.movedThisFrame.x = 0; this.movedThisFrame.y = 0;\n18\t    // Keyboard\n19\t    let keyPressed = false;\n20\t    for (const a of PRESSED) if (KEYS[a].some((k) => input.wasPressed(k))) { this.pressedNow.add(a); keyPressed = true; }\n21\t    if (input.wasPressed('Tab')) { this.pressedNow.add('tabR'); keyPressed = true; }\n22\t    const keyDown = ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space', 'KeyQ', 'KeyE', 'Enter', 'Escape', 'KeyC', 'KeyB', 'KeyR', 'ShiftLeft', 'ControlLeft', 'KeyI', 'KeyT', 'Backspace', 'Tab'].some((k) => input.isDown(k));\n23\t    const anyPress = (input.queuedPresses?.length ?? 0) > 0 || keyPressed;\n24\t    if (keyDown || anyPress) { this.lastDevice = this.lastDevice === 'mouse' && !keyDown && !keyPressed ? 'mouse' : 'key'; this.anyInput = true; this.keySeen = true; }\n25\t    // Mouse\n26\t    const p = input.pointer, wheel = input.wheel ?? 0;\n27\t    this.clicked = input.wasPressed('MouseLeft'); this.rclicked = input.wasPressed('MouseRight');\n28\t    const touchNow = input.wasPressed?.('Touch');\n29\t    if (touchNow) { this.touchSeen = true; this.anyInput = true; this.clicked = true; }\n30\t    if (this.lastPointer) {\n31\t      const dx = Math.abs(p.x - this.lastPointer.x) * 240, dy = Math.abs(p.y - this.lastPointer.y) * 135;\n32\t      if (dx + dy > 3 && !touchNow) { this.anyInput = true; this.lastDevice = 'mouse'; this.mouseIdle = 0; this.lastPointer = { x: p.x, y: p.y }; }\n33\t    } else this.lastPointer = { x: p.x, y: p.y };\n34\t    if (this.clicked || this.rclicked || wheel) { this.anyInput = true; if (!touchNow) { this.lastDevice = 'mouse'; this.mouseIdle = 0; } }\n35\t    this.mouseIdle += dt;\n36\t    this.wheel = wheel;\n37\t    // Pads\n38\t    const prev = this.prevButtons;\n39\t    this.create = false;\n40\t    for (const pad of this.pads) {\n41\t      const pb = prev[pad.i] ?? [];\n42\t      if (pad.buttons[BTN.create] > 0.5) this.create = true;\n43\t      for (let b = 0; b < pad.buttons.length; b++) {\n44\t        const on = pad.buttons[b] > 0.5, was = (pb[b] ?? 0) > 0.5;\n45\t        if (on && !was) {\n46\t          this.anyInput = true; this.lastDevice = 'pad'; this.padEverSeen = true;\n47\t          for (const a of PRESSED) if (MENU_BUTTONS[a] === b) { if (a === 'pause' && this.create) continue; this.pressedNow.add(a); }\n48\t        }\n49\t      }\n50\t      const moved = Math.abs(pad.axes[0]) > 0.2 || Math.abs(pad.axes[1]) > 0.2 || Math.abs(pad.axes[2]) > 0.2 || Math.abs(pad.axes[3]) > 0.2 || pad.buttons[BTN.l2] > 0.2 || pad.buttons[BTN.r2] > 0.2;\n51\t      if (moved) { this.anyInput = true; this.lastDevice = 'pad'; this.padEverSeen = true; }\n52\t      prev[pad.i] = pad.buttons;\n53\t    }\n54\t    for (const a of this.injected) { if (a === 'moveX+' || a === 'moveX-') this.movedThisFrame.x = a === 'moveX+' ? 1 : -1; else if (a === 'moveY+' || a === 'moveY-') this.movedThisFrame.y = a === 'moveY+' ? 1 : -1; else this.pressedNow.add(a); this.anyInput = true; }\n55\t    this.injected.length = 0;\n56\t    this.updateMoves(input, dt);\n57\t    if (this.anyInput) this.idle = 0; else this.idle += dt;\n58\t  }\n59\t  setDt(dt) { this.lastDt = dt; }\n60\t  // Menu movement with repeat: first repeat at 0.35 s, then every 0.09 s.\n61\t  updateMoves(input, dt) {\n62\t    let x = 0, y = 0;\n63\t    if (input.isDown('ArrowRight') || input.isDown('KeyD')) x = 1; if (input.isDown('ArrowLeft') || input.isDown('KeyA')) x = -1;\n64\t    if (input.isDown('ArrowDown') || input.isDown('KeyS')) y = 1; if (input.isDown('ArrowUp') || input.isDown('KeyW')) y = -1;\n65\t    for (const pad of this.pads) {\n66\t      if (pad.axes[0] > 0.5 || pad.buttons[BTN.right] > 0.5) x = 1; else if (pad.axes[0] < -0.5 || pad.buttons[BTN.left] > 0.5) x = -1;\n67\t      if (pad.axes[1] > 0.5 || pad.buttons[BTN.down] > 0.5) y = 1; else if (pad.axes[1] < -0.5 || pad.buttons[BTN.up] > 0.5) y = -1;\n68\t    }\n69\t    for (const [ax, v] of [['x', x], ['y', y]]) {\n70\t      if (v !== this.moveDir[ax]) { this.moveDir[ax] = v; this.moveTimer[ax] = 0.35; if (v) this.movedThisFrame[ax] = v; }\n71\t      else if (v) { this.moveTimer[ax] -= dt; if (this.moveTimer[ax] <= 0) { this.moveTimer[ax] = 0.09; this.movedThisFrame[ax] = v; } }\n72\t    }\n73\t  }\n74\t  pressed(a) { return this.pressedNow.has(a); }\n75\t  moveX() { return this.movedThisFrame.x; }\n76\t  moveY() { return this.movedThisFrame.y; }\n77\t  inject(a) { this.injected.push(a); }\n78\t  // At the end of update: read pads and hand them to the engine, so they arrive (and replay) next frame.\n79\t  send(ctx) {\n80\t    const pads = readPads();\n81\t    const key = padsKey(pads);\n82\t    if (key !== this.lastPadSent) { this.lastPadSent = key; ctx.input.send({ pads: pads.map(({ i, axes, buttons }) => ({ i, axes, buttons })) }); }\n83\t    if (pads.length) { if (!this.padEverSeen && pads.some((p) => p.buttons.some((b) => b > 0.5))) this.padEverSeen = true; if (typeof this.hasPad === 'undefined' || !this.hasPad) this.hasPad = true; } else this.hasPad = false;\n84\t    if (ctx.audio && !ctx.audio.unlocked && pads.some((p) => p.buttons.some((b) => b > 0.5))) ctx.audio.unlock();\n85\t  }\n86\t  rumble(player, strong, weak, ms) { if (!this.vibration) return; const pad = this.pads[player]; if (pad) rumble(pad.i, strong, weak, ms); }\n87\t  // Which physical inputs does this player use?\n88\t  padFor(player) {\n89\t    if (this.couch) { if (this.pads.length >= 2) return this.pads[player]; if (this.pads.length === 1) return player === 0 ? this.pads[0] : null; return null; }\n90\t    if (player === 0) return this.pads[0] ?? null;\n91\t    return null;\n92\t  }\n93\t  keysFor(player) { // returns a key map, or null when this player uses a pad only\n94\t    if (!this.couch) return player === 0 ? KEYS_SOLO : null;\n95\t    if (this.pads.length >= 2) return null;\n96\t    if (this.pads.length === 1) return player === 1 ? KEYS_SOLO : null;\n97\t    return player === 0 ? KEYS_P1 : KEYS_P2;\n98\t  }\n99\t  // The driver's controls, filtered. Call once per frame per player.\n100\t  drive(ctx, player, dt) {\n101\t    const input = ctx.input, d = this.driver[player], pad = this.padFor(player), k = this.keysFor(player);\n102\t    let kSteer = 0, kThrottle = 0, kBrake = 0, analogSteer = null, anaThrottle = null, anaBrake = null, hand = false, up = false, down = false, cam = false, back = false, recover = false, lookX = 0, lookY = 0;\n103\t    if (k) {\n104\t      if (k.left.some((c) => input.isDown(c))) kSteer -= 1; if (k.right.some((c) => input.isDown(c))) kSteer += 1;\n105\t      if (k.throttle.some((c) => input.isDown(c))) kThrottle = 1; if (k.brake.some((c) => input.isDown(c))) kBrake = 1;\n106\t      hand = k.hand.some((c) => input.isDown(c)); up = k.up.some((c) => input.wasPressed(c)); down = k.down.some((c) => input.wasPressed(c));\n107\t      cam = k.cam.some((c) => input.wasPressed(c)); back = k.back.some((c) => input.isDown(c)); recover = k.recover.some((c) => input.isDown(c));\n108\t    }\n109\t    if (pad) {\n110\t      const pb = d.prevB ?? [], B = (b) => pad.buttons[b] > 0.5, P = (b) => pad.buttons[b] > 0.5 && !((pb[b] ?? 0) > 0.5);\n111\t      const ax = pad.axes[0], dead = 0.08;\n112\t      if (Math.abs(ax) > 0.02 || pad.buttons[BTN.left] > 0.5 || pad.buttons[BTN.right] > 0.5) { const a = Math.abs(ax) > dead ? (Math.abs(ax) - dead) / (1 - dead) : 0; analogSteer = Math.sign(ax) * Math.pow(a, this.steerCurve); if (pad.buttons[BTN.left] > 0.5) analogSteer = -1; if (pad.buttons[BTN.right] > 0.5) analogSteer = 1; }\n113\t      const rt = pad.buttons[BTN.r2], lt = pad.buttons[BTN.l2];\n114\t      anaThrottle = rt; anaBrake = lt;\n115\t      // A trigger that reports only 0 or 1 gets the keyboard ramp.\n116\t      d.digitalT = (rt === 0 || rt === 1) && (d.digitalT ?? true) ; d.digitalB = (lt === 0 || lt === 1) && (d.digitalB ?? true);\n117\t      hand = hand || B(BTN.square); up = up || P(BTN.r1); down = down || P(BTN.l1);\n118\t      const tri = B(BTN.triangle); if (tri) { d.triHold += dt; } else { if (d.triHold > 0 && d.triHold < 0.4) cam = true; d.triHold = 0; }\n119\t      recover = recover || d.triHold >= 0.4; back = back || B(BTN.circle); lookX = Math.abs(pad.axes[2]) > 0.12 ? pad.axes[2] : 0; lookY = Math.abs(pad.axes[3]) > 0.12 ? -pad.axes[3] : 0;\n120\t      d.prevB = pad.buttons;\n121\t    }\n122\t    // Mouse steering, optional.\n123\t    const mouseOn = this.mouseSteer && player === 0 && this.lastDevice === 'mouse';\n124\t    if (mouseOn) { analogSteer = Math.max(-1, Math.min(1, input.pointer.x * 1.6)); anaThrottle = input.isDown('MouseLeft') ? 1 : 0; anaBrake = input.isDown('MouseRight') ? 1 : 0; }\n125\t    else if (player === 0 && input.isDown('MouseRight')) { d.lookX = Math.max(-1, Math.min(1, (d.lookX ?? 0) + (input.mouseDelta.x ?? 0) * 0.006)); lookX = d.lookX; lookY = 0; } else d.lookX = 0;\n126\t    // Filters: keyboard steering goes toward +-1 at 3.2 per second and returns at 6.\n127\t    if (analogSteer !== null && !kSteer) d.steer = analogSteer;\n128\t    else { const to = kSteer, rate = to === 0 || Math.sign(to) !== Math.sign(d.steer) ? 6 : 3.2; d.steer += Math.max(-rate * dt, Math.min(rate * dt, to - d.steer)); }\n129\t    // Throttle and brake: keys ramp over 0.1 s; analog follows the pedal.\n130\t    const ramp = (cur, to) => cur + Math.max(-dt / 0.1, Math.min(dt / 0.1, to - cur));\n131\t    const tTo = Math.max(kThrottle, anaThrottle ?? 0), bTo = Math.max(kBrake, anaBrake ?? 0), digT = kThrottle || (pad && d.digitalT), digB = kBrake || (pad && d.digitalB);\n132\t    d.throttle = digT ? ramp(d.throttle, tTo) : tTo; d.brake = digB ? ramp(d.brake, bTo) : bTo;\n133\t    d.handbrake = hand; d.up = up; d.down = down; d.cam = cam; d.lookBack = back; d.recover = recover; d.lookX2 = lookX; d.lookY2 = lookY;\n134\t    return d;\n135\t  }\n136\t  resetDriver() { for (const d of this.driver) { d.steer = 0; d.throttle = 0; d.brake = 0; d.triHold = 0; } }\n137\t  state() { return { lastDevice: this.lastDevice, idle: this.idle, pads: this.pads.length }; }\n138\t}\n139\tconst mkDriver = () => ({ steer: 0, throttle: 0, brake: 0, handbrake: false, up: false, down: false, cam: false, lookBack: false, recover: false, triHold: 0, lookX2: 0, lookY2: 0, digitalT: true, digitalB: true });\n140\tconst KEYS_SOLO = { left: ['KeyA', 'ArrowLeft'], right: ['KeyD', 'ArrowRight'], throttle: ['KeyW', 'ArrowUp'], brake: ['KeyS', 'ArrowDown'], hand: ['Space'], up: ['KeyE', 'ShiftLeft'], down: ['KeyQ', 'ControlLeft'], cam: ['KeyC'], back: ['KeyB'], recover: ['KeyR'] };\n141\tconst KEYS_P1 = { left: ['KeyA'], right: ['KeyD'], throttle: ['KeyW'], brake: ['KeyS'], hand: ['Space'], up: ['KeyE'], down: ['KeyQ'], cam: ['KeyC'], back: ['KeyB'], recover: ['KeyR'] };\n142\tconst KEYS_P2 = { left: ['ArrowLeft'], right: ['ArrowRight'], throttle: ['ArrowUp'], brake: ['ArrowDown'], hand: ['Enter'], up: ['Period'], down: ['Comma'], cam: ['Slash'], back: ['ShiftRight'], recover: ['Backslash'] };\n143\texport { KEYS_SOLO, KEYS_P1, KEYS_P2 };\n144\t"}]},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"d93e7b6a-4f15-4500-aaf3-e8cb15cef6f1","timestamp":"2026-11-06T04:16:20.240Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-171904__x89353d/work/GranTumbleweed-GranTurismo3ASpec-claude-opus-5-5-xhigh-20261105-171904/src/game/input/actions.js","content":"// Turns keys, mouse and latched pad state into actions. Tracks the last device (for prompts) and idle time (for attract mode).\nimport { BTN, padsKey, readPads, rumble } from './pad.js';\nconst MENU_BUTTONS = { confirm: BTN.cross, back: BTN.circle, alt: BTN.square, info: BTN.triangle, tabL: BTN.l1, tabR: BTN.r1, pause: BTN.options };\nconst KEYS = { confirm: ['Enter'], back: ['Escape', 'Backspace'], alt: ['KeyT'], info: ['KeyI'], tabL: ['KeyQ'], tabR: ['KeyE', 'Tab'], pause: ['Escape'] };\nconst PRESSED = Object.keys(MENU_BUTTONS);\nexport class Actions {\n  constructor() {\n    this.pads = []; this.prevButtons = []; this.frame = -1; this.lastDevice = 'key'; this.idle = 0; this.padKey = ''; this.pressedNow = new Set(); this.injected = []; this.moveTimer = { x: 0, y: 0 }; this.moveDir = { x: 0, y: 0 }; this.mx = 0; this.my = 0; this.lastPointer = null; this.driver = [mkDriver(), mkDriver()]; this.couch = false; this.touchSeen = false; this.anyInput = false; this.padEverSeen = false; this.keySeen = false; this.vibration = true; this.steerCurve = 1.4; this.mouseSteer = false; this.enabled = true; this.movedThisFrame = { x: 0, y: 0 }; this.lastPadSent = ''; this.clicked = false; this.rclicked = false; this.create = false; this.mouseIdle = 0;\n  }\n  // Once per frame, from whichever hook runs first (engine fact 8).\n  latch(ctx) {\n    const f = ctx.engine.frame;\n    if (f === this.frame) return;\n    this.frame = f;\n    const input = ctx.input, dt = this.lastDt ?? 1 / 60;\n    for (const cmd of input.commands) if (cmd && cmd.pads) { this.pads = cmd.pads; }\n    this.anyInput = false; this.pressedNow.clear(); this.movedThisFrame.x = 0; this.movedThisFrame.y = 0;\n    // Keyboard\n    let keyPressed = false;\n    for (const a of PRESSED) if (KEYS[a].some((k) => input.wasPressed(k))) { this.pressedNow.add(a); keyPressed = true; }\n    if (input.wasPressed('Tab')) { this.pressedNow.add('tabR'); keyPressed = true; }\n    const keyDown = ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space', 'KeyQ', 'KeyE', 'Enter', 'Escape', 'KeyC', 'KeyB', 'KeyR', 'ShiftLeft', 'ControlLeft', 'KeyI', 'KeyT', 'Backspace', 'Tab'].some((k) => input.isDown(k));\n    const anyPress = (input.queuedPresses?.length ?? 0) > 0 || keyPressed;\n    if (keyDown || anyPress) { this.lastDevice = this.lastDevice === 'mouse' && !keyDown && !keyPressed ? 'mouse' : 'key'; this.anyInput = true; this.keySeen = true; }\n    // Mouse\n    const p = input.pointer, wheel = input.wheel ?? 0;\n    this.clicked = input.wasPressed('MouseLeft'); this.rclicked = input.wasPressed('MouseRight');\n    const touchNow = input.wasPressed?.('Touch');\n    if (touchNow) { this.touchSeen = true; this.anyInput = true; this.clicked = true; }\n    if (this.lastPointer) {\n      const dx = Math.abs(p.x - this.lastPointer.x) * 240, dy = Math.abs(p.y - this.lastPointer.y) * 135;\n      if (dx + dy > 3 && !touchNow) { this.anyInput = true; this.lastDevice = 'mouse'; this.mouseIdle = 0; this.lastPointer = { x: p.x, y: p.y }; }\n    } else this.lastPointer = { x: p.x, y: p.y };\n    if (this.clicked || this.rclicked || wheel) { this.anyInput = true; if (!touchNow) { this.lastDevice = 'mouse'; this.mouseIdle = 0; } }\n    this.mouseIdle += dt;\n    this.wheel = wheel;\n    // Pads\n    const prev = this.prevButtons;\n    this.create = false;\n    for (const pad of this.pads) {\n      const pb = prev[pad.i] ?? [];\n      if (pad.buttons[BTN.create] > 0.5) this.create = true;\n      for (let b = 0; b < pad.buttons.length; b++) {\n        const on = pad.buttons[b] > 0.5, was = (pb[b] ?? 0) > 0.5;\n        if (on && !was) {\n          this.anyInput = true; this.lastDevice = 'pad'; this.padEverSeen = true;\n          for (const a of PRESSED) if (MENU_BUTTONS[a] === b) { if (a === 'pause' && this.create) continue; this.pressedNow.add(a); }\n        }\n      }\n      const moved = Math.abs(pad.axes[0]) > 0.2 || Math.abs(pad.axes[1]) > 0.2 || Math.abs(pad.axes[2]) > 0.2 || Math.abs(pad.axes[3]) > 0.2 || pad.buttons[BTN.l2] > 0.2 || pad.buttons[BTN.r2] > 0.2;\n      if (moved) { this.anyInput = true; this.lastDevice = 'pad'; this.padEverSeen = true; }\n      prev[pad.i] = pad.buttons;\n    }\n    for (const a of this.injected) { if (a === 'moveX+' || a === 'moveX-') this.movedThisFrame.x = a === 'moveX+' ? 1 : -1; else if (a === 'moveY+' || a === 'moveY-') this.movedThisFrame.y = a === 'moveY+' ? 1 : -1; else this.pressedNow.add(a); this.anyInput = true; }\n    this.injected.length = 0;\n    this.updateMoves(input, dt);\n    if (this.anyInput) this.idle = 0; else this.idle += dt;\n  }\n  setDt(dt) { this.lastDt = dt; }\n  // Menu movement with repeat: first repeat at 0.35 s, then every 0.09 s.\n  updateMoves(input, dt) {\n    let x = 0, y = 0;\n    if (input.isDown('ArrowRight') || input.isDown('KeyD')) x = 1; if (input.isDown('ArrowLeft') || input.isDown('KeyA')) x = -1;\n    if (input.isDown('ArrowDown') || input.isDown('KeyS')) y = 1; if (input.isDown('ArrowUp') || input.isDown('KeyW')) y = -1;\n    for (const pad of this.pads) {\n      if (pad.axes[0] > 0.5 || pad.buttons[BTN.right] > 0.5) x = 1; else if (pad.axes[0] < -0.5 || pad.buttons[BTN.left] > 0.5) x = -1;\n      if (pad.axes[1] > 0.5 || pad.buttons[BTN.down] > 0.5) y = 1; else if (pad.axes[1] < -0.5 || pad.buttons[BTN.up] > 0.5) y = -1;\n    }\n    for (const [ax, v] of [['x', x], ['y', y]]) {\n      if (v !== this.moveDir[ax]) { this.moveDir[ax] = v; this.moveTimer[ax] = 0.35; if (v) this.movedThisFrame[ax] = v; }\n      else if (v) { this.moveTimer[ax] -= dt; if (this.moveTimer[ax] <= 0) { this.moveTimer[ax] = 0.09; this.movedThisFrame[ax] = v; } }\n    }\n  }\n  pressed(a) { return this.pressedNow.has(a); }\n  moveX() { return this.movedThisFrame.x; }\n  moveY() { return this.movedThisFrame.y; }\n  inject(a) { this.injected.push(a); }\n  // At the end of update: read pads and hand them to the engine, so they arrive (and replay) next frame.\n  send(ctx) {\n    const pads = readPads();\n    const key = padsKey(pads);\n    if (key !== this.lastPadSent) { this.lastPadSent = key; ctx.input.send({ pads: pads.map(({ i, axes, buttons }) => ({ i, axes, buttons })) }); }\n    if (pads.length) { if (!this.padEverSeen && pads.some((p) => p.buttons.some((b) => b > 0.5))) this.padEverSeen = true; if (typeof this.hasPad === 'undefined' || !this.hasPad) this.hasPad = true; } else this.hasPad = false;\n    if (ctx.audio && !ctx.audio.unlocked && pads.some((p) => p.buttons.some((b) => b > 0.5))) ctx.audio.unlock();\n  }\n  rumble(player, strong, weak, ms) { if (!this.vibration) return; const pad = this.pads[player]; if (pad) rumble(pad.i, strong, weak, ms); }\n  // Which physical inputs does this player use?\n  padFor(player) {\n    if (this.couch) { if (this.pads.length >= 2) return this.pads[player]; if (this.pads.length === 1) return player === 0 ? this.pads[0] : null; return null; }\n    if (player === 0) return this.pads[0] ?? null;\n    return null;\n  }\n  keysFor(player) { // returns a key map, or null when this player uses a pad only\n    if (!this.couch) return player === 0 ? KEYS_SOLO : null;\n    if (this.pads.length >= 2) return null;\n    if (this.pads.length === 1) return player === 1 ? KEYS_SOLO : null;\n    return player === 0 ? KEYS_P1 : KEYS_P2;\n  }\n  // The driver's controls, filtered. Call once per frame per player.\n  drive(ctx, player, dt) {\n    const input = ctx.input, d = this.driver[player], pad = this.padFor(player), k = this.keysFor(player);\n    let kSteer = 0, kThrottle = 0, kBrake = 0, analogSteer = null, anaThrottle = null, anaBrake = null, hand = false, up = false, down = false, cam = false, back = false, recover = false, lookX = 0, lookY = 0;\n    if (k) {\n      if (k.left.some((c) => input.isDown(c))) kSteer -= 1; if (k.right.some((c) => input.isDown(c))) kSteer += 1;\n      if (k.throttle.some((c) => input.isDown(c))) kThrottle = 1; if (k.brake.some((c) => input.isDown(c))) kBrake = 1;\n      hand = k.hand.some((c) => input.isDown(c)); up = k.up.some((c) => input.wasPressed(c)); down = k.down.some((c) => input.wasPressed(c));\n      cam = k.cam.some((c) => input.wasPressed(c)); back = k.back.some((c) => input.isDown(c)); recover = k.recover.some((c) => input.isDown(c));\n    }\n    if (pad) {\n      const pb = d.prevB ?? [], B = (b) => pad.buttons[b] > 0.5, P = (b) => pad.buttons[b] > 0.5 && !((pb[b] ?? 0) > 0.5);\n      const ax = pad.axes[0], dead = 0.08;\n      if (Math.abs(ax) > 0.02 || pad.buttons[BTN.left] > 0.5 || pad.buttons[BTN.right] > 0.5) { const a = Math.abs(ax) > dead ? (Math.abs(ax) - dead) / (1 - dead) : 0; analogSteer = Math.sign(ax) * Math.pow(a, this.steerCurve); if (pad.buttons[BTN.left] > 0.5) analogSteer = -1; if (pad.buttons[BTN.right] > 0.5) analogSteer = 1; }\n      const rt = pad.buttons[BTN.r2], lt = pad.buttons[BTN.l2];\n      anaThrottle = rt; anaBrake = lt;\n      // A trigger that reports only 0 or 1 gets the keyboard ramp.\n      d.digitalT = (rt === 0 || rt === 1) && (d.digitalT ?? true) ; d.digitalB = (lt === 0 || lt === 1) && (d.digitalB ?? true);\n      hand = hand || B(BTN.square); up = up || P(BTN.r1); down = down || P(BTN.l1);\n      const tri = B(BTN.triangle); if (tri) { d.triHold += dt; } else { if (d.triHold > 0 && d.triHold < 0.4) cam = true; d.triHold = 0; }\n      recover = recover || d.triHold >= 0.4; back = back || B(BTN.circle); lookX = Math.abs(pad.axes[2]) > 0.12 ? pad.axes[2] : 0; lookY = Math.abs(pad.axes[3]) > 0.12 ? -pad.axes[3] : 0;\n      d.prevB = pad.buttons;\n    }\n    // Mouse steering, optional.\n    const mouseOn = this.mouseSteer && player === 0 && this.lastDevice === 'mouse';\n    if (mouseOn) { analogSteer = Math.max(-1, Math.min(1, input.pointer.x * 1.6)); anaThrottle = input.isDown('MouseLeft') ? 1 : 0; anaBrake = input.isDown('MouseRight') ? 1 : 0; }\n    else if (player === 0 && input.isDown('MouseRight')) { d.lookX = Math.max(-1, Math.min(1, (d.lookX ?? 0) + (input.mouseDelta.x ?? 0) * 0.006)); lookX = d.lookX; lookY = 0; } else d.lookX = 0;\n    // Filters: keyboard steering goes toward +-1 at 3.2 per second and returns at 6.\n    if (analogSteer !== null && !kSteer) d.steer = analogSteer;\n    else { const to = kSteer, rate = to === 0 || Math.sign(to) !== Math.sign(d.steer) ? 6 : 3.2; d.steer += Math.max(-rate * dt, Math.min(rate * dt, to - d.steer)); }\n    // Throttle and brake: keys ramp over 0.1 s; analog follows the pedal.\n    const ramp = (cur, to) => cur + Math.max(-dt / 0.1, Math.min(dt / 0.1, to - cur));\n    const tTo = Math.max(kThrottle, anaThrottle ?? 0), bTo = Math.max(kBrake, anaBrake ?? 0), digT = kThrottle || (pad && d.digitalT), digB = kBrake || (pad && d.digitalB);\n    d.throttle = digT ? ramp(d.throttle, tTo) : tTo; d.brake = digB ? ramp(d.brake, bTo) : bTo;\n    d.handbrake = hand; d.up = up; d.down = down; d.cam = cam; d.lookBack = back; d.recover = recover; d.lookX2 = lookX; d.lookY2 = lookY;\n    return d;\n  }\n  resetDriver() { for (const d of this.driver) { d.steer = 0; d.throttle = 0; d.brake = 0; d.triHold = 0; } }\n  state() { return { lastDevice: this.lastDevice, idle: this.idle, pads: this.pads.length }; }\n}\nconst mkDriver = () => ({ steer: 0, throttle: 0, brake: 0, handbrake: false, up: false, down: false, cam: false, lookBack: false, recover: false, triHold: 0, lookX2: 0, lookY2: 0, digitalT: true, digitalB: true });\nconst KEYS_SOLO = { left: ['KeyA', 'ArrowLeft'], right: ['KeyD', 'ArrowRight'], throttle: ['KeyW', 'ArrowUp'], brake: ['KeyS', 'ArrowDown'], hand: ['Space'], up: ['KeyE', 'ShiftLeft'], down: ['KeyQ', 'ControlLeft'], cam: ['KeyC'], back: ['KeyB'], recover: ['KeyR'] };\nconst KEYS_P1 = { left: ['KeyA'], right: ['KeyD'], throttle: ['KeyW'], brake: ['KeyS'], hand: ['Space'], up: ['KeyE'], down: ['KeyQ'], cam: ['KeyC'], back: ['KeyB'], recover: ['KeyR'] };\nconst KEYS_P2 = { left: ['ArrowLeft'], right: ['ArrowRight'], throttle: ['ArrowUp'], brake: ['ArrowDown'], hand: ['Enter'], up: ['Period'], down: ['Comma'], cam: ['Slash'], back: ['ShiftRight'], recover: ['Backslash'] };\nexport { KEYS_SOLO, KEYS_P1, KEYS_P2 };\n","numLines":144,"startLine":1,"totalLines":144}},"tool_result_meta":[{"id":"toolu_015PHd3Dy466RmQA28yC2eE2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
