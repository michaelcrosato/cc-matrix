'headless', 'play', 'browser', 'audio', 'hub'];\")\nrep(T,\"  hub: [HTML, 'tools/hub'],\\n\",\"  hub: [HTML, 'tools/hub'],\\n  audit: ['src/game', 'tools/audit.mjs', 'tools/tests', '../PLAN.md'],\\n\")\nopen('tools/tests/audit.mjs','w').write(\"\"\"// Runs tools/audit.mjs: every line of PLAN.md has evidence, and the plan's numbers and words match the game's data.\nimport { spawnSync } from 'node:child_process';\nimport { suite } from './_lib.mjs';\nconst t = suite(), r = spawnSync(process.execPath, ['tools/audit.mjs'], { encoding: 'utf8', maxBuffer: 1 << 26 }), out = String(r.stdout).trim().split('\\\\n');\nfor (const l of out.filter((x) => x.startsWith('FAIL'))) t.ok(false, l);\nt.ok(r.status === 0, `audit exit ${r.status}: ${out.at(-1)}`); t.ok(/audit: \\\\d+ lines, 0 failing/.test(out.at(-1)), out.at(-1));\nt.done();\n\"\"\")\nEOF\nsed -n 250p ../PLAN.md | cut -c1-210; node tools/audit.mjs 2>&1 | tail -30 | cut -c1-240","description":"Add badges and checks, extend the audit to all prose and the folder map, run it","timeout":120000}}}
