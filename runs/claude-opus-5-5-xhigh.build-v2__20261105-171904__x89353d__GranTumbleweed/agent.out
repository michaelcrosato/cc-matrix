t) < 0.004 && !e.lapsedThisLap) { e.lapse = 2; e.lapsedThisLap = true; } }\n228\t    }\n229\t    // Splits: the time at each 20 m, for gap readouts between staggered cars.\n230\t    if (e.ownStart !== null) { const k = Math.floor(Math.max(0, e.progress) / 20); if (k >= e.splits.length) { for (let n = e.splits.length; n <= k; n++) e.splits[n] = this.time - e.ownStart; } }\n231\t  }\n232\t  needsPit(e) { if (!e.p) return false; const mean = (e.c.wear[0] + e.c.wear[1] + e.c.wear[2] + e.c.wear[3]) / 4; return !!this.tr.pit && (mean < 0.3 || e.c.fuel < 0.12) && !e.finished && this.laps >= 10; }\n233\t  crossLine(e) {\n234\t    e.lap++; e.lapsedThisLap = false;\n235\t    const now = this.time;\n236\t    if (e.lapStart !== null && !e.finished) {\n237\t      const t = now - e.lapStart; e.lastLap = t; if (e.bestLap === null || t < e.bestLap) { e.bestLap = t; }\n238\t      this.emit('lap', e, { time: t, lap: e.lap });\n239\t    } else if (e.lap === 1) this.emit('lap', e, { time: null, lap: 1 });\n240\t    e.lapStart = now;\n241\t    if (!e.finished && this.laps > 0 && e.lap > this.laps && this.phase !== 'rolling') {\n242\t      e.finished = true; e.finishTime = e.ownStart !== null ? now - e.ownStart : now;\n243\t      this.emit('flag', e, { kind: 'finish', own: e.player !== null });\n244\t      if (this.leaderFinishedAt === null) this.leaderFinishedAt = now;\n245\t      if (e.player !== null) e.autoDrive = true;\n246\t    } else if (!e.finished && this.laps > 0 && e.lap === this.laps && e.player !== null) this.emit('flag', e, { kind: 'finalLap' });\n247\t  }\n248\t  enterPit(e) {\n249\t    const c = e.c, tr = this.tr, halfW = tr.width[c.loc.i] / 2;\n250\t    e.pit = { phase: 'in', s: rel(tr, c.loc.s), t: c.loc.t, speed: Math.min(Math.abs(c.u), 45), box: tr.pit.box + (e.i - this.cars.length / 2) * 12, laneT: halfW + 3.6, boxT: halfW + 5.6, svc: 0, tyres: 0, fuel: 0, skipTyres: false, startedAt: this.time };\n251\t    c.inPit = true; e.wantPit = false; e.pits++; c.dragScale = 1;\n252\t    this.emit('pitIn', e);\n253\t  }\n254\t  stepPit(e, dt) {\n255\t    const c = e.c, tr = this.tr, P = e.pit, A = 14;\n256\t    if (P.phase === 'in') {\n257\t      const dist = P.box - P.s, stopV = Math.sqrt(Math.max(0, 2 * 7 * dist));\n258\t      const want = Math.min(PIT_SPEED, stopV);\n259\t      P.speed = P.speed > want ? Math.max(want, P.speed - A * dt) : Math.min(want, P.speed + 8 * dt);\n260\t      P.s += P.speed * dt;\n261\t      P.t += (P.laneT - P.t) * Math.min(1, dt * 1.8);\n262\t      if (dist < 28) P.t += (P.boxT - P.t) * Math.min(1, dt * 2.2);\n263\t      if (dist < 0.3 || (P.speed < 0.3 && dist < 3)) {\n264\t        P.phase = 'box'; P.speed = 0;\n265\t        const mean = (c.wear[0] + c.wear[1] + c.wear[2] + c.wear[3]) / 4;\n266\t        P.tyres = mean < 0.7 ? 4 : 0;\n267\t        P.fuel = (1 - c.fuel) * 100 * 0.1;\n268\t        P.total = Math.max(P.tyres, P.fuel);\n269\t        this.emit('pitBox', e, { tyres: P.tyres > 0, fuel: P.fuel });\n270\t      }\n271\t    } else if (P.phase === 'box') {\n272\t      P.svc += dt;\n273\t      if (P.fuel > 0) c.fuel = Math.min(1, c.fuel + (dt / 0.1) / 100);\n274\t      if (P.skipTyres) P.tyres = 0;\n275\t      if (P.svc >= Math.max(P.tyres, P.fuel)) {\n276\t        if (P.tyres > 0) { c.wear[0] = c.wear[1] = c.wear[2] = c.wear[3] = 1; }\n277\t        P.phase = 'out'; this.emit('pitGo', e, { time: P.svc });\n278\t      }\n279\t    } else if (P.phase === 'out') {\n280\t      P.speed = Math.min(PIT_SPEED, P.speed + 9 * dt);\n281\t      P.s += P.speed * dt;\n282\t      const halfW = tr.width[c.loc.i] / 2, remain = tr.pit.out - P.s;\n283\t      if (remain > 90) P.t += (P.laneT - P.t) * Math.min(1, dt * 1.5); else P.t += (halfW - 1.8 - P.t) * Math.min(1, dt * 0.9);\n284\t      if (remain <= 0) {\n285\t        const pt = trackPoint(tr, P.s, P.t); c.vx = Math.sin(pt.yaw) * P.speed; c.vz = Math.cos(pt.yaw) * P.speed; c.inPit = false; e.pit = null; e.noContact = 1.5; c.delta = 0; c.r = 0;\n286\t        this.emit('pitOut', e);\n287\t        return;\n288\t      }\n289\t    }\n290\t    const pt = trackPoint(tr, P.s, P.t);\n291\t    c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.vy = 0; c.vx = Math.sin(pt.yaw) * P.speed; c.vz = Math.cos(pt.yaw) * P.speed; c.u = P.speed; c.w = 0; c.r = 0; c.delta *= 0.9; c.ax = 0; c.ay = 0;\n292\t    c.rpm = c.p.idle + P.speed * 120; c.gear = 1; c.sliding = false; c.locked = false; c.airborne = false; c.surface = 'apron';\n293\t    c.loc.i = pt.i; c.loc.s = wrapS(tr, P.s); c.loc.t = P.t;\n294\t  }\n295\t  skipTyres(i) { const P = this.cars[i]?.pit; if (P && P.phase === 'box') P.skipTyres = true; }\n296\t  recover(i) {\n297\t    const e = this.cars[i], c = e.c, tr = this.tr, line = this.line;\n298\t    if (e.pit) return false;\n299\t    const k = c.loc.i, x = line.px[k], z = line.pz[k], yaw = Math.atan2(tr.tx[k], tr.tz[k]);\n300\t    c.x = x; c.z = z; c.y = tr.y[k]; c.vy = 0; c.yaw = yaw; c.vx = 0; c.vz = 0; c.r = 0; c.delta = 0; c.gear = 1; c.ax = 0; c.ay = 0; c.shift = 0; c.loc.t = line.off[k]; c.u = 0; c.w = 0; c.laneNow = 0;\n301\t    e.noContact = 2; e.reverse = false; e.stopped = 0; e.recoveries++;\n302\t    this.emit('recover', e);\n303\t    return true;\n304\t  }\n305\t  retire(i) { const e = this.cars[i]; e.retired = true; e.autoDrive = true; e.finished = true; e.finishTime = null; }\n306\t  updateOrder() {\n307\t    const score = (e) => (e.retired ? -1e9 : e.finished && e.finishTime !== null ? 1e9 - e.finishTime : e.progress);\n308\t    this.order = this.cars.slice().sort((a, b) => score(b) - score(a));\n309\t    this.order.forEach((e, k) => { e.pos = k + 1; });\n310\t  }\n311\t  checkFinish() {\n312\t    // After the leader flag, a player gets a while to finish; then they are flagged where they are.\n313\t    if (this.leaderFinishedAt !== null && !this.done) {\n314\t      const best = this.cars.reduce((a, e) => (e.bestLap && (!a || e.bestLap < a) ? e.bestLap : a), null) ?? 90;\n315\t      if (this.time - this.leaderFinishedAt > Math.max(60, best * 1.25)) {\n316\t        for (const e of this.cars) if (!e.finished && !e.flagged) { e.flagged = true; if (e.player !== null) { e.finished = true; e.finishTime = null; e.autoDrive = true; this.emit('flag', e, { kind: 'finish', own: true, flagged: true }); } }\n317\t      }\n318\t    }\n319\t    if (!this.done && this.players.length && this.players.every((e) => e.finished)) {\n320\t      // Rally: the clock decides, so wait until the rival has finished or its clock has passed ours.\n321\t      const stagger = this.setup.start === 'stagger', me = this.players[0], rival = stagger ? this.cars.find((x) => x !== me) : null;\n322\t      if (!stagger || !rival || rival.finished || me.finishTime === null || (rival.ownStart !== null && this.time - rival.ownStart > me.finishTime)) { this.done = true; this.doneAt = this.time; }\n323\t    }\n324\t  }\n325\t  // Times shown to the player: leader's time, gaps for the rest.\n326\t  results() {\n327\t    const rows = this.order.map((e) => ({ i: e.i, name: e.name, carId: e.carId, player: e.player, pos: e.pos, time: e.finishTime, finished: e.finished && !e.retired && e.finishTime !== null, retired: e.retired, best: e.bestLap, progress: e.progress }));\n328\t    const leader = rows[0], lapLen = this.tr.length;\n329\t    for (const r of rows) {\n330\t      if (r === leader) { r.text = r.finished ? formatTime(r.time) : '--:--'; continue; }\n331\t      if (r.finished) r.text = `+${(r.time - leader.time).toFixed(2)}`;\n332\t      else if (r.retired) r.text = 'RETIRED';\n333\t      else { const laps = Math.max(0, Math.floor((leader.progress - r.progress) / lapLen)); r.text = laps >= 1 ? `+${laps} LAP` : 'RUNNING'; }\n334\t    }\n335\t    return rows;\n336\t  }\n337\t  gapAhead(e) {\n338\t    const k = this.order.indexOf(e); if (k <= 0) return null;\n339\t    const a = this.order[k - 1], d = a.progress - e.progress, v = Math.max(8, Math.abs(e.c.u));\n340\t    return d / v;\n341\t  }\n342\t  gapBehind(e) {\n343\t    const k = this.order.indexOf(e); if (k < 0 || k >= this.order.length - 1) return null;\n344\t    const b = this.order[k + 1], d = e.progress - b.progress, v = Math.max(8, Math.abs(b.c.u));\n345\t    return d / v;\n346\t  }\n347\t  // Rally: how far ahead on the clock, comparing our time now to the rival's time at this same place.\n348\t  clockGap(e, rival) {\n349\t    if (e.ownStart === null || rival.ownStart === null) return null;\n350\t    const k = Math.floor(Math.max(0, e.progress) / 20);\n351\t    const theirs = rival.splits[k], mine = this.time - e.ownStart;\n352\t    if (theirs !== undefined) return mine - theirs; // positive: we are behind\n353\t    const k2 = Math.floor(Math.max(0, rival.progress) / 20), mineThere = e.splits[k2], theirNow = this.time - rival.ownStart;\n354\t    return mineThere !== undefined ? mineThere - theirNow : null;\n355\t  }\n356\t  record() {\n357\t    const v = this.recVals;\n358\t    for (const e of this.cars) {\n359\t      const c = e.c, inp = e.inp, br = inp ? inp.brake > 0.05 : e.pit?.phase === 'in';\n360\t      v[0] = c.x; v[1] = c.y; v[2] = c.z; v[3] = c.yaw; v[4] = this.bodyPitch(e); v[5] = this.bodyRoll(e); v[6] = c.delta; v[7] = c.rpm; v[8] = inp ? inp.throttle : 0.2; v[9] = c.gear;\n361\t      v[10] = (br ? F_BRAKE : 0) | (c.sliding ? F_SLIDE : 0) | (c.airborne ? F_AIR : 0) | (e.pit ? F_PIT : 0) | (c.locked ? F_LOCK : 0) | F_HEAD; v[11] = c.u;\n362\t      this.rec.add(e.i, v);\n363\t    }\n364\t    this.rec.push();\n365\t  }\n366\t  bodyPitch(e) { const c = e.c, tr = this.tr; return -c.ax * 0.004 - Math.atan(tr.slope[c.loc.i] * Math.sign(c.u || 1)) * (Math.cos(c.yaw - Math.atan2(tr.tx[c.loc.i], tr.tz[c.loc.i])) > 0 ? 1 : -1); }\n367\t  bodyRoll(e) { const c = e.c, tr = this.tr; return c.ay * 0.008 + tr.bank[c.loc.i]; }\n368\t  fingerprint() {\n369\t    let h = 2166136261 >>> 0;\n370\t    const mix = (v) => { h ^= v | 0; h = Math.imul(h, 16777619) >>> 0; };\n371\t    for (const e of this.cars) { mix(Math.round(e.c.x * 100)); mix(Math.round(e.c.z * 100)); mix(e.lap); mix(Math.round(e.c.wear[0] * 10000)); mix(Math.round(e.c.fuel * 10000)); }\n372\t    return h.toString(16);\n373\t  }\n374\t  // Dev mode's save state: the sim as JSON, without its references.\n375\t  saveState() {\n376\t    return JSON.stringify({ time: this.time, frame: this.frame, phase: this.phase, greenAt: this.greenAt, cars: this.cars.map((e) => { const { p, touching, ...c } = e.c; return { c, lap: e.lap, lastS: e.lastS, lapStart: e.lapStart, bestLap: e.bestLap, lastLap: e.lastLap, finished: e.finished, finishTime: e.finishTime, ownStart: e.ownStart, autoDrive: e.autoDrive, pit: e.pit, metres: e.metres }; }), done: this.done, leaderFinishedAt: this.leaderFinishedAt });\n377\t  }\n378\t  loadState(json) {\n379\t    const s = JSON.parse(json);\n380\t    this.time = s.time; this.frame = s.frame; this.phase = s.phase; this.greenAt = s.greenAt; this.done = s.done; this.leaderFinishedAt = s.leaderFinishedAt;\n381\t    s.cars.forEach((d, i) => { const e = this.cars[i]; Object.assign(e.c, d.c); e.lap = d.lap; e.lastS = d.lastS; e.lapStart = d.lapStart; e.bestLap = d.bestLap; e.lastLap = d.lastLap; e.finished = d.finished; e.finishTime = d.finishTime; e.ownStart = d.ownStart; e.autoDrive = d.autoDrive; e.pit = d.pit; e.metres = d.metres; e.progress = this.progressOf(e); });\n382\t    this.updateOrder();\n383\t  }\n384\t  teleport(i, s) { const e = this.cars[i], tr = this.tr, c = e.c, pt = trackPoint(tr, s, 0); c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.loc.i = pt.i; c.loc.s = wrapS(tr, s); c.loc.t = 0; c.vx = 0; c.vz = 0; c.r = 0; c.delta = 0; c.vy = 0; e.lastS = c.loc.s; e.progress = this.progressOf(e); }\n385\t  // Dev: finish now in position n (1-based).\n386\t  finishNow(i, n = 1) {\n387\t    const e = this.cars[i], others = this.cars.filter((x) => x !== e), base = this.time;\n388\t    const mine = Math.max(30, base - (e.ownStart ?? 0));\n389\t    others.forEach((o, k) => { const ahead = k < n - 1; if (!o.finished) { o.finished = true; o.finishTime = mine + (ahead ? -8 + k : 2 + k); } });\n390\t    if (!e.finished) { e.finished = true; e.finishTime = mine; e.autoDrive = e.player !== null; }\n391\t    this.leaderFinishedAt = this.leaderFinishedAt ?? base;\n392\t    this.updateOrder(); this.checkFinish();\n393\t    this.emit('flag', e, { kind: 'finish', own: true });\n394\t  }\n395\t}\n396\tfunction wrapDelta(a, b, L) { let d = a - b; if (d > L / 2) d -= L; else if (d < -L / 2) d += L; return d; }\n397\texport function formatTime(t) {\n398\t  if (t === null || t === undefined || !Number.isFinite(t)) return '--:--.-';\n399\t  const m = Math.floor(t / 60), s = t - m * 60;\n400\t  return `${m}:${s < 10 ? '0' : ''}${s.toFixed(2)}`;\n401\t}\n402\texport { GhostTrace, G };\n403\t"}]},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"a8692e9d-8288-4ad8-9cce-195924c35671","timestamp":"2026-11-06T04:15:19.799Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-171904__x89353d/work/GranTumbleweed-GranTurismo3ASpec-claude-opus-5-5-xhigh-20261105-171904/src/game/sim/race.js","content":"// RaceSim: the field, laps, flags, starts, pit lane, slipstream, results, replay feed and events. Plain JS, no engine.\nimport { aiDrive, buildTrack, collideCars, G, newCar, racingLine, RHO, speedProfile, stepCar } from './sim.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { tunedParams } from './tuning.js';\nimport { F_AIR, F_BRAKE, F_HEAD, F_LOCK, F_PIT, F_SLIDE, FIELDS, GhostTrace, Recording } from './replaydata.js';\n\nexport const PIT_WIDTH = 8, PIT_SPEED = 60 / 3.6;\nconst lineCache = new Map(), profileCache = new Map();\nexport function loadTrack(id, { rain = false } = {}) {\n  const tr = buildTrack(TRACKS[id]);\n  tr.id = id; tr.name = TRACKS[id].name; tr.pit = TRACKS[id].pit ?? null;\n  if (rain) tr.muScale = 0.78;\n  if (!lineCache.has(id)) lineCache.set(id, racingLine(tr));\n  if (tr.pit) { const inner = tr.pit.in; tr.pit = { ...tr.pit, lead: inner - 60 }; forPit(tr, (i) => { tr.wallR[i] = PIT_WIDTH + 2; }); }\n  return { tr, line: lineCache.get(id) };\n}\nexport const wrapS = (tr, s) => ((s % tr.length) + tr.length) % tr.length;\nconst rel = (tr, s) => { let d = wrapS(tr, s); if (d > tr.length / 2) d -= tr.length; return d; };\nfunction forPit(tr, fn) { const from = tr.pit.lead ?? tr.pit.in; for (let i = 0; i < tr.N; i++) { const d = rel(tr, i * tr.ds); if (d >= from && d <= tr.pit.out) fn(i, d); } }\nexport function trackPoint(tr, s, t, out = {}) {\n  const S = wrapS(tr, s), f = S / tr.ds, i = Math.floor(f) % tr.N, j = (i + 1) % tr.N, u = f - Math.floor(f), L = (a) => a[i] + (a[j] - a[i]) * u, tx = L(tr.tx), tz = L(tr.tz), bk = L(tr.bank);\n  out.x = L(tr.x) - tz * t; out.z = L(tr.z) + tx * t; out.y = L(tr.y) - t * Math.sin(bk); out.yaw = Math.atan2(tx, tz); out.i = i; out.tx = tx; out.tz = tz; out.width = L(tr.width); out.bank = bk; out.slope = tr.slope[i];\n  return out;\n}\nexport function indexOfS(tr, s) { return Math.round(wrapS(tr, s) / tr.ds) % tr.N; }\nfunction mulberry(seed) { let a = seed >>> 0; return () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nexport function carProfile(tr, line, p, carId, installKey) {\n  const key = `${tr.id}|${carId}|${installKey}|${tr.muScale}`;\n  let v = profileCache.get(key);\n  if (!v) {\n    const surf = (tr.surface === 'dirt' ? (p.tyreTable?.dirt ?? 0.62) : 1) * tr.muScale;\n    // Steep banking: the flat-road estimate is too hopeful, and a car that overdrives it scrapes the wall and eats its tyres.\n    // Measured on Saltline: this limit is quicker and clean for every car. It leaves flat circuits alone.\n    let vCap = null;\n    for (let i = 0; i < tr.N; i++) if (Math.abs(tr.bank[i]) > 0.15) {\n      vCap ??= new Float64Array(tr.N).fill(110);\n      const mu = p.tyreMu * 0.57 * surf, tb = Math.tan(Math.abs(tr.bank[i])), muB = (mu + tb) / Math.max(0.2, 1 - mu * tb), den = Math.max(Math.abs(line.kappa[i]), 1e-5) - (muB * (RHO * p.clA)) / (2 * p.mass);\n      vCap[i] = den > 1e-5 ? Math.min(110, Math.sqrt((muB * G) / den)) : 110;\n    }\n    v = speedProfile(tr, line, vCap ? { ...p, vCap } : p, surf); profileCache.set(key, v);\n  }\n  return v;\n}\nexport const defaultEnv = () => ({ gripScale: 1, powerScale: 1, brakeScale: 1, aeroScale: 1, wearScale: 1, fuelScale: 1, wallLoss: 1, stability: 1, traction: 1, rubber: 0, slip: 0.65, aiPace: null, god: false, steerRate: 3 });\nconst BASE_WEAR = 0.0012, BASE_FUEL = 0.0018;\nexport class RaceSim {\n  // setup: { kind, track, laps, rain, start, startS, startSpeed, contact, wear, fuel, cars: [{ carId, install, oil, name, paint, skill, player, assists, seat }], seed, stagger }\n  constructor(setup) {\n    this.setup = setup; this.kind = setup.kind ?? 'race'; this.laps = setup.laps ?? 1; this.rng = mulberry(setup.seed ?? 1);\n    const { tr, line } = loadTrack(setup.track, { rain: setup.rain }); this.tr = tr; this.line = line;\n    this.contact = setup.contact !== false; this.wearMul = setup.wear ?? 1; this.fuelMul = setup.fuel ?? 1; this.env = setup.env ?? defaultEnv();\n    this.frame = 0; this.time = 0; this.greenAt = null; this.phase = 'grid'; this.lights = 0; this.lightT = 0; this.events = []; this.order = []; this.done = false; this.leaderFinishedAt = null; this.hold = !!setup.hold; this.subEnv = {}; this.flaggedAt = null; this.hourNow = setup.hour ?? TRACKS[setup.track].hour; this.cool = false;\n    this.cars = setup.cars.map((d, i) => this.makeEntry(d, i));\n    this.placeGrid();\n    this.players = this.cars.filter((e) => e.player !== null && e.player !== undefined);\n    this.order = this.cars.slice();\n    this.rec = setup.record === false ? null : new Recording({ track: setup.track, hour: this.hourNow, hourEnd: setup.hourEnd ?? null, rain: !!setup.rain, cars: this.cars.map((e) => ({ carId: e.carId, install: e.install, name: e.name, paint: e.paint, player: e.player ?? null })) });\n    this.recVals = new Array(FIELDS).fill(0);\n    this.updateOrder();\n  }\n  makeEntry(d, i) {\n    const p = tunedParams(d.carId, d.install), tr = this.tr, c = newCar(p, tr, 0, 0), installKey = d.install ? JSON.stringify(d.install) : '';\n    c.oil = d.oil ?? 1;\n    const e = { i, carId: d.carId, install: d.install ?? null, name: d.name ?? `CAR ${i + 1}`, paint: d.paint ?? null, player: d.player ?? null, seat: d.seat ?? null, c, p, installKey, speeds: carProfile(tr, this.line, p, d.carId, installKey), skill: d.skill ?? 0.9, assists: d.assists ?? null, lap: 0, lastS: 0, lapStart: null, lastLap: null, bestLap: null, finished: false, finishTime: null, retired: false, progress: 0, pit: null, noContact: 0, stopped: 0, recoveries: 0, walls: 0, topSpeed: 0, wrongWay: false, reverse: false, brakeHold: 0, dirt: d.dirt ?? 0, dirtM: 0, metres: 0, lapse: 0, lapseAt: 0.2 + 0.6 * this.rng(), phase: this.rng() * 6.28, slip: false, autoDrive: false, wantPit: false, pits: 0, startDelay: d.startDelay ?? 0, ownStart: null, splits: [], lastSurface: null, lastGear: 1, lastWalls: 0, lastAir: false, airT: 0, lockT: 0, onLapDirty: false, flagged: false, input: null, laneNow: 0 };\n    return e;\n  }\n  placeGrid() {\n    const s = this.setup, tr = this.tr, n = this.cars.length;\n    const place = (e, S, t, speed) => { const i = indexOfS(tr, S), pt = trackPoint(tr, S, t), c = e.c; c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.loc.i = i; c.loc.s = wrapS(tr, S); c.loc.t = t; c.vx = Math.sin(pt.yaw) * speed; c.vz = Math.cos(pt.yaw) * speed; c.u = speed; e.lastS = wrapS(tr, S); c.laneNow = t - this.line.off[i]; e.gridT = t; };\n    const kind = s.start ?? 'standing';\n    if (kind === 'rolling') {\n      this.phase = 'rolling';\n      this.cars.forEach((e, k) => place(e, -150 - Math.floor(k / 2) * 12, k % 2 ? 2.6 : -2.6, 80 / 3.6));\n    } else if (kind === 'flying') {\n      this.phase = 'green'; this.greenAt = 0;\n      const S = s.startS ?? -220;\n      this.cars.forEach((e, k) => { place(e, S - k * 12, 0, (s.startSpeed ?? 120) / 3.6); e.ownStart = 0; });\n    } else { // standing, and rally's stagger\n      this.phase = 'grid';\n      const S0 = s.startS ?? -12;\n      this.cars.forEach((e, k) => {\n        const row = Math.floor(k / 2), staggered = kind === 'stagger';\n        place(e, staggered ? S0 : S0 - row * 9, staggered || this.cars.length === 1 ? 0 : k % 2 ? 2.6 : -2.6, 0);\n      });\n    }\n    this.updateProgressAll();\n  }\n  updateProgressAll() { for (const e of this.cars) e.progress = this.progressOf(e); }\n  progressOf(e) { return (e.lap - 1) * this.tr.length + (e.lap === 0 ? wrapS(this.tr, e.c.loc.s) : e.c.loc.s); }\n  go() { if (this.phase === 'grid') { this.hold = false; this.green(); } }\n  green() { this.phase = 'green'; this.greenAt = this.time; for (const e of this.cars) if (e.startDelay === 0) e.ownStart = this.time; this.events.push({ type: 'flag', kind: 'green' }); }\n  emit(type, car, extra) { this.events.push({ type, car: car?.i ?? -1, ...extra }); }\n  drainEvents() { const ev = this.events; this.events = []; return ev; }\n  envFor(e) {\n    const v = this.env, god = v.god && e.player !== null, se = this.subEnv;\n    se.gripScale = v.gripScale; se.powerScale = v.powerScale; se.brakeScale = v.brakeScale; se.aeroScale = v.aeroScale;\n    se.wearRate = god ? 0 : BASE_WEAR * this.wearMul * v.wearScale; se.fuelRate = god ? 0 : BASE_FUEL * this.fuelMul * v.fuelScale; se.wallLoss = god ? 0 : v.wallLoss;\n    return se;\n  }\n  aiInput(e, skillMul = 1) {\n    const c = e.c, tr = this.tr, u = Math.hypot(c.vx, c.vz);\n    let skill = (this.env.aiPace ?? e.skill) * skillMul * (tr.def.aiScale ?? 1);\n    const wearNow = (c.wear[0] + c.wear[1] + c.wear[2] + c.wear[3]) / 4; skill *= Math.sqrt(0.72 + 0.28 * Math.sqrt(wearNow)); // a worn tyre has less to give, and the AI knows it\n    if (e.lapse > 0) { skill -= 0.04; e.lapse -= 1 / 60; }\n    if (this.env.rubber > 0 && this.players.length) { const lead = this.players[0].progress - e.progress; skill += Math.max(-1, Math.min(1, lead / 150)) * this.env.rubber; }\n    let lane = Math.sin(e.phase + this.time * 0.3) * 0.6;\n    if (this.phase === 'rolling') { lane = (e.gridT ?? 0) - this.line.off[c.loc.i]; }\n    const field = this.contact && !e.finished ? (this.rawCars ??= this.cars.map((x) => x.c)) : null;\n    const inp = aiDrive(c, tr, this.line, e.speeds, { skill, lane }, field);\n    if (this.phase === 'rolling') { const err = 88 / 3.6 - u; inp.throttle = err > 0 ? Math.min(1, err) : 0; inp.brake = err < -1 ? 0.3 : 0; }\n    if (tr.surface === 'dirt') inp.asm = (inp.asm ?? 0.6) * 0.5;\n    return inp;\n  }\n  driverInput(e, raw) {\n    // raw: { steer, throttle, brake, handbrake, up, down } from the input layer. Assists come from the profile.\n    const c = e.c, a = e.assists ?? {}, env = this.env, inp = e.input ?? (e.input = {});\n    let throttle = raw.throttle ?? 0, brake = raw.brake ?? 0;\n    const speed = c.u;\n    // Reverse: hold the brake at a standstill for 0.4 s. Any throttle returns to first.\n    if (e.reverse) { if (throttle > 0.05) { e.reverse = false; c.gear = 1; } else { throttle = brake; brake = 0; } }\n    else if (brake > 0.2 && throttle < 0.05 && Math.abs(speed) < 0.5) { e.brakeHold += 1 / 60; if (e.brakeHold > 0.4) { e.reverse = true; e.brakeHold = 0; c.gear = 1; } } else e.brakeHold = 0;\n    inp.steer = raw.steer ?? 0; inp.throttle = throttle; inp.brake = brake; inp.handbrake = !!raw.handbrake; inp.reverse = e.reverse;\n    inp.abs = a.abs !== false; inp.auto = a.auto !== false; inp.up = !!raw.up; inp.down = !!raw.down;\n    inp.tcs = Math.min(1, ((a.tcs ?? 5) / 10) * env.traction); inp.asm = Math.min(1, ((a.asm ?? 5) / 10) * env.stability * (this.tr.surface === 'dirt' ? 0.5 : 1)); inp.steerRate = env.steerRate;\n    if (this.phase === 'rolling') { if (c.u > 25) { inp.throttle = 0; if (c.u > 26) inp.brake = Math.max(inp.brake, 0.3); } }\n    if (this.phase === 'grid') { inp.throttle = 0; inp.brake = 1; inp.handbrake = false; inp.reverse = false; }\n    if (e.ownStart === null && this.phase !== 'rolling') { inp.throttle = 0; inp.brake = 1; }\n    return inp;\n  }\n  step(inputs = []) {\n    const dt = 1 / 60;\n    this.frame++; this.time += dt;\n    if (this.phase === 'grid' && !this.hold) {\n      this.lightT += dt;\n      const lit = Math.min(5, Math.floor(this.lightT / 0.6));\n      if (lit !== this.lights) { this.lights = lit; this.events.push({ type: 'flag', kind: 'lights', n: lit }); }\n      if (this.lightT > 3.4) this.green();\n    }\n    if (this.phase === 'rolling') {\n      const leader = this.cars.reduce((a, b) => (this.progressOf(a) > this.progressOf(b) ? a : b));\n      if (this.progressOf(leader) >= 0 && leader.lap >= 1) { this.green(); }\n    }\n    for (const e of this.cars) {\n      if (e.ownStart === null && this.phase === 'green' && this.time - this.greenAt >= e.startDelay) { e.ownStart = this.time; if (e.player !== null) this.events.push({ type: 'flag', kind: 'green', own: true }); }\n    }\n    this.slipstream();\n    for (const e of this.cars) {\n      const human = e.player !== null && !e.autoDrive && !e.finished && !e.retired;\n      if (e.pit) { e.inp = null; continue; }\n      if (human) e.inp = this.driverInput(e, inputs[e.player] ?? {});\n      else {\n        const held = (this.phase === 'grid') || (e.ownStart === null && this.phase !== 'rolling');\n        e.inp = held ? { steer: 0, throttle: 0, brake: 1, abs: true, auto: true, tcs: 0, asm: 0 } : this.aiInput(e, e.finished ? 0.82 : 1);\n      }\n    }\n    const contactCars = this.contact ? this.cars.filter((e) => !e.pit && e.noContact <= 0 && !e.ghost).map((e) => e.c) : null;\n    for (let sub = 0; sub < 4; sub++) {\n      for (const e of this.cars) {\n        if (e.pit) continue;\n        const inp = e.inp;\n        if (sub > 0 && inp.up) { inp.up = false; }\n        if (sub > 0 && inp.down) { inp.down = false; }\n        stepCar(e.c, inp, 1 / 240, this.tr, this.envFor(e));\n      }\n      if (contactCars) collideCars(contactCars);\n    }\n    for (const e of this.cars) this.post(e, dt);\n    if (this.setup.hourEnd !== undefined && this.setup.hourEnd !== null && this.laps > 0) {\n      const lead = Math.max(0, Math.max(...this.cars.map((e) => e.progress))) / (this.laps * this.tr.length);\n      this.hourNow = (this.setup.hour ?? 18.5) + (this.setup.hourEnd - (this.setup.hour ?? 18.5)) * Math.min(1, lead);\n    }\n    this.updateOrder();\n    this.checkFinish();\n    if (this.rec && this.frame % 2 === 0) this.record();\n  }\n  slipstream() {\n    const tr = this.tr, slip = this.env.slip;\n    for (const e of this.cars) {\n      e.slip = false; e.c.dragScale = 1;\n      if (Math.abs(e.c.u) < 100 / 3.6 || e.pit) continue;\n      for (const b of this.cars) {\n        if (b === e || b.pit) continue;\n        let gap = (b.c.loc.s - e.c.loc.s + tr.length) % tr.length;\n        if (gap > 0.5 && gap < 25 && Math.abs(b.c.loc.t - e.c.loc.t) < 2) { e.c.dragScale = slip; e.slip = true; break; }\n      }\n    }\n  }\n  post(e, dt) {\n    const c = e.c, tr = this.tr;\n    if (e.pit) this.stepPit(e, dt);\n    if (e.noContact > 0) e.noContact -= dt;\n    // Lap count: s wraps from past 90% to under 10% going forward.\n    const s = c.loc.s, L = tr.length;\n    if (e.lastS > L * 0.9 && s < L * 0.1) this.crossLine(e);\n    else if (e.lastS < L * 0.1 && s > L * 0.9) { if (e.lap > 0) e.lap--; }\n    const moved = Math.min(5, Math.abs(wrapDelta(s, e.lastS, L)));\n    e.metres += moved;\n    if (c.surface === 'dirt' || c.surface === 'gravel') { e.dirtM += moved; e.dirt = Math.min(1, e.dirt + moved * 0.0002); }\n    e.lastS = s;\n    e.progress = this.progressOf(e);\n    e.topSpeed = Math.max(e.topSpeed, Math.abs(c.u));\n    const sp = Math.hypot(c.vx, c.vz);\n    // Wrong way\n    const dot = Math.sin(c.yaw) * tr.tx[c.loc.i] + Math.cos(c.yaw) * tr.tz[c.loc.i];\n    e.wrongWay 