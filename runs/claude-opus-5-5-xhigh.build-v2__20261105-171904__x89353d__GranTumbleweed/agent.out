it_for_function(\"window.__GAME__.state().screen==='results'\"); pg.wait_for_timeout(500)\n    pg.evaluate(\"window.__APP__.driverOverride=null; window.__APP__.watchReplay({after:()=>{}})\"); pg.wait_for_function(\"window.__GAME__.state().scene==='replay'&&!window.__APP__.switching\")\n    for k in range(3):\n        pg.evaluate(f\"window.__APP__.scene.t=Math.min(window.__APP__.scene.rec.duration-2,{4+k*9}); window.__APP__.scene.tv.force();\"); pg.wait_for_timeout(1500); pg.screenshot(path=f'shots/tv{k}.png')\n        print(k, pg.evaluate(\"(()=>{const r=window.__APP__.scene,c=r.cam,S=r.tv.shot;return {fov:+c.fov.toFixed(1),dist:+Math.hypot(S.x-r.fx.x,S.z-r.fx.z).toFixed(0),heli:!!S.heli,low:!!S.low}})()\"))\n    print('errors',errs[:3]); b.close()\nEOF\ntimeout 200 python3 tools/.shot.py 2>&1 | tail -n 6 | cut -c1-260","description":"Capture the test card and replay TV shots","timeout":220000}}}
