{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjecBWXdcp2ikCK3qY4","type":"message","role":"assistant","content":[{"type":"text","text":"Now the render layer: a triangle batcher, the track mesh with skirts and barriers, then per-track dressing."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10947,"cache_read_input_tokens":254736,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10947},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"ff81042a-f387-4810-b326-7837a2af31bc","timestamp":"2026-11-06T00:35:54.087Z","request_id":"req_011Cgkjebv9ZZLMDVJviJ6kv"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjecBWXdcp2ikCK3qY4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Mf4gTkjoq8mgsFCaZe7Cdp","name":"Bash","input":{"command":"cat > src/game/render/geo.js <<'EOF'\n// A batch of flat-shaded, vertex-coloured triangles: one draw call for a whole world of chunky shapes.\nimport { glowMaterial, PALETTE, THREE, toonMaterial } from '../../pixel-engine.js';\nconst { BufferGeometry, Color, Float32BufferAttribute, Mesh } = THREE;\nconst cache = new Map();\nexport function rgb(c) {\n  if (c && typeof c === 'object') return c;\n  let v = cache.get(c);\n  if (!v) { const col = new Color(typeof c === 'string' ? PALETTE[c] : c); v = { r: col.r, g: col.g, b: col.b }; cache.set(c, v); }\n  return v;\n}\nexport const mix = (a, b, t) => { const A = rgb(a), B = rgb(b); return { r: A.r + (B.r - A.r) * t, g: A.g + (B.g - A.g) * t, b: A.b + (B.b - A.b) * t }; };\nexport const shade = (a, k) => { const A = rgb(a); return { r: A.r * k, g: A.g * k, b: A.b * k }; };\nexport class GeoBatch {\n  constructor() { this.pos = []; this.nor = []; this.col = []; }\n  get triangles() { return this.pos.length / 9; }\n  tri(a, b, c, color) {\n    const C = rgb(color), ux = b[0] - a[0], uy = b[1] - a[1], uz = b[2] - a[2], vx = c[0] - a[0], vy = c[1] - a[1], vz = c[2] - a[2]; let nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx; const l = Math.hypot(nx, ny, nz) || 1; nx /= l; ny /= l; nz /= l;\n    this.pos.push(a[0], a[1], a[2], b[0], b[1], b[2], c[0], c[1], c[2]);\n    this.nor.push(nx, ny, nz, nx, ny, nz, nx, ny, nz);\n    this.col.push(C.r, C.g, C.b, C.r, C.g, C.b, C.r, C.g, C.b);\n  }\n  quad(a, b, c, d, color) { this.tri(a, b, c, color); this.tri(a, c, d, color); }\n  // A box standing on (x, y0, z), turned by yaw about Y. topC colours the top face.\n  box(x, y0, z, w, h, d, color, yaw = 0, topC = null) {\n    const s = Math.sin(yaw), c = Math.cos(yaw), P = (lx, ly, lz) => [x + lx * c + lz * s, y0 + ly, z - lx * s + lz * c], hw = w / 2, hd = d / 2;\n    const a = P(-hw, 0, -hd), b = P(hw, 0, -hd), e = P(hw, 0, hd), f = P(-hw, 0, hd), g = P(-hw, h, -hd), i = P(hw, h, -hd), j = P(hw, h, hd), k = P(-hw, h, hd);\n    this.quad(a, g, i, b, color); this.quad(b, i, j, e, color); this.quad(e, j, k, f, color); this.quad(f, k, g, a, color); this.quad(g, k, j, i, topC ?? color); this.quad(a, b, e, f, color);\n  }\n  // A box between two points, width w and height h, standing on the line.\n  beam(p, q, w, h, color) {\n    const dx = q[0] - p[0], dz = q[2] - p[2], l = Math.hypot(dx, dz) || 1, rx = (dz / l) * (w / 2), rz = (-dx / l) * (w / 2);\n    const a = [p[0] - rx, p[1], p[2] - rz], b = [p[0] + rx, p[1], p[2] + rz], c = [q[0] + rx, q[1], q[2] + rz], d = [q[0] - rx, q[1], q[2] - rz], up = (v) => [v[0], v[1] + h, v[2]];\n    this.quad(a, up(a), up(d), d, color); this.quad(c, up(c), up(b), b, color); this.quad(up(a), up(b), up(c), up(d), color); this.quad(d, up(d), up(c), c, color); this.quad(b, up(b), up(a), a, color);\n  }\n  cone(x, y0, z, r, h, n, color, r1 = 0, yaw = 0) {\n    const top = y0 + h;\n    for (let i = 0; i < n; i++) {\n      const a0 = yaw + (i / n) * Math.PI * 2, a1 = yaw + ((i + 1) / n) * Math.PI * 2, A = [x + Math.sin(a0) * r, y0, z + Math.cos(a0) * r], B = [x + Math.sin(a1) * r, y0, z + Math.cos(a1) * r];\n      if (r1 > 0) { const C = [x + Math.sin(a1) * r1, top, z + Math.cos(a1) * r1], D = [x + Math.sin(a0) * r1, top, z + Math.cos(a0) * r1]; this.quad(A, B, C, D, color); this.tri(D, C, [x, top, z], color); }\n      else this.tri(A, B, [x, top, z], color);\n    }\n  }\n  ball(x, y, z, r, color, n = 6, sy = 1) { // a low-poly lump: two rings and two poles\n    const ring = (k, f, ry) => { const out = []; for (let i = 0; i < n; i++) { const a = ((i + k) / n) * Math.PI * 2; out.push([x + Math.sin(a) * r * f, y + ry * r * sy, z + Math.cos(a) * r * f]); } return out; };\n    const r0 = ring(0, 0.85, 0.5), r1 = ring(0.5, 0.85, -0.5), T = [x, y + r * sy, z], B = [x, y - r * sy, z];\n    for (let i = 0; i < n; i++) { const j = (i + 1) % n; this.tri(r0[i], r0[j], T, color); this.tri(r1[j], r1[i], B, color); this.tri(r1[i], r1[j], r0[j], color); this.tri(r1[i], r0[j], r0[i], color); }\n  }\n  // A vertical panel facing +normal side (both sides drawn).\n  panel(p, q, h, color) { const a = p, b = q, c = [q[0], q[1] + h, q[2]], d = [p[0], p[1] + h, p[2]]; this.quad(a, b, c, d, color); this.quad(b, a, d, c, color); }\n  geometry() {\n    const g = new BufferGeometry();\n    g.setAttribute('position', new Float32BufferAttribute(this.pos, 3));\n    g.setAttribute('normal', new Float32BufferAttribute(this.nor, 3));\n    g.setAttribute('color', new Float32BufferAttribute(this.col, 3));\n    return g;\n  }\n  mesh({ cast = false, receive = true, glow = false } = {}) {\n    let mat;\n    if (glow) { mat = glowMaterial(0xffffff).clone(); mat.vertexColors = true; mat.userData = {}; } else mat = toonMaterial(0xffffff, { vertexColors: true });\n    const m = new Mesh(this.geometry(), mat);\n    m.castShadow = cast; m.receiveShadow = receive && !glow; m.frustumCulled = false;\n    return m;\n  }\n}\n// Value noise on a coarse grid, for hills and blotches.\nexport function noise2(seed = 1) {\n  const h = (x, y) => { let n = Math.imul(x, 374761393) + Math.imul(y, 668265263) + Math.imul(seed, 2147483647 / 3 | 0); n = Math.imul(n ^ (n >>> 13), 1274126177); return ((n ^ (n >>> 16)) >>> 0) / 4294967296; };\n  const s = (t) => t * t * (3 - 2 * t);\n  return (x, y) => { const xi = Math.floor(x), yi = Math.floor(y), u = s(x - xi), v = s(y - yi); const a = h(xi, yi), b = h(xi + 1, yi), c = h(xi, yi + 1), d = h(xi + 1, yi + 1); return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v; };\n}\nexport function seeded(seed = 1) { let a = seed >>> 0; const f = () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; f.range = (x, y) => x + (y - x) * f(); f.pick = (l) => l[Math.floor(f() * l.length) % l.length]; return f; }\nEOF\ncat > src/game/render/trackmesh.js <<'EOF'\n// Builds the circuit from the sim's track record: road bands, kerbs, lines, skirts of terrain, barriers and boards.\nimport { THREE } from '../../pixel-engine.js';\nimport { GeoBatch, mix, noise2, seeded, shade } from './geo.js';\nimport { PIT_WIDTH } from '../sim/race.js';\nconst { Group } = THREE;\nexport const THEMES = {\n  kestrel: { road: mix('night', 'slate', 0.2), road2: mix('night', 'slate', 0.34), ground: 'green', ramp: ['green', mix('green', 'lime', 0.35), mix('green', 'teal', 0.5), 'green', mix('green', 'sand', 0.2)], barrier: 'armco', hill: 12, fence: 'white', far: ['teal', mix('teal', 'navy', 0.5)] },\n  cedar: { road: mix('night', 'slate', 0.15), road2: mix('night', 'slate', 0.28), ground: 'teal', ramp: [mix('teal', 'green', 0.4), 'teal', mix('teal', 'navy', 0.25), mix('slate', 'teal', 0.5), mix('green', 'teal', 0.6)], barrier: 'armco', hill: 26, rise: 1, far: ['navy', mix('navy', 'slate', 0.4)] },\n  harbour: { road: mix('night', 'ink', 0.25), road2: mix('night', 'ink', 0.05), ground: 'night', ramp: ['night', mix('night', 'slate', 0.25), mix('night', 'ink', 0.4)], barrier: 'concrete', hill: 0, flat: true, far: ['ink', mix('ink', 'navy', 0.6)] },\n  saltline: { road: mix('night', 'slate', 0.1), road2: mix('night', 'slate', 0.24), ground: 'white', ramp: ['white', mix('white', 'mist', 0.35), mix('white', 'sand', 0.3), mix('white', 'mist', 0.6)], barrier: 'catch', hill: 0.5, flat: true, far: ['plum', mix('plum', 'red', 0.45)] },\n  redclay: { road: mix('orange', 'plum', 0.3), road2: mix('orange', 'plum', 0.42), ground: 'orange', ramp: ['orange', mix('orange', 'red', 0.5), mix('orange', 'sand', 0.35), mix('red', 'plum', 0.4), 'red'], barrier: 'tyres', hill: 6, canyon: true, far: ['plum', mix('red', 'plum', 0.5)] },\n  proving: { road: mix('night', 'slate', 0.3), road2: mix('night', 'slate', 0.42), ground: mix('slate', 'green', 0.3), ramp: [mix('slate', 'green', 0.3), mix('slate', 'green', 0.45), 'slate', mix('slate', 'mist', 0.4)], barrier: 'none', hill: 1, flat: true, far: ['teal', mix('slate', 'navy', 0.5)] },\n};\nconst P = (tr, k, t, lift = 0) => { const i = k % tr.N; return [tr.x[i] - tr.tz[i] * t, tr.y[i] + lift - t * Math.sin(tr.bank[i]), tr.z[i] + tr.tx[i] * t]; };\n// A strip of the road from offset fn from() to fn to(), one quad per sample, colours unshared.\nexport function ribbon(b, tr, from, to, lift, colourAt, range = null) {\n  const up = from(10) < to(10);\n  const each = (i) => {\n    const col = colourAt(i); if (col === null) return;\n    const hA = tr.width[i % tr.N] / 2, hD = tr.width[(i + 1) % tr.N] / 2, a = P(tr, i, from(hA), lift), e0 = P(tr, i, to(hA), lift), d = P(tr, i + 1, from(hD), lift), f = P(tr, i + 1, to(hD), lift);\n    if (up) { b.tri(a, e0, d, col); b.tri(e0, f, d, col); } else { b.tri(a, d, e0, col); b.tri(e0, d, f, col); }\n  };\n  if (range) for (const i of range) each(i); else for (let i = 0; i < tr.N; i++) each(i);\n}\n// A hash of track samples, so a skirt can stop before it reaches another part of the circuit and props can stay off the road.\nexport class TrackField {\n  constructor(tr, cell = 40) { this.tr = tr; this.cell = cell; this.map = new Map(); for (let i = 0; i < tr.N; i += 2) { const k = this.key(tr.x[i], tr.z[i]); let a = this.map.get(k); if (!a) this.map.set(k, (a = [])); a.push(i); } }\n  key(x, z) { return `${Math.floor(x / this.cell)}:${Math.floor(z / this.cell)}`; }\n  // Distance from (x, z) to the nearest road centre within reach.\n  nearest(x, z, reach = 160) {\n    const c = this.cell, n = Math.ceil(reach / c), cx = Math.floor(x / c), cz = Math.floor(z / c), tr = this.tr; let best = Infinity, bi = -1;\n    for (let a = -n; a <= n; a++) for (let b = -n; b <= n; b++) { const l = this.map.get(`${cx + a}:${cz + b}`); if (!l) continue; for (const i of l) { const d = (x - tr.x[i]) ** 2 + (z - tr.z[i]) ** 2; if (d < best) { best = d; bi = i; } } }\n    return { d: Math.sqrt(best), i: bi };\n  }\n  clear(x, z, r = 0) { const { d, i } = this.nearest(x, z, 60 + r); if (i < 0) return true; const tr = this.tr; return d > tr.width[i] / 2 + Math.max(tr.wallL[i], tr.wallR[i]) + 2 + r; }\n}\nexport function roadColourFns(tr, theme, opts = {}) {\n  const lamps = opts.lamps ?? null;\n  return (i) => {\n    const base = i % 4 < 2 ? theme.road : theme.road2;\n    if (lamps) { const k = lamps[i % tr.N]; if (k > 0) return mix(base, 'sand', k * 0.5); }\n    return base;\n  };\n}\nexport function buildTrackMesh(tr, line, { lamps = null, speeds = null, night = false } = {}) {\n  const theme = THEMES[tr.id], group = new Group(), road = new GeoBatch(), land = new GeoBatch(), rails = new GeoBatch(), n2 = noise2(tr.id.length * 7 + 3), rnd = seeded(tr.N), field = new TrackField(tr), dirt = tr.surface === 'dirt';\n  // ---- road ----\n  const roadCol = roadColourFns(tr, theme, { lamps });\n  ribbon(road, tr, (h) => -h, (h) => h, 0, roadCol);\n  // Rubber: a darker strip on the racing line where the speed profile falls.\n  if (speeds && !dirt) { const dark = shade(theme.road, 0.72); for (let i = 0; i < tr.N; i++) { if (speeds[(i + 1) % tr.N] < speeds[i] - 0.05) { const o = line.off[i], o2 = line.off[(i + 1) % tr.N]; road.tri(P(tr, i, o - 0.8, 0.012), P(tr, i, o + 0.8, 0.012), P(tr, i + 1, o2 - 0.8, 0.012), dark); road.tri(P(tr, i, o + 0.8, 0.012), P(tr, i + 1, o2 + 0.8, 0.012), P(tr, i + 1, o2 - 0.8, 0.012), dark); } } }\n  // Kerbs on the inside of corners, red and white every 4 m; edge lines; centre dashes on the pit straight.\n  const kerbHere = (i, s) => Math.abs(tr.kappa[i]) > 1 / 240 && Math.sign(tr.kappa[i]) === s;\n  if (!dirt) {\n    for (const s of [-1, 1]) {\n      ribbon(road, tr, (h) => s * h, (h) => s * (h + 1.6), 0.02, (i) => {\n        const near = [-4, -2, 0, 2, 4, 6].some((o) => kerbHere((i + o + tr.N) % tr.N, s));\n        return near ? (i % 2 ? 'red' : 'white') : mix(theme.ground === 'night' ? 'night' : theme.road2, 'mist', 0.1);\n      });\n      ribbon(road, tr, (h) => s * (h - 0.55), (h) => s * (h - 0.3), 0.03, () => 'white');\n    }\n    const straight = (i) => { const d = i * tr.ds; return tr.pit && (d < tr.pit.out || d > tr.length + tr.pit.in); };\n    ribbon(road, tr, () => -0.15, () => 0.15, 0.03, (i) => (i % 4 === 0 && straight(i) ? 'white' : null));\n  } else {\n    for (const s of [-1, 1]) ribbon(road, tr, (h) => s * h, (h) => s * (h + 1.6), 0.01, (i) => (i % 3 ? mix('orange', 'sand', 0.25) : mix('orange', 'plum', 0.15)));\n    ribbon(road, tr, () => -2.6, () => -1.9, 0.015, () => mix(theme.road, 'ink', 0.25)); ribbon(road, tr, () => 1.9, () => 2.6, 0.015, () => mix(theme.road, 'ink', 0.25));\n  }\n  // Start line: chequered, and a grid of painted boxes.\n  { const cols = 10, k0 = 0, w = tr.width[k0], len = 2.4; for (let r = 0; r < 2; r++) for (let c = 0; c < cols; c++) { const tx = tr.tx[k0], tz = tr.tz[k0], t0 = -w / 2 + (c * w) / cols, t1 = t0 + w / cols, s0 = r * len / 2, s1 = s0 + len / 2, Q = (t, s) => [tr.x[k0] - tz * t + tx * s, tr.y[k0] + 0.04 - t * Math.sin(tr.bank[k0]), tr.z[k0] + tx * t + tz * s]; const col = (r + c) % 2 ? 'white' : 'ink'; road.tri(Q(t0, s0), Q(t1, s0), Q(t0, s1), col); road.tri(Q(t1, s0), Q(t1, s1), Q(t0, s1), col); } }\n  for (let row = 0; row < 4; row++) for (const side of [-1, 1]) { const S = tr.length - 12 - row * 9, i = Math.round(S / tr.ds) % tr.N, tx = tr.tx[i], tz = tr.tz[i], Q = (t, s) => [tr.x[i] - tz * t + tx * s, tr.y[i] + 0.04, tr.z[i] + tx * t + tz * s], t0 = side * 2.6 - 1.2, t1 = side * 2.6 + 1.2; road.tri(Q(t0, 0), Q(t1, 0), Q(t0, 0.3), 'white'); road.tri(Q(t1, 0), Q(t1, 0.3), Q(t0, 0.3), 'white'); }\n  // Pit lane: an apron along the driver's right, with the entry line and the boxes.\n  if (tr.pit) {\n    const isPit = (i) => { let d = i * tr.ds; if (d > tr.length / 2) d -= tr.length; return d >= tr.pit.in && d <= tr.pit.out; };\n    const apron = mix('slate', 'night', 0.4);\n    ribbon(road, tr, (h) => h + 1.6, (h) => h + PIT_WIDTH + 2, 0.015, (i) => (isPit(i) ? apron : null));\n    ribbon(road, tr, (h) => h + 1.6, (h) => h + 1.9, 0.03, (i) => (isPit(i) && i % 3 !== 0 ? 'white' : null));\n    ribbon(road, tr, (h) => h - 3, (h) => h + 1.6, 0.05, (i) => { let d = i * tr.ds; if (d > tr.length / 2) d -= tr.length; return Math.abs(d - tr.pit.in) < 5 && (i % 2 === 0) ? 'sand' : null; });\n    ribbon(road, tr, (h) => h + 5, (h) => h + 7.4, 0.03, (i) => { let d = i * tr.ds; if (d > tr.length / 2) d -= tr.length; return Math.abs(d - tr.pit.box) < 56 && Math.round(d / 4) % 3 === 0 ? 'sand' : null; });\n  }\n  // ---- terrain skirts ----\n  const groundY = Math.min(...tr.y) - 3, cols = [0, 3, 8, 16, 30, 55, 85, 120], ramp = theme.ramp;\n  const heightAt = (i, side, d, baseY) => {\n    const x = tr.x[i], z = tr.z[i], nv = n2(x * 0.012 + side * 3, z * 0.012), k = Math.min(1, d / 60);\n    if (theme.flat) return baseY + (groundY - baseY) * Math.min(1, d / 18) + (theme.hill ?? 0) * nv * k;\n    let h = baseY + (groundY - baseY) * k * k * (3 - 2 * k) + (theme.hill ?? 6) * (nv - 0.25) * k * 1.4;\n    if (theme.rise) { const up = n2(x * 0.006, z * 0.006 + side) - 0.42; if (up > 0) h += up * 110 * Math.min(1, d / 40); }\n    if (theme.canyon) { const wall = n2(x * 0.008 + 9, z * 0.008 + side * 4), rise = Math.max(0, Math.min(1, (d - 16) / 28)); h += rise * rise * (20 + wall * 34) * (0.55 + 0.45 * n2(x * 0.03, z * 0.03)); }\n    return h;\n  };\n  const step = 2, maxReach = cols[cols.length - 1];\n  const lim = { [-1]: new Float32Array(tr.N), 1: new Float32Array(tr.N) };\n  for (let i = 0; i < tr.N; i += step) for (const side of [-1, 1]) {\n    const half = tr.width[i] / 2, rx = -tr.tz[i] * side, rz = tr.tx[i] * side; let reach = maxReach;\n    for (let d = 10; d <= maxReach; d += 10) { const px = tr.x[i] + rx * (half + d), pz = tr.z[i] + rz * (half + d), { d: near } = field.nearest(px, pz, Math.min(120, d + 40)); if (near < (half + d) * 0.9 - 4) { reach = Math.max(4, (d - 10) * 0.95); break; } }\n    lim[side][i] = reach;\n  }\n  for (const side of [-1, 1]) {\n    // Smooth the reach a little, so the skirt's edge doesn't saw back and forth.\n    const r = lim[side], rs = new Float32Array(tr.N);\n    for (let i = 0; i < tr.N; i += step) { let m = Infinity; for (let o = -6; o <= 6; o += step) m = Math.min(m, r[(i + o + tr.N * 2) % tr.N - ((i + o + tr.N * 2) % tr.N) % step] || m); rs[i] = m; }\n    for (let i = 0; i < tr.N; i += step) {\n      const j = (i + step) % tr.N;\n      for (let c = 0; c < cols.length - 1; c++) {\n        const d0 = Math.min(cols[c], rs[i]), d1 = Math.min(cols[c + 1], rs[i]), d2 = Math.min(cols[c], rs[j]), d3 = Math.min(cols[c + 1], rs[j]);\n        if (d1 <= d0 + 0.01 && d3 <= d2 + 0.01) continue;\n        const pt = (k, d) => { const h = tr.width[k] / 2 + 1.5 + d, y = heightAt(k, side, d, tr.y[k] - (h * side) * Math.sin(tr.bank[k])); return [tr.x[k] - tr.tz[k] * h * side, y - (d === 0 ? 0.03 : 0), tr.z[k] + tr.tx[k] * h * side]; };\n        const a = pt(i, d0), b = pt(i, d1), e = pt(j, d2), f = pt(j, d3), nv = n2(a[0] * 0.03, a[2] * 0.03), col = ramp[Math.floor((nv * 1.6 + (c % 2) * 0.12 + rnd() * 0.08) * ramp.length) % ramp.length];\n        const flip = side > 0;\n        if (flip) { land.tri(a, b, e, col); land.tri(b, f, e, col); } else { land.tri(a, e, b, col); land.tri(b, e, f, col); }\n      }\n    }\n  }\n  // The flat ground under everything.\n  { const S = 7000, y = groundY - 0.05, cx = (Math.min(...tr.x) + Math.max(...tr.x)) / 2, cz = (Math.min(...tr.z) + Math.max(...tr.z)) / 2; const c = mix(theme.ground, ramp[1] ?? theme.ground, 0.3); land.quad([cx - S, y, cz - S], [cx - S, y, cz + S], [cx + S, y, cz + S], [cx + S, y, cz - S], c); }\n  // ---- barriers ----\n  const wallPoint = (k, side, up = 0) => { const off = side > 0 ? tr.wallR[k] : tr.wallL[k], t = side * (tr.width[k] / 2 + off + 1.1); return [tr.x[k] - tr.tz[k] * t, tr.y[k] + up - t * Math.sin(tr.bank[k]), tr.z[k] + tr.tx[k] * t]; };\n  if (theme.barrier !== 'none') for (const side of [-1, 1]) for (let i = 0; i < tr.N; i++) {\n    const j = (i + 1) % tr.N, hard = Math.abs(tr.kappa[i]) > 1 / 70, a = wallPoint(i, side), b = wallPoint(j, side);\n    const paint = hard && i % 4 < 2;\n    if (theme.barrier === 'armco') { const col = paint ? (i % 2 ? 'red' : 'white') : 'mist', u = (v, y) => [v[0], v[1] + y, v[2]]; rails.quad(u(a, 0.35), u(b, 0.35), u(b, 0.85), u(a, 0.85), col); rails.quad(u(b, 0.35), u(a, 0.35), u(a, 0.85), u(b, 0.85), col); if (i % 2 === 0) rails.box(a[0], a[1], a[2], 0.18, 0.9, 0.18, 'slate'); }\n    else if (theme.barrier === 'concrete') { const col = paint ? (i % 2 ? 'red' : 'white') : mix('mist', 'slate', 0.45), u = (v, y) => [v[0], v[1] + y, v[2]]; rails.quad(u(a, 0), u(b, 0), u(b, 1.1), u(a, 1.1), col); rails.quad(u(b, 0), u(a, 0), u(a, 1.1), u(b, 1.1), col); rails.quad(u(a, 1.1), u(b, 1.1), [b[0] + side * tr.tz[i] * 0.3 * -1, b[1] + 1.1, b[2] + side * tr.tx[i] * 0.3], [a[0] + side * tr.tz[i] * 0.3 * -1, a[1] + 1.1, a[2] + side * tr.tx[i] * 0.3], 'white'); }\n    else if (theme.barrier === 'catch') { const u = (v, y) => [v[0], v[1] + y, v[2]], col = paint ? 'red' : 'mist'; rails.quad(u(a, 0), u(b, 0), u(b, 0.9), u(a, 0.9), col); rails.quad(u(b, 0), u(a, 0), u(a, 0.9), u(b, 0.9), col); if (i % 3 === 0) rails.box(a[0], a[1], a[2], 0.14, 3.4, 0.14, 'slate'); rails.beam([a[0], a[1] + 3.3, a[2]], [b[0], b[1] + 3.3, b[2]], 0.08, 0.08, 'slate'); rails.beam([a[0], a[1] + 2.1, a[2]], [b[0], b[1] + 2.1, b[2]], 0.05, 0.05, 'slate'); }\n    else if (theme.barrier === 'tyres') { if (hard || i % 3 === 0) { const col = paint ? (i % 2 ? 'red' : 'white') : 'ink'; rails.cone(a[0], a[1], a[2], 0.42, 0.45, 6, col, 0.42); rails.cone(a[0], a[1] + 0.45, a[2], 0.42, 0.42, 6, 'ink', 0.42); } }\n  }\n  // ---- braking boards at 300, 200, 100 m before major corners ----\n  tr.cornerS.forEach((cs, ci) => {\n    const k = Math.round(cs / tr.ds) % tr.N;\n    if (Math.abs(tr.kappa[k]) < 1 / 90) return;\n    const side = tr.kappa[k] > 0 ? -1 : 1; // the board on the outside\n    for (const m of [300, 200, 100]) {\n      const b = (k - Math.round(m / tr.ds) + tr.N) % tr.N, a = wallPoint(b, side), tall = 1.3 + m / 300;\n      if (!field.clear(a[0], a[2], -14 + 6)) continue;\n      const tx = tr.tx[b], tz = tr.tz[b];\n      rails.box(a[0], a[1], a[2], 0.16, tall, 0.16, 'slate');\n      rails.box(a[0], a[1] + tall - 0.3, a[2], 1.4, 0.8, 0.12, 'white', Math.atan2(tx, tz));\n      for (let q = 0; q < m / 100; q++) rails.box(a[0] - tz * 0 + (q - (m / 100 - 1) / 2) * 0.38 * tz, a[1] + tall - 0.1, a[2] - (q - (m / 100 - 1) / 2) * 0.38 * tx, 0.22, 0.36, 0.14, 'red', Math.atan2(tx, tz));\n    }\n    void ci;\n  });\n  group.add(road.mesh({ receive: true }), land.mesh({ receive: !night }), rails.mesh({ receive: false }));\n  return { group, field, groundY, theme };\n}\n// The driving line: dashes along the racing line, red where the speed profile says brake.\nexport function buildDrivingLine(tr, line, speeds) {\n  const b = new GeoBatch();\n  for (let i = 0; i < tr.N; i += 2) {\n    if (i % 4 >= 2) continue;\n    const j = (i + 2) % tr.N, braking = speeds[(i + 3) % tr.N] < speeds[i] - 0.12, col = braking ? 'red' : 'lime';\n    const a = P(tr, i, line.off[i] - 0.22, 0.06), c = P(tr, i, line.off[i] + 0.22, 0.06), d = P(tr, j, line.off[j] - 0.22, 0.06), e = P(tr, j, line.off[j] + 0.22, 0.06);\n    b.tri(a, c, d, col); b.tri(c, e, d, col);\n  }\n  const m = b.mesh({ glow: true, receive: false });\n  return m;\n}\nEOF\ncat > src/game/models/cars.js <<'EOF'\n// Fourteen cars as data. Side-profile polygons of [z, y] extruded across the car (`slab`, rot [0, -90, 0]).\n// Tail lamps differ on every car: it is the view you stare at. `node src/check.mjs --sheets src/game/models/cars.js` draws them.\nimport { model } from '../../pixel-engine.js';\n\nexport function carDef(o) {\n  const w = o.width ?? 1.72, g = o.glassWidth ?? w - 0.26, tailZ = o.tailZ ?? -2.1, noseZ = o.noseZ ?? 2.1;\n  const lamps = o.lamps ?? [{ w: 0.42, h: 0.12, x: w / 2 - 0.25, y: 0.72 }];\n  const parts = [\n    { name: 'body', slab: o.body, depth: w, at: [0, 0, 0], rot: [0, -90, 0], c: 'paint' },\n    { name: 'glass', slab: o.cabin, depth: g, at: [0, 0, 0], rot: [0, -90, 0], c: 'glass' },\n    ...(o.roof ? [{ name: 'roof', slab: o.roof, depth: g - 0.08, at: [0, 0, 0], rot: [0, -90, 0], c: 'paint' }] : []),\n    { name: 'sill', box: [w + 0.02, 0.12, (o.length ?? 4.2) - 0.5], at: [0, 0.26, 0], c: 'dark' },\n    { name: 'panel', box: [w - 0.1, 0.05 + (o.panelH ?? 0.16), 0.05], at: [0, o.panelY ?? (lamps[0].y ?? 0.72), tailZ + 0.015], c: 'dark' },\n    ...lamps.flatMap((l) => (l.x === 0 ? [{ box: [l.w, l.h, 0.06], at: [0, l.y, tailZ - 0.01], c: 'lamp', glow: true }] : [{ mirror: [{ box: [l.w, l.h, 0.06], at: [l.x, l.y, tailZ - 0.01], c: 'lamp', glow: true }], axis: 'x' }])),\n    { box: [0.46, 0.12, 0.05], at: [0, o.plateY ?? (lamps[0].y ?? 0.72) - 0.2, tailZ - 0.005], c: 'plate' },\n    { mirror: [{ box: [o.headW ?? 0.34, o.headH ?? 0.1, 0.05], at: [w / 2 - (o.headW ?? 0.34) / 2 - 0.05, o.headY ?? 0.66, noseZ], c: 'head', glow: true }], axis: 'x' },\n    ...(o.exhausts ?? []).map((ex) => ({ cyl: [ex.r ?? 0.1, 0.1, ex.r ?? 0.1], at: [ex.x, ex.y ?? 0.34, tailZ - 0.03], rot: [90, 0, 0], c: 'dark' })),\n    ...(o.extra ?? []),\n  ];\n  return { def: model({ id: o.id, about: o.about, tags: ['vehicle', 'car'], palette: { paint: 'red', glass: 'navy', dark: 'ink', lamp: 'orange', head: 'sand', plate: 'white', trim: 'slate', accent: o.accent ?? 'sand', ...(o.palette ?? {}) }, parts, collider: 'none' }), body: o.body, width: w, length: o.length ?? 4.2, tailZ, noseZ, lamps, wing: o.wing ?? null, rally: !!o.rally, stockWing: !!o.stockWing, headY: o.headY ?? 0.66 };\n}\nconst sillW = (w) => w;\nexport const CAR_MODELS = {\n  // A tall upright box, and two thin lamps standing on end.\n  pico: carDef({ id: 'car-pico', about: 'Upright kei city car, tall and short, vertical lamps', length: 3.2, width: 1.42, tailZ: -1.6, noseZ: 1.56, panelY: 0.56, panelH: 0.08, plateY: 0.5,\n    lamps: [{ w: 0.14, h: 0.34, x: 0.56, y: 0.8 }], headY: 0.72, headW: 0.26, headH: 0.18,\n    body: [[-1.58, 0.28], [1.54, 0.28], [1.6, 0.6], [1.38, 0.86], [0.9, 0.92], [-1.52, 1], [-1.6, 0.74]],\n    cabin: [[-1.48, 0.94], [0.98, 0.9], [0.5, 1.5], [-1.38, 1.54]],\n    roof: [[-1.42, 1.52], [0.54, 1.48], [0.46, 1.56], [-1.36, 1.6]],\n    extra: [{ mirror: [{ box: [0.1, 0.06, 0.05], at: [0.62, 1.0, 0.62], c: 'dark' }], axis: 'x' }] }),\n  // A hot hatch with two square lamps high up, and a roof spoiler.\n  kite: carDef({ id: 'car-kite', about: 'Second-hand hot hatch with a roof spoiler', length: 3.9, width: 1.66, tailZ: -1.92, noseZ: 1.93, panelY: 0.66, panelH: 0.06,\n    lamps: [{ w: 0.2, h: 0.2, x: 0.62, y: 0.86 }], headY: 0.68, exhausts: [{ x: 0.5 }],\n    body: [[-1.92, 0.3], [1.93, 0.3], [1.95, 0.62], [1.55, 0.82], [0.72, 0.92], [-1.82, 0.98], [-1.92, 0.72]],\n    cabin: [[-1.72, 0.92], [0.86, 0.9], [0.18, 1.36], [-1.3, 1.38]],\n    roof: [[-1.42, 1.36], [0.24, 1.34], [0.14, 1.42], [-1.34, 1.44]],\n    extra: [{ box: [1.2, 0.05, 0.3], at: [0, 1.4, -1.46], c: 'dark' }] }),\n  // A rear-drive coupe with a long bonnet: wide flat lamps and a low boot spoiler.\n  ginga: carDef({ id: 'car-ginga', about: 'Rear-drive coupe with a long bonnet', length: 4.4, width: 1.74, tailZ: -2.17, noseZ: 2.18, headY: 0.62,\n    lamps: [{ w: 0.42, h: 0.12, x: 0.6, y: 0.78 }], exhausts: [{ x: 0.55 }],\n    body: [[-2.17, 0.3], [2.18, 0.3], [2.2, 0.54], [1.78, 0.72], [0.5, 0.88], [-1.2, 0.92], [-2.12, 0.95], [-2.17, 0.7]],\n    cabin: [[-1.28, 0.9], [0.62, 0.86], [-0.1, 1.27], [-0.8, 1.28]],\n    roof: [[-0.9, 1.26], [-0.02, 1.25], [-0.14, 1.32], [-0.8, 1.33]],\n    extra: [{ box: [1.5, 0.05, 0.3], at: [0, 1.06, -1.96], c: 'trim' }, { mirror: [{ box: [0.06, 0.12, 0.2], at: [0.6, 1.0, -1.96], c: 'trim' }], axis: 'x' }] }),\n  // A tiny open two-seater: a windscreen, a roll hoop, two small square lamps wide apart.\n  moth: carDef({ id: 'car-moth', about: 'Tiny open two-seater with a windscreen and a roll hoop', length: 3.75, width: 1.58, glassWidth: 1.3, tailZ: -1.87, noseZ: 1.86, headY: 0.58, headW: 0.2, panelY: 0.6, panelH: 0.05, palette: { glass: 'cyan', trim: 'mist' },\n    lamps: [{ w: 0.14, h: 0.14, x: 0.64, y: 0.66 }], exhausts: [{ x: 0.42 }],\n    body: [[-1.87, 0.28], [1.86, 0.28], [1.88, 0.48], [1.4, 0.62], [0.42, 0.76], [-0.5, 0.78], [-1.8, 0.8], [-1.87, 0.6]],\n    cabin: [[0.42, 0.74], [0.36, 0.76], [0.1, 1.16], [0.16, 1.16]],\n    extra: [{ box: [0.56, 0.3, 0.5], at: [-0.32, 0.86, -0.42], c: 'dark' }, { box: [0.06, 0.5, 0.06], at: [-0.55, 1.02, -0.86], c: 'trim' }, { box: [0.06, 0.5, 0.06], at: [0.55, 1.02, -0.86], c: 'trim' }, { box: [1.16, 0.06, 0.06], at: [0, 1.26, -0.86], c: 'trim' }] }),\n  // A rally-bred four-door: round lamps as stacked pairs, a big rear wing on two struts, a bonnet scoop.\n  ryu: carDef({ id: 'car-ryu', about: 'Turbo four-wheel-drive sedan with a tall rear wing', length: 4.35, width: 1.74, tailZ: -2.18, noseZ: 2.15, headY: 0.68,\n    lamps: [{ w: 0.2, h: 0.2, x: 0.66, y: 0.84 }, { w: 0.14, h: 0.14, x: 0.42, y: 0.84 }], exhausts: [{ x: -0.5, r: 0.14 }],\n    body: [[-2.18, 0.3], [2.15, 0.3], [2.17, 0.6], [1.75, 0.76], [0.8, 0.88], [-1.55, 0.94], [-2.15, 0.98], [-2.18, 0.72]],\n    cabin: [[-1.58, 0.92], [0.88, 0.86], [0.2, 1.34], [-1.1, 1.36]],\n    roof: [[-1.18, 1.34], [0.26, 1.32], [0.14, 1.4], [-1.1, 1.42]],\n    extra: [{ box: [0.5, 0.08, 0.34], at: [0, 0.9, 1.2], c: 'dark' }, { box: [1.56, 0.05, 0.28], at: [0, 1.34, -2.0], c: 'paint' }, { mirror: [{ box: [0.06, 0.34, 0.14], at: [0.62, 1.14, -1.98], c: 'dark' }], axis: 'x' }] }),\n  // Long bonnet, short tail: a full-width lamp bar and twin pipes.\n  longhorn: carDef({ id: 'car-longhorn', about: 'Large American fastback with a long bonnet and a lamp bar', length: 4.75, width: 1.82, tailZ: -2.36, noseZ: 2.38, headY: 0.66, headW: 0.26, headH: 0.16, panelH: 0.14, palette: { trim: 'mist' },\n    lamps: [{ w: 1.5, h: 0.12, x: 0, y: 0.76 }], exhausts: [{ x: 0.55, r: 0.12 }, { x: -0.55, r: 0.12 }],\n    body: [[-2.36, 0.32], [2.38, 0.32], [2.4, 0.72], [2.1, 0.8], [0.5, 0.88], [-1.0, 0.94], [-2.3, 0.92], [-2.36, 0.62]],\n    cabin: [[-1.9, 0.92], [0.5, 0.86], [-0.28, 1.26], [-0.86, 1.28]],\n    roof: [[-1.0, 1.26], [-0.2, 1.25], [-0.32, 1.3], [-0.9, 1.32]],\n    extra: [{ box: [0.74, 0.1, 0.9], at: [0, 0.92, 1.3], c: 'dark' }, { box: [1.86, 0.1, 0.08], at: [0, 0.46, -2.4], c: 'trim' }, { box: [1.86, 0.1, 0.08], at: [0, 0.46, 2.42], c: 'trim' }] }),\n  // Three boxes: L-shaped lamps, a chrome line, a neat boot.\n  brandt32: carDef({ id: 'car-brandt32', about: 'Three-box sport sedan with L-shaped lamps', length: 4.45, width: 1.78, tailZ: -2.22, noseZ: 2.2, headY: 0.68, headW: 0.4, palette: { trim: 'mist' },\n    lamps: [{ w: 0.46, h: 0.1, x: 0.62, y: 0.86 }, { w: 0.16, h: 0.2, x: 0.77, y: 0.74 }], exhausts: [{ x: 0.6 }, { x: 0.42 }],\n    body: [[-2.22, 0.3], [2.2, 0.3], [2.22, 0.62], [1.72, 0.82], [0.95, 0.9], [-1.12, 0.94], [-1.28, 1.0], [-2.16, 1.0], [-2.22, 0.74]],\n    cabin: [[-1.32, 0.96], [1.0, 0.88], [0.28, 1.36], [-0.88, 1.38]],\n    roof: [[-0.96, 1.36], [0.34, 1.34], [0.24, 1.42], [-0.9, 1.44]],\n    extra: [{ box: [1.8, 0.04, 2.7], at: [0, 0.8, -0.1], c: 'trim' }] }),\n  // A sloped tail with the engine bump, and a slim strip across: the shape everyone knows is a Heck.\n  heck: carDef({ id: 'car-heck', about: 'Rear-engined sports coupe with a sloped tail and a lamp strip', length: 4.1, width: 1.78, tailZ: -2.05, noseZ: 2.03, headY: 0.74, headW: 0.26, headH: 0.18, panelH: 0.06, plateY: 0.56, panelY: 0.76,\n    lamps: [{ w: 1.46, h: 0.07, x: 0, y: 0.78 }, { w: 0.2, h: 0.12, x: 0.72, y: 0.76 }], exhausts: [{ x: 0.3 }, { x: -0.3 }],\n    body: [[-2.05, 0.3], [2.03, 0.3], [2.04, 0.56], [1.6, 0.78], [0.72, 0.86], [-0.2, 0.92], [-1.3, 0.98], [-1.98, 0.86], [-2.05, 0.62]],\n    cabin: [[-1.46, 0.94], [0.76, 0.84], [0.1, 1.26], [-0.7, 1.28]],\n    roof: [[-0.82, 1.26], [0.16, 1.25], [0.04, 1.32], [-0.74, 1.33]],\n    extra: [{ box: [1.1, 0.05, 0.42], at: [0, 1.02, -1.62], c: 'paint' }, { box: [0.9, 0.05, 0.4], at: [0, 1.0, -1.2], c: 'dark' }] }),\n  // A low wedge: slatted rear panel, four small square lamps in a row.\n  libeccio: carDef({ id: 'car-libeccio', about: 'Mid-engined V8 wedge with a slatted tail', length: 4.3, width: 1.88, tailZ: -2.15, noseZ: 2.14, headY: 0.54, headW: 0.42, headH: 0.07, panelH: 0.22, panelY: 0.7,\n    lamps: [{ w: 0.22, h: 0.14, x: 0.72, y: 0.74 }, { w: 0.22, h: 0.14, x: 0.44, y: 0.74 }], exhausts: [{ x: 0.3 }, { x: -0.3 }, { x: 0.46 }, { x: -0.46 }],\n    body: [[-2.15, 0.3], [2.14, 0.3], [2.16, 0.46], [0.9, 0.72], [0.2, 0.8], [-1.2, 0.9], [-2.1, 0.92], [-2.15, 0.6]],\n    cabin: [[-1.4, 0.88], [0.8, 0.72], [-0.16, 1.14], [-1.0, 1.16]],\n    roof: [[-1.08, 1.14], [-0.1, 1.13], [-0.2, 1.2], [-1.02, 1.21]],\n    extra: [{ box: [1.2, 0.04, 0.5], at: [0, 1.0, -1.62], c: 'dark' }, { mirror: [{ box: [0.08, 0.12, 0.7], at: [0.92, 0.62, -0.6], c: 'dark' }], axis: 'x' }] }),\n  // The Kite, stripped: a roll cage in the glass, a splitter, a low wing, and a number on the door.\n  kiteCup: carDef({ id: 'car-kitecup', about: 'Stripped one-make racing hatch with a cage and a wing', length: 3.95, width: 1.72, tailZ: -1.92, noseZ: 1.98, panelY: 0.66, panelH: 0.06, accent: 'white',\n    lamps: [{ w: 0.2, h: 0.2, x: 0.64, y: 0.86 }, { w: 0.08, h: 0.2, x: 0, y: 1.2 }], headY: 0.66, exhausts: [{ x: 0.5, r: 0.14 }],\n    body: [[-1.92, 0.26], [1.98, 0.26], [1.98, 0.6], [1.55, 0.8], [0.72, 0.9], [-1.82, 0.96], [-1.92, 0.7]],\n    cabin: [[-1.72, 0.9], [0.86, 0.88], [0.18, 1.32], [-1.3, 1.34]],\n    roof: [[-1.42, 1.32], [0.24, 1.3], [0.14, 1.38], [-1.34, 1.4]],\n    extra: [{ box: [1.8, 0.06, 0.2], at: [0, 0.22, 2.0], c: 'dark' }, { box: [1.4, 0.05, 0.26], at: [0, 1.3, -1.94], c: 'dark' }, { mirror: [{ box: [0.06, 0.32, 0.12], at: [0.5, 1.12, -1.86], c: 'dark' }], axis: 'x' }, { mirror: [{ box: [0.04, 0.34, 0.46], at: [0.87, 0.62, 0], c: 'accent' }], axis: 'x' }] }),\n  // Works gravel car: mud flaps, a roof vent, a light bar on the nose.\n  ryuRally: carDef({ id: 'car-ryurally', about: 'Gravel rally sedan with mud flaps, a roof vent and spot lamps', length: 4.35, width: 1.76, tailZ: -2.18, noseZ: 2.15, headY: 0.68, rally: true, accent: 'white',\n    lamps: [{ w: 0.2, h: 0.2, x: 0.66, y: 0.84 }, { w: 0.14, h: 0.14, x: 0.42, y: 0.84 }], exhausts: [{ x: -0.5, r: 0.14 }],\n    body: [[-2.18, 0.36], [2.15, 0.36], [2.17, 0.66], [1.75, 0.82], [0.8, 0.94], [-1.55, 1.0], [-2.15, 1.04], [-2.18, 0.78]],\n    cabin: [[-1.58, 0.98], [0.88, 0.92], [0.2, 1.4], [-1.1, 1.42]],\n    roof: [[-1.18, 1.4], [0.26, 1.38], [0.14, 1.46], [-1.1, 1.48]],\n    extra: [{ box: [0.5, 0.08, 0.34], at: [0, 0.96, 1.2], c: 'dark' }, { box: [1.6, 0.05, 0.3], at: [0, 1.4, -2.02], c: 'paint' }, { mirror: [{ box: [0.06, 0.36, 0.14], at: [0.62, 1.2, -2.0], c: 'dark' }], axis: 'x' }, { box: [0.4, 0.1, 0.3], at: [0, 1.5, -0.4], c: 'dark' }, { mirror: [{ box: [0.36, 0.34, 0.04], at: [0.66, 0.34, -1.92], c: 'dark' }, { box: [0.36, 0.34, 0.04], at: [0.66, 0.34, 1.0], c: 'dark' }], axis: 'x' }, { mirror: [{ box: [0.24, 0.2, 0.06], at: [0.34, 0.92, 2.1], c: 'head', glow: true }], axis: 'x' }, { mirror: [{ box: [0.04, 0.3, 0.6], at: [0.89, 0.72, 0], c: 'accent' }], axis: 'x' }] }),\n  // The Ginga as the factory remembers it: lowered, wide fenders, a tall wing, four round lamps.\n  works: carDef({ id: 'car-works', about: 'Factory GT racer based on the Ginga coupe', length: 4.5, width: 1.96, glassWidth: 1.4, tailZ: -2.25, noseZ: 2.26, headY: 0.54, accent: 'orange',\n    lamps: [{ w: 0.2, h: 0.2, x: 0.76, y: 0.74 }, { w: 0.2, h: 0.2, x: 0.5, y: 0.74 }], exhausts: [{ x: 0.74, r: 0.14 }],\n    body: [[-2.25, 0.24], [2.26, 0.24], [2.3, 0.46], [1.82, 0.64], [0.5, 0.82], [-1.2, 0.86], [-2.2, 0.88], [-2.25, 0.6]],\n    cabin: [[-1.28, 0.84], [0.62, 0.8], [-0.1, 1.2], [-0.8, 1.21]],\n    roof: [[-0.9, 1.19], [-0.02, 1.18], [-0.14, 1.25], [-0.8, 1.26]],\n    extra: [{ box: [1.94, 0.06, 0.42], at: [0, 1.3, -2.1], c: 'dark' }, { mirror: [{ box: [0.08, 0.44, 0.34], at: [0.92, 1.1, -2.1], c: 'dark' }, { box: [0.08, 0.3, 0.16], at: [0.5, 1.02, -2.06], c: 'dark' }], axis: 'x' }, { box: [2.0, 0.05, 0.3], at: [0, 0.2, 2.2], c: 'dark' }, { box: [0.06, 0.04, 2.8], at: [0, 0.9, 0], c: 'accent' }, { mirror: [{ box: [0.04, 0.3, 0.5], at: [0.98, 0.56, -0.4], c: 'accent' }], axis: 'x' }] }),\n  // Homologated: the Libeccio's wedge, longer, wider, on a wing. One long red bar and a central rain lamp.\n  corsa: carDef({ id: 'car-corsa', about: 'Homologation racer based on the Libeccio', length: 4.55, width: 2.0, glassWidth: 1.3, tailZ: -2.28, noseZ: 2.27, headY: 0.48, headW: 0.5, headH: 0.06, panelH: 0.2, panelY: 0.66, accent: 'white',\n    lamps: [{ w: 1.7, h: 0.08, x: 0, y: 0.72 }, { w: 0.14, h: 0.14, x: 0.0, y: 0.48 }], exhausts: [{ x: 0.5, r: 0.14 }, { x: -0.5, r: 0.14 }],\n    body: [[-2.28, 0.24], [2.27, 0.24], [2.3, 0.4], [0.9, 0.68], [0.2, 0.76], [-1.2, 0.86], [-2.24, 0.86], [-2.28, 0.54]],\n    cabin: [[-1.3, 0.84], [0.74, 0.68], [-0.2, 1.08], [-1.0, 1.1]],\n    roof: [[-1.08, 1.08], [-0.14, 1.07], [-0.24, 1.14], [-1.02, 1.15]],\n    extra: [{ box: [2.0, 0.06, 0.46], at: [0, 1.22, -2.24], c: 'accent' }, { mirror: [{ box: [0.08, 0.44, 0.4], at: [0.94, 1.04, -2.22], c: 'dark' }], axis: 'x' }, { box: [2.04, 0.05, 0.3], at: [0, 0.2, 2.22], c: 'dark' }, { box: [0.2, 0.3, 0.9], at: [0, 1.02, -1.2], c: 'paint' }, { box: [0.4, 0.04, 3.8], at: [0, 0.82, 0], c: 'accent' }] }),\n  // A prototype: a narrow cockpit over wide fenders, a fin, a full-width wing, one lamp in each end plate and a bar.\n  type9: carDef({ id: 'car-type9', about: 'Closed-cockpit endurance prototype with a fin and full-width wing', length: 4.6, width: 2.0, glassWidth: 0.92, tailZ: -2.3, noseZ: 2.3, headY: 0.44, headW: 0.4, headH: 0.06, panelH: 0.24, panelY: 0.6, palette: { glass: 'ink' }, accent: 'red',\n    lamps: [{ w: 0.3, h: 0.1, x: 0.82, y: 0.72 }, { w: 0.5, h: 0.04, x: 0, y: 0.84 }], exhausts: [{ x: 0.22, y: 0.6, r: 0.14 }, { x: -0.22, y: 0.6, r: 0.14 }],\n    body: [[-2.3, 0.2], [2.3, 0.2], [2.34, 0.32], [1.2, 0.56], [0.2, 0.62], [-1.4, 0.74], [-2.26, 0.8], [-2.3, 0.5]],\n    cabin: [[-0.9, 0.7], [0.82, 0.56], [-0.04, 1.06], [-0.7, 1.08]],\n    roof: [[-0.78, 1.06], [0, 1.05], [-0.1, 1.12], [-0.7, 1.13]],\n    extra: [{ box: [0.06, 0.5, 1.5], at: [0, 1.08, -1.36], c: 'paint' }, { box: [2.0, 0.05, 0.42], at: [0, 1.16, -2.22], c: 'accent' }, { mirror: [{ box: [0.08, 0.5, 0.56], at: [0.96, 0.96, -2.14], c: 'dark' }, { box: [0.42, 0.14, 2.9], at: [0.8, 0.66, 0], c: 'paint' }], axis: 'x' }, { box: [2.06, 0.05, 0.34], at: [0, 0.16, 2.24], c: 'dark' }, { mirror: [{ box: [0.04, 0.3, 0.6], at: [1.0, 0.5, 0], c: 'accent' }], axis: 'x' }] }),\n};\n// Parts that appear on the model when bought.\nexport const lipSpoiler = model({ id: 'part-lip', about: 'A small lip spoiler', tags: ['vehicle', 'part'], palette: { paint: 'red' }, parts: [{ box: [1.3, 0.06, 0.2], at: [0, 0.03, 0], c: 'paint' }], collider: 'none' });\nexport const bigWing = model({ id: 'part-wing', about: 'A tall rear wing on two struts', tags: ['vehicle', 'part'], palette: { dark: 'ink', paint: 'red' }, parts: [{ box: [1.72, 0.06, 0.34], at: [0, 0.42, 0], c: 'paint' }, { mirror: [{ box: [0.06, 0.4, 0.14], at: [0.52, 0.2, 0], c: 'dark' }, { box: [0.06, 0.18, 0.4], at: [0.87, 0.46, 0], c: 'dark' }], axis: 'x' }], collider: 'none' });\nexport const ALL_CAR_DEFS = Object.fromEntries(Object.entries(CAR_MODELS).map(([k, v]) => [k, v.def]));\nexport const carDefs = Object.values(ALL_CAR_DEFS);\nvoid sillW;\nEOF\ncat > tools/sheets.mjs <<'EOF'\n// A module of only the model defs, for check.mjs --sheets (it expects exports that are defs).\nexport * from '../src/game/models/cars.js';\nEOF\nnode -e \"\nimport('./src/game/models/cars.js').then(async(m)=>{ const {checkModel}=await import('./src/pixel-engine.js'); for