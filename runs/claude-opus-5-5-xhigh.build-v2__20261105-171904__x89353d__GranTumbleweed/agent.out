{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkshTX998h4DitvBeaJr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QDTjDK465rzN88qMiZ5d3o","name":"Bash","input":{"command":"python3 - <<'EOF'\nimport re\ndef rep(p,a,b,cnt=1):\n    s=open(p).read()\n    assert a in s, (p,a[:70])\n    s=s.replace(a,b) if cnt==0 else s.replace(a,b,cnt)\n    open(p,'w').write(s)\nL='src/game/ui/screens/licence.js'\nrep(L,\"const w = Math.min(ui.w - 20, 220), x = ui.w - w - 10;\\n    LICENCE_ORDER\",\"const w = Math.min(ui.w - 20, 256), x = ui.w - w - 10;\\n    LICENCE_ORDER\")\nrep(L,\"if (offer) ui.text(x + 8, my + 44, LINES.arai.offerLine.slice(0, 50), { color: 'lime' });\",\"ui.text(x + 8, my + 44, offer ? 'THE EXAMINER OFFERS THE DRIVING LINE.' : t.tip.slice(0, Math.floor((w - 16) / 6)), { color: offer ? 'lime' : 'mist' });\")\nE='src/game/ui/screens/events.js'\nrep(E,\"{ color: st?.won ? 'lime' : st?.round ? 'sand' : 'slate' });\",\"{ color: st?.won ? 'lime' : st?.round ? 'sand' : 'mist' });\")\nrep(E,\"    ui.button('go', ui.cx - 60, 164, 120, 18, 'TO THE START',\",\"    ui.lines(x + 8, 144, TIPS[(st.round + (app.profile.day ?? 1)) % TIPS.length], { chars: Math.floor((w - 16) / 6), gap: 9, color: 'slate' });\\n    ui.button('go', ui.cx - 60, 166, 120, 18, 'TO THE START',\")\nrep(E,\"import { TRACKS } from '../../data/tracks.js';\",\"import { TRACKS } from '../../data/tracks.js';\\nimport { TIPS } from '../../data/text.js';\")\nT='src/game/ui/screens/tuning.js'\nrep(T,\"personAt: [4.6, 0, 0.8], personYaw: -1.2, radius: 7.8, height: 2.3, sun: 0.7 });\",\"personAt: [3.8, 0, -1.8], personYaw: -0.6, radius: 8.6, height: 2.3, sun: 0.7, lookX: -1.5, angle: 0.25 });\")\nD='src/game/ui/screens/dealer.js'\nrep(D,\"personAt: [-4.6, 0, 1.8], personYaw: 1.1, radius: 7.8, height: 2.5 });\",\"personAt: [-3.6, 0, -2.2], personYaw: 0.7, radius: 8.4, height: 2.5, lookX: -1.1, angle: 0.2 });\")\nG='src/game/ui/screens/garage.js'\nrep(G,\"['CARS', 'TROPHIES', 'STATISTICS']\",\"['CARS', 'TROPHIES', 'STATS']\")\nrep(G,\"radius: 8, height: 2.6, angle: 0.4 });\",\"radius: 8.4, height: 2.6, angle: 0.3, lookX: -1.1 });\")\nS='src/game/ui/screens/service.js'\nrep(S,\"personAt: [4.4, 0, 2.4], personYaw: -1.0, orbit: false, angle: 0.55, radius: 9, height: 2.8, sun: 0.75 });\",\"personAt: [3.4, 0, 2.8], personYaw: -1.0, orbit: false, angle: 0.5, radius: 9.4, height: 3, sun: 0.75, lookX: -1.2 });\")\nTh='src/game/ui/screens/theatre.js'\nrep(Th,\"    const last = app.lastRace;\\n\",\"    const last = app.lastRace; ui.panel(x - 6, 40, w + 12, 116, { color: 'ink', border: 'slate' });\\n\")\n# Sets: the wash is a frame, not a wall.\nSe='src/game/render/sets.js'\nrep(Se,\"for (const q of [-1, 1]) s.b.box(q * 2.4, 0, 0, 0.4, 3.8, 8, 'mist'); s.b.box(0, 3.8, 0, 5.6, 0.3, 8, 'white');\",\"for (const q of [-1, 1]) for (const z of [-4, 4]) s.b.box(q * 2.6, 0, z, 0.3, 3.8, 0.3, 'mist'); s.b.box(0, 3.8, -4, 5.6, 0.3, 0.4, 'white'); s.b.box(0, 3.8, 4, 5.6, 0.3, 0.4, 'white'); for (const q of [-1, 1]) s.b.box(q * 2.6, 3.8, 0, 0.3, 0.3, 8.3, 'white');\")\n# Judge base for multi-leg tests; HUD reads the sum.\nR='src/game/scenes/race.js'\nrep(R,\"    this.judge.step(0);\\n\",\"    this.judge.step(0); this.judge.base = this.opts.legBase ?? 0;\\n\")\nH='src/game/ui/racehud.js'\nrep(H,\"const J = o.test; ui.text(rx, ry, formatTime(J.total), {\",\"const J = o.test; ui.text(rx, ry, formatTime(J.totalWithBase), {\")\nrep(H,\"const passed = J.total > m[name], dim = passed ? 'slate' : col; ui.text(rx, ry, `${name.toUpperCase()} ${formatTime(m[name] / (J.test.legs?.length ?? 1) * (J.test.legs?.length ?? 1))}`,\",\"const passed = J.totalWithBase > m[name], dim = passed ? 'slate' : col; ui.text(rx, ry, `${name.toUpperCase()} ${formatTime(m[name])}`,\")\nrep(H,\"      if (o.ghostGap !== undefined && o.ghostGap !== null) { ui.text(rx, ry, `GHOST ${o.ghostGap >= 0 ? '+' : ''}${o.ghostGap.toFixed(2)}`, { align: 'right', color: o.ghostGap <= 0 ? 'lime' : 'orange' }); ry += 10; }\\n\",\"\")\nrep(R,\"    if (this.traceLap && this.ghost) { hudOpts.ghostGap = null; }\\n    void d;\\n\",\"    void d;\\n\")\n# Time trial banner\nrep(R,\"    if (this.tr?.pit) void 0;\\n\",\"    if (this.data.kind === 'timetrial') ui.text(ui.cx, 22, this.ghost ? 'PASS THE PAD: BEAT THE GHOST. THE BEST TIME STANDS.' : 'SET A LAP. IT BECOMES THE GHOST.', { align: 'center', color: 'sand' });\\n\")\n# P2 can change camera in a duel.\nrep(R,\"if (d.cam && e.player === this.viewPlayer) { this.chase.cycle(); app.options.camMode = this.chase.mode; app.mix.sfx('tick'); }\",\"if (d.cam) { if (e.player === this.viewPlayer) { this.chase.cycle(); app.options.camMode = this.chase.mode; } else app.couchScene?.chase?.cycle(); app.mix.sfx('tick'); }\")\n# Taillight trails at night.\nrep(R,\"    // Ghosts in time trial.\\n\",\"\"\"    // Taillight trails at night.\n    if (this.night > 0.4) { this.trails = sim.cars.map(() => { const q = new Trail({ width: 0.34, life: 0.45, color: 0xff3020, tail: 0x5d275d, points: 18, minStep: 0.6 }); ctx.scene.add(q); return q; }); }\n    // Ghosts in time trial.\n\"\"\")\nrep(R,\"    // Light rig follows the player's car.\\n\",\"\"\"    if (this.trails) { const t = ctx.time; sim.cars.forEach((e, k) => { const c = e.c, q = this.trails[k]; if (Math.hypot(c.vx, c.vz) > 6) { P.set(c.x - Math.sin(c.yaw) * (c.p.b + 0.7), c.y + 0.7, c.z - Math.cos(c.yaw) * (c.p.b + 0.7)); q.push(P, t); } q.update(t, this.cam); }); }\n    // Light rig follows the player's car.\n\"\"\")\nrep(R,\"import { PALETTE, setLookLayer, THREE, toonMaterial } from '../../pixel-engine.js';\",\"import { PALETTE, setLookLayer, THREE, toonMaterial, Trail } from '../../pixel-engine.js';\")\nrep(R,\"const { ConeGeometry, Group, Mesh, Vector3 } = THREE;\",\"const { ConeGeometry, Group, Mesh, Vector3 } = THREE;\\nconst P = new Vector3();\")\n# Museum: cars seen in a race are met.\nF='src/game/flows.js'\nrep(F,\"    app.lastRace = sim.rec; const rows = sim.results();\\n\",\"    app.lastRace = sim.rec; const rows = sim.results(); for (const e of sim.cars) app.profile.seen[e.carId] = true;\\n\")\n# Sound unlock notice on Settings.\nSt='src/game/ui/screens/settings.js'\nrep(St,\"    y = ui.h - 42; const half = (w - 6) / 2;\\n\",\"    if (!app.mix.audio?.unlocked) { ui.sprite(x, ui.h - 56, ['..x....', '.xx..x.', 'xxx.x.x', 'xxx..x.', 'xxx.x.x', '.xx....', '..x....'], { x: 'red' }); ui.text(x + 10, ui.h - 56, 'PRESS A KEY OR CLICK FOR SOUND', { color: 'mist' }); }\\n    y = ui.h - 42; const half = (w - 6) / 2;\\n\")\n# ?scene=replay: simulate a short race, then watch it.\nM='src/main.js'\nrep(M,\"  if (scene === 'replay') { const s = new RaceScene(app, quickSetup({ track: param('track') ?? 'kestrel', carId: param('car') ?? 'ginga', laps: 1, field: 4, assists: app.options.assists, seed }), {}); void s; void ReplayScene; app.ui.note('RACE A LAP, THEN WATCH IT IN THE THEATRE.'); }\\n\",\"  if (scene === 'replay') { const s = new RaceSim({ ...quickSetup({ track: param('track') ?? 'kestrel', carId: param('car') ?? 'ginga', laps: 1, field: 5, assists: app.options.assists, seed }) }); s.cars.at(-1).player = null; s.players = []; for (let i = 0; i < 60 * 45; i++) s.step([]); app.lastRace = s.rec; app.go(() => new ReplayScene(app, s.rec, { after: () => app.toTitle() })); }\\n\")\nrep(M,\"import { quickSetup } from './game/sim/setups.js';\",\"import { quickSetup } from './game/sim/setups.js';\\nimport { RaceSim } from './game/sim/race.js';\")\nEOF\ncat > docs/adding-content.md <<'EOF'\n# Adding content to Gran Tumbleweed\n\nAll content is data in `src/game/data/`. `node tools/test.mjs data` checks that every id resolves, every event has a car that can enter it, every test has medals, and all text fits a 60-character line and a 4-line card. Models go through `node src/check.mjs --sheets tools/sheets.mjs`.\n\n## A car\n1. Physics row in `data/carphysics.js`: mass, power, rpm, gears, tyres, aero.\n2. Catalogue row in `data/cars.js` (`CAR_INFO`): name, marque, year, price, `where` (`used`, `dealer`, `prize`), sound (`cyl`, `filter`, `exhaust`), Mr. Fenn's line, four lines of brochure. Add it to a showroom in `SHOWROOMS`.\n3. Model in `models/cars.js` (`CAR_MODELS`): `carDef({ id, about, length, width, body, cabin, roof, lamps, extra })`. Make the tail distinct: it is the view you stare at.\n\n## A track\n1. `data/tracks.js`: a closed list of corners, `[x, z, radius, y, width, bankDeg]`, with `surface`, `edge`, `runoff`, `hour`, and optionally `pit` and `crests`.\n2. A colour theme in `render/trackmesh.js` (`THEMES`).\n3. A dressing function in `render/dressing.js` (`DRESS`): grandstands, landmarks, things that move.\n\n## A licence test\n`data/licences.js`: `{ title, lesson, carId, track, start, startSpeed, kind, end or box or cones, assists, brief, tip }`. `kind` is `section`, `stop`, `cones` or `lap`; `legs` drives it in several cars. Then run `node tools/medals.mjs`: it runs the AI demonstration at 97% pace and freezes the medal times in `data/medals.js`.\n\n## An event\n`data/events.js`: `{ name, needs, limit, restriction, pace, pool, prize, bonus, prizeCar, field, wear, rounds, intro }`. A round is `{ track, laps, hour, rain, hourEnd }`. `grid` lists the field by hand when `pool` and `pace` aren't enough; `rivals` does the same for a rally. Pit stops open at ten laps or more. `node tools/tests/play.mjs` plays the career through; `PLAY_VERBOSE=1` prints each result.\n\n## A part\n`data/parts.js`: `{ cat, group, name, price, line }`. `group` makes parts exclusive. Its numbers live in `sim/tuning.js`, `tunedRow`. A setting goes in `SETUP_SLIDERS` with the parts that open it.\n\n## A song\n`data/songs.js`: `{ bpm, tracks, patterns, order }` with `square`, `triangle`, `saw`, `sine` and `noise` only. Every track in a pattern needs the same step count. Play it with `app.mix.music('id')`.\n\n## A line of writing\n`data/text.js`. Sincere, exact, formally polite, funny only by being deadpan. Uppercase: the HUD font has no other case. Nobody calls the player a champion.\nEOF\nnode tools/build.mjs 2>&1 | cut -c1-60 | tail -2\npython3 - <<'EOF'\np='tools/scratch/gallery.py'; s=open(p).read()\na=\"names=sys.argv[1:] or list(SHOTS)\"\nb='''SHOTS.update({\n 'results': JS_RACE('kestrel','ginga',\"a.scene.sim.finishNow(a.scene.sim.cars.length-1,2); e.step(240)\",240,5),\n 'pit': \"\"\"(async()=>{const a=window.__APP__; a.ui.clear(); await a.startQuick({track:'harbour',carId:'works',laps:10,field:4,difficulty:'normal',hour:21}); const e=window.__PIXEL_ENGINE__, s=a.scene.sim, me=s.cars[s.cars.length-1]; e.step(20); s.teleport(me.i, s.tr.pit.in-40); me.c.vx=Math.sin(me.c.yaw)*20; me.c.vz=Math.cos(me.c.yaw)*20; me.c.wear.fill(0.3); me.c.fuel=0.3; s.enterPit(me); e.step(420); a.scene.chase.mode=1; e.manual=false; })()\"\"\",\n 'podium': \"\"\"(async()=>{const a=window.__APP__; a.ui.clear(); a.profile=a.career.newProfile(); a.career.addCar(a.profile,'corsa'); await a.ceremony('gp',{seriesDone:true,seriesWon:true,prizeCar:'type9',ending:true}); const e=window.__PIXEL_ENGINE__; await new Promise(r=>setTimeout(r,1500)); e.step(100); e.manual=false; })()\"\"\",\n 'prize': \"\"\"(async()=>{const a=window.__APP__; const e=window.__PIXEL_ENGINE__; a.ui.top?.tl?.skip(); await new Promise(r=>setTimeout(r,800)); e.step(280); e.manual=false; })()\"\"\",\n 'ending': \"\"\"(async()=>{const a=window.__APP__; const e=window.__PIXEL_ENGINE__; a.ui.top?.tl?.skip(); await new Promise(r=>setTimeout(r,800)); if(a.ui.top) a.ui.top.t=999; e.manual=false; })()\"\"\",\n 'couch': \"\"\"(async()=>{const a=window.__APP__; a.ui.clear(); await a.startCouch({track:'cedar',carA:'ginga',carB:'kite',laps:2,ai:2}); await new Promise(r=>setTimeout(r,3500)); const e=window.__PIXEL_ENGINE__; e.step(60); e.manual=false; })()\"\"\",\n 'pause': \"\"\"(async()=>{const a=window.__APP__; await a.startQuick({track:'kestrel',carId:'moth',laps:2,field:3,difficulty:'normal'}); const e=window.__PIXEL_ENGINE__; e.step(30); e.manual=false; a.openPause(a.scene); })()\"\"\",\n 'dev': \"\"\"(async()=>{const a=window.__APP__; a.openDev(a.scene); const d=window.__APP__.dev; d.overlays.telemetry=true; d.overlays.load=true; })()\"\"\",\n 'settings': \"\"\"(async()=>{const a=window.__APP__; await a.toTitle(); await new Promise(r=>setTimeout(r,400)); a.ui.top.focus='settings'; window.__GAME__.press('confirm'); })()\"\"\",\n 'handbook': \"\"\"(async()=>{const a=window.__APP__; await a.jumpMenu('map'); await new Promise(r=>setTimeout(r,300)); window.__GAME__.press('pause'); await new Promise(r=>setTimeout(r,300)); a.ui.top.focus='handbook'; window.__GAME__.press('confirm'); })()\"\"\",\n 'about': \"\"\"(async()=>{const a=window.__APP__; await a.toTitle(); await new Promise(r=>setTimeout(r,400)); a.ui.top.focus='about'; window.__GAME__.press('confirm'); })()\"\"\",\n})\nnames=sys.argv[1:] or list(SHOTS)'''\nassert a in s; s=s.replace(a,b,1); open(p,'w').write(s)\nEOF\ntimeout 280 python3 tools/scratch/gallery.py results pit podium prize ending couch pause dev settings 2>&1 | tail -11 | cut -c1-200; cd shots && magick montage results.png pit.png podium.png prize.png ending.png couch.png pause.png dev.png settings.png -tile 3x3 -geometry 640x360+2+2 sheet4.png 2>/dev/null; cd ..","description":"Apply polish batch, add designer docs, render ceremony and overlay screens","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2862,"cache_read_input_tokens":701362,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2862},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"bbad6270-0785-40b8-8c6a-2b1bd9da595a","timestamp":"2026-11-06T02:21:45.141Z","request_id":"req_011CgkshTBnwLFzvTSGxb1bc","wire_tool_inputs":{"toolu_01QDTjDK465rzN88qMiZ5d3o":{"command":"python3 - <<'EOF'\nimport re\ndef rep(p,a,b,cnt=1):\n    s=open(p).read()\n    assert a in s, (p,a[:70])\n    s=s.replace(a,b) if cnt==0 else s.replace(a,b,cnt)\n    open(p,'w').write(s)\nL='src/game/ui/screens/licence.js'\nrep(L,\"const w = Math.min(ui.w - 20, 220), x = ui.w - w - 10;\\n    LICENCE_ORDER\",\"const w = Math.min(ui.w - 20, 256), x = ui.w - w - 10;\\n    LICENCE_ORDER\")\nrep(L,\"if (offer) ui.text(x + 8, my + 44, LINES.arai.offerLine.slice(0, 50), { color: 'lime' });\",\"ui.text(x + 8, my + 44, offer ? 'THE EXAMINER OFFERS THE DRIVING LINE.' : t.tip.slice(0, Math.floor((w - 16) / 6)), { color: offer ? 'lime' : 'mist' });\")\nE='src/game/ui/screens/events.js'\nrep(E,\"{ color: st?.won ? 'lime' : st?.round ? 'sand' : 'slate' });\",\"{ color: st?.won ? 'lime' : st?.round ? 'sand' : 'mist' });\")\nrep(E,\"    ui.button('go', ui.cx - 60, 164, 120, 18, 'TO THE START',\",\"    ui.lines(x + 8, 144, TIPS[(st.round + (app.profile.day ?? 1)) % TIPS.length], { chars: Math.floor((w - 16) / 6), gap: 9, color: 'slate' });\\n    ui.button('go', ui.cx - 60, 166, 120, 18, 'TO THE START',\")\nrep(E,\"import { TRACKS } from '../../data/tracks.js';\",\"import { TRACKS } from '../../data/tracks.js';\\nimport { TIPS } from '../../data/text.js';\")\nT='src/game/ui/screens/tuning.js'\nrep(T,\"personAt: [4.6, 0, 0.8], personYaw: -1.2, radius: 7.8, height: 2.3, sun: 0.7 });\",\"personAt: [3.8, 0, -1.8], personYaw: -0.6, radius: 8.6, height: 2.3, sun: 0.7, lookX: -1.5, angle: 0.25 });\")\nD='src/game/ui/screens/dealer.js'\nrep(D,\"personAt: [-4.6, 0, 1.8], personYaw: 1.1, radius: 7.8, height: 2.5 });\",\"personAt: [-3.6, 0, -2.2], personYaw: 0.7, radius: 8.4, height: 2.5, lookX: -1.1, angle: 0.2 });\")\nG='src/game/ui/screens/garage.js'\nrep(G,\"['CARS', 'TROPHIES', 'STATISTICS']\",\"['CARS', 'TROPHIES', 'STATS']\")\nrep(G,\"radius: 8, height: 2.6, angle: 0.4 });\",\"radius: 8.4, height: 2.6, angle: 0.3, lookX: -1.1 });\")\nS='src/game/ui/screens/service.js'\nrep(S,\"personAt: [4.4, 0, 2.4], personYaw: -1.0, orbit: false, angle: 0.55, radius: 9, height: 2.8, sun: 0.75 });\",\"personAt: [3.4, 0, 2.8], personYaw: -1.0, orbit: false, angle: 0.5, radius: 9.4, height: 3, sun: 0.75, lookX: -1.2 });\")\nTh='src/game/ui/screens/theatre.js'\nrep(Th,\"    const last = app.lastRace;\\n\",\"    const last = app.lastRace; ui.panel(x - 6, 40, w + 12, 116, { color: 'ink', border: 'slate' });\\n\")\n# Sets: the wash is a frame, not a wall.\nSe='src/game/render/sets.js'\nrep(Se,\"for (const q of [-1, 1]) s.b.box(q * 2.4, 0, 0, 0.4, 3.8, 8, 'mist'); s.b.box(0, 3.8, 0, 5.6, 0.3, 8, 'white');\",\"for (const q of [-1, 1]) for (const z of [-4, 4]) s.b.box(q * 2.6, 0, z, 0.3, 3.8, 0.3, 'mist'); s.b.box(0, 3.8, -4, 5.6, 0.3, 0.4, 'white'); s.b.box(0, 3.8, 4, 5.6, 0.3, 0.4, 'white'); for (const q of [-1, 1]) s.b.box(q * 2.6, 3.8, 0, 0.3, 0.3, 8.3, 'white');\")\n# Judge base for multi-leg tests; HUD reads the sum.\nR='src/game/scenes/race.js'\nrep(R,\"    this.judge.step(0);\\n\",\"    this.judge.step(0); this.judge.base = this.opts.legBase ?? 0;\\n\")\nH='src/game/ui/racehud.js'\nrep(H,\"const J = o.test; ui.text(rx, ry, formatTime(J.total), {\",\"const J = o.test; ui.text(rx, ry, formatTime(J.totalWithBase), {\")\nrep(H,\"const passed = J.total > m[name], dim = passed ? 'slate' : col; ui.text(rx, ry, `${name.toUpperCase()} ${formatTime(m[name] / (J.test.legs?.length ?? 1) * (J.test.legs?.length ?? 1))}`,\",\"const passed = J.totalWithBase > m[name], dim = passed ? 'slate' : col; ui.text(rx, ry, `${name.toUpperCase()} ${formatTime(m[name])}`,\")\nrep(H,\"      if (o.ghostGap !== undefined && o.ghostGap !== null) { ui.text(rx, ry, `GHOST ${o.ghostGap >= 0 ? '+' : ''}${o.ghostGap.toFixed(2)}`, { align: 'right', color: o.ghostGap <= 0 ? 'lime' : 'orange' }); ry += 10; }\\n\",\"\")\nrep(R,\"    if (this.traceLap && this.ghost) { hudOpts.ghostGap = null; }\\n    void d;\\n\",\"    void d;\\n\")\n# Time trial banner\nrep(R,\"    if (this.tr?.pit) void 0;\\n\",\"    if (this.data.kind === 'timetrial') ui.text(ui.cx, 22, this.ghost ? 'PASS THE PAD: BEAT THE GHOST. THE BEST TIME STANDS.' : 'SET A LAP. IT BECOMES THE GHOST.', { align: 'center', color: 'sand' });\\n\")\n# P2 can change camera in a duel.\nrep(R,\"if (d.cam && e.player === this.viewPlayer) { this.chase.cycle(); app.options.camMode = this.chase.mode; app.mix.sfx('tick'); }\",\"if (d.cam) { if (e.player === this.viewPlayer) { this.chase.cycle(); app.options.camMode = this.chase.mode; } else app.couchScene?.chase?.cycle(); app.mix.sfx('tick'); }\")\n# Taillight trails at night.\nrep(R,\"    // Ghosts in time trial.\\n\",\"\"\"    // Taillight trails at night.\n    if (this.night > 0.4) { this.trails = sim.cars.map(() => { const q = new Trail({ width: 0.34, life: 0.45, color: 0xff3020, tail: 0x5d275d, points: 18, minStep: 0.6 }); ctx.scene.add(q); return q; }); }\n    // Ghosts in time trial.\n\"\"\")\nrep(R,\"    // Light rig follows the player's car.\\n\",\"\"\"    if (this.trails) { const t = ctx.time; sim.cars.forEach((e, k) => { const c = e.c, q = this.trails[k]; if (Math.hypot(c.vx, c.vz) > 6) { P.set(c.x - Math.sin(c.yaw) * (c.p.b + 0.7), c.y + 0.7, c.z - Math.cos(c.yaw) * (c.p.b + 0.7)); q.push(P, t); } q.update(t, this.cam); }); }\n    // Light rig follows the player's car.\n\"\"\")\nrep(R,\"import { PALETTE, setLookLayer, THREE, toonMaterial } from '../../pixel-engine.js';\",\"import { PALETTE, setLookLayer, THREE, toonMaterial, Trail } from '../../pixel-engine.js';\")\nrep(R,\"const { ConeGeometry, Group, Mesh, Vector3 } = THREE;\",\"const { ConeGeometry, Group, Mesh, Vector3 } = THREE;\\nconst P = new Vector3();\")\n# Museum: cars seen in a race are met.\nF='src/game/flows.js'\nrep(F,\"    app.lastRace = sim.rec; const rows = sim.results();\\n\",\"    app.lastRace = sim.rec; const rows = sim.results(); for (const e of sim.cars) app.profile.seen[e.carId] = true;\\n\")\n# Sound unlock notice on Settings.\nSt='src/game/ui/screens/settings.js'\nrep(St,\"    y = ui.h - 42; const half = (w - 6) / 2;\\n\",\"    if (!app.mix.audio?.unlocked) { ui.sprite(x, ui.h - 56, ['..x....', '.xx..x.', 'xxx.x.x', 'xxx..x.', 'xxx.x.x', '.xx....', '..x....'], { x: 'red' }); ui.text(x + 10, ui.h - 56, 'PRESS A KEY OR CLICK FOR SOUND', { color: 'mist' }); }\\n    y = ui.h - 42; const half = (w - 6) / 2;\\n\")\n# ?scene=replay: simulate a short race, then watch it.\nM='src/main.js'\nrep(M,\"  if (scene === 'replay') { const s = new RaceScene(app, quickSetup({ track: param('track') ?? 'kestrel', carId: param('car') ?? 'ginga', laps: 1, field: 4, assists: app.options.assists, seed }), {}); void s; void ReplayScene; app.ui.note('RACE A LAP, THEN WATCH IT IN THE THEATRE.'); }\\n\",\"  if (scene === 'replay') { const s = new RaceSim({ ...quickSetup({ track: param('track') ?? 'kestrel', carId: param('car') ?? 'ginga', laps: 1, field: 5, assists: app.options.assists, seed }) }); s.cars.at(-1).player = null; s.players = []; for (let i = 0; i < 60 * 45; i++) s.step([]); app.lastRace = s.rec; app.go(() => new ReplayScene(app, s.rec, { after: () => app.toTitle() })); }\\n\")\nrep(M,\"import { quickSetup } from './game/sim/setups.js';\",\"import { quickSetup } from './game/sim/setups.js';\\nimport { RaceSim } from './game/sim/race.js';\")\nEOF\ncat > docs/adding-content.md <<'EOF'\n# Adding content to Gran Tumbleweed\n\nAll content is data in `src/game/data/`. `node tools/test.mjs data` checks that every id resolves, every event has a car that can enter it, every test has medals, and all text fits a 60-character line and a 4-line card. Models go through `node src/check.mjs --sheets tools/sheets.mjs`.\n\n## A car\n1. Physics row in `data/carphysics.js`: mass, power, rpm, gears, tyres, aero.\n2. Catalogue row in `data/cars.js` (`CAR_INFO`): name, marque, year, price, `where` (`used`, `dealer`, `prize`), sound (`cyl`, `filter`, `exhaust`), Mr. Fenn's line, four lines of brochure. Add it to a showroom in `SHOWROOMS`.\n3. Model in `models/cars.js` (`CAR_MODELS`): `carDef({ id, about, length, width, body, cabin, roof, lamps, extra })`. Make the tail distinct: it is the view you stare at.\n\n## A track\n1. `data/tracks.js`: a closed list of corners, `[x, z, radius, y, width, bankDeg]`, with `surface`, `edge`, `runoff`, `hour`, and optionally `pit` and `crests`.\n2. A colour theme in `render/trackmesh.js` (`THEMES`).\n3. A dressing function in `render/dressing.js` (`DRESS`): grandstands, landmarks, things that move.\n\n## A licence test\n`data/licences.js`: `{ title, lesson, carId, track, start, startSpeed, kind, end or box or cones, assists, brief, tip }`. `kind` is `section`, `stop`, `cones` or `lap`; `legs` drives it in several cars. Then run `node tools/medals.mjs`: it runs the AI demonstration at 97% pace and freezes the medal times in `data/medals.js`.\n\n## An event\n`data/events.js`: `{ name, needs, limit, restriction, pace, pool, prize, bonus, prizeCar, field, wear, rounds, intro }`. A round is `{ track, laps, hour, rain, hourEnd }`. `grid` lists the field by hand when `pool` and `pace` aren't enough; `rivals` does the same for a rally. Pit stops open at ten laps or more. `node tools/tests/play.mjs` plays the career through; `PLAY_VERBOSE=1` prints each result.\n\n## A part\n`data/parts.js`: `{ cat, group, name, price, line }`. `group` makes parts exclusive. Its numbers live in `sim/tuning.js`, `tunedRow`. A setting goes in `SETUP_SLIDERS` with the parts that open it.\n\n## A song\n`data/songs.js`: `{ bpm, tracks, patterns, order }` with `square`, `triangle`, `saw`, `sine` and `noise` only. Every track in a pattern needs the same step count. Play it with `app.mix.music('id')`.\n\n## A line of writing\n`data/text.js`. Sincere, exact, formally polite, funny only by being deadpan. Uppercase: the HUD font has no other case. Nobody calls the player a champion.\nEOF\nnode tools/build.mjs 2>&1 | cut -c1-60 | tail -2\npython3 - <<'EOF'\np='tools/scratch/gallery.py'; s=open(p).read()\na=\"names=sys.argv[1:] or list(SHOTS)\"\nb='''SHOTS.update({\n 'results': JS_RACE('kestrel','ginga',\"a.scene.sim.finishNow(a.scene.sim.cars.length-1,2); e.step(240)\",240,5),\n 'pit': \"\"\"(async()=>{const a=window.__APP__; a.ui.clear(); await a.startQuick({track:'harbour',carId:'works',laps:10,field:4,difficulty:'normal',hour:21}); const e=window.__PIXEL_ENGINE__, s=a.scene.sim, me=s.cars[s.cars.length-1]; e.step(20); s.teleport(me.i, s.tr.pit.in-40); me.c.vx=Math.sin(me.c.yaw)*20; me.c.vz=Math.cos(me.c.yaw)*20; me.c.wear.fill(0.3); me.c.fuel=0.3; s.enterPit(me); e.step(420); a.scene.chase.mode=1; e.manual=false; })()\"\"\",\n 'podium': \"\"\"(async()=>{const a=window.__APP__; a.ui.clear(); a.profile=a.career.newProfile(); a.career.addCar(a.profile,'corsa'); await a.ceremony('gp',{seriesDone:true,seriesWon:true,prizeCar:'type9',ending:true}); const e=window.__PIXEL_ENGINE__; await new Promise(r=>setTimeout(r,1500)); e.step(100); e.manual=false; })()\"\"\",\n 'prize': \"\"\"(async()=>{const a=window.__APP__; const e=window.__PIXEL_ENGINE__; a.ui.top?.tl?.skip(); await new Promise(r=>setTimeout(r,800)); e.step(280); e.manual=false; })()\"\"\",\n 'ending': \"\"\"(async()=>{const a=window.__APP__; const e=window.__PIXEL_ENGINE__; a.ui.top?.tl?.skip(); await new Promise(r=>setTimeout(r,800)); if(a.ui.top) a.ui.top.t=999; e.manual=false; })()\"\"\",\n 'couch': \"\"\"(async()=>{const a=window.__APP__; a.ui.clear(); await a.startCouch({track:'cedar',carA:'ginga',carB:'kite',laps:2,ai:2}); await new Promise(r=>setTimeout(r,3500)); const e=window.__PIXEL_ENGINE__; e.step(60); e.manual=false; })()\"\"\",\n 'pause': \"\"\"(async()=>{const a=window.__APP__; await a.startQuick({track:'kestrel',carId:'moth',laps:2,field:3,difficulty:'normal'}); const e=window.__PIXEL_ENGINE__; e.step(30); e.manual=false; a.openPause(a.scene); })()\"\"\",\n 'dev': \"\"\"(async()=>{const a=window.__APP__; a.openDev(a.scene); const d=window.__APP__.dev; d.overlays.telemetry=true; d.overlays.load=true; })()\"\"\",\n 'settings': \"\"\"(async()=>{const a=window.__APP__; await a.toTitle(); await new Promise(r=>setTimeout(r,400)); a.ui.top.focus='settings'; window.__GAME__.press('confirm'); })()\"\"\",\n 'handbook': \"\"\"(async()=>{const a=window.__APP__; await a.jumpMenu('map'); await new Promise(r=>setTimeout(r,300)); window.__GAME__.press('pause'); await new Promise(r=>setTimeout(r,300)); a.ui.top.focus='handbook'; window.__GAME__.press('confirm'); })()\"\"\",\n 'about': \"\"\"(async()=>{const a=window.__APP__; await a.toTitle(); await new Promise(r=>setTimeout(r,400)); a.ui.top.focus='about'; window.__GAME__.press('confirm'); })()\"\"\",\n})\nnames=sys.argv[1:] or list(SHOTS)'''\nassert a in s; s=s.replace(a,b,1); open(p,'w').write(s)\nEOF\ntimeout 280 python3 tools/scratch/gallery.py results pit podium prize ending couch pause dev settings 2>&1 | tail -11 | cut -c1-200; cd shots && magick montage results.png pit.png podium.png prize.png ending.png couch.png pause.png dev.png settings.png -tile 3x3 -geometry 640x360+2+2 sheet4.png 2>/dev/null; cd ..","description":"Apply polish batch, add designer docs, render ceremony and overlay screens","timeout":300000}}}
