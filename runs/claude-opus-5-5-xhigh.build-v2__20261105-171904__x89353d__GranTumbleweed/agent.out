{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmqGqDMwfCoMXyKDdx4","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28878,"cache_read_input_tokens":458648,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28878},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"d8fb6430-7d28-437a-bfe4-15b14c5c98cd","timestamp":"2026-11-06T01:04:07.898Z","request_id":"req_011CgkmqGWsn1op9fd6CV35y","thinking_duration_ms":45700,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkmqGqDMwfCoMXyKDdx4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0144PkBfoaZFyBT3ErwzJn3V","name":"Bash","input":{"command":"cat > src/game/ui/screens/pause.js <<'EOF'\n// Pause (Options or Esc): Resume, Restart, Retire, Assists, Settings, Handbook, Dev Mode. The race is simply not stepped.\nimport { SettingsScreen } from './settings.js';\nimport { HandbookScreen } from './handbook.js';\nimport { AboutScreen } from './about.js';\nimport { Dialog } from './common.js';\nexport class PauseScreen {\n  constructor(app, scene) { this.id = 'pause'; this.app = app; this.scene = scene; }\n  enter() { this.scene.paused = true; this.app.mix.quiet(); this.app.mix.sfx('tick'); }\n  exit() { this.scene.paused = false; }\n  list() { const a = this.app, s = this.scene; return [['resume', 'RESUME', () => this.app.ui.pop()], ['restart', 'RESTART', () => a.restartRun(s)], ['retire', s.judge ? 'END ATTEMPT' : 'RETIRE', () => this.askRetire()], ['assists', 'ASSISTS', () => a.ui.push(new AssistsScreen(a, s))], ['settings', 'SETTINGS', () => a.ui.push(new SettingsScreen(a, { inRace: true }))], ['handbook', 'HANDBOOK', () => a.ui.push(new HandbookScreen(a))], ...(a.session ? [] : [['dev', 'DEV MODE', () => a.openDev(s)]])]; }\n  askRetire() { const a = this.app, s = this.scene, ui = a.ui, d = new Dialog(a, s.judge ? 'END THIS ATTEMPT?' : 'RETIRE FROM THE RACE?', [s.data.event ? 'YOU WILL BE PLACED LAST IN THIS ROUND.' : 'THE RESULT WILL NOT COUNT.'], [['no', 'KEEP DRIVING', () => ui.pop()], ['yes', 'RETIRE', () => { ui.clear(); a.retireRun(s); }]]); d.focus = 'no'; d.under = this; ui.push(d); }\n  draw(ui) {\n    const list = this.list(), w = 130, h = 15, gap = 3, H = list.length * (h + gap), x = Math.round(ui.cx - w / 2), y = Math.round(ui.h / 2 - H / 2) + 4;\n    ui.panel(x - 12, y - 24, w + 24, H + 32, { color: 'ink', border: 'slate' });\n    ui.text(ui.cx, y - 19, 'PAUSED', { align: 'center', scale: 2, color: 'sand' });\n    list.forEach(([id, label, fn], k) => ui.button(id, x, y + k * (h + gap), w, h, label, { confirm: fn }));\n    if (this.app.actions.pressed('pause') && ui.locked <= 0 && ui.top === this && !this.app.actions.pressed('back')) ui.pop();\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'RESUME']]);\n  }\n}\nexport class MapPause {\n  constructor(app) { this.id = 'mapPause'; this.app = app; }\n  draw(ui) {\n    const a = this.app, list = [['resume', 'BACK TO THE MAP', () => ui.pop()], ['settings', 'SETTINGS', () => ui.push(new SettingsScreen(a))], ['handbook', 'HANDBOOK', () => ui.push(new HandbookScreen(a))], ['about', 'ABOUT', () => ui.push(new AboutScreen(a))], ['dev', 'DEV MODE', () => a.openDev(null)], ['title', 'TITLE SCREEN', () => a.toTitle()]], w = 130, h = 15, gap = 3, H = list.length * (h + gap), x = Math.round(ui.cx - w / 2), y = Math.round(ui.h / 2 - H / 2) + 4;\n    ui.panel(x - 12, y - 24, w + 24, H + 32, { color: 'ink', border: 'slate' });\n    ui.text(ui.cx, y - 19, 'MENU', { align: 'center', scale: 2, color: 'sand' });\n    list.forEach(([id, label, fn], k) => ui.button(id, x, y + k * (h + gap), w, h, label, { confirm: fn }));\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\nexport class AssistsScreen {\n  constructor(app, scene) { this.id = 'assists'; this.app = app; this.scene = scene; }\n  draw(ui) {\n    const a = this.app, A = a.options.assists, w = Math.min(ui.w - 40, 280), x = Math.round(ui.cx - w / 2), h = 16; let y = 44;\n    ui.panel(x - 8, 14, w + 16, 150, { color: 'ink', border: 'slate' }); ui.text(ui.cx, 20, 'ASSISTS', { align: 'center', scale: 2, color: 'sand' });\n    const apply = () => { a.saveOptions(); const s = this.scene; for (const e of s?.sim?.players ?? []) if (!s.judge) e.assists = { ...A }; };\n    const toggle = (id, label, val, flip) => { const f = ui.item(id, x, y, w, h, { confirm: flip, onX: flip }); ui.rect(x, y, w, h, f ? 'navy' : 'night'); ui.text(x + 6, y + 5, label, { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 5, val, { align: 'right', color: 'sand' }); y += h + 3; };\n    toggle('abs', 'ABS', A.abs ? 'ON' : 'OFF', () => { A.abs = !A.abs; apply(); });\n    ui.slider('tcs', x, y, w, h, 'TRACTION CONTROL', A.tcs, 0, 10, { step: 1, set: (v) => { A.tcs = Math.round(v); apply(); }, reset: () => { A.tcs = 5; apply(); }, format: (v) => String(v) }); y += h + 3;\n    ui.slider('asm', x, y, w, h, 'STABILITY CONTROL', A.asm, 0, 10, { step: 1, set: (v) => { A.asm = Math.round(v); apply(); }, reset: () => { A.asm = 5; apply(); }, format: (v) => String(v) }); y += h + 3;\n    toggle('auto', 'GEARS', A.auto ? 'AUTOMATIC' : 'MANUAL', () => { A.auto = !A.auto; apply(); });\n    toggle('line', 'DRIVING LINE', A.line ? 'ON' : 'OFF', () => { A.line = !A.line; apply(); });\n    if (this.scene?.judge) ui.text(ui.cx, y + 2, 'A TEST MAY OVERRIDE THESE.', { align: 'center', color: 'orange' });\n    ui.prompts([['confirm', 'CHANGE'], ['moveX', 'ADJUST'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/game/ui/screens/results.js <<'EOF'\n// Results: one large table of at most 8 rows, then prize money counting up with a soft register sound, then points.\nimport { CAR_INFO } from '../../data/cars.js';\nimport { EVENTS, POINTS } from '../../data/events.js';\nimport { LINES } from '../../data/text.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { formatTime } from '../../sim/race.js';\nimport { cr } from './common.js';\nconst fill = (s, o) => s.replace('{TRACK}', o.track).replace('{NAME}', o.name).replace('{POS}', o.pos).replace('{TIME}', o.time ?? '');\nexport class ResultsScreen {\n  constructor(app, o) { this.id = 'results'; this.app = app; this.o = o; this.t = 0; this.shown = 0; this.saved = false; this.defaultFocus = 'continue'; }\n  enter(ui) {\n    const o = this.o, track = TRACKS[o.track]?.name?.toUpperCase() ?? '', me = o.rows.find((r) => r.player === 0), list = me?.pos === 1 ? LINES.dell.win : (me?.pos ?? 9) <= 3 ? LINES.dell.podium : LINES.dell.mid, line = o.record ? LINES.dell.record : list[Math.round((o.seed ?? 1) * 7) % list.length];\n    ui.say('dell', fill(line, { track, name: 'THE DRIVER', pos: `P${me?.pos ?? '-'}`, time: o.bestText }), 5);\n    this.app.mix.sfx(me?.pos === 1 ? 'fanfare2' : 'sting');\n  }\n  draw(ui, dt) {\n    const app = this.app, o = this.o, w = Math.min(ui.w - 16, 372), x = Math.round(ui.cx - w / 2), rows = o.rows.slice(0, 8), rh = 14, top = 26; this.t += dt;\n    ui.panel(x, 6, w, ui.h - 30, { color: 'ink', border: 'slate' });\n    ui.text(x + 8, 11, o.title ?? 'RESULTS', { color: 'sand' }); ui.text(x + w - 8, 11, TRACKS[o.track]?.name?.toUpperCase() ?? '', { align: 'right', color: 'mist' });\n    rows.forEach((r, k) => {\n      const y = top + k * rh, mine = r.player !== null && r.player !== undefined; if (mine) ui.rect(x + 3, y - 2, w - 6, rh - 1, 'navy');\n      ui.text(x + 8, y + 1, `${r.pos}`, { color: k === 0 ? 'sand' : 'white', scale: 1 }); ui.text(x + 24, y + 1, r.name, { color: mine ? 'sand' : 'white' }); ui.text(x + 104, y + 1, CAR_INFO[r.carId].short, { color: 'mist' });\n      ui.text(x + w - 44, y + 1, r.text ?? '', { align: 'right', color: k === 0 ? 'sand' : 'white' });\n      if (o.showPoints) ui.text(x + w - 8, y + 1, `${POINTS[k] ?? 0}`, { align: 'right', color: 'lime' });\n    });\n    const by = top + rows.length * rh + 3;\n    if (o.best) ui.text(x + 8, by, `YOUR BEST LAP ${formatTime(o.best)}${o.record ? ', A NEW RECORD' : ''}`, { color: o.record ? 'lime' : 'mist' });\n    if (o.prize !== undefined) {\n      const reveal = Math.min(1, this.t / 1.4), shown = Math.round(o.prize * reveal);\n      if (shown !== this.shown && Math.floor(this.t * 12) !== Math.floor((this.t - dt) * 12)) app.mix.sfx('coin', { volume: 0.5 }); this.shown = shown;\n      if (reveal >= 1 && !this.rang) { this.rang = true; if (o.prize > 0) app.mix.sfx('register'); }\n      ui.text(x + 8, by + 11, 'PRIZE', { color: 'mist' }); ui.text(x + 56, by + 11, cr(shown), { color: 'sand' });\n      if (o.points !== undefined) { ui.text(x + w - 8, by + 11, `${o.points} POINTS`, { align: 'right', color: 'lime' }); }\n      if (o.seriesLine) ui.text(x + 8, by + 22, o.seriesLine, { color: o.seriesWon ? 'lime' : 'mist' });\n    }\n    const bw = Math.floor((w - 16 - 15) / 4), byy = ui.h - 44;\n    ui.button('continue', x + 8, byy, bw, 15, 'CONTINUE', { confirm: () => app.resultsContinue(o) });\n    if (o.retry !== false) ui.button('retry', x + 13 + bw, byy, bw, 15, 'RETRY', { confirm: () => app.resultsRetry(o) });\n    ui.button('replay', x + 18 + bw * 2, byy, bw, 15, 'WATCH REPLAY', { confirm: () => app.watchReplay({ after: () => app.afterResultsReplay(o) }) });\n    ui.button('save', x + 23 + bw * 3, byy, bw, 15, this.saved ? 'SAVED' : 'SAVE REPLAY', { confirm: () => this.saveAsk(ui), disabled: this.saved });\n    ui.prompts([['confirm', 'CHOOSE']]);\n    if (this.pickSlot) this.drawSlots(ui);\n  }\n  saveAsk() { this.pickSlot = true; }\n  drawSlots(ui) { /* the slot picker pushes itself as its own screen, so input is its own */ ui.push(new SaveSlotScreen(this.app, this)); this.pickSlot = false; }\n  onBack() { this.app.resultsContinue(this.o); return true; }\n}\nexport class SaveSlotScreen {\n  constructor(app, parent) { this.id = 'saveSlot'; this.app = app; this.parent = parent; }\n  draw(ui) {\n    const app = this.app, p = app.profile, w = 220, x = Math.round(ui.cx - w / 2), y = 70; ui.panel(x - 6, y - 16, w + 12, 100, { color: 'ink', border: 'sand' }); ui.text(ui.cx, y - 11, 'SAVE TO WHICH SLOT?', { align: 'center', color: 'sand' });\n    p.replays.forEach((z, k) => ui.button(`slot${k}`, x, y + k * 20, w, 16, `SLOT ${k + 1}: ${z ? TRACKS[z.meta.track].name.toUpperCase() : 'EMPTY'}`, { left: true, confirm: () => { const ok = app.saveReplay(k); ui.pop(); if (ok) { this.parent.saved = true; ui.note('SAVED TO THE THEATRE.'); } else ui.note('THE STORAGE IS FULL. THE REPLAY WAS NOT SAVED.'); } }));\n    ui.prompts([['confirm', 'SAVE'], ['back', 'BACK']]);\n  }\n}\nexport const eventRowsTitle = (id) => EVENTS[id]?.name ?? 'RESULTS';\nEOF\ncat > src/game/ui/screens/cinema.js <<'EOF'\n// The ceremonies: the podium, the prize reveal, the credits and the ending card. All are Timelines over a set.\nimport { Timeline, THREE, PALETTE, toonMaterial } from '../../../pixel-engine.js';\nimport { CAR_INFO } from '../../data/cars.js';\nimport { EVENTS } from '../../data/events.js';\nimport { ENDING_LINES } from '../../data/text.js';\nimport { TITLE, MAKER, SOURCE } from '../../data/meta.js';\nimport { makePerson } from '../../render/people.js';\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\nconst P = (b, x, y, z) => [b.x + x, y, b.z + z];\nfunction playShots(scene, tl) { const t = tl, v = new Vector3(); scene.camOverride = (cam) => { const shot = t.camera(); if (!shot) return; cam.position.set(...shot.position); v.set(...shot.target); cam.lookAt(v); if (shot.fov) { cam.fov = shot.fov; cam.updateProjectionMatrix(); } }; }\nexport class PodiumScreen {\n  constructor(app, o) { this.id = 'podium'; this.app = app; this.o = o; this.t = 0; this.noBack = true; this.inputOff = false; }\n  async enter() {\n    const a = this.app, s = a.scene, o = this.o; a.mix.music('fanfare'); s.stage('podium', { orbit: false, radius: 22, height: 8, lookY: 2 });\n    const b = s.base; const win = await makePerson(a.ctx, 'driver'), two = await makePerson(a.ctx, 'crew'), three = await makePerson(a.ctx, 'crew2');\n    this.people = [win, two, three]; win.object.position.set(b.x, 2, b.z - 3); two.object.position.set(b.x - 4, 1.3, b.z - 3); three.object.position.set(b.x + 4, 0.8, b.z - 3); for (const q of this.people) { a.ctx.scene.add(q.object); q.play('Idle'); }\n    win.play('PodiumCheer'); two.play('CrowdCheer'); three.play('PodiumBow');\n    s.fx.push((dt) => { for (const q of this.people) q.update(dt); });\n    // The winner's car rolls in.\n    const v = s.showCar(o.carId, o.install, { y: 0 }); s.stageOpts.carFixed = true; s.stageOpts.carX = 12; s.stageOpts.carZ = 6; s.stageOpts.carYaw = -Math.PI / 2; s.carSpin = 2;\n    s.fx.push((dt) => { const so = s.stageOpts; if (so.carX > 0.5) so.carX = Math.max(0.5, so.carX - dt * 3.2); else s.carSpin = 0; void v; });\n    this.tl = new Timeline({ bars: 0.5, shots: [{ at: 0, position: P(b, 0, 2.2, 12), target: P(b, 0, 2.6, -3), fov: 42 }, { at: 3, position: P(b, -6, 4.4, 9), target: P(b, 0, 2.8, -3), fov: 34 }, { at: 3.01, cut: true, position: P(b, 9, 1.4, 11), target: P(b, 2, 0.9, 6), fov: 30 }, { at: o.short ? 6 : 7, position: P(b, 5, 2, 12), target: P(b, 0, 1.0, 6), fov: 34 }, { at: o.short ? 6.01 : 7.01, cut: true, position: P(b, 0, 3.5, 6), target: P(b, 0, 3.4, -3), fov: 40 }, { at: o.short ? 8 : 10.5, position: P(b, 0, 3.3, 4.5), target: P(b, 0, 3.2, -3), fov: 30 }], lines: [{ at: 0.4, until: 3.5, text: EVENTS[o.eventId]?.name ?? 'A WIN', who: 'DELL' }, { at: 3.6, until: 7, text: o.line ?? 'THE CAR WAS DRIVEN CORRECTLY. THE CROWD WAS INFORMED.', who: 'DELL' }], cues: [{ at: 0.3, run: () => { a.mix.sfx('fanfare2'); a.ctx.particles.burst('confetti', P(b, 0, 9, -3)); } }, { at: 1.3, run: () => a.ctx.particles.burst('confetti', P(b, -3, 9, -3)) }, { at: 2.3, run: () => a.ctx.particles.burst('confetti', P(b, 3, 9, -3)) }, { at: 3.6, run: () => a.mix.say(o.line ?? 'THE CAR WAS DRIVEN CORRECTLY.', 'dell') }, { at: 5, run: () => a.ctx.particles.burst('confetti', P(b, 0, 9, -3)) }], onEnd: () => { this.done = true; } });\n    this.tl.play(); playShots(s, this.tl);\n  }\n  exit() { const s = this.app.scene; if (s) { s.camOverride = null; s.fx.length = 0; if (s.stageOpts) s.stageOpts.carFixed = false; s.carSpin = 0; for (const q of this.people ?? []) q.object.removeFromParent(); } }\n  draw(ui, dt) {\n    if (!this.tl) return; this.tl.update(dt);\n    const barH = Math.round(this.tl.bars() * 22); ui.rect(0, 0, ui.w, barH, 'ink'); ui.rect(0, ui.h - barH, ui.w, barH, 'ink');\n    const l = this.tl.line(); if (l) { ui.text(ui.cx, ui.h - 40 - (barH ? 0 : 0), `${l.who ? l.who + ': ' : ''}${l.text}`.slice(0, 66), { align: 'center', color: 'white' }); }\n    ui.text(ui.cx, 4, 'THE WINNER', { align: 'center', color: 'sand' });\n    if (this.done && !this.o.auto) { this.done = false; this.o.next(); } else if (this.done) this.o.next?.();\n    if (this.app.actions.pressed('confirm') && !this.o.auto) this.tl.skip();\n    ui.prompts([['confirm', 'SKIP']]);\n  }\n}\nexport class PrizeScreen {\n  constructor(app, o) { this.id = 'prize'; this.app = app; this.o = o; this.noBack = true; this.lights = []; }\n  enter() {\n    const a = this.app, s = a.scene, o = this.o, ctx = a.ctx; s.stage('prize', { car: { carId: o.carId, install: null, y: 0.18 }, orbit: false, radius: 8, height: 2.2, angle: 0.5 }); s.stageOpts.carFixed = true; s.stageOpts.carYaw = 0.8;\n    const b = s.base;\n    this.cover = new Mesh(new BoxGeometry(2.6, 1.7, 5.2), toonMaterial(PALETTE.plum)); this.cover.position.set(b.x, 0.95, b.z); this.cover.rotation.y = 0.8; this.cover.castShadow = true; ctx.scene.add(this.cover);\n    const light = (x, y, z, c, i) => { const h = ctx.lights.request({ position: [b.x + x, y, b.z + z], color: c, intensity: i, radius: 16, priority: 4, fadeIn: 0.6 }); this.lights.push(h); };\n    const name = CAR_INFO[o.carId].name;\n    this.tl = new Timeline({ bars: 0.5, shots: [{ at: 0, position: P(b, 0, 3.4, 10), target: P(b, 0, 1, 0), fov: 34 }, { at: 3, position: P(b, 3, 2.6, 8), target: P(b, 0, 1, 0), fov: 30 }, { at: o.short ? 6 : 9, position: P(b, 6, 1.5, 4.6), target: P(b, 0, 0.9, 0), fov: 34 }], lines: [{ at: 1, until: 3, text: 'A PRIZE.' }, { at: 4.2, until: o.short ? 6 : 9, text: name }], cues: [{ at: 0.7, run: () => light(-3, 5, 2, 0xffe0a0, 14) }, { at: 1.7, run: () => { light(3, 5, 2, 0xffe0a0, 14); a.mix.sfx('tick'); } }, { at: 2.6, run: () => { a.mix.sfx('whirr'); ctx.tweens.to(this.cover.position, { y: 6, z: b.z - 4 }, { duration: 1.5, ease: 'inOutQuad' }); } }, { at: 3.4, run: () => { a.mix.sfx('fanfare2'); light(0, 6, 5, 0xffffff, 18); ctx.engine.ambient.intensity = 1; ctx.particles.burst('confetti', P(b, 0, 6, 0)); } }, { at: 4.4, run: () => a.mix.say(o.line ?? 'PRIZE CARS ARE NOT FOR SALE. IT IS SIMPLY NOT DONE.', 'fenn') }], onEnd: () => { this.done = true; } });\n    this.tl.play(); playShots(s, this.tl);\n  }\n  exit() { const s = this.app.scene; if (s) { s.camOverride = null; if (s.stageOpts) s.stageOpts.carFixed = false; } this.cover?.removeFromParent(); for (const l of this.lights) l.release?.(); }\n  draw(ui, dt) {\n    if (!this.tl) return; this.tl.update(dt);\n    const barH = Math.round(this.tl.bars() * 22); ui.rect(0, 0, ui.w, barH, 'ink'); ui.rect(0, ui.h - barH, ui.w, barH, 'ink');\n    const l = this.tl.line(); if (l) ui.text(ui.cx, ui.h - 44, l.text, { align: 'center', scale: 2, color: 'sand' });\n    if (this.done) { this.done = false; this.o.next?.(); }\n    if (this.app.actions.pressed('confirm') && !this.o.auto) this.tl.skip();\n    ui.prompts([['confirm', 'SKIP']]);\n  }\n}\n// The credits, then the ending card in the catalogue voice.\nexport class EndingScreen {\n  constructor(app, o) { this.id = 'ending'; this.app = app; this.o = o; this.t = 0; this.noBack = true; this.defaultFocus = 'go'; }\n  enter() { const a = this.app; a.mix.music('longDrive'); a.scene.stage('map', { hour: 21 }); }\n  draw(ui, dt) {\n    this.t += dt; const rows = [TITLE, MAKER, '', 'INSPIRED BY', SOURCE.toUpperCase(), '', 'MS. ARAI, CHIEF EXAMINER', 'BENNO, MECHANIC', 'MR. FENN, DEALER', 'DELL, COMMENTATOR', '', 'BUILT ON PIXEL ENGINE 0.46.0', 'THREE.JS R186, RAPIER', 'THE SWEETIE 16 PALETTE BY GRAFXKID', '', 'THANK YOU FOR DRIVING.'], scroll = ui.h - this.t * 18;\n    ui.panel(ui.cx - 140, 0, 280, ui.h, { color: 'ink', border: false, scan: true });\n    if (scroll > -rows.length * 12 - 10) rows.forEach((r, k) => { const y = scroll + k * 12; if (y > -8 && y < ui.h - 20) ui.text(ui.cx, y, r, { align: 'center', color: k === 0 ? 'sand' : 'white' }); });\n    else { ui.text(ui.cx, 96, ENDING_LINES[0], { align: 'center', scale: 2, color: 'white' }); ui.text(ui.cx, 118, ENDING_LINES[1], { align: 'center', scale: 2, color: 'sand' }); ui.button('go', ui.cx - 50, 160, 100, 16, 'CONTINUE', { confirm: () => this.o.next() }); }\n    if (this.app.actions.pressed('confirm') && scroll > -rows.length * 12 - 10) this.t = 999;\n    ui.prompts([['confirm', scroll > -rows.length * 12 - 10 ? 'SKIP' : 'CONTINUE']]);\n  }\n}\nEOF\ncat > src/game/scenes/replay.js <<'EOF'\n// ReplayScene: plays recorded poses with the replay director. Replays never re-simulate.\nimport { THREE } from '../../pixel-engine.js';\nimport { loadTrack, carProfile } from '../sim/race.js';\nimport { tunedParams } from '../sim/tuning.js';\nimport { buildWorld } from '../render/world.js';\nimport { CarView } from '../render/carview.js';\nimport { TvDirector } from '../render/director.js';\nimport { CAM_MODES, ChaseCam } from '../render/camera.js';\nimport { F_AIR, F_BRAKE, F_LOCK, F_SLIDE } from '../sim/replaydata.js';\nimport { LINES } from '../data/text.js';\nimport { CAR_INFO } from '../data/cars.js';\nconst { Vector3 } = THREE;\nconst MODES = ['DIRECTOR', 'CHASE', 'BONNET', 'FREE'];\nexport class ReplayScene {\n  constructor(app, rec, opts = {}) { this.name = 'replay'; this.app = app; this.rec = rec; this.opts = opts; this.t = 0; this.playing = true; this.mode = 0; this.focus = rec.meta.cars.findIndex((c) => c.player === 0); if (this.focus < 0) this.focus = 0; this.views = []; this.target = new Vector3(); this.pose = {}; this.hudOn = true; this.orbit = 0.6; this.pitch = 0.3; this.dist = 9; this.dellT = 4; this.dellI = 0; }\n  async setup(ctx) {\n    const app = this.app; app.enterScene(ctx, this); app.ui.clear();\n    const cam = ctx.camera.camera; cam.near = 0.5; cam.far = 6000; cam.updateProjectionMatrix(); this.cam = cam;\n    const m = this.rec.meta, { tr, line } = loadTrack(m.track, { rain: m.rain }); this.tr = tr;\n    const f = m.cars[this.focus], p = tunedParams(f.carId, f.install);\n    this.world = buildWorld(ctx, tr, line, { hour: m.hour, rain: m.rain, speeds: carProfile(tr, line, p, f.carId, JSON.stringify(f.install ?? '')) });\n    this.views = m.cars.map((c) => { const v = new CarView(c.carId, { install: c.install, paint: c.paint ?? undefined }); ctx.scene.add(v.object); return v; });\n    this.tv = new TvDirector(tr, this.world.field, 23); this.chase = new ChaseCam(cam); this.chase.mode = 0;\n    app.mix.clearCars(); app.mix.music(this.opts.song === null ? null : 'longDrive');\n    this.night = this.world.night;\n    if (this.night > 0.15) { this.beam = new THREE.Object3D(); ctx.scene.add(this.beam); ctx.lights.request({ follow: this.beam, color: 0xfff0c0, intensity: 16, radius: 34, priority: 8, decay: 1 }); }\n    app.ui.push(new ReplayHudScreen(app, this));\n  }\n  fixedUpdate(ctx) { this.app.actions.latch(ctx); }\n  update(ctx, dt) {\n    const app = this.app, a = app.actions; a.setDt(dt); a.latch(ctx); ctx.hud.clear();\n    if (!this.world) { a.send(ctx); return; }\n    const slow = a.pads.some((p) => p.buttons[7] > 0.3) || ctx.input.isDown('ShiftLeft'), rate = slow ? 0.25 : 1;\n    if (this.playing) { this.t += dt * rate; if (this.t >= this.rec.duration) { if (this.opts.onEnd) { this.opts.onEnd(); } else this.t = 0; } }\n    this.t = Math.max(0, Math.min(this.rec.duration - 0.01, this.t));\n    const rec = this.rec, s = this.pose;\n    for (let i = 0; i < this.views.length; i++) {\n      rec.sample(i, this.t, s); const v = this.views[i], f = s.flags;\n      v.update(this.playing ? dt * rate : 0, s.x, s.y, s.z, s.yaw, s.pitch, s.roll, 0, 0, s.steer, s.u, !!(f & F_AIR));\n      v.setBrake(!!(f & F_BRAKE)); v.setHead(this.night > 0.2);\n      if (i === this.focus) { this.fx = { x: s.x, y: s.y, z: s.z, yaw: s.yaw, u: s.u, rpm: s.rpm, throttle: s.throttle, flags: f }; }\n      const near = (s.x - this.cam.position.x) ** 2 + (s.z - this.cam.position.z) ** 2 < 22000;\n      if (near && this.playing && (f & (F_SLIDE | F_LOCK)) && Math.abs(s.u) > 4) { ctx.particles.burst(this.tr.surface === 'dirt' ? 'dirtDust' : 'tyreSmoke', [s.x - Math.sin(s.yaw) * 1.2, s.y + 0.15, s.z - Math.cos(s.yaw) * 1.2]); this.world.skids.lay(`${i}`, s.x - Math.sin(s.yaw) * 1.2, s.y, s.z - Math.cos(s.yaw) * 1.2); } else this.world.skids.lift(`${i}`);\n      if (near && this.playing && this.tr.surface === 'dirt' && Math.abs(s.u) > 5 && Math.floor(this.t * 20) !== Math.floor((this.t - dt) * 20)) ctx.particles.burst('dirtDust', [s.x - Math.sin(s.yaw) * 1.2, s.y + 0.15, s.z - Math.cos(s.yaw) * 1.2], { count: 1 });\n    }\n    const F = this.fx; this.target.set(F.x, F.y + 0.9, F.z);\n    if (this.beam) this.beam.position.set(F.x + Math.sin(F.yaw) * 12, F.y + 1.6, F.z + Math.cos(F.yaw) * 12);\n    // Camera modes: Director, Chase, Bonnet, Free.\n    const name = MODES[this.mode], i0 = this.nearestIdx(F.x, F.z), fv = this.views[this.focus];\n    fv.object.visible = name !== 'BONNET';\n    if (name === 'DIRECTOR') {\n      const anySlide = !!(F.flags & (F_SLIDE | F_LOCK));\n      const cut = this.tv.update(dt, { x: F.x, y: F.y, z: F.z, s: i0 * this.tr.ds }, this.cam, { busy: anySlide });\n      if (cut && anySlide) this.tv.cutT = Math.min(this.tv.cutT, 5);\n    } else if (name === 'FREE') {\n      let dx = 0, dy = 0; if (ctx.input.isDown('MouseLeft') || ctx.input.isDown('MouseRight')) { dx = (ctx.input.mouseDelta.x ?? 0) * 0.01; dy = (ctx.input.mouseDelta.y ?? 0) * 0.008; } for (const p of a.pads) { if (Math.abs(p.axes[2]) > 0.15) dx += p.axes[2] * dt * 2; if (Math.abs(p.axes[3]) > 0.15) dy += p.axes[3] * dt * 1.5; }\n      this.orbit += dx; this.pitch = Math.max(0.03, Math.min(1.4, this.pitch + dy)); if (a.wheel) this.dist = Math.max(3.5, Math.min(40, this.dist + Math.sign(a.wheel) * 1.2));\n      this.cam.position.set(F.x + Math.sin(this.orbit) * Math.cos(this.pitch) * this.dist, F.y + 0.8 + Math.sin(this.pitch) * this.dist, F.z + Math.cos(this.orbit) * Math.cos(this.pitch) * this.dist); this.cam.lookAt(this.target); if (this.cam.fov !== 48) { this.cam.fov = 48; this.cam.updateProjectionMatrix(); }\n    } else { this.chase.mode = name === 'BONNET' ? 2 : 0; this.chase.update(dt, F, {}); }\n    this.world.update(this.playing ? dt * rate : 0, ctx.time, false, this.target, i0 * this.tr.ds);\n    // Sound: the focus car, at a distance that follows the camera.\n    if (this.playing) { const d = this.cam.position.distanceTo(this.target), g = name === 'DIRECTOR' ? Math.max(0.12, Math.min(1, 30 / Math.max(10, d))) : 1, car = rec.meta.cars[this.focus]; if (!this.pCache) this.pCache = rec.meta.cars.map((c) => tunedParams(c.carId, c.install)); app.mix.engines([{ key: `${this.focus}:${car.carId}`, carId: car.carId, p: this.pCache[this.focus], rpm: F.rpm, throttle: F.throttle, spool: 0.5, gain: g, pan: 0 }], dt); this.dellT -= dt; if (this.dellT <= 0) { this.dellT = 7 + (this.dellI % 3) * 2; const l = LINES.dell.replay[this.dellI++ % LINES.dell.replay.length]; app.ui.say('dell', l, 4); } } else app.mix.quiet();\n    app.ui.frame(ctx, dt); app.afterFrame(ctx, dt);\n    a.send(ctx);\n  }\n  nearestIdx(x, z) { const tr = this.tr; let best = this.lastI ?? 0, bd = Infinity; const c = this.lastI ?? 0; for (let k = -30; k <= 30; k++) { const i = (c + k + tr.N) % tr.N, d = (tr.x[i] - x) ** 2 + (tr.z[i] - z) ** 2; if (d < bd) { bd = d; best = i; } } if (this.lastI === undefined || bd > 2500) { for (let i = 0; i < tr.N; i += 2) { const d = (tr.x[i] - x) ** 2 + (tr.z[i] - z) ** 2; if (d < bd) { bd = d; best = i; } } } this.lastI = best; return best; }\n  cameraTarget() { return this.target; }\n  status() { return `replay ${this.rec.meta.track} ${this.t.toFixed(1)}/${this.rec.duration.toFixed(1)} ${MODES[this.mode]}`; }\n  dispose() { if (this.app.scene === this) this.app.scene = null; this.app.mix.clearCars(); }\n}\nclass ReplayHudScreen {\n  constructor(app, scene) { this.id = 'replay'; this.app = app; this.scene = scene; this.inputOff = false; this.noBox = true; }\n  draw(ui, dt) {\n    const a = this.app.actions, s = this.scene, app = this.app, ctx = app.ctx, N = s.views.length;\n    if (a.pressed('confirm')) { s.playing = !s.playing; app.mix.sfx('tick'); }\n    const dx = a.moveX(); if (dx) { s.t += dx * 3; app.mix.sfx('tick'); }\n    if (a.pressed('tabL')) { s.focus = (s.focus - 1 + N) % N; s.tv.force(); app.mix.sfx('tick'); s.pCache && 0; }\n    if (a.pressed('tabR')) { s.focus = (s.focus + 1) % N; s.tv.force(); app.mix.sfx('tick'); }\n    if (a.pressed('info')) { s.mode = (s.mode + 1) % MODES.length; s.chase.snap(); app.mix.sfx('tick'); }\n    if (a.pressed('alt') || ctx.input.wasPressed('KeyH')) s.hudOn = !s.hudOn;\n    // Mouse: click a car to focus it.\n    if (a.clicked) { const p = ctx.input.pointer, o = new THREE.Vector3(), d = new THREE.Vector3(); ctx.camera.rayAt(p.x, p.y, o, d); let best = 7, bi = -1; s.views.forEach((v, i) => { const q = v.object.position.clone().sub(o), t = q.dot(d), d2 = q.lengthSq() - t * t; if (t > 0 && d2 < best) { best = d2; bi = i; } }); if (bi >= 0) { s.focus = bi; s.tv.force(); } }\n    if (!s.hudOn) return;\n    // Bars and a small tag.\n    ui.rect(0, 0, ui.w, 12, 'ink'); ui.rect(0, ui.h - 28, ui.w, 28, 'ink');\n    ui.text(6, 3, 'REPLAY', { color: Math.floor(ui.time * 2) % 2 ? 'red' : 'white' }); ui.text(50, 3, MODES[s.mode], { color: 'mist' }); const car = s.rec.meta.cars[s.focus]; ui.text(ui.w - 6, 3, `${car.name}  ${CAR_INFO[car.carId].short}`, { align: 'right', color: 'sand' });\n    ui.bar(6, ui.h - 25, ui.w - 12, 3, s.t / s.rec.duration, 'sand', 'night');\n    ui.text(ui.cx, 3, `${Math.round(Math.abs(s.fx?.u ?? 0) * 3.6)} KM/H`, { align: 'center', color: 'white' });\n    if (!s.playing) ui.text(ui.cx, 30, 'PAUSED', { align: 'center', scale: 2, color: 'sand' });\n    ui.prompts([['play', s.playing ? 'PAUSE' : 'PLAY'], ['scrub', 'SCRUB'], ['focus', 'CAR'], ['info', 'CAMERA'], ['slow', 'SLOW'], ['alt', 'HIDE'], ['back', 'EXIT']]);\n    void CAM_MODES; void dt;\n  }\n  onBack() { const s = this.scene; s.opts.after?.(); return true; }\n}\nEOF\ncat > src/game/flows.js <<'EOF'\n// The glue between screens and scenes: starting a drive, what happens after it, and where it returns to.\nimport { RaceScene } from './scenes/race.js';\nimport { MenuScene } from './scenes/menu.js';\nimport { ReplayScene } from './scenes/replay.js';\nimport { TESTS, LICENCES } from './data/licences.js';\nimport { EVENTS } from './data/events.js';\nimport { CAR_INFO } from './data/cars.js';\nimport { LINES } from './data/text.js';\nimport { carEntry, driveCar, eventState, oilOf, recordFailure, recordLap, recordRound, recordTest } from './sim/career.js';\nimport { couchSetup, eventSetup, quickSetup, testDriveSetup, trialSetup } from './sim/setups.js';\nimport { legCount, testSetup } from './sim/licence.js';\nimport { formatTime } from './sim/race.js';\nimport { GhostTrace, Recording } from './sim/replaydata.js';\nimport { PauseScreen } from './ui/screens/pause.js';\nimport { MapScreen } from './ui/screens/map.js';\nimport { LicenceListScreen, TestListScreen, TestCardScreen, TestResultScreen } from './ui/screens/licence.js';\nimport { EventCardScreen, EventListScreen, RoundCardScreen } from './ui/screens/events.js';\nimport { DealerScreen } from './ui/screens/dealer.js';\nimport { PartsScreen, TuningScreen } from './ui/screens/tuning.js';\nimport { GarageScreen } from './ui/screens/garage.js';\nimport { TheatreScreen } from './ui/screens/theatre.js';\nimport { ArcadeScreen } from './ui/screens/arcade.js';\nimport { ResultsScreen } from './ui/screens/results.js';\nimport { EndingScreen, PodiumScreen, PrizeScreen } from './ui/screens/cinema.js';\nimport { startCouchEngine, stopCouchEngine } from './net/couch.js';\nimport { DevPanel } from './dev/devmode.js';\nvoid Recording;\nexport function installFlows(app) {\n  const seed = () => { app.seedN = (app.seedN ?? 0) + 1; return (Date.now() % 100000) + app.seedN; };\n  const toMenu = (start) => app.go(() => new MenuScene(app, { start }));\n  app.toMenu = toMenu;\n  const mapThen = (...list) => (ui) => { ui.push(new MapScreen(app)); for (const fn of list) ui.push(fn()); };\n  const assists = () => ({ ...app.options.assists });\n  app.toTitle = () => { app.engine.timeScale = 1; return toMenu(null); };\n  app.factory.pause = (scene) => app.ui.push(new PauseScreen(app, scene));\n  app.openDev = (scene) => app.ui.push(new DevPanel(app, scene));\n  // ---- Licence tests ----\n  app.startTest = (id, o = {}) => {\n    const test = TESTS[id], leg = o.leg ?? 0;\n    const setup = { ...testSetup(test, leg, assists()), seed: seed() };\n    return app.go(() => new RaceScene(app, setup, { test, demo: !!o.demo, showLine: !!app.lineForTest || (app.profile.tests[id]?.fails ?? 0) >= 3 && app.lineForTest, legBase: o.legBase ?? 0, run: { type: 'licence', id, demo: !!o.demo } }));\n  };\n  app.factory.testFinished = (scene) => {\n    const J = scene.judge, test = scene.test, demo = !!scene.opts.demo, id = test.id, base = scene.opts.legBase ?? 0, total = J.total + base, leg = scene.leg;\n    app.lastRace = scene.sim.rec;\n    if (J.status === 'pass' && leg + 1 < legCount(test)) { return app.startTest(id, { demo, leg: leg + 1, legBase: total }); }\n    const o = { test, failed: J.status !== 'pass', reason: J.reason, time: total, demo };\n    if (demo) { o.medal = null; app.ui.push(new TestResultScreen(app, { ...o, failed: false, reason: '', demoShown: true, time: total })); return; }\n    if (J.status !== 'pass') { if (!app.devActive()) recordFailure(app.profile, id); }\n    else if (app.devActive()) { o.notSaved = true; }\n    else { const r = recordTest(app.profile, id, total); o.medal = r.medal; o.licenceWon = r.licenceWon; o.reward = r.reward; o.prizeCar = r.prizeCar; o.allGold = r.allGold; if (!r.medal) o.failed = false; }\n    if (!o.failed) o.next = o.medal === 'gold' ? null : o.medal === 'silver' ? 'gold' : o.medal === 'bronze' ? 'silver' : 'bronze';\n    app.save();\n    if (o.licenceWon) app.ui.note(LINES.arai.licence);\n    app.ui.push(new TestResultScreen(app, o));\n  };\n  app.backToTests = (id, o = {}) => {\n    const lic = TESTS[id].licence;\n    return toMenu((ui) => {\n      ui.push(new MapScreen(app)); ui.push(new LicenceListScreen(app)); ui.push(new TestListScreen(app, lic));\n      if (o.prizeCar) ui.push(new PrizeScreen(app, { carId: o.prizeCar, line: LICENCES[lic].allGold?.text, next: () => ui.pop() }));\n    });\n  };\n  app.afterTestReplay = (o) => app.go(() => new MenuScene(app, { start: (ui) => { ui.push(new MapScreen(app)); ui.push(new LicenceListScreen(app)); ui.push(new TestListScreen(app, o.test.licence)); ui.push(new TestCardScreen(app, o.test.id)); } }));\n  // ---- Events ----\n  app.startEventRound = (id) => {\n    const setup = eventSetup(app.profile, id, assists(), seed());\n    return app.go(() => new RaceScene(app, setup, { run: { type: 'event', id } }));\n  };\n  app.factory.raceFinished = (scene) => {\n    const sim = scene.sim, kind = scene.data.kind, me = sim.cars.find((e) => e.player === 0), run = scene.run ?? {};\n    app.lastRace = sim.rec; const rows = sim.results();\n    const car = carEntry(app.profile);\n    if (kind === 'testdrive') return app.returnFromTestDrive(run);\n    const record = !app.devActive() && me?.bestLap ? recordLap(app.profile, sim.tr.id, me.bestLap, me.carId) : false;\n    const o = { kind, rows, track: sim.tr.id, best: me?.bestLap ?? null, bestText: me?.bestLap ? formatTime(me.bestLap) : '', record, seed: scene.data.seed, run };\n    if (kind === 'race' || kind === 'rally') {\n      app.undo = JSON.stringify(app.profile);\n      if (car && me) driveCar(app.profile, car, me.metres, me.dirtM);\n      const names = rows.map((r) => r.name), r = recordRound(app.profile, run.id, names, 'YOU', app.prizeMult ?? 1);\n      Object.assign(o, { title: EVENTS[run.id].name, prize: r.prize, points: r.points, showPoints: kind === 'race', round: r });\n      if (r.seriesDone) { o.seriesWon = r.seriesWon; o.seriesLine = r.seriesWon ? `THE SERIES IS YOURS. ${r.bonus ? `BONUS ${r.bonus.toLocaleString('en-US')} CR.` : ''}${r.prizeCar ? ` PRIZE: ${CAR_INFO[r.prizeCar].short}.` : ''}` : 'THE SERIES GOES TO ANOTHER DRIVER. YOU MAY ENTER AGAIN.'; }\n      else o.seriesLine = `ROUND ${eventState(app.profile, run.id).round + 1} OF ${EVENTS[run.id].rounds.length} IS NEXT.`;\n      if (me?.pos === 1 && sim.tr.id === 'harbour') scene.fireworksOn = true;\n      app.save();\n    } else if (kind === 'couch') { stopCouchEngine(app); o.title = 'THE DUEL'; o.retry = true; }\n    else { o.title = kind === 'timetrial' ? 'TIME TRIAL' : 'QUICK RACE'; if (me?.pos === 1 && sim.tr.id === 'harbour') scene.fireworksOn = true; }\n    app.ui.push(new ResultsScreen(app, o));\n  };\n  app.resultsContinue = (o) => {\n    const k = o.kind;\n    if (k === 'race' || k === 'rally') {\n      const r = o.round, id = o.run.id;\n      if (r.seriesDone && r.seriesWon) return app.ceremony(id, r);\n      if (r.seriesDone) return toMenu(mapThen(() => new EventListScreen(app), () => new EventCardScreen(app, id)));\n      return toMenu(mapThen(() => new EventListScreen(app), () => new EventCardScreen(app, id), () => new RoundCardScreen(app, id)));\n    }\n    return toMenu(mapThen(() => new ArcadeScreen(app)));\n  };\n  app.ceremony = (id, r) => {\n    const car = carEntry(app.profile), finish = (ui) => { ui.clear(); ui.push(new MapScreen(app)); };\n    return toMenu((ui) => {\n      ui.push(new MapScreen(app));\n      const afterPrize = () => { if (r.ending) { ui.pop(); ui.push(new EndingScreen(app, { next: () => finish(ui) })); } else finish(ui); };\n      const toPrize = () => { ui.pop(); if (r.prizeCar) ui.push(new PrizeScreen(app, { carId: r.prizeCar, next: afterPrize })); else afterPrize(); };\n      ui.push(new PodiumScreen(app, { eventId: id, carId: car?.carId ?? 'kite', install: car?.install, next: toPrize, line: LINES.dell.win[0].replace('{TRACK}', 'THE PENINSULA').replace('{NAME}', 'THE DRIVER') }));\n    });\n  };\n  app.resultsRetry = (o) => {\n    const k = o.kind;\n    if (k === 'race' || k === 'rally') { if (app.undo) { app.profile = JSON.parse(app.undo); app.save(); } return app.startEventRound(o.run.id); }\n    return app.runAgain?.();\n  };\n  // ---- Arcade ----\n  app.startQuick = (p) => { app.runAgain = () => app.startQuick(p); const setup = quickSetup({ ...p, assists: assists(), seed: seed(), poolIds: Object.keys(CAR_INFO).filter((c) => c !== 'type9' || p.carId === 'type9').slice(0, 13) }); return app.go(() => new RaceScene(app, setup, { run: { type: 'quick' } })); };\n  app.startTimeTrial = (p) => { app.runAgain = () => app.startTimeTrial(p); const key = `${p.track}:${p.carId}`, setup = trialSetup({ ...p, assists: assists(), seed: seed() }); return app.go(() => new RaceScene(app, setup, { run: { type: 'trial', key }, ghostData: app.profile.ghosts[key] ?? null })); };\n  app.lapDone = (scene, trace, time) => { // Time trial: the best lap becomes the ghost.\n    const run = scene.run; if (run?.type !== 'trial') return;\n    const key = run.key, cur = app.profile.ghosts[key], isBest = !cur || time < cur.time; if (!isBest || app.devActive()) { if (scene.ghost) scene.traceStart = scene.sim.time; return; }\n    const data = trace.toData(time, scene.sim.cars[0].carId); app.profile.ghosts[key] = data; recordLap(app.profile, scene.sim.tr.id, time, scene.sim.cars[0].carId); app.save(); scene.setGhost(app.ctx, data); scene.hud.flash('A NEW GHOST: YOUR BEST', 3); scene.traceStart = scene.sim.time; void GhostTrace;\n  };\n  app.startCouch = (p) => { app.runAgain = () => app.startCouch(p); const setup = couchSetup({ ...p, assists: assists(), seed: seed() }); app.actions.couch = true; return app.go(() => new RaceScene(app, setup, { compact: true, run: { type: 'couch' }, onReady: (scene) => startCouchEngine(app, scene, setup) })); };\n  // ---- Test drive: one lap of the Proving Ground ----\n  app.startTestDrive = (carId, install, from) => { const car = from.uid ? carEntry(app.profile, from.uid) : null, setup = testDriveSetup({ carId, install, assists: assists(), paint: install?.paint ?? undefined, seed: seed(), oil: car ? oilOf(car) : 1 }); return app.go(() => new RaceScene(app, setup, { run: { type: 'testdrive', from } })); };\n  app.returnFromTestDrive = (run) => { const f = run.from ?? {}; return toMenu((ui) => { ui.push(new MapScreen(app)); if (f.from === 'dealer') { const d = new DealerScreen(app, { first: f.first && !app.profile.cars.length }); d.room = f.room; d.car = f.car; ui.push(d); } else if (f.from === 'parts') { ui.push(new TuningScreen(app)); ui.push(new PartsScreen(app, f.tile)); } else if (f.from === 'tuning') ui.push(new TuningScreen(app)); }); };\n  // ---- Restart and retire, from the pause menu ----\n  app.restartRun = (scene) => {\n    const run = scene.run ?? {}; app.ui.clear(); stopCouchEngine(app);\n    if (run.type === 'licence') return app.startTest(run.id, { demo: run.demo });\n    if (run.type === 'event') return app.startEventRound(run.id);\n    if (run.type === 'testdrive') { const m = scene.data.cars[scene.data.cars.length - 1]; return app.startTestDrive(m.carId, m.install, run.from); }\n    if (scene.opts.attract) return null;\n    return app.runAgain?.();\n  };\n  app.retireRun = (scene) => {\n    const run = scene.run ?? {}, sim = scene.sim; scene.ended = true; stopCouchEngine(app);\n    if (run.type === 'licence') { const t = TESTS[run.id]; if (!run.demo && !app.devActive()) { recordFailure(app.profile, run.id); app.save(); } return app.backToTests(t.id); }\n    if (run.type === 'testdrive') return app.returnFromTestDrive(run);\n    if (run.type === 'event') { for (const e of sim.players) sim.retire(e.i); sim.updateOrder(); app.factory.raceFinished(scene); return null; }\n    return toMenu(mapThen(() => new ArcadeScreen(app)));\n  };\n  // ---- Replays ----\n  app.watchReplay = ({ after }) => { if (!app.lastRace || !app.lastRace.frames) { app.ui.note('THERE IS NOTHING TO WATCH.'); return null; } return app.go(() => new ReplayScene(app, app.lastRace, { after })); };\n  app.afterResultsReplay = (o) => app.resultsContinue(o);\n  app.watchRecording = (rec, { after }) => app.go(() => new ReplayScene(app, rec, { after: after === 'theatre' ? () => toMenu(mapThen(() => new TheatreScreen(app))) : after }));\n  app.watchSaved = (k, { after }) => { const z = app.profile.replays[k]; if (!z) return null; const rec = Recording.fromCompressed(z); return app.watchRecording(rec, { after }); };\n  app.saveReplay = (k) => { if (!app.lastRace) return false; const prev = app.profile.replays[k], z = app.lastRace.compress(); z.day = app.profile.day; app.profile.replays[k] = z; if (!app.save()) { app.profile.replays[k] = prev; return false; } return true; };\n  app.openGarageFromEvent = (ui) => ui.push(new GarageScreen(app, { onChoose: (u) => { u.note('YOUR RIDE IS CHOSEN.'); } }));\n  app.openTuningFromEvent = (ui) => ui.push(new TuningScreen(app));\n}\nEOF\ncat > src/game/net/couch.js <<'EOF'\n// Couch Duel: two players, one TV. The page becomes two side-by-side containers and a second engine draws the shared sim.\nimport { Engine } from '../../pixel-engine.js';\nimport { RaceScene } from '../scenes/race.js';\nexport function engineOptionsFor(container) { return { container, camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false, key: false }, touch: false, seed: 1 }; }\nexport async function startCouchEngine(app, mainScene, setup) {\n  if (typeof document === 'undefined') return null; // headless tools draw one side\n  const p1 = document.getElementById('p1'), p2 = document.getElementById('p2');\n  if (!p1 || !p2) return null;\n  p1.style.width = p2.style.width = '50vw'; p2.style.display = 'block';\n  const scene = new RaceScene(app, setup, { role: 'view', sim: mainScene.sim, viewPlayer: 1, compact: true });\n  const e2 = await Engine.start(scene, engineOptionsFor(p2));\n  e2.audio.persist = false; e2.audio.setMuted(true); e2.input.gamepadButtons = {};\n  app.engine2 = e2; app.couchScene = scene;\n  // Keep the first engine's handle: __PIXEL_ENGINE__ now holds the last one started.\n  if (typeof window !== 'undefined') window.__PIXEL_ENGINE__ = app.engine;\n  return e2;\n}\nexport function stopCouchEngine(app) {\n  app.actions.couch = false;\n  if (!app.engine2) return;\n  try { app.engine2.dispose(); } catch { /* it was on its way out */ }\n  app.engine2 = null; app.couchScene = null;\n  if (typeof document !== 'undefined') { const p1 = document.getElementById('p1'), p2 = document.getElementById('p2'); if (p2) p2.style.display = 'none'; if (p1) p1.style.width = '100vw'; }\n}\nEOF\npython3 - <<'EOF'\np='src/game/sim/licence.js'; s=open(p).read()\na=\"  const carId = legCar(test, leg), dummy = new RaceSim({ track: test.track, cars: [], record: false }), tr = dummy.tr;\\n\"\nb=\"  const carId = legCar(test, leg), { tr } = loadTrack(test.track);\\n\"\nassert a in s; s=s.replace(a,b)\ns=s.replace(\"import { indexOfS, RaceSim, trackPoint, wrapS } from './race.js';\",\"import { indexOfS, loadTrack, RaceSim, trackPoint, wrapS } from './race.js';\")\nopen(p,'w').write(s)\nEOF\nsed -i 's/^6\\. Menu world: IN PROGRESS.*/6-7. Menu world and career screens: written (scenes\\/menu.js, scenes\\/replay.js, flows.js, ui\\/screens\\/*). Not yet run. Next: dev\\/devmode.js, attract\\/director.js, net\\/hub.js, main.js full boot, data suite, headless suite, play suite./' ../PROGRESS.md; echo ok","description":"Write pause, results, ceremonies, replay scene, flows and couch engine"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28878,"cache_read_input_tokens":458648,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28878},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"b9b721fd-e2e6-4cc9-9714-d446a5a3f07e","timestamp":"2026-11-06T01:06:42.412Z","request_id":"req_011CgkmqGWsn1op9fd6CV35y","wire_tool_inputs":{"toolu_0144PkBfoaZFyBT3ErwzJn3V":{"command":"cat > src/game/ui/screens/pause.js <<'EOF'\n// Pause (Options or Esc): Resume, Restart, Retire, Assists, Settings, Handbook, Dev Mode. The race is simply not stepped.\nimport { SettingsScreen } from './settings.js';\nimport { HandbookScreen } from './handbook.js';\nimport { AboutScreen } from './about.js';\nimport { Dialog } from './common.js';\nexport class PauseScreen {\n  constructor(app, scene) { this.id = 'pause'; this.app = app; this.scene = scene; }\n  enter() { this.scene.paused = true; this.app.mix.quiet(); this.app.mix.sfx('tick'); }\n  exit() { this.scene.paused = false; }\n  list() { const a = this.app, s = this.scene; return [['resume', 'RESUME', () => this.app.ui.pop()], ['restart', 'RESTART', () => a.restartRun(s)], ['retire', s.judge ? 'END ATTEMPT' : 'RETIRE', () => this.askRetire()], ['assists', 'ASSISTS', () => a.ui.push(new AssistsScreen(a, s))], ['settings', 'SETTINGS', () => a.ui.push(new SettingsScreen(a, { inRace: true }))], ['handbook', 'HANDBOOK', () => a.ui.push(new HandbookScreen(a))], ...(a.session ? [] : [['dev', 'DEV MODE', () => a.openDev(s)]])]; }\n  askRetire() { const a = this.app, s = this.scene, ui = a.ui, d = new Dialog(a, s.judge ? 'END THIS ATTEMPT?' : 'RETIRE FROM THE RACE?', [s.data.event ? 'YOU WILL BE PLACED LAST IN THIS ROUND.' : 'THE RESULT WILL NOT COUNT.'], [['no', 'KEEP DRIVING', () => ui.pop()], ['yes', 'RETIRE', () => { ui.clear(); a.retireRun(s); }]]); d.focus = 'no'; d.under = this; ui.push(d); }\n  draw(ui) {\n    const list = this.list(), w = 130, h = 15, gap = 3, H = list.length * (h + gap), x = Math.round(ui.cx - w / 2), y = Math.round(ui.h / 2 - H / 2) + 4;\n    ui.panel(x - 12, y - 24, w + 24, H + 32, { color: 'ink', border: 'slate' });\n    ui.text(ui.cx, y - 19, 'PAUSED', { align: 'center', scale: 2, color: 'sand' });\n    list.forEach(([id, label, fn], k) => ui.button(id, x, y + k * (h + gap), w, h, label, { confirm: fn }));\n    if (this.app.actions.pressed('pause') && ui.locked <= 0 && ui.top === this && !this.app.actions.pressed('back')) ui.pop();\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'RESUME']]);\n  }\n}\nexport class MapPause {\n  constructor(app) { this.id = 'mapPause'; this.app = app; }\n  draw(ui) {\n    const a = this.app, list = [['resume', 'BACK TO THE MAP', () => ui.pop()], ['settings', 'SETTINGS', () => ui.push(new SettingsScreen(a))], ['handbook', 'HANDBOOK', () => ui.push(new HandbookScreen(a))], ['about', 'ABOUT', () => ui.push(new AboutScreen(a))], ['dev', 'DEV MODE', () => a.openDev(null)], ['title', 'TITLE SCREEN', () => a.toTitle()]], w = 130, h = 15, gap = 3, H = list.length * (h + gap), x = Math.round(ui.cx - w / 2), y = Math.round(ui.h / 2 - H / 2) + 4;\n    ui.panel(x - 12, y - 24, w + 24, H + 32, { color: 'ink', border: 'slate' });\n    ui.text(ui.cx, y - 19, 'MENU', { align: 'center', scale: 2, color: 'sand' });\n    list.forEach(([id, label, fn], k) => ui.button(id, x, y + k * (h + gap), w, h, label, { confirm: fn }));\n    ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]);\n  }\n}\nexport class AssistsScreen {\n  constructor(app, scene) { this.id = 'assists'; this.app = app; this.scene = scene; }\n  draw(ui) {\n    const a = this.app, A = a.options.assists, w = Math.min(ui.w - 40, 280), x = Math.round(ui.cx - w / 2), h = 16; let y = 44;\n    ui.panel(x - 8, 14, w + 16, 150, { color: 'ink', border: 'slate' }); ui.text(ui.cx, 20, 'ASSISTS', { align: 'center', scale: 2, color: 'sand' });\n    const apply = () => { a.saveOptions(); const s = this.scene; for (const e of s?.sim?.players ?? []) if (!s.judge) e.assists = { ...A }; };\n    const toggle = (id, label, val, flip) => { const f = ui.item(id, x, y, w, h, { confirm: flip, onX: flip }); ui.rect(x, y, w, h, f ? 'navy' : 'night'); ui.text(x + 6, y + 5, label, { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 5, val, { align: 'right', color: 'sand' }); y += h + 3; };\n    toggle('abs', 'ABS', A.abs ? 'ON' : 'OFF', () => { A.abs = !A.abs; apply(); });\n    ui.slider('tcs', x, y, w, h, 'TRACTION CONTROL', A.tcs, 0, 10, { step: 1, set: (v) => { A.tcs = Math.round(v); apply(); }, reset: () => { A.tcs = 5; apply(); }, format: (v) => String(v) }); y += h + 3;\n    ui.slider('asm', x, y, w, h, 'STABILITY CONTROL', A.asm, 0, 10, { step: 1, set: (v) => { A.asm = Math.round(v); apply(); }, reset: () => { A.asm = 5; apply(); }, format: (v) => String(v) }); y += h + 3;\n    toggle('auto', 'GEARS', A.auto ? 'AUTOMATIC' : 'MANUAL', () => { A.auto = !A.auto; apply(); });\n    toggle('line', 'DRIVING LINE', A.line ? 'ON' : 'OFF', () => { A.line = !A.line; apply(); });\n    if (this.scene?.judge) ui.text(ui.cx, y + 2, 'A TEST MAY OVERRIDE THESE.', { align: 'center', color: 'orange' });\n    ui.prompts([['confirm', 'CHANGE'], ['moveX', 'ADJUST'], ['back', 'BACK']]);\n  }\n}\nEOF\ncat > src/game/ui/screens/results.js <<'EOF'\n// Results: one large table of at most 8 rows, then prize money counting up with a soft register sound, then points.\nimport { CAR_INFO } from '../../data/cars.js';\nimport { EVENTS, POINTS } from '../../data/events.js';\nimport { LINES } from '../../data/text.js';\nimport { TRACKS } from '../../data/tracks.js';\nimport { formatTime } from '../../sim/race.js';\nimport { cr } from './common.js';\nconst fill = (s, o) => s.replace('{TRACK}', o.track).replace('{NAME}', o.name).replace('{POS}', o.pos).replace('{TIME}', o.time ?? '');\nexport class ResultsScreen {\n  constructor(app, o) { this.id = 'results'; this.app = app; this.o = o; this.t = 0; this.shown = 0; this.saved = false; this.defaultFocus = 'continue'; }\n  enter(ui) {\n    const o = this.o, track = TRACKS[o.track]?.name?.toUpperCase() ?? '', me = o.rows.find((r) => r.player === 0), list = me?.pos === 1 ? LINES.dell.win : (me?.pos ?? 9) <= 3 ? LINES.dell.podium : LINES.dell.mid, line = o.record ? LINES.dell.record : list[Math.round((o.seed ?? 1) * 7) % list.length];\n    ui.say('dell', fill(line, { track, name: 'THE DRIVER', pos: `P${me?.pos ?? '-'}`, time: o.bestText }), 5);\n    this.app.mix.sfx(me?.pos === 1 ? 'fanfare2' : 'sting');\n  }\n  draw(ui, dt) {\n    const app = this.app, o = this.o, w = Math.min(ui.w - 16, 372), x = Math.round(ui.cx - w / 2), rows = o.rows.slice(0, 8), rh = 14, top = 26; this.t += dt;\n    ui.panel(x, 6, w, ui.h - 30, { color: 'ink', border: 'slate' });\n    ui.text(x + 8, 11, o.title ?? 'RESULTS', { color: 'sand' }); ui.text(x + w - 8, 11, TRACKS[o.track]?.name?.toUpperCase() ?? '', { align: 'right', color: 'mist' });\n    rows.forEach((r, k) => {\n      const y = top + k * rh, mine = r.player !== null && r.player !== undefined; if (mine) ui.rect(x + 3, y - 2, w - 6, rh - 1, 'navy');\n      ui.text(x + 8, y + 1, `${r.pos}`, { color: k === 0 ? 'sand' : 'white', scale: 1 }); ui.text(x + 24, y + 1, r.name, { color: mine ? 'sand' : 'white' }); ui.text(x + 104, y + 1, CAR_INFO[r.carId].short, { color: 'mist' });\n      ui.text(x + w - 44, y + 1, r.text ?? '', { align: 'right', color: k === 0 ? 'sand' : 'white' });\n      if (o.showPoints) ui.text(x + w - 8, y + 1, `${POINTS[k] ?? 0}`, { align: 'right', color: 'lime' });\n    });\n    const by = top + rows.length * rh + 3;\n    if (o.best) ui.text(x + 8, by, `YOUR BEST LAP ${formatTime(o.best)}${o.record ? ', A NEW RECORD' : ''}`, { color: o.record ? 'lime' : 'mist' });\n    if (o.prize !== undefined) {\n      const reveal = Math.min(1, this.t / 1.4), shown = Math.round(o.prize * reveal);\n      if (shown !== this.shown && Math.floor(this.t * 12) !== Math.floor((this.t - dt) * 12)) app.mix.sfx('coin', { volume: 0.5 }); this.shown = shown;\n      if (reveal >= 1 && !this.rang) { this.rang = true; if (o.prize > 0) app.mix.sfx('register'); }\n      ui.text(x + 8, by + 11, 'PRIZE', { color: 'mist' }); ui.text(x + 56, by + 11, cr(shown), { color: 'sand' });\n      if (o.points !== undefined) { ui.text(x + w - 8, by + 11, `${o.points} POINTS`, { align: 'right', color: 'lime' }); }\n      if (o.seriesLine) ui.text(x + 8, by + 22, o.seriesLine, { color: o.seriesWon ? 'lime' : 'mist' });\n    }\n    const bw = Math.floor((w - 16 - 15) / 4), byy = ui.h - 44;\n    ui.button('continue', x + 8, byy, bw, 15, 'CONTINUE', { confirm: () => app.resultsContinue(o) });\n    if (o.retry !== false) ui.button('retry', x + 13 + bw, byy, bw, 15, 'RETRY', { confirm: () => app.resultsRetry(o) });\n    ui.button('replay', x + 18 + bw * 2, byy, bw, 15, 'WATCH REPLAY', { confirm: () => app.watchReplay({ after: () => app.afterResultsReplay(o) }) });\n    ui.button('save', x + 23 + bw * 3, byy, bw, 15, this.saved ? 'SAVED' : 'SAVE REPLAY', { confirm: () => this.saveAsk(ui), disabled: this.saved });\n    ui.prompts([['confirm', 'CHOOSE']]);\n    if (this.pickSlot) this.drawSlots(ui);\n  }\n  saveAsk() { this.pickSlot = true; }\n  drawSlots(ui) { /* the slot picker pushes itself as its own screen, so input is its own */ ui.push(new SaveSlotScreen(this.app, this)); this.pickSlot = false; }\n  onBack() { this.app.resultsContinue(this.o); return true; }\n}\nexport class SaveSlotScreen {\n  constructor(app, parent) { this.id = 'saveSlot'; this.app = app; this.parent = parent; }\n  draw(ui) {\n    const app = this.app, p = app.profile, w = 220, x = Math.round(ui.cx - w / 2), y = 70; ui.panel(x - 6, y - 16, w + 12, 100, { color: 'ink', border: 'sand' }); ui.text(ui.cx, y - 11, 'SAVE TO WHICH SLOT?', { align: 'center', color: 'sand' });\n    p.replays.forEach((z, k) => ui.button(`slot${k}`, x, y + k * 20, w, 16, `SLOT ${k + 1}: ${z ? TRACKS[z.meta.track].name.toUpperCase() : 'EMPTY'}`, { left: true, confirm: () => { const ok = app.saveReplay(k); ui.pop(); if (ok) { this.parent.saved = true; ui.note('SAVED TO THE THEATRE.'); } else ui.note('THE STORAGE IS FULL. THE REPLAY WAS NOT SAVED.'); } }));\n    ui.prompts([['confirm', 'SAVE'], ['back', 'BACK']]);\n  }\n}\nexport const eventRowsTitle = (id) => EVENTS[id]?.name ?? 'RESULTS';\nEOF\ncat > src/game/ui/screens/cinema.js <<'EOF'\n// The ceremonies: the podium, the prize reveal, the credits and the ending card. All are Timelines over a set.\nimport { Timeline, THREE, PALETTE, toonMaterial } from '../../../pixel-engine.js';\nimport { CAR_INFO } from '../../data/cars.js';\nimport { EVENTS } from '../../data/events.js';\nimport { ENDING_LINES } from '../../data/text.js';\nimport { TITLE, MAKER, SOURCE } from '../../data/meta.js';\nimport { makePerson } from '../../render/people.js';\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\nconst P = (b, x, y, z) => [b.x + x, y, b.z + z];\nfunction playShots(scene, tl) { const t = tl, v = new Vector3(); scene.camOverride = (cam) => { const shot = t.camera(); if (!shot) return; cam.position.set(...shot.position); v.set(...shot.target); cam.lookAt(v); if (shot.fov) { cam.fov = shot.fov; cam.updateProjectionMatrix(); } }; }\nexport class PodiumScreen {\n  constructor(app, o) { this.id = 'podium'; this.app = app; this.o = o; this.t = 0; this.noBack = true; this.inputOff = false; }\n  async enter() {\n    const a = this.app, s = a.scene, o = this.o; a.mix.music('fanfare'); s.stage('podium', { orbit: false, radius: 22, height: 8, lookY: 2 });\n    const b = s.base; const win = await makePerson(a.ctx, 'driver'), two = await makePerson(a.ctx, 'crew'), three = await makePerson(a.ctx, 'crew2');\n    this.people = [win, two, three]; win.object.position.set(b.x, 2, b.z - 3); two.object.position.set(b.x - 4, 1.3, b.z - 3); three.object.position.set(b.x + 4, 0.8, b.z - 3); for (const q of this.people) { a.ctx.scene.add(q.object); q.play('Idle'); }\n    win.play('PodiumCheer'); two.play('CrowdCheer'); three.play('PodiumBow');\n    s.fx.push((dt) => { for (const q of this.people) q.update(dt); });\n    // The winner's car rolls in.\n    const v = s.showCar(o.carId, o.install, { y: 0 }); s.stageOpts.carFixed = true; s.stageOpts.carX = 12; s.stageOpts.carZ = 6; s.stageOpts.carYaw = -Math.PI / 2; s.carSpin = 2;\n    s.fx.push((dt) => { const so = s.stageOpts; if (so.carX > 0.5) so.carX = Math.max(0.5, so.carX - dt * 3.2); else s.carSpin = 0; void v; });\n    this.tl = new Timeline({ bars: 0.5, shots: [{ at: 0, position: P(b, 0, 2.2, 12), target: P(b, 0, 2.6, -3), fov: 42 }, { at: 3, position: P(b, -6, 4.4, 9), target: P(b, 0, 2.8, -3), fov: 34 }, { at: 3.01, cut: true, position: P(b, 9, 1.4, 11), target: P(b, 2, 0.9, 6), fov: 30 }, { at: o.short ? 6 : 7, position: P(b, 5, 2, 12), target: P(b, 0, 1.0, 6), fov: 34 }, { at: o.short ? 6.01 : 7.01, cut: true, position: P(b, 0, 3.5, 6), target: P(b, 0, 3.4, -3), fov: 40 }, { at: o.short ? 8 : 10.5, position: P(b, 0, 3.3, 4.5), target: P(b, 0, 3.2, -3), fov: 30 }], lines: [{ at: 0.4, until: 3.5, text: EVENTS[o.eventId]?.name ?? 'A WIN', who: 'DELL' }, { at: 3.6, until: 7, text: o.line ?? 'THE CAR WAS DRIVEN CORRECTLY. THE CROWD WAS INFORMED.', who: 'DELL' }], cues: [{ at: 0.3, run: () => { a.mix.sfx('fanfare2'); a.ctx.particles.burst('confetti', P(b, 0, 9, -3)); } }, { at: 1.3, run: () => a.ctx.particles.burst('confetti', P(b, -3, 9, -3)) }, { at: 2.3, run: () => a.ctx.particles.burst('confetti', P(b, 3, 9, -3)) }, { at: 3.6, run: () => a.mix.say(o.line ?? 'THE CAR WAS DRIVEN CORRECTLY.', 'dell') }, { at: 5, run: () => a.ctx.particles.burst('confetti', P(b, 0, 9, -3)) }], onEnd: () => { this.done = true; } });\n    this.tl.play(); playShots(s, this.tl);\n  }\n  exit() { const s = this.app.scene; if (s) { s.camOverride = null; s.fx.length = 0; if (s.stageOpts) s.stageOpts.carFixed = false; s.carSpin = 0; for (const q of this.people ?? []) q.object.removeFromParent(); } }\n  draw(ui, dt) {\n    if (!this.tl) return; this.tl.update(dt);\n    const barH = Math.round(this.tl.bars() * 22); ui.rect(0, 0, ui.w, barH, 'ink'); ui.rect(0, ui.h - barH, ui.w, barH, 'ink');\n    const l = this.tl.line(); if (l) { ui.text(ui.cx, ui.h - 40 - (barH ? 0 : 0), `${l.who ? l.who + ': ' : ''}${l.text}`.slice(0, 66), { align: 'center', color: 'white' }); }\n    ui.text(ui.cx, 4, 'THE WINNER', { align: 'center', color: 'sand' });\n    if (this.done && !this.o.auto) { this.done = false; this.o.next(); } else if (this.done) this.o.next?.();\n    if (this.app.actions.pressed('confirm') && !this.o.auto) this.tl.skip();\n    ui.prompts([['confirm', 'SKIP']]);\n  }\n}\nexport class PrizeScreen {\n  constructor(app, o) { this.id = 'prize'; this.app = app; this.o = o; this.noBack = true; this.lights = []; }\n  enter() {\n    const a = this.app, s = a.scene, o = this.o, ctx = a.ctx; s.stage('prize', { car: { carId: o.carId, install: null, y: 0.18 }, orbit: false, radius: 8, height: 2.2, angle: 0.5 }); s.stageOpts.carFixed = true; s.stageOpts.carYaw = 0.8;\n    const b = s.base;\n    this.cover = new Mesh(new BoxGeometry(2.6, 1.7, 5.2), toonMaterial(PALETTE.plum)); this.cover.position.set(b.x, 0.95, b.z); this.cover.rotation.y = 0.8; this.cover.castShadow = true; ctx.scene.add(this.cover);\n    const light = (x, y, z, c, i) => { const h = ctx.lights.request({ position: [b.x + x, y, b.z + z], color: c, intensity: i, radius: 16, priority: 4, fadeIn: 0.6 }); this.lights.push(h); };\n    const name = CAR_INFO[o.carId].name;\n    this.tl = new Timeline({ bars: 0.5, shots: [{ at: 0, position: P(b, 0, 3.4, 10), target: P(b, 0, 1, 0), fov: 34 }, { at: 3, position: P(b, 3, 2.6, 8), target: P(b, 0, 1, 0), fov: 30 }, { at: o.short ? 6 : 9, position: P(b, 6, 1.5, 4.6), target: P(b, 0, 0.9, 0), fov: 34 }], lines: [{ at: 1, until: 3, text: 'A PRIZE.' }, { at: 4.2, until: o.short ? 6 : 9, text: name }], cues: [{ at: 0.7, run: () => light(-3, 5, 2, 0xffe0a0, 14) }, { at: 1.7, run: () => { light(3, 5, 2, 0xffe0a0, 14); a.mix.sfx('tick'); } }, { at: 2.6, run: () => { a.mix.sfx('whirr'); ctx.tweens.to(this.cover.position, { y: 6, z: b.z - 4 }, { duration: 1.5, ease: 'inOutQuad' }); } }, { at: 3.4, run: () => { a.mix.sfx('fanfare2'); light(0, 6, 5, 0xffffff, 18); ctx.engine.ambient.intensity = 1; ctx.particles.burst('confetti', P(b, 0, 6, 0)); } }, { at: 4.4, run: () => a.mix.say(o.line ?? 'PRIZE CARS ARE NOT FOR SALE. IT IS SIMPLY NOT DONE.', 'fenn') }], onEnd: () => { this.done = true; } });\n    this.tl.play(); playShots(s, this.tl);\n  }\n  exit() { const s = this.app.scene; if (s) { s.camOverride = null; if (s.stageOpts) s.stageOpts.carFixed = false; } this.cover?.removeFromParent(); for (const l of this.lights) l.release?.(); }\n  draw(ui, dt) {\n    if (!this.tl) return; this.tl.update(dt);\n    const barH = Math.round(this.tl.bars() * 22); ui.rect(0, 0, ui.w, barH, 'ink'); ui.rect(0, ui.h - barH, ui.w, barH, 'ink');\n    const l = this.tl.line(); if (l) ui.text(ui.cx, ui.h - 44, l.text, { align: 'center', scale: 2, color: 'sand' });\n    if (this.done) { this.done = false; this.o.next?.(); }\n    if (this.app.actions.pressed('confirm') && !this.o.auto) this.tl.skip();\n    ui.prompts([['confirm', 'SKIP']]);\n  }\n}\n// The credits, then the ending card in the catalogue voice.\nexport class EndingScreen {\n  constructor(app, o) { this.id = 'ending'; this.app = app; this.o = o; this.t = 0; this.noBack = true; this.defaultFocus = 'go'; }\n  enter() { const a = this.app; a.mix.music('longDrive'); a.scene.stage('map', { hour: 21 }); }\n  draw(ui, dt) {\n    this.t += dt; const rows = [TITLE, MAKER, '', 'INSPIRED BY', SOURCE.toUpperCase(), '', 'MS. ARAI, CHIEF EXAMINER', 'BENNO, MECHANIC', 'MR. FENN, DEALER', 'DELL, COMMENTATOR', '', 'BUILT ON PIXEL ENGINE 0.46.0', 'THREE.JS R186, RAPIER', 'THE SWEETIE 16 PALETTE BY GRAFXKID', '', 'THANK YOU FOR DRIVING.'], scroll = ui.h - this.t * 18;\n    ui.panel(ui.cx - 140, 0, 280, ui.h, { color: 'ink', border: false, scan: true });\n    if (scroll > -rows.length * 12 - 10) rows.forEach((r, k) => { const y = scroll + k * 12; if (y > -8 && y < ui.h - 20) ui.text(ui.cx, y, r, { align: 'center', color: k === 0 ? 'sand' : 'white' }); });\n    else { ui.text(ui.cx, 96, ENDING_LINES[0], { align: 'center', scale: 2, color: 'white' }); ui.text(ui.cx, 118, ENDING_LINES[1], { align: 'center', scale: 2, color: 'sand' }); ui.button('go', ui.cx - 50, 160, 100, 16, 'CONTINUE', { confirm: () => this.o.next() }); }\n    if (this.app.actions.pressed('confirm') && scroll > -rows.length * 12 - 10) this.t = 999;\n    ui.prompts([['confirm', scroll > -rows.length * 12 - 10 ? 'SKIP' : 'CONTINUE']]);\n  }\n}\nEOF\ncat > src/game/scenes/replay.js <<'EOF'\n// ReplayScene: plays recorded poses with the replay director. Replays never re-simulate.\nimport { THREE } from '../../pixel-engine.js';\nimport { loadTrack, carProfile } from '../sim/race.js';\nimport { tunedParams } from '../sim/tuning.js';\nimport { buildWorld } from '../render/world.js';\nimport { CarView } from '../render/carview.js';\nimport { TvDirector } from '../render/director.js';\nimport { CAM_MODES, ChaseCam } from '../render/camera.js';\nimport { F_AIR, F_BRAKE, F_LOCK, F_SLIDE } from '../sim/replaydata.js';\nimport { LINES } from '../data/text.js';\nimport { CAR_INFO } from '../data/cars.js';\nconst { Vector3 } = THREE;\nconst MODES = ['DIRECTOR', 'CHASE', 'BONNET', 'FREE'];\nexport class ReplayScene {\n  constructor(app, rec, opts = {}) { this.name = 'replay'; this.app = app; this.rec = rec; this.opts = opts; this.t = 0; this.playing = true; this.mode = 0; this.focus = rec.meta.cars.findIndex((c) => c.player === 0); if (this.focus < 0) this.focus = 0; this.views = []; this.target = new Vector3(); this.pose = {}; this.hudOn = true; this.orbit = 0.6; this.pitch = 0.3; this.dist = 9; this.dellT = 4; this.dellI = 0; }\n  async setup(ctx) {\n    const app = this.app; app.enterScene(ctx, this); app.ui.clear();\n    const cam = ctx.camera.camera; cam.near = 0.5; cam.far = 6000; cam.updateProjectionMatrix(); this.cam = cam;\n    const m = this.rec.meta, { tr, line } = loadTrack(m.track, { rain: m.rain }); this.tr = tr;\n    const f = m.cars[this.focus], p = tunedParams(f.carId, f.install);\n    this.world = buildWorld(ctx, tr, line, { hour: m.hour, rain: m.rain, speeds: carProfile(tr, line, p, f.carId, JSON.stringify(f.install ?? '')) });\n    this.views = m.cars.map((c) => { const v = new CarView(c.carId, { install: c.install, paint: c.paint ?? undefined }); ctx.scene.add(v.object); return v; });\n    this.tv = new TvDirector(tr, this.world.field, 23); this.chase = new ChaseCam(cam); this.chase.mode = 0;\n    app.mix.clearCars(); app.mix.music(this.opts.song === null ? null : 'longDrive');\n    this.night = this.world.night;\n    if (this.night > 0.15) { this.beam = new THREE.Object3D(); ctx.scene.add(this.beam); ctx.lights.request({ follow: this.beam, color: 0xfff0c0, intensity: 16, radius: 34, priority: 8, decay: 1 }); }\n    app.ui.push(new ReplayHudScreen(app, this));\n  }\n  fixedUpdate(ctx) { this.app.actions.latch(ctx); }\n  update(ctx, dt) {\n    const app = this.app, a = app.actions; a.setDt(dt); a.latch(ctx); ctx.hud.clear();\n    if (!this.world) { a.send(ctx); return; }\n    const slow = a.pads.some((p) => p.buttons[7] > 0.3) || ctx.input.isDown('ShiftLeft'), rate = slow ? 0.25 : 1;\n    if (this.playing) { this.t += dt * rate; if (this.t >= this.rec.duration) { if (this.opts.onEnd) { this.opts.onEnd(); } else this.t = 0; } }\n    this.t = Math.max(0, Math.min(this.rec.duration - 0.01, this.t));\n    const rec = this.rec, s = this.pose;\n    for (let i = 0; i < this.views.length; i++) {\n      rec.sample(i, this.t, s); const v = this.views[i], f = s.flags;\n      v.update(this.playing ? dt * rate : 0, s.x, s.y, s.z, s.yaw, s.pitch, s.roll, 0, 0, s.steer, s.u, !!(f & F_AIR));\n      v.setBrake(!!(f & F_BRAKE)); v.setHead(this.night > 0.2);\n      if (i === this.focus) { this.fx = { x: s.x, y: s.y, z: s.z, yaw: s.yaw, u: s.u, rpm: s.rpm, throttle: s.throttle, flags: f }; }\n      const near = (s.x - this.cam.position.x) ** 2 + (s.z - this.cam.position.z) ** 2 < 22000;\n      if (near && this.playing && (f & (F_SLIDE | F_LOCK)) && Math.abs(s.u) > 4) { ctx.particles.burst(this.tr.surface === 'dirt' ? 'dirtDust' : 'tyreSmoke', [s.x - Math.sin(s.yaw) * 1.2, s.y + 0.15, s.z - Math.cos(s.yaw) * 1.2]); this.world.skids.lay(`${i}`, s.x - Math.sin(s.yaw) * 1.2, s.y, s.z - Math.cos(s.yaw) * 1.2); } else this.world.skids.lift(`${i}`);\n      if (near && this.playing && this.tr.surface === 'dirt' && Math.abs(s.u) > 5 && Math.floor(this.t * 20) !== Math.floor((this.t - dt) * 20)) ctx.particles.burst('dirtDust', [s.x - Math.sin(s.yaw) * 1.2, s.y + 0.15, s.z - Math.cos(s.yaw) * 1.2], { count: 1 });\n    }\n    const F = this.fx; this.target.set(F.x, F.y + 0.9, F.z);\n    if (this.beam) this.beam.position.set(F.x + Math.sin(F.yaw) * 12, F.y + 1.6, F.z + Math.cos(F.yaw) * 12);\n    // Camera modes: Director, Chase, Bonnet, Free.\n    const name = MODES[this.mode], i0 = this.nearestIdx(F.x, F.z), fv = this.views[this.focus];\n    fv.object.visible = name !== 'BONNET';\n    if (name === 'DIRECTOR') {\n      const anySlide = !!(F.flags & (F_SLIDE | F_LOCK));\n      const cut = this.tv.update(dt, { x: F.x, y: F.y, z: F.z, s: i0 * this.tr.ds }, this.cam, { busy: anySlide });\n      if (cut && anySlide) this.tv.cutT = Math.min(this.tv.cutT, 5);\n    } else if (name === 'FREE') {\n      let dx = 0, dy = 0; if (ctx.input.isDown('MouseLeft') || ctx.input.isDown('MouseRight')) { dx = (ctx.input.mouseDelta.x ?? 0) * 0.01; dy = (ctx.input.mouseDelta.y ?? 0) * 0.008; } for (const p of a.pads) { if (Math.abs(p.axes[2]) > 0.15) dx += p.axes[2] * dt * 2; if (Math.abs(p.axes[3]) > 0.15) dy += p.axes[3] * dt * 1.5; }\n      this.orbit += dx; this.pitch = Math.max(0.03, Math.min(1.4, this.pitch + dy)); if (a.wheel) this.dist = Math.max(3.5, Math.min(40, this.dist + Math.sign(a.wheel) * 1.2));\n      this.cam.position.set(F.x + Math.sin(this.orbit) * Math.cos(this.pitch) * this.dist, F.y + 0.8 + Math.sin(this.pitch) * this.dist, F.z + Math.cos(this.orbit) * Math.cos(this.pitch) * this.dist); this.cam.lookAt(this.target); if (this.cam.fov !== 48) { this.cam.fov = 48; this.cam.updateProjectionMatrix(); }\n    } else { this.chase.mode = name === 'BONNET' ? 2 : 0; this.chase.update(dt, F, {}); }\n    this.world.update(this.playing ? dt * rate : 0, ctx.time, false, this.target, i0 * this.tr.ds);\n    // Sound: the focus car, at a distance that follows the camera.\n    if (this.playing) { const d = this.cam.position.distanceTo(this.target), g = name === 'DIRECTOR' ? Math.max(0.12, Math.min(1, 30 / Math.max(10, d))) : 1, car = rec.meta.cars[this.focus]; if (!this.pCache) this.pCache = rec.meta.cars.map((c) => tunedParams(c.carId, c.install)); app.mix.engines([{ key: `${this.focus}:${car.carId}`, carId: car.carId, p: this.pCache[this.focus], rpm: F.rpm, throttle: F.throttle, spool: 0.5, gain: g, pan: 0 }], dt); this.dellT -= dt; if (this.dellT <= 0) { this.dellT = 7 + (this.dellI % 3) * 2; const l = LINES.dell.replay[this.dellI++ % LINES.dell.replay.length]; app.ui.say('dell', l, 4); } } else app.mix.quiet();\n    app.ui.frame(ctx, dt); app.afterFrame(ctx, dt);\n    a.send(ctx);\n  }\n  nearestIdx(x, z) { const tr = this.tr; let best = this.lastI ?? 0, bd = Infinity; const c = this.lastI ?? 0; for (let k = -30; k <= 30; k++) { const i = (c + k + tr.N) % tr.N, d = (tr.x[i] - x) ** 2 + (tr.z[i] - z) ** 2; if (d < bd) { bd = d; best = i; } } if (this.lastI === undefined || bd > 2500) { for (let i = 0; i < tr.N; i += 2) { const d = (tr.x[i] - x) ** 2 + (tr.z[i] - z) ** 2; if (d < bd) { bd = d; best = i; } } } this.lastI = best; return best; }\n  cameraTarget() { return this.target; }\n  status() { return `replay ${this.rec.meta.track} ${this.t.toFixed(1)}/${this.rec.duration.toFixed(1)} ${MODES[this.mode]}`; }\n  dispose() { if (this.app.scene === this) this.app.scene = null; this.app.mix.clearCars(); }\n}\nclass ReplayHudScreen {\n  constructor(app, scene) { this.id = 'replay'; this.app = app; this.scene = scene; this.inputOff = false; this.noBox = true; }\n  draw(ui, dt) {\n    const a = this.app.actions, s = this.scene, app = this.app, ctx = app.ctx, N = s.views.length;\n    if (a.pressed('confirm')) { s.playing = !s.playing; app.mix.sfx('tick'); }\n    const dx = a.moveX(); if (dx) { s.t += dx * 3; app.mix.sfx('tick'); }\n    if (a.pressed('tabL')) { s.focus = (s.focus - 1 + N) % N; s.tv.force(); app.mix.sfx('tick'); s.pCache && 0; }\n    if (a.pressed('tabR')) { s.focus = (s.focus + 1) % N; s.tv.force(); app.mix.sfx('tick'); }\n    if (a.pressed('info')) { s.mode = (s.mode + 1) % MODES.length; s.chase.snap(); app.mix.sfx('tick'); }\n    if (a.pressed('alt') || ctx.input.wasPressed('KeyH')) s.hudOn = !s.hudOn;\n    // Mouse: click a car to focus it.\n    if (a.clicked) { const p = ctx.input.pointer, o = new THREE.Vector3(), d = new THREE.Vector3(); ctx.camera.rayAt(p.x, p.y, o, d); let best = 7, bi = -1; s.views.forEach((v, i) => { const q = v.object.position.clone().sub(o), t = q.dot(d), d2 = q.lengthSq() - t * t; if (t > 0 && d2 < best) { best = d2; bi = i; } }); if (bi >= 0) { s.focus = bi; s.tv.force(); } }\n    if (!s.hudOn) return;\n    // Bars and a small tag.\n    ui.rect(0, 0, ui.w, 12, 'ink'); ui.rect(0, ui.h - 28, ui.w, 28, 'ink');\n    ui.text(6, 3, 'REPLAY', { color: Math.floor(ui.time * 2) % 2 ? 'red' : 'white' }); ui.text(50, 3, MODES[s.mode], { color: 'mist' }); const car = s.rec.meta.cars[s.focus]; ui.text(ui.w - 6, 3, `${car.name}  ${CAR_INFO[car.carId].short}`, { align: 'right', color: 'sand' });\n    ui.bar(6, ui.h - 25, ui.w - 12, 3, s.t / s.rec.duration, 'sand', 'night');\n    ui.text(ui.cx, 3, `${Math.round(Math.abs(s.fx?.u ?? 0) * 3.6)} KM/H`, { align: 'center', color: 'white' });\n    if (!s.playing) ui.text(ui.cx, 30, 'PAUSED', { align: 'center', scale: 2, color: 'sand' });\n    ui.prompts([['play', s.playing ? 'PAUSE' : 'PLAY'], ['scrub', 'SCRUB'], ['focus', 'CAR'], ['info', 'CAMERA'], ['slow', 'SLOW'], ['alt', 'HIDE'], ['back', 'EXIT']]);\n    void CAM_MODES; void dt;\n  }\n  onBack() { const s = this.scene; s.opts.after?.(); return true; }\n}\nEOF\ncat > src/game/flows.js <<'EOF'\n// The glue between screens and scenes: starting a drive, what happens after it, and where it returns to.\nimport { RaceScene } from './scenes/race.js';\nimport { MenuScene } from './scenes/menu.js';\nimport { ReplayScene } from './scenes/replay.js';\nimport { TESTS, LICENCES } from './data/licences.js';\nimport { EVENTS } from './data/events.js';\nimport { CAR_INFO } from './data/cars.js';\nimport { LINES } from './data/text.js';\nimport { carEntry, driveCar, eventState, oilOf, recordFailure, recordLap, recordRound, recordTest } from './sim/career.js';\nimport { couchSetup, eventSetup, quickSetup, testDriveSetup, trialSetup } from './sim/setups.js';\nimport { legCount, testSetup } from './sim/licence.js';\nimport { formatTime } from './sim/race.js';\nimport { GhostTrace, Recording } from './sim/replaydata.js';\nimport { PauseScreen } from './ui/screens/pause.js';\nimport { MapScreen } from './ui/screens/map.js';\nimport { LicenceListScreen, TestListScreen, TestCardScreen, TestResultScreen } from './ui/screens/licence.js';\nimport { EventCardScreen, EventListScreen, RoundCardScreen } from './ui/screens/events.js';\nimport { DealerScreen } from './ui/screens/dealer.js';\nimport { PartsScreen, TuningScreen } from './ui/screens/tuning.js';\nimport { GarageScreen } from './ui/screens/garage.js';\nimport { TheatreScreen } from './ui/screens/theatre.js';\nimport { ArcadeScreen } from './ui/screens/arcade.js';\nimport { ResultsScreen } from './ui/screens/results.js';\nimport { EndingScreen, PodiumScreen, PrizeScreen } from './ui/screens/cinema.js';\nimport { startCouchEngine, stopCouchEngine } from './net/couch.js';\nimport { DevPanel } from './dev/devmode.js';\nvoid Recording;\nexport function installFlows(app) {\n  const seed = () => { app.seedN = (app.seedN ?? 0) + 1; return (Date.now() % 100000) + app.seedN; };\n  const toMenu = (start) => app.go(() => new MenuScene(app, { start }));\n  app.toMenu = toMenu;\n  const mapThen = (...list) => (ui) => { ui.push(new MapScreen(app)); for (const fn of list) ui.push(fn()); };\n  const assists = () => ({ ...app.options.assists });\n  app.toTitle = () => { app.engine.timeScale = 1; return toMenu(null); };\n  app.factory.pause = (scene) => app.ui.push(new PauseScreen(app, scene));\n  app.openDev = (scene) => app.ui.push(new DevPanel(app, scene));\n  // ---- Licence tests ----\n  app.startTest = (id, o = {}) => {\n    const test = TESTS[id], leg = o.leg ?? 0;\n    const setup = { ...testSetup(test, leg, assists()), seed: seed() };\n    return app.go(() => new RaceScene(app, setup, { test, demo: !!o.demo, showLine: !!app.lineForTest || (app.profile.tests[id]?.fails ?? 0) >= 3 && app.lineForTest, legBase: o.legBase ?? 0, run: { type: 'licence', id, demo: !!o.demo } }));\n  };\n  app.factory.testFinished = (scene) => {\n    const J = scene.judge, test = scene.test, demo = !!scene.opts.demo, id = test.id, base = scene.opts.legBase ?? 0, total = J.total + base, leg = scene.leg;\n    app.lastRace = scene.sim.rec;\n    if (J.status === 'pass' && leg + 1 < legCount(test)) { return app.startTest(id, { demo, leg: leg + 1, legBase: total }); }\n    const o = { test, failed: J.status !== 'pass', reason: J.reason, time: total, demo };\n    if (demo) { o.medal = null; app.ui.push(new TestResultScreen(app, { ...o, failed: false, reason: '', demoShown: true, time: total })); return; }\n    if (J.status !== 'pass') { if (!app.devActive()) recordFailure(app.profile, id); }\n    else if (app.devActive()) { o.notSaved = true; }\n    else { const r = recordTest(app.profile, id, total); o.medal = r.medal; o.licenceWon = r.licenceWon; o.reward = r.reward; o.prizeCar = r.prizeCar; o.allGold = r.allGold; if (!r.medal) o.failed = false; }\n    if (!o.failed) o.next = o.medal === 'gold' ? null : o.medal === 'silver' ? 'gold' : o.medal === 'bronze' ? 'silver' : 'bronze';\n    app.save();\n    if (o.licenceWon) app.ui.note(LINES.arai.licence);\n    app.ui.push(new TestResultScreen(app, o));\n  };\n  app.backToTests = (id, o = {}) => {\n    const lic = TESTS[id].licence;\n    return toMenu((ui) => {\n      ui.push(new MapScreen(app)); ui.push(new LicenceListScreen(app)); ui.push(new TestListScreen(app, lic));\n      if (o.prizeCar) ui.push(new PrizeScreen(app, { carId: o.prizeCar, line: LICENCES[lic].allGold?.text, next: () => ui.pop() }));\n    });\n  };\n  app.afterTestReplay = (o) => app.go(() => new MenuScene(app, { start: (ui) => { ui.push(new MapScreen(app)); ui.push(new LicenceListScreen(app)); ui.push(new TestListScreen(app, o.test.licence)); ui.push(new TestCardScreen(app, o.test.id)); } }));\n  // ---- Events ----\n  app.startEventRound = (id) => {\n    const setup = eventSetup(app.profile, id, assists(), seed());\n    return app.go(() => new RaceScene(app, setup, { run: { type: 'event', id } }));\n  };\n  app.factory.raceFinished = (scene) => {\n    const sim = scene.sim, kind = scene.data.kind, me = sim.cars.find((e) => e.player === 0), run = scene.run ?? {};\n    app.lastRace = sim.rec; const rows = sim.results();\n    const car = carEntry(app.profile);\n    if (kind === 'testdrive') return app.returnFromTestDrive(run);\n    const record = !app.devActive() && me?.bestLap ? recordLap(app.profile, sim.tr.id, me.bestLap, me.carId) : false;\n    const o = { kind, rows, track: sim.tr.id, best: me?.bestLap ?? null, bestText: me?.bestLap ? formatTime(me.bestLap) : '', record, seed: scene.data.seed, run };\n    if (kind === 'race' || kind === 'rally') {\n      app.undo = JSON.stringify(app.profile);\n      if (car && me) driveCar(app.profile, car, me.metres, me.dirtM);\n      const names = rows.map((r) => r.name), r = recordRound(app.profile, run.id, names, 'YOU', app.prizeMult ?? 1);\n      Object.assign(o, { title: EVENTS[run.id].name, prize: r.prize, points: r.points, showPoints: kind === 'race', round: r });\n      if (r.seriesDone) { o.seriesWon = r.seriesWon; o.seriesLine = r.seriesWon ? `THE SERIES IS YOURS. ${r.bonus ? `BONUS ${r.bonus.toLocaleString('en-US')} CR.` : ''}${r.prizeCar ? ` PRIZE: ${CAR_INFO[r.prizeCar].short}.` : ''}` : 'THE SERIES GOES TO ANOTHER DRIVER. YOU MAY ENTER AGAIN.'; }\n      else o.seriesLine = `ROUND ${eventState(app.profile, run.id).round + 1} OF ${EVENTS[run.id].rounds.length} IS NEXT.`;\n      if (me?.pos === 1 && sim.tr.id === 'harbour') scene.fireworksOn = true;\n      app.save();\n    } else if (kind === 'couch') { stopCouchEngine(app); o.title = 'THE DUEL'; o.retry = true; }\n    else { o.title = kind === 'timetrial' ? 'TIME TRIAL' : 'QUICK RACE'; if (me?.pos === 1 && sim.tr.id === 'harbour') scene.fireworksOn = true; }\n    app.ui.push(new ResultsScreen(app, o));\n  };\n  app.resultsContinue = (o) => {\n    const k = o.kind;\n    if (k === 'race' || k === 'rally') {\n      const r = o.round, id = o.run.id;\n      if (r.seriesDone && r.seriesWon) return app.ceremony(id, r);\n      if (r.seriesDone) return toMenu(mapThen(() => new EventListScreen(app), () => new EventCardScreen(app, id)));\n      return toMenu(mapThen(() => new EventListScreen(app), () => new EventCardScreen(app, id), () => new RoundCardScreen(app, id)));\n    }\n    return toMenu(mapThen(() => new ArcadeScreen(app)));\n  };\n  app.ceremony = (id, r) => {\n    const car = carEntry(app.profile), finish = (ui) => { ui.clear(); ui.push(new MapScreen(app)); };\n    return toMenu((ui) => {\n      ui.push(new MapScreen(app));\n      const afterPrize = () => { if (r.ending) { ui.pop(); ui.push(new EndingScreen(app, { next: () => finish(ui) })); } else finish(ui); };\n      const toPrize = () => { ui.pop(); if (r.prizeCar) ui.push(new PrizeScreen(app, { carId: r.prizeCar, next: afterPrize })); else afterPrize(); };\n      ui.push(new PodiumScreen(app, { eventId: id, carId: car?.carId ?? 'kite', install: car?.install, next: toPrize, line: LINES.dell.win[0].replace('{TRACK}', 'THE PENINSULA').replace('{NAME}', 'THE DRIVER') }));\n    });\n  };\n  app.resultsRetry = (o) => {\n    const k = o.kind;\n    if (k === 'race' || k === 'rally') { if (app.undo) { app.profile = JSON.parse(app.undo); app.save(); } return app.startEventRound(o.run.id); }\n    return app.runAgain?.();\n  };\n  // ---- Arcade ----\n  app.startQuick = (p) => { app.runAgain = () => app.startQuick(p); const setup = quickSetup({ ...p, assists: assists(), seed: seed(), poolIds: Object.keys(CAR_INFO).filter((c) => c !== 'type9' || p.carId === 'type9').slice(0, 13) }); return app.go(() => new RaceScene(app, setup, { run: { type: 'quick' } })); };\n  app.startTimeTrial = (p) => { app.runAgain = () => app.startTimeTrial(p); const key = `${p.track}:${p.carId}`, setup = trialSetup({ ...p, assists: assists(), seed: seed() }); return app.go(() => new RaceScene(app, setup, { run: { type: 'trial', key }, ghostData: app.profile.ghosts[key] ?? null })); };\n  app.lapDone = (scene, trace, time) => { // Time trial: the best lap becomes the ghost.\n    const run = scene.run; if (run?.type !== 'trial') return;\n    const key = run.key, cur = app.profile.ghosts[key], isBest = !cur || time < cur.time; if (!isBest || app.devActive()) { if (scene.ghost) scene.traceStart = scene.sim.time; return; }\n    const data = trace.toData(time, scene.sim.cars[0].carId); app.profile.ghosts[key] = data; recordLap(app.profile, scene.sim.tr.id, time, scene.sim.cars[0].carId); app.save(); scene.setGhost(app.ctx, data); scene.hud.flash('A NEW GHOST: YOUR BEST', 3); scene.traceStart = scene.sim.time; void GhostTrace;\n  };\n  app.startCouch = (p) => { app.runAgain = () => app.startCouch(p); const setup = couchSetup({ ...p, assists: assists(), seed: seed() }); app.actions.couch = true; return app.go(() => new RaceScene(app, setup, { compact: true, run: { type: 'couch' }, onReady: (scene) => startCouchEngine(app, scene, setup) })); };\n  // ---- Test drive: one lap of the Proving Ground ----\n  app.startTestDrive = (carId, install, from) => { const car = from.uid ? carEntry(app.profile, from.uid) : null, setup = testDriveSetup({ carId, install, assists: assists(), paint: install?.paint ?? undefined, seed: seed(), oil: car ? oilOf(car) : 1 }); return app.go(() => new RaceScene(app, setup, { run: { type: 'testdrive', from } })); };\n  app.returnFromTestDrive = (run) => { const f = run.from ?? {}; return toMenu((ui) => { ui.push(new MapScreen(app)); if (f.from === 'dealer') { const d = new DealerScreen(app, { first: f.first && !app.profile.cars.length }); d.room = f.room; d.car = f.car; ui.push(d); } else if (f.from === 'parts') { ui.push(new TuningScreen(app)); ui.push(new PartsScreen(app, f.tile)); } else if (f.from === 'tuning') ui.push(new TuningScreen(app)); }); };\n  // ---- Restart and retire, from the pause menu ----\n  app.restartRun = (scene) => {\n    const run = scene.run ?? {}; app.ui.clear(); stopCouchEngine(app);\n    if (run.type === 'licence') return app.startTest(run.id, { demo: run.demo });\n    if (run.type === 'event') return app.startEventRound(run.id);\n    if (run.type === 'testdrive') { const m = scene.data.cars[scene.data.cars.length - 1]; return app.startTestDrive(m.carId, m.install, run.from); }\n    if (scene.opts.attract) return null;\n    return app.runAgain?.();\n  };\n  app.retireRun = (scene) => {\n    const run = scene.run ?? {}, sim = scene.sim; scene.ended = true; stopCouchEngine(app);\n    if (run.type === 'licence') { const t = TESTS[run.id]; if (!run.demo && !app.devActive()) { recordFailure(app.profile, run.id); app.save(); } return app.backToTests(t.id); }\n    if (run.type === 'testdrive') return app.returnFromTestDrive(run);\n    if (run.type === 'event') { for (const e of sim.players) sim.retire(e.i); sim.updateOrder(); app.factory.raceFinished(scene); return null; }\n    return toMenu(mapThen(() => new ArcadeScreen(app)));\n  };\n  // ---- Replays ----\n  app.watchReplay = ({ after }) => { if (!app.lastRace || !app.lastRace.frames) { app.ui.note('THERE IS NOTHING TO WATCH.'); return null; } return app.go(() => new ReplayScene(app, app.lastRace, { after })); };\n  app.afterResultsReplay = (o) => app.resultsContinue(o);\n  app.watchRecording = (rec, { after }) => app.go(() => new ReplayScene(app, rec, { after: after === 'theatre' ? () => toMenu(mapThen(() => new TheatreScreen(app))) : after }));\n  app.watchSaved = (k, { after }) => { const z = app.profile.replays[k]; if (!z) return null; const rec = Recording.fromCompressed(z); return app.watchRecording(rec, { after }); };\n  app.saveReplay = (k) => { if (!app.lastRace) return false; const prev = app.profile.replays[k], z = app.lastRace.compress(); z.day = app.profile.day; app.profile.replays[k] = z; if (!app.save()) { app.profile.replays[k] = prev; return false; } return true; };\n  app.openGarageFromEvent = (ui) => ui.push(new GarageScreen(app, { onChoose: (u) => { u.note('YOUR RIDE IS CHOSEN.'); } }));\n  app.openTuningFromEvent = (ui) => ui.push(new TuningScreen(app));\n}\nEOF\ncat > src/game/net/couch.js <<'EOF'\n// Couch Duel: two players, one TV. The page becomes two side-by-side containers and a second engine draws the shared sim.\nimport { Engine } from '../../pixel-engine.js';\nimport { RaceScene } from '../scenes/race.js';\nexport function engineOptionsFor(container) { return { container, camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false, key: false }, touch: false, seed: 1 }; }\nexport async function startCouchEngine(app, mainScene, setup) {\n  if (typeof document === 'undefined') return null; // headless tools draw one side\n  const p1 = document.getElementById('p1'), p2 = document.getElementById('p2');\n  if (!p1 || !p2) return null;\n  p1.style.width = p2.style.width = '50vw'; p2.style.display = 'block';\n  const scene = new RaceScene(app, setup, { role: 'view', sim: mainScene.sim, viewPlayer: 1, compact: true });\n  const e2 = await Engine.start(scene, engineOptionsFor(p2));\n  e2.audio.persist = false; e2.audio.setMuted(true); e2.input.gamepadButtons = {};\n  app.engine2 = e2; app.couchScene = scene;\n  // Keep the first engine's handle: __PIXEL_ENGINE__ now holds the last one started.\n  if (typeof window !== 'undefined') window.__PIXEL_ENGINE__ = app.engine;\n  return e2;\n}\nexport function stopCouchEngine(app) {\n  app.actions.couch = false;\n  if (!app.engine2) return;\n  try { app.engine2.dispose(); } catch { /* it was on its way out */ }\n  app.engine2 = null; app.couchScene = null;\n  if (typeof document !== 'undefined') { const p1 = document.getElementById('p1'), p2 = document.getElementById('p2'); if (p2) p2.style.display = 'none'; if (p1) p1.style.width = '100vw'; }\n}\nEOF\npython3 - <<'EOF'\np='src/game/sim/licence.js'; s=open(p).read()\na=\"  const carId = legCar(test, leg), dummy = new RaceSim({ track: test.track, cars: [], record: false }), tr = dummy.tr;\\n\"\nb=\"  const carId = legCar(test, leg), { tr } = loadTrack(test.track);\\n\"\nassert a in s; s=s.replace(a,b)\ns=s.replace(\"import { indexOfS, RaceSim, trackPoint, wrapS } from './race.js';\",\"import { indexOfS, loadTrack, RaceSim, trackPoint, wrapS } from './race.js';\")\nopen(p,'w').write(s)\nEOF\nsed -i 's/^6\\. Menu world: IN PROGRESS.*/6-7. Menu world and career screens: written (scenes\\/menu.js, scenes\\/replay.js, flows.js, ui\\/screens\\/*). Not yet run. Next: dev\\/devmode.js, attract\\/director.js, net\\/hub.js, main.js full boot, data suite, headless suite, play suite./' ../PROGRESS.md; echo ok","description":"Write pause, results, ceremonies, replay scene, flows and couch engine"}}}
