{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkkj4pd8L1LTGjw8yWwQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MNvfQzJLxKbogjZZC3EQ9V","name":"Bash","input":{"command":"cat > src/game/models/clips.js <<'EOF'\n// New animations, authored as ClipDef data on the engine's hero rig. analyzeClip checks them in the headless suite.\nconst rest = () => ({ Pelvis: { r: [0, 0, 0], p: [0, 0, 0], s: 1 }, Torso: [0, 0, 0], Head: [0, 0, 0], ArmR: [4, 0, -8], ForearmR: [-18, 0, 0], HandR: [0, 0, 0], ArmL: [4, 0, 8], ForearmL: [-18, 0, 0], HandL: [0, 0, 0], LegR: [0, 0, 0], ShinR: [0, 0, 0], FootR: [0, 0, 0], LegL: [0, 0, 0], ShinL: [0, 0, 0], FootL: [0, 0, 0] });\nconst pose = (o) => ({ ...rest(), ...o });\nconst crouch = (o = {}) => pose({ Pelvis: { r: [18, 0, 0], p: [0, -0.34, 0.02], s: 1 }, Torso: [24, 0, 0], Head: [-22, 0, 0], LegR: [-74, 0, 0], ShinR: [96, 0, 0], FootR: [-30, 0, 0], LegL: [-74, 0, 0], ShinL: [96, 0, 0], FootL: [-30, 0, 0], ...o });\nconst kneel = (o = {}) => pose({ Pelvis: { r: [6, 0, 0], p: [0, -0.42, 0], s: 1 }, Torso: [28, 0, 0], Head: [-20, 0, 0], LegR: [-84, 0, 0], ShinR: [84, 0, 0], FootR: [0, 0, 0], LegL: [8, 0, 0], ShinL: [112, 0, 0], FootL: [30, 0, 0], ...o });\nexport const GAME_CLIPS = [\n  { name: 'PitJack', frames: 40, loop: true, keys: [[0, crouch({ ArmR: [-70, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-30, 0, 0] })], [20, crouch({ Pelvis: { r: [26, 0, 0], p: [0, -0.4, 0.04], s: 1 }, Torso: [44, 0, 0], ArmR: [-36, 0, -10], ForearmR: [-12, 0, 0], ArmL: [-36, 0, 10], ForearmL: [-12, 0, 0] })], [40, crouch({ ArmR: [-70, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-30, 0, 0] })]], notes: 'Crouch and pump a jack lever.' },\n  { name: 'PitWheelGun', frames: 120, loop: true, keys: [\n    [0, kneel({ ArmR: [-76, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-60, 0, 8], ForearmL: [-40, 0, 0] })],\n    [20, kneel({ Torso: [34, 6, 0], ArmR: [-82, 0, -4], ForearmR: [-8, 0, 0], ArmL: [-60, 0, 8], ForearmL: [-40, 0, 0] })],\n    [45, kneel({ Torso: [22, -18, 0], ArmR: [-50, 0, -30], ForearmR: [-60, 0, 0], ArmL: [-50, 0, 30], ForearmL: [-60, 0, 0] })],\n    [75, kneel({ Torso: [34, 16, 0], ArmR: [-80, 0, -24], ForearmR: [-40, 0, 0], ArmL: [-80, 0, 24], ForearmL: [-40, 0, 0] })],\n    [100, kneel({ Torso: [34, 6, 0], ArmR: [-82, 0, -4], ForearmR: [-8, 0, 0], ArmL: [-60, 0, 8], ForearmL: [-40, 0, 0] })],\n    [120, kneel({ ArmR: [-76, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-60, 0, 8], ForearmL: [-40, 0, 0] })]], notes: 'Kneel, gun to the hub, pull a wheel, fit a wheel.' },\n  { name: 'PitFuel', frames: 60, loop: true, grounded: true, keys: [[0, pose({ Pelvis: { r: [0, 12, 0], p: [0, -0.04, 0], s: 1 }, Torso: [10, 10, 0], ArmR: [-74, 8, -8], ForearmR: [-16, 0, 0], ArmL: [-62, -6, 14], ForearmL: [-30, 0, 0], LegR: [-10, 0, 0], ShinR: [18, 0, 0], FootR: [-8, 0, 0], LegL: [-16, 0, 0], ShinL: [24, 0, 0], FootL: [-8, 0, 0] })], [30, pose({ Pelvis: { r: [0, 12, 0], p: [0, -0.06, 0], s: 1 }, Torso: [13, 12, 0], Head: [8, -10, 0], ArmR: [-74, 8, -8], ForearmR: [-16, 0, 0], ArmL: [-62, -6, 14], ForearmL: [-30, 0, 0], LegR: [-12, 0, 0], ShinR: [22, 0, 0], FootR: [-10, 0, 0], LegL: [-18, 0, 0], ShinL: [28, 0, 0], FootL: [-10, 0, 0] })], [60, pose({ Pelvis: { r: [0, 12, 0], p: [0, -0.04, 0], s: 1 }, Torso: [10, 10, 0], ArmR: [-74, 8, -8], ForearmR: [-16, 0, 0], ArmL: [-62, -6, 14], ForearmL: [-30, 0, 0], LegR: [-10, 0, 0], ShinR: [18, 0, 0], FootR: [-8, 0, 0], LegL: [-16, 0, 0], ShinL: [24, 0, 0], FootL: [-8, 0, 0] })]], notes: 'Hold a fuel hose to the flank.' },\n  { name: 'MarshalFlag', frames: 40, loop: true, grounded: true, keys: [[0, pose({ ArmR: [-170, 0, -12], ForearmR: [-14, 0, 0], Torso: [0, 0, 5], Head: [-6, 0, 0] })], [10, pose({ ArmR: [-150, 0, -40], ForearmR: [-18, 0, 0], Torso: [0, 0, 9], Head: [-6, 0, 0] })], [20, pose({ ArmR: [-170, 0, -12], ForearmR: [-14, 0, 0], Torso: [0, 0, 5], Head: [-6, 0, 0] })], [30, pose({ ArmR: [-168, 0, 16], ForearmR: [-12, 0, 0], Torso: [0, 0, 1], Head: [-6, 0, 0] })], [40, pose({ ArmR: [-170, 0, -12], ForearmR: [-14, 0, 0], Torso: [0, 0, 5], Head: [-6, 0, 0] })]], notes: 'Wave a flag overhead; the flag mesh is parented to the hand.' },\n  { name: 'ExaminerClipboard', frames: 150, loop: true, grounded: true, keys: [\n    [0, pose({ ArmR: [-64, 0, 14], ForearmR: [-70, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [18, 0, 0] })],\n    [40, pose({ ArmR: [-68, 12, 8], ForearmR: [-86, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [22, 8, 0] })],\n    [60, pose({ ArmR: [-60, -6, 18], ForearmR: [-66, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [20, -4, 0] })],\n    [90, pose({ ArmR: [-44, 0, 8], ForearmR: [-60, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [-6, 0, 0] })],\n    [105, pose({ ArmR: [-44, 0, 8], ForearmR: [-60, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [14, 0, 0] })],\n    [120, pose({ ArmR: [-44, 0, 8], ForearmR: [-60, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [-4, 0, 0] })],\n    [150, pose({ ArmR: [-64, 0, 14], ForearmR: [-70, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [18, 0, 0] })]], notes: 'Note something, look up, nod.' },\n  { name: 'DealerPresent', frames: 90, loop: true, grounded: true, keys: [\n    [0, pose({ ArmR: [8, 0, -8], ForearmR: [-40, 0, 0], ArmL: [8, 0, 8], ForearmL: [-40, 0, 0] })],\n    [28, pose({ Torso: [4, 18, 0], Head: [-2, 20, 0], ArmL: [-62, 30, 42], ForearmL: [-10, 0, 0], HandL: [-16, 0, 0], ArmR: [8, 0, -8], ForearmR: [-40, 0, 0] })],\n    [62, pose({ Torso: [4, 22, 0], Head: [-2, 26, 0], ArmL: [-68, 58, 34], ForearmL: [-8, 0, 0], HandL: [-16, 0, 0], ArmR: [8, 0, -8], ForearmR: [-40, 0, 0] })],\n    [90, pose({ ArmR: [8, 0, -8], ForearmR: [-40, 0, 0], ArmL: [8, 0, 8], ForearmL: [-40, 0, 0] })]], notes: 'An open-handed sweep toward the car.' },\n  { name: 'MechanicWipe', frames: 80, loop: true, grounded: true, keys: [\n    [0, pose({ ArmR: [-50, 0, 18], ForearmR: [-76, 0, 0], ArmL: [-50, 0, -18], ForearmL: [-76, 0, 0], Head: [16, 0, 0] })],\n    [20, pose({ ArmR: [-46, 0, 24], ForearmR: [-84, 0, 0], ArmL: [-54, 0, -24], ForearmL: [-68, 0, 0], Head: [16, 4, 0] })],\n    [40, pose({ ArmR: [-54, 0, 12], ForearmR: [-68, 0, 0], ArmL: [-46, 0, -12], ForearmL: [-84, 0, 0], Head: [16, -4, 0] })],\n    [60, pose({ ArmR: [-46, 0, 20], ForearmR: [-80, 0, 0], ArmL: [-50, 0, -20], ForearmL: [-72, 0, 0], Head: [2, 20, 0] })],\n    [80, pose({ ArmR: [-50, 0, 18], ForearmR: [-76, 0, 0], ArmL: [-50, 0, -18], ForearmL: [-76, 0, 0], Head: [16, 0, 0] })]], notes: 'Wipe hands on a rag, look at the car.' },\n  { name: 'PodiumCheer', frames: 40, loop: true, fast: true, keys: [\n    [0, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.1, 0], s: 1 }, ArmR: [-168, 0, -24], ForearmR: [-8, 0, 0], ArmL: [-168, 0, 24], ForearmL: [-8, 0, 0], LegR: [-24, 0, 0], ShinR: [40, 0, 0], FootR: [-16, 0, 0], LegL: [-24, 0, 0], ShinL: [40, 0, 0], FootL: [-16, 0, 0], Head: [-14, 0, 0] })],\n    [20, pose({ Pelvis: { r: [0, 0, 0], p: [0, 0.24, 0], s: 1 }, ArmR: [-178, 0, -10], ForearmR: [-4, 0, 0], ArmL: [-178, 0, 10], ForearmL: [-4, 0, 0], LegR: [-8, 0, 0], ShinR: [18, 0, 0], FootR: [20, 0, 0], LegL: [-8, 0, 0], ShinL: [18, 0, 0], FootL: [20, 0, 0], Head: [-20, 0, 0] })],\n    [40, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.1, 0], s: 1 }, ArmR: [-168, 0, -24], ForearmR: [-8, 0, 0], ArmL: [-168, 0, 24], ForearmL: [-8, 0, 0], LegR: [-24, 0, 0], ShinR: [40, 0, 0], FootR: [-16, 0, 0], LegL: [-24, 0, 0], ShinL: [40, 0, 0], FootL: [-16, 0, 0], Head: [-14, 0, 0] })]], notes: 'Arms up, small jump.' },\n  { name: 'PodiumBow', frames: 80, loop: true, grounded: true, keys: [\n    [0, pose({ ArmR: [4, 0, -6], ArmL: [4, 0, 6] })],\n    [24, pose({ Pelvis: { r: [28, 0, 0], p: [0, -0.02, -0.04], s: 1 }, Torso: [30, 0, 0], Head: [12, 0, 0], ArmR: [-8, 0, -6], ArmL: [-8, 0, 6] })],\n    [50, pose({ Pelvis: { r: [28, 0, 0], p: [0, -0.02, -0.04], s: 1 }, Torso: [30, 0, 0], Head: [12, 0, 0], ArmR: [-8, 0, -6], ArmL: [-8, 0, 6] })],\n    [80, pose({ ArmR: [4, 0, -6], ArmL: [4, 0, 6] })]], notes: 'A formal bow.' },\n  { name: 'CrowdCheer', frames: 24, loop: true, grounded: true, keys: [\n    [0, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.02, 0], s: 1 }, ArmR: [-150, 0, -14], ForearmR: [-20, 0, 0], ArmL: [-40, 0, 20], ForearmL: [-60, 0, 0], LegR: [-6, 0, 0], ShinR: [10, 0, 0], FootR: [-4, 0, 0], LegL: [-6, 0, 0], ShinL: [10, 0, 0], FootL: [-4, 0, 0] })],\n    [12, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.07, 0], s: 1 }, ArmR: [-168, 0, -6], ForearmR: [-10, 0, 0], ArmL: [-50, 0, 24], ForearmL: [-70, 0, 0], LegR: [-14, 0, 0], ShinR: [24, 0, 0], FootR: [-10, 0, 0], LegL: [-14, 0, 0], ShinL: [24, 0, 0], FootL: [-10, 0, 0] })],\n    [24, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.02, 0], s: 1 }, ArmR: [-150, 0, -14], ForearmR: [-20, 0, 0], ArmL: [-40, 0, 20], ForearmL: [-60, 0, 0], LegR: [-6, 0, 0], ShinR: [10, 0, 0], FootR: [-4, 0, 0], LegL: [-6, 0, 0], ShinL: [10, 0, 0], FootL: [-4, 0, 0] })]], notes: 'A looping bob for the crowd stand-ins.' },\n];\nEOF\ncat > src/game/render/people.js <<'EOF'\n// People are the engine's hero, recoloured by swapping mesh materials by name. Overalls, suits, and the four of the cast.\nimport { compileClips, HERO_CLIPS, HERO_MODEL, HERO_RIG, PALETTE, setLookLayer, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { GAME_CLIPS } from '../models/clips.js';\nconst { AnimationMixer, BoxGeometry, Mesh } = THREE;\nconst LOOKS = {\n  arai: { shirt: 'navy', legs: 'navy', hat: 'ink', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'sand' },\n  benno: { shirt: 'orange', legs: 'orange', hat: 'night', shoes: 'ink', face: 'sand', gloves: 'slate' },\n  fenn: { shirt: 'white', legs: 'night', hat: 'night', shoes: 'plum', face: 'sand', gloves: 'sand' },\n  dell: { shirt: 'teal', legs: 'slate', hat: 'teal', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'sand' },\n  crew: { shirt: 'red', legs: 'white', hat: 'red', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'ink' },\n  crew2: { shirt: 'blue', legs: 'white', hat: 'blue', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'ink' },\n  driver: { shirt: 'red', legs: 'red', hat: 'white', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'white' },\n  marshal: { shirt: 'orange', legs: 'white', hat: 'white', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'white' },\n};\nconst SLOTS = { Overalls: 'legs', ThighR: 'legs', ShinR_Mesh: 'legs', ThighL: 'legs', ShinL_Mesh: 'legs', Shirt: 'shirt', SleeveR: 'shirt', ForearmR_Mesh: 'shirt', SleeveL: 'shirt', ForearmL_Mesh: 'shirt', Hat: 'hat', Brim: 'hat', ShoeR: 'shoes', ShoeL: 'shoes', GloveR: 'gloves', GloveL: 'gloves', ButtonR: 'gloves', ButtonL: 'gloves' };\nexport const ALL_CLIPS = [...HERO_CLIPS, ...GAME_CLIPS];\nexport class Person {\n  constructor(model, look) {\n    this.object = model; this.mixer = new AnimationMixer(model); this.actions = new Map(); this.current = null;\n    const L = LOOKS[look] ?? LOOKS.crew;\n    model.traverse((o) => {\n      if (!o.isMesh) return;\n      o.castShadow = true; o.receiveShadow = false;\n      const slot = SLOTS[o.name];\n      if (slot && L[slot]) o.material = toonMaterial(PALETTE[L[slot]]);\n      if (L.noMoustache && o.name === 'Moustache') o.visible = false;\n    });\n    setLookLayer(model, 'actors');\n    for (const clip of compileClips(ALL_CLIPS, HERO_RIG, model)) this.actions.set(clip.name, this.mixer.clipAction(clip));\n  }\n  play(name, { fade = 0.2, once = false, speed = 1 } = {}) {\n    const a = this.actions.get(name); if (!a || a === this.current) return;\n    a.reset(); a.setLoop(once ? THREE.LoopOnce : THREE.LoopRepeat, Infinity); a.clampWhenFinished = once; a.timeScale = speed; a.enabled = true; a.setEffectiveWeight(1);\n    if (this.current) this.current.crossFadeTo(a, fade, false);\n    a.play(); this.current = a;\n  }\n  update(dt) { this.mixer.update(dt); }\n  attachProp(handName, mesh) { let hand = null; this.object.traverse((o) => { if (o.name === handName) hand = o; }); hand?.add(mesh); return mesh; }\n}\nexport async function makePerson(ctx, look) { const m = await ctx.loadModel(HERO_MODEL, { castShadow: true }); return new Person(m.scene, look); }\nexport const flagProp = (colour = 'red') => { const m = new Mesh(new BoxGeometry(0.9, 0.5, 0.04), toonMaterial(PALETTE[colour])); m.position.set(0.45, -0.1, 0); return m; };\nEOF\ncat > src/game/render/pitcrew.js <<'EOF'\n// The pit crew: they wait by the wall, run in when the car stops, jack it, swap wheels, fuel it, and run off.\nimport { makePerson } from './people.js';\nimport { THREE, toonMaterial, PALETTE } from '../../pixel-engine.js';\nimport { trackPoint, PIT_WIDTH } from '../sim/race.js';\nconst { Group, BoxGeometry, CylinderGeometry, Mesh, Vector3 } = THREE;\nexport class PitCrew {\n  constructor(ctx, tr) { this.ctx = ctx; this.tr = tr; this.people = []; this.state = 'off'; this.group = new Group(); this.t = 0; this.visible = false; this.group.visible = false; ctx.scene.add(this.group); }\n  async build() {\n    const looks = ['crew', 'crew', 'crew', 'crew', 'crew2', 'benno'];\n    for (const l of looks) { const p = await makePerson(this.ctx, l); this.group.add(p.object); this.people.push(p); }\n    const hoseGeo = new CylinderGeometry(0.06, 0.06, 2.4, 5).rotateZ(Math.PI / 2);\n    this.hose = new Mesh(hoseGeo, toonMaterial(PALETTE.slate)); this.hose.visible = false; this.group.add(this.hose);\n    this.jackBar = new Mesh(new BoxGeometry(0.12, 0.2, 1.3), toonMaterial(PALETTE.red)); this.group.add(this.jackBar); this.jackBar.visible = false;\n    this.spare = [0, 1].map(() => { const m = new Mesh(new CylinderGeometry(0.3, 0.3, 0.22, 10).rotateZ(Math.PI / 2), toonMaterial(PALETTE.ink)); this.group.add(m); return m; });\n  }\n  // Sets where each of them should be, given the stopped car's pose.\n  place(e) {\n    const c = e.c, sn = Math.sin(c.yaw), cs = Math.cos(c.yaw), rx = -cs, rz = sn, a = c.p.a, b = c.p.b, T = c.p.T / 2 + 0.75;\n    const at = (lat, lon) => new Vector3(c.x + rx * lat + sn * lon, c.y, c.z + rz * lat + cs * lon);\n    this.spots = [at(-T, a), at(T, a), at(-T, -b), at(T, -b), at(T + 0.2, 0.1 - 0.4), at(0, a + 1.9)];\n    this.faces = [Math.PI / 2 + c.yaw, -Math.PI / 2 + c.yaw, Math.PI / 2 + c.yaw, -Math.PI / 2 + c.yaw, -Math.PI / 2 + c.yaw, Math.PI + c.yaw];\n    this.waits = this.spots.map((s, i) => { const w = at(T + 4.5, (i - 2.5) * 1.6); return w; });\n    this.jackAt = at(0, a + 1.2); this.car = e;\n  }\n  start(e) { this.place(e); this.state = 'run'; this.t = 0; this.group.visible = true; this.people.forEach((p, i) => { p.object.position.copy(this.waits[i]); p.play('Run', { fade: 0.05 }); }); }\n  go() { if (this.state === 'off') return; this.state = 'leave'; this.t = 0; this.people.forEach((p) => p.play('Run', { fade: 0.1 })); this.hose.visible = false; this.jackBar.visible = false; }\n  update(dt, view) {\n    if (this.state === 'off') return;\n    this.t += dt; for (const p of this.people) p.update(dt);\n    const moveTo = (p, to, sp = 7) => { const d = to.clone().sub(p.object.position); d.y = 0; const l = d.length(); if (l > 0.02) { p.object.position.addScaledVector(d, Math.min(1, (sp * dt) / l)); p.object.rotation.y = Math.atan2(d.x, d.z); } p.object.position.y = to.y; return l; };\n    if (this.state === 'run') {\n      let all = true;\n      this.people.forEach((p, i) => { if (moveTo(p, this.spots[i]) > 0.1) all = false; else { p.object.rotation.y = this.faces[i]; p.play(i < 4 ? (i === 0 ? 'PitWheelGun' : 'PitWheelGun') : i === 4 ? 'PitFuel' : 'PitJack'); } });\n      if (all || this.t > 1) { this.state = 'work'; this.t = 0; }\n    } else if (this.state === 'work') {\n      if (view) { const target = Math.min(0.15, this.t * 0.6); view.jack = target; }\n      this.hose.visible = true; const p = this.people[4].object; this.hose.position.set(p.position.x, p.position.y + 0.95, p.position.z); this.hose.rotation.y = this.car.c.yaw + Math.PI / 2 + Math.PI / 2;\n      this.jackBar.visible = true; this.jackBar.position.copy(this.jackAt).setY(this.jackAt.y + 0.2); this.jackBar.rotation.y = this.car.c.yaw;\n      this.spare.forEach((m, i) => { const q = this.spots[i * 2 + 1]; m.visible = true; m.position.set(q.x, q.y + 0.3, q.z); });\n    } else if (this.state === 'leave') {\n      if (view) view.jack = Math.max(0, view.jack - dt * 0.8);\n      let all = true; this.people.forEach((p, i) => { if (moveTo(p, this.waits[i], 8) > 0.15) all = false; });\n      this.spare.forEach((m) => { m.visible = false; });\n      if (all || this.t > 1.4) { this.state = 'off'; this.group.visible = false; if (view) view.jack = 0; }\n    }\n  }\n}\nvoid trackPoint; void PIT_WIDTH;\nEOF\ncat > src/game/render/director.js <<'EOF'\n// The replay director: camera posts every ~280 m beside the road, some authored shots, and a cut every 4 to 8 s toward what is interesting.\nimport { THREE } from '../../pixel-engine.js';\nimport { trackPoint, wrapS } from '../sim/race.js';\nconst { Vector3 } = THREE;\nexport class TvDirector {\n  constructor(tr, field, seed = 7) {\n    this.tr = tr; this.posts = []; this.shot = null; this.cutT = 0; this.pos = new Vector3(); this.look = new Vector3(); let s = 0, a = seed;\n    const rnd = () => { a = (a * 1664525 + 1013904223) >>> 0; return a / 4294967296; };\n    while (s < tr.length) {\n      const side = rnd() > 0.5 ? 1 : -1, i = Math.round(s / tr.ds) % tr.N, wall = side > 0 ? tr.wallR[i] : tr.wallL[i], off = tr.width[i] / 2 + Math.max(wall + 2, 15 + rnd() * 10), x = tr.x[i] - tr.tz[i] * off * side, z = tr.z[i] + tr.tx[i] * off * side;\n      this.posts.push({ s, x, y: tr.y[i] + 3 + rnd() * 5 + (tr.surface === 'dirt' ? 3 : 0), z, fov: 18 + rnd() * 12 });\n      s += 240 + rnd() * 80;\n    }\n    // Authored: low at the start line, a helicopter on the straight, the gantry.\n    const a0 = trackPoint(tr, 6, tr.width[0] / 2 + 2.2); this.posts.push({ s: 0, x: a0.x, y: a0.y + 0.7, z: a0.z, fov: 32, low: true });\n    const h = trackPoint(tr, -200, 0); this.heli = { s: -200, x: h.x, y: h.y + 42, z: h.z, fov: 24, heli: true };\n    const g = trackPoint(tr, 3, 0); this.posts.push({ s: 40, x: g.x, y: g.y + 8.6, z: g.z, fov: 40, gantry: true });\n    this.posts.sort((p, q) => p.s - q.s);\n  }\n  // The next post ahead of the focus.\n  pick(s) {\n    const tr = this.tr; let best = this.posts[0], bd = Infinity;\n    for (const p of this.posts) { const d = wrapS(tr, p.s - s - 50); if (d < bd && p !== this.shot) { bd = d; best = p; } }\n    return best;\n  }\n  force() { this.cutT = 0; }\n  // focus: { x, y, z, s }. Returns true on a cut.\n  update(dt, focus, cam, { busy = false } = {}) {\n    this.cutT -= dt; let cut = false;\n    const shot = this.shot;\n    const dist = shot ? Math.hypot(shot.x - focus.x, shot.z - focus.z) : 1e9, behind = shot ? wrapS(this.tr, focus.s - shot.s) : 0;\n    if (!shot || this.cutT <= 0 || dist > 170 || (behind < this.tr.length / 2 && behind > 110 && !shot.heli)) {\n      this.shot = this.pick(focus.s); this.cutT = 4 + (Math.abs(Math.sin(focus.s * 13.1)) * 4) - (busy ? 1.5 : 0); cut = true;\n      if (Math.abs(Math.sin(focus.s * 3.3)) > 0.93 && this.heli) { this.shot = this.heli; this.heli.x = focus.x + 20; this.heli.z = focus.z - 34; this.heli.y = focus.y + 36; }\n    }\n    const S = this.shot;\n    this.pos.set(S.x, S.y, S.z);\n    if (S.heli) { S.x += (focus.x + 16 - S.x) * Math.min(1, dt * 0.8); S.z += (focus.z - 30 - S.z) * Math.min(1, dt * 0.8); }\n    this.look.set(focus.x, focus.y + 0.7, focus.z);\n    cam.position.copy(this.pos); cam.lookAt(this.look);\n    const d2 = this.pos.distanceTo(this.look), wantFov = S.low || S.gantry ? S.fov : Math.max(12, Math.min(44, (S.fov * 60) / Math.max(30, d2)));\n    cam.fov = wantFov; cam.updateProjectionMatrix();\n    return cut;\n  }\n}\nEOF\ncat > src/game/ui/racehud.js <<'EOF'\n// The race HUD. Position top-left, times top-right, speed and gear bottom-right, map and tyres bottom-left. The middle stays clear.\nimport { formatTime } from '../sim/race.js';\nconst wearColour = (w) => (w > 0.65 ? 'lime' : w > 0.38 ? 'sand' : w > 0.18 ? 'orange' : 'red');\nexport class RaceHud {\n  constructor(sim, compact = false) {\n    this.sim = sim; this.compact = compact; this.msg = null; this.msgT = 0; this.big = null; this.bigT = 0;\n    const tr = sim.tr, pts = []; let minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;\n    for (let i = 0; i < tr.N; i++) { minX = Math.min(minX, tr.x[i]); maxX = Math.max(maxX, tr.x[i]); minZ = Math.min(minZ, tr.z[i]); maxZ = Math.max(maxZ, tr.z[i]); }\n    this.mapSize = compact ? 34 : 54; const k = (this.mapSize - 2) / Math.max(maxX - minX, maxZ - minZ); this.mapK = k; this.minX = minX; this.minZ = minZ; this.maxX = maxX; this.maxZ = maxZ;\n    this.mapW = Math.round((maxX - minX) * k) + 2; this.mapH = Math.round((maxZ - minZ) * k) + 2;\n    const seen = new Set();\n    for (let i = 0; i < tr.N; i += 2) { const px = Math.round((maxX - tr.x[i]) * k), pz = Math.round((tr.z[i] - minZ) * k), key = px * 1000 + pz; if (!seen.has(key)) { seen.add(key); pts.push(px, pz); } }\n    this.pts = pts;\n  }\n  flash(text, seconds = 2.2, big = false) { if (big) { this.big = text; this.bigT = seconds; } else { this.msg = text; this.msgT = seconds; } }\n  mapAt(ui, x, y, car, mine) {\n    const hud = ui.hud, p = this.pts;\n    ui.panel(x - 2, y - 2, this.mapW + 4, this.mapH + 4, { color: 'ink', border: false, scan: true });\n    for (let i = 0; i < p.length; i += 2) hud.rect(x + p[i], y + this.mapH - p[i + 1] - 1, 1, 1, 'mist');\n    const dot = (cx, cz, col, size) => { const px = Math.round((this.maxX - cx) * this.mapK), pz = Math.round((cz - this.minZ) * this.mapK); hud.rect(x + px - (size >> 1), y + this.mapH - pz - 1 - (size >> 1), size, size, col); };\n    for (const e of this.sim.cars) if (e !== car) dot(e.c.x, e.c.z, e.player !== null ? 'sky' : 'red', 2);\n    if (mine) dot(car.c.x, car.c.z, 'sand', 3);\n  }\n  // Draws around a car. o: { units, assists, slipOn, dev, flags, test: judge, recover, showMap, ghosts }\n  draw(ui, car, dt, o = {}) {\n    const sim = this.sim, c = car.c, w = ui.w, h = ui.h, hud = ui.hud, compact = this.compact, kmh = o.units !== 'mph', speed = Math.abs(c.u) * (kmh ? 3.6 : 2.237), p = c.p;\n    // ---- top-left: position and lap ----\n    if (!o.test) {\n      const raceN = sim.cars.filter((e) => !e.ghost).length;\n      if (raceN > 1) ui.text(6, 5, `P${car.pos}`, { scale: 2, color: car.pos === 1 ? 'sand' : 'white' });\n      if (raceN > 1) ui.text(6 + hud.measure(`P${car.pos}`, 2).width + 2, 11, `/${raceN}`, { color: 'mist' });\n      if (sim.laps > 0) { const lapNow = Math.max(1, Math.min(car.lap, sim.laps)); ui.text(6, 22, `LAP ${lapNow}/${sim.laps}`, { color: car.lap === sim.laps ? 'sand' : 'mist' }); }\n      else if (car.lap > 0) ui.text(6, 22, `LAP ${car.lap}`, { color: 'mist' });\n    }\n    // ---- top-right: time, best lap, gap ----\n    const rx = w - 6; let ry = 5;\n    if (o.test) {\n      const J = o.test; ui.text(rx, ry, formatTime(J.total), { align: 'right', scale: compact ? 1 : 2, color: J.running ? 'white' : 'mist' }); ry += 18;\n      const m = J.test.medals;\n      if (m) { for (const [name, col] of [['gold', 'sand'], ['silver', 'mist'], ['bronze', 'orange']]) { const passed = J.total > m[name], dim = passed ? 'slate' : col; ui.text(rx, ry, `${name.toUpperCase()} ${formatTime(m[name] / (J.test.legs?.length ?? 1) * (J.test.legs?.length ?? 1))}`, { align: 'right', color: dim }); ry += 10; } }\n      if (J.penalty > 0) { ui.text(rx, ry, `+${J.penalty.toFixed(0)} S PENALTY`, { align: 'right', color: 'red' }); ry += 10; }\n      if (o.legText) { ui.text(rx, ry, o.legText, { align: 'right', color: 'sky' }); ry += 10; }\n    } else {\n      const t = car.ownStart !== null ? sim.time - car.ownStart : 0, lapT = car.lapStart !== null ? sim.time - car.lapStart : 0;\n      if (!compact) { ui.text(rx, ry, formatTime(car.finished ? car.finishTime : t), { align: 'right', color: 'white' }); ry += 10; }\n      ui.text(rx, ry, `LAP ${formatTime(lapT)}`, { align: 'right', color: 'mist' }); ry += 10;\n      if (car.bestLap) { ui.text(rx, ry, `BEST ${formatTime(car.bestLap)}`, { align: 'right', color: 'sand' }); ry += 10; }\n      if (o.rival) { const g = sim.clockGap(car, o.rival); if (g !== null) { ui.text(rx, ry, `${g <= 0 ? '-' : '+'}${Math.abs(g).toFixed(2)}`, { align: 'right', color: g <= 0 ? 'lime' : 'red' }); ry += 10; } }\n      else if (sim.cars.length > 1) { const g = sim.gapAhead(car); if (g !== null && g < 99) { ui.text(rx, ry, `AHEAD +${g.toFixed(1)}`, { align: 'right', color: 'mist' }); ry += 10; } const b = sim.gapBehind(car); if (b !== null && b < 99 && !compact) { ui.text(rx, ry, `BEHIND -${b.toFixed(1)}`, { align: 'right', color: 'slate' }); ry += 10; } }\n      if (o.ghostGap !== undefined && o.ghostGap !== null) { ui.text(rx, ry, `GHOST ${o.ghostGap >= 0 ? '+' : ''}${o.ghostGap.toFixed(2)}`, { align: 'right', color: o.ghostGap <= 0 ? 'lime' : 'orange' }); ry += 10; }\n    }\n    // ---- bottom-right: speed and gear with the rev bar ----\n    const sc = compact ? 2 : 3, spTxt = String(Math.round(speed)), gearTxt = car.reverse ? 'R' : c.shift > 0 ? '-' : String(c.gear), by = h - 8 - 7 * sc;\n    ui.text(rx - (compact ? 16 : 26), by, spTxt, { align: 'right', scale: sc });\n    ui.text(rx - (compact ? 16 : 26), by - 9, kmh ? 'KM/H' : 'MPH', { align: 'right', color: 'mist' });\n    ui.text(rx, by, gearTxt, { align: 'right', scale: sc, color: c.rpm > p.upshift ? 'red' : 'sand' });\n    const segs = compact ? 10 : 18, segW = compact ? 5 : 5, bx = rx - segs * (segW + 1), byy = by - 18 - (compact ? 0 : 0), frac = Math.min(1, c.rpm / p.redline);\n    for (let k = 0; k < segs; k++) { const f = (k + 1) / segs, on = frac >= f - 0.01, col = f > 0.92 ? 'red' : f > 0.8 ? 'orange' : 'lime'; ui.rect(bx + k * (segW + 1), byy, segW, 4, on ? col : 'night'); }\n    if (c.rpm > p.upshift && !car.reverse) ui.rect(bx - 7, byy, 5, 4, Math.floor(ui.time * 16) % 2 ? 'white' : 'red');\n    // ---- bottom-left: map, tyres, fuel, assists ----\n    const mx = 6, my = h - this.mapH - 8;\n    if (o.showMap !== false) this.mapAt(ui, mx, my, car, true);\n    const tx = mx + this.mapW + 7, ty = h - 22, sq = 6;\n    [[0, 0, 0], [1, 1, 0], [2, 0, 1], [3, 1, 1]].forEach(([i, cx, cy]) => { const col = wearColour(c.wear[i]); ui.rect(tx + cx * (sq + 2) - 1, ty + cy * (sq + 2) - 1, sq + 2, sq + 2, 'ink'); ui.rect(tx + cx * (sq + 2), ty + cy * (sq + 2), sq, sq, col); });\n    if (o.fuel) { ui.text(tx, ty - 18, 'FUEL', { color: c.fuel < 0.15 ? 'red' : 'mist' }); ui.bar(tx, ty - 9, 40, 4, c.fuel, c.fuel < 0.15 ? 'red' : 'sky', 'ink'); }\n    if (!compact) { let ax = tx + 20, ay = ty; for (const [on, t] of [[c.absOn, 'ABS'], [c.tcsOn, 'TCS'], [c.asmOn, 'STB']]) { if (on) { ui.rect(ax - 1, ay - 1, 20, 9, 'orange'); ui.text(ax, ay, t, { color: 'ink', shadow: false }); ay += 0; ax += 22; } } if (car.slip) ui.text(tx + 20, ty + 9, 'SLIP', { color: 'cyan' }); }\n    if (o.dev) ui.text(6, 32, 'DEV', { color: 'red' });\n    // ---- centre-top: flags and messages ----\n    const cy = compact ? 34 : 38;\n    if (this.bigT > 0) { this.bigT -= dt; ui.text(ui.cx, cy, this.big, { align: 'center', scale: compact ? 2 : 3, color: 'sand' }); }\n    if (this.msgT > 0) { this.msgT -= dt; ui.text(ui.cx, cy + 26, this.msg, { align: 'center', color: 'white' }); }\n    if (car.wrongWay) ui.text(ui.cx, cy + 40, 'WRONG WAY', { align: 'center', scale: 2, color: 'red' });\n    if (car.pit) {\n      const P = car.pit; ui.text(ui.cx, cy, 'PIT', { align: 'center', scale: 2, color: 'sand' });\n      if (P.phase === 'box') { const left = Math.max(P.tyres, P.fuel) - P.svc; ui.text(ui.cx, cy + 18, `${Math.max(0, left).toFixed(1)} S`, { align: 'center', color: 'white' }); if (P.tyres > 0 && !P.skipTyres && o.skipPrompt) ui.text(ui.cx, cy + 30, o.skipPrompt, { align: 'center', color: 'mist' }); }\n    }\n    if (o.recover > 0 && !car.pit) { ui.text(ui.cx, h - 70, 'RECOVERING', { align: 'center', color: 'sand' }); ui.bar(ui.cx - 30, h - 60, 60, 4, o.recover, 'sand'); }\n    else if (o.recoverHint) ui.text(ui.cx, h - 60, o.recoverHint, { align: 'center', color: 'mist' });\n    void hud;\n  }\n}\nEOF\necho ok","description":"Write animation clips, people, pit crew, TV director and race HUD"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19884,"cache_read_input_tokens":352328,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19884},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"774ee883-b214-496e-9dda-c827be96e669","timestamp":"2026-11-06T00:51:36.757Z","request_id":"req_011Cgkkj4Yke9EsMqJbBFyf4","wire_tool_inputs":{"toolu_01MNvfQzJLxKbogjZZC3EQ9V":{"command":"cat > src/game/models/clips.js <<'EOF'\n// New animations, authored as ClipDef data on the engine's hero rig. analyzeClip checks them in the headless suite.\nconst rest = () => ({ Pelvis: { r: [0, 0, 0], p: [0, 0, 0], s: 1 }, Torso: [0, 0, 0], Head: [0, 0, 0], ArmR: [4, 0, -8], ForearmR: [-18, 0, 0], HandR: [0, 0, 0], ArmL: [4, 0, 8], ForearmL: [-18, 0, 0], HandL: [0, 0, 0], LegR: [0, 0, 0], ShinR: [0, 0, 0], FootR: [0, 0, 0], LegL: [0, 0, 0], ShinL: [0, 0, 0], FootL: [0, 0, 0] });\nconst pose = (o) => ({ ...rest(), ...o });\nconst crouch = (o = {}) => pose({ Pelvis: { r: [18, 0, 0], p: [0, -0.34, 0.02], s: 1 }, Torso: [24, 0, 0], Head: [-22, 0, 0], LegR: [-74, 0, 0], ShinR: [96, 0, 0], FootR: [-30, 0, 0], LegL: [-74, 0, 0], ShinL: [96, 0, 0], FootL: [-30, 0, 0], ...o });\nconst kneel = (o = {}) => pose({ Pelvis: { r: [6, 0, 0], p: [0, -0.42, 0], s: 1 }, Torso: [28, 0, 0], Head: [-20, 0, 0], LegR: [-84, 0, 0], ShinR: [84, 0, 0], FootR: [0, 0, 0], LegL: [8, 0, 0], ShinL: [112, 0, 0], FootL: [30, 0, 0], ...o });\nexport const GAME_CLIPS = [\n  { name: 'PitJack', frames: 40, loop: true, keys: [[0, crouch({ ArmR: [-70, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-30, 0, 0] })], [20, crouch({ Pelvis: { r: [26, 0, 0], p: [0, -0.4, 0.04], s: 1 }, Torso: [44, 0, 0], ArmR: [-36, 0, -10], ForearmR: [-12, 0, 0], ArmL: [-36, 0, 10], ForearmL: [-12, 0, 0] })], [40, crouch({ ArmR: [-70, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-70, 0, 10], ForearmL: [-30, 0, 0] })]], notes: 'Crouch and pump a jack lever.' },\n  { name: 'PitWheelGun', frames: 120, loop: true, keys: [\n    [0, kneel({ ArmR: [-76, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-60, 0, 8], ForearmL: [-40, 0, 0] })],\n    [20, kneel({ Torso: [34, 6, 0], ArmR: [-82, 0, -4], ForearmR: [-8, 0, 0], ArmL: [-60, 0, 8], ForearmL: [-40, 0, 0] })],\n    [45, kneel({ Torso: [22, -18, 0], ArmR: [-50, 0, -30], ForearmR: [-60, 0, 0], ArmL: [-50, 0, 30], ForearmL: [-60, 0, 0] })],\n    [75, kneel({ Torso: [34, 16, 0], ArmR: [-80, 0, -24], ForearmR: [-40, 0, 0], ArmL: [-80, 0, 24], ForearmL: [-40, 0, 0] })],\n    [100, kneel({ Torso: [34, 6, 0], ArmR: [-82, 0, -4], ForearmR: [-8, 0, 0], ArmL: [-60, 0, 8], ForearmL: [-40, 0, 0] })],\n    [120, kneel({ ArmR: [-76, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-60, 0, 8], ForearmL: [-40, 0, 0] })]], notes: 'Kneel, gun to the hub, pull a wheel, fit a wheel.' },\n  { name: 'PitFuel', frames: 60, loop: true, grounded: true, keys: [[0, pose({ Pelvis: { r: [0, 12, 0], p: [0, -0.04, 0], s: 1 }, Torso: [10, 10, 0], ArmR: [-74, 8, -8], ForearmR: [-16, 0, 0], ArmL: [-62, -6, 14], ForearmL: [-30, 0, 0], LegR: [-10, 0, 0], ShinR: [18, 0, 0], FootR: [-8, 0, 0], LegL: [-16, 0, 0], ShinL: [24, 0, 0], FootL: [-8, 0, 0] })], [30, pose({ Pelvis: { r: [0, 12, 0], p: [0, -0.06, 0], s: 1 }, Torso: [13, 12, 0], Head: [8, -10, 0], ArmR: [-74, 8, -8], ForearmR: [-16, 0, 0], ArmL: [-62, -6, 14], ForearmL: [-30, 0, 0], LegR: [-12, 0, 0], ShinR: [22, 0, 0], FootR: [-10, 0, 0], LegL: [-18, 0, 0], ShinL: [28, 0, 0], FootL: [-10, 0, 0] })], [60, pose({ Pelvis: { r: [0, 12, 0], p: [0, -0.04, 0], s: 1 }, Torso: [10, 10, 0], ArmR: [-74, 8, -8], ForearmR: [-16, 0, 0], ArmL: [-62, -6, 14], ForearmL: [-30, 0, 0], LegR: [-10, 0, 0], ShinR: [18, 0, 0], FootR: [-8, 0, 0], LegL: [-16, 0, 0], ShinL: [24, 0, 0], FootL: [-8, 0, 0] })]], notes: 'Hold a fuel hose to the flank.' },\n  { name: 'MarshalFlag', frames: 40, loop: true, grounded: true, keys: [[0, pose({ ArmR: [-170, 0, -12], ForearmR: [-14, 0, 0], Torso: [0, 0, 5], Head: [-6, 0, 0] })], [10, pose({ ArmR: [-150, 0, -40], ForearmR: [-18, 0, 0], Torso: [0, 0, 9], Head: [-6, 0, 0] })], [20, pose({ ArmR: [-170, 0, -12], ForearmR: [-14, 0, 0], Torso: [0, 0, 5], Head: [-6, 0, 0] })], [30, pose({ ArmR: [-168, 0, 16], ForearmR: [-12, 0, 0], Torso: [0, 0, 1], Head: [-6, 0, 0] })], [40, pose({ ArmR: [-170, 0, -12], ForearmR: [-14, 0, 0], Torso: [0, 0, 5], Head: [-6, 0, 0] })]], notes: 'Wave a flag overhead; the flag mesh is parented to the hand.' },\n  { name: 'ExaminerClipboard', frames: 150, loop: true, grounded: true, keys: [\n    [0, pose({ ArmR: [-64, 0, 14], ForearmR: [-70, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [18, 0, 0] })],\n    [40, pose({ ArmR: [-68, 12, 8], ForearmR: [-86, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [22, 8, 0] })],\n    [60, pose({ ArmR: [-60, -6, 18], ForearmR: [-66, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [20, -4, 0] })],\n    [90, pose({ ArmR: [-44, 0, 8], ForearmR: [-60, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [-6, 0, 0] })],\n    [105, pose({ ArmR: [-44, 0, 8], ForearmR: [-60, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [14, 0, 0] })],\n    [120, pose({ ArmR: [-44, 0, 8], ForearmR: [-60, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [-4, 0, 0] })],\n    [150, pose({ ArmR: [-64, 0, 14], ForearmR: [-70, 0, 0], ArmL: [-54, 0, -14], ForearmL: [-74, 0, 0], Head: [18, 0, 0] })]], notes: 'Note something, look up, nod.' },\n  { name: 'DealerPresent', frames: 90, loop: true, grounded: true, keys: [\n    [0, pose({ ArmR: [8, 0, -8], ForearmR: [-40, 0, 0], ArmL: [8, 0, 8], ForearmL: [-40, 0, 0] })],\n    [28, pose({ Torso: [4, 18, 0], Head: [-2, 20, 0], ArmL: [-62, 30, 42], ForearmL: [-10, 0, 0], HandL: [-16, 0, 0], ArmR: [8, 0, -8], ForearmR: [-40, 0, 0] })],\n    [62, pose({ Torso: [4, 22, 0], Head: [-2, 26, 0], ArmL: [-68, 58, 34], ForearmL: [-8, 0, 0], HandL: [-16, 0, 0], ArmR: [8, 0, -8], ForearmR: [-40, 0, 0] })],\n    [90, pose({ ArmR: [8, 0, -8], ForearmR: [-40, 0, 0], ArmL: [8, 0, 8], ForearmL: [-40, 0, 0] })]], notes: 'An open-handed sweep toward the car.' },\n  { name: 'MechanicWipe', frames: 80, loop: true, grounded: true, keys: [\n    [0, pose({ ArmR: [-50, 0, 18], ForearmR: [-76, 0, 0], ArmL: [-50, 0, -18], ForearmL: [-76, 0, 0], Head: [16, 0, 0] })],\n    [20, pose({ ArmR: [-46, 0, 24], ForearmR: [-84, 0, 0], ArmL: [-54, 0, -24], ForearmL: [-68, 0, 0], Head: [16, 4, 0] })],\n    [40, pose({ ArmR: [-54, 0, 12], ForearmR: [-68, 0, 0], ArmL: [-46, 0, -12], ForearmL: [-84, 0, 0], Head: [16, -4, 0] })],\n    [60, pose({ ArmR: [-46, 0, 20], ForearmR: [-80, 0, 0], ArmL: [-50, 0, -20], ForearmL: [-72, 0, 0], Head: [2, 20, 0] })],\n    [80, pose({ ArmR: [-50, 0, 18], ForearmR: [-76, 0, 0], ArmL: [-50, 0, -18], ForearmL: [-76, 0, 0], Head: [16, 0, 0] })]], notes: 'Wipe hands on a rag, look at the car.' },\n  { name: 'PodiumCheer', frames: 40, loop: true, fast: true, keys: [\n    [0, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.1, 0], s: 1 }, ArmR: [-168, 0, -24], ForearmR: [-8, 0, 0], ArmL: [-168, 0, 24], ForearmL: [-8, 0, 0], LegR: [-24, 0, 0], ShinR: [40, 0, 0], FootR: [-16, 0, 0], LegL: [-24, 0, 0], ShinL: [40, 0, 0], FootL: [-16, 0, 0], Head: [-14, 0, 0] })],\n    [20, pose({ Pelvis: { r: [0, 0, 0], p: [0, 0.24, 0], s: 1 }, ArmR: [-178, 0, -10], ForearmR: [-4, 0, 0], ArmL: [-178, 0, 10], ForearmL: [-4, 0, 0], LegR: [-8, 0, 0], ShinR: [18, 0, 0], FootR: [20, 0, 0], LegL: [-8, 0, 0], ShinL: [18, 0, 0], FootL: [20, 0, 0], Head: [-20, 0, 0] })],\n    [40, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.1, 0], s: 1 }, ArmR: [-168, 0, -24], ForearmR: [-8, 0, 0], ArmL: [-168, 0, 24], ForearmL: [-8, 0, 0], LegR: [-24, 0, 0], ShinR: [40, 0, 0], FootR: [-16, 0, 0], LegL: [-24, 0, 0], ShinL: [40, 0, 0], FootL: [-16, 0, 0], Head: [-14, 0, 0] })]], notes: 'Arms up, small jump.' },\n  { name: 'PodiumBow', frames: 80, loop: true, grounded: true, keys: [\n    [0, pose({ ArmR: [4, 0, -6], ArmL: [4, 0, 6] })],\n    [24, pose({ Pelvis: { r: [28, 0, 0], p: [0, -0.02, -0.04], s: 1 }, Torso: [30, 0, 0], Head: [12, 0, 0], ArmR: [-8, 0, -6], ArmL: [-8, 0, 6] })],\n    [50, pose({ Pelvis: { r: [28, 0, 0], p: [0, -0.02, -0.04], s: 1 }, Torso: [30, 0, 0], Head: [12, 0, 0], ArmR: [-8, 0, -6], ArmL: [-8, 0, 6] })],\n    [80, pose({ ArmR: [4, 0, -6], ArmL: [4, 0, 6] })]], notes: 'A formal bow.' },\n  { name: 'CrowdCheer', frames: 24, loop: true, grounded: true, keys: [\n    [0, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.02, 0], s: 1 }, ArmR: [-150, 0, -14], ForearmR: [-20, 0, 0], ArmL: [-40, 0, 20], ForearmL: [-60, 0, 0], LegR: [-6, 0, 0], ShinR: [10, 0, 0], FootR: [-4, 0, 0], LegL: [-6, 0, 0], ShinL: [10, 0, 0], FootL: [-4, 0, 0] })],\n    [12, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.07, 0], s: 1 }, ArmR: [-168, 0, -6], ForearmR: [-10, 0, 0], ArmL: [-50, 0, 24], ForearmL: [-70, 0, 0], LegR: [-14, 0, 0], ShinR: [24, 0, 0], FootR: [-10, 0, 0], LegL: [-14, 0, 0], ShinL: [24, 0, 0], FootL: [-10, 0, 0] })],\n    [24, pose({ Pelvis: { r: [0, 0, 0], p: [0, -0.02, 0], s: 1 }, ArmR: [-150, 0, -14], ForearmR: [-20, 0, 0], ArmL: [-40, 0, 20], ForearmL: [-60, 0, 0], LegR: [-6, 0, 0], ShinR: [10, 0, 0], FootR: [-4, 0, 0], LegL: [-6, 0, 0], ShinL: [10, 0, 0], FootL: [-4, 0, 0] })]], notes: 'A looping bob for the crowd stand-ins.' },\n];\nEOF\ncat > src/game/render/people.js <<'EOF'\n// People are the engine's hero, recoloured by swapping mesh materials by name. Overalls, suits, and the four of the cast.\nimport { compileClips, HERO_CLIPS, HERO_MODEL, HERO_RIG, PALETTE, setLookLayer, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { GAME_CLIPS } from '../models/clips.js';\nconst { AnimationMixer, BoxGeometry, Mesh } = THREE;\nconst LOOKS = {\n  arai: { shirt: 'navy', legs: 'navy', hat: 'ink', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'sand' },\n  benno: { shirt: 'orange', legs: 'orange', hat: 'night', shoes: 'ink', face: 'sand', gloves: 'slate' },\n  fenn: { shirt: 'white', legs: 'night', hat: 'night', shoes: 'plum', face: 'sand', gloves: 'sand' },\n  dell: { shirt: 'teal', legs: 'slate', hat: 'teal', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'sand' },\n  crew: { shirt: 'red', legs: 'white', hat: 'red', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'ink' },\n  crew2: { shirt: 'blue', legs: 'white', hat: 'blue', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'ink' },\n  driver: { shirt: 'red', legs: 'red', hat: 'white', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'white' },\n  marshal: { shirt: 'orange', legs: 'white', hat: 'white', shoes: 'ink', face: 'sand', noMoustache: true, gloves: 'white' },\n};\nconst SLOTS = { Overalls: 'legs', ThighR: 'legs', ShinR_Mesh: 'legs', ThighL: 'legs', ShinL_Mesh: 'legs', Shirt: 'shirt', SleeveR: 'shirt', ForearmR_Mesh: 'shirt', SleeveL: 'shirt', ForearmL_Mesh: 'shirt', Hat: 'hat', Brim: 'hat', ShoeR: 'shoes', ShoeL: 'shoes', GloveR: 'gloves', GloveL: 'gloves', ButtonR: 'gloves', ButtonL: 'gloves' };\nexport const ALL_CLIPS = [...HERO_CLIPS, ...GAME_CLIPS];\nexport class Person {\n  constructor(model, look) {\n    this.object = model; this.mixer = new AnimationMixer(model); this.actions = new Map(); this.current = null;\n    const L = LOOKS[look] ?? LOOKS.crew;\n    model.traverse((o) => {\n      if (!o.isMesh) return;\n      o.castShadow = true; o.receiveShadow = false;\n      const slot = SLOTS[o.name];\n      if (slot && L[slot]) o.material = toonMaterial(PALETTE[L[slot]]);\n      if (L.noMoustache && o.name === 'Moustache') o.visible = false;\n    });\n    setLookLayer(model, 'actors');\n    for (const clip of compileClips(ALL_CLIPS, HERO_RIG, model)) this.actions.set(clip.name, this.mixer.clipAction(clip));\n  }\n  play(name, { fade = 0.2, once = false, speed = 1 } = {}) {\n    const a = this.actions.get(name); if (!a || a === this.current) return;\n    a.reset(); a.setLoop(once ? THREE.LoopOnce : THREE.LoopRepeat, Infinity); a.clampWhenFinished = once; a.timeScale = speed; a.enabled = true; a.setEffectiveWeight(1);\n    if (this.current) this.current.crossFadeTo(a, fade, false);\n    a.play(); this.current = a;\n  }\n  update(dt) { this.mixer.update(dt); }\n  attachProp(handName, mesh) { let hand = null; this.object.traverse((o) => { if (o.name === handName) hand = o; }); hand?.add(mesh); return mesh; }\n}\nexport async function makePerson(ctx, look) { const m = await ctx.loadModel(HERO_MODEL, { castShadow: true }); return new Person(m.scene, look); }\nexport const flagProp = (colour = 'red') => { const m = new Mesh(new BoxGeometry(0.9, 0.5, 0.04), toonMaterial(PALETTE[colour])); m.position.set(0.45, -0.1, 0); return m; };\nEOF\ncat > src/game/render/pitcrew.js <<'EOF'\n// The pit crew: they wait by the wall, run in when the car stops, jack it, swap wheels, fuel it, and run off.\nimport { makePerson } from './people.js';\nimport { THREE, toonMaterial, PALETTE } from '../../pixel-engine.js';\nimport { trackPoint, PIT_WIDTH } from '../sim/race.js';\nconst { Group, BoxGeometry, CylinderGeometry, Mesh, Vector3 } = THREE;\nexport class PitCrew {\n  constructor(ctx, tr) { this.ctx = ctx; this.tr = tr; this.people = []; this.state = 'off'; this.group = new Group(); this.t = 0; this.visible = false; this.group.visible = false; ctx.scene.add(this.group); }\n  async build() {\n    const looks = ['crew', 'crew', 'crew', 'crew', 'crew2', 'benno'];\n    for (const l of looks) { const p = await makePerson(this.ctx, l); this.group.add(p.object); this.people.push(p); }\n    const hoseGeo = new CylinderGeometry(0.06, 0.06, 2.4, 5).rotateZ(Math.PI / 2);\n    this.hose = new Mesh(hoseGeo, toonMaterial(PALETTE.slate)); this.hose.visible = false; this.group.add(this.hose);\n    this.jackBar = new Mesh(new BoxGeometry(0.12, 0.2, 1.3), toonMaterial(PALETTE.red)); this.group.add(this.jackBar); this.jackBar.visible = false;\n    this.spare = [0, 1].map(() => { const m = new Mesh(new CylinderGeometry(0.3, 0.3, 0.22, 10).rotateZ(Math.PI / 2), toonMaterial(PALETTE.ink)); this.group.add(m); return m; });\n  }\n  // Sets where each of them should be, given the stopped car's pose.\n  place(e) {\n    const c = e.c, sn = Math.sin(c.yaw), cs = Math.cos(c.yaw), rx = -cs, rz = sn, a = c.p.a, b = c.p.b, T = c.p.T / 2 + 0.75;\n    const at = (lat, lon) => new Vector3(c.x + rx * lat + sn * lon, c.y, c.z + rz * lat + cs * lon);\n    this.spots = [at(-T, a), at(T, a), at(-T, -b), at(T, -b), at(T + 0.2, 0.1 - 0.4), at(0, a + 1.9)];\n    this.faces = [Math.PI / 2 + c.yaw, -Math.PI / 2 + c.yaw, Math.PI / 2 + c.yaw, -Math.PI / 2 + c.yaw, -Math.PI / 2 + c.yaw, Math.PI + c.yaw];\n    this.waits = this.spots.map((s, i) => { const w = at(T + 4.5, (i - 2.5) * 1.6); return w; });\n    this.jackAt = at(0, a + 1.2); this.car = e;\n  }\n  start(e) { this.place(e); this.state = 'run'; this.t = 0; this.group.visible = true; this.people.forEach((p, i) => { p.object.position.copy(this.waits[i]); p.play('Run', { fade: 0.05 }); }); }\n  go() { if (this.state === 'off') return; this.state = 'leave'; this.t = 0; this.people.forEach((p) => p.play('Run', { fade: 0.1 })); this.hose.visible = false; this.jackBar.visible = false; }\n  update(dt, view) {\n    if (this.state === 'off') return;\n    this.t += dt; for (const p of this.people) p.update(dt);\n    const moveTo = (p, to, sp = 7) => { const d = to.clone().sub(p.object.position); d.y = 0; const l = d.length(); if (l > 0.02) { p.object.position.addScaledVector(d, Math.min(1, (sp * dt) / l)); p.object.rotation.y = Math.atan2(d.x, d.z); } p.object.position.y = to.y; return l; };\n    if (this.state === 'run') {\n      let all = true;\n      this.people.forEach((p, i) => { if (moveTo(p, this.spots[i]) > 0.1) all = false; else { p.object.rotation.y = this.faces[i]; p.play(i < 4 ? (i === 0 ? 'PitWheelGun' : 'PitWheelGun') : i === 4 ? 'PitFuel' : 'PitJack'); } });\n      if (all || this.t > 1) { this.state = 'work'; this.t = 0; }\n    } else if (this.state === 'work') {\n      if (view) { const target = Math.min(0.15, this.t * 0.6); view.jack = target; }\n      this.hose.visible = true; const p = this.people[4].object; this.hose.position.set(p.position.x, p.position.y + 0.95, p.position.z); this.hose.rotation.y = this.car.c.yaw + Math.PI / 2 + Math.PI / 2;\n      this.jackBar.visible = true; this.jackBar.position.copy(this.jackAt).setY(this.jackAt.y + 0.2); this.jackBar.rotation.y = this.car.c.yaw;\n      this.spare.forEach((m, i) => { const q = this.spots[i * 2 + 1]; m.visible = true; m.position.set(q.x, q.y + 0.3, q.z); });\n    } else if (this.state === 'leave') {\n      if (view) view.jack = Math.max(0, view.jack - dt * 0.8);\n      let all = true; this.people.forEach((p, i) => { if (moveTo(p, this.waits[i], 8) > 0.15) all = false; });\n      this.spare.forEach((m) => { m.visible = false; });\n      if (all || this.t > 1.4) { this.state = 'off'; this.group.visible = false; if (view) view.jack = 0; }\n    }\n  }\n}\nvoid trackPoint; void PIT_WIDTH;\nEOF\ncat > src/game/render/director.js <<'EOF'\n// The replay director: camera posts every ~280 m beside the road, some authored shots, and a cut every 4 to 8 s toward what is interesting.\nimport { THREE } from '../../pixel-engine.js';\nimport { trackPoint, wrapS } from '../sim/race.js';\nconst { Vector3 } = THREE;\nexport class TvDirector {\n  constructor(tr, field, seed = 7) {\n    this.tr = tr; this.posts = []; this.shot = null; this.cutT = 0; this.pos = new Vector3(); this.look = new Vector3(); let s = 0, a = seed;\n    const rnd = () => { a = (a * 1664525 + 1013904223) >>> 0; return a / 4294967296; };\n    while (s < tr.length) {\n      const side = rnd() > 0.5 ? 1 : -1, i = Math.round(s / tr.ds) % tr.N, wall = side > 0 ? tr.wallR[i] : tr.wallL[i], off = tr.width[i] / 2 + Math.max(wall + 2, 15 + rnd() * 10), x = tr.x[i] - tr.tz[i] * off * side, z = tr.z[i] + tr.tx[i] * off * side;\n      this.posts.push({ s, x, y: tr.y[i] + 3 + rnd() * 5 + (tr.surface === 'dirt' ? 3 : 0), z, fov: 18 + rnd() * 12 });\n      s += 240 + rnd() * 80;\n    }\n    // Authored: low at the start line, a helicopter on the straight, the gantry.\n    const a0 = trackPoint(tr, 6, tr.width[0] / 2 + 2.2); this.posts.push({ s: 0, x: a0.x, y: a0.y + 0.7, z: a0.z, fov: 32, low: true });\n    const h = trackPoint(tr, -200, 0); this.heli = { s: -200, x: h.x, y: h.y + 42, z: h.z, fov: 24, heli: true };\n    const g = trackPoint(tr, 3, 0); this.posts.push({ s: 40, x: g.x, y: g.y + 8.6, z: g.z, fov: 40, gantry: true });\n    this.posts.sort((p, q) => p.s - q.s);\n  }\n  // The next post ahead of the focus.\n  pick(s) {\n    const tr = this.tr; let best = this.posts[0], bd = Infinity;\n    for (const p of this.posts) { const d = wrapS(tr, p.s - s - 50); if (d < bd && p !== this.shot) { bd = d; best = p; } }\n    return best;\n  }\n  force() { this.cutT = 0; }\n  // focus: { x, y, z, s }. Returns true on a cut.\n  update(dt, focus, cam, { busy = false } = {}) {\n    this.cutT -= dt; let cut = false;\n    const shot = this.shot;\n    const dist = shot ? Math.hypot(shot.x - focus.x, shot.z - focus.z) : 1e9, behind = shot ? wrapS(this.tr, focus.s - shot.s) : 0;\n    if (!shot || this.cutT <= 0 || dist > 170 || (behind < this.tr.length / 2 && behind > 110 && !shot.heli)) {\n      this.shot = this.pick(focus.s); this.cutT = 4 + (Math.abs(Math.sin(focus.s * 13.1)) * 4) - (busy ? 1.5 : 0); cut = true;\n      if (Math.abs(Math.sin(focus.s * 3.3)) > 0.93 && this.heli) { this.shot = this.heli; this.heli.x = focus.x + 20; this.heli.z = focus.z - 34; this.heli.y = focus.y + 36; }\n    }\n    const S = this.shot;\n    this.pos.set(S.x, S.y, S.z);\n    if (S.heli) { S.x += (focus.x + 16 - S.x) * Math.min(1, dt * 0.8); S.z += (focus.z - 30 - S.z) * Math.min(1, dt * 0.8); }\n    this.look.set(focus.x, focus.y + 0.7, focus.z);\n    cam.position.copy(this.pos); cam.lookAt(this.look);\n    const d2 = this.pos.distanceTo(this.look), wantFov = S.low || S.gantry ? S.fov : Math.max(12, Math.min(44, (S.fov * 60) / Math.max(30, d2)));\n    cam.fov = wantFov; cam.updateProjectionMatrix();\n    return cut;\n  }\n}\nEOF\ncat > src/game/ui/racehud.js <<'EOF'\n// The race HUD. Position top-left, times top-right, speed and gear bottom-right, map and tyres bottom-left. The middle stays clear.\nimport { formatTime } from '../sim/race.js';\nconst wearColour = (w) => (w > 0.65 ? 'lime' : w > 0.38 ? 'sand' : w > 0.18 ? 'orange' : 'red');\nexport class RaceHud {\n  constructor(sim, compact = false) {\n    this.sim = sim; this.compact = compact; this.msg = null; this.msgT = 0; this.big = null; this.bigT = 0;\n    const tr = sim.tr, pts = []; let minX = Infinity, maxX = -Infinity, minZ = Infinity, maxZ = -Infinity;\n    for (let i = 0; i < tr.N; i++) { minX = Math.min(minX, tr.x[i]); maxX = Math.max(maxX, tr.x[i]); minZ = Math.min(minZ, tr.z[i]); maxZ = Math.max(maxZ, tr.z[i]); }\n    this.mapSize = compact ? 34 : 54; const k = (this.mapSize - 2) / Math.max(maxX - minX, maxZ - minZ); this.mapK = k; this.minX = minX; this.minZ = minZ; this.maxX = maxX; this.maxZ = maxZ;\n    this.mapW = Math.round((maxX - minX) * k) + 2; this.mapH = Math.round((maxZ - minZ) * k) + 2;\n    const seen = new Set();\n    for (let i = 0; i < tr.N; i += 2) { const px = Math.round((maxX - tr.x[i]) * k), pz = Math.round((tr.z[i] - minZ) * k), key = px * 1000 + pz; if (!seen.has(key)) { seen.add(key); pts.push(px, pz); } }\n    this.pts = pts;\n  }\n  flash(text, seconds = 2.2, big = false) { if (big) { this.big = text; this.bigT = seconds; } else { this.msg = text; this.msgT = seconds; } }\n  mapAt(ui, x, y, car, mine) {\n    const hud = ui.hud, p = this.pts;\n    ui.panel(x - 2, y - 2, this.mapW + 4, this.mapH + 4, { color: 'ink', border: false, scan: true });\n    for (let i = 0; i < p.length; i += 2) hud.rect(x + p[i], y + this.mapH - p[i + 1] - 1, 1, 1, 'mist');\n    const dot = (cx, cz, col, size) => { const px = Math.round((this.maxX - cx) * this.mapK), pz = Math.round((cz - this.minZ) * this.mapK); hud.rect(x + px - (size >> 1), y + this.mapH - pz - 1 - (size >> 1), size, size, col); };\n    for (const e of this.sim.cars) if (e !== car) dot(e.c.x, e.c.z, e.player !== null ? 'sky' : 'red', 2);\n    if (mine) dot(car.c.x, car.c.z, 'sand', 3);\n  }\n  // Draws around a car. o: { units, assists, slipOn, dev, flags, test: judge, recover, showMap, ghosts }\n  draw(ui, car, dt, o = {}) {\n    const sim = this.sim, c = car.c, w = ui.w, h = ui.h, hud = ui.hud, compact = this.compact, kmh = o.units !== 'mph', speed = Math.abs(c.u) * (kmh ? 3.6 : 2.237), p = c.p;\n    // ---- top-left: position and lap ----\n    if (!o.test) {\n      const raceN = sim.cars.filter((e) => !e.ghost).length;\n      if (raceN > 1) ui.text(6, 5, `P${car.pos}`, { scale: 2, color: car.pos === 1 ? 'sand' : 'white' });\n      if (raceN > 1) ui.text(6 + hud.measure(`P${car.pos}`, 2).width + 2, 11, `/${raceN}`, { color: 'mist' });\n      if (sim.laps > 0) { const lapNow = Math.max(1, Math.min(car.lap, sim.laps)); ui.text(6, 22, `LAP ${lapNow}/${sim.laps}`, { color: car.lap === sim.laps ? 'sand' : 'mist' }); }\n      else if (car.lap > 0) ui.text(6, 22, `LAP ${car.lap}`, { color: 'mist' });\n    }\n    // ---- top-right: time, best lap, gap ----\n    const rx = w - 6; let ry = 5;\n    if (o.test) {\n      const J = o.test; ui.text(rx, ry, formatTime(J.total), { align: 'right', scale: compact ? 1 : 2, color: J.running ? 'white' : 'mist' }); ry += 18;\n      const m = J.test.medals;\n      if (m) { for (const [name, col] of [['gold', 'sand'], ['silver', 'mist'], ['bronze', 'orange']]) { const passed = J.total > m[name], dim = passed ? 'slate' : col; ui.text(rx, ry, `${name.toUpperCase()} ${formatTime(m[name] / (J.test.legs?.length ?? 1) * (J.test.legs?.length ?? 1))}`, { align: 'right', color: dim }); ry += 10; } }\n      if (J.penalty > 0) { ui.text(rx, ry, `+${J.penalty.toFixed(0)} S PENALTY`, { align: 'right', color: 'red' }); ry += 10; }\n      if (o.legText) { ui.text(rx, ry, o.legText, { align: 'right', color: 'sky' }); ry += 10; }\n    } else {\n      const t = car.ownStart !== null ? sim.time - car.ownStart : 0, lapT = car.lapStart !== null ? sim.time - car.lapStart : 0;\n      if (!compact) { ui.text(rx, ry, formatTime(car.finished ? car.finishTime : t), { align: 'right', color: 'white' }); ry += 10; }\n      ui.text(rx, ry, `LAP ${formatTime(lapT)}`, { align: 'right', color: 'mist' }); ry += 10;\n      if (car.bestLap) { ui.text(rx, ry, `BEST ${formatTime(car.bestLap)}`, { align: 'right', color: 'sand' }); ry += 10; }\n      if (o.rival) { const g = sim.clockGap(car, o.rival); if (g !== null) { ui.text(rx, ry, `${g <= 0 ? '-' : '+'}${Math.abs(g).toFixed(2)}`, { align: 'right', color: g <= 0 ? 'lime' : 'red' }); ry += 10; } }\n      else if (sim.cars.length > 1) { const g = sim.gapAhead(car); if (g !== null && g < 99) { ui.text(rx, ry, `AHEAD +${g.toFixed(1)}`, { align: 'right', color: 'mist' }); ry += 10; } const b = sim.gapBehind(car); if (b !== null && b < 99 && !compact) { ui.text(rx, ry, `BEHIND -${b.toFixed(1)}`, { align: 'right', color: 'slate' }); ry += 10; } }\n      if (o.ghostGap !== undefined && o.ghostGap !== null) { ui.text(rx, ry, `GHOST ${o.ghostGap >= 0 ? '+' : ''}${o.ghostGap.toFixed(2)}`, { align: 'right', color: o.ghostGap <= 0 ? 'lime' : 'orange' }); ry += 10; }\n    }\n    // ---- bottom-right: speed and gear with the rev bar ----\n    const sc = compact ? 2 : 3, spTxt = String(Math.round(speed)), gearTxt = car.reverse ? 'R' : c.shift > 0 ? '-' : String(c.gear), by = h - 8 - 7 * sc;\n    ui.text(rx - (compact ? 16 : 26), by, spTxt, { align: 'right', scale: sc });\n    ui.text(rx - (compact ? 16 : 26), by - 9, kmh ? 'KM/H' : 'MPH', { align: 'right', color: 'mist' });\n    ui.text(rx, by, gearTxt, { align: 'right', scale: sc, color: c.rpm > p.upshift ? 'red' : 'sand' });\n    const segs = compact ? 10 : 18, segW = compact ? 5 : 5, bx = rx - segs * (segW + 1), byy = by - 18 - (compact ? 0 : 0), frac = Math.min(1, c.rpm / p.redline);\n    for (let k = 0; k < segs; k++) { const f = (k + 1) / segs, on = frac >= f - 0.01, col = f > 0.92 ? 'red' : f > 0.8 ? 'orange' : 'lime'; ui.rect(bx + k * (segW + 1), byy, segW, 4, on ? col : 'night'); }\n    if (c.rpm > p.upshift && !car.reverse) ui.rect(bx - 7, byy, 5, 4, Math.floor(ui.time * 16) % 2 ? 'white' : 'red');\n    // ---- bottom-left: map, tyres, fuel, assists ----\n    const mx = 6, my = h - this.mapH - 8;\n    if (o.showMap !== false) this.mapAt(ui, mx, my, car, true);\n    const tx = mx + this.mapW + 7, ty = h - 22, sq = 6;\n    [[0, 0, 0], [1, 1, 0], [2, 0, 1], [3, 1, 1]].forEach(([i, cx, cy]) => { const col = wearColour(c.wear[i]); ui.rect(tx + cx * (sq + 2) - 1, ty + cy * (sq + 2) - 1, sq + 2, sq + 2, 'ink'); ui.rect(tx + cx * (sq + 2), ty + cy * (sq + 2), sq, sq, col); });\n    if (o.fuel) { ui.text(tx, ty - 18, 'FUEL', { color: c.fuel < 0.15 ? 'red' : 'mist' }); ui.bar(tx, ty - 9, 40, 4, c.fuel, c.fuel < 0.15 ? 'red' : 'sky', 'ink'); }\n    if (!compact) { let ax = tx + 20, ay = ty; for (const [on, t] of [[c.absOn, 'ABS'], [c.tcsOn, 'TCS'], [c.asmOn, 'STB']]) { if (on) { ui.rect(ax - 1, ay - 1, 20, 9, 'orange'); ui.text(ax, ay, t, { color: 'ink', shadow: false }); ay += 0; ax += 22; } } if (car.slip) ui.text(tx + 20, ty + 9, 'SLIP', { color: 'cyan' }); }\n    if (o.dev) ui.text(6, 32, 'DEV', { color: 'red' });\n    // ---- centre-top: flags and messages ----\n    const cy = compact ? 34 : 38;\n    if (this.bigT > 0) { this.bigT -= dt; ui.text(ui.cx, cy, this.big, { align: 'center', scale: compact ? 2 : 3, color: 'sand' }); }\n    if (this.msgT > 0) { this.msgT -= dt; ui.text(ui.cx, cy + 26, this.msg, { align: 'center', color: 'white' }); }\n    if (car.wrongWay) ui.text(ui.cx, cy + 40, 'WRONG WAY', { align: 'center', scale: 2, color: 'red' });\n    if (car.pit) {\n      const P = car.pit; ui.text(ui.cx, cy, 'PIT', { align: 'center', scale: 2, color: 'sand' });\n      if (P.phase === 'box') { const left = Math.max(P.tyres, P.fuel) - P.svc; ui.text(ui.cx, cy + 18, `${Math.max(0, left).toFixed(1)} S`, { align: 'center', color: 'white' }); if (P.tyres > 0 && !P.skipTyres && o.skipPrompt) ui.text(ui.cx, cy + 30, o.skipPrompt, { align: 'center', color: 'mist' }); }\n    }\n    if (o.recover > 0 && !car.pit) { ui.text(ui.cx, h - 70, 'RECOVERING', { align: 'center', color: 'sand' }); ui.bar(ui.cx - 30, h - 60, 60, 4, o.recover, 'sand'); }\n    else if (o.recoverHint) ui.text(ui.cx, h - 60, o.recoverHint, { align: 'center', color: 'mist' });\n    void hud;\n  }\n}\nEOF\necho ok","description":"Write animation clips, people, pit crew, TV director and race HUD"}}}
