{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkijBCs3vfqKNmA4nJV5","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"The API work is done, and I'm now setting up the build tool, the test runner, and a first sim suite that checks the plan's regression numbers.\n\n","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10711,"cache_read_input_tokens":156959,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10711},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"0a8ba193-6297-49ba-82d2-f0c5ad8f9690","timestamp":"2026-11-06T00:23:39.042Z","request_id":"req_011CgkijAxFA9kie3shvdqHm","narration_block_indexes":[0],"thinking_duration_ms":1,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkijBCs3vfqKNmA4nJV5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WQAgsqNcoJ9uoCiuqq4rVa","name":"Bash","input":{"command":"cat > package.json <<'EOF'\n{ \"name\": \"gran-tumbleweed\", \"version\": \"1.0.0\", \"private\": true, \"type\": \"module\",\n  \"scripts\": { \"build\": \"node tools/build.mjs\", \"test\": \"node tools/test.mjs\" },\n  \"devDependencies\": { \"playwright\": \"1.63.0\" } }\nEOF\ncat > .gitignore <<'EOF'\nnode_modules/\n.dl/\ncheck/\ntools/.testcache.json\ntools/.bundle.js\nshots/\nEOF\nnpm install --silent --no-audit --no-fund 2>&1 | tail -2\n# hub meta tags\ncat > tools/hub-metas.html <<'EOF'\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:session-goal\" content=\"Lowest time wins: same car, same track\">\n<meta name=\"hub:session-howto\" content=\"Steer stick or A D. R2 or W go. L2 or S brake.\">\n<meta name=\"hub:webgpu\" content=\"required\">\n<meta name=\"hub:type\" content=\"Game\">\n<meta name=\"hub:players\" content=\"1-2\">\nEOF\ncat > tools/build.mjs <<'EOF'\n// node tools/build.mjs [output.html]: bundles the game into one HTML file. session.js goes in unmodified, first in <head>.\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync, writeFileSync, rmSync, existsSync } from 'node:fs';\nimport { dirname, resolve, basename } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst root = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nprocess.chdir(root);\nconst out = process.argv[2] ?? resolve(root, '..', `${basename(root)}.html`);\nconst bundle = 'tools/.bundle.js';\n\n// The exit interview is the one source of the About screen, so it and the chat reply can't drift apart.\nconst interview = resolve(root, '..', 'exit-interview.json');\nconst about = existsSync(interview) ? JSON.parse(readFileSync(interview, 'utf8')) : null;\nconst credits = readFileSync('src/CREDITS.md', 'utf8');\nwriteFileSync('src/game/data/about.gen.js', `// Generated by tools/build.mjs from exit-interview.json and the kit's CREDITS.md. Do not edit.\\nexport const INTERVIEW = ${JSON.stringify(about)};\\nexport const KIT_CREDITS = ${JSON.stringify(credits)};\\n`);\n\nexecFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--target=esnext', '--charset=utf8', '--legal-comments=none', '--log-level=warning', `--outfile=${bundle}`], { stdio: 'inherit' });\nconst js = readFileSync(bundle, 'utf8').replace(/<\\/script/gi, '<\\\\/script');\nrmSync(bundle);\nconst session = readFileSync('tools/hub/session.js', 'utf8'); // the client, unmodified\nconst metas = readFileSync('tools/hub-metas.html', 'utf8');\nconst title = /export const TITLE = '([^']+)'/.exec(readFileSync('src/game/data/meta.js', 'utf8'))?.[1] ?? '';\nconst html = `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>${session}</script><title>${title}</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<link rel=\"icon\" href=\"data:,\">\n${metas}\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#row{display:flex;width:100vw;height:100vh}#p1{position:relative;width:100vw;height:100vh;overflow:hidden}#p2{display:none;position:relative;height:100vh;overflow:hidden}</style>\n</head><body><div id=\"row\"><div id=\"p1\"></div><div id=\"p2\"></div></div><script type=\"module\">${js}</script></body></html>`;\nwriteFileSync(out, html);\nconsole.log(`built ${out} (${(html.length / 1048576).toFixed(1)} MB)`);\nEOF\ncat > tools/test.mjs <<'EOF'\n// node tools/test.mjs [suite...]: runs the suites, skipping any whose files haven't changed since it last passed.\n// Prints failures, then one line: \"tests: N passed, M failed\". Pass --force to ignore the cache.\nimport { spawnSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';\nimport { dirname, join, resolve, basename } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst root = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nprocess.chdir(root);\nconst HTML = resolve(root, '..', `${basename(root)}.html`);\nconst ALL = ['sim', 'data', 'career', 'headless', 'play', 'browser', 'audio', 'hub'];\n// What each suite reads: when none of it changes, the suite is skipped.\nconst COVERS = {\n  sim: ['src/game/sim', 'src/game/data'],\n  data: ['src/game/data', 'src/game/sim'],\n  career: ['src/game/sim', 'src/game/data'],\n  headless: ['src/game', 'src/main.js'],\n  play: ['src/game', 'src/main.js'],\n  browser: [HTML],\n  audio: [HTML],\n  hub: [HTML, 'tools/hub'],\n};\nconst args = process.argv.slice(2), force = args.includes('--force'), want = args.filter((a) => !a.startsWith('--'));\nconst suites = want.length ? want : ALL;\nconst cacheFile = 'tools/.testcache.json';\nconst cache = existsSync(cacheFile) ? JSON.parse(readFileSync(cacheFile, 'utf8')) : {};\nconst files = (p) => { if (!existsSync(p)) return []; if (statSync(p).isFile()) return [p]; return readdirSync(p).sort().flatMap((n) => files(join(p, n))); };\nconst hashOf = (s) => { const h = createHash('sha1'); for (const f of [`tools/tests/${s}.mjs`, 'tools/tests/_lib.mjs', ...(COVERS[s] ?? []).flatMap(files)]) if (existsSync(f)) h.update(f).update(readFileSync(f)); return h.digest('hex'); };\nlet passed = 0, failed = 0;\nfor (const s of suites) {\n  const hash = hashOf(s);\n  if (!force && cache[s]?.hash === hash) { passed += cache[s].passed; continue; }\n  const r = spawnSync(process.execPath, [`tools/tests/${s}.mjs`], { encoding: 'utf8', maxBuffer: 1 << 28, env: { ...process.env, GAME_HTML: HTML } });\n  const line = (r.stdout ?? '').trim().split('\\n').filter((l) => l.startsWith('@@RESULT ')).pop();\n  const res = line ? JSON.parse(line.slice(9)) : { passed: 0, failed: 1, failures: [`suite ${s} crashed (exit ${r.status}): ${(r.stderr ?? '').trim().split('\\n').slice(0, 12).join(' | ')}`] };\n  passed += res.passed; failed += res.failed;\n  for (const f of res.failures) console.log(`FAIL ${s}: ${f}`);\n  if (res.failed === 0) { cache[s] = { hash, passed: res.passed }; } else delete cache[s];\n  writeFileSync(cacheFile, JSON.stringify(cache));\n}\nconsole.log(`tests: ${passed} passed, ${failed} failed`);\nprocess.exit(failed ? 1 : 0);\nEOF\ncat > tools/tests/_lib.mjs <<'EOF'\n// A very small test harness. Suites call t.ok / t.near and finish with t.done().\nexport function suite() {\n  const failures = []; let passed = 0;\n  const t = {\n    ok(cond, msg) { if (cond) passed++; else failures.push(msg); return !!cond; },\n    near(a, b, tol, msg) { return t.ok(Math.abs(a - b) <= tol, `${msg}: got ${typeof a === 'number' ? a.toFixed(2) : a}, want ${b} +/- ${tol}`); },\n    eq(a, b, msg) { return t.ok(a === b, `${msg}: got ${a}, want ${b}`); },\n    done() { process.stdout.write(`\\n@@RESULT ${JSON.stringify({ passed, failed: failures.length, failures })}\\n`); process.exit(0); },\n  };\n  return t;\n}\nEOF\ncat > tools/tests/sim.mjs <<'EOF'\n// The regression numbers from the plan: spec sheet, laps at 97% AI pace, determinism, reverse, manual, airborne, contact, wear and fuel.\nimport { suite } from './_lib.mjs';\nimport { aiDrive, buildTrack, carParams, collideCars, newCar, racingLine, speedProfile, stepCar } from '../../src/game/sim/sim.js';\nimport { CARS } from '../../src/game/data/carphysics.js';\nimport { TRACKS } from '../../src/game/data/tracks.js';\nconst t = suite();\nconst SPEC = { pico: [10.5, null, 163, 45], kite: [7.4, 36.1, 214, 43], ginga: [6.6, 24.0, 243, 43], moth: [6.7, 31.2, 219, 42], brandt32: [6.1, 17.6, 278, 42], ryu: [4.4, 17.3, 243, 41], longhorn: [6.5, 15.9, 285, 43], heck: [4.8, 13.8, 301, 40], libeccio: [5.0, 12.8, 279, 40], kiteCup: [5.8, 18.6, 219, 35], ryuRally: [4.0, 13.1, 217, 41], works: [4.4, 9.8, 289, 32], corsa: [3.8, 8.2, 299, 30], type9: [3.4, 7.0, 314, 27] };\nconst LAPS = { pico: [136, 133, 150, 75, 163, 128], kite: [125, 124, 140, 64, 157, 118], ginga: [122, 120, 135, 59, 146, 115], moth: [123, 121, 135, 61, 145, 115], brandt32: [120, 118, 133, 58, 145, 112], ryu: [117, 115, 127, 57, 139, 110], longhorn: [121, 120, 135, 58, 147, 113], heck: [115, 113, 126, 62, 137, 108], libeccio: [114, 112, 126, 59, 137, 106], kiteCup: [110, 109, 125, 54, 143, 105], ryuRally: [116, 114, 126, 58, 115, 109], works: [104, 102, 115, 49, 142, 97], corsa: [101, 99, 111, 54, 137, 94], type9: [92, 90, 105, 41, 129, 87] };\nconst ORDER = ['kestrel', 'cedar', 'harbour', 'saltline', 'redclay', 'proving'];\nconst tracks = Object.fromEntries(ORDER.map((k) => [k, buildTrack(TRACKS[k])]));\nconst lines = Object.fromEntries(ORDER.map((k) => [k, racingLine(tracks[k])]));\n// A long flat road for the spec sheet.\nconst flat = buildTrack({ corners: [[60000, 0, 300, 0, 40, 0], [60000, 3000, 300, 0, 40, 0], [-60000, 3000, 300, 0, 40, 0], [-60000, 0, 300, 0, 40, 0]], surface: 'asphalt', edge: 'grass', runoff: 20, wearRate: 0 });\nconst NOWEAR = { wearRate: 0, fuelRate: 0 };\nfunction spec(id) {\n  const p = carParams(CARS[id]), c = newCar(p, flat, 0, 0), dt = 1 / 240; let t100 = null, t200 = null, time = 0, top = 0;\n  for (let i = 0; i < 240 * 200; i++) { stepCar(c, { steer: 0, throttle: 1, brake: 0, abs: true, auto: true, tcs: 0.5, asm: 0.5 }, dt, flat, NOWEAR); time += dt; const u = c.u * 3.6; top = Math.max(top, u); if (t100 === null && u >= 100) t100 = time; if (t200 === null && u >= 200) t200 = time; }\n  const c2 = newCar(p, flat, 0, 0); c2.vx = Math.sin(c2.yaw) * (100 / 3.6); c2.vz = Math.cos(c2.yaw) * (100 / 3.6); let x0 = c2.x, z0 = c2.z, guard = 0;\n  while (Math.hypot(c2.vx, c2.vz) > 0.3 && guard++ < 240 * 30) stepCar(c2, { steer: 0, throttle: 0, brake: 1, abs: true, auto: true, tcs: 0.5, asm: 0.5 }, dt, flat, NOWEAR);\n  return { t100, t200, top, stop: Math.hypot(c2.x - x0, c2.z - z0) };\n}\nfor (const id of Object.keys(SPEC)) {\n  const s = spec(id), [a, b, top, stop] = SPEC[id];\n  t.near(s.t100, a, Math.max(0.3, a * 0.05), `${id} 0-100`);\n  if (b !== null) t.near(s.t200 ?? 999, b, Math.max(0.5, b * 0.05), `${id} 0-200`);\n  t.near(s.top, top, top * 0.05, `${id} top speed`);\n  t.near(s.stop, stop, Math.max(2, stop * 0.05), `${id} 100-0`);\n}\nfunction lapTime(id, k, skill = 0.97) {\n  const tr = tracks[k], line = lines[k], p = carParams(CARS[id]), c = newCar(p, tr, 0, 0), speeds = speedProfile(tr, line, p, tr.surface === 'dirt' ? (p.tyreTable?.dirt ?? 0.62) : 1), dt = 1 / 240;\n  let inp = null, laps = 0, lastS = 0, time = 0, lap2 = null, start2 = 0, guard = 0;\n  while (laps < 3 && guard++ < 240 * 900) {\n    if (guard % 4 === 1) inp = aiDrive(c, tr, line, speeds, { skill });\n    stepCar(c, inp, dt, tr, NOWEAR); time += dt;\n    if (lastS > tr.length * 0.9 && c.loc.s < tr.length * 0.1) { laps++; if (laps === 1) start2 = time; if (laps === 2) lap2 = time - start2; }\n    lastS = c.loc.s;\n  }\n  return lap2 ?? 9999;\n}\nfor (const id of Object.keys(LAPS)) ORDER.forEach((k, i) => t.near(lapTime(id, k), LAPS[id][i], 3, `${id} on ${k} lap`));\n// Determinism\nconst run = () => { const tr = tracks.kestrel, cars = ['ginga', 'kite', 'ryu'].map((id, i) => newCar(carParams(CARS[id]), tr, i * 3 + 1, i % 2 ? 2 : -2)), sp = cars.map((c) => speedProfile(tr, lines.kestrel, c.p)); for (let f = 0; f < 3600; f++) { const inps = cars.map((c, i) => aiDrive(c, tr, lines.kestrel, sp[i], { skill: 0.95 }, cars)); for (let s = 0; s < 4; s++) { cars.forEach((c, i) => stepCar(c, inps[i], 1 / 240, tr)); collideCars(cars); } } return cars.map((c) => `${c.x.toFixed(4)},${c.z.toFixed(4)},${c.wear[0].toFixed(5)}`).join('|'); };\nt.eq(run(), run(), 'same inputs give the same race');\n// Reverse\n{ const tr = tracks.proving, c = newCar(carParams(CARS.kite), tr, 0, 0); for (let i = 0; i < 480; i++) stepCar(c, { steer: 0, throttle: 0.8, brake: 0, reverse: true, abs: true, auto: true }, 1 / 240, tr); t.ok(c.u < -1, `reverse moves backward: ${c.u}`); }\n// Manual gears\n{ const tr = tracks.proving, c = newCar(carParams(CARS.ginga), tr, 0, 0); stepCar(c, { steer: 0, throttle: 1, brake: 0, auto: false, up: true }, 1 / 240, tr); t.eq(c.gear, 2, 'manual upshift works'); for (let i = 0; i < 240; i++) stepCar(c, { steer: 0, throttle: 1, brake: 0, auto: false }, 1 / 240, tr); const g = c.gear; c.shift = 0; c.vx = Math.sin(c.yaw) * 75; c.vz = Math.cos(c.yaw) * 75; stepCar(c, { steer: 0, throttle: 1, brake: 0, auto: false, down: true }, 1 / 240, tr); t.eq(c.gear, g, 'a downshift that would over-rev is refused'); }\n// Airborne on Red Clay's crest\n{ const tr = tracks.redclay, line = lines.redclay, c = newCar(carParams(CARS.ryuRally), tr, 0, 0), sp = speedProfile(tr, line, c.p, 0.72); let air = 0; for (let f = 0; f < 60 * 240; f++) { const inp = aiDrive(c, tr, line, sp, { skill: 1 }); for (let s = 0; s < 4; s++) stepCar(c, inp, 1 / 240, tr, NOWEAR); if (c.airborne) air += 1 / 60; } t.ok(air > 0.1, `crests lift the car: ${air.toFixed(2)} s`); }\n// Contact doesn't explode\n{ const tr = tracks.kestrel, line = lines.kestrel, cars = []; for (let i = 0; i < 8; i++) cars.push(newCar(carParams(CARS.ginga), tr, (tr.N - i * 3) % tr.N, i % 2 ? 2.2 : -2.2)); const sp = speedProfile(tr, line, cars[0].p); let maxV = 0; for (let f = 0; f < 60 * 120; f++) { const inps = cars.map((c) => aiDrive(c, tr, line, sp, { skill: 0.95 }, cars)); for (let s = 0; s < 4; s++) { cars.forEach((c, i) => stepCar(c, inps[i], 1 / 240, tr)); collideCars(cars); } for (const c of cars) maxV = Math.max(maxV, Math.hypot(c.vx, c.vz)); } t.ok(maxV < 90 && cars.every((c) => Number.isFinite(c.x)), `an 8-car race stays sane: max ${maxV.toFixed(1)} m/s`); }\n// Wear and fuel over ten laps at Harbour\n{ const tr = tracks.harbour, line = lines.harbour, c = newCar(carParams(CARS.libeccio), tr, 0, 0), sp = speedProfile(tr, line, c.p); let laps = 0, last = 0, g = 0; while (laps < 8 && g++ < 60 * 1500) { const inp = aiDrive(c, tr, line, sp, { skill: 0.95 }); for (let s = 0; s < 4; s++) stepCar(c, inp, 1 / 240, tr); if (last > tr.length * 0.9 && c.loc.s < tr.length * 0.1) laps++; last = c.loc.s; } const mean = c.wear.reduce((a, b) => a + b) / 4; t.ok(mean < 0.7, `tyres wear over distance: ${mean.toFixed(2)}`); t.ok(c.fuel < 0.55, `fuel falls over distance: ${c.fuel.toFixed(2)}`); }\nt.done();\nEOF\nmkdir -p src/game/data && time node tools/test.mjs sim --force","description":"Create build tool, test runner and sim regression suite, then run it","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10711,"cache_read_input_tokens":156959,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10711},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"647dd264-a637-4032-b99b-f830f064d5a2","timestamp":"2026-11-06T00:24:29.744Z","request_id":"req_011CgkijAxFA9kie3shvdqHm","wire_tool_inputs":{"toolu_01WQAgsqNcoJ9uoCiuqq4rVa":{"command":"cat > package.json <<'EOF'\n{ \"name\": \"gran-tumbleweed\", \"version\": \"1.0.0\", \"private\": true, \"type\": \"module\",\n  \"scripts\": { \"build\": \"node tools/build.mjs\", \"test\": \"node tools/test.mjs\" },\n  \"devDependencies\": { \"playwright\": \"1.63.0\" } }\nEOF\ncat > .gitignore <<'EOF'\nnode_modules/\n.dl/\ncheck/\ntools/.testcache.json\ntools/.bundle.js\nshots/\nEOF\nnpm install --silent --no-audit --no-fund 2>&1 | tail -2\n# hub meta tags\ncat > tools/hub-metas.html <<'EOF'\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:session-goal\" content=\"Lowest time wins: same car, same track\">\n<meta name=\"hub:session-howto\" content=\"Steer stick or A D. R2 or W go. L2 or S brake.\">\n<meta name=\"hub:webgpu\" content=\"required\">\n<meta name=\"hub:type\" content=\"Game\">\n<meta name=\"hub:players\" content=\"1-2\">\nEOF\ncat > tools/build.mjs <<'EOF'\n// node tools/build.mjs [output.html]: bundles the game into one HTML file. session.js goes in unmodified, first in <head>.\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync, writeFileSync, rmSync, existsSync } from 'node:fs';\nimport { dirname, resolve, basename } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst root = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nprocess.chdir(root);\nconst out = process.argv[2] ?? resolve(root, '..', `${basename(root)}.html`);\nconst bundle = 'tools/.bundle.js';\n\n// The exit interview is the one source of the About screen, so it and the chat reply can't drift apart.\nconst interview = resolve(root, '..', 'exit-interview.json');\nconst about = existsSync(interview) ? JSON.parse(readFileSync(interview, 'utf8')) : null;\nconst credits = readFileSync('src/CREDITS.md', 'utf8');\nwriteFileSync('src/game/data/about.gen.js', `// Generated by tools/build.mjs from exit-interview.json and the kit's CREDITS.md. Do not edit.\\nexport const INTERVIEW = ${JSON.stringify(about)};\\nexport const KIT_CREDITS = ${JSON.stringify(credits)};\\n`);\n\nexecFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--target=esnext', '--charset=utf8', '--legal-comments=none', '--log-level=warning', `--outfile=${bundle}`], { stdio: 'inherit' });\nconst js = readFileSync(bundle, 'utf8').replace(/<\\/script/gi, '<\\\\/script');\nrmSync(bundle);\nconst session = readFileSync('tools/hub/session.js', 'utf8'); // the client, unmodified\nconst metas = readFileSync('tools/hub-metas.html', 'utf8');\nconst title = /export const TITLE = '([^']+)'/.exec(readFileSync('src/game/data/meta.js', 'utf8'))?.[1] ?? '';\nconst html = `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>${session}</script><title>${title}</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<link rel=\"icon\" href=\"data:,\">\n${metas}\n<style>html,body{margin:0;height:100%;background:#000;overflow:hidden}#row{display:flex;width:100vw;height:100vh}#p1{position:relative;width:100vw;height:100vh;overflow:hidden}#p2{display:none;position:relative;height:100vh;overflow:hidden}</style>\n</head><body><div id=\"row\"><div id=\"p1\"></div><div id=\"p2\"></div></div><script type=\"module\">${js}</script></body></html>`;\nwriteFileSync(out, html);\nconsole.log(`built ${out} (${(html.length / 1048576).toFixed(1)} MB)`);\nEOF\ncat > tools/test.mjs <<'EOF'\n// node tools/test.mjs [suite...]: runs the suites, skipping any whose files haven't changed since it last passed.\n// Prints failures, then one line: \"tests: N passed, M failed\". Pass --force to ignore the cache.\nimport { spawnSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { existsSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';\nimport { dirname, join, resolve, basename } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst root = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nprocess.chdir(root);\nconst HTML = resolve(root, '..', `${basename(root)}.html`);\nconst ALL = ['sim', 'data', 'career', 'headless', 'play', 'browser', 'audio', 'hub'];\n// What each suite reads: when none of it changes, the suite is skipped.\nconst COVERS = {\n  sim: ['src/game/sim', 'src/game/data'],\n  data: ['src/game/data', 'src/game/sim'],\n  career: ['src/game/sim', 'src/game/data'],\n  headless: ['src/game', 'src/main.js'],\n  play: ['src/game', 'src/main.js'],\n  browser: [HTML],\n  audio: [HTML],\n  hub: [HTML, 'tools/hub'],\n};\nconst args = process.argv.slice(2), force = args.includes('--force'), want = args.filter((a) => !a.startsWith('--'));\nconst suites = want.length ? want : ALL;\nconst cacheFile = 'tools/.testcache.json';\nconst cache = existsSync(cacheFile) ? JSON.parse(readFileSync(cacheFile, 'utf8')) : {};\nconst files = (p) => { if (!existsSync(p)) return []; if (statSync(p).isFile()) return [p]; return readdirSync(p).sort().flatMap((n) => files(join(p, n))); };\nconst hashOf = (s) => { const h = createHash('sha1'); for (const f of [`tools/tests/${s}.mjs`, 'tools/tests/_lib.mjs', ...(COVERS[s] ?? []).flatMap(files)]) if (existsSync(f)) h.update(f).update(readFileSync(f)); return h.digest('hex'); };\nlet passed = 0, failed = 0;\nfor (const s of suites) {\n  const hash = hashOf(s);\n  if (!force && cache[s]?.hash === hash) { passed += cache[s].passed; continue; }\n  const r = spawnSync(process.execPath, [`tools/tests/${s}.mjs`], { encoding: 'utf8', maxBuffer: 1 << 28, env: { ...process.env, GAME_HTML: HTML } });\n  const line = (r.stdout ?? '').trim().split('\\n').filter((l) => l.startsWith('@@RESULT ')).pop();\n  const res = line ? JSON.parse(line.slice(9)) : { passed: 0, failed: 1, failures: [`suite ${s} crashed (exit ${r.status}): ${(r.stderr ?? '').trim().split('\\n').slice(0, 12).join(' | ')}`] };\n  passed += res.passed; failed += res.failed;\n  for (const f of res.failures) console.log(`FAIL ${s}: ${f}`);\n  if (res.failed === 0) { cache[s] = { hash, passed: res.passed }; } else delete cache[s];\n  writeFileSync(cacheFile, JSON.stringify(cache));\n}\nconsole.log(`tests: ${passed} passed, ${failed} failed`);\nprocess.exit(failed ? 1 : 0);\nEOF\ncat > tools/tests/_lib.mjs <<'EOF'\n// A very small test harness. Suites call t.ok / t.near and finish with t.done().\nexport function suite() {\n  const failures = []; let passed = 0;\n  const t = {\n    ok(cond, msg) { if (cond) passed++; else failures.push(msg); return !!cond; },\n    near(a, b, tol, msg) { return t.ok(Math.abs(a - b) <= tol, `${msg}: got ${typeof a === 'number' ? a.toFixed(2) : a}, want ${b} +/- ${tol}`); },\n    eq(a, b, msg) { return t.ok(a === b, `${msg}: got ${a}, want ${b}`); },\n    done() { process.stdout.write(`\\n@@RESULT ${JSON.stringify({ passed, failed: failures.length, failures })}\\n`); process.exit(0); },\n  };\n  return t;\n}\nEOF\ncat > tools/tests/sim.mjs <<'EOF'\n// The regression numbers from the plan: spec sheet, laps at 97% AI pace, determinism, reverse, manual, airborne, contact, wear and fuel.\nimport { suite } from './_lib.mjs';\nimport { aiDrive, buildTrack, carParams, collideCars, newCar, racingLine, speedProfile, stepCar } from '../../src/game/sim/sim.js';\nimport { CARS } from '../../src/game/data/carphysics.js';\nimport { TRACKS } from '../../src/game/data/tracks.js';\nconst t = suite();\nconst SPEC = { pico: [10.5, null, 163, 45], kite: [7.4, 36.1, 214, 43], ginga: [6.6, 24.0, 243, 43], moth: [6.7, 31.2, 219, 42], brandt32: [6.1, 17.6, 278, 42], ryu: [4.4, 17.3, 243, 41], longhorn: [6.5, 15.9, 285, 43], heck: [4.8, 13.8, 301, 40], libeccio: [5.0, 12.8, 279, 40], kiteCup: [5.8, 18.6, 219, 35], ryuRally: [4.0, 13.1, 217, 41], works: [4.4, 9.8, 289, 32], corsa: [3.8, 8.2, 299, 30], type9: [3.4, 7.0, 314, 27] };\nconst LAPS = { pico: [136, 133, 150, 75, 163, 128], kite: [125, 124, 140, 64, 157, 118], ginga: [122, 120, 135, 59, 146, 115], moth: [123, 121, 135, 61, 145, 115], brandt32: [120, 118, 133, 58, 145, 112], ryu: [117, 115, 127, 57, 139, 110], longhorn: [121, 120, 135, 58, 147, 113], heck: [115, 113, 126, 62, 137, 108], libeccio: [114, 112, 126, 59, 137, 106], kiteCup: [110, 109, 125, 54, 143, 105], ryuRally: [116, 114, 126, 58, 115, 109], works: [104, 102, 115, 49, 142, 97], corsa: [101, 99, 111, 54, 137, 94], type9: [92, 90, 105, 41, 129, 87] };\nconst ORDER = ['kestrel', 'cedar', 'harbour', 'saltline', 'redclay', 'proving'];\nconst tracks = Object.fromEntries(ORDER.map((k) => [k, buildTrack(TRACKS[k])]));\nconst lines = Object.fromEntries(ORDER.map((k) => [k, racingLine(tracks[k])]));\n// A long flat road for the spec sheet.\nconst flat = buildTrack({ corners: [[60000, 0, 300, 0, 40, 0], [60000, 3000, 300, 0, 40, 0], [-60000, 3000, 300, 0, 40, 0], [-60000, 0, 300, 0, 40, 0]], surface: 'asphalt', edge: 'grass', runoff: 20, wearRate: 0 });\nconst NOWEAR = { wearRate: 0, fuelRate: 0 };\nfunction spec(id) {\n  const p = carParams(CARS[id]), c = newCar(p, flat, 0, 0), dt = 1 / 240; let t100 = null, t200 = null, time = 0, top = 0;\n  for (let i = 0; i < 240 * 200; i++) { stepCar(c, { steer: 0, throttle: 1, brake: 0, abs: true, auto: true, tcs: 0.5, asm: 0.5 }, dt, flat, NOWEAR); time += dt; const u = c.u * 3.6; top = Math.max(top, u); if (t100 === null && u >= 100) t100 = time; if (t200 === null && u >= 200) t200 = time; }\n  const c2 = newCar(p, flat, 0, 0); c2.vx = Math.sin(c2.yaw) * (100 / 3.6); c2.vz = Math.cos(c2.yaw) * (100 / 3.6); let x0 = c2.x, z0 = c2.z, guard = 0;\n  while (Math.hypot(c2.vx, c2.vz) > 0.3 && guard++ < 240 * 30) stepCar(c2, { steer: 0, throttle: 0, brake: 1, abs: true, auto: true, tcs: 0.5, asm: 0.5 }, dt, flat, NOWEAR);\n  return { t100, t200, top, stop: Math.hypot(c2.x - x0, c2.z - z0) };\n}\nfor (const id of Object.keys(SPEC)) {\n  const s = spec(id), [a, b, top, stop] = SPEC[id];\n  t.near(s.t100, a, Math.max(0.3, a * 0.05), `${id} 0-100`);\n  if (b !== null) t.near(s.t200 ?? 999, b, Math.max(0.5, b * 0.05), `${id} 0-200`);\n  t.near(s.top, top, top * 0.05, `${id} top speed`);\n  t.near(s.stop, stop, Math.max(2, stop * 0.05), `${id} 100-0`);\n}\nfunction lapTime(id, k, skill = 0.97) {\n  const tr = tracks[k], line = lines[k], p = carParams(CARS[id]), c = newCar(p, tr, 0, 0), speeds = speedProfile(tr, line, p, tr.surface === 'dirt' ? (p.tyreTable?.dirt ?? 0.62) : 1), dt = 1 / 240;\n  let inp = null, laps = 0, lastS = 0, time = 0, lap2 = null, start2 = 0, guard = 0;\n  while (laps < 3 && guard++ < 240 * 900) {\n    if (guard % 4 === 1) inp = aiDrive(c, tr, line, speeds, { skill });\n    stepCar(c, inp, dt, tr, NOWEAR); time += dt;\n    if (lastS > tr.length * 0.9 && c.loc.s < tr.length * 0.1) { laps++; if (laps === 1) start2 = time; if (laps === 2) lap2 = time - start2; }\n    lastS = c.loc.s;\n  }\n  return lap2 ?? 9999;\n}\nfor (const id of Object.keys(LAPS)) ORDER.forEach((k, i) => t.near(lapTime(id, k), LAPS[id][i], 3, `${id} on ${k} lap`));\n// Determinism\nconst run = () => { const tr = tracks.kestrel, cars = ['ginga', 'kite', 'ryu'].map((id, i) => newCar(carParams(CARS[id]), tr, i * 3 + 1, i % 2 ? 2 : -2)), sp = cars.map((c) => speedProfile(tr, lines.kestrel, c.p)); for (let f = 0; f < 3600; f++) { const inps = cars.map((c, i) => aiDrive(c, tr, lines.kestrel, sp[i], { skill: 0.95 }, cars)); for (let s = 0; s < 4; s++) { cars.forEach((c, i) => stepCar(c, inps[i], 1 / 240, tr)); collideCars(cars); } } return cars.map((c) => `${c.x.toFixed(4)},${c.z.toFixed(4)},${c.wear[0].toFixed(5)}`).join('|'); };\nt.eq(run(), run(), 'same inputs give the same race');\n// Reverse\n{ const tr = tracks.proving, c = newCar(carParams(CARS.kite), tr, 0, 0); for (let i = 0; i < 480; i++) stepCar(c, { steer: 0, throttle: 0.8, brake: 0, reverse: true, abs: true, auto: true }, 1 / 240, tr); t.ok(c.u < -1, `reverse moves backward: ${c.u}`); }\n// Manual gears\n{ const tr = tracks.proving, c = newCar(carParams(CARS.ginga), tr, 0, 0); stepCar(c, { steer: 0, throttle: 1, brake: 0, auto: false, up: true }, 1 / 240, tr); t.eq(c.gear, 2, 'manual upshift works'); for (let i = 0; i < 240; i++) stepCar(c, { steer: 0, throttle: 1, brake: 0, auto: false }, 1 / 240, tr); const g = c.gear; c.shift = 0; c.vx = Math.sin(c.yaw) * 75; c.vz = Math.cos(c.yaw) * 75; stepCar(c, { steer: 0, throttle: 1, brake: 0, auto: false, down: true }, 1 / 240, tr); t.eq(c.gear, g, 'a downshift that would over-rev is refused'); }\n// Airborne on Red Clay's crest\n{ const tr = tracks.redclay, line = lines.redclay, c = newCar(carParams(CARS.ryuRally), tr, 0, 0), sp = speedProfile(tr, line, c.p, 0.72); let air = 0; for (let f = 0; f < 60 * 240; f++) { const inp = aiDrive(c, tr, line, sp, { skill: 1 }); for (let s = 0; s < 4; s++) stepCar(c, inp, 1 / 240, tr, NOWEAR); if (c.airborne) air += 1 / 60; } t.ok(air > 0.1, `crests lift the car: ${air.toFixed(2)} s`); }\n// Contact doesn't explode\n{ const tr = tracks.kestrel, line = lines.kestrel, cars = []; for (let i = 0; i < 8; i++) cars.push(newCar(carParams(CARS.ginga), tr, (tr.N - i * 3) % tr.N, i % 2 ? 2.2 : -2.2)); const sp = speedProfile(tr, line, cars[0].p); let maxV = 0; for (let f = 0; f < 60 * 120; f++) { const inps = cars.map((c) => aiDrive(c, tr, line, sp, { skill: 0.95 }, cars)); for (let s = 0; s < 4; s++) { cars.forEach((c, i) => stepCar(c, inps[i], 1 / 240, tr)); collideCars(cars); } for (const c of cars) maxV = Math.max(maxV, Math.hypot(c.vx, c.vz)); } t.ok(maxV < 90 && cars.every((c) => Number.isFinite(c.x)), `an 8-car race stays sane: max ${maxV.toFixed(1)} m/s`); }\n// Wear and fuel over ten laps at Harbour\n{ const tr = tracks.harbour, line = lines.harbour, c = newCar(carParams(CARS.libeccio), tr, 0, 0), sp = speedProfile(tr, line, c.p); let laps = 0, last = 0, g = 0; while (laps < 8 && g++ < 60 * 1500) { const inp = aiDrive(c, tr, line, sp, { skill: 0.95 }); for (let s = 0; s < 4; s++) stepCar(c, inp, 1 / 240, tr); if (last > tr.length * 0.9 && c.loc.s < tr.length * 0.1) laps++; last = c.loc.s; } const mean = c.wear.reduce((a, b) => a + b) / 4; t.ok(mean < 0.7, `tyres wear over distance: ${mean.toFixed(2)}`); t.ok(c.fuel < 0.55, `fuel falls over distance: ${c.fuel.toFixed(2)}`); }\nt.done();\nEOF\nmkdir -p src/game/data && time node tools/test.mjs sim --force","description":"Create build tool, test runner and sim regression suite, then run it","timeout":300000}}}
