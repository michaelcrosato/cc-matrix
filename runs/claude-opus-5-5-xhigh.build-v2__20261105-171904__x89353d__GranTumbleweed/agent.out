dclay', 'ryuRally', None, 1), 'redclay2': race('redclay', 'ryuRally', 'q.tr.cornerS[4]-60', 1), 'proving': race('proving', 'kite', None, 0), 'proving2': race('proving', 'kite', 'q.tr.cornerS[4]-30', 0),\n  'dealer': menu('dealer', 'a.ui.top.room=3; a.ui.top.show(true);'), 'mapNight': menu('map'), 'title': \"(async()=>{const a=window.__APP__; a.ui.clear(); await a.toTitle(); })()\",\n}\nnames = sys.argv[1:] or list(SHOTS)\nos.makedirs('shots', exist_ok=True)\nwith sync_playwright() as p:\n    b = p.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'])\n    pg = b.new_page(viewport={'width': 1920, 'height': 1080}); pg.set_default_timeout(70000); errs = []\n    pg.on('pageerror', lambda e: errs.append(str(e)[:200]))\n    pg.goto('file://' + html); pg.wait_for_function('window.__GAME__!==undefined'); pg.wait_for_timeout(1500)\n    for n in names:\n        pg.evaluate(SHOTS[n]); pg.wait_for_timeout(2200); pg.screenshot(path=f'shots/{n}.png')\n    print('shots', len(names), 'errors', errs[:4])\n    b.close()\nEOF\nnode tools/audit.mjs 2>&1 | tail -4 | cut -c1-220; node tools/build.mjs 2>&1 | cut -c1-30 | tail -1; timeout 280 python3 tools/shots.py cedar cedar2 kestrel2 harbour2 redclay2 proving2 saltline dealer title 2>&1 | tail -2 | cut -c1-260; cd shots && magick montage cedar.png cedar2.png kestrel2.png harbour2.png redclay2.png proving2.png saltline.png dealer.png title.png -tile 3x3 -geometry 640x360+2+2 sheet.png 2>/dev/null; cd ..","description":"Correct audit evidence, keep a shots tool, rebuild, render final views","timeout":320000}}}
