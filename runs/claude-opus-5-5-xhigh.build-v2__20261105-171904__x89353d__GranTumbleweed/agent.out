;\nfunction wheelMesh(R, width, style, rimColour) {\n  const spin = new Group(), key = `${R}:${width}`;\n  if (!tyreGeom.has(key)) tyreGeom.set(key, new CylinderGeometry(R, R, width, 12).rotateZ(Math.PI / 2));\n  const tyre = new Mesh(tyreGeom.get(key), toonMaterial(PALETTE.ink));\n  tyre.castShadow = true; tyre.receiveShadow = false; spin.add(tyre);\n  const rimR = R * 0.62, hub = new Mesh(new CylinderGeometry(rimR, rimR, width + 0.03, 8).rotateZ(Math.PI / 2), toonMaterial(PALETTE[rimColour])); spin.add(hub);\n  const [n] = SPOKES[style] ?? SPOKES[0];\n  for (let k = 0; k < n; k++) { const bar = new Mesh(new BoxGeometry(width + 0.06, R * 0.28, rimR * 1.9), toonMaterial(PALETTE.night)); bar.rotation.x = (k / n) * Math.PI; spin.add(bar); }\n  return spin;\n}\nconst mudDefs = new Map();\nfunction mudDefFor(carId) {\n  if (mudDefs.has(carId)) return mudDefs.get(carId);\n  const k = CAR_MODELS[carId], top = 0.66, body = k.body.map(([z, y]) => [z, Math.min(y, top)]);\n  const def = model({ id: `mud-${carId}`, about: 'mud on the lower body', tags: ['vehicle', 'part'], palette: { mud: 'orange' }, parts: [{ slab: body, depth: k.width + 0.05, at: [0, 0, 0], rot: [0, -90, 0], c: 'mud' }], collider: 'none' });\n  mudDefs.set(carId, def);\n  return def;\n}\nexport class CarView {\n  // o: { install, paint, ghost: colourName, scale, noWheelsSpin, tag }\n  constructor(carId, o = {}) {\n    this.carId = carId; this.o = o; this.install = o.install ?? null;\n    this.object = new Group(); this.body = new Group(); this.object.add(this.body); this.wheels = []; this.spin = 0;\n    this.pitch = 0; this.roll = 0; this.heave = 0; this.braking = false; this.headOn = false; this.dirt = 0; this.jack = 0; this.shake = 0; this.yawExtra = 0;\n    this.build();\n    setLookLayer(this.object, 'actors');\n    if (o.scale) this.object.scale.setScalar(o.scale);\n  }\n  build() {\n    const carId = this.carId, kit = CAR_MODELS[carId], row = tunedRow(carId, this.install), paint = this.o.paint ?? this.install?.paint ?? CAR_INFO[carId].paint, phys = PHYSICS[carId], L = row.wheelbase, frontW = row.frontWeight, a = L * (1 - frontW), b = L * frontW, T = row.track ?? 1.5, R = row.wheelR ?? 0.31;\n    this.R = R;\n    const built = buildModel(kit.def, { palette: { paint } });\n    this.bodyModel = built.object;\n    this.bodyModel.position.z = a - L / 2; // the model is centred on its wheelbase; the car's origin is its centre of gravity\n    this.body.add(this.bodyModel);\n    this.paint = paint;\n    for (const m of this.meshes(this.bodyModel)) { m.castShadow = true; m.receiveShadow = false; }\n    // Wheels: steer pivot, then spin group.\n    const style = this.install?.rims ?? 0, rimCol = RIM_COLOURS[style] ?? 'mist', width = row.clA > 1 ? 0.3 : 0.23, wheelZ = [a, a, -b, -b], wheelX = [-T / 2, T / 2, -T / 2, T / 2];\n    for (let i = 0; i < 4; i++) {\n      const pivot = new Group(), spin = wheelMesh(R, width, style, rimCol);\n      pivot.position.set(wheelX[i], R, wheelZ[i]); pivot.add(spin); this.object.add(pivot);\n      this.wheels.push({ pivot, spin, front: i < 2 });\n    }\n    // Brake lamps: bright red, shown only under braking. Head glow is part of the body model; a beam quad sells it at night.\n    this.brake = new Group(); this.brake.visible = false;\n    const tailZ = kit.tailZ - 0.04 + (a - L / 2), red = glowMaterial(PALETTE.red), bright = glowMaterial(0xff5a50);\n    for (const l of kit.lamps) { const xs = l.x === 0 ? [0] : [l.x, -l.x]; for (const x of xs) { const m = new Mesh(new BoxGeometry(l.w + 0.02, l.h + 0.02, 0.02), bright); m.position.set(x, l.y, tailZ); this.brake.add(m); } }\n    this.body.add(this.brake);\n    this.head = new Group(); this.head.visible = false;\n    for (const s of [-1, 1]) { const m = new Mesh(new BoxGeometry(0.34, 0.14, 0.02), glowMaterial(PALETTE.white)); m.position.set(s * (kit.width / 2 - 0.2), kit.headY, kit.noseZ + 0.04 + (a - L / 2)); this.head.add(m); }\n    this.body.add(this.head);\n    void red; void phys;\n    // Parts on the model: lip spoiler, big wing.\n    if (this.install) {\n      if (hasPart(this.install, 'aeroStreet') && !kit.stockWing) { const lip = buildModel(lipSpoiler, { palette: { paint } }).object; lip.position.set(0, kit.body[kit.body.length - 2][1] + 0.01, kit.tailZ + 0.18 + (a - L / 2)); this.body.add(lip); this.shadowAll(lip); }\n      if (hasPart(this.install, 'aeroWing')) { const wing = buildModel(bigWing, { palette: { paint } }).object; wing.position.set(0, kit.body[kit.body.length - 2][1] - 0.02, kit.tailZ + 0.26 + (a - L / 2)); this.body.add(wing); this.shadowAll(wing); this.wing = wing; }\n    }\n    // Mud: a slightly larger shell of the lower body, dissolved by 1 - dirt.\n    const mud = buildModel(mudDefFor(carId), {}).object;\n    this.mudMat = toonMaterial(PALETTE.orange, { dissolve: true }).clone(); this.mudMat.dissolve = 1;\n    for (const m of this.meshes(mud)) { m.material = this.mudMat; m.castShadow = false; m.receiveShadow = false; }\n    mud.position.z = a - L / 2; mud.visible = false; this.mud = mud; this.body.add(mud);\n    if (this.o.ghost) this.toGhost(this.o.ghost);\n  }\n  shadowAll(o) { for (const m of this.meshes(o)) { m.castShadow = true; m.receiveShadow = false; } }\n  meshes(root = this.object) { const out = []; root.traverse((o) => { if (o.isMesh) out.push(o); }); return out; }\n  // A stippled ghost: every mesh gets one clone of a dissolve material.\n  toGhost(colour) {\n    const mat = toonMaterial(typeof colour === 'string' ? PALETTE[colour] : colour, { dissolve: true }).clone(); mat.dissolve = 0.35; this.ghostMat = mat;\n    for (const m of this.meshes()) { m.material = mat; m.castShadow = false; m.receiveShadow = false; }\n    this.mud.visible = false; this.brake.visible = false; this.head.visible = false; this.isGhost = true;\n  }\n  setDirt(d) { this.dirt = d; if (this.isGhost) return; this.mud.visible = d > 0.02; this.mudMat.dissolve = 1 - d * 0.75; }\n  setBrake(on) { if (this.braking !== on) { this.braking = on; if (!this.isGhost) this.brake.visible = on; } }\n  setHead(on) { if (this.headOn !== on) { this.headOn = on; if (!this.isGhost) this.head.visible = on; } }\n  // pose: x y z yaw (world), pitch/roll for the road and the body, steer, speed m/s.\n  update(dt, x, y, z, yaw, roadPitch, roadRoll, bodyPitch, bodyRoll, steer, speed, airborne = false) {\n    const o = this.object; o.position.set(x, y + this.jack, z); o.rotation.set(roadPitch, yaw, roadRoll, 'YXZ');\n    this.pitch += (bodyPitch - this.pitch) * Math.min(1, dt * 14); this.roll += (bodyRoll - this.roll) * Math.min(1, dt * 12);\n    this.body.rotation.x = this.pitch; this.body.rotation.z = this.roll;\n    const sh = this.shake > 0 ? Math.sin(performance.now?.() * 0.09 || 0) * this.shake : 0;\n    this.body.position.y = (airborne ? 0.08 : 0) + sh + this.heave;\n    this.spin += (speed / this.R) * dt;\n    for (const w of this.wheels) { w.spin.rotation.x = this.spin; if (w.front) w.pivot.rotation.y = -steer; }\n  }\n  setPaint(colour) { if (colour !== this.paint) this.rebuild({ paint: colour }); }\n  rebuild(o = {}) { // after a purchase: swap the model, keep the position\n    Object.assign(this.o, o); const parent = this.object;\n    for (const c of [...this.body.children]) this.body.remove(c);\n    for (const w of this.wheels) parent.remove(w.pivot);\n    this.wheels = [];\n    this.build(); setLookLayer(this.object, 'actors');\n  }\n  setInstall(install) { this.install = install; this.o.paint = install?.paint ?? this.o.paint; this.rebuild(); }\n  dispose() { this.object.removeFromParent(); }\n}\nEOF\ncat > src/game/render/camera.js <<'EOF'\n// The driver's cameras: chase near, chase far, bonnet. A little yaw lag so slides read; right stick or right drag looks around.\nimport { THREE } from '../../pixel-engine.js';\nconst { Vector3 } = THREE;\nexport const CAM_MODES = [{ id: 'near', back: 6.8, up: 2.4 }, { id: 'far', back: 8.5, up: 3.1 }, { id: 'bonnet', back: 0, up: 1.05 }];\nexport class ChaseCam {\n  constructor(cam) { this.cam = cam; this.mode = 0; this.pos = new Vector3(); this.want = new Vector3(); this.look = new Vector3(); this.yaw = 0; this.orbit = 0; this.pitch = 0; this.ready = false; this.distance = null; this.fovBase = 58; }\n  cycle() { this.mode = (this.mode + 1) % CAM_MODES.length; this.ready = false; }\n  snap() { this.ready = false; }\n  update(dt, c, { lookBack = false, lookX = 0, lookY = 0, slope = 0 } = {}) {\n    const m = CAM_MODES[this.mode], cam = this.cam, speed = Math.abs(c.u ?? 0);\n    let dy = c.yaw - this.yaw; while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI;\n    if (!this.ready) { this.yaw = c.yaw; dy = 0; }\n    this.yaw += dy * Math.min(1, dt * 7);\n    this.orbit += (lookX * 2.6 - this.orbit) * Math.min(1, dt * 6); this.pitch += (lookY * 0.8 - this.pitch) * Math.min(1, dt * 6);\n    let baseYaw = this.yaw + this.orbit; if (lookBack) baseYaw += Math.PI;\n    const sn = Math.sin(baseYaw), cs = Math.cos(baseYaw);\n    if (m.id === 'bonnet') {\n      const fsn = Math.sin(c.yaw + (lookBack ? Math.PI : this.orbit)), fcs = Math.cos(c.yaw + (lookBack ? Math.PI : this.orbit));\n      this.want.set(c.x + Math.sin(c.yaw) * 0.2, c.y + m.up, c.z + Math.cos(c.yaw) * 0.2);\n      this.pos.copy(this.want);\n      this.look.set(c.x + fsn * 12, c.y + 1.0 + slope * 12 + this.pitch * 6, c.z + fcs * 12);\n    } else {\n      const back = this.distance ?? m.back;\n      this.want.set(c.x - sn * back, c.y + m.up + this.pitch * 2 + slope * -back, c.z - cs * back);\n      if (!this.ready) this.pos.copy(this.want); else this.pos.lerp(this.want, 1 - Math.exp(-dt * 8));\n      this.look.set(c.x + sn * 8, c.y + 1.1 + slope * 8, c.z + cs * 8);\n    }\n    this.ready = true;\n    cam.position.copy(this.pos); cam.lookAt(this.look);\n    cam.fov = this.fovBase + 8 * Math.min(1, speed / 80); cam.updateProjectionMatrix();\n  }\n}\nEOF\ncat > src/game/render/sky.js <<'EOF'\n// Sky: the engine's flat sky and sun, plus a far ring of silhouettes, a sun or moon disc, and chunky clouds.\nimport { applySky, skyAt, THREE } from '../../pixel-engine.js';\nimport { GeoBatch, mix, rgb, seeded } from './geo.js';\nconst { Color, Group } = THREE;\nexport function nightOf(hour) { const h = ((hour % 24) + 24) % 24; return h > 20 || h < 5 ? 1 : h > 18 ? (h - 18) / 2 : h < 7 ? (7 - h) / 2 : 0; }\nexport function applyHour(engine, hour, { rain = false, tunnel = 0 } = {}) {\n  const s = skyAt(hour);\n  applySky(engine, s);\n  const night = nightOf(hour);\n  // Raise the ambient so a road reads at night; the baked lamp pools and the glow do the rest.\n  engine.ambient.intensity = s.ambientIntensity * (1 + 0.3 * (1 - night)) + night * 1.15;\n  if (rain) { engine.ambient.intensity *= 0.9; engine.sun.intensity *= 0.45; const c = new Color(s.sky).lerp(new Color(0x566c86), 0.75); engine.scene.background = c; }\n  if (tunnel > 0) { engine.sun.intensity *= 1 - tunnel * 0.85; engine.ambient.intensity *= 1 - tunnel * 0.5; const c = (engine.scene.background instanceof Color ? engine.scene.background.clone() : new Color(s.sky)).lerp(new Color(0x1a1c2c), tunnel); engine.scene.background = c; }\n  return s;\n}\nexport function buildSkyDressing(tr, theme, hour, { cx = 0, cz = 0, seed = 3, radius = 2600, skyline = false } = {}) {\n  const group = new Group(), b = new GeoBatch(), g = new GeoBatch(), r = seeded(seed + tr?.N ?? seed), night = nightOf(hour), base = Math.min(...(tr ? tr.y : [0])) - 5;\n  const far = theme.far ?? ['teal', 'navy'];\n  const nightK = 1 - night * 0.55;\n  const ring = (R, col, minH, maxH, parts, flat = false) => {\n    let last = null;\n    for (let i = 0; i <= parts; i++) {\n      const a = (i / parts) * Math.PI * 2, h = minH + (maxH - minH) * (flat ? (r() > 0.6 ? r() : 0.05) : r()), p = [cx + Math.sin(a) * R, base, cz + Math.cos(a) * R], top = [p[0], base + h, p[2]];\n      if (last) { b.quad(last.p, last.top, top, p, col); b.quad(p, top, last.top, last.p, col); }\n      last = { p, top };\n    }\n  };\n  const c0 = { r: rgb(far[0]).r * nightK, g: rgb(far[0]).g * nightK, b: rgb(far[0]).b * nightK }, c1 = { r: rgb(far[1]).r * nightK, g: rgb(far[1]).g * nightK, b: rgb(far[1]).b * nightK };\n  ring(radius + 500, c1, 140, 330, 48, !!theme.flat && !skyline);\n  ring(radius, c0, 60, 200, 64, !!theme.flat);\n  if (skyline) { // A city skyline with lit windows, at the near edge of the ring.\n    for (let i = 0; i < 90; i++) { const a = r() * Math.PI * 2, R = radius * 0.5 + r() * 500, x = cx + Math.sin(a) * R, z = cz + Math.cos(a) * R, w = 40 + r() * 60, h = 50 + r() * 190; b.box(x, base, z, w, h, w, mix('ink', 'navy', r() * 0.5), a); for (let k = 0; k < 8; k++) g.box(x + (r() - 0.5) * w * 1.02, base + 10 + r() * (h - 16), z + (r() - 0.5) * w * 1.02, 5, 5, 5, r() > 0.5 ? 'sand' : 'orange', a); }\n  }\n  // Sun or moon: a flat disc, far off along the sun's direction.\n  const s = skyAt(hour), d = s.sunDir, D = 3200, sx = cx + d[0] * D, sy = base + Math.max(0.09, d[1]) * D, sz = cz + d[2] * D, n = 14, rad = night > 0.5 ? 60 : 110, col = night > 0.5 ? 'white' : hour > 16 ? 'orange' : 'sand';\n  const ux = -d[2], uz = d[0], ul = Math.hypot(ux, uz) || 1;\n  for (let i = 0; i < n; i++) { const a0 = (i / n) * 6.283, a1 = ((i + 1) / n) * 6.283, P = (a) => [sx + (ux / ul) * Math.cos(a) * rad, sy + Math.sin(a) * rad, sz + (uz / ul) * Math.cos(a) * rad]; g.tri([sx, sy, sz], P(a0), P(a1), col); g.tri([sx, sy, sz], P(a1), P(a0), col); }\n  // Chunky clouds (none at night, stars instead).\n  if (night < 0.6) for (let i = 0; i < 22; i++) { const a = r() * 6.283, R = 500 + r() * 1800, x = cx + Math.sin(a) * R, z = cz + Math.cos(a) * R, y = base + 260 + r() * 340, col2 = hour > 17 ? mix('sand', 'orange', 0.5) : 'white'; for (let k = 0; k < 4; k++) g.box(x + (k - 1.5) * 44 + r() * 20, y + r() * 14, z + r() * 40, 60 + r() * 50, 14 + r() * 14, 40 + r() * 40, col2, a); }\n  else for (let i = 0; i < 260; i++) { const a = r() * 6.283, e = 0.12 + r() * 0.9, R = 3100, x = cx + Math.sin(a) * R * Math.cos(e), z = cz + Math.cos(a) * R * Math.cos(e), y = base + Math.sin(e) * R; g.box(x, y, z, 8, 8, 8, r() > 0.8 ? 'cyan' : 'white'); }\n  group.add(b.mesh({ receive: false }), g.mesh({ glow: true }));\n  return group;\n}\nEOF\ncat > src/game/render/particles.js <<'EOF'\n// Particle presets, registered in code. Sizes are whole art pixels and colours are palette names.\nexport const PARTICLE_PRESETS = {\n  tyreSmoke: { count: [1, 2], life: [0.5, 1.1], speed: [0.4, 1.2], spread: 60, gravity: -0.8, drag: 1.5, size: [2, 5], colors: ['white', 'mist', 'mist', 'slate'], radius: 0.2, max: 400 },\n  dirtDust: { count: [1, 3], life: [0.8, 2.2], speed: [0.6, 2], spread: 70, gravity: -0.3, drag: 1.2, size: [3, 7], colors: ['sand', 'orange', 'orange', 'plum'], radius: 0.4, max: 600 },\n  saltDust: { count: [1, 2], life: [0.5, 1.2], speed: [0.6, 1.6], spread: 70, gravity: -0.2, drag: 1.4, size: [2, 4], colors: ['white', 'white', 'mist'], radius: 0.3, max: 300 },\n  gravel: { count: [2, 4], life: [0.25, 0.6], speed: [2, 5], spread: 40, gravity: 12, drag: 0.5, size: [1, 1], colors: ['slate', 'sand', 'orange'], radius: 0.2, max: 300 },\n  sparks: { count: [4, 8], life: [0.2, 0.5], speed: [3, 9], spread: 60, gravity: 14, drag: 0.5, size: [1, 1], colors: ['white', 'sand', 'orange', 'red'], max: 300 },\n  rainSpray: { count: [1, 2], life: [0.3, 0.7], speed: [0.8, 2], spread: 50, gravity: 3, drag: 1, size: [2, 3], colors: ['white', 'mist', 'mist'], radius: 0.4, max: 400 },\n  exhaustPop: { count: [2, 4], life: [0.08, 0.18], speed: [1, 3], spread: 25, size: [2, 1], colors: ['sand', 'orange', 'red'], max: 120 },\n  foam: { count: [2, 4], life: [0.6, 1.3], speed: [0.2, 0.8], spread: 180, gravity: 1, drag: 2, size: [2, 3], colors: ['white', 'white', 'mist', 'sky'], radius: 0.8, max: 400 },\n  confetti: { count: [16, 24], life: [1.5, 3], speed: [2, 6], spread: 70, gravity: 3, drag: 1.2, size: [1, 1], colors: ['red', 'sand', 'sky', 'lime', 'white'], radius: 1.2, max: 500 },\n  firework: { count: [30, 42], life: [0.6, 1.4], speed: [8, 18], spread: 180, gravity: 5, drag: 1.4, size: [2, 1], colors: ['white', 'sand', 'orange', 'red'], max: 500 },\n  firework2: { count: [30, 42], life: [0.6, 1.4], speed: [8, 18], spread: 180, gravity: 5, drag: 1.4, size: [2, 1], colors: ['white', 'cyan', 'sky', 'blue'], max: 500 },\n  firework3: { count: [30, 42], life: [0.6, 1.4], speed: [8, 18], spread: 180, gravity: 5, drag: 1.4, size: [2, 1], colors: ['white', 'lime', 'green', 'teal'], max: 500 },\n  mist: { count: [1, 1], life: [2, 4], speed: [0.2, 0.6], spread: 80, drag: 0.2, gravity: -0.05, size: [5, 8], colors: ['white', 'mist'], radius: 3, max: 200 },\n  waterfall: { count: [1, 3], life: [0.8, 1.4], speed: [1, 2], direction: [0, -1, 0], spread: 16, gravity: 8, size: [2, 3], colors: ['white', 'cyan', 'sky'], radius: 1, max: 300 },\n  dustDevil: { count: [2, 3], life: [1, 2], speed: [1, 3], spread: 30, gravity: -2.5, drag: 0.3, size: [3, 5], colors: ['white', 'sand', 'mist'], radius: 1.2, max: 200 },\n  welding: { count: [3, 6], life: [0.15, 0.4], speed: [1.5, 3.5], spread: 70, gravity: 7, size: [1, 1], colors: ['white', 'cyan', 'sand'], max: 100 },\n};\nexport function registerParticles(ctx) { for (const [k, v] of Object.entries(PARTICLE_PRESETS)) ctx.particles.register(k, v); }\nEOF\ncat > src/game/render/skid.js <<'EOF'\n// Skid marks: a ring buffer of dark quads laid where a tyre slides or locks.\nimport { rgb } from './geo.js';\nimport { PALETTE, THREE, toonMaterial } from '../../pixel-engine.js';\nconst { BufferAttribute, BufferGeometry, DynamicDrawUsage, Mesh } = THREE;\nexport class SkidMarks {\n  constructor(max = 1400, colour = 'ink') {\n    this.max = max; this.n = 0; this.next = 0; this.pos = new Float32Array(max * 18); this.geo = new BufferGeometry();\n    this.attr = new BufferAttribute(this.pos, 3); this.attr.setUsage(DynamicDrawUsage); this.geo.setAttribute('position', this.attr);\n    const nor = new Float32Array(max * 18); for (let i = 1; i < nor.length; i += 3) nor[i] = 1; this.geo.setAttribute('normal', new BufferAttribute(nor, 3));\n    const col = new Float32Array(max * 18), c = rgb(colour); for (let i = 0; i < col.length; i += 3) { col[i] = c.r; col[i + 1] = c.g; col[i + 2] = c.b; } this.geo.setAttribute('color', new BufferAttribute(col, 3));\n    this.geo.setDrawRange(0, 0);\n    this.mesh = new Mesh(this.geo, toonMaterial(0xffffff, { vertexColors: true })); this.mesh.frustumCulled = false; this.mesh.receiveShadow = false; this.mesh.castShadow = false; this.last = new Map();\n    void PALETTE;\n  }\n  // A mark from this tyre's last point to here, width w. key: which tyre.\n  lay(key, x, y, z, w = 0.22) {\n    const l = this.last.get(key);\n    if (l && Math.hypot(x - l.x, z - l.z) < 8 && Math.hypot(x - l.x, z - l.z) > 0.4) {\n      const dx = x - l.x, dz = z - l.z, d = Math.hypot(dx, dz) || 1, rx = (dz / d) * w, rz = (-dx / d) * w, Y = y + 0.05, Y0 = l.y + 0.05, p = this.next * 18, a = this.pos;\n      a.set([l.x - rx, Y0, l.z - rz, l.x + rx, Y0, l.z + rz, x + rx, Y, z + rz, l.x - rx, Y0, l.z - rz, x + rx, Y, z + rz, x - rx, Y, z - rz], p);\n      this.next = (this.next + 1) % this.max; this.n = Math.min(this.max, this.n + 1); this.geo.setDrawRange(0, this.n * 6); this.attr.needsUpdate = true;\n      this.last.set(key, { x, y, z });\n    } else if (!l || Math.hypot(x - l.x, z - l.z) >= 8) this.last.set(key, { x, y, z });\n  }\n  lift(key) { this.last.delete(key); }\n}\nEOF\ncat > src/game/input/pad.js <<'EOF'\n// Pads are read raw, once a frame at the end of update: quantised, and sent through input.send so the engine's recordings replay them.\nexport const BTN = { cross: 0, circle: 1, square: 2, triangle: 3, l1: 4, r1: 5, l2: 6, r2: 7, create: 8, options: 9, l3: 10, r3: 11, up: 12, down: 13, left: 14, right: 15 };\nconst q = (v) => Math.round(v * 255) / 255;\nexport function readPads() {\n  if (typeof navigator === 'undefined' || !navigator.getGamepads) return [];\n  let list; try { list = navigator.getGamepads(); } catch { return []; }\n  const out = [];\n  for (const p of list ?? []) {\n    if (!p || !p.connected || (p.mapping && p.mapping !== 'standard')) continue;\n    out.push({ i: p.index, axes: [0, 1, 2, 3].map((k) => q(p.axes[k] ?? 0)), buttons: Array.from({ length: 16 }, (_, k) => q(p.buttons[k]?.value ?? (p.buttons[k]?.pressed ? 1 : 0))), real: p });\n  }\n  return out;\n}\nexport const padsKey = (pads) => pads.map((p) => `${p.axes.join(',')}|${p.buttons.join(',')}`).join(';');\nexport function rumble(index, strong = 0.3, weak = 0.2, ms = 90) {\n  if (typeof navigator === 'undefined' || !navigator.getGamepads) return;\n  try { const p = navigator.getGamepads()[index]; p?.vibrationActuator?.playEffect?.('dual-rumble', { duration: ms, strongMagnitude: strong, weakMagnitude: weak }); } catch { /* a pad without rumble */ }\n}\nEOF\ncat > src/game/input/actions.js <<'EOF'\n// Turns keys, mouse and latched pad state into actions. Tracks the last device (for prompts) and idle time (for attract mode).\nimport { BTN, padsKey, readPads, rumble } from './pad.js';\nconst MENU_BUTTONS = { confirm: BTN.cross, back: BTN.circle, alt: BTN.square, info: BTN.triangle, tabL: BTN.l1, tabR: BTN.r1, pause: BTN.options };\nconst KEYS = { confirm: ['Enter'], back: ['Escape', 'Backspace'], alt: ['KeyT'], info: ['KeyI'], tabL: ['KeyQ'], tabR: ['KeyE', 'Tab'], pause: ['Escape'] };\nconst PRESSED = Object.keys(MENU_BUTTONS);\nexport class Actions {\n  constructor() {\n    this.pads = []; this.prevButtons = []; this.frame = -1; this.lastDevice = 'key'; this.idle = 0; this.padKey = ''; this.pressedNow = new Set(); this.injected = []; this.moveTimer = { x: 0, y: 0 }; this.moveDir = { x: 0, y: 0 }; this.mx = 0; this.my = 0; this.lastPointer = null; this.driver = [mkDriver(), mkDriver()]; this.couch = false; this.touchSeen = false; this.anyInput = false; this.padEverSeen = false; this.keySeen = false; this.vibration = true; this.steerCurve = 1.4; this.mouseSteer = false; this.enabled = true; this.movedThisFrame = { x: 0, y: 0 }; this.lastPadSent = ''; this.clicked = false; this.rclicked = false; this.create = false; this.mouseIdle = 0;\n  }\n  // Once per frame, from whichever hook runs first (engine fact 8).\n  latch(ctx) {\n    const f = ctx.engine.frame;\n    if (f === this.frame) return;\n    this.frame = f;\n    const input = ctx.input, dt = this.lastDt ?? 1 / 60;\n    for (const cmd of input.commands) if (cmd && cmd.pads) { this.pads = cmd.pads; }\n    this.anyInput = false; this.pressedNow.clear(); this.movedThisFrame.x = 0; this.movedThisFrame.y = 0;\n    // Keyboard\n    let keyPressed = false;\n    for (const a of PRESSED) if (KEYS[a].some((k) => input.wasPressed(k))) { this.pressedNow.add(a); keyPressed = true; }\n    if (input.wasPressed('Tab')) { this.pressedNow.add('tabR'); keyPressed = true; }\n    const keyDown = ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space', 'KeyQ', 'KeyE', 'Enter', 'Escape', 'KeyC', 'KeyB', 'KeyR', 'ShiftLeft', 'ControlLeft', 'KeyI', 'KeyT', 'Backspace', 'Tab'].some((k) => input.isDown(k));\n    const anyPress = (input.queuedPresses?.length ?? 0) > 0 || keyPressed;\n    if (keyDown || anyPress) { this.lastDevice = this.lastDevice === 'mouse' && !keyDown && !keyPressed ? 'mouse' : 'key'; this.anyInput = true; this.keySeen = true; }\n    // Mouse\n    const p = input.pointer, wheel = input.wheel ?? 0;\n    this.clicked = input.wasPressed('MouseLeft'); this.rclicked = input.wasPressed('MouseRight');\n    const touchNow = input.wasPressed?.('Touch');\n    if (touchNow) { this.touchSeen = true; this.anyInput = true; this.clicked = true; }\n    if (this.lastPointer) {\n      const dx = Math.abs(p.x - this.lastPointer.x) * 240, dy = Math.abs(p.y - this.lastPointer.y) * 135;\n      if (dx + dy > 3 && !touchNow) { this.anyInput = true; this.lastDevice = 'mouse'; this.mouseIdle = 0; this.lastPointer = { x: p.x, y: p.y }; }\n    } else this.lastPointer = { x: p.x, y: p.y };\n    if (this.clicked || this.rclicked || wheel) { this.anyInput = true; if (!touchNow) { this.lastDevice = 'mouse'; this.mouseIdle = 0; } }\n    this.mouseIdle += dt;\n    this.wheel = wheel;\n    // Pads\n    const prev = this.prevButtons;\n    this.create = false;\n    for (const pad of this.pads) {\n      const pb = prev[pad.i] ?? [];\n      if (pad.buttons[BTN.create] > 0.5) this.create = true;\n      for (let b = 0; b < pad.buttons.length; b++) {\n        const on = pad.buttons[b] > 0.5, was = (pb[b] ?? 0) > 0.5;\n        if (on && !was) {\n          this.anyInput = true; this.lastDevice = 'pad'; this.padEverSeen = true;\n          for (const a of PRESSED) if (MENU_BUTTONS[a] === b) { if (a === 'pause' && this.create) continue; this.pressedNow.add(a); }\n        }\n      }\n      const moved = Math.abs(pad.axes[0]) > 0.2 || Math.abs(pad.axes[1]) > 0.2 || Math.abs(pad.axes[2]) > 0.2 || Math.abs(pad.axes[3]) > 0.2 || pad.buttons[BTN.l2] > 0.2 || pad.buttons[BTN.r2] > 0.2;\n      if (moved) { this.anyInput = true; this.lastDevice = 'pad'; this.padEverSeen = true; }\n      prev[pad.i] = pad.buttons;\n    }\n    for (const a of this.injected) { if (a === 'moveX+' || a === 'moveX-') this.movedThisFrame.x = a === 'moveX+' ? 1 : -1; else if (a === 'moveY+' || a === 'moveY-') this.movedThisFrame.y = a === 'moveY+' ? 1 : -1; else this.pressedNow.add(a); this.anyInput = true; }\n    this.injected.length = 0;\n    this.updateMoves(input, dt);\n    if (this.anyInput) this.idle = 0; else this.idle += dt;\n  }\n  setDt(dt) { this.lastDt = dt; }\n  // Menu movement with repeat: first repeat at 0.35 s, then every 0.09 s.\n  updateMoves(input, dt) {\n    let x = 0, y = 0;\n    if (input.isDown('ArrowRight') || input.isDown('KeyD')) x = 1; if (input.isDown('ArrowLeft') || input.isDown('KeyA')) x = -1;\n    if (input.isDown('ArrowDown') || input.isDown('KeyS')) y = 1; if (input.isDown('ArrowUp') || input.isDown('KeyW')) y = -1;\n    for (const pad of this.pads) {\n      if (pad.axes[0] > 0.5 || pad.buttons[BTN.right] > 0.5) x = 1; else if (pad.axes[0] < -0.5 || pad.buttons[BTN.left] > 0.5) x = -1;\n      if (pad.axes[1] > 0.5 || pad.buttons[BTN.down] > 0.5) y = 1; else if (pad.axes[1] < -0.5 || pad.buttons[BTN.up] > 0.5) y = -1;\n    }\n    for (const [ax, v] of [['x', x], ['y', y]]) {\n      if (v !== this.moveDir[ax]) { this.moveDir[ax] = v; this.moveTimer[ax] = 0.35; if (v) this.movedThisFrame[ax] = v; }\n      else if (v) { this.moveTimer[ax] -= dt; if (this.moveTimer[ax] <= 0) { this.moveTimer[ax] = 0.09; this.movedThisFrame[ax] = v; } }\n    }\n  }\n  pressed(a) { return this.pressedNow.has(a); }\n  moveX() { return this.movedThisFrame.x; }\n  moveY() { return this.movedThisFrame.y; }\n  inject(a) { this.injected.push(a); }\n  // At the end of update: read pads and hand them to the engine, so they arrive (and replay) next frame.\n  send(ctx) {\n    const pads = readPads();\n    const key = padsKey(pads);\n    if (key !== this.lastPadSent) { this.lastPadSent = key; ctx.input.send({ pads: pads.map(({ i, axes, buttons }) => ({ i, axes, buttons })) }); }\n    if (pads.length) { if (!this.padEverSeen && pads.some((p) => p.buttons.some((b) => b > 0.5))) this.padEverSeen = true; if (typeof this.hasPad === 'undefined' || !this.hasPad) this.hasPad = true; } else this.hasPad = false;\n    if (ctx.audio && !ctx.audio.unlocked && pads.some((p) => p.buttons.some((b) => b > 0.5))) ctx.audio.unlock();\n  }\n  rumble(player, strong, weak, ms) { if (!this.vibration) return; const pad = this.pads[player]; if (pad) rumble(pad.i, strong, weak, ms); }\n  // Which physical inputs does this player use?\n  padFor(player) {\n    if (this.couch) { if (this.pads.length >= 2) return this.pads[player]; if (this.pads.length === 1) return player === 0 ? this.pads[0] : null; return null; }\n    if (player === 0) return this.pads[0] ?? null;\n    return null;\n  }\n  keysFor(player) { // returns a key map, or null when this player uses a pad only\n    if (!this.couch) return player === 0 ? KEYS_SOLO : null;\n    if (this.pads.length >= 2) return null;\n    if (this.pads.length === 1) return player === 1 ? KEYS_SOLO : null;\n    return player === 0 ? KEYS_P1 : KEYS_P2;\n  }\n  // The driver's controls, filtered. Call once per frame per player.\n  drive(ctx, player, dt) {\n    const input = ctx.input, d = this.driver[player], pad = this.padFor(player), k = this.keysFor(player);\n    let kSteer = 0, kThrottle = 0, kBrake = 0, analogSteer = null, anaThrottle = null, anaBrake = null, hand = false, up = false, down = false, cam = false, back = false, recover = false, lookX = 0, lookY = 0;\n    if (k) {\n      if (k.left.some((c) => input.isDown(c))) kSteer -= 1; if (k.right.some((c) => input.isDown(c))) kSteer += 1;\n      if (k.throttle.some((c) => input.isDown(c))) kThrottle = 1; if (k.brake.some((c) => input.isDown(c))) kBrake = 1;\n      hand = k.hand.some((c) => input.isDown(c)); up = k.up.some((c) => input.wasPressed(c)); down = k.down.some((c) => input.wasPressed(c));\n      cam = k.cam.some((c) => input.wasPressed(c)); back = k.back.some((c) => input.isDown(c)); recover = k.recover.some((c) => input.isDown(c));\n    }\n    if (pad) {\n      const pb = d.prevB ?? [], B = (b) => pad.buttons[b] > 0.5, P = (b) => pad.buttons[b] > 0.5 && !((pb[b] ?? 0) > 0.5);\n      const ax = pad.axes[0], dead = 0.08;\n      if (Math.abs(ax) > 0.02 || pad.buttons[BTN.left] > 0.5 || pad.buttons[BTN.right] > 0.5) { const a = Math.abs(ax) > dead ? (Math.abs(ax) - dead) / (1 - dead) : 0; analogSteer = Math.sign(ax) * Math.pow(a, this.steerCurve); if (pad.buttons[BTN.left] > 0.5) analogSteer = -1; if (pad.buttons[BTN.right] > 0.5) analogSteer = 1; }\n      const rt = pad.buttons[BTN.r2], lt = pad.buttons[BTN.l2];\n      anaThrottle = rt; anaBrake = lt;\n      // A trigger that reports only 0 or 1 gets the keyboard ramp.\n      d.digitalT = (rt === 0 || rt === 1) && (d.digitalT ?? true) ; d.digitalB = (lt === 0 || lt === 1) && (d.digitalB ?? true);\n      hand = hand || B(BTN.square); up = up || P(BTN.r1); down = down || P(BTN.l1);\n      const tri = B(BTN.triangle); if (tri) { d.triHold += dt; } else { if (d.triHold > 0 && d.triHold < 0.4) cam = true; d.triHold = 0; }\n      recover = recover || d.triHold >= 0.4; back = back || B(BTN.circle); lookX = Math.abs(pad.axes[2]) > 0.12 ? pad.axes[2] : 0; lookY = Math.abs(pad.axes[3]) > 0.12 ? -pad.axes[3] : 0;\n      d.prevB = pad.buttons;\n    }\n    // Mouse steering, optional.\n    const mouseOn = this.mouseSteer && player === 0 && this.lastDevice === 'mouse';\n    if (mouseOn) { analogSteer = Math.max(-1, Math.min(1, input.pointer.x * 1.6)); anaThrottle = input.isDown('MouseLeft') ? 1 : 0; anaBrake = input.isDown('MouseRight') ? 1 : 0; }\n    else if (player === 0 && input.isDown('MouseRight')) { d.lookX = Math.max(-1, Math.min(1, (d.lookX ?? 0) + (input.mouseDelta.x ?? 0) * 0.006)); lookX = d.lookX; lookY = 0; } else d.lookX = 0;\n    // Filters: keyboard steering goes toward +-1 at 3.2 per second and returns at 6.\n    if (analogSteer !== null && !kSteer) d.steer = analogSteer;\n    else { const to = kSteer, rate = to === 0 || Math.sign(to) !== Math.sign(d.steer) ? 6 : 3.2; d.steer += Math.max(-rate * dt, Math.min(rate * dt, to - d.steer)); }\n    // Throttle and brake: keys ramp over 0.1 s; analog follows the pedal.\n    const ramp = (cur, to) => cur + Math.max(-dt / 0.1, Math.min(dt / 0.1, to - cur));\n    const tTo = Math.max(kThrottle, anaThrottle ?? 0), bTo = Math.max(kBrake, anaBrake ?? 0), digT = kThrottle || (pad && d.digitalT), digB = kBrake || (pad && d.digitalB);\n    d.throttle = digT ? ramp(d.throttle, tTo) : tTo; d.brake = digB ? ramp(d.brake, bTo) : bTo;\n    d.handbrake = hand; d.up = up; d.down = down; d.cam = cam; d.lookBack = back; d.recover = recover; d.lookX2 = lookX; d.lookY2 = lookY;\n    return d;\n  }\n  resetDriver() { for (const d of this.driver) { d.steer = 0; d.throttle = 0; d.brake = 0; d.triHold = 0; } }\n  state() { return { lastDevice: this.lastDevice, idle: this.idle, pads: this.pads.length }; }\n}\nconst mkDriver = () => ({ steer: 0, throttle: 0, brake: 0, handbrake: false, up: false, down: false, cam: false, lookBack: false, recover: false, triHold: 0, lookX2: 0, lookY2: 0, digitalT: true, digitalB: true });\nconst KEYS_SOLO = { left: ['KeyA', 'ArrowLeft'], right: ['KeyD', 'ArrowRight'], throttle: ['KeyW', 'ArrowUp'], brake: ['KeyS', 'ArrowDown'], hand: ['Space'], up: ['KeyE', 'ShiftLeft'], down: ['KeyQ', 'ControlLeft'], cam: ['KeyC'], back: ['KeyB'], recover: ['KeyR'] };\nconst KEYS_P1 = { left: ['KeyA'], right: ['KeyD'], throttle: ['KeyW'], brake: ['KeyS'], hand: ['Space'], up: ['KeyE'], down: ['KeyQ'], cam: ['KeyC'], back: ['KeyB'], recover: ['KeyR'] };\nconst KEYS_P2 = { left: ['ArrowLeft'], right: ['ArrowRight'], throttle: ['ArrowUp'], brake: ['ArrowDown'], hand: ['Enter'], up: ['Period'], down: ['Comma'], cam: ['Slash'], back: ['ShiftRight'], recover: ['Backslash'] };\nexport { KEYS_SOLO, KEYS_P1, KEYS_P2 };\nEOF\ncat >> /dev/null <<'EOF'\nEOF\nsed -i 's/^## Build order status.*/&/; s/^1\\. Pipeline: in progress/1. Pipeline: done (tools\\/build.mjs, tools\\/test.mjs)/; s/^2\\. Sim in Node: not started/2. Sim in Node: done (sim suite green: 147 checks). race.js, career.js, licence.js, tuning.js, replaydata.js written; medals frozen in data\\/medals.js/; s/^3\\. One car on one track: not started/3. One car on one track: IN PROGRESS. render\\/geo, trackmesh, carview, camera, sky, particles, skid and models\\/cars.js written; input\\/pad+actions written. Next: ui, app, scenes\\/race, main.js/' ../PROGRESS.md; echo saved","description":"Write car view, cameras, sky, particles, skid marks and input layer"}}}
