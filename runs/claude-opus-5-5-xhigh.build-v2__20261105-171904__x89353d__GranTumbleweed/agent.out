{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011eJg7JAZqMVtQKSTxpuvY4","type":"tool_result","content":"1\t// The glue between screens and scenes: starting a drive, what happens after it, and where it returns to.\n2\timport { RaceScene } from './scenes/race.js';\n3\timport { MenuScene } from './scenes/menu.js';\n4\timport { ReplayScene } from './scenes/replay.js';\n5\timport { TESTS, LICENCES } from './data/licences.js';\n6\timport { EVENTS } from './data/events.js';\n7\timport { CAR_INFO } from './data/cars.js';\n8\timport { LINES } from './data/text.js';\n9\timport { carEntry, driveCar, eventState, oilOf, recordFailure, recordLap, recordRound, recordTest } from './sim/career.js';\n10\timport { couchSetup, eventSetup, quickSetup, testDriveSetup, trialSetup } from './sim/setups.js';\n11\timport { legCount, testSetup } from './sim/licence.js';\n12\timport { formatTime } from './sim/race.js';\n13\timport { GhostTrace, Recording } from './sim/replaydata.js';\n14\timport { PauseScreen } from './ui/screens/pause.js';\n15\timport { MapScreen } from './ui/screens/map.js';\n16\timport { LicenceListScreen, TestListScreen, TestCardScreen, TestResultScreen } from './ui/screens/licence.js';\n17\timport { EventCardScreen, EventListScreen, RoundCardScreen } from './ui/screens/events.js';\n18\timport { DealerScreen } from './ui/screens/dealer.js';\n19\timport { PartsScreen, TuningScreen } from './ui/screens/tuning.js';\n20\timport { GarageScreen } from './ui/screens/garage.js';\n21\timport { TheatreScreen } from './ui/screens/theatre.js';\n22\timport { ArcadeScreen } from './ui/screens/arcade.js';\n23\timport { ResultsScreen } from './ui/screens/results.js';\n24\timport { EndingScreen, PodiumScreen, PrizeScreen } from './ui/screens/cinema.js';\n25\timport { startCouchEngine, stopCouchEngine } from './net/couch.js';\n26\timport { DevPanel } from './dev/devmode.js';\n27\tvoid Recording;\n28\texport function installFlows(app) {\n29\t  const seed = () => { app.seedN = (app.seedN ?? 0) + 1; return (Date.now() % 100000) + app.seedN; };\n30\t  const toMenu = (start) => app.go(() => new MenuScene(app, { start }));\n31\t  app.toMenu = toMenu;\n32\t  const mapThen = (...list) => (ui) => { ui.push(new MapScreen(app)); for (const fn of list) ui.push(fn()); };\n33\t  const assists = () => ({ ...app.options.assists });\n34\t  app.toTitle = () => { app.engine.timeScale = 1; return toMenu(null); };\n35\t  app.factory.pause = (scene) => app.ui.push(new PauseScreen(app, scene));\n36\t  app.openDev = (scene) => app.ui.push(new DevPanel(app, scene));\n37\t  // ---- Licence tests ----\n38\t  app.startTest = (id, o = {}) => {\n39\t    const test = TESTS[id], leg = o.leg ?? 0;\n40\t    const setup = { ...testSetup(test, leg, assists()), seed: seed() };\n41\t    return app.go(() => new RaceScene(app, setup, { test, demo: !!o.demo, showLine: !!app.lineForTest || (app.profile.tests[id]?.fails ?? 0) >= 3 && app.lineForTest, legBase: o.legBase ?? 0, run: { type: 'licence', id, demo: !!o.demo } }));\n42\t  };\n43\t  app.factory.testFinished = (scene) => {\n44\t    const J = scene.judge, test = scene.test, demo = !!scene.opts.demo, id = test.id, base = scene.opts.legBase ?? 0, total = J.total + base, leg = scene.leg;\n45\t    app.lastRace = scene.sim.rec;\n46\t    if (J.status === 'pass' && leg + 1 < legCount(test)) { return app.startTest(id, { demo, leg: leg + 1, legBase: total }); }\n47\t    const o = { test, failed: J.status !== 'pass', reason: J.reason, time: total, demo };\n48\t    if (demo) { o.medal = null; app.ui.push(new TestResultScreen(app, { ...o, failed: false, reason: '', demoShown: true, time: total })); return; }\n49\t    if (J.status !== 'pass') { if (!app.devActive()) recordFailure(app.profile, id); }\n50\t    else if (app.devActive()) { o.notSaved = true; }\n51\t    else { const r = recordTest(app.profile, id, total); o.medal = r.medal; o.licenceWon = r.licenceWon; o.reward = r.reward; o.prizeCar = r.prizeCar; o.allGold = r.allGold; if (!r.medal) o.failed = false; }\n52\t    if (!o.failed) o.next = o.medal === 'gold' ? null : o.medal === 'silver' ? 'gold' : o.medal === 'bronze' ? 'silver' : 'bronze';\n53\t    app.save();\n54\t    if (o.licenceWon) app.ui.note(LINES.arai.licence);\n55\t    app.ui.push(new TestResultScreen(app, o));\n56\t  };\n57\t  app.backToTests = (id, o = {}) => {\n58\t    const lic = TESTS[id].licence;\n59\t    return toMenu((ui) => {\n60\t      ui.push(new MapScreen(app)); ui.push(new LicenceListScreen(app)); ui.push(new TestListScreen(app, lic));\n61\t      if (o.prizeCar) ui.push(new PrizeScreen(app, { carId: o.prizeCar, line: LICENCES[lic].allGold?.text, next: () => ui.pop() }));\n62\t    });\n63\t  };\n64\t  app.afterTestReplay = (o) => app.go(() => new MenuScene(app, { start: (ui) => { ui.push(new MapScreen(app)); ui.push(new LicenceListScreen(app)); ui.push(new TestListScreen(app, o.test.licence)); ui.push(new TestCardScreen(app, o.test.id)); } }));\n65\t  // ---- Events ----\n66\t  app.startEventRound = (id) => {\n67\t    const setup = eventSetup(app.profile, id, assists(), seed());\n68\t    return app.go(() => new RaceScene(app, setup, { run: { type: 'event', id } }));\n69\t  };\n70\t  app.factory.raceFinished = (scene) => {\n71\t    const sim = scene.sim, kind = scene.data.kind, me = sim.cars.find((e) => e.player === 0), run = scene.run ?? {};\n72\t    app.lastRace = sim.rec; const rows = sim.results(); for (const e of sim.cars) app.profile.seen[e.carId] = true;\n73\t    const car = carEntry(app.profile);\n74\t    if (kind === 'testdrive') return app.returnFromTestDrive(run);\n75\t    const record = !app.devActive() && me?.bestLap ? recordLap(app.profile, sim.tr.id, me.bestLap, me.carId) : false;\n76\t    const o = { kind, rows, track: sim.tr.id, best: me?.bestLap ?? null, bestText: me?.bestLap ? formatTime(me.bestLap) : '', record, seed: scene.data.seed, run };\n77\t    if (kind === 'race' || kind === 'rally') {\n78\t      app.undo = JSON.stringify(app.profile);\n79\t      if (car && me) { driveCar(app.profile, car, me.metres, me.dirtM); car.lastWear = (me.c.wear[0] + me.c.wear[1] + me.c.wear[2] + me.c.wear[3]) / 4; }\n80\t      const names = rows.map((r) => r.name), r = recordRound(app.profile, run.id, names, 'YOU', app.prizeMult ?? 1);\n81\t      Object.assign(o, { title: EVENTS[run.id].name, prize: r.prize, points: r.points, showPoints: kind === 'race', round: r });\n82\t      if (r.seriesDone) { o.seriesWon = r.seriesWon; o.seriesLine = r.seriesWon ? `THE SERIES IS YOURS. ${r.bonus ? `BONUS ${r.bonus.toLocaleString('en-US')} CR.` : ''}${r.prizeCar ? ` PRIZE: ${CAR_INFO[r.prizeCar].short}.` : ''}` : 'THE SERIES GOES TO ANOTHER DRIVER. YOU MAY ENTER AGAIN.'; }\n83\t      else o.seriesLine = `ROUND ${eventState(app.profile, run.id).round + 1} OF ${EVENTS[run.id].rounds.length} IS NEXT.`;\n84\t      if (me?.pos === 1 && sim.tr.id === 'harbour') scene.fireworksOn = true;\n85\t      app.save();\n86\t    } else if (kind === 'couch') { stopCouchEngine(app); o.title = 'THE DUEL'; o.retry = true; }\n87\t    else { o.title = kind === 'timetrial' ? 'TIME TRIAL' : 'QUICK RACE'; if (me?.pos === 1 && sim.tr.id === 'harbour') scene.fireworksOn = true; }\n88\t    app.ui.push(new ResultsScreen(app, o));\n89\t  };\n90\t  app.resultsContinue = (o) => {\n91\t    const k = o.kind;\n92\t    if (k === 'race' || k === 'rally') {\n93\t      const r = o.round, id = o.run.id;\n94\t      if (r.seriesDone && r.seriesWon) return app.ceremony(id, r);\n95\t      if (r.seriesDone) return toMenu(mapThen(() => new EventListScreen(app), () => new EventCardScreen(app, id)));\n96\t      return toMenu(mapThen(() => new EventListScreen(app), () => new EventCardScreen(app, id), () => new RoundCardScreen(app, id)));\n97\t    }\n98\t    return toMenu(mapThen(() => new ArcadeScreen(app)));\n99\t  };\n100\t  app.ceremony = (id, r) => {\n101\t    const car = carEntry(app.profile), finish = (ui) => { ui.clear(); ui.push(new MapScreen(app)); };\n102\t    return toMenu((ui) => {\n103\t      ui.push(new MapScreen(app));\n104\t      const afterPrize = () => { if (r.ending) { ui.pop(); ui.push(new EndingScreen(app, { next: () => finish(ui) })); } else finish(ui); };\n105\t      const toPrize = () => { ui.pop(); if (r.prizeCar) ui.push(new PrizeScreen(app, { carId: r.prizeCar, next: afterPrize })); else afterPrize(); };\n106\t      ui.push(new PodiumScreen(app, { eventId: id, carId: car?.carId ?? 'kite', install: car?.install, next: toPrize, line: LINES.dell.win[0].replace('{TRACK}', 'THE PENINSULA').replace('{NAME}', 'THE DRIVER') }));\n107\t    });\n108\t  };\n109\t  app.resultsRetry = (o) => {\n110\t    const k = o.kind;\n111\t    if (k === 'race' || k === 'rally') { if (app.undo) { app.profile = JSON.parse(app.undo); app.save(); } return app.startEventRound(o.run.id); }\n112\t    return app.runAgain?.();\n113\t  };\n114\t  // ---- Arcade ----\n115\t  app.startQuick = (p) => { app.runAgain = () => app.startQuick(p); const setup = quickSetup({ ...p, assists: assists(), seed: seed(), poolIds: Object.keys(CAR_INFO).filter((c) => c !== 'type9' || p.carId === 'type9').slice(0, 13) }); return app.go(() => new RaceScene(app, setup, { run: { type: 'quick' } })); };\n116\t  app.startTimeTrial = (p) => { app.runAgain = () => app.startTimeTrial(p); const key = `${p.track}:${p.carId}`, setup = trialSetup({ ...p, assists: assists(), seed: seed() }); return app.go(() => new RaceScene(app, setup, { run: { type: 'trial', key }, ghostData: app.profile.ghosts[key] ?? null })); };\n117\t  app.lapDone = (scene, trace, time) => { // Time trial: the best lap becomes the ghost.\n118\t    const run = scene.run; if (run?.type !== 'trial') return;\n119\t    const key = run.key, cur = app.profile.ghosts[key], isBest = !cur || time < cur.time; if (!isBest || app.devActive()) { if (scene.ghost) scene.traceStart = scene.sim.time; return; }\n120\t    const data = trace.toData(time, scene.sim.cars[0].carId); app.profile.ghosts[key] = data; recordLap(app.profile, scene.sim.tr.id, time, scene.sim.cars[0].carId); app.save(); scene.setGhost(app.ctx, data); scene.hud.flash('A NEW GHOST: YOUR BEST', 3); scene.traceStart = scene.sim.time; void GhostTrace;\n121\t  };\n122\t  app.startCouch = (p) => { app.runAgain = () => app.startCouch(p); const setup = couchSetup({ ...p, assists: assists(), seed: seed() }); app.actions.couch = true; return app.go(() => new RaceScene(app, setup, { compact: true, run: { type: 'couch' }, onReady: (scene) => startCouchEngine(app, scene, setup) })); };\n123\t  // ---- Test drive: one lap of the Proving Ground ----\n124\t  app.startTestDrive = (carId, install, from) => { const car = from.uid ? carEntry(app.profile, from.uid) : null, setup = testDriveSetup({ carId, install, assists: assists(), paint: install?.paint ?? undefined, seed: seed(), oil: car ? oilOf(car) : 1 }); return app.go(() => new RaceScene(app, setup, { run: { type: 'testdrive', from } })); };\n125\t  app.returnFromTestDrive = (run) => { const f = run.from ?? {}; return toMenu((ui) => { ui.push(new MapScreen(app)); if (f.from === 'dealer') { const d = new DealerScreen(app, { first: f.first && !app.profile.cars.length }); d.room = f.room; d.car = f.car; ui.push(d); } else if (f.from === 'parts') { ui.push(new TuningScreen(app)); ui.push(new PartsScreen(app, f.tile)); } else if (f.from === 'tuning') ui.push(new TuningScreen(app)); }); };\n126\t  // ---- Restart and retire, from the pause menu ----\n127\t  app.restartRun = (scene) => {\n128\t    const run = scene.run ?? {}; app.ui.clear(); stopCouchEngine(app);\n129\t    if (run.type === 'licence') return app.startTest(run.id, { demo: run.demo });\n130\t    if (run.type === 'event') return app.startEventRound(run.id);\n131\t    if (run.type === 'testdrive') { const m = scene.data.cars[scene.data.cars.length - 1]; return app.startTestDrive(m.carId, m.install, run.from); }\n132\t    if (scene.opts.attract) return null;\n133\t    return app.runAgain?.();\n134\t  };\n135\t  app.retireRun = (scene) => {\n136\t    const run = scene.run ?? {}, sim = scene.sim; scene.ended = true; stopCouchEngine(app);\n137\t    if (run.type === 'licence') { const t = TESTS[run.id]; if (!run.demo && !app.devActive()) { recordFailure(app.profile, run.id); app.save(); } return app.backToTests(t.id); }\n138\t    if (run.type === 'testdrive') return app.returnFromTestDrive(run);\n139\t    if (run.type === 'event') { for (const e of sim.players) sim.retire(e.i); sim.updateOrder(); app.factory.raceFinished(scene); return null; }\n140\t    return toMenu(mapThen(() => new ArcadeScreen(app)));\n141\t  };\n142\t  // ---- Replays ----\n143\t  app.watchReplay = ({ after }) => { if (!app.lastRace || !app.lastRace.frames) { app.ui.note('THERE IS NOTHING TO WATCH.'); return null; } return app.go(() => new ReplayScene(app, app.lastRace, { after })); };\n144\t  app.afterResultsReplay = (o) => app.resultsContinue(o);\n145\t  app.watchRecording = (rec, { after }) => app.go(() => new ReplayScene(app, rec, { after: after === 'theatre' ? () => toMenu(mapThen(() => new TheatreScreen(app))) : after }));\n146\t  app.watchSaved = (k, { after }) => { const z = app.profile.replays[k]; if (!z) return null; const rec = Recording.fromCompressed(z); return app.watchRecording(rec, { after }); };\n147\t  app.saveReplay = (k) => { if (!app.lastRace) return false; const prev = app.profile.replays[k], z = app.lastRace.compress(); z.day = app.profile.day; app.profile.replays[k] = z; if (!app.save()) { app.profile.replays[k] = prev; return false; } return true; };\n148\t  app.openGarageFromEvent = (ui) => ui.push(new GarageScreen(app, { onChoose: (u) => { u.note('YOUR RIDE IS CHOSEN.'); } }));\n149\t  app.openTuningFromEvent = (ui) => ui.push(new TuningScreen(app));\n150\t}\n151\t"}]},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"3452a036-f43b-465d-9313-8c851df463c3","timestamp":"2026-11-06T04:16:24.738Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-171904__x89353d/work/GranTumbleweed-GranTurismo3ASpec-claude-opus-5-5-xhigh-20261105-171904/src/game/flows.js","content":"// The glue between screens and scenes: starting a drive, what happens after it, and where it returns to.\nimport { RaceScene } from './scenes/race.js';\nimport { MenuScene } from './scenes/menu.js';\nimport { ReplayScene } from './scenes/replay.js';\nimport { TESTS, LICENCES } from './data/licences.js';\nimport { EVENTS } from './data/events.js';\nimport { CAR_INFO } from './data/cars.js';\nimport { LINES } from './data/text.js';\nimport { carEntry, driveCar, eventState, oilOf, recordFailure, recordLap, recordRound, recordTest } from './sim/career.js';\nimport { couchSetup, eventSetup, quickSetup, testDriveSetup, trialSetup } from './sim/setups.js';\nimport { legCount, testSetup } from './sim/licence.js';\nimport { formatTime } from './sim/race.js';\nimport { GhostTrace, Recording } from './sim/replaydata.js';\nimport { PauseScreen } from './ui/screens/pause.js';\nimport { MapScreen } from './ui/screens/map.js';\nimport { LicenceListScreen, TestListScreen, TestCardScreen, TestResultScreen } from './ui/screens/licence.js';\nimport { EventCardScreen, EventListScreen, RoundCardScreen } from './ui/screens/events.js';\nimport { DealerScreen } from './ui/screens/dealer.js';\nimport { PartsScreen, TuningScreen } from './ui/screens/tuning.js';\nimport { GarageScreen } from './ui/screens/garage.js';\nimport { TheatreScreen } from './ui/screens/theatre.js';\nimport { ArcadeScreen } from './ui/screens/arcade.js';\nimport { ResultsScreen } from './ui/screens/results.js';\nimport { EndingScreen, PodiumScreen, PrizeScreen } from './ui/screens/cinema.js';\nimport { startCouchEngine, stopCouchEngine } from './net/couch.js';\nimport { DevPanel } from './dev/devmode.js';\nvoid Recording;\nexport function installFlows(app) {\n  const seed = () => { app.seedN = (app.seedN ?? 0) + 1; return (Date.now() % 100000) + app.seedN; };\n  const toMenu = (start) => app.go(() => new MenuScene(app, { start }));\n  app.toMenu = toMenu;\n  const mapThen = (...list) => (ui) => { ui.push(new MapScreen(app)); for (const fn of list) ui.push(fn()); };\n  const assists = () => ({ ...app.options.assists });\n  app.toTitle = () => { app.engine.timeScale = 1; return toMenu(null); };\n  app.factory.pause = (scene) => app.ui.push(new PauseScreen(app, scene));\n  app.openDev = (scene) => app.ui.push(new DevPanel(app, scene));\n  // ---- Licence tests ----\n  app.startTest = (id, o = {}) => {\n    const test = TESTS[id], leg = o.leg ?? 0;\n    const setup = { ...testSetup(test, leg, assists()), seed: seed() };\n    return app.go(() => new RaceScene(app, setup, { test, demo: !!o.demo, showLine: !!app.lineForTest || (app.profile.tests[id]?.fails ?? 0) >= 3 && app.lineForTest, legBase: o.legBase ?? 0, run: { type: 'licence', id, demo: !!o.demo } }));\n  };\n  app.factory.testFinished = (scene) => {\n    const J = scene.judge, test = scene.test, demo = !!scene.opts.demo, id = test.id, base = scene.opts.legBase ?? 0, total = J.total + base, leg = scene.leg;\n    app.lastRace = scene.sim.rec;\n    if (J.status === 'pass' && leg + 1 < legCount(test)) { return app.startTest(id, { demo, leg: leg + 1, legBase: total }); }\n    const o = { test, failed: J.status !== 'pass', reason: J.reason, time: total, demo };\n    if (demo) { o.medal = null; app.ui.push(new TestResultScreen(app, { ...o, failed: false, reason: '', demoShown: true, time: total })); return; }\n    if (J.status !== 'pass') { if (!app.devActive()) recordFailure(app.profile, id); }\n    else if (app.devActive()) { o.notSaved = true; }\n    else { const r = recordTest(app.profile, id, total); o.medal = r.medal; o.licenceWon = r.licenceWon; o.reward = r.reward; o.prizeCar = r.prizeCar; o.allGold = r.allGold; if (!r.medal) o.failed = false; }\n    if (!o.failed) o.next = o.medal === 'gold' ? null : o.medal === 'silver' ? 'gold' : o.medal === 'bronze' ? 'silver' : 'bronze';\n    app.save();\n    if (o.licenceWon) app.ui.note(LINES.arai.licence);\n    app.ui.push(new TestResultScreen(app, o));\n  };\n  app.backToTests = (id, o = {}) => {\n    const lic = TESTS[id].licence;\n    return toMenu((ui) => {\n      ui.push(new MapScreen(app)); ui.push(new LicenceListScreen(app)); ui.push(new TestListScreen(app, lic));\n      if (o.prizeCar) ui.push(new PrizeScreen(app, { carId: o.prizeCar, line: LICENCES[lic].allGold?.text, next: () => ui.pop() }));\n    });\n  };\n  app.afterTestReplay = (o) => app.go(() => new MenuScene(app, { start: (ui) => { ui.push(new MapScreen(app)); ui.push(new LicenceListScreen(app)); ui.push(new TestListScreen(app, o.test.licence)); ui.push(new TestCardScreen(app, o.test.id)); } }));\n  // ---- Events ----\n  app.startEventRound = (id) => {\n    const setup = eventSetup(app.profile, id, assists(), seed());\n    return app.go(() => new RaceScene(app, setup, { run: { type: 'event', id } }));\n  };\n  app.factory.raceFinished = (scene) => {\n    const sim = scene.sim, kind = scene.data.kind, me = sim.cars.find((e) => e.player === 0), run = scene.run ?? {};\n    app.lastRace = sim.rec; const rows = sim.results(); for (const e of sim.cars) app.profile.seen[e.carId] = true;\n    const car = carEntry(app.profile);\n    if (kind === 'testdrive') return app.returnFromTestDrive(run);\n    const record = !app.devActive() && me?.bestLap ? recordLap(app.profile, sim.tr.id, me.bestLap, me.carId) : false;\n    const o = { kind, rows, track: sim.tr.id, best: me?.bestLap ?? null, bestText: me?.bestLap ? formatTime(me.bestLap) : '', record, seed: scene.data.seed, run };\n    if (kind === 'race' || kind === 'rally') {\n      app.undo = JSON.stringify(app.profile);\n      if (car && me) { driveCar(app.profile, car, me.metres, me.dirtM); car.lastWear = (me.c.wear[0] + me.c.wear[1] + me.c.wear[2] + me.c.wear[3]) / 4; }\n      const names = rows.map((r) => r.name), r = recordRound(app.profile, run.id, names, 'YOU', app.prizeMult ?? 1);\n      Object.assign(o, { title: EVENTS[run.id].name, prize: r.prize, points: r.points, showPoints: kind === 'race', round: r });\n      if (r.seriesDone) { o.seriesWon = r.seriesWon; o.seriesLine = r.seriesWon ? `THE SERIES IS YOURS. ${r.bonus ? `BONUS ${r.bonus.toLocaleString('en-US')} CR.` : ''}${r.prizeCar ? ` PRIZE: ${CAR_INFO[r.prizeCar].short}.` : ''}` : 'THE SERIES GOES TO ANOTHER DRIVER. YOU MAY ENTER AGAIN.'; }\n      else o.seriesLine = `ROUND ${eventState(app.profile, run.id).round + 1} OF ${EVENTS[run.id].rounds.length} IS NEXT.`;\n      if (me?.pos === 1 && sim.tr.id === 'harbour') scene.fireworksOn = true;\n      app.save();\n    } else if (kind === 'couch') { stopCouchEngine(app); o.title = 'THE DUEL'; o.retry = true; }\n    else { o.title = kind === 'timetrial' ? 'TIME TRIAL' : 'QUICK RACE'; if (me?.pos === 1 && sim.tr.id === 'harbour') scene.fireworksOn = true; }\n    app.ui.push(new ResultsScreen(app, o));\n  };\n  app.resultsContinue = (o) => {\n    const k = o.kind;\n    if (k === 'race' || k === 'rally') {\n      const r = o.round, id = o.run.id;\n      if (r.seriesDone && r.seriesWon) return app.ceremony(id, r);\n      if (r.seriesDone) return toMenu(mapThen(() => new EventListScreen(app), () => new EventCardScreen(app, id)));\n      return toMenu(mapThen(() => new EventListScreen(app), () => new EventCardScreen(app, id), () => new RoundCardScreen(app, id)));\n    }\n    return toMenu(mapThen(() => new ArcadeScreen(app)));\n  };\n  app.ceremony = (id, r) => {\n    const car = carEntry(app.profile), finish = (ui) => { ui.clear(); ui.push(new MapScreen(app)); };\n    return toMenu((ui) => {\n      ui.push(new MapScreen(app));\n      const afterPrize = () => { if (r.ending) { ui.pop(); ui.push(new EndingScreen(app, { next: () => finish(ui) })); } else finish(ui); };\n      const toPrize = () => { ui.pop(); if (r.prizeCar) ui.push(new PrizeScreen(app, { carId: r.prizeCar, next: afterPrize })); else afterPrize(); };\n      ui.push(new PodiumScreen(app, { eventId: id, carId: car?.carId ?? 'kite', install: car?.install, next: toPrize, line: LINES.dell.win[0].replace('{TRACK}', 'THE PENINSULA').replace('{NAME}', 'THE DRIVER') }));\n    });\n  };\n  app.resultsRetry = (o) => {\n    const k = o.kind;\n    if (k === 'race' || k === 'rally') { if (app.undo) { app.profile = JSON.parse(app.undo); app.save(); } return app.startEventRound(o.run.id); }\n    return app.runAgain?.();\n  };\n  // ---- Arcade ----\n  app.startQuick = (p) => { app.runAgain = () => app.startQuick(p); const setup = quickSetup({ ...p, assists: assists(), seed: seed(), poolIds: Object.keys(CAR_INFO).filter((c) => c !== 'type9' || p.carId === 'type9').slice(0, 13) }); return app.go(() => new RaceScene(app, setup, { run: { type: 'quick' } })); };\n  app.startTimeTrial = (p) => { app.runAgain = () => app.startTimeTrial(p); const key = `${p.track}:${p.carId}`, setup = trialSetup({ ...p, assists: assists(), seed: seed() }); return app.go(() => new RaceScene(app, setup, { run: { type: 'trial', key }, ghostData: app.profile.ghosts[key] ?? null })); };\n  app.lapDone = (scene, trace, time) => { // Time trial: the best lap becomes the ghost.\n    const run = scene.run; if (run?.type !== 'trial') return;\n    const key = run.key, cur = app.profile.ghosts[key], isBest = !cur || time < cur.time; if (!isBest || app.devActive()) { if (scene.ghost) scene.traceStart = scene.sim.time; return; }\n    const data = trace.toData(time, scene.sim.cars[0].carId); app.profile.ghosts[key] = data; recordLap(app.profile, scene.sim.tr.id, time, scene.sim.cars[0].carId); app.save(); scene.setGhost(app.ctx, data); scene.hud.flash('A NEW GHOST: YOUR BEST', 3); scene.traceStart = scene.sim.time; void GhostTrace;\n  };\n  app.startCouch = (p) => { app.runAgain = () => app.startCouch(p); const setup = couchSetup({ ...p, assists: assists(), seed: seed() }); app.actions.couch = true; return app.go(() => new RaceScene(app, setup, { compact: true, run: { type: 'couch' }, onReady: (scene) => startCouchEngine(app, scene, setup) })); };\n  // ---- Test drive: one lap of the Proving Ground ----\n  app.startTestDrive = (carId, install, from) => { const car = from.uid ? carEntry(app.profile, from.uid) : null, setup = testDriveSetup({ carId, install, assists: assists(), paint: install?.paint ?? undefined, seed: seed(), oil: car ? oilOf(car) : 1 }); return app.go(() => new RaceScene(app, setup, { run: { type: 'testdrive', from } })); };\n  app.returnFromTestDrive = (run) => { const f = run.from ?? {}; return toMenu((ui) => { ui.push(new MapScreen(app)); if (f.from === 'dealer') { const d = new DealerScreen(app, { first: f.first && !app.profile.cars.length }); d.room = f.room; d.car = f.car; ui.push(d); } else if (f.from === 'parts') { ui.push(new TuningScreen(app)); ui.push(new PartsScreen(app, f.tile)); } else if (f.from === 'tuning') ui.push(new TuningScreen(app)); }); };\n  // ---- Restart and retire, from the pause menu ----\n  app.restartRun = (scene) => {\n    const run = scene.run ?? {}; app.ui.clear(); stopCouchEngine(app);\n    if (run.type === 'licence') return app.startTest(run.id, { demo: run.demo });\n    if (run.type === 'event') return app.startEventRound(run.id);\n    if (run.type === 'testdrive') { const m = scene.data.cars[scene.data.cars.length - 1]; return app.startTestDrive(m.carId, m.install, run.from); }\n    if (scene.opts.attract) return null;\n    return app.runAgain?.();\n  };\n  app.retireRun = (scene) => {\n    const run = scene.run ?? {}, sim = scene.sim; scene.ended = true; stopCouchEngine(app);\n    if (run.type === 'licence') { const t = TESTS[run.id]; if (!run.demo && !app.devActive()) { recordFailure(app.profile, run.id); app.save(); } return app.backToTests(t.id); }\n    if (run.type === 'testdrive') return app.returnFromTestDrive(run);\n    if (run.type === 'event') { for (const e of sim.players) sim.retire(e.i); sim.updateOrder(); app.factory.raceFinished(scene); return null; }\n    return toMenu(mapThen(() => new ArcadeScreen(app)));\n  };\n  // ---- Replays ----\n  app.watchReplay = ({ after }) => { if (!app.lastRace || !app.lastRace.frames) { app.ui.note('THERE IS NOTHING TO WATCH.'); return null; } return app.go(() => new ReplayScene(app, app.lastRace, { after })); };\n  app.afterResultsReplay = (o) => app.resultsContinue(o);\n  app.watchRecording = (rec, { after }) => app.go(() => new ReplayScene(app, rec, { after: after === 'theatre' ? () => toMenu(mapThen(() => new TheatreScreen(app))) : after }));\n  app.watchSaved = (k, { after }) => { const z = app.profile.replays[k]; if (!z) return null; const rec = Recording.fromCompressed(z); return app.watchRecording(rec, { after }); };\n  app.saveReplay = (k) => { if (!app.lastRace) return false; const prev = app.profile.replays[k], z = app.lastRace.compress(); z.day = app.profile.day; app.profile.replays[k] = z; if (!app.save()) { app.profile.replays[k] = prev; return false; } return true; };\n  app.openGarageFromEvent = (ui) => ui.push(new GarageScreen(app, { onChoose: (u) => { u.note('YOUR RIDE IS CHOSEN.'); } }));\n  app.openTuningFromEvent = (ui) => ui.push(new TuningScreen(app));\n}\n","numLines":151,"startLine":1,"totalLines":151}},"tool_result_meta":[{"id":"toolu_011eJg7JAZqMVtQKSTxpuvY4","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
