(t.x, t.y + 20, t.z, 13, 0.5, 13, 'mist'); b.box(t.x, t.y + 20.5, t.z, 0.4, 5, 0.4, 'slate');\n    blockText(b, 'LICENCE', [t.x - 13.5, t.y + 8, t.z - 4.1], 1, 0, 1, 'red', 0.3);\n    for (let k = 0; k < 5; k++) { const h = d.at(300 + k * 56, -1, 30), W = 40, D = 26, H = 13; b.box(h.x, h.y, h.z, W, H, D, k % 2 ? mix('mist', 'slate', 0.3) : mix('slate', 'mist', 0.2), 0, 'slate'); b.box(h.x, h.y + H - 0.2, h.z, W + 1, 0.4, D + 1, 'white'); b.box(h.x, h.y, h.z + D / 2 + 0.05, W - 6, H - 3, 0.1, 'night'); }\n    // A retired airliner's tail, as old airfields have.\n    const j = d.at(740, -1, 40); b.box(j.x, j.y + 3, j.z, 5, 4.5, 40, 'white', 0.3); b.box(j.x, j.y + 6, j.z - 16, 0.6, 8, 8, 'red', 0.3); b.box(j.x, j.y + 4, j.z + 2, 34, 0.6, 7, 'mist', 0.3);\n    // Painted boxes and cones on the apron.\n    for (const s of [120, 200, 280, 400, 520]) for (const side of [-1, 1]) { const p = d.at(s, side, -9); b.box(p.x, y0 + 0.03 + Math.max(p.y - y0, 0) * 0, p.z, 6, 0.04, 6, 'sand', p.yaw); }\n    d.scatter(60, (x, y, z) => { b.cone(x, y, z, 0.28, 0.75, 5, 'orange'); b.box(x, y, z, 0.6, 0.06, 0.6, 'orange'); }, { minD: -12, maxD: 4, r: -14 });\n    // Windsock on a pole, by cloth.\n    const w = d.at(60, 1, 8); b.box(w.x, w.y, w.z, 0.2, 8, 0.2, 'white');\n    const sock = clothGrid({ width: 3.4, height: 0.9, cols: 10, rows: 4, origin: [w.x, w.y + 8, w.z], across: [1, 0, 0.3], pin: 'left' }); sock.wind = [9, 0.6, 2]; sock.gust = 0.9; sock.drag = 0.6; const sm = new SoftMesh(sock, toonMaterial(PALETTE.orange), { doubleSided: true }); sm.castShadow = false; d.add(sm); d.fixed.push((dt) => sock.step(dt)); d.mover(() => sm.sync());\n    // The examiner's van, beside the tower.\n    const v = { x: t.x + 12, y: t.y, z: t.z + 8 }; b.box(v.x, v.y + 0.4, v.z, 2, 2, 4.6, 'white', 0.4, 'mist'); b.box(v.x, v.y + 0.3, v.z, 2.1, 0.5, 4.7, 'navy', 0.4); g.box(v.x - 0.2, v.y + 2.4, v.z, 0.8, 0.2, 0.3, 'orange', 0.4); for (const q of [-1, 1]) for (const e of [-1, 1]) b.box(v.x + q * 1, v.y, v.z + e * 1.5, 0.3, 0.6, 0.6, 'ink', 0.4);\n    d.scatter(70, (x, y, z) => d.oak(x, y, z, 2, 4.5), { minD: 24, maxD: 110, r: 4 });\n    void r;\n  },\n};\nexport function buildDressing(ctx, tr, mesh, hour, night) {\n  const d = new Dress(ctx, tr, mesh, hour); d.night = night;\n  DRESS[tr.id]?.(d);\n  const lamps = d.gantry();\n  d.finish();\n  return { group: d.group, update: (dt, t, cheer, focus) => { for (const fn of d.movers) fn(dt, t, cheer, ctx, focus); }, fixedUpdate: (dt) => { for (const fn of d.fixed) fn(dt); }, lamps, tunnel: d.tunnel };\n}\nvoid rgb;\nEOF\npython3 - <<'EOF'\n# trackmesh: export terrainAt, lamp indices, and lamp pools.\np='src/game/render/trackmesh.js'; s=open(p).read()\na=\"  group.add(road.mesh({ receive: true }), land.mesh({ receive: !night }), rails.mesh({ receive: false }));\\n  return { group, field, groundY, theme };\"\nb=\"\"\"  group.add(road.mesh({ receive: true }), land.mesh({ receive: !night }), rails.mesh({ receive: false }));\n  const terrainAt = (i, side, d) => {\n    const k = ((i % tr.N) + tr.N) % tr.N, q = k - (k % step), reach = lim[side][q] || maxReach;\n    if (d > reach) return groundY;\n    const H = tr.width[k] / 2 + 1.5 + Math.max(0, d);\n    return heightAt(k, side, Math.max(0, d), tr.y[k] - H * side * Math.sin(tr.bank[k]));\n  };\n  return { group, field, groundY, theme, terrainAt, lampIdx: opts.lampIdx ?? null };\"\"\"\nassert a in s; s=s.replace(a,b)\na=\"export function buildTrackMesh(tr, line, { lamps = null, speeds = null, night = false } = {}) {\"\nb=\"export function buildTrackMesh(tr, line, opts = {}) {\\n  const { lamps = null, speeds = null, night = false } = opts;\"\nassert a in s; s=s.replace(a,b)\nopen(p,'w').write(s)\nEOF\ncat > src/game/render/world.js <<'EOF'\n// The whole race world for one circuit: road, terrain, dressing, sky, lamps. Used by the race and by replays.\nimport { Precipitation, THREE } from '../../pixel-engine.js';\nimport { buildTrackMesh, THEMES } from './trackmesh.js';\nimport { buildDressing } from './dressing.js';\nimport { applyHour, buildSkyDressing, nightOf } from './sky.js';\nimport { registerParticles } from './particles.js';\nimport { SkidMarks } from './skid.js';\nconst { Group } = THREE;\nfunction lampPools(tr) { // Harbour Lights: lamps every 16 samples, their pools baked into the road's colours.\n  const lamps = new Float32Array(tr.N), idx = [];\n  for (let i = 0; i < tr.N; i += 16) { idx.push(i); for (let o = -3; o <= 3; o++) lamps[(i + o + tr.N) % tr.N] = Math.max(lamps[(i + o + tr.N) % tr.N], 1 - Math.abs(o) / 4); }\n  return { lamps, idx };\n}\nexport function buildWorld(ctx, tr, line, { hour, rain = false, speeds = null }) {\n  registerParticles(ctx);\n  const night = nightOf(hour), group = new Group(), theme = THEMES[tr.id];\n  const pools = tr.id === 'harbour' ? lampPools(tr) : null;\n  const mesh = buildTrackMesh(tr, line, { lamps: pools && night > 0.25 ? pools.lamps : null, lampIdx: pools?.idx ?? null, speeds, night: night > 0.5 });\n  group.add(mesh.group);\n  const dress = buildDressing(ctx, tr, mesh, hour, night);\n  group.add(dress.group);\n  const cx = (Math.min(...tr.x) + Math.max(...tr.x)) / 2, cz = (Math.min(...tr.z) + Math.max(...tr.z)) / 2;\n  group.add(buildSkyDressing(tr, theme, hour, { cx, cz, seed: tr.N, skyline: tr.id === 'harbour' }));\n  ctx.scene.add(group);\n  const skids = new SkidMarks(1400, tr.surface === 'dirt' ? 'plum' : 'ink'); ctx.scene.add(skids.mesh);\n  let curHour = null, inTunnel = false, rainFx = null;\n  const setHour = (h, tunnel = 0) => { applyHour(ctx.engine, h, { rain, tunnel }); curHour = h; };\n  setHour(hour);\n  if (rain) { rainFx = new Precipitation({ kind: 'rain', count: 1100, area: [70, 26, 70], color: 0x94b0c2, speed: 26 }); rainFx.wind.set(1.2, 0.4); ctx.scene.add(rainFx); }\n  const out = {\n    group, mesh, dress, skids, theme, field: mesh.field, night, rain,\n    lamps: dress.lamps,\n    setHourIf(h) { if (Math.abs(h - curHour) > 0.05) setHour(h, inTunnel ? 1 : 0); },\n    update(dt, t, cheer, focus, sAtFocus) {\n      dress.update(dt, t, cheer, focus);\n      if (dress.tunnel && sAtFocus !== undefined) { const now = sAtFocus > dress.tunnel[0] && sAtFocus < dress.tunnel[1]; if (now !== inTunnel) { inTunnel = now; setHour(curHour, now ? 1 : 0); } }\n      if (rainFx && focus) rainFx.update(dt, focus);\n    },\n    fixedUpdate(dt) { dress.fixedUpdate(dt); },\n    setLights(n, green) { dress.lamps.forEach((l, k) => { l.red.visible = !green && k < n; l.green.visible = !!green; }); },\n  };\n  return out;\n}\nEOF\necho done","description":"Write block text, per-track dressing and the world builder"}}}
