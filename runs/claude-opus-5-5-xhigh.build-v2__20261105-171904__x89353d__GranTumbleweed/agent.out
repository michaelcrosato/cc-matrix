{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013dVF6z5P8S4PJVrsScVEzH","type":"tool_result","content":"1\t// RaceSim: the field, laps, flags, starts, pit lane, slipstream, results, replay feed and events. Plain JS, no engine.\n2\timport { aiDrive, buildTrack, collideCars, G, newCar, racingLine, RHO, speedProfile, stepCar } from './sim.js';\n3\timport { TRACKS } from '../data/tracks.js';\n4\timport { tunedParams } from './tuning.js';\n5\timport { F_AIR, F_BRAKE, F_HEAD, F_LOCK, F_PIT, F_SLIDE, FIELDS, GhostTrace, Recording } from './replaydata.js';\n6\t\n7\texport const PIT_WIDTH = 8, PIT_SPEED = 60 / 3.6;\n8\tconst lineCache = new Map(), profileCache = new Map();\n9\texport function loadTrack(id, { rain = false } = {}) {\n10\t  const tr = buildTrack(TRACKS[id]);\n11\t  tr.id = id; tr.name = TRACKS[id].name; tr.pit = TRACKS[id].pit ?? null;\n12\t  if (rain) tr.muScale = 0.78;\n13\t  if (!lineCache.has(id)) lineCache.set(id, racingLine(tr));\n14\t  if (tr.pit) { const inner = tr.pit.in; tr.pit = { ...tr.pit, lead: inner - 60 }; forPit(tr, (i) => { tr.wallR[i] = PIT_WIDTH + 2; }); }\n15\t  return { tr, line: lineCache.get(id) };\n16\t}\n17\texport const wrapS = (tr, s) => ((s % tr.length) + tr.length) % tr.length;\n18\tconst rel = (tr, s) => { let d = wrapS(tr, s); if (d > tr.length / 2) d -= tr.length; return d; };\n19\tfunction forPit(tr, fn) { const from = tr.pit.lead ?? tr.pit.in; for (let i = 0; i < tr.N; i++) { const d = rel(tr, i * tr.ds); if (d >= from && d <= tr.pit.out) fn(i, d); } }\n20\texport function trackPoint(tr, s, t, out = {}) {\n21\t  const S = wrapS(tr, s), f = S / tr.ds, i = Math.floor(f) % tr.N, j = (i + 1) % tr.N, u = f - Math.floor(f), L = (a) => a[i] + (a[j] - a[i]) * u, tx = L(tr.tx), tz = L(tr.tz), bk = L(tr.bank);\n22\t  out.x = L(tr.x) - tz * t; out.z = L(tr.z) + tx * t; out.y = L(tr.y) - t * Math.sin(bk); out.yaw = Math.atan2(tx, tz); out.i = i; out.tx = tx; out.tz = tz; out.width = L(tr.width); out.bank = bk; out.slope = tr.slope[i];\n23\t  return out;\n24\t}\n25\texport function indexOfS(tr, s) { return Math.round(wrapS(tr, s) / tr.ds) % tr.N; }\n26\tfunction mulberry(seed) { let a = seed >>> 0; return () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n27\texport function carProfile(tr, line, p, carId, installKey) {\n28\t  const key = `${tr.id}|${carId}|${installKey}|${tr.muScale}`;\n29\t  let v = profileCache.get(key);\n30\t  if (!v) {\n31\t    const surf = (tr.surface === 'dirt' ? (p.tyreTable?.dirt ?? 0.62) : 1) * tr.muScale;\n32\t    // Steep banking: the flat-road estimate is too hopeful, and a car that overdrives it scrapes the wall and eats its tyres.\n33\t    // Measured on Saltline: this limit is quicker and clean for every car. It leaves flat circuits alone.\n34\t    let vCap = null;\n35\t    for (let i = 0; i < tr.N; i++) if (Math.abs(tr.bank[i]) > 0.15) {\n36\t      vCap ??= new Float64Array(tr.N).fill(110);\n37\t      const mu = p.tyreMu * 0.57 * surf, tb = Math.tan(Math.abs(tr.bank[i])), muB = (mu + tb) / Math.max(0.2, 1 - mu * tb), den = Math.max(Math.abs(line.kappa[i]), 1e-5) - (muB * (RHO * p.clA)) / (2 * p.mass);\n38\t      vCap[i] = den > 1e-5 ? Math.min(110, Math.sqrt((muB * G) / den)) : 110;\n39\t    }\n40\t    v = speedProfile(tr, line, vCap ? { ...p, vCap } : p, surf); profileCache.set(key, v);\n41\t  }\n42\t  return v;\n43\t}\n44\texport const defaultEnv = () => ({ gripScale: 1, powerScale: 1, brakeScale: 1, aeroScale: 1, wearScale: 1, fuelScale: 1, wallLoss: 1, stability: 1, traction: 1, rubber: 0, slip: 0.65, aiPace: null, god: false, steerRate: 3 });\n45\tconst BASE_WEAR = 0.0012, BASE_FUEL = 0.0018;\n46\texport class RaceSim {\n47\t  // setup: { kind, track, laps, rain, start, startS, startSpeed, contact, wear, fuel, cars: [{ carId, install, oil, name, paint, skill, player, assists, seat }], seed, stagger }\n48\t  constructor(setup) {\n49\t    this.setup = setup; this.kind = setup.kind ?? 'race'; this.laps = setup.laps ?? 1; this.rng = mulberry(setup.seed ?? 1);\n50\t    const { tr, line } = loadTrack(setup.track, { rain: setup.rain }); this.tr = tr; this.line = line;\n51\t    this.contact = setup.contact !== false; this.wearMul = setup.wear ?? 1; this.fuelMul = setup.fuel ?? 1; this.env = setup.env ?? defaultEnv();\n52\t    this.frame = 0; this.time = 0; this.greenAt = null; this.phase = 'grid'; this.lights = 0; this.lightT = 0; this.events = []; this.order = []; this.done = false; this.leaderFinishedAt = null; this.hold = !!setup.hold; this.subEnv = {}; this.flaggedAt = null; this.hourNow = setup.hour ?? TRACKS[setup.track].hour; this.cool = false;\n53\t    this.cars = setup.cars.map((d, i) => this.makeEntry(d, i));\n54\t    this.placeGrid();\n55\t    this.players = this.cars.filter((e) => e.player !== null && e.player !== undefined);\n56\t    this.order = this.cars.slice();\n57\t    this.rec = setup.record === false ? null : new Recording({ track: setup.track, hour: this.hourNow, hourEnd: setup.hourEnd ?? null, rain: !!setup.rain, cars: this.cars.map((e) => ({ carId: e.carId, install: e.install, name: e.name, paint: e.paint, player: e.player ?? null })) });\n58\t    this.recVals = new Array(FIELDS).fill(0);\n59\t    this.updateOrder();\n60\t  }\n61\t  makeEntry(d, i) {\n62\t    const p = tunedParams(d.carId, d.install), tr = this.tr, c = newCar(p, tr, 0, 0), installKey = d.install ? JSON.stringify(d.install) : '';\n63\t    c.oil = d.oil ?? 1;\n64\t    const e = { i, carId: d.carId, install: d.install ?? null, name: d.name ?? `CAR ${i + 1}`, paint: d.paint ?? null, player: d.player ?? null, seat: d.seat ?? null, c, p, installKey, speeds: carProfile(tr, this.line, p, d.carId, installKey), skill: d.skill ?? 0.9, assists: d.assists ?? null, lap: 0, lastS: 0, lapStart: null, lastLap: null, bestLap: null, finished: false, finishTime: null, retired: false, progress: 0, pit: null, noContact: 0, stopped: 0, recoveries: 0, walls: 0, topSpeed: 0, wrongWay: false, reverse: false, brakeHold: 0, dirt: d.dirt ?? 0, dirtM: 0, metres: 0, lapse: 0, lapseAt: 0.2 + 0.6 * this.rng(), phase: this.rng() * 6.28, slip: false, autoDrive: false, wantPit: false, pits: 0, startDelay: d.startDelay ?? 0, ownStart: null, splits: [], lastSurface: null, lastGear: 1, lastWalls: 0, lastAir: false, airT: 0, lockT: 0, onLapDirty: false, flagged: false, input: null, laneNow: 0 };\n65\t    return e;\n66\t  }\n67\t  placeGrid() {\n68\t    const s = this.setup, tr = this.tr, n = this.cars.length;\n69\t    const place = (e, S, t, speed) => { const i = indexOfS(tr, S), pt = trackPoint(tr, S, t), c = e.c; c.x = pt.x; c.z = pt.z; c.y = pt.y; c.yaw = pt.yaw; c.loc.i = i; c.loc.s = wrapS(tr, S); c.loc.t = t; c.vx = Math.sin(pt.yaw) * speed; c.vz = Math.cos(pt.yaw) * speed; c.u = speed; e.lastS = wrapS(tr, S); c.laneNow = t - this.line.off[i]; e.gridT = t; };\n70\t    const kind = s.start ?? 'standing';\n71\t    if (kind === 'rolling') {\n72\t      this.phase = 'rolling';\n73\t      this.cars.forEach((e, k) => place(e, -150 - Math.floor(k / 2) * 12, k % 2 ? 2.6 : -2.6, 80 / 3.6));\n74\t    } else if (kind === 'flying') {\n75\t      this.phase = 'green'; this.greenAt = 0;\n76\t      const S = s.startS ?? -220;\n77\t      this.cars.forEach((e, k) => { place(e, S - k * 12, 0, (s.startSpeed ?? 120) / 3.6); e.ownStart = 0; });\n78\t    } else { // standing, and rally's stagger\n79\t      this.phase = 'grid';\n80\t      const S0 = s.startS ?? -12;\n81\t      this.cars.forEach((e, k) => {\n82\t        const row = Math.floor(k / 2), staggered = kind === 'stagger';\n83\t        place(e, staggered ? S0 : S0 - row * 9, staggered || this.cars.length === 1 ? 0 : k % 2 ? 2.6 : -2.6, 0);\n84\t      });\n85\t    }\n86\t    this.updateProgressAll();\n87\t  }\n88\t  updateProgressAll() { for (const e of this.cars) e.progress = this.progressOf(e); }\n89\t  progressOf(e) { return (e.lap - 1) * this.tr.length + (e.lap === 0 ? wrapS(this.tr, e.c.loc.s) : e.c.loc.s); }\n90\t  go() { if (this.phase === 'grid') { this.hold = false; this.green(); } }\n91\t  green() { this.phase = 'green'; this.greenAt = this.time; for (const e of this.cars) if (e.startDelay === 0) e.ownStart = this.time; this.events.push({ type: 'flag', kind: 'green' }); }\n92\t  emit(type, car, extra) { this.events.push({ type, car: car?.i ?? -1, ...extra }); }\n93\t  drainEvents() { const ev = this.events; this.events = []; return ev; }\n94\t  envFor(e) {\n95\t    const v = this.env, god = v.god && e.player !== null, se = this.subEnv;\n96\t    se.gripScale = v.gripScale; se.powerScale = v.powerScale; se.brakeScale = v.brakeScale; se.aeroScale = v.aeroScale;\n97\t    se.wearRate = god ? 0 : BASE_WEAR * this.wearMul * v.wearScale; se.fuelRate = god ? 0 : BASE_FUEL * this.fuelMul * v.fuelScale; se.wallLoss = god ? 0 : v.wallLoss;\n98\t    return se;\n99\t  }\n100\t  aiInput(e, skillMul = 1) {\n101\t    const c = e.c, tr = this.tr, u = Math.hypot(c.vx, c.vz);\n102\t    let skill = (this.env.aiPace ?? e.skill) * skillMul * (tr.def.aiScale ?? 1);\n103\t    const wearNow = (c.wear[0] + c.wear[1] + c.wear[2] + c.wear[3]) / 4; skill *= Math.sqrt(0.72 + 0.28 * Math.sqrt(wearNow)); // a worn tyre has less to give, and the AI knows it\n104\t    if (e.lapse > 0) { skill -= 0.04; e.lapse -= 1 / 60; }\n105\t    if (this.env.rubber > 0 && this.players.length) { const lead = this.players[0].progress - e.progress; skill += Math.max(-1, Math.min(1, lead / 150)) * this.env.rubber; }\n106\t    let lane = Math.sin(e.phase + this.time * 0.3) * 0.6;\n107\t    if (this.phase === 'rolling') { lane = (e.gridT ?? 0) - this.line.off[c.loc.i]; }\n108\t    const field = this.contact && !e.finished ? (this.rawCars ??= this.cars.map((x) => x.c)) : null;\n109\t    const inp = aiDrive(c, tr, this.line, e.speeds, { skill, lane }, field);\n110\t    if (this.phase === 'rolling') { const err = 88 / 3.6 - u; inp.throttle = err > 0 ? Math.min(1, err) : 0; inp.brake = err < -1 ? 0.3 : 0; }\n111\t    if (tr.surface === 'dirt') inp.asm = (inp.asm ?? 0.6) * 0.5;\n112\t    return inp;\n113\t  }\n114\t  driverInput(e, raw) {\n115\t    // raw: { steer, throttle, brake, handbrake, up, down } from the input layer. Assists come from the profile.\n116\t    const c = e.c, a = e.assists ?? {}, env = this.env, inp = e.input ?? (e.input = {});\n117\t    let throttle = raw.throttle ?? 0, brake = raw.brake ?? 0;\n118\t    const speed = c.u;\n119\t    // Reverse: hold the brake at a standstill for 0.4 s. Any throttle returns to first.\n120\t    if (e.reverse) { if (throttle > 0.05) { e.reverse = false; c.gear = 1; } else { throttle = brake; brake = 0; } }\n121\t    else if (brake > 0.2 && throttle < 0.05 && Math.abs(speed) < 0.5) { e.brakeHold += 1 / 60; if (e.brakeHold > 0.4) { e.reverse = true; e.brakeHold = 0; c.gear = 1; } } else e.brakeHold = 0;\n122\t    inp.steer = raw.steer ?? 0; inp.throttle = throttle; inp.brake = brake; inp.handbrake = !!raw.handbrake; inp.reverse = e.reverse;\n123\t    inp.abs = a.abs !== false; inp.auto = a.auto !== false; inp.up = !!raw.up; inp.down = !!raw.down;\n124\t    inp.tcs = Math.min(1, ((a.tcs ?? 5) / 10) * env.traction); inp.asm = Math.min(1, ((a.asm ?? 5) / 10) * env.stability * (this.tr.surface === 'dirt' ? 0.5 : 1)); inp.steerRate = env.steerRate;\n125\t    if (this.phase === 'rolling') { if (c.u > 25) { inp.throttle = 0; if (c.u > 26) inp.brake = Math.max(inp.brake, 0.3); } }\n126\t    if (this.phase === 'grid') { inp.throttle = 0; inp.brake = 1; inp.handbrake = false; inp.reverse = false; }\n127\t    if (e.ownStart === null && this.phase !== 'rolling') { inp.throttle = 0; inp.brake = 1; }\n128\t    return inp;\n129\t  }\n130\t  step(inputs = []) {\n131\t    const dt = 1 / 60;\n132\t    this.frame++; this.time += dt;\n133\t    if (this.phase === 'grid' && !this.hold) {\n134\t      this.lightT += dt;\n135\t      const lit = Math.min(5, Math.floor(this.lightT / 0.6));\n136\t      if (lit !== this.lights) { this.lights = lit; this.events.push({ type: 'flag', kind: 'lights', n: lit }); }\n137\t      if (this.lightT > 3.4) this.green();\n138\t    }\n139\t    if (this.phase === 'rolling') {\n140\t      const leader = this.cars.reduce((a, b) => (this.progressOf(a) > this.progressOf(b) ? a : b));\n141\t      if (this.progressOf(leader) >= 0 && leader.lap >= 1) { this.green(); }\n142\t    }\n143\t    for (const e of this.cars) {\n144\t      if (e.ownStart === null && this.phase === 'green' && this.time - this.greenAt >= e.startDelay) { e.ownStart = this.time; if (e.player !== null) this.events.push({ type: 'flag', kind: 'green', own: true }); }\n145\t    }\n146\t    this.slipstream();\n147\t    for (const e of this.cars) {\n148\t      const human = e.player !== null && !e.autoDrive && !e.finished && !e.retired;\n149\t      if (e.pit) { e.inp = null; continue; }\n150\t      if (human) e.inp = this.driverInput(e, inputs[e.player] ?? {});\n151\t      else {\n152\t        const held = (this.phase === 'grid') || (e.ownStart === null && this.phase !== 'rolling');\n153\t        e.inp = held ? { steer: 0, throttle: 0, brake: 1, abs: true, auto: true, tcs: 0, asm: 0 } : this.aiInput(e, e.finished ? 0.82 : 1);\n154\t      }\n155\t    }\n156\t    const contactCars = this.contact ? this.cars.filter((e) => !e.pit && e.noContact <= 0 && !e.ghost).map((e) => e.c) : null;\n157\t    for (let sub = 0; sub < 4; sub++) {\n158\t      for (const e of this.cars) {\n159\t        if (e.pit) continue;\n160\t        const inp = e.inp;\n161\t        if (sub > 0 && inp.up) { inp.up = false; }\n162\t        if (sub > 0 && inp.down) { inp.down = false; }\n163\t        stepCar(e.c, inp, 1 / 240, this.tr, this.envFor(e));\n164\t      }\n165\t      if (contactCars) collideCars(contactCars);\n166\t    }\n167\t    for (const e of this.cars) this.post(e, dt);\n168\t    if (this.setup.hourEnd !== undefined && this.setup.hourEnd !== null && this.laps > 0) {\n169\t      const lead = Math.max(0, Math.max(...this.cars.map((e) => e.progress))) / (this.laps * this.tr.length);\n170\t      this.hourNow = (this.setup.hour ?? 18.5) + (this.setup.hourEnd - (this.setup.hour ?? 18.5)) * Math.min(1, lead);\n171\t    }\n172\t    this.updateOrder();\n173\t    this.checkFinish();\n174\t    if (this.rec && this.frame % 2 === 0) this.record();\n175\t  }\n176\t  slipstream() {\n177\t    const tr = this.tr, slip = this.env.slip;\n178\t    for (const e of this.cars) {\n179\t      e.slip = false; e.c.dragScale = 1;\n180\t      if (Math.abs(e.c.u) < 100 / 3.6 || e.pit) continue;\n181\t      for (const b of this.cars) {\n182\t        if (b === e || b.pit) continue;\n183\t        let gap = (b.c.loc.s - e.c.loc.s + tr.length) % tr.length;\n184\t        if (gap > 0.5 && gap < 25 && Math.abs(b.c.loc.t - e.c.loc.t) < 2) { e.c.dragScale = slip; e.slip = true; break; }\n185\t      }\n186\t    }\n187\t  }\n188\t  post(e, dt) {\n189\t    const c = e.c, tr = this.tr;\n190\t    if (e.pit) this.stepPit(e, dt);\n191\t    if (e.noContact > 0) e.noContact -= dt;\n192\t    // Lap count: s wraps from past 90% to under 10% going forward.\n193\t    const s = c.loc.s, L = tr.length;\n194\t    if (e.lastS > L * 0.9 && s < L * 0.1) this.crossLine(e);\n195\t    else if (e.lastS < L * 0.1 && s > L * 0.9) { if (e.lap > 0) e.lap--; }\n196\t    const moved = Math.min(5, Math.abs(wrapDelta(s, e.lastS, L)));\n197\t    e.metres += moved;\n198\t    if (c.surface === 'dirt' || c.surface === 'gravel') { e.dirtM += moved; e.dirt = Math.min(1, e.dirt + moved * 0.0002); }\n199\t    e.lastS = s;\n200\t    e.progress = this.progressOf(e);\n201\t    e.topSpeed = Math.max(e.topSpeed, Math.abs(c.u));\n202\t    const sp = Math.hypot(c.vx, c.vz);\n203\t    // Wrong way\n204\t    const dot = Math.sin(c.yaw) * tr.tx[c.loc.i] + Math.cos(c.yaw) * tr.tz[c.loc.i];\n205\t    e.wrongWay = !e.pit && dot < 0 && sp > 5;\n206\t    // Events\n207\t    if (c.gear !== e.lastGear) { this.emit('shift', e, { up: c.gear > e.lastGear