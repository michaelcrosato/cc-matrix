{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkn69HhyXLrucMnqfjeY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B2fzxQrFWjcuS3BdabFixT","name":"Bash","input":{"command":"cat > src/game/dev/devmode.js <<'EOF'\n// Dev mode: a pad-friendly panel over the running game. Live sliders, tools, overlays. Sliders stay for the session; Reset clears them.\nimport { CAR_IDS, CAR_INFO } from '../data/cars.js';\nimport { EVENT_IDS, EVENTS } from '../data/events.js';\nimport { TEST_IDS, TESTS, LICENCE_ORDER, LICENCES } from '../data/licences.js';\nimport { addCar, carEntry, eventState, newProfile, recordRound, recordTest } from '../sim/career.js';\nimport { defaultEnv, trackPoint } from '../sim/race.js';\nimport { THREE } from '../../pixel-engine.js';\nconst { Vector3 } = THREE;\nexport const SLIDERS = [\n  { id: 'gripScale', name: 'GRIP', def: 1, min: 0.5, max: 1.5, step: 0.05, get: (a) => a.env.gripScale, set: (a, v) => { a.env.gripScale = v; } },\n  { id: 'powerScale', name: 'POWER', def: 1, min: 0.5, max: 2, step: 0.05, get: (a) => a.env.powerScale, set: (a, v) => { a.env.powerScale = v; } },\n  { id: 'brakeScale', name: 'BRAKE STRENGTH', def: 1, min: 0.5, max: 1.5, step: 0.05, get: (a) => a.env.brakeScale, set: (a, v) => { a.env.brakeScale = v; } },\n  { id: 'aeroScale', name: 'DOWNFORCE', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.aeroScale, set: (a, v) => { a.env.aeroScale = v; } },\n  { id: 'wearScale', name: 'TYRE WEAR', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.env.wearScale, set: (a, v) => { a.env.wearScale = v; } },\n  { id: 'fuelScale', name: 'FUEL USE', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.env.fuelScale, set: (a, v) => { a.env.fuelScale = v; } },\n  { id: 'steerRate', name: 'STEERING RATE', def: 3, min: 1, max: 8, step: 0.25, get: (a) => a.env.steerRate, set: (a, v) => { a.env.steerRate = v; } },\n  { id: 'stability', name: 'STABILITY STRENGTH', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.stability, set: (a, v) => { a.env.stability = v; } },\n  { id: 'traction', name: 'TRACTION STRENGTH', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.traction, set: (a, v) => { a.env.traction = v; } },\n  { id: 'aiPace', name: 'AI PACE', def: 0, min: 0, max: 1.05, step: 0.01, get: (a) => a.env.aiPace ?? 0, set: (a, v) => { a.env.aiPace = v < 0.7 ? null : v; }, fmt: (v) => (v < 0.7 ? 'EVENT' : v.toFixed(2)) },\n  { id: 'rubber', name: 'AI RUBBER BAND', def: 0, min: 0, max: 0.03, step: 0.002, get: (a) => a.env.rubber, set: (a, v) => { a.env.rubber = v; }, fmt: (v) => v.toFixed(3) },\n  { id: 'wallLoss', name: 'WALL SPEED LOSS', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.wallLoss, set: (a, v) => { a.env.wallLoss = v; } },\n  { id: 'slip', name: 'SLIPSTREAM', def: 0.65, min: 0.4, max: 1, step: 0.05, get: (a) => a.env.slip, set: (a, v) => { a.env.slip = v; } },\n  { id: 'prize', name: 'PRIZE MONEY', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.prizeMult ?? 1, set: (a, v) => { a.prizeMult = v; } },\n  { id: 'chase', name: 'CHASE DISTANCE', def: 8.5, min: 4, max: 14, step: 0.5, get: (a) => a.devSliders?.chase ?? 8.5, set: (a, v) => { (a.devSliders ??= { fov: 58 }).chase = v; if (a.scene?.chase) a.scene.chase.distance = v; } },\n  { id: 'fov', name: 'CHASE FOV', def: 58, min: 40, max: 90, step: 2, get: (a) => a.devSliders?.fov ?? 58, set: (a, v) => { (a.devSliders ??= { chase: 8.5 }).fov = v; if (a.scene?.chase) a.scene.chase.fovBase = v; }, fmt: (v) => v.toFixed(0) },\n];\nconst PER = 7;\nconst TABS = ['SLIDERS', 'RACE', 'VIEW', 'WEATHER', 'CAREER', 'JUMP'];\nconst SCALES = [0.25, 0.5, 1, 2, 4];\nexport const newDevState = () => ({ overlays: { line: false, load: false, surface: false, circles: false, ai: false, telemetry: false }, freeCam: false, tele: [], savedState: null });\nexport function devDirty(app) { for (const s of SLIDERS) { const v = s.get(app); if (Math.abs(v - s.def) > 1e-6) return true; } return !!app.env.god; }\nexport class DevPanel {\n  constructor(app, scene) { this.id = 'dev'; this.app = app; this.scene = scene; this.tab = 0; this.page = 0; app.dev = app.dev ?? newDevState(); }\n  draw(ui) {\n    const app = this.app, w = Math.min(ui.w - 12, 380), x = Math.round(ui.cx - w / 2), h = ui.h - 22;\n    ui.panel(x, 3, w, h, { color: 'ink', border: 'red', scan: false });\n    ui.text(x + 6, 7, 'DEV MODE', { color: 'red' }); if (devDirty(app)) ui.text(x + w - 6, 7, 'RECORDS ARE OFF', { align: 'right', color: 'orange' });\n    ui.tabs('t', x + 3, 17, w - 6, TABS, this.tab, (i) => { this.tab = i; this.focus = null; this.page = 0; ui.box.ready = false; });\n    const fn = [this.sliders, this.race, this.view, this.weather, this.career, this.jump][this.tab]; fn.call(this, ui, x + 5, 33, w - 10);\n  }\n  btn(ui, id, x, y, w, label, fn, o = {}) { ui.button(id, x, y, w, 15, label, { ...o, confirm: fn }); }\n  sliders(ui, x, y, w) {\n    const app = this.app, pages = Math.ceil(SLIDERS.length / PER), list = SLIDERS.slice(this.page * PER, this.page * PER + PER);\n    list.forEach((s, k) => ui.slider(s.id, x, y + k * 18, w, 15, s.name, s.get(app), s.min, s.max, { step: s.step, set: (v) => { s.set(app, Math.round(v / s.step) * s.step); app.devDirty = devDirty(app); }, reset: () => { s.set(app, s.def); app.devDirty = devDirty(app); }, format: s.fmt ?? ((v) => v.toFixed(2)) }));\n    const by = y + PER * 18 + 2, bw = (w - 6) / 2;\n    this.btn(ui, 'pageNext', x, by, bw, `MORE SLIDERS ${this.page + 1}/${pages}`, () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; });\n    this.btn(ui, 'resetAll', x + bw + 6, by, bw, 'RESET ALL', () => this.resetAll());\n    ui.prompts([['moveX', 'ADJUST'], ['confirm', 'RESET ONE'], ['info', 'RESET ALL'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  onInfo() { if (this.tab === 0) this.resetAll(); }\n  resetAll() { const app = this.app, d = defaultEnv(); Object.assign(app.env, d); app.prizeMult = 1; app.devSliders = null; if (app.scene?.chase) { app.scene.chase.distance = null; app.scene.chase.fovBase = 58; } app.devDirty = false; app.ui.note('ALL SLIDERS AT THEIR DEFAULTS.'); }\n  race(ui, x, y, w) {\n    const app = this.app, s = app.scene, sim = s?.sim, bw = (w - 6) / 2;\n    if (!sim) { ui.lines(x + 2, y + 2, 'THESE TOOLS WORK DURING A DRIVE. OPEN DEV MODE FROM THE PAUSE MENU.', { chars: 50, color: 'mist' }); this.btn(ui, 'quick', x, y + 26, w, 'START A TEST RACE NOW', () => app.startQuick({ track: 'kestrel', carId: 'ginga', laps: 2, field: 6, difficulty: 'normal' })); ui.prompts([['confirm', 'CHOOSE'], ['tabs', 'TAB'], ['back', 'CLOSE']]); return; }\n    const me = s.focusE ?? sim.cars[0], L = sim.tr.length;\n    const f = ui.item('teleport', x, y, w, 15, { onX: (d) => { const k = (me.c.loc.s + d * 80 + L) % L; sim.teleport(me.i, k); s.chase?.snap(); app.mix.sfx('tick'); }, confirm: () => sim.teleport(me.i, 0) }); ui.rect(x, y, w, 15, f ? 'navy' : 'night'); ui.text(x + 6, y + 4, 'TELEPORT ALONG THE TRACK', { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 4, `< ${Math.round(me.c.loc.s)} M >`, { align: 'right', color: 'sand' });\n    const pos = this.finishPos ?? 1;\n    const f2 = ui.item('finish', x, y + 18, w, 15, { onX: (d) => { this.finishPos = Math.max(1, Math.min(sim.cars.length, pos + d)); }, confirm: () => { ui.pop(); ui.pop(); sim.finishNow(me.i, pos); } }); ui.rect(x, y + 18, w, 15, f2 ? 'navy' : 'night'); ui.text(x + 6, y + 22, 'FINISH NOW IN POSITION', { color: f2 ? 'white' : 'mist' }); ui.text(x + w - 6, y + 22, `< ${pos} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'end', x, y + 36, bw, 'END RACE', () => { ui.pop(); ui.pop(); sim.finishNow(me.i, sim.cars.length); });\n    this.btn(ui, 'restart', x + bw + 6, y + 36, bw, 'RESTART', () => app.restartRun(s));\n    this.btn(ui, 'reset', x, y + 54, bw, 'RESET CAR', () => sim.recover(me.i));\n    this.btn(ui, 'god', x + bw + 6, y + 54, bw, `GOD MODE: ${app.env.god ? 'ON' : 'OFF'}`, () => { app.env.god = !app.env.god; app.devDirty = devDirty(app); });\n    const cur = SCALES.indexOf(app.engine.timeScale);\n    const f3 = ui.item('scale', x, y + 72, w, 15, { onX: (d) => { const n = SCALES[Math.max(0, Math.min(SCALES.length - 1, (cur < 0 ? 2 : cur) + d))]; app.engine.timeScale = n; }, confirm: () => { app.engine.timeScale = 1; } }); ui.rect(x, y + 72, w, 15, f3 ? 'navy' : 'night'); ui.text(x + 6, y + 76, 'TIME SCALE', { color: f3 ? 'white' : 'mist' }); ui.text(x + w - 6, y + 76, `< ${app.engine.timeScale} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'frame', x, y + 90, bw, 'STEP ONE FRAME', () => { s.stepFrames = 1; });\n    this.btn(ui, 'saveState', x + bw + 6, y + 90, bw, 'SAVE STATE', () => { app.dev.savedState = sim.saveState(); ui.note('STATE SAVED.'); });\n    this.btn(ui, 'loadState', x, y + 108, bw, 'LOAD STATE', () => { if (app.dev.savedState) { sim.loadState(app.dev.savedState); s.chase?.snap(); ui.note('STATE LOADED.'); } else ui.note('NOTHING SAVED YET.'); });\n    this.btn(ui, 'changeCar', x + bw + 6, y + 108, bw, 'CHANGE CAR', () => { const d = s.data, i = d.cars.findIndex((c) => c.player === 0); if (i < 0) return; const n = CAR_IDS[(CAR_IDS.indexOf(d.cars[i].carId) + 1) % CAR_IDS.length], patch = { ...d, cars: d.cars.map((c, k) => (k === i ? { ...c, carId: n, install: null } : c)) }; app.restartWith(s, patch); });\n    ui.prompts([['confirm', 'DO IT'], ['moveX', 'ADJUST'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  view(ui, x, y, w) {\n    const app = this.app, o = app.dev.overlays, bw = (w - 6) / 2, tog = (id, label, on, fn, i) => this.btn(ui, id, x + (i % 2) * (bw + 6), y + Math.floor(i / 2) * 18, bw, `${label}: ${on ? 'ON' : 'OFF'}`, fn);\n    [['line', 'RACING LINE'], ['load', 'WHEEL LOAD, SLIP'], ['surface', 'SURFACE TINT'], ['circles', 'COLLISION CIRCLES'], ['ai', 'AI TARGETS'], ['telemetry', 'TELEMETRY']].forEach(([k, label], i) => tog(k, label, o[k], () => { o[k] = !o[k]; if (k === 'line' && app.scene) app.scene.lineOn = o[k]; }, i));\n    tog('freeCam', 'FREE CAMERA', app.dev.freeCam, () => { app.dev.freeCam = !app.dev.freeCam; if (app.dev.freeCam) app.dev.driveFreeCam = driveFreeCam; }, 6);\n    tog('panel', 'ENGINE DEBUG PANEL', !!app.engine.debugShown, () => app.engine.showDebug(!app.engine.debugShown), 7);\n    ui.prompts([['confirm', 'TOGGLE'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  weather(ui, x, y, w) {\n    const app = this.app, s = app.scene, d = s?.data, bw = (w - 6) / 2;\n    if (!d) { ui.lines(x + 2, y + 2, 'THE WEATHER CHANGES ONLY ON THE CIRCUIT. IT IS ALWAYS SOMETHING ON THE PENINSULA.', { chars: 50, color: 'mist' }); ui.prompts([['tabs', 'TAB'], ['back', 'CLOSE']]); this.btn(ui, 'attract', x, y + 28, w, 'START ATTRACT MODE NOW', () => app.attract?.start()); return; }\n    this.hour = this.hour ?? d.hour ?? 12;\n    const f = ui.item('hour', x, y, w, 15, { onX: (k) => { this.hour = (this.hour + k + 24) % 24; s.world?.setHourIf(this.hour); }, confirm: () => app.restartWith(s, { ...d, hour: this.hour }) }); ui.rect(x, y, w, 15, f ? 'navy' : 'night'); ui.text(x + 6, y + 4, 'HOUR OF DAY (CONFIRM RESTARTS WITH LAMPS)', { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 4, `< ${this.hour} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'rain', x, y + 18, bw, `RAIN: ${d.rain ? 'ON' : 'OFF'}`, () => app.restartWith(s, { ...d, rain: !d.rain }));\n    const n = d.cars.length;\n    const f2 = ui.item('fieldSize', x + bw + 6, y + 18, bw, 15, { onX: (k) => { this.field = Math.max(1, Math.min(8, (this.field ?? n) + k)); }, confirm: () => { const m = this.field ?? n, me = d.cars.filter((c) => c.player !== null && c.player !== undefined), others = d.cars.filter((c) => c.player === null || c.player === undefined); const pool = others.length ? others : [{ carId: me[0]?.carId ?? 'ginga', name: 'T. HOLLIS', skill: 0.9 }]; const list = []; for (let i = 0; i < m - me.length; i++) list.push({ ...pool[i % pool.length], name: `AI ${i + 1}` }); app.restartWith(s, { ...d, cars: [...list, ...me] }); } }); ui.rect(x + bw + 6, y + 18, bw, 15, f2 ? 'navy' : 'night'); ui.text(x + bw + 12, y + 22, `FIELD < ${this.field ?? n} >`, { color: f2 ? 'white' : 'mist' });\n    this.btn(ui, 'attract', x, y + 36, w, 'START ATTRACT MODE NOW', () => app.attract?.start());\n    ui.prompts([['confirm', 'APPLY'], ['moveX', 'ADJUST'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  career(ui, x, y, w) {\n    const app = this.app, p = app.profile, bw = (w - 6) / 2;\n    this.btn(ui, 'credits', x, y, bw, 'GIVE 100,000 CR', () => { p.credits += 100000; app.save(); ui.note('100,000 CR GIVEN.'); });\n    this.btn(ui, 'cars', x + bw + 6, y, bw, 'UNLOCK ALL CARS', () => { for (const id of CAR_IDS) if (!p.cars.some((c) => c.carId === id)) addCar(p, id, { prize: CAR_INFO[id].where === 'prize' }); if (p.current === null) p.current = p.cars[0].uid; app.save(); ui.note('ALL FOURTEEN IN THE GARAGE.'); });\n    this.btn(ui, 'gold', x, y + 18, bw, 'ALL TESTS AT GOLD', () => { for (const id of TEST_IDS) recordTest(p, id, TESTS[id].medals.gold - 0.01); app.save(); ui.note('EVERY LICENCE HELD, AT GOLD.'); });\n    this.btn(ui, 'winEvent', x + bw + 6, y + 18, bw, 'WIN THE CURRENT EVENT', () => { const id = app.scene?.data?.event ?? EVENT_IDS.find((k) => !p.events[k]?.won) ?? 'gp', e = EVENTS[id]; let last = null; const st = eventState(p, id); for (let i = st.round; i < e.rounds.length; i++) last = recordRound(p, id, ['YOU', 'R. OKADA'], 'YOU'); app.save(); ui.note(`${e.name} WON${last?.prizeCar ? `: ${CAR_INFO[last.prizeCar].short}` : ''}.`); });\n    this.btn(ui, 'resetSave', x, y + 36, w, 'RESET THE SAVE', () => { app.profile = newProfile(); app.save(); if (app.profile && app.toTitle) app.toTitle(); });\n    ui.text(x + 2, y + 56, `CREDITS ${p.credits.toLocaleString('en-US')}`, { color: 'mist' }); ui.text(x + 2, y + 66, `CURRENT CAR ${carEntry(p) ? CAR_INFO[carEntry(p).carId].short : 'NONE'}`, { color: 'mist' });\n    ui.prompts([['confirm', 'DO IT'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n    void LICENCE_ORDER; void LICENCES;\n  }\n  jump(ui, x, y, w) {\n    const app = this.app; const list = [...EVENT_IDS.map((id) => ({ id: `ev-${id}`, label: `EVENT: ${EVENTS[id].name}`, go: () => app.startEventRound(id) })), ...TEST_IDS.map((id) => ({ id: `t-${id}`, label: `TEST ${id}: ${TESTS[id].title}`, go: () => app.startTest(id) })), ...['map', 'dealer', 'tuning', 'service', 'garage', 'museum', 'theatre', 'arcade'].map((id) => ({ id: `m-${id}`, label: `MENU: ${id.toUpperCase()}`, go: () => app.jumpMenu(id) }))];\n    const pages = Math.ceil(list.length / PER); list.slice(this.page * PER, this.page * PER + PER).forEach((it, k) => this.btn(ui, it.id, x, y + k * 18, w, it.label, () => { if (app.profile.cars.length === 0 && !it.id.startsWith('m-')) addCar(app.profile, 'kite'); ui.clear(); it.go(); }, { left: true }));\n    this.btn(ui, 'pageNext', x, y + PER * 18 + 2, w, `MORE ${this.page + 1}/${pages}`, () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; });\n    ui.prompts([['confirm', 'GO'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n}\nconst FV = new Vector3();\nfunction driveFreeCam(ctx, dt, cam) { // WASD or the left stick moves, the right stick or a right drag looks\n  const input = ctx.input, a = FV; this._y = this._y ?? 0;\n  let mx = 0, mz = 0, my = 0, lx = 0, ly = 0;\n  if (input.isDown('KeyW') || input.isDown('ArrowUp')) mz += 1; if (input.isDown('KeyS') || input.isDown('ArrowDown')) mz -= 1; if (input.isDown('KeyA') || input.isDown('ArrowLeft')) mx -= 1; if (input.isDown('KeyD') || input.isDown('ArrowRight')) mx += 1; if (input.isDown('KeyE')) my += 1; if (input.isDown('KeyQ')) my -= 1;\n  const app = ctx.engine.game?.app; for (const p of app?.actions.pads ?? []) { mx += p.axes[0]; mz -= p.axes[1]; lx += p.axes[2]; ly += p.axes[3]; }\n  if (input.isDown('MouseRight')) { lx += (input.mouseDelta.x ?? 0) * 0.3; ly += (input.mouseDelta.y ?? 0) * 0.3; }\n  cam.rotation.order = 'YXZ'; cam.rotation.y -= lx * dt * 2; cam.rotation.x = Math.max(-1.4, Math.min(1.4, cam.rotation.x - ly * dt * 2));\n  a.set(mx, my, -mz).multiplyScalar(dt * 24).applyEuler(cam.rotation); cam.position.add(a);\n}\nconst P = new Vector3();\n// Overlays, drawn over the HUD.\nexport function drawOverlays(ui, app, scene) {\n  const dev = app.dev; if (!dev) return; const o = dev.overlays, sim = scene.sim, cam = scene.cam, me = scene.focusE; if (!sim || !me) return;\n  const project = (x, y, z) => { P.set(x, y, z).project(cam); return P.z < 1 ? [(P.x + 1) * 0.5 * ui.w, (1 - P.y) * 0.5 * ui.h] : null; };\n  const c = me.c;\n  if (o.load) { const bx = ui.w - 96, by = 60; ui.panel(bx - 3, by - 3, 96, 52, { color: 'ink', border: false, scan: true }); for (let i = 0; i < 4; i++) { const load = c.fz[i] / (c.p.mass * 9.81 * 0.5), slip = Math.min(1.6, c.use[i]) / 1.6; ui.text(bx, by + i * 12, ['FL', 'FR', 'RL', 'RR'][i], { color: 'mist' }); ui.bar(bx + 16, by + i * 12, 34, 4, load, 'sky', 'night'); ui.bar(bx + 54, by + i * 12, 34, 4, slip, slip > 0.8 ? 'red' : 'lime', 'night'); } }\n  if (o.surface) { const col = { asphalt: 'slate', kerb: 'red', grass: 'green', gravel: 'orange', dirt: 'orange', apron: 'mist' }[c.surface] ?? 'white'; ui.rect(0, 0, ui.w, 2, col); ui.rect(0, ui.h - 2, ui.w, 2, col); ui.text(ui.cx, 8, `SURFACE: ${c.surface.toUpperCase()}`, { align: 'center', color: col }); }\n  if (o.circles) for (const e of sim.cars) { for (const off of [-1.35, 0, 1.35]) { const cx = e.c.x + Math.sin(e.c.yaw) * off, cz = e.c.z + Math.cos(e.c.yaw) * off; for (let a = 0; a < 12; a++) { const t = (a / 12) * 6.283, q = project(cx + Math.sin(t) * 0.875, e.c.y + 0.3, cz + Math.cos(t) * 0.875); if (q) ui.rect(q[0], q[1], 1, 1, e === me ? 'lime' : 'red'); } } }\n  if (o.ai) for (const e of sim.cars) { if (e.player !== null && !e.autoDrive) continue; const u = Math.hypot(e.c.vx, e.c.vz), idx = (e.c.loc.i + Math.round(Math.max(7, u * 0.62) / sim.tr.ds)) % sim.tr.N, tr = sim.tr, rx = -tr.tz[idx], rz = tr.tx[idx], lane = e.c.laneNow ?? 0, q = project(sim.line.px[idx] + rx * lane, tr.y[idx] + 0.3, sim.line.pz[idx] + rz * lane); if (q) { ui.rect(q[0] - 1, q[1] - 1, 3, 3, 'cyan'); } const n = project(e.c.x, e.c.y + 1.7, e.c.z); if (n) ui.text(n[0], n[1] - 8, `${(e.speeds[e.c.loc.i] * 3.6).toFixed(0)}`, { align: 'center', color: 'cyan' }); }\n  if (o.line) { const i = c.loc.i; ui.text(ui.cx, 16, `LINE WANTS ${(me.speeds[i] * 3.6).toFixed(0)} KM/H`, { align: 'center', color: 'lime' }); }\n  if (o.telemetry) {\n    const T = dev.tele; T.push([Math.abs(c.u) / 90, me.inp?.throttle ?? 0, me.inp?.brake ?? 0, 0.5 + c.ax / 40, 0.5 + c.ay / 40]); if (T.length > 200) T.shift();\n    const x0 = ui.cx - 100, y0 = ui.h - 52, H = 26; ui.panel(x0 - 2, y0 - 2, 204, H + 4, { color: 'ink', border: false }); const cols = ['white', 'lime', 'red', 'sky', 'sand']; T.forEach((v, k) => { for (let n = 0; n < 5; n++) ui.rect(x0 + k, y0 + H - Math.round(Math.max(0, Math.min(1, v[n])) * H), 1, 1, cols[n]); });\n    ui.text(x0, y0 - 10, 'SPD THR BRK AX AY', { color: 'mist' });\n  }\n  void trackPoint;\n}\nEOF\ncat > src/game/attract/director.js <<'EOF'\n// Attract mode: after 10 s of no input on the title or the Map, the game plays itself. Any input returns to where the player was.\nimport { RaceScene } from '../scenes/race.js';\nimport { MenuScene } from '../scenes/menu.js';\nimport { THREE } from '../../pixel-engine.js';\nimport { TITLE } from '../data/meta.js';\nimport { TESTS } from '../data/licences.js';\nimport { testSetup } from '../sim/licence.js';\nimport { defaultEnv, trackPoint } from '../sim/race.js';\nimport { CAR_INFO } from '../data/cars.js';\nimport { EVENTS } from '../data/events.js';\nimport { fullInstall } from '../sim/tuning.js';\nimport { DynoScreen } from '../ui/screens/tuning.js';\nimport { PodiumScreen, PrizeScreen } from '../ui/screens/cinema.js';\nimport { medalIcon } from '../ui/screens/common.js';\nvoid THREE;\nconst CLIPS = [\n  { id: 'title', seconds: 3, kind: 'menu' },\n  { id: 'showroom', seconds: 10, kind: 'menu' },\n  { id: 'tuning', seconds: 8, kind: 'menu' },\n  { id: 'licence', seconds: 10, kind: 'race' },\n  { id: 'kestrel', seconds: 20, kind: 'race' },\n  { id: 'redclay', seconds: 12, kind: 'race' },\n  { id: 'harbour', seconds: 20, kind: 'race' },\n  { id: 'saltline', seconds: 10, kind: 'race' },\n  { id: 'podium', seconds: 8, kind: 'menu' },\n  { id: 'credits', seconds: 4, kind: 'menu' },\n];\nconst AI_FIELD = (ids, base = 0.95, extra = {}) => ids.map((id, i) => ({ carId: id, name: `DEMO ${i + 1}`, skill: base + i * 0.006, ...extra }));\nexport class Attract {\n  constructor(app) { this.app = app; this.active = false; this.i = 0; this.t = 0; this.returnTo = null; this.starting = false; }\n  // Called every frame by the App.\n  tick(ctx, dt) {\n    const app = this.app, a = app.actions;\n    if (app.session) return;\n    if (!this.active) {\n      if (app.idleWatch && a.idle > 10 && !app.switching && !this.starting) this.start();\n      return;\n    }\n    if (this.grace > 0) this.grace -= dt;\n    else if (a.anyInput) { this.stop(); return; }\n    if (app.switching) return;\n    this.t += dt;\n    this.clip?.update?.(dt);\n    if (this.t >= CLIPS[this.i].seconds) { this.i = (this.i + 1) % CLIPS.length; this.play(); }\n  }\n  start() {\n    const app = this.app; if (this.active || app.session) return;\n    this.returnTo = app.ui.stack.some((s) => s.id === 'map') ? 'map' : 'title';\n    this.active = true; this.i = 0; this.grace = 0.5; app.idleWatch = false; app.ui.subtitle = null; app.ui.clear();\n    this.savedEnv = { ...app.env };\n    this.play();\n  }\n  stop() {\n    const app = this.app; this.active = false; this.clip = null; Object.assign(app.env, this.savedEnv ?? {}); app.actions.idle = 0; app.ui.clear();\n    app.mix.stopVoice();\n    const back = this.returnTo === 'map' ? (ui) => ui.push(new app.Screens.MapScreen(app)) : null;\n    app.go(() => new MenuScene(app, { start: back }), 'fade');\n  }\n  menuClip(setupFn) { return this.app.go(() => new MenuScene(this.app, { start: (ui, scene) => { const s = new AttractScreen(this.app, this); ui.push(s); setupFn?.(ui, scene, s); } }), 'blinds'); }\n  raceClip(setup, opts = {}) { const app = this.app; app.ui.clear(); return app.go(() => new RaceScene(app, { ...setup, env: defaultEnv() }, { attract: true, ...opts, onFrame: (scene, ctx, dt) => { this.overlay(ctx, dt); opts.onFrame?.(scene, ctx, dt); } }), 'blinds'); }\n  overlay(ctx) { const ui = this.app.ui; ui.hud = ctx.hud; const w = ctx.hud.width; ui.w = w; ui.h = ctx.hud.height; ui.cx = w / 2; ui.panel(w / 2 - 22, 3, 44, 11, { color: 'ink', border: 'red' }); ui.text(w / 2, 5, 'DEMO', { align: 'center', color: Math.floor(ui.time * 2) % 2 ? 'red' : 'white' }); if (this.caption) ui.text(w / 2, ctx.hud.height - 20, this.caption, { align: 'center', color: 'sand' }); }\n  play() {\n    const app = this.app, clip = CLIPS[this.i]; this.t = 0; this.clip = null; this.caption = null;\n    this.seen = this.seen ?? new Set(); this.seen.add(clip.id);\n    const P = this[`play_${clip.id}`]; P.call(this);\n    void app;\n  }\n  play_title() { this.menuClip((ui, scene, s) => { scene.opts.title = true; scene.stage('map', { hour: 18.4 }); app_music(this.app, 'lounge'); s.big = TITLE; }); }\n  play_showroom() {\n    const cars = ['kite', 'libeccio', 'heck'];\n    this.menuClip((ui, scene, s) => { app_music(this.app, 'catalogue'); let k = -1, t = 99; s.onTick = (dt) => { t += dt; if (t > 3.3) { t = 0; k = (k + 1) % cars.length; scene.stage('showroom', { showroom: k + 1, car: { carId: cars[k], install: null }, person: 'fenn', personClip: 'DealerPresent', personAt: [-4.6, 0, 1.8], personYaw: 1.1 }); s.lines = CAR_INFO[cars[k]].text; ui.say('fenn', CAR_INFO[cars[k]].fenn, 3); } }; });\n  }\n  play_tuning() {\n    const app = this.app, car = { carId: 'ginga', install: fullInstall(['exhaust', 'stage2']), km: 0, dirt: 0, uid: -1 };\n    this.menuClip((ui, scene, s) => { app_music(app, 'socket'); scene.stage('bay', { car: { carId: 'ginga', install: car.install, y: 0.08 }, person: 'benno', personClip: 'MechanicWipe', personAt: [4.6, 0, 0.8], personYaw: -1.2, radius: 7.8, height: 2.3 }); const before = fullInstall(['exhaust']); const dy = new DynoScreen(app, car, before); ui.push(dy); let t = 0, done = false; s.owner = this; dy.autoClose = true; this.clip = { update: (dt) => { t += dt; if (t > 5.8 && !done) { done = true; ui.pop(); const inst = fullInstall(['exhaust', 'stage2', 'aeroWing']); scene.showCar('ginga', inst, { y: 0.08 }).settle = 0.16; s.lines = ['A BIG WING: YOU NOW HAVE MORE DOWNFORCE.', 'YOU ALSO HAVE MORE DRAG. THERE IS NO THIRD THING.']; app.mix.sfx('register'); } } }; });\n  }\n  play_licence() {\n    const test = TESTS['B-1'], app = this.app; let medal = 0;\n    this.raceClip({ ...testSetup(test, 0, {}), record: false, seed: 3 }, { test, demo: true, hideHud: false, onFrame: (scene, ctx, dt) => { if (scene.judge?.status === 'pass' && !medal) { medal = 1; app.mix.sfx('medal'); } if (medal) { medal += dt; const ui = app.ui; ui.panel(ui.cx - 70, 80, 140, 40, { color: 'ink', border: 'sand' }); medalIcon(ui, ui.cx - 4, 84, 'gold'); ui.text(ui.cx, 98, 'GOLD', { align: 'center', scale: 2, color: 'sand' }); } } });\n    this.caption = 'LICENCE B-1: THRESHOLD';\n  }\n  play_kestrel() { this.caption = 'KESTREL PARK'; this.raceClip({ kind: 'attract', track: 'kestrel', laps: 3, hour: 15, start: 'rolling', wear: 0, fuel: 0, record: false, seed: 5, cars: AI_FIELD(['ginga', 'kite', 'brandt32', 'moth', 'ryu', 'heck'], 0.92) }, { onFrame: (scene) => { if (this.t > 9 && !scene.tvMode) scene.startTv(); if (scene.sim.phase === 'green' && this.t > 3 && !this.cut1) { this.cut1 = true; } } }); this.cut1 = false; }\n  play_redclay() {\n    this.caption = 'RED CLAY STAGE';\n    this.raceClip({ kind: 'attract', track: 'redclay', laps: 3, hour: 17, start: 'flying', startS: 240, startSpeed: 90, contact: false, wear: 0, fuel: 0, record: false, seed: 6, cars: [{ carId: 'ryuRally', name: 'DEMO', skill: 1 }] }, { onFrame: (scene) => { const sim = scene.sim; if (this.t > 6.5 && !this.hair) { this.hair = true; const s = sim.tr.cornerS[4] - 70; sim.teleport(0, s); const c = sim.cars[0].c, pt = trackPoint(sim.tr, s, 0); c.vx = Math.sin(pt.yaw) * 24; c.vz = Math.cos(pt.yaw) * 24; scene.chase.snap(); this.caption = 'A HANDBRAKE HAIRPIN'; const orig = sim.aiInput.bind(sim); sim.aiInput = (e, m) => { const inp = orig(e, m), d = sim.tr.cornerS[4] - e.c.loc.s; inp.handbrake = d > -6 && d < 14 && Math.abs(e.c.u) > 8; return inp; }; } } });\n    this.hair = false;\n  }\n  play_harbour() {\n    this.caption = 'HARBOUR LIGHTS, NIGHT'; this.pitted = false;\n    this.raceClip({ kind: 'attract', track: 'harbour', laps: 10, hour: 21, start: 'flying', startS: 400, startSpeed: 90, wear: 0, fuel: 1, record: false, seed: 7, cars: AI_FIELD(['libeccio', 'heck', 'brandt32', 'works'], 0.97) }, { onFrame: (scene) => { const sim = scene.sim, e = sim.cars[sim.cars.length - 1], tr = sim.tr; if (this.t > 9.5 && !this.pitted) { this.pitted = true; this.caption = 'THE TEN LAP RACE: ONE STOP NEEDED'; const s = tr.pit.in - 90, pt = trackPoint(tr, s, 0); sim.teleport(e.i, s); e.c.vx = Math.sin(pt.yaw) * 25; e.c.vz = Math.cos(pt.yaw) * 25; for (let i = 0; i < 4; i++) e.c.wear[i] = 0.25; e.c.fuel = 0.3; e.wantPit = true; scene.chase.snap(); } } });\n  }\n  play_saltline() {\n    this.caption = 'SALTLINE SPEEDBOWL';\n    this.raceClip({ kind: 'attract', track: 'saltline', laps: 5, hour: 18.5, start: 'flying', startS: 320, startSpeed: 290, wear: 0, fuel: 0, record: false, seed: 8, contact: false, cars: [{ carId: 'corsa', name: 'DEMO 1', skill: 1.04 }, { carId: 'type9', name: 'DEMO 2', skill: 1.02 }] }, { beforeStep: (sim) => { sim.env.slip = 0.5; } });\n  }\n  play_podium() {\n    const app = this.app;\n    this.menuClip((ui) => { ui.push(new PodiumScreen(app, { eventId: 'gp', carId: 'corsa', install: null, short: true, auto: true, next: () => { ui.pop(); ui.push(new PrizeScreen(app, { carId: 'type9', short: true, auto: true, next: () => {} })); } })); });\n    this.caption = null;\n  }\n  play_credits() { this.menuClip((ui, scene, s) => { scene.opts.title = true; scene.stage('map', { hour: 21 }); app_music(this.app, 'longDrive'); s.big = TITLE; s.lines = ['PRESS ANY BUTTON']; }); }\n}\nconst app_music = (app, id) => app.mix.music(id);\nclass AttractScreen {\n  constructor(app, owner) { this.id = 'attract'; this.app = app; this.owner = owner; this.noBack = true; this.lines = null; this.big = null; this.inputOff = true; }\n  draw(ui, dt) {\n    this.onTick?.(dt);\n    if (this.big) { const [a, b] = this.big.split(' '); ui.text(ui.cx, 60, a, { align: 'center', scale: 3, color: 'white', shadow: 'plum' }); ui.text(ui.cx, 84, b, { align: 'center', scale: 4, color: 'sand', shadow: 'plum' }); }\n    if (this.lines) { const H = this.lines.length * 10 + 6, y = ui.h - 22 - H; ui.panel(10, y, Math.min(ui.w - 20, 340), H, { color: 'ink', border: 'slate' }); this.lines.forEach((l, k) => ui.text(16, y + 4 + k * 10, l)); }\n    ui.panel(ui.cx - 22, 3, 44, 11, { color: 'ink', border: 'red' }); ui.text(ui.cx, 5, 'DEMO', { align: 'center', color: Math.floor(ui.time * 2) % 2 ? 'red' : 'white' });\n  }\n}\nvoid EVENTS;\nEOF\ncat > src/game/net/hub.js <<'EOF'\n// A hub session: ghost mode. Every copy runs its own physics; the others are stippled ghosts in seat colours with name tags.\nimport { Engine } from '../../pixel-engine.js';\nimport { RaceScene } from '../scenes/race.js';\nimport { hubSetup } from '../sim/setups.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { TITLE, SEAT_COLOURS, SEAT_PAINT } from '../data/meta.js';\nimport { CAR_INFO } from '../data/cars.js';\nimport { CarView } from '../render/carview.js';\nimport { SettingsScreen } from '../ui/screens/settings.js';\nimport { HandbookScreen } from '../ui/screens/handbook.js';\nimport { drawGlyph, specFor } from '../ui/glyphs.js';\nimport { miniMap } from '../ui/screens/common.js';\nimport { safeName } from '../ui/ui.js';\nimport { BTN } from '../input/pad.js';\nimport { engineOptionsFor } from './couch.js';\nconst BUFFER = 150;\nclass Ghosts {\n  constructor(scene, info) { this.scene = scene; this.info = info; this.list = new Map(); }\n  receive(data, from, now) {\n    if (!data || data.t !== 'g') { if (data?.t === 'done') { const g = this.list.get(from); if (g) g.done = data.time; } return; }\n    let g = this.list.get(from);\n    if (!g) { const p = this.info.players.find((x) => x.id === from), scene = this.scene, carId = scene.sim.cars[0].carId, seat = p ? this.info.players.indexOf(p) : 0, view = new CarView(carId, { ghost: SEAT_PAINT[seat % 4] }); scene.ctx.scene.add(view.object); g = { view, snaps: [], name: safeName(p?.name, `P${seat + 1}`), seat, x: 0, y: 0, z: 0, s: 0, lap: 0 }; this.list.set(from, g); }\n    g.snaps.push({ at: now, x: data.x, y: data.y, z: data.z, yaw: data.yaw, v: data.v, s: data.s, lap: data.lap, steer: data.steer, br: data.br }); if (g.snaps.length > 24) g.snaps.shift();\n  }\n  remove(id) { const g = this.list.get(id); if (g) { g.view.dispose(); this.list.delete(id); } }\n  update(dt, now) {\n    for (const g of this.list.values()) {\n      const t = now - BUFFER, S = g.snaps; let a = S[0], b = S[S.length - 1]; for (let i = 0; i + 1 < S.length; i++) if (S[i].at <= t && S[i + 1].at >= t) { a = S[i]; b = S[i + 1]; break; }\n      if (!a) continue; const f = b.at > a.at ? Math.max(0, Math.min(1, (t - a.at) / (b.at - a.at))) : 0; let dy = b.yaw - a.yaw; while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI;\n      g.x = a.x + (b.x - a.x) * f; g.y = a.y + (b.y - a.y) * f; g.z = a.z + (b.z - a.z) * f; g.yaw = a.yaw + dy * f; g.s = b.s; g.lap = b.lap; g.view.update(dt, g.x, g.y, g.z, g.yaw, 0, 0, 0, 0, a.steer ?? 0, a.v ?? 0);\n    }\n  }\n  tags(ui, cam) { const P = this.scene.tagV ??= new (this.scene.cam.position.constructor)(); for (const g of this.list.values()) { P.set(g.x, g.y + 1.9, g.z).project(cam); if (P.z < 1 && P.x > -1 && P.x < 1 && P.y > -1 && P.y < 1) ui.text((P.x + 1) * 0.5 * ui.w, (1 - P.y) * 0.5 * ui.h, g.name, { align: 'center', color: SEAT_COLOURS[g.seat % 4] }); } }\n}\nclass HubMenu {\n  constructor(app, go) { this.id = 'hubMenu'; this.app = app; this.go = go; }\n  draw(ui) { const a = this.app, list = [['resume', 'BACK TO THE RACE', () => ui.pop()], ['settings', 'SETTINGS', () => ui.push(new SettingsScreen(a, { inRace: true, limited: true }))], ['handbook', 'HANDBOOK', () => ui.push(new HandbookScreen(a))]], w = 140, x = ui.cx - w / 2, y = 80; ui.panel(x - 8, y - 22, w + 16, 86, { color: 'ink', border: 'slate' }); ui.text(ui.cx, y - 16, 'THE RACE GOES ON', { align: 'center', color: 'sand' }); list.forEach(([id, l, fn], k) => ui.button(id, x, y + k * 18, w, 15, l, { confirm: fn })); ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]); }\n}\nexport async function startSession(app, info, container) {\n  const hub = window.AIHub, rng = hub.rng('round'), setup = hubSetup(rng, info.seed), me = info.players.findIndex((p) => p.id === info.me), player = setup.cars[0];\n  player.paint = SEAT_PAINT[Math.max(0, me) % 4];\n  let done = false, last = 0, walls = 0, card = { left: null, ready: [], asking: 0, asked: false }, started = false, ended = false, cardAnswered = null;\n  const touchOnly = !!app.touchGate;\n  const state = { get card() { return card; }, get started() { return started; } };\n  const tl = () => hub.time();\n  const opts = {\n    run: { type: 'hub' }, hideHud: false,\n    beforeStep: (sim, inputs) => { if (!started || tl() < 0 || ended) { for (const k in inputs) inputs[k] = { steer: 0, throttle: 0, brake: 0 }; } if (ended) inputs[0] = { steer: 0, throttle: 0, brake: 1 }; },\n    afterStep: (sim) => {\n      const e = sim.cars[0], t = tl();\n      if (started && sim.phase === 'grid' && t >= 0) sim.go();\n      if (sim.phase === 'grid' && started) { const lit = Math.max(0, Math.min(3, Math.floor((t + 3000) / 1000) + 1)); if (lit !== sim.lights) { sim.lights = lit; sim.events.push({ type: 'flag', kind: 'lights', n: lit }); } }\n      if (!done && e.finished && e.finishTime !== null) { done = true; const stats = { 'Best lap': e.bestLap ? +e.bestLap.toFixed(2) : 0, 'Top km/h': Math.round(e.topSpeed * 3.6), Walls: e.walls }; hub.result({ time: Math.round(tl()), stats, awards: e.walls === 0 ? [{ title: 'Clean', detail: 'No wall was touched.' }] : [] }); hub.send({ t: 'done', time: Math.round(tl()) }); }\n      walls = e.walls;\n    },\n    onFrame: (scene, ctx, dt) => {\n      const a = app.actions, sim = scene.sim, e = sim.cars[0], now = performance.now();\n      if (!scene.ghosts) { scene.ctx = ctx; scene.ghosts = new Ghosts(scene, info); for (const m of pending) scene.ghosts.receive(m[0], m[1], now); pending.length = 0; }\n      scene.ghosts.update(dt, now); scene.ghosts.tags(app.ui, scene.cam);\n      // While racing, at 10 Hz.\n      if (started && tl() >= 0 && !ended && now - last > 100) {\n        last = now; const c = e.c, R = (v, k = 100) => Math.round(v * k) / k, metres = Math.max(0, e.progress);\n        hub.send({ t: 'g', a: sim.tr.id, x: R(c.x), y: R(c.y), z: R(c.z), yaw: R(c.yaw, 1000), v: R(c.u), s: R(c.loc.s, 10), lap: e.lap, steer: R(c.delta, 100), br: (e.inp?.brake ?? 0) > 0.05 ? 1 : 0 }, { reliable: false });\n        const riders = [...scene.ghosts.list.values()], pos = 1 + riders.filter((g) => (g.lap - 1) * sim.tr.length + g.s > e.progress).length;\n        hub.progress({ score: Math.floor(metres), label: `LAP ${Math.max(1, Math.min(e.lap, sim.laps))}/${sim.laps} P${pos}` });\n      }\n      // The card: the cars lined up, each seat's colour, the map, how to win, the controls, the countdown.\n      if (!started) drawCard(app, scene, ctx, card, info, setup);\n      // Enter and the pad's Cross answer Ready; Triangle or M asks for more time.\n      if (!started) for (const pad of a.pads) { const pb = pad.prevHub ?? (scene.padPrev ??= {})[pad.i] ?? []; const P = (b) => pad.buttons[b] > 0.5 && !(pb[b] > 0.5); if (P(BTN.cross)) answer('ready'); if (P(BTN.triangle)) answer('more'); (scene.padPrev ??= {})[pad.i] = pad.buttons; }\n      if (!started && a.clicked) { const ui = app.ui; if (ui.inRect(cardRects.ready)) answer('ready'); else if (ui.inRect(cardRects.more)) answer('more'); }\n      // Options or Esc opens settings over the running race. It never pauses, and it offers no quit.\n      if (started && a.pressed('pause') && !a.create && !app.ui.top) app.ui.push(new HubMenu(app));\n      if (touchOnly && app.touchGate) { const ui = app.ui; ui.panel(ui.cx - 110, 90, 220, 26, { color: 'ink', border: 'red' }); ui.text(ui.cx, 99, 'CONTROLLER OR KEYBOARD REQUIRED', { align: 'center', color: 'sand' }); }\n      void walls; void state;\n    },\n  };\n  const pending = [], cardRects = { ready: { x: 0, y: 0, w: 0, h: 0 }, more: { x: 0, y: 0, w: 0, h: 0 } };\n  const answer = (w) => { if (cardAnswered === w && w === 'ready') return; cardAnswered = w; hub.answer(w); app.mix.sfx('confirm'); };\n  app.cardRects = cardRects;\n  const scene = new RaceScene(app, setup, opts);\n  const engine = await Engine.start(scene, { ...engineOptionsFor(container), settings: { button: false }, seed: info.seed });\n  app.bind(engine);\n  engine.audio.setVolume('music', 0.1);\n  hub.on('card', (c) => { card = c; });\n  hub.on('start', () => { started = true; cardAnswered = 'started'; });\n  hub.on('message', (data, from) => { const now = performance.now(); if (scene.ghosts) scene.ghosts.receive(data, from, now); else pending.push([data, from]); });\n  hub.on('leave', ({ id }) => scene.ghosts?.remove(id));\n  hub.on('time-up', () => { if (!done) { done = true; const e = scene.sim.cars[0]; hub.result({ score: Math.floor(Math.max(0, e.progress)), stats: { 'Best lap': e.bestLap ? +e.bestLap.toFixed(2) : 0, 'Top km/h': Math.round(e.topSpeed * 3.6), Walls: e.walls } }); } });\n  hub.on('end', () => { ended = true; app.mix.stopAll(); app.inputDead = true; });\n  window.addEventListener('keydown', (e) => { if (hub.time() !== -Infinity) return; if (e.code === 'Enter') answer('ready'); if (e.code === 'KeyM') answer('more'); });\n  hub.ready();\n  void TRACKS; void CAR_INFO; void TITLE;\n  return engine;\n}\nfunction drawCard(app, scene, ctx, card, info, setup) {\n  const ui = app.ui, w = ui.w, h = ui.h, hud = ctx.hud, sim = scene.sim, x = Math.round(ui.cx - 150), y = 18, dev = app.actions.lastDevice, xbox = app.options.glyphs === 'xbox';\n  ui.panel(x, y, 300, 196, { color: 'ink', border: 'sand' });\n  const [a, b] = TITLE.split(' '); ui.text(ui.cx, y + 6, `${a} ${b}`, { align: 'center', scale: 2, color: 'sand' });\n  ui.text(ui.cx, y + 26, `${TRACKS[setup.track].name.toUpperCase()}, ${setup.laps} LAPS, ${CAR_INFO[setup.cars[0].carId].short}`, { align: 'center' });\n  miniMap(ui, x + 8, y + 40, setup.track, 64, 'mist');\n  info.players.forEach((p, k) => { const yy = y + 42 + k * 12, ready = card.ready?.includes(p.id); ui.rect(x + 80, yy, 8, 8, SEAT_COLOURS[k % 4]); ui.text(x + 92, yy + 1, safeName(p.name, `P${k + 1}`).slice(0, 18), { color: 'white' }); ui.text(x + 292, yy + 1, ready ? 'READY' : '...', { align: 'right', color: ready ? 'lime' : 'slate' }); });\n  ui.text(x + 8, y + 112, 'LOWEST TIME WINS: SAME CAR, SAME CIRCUIT.', { color: 'sand' });\n  let gx = x + 8; for (const [act, label] of [['steer', 'STEER'], ['throttle', 'GO'], ['brake', 'BRAKE']]) { const spec = specFor(act, dev), gw = drawGlyph(hud, gx, y + 124, spec, xbox); ui.text(gx + gw + 3, y + 126, label, { color: 'mist' }); gx += gw + 3 + hud.measure(label).width + 10; }\n  const left = card.left; ui.text(ui.cx, y + 144, card.starting ? 'STARTING' : card.paused ? 'HOLDING: MORE TIME ASKED' : left !== null && left !== undefined ? `${Math.ceil(left / 1000)} S` : '', { align: 'center', scale: 1, color: 'white' });\n  const R = app.cardRects, bw = 110; R.ready = { x: ui.cx - bw - 6, y: y + 158, w: bw, h: 26 }; R.more = { x: ui.cx + 6, y: y + 158, w: bw, h: 26 };\n  ui.button('hubReady', R.ready.x, R.ready.y, bw, 26, 'READY', {}); ui.button('hubMore', R.more.x, R.more.y, bw, 26, card.asked ? 'TAKE IT BACK' : 'MORE TIME', {});\n  drawGlyph(hud, R.ready.x + 4, R.ready.y + 7, specFor('confirm', dev === 'mouse' ? 'key' : dev), xbox); drawGlyph(hud, R.more.x + 4, R.more.y + 7, specFor('more', dev === 'mouse' ? 'key' : dev), xbox);\n  void w; void h; void sim;\n}\nEOF\ncat > src/main.js <<'EOF'\n// Boots the game: a hub session if the hub opened the page, otherwise the game on its own.\n// Drive with a pad (stick, R2, L2), or WASD and arrows. The in-game Handbook lists every control.\nimport { Engine, withUrlOptions } from './pixel-engine.js';\nimport { App } from './game/app.js';\nimport { installFlows } from './game/flows.js';\nimport { MenuScene } from './game/scenes/menu.js';\nimport { RaceScene } from './game/scenes/race.js';\nimport { ReplayScene } from './game/scenes/replay.js';\nimport { Attract } from './game/attract/director.js';\nimport { MapScreen } from './game/ui/screens/map.js';\nimport { TITLE } from './game/data/meta.js';\nimport { quickSetup } from './game/sim/setups.js';\nimport { startSession } from './game/net/hub.js';\nimport { DevPanel, drawOverlays } from './game/dev/devmode.js';\nconst param = (k) => (typeof location !== 'undefined' ? new URLSearchParams(location.search).get(k) : null);\nexport const engineOptions = (container, seed = 1) => ({ container, camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false }, touch: false, seed });\nexport function makeApp(o = {}) {\n  const app = new App(o); app.Screens = { MapScreen }; installFlows(app); app.attract = new Attract(app);\n  app.jumpMenu = (id) => app.toMenu((ui) => { ui.push(new MapScreen(app)); if (id !== 'map') ui.top.open(id, ui); });\n  app.restartWith = (scene, setup) => { app.ui.clear(); const run = scene.run, opts = { run, test: scene.test, demo: scene.opts.demo, ghostData: scene.opts.ghostData }; return app.go(() => new RaceScene(app, { ...setup, seed: (setup.seed ?? 1) + 1 }, opts)); };\n  app.drawOverlays = (ui, scene) => drawOverlays(ui, app, scene);\n  return app;\n}\n/** A fresh game: `node src/check.mjs --headless src/main.js` plays one in Node. */\nexport function createGame() { return new MenuScene(makeApp({ headless: true })); }\nfunction touchOnly() { try { return !matchMedia('(any-pointer: fine)').matches && matchMedia('(pointer: coarse)').matches && !(navigator.getGamepads && [...navigator.getGamepads()].some(Boolean)); } catch { return false; } }\nfunction failMessage(msg) { const d = document.createElement('div'); d.style.cssText = 'position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#f4f4f4;background:#1a1c2c;font:bold 22px monospace;text-align:center;padding:40px'; d.textContent = `${TITLE} needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox 141 on Windows. (${msg})`; document.body.appendChild(d); }\nasync function boot() {\n  const container = document.getElementById('p1') ?? document.getElementById('app'), hub = window.AIHub;\n  // In a session the client answers first. connect() comes before anything else.\n  if (hub && hub.active) {\n    const info = await hub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n    if (info) {\n      const app = makeApp({ session: true }); window.__APP__ = app;\n      if (touchOnly()) { app.touchGate = true; window.addEventListener('keydown', () => { app.touchGate = false; }); }\n      try { await startSession(app, info, container); } catch (e) { hub.fail(String(e?.message ?? e)); failMessage(String(e?.message ?? e)); }\n      return;\n    }\n  }\n  const app = makeApp(); window.__APP__ = app;\n  const seed = +(param('seed') ?? 1), scene = param('scene');\n  if (touchOnly()) { app.touchGate = true; const lift = () => { app.touchGate = false; removeEventListener('keydown', lift); }; addEventListener('keydown', lift); addEventListener('gamepadconnected', lift); }\n  let game;\n  if (scene === 'race') { const setup = quickSetup({ track: param('track') ?? 'kestrel', carId: param('car') ?? 'ginga', laps: +(param('laps') ?? 2), field: +(param('ai') ?? 5) + 1, hour: param('hour') ? +param('hour') : undefined, rain: param('rain') === '1', assists: app.options.assists, pace: param('pace') ? +param('pace') : null, seed }); app.runAgain = () => app.startQuick({ track: setup.track, carId: param('car') ?? 'ginga', laps: setup.laps, field: setup.cars.length }); game = new RaceScene(app, setup, { run: { type: 'quick' } }); }\n  else game = new MenuScene(app, param('scene') === 'map' ? { start: (ui) => ui.push(new MapScreen(app)) } : {});\n  let engine;\n  try { engine = await Engine.start(game, withUrlOptions(engineOptions(container, seed))); }\n  catch (e) { failMessage(String(e?.message ?? e)); return; }\n  app.bind(engine);\n  if (scene === 'licence') app.startTest(param('test') ?? 'C-1');\n  if (scene === 'replay') { const s = new RaceScene(app, quickSetup({ track: param('track') ?? 'kestrel', carId: param('car') ?? 'ginga', laps: 1, field: 4, assists: app.options.assists, seed }), {}); void s; void ReplayScene; app.ui.note('RACE A LAP, THEN WATCH IT IN THE THEATRE.'); }\n  if (param('attract') === '1') app.attract.start();\n  if (param('dev') === '1') app.ui.push(new DevPanel(app, app.scene?.sim ? app.scene : null));\n}\nif (typeof document !== 'undefined') boot();\nEOF\npython3 - <<'EOF'\np='src/game/scenes/race.js'; s=open(p).read()\na=\"    this.opts.drawExtra?.(this, ui, dt);\\n\"\nb=\"    this.opts.drawExtra?.(this, ui, dt);\\n    if (this.app.dev) this.app.drawOverlays?.(ui, this);\\n\"\nassert a in s; s=s.replace(a,b)\n# Attract clips must not finish into career flows\na=\"    if (this.ended) return;\\n\"\nb=\"    if (this.ended || this.opts.attract) return;\\n\"\nassert a in s; s=s.replace(a,b)\nopen(p,'w').write(s)\np='src/game/sim/licence.js'; s=open(p).read()\na=\"  get total() { return this.time + this.penalty; }\"\nb=\"  get total() { return this.time + this.penalty; }\\n  get totalWithBase() { return this.total + (this.base ?? 0); }\"\nassert a in s; s=s.replace(a,b); open(p,'w').write(s)\nEOF\necho 'export const INTERVIEW = null; export const KIT_CREDITS = \"\";' > src/game/data/about.gen.js\ncat > tools/tests/data.mjs <<'EOF'\n// Every id resolves; restrictions are satisfiable; every test has medals; all text fits the 60-character line and 4-line card.\nimport { suite } from './_lib.mjs';\nimport { CAR_IDS, CAR_INFO, MARQUES, PHYSICS, SHOWROOMS } from '../../src/game/data/cars.js';\nimport { TRACKS } from '../../src/game/data/tracks.js';\nimport { EVENTS, EVENT_IDS, AI_TUNES } from '../../src/game/data/events.js';\nimport { LICENCES, TESTS, TEST_IDS } from '../../src/game/data/licences.js';\nimport { PARTS, PART_IDS, SETUP_SLIDERS, TILES } from '../../src/game/data/parts.js';\nimport { TYRES } from '../../src/game/data/tyres.js';\nimport { HANDBOOK, LINES, MAP_PLACES, SPEAKERS, TIPS } from '../../src/game/data/text.js';\nimport { SONGS } from '../../src/game/data/songs.js';\nimport { SFX } from '../../src/game/audio/sfx.js';\nimport { CAR_MODELS } from '../../src/game/models/cars.js';\nimport { BUILDING_DEFS } from '../../src/game/models/buildings.js';\nimport { checkModel, analyzeClip, HERO_RIG } from '../../src/pixel-engine.js';\nimport { GAME_CLIPS } from '../../src/game/models/clips.js';\nimport { eligible } from '../../src/game/sim/career.js';\nimport { fullInstall, specOf } from '../../src/game/sim/tuning.js';\nconst t = suite();\nt.eq(CAR_IDS.length, 14, 'fourteen cars');\nfor (const id of CAR_IDS) {\n  const i = CAR_INFO[id];\n  t.ok(PHYSICS[id], `${id} has a physics row`); t.ok(MARQUES[i.marque], `${id} has a marque`); t.ok(CAR_MODELS[id], `${id} has a model`);\n  t.ok(Array.isArray(i.text) && i.text.length <= 4, `${id} brochure is at most 4 lines`);\n  for (const l of i.text) t.ok(l.length <= 60, `${id} brochure line too long: ${l}`);\n  t.ok(i.fenn, `${id} has a line from Mr. Fenn`);\n  const r = checkModel(CAR_MODELS[id].def); t.eq(r.problems.length, 0, `${id} model has problems: ${r.problems.join('; ')}`);\n}\nfor (const [id, d] of Object.entries(BUILDING_DEFS)) t.eq(checkModel(d).problems.length, 0, `building ${id}: ${checkModel(d).problems.join('; ')}`);\nt.eq(new Set(CAR_IDS.map((id) => PHYSICS[id].layout)).size, 5, 'all five layouts');\nfor (const s of SHOWROOMS) for (const c of s.cars) t.ok(CAR_INFO[c], `${s.id} lists a real car`);\nt.ok(SHOWROOMS[0].cars.every((c) => CAR_INFO[c].price <= 15000), 'every used car is affordable from the start');\nfor (const id of EVENT_IDS) {\n  const e = EVENTS[id];\n  for (const r of e.rounds) t.ok(TRACKS[r.track], `${id} round ${r.track} resolves`);\n  for (const p of e.pool) { const [c, tune] = Array.isArray(p) ? p : [p]; t.ok(CAR_INFO[c], `${id} pool ${c}`); if (tune) t.ok(AI_TUNES[tune], `${id} tune ${tune}`); }\n  if (e.prizeCar) t.ok(CAR_INFO[e.prizeCar], `${id} prize car`);\n  for (const l of e.needs) t.ok(LICENCES[l], `${id} needs ${l}`);\n  // Winnable with a car obtainable by then: at least one buyable or prize car qualifies, stock.\n  t.ok(CAR_IDS.some((c) => eligible(e, c, null).ok && (CAR_INFO[c].price > 0 || c !== e.prizeCar)), `${id} has a qualifying car`);\n  t.ok(e.intro.length <= 120, `${id} intro fits`);\n}\nt.ok(eligible(EVENTS.dawn, 'kite', null).ok, 'the Kite qualifies for the Dawn Patrol Cup');\nt.ok(!eligible(EVENTS.fellow, 'ginga', null).ok, 'the Ginga is refused by the Front-Drive Fellowship');\nt.ok(eligible(EVENTS.feather, 'moth', null).ok, 'the Moth qualifies for the Featherweight');\nt.ok(!eligible(EVENTS.dawn, 'kite', fullInstall(['stage3', 'intake'])).ok, 'a tuned Kite can exceed the limit');\nfor (const id of TEST_IDS) {\n  const T = TESTS[id]; t.ok(T.medals && T.medals.gold < T.medals.silver && T.medals.silver < T.medals.bronze, `${id} has ordered medals`);\n  t.ok(CAR_INFO[T.carId], `${id} car`); t.ok(TRACKS[T.track], `${id} track`); for (const l of T.brief) t.ok(l.length <= 60, `${id} brief line too long: ${l}`); t.ok(T.brief.length <= 4, `${id} brief fits a card`); t.ok(T.tip.length <= 80, `${id} tip`);\n}\nfor (const l of Object.values(LICENCES)) { t.eq(l.tests.length, 4, `${l.id} has four tests`); for (const x of l.tests) t.ok(TESTS[x], `${l.id} test ${x}`); }\nfor (const id of PART_IDS) { t.ok(TILES.some((x) => x.id === PARTS[id].cat), `${id} has a tile`); t.ok(PARTS[id].line.length <= 60, `${id} line fits`); t.ok(PARTS[id].price > 0, `${id} has a price`); }\nfor (const s of SETUP_SLIDERS) for (const n of s.needs) t.ok(PARTS[n], `${s.id} needs ${n}`);\nfor (const k of Object.keys(TYRES)) t.ok(TYRES[k].line.length <= 60, `${k} tyre line fits`);\nfor (const p of HANDBOOK) { for (const l of p.lines ?? []) t.ok(l.length <= 60, `handbook line too long: ${l}`); t.ok((p.lines ?? []).length <= 4, `${p.title} fits`); }\nfor (const l of TIPS) t.ok(l.length <= 90, `tip fits: ${l}`);\nfor (const m of MAP_PLACES) { t.ok(m.blurb.length <= 60, `${m.id} blurb`); }\nt.eq(MAP_PLACES.length, 9, 'nine places on the map');\nfor (const s of Object.values(LINES)) for (const l of Object.values(s)) for (const x of [].concat(l)) t.ok(/^[A-Z0-9 .,:;!?'\"()\\-+/%#=<>{}]*$/.test(x), `line uses the font: ${x}`);\nt.eq(Object.keys(SPEAKERS).length, 4, 'four speakers');\n// Songs: every track in a pattern has the same step count; only allowed waves; at least eight pieces.\nt.ok(Object.keys(SONGS).length >= 9, 'eight pieces and a fanfare');\nfor (const [id, s] of Object.entries(SONGS)) { for (const tk of Object.values(s.tracks)) t.ok(['square', 'triangle', 'saw', 'sine', 'noise'].includes(tk.wave), `${id} wave`); for (const [pn, p] of Object.entries(s.patterns)) { const counts = Object.entries(p).map(([k, v]) => [k, v.trim().split(/\\s+/).length]), n = counts[0][1]; for (const [k, c] of counts) t.eq(c, n, `${id}/${pn}/${k} steps`); t.ok(n % 16 === 0 || id === 'fanfare', `${id}/${pn} whole bars`); for (const k of Object.keys(p)) t.ok(s.tracks[k], `${id}/${pn}/${k} has an instrument`); } for (const o of s.order) t.ok(s.patterns[o], `${id} order ${o}`); }\nfor (const v of Object.values(SFX)) t.ok(v.wave, 'sound has a wave');\n// New clips pass the engine's own analysis.\nfor (const c of GAME_CLIPS) { const r = analyzeClip(c, HERO_RIG); t.eq(r.problems.length, 0, `clip ${c.name}: ${r.problems.join('; ')}`); }\nvoid specOf;\nt.done();\nEOF\ncat > tools/tests/career.mjs <<'EOF'\n// Money, licences, unlocks, prizes, oil, days. A save survives a version migration.\nimport { suite } from './_lib.mjs';\nimport * as C from '../../src/game/sim/career.js';\nimport { oilFactor, specOf, tunedParams, fullInstall } from '../../src/game/sim/tuning.js';\nimport { EVENTS, POINTS } from '../../src/game/data/events.js';\nimport { LICENCES, TESTS } from '../../src/game/data/licences.js';\nimport { SAVE_VERSION, START_CREDITS } from '../../src/game/data/meta.js';\nconst t = suite();\nlet p = C.newProfile();\nt.eq(p.credits, START_CREDITS, 'starts with 15,000');\nt.ok(!C.buyCar(p, 'moth').ok, 'cannot afford the Moth');\nt.ok(C.buyCar(p, 'kite').ok, 'buys the Kite'); t.eq(p.credits, 2500, 'pays for the Kite'); t.eq(C.carEntry(p).carId, 'kite', 'Kite is current');\nt.ok(!C.buyCar(p, 'works').ok, 'the Works is closed before Licence A');\nt.eq(C.sellCar(p, C.carEntry(p).uid).why, 'last', 'cannot sell the last car');\n// Parts\nconst car = C.carEntry(p);\nt.ok(C.buyPart(p, car, 'exhaust').ok, 'buys an exhaust'); t.eq(p.credits, 1600, 'pays 900'); t.ok(tunedParams('kite', car.install).powerPS > 148 * 1.03, 'an exhaust adds power');\nt.eq(C.buyPart(p, car, 'exhaust').why, 'owned', 'cannot buy it twice');\np.credits = 50000; C.buyPart(p, car, 'stage1'); C.buyPart(p, car, 'stage3'); t.ok(car.install.on.stage === 'stage3' && car.install.owned.includes('stage1'), 'exclusive group keeps one on'); C.buyPart(p, car, 'stage1'); t.eq(car.install.on.stage, 'stage1', 'an owned part swaps for free');\nconst mass = tunedParams('kite', car.install).mass; C.buyPart(p, car, 'weight2'); t.ok(tunedParams('kite', car.install).mass < mass, 'weight stage lowers mass');\nC.buyPart(p, car, 'aeroWing'); t.ok(tunedParams('kite', car.install).clA > 0.5, 'a wing adds downforce'); C.setSetup(car, 'downforce', 1.5); t.ok(tunedParams('kite', car.install).clA > 0.75, 'the downforce slider works');\nC.buyTyre(p, car, 'slick'); t.ok(tunedParams('kite', car.install).tyreMu === 1.3 && tunedParams('kite', car.install).wearX === 2.2, 'tyres replace the stock row');\nC.buyPaint(p, car, 'blue'); t.eq(car.install.paint, 'blue', 'paint'); C.buyRims(p, car, 2); t.eq(car.install.rims, 2, 'rims');\n// Oil\nt.near(oilFactor(50, true), 1.02, 1e-9, 'fresh oil gives 2%'); t.near(oilFactor(150, true), 1, 1e-9, 'level after 100 km'); t.near(oilFactor(280), 0.99, 1e-9, '0.5% per 40 km past 200'); t.near(oilFactor(5000), 0.92, 1e-9, 'never worse than -8%');\nconst c2 = C.carEntry(p); c2.kmOil = 500; const before = p.credits; t.ok(C.changeOil(p, c2).ok, 'oil change'); t.eq(p.credits, before - C.OIL_PRICE, 'oil costs 250'); t.eq(c2.kmOil, 0, 'oil is fresh');\nc2.dirt = 0.5; C.washCar(p, c2); t.eq(c2.dirt, 0, 'a wash removes mud');\nC.driveCar(p, c2, 10000, 5000); t.near(c2.km, 10, 1e-6, 'km counted'); t.ok(c2.dirt > 0, 'dirt builds up');\n// Licences\nconst q = C.newProfile(); C.addCar(q, 'kite');\nfor (const [i, id] of LICENCES.C.tests.entries()) { const r = C.recordTest(q, id, TESTS[id].medals.gold - 0.01); t.eq(r.medal, 'gold', `${id} gold`); if (i === 3) { t.ok(r.licenceWon, 'Licence C is won on the fourth test'); t.eq(r.reward, 2000, 'reward 2000'); t.ok(r.allGold && r.prizeCar === 'pico', 'all gold gives the Pico'); } }\nt.ok(q.licences.C, 'holds C'); t.ok(C.licenceOpen(q, 'B'), 'opens B'); t.ok(!C.licenceOpen(q, 'A'), 'A stays closed');\nt.eq(C.medalFor(TESTS['C-1'], TESTS['C-1'].medals.bronze + 1), null, 'too slow is no medal');\nconst f = C.newProfile(); t.eq(C.recordFailure(f, 'C-1'), 1, 'failures count'); C.recordFailure(f, 'C-1'); C.recordFailure(f, 'C-1'); t.eq(f.tests['C-1'].fails, 3, 'three failures offer the line');\n// Events\nconst e = C.newProfile(); C.addCar(e, 'kite'); t.ok(!C.eventOpen(e, 'dawn').ok, 'needs a licence'); e.licences.C = true; t.ok(C.eventOpen(e, 'dawn').ok, 'opens with C'); t.ok(!C.eventOpen(e, 'gp').ok, 'GP is closed');\nconst roster = C.eventRoster('dawn'); t.eq(roster.length, 5, 'field of six'); t.ok(roster[0].skill <= roster[4].skill, 'slowest at the front');\nconst names = ['YOU', ...roster.map((r) => r.name)]; let cash = e.credits, day = e.day;\nlet r = C.recordRound(e, 'dawn', names, 'YOU'); t.eq(r.prize, 1500, 'first prize'); t.eq(r.points, POINTS[0], '10 points'); t.eq(e.credits, cash + 1500, 'paid'); t.eq(e.day, day + 1, 'a race advances the day'); t.ok(!r.seriesDone, 'series continues');\nr = C.recordRound(e, 'dawn', [...names.slice(1), 'YOU'], 'YOU'); t.eq(r.prize, 0, 'last pays nothing');\nr = C.recordRound(e, 'dawn', names, 'YOU'); t.ok(r.seriesDone, 'series ends'); t.ok(r.seriesWon, 'most points wins'); t.eq(r.bonus, 3000, 'series bonus');\nt.ok(e.events.dawn.won, 'marked won'); t.ok(e.trophies.some((x) => x.kind === 'cup'), 'a cup on the shelf'); t.eq(e.events.dawn.round, 0, 'can run it again');\nconst again = C.recordRound(e, 'dawn', names, 'YOU'); void again; for (let i = 0; i < 2; i++) r = C.recordRound(e, 'dawn', names, 'YOU'); t.eq(r.bonus, 0, 'no second bonus');\n// Rally: the clock decides by legs.\nconst ra = C.newProfile(); ra.licences.B = true; let rr; for (const order of [['YOU', 'A'], ['B', 'YOU'], ['YOU', 'C']]) rr = C.recordRound(ra, 'clay', order, 'YOU'); t.ok(rr.seriesWon && rr.prizeCar === 'ryuRally', 'two legs of three wins the rally');\nconst rb = C.newProfile(); for (const order of [['A', 'YOU'], ['B', 'YOU'], ['YOU', 'C']]) rr = C.recordRound(rb, 'clay', order, 'YOU'); t.ok(!rr.seriesWon, 'one leg of three does not');\n// Prize cars cannot be sold; selling pays half.\nconst s = C.newProfile(); C.addCar(s, 'kite'); C.addCar(s, 'ginga'); const pz = C.addCar(s, 'type9', { prize: true }); t.eq(C.sellCar(s, pz.uid).why, 'prize', 'a prize car cannot be sold'); const cc = s.credits; t.ok(C.sellCar(s, s.cars[0].uid).ok, 'sells'); t.eq(s.credits, cc + 6250, 'half the price');\n// GP\nconst g = C.newProfile(); g.licences.A = true; t.ok(!C.eventOpen(g, 'gp').ok, 'GP needs a win'); g.events.h200 = { won: true }; t.ok(C.eventOpen(g, 'gp').ok, 'H200 opens the GP'); for (let i = 0; i < 4; i++) r = C.recordRound(g, 'gp', ['YOU', 'A'], 'YOU'); t.ok(r.ending && g.ended && r.prizeCar === 'type9', 'winning the GP ends the game with the Type 9');\n// Migration\nconst old = { version: 1, credits: 777, cars: [{ uid: 1, carId: 'kite', install: { owned: ['exhaust'] }, km: 12, kmOil: 12 }], licences: {}, events: {}, trophies: [], tests: {}, stats: { km: 12, wins: 0, gold: 0, races: 1 }, current: 1, nextUid: 2, day: 3, records: {} };\nconst m = C.migrate(JSON.parse(JSON.stringify(old))); t.eq(m.version, SAVE_VERSION, 'migrates to the current version'); t.eq(m.credits, 777, 'keeps money'); t.ok(Array.isArray(m.replays) && m.ghosts, 'adds replay slots and ghosts'); t.ok(m.cars[0].install.tyres && m.cars[0].install.owned[0] === 'exhaust', 'fills in installs'); t.ok(tunedParams('kite', m.cars[0].install).powerPS > 148, 'a migrated car still drives');\nt.eq(C.migrate(null).credits, START_CREDITS, 'garbage becomes a new profile');\nt.eq(C.nudge(C.newProfile()).to, 'dealer', 'the first nudge is to the dealer');\nconst n2 = C.newProfile(); C.addCar(n2, 'kite'); t.eq(C.nudge(n2).to, 'licence', 'then the licence centre');\nvoid specOf; void fullInstall; void EVENTS;\nt.done();\nEOF\nnode tools/test.mjs data career 2>&1 | tail -30","description":"Write dev mode, attract, hub, boot, data and career suites, run them","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26330,"cache_read_input_tokens":487526,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26330},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"516aaeac-9562-4713-ab00-857211dd041d","timestamp":"2026-11-06T01:10:25.010Z","request_id":"req_011Cgkn693apgkee1ykYD9YK","wire_tool_inputs":{"toolu_01B2fzxQrFWjcuS3BdabFixT":{"command":"cat > src/game/dev/devmode.js <<'EOF'\n// Dev mode: a pad-friendly panel over the running game. Live sliders, tools, overlays. Sliders stay for the session; Reset clears them.\nimport { CAR_IDS, CAR_INFO } from '../data/cars.js';\nimport { EVENT_IDS, EVENTS } from '../data/events.js';\nimport { TEST_IDS, TESTS, LICENCE_ORDER, LICENCES } from '../data/licences.js';\nimport { addCar, carEntry, eventState, newProfile, recordRound, recordTest } from '../sim/career.js';\nimport { defaultEnv, trackPoint } from '../sim/race.js';\nimport { THREE } from '../../pixel-engine.js';\nconst { Vector3 } = THREE;\nexport const SLIDERS = [\n  { id: 'gripScale', name: 'GRIP', def: 1, min: 0.5, max: 1.5, step: 0.05, get: (a) => a.env.gripScale, set: (a, v) => { a.env.gripScale = v; } },\n  { id: 'powerScale', name: 'POWER', def: 1, min: 0.5, max: 2, step: 0.05, get: (a) => a.env.powerScale, set: (a, v) => { a.env.powerScale = v; } },\n  { id: 'brakeScale', name: 'BRAKE STRENGTH', def: 1, min: 0.5, max: 1.5, step: 0.05, get: (a) => a.env.brakeScale, set: (a, v) => { a.env.brakeScale = v; } },\n  { id: 'aeroScale', name: 'DOWNFORCE', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.aeroScale, set: (a, v) => { a.env.aeroScale = v; } },\n  { id: 'wearScale', name: 'TYRE WEAR', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.env.wearScale, set: (a, v) => { a.env.wearScale = v; } },\n  { id: 'fuelScale', name: 'FUEL USE', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.env.fuelScale, set: (a, v) => { a.env.fuelScale = v; } },\n  { id: 'steerRate', name: 'STEERING RATE', def: 3, min: 1, max: 8, step: 0.25, get: (a) => a.env.steerRate, set: (a, v) => { a.env.steerRate = v; } },\n  { id: 'stability', name: 'STABILITY STRENGTH', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.stability, set: (a, v) => { a.env.stability = v; } },\n  { id: 'traction', name: 'TRACTION STRENGTH', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.traction, set: (a, v) => { a.env.traction = v; } },\n  { id: 'aiPace', name: 'AI PACE', def: 0, min: 0, max: 1.05, step: 0.01, get: (a) => a.env.aiPace ?? 0, set: (a, v) => { a.env.aiPace = v < 0.7 ? null : v; }, fmt: (v) => (v < 0.7 ? 'EVENT' : v.toFixed(2)) },\n  { id: 'rubber', name: 'AI RUBBER BAND', def: 0, min: 0, max: 0.03, step: 0.002, get: (a) => a.env.rubber, set: (a, v) => { a.env.rubber = v; }, fmt: (v) => v.toFixed(3) },\n  { id: 'wallLoss', name: 'WALL SPEED LOSS', def: 1, min: 0, max: 2, step: 0.1, get: (a) => a.env.wallLoss, set: (a, v) => { a.env.wallLoss = v; } },\n  { id: 'slip', name: 'SLIPSTREAM', def: 0.65, min: 0.4, max: 1, step: 0.05, get: (a) => a.env.slip, set: (a, v) => { a.env.slip = v; } },\n  { id: 'prize', name: 'PRIZE MONEY', def: 1, min: 0, max: 5, step: 0.25, get: (a) => a.prizeMult ?? 1, set: (a, v) => { a.prizeMult = v; } },\n  { id: 'chase', name: 'CHASE DISTANCE', def: 8.5, min: 4, max: 14, step: 0.5, get: (a) => a.devSliders?.chase ?? 8.5, set: (a, v) => { (a.devSliders ??= { fov: 58 }).chase = v; if (a.scene?.chase) a.scene.chase.distance = v; } },\n  { id: 'fov', name: 'CHASE FOV', def: 58, min: 40, max: 90, step: 2, get: (a) => a.devSliders?.fov ?? 58, set: (a, v) => { (a.devSliders ??= { chase: 8.5 }).fov = v; if (a.scene?.chase) a.scene.chase.fovBase = v; }, fmt: (v) => v.toFixed(0) },\n];\nconst PER = 7;\nconst TABS = ['SLIDERS', 'RACE', 'VIEW', 'WEATHER', 'CAREER', 'JUMP'];\nconst SCALES = [0.25, 0.5, 1, 2, 4];\nexport const newDevState = () => ({ overlays: { line: false, load: false, surface: false, circles: false, ai: false, telemetry: false }, freeCam: false, tele: [], savedState: null });\nexport function devDirty(app) { for (const s of SLIDERS) { const v = s.get(app); if (Math.abs(v - s.def) > 1e-6) return true; } return !!app.env.god; }\nexport class DevPanel {\n  constructor(app, scene) { this.id = 'dev'; this.app = app; this.scene = scene; this.tab = 0; this.page = 0; app.dev = app.dev ?? newDevState(); }\n  draw(ui) {\n    const app = this.app, w = Math.min(ui.w - 12, 380), x = Math.round(ui.cx - w / 2), h = ui.h - 22;\n    ui.panel(x, 3, w, h, { color: 'ink', border: 'red', scan: false });\n    ui.text(x + 6, 7, 'DEV MODE', { color: 'red' }); if (devDirty(app)) ui.text(x + w - 6, 7, 'RECORDS ARE OFF', { align: 'right', color: 'orange' });\n    ui.tabs('t', x + 3, 17, w - 6, TABS, this.tab, (i) => { this.tab = i; this.focus = null; this.page = 0; ui.box.ready = false; });\n    const fn = [this.sliders, this.race, this.view, this.weather, this.career, this.jump][this.tab]; fn.call(this, ui, x + 5, 33, w - 10);\n  }\n  btn(ui, id, x, y, w, label, fn, o = {}) { ui.button(id, x, y, w, 15, label, { ...o, confirm: fn }); }\n  sliders(ui, x, y, w) {\n    const app = this.app, pages = Math.ceil(SLIDERS.length / PER), list = SLIDERS.slice(this.page * PER, this.page * PER + PER);\n    list.forEach((s, k) => ui.slider(s.id, x, y + k * 18, w, 15, s.name, s.get(app), s.min, s.max, { step: s.step, set: (v) => { s.set(app, Math.round(v / s.step) * s.step); app.devDirty = devDirty(app); }, reset: () => { s.set(app, s.def); app.devDirty = devDirty(app); }, format: s.fmt ?? ((v) => v.toFixed(2)) }));\n    const by = y + PER * 18 + 2, bw = (w - 6) / 2;\n    this.btn(ui, 'pageNext', x, by, bw, `MORE SLIDERS ${this.page + 1}/${pages}`, () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; });\n    this.btn(ui, 'resetAll', x + bw + 6, by, bw, 'RESET ALL', () => this.resetAll());\n    ui.prompts([['moveX', 'ADJUST'], ['confirm', 'RESET ONE'], ['info', 'RESET ALL'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  onInfo() { if (this.tab === 0) this.resetAll(); }\n  resetAll() { const app = this.app, d = defaultEnv(); Object.assign(app.env, d); app.prizeMult = 1; app.devSliders = null; if (app.scene?.chase) { app.scene.chase.distance = null; app.scene.chase.fovBase = 58; } app.devDirty = false; app.ui.note('ALL SLIDERS AT THEIR DEFAULTS.'); }\n  race(ui, x, y, w) {\n    const app = this.app, s = app.scene, sim = s?.sim, bw = (w - 6) / 2;\n    if (!sim) { ui.lines(x + 2, y + 2, 'THESE TOOLS WORK DURING A DRIVE. OPEN DEV MODE FROM THE PAUSE MENU.', { chars: 50, color: 'mist' }); this.btn(ui, 'quick', x, y + 26, w, 'START A TEST RACE NOW', () => app.startQuick({ track: 'kestrel', carId: 'ginga', laps: 2, field: 6, difficulty: 'normal' })); ui.prompts([['confirm', 'CHOOSE'], ['tabs', 'TAB'], ['back', 'CLOSE']]); return; }\n    const me = s.focusE ?? sim.cars[0], L = sim.tr.length;\n    const f = ui.item('teleport', x, y, w, 15, { onX: (d) => { const k = (me.c.loc.s + d * 80 + L) % L; sim.teleport(me.i, k); s.chase?.snap(); app.mix.sfx('tick'); }, confirm: () => sim.teleport(me.i, 0) }); ui.rect(x, y, w, 15, f ? 'navy' : 'night'); ui.text(x + 6, y + 4, 'TELEPORT ALONG THE TRACK', { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 4, `< ${Math.round(me.c.loc.s)} M >`, { align: 'right', color: 'sand' });\n    const pos = this.finishPos ?? 1;\n    const f2 = ui.item('finish', x, y + 18, w, 15, { onX: (d) => { this.finishPos = Math.max(1, Math.min(sim.cars.length, pos + d)); }, confirm: () => { ui.pop(); ui.pop(); sim.finishNow(me.i, pos); } }); ui.rect(x, y + 18, w, 15, f2 ? 'navy' : 'night'); ui.text(x + 6, y + 22, 'FINISH NOW IN POSITION', { color: f2 ? 'white' : 'mist' }); ui.text(x + w - 6, y + 22, `< ${pos} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'end', x, y + 36, bw, 'END RACE', () => { ui.pop(); ui.pop(); sim.finishNow(me.i, sim.cars.length); });\n    this.btn(ui, 'restart', x + bw + 6, y + 36, bw, 'RESTART', () => app.restartRun(s));\n    this.btn(ui, 'reset', x, y + 54, bw, 'RESET CAR', () => sim.recover(me.i));\n    this.btn(ui, 'god', x + bw + 6, y + 54, bw, `GOD MODE: ${app.env.god ? 'ON' : 'OFF'}`, () => { app.env.god = !app.env.god; app.devDirty = devDirty(app); });\n    const cur = SCALES.indexOf(app.engine.timeScale);\n    const f3 = ui.item('scale', x, y + 72, w, 15, { onX: (d) => { const n = SCALES[Math.max(0, Math.min(SCALES.length - 1, (cur < 0 ? 2 : cur) + d))]; app.engine.timeScale = n; }, confirm: () => { app.engine.timeScale = 1; } }); ui.rect(x, y + 72, w, 15, f3 ? 'navy' : 'night'); ui.text(x + 6, y + 76, 'TIME SCALE', { color: f3 ? 'white' : 'mist' }); ui.text(x + w - 6, y + 76, `< ${app.engine.timeScale} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'frame', x, y + 90, bw, 'STEP ONE FRAME', () => { s.stepFrames = 1; });\n    this.btn(ui, 'saveState', x + bw + 6, y + 90, bw, 'SAVE STATE', () => { app.dev.savedState = sim.saveState(); ui.note('STATE SAVED.'); });\n    this.btn(ui, 'loadState', x, y + 108, bw, 'LOAD STATE', () => { if (app.dev.savedState) { sim.loadState(app.dev.savedState); s.chase?.snap(); ui.note('STATE LOADED.'); } else ui.note('NOTHING SAVED YET.'); });\n    this.btn(ui, 'changeCar', x + bw + 6, y + 108, bw, 'CHANGE CAR', () => { const d = s.data, i = d.cars.findIndex((c) => c.player === 0); if (i < 0) return; const n = CAR_IDS[(CAR_IDS.indexOf(d.cars[i].carId) + 1) % CAR_IDS.length], patch = { ...d, cars: d.cars.map((c, k) => (k === i ? { ...c, carId: n, install: null } : c)) }; app.restartWith(s, patch); });\n    ui.prompts([['confirm', 'DO IT'], ['moveX', 'ADJUST'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  view(ui, x, y, w) {\n    const app = this.app, o = app.dev.overlays, bw = (w - 6) / 2, tog = (id, label, on, fn, i) => this.btn(ui, id, x + (i % 2) * (bw + 6), y + Math.floor(i / 2) * 18, bw, `${label}: ${on ? 'ON' : 'OFF'}`, fn);\n    [['line', 'RACING LINE'], ['load', 'WHEEL LOAD, SLIP'], ['surface', 'SURFACE TINT'], ['circles', 'COLLISION CIRCLES'], ['ai', 'AI TARGETS'], ['telemetry', 'TELEMETRY']].forEach(([k, label], i) => tog(k, label, o[k], () => { o[k] = !o[k]; if (k === 'line' && app.scene) app.scene.lineOn = o[k]; }, i));\n    tog('freeCam', 'FREE CAMERA', app.dev.freeCam, () => { app.dev.freeCam = !app.dev.freeCam; if (app.dev.freeCam) app.dev.driveFreeCam = driveFreeCam; }, 6);\n    tog('panel', 'ENGINE DEBUG PANEL', !!app.engine.debugShown, () => app.engine.showDebug(!app.engine.debugShown), 7);\n    ui.prompts([['confirm', 'TOGGLE'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  weather(ui, x, y, w) {\n    const app = this.app, s = app.scene, d = s?.data, bw = (w - 6) / 2;\n    if (!d) { ui.lines(x + 2, y + 2, 'THE WEATHER CHANGES ONLY ON THE CIRCUIT. IT IS ALWAYS SOMETHING ON THE PENINSULA.', { chars: 50, color: 'mist' }); ui.prompts([['tabs', 'TAB'], ['back', 'CLOSE']]); this.btn(ui, 'attract', x, y + 28, w, 'START ATTRACT MODE NOW', () => app.attract?.start()); return; }\n    this.hour = this.hour ?? d.hour ?? 12;\n    const f = ui.item('hour', x, y, w, 15, { onX: (k) => { this.hour = (this.hour + k + 24) % 24; s.world?.setHourIf(this.hour); }, confirm: () => app.restartWith(s, { ...d, hour: this.hour }) }); ui.rect(x, y, w, 15, f ? 'navy' : 'night'); ui.text(x + 6, y + 4, 'HOUR OF DAY (CONFIRM RESTARTS WITH LAMPS)', { color: f ? 'white' : 'mist' }); ui.text(x + w - 6, y + 4, `< ${this.hour} >`, { align: 'right', color: 'sand' });\n    this.btn(ui, 'rain', x, y + 18, bw, `RAIN: ${d.rain ? 'ON' : 'OFF'}`, () => app.restartWith(s, { ...d, rain: !d.rain }));\n    const n = d.cars.length;\n    const f2 = ui.item('fieldSize', x + bw + 6, y + 18, bw, 15, { onX: (k) => { this.field = Math.max(1, Math.min(8, (this.field ?? n) + k)); }, confirm: () => { const m = this.field ?? n, me = d.cars.filter((c) => c.player !== null && c.player !== undefined), others = d.cars.filter((c) => c.player === null || c.player === undefined); const pool = others.length ? others : [{ carId: me[0]?.carId ?? 'ginga', name: 'T. HOLLIS', skill: 0.9 }]; const list = []; for (let i = 0; i < m - me.length; i++) list.push({ ...pool[i % pool.length], name: `AI ${i + 1}` }); app.restartWith(s, { ...d, cars: [...list, ...me] }); } }); ui.rect(x + bw + 6, y + 18, bw, 15, f2 ? 'navy' : 'night'); ui.text(x + bw + 12, y + 22, `FIELD < ${this.field ?? n} >`, { color: f2 ? 'white' : 'mist' });\n    this.btn(ui, 'attract', x, y + 36, w, 'START ATTRACT MODE NOW', () => app.attract?.start());\n    ui.prompts([['confirm', 'APPLY'], ['moveX', 'ADJUST'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n  career(ui, x, y, w) {\n    const app = this.app, p = app.profile, bw = (w - 6) / 2;\n    this.btn(ui, 'credits', x, y, bw, 'GIVE 100,000 CR', () => { p.credits += 100000; app.save(); ui.note('100,000 CR GIVEN.'); });\n    this.btn(ui, 'cars', x + bw + 6, y, bw, 'UNLOCK ALL CARS', () => { for (const id of CAR_IDS) if (!p.cars.some((c) => c.carId === id)) addCar(p, id, { prize: CAR_INFO[id].where === 'prize' }); if (p.current === null) p.current = p.cars[0].uid; app.save(); ui.note('ALL FOURTEEN IN THE GARAGE.'); });\n    this.btn(ui, 'gold', x, y + 18, bw, 'ALL TESTS AT GOLD', () => { for (const id of TEST_IDS) recordTest(p, id, TESTS[id].medals.gold - 0.01); app.save(); ui.note('EVERY LICENCE HELD, AT GOLD.'); });\n    this.btn(ui, 'winEvent', x + bw + 6, y + 18, bw, 'WIN THE CURRENT EVENT', () => { const id = app.scene?.data?.event ?? EVENT_IDS.find((k) => !p.events[k]?.won) ?? 'gp', e = EVENTS[id]; let last = null; const st = eventState(p, id); for (let i = st.round; i < e.rounds.length; i++) last = recordRound(p, id, ['YOU', 'R. OKADA'], 'YOU'); app.save(); ui.note(`${e.name} WON${last?.prizeCar ? `: ${CAR_INFO[last.prizeCar].short}` : ''}.`); });\n    this.btn(ui, 'resetSave', x, y + 36, w, 'RESET THE SAVE', () => { app.profile = newProfile(); app.save(); if (app.profile && app.toTitle) app.toTitle(); });\n    ui.text(x + 2, y + 56, `CREDITS ${p.credits.toLocaleString('en-US')}`, { color: 'mist' }); ui.text(x + 2, y + 66, `CURRENT CAR ${carEntry(p) ? CAR_INFO[carEntry(p).carId].short : 'NONE'}`, { color: 'mist' });\n    ui.prompts([['confirm', 'DO IT'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n    void LICENCE_ORDER; void LICENCES;\n  }\n  jump(ui, x, y, w) {\n    const app = this.app; const list = [...EVENT_IDS.map((id) => ({ id: `ev-${id}`, label: `EVENT: ${EVENTS[id].name}`, go: () => app.startEventRound(id) })), ...TEST_IDS.map((id) => ({ id: `t-${id}`, label: `TEST ${id}: ${TESTS[id].title}`, go: () => app.startTest(id) })), ...['map', 'dealer', 'tuning', 'service', 'garage', 'museum', 'theatre', 'arcade'].map((id) => ({ id: `m-${id}`, label: `MENU: ${id.toUpperCase()}`, go: () => app.jumpMenu(id) }))];\n    const pages = Math.ceil(list.length / PER); list.slice(this.page * PER, this.page * PER + PER).forEach((it, k) => this.btn(ui, it.id, x, y + k * 18, w, it.label, () => { if (app.profile.cars.length === 0 && !it.id.startsWith('m-')) addCar(app.profile, 'kite'); ui.clear(); it.go(); }, { left: true }));\n    this.btn(ui, 'pageNext', x, y + PER * 18 + 2, w, `MORE ${this.page + 1}/${pages}`, () => { this.page = (this.page + 1) % pages; this.focus = null; ui.box.ready = false; });\n    ui.prompts([['confirm', 'GO'], ['tabs', 'TAB'], ['back', 'CLOSE']]);\n  }\n}\nconst FV = new Vector3();\nfunction driveFreeCam(ctx, dt, cam) { // WASD or the left stick moves, the right stick or a right drag looks\n  const input = ctx.input, a = FV; this._y = this._y ?? 0;\n  let mx = 0, mz = 0, my = 0, lx = 0, ly = 0;\n  if (input.isDown('KeyW') || input.isDown('ArrowUp')) mz += 1; if (input.isDown('KeyS') || input.isDown('ArrowDown')) mz -= 1; if (input.isDown('KeyA') || input.isDown('ArrowLeft')) mx -= 1; if (input.isDown('KeyD') || input.isDown('ArrowRight')) mx += 1; if (input.isDown('KeyE')) my += 1; if (input.isDown('KeyQ')) my -= 1;\n  const app = ctx.engine.game?.app; for (const p of app?.actions.pads ?? []) { mx += p.axes[0]; mz -= p.axes[1]; lx += p.axes[2]; ly += p.axes[3]; }\n  if (input.isDown('MouseRight')) { lx += (input.mouseDelta.x ?? 0) * 0.3; ly += (input.mouseDelta.y ?? 0) * 0.3; }\n  cam.rotation.order = 'YXZ'; cam.rotation.y -= lx * dt * 2; cam.rotation.x = Math.max(-1.4, Math.min(1.4, cam.rotation.x - ly * dt * 2));\n  a.set(mx, my, -mz).multiplyScalar(dt * 24).applyEuler(cam.rotation); cam.position.add(a);\n}\nconst P = new Vector3();\n// Overlays, drawn over the HUD.\nexport function drawOverlays(ui, app, scene) {\n  const dev = app.dev; if (!dev) return; const o = dev.overlays, sim = scene.sim, cam = scene.cam, me = scene.focusE; if (!sim || !me) return;\n  const project = (x, y, z) => { P.set(x, y, z).project(cam); return P.z < 1 ? [(P.x + 1) * 0.5 * ui.w, (1 - P.y) * 0.5 * ui.h] : null; };\n  const c = me.c;\n  if (o.load) { const bx = ui.w - 96, by = 60; ui.panel(bx - 3, by - 3, 96, 52, { color: 'ink', border: false, scan: true }); for (let i = 0; i < 4; i++) { const load = c.fz[i] / (c.p.mass * 9.81 * 0.5), slip = Math.min(1.6, c.use[i]) / 1.6; ui.text(bx, by + i * 12, ['FL', 'FR', 'RL', 'RR'][i], { color: 'mist' }); ui.bar(bx + 16, by + i * 12, 34, 4, load, 'sky', 'night'); ui.bar(bx + 54, by + i * 12, 34, 4, slip, slip > 0.8 ? 'red' : 'lime', 'night'); } }\n  if (o.surface) { const col = { asphalt: 'slate', kerb: 'red', grass: 'green', gravel: 'orange', dirt: 'orange', apron: 'mist' }[c.surface] ?? 'white'; ui.rect(0, 0, ui.w, 2, col); ui.rect(0, ui.h - 2, ui.w, 2, col); ui.text(ui.cx, 8, `SURFACE: ${c.surface.toUpperCase()}`, { align: 'center', color: col }); }\n  if (o.circles) for (const e of sim.cars) { for (const off of [-1.35, 0, 1.35]) { const cx = e.c.x + Math.sin(e.c.yaw) * off, cz = e.c.z + Math.cos(e.c.yaw) * off; for (let a = 0; a < 12; a++) { const t = (a / 12) * 6.283, q = project(cx + Math.sin(t) * 0.875, e.c.y + 0.3, cz + Math.cos(t) * 0.875); if (q) ui.rect(q[0], q[1], 1, 1, e === me ? 'lime' : 'red'); } } }\n  if (o.ai) for (const e of sim.cars) { if (e.player !== null && !e.autoDrive) continue; const u = Math.hypot(e.c.vx, e.c.vz), idx = (e.c.loc.i + Math.round(Math.max(7, u * 0.62) / sim.tr.ds)) % sim.tr.N, tr = sim.tr, rx = -tr.tz[idx], rz = tr.tx[idx], lane = e.c.laneNow ?? 0, q = project(sim.line.px[idx] + rx * lane, tr.y[idx] + 0.3, sim.line.pz[idx] + rz * lane); if (q) { ui.rect(q[0] - 1, q[1] - 1, 3, 3, 'cyan'); } const n = project(e.c.x, e.c.y + 1.7, e.c.z); if (n) ui.text(n[0], n[1] - 8, `${(e.speeds[e.c.loc.i] * 3.6).toFixed(0)}`, { align: 'center', color: 'cyan' }); }\n  if (o.line) { const i = c.loc.i; ui.text(ui.cx, 16, `LINE WANTS ${(me.speeds[i] * 3.6).toFixed(0)} KM/H`, { align: 'center', color: 'lime' }); }\n  if (o.telemetry) {\n    const T = dev.tele; T.push([Math.abs(c.u) / 90, me.inp?.throttle ?? 0, me.inp?.brake ?? 0, 0.5 + c.ax / 40, 0.5 + c.ay / 40]); if (T.length > 200) T.shift();\n    const x0 = ui.cx - 100, y0 = ui.h - 52, H = 26; ui.panel(x0 - 2, y0 - 2, 204, H + 4, { color: 'ink', border: false }); const cols = ['white', 'lime', 'red', 'sky', 'sand']; T.forEach((v, k) => { for (let n = 0; n < 5; n++) ui.rect(x0 + k, y0 + H - Math.round(Math.max(0, Math.min(1, v[n])) * H), 1, 1, cols[n]); });\n    ui.text(x0, y0 - 10, 'SPD THR BRK AX AY', { color: 'mist' });\n  }\n  void trackPoint;\n}\nEOF\ncat > src/game/attract/director.js <<'EOF'\n// Attract mode: after 10 s of no input on the title or the Map, the game plays itself. Any input returns to where the player was.\nimport { RaceScene } from '../scenes/race.js';\nimport { MenuScene } from '../scenes/menu.js';\nimport { THREE } from '../../pixel-engine.js';\nimport { TITLE } from '../data/meta.js';\nimport { TESTS } from '../data/licences.js';\nimport { testSetup } from '../sim/licence.js';\nimport { defaultEnv, trackPoint } from '../sim/race.js';\nimport { CAR_INFO } from '../data/cars.js';\nimport { EVENTS } from '../data/events.js';\nimport { fullInstall } from '../sim/tuning.js';\nimport { DynoScreen } from '../ui/screens/tuning.js';\nimport { PodiumScreen, PrizeScreen } from '../ui/screens/cinema.js';\nimport { medalIcon } from '../ui/screens/common.js';\nvoid THREE;\nconst CLIPS = [\n  { id: 'title', seconds: 3, kind: 'menu' },\n  { id: 'showroom', seconds: 10, kind: 'menu' },\n  { id: 'tuning', seconds: 8, kind: 'menu' },\n  { id: 'licence', seconds: 10, kind: 'race' },\n  { id: 'kestrel', seconds: 20, kind: 'race' },\n  { id: 'redclay', seconds: 12, kind: 'race' },\n  { id: 'harbour', seconds: 20, kind: 'race' },\n  { id: 'saltline', seconds: 10, kind: 'race' },\n  { id: 'podium', seconds: 8, kind: 'menu' },\n  { id: 'credits', seconds: 4, kind: 'menu' },\n];\nconst AI_FIELD = (ids, base = 0.95, extra = {}) => ids.map((id, i) => ({ carId: id, name: `DEMO ${i + 1}`, skill: base + i * 0.006, ...extra }));\nexport class Attract {\n  constructor(app) { this.app = app; this.active = false; this.i = 0; this.t = 0; this.returnTo = null; this.starting = false; }\n  // Called every frame by the App.\n  tick(ctx, dt) {\n    const app = this.app, a = app.actions;\n    if (app.session) return;\n    if (!this.active) {\n      if (app.idleWatch && a.idle > 10 && !app.switching && !this.starting) this.start();\n      return;\n    }\n    if (this.grace > 0) this.grace -= dt;\n    else if (a.anyInput) { this.stop(); return; }\n    if (app.switching) return;\n    this.t += dt;\n    this.clip?.update?.(dt);\n    if (this.t >= CLIPS[this.i].seconds) { this.i = (this.i + 1) % CLIPS.length; this.play(); }\n  }\n  start() {\n    const app = this.app; if (this.active || app.session) return;\n    this.returnTo = app.ui.stack.some((s) => s.id === 'map') ? 'map' : 'title';\n    this.active = true; this.i = 0; this.grace = 0.5; app.idleWatch = false; app.ui.subtitle = null; app.ui.clear();\n    this.savedEnv = { ...app.env };\n    this.play();\n  }\n  stop() {\n    const app = this.app; this.active = false; this.clip = null; Object.assign(app.env, this.savedEnv ?? {}); app.actions.idle = 0; app.ui.clear();\n    app.mix.stopVoice();\n    const back = this.returnTo === 'map' ? (ui) => ui.push(new app.Screens.MapScreen(app)) : null;\n    app.go(() => new MenuScene(app, { start: back }), 'fade');\n  }\n  menuClip(setupFn) { return this.app.go(() => new MenuScene(this.app, { start: (ui, scene) => { const s = new AttractScreen(this.app, this); ui.push(s); setupFn?.(ui, scene, s); } }), 'blinds'); }\n  raceClip(setup, opts = {}) { const app = this.app; app.ui.clear(); return app.go(() => new RaceScene(app, { ...setup, env: defaultEnv() }, { attract: true, ...opts, onFrame: (scene, ctx, dt) => { this.overlay(ctx, dt); opts.onFrame?.(scene, ctx, dt); } }), 'blinds'); }\n  overlay(ctx) { const ui = this.app.ui; ui.hud = ctx.hud; const w = ctx.hud.width; ui.w = w; ui.h = ctx.hud.height; ui.cx = w / 2; ui.panel(w / 2 - 22, 3, 44, 11, { color: 'ink', border: 'red' }); ui.text(w / 2, 5, 'DEMO', { align: 'center', color: Math.floor(ui.time * 2) % 2 ? 'red' : 'white' }); if (this.caption) ui.text(w / 2, ctx.hud.height - 20, this.caption, { align: 'center', color: 'sand' }); }\n  play() {\n    const app = this.app, clip = CLIPS[this.i]; this.t = 0; this.clip = null; this.caption = null;\n    this.seen = this.seen ?? new Set(); this.seen.add(clip.id);\n    const P = this[`play_${clip.id}`]; P.call(this);\n    void app;\n  }\n  play_title() { this.menuClip((ui, scene, s) => { scene.opts.title = true; scene.stage('map', { hour: 18.4 }); app_music(this.app, 'lounge'); s.big = TITLE; }); }\n  play_showroom() {\n    const cars = ['kite', 'libeccio', 'heck'];\n    this.menuClip((ui, scene, s) => { app_music(this.app, 'catalogue'); let k = -1, t = 99; s.onTick = (dt) => { t += dt; if (t > 3.3) { t = 0; k = (k + 1) % cars.length; scene.stage('showroom', { showroom: k + 1, car: { carId: cars[k], install: null }, person: 'fenn', personClip: 'DealerPresent', personAt: [-4.6, 0, 1.8], personYaw: 1.1 }); s.lines = CAR_INFO[cars[k]].text; ui.say('fenn', CAR_INFO[cars[k]].fenn, 3); } }; });\n  }\n  play_tuning() {\n    const app = this.app, car = { carId: 'ginga', install: fullInstall(['exhaust', 'stage2']), km: 0, dirt: 0, uid: -1 };\n    this.menuClip((ui, scene, s) => { app_music(app, 'socket'); scene.stage('bay', { car: { carId: 'ginga', install: car.install, y: 0.08 }, person: 'benno', personClip: 'MechanicWipe', personAt: [4.6, 0, 0.8], personYaw: -1.2, radius: 7.8, height: 2.3 }); const before = fullInstall(['exhaust']); const dy = new DynoScreen(app, car, before); ui.push(dy); let t = 0, done = false; s.owner = this; dy.autoClose = true; this.clip = { update: (dt) => { t += dt; if (t > 5.8 && !done) { done = true; ui.pop(); const inst = fullInstall(['exhaust', 'stage2', 'aeroWing']); scene.showCar('ginga', inst, { y: 0.08 }).settle = 0.16; s.lines = ['A BIG WING: YOU NOW HAVE MORE DOWNFORCE.', 'YOU ALSO HAVE MORE DRAG. THERE IS NO THIRD THING.']; app.mix.sfx('register'); } } }; });\n  }\n  play_licence() {\n    const test = TESTS['B-1'], app = this.app; let medal = 0;\n    this.raceClip({ ...testSetup(test, 0, {}), record: false, seed: 3 }, { test, demo: true, hideHud: false, onFrame: (scene, ctx, dt) => { if (scene.judge?.status === 'pass' && !medal) { medal = 1; app.mix.sfx('medal'); } if (medal) { medal += dt; const ui = app.ui; ui.panel(ui.cx - 70, 80, 140, 40, { color: 'ink', border: 'sand' }); medalIcon(ui, ui.cx - 4, 84, 'gold'); ui.text(ui.cx, 98, 'GOLD', { align: 'center', scale: 2, color: 'sand' }); } } });\n    this.caption = 'LICENCE B-1: THRESHOLD';\n  }\n  play_kestrel() { this.caption = 'KESTREL PARK'; this.raceClip({ kind: 'attract', track: 'kestrel', laps: 3, hour: 15, start: 'rolling', wear: 0, fuel: 0, record: false, seed: 5, cars: AI_FIELD(['ginga', 'kite', 'brandt32', 'moth', 'ryu', 'heck'], 0.92) }, { onFrame: (scene) => { if (this.t > 9 && !scene.tvMode) scene.startTv(); if (scene.sim.phase === 'green' && this.t > 3 && !this.cut1) { this.cut1 = true; } } }); this.cut1 = false; }\n  play_redclay() {\n    this.caption = 'RED CLAY STAGE';\n    this.raceClip({ kind: 'attract', track: 'redclay', laps: 3, hour: 17, start: 'flying', startS: 240, startSpeed: 90, contact: false, wear: 0, fuel: 0, record: false, seed: 6, cars: [{ carId: 'ryuRally', name: 'DEMO', skill: 1 }] }, { onFrame: (scene) => { const sim = scene.sim; if (this.t > 6.5 && !this.hair) { this.hair = true; const s = sim.tr.cornerS[4] - 70; sim.teleport(0, s); const c = sim.cars[0].c, pt = trackPoint(sim.tr, s, 0); c.vx = Math.sin(pt.yaw) * 24; c.vz = Math.cos(pt.yaw) * 24; scene.chase.snap(); this.caption = 'A HANDBRAKE HAIRPIN'; const orig = sim.aiInput.bind(sim); sim.aiInput = (e, m) => { const inp = orig(e, m), d = sim.tr.cornerS[4] - e.c.loc.s; inp.handbrake = d > -6 && d < 14 && Math.abs(e.c.u) > 8; return inp; }; } } });\n    this.hair = false;\n  }\n  play_harbour() {\n    this.caption = 'HARBOUR LIGHTS, NIGHT'; this.pitted = false;\n    this.raceClip({ kind: 'attract', track: 'harbour', laps: 10, hour: 21, start: 'flying', startS: 400, startSpeed: 90, wear: 0, fuel: 1, record: false, seed: 7, cars: AI_FIELD(['libeccio', 'heck', 'brandt32', 'works'], 0.97) }, { onFrame: (scene) => { const sim = scene.sim, e = sim.cars[sim.cars.length - 1], tr = sim.tr; if (this.t > 9.5 && !this.pitted) { this.pitted = true; this.caption = 'THE TEN LAP RACE: ONE STOP NEEDED'; const s = tr.pit.in - 90, pt = trackPoint(tr, s, 0); sim.teleport(e.i, s); e.c.vx = Math.sin(pt.yaw) * 25; e.c.vz = Math.cos(pt.yaw) * 25; for (let i = 0; i < 4; i++) e.c.wear[i] = 0.25; e.c.fuel = 0.3; e.wantPit = true; scene.chase.snap(); } } });\n  }\n  play_saltline() {\n    this.caption = 'SALTLINE SPEEDBOWL';\n    this.raceClip({ kind: 'attract', track: 'saltline', laps: 5, hour: 18.5, start: 'flying', startS: 320, startSpeed: 290, wear: 0, fuel: 0, record: false, seed: 8, contact: false, cars: [{ carId: 'corsa', name: 'DEMO 1', skill: 1.04 }, { carId: 'type9', name: 'DEMO 2', skill: 1.02 }] }, { beforeStep: (sim) => { sim.env.slip = 0.5; } });\n  }\n  play_podium() {\n    const app = this.app;\n    this.menuClip((ui) => { ui.push(new PodiumScreen(app, { eventId: 'gp', carId: 'corsa', install: null, short: true, auto: true, next: () => { ui.pop(); ui.push(new PrizeScreen(app, { carId: 'type9', short: true, auto: true, next: () => {} })); } })); });\n    this.caption = null;\n  }\n  play_credits() { this.menuClip((ui, scene, s) => { scene.opts.title = true; scene.stage('map', { hour: 21 }); app_music(this.app, 'longDrive'); s.big = TITLE; s.lines = ['PRESS ANY BUTTON']; }); }\n}\nconst app_music = (app, id) => app.mix.music(id);\nclass AttractScreen {\n  constructor(app, owner) { this.id = 'attract'; this.app = app; this.owner = owner; this.noBack = true; this.lines = null; this.big = null; this.inputOff = true; }\n  draw(ui, dt) {\n    this.onTick?.(dt);\n    if (this.big) { const [a, b] = this.big.split(' '); ui.text(ui.cx, 60, a, { align: 'center', scale: 3, color: 'white', shadow: 'plum' }); ui.text(ui.cx, 84, b, { align: 'center', scale: 4, color: 'sand', shadow: 'plum' }); }\n    if (this.lines) { const H = this.lines.length * 10 + 6, y = ui.h - 22 - H; ui.panel(10, y, Math.min(ui.w - 20, 340), H, { color: 'ink', border: 'slate' }); this.lines.forEach((l, k) => ui.text(16, y + 4 + k * 10, l)); }\n    ui.panel(ui.cx - 22, 3, 44, 11, { color: 'ink', border: 'red' }); ui.text(ui.cx, 5, 'DEMO', { align: 'center', color: Math.floor(ui.time * 2) % 2 ? 'red' : 'white' });\n  }\n}\nvoid EVENTS;\nEOF\ncat > src/game/net/hub.js <<'EOF'\n// A hub session: ghost mode. Every copy runs its own physics; the others are stippled ghosts in seat colours with name tags.\nimport { Engine } from '../../pixel-engine.js';\nimport { RaceScene } from '../scenes/race.js';\nimport { hubSetup } from '../sim/setups.js';\nimport { TRACKS } from '../data/tracks.js';\nimport { TITLE, SEAT_COLOURS, SEAT_PAINT } from '../data/meta.js';\nimport { CAR_INFO } from '../data/cars.js';\nimport { CarView } from '../render/carview.js';\nimport { SettingsScreen } from '../ui/screens/settings.js';\nimport { HandbookScreen } from '../ui/screens/handbook.js';\nimport { drawGlyph, specFor } from '../ui/glyphs.js';\nimport { miniMap } from '../ui/screens/common.js';\nimport { safeName } from '../ui/ui.js';\nimport { BTN } from '../input/pad.js';\nimport { engineOptionsFor } from './couch.js';\nconst BUFFER = 150;\nclass Ghosts {\n  constructor(scene, info) { this.scene = scene; this.info = info; this.list = new Map(); }\n  receive(data, from, now) {\n    if (!data || data.t !== 'g') { if (data?.t === 'done') { const g = this.list.get(from); if (g) g.done = data.time; } return; }\n    let g = this.list.get(from);\n    if (!g) { const p = this.info.players.find((x) => x.id === from), scene = this.scene, carId = scene.sim.cars[0].carId, seat = p ? this.info.players.indexOf(p) : 0, view = new CarView(carId, { ghost: SEAT_PAINT[seat % 4] }); scene.ctx.scene.add(view.object); g = { view, snaps: [], name: safeName(p?.name, `P${seat + 1}`), seat, x: 0, y: 0, z: 0, s: 0, lap: 0 }; this.list.set(from, g); }\n    g.snaps.push({ at: now, x: data.x, y: data.y, z: data.z, yaw: data.yaw, v: data.v, s: data.s, lap: data.lap, steer: data.steer, br: data.br }); if (g.snaps.length > 24) g.snaps.shift();\n  }\n  remove(id) { const g = this.list.get(id); if (g) { g.view.dispose(); this.list.delete(id); } }\n  update(dt, now) {\n    for (const g of this.list.values()) {\n      const t = now - BUFFER, S = g.snaps; let a = S[0], b = S[S.length - 1]; for (let i = 0; i + 1 < S.length; i++) if (S[i].at <= t && S[i + 1].at >= t) { a = S[i]; b = S[i + 1]; break; }\n      if (!a) continue; const f = b.at > a.at ? Math.max(0, Math.min(1, (t - a.at) / (b.at - a.at))) : 0; let dy = b.yaw - a.yaw; while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI;\n      g.x = a.x + (b.x - a.x) * f; g.y = a.y + (b.y - a.y) * f; g.z = a.z + (b.z - a.z) * f; g.yaw = a.yaw + dy * f; g.s = b.s; g.lap = b.lap; g.view.update(dt, g.x, g.y, g.z, g.yaw, 0, 0, 0, 0, a.steer ?? 0, a.v ?? 0);\n    }\n  }\n  tags(ui, cam) { const P = this.scene.tagV ??= new (this.scene.cam.position.constructor)(); for (const g of this.list.values()) { P.set(g.x, g.y + 1.9, g.z).project(cam); if (P.z < 1 && P.x > -1 && P.x < 1 && P.y > -1 && P.y < 1) ui.text((P.x + 1) * 0.5 * ui.w, (1 - P.y) * 0.5 * ui.h, g.name, { align: 'center', color: SEAT_COLOURS[g.seat % 4] }); } }\n}\nclass HubMenu {\n  constructor(app, go) { this.id = 'hubMenu'; this.app = app; this.go = go; }\n  draw(ui) { const a = this.app, list = [['resume', 'BACK TO THE RACE', () => ui.pop()], ['settings', 'SETTINGS', () => ui.push(new SettingsScreen(a, { inRace: true, limited: true }))], ['handbook', 'HANDBOOK', () => ui.push(new HandbookScreen(a))]], w = 140, x = ui.cx - w / 2, y = 80; ui.panel(x - 8, y - 22, w + 16, 86, { color: 'ink', border: 'slate' }); ui.text(ui.cx, y - 16, 'THE RACE GOES ON', { align: 'center', color: 'sand' }); list.forEach(([id, l, fn], k) => ui.button(id, x, y + k * 18, w, 15, l, { confirm: fn })); ui.prompts([['confirm', 'CHOOSE'], ['back', 'BACK']]); }\n}\nexport async function startSession(app, info, container) {\n  const hub = window.AIHub, rng = hub.rng('round'), setup = hubSetup(rng, info.seed), me = info.players.findIndex((p) => p.id === info.me), player = setup.cars[0];\n  player.paint = SEAT_PAINT[Math.max(0, me) % 4];\n  let done = false, last = 0, walls = 0, card = { left: null, ready: [], asking: 0, asked: false }, started = false, ended = false, cardAnswered = null;\n  const touchOnly = !!app.touchGate;\n  const state = { get card() { return card; }, get started() { return started; } };\n  const tl = () => hub.time();\n  const opts = {\n    run: { type: 'hub' }, hideHud: false,\n    beforeStep: (sim, inputs) => { if (!started || tl() < 0 || ended) { for (const k in inputs) inputs[k] = { steer: 0, throttle: 0, brake: 0 }; } if (ended) inputs[0] = { steer: 0, throttle: 0, brake: 1 }; },\n    afterStep: (sim) => {\n      const e = sim.cars[0], t = tl();\n      if (started && sim.phase === 'grid' && t >= 0) sim.go();\n      if (sim.phase === 'grid' && started) { const lit = Math.max(0, Math.min(3, Math.floor((t + 3000) / 1000) + 1)); if (lit !== sim.lights) { sim.lights = lit; sim.events.push({ type: 'flag', kind: 'lights', n: lit }); } }\n      if (!done && e.finished && e.finishTime !== null) { done = true; const stats = { 'Best lap': e.bestLap ? +e.bestLap.toFixed(2) : 0, 'Top km/h': Math.round(e.topSpeed * 3.6), Walls: e.walls }; hub.result({ time: Math.round(tl()), stats, awards: e.walls === 0 ? [{ title: 'Clean', detail: 'No wall was touched.' }] : [] }); hub.send({ t: 'done', time: Math.round(tl()) }); }\n      walls = e.walls;\n    },\n    onFrame: (scene, ctx, dt) => {\n      const a = app.actions, sim = scene.sim, e = sim.cars[0], now = performance.now();\n      if (!scene.ghosts) { scene.ctx = ctx; scene.ghosts = new Ghosts(scene, info); for (const m of pending) scene.ghosts.receive(m[0], m[1], now); pending.length = 0; }\n      scene.ghosts.update(dt, now); scene.ghosts.tags(app.ui, scene.cam);\n      // While racing, at 10 Hz.\n      if (started && tl() >= 0 && !ended && now - last > 100) {\n        last = now; const c = e.c, R = (v, k = 100) => Math.round(v * k) / k, metres = Math.max(0, e.progress);\n        hub.send({ t: 'g', a: sim.tr.id, x: R(c.x), y: R(c.y), z: R(c.z), yaw: R(c.yaw, 1000), v: R(c.u), s: R(c.loc.s, 10), lap: e.lap, steer: R(c.delta, 100), br: (e.inp?.brake ?? 0) > 0.05 ? 1 : 0 }, { reliable: false });\n        const riders = [...scene.ghosts.list.values()], pos = 1 + riders.filter((g) => (g.lap - 1) * sim.tr.length + g.s > e.progress).length;\n        hub.progress({ score: Math.floor(metres), label: `LAP ${Math.max(1, Math.min(e.lap, sim.laps))}/${sim.laps} P${pos}` });\n      }\n      // The card: the cars lined up, each seat's colour, the map, how to win, the controls, the countdown.\n      if (!started) drawCard(app, scene, ctx, card, info, setup);\n      // Enter and the pad's Cross answer Ready; Triangle or M asks for more time.\n      if (!started) for (const pad of a.pads) { const pb = pad.prevHub ?? (scene.padPrev ??= {})[pad.i] ?? []; const P = (b) => pad.buttons[b] > 0.5 && !(pb[b] > 0.5); if (P(BTN.cross)) answer('ready'); if (P(BTN.triangle)) answer('more'); (scene.padPrev ??= {})[pad.i] = pad.buttons; }\n      if (!started && a.clicked) { const ui = app.ui; if (ui.inRect(cardRects.ready)) answer('ready'); else if (ui.inRect(cardRects.more)) answer('more'); }\n      // Options or Esc opens settings over the running race. It never pauses, and it offers no quit.\n      if (started && a.pressed('pause') && !a.create && !app.ui.top) app.ui.push(new HubMenu(app));\n      if (touchOnly && app.touchGate) { const ui = app.ui; ui.panel(ui.cx - 110, 90, 220, 26, { color: 'ink', border: 'red' }); ui.text(ui.cx, 99, 'CONTROLLER OR KEYBOARD REQUIRED', { align: 'center', color: 'sand' }); }\n      void walls; void state;\n    },\n  };\n  const pending = [], cardRects = { ready: { x: 0, y: 0, w: 0, h: 0 }, more: { x: 0, y: 0, w: 0, h: 0 } };\n  const answer = (w) => { if (cardAnswered === w && w === 'ready') return; cardAnswered = w; hub.answer(w); app.mix.sfx('confirm'); };\n  app.cardRects = cardRects;\n  const scene = new RaceScene(app, setup, opts);\n  const engine = await Engine.start(scene, { ...engineOptionsFor(container), settings: { button: false }, seed: info.seed });\n  app.bind(engine);\n  engine.audio.setVolume('music', 0.1);\n  hub.on('card', (c) => { card = c; });\n  hub.on('start', () => { started = true; cardAnswered = 'started'; });\n  hub.on('message', (data, from) => { const now = performance.now(); if (scene.ghosts) scene.ghosts.receive(data, from, now); else pending.push([data, from]); });\n  hub.on('leave', ({ id }) => scene.ghosts?.remove(id));\n  hub.on('time-up', () => { if (!done) { done = true; const e = scene.sim.cars[0]; hub.result({ score: Math.floor(Math.max(0, e.progress)), stats: { 'Best lap': e.bestLap ? +e.bestLap.toFixed(2) : 0, 'Top km/h': Math.round(e.topSpeed * 3.6), Walls: e.walls } }); } });\n  hub.on('end', () => { ended = true; app.mix.stopAll(); app.inputDead = true; });\n  window.addEventListener('keydown', (e) => { if (hub.time() !== -Infinity) return; if (e.code === 'Enter') answer('ready'); if (e.code === 'KeyM') answer('more'); });\n  hub.ready();\n  void TRACKS; void CAR_INFO; void TITLE;\n  return engine;\n}\nfunction drawCard(app, scene, ctx, card, info, setup) {\n  const ui = app.ui, w = ui.w, h = ui.h, hud = ctx.hud, sim = scene.sim, x = Math.round(ui.cx - 150), y = 18, dev = app.actions.lastDevice, xbox = app.options.glyphs === 'xbox';\n  ui.panel(x, y, 300, 196, { color: 'ink', border: 'sand' });\n  const [a, b] = TITLE.split(' '); ui.text(ui.cx, y + 6, `${a} ${b}`, { align: 'center', scale: 2, color: 'sand' });\n  ui.text(ui.cx, y + 26, `${TRACKS[setup.track].name.toUpperCase()}, ${setup.laps} LAPS, ${CAR_INFO[setup.cars[0].carId].short}`, { align: 'center' });\n  miniMap(ui, x + 8, y + 40, setup.track, 64, 'mist');\n  info.players.forEach((p, k) => { const yy = y + 42 + k * 12, ready = card.ready?.includes(p.id); ui.rect(x + 80, yy, 8, 8, SEAT_COLOURS[k % 4]); ui.text(x + 92, yy + 1, safeName(p.name, `P${k + 1}`).slice(0, 18), { color: 'white' }); ui.text(x + 292, yy + 1, ready ? 'READY' : '...', { align: 'right', color: ready ? 'lime' : 'slate' }); });\n  ui.text(x + 8, y + 112, 'LOWEST TIME WINS: SAME CAR, SAME CIRCUIT.', { color: 'sand' });\n  let gx = x + 8; for (const [act, label] of [['steer', 'STEER'], ['throttle', 'GO'], ['brake', 'BRAKE']]) { const spec = specFor(act, dev), gw = drawGlyph(hud, gx, y + 124, spec, xbox); ui.text(gx + gw + 3, y + 126, label, { color: 'mist' }); gx += gw + 3 + hud.measure(label).width + 10; }\n  const left = card.left; ui.text(ui.cx, y + 144, card.starting ? 'STARTING' : card.paused ? 'HOLDING: MORE TIME ASKED' : left !== null && left !== undefined ? `${Math.ceil(left / 1000)} S` : '', { align: 'center', scale: 1, color: 'white' });\n  const R = app.cardRects, bw = 110; R.ready = { x: ui.cx - bw - 6, y: y + 158, w: bw, h: 26 }; R.more = { x: ui.cx + 6, y: y + 158, w: bw, h: 26 };\n  ui.button('hubReady', R.ready.x, R.ready.y, bw, 26, 'READY', {}); ui.button('hubMore', R.more.x, R.more.y, bw, 26, card.asked ? 'TAKE IT BACK' : 'MORE TIME', {});\n  drawGlyph(hud, R.ready.x + 4, R.ready.y + 7, specFor('confirm', dev === 'mouse' ? 'key' : dev), xbox); drawGlyph(hud, R.more.x + 4, R.more.y + 7, specFor('more', dev === 'mouse' ? 'key' : dev), xbox);\n  void w; void h; void sim;\n}\nEOF\ncat > src/main.js <<'EOF'\n// Boots the game: a hub session if the hub opened the page, otherwise the game on its own.\n// Drive with a pad (stick, R2, L2), or WASD and arrows. The in-game Handbook lists every control.\nimport { Engine, withUrlOptions } from './pixel-engine.js';\nimport { App } from './game/app.js';\nimport { installFlows } from './game/flows.js';\nimport { MenuScene } from './game/scenes/menu.js';\nimport { RaceScene } from './game/scenes/race.js';\nimport { ReplayScene } from './game/scenes/replay.js';\nimport { Attract } from './game/attract/director.js';\nimport { MapScreen } from './game/ui/screens/map.js';\nimport { TITLE } from './game/data/meta.js';\nimport { quickSetup } from './game/sim/setups.js';\nimport { startSession } from './game/net/hub.js';\nimport { DevPanel, drawOverlays } from './game/dev/devmode.js';\nconst param = (k) => (typeof location !== 'undefined' ? new URLSearchParams(location.search).get(k) : null);\nexport const engineOptions = (container, seed = 1) => ({ container, camera: { preset: 'fixed', position: [0, 5, -10], target: [0, 1, 0], fov: 58, minZoom: 1, maxZoom: 1 }, settings: { button: false }, touch: false, seed });\nexport function makeApp(o = {}) {\n  const app = new App(o); app.Screens = { MapScreen }; installFlows(app); app.attract = new Attract(app);\n  app.jumpMenu = (id) => app.toMenu((ui) => { ui.push(new MapScreen(app)); if (id !== 'map') ui.top.open(id, ui); });\n  app.restartWith = (scene, setup) => { app.ui.clear(); const run = scene.run, opts = { run, test: scene.test, demo: scene.opts.demo, ghostData: scene.opts.ghostData }; return app.go(() => new RaceScene(app, { ...setup, seed: (setup.seed ?? 1) + 1 }, opts)); };\n  app.drawOverlays = (ui, scene) => drawOverlays(ui, app, scene);\n  return app;\n}\n/** A fresh game: `node src/check.mjs --headless src/main.js` plays one in Node. */\nexport function createGame() { return new MenuScene(makeApp({ headless: true })); }\nfunction touchOnly() { try { return !matchMedia('(any-pointer: fine)').matches && matchMedia('(pointer: coarse)').matches && !(navigator.getGamepads && [...navigator.getGamepads()].some(Boolean)); } catch { return false; } }\nfunction failMessage(msg) { const d = document.createElement('div'); d.style.cssText = 'position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#f4f4f4;background:#1a1c2c;font:bold 22px monospace;text-align:center;padding:40px'; d.textContent = `${TITLE} needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox 141 on Windows. (${msg})`; document.body.appendChild(d); }\nasync function boot() {\n  const container = document.getElementById('p1') ?? document.getElementById('app'), hub = window.AIHub;\n  // In a session the client answers first. connect() comes before anything else.\n  if (hub && hub.active) {\n    const info = await hub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n    if (info) {\n      const app = makeApp({ session: true }); window.__APP__ = app;\n      if (touchOnly()) { app.touchGate = true; window.addEventListener('keydown', () => { app.touchGate = false; }); }\n      try { await startSession(app, info, container); } catch (e) { hub.fail(String(e?.message ?? e)); failMessage(String(e?.message ?? e)); }\n      return;\n    }\n  }\n  const app = makeApp(); window.__APP__ = app;\n  const seed = +(param('seed') ?? 1), scene = param('scene');\n  if (touchOnly()) { app.touchGate = true; const lift = () => { app.touchGate = false; removeEventListener('keydown', lift); }; addEventListener('keydown', lift); addEventListener('gamepadconnected', lift); }\n  let game;\n  if (scene === 'race') { const setup = quickSetup({ track: param('track') ?? 'kestrel', carId: param('car') ?? 'ginga', laps: +(param('laps') ?? 2), field: +(param('ai') ?? 5) + 1, hour: param('hour') ? +param('hour') : undefined, rain: param('rain') === '1', assists: app.options.assists, pace: param('pace') ? +param('pace') : null, seed }); app.runAgain = () => app.startQuick({ track: setup.track, carId: param('car') ?? 'ginga', laps: setup.laps, field: setup.cars.length }); game = new RaceScene(app, setup, { run: { type: 'quick' } }); }\n  else game = new MenuScene(app, param('scene') === 'map' ? { start: (ui) => ui.push(new MapScreen(app)) } : {});\n  let engine;\n  try { engine = await Engine.start(game, withUrlOptions(engineOptions(container, seed))); }\n  catch (e) { failMessage(String(e?.message ?? e)); return; }\n  app.bind(engine);\n  if (scene === 'licence') app.startTest(param('test') ?? 'C-1');\n  if (scene === 'replay') { const s = new RaceScene(app, quickSetup({ track: param('track') ?? 'kestrel', carId: param('car') ?? 'ginga', laps: 1, field: 4, assists: app.options.assists, seed }), {}); void s; void ReplayScene; app.ui.note('RACE A LAP, THEN WATCH IT IN THE THEATRE.'); }\n  if (param('attract') === '1') app.attract.start();\n  if (param('dev') === '1') app.ui.push(new DevPanel(app, app.scene?.sim ? app.scene : null));\n}\nif (typeof document !== 'undefined') boot();\nEOF\npython3 - <<'EOF'\np='src/game/scenes/race.js'; s=open(p).read()\na=\"    this.opts.drawExtra?.(this, ui, dt);\\n\"\nb=\"    this.opts.drawExtra?.(this, ui, dt);\\n    if (this.app.dev) this.app.drawOverlays?.(ui, this);\\n\"\nassert a in s; s=s.replace(a,b)\n# Attract clips must not finish into career flows\na=\"    if (this.ended) return;\\n\"\nb=\"    if (this.ended || this.opts.attract) return;\\n\"\nassert a in s; s=s.replace(a,b)\nopen(p,'w').write(s)\np='src/game/sim/licence.js'; s=open(p).read()\na=\"  get total() { return this.time + this.penalty; }\"\nb=\"  get total() { return this.time + this.penalty; }\\n  get totalWithBase() { return this.total + (this.base ?? 0); }\"\nassert a in s; s=s.replace(a,b); open(p,'w').write(s)\nEOF\necho 'export const INTERVIEW = null; export const KIT_CREDITS = \"\";' > src/game/data/about.gen.js\ncat > tools/tests/data.mjs <<'EOF'\n// Every id resolves; restrictions are satisfiable; every test has medals; all text fits the 60-character line and 4-line card.\nimport { suite } from './_lib.mjs';\nimport { CAR_IDS, CAR_INFO, MARQUES, PHYSICS, SHOWROOMS } from '../../src/game/data/cars.js';\nimport { TRACKS } from '../../src/game/data/tracks.js';\nimport { EVENTS, EVENT_IDS, AI_TUNES } from '../../src/game/data/events.js';\nimport { LICENCES, TESTS, TEST_IDS } from '../../src/game/data/licences.js';\nimport { PARTS, PART_IDS, SETUP_SLIDERS, TILES } from '../../src/game/data/parts.js';\nimport { TYRES } from '../../src/game/data/tyres.js';\nimport { HANDBOOK, LINES, MAP_PLACES, SPEAKERS, TIPS } from '../../src/game/data/text.js';\nimport { SONGS } from '../../src/game/data/songs.js';\nimport { SFX } from '../../src/game/audio/sfx.js';\nimport { CAR_MODELS } from '../../src/game/models/cars.js';\nimport { BUILDING_DEFS } from '../../src/game/models/buildings.js';\nimport { checkModel, analyzeClip, HERO_RIG } from '../../src/pixel-engine.js';\nimport { GAME_CLIPS } from '../../src/game/models/clips.js';\nimport { eligible } from '../../src/game/sim/career.js';\nimport { fullInstall, specOf } from '../../src/game/sim/tuning.js';\nconst t = suite();\nt.eq(CAR_IDS.length, 14, 'fourteen cars');\nfor (const id of CAR_IDS) {\n  const i = CAR_INFO[id];\n  t.ok(PHYSICS[id], `${id} has a physics row`); t.ok(MARQUES[i.marque], `${id} has a marque`); t.ok(CAR_MODELS[id], `${id} has a model`);\n  t.ok(Array.isArray(i.text) && i.text.length <= 4, `${id} brochure is at most 4 lines`);\n  for (const l of i.text) t.ok(l.length <= 60, `${id} brochure line too long: ${l}`);\n  t.ok(i.fenn, `${id} has a line from Mr. Fenn`);\n  const r = checkModel(CAR_MODELS[id].def); t.eq(r.problems.length, 0, `${id} model has problems: ${r.problems.join('; ')}`);\n}\nfor (const [id, d] of Object.entries(BUILDING_DEFS)) t.eq(checkModel(d).problems.length, 0, `building ${id}: ${checkModel(d).problems.join('; ')}`);\nt.eq(new Set(CAR_IDS.map((id) => PHYSICS[id].layout)).size, 5, 'all five layouts');\nfor (const s of SHOWROOMS) for (const c of s.cars) t.ok(CAR_INFO[c], `${s.id} lists a real car`);\nt.ok(SHOWROOMS[0].cars.every((c) => CAR_INFO[c].price <= 15000), 'every used car is affordable from the start');\nfor (const id of EVENT_IDS) {\n  const e = EVENTS[id];\n  for (const r of e.rounds) t.ok(TRACKS[r.track], `${id} round ${r.track} resolves`);\n  for (const p of e.pool) { const [c, tune] = Array.isArray(p) ? p : [p]; t.ok(CAR_INFO[c], `${id} pool ${c}`); if (tune) t.ok(AI_TUNES[tune], `${id} tune ${tune}`); }\n  if (e.prizeCar) t.ok(CAR_INFO[e.prizeCar], `${id} prize car`);\n  for (const l of e.needs) t.ok(LICENCES[l], `${id} needs ${l}`);\n  // Winnable with a car obtainable by then: at least one buyable or prize car qualifies, stock.\n  t.ok(CAR_IDS.some((c) => eligible(e, c, null).ok && (CAR_INFO[c].price > 0 || c !== e.prizeCar)), `${id} has a qualifying car`);\n  t.ok(e.intro.length <= 120, `${id} intro fits`);\n}\nt.ok(eligible(EVENTS.dawn, 'kite', null).ok, 'the Kite qualifies for the Dawn Patrol Cup');\nt.ok(!eligible(EVENTS.fellow, 'ginga', null).ok, 'the Ginga is refused by the Front-Drive Fellowship');\nt.ok(eligible(EVENTS.feather, 'moth', null).ok, 'the Moth qualifies for the Featherweight');\nt.ok(!eligible(EVENTS.dawn, 'kite', fullInstall(['stage3', 'intake'])).ok, 'a tuned Kite can exceed the limit');\nfor (const id of TEST_IDS) {\n  const T = TESTS[id]; t.ok(T.medals && T.medals.gold < T.medals.silver && T.medals.silver < T.medals.bronze, `${id} has ordered medals`);\n  t.ok(CAR_INFO[T.carId], `${id} car`); t.ok(TRACKS[T.track], `${id} track`); for (const l of T.brief) t.ok(l.length <= 60, `${id} brief line too long: ${l}`); t.ok(T.brief.length <= 4, `${id} brief fits a card`); t.ok(T.tip.length <= 80, `${id} tip`);\n}\nfor (const l of Object.values(LICENCES)) { t.eq(l.tests.length, 4, `${l.id} has four tests`); for (const x of l.tests) t.ok(TESTS[x], `${l.id} test ${x}`); }\nfor (const id of PART_IDS) { t.ok(TILES.some((x) => x.id === PARTS[id].cat), `${id} has a tile`); t.ok(PARTS[id].line.length <= 60, `${id} line fits`); t.ok(PARTS[id].price > 0, `${id} has a price`); }\nfor (const s of SETUP_SLIDERS) for (const n of s.needs) t.ok(PARTS[n], `${s.id} needs ${n}`);\nfor (const k of Object.keys(TYRES)) t.ok(TYRES[k].line.length <= 60, `${k} tyre line fits`);\nfor (const p of HANDBOOK) { for (const l of p.lines ?? []) t.ok(l.length <= 60, `handbook line too long: ${l}`); t.ok((p.lines ?? []).length <= 4, `${p.title} fits`); }\nfor (const l of TIPS) t.ok(l.length <= 90, `tip fits: ${l}`);\nfor (const m of MAP_PLACES) { t.ok(m.blurb.length <= 60, `${m.id} blurb`); }\nt.eq(MAP_PLACES.length, 9, 'nine places on the map');\nfor (const s of Object.values(LINES)) for (const l of Object.values(s)) for (const x of [].concat(l)) t.ok(/^[A-Z0-9 .,:;!?'\"()\\-+/%#=<>{}]*$/.test(x), `line uses the font: ${x}`);\nt.eq(Object.keys(SPEAKERS).length, 4, 'four speakers');\n// Songs: every track in a pattern has the same step count; only allowed waves; at least eight pieces.\nt.ok(Object.keys(SONGS).length >= 9, 'eight pieces and a fanfare');\nfor (const [id, s] of Object.entries(SONGS)) { for (const tk of Object.values(s.tracks)) t.ok(['square', 'triangle', 'saw', 'sine', 'noise'].includes(tk.wave), `${id} wave`); for (const [pn, p] of Object.entries(s.patterns)) { const counts = Object.entries(p).map(([k, v]) => [k, v.trim().split(/\\s+/).length]), n = counts[0][1]; for (const [k, c] of counts) t.eq(c, n, `${id}/${pn}/${k} steps`); t.ok(n % 16 === 0 || id === 'fanfare', `${id}/${pn} whole bars`); for (const k of Object.keys(p)) t.ok(s.tracks[k], `${id}/${pn}/${k} has an instrument`); } for (const o of s.order) t.ok(s.patterns[o], `${id} order ${o}`); }\nfor (const v of Object.values(SFX)) t.ok(v.wave, 'sound has a wave');\n// New clips pass the engine's own analysis.\nfor (const c of GAME_CLIPS) { const r = analyzeClip(c, HERO_RIG); t.eq(r.problems.length, 0, `clip ${c.name}: ${r.problems.join('; ')}`); }\nvoid specOf;\nt.done();\nEOF\ncat > tools/tests/career.mjs <<'EOF'\n// Money, licences, unlocks, prizes, oil, days. A save survives a version migration.\nimport { suite } from './_lib.mjs';\nimport * as C from '../../src/game/sim/career.js';\nimport { oilFactor, specOf, tunedParams, fullInstall } from '../../src/game/sim/tuning.js';\nimport { EVENTS, POINTS } from '../../src/game/data/events.js';\nimport { LICENCES, TESTS } from '../../src/game/data/licences.js';\nimport { SAVE_VERSION, START_CREDITS } from '../../src/game/data/meta.js';\nconst t = suite();\nlet p = C.newProfile();\nt.eq(p.credits, START_CREDITS, 'starts with 15,000');\nt.ok(!C.buyCar(p, 'moth').ok, 'cannot afford the Moth');\nt.ok(C.buyCar(p, 'kite').ok, 'buys the Kite'); t.eq(p.credits, 2500, 'pays for the Kite'); t.eq(C.carEntry(p).carId, 'kite', 'Kite is current');\nt.ok(!C.buyCar(p, 'works').ok, 'the Works is closed before Licence A');\nt.eq(C.sellCar(p, C.carEntry(p).uid).why, 'last', 'cannot sell the last car');\n// Parts\nconst car = C.carEntry(p);\nt.ok(C.buyPart(p, car, 'exhaust').ok, 'buys an exhaust'); t.eq(p.credits, 1600, 'pays 900'); t.ok(tunedParams('kite', car.install).powerPS > 148 * 1.03, 'an exhaust adds power');\nt.eq(C.buyPart(p, car, 'exhaust').why, 'owned', 'cannot buy it twice');\np.credits = 50000; C.buyPart(p, car, 'stage1'); C.buyPart(p, car, 'stage3'); t.ok(car.install.on.stage === 'stage3' && car.install.owned.includes('stage1'), 'exclusive group keeps one on'); C.buyPart(p, car, 'stage1'); t.eq(car.install.on.stage, 'stage1', 'an owned part swaps for free');\nconst mass = tunedParams('kite', car.install).mass; C.buyPart(p, car, 'weight2'); t.ok(tunedParams('kite', car.install).mass < mass, 'weight stage lowers mass');\nC.buyPart(p, car, 'aeroWing'); t.ok(tunedParams('kite', car.install).clA > 0.5, 'a wing adds downforce'); C.setSetup(car, 'downforce', 1.5); t.ok(tunedParams('kite', car.install).clA > 0.75, 'the downforce slider works');\nC.buyTyre(p, car, 'slick'); t.ok(tunedParams('kite', car.install).tyreMu === 1.3 && tunedParams('kite', car.install).wearX === 2.2, 'tyres replace the stock row');\nC.buyPaint(p, car, 'blue'); t.eq(car.install.paint, 'blue', 'paint'); C.buyRims(p, car, 2); t.eq(car.install.rims, 2, 'rims');\n// Oil\nt.near(oilFactor(50, true), 1.02, 1e-9, 'fresh oil gives 2%'); t.near(oilFactor(150, true), 1, 1e-9, 'level after 100 km'); t.near(oilFactor(280), 0.99, 1e-9, '0.5% per 40 km past 200'); t.near(oilFactor(5000), 0.92, 1e-9, 'never worse than -8%');\nconst c2 = C.carEntry(p); c2.kmOil = 500; const before = p.credits; t.ok(C.changeOil(p, c2).ok, 'oil change'); t.eq(p.credits, before - C.OIL_PRICE, 'oil costs 250'); t.eq(c2.kmOil, 0, 'oil is fresh');\nc2.dirt = 0.5; C.washCar(p, c2); t.eq(c2.dirt, 0, 'a wash removes mud');\nC.driveCar(p, c2, 10000, 5000); t.near(c2.km, 10, 1e-6, 'km counted'); t.ok(c2.dirt > 0, 'dirt builds up');\n// Licences\nconst q = C.newProfile(); C.addCar(q, 'kite');\nfor (const [i, id] of LICENCES.C.tests.entries()) { const r = C.recordTest(q, id, TESTS[id].medals.gold - 0.01); t.eq(r.medal, 'gold', `${id} gold`); if (i === 3) { t.ok(r.licenceWon, 'Licence C is won on the fourth test'); t.eq(r.reward, 2000, 'reward 2000'); t.ok(r.allGold && r.prizeCar === 'pico', 'all gold gives the Pico'); } }\nt.ok(q.licences.C, 'holds C'); t.ok(C.licenceOpen(q, 'B'), 'opens B'); t.ok(!C.licenceOpen(q, 'A'), 'A stays closed');\nt.eq(C.medalFor(TESTS['C-1'], TESTS['C-1'].medals.bronze + 1), null, 'too slow is no medal');\nconst f = C.newProfile(); t.eq(C.recordFailure(f, 'C-1'), 1, 'failures count'); C.recordFailure(f, 'C-1'); C.recordFailure(f, 'C-1'); t.eq(f.tests['C-1'].fails, 3, 'three failures offer the line');\n// Events\nconst e = C.newProfile(); C.addCar(e, 'kite'); t.ok(!C.eventOpen(e, 'dawn').ok, 'needs a licence'); e.licences.C = true; t.ok(C.eventOpen(e, 'dawn').ok, 'opens with C'); t.ok(!C.eventOpen(e, 'gp').ok, 'GP is closed');\nconst roster = C.eventRoster('dawn'); t.eq(roster.length, 5, 'field of six'); t.ok(roster[0].skill <= roster[4].skill, 'slowest at the front');\nconst names = ['YOU', ...roster.map((r) => r.name)]; let cash = e.credits, day = e.day;\nlet r = C.recordRound(e, 'dawn', names, 'YOU'); t.eq(r.prize, 1500, 'first prize'); t.eq(r.points, POINTS[0], '10 points'); t.eq(e.credits, cash + 1500, 'paid'); t.eq(e.day, day + 1, 'a race advances the day'); t.ok(!r.seriesDone, 'series continues');\nr = C.recordRound(e, 'dawn', [...names.slice(1), 'YOU'], 'YOU'); t.eq(r.prize, 0, 'last pays nothing');\nr = C.recordRound(e, 'dawn', names, 'YOU'); t.ok(r.seriesDone, 'series ends'); t.ok(r.seriesWon, 'most points wins'); t.eq(r.bonus, 3000, 'series bonus');\nt.ok(e.events.dawn.won, 'marked won'); t.ok(e.trophies.some((x) => x.kind === 'cup'), 'a cup on the shelf'); t.eq(e.events.dawn.round, 0, 'can run it again');\nconst again = C.recordRound(e, 'dawn', names, 'YOU'); void again; for (let i = 0; i < 2; i++) r = C.recordRound(e, 'dawn', names, 'YOU'); t.eq(r.bonus, 0, 'no second bonus');\n// Rally: the clock decides by legs.\nconst ra = C.newProfile(); ra.licences.B = true; let rr; for (const order of [['YOU', 'A'], ['B', 'YOU'], ['YOU', 'C']]) rr = C.recordRound(ra, 'clay', order, 'YOU'); t.ok(rr.seriesWon && rr.prizeCar === 'ryuRally', 'two legs of three wins the rally');\nconst rb = C.newProfile(); for (const order of [['A', 'YOU'], ['B', 'YOU'], ['YOU', 'C']]) rr = C.recordRound(rb, 'clay', order, 'YOU'); t.ok(!rr.seriesWon, 'one leg of three does not');\n// Prize cars cannot be sold; selling pays half.\nconst s = C.newProfile(); C.addCar(s, 'kite'); C.addCar(s, 'ginga'); const pz = C.addCar(s, 'type9', { prize: true }); t.eq(C.sellCar(s, pz.uid).why, 'prize', 'a prize car cannot be sold'); const cc = s.credits; t.ok(C.sellCar(s, s.cars[0].uid).ok, 'sells'); t.eq(s.credits, cc + 6250, 'half the price');\n// GP\nconst g = C.newProfile(); g.licences.A = true; t.ok(!C.eventOpen(g, 'gp').ok, 'GP needs a win'); g.events.h200 = { won: true }; t.ok(C.eventOpen(g, 'gp').ok, 'H200 opens the GP'); for (let i = 0; i < 4; i++) r = C.recordRound(g, 'gp', ['YOU', 'A'], 'YOU'); t.ok(r.ending && g.ended && r.prizeCar === 'type9', 'winning the GP ends the game with the Type 9');\n// Migration\nconst old = { version: 1, credits: 777, cars: [{ uid: 1, carId: 'kite', install: { owned: ['exhaust'] }, km: 12, kmOil: 12 }], licences: {}, events: {}, trophies: [], tests: {}, stats: { km: 12, wins: 0, gold: 0, races: 1 }, current: 1, nextUid: 2, day: 3, records: {} };\nconst m = C.migrate(JSON.parse(JSON.stringify(old))); t.eq(m.version, SAVE_VERSION, 'migrates to the current version'); t.eq(m.credits, 777, 'keeps money'); t.ok(Array.isArray(m.replays) && m.ghosts, 'adds replay slots and ghosts'); t.ok(m.cars[0].install.tyres && m.cars[0].install.owned[0] === 'exhaust', 'fills in installs'); t.ok(tunedParams('kite', m.cars[0].install).powerPS > 148, 'a migrated car still drives');\nt.eq(C.migrate(null).credits, START_CREDITS, 'garbage becomes a new profile');\nt.eq(C.nudge(C.newProfile()).to, 'dealer', 'the first nudge is to the dealer');\nconst n2 = C.newProfile(); C.addCar(n2, 'kite'); t.eq(C.nudge(n2).to, 'licence', 'then the licence centre');\nvoid specOf; void fullInstall; void EVENTS;\nt.done();\nEOF\nnode tools/test.mjs data career 2>&1 | tail -30","description":"Write dev mode, attract, hub, boot, data and career suites, run them","timeout":120000}}}
