r each browser run'),\n};\nconst rows = []; let fails = 0, reqs = 0;\nfor (let n = 1; n <= 860; n++) {\n  const line = plan[n - 1];\n  if (!(/^\\|/.test(line) || /^- /.test(line) || /^[0-9]+\\. /.test(line)) || /^\\| ---/.test(line)) continue;\n  reqs++; const ev = E[n]; let ok = true, kinds = [];\n  if (!ev) { ok = false; kinds.push('NO EVIDENCE'); }\n  else for (const part of ev.split('|')) {\n    const [k, ...rest] = part.split(':'), arg = rest.join(':');\n    if (k === 't') { const hit = tests.includes(arg); ok &&= hit; kinds.push(hit ? `test: ${arg}` : `MISSING test: ${arg}`); }\n    else if (k === 'c') { const hit = code.includes(arg); ok &&= hit; kinds.push(hit ? `code: ${arg}` : `MISSING code: ${arg}`); }\n    else if (k === 'f') { const hit = existsSync(arg); ok &&= hit; kinds.push(hit ? `file: ${arg}` : `MISSING file: ${arg}`); }\n    else if (k === 'i') kinds.push(`not a requirement: ${arg}`);\n    else if (k === 'g') { const hit = !/TODO|FIXME|placeholder|\\bstub\\b|coming soon/i.test(read(walk('src/game'))); ok &&= hit; kinds.push(hit ? 'grep: none in the game' : 'GREP FOUND ONE'); }\n    else if (k === 'd') {\n      let hit = true;\n      if (arg === 'tracks') hit = Object.keys(TRACKS).length === 6;\n      else if (arg === 'paint') hit = PAINT_PRICE === 500; else if (arg === 'rims') hit = RIM_PRICE === 300;\n      else if (arg.startsWith('line:')) hit = dLine(+arg.slice(5));\n      else { try { hit = !!fn(arg, n); } catch (e) { hit = false; kinds.push(`error ${e.message}`); } }\n      ok &&= hit; kinds.push(hit ? `data matches the plan (${arg})` : `DATA DIFFERS (${arg})`);\n    }\n  }\n  if (!ok) fails++;\n  rows.push({ n, ok, text: line.replace(/^\\| /, '').slice(0, 62).replace(/\\|/g, '/'), ev: kinds.join('; ') });\n}\nconst dev = rows.filter((r) => /not a requirement/.test(r.ev)).length;\nconst md = ['# PLAN.md audit', '', 'Written by `node tools/audit.mjs`. Every table row, bullet and numbered item in PLAN.md sections 1 to 18, with its evidence. \"test\" names a check in `tools/tests`; `node tools/test.mjs` proves those pass. \"data\" compares the plan\\'s numbers or words with the game\\'s data. Appendices A to C are the code those sections use: the sim suite covers them.', '', `Lines: ${reqs}. Failing: ${fails}. Not requirements on the game (headers, notes, reported facts): ${dev}.`, '', '| Line | | PLAN.md | Evidence |', '| --- | --- | --- | --- |', ...rows.map((r) => `| ${r.n} | ${r.ok ? 'ok' : '**FAIL**'} | ${r.text} | ${r.ev.replace(/\\|/g, '/')} |`)];\nwriteFileSync('docs/plan-audit.md', md.join('\\n') + '\\n');\nfor (const r of rows.filter((x) => !x.ok)) console.log(`FAIL line ${r.n}: ${r.text} :: ${r.ev}`);\nconsole.log(`audit: ${reqs} lines, ${fails} failing, ${dev} not requirements on the game`);\nprocess.exit(fails ? 1 : 0);\nEOF\nnode tools/audit.mjs 2>&1 | tail -50 | cut -c1-240","description":"Write the line-by-line plan audit tool and run it","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4891,"cache_read_input_tokens":885351,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4891},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"1b92e9b8-9b04-4ac8-94b6-22855d39259b","timestamp":"2026-11-06T03:58:53.198Z","request_id":"req_011Cgm15GGPjwQKveiKDfXir","wire_tool_inputs":{"toolu_01FnfJ8kpkv1vcviDvMPHyYo":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-171904__x89353d/work/GranTumbleweed-GranTurismo3ASpec-claude-opus-5-5-xhigh-20261105-171904; sed -i 's/^const CLIPS = \\[/export const CLIPS = [/' src/game/attract/director.js; cat > tools/audit.mjs <<'EOF'\n// node tools/audit.mjs: every requirement-bearing line of PLAN.md, with its evidence. A line with no evidence is a failure.\n// t: a named check in tools/tests (the suites prove it passes). c: code present in the game. f: a file. d: the plan's numbers or words compared with the game's data.\n// i: not a requirement on the game (a fact the plan reports, a table header, a note for the builder), with the reason.\nimport { existsSync, readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs';\nimport { join, resolve, dirname, basename } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nconst root = resolve(dirname(fileURLToPath(import.meta.url)), '..'); process.chdir(root);\nconst plan = readFileSync('../PLAN.md', 'utf8').split('\\n');\nconst walk = (p) => (statSync(p).isFile() ? [p] : readdirSync(p).flatMap((n) => walk(join(p, n))));\nconst read = (l) => l.map((f) => readFileSync(f, 'utf8')).join('\\n');\nconst code = read([...walk('src/game'), 'src/main.js', 'tools/build.mjs', 'tools/hub-metas.html', 'tools/test.mjs', 'tools/medals.mjs']), tests = read(walk('tools/tests'));\nconst { CAR_INFO, PHYSICS } = await import('../src/game/data/cars.js');\nconst { TYRES } = await import('../src/game/data/tyres.js');\nconst { PARTS, PAINT_PRICE, RIM_PRICE, SETUP_SLIDERS } = await import('../src/game/data/parts.js');\nconst { EVENTS } = await import('../src/game/data/events.js');\nconst { TESTS, LICENCES } = await import('../src/game/data/licences.js');\nconst { SONGS } = await import('../src/game/data/songs.js');\nconst { SPEAKERS, LINES, TIPS, MAP_PLACES, ENDING_LINES, PRIZE_SELL } = await import('../src/game/data/text.js');\nconst { SLIDERS } = await import('../src/game/dev/devmode.js');\nconst { CLIPS } = await import('../src/game/attract/director.js');\nconst { GAME_CLIPS } = await import('../src/game/models/clips.js');\nconst { TRACKS } = await import('../src/game/data/tracks.js');\nconst num = (s) => Number(String(s).replace(/[,×]/g, ''));\nconst cells = (n) => plan[n - 1].split('|').slice(1, -1).map((x) => x.trim());\nconst up = (s) => s.toUpperCase().replace(/[“”]/g, '\"').replace(/\\s+/g, ' ').trim();\nconst allText = up(JSON.stringify([LINES, TIPS, MAP_PLACES, ENDING_LINES, PRIZE_SELL])) + up(code);\nconst CARROW = { 256: 'pico', 257: 'kite', 258: 'ginga', 259: 'moth', 260: 'ryu', 261: 'longhorn', 262: 'brandt32', 263: 'heck', 264: 'libeccio', 265: 'kiteCup', 266: 'ryuRally', 267: 'works', 268: 'corsa', 269: 'type9' };\nconst dCar = (n) => { const id = CARROW[n], c = cells(n), i = CAR_INFO[id], p = PHYSICS[id], price = /^[\\d,]+$/.test(c[6]) ? num(c[6]) : (/([\\d,]{5,}) after/.exec(c[6]) ? num(/([\\d,]{5,}) after/.exec(c[6])[1]) : 0); return i.year === +c[2] && p.powerPS === num(c[4]) && p.massKg === num(c[5]) && i.price === price && p.layout === c[3].split(' ')[0] && (!/turbo/.test(c[3]) || p.turbo === true) && up(i.name).includes(up(c[1]).split(' ').pop()); };\nconst TY = { 281: 'street', 282: 'sport', 283: 'semi', 284: 'slick', 285: 'rally' };\nconst dTyre = (n) => { const t = TYRES[TY[n]], c = cells(n); return t.tyreMu === +c[1] && t.alphaP === +c[2] && t.dirt === +c[3] && t.wearX === +c[4] && t.price === num(c[5].split(' ')[0]); };\nconst PR = { 295: ['exhaust'], 296: ['intake'], 297: ['stage1', 'stage2', 'stage3'], 298: ['turbo1', 'turbo2'], 299: ['weight1', 'weight2', 'weight3'], 300: ['clutch'], 301: ['gearbox'], 302: ['lsd'], 303: ['suspSport'], 304: ['suspRace'], 305: ['brakeSport'], 306: ['brakeRace'], 307: ['aeroStreet'], 308: ['aeroWing'] };\nconst dPart = (n) => { const prices = cells(n)[3].split(',').map((x) => x.trim()).join(' ').replace(/(\\d) (\\d{3})/g, '$1$2').split(/\\s+/).map(num); return PR[n].every((id, k) => PARTS[id].price === prices[k]); };\nconst BRO = { 605: 'pico', 606: 'kite', 607: 'ginga', 608: 'moth', 609: 'ryu', 610: 'longhorn', 611: 'brandt32', 612: 'heck', 613: 'libeccio', 614: 'kiteCup', 615: 'ryuRally', 616: 'works', 617: 'corsa', 618: 'type9' };\nconst dBro = (n) => up(CAR_INFO[BRO[n]].text.join(' ')) === up(cells(n)[1]);\nconst dLine = (n) => { const quotes = [...plan[n - 1].matchAll(/\"([^\"]+)\"/g)].map((m) => up(m[1])); return quotes.length > 0 && quotes.every((q) => allText.includes(q)); };\nconst EV = { 361: 'dawn', 362: 'fellow', 363: 'feather', 364: 'society', 365: 'clay', 366: 'touring', 367: 'h200', 368: 'gp' };\nconst dEvent = (n) => { const e = EVENTS[EV[n]], c = cells(n), bonus = /([\\d,]{5,})/.exec(c[8])?.[1]; return e.prize === num(c[7]) && (bonus ? num(bonus) : 0) === e.bonus && (c[8].match(/Kite Cup|Ryu Rally|Corsa|Works|Type 9/) ? up(CAR_INFO[e.prizeCar].name).includes(up(c[8].match(/Kite Cup|Ryu Rally|Corsa|Works|Type 9/)[0])) || (c[8].includes('Works') && e.prizeCar === 'works') : !e.prizeCar) && e.needs[0] === c[2][0]; };\nconst SO = { 571: 'lounge', 572: 'catalogue', 573: 'socket', 574: 'exam', 575: 'apex', 576: 'city', 577: 'clay', 578: 'longDrive' };\nconst dSong = (n) => SONGS[SO[n]].bpm === num(cells(n)[3]);\nconst SP = { 588: 'arai', 589: 'benno', 590: 'fenn', 591: 'dell' };\nconst dSpeak = (n) => SPEAKERS[SP[n]].pitch === parseInt(cells(n)[1], 10);\nconst CL = { 643: 0, 644: 1, 645: 2, 646: 3, 647: 4, 648: 5, 649: 6, 650: 7, 651: 8, 652: 9 };\nconst dClip = (n) => CLIPS[CL[n]].seconds === num(cells(n)[3]);\nconst SL = { 666: 'gripScale', 667: 'powerScale', 668: 'brakeScale', 669: 'aeroScale', 670: 'wearScale', 671: 'fuelScale', 672: 'steerRate', 673: 'stability', 674: 'traction', 676: 'rubber', 677: 'wallLoss', 678: 'slip', 679: 'prize' };\nconst dSlider = (n) => { const s = SLIDERS.find((x) => x.id === SL[n]), c = cells(n), [a, b] = c[2].split('–').map(Number); return s.def === +c[1] && s.min === a && s.max === b; };\nconst CLIPN = { 520: 'PitJack', 521: 'PitWheelGun', 522: 'PitFuel', 523: 'MarshalFlag', 524: 'ExaminerClipboard', 525: 'DealerPresent', 526: 'MechanicWipe', 527: 'PodiumCheer', 528: 'CrowdCheer' };\nconst dClipDef = (n) => !!GAME_CLIPS.find((c) => c.name === CLIPN[n]) && code.includes(`'${CLIPN[n]}'`) && code.split(`'${CLIPN[n]}'`).length > 2;\nconst TEST = { 330: 'C-1', 331: 'C-2', 332: 'C-3', 333: 'C-4', 339: 'B-1', 340: 'B-2', 341: 'B-3', 342: 'B-4', 348: 'A-1', 349: 'A-2', 350: 'A-3', 351: 'A-4' };\nconst dTest = (n) => { const t = TESTS[TEST[n]], c = cells(n); return up(t.title) === up(c[1]) && !!t.medals && (n < 346 || up(CAR_INFO[t.carId].name).includes(up(c[2]).split(' ')[0])) && t.lesson && LICENCES[t.licence].tests.includes(t.id); };\nconst dTestDetail = { 330: (t) => t.standing && t.box.s === 400 && t.box.len === 30, 331: (t) => t.startSpeed === 60 && t.start.c === 0 && t.start.off === -100 && t.end.c === 1 && t.end.off === 100, 332: (t) => t.startSpeed === 50 && t.cones.count === 6 && t.cones.spacing === 40, 333: (t) => t.start.c === 2 && t.start.off === -50 && t.end.c === 6 && t.end.off === 50, 339: (t) => t.startSpeed === 160 && t.assists.abs === false && t.box.s - t.start.s === 150, 340: (t) => t.track === 'kestrel' && t.start.c === 5 && t.start.off === -150 && t.end.c === 7 && t.end.off === 60 && t.assists.tcs === 0, 341: (t) => t.legs.join() === 'kite,ginga,ryu' && t.start.c === 7 && t.end.c === 10, 342: (t) => t.kind === 'lap' && t.track === 'kestrel', 348: (t) => t.track === 'cedar' && t.start.c === 3 && t.start.off === -100 && t.end.c === 5 && t.end.off === 100, 349: (t) => t.track === 'cedar' && t.start.c === 7 && t.end.c === 10, 350: (t) => t.track === 'redclay' && t.start.c === 7 && t.end.c === 10, 351: (t) => t.track === 'harbour' && t.kind === 'lap' && t.noMargin };\nconst fn = (name, n) => ({ car: dCar, tyre: dTyre, part: dPart, bro: dBro, line: dLine, event: dEvent, song: dSong, speak: dSpeak, clip: dClip, slider: dSlider, clipdef: dClipDef, test: (k) => dTest(k) && dTestDetail[k](TESTS[TEST[k]]) }[name](n));\nconst I = (r) => `i:${r}`;\nconst E = {\n  21: I('table header'), 23: 'c:cyl: 3|t:all five layouts', 24: 't:all gold gives the Pico', 25: 't:buys the Kite|t:pays for weight stage 1', 26: 't:nine buildings on the Map', 27: 'c:class TvDirector|t:triangle changes camera',