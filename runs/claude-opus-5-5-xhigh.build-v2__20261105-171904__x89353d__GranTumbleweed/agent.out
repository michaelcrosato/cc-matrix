{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkk7darJCLB6CABuMYJh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01732DZFnJrFLiTQ28bgSQNc","name":"Bash","input":{"command":"grep -n 'type Wave\\b' -A 4 src/API.md | cut -c1-200; cat > src/game/ui/glyphs.js <<'EOF'\n// Button glyphs as pixel sprites. PlayStation and Xbox sets, keycaps and mouse icons. prompt() picks by the last device used.\nconst SHAPE = {\n  cross: ['.........', '.x.....x.', '..x...x..', '...x.x...', '....x....', '...x.x...', '..x...x..', '.x.....x.', '.........'],\n  circle: ['.........', '...xxx...', '..x...x..', '.x.....x.', '.x.....x.', '.x.....x.', '..x...x..', '...xxx...', '.........'],\n  square: ['.........', '.xxxxxxx.', '.x.....x.', '.x.....x.', '.x.....x.', '.x.....x.', '.x.....x.', '.xxxxxxx.', '.........'],\n  triangle: ['.........', '....x....', '....x....', '...x.x...', '...x.x...', '..x...x..', '..x...x..', '.xxxxxxx.', '.........'],\n};\nconst COLOURS = { cross: 'sky', circle: 'red', square: 'orange', triangle: 'lime' };\nconst XBOX = { cross: ['A', 'lime'], circle: ['B', 'red'], square: ['X', 'sky'], triangle: ['Y', 'sand'] };\nconst DISC = ['...xxxxx...', '..xxxxxxx..', '.xxxxxxxxx.', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', '.xxxxxxxxx.', '..xxxxxxx..', '...xxxxx...'];\nconst DPAD = ['....xxx....', '....xxx....', '....xxx....', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', '....xxx....', '....xxx....', '....xxx....'];\nconst STICK = ['...xxxxx...', '..x.....x..', '.x..xxx..x.', 'x..xxxxx..x', 'x..xxxxx..x', 'x..xxxxx..x', '.x..xxx..x.', '..x.....x..', '...xxxxx...'];\nconst MOUSE_L = ['..xxxxx..', '.xoox.xx.', '.xoox.xx.', '.xoox.xx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '..xxxxx..'];\nconst MOUSE_R = ['..xxxxx..', '.xx.xoox.', '.xx.xoox.', '.xx.xoox.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '..xxxxx..'];\nconst MOUSE_W = ['..xxxxx..', '.xx.o.xx.', '.xx.o.xx.', '.xx.o.xx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '..xxxxx..'];\n// Every prompt action: what it shows on each device.\nexport const ACTION_GLYPHS = {\n  confirm: { pad: 'cross', key: 'ENTER', mouse: 'lmb' }, back: { pad: 'circle', key: 'ESC', mouse: 'rmb' }, alt: { pad: 'square', key: 'T', mouse: 'key:T' }, info: { pad: 'triangle', key: 'I', mouse: 'key:I' },\n  tabL: { pad: 'L1', key: 'Q', mouse: 'key:Q' }, tabR: { pad: 'R1', key: 'E', mouse: 'key:E' }, tabs: { pad: 'L1 R1', key: 'Q E', mouse: 'key:Q E' },\n  move: { pad: 'dpad', key: 'ARROWS', mouse: 'mouse' }, moveX: { pad: 'dpad', key: '< >', mouse: 'wheel' }, wheel: { pad: 'dpad', key: '< >', mouse: 'wheel' },\n  pause: { pad: 'options', key: 'ESC', mouse: 'key:ESC' }, steer: { pad: 'stick', key: 'A D', mouse: 'key:A D' }, throttle: { pad: 'R2', key: 'W', mouse: 'key:W' }, brake: { pad: 'L2', key: 'S', mouse: 'key:S' },\n  handbrake: { pad: 'square', key: 'SPACE', mouse: 'key:SPACE' }, shift: { pad: 'R1 L1', key: 'E Q', mouse: 'key:E Q' }, camera: { pad: 'triangle', key: 'C', mouse: 'key:C' }, lookBack: { pad: 'circle', key: 'B', mouse: 'key:B' }, look: { pad: 'stickR', key: 'DRAG', mouse: 'rmb' }, recover: { pad: 'triangle', key: 'R', mouse: 'key:R' },\n  drag: { pad: 'stickR', key: 'DRAG', mouse: 'lmb' }, more: { pad: 'triangle', key: 'M', mouse: 'key:M' }, focus: { pad: 'L1 R1', key: 'Q E', mouse: 'lmb' }, slow: { pad: 'R2', key: 'SHIFT', mouse: 'key:SHIFT' }, play: { pad: 'cross', key: 'ENTER', mouse: 'lmb' }, scrub: { pad: 'dpad', key: '< >', mouse: 'key:< >' }, hide: { pad: 'square', key: 'H', mouse: 'key:H' },\n};\nconst XBOX_NAMES = { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', 'L1 R1': 'LB RB', 'R1 L1': 'RB LB' };\nexport function glyphWidth(hud, spec, xbox) {\n  if (['cross', 'circle', 'square', 'triangle', 'dpad', 'stick', 'stickR', 'options'].includes(spec)) return 11;\n  if (spec === 'lmb' || spec === 'rmb' || spec === 'mouse' || spec === 'wheel') return 9;\n  const txt = spec.startsWith('key:') ? spec.slice(4) : xbox && XBOX_NAMES[spec] ? XBOX_NAMES[spec] : spec;\n  return hud.measure(txt).width + 6;\n}\n// Draws a glyph with top-left at (x, y). Returns its width.\nexport function drawGlyph(hud, x, y, spec, xbox = false) {\n  const col = { x: 'white', o: 'sand' };\n  if (SHAPE[spec]) {\n    hud.sprite(x, y, DISC, { x: 'night' });\n    if (xbox) { const [l, c] = XBOX[spec]; hud.text(x + 3, y + 2, l, { color: c, shadow: false }); }\n    else hud.sprite(x + 1, y + 1, SHAPE[spec], { x: COLOURS[spec] });\n    return 11;\n  }\n  if (spec === 'dpad') { hud.sprite(x, y + 1, DPAD, { x: 'mist' }); return 11; }\n  if (spec === 'stick' || spec === 'stickR') { hud.sprite(x, y + 1, STICK, { x: spec === 'stickR' ? 'sky' : 'mist' }); return 11; }\n  if (spec === 'options') { hud.sprite(x, y, DISC, { x: 'night' }); for (const k of [3, 5, 7]) hud.rect(x + 3, y + k, 5, 1, 'white'); return 11; }\n  if (spec === 'lmb') { hud.sprite(x, y + 1, MOUSE_L, col); return 9; }\n  if (spec === 'rmb') { hud.sprite(x, y + 1, MOUSE_R, col); return 9; }\n  if (spec === 'mouse') { hud.sprite(x, y + 1, MOUSE_W.map((r) => r.replace(/o/g, 'x')), col); return 9; }\n  if (spec === 'wheel') { hud.sprite(x, y + 1, MOUSE_W, col); return 9; }\n  const txt = spec.startsWith('key:') ? spec.slice(4) : xbox && XBOX_NAMES[spec] ? XBOX_NAMES[spec] : spec, w = hud.measure(txt).width + 6;\n  hud.rect(x, y, w, 11, 'mist'); hud.rect(x + 1, y + 1, w - 2, 9, 'night'); hud.rect(x + 1, y + 8, w - 2, 2, 'ink');\n  hud.text(x + 3, y + 2, txt, { color: 'white', shadow: false });\n  return w;\n}\nexport function specFor(action, device) { const g = ACTION_GLYPHS[action] ?? ACTION_GLYPHS.confirm; return g[device === 'pad' ? 'pad' : device === 'mouse' ? 'mouse' : 'key']; }\nEOF\ncat > src/game/ui/ui.js <<'EOF'\n// The menu system. Screens are a stack; each frame the top screen declares what is on it, in absolute art pixels.\n// There is always exactly one focused item, a thick box that slides to the next. Same screens for every input.\nimport { drawGlyph, glyphWidth, specFor } from './glyphs.js';\nconst lerp = (a, b, t) => a + (b - a) * t;\nexport function wrapText(text, chars = 60) {\n  const out = []; let line = '';\n  for (const w of String(text).split(' ')) { if ((line + ' ' + w).trim().length > chars) { out.push(line); line = w; } else line = (line + ' ' + w).trim(); }\n  if (line) out.push(line);\n  return out;\n}\nconst FONT_OK = /^[A-Z0-9 .,:;!?'\"()\\-+/%#=<>_*&@$\\[\\]\\\\|^~]*$/;\nexport const safeName = (name, fallback) => (name && FONT_OK.test(String(name).toUpperCase()) ? String(name).toUpperCase() : fallback);\nexport class UI {\n  constructor(app) {\n    this.app = app; this.stack = []; this.items = []; this.time = 0; this.box = { x: 0, y: 0, w: 0, h: 0, ready: false }; this.hud = null; this.w = 480; this.h = 270; this.cx = 240; this.promptList = []; this.clicks = []; this.pointer = { x: -1, y: -1 }; this.lastPtr = { x: -1, y: -1 }; this.pointerMoved = false; this.locked = 0; this.subtitle = null; this.toast = null;\n  }\n  get top() { return this.stack[this.stack.length - 1] ?? null; }\n  push(screen) { this.stack.push(screen); screen.t = 0; screen.enter?.(this); this.box.ready = false; return screen; }\n  pop() { const s = this.stack.pop(); s?.exit?.(this); this.box.ready = false; const t = this.top; if (t) { t.t = 0; t.resume?.(this); } return s; }\n  replace(screen) { const s = this.stack.pop(); s?.exit?.(this); return this.push(screen); }\n  clear() { while (this.stack.length) this.stack.pop()?.exit?.(this); }\n  popTo(pred) { while (this.stack.length && !pred(this.top)) this.pop(); }\n  // ---- drawing, top-left origin ----\n  text(x, y, str, o = {}) {\n    const hud = this.hud, s = String(str), scale = o.scale ?? 1;\n    let X = x;\n    if (o.align === 'center') X = Math.round(x - hud.measure(s, scale).width / 2); else if (o.align === 'right') X = Math.round(x - hud.measure(s, scale).width);\n    hud.text(X, y, s, { color: o.color ?? 'white', scale, shadow: o.shadow === undefined ? 'ink' : o.shadow });\n  }\n  lines(x, y, list, o = {}) { (Array.isArray(list) ? list : wrapText(list, o.chars ?? 60)).forEach((l, i) => this.text(x, y + i * (o.gap ?? 10), l, o)); }\n  rect(x, y, w, h, color) { this.hud.rect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), color); }\n  frameRect(x, y, w, h, color, t = 1) { this.rect(x, y, w, t, color); this.rect(x, y + h - t, w, t, color); this.rect(x, y, t, h, color); this.rect(x + w - t, y, t, h, color); }\n  panel(x, y, w, h, { color = 'ink', border = 'night', scan = false, gap = 2 } = {}) {\n    if (scan) for (let k = 0; k < h; k += gap) this.rect(x, y + k, w, 1, color); else this.rect(x, y, w, h, color);\n    if (border) this.frameRect(x, y, w, h, border);\n  }\n  sprite(x, y, rows, colors) { this.hud.sprite(Math.round(x), Math.round(y), rows, colors); }\n  bar(x, y, w, h, f, color = 'lime', back = 'night') { this.rect(x, y, w, h, back); this.rect(x, y, Math.round(w * Math.max(0, Math.min(1, f))), h, color); }\n  // ---- items ----\n  item(id, x, y, w, h, o = {}) { const it = { id, x, y, w, h, ...o }; this.items.push(it); return it.id === this.focusId; }\n  focused(id) { return this.focusId === id; }\n  // A button with a label: drawn now, focus box comes at the end.\n  button(id, x, y, w, h, label, o = {}) {\n    const f = this.item(id, x, y, w, h, o);\n    const bg = o.disabled ? 'ink' : f ? 'navy' : o.bg ?? 'night', col = o.disabled ? 'slate' : f ? 'white' : o.color ?? 'mist';\n    this.rect(x, y, w, h, bg); this.rect(x, y + h - 2, w, 2, 'ink');\n    const scale = o.scale ?? 1, ty = Math.round(y + (h - 7 * scale) / 2) - (h > 12 ? 1 : 0);\n    if (o.left) this.text(x + 6, ty, label, { color: col, scale }); else this.text(x + w / 2, ty, label, { color: col, scale, align: 'center' });\n    if (o.right) this.text(x + w - 6, ty, o.right, { color: o.rightColor ?? 'sand', align: 'right' });\n    return f;\n  }\n  slider(id, x, y, w, h, label, value, min, max, o = {}) {\n    const f = this.item(id, x, y, w, h, { ...o, slider: { value, min, max, step: o.step ?? (max - min) / 20, set: o.set, reset: o.reset } });\n    this.rect(x, y, w, h, f ? 'navy' : 'night');\n    this.text(x + 6, y + Math.round((h - 7) / 2), label, { color: f ? 'white' : 'mist' });\n    const bw = o.barW ?? Math.floor(w * 0.42), bx = x + w - bw - (o.valueW ?? 34), by = y + Math.round(h / 2) - 2, frac = (value - min) / (max - min || 1);\n    this.rect(bx, by, bw, 4, 'ink'); this.rect(bx, by, Math.round(bw * frac), 4, f ? 'lime' : 'mist'); this.rect(bx + Math.round((bw - 3) * frac), by - 2, 3, 8, 'white');\n    this.text(x + w - 5, y + Math.round((h - 7) / 2), o.format ? o.format(value) : value.toFixed(2), { align: 'right', color: f ? 'sand' : 'mist' });\n    const it = this.items[this.items.length - 1]; it.bar = { x: bx, w: bw };\n    return f;\n  }\n  tabs(id, x, y, w, labels, index, onChange) {\n    const tw = Math.floor(w / labels.length);\n    labels.forEach((l, i) => { const on = i === index; this.rect(x + i * tw, y, tw - 1, 12, on ? 'navy' : 'night'); this.text(x + i * tw + (tw - 1) / 2, y + 3, l, { align: 'center', color: on ? 'sand' : 'slate' }); this.clicks.push({ x: x + i * tw, y, w: tw - 1, h: 12, fn: () => onChange(i) }); });\n    if (this.app.actions.pressed('tabL')) { onChange((index - 1 + labels.length) % labels.length); this.app.mix?.sfx('tick'); }\n    if (this.app.actions.pressed('tabR')) { onChange((index + 1) % labels.length); this.app.mix?.sfx('tick'); }\n  }\n  header(title, sub = null) {\n    this.text(10, 8, title, { scale: 2, color: 'sand', shadow: 'ink' });\n    if (sub) this.text(10, 26, sub, { color: 'mist' });\n  }\n  prompts(list) { this.promptList = list; }\n  // A speaking line: voice once, subtitle in full.\n  say(speaker, text, seconds = null) { const app = this.app; app.mix?.say(text, speaker); this.subtitle = { speaker, text, t: seconds ?? Math.max(3.5, text.length * 0.09) }; }\n  drawSubtitle(dt) {\n    const s = this.subtitle; if (!s) return;\n    s.t -= dt; if (s.t <= 0) { this.subtitle = null; return; }\n    const lines = wrapText(s.text, Math.min(60, Math.floor((this.w - 40) / 6))), h = 16 + lines.length * 10, y = this.h - 36 - h, w = Math.min(this.w - 20, 372), x = Math.round(this.cx - w / 2);\n    this.panel(x, y, w, h, { color: 'ink', border: 'slate' });\n    const name = this.app.speakers?.[s.speaker]?.name ?? s.speaker;\n    this.text(x + 6, y + 4, name, { color: 'sand' });\n    lines.forEach((l, i) => this.text(x + 6, y + 14 + i * 10, l));\n  }\n  note(text, seconds = 2.4) { this.toast = { text, t: seconds }; }\n  // ---- the frame ----\n  frame(ctx, dt) {\n    this.hud = ctx.hud; this.ctx = ctx; this.time += dt; this.w = ctx.hud.width; this.h = ctx.hud.height; this.cx = this.w / 2;\n    const a = this.app.actions, p = ctx.input.pointer;\n    this.pointer.x = ((p.x + 1) / 2) * this.w; this.pointer.y = ((1 - p.y) / 2) * this.h;\n    this.pointerMoved = Math.abs(this.pointer.x - this.lastPtr.x) + Math.abs(this.pointer.y - this.lastPtr.y) > 0.5;\n    this.lastPtr.x = this.pointer.x; this.lastPtr.y = this.pointer.y;\n    this.items.length = 0; this.promptList = []; this.clicks.length = 0;\n    const top = this.top;\n    if (top) {\n      top.t = (top.t ?? 0) + dt;\n      if (top.overlayOf) top.overlayOf.draw?.(this, dt);\n      this.focusId = top.focus ?? null;\n      top.draw?.(this, dt);\n      if (this.top === top) this.finish(top, a, dt);\n    }\n    this.drawSubtitle(dt);\n    if (this.toast) { this.toast.t -= dt; if (this.toast.t <= 0) this.toast = null; else { const w = this.hud.measure(this.toast.text).width + 12, x = Math.round(this.cx - w / 2); this.panel(x, 34, w, 13, { color: 'plum', border: 'red' }); this.text(this.cx, 37, this.toast.text, { align: 'center' }); } }\n  }\n  finish(top, a, dt) {\n    const items = this.items;\n    if (items.length) {\n      let cur = items.find((i) => i.id === top.focus);\n      if (!cur) { cur = items.find((i) => i.id === top.defaultFocus) ?? items.find((i) => !i.disabledFocus) ?? items[0]; top.focus = cur.id; this.focusId = cur.id; }\n      if (!top.inputOff && this.locked <= 0) cur = this.navigate(top, cur, a) ?? cur;\n      // The focus box slides.\n      const b = this.box, sp = 1 - Math.exp(-dt * 22);\n      if (!b.ready) { Object.assign(b, { x: cur.x, y: cur.y, w: cur.w, h: cur.h, ready: true }); }\n      b.x = lerp(b.x, cur.x, sp); b.y = lerp(b.y, cur.y, sp); b.w = lerp(b.w, cur.w, sp); b.h = lerp(b.h, cur.h, sp);\n      if (!cur.noBox) { const col = Math.sin(this.time * 6) > 0 ? 'sand' : 'white', x = Math.round(b.x) - 2, y = Math.round(b.y) - 2, w = Math.round(b.w) + 4, h = Math.round(b.h) + 4; this.frameRect(x, y, w, h, col, 2); }\n    } else if (!top.inputOff && this.locked <= 0) {\n      if (a.pressed('confirm')) top.onConfirm?.(this);\n    }\n    if (!top.inputOff && this.locked <= 0) {\n      if (a.pressed('back')) { if (top.onBack) { if (top.onBack(this) !== false) this.app.mix?.sfx('back'); } else if (this.stack.length > 1 && !top.noBack) { this.app.mix?.sfx('back'); this.pop(); } }\n      if (a.rclicked) a.inject('back');\n      if (a.pressed('info')) top.onInfo?.(this);\n      if (a.pressed('alt')) top.onAlt?.(this);\n    }\n    this.locked -= dt;\n    this.drawPrompts(a);\n    // Clicks on tabs and prompts.\n    if (a.clicked && this.locked <= 0) for (const c of this.clicks) if (this.inRect(c)) { c.fn(); break; }\n  }\n  inRect(r) { const p = this.pointer; return p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h; }\n  navigate(top, cur, a) {\n    const items = this.items; let moved = null;\n    // Mouse: hover moves the focus, click confirms.\n    if (this.pointerMoved || a.clicked) { const hit = items.find((i) => this.inRect(i)); if (hit && hit.id !== cur.id) { top.focus = hit.id; moved = hit; this.app.mix?.sfx('tick'); } }\n    const dx = a.moveX(), dy = a.moveY();\n    if ((dx || dy) && !moved) {\n      if (dx && cur.slider) { this.nudge(cur, dx); return cur; }\n      if (dx && cur.onX) { cur.onX(dx); return cur; }\n      if (dy && cur.onY) { cur.onY(dy); return cur; }\n      const c0 = { x: cur.x + cur.w / 2, y: cur.y + cur.h / 2 }; let best = null, bs = Infinity;\n      for (const i of items) {\n        if (i === cur) continue;\n        const cx = i.x + i.w / 2, cy = i.y + i.h / 2, vx = cx - c0.x, vy = cy - c0.y, along = dx ? vx * dx : vy * dy, across = dx ? Math.abs(vy) : Math.abs(vx);\n        if (along <= 1) continue;\n        const score = along + across * 2.2; if (score < bs) { bs = score; best = i; }\n      }\n      if (!best && top.wrapFocus !== false) { // wrap around in the pressed direction\n        const list = items.filter((i) => (dx ? Math.abs(i.y + i.h / 2 - c0.y) < 8 : Math.abs(i.x + i.w / 2 - c0.x) < 40));\n        if (list.length > 1) best = (dx > 0 || dy > 0) ? list.reduce((p, q) => ((dx ? q.x < p.x : q.y < p.y) ? q : p)) : list.reduce((p, q) => ((dx ? q.x > p.x : q.y > p.y) ? q : p));\n      }\n      if (best && best !== cur) { top.focus = best.id; moved = best; this.app.mix?.sfx('tick'); }\n    }\n    const now = moved ?? cur;\n    if (a.wheel && now.slider) this.nudge(now, -Math.sign(a.wheel));\n    // Dragging a slider with the mouse.\n    if (now.slider && now.bar && this.ctx.input.isDown('MouseLeft') && this.inRect(now)) { const f = Math.max(0, Math.min(1, (this.pointer.x - now.bar.x) / now.bar.w)), s = now.slider; s.set?.(s.min + (s.max - s.min) * f); }\n    if (a.pressed('confirm') || (a.clicked && this.inRect(now))) {\n      if (now.slider && !a.clicked) { now.slider.reset?.(); this.app.mix?.sfx('tick'); }\n      else if (!now.slider) {\n        if (now.denied) { this.app.mix?.sfx('denied'); now.denied(); }\n        else if (now.confirm) { if (now.quiet !== true) this.app.mix?.sfx('confirm'); now.confirm(); }\n      }\n    }\n    return now;\n  }\n  nudge(it, dir) { const s = it.slider; let v = s.value + dir * s.step; v = Math.max(s.min, Math.min(s.max, v)); s.set?.(v); this.app.mix?.sfx('tick'); }\n  drawPrompts(a) {\n    const list = this.promptList; if (!list.length) return;\n    const hud = this.hud, dev = a.lastDevice, xbox = this.app.options.glyphs === 'xbox', y = this.h - 15; let total = 0;\n    const specs = list.map(([act, label]) => { const spec = specFor(act, dev), gw = glyphWidth(hud, spec, xbox), lw = hud.measure(label).width; total += gw + 3 + lw + 12; return { act, label, spec, gw, lw }; });\n    total -= 12; let x = Math.max(6, Math.round(this.cx - total / 2));\n    this.rect(0, y - 3, this.w, 18, 'ink');\n    for (const s of specs) { drawGlyph(hud, x, y, s.spec, xbox); hud.text(x + s.gw + 3, y + 2, s.label, { color: 'mist', shadow: false }); const act = s.act; if (['back', 'confirm', 'alt', 'info', 'tabL', 'tabR'].includes(act)) this.clicks.push({ x, y: y - 2, w: s.gw + 3 + s.lw, h: 14, fn: () => a.inject(act) }); x += s.gw + 3 + s.lw + 12; }\n  }\n}\nEOF\ncat > src/game/audio/enginesynth.js <<'EOF'\n// The most important sound in the game. A Web Audio graph on any BaseAudioContext, so a test can render it offline.\n// Firing frequency f0 = rpm / 60 x cylinders / 2. Saw at f0, square at f0 / 2, triangle at 2 x f0, filtered noise for exhaust.\nexport function noiseBuffer(actx, seconds = 2) {\n  const n = Math.floor(actx.sampleRate * seconds), b = actx.createBuffer(1, n, actx.sampleRate), d = b.getChannelData(0); let s = 12345;\n  for (let i = 0; i < n; i++) { s = (Math.imul(s, 1103515245) + 12345) & 0x7fffffff; d[i] = (s / 0x7fffffff) * 2 - 1; }\n  return b;\n}\nexport class EngineSynth {\n  // data: { cylinders, filter, exhaust, turbo, sportExhaust, redline, idle }\n  constructor(actx, dest, data, shared = {}) {\n    this.ctx = actx; this.data = data; this.lastRpm = 0; this.lastThrottle = 0; this.crackle = 0; this.gainTarget = 1; this.lastLift = 0;\n    const t = actx.currentTime;\n    const osc = (type, g) => { const o = actx.createOscillator(); o.type = type; const a = actx.createGain(); a.gain.value = g; o.connect(a); o.start(t); return { o, a }; };\n    this.saw = osc('sawtooth', 0.34); this.sq = osc('square', 0.26); this.tri = osc('triangle', 0.14);\n    this.noise = actx.createBufferSource(); this.noise.buffer = shared.noise ?? noiseBuffer(actx); this.noise.loop = true; this.noise.start(t);\n    this.noiseBand = actx.createBiquadFilter(); this.noiseBand.type = 'bandpass'; this.noiseBand.Q.value = 0.9; this.noiseGain = actx.createGain(); this.noiseGain.gain.value = 0.2; this.noise.connect(this.noiseBand); this.noiseBand.connect(this.noiseGain);\n    this.lp = actx.createBiquadFilter(); this.lp.type = 'lowpass'; this.lp.Q.value = 1.1;\n    for (const v of [this.saw, this.sq, this.tri]) v.a.connect(this.lp);\n    this.noiseGain.connect(this.lp);\n    this.out = actx.createGain(); this.out.gain.value = 0;\n    this.pan = actx.createStereoPanner ? actx.createStereoPanner() : null;\n    this.lp.connect(this.out);\n    if (this.pan) { this.out.connect(this.pan); this.pan.connect(dest); } else this.out.connect(dest);\n    // Turbo: a whistle rising with spool, a puff of filtered noise on lift.\n    this.whistle = actx.createOscillator(); this.whistle.type = 'sine'; this.whistleGain = actx.createGain(); this.whistleGain.gain.value = 0; this.whistle.connect(this.whistleGain); this.whistleGain.connect(this.pan ?? dest); this.whistle.start(t);\n    this.puffSrc = actx.createBufferSource(); this.puffSrc.buffer = this.noise.buffer; this.puffSrc.loop = true; this.puffFilter = actx.createBiquadFilter(); this.puffFilter.type = 'highpass'; this.puffFilter.frequency.value = 1800; this.puffGain = actx.createGain(); this.puffGain.gain.value = 0; this.puffSrc.connect(this.puffFilter); this.puffFilter.connect(this.puffGain); this.puffGain.connect(this.pan ?? dest); this.puffSrc.start(t);\n    // Overrun crackle: short pops of noise with the sport exhaust.\n    this.crackleGain = actx.createGain(); this.crackleGain.gain.value = 0; this.crackleBand = actx.createBiquadFilter(); this.crackleBand.type = 'bandpass'; this.crackleBand.frequency.value = 900; this.crackleBand.Q.value = 2; this.noise.connect(this.crackleBand); this.crackleBand.connect(this.crackleGain); this.crackleGain.connect(this.pan ?? dest);\n    this.seed = 7; this.limT = 0;\n  }\n  set({ rpm, throttle, spool = 0, gain = 1, pan = 0, dt = 1 / 60 }) {\n    const d = this.data, a = this.ctx, t = a.currentTime, k = 0.012;\n    this.lastRpm = rpm; this.lastThrottle = throttle;\n    const cyl = d.cylinders ?? 4, f0 = Math.max(18, (rpm / 60) * (cyl / 2));\n    this.saw.o.frequency.setTargetAtTime(f0, t, k); this.sq.o.frequency.setTargetAtTime(f0 / 2, t, k); this.tri.o.frequency.setTargetAtTime(2 * f0, t, k);\n    const rn = Math.min(1.2, rpm / (d.redline ?? 7000)), cutoff = (d.filter ?? 1200) * (0.45 + 1.5 * throttle * rn + 0.75 * rn);\n    this.lp.frequency.setTargetAtTime(Math.min(9000, cutoff), t, k * 2);\n    this.noiseBand.frequency.setTargetAtTime(Math.min(4000, 220 + f0 * 1.6), t, k);\n    const loud = (d.exhaust ?? 1) * (d.sportExhaust ? 1.25 : 1);\n    this.noiseGain.gain.setTargetAtTime(0.14 * loud * (0.4 + throttle), t, k);\n    let body = (0.35 + 0.65 * throttle) * loud * gain;\n    // Rev-limiter stutter at redline.\n    if (rpm >= (d.redline ?? 7000) - 20 && throttle > 0.2) { this.limT += dt * 28; if (this.limT % 1 < 0.42) body *= 0.25; }\n    this.out.gain.setTargetAtTime(body * 0.5, t, 0.008);\n    if (this.pan) this.pan.pan.setTargetAtTime(Math.max(-1, Math.min(1, pan)), t, 0.03);\n    // Turbo\n    if (d.turbo) { this.whistle.frequency.setTargetAtTime(1500 + 3400 * spool, t, 0.04); this.whistleGain.gain.setTargetAtTime(0.032 * spool * spool * gain * (0.4 + throttle), t, 0.05); const lift = this.prevThrottle > 0.6 && throttle < 0.2 && spool > 0.45; if (lift) { this.puffGain.gain.cancelScheduledValues(t); this.puffGain.gain.setValueAtTime(0.13 * gain, t); this.puffGain.gain.exponentialRampToValueAtTime(0.0008, t + 0.26); } }\n    // Overrun crackle on lift.\n    if (d.sportExhaust && throttle < 0.08 && rpm > (d.redline ?? 7000) * 0.5) { this.seed = (Math.imul(this.seed, 1103515245) + 12345) & 0x7fffffff; if (this.seed % 100 < 9) { this.crackleGain.gain.cancelScheduledValues(t); this.crackleGain.gain.setValueAtTime(0.32 * gain, t); this.crackleGain.gain.exponentialRampToValueAtTime(0.001, t + 0.05); this.crackle++; } }\n    this.prevThrottle = throttle;\n  }\n  silence() { const t = this.ctx.currentTime; this.out.gain.setTargetAtTime(0, t, 0.03); this.whistleGain.gain.setTargetAtTime(0, t, 0.03); this.puffGain.gain.setTargetAtTime(0, t, 0.03); this.crackleGain.gain.setTargetAtTime(0, t, 0.03); }\n  dispose() { try { for (const v of [this.saw, this.sq, this.tri]) v.o.stop(); this.noise.stop(); this.whistle.stop(); this.puffSrc.stop(); } catch { /* already stopped */ } try { (this.pan ?? this.out).disconnect(); this.out.disconnect(); this.whistleGain.disconnect(); this.puffGain.disconnect(); this.crackleGain.disconnect(); } catch { /* already gone */ } }\n}\nEOF\ncat > src/game/audio/voice.js <<'EOF'\n// Gibberish voices, in code. Each letter is a syllable of 65-85 ms; vowels pick formants through two band-pass filters over a\n// saw; consonants add a 12 ms noise click; the sentence end falls and a question rises. The same words always make the same sound.\nimport { SPEAKERS } from '../data/text.js';\nconst FORMANTS = { A: [800, 1150], E: [400, 2000], I: [300, 2400], O: [450, 800], U: [325, 700] };\nconst VOWELS = Object.keys(FORMANTS);\nexport function syllables(text) {\n  const out = []; let h = 2166136261;\n  for (const ch of String(text).toUpperCase()) {\n    h = Math.imul(h ^ ch.charCodeAt(0), 16777619) >>> 0;\n    if (/[A-Z]/.test(ch)) { const vowel = VOWELS.includes(ch); out.push({ vowel, f: vowel ? FORMANTS[ch] : FORMANTS[VOWELS[h % 5]], length: 0.065 + ((h >>> 8) % 21) / 1000, detune: ((h >>> 13) % 13) - 6, click: !vowel }); }\n    else if (/[0-9]/.test(ch)) out.push({ vowel: true, f: FORMANTS[VOWELS[+ch % 5]], length: 0.07, detune: (+ch % 7) - 3, click: true });\n    else if (ch === ' ') out.push({ gap: 0.03 });\n    else if (/[.,;:!?]/.test(ch)) out.push({ gap: ch === ',' ? 0.09 : 0.16 });\n  }\n  return out;\n}\nexport function speak(actx, dest, noise, text, speakerId, gain = 0.5) {\n  const sp = SPEAKERS[speakerId] ?? SPEAKERS.arai, list = syllables(text), rises = /\\?\\s*$/.test(text), rate = sp.manner === 'fast' ? 0.72 : sp.manner === 'gravel' ? 0.95 : 1; let t = actx.currentTime + 0.02; const total = list.length, started = t, nodes = [];\n  list.forEach((s, i) => {\n    if (s.gap) { t += s.gap * rate; return; }\n    const pos = i / Math.max(1, total), end = pos > 0.82 ? (pos - 0.82) / 0.18 : 0, len = s.length * rate;\n    let pitch = sp.pitch * Math.pow(2, s.detune / 48);\n    if (rises) pitch *= 1 + end * 0.45; else pitch *= 1 - end * 0.3;\n    if (sp.manner === 'lilt' && end > 0) pitch *= 1 + Math.sin(end * 3.14) * 0.25;\n    const o = actx.createOscillator(); o.type = sp.wave === 'square' ? 'square' : 'sawtooth'; o.frequency.value = pitch;\n    const f1 = actx.createBiquadFilter(), f2 = actx.createBiquadFilter(); f1.type = 'bandpass'; f2.type = 'bandpass'; f1.frequency.value = s.f[0]; f2.frequency.value = s.f[1]; f1.Q.value = 5; f2.Q.value = 7;\n    const g = actx.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(gain, t + 0.008); g.gain.setValueAtTime(gain, t + len * 0.7); g.gain.linearRampToValueAtTime(0, t + len);\n    o.connect(f1); o.connect(f2); f1.connect(g); f2.connect(g); g.connect(dest); o.start(t); o.stop(t + len + 0.01); nodes.push(o);\n    if (s.click && noise) { const n = actx.createBufferSource(); n.buffer = noise; n.loopStart = (i % 7) * 0.1; const c = actx.createGain(), hp = actx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 2400; c.gain.setValueAtTime(gain * 0.55, t); c.gain.linearRampToValueAtTime(0, t + 0.012); n.connect(hp); hp.connect(c); c.connect(dest); n.start(t, (i % 13) * 0.05, 0.016); nodes.push(n); }\n    t += len;\n  });\n  return { until: t, started, stop() { for (const n of nodes) { try { n.stop(); } catch { /* done already */ } } } };\n}\nEOF\ncat > src/game/data/songs.js <<'EOF'\n// Eight original pieces as Song data. Square, triangle, saw, sine and noise only. Harmony written out as note steps.\nconst row = (s) => s.trim().split(/\\s+/).join(' ');\nconst rep = (s, n) => Array(n).fill(row(s)).join(' ');\nconst R = (n = 16) => Array(n).fill('.').join(' ');\n// Comping: a chord as four notes, arpeggiated in a pattern over one bar of 16 steps.\nconst arp = (a, b, c, d, pat = 'a . b . c . d . c . b . a . b .') => pat.replace(/\\b[abcd]\\b/g, (m) => ({ a, b, c, d }[m]));\nconst BRUSH = { wave: 'noise', decay: 0.06, volume: 0.05 }, KICK = { wave: 'sine', freqEnd: 40, sweepTime: 0.08, decay: 0.12, volume: 0.22 };\nexport const SONGS = {\n  lounge: { // Db: ii7, V7, Imaj7, vi7 with a turnaround. A bossa lounge with a soft sine lead.\n    bpm: 92,\n    tracks: { lead: { wave: 'sine', attack: 0.01, decay: 0.42, volume: 0.28, vibrato: { depth: 0.12, rate: 5 } }, comp: { wave: 'triangle', decay: 0.2, volume: 0.1 }, bass: { wave: 'triangle', decay: 0.28, volume: 0.24 }, brush: BRUSH },\n    patterns: {\n      a: { lead: row('. . F5 . Ab5 . . Gb5 . . Eb5 . . . Db5 .  C5 . . Eb5 . . Ab5 . Gb5 . . F5 . . Eb5 .  F5 . . . Ab5 . C6 . . Bb5 . Ab5 . . F5 .  Db5 . . F5 . . Ab5 . . . F5 . Db5 . . .'),\n        comp: `${arp('Eb4', 'Gb4', 'Bb4', 'Db5', '. . a . b . . c . d . . c . . b')} ${arp('Ab3', 'C4', 'Eb4', 'Gb4', '. . a . b . . c . d . . c . . b')} ${arp('Db4', 'F4', 'Ab4', 'C5', '. . a . b . . c . d . . c . . b')} ${arp('Bb3', 'Db4', 'F4', 'Ab4', '. . a . b . . c . d . . c . . b')}`,\n        bass: row('Eb2 . . Eb2 . . Bb2 . . . Eb2 . . Bb1 . .  Ab2 . . Ab2 . . Eb2 . . . Ab2 . . Gb2 . .  Db2 . . Db2 . . Ab2 . . . Db2 . . F2 . .  Bb1 . . Bb1 . . F2 . . . Bb1 . . Ab2 . .'),\n        brush: rep('C8 . . C8 . . C8 . C8 . . C8 . . C8 .', 4) },\n      b: { lead: row('Bb5 . . . Ab5 . F5 . . Eb5 . . Db5 . . .  Eb5 . Gb5 . Bb5 . . Ab5 . . Gb5 . Eb5 . . .  Db5 . F5 . Ab5 . . C6 . . Ab5 . F5 . . Eb5  Db5 . . . . . . . . . . . . . . .'),\n        comp: `${arp('Gb3', 'Bb3', 'Db4', 'F4', '. . a . b . . c . d . . c . . b')} ${arp('F3', 'A3', 'C4', 'Eb4', '. . a . b . . c . d . . c . . b')} ${arp('Bb3', 'Db4', 'F4', 'Ab4', '. . a . b . . c . d . . c . . b')} ${arp('Eb3', 'Gb3', 'Bb3', 'Db4', 'a . b . c . d . c . b . a . . .')}`,\n        bass: row('Gb2 . . Gb2 . . Db2 . . . Gb2 . . Db2 . .  F2 . . F2 . . C2 . . . F2 . . C2 . .  Bb1 . . Bb1 . . F2 . . . Bb1 . . F2 . .  Eb2 . . Eb2 . . Bb1 . Ab1 . . Ab1 . Ab2 . .'),\n        brush: rep('C8 . . C8 . . C8 . C8 . . C8 . . C8 .', 4) },\n    }, order: ['a', 'a', 'b', 'a'],\n  },\n  catalogue: { // Fmaj7, Em7, Dm7, G7, very slow, vibraphone-like.\n    bpm: 76,\n    tracks: { vibe: { wave: 'sine', decay: 0.9, volume: 0.22, vibrato: { depth: 0.18, rate: 4.2 } }, vibe2: { wave: 'sine', decay: 0.7, volume: 0.12, vibrato: { depth: 0.18, rate: 4.2 } }, bass: { wave: 'triangle', decay: 0.5, volume: 0.2 } },\n    patterns: { a: {\n      vibe: row('A5 . . . C6 . . . E6 . . . . . . .  G5 . . . B5 . . . D6 . . . . . . .  F5 . . . A5 . . . C6 . . . . . . .  D6 . . . B5 . . . G5 . . . F5 . . .'),\n      vibe2: row('F4 . . . . . A4 . . . C5 . . . . .  E4 . . . . . G4 . . . B4 . . . . .  D4 . . . . . F4 . . . A4 . . . . .  G4 . . . . . B4 . . . D5 . . . . .'),\n      bass: row('F2 . . . . . . . C3 . . . . . . .  E2 . . . . . . . B2 . . . . . . .  D2 . . . . . . . A2 . . . . . . .  G2 . . . . . . . D3 . . . . . . .') },\n      b: { vibe: row('C6 . . . A5 . . . F5 . . . E5 . . .  D6 . . . B5 . . . G5 . . . E5 . . .  A5 . . . F5 . . . D5 . . . F5 . . .  G5 . . . F5 . D5 . B4 . . . . . . .'),\n        vibe2: row('F4 . . . . . . . C5 . . . . . . .  E4 . . . . . . . B4 . . . . . . .  D4 . . . . . . . A4 . . . . . . .  G4 . . . . . . . . . . . . . . .'),\n        bass: row('F2 . . . . . . . A2 . . . . . . .  E2 . . . . . . . G2 . . . . . . .  D2 . . . . . . . F2 . . . . . . .  G2 . . . . . . . G2 . . . . . . .') } }, order: ['a', 'a', 'b', 'a'],\n  },\n  socket: { // Light funk, muted square. A minor pentatonic over Am7, D9.\n    bpm: 108,\n    tracks: { lead: { wave: 'square', duty: 0.25, decay: 0.09, volume: 0.12 }, clav: { wave: 'square', duty: 0.125, decay: 0.05, volume: 0.09 }, bass: { wave: 'triangle', decay: 0.14, volume: 0.26 }, hat: { wave: 'noise', decay: 0.03, volume: 0.05 }, snare: { wave: 'noise', decay: 0.1, volume: 0.1 } },\n    patterns: { a: {\n      lead: row('A4 . C5 . . D5 . . E5 . . G5 . . E5 .  D5 . . C5 . . A4 . . . C5 . D5 . . .  A4 . C5 . . D5 . . E5 . G5 . A5 . G5 .  E5 . D5 . C5 . . . A4 . . . . . . .'),\n      clav: row('. . A3 C4 . . A3 . . G3 . . C4 . . .  . . D4 F#4 . . D4 . . C4 . . E4 . . .  . . A3 C4 . . A3 . . G3 . . C4 . . .  . . D4 F#4 . . D4 . . C4 . . E4 . . .'),\n      bass: row('A2 . . A2 . . G2 . . E2 . . G2 . A2 .  D2 . . D2 . . F#2 . . A2 . . C3 . D3 .  A2 . . A2 . . G2 . . E2 . . G2 . A2 .  D2 . . D2 . . F#2 . . A2 . . G2 . E2 .'),\n      hat: rep('C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4) } }, order: ['a'],\n  },\n  exam: { // Sparse, metronomic, polite. C: a bass pulse and a three-note motif.\n    bpm: 120,\n    tracks: { tick: { wave: 'noise', decay: 0.02, volume: 0.05 }, bass: { wave: 'triangle', decay: 0.2, volume: 0.2 }, motif: { wave: 'sine', decay: 0.3, volume: 0.2 }, pad: { wave: 'triangle', attack: 0.04, decay: 0.8, volume: 0.05 } },\n    patterns: { a: { tick: rep('C8 . . . C8 . . . C8 . . . C8 . . .', 4), bass: rep('C2 . . . . . . . C2 . . . . . . .', 2) + ' ' + rep('G1 . . . . . . . G1 . . . . . . .', 2),\n      motif: row('. . . . . . . . E5 . G5 . C5 . . .  . . . . . . . . . . . . . . . .  . . . . . . . . D5 . G5 . B4 . . .  . . . . . . . . . . . . . . . .'),\n      pad: row('C4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . .  D4 . . . . . . . . . . . . . . .  F4 . . . . . . . . . . . . . . .') } }, order: ['a'],\n  },\n  apex: { // Driving chiptune rock. E minor: i, VI, III, VII with a lead hook.\n    bpm: 156,\n    tracks: { lead: { wave: 'square', duty: 0.5, decay: 0.16, volume: 0.13 }, gtr: { wave: 'saw', decay: 0.1, volume: 0.09 }, bass: { wave: 'triangle', decay: 0.12, volume: 0.28 }, kick: KICK, snare: { wave: 'noise', decay: 0.12, volume: 0.12 }, hat: { wave: 'noise', decay: 0.025, volume: 0.05 } },\n    patterns: { a: {\n      lead: row('E5 . . G5 . . B5 . A5 . G5 . E5 . . .  C5 . . E5 . . G5 . F#5 . E5 . C5 . . .  G5 . . B5 . . D6 . C6 . B5 . G5 . . .  D5 . . F#5 . . A5 . B5 . A5 . F#5 . D5 .'),\n      gtr: `${rep('E3 E3 . E3 B3 . E3 .', 2)} ${rep('C3 C3 . C3 G3 . C3 .', 2)} ${rep('G3 G3 . G3 D4 . G3 .', 2)} ${rep('D3 D3 . D3 A3 . D3 .', 2)}`,\n      bass: `${rep('E2 . E2 . E2 . E2 E2', 2)} ${rep('C2 . C2 . C2 . C2 C2', 2)} ${rep('G2 . G2 . G2 . G2 G2', 2)} ${rep('D2 . D2 . D2 . D2 D2', 2)}`,\n      kick: rep('C2 . . . . . . . C2 . C2 . . . . .', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4), hat: rep('C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', 4) },\n      b: { lead: row('B5 . . . A5 . B5 . G5 . . . E5 . G5 .  A5 . . . G5 . A5 . F#5 . . . D5 . E5 .  B5 . . . A5 . B5 . D6 . . . B5 . G5 .  A5 . G5 . F#5 . E5 . F#5 . . . . . . .'),\n        gtr: `${rep('E3 . E3 . G3 . E3 .', 2)} ${rep('D3 . D3 . F#3 . D3 .', 2)} ${rep('C3 . C3 . E3 . C3 .', 2)} ${rep('B2 . B2 . D#3 . B2 .', 2)}`,\n        bass: `${rep('E2 E2 . E2 . E2 . E2', 2)} ${rep('D2 D2 . D2 . D2 . D2', 2)} ${rep('C2 C2 . C2 . C2 . C2', 2)} ${rep('B1 B1 . B1 . B1 . B1', 2)}`,\n        kick: rep('C2 . . . . . . . C2 . C2 . . . . .', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4), hat: rep('C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', 4) } }, order: ['a', 'a', 'b', 'a'],\n  },\n  city: { // City-pop groove. Bb: Imaj7, iii7, vi7, IV.\n    bpm: 118,\n    tracks: { lead: { wave: 'square', duty: 0.25, attack: 0.005, decay: 0.2, volume: 0.1, vibrato: { depth: 0.1, rate: 6 } }, keys: { wave: 'triangle', decay: 0.18, volume: 0.1 }, bass: { wave: 'square', duty: 0.5, decay: 0.12, volume: 0.13 }, kick: KICK, snare: { wave: 'noise', decay: 0.1, volume: 0.09 }, hat: { wave: 'noise', decay: 0.03, volume: 0.05 } },\n    patterns: { a: {\n      lead: row('D5 . F5 . A5 . . G5 . . F5 . D5 . . .  D5 . F5 . A5 . . C6 . . A5 . F5 . . .  C5 . Eb5 . G5 . . F5 . . Eb5 . C5 . . .  Eb5 . G5 . Bb5 . . A5 . . G5 . F5 . . .'),\n      keys: `${arp('Bb3', 'D4', 'F4', 'A4', '. . a b . . c . . d . . c . . .')} ${arp('D4', 'F4', 'A4', 'C5', '. . a b . . c . . d . . c . . .')} ${arp('G3', 'Bb3', 'D4', 'F4', '. . a b . . c . . d . . c . . .')} ${arp('Eb4', 'G4', 'Bb4', 'D5', '. . a b . . c . . d . . c . . .')}`,\n      bass: row('Bb1 . . Bb1 . . Bb2 . . F2 . . Bb1 . . .  D2 . . D2 . . D3 . . A2 . . D2 . . .  G1 . . G1 . . G2 . . D2 . . G1 . . .  Eb2 . . Eb2 . . Eb3 . . Bb2 . F2 . G2 . .'),\n      kick: rep('C2 . . . . . C2 . . . C2 . . . . .', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4), hat: rep('C8 . C8 C8 . C8 C8 . C8 . C8 C8 . C8 C8 .', 4) } }, order: ['a'],\n  },\n  clay: { // Twangy, galloping. G mixolydian.\n    bpm: 132,\n    tracks: { twang: { wave: 'saw', decay: 0.14, volume: 0.1, vibrato: { depth: 0.25, rate: 7 } }, gallop: { wave: 'square', duty: 0.25, decay: 0.05, volume: 0.08 }, bass: { wave: 'triangle', decay: 0.14, volume: 0.27 }, hat: { wave: 'noise', decay: 0.03, volume: 0.06 }, snare: { wave: 'noise', decay: 0.1, volume: 0.1 } },\n    patterns: { a: {\n      twang: row('G4 . B4 . D5 . . E5 . F5 . E5 D5 . B4 .  G4 . B4 . D5 . . E5 . F5 . G5 F5 . D5 .  F4 . A4 . C5 . . D5 . E5 . D5 C5 . A4 .  G4 . B4 . D5 . F5 . E5 . D5 . B4 . G4 .'),\n      gallop: rep('G3 . G3 G3 D3 . D3 D3 G3 . G3 G3 F3 . F3 F3', 2) + ' ' + rep('F3 . F3 F3 C3 . C3 C3 G3 . G3 G3 D3 . D3 D3', 2),\n      bass: rep('G2 . . . D2 . . . G2 . . . F2 . . .', 2) + ' ' + rep('F2 . . . C2 . . . G2 . . . D2 . . .', 2),\n      hat: rep('C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4) } }, order: ['a'],\n  },\n  longDrive: { // Calm arpeggios that open out. D: Imaj7, V/vi, vi7, IVmaj7.\n    bpm: 84,\n    tracks: { arp: { wave: 'triangle', decay: 0.42, volume: 0.15 }, lead: { wave: 'sine', attack: 0.02, decay: 0.7, volume: 0.2, vibrato: { depth: 0.12, rate: 4.5 } }, bass: { wave: 'sine', decay: 0.7, volume: 0.24 } },\n    patterns: { a: {\n      arp: `${arp('D4', 'F#4', 'A4', 'C#5', 'a b c d c b a b a b c d c b a b')} ${arp('F#3', 'A#3', 'C#4', 'E4', 'a b c d c b a b a b c d c b a b')} ${arp('B3', 'D4', 'F#4', 'A4', 'a b c d c b a b a b c d c b a b')} ${arp('G3', 'B3', 'D4', 'F#4', 'a b c d c b a b a b c d c b a b')}`,\n      lead: row('F#5 . . . . . A5 . . . . . . . . .  E5 . . . . . C#5 . . . . . . . . .  D5 . . . . . F#5 . . . . . A5 . . .  B5 . . . A5 . F#5 . D5 . . . . . . .'),\n      bass: row('D2 . . . . . . . . . . . . . . .  F#2 . . . . . . . . . . . . . . .  B1 . . . . . . . . . . . . . . .  G2 . . . . . . . . . . . . . . .') } }, order: ['a'],\n  },\n  fanfare: { bpm: 180, loop: false, tracks: { a: { wave: 'square', duty: 0.25, decay: 0.3, volume: 0.2 }, b: { wave: 'triangle', decay: 0.3, volume: 0.2 } }, patterns: { a: { a: row('G5 . G5 . C6 . . . E6 . . . G6 . . . . . . .'), b: row('E4 . E4 . G4 . . . C5 . . . E5 . . . . . . .') } }, order: ['a'] },\n};\nvoid R;\nEOF\ncat > src/game/audio/sfx.js <<'EOF'\n// Every sound effect, as data. Menu ticks, thumps, chirps, chimes.\nexport const SFX = {\n  tick: { wave: 'square', duty: 0.25, freq: 1100, decay: 0.03, volume: 0.1 },\n  confirm: { wave: 'triangle', freq: 660, decay: 0.12, volume: 0.22, arp: [0, 7], arpRate: 0.05 },\n  back: { wave: 'triangle', freq: 440, freqEnd: 330, decay: 0.1, volume: 0.18 },\n  denied: { wave: 'square', duty: 0.5, freq: 160, decay: 0.16, volume: 0.16, crush: 6 },\n  register: { wave: 'triangle', freq: 1320, decay: 0.08, volume: 0.2, arp: [0, 5, 9], arpRate: 0.04, layers: [{ wave: 'noise', freq: 9000, decay: 0.02, volume: 0.1, delay: 0.1 }] },\n  coin: { wave: 'square', duty: 0.25, freq: 1800, decay: 0.05, volume: 0.09 },\n  whirr: { wave: 'saw', freq: 90, freqEnd: 150, attack: 0.08, decay: 0.3, volume: 0.05 },\n  gear: { wave: 'noise', freq: 2400, decay: 0.03, volume: 0.1, layers: [{ wave: 'square', freq: 140, decay: 0.04, volume: 0.1 }] },\n  gearDown: { wave: 'noise', freq: 1800, decay: 0.04, volume: 0.1, layers: [{ wave: 'square', freq: 110, decay: 0.05, volume: 0.1 }] },\n  thump: { wave: 'noise', freq: 600, decay: 0.14, volume: 0.3, layers: [{ wave: 'sine', freq: 90, freqEnd: 40, decay: 0.16, volume: 0.45 }] },\n  thumpBig: { wave: 'noise', freq: 420, decay: 0.3, volume: 0.42, layers: [{ wave: 'sine', freq: 70, freqEnd: 28, decay: 0.3, volume: 0.6 }, { wave: 'noise', freq: 4000, decay: 0.08, volume: 0.15 }] },\n  carHit: { wave: 'noise', freq: 900, decay: 0.1, volume: 0.25, layers: [{ wave: 'square', freq: 120, freqEnd: 60, decay: 0.1, volume: 0.2 }] },\n  landing: { wave: 'sine', freq: 80, freqEnd: 34, decay: 0.22, volume: 0.5, layers: [{ wave: 'noise', freq: 500, decay: 0.12, volume: 0.22 }] },\n  lockChirp: { wave: 'saw', freq: 2200, freqEnd: 1500, decay: 0.12, volume: 0.1 },\n  ratchet: { wave: 'noise', freq: 5000, decay: 0.03, volume: 0.08, layers: [{ wave: 'noise', freq: 5000, decay: 0.03, volume: 0.08, delay: 0.04 }, { wave: 'noise', freq: 5000, decay: 0.03, volume: 0.08, delay: 0.08 }] },\n  lapChime: { wave: 'triangle', freq: 988, decay: 0.3, volume: 0.22, arp: [0, 4, 7], arpRate: 0.07 },\n  bestLap: { wave: 'triangle', freq: 988, decay: 0.42, volume: 0.25, arp: [0, 4, 7, 12], arpRate: 0.07 },\n  beep: { wave: 'square', duty: 0.5, freq: 880, decay: 0.16, volume: 0.17 },\n  beepGo: { wave: 'square', duty: 0.5, freq: 1760, decay: 0.5, volume: 0.2 },\n  flag: { wave: 'triangle', freq: 784, decay: 0.32, volume: 0.25, arp: [0, 4, 7, 12, 16], arpRate: 0.08 },\n  wheelGun: { wave: 'saw', freq: 300, freqEnd: 900, decay: 0.24, volume: 0.16, crush: 5, layers: [{ wave: 'noise', freq: 3000, decay: 0.2, volume: 0.1 }] },\n  coneHit: { wave: 'square', freq: 500, freqEnd: 220, decay: 0.09, volume: 0.17 },\n  splash: { wave: 'noise', freq: 2200, decay: 0.3, volume: 0.16 },\n  brush: { wave: 'noise', freq: 3000, attack: 0.04, decay: 0.3, volume: 0.1 },\n  sting: { wave: 'triangle', freq: 523, decay: 0.5, volume: 0.2, arp: [0, 7, 12], arpRate: 0.12 },\n  fanfare2: { wave: 'square', duty: 0.25, freq: 523, decay: 0.8, volume: 0.17, arp: [0, 4, 7, 12, 16, 19], arpRate: 0.11, layers: [{ wave: 'triangle', freq: 262, decay: 0.8, volume: 0.17, arp: [0, 4, 7, 12], arpRate: 0.17 }] },\n  medal: { wave: 'triangle', freq: 659, decay: 0.5, volume: 0.25, arp: [0, 5, 9, 12], arpRate: 0.09 },\n  pop: { wave: 'noise', freq: 1500, decay: 0.08, volume: 0.15 },\n  firework: { wave: 'noise', freq: 800, decay: 0.45, volume: 0.15, layers: [{ wave: 'sine', freq: 120, freqEnd: 50, decay: 0.2, volume: 0.2 }] },\n};\nEOF\ncat > src/game/audio/mix.js <<'EOF'\n// All sound goes through here. The engine's AudioManager plays effects and music; this adds the engine synths, tyres, wind, rain and voices.\nimport { EngineSynth, noiseBuffer } from './enginesynth.js';\nimport { speak } from './voice.js';\nimport { SFX } from './sfx.js';\nimport { SONGS } from '../data/songs.js';\nimport { CAR_INFO } from '../data/cars.js';\nexport function engineData(carId, p) {\n  const i = CAR_INFO[carId];\n  return { cylinders: i?.cyl ?? 4, filter: i?.filter ?? 1200, exhaust: i?.exhaust ?? 1, turbo: !!p?.turbo, sportExhaust: !!p?.sportExhaust, redline: p?.redline ?? 7000, idle: p?.idle ?? 900 };\n}\nexport class AudioMix {\n  constructor(app) { this.app = app; this.audio = null; this.built = false; this.synths = []; this.voiceFor = null; this.song = null; this.lastVoice = null; this.silent = false; this.kerbT = 0; this.lastLoud = 0; }\n  attach(audio) {\n    if (this.audio === audio) return; this.audio = audio; this.built = false; this.synths = [];\n    for (const [k, v] of Object.entries(SFX)) audio.register(k, v);\n  }\n  ensure() {\n    const a = this.audio; if (this.built || !a?.context) return !!this.built;\n    const c = a.context; this.built = true; this.ctx = c; this.noise = noiseBuffer(c);\n    this.master = c.createGain(); this.master.connect(c.destination);\n    this.analyser = c.createAnalyser?.() ?? null; if (this.analyser) { this.analyser.fftSize = 1024; this.master.connect(this.analyser); }\n    this.voices = c.createGain(); this.voices.connect(c.destination);\n    const loop = (filterType, freq, Q = 1) => { const s = c.createBufferSource(); s.buffer = this.noise; s.loop = true; const f = c.createBiquadFilter(); f.type = filterType; f.frequency.value = freq; f.Q.value = Q; const g = c.createGain(); g.gain.value = 0; s.connect(f); f.connect(g); g.connect(this.master); s.start(); return { s, f, g }; };\n    this.tyre = loop('bandpass', 2100, 7); this.wind = loop('lowpass', 900); this.gravel = loop('lowpass', 500, 0.8); this.rain = loop('highpass', 3000); this.crowd = loop('bandpass', 900, 0.6);\n    const k = c.createOscillator(); k.type = 'square'; k.frequency.value = 40; const kg = c.createGain(); kg.gain.value = 0; const kf = c.createBiquadFilter(); kf.type = 'lowpass'; kf.frequency.value = 500; k.connect(kf); kf.connect(kg); kg.connect(this.master); k.start(); this.kerb = { o: k, g: kg };\n    return true;\n  }\n  // Scales our graph by the engine's volumes every frame, respecting mute.\n  volumes() {\n    if (!this.built) return;\n    const v = this.audio.volume, on = !v.muted && !this.silent, t = this.ctx.currentTime;\n    this.master.gain.setTargetAtTime(on ? v.master * v.sfx : 0, t, 0.02);\n    this.voices.gain.setTargetAtTime(on ? v.master * (this.app.options?.voices ?? 0.8) : 0, t, 0.02);\n  }\n  sfx(name, o) { if (this.silent) return; this.audio?.play(name, o); }\n  count(name) { if (this.audio) this.audio.counts[name] = (this.audio.counts[name] ?? 0) + 1; }\n  music(songId) {\n    if (!this.audio) return;\n    if (this.song === songId && this.audio.playing) return;\n    if (songId === null) { this.audio.playMusic(null); this.song = null; return; }\n    this.song = songId; this.audio.playMusic(SONGS[songId], songId);\n  }\n  say(text, speaker) {\n    this.count('voice'); if (this.silent) return;\n    if (!this.ensure()) { this.lastLine = { text, speaker }; return; }\n    this.lastVoice?.stop(); this.lastVoice = speak(this.ctx, this.voices, this.noise, text, speaker, 0.55);\n    this.lastLine = { text, speaker };\n  }\n  stopVoice() { this.lastVoice?.stop(); this.lastVoice = null; }\n  // ---- cars: one synth per listened-to car, reassigned as cars come and go. ----\n  synthFor(slot, carKey, carId, p) {\n    if (!this.ensure()) return null;\n    let s = this.synths[slot];\n    if (s && s.key === carKey) return s.synth;\n    if (s) { s.synth.dispose(); }\n    const synth = new EngineSynth(this.ctx, this.master, engineData(carId, p), { noise: this.noise });\n    this.synths[slot] = { key: carKey, synth };\n    return synth;\n  }\n  // list: [{ key, carId, p, rpm, throttle, spool, gain, pan }]. Slot 0 is the driver's own.\n  engines(list, dt) {\n    this.volumes(); this.lastEngines = list;\n    if (!this.built && !this.ensure()) return;\n    for (let i = 0; i < 4; i++) { const it = list[i], s = it ? this.synthFor(i, it.key, it.carId, it.p) : this.synths[i]?.synth; if (!s) continue; if (it) s.set({ rpm: it.rpm, throttle: it.throttle, spool: it.spool, gain: it.gain, pan: it.pan, dt }); else s.silence(); }\n  }\n  // state: { tyre, wind, gravel, rain, kerb, crowd }: gains 0..1.\n  world(st) {\n    if (!this.built) return;\n    const t = this.ctx.currentTime, k = 0.05;\n    this.tyre.g.gain.setTargetAtTime((st.tyre ?? 0) * 0.14, t, k); this.tyre.f.frequency.setTargetAtTime(1900 + (st.tyrePitch ?? 0) * 900, t, k);\n    this.wind.g.gain.setTargetAtTime((st.wind ?? 0) * 0.18, t, k); this.wind.f.frequency.setTargetAtTime(500 + (st.wind ?? 0) * 1600, t, k);\n    this.gravel.g.gain.setTargetAtTime((st.gravel ?? 0) * 0.28, t, k); this.rain.g.gain.setTargetAtTime((st.rain ?? 0) * 0.07, t, 0.2); this.crowd.g.gain.setTargetAtTime((st.crowd ?? 0) * 0.08, t, 0.25);\n    this.kerb.g.gain.setTargetAtTime((st.kerb ?? 0) * 0.08, t, 0.02); this.kerb.o.frequency.setTargetAtTime(20 + (st.kerbRate ?? 0) * 3, t, 0.03);\n  }\n  quiet() {\n    if (!this.built) return;\n    for (const s of this.synths) s?.synth.silence();\n    this.world({});\n  }\n  clearCars() { for (const s of this.synths) { try { s?.synth.dispose(); } catch { /* gone */ } } this.synths = []; if (this.built) this.world({}); }\n  // Stops everything, for the hub's `end`.\n  stopAll() { this.silent = true; this.stopVoice(); this.clearCars(); this.audio?.playMusic(null); this.song = null; if (this.built) { this.master.gain.value = 0; this.voices.gain.value = 0; } }\n  level() { if (!this.analyser) return 0; const a = new Float32Array(this.analyser.fftSize); this.analyser.getFloatTimeDomainData(a); let m = 0; for (const v of a) m = Math.max(m, Math.abs(v)); return m; }\n}\nEOF\necho ok","description":"Write glyphs, UI framework, engine synth, voices, songs, SFX and audio mix"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18348,"cache_read_input_tokens":294321,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18348},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"fed78e2d-227b-4176-b3a1-9d062613ced2","timestamp":"2026-11-06T00:44:58.307Z","request_id":"req_011Cgkk7dLxrfCc9kD7oBriS","wire_tool_inputs":{"toolu_01732DZFnJrFLiTQ28bgSQNc":{"command":"grep -n 'type Wave\\b' -A 4 src/API.md | cut -c1-200; cat > src/game/ui/glyphs.js <<'EOF'\n// Button glyphs as pixel sprites. PlayStation and Xbox sets, keycaps and mouse icons. prompt() picks by the last device used.\nconst SHAPE = {\n  cross: ['.........', '.x.....x.', '..x...x..', '...x.x...', '....x....', '...x.x...', '..x...x..', '.x.....x.', '.........'],\n  circle: ['.........', '...xxx...', '..x...x..', '.x.....x.', '.x.....x.', '.x.....x.', '..x...x..', '...xxx...', '.........'],\n  square: ['.........', '.xxxxxxx.', '.x.....x.', '.x.....x.', '.x.....x.', '.x.....x.', '.x.....x.', '.xxxxxxx.', '.........'],\n  triangle: ['.........', '....x....', '....x....', '...x.x...', '...x.x...', '..x...x..', '..x...x..', '.xxxxxxx.', '.........'],\n};\nconst COLOURS = { cross: 'sky', circle: 'red', square: 'orange', triangle: 'lime' };\nconst XBOX = { cross: ['A', 'lime'], circle: ['B', 'red'], square: ['X', 'sky'], triangle: ['Y', 'sand'] };\nconst DISC = ['...xxxxx...', '..xxxxxxx..', '.xxxxxxxxx.', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', '.xxxxxxxxx.', '..xxxxxxx..', '...xxxxx...'];\nconst DPAD = ['....xxx....', '....xxx....', '....xxx....', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', '....xxx....', '....xxx....', '....xxx....'];\nconst STICK = ['...xxxxx...', '..x.....x..', '.x..xxx..x.', 'x..xxxxx..x', 'x..xxxxx..x', 'x..xxxxx..x', '.x..xxx..x.', '..x.....x..', '...xxxxx...'];\nconst MOUSE_L = ['..xxxxx..', '.xoox.xx.', '.xoox.xx.', '.xoox.xx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '..xxxxx..'];\nconst MOUSE_R = ['..xxxxx..', '.xx.xoox.', '.xx.xoox.', '.xx.xoox.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '..xxxxx..'];\nconst MOUSE_W = ['..xxxxx..', '.xx.o.xx.', '.xx.o.xx.', '.xx.o.xx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '.xxxxxxx.', '..xxxxx..'];\n// Every prompt action: what it shows on each device.\nexport const ACTION_GLYPHS = {\n  confirm: { pad: 'cross', key: 'ENTER', mouse: 'lmb' }, back: { pad: 'circle', key: 'ESC', mouse: 'rmb' }, alt: { pad: 'square', key: 'T', mouse: 'key:T' }, info: { pad: 'triangle', key: 'I', mouse: 'key:I' },\n  tabL: { pad: 'L1', key: 'Q', mouse: 'key:Q' }, tabR: { pad: 'R1', key: 'E', mouse: 'key:E' }, tabs: { pad: 'L1 R1', key: 'Q E', mouse: 'key:Q E' },\n  move: { pad: 'dpad', key: 'ARROWS', mouse: 'mouse' }, moveX: { pad: 'dpad', key: '< >', mouse: 'wheel' }, wheel: { pad: 'dpad', key: '< >', mouse: 'wheel' },\n  pause: { pad: 'options', key: 'ESC', mouse: 'key:ESC' }, steer: { pad: 'stick', key: 'A D', mouse: 'key:A D' }, throttle: { pad: 'R2', key: 'W', mouse: 'key:W' }, brake: { pad: 'L2', key: 'S', mouse: 'key:S' },\n  handbrake: { pad: 'square', key: 'SPACE', mouse: 'key:SPACE' }, shift: { pad: 'R1 L1', key: 'E Q', mouse: 'key:E Q' }, camera: { pad: 'triangle', key: 'C', mouse: 'key:C' }, lookBack: { pad: 'circle', key: 'B', mouse: 'key:B' }, look: { pad: 'stickR', key: 'DRAG', mouse: 'rmb' }, recover: { pad: 'triangle', key: 'R', mouse: 'key:R' },\n  drag: { pad: 'stickR', key: 'DRAG', mouse: 'lmb' }, more: { pad: 'triangle', key: 'M', mouse: 'key:M' }, focus: { pad: 'L1 R1', key: 'Q E', mouse: 'lmb' }, slow: { pad: 'R2', key: 'SHIFT', mouse: 'key:SHIFT' }, play: { pad: 'cross', key: 'ENTER', mouse: 'lmb' }, scrub: { pad: 'dpad', key: '< >', mouse: 'key:< >' }, hide: { pad: 'square', key: 'H', mouse: 'key:H' },\n};\nconst XBOX_NAMES = { L1: 'LB', R1: 'RB', L2: 'LT', R2: 'RT', 'L1 R1': 'LB RB', 'R1 L1': 'RB LB' };\nexport function glyphWidth(hud, spec, xbox) {\n  if (['cross', 'circle', 'square', 'triangle', 'dpad', 'stick', 'stickR', 'options'].includes(spec)) return 11;\n  if (spec === 'lmb' || spec === 'rmb' || spec === 'mouse' || spec === 'wheel') return 9;\n  const txt = spec.startsWith('key:') ? spec.slice(4) : xbox && XBOX_NAMES[spec] ? XBOX_NAMES[spec] : spec;\n  return hud.measure(txt).width + 6;\n}\n// Draws a glyph with top-left at (x, y). Returns its width.\nexport function drawGlyph(hud, x, y, spec, xbox = false) {\n  const col = { x: 'white', o: 'sand' };\n  if (SHAPE[spec]) {\n    hud.sprite(x, y, DISC, { x: 'night' });\n    if (xbox) { const [l, c] = XBOX[spec]; hud.text(x + 3, y + 2, l, { color: c, shadow: false }); }\n    else hud.sprite(x + 1, y + 1, SHAPE[spec], { x: COLOURS[spec] });\n    return 11;\n  }\n  if (spec === 'dpad') { hud.sprite(x, y + 1, DPAD, { x: 'mist' }); return 11; }\n  if (spec === 'stick' || spec === 'stickR') { hud.sprite(x, y + 1, STICK, { x: spec === 'stickR' ? 'sky' : 'mist' }); return 11; }\n  if (spec === 'options') { hud.sprite(x, y, DISC, { x: 'night' }); for (const k of [3, 5, 7]) hud.rect(x + 3, y + k, 5, 1, 'white'); return 11; }\n  if (spec === 'lmb') { hud.sprite(x, y + 1, MOUSE_L, col); return 9; }\n  if (spec === 'rmb') { hud.sprite(x, y + 1, MOUSE_R, col); return 9; }\n  if (spec === 'mouse') { hud.sprite(x, y + 1, MOUSE_W.map((r) => r.replace(/o/g, 'x')), col); return 9; }\n  if (spec === 'wheel') { hud.sprite(x, y + 1, MOUSE_W, col); return 9; }\n  const txt = spec.startsWith('key:') ? spec.slice(4) : xbox && XBOX_NAMES[spec] ? XBOX_NAMES[spec] : spec, w = hud.measure(txt).width + 6;\n  hud.rect(x, y, w, 11, 'mist'); hud.rect(x + 1, y + 1, w - 2, 9, 'night'); hud.rect(x + 1, y + 8, w - 2, 2, 'ink');\n  hud.text(x + 3, y + 2, txt, { color: 'white', shadow: false });\n  return w;\n}\nexport function specFor(action, device) { const g = ACTION_GLYPHS[action] ?? ACTION_GLYPHS.confirm; return g[device === 'pad' ? 'pad' : device === 'mouse' ? 'mouse' : 'key']; }\nEOF\ncat > src/game/ui/ui.js <<'EOF'\n// The menu system. Screens are a stack; each frame the top screen declares what is on it, in absolute art pixels.\n// There is always exactly one focused item, a thick box that slides to the next. Same screens for every input.\nimport { drawGlyph, glyphWidth, specFor } from './glyphs.js';\nconst lerp = (a, b, t) => a + (b - a) * t;\nexport function wrapText(text, chars = 60) {\n  const out = []; let line = '';\n  for (const w of String(text).split(' ')) { if ((line + ' ' + w).trim().length > chars) { out.push(line); line = w; } else line = (line + ' ' + w).trim(); }\n  if (line) out.push(line);\n  return out;\n}\nconst FONT_OK = /^[A-Z0-9 .,:;!?'\"()\\-+/%#=<>_*&@$\\[\\]\\\\|^~]*$/;\nexport const safeName = (name, fallback) => (name && FONT_OK.test(String(name).toUpperCase()) ? String(name).toUpperCase() : fallback);\nexport class UI {\n  constructor(app) {\n    this.app = app; this.stack = []; this.items = []; this.time = 0; this.box = { x: 0, y: 0, w: 0, h: 0, ready: false }; this.hud = null; this.w = 480; this.h = 270; this.cx = 240; this.promptList = []; this.clicks = []; this.pointer = { x: -1, y: -1 }; this.lastPtr = { x: -1, y: -1 }; this.pointerMoved = false; this.locked = 0; this.subtitle = null; this.toast = null;\n  }\n  get top() { return this.stack[this.stack.length - 1] ?? null; }\n  push(screen) { this.stack.push(screen); screen.t = 0; screen.enter?.(this); this.box.ready = false; return screen; }\n  pop() { const s = this.stack.pop(); s?.exit?.(this); this.box.ready = false; const t = this.top; if (t) { t.t = 0; t.resume?.(this); } return s; }\n  replace(screen) { const s = this.stack.pop(); s?.exit?.(this); return this.push(screen); }\n  clear() { while (this.stack.length) this.stack.pop()?.exit?.(this); }\n  popTo(pred) { while (this.stack.length && !pred(this.top)) this.pop(); }\n  // ---- drawing, top-left origin ----\n  text(x, y, str, o = {}) {\n    const hud = this.hud, s = String(str), scale = o.scale ?? 1;\n    let X = x;\n    if (o.align === 'center') X = Math.round(x - hud.measure(s, scale).width / 2); else if (o.align === 'right') X = Math.round(x - hud.measure(s, scale).width);\n    hud.text(X, y, s, { color: o.color ?? 'white', scale, shadow: o.shadow === undefined ? 'ink' : o.shadow });\n  }\n  lines(x, y, list, o = {}) { (Array.isArray(list) ? list : wrapText(list, o.chars ?? 60)).forEach((l, i) => this.text(x, y + i * (o.gap ?? 10), l, o)); }\n  rect(x, y, w, h, color) { this.hud.rect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), color); }\n  frameRect(x, y, w, h, color, t = 1) { this.rect(x, y, w, t, color); this.rect(x, y + h - t, w, t, color); this.rect(x, y, t, h, color); this.rect(x + w - t, y, t, h, color); }\n  panel(x, y, w, h, { color = 'ink', border = 'night', scan = false, gap = 2 } = {}) {\n    if (scan) for (let k = 0; k < h; k += gap) this.rect(x, y + k, w, 1, color); else this.rect(x, y, w, h, color);\n    if (border) this.frameRect(x, y, w, h, border);\n  }\n  sprite(x, y, rows, colors) { this.hud.sprite(Math.round(x), Math.round(y), rows, colors); }\n  bar(x, y, w, h, f, color = 'lime', back = 'night') { this.rect(x, y, w, h, back); this.rect(x, y, Math.round(w * Math.max(0, Math.min(1, f))), h, color); }\n  // ---- items ----\n  item(id, x, y, w, h, o = {}) { const it = { id, x, y, w, h, ...o }; this.items.push(it); return it.id === this.focusId; }\n  focused(id) { return this.focusId === id; }\n  // A button with a label: drawn now, focus box comes at the end.\n  button(id, x, y, w, h, label, o = {}) {\n    const f = this.item(id, x, y, w, h, o);\n    const bg = o.disabled ? 'ink' : f ? 'navy' : o.bg ?? 'night', col = o.disabled ? 'slate' : f ? 'white' : o.color ?? 'mist';\n    this.rect(x, y, w, h, bg); this.rect(x, y + h - 2, w, 2, 'ink');\n    const scale = o.scale ?? 1, ty = Math.round(y + (h - 7 * scale) / 2) - (h > 12 ? 1 : 0);\n    if (o.left) this.text(x + 6, ty, label, { color: col, scale }); else this.text(x + w / 2, ty, label, { color: col, scale, align: 'center' });\n    if (o.right) this.text(x + w - 6, ty, o.right, { color: o.rightColor ?? 'sand', align: 'right' });\n    return f;\n  }\n  slider(id, x, y, w, h, label, value, min, max, o = {}) {\n    const f = this.item(id, x, y, w, h, { ...o, slider: { value, min, max, step: o.step ?? (max - min) / 20, set: o.set, reset: o.reset } });\n    this.rect(x, y, w, h, f ? 'navy' : 'night');\n    this.text(x + 6, y + Math.round((h - 7) / 2), label, { color: f ? 'white' : 'mist' });\n    const bw = o.barW ?? Math.floor(w * 0.42), bx = x + w - bw - (o.valueW ?? 34), by = y + Math.round(h / 2) - 2, frac = (value - min) / (max - min || 1);\n    this.rect(bx, by, bw, 4, 'ink'); this.rect(bx, by, Math.round(bw * frac), 4, f ? 'lime' : 'mist'); this.rect(bx + Math.round((bw - 3) * frac), by - 2, 3, 8, 'white');\n    this.text(x + w - 5, y + Math.round((h - 7) / 2), o.format ? o.format(value) : value.toFixed(2), { align: 'right', color: f ? 'sand' : 'mist' });\n    const it = this.items[this.items.length - 1]; it.bar = { x: bx, w: bw };\n    return f;\n  }\n  tabs(id, x, y, w, labels, index, onChange) {\n    const tw = Math.floor(w / labels.length);\n    labels.forEach((l, i) => { const on = i === index; this.rect(x + i * tw, y, tw - 1, 12, on ? 'navy' : 'night'); this.text(x + i * tw + (tw - 1) / 2, y + 3, l, { align: 'center', color: on ? 'sand' : 'slate' }); this.clicks.push({ x: x + i * tw, y, w: tw - 1, h: 12, fn: () => onChange(i) }); });\n    if (this.app.actions.pressed('tabL')) { onChange((index - 1 + labels.length) % labels.length); this.app.mix?.sfx('tick'); }\n    if (this.app.actions.pressed('tabR')) { onChange((index + 1) % labels.length); this.app.mix?.sfx('tick'); }\n  }\n  header(title, sub = null) {\n    this.text(10, 8, title, { scale: 2, color: 'sand', shadow: 'ink' });\n    if (sub) this.text(10, 26, sub, { color: 'mist' });\n  }\n  prompts(list) { this.promptList = list; }\n  // A speaking line: voice once, subtitle in full.\n  say(speaker, text, seconds = null) { const app = this.app; app.mix?.say(text, speaker); this.subtitle = { speaker, text, t: seconds ?? Math.max(3.5, text.length * 0.09) }; }\n  drawSubtitle(dt) {\n    const s = this.subtitle; if (!s) return;\n    s.t -= dt; if (s.t <= 0) { this.subtitle = null; return; }\n    const lines = wrapText(s.text, Math.min(60, Math.floor((this.w - 40) / 6))), h = 16 + lines.length * 10, y = this.h - 36 - h, w = Math.min(this.w - 20, 372), x = Math.round(this.cx - w / 2);\n    this.panel(x, y, w, h, { color: 'ink', border: 'slate' });\n    const name = this.app.speakers?.[s.speaker]?.name ?? s.speaker;\n    this.text(x + 6, y + 4, name, { color: 'sand' });\n    lines.forEach((l, i) => this.text(x + 6, y + 14 + i * 10, l));\n  }\n  note(text, seconds = 2.4) { this.toast = { text, t: seconds }; }\n  // ---- the frame ----\n  frame(ctx, dt) {\n    this.hud = ctx.hud; this.ctx = ctx; this.time += dt; this.w = ctx.hud.width; this.h = ctx.hud.height; this.cx = this.w / 2;\n    const a = this.app.actions, p = ctx.input.pointer;\n    this.pointer.x = ((p.x + 1) / 2) * this.w; this.pointer.y = ((1 - p.y) / 2) * this.h;\n    this.pointerMoved = Math.abs(this.pointer.x - this.lastPtr.x) + Math.abs(this.pointer.y - this.lastPtr.y) > 0.5;\n    this.lastPtr.x = this.pointer.x; this.lastPtr.y = this.pointer.y;\n    this.items.length = 0; this.promptList = []; this.clicks.length = 0;\n    const top = this.top;\n    if (top) {\n      top.t = (top.t ?? 0) + dt;\n      if (top.overlayOf) top.overlayOf.draw?.(this, dt);\n      this.focusId = top.focus ?? null;\n      top.draw?.(this, dt);\n      if (this.top === top) this.finish(top, a, dt);\n    }\n    this.drawSubtitle(dt);\n    if (this.toast) { this.toast.t -= dt; if (this.toast.t <= 0) this.toast = null; else { const w = this.hud.measure(this.toast.text).width + 12, x = Math.round(this.cx - w / 2); this.panel(x, 34, w, 13, { color: 'plum', border: 'red' }); this.text(this.cx, 37, this.toast.text, { align: 'center' }); } }\n  }\n  finish(top, a, dt) {\n    const items = this.items;\n    if (items.length) {\n      let cur = items.find((i) => i.id === top.focus);\n      if (!cur) { cur = items.find((i) => i.id === top.defaultFocus) ?? items.find((i) => !i.disabledFocus) ?? items[0]; top.focus = cur.id; this.focusId = cur.id; }\n      if (!top.inputOff && this.locked <= 0) cur = this.navigate(top, cur, a) ?? cur;\n      // The focus box slides.\n      const b = this.box, sp = 1 - Math.exp(-dt * 22);\n      if (!b.ready) { Object.assign(b, { x: cur.x, y: cur.y, w: cur.w, h: cur.h, ready: true }); }\n      b.x = lerp(b.x, cur.x, sp); b.y = lerp(b.y, cur.y, sp); b.w = lerp(b.w, cur.w, sp); b.h = lerp(b.h, cur.h, sp);\n      if (!cur.noBox) { const col = Math.sin(this.time * 6) > 0 ? 'sand' : 'white', x = Math.round(b.x) - 2, y = Math.round(b.y) - 2, w = Math.round(b.w) + 4, h = Math.round(b.h) + 4; this.frameRect(x, y, w, h, col, 2); }\n    } else if (!top.inputOff && this.locked <= 0) {\n      if (a.pressed('confirm')) top.onConfirm?.(this);\n    }\n    if (!top.inputOff && this.locked <= 0) {\n      if (a.pressed('back')) { if (top.onBack) { if (top.onBack(this) !== false) this.app.mix?.sfx('back'); } else if (this.stack.length > 1 && !top.noBack) { this.app.mix?.sfx('back'); this.pop(); } }\n      if (a.rclicked) a.inject('back');\n      if (a.pressed('info')) top.onInfo?.(this);\n      if (a.pressed('alt')) top.onAlt?.(this);\n    }\n    this.locked -= dt;\n    this.drawPrompts(a);\n    // Clicks on tabs and prompts.\n    if (a.clicked && this.locked <= 0) for (const c of this.clicks) if (this.inRect(c)) { c.fn(); break; }\n  }\n  inRect(r) { const p = this.pointer; return p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h; }\n  navigate(top, cur, a) {\n    const items = this.items; let moved = null;\n    // Mouse: hover moves the focus, click confirms.\n    if (this.pointerMoved || a.clicked) { const hit = items.find((i) => this.inRect(i)); if (hit && hit.id !== cur.id) { top.focus = hit.id; moved = hit; this.app.mix?.sfx('tick'); } }\n    const dx = a.moveX(), dy = a.moveY();\n    if ((dx || dy) && !moved) {\n      if (dx && cur.slider) { this.nudge(cur, dx); return cur; }\n      if (dx && cur.onX) { cur.onX(dx); return cur; }\n      if (dy && cur.onY) { cur.onY(dy); return cur; }\n      const c0 = { x: cur.x + cur.w / 2, y: cur.y + cur.h / 2 }; let best = null, bs = Infinity;\n      for (const i of items) {\n        if (i === cur) continue;\n        const cx = i.x + i.w / 2, cy = i.y + i.h / 2, vx = cx - c0.x, vy = cy - c0.y, along = dx ? vx * dx : vy * dy, across = dx ? Math.abs(vy) : Math.abs(vx);\n        if (along <= 1) continue;\n        const score = along + across * 2.2; if (score < bs) { bs = score; best = i; }\n      }\n      if (!best && top.wrapFocus !== false) { // wrap around in the pressed direction\n        const list = items.filter((i) => (dx ? Math.abs(i.y + i.h / 2 - c0.y) < 8 : Math.abs(i.x + i.w / 2 - c0.x) < 40));\n        if (list.length > 1) best = (dx > 0 || dy > 0) ? list.reduce((p, q) => ((dx ? q.x < p.x : q.y < p.y) ? q : p)) : list.reduce((p, q) => ((dx ? q.x > p.x : q.y > p.y) ? q : p));\n      }\n      if (best && best !== cur) { top.focus = best.id; moved = best; this.app.mix?.sfx('tick'); }\n    }\n    const now = moved ?? cur;\n    if (a.wheel && now.slider) this.nudge(now, -Math.sign(a.wheel));\n    // Dragging a slider with the mouse.\n    if (now.slider && now.bar && this.ctx.input.isDown('MouseLeft') && this.inRect(now)) { const f = Math.max(0, Math.min(1, (this.pointer.x - now.bar.x) / now.bar.w)), s = now.slider; s.set?.(s.min + (s.max - s.min) * f); }\n    if (a.pressed('confirm') || (a.clicked && this.inRect(now))) {\n      if (now.slider && !a.clicked) { now.slider.reset?.(); this.app.mix?.sfx('tick'); }\n      else if (!now.slider) {\n        if (now.denied) { this.app.mix?.sfx('denied'); now.denied(); }\n        else if (now.confirm) { if (now.quiet !== true) this.app.mix?.sfx('confirm'); now.confirm(); }\n      }\n    }\n    return now;\n  }\n  nudge(it, dir) { const s = it.slider; let v = s.value + dir * s.step; v = Math.max(s.min, Math.min(s.max, v)); s.set?.(v); this.app.mix?.sfx('tick'); }\n  drawPrompts(a) {\n    const list = this.promptList; if (!list.length) return;\n    const hud = this.hud, dev = a.lastDevice, xbox = this.app.options.glyphs === 'xbox', y = this.h - 15; let total = 0;\n    const specs = list.map(([act, label]) => { const spec = specFor(act, dev), gw = glyphWidth(hud, spec, xbox), lw = hud.measure(label).width; total += gw + 3 + lw + 12; return { act, label, spec, gw, lw }; });\n    total -= 12; let x = Math.max(6, Math.round(this.cx - total / 2));\n    this.rect(0, y - 3, this.w, 18, 'ink');\n    for (const s of specs) { drawGlyph(hud, x, y, s.spec, xbox); hud.text(x + s.gw + 3, y + 2, s.label, { color: 'mist', shadow: false }); const act = s.act; if (['back', 'confirm', 'alt', 'info', 'tabL', 'tabR'].includes(act)) this.clicks.push({ x, y: y - 2, w: s.gw + 3 + s.lw, h: 14, fn: () => a.inject(act) }); x += s.gw + 3 + s.lw + 12; }\n  }\n}\nEOF\ncat > src/game/audio/enginesynth.js <<'EOF'\n// The most important sound in the game. A Web Audio graph on any BaseAudioContext, so a test can render it offline.\n// Firing frequency f0 = rpm / 60 x cylinders / 2. Saw at f0, square at f0 / 2, triangle at 2 x f0, filtered noise for exhaust.\nexport function noiseBuffer(actx, seconds = 2) {\n  const n = Math.floor(actx.sampleRate * seconds), b = actx.createBuffer(1, n, actx.sampleRate), d = b.getChannelData(0); let s = 12345;\n  for (let i = 0; i < n; i++) { s = (Math.imul(s, 1103515245) + 12345) & 0x7fffffff; d[i] = (s / 0x7fffffff) * 2 - 1; }\n  return b;\n}\nexport class EngineSynth {\n  // data: { cylinders, filter, exhaust, turbo, sportExhaust, redline, idle }\n  constructor(actx, dest, data, shared = {}) {\n    this.ctx = actx; this.data = data; this.lastRpm = 0; this.lastThrottle = 0; this.crackle = 0; this.gainTarget = 1; this.lastLift = 0;\n    const t = actx.currentTime;\n    const osc = (type, g) => { const o = actx.createOscillator(); o.type = type; const a = actx.createGain(); a.gain.value = g; o.connect(a); o.start(t); return { o, a }; };\n    this.saw = osc('sawtooth', 0.34); this.sq = osc('square', 0.26); this.tri = osc('triangle', 0.14);\n    this.noise = actx.createBufferSource(); this.noise.buffer = shared.noise ?? noiseBuffer(actx); this.noise.loop = true; this.noise.start(t);\n    this.noiseBand = actx.createBiquadFilter(); this.noiseBand.type = 'bandpass'; this.noiseBand.Q.value = 0.9; this.noiseGain = actx.createGain(); this.noiseGain.gain.value = 0.2; this.noise.connect(this.noiseBand); this.noiseBand.connect(this.noiseGain);\n    this.lp = actx.createBiquadFilter(); this.lp.type = 'lowpass'; this.lp.Q.value = 1.1;\n    for (const v of [this.saw, this.sq, this.tri]) v.a.connect(this.lp);\n    this.noiseGain.connect(this.lp);\n    this.out = actx.createGain(); this.out.gain.value = 0;\n    this.pan = actx.createStereoPanner ? actx.createStereoPanner() : null;\n    this.lp.connect(this.out);\n    if (this.pan) { this.out.connect(this.pan); this.pan.connect(dest); } else this.out.connect(dest);\n    // Turbo: a whistle rising with spool, a puff of filtered noise on lift.\n    this.whistle = actx.createOscillator(); this.whistle.type = 'sine'; this.whistleGain = actx.createGain(); this.whistleGain.gain.value = 0; this.whistle.connect(this.whistleGain); this.whistleGain.connect(this.pan ?? dest); this.whistle.start(t);\n    this.puffSrc = actx.createBufferSource(); this.puffSrc.buffer = this.noise.buffer; this.puffSrc.loop = true; this.puffFilter = actx.createBiquadFilter(); this.puffFilter.type = 'highpass'; this.puffFilter.frequency.value = 1800; this.puffGain = actx.createGain(); this.puffGain.gain.value = 0; this.puffSrc.connect(this.puffFilter); this.puffFilter.connect(this.puffGain); this.puffGain.connect(this.pan ?? dest); this.puffSrc.start(t);\n    // Overrun crackle: short pops of noise with the sport exhaust.\n    this.crackleGain = actx.createGain(); this.crackleGain.gain.value = 0; this.crackleBand = actx.createBiquadFilter(); this.crackleBand.type = 'bandpass'; this.crackleBand.frequency.value = 900; this.crackleBand.Q.value = 2; this.noise.connect(this.crackleBand); this.crackleBand.connect(this.crackleGain); this.crackleGain.connect(this.pan ?? dest);\n    this.seed = 7; this.limT = 0;\n  }\n  set({ rpm, throttle, spool = 0, gain = 1, pan = 0, dt = 1 / 60 }) {\n    const d = this.data, a = this.ctx, t = a.currentTime, k = 0.012;\n    this.lastRpm = rpm; this.lastThrottle = throttle;\n    const cyl = d.cylinders ?? 4, f0 = Math.max(18, (rpm / 60) * (cyl / 2));\n    this.saw.o.frequency.setTargetAtTime(f0, t, k); this.sq.o.frequency.setTargetAtTime(f0 / 2, t, k); this.tri.o.frequency.setTargetAtTime(2 * f0, t, k);\n    const rn = Math.min(1.2, rpm / (d.redline ?? 7000)), cutoff = (d.filter ?? 1200) * (0.45 + 1.5 * throttle * rn + 0.75 * rn);\n    this.lp.frequency.setTargetAtTime(Math.min(9000, cutoff), t, k * 2);\n    this.noiseBand.frequency.setTargetAtTime(Math.min(4000, 220 + f0 * 1.6), t, k);\n    const loud = (d.exhaust ?? 1) * (d.sportExhaust ? 1.25 : 1);\n    this.noiseGain.gain.setTargetAtTime(0.14 * loud * (0.4 + throttle), t, k);\n    let body = (0.35 + 0.65 * throttle) * loud * gain;\n    // Rev-limiter stutter at redline.\n    if (rpm >= (d.redline ?? 7000) - 20 && throttle > 0.2) { this.limT += dt * 28; if (this.limT % 1 < 0.42) body *= 0.25; }\n    this.out.gain.setTargetAtTime(body * 0.5, t, 0.008);\n    if (this.pan) this.pan.pan.setTargetAtTime(Math.max(-1, Math.min(1, pan)), t, 0.03);\n    // Turbo\n    if (d.turbo) { this.whistle.frequency.setTargetAtTime(1500 + 3400 * spool, t, 0.04); this.whistleGain.gain.setTargetAtTime(0.032 * spool * spool * gain * (0.4 + throttle), t, 0.05); const lift = this.prevThrottle > 0.6 && throttle < 0.2 && spool > 0.45; if (lift) { this.puffGain.gain.cancelScheduledValues(t); this.puffGain.gain.setValueAtTime(0.13 * gain, t); this.puffGain.gain.exponentialRampToValueAtTime(0.0008, t + 0.26); } }\n    // Overrun crackle on lift.\n    if (d.sportExhaust && throttle < 0.08 && rpm > (d.redline ?? 7000) * 0.5) { this.seed = (Math.imul(this.seed, 1103515245) + 12345) & 0x7fffffff; if (this.seed % 100 < 9) { this.crackleGain.gain.cancelScheduledValues(t); this.crackleGain.gain.setValueAtTime(0.32 * gain, t); this.crackleGain.gain.exponentialRampToValueAtTime(0.001, t + 0.05); this.crackle++; } }\n    this.prevThrottle = throttle;\n  }\n  silence() { const t = this.ctx.currentTime; this.out.gain.setTargetAtTime(0, t, 0.03); this.whistleGain.gain.setTargetAtTime(0, t, 0.03); this.puffGain.gain.setTargetAtTime(0, t, 0.03); this.crackleGain.gain.setTargetAtTime(0, t, 0.03); }\n  dispose() { try { for (const v of [this.saw, this.sq, this.tri]) v.o.stop(); this.noise.stop(); this.whistle.stop(); this.puffSrc.stop(); } catch { /* already stopped */ } try { (this.pan ?? this.out).disconnect(); this.out.disconnect(); this.whistleGain.disconnect(); this.puffGain.disconnect(); this.crackleGain.disconnect(); } catch { /* already gone */ } }\n}\nEOF\ncat > src/game/audio/voice.js <<'EOF'\n// Gibberish voices, in code. Each letter is a syllable of 65-85 ms; vowels pick formants through two band-pass filters over a\n// saw; consonants add a 12 ms noise click; the sentence end falls and a question rises. The same words always make the same sound.\nimport { SPEAKERS } from '../data/text.js';\nconst FORMANTS = { A: [800, 1150], E: [400, 2000], I: [300, 2400], O: [450, 800], U: [325, 700] };\nconst VOWELS = Object.keys(FORMANTS);\nexport function syllables(text) {\n  const out = []; let h = 2166136261;\n  for (const ch of String(text).toUpperCase()) {\n    h = Math.imul(h ^ ch.charCodeAt(0), 16777619) >>> 0;\n    if (/[A-Z]/.test(ch)) { const vowel = VOWELS.includes(ch); out.push({ vowel, f: vowel ? FORMANTS[ch] : FORMANTS[VOWELS[h % 5]], length: 0.065 + ((h >>> 8) % 21) / 1000, detune: ((h >>> 13) % 13) - 6, click: !vowel }); }\n    else if (/[0-9]/.test(ch)) out.push({ vowel: true, f: FORMANTS[VOWELS[+ch % 5]], length: 0.07, detune: (+ch % 7) - 3, click: true });\n    else if (ch === ' ') out.push({ gap: 0.03 });\n    else if (/[.,;:!?]/.test(ch)) out.push({ gap: ch === ',' ? 0.09 : 0.16 });\n  }\n  return out;\n}\nexport function speak(actx, dest, noise, text, speakerId, gain = 0.5) {\n  const sp = SPEAKERS[speakerId] ?? SPEAKERS.arai, list = syllables(text), rises = /\\?\\s*$/.test(text), rate = sp.manner === 'fast' ? 0.72 : sp.manner === 'gravel' ? 0.95 : 1; let t = actx.currentTime + 0.02; const total = list.length, started = t, nodes = [];\n  list.forEach((s, i) => {\n    if (s.gap) { t += s.gap * rate; return; }\n    const pos = i / Math.max(1, total), end = pos > 0.82 ? (pos - 0.82) / 0.18 : 0, len = s.length * rate;\n    let pitch = sp.pitch * Math.pow(2, s.detune / 48);\n    if (rises) pitch *= 1 + end * 0.45; else pitch *= 1 - end * 0.3;\n    if (sp.manner === 'lilt' && end > 0) pitch *= 1 + Math.sin(end * 3.14) * 0.25;\n    const o = actx.createOscillator(); o.type = sp.wave === 'square' ? 'square' : 'sawtooth'; o.frequency.value = pitch;\n    const f1 = actx.createBiquadFilter(), f2 = actx.createBiquadFilter(); f1.type = 'bandpass'; f2.type = 'bandpass'; f1.frequency.value = s.f[0]; f2.frequency.value = s.f[1]; f1.Q.value = 5; f2.Q.value = 7;\n    const g = actx.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(gain, t + 0.008); g.gain.setValueAtTime(gain, t + len * 0.7); g.gain.linearRampToValueAtTime(0, t + len);\n    o.connect(f1); o.connect(f2); f1.connect(g); f2.connect(g); g.connect(dest); o.start(t); o.stop(t + len + 0.01); nodes.push(o);\n    if (s.click && noise) { const n = actx.createBufferSource(); n.buffer = noise; n.loopStart = (i % 7) * 0.1; const c = actx.createGain(), hp = actx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 2400; c.gain.setValueAtTime(gain * 0.55, t); c.gain.linearRampToValueAtTime(0, t + 0.012); n.connect(hp); hp.connect(c); c.connect(dest); n.start(t, (i % 13) * 0.05, 0.016); nodes.push(n); }\n    t += len;\n  });\n  return { until: t, started, stop() { for (const n of nodes) { try { n.stop(); } catch { /* done already */ } } } };\n}\nEOF\ncat > src/game/data/songs.js <<'EOF'\n// Eight original pieces as Song data. Square, triangle, saw, sine and noise only. Harmony written out as note steps.\nconst row = (s) => s.trim().split(/\\s+/).join(' ');\nconst rep = (s, n) => Array(n).fill(row(s)).join(' ');\nconst R = (n = 16) => Array(n).fill('.').join(' ');\n// Comping: a chord as four notes, arpeggiated in a pattern over one bar of 16 steps.\nconst arp = (a, b, c, d, pat = 'a . b . c . d . c . b . a . b .') => pat.replace(/\\b[abcd]\\b/g, (m) => ({ a, b, c, d }[m]));\nconst BRUSH = { wave: 'noise', decay: 0.06, volume: 0.05 }, KICK = { wave: 'sine', freqEnd: 40, sweepTime: 0.08, decay: 0.12, volume: 0.22 };\nexport const SONGS = {\n  lounge: { // Db: ii7, V7, Imaj7, vi7 with a turnaround. A bossa lounge with a soft sine lead.\n    bpm: 92,\n    tracks: { lead: { wave: 'sine', attack: 0.01, decay: 0.42, volume: 0.28, vibrato: { depth: 0.12, rate: 5 } }, comp: { wave: 'triangle', decay: 0.2, volume: 0.1 }, bass: { wave: 'triangle', decay: 0.28, volume: 0.24 }, brush: BRUSH },\n    patterns: {\n      a: { lead: row('. . F5 . Ab5 . . Gb5 . . Eb5 . . . Db5 .  C5 . . Eb5 . . Ab5 . Gb5 . . F5 . . Eb5 .  F5 . . . Ab5 . C6 . . Bb5 . Ab5 . . F5 .  Db5 . . F5 . . Ab5 . . . F5 . Db5 . . .'),\n        comp: `${arp('Eb4', 'Gb4', 'Bb4', 'Db5', '. . a . b . . c . d . . c . . b')} ${arp('Ab3', 'C4', 'Eb4', 'Gb4', '. . a . b . . c . d . . c . . b')} ${arp('Db4', 'F4', 'Ab4', 'C5', '. . a . b . . c . d . . c . . b')} ${arp('Bb3', 'Db4', 'F4', 'Ab4', '. . a . b . . c . d . . c . . b')}`,\n        bass: row('Eb2 . . Eb2 . . Bb2 . . . Eb2 . . Bb1 . .  Ab2 . . Ab2 . . Eb2 . . . Ab2 . . Gb2 . .  Db2 . . Db2 . . Ab2 . . . Db2 . . F2 . .  Bb1 . . Bb1 . . F2 . . . Bb1 . . Ab2 . .'),\n        brush: rep('C8 . . C8 . . C8 . C8 . . C8 . . C8 .', 4) },\n      b: { lead: row('Bb5 . . . Ab5 . F5 . . Eb5 . . Db5 . . .  Eb5 . Gb5 . Bb5 . . Ab5 . . Gb5 . Eb5 . . .  Db5 . F5 . Ab5 . . C6 . . Ab5 . F5 . . Eb5  Db5 . . . . . . . . . . . . . . .'),\n        comp: `${arp('Gb3', 'Bb3', 'Db4', 'F4', '. . a . b . . c . d . . c . . b')} ${arp('F3', 'A3', 'C4', 'Eb4', '. . a . b . . c . d . . c . . b')} ${arp('Bb3', 'Db4', 'F4', 'Ab4', '. . a . b . . c . d . . c . . b')} ${arp('Eb3', 'Gb3', 'Bb3', 'Db4', 'a . b . c . d . c . b . a . . .')}`,\n        bass: row('Gb2 . . Gb2 . . Db2 . . . Gb2 . . Db2 . .  F2 . . F2 . . C2 . . . F2 . . C2 . .  Bb1 . . Bb1 . . F2 . . . Bb1 . . F2 . .  Eb2 . . Eb2 . . Bb1 . Ab1 . . Ab1 . Ab2 . .'),\n        brush: rep('C8 . . C8 . . C8 . C8 . . C8 . . C8 .', 4) },\n    }, order: ['a', 'a', 'b', 'a'],\n  },\n  catalogue: { // Fmaj7, Em7, Dm7, G7, very slow, vibraphone-like.\n    bpm: 76,\n    tracks: { vibe: { wave: 'sine', decay: 0.9, volume: 0.22, vibrato: { depth: 0.18, rate: 4.2 } }, vibe2: { wave: 'sine', decay: 0.7, volume: 0.12, vibrato: { depth: 0.18, rate: 4.2 } }, bass: { wave: 'triangle', decay: 0.5, volume: 0.2 } },\n    patterns: { a: {\n      vibe: row('A5 . . . C6 . . . E6 . . . . . . .  G5 . . . B5 . . . D6 . . . . . . .  F5 . . . A5 . . . C6 . . . . . . .  D6 . . . B5 . . . G5 . . . F5 . . .'),\n      vibe2: row('F4 . . . . . A4 . . . C5 . . . . .  E4 . . . . . G4 . . . B4 . . . . .  D4 . . . . . F4 . . . A4 . . . . .  G4 . . . . . B4 . . . D5 . . . . .'),\n      bass: row('F2 . . . . . . . C3 . . . . . . .  E2 . . . . . . . B2 . . . . . . .  D2 . . . . . . . A2 . . . . . . .  G2 . . . . . . . D3 . . . . . . .') },\n      b: { vibe: row('C6 . . . A5 . . . F5 . . . E5 . . .  D6 . . . B5 . . . G5 . . . E5 . . .  A5 . . . F5 . . . D5 . . . F5 . . .  G5 . . . F5 . D5 . B4 . . . . . . .'),\n        vibe2: row('F4 . . . . . . . C5 . . . . . . .  E4 . . . . . . . B4 . . . . . . .  D4 . . . . . . . A4 . . . . . . .  G4 . . . . . . . . . . . . . . .'),\n        bass: row('F2 . . . . . . . A2 . . . . . . .  E2 . . . . . . . G2 . . . . . . .  D2 . . . . . . . F2 . . . . . . .  G2 . . . . . . . G2 . . . . . . .') } }, order: ['a', 'a', 'b', 'a'],\n  },\n  socket: { // Light funk, muted square. A minor pentatonic over Am7, D9.\n    bpm: 108,\n    tracks: { lead: { wave: 'square', duty: 0.25, decay: 0.09, volume: 0.12 }, clav: { wave: 'square', duty: 0.125, decay: 0.05, volume: 0.09 }, bass: { wave: 'triangle', decay: 0.14, volume: 0.26 }, hat: { wave: 'noise', decay: 0.03, volume: 0.05 }, snare: { wave: 'noise', decay: 0.1, volume: 0.1 } },\n    patterns: { a: {\n      lead: row('A4 . C5 . . D5 . . E5 . . G5 . . E5 .  D5 . . C5 . . A4 . . . C5 . D5 . . .  A4 . C5 . . D5 . . E5 . G5 . A5 . G5 .  E5 . D5 . C5 . . . A4 . . . . . . .'),\n      clav: row('. . A3 C4 . . A3 . . G3 . . C4 . . .  . . D4 F#4 . . D4 . . C4 . . E4 . . .  . . A3 C4 . . A3 . . G3 . . C4 . . .  . . D4 F#4 . . D4 . . C4 . . E4 . . .'),\n      bass: row('A2 . . A2 . . G2 . . E2 . . G2 . A2 .  D2 . . D2 . . F#2 . . A2 . . C3 . D3 .  A2 . . A2 . . G2 . . E2 . . G2 . A2 .  D2 . . D2 . . F#2 . . A2 . . G2 . E2 .'),\n      hat: rep('C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4) } }, order: ['a'],\n  },\n  exam: { // Sparse, metronomic, polite. C: a bass pulse and a three-note motif.\n    bpm: 120,\n    tracks: { tick: { wave: 'noise', decay: 0.02, volume: 0.05 }, bass: { wave: 'triangle', decay: 0.2, volume: 0.2 }, motif: { wave: 'sine', decay: 0.3, volume: 0.2 }, pad: { wave: 'triangle', attack: 0.04, decay: 0.8, volume: 0.05 } },\n    patterns: { a: { tick: rep('C8 . . . C8 . . . C8 . . . C8 . . .', 4), bass: rep('C2 . . . . . . . C2 . . . . . . .', 2) + ' ' + rep('G1 . . . . . . . G1 . . . . . . .', 2),\n      motif: row('. . . . . . . . E5 . G5 . C5 . . .  . . . . . . . . . . . . . . . .  . . . . . . . . D5 . G5 . B4 . . .  . . . . . . . . . . . . . . . .'),\n      pad: row('C4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . .  D4 . . . . . . . . . . . . . . .  F4 . . . . . . . . . . . . . . .') } }, order: ['a'],\n  },\n  apex: { // Driving chiptune rock. E minor: i, VI, III, VII with a lead hook.\n    bpm: 156,\n    tracks: { lead: { wave: 'square', duty: 0.5, decay: 0.16, volume: 0.13 }, gtr: { wave: 'saw', decay: 0.1, volume: 0.09 }, bass: { wave: 'triangle', decay: 0.12, volume: 0.28 }, kick: KICK, snare: { wave: 'noise', decay: 0.12, volume: 0.12 }, hat: { wave: 'noise', decay: 0.025, volume: 0.05 } },\n    patterns: { a: {\n      lead: row('E5 . . G5 . . B5 . A5 . G5 . E5 . . .  C5 . . E5 . . G5 . F#5 . E5 . C5 . . .  G5 . . B5 . . D6 . C6 . B5 . G5 . . .  D5 . . F#5 . . A5 . B5 . A5 . F#5 . D5 .'),\n      gtr: `${rep('E3 E3 . E3 B3 . E3 .', 2)} ${rep('C3 C3 . C3 G3 . C3 .', 2)} ${rep('G3 G3 . G3 D4 . G3 .', 2)} ${rep('D3 D3 . D3 A3 . D3 .', 2)}`,\n      bass: `${rep('E2 . E2 . E2 . E2 E2', 2)} ${rep('C2 . C2 . C2 . C2 C2', 2)} ${rep('G2 . G2 . G2 . G2 G2', 2)} ${rep('D2 . D2 . D2 . D2 D2', 2)}`,\n      kick: rep('C2 . . . . . . . C2 . C2 . . . . .', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4), hat: rep('C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', 4) },\n      b: { lead: row('B5 . . . A5 . B5 . G5 . . . E5 . G5 .  A5 . . . G5 . A5 . F#5 . . . D5 . E5 .  B5 . . . A5 . B5 . D6 . . . B5 . G5 .  A5 . G5 . F#5 . E5 . F#5 . . . . . . .'),\n        gtr: `${rep('E3 . E3 . G3 . E3 .', 2)} ${rep('D3 . D3 . F#3 . D3 .', 2)} ${rep('C3 . C3 . E3 . C3 .', 2)} ${rep('B2 . B2 . D#3 . B2 .', 2)}`,\n        bass: `${rep('E2 E2 . E2 . E2 . E2', 2)} ${rep('D2 D2 . D2 . D2 . D2', 2)} ${rep('C2 C2 . C2 . C2 . C2', 2)} ${rep('B1 B1 . B1 . B1 . B1', 2)}`,\n        kick: rep('C2 . . . . . . . C2 . C2 . . . . .', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4), hat: rep('C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', 4) } }, order: ['a', 'a', 'b', 'a'],\n  },\n  city: { // City-pop groove. Bb: Imaj7, iii7, vi7, IV.\n    bpm: 118,\n    tracks: { lead: { wave: 'square', duty: 0.25, attack: 0.005, decay: 0.2, volume: 0.1, vibrato: { depth: 0.1, rate: 6 } }, keys: { wave: 'triangle', decay: 0.18, volume: 0.1 }, bass: { wave: 'square', duty: 0.5, decay: 0.12, volume: 0.13 }, kick: KICK, snare: { wave: 'noise', decay: 0.1, volume: 0.09 }, hat: { wave: 'noise', decay: 0.03, volume: 0.05 } },\n    patterns: { a: {\n      lead: row('D5 . F5 . A5 . . G5 . . F5 . D5 . . .  D5 . F5 . A5 . . C6 . . A5 . F5 . . .  C5 . Eb5 . G5 . . F5 . . Eb5 . C5 . . .  Eb5 . G5 . Bb5 . . A5 . . G5 . F5 . . .'),\n      keys: `${arp('Bb3', 'D4', 'F4', 'A4', '. . a b . . c . . d . . c . . .')} ${arp('D4', 'F4', 'A4', 'C5', '. . a b . . c . . d . . c . . .')} ${arp('G3', 'Bb3', 'D4', 'F4', '. . a b . . c . . d . . c . . .')} ${arp('Eb4', 'G4', 'Bb4', 'D5', '. . a b . . c . . d . . c . . .')}`,\n      bass: row('Bb1 . . Bb1 . . Bb2 . . F2 . . Bb1 . . .  D2 . . D2 . . D3 . . A2 . . D2 . . .  G1 . . G1 . . G2 . . D2 . . G1 . . .  Eb2 . . Eb2 . . Eb3 . . Bb2 . F2 . G2 . .'),\n      kick: rep('C2 . . . . . C2 . . . C2 . . . . .', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4), hat: rep('C8 . C8 C8 . C8 C8 . C8 . C8 C8 . C8 C8 .', 4) } }, order: ['a'],\n  },\n  clay: { // Twangy, galloping. G mixolydian.\n    bpm: 132,\n    tracks: { twang: { wave: 'saw', decay: 0.14, volume: 0.1, vibrato: { depth: 0.25, rate: 7 } }, gallop: { wave: 'square', duty: 0.25, decay: 0.05, volume: 0.08 }, bass: { wave: 'triangle', decay: 0.14, volume: 0.27 }, hat: { wave: 'noise', decay: 0.03, volume: 0.06 }, snare: { wave: 'noise', decay: 0.1, volume: 0.1 } },\n    patterns: { a: {\n      twang: row('G4 . B4 . D5 . . E5 . F5 . E5 D5 . B4 .  G4 . B4 . D5 . . E5 . F5 . G5 F5 . D5 .  F4 . A4 . C5 . . D5 . E5 . D5 C5 . A4 .  G4 . B4 . D5 . F5 . E5 . D5 . B4 . G4 .'),\n      gallop: rep('G3 . G3 G3 D3 . D3 D3 G3 . G3 G3 F3 . F3 F3', 2) + ' ' + rep('F3 . F3 F3 C3 . C3 C3 G3 . G3 G3 D3 . D3 D3', 2),\n      bass: rep('G2 . . . D2 . . . G2 . . . F2 . . .', 2) + ' ' + rep('F2 . . . C2 . . . G2 . . . D2 . . .', 2),\n      hat: rep('C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8', 4), snare: rep('. . . . C6 . . . . . . . C6 . . .', 4) } }, order: ['a'],\n  },\n  longDrive: { // Calm arpeggios that open out. D: Imaj7, V/vi, vi7, IVmaj7.\n    bpm: 84,\n    tracks: { arp: { wave: 'triangle', decay: 0.42, volume: 0.15 }, lead: { wave: 'sine', attack: 0.02, decay: 0.7, volume: 0.2, vibrato: { depth: 0.12, rate: 4.5 } }, bass: { wave: 'sine', decay: 0.7, volume: 0.24 } },\n    patterns: { a: {\n      arp: `${arp('D4', 'F#4', 'A4', 'C#5', 'a b c d c b a b a b c d c b a b')} ${arp('F#3', 'A#3', 'C#4', 'E4', 'a b c d c b a b a b c d c b a b')} ${arp('B3', 'D4', 'F#4', 'A4', 'a b c d c b a b a b c d c b a b')} ${arp('G3', 'B3', 'D4', 'F#4', 'a b c d c b a b a b c d c b a b')}`,\n      lead: row('F#5 . . . . . A5 . . . . . . . . .  E5 . . . . . C#5 . . . . . . . . .  D5 . . . . . F#5 . . . . . A5 . . .  B5 . . . A5 . F#5 . D5 . . . . . . .'),\n      bass: row('D2 . . . . . . . . . . . . . . .  F#2 . . . . . . . . . . . . . . .  B1 . . . . . . . . . . . . . . .  G2 . . . . . . . . . . . . . . .') } }, order: ['a'],\n  },\n  fanfare: { bpm: 180, loop: false, tracks: { a: { wave: 'square', duty: 0.25, decay: 0.3, volume: 0.2 }, b: { wave: 'triangle', decay: 0.3, volume: 0.2 } }, patterns: { a: { a: row('G5 . G5 . C6 . . . E6 . . . G6 . . . . . . .'), b: row('E4 . E4 . G4 . . . C5 . . . E5 . . . . . . .') } }, order: ['a'] },\n};\nvoid R;\nEOF\ncat > src/game/audio/sfx.js <<'EOF'\n// Every sound effect, as data. Menu ticks, thumps, chirps, chimes.\nexport const SFX = {\n  tick: { wave: 'square', duty: 0.25, freq: 1100, decay: 0.03, volume: 0.1 },\n  confirm: { wave: 'triangle', freq: 660, decay: 0.12, volume: 0.22, arp: [0, 7], arpRate: 0.05 },\n  back: { wave: 'triangle', freq: 440, freqEnd: 330, decay: 0.1, volume: 0.18 },\n  denied: { wave: 'square', duty: 0.5, freq: 160, decay: 0.16, volume: 0.16, crush: 6 },\n  register: { wave: 'triangle', freq: 1320, decay: 0.08, volume: 0.2, arp: [0, 5, 9], arpRate: 0.04, layers: [{ wave: 'noise', freq: 9000, decay: 0.02, volume: 0.1, delay: 0.1 }] },\n  coin: { wave: 'square', duty: 0.25, freq: 1800, decay: 0.05, volume: 0.09 },\n  whirr: { wave: 'saw', freq: 90, freqEnd: 150, attack: 0.08, decay: 0.3, volume: 0.05 },\n  gear: { wave: 'noise', freq: 2400, decay: 0.03, volume: 0.1, layers: [{ wave: 'square', freq: 140, decay: 0.04, volume: 0.1 }] },\n  gearDown: { wave: 'noise', freq: 1800, decay: 0.04, volume: 0.1, layers: [{ wave: 'square', freq: 110, decay: 0.05, volume: 0.1 }] },\n  thump: { wave: 'noise', freq: 600, decay: 0.14, volume: 0.3, layers: [{ wave: 'sine', freq: 90, freqEnd: 40, decay: 0.16, volume: 0.45 }] },\n  thumpBig: { wave: 'noise', freq: 420, decay: 0.3, volume: 0.42, layers: [{ wave: 'sine', freq: 70, freqEnd: 28, decay: 0.3, volume: 0.6 }, { wave: 'noise', freq: 4000, decay: 0.08, volume: 0.15 }] },\n  carHit: { wave: 'noise', freq: 900, decay: 0.1, volume: 0.25, layers: [{ wave: 'square', freq: 120, freqEnd: 60, decay: 0.1, volume: 0.2 }] },\n  landing: { wave: 'sine', freq: 80, freqEnd: 34, decay: 0.22, volume: 0.5, layers: [{ wave: 'noise', freq: 500, decay: 0.12, volume: 0.22 }] },\n  lockChirp: { wave: 'saw', freq: 2200, freqEnd: 1500, decay: 0.12, volume: 0.1 },\n  ratchet: { wave: 'noise', freq: 5000, decay: 0.03, volume: 0.08, layers: [{ wave: 'noise', freq: 5000, decay: 0.03, volume: 0.08, delay: 0.04 }, { wave: 'noise', freq: 5000, decay: 0.03, volume: 0.08, delay: 0.08 }] },\n  lapChime: { wave: 'triangle', freq: 988, decay: 0.3, volume: 0.22, arp: [0, 4, 7], arpRate: 0.07 },\n  bestLap: { wave: 'triangle', freq: 988, decay: 0.42, volume: 0.25, arp: [0, 4, 7, 12], arpRate: 0.07 },\n  beep: { wave: 'square', duty: 0.5, freq: 880, decay: 0.16, volume: 0.17 },\n  beepGo: { wave: 'square', duty: 0.5, freq: 1760, decay: 0.5, volume: 0.2 },\n  flag: { wave: 'triangle', freq: 784, decay: 0.32, volume: 0.25, arp: [0, 4, 7, 12, 16], arpRate: 0.08 },\n  wheelGun: { wave: 'saw', freq: 300, freqEnd: 900, decay: 0.24, volume: 0.16, crush: 5, layers: [{ wave: 'noise', freq: 3000, decay: 0.2, volume: 0.1 }] },\n  coneHit: { wave: 'square', freq: 500, freqEnd: 220, decay: 0.09, volume: 0.17 },\n  splash: { wave: 'noise', freq: 2200, decay: 0.3, volume: 0.16 },\n  brush: { wave: 'noise', freq: 3000, attack: 0.04, decay: 0.3, volume: 0.1 },\n  sting: { wave: 'triangle', freq: 523, decay: 0.5, volume: 0.2, arp: [0, 7, 12], arpRate: 0.12 },\n  fanfare2: { wave: 'square', duty: 0.25, freq: 523, decay: 0.8, volume: 0.17, arp: [0, 4, 7, 12, 16, 19], arpRate: 0.11, layers: [{ wave: 'triangle', freq: 262, decay: 0.8, volume: 0.17, arp: [0, 4, 7, 12], arpRate: 0.17 }] },\n  medal: { wave: 'triangle', freq: 659, decay: 0.5, volume: 0.25, arp: [0, 5, 9, 12], arpRate: 0.09 },\n  pop: { wave: 'noise', freq: 1500, decay: 0.08, volume: 0.15 },\n  firework: { wave: 'noise', freq: 800, decay: 0.45, volume: 0.15, layers: [{ wave: 'sine', freq: 120, freqEnd: 50, decay: 0.2, volume: 0.2 }] },\n};\nEOF\ncat > src/game/audio/mix.js <<'EOF'\n// All sound goes through here. The engine's AudioManager plays effects and music; this adds the engine synths, tyres, wind, rain and voices.\nimport { EngineSynth, noiseBuffer } from './enginesynth.js';\nimport { speak } from './voice.js';\nimport { SFX } from './sfx.js';\nimport { SONGS } from '../data/songs.js';\nimport { CAR_INFO } from '../data/cars.js';\nexport function engineData(carId, p) {\n  const i = CAR_INFO[carId];\n  return { cylinders: i?.cyl ?? 4, filter: i?.filter ?? 1200, exhaust: i?.exhaust ?? 1, turbo: !!p?.turbo, sportExhaust: !!p?.sportExhaust, redline: p?.redline ?? 7000, idle: p?.idle ?? 900 };\n}\nexport class AudioMix {\n  constructor(app) { this.app = app; this.audio = null; this.built = false; this.synths = []; this.voiceFor = null; this.song = null; this.lastVoice = null; this.silent = false; this.kerbT = 0; this.lastLoud = 0; }\n  attach(audio) {\n    if (this.audio === audio) return; this.audio = audio; this.built = false; this.synths = [];\n    for (const [k, v] of Object.entries(SFX)) audio.register(k, v);\n  }\n  ensure() {\n    const a = this.audio; if (this.built || !a?.context) return !!this.built;\n    const c = a.context; this.built = true; this.ctx = c; this.noise = noiseBuffer(c);\n    this.master = c.createGain(); this.master.connect(c.destination);\n    this.analyser = c.createAnalyser?.() ?? null; if (this.analyser) { this.analyser.fftSize = 1024; this.master.connect(this.analyser); }\n    this.voices = c.createGain(); this.voices.connect(c.destination);\n    const loop = (filterType, freq, Q = 1) => { const s = c.createBufferSource(); s.buffer = this.noise; s.loop = true; const f = c.createBiquadFilter(); f.type = filterType; f.frequency.value = freq; f.Q.value = Q; const g = c.createGain(); g.gain.value = 0; s.connect(f); f.connect(g); g.connect(this.master); s.start(); return { s, f, g }; };\n    this.tyre = loop('bandpass', 2100, 7); this.wind = loop('lowpass', 900); this.gravel = loop('lowpass', 500, 0.8); this.rain = loop('highpass', 3000); this.crowd = loop('bandpass', 900, 0.6);\n    const k = c.createOscillator(); k.type = 'square'; k.frequency.value = 40; const kg = c.createGain(); kg.gain.value = 0; const kf = c.createBiquadFilter(); kf.type = 'lowpass'; kf.frequency.value = 500; k.connect(kf); kf.connect(kg); kg.connect(this.master); k.start(); this.kerb = { o: k, g: kg };\n    return true;\n  }\n  // Scales our graph by the engine's volumes every frame, respecting mute.\n  volumes() {\n    if (!this.built) return;\n    const v = this.audio.volume, on = !v.muted && !this.silent, t = this.ctx.currentTime;\n    this.master.gain.setTargetAtTime(on ? v.master * v.sfx : 0, t, 0.02);\n    this.voices.gain.setTargetAtTime(on ? v.master * (this.app.options?.voices ?? 0.8) : 0, t, 0.02);\n  }\n  sfx(name, o) { if (this.silent) return; this.audio?.play(name, o); }\n  count(name) { if (this.audio) this.audio.counts[name] = (this.audio.counts[name] ?? 0) + 1; }\n  music(songId) {\n    if (!this.audio) return;\n    if (this.song === songId && this.audio.playing) return;\n    if (songId === null) { this.audio.playMusic(null); this.song = null; return; }\n    this.song = songId; this.audio.playMusic(SONGS[songId], songId);\n  }\n  say(text, speaker) {\n    this.count('voice'); if (this.silent) return;\n    if (!this.ensure()) { this.lastLine = { text, speaker }; return; }\n    this.lastVoice?.stop(); this.lastVoice = speak(this.ctx, this.voices, this.noise, text, speaker, 0.55);\n    this.lastLine = { text, speaker };\n  }\n  stopVoice() { this.lastVoice?.stop(); this.lastVoice = null; }\n  // ---- cars: one synth per listened-to car, reassigned as cars come and go. ----\n  synthFor(slot, carKey, carId, p) {\n    if (!this.ensure()) return null;\n    let s = this.synths[slot];\n    if (s && s.key === carKey) return s.synth;\n    if (s) { s.synth.dispose(); }\n    const synth = new EngineSynth(this.ctx, this.master, engineData(carId, p), { noise: this.noise });\n    this.synths[slot] = { key: carKey, synth };\n    return synth;\n  }\n  // list: [{ key, carId, p, rpm, throttle, spool, gain, pan }]. Slot 0 is the driver's own.\n  engines(list, dt) {\n    this.volumes(); this.lastEngines = list;\n    if (!this.built && !this.ensure()) return;\n    for (let i = 0; i < 4; i++) { const it = list[i], s = it ? this.synthFor(i, it.key, it.carId, it.p) : this.synths[i]?.synth; if (!s) continue; if (it) s.set({ rpm: it.rpm, throttle: it.throttle, spool: it.spool, gain: it.gain, pan: it.pan, dt }); else s.silence(); }\n  }\n  // state: { tyre, wind, gravel, rain, kerb, crowd }: gains 0..1.\n  world(st) {\n    if (!this.built) return;\n    const t = this.ctx.currentTime, k = 0.05;\n    this.tyre.g.gain.setTargetAtTime((st.tyre ?? 0) * 0.14, t, k); this.tyre.f.frequency.setTargetAtTime(1900 + (st.tyrePitch ?? 0) * 900, t, k);\n    this.wind.g.gain.setTargetAtTime((st.wind ?? 0) * 0.18, t, k); this.wind.f.frequency.setTargetAtTime(500 + (st.wind ?? 0) * 1600, t, k);\n    this.gravel.g.gain.setTargetAtTime((st.gravel ?? 0) * 0.28, t, k); this.rain.g.gain.setTargetAtTime((st.rain ?? 0) * 0.07, t, 0.2); this.crowd.g.gain.setTargetAtTime((st.crowd ?? 0) * 0.08, t, 0.25);\n    this.kerb.g.gain.setTargetAtTime((st.kerb ?? 0) * 0.08, t, 0.02); this.kerb.o.frequency.setTargetAtTime(20 + (st.kerbRate ?? 0) * 3, t, 0.03);\n  }\n  quiet() {\n    if (!this.built) return;\n    for (const s of this.synths) s?.synth.silence();\n    this.world({});\n  }\n  clearCars() { for (const s of this.synths) { try { s?.synth.dispose(); } catch { /* gone */ } } this.synths = []; if (this.built) this.world({}); }\n  // Stops everything, for the hub's `end`.\n  stopAll() { this.silent = true; this.stopVoice(); this.clearCars(); this.audio?.playMusic(null); this.song = null; if (this.built) { this.master.gain.value = 0; this.voices.gain.value = 0; } }\n  level() { if (!this.analyser) return 0; const a = new Float32Array(this.analyser.fftSize); this.analyser.getFloatTimeDomainData(a); let m = 0; for (const v of a) m = Math.max(m, Math.abs(v)); return m; }\n}\nEOF\necho ok","description":"Write glyphs, UI framework, engine synth, voices, songs, SFX and audio mix"}}}
