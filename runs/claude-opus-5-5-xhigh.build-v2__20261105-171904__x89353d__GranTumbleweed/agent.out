g down.\n2650-- `pitch?: number`: Pitch shift in semitones.\n2651-\n2652-### type VolumeChannel\n2653-\n2654-```ts\n2655-type VolumeChannel = 'master' | 'sfx' | 'music'\n2628:### interface SpatialOptions\n2629-\n2630-- `ref?: number`: Within this distance (m) the sound is at full volume (default 1).\n2631-- `max?: number`: Silent from this distance on (default 30); it fades out over the last fifth.\n2632-- `rolloff?: number`: How fast it falls off past `ref` (default 1: inverse distance, the way sound really does).\n2633-\n2634-### interface Voice\n2635-\n2636-A looping sound steered while it plays (`AudioManager.loop`): a hum, a fire, a waterfall.\n  177 src/game/ui/ui.js\n   53 src/game/ui/glyphs.js\n  106 src/game/render/carview.js\n  336 total\n7:const RIM_COLOURS = ['mist', 'white', 'sand', 'white'];\n8:const tyreGeom = new Map(), SPOKES = [[1, 'box'], [5, 'box'], [8, 'bar'], [3, 'box']];\n9:function wheelMesh(R, width, style, rimColour) {\n11:  if (!tyreGeom.has(key)) tyreGeom.set(key, new CylinderGeometry(R, R, width, 12).rotateZ(Math.PI / 2));\n12:  const tyre = new Mesh(tyreGeom.get(key), toonMaterial(PALETTE.ink));\n15:  const [n] = SPOKES[style] ?? SPOKES[0];\n19:const mudDefs = new Map();\n20:function mudDefFor(carId) {\n21:  if (mudDefs.has(carId)) return mudDefs.get(carId);\n24:  mudDefs.set(carId, def);\n47:    const style = this.install?.rims ?? 0, rimCol = RIM_COLOURS[style] ?? 'mist', width = row.clA > 1 ? 0.3 : 0.23, w\n49:      const pivot = new Group(), spin = wheelMesh(R, width, style, rimCol);\n68:    const mud = buildModel(mudDefFor(carId), {}).object;\nsrc/game/net/hub.js:11:import { drawGlyph, glyphWidth, specFor } from '../ui/glyphs.js';\nsrc/game/ui/screens/handbook.js:3:import { drawGlyph, specFor, glyphWidth } from '../glyphs.js';\nsrc/game/ui/ui.js:3:import { drawGlyph, glyphWidth, specFor } from './glyphs.js';\nsrc/game/scenes/race.js:17:import { drawGlyph, glyphWidth, specFor } from '../ui/glyphs.js';","stderr":"","interrupted":false