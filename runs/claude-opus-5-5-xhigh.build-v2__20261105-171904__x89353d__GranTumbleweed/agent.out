{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkizX4dH54qkYP1g93rS","type":"message","role":"assistant","content":[{"type":"text","text":"Now the data layer: cars, tyres, parts, licences, events and the writing. It's all plain data, so it can be validated and a designer can extend it later."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16089,"cache_read_input_tokens":180632,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16089},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"fe1edf6f-61fa-4087-97c8-d1655f93d140","timestamp":"2026-11-06T00:26:08.608Z","request_id":"req_011CgkizWpVgB8PDJ1H7HZ8j"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkizX4dH54qkYP1g93rS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JzLYvhGL7FFkUAmZ4Ci9Az","name":"Bash","input":{"command":"cat > src/game/data/meta.js <<'EOF'\n// Every on-screen use of the game's name reads TITLE.\nexport const TITLE = 'GRAN TUMBLEWEED';\nexport const SUBTITLE = 'THE PENINSULA DRIVING CATALOGUE';\nexport const MAKER = 'A CHUNKY PIXEL PRODUCTION';\nexport const SOURCE = 'Gran Turismo 3: A-Spec';\nexport const SAVE_KEY = 'gran-tumbleweed.profile';\nexport const OPTIONS_KEY = 'gran-tumbleweed.options';\nexport const SAVE_VERSION = 2;\nexport const START_CREDITS = 15000;\nexport const SEAT_COLOURS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nexport const SEAT_PAINT = ['red', 'blue', 'green', 'sand'];\nexport const PAINTS = ['red', 'orange', 'sand', 'lime', 'green', 'teal', 'blue', 'sky', 'cyan', 'white', 'mist', 'slate', 'navy', 'plum', 'ink', 'night'];\nexport const RIM_STYLES = ['DISH', 'FIVE SPOKE', 'MESH', 'RALLY'];\nEOF\ncat > src/game/data/cars.js <<'EOF'\n// The car catalogue. Physics rows are in carphysics.js; this file has what the showroom, the Museum and the sound need.\nimport { CARS as PHYSICS } from './carphysics.js';\nexport { PHYSICS };\nexport const MARQUES = {\n  tsubame: { name: 'TSUBAME', line: 'SMALL, CLEVER. THE SWALLOW RETURNS EACH YEAR.' },\n  kaminari: { name: 'KAMINARI', line: 'THUNDER, IN THE SERIOUS SENSE.' },\n  castellan: { name: 'CASTELLAN', line: 'A SHED, A LATHE, A PRINCIPLE.' },\n  brandt: { name: 'BRANDT', line: 'POLITE, AND TERRIFYING.' },\n  ironwood: { name: 'IRONWOOD', line: 'DISPLACEMENT AS A MORAL POSITION.' },\n  vespucci: { name: 'VESPUCCI', line: 'BEAUTIFUL. A LITTLE DRAMATIC.' },\n  halcyon: { name: 'HALCYON WORKS', line: 'THE PENINSULA\\'S OWN TINY RACE SHOP.' },\n};\n// where: used, dealer or prize. after: a licence that opens the dealer sale of a prize car.\nexport const CAR_INFO = {\n  pico: { name: 'TSUBAME PICO 660', short: 'PICO 660', marque: 'tsubame', year: 1991, price: 4800, where: 'used', paint: 'sky', cyl: 3, filter: 900, exhaust: 0.8, fenn: 'THE PICO. ONE OWNER. SHE WENT ONLY TO THE SHOPS AND BACK.', text: ['A CITY CAR OF 660 CC, MADE TO FIT WHERE OTHER CARS', 'CAN ONLY WISH TO GO. AT 720 KG IT HAS LITTLE TO HOLD', 'BACK AND LITTLE TO PUSH. IT TEACHES THE FIRST LESSON:', 'MOMENTUM IS EXPENSIVE.'] },\n  kite: { name: 'TSUBAME KITE 1.6 RS', short: 'KITE 1.6 RS', marque: 'tsubame', year: 1996, price: 12500, where: 'used', paint: 'red', cyl: 4, filter: 1300, exhaust: 1, fenn: 'A PREVIOUS OWNER. ONE CAREFUL WEEKEND. SHE HAS 88,000 KILOMETRES AND NO REGRETS.', text: ['THE KITE WAS A FAMILY HATCHBACK UNTIL THE ENGINEERS', 'STAYED LATE. THE 1.6-LITRE ENGINE ASKS TO BE REVVED,', 'AND THE FRONT TYRES DO ALL OF THE WORK. BRAKE BEFORE', 'THE CORNER AND IT WILL THANK YOU.'] },\n  ginga: { name: 'KAMINARI GINGA S', short: 'GINGA S', marque: 'kaminari', year: 1994, price: 14800, where: 'used', paint: 'white', cyl: 4, filter: 1100, exhaust: 1.1, fenn: 'REAR-WHEEL DRIVE, AND ONLY SOME OF THE MARKS ARE FROM THE PREVIOUS OWNER.', text: ['A FRONT-ENGINED, REAR-DRIVE COUPE IN GOOD USED', 'CONDITION. THE STEERING SPEAKS CLEARLY AND THE REAR', 'AXLE ANSWERS THE RIGHT FOOT. MANY DRIVERS LEARNED TO', 'DRIVE IN THIS CAR. SOME LEARNED TWICE.'] },\n  moth: { name: 'CASTELLAN MOTH 1.8', short: 'MOTH 1.8', marque: 'castellan', year: 1998, price: 24000, where: 'dealer', showroom: 0, paint: 'green', cyl: 4, filter: 1500, exhaust: 0.9, fenn: '860 KILOGRAMS. FORGIVE ME. I WILL BE ALL RIGHT IN A MOMENT.', text: ['TWO SEATS, ONE PURPOSE, 860 KG. CASTELLAN REMOVED', 'WHAT THE CAR DID NOT NEED, THEN REMOVED A LITTLE', 'MORE. THE POWER FIGURE IS MODEST. THAT IS NOT THE', 'FIGURE THAT MATTERS.'] },\n  ryu: { name: 'KAMINARI RYU 2.0T', short: 'RYU 2.0T', marque: 'kaminari', year: 1999, price: 39000, where: 'dealer', showroom: 0, paint: 'blue', cyl: 4, filter: 1000, exhaust: 1.2, fenn: 'FOUR DRIVEN WHEELS. THERE IS NO SUCH THING AS BAD WEATHER, ONLY LATE BRAKING.', text: ['TURBOCHARGED, FOUR-WHEEL DRIVE, BORN FOR A RALLY', 'RULE THAT NO LONGER EXISTS. POWER ARRIVES LATE AND', 'THEN ALL AT ONCE. IN THE RAIN, VERY LITTLE CAN KEEP', 'IT IN SIGHT.'] },\n  longhorn: { name: 'IRONWOOD LONGHORN 428', short: 'LONGHORN 428', marque: 'ironwood', year: 1969, price: 47000, where: 'dealer', showroom: 1, paint: 'orange', cyl: 8, filter: 700, exhaust: 1.5, fenn: 'THE BRAKES ARE ORIGINAL. I WOULD MENTION THIS EARLY.', text: ['A LARGE AMERICAN COUPE OF THE OLD SCHOOL: SEVEN', 'LITRES, 420 PS, AND BRAKES THAT REMEMBER A SIMPLER', 'TIME. IT DOES NOT LIKE CORNERS, AND IT SAYS SO. ON A', 'LONG STRAIGHT NOBODY ASKS IT TO APOLOGISE.'] },\n  brandt32: { name: 'BRANDT 3.2 CSR', short: 'BRANDT 3.2', marque: 'brandt', year: 2000, price: 58000, where: 'dealer', showroom: 1, paint: 'slate', cyl: 6, filter: 1600, exhaust: 1.05, fenn: 'THERE ARE FOUR DOORS. PLEASE DO NOT LET THAT REASSURE YOU.', text: ['A FOUR-DOOR SEDAN, ACCORDING TO THE CATALOGUE. THE', 'STRAIGHT SIX REACHES 7,900 RPM WITH AN EVEN TEMPER,', 'AND THE BALANCE IS CLOSE TO 50:50. BUSINESSMEN BOUGHT', 'IT FOR THE LEATHER. OTHERS DID NOT.'] },\n  heck: { name: 'BRANDT HECK 3.6', short: 'HECK 3.6', marque: 'brandt', year: 1997, price: 92000, where: 'dealer', showroom: 1, paint: 'sand', cyl: 6, filter: 1800, exhaust: 1.1, fenn: 'THE ENGINE IS BEHIND THE AXLE. IT HAS ALWAYS BEEN BEHIND THE AXLE. WE DO NOT DISCUSS IT.', text: ['THE ENGINE SITS BEHIND THE REAR AXLE, WHERE BRANDT', 'HAS INSISTED FOR FORTY YEARS THAT IT BELONGS.', 'TRACTION IS WONDERFUL. LIFTING IN MID-CORNER IS NOT', 'RECOMMENDED. THIS IS WRITTEN IN THE MANUAL.'] },\n  libeccio: { name: 'VESPUCCI LIBECCIO', short: 'LIBECCIO', marque: 'vespucci', year: 1995, price: 135000, where: 'dealer', showroom: 2, paint: 'red', cyl: 8, filter: 2000, exhaust: 1.25, fenn: 'THE SOUTH-WEST WIND. I HAVE WATCHED IT LEAVE THIS ROOM MANY TIMES.', text: ['NAMED FOR THE SOUTH-WEST WIND. A MID-ENGINED V8', 'WITH A LOW NOSE AND A HIGH OPINION OF ITSELF. LIGHT', 'ON THE FRONT WHEELS AT SPEED. PRECISE, IF YOU ARE.'] },\n  kiteCup: { name: 'TSUBAME KITE CUP RACER', short: 'KITE CUP', marque: 'tsubame', year: 2000, price: 0, where: 'prize', paint: 'lime', cyl: 4, filter: 2200, exhaust: 1.3, fenn: 'A PRIZE CAR. THESE DO NOT COME THROUGH MY DOOR.', text: ['A STRIPPED KITE FOR A ONE-MAKE SERIES, WITH A ROLL', 'CAGE WHERE THE REAR SEATS USED TO BE. 210 PS THROUGH', 'THE FRONT WHEELS ASKS FOR A PATIENT FOOT.'] },\n  ryuRally: { name: 'KAMINARI RYU RALLY SPEC', short: 'RYU RALLY', marque: 'kaminari', year: 1999, price: 0, where: 'prize', paint: 'cyan', cyl: 4, filter: 1400, exhaust: 1.5, fenn: 'A PRIZE CAR. THIS ONE ARRIVES WITH THE CLAY STILL ON IT.', text: ['WORKS GRAVEL SPECIFICATION: LONG TRAVEL, SHORT', 'GEARING, AND A BONNET THAT HAS SEEN WEATHER. ON DIRT', 'IT IS ANOTHER SPECIES. ON TARMAC IT SEEMS TO BE', 'LOOKING FOR THE EXIT.'] },\n  works: { name: 'KAMINARI GINGA WORKS GT', short: 'WORKS GT', marque: 'kaminari', year: 2000, price: 310000, where: 'prize', after: 'A', showroom: 2, paint: 'navy', cyl: 6, filter: 2600, exhaust: 1.6, fenn: 'I AM ALLOWED TO SELL THIS ONE AFTER YOUR NATIONAL LICENCE. I HOPE YOU UNDERSTAND WHY.', text: ['THE GINGA AS THE FACTORY WOULD LIKE TO REMEMBER IT.', '560 PS, CARBON PANELS, AND A WING WITH ITS OWN', 'OPINION ABOUT CORNER SPEED.'] },\n  corsa: { name: 'VESPUCCI LIBECCIO CORSA', short: 'CORSA', marque: 'vespucci', year: 1998, price: 520000, where: 'prize', after: 'A', showroom: 2, paint: 'red', cyl: 10, filter: 3000, exhaust: 1.7, fenn: 'TWENTY-FIVE WERE BUILT FOR THE ROAD. NONE OF THEM HAS ENJOYED IT.', text: ['HOMOLOGATED IN THE STRICTEST SENSE OF THE WORD:', 'VESPUCCI BUILT TWENTY-FIVE ROAD CARS SO THAT IT COULD', 'RACE THIS ONE. 620 PS. 1,100 KG. DO NOT LIFT.'] },\n  type9: { name: 'HALCYON TYPE 9 PROTOTYPE', short: 'TYPE 9', marque: 'halcyon', year: 2001, price: 0, where: 'prize', paint: 'white', cyl: 12, filter: 3400, exhaust: 1.8, fenn: 'THERE IS ONLY THE ONE. I WOULD LIKE TO STAND NEAR IT, IF YOU DO NOT MIND.', text: ['BUILT BY A SMALL WORKS TEAM ON THE PENINSULA, IN A', 'SHED, FOR ONE RACE. 780 PS, 930 KG, A CLOSED COCKPIT', 'AND NO RADIO. IT STOPS AS WELL AS IT GOES, WHICH', 'TAKES SOME TIME TO BELIEVE.'] },\n};\nexport const CAR_IDS = Object.keys(CAR_INFO);\nexport const SHOWROOMS = [\n  { id: 'used', name: 'THE USED LOT', line: 'FOUR WHEELS. A HISTORY. NO QUESTIONS.', cars: ['pico', 'kite', 'ginga'] },\n  { id: 'east', name: 'EASTERN MOTORS', line: 'LIGHTNESS AND THUNDER.', cars: ['moth', 'ryu'] },\n  { id: 'west', name: 'WESTERN IMPORTS', line: 'DISPLACEMENT AND DOCTRINE.', cars: ['longhorn', 'brandt32', 'heck'] },\n  { id: 'grand', name: 'THE GRAND SALON', line: 'PLEASE DO NOT TOUCH WITHOUT MONEY.', cars: ['libeccio', 'works', 'corsa'] },\n];\nexport const LAYOUT_WORDS = { FF: 'FRONT ENGINE, FRONT DRIVE', FR: 'FRONT ENGINE, REAR DRIVE', MR: 'MID ENGINE, REAR DRIVE', RR: 'REAR ENGINE, REAR DRIVE', '4WD': 'FOUR-WHEEL DRIVE' };\nexport const DRIVER_NAMES = ['T. HOLLIS', 'R. OKADA', 'M. VOSS', 'S. MIRA', 'L. BRANDO', 'K. ASHBY', 'J. TANAKA', 'P. FARROW', 'E. LINDQVIST', 'D. MARCH', 'A. COSTA', 'H. NAGANO', 'B. WREN', 'G. PELLEGRINI', 'N. ORTIZ', 'C. DUVAL'];\nEOF\ncat > src/game/data/tyres.js <<'EOF'\n// Tyres. Stock rows in carphysics.js stay in place until the player buys a set.\nexport const TYRES = {\n  street: { id: 'street', name: 'STREET', tyreMu: 0.95, alphaP: 0.14, dirt: 0.45, wearX: 0.8, price: 600, line: 'THEY LAST. THEY ALSO SQUEAL.' },\n  sport: { id: 'sport', name: 'SPORT', tyreMu: 1.0, alphaP: 0.125, dirt: 0.5, wearX: 1.0, price: 1200, line: 'A GOOD HONEST TYRE.' },\n  semi: { id: 'semi', name: 'SEMI-SLICK', tyreMu: 1.12, alphaP: 0.115, dirt: 0.42, wearX: 1.4, price: 4800, line: 'MORE GRIP. LESS OF THE TYRE AT THE END.' },\n  slick: { id: 'slick', name: 'RACING SLICK', tyreMu: 1.3, alphaP: 0.105, dirt: 0.35, wearX: 2.2, price: 12000, line: 'VERY FAST. VERY BRIEF. HOPELESS ON DIRT.' },\n  rally: { id: 'rally', name: 'RALLY DIRT', tyreMu: 0.84, alphaP: 0.17, dirt: 0.72, wearX: 1.2, price: 2500, line: 'FOR THE RED CLAY. NOT FOR ANYTHING ELSE.' },\n};\nexport const TYRE_IDS = Object.keys(TYRES);\nEOF\ncat > src/game/data/parts.js <<'EOF'\n// Tuning Street's catalogue. Each part's numbers are applied in sim/tuning.js. group: exclusive within the group.\nexport const PARTS = {\n  exhaust: { cat: 'engine', name: 'SPORT EXHAUST', price: 900, line: 'POWER +4%. LOUDER, DEEPER, CRACKLES ON LIFT.' },\n  intake: { cat: 'engine', name: 'INTAKE AND ECU', price: 1800, line: 'POWER +6%. THE ENGINE BREATHES MORE EASILY.' },\n  stage1: { cat: 'engine', group: 'stage', name: 'STAGE 1 TUNE', price: 3000, line: 'POWER +10%.' },\n  stage2: { cat: 'engine', group: 'stage', name: 'STAGE 2 TUNE', price: 8000, line: 'POWER +20%. REVS A LITTLE HIGHER.' },\n  stage3: { cat: 'engine', group: 'stage', name: 'STAGE 3 TUNE', price: 20000, line: 'POWER +35%. REVS MUCH HIGHER.' },\n  turbo1: { cat: 'engine', group: 'turbo', name: 'TURBO KIT 1', price: 6000, line: 'A WHISTLE AND SOME MORE POWER. SOME LAG.' },\n  turbo2: { cat: 'engine', group: 'turbo', name: 'TURBO KIT 2', price: 15000, line: 'A LOUDER WHISTLE. POWER ARRIVES LATE.' },\n  weight1: { cat: 'weight', group: 'weight', name: 'WEIGHT STAGE 1', price: 1500, line: 'MASS -5%. THE SPARE WHEEL IS GONE.' },\n  weight2: { cat: 'weight', group: 'weight', name: 'WEIGHT STAGE 2', price: 4500, line: 'MASS -10%. SO IS THE REAR SEAT.' },\n  weight3: { cat: 'weight', group: 'weight', name: 'WEIGHT STAGE 3', price: 12000, line: 'MASS -15%. DO NOT ASK ABOUT THE RADIO.' },\n  clutch: { cat: 'drivetrain', name: 'CLUTCH AND FLYWHEEL', price: 1200, line: 'GEAR CHANGES TAKE 0.11 S.' },\n  gearbox: { cat: 'drivetrain', name: 'RACE GEARBOX', price: 5000, line: 'CHANGES IN 0.08 S. GEARING BECOMES A SETTING.' },\n  lsd: { cat: 'drivetrain', name: 'LIMITED-SLIP DIFF', price: 2500, line: 'BOTH DRIVEN WHEELS SHARE THE WORK. A SETTING.' },\n  suspSport: { cat: 'suspension', group: 'susp', name: 'SPORT SUSPENSION', price: 2000, line: 'LOWER, FLATTER. BALANCE BECOMES A SETTING.' },\n  suspRace: { cat: 'suspension', group: 'susp', name: 'RACE SUSPENSION', price: 6000, line: 'LOWER STILL. BALANCE AND RIDE HEIGHT TO SET.' },\n  brakeSport: { cat: 'brakes', group: 'brakes', name: 'SPORT PADS', price: 1500, line: 'STOPS HARDER, IF THE TYRES ALLOW.' },\n  brakeRace: { cat: 'brakes', group: 'brakes', name: 'RACE BRAKE KIT', price: 5000, line: 'STOPS MUCH HARDER. BRAKE BALANCE TO SET.' },\n  aeroStreet: { cat: 'aero', group: 'aero', name: 'STREET KIT', price: 2500, line: 'A LITTLE DOWNFORCE. A LIP SPOILER APPEARS.' },\n  aeroWing: { cat: 'aero', group: 'aero', name: 'BIG WING', price: 6000, line: 'MUCH MORE DOWNFORCE. MORE DRAG. A SETTING.' },\n};\nexport const PART_IDS = Object.keys(PARTS);\nexport const TILES = [\n  { id: 'engine', name: 'ENGINE', line: 'THE PART YOU CAN HEAR.' },\n  { id: 'weight', name: 'WEIGHT', line: 'THE CHEAPEST POWER IS LESS CAR.' },\n  { id: 'drivetrain', name: 'DRIVETRAIN', line: 'BETWEEN THE ENGINE AND THE ROAD.' },\n  { id: 'suspension', name: 'SUSPENSION', line: 'HOW THE WEIGHT MOVES.' },\n  { id: 'brakes', name: 'BRAKES', line: 'A PEDAL WITH A FAR END.' },\n  { id: 'aero', name: 'AERO', line: 'GRIP, AT A PRICE, AT SPEED.' },\n  { id: 'tyres', name: 'TYRES', line: 'THE ONLY PART THAT TOUCHES ANYTHING.' },\n  { id: 'body', name: 'BODY', line: 'NO EFFECT. GREAT IMPORTANCE.' },\n];\nexport const PAINT_PRICE = 500, RIM_PRICE = 300;\n// Setup sliders. needs: part ids, any of which makes the slider available.\nexport const SETUP_SLIDERS = [\n  { id: 'gearing', name: 'GEARING', needs: ['gearbox'], min: 0.85, max: 1.15, step: 0.01, def: 1, low: 'ACCELERATION', high: 'TOP SPEED', line: 'SHORT GEARS PULL HARD. LONG GEARS RUN ON.' },\n  { id: 'lsd', name: 'LSD', needs: ['lsd'], min: 0.2, max: 0.8, step: 0.02, def: 0.4, low: 'FREE', high: 'LOCKED', line: 'LOCKED PUTS POWER DOWN. FREE TURNS IN.' },\n  { id: 'balance', name: 'BALANCE', needs: ['suspSport', 'suspRace'], min: 0.45, max: 0.7, step: 0.01, def: 0.56, low: 'TURNS IN', high: 'STABLE', line: 'WHERE THE CAR LEANS, IT LETS GO FIRST.' },\n  { id: 'ride', name: 'RIDE HEIGHT', needs: ['suspRace'], min: 0.9, max: 1, step: 0.01, def: 1, low: 'LOW', high: 'HIGH', line: 'LOW IS QUICK. BELOW 0.94 THE KERBS WILL BE FELT.' },\n  { id: 'brakeF', name: 'BRAKE BALANCE', needs: ['brakeRace'], min: 0.5, max: 0.75, step: 0.01, def: 0.62, low: 'REAR', high: 'FRONT', line: 'REAR BIAS ROTATES THE CAR. FRONT BIAS IS CALM.' },\n  { id: 'downforce', name: 'DOWNFORCE', needs: ['aeroWing'], min: 0.5, max: 1.5, step: 0.05, def: 1, low: 'LOW DRAG', high: 'HIGH GRIP', line: 'THERE IS NO THIRD THING.' },\n];\nEOF\ncat > src/game/data/events.js <<'EOF'\n// Career events. pool entries are carId or [carId, 'tuned']. round: { track, laps, hour?, rain? }.\nexport const POINTS = [10, 8, 6, 5, 4, 3, 2, 1];\nexport const PRIZE_RATIO = [1, 0.6, 0.4, 0.2];\nexport const TIERS = ['C', 'B', 'A'];\nexport const EVENTS = {\n  dawn: { name: 'DAWN PATROL CUP', needs: ['C'], limit: { maxPS: 210 }, restriction: '210 PS OR LESS', pace: [0.86, 0.9], pool: ['pico', 'kite', 'moth'], prize: 1500, bonus: 3000, field: 6, wear: 0.5, rounds: [{ track: 'kestrel', laps: 2 }, { track: 'harbour', laps: 2, hour: 18.5 }, { track: 'kestrel', laps: 3 }], intro: 'THE FIRST RACE OF A RACING LIFE. THE MORNING IS COOL. NOBODY IS WATCHING.' },\n  fellow: { name: 'FRONT-DRIVE FELLOWSHIP', needs: ['C'], limit: { maxPS: 230, layout: ['FF'] }, restriction: 'FRONT DRIVE, 230 PS OR LESS', pace: [0.88, 0.91], pool: ['kite', ['kite', 'tuned'], ['pico', 'tuned']], prize: 2000, bonus: 5000, field: 6, wear: 0.5, rounds: [{ track: 'cedar', laps: 2 }, { track: 'saltline', laps: 4 }], intro: 'THE MEMBERS MEET TWICE A YEAR TO DISCUSS UNDERSTEER. THEY ARE AGAINST IT.' },\n  feather: { name: 'FEATHERWEIGHT TROPHY', needs: ['B'], limit: { maxKg: 1100 }, restriction: '1,100 KG OR LESS', pace: [0.9, 0.93], pool: ['moth', 'kiteCup', ['pico', 'tuned']], prize: 3000, bonus: 8000, prizeCar: 'kiteCup', field: 7, wear: 0.5, rounds: [{ track: 'cedar', laps: 3 }, { track: 'kestrel', laps: 3 }, { track: 'harbour', laps: 3, hour: 18.5 }], intro: 'THE SCALES ARE AT THE GATE. THEY ARE ACCURATE. PLEASE REMOVE YOUR SHOES IF NECESSARY.' },\n  society: { name: 'REAR-DRIVE SOCIETY', needs: ['B'], limit: { layout: ['FR'] }, restriction: 'FRONT ENGINE, REAR DRIVE', pace: [0.91, 0.94], pool: ['ginga', 'brandt32', 'longhorn'], prize: 3500, bonus: 10000, field: 7, wear: 0.5, rounds: [{ track: 'kestrel', laps: 3, rain: true }, { track: 'saltline', laps: 5 }], intro: 'THE SOCIETY RACES IN ANY WEATHER. IT HAS OPINIONS ABOUT THOSE WHO DO NOT.' },\n  clay: { name: 'RED CLAY RALLY', needs: ['B'], limit: {}, restriction: 'ANY CAR. DIRT TYRES ADVISED', pace: [0.91, 0.95], pool: ['ryu', 'ryuRally'], prize: 4000, bonus: 0, prizeCar: 'ryuRally', field: 2, wear: 0.5, rally: true, rounds: [{ track: 'redclay', laps: 2 }, { track: 'redclay', laps: 2 }, { track: 'redclay', laps: 2 }], intro: 'THREE LEGS. ONE RIVAL EACH. THE CLOCK DECIDES. THE CANYON HAS NO OPINION.' },\n  touring: { name: 'PENINSULA TOURING TROPHY', needs: ['A'], limit: { maxPS: 520 }, restriction: '520 PS OR LESS', pace: [0.93, 0.96], pool: ['brandt32', 'heck', 'libeccio', 'longhorn', ['ryu', 'tuned']], prize: 6000, bonus: 40000, prizeCar: 'corsa', field: 8, wear: 0.5, rounds: [{ track: 'cedar', laps: 3 }, { track: 'harbour', laps: 3 }, { track: 'saltline', laps: 6 }, { track: 'kestrel', laps: 4 }], intro: 'FOUR CIRCUITS. THE WHOLE PENINSULA. THE GRANDSTANDS HAVE BEEN PAINTED.' },\n  h200: { name: 'HARBOUR LIGHTS 200', needs: ['A'], limit: {}, restriction: 'ANY CAR. ONE STOP NEEDED', pace: [0.92, 0.95], pool: ['heck', 'libeccio', ['brandt32', 'tuned']], prize: 20000, bonus: 0, prizeCar: 'works', field: 8, wear: 1, endurance: true, rounds: [{ track: 'harbour', laps: 10, hour: 18.5, hourEnd: 21 }], intro: 'TEN LAPS, DUSK INTO NIGHT. YOU WILL NEED FUEL AND TYRES. YOU WILL NEED BENNO.' },\n  gp: { name: 'THE HALCYON GRAND PRIX', needs: ['A'], needsAny: ['touring', 'h200'], limit: {}, restriction: 'ANY CAR', pace: [0.96, 0.99], pool: ['works', 'corsa', ['libeccio', 'tuned']], prize: 30000, bonus: 0, prizeCar: 'type9', field: 8, wear: 0.5, ending: true, rounds: [{ track: 'kestrel', laps: 5 }, { track: 'cedar', laps: 5 }, { track: 'saltline', laps: 8 }, { track: 'harbour', laps: 5 }], intro: 'THE LAST RACE ON THE CALENDAR. THE WHOLE PENINSULA CLOSES FOR IT.' },\n};\nexport const EVENT_IDS = Object.keys(EVENTS);\n// What 'tuned' means on an AI car: a fixed install, so the same field every time.\nexport const AI_TUNES = { tuned: { parts: ['exhaust', 'intake', 'stage2', 'weight1', 'suspSport', 'brakeSport'], tyre: 'sport' } };\nEOF\ncat > src/game/data/licences.js <<'EOF'\n// Licence tests as data. start and end are places: { s } metres from the line or { c, off } metres from corner c's apex.\n// kind: section (time from start to end), stop (stop inside a box), cones (a weave), lap (flying lap).\nimport { MEDALS } from './medals.js';\nexport const LICENCES = {\n  C: { id: 'C', name: 'PROVISIONAL', line: 'WHERE EVERYONE BEGINS.', reward: 2000, allGold: { car: 'pico', text: 'THE TSUBAME PICO 660, WITH MS. ARAI\\'S COMPLIMENTS.' }, tests: ['C-1', 'C-2', 'C-3', 'C-4'] },\n  B: { id: 'B', name: 'CLUB', line: 'FOR THOSE WHO HAVE LEARNED TO WAIT.', reward: 5000, allGold: { car: 'moth', text: 'THE CASTELLAN MOTH 1.8. MS. ARAI IS SAID TO HAVE SMILED.' }, tests: ['B-1', 'B-2', 'B-3', 'B-4'], needs: 'C' },\n  A: { id: 'A', name: 'NATIONAL', line: 'FEW HOLD IT. NONE OF THEM TALK ABOUT IT.', reward: 10000, allGold: { credits: 25000, helmet: true, text: '25,000 CR AND A GOLD HELMET FOR THE SHELF.' }, tests: ['A-1', 'A-2', 'A-3', 'A-4'], needs: 'B' },\n};\nconst T = {\n  'C-1': { title: 'START AND STOP', lesson: 'THE BRAKE IS A PEDAL WITH A FAR END.', carId: 'kite', track: 'proving', start: { s: 0 }, startSpeed: 0, standing: true, kind: 'stop', box: { s: 400, len: 30 }, brief: ['ACCELERATE TO THE MARKER, THEN BRING THE CAR TO REST', 'INSIDE THE WHITE BOX. PLEASE REMEMBER: THE BRAKE IS', 'ALSO A STEERING WHEEL.'], tip: 'BRAKE LATER THAN IS COMFORTABLE, THEN LATER THAN THAT.' },\n  'C-2': { title: 'FIRST CORNER', lesson: 'TURN IN, APEX, UNWIND.', carId: 'kite', track: 'proving', start: { c: 0, off: -100 }, startSpeed: 60, kind: 'section', end: { c: 1, off: 100 }, brief: ['A LONG RIGHT-HANDER, THEN ANOTHER. TURN IN ONCE.', 'TOUCH THE INSIDE. LET THE CAR RUN WIDE ON THE WAY OUT.'], tip: 'IF YOU ARE STILL STEERING MORE AT THE EXIT, YOU TURNED IN TOO SOON.' },\n  'C-3': { title: 'CONE WEAVE', lesson: 'WEIGHT MOVES.', carId: 'kite', track: 'proving', start: { s: 100 }, startSpeed: 50, kind: 'cones', cones: { from: 210, spacing: 40, count: 6 }, end: { s: 460 }, brief: ['PASS THE SIX CONES, RIGHT OF THE FIRST, LEFT OF THE', 'NEXT. EACH CONE YOU HIT OR MISS ADDS ONE SECOND.'], tip: 'BEGIN EACH TURN BEFORE YOU THINK YOU NEED TO.' },\n  'C-4': { title: 'THE SHORT LOOP', lesson: 'LINK CORNERS. KEEP YOUR HEAD UP.', carId: 'kite', track: 'proving', start: { c: 2, off: -50 }, startSpeed: 60, kind: 'section', end: { c: 6, off: 50 }, brief: ['FIVE CORNERS IN A ROW. THE EXIT OF EACH IS THE ENTRY', 'OF THE NEXT. PLEASE LOOK WHERE YOU WISH TO GO.'], tip: 'A SMALL MISTAKE EARLY BECOMES A LARGE ONE LATER.' },\n  'B-1': { title: 'THRESHOLD', lesson: 'SQUEEZE. DO NOT STAMP.', carId: 'ginga', track: 'proving', start: { s: -60 }, startSpeed: 160, kind: 'stop', box: { s: 150, len: 34 }, assists: { abs: false }, lockAllowed: true, brief: ['ABS IS OFF. YOU ARRIVE AT 160 KM/H. STOP INSIDE THE', 'BOX. LOCKING THE WHEELS IS ALLOWED, AND IT WILL COST', 'YOU TIME.'], tip: 'A LOCKED TYRE IS A TYRE THAT HAS STOPPED HELPING.' },\n  'B-2': { title: 'HAIRPIN EXIT', lesson: 'FEED THE THROTTLE.', carId: 'ginga', track: 'kestrel', start: { c: 5, off: -150 }, startSpeed: 100, kind: 'section', end: { c: 7, off: 60 }, assists: { tcs: 0 }, brief: ['TRACTION CONTROL IS OFF. THE REAR AXLE WILL DO WHAT', 'YOUR RIGHT FOOT SAYS. PLEASE SAY IT SLOWLY.'], tip: 'THE TIME IS MADE ON THE EXIT. IT IS LOST THERE AS WELL.' },\n  'B-3': { title: 'THREE LAYOUTS', lesson: 'FF, FR, 4WD IN THE SAME CORNERS.', carId: 'kite', legs: ['kite', 'ginga', 'ryu'], track: 'proving', start: { c: 7, off: -40 }, startSpeed: 50, kind: 'section', end: { c: 10, off: 40 }, brief: ['THE SAME FOUR CORNERS IN THREE CARS. FRONT DRIVE, THEN', 'REAR, THEN ALL FOUR. YOUR TIMES ARE ADDED TOGETHER.'], tip: 'WHAT WORKED IN THE LAST CAR IS NOW INCORRECT.' },\n  'B-4': { title: 'ONE LAP OF KESTREL', lesson: 'RHYTHM.', carId: 'ginga', track: 'kestrel', start: { s: -220 }, startSpeed: 120, kind: 'lap', brief: ['ONE FLYING LAP OF KESTREL PARK. THE WINDMILL WILL', 'NOT TURN TO LOOK. PLEASE DRIVE ANYWAY.'], tip: 'THERE ARE FOURTEEN CORNERS. THERE IS ONLY ONE RHYTHM.' },\n  'A-1': { title: 'BLIND CREST', lesson: 'TRUST THE ROAD YOU REMEMBER.', carId: 'brandt32', track: 'cedar', start: { c: 3, off: -100 }, startSpeed: 100, kind: 'section', end: { c: 5, off: 100 }, brief: ['THE ROAD GOES OVER A CREST. IT CONTINUES ON THE OTHER', 'SIDE. YOU WILL HAVE TO TAKE THIS ON TRUST.'], tip: 'BE STRAIGHT WHEN THE CAR GOES LIGHT.' },\n  'A-2': { title: 'SWITCHBACKS', lesson: 'MOMENTUM.', carId: 'moth', track: 'cedar', start: { c: 7, off: -40 }, startSpeed: 60, kind: 'section', end: { c: 10, off: 30 }, brief: ['FOUR TIGHT CORNERS, UPHILL, IN THE MOTH. THERE ARE 135', 'PS. WHATEVER SPEED YOU LOSE, YOU WILL NOT SEE AGAIN.'], tip: 'A WIDE CORNER AT SPEED BEATS A TIDY ONE WITHOUT.' },\n  'A-3': { title: 'RED CLAY', lesson: 'ROTATE WITH THE HANDBRAKE.', carId: 'ryuRally', track: 'redclay', start: { c: 7, off: -50 }, startSpeed: 60, kind: 'section', end: { c: 10, off: 40 }, brief: ['DIRT. THE RYU RALLY. THE HAIRPIN WILL NOT COME TO YOU.', 'A TOUCH OF HANDBRAKE TURNS THE CAR. THE THROTTLE', 'BRINGS IT BACK.'], tip: 'LOOK AT THE EXIT, AND NOT AT THE CANYON WALL.' },\n  'A-4': { title: 'HARBOUR AT NIGHT', lesson: 'EVERYTHING, BY LAMPLIGHT.', carId: 'libeccio', track: 'harbour', start: { s: -220 }, startSpeed: 120, kind: 'lap', hour: 21, noMargin: true, brief: ['ONE LAP OF THE HARBOUR AT NIGHT, IN THE LIBECCIO. THE', 'WALLS ARE CLOSE. A TOUCH ENDS THE ATTEMPT.'], tip: 'THE LAMPS ARE NOT THERE FOR YOU. THE WALLS ARE.' },\n};\nexport const TESTS = Object.fromEntries(Object.entries(T).map(([id, t]) => [id, { id, licence: id[0], medals: MEDALS[id], ...t }]));\nexport const TEST_IDS = Object.keys(TESTS);\nexport const LICENCE_ORDER = ['C', 'B', 'A'];\nEOF\ncat > src/game/data/medals.js <<'EOF'\n// Written by tools/medals.mjs from the AI demonstrations (gold T x 1.03, silver x 1.09, bronze x 1.18). Frozen here.\nexport const MEDALS = {};\nEOF\ncat > src/game/data/text.js <<'EOF'\n// Everything the cast says, in the catalogue voice. Uppercase: the HUD font has no other case.\nexport const SPEAKERS = {\n  arai: { name: 'MS. ARAI', pitch: 210, wave: 'sawtooth', manner: 'even', title: 'CHIEF EXAMINER' },\n  benno: { name: 'BENNO', pitch: 130, wave: 'square', manner: 'gravel', title: 'MECHANIC' },\n  fenn: { name: 'MR. FENN', pitch: 180, wave: 'sawtooth', manner: 'lilt', title: 'DEALER' },\n  dell: { name: 'DELL', pitch: 160, wave: 'sawtooth', manner: 'fast', title: 'COMMENTATOR' },\n};\nexport const LINES = {\n  arai: {\n    greet: 'WELCOME TO THE PENINSULA. A LICENCE IS NOT DIFFICULT TO OBTAIN. IT IS ONLY DIFFICULT TO DESERVE.',\n    fail: ['THE BOX HAS NOT MOVED. PLEASE TRY AGAIN.', 'THAT WAS NOT THE ROAD. THE ROAD IS THE GREY PART.', 'WE HAVE TIME. WE HAVE A GREAT DEAL OF TIME.'],\n    gold: ['THANK YOU. THAT WAS CORRECT.', 'YES. THAT IS HOW IT IS DONE.'],\n    silver: ['VERY NEARLY CORRECT.', 'GOOD. THE GOLD TIME REMAINS AVAILABLE.'],\n    bronze: ['A PASS. THE PAPERWORK DOES NOT MENTION HOW CLOSE.', 'THAT WILL DO. FOR NOW.'],\n    offerLine: 'MAY I SUGGEST THE DRIVING LINE? THERE IS NO SHAME IN IT. THERE IS ONLY A LINE.',\n    licence: 'YOUR LICENCE. PLEASE DO NOT LAMINATE IT.',\n    demo: 'PLEASE OBSERVE. I WILL NOT BE HURRYING.',\n    idle: 'THE TOWER IS OPEN. PLEASE CHOOSE A LICENCE.',\n  },\n  fenn: {\n    hello: 'WELCOME TO THE ROW. EVERY CAR HERE HAS A KERB WEIGHT, AND I KNOW THEM ALL.',\n    bought: 'CONGRATULATIONS. PLEASE LOOK AFTER HER. SHE HAS BEEN WAITING.',\n    poor: 'A BEAUTIFUL CAR. PERHAPS AFTER ANOTHER RACE OR TWO.',\n    lowLicence: 'I AM SORRY. THIS ONE WANTS A NATIONAL LICENCE.',\n    sold: 'SHE WILL BE MISSED. I WILL SEE TO IT PERSONALLY.',\n  },\n  benno: {\n    hello: 'WHAT DID YOU DO TO IT THIS TIME?',\n    oilTired: 'YOUR OIL IS TIRED. IT HAS SEEN THINGS. TWO HUNDRED AND FIFTY CREDITS.',\n    oilFresh: 'THE OIL IS FINE. YOU ARE WORRYING. I RESPECT THAT.',\n    oilDone: 'FRESH OIL. ABOUT TWO PERCENT MORE POWER, FOR THE FIRST HUNDRED KILOMETRES.',\n    wash: 'IT IS NOT FASTER NOW. IT IS SIMPLY POLITE.',\n    washClean: 'IT IS ALREADY CLEAN. I WILL NOT TAKE YOUR MONEY FOR THAT. WELL. FIFTY CREDITS.',\n    wing: 'YOU NOW HAVE MORE DOWNFORCE. YOU ALSO HAVE MORE DRAG. THERE IS NO THIRD THING.',\n    engine: 'LISTEN TO THAT. NO, CLOSER. THAT IS THE SOUND OF MONEY LEAVING.',\n    weight: 'I TOOK OUT THE PARTS YOU WILL NOT MISS. YOU WILL MISS THEM A LITTLE.',\n    tyres: 'FOUR NEW TYRES. PLEASE KEEP THEM ON THE ROAD.',\n    brakes: 'NOW YOU CAN ARRIVE AT THE CORNER LATER. THE CORNER HAS NOT MOVED.',\n    susp: 'IT SITS LOWER NOW. MIND THE SPEED BUMP AT THE CHURCH.',\n    drive: 'THE POWER NOW GETS TO THE ROAD. MOST OF IT.',\n    body: 'A NEW COLOUR. IT IS STILL THE SAME CAR. BUT YES. IT LOOKS WELL.',\n    pit: ['IN AND OUT. PLEASE KEEP YOUR HANDS INSIDE.', 'FRESH TYRES. THE OLD ONES ARE RETIRING WITH HONOURS.', 'FUEL IS GOING IN. PLEASE DO NOT SMOKE.'],\n  },\n  dell: {\n    win: ['A WIN AT {TRACK}. THE CROWD HAS BEEN INFORMED.', 'FIRST PLACE. {NAME} DROVE THIS CORRECTLY.', 'THE LINE WAS CROSSED FIRST BY {NAME}. THIS IS A FACT.'],\n    podium: ['ON THE PODIUM AT {TRACK}. THE STEPS ARE NEWLY PAINTED.', 'A SOLID RESULT. THE GRANDSTAND APPLAUDED AT A REASONABLE VOLUME.'],\n    mid: ['A QUIET AFTERNOON AT {TRACK}.', 'PLACED {POS}. THE CAR IS UNHARMED. THE TIME WAS NOT.'],\n    record: 'LAP RECORD AT {TRACK}. {TIME}. THE WINDMILL DID NOT TURN TO LOOK.',\n    replay: ['THERE IS THE BRAKING POINT. THERE IS THE CORNER.', 'AND AGAIN, FROM THE BRIDGE.', 'A VERY TIDY LINE THROUGH HERE.', 'THE GAP IS SMALL. THE GAP REMAINS.', 'THE TYRES ARE WORKING HARD. YOU CAN SEE IT, IF YOU KNOW.'],\n    start: 'THE FIELD IS FORMED. THE LIGHTS ARE ON THE GANTRY.',\n  },\n};\nexport const TIPS = [\n  'BRAKE IN A STRAIGHT LINE. A TYRE HAS ONLY SO MUCH GRIP TO SHARE.',\n  'SLOW IN, FAST OUT. THIS HAS BEEN TRUE FOR SOME TIME.',\n  'A WASHED CAR IS NOT FASTER. IT IS SIMPLY POLITE.',\n  'THE FRONT-DRIVE CAR PULLS. THE REAR-DRIVE CAR PUSHES. CHOOSE WHICH TO ARGUE WITH.',\n  'TIRED OIL COSTS POWER. THE SERVICE BAY IS NEAR THE LIGHTHOUSE.',\n  'ON A LONG STRAIGHT, STAY BEHIND THE CAR AHEAD. THEN DO NOT.',\n  'IN THE RAIN, EVERY CORNER IS ONE GEAR LONGER THAN YOU THINK.',\n  'ALL FOUR TYRES WEAR. YOU CAN SEE THEM IN THE CORNER OF THE SCREEN.',\n];\nexport const MAP_PLACES = [\n  { id: 'licence', name: 'LICENCE CENTRE', blurb: 'EVERY DRIVER BEGINS WITH A CLIPBOARD.' },\n  { id: 'events', name: 'EVENT HALL', blurb: 'THE ROAD BETWEEN YOU AND THE GRAND PRIX.' },\n  { id: 'dealer', name: 'DEALER ROW', blurb: 'THREE SHOWROOMS AND A USED LOT. BRING MONEY.' },\n  { id: 'tuning', name: 'TUNING STREET', blurb: 'WHAT YOU BUY HERE YOU WILL FEEL.' },\n  { id: 'service', name: 'SERVICE BAY', blurb: 'OIL AND SOAP.' },\n  { id: 'garage', name: 'HOME GARAGE', blurb: 'EVERYTHING YOU HAVE EARNED.' },\n  { id: 'museum', name: 'MUSEUM', blurb: 'CARS YOU HAVE MET.' },\n  { id: 'theatre', name: 'THEATRE', blurb: 'WATCH IT AGAIN, MORE SLOWLY.' },\n  { id: 'arcade', name: 'ARCADE GATE', blurb: 'NO LICENCE REQUIRED. NO MONEY EITHER.' },\n];\nexport const ENDING_LINES = ['YOU MAY KEEP DRIVING.', 'MOST PEOPLE DO.'];\nexport const PRIZE_SELL = 'PRIZE CARS ARE NOT FOR SALE. IT IS SIMPLY NOT DONE.';\nexport const LAST_CAR = 'YOU CANNOT SELL YOUR LAST CAR. HOW WOULD YOU GET HOME?';\nexport const HANDBOOK = [\n  { title: 'CONTROLS', device: true },\n  { title: 'WHAT YOU CAN AND CANNOT DO', lines: ['CARS CANNOT BE DAMAGED OR FLIP OVER, BY DESIGN.', 'YOU CAN HIT WALLS AND CARS. IT COSTS YOU TIME.', 'YOU CANNOT LEAVE THE CIRCUIT PAST THE BARRIERS.', 'THERE IS NO COCKPIT VIEW. THERE IS A BONNET VIEW.'] },\n  { title: 'RECOVERY', lines: ['A STOPPED OR LOST CAR CAN BE PUT BACK ON THE ROAD', 'AT ANY TIME. HOLD THE RECOVER BUTTON FOR ONE SECOND.', 'IN A LICENCE TEST, RECOVERY ENDS THE ATTEMPT.'] },\n  { title: 'ASSISTS', lines: ['ABS STOPS THE BRAKES LOCKING. TRACTION TRIMS POWER.', 'STABILITY ARGUES WITH A SLIDE. EACH CAN BE TURNED', 'DOWN ON ITS OWN FROM THE PAUSE MENU. THE DRIVING', 'LINE SHOWS WHERE TO GO, AND RED WHERE TO BRAKE.'] },\n  { title: 'TYRES AND WEAR', lines: ['FOUR SQUARES IN THE CORNER OF THE SCREEN SHOW YOUR', 'FOUR TYRES. GREEN IS FRESH. RED IS FINISHED.', 'SOFTER TYRES GRIP MORE AND WEAR FASTER. A WORN TYRE', 'GRIPS ABOUT THREE QUARTERS AS WELL AS A NEW ONE.'] },\n  { title: 'PIT STOPS', lines: ['ON THE PIT STRAIGHT, KEEP RIGHT AND CROSS THE ENTRY', 'LINE. THE CREW TAKES THE CAR AND STOPS IT IN THE BOX.', 'TYRES TAKE FOUR SECONDS. FUEL TAKES A TENTH PER', 'PERCENT. PRESS BACK TO SKIP THE TYRES.'] },\n  { title: 'TUNING IN PLAIN WORDS', lines: ['POWER MOVES YOU ALONG THE STRAIGHT. WEIGHT HELPS', 'EVERYWHERE. TYRES HELP CORNERS. AERO HELPS FAST', 'CORNERS AND HURTS TOP SPEED. PARTS THAT OFFER A', 'SETTING ADD A SLIDER ON THE SETUP TAB.'] },\n  { title: 'RALLY', lines: ['ON DIRT THE ROAD IS LOOSE AND THE CLOCK DECIDES. FIT', 'RALLY TYRES. STABILITY IS HALVED ON DIRT. A TOUCH OF', 'HANDBRAKE ROTATES THE CAR IN A HAIRPIN. THE CRESTS', 'WILL LIFT YOU, SO BE STRAIGHT WHEN THEY DO.'] },\n  { title: 'MEDALS', lines: ['A TEST IS PASSED AT BRONZE. A LICENCE NEEDS BRONZE', 'IN ALL FOUR. GOLD IN ALL FOUR EARNS A PRIZE.', 'MEDALS AND RECORDS ARE NOT KEPT WHEN DEV SLIDERS', 'ARE AWAY FROM THEIR DEFAULTS.'] },\n];\nEOF\necho ok","description":"Write car, tyre, part, event, licence and text data"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16089,"cache_read_input_tokens":180632,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16089},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"406faafc-6c7f-4e76-892b-dddcc448990c","timestamp":"2026-11-06T00:28:37.408Z","request_id":"req_011CgkizWpVgB8PDJ1H7HZ8j","wire_tool_inputs":{"toolu_01JzLYvhGL7FFkUAmZ4Ci9Az":{"command":"cat > src/game/data/meta.js <<'EOF'\n// Every on-screen use of the game's name reads TITLE.\nexport const TITLE = 'GRAN TUMBLEWEED';\nexport const SUBTITLE = 'THE PENINSULA DRIVING CATALOGUE';\nexport const MAKER = 'A CHUNKY PIXEL PRODUCTION';\nexport const SOURCE = 'Gran Turismo 3: A-Spec';\nexport const SAVE_KEY = 'gran-tumbleweed.profile';\nexport const OPTIONS_KEY = 'gran-tumbleweed.options';\nexport const SAVE_VERSION = 2;\nexport const START_CREDITS = 15000;\nexport const SEAT_COLOURS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\nexport const SEAT_PAINT = ['red', 'blue', 'green', 'sand'];\nexport const PAINTS = ['red', 'orange', 'sand', 'lime', 'green', 'teal', 'blue', 'sky', 'cyan', 'white', 'mist', 'slate', 'navy', 'plum', 'ink', 'night'];\nexport const RIM_STYLES = ['DISH', 'FIVE SPOKE', 'MESH', 'RALLY'];\nEOF\ncat > src/game/data/cars.js <<'EOF'\n// The car catalogue. Physics rows are in carphysics.js; this file has what the showroom, the Museum and the sound need.\nimport { CARS as PHYSICS } from './carphysics.js';\nexport { PHYSICS };\nexport const MARQUES = {\n  tsubame: { name: 'TSUBAME', line: 'SMALL, CLEVER. THE SWALLOW RETURNS EACH YEAR.' },\n  kaminari: { name: 'KAMINARI', line: 'THUNDER, IN THE SERIOUS SENSE.' },\n  castellan: { name: 'CASTELLAN', line: 'A SHED, A LATHE, A PRINCIPLE.' },\n  brandt: { name: 'BRANDT', line: 'POLITE, AND TERRIFYING.' },\n  ironwood: { name: 'IRONWOOD', line: 'DISPLACEMENT AS A MORAL POSITION.' },\n  vespucci: { name: 'VESPUCCI', line: 'BEAUTIFUL. A LITTLE DRAMATIC.' },\n  halcyon: { name: 'HALCYON WORKS', line: 'THE PENINSULA\\'S OWN TINY RACE SHOP.' },\n};\n// where: used, dealer or prize. after: a licence that opens the dealer sale of a prize car.\nexport const CAR_INFO = {\n  pico: { name: 'TSUBAME PICO 660', short: 'PICO 660', marque: 'tsubame', year: 1991, price: 4800, where: 'used', paint: 'sky', cyl: 3, filter: 900, exhaust: 0.8, fenn: 'THE PICO. ONE OWNER. SHE WENT ONLY TO THE SHOPS AND BACK.', text: ['A CITY CAR OF 660 CC, MADE TO FIT WHERE OTHER CARS', 'CAN ONLY WISH TO GO. AT 720 KG IT HAS LITTLE TO HOLD', 'BACK AND LITTLE TO PUSH. IT TEACHES THE FIRST LESSON:', 'MOMENTUM IS EXPENSIVE.'] },\n  kite: { name: 'TSUBAME KITE 1.6 RS', short: 'KITE 1.6 RS', marque: 'tsubame', year: 1996, price: 12500, where: 'used', paint: 'red', cyl: 4, filter: 1300, exhaust: 1, fenn: 'A PREVIOUS OWNER. ONE CAREFUL WEEKEND. SHE HAS 88,000 KILOMETRES AND NO REGRETS.', text: ['THE KITE WAS A FAMILY HATCHBACK UNTIL THE ENGINEERS', 'STAYED LATE. THE 1.6-LITRE ENGINE ASKS TO BE REVVED,', 'AND THE FRONT TYRES DO ALL OF THE WORK. BRAKE BEFORE', 'THE CORNER AND IT WILL THANK YOU.'] },\n  ginga: { name: 'KAMINARI GINGA S', short: 'GINGA S', marque: 'kaminari', year: 1994, price: 14800, where: 'used', paint: 'white', cyl: 4, filter: 1100, exhaust: 1.1, fenn: 'REAR-WHEEL DRIVE, AND ONLY SOME OF THE MARKS ARE FROM THE PREVIOUS OWNER.', text: ['A FRONT-ENGINED, REAR-DRIVE COUPE IN GOOD USED', 'CONDITION. THE STEERING SPEAKS CLEARLY AND THE REAR', 'AXLE ANSWERS THE RIGHT FOOT. MANY DRIVERS LEARNED TO', 'DRIVE IN THIS CAR. SOME LEARNED TWICE.'] },\n  moth: { name: 'CASTELLAN MOTH 1.8', short: 'MOTH 1.8', marque: 'castellan', year: 1998, price: 24000, where: 'dealer', showroom: 0, paint: 'green', cyl: 4, filter: 1500, exhaust: 0.9, fenn: '860 KILOGRAMS. FORGIVE ME. I WILL BE ALL RIGHT IN A MOMENT.', text: ['TWO SEATS, ONE PURPOSE, 860 KG. CASTELLAN REMOVED', 'WHAT THE CAR DID NOT NEED, THEN REMOVED A LITTLE', 'MORE. THE POWER FIGURE IS MODEST. THAT IS NOT THE', 'FIGURE THAT MATTERS.'] },\n  ryu: { name: 'KAMINARI RYU 2.0T', short: 'RYU 2.0T', marque: 'kaminari', year: 1999, price: 39000, where: 'dealer', showroom: 0, paint: 'blue', cyl: 4, filter: 1000, exhaust: 1.2, fenn: 'FOUR DRIVEN WHEELS. THERE IS NO SUCH THING AS BAD WEATHER, ONLY LATE BRAKING.', text: ['TURBOCHARGED, FOUR-WHEEL DRIVE, BORN FOR A RALLY', 'RULE THAT NO LONGER EXISTS. POWER ARRIVES LATE AND', 'THEN ALL AT ONCE. IN THE RAIN, VERY LITTLE CAN KEEP', 'IT IN SIGHT.'] },\n  longhorn: { name: 'IRONWOOD LONGHORN 428', short: 'LONGHORN 428', marque: 'ironwood', year: 1969, price: 47000, where: 'dealer', showroom: 1, paint: 'orange', cyl: 8, filter: 700, exhaust: 1.5, fenn: 'THE BRAKES ARE ORIGINAL. I WOULD MENTION THIS EARLY.', text: ['A LARGE AMERICAN COUPE OF THE OLD SCHOOL: SEVEN', 'LITRES, 420 PS, AND BRAKES THAT REMEMBER A SIMPLER', 'TIME. IT DOES NOT LIKE CORNERS, AND IT SAYS SO. ON A', 'LONG STRAIGHT NOBODY ASKS IT TO APOLOGISE.'] },\n  brandt32: { name: 'BRANDT 3.2 CSR', short: 'BRANDT 3.2', marque: 'brandt', year: 2000, price: 58000, where: 'dealer', showroom: 1, paint: 'slate', cyl: 6, filter: 1600, exhaust: 1.05, fenn: 'THERE ARE FOUR DOORS. PLEASE DO NOT LET THAT REASSURE YOU.', text: ['A FOUR-DOOR SEDAN, ACCORDING TO THE CATALOGUE. THE', 'STRAIGHT SIX REACHES 7,900 RPM WITH AN EVEN TEMPER,', 'AND THE BALANCE IS CLOSE TO 50:50. BUSINESSMEN BOUGHT', 'IT FOR THE LEATHER. OTHERS DID NOT.'] },\n  heck: { name: 'BRANDT HECK 3.6', short: 'HECK 3.6', marque: 'brandt', year: 1997, price: 92000, where: 'dealer', showroom: 1, paint: 'sand', cyl: 6, filter: 1800, exhaust: 1.1, fenn: 'THE ENGINE IS BEHIND THE AXLE. IT HAS ALWAYS BEEN BEHIND THE AXLE. WE DO NOT DISCUSS IT.', text: ['THE ENGINE SITS BEHIND THE REAR AXLE, WHERE BRANDT', 'HAS INSISTED FOR FORTY YEARS THAT IT BELONGS.', 'TRACTION IS WONDERFUL. LIFTING IN MID-CORNER IS NOT', 'RECOMMENDED. THIS IS WRITTEN IN THE MANUAL.'] },\n  libeccio: { name: 'VESPUCCI LIBECCIO', short: 'LIBECCIO', marque: 'vespucci', year: 1995, price: 135000, where: 'dealer', showroom: 2, paint: 'red', cyl: 8, filter: 2000, exhaust: 1.25, fenn: 'THE SOUTH-WEST WIND. I HAVE WATCHED IT LEAVE THIS ROOM MANY TIMES.', text: ['NAMED FOR THE SOUTH-WEST WIND. A MID-ENGINED V8', 'WITH A LOW NOSE AND A HIGH OPINION OF ITSELF. LIGHT', 'ON THE FRONT WHEELS AT SPEED. PRECISE, IF YOU ARE.'] },\n  kiteCup: { name: 'TSUBAME KITE CUP RACER', short: 'KITE CUP', marque: 'tsubame', year: 2000, price: 0, where: 'prize', paint: 'lime', cyl: 4, filter: 2200, exhaust: 1.3, fenn: 'A PRIZE CAR. THESE DO NOT COME THROUGH MY DOOR.', text: ['A STRIPPED KITE FOR A ONE-MAKE SERIES, WITH A ROLL', 'CAGE WHERE THE REAR SEATS USED TO BE. 210 PS THROUGH', 'THE FRONT WHEELS ASKS FOR A PATIENT FOOT.'] },\n  ryuRally: { name: 'KAMINARI RYU RALLY SPEC', short: 'RYU RALLY', marque: 'kaminari', year: 1999, price: 0, where: 'prize', paint: 'cyan', cyl: 4, filter: 1400, exhaust: 1.5, fenn: 'A PRIZE CAR. THIS ONE ARRIVES WITH THE CLAY STILL ON IT.', text: ['WORKS GRAVEL SPECIFICATION: LONG TRAVEL, SHORT', 'GEARING, AND A BONNET THAT HAS SEEN WEATHER. ON DIRT', 'IT IS ANOTHER SPECIES. ON TARMAC IT SEEMS TO BE', 'LOOKING FOR THE EXIT.'] },\n  works: { name: 'KAMINARI GINGA WORKS GT', short: 'WORKS GT', marque: 'kaminari', year: 2000, price: 310000, where: 'prize', after: 'A', showroom: 2, paint: 'navy', cyl: 6, filter: 2600, exhaust: 1.6, fenn: 'I AM ALLOWED TO SELL THIS ONE AFTER YOUR NATIONAL LICENCE. I HOPE YOU UNDERSTAND WHY.', text: ['THE GINGA AS THE FACTORY WOULD LIKE TO REMEMBER IT.', '560 PS, CARBON PANELS, AND A WING WITH ITS OWN', 'OPINION ABOUT CORNER SPEED.'] },\n  corsa: { name: 'VESPUCCI LIBECCIO CORSA', short: 'CORSA', marque: 'vespucci', year: 1998, price: 520000, where: 'prize', after: 'A', showroom: 2, paint: 'red', cyl: 10, filter: 3000, exhaust: 1.7, fenn: 'TWENTY-FIVE WERE BUILT FOR THE ROAD. NONE OF THEM HAS ENJOYED IT.', text: ['HOMOLOGATED IN THE STRICTEST SENSE OF THE WORD:', 'VESPUCCI BUILT TWENTY-FIVE ROAD CARS SO THAT IT COULD', 'RACE THIS ONE. 620 PS. 1,100 KG. DO NOT LIFT.'] },\n  type9: { name: 'HALCYON TYPE 9 PROTOTYPE', short: 'TYPE 9', marque: 'halcyon', year: 2001, price: 0, where: 'prize', paint: 'white', cyl: 12, filter: 3400, exhaust: 1.8, fenn: 'THERE IS ONLY THE ONE. I WOULD LIKE TO STAND NEAR IT, IF YOU DO NOT MIND.', text: ['BUILT BY A SMALL WORKS TEAM ON THE PENINSULA, IN A', 'SHED, FOR ONE RACE. 780 PS, 930 KG, A CLOSED COCKPIT', 'AND NO RADIO. IT STOPS AS WELL AS IT GOES, WHICH', 'TAKES SOME TIME TO BELIEVE.'] },\n};\nexport const CAR_IDS = Object.keys(CAR_INFO);\nexport const SHOWROOMS = [\n  { id: 'used', name: 'THE USED LOT', line: 'FOUR WHEELS. A HISTORY. NO QUESTIONS.', cars: ['pico', 'kite', 'ginga'] },\n  { id: 'east', name: 'EASTERN MOTORS', line: 'LIGHTNESS AND THUNDER.', cars: ['moth', 'ryu'] },\n  { id: 'west', name: 'WESTERN IMPORTS', line: 'DISPLACEMENT AND DOCTRINE.', cars: ['longhorn', 'brandt32', 'heck'] },\n  { id: 'grand', name: 'THE GRAND SALON', line: 'PLEASE DO NOT TOUCH WITHOUT MONEY.', cars: ['libeccio', 'works', 'corsa'] },\n];\nexport const LAYOUT_WORDS = { FF: 'FRONT ENGINE, FRONT DRIVE', FR: 'FRONT ENGINE, REAR DRIVE', MR: 'MID ENGINE, REAR DRIVE', RR: 'REAR ENGINE, REAR DRIVE', '4WD': 'FOUR-WHEEL DRIVE' };\nexport const DRIVER_NAMES = ['T. HOLLIS', 'R. OKADA', 'M. VOSS', 'S. MIRA', 'L. BRANDO', 'K. ASHBY', 'J. TANAKA', 'P. FARROW', 'E. LINDQVIST', 'D. MARCH', 'A. COSTA', 'H. NAGANO', 'B. WREN', 'G. PELLEGRINI', 'N. ORTIZ', 'C. DUVAL'];\nEOF\ncat > src/game/data/tyres.js <<'EOF'\n// Tyres. Stock rows in carphysics.js stay in place until the player buys a set.\nexport const TYRES = {\n  street: { id: 'street', name: 'STREET', tyreMu: 0.95, alphaP: 0.14, dirt: 0.45, wearX: 0.8, price: 600, line: 'THEY LAST. THEY ALSO SQUEAL.' },\n  sport: { id: 'sport', name: 'SPORT', tyreMu: 1.0, alphaP: 0.125, dirt: 0.5, wearX: 1.0, price: 1200, line: 'A GOOD HONEST TYRE.' },\n  semi: { id: 'semi', name: 'SEMI-SLICK', tyreMu: 1.12, alphaP: 0.115, dirt: 0.42, wearX: 1.4, price: 4800, line: 'MORE GRIP. LESS OF THE TYRE AT THE END.' },\n  slick: { id: 'slick', name: 'RACING SLICK', tyreMu: 1.3, alphaP: 0.105, dirt: 0.35, wearX: 2.2, price: 12000, line: 'VERY FAST. VERY BRIEF. HOPELESS ON DIRT.' },\n  rally: { id: 'rally', name: 'RALLY DIRT', tyreMu: 0.84, alphaP: 0.17, dirt: 0.72, wearX: 1.2, price: 2500, line: 'FOR THE RED CLAY. NOT FOR ANYTHING ELSE.' },\n};\nexport const TYRE_IDS = Object.keys(TYRES);\nEOF\ncat > src/game/data/parts.js <<'EOF'\n// Tuning Street's catalogue. Each part's numbers are applied in sim/tuning.js. group: exclusive within the group.\nexport const PARTS = {\n  exhaust: { cat: 'engine', name: 'SPORT EXHAUST', price: 900, line: 'POWER +4%. LOUDER, DEEPER, CRACKLES ON LIFT.' },\n  intake: { cat: 'engine', name: 'INTAKE AND ECU', price: 1800, line: 'POWER +6%. THE ENGINE BREATHES MORE EASILY.' },\n  stage1: { cat: 'engine', group: 'stage', name: 'STAGE 1 TUNE', price: 3000, line: 'POWER +10%.' },\n  stage2: { cat: 'engine', group: 'stage', name: 'STAGE 2 TUNE', price: 8000, line: 'POWER +20%. REVS A LITTLE HIGHER.' },\n  stage3: { cat: 'engine', group: 'stage', name: 'STAGE 3 TUNE', price: 20000, line: 'POWER +35%. REVS MUCH HIGHER.' },\n  turbo1: { cat: 'engine', group: 'turbo', name: 'TURBO KIT 1', price: 6000, line: 'A WHISTLE AND SOME MORE POWER. SOME LAG.' },\n  turbo2: { cat: 'engine', group: 'turbo', name: 'TURBO KIT 2', price: 15000, line: 'A LOUDER WHISTLE. POWER ARRIVES LATE.' },\n  weight1: { cat: 'weight', group: 'weight', name: 'WEIGHT STAGE 1', price: 1500, line: 'MASS -5%. THE SPARE WHEEL IS GONE.' },\n  weight2: { cat: 'weight', group: 'weight', name: 'WEIGHT STAGE 2', price: 4500, line: 'MASS -10%. SO IS THE REAR SEAT.' },\n  weight3: { cat: 'weight', group: 'weight', name: 'WEIGHT STAGE 3', price: 12000, line: 'MASS -15%. DO NOT ASK ABOUT THE RADIO.' },\n  clutch: { cat: 'drivetrain', name: 'CLUTCH AND FLYWHEEL', price: 1200, line: 'GEAR CHANGES TAKE 0.11 S.' },\n  gearbox: { cat: 'drivetrain', name: 'RACE GEARBOX', price: 5000, line: 'CHANGES IN 0.08 S. GEARING BECOMES A SETTING.' },\n  lsd: { cat: 'drivetrain', name: 'LIMITED-SLIP DIFF', price: 2500, line: 'BOTH DRIVEN WHEELS SHARE THE WORK. A SETTING.' },\n  suspSport: { cat: 'suspension', group: 'susp', name: 'SPORT SUSPENSION', price: 2000, line: 'LOWER, FLATTER. BALANCE BECOMES A SETTING.' },\n  suspRace: { cat: 'suspension', group: 'susp', name: 'RACE SUSPENSION', price: 6000, line: 'LOWER STILL. BALANCE AND RIDE HEIGHT TO SET.' },\n  brakeSport: { cat: 'brakes', group: 'brakes', name: 'SPORT PADS', price: 1500, line: 'STOPS HARDER, IF THE TYRES ALLOW.' },\n  brakeRace: { cat: 'brakes', group: 'brakes', name: 'RACE BRAKE KIT', price: 5000, line: 'STOPS MUCH HARDER. BRAKE BALANCE TO SET.' },\n  aeroStreet: { cat: 'aero', group: 'aero', name: 'STREET KIT', price: 2500, line: 'A LITTLE DOWNFORCE. A LIP SPOILER APPEARS.' },\n  aeroWing: { cat: 'aero', group: 'aero', name: 'BIG WING', price: 6000, line: 'MUCH MORE DOWNFORCE. MORE DRAG. A SETTING.' },\n};\nexport const PART_IDS = Object.keys(PARTS);\nexport const TILES = [\n  { id: 'engine', name: 'ENGINE', line: 'THE PART YOU CAN HEAR.' },\n  { id: 'weight', name: 'WEIGHT', line: 'THE CHEAPEST POWER IS LESS CAR.' },\n  { id: 'drivetrain', name: 'DRIVETRAIN', line: 'BETWEEN THE ENGINE AND THE ROAD.' },\n  { id: 'suspension', name: 'SUSPENSION', line: 'HOW THE WEIGHT MOVES.' },\n  { id: 'brakes', name: 'BRAKES', line: 'A PEDAL WITH A FAR END.' },\n  { id: 'aero', name: 'AERO', line: 'GRIP, AT A PRICE, AT SPEED.' },\n  { id: 'tyres', name: 'TYRES', line: 'THE ONLY PART THAT TOUCHES ANYTHING.' },\n  { id: 'body', name: 'BODY', line: 'NO EFFECT. GREAT IMPORTANCE.' },\n];\nexport const PAINT_PRICE = 500, RIM_PRICE = 300;\n// Setup sliders. needs: part ids, any of which makes the slider available.\nexport const SETUP_SLIDERS = [\n  { id: 'gearing', name: 'GEARING', needs: ['gearbox'], min: 0.85, max: 1.15, step: 0.01, def: 1, low: 'ACCELERATION', high: 'TOP SPEED', line: 'SHORT GEARS PULL HARD. LONG GEARS RUN ON.' },\n  { id: 'lsd', name: 'LSD', needs: ['lsd'], min: 0.2, max: 0.8, step: 0.02, def: 0.4, low: 'FREE', high: 'LOCKED', line: 'LOCKED PUTS POWER DOWN. FREE TURNS IN.' },\n  { id: 'balance', name: 'BALANCE', needs: ['suspSport', 'suspRace'], min: 0.45, max: 0.7, step: 0.01, def: 0.56, low: 'TURNS IN', high: 'STABLE', line: 'WHERE THE CAR LEANS, IT LETS GO FIRST.' },\n  { id: 'ride', name: 'RIDE HEIGHT', needs: ['suspRace'], min: 0.9, max: 1, step: 0.01, def: 1, low: 'LOW', high: 'HIGH', line: 'LOW IS QUICK. BELOW 0.94 THE KERBS WILL BE FELT.' },\n  { id: 'brakeF', name: 'BRAKE BALANCE', needs: ['brakeRace'], min: 0.5, max: 0.75, step: 0.01, def: 0.62, low: 'REAR', high: 'FRONT', line: 'REAR BIAS ROTATES THE CAR. FRONT BIAS IS CALM.' },\n  { id: 'downforce', name: 'DOWNFORCE', needs: ['aeroWing'], min: 0.5, max: 1.5, step: 0.05, def: 1, low: 'LOW DRAG', high: 'HIGH GRIP', line: 'THERE IS NO THIRD THING.' },\n];\nEOF\ncat > src/game/data/events.js <<'EOF'\n// Career events. pool entries are carId or [carId, 'tuned']. round: { track, laps, hour?, rain? }.\nexport const POINTS = [10, 8, 6, 5, 4, 3, 2, 1];\nexport const PRIZE_RATIO = [1, 0.6, 0.4, 0.2];\nexport const TIERS = ['C', 'B', 'A'];\nexport const EVENTS = {\n  dawn: { name: 'DAWN PATROL CUP', needs: ['C'], limit: { maxPS: 210 }, restriction: '210 PS OR LESS', pace: [0.86, 0.9], pool: ['pico', 'kite', 'moth'], prize: 1500, bonus: 3000, field: 6, wear: 0.5, rounds: [{ track: 'kestrel', laps: 2 }, { track: 'harbour', laps: 2, hour: 18.5 }, { track: 'kestrel', laps: 3 }], intro: 'THE FIRST RACE OF A RACING LIFE. THE MORNING IS COOL. NOBODY IS WATCHING.' },\n  fellow: { name: 'FRONT-DRIVE FELLOWSHIP', needs: ['C'], limit: { maxPS: 230, layout: ['FF'] }, restriction: 'FRONT DRIVE, 230 PS OR LESS', pace: [0.88, 0.91], pool: ['kite', ['kite', 'tuned'], ['pico', 'tuned']], prize: 2000, bonus: 5000, field: 6, wear: 0.5, rounds: [{ track: 'cedar', laps: 2 }, { track: 'saltline', laps: 4 }], intro: 'THE MEMBERS MEET TWICE A YEAR TO DISCUSS UNDERSTEER. THEY ARE AGAINST IT.' },\n  feather: { name: 'FEATHERWEIGHT TROPHY', needs: ['B'], limit: { maxKg: 1100 }, restriction: '1,100 KG OR LESS', pace: [0.9, 0.93], pool: ['moth', 'kiteCup', ['pico', 'tuned']], prize: 3000, bonus: 8000, prizeCar: 'kiteCup', field: 7, wear: 0.5, rounds: [{ track: 'cedar', laps: 3 }, { track: 'kestrel', laps: 3 }, { track: 'harbour', laps: 3, hour: 18.5 }], intro: 'THE SCALES ARE AT THE GATE. THEY ARE ACCURATE. PLEASE REMOVE YOUR SHOES IF NECESSARY.' },\n  society: { name: 'REAR-DRIVE SOCIETY', needs: ['B'], limit: { layout: ['FR'] }, restriction: 'FRONT ENGINE, REAR DRIVE', pace: [0.91, 0.94], pool: ['ginga', 'brandt32', 'longhorn'], prize: 3500, bonus: 10000, field: 7, wear: 0.5, rounds: [{ track: 'kestrel', laps: 3, rain: true }, { track: 'saltline', laps: 5 }], intro: 'THE SOCIETY RACES IN ANY WEATHER. IT HAS OPINIONS ABOUT THOSE WHO DO NOT.' },\n  clay: { name: 'RED CLAY RALLY', needs: ['B'], limit: {}, restriction: 'ANY CAR. DIRT TYRES ADVISED', pace: [0.91, 0.95], pool: ['ryu', 'ryuRally'], prize: 4000, bonus: 0, prizeCar: 'ryuRally', field: 2, wear: 0.5, rally: true, rounds: [{ track: 'redclay', laps: 2 }, { track: 'redclay', laps: 2 }, { track: 'redclay', laps: 2 }], intro: 'THREE LEGS. ONE RIVAL EACH. THE CLOCK DECIDES. THE CANYON HAS NO OPINION.' },\n  touring: { name: 'PENINSULA TOURING TROPHY', needs: ['A'], limit: { maxPS: 520 }, restriction: '520 PS OR LESS', pace: [0.93, 0.96], pool: ['brandt32', 'heck', 'libeccio', 'longhorn', ['ryu', 'tuned']], prize: 6000, bonus: 40000, prizeCar: 'corsa', field: 8, wear: 0.5, rounds: [{ track: 'cedar', laps: 3 }, { track: 'harbour', laps: 3 }, { track: 'saltline', laps: 6 }, { track: 'kestrel', laps: 4 }], intro: 'FOUR CIRCUITS. THE WHOLE PENINSULA. THE GRANDSTANDS HAVE BEEN PAINTED.' },\n  h200: { name: 'HARBOUR LIGHTS 200', needs: ['A'], limit: {}, restriction: 'ANY CAR. ONE STOP NEEDED', pace: [0.92, 0.95], pool: ['heck', 'libeccio', ['brandt32', 'tuned']], prize: 20000, bonus: 0, prizeCar: 'works', field: 8, wear: 1, endurance: true, rounds: [{ track: 'harbour', laps: 10, hour: 18.5, hourEnd: 21 }], intro: 'TEN LAPS, DUSK INTO NIGHT. YOU WILL NEED FUEL AND TYRES. YOU WILL NEED BENNO.' },\n  gp: { name: 'THE HALCYON GRAND PRIX', needs: ['A'], needsAny: ['touring', 'h200'], limit: {}, restriction: 'ANY CAR', pace: [0.96, 0.99], pool: ['works', 'corsa', ['libeccio', 'tuned']], prize: 30000, bonus: 0, prizeCar: 'type9', field: 8, wear: 0.5, ending: true, rounds: [{ track: 'kestrel', laps: 5 }, { track: 'cedar', laps: 5 }, { track: 'saltline', laps: 8 }, { track: 'harbour', laps: 5 }], intro: 'THE LAST RACE ON THE CALENDAR. THE WHOLE PENINSULA CLOSES FOR IT.' },\n};\nexport const EVENT_IDS = Object.keys(EVENTS);\n// What 'tuned' means on an AI car: a fixed install, so the same field every time.\nexport const AI_TUNES = { tuned: { parts: ['exhaust', 'intake', 'stage2', 'weight1', 'suspSport', 'brakeSport'], tyre: 'sport' } };\nEOF\ncat > src/game/data/licences.js <<'EOF'\n// Licence tests as data. start and end are places: { s } metres from the line or { c, off } metres from corner c's apex.\n// kind: section (time from start to end), stop (stop inside a box), cones (a weave), lap (flying lap).\nimport { MEDALS } from './medals.js';\nexport const LICENCES = {\n  C: { id: 'C', name: 'PROVISIONAL', line: 'WHERE EVERYONE BEGINS.', reward: 2000, allGold: { car: 'pico', text: 'THE TSUBAME PICO 660, WITH MS. ARAI\\'S COMPLIMENTS.' }, tests: ['C-1', 'C-2', 'C-3', 'C-4'] },\n  B: { id: 'B', name: 'CLUB', line: 'FOR THOSE WHO HAVE LEARNED TO WAIT.', reward: 5000, allGold: { car: 'moth', text: 'THE CASTELLAN MOTH 1.8. MS. ARAI IS SAID TO HAVE SMILED.' }, tests: ['B-1', 'B-2', 'B-3', 'B-4'], needs: 'C' },\n  A: { id: 'A', name: 'NATIONAL', line: 'FEW HOLD IT. NONE OF THEM TALK ABOUT IT.', reward: 10000, allGold: { credits: 25000, helmet: true, text: '25,000 CR AND A GOLD HELMET FOR THE SHELF.' }, tests: ['A-1', 'A-2', 'A-3', 'A-4'], needs: 'B' },\n};\nconst T = {\n  'C-1': { title: 'START AND STOP', lesson: 'THE BRAKE IS A PEDAL WITH A FAR END.', carId: 'kite', track: 'proving', start: { s: 0 }, startSpeed: 0, standing: true, kind: 'stop', box: { s: 400, len: 30 }, brief: ['ACCELERATE TO THE MARKER, THEN BRING THE CAR TO REST', 'INSIDE THE WHITE BOX. PLEASE REMEMBER: THE BRAKE IS', 'ALSO A STEERING WHEEL.'], tip: 'BRAKE LATER THAN IS COMFORTABLE, THEN LATER THAN THAT.' },\n  'C-2': { title: 'FIRST CORNER', lesson: 'TURN IN, APEX, UNWIND.', carId: 'kite', track: 'proving', start: { c: 0, off: -100 }, startSpeed: 60, kind: 'section', end: { c: 1, off: 100 }, brief: ['A LONG RIGHT-HANDER, THEN ANOTHER. TURN IN ONCE.', 'TOUCH THE INSIDE. LET THE CAR RUN WIDE ON THE WAY OUT.'], tip: 'IF YOU ARE STILL STEERING MORE AT THE EXIT, YOU TURNED IN TOO SOON.' },\n  'C-3': { title: 'CONE WEAVE', lesson: 'WEIGHT MOVES.', carId: 'kite', track: 'proving', start: { s: 100 }, startSpeed: 50, kind: 'cones', cones: { from: 210, spacing: 40, count: 6 }, end: { s: 460 }, brief: ['PASS THE SIX CONES, RIGHT OF THE FIRST, LEFT OF THE', 'NEXT. EACH CONE YOU HIT OR MISS ADDS ONE SECOND.'], tip: 'BEGIN EACH TURN BEFORE YOU THINK YOU NEED TO.' },\n  'C-4': { title: 'THE SHORT LOOP', lesson: 'LINK CORNERS. KEEP YOUR HEAD UP.', carId: 'kite', track: 'proving', start: { c: 2, off: -50 }, startSpeed: 60, kind: 'section', end: { c: 6, off: 50 }, brief: ['FIVE CORNERS IN A ROW. THE EXIT OF EACH IS THE ENTRY', 'OF THE NEXT. PLEASE LOOK WHERE YOU WISH TO GO.'], tip: 'A SMALL MISTAKE EARLY BECOMES A LARGE ONE LATER.' },\n  'B-1': { title: 'THRESHOLD', lesson: 'SQUEEZE. DO NOT STAMP.', carId: 'ginga', track: 'proving', start: { s: -60 }, startSpeed: 160, kind: 'stop', box: { s: 150, len: 34 }, assists: { abs: false }, lockAllowed: true, brief: ['ABS IS OFF. YOU ARRIVE AT 160 KM/H. STOP INSIDE THE', 'BOX. LOCKING THE WHEELS IS ALLOWED, AND IT WILL COST', 'YOU TIME.'], tip: 'A LOCKED TYRE IS A TYRE THAT HAS STOPPED HELPING.' },\n  'B-2': { title: 'HAIRPIN EXIT', lesson: 'FEED THE THROTTLE.', carId: 'ginga', track: 'kestrel', start: { c: 5, off: -150 }, startSpeed: 100, kind: 'section', end: { c: 7, off: 60 }, assists: { tcs: 0 }, brief: ['TRACTION CONTROL IS OFF. THE REAR AXLE WILL DO WHAT', 'YOUR RIGHT FOOT SAYS. PLEASE SAY IT SLOWLY.'], tip: 'THE TIME IS MADE ON THE EXIT. IT IS LOST THERE AS WELL.' },\n  'B-3': { title: 'THREE LAYOUTS', lesson: 'FF, FR, 4WD IN THE SAME CORNERS.', carId: 'kite', legs: ['kite', 'ginga', 'ryu'], track: 'proving', start: { c: 7, off: -40 }, startSpeed: 50, kind: 'section', end: { c: 10, off: 40 }, brief: ['THE SAME FOUR CORNERS IN THREE CARS. FRONT DRIVE, THEN', 'REAR, THEN ALL FOUR. YOUR TIMES ARE ADDED TOGETHER.'], tip: 'WHAT WORKED IN THE LAST CAR IS NOW INCORRECT.' },\n  'B-4': { title: 'ONE LAP OF KESTREL', lesson: 'RHYTHM.', carId: 'ginga', track: 'kestrel', start: { s: -220 }, startSpeed: 120, kind: 'lap', brief: ['ONE FLYING LAP OF KESTREL PARK. THE WINDMILL WILL', 'NOT TURN TO LOOK. PLEASE DRIVE ANYWAY.'], tip: 'THERE ARE FOURTEEN CORNERS. THERE IS ONLY ONE RHYTHM.' },\n  'A-1': { title: 'BLIND CREST', lesson: 'TRUST THE ROAD YOU REMEMBER.', carId: 'brandt32', track: 'cedar', start: { c: 3, off: -100 }, startSpeed: 100, kind: 'section', end: { c: 5, off: 100 }, brief: ['THE ROAD GOES OVER A CREST. IT CONTINUES ON THE OTHER', 'SIDE. YOU WILL HAVE TO TAKE THIS ON TRUST.'], tip: 'BE STRAIGHT WHEN THE CAR GOES LIGHT.' },\n  'A-2': { title: 'SWITCHBACKS', lesson: 'MOMENTUM.', carId: 'moth', track: 'cedar', start: { c: 7, off: -40 }, startSpeed: 60, kind: 'section', end: { c: 10, off: 30 }, brief: ['FOUR TIGHT CORNERS, UPHILL, IN THE MOTH. THERE ARE 135', 'PS. WHATEVER SPEED YOU LOSE, YOU WILL NOT SEE AGAIN.'], tip: 'A WIDE CORNER AT SPEED BEATS A TIDY ONE WITHOUT.' },\n  'A-3': { title: 'RED CLAY', lesson: 'ROTATE WITH THE HANDBRAKE.', carId: 'ryuRally', track: 'redclay', start: { c: 7, off: -50 }, startSpeed: 60, kind: 'section', end: { c: 10, off: 40 }, brief: ['DIRT. THE RYU RALLY. THE HAIRPIN WILL NOT COME TO YOU.', 'A TOUCH OF HANDBRAKE TURNS THE CAR. THE THROTTLE', 'BRINGS IT BACK.'], tip: 'LOOK AT THE EXIT, AND NOT AT THE CANYON WALL.' },\n  'A-4': { title: 'HARBOUR AT NIGHT', lesson: 'EVERYTHING, BY LAMPLIGHT.', carId: 'libeccio', track: 'harbour', start: { s: -220 }, startSpeed: 120, kind: 'lap', hour: 21, noMargin: true, brief: ['ONE LAP OF THE HARBOUR AT NIGHT, IN THE LIBECCIO. THE', 'WALLS ARE CLOSE. A TOUCH ENDS THE ATTEMPT.'], tip: 'THE LAMPS ARE NOT THERE FOR YOU. THE WALLS ARE.' },\n};\nexport const TESTS = Object.fromEntries(Object.entries(T).map(([id, t]) => [id, { id, licence: id[0], medals: MEDALS[id], ...t }]));\nexport const TEST_IDS = Object.keys(TESTS);\nexport const LICENCE_ORDER = ['C', 'B', 'A'];\nEOF\ncat > src/game/data/medals.js <<'EOF'\n// Written by tools/medals.mjs from the AI demonstrations (gold T x 1.03, silver x 1.09, bronze x 1.18). Frozen here.\nexport const MEDALS = {};\nEOF\ncat > src/game/data/text.js <<'EOF'\n// Everything the cast says, in the catalogue voice. Uppercase: the HUD font has no other case.\nexport const SPEAKERS = {\n  arai: { name: 'MS. ARAI', pitch: 210, wave: 'sawtooth', manner: 'even', title: 'CHIEF EXAMINER' },\n  benno: { name: 'BENNO', pitch: 130, wave: 'square', manner: 'gravel', title: 'MECHANIC' },\n  fenn: { name: 'MR. FENN', pitch: 180, wave: 'sawtooth', manner: 'lilt', title: 'DEALER' },\n  dell: { name: 'DELL', pitch: 160, wave: 'sawtooth', manner: 'fast', title: 'COMMENTATOR' },\n};\nexport const LINES = {\n  arai: {\n    greet: 'WELCOME TO THE PENINSULA. A LICENCE IS NOT DIFFICULT TO OBTAIN. IT IS ONLY DIFFICULT TO DESERVE.',\n    fail: ['THE BOX HAS NOT MOVED. PLEASE TRY AGAIN.', 'THAT WAS NOT THE ROAD. THE ROAD IS THE GREY PART.', 'WE HAVE TIME. WE HAVE A GREAT DEAL OF TIME.'],\n    gold: ['THANK YOU. THAT WAS CORRECT.', 'YES. THAT IS HOW IT IS DONE.'],\n    silver: ['VERY NEARLY CORRECT.', 'GOOD. THE GOLD TIME REMAINS AVAILABLE.'],\n    bronze: ['A PASS. THE PAPERWORK DOES NOT MENTION HOW CLOSE.', 'THAT WILL DO. FOR NOW.'],\n    offerLine: 'MAY I SUGGEST THE DRIVING LINE? THERE IS NO SHAME IN IT. THERE IS ONLY A LINE.',\n    licence: 'YOUR LICENCE. PLEASE DO NOT LAMINATE IT.',\n    demo: 'PLEASE OBSERVE. I WILL NOT BE HURRYING.',\n    idle: 'THE TOWER IS OPEN. PLEASE CHOOSE A LICENCE.',\n  },\n  fenn: {\n    hello: 'WELCOME TO THE ROW. EVERY CAR HERE HAS A KERB WEIGHT, AND I KNOW THEM ALL.',\n    bought: 'CONGRATULATIONS. PLEASE LOOK AFTER HER. SHE HAS BEEN WAITING.',\n    poor: 'A BEAUTIFUL CAR. PERHAPS AFTER ANOTHER RACE OR TWO.',\n    lowLicence: 'I AM SORRY. THIS ONE WANTS A NATIONAL LICENCE.',\n    sold: 'SHE WILL BE MISSED. I WILL SEE TO IT PERSONALLY.',\n  },\n  benno: {\n    hello: 'WHAT DID YOU DO TO IT THIS TIME?',\n    oilTired: 'YOUR OIL IS TIRED. IT HAS SEEN THINGS. TWO HUNDRED AND FIFTY CREDITS.',\n    oilFresh: 'THE OIL IS FINE. YOU ARE WORRYING. I RESPECT THAT.',\n    oilDone: 'FRESH OIL. ABOUT TWO PERCENT MORE POWER, FOR THE FIRST HUNDRED KILOMETRES.',\n    wash: 'IT IS NOT FASTER NOW. IT IS SIMPLY POLITE.',\n    washClean: 'IT IS ALREADY CLEAN. I WILL NOT TAKE YOUR MONEY FOR THAT. WELL. FIFTY CREDITS.',\n    wing: 'YOU NOW HAVE MORE DOWNFORCE. YOU ALSO HAVE MORE DRAG. THERE IS NO THIRD THING.',\n    engine: 'LISTEN TO THAT. NO, CLOSER. THAT IS THE SOUND OF MONEY LEAVING.',\n    weight: 'I TOOK OUT THE PARTS YOU WILL NOT MISS. YOU WILL MISS THEM A LITTLE.',\n    tyres: 'FOUR NEW TYRES. PLEASE KEEP THEM ON THE ROAD.',\n    brakes: 'NOW YOU CAN ARRIVE AT THE CORNER LATER. THE CORNER HAS NOT MOVED.',\n    susp: 'IT SITS LOWER NOW. MIND THE SPEED BUMP AT THE CHURCH.',\n    drive: 'THE POWER NOW GETS TO THE ROAD. MOST OF IT.',\n    body: 'A NEW COLOUR. IT IS STILL THE SAME CAR. BUT YES. IT LOOKS WELL.',\n    pit: ['IN AND OUT. PLEASE KEEP YOUR HANDS INSIDE.', 'FRESH TYRES. THE OLD ONES ARE RETIRING WITH HONOURS.', 'FUEL IS GOING IN. PLEASE DO NOT SMOKE.'],\n  },\n  dell: {\n    win: ['A WIN AT {TRACK}. THE CROWD HAS BEEN INFORMED.', 'FIRST PLACE. {NAME} DROVE THIS CORRECTLY.', 'THE LINE WAS CROSSED FIRST BY {NAME}. THIS IS A FACT.'],\n    podium: ['ON THE PODIUM AT {TRACK}. THE STEPS ARE NEWLY PAINTED.', 'A SOLID RESULT. THE GRANDSTAND APPLAUDED AT A REASONABLE VOLUME.'],\n    mid: ['A QUIET AFTERNOON AT {TRACK}.', 'PLACED {POS}. THE CAR IS UNHARMED. THE TIME WAS NOT.'],\n    record: 'LAP RECORD AT {TRACK}. {TIME}. THE WINDMILL DID NOT TURN TO LOOK.',\n    replay: ['THERE IS THE BRAKING POINT. THERE IS THE CORNER.', 'AND AGAIN, FROM THE BRIDGE.', 'A VERY TIDY LINE THROUGH HERE.', 'THE GAP IS SMALL. THE GAP REMAINS.', 'THE TYRES ARE WORKING HARD. YOU CAN SEE IT, IF YOU KNOW.'],\n    start: 'THE FIELD IS FORMED. THE LIGHTS ARE ON THE GANTRY.',\n  },\n};\nexport const TIPS = [\n  'BRAKE IN A STRAIGHT LINE. A TYRE HAS ONLY SO MUCH GRIP TO SHARE.',\n  'SLOW IN, FAST OUT. THIS HAS BEEN TRUE FOR SOME TIME.',\n  'A WASHED CAR IS NOT FASTER. IT IS SIMPLY POLITE.',\n  'THE FRONT-DRIVE CAR PULLS. THE REAR-DRIVE CAR PUSHES. CHOOSE WHICH TO ARGUE WITH.',\n  'TIRED OIL COSTS POWER. THE SERVICE BAY IS NEAR THE LIGHTHOUSE.',\n  'ON A LONG STRAIGHT, STAY BEHIND THE CAR AHEAD. THEN DO NOT.',\n  'IN THE RAIN, EVERY CORNER IS ONE GEAR LONGER THAN YOU THINK.',\n  'ALL FOUR TYRES WEAR. YOU CAN SEE THEM IN THE CORNER OF THE SCREEN.',\n];\nexport const MAP_PLACES = [\n  { id: 'licence', name: 'LICENCE CENTRE', blurb: 'EVERY DRIVER BEGINS WITH A CLIPBOARD.' },\n  { id: 'events', name: 'EVENT HALL', blurb: 'THE ROAD BETWEEN YOU AND THE GRAND PRIX.' },\n  { id: 'dealer', name: 'DEALER ROW', blurb: 'THREE SHOWROOMS AND A USED LOT. BRING MONEY.' },\n  { id: 'tuning', name: 'TUNING STREET', blurb: 'WHAT YOU BUY HERE YOU WILL FEEL.' },\n  { id: 'service', name: 'SERVICE BAY', blurb: 'OIL AND SOAP.' },\n  { id: 'garage', name: 'HOME GARAGE', blurb: 'EVERYTHING YOU HAVE EARNED.' },\n  { id: 'museum', name: 'MUSEUM', blurb: 'CARS YOU HAVE MET.' },\n  { id: 'theatre', name: 'THEATRE', blurb: 'WATCH IT AGAIN, MORE SLOWLY.' },\n  { id: 'arcade', name: 'ARCADE GATE', blurb: 'NO LICENCE REQUIRED. NO MONEY EITHER.' },\n];\nexport const ENDING_LINES = ['YOU MAY KEEP DRIVING.', 'MOST PEOPLE DO.'];\nexport const PRIZE_SELL = 'PRIZE CARS ARE NOT FOR SALE. IT IS SIMPLY NOT DONE.';\nexport const LAST_CAR = 'YOU CANNOT SELL YOUR LAST CAR. HOW WOULD YOU GET HOME?';\nexport const HANDBOOK = [\n  { title: 'CONTROLS', device: true },\n  { title: 'WHAT YOU CAN AND CANNOT DO', lines: ['CARS CANNOT BE DAMAGED OR FLIP OVER, BY DESIGN.', 'YOU CAN HIT WALLS AND CARS. IT COSTS YOU TIME.', 'YOU CANNOT LEAVE THE CIRCUIT PAST THE BARRIERS.', 'THERE IS NO COCKPIT VIEW. THERE IS A BONNET VIEW.'] },\n  { title: 'RECOVERY', lines: ['A STOPPED OR LOST CAR CAN BE PUT BACK ON THE ROAD', 'AT ANY TIME. HOLD THE RECOVER BUTTON FOR ONE SECOND.', 'IN A LICENCE TEST, RECOVERY ENDS THE ATTEMPT.'] },\n  { title: 'ASSISTS', lines: ['ABS STOPS THE BRAKES LOCKING. TRACTION TRIMS POWER.', 'STABILITY ARGUES WITH A SLIDE. EACH CAN BE TURNED', 'DOWN ON ITS OWN FROM THE PAUSE MENU. THE DRIVING', 'LINE SHOWS WHERE TO GO, AND RED WHERE TO BRAKE.'] },\n  { title: 'TYRES AND WEAR', lines: ['FOUR SQUARES IN THE CORNER OF THE SCREEN SHOW YOUR', 'FOUR TYRES. GREEN IS FRESH. RED IS FINISHED.', 'SOFTER TYRES GRIP MORE AND WEAR FASTER. A WORN TYRE', 'GRIPS ABOUT THREE QUARTERS AS WELL AS A NEW ONE.'] },\n  { title: 'PIT STOPS', lines: ['ON THE PIT STRAIGHT, KEEP RIGHT AND CROSS THE ENTRY', 'LINE. THE CREW TAKES THE CAR AND STOPS IT IN THE BOX.', 'TYRES TAKE FOUR SECONDS. FUEL TAKES A TENTH PER', 'PERCENT. PRESS BACK TO SKIP THE TYRES.'] },\n  { title: 'TUNING IN PLAIN WORDS', lines: ['POWER MOVES YOU ALONG THE STRAIGHT. WEIGHT HELPS', 'EVERYWHERE. TYRES HELP CORNERS. AERO HELPS FAST', 'CORNERS AND HURTS TOP SPEED. PARTS THAT OFFER A', 'SETTING ADD A SLIDER ON THE SETUP TAB.'] },\n  { title: 'RALLY', lines: ['ON DIRT THE ROAD IS LOOSE AND THE CLOCK DECIDES. FIT', 'RALLY TYRES. STABILITY IS HALVED ON DIRT. A TOUCH OF', 'HANDBRAKE ROTATES THE CAR IN A HAIRPIN. THE CRESTS', 'WILL LIFT YOU, SO BE STRAIGHT WHEN THEY DO.'] },\n  { title: 'MEDALS', lines: ['A TEST IS PASSED AT BRONZE. A LICENCE NEEDS BRONZE', 'IN ALL FOUR. GOLD IN ALL FOUR EARNS A PRIZE.', 'MEDALS AND RECORDS ARE NOT KEPT WHEN DEV SLIDERS', 'ARE AWAY FROM THEIR DEFAULTS.'] },\n];\nEOF\necho ok","description":"Write car, tyre, part, event, licence and text data"}}}
