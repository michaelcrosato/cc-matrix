metry(0.34, 0.9, 6), toonMaterial(PALETTE.orange)); m.position.set(k.x, k.y + 0.45, k.z); setLookLayer(m, 'actors'); m.castShadow = true; ctx.scene.add(m);\",\"const m = buildModel(coneDef, {}).object; m.position.set(k.x, k.y, k.z); setLookLayer(m, 'actors'); for (const q of m.children) if (q.isMesh) q.castShadow = true; ctx.scene.add(m);\")\nrep(R,\"k.m.position.y = Math.max(k.k.y + 0.2, k.m.position.y + k.vy * dt);\",\"k.m.position.y = Math.max(k.k.y, k.m.position.y + k.vy * dt);\")\nrep(R,\"import { PALETTE, setLookLayer, THREE, toonMaterial, Trail } from '../../pixel-engine.js';\",\"import { buildModel, setLookLayer, THREE, Trail } from '../../pixel-engine.js';\\nimport { coneDef } from '../models/props.js';\")\nrep(R,\"const { ConeGeometry, Group, Mesh, Vector3 } = THREE;\",\"const { Group, Vector3 } = THREE;\")\nD='src/game/render/dressing.js'\nrep(D,\"    d.scatter(40, (x, y, z) => { b.cone(x, y, z, 0.95, 1.3, 7, 'sand', 0.95, r() * 3); b.cone(x, y + 1.3, z, 0.95, 0.35, 7, mix('sand', 'orange', 0.4)); }, { minD: 2, maxD: 26, r: 1 });\\n\",\"    d.scatter(30, (x, y, z) => d.place(haybaleDef, x, y, z, r() * 3), { minD: 2, maxD: 26, r: 1 });\\n    d.scatter(10, (x, y, z) => d.place('haystack', x, y, z, r() * 3), { minD: 8, maxD: 40, r: 2 });\\n    d.scatter(12, (x, y, z) => d.place('birch', x, y, z, r() * 3), { minD: 6, maxD: 50, r: 3 });\\n\")\nrep(D,\"for (let k = 0; k < 70; k++) { const x = -420 + r() * 1000, z = quay + 12 + r() * 16 - 8, n = 1 + Math.floor(r() * 4); for (let q = 0; q < n; q++) b.box(x, d.mesh.groundY + 3 + q * 2.6, z, 12, 2.6, 2.5, r.pick(['red', 'teal', 'blue', 'orange', 'sand', 'slate'])); }\",\"for (let k = 0; k < 70; k++) { const x = -420 + r() * 1000, z = quay + 12 + r() * 16 - 8, n = 1 + Math.floor(r() * 4); for (let q = 0; q < n; q++) b.box(x, d.mesh.groundY + 3 + q * 2.6, z, 12, 2.6, 2.5, r.pick(['red', 'teal', 'blue', 'orange', 'sand', 'slate'])); }\\n    for (let k = 0; k < 8; k++) d.place(containerDef, -300 + k * 90, d.mesh.groundY + 3, quay + 22, Math.PI / 2);\\n    for (let k = 0; k < 14; k++) d.place(k % 2 ? 'crate' : 'barrel', -360 + k * 60 + r() * 12, d.mesh.groundY + 3, quay + 6 + r() * 4, r() * 3);\")\nrep(D,\"    // Thin mist.\\n\",\"    d.place('bench', hut.x + 4, hut.y, hut.z - 3, 0.3); d.place('signpost', hut.x - 4, hut.y, hut.z + 3, 0.6);\\n    // Thin mist.\\n\")\nrep(D,\"import { blockText } from './blocktext.js';\",\"import { blockText } from './blocktext.js';\\nimport { containerDef, haybaleDef } from '../models/props.js';\")\n# ---- Pit lane, in every race; a long way onto the apron in a short one, so running wide is not a pit stop.\nRc='src/game/sim/race.js'\nrep(Rc,\"if (human) { if (this.laps >= 10 && c.u > 1 && c.loc.t > halfW + 0.3 && d >= tr.pit.in - 4 && d < tr.pit.box - 40) this.enterPit(e); } // the pit lane opens only for races long enough to need it\",\"if (human) { if (c.u > 1 && c.loc.t > halfW + (this.laps >= 10 ? 0.3 : 3) && d >= tr.pit.in - 4 && d < tr.pit.box - 40) this.enterPit(e); } // in a short race it takes a deliberate move: running wide off the last corner is not a pit stop\")\nrep('src/game/data/text.js',\"'IN RACES OF TEN LAPS OR MORE, KEEP RIGHT ONTO THE', 'APRON BEFORE THE ENTRY LINE. THE CREW TAKES THE CAR.',\",\"'ON THE PIT STRAIGHT, KEEP WELL RIGHT ONTO THE APRON', 'BEFORE THE ENTRY LINE. THE CREW TAKES THE CAR.',\")\nrep('docs/adding-content.md',\"Pit stops open at ten laps or more. \",\"The AI pits only in races of ten laps or more. \")\n# ---- B-1: stop inside a box 150 m on.\nrep('src/game/data/licences.js',\"carId: 'ginga', track: 'proving', start: { s: -60 }, startSpeed: 160, kind: 'stop', box: { s: 150, len: 34 },\",\"carId: 'ginga', track: 'proving', start: { s: 0 }, startSpeed: 160, kind: 'stop', box: { s: 150, len: 34 },\")\n# ---- Attract: slipstream at 300 km/h past the blimp.\nrep('src/game/attract/director.js',\"cars: [{ carId: 'corsa', name: 'DEMO 1', skill: 1.04 }, { carId: 'type9', name: 'DEMO 2', skill: 1.02 }] }\",\"cars: [{ carId: 'type9', name: 'DEMO 1', skill: 1.02 }, { carId: 'type9', name: 'DEMO 2', skill: 1 }] }\")\n# ---- audio/music.js, and ctx.audio.loop voices for the other cars.\nopen('src/game/audio/music.js','w').write(\"\"\"// Music: one song at a time from data/songs.js, through the engine's sequencer. The Settings slider sets its level.\nimport { SONGS } from '../data/songs.js';\nexport function playSong(audio, id) { audio.playMusic(id === null ? null : SONGS[id], id ?? undefined); }\n\"\"\")\nM='src/game/audio/mix.js'\nrep(M,\"    if (songId === null) { this.audio.playMusic(null); this.song = null; return; }\\n    this.song = songId; this.audio.playMusic(SONGS[songId], songId);\",\"    this.song = songId; playSong(this.audio, songId);\")\nrep(M,\"import { SONGS } from '../data/songs.js';\\n\",\"import { playSong } from './music.js';\\nimport { spatialize } from '../../pixel-engine.js';\\n\")\nrep(M,\"  // state: { tyre, wind, gravel, rain, kerb, crowd }: gains 0..1.\\n\",\"\"\"  // The nearest other cars: looping voices placed in the world, pitched by their rpm. list: [{ x, y, z, rpm }].\n  others(list, listener) {\n    if (!this.audio || this.silent) return;\n    this.loopVoices ??= [];\n    for (let i = 0; i < 3; i++) {\n      const it = list[i]; let v = this.loopVoices[i];\n      if (!it) { v?.set({ volume: 0 }); continue; }\n      if (!v || v.stopped) v = this.loopVoices[i] = this.audio.loop('carLoop', { volume: 0 });\n      const s = spatialize(listener, it, { ref: 6, max: 110 });\n      v.set({ volume: s.gain * 0.5, pan: s.pan, pitch: 12 * Math.log2(Math.max(0.25, it.rpm / 3000)) });\n    }\n  }\n  // state: { tyre, wind, gravel, rain, kerb, crowd }: gains 0..1.\n\"\"\")\nrep(M,\"  clearCars() { for (const s of this.synths) { try { s?.synth.dispose(); } catch { /* gone */ } } this.synths = []; if (this.built) this.world({}); }\",\"  clearCars() { for (const s of this.synths) { try { s?.synth.dispose(); } catch { /* gone */ } } this.synths = []; for (const v of this.loopVoices ?? []) v?.stop(); this.loopVoices = []; if (this.built) this.world({}); }\")\nrep('src/game/audio/sfx.js',\"  tick: { wave: 'square',\",\"  carLoop: { wave: 'saw', freq: 98, sustain: 0.5, volume: 0.3, layers: [{ wave: 'square', duty: 0.5, freq: 98, sustain: 0.5, volume: 0.14 }] },\\n  tick: { wave: 'square',\")\nSc='src/game/scenes/race.js'\nrep(Sc,\"\"\"    const others = sim.cars.filter((e) => !list.some((l) => l.key === `${e.i}:${e.carId}`)).map((e) => [camD(e), e]).sort((a, b) => a[0] - b[0]).slice(0, 4 - list.length);\n    for (const [d, e] of others) list.push(entry(e, Math.max(0, 0.65 * (1 - d / 110)), panOf(e)));\n    mix.engines(list, dt);\"\"\",\"\"\"    mix.engines(list, dt);\n    // The nearest three others: looping voices in the world, spatialized, pitched by rpm.\n    const others = sim.cars.filter((e) => !list.some((l) => l.key === `${e.i}:${e.carId}`)).map((e) => [camD(e), e]).sort((a, b) => a[0] - b[0]).slice(0, 3);\n    if (!this.ears) this.ears = { position: new Vector3(), right: new Vector3() };\n    this.ears.position.copy(listener); this.ears.right.set(rightX, cam.matrixWorld.elements[1], rightZ);\n    mix.others(others.map(([, e]) => ({ x: e.c.x, y: e.c.y, z: e.c.z, rpm: e.c.rpm })), this.ears);\"\"\")\ns=open(Sc).read(); s=s.replace(\", panOf = (e) => { const dx = e.c.x - listener.x, dz = e.c.z - listener.z, d = Math.hypot(dx, dz) || 1; return Math.max(-1, Math.min(1, ((dx * rightX + dz * rightZ) / d) * 0.8)); };\",\";\"); open(Sc,'w').write(s)\n# ---- Tests: pit entry, other-car voices, at most 7 items, a prompt row on every screen.\nSm='tools/tests/sim.mjs'\nrep(Sm,\"// A keyboard-style driver, through\",\"\"\"// Pit entry: on the apron at the line in a long race; a deliberate move in a short one, so running wide is not a stop. The AI stays out in short races.\n{ const entry = (laps, off) => { const s = new RaceSim({ track: 'kestrel', laps, start: 'flying', startS: -300, startSpeed: 90, contact: false, record: false, cars: [{ carId: 'ginga', player: 0, assists: {}, name: 'YOU' }] }), e = s.cars[0], at = s.tr.pit.in - 2, pt = trackPoint(s.tr, at, s.tr.width[0] / 2 + off), c = e.c; c.x = pt.x; c.y = pt.y; c.z = pt.z; c.yaw = pt.yaw; c.loc.i = pt.i; c.loc.s = ((at % s.tr.length) + s.tr.length) % s.tr.length; c.loc.t = s.tr.width[0] / 2 + off; e.lastS = c.loc.s; c.vx = Math.sin(pt.yaw) * 25; c.vz = Math.cos(pt.yaw) * 25; for (let i = 0; i < 12 && !e.pit; i++) s.step([{ throttle: 0.3 }]); return !!e.pit; };\n  t.ok(entry(10, 1), 'a ten-lap race: the apron takes you into the pits'); t.ok(!entry(3, 1), 'a short race: running wide does not'); t.ok(entry(3, 4.5), 'a short race: a deliberate move does'); }\n// A keyboard-style driver, through\"\"\")\nrep(Sm,\"import { RaceSim } from '../../src/game/sim/race.js';\",\"import { RaceSim, trackPoint } from '../../src/game/sim/race.js';\")\nDr='tools/tests/_drive.mjs'\nrep(Dr,\"  constructor(app, engine) { this.app = app; this.engine = engine; this.log = []; }\",\"  constructor(app, engine) { this.app = app; this.engine = engine; this.log = []; this.seen = {}; }\\n  // What every screen showed: at most this many items, and a prompt row.\\n  note() { const u = this.app.ui, id = u.top?.id; if (!id) return; const r = (this.seen[id] ??= { items: 0, prompts: [] }); r.items = Math.max(r.items, u.items.length); for (const [a] of u.promptList) if (!r.prompts.includes(a)) r.prompts.push(a); }\")\nrep(Dr,\"if (this.engine.errors?.length) throw new Error(`game error: ${this.engine.errors[0]}`); await this.tickle(); }\",\"if (this.engine.errors?.length) throw new Error(`game error: ${this.engine.errors[0]}`); this.note(); await this.tickle(); }\")\nHl='tools/tests/headless.mjs'\nrep(Hl,\"// The kit's own headless check:\",\"\"\"// The 10-foot rules, on every screen this suite visited.\n{ const seen = b.seen, ids = Object.keys(seen); t.ok(ids.length >= 25, `screens visited: ${ids.join(',')}`); for (const id of ids) { if (!['map', 'dev', 'prize', 'podium', 'ending'].includes(id)) t.ok(seen[id].items <= 7, `${id} has ${seen[id].items} focusable items, at most 7`); if (!['attract'].includes(id)) t.ok(seen[id].prompts.length > 0, `${id} has a prompt row`); if (!['title', 'map', 'greeting', 'results', 'testResult', 'podium', 'prize', 'ending', 'attract', 'dyno'].includes(id)) t.ok(seen[id].prompts.includes('back'), `${id} prompts Back: ${seen[id].prompts.join(',')}`); } }\n// The kit's own headless check:\"\"\")\nAu='tools/tests/audio.mjs'\nrep(Au,\"const level = await page.evaluate(() => { const m = window.__APP__.mix; return { lvl: m.level(), synths: m.synths.length,\",\"const level = await page.evaluate(() => { const m = window.__APP__.mix; return { lvl: m.level(), loops: m.audio.loops.length, loopPitch: m.loopVoices?.[0]?.settings.pitch, synths: m.synths.length,\")\nrep(Au,\"t.ok(level.synths >= 1, 'engine voices run');\",\"t.ok(level.synths >= 1, 'engine voices run'); t.ok(level.loops >= 1 && Number.isFinite(level.loopPitch), `other cars are looping voices pitched by rpm: ${level.loops}, ${level.loopPitch}`);\")\nEOF\nnode tools/medals.mjs 2>&1 | grep -E 'B-1|FAILED' | cut -c1-80; sed -n 2,8p src/game/ui/widgets.js | cut -c1-60; node tools/build.mjs 2>&1 | cut -c1-70 | tail -2; timeout 250 node tools/test.mjs sim data career 2>&1 | tail -4 | cut -c1-300; timeout 280 node tools/test.mjs headless 2>&1 | tail -12 | cut -c1-260","description":"Align the folder map, other-car voices, pit lane, B-1; extend tests; run them","timeout":560000}}}
