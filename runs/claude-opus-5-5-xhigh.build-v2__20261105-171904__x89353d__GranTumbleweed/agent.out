{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BuaNc7NDRZsbnfxwyf6DW3","type":"tool_result","content":"1\t// RaceScene: everything driven. A race, a licence test, a test drive, a time trial, an attract clip, a couch duel, a hub round.\n2\timport { buildModel, setLookLayer, THREE, Trail } from '../../pixel-engine.js';\n3\timport { coneDef } from '../models/props.js';\n4\timport { RaceSim, trackPoint, wrapS } from '../sim/race.js';\n5\timport { DemoBrain, Judge, legCount, placeS, testSetup } from '../sim/licence.js';\n6\timport { F_BRAKE } from '../sim/replaydata.js';\n7\timport { GhostTrace, ghostSample } from '../sim/replaydata.js';\n8\timport { buildWorld } from '../render/world.js';\n9\timport { CarView } from '../render/carview.js';\n10\timport { ChaseCam } from '../render/camera.js';\n11\timport { TvDirector } from '../render/director.js';\n12\timport { PitCrew } from '../render/pitcrew.js';\n13\timport { flagProp, makePerson } from '../render/people.js';\n14\timport { buildDrivingLine } from '../render/trackmesh.js';\n15\timport { GeoBatch } from '../render/geo.js';\n16\timport { RaceHud } from '../ui/racehud.js';\n17\timport { LINES } from '../data/text.js';\n18\timport { drawGlyph, glyphWidth, specFor } from '../ui/glyphs.js';\n19\tconst { Group, Vector3 } = THREE;\n20\tconst P = new Vector3();\n21\texport class RaceScene {\n22\t  constructor(app, setup, opts = {}) {\n23\t    this.name = 'race'; this.app = app; this.data = setup; this.role = opts.role ?? 'main'; this.sim = opts.sim ?? null; this.viewPlayer = opts.viewPlayer ?? 0; this.run = opts.run ?? null; this.opts = opts; this.compact = !!opts.compact;\n24\t    this.target = new Vector3(); this.paused = false; this.views = []; this.t = 0; this.tvMode = false; this.ended = false; this.afterT = null; this.recoverT = 0; this.cheer = 0; this.hudHidden = false; this.upL = [false, false]; this.downL = [false, false]; this.drv = [null, null]; this.frozen = false; this.fireworkT = 0; this.stepFrames = 0; this.legTimes = []; this.leg = setup.leg ?? 0; this.ghost = null; this.trace = null; this.pose = {}; this.camTarget = null;\n25\t  }\n26\t  ready() { if (this.role === 'main' && typeof window !== 'undefined') window.__GAME__ = this.app.handle(); }\n27\t  async setup(ctx) {\n28\t    const app = this.app; if (this.role === 'main') { app.enterScene(ctx, this); app.ui.clear(); app.ui.subtitle = null; app.actions.resetDriver(); }\n29\t    const cam = ctx.camera.camera; cam.near = 0.5; cam.far = 6000; cam.updateProjectionMatrix();\n30\t    this.cam = cam;\n31\t    if (!this.sim) this.sim = new RaceSim({ ...this.data, env: app.env });\n32\t    const sim = this.sim, tr = sim.tr, hour = this.data.hour ?? 12, focusE = this.focusEntry();\n33\t    this.world = buildWorld(ctx, tr, sim.line, { hour, hourEnd: this.data.hourEnd ?? null, rain: !!this.data.rain, speeds: focusE?.speeds });\n34\t    this.buildCars(ctx);\n35\t    this.chase = new ChaseCam(cam);\n36\t    this.chase.mode = app.options.camMode ?? 0;\n37\t    if (app.devSliders) { this.chase.distance = app.devSliders.chase; this.chase.fovBase = app.devSliders.fov; }\n38\t    this.tv = new TvDirector(tr, this.world.field, (this.data.seed ?? 1) + 11);\n39\t    this.hud = new RaceHud(sim, this.compact);\n40\t    if (sim.tr.pit && this.role === 'main' && (this.data.laps > 3 || this.data.kind === 'attract')) { this.crew = new PitCrew(ctx, tr); await this.crew.build(); }\n41\t    this.line = focusE ? buildDrivingLine(tr, sim.line, focusE.speeds) : null;\n42\t    if (this.line) { this.line.visible = false; ctx.scene.add(this.line); }\n43\t    // Licence test: the judge, the box, the cones.\n44\t    if (this.data.test) { this.setupTest(ctx); }\n45\t    // Lights at dusk and night.\n46\t    this.night = this.world.night;\n47\t    if (this.night > 0.15) {\n48\t      this.beam = new THREE.Object3D(); ctx.scene.add(this.beam);\n49\t      this.beamL = ctx.lights.request({ follow: this.beam, color: 0xfff0c0, intensity: 16, radius: 34, priority: 8, decay: 1 });\n50\t      this.tail = new THREE.Object3D(); ctx.scene.add(this.tail);\n51\t      ctx.lights.request({ follow: this.tail, color: 0xff3020, intensity: 4, radius: 8, priority: 3 });\n52\t    }\n53\t    // Marshals at the line. Not in a hub round: its build has to be quick.\n54\t    if (this.role === 'main' && this.data.kind !== 'hub' && this.data.kind !== 'licence') {\n55\t      this.marshals = [];\n56\t      for (const [s0, colour] of [[26, 'red'], [-40, 'sand']]) { const m = await makePerson(ctx, 'marshal'), pt = trackPoint(tr, s0, -(tr.width[0] / 2 + Math.min(tr.wallL[0], 2.5))); m.object.position.set(pt.x, pt.y, pt.z); m.object.rotation.y = pt.yaw + Math.PI / 2; m.play('MarshalFlag', { fade: 0 }); m.attachProp('HandR', flagProp(colour)); ctx.scene.add(m.object); this.marshals.push(m); }\n57\t    }\n58\t    // Taillight trails at night.\n59\t    if (this.night > 0.4) { this.trails = sim.cars.map(() => { const q = new Trail({ width: 0.2, life: 0.4, color: 0xff3020, tail: 0x5d275d, points: 18, minStep: 0.6 }); ctx.scene.add(q); return q; }); }\n60\t    // Ghosts in time trial.\n61\t    if (this.data.kind === 'timetrial') { this.trace = new GhostTrace(); this.traceStart = null; }\n62\t    if (this.opts.ghostData) this.setGhost(ctx, this.opts.ghostData);\n63\t    this.world.setLights(0, false);\n64\t    app.mix.clearCars();\n65\t    const song = this.songFor();\n66\t    if (this.role === 'main') { if (app.options.raceMusic !== false && song) app.mix.music(song); else app.mix.music(null); }\n67\t    this.opts.onReady?.(this, ctx);\n68\t  }\n69\t  songFor() { const d = this.data, t = d.track; if (d.kind === 'licence') return 'exam'; if (t === 'redclay') return 'clay'; if ((d.hour ?? 12) >= 18 || (d.hour ?? 12) < 6) return 'city'; return 'apex'; }\n70\t  focusEntry() { const s = this.sim; return s.cars.find((e) => e.player === this.viewPlayer) ?? s.cars[s.cars.length - 1] ?? null; }\n71\t  buildCars(ctx) {\n72\t    for (const v of this.views) v.dispose();\n73\t    this.views = this.sim.cars.map((e) => { const v = new CarView(e.carId, { install: e.install, paint: e.paint ?? undefined }); v.setDirt(e.dirt); ctx.scene.add(v.object); return v; });\n74\t  }\n75\t  setGhost(ctx, data) {\n76\t    if (this.ghost) this.ghost.view.dispose();\n77\t    const view = new CarView(data.carId, { ghost: 'sky' }); ctx.scene.add(view.object); this.ghost = { view, data };\n78\t  }\n79\t  setupTest(ctx) {\n80\t    const app = this.app, sim = this.sim, tr = sim.tr, test = this.opts.test;\n81\t    this.test = test; this.judge = new Judge(test, sim);\n82\t    this.judge.step(0); this.judge.base = this.opts.legBase ?? 0;\n83\t    if (test.box) { // The white box, painted on the road.\n84\t      const b = new GeoBatch(), s0 = test.box.s - test.box.len / 2, s1 = test.box.s + test.box.len / 2, w = 5, Q = (s, t) => { const p = trackPoint(tr, s, t); return [p.x, p.y + 0.07, p.z]; };\n85\t      const edge = (s, t0, t1) => b.quad(Q(s, t0), Q(s, t1), Q(s + 0.8, t1), Q(s + 0.8, t0), 'white'); edge(s0, -w, w); edge(s1 - 0.8, -w, w); for (let s = s0; s < s1 - 2; s += 2) { const n = s + 2; b.quad(Q(s, -w), Q(s, -w + 0.5), Q(n, -w + 0.5), Q(n, -w), 'white'); b.quad(Q(s, w - 0.5), Q(s, w), Q(n, w), Q(n, w - 0.5), 'white'); }\n86\t      for (let s = s0 - 60; s < s0; s += 8) { b.quad(Q(s, -w), Q(s, -w + 0.3), Q(s + 4, -w + 0.3), Q(s + 4, -w), 'sand'); b.quad(Q(s, w - 0.3), Q(s, w), Q(s + 4, w), Q(s + 4, w - 0.3), 'sand'); }\n87\t      ctx.scene.add(b.mesh({ glow: true }));\n88\t    }\n89\t    if (this.judge.cones) {\n90\t      this.cones = this.judge.cones.map((k) => { const m = buildModel(coneDef, {}).object; m.position.set(k.x, k.y, k.z); setLookLayer(m, 'actors'); for (const q of m.children) if (q.isMesh) q.castShadow = true; ctx.scene.add(m); return { m, k, vy: 0, vx: 0, vz: 0, a: 0 }; });\n91\t    }\n92\t    // The end of the section: a banner across the road.\n93\t    if (test.end) { const s = placeS(tr, test.end), l = trackPoint(tr, s, -tr.width[0] / 2 - 2), r = trackPoint(tr, s, tr.width[0] / 2 + 2), b = new GeoBatch(); b.box(l.x, l.y, l.z, 0.4, 5, 0.4, 'white'); b.box(r.x, r.y, r.z, 0.4, 5, 0.4, 'white'); b.beam([l.x, l.y + 4.6, l.z], [r.x, r.y + 4.6, r.z], 0.3, 0.8, 'red'); ctx.scene.add(b.mesh({ cast: true, receive: false })); }\n94\t    if (this.opts.demo) {\n95\t      const e = sim.cars[0]; e.autoDrive = true; const brain = new DemoBrain(test, sim, this.judge, { skill: 0.97 });\n96\t      sim.aiInput = () => brain.input();\n97\t      this.hud.flash('DEMONSTRATION', 99, false);\n98\t      app.ui.say('arai', LINES.arai.demo);\n99\t    }\n100\t    if (app.options.assists.line || this.opts.showLine) this.lineOn = true;\n101\t    void legCount;\n102\t  }\n103\t  // ---- fixed step ----\n104\t  fixedUpdate(ctx, dt) {\n105\t    const app = this.app; app.actions.latch(ctx);\n106\t    if (this.role !== 'main') return;\n107\t    this.world?.fixedUpdate(dt);\n108\t    if (!this.sim || !this.world) return;\n109\t    if (this.paused && this.stepFrames <= 0) return;\n110\t    if (this.stepFrames > 0) this.stepFrames--;\n111\t    const sim = this.sim;\n112\t    for (const e of sim.cars) { const c = e.c; e.px = c.x; e.py = c.y; e.pz = c.z; e.pyaw = c.yaw; }\n113\t    const inputs = [];\n114\t    for (const e of sim.players) {\n115\t      const d = app.driverOverride?.(e, this.drv[e.player], sim) ?? this.drv[e.player]; if (!d) { inputs[e.player] = {}; continue; }\n116\t      inputs[e.player] = { steer: d.steer, throttle: d.throttle, brake: d.brake, handbrake: d.handbrake, up: this.upL[e.player], down: this.downL[e.player] };\n117\t      this.upL[e.player] = false; this.downL[e.player] = false;\n118\t    }\n119\t    this.opts.beforeStep?.(sim, inputs, dt);\n120\t    sim.step(inputs);\n121\t    if (this.judge) this.judge.step(1 / 60);\n122\t    if (this.trace) this.stepTrace(sim);\n123\t    if (this.opts.afterStep) this.opts.afterStep(sim, dt, this);\n124\t  }\n125\t  stepTrace(sim) { // Time trial: a ghost of this lap at 10 Hz.\n126\t    const e = sim.cars[0], c = e.c;\n127\t    if (e.lap === this.traceLap) { if (sim.frame % 6 === 0) this.trace.add(c.x, c.y, c.z, c.yaw); }\n128\t    else { const done = this.trace, doneLap = this.traceLap; this.trace = new GhostTrace(); this.traceLap = e.lap; this.traceStart = sim.time; if (doneLap && e.lastLap) this.app.lapDone?.(this, done, e.lastLap); }\n129\t  }\n130\t  // ---- per frame ----\n131\t  update(ctx, dt) {\n132\t    const app = this.app, a = app.actions; a.setDt(dt); a.latch(ctx);\n133\t    if (!this.sim || !this.world || !this.chase) { a.send(ctx); return; }\n134\t    this.t += dt;\n135\t    const sim = this.sim, main = this.role === 'main', focus = this.focusE ?? this.focusEntry();\n136\t    this.focusE = focus;\n137\t    // Inputs\n138\t    if (main) for (const e of sim.players) { const d = a.drive(ctx, e.player, dt); this.drv[e.player] = d; if (d.up) this.upL[e.player] = true; if (d.down) this.downL[e.player] = true; }\n139\t    if (main && !this.paused) { this.handleDriverButtons(ctx, focus, dt); this.handleEvents(ctx); }\n140\t    // Lights on the gantry\n141\t    if (sim.phase === 'grid') this.world.setLights(sim.lights, false); else if (sim.time - (sim.greenAt ?? 0) < 4 && sim.greenAt !== null) this.world.setLights(0, true); else this.world.setLights(0, false);\n142\t    if (this.data.hourEnd !== undefined && this.data.hourEnd !== null) this.world.setHourIf(sim.hourNow);\n143\t    // Cars\n144\t    this.drawCars(ctx, dt);\n145\t    // Camera\n146\t    this.drawCamera(ctx, dt, focus);\n147\t    // World\n148\t    this.cheer = Math.max(0, this.cheer - dt);\n149\t    this.world.update(dt, ctx.time, this.cheer > 0, this.target, focus?.c.loc.s);\n150\t    this.crew?.update(dt, focus ? this.views[focus.i] : null);\n151\t    if (this.marshals) for (const m of this.marshals) m.update(dt);\n152\t    if (this.line) this.line.visible = !!(app.options.assists.line || this.lineOn);\n153\t    this.drawParticles(ctx, dt);\n154\t    if (main) this.drawAudio(ctx, dt, focus);\n155\t    // HUD\n156\t    ctx.hud.clear();\n157\t    if (!this.hudHidden) this.drawHud(ctx, dt, focus);\n158\t    if (main) { this.flow(ctx, dt, focus); app.ui.frame(ctx, dt); app.afterFrame(ctx, dt); }\n159\t    this.opts.onFrame?.(this, ctx, dt);\n160\t    a.send(ctx);\n161\t  }\n162\t  handleDriverButtons(ctx, focus, dt) {\n163\t    const app = this.app, a = app.actions, sim = this.sim;\n164\t    for (const e of sim.players) {\n165\t      const d = this.drv[e.player]; if (!d) continue;\n166\t      if (d.cam) { if (e.player === this.viewPlayer) { this.chase.cycle(); app.options.camMode = this.chase.mode; } else app.couchScene?.chase?.cycle(); app.mix.sfx('tick'); }\n167\t      // Recovery: hold for 1 s when off the road or stopped.\n168\t      const stoppedOrOff = (!e.c.onTrack || Math.abs(e.c.u) < 2) && !e.pit;\n169\t      if (d.recover && stoppedOrOff && !e.finished) { e.recT = (e.recT ?? 0) + dt; if (e.recT >= 1) { e.recT = 0; sim.recover(e.i); app.mix.sfx('whirr'); } } else e.recT = 0;\n170\t    }\n171\t    // Pause. Hub rounds open a settings menu that does not pause.\n172\t    if (focus?.pit?.phase === 'box' && focus.pit.tyres > 0 && !focus.pit.skipTyres && a.pressed('back') && !app.ui.top) { sim.skipTyres(focus.i); app.mix.sfx('tick'); }\n173\t    else if (a.pressed('pause') && !app.ui.top && !app.session) app.openPause(this);\n174\t  }\n175\t  handleEvents(ctx) {\n176\t    const app = this.app, mix = app.mix, sim = this.sim, focus = this.focusE, E = ctx.engine;\n177\t    for (const ev of sim.drainEvents()) {\n178\t      const e = ev.car >= 0 ? sim.cars[ev.car] : null, mine = e && e.player !== null, near = e === focus;\n179\t      switch (ev.type) {\n180\t        case 'shift': if (mine) { mix.sfx(ev.up ? 'gear' : 'gearDown'); app.actions.rumble(e.player, 0.1, 0.25, 50); if (e.p.sportExhaust) ctx.particles.burst('exhaustPop', this.tailPipe(e)); } break;\n181\t        case 'kerb': if (near) { mix.count('kerb'); E.shake.add(e.p.lowRide ? 0.16 : 0.07); app.actions.rumble(e.player ?? 0, 0.12, 0.3, 70); this.kerbT = 0.2; if (e.p.lowRide) this.views[e.i].heave = 0.05; } break;\n182\t        case 'wallHit': { const v = ev.v; if (near || mine) { mix.sfx(v > 12 ? 'thumpBig' : 'thump', { volume: Math.min(1, 0.4 + v / 20) }); E.shake.add(Math.min(0.75, v * 0.05)); if (e.player !== null) app.actions.rumble(e.player, Math.min(1, v / 14), 0.5, 180); if (v > 22) E.hitstop(0.05); } ctx.particles.burst('sparks', [e.c.x, e.c.y + 0.5, e.c.z]); break; }\n183\t        case 'carHit': if (near || mine) { mix.sfx('carHit', { volume: Math.min(1, 0.3 + ev.v / 12) }); E.shake.add(Math.min(0.4, ev.v * 0.04)); ctx.particles.burst('sparks', [e.c.x, e.c.y + 0.5, e.c.z], { count: 3 }); if (e.player !== null) app.actions.rumble(e.player, 0.5, 0.5, 120); } break;\n184\t        case 'lockup': if (near) { mix.sfx('lockChirp'); if (e.player !== null) app.actions.rumble(e.player, 0.25, 0.6, 140); } break;\n185\t        case 'land': if (near) { mix.sfx('landing', { volume: Math.min(1, 0.4 + ev.air) }); E.shake.add(Math.min(0.5, ev.air * 0.5)); ctx.particles.burst(sim.tr.surface === 'dirt' ? 'dirtDust' : 'tyreSmoke', [e.c.x, e.c.y + 0.3, e.c.z], { count: 10 }); this.views[e.i].heave = -0.09; } break;\n186\t        case 'lap': if (mine && ev.time !== null) { const best = e.bestLap === ev.time; mix.sfx(best ? 'bestLap' : 'lapChime'); this.hud.flash(`LAP ${app.fmt(ev.time)}`, 3); if (best) app.onBestLap?.(this, e, ev.time); } break;\n187\t        case 'flag':\n188\t          if (ev.kind === 'lights') { if (ev.n > 0) mix.sfx('beep'); }\n189\t          else if (ev.kind === 'green') { mix.sfx('beepGo'); E.screen.flash('white', { duration: 0.08 }); this.hud.flash('GREEN', 1.6, true); this.cheer = Math.max(this.cheer, 4); }\n190\t          else if (ev.kind === 'finalLap') { this.hud.flash('FINAL LAP', 3); mix.sfx('sting'); }\n191\t          else if (ev.kind === 'finish' && ev.own) { mix.sfx('flag'); this.hud.flash('FINISH', 3, true); this.cheer = 6; if (!this.tvMode && !this.data.test) this.startTv(); }\n192\t          break;\n193\t        case 'pitIn': if (near) { mix.sfx('whirr'); } break;\n194\t        case 'pitBox': if (near) { this.crew?.start(e); mix.sfx('wheelGun'); this.wheelGunT = 0.8; app.ui.say('benno', LINES.benno.pit[Math.floor(sim.time) % LINES.benno.pit.length], 3); } break;\n195\t        case 'pitGo': if (near) { this.crew?.go(); mix.sfx('beep'); this.hud.flash(`STOP ${ev.time.toFixed(1)} S`, 3); } break;\n196\t        case 'recover': if (near) { ctx.particles.burst('smoke', [e.c.x, e.c.y + 0.5, e.c.z], { count: 10 }); } break;\n197\t        case 'cone': mix.sfx('coneHit'); this.hud.flash(ev.hit ? 'CONE HIT: +1 S' : 'WRONG SIDE: +1 S', 1.6); break;\n198\t        case 'testPass': mix.sfx('flag'); break;\n199\t        case 'testFail': mix.sfx('denied'); this.hud.flash(ev.reason, 4); break;\n200\t        default: break;\n201\t      }\n202\t    }\n203\t    if (this.wheelGunT > 0) { this.wheelGunT -= ctx.engine.time ? 0.016 : 0; if (Math.floor(this.wheelGunT * 8) !== Math.floor((this.wheelGunT + 0.016) * 8)) mix.sfx('wheelGun', { volume: 0.5 }); }\n204\t  }\n205\t  tailPipe(e) { const c = e.c, sn = Math.sin(c.yaw), cs = Math.cos(c.yaw), back = e.p.b + 0.7; return [c.x - sn * back, c.y + 0.4, c.z - cs * back]; }\n206\t  drawCars(ctx, dt) {\n207\t    const sim = this.sim, alpha = this.paused ? 1 : (ctx.physics.alpha ?? 1), tr = sim.tr;\n208\t    for (const e of sim.cars) {\n209\t      const c = e.c, v = this.views[e.i]; if (e.hidden) { v.object.visible = false; continue; }\n210\t      const x = e.px === undefined ? c.x : e.px + (c.x - e.px) * alpha, y = e.py === undefined ? c.y : e.py + (c.y - e.py) * alpha, z = e.pz === undefined ? c.z : e.pz + (c.z - e.pz) * alpha; let dy = c.yaw - (e.pyaw ?? c.yaw); while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI; const yaw = c.yaw - dy * (1 - alpha);\n211\t      const i = c.loc.i, dir = Math.sin(yaw) * tr.tx[i] + Math.cos(yaw) * tr.tz[i] >= 0 ? 1 : -1, slope = tr.slope[i] * dir, bank = tr.bank[i] * dir;\n212\t      e.vPitch = (e.vPitch ?? 0) + (-Math.atan(slope) - (e.vPitch ?? 0)) * Math.min(1, dt * 10); e.vRoll = (e.vRoll ?? 0) + (bank - (e.vRoll ?? 0)) * Math.min(1, dt * 10);\n213\t      v.heave += (Math.max(-0.08, Math.min(0.08, -c.vy * 0.016)) - v.heave) * Math.min(1, dt * 9);\n214\t      v.update(dt, x, y, z, yaw, e.vPitch, e.vRoll, -c.ax * 0.004, -c.ay * 0.008, c.delta, c.u, c.airborne);\n215\t      v.setBrake((e.inp?.brake ?? 0) > 0.05 || e.pit?.phase === 'in');\n216\t      v.setHead(this.night > 0.2);\n217\t      if (e.dirt !== v.dirt && sim.tr.surface === 'dirt') v.setDirt(e.dirt);\n218\t      if (Math.abs(c.u) < 0.5 && !e.pit) v.shake = Math.max(0, Math.min(0.004, c.rpm / 300000)); else if (c.rpm > c.p.redline - 30) v.shake = 0.006; else v.shake = 0;\n219\t    }\n220\t    // Ghost car of the best lap.\n221\t    if (this.ghost && this.traceStart !== null && this.traceStart !== undefined) { const t = sim.time - this.traceStart, s = ghostSample(this.ghost.data, t, this.pose), g = this.ghost.view; g.object.visible = !s.done; if (!s.done) g.update(dt, s.x, s.y, s.z, s.yaw, 0, 0, 0, 0, 0, 30); }\n222\t    if (this.cones) for (const k of this.cones) { if (k.k.hit && k.a < 2) { if (k.a === 0) { const e = sim.cars[0].c; k.vx = e.vx * 0.5; k.vz = e.vz * 0.5; k.vy = 5; } k.a += dt; k.vy -= 14 * dt; k.m.position.x += k.vx * dt; k.m.position.z += k.vz * dt; k.m.position.y = Math.max(k.k.y, k.m.position.y + k.vy * dt); k.m.rotation.x += dt * 9; } }\n223\t    if (this.trails) { const t = ctx.time; sim.cars.forEach((e, k) => { const c = e.c, q = this.trails[k]; if (Math.hypot(c.vx, c.vz) > 6) { P.set(c.x - Math.sin(c.yaw) * (c.p.b + 0.7), c.y + 0.7, c.z - Math.cos(c.yaw) * (c.p.b + 0.7)); q.push(P, t); } q.update(t, this.cam); }); }\n224\t    // Light rig follows the player's car.\n225\t    const f = this.focusE;\n226\t    if (f && this.beam) { const c = f.c, sn = Math.sin(c.yaw), cs = Math.cos(c.yaw); this.beam.position.set(c.x + sn * 12, c.y + 1.6, c.z + cs * 12); this.tail.position.set(c.x - sn * 3, c.y + 0.8, c.z - cs * 3); }\n227\t  }\n228\t  startTv() { this.tvMode = true; this.tv.force(); }\n229\t  drawCamera(ctx, dt, focus) {\n230\t    if (!focus) return;\n231\t    const c = focus.c, app = this.app, d = this.drv[this.viewPlayer] ?? {}, cam = this.cam, tr = this.sim.tr, i = c.loc.i, dir = Math.sin(c.yaw) * tr.tx[i] + Math.cos(c.yaw) * tr.tz[i] >= 0 ? 1 : -1;\n232\t    const devCam = app.dev?.freeCam;\n233\t    if (devCam) { app.dev.driveFreeCam(ctx, dt, cam); this.target.copy(cam.position); return; }\n234\t    if (this.camOverride) { this.camOverride(cam, dt); this.target.set(c.x, c.y + 0.9, c.z); return; }\n235\t    if (this.tvMode) this.tv.update(dt, { x: c.x, y: c.y, z: c.z, s: c.loc.s }, cam, { busy: c.sliding });\n236\t    else this.chase.update(dt, { x: this.views[focus.i].object.position.x, y: this.views[focus.i].object.position.y, z: this.views[focus.i].object.position.z, yaw: this.views[focus.i].object.rotation.y, u: c.u }, { lookBack: !!d.lookBack, lookX: d.lookX2 ?? 0, lookY: d.lookY2 ?? 0, slope: tr.slope[i] * dir });\n237\t    this.target.set(c.x, c.y + 0.9, c.z);\n238\t    this.views[focus.i].object.visible = !(this.chase.mode === 2 && !this.tvMode && !d.lookBack);\n239\t  }\n240\t  drawParticles(ctx, dt) {\n241\t    const sim = this.sim, cam = this.cam, P = ctx.particles, tr = sim.tr, wet = !!this.data.rain;\n242\t    this.frameN = (this.frameN ?? 0) + 1; const every2 = this.frameN % 2 === 0;\n243\t    for (const e of sim.cars) {\n244\t      const c = e.c, u = Math.hypot(c.vx, c.vz); if (u < 3) continue;\n245\t      const dx = c.x - cam.position.x, dz = c.z - cam.position.z; if (dx * dx + dz * dz > 22000) continue;\n246\t      const sn = Math.sin(c.yaw), cs = Math.cos(c.yaw), bx = c.x - sn * c.p.b, bz = c.z - cs * c.p.b, ry = c.y + 0.15, rx = -cs * c.p.T / 2, rz = sn * c.p.T / 2;\n247\t      const dirt = c.surface === 'dirt' || c.surface === 'gravel', grass = c.surface === 'grass', hard = c.sliding || c.locked || c.spinning;\n248\t      if (hard && !dirt && !grass && every2) { P.burst(wet ? 'rainSpray' : 'tyreSmoke', [bx + rx, ry, bz + rz]); P.burst(wet ? 'rainSpray' : 'tyreSmoke', [bx - rx, ry, bz - rz]); }\n249\t      if (hard && !dirt && !grass) { this.world.skids.lay(`${e.i}L`, bx + rx, c.y, bz + rz); this.world.skids.lay(`${e.i}R`, bx - rx, c.y, bz - rz); } else { this.world.skids.lift(`${e.i}L`); this.world.skids.lift(`${e.i}R`); }\n250\t      if (dirt && u > 5 && every2) { P.burst('dirtDust', [bx + rx, ry, bz + rz], { count: 1 + (hard ? 1 : 0) }); P.burst('dirtDust', [bx - rx, ry, bz - rz], { count: 1 }); if (hard || c.surface === 'gravel') P.burst('gravel', [bx, ry, bz], { direction: [-c.vx * 0.2, 1, -c.vz * 0.2] }); }\n251\t      if (grass && every2) P.burst('gravel', [bx, ry, bz], { direction: [-c.vx * 0.2, 1, -c.vz * 0.2], colors: ['green', 'lime', 'teal'] });\n252\t      if (wet && u > 14 && !dirt && every2) { P.burst('rainSpray', [bx + rx, ry, bz + rz], { direction: [-c.vx * 0.05, 1, -c.vz * 0.05] }); P.burst('rainSpray', [bx - rx, ry, bz - rz], { direction: [-c.vx * 0.05, 1, -c.vz * 0.05] }); }\n253\t      if (tr.id === 'saltline' && (c.surface === 'apron') && every2) P.burst('saltDust', [bx, ry, bz]);\n254\t    }\n255\t    // Fireworks when the race is won at Harbour Lights.\n256\t    if (this.fireworksOn && tr.id === 'harbour') { this.fireworkT -= dt; if (this.fireworkT <= 0) { this.fireworkT = 0.5 + (Math.sin(ctx.time * 7) + 1) * 0.3; const f = this.target, k = Math.floor(ctx.time * 3) % 3, name = ['firework', 'firework2', 'firework3'][k]; P.burst(name, [f.x + Math.sin(ctx.time * 3.7) * 80, f.y + 42 + Math.sin(ctx.time) * 10, f.z + Math.cos(ctx.time * 2.1) * 80]); this.app.mix.sfx('firework', { volume: 0.4 }); } }\n257\t  }\n258\t  drawAudio(ctx, dt, focus) {\n259\t    const app = this.app, mix = app.mix, sim = this.sim, cam = this.cam, tr = sim.tr;\n260\t    if (this.paused || !focus) { mix.quiet(); return; }\n261\t    const list = [], c0 = focus.c, rightX = cam.matrixWorld.elements[0], rightZ = cam.matrixWorld.elements[2], listener = cam.position;\n262\t    const players = sim.players.filter((e) => e.player !== null), couch = this.data.kind === 'couch';\n263\t    const entry = (e, gain, pan) => ({ key: `${e.i}:${e.carId}`, carId: e.carId, p: e.p, rpm: e.c.rpm, throttle: e.inp?.throttle ?? 0.1, spool: e.c.spool, gain, pan });\n264\t    const camD = (e) => Math.hypot(e.c.x - listener.x, e.c.z - listener.z);\n265\t    if (couch) players.forEach((e, k) => list.push(entry(e, 0.75, k === 0 ? -0.6 : 0.6)));\n266\t    else list.push(entry(focus, this.tvMode ? Math.min(1, 40 / Math.max(10, camD(focus))) : 1, 0));\n267\t    mix.engines(list, dt);\n268\t    // The nearest three others: looping voices in the world, spatialized, pitched by rpm.\n269\t    const others = sim.cars.filter((e) => !list.some((l) => l.key === `${e.i}:${e.carId}`)).map((e) => [camD(e), e]).sort((a, b) => a[0] - b[0]).slice(0, 3);\n270\t    if (!this.ears) this.ears = { position: new Vector3(), right: new Vector3() };\n271\t    this.ears.position.copy(listener); this.ears.right.set(rightX, cam.matrixWorld.elements[1], rightZ);\n272\t    mix.others(others.map(([, e]) => ({ x: e.c.x, y: e.c.y, z: e.c.z, rpm: e.c.rpm })), this.ears);\n273\t    const u = Math.abs(c0.u), dirt = c0.surface === 'dirt' || c0.surface === 'gravel' || c0.surface === 'grass';\n274\t    const useMax = Math.max(c0.use[0], c0.use[1], c0.use[2], c0.use[3]);\n275\t    const tyre = !dirt && u > 4 ? Math.max(0, Math.min(1, (useMax - 0.85) * 1.5)) * (c0.sliding || c0.locked ? 1 : 0.5) : 0;\n276\t    if (tyre > 0.3 && !this.tyreCounted) { mix.count('tyre'); this.tyreCounted = true; } else if (tyre < 0.1) this.tyreCounted = false;\n277\t    this.kerbT = Math.max(0, (this.kerbT ?? 0) - dt);\n278\t    const onKerb = c0.surface === 'kerb' && u > 8;\n279\t    const stand = this.world.dress.tunnel ? 0 : Math.max(0, 1 - Math.abs(((c0.loc.s + tr.length / 2) % tr.length) - tr.length / 2) / 340);\n280\t    mix.world({ tyre, tyrePitch: Math.min(1, u / 60), wind: Math.min(1, (u * u) / 6000) * (focus.slip ? 1.35 : 1), gravel: dirt ? Math.min(1, u / 30) : 0, rain: this.data.rain ? 1 : 0, kerb: onKerb ? 1 : 0, kerbRate: u, crowd: stand * (0.5 + (this.cheer > 0 ? 0.5 : 0)) });\n281\t    if (focus.inp?.handbrake && !this.hbDown) { mix.sfx('ratchet'); this.hbDown = true; } else if (!focus.inp?.handbrake) this.hbDown = false;\n282\t  }\n283\t  drawHud(ctx, dt, focus) {\n284\t    const app = this.app, ui = app.ui; if (!focus) return;\n285\t    if (this.role !== 'main') { ui.hud = ctx.hud; ui.w = ctx.hud.width; ui.h = ctx.hud.height; ui.cx = ui.w / 2; }\n286\t    else { ui.hud = ctx.hud; ui.w = ctx.hud.width; ui.h = ctx.hud.height; ui.cx = ui.w / 2; }\n287\t    if (this.opts.hideHud) return;\n288\t    const sim = this.sim, rival = this.data.kind === 'rally' ? sim.cars.find((e) => e !== focus) : null, d = this.drv[focus.player ?? 0];\n289\t    const hudOpts = { units: app.options.units === 'mph' ? 'mph' : 'kmh', fuel: sim.laps > 3 || this.data.kind === 'hub', dev: app.devActive(), test: this.judge, rival, recover: (focus.recT ?? 0), legText: this.test?.legs ? `CAR ${this.leg + 1}/${this.test.legs.length}` : null };\n290\t    void d;\n291\t    this.hud.draw(ui, focus, dt, hudOpts);\n292\t    this.opts.drawExtra?.(this, ui, dt);\n293\t    // The controls, for the device in use, for the first seconds of a drive. They swap the moment the player switches.\n294\t    if (this.role === 'main' && !this.opts.attract && !this.opts.demo && !ui.top) {\n295\t      const dev = app.actions.lastDevice, xbox = app.options.glyphs === 'xbox', row = (list, y) => { const w = list.reduce((v, x) => v + (typeof x === 'string' ? ctx.hud.measure(x).width : glyphWidth(ctx.hud, specFor(x.a, dev), xbox)) + 4, -4); let px = Math.round(ui.cx - w / 2); ui.rect(px - 4, y - 2, w + 8, 15, 'ink'); for (const x of list) { if (typeof x === 'string') { ui.text(px, y + 2, x, { color: 'white' }); px += ctx.hud.measure(x).width + 4; } else px += drawGlyph(ctx.hud, px, y, specFor(x.a, dev), xbox) + 4; } };\n296\t      if (this.t < 8 && ui.w >= 300) row([{ a: 'steer' }, 'STEER', { a: 'throttle' }, 'GO', { a: 'brake' }, 'BRAKE', { a: 'pause' }, 'PAUSE'], ui.h - 62);\n297\t      if (!focus.pit && !focus.finished && !focus.c.onTrack && Math.abs(focus.c.u) < 8) row(['HOLD', { a: 'recover' }, 'TO RECOVER'], ui.h - 76);\n298\t      if (focus.pit?.phase === 'box' && focus.pit.tyres > 0 && !focus.pit.skipTyres) row([{ a: 'back' }, 'SKIP THE TYRES'], 68);\n299\t    }\n300\t    if (this.app.dev) this.app.drawOverlays?.(ui, this);\n301\t    if (sim.phase === 'grid') { const n = sim.lights; for (let k = 0; k < 5; k++) { const x = ui.cx - 40 + k * 17; ui.rect(x, 20, 13, 13, 'ink'); ui.rect(x + 2, 22, 9, 9, k < n ? 'red' : 'night'); } }\n302\t    if (sim.phase === 'rolling') ui.text(ui.cx, 22, 'ROLLING START: HOLD FORMATION', { align: 'center', color: 'sand' });\n303\t    if (focus.startDelay > 0 && focus.ownStart === null && sim.phase === 'green') { const left = Math.max(0, focus.startDelay - (sim.time - sim.greenAt)); ui.text(ui.cx, 40, `${Math.ceil(left)}`, { align: 'center', scale: 3, color: 'sand' }); ui.text(ui.cx, 22, 'YOUR RIVAL HAS STARTED', { align: 'center', color: 'mist' }); }\n304\t    if (this.ghost?.view.object.visible) { P.copy(this.ghost.view.object.position); P.y += 1.9; P.project(this.cam); if (P.z < 1 && Math.abs(P.x) < 1 && Math.abs(P.y) < 1) ui.text((P.x + 1) * 0.5 * ui.w, (1 - P.y) * 0.5 * ui.h, 'GHOST', { align: 'center', color: 'sky' }); }\n305\t    if (this.data.kind === 'timetrial') ui.text(ui.cx, 22, this.ghost ? 'PASS THE PAD: BEAT THE GHOST. THE BEST TIME STANDS.' : 'SET A LAP. IT BECOMES THE GHOST.', { align: 'center', color: 'sand' });\n306\t    // A word from the crew when a stop is needed.\n307\t    if (sim.laps >= 10 && sim.tr.pit && !focus.finished && !focus.pit) { const wear = (focus.c.wear[0] + focus.c.wear[1] + focus.c.wear[2] + focus.c.wear[3]) / 4; if (wear < 0.4 || focus.c.fuel < 0.25) { ui.text(ui.cx, 22, 'BOX THIS LAP: KEEP RIGHT AT THE PIT ENTRY', { align: 'center', color: Math.floor(ui.time * 2) % 2 ? 'sand' : 'white' }); } }\n308\t  }\n309\t  // The end of a drive.\n310\t  flow(ctx, dt, focus) {\n311\t    const app = this.app, sim = this.sim;\n312\t    if (this.ended || this.opts.attract) return;\n313\t    if (this.judge) { if (this.judge.status !== 'running') { this.afterT ??= 1.6; this.afterT -= dt; if (this.afterT <= 0) { this.ended = true; app.onTestFinished(this); } } return; }\n314\t    if (sim.done) { this.afterT ??= this.data.kind === 'testdrive' ? 0.8 : 3; this.afterT -= dt; if (this.afterT <= 0) { this.ended = true; app.onRaceFinished(this); } }\n315\t    void focus;\n316\t  }\n317\t  cameraTarget() { return this.target; }\n318\t  status() {\n319\t    const s = this.sim; if (!s) return 'race loading';\n320\t    const e = this.focusE ?? s.cars[0];\n321\t    if (this.judge) return `licence ${this.test.id} ${this.judge.status} ${this.judge.total.toFixed(2)}`;\n322\t    return `race ${this.data.track} lap ${Math.max(0, e.lap)}/${s.laps} p${e.pos ?? 1}/${s.cars.length} ${s.time.toFixed(1)} ${s.phase}`;\n323\t  }\n324\t  fingerprint() { return this.sim?.fingerprint() ?? ''; }\n325\t  dispose() { this.app.mix.clearCars(); if (this.app.scene === this) this.app.scene = null; }\n326\t}\n327\tvoid F_BRAKE; void wrapS; void Group; void testSetup;\n328\t"}]},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"429ee742-f353-4bb5-be6f-6e31815b34db","timestamp":"2026-11-06T04:15:20.983Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-171904__x89353d/work/GranTumbleweed-GranTurismo3ASpec-claude-opus-5-5-xhigh-20261105-171904/src/game/scenes/race.js","content":"// RaceScene: everything driven. A race, a licence test, a test drive, a time trial, an attract clip, a couch duel, a hub round.\nimport { buildModel, setLookLayer, THREE, Trail } from '../../pixel-engine.js';\nimport { coneDef } from '../models/props.js';\nimport { RaceSim, trackPoint, wrapS } from '../sim/race.js';\nimport { DemoBrain, Judge, legCount, placeS, testSetup } from '../sim/licence.js';\nimport { F_BRAKE } from '../sim/replaydata.js';\nimport { GhostTrace, ghostSample } from '../sim/replaydata.js';\nimport { buildWorld } from '../render/world.js';\nimport { CarView } from '../render/carview.js';\nimport { ChaseCam } from '../render/camera.js';\nimport { TvDirector } from '../render/director.js';\nimport { PitCrew } from '../render/pitcrew.js';\nimport { flagProp, makePerson } from '../render/people.js';\nimport { buildDrivingLine } from '../render/trackmesh.js';\nimport { GeoBatch } from '../render/geo.js';\nimport { RaceHud } from '../ui/racehud.js';\nimport { LINES } from '../data/text.js';\nimport { drawGlyph, glyphWidth, specFor } from '../ui/glyphs.js';\nconst { Group, Vector3 } = THREE;\nconst P = new Vector3();\nexport class RaceScene {\n  constructor(app, setup, opts = {}) {\n    this.name = 'race'; this.app = app; this.data = setup; this.role = opts.role ?? 'main'; this.sim = opts.sim ?? null; this.viewPlayer = opts.viewPlayer ?? 0; this.run = opts.run ?? null; this.opts = opts; this.compact = !!opts.compact;\n    this.target = new Vector3(); this.paused = false; this.views = []; this.t = 0; this.tvMode = false; this.ended = false; this.afterT = null; this.recoverT = 0; this.cheer = 0; this.hudHidden = false; this.upL = [false, false]; this.downL = [false, false]; this.drv = [null, null]; this.frozen = false; this.fireworkT = 0; this.stepFrames = 0; this.legTimes = []; this.leg = setup.leg ?? 0; this.ghost = null; this.trace = null; this.pose = {}; this.camTarget = null;\n  }\n  ready() { if (this.role === 'main' && typeof window !== 'undefined') window.__GAME__ = this.app.handle(); }\n  async setup(ctx) {\n    const app = this.app; if (this.role === 'main') { app.enterScene(ctx, this); app.ui.clear(); app.ui.subtitle = null; app.actions.resetDriver(); }\n    const cam = ctx.camera.camera; cam.near = 0.5; cam.far = 6000; cam.updateProjectionMatrix();\n    this.cam = cam;\n    if (!this.sim) this.sim = new RaceSim({ ...this.data, env: app.env });\n    const sim = this.sim, tr = sim.tr, hour = this.data.hour ?? 12, focusE = this.focusEntry();\n    this.world = buildWorld(ctx, tr, sim.line, { hour, hourEnd: this.data.hourEnd ?? null, rain: !!this.data.rain, speeds: focusE?.speeds });\n    this.buildCars(ctx);\n    this.chase = new ChaseCam(cam);\n    this.chase.mode = app.options.camMode ?? 0;\n    if (app.devSliders) { this.chase.distance = app.devSliders.chase; this.chase.fovBase = app.devSliders.fov; }\n    this.tv = new TvDirector(tr, this.world.field, (this.data.seed ?? 1) + 11);\n    this.hud = new RaceHud(sim, this.compact);\n    if (sim.tr.pit && this.role === 'main' && (this.data.laps > 3 || this.data.kind === 'attract')) { this.crew = new PitCrew(ctx, tr); await this.crew.build(); }\n    this.line = focusE ? buildDrivingLine(tr, sim.line, focusE.speeds) : null;\n    if (this.line) { this.line.visible = false; ctx.scene.add(this.line); }\n    // Licence test: the judge, the box, the cones.\n    if (this.data.test) { this.setupTest(ctx); }\n    // Lights at dusk and night.\n    this.night = this.world.night;\n    if (this.night > 0.15) {\n      this.beam = new THREE.Object3D(); ctx.scene.add(this.beam);\n      this.beamL = ctx.lights.request({ follow: this.beam, color: 0xfff0c0, intensity: 16, radius: 34, priority: 8, decay: 1 });\n      this.tail = new THREE.Object3D(); ctx.scene.add(this.tail);\n      ctx.lights.request({ follow: this.tail, color: 0xff3020, intensity: 4, radius: 8, priority: 3 });\n    }\n    // Marshals at the line. Not in a hub round: its build has to be quick.\n    if (this.role === 'main' && this.data.kind !== 'hub' && this.data.kind !== 'licence') {\n      this.marshals = [];\n      for (const [s0, colour] of [[26, 'red'], [-40, 'sand']]) { const m = await makePerson(ctx, 'marshal'), pt = trackPoint(tr, s0, -(tr.width[0] / 2 + Math.min(tr.wallL[0], 2.5))); m.object.position.set(pt.x, pt.y, pt.z); m.object.rotation.y = pt.yaw + Math.PI / 2; m.play('MarshalFlag', { fade: 0 }); m.attachProp('HandR', flagProp(colour)); ctx.scene.add(m.object); this.marshals.push(m); }\n    }\n    // Taillight trails at night.\n    if (this.night > 0.4) { this.trails = sim.cars.map(() => { const q = new Trail({ width: 0.2, life: 0.4, color: 0xff3020, tail: 0x5d275d, points: 18, minStep: 0.6 }); ctx.scene.add(q); return q; }); }\n    // Ghosts in time trial.\n    if (this.data.kind === 'timetrial') { this.trace = new GhostTrace(); this.traceStart = null; }\n    if (this.opts.ghostData) this.setGhost(ctx, this.opts.ghostData);\n    this.world.setLights(0, false);\n    app.mix.clearCars();\n    const song = this.songFor();\n    if (this.role === 'main') { if (app.options.raceMusic !== false && song) app.mix.music(song); else app.mix.music(null); }\n    this.opts.onReady?.(this, ctx);\n  }\n  songFor() { const d = this.data, t = d.track; if (d.kind === 'licence') return 'exam'; if (t === 'redclay') return 'clay'; if ((d.hour ?? 12) >= 18 || (d.hour ?? 12) < 6) return 'city'; return 'apex'; }\n  focusEntry() { const s = this.sim; return s.cars.find((e) => e.player === this.viewPlayer) ?? s.cars[s.cars.length - 1] ?? null; }\n  buildCars(ctx) {\n    for (const v of this.views) v.dispose();\n    this.views = this.sim.cars.map((e) => { const v = new CarView(e.carId, { install: e.install, paint: e.paint ?? undefined }); v.setDirt(e.dirt); ctx.scene.add(v.object); return v; });\n  }\n  setGhost(ctx, data) {\n    if (this.ghost) this.ghost.view.dispose();\n    const view = new CarView(data.carId, { ghost: 'sky' }); ctx.scene.add(view.object); this.ghost = { view, data };\n  }\n  setupTest(ctx) {\n    const app = this.app, sim = this.sim, tr = sim.tr, test = this.opts.test;\n    this.test = test; this.judge = new Judge(test, sim);\n    this.judge.step(0); this.judge.base = this.opts.legBase ?? 0;\n    if (test.box) { // The white box, painted on the road.\n      const b = new GeoBatch(), s0 = test.box.s - test.box.len / 2, s1 = test.box.s + test.box.len / 2, w = 5, Q = (s, t) => { const p = trackPoint(tr, s, t); return [p.x, p.y + 0.07, p.z]; };\n      const edge = (s, t0, t1) => b.quad(Q(s, t0), Q(s, t1), Q(s + 0.8, t1), Q(s + 0.8, t0), 'white'); edge(s0, -w, w); edge(s1 - 0.8, -w, w); for (let s = s0; s < s1 - 2; s += 2) { const n = s + 2; b.quad(Q(s, -w), Q(s, -w + 0.5), Q(n, -w + 0.5), Q(n, -w), 'white'); b.quad(Q(s, w - 0.5), Q(s, w), Q(n, w), Q(n, w - 0.5), 'white'); }\n      for (let s = s0 - 60; s < s0; s += 8) { b.quad(Q(s, -w), Q(s, -w + 0.3), Q(s + 4, -w + 0.3), Q(s + 4, -w), 'sand'); b.quad(Q(s, w - 0.3), Q(s, w), Q(s + 4, w), Q(s + 4, w - 0.3), 'sand'); }\n      ctx.scene.add(b.mesh({ glow: true }));\n    }\n    if (this.judge.cones) {\n      this.cones = this.judge.cones.map((k) => { const m = buildModel(coneDef, {}).object; m.position.set(k.x, k.y, k.z); setLookLayer(m, 'actors'); for (const q of m.children) if (q.isMesh) q.castShadow = true; ctx.scene.add(m); return { m, k, vy: 0, vx: 0, vz: 0, a: 0 }; });\n    }\n    // The end of the section: a banner across the road.\n    if (test.end) { const s = placeS(tr, test.end), l = trackPoint(tr, s, -tr.width[0] / 2 - 2), r = trackPoint(tr, s, tr.width[0] / 2 + 2), b = new GeoBatch(); b.box(l.x, l.y, l.z, 0.4, 5, 0.4, 'white'); b.box(r.x, r.y, r.z, 0.4, 5, 0.4, 'white'); b.beam([l.x, l.y + 4.6, l.z], [r.x, r.y + 4.6, r.z], 0.3, 0.8, 'red'); ctx.scene.add(b.mesh({ cast: true, receive: false })); }\n    if (this.opts.demo) {\n      const e = sim.cars[0]; e.autoDrive = true; const brain = new DemoBrain(test, sim, this.judge, { skill: 0.97 });\n      sim.aiInput = () => brain.input();\n      this.hud.flash('DEMONSTRATION', 99, false);\n      app.ui.say('arai', LINES.arai.demo);\n    }\n    if (app.options.assists.line || this.opts.showLine) this.lineOn = true;\n    void legCount;\n  }\n  // ---- fixed step ----\n  fixedUpdate(ctx, dt) {\n    const app = this.app; app.actions.latch(ctx);\n    if (this.role !== 'main') return;\n    this.world?.fixedUpdate(dt);\n    if (!this.sim || !this.world) return;\n    if (this.paused && this.stepFrames <= 0) return;\n    if (this.stepFrames > 0) this.stepFrames--;\n    const sim = this.sim;\n    for (const e of sim.cars) { const c = e.c; e.px = c.x; e.py = c.y; e.pz = c.z; e.pyaw = c.yaw; }\n    const inputs = [];\n    for (const e of sim.players) {\n      const d = app.driverOverride?.(e, this.drv[e.player], sim) ?? this.drv[e.player]; if (!d) { inputs[e.player] = {}; continue; }\n      inputs[e.player] = { steer: d.steer, throttle: d.throttle, brake: d.brake, handbrake: d.handbrake, up: this.upL[e.player], down: this.downL[e.player] };\n      this.upL[e.player] = false; this.downL[e.player] = false;\n    }\n    this.opts.beforeStep?.(sim, inputs, dt);\n    sim.step(inputs);\n    if (this.judge) this.judge.step(1 / 60);\n    if (this.trace) this.stepTrace(sim);\n    if (this.opts.afterStep) this.opts.afterStep(sim, dt, this);\n  }\n  stepTrace(sim) { // Time trial: a ghost of this lap at 10 Hz.\n    const e = sim.cars[0], c = e.c;\n    if (e.lap === this.traceLap) { if (sim.frame % 6 === 0) this.trace.add(c.x, c.y, c.z, c.yaw); }\n    else { const done = this.trace, doneLap = this.traceLap; this.trace = new GhostTrace(); this.traceLap = e.lap; this.traceStart = sim.time; if (doneLap && e.lastLap) this.app.lapDone?.(this, done, e.lastLap); }\n  }\n  // ---- per frame ----\n  update(ctx, dt) {\n    const app = this.app, a = app.actions; a.setDt(dt); a.latch(ctx);\n    if (!this.sim || !this.world || !this.chase) { a.send(ctx); return; }\n    this.t += dt;\n    const sim = this.sim, main = this.role === 'main', focus = this.focusE ?? this.focusEntry();\n    this.focusE = focus;\n    // Inputs\n    if (main) for (const e of sim.players) { const d = a.drive(ctx, e.player, dt); this.drv[e.player] = d; if (d.up) this.upL[e.player] = true; if (d.down) this.downL[e.player] = true; }\n    if (main && !this.paused) { this.handleDriverButtons(ctx, focus, dt); this.handleEvents(ctx); }\n    // Lights on the gantry\n    if (sim.phase === 'grid') this.world.setLights(sim.lights, false); else if (sim.time - (sim.greenAt ?? 0) < 4 && sim.greenAt !== null) this.world.setLights(0, true); else this.world.setLights(0, false);\n    if (this.data.hourEnd !== undefined && this.data.hourEnd !== null) this.world.setHourIf(sim.hourNow);\n    // Cars\n    this.drawCars(ctx, dt);\n    // Camera\n    this.drawCamera(ctx, dt, focus);\n    // World\n    this.cheer = Math.max(0, this.cheer - dt);\n    this.world.update(dt, ctx.time, this.cheer > 0, this.target, focus?.c.loc.s);\n    this.crew?.update(dt, focus ? this.views[focus.i] : null);\n    if (this.marshals) for (const m of this.marshals) m.update(dt);\n    if (this.line) this.line.visible = !!(app.options.assists.line || this.lineOn);\n    this.drawParticles(ctx, dt);\n    if (main) this.drawAudio(ctx, dt, focus);\n    // HUD\n    ctx.hud.clear();\n    if (!this.hudHidden) this.drawHud(ctx, dt, focus);\n    if (main) { this.flow(ctx, dt, focus); app.ui.frame(ctx, dt); app.afterFrame(ctx, dt); }\n    this.opts.onFrame?.(this, ctx, dt);\n    a.send(ctx);\n  }\n  handleDriverButtons(ctx, focus, dt) {\n    const app = this.app, a = app.actions, sim = this.sim;\n    for (const e of sim.players) {\n      const d = this.drv[e.player]; if (!d) continue;\n      if (d.cam) { if (e.player === this.viewPlayer) { this.chase.cycle(); app.options.camMode = this.chase.mode; } else app.couchScene?.chase?.cycle(); app.mix.sfx('tick'); }\n      // Recovery: hold for 1 s when off the road or stopped.\n      const stoppedOrOff = (!e.c.onTrack || Math.abs(e.c.u) < 2) && !e.pit;\n      if (d.recover && stoppedOrOff && !e.finished) { e.recT = (e.recT ?? 0) + dt; if (e.recT >= 1) { e.recT = 0; sim.recover(e.i); app.mix.sfx('whirr'); } } else e.recT = 0;\n    }\n    // Pause. Hub rounds open a settings menu that does not pause.\n    if (focus?.pit?.phase === 'box' && focus.pit.tyres > 0 && !focus.pit.skipTyres && a.pressed('back') && !app.ui.top) { sim.skipTyres(focus.i); app.mix.sfx('tick'); }\n    else if (a.pressed('pause') && !app.ui.top && !app.session) app.openPause(this);\n  }\n  handleEvents(ctx) {\n    const app = this.app, mix = app.mix, sim = this.sim, focus = this.focusE, E = ctx.engine;\n    for (const ev of sim.drainEvents()) {\n      const e = ev.car >= 0 ? sim.cars[ev.car] : null, mine = e && e.player !== null, near = e === focus;\n      switch (ev.type) {\n        case 'shift': if (mine) { mix.sfx(ev.up ? 'gear' : 'gearDown'); app.actions.rumble(e.player, 0.1, 0.25, 50); if (e.p.sportExhaust) ctx.particles.burst('exhaustPop', this.tailPipe(e)); } break;\n        case 'kerb': if (near) { mix.count('kerb'); E.shake.add(e.p.lowRide ? 0.16 : 0.07); app.actions.rumble(e.player ?? 0, 0.12, 0.3, 70); this.kerbT = 0.2; if (e.p.lowRide) this.views[e.i].heave = 0.05; } break;\n        case 'wallHit': { const v = ev.v; if (near || mine) { mix.sfx(v > 12 ? 'thumpBig' : 'thump', { volume: Math.min(1, 0.4 + v / 20) }); E.shake.add(Math.min(0.75, v * 0.05)); if (e.player !== null) app.actions.rumble(e.player, Math.min(1, v / 14), 0.5, 180); if (v > 22) E.hitstop(0.05); } ctx.particles.burst('sparks', [e.c.x, e.c.y + 0.5, e.c.z]); break; }\n        case 'carHit': if (near || mine) { mix.sfx('carHit', { volume: Math.min(1, 0.3 + ev.v / 12) }); E.shake.add(Math.min(0.4, ev.v * 0.04)); ctx.particles.burst('sparks', [e.c.x, e.c.y + 0.5, e.c.z], { count: 3 }); if (e.player !== null) app.actions.rumble(e.player, 0.5, 0.5, 120); } break;\n        case 'lockup': if (near) { mix.sfx('lockChirp'); if (e.player !== null) app.actions.rumble(e.player, 0.25, 0.6, 140); } break;\n        case 'land': if (near) { mix.sfx('landing', { volume: Math.min(1, 0.4 + ev.air) }); E.shake.add(Math.min(0.5, ev.air * 0.5)); ctx.particles.burst(sim.tr.surface === 'dirt' ? 'dirtDust' : 'tyreSmoke', [e.c.x, e.c.y + 0.3, e.c.z], { count: 10 }); this.views[e.i].heave = -0.09; } break;\n        case 'lap': if (mine && ev.time !== null) { const best = e.bestLap === ev.time; mix.sfx(best ? 'bestLap' : 'lapChime'); this.hud.flash(`LAP ${app.fmt(ev.time)}`, 3); if (best) app.onBestLap?.(this, e, ev.time); } break;\n        case 'flag':\n          if (ev.kind === 'lights') { if (ev.n > 0) mix.sfx('beep'); }\n          else if (ev.kind === 'green') { mix.sfx('beepGo'); E.screen.flash('white', { duration: 0.08 }); this.hud.flash('GREEN', 1.6, true); this.cheer = Math.max(this.cheer, 4); }\n          else if (ev.kind === 'finalLap') { this.hud.flash('FINAL LAP', 3); mix.sfx('sting'); }\n          else if (ev.kind === 'finish' && ev.own) { mix.sfx('flag'); this.hud.flash('FINISH', 3, true); this.cheer = 6; if (!this.tvMode && !this.data.test) this.startTv(); }\n          break;\n        case 'pitIn': if (near) { mix.sfx('whirr'); } break;\n        case 'pitBox': if (near) { this.crew?.start(e); mix.sfx('wheelGun'); this.wheelGunT = 0.8; app.ui.say('benno', LINES.benno.pit[Math.floor(sim.time) % LINES.benno.pit.length], 3); } break;\n        case 'pitGo': if (near) { this.crew?.go(); mix.sfx('beep'); this.hud.flash(`STOP ${ev.time.toFixed(1)} S`, 3); } break;\n        case 'recover': if (near) { ctx.particles.burst('smoke', [e.c.x, e.c.y + 0.5, e.c.z], { count: 10 }); } break;\n        case 'cone': mix.sfx('coneHit'); this.hud.flash(ev.hit ? 'CONE HIT: +1 S' : 'WRONG SIDE: +1 S', 1.6); break;\n        case 'testPass': mix.sfx('flag'); break;\n        case 'testFail': mix.sfx('denied'); this.hud.flash(ev.reason, 4); break;\n        default: break;\n      }\n    }\n    if (this.wheelGunT > 0) { this.wheelGunT -= ctx.engine.time ? 0.016 : 0; if (Math.floor(this.wheelGunT * 8) !== Math.floor((this.wheelGunT + 0.016) * 8)) mix.sfx('wheelGun', { volume: 0.5 }); }\n  }\n  tailPipe(e) { const c = e.c, sn = Math.sin(c.yaw), cs = Math.cos(c.yaw), back = e.p.b + 0.7; return [c.x - sn * back, c.y + 0.4, c.z - cs * back]; }\n  drawCars(ctx, dt) {\n    const sim = this.sim, alpha = this.paused ? 1 : (ctx.physics.alpha ?? 1), tr = sim.tr;\n    for (const e of sim.cars) {\n      const c = e.c, v = this.views[e.i]; if (e.hidden) { v.object.visible = false; continue; }\n      const x = e.px === undefined ? c.x : e.px + (c.x - e.px) * alpha, y = e.py === undefined ? c.y : e.py + (c.y - e.py) * alpha, z = e.pz === undefined ? c.z : e.pz + (c.z - e.pz) * alpha; let dy = c.yaw - (e.pyaw ?? c.yaw); while (dy > Math.PI) dy -= 2 * Math.PI; while (dy < -Math.PI) dy += 2 * Math.PI; const yaw = c.yaw - dy * (1 - alpha);\n      const i = c.loc.i, dir = Math.sin(yaw) * tr.tx[i] + Math.cos(yaw) * tr.tz[i] >= 0 ? 1 : -1, slope = tr.slope[i] * dir, bank = tr.bank[i] * dir;\n      e.vPitch = (e.vPitch ?? 0) + (-Math.atan(slope) - (e.vPitch ?? 0)) * Math.min(1, dt * 10); e.vRoll = (e.vRoll ?? 0) + (bank - (e.vRoll ?? 0)) * Math.min(1, dt * 10);\n      v.heave += (Math.max(-0.08, Math.min(0.08, -c.vy * 0.016)) - v.heave) * Math.min(1, dt * 9);\n      v.update(dt, x, y, z, yaw, e.vPitch, e.vRoll, -c.ax * 0.004, -c.ay * 0.008, c.delta, c.u, c.airborne);\n      v.setBrake((e.inp?.brake ?? 0) > 0.05 || e.pit?.phase === 'in');\n      v.setHead(this.night > 0.2);\n      if (e.dirt !== v.dirt && sim.tr.surface === 'dirt') v.setDirt(e.dirt);\n      if (Math.abs(c.u) < 0.5 && !e.pit) v.shake = Math.max(0, Math.min(0.004, c.rpm / 300000)); else if (c.rpm > c.p.redline - 30) v.shake = 0.006; else v.shake = 0;\n    }\n    // Ghost car of the best lap.\n    if (this.ghost && this.traceStart !== null && this.traceStart !== undefined) { const t = sim.time - this.traceStart, s = ghostSample(this.ghost.data, t, this.pose), g = this.ghost.view; g.object.visible = !s.done; if (!s.done) g.update(dt, s.x, s.y, s.z, s.yaw, 0, 0, 0, 0, 0, 30); }\n    if (this.cones) for (const k of this.cones) { if (k.k.hit && k.a < 2) { if (k.a === 0) { const e = sim.cars[0].c; k.vx = e.vx * 0.5; k.vz = e.vz * 0.5; k.vy = 5; } k.a += dt; k.vy -= 14 * dt; k.m.position.x += k.vx * dt; k.m.position.z += k.vz * dt; k.m.position.y = Math.max(k.k.y, k.m.position.y + k.vy * dt); k.m.rotation.x += dt * 9; } }\n    if (this.trails) { const t = ctx.time; sim.cars.forEach((e, k) => { const c = e.c, q = this.trails[k]; if (Math.hypot(c.vx, c.vz) > 6) { P.set(c.x - Math.sin(c.yaw) * (c.p.b + 0.7), c.y + 0.7, c.z - Math.cos(c.yaw) * (c.p.b + 0.7)); q.push(P, t); } q.update(t, this.cam); }); }\n    // Light rig follows the player's car.\n    const f = this.focusE;\n    if (f && this.beam) { const c = f.c, sn = Math.sin(c.yaw), cs = Math.cos(c.yaw); this.beam.position.set(c.x + sn * 12, c.y + 1.6, c.z + cs * 12); this.tail.position.set(c.x - sn * 3, c.y + 0.8, c.z - cs * 3); }\n  }\n  startTv() { this.tvMode = true; this.tv.force(); }\n  drawCamera(ctx, dt, focus) {\n    if (!focus) return;\n    const c = focus.c, app = this.app, d = this.drv[this.viewPlayer] ?? {}, cam = this.cam, tr = this.sim.tr, i = c.loc.i, dir = Math.sin(c.yaw) * tr.tx[i] + Math.cos(c.yaw) * tr.tz[i] >= 0 ? 1 : -1;\n    const devCam = app.dev?.freeCam;\n    if (devCam) { app.dev.driveFreeCam(ctx, dt, cam); this.target.copy(cam.position); return; }\n    if (this.camOverride) { this.camOverride(cam, dt); this.target.set(c.x, c.y + 0.9, c.z); return; }\n    if (this.tvMode) this.tv.update(dt, { x: c.x, y: c.y, z: c.z, s: c.loc.s }, cam, { busy: c.sliding });\n    else this.chase.update(dt, { x: this.views[focus.i].object.position.x, y: this.views[focus.i].object.position.y, z: this.views[focus.i].object.position.z, yaw: this.views[focus.i].object.rotation.y, u: c.u }, { lookBack: !!d.lookBack, lookX: d.lookX2 ?? 0, lookY: d.lookY2 ?? 0, slope: tr.slope[i] * dir });\n    this.target.set(c.x, c.y + 0.9, c.z);\n    this.views[focus.i].object.visible = !(this.chase.mode === 2 && !this.tvMode && !d.lookBack);\n  }\n  drawParticles(ctx, dt) {\n    const sim = this.sim, cam = this.cam, P = ctx.particles, tr = sim.tr, wet = !!this.data.rain;\n    this.frameN = (this.frameN ?? 0) + 1; const every2 = this.frameN % 2 === 0;\n    for (const e of sim.cars) {\n      const c = e.c, u = Math.hypot(c.vx, c.vz); if (u < 3) continue;\n      const dx = c.x - cam.position.x, dz = c.z - cam.position.z; if (dx * dx + dz * dz > 22000) continue;\n      const sn = Math.sin(c.yaw), cs = Math.cos(c.yaw), bx = c.x - sn * c.p.b, bz = c.z - cs * c.p.b, ry = c.y + 0.15, rx = -cs * c.p.T / 2, rz = sn * c.p.T / 2;\n      const dirt = c.surface === 'dirt' || c.surface === 'gravel', grass = c.surface === 'grass', hard = c.sliding || c.locked || c.spinning;\n      if (hard && !dirt && !grass && every2) { P.burst(wet ? 'rainSpray' : 'tyreSmoke', [bx + rx, ry, bz + rz]); P.burst(wet ? 'rainSpray' : 'tyreSmoke', [bx - rx, ry, bz - rz]); }\n      if (hard && !dirt && !grass) { this.world.skids.lay(`${e.i}L`, bx + rx, c.y, bz + rz); this.world.skids.lay(`${e.i}R`, bx - rx, c.y, bz - rz); } else { this.world.skids.lift(`${e.i}L`); this.world.skids.lift(`${e.i}R`); }\n      if (dirt && u > 5 && every2) { P.burst('dirtDust', [bx + rx, ry, bz + rz], { count: 1 + (hard ? 1 : 0) }); P.burst('dirtDust', [bx - rx, ry, bz - rz], { count: 1 }); if (hard || c.surface === 'gravel') P.burst('gravel', [bx, ry, bz], { direction: [-c.vx * 0.2, 1, -c.vz * 0.2] }); }\n      if (grass && every2) P.burst('gravel', [bx, ry, bz], { direction: [-c.vx * 0.2, 1, -c.vz * 0.2], colors: ['green', 'lime', 'teal'] });\n      if (wet && u > 14 && !dirt && every2) { P.burst('rainSpray', [bx + rx, ry, bz + rz], { direction: [-c.vx * 0.05, 1, -c.vz * 0.05] }); P.burst('rainSpray', [bx - rx, ry, bz - rz], { direction: [-c.vx * 0.05, 1, -c.vz * 0.05] }); }\n      if (tr.id === 'saltline' && (c.surface === 'apron') && every2) P.b