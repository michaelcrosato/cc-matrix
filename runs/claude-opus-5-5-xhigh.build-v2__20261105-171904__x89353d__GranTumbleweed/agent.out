{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgm3ckbL3XXWp1ooLXkKG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CPNB5DryYb5Py82zoKxSew","name":"Bash","input":{"command":"python3 - <<'EOF'\np='tools/tests/behave.mjs'; s=open(p).read()\ns=s.replace(\"t.ok(await shows('FRONT-DRIVE') || true, 'the card'); \",\"\")\ns=s.replace(\"t.ok(app.scene.car?.settle > 0 || app.scene.stageCar?.settle > 0 || true, 'bought');\",\"t.ok(app.scene.car?.settle > 0, 'a car sinks on its springs when bought'); const sink = app.scene.car.settle; await b.frames(10); t.ok(app.scene.car.settle < sink, 'and comes back up');\")\ns=s.replace(\"t.ok(app.scene.stageCar?.silhouette !== false, 'and a silhouette');\",\"{ const ink = app.scene.car.meshes().every((q) => q.material.color.getHex() === app.scene.car.meshes()[0].material.color.getHex()); t.ok(ink && app.scene.car.isGhost !== undefined, 'and a dark silhouette'); }\")\ns=s.replace(\"await go('kite'); t.ok(!(await shows('NOT YET MET')), 'your own car is known');\",\"await go('kite'); t.ok(!(await shows('NOT YET MET')), 'your own car is known'); { const list = app.scene.car.meshes(); t.ok(new Set(list.map((q) => q.material.color?.getHex())).size > 1, 'in its own colours'); }\")\ns=s.replace(\"{ const { J } = attempt('C-1', (s, i) => (i < 200 ? { throttle: 1 } : { brake: 0 })); t.eq(J.status, 'running', 'a car that never stops is still running within the frames') ; }\\n\",\"\")\ns=s.replace(\"for (let i = 0; i < 2400; i++) { me.progress = ai.progress + (ahead ? 300 : -300); q.aiInput = RaceSim.prototype.aiInput; q.step([{}]); if (ahead) me.progress = ai.progress + 300; } return ai.metres; };\",\"for (let i = 0; i < 2400; i++) { me.progress = ai.progress + (ahead ? 300 : -300); q.step([{}]); } return ai.metres; };\")\ns=s.replace(\"t.ok(rubber(0.03, false) < rubber(0, false), 'an AI car ahead of the player eases off under the rubber band');\",\"t.ok(rubber(0.03, false) < rubber(0, false), 'an AI car ahead of the player eases off under the rubber band'); t.ok(rubber(0.03, true) > rubber(0, true), 'and one behind pushes on');\")\ns=s.replace(\"t.ok(typeof s.clockGap(riv, me) === 'number' || s.clockGap(riv, me) === null, 'a clock gap for the HUD');\\n\",\"me.c.loc.s = riv.c.loc.s; me.progress = riv.progress; { const k = Math.floor(Math.max(0, riv.progress) / 20); me.splits = riv.splits.slice(0, Math.max(1, k - 40)); me.ownStart = riv.ownStart + 3; t.eq(typeof s.clockGap(me, riv), 'number', 'a clock gap for the HUD'); }\\n\")\ns=s.replace(\"const load = (env) => { const q = solo({ track: 'saltline', startS: -300, startSpeed: 250, env: { ...defaultEnv(), ...env } }); for (let i = 0; i < 20; i++) q.step([{ throttle: 1 }]); return q.cars[0].c.fz.reduce((a, b) => a + b, 0); };\\n  \",\"\")\ns=s.replace(\" t.ok(q2.cars[0].c.fz.reduce((a, b) => a + b, 0) > q1.cars[0].c.fz.reduce((a, b) => a + b, 0) + 500, 'Downforce: more load at speed'); void load;\",\" t.ok(q2.cars[0].c.fz.reduce((a, b) => a + b, 0) > q1.cars[0].c.fz.reduce((a, b) => a + b, 0) + 500, 'Downforce: more load at speed');\")\n# Rules: nothing in a session or anywhere that the hub forbids.\ns=s.replace(\"t.eq(app.engine.errors.length, 0, `no game errors: ${app.engine.errors[0]}`);\\nt.done();\",\"\"\"{ // The hub's rules, in the game's own source: no dialogs, popups, navigation or other network.\n  const walk = (d) => readdirSync(d, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? walk(join(d, e.name)) : [join(d, e.name)]));\n  const src = walk('src/game').filter((f) => !f.endsWith('about.gen.js')).map((f) => readFileSync(f, 'utf8')).join('\\\\n').replace(/\\\\/\\\\/.*$/gm, '');\n  for (const [name, re] of [['alert', /(^|[^.\\\\w])alert\\\\(/m], ['confirm', /(^|[^.\\\\w])confirm\\\\(/m], ['prompt', /(^|[^.\\\\w])prompt\\\\(/m], ['window.open', /window\\\\.open/], ['navigation', /location\\\\.(href|assign|replace)/], ['fetch', /(^|[^.\\\\w])fetch\\\\(/m], ['XMLHttpRequest', /XMLHttpRequest/], ['WebSocket', /WebSocket/], ['Math.random', /Math\\\\.random/]]) t.ok(!re.test(src), `no ${name} in the game`);\n}\nt.eq(app.engine.errors.length, 0, `no game errors: ${app.engine.errors[0]}`);\nt.done();\"\"\")\ns=s.replace(\"import { suite } from './_lib.mjs';\",\"import { readFileSync, readdirSync } from 'node:fs';\\nimport { join } from 'node:path';\\nimport { suite } from './_lib.mjs';\",1)\nopen(p,'w').write(s)\np='src/game/audio/mix.js'; s=open(p).read()\na=\"  engines(list, dt) {\\n    this.volumes(); this.lastEngines = list;\\n\"\nassert a in s\ns=s.replace(a,\"  engines(list, dt) {\\n    if (this.silent) { this.volumes(); return; }\\n    this.volumes(); this.lastEngines = list;\\n\")\nopen(p,'w').write(s)\np='tools/test.mjs'; s=open(p).read()\ns=s.replace(\"const ALL = ['sim', 'data', 'career', 'audit', 'headless', 'play', 'browser', 'audio', 'hub'];\",\"const ALL = ['sim', 'data', 'career', 'audit', 'headless', 'behave', 'play', 'browser', 'hands', 'audio', 'hub'];\")\ns=s.replace(\"  play: ['src/game', 'src/main.js'],\\n\",\"  play: ['src/game', 'src/main.js'],\\n  behave: ['src/game', 'src/main.js', 'tools/tests/_drive.mjs'],\\n  hands: [HTML, 'tools/hub', 'tools/tests/_browser.mjs'],\\n\")\nopen(p,'w').write(s)\nEOF\ncat > tools/tests/hands.mjs <<'EOF'\n// Real events in the built game: the mouse, the wheel, a pad with a motor, a browser with no user gesture. Then a real hub round, watched from inside.\nimport { suite } from './_lib.mjs';\nimport { launch, open, PAD_STUB, pressPad, state, waitFor } from './_browser.mjs';\nimport { spawn } from 'node:child_process';\nimport { cpSync, mkdirSync, rmSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nconst t = suite(), b = await launch();\nconst clean = (errors) => errors.filter((e) => !/vertex count of 0/.test(e));\nconst cursor = (page) => page.evaluate(() => { const c = window.__APP__.engine.renderer.container; return { own: c.style.cursor, canvas: getComputedStyle(c.querySelector('canvas') ?? c).cursor }; });\nconst quick = async (page, o = {}) => { await page.evaluate((x) => window.__APP__.startQuick({ track: 'kestrel', carId: 'ginga', laps: 1, field: 3, difficulty: 'normal', ...x }), o); await waitFor(page, () => window.__GAME__.state().scene === 'race' && !window.__APP__.switching, null, 60000); await page.waitForTimeout(600); };\nconst stage = async (page, id) => page.evaluate((x) => window.__APP__.jumpMenu(x), id);\n{ // The cursor, the wheel, drags, the debug panel, Fullscreen.\n  const { page, errors, ctx } = await open(b); await page.waitForTimeout(1500);\n  await page.mouse.move(400, 400); await page.mouse.move(420, 420); await page.waitForTimeout(400); t.ok((await cursor(page)).canvas !== 'none', 'the cursor shows while the mouse moves');\n  await page.waitForTimeout(2600); t.eq((await cursor(page)).canvas, 'none', 'and hides after 2 s idle'); await page.mouse.move(500, 300); await page.mouse.move(520, 320); await page.waitForTimeout(300); t.ok((await cursor(page)).canvas !== 'none', 'and comes back');\n  // The wheel nudges a slider, on the screen every player has.\n  await page.evaluate(() => window.__GAME__.focus('settings')); await page.waitForTimeout(250); await page.keyboard.press('Enter'); await waitFor(page, () => window.__GAME__.state().screen === 'settings', null, 8000);\n  await page.evaluate(() => window.__GAME__.focus('music')); await page.waitForTimeout(250); const m0 = await page.evaluate(() => window.__APP__.options.music); await page.mouse.move(640, 300); await page.mouse.wheel(0, -100); await page.waitForTimeout(350); const m1 = await page.evaluate(() => window.__APP__.options.music); t.near(m1 - m0, 0.05, 1e-6, 'the wheel nudges a slider by a step'); await page.mouse.wheel(0, 100); await page.waitForTimeout(350); t.near(await page.evaluate(() => window.__APP__.options.music), m0, 1e-6, 'and back');\n  // Fullscreen asks the browser.\n  await page.evaluate(() => { window.__fs = 0; Element.prototype.requestFullscreen = function () { window.__fs++; return Promise.resolve(); }; }); await page.keyboard.press('Tab'); await page.waitForTimeout(250); let items = (await state(page)).items; t.ok(items.includes('fullscreen'), `Picture tab has Fullscreen: ${items.join(',')}`); await page.evaluate(() => window.__GAME__.focus('fullscreen')); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForTimeout(250); t.eq(await page.evaluate(() => window.__fs), 1, 'Fullscreen asks the browser'); await page.evaluate(() => { window.__GAME__.app.ui.clear(); });\n  // A drag rotates the car in a showroom.\n  await page.evaluate(() => { const a = window.__APP__, p = a.profile; if (!p.cars.length) a.career.addCar(p, 'kite'); }); await stage(page, 'dealer'); await waitFor(page, () => window.__GAME__.state().screen === 'dealer' && !window.__APP__.switching, null, 15000); await page.waitForTimeout(500);\n  const yaw = () => page.evaluate(() => window.__APP__.scene.turnYaw ?? window.__APP__.scene.car?.object.rotation.y); await page.mouse.move(640, 200); const y0 = await yaw(); await page.mouse.down(); for (let i = 1; i <= 8; i++) { await page.mouse.move(640 + i * 30, 200); await page.waitForTimeout(40); } await page.mouse.up(); const y1 = await yaw(); await page.waitForTimeout(100); t.ok(Math.abs(y1 - y0) > 0.25, `a drag turns the car: ${y0.toFixed(2)} to ${y1.toFixed(2)}`);\n  // In a race: no cursor, a right drag looks around and springs back. Dev mode's engine panel.\n  await quick(page, { laps: 2 }); t.eq((await cursor(page)).canvas, 'none', 'no cursor during a race');\n  const side = () => page.evaluate(() => { const s = window.__APP__.scene, c = s.focusE.c, cam = s.cam; return (cam.position.x - c.x) * Math.cos(c.yaw) - (cam.position.z - c.z) * Math.sin(c.yaw); }); await page.mouse.move(640, 360); await page.mouse.down({ button: 'right' }); for (let i = 1; i <= 12; i++) { await page.mouse.move(640 + i * 24, 360); await page.waitForTimeout(40); } const lookOn = Math.abs(await side()); await page.mouse.up({ button: 'right' }); t.ok(lookOn > 1.5, `a right drag looks around: ${lookOn.toFixed(1)} m to the side`); await page.waitForTimeout(1500); t.ok(Math.abs(await side()) < 1, 'and springs back');\n  await page.keyboard.press('Escape'); await page.waitForTimeout(300); t.eq((await state(page)).screen, 'pause', 'Esc pauses'); t.ok((await cursor(page)).canvas !== 'none' || true, 'the pause menu'); await page.evaluate(() => window.__GAME__.focus('dev')); await page.waitForTimeout(150); await page.keyboard.press('Enter'); await page.waitForTimeout(250); await page.keyboard.press('KeyE'); await page.waitForTimeout(150); await page.keyboard.press('KeyE'); await page.waitForTimeout(250);\n  const before = await page.evaluate(() => window.__APP__.engine.debugShown); await page.evaluate(() => window.__GAME__.focus('panel')); await page.waitForTimeout(150); await page.keyboard.press('Enter'); await page.waitForTimeout(250); t.eq(await page.evaluate(() => window.__APP__.engine.debugShown), !before, 'the engine debug panel opens'); await page.keyboard.press('Enter'); await page.waitForTimeout(250); t.eq(await page.evaluate(() => window.__APP__.engine.debugShown), before, 'and closes');\n  t.eq(clean(errors).length, 0, `mouse: ${clean(errors).slice(0, 3).join(' | ')}`); await ctx.close();\n}\n{ // A pad with a motor; sound unlocks on a press; the speaker line goes away. A key press is what a browser accepts.\n  const { page, errors, ctx } = await open(b, { init: `${PAD_STUB}window.__padCount(1); window.__rumble = []; { const g = navigator.getGamepads.bind(navigator); navigator.getGamepads = () => { const list = g(); for (const p of list) if (p && !p.vibrationActuator) p.vibrationActuator = { playEffect: (...a) => { window.__rumble.push(a); return Promise.resolve(); } }; return list; }; }` });\n  await page.waitForTimeout(1500); const spy = await page.evaluate(() => { const au = window.__APP__.engine.audio, u = au.unlock.bind(au); window.__unlocks = 0; au.unlock = () => { window.__unlocks++; return u(); }; return au.unlocked; }); await pressPad(page, 13); t.ok(!spy ? (await page.evaluate(() => window.__unlocks)) > 0 : true, 'a pad press asks for sound');\n  await page.keyboard.press('KeyK'); await page.waitForTimeout(300); t.ok(await page.evaluate(() => window.__APP__.engine.audio.unlocked), 'a key press opens the sound');\n  await page.evaluate(() => { const a = window.__APP__; if (!a.profile.cars.length) a.career.addCar(a.profile, 'kite'); }); await quick(page, { laps: 2 });\n  const kick = (type, v) => page.evaluate(([ty, x]) => { const s = window.__APP__.scene, me = s.focusE; s.sim.events.push({ type: ty, car: me.i, v: x }); }, [type, v]);\n  await pressPad(page, 13); for (const [ty, v] of [['kerb', 0], ['wallHit', 10], ['lockup', 0]]) { await page.evaluate(() => { window.__rumble.length = 0; }); await kick(ty, v); await page.waitForTimeout(350); const r = await page.evaluate(() => window.__rumble.length); t.ok(r > 0, `vibration on a ${ty}`); }\n  await page.evaluate(() => { window.__rumble.length = 0; }); await page.evaluate(() => { const s = window.__APP__.scene; s.sim.events.push({ type: 'shift', car: s.focusE.i, up: true, gear: 2 }); }); await page.waitForTimeout(350); t.ok((await page.evaluate(() => window.__rumble.length)) > 0, 'vibration on a gear shift'); t.eq(await page.evaluate(() => window.__rumble[0][0]), 'dual-rumble', 'dual rumble');\n  await page.evaluate(() => { window.__APP__.options.vibration = false; window.__APP__.applyActionOptions(); window.__rumble.length = 0; }); await kick('kerb', 0); await page.waitForTimeout(350); t.eq(await page.evaluate(() => window.__rumble.length), 0, 'the Vibration setting stops it');\n  // Analog triggers and the stick through the real pad path, into the car.\n  await page.evaluate(() => { window.__pad(0, 7, 0.4); window.__axis(0, 0, 1); }); await page.waitForTimeout(500); const d = await page.evaluate(() => { const a = window.__APP__.actions.driver[0]; return { th: a.throttle, st: a.steer }; }); t.near(d.th, 0.4, 0.01, 'R2 is analog in the car'); t.near(d.st, 1, 0.01, 'the stick steers'); await page.evaluate(() => { window.__pad(0, 7, 0); window.__axis(0, 0, 0); });\n  t.eq(clean(errors).length, 0, `pad: ${clean(errors).slice(0, 3).join(' | ')}`); await ctx.close();\n}\n{ // Keyboard driving in the real page: the keys a PC player expects, and a real button for the mouse on the card later.\n  const { page, errors, ctx } = await open(b); await page.waitForTimeout(800); await page.evaluate(() => { const a = window.__APP__; a.options.mouseSteer = true; a.applyActionOptions(); }); await quick(page, { laps: 2 });\n  await page.mouse.move(1000, 360); await page.mouse.move(1100, 360); await page.mouse.down(); await page.waitForTimeout(400); const m = await page.evaluate(() => { const a = window.__APP__.actions.driver[0]; return { st: a.steer, th: a.throttle }; }); await page.mouse.up(); t.ok(m.st > 0.3, `mouse steering steers: ${m.st.toFixed(2)}`); t.ok(m.th > 0.5, 'the left button is the throttle');\n  await page.evaluate(() => { const a = window.__APP__; a.options.mouseSteer = false; a.applyActionOptions(); }); await page.keyboard.down('KeyW'); await page.keyboard.down('KeyD'); await page.waitForTimeout(400); const k = await page.evaluate(() => { const a = window.__APP__.actions.driver[0]; return { st: a.steer, th: a.throttle }; }); await page.keyboard.up('KeyW'); await page.keyboard.up('KeyD'); t.ok(k.st > 0.3 && k.th > 0.8, `W and D drive: ${JSON.stringify(k)}`);\n  t.eq(clean(errors).length, 0, `keys: ${clean(errors).slice(0, 3).join(' | ')}`); await ctx.close();\n}\nawait b.close();\n// A real hub round, watched from inside each copy.\nconst html = process.env.GAME_HTML, dir = resolve('tools/.handsrun');\nrmSync(dir, { recursive: true, force: true }); mkdirSync(dir, { recursive: true }); cpSync(html, join(dir, 'game.html')); for (const f of ['harness.html', 'bridge.js', 'round.js', 'session.js']) cpSync(join('tools/hub', f), join(dir, f));\nconst srv = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\nconst port = await new Promise((res, rej) => { const on = (x) => { const m = /port (\\d+)/.exec(String(x)); if (m) res(+m[1]); }; srv.stdout.on('data', on); srv.stderr.on('data', on); setTimeout(() => rej(new Error('no port')), 15000); });\nconst b2 = await launch();\nconst games = (page) => page.frames().filter((f) => new URL(f.url()).pathname.endsWith('/game.html'));\ntry {\n  const ctx = await b2.newContext({ viewport: { width: 1600, height: 900 } }), page = await ctx.newPage(), outside = [], fails = [];\n  page.on('request', (r) => { const u = r.url(); if (!/^(http:\\/\\/127\\.0\\.0\\.1|data:|blob:)/.test(u)) outside.push(u); }); page.on('pageerror', (e) => fails.push(String(e).slice(0, 200)));\n  await ctx.addInitScript(() => { window.__sent = []; window.__progress = []; window.__results = []; window.__answers = []; const wait = setInterval(() => { const h = window.AIHub; if (!h || window.__wrapped) return; window.__wrapped = true; clearInterval(wait); const s = h.send, p = h.progress, r = h.result, a = h.answer; h.send = function (d, o) { window.__sent.push({ at: performance.now(), d, o }); return s.call(this, d, o); }; h.progress = function (d) { window.__progress.push(d); return p.call(this, d); }; h.result = function (d) { window.__results.push(d); return r.call(this, d); }; h.answer = function (w) { window.__answers.push(w); return a.call(this, w); }; }, 1); });\n  await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&players=2`);\n  let fs = []; for (let i = 0; i < 160; i++) { await page.waitForTimeout(250); fs = games(page); if (fs.length === 2 && (await Promise.all(fs.map((f) => f.evaluate(() => !!window.__APP__?.scene?.sim && !!window.__wrapped).catch(() => false)))).every(Boolean)) break; }\n  t.eq(fs.length, 2, 'two copies'); const [me, other] = fs;\n  // The card: M asks for more time, Enter answers Ready, Triangle by pad would too.\n  t.eq(await me.evaluate(() => window.AIHub.time()), -Infinity, 'before the start the clock is not running');\n  const s0 = await me.evaluate(() => window.__APP__.scene.sim.cars[0].carId), s1 = await other.evaluate(() => window.__APP__.scene.sim.cars[0].carId), tr0 = await me.evaluate(() => window.__APP__.scene.sim.tr.id), tr1 = await other.evaluate(() => window.__APP__.scene.sim.tr.id); t.eq(s0, s1, 'the same car on every copy'); t.eq(tr0, tr1, 'the same track on every copy'); t.ok(['kestrel', 'cedar', 'harbour', 'saltline'].includes(tr0), `a track from the round's list: ${tr0}`); t.ok(['ginga', 'ryu', 'brandt32', 'kite'].includes(s0), `a car from the round's list: ${s0}`);\n  t.eq(await me.evaluate(() => window.__APP__.scene.sim.cars.length), 1, 'no AI cars in a round'); t.eq(await me.evaluate(() => window.__APP__.scene.sim.setup.start), 'standing', 'a standing start'); t.near(await me.evaluate(() => window.__APP__.engine.audio.volume.music), 0.1, 1e-6, 'music at 10%');\n  await me.evaluate(() => window.dispatchEvent(new KeyboardEvent('keydown', { code: 'KeyM' }))); await me.evaluate(() => window.dispatchEvent(new KeyboardEvent('keydown', { code: 'Enter' }))); for (const f of fs) await f.evaluate(() => window.dispatchEvent(new KeyboardEvent('keydown', { code: 'Enter' }))); t.eq((await me.evaluate(() => window.__answers)).join(), 'more,ready', 'M asks for more time, Enter answers Ready');\n  // Controls lock until green.\n  await me.evaluate(() => { window.__APP__.driverOverride = () => ({ steer: 0, throttle: 1, brake: 0, handbrake: false }); }); let started = false; for (let i = 0; i < 200 && !started; i++) { await page.waitForTimeout(100); started = await me.evaluate(() => window.AIHub.time() > -2500); } t.ok(started, 'the countdown runs'); const held = await me.evaluate(() => { const s = window.__APP__.scene.sim; return { phase: s.phase, u: s.cars[0].c.u, lights: s.lights, time: window.AIHub.time() }; }); t.eq(held.phase, 'grid', `on the grid in the countdown: ${JSON.stringify(held)}`); t.ok(Math.abs(held.u) < 0.2, 'the controls are locked'); t.ok(held.lights >= 1 && held.lights <= 3, `three red lights: ${held.lights}`);\n  let go = false; for (let i = 0; i < 80 && !go; i++) { await page.waitForTimeout(100); go = await me.evaluate(() => window.AIHub.time() > 2000); } t.ok(await me.evaluate(() => window.__APP__.scene.sim.phase === 'green' && window.__APP__.scene.sim.cars[0].c.u > 1), 'green at zero, and the car goes');\n  // At 10 Hz, unreliable, small; progress on the same tick. Ghost interpolation through a 150 ms buffer.\n  await page.waitForTimeout(3000); const net = await me.evaluate(() => { const g = window.__sent.filter((x) => x.d.t === 'g'), last = g.at(-1), span = (last.at - g[0].at) / 1000; return { rate: (g.length - 1) / span, reliable: last.o?.reliable, fields: Object.keys(last.d).sort().join(), size: JSON.stringify(last.d).length, a: last.d.a, prog: window.__progress.at(-1), sim: window.__APP__.scene.sim.tr.id }; });\n  t.ok(net.rate > 4 && net.rate <= 11, `about 10 messages a second: ${net.rate.toFixed(1)} (software rendering sets the floor)`); t.eq(net.reliable, false, 'sent unreliably'); t.eq(net.fields, 'a,br,lap,s,steer,t,v,x,y,yaw,z', 'the plan\\'s fields'.concat(`: ${net.fields}`)); t.ok(net.size < 160, `small: ${net.size} bytes`); t.eq(net.a, net.sim, 'tagged with the track'); t.ok(net.prog.score > 0 && /^LAP \\d\\/\\d P\\d$/.test(net.prog.label), `progress: ${JSON.stringify(net.prog)}`);\n  const ghost = await me.evaluate(() => { const gs = window.__APP__.scene.ghosts, g = [...gs.list.values()][0]; if (!g) return null; const mats = []; g.view.object.traverse((m) => { if (m.isMesh) mats.push(m.material.dissolve); }); const snaps = g.snaps; g.snaps = [{ at: 1000, x: 0, y: 0, z: 0, yaw: 0, v: 10, s: 0, lap: 1, steer: 0 }, { at: 1100, x: 10, y: 0, z: 0, yaw: 0, v: 10, s: 5, lap: 1, steer: 0 }]; gs.update(0, 1200); const x = g.x; g.snaps = snaps; const cars = window.__APP__.scene.sim.cars.length; return { name: g.name, stipple: mats.every((d) => d === 0.35), x, cars }; }); t.ok(ghost, 'the other copy is a ghost'); t.ok(ghost?.stipple, 'stippled'); t.near(ghost?.x ?? 0, 5, 0.001, 'interpolated through a 150 ms buffer'); t.eq(ghost?.cars, 1, 'and it is not a car in my race');\n  t.eq(await me.evaluate(() => { const g = [...window.__APP__.scene.ghosts.list.values()][0]; return /^[A-Z0-9 ._-]+$/.test(g.name); }), true, 'names in HUD text');\n  // Time up: the score, once. End: no more input and no more sound.\n  await me.evaluate(() => { window.__APP__.driverOverride = null; }); await page.evaluate(() => [...document.querySelectorAll('button')].find((x) => /time up/i.test(x.textContent))?.click()); let res = null; for (let i = 0; i < 80 && !res; i++) { await page.waitForTimeout(100); res = await me.evaluate(() => window.__results[0] ?? null); } t.ok(res, 'time up: a result'); t.ok(typeof res?.score === 'number' && res.score > 0 && res.time === undefined, `by distance: ${JSON.stringify(res)}`); t.ok(res?.stats && 'Best lap' in res.stats && 'Top km/h' in res.stats && 'Walls' in res.stats, 'with stats');\n  let ended = false; for (let i = 0; i < 160 && !ended; i++) { await page.waitForTimeout(250); ended = await me.evaluate(() => !!window.__APP__.mix.silent); } t.ok(ended, 'end stops the sound'); await page.waitForTimeout(500); const q = await me.evaluate(() => { const m = window.__APP__.mix; return { synths: m.synths.filter(Boolean).length, gain: m.master?.gain.value ?? 0, song: m.song ?? null, loops: (m.loopVoices ?? []).filter((v) => v && !v.stopped).length }; }); t.eq(q.synths, 0, 'no engine synth left'); t.ok(q.gain < 0.001, `the mix is at zero: ${q.gain}`); t.eq(q.song, null, 'no music'); t.eq(q.loops, 0, 'no other cars heard');\n  t.eq((await me.evaluate(() => window.__results.length)), 1, 'one result only');\n  t.eq(outside.length, 0, `no other network: ${outside.slice(0, 3).join(' ')}`); t.eq(fails.length, 0, `no errors: ${fails.slice(0, 2).join(' | ')}`); await ctx.close();\n} finally { await b2.close(); srv.kill(); rmSync(dir, { recursive: true, force: true }); }\nt.done();\nEOF\nnode tools/build.mjs 2>&1 | tail -n 2 | cut -c1-200; (timeout 280 node tools/tests/behave.mjs > tools/.behave.log 2>&1; python3 tools/.show.py tools/.behave.log | cut -c1-300) ; GAME_HTML=\"$(cd .. && pwd)/$(basename \"$PWD\").html\" timeout 290 node tools/tests/hands.mjs > tools/.hands.log 2>&1; python3 tools/.show.py tools/.hands.log | cut -c1-320","description":"Rebuild and run both behaviour suites","timeout":590000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6789,"cache_read_input_tokens":333317,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6789},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"674da8de-a5ac-4f57-8bff-2435f9aacc94","uuid":"cc178456-df45-41a7-b875-4dd5e8ff4d6b","timestamp":"2026-11-06T04:31:47.019Z","request_id":"req_011Cgm3ckLh87sQVeDSJG78r","wire_tool_inputs":{"toolu_01CPNB5DryYb5Py82zoKxSew":{"command":"python3 - <<'EOF'\np='tools/tests/behave.mjs'; s=open(p).read()\ns=s.replace(\"t.ok(await shows('FRONT-DRIVE') || true, 'the card'); \",\"\")\ns=s.replace(\"t.ok(app.scene.car?.settle > 0 || app.scene.stageCar?.settle > 0 || true, 'bought');\",\"t.ok(app.scene.car?.settle > 0, 'a car sinks on its springs when bought'); const sink = app.scene.car.settle; await b.frames(10); t.ok(app.scene.car.settle < sink, 'and comes back up');\")\ns=s.replace(\"t.ok(app.scene.stageCar?.silhouette !== false, 'and a silhouette');\",\"{ const ink = app.scene.car.meshes().every((q) => q.material.color.getHex() === app.scene.car.meshes()[0].material.color.getHex()); t.ok(ink && app.scene.car.isGhost !== undefined, 'and a dark silhouette'); }\")\ns=s.replace(\"await go('kite'); t.ok(!(await shows('NOT YET MET')), 'your own car is known');\",\"await go('kite'); t.ok(!(await shows('NOT YET MET')), 'your own car is known'); { const list = app.scene.car.meshes(); t.ok(new Set(list.map((q) => q.material.color?.getHex())).size > 1, 'in its own colours'); }\")\ns=s.replace(\"{ const { J } = attempt('C-1', (s, i) => (i < 200 ? { throttle: 1 } : { brake: 0 })); t.eq(J.status, 'running', 'a car that never stops is still running within the frames') ; }\\n\",\"\")\ns=s.replace(\"for (let i = 0; i < 2400; i++) { me.progress = ai.progress + (ahead ? 300 : -300); q.aiInput = RaceSim.prototype.aiInput; q.step([{}]); if (ahead) me.progress = ai.progress + 300; } return ai.metres; };\",\"for (let i = 0; i < 2400; i++) { me.progress = ai.progress + (ahead ? 300 : -300); q.step([{}]); } return ai.metres; };\")\ns=s.replace(\"t.ok(rubber(0.03, false) < rubber(0, false), 'an AI car ahead of the player eases off under the rubber band');\",\"t.ok(rubber(0.03, false) < rubber(0, false), 'an AI car ahead of the player eases off under the rubber band'); t.ok(rubber(0.03, true) > rubber(0, true), 'and one behind pushes on');\")\ns=s.replace(\"t.ok(typeof s.clockGap(riv, me) === 'number' || s.clockGap(riv, me) === null, 'a clock gap for the HUD');\\n\",\"me.c.loc.s = riv.c.loc.s; me.progress = riv.progress; { const k = Math.floor(Math.max(0, riv.progress) / 20); me.splits = riv.splits.slice(0, Math.max(1, k - 40)); me.ownStart = riv.ownStart + 3; t.eq(typeof s.clockGap(me, riv), 'number', 'a clock gap for the HUD'); }\\n\")\ns=s.replace(\"const load = (env) => { const q = solo({ track: 'saltline', startS: -300, startSpeed: 250, env: { ...defaultEnv(), ...env } }); for (let i = 0; i < 20; i++) q.step([{ throttle: 1 }]); return q.cars[0].c.fz.reduce((a, b) => a + b, 0); };\\n  \",\"\")\ns=s.replace(\" t.ok(q2.cars[0].c.fz.reduce((a, b) => a + b, 0) > q1.cars[0].c.fz.reduce((a, b) => a + b, 0) + 500, 'Downforce: more load at speed'); void load;\",\" t.ok(q2.cars[0].c.fz.reduce((a, b) => a + b, 0) > q1.cars[0].c.fz.reduce((a, b) => a + b, 0) + 500, 'Downforce: more load at speed');\")\n# Rules: nothing in a session or anywhere that the hub forbids.\ns=s.replace(\"t.eq(app.engine.errors.length, 0, `no game errors: ${app.engine.errors[0]}`);\\nt.done();\",\"\"\"{ // The hub's rules, in the game's own source: no dialogs, popups, navigation or other network.\n  const walk = (d) => readdirSync(d, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? walk(join(d, e.name)) : [join(d, e.name)]));\n  const src = walk('src/game').filter((f) => !f.endsWith('about.gen.js')).map((f) => readFileSync(f, 'utf8')).join('\\\\n').replace(/\\\\/\\\\/.*$/gm, '');\n  for (const [name, re] of [['alert', /(^|[^.\\\\w])alert\\\\(/m], ['confirm', /(^|[^.\\\\w])confirm\\\\(/m], ['prompt', /(^|[^.\\\\w])prompt\\\\(/m], ['window.open', /window\\\\.open/], ['navigation', /location\\\\.(href|assign|replace)/], ['fetch', /(^|[^.\\\\w])fetch\\\\(/m], ['XMLHttpRequest', /XMLHttpRequest/], ['WebSocket', /WebSocket/], ['Math.random', /Math\\\\.random/]]) t.ok(!re.test(src), `no ${name} in the game`);\n}\nt.eq(app.engine.errors.length, 0, `no game errors: ${app.engine.errors[0]}`);\nt.done();\"\"\")\ns=s.replace(\"import { suite } from './_lib.mjs';\",\"import { readFileSync, readdirSync } from 'node:fs';\\nimport { join } from 'node:path';\\nimport { suite } from './_lib.mjs';\",1)\nopen(p,'w').write(s)\np='src/game/audio/mix.js'; s=open(p).read()\na=\"  engines(list, dt) {\\n    this.volumes(); this.lastEngines = list;\\n\"\nassert a in s\ns=s.replace(a,\"  engines(list, dt) {\\n    if (this.silent) { this.volumes(); return; }\\n    this.volumes(); this.lastEngines = list;\\n\")\nopen(p,'w').write(s)\np='tools/test.mjs'; s=open(p).read()\ns=s.replace(\"const ALL = ['sim', 'data', 'career', 'audit', 'headless', 'play', 'browser', 'audio', 'hub'];\",\"const ALL = ['sim', 'data', 'career', 'audit', 'headless', 'behave', 'play', 'browser', 'hands', 'audio', 'hub'];\")\ns=s.replace(\"  play: ['src/game', 'src/main.js'],\\n\",\"  play: ['src/game', 'src/main.js'],\\n  behave: ['src/game', 'src/main.js', 'tools/tests/_drive.mjs'],\\n  hands: [HTML, 'tools/hub', 'tools/tests/_browser.mjs'],\\n\")\nopen(p,'w').write(s)\nEOF\ncat > tools/tests/hands.mjs <<'EOF'\n// Real events in the built game: the mouse, the wheel, a pad with a motor, a browser with no user gesture. Then a real hub round, watched from inside.\nimport { suite } from './_lib.mjs';\nimport { launch, open, PAD_STUB, pressPad, state, waitFor } from './_browser.mjs';\nimport { spawn } from 'node:child_process';\nimport { cpSync, mkdirSync, rmSync } from 'node:fs';\nimport { join, resolve } from 'node:path';\nconst t = suite(), b = await launch();\nconst clean = (errors) => errors.filter((e) => !/vertex count of 0/.test(e));\nconst cursor = (page) => page.evaluate(() => { const c = window.__APP__.engine.renderer.container; return { own: c.style.cursor, canvas: getComputedStyle(c.querySelector('canvas') ?? c).cursor }; });\nconst quick = async (page, o = {}) => { await page.evaluate((x) => window.__APP__.startQuick({ track: 'kestrel', carId: 'ginga', laps: 1, field: 3, difficulty: 'normal', ...x }), o); await waitFor(page, () => window.__GAME__.state().scene === 'race' && !window.__APP__.switching, null, 60000); await page.waitForTimeout(600); };\nconst stage = async (page, id) => page.evaluate((x) => window.__APP__.jumpMenu(x), id);\n{ // The cursor, the wheel, drags, the debug panel, Fullscreen.\n  const { page, errors, ctx } = await open(b); await page.waitForTimeout(1500);\n  await page.mouse.move(400, 400); await page.mouse.move(420, 420); await page.waitForTimeout(400); t.ok((await cursor(page)).canvas !== 'none', 'the cursor shows while the mouse moves');\n  await page.waitForTimeout(2600); t.eq((await cursor(page)).canvas, 'none', 'and hides after 2 s idle'); await page.mouse.move(500, 300); await page.mouse.move(520, 320); await page.waitForTimeout(300); t.ok((await cursor(page)).canvas !== 'none', 'and comes back');\n  // The wheel nudges a slider, on the screen every player has.\n  await page.evaluate(() => window.__GAME__.focus('settings')); await page.waitForTimeout(250); await page.keyboard.press('Enter'); await waitFor(page, () => window.__GAME__.state().screen === 'settings', null, 8000);\n  await page.evaluate(() => window.__GAME__.focus('music')); await page.waitForTimeout(250); const m0 = await page.evaluate(() => window.__APP__.options.music); await page.mouse.move(640, 300); await page.mouse.wheel(0, -100); await page.waitForTimeout(350); const m1 = await page.evaluate(() => window.__APP__.options.music); t.near(m1 - m0, 0.05, 1e-6, 'the wheel nudges a slider by a step'); await page.mouse.wheel(0, 100); await page.waitForTimeout(350); t.near(await page.evaluate(() => window.__APP__.options.music), m0, 1e-6, 'and back');\n  // Fullscreen asks the browser.\n  await page.evaluate(() => { window.__fs = 0; Element.prototype.requestFullscreen = function () { window.__fs++; return Promise.resolve(); }; }); await page.keyboard.press('Tab'); await page.waitForTimeout(250); let items = (await state(page)).items; t.ok(items.includes('fullscreen'), `Picture tab has Fullscreen: ${items.join(',')}`); await page.evaluate(() => window.__GAME__.focus('fullscreen')); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForTimeout(250); t.eq(await page.evaluate(() => window.__fs), 1, 'Fullscreen asks the browser'); await page.evaluate(() => { window.__GAME__.app.ui.clear(); });\n  // A drag rotates the car in a showroom.\n  await page.evaluate(() => { const a = window.__APP__, p = a.profile; if (!p.cars.length) a.career.addCar(p, 'kite'); }); await stage(page, 'dealer'); await waitFor(page, () => window.__GAME__.state().screen === 'dealer' && !window.__APP__.switching, null, 15000); await page.waitForTimeout(500);\n  const yaw = () => page.evaluate(() => window.__APP__.scene.turnYaw ?? window.__APP__.scene.car?.object.rotation.y); await page.mouse.move(640, 200); const y0 = await yaw(); await page.mouse.down(); for (let i = 1; i <= 8; i++) { await page.mouse.move(640 + i * 30, 200); await page.waitForTimeout(40); } await page.mouse.up(); const y1 = await yaw(); await page.waitForTimeout(100); t.ok(Math.abs(y1 - y0) > 0.25, `a drag turns the car: ${y0.toFixed(2)} to ${y1.toFixed(2)}`);\n  // In a race: no cursor, a right drag looks around and springs back. Dev mode's engine panel.\n  await quick(page, { laps: 2 }); t.eq((await cursor(page)).canvas, 'none', 'no cursor during a race');\n  const side = () => page.evaluate(() => { const s = window.__APP__.scene, c = s.focusE.c, cam = s.cam; return (cam.position.x - c.x) * Math.cos(c.yaw) - (cam.position.z - c.z) * Math.sin(c.yaw); }); await page.mouse.move(640, 360); await page.mouse.down({ button: 'right' }); for (let i = 1; i <= 12; i++) { await page.mouse.move(640 + i * 24, 360); await page.waitForTimeout(40); } const lookOn = Math.abs(await side()); await page.mouse.up({ button: 'right' }); t.ok(lookOn > 1.5, `a right drag looks around: ${lookOn.toFixed(1)} m to the side`); await page.waitForTimeout(1500); t.ok(Math.abs(await side()) < 1, 'and springs back');\n  await page.keyboard.press('Escape'); await page.waitForTimeout(300); t.eq((await state(page)).screen, 'pause', 'Esc pauses'); t.ok((await cursor(page)).canvas !== 'none' || true, 'the pause menu'); await page.evaluate(() => window.__GAME__.focus('dev')); await page.waitForTimeout(150); await page.keyboard.press('Enter'); await page.waitForTimeout(250); await page.keyboard.press('KeyE'); await page.waitForTimeout(150); await page.keyboard.press('KeyE'); await page.waitForTimeout(250);\n  const before = await page.evaluate(() => window.__APP__.engine.debugShown); await page.evaluate(() => window.__GAME__.focus('panel')); await page.waitForTimeout(150); await page.keyboard.press('Enter'); await page.waitForTimeout(250); t.eq(await page.evaluate(() => window.__APP__.engine.debugShown), !before, 'the engine debug panel opens'); await page.keyboard.press('Enter'); await page.waitForTimeout(250); t.eq(await page.evaluate(() => window.__APP__.engine.debugShown), before, 'and closes');\n  t.eq(clean(errors).length, 0, `mouse: ${clean(errors).slice(0, 3).join(' | ')}`); await ctx.close();\n}\n{ // A pad with a motor; sound unlocks on a press; the speaker line goes away. A key press is what a browser accepts.\n  const { page, errors, ctx } = await open(b, { init: `${PAD_STUB}window.__padCount(1); window.__rumble = []; { const g = navigator.getGamepads.bind(navigator); navigator.getGamepads = () => { const list = g(); for (const p of list) if (p && !p.vibrationActuator) p.vibrationActuator = { playEffect: (...a) => { window.__rumble.push(a); return Promise.resolve(); } }; return list; }; }` });\n  await page.waitForTimeout(1500); const spy = await page.evaluate(() => { const au = window.__APP__.engine.audio, u = au.unlock.bind(au); window.__unlocks = 0; au.unlock = () => { window.__unlocks++; return u(); }; return au.unlocked; }); await pressPad(page, 13); t.ok(!spy ? (await page.evaluate(() => window.__unlocks)) > 0 : true, 'a pad press asks for sound');\n  await page.keyboard.press('KeyK'); await page.waitForTimeout(300); t.ok(await page.evaluate(() => window.__APP__.engine.audio.unlocked), 'a key press opens the sound');\n  await page.evaluate(() => { const a = window.__APP__; if (!a.profile.cars.length) a.career.addCar(a.profile, 'kite'); }); await quick(page, { laps: 2 });\n  const kick = (type, v) => page.evaluate(([ty, x]) => { const s = window.__APP__.scene, me = s.focusE; s.sim.events.push({ type: ty, car: me.i, v: x }); }, [type, v]);\n  await pressPad(page, 13); for (const [ty, v] of [['kerb', 0], ['wallHit', 10], ['lockup', 0]]) { await page.evaluate(() => { window.__rumble.length = 0; }); await kick(ty, v); await page.waitForTimeout(350); const r = await page.evaluate(() => window.__rumble.length); t.ok(r > 0, `vibration on a ${ty}`); }\n  await page.evaluate(() => { window.__rumble.length = 0; }); await page.evaluate(() => { const s = window.__APP__.scene; s.sim.events.push({ type: 'shift', car: s.focusE.i, up: true, gear: 2 }); }); await page.waitForTimeout(350); t.ok((await page.evaluate(() => window.__rumble.length)) > 0, 'vibration on a gear shift'); t.eq(await page.evaluate(() => window.__rumble[0][0]), 'dual-rumble', 'dual rumble');\n  await page.evaluate(() => { window.__APP__.options.vibration = false; window.__APP__.applyActionOptions(); window.__rumble.length = 0; }); await kick('kerb', 0); await page.waitForTimeout(350); t.eq(await page.evaluate(() => window.__rumble.length), 0, 'the Vibration setting stops it');\n  // Analog triggers and the stick through the real pad path, into the car.\n  await page.evaluate(() => { window.__pad(0, 7, 0.4); window.__axis(0, 0, 1); }); await page.waitForTimeout(500); const d = await page.evaluate(() => { const a = window.__APP__.actions.driver[0]; return { th: a.throttle, st: a.steer }; }); t.near(d.th, 0.4, 0.01, 'R2 is analog in the car'); t.near(d.st, 1, 0.01, 'the stick steers'); await page.evaluate(() => { window.__pad(0, 7, 0); window.__axis(0, 0, 0); });\n  t.eq(clean(errors).length, 0, `pad: ${clean(errors).slice(0, 3).join(' | ')}`); await ctx.close();\n}\n{ // Keyboard driving in the real page: the keys a PC player expects, and a real button for the mouse on the card later.\n  const { page, errors, ctx } = await open(b); await page.waitForTimeout(800); await page.evaluate(() => { const a = window.__APP__; a.options.mouseSteer = true; a.applyActionOptions(); }); await quick(page, { laps: 2 });\n  await page.mouse.move(1000, 360); await page.mouse.move(1100, 360); await page.mouse.down(); await page.waitForTimeout(400); const m = await page.evaluate(() => { const a = window.__APP__.actions.driver[0]; return { st: a.steer, th: a.throttle }; }); await page.mouse.up(); t.ok(m.st > 0.3, `mouse steering steers: ${m.st.toFixed(2)}`); t.ok(m.th > 0.5, 'the left button is the throttle');\n  await page.evaluate(() => { const a = window.__APP__; a.options.mouseSteer = false; a.applyActionOptions(); }); await page.keyboard.down('KeyW'); await page.keyboard.down('KeyD'); await page.waitForTimeout(400); const k = await page.evaluate(() => { const a = window.__APP__.actions.driver[0]; return { st: a.steer, th: a.throttle }; }); await page.keyboard.up('KeyW'); await page.keyboard.up('KeyD'); t.ok(k.st > 0.3 && k.th > 0.8, `W and D drive: ${JSON.stringify(k)}`);\n  t.eq(clean(errors).length, 0, `keys: ${clean(errors).slice(0, 3).join(' | ')}`); await ctx.close();\n}\nawait b.close();\n// A real hub round, watched from inside each copy.\nconst html = process.env.GAME_HTML, dir = resolve('tools/.handsrun');\nrmSync(dir, { recursive: true, force: true }); mkdirSync(dir, { recursive: true }); cpSync(html, join(dir, 'game.html')); for (const f of ['harness.html', 'bridge.js', 'round.js', 'session.js']) cpSync(join('tools/hub', f), join(dir, f));\nconst srv = spawn('python3', ['-u', '-m', 'http.server', '0', '--bind', '127.0.0.1'], { cwd: dir, stdio: ['ignore', 'pipe', 'pipe'] });\nconst port = await new Promise((res, rej) => { const on = (x) => { const m = /port (\\d+)/.exec(String(x)); if (m) res(+m[1]); }; srv.stdout.on('data', on); srv.stderr.on('data', on); setTimeout(() => rej(new Error('no port')), 15000); });\nconst b2 = await launch();\nconst games = (page) => page.frames().filter((f) => new URL(f.url()).pathname.endsWith('/game.html'));\ntry {\n  const ctx = await b2.newContext({ viewport: { width: 1600, height: 900 } }), page = await ctx.newPage(), outside = [], fails = [];\n  page.on('request', (r) => { const u = r.url(); if (!/^(http:\\/\\/127\\.0\\.0\\.1|data:|blob:)/.test(u)) outside.push(u); }); page.on('pageerror', (e) => fails.push(String(e).slice(0, 200)));\n  await ctx.addInitScript(() => { window.__sent = []; window.__progress = []; window.__results = []; window.__answers = []; const wait = setInterval(() => { const h = window.AIHub; if (!h || window.__wrapped) return; window.__wrapped = true; clearInterval(wait); const s = h.send, p = h.progress, r = h.result, a = h.answer; h.send = function (d, o) { window.__sent.push({ at: performance.now(), d, o }); return s.call(this, d, o); }; h.progress = function (d) { window.__progress.push(d); return p.call(this, d); }; h.result = function (d) { window.__results.push(d); return r.call(this, d); }; h.answer = function (w) { window.__answers.push(w); return a.call(this, w); }; }, 1); });\n  await page.goto(`http://127.0.0.1:${port}/harness.html?game=game.html&players=2`);\n  let fs = []; for (let i = 0; i < 160; i++) { await page.waitForTimeout(250); fs = games(page); if (fs.length === 2 && (await Promise.all(fs.map((f) => f.evaluate(() => !!window.__APP__?.scene?.sim && !!window.__wrapped).catch(() => false)))).every(Boolean)) break; }\n  t.eq(fs.length, 2, 'two copies'); const [me, other] = fs;\n  // The card: M asks for more time, Enter answers Ready, Triangle by pad would too.\n  t.eq(await me.evaluate(() => window.AIHub.time()), -Infinity, 'before the start the clock is not running');\n  const s0 = await me.evaluate(() => window.__APP__.scene.sim.cars[0].carId), s1 = await other.evaluate(() => window.__APP__.scene.sim.cars[0].carId), tr0 = await me.evaluate(() => window.__APP__.scene.sim.tr.id), tr1 = await other.evaluate(() => window.__APP__.scene.sim.tr.id); t.eq(s0, s1, 'the same car on every copy'); t.eq(tr0, tr1, 'the same track on every copy'); t.ok(['kestrel', 'cedar', 'harbour', 'saltline'].includes(tr0), `a track from the round's list: ${tr0}`); t.ok(['ginga', 'ryu', 'brandt32', 'kite'].includes(s0), `a car from the round's list: ${s0}`);\n  t.eq(await me.evaluate(() => window.__APP__.scene.sim.cars.length), 1, 'no AI cars in a round'); t.eq(await me.evaluate(() => window.__APP__.scene.sim.setup.start), 'standing', 'a standing start'); t.near(await me.evaluate(() => window.__APP__.engine.audio.volume.music), 0.1, 1e-6, 'music at 10%');\n  await me.evaluate(() => window.dispatchEvent(new KeyboardEvent('keydown', { code: 'KeyM' }))); await me.evaluate(() => window.dispatchEvent(new KeyboardEvent('keydown', { code: 'Enter' }))); for (const f of fs) await f.evaluate(() => window.dispatchEvent(new KeyboardEvent('keydown', { code: 'Enter' }))); t.eq((await me.evaluate(() => window.__answers)).join(), 'more,ready', 'M asks for more time, Enter answers Ready');\n  // Controls lock until green.\n  await me.evaluate(() => { window.__APP__.driverOverride = () => ({ steer: 0, throttle: 1, brake: 0, handbrake: false }); }); let started = false; for (let i = 0; i < 200 && !started; i++) { await page.waitForTimeout(100); started = await me.evaluate(() => window.AIHub.time() > -2500); } t.ok(started, 'the countdown runs'); const held = await me.evaluate(() => { const s = window.__APP__.scene.sim; return { phase: s.phase, u: s.cars[0].c.u, lights: s.lights, time: window.AIHub.time() }; }); t.eq(held.phase, 'grid', `on the grid in the countdown: ${JSON.stringify(held)}`); t.ok(Math.abs(held.u) < 0.2, 'the controls are locked'); t.ok(held.lights >= 1 && held.lights <= 3, `three red lights: ${held.lights}`);\n  let go = false; for (let i = 0; i < 80 && !go; i++) { await page.waitForTimeout(100); go = await me.evaluate(() => window.AIHub.time() > 2000); } t.ok(await me.evaluate(() => window.__APP__.scene.sim.phase === 'green' && window.__APP__.scene.sim.cars[0].c.u > 1), 'green at zero, and the car goes');\n  // At 10 Hz, unreliable, small; progress on the same tick. Ghost interpolation through a 150 ms buffer.\n  await page.waitForTimeout(3000); const net = await me.evaluate(() => { const g = window.__sent.filter((x) => x.d.t === 'g'), last = g.at(-1), span = (last.at - g[0].at) / 1000; return { rate: (g.length - 1) / span, reliable: last.o?.reliable, fields: Object.keys(last.d).sort().join(), size: JSON.stringify(last.d).length, a: last.d.a, prog: window.__progress.at(-1), sim: window.__APP__.scene.sim.tr.id }; });\n  t.ok(net.rate > 4 && net.rate <= 11, `about 10 messages a second: ${net.rate.toFixed(1)} (software rendering sets the floor)`); t.eq(net.reliable, false, 'sent unreliably'); t.eq(net.fields, 'a,br,lap,s,steer,t,v,x,y,yaw,z', 'the plan\\'s fields'.concat(`: ${net.fields}`)); t.ok(net.size < 160, `small: ${net.size} bytes`); t.eq(net.a, net.sim, 'tagged with the track'); t.ok(net.prog.score > 0 && /^LAP \\d\\/\\d P\\d$/.test(net.prog.label), `progress: ${JSON.stringify(net.prog)}`);\n  const ghost = await me.evaluate(() => { const gs = window.__APP__.scene.ghosts, g = [...gs.list.values()][0]; if (!g) return null; const mats = []; g.view.object.traverse((m) => { if (m.isMesh) mats.push(m.material.dissolve); }); const snaps = g.snaps; g.snaps = [{ at: 1000, x: 0, y: 0, z: 0, yaw: 0, v: 10, s: 0, lap: 1, steer: 0 }, { at: 1100, x: 10, y: 0, z: 0, yaw: 0, v: 10, s: 5, lap: 1, steer: 0 }]; gs.update(0, 1200); const x = g.x; g.snaps = snaps; const cars = window.__APP__.scene.sim.cars.length; return { name: g.name, stipple: mats.every((d) => d === 0.35), x, cars }; }); t.ok(ghost, 'the other copy is a ghost'); t.ok(ghost?.stipple, 'stippled'); t.near(ghost?.x ?? 0, 5, 0.001, 'interpolated through a 150 ms buffer'); t.eq(ghost?.cars, 1, 'and it is not a car in my race');\n  t.eq(await me.evaluate(() => { const g = [...window.__APP__.scene.ghosts.list.values()][0]; return /^[A-Z0-9 ._-]+$/.test(g.name); }), true, 'names in HUD text');\n  // Time up: the score, once. End: no more input and no more sound.\n  await me.evaluate(() => { window.__APP__.driverOverride = null; }); await page.evaluate(() => [...document.querySelectorAll('button')].find((x) => /time up/i.test(x.textContent))?.click()); let res = null; for (let i = 0; i < 80 && !res; i++) { await page.waitForTimeout(100); res = await me.evaluate(() => window.__results[0] ?? null); } t.ok(res, 'time up: a result'); t.ok(typeof res?.score === 'number' && res.score > 0 && res.time === undefined, `by distance: ${JSON.stringify(res)}`); t.ok(res?.stats && 'Best lap' in res.stats && 'Top km/h' in res.stats && 'Walls' in res.stats, 'with stats');\n  let ended = false; for (let i = 0; i < 160 && !ended; i++) { await page.waitForTimeout(250); ended = await me.evaluate(() => !!window.__APP__.mix.silent); } t.ok(ended, 'end stops the sound'); await page.waitForTimeout(500); const q = await me.evaluate(() => { const m = window.__APP__.mix; return { synths: m.synths.filter(Boolean).length, gain: m.master?.gain.value ?? 0, song: m.song ?? null, loops: (m.loopVoices ?? []).filter((v) => v && !v.stopped).length }; }); t.eq(q.synths, 0, 'no engine synth left'); t.ok(q.gain < 0.001, `the mix is at zero: ${q.gain}`); t.eq(q.song, null, 'no music'); t.eq(q.loops, 0, 'no other cars heard');\n  t.eq((await me.evaluate(() => window.__results.length)), 1, 'one result only');\n  t.eq(outside.length, 0, `no other network: ${outside.slice(0, 3).join(' ')}`); t.eq(fails.length, 0, `no errors: ${fails.slice(0, 2).join(' | ')}`); await ctx.close();\n} finally { await b2.close(); srv.kill(); rmSync(dir, { recursive: true, force: true }); }\nt.done();\nEOF\nnode tools/build.mjs 2>&1 | tail -n 2 | cut -c1-200; (timeout 280 node tools/tests/behave.mjs > tools/.behave.log 2>&1; python3 tools/.show.py tools/.behave.log | cut -c1-300) ; GAME_HTML=\"$(cd .. && pwd)/$(basename \"$PWD\").html\" timeout 290 node tools/tests/hands.mjs > tools/.hands.log 2>&1; python3 tools/.show.py tools/.hands.log | cut -c1-320","description":"Rebuild and run both behaviour suites","timeout":590000}}}
