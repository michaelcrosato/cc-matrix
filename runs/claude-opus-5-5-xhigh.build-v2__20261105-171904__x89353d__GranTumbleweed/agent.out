er = career; this.factory = {};\")\nopen(p,'w').write(s)\np='tools/scratch/gallery.py'; s=open(p).read()\na=\"names=sys.argv[1:] or list(SHOTS)\"\nb='''SETUP=\"\"\"const a=window.__APP__, C=a.career; if(!a.profile.cars.length){const c=C.addCar(a.profile,'kite'); a.profile.credits=64000; a.profile.licences.C=true; a.profile.licences.B=true; a.profile.tests['C-1']={medal:'gold',best:17.9,fails:0}; a.profile.tests['C-2']={medal:'silver',best:17.9,fails:0}; a.profile.tests['C-3']={medal:'bronze',best:27.9,fails:0}; a.profile.events.dawn={round:0,points:{},legs:0,done:true,won:true,wins:3}; a.profile.trophies.push({kind:'licence',id:'C'},{kind:'cup',id:'dawn'},{kind:'cup',id:'fellow'},{kind:'helmet',id:'A'}); a.profile.stats.km=420; a.profile.stats.wins=4; C.addCar(a.profile,'ginga'); C.addCar(a.profile,'libeccio'); a.profile.seen.moth=true; c.kmOil=420; c.dirt=0.8;}\"\"\"\ndef MENU(place, extra='0', wait=''): return f\"\"\"(async()=>{{{SETUP}; a.ui.clear(); await a.jumpMenu('{place}'); const e=window.__PIXEL_ENGINE__; e.step(30); e.manual=false; await new Promise(r=>setTimeout(r,300)); const ui=a.ui, top=ui.top; {extra}; }})()\"\"\"\nSHOTS.update({\n 'title': \"(async()=>{const a=window.__APP__; a.ui.clear(); await a.toTitle(); })()\",\n 'map': MENU('map'),\n 'dealer': MENU('dealer'),\n 'brochure': MENU('dealer',\"top.brochure=true\"),\n 'licenceList': MENU('licence'),\n 'testCard': MENU('licence',\"ui.push(new (top.constructor.TestList)(a,'C'));\"),\n 'events': MENU('events'),\n 'tuning': MENU('tuning'),\n 'service': MENU('service'),\n 'garage': MENU('garage'),\n 'garageShelf': MENU('garage',\"top.tab=1\"),\n 'museum': MENU('museum'),\n 'theatre': MENU('theatre'),\n 'arcade': MENU('arcade'),\n})\nnames=sys.argv[1:] or list(SHOTS)'''\nassert a in s; s=s.replace(a,b)\nopen(p,'w').write(s)\nEOF\nnode tools/build.mjs | cut -c1-40 | tail -1; timeout 280 python3 tools/scratch/gallery.py cedarViaduct harbourCity harbourDusk saltStart redclayCrest rain title map dealer 2>&1 | 