file, car, me.metres, me.dirtM); car.lastWear = (me.c.wear[0] + me.c.wear[1] + me.c.wear[2] + me.c.wear[3]) / 4; }\\n\")\n# Sound: speaker-off icon and the line on the title, whenever sound is still locked.\nTi='src/game/ui/screens/title.js'\nrep(Ti,\"    if (!app.mix.audio?.unlocked && app.actions.lastDevice === 'pad') ui.text(cx, ui.h - 28, 'PRESS A KEY OR CLICK FOR SOUND', { align: 'center', color: 'mist' });\\n\",\"    if (!app.mix.audio?.unlocked) { ui.sprite(cx - 100, ui.h - 29, ['..x....', '.xx..x.', 'xxx.x.x', 'xxx..x.', 'xxx.x.x', '.xx....', '..x....'], { x: 'red' }); ui.text(cx + 4, ui.h - 28, 'PRESS A KEY OR CLICK FOR SOUND', { align: 'center', color: 'mist' }); }\\n\")\n# ---- tests ----\nSm='tools/tests/sim.mjs'\nrep(Sm,\"while (laps < 8 && g++ < 60 * 1500)\",\"while (laps < 10 && g++ < 60 * 1800)\")\nHl='tools/tests/headless.mjs'\nrep(Hl,\"t.done();\\n\",\"\"\"// The kit's own headless check: the game plays and replays to the same fingerprint.\n{ const r = spawnSync(process.execPath, ['src/check.mjs', '--headless', 'src/main.js', '--keys', 'KeyS*20', '--out', 'tools/.checkrun'], { encoding: 'utf8' }); t.eq(r.status, 0, `check.mjs --headless: ${String(r.stdout).slice(-200)}`); t.ok(/replayed to the same/.test(r.stdout), 'check.mjs replays to the same fingerprint'); rmSync('tools/.checkrun', { recursive: true, force: true }); rmSync('check', { recursive: true, force: true }); }\nt.done();\n\"\"\")\nrep(Hl,\"import { suite } from './_lib.mjs';\\n\",\"import { spawnSync } from 'node:child_process';\\nimport { rmSync } from 'node:fs';\\nimport { suite } from './_lib.mjs';\\n\")\nAu='tools/tests/audio.mjs'\nrep(Au,\"// Music at 10% is well under effects: a track's peak at 10% against a thump at full effects, rendered from the same data.\\n\",\"\"\"// Tyres squeal: a handbrake slide at speed.\nawait page.keyboard.down('KeyW'); await page.waitForTimeout(800); await page.keyboard.down('Space'); await page.keyboard.down('KeyD'); await waitFor(page, () => (window.__APP__.mix.audio.counts.tyre ?? 0) >= 1, null, 15000).catch(() => {}); await page.keyboard.up('Space'); await page.keyboard.up('KeyD'); await page.keyboard.up('KeyW');\n{ const n = await page.evaluate(() => window.__APP__.mix.audio.counts.tyre ?? 0); t.ok(n >= 1, `tyre squeal is counted: ${n}`); }\n// Music at 10% is well under effects: every song's loudest instrument, rendered and scaled to 10%, against a wall thump at full effects.\n{ const peak = (a) => { let m = 0; for (const v of a) m = Math.max(m, Math.abs(v)); return m; }, thump = peak(renderSound(SFX.thump)); for (const [id, s] of Object.entries(SONGS)) { const loudest = Math.max(...Object.values(s.tracks).map((k) => peak(renderSound({ ...k, freq: k.wave === 'noise' ? 4000 : 220, sustain: 0.1 })))); t.ok(loudest * 0.1 < thump * 0.2, `${id} at 10% is well under a thump: ${(loudest * 0.1).toFixed(3)} against ${thump.toFixed(3)}`); } }\n\"\"\")\nrep(Au,\"import { launch, open, waitFor } from './_browser.mjs';\\n\",\"import { launch, open, waitFor } from './_browser.mjs';\\nimport { renderSound } from '../../src/pixel-engine.js';\\nimport { SONGS } from '../../src/game/data/songs.js';\\nimport { SFX } from '../../src/game/audio/sfx.js';\\n\")\nBr='tools/tests/browser.mjs'\nrep(Br,\"  await page.touchscreen.tap(50, 50); await waitFor(page, () => !window.__GAME__.state().attract, null, 10000); await page.waitForTimeout(800); s = await state(page); t.eq(s.touchGate, true, 'a tap returns to the gate');\\n\",\"\"\"  await page.touchscreen.tap(50, 50); await waitFor(page, () => !window.__GAME__.state().attract, null, 10000); await page.waitForTimeout(800); s = await state(page); t.eq(s.touchGate, true, 'a tap returns to the gate');\n  await page.evaluate(() => window.dispatchEvent(new Event('gamepadconnected'))); await page.waitForTimeout(500); s = await state(page); t.eq(s.touchGate, false, 'a connected pad lifts the gate'); t.ok(s.items.includes('new'), 'and the title menu appears');\n\"\"\")\nrep(Br,\"await b.clo