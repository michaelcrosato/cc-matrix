set = new Set(cells.map(c => c[0] + ',' + c[1]));\n  return { w, h, at: (cx, cy) => set.has(cx + ',' + cy) };\"\"\",\"\"\"  const w = x - 1, h = f.h, grid = new Uint8Array(Math.max(1, w * h));\n  for (const [cx, cy] of cells) if (cx >= 0 && cx < w && cy >= 0 && cy < h) grid[cy * w + cx] = 1;\n  return { w, h, at: (cx, cy) => cx >= 0 && cy >= 0 && cx < w && cy < h && grid[cy * w + cx] === 1 };\"\"\")\ns=s.replace(\"ST.map = new E.TileMap({ rows, legend, types, floorTex: (x, y, tag) => floorTex(x, y, tag), outside: sd.surface.ground, ao: 3 });\",\"ST.map = new E.TileMap({ rows, legend, types, floorTex: (x, y, tag) => floorTex(x, y, tag), outside: sd.surface.ground, ao: 3, chunks: true });\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"chunks: true\" src/25-field.js | head -2","description":"Optimize field bitmaps and enable floor chunking"}}}
