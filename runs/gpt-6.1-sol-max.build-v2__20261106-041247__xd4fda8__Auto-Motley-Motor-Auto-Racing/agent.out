tconst c = this.drivers[0].car,\n\t\t\t\tpoints = this.world.graphPath(c, target);\n\t\t\tthis.navRoad = new M.Road({ id: \"navigation\", width: 48, points }, false);\n\t\t\tthis.drivers[0].aiS = 0;\n\t\t}\n\t\ttickDriver(D, raw, dt) {\n\t\t\tconst car = D.car,\n\t\t\t\told = { x: car.x, y: car.y, vx: car.vx, vy: car.vy },\n\t\t\t\tit = M.intent(raw);\n\t\t\tD.lastIntent = it;\n\t\t\tD.immune = Math.max(0, D.immune - dt);\n\t\t\tif (D.crashT > 0) {\n\t\t\t\tD.crashT -= dt;\n\t\t\t\tif (D.crashT <= 0) this.restore(D);\n\t\t\t\treturn { crash: false };\n\t\t\t}\n\t\t\tD.recoverHold = it.recover ? D.recoverHold + dt : 0;\n\t\t\tlet reason = D.recoverHold >= 0.65 ? \"Manual recovery\" : \"\";\n\t\t\tconst spec = D.spec.physics,\n\t\t\t\tT = this.tuning;\n\t\t\tcar.o.top = spec.top * T.speed;\n\t\t\t\t\t\t\t\ttime: s.time,\n\t\t\t\t\t\t\t\tx: d.car.x,\n\t\t\t\t\t\t\t\ty: d.car.y,\n\t\t\t\t\t\t\t\ts: d.progress.s,\n\t\t\t\t\t\t\t\taiS: d.aiS,\n\t\t\t\t\t\t\t\tq,\n\t\t\t\t\t\t\t};\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tconst D = s.drivers[0];\n\t\t\t\t\tevidence.push({\n\t\t\t\t\t\tfirstOff,\n\t\t\t\t\t\tcourse,\n\t\t\t\t\t\tcar,\n\t\t\t\t\t\tphase: s.phase,\n\t\t\t\t\t\ttime: s.time,\n\t\t\t\t\t\tlap: D.progress.laps,\n\t\t\t\t\t\tnext: D.progress.next,\n\t\t\t\t\t\tcrashes: D.crashes,\n\t\t\t\t\t\tx: D.car.x,\n\t\t\t\t\t\ty: D.car.y,\n\t\t\t\t\t\ts: D.progress.s,\n\t\t\t\t\t\taiS: D.aiS,\n\t\t\t\t\t});\n\t\t\t\t\tassert.equal(s.phase, \"finished\", JSON.stringify(evidence.at(-1)));\n\t\t\t\t\tassert.equal(D.progress.laps, 1);\n\t\t\t\t\tassert.equal(D.crashes, 0, \"AI should finish cleanly\");\n\t\t\t\t},\n\t\t\t);\n\tfs.mkdirSync(\"docs/evidence\", { recursive: true });\n\tfs.writeFileSync(\n\t\t\"docs/evidence/ai-laps.json\",\n\t\tJSON.stringify(evidence, null, 2),\n\t);\n}\n\t\tfor (let i = 0; i < 120; i++) s.step([{ gas: 1 }]);\n\t\tassert.ok(s.drivers[0].car.speed > 25);\n\t});\n\tawait test(\"partial analog brake survives normalization\", () => {\n\t\tassert.equal(