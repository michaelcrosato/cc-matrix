t all = f => { f(this); if (this.keysTo) for (const q of this.keysTo) f(q); };\n    on(window, 'keyup', e => all(q => q.release(e.code)));\n    on(window, 'blur', () => all(q => q.clear()));\n","exit_code":0,"status":"completed"}}
