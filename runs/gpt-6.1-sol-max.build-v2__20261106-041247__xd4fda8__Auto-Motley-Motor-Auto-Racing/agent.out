{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"sed -n '3650,3678p' vendor/engine/my-3d2dge.js && rg -n 'halves|keysTo|addPlayer\\\\(' vendor/engine/my-3d2dge.js | head -35 && sed -n '2540,2570p' vendor/engine/my-3d2dge.js && sed -n '891,910p' vendor/engine/my-3d2dge.js\"","aggregated_output":" *    Numpad notation names directions as the keys of a number pad, for a fighter facing right: 1 down-back, 2 down, 3\n *    down-forward, 4 back, 5 neutral, 6 forward, 7 up-back, 8 up, 9 up-forward; facing left mirrors them.\n * ============================================================================= */\nconst _DIRS = ['up', 'down', 'left', 'right'], _PAD = { 0: 5, 1: 8, 2: 2, 4: 4, 8: 6, 5: 7, 9: 9, 6: 1, 10: 3 };   // direction bits (up 1, down 2, left 4, right 8) -> numpad, facing right\nHOOKS.input.push(g => { for (const I of g._players || [g.input]) {   // (each player's own history: game.players)\n  const H = I._hist || (I._hist = []); let b = 0;\n  for (let i = 0; i < 4; i++) if (I.map[_DIRS[i]] && I.down(_DIRS[i])) b |= 1 << i;\n  if (b & 3) b = (b & 3) === 3 ? b & ~3 : b; if ((b & 12) === 12) b &= ~12;   // (both ways at once: neither)\n  const last = H[H.length - 1], pressed = [...I._now].filter(a => !_DIRS.includes(a));\n  if (!last || last._b !== b || pressed.length) H.push({ t: I.clock, dir: _PAD[b] || 5, pressed, _b: b });\n  while (H.length > 2 && H[1].t < I.clock - 1) H.shift();\n} });\n// one step of a sequence, 'down+right' or 'attack' or 'down+attack': the directions it holds (bits) and the buttons pressed\nconst _seqStep = s => { let b = 0, dirs = false; const btn = []; for (const p of String(s).split('+')) { const i = _DIRS.indexOf(p); if (i >= 0) { b |= 1 << i; dirs = true; } else if (p === 'neutral') dirs = true; else if (p) btn.push(p); } return { b, dirs, btn }; };\n/**\n * true on the step a sequence of inputs ends, each one after the last within window seconds (.5) of the first:\n * input.sequence(['down', 'down+right', 'right', 'attack']). A step names actions joined by +: its directions are held\n * exactly as it says (up, down, left, right; 'neutral' for none) as they change to that, its buttons pressed. A cheat\n * code: input.sequence(['up', 'up', 'down', 'down', 'left', 'right', 'left', 'right', 'kick', 'attack'], { window: 3 })\n */\nInput.prototype.sequence = function (steps, o = {}) {\n  const H = this._hist, n = steps.length; if (!H || !H.length || !n) return false;\n  const win = o.window === undefined ? .5 : o.window, last = H[H.length - 1], now = this.clock;\n  if (last.t !== now) return false;\n  const ok = (st, k) => { const h = H[k]; if (st.dirs && h._b !== st.b) return false; if (st.btn.length) return st.btn.every(a => h.pressed.includes(a)); return k === 0 || H[k - 1]._b !== h._b; };\n  const S = steps.map(_seqStep); let i = n - 1, k = H.length - 1; if (!ok(S[i], k)) return false;\n  if (S[i].dirs || !S[i - 1] || S[i - 1].btn.length) k--;   // (a button may land on the step its motion ends)\n  for (i--; i >= 0 && k >= 0; k--) { if (now - H[k].t > win) return false; if (ok(S[i], k)) i--; }\n  return i < 0;\n782:     *  joined player's own), or null (none); keysTo: the other players' inputs the keyboard's codes go to as well (players\n784:    this.pad = 'any'; this.keysTo = null; this._claimed = null;\n792:     *  0..1; the first that holds the finger wins), or null: a pinball's two halves, a rhythm game's lanes. A finger\n822:      const share = this.keysTo && this.keysTo.filter(q => q._codes[e.code]);   // (players sharing the keyboard: each answers to its half)\n835:    const all = f => { f(this); if (this.keysTo) for (const q of this.keysTo) f(q); };\n874:      if (!Array.isArray(map[a])) continue;   // (a preset's halves: Input.halfKeys)\n3738: *  A preset's own halves come first: preset.halves = { left: { pass: ['KeyR'] }, right: { pass: ['KeyL'] } } (an action\n3741:  const P = typeof preset === 'string' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, own = (P.halves && P.halves[side]) || {}, out  [... omitted end of long line]\n3751:  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\n3752:  if (!I.keysTo.length) I.keysTo = null;\n3832:  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n3839:    game.addPlayer({ pad: p.index });\n9062:  /** row of hearts: hp and max in hearts (halves allowed, e.g. 2.5 of 3) */\n10233:   *  2/pi) n is split in two halves whose products stay exact, good to about 1e12; past that any angle in range will do */\n12045:  /** binary space partition: halves split again down to o.min (7) cells, a room in each leaf, sisters joined */\n13958:   *  a critical hit, physical only, ignores armor; guard halves it) */\n   * open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without\n   * scenes) pauses on its pause screen; any other scene, a title, waits under the settings. menu('settings') or\n   * menu('controls') opens that screen. Without a menu (menu: false, or the agent edition) it pauses a scene in play.\n   * o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when\n   * a menu opened\n   */\n  menu(name, o) {\n    const sh = this.shell, s = this.scene, play = !!s && (!!s.pausable || this.sceneName === 'main');\n    if (o && o.pause === false && !this.paused) this._goOn = true;   // (until it resumes)\n    if (!sh || !sh._menu()) { if (play) this.pause('player'); return false; }\n    if (!name && play) { this.pause('player'); return true; }\n    if (this.pause('menu')) sh._ownPause = true;\n    sh.show(name || 'settings'); return true;\n  }\n  /** the standard features in a page (section 10b): the page set up for phones, pausing when it is hidden, the player's\n   *  full-screen choice kept, a phone's first tap going full screen, the corner buttons and the menu screens */\n  _standard(signal) {\n    const on = (t, type, fn, o) => t.addEventListener(type, fn, Object.assign({ signal }, o)), fs = this.fullscreen;\n    pageSetup(this.screen.canvas);\n    on(window, 'blur', () => this._autoPause('focus'));\n    on(document, 'visibilitychange', () => { if (document.hidden) this._autoPause('focus'); this.audio._background(document.hidden && !this.settings.background); });   // a hidden page sleeps its sound\n    on(window, 'pagehide', () => this._autoPause('focus'));\n    // held keys let go as the screen changes; a finger on the glass goes on, and a tap that has landed (the one that went full screen) counts\n    const fsChange = () => { this.input._refit(); if (this.shell && this.shell.screen) this.shell._render(); };   // (the player's choice is what they asked for: fullscreen.toggle() keeps it)\n    on(document, 'fullscreenchange', fsChange); on(document, 'webkitfullscreenchange', fsChange);\n    on(window, 'pointerup', e => {   // (a browser goes full screen only from a tap: this one, or a game started by it)\n      if (e.pointerType === 'mouse') return;\n      if (!this._fsAuto && !(e.target && e.target.closest && e.target.closest('[data-sys=\"corner\"]'))) this._fsAuto = this._autoFull();   // once until a game starts: the player who leaves it mid-game stays out\n      if (!this._guard && this.o.backGesture !== false && this._canBack() && window.top === window && history.pushState) try { history.pushState({ e3: 'back' }, ''); this._guard = true; } catch (err) { /* a sandboxed page */ }\n    }, { capture: true });\n    // the phone's back gesture (and the browser's back button, after a tap) steps back in the game before it leaves the page:\n  /** can the player rebind action a? Every action but the menu's (start, pause, confirm, cancel: they are how a player\n   *  gets back to the menu), and those the game hides with new E.Game({ menu: { controls: { a: false } } }) */\n  rebindable(a, map = this.preset) { return !!map && a in map && !(a in MENU_KEYS) && !(this.names && this.names[a] === false); }\n  /** the player's bindings over the preset: { action: { keys: [codes], pad: [codes] } } (game.settings.bindings keeps them) */\n  get bindings() { return this._bindings || {}; }\n  set bindings(b) { this._bindings = b && typeof b === 'object' ? b : {}; if (this.preset) this.use(this.preset); }\n  /**\n   * bind action a to one code for a device ('keys' = keyboard and mouse, 'pad' = gamepad), in place of that device's\n   * codes: input.rebind('attack', 'keys', 'KeyF'). Returns null when done, the action that already uses the code (nothing\n   * changes: free it first), or 'reserved' for the codes the menus keep (Escape, Enter, F keys, Start, the d-pad). The\n   * arrow keys and the d-pad always move as well\n   */\n  rebind(a, device, code) {\n    if (!this.rebindable(a) || (device !== 'keys' && device !== 'pad') || !BINDABLE.test(code) || padCode(code) !== (device === 'pad')) return 'reserved';\n    const other = Object.keys(this.map).find(b => b !== a && !(b in MENU_KEYS) && this.map[b].includes(code));\n    if (other) return other;\n    this._setBindings(Object.assign({}, this.bindings, { [a]: Object.assign({}, this.bindings[a], { [device]: [code] }) }));\n    return null;\n  }\n  /** take away action a's codes for one device ('keys' or 'pad'); the arrow keys and d-pad stay on the moves */\n","exit_code":0,"status":"completed"}}
