cene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.consumeAll(); }\n  }\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\n  if (I.pressed('pause')) game.pausedBy = 1;\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\n  for (const p of pads) {   // Start on a pad no one holds: player 1's own once it plays on it (the press that just woke it joins)\n","exit_code":0,"status":"completed"}}
