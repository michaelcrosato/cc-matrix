ff/modules/mode7.js\nvendor/engine-repo/dist/handoff/modules/rpg.js\nvendor/engine-repo/dist/handoff/modules/fight.js\nvendor/engine-repo/dist/handoff/modules/story.js\nvendor/engine-repo/dist/handoff/modules/strategy.js\nvendor/engine-repo/dist/handoff/modules/grid.js\nvendor/engine-repo/dist/handoff/modules/terrain.js\nvendor/engine-repo/dist/handoff/modules/rooms.js\nvendor/engine-repo/dist/handoff/modules/physics.js\nvendor/engine-repo/dist/handoff/modules/road.js\nvendor/engine-repo/dist/handoff/modules/gen.js\nvendor/engine-repo/dist/handoff/modules/click.js\nvendor/engine-repo/dist/handoff/kits/pointclick.html\nvendor/engine-repo/dist/handoff/kits/animlab.js\nvendor/engine-repo/dist/handoff/kits/puzzle.js\nvendor/engine-repo/dist/handoff/kits/brawler.js\nvendor/engine-repo/dist/handoff/kits/shooter.js\nvendor/engine-repo/dist/handoff/kits/stealth.js\nvendor/engine-repo/dist/handoff/kits/metroidvania.html\nvendor/engine-repo/dist/handoff/src/assets/sets/adventure.js\nvendor/engine-repo/dist/handoff/kits/sim.js\nvendor/engine-repo/dist/handoff/kits/roguelike.html\nvendor/engine-repo/dist/handoff/kits/artillery.html\nvendor/engine-repo/dist/handoff/kits/platformer.js\n","exit_code":0,"status":"completed"}}
