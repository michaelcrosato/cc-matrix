     car.update(dt,null,it);\n      if(it.brake>.1&&Math.abs(car.speed)<.8){car.vx=car.vy=car.speed=car.slide=0;}\n      const hit=this.world.collisions(car,old);\n      if(car.surface==='water')reason='Deep water';\n      if(hit.impact>=T.crash)reason=hit.reason;\n      if(hit.impact>8){D.bumped=true;if(this.tick%18===0)this.emit('bump',{driver:D.i,force:hit.impact});}\n      D.stuck=it.gas>.5&&car.speed<3?D.stuck+dt:0;\n      if(D.stuck>8)reason='Immobilized';\n      D.maxSpeed=Math.max(D.maxSpeed,car.speed);if(car.speed>20&&it.brake>.1)D.braked=true;\n      if(D.braked&&Math.abs(car.speed)<1)D.stopped=true;\n      if(car.surface==='grass')D.touchedGrass=true;if(car.surface==='gravel')D.touchedGravel=true;if(Math.abs(car.slide)>12)D.slid=true;\n      const crash=reason&&!this.config.invincible?this.incident(D,reason):false;\n      if(crash&&this.drivers.length===1){if(!['free','explore','lesson'].includes(this.config.mode)){D.penalty+=5;this.emit('penalty',{seconds:5});}}\n","exit_code":0,"status":"completed"}}
