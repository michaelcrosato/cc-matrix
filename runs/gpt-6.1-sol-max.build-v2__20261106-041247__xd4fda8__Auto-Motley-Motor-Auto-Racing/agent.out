{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"ls -lh docs/evidence && rg -n 'auto=|scenario|limit|fetch|gameUrl|gameURL|new URL' vendor/hub/harness.html | head -30 && rg -n 'play\\\\(|inputs|keydown|Pad|time-up|auto' vendor/hub/harness.html | tail -30\"","aggregated_output":"total 824K\n-rw-r--r-- 1 micha micha 6.4K Nov  6 04:22 ai-laps.json\n-rw-r--r-- 1 micha micha 2.5K Nov  6 04:40 browser-exception.txt\n-rw-r--r-- 1 micha micha  284 Nov  6 04:39 build.json\n-rw-r--r-- 1 micha micha 807K Nov  6 04:40 title.png\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n67:import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n70:const params = new URLSearchParams(location.search);\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n95:/** The game's head metas, when the page can be fetched from here. */\n98:    const html = await (await fetch(url)).text();\n117:const gameUrl = (game, { tag, seed } = {}) => {\n120:    url = new URL(game, location.href);\n163:  if (!gameUrl(game)) {\n170:  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n192:    limitMs,\n249:    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n421:    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n12:  body { display: grid; grid-template-rows: auto 1fr; }\n23:  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n26:  .cell__state { margin-left: auto; color: var(--dim); }\n29:  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n37:  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n61:    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n72:const auto = params.get('auto') === '1';\n211:    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n258:    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n302:  if (!auto && players.every((c) => ready.has(c.key))) return releaseRound(state);\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n399:  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n544:if (auto) conformance();\n","exit_code":0,"status":"completed"}}
