{"type":"item.completed","item":{"id":"item_153","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,115p' src/sim.js && cat docs/evidence/tests-core.json | head -18\"","aggregated_output":"((M, E) => {\n\tconst { clamp } = E,\n\t\tDT = M.DT;\n\tclass Progress {\n\t\tconstructor(course, s = 20) {\n\t\t\tthis.course = course;\n\t\t\tthis.laps = 0;\n\t\t\tthis.next = 1;\n\t\t\tthis.lastGate = 0;\n\t\t\tthis.s = s;\n\t\t\tthis.distance = s;\n\t\t\tthis.legal = true;\n\t\t\tthis.wrong = false;\n\t\t\tthis.splits = [];\n\t\t\tthis.lapStart = 0;\n\t\t\tthis.gatesPassed = 0;\n\t\t\tthis.offT = 0;\n\t\t}\n\t\tplace(s, lap = this.laps, gate = this.lastGate) {\n\t\t\tthis.s = s;\n\t\t\tthis.laps = lap;\n\t\t\tthis.distance = lap * this.course.length + s;\n\t\t\tthis.lastGate = gate;\n\t\t\tthis.next = (gate + 1) % this.course.gates.length;\n\t\t\tthis.legal = true;\n\t\t\tthis.offT = 0;\n\t\t}\n\t\tupdate(car, old, dt, time) {\n\t\t\tconst C = this.course,\n\t\t\t\tL = C.length,\n\t\t\t\tp = C.project(car.x, car.y, this.s, 12);\n\t\t\tlet dd = p.s - this.s;\n\t\t\tif (dd > L / 2) dd -= L;\n\t\t\tif (dd < -L / 2) dd += L;\n\t\t\tconst max =\n\t\t\t\tMath.hypot(car.x - old.x, car.y - old.y) * 1.8 +\n\t\t\t\tMath.max(2, C.width / 2 + (car.r || 7));\n\t\t\tthis.legal = p.d < C.width / 2 + 18 && Math.abs(dd) < max;\n\t\t\tthis.wrong =\n\t\t\t\tMath.cos(car.angle - p.angle) < -0.35 && Math.abs(car.speed) > 15;\n\t\t\tthis.offT = this.legal ? 0 : this.offT + dt;\n\t\t\tif (Math.abs(dd) < max) {\n\t\t\t\tthis.s = p.s;\n\t\t\t\tif (this.legal) this.distance += dd;\n\t\t\t}\n\t\t\t// A gate is a directed finite segment, crossed by the actual motion of this tick.\n\t\t\tconst g = C.gates[this.next],\n\t\t\t\tnx = Math.cos(g.angle),\n\t\t\t\tny = Math.sin(g.angle);\n\t\t\tconst a = (old.x - g.x) * nx + (old.y - g.y) * ny,\n\t\t\t\tb = (car.x - g.x) * nx + (car.y - g.y) * ny;\n\t\t\tlet lap = false,\n\t\t\t\tgate = false;\n\t\t\tif (\n\t\t\t\tthis.legal &&\n\t\t\t\ta <= 0 &&\n\t\t\t\tb > 0 &&\n\t\t\t\tb - a > 1e-7 &&\n\t\t\t\tMath.hypot(car.x - old.x, car.y - old.y) < 10\n\t\t\t) {\n\t\t\t\tconst t = -a / (b - a),\n\t\t\t\t\tx = old.x + (car.x - old.x) * t - g.x,\n\t\t\t\t\ty = old.y + (car.y - old.y) * t - g.y;\n\t\t\t\tif (\n\t\t\t\t\tMath.abs(-x * ny + y * nx) < g.half &&\n\t\t\t\t\tMath.abs(dd) < max &&\n\t\t\t\t\tdd >= -0.05\n\t\t\t\t) {\n\t\t\t\t\tthis.lastGate = this.next;\n\t\t\t\t\tthis.next = (this.next + 1) % C.gates.length;\n\t\t\t\t\tthis.gatesPassed++;\n\t\t\t\t\tgate = true;\n\t\t\t\t\tif (this.lastGate === 0) {\n\t\t\t\t\t\tthis.laps++;\n\t\t\t\t\t\tconst split = time - this.lapStart;\n\t\t\t\t\t\tthis.splits.push(split);\n\t\t\t\t\t\tthis.lapStart = time;\n\t\t\t\t\t\tlap = true;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn { gate, lap };\n\t\t}\n\t}\n\tM.intent = (raw = {}) => {\n\t\tconst number = (v, lo, hi, fallback = 0) =>\n\t\t\ttypeof v === \"number\" && Number.isFinite(v) ? clamp(v, lo, hi) : fallback;\n\t\treturn {\n\t\t\tsteer: number(raw.steer, -1, 1),\n\t\t\tgas: number(raw.gas, 0, 1),\n\t\t\tbrake: number(raw.brake, 0, 1),\n\t\t\trecover: raw.recover === true,\n\t\t\tdrift: 0,\n\t\t};\n\t};\n\tclass Simulation {\n\t\tconstructor(world, config = {}) {\n\t\t\tthis.world = world;\n\t\t\tthis.config = {\n\t\t\t\tmode: \"trial\",\n\t\t\t\tcourse: 0,\n\t\t\t\tcars: [2, 4],\n\t\t\t\tlaps: 2,\n\t\t\t\ttarget: 10,\n\t\t\t\tdifficulty: \"normal\",\n\t\t\t\tseed: 1980,\n\t\t\t\tcountdown: 3,\n\t\t\t\tcap: 180,\n\t\t\t\t...config,\n\t\t\t};\n\t\t\tthis.course = world.courses[this.config.course];\n\t\t\tthis.tuning = { ...M.DEFAULTS, ...config.tuning };\n\t\t\tthis.rng = M.namedRng(this.config.seed, \"rules\");\n\t\t\tthis.tick = 0;\n\t\t\tthis.time = 0;\n{\n  \"filter\": \"core\",\n  \"total\": 32,\n  \"failed\": 1,\n  \"outcomes\": [\n    {\n      \"name\": \"data schemas\",\n      \"pass\": true\n    },\n    {\n      \"name\": \"matching profiles identical\",\n      \"pass\": true\n    },\n    {\n      \"name\": \"i