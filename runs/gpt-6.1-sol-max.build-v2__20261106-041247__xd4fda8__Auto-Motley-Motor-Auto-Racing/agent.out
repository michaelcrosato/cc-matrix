{"type":"item.completed","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -lc \"sed -n '94,130p' vendor/hub/harness.html && sed -n '1,15p' vendor/hub/session.js && head -18 docs/evidence/ai-laps.json\"","aggregated_output":"\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n    return {\n      session: meta('hub:session'),\n      players: meta('hub:session-players'),\n      mode: meta('hub:session-mode'),\n      minutes: meta('hub:session-minutes'),\n    };\n  } catch {\n    return null;\n  }\n}\n\n/**\n * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\n * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n * address in an unsandboxed frame would run as this origin, where a signed-in player's session is kept.\n */\nconst gameUrl = (game, { tag, seed } = {}) => {\n  let url;\n  try {\n    url = new URL(game, location.href);\n  } catch {\n    return null;\n  }\n  if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return null;\n  url.searchParams.set('aihub', '1');\n  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n  return url.href;\n};\n\nfunction applyNet() {\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n[\n  {\n    \"firstOff\": null,\n    \"course\": 4,\n    \"car\": 0,\n    \"phase\": \"finished\",\n    \"time\": 182.516666666665,\n    \"lap\": 1,\n    \"next\": 1,\n    \"crashes\": 0,\n    \"x\": 5094.516187232083,\n    \"y\": 853.4564903647346,\n    \"s\": 0.49853754007367324,\n    \"aiS\": 15773.983766118326\n  },\n  {\n    \"firstOff\": null,\n    \"course\": 4,\n","exit_code":0,"status":"completed"}}
