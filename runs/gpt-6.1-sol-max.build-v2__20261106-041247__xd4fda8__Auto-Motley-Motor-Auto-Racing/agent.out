omitted end of long line]\n3859:  r.overlay(g => { for (const v of S.vps) { if (v.x > 0) px.rect(g, v.x - S.gap, v.y, S.gap, v.h, '#05040a'); if (v.y > 0) px.rect(g, v.x, v.y - S.gap, v.w, S.gap, '#05040a'); } });\n4372:   *   rig.drawPortrait(g, x, y, 40, { zoom: 3, turn: .6, bg: '#1a2050', frame: true })   // inside r.overlay(g => ...)\n4778:    const J = this.J, g = r.tgt, [ox, oy] = r.w(this.x, this.y, this.z);\n6505:    r.overlay(g => {\n8780:    if (sw.cv) { if (z > .5) this.queue(x, y, z - .01, g => { if (!g._info) sh(g); }, { bias: -.001, noInfo: true }); else this.decal(g => { if (!g._info) sh(g); }); }\n","exit_code":1,"status":"failed"}}
