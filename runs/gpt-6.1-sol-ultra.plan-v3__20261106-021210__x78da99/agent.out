bpm, steps, tracks, loop }; the core's own songs are E.songs') */\n.planner-research/engine/my-3d2dge.js:14186:- A visual novel: story.log (what was said and chosen: { who, name, text }, for a backlog), story.auto (seconds a page\n.planner-research/engine/my-3d2dge.js:14229:    /** log: what was said and chosen, oldest first ({ who, name, text }, the last 200: a visual novel's backlog) */\n.planner-research/engine/my-3d2dge.js:14280:    if (!s.event) return false;\n.planner-research/engine/my-3d2dge.js:14286:    return false;\n.planner-research/engine/my-3d2dge.js:14289:    if (!this.nodes[id]) { E.warn('story:' + id, 'E.Story: no node \"' + id + '\" (a goto)'); this._end(); return false; }\n.planner-research/engine/my-3d2dge.js:14306:    if (!this.running) return false;\n.planner-research/engine/my-3d2dge.js:14358:  /** put back what state() gave (a load) */\n.planner-research/engine/my-3d2dge.js:14376:  player: 'blue', fog: true, on: { attack(u, t), death(u), made(u), built(b), gathered(u, n), ordered(at, u) } }).\n.planner-research/engine/my-3d2dge.js:14383:- rts.order(units, kind, target, { queue }): 'move' ({ x, y }), 'attack' (a unit), 'amove' ({ x, y }: fighting what it\n.planner-research/engine/my-3d2dge.js:14386:  one flow field to it, kept apart; idle units fight what comes into sight. rts.smart(units, x, y, target): attack a foe,\n.planner-research/engine/my-3d2dge.js:14396:- rts.ai(side, { build: [['worker', 5], ['barracks'], ['soldier', 6]], waves: { first: 90, every: 75, min: 4 }, script })\n.planner-research/engine/my-3d2dge.js:14398:  workers mining nearest home and sends attack-moves at the nearest foe building; script(rts, side): a generator\n.planner-research/engine/my-3d2dge.js:14449:    /** its events: { attack, death, made, built, gathered, ordered } */\n.planner-research/engine/my-3d2dge.js:14463:  afford(side, cost) { const R = this.side(side).res; for (const k in cost || {}) if ((R[k] || 0) < cost[k]) return false; return true; }\n.planner-research/engine/my-3d2dge.js:14492:  /** give units an order: kind 'move' | 'attack' | 'amove' | 'gather' | 'build' | 'patrol' | 'stop', target ({ x, y }, a\n.planner-research/engine/my-3d2dge.js:14496:    if (kind === 'build') { const K = this.kinds[target.kind], b = list[0]; if (!b || !this.afford(b.side, K.cost)) return false; this._pay(b.side, K.cost); list.length = 1; }\n.planner-research/engine/my-3d2dge.js:14517:  /** the right click: attack a foe at the point, gather a resource, else move (o.queue as order's); a building that\n.planner-research/engine/my-3d2dge.js:14523:    if (target && units.length && this._foe(units[0], target)) return this.order(mine, 'attack', target, o);\n.planner-research/engine/my-3d2dge.js:14528:    const K = this.kinds[kind]; if (!b || b.dead || b.progress < 1 || !(b.K.makes || []).includes(kind) || b.queue.length >= 5 || !this.afford(b.side, K.cost)) return false;\n.planner-research/engine/my-3d2dge.js:14531:  /** take back the last in building's queue (refunded) */\n.planner-research/engine/my-3d2dge.js:14538:      const x = cx + i, y = cy + j; if (!this.map.walkable(x, y) || (fog && !fog.seen([x, y]))) return false;\n.planner-research/engine/my-3d2dge.js:14539:      if (this.units.some(u => u !== by && !u.building && !u.resource && Math.floor(u.x / T) === x && Math.floor(u.y / T) === y)) return false;\n.planner-research/engine/my-3d2dge.js:14575:    if (!o) { if (u.K.atk && (u._look = (u._look || 0) - dt) <= 0) { u._look = .25; const f = this._near(u, (u.K.sight || 6) * this.map.T); if (f && !u.building) u.orders.push({ kind: 'attack', target [... omitted end of long line]\n.planner-research/engine/my-3d2dge.js:14576:    if (o.kind === 'attack') { if (this._fight(u, o.target, dt)) u.orders.shift(); return; }\n.planner-research/engine/my-3d2dge.js:14578:      u._look = .25; const f = this._near(u, (u.K.sight || 6) * this.map.T); if (f) { u.orders.unshift({ kind: 'attack', target: f, idle: true }); return; }\n.planner-research/engine/my-3d2dge.js:14595:    if (this._gap(u, t) > (u.K.range || 8)) { this._go(u, t.x, t.y, t.x, t.y, dt, true); return false; }\n.planner-research/engine/my-3d2dge.js:14596:    u.face = Math.atan2(t.y - u.y, t.x - u.x); this._strike(u, t); return false;\n.planner-research/engine/my-3d2dge.js:14600:    u.cool = u.K.rate || 1; if (this.on.attack) this.on.attack(u, t);\n.planner-research/engine/my-3d2dge.js:14603:  // a worker's trips: to the resource, a load, back to the nearest depot of its side; then again, till it runs out\n.planner-research/engine/my-3d2dge.js:14665:    return false;\n.planner-research/engine/my-3d2dge.js:14691:    for (let n = 1; n <= 9; n++) {   // control groups: Ctrl+n keeps the selection, n calls it back\n.planner-research/engine/my-3d2dge.js:14716:  /* ---- the AI: a build order as data, waves of attack-moves, a script ---- */\n.planner-research/engine/my-3d2dge.js:14732:        const room = (cx, cy) => { for (let y = cy - 1; y <= cy + (K.h || 1); y++) for (let x = cx - 1; x <= cx + (K.w || 1); x++) if (!this.map.walkable(x, y)) return false; return this.canPlace(kind [... omitted end of long line]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '350,383p' .planner-research/hub/session.js && sed -n '298,325p' .planner-research/hub/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '350,383p' .planner-research/hub/session.js && sed -n '298,325p' .planner-research/hub/README.md\"","aggregated_output":"\n  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n  hub.send = function (data, opts) {\n    if (!welcomed || ended) return false;\n    opts = opts || {};\n    var text;\n    try {\n      text = JSON.stringify(data);\n    } catch (e) {\n      warn('send: data is not JSON');\n      return false;\n    }\n    if (text === undefined) return false;\n    if (text.length > limits.maxBytes) {\n      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n      return false;\n    }\n    var t = now();\n    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n    refilled = t;\n    if (tokens < 1) {\n      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n      return false;\n    }\n    tokens -= 1;\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '2320,2337p' .planner-research/engine/my-3d2dge.js && sed -n '1661,1684p' .planner-research/engine/my-3d2dge.js && rg -n -F 'hitFx(' .planner-research/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '2320,2337p' .planner-research/engine/my-3d2dge.js && sed -n '1661,1684p' .planner-research/engine/my-3d2dge.js && rg -n -F 'hitFx(' .planner-research/engine/my-3d2dge.js\"","aggregated_output":"   * - draw: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\n   * - loop: false makes a game in a page that runs only by advance()\n   * - menu: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\n   * - fullscreen: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it\n   *   off), 'button' (only when asked) or false\n   * - corner, backGesture: corner: the menu and full-screen buttons (top right); backGesture: a\n   *   phone's back steps back in the game first (false: it leaves the page)\n   * - autoPause: a pausable scene pauses when the page is hidden or loses focus\n   * - live: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it,\n   *   the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\n   * - id: the name the player's settings are saved under (the page's path)\n   * - pace: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every\n   *   other one, evenly), unless the player picks Frame rate 60\n   * - camera: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\n   */\n  constructor(o = {}) {\n    o = Object.assign({}, o);\n    /** true for a game with no display (o.headless, or no DOM: Node) */\n  /** twinkling star glints for magic, treasure and pickups */\n  glints(x, y, z, n = 5, color = '#fff6c0', spread = 10) { for (let i = 0; i < n; i++) this.add({ kind: 'glint', x: x + (Math.random() - .5) * spread, y: y + (Math.random() - .5) * spread, z: z + Math.random() * spread, vz: 6, max: .35 + Math.random() * .4, size: 1 + Math.random(), color }); }\n  /**\n   * a full explosion in one call: fireball, smoke, sparks, debris, shockwave ring, screen shake and flash, sound.\n   * explosion(x, y, z, size = 1, { debris: ['#6a5a4a'], sound: true, flash: true })\n   */\n  explosion(x, y, z, size = 1, o = {}) {\n    const G = this._game;\n    this.fire(x, y, z, Math.round(7 * size), { size: 5 * size, speed: 45 * size });\n    this.smoke(x, y, z + 4 * size, Math.round(5 * size), { size: 5 * size });\n    this.sparks(x, y, z, Math.round(10 * size));\n    if (o.debris !== false) this.bits(x, y, z, Math.round(8 * size), o.debris || ['#6a5a4a', '#3a3438', '#ffb040']);\n    this.ring(x, y, 3 * size, 26 * size, '#ffe0a0', .4, z);\n    if (o.shake !== 0) G.shake(o.shake === undefined ? 2.5 * size : o.shake); if (o.freeze !== false) G.freeze(.03 * Math.min(2, size));\n    if (o.flash !== false && size >= 1.5) G.flash('#fff4d0', .12);\n    if (o.sound !== false) G.audio.sfx(size >= 1.5 ? 'boom' : 'explode');\n  }\n}\nE.Particles = Particles;\n\n/* =============================================================================\n * 9. RENDERER  per-frame drawing API handed to your draw(r) function\n * ============================================================================= */\nconst AS = 256, AOX = 128, AOY = 200;  // scratch image per character: room for bosses up to about 250 px, capes, lying bodies\n2653:   * a damage number and a rumble on a gamepad. hitFx(x, y, z, { power: 1, angle, damage, color, sound: 'hit', rumble: true })\n2655:  hitFx(x, y, z, o = {}) {\n11655:      this.game.hitFx(b.x, 0, 8, { power: 2, color: '#ffe070', sound: 'kick' }); this.game.shake(4);\n11716:    const heavy = m.dmg >= 70; g.hitFx(x, 0, z, { power: heavy ? 1.8 : 1.1, angle: dir > 0 ? 0 : PI, color: '#ffe070', sound: heavy ? 'kick' : 'punch' });\n","exit_code":0,"status":"completed"}}
