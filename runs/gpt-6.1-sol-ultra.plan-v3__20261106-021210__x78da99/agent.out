ch/engine/my-3d2dge.js:13722:if (rpg.restore(JSON.parse(JSON.stringify(party.state()))).members[0].stat('atk') !== hero.stat('atk')) throw new Error('saved and back');\n.planner-research/engine/my-3d2dge.js:13724:Rules: ids in the save, never objects; a battle reads members' stat() and writes their hp and mp back; draw windows\n.planner-research/engine/my-3d2dge.js:13771:  /** wear item id (from inv, when given: the old piece goes back into it); false when it can't be worn or isn't there */\n.planner-research/engine/my-3d2dge.js:13773:    const it = this.rpg.item(id), slot = it && (it.slot || (SLOTS.includes(it.kind) ? it.kind : null)); if (!slot || (inv && !inv.has(id))) return false;\n.planner-research/engine/my-3d2dge.js:13774:    const old = this.equipped[slot]; if (inv) { inv.remove(id, 1); if (old && !inv.add(old, 1)) { inv.add(id, 1); return false; } }\n.planner-research/engine/my-3d2dge.js:13778:  unequip(slot, inv) { const id = this.equipped[slot]; if (!id || (inv && !inv.add(id, 1))) return false; delete this.equipped[slot]; this._fit(); return true; }\n.planner-research/engine/my-3d2dge.js:13786:  afflict(k, turns) { const s = this.rpg.status[k]; if (!s || this.dead) return false; this.effects[k] = turns !== undefined ? turns : s.turns || 0; return true; }\n.planner-research/engine/my-3d2dge.js:13810:    /** rpg: its rules; slots: how many stacks a list holds; grid: [w, h] cells, or null; entries: its stacks ({ id, n, x, y }) */\n.planner-research/engine/my-3d2dge.js:13813:  _stack(id) { const it = this.rpg.item(id); return (it && it.stack) || 99; }\n.planner-research/engine/my-3d2dge.js:13819:  /** its stacks: [{ id, n, item, x, y }] */\n.planner-research/engine/my-3d2dge.js:13823:    if (!this.rpg.item(id)) { E.warn('rpg:item:' + id, 'E.RPG: no item \"' + id + '\"'); return false; }\n.planner-research/engine/my-3d2dge.js:13824:    const st = this._stack(id), plan = []; let left = n;\n.planner-research/engine/my-3d2dge.js:13829:      if (!at) return fals