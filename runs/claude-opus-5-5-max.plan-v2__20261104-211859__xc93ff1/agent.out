PS.find(c=>c.name==='Idle');\nconsole.log('sample Idle', JSON.stringify(idle,null,0)?.slice(0,900));\nEOF\nnode inspect-rig.mjs /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211859__xc93ff1/work/_research/engine/unpacked/pixel-engine 2>&1 | head -80","description":"Print the hero rig joints, clip names and palette"}}}
