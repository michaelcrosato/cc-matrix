).cameraRig?.preset ?? e.camera.preset);\ne.input.setKey('KeyD',true); e.step(30); e.input.setKey('KeyD',false); e.step(2); log('walk', e.state().status);\ne.input.setKey('PadCross',true); e.step(6); e.input.setKey('PadCross',false); log('jump via PadCross', e.state().status, 'jumps', e.game.hero.stats.jumps);\ne.step(60);\n// Recording & fingerprint across scene\nconst end=e.fingerprint(); const rec=e.recording(); log('recording frames', rec.frames.length, 'name', rec.game ?? rec.name ?? '');\nawait e.replay(rec, ()=>e.loadGame(new B(),{camera:{preset:'iso',zoom:1.2}})); log('replay same', e.fingerprint()===end, e.state().status);\nlog('hud size headless', e.hud.width, e.hud.height, 'viewport', e.state().view ?? '');\nlog('audio', e.audio.volume, e.audio.context);\ne.audio.setVolume('music',0.1); log('after set', e.audio.volume.music);\nlog('input.pointer', e.input.pointer);\ne.input.setPointer(0.5,0.5,true); e.step(1); log('MouseLeft after setPointer down', e.input.isDown('MouseLeft'), 'buttonEvents', e.input.buttonEvents.length);\nprocess.exit(0);\nEOF\nnode headless2.mjs 2>&1 | tail -22","description":"Probe camera moves, transitions, scene loads and replays in headless Node","timeout":120000}},"wire_ingest_context":{"toolu_01H6AhW9QtWJEtUbxx4U2nbV":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211859__xc93ff1/work/_research/spike"}}}
