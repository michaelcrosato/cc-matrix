{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9Ub8mwwuzCZz5NPPtA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WxzJiBxYXCZbeQNrko3v3k","name":"Bash","input":{"command":"mkdir -p /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211859__xc93ff1/work/_research/spike/src && cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211859__xc93ff1/work/_research/spike && cat > src/game.js <<'EOF'\n// Spike: can one html hold engine + game on file://, with custom clips, re-dressed avatars, data models and a ghost session?\nimport { buildModel, compileClips, ContactShadow, Engine, HERO_CLIPS, HERO_MODEL, HERO_RIG, LOOK_PRESETS, mergeStaticMeshes, model, ModelCatalog, MODEL_LIBRARY, PALETTE, placeFeet, setLookLayer, THREE, toonMaterial, withUrlOptions, validateClip, WaterSurface, WAVES_CALM, applySky, skyAt } from '../pixel-engine.js';\nconst { AnimationMixer, BoxGeometry, CylinderGeometry, Color, Group, Mesh, SphereGeometry, Vector3 } = THREE;\n\nexport const ounce = model({\n  id: 'ounce', about: 'A retro bathroom scale with a dial face', tags: ['character'], floats: false,\n  palette: { body: 'cyan', trim: 'white', dial: 'white', mark: 'ink', needle: 'red', foot: 'slate', eye: 'ink' },\n  parts: [\n    { name: 'plate', box: [0.9, 0.16, 0.9], at: [0, 0.14, 0], c: 'body' },\n    { box: [0.96, 0.06, 0.96], at: [0, 0.03, 0], c: 'foot' },\n    { name: 'tread', box: [0.74, 0.03, 0.42], at: [0, 0.235, -0.16], c: 'trim' },\n    { name: 'dialbox', cyl: [0.5, 0.2, 0.5], at: [0, 0.34, 0.3], rot: [62, 0, 0], c: 'trim', seg: 12 },\n    { name: 'dialface', cyl: [0.4, 0.04, 0.4], at: [0, 0.42, 0.355], rot: [62, 0, 0], c: 'dial', seg: 12 },\n    { name: 'needle', box: [0.035, 0.03, 0.17], at: [0, 0.46, 0.39], rot: [62, 0, 0], c: 'needle' },\n    { mirror: [{ name: 'eye', box: [0.07, 0.1, 0.04], at: [0.11, 0.56, 0.2], c: 'eye' }], axis: 'x' },\n  ],\n});\nexport const kettleVolcano = model({\n  id: 'kettle-volcano', about: 'A kettlebell the size of a volcano', tags: ['scenery'],\n  palette: { iron: 'slate', iron2: 'night', lava: 'orange' },\n  parts: [\n    { name: 'ball', ball: [14, 10, 14], at: [0, 5, 0], c: 'iron' },\n    { name: 'handle', torus: [10, 2.2, 3], at: [0, 12, 0], rot: [90, 0, 0], c: 'iron2' },\n    { cyl: [5, 1, 5], at: [0, 9.8, 0], c: 'lava', glow: true },\n  ],\n});\nexport const roller = model({ id: 'roller-hill', about: 'A foam roller as big as a hill', tags: ['scenery'],\n  palette: { foam: 'lime', foam2: 'green' },\n  parts: [ { cyl: [4, 9, 4], at: [0, 2, 0], rot: [0, 0, 90], c: 'foam', seg: 10 }, { cyl: [4.1, 1, 4.1], at: [-3, 2, 0], rot: [0, 0, 90], c: 'foam2', seg: 10 }, { cyl: [4.1, 1, 4.1], at: [3, 2, 0], rot: [0, 0, 90], c: 'foam2', seg: 10 } ] });\nconst MODELS = new ModelCatalog([...MODEL_LIBRARY.all(), ounce, kettleVolcano, roller]);\n\nconst STAND = placeFeet({ Pelvis: { p: [0, -0.02, 0] }, ArmR: [6, 0, -9], ArmL: [6, 0, 9] }, HERO_RIG, { R: { z: 0 }, L: { z: 0 } });\nexport const CLIPS = [\n  { name: 'PoseTree', frames: 60, loop: true, keys: [\n    [0, { Pelvis: { p: [0.03, -0.02, 0] }, Torso: [0, 0, 0], Head: [0, 0, 0], ArmR: [-172, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-172, 0, 6], ForearmL: [-14, 0, 0], LegR: [-62, 0, -58], ShinR: [150, 0, 0], FootR: [30, 0, 0], LegL: [0, 0, 0], ShinL: [0, 0, 0], FootL: [0, 0, 0] }],\n    [60, { Pelvis: { p: [0.03, -0.02, 0] }, Torso: [0, 0, 0], Head: [0, 0, 0], ArmR: [-172, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-172, 0, 6], ForearmL: [-14, 0, 0], LegR: [-62, 0, -58], ShinR: [150, 0, 0], FootR: [30, 0, 0], LegL: [0, 0, 0], ShinL: [0, 0, 0], FootL: [0, 0, 0] }],\n  ]},\n  { name: 'PoseWarrior', frames: 60, loop: true, keys: [\n    [0, placeFeet({ Pelvis: { p: [0, -0.2, 0] }, Torso: [0, 25, 0], Head: [0, 40, 0], ArmR: [0, 0, -90], ArmL: [0, 0, 90], ForearmR: [0, 0, 0], ForearmL: [0, 0, 0] }, HERO_RIG, { R: { z: 0.38 }, L: { z: -0.38 } })],\n    [60, placeFeet({ Pelvis: { p: [0, -0.2, 0] }, Torso: [0, 25, 0], Head: [0, 40, 0], ArmR: [0, 0, -90], ArmL: [0, 0, 90], ForearmR: [0, 0, 0], ForearmL: [0, 0, 0] }, HERO_RIG, { R: { z: 0.38 }, L: { z: -0.38 } })],\n  ]},\n  { name: 'RepSquat', frames: 30, loop: false, grounded: true, keys: [\n    [0, placeFeet({ Pelvis: { p: [0, -0.02, 0] }, Torso: [2, 0, 0], ArmR: [6, 0, -9], ArmL: [6, 0, 9] }, HERO_RIG, { R: { z: 0 }, L: { z: 0 } })],\n    [30, placeFeet({ Pelvis: { p: [0, -0.32, -0.08] }, Torso: [28, 0, 0], Head: [-20, 0, 0], ArmR: [-85, 0, -8], ArmL: [-85, 0, 8] }, HERO_RIG, { R: { z: 0 }, L: { z: 0 } })],\n  ]},\n  { name: 'PoseDog', frames: 60, loop: true, keys: [\n    [0, { Pelvis: { r: [125, 0, 0], p: [0, -0.1, -0.1] }, Torso: [0, 0, 0], Head: [-20, 0, 0], ArmR: [-170, 0, -6], ArmL: [-170, 0, 6], LegR: [-120, 0, 0], LegL: [-120, 0, 0], ShinR: [0, 0, 0], ShinL: [0, 0, 0], FootR: [40, 0, 0], FootL: [40, 0, 0] }],\n    [60, { Pelvis: { r: [125, 0, 0], p: [0, -0.1, -0.1] }, Torso: [0, 0, 0], Head: [-20, 0, 0], ArmR: [-170, 0, -6], ArmL: [-170, 0, 6], LegR: [-120, 0, 0], LegL: [-120, 0, 0], ShinR: [0, 0, 0], ShinL: [0, 0, 0], FootR: [40, 0, 0], FootL: [40, 0, 0] }],\n  ]},\n];\nfor (const c of CLIPS) { const p = validateClip(c, HERO_RIG); if (p.length) console.warn(c.name, p); }\n\n// Re-dress the hero: same rig, other clothes.\nfunction dress(root, look) {\n  const hide = new Set(['Moustache', 'ButtonR', 'ButtonL', 'Hat', 'Brim', ...(look.hide || [])]);\n  root.traverse((o) => {\n    if (!o.isMesh) return;\n    if (hide.has(o.name)) { o.visible = false; return; }\n    const slot = { Overalls: 'bottom', ThighR: 'bottom', ThighL: 'bottom', ShinR_Mesh: 'skin', ShinL_Mesh: 'skin', Shirt: 'top', SleeveR: 'top', SleeveL: 'top', ForearmR_Mesh: 'skin', ForearmL_Mesh: 'skin', GloveR: 'skin', GloveL: 'skin', Face: 'skin', Nose: 'skin', ShoeR: 'shoe', ShoeL: 'shoe' }[o.name];\n    if (slot) o.material = toonMaterial(PALETTE[look[slot]]);\n  });\n  // A hair piece on the Head joint.\n  let head = null; root.traverse((o) => { if (o.name === 'Head') head = o; });\n  if (head) {\n    const hair = new Mesh(new BoxGeometry(0.46, 0.14, 0.42), toonMaterial(PALETTE[look.hair]));\n    hair.position.set(0, 0.32 + (look.hairUp || 0), -0.02);\n    head.add(hair);\n    if (look.bun) { const bun = new Mesh(new SphereGeometry(0.1, 8, 6), toonMaterial(PALETTE[look.hair])); bun.position.set(0, 0.44, -0.12); head.add(bun); }\n  }\n}\n\nconst LOOKS = [\n  { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' },\n  { skin: 'orange', top: 'lime', bottom: 'teal', shoe: 'white', hair: 'plum' },\n  { skin: 'sand', top: 'cyan', bottom: 'navy', shoe: 'white', hair: 'mist', bun: true },\n  { skin: 'orange', top: 'orange', bottom: 'slate', shoe: 'white', hair: 'red' },\n];\n\nclass Spike {\n  name = 'Spike';\n  assets = [HERO_MODEL];\n  target = new Vector3(0, 1.0, 0);\n  avatars = [];\n  dot = { x: 0, y: 0 };\n  async setup(ctx) {\n    const { scene, physics, palette } = ctx;\n    const params = new URLSearchParams(typeof location !== 'undefined' ? location.search : '');\n    scene.background = new Color(PALETTE.sky);\n    const parts = [];\n    const floor = new Mesh(new BoxGeometry(40, 1, 22), toonMaterial(palette.white));\n    floor.position.set(0, -0.5, -4); floor.receiveShadow = true; parts.push(floor);\n    physics.addStaticBox({ position: [0, -0.5, -4], halfExtents: [20, 0.5, 11] });\n    for (let i = 0; i < 4; i++) {\n      const mat = new Mesh(new BoxGeometry(1.1, 0.04, 1.7), toonMaterial([palette.cyan, palette.lime, palette.sand, palette.orange][i]));\n      mat.position.set(-3 + i * 2, 0.02, 0); mat.receiveShadow = true; parts.push(mat);\n    }\n    scene.add(...mergeStaticMeshes(parts));\n    const water = new WaterSurface({ size: [60, 26], at: [0, -0.3, -24], waves: WAVES_CALM });\n    scene.add(water); this.water = water;\n    const place = (id, at, yaw = 0, o = {}) => { const m = buildModel(id, { catalog: MODELS, ...o }); m.object.position.set(...at); m.object.rotation.y = yaw; scene.add(m.object); return m; };\n    place('kettle-volcano', [8, 0, -22]);\n    place('roller-hill', [-9, 0, -13], 0.4);\n    place('oak', [-14, 0, -8]); place('bush', [12, 0, -9]); place('lamp-post', [-6, 0, -6]); place('bench', [6, 0, -7]);\n    this.ounce = place('ounce', [4.8, 0, 0.3], -0.35);\n    setLookLayer(this.ounce.object, 'actors');\n    for (let i = 0; i < 4; i++) {\n      const m = await ctx.loadModel(HERO_MODEL, { castShadow: true });\n      dress(m.scene, LOOKS[i]);\n      setLookLayer(m.scene, 'actors');\n      m.scene.position.set(-3 + i * 2, 0, 0);\n      scene.add(m.scene);\n      const clips = compileClips(CLIPS, HERO_RIG, m.scene);\n      const mixer = new AnimationMixer(m.scene);\n      const pick = ['PoseTree', 'PoseWarrior', 'PoseDog', 'RepSquat'][i];\n      const action = mixer.clipAction(clips.find((c) => c.name === pick));\n      if (pick === 'RepSquat') { action.play(); action.paused = true; }\n      else action.play();\n      this.avatars.push({ root: m.scene, mixer, action, scrub: pick === 'RepSquat' });\n      const s = new ContactShadow(0.42); s.place(-3 + i * 2, 0.04, 0, 0); scene.add(s);\n    }\n    window.__SPIKE__ = this;\n  }\n  fixedUpdate(ctx, dt) {\n    const a = ctx.input.moveAxis();\n    this.dot.x += (a.x - this.dot.x) * Math.min(1, dt * 8);\n    this.dot.y += (a.y - this.dot.y) * Math.min(1, dt * 8);\n  }\n  update(ctx, dt) {\n    this.water.update(ctx.time);\n    for (const av of this.avatars) {\n      if (av.scrub) { av.action.time = (Math.sin(ctx.time * 1.5) * 0.5 + 0.5) * av.action.getClip().duration; av.mixer.update(0); }\n      else av.mixer.update(dt);\n    }\n    const hud = ctx.hud; hud.clear();\n    const W = hud.width, H = hud.height;\n    hud.rect(0, 0, W, 34, 'white', 'bottom-left');\n    hud.text(8, 8, 'OUNCE:', { anchor: 'bottom-left', color: 'teal', shadow: false });\n    hud.text(8, 18, 'YOUR KNEES HAVE FEELINGS TOO. HAVE YOU ASKED THEM?', { anchor: 'bottom-left', color: 'ink', shadow: false, scale: 1 });\n    hud.text(0, 8, 'WOBBLE AGE 71', { anchor: 'top', scale: 2, color: 'ink', shadow: 'white' });\n    // Lowercase glyph test via sprites\n    const glyph = { g: ['.....','.....','.oooo','o...o','.oooo','....o','.ooo.'], o: ['.....','.....','.ooo.','o...o','o...o','o...o','.ooo.'], d: ['....o','....o','.oooo','o...o','o...o','o...o','.oooo'] };\n    let x = 8; for (const ch of 'good') { hud.sprite(x, 8, glyph[ch], { o: 'ink' }); x += 6; }\n    hud.text(0, 4, `${W}x${H}`, { anchor: 'top-right', color: 'ink', shadow: false });\n  }\n  cameraTarget() { return this.target; }\n  status() { return `spike avatars ${this.avatars.length}`; }\n}\n\n// ---- session glue ----\nasync function main() {\n  const params = new URLSearchParams(location.search);\n  let info = null;\n  if (window.AIHub && AIHub.active) {\n    info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n  }\n  const look = params.get('lk');\n  const options = withUrlOptions({ container: document.getElementById('app'), seed: info ? info.seed : 1, touch: false,\n    settings: { button: false }, background: PALETTE.sky,\n    camera: { preset: 'fixed', position: [0, 3.0, 9.5], target: [0, 1.0, 0], fov: 32 },\n    look: look ? LOOK_PRESETS[look] : undefined });\n  const engine = await Engine.start(new Spike(), options);\n  window.__ENGINE__ = engine;\n  if (info) {\n    let t = 0, sent = 0;\n    AIHub.on('card', (c) => { window.__CARD__ = c; });\n    addEventListener('keydown', (e) => { if (e.code === 'Enter' || e.key === 'Enter') AIHub.answer('ready'); });\n    AIHub.on('message', (data, from) => { window.__GHOST__ = { data, from }; });\n    let done = false; const report = () => { if (!done) { done = true; AIHub.result({ score: Math.round(engine.time * 10), stats: { wobble: 1 } }); } };\n    AIHub.on('time-up', report);\n    AIHub.on('end', () => { engine.audio.setMuted(true); done = true; window.__ENDED__ = true; });\n    setInterval(() => { if (AIHub.time() >= 0 && !done) { AIHub.progress({ score: Math.round(engine.time * 10), label: 'ok' }); AIHub.send({ x: Math.sin(t += 0.1), s: ++sent }, { reliable: false }); } }, 100);\n    AIHub.ready();\n  }\n}\nif (typeof document !== 'undefined') main().catch((e) => { console.error(e); if (window.AIHub) AIHub.fail(String(e)); });\nexport const createGame = () => new Spike();\nEOF\ncat > build.mjs <<'EOF'\n// usage: node build.mjs <esbuild path or 'esbuild'>; writes dist/spike.html from src/game.js + pixel-engine.js + session.js\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync, writeFileSync, mkdirSync } from 'node:fs';\nmkdirSync('dist', { recursive: true });\nexecFileSync('esbuild', ['src/game.js', '--bundle', '--format=esm', '--platform=browser', '--target=esnext', '--charset=utf8', '--outfile=dist/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\nconst js = readFileSync('dist/bundle.js', 'utf8');\nconst session = readFileSync('../hub/session.js', 'utf8');\nconst safe = (s) => s.replace(/<\\/script/gi, '<\\\\/script').replace(/<!--/g, '<\\\\!--');\nconst html = `<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<script>${session}</script>\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Highest balance score wins\">\n<meta name=\"hub:session-howto\" content=\"Left stick or WASD or mouse: lean\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:webgpu\" content=\"required\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<link rel=\"icon\" href=\"data:,\">\n<title>Spike</title>\n<style>html, body { margin: 0; height: 100%; background: #0d0b14; } #app { position: fixed; inset: 0; }</style>\n</head>\n<body>\n<div id=\"app\"></div>\n<script type=\"module\">${safe(js)}</script>\n</body>\n</html>`;\nwriteFileSync('dist/spike.html', html);\nconsole.log('html bytes', html.length, 'bundle', js.length, 'engine', readFileSync('pixel-engine.js').length);\nEOF\nnode build.mjs && ls -la dist","description":"Write and build the single-file spike game"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5033,"cache_read_input_tokens":192500,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5033},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"35b0c7f2-b636-4810-bb2b-a989930a5e0b","uuid":"ff248e40-72be-45bc-bcf3-663c8646805a","timestamp":"2026-11-05T04:27:02.210Z","request_id":"req_011Cgj9Uatdek55pJmyR36FA","wire_tool_inputs":{"toolu_01WxzJiBxYXCZbeQNrko3v3k":{"command":"mkdir -p /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211859__xc93ff1/work/_research/spike/src && cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211859__xc93ff1/work/_research/spike && cat > src/game.js <<'EOF'\n// Spike: can one html hold engine + game on file://, with custom clips, re-dressed avatars, data models and a ghost session?\nimport { buildModel, compileClips, ContactShadow, Engine, HERO_CLIPS, HERO_MODEL, HERO_RIG, LOOK_PRESETS, mergeStaticMeshes, model, ModelCatalog, MODEL_LIBRARY, PALETTE, placeFeet, setLookLayer, THREE, toonMaterial, withUrlOptions, validateClip, WaterSurface, WAVES_CALM, applySky, skyAt } from '../pixel-engine.js';\nconst { AnimationMixer, BoxGeometry, CylinderGeometry, Color, Group, Mesh, SphereGeometry, Vector3 } = THREE;\n\nexport const ounce = model({\n  id: 'ounce', about: 'A retro bathroom scale with a dial face', tags: ['character'], floats: false,\n  palette: { body: 'cyan', trim: 'white', dial: 'white', mark: 'ink', needle: 'red', foot: 'slate', eye: 'ink' },\n  parts: [\n    { name: 'plate', box: [0.9, 0.16, 0.9], at: [0, 0.14, 0], c: 'body' },\n    { box: [0.96, 0.06, 0.96], at: [0, 0.03, 0], c: 'foot' },\n    { name: 'tread', box: [0.74, 0.03, 0.42], at: [0, 0.235, -0.16], c: 'trim' },\n    { name: 'dialbox', cyl: [0.5, 0.2, 0.5], at: [0, 0.34, 0.3], rot: [62, 0, 0], c: 'trim', seg: 12 },\n    { name: 'dialface', cyl: [0.4, 0.04, 0.4], at: [0, 0.42, 0.355], rot: [62, 0, 0], c: 'dial', seg: 12 },\n    { name: 'needle', box: [0.035, 0.03, 0.17], at: [0, 0.46, 0.39], rot: [62, 0, 0], c: 'needle' },\n    { mirror: [{ name: 'eye', box: [0.07, 0.1, 0.04], at: [0.11, 0.56, 0.2], c: 'eye' }], axis: 'x' },\n  ],\n});\nexport const kettleVolcano = model({\n  id: 'kettle-volcano', about: 'A kettlebell the size of a volcano', tags: ['scenery'],\n  palette: { iron: 'slate', iron2: 'night', lava: 'orange' },\n  parts: [\n    { name: 'ball', ball: [14, 10, 14], at: [0, 5, 0], c: 'iron' },\n    { name: 'handle', torus: [10, 2.2, 3], at: [0, 12, 0], rot: [90, 0, 0], c: 'iron2' },\n    { cyl: [5, 1, 5], at: [0, 9.8, 0], c: 'lava', glow: true },\n  ],\n});\nexport const roller = model({ id: 'roller-hill', about: 'A foam roller as big as a hill', tags: ['scenery'],\n  palette: { foam: 'lime', foam2: 'green' },\n  parts: [ { cyl: [4, 9, 4], at: [0, 2, 0], rot: [0, 0, 90], c: 'foam', seg: 10 }, { cyl: [4.1, 1, 4.1], at: [-3, 2, 0], rot: [0, 0, 90], c: 'foam2', seg: 10 }, { cyl: [4.1, 1, 4.1], at: [3, 2, 0], rot: [0, 0, 90], c: 'foam2', seg: 10 } ] });\nconst MODELS = new ModelCatalog([...MODEL_LIBRARY.all(), ounce, kettleVolcano, roller]);\n\nconst STAND = placeFeet({ Pelvis: { p: [0, -0.02, 0] }, ArmR: [6, 0, -9], ArmL: [6, 0, 9] }, HERO_RIG, { R: { z: 0 }, L: { z: 0 } });\nexport const CLIPS = [\n  { name: 'PoseTree', frames: 60, loop: true, keys: [\n    [0, { Pelvis: { p: [0.03, -0.02, 0] }, Torso: [0, 0, 0], Head: [0, 0, 0], ArmR: [-172, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-172, 0, 6], ForearmL: [-14, 0, 0], LegR: [-62, 0, -58], ShinR: [150, 0, 0], FootR: [30, 0, 0], LegL: [0, 0, 0], ShinL: [0, 0, 0], FootL: [0, 0, 0] }],\n    [60, { Pelvis: { p: [0.03, -0.02, 0] }, Torso: [0, 0, 0], Head: [0, 0, 0], ArmR: [-172, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-172, 0, 6], ForearmL: [-14, 0, 0], LegR: [-62, 0, -58], ShinR: [150, 0, 0], FootR: [30, 0, 0], LegL: [0, 0, 0], ShinL: [0, 0, 0], FootL: [0, 0, 0] }],\n  ]},\n  { name: 'PoseWarrior', frames: 60, loop: true, keys: [\n    [0, placeFeet({ Pelvis: { p: [0, -0.2, 0] }, Torso: [0, 25, 0], Head: [0, 40, 0], ArmR: [0, 0, -90], ArmL: [0, 0, 90], ForearmR: [0, 0, 0], ForearmL: [0, 0, 0] }, HERO_RIG, { R: { z: 0.38 }, L: { z: -0.38 } })],\n    [60, placeFeet({ Pelvis: { p: [0, -0.2, 0] }, Torso: [0, 25, 0], Head: [0, 40, 0], ArmR: [0, 0, -90], ArmL: [0, 0, 90], ForearmR: [0, 0, 0], ForearmL: [0, 0, 0] }, HERO_RIG, { R: { z: 0.38 }, L: { z: -0.38 } })],\n  ]},\n  { name: 'RepSquat', frames: 30, loop: false, grounded: true, keys: [\n    [0, placeFeet({ Pelvis: { p: [0, -0.02, 0] }, Torso: [2, 0, 0], ArmR: [6, 0, -9], ArmL: [6, 0, 9] }, HERO_RIG, { R: { z: 0 }, L: { z: 0 } })],\n    [30, placeFeet({ Pelvis: { p: [0, -0.32, -0.08] }, Torso: [28, 0, 0], Head: [-20, 0, 0], ArmR: [-85, 0, -8], ArmL: [-85, 0, 8] }, HERO_RIG, { R: { z: 0 }, L: { z: 0 } })],\n  ]},\n  { name: 'PoseDog', frames: 60, loop: true, keys: [\n    [0, { Pelvis: { r: [125, 0, 0], p: [0, -0.1, -0.1] }, Torso: [0, 0, 0], Head: [-20, 0, 0], ArmR: [-170, 0, -6], ArmL: [-170, 0, 6], LegR: [-120, 0, 0], LegL: [-120, 0, 0], ShinR: [0, 0, 0], ShinL: [0, 0, 0], FootR: [40, 0, 0], FootL: [40, 0, 0] }],\n    [60, { Pelvis: { r: [125, 0, 0], p: [0, -0.1, -0.1] }, Torso: [0, 0, 0], Head: [-20, 0, 0], ArmR: [-170, 0, -6], ArmL: [-170, 0, 6], LegR: [-120, 0, 0], LegL: [-120, 0, 0], ShinR: [0, 0, 0], ShinL: [0, 0, 0], FootR: [40, 0, 0], FootL: [40, 0, 0] }],\n  ]},\n];\nfor (const c of CLIPS) { const p = validateClip(c, HERO_RIG); if (p.length) console.warn(c.name, p); }\n\n// Re-dress the hero: same rig, other clothes.\nfunction dress(root, look) {\n  const hide = new Set(['Moustache', 'ButtonR', 'ButtonL', 'Hat', 'Brim', ...(look.hide || [])]);\n  root.traverse((o) => {\n    if (!o.isMesh) return;\n    if (hide.has(o.name)) { o.visible = false; return; }\n    const slot = { Overalls: 'bottom', ThighR: 'bottom', ThighL: 'bottom', ShinR_Mesh: 'skin', ShinL_Mesh: 'skin', Shirt: 'top', SleeveR: 'top', SleeveL: 'top', ForearmR_Mesh: 'skin', ForearmL_Mesh: 'skin', GloveR: 'skin', GloveL: 'skin', Face: 'skin', Nose: 'skin', ShoeR: 'shoe', ShoeL: 'shoe' }[o.name];\n    if (slot) o.material = toonMaterial(PALETTE[look[slot]]);\n  });\n  // A hair piece on the Head joint.\n  let head = null; root.traverse((o) => { if (o.name === 'Head') head = o; });\n  if (head) {\n    const hair = new Mesh(new BoxGeometry(0.46, 0.14, 0.42), toonMaterial(PALETTE[look.hair]));\n    hair.position.set(0, 0.32 + (look.hairUp || 0), -0.02);\n    head.add(hair);\n    if (look.bun) { const bun = new Mesh(new SphereGeometry(0.1, 8, 6), toonMaterial(PALETTE[look.hair])); bun.position.set(0, 0.44, -0.12); head.add(bun); }\n  }\n}\n\nconst LOOKS = [\n  { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' },\n  { skin: 'orange', top: 'lime', bottom: 'teal', shoe: 'white', hair: 'plum' },\n  { skin: 'sand', top: 'cyan', bottom: 'navy', shoe: 'white', hair: 'mist', bun: true },\n  { skin: 'orange', top: 'orange', bottom: 'slate', shoe: 'white', hair: 'red' },\n];\n\nclass Spike {\n  name = 'Spike';\n  assets = [HERO_MODEL];\n  target = new Vector3(0, 1.0, 0);\n  avatars = [];\n  dot = { x: 0, y: 0 };\n  async setup(ctx) {\n    const { scene, physics, palette } = ctx;\n    const params = new URLSearchParams(typeof location !== 'undefined' ? location.search : '');\n    scene.background = new Color(PALETTE.sky);\n    const parts = [];\n    const floor = new Mesh(new BoxGeometry(40, 1, 22), toonMaterial(palette.white));\n    floor.position.set(0, -0.5, -4); floor.receiveShadow = true; parts.push(floor);\n    physics.addStaticBox({ position: [0, -0.5, -4], halfExtents: [20, 0.5, 11] });\n    for (let i = 0; i < 4; i++) {\n      const mat = new Mesh(new BoxGeometry(1.1, 0.04, 1.7), toonMaterial([palette.cyan, palette.lime, palette.sand, palette.orange][i]));\n      mat.position.set(-3 + i * 2, 0.02, 0); mat.receiveShadow = true; parts.push(mat);\n    }\n    scene.add(...mergeStaticMeshes(parts));\n    const water = new WaterSurface({ size: [60, 26], at: [0, -0.3, -24], waves: WAVES_CALM });\n    scene.add(water); this.water = water;\n    const place = (id, at, yaw = 0, o = {}) => { const m = buildModel(id, { catalog: MODELS, ...o }); m.object.position.set(...at); m.object.rotation.y = yaw; scene.add(m.object); return m; };\n    place('kettle-volcano', [8, 0, -22]);\n    place('roller-hill', [-9, 0, -13], 0.4);\n    place('oak', [-14, 0, -8]); place('bush', [12, 0, -9]); place('lamp-post', [-6, 0, -6]); place('bench', [6, 0, -7]);\n    this.ounce = place('ounce', [4.8, 0, 0.3], -0.35);\n    setLookLayer(this.ounce.object, 'actors');\n    for (let i = 0; i < 4; i++) {\n      const m = await ctx.loadModel(HERO_MODEL, { castShadow: true });\n      dress(m.scene, LOOKS[i]);\n      setLookLayer(m.scene, 'actors');\n      m.scene.position.set(-3 + i * 2, 0, 0);\n      scene.add(m.scene);\n      const clips = compileClips(CLIPS, HERO_RIG, m.scene);\n      const mixer = new AnimationMixer(m.scene);\n      const pick = ['PoseTree', 'PoseWarrior', 'PoseDog', 'RepSquat'][i];\n      const action = mixer.clipAction(clips.find((c) => c.name === pick));\n      if (pick === 'RepSquat') { action.play(); action.paused = true; }\n      else action.play();\n      this.avatars.push({ root: m.scene, mixer, action, scrub: pick === 'RepSquat' });\n      const s = new ContactShadow(0.42); s.place(-3 + i * 2, 0.04, 0, 0); scene.add(s);\n    }\n    window.__SPIKE__ = this;\n  }\n  fixedUpdate(ctx, dt) {\n    const a = ctx.input.moveAxis();\n    this.dot.x += (a.x - this.dot.x) * Math.min(1, dt * 8);\n    this.dot.y += (a.y - this.dot.y) * Math.min(1, dt * 8);\n  }\n  update(ctx, dt) {\n    this.water.update(ctx.time);\n    for (const av of this.avatars) {\n      if (av.scrub) { av.action.time = (Math.sin(ctx.time * 1.5) * 0.5 + 0.5) * av.action.getClip().duration; av.mixer.update(0); }\n      else av.mixer.update(dt);\n    }\n    const hud = ctx.hud; hud.clear();\n    const W = hud.width, H = hud.height;\n    hud.rect(0, 0, W, 34, 'white', 'bottom-left');\n    hud.text(8, 8, 'OUNCE:', { anchor: 'bottom-left', color: 'teal', shadow: false });\n    hud.text(8, 18, 'YOUR KNEES HAVE FEELINGS TOO. HAVE YOU ASKED THEM?', { anchor: 'bottom-left', color: 'ink', shadow: false, scale: 1 });\n    hud.text(0, 8, 'WOBBLE AGE 71', { anchor: 'top', scale: 2, color: 'ink', shadow: 'white' });\n    // Lowercase glyph test via sprites\n    const glyph = { g: ['.....','.....','.oooo','o...o','.oooo','....o','.ooo.'], o: ['.....','.....','.ooo.','o...o','o...o','o...o','.ooo.'], d: ['....o','....o','.oooo','o...o','o...o','o...o','.oooo'] };\n    let x = 8; for (const ch of 'good') { hud.sprite(x, 8, glyph[ch], { o: 'ink' }); x += 6; }\n    hud.text(0, 4, `${W}x${H}`, { anchor: 'top-right', color: 'ink', shadow: false });\n  }\n  cameraTarget() { return this.target; }\n  status() { return `spike avatars ${this.avatars.length}`; }\n}\n\n// ---- session glue ----\nasync function main() {\n  const params = new URLSearchParams(location.search);\n  let info = null;\n  if (window.AIHub && AIHub.active) {\n    info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n  }\n  const look = params.get('lk');\n  const options = withUrlOptions({ container: document.getElementById('app'), seed: info ? info.seed : 1, touch: false,\n    settings: { button: false }, background: PALETTE.sky,\n    camera: { preset: 'fixed', position: [0, 3.0, 9.5], target: [0, 1.0, 0], fov: 32 },\n    look: look ? LOOK_PRESETS[look] : undefined });\n  const engine = await Engine.start(new Spike(), options);\n  window.__ENGINE__ = engine;\n  if (info) {\n    let t = 0, sent = 0;\n    AIHub.on('card', (c) => { window.__CARD__ = c; });\n    addEventListener('keydown', (e) => { if (e.code === 'Enter' || e.key === 'Enter') AIHub.answer('ready'); });\n    AIHub.on('message', (data, from) => { window.__GHOST__ = { data, from }; });\n    let done = false; const report = () => { if (!done) { done = true; AIHub.result({ score: Math.round(engine.time * 10), stats: { wobble: 1 } }); } };\n    AIHub.on('time-up', report);\n    AIHub.on('end', () => { engine.audio.setMuted(true); done = true; window.__ENDED__ = true; });\n    setInterval(() => { if (AIHub.time() >= 0 && !done) { AIHub.progress({ score: Math.round(engine.time * 10), label: 'ok' }); AIHub.send({ x: Math.sin(t += 0.1), s: ++sent }, { reliable: false }); } }, 100);\n    AIHub.ready();\n  }\n}\nif (typeof document !== 'undefined') main().catch((e) => { console.error(e); if (window.AIHub) AIHub.fail(String(e)); });\nexport const createGame = () => new Spike();\nEOF\ncat > build.mjs <<'EOF'\n// usage: node build.mjs <esbuild path or 'esbuild'>; writes dist/spike.html from src/game.js + pixel-engine.js + session.js\nimport { execFileSync } from 'node:child_process';\nimport { readFileSync, writeFileSync, mkdirSync } from 'node:fs';\nmkdirSync('dist', { recursive: true });\nexecFileSync('esbuild', ['src/game.js', '--bundle', '--format=esm', '--platform=browser', '--target=esnext', '--charset=utf8', '--outfile=dist/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\nconst js = readFileSync('dist/bundle.js', 'utf8');\nconst session = readFileSync('../hub/session.js', 'utf8');\nconst safe = (s) => s.replace(/<\\/script/gi, '<\\\\/script').replace(/<!--/g, '<\\\\!--');\nconst html = `<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<script>${session}</script>\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Highest balance score wins\">\n<meta name=\"hub:session-howto\" content=\"Left stick or WASD or mouse: lean\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:webgpu\" content=\"required\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<link rel=\"icon\" href=\"data:,\">\n<title>Spike</title>\n<style>html, body { margin: 0; height: 100%; background: #0d0b14; } #app { position: fixed; inset: 0; }</style>\n</head>\n<body>\n<div id=\"app\"></div>\n<script type=\"module\">${safe(js)}</script>\n</body>\n</html>`;\nwriteFileSync('dist/spike.html', html);\nconsole.log('html bytes', html.length, 'bundle', js.length, 'engine', readFileSync('pixel-engine.js').length);\nEOF\nnode build.mjs && ls -la dist","description":"Write and build the single-file spike game"}}}
