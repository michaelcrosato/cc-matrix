{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E9s6ZLjXygUnba69vB3occ","type":"tool_result","content":"types/game/hero/rig.d.ts:13: *   Arm*     X swings: -90 = straight ahead, -180 = overhead, +40 = back\nFILE: types/game/hero/rig.d.ts\n3: * The hero rig (public/assets/hero.glb, built by scripts/assets/hero.mjs).\n4- *\n5- * The character faces +Z. L/R are the character's own sides (its right = -X).\n6- * Rotations are Euler XYZ degrees relative to rest; Z is applied first, then Y, then X,\n7- * all about the parent's axes. Verified against contact sheets (`npm run anim -- sheet`).\n8- *\n9- *   Pelvis   +X tip forward (90 = face down, -90 = on its back, 360 = front flip)\n10- *            +Y turn to its left, +Z roll to its RIGHT. p = [x, y, z] offset (m), s = squash\n11- *   Torso    +X bend forward, +Y twist left, +Z lean right\n12- *   Head     +X look down, +Y look left, +Z tilt right\n13- *   Arm*     X swings: -90 = straight ahead, -180 = overhead, +40 = back\n14- *            Z spreads (applied first): ArmR -Z / ArmL +Z = out to the side, 90 = T-pose.\n15- *            e.g. ArmR [-90, 0, -40] points ahead and out to its right.\n16- *   Forearm* -X bends the elbow (forearm comes forward/up)\n17- *   Hand*    -X curl wrist forward\n18- *   Leg*     -X swing forward (kick/step), +X swing back; LegR -Z / LegL +Z = out to the side\n19- *   Shin*    +X bends the knee (foot goes back)\n20- *   Foot*    +X points the toes down, -X pulls the toes up (heel strike)\n21- *\n22- * Standing: hip 0.62, shoulders 1.12, top of head ~1.74. Leg = thigh 0.30 + shin 0.22 +\n23- * ankle 0.10. Arm = 0.25 + 0.16 + hand. Prefer `placeFeet` / `gaitClip` over posing legs\n24- * by hand: they keep the soles on the floor.\n25- */\n26-export declare const HERO_RIG: RigSpec;\ntypes/engine/animation/sheet.d.ts:21:export interface SheetOptions {\ntypes/engine/animation/sheet.d.ts-22-    /** Authoring frames to show (default: the key frames, or 12 evenly spaced). */\ntypes/engine/animation/sheet.d.ts-23-    frames?: number[];\ntypes/engine/animation/sheet.d.ts-24-    views?: ViewName[];\ntypes/engine/animation/sheet.d.ts-25-    /** Pixels per metre (default 64). */\ntypes/engine/animation/sheet.d.ts-26-    scale?: number;\ntypes/engine/animation/sheet.d.ts-27-    skeleton?: boolean;\ntypes/engine/animation/sheet.d.ts-28-    trails?: boolean;\ntypes/engine/animation/sheet.d.ts-29-    /** Metrics to print under the sheet. */\ntypes/engine/animation/sheet.d.ts-30-    report?: ClipReport;\ntypes/engine/animation/sheet.d.ts-31-    /** A previous version of the clip: its skeleton and paths are drawn in magenta. */\ntypes/engine/animation/sheet.d.ts-32-    ghost?: AnimationClip;\ntypes/engine/animation/sheet.d.ts-33-    /**\ntypes/engine/animation/sheet.d.ts-34-     * Called after the model is posed at each frame, before it is drawn: for parts the game\ntypes/engine/animation/sheet.d.ts-35-     * moves at runtime from the pose (a bow's string drawn to the hand).\ntypes/engine/animation/types.d.ts:15:export interface JointPose {\ntypes/engine/animation/types.d.ts-16-    /** Rotation, degrees XYZ. */\ntypes/engine/animation/types.d.ts-17-    r?: Euler;\ntypes/engine/animation/types.d.ts-18-    /** Position offset from rest, metres (Pelvis only in practice). */\ntypes/engine/animation/types.d.ts-19-    p?: Vec3;\ntypes/engine/animation/types.d.ts-20-    /** Scale: uniform number or per-axis. 1 = rest. */\ntypes/engine/animation/types.d.ts-21-    s?: number | Vec3;\ntypes/engine/animation/types.d.ts-22-}\ntypes/engine/animation/types.d.ts-23-/** Joint name → rotation (degrees) or full joint pose. Missing joints are at rest. */\ntypes/engine/animation/types.d.ts-24-export type Pose = Readonly<Record<string, Euler | JointPose>>;\ntypes/engine/animation/types.d.ts-25-export type Ease = 'linear'\ntypes/engine/animation/types.d.ts:41:export interface Layer {\ntypes/engine/animation/types.d.ts-42-    joint: string;\ntypes/engine/animation/types.d.ts-43-    /** rx/ry/rz in degrees, px/py/pz in metres, s = uniform scale delta. */\ntypes/engine/animation/types.d.ts-44-    channel: 'rx' | 'ry' | 'rz' | 'px' | 'py' | 'pz' | 's';\ntypes/engine/animation/types.d.ts-45-    amplitude: number;\ntypes/engine/animation/types.d.ts-46-    /** Frames per cycle. For looping clips it must divide `frames`. */\ntypes/engine/animation/types.d.ts-47-    period: number;\ntypes/engine/animation/types.d.ts-48-    /** 0..1 fraction of a cycle. */\ntypes/engine/animation/types.d.ts-49-    phase?: number;\ntypes/engine/animation/types.d.ts-50-}\ntypes/engine/animation/types.d.ts-51-/** Where the feet should be (foot IK goals; see ik.ts). A missing side is left as keyed. */\ntypes/engine/animation/types.d.ts-52-export interface FeetGoals {\ntypes/engine/animation/types.d.ts-53-    R?: FootGoalDef;\ntypes/engine/texture/types.d.ts:50:export type Layer = PixelsLayer | PatternLayer | PathLayer | OutlineLayer;\ntypes/engine/texture/types.d.ts-51-export interface TextureDef {\ntypes/engine/texture/types.d.ts-52-    readonly id: string;\ntypes/engine/texture/types.d.ts-53-    /** One line: what it is (`npm run tex -- find` searches it). */\ntypes/engine/texture/types.d.ts-54-    readonly about: string;\ntypes/engine/texture/types.d.ts-55-    readonly tags: readonly string[];\ntypes/engine/texture/types.d.ts-56-    /** Texels, width × height; powers of two for surfaces that tile. Sprite sheets: all frames. */\ntypes/engine/texture/types.d.ts-57-    readonly size: readonly [w: number, h: number];\ntypes/engine/texture/types.d.ts-58-    /** Slots → PALETTE names (at most 255). Layers name slots, never colours, so a bake can re-bind them. */\ntypes/engine/texture/types.d.ts-59-    readonly palette: Readonly<Record<TexSlot, PaletteColor>>;\ntypes/engine/texture/types.d.ts-60-    /** Seamless: patterns wrap by construction; the check measures the seam of pixels, paths and gradients. */\ntypes/engine/texture/types.d.ts-61-    readonly tile?: