 at: [0, 10.5, 0], rot: [90, 0, 0], c: 'dark', seg: 14 }, { cyl: [3, 0.5, 3], at: [0, 8.9, 0], c: 'glow', glow: true } ],\n});\nexport const sweatJar = model({\n  id: 'sweat-jar', about: 'A giant glass jar on the plaza holding the guests\\' Drips', tags: ['prop'], palette: { glass: 'mist', lid: 'slate', plinth: 'white', label: 'sand' },\n  parts: [ { name: 'plinth', cyl: [2.2, 0.3, 2.2], at: [0, 0.15, 0], c: 'plinth', seg: 12 }, { name: 'wall', tube: [[0.9, 0.3], [0.9, 2.6]], r: 0.05, at: [0, 0, 0], c: 'glass' }, { name: 'lid', cyl: [1.5, 0.22, 1.5], at: [0, 2.8, 0], c: 'lid', seg: 12 }, { name: 'label', box: [0.9, 0.5, 0.05], at: [0, 1.5, 0.76], c: 'label' } ],\n});\nEOF\ntimeout 150 node check.mjs --sheets sig-models.js 2>&1 | tail -14 | cut -c1-220; ls check/sheets | head","description":"Draw model sheets for Ounce and signature props with the kit's tool","timeout":200000}}}
