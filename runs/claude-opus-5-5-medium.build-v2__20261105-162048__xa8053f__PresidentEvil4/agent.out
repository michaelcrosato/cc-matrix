; while ((a.savedScale ?? 1) !== 1) row(8);\n  a.say('MAX', 'x'); a.player.locked = true; a.dialog.start([{ who: 'MAX', text: 'A long line for skipping.' }], { lock: true, done: () => { a.player.locked = false; } }); row(9); ok(!a.dialog.active, 'SKIP CUTSCENE'); a.run.health = 5; row(10); ok(a.run.health === a.run.maxHealth, 'HEAL'); const m0 = a.run.money; row(11); ok(a.run.money === m0 + 10000, 'GIVE 10,000 DOUBLOONS'); row(12); ok(gun() === 1 && a.run.items.some((i) => i.id === 'harpoon'), 'GIVE ALL WEAPONS AND ITEMS'); row(13); const { findSpot } = await import('../../src/core/run.js'); ok(!findSpot(a.run, 'samphire'), 'FILL CASE'); const x = a.spawnEnemy('gaffer', P.pos.x + 4, P.pos.z); row(14); ok(x.dead, 'KILL ALL'); row(15); ok(a.level.doors.every((d) => d.open) && a.level.gates.G.every((g) => g.open), 'UNLOCK ALL'); row(16); ok(!e.errors.length, 'ENGINE DEBUG PANEL', e.errors[0]);\n  D.s.tab = 2; D.s.focus = 0; const n0 = a.enemies.length; press('Enter'); ok(a.enemies.length === n0 + 1, 'SPAWN makes one'); P.god = false; a.infiniteAmmo = false; a.oneHit = false;\n  press('Escape'); ok(D.done && !M.sub, 'dev closes'); M.s.focus = 1; press('Enter'); ok(M.sub?.constructor.name === 'SettingsScreen', 'SETTINGS opens'); press('Escape'); ok(!M.sub, 'settings closes'); M.s.focus = 0; press('Enter'); ok(!a.menu, 'RESUME'); ok(e.timeScale === 1, 'time returns');\n  press('Escape'); a.menu.s.focus = 2; const pr = (() => { e.input.setKey('Enter', true); step(2); e.input.setKey('Enter', false); step(1); return app.pending; })(); await settle(pr); ok(e.game !== a && e.game.id === 'quay', 'RESTART FROM CHECKPOINT'); const a2 = e.game; a2.scripts = []; a2.cutscene?.skip(); press('Escape'); a2.menu.s.focus = 4; e.input.setKey('Enter', true); step(2); e.input.setKey('Enter', false); step(1); await settle(app.pending); ok(e.game.name === 'title', 'QUIT TO TITLE');\n  const T = e.game; const ids = T.items().map((i) => i.id); ok(ids.includes('continue'), 'CONTINUE offered with a save'); T.s.focus = ids.indexOf('new'); press('Enter'); ok(!!T.pick, 'NEW CLAIM asks for cover'); ok(T.pick.focus === 1, 'Standard by default'); press('Escape'); T.s.focus = T.items().findIndex((i) => i.id === 'settings'); press('Enter'); ok(T.sub?.constructor.name === 'SettingsScreen', 'title SETTINGS'); const Se = T.sub; for (const [tab, n] of [[0, 5], [1, 5], [2, 6]]) { Se.s.tab = tab; ok(Se.rows(tab).length === n, `settings page ${tab}`); } Se.s.tab = 2; Se.s.focus = 1; const l0 = app.settings.look; press('Enter'); ok(app.settings.look !== l0, 'LOOK cycles'); Se.s.focus = 3; const q0 = app.settings.quality; press('Enter'); ok(app.settings.quality !== q0, 'QUALITY cycles'); Se.s.focus = 4; const f0 = app.settings.fps; press('Enter'); ok(app.settings.fps !== f0, 'FRAME RATE cycles'); Se.s.focus = 2; const p0 = app.settings.pixelSize; press('Enter'); ok(app.settings.pixelSize !== p0, 'PIXEL SIZE cycles'); Se.s.tab = 0; Se.s.focus = 4; press('Enter'); ok(app.settings.look === 'native' && app.settings.music === 0.1, 'RESET ALL SETTINGS'); press('Escape'); T.s.focus = T.items().findIndex((i) => i.id === 'about'); press('Enter'); ok(T.sub?.constructor.name === 'AboutScreen', 'ABOUT'); press('Escape'); T.s.focus = T.items().findIndex((i) => i.id === 'continue'); e.input.setKey('Enter', true); step(2); e.input.setKey('Enter', false); step(1); await settle(app.pending); ok(e.game.id === 'quay', 'CONTINUE loads the save', e.game.name); ok(!e.errors.length, 'no errors in menus', e.errors[0]); }\ndone('reach');\"\"\",1)\nopen(p,'w').write(s)\nP\ntimeout 200 node tests/node/reach.mjs 2>&1 | grep -v \"^file\\|\\`);for\\|^ *\\^$\\|pixel-engine.js\" | sed 's#file://[^ ]*work/[^/]*/##' | cut -c1-240 | tail -14","description":"Inspect the MISS; test every menu item through the real screens","timeout":220000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2877,"cach