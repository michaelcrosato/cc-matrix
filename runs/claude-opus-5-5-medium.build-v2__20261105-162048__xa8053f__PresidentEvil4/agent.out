t-stall cart haystack clothesline dead-tree rock boulders reeds tall-grass tombstone column altar banner portcullis sarcophagus lever wall-chains cage cobweb puddle chimney fence timber-wall; do grep -q \"^| \\`$i\\`\\|\\`$i\\`\" ../_kit/pixel-engine/LIBRARY.md || echo MISSING $i; done; grep -n \"\\`door\\`\\|\\`ladder\\`\\|\\`wardrobe\\`\\|\\`roof\\`\\|\\`column\\`\\|\\`lamp-post\\`\\|\\`candles\\`\" ../_kit/pixel-engine/LIBRARY.md | cut -c1-200; grep -n \"cobbles\\|flagstones\\|planks\\|\\`deck\\|rough-boards\\|dry-stone\\|basalt\\|slate-roof\\|metal-plates\\|moss\\b\\|\\`dirt\\|wet-sand\\|ruined-mosaic\\|bricks\" ../_kit/pixel-engine/LIBRARY.md | cut -c1-130 | head -20","description":"Write all character, weapon, and prop models and check them"}}}
