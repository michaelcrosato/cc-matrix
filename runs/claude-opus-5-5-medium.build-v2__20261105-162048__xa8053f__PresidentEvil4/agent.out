{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkf1EBCNqrNh6e2dToaK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TeruUnWgCktNNg8DqEogWW","name":"Bash","input":{"command":"cat > src/core/save.js <<'E'\n// localStorage with a slug prefix. In a hub session the client hands us an empty storage: nothing special needed.\nimport { SLUG } from '../config.js';\nconst mem = new Map();\nconst store = () => { try { return globalThis.localStorage || null; } catch { return null; } };\nexport const save = {\n  get(k, d = null) { try { const s = store(); const v = s ? s.getItem(`${SLUG}.${k}`) : mem.get(k); return v == null ? d : JSON.parse(v); } catch { return d; } },\n  set(k, v) { try { const s = store(); const j = JSON.stringify(v); if (s) s.setItem(`${SLUG}.${k}`, j); else mem.set(k, j); } catch { /* storage full or denied: the game goes on */ } },\n  del(k) { try { const s = store(); if (s) s.removeItem(`${SLUG}.${k}`); else mem.delete(k); } catch { /* ignored */ } },\n};\nexport const DEFAULT_SETTINGS = { music: 0.1, sfx: 1, voice: 1, master: 0.8, padAim: 1, mouseAim: 1, invertY: false, aimAssist: 1, glyphs: 'ps', shake: 1, look: 'native', pixelSize: 'fine', quality: 'high', fps: 60 };\nexport function loadSettings() { return { ...DEFAULT_SETTINGS, ...save.get('settings', {}) }; }\nexport function storeSettings(s) { save.set('settings', s); }\nE\ncat > src/core/device.js <<'E'\n// Which input was used last. Prompts follow it at once. A pad connecting never steals the glyphs until used.\nexport const device = { last: 'keyboard', moved: 0, padSeen: false, keySeen: false, touchOnly: false };\nlet attached = false;\nexport function attachDevice() {\n  if (attached || typeof window === 'undefined') return; attached = true;\n  window.addEventListener('keydown', () => { device.last = 'keyboard'; device.keySeen = true; device.moved++; }, true);\n  window.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { device.last = 'keyboard'; device.moved++; } }, true);\n  window.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') { device.last = 'keyboard'; device.moved++; } }, true);\n  window.addEventListener('wheel', () => { device.last = 'keyboard'; device.moved++; }, true);\n  device.touchOnly = navigator.maxTouchPoints > 0 && !matchMedia('(any-pointer: fine)').matches;\n}\nexport function pollPads() {\n  if (typeof navigator === 'undefined' || !navigator.getGamepads) return false;\n  let used = false;\n  for (const p of navigator.getGamepads() || []) {\n    if (!p) continue; device.padSeen = true;\n    if (p.buttons.some((b) => b.pressed || b.value > 0.3) || p.axes.some((a) => Math.abs(a) > 0.25)) used = true;\n  }\n  if (used) { device.last = 'pad'; device.moved++; }\n  return used;\n}\nexport function rumble(strong = 0.5, weak = 0.3, ms = 120) {\n  if (typeof navigator === 'undefined' || !navigator.getGamepads) return;\n  try { for (const p of navigator.getGamepads() || []) p?.vibrationActuator?.playEffect?.('dual-rumble', { duration: ms, strongMagnitude: strong, weakMagnitude: weak })?.catch?.(() => {}); } catch { /* a stub or an old pad */ }\n}\nE\ncat > src/core/intent.js <<'E'\n// The player reads an Intent, never ctx.input. Human, bot and network all fill the same object.\nexport const PAD_BUTTONS = { 0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle', 4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2', 8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3', 12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight' };\nexport const BIND = {\n  aim: ['PadL2', 'MouseRight'], fire: ['PadR2', 'MouseLeft'], knife: ['PadR1', 'KeyV'], action: ['PadCross', 'KeyE'], run: ['PadCircle', 'ShiftLeft', 'ShiftRight'], turn: ['KeyQ'], reload: ['PadSquare', 'KeyR'],\n  case: ['PadTriangle', 'Tab', 'KeyI'], pause: ['PadOptions', 'Escape', 'KeyP'], map: ['KeyM'], next: ['PadUp'], prev: ['PadDown'], heal: ['PadLeft', 'KeyH'], command: ['PadRight', 'KeyC'], throw: ['PadL1', 'KeyG'], shoulder: ['PadR3', 'KeyT'], dodge: ['PadCircle', 'Space'],\n  confirm: ['PadCross', 'Enter', 'Space'], back: ['PadCircle', 'Escape'], tabPrev: ['PadL1', 'KeyQ'], tabNext: ['PadR1', 'KeyE'], secondary: ['PadSquare', 'KeyR'], tertiary: ['PadTriangle', 'KeyT'], arrange: ['PadR1', 'KeyF'],\n  up: ['PadUp', 'ArrowUp', 'KeyW'], down: ['PadDown', 'ArrowDown', 'KeyS'], left: ['PadLeft', 'ArrowLeft', 'KeyA'], right: ['PadRight', 'ArrowRight', 'KeyD'],\n};\nexport const newIntent = () => ({ moveX: 0, moveY: 0, lookX: 0, lookY: 0, absYaw: null, absPitch: null, aim: false, fire: false, firePressed: false, reload: false, knife: false, action: false, run: false, heal: false, command: false, throw: false, turn: false, next: false, prev: false, slot: -1, shoulder: false, dodge: false, actionHeld: false });\nexport class HumanIntent {\n  constructor() { this.i = newIntent(); this.createHeld = false; this.circleAt = -9; }\n  /** Called each fixed step. Presses via consumePress so none is lost. */\n  fixed(ctx) {\n    const I = ctx.input, i = this.i, m = I.moveAxis();\n    i.moveX = m.x; i.moveY = m.y;\n    i.aim = I.anyDown(BIND.aim);\n    const firing = i.aim ? I.anyDown(BIND.fire) : I.isDown('PadR2');\n    i.firePressed = i.aim ? I.consumeAny(BIND.fire) : false;\n    i.fire = firing;\n    i.knife = I.consumeAny(BIND.knife) || (!i.aim && I.consumePress('MouseLeft'));\n    i.actionHeld = I.anyDown(BIND.action);\n    i.action = I.consumeAny(BIND.action);\n    i.run = I.anyDown(BIND.run);\n    i.dodge = I.consumeAny(BIND.dodge);\n    i.reload = I.consumeAny(BIND.reload);\n    i.heal = I.consumeAny(BIND.heal);\n    i.command = I.consumeAny(BIND.command);\n    i.throw = I.consumeAny(BIND.throw);\n    i.shoulder = I.consumeAny(BIND.shoulder);\n    i.next = I.consumeAny(BIND.next); i.prev = I.consumeAny(BIND.prev);\n    // Quick turn: tap Circle with the stick back, or Q.\n    i.turn = I.consumeAny(BIND.turn) || (i.dodge && m.y < -0.5);\n    for (let k = 1; k <= 4; k++) if (I.consumePress(`Digit${k}`)) i.slot = k - 1;\n    return i;\n  }\n}\nexport class BotIntent { constructor() { this.i = newIntent(); } fixed() { return this.i; } }\nexport class NetIntent { constructor() { this.i = newIntent(); } fixed() { return this.i; } }\nE\ncat > src/core/run.js <<'E'\n// Persistent run state: everything that outlives an Area. Plain data, saved as JSON.\nimport { ITEMS, combineRecipes } from '../data/items.js';\nimport { WEAPONS, WEAPON_ORDER, weaponStats } from '../data/weapons.js';\nimport { DIFFICULTY } from '../data/tuning.js';\nexport function newRun(difficulty = 'standard') {\n  const r = { difficulty, chapter: 1, area: 'quay', entry: null, health: 100, maxHealth: 100, dameHp: null, money: 300, weapon: 'pistol', weapons: { pistol: { ammo: 12, tune: {} } }, grid: { w: 10, h: 6 }, items: [], valuables: [], keys: [], notes: [], tannoys: [], rewards: [], flags: {}, seen: {}, areaFlags: {}, rank: 2, deductions: 0, uid: 1,\n    stats: { time: 0, shots: 0, hits: 0, heads: 0, kicks: 0, kills: 0, deaths: 0, chapterStart: null, tookDamage: 0 }, chapterBase: { time: 0, shots: 0, hits: 0, heads: 0, kicks: 0 }, sockets: { pearl: false, blackpearl: false, amber: false } };\n  place(r, { id: 'pistol' }, 0, 0);\n  addItem(r, 'ammo_pistol', 30);\n  addItem(r, 'samphire');\n  return r;\n}\nexport const diff = (r) => DIFFICULTY[r.difficulty] || DIFFICULTY.standard;\nexport const fp = (it) => { const d = ITEMS[it.id]; return it.rot ? [d.h, d.w] : [d.w, d.h]; };\nfunction occupied(r, ignore) {\n  const g = Array.from({ length: r.grid.h }, () => Array(r.grid.w).fill(false));\n  for (const it of r.items) { if (it === ignore) continue; const [w, h] = fp(it); for (let y = it.y; y < it.y + h; y++) for (let x = it.x; x < it.x + w; x++) if (g[y]) g[y][x] = true; }\n  return g;\n}\nexport function fits(r, it, x, y, ignore = null) {\n  const [w, h] = fp(it); if (x < 0 || y < 0 || x + w > r.grid.w || y + h > r.grid.h) return false;\n  const g = occupied(r, ignore); for (let j = y; j < y + h; j++) for (let i = x; i < x + w; i++) if (g[j][i]) return false; return true;\n}\nfunction place(r, it, x, y) { const item = { uid: r.uid++, id: it.id, x, y, rot: !!it.rot, count: it.count ?? 1 }; r.items.push(item); return item; }\nexport function findSpot(r, id, count = 1) {\n  for (const rot of [false, true]) { const t = { id, rot }; for (let y = 0; y < r.grid.h; y++) for (let x = 0; x < r.grid.w; x++) if (fits(r, t, x, y)) return { x, y, rot }; }\n  return null;\n}\n/** Adds to the Case: stacks first, then new cells. Returns what did not fit. */\nexport function addItem(r, id, count = 1) {\n  const d = ITEMS[id]; if (!d) throw new Error(`no item ${id}`);\n  if (d.kind === 'treasure') { for (let n = 0; n < count; n++) r.valuables.push(id); return 0; }\n  if (d.kind === 'key') { if (!r.keys.includes(id)) r.keys.push(id); return 0; }\n  if (d.kind === 'weapon' && !r.weapons[d.weapon]) r.weapons[d.weapon] = { ammo: WEAPONS[d.weapon].mag, tune: {} };\n  let left = count;\n  if (d.max) for (const it of r.items) if (it.id === id && it.count < d.max) { const n = Math.min(left, d.max - it.count); it.count += n; left -= n; if (!left) return 0; }\n  while (left > 0) {\n    const s = findSpot(r, id); if (!s) return left;\n    const n = d.max ? Math.min(left, d.max) : 1; place(r, { id, rot: s.rot, count: n }, s.x, s.y); left -= n;\n  }\n  return 0;\n}\nexport function removeItem(r, it) { const i = r.items.indexOf(it); if (i >= 0) r.items.splice(i, 1); }\nexport function arrange(r) {\n  const items = [...r.items].sort((a, b) => { const A = ITEMS[a.id], B = ITEMS[b.id]; return B.w * B.h - A.w * A.h || B.h - A.h || a.uid - b.uid; });\n  const copy = r.items; r.items = []; const leftovers = [];\n  for (const it of items) {\n    let done = false;\n    for (const rot of [false, true]) { it.rot = rot; for (let y = 0; y < r.grid.h && !done; y++) for (let x = 0; x < r.grid.w && !done; x++) if (fits(r, it, x, y)) { it.x = x; it.y = y; r.items.push(it); done = true; } if (done) break; }\n    if (!done) leftovers.push(it);\n  }\n  if (leftovers.length) { r.items = copy; return false; }\n  return true;\n}\nexport function ammoOf(r, weaponId) { const a = WEAPONS[weaponId].ammo; return r.items.filter((i) => i.id === a).reduce((n, i) => n + i.count, 0); }\nexport function takeAmmo(r, weaponId, want) {\n  const a = WEAPONS[weaponId].ammo; let got = 0;\n  for (const it of r.items) if (it.id === a && got < want) { const n = Math.min(it.count, want - got); it.count -= n; got += n; }\n  r.items = r.items.filter((i) => !(i.id === a && i.count <= 0));\n  return got;\n}\nexport const statsOf = (r, id) => weaponStats(id, r.weapons[id]?.tune);\nexport const ownedWeapons = (r) => WEAPON_ORDER.filter((w) => r.items.some((i) => i.id === w));\nexport function count(r, id) { return r.items.filter((i) => i.id === id).reduce((n, i) => n + i.count, 0); }\nexport function combine(r, a, b) {\n  const rec = combineRecipes.find((c) => (c.from[0] === a.id && c.from[1] === b.id) || (c.from[0] === b.id && c.from[1] === a.id));\n  if (!rec || a === b) return false;\n  removeItem(r, a); removeItem(r, b);\n  const out = { id: rec.to }; place(r, { id: rec.to, rot: a.rot }, a.x, a.y); return out;\n}\nexport function combinable(r, a) { return r.items.filter((b) => b !== a && combineRecipes.some((c) => (c.from[0] === a.id && c.from[1] === b.id) || (c.from[0] === b.id && c.from[1] === a.id))); }\n/** Use a herb: returns the amount healed or false. */\nexport function useHerb(r, it) {\n  const d = ITEMS[it.id]; if (d.kind !== 'herb' || !d.heal) return false;\n  if (d.maxUp) r.maxHealth += d.maxUp;\n  r.health = Math.min(r.maxHealth, r.health + d.heal * r.maxHealth); removeItem(r, it); return true;\n}\nexport function bestHerb(r) { let best = null; for (const it of r.items) { const d = ITEMS[it.id]; if (d.kind === 'herb' && d.heal && (!best || d.heal < ITEMS[best.id].heal === false)) if (!best || d.heal > ITEMS[best.id].heal) best = it; } return best; }\nexport function socketInto(r, gem) {\n  const i = r.valuables.indexOf(gem); if (i < 0 || !r.valuables.includes('reliquary') || r.sockets[gem] === undefined || r.sockets[gem]) return false;\n  r.valuables.splice(i, 1); r.sockets[gem] = true; return true;\n}\nexport const reliquaryFull = (r) => r.sockets.pearl && r.sockets.blackpearl && r.sockets.amber;\nexport function treasureValue(r, id) { if (id === 'reliquary') return reliquaryFull(r) ? ITEMS.reliquary.full : ITEMS.reliquary.value; return ITEMS[id].value; }\nexport function sellPrice(r, it) {\n  const d = ITEMS[it.id]; if (d.kind === 'weapon') return Math.floor(WEAPONS[d.weapon].price / 2) || 100;\n  if (d.kind === 'ammo') return Math.ceil(d.price / 2 * it.count / d.gives);\n  return d.sell ?? Math.floor((d.price || 100) / 2);\n}\nexport function sellTreasure(r, id) { const i = r.valuables.indexOf(id); if (i < 0) return 0; const v = treasureValue(r, id); r.valuables.splice(i, 1); if (id === 'reliquary') r.sockets = { pearl: false, blackpearl: false, amber: false }; r.money += v; return v; }\nE\ncat > src/core/ui.js <<'E'\n// The pixel UI kit. Immediate mode over ctx.hud. Every screen for every input. Focus by stick or D-pad, hover moves focus, click activates.\nimport { BIND } from './intent.js';\nimport { device } from './device.js';\nexport const FONT_CHARS = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ.,:;-+=/()[]{}%_!?<>#'‘’“”*@°·&|\\\\~^$ \";\nconst up = (s) => String(s).toUpperCase();\nexport class UI {\n  constructor(app) { this.app = app; this.t = 0; this.rects = []; this.holdT = {}; this.px = 0; this.py = 0; this.lastP = [9, 9]; this.hover = false; this.click = false; this.rclick = false; this.wheel = 0; this.nav = {}; this.mouseDown = false; }\n  begin(ctx, clear = true) {\n    this.ctx = ctx; this.hud = ctx.hud; this.input = ctx.input; const dt = 1 / 60; this.t += dt; this.dt = dt; this.W = ctx.hud.width || 480; this.H = ctx.hud.height || 270;\n    if (clear) ctx.hud.clear();\n    const p = this.input.pointer; this.px = (p.x + 1) / 2 * this.W; this.py = (1 - p.y) / 2 * this.H;\n    this.hover = (p.x !== this.lastP[0] || p.y !== this.lastP[1]); this.lastP = [p.x, p.y];\n    this.click = false; this.rclick = false; this.cx = this.px; this.cy = this.py;\n    for (const e of this.input.buttonEvents) if (e.down && (e.code === 'MouseLeft' || e.code === 'Touch')) { this.click = true; this.cx = (e.x + 1) / 2 * this.W; this.cy = (1 - e.y) / 2 * this.H; this.hover = true; } else if (e.down && e.code === 'MouseRight') this.rclick = true;\n    this.mouseDown = this.input.isDown('MouseLeft');\n    this.wheel = this.input.wheel;\n    const I = this.input, down = (a) => I.anyDown(BIND[a]), pressed = (a) => BIND[a].some((c) => I.wasPressed(c));\n    const m = I.padAxis || { x: 0, y: 0 };\n    const dirs = { up: down('up') || m.y > 0.5, down: down('down') || m.y < -0.5, left: down('left') || m.x < -0.5, right: down('right') || m.x > 0.5 };\n    this.nav = {};\n    for (const k in dirs) {\n      if (dirs[k]) { const h = this.holdT[k] ?? -1; if (h < 0) { this.nav[k] = true; this.holdT[k] = 0; } else { this.holdT[k] = h + dt; if (this.holdT[k] > 0.34) { this.nav[k] = true; this.holdT[k] = 0.22; } } } else this.holdT[k] = -1;\n    }\n    this.pressed = pressed;\n    this.confirm = pressed('confirm'); this.back = pressed('back'); this.secondary = pressed('secondary'); this.tertiary = pressed('tertiary');\n    this.tabPrev = pressed('tabPrev'); this.tabNext = pressed('tabNext');\n  }\n  sound(n) { this.ctx.audio.play(n); }\n  text(x, y, s, o = {}) { this.hud.text(Math.round(x), Math.round(y), up(s), o); }\n  center(y, s, o = {}, cx = this.W / 2) { const m = this.hud.measure(up(s), o.scale || 1); this.text(cx - m.width / 2, y, s, o); return m; }\n  measure(s, scale = 1) { return this.hud.measure(up(s), scale); }\n  rect(x, y, w, h, c) { this.hud.rect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), c); }\n  panel(x, y, w, h, o = {}) { this.rect(x, y, w, h, o.bg ?? 'ink'); const b = o.border ?? 'slate'; this.rect(x, y, w, 1, b); this.rect(x, y + h - 1, w, 1, b); this.rect(x, y, 1, h, b); this.rect(x + w - 1, y, 1, h, b); }\n  dim(c = 'ink') { const W = this.W, H = this.H; for (let y = 0; y < H; y += 2) this.rect(0, y, W, 1, c); }\n  within(x, y, w, h, px = this.px, py = this.py) { return px >= x && py >= y && px < x + w && py < y + h; }\n  /** A vertical list. state: {focus}. items: [{label, disabled, color, value}] Returns the activated index or -1. */\n  list(state, items, o = {}) {\n    const x = o.x ?? 40, y = o.y ?? 60, w = o.w ?? 180, rh = o.rowH ?? 16, sc = o.scale ?? 1; state.focus = Math.max(0, Math.min(items.length - 1, state.focus ?? 0));\n    let out = -1; const max = o.max ?? items.length; state.scroll = state.scroll ?? 0;\n    if (!o.noNav) {\n      if (this.nav.up) { state.focus = (state.focus - 1 + items.length) % items.length; this.sound('uimove'); }\n      if (this.nav.down) { state.focus = (state.focus + 1) % items.length; this.sound('uimove'); }\n    }\n    if (this.wheel && !o.noWheel) { state.focus = Math.max(0, Math.min(items.length - 1, state.focus + Math.sign(this.wheel))); }\n    if (state.focus < state.scroll) state.scroll = state.focus; if (state.focus >= state.scroll + max) state.scroll = state.focus - max + 1;\n    for (let vi = 0; vi < Math.min(max, items.length); vi++) {\n      const i = vi + state.scroll, it = items[i], ry = y + vi * rh;\n      if (this.hover && this.within(x, ry - 1, w, rh)) state.focus = i;\n      const on = state.focus === i;\n      if (on) { this.rect(x, ry - 2, w, rh - 1, o.bar ?? 'navy'); this.rect(x, ry - 2, 2, rh - 1, 'orange'); this.text(x + 4, ry + (rh - 4 - 7 * sc) / 2 - 1 , '>', { color: 'orange', scale: 1 }); }\n      this.text(x + 12, ry + (rh - 4 - 7 * sc) / 2 - 1, it.label, { color: it.disabled ? 'slate' : on ? 'white' : (it.color ?? 'mist'), scale: sc });\n      if (it.value != null) { const m = this.measure(it.value, 1); this.text(x + w - m.width - 5, ry + (rh - 4 - 7) / 2 - 1, it.value, { color: it.valueColor ?? (on ? 'sand' : 'slate') }); }\n      if (this.click && this.within(x, ry - 1, w, rh, this.cx, this.cy)) { state.focus = i; if (!it.disabled) out = i; else this.sound('uideny'); }\n    }\n    if (items.length > max) { if (state.scroll > 0) this.text(x + w - 8, y - 11, '^', { color: 'sand' }); if (state.scroll + max < items.length) this.text(x + w - 8, y + max * rh - 2, 'V', { color: 'sand' }); }\n    if (this.confirm && !o.noConfirm) { if (!items[state.focus]?.disabled) out = state.focus; else this.sound('uideny'); }\n    if (out >= 0) this.sound('uiconfirm');\n    return out;\n  }\n  /** Tabs across the top. Returns the current index. */\n  tabs(state, labels, y = 8) {\n    state.tab = state.tab ?? 0;\n    if (this.tabPrev) { state.tab = (state.tab - 1 + labels.length) % labels.length; state.focus = 0; state.scroll = 0; this.sound('uimove'); }\n    if (this.tabNext) { state.tab = (state.tab + 1) % labels.length; state.focus = 0; state.scroll = 0; this.sound('uimove'); }\n    let total = 0; for (const l of labels) total += this.measure(l).width + 10;\n    let x = Math.round(this.W / 2 - total / 2);\n    this.glyph(device.last === 'pad' ? 'PadL1' : 'KeyQ', x - 18, y - 1); this.glyph(device.last === 'pad' ? 'PadR1' : 'KeyE', x + total + 3, y - 1);\n    labels.forEach((l, i) => { const w = this.measure(l).width + 8, on = i === state.tab; if (on) this.rect(x, y - 2, w, 11, 'navy'); this.text(x + 4, y, l, { color: on ? 'white' : 'slate' }); if (this.click && this.within(x, y - 2, w, 11, this.cx, this.cy)) { state.tab = i; state.focus = 0; state.scroll = 0; this.sound('uimove'); } x += w + 2; });\n    return state.tab;\n  }\n  slider(x, y, w, v, min, max, o = {}) {\n    const k = Math.max(0, Math.min(1, (v - min) / (max - min)));\n    this.rect(x, y + 2, w, 3, 'night'); this.rect(x, y + 2, Math.round(w * k), 3, o.color ?? 'sand');\n    if (o.def != null) this.rect(x + Math.round(w * ((o.def - min) / (max - min))), y, 1, 7, 'slate');\n    this.rect(x + Math.round(w * k) - 1, y, 3, 7, 'white');\n    if (this.mouseDown && this.within(x - 2, y - 3, w + 4, 13)) return min + (max - min) * Math.max(0, Math.min(1, (this.px - x) / w));\n    return v;\n  }\n  bar(x, y, w, h, k, c, bg = 'night') { this.rect(x, y, w, h, bg); this.rect(x, y, Math.round(w * Math.max(0, Math.min(1, k))), h, c); }\n  wrap(s, width) { const out = []; let line = ''; for (const w of up(s).split(' ')) { const t = line ? line + ' ' + w : w; if (this.measure(t).width > width && line) { out.push(line); line = w; } else line = t; } if (line) out.push(line); return out; }\n  para(x, y, s, width, o = {}) { const lines = this.wrap(s, width); lines.forEach((l, i) => this.text(x, y + i * (o.lh ?? 10), l, o)); return lines.length; }\n  /** Draws one input glyph at (x, y). Width returned. */\n  glyph(code, x, y) { return drawGlyph(this, code, x, y); }\n  /** Glyph for an action on the current device. */\n  action(a, x, y) { return this.glyph(codeFor(a), x, y); }\n  /** A prompt bar at the bottom. [[action, label], ...] */\n  prompts(list, o = {}) {\n    let total = 0; for (const [a, l] of list) total += glyphWidth(codeFor(a)) + 3 + this.measure(l).width + 10;\n    let x = Math.round(this.W / 2 - total / 2); const y = o.y ?? this.H - 15;\n    if (!o.noBar) this.rect(0, y - 3, this.W, 17, 'ink');\n    for (const [a, l, id] of list) { const gw = this.action(a, x, y - 1); this.text(x + gw + 3, y + 1, l, { color: 'mist' }); const w = gw + 3 + this.measure(l).width; if (id && this.click && this.within(x, y - 3, w, 14, this.cx, this.cy)) this.clickedPrompt = id; x += w + 10; }\n  }\n}\n// ---- Glyphs\nconst KEYNAME = { KeyQ: 'Q', KeyE: 'E', KeyR: 'R', KeyT: 'T', KeyF: 'F', KeyG: 'G', KeyH: 'H', KeyC: 'C', KeyV: 'V', KeyM: 'M', KeyI: 'I', KeyP: 'P', KeyW: 'W', Enter: 'ENTER', Space: 'SPACE', Escape: 'ESC', Tab: 'TAB', ShiftLeft: 'SHIFT', ArrowUp: '^' };\nconst PS = { PadCross: ['blue', 'x'], PadCircle: ['red', 'o'], PadSquare: ['plum', 's'], PadTriangle: ['green', 't'] };\nconst XB = { PadCross: ['green', 'A'], PadCircle: ['red', 'B'], PadSquare: ['blue', 'X'], PadTriangle: ['sand', 'Y'] };\nconst PILL_PS = { PadL1: 'L1', PadR1: 'R1', PadL2: 'L2', PadR2: 'R2', PadOptions: 'OPT', PadCreate: 'CRT', PadR3: 'R3', PadL3: 'L3', PadUp: 'D^', PadDown: 'DV', PadLeft: 'D<', PadRight: 'D>', PadStick: 'LS' };\nconst PILL_XB = { ...PILL_PS, PadL1: 'LB', PadR1: 'RB', PadL2: 'LT', PadR2: 'RT', PadOptions: 'MENU', PadCreate: 'VIEW' };\nconst DISC = ['...xxxxx...', '..xxxxxxx..', '.xxxxxxxxx.', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', '.xxxxxxxxx.', '..xxxxxxx..', '...xxxxx...'];\nconst SYM = { x: ['.......', '.w...w.', '..w.w..', '...w...', '..w.w..', '.w...w.', '.......'], o: ['..www..', '.w...w.', 'w.....w', 'w.....w', 'w.....w', '.w...w.', '..www..'], s: ['wwwwwww', 'w.....w', 'w.....w', 'w.....w', 'w.....w', 'w.....w', 'wwwwwww'], t: ['...w...', '..w.w..', '..w.w..', '.w...w.', '.w...w.', 'w.....w', 'wwwwwww'] };\nexport const glyphWidth = (code) => { if (code.startsWith('Mouse')) return 9; if (code in PS) return 11; if (code.startsWith('Pad')) return (({ ...PILL_PS, ...PILL_XB })[code]?.length || 2) * 6 + 3; return Math.max(11, (KEYNAME[code]?.length || 1) * 6 + 5); };\nexport function drawGlyph(ui, code, x, y) {\n  const xbox = ui.app.settings.glyphs === 'xbox';\n  if (code in PS) {\n    const [c, s] = (xbox ? XB : PS)[code];\n    ui.hud.sprite(x, y, DISC, { x: c });\n    if (xbox) ui.hud.text(x + 3, y + 2, s, { color: 'white', shadow: false });\n    else ui.hud.sprite(x + 2, y + 2, SYM[s], { w: 'white' });\n    return 11;\n  }\n  if (code.startsWith('Pad')) {\n    const t = (xbox ? PILL_XB : PILL_PS)[code] || '?', w = t.length * 6 + 3;\n    ui.rect(x, y + 1, w, 9, 'slate'); ui.hud.text(x + 2, y + 2, t, { color: 'white', shadow: false }); return w;\n  }\n  if (code.startsWith('Mouse')) {\n    const L = code === 'MouseLeft', R = code === 'MouseRight', W = code === 'MouseWheel';\n    ui.hud.sprite(x, y, ['..mmmmm..', '.lll#rrr.', '.lll#rrr.', '.lll#rrr.', '.mmmmmmm.', '.mmmmmmm.', '.mmmmmmm.', '.mmmmmmm.', '.mmmmmmm.', '..mmmmm..', '.........'], { m: 'mist', l: L ? 'orange' : 'mist', r: R ? 'orange' : 'mist', '#': W ? 'orange' : 'slate' });\n    return 9;\n  }\n  const t = KEYNAME[code] ?? code.replace('Key', '').replace('Digit', ''), w = Math.max(11, t.length * 6 + 5);\n  ui.rect(x, y, w, 11, 'mist'); ui.rect(x + 1, y + 1, w - 2, 9, 'ink'); ui.hud.text(x + Math.round((w - t.length * 6 + 1) / 2), y + 2, t, { color: 'white', shadow: false });\n  return w;\n}\n/** The code to show for an action on the current device. */\nexport function codeFor(a) {\n  const list = BIND[a] || [a];\n  const pad = device.last === 'pad';\n  const hit = list.find((c) => (pad ? c.startsWith('Pad') : !c.startsWith('Pad')));\n  return hit ?? (a.startsWith('Pad') || a.startsWith('Key') || a.startsWith('Mouse') ? a : list[0]);\n}\nE\ncat \"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-162048__xa8053f/tmp/claude-1000/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-162048--xa8053f-work/76d12802-c986-437e-adae-1ae347966275/tasks/br8csve2l.output\" | cut -c1-200 | tail -30","description":"Write core modules: save, device, intent, run state, UI kit"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":25326,"cache_read_input_tokens":222172,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":25326},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76d12802-c986-437e-adae-1ae347966275","uuid":"ccb34d89-2359-4b08-98b9-6288a7b00e78","timestamp":"2026-11-05T23:35:44.863Z","request_id":"req_011Cgkf1DwZCB5h85EJx9n8A","wire_tool_inputs":{"toolu_01TeruUnWgCktNNg8DqEogWW":{"command":"cat > src/core/save.js <<'E'\n// localStorage with a slug prefix. In a hub session the client hands us an empty storage: nothing special needed.\nimport { SLUG } from '../config.js';\nconst mem = new Map();\nconst store = () => { try { return globalThis.localStorage || null; } catch { return null; } };\nexport const save = {\n  get(k, d = null) { try { const s = store(); const v = s ? s.getItem(`${SLUG}.${k}`) : mem.get(k); return v == null ? d : JSON.parse(v); } catch { return d; } },\n  set(k, v) { try { const s = store(); const j = JSON.stringify(v); if (s) s.setItem(`${SLUG}.${k}`, j); else mem.set(k, j); } catch { /* storage full or denied: the game goes on */ } },\n  del(k) { try { const s = store(); if (s) s.removeItem(`${SLUG}.${k}`); else mem.delete(k); } catch { /* ignored */ } },\n};\nexport const DEFAULT_SETTINGS = { music: 0.1, sfx: 1, voice: 1, master: 0.8, padAim: 1, mouseAim: 1, invertY: false, aimAssist: 1, glyphs: 'ps', shake: 1, look: 'native', pixelSize: 'fine', quality: 'high', fps: 60 };\nexport function loadSettings() { return { ...DEFAULT_SETTINGS, ...save.get('settings', {}) }; }\nexport function storeSettings(s) { save.set('settings', s); }\nE\ncat > src/core/device.js <<'E'\n// Which input was used last. Prompts follow it at once. A pad connecting never steals the glyphs until used.\nexport const device = { last: 'keyboard', moved: 0, padSeen: false, keySeen: false, touchOnly: false };\nlet attached = false;\nexport function attachDevice() {\n  if (attached || typeof window === 'undefined') return; attached = true;\n  window.addEventListener('keydown', () => { device.last = 'keyboard'; device.keySeen = true; device.moved++; }, true);\n  window.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { device.last = 'keyboard'; device.moved++; } }, true);\n  window.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') { device.last = 'keyboard'; device.moved++; } }, true);\n  window.addEventListener('wheel', () => { device.last = 'keyboard'; device.moved++; }, true);\n  device.touchOnly = navigator.maxTouchPoints > 0 && !matchMedia('(any-pointer: fine)').matches;\n}\nexport function pollPads() {\n  if (typeof navigator === 'undefined' || !navigator.getGamepads) return false;\n  let used = false;\n  for (const p of navigator.getGamepads() || []) {\n    if (!p) continue; device.padSeen = true;\n    if (p.buttons.some((b) => b.pressed || b.value > 0.3) || p.axes.some((a) => Math.abs(a) > 0.25)) used = true;\n  }\n  if (used) { device.last = 'pad'; device.moved++; }\n  return used;\n}\nexport function rumble(strong = 0.5, weak = 0.3, ms = 120) {\n  if (typeof navigator === 'undefined' || !navigator.getGamepads) return;\n  try { for (const p of navigator.getGamepads() || []) p?.vibrationActuator?.playEffect?.('dual-rumble', { duration: ms, strongMagnitude: strong, weakMagnitude: weak })?.catch?.(() => {}); } catch { /* a stub or an old pad */ }\n}\nE\ncat > src/core/intent.js <<'E'\n// The player reads an Intent, never ctx.input. Human, bot and network all fill the same object.\nexport const PAD_BUTTONS = { 0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle', 4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2', 8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3', 12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight' };\nexport const BIND = {\n  aim: ['PadL2', 'MouseRight'], fire: ['PadR2', 'MouseLeft'], knife: ['PadR1', 'KeyV'], action: ['PadCross', 'KeyE'], run: ['PadCircle', 'ShiftLeft', 'ShiftRight'], turn: ['KeyQ'], reload: ['PadSquare', 'KeyR'],\n  case: ['PadTriangle', 'Tab', 'KeyI'], pause: ['PadOptions', 'Escape', 'KeyP'], map: ['KeyM'], next: ['PadUp'], prev: ['PadDown'], heal: ['PadLeft', 'KeyH'], command: ['PadRight', 'KeyC'], throw: ['PadL1', 'KeyG'], shoulder: ['PadR3', 'KeyT'], dodge: ['PadCircle', 'Space'],\n  confirm: ['PadCross', 'Enter', 'Space'], back: ['PadCircle', 'Escape'], tabPrev: ['PadL1', 'KeyQ'], tabNext: ['PadR1', 'KeyE'], secondary: ['PadSquare', 'KeyR'], tertiary: ['PadTriangle', 'KeyT'], arrange: ['PadR1', 'KeyF'],\n  up: ['PadUp', 'ArrowUp', 'KeyW'], down: ['PadDown', 'ArrowDown', 'KeyS'], left: ['PadLeft', 'ArrowLeft', 'KeyA'], right: ['PadRight', 'ArrowRight', 'KeyD'],\n};\nexport const newIntent = () => ({ moveX: 0, moveY: 0, lookX: 0, lookY: 0, absYaw: null, absPitch: null, aim: false, fire: false, firePressed: false, reload: false, knife: false, action: false, run: false, heal: false, command: false, throw: false, turn: false, next: false, prev: false, slot: -1, shoulder: false, dodge: false, actionHeld: false });\nexport class HumanIntent {\n  constructor() { this.i = newIntent(); this.createHeld = false; this.circleAt = -9; }\n  /** Called each fixed step. Presses via consumePress so none is lost. */\n  fixed(ctx) {\n    const I = ctx.input, i = this.i, m = I.moveAxis();\n    i.moveX = m.x; i.moveY = m.y;\n    i.aim = I.anyDown(BIND.aim);\n    const firing = i.aim ? I.anyDown(BIND.fire) : I.isDown('PadR2');\n    i.firePressed = i.aim ? I.consumeAny(BIND.fire) : false;\n    i.fire = firing;\n    i.knife = I.consumeAny(BIND.knife) || (!i.aim && I.consumePress('MouseLeft'));\n    i.actionHeld = I.anyDown(BIND.action);\n    i.action = I.consumeAny(BIND.action);\n    i.run = I.anyDown(BIND.run);\n    i.dodge = I.consumeAny(BIND.dodge);\n    i.reload = I.consumeAny(BIND.reload);\n    i.heal = I.consumeAny(BIND.heal);\n    i.command = I.consumeAny(BIND.command);\n    i.throw = I.consumeAny(BIND.throw);\n    i.shoulder = I.consumeAny(BIND.shoulder);\n    i.next = I.consumeAny(BIND.next); i.prev = I.consumeAny(BIND.prev);\n    // Quick turn: tap Circle with the stick back, or Q.\n    i.turn = I.consumeAny(BIND.turn) || (i.dodge && m.y < -0.5);\n    for (let k = 1; k <= 4; k++) if (I.consumePress(`Digit${k}`)) i.slot = k - 1;\n    return i;\n  }\n}\nexport class BotIntent { constructor() { this.i = newIntent(); } fixed() { return this.i; } }\nexport class NetIntent { constructor() { this.i = newIntent(); } fixed() { return this.i; } }\nE\ncat > src/core/run.js <<'E'\n// Persistent run state: everything that outlives an Area. Plain data, saved as JSON.\nimport { ITEMS, combineRecipes } from '../data/items.js';\nimport { WEAPONS, WEAPON_ORDER, weaponStats } from '../data/weapons.js';\nimport { DIFFICULTY } from '../data/tuning.js';\nexport function newRun(difficulty = 'standard') {\n  const r = { difficulty, chapter: 1, area: 'quay', entry: null, health: 100, maxHealth: 100, dameHp: null, money: 300, weapon: 'pistol', weapons: { pistol: { ammo: 12, tune: {} } }, grid: { w: 10, h: 6 }, items: [], valuables: [], keys: [], notes: [], tannoys: [], rewards: [], flags: {}, seen: {}, areaFlags: {}, rank: 2, deductions: 0, uid: 1,\n    stats: { time: 0, shots: 0, hits: 0, heads: 0, kicks: 0, kills: 0, deaths: 0, chapterStart: null, tookDamage: 0 }, chapterBase: { time: 0, shots: 0, hits: 0, heads: 0, kicks: 0 }, sockets: { pearl: false, blackpearl: false, amber: false } };\n  place(r, { id: 'pistol' }, 0, 0);\n  addItem(r, 'ammo_pistol', 30);\n  addItem(r, 'samphire');\n  return r;\n}\nexport const diff = (r) => DIFFICULTY[r.difficulty] || DIFFICULTY.standard;\nexport const fp = (it) => { const d = ITEMS[it.id]; return it.rot ? [d.h, d.w] : [d.w, d.h]; };\nfunction occupied(r, ignore) {\n  const g = Array.from({ length: r.grid.h }, () => Array(r.grid.w).fill(false));\n  for (const it of r.items) { if (it === ignore) continue; const [w, h] = fp(it); for (let y = it.y; y < it.y + h; y++) for (let x = it.x; x < it.x + w; x++) if (g[y]) g[y][x] = true; }\n  return g;\n}\nexport function fits(r, it, x, y, ignore = null) {\n  const [w, h] = fp(it); if (x < 0 || y < 0 || x + w > r.grid.w || y + h > r.grid.h) return false;\n  const g = occupied(r, ignore); for (let j = y; j < y + h; j++) for (let i = x; i < x + w; i++) if (g[j][i]) return false; return true;\n}\nfunction place(r, it, x, y) { const item = { uid: r.uid++, id: it.id, x, y, rot: !!it.rot, count: it.count ?? 1 }; r.items.push(item); return item; }\nexport function findSpot(r, id, count = 1) {\n  for (const rot of [false, true]) { const t = { id, rot }; for (let y = 0; y < r.grid.h; y++) for (let x = 0; x < r.grid.w; x++) if (fits(r, t, x, y)) return { x, y, rot }; }\n  return null;\n}\n/** Adds to the Case: stacks first, then new cells. Returns what did not fit. */\nexport function addItem(r, id, count = 1) {\n  const d = ITEMS[id]; if (!d) throw new Error(`no item ${id}`);\n  if (d.kind === 'treasure') { for (let n = 0; n < count; n++) r.valuables.push(id); return 0; }\n  if (d.kind === 'key') { if (!r.keys.includes(id)) r.keys.push(id); return 0; }\n  if (d.kind === 'weapon' && !r.weapons[d.weapon]) r.weapons[d.weapon] = { ammo: WEAPONS[d.weapon].mag, tune: {} };\n  let left = count;\n  if (d.max) for (const it of r.items) if (it.id === id && it.count < d.max) { const n = Math.min(left, d.max - it.count); it.count += n; left -= n; if (!left) return 0; }\n  while (left > 0) {\n    const s = findSpot(r, id); if (!s) return left;\n    const n = d.max ? Math.min(left, d.max) : 1; place(r, { id, rot: s.rot, count: n }, s.x, s.y); left -= n;\n  }\n  return 0;\n}\nexport function removeItem(r, it) { const i = r.items.indexOf(it); if (i >= 0) r.items.splice(i, 1); }\nexport function arrange(r) {\n  const items = [...r.items].sort((a, b) => { const A = ITEMS[a.id], B = ITEMS[b.id]; return B.w * B.h - A.w * A.h || B.h - A.h || a.uid - b.uid; });\n  const copy = r.items; r.items = []; const leftovers = [];\n  for (const it of items) {\n    let done = false;\n    for (const rot of [false, true]) { it.rot = rot; for (let y = 0; y < r.grid.h && !done; y++) for (let x = 0; x < r.grid.w && !done; x++) if (fits(r, it, x, y)) { it.x = x; it.y = y; r.items.push(it); done = true; } if (done) break; }\n    if (!done) leftovers.push(it);\n  }\n  if (leftovers.length) { r.items = copy; return false; }\n  return true;\n}\nexport function ammoOf(r, weaponId) { const a = WEAPONS[weaponId].ammo; return r.items.filter((i) => i.id === a).reduce((n, i) => n + i.count, 0); }\nexport function takeAmmo(r, weaponId, want) {\n  const a = WEAPONS[weaponId].ammo; let got = 0;\n  for (const it of r.items) if (it.id === a && got < want) { const n = Math.min(it.count, want - got); it.count -= n; got += n; }\n  r.items = r.items.filter((i) => !(i.id === a && i.count <= 0));\n  return got;\n}\nexport const statsOf = (r, id) => weaponStats(id, r.weapons[id]?.tune);\nexport const ownedWeapons = (r) => WEAPON_ORDER.filter((w) => r.items.some((i) => i.id === w));\nexport function count(r, id) { return r.items.filter((i) => i.id === id).reduce((n, i) => n + i.count, 0); }\nexport function combine(r, a, b) {\n  const rec = combineRecipes.find((c) => (c.from[0] === a.id && c.from[1] === b.id) || (c.from[0] === b.id && c.from[1] === a.id));\n  if (!rec || a === b) return false;\n  removeItem(r, a); removeItem(r, b);\n  const out = { id: rec.to }; place(r, { id: rec.to, rot: a.rot }, a.x, a.y); return out;\n}\nexport function combinable(r, a) { return r.items.filter((b) => b !== a && combineRecipes.some((c) => (c.from[0] === a.id && c.from[1] === b.id) || (c.from[0] === b.id && c.from[1] === a.id))); }\n/** Use a herb: returns the amount healed or false. */\nexport function useHerb(r, it) {\n  const d = ITEMS[it.id]; if (d.kind !== 'herb' || !d.heal) return false;\n  if (d.maxUp) r.maxHealth += d.maxUp;\n  r.health = Math.min(r.maxHealth, r.health + d.heal * r.maxHealth); removeItem(r, it); return true;\n}\nexport function bestHerb(r) { let best = null; for (const it of r.items) { const d = ITEMS[it.id]; if (d.kind === 'herb' && d.heal && (!best || d.heal < ITEMS[best.id].heal === false)) if (!best || d.heal > ITEMS[best.id].heal) best = it; } return best; }\nexport function socketInto(r, gem) {\n  const i = r.valuables.indexOf(gem); if (i < 0 || !r.valuables.includes('reliquary') || r.sockets[gem] === undefined || r.sockets[gem]) return false;\n  r.valuables.splice(i, 1); r.sockets[gem] = true; return true;\n}\nexport const reliquaryFull = (r) => r.sockets.pearl && r.sockets.blackpearl && r.sockets.amber;\nexport function treasureValue(r, id) { if (id === 'reliquary') return reliquaryFull(r) ? ITEMS.reliquary.full : ITEMS.reliquary.value; return ITEMS[id].value; }\nexport function sellPrice(r, it) {\n  const d = ITEMS[it.id]; if (d.kind === 'weapon') return Math.floor(WEAPONS[d.weapon].price / 2) || 100;\n  if (d.kind === 'ammo') return Math.ceil(d.price / 2 * it.count / d.gives);\n  return d.sell ?? Math.floor((d.price || 100) / 2);\n}\nexport function sellTreasure(r, id) { const i = r.valuables.indexOf(id); if (i < 0) return 0; const v = treasureValue(r, id); r.valuables.splice(i, 1); if (id === 'reliquary') r.sockets = { pearl: false, blackpearl: false, amber: false }; r.money += v; return v; }\nE\ncat > src/core/ui.js <<'E'\n// The pixel UI kit. Immediate mode over ctx.hud. Every screen for every input. Focus by stick or D-pad, hover moves focus, click activates.\nimport { BIND } from './intent.js';\nimport { device } from './device.js';\nexport const FONT_CHARS = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ.,:;-+=/()[]{}%_!?<>#'‘’“”*@°·&|\\\\~^$ \";\nconst up = (s) => String(s).toUpperCase();\nexport class UI {\n  constructor(app) { this.app = app; this.t = 0; this.rects = []; this.holdT = {}; this.px = 0; this.py = 0; this.lastP = [9, 9]; this.hover = false; this.click = false; this.rclick = false; this.wheel = 0; this.nav = {}; this.mouseDown = false; }\n  begin(ctx, clear = true) {\n    this.ctx = ctx; this.hud = ctx.hud; this.input = ctx.input; const dt = 1 / 60; this.t += dt; this.dt = dt; this.W = ctx.hud.width || 480; this.H = ctx.hud.height || 270;\n    if (clear) ctx.hud.clear();\n    const p = this.input.pointer; this.px = (p.x + 1) / 2 * this.W; this.py = (1 - p.y) / 2 * this.H;\n    this.hover = (p.x !== this.lastP[0] || p.y !== this.lastP[1]); this.lastP = [p.x, p.y];\n    this.click = false; this.rclick = false; this.cx = this.px; this.cy = this.py;\n    for (const e of this.input.buttonEvents) if (e.down && (e.code === 'MouseLeft' || e.code === 'Touch')) { this.click = true; this.cx = (e.x + 1) / 2 * this.W; this.cy = (1 - e.y) / 2 * this.H; this.hover = true; } else if (e.down && e.code === 'MouseRight') this.rclick = true;\n    this.mouseDown = this.input.isDown('MouseLeft');\n    this.wheel = this.input.wheel;\n    const I = this.input, down = (a) => I.anyDown(BIND[a]), pressed = (a) => BIND[a].some((c) => I.wasPressed(c));\n    const m = I.padAxis || { x: 0, y: 0 };\n    const dirs = { up: down('up') || m.y > 0.5, down: down('down') || m.y < -0.5, left: down('left') || m.x < -0.5, right: down('right') || m.x > 0.5 };\n    this.nav = {};\n    for (const k in dirs) {\n      if (dirs[k]) { const h = this.holdT[k] ?? -1; if (h < 0) { this.nav[k] = true; this.holdT[k] = 0; } else { this.holdT[k] = h + dt; if (this.holdT[k] > 0.34) { this.nav[k] = true; this.holdT[k] = 0.22; } } } else this.holdT[k] = -1;\n    }\n    this.pressed = pressed;\n    this.confirm = pressed('confirm'); this.back = pressed('back'); this.secondary = pressed('secondary'); this.tertiary = pressed('tertiary');\n    this.tabPrev = pressed('tabPrev'); this.tabNext = pressed('tabNext');\n  }\n  sound(n) { this.ctx.audio.play(n); }\n  text(x, y, s, o = {}) { this.hud.text(Math.round(x), Math.round(y), up(s), o); }\n  center(y, s, o = {}, cx = this.W / 2) { const m = this.hud.measure(up(s), o.scale || 1); this.text(cx - m.width / 2, y, s, o); return m; }\n  measure(s, scale = 1) { return this.hud.measure(up(s), scale); }\n  rect(x, y, w, h, c) { this.hud.rect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), c); }\n  panel(x, y, w, h, o = {}) { this.rect(x, y, w, h, o.bg ?? 'ink'); const b = o.border ?? 'slate'; this.rect(x, y, w, 1, b); this.rect(x, y + h - 1, w, 1, b); this.rect(x, y, 1, h, b); this.rect(x + w - 1, y, 1, h, b); }\n  dim(c = 'ink') { const W = this.W, H = this.H; for (let y = 0; y < H; y += 2) this.rect(0, y, W, 1, c); }\n  within(x, y, w, h, px = this.px, py = this.py) { return px >= x && py >= y && px < x + w && py < y + h; }\n  /** A vertical list. state: {focus}. items: [{label, disabled, color, value}] Returns the activated index or -1. */\n  list(state, items, o = {}) {\n    const x = o.x ?? 40, y = o.y ?? 60, w = o.w ?? 180, rh = o.rowH ?? 16, sc = o.scale ?? 1; state.focus = Math.max(0, Math.min(items.length - 1, state.focus ?? 0));\n    let out = -1; const max = o.max ?? items.length; state.scroll = state.scroll ?? 0;\n    if (!o.noNav) {\n      if (this.nav.up) { state.focus = (state.focus - 1 + items.length) % items.length; this.sound('uimove'); }\n      if (this.nav.down) { state.focus = (state.focus + 1) % items.length; this.sound('uimove'); }\n    }\n    if (this.wheel && !o.noWheel) { state.focus = Math.max(0, Math.min(items.length - 1, state.focus + Math.sign(this.wheel))); }\n    if (state.focus < state.scroll) state.scroll = state.focus; if (state.focus >= state.scroll + max) state.scroll = state.focus - max + 1;\n    for (let vi = 0; vi < Math.min(max, items.length); vi++) {\n      const i = vi + state.scroll, it = items[i], ry = y + vi * rh;\n      if (this.hover && this.within(x, ry - 1, w, rh)) state.focus = i;\n      const on = state.focus === i;\n      if (on) { this.rect(x, ry - 2, w, rh - 1, o.bar ?? 'navy'); this.rect(x, ry - 2, 2, rh - 1, 'orange'); this.text(x + 4, ry + (rh - 4 - 7 * sc) / 2 - 1 , '>', { color: 'orange', scale: 1 }); }\n      this.text(x + 12, ry + (rh - 4 - 7 * sc) / 2 - 1, it.label, { color: it.disabled ? 'slate' : on ? 'white' : (it.color ?? 'mist'), scale: sc });\n      if (it.value != null) { const m = this.measure(it.value, 1); this.text(x + w - m.width - 5, ry + (rh - 4 - 7) / 2 - 1, it.value, { color: it.valueColor ?? (on ? 'sand' : 'slate') }); }\n      if (this.click && this.within(x, ry - 1, w, rh, this.cx, this.cy)) { state.focus = i; if (!it.disabled) out = i; else this.sound('uideny'); }\n    }\n    if (items.length > max) { if (state.scroll > 0) this.text(x + w - 8, y - 11, '^', { color: 'sand' }); if (state.scroll + max < items.length) this.text(x + w - 8, y + max * rh - 2, 'V', { color: 'sand' }); }\n    if (this.confirm && !o.noConfirm) { if (!items[state.focus]?.disabled) out = state.focus; else this.sound('uideny'); }\n    if (out >= 0) this.sound('uiconfirm');\n    return out;\n  }\n  /** Tabs across the top. Returns the current index. */\n  tabs(state, labels, y = 8) {\n    state.tab = state.tab ?? 0;\n    if (this.tabPrev) { state.tab = (state.tab - 1 + labels.length) % labels.length; state.focus = 0; state.scroll = 0; this.sound('uimove'); }\n    if (this.tabNext) { state.tab = (state.tab + 1) % labels.length; state.focus = 0; state.scroll = 0; this.sound('uimove'); }\n    let total = 0; for (const l of labels) total += this.measure(l).width + 10;\n    let x = Math.round(this.W / 2 - total / 2);\n    this.glyph(device.last === 'pad' ? 'PadL1' : 'KeyQ', x - 18, y - 1); this.glyph(device.last === 'pad' ? 'PadR1' : 'KeyE', x + total + 3, y - 1);\n    labels.forEach((l, i) => { const w = this.measure(l).width + 8, on = i === state.tab; if (on) this.rect(x, y - 2, w, 11, 'navy'); this.text(x + 4, y, l, { color: on ? 'white' : 'slate' }); if (this.click && this.within(x, y - 2, w, 11, this.cx, this.cy)) { state.tab = i; state.focus = 0; state.scroll = 0; this.sound('uimove'); } x += w + 2; });\n    return state.tab;\n  }\n  slider(x, y, w, v, min, max, o = {}) {\n    const k = Math.max(0, Math.min(1, (v - min) / (max - min)));\n    this.rect(x, y + 2, w, 3, 'night'); this.rect(x, y + 2, Math.round(w * k), 3, o.color ?? 'sand');\n    if (o.def != null) this.rect(x + Math.round(w * ((o.def - min) / (max - min))), y, 1, 7, 'slate');\n    this.rect(x + Math.round(w * k) - 1, y, 3, 7, 'white');\n    if (this.mouseDown && this.within(x - 2, y - 3, w + 4, 13)) return min + (max - min) * Math.max(0, Math.min(1, (this.px - x) / w));\n    return v;\n  }\n  bar(x, y, w, h, k, c, bg = 'night') { this.rect(x, y, w, h, bg); this.rect(x, y, Math.round(w * Math.max(0, Math.min(1, k))), h, c); }\n  wrap(s, width) { const out = []; let line = ''; for (const w of up(s).split(' ')) { const t = line ? line + ' ' + w : w; if (this.measure(t).width > width && line) { out.push(line); line = w; } else line = t; } if (line) out.push(line); return out; }\n  para(x, y, s, width, o = {}) { const lines = this.wrap(s, width); lines.forEach((l, i) => this.text(x, y + i * (o.lh ?? 10), l, o)); return lines.length; }\n  /** Draws one input glyph at (x, y). Width returned. */\n  glyph(code, x, y) { return drawGlyph(this, code, x, y); }\n  /** Glyph for an action on the current device. */\n  action(a, x, y) { return this.glyph(codeFor(a), x, y); }\n  /** A prompt bar at the bottom. [[action, label], ...] */\n  prompts(list, o = {}) {\n    let total = 0; for (const [a, l] of list) total += glyphWidth(codeFor(a)) + 3 + this.measure(l).width + 10;\n    let x = Math.round(this.W / 2 - total / 2); const y = o.y ?? this.H - 15;\n    if (!o.noBar) this.rect(0, y - 3, this.W, 17, 'ink');\n    for (const [a, l, id] of list) { const gw = this.action(a, x, y - 1); this.text(x + gw + 3, y + 1, l, { color: 'mist' }); const w = gw + 3 + this.measure(l).width; if (id && this.click && this.within(x, y - 3, w, 14, this.cx, this.cy)) this.clickedPrompt = id; x += w + 10; }\n  }\n}\n// ---- Glyphs\nconst KEYNAME = { KeyQ: 'Q', KeyE: 'E', KeyR: 'R', KeyT: 'T', KeyF: 'F', KeyG: 'G', KeyH: 'H', KeyC: 'C', KeyV: 'V', KeyM: 'M', KeyI: 'I', KeyP: 'P', KeyW: 'W', Enter: 'ENTER', Space: 'SPACE', Escape: 'ESC', Tab: 'TAB', ShiftLeft: 'SHIFT', ArrowUp: '^' };\nconst PS = { PadCross: ['blue', 'x'], PadCircle: ['red', 'o'], PadSquare: ['plum', 's'], PadTriangle: ['green', 't'] };\nconst XB = { PadCross: ['green', 'A'], PadCircle: ['red', 'B'], PadSquare: ['blue', 'X'], PadTriangle: ['sand', 'Y'] };\nconst PILL_PS = { PadL1: 'L1', PadR1: 'R1', PadL2: 'L2', PadR2: 'R2', PadOptions: 'OPT', PadCreate: 'CRT', PadR3: 'R3', PadL3: 'L3', PadUp: 'D^', PadDown: 'DV', PadLeft: 'D<', PadRight: 'D>', PadStick: 'LS' };\nconst PILL_XB = { ...PILL_PS, PadL1: 'LB', PadR1: 'RB', PadL2: 'LT', PadR2: 'RT', PadOptions: 'MENU', PadCreate: 'VIEW' };\nconst DISC = ['...xxxxx...', '..xxxxxxx..', '.xxxxxxxxx.', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', 'xxxxxxxxxxx', '.xxxxxxxxx.', '..xxxxxxx..', '...xxxxx...'];\nconst SYM = { x: ['.......', '.w...w.', '..w.w..', '...w...', '..w.w..', '.w...w.', '.......'], o: ['..www..', '.w...w.', 'w.....w', 'w.....w', 'w.....w', '.w...w.', '..www..'], s: ['wwwwwww', 'w.....w', 'w.....w', 'w.....w', 'w.....w', 'w.....w', 'wwwwwww'], t: ['...w...', '..w.w..', '..w.w..', '.w...w.', '.w...w.', 'w.....w', 'wwwwwww'] };\nexport const glyphWidth = (code) => { if (code.startsWith('Mouse')) return 9; if (code in PS) return 11; if (code.startsWith('Pad')) return (({ ...PILL_PS, ...PILL_XB })[code]?.length || 2) * 6 + 3; return Math.max(11, (KEYNAME[code]?.length || 1) * 6 + 5); };\nexport function drawGlyph(ui, code, x, y) {\n  const xbox = ui.app.settings.glyphs === 'xbox';\n  if (code in PS) {\n    const [c, s] = (xbox ? XB : PS)[code];\n    ui.hud.sprite(x, y, DISC, { x: c });\n    if (xbox) ui.hud.text(x + 3, y + 2, s, { color: 'white', shadow: false });\n    else ui.hud.sprite(x + 2, y + 2, SYM[s], { w: 'white' });\n    return 11;\n  }\n  if (code.startsWith('Pad')) {\n    const t = (xbox ? PILL_XB : PILL_PS)[code] || '?', w = t.length * 6 + 3;\n    ui.rect(x, y + 1, w, 9, 'slate'); ui.hud.text(x + 2, y + 2, t, { color: 'white', shadow: false }); return w;\n  }\n  if (code.startsWith('Mouse')) {\n    const L = code === 'MouseLeft', R = code === 'MouseRight', W = code === 'MouseWheel';\n    ui.hud.sprite(x, y, ['..mmmmm..', '.lll#rrr.', '.lll#rrr.', '.lll#rrr.', '.mmmmmmm.', '.mmmmmmm.', '.mmmmmmm.', '.mmmmmmm.', '.mmmmmmm.', '..mmmmm..', '.........'], { m: 'mist', l: L ? 'orange' : 'mist', r: R ? 'orange' : 'mist', '#': W ? 'orange' : 'slate' });\n    return 9;\n  }\n  const t = KEYNAME[code] ?? code.replace('Key', '').replace('Digit', ''), w = Math.max(11, t.length * 6 + 5);\n  ui.rect(x, y, w, 11, 'mist'); ui.rect(x + 1, y + 1, w - 2, 9, 'ink'); ui.hud.text(x + Math.round((w - t.length * 6 + 1) / 2), y + 2, t, { color: 'white', shadow: false });\n  return w;\n}\n/** The code to show for an action on the current device. */\nexport function codeFor(a) {\n  const list = BIND[a] || [a];\n  const pad = device.last === 'pad';\n  const hit = list.find((c) => (pad ? c.startsWith('Pad') : !c.startsWith('Pad')));\n  return hit ?? (a.startsWith('Pad') || a.startsWith('Key') || a.startsWith('Mouse') ? a : list[0]);\n}\nE\ncat \"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-162048__xa8053f/tmp/claude-1000/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-162048--xa8053f-work/76d12802-c986-437e-adae-1ae347966275/tasks/br8csve2l.output\" | cut -c1-200 | tail -30","description":"Write core modules: save, device, intent, run state, UI kit"}}}
