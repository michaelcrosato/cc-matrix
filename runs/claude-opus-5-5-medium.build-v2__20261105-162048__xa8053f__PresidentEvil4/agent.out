sy() { const b\"\"\")\n# fight logic\na=s.index(\"    const close = a.enemies.filter\"); b=s.index(\"    this.aimAt(A, i); i.aim = true;\")\ns=s[:a]+\"\"\"    const close = a.enemies.filter((x) => !x.dead && !x.crawler && x.state !== 'STUN' && x.state !== 'KNEEL' && x.pos.distanceTo(P.pos) < 2.6).length;\n    if (P.limpets > 0 && a.interact.best) { i.action = true; return; }\n    const stun = a.enemies.find((x) => !x.dead && (x.kickable() || x.takedownable()) && x.pos.distanceTo(P.pos) < 6);\n    if (stun && !close) { const L = Math.hypot(stun.pos.x - P.pos.x, stun.pos.z - P.pos.z) || 1; this.moveDir((stun.pos.x - P.pos.x) / L, (stun.pos.z - P.pos.z) / L, i, true); return; }\n    if (close >= 1 || (e && e.def.saw && dist < 4.5) || (a.boss && a.boss.pos && !a.boss.dead && a.boss.pos.distanceTo(P.pos) < 5.5 && !['KNEEL', 'SAG', 'MOTHER'].includes(a.boss.state))) { this.flee(dt, i); return; }\n\"\"\"+s[b:]\ns=s.replace(\"\"\"const tgt = this.chooseTarget(); if (tgt) { this.fight(tgt, dt, i); return; }\"\"\",\"\"\"const tgt = this.hasAmmo() ? this.chooseTarget() : null; const lootFirst = !this.hasAmmo() && this.lootGoal(); if (lootFirst) { this.pursue(lootFirst, dt, i); return; } if (tgt) { this.fight(tgt, dt, i); return; } if (!this.hasAmmo() && a.enemies.some((x) => !x.dead && x.pos.distanceTo(P.pos) < 5)) { this.flee(dt, i); return; }\"\"\")\ns=s.replace(\"\"\"let best = null, bd = 14; for (const d of a.drops) {\"\"\",\"\"\"let best = null, bd = 14; for (const it of a.interact.items) { if (it.verb !== 'OPEN' || it.floor !== P.floor) continue; const k = Math.hypot(it.x - P.pos.x, it.z - P.pos.z); if (k < bd) { const c = a.navOf(P.floor, 0).path([P.pos.x, 0, P.pos.z], [it.x, 0, it.z]); if (c) { bd = k; best = { x: it.x, z: it.z, it }; } } } if (best) { best.it.tries = (best.it.tries ?? 0) + 1; if (best.it.tries < 400) return { x: best.x, z: best.z, r: 1.1, press: true, pressAny: true }; } best = null; for (const d of a.drops) {\"\"\")\ns=s.replace(\"export function bot