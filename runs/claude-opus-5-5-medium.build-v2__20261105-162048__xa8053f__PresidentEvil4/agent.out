{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgBZ6d63z8oHshY7FBz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013NPd7YgA7p5eJZfZEG9u2u","name":"Bash","input":{"command":"cat > src/models/icons.js <<'E'\n// Item icons as TextureDefs with SVG path layers, read through hudSprite. Sized to their Case footprint (14 art px a cell).\nimport { hudSprite, textureDef } from '../../pixel-engine.js';\nconst T = (id, w, h, palette, layers) => textureDef({ id: `icon-${id}`, about: `Icon for ${id}`, tags: ['icon'], size: [w, h], palette, layers });\nconst R = (x, y, w, h) => `M${x} ${y} H${x + w} V${y + h} H${x} Z`;\nconst gun = { steel: 'slate', hi: 'mist', wood: 'orange', dark: 'night' };\nexport const ICON_DEFS = {\n  pistol: T('pistol', 42, 28, gun, [{ path: `${R(6, 7, 30, 6)}`, fill: 'steel' }, { path: R(14, 5, 12, 11), fill: 'hi' }, { path: 'M12 13 L22 13 L18 25 L8 25 Z', fill: 'wood' }, { path: R(6, 8, 30, 1), fill: 'hi' }, { path: R(20, 13, 6, 5), fill: 'dark' }]),\n  scatter: T('scatter', 98, 28, gun, [{ path: R(26, 8, 66, 5), fill: 'steel' }, { path: R(40, 13, 22, 5), fill: 'wood' }, { path: 'M4 10 L28 8 L28 16 L14 22 L4 22 Z', fill: 'wood' }, { path: R(26, 8, 66, 1), fill: 'hi' }, { path: R(88, 6, 3, 2), fill: 'hi' }]),\n  rifle: T('rifle', 112, 28, gun, [{ path: R(24, 10, 84, 3), fill: 'steel' }, { path: 'M4 12 L34 10 L70 12 L70 16 L34 16 L16 23 L4 23 Z', fill: 'dark' }, { path: R(36, 4, 28, 4), fill: 'hi' }, { path: R(44, 8, 3, 2), fill: 'steel' }, { path: R(58, 8, 3, 2), fill: 'steel' }]),\n  harpoon: T('harpoon', 84, 28, gun, [{ path: R(10, 12, 50, 7), fill: 'wood' }, { path: R(14, 9, 66, 3), fill: 'hi' }, { path: 'M74 6 L82 10 L74 15 Z', fill: 'hi' }, { path: R(44, 3, 3, 22), fill: 'steel' }, { path: 'M16 19 L24 19 L20 26 L12 26 Z', fill: 'wood' }]),\n  ammo_pistol: T('ammo_pistol', 28, 14, { box: 'sand', dark: 'night', hi: 'white' }, [{ path: R(3, 3, 22, 9), fill: 'box' }, { path: R(3, 7, 22, 2), fill: 'dark' }, { path: R(6, 4, 3, 2), fill: 'hi' }]),\n  ammo_shells: T('ammo_shells', 28, 14, { a: 'red', b: 'sand' }, [{ path: `${R(3, 2, 6, 10)}${R(11, 2, 6, 10)}${R(19, 2, 6, 10)}`, fill: 'a' }, { path: `${R(3, 9, 6, 3)}${R(11, 9, 6, 3)}${R(19, 9, 6, 3)}`, fill: 'b' }]),\n  ammo_rifle: T('ammo_rifle', 28, 14, { a: 'sand', b: 'orange' }, [{ path: `${R(3, 3, 3, 9)}${R(8, 3, 3, 9)}${R(13, 3, 3, 9)}${R(18, 3, 3, 9)}`, fill: 'a' }, { path: `${R(3, 1, 3, 2)}${R(8, 1, 3, 2)}${R(13, 1, 3, 2)}${R(18, 1, 3, 2)}`, fill: 'b' }]),\n  ammo_bolts: T('ammo_bolts', 42, 14, { a: 'mist', b: 'white' }, [{ path: `${R(3, 3, 32, 2)}${R(3, 9, 32, 2)}`, fill: 'a' }, { path: 'M35 1 L40 4 L35 7 Z M35 7 L40 10 L35 13 Z', fill: 'b' }]),\n  samphire: T('samphire', 14, 28, { a: 'green', b: 'lime' }, [{ path: `${R(6, 4, 2, 21)}`, fill: 'a' }, { path: 'M7 8 L12 4 L12 9 Z M7 13 L2 9 L2 14 Z M7 18 L12 14 L12 19 Z', fill: 'b' }]),\n  dulse: T('dulse', 14, 28, { a: 'plum', b: 'red' }, [{ path: 'M7 25 L3 16 L7 5 L11 16 Z', fill: 'b' }, { path: R(6, 12, 2, 13), fill: 'a' }]),\n  holly: T('holly', 14, 28, { a: 'sand', b: 'orange' }, [{ path: 'M7 4 L12 12 L7 25 L2 12 Z', fill: 'a' }, { path: R(6, 8, 2, 16), fill: 'b' }]),\n  mix_ss: T('mix_ss', 14, 28, { a: 'lime', b: 'white', c: 'green' }, [{ path: R(3, 6, 8, 19), fill: 'c' }, { path: R(4, 9, 6, 15), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }]),\n  mix_sss: T('mix_sss', 14, 28, { a: 'cyan', b: 'white', c: 'green' }, [{ path: R(3, 6, 8, 19), fill: 'c' }, { path: R(4, 9, 6, 15), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }]),\n  mix_sd: T('mix_sd', 14, 28, { a: 'orange', b: 'white', c: 'plum' }, [{ path: R(3, 6, 8, 19), fill: 'c' }, { path: R(4, 9, 6, 15), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }]),\n  mix_sdh: T('mix_sdh', 14, 28, { a: 'sand', b: 'white', c: 'orange' }, [{ path: R(3, 6, 8, 19), fill: 'c' }, { path: R(4, 9, 6, 15), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }]),\n  firstaid: T('firstaid', 14, 28, { a: 'white', b: 'red' }, [{ path: R(2, 6, 10, 16), fill: 'a' }, { path: `${R(6, 8, 2, 12)}${R(3, 13, 8, 2)}`, fill: 'b' }]),\n  flare: T('flare', 14, 28, { a: 'red', b: 'white' }, [{ path: R(4, 6, 6, 19), fill: 'a' }, { path: R(4, 3, 6, 4), fill: 'b' }]),\n  depth: T('depth', 14, 28, { a: 'night', b: 'sand' }, [{ path: R(2, 7, 10, 16), fill: 'a' }, { path: `${R(2, 10, 10, 2)}${R(2, 19, 10, 2)}`, fill: 'b' }]),\n  oil: T('oil', 14, 28, { a: 'lime', b: 'sand', c: 'orange' }, [{ path: R(3, 11, 8, 14), fill: 'a' }, { path: R(5, 6, 4, 6), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }, { path: R(6, 1, 2, 2), fill: 'c' }]),\n  pearl: T('pearl', 28, 28, { a: 'white', b: 'mist' }, [{ path: 'M14 6 L20 9 L22 14 L20 19 L14 22 L8 19 L6 14 L8 9 Z', fill: 'b' }, { path: 'M10 9 L15 8 L14 13 L9 13 Z', fill: 'a' }]),\n  blackpearl: T('blackpearl', 28, 28, { a: 'slate', b: 'ink', c: 'plum' }, [{ path: 'M14 6 L20 9 L22 14 L20 19 L14 22 L8 19 L6 14 L8 9 Z', fill: 'c' }, { path: 'M10 9 L15 8 L14 13 L9 13 Z', fill: 'a' }]),\n  seaglass: T('seaglass', 28, 28, { a: 'cyan', b: 'lime', c: 'sky' }, [{ path: 'M4 12 L12 8 L14 16 L6 20 Z', fill: 'a' }, { path: 'M14 6 L24 8 L22 15 L15 13 Z', fill: 'b' }, { path: 'M15 16 L24 18 L20 24 L13 22 Z', fill: 'c' }]),\n  amber: T('amber', 28, 28, { a: 'orange', b: 'sand', c: 'night' }, [{ path: 'M14 4 L23 11 L19 23 L9 23 L5 11 Z', fill: 'a' }, { path: 'M9 9 L14 7 L12 13 Z', fill: 'b' }, { path: R(13, 14, 3, 3), fill: 'c' }]),\n  tusk: T('tusk', 28, 28, { a: 'white', b: 'slate' }, [{ path: 'M4 24 C8 14 14 6 24 4 C22 12 16 22 8 26 Z', fill: 'a' }, { path: R(11, 14, 5, 2), fill: 'b' }]),\n  goldtooth: T('goldtooth', 28, 28, { a: 'sand', b: 'orange' }, [{ path: 'M8 7 L20 7 L20 15 L18 23 L15 16 L13 16 L10 23 L8 15 Z', fill: 'a' }, { path: R(10, 9, 3, 3), fill: 'b' }]),\n  reliquary: T('reliquary', 28, 28, { a: 'orange', b: 'sand', c: 'ink' }, [{ path: R(5, 9, 18, 14), fill: 'a' }, { path: 'M5 9 L14 3 L23 9 Z', fill: 'b' }, { path: `${R(8, 13, 3, 3)}${R(13, 13, 3, 3)}${R(18, 13, 3, 3)}`, fill: 'c' }]),\n  coldkey: T('coldkey', 28, 28, { a: 'cyan', b: 'white' }, [{ path: `${R(12, 5, 4, 14)}${R(16, 15, 5, 2)}${R(16, 11, 4, 2)}`, fill: 'a' }, { path: 'M8 18 L20 18 L20 25 L8 25 Z', fill: 'b' }]),\n  chart: T('chart', 28, 28, { a: 'sand', b: 'plum', c: 'red' }, [{ path: R(4, 5, 20, 18), fill: 'a' }, { path: 'M8 10 L18 9 L20 18 L10 19 Z', fill: 'b' }, { path: R(12, 12, 3, 3), fill: 'c' }]),\n  case1: T('case1', 28, 28, { a: 'slate', b: 'sand', c: 'night' }, [{ path: R(4, 9, 20, 14), fill: 'a' }, { path: R(10, 5, 8, 4), fill: 'c' }, { path: `${R(7, 11, 3, 3)}${R(18, 11, 3, 3)}`, fill: 'b' }]),\n  case2: T('case2', 28, 28, { a: 'mist', b: 'orange', c: 'night' }, [{ path: R(3, 8, 22, 16), fill: 'a' }, { path: R(10, 4, 8, 4), fill: 'c' }, { path: `${R(6, 10, 3, 3)}${R(19, 10, 3, 3)}`, fill: 'b' }]),\n  helmet: T('helmet', 32, 32, { a: 'orange', b: 'sand', c: 'lime', d: 'night' }, [{ path: 'M16 2 L24 5 L29 12 L29 22 L24 28 L8 28 L3 22 L3 12 L8 5 Z', fill: 'a' }, { path: 'M16 8 L22 11 L24 16 L22 21 L16 24 L10 21 L8 16 L10 11 Z', fill: 'b' }, { path: 'M16 10 L21 12 L22 16 L21 20 L16 22 L11 20 L10 16 L11 12 Z', fill: 'c' }, { path: R(8, 27, 16, 4), fill: 'd' }]),\n  pym: T('pym', 32, 32, { a: 'sand', b: 'night', c: 'white', d: 'navy' }, [{ path: R(8, 6, 16, 16), fill: 'a' }, { path: R(8, 4, 16, 5), fill: 'b' }, { path: `${R(10, 12, 5, 4)}${R(17, 12, 5, 4)}`, fill: 'c' }, { path: R(4, 22, 24, 10), fill: 'd' }, { path: R(14, 22, 4, 8), fill: 'c' }]),\n  max: T('max', 32, 32, { a: 'mist', b: 'sand', c: 'ink', d: 'red', e: 'slate' }, [{ path: R(8, 6, 16, 16), fill: 'a' }, { path: R(7, 3, 18, 6), fill: 'b' }, { path: R(8, 12, 16, 4), fill: 'c' }, { path: R(6, 21, 20, 4), fill: 'd' }, { path: R(4, 25, 24, 7), fill: 'e' }]),\n};\nconst CACHE = {};\nconst GROUP = { };\nexport function iconFor(id, rot = false) {\n  const k = id + (rot ? ':r' : ''); if (CACHE[k]) return CACHE[k];\n  const base = hudSprite(ICON_DEFS[id] ?? ICON_DEFS.chart); let rows = base.rows;\n  if (rot) { const w = rows[0].length, h = rows.length, out = []; for (let x = 0; x < w; x++) { let s = ''; for (let y = h - 1; y >= 0; y--) s += rows[y][x]; out.push(s); } rows = out; }\n  return (CACHE[k] = { rows, colors: base.colors, w: rows[0].length, h: rows.length });\n}\nE\ncat > src/screens/pause.js <<'E'\nimport { SettingsScreen } from './settings.js';\nimport { DevScreen } from './dev.js';\nexport class PauseMenu {\n  constructor(A) { this.A = A; this.s = { focus: 0 }; this.ctx = A.ctx; }\n  update(ui) {\n    const A = this.A, inSession = A.app.session?.hub;\n    if (this.sub) { this.sub.update(ui); if (this.sub.done) this.sub = null; return; }\n    ui.dim(); ui.center(36, 'PAUSED', { scale: 2, color: 'sand' }); ui.center(58, A.objective, { color: 'mist' });\n    const items = [{ label: 'RESUME' }, { label: 'SETTINGS' }]; if (!inSession) items.push({ label: 'RESTART FROM CHECKPOINT' }, { label: 'DEV MODE' }, { label: 'QUIT TO TITLE' });\n    const i = ui.list(this.s, items, { x: ui.W / 2 - 100, y: 80, w: 200, rowH: 18 });\n    ui.prompts([['confirm', 'SELECT'], ['back', 'RESUME']]);\n    if (i === 0 || ui.back) { A.closeMenu(); return; }\n    if (i === 1) this.sub = new SettingsScreen(A.app);\n    if (i === 2) { A.menu = null; A.ctx.engine.timeScale = 1; A.app.restartCheckpoint(); }\n    if (i === 3) this.sub = new DevScreen(A);\n    if (i === 4) { A.menu = null; A.ctx.engine.timeScale = 1; A.app.goTitle(); }\n  }\n}\nE\ncat > src/screens/denied.js <<'E'\n// CLAIM DENIED: a big rubber stamp, then Continue or Quit.\nexport class DeniedScreen {\n  constructor(A, reason) { this.A = A; this.reason = reason; this.s = { focus: 0 }; this.t = 0; A.ctx.audio.play('stamp'); A.ctx.engine.shake.add(0.6); }\n  update(ui) {\n    this.t += 1 / 60; const A = this.A; ui.dim(); const k = Math.min(1, this.t / 0.14), sc = k < 1 ? 5 : 4; const m = ui.measure('CLAIM DENIED', 4); const w = m.width + 16, x = ui.W / 2 - w / 2, y = 54;\n    for (let j = 0; j < 2; j++) { ui.rect(x - j, y - j, w + j * 2, 1, 'red'); ui.rect(x - j, y + 44 + j, w + j * 2, 1, 'red'); ui.rect(x - j, y - j, 1, 45 + j * 2, 'red'); ui.rect(x + w - 1 + j, y - j, 1, 45 + j * 2, 'red'); }\n    ui.center(y + 8, 'CLAIM DENIED', { scale: 4, color: 'red' }); ui.center(y + 52, this.reason, { color: 'mist' });\n    if (this.t < 0.7) return;\n    const i = ui.list(this.s, [{ label: 'CONTINUE' }, { label: 'QUIT TO TITLE' }], { x: ui.W / 2 - 80, y: 136, w: 160, rowH: 18 });\n    ui.prompts([['confirm', 'SELECT']]);\n    if (i === 0) { A.menu = null; A.ctx.engine.timeScale = 1; A.app.restartCheckpoint(); }\n    if (i === 1) { A.menu = null; A.ctx.engine.timeScale = 1; A.app.goTitle(); }\n  }\n}\nE\ncat > src/screens/form.js <<'E'\n// The Claim Form: five big lines and a rubber stamp.\nexport function gradeOf(stats) { const acc = stats.shots ? stats.hits / stats.shots : 0; return acc > 0.65 && stats.deaths < 2 ? 'APPROVED' : acc > 0.4 ? 'PENDING' : 'DENIED'; }\nconst mmss = (t) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`;\nexport class FormScreen {\n  constructor(A, next, o = {}) {\n    this.A = A; this.next = next; this.t = 0; this.title = o.title ?? `CLAIM FORM ${A.run.chapter}`; const r = A.run, b = r.chapterBase, S = r.stats;\n    this.c = { time: S.time - b.time, shots: S.shots - b.shots, hits: S.hits - b.hits, heads: S.heads - b.heads, kicks: S.kicks - b.kicks, deaths: S.deaths - (b.deaths ?? 0) };\n    this.grade = gradeOf(this.c); this.bonus = { APPROVED: 1500, PENDING: 800, DENIED: 300 }[this.grade]; r.money += this.bonus; r.chapterBase = { ...S }; this.stamped = false;\n  }\n  update(ui) {\n    this.t += 1 / 60; const c = this.c, r = this.A.run; ui.rect(0, 0, ui.W, ui.H, 'ink'); const W = 300, x = ui.W / 2 - W / 2; ui.rect(x, 16, W, ui.H - 46, 'sand'); ui.rect(x + 3, 19, W - 6, ui.H - 52, 'white');\n    ui.center(26, 'OSTRANDER MUTUAL ASSURANCE', { color: 'plum', shadow: false }); ui.center(38, this.title, { scale: 2, color: 'ink', shadow: false });\n    const acc = c.shots ? Math.round((c.hits / c.shots) * 100) : 0; const lines = [['TIME', mmss(c.time)], ['ACCURACY', `${acc}%`], ['HEADSHOTS', c.heads], ['KICKS', c.kicks], ['DEDUCTIONS', `-${r.deductions}`]];\n    lines.forEach(([k, v], i) => { if (this.t < 0.2 + i * 0.2) return; const y = 66 + i * 21; ui.text(x + 16, y, k, { scale: 2, color: 'navy', shadow: false }); const m = ui.measure(v, 2); ui.text(x + W - 16 - m.width, y, v, { scale: 2, color: 'ink', shadow: false }); });\n    if (this.t > 1.5) { if (!this.stamped) { this.stamped = true; ui.ctx.audio.play('stamp'); ui.ctx.engine.shake.add(0.5); } const col = { APPROVED: 'green', PENDING: 'orange', DENIED: 'red' }[this.grade]; const m = ui.measure(this.grade, 3); const sx = x + W - m.width - 30, sy = 172; for (let j = 0; j < 2; j++) { ui.rect(sx - 4 - j, sy - 4 - j, m.width + 8 + j * 2, 1, col); ui.rect(sx - 4 - j, sy + 25 + j, m.width + 8 + j * 2, 1, col); ui.rect(sx - 4 - j, sy - 4 - j, 1, 29 + j * 2, col); ui.rect(sx + m.width + 3 + j, sy - 4 - j, 1, 29 + j * 2, col); } ui.text(sx, sy, this.grade, { scale: 3, color: col, shadow: false }); ui.text(x + 16, 182, `BONUS ${this.bonus} D`, { color: 'plum', shadow: false }); }\n    if (this.t > 1.8) { ui.prompts([['confirm', 'FILE IT']]); if (ui.confirm || ui.click) { const A = this.A; A.menu = null; A.ctx.engine.timeScale = 1; this.next(); } }\n  }\n}\nE\ncat > src/screens/case.js <<'E'\n// The Case: an Ostrander Mutual sample case. Tabs: CASE, VALUABLES, KEY ITEMS, MAP, FILES, RADIO. Time frozen.\nimport { ITEMS } from '../data/items.js';\nimport { WEAPONS } from '../data/weapons.js';\nimport { NOTES } from '../data/notes.js';\nimport { PYM_HINTS } from '../data/dialogue.js';\nimport { addItem, arrange, combinable, combine, fits, fp, removeItem, socketInto, treasureValue, useHerb, reliquaryFull } from '../core/run.js';\nimport { device } from '../core/device.js';\nimport { iconFor } from '../models/icons.js';\nimport { pymLine } from '../game/director.js';\nconst CELL = 14; const TABS = ['CASE', 'VALUABLES', 'KEY ITEMS', 'MAP', 'FILES', 'RADIO'];\nexport function openCase(A, o = {}) { A.openMenu(new CaseScreen(A, o)); }\nexport const openMapTab = (A) => openCase(A, { tab: 3 });\nexport class CaseScreen {\n  constructor(A, o) { this.A = A; this.s = { tab: o.tab ?? 0, focus: 0 }; this.cx = 0; this.cy = 0; this.held = null; this.menu = null; this.incoming = o.incoming ?? null; this.r1 = 0; if (o.focusNote) this.s.focus = A.run.notes.indexOf(o.focusNote); if (o.incoming) { this.held = { id: o.incoming.id, count: o.incoming.count, rot: false, fresh: true }; } if (this.A.ctx.audio) this.A.ctx.audio.play('uiconfirm'); }\n  close() { const A = this.A; if (this.held) { if (this.held.orig) { Object.assign(this.held.orig, { x: this.held.ox, y: this.held.oy, rot: this.held.orot }); A.run.items.push(this.held.orig); } this.held = null; } if (this.incoming) this.incoming = null; A.closeMenu(); A.ctx.audio.play('uiback'); }\n  update(ui) {\n    const A = this.A, run = A.run; ui.rect(0, 0, ui.W, ui.H, 'ink');\n    // R1 tap changes tab; hold arranges (CASE tab).\n    if (this.s.tab === 0) { const I = ui.input; if (I.isDown('PadR1')) { this.r1 += 1 / 60; if (this.r1 > 0.45 && !this.arrDone) { this.arrDone = true; this.doArrange(); } ui.tabNext = false; } else { if (this.r1 > 0 && this.r1 <= 0.45) ui.tabNext = true; else if (I.wasPressed('KeyE')) ui.tabNext = true; else ui.tabNext = false; this.r1 = 0; this.arrDone = false; } }\n    if (!this.menu && !this.held) ui.tabs(this.s, TABS, 10);\n    const tab = this.s.tab; ui.text(ui.W - 66, ui.H - 26, `${run.money} D`, { color: 'sand' });\n    if (tab === 0) this.caseTab(ui); else if (tab === 1) this.listTab(ui, run.valuables, 'treasure'); else if (tab === 2) this.listTab(ui, run.keys, 'key'); else if (tab === 3) this.mapTab(ui); else if (tab === 4) this.filesTab(ui); else this.radioTab(ui);\n    if (ui.back && !this.menu && !this.held) this.close(); else if (ui.back && this.menu) { this.menu = null; ui.back = false; ui.sound('uiback'); } else if (ui.back && this.held && !this.menu) this.cancelHeld(ui);\n    if (BIND_CLOSE(ui) && !this.held && !this.menu) this.close();\n  }\n  cancelHeld(ui) { const h = this.held; if (h.orig) { Object.assign(h.orig, { x: h.ox, y: h.oy, rot: h.orot }); this.A.run.items.push(h.orig); this.held = null; } else if (h.fresh) { this.held = null; this.incoming = null; this.close(); } ui.sound('uiback'); }\n  doArrange() { const r = this.A.run; if (arrange(r)) this.A.ctx.audio.play('uiconfirm'); else this.A.ctx.audio.play('uideny'); }\n  caseTab(ui) {\n    const A = this.A, run = A.run, G = run.grid, gx = 18, gy = 34, gw = G.w * CELL, gh = G.h * CELL;\n    ui.panel(gx - 2, gy - 2, gw + 4, gh + 4, { bg: 'night', border: 'slate' });\n    for (let y = 0; y < G.h; y++) for (let x = 0; x < G.w; x++) { ui.rect(gx + x * CELL, gy + y * CELL, CELL - 1, CELL - 1, 'navy'); }\n    for (const it of run.items) { const [w, h] = fp(it), px = gx + it.x * CELL, py = gy + it.y * CELL; ui.rect(px, py, w * CELL - 1, h * CELL - 1, run.weapon === it.id ? 'plum' : 'night'); const ic = iconFor(it.id, it.rot); ui.hud.sprite(px, py, ic.rows, ic.colors); if (ITEMS[it.id].max) ui.text(px + 1, py + h * CELL - 9, String(it.count), { color: 'white' }); }\n    // Cursor\n    if (!this.menu) {\n      if (ui.nav.left) this.cx--; if (ui.nav.right) this.cx++; if (ui.nav.up) this.cy--; if (ui.nav.down) this.cy++;\n      if (Object.keys(ui.nav).length) ui.sound('uimove');\n      if (ui.hover && ui.within(gx, gy, gw, gh)) { this.cx = Math.floor((ui.px - gx) / CELL); this.cy = Math.floor((ui.py - gy) / CELL); }\n      this.cx = Math.max(0, Math.min(G.w - 1, this.cx)); this.cy = Math.max(0, Math.min(G.h - 1, this.cy));\n    }\n    const under = run.items.find((it) => { const [w, h] = fp(it); return this.cx >= it.x && this.cx < it.x + w && this.cy >= it.y && this.cy < it.y + h; });\n    const focus = this.held ?? under;\n    if (this.held) {\n      const h = this.held, [w, hh] = fp(h); const nx = Math.min(this.cx, G.w - w), ny = Math.min(this.cy, G.h - hh); const ok = fits(run, h, Math.max(0, nx), Math.max(0, ny)); const px = gx + Math.max(0, nx) * CELL, py = gy + Math.max(0, ny) * CELL;\n      ui.rect(px - 1, py - 1, w * CELL + 1, hh * CELL + 1, ok ? 'green' : 'red'); ui.rect(px, py, w * CELL - 1, hh * CELL - 1, 'night'); const ic = iconFor(h.id, h.rot); ui.hud.sprite(px, py, ic.rows, ic.colors);\n      if (ui.secondary || ui.rclick || ui.wheel) { h.rot = !h.rot; ui.sound('uimove'); }\n      if (ui.confirm || (ui.click && ui.within(gx, gy, gw, gh, ui.cx, ui.cy))) {\n        if (ok) { this.placeHeld(Math.max(0, nx), Math.max(0, ny), ui); } else ui.sound('uideny');\n      }\n      if (ui.tertiary) this.dropHeld(ui);\n    } else if (this.menu) { this.itemMenu(ui, gx, gy); } else {\n      const px = gx + this.cx * CELL, py = gy + this.cy * CELL; const bl = Math.floor(ui.t * 4) % 2 ? 'sand' : 'white';\n      if (under) { const [w, h] = fp(under); const ux = gx + under.x * CELL, uy = gy + under.y * CELL, uw = w * CELL - 1, uh = h * CELL - 1; ui.rect(ux, uy, uw, 1, bl); ui.rect(ux, uy + uh, uw, 1, bl); ui.rect(ux, uy, 1, uh, bl); ui.rect(ux + uw, uy, 1, uh + 1, bl); } else { ui.rect(px, py, CELL - 1, 1, bl); ui.rect(px, py + CELL - 2, CELL - 1, 1, bl); ui.rect(px, py, 1, CELL - 1, bl); ui.rect(px + CELL - 2, py, 1, CELL - 1, bl); }\n      if ((ui.confirm || (ui.click && ui.within(gx, gy, gw, gh, ui.cx, ui.cy))) && under) { this.menu = { it: under, s: { focus: 0 }, mode: 'root' }; ui.confirm = false; ui.click = false; ui.sound('uiconfirm'); }\n      else if (ui.secondary && under) this.pickUp(under, ui);\n      else if (ui.tertiary && under) { this.pickUp(under, ui); this.dropHeld(ui); }\n      if (ui.input.wasPressed('KeyF')) this.doArrange();\n    }\n    this.infoPanel(ui, focus, gx + gw + 14, gy);\n    const pr = this.held ? [['confirm', 'PLACE'], ['secondary', 'ROTATE'], ['tertiary', 'DROP'], ['back', 'CANCEL']] : this.menu ? [['confirm', 'SELECT'], ['back', 'BACK']] : [['confirm', 'USE'], ['secondary', 'MOVE'], ['tertiary', 'DROP'], [device.last === 'pad' ? 'PadR1' : 'KeyF', 'HOLD: ARRANGE'], ['back', 'CLOSE']];\n    if (this.incoming && this.held?.fresh) ui.center(gy + gh + 8, 'NO ROOM. PLACE IT, OR LEAVE IT ON THE GROUND.', { color: 'orange' });\n    ui.prompts(pr);\n  }\n  pickUp(it, ui) { const r = this.A.run; removeItem(r, it); this.held = { id: it.id, rot: it.rot, count: it.count, orig: it, ox: it.x, oy: it.y, orot: it.rot }; ui.sound('uimove'); }\n  placeHeld(x, y, ui) {\n    const A = this.A, run = A.run, h = this.held; ui.sound('uiconfirm');\n    if (h.orig) { Object.assign(h.orig, { x, y, rot: h.rot }); run.items.push(h.orig); }\n    else { run.items.push({ uid: run.uid++, id: h.id, x, y, rot: h.rot, count: h.count ?? 1 }); if (this.incoming) { A.finishDrop(this.incoming); this.incoming = null; } }\n    this.held = null;\n  }\n  dropHeld(ui) {\n    const A = this.A, h = this.held, P = A.player; const d = ITEMS[h.id];\n    if (h.fresh) { this.held = null; this.incoming = null; this.close(); return; }\n    if (d.kind === 'weapon' && A.run.items.filter((i) => ITEMS[i.id].kind === 'weapon').length === 0) { ui.sound('uideny'); return; }\n    A.spawnDrop(P.pos.x + Math.sin(P.yaw) * 0.9, P.pos.z + Math.cos(P.yaw) * 0.9, { id: h.id, count: h.count ?? 1 }); if (A.run.weapon === h.id) { const w = A.run.items.find((i) => ITEMS[i.id].kind === 'weapon'); if (w) P.setWeapon(w.id); }\n    this.held = null; ui.sound('uiback');\n  }\n  itemMenu(ui, gx, gy) {\n    const A = this.A, run = A.run, M = this.menu, it = M.it, d = ITEMS[it.id]; const x = gx + 30, y = gy + 24;\n    if (M.mode === 'root') {\n      const list = []; if (d.kind === 'weapon') list.push({ label: run.weapon === it.id ? 'EQUIPPED' : 'EQUIP', disabled: run.weapon === it.id, go: 'equip' }); if (d.kind === 'herb') list.push({ label: 'USE', disabled: !d.heal, go: 'use' }); if (combinable(run, it).length) list.push({ label: 'COMBINE', go: 'combine' }); list.push({ label: 'MOVE', go: 'move' });\n      ui.panel(x - 4, y - 6, 110, list.length * 15 + 8, { bg: 'ink', border: 'sand' }); const i = ui.list(M.s, list, { x, y, w: 102, rowH: 15 });\n      if (i >= 0) { const g = list[i].go; if (g === 'equip') { A.player.setWeapon(it.id); this.menu = null; } else if (g === 'use') { useHerb(run, it); ui.sound('pickup'); this.menu = null; } else if (g === 'combine') { M.mode = 'combine'; M.s = { focus: 0 }; } else { this.menu = null; this.pickUp(it, ui); } }\n    } else {\n      const opts = combinable(run, it); const list = opts.map((o) => ({ label: ITEMS[o.id].name })); ui.panel(x - 4, y - 6, 170, list.length * 15 + 8, { bg: 'ink', border: 'sand' }); const i = ui.list(M.s, list, { x, y, w: 162, rowH: 15 });\n      if (i >= 0) { combine(run, it, opts[i]); ui.sound('pickup'); this.menu = null; }\n    }\n  }\n  infoPanel(ui, it, x, y) {\n    if (!it) { ui.text(x, y + 4, 'EMPTY', { color: 'slate' }); return; } const d = ITEMS[it.id]; const ic = iconFor(it.id); const w = ui.W - x - 12;\n    ui.hud.sprite(x, y, ic.rows, ic.colors); ui.text(x, y + ic.h + 6, d.name, { color: 'white' });\n    const about = d.kind === 'weapon' ? WEAPONS[d.weapon].about : (d.about ?? []); let yy = y + ic.h + 18; for (const l of about) { yy += ui.para(x, yy, l, w, { color: 'mist' }) * 10; }\n    if (d.kind === 'weapon') { const st = this.A.run.weapons[d.weapon]; ui.text(x, yy + 4, `LOADED ${st?.ammo ?? 0}`, { color: 'sand' }); }\n    if (d.kind === 'ammo') ui.text(x, yy + 4, `${it.count} OF ${d.max}`, { color: 'sand' });\n  }\n  listTab(ui, list, kind) {\n    const A = this.A, run = A.run, x = 34, y = 44; if (!list.length) { ui.center(90, kind === 'key' ? 'NO KEY ITEMS' : 'NOTHING OF VALUE', { color: 'slate' }); ui.prompts([['back', 'CLOSE']]); return; }\n    const items = list.map((id) => ({ label: ITEMS[id].name, value: kind === 'treasure' ? `${treasureValue(run, id)}` : null })); const i = ui.list(this.s, items, { x, y, w: 210, rowH: 17, max: 7 }); const id = list[this.s.focus]; if (!id) return; const ic = iconFor(id); const px = 270; ui.hud.sprite(px, y, ic.rows, ic.colors, { scale: 2 }); ui.text(px, y + 62, ITEMS[id].name, { color: 'white' }); let yy = y + 74; for (const l of ITEMS[id].about ?? []) yy += ui.para(px, yy, l, ui.W - px - 12, { color: 'mist' }) * 10;\n    if (id === 'reliquary') { const s = run.sockets; ui.text(px, yy + 4, `SOCKETS ${['pearl', 'blackpearl', 'amber'].filter((k) => s[k]).length}/3`, { color: 'sand' }); }\n    const socketable = ['pearl', 'blackpearl', 'amber'].includes(id) && run.valuables.includes('reliquary') && !run.sockets[id];\n    if (socketable && i >= 0) { socketInto(run, id); ui.sound('pickup'); }\n    ui.prompts(socketable ? [['confirm', 'SET IN RELIQUARY'], ['back', 'CLOSE']] : [['back', 'CLOSE']]);\n  }\n  mapTab(ui) {\n    const A = this.A, L = A.level, run = A.run, rows = L.rows, s = Math.min(2, Math.floor(Math.min((ui.W - 60) / L.W, (ui.H - 70) / L.H))) || 1, ox = Math.floor(ui.W / 2 - (L.W * s) / 2), oy = 26 + Math.floor((ui.H - 60 - L.H * s) / 2);\n    const col = { '#': 'night', T: 'slate', '~': 'navy', H: 'plum', D: 'orange', G: 'red', S: 'red', W: 'cyan', B: 'orange' };\n    for (let y = 0; y < L.H; y++) for (let x = 0; x < L.W; x++) { const c = rows[y][x]; ui.rect(ox + x * s, oy + y * s, s, s, col[c] ?? 'teal'); }\n    const mark = (m, c) => ui.rect(ox + m.col * s - 1, oy + m.row * s - 1, 3, 3, c); for (const m of L.markers.t) mark(m, 'white'); for (const m of L.markers.m) mark(m, 'lime'); if (run.keys.includes('chart')) for (const t of A.tannoys) if (!t.dead) mark(t.m, 'red');\n    const P = A.player; const b = Math.floor(ui.t * 3) % 2; ui.rect(ox + L.col(P.pos.x) * s - 1, oy + L.row(P.pos.z) * s - 1, 3, 3, b ? 'sand' : 'white');\n    ui.text(10, 28, A.def.title ?? A.id, { color: 'sand' }); ui.text(10, 40, A.objective, { color: 'mist' }); ui.text(10, ui.H - 34, `LOUDSPEAKERS ${run.tannoys.length}/15`, { color: 'mist' }); ui.prompts([['back', 'CLOSE']]);\n  }\n  filesTab(ui) {\n    const run = this.A.run; if (!run.notes.length) { ui.center(90, 'NO FILES YET', { color: 'slate' }); ui.prompts([['back', 'CLOSE']]); return; }\n    ui.list(this.s, run.notes.map((id) => ({ label: NOTES[id].title })), { x: 16, y: 44, w: 200, rowH: 17, max: 6, noConfirm: true }); const n = NOTES[run.notes[this.s.focus]]; const x = 232; ui.panel(x, 40, ui.W - x - 12, 120, { bg: 'white', border: 'sand' }); ui.text(x + 8, 48, n.title, { color: 'plum', shadow: false }); let y = 64; for (const l of n.lines) y += ui.para(x + 8, y, l, ui.W - x - 28, { color: 'ink', shadow: false }) * 10 + 3; ui.prompts([['back', 'CLOSE']]);\n  }\n  radioTab(ui) {\n    const A = this.A, safe = (A.safeRooms ?? []).some((m) => Math.hypot(m.x - A.player.pos.x, m.z - A.player.pos.z) < 8);\n    const px = 40, py = 50; const a = iconFor('pym'), b = iconFor('max'); ui.hud.sprite(px, py, a.rows, a.colors, { scale: 2 }); ui.hud.sprite(ui.W - px - 64, py, b.rows, b.colors, { scale: 2 }); ui.center(52, 'CLAIMS DESK', { color: 'cyan' });\n    ui.para(px + 76, 70, A.def.hint ? PYM_HINTS[A.def.hint] : PYM_HINTS.general, ui.W - 2 * px - 152, { color: safe ? 'white' : 'slate' }); ui.center(136, safe ? 'THE LINE IS CLEAR' : 'LONG CALLS ONLY IN DRY ROOMS. SHORT HINT ON HOLD.', { color: 'sand' });\n    const i = ui.list(this.s, [{ label: 'CALL THE DESK' }], { x: ui.W / 2 - 70, y: 156, w: 140, rowH: 16 }); if (i === 0) { A.closeMenu(); A.radio(A.def.hint ?? 'general'); A.app.mix.play('onhold'); A.ctx.tweens.call(6, () => A.app.mix.play(A.def.music ?? null)); return; }\n    ui.prompts([['confirm', 'CALL'], ['back', 'CLOSE']]);\n  }\n}\nfunction BIND_CLOSE(ui) { return ui.input.wasPressed('Tab') || ui.input.wasPressed('KeyI') || ui.input.wasPressed('PadTriangle') && !ui._t; }\nE\ncat > src/screens/shop.js <<'E'\n// Mr. Fathom. Tabs BUY, SELL, TUNE. Six rows, one big item panel, his helmet and a line of text.\nimport { ITEMS } from '../data/items.js';\nimport { WEAPONS, TUNE_NAME, TUNE_STATS, WEAPON_ORDER } from '../data/weapons.js';\nimport { CASE_SIZES, SHOP_BARKS, STOCK } from '../data/shop.js';\nimport { addItem, ammoOf, removeItem, sellPrice, sellTreasure, treasureValue, ownedWeapons } from '../core/run.js';\nimport { iconFor } from '../models/icons.js';\nimport { VoiceLine } from '../audio/voice.js';\nexport function openShop(A, f) { A.openMenu(new ShopScreen(A, f)); }\nexport function buy(run, id) {\n  if (CASE_SIZES[id]) { const c = CASE_SIZES[id]; if (run.money < c.price || run.grid.w >= c.w) return 'poor'; run.money -= c.price; run.grid = { w: c.w, h: c.h }; return 'ok'; }\n  const d = ITEMS[id]; const price = d.kind === 'weapon' ? WEAPONS[d.weapon].price : d.price;\n  if (run.money < price) return 'poor';\n  const left = addItem(run, id, d.gives ?? 1); if (left > 0) return 'full';\n  run.money -= price; return 'ok';\n}\nexport function tunePrice(id, stat, lvl) { const base = WEAPONS[id].tune; return base[Math.min(3, lvl)] * (stat === 'power' ? 1.2 : 1) | 0; }\nexport function tune(run, id, stat) { const st = run.weapons[id]; st.tune ??= {}; const l = st.tune[stat] || 0; if (l >= 4) return 'max'; const p = tunePrice(id, stat, l); if (run.money < p) return 'poor'; run.money -= p; st.tune[stat] = l + 1; return 'ok'; }\nexport function grantRewards(run) { const out = []; const n = run.tannoys.length; if (n >= 5 && !run.rewards.includes(5)) { run.rewards.push(5); run.money += 1000; out.push('5 LOUDSPEAKERS: 1000 D'); } if (n >= 10 && !run.rewards.includes(10)) { run.rewards.push(10); const next = run.grid.w < 12 ? CASE_SIZES.case1 : CASE_SIZES.case2; run.grid = { w: next.w, h: next.h }; out.push('10 LOUDSPEAKERS: A BIGGER CASE'); } if (n >= 15 && !run.rewards.includes(15)) { run.rewards.push(15); run.valuables.push('blackpearl'); out.push('15 LOUDSPEAKERS: A BLACK PEARL'); } return out; }\nexport class ShopScreen {\n  constructor(A, f) { this.A = A; this.f = f; this.s = { tab: 0, focus: 0 }; this.w = 0; this.line(A.rng.pick(SHOP_BARKS.greet)); A.app.mix.play('shop', 0.2); A.ctx.audio.play('bubble'); this.rewards = grantRewards(A.run); if (this.rewards.length) this.line(`A GIFT FOR THE COLLECTOR. ${this.rewards[0]}`); }\n  line(t) { this.bark = { text: t, n: 0, voice: new VoiceLine(this.A.ctx.audio, 'FATHOM', t, () => this.A.app.settings.voice) }; }\n  update(ui) {\n    const A = this.A, run = A.run; ui.rect(0, 0, ui.W, ui.H, 'ink'); ui.tabs(this.s, ['BUY', 'SELL', 'TUNE'], 10);\n    const m = `${run.money} D`, mw = ui.measure(m, 2); ui.text(ui.W - mw.width - 8, 26, m, { scale: 2, color: 'sand' });\n    // Helmet and bark\n    const b = this.bark; b.n = Math.min(b.text.length, b.n + 0.5); b.voice.tick(Math.floor(b.n)); const h = iconFor('helmet'); const hy = ui.H - 68; ui.hud.sprite(10, hy, h.rows, h.colors, { scale: 1 }); ui.panel(46, hy, ui.W - 56, 34, { bg: 'night', border: 'teal' }); ui.para(52, hy + 5, b.text.slice(0, Math.floor(b.n)), ui.W - 70, { color: 'lime' });\n    const t = this.s.tab; if (t === 0) this.buyTab(ui); else if (t === 1) this.sellTab(ui); else this.tuneTab(ui);\n    if (ui.back) { A.ctx.audio.play('bubble'); A.say('FATHOM', A.rng.pick(SHOP_BARKS.leave), 1.5); A.app.mix.play(A.def.music ?? null, 0.3); A.closeMenu(); }\n  }\n  panel(ui, id, x, y, extra) {\n    const ic = iconFor(id); const big = ic.h <= 28 && ic.w <= 56 ? 2 : 1; ui.hud.sprite(x, y, ic.rows, ic.colors, { scale: big }); const name = CASE_SIZES[id]?.name ?? ITEMS[id].name; const dy = y + ic.h * big + 6; ui.text(x, dy, name, { color: 'white' });\n    const about = CASE_SIZES[id] ? [`GRID ${CASE_SIZES[id].w} BY ${CASE_SIZES[id].h}.`] : ITEMS[id].kind === 'weapon' ? WEAPONS[ITEMS[id].weapon].about : ITEMS[id].about ?? []; let yy = dy + 12; for (const l of about) yy += ui.para(x, yy, l, ui.W - x - 10, { color: 'mist' }) * 10; if (extra) ui.text(x, yy + 2, extra, { color: 'sand' });\n  }\n  buyTab(ui) {\n    const A = this.A, run = A.run, list = (STOCK[Math.min(3, run.chapter)] ?? STOCK[1]).filter((id) => { if (CASE_SIZES[id]) return run.grid.w < CASE_SIZES[id].w; const d = ITEMS[id]; if (d.kind === 'weapon') return !run.items.some((i) => i.id === id); if (d.kind === 'key') return !run.keys.includes(id); return true; });\n    const price = (id) => CASE_SIZES[id]?.price ?? (ITEMS[id].kind === 'weapon' ? WEAPONS[ITEMS[id].weapon].price : ITEMS[id].price);\n    const items = list.map((id) => ({ label: CASE_SIZES[id]?.name ?? ITEMS[id].name, value: `${price(id)}`, valueColor: run.money >= price(id) ? 'sand' : 'red' })); const i = ui.list(this.s, items, { x: 10, y: 46, w: 214, rowH: 17, max: 6 });\n    const id = list[this.s.focus]; if (id) this.panel(ui, id, 238, 46);\n    if (i >= 0 && id) { const r = buy(run, id); if (r === 'ok') { A.ctx.audio.play('coins'); this.line(A.rng.pick(SHOP_BARKS.buy)); } else if (r === 'full') { A.ctx.audio.play('uideny'); this.line('NO ROOM IN THAT CASE, FRIEND. ARRANGE IT OR SELL SOMETHING.'); } else { A.ctx.audio.play('uideny'); this.line(A.rng.pick(SHOP_BARKS.poor)); } }\n    ui.prompts([['confirm', 'BUY'], ['back', 'LEAVE']]);\n  }\n  sellTab(ui) {\n    const A = this.A, run = A.run; const owned = ownedWeapons(run); const items = [...run.valuables.map((id, n) => ({ id, tr: true, n })), ...run.items.filter((it) => !(ITEMS[it.id].kind === 'weapon' && owned.length <= 1)).map((it) => ({ it, id: it.id }))]; const rows = items.map((r) => ({ label: ITEMS[r.id].name, value: `${r.tr ? treasureValue(run, r.id) : sellPrice(run, r.it)}` }));\n    if (!rows.length) { ui.text(16, 60, 'NOTHING TO SELL', { color: 'slate' }); ui.prompts([['back', 'LEAVE']]); return; }\n    const i = ui.list(this.s, rows, { x: 10, y: 46, w: 214, rowH: 17, max: 6 }); const r = items[this.s.focus]; if (r) this.panel(ui, r.id, 238, 46, r.tr ? 'FULL PRICE: TREASURE' : 'HALF PRICE');\n    if (i >= 0 && r) { if (r.tr) sellTreasure(run, r.id); else { run.money += sellPrice(run, r.it); if (run.weapon === r.id) { removeItem(run, r.it); const w = ownedWeapons(run)[0]; if (w) A.player.setWeapon(w); } else removeItem(run, r.it); } A.ctx.audio.play('coins'); this.line(r.tr ? 'A FINE PIECE. I KNOW A WIDOW WHO COLLECTS.' : A.rng.pick(SHOP_BARKS.sell)); }\n    ui.prompts([['confirm', 'SELL'], ['back', 'LEAVE']]);\n  }\n  tuneTab(ui) {\n    const A = this.A, run = A.run, list = ownedWeapons(run); if (!list.length) return; this.w = Math.max(0, Math.min(list.length - 1, this.w)); if (ui.nav.left) { this.w = (this.w - 1 + list.length) % list.length; ui.sound('uimove'); } if (ui.nav.right) { this.w = (this.w + 1) % list.length; ui.sound('uimove'); }\n    const id = list[this.w], st = run.weapons[id]; st.tune ??= {}; const rows = TUNE_STATS.map((s) => { const l = st.tune[s] || 0; return { label: TUNE_NAME[s], value: l >= 4 ? 'MAX' : `${tunePrice(id, s, l)}` }; });\n    ui.center(30, `< ${WEAPONS[id].name} >`, { color: 'white' }); const i = ui.list(this.s, rows, { x: 10, y: 54, w: 214, rowH: 20 });\n    TUNE_STATS.forEach((s, k) => { const l = st.tune[s] || 0; for (let n = 0; n < 4; n++) ui.rect(120 + n * 10, 56 + k * 20, 8, 7, n < l ? 'sand' : 'night'); });\n    const ic = iconFor(id); ui.hud.sprite(238, 46, ic.rows, ic.colors); ui.para(238, 84, TUNE_STATS.every((s) => (st.tune[s] || 0) >= 4) ? `PERK ON: ${WEAPONS[id].perk}` : `FILL ALL FOUR: ${WEAPONS[id].perk}`, ui.W - 248, { color: 'sand' });\n    if (i >= 0) { const r = tune(run, id, TUNE_STATS[i]); if (r === 'ok') { A.ctx.audio.play('reload3'); this.line(A.rng.pick(SHOP_BARKS.tune)); } else { A.ctx.audio.play('uideny'); this.line(r === 'max' ? 'SHE WILL TAKE NO MORE, FRIEND.' : A.rng.pick(SHOP_BARKS.poor)); } }\n    ui.prompts([['confirm', 'TUNE'], ['left', 'WEAPON'], ['back', 'LEAVE']]);\n  }\n}\nE\ncat > src/screens/settings.js <<'E'\n// Paged, not dense. Same screen for every input.\nimport { DEFAULT_SETTINGS, storeSettings } from '../core/save.js';\nimport { TUNING } from '../data/tuning.js';\nconst LOOKS = ['native', 'spooky', 'ps1_horror', 'noir'];\nconst PAGES = ['SOUND', 'CONTROLS', 'PICTURE'];\nexport class SettingsScreen {\n  constructor(app) { this.app = app; this.s = { tab: 0, focus: 0 }; this.done = false; }\n  rows(tab) {\n    const S = this.app.settings;\n    if (tab === 0) return [{ k: 'music', label: 'MUSIC', min: 0, max: 1 }, { k: 'sfx', label: 'SOUND EFFECTS', min: 0, max: 1 }, { k: 'voice', label: 'VOICES', min: 0, max: 1 }, { k: 'master', label: 'MASTER', min: 0, max: 1 }, { reset: true, label: 'RESET ALL SETTINGS' }];\n    if (tab === 1) return [{ k: 'padAim', label: 'AIM SPEED, PAD', min: 0.3, max: 2 }, { k: 'mouseAim', label: 'AIM SPEED, MOUSE', min: 0.3, max: 2 }, { k: 'aimAssist', label: 'AIM ASSIST', min: 0, max: 2 }, { k: 'invertY', label: 'INVERT Y', opts: [false, true], names: ['OFF', 'ON'] }, { k: 'glyphs', label: 'CONTROLLER GLYPHS', opts: ['ps', 'xbox'], names: ['PLAYSTATION', 'XBOX'] }];\n    return [{ k: 'shake', label: 'SCREEN SHAKE', min: 0, max: 1.5 }, { k: 'look', label: 'LOOK', opts: LOOKS, names: LOOKS.map((l) => l.toUpperCase().replace('_', ' ')) }, { k: 'pixelSize', label: 'PIXEL SIZE', opts: ['fine', 'chunky'], names: ['FINE', 'CHUNKY'] }, { k: 'quality', label: 'QUALITY', opts: ['low', 'medium', 'high'], names: ['LOW', 'MEDIUM', 'HIGH'] }, { k: 'fps', label: 'FRAME RATE', opts: [60, 30, 0], names: ['60', '30', 'DISPLAY'] }, { full: true, label: 'FULLSCREEN' }];\n  }\n  update(ui) {\n    const app = this.app, S = app.settings; ui.rect(0, 0, ui.W, ui.H, 'ink'); ui.center(26, 'SETTINGS', { scale: 2, color: 'sand' }); const tab = ui.tabs(this.s, PAGES, 46); const rows = this.rows(tab);\n    const display = rows.map((r) => ({ label: r.label })); const x = Math.round(ui.W / 2 - 170), y = 68; const i = ui.list(this.s, display, { x, y, w: 340, rowH: 20, noConfirm: true });\n    rows.forEach((r, k) => {\n      const ry = y + k * 20 + 4, on = this.s.focus === k;\n      if (r.min != null) { const nv = ui.slider(x + 170, ry, 110, S[r.k], r.min, r.max, { def: DEFAULT_SETTINGS[r.k] }); if (nv !== S[r.k]) { S[r.k] = nv; this.apply(); } ui.text(x + 290, ry, `${Math.round(S[r.k] * 100)}%`, { color: on ? 'white' : 'mist' }); if (on) { const st = (r.max - r.min) / 20; if (ui.nav.left) { S[r.k] = Math.max(r.min, S[r.k] - st); this.apply(); ui.sound('uimove'); } if (ui.nav.right) { S[r.k] = Math.min(r.max, S[r.k] + st); this.apply(); ui.sound('uimove'); } } }\n      else if (r.opts) { const n = r.opts.indexOf(S[r.k]); ui.text(x + 170, ry, `< ${r.names[Math.max(0, n)]} >`, { color: on ? 'white' : 'mist' }); const step = (d) => { S[r.k] = r.opts[(Math.max(0, n) + d + r.opts.length) % r.opts.length]; this.apply(); ui.sound('uimove'); }; if (on && ui.nav.left) step(-1); if (on && (ui.nav.right || ui.confirm)) step(1); if (ui.click && ui.within(x + 170, ry - 4, 150, 16, ui.cx, ui.cy)) step(1); }\n    });\n    const r = rows[this.s.focus]; if (ui.confirm || (ui.click && ui.within(x, y + this.s.focus * 20 - 2, 170, 18, ui.cx, ui.cy))) { if (r?.reset) { Object.assign(S, DEFAULT_SETTINGS); this.apply(); ui.sound('uiconfirm'); } if (r?.full) app.toggleFullscreen(); }\n    ui.prompts([['confirm', 'CHANGE'], ['left', 'ADJUST'], ['back', 'BACK']]);\n    if (ui.back) { ui.sound('uiback'); this.done = true; }\n  }\n  apply() { const app = this.app; storeSettings(app.settings); app.applySettings(); }\n}\nE\ncat > src/screens/about.js <<'E'\n// Paged. Source Information, Testing Feedback, Engine Feedback, Prompt Feedback, Credits.\nimport { ABOUT_PAGES } from '../data/about.js';\nexport class AboutScreen {\n  constructor(app) { this.app = app; this.s = { tab: 0 }; this.scroll = 0; this.done = false; }\n  update(ui) {\n    ui.rect(0, 0, ui.W, ui.H, 'ink'); const titles = ABOUT_PAGES.map((p) => p.tab); const prev = this.s.tab; const tab = ui.tabs(this.s, titles, 10); if (tab !== prev) this.scroll = 0; const page = ABOUT_PAGES[tab]; const W = Math.min(ui.W - 40, 420), x = Math.round(ui.W / 2 - W / 2), top = 28, bottom = ui.H - 22;\n    const lines = []; for (const [k, v] of page.rows) { if (k) lines.push({ t: k, c: 'sand' }); for (const l of ui.wrap(v, W)) lines.push({ t: l, c: 'white' }); lines.push({ t: '', c: 'white' }); }\n    const vis = Math.floor((bottom - top) / 10); const maxS = Math.max(0, lines.length - vis);\n    if (ui.nav.down) this.scroll++; if (ui.nav.up) this.scroll--; if (ui.wheel) this.scroll += Math.sign(ui.wheel) * 2; this.scroll = Math.max(0, Math.min(maxS, this.scroll));\n    for (let i = 0; i < vis && i + this.scroll < lines.length; i++) { const L = lines[i + this.scroll]; ui.text(x, top + i * 10, L.t, { color: L.c }); }\n    if (this.scroll > 0) ui.text(ui.W - 14, top, '^', { color: 'sand' }); if (this.scroll < maxS) ui.text(ui.W - 14, bottom - 10, 'V', { color: 'sand' });\n    ui.prompts([['up', 'SCROLL'], ['back', 'BACK']]); if (ui.back) { ui.sound('uiback'); this.done = true; }\n  }\n}\nE\ncat > src/screens/dev.js <<'E'\n// Dev mode: tools, teleport, spawn, live balance sliders. Same pixel UI.\nimport { TUNING, TUNING_DEFS, TUNING_DEFAULT, resetTuning } from '../data/tuning.js';\nimport { SPAWNABLE, ENEMIES } from '../data/enemies.js';\nimport { TELEPORTS } from '../data/levels/areas.js';\nimport { ITEMS } from '../data/items.js';\nimport { save } from '../core/save.js';\nimport { addItem } from '../core/run.js';\nexport class DevScreen {\n  constructor(A) { this.A = A; this.s = { tab: 0, focus: 0 }; this.page = 0; this.done = false; A.app.devUsed = true; }\n  update(ui) {\n    ui.rect(0, 0, ui.W, ui.H, 'ink'); const tab = ui.tabs(this.s, ['TOOLS', 'TELEPORT', 'SPAWN', 'BALANCE'], 10); [this.tools, this.teleport, this.spawn, this.balance][tab].call(this, ui); if (ui.back) { ui.sound('uiback'); this.done = true; }\n  }\n  tools(ui) {\n    const A = this.A, P = A.player, e = A.ctx.engine; const on = (b) => (b ? 'ON' : 'OFF');\n    const rows = [\n      { label: 'GOD MODE', value: on(P.god), f: () => { P.god = !P.god; } }, { label: 'NO-CLIP', value: on(P.noclip), f: () => { P.noclip = !P.noclip; } }, { label: 'INFINITE AMMO', value: on(A.infiniteAmmo), f: () => { A.infiniteAmmo = !A.infiniteAmmo; } }, { label: 'ONE-HIT KILLS', value: on(A.oneHit), f: () => { A.oneHit = !A.oneHit; } }, { label: 'FREEZE AI', value: on(A.frozenAI), f: () => { A.frozenAI = !A.frozenAI; } },\n      { label: 'SHOW HIT ZONES', value: on(A.showZones), f: () => { A.app.dev.toggleZones(A); } }, { label: 'SHOW NAV AND FLOW', value: on(A.showNav), f: () => { A.app.dev.toggleNav(A); } }, { label: 'SHOW TRIGGERS', value: on(A.showTriggers), f: () => { A.app.dev.toggleTriggers(A); } },\n      { label: 'GAME SPEED', value: `${A.savedScale ?? 1}`, f: () => { const L = [0.25, 0.5, 1, 2], k = L.indexOf(A.savedScale ?? 1); A.savedScale = L[(k + 1) % 4]; } },\n      { label: 'SKIP CUTSCENE', f: () => { A.cutscene?.skip(); if (A.dialog.active) A.dialog.skip(); } }, { label: 'HEAL', f: () => { A.run.health = A.run.maxHealth; if (A.dame) A.dame.hp = A.dame.maxHp; } }, { label: 'GIVE 10,000 DOUBLOONS', f: () => { A.run.money += 10000; } },\n      { label: 'GIVE ALL WEAPONS AND ITEMS', f: () => { A.run.grid = { w: 14, h: 8 }; for (const id of Object.keys(ITEMS)) { const d = ITEMS[id]; if (d.kind === 'weapon' && !A.run.items.some((i) => i.id === id)) addItem(A.run, id); else if (d.kind === 'treasure' || d.kind === 'key') addItem(A.run, id); else if (d.kind === 'ammo') addItem(A.run, id, d.max); } } },\n      { label: 'FILL CASE', f: () => { let g = 0; while (g++ < 200 && addItem(A.run, 'samphire') === 0); } }, { label: 'KILL ALL', f: () => { for (const x of [...A.enemies]) if (!x.dead) x.die({}); } }, { label: 'UNLOCK ALL', f: () => { for (const d of A.level.doors) A.level.openDoor(d, null, true); for (const k in A.level.gates) { const g = A.level.gates[k]; if (g.q) A.level.openGate(g); } } },\n      { label: 'ENGINE DEBUG PANEL', value: on(e.debugShown), f: () => { e.showDebug?.(!e.debugShown); } }, { label: 'RESET ALL COUNTERS', f: () => { A.run.stats.kills = 0; } },\n    ];\n    const i = ui.list(this.s, rows, { x: 40, y: 34, w: 300, rowH: 15, max: 12 }); if (i >= 0) rows[i].f();\n    ui.text(350, 40, `RANK ${A.rank()}`, { color: 'sand' }); ui.text(350, 52, `ALIVE ${A.enemies.filter((x) => !x.dead).length}`, { color: 'sand' }); ui.text(350, 64, `TOKENS ${A.tokensHeld}/${A.maxTokens()}`, { color: 'sand' }); ui.prompts([['confirm', 'TOGGLE'], ['back', 'BACK']]);\n  }\n  teleport(ui) {\n    const rows = TELEPORTS.map((t) => ({ label: t.label })); const i = ui.list(this.s, rows, { x: 60, y: 34, w: 300, rowH: 15, max: 13 }); ui.prompts([['confirm', 'GO'], ['back', 'BACK']]); if (i >= 0) { const A = this.A, t = TELEPORTS[i]; A.menu = null; A.ctx.engine.timeScale = 1; A.app.teleport(t); }\n  }\n  spawn(ui) {\n    const rows = SPAWNABLE.map((t) => ({ label: ENEMIES[t].name })); const i = ui.list(this.s, rows, { x: 60, y: 34, w: 300, rowH: 15, max: 13 }); ui.prompts([['confirm', 'SPAWN AT THE LASER DOT'], ['back', 'BACK']]);\n    if (i >= 0) { const A = this.A, P = A.player; const at = P.dotOn ? P.dot : { x: P.pos.x + Math.sin(P.camYaw) * 5, z: P.pos.z + Math.cos(P.camYaw) * 5 }; A.spawnEnemy(SPAWNABLE[i], at.x, at.z, { floor: P.floor }); }\n  }\n  balance(ui) {\n    const keys = Object.keys(TUNING_DEFS), perPage = 8, pages = Math.ceil(keys.length / perPage); const start = this.page * perPage, list = keys.slice(start, start + perPage); const rows = list.map((k) => ({ label: k.replace(/([A-Z])/g, ' $1').toUpperCase() })); rows.push({ label: 'RESET ALL' });\n    const x = Math.round(ui.W / 2 - 200), y = 34; const i = ui.list(this.s, rows, { x, y, w: 400, rowH: 21, noConfirm: true });\n    list.forEach((k, n) => { const [def, min, max] = TUNING_DEFS[k], ry = y + n * 21 + 4; const nv = ui.slider(x + 180, ry, 100, TUNING[k], min, max, { def }); if (nv !== TUNING[k]) { TUNING[k] = nv; this.persist(); } ui.text(x + 290, ry, TUNING[k].toFixed(2), { color: 'white' }); ui.text(x + 330, ry, `DEF ${def}`, { color: 'slate' }); if (this.s.focus === n) { const st = (max - min) / 40; if (ui.nav.left) { TUNING[k] = Math.max(min, TUNING[k] - st); this.persist(); ui.sound('uimove'); } if (ui.nav.right) { TUNING[k] = Math.min(max, TUNING[k] + st); this.persist(); ui.sound('uimove'); } if (ui.tertiary) { TUNING[k] = TUNING_DEFAULT[k]; this.persist(); ui.sound('uiback'); } } });\n    if (ui.confirm && this.s.focus === list.length) { resetTuning(); this.persist(); ui.sound('uiconfirm'); }\n    if (ui.click && ui.within(x, y + list.length * 21 - 2, 200, 18, ui.cx, ui.cy)) { resetTuning(); this.persist(); }\n    if (ui.secondary) { this.page = (this.page + 1) % pages; this.s.focus = 0; ui.sound('uimove'); }\n    ui.text(x, ui.H - 32, `PAGE ${this.page + 1}/${pages}`, { color: 'slate' }); ui.prompts([['left', 'ADJUST'], ['tertiary', 'RESET ONE'], ['secondary', 'NEXT PAGE'], ['back', 'BACK']]);\n  }\n  persist() { save.set('tuning', { ...TUNING }); }\n}\nE\necho ok","description":"Write icons, Case, Shop, pause, settings, about, dev screens"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":32969,"cache_read_input_tokens":332009,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":32969},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76d12802-c986-437e-adae-1ae347966275","uuid":"a55300af-f652-46bf-bfbc-0e1bfa9b4b96","timestamp":"2026-11-05T23:52:44.622Z","request_id":"req_011CgkgBYpzyScwRGmUWJcAh","wire_tool_inputs":{"toolu_013NPd7YgA7p5eJZfZEG9u2u":{"command":"cat > src/models/icons.js <<'E'\n// Item icons as TextureDefs with SVG path layers, read through hudSprite. Sized to their Case footprint (14 art px a cell).\nimport { hudSprite, textureDef } from '../../pixel-engine.js';\nconst T = (id, w, h, palette, layers) => textureDef({ id: `icon-${id}`, about: `Icon for ${id}`, tags: ['icon'], size: [w, h], palette, layers });\nconst R = (x, y, w, h) => `M${x} ${y} H${x + w} V${y + h} H${x} Z`;\nconst gun = { steel: 'slate', hi: 'mist', wood: 'orange', dark: 'night' };\nexport const ICON_DEFS = {\n  pistol: T('pistol', 42, 28, gun, [{ path: `${R(6, 7, 30, 6)}`, fill: 'steel' }, { path: R(14, 5, 12, 11), fill: 'hi' }, { path: 'M12 13 L22 13 L18 25 L8 25 Z', fill: 'wood' }, { path: R(6, 8, 30, 1), fill: 'hi' }, { path: R(20, 13, 6, 5), fill: 'dark' }]),\n  scatter: T('scatter', 98, 28, gun, [{ path: R(26, 8, 66, 5), fill: 'steel' }, { path: R(40, 13, 22, 5), fill: 'wood' }, { path: 'M4 10 L28 8 L28 16 L14 22 L4 22 Z', fill: 'wood' }, { path: R(26, 8, 66, 1), fill: 'hi' }, { path: R(88, 6, 3, 2), fill: 'hi' }]),\n  rifle: T('rifle', 112, 28, gun, [{ path: R(24, 10, 84, 3), fill: 'steel' }, { path: 'M4 12 L34 10 L70 12 L70 16 L34 16 L16 23 L4 23 Z', fill: 'dark' }, { path: R(36, 4, 28, 4), fill: 'hi' }, { path: R(44, 8, 3, 2), fill: 'steel' }, { path: R(58, 8, 3, 2), fill: 'steel' }]),\n  harpoon: T('harpoon', 84, 28, gun, [{ path: R(10, 12, 50, 7), fill: 'wood' }, { path: R(14, 9, 66, 3), fill: 'hi' }, { path: 'M74 6 L82 10 L74 15 Z', fill: 'hi' }, { path: R(44, 3, 3, 22), fill: 'steel' }, { path: 'M16 19 L24 19 L20 26 L12 26 Z', fill: 'wood' }]),\n  ammo_pistol: T('ammo_pistol', 28, 14, { box: 'sand', dark: 'night', hi: 'white' }, [{ path: R(3, 3, 22, 9), fill: 'box' }, { path: R(3, 7, 22, 2), fill: 'dark' }, { path: R(6, 4, 3, 2), fill: 'hi' }]),\n  ammo_shells: T('ammo_shells', 28, 14, { a: 'red', b: 'sand' }, [{ path: `${R(3, 2, 6, 10)}${R(11, 2, 6, 10)}${R(19, 2, 6, 10)}`, fill: 'a' }, { path: `${R(3, 9, 6, 3)}${R(11, 9, 6, 3)}${R(19, 9, 6, 3)}`, fill: 'b' }]),\n  ammo_rifle: T('ammo_rifle', 28, 14, { a: 'sand', b: 'orange' }, [{ path: `${R(3, 3, 3, 9)}${R(8, 3, 3, 9)}${R(13, 3, 3, 9)}${R(18, 3, 3, 9)}`, fill: 'a' }, { path: `${R(3, 1, 3, 2)}${R(8, 1, 3, 2)}${R(13, 1, 3, 2)}${R(18, 1, 3, 2)}`, fill: 'b' }]),\n  ammo_bolts: T('ammo_bolts', 42, 14, { a: 'mist', b: 'white' }, [{ path: `${R(3, 3, 32, 2)}${R(3, 9, 32, 2)}`, fill: 'a' }, { path: 'M35 1 L40 4 L35 7 Z M35 7 L40 10 L35 13 Z', fill: 'b' }]),\n  samphire: T('samphire', 14, 28, { a: 'green', b: 'lime' }, [{ path: `${R(6, 4, 2, 21)}`, fill: 'a' }, { path: 'M7 8 L12 4 L12 9 Z M7 13 L2 9 L2 14 Z M7 18 L12 14 L12 19 Z', fill: 'b' }]),\n  dulse: T('dulse', 14, 28, { a: 'plum', b: 'red' }, [{ path: 'M7 25 L3 16 L7 5 L11 16 Z', fill: 'b' }, { path: R(6, 12, 2, 13), fill: 'a' }]),\n  holly: T('holly', 14, 28, { a: 'sand', b: 'orange' }, [{ path: 'M7 4 L12 12 L7 25 L2 12 Z', fill: 'a' }, { path: R(6, 8, 2, 16), fill: 'b' }]),\n  mix_ss: T('mix_ss', 14, 28, { a: 'lime', b: 'white', c: 'green' }, [{ path: R(3, 6, 8, 19), fill: 'c' }, { path: R(4, 9, 6, 15), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }]),\n  mix_sss: T('mix_sss', 14, 28, { a: 'cyan', b: 'white', c: 'green' }, [{ path: R(3, 6, 8, 19), fill: 'c' }, { path: R(4, 9, 6, 15), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }]),\n  mix_sd: T('mix_sd', 14, 28, { a: 'orange', b: 'white', c: 'plum' }, [{ path: R(3, 6, 8, 19), fill: 'c' }, { path: R(4, 9, 6, 15), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }]),\n  mix_sdh: T('mix_sdh', 14, 28, { a: 'sand', b: 'white', c: 'orange' }, [{ path: R(3, 6, 8, 19), fill: 'c' }, { path: R(4, 9, 6, 15), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }]),\n  firstaid: T('firstaid', 14, 28, { a: 'white', b: 'red' }, [{ path: R(2, 6, 10, 16), fill: 'a' }, { path: `${R(6, 8, 2, 12)}${R(3, 13, 8, 2)}`, fill: 'b' }]),\n  flare: T('flare', 14, 28, { a: 'red', b: 'white' }, [{ path: R(4, 6, 6, 19), fill: 'a' }, { path: R(4, 3, 6, 4), fill: 'b' }]),\n  depth: T('depth', 14, 28, { a: 'night', b: 'sand' }, [{ path: R(2, 7, 10, 16), fill: 'a' }, { path: `${R(2, 10, 10, 2)}${R(2, 19, 10, 2)}`, fill: 'b' }]),\n  oil: T('oil', 14, 28, { a: 'lime', b: 'sand', c: 'orange' }, [{ path: R(3, 11, 8, 14), fill: 'a' }, { path: R(5, 6, 4, 6), fill: 'a' }, { path: R(5, 3, 4, 3), fill: 'b' }, { path: R(6, 1, 2, 2), fill: 'c' }]),\n  pearl: T('pearl', 28, 28, { a: 'white', b: 'mist' }, [{ path: 'M14 6 L20 9 L22 14 L20 19 L14 22 L8 19 L6 14 L8 9 Z', fill: 'b' }, { path: 'M10 9 L15 8 L14 13 L9 13 Z', fill: 'a' }]),\n  blackpearl: T('blackpearl', 28, 28, { a: 'slate', b: 'ink', c: 'plum' }, [{ path: 'M14 6 L20 9 L22 14 L20 19 L14 22 L8 19 L6 14 L8 9 Z', fill: 'c' }, { path: 'M10 9 L15 8 L14 13 L9 13 Z', fill: 'a' }]),\n  seaglass: T('seaglass', 28, 28, { a: 'cyan', b: 'lime', c: 'sky' }, [{ path: 'M4 12 L12 8 L14 16 L6 20 Z', fill: 'a' }, { path: 'M14 6 L24 8 L22 15 L15 13 Z', fill: 'b' }, { path: 'M15 16 L24 18 L20 24 L13 22 Z', fill: 'c' }]),\n  amber: T('amber', 28, 28, { a: 'orange', b: 'sand', c: 'night' }, [{ path: 'M14 4 L23 11 L19 23 L9 23 L5 11 Z', fill: 'a' }, { path: 'M9 9 L14 7 L12 13 Z', fill: 'b' }, { path: R(13, 14, 3, 3), fill: 'c' }]),\n  tusk: T('tusk', 28, 28, { a: 'white', b: 'slate' }, [{ path: 'M4 24 C8 14 14 6 24 4 C22 12 16 22 8 26 Z', fill: 'a' }, { path: R(11, 14, 5, 2), fill: 'b' }]),\n  goldtooth: T('goldtooth', 28, 28, { a: 'sand', b: 'orange' }, [{ path: 'M8 7 L20 7 L20 15 L18 23 L15 16 L13 16 L10 23 L8 15 Z', fill: 'a' }, { path: R(10, 9, 3, 3), fill: 'b' }]),\n  reliquary: T('reliquary', 28, 28, { a: 'orange', b: 'sand', c: 'ink' }, [{ path: R(5, 9, 18, 14), fill: 'a' }, { path: 'M5 9 L14 3 L23 9 Z', fill: 'b' }, { path: `${R(8, 13, 3, 3)}${R(13, 13, 3, 3)}${R(18, 13, 3, 3)}`, fill: 'c' }]),\n  coldkey: T('coldkey', 28, 28, { a: 'cyan', b: 'white' }, [{ path: `${R(12, 5, 4, 14)}${R(16, 15, 5, 2)}${R(16, 11, 4, 2)}`, fill: 'a' }, { path: 'M8 18 L20 18 L20 25 L8 25 Z', fill: 'b' }]),\n  chart: T('chart', 28, 28, { a: 'sand', b: 'plum', c: 'red' }, [{ path: R(4, 5, 20, 18), fill: 'a' }, { path: 'M8 10 L18 9 L20 18 L10 19 Z', fill: 'b' }, { path: R(12, 12, 3, 3), fill: 'c' }]),\n  case1: T('case1', 28, 28, { a: 'slate', b: 'sand', c: 'night' }, [{ path: R(4, 9, 20, 14), fill: 'a' }, { path: R(10, 5, 8, 4), fill: 'c' }, { path: `${R(7, 11, 3, 3)}${R(18, 11, 3, 3)}`, fill: 'b' }]),\n  case2: T('case2', 28, 28, { a: 'mist', b: 'orange', c: 'night' }, [{ path: R(3, 8, 22, 16), fill: 'a' }, { path: R(10, 4, 8, 4), fill: 'c' }, { path: `${R(6, 10, 3, 3)}${R(19, 10, 3, 3)}`, fill: 'b' }]),\n  helmet: T('helmet', 32, 32, { a: 'orange', b: 'sand', c: 'lime', d: 'night' }, [{ path: 'M16 2 L24 5 L29 12 L29 22 L24 28 L8 28 L3 22 L3 12 L8 5 Z', fill: 'a' }, { path: 'M16 8 L22 11 L24 16 L22 21 L16 24 L10 21 L8 16 L10 11 Z', fill: 'b' }, { path: 'M16 10 L21 12 L22 16 L21 20 L16 22 L11 20 L10 16 L11 12 Z', fill: 'c' }, { path: R(8, 27, 16, 4), fill: 'd' }]),\n  pym: T('pym', 32, 32, { a: 'sand', b: 'night', c: 'white', d: 'navy' }, [{ path: R(8, 6, 16, 16), fill: 'a' }, { path: R(8, 4, 16, 5), fill: 'b' }, { path: `${R(10, 12, 5, 4)}${R(17, 12, 5, 4)}`, fill: 'c' }, { path: R(4, 22, 24, 10), fill: 'd' }, { path: R(14, 22, 4, 8), fill: 'c' }]),\n  max: T('max', 32, 32, { a: 'mist', b: 'sand', c: 'ink', d: 'red', e: 'slate' }, [{ path: R(8, 6, 16, 16), fill: 'a' }, { path: R(7, 3, 18, 6), fill: 'b' }, { path: R(8, 12, 16, 4), fill: 'c' }, { path: R(6, 21, 20, 4), fill: 'd' }, { path: R(4, 25, 24, 7), fill: 'e' }]),\n};\nconst CACHE = {};\nconst GROUP = { };\nexport function iconFor(id, rot = false) {\n  const k = id + (rot ? ':r' : ''); if (CACHE[k]) return CACHE[k];\n  const base = hudSprite(ICON_DEFS[id] ?? ICON_DEFS.chart); let rows = base.rows;\n  if (rot) { const w = rows[0].length, h = rows.length, out = []; for (let x = 0; x < w; x++) { let s = ''; for (let y = h - 1; y >= 0; y--) s += rows[y][x]; out.push(s); } rows = out; }\n  return (CACHE[k] = { rows, colors: base.colors, w: rows[0].length, h: rows.length });\n}\nE\ncat > src/screens/pause.js <<'E'\nimport { SettingsScreen } from './settings.js';\nimport { DevScreen } from './dev.js';\nexport class PauseMenu {\n  constructor(A) { this.A = A; this.s = { focus: 0 }; this.ctx = A.ctx; }\n  update(ui) {\n    const A = this.A, inSession = A.app.session?.hub;\n    if (this.sub) { this.sub.update(ui); if (this.sub.done) this.sub = null; return; }\n    ui.dim(); ui.center(36, 'PAUSED', { scale: 2, color: 'sand' }); ui.center(58, A.objective, { color: 'mist' });\n    const items = [{ label: 'RESUME' }, { label: 'SETTINGS' }]; if (!inSession) items.push({ label: 'RESTART FROM CHECKPOINT' }, { label: 'DEV MODE' }, { label: 'QUIT TO TITLE' });\n    const i = ui.list(this.s, items, { x: ui.W / 2 - 100, y: 80, w: 200, rowH: 18 });\n    ui.prompts([['confirm', 'SELECT'], ['back', 'RESUME']]);\n    if (i === 0 || ui.back) { A.closeMenu(); return; }\n    if (i === 1) this.sub = new SettingsScreen(A.app);\n    if (i === 2) { A.menu = null; A.ctx.engine.timeScale = 1; A.app.restartCheckpoint(); }\n    if (i === 3) this.sub = new DevScreen(A);\n    if (i === 4) { A.menu = null; A.ctx.engine.timeScale = 1; A.app.goTitle(); }\n  }\n}\nE\ncat > src/screens/denied.js <<'E'\n// CLAIM DENIED: a big rubber stamp, then Continue or Quit.\nexport class DeniedScreen {\n  constructor(A, reason) { this.A = A; this.reason = reason; this.s = { focus: 0 }; this.t = 0; A.ctx.audio.play('stamp'); A.ctx.engine.shake.add(0.6); }\n  update(ui) {\n    this.t += 1 / 60; const A = this.A; ui.dim(); const k = Math.min(1, this.t / 0.14), sc = k < 1 ? 5 : 4; const m = ui.measure('CLAIM DENIED', 4); const w = m.width + 16, x = ui.W / 2 - w / 2, y = 54;\n    for (let j = 0; j < 2; j++) { ui.rect(x - j, y - j, w + j * 2, 1, 'red'); ui.rect(x - j, y + 44 + j, w + j * 2, 1, 'red'); ui.rect(x - j, y - j, 1, 45 + j * 2, 'red'); ui.rect(x + w - 1 + j, y - j, 1, 45 + j * 2, 'red'); }\n    ui.center(y + 8, 'CLAIM DENIED', { scale: 4, color: 'red' }); ui.center(y + 52, this.reason, { color: 'mist' });\n    if (this.t < 0.7) return;\n    const i = ui.list(this.s, [{ label: 'CONTINUE' }, { label: 'QUIT TO TITLE' }], { x: ui.W / 2 - 80, y: 136, w: 160, rowH: 18 });\n    ui.prompts([['confirm', 'SELECT']]);\n    if (i === 0) { A.menu = null; A.ctx.engine.timeScale = 1; A.app.restartCheckpoint(); }\n    if (i === 1) { A.menu = null; A.ctx.engine.timeScale = 1; A.app.goTitle(); }\n  }\n}\nE\ncat > src/screens/form.js <<'E'\n// The Claim Form: five big lines and a rubber stamp.\nexport function gradeOf(stats) { const acc = stats.shots ? stats.hits / stats.shots : 0; return acc > 0.65 && stats.deaths < 2 ? 'APPROVED' : acc > 0.4 ? 'PENDING' : 'DENIED'; }\nconst mmss = (t) => `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`;\nexport class FormScreen {\n  constructor(A, next, o = {}) {\n    this.A = A; this.next = next; this.t = 0; this.title = o.title ?? `CLAIM FORM ${A.run.chapter}`; const r = A.run, b = r.chapterBase, S = r.stats;\n    this.c = { time: S.time - b.time, shots: S.shots - b.shots, hits: S.hits - b.hits, heads: S.heads - b.heads, kicks: S.kicks - b.kicks, deaths: S.deaths - (b.deaths ?? 0) };\n    this.grade = gradeOf(this.c); this.bonus = { APPROVED: 1500, PENDING: 800, DENIED: 300 }[this.grade]; r.money += this.bonus; r.chapterBase = { ...S }; this.stamped = false;\n  }\n  update(ui) {\n    this.t += 1 / 60; const c = this.c, r = this.A.run; ui.rect(0, 0, ui.W, ui.H, 'ink'); const W = 300, x = ui.W / 2 - W / 2; ui.rect(x, 16, W, ui.H - 46, 'sand'); ui.rect(x + 3, 19, W - 6, ui.H - 52, 'white');\n    ui.center(26, 'OSTRANDER MUTUAL ASSURANCE', { color: 'plum', shadow: false }); ui.center(38, this.title, { scale: 2, color: 'ink', shadow: false });\n    const acc = c.shots ? Math.round((c.hits / c.shots) * 100) : 0; const lines = [['TIME', mmss(c.time)], ['ACCURACY', `${acc}%`], ['HEADSHOTS', c.heads], ['KICKS', c.kicks], ['DEDUCTIONS', `-${r.deductions}`]];\n    lines.forEach(([k, v], i) => { if (this.t < 0.2 + i * 0.2) return; const y = 66 + i * 21; ui.text(x + 16, y, k, { scale: 2, color: 'navy', shadow: false }); const m = ui.measure(v, 2); ui.text(x + W - 16 - m.width, y, v, { scale: 2, color: 'ink', shadow: false }); });\n    if (this.t > 1.5) { if (!this.stamped) { this.stamped = true; ui.ctx.audio.play('stamp'); ui.ctx.engine.shake.add(0.5); } const col = { APPROVED: 'green', PENDING: 'orange', DENIED: 'red' }[this.grade]; const m = ui.measure(this.grade, 3); const sx = x + W - m.width - 30, sy = 172; for (let j = 0; j < 2; j++) { ui.rect(sx - 4 - j, sy - 4 - j, m.width + 8 + j * 2, 1, col); ui.rect(sx - 4 - j, sy + 25 + j, m.width + 8 + j * 2, 1, col); ui.rect(sx - 4 - j, sy - 4 - j, 1, 29 + j * 2, col); ui.rect(sx + m.width + 3 + j, sy - 4 - j, 1, 29 + j * 2, col); } ui.text(sx, sy, this.grade, { scale: 3, color: col, shadow: false }); ui.text(x + 16, 182, `BONUS ${this.bonus} D`, { color: 'plum', shadow: false }); }\n    if (this.t > 1.8) { ui.prompts([['confirm', 'FILE IT']]); if (ui.confirm || ui.click) { const A = this.A; A.menu = null; A.ctx.engine.timeScale = 1; this.next(); } }\n  }\n}\nE\ncat > src/screens/case.js <<'E'\n// The Case: an Ostrander Mutual sample case. Tabs: CASE, VALUABLES, KEY ITEMS, MAP, FILES, RADIO. Time frozen.\nimport { ITEMS } from '../data/items.js';\nimport { WEAPONS } from '../data/weapons.js';\nimport { NOTES } from '../data/notes.js';\nimport { PYM_HINTS } from '../data/dialogue.js';\nimport { addItem, arrange, combinable, combine, fits, fp, removeItem, socketInto, treasureValue, useHerb, reliquaryFull } from '../core/run.js';\nimport { device } from '../core/device.js';\nimport { iconFor } from '../models/icons.js';\nimport { pymLine } from '../game/director.js';\nconst CELL = 14; const TABS = ['CASE', 'VALUABLES', 'KEY ITEMS', 'MAP', 'FILES', 'RADIO'];\nexport function openCase(A, o = {}) { A.openMenu(new CaseScreen(A, o)); }\nexport const openMapTab = (A) => openCase(A, { tab: 3 });\nexport class CaseScreen {\n  constructor(A, o) { this.A = A; this.s = { tab: o.tab ?? 0, focus: 0 }; this.cx = 0; this.cy = 0; this.held = null; this.menu = null; this.incoming = o.incoming ?? null; this.r1 = 0; if (o.focusNote) this.s.focus = A.run.notes.indexOf(o.focusNote); if (o.incoming) { this.held = { id: o.incoming.id, count: o.incoming.count, rot: false, fresh: true }; } if (this.A.ctx.audio) this.A.ctx.audio.play('uiconfirm'); }\n  close() { const A = this.A; if (this.held) { if (this.held.orig) { Object.assign(this.held.orig, { x: this.held.ox, y: this.held.oy, rot: this.held.orot }); A.run.items.push(this.held.orig); } this.held = null; } if (this.incoming) this.incoming = null; A.closeMenu(); A.ctx.audio.play('uiback'); }\n  update(ui) {\n    const A = this.A, run = A.run; ui.rect(0, 0, ui.W, ui.H, 'ink');\n    // R1 tap changes tab; hold arranges (CASE tab).\n    if (this.s.tab === 0) { const I = ui.input; if (I.isDown('PadR1')) { this.r1 += 1 / 60; if (this.r1 > 0.45 && !this.arrDone) { this.arrDone = true; this.doArrange(); } ui.tabNext = false; } else { if (this.r1 > 0 && this.r1 <= 0.45) ui.tabNext = true; else if (I.wasPressed('KeyE')) ui.tabNext = true; else ui.tabNext = false; this.r1 = 0; this.arrDone = false; } }\n    if (!this.menu && !this.held) ui.tabs(this.s, TABS, 10);\n    const tab = this.s.tab; ui.text(ui.W - 66, ui.H - 26, `${run.money} D`, { color: 'sand' });\n    if (tab === 0) this.caseTab(ui); else if (tab === 1) this.listTab(ui, run.valuables, 'treasure'); else if (tab === 2) this.listTab(ui, run.keys, 'key'); else if (tab === 3) this.mapTab(ui); else if (tab === 4) this.filesTab(ui); else this.radioTab(ui);\n    if (ui.back && !this.menu && !this.held) this.close(); else if (ui.back && this.menu) { this.menu = null; ui.back = false; ui.sound('uiback'); } else if (ui.back && this.held && !this.menu) this.cancelHeld(ui);\n    if (BIND_CLOSE(ui) && !this.held && !this.menu) this.close();\n  }\n  cancelHeld(ui) { const h = this.held; if (h.orig) { Object.assign(h.orig, { x: h.ox, y: h.oy, rot: h.orot }); this.A.run.items.push(h.orig); this.held = null; } else if (h.fresh) { this.held = null; this.incoming = null; this.close(); } ui.sound('uiback'); }\n  doArrange() { const r = this.A.run; if (arrange(r)) this.A.ctx.audio.play('uiconfirm'); else this.A.ctx.audio.play('uideny'); }\n  caseTab(ui) {\n    const A = this.A, run = A.run, G = run.grid, gx = 18, gy = 34, gw = G.w * CELL, gh = G.h * CELL;\n    ui.panel(gx - 2, gy - 2, gw + 4, gh + 4, { bg: 'night', border: 'slate' });\n    for (let y = 0; y < G.h; y++) for (let x = 0; x < G.w; x++) { ui.rect(gx + x * CELL, gy + y * CELL, CELL - 1, CELL - 1, 'navy'); }\n    for (const it of run.items) { const [w, h] = fp(it), px = gx + it.x * CELL, py = gy + it.y * CELL; ui.rect(px, py, w * CELL - 1, h * CELL - 1, run.weapon === it.id ? 'plum' : 'night'); const ic = iconFor(it.id, it.rot); ui.hud.sprite(px, py, ic.rows, ic.colors); if (ITEMS[it.id].max) ui.text(px + 1, py + h * CELL - 9, String(it.count), { color: 'white' }); }\n    // Cursor\n    if (!this.menu) {\n      if (ui.nav.left) this.cx--; if (ui.nav.right) this.cx++; if (ui.nav.up) this.cy--; if (ui.nav.down) this.cy++;\n      if (Object.keys(ui.nav).length) ui.sound('uimove');\n      if (ui.hover && ui.within(gx, gy, gw, gh)) { this.cx = Math.floor((ui.px - gx) / CELL); this.cy = Math.floor((ui.py - gy) / CELL); }\n      this.cx = Math.max(0, Math.min(G.w - 1, this.cx)); this.cy = Math.max(0, Math.min(G.h - 1, this.cy));\n    }\n    const under = run.items.find((it) => { const [w, h] = fp(it); return this.cx >= it.x && this.cx < it.x + w && this.cy >= it.y && this.cy < it.y + h; });\n    const focus = this.held ?? under;\n    if (this.held) {\n      const h = this.held, [w, hh] = fp(h); const nx = Math.min(this.cx, G.w - w), ny = Math.min(this.cy, G.h - hh); const ok = fits(run, h, Math.max(0, nx), Math.max(0, ny)); const px = gx + Math.max(0, nx) * CELL, py = gy + Math.max(0, ny) * CELL;\n      ui.rect(px - 1, py - 1, w * CELL + 1, hh * CELL + 1, ok ? 'green' : 'red'); ui.rect(px, py, w * CELL - 1, hh * CELL - 1, 'night'); const ic = iconFor(h.id, h.rot); ui.hud.sprite(px, py, ic.rows, ic.colors);\n      if (ui.secondary || ui.rclick || ui.wheel) { h.rot = !h.rot; ui.sound('uimove'); }\n      if (ui.confirm || (ui.click && ui.within(gx, gy, gw, gh, ui.cx, ui.cy))) {\n        if (ok) { this.placeHeld(Math.max(0, nx), Math.max(0, ny), ui); } else ui.sound('uideny');\n      }\n      if (ui.tertiary) this.dropHeld(ui);\n    } else if (this.menu) { this.itemMenu(ui, gx, gy); } else {\n      const px = gx + this.cx * CELL, py = gy + this.cy * CELL; const bl = Math.floor(ui.t * 4) % 2 ? 'sand' : 'white';\n      if (under) { const [w, h] = fp(under); const ux = gx + under.x * CELL, uy = gy + under.y * CELL, uw = w * CELL - 1, uh = h * CELL - 1; ui.rect(ux, uy, uw, 1, bl); ui.rect(ux, uy + uh, uw, 1, bl); ui.rect(ux, uy, 1, uh, bl); ui.rect(ux + uw, uy, 1, uh + 1, bl); } else { ui.rect(px, py, CELL - 1, 1, bl); ui.rect(px, py + CELL - 2, CELL - 1, 1, bl); ui.rect(px, py, 1, CELL - 1, bl); ui.rect(px + CELL - 2, py, 1, CELL - 1, bl); }\n      if ((ui.confirm || (ui.click && ui.within(gx, gy, gw, gh, ui.cx, ui.cy))) && under) { this.menu = { it: under, s: { focus: 0 }, mode: 'root' }; ui.confirm = false; ui.click = false; ui.sound('uiconfirm'); }\n      else if (ui.secondary && under) this.pickUp(under, ui);\n      else if (ui.tertiary && under) { this.pickUp(under, ui); this.dropHeld(ui); }\n      if (ui.input.wasPressed('KeyF')) this.doArrange();\n    }\n    this.infoPanel(ui, focus, gx + gw + 14, gy);\n    const pr = this.held ? [['confirm', 'PLACE'], ['secondary', 'ROTATE'], ['tertiary', 'DROP'], ['back', 'CANCEL']] : this.menu ? [['confirm', 'SELECT'], ['back', 'BACK']] : [['confirm', 'USE'], ['secondary', 'MOVE'], ['tertiary', 'DROP'], [device.last === 'pad' ? 'PadR1' : 'KeyF', 'HOLD: ARRANGE'], ['back', 'CLOSE']];\n    if (this.incoming && this.held?.fresh) ui.center(gy + gh + 8, 'NO ROOM. PLACE IT, OR LEAVE IT ON THE GROUND.', { color: 'orange' });\n    ui.prompts(pr);\n  }\n  pickUp(it, ui) { const r = this.A.run; removeItem(r, it); this.held = { id: it.id, rot: it.rot, count: it.count, orig: it, ox: it.x, oy: it.y, orot: it.rot }; ui.sound('uimove'); }\n  placeHeld(x, y, ui) {\n    const A = this.A, run = A.run, h = this.held; ui.sound('uiconfirm');\n    if (h.orig) { Object.assign(h.orig, { x, y, rot: h.rot }); run.items.push(h.orig); }\n    else { run.items.push({ uid: run.uid++, id: h.id, x, y, rot: h.rot, count: h.count ?? 1 }); if (this.incoming) { A.finishDrop(this.incoming); this.incoming = null; } }\n    this.held = null;\n  }\n  dropHeld(ui) {\n    const A = this.A, h = this.held, P = A.player; const d = ITEMS[h.id];\n    if (h.fresh) { this.held = null; this.incoming = null; this.close(); return; }\n    if (d.kind === 'weapon' && A.run.items.filter((i) => ITEMS[i.id].kind === 'weapon').length === 0) { ui.sound('uideny'); return; }\n    A.spawnDrop(P.pos.x + Math.sin(P.yaw) * 0.9, P.pos.z + Math.cos(P.yaw) * 0.9, { id: h.id, count: h.count ?? 1 }); if (A.run.weapon === h.id) { const w = A.run.items.find((i) => ITEMS[i.id].kind === 'weapon'); if (w) P.setWeapon(w.id); }\n    this.held = null; ui.sound('uiback');\n  }\n  itemMenu(ui, gx, gy) {\n    const A = this.A, run = A.run, M = this.menu, it = M.it, d = ITEMS[it.id]; const x = gx + 30, y = gy + 24;\n    if (M.mode === 'root') {\n      const list = []; if (d.kind === 'weapon') list.push({ label: run.weapon === it.id ? 'EQUIPPED' : 'EQUIP', disabled: run.weapon === it.id, go: 'equip' }); if (d.kind === 'herb') list.push({ label: 'USE', disabled: !d.heal, go: 'use' }); if (combinable(run, it).length) list.push({ label: 'COMBINE', go: 'combine' }); list.push({ label: 'MOVE', go: 'move' });\n      ui.panel(x - 4, y - 6, 110, list.length * 15 + 8, { bg: 'ink', border: 'sand' }); const i = ui.list(M.s, list, { x, y, w: 102, rowH: 15 });\n      if (i >= 0) { const g = list[i].go; if (g === 'equip') { A.player.setWeapon(it.id); this.menu = null; } else if (g === 'use') { useHerb(run, it); ui.sound('pickup'); this.menu = null; } else if (g === 'combine') { M.mode = 'combine'; M.s = { focus: 0 }; } else { this.menu = null; this.pickUp(it, ui); } }\n    } else {\n      const opts = combinable(run, it); const list = opts.map((o) => ({ label: ITEMS[o.id].name })); ui.panel(x - 4, y - 6, 170, list.length * 15 + 8, { bg: 'ink', border: 'sand' }); const i = ui.list(M.s, list, { x, y, w: 162, rowH: 15 });\n      if (i >= 0) { combine(run, it, opts[i]); ui.sound('pickup'); this.menu = null; }\n    }\n  }\n  infoPanel(ui, it, x, y) {\n    if (!it) { ui.text(x, y + 4, 'EMPTY', { color: 'slate' }); return; } const d = ITEMS[it.id]; const ic = iconFor(it.id); const w = ui.W - x - 12;\n    ui.hud.sprite(x, y, ic.rows, ic.colors); ui.text(x, y + ic.h + 6, d.name, { color: 'white' });\n    const about = d.kind === 'weapon' ? WEAPONS[d.weapon].about : (d.about ?? []); let yy = y + ic.h + 18; for (const l of about) { yy += ui.para(x, yy, l, w, { color: 'mist' }) * 10; }\n    if (d.kind === 'weapon') { const st = this.A.run.weapons[d.weapon]; ui.text(x, yy + 4, `LOADED ${st?.ammo ?? 0}`, { color: 'sand' }); }\n    if (d.kind === 'ammo') ui.text(x, yy + 4, `${it.count} OF ${d.max}`, { color: 'sand' });\n  }\n  listTab(ui, list, kind) {\n    const A = this.A, run = A.run, x = 34, y = 44; if (!list.length) { ui.center(90, kind === 'key' ? 'NO KEY ITEMS' : 'NOTHING OF VALUE', { color: 'slate' }); ui.prompts([['back', 'CLOSE']]); return; }\n    const items = list.map((id) => ({ label: ITEMS[id].name, value: kind === 'treasure' ? `${treasureValue(run, id)}` : null })); const i = ui.list(this.s, items, { x, y, w: 210, rowH: 17, max: 7 }); const id = list[this.s.focus]; if (!id) return; const ic = iconFor(id); const px = 270; ui.hud.sprite(px, y, ic.rows, ic.colors, { scale: 2 }); ui.text(px, y + 62, ITEMS[id].name, { color: 'white' }); let yy = y + 74; for (const l of ITEMS[id].about ?? []) yy += ui.para(px, yy, l, ui.W - px - 12, { color: 'mist' }) * 10;\n    if (id === 'reliquary') { const s = run.sockets; ui.text(px, yy + 4, `SOCKETS ${['pearl', 'blackpearl', 'amber'].filter((k) => s[k]).length}/3`, { color: 'sand' }); }\n    const socketable = ['pearl', 'blackpearl', 'amber'].includes(id) && run.valuables.includes('reliquary') && !run.sockets[id];\n    if (socketable && i >= 0) { socketInto(run, id); ui.sound('pickup'); }\n    ui.prompts(socketable ? [['confirm', 'SET IN RELIQUARY'], ['back', 'CLOSE']] : [['back', 'CLOSE']]);\n  }\n  mapTab(ui) {\n    const A = this.A, L = A.level, run = A.run, rows = L.rows, s = Math.min(2, Math.floor(Math.min((ui.W - 60) / L.W, (ui.H - 70) / L.H))) || 1, ox = Math.floor(ui.W / 2 - (L.W * s) / 2), oy = 26 + Math.floor((ui.H - 60 - L.H * s) / 2);\n    const col = { '#': 'night', T: 'slate', '~': 'navy', H: 'plum', D: 'orange', G: 'red', S: 'red', W: 'cyan', B: 'orange' };\n    for (let y = 0; y < L.H; y++) for (let x = 0; x < L.W; x++) { const c = rows[y][x]; ui.rect(ox + x * s, oy + y * s, s, s, col[c] ?? 'teal'); }\n    const mark = (m, c) => ui.rect(ox + m.col * s - 1, oy + m.row * s - 1, 3, 3, c); for (const m of L.markers.t) mark(m, 'white'); for (const m of L.markers.m) mark(m, 'lime'); if (run.keys.includes('chart')) for (const t of A.tannoys) if (!t.dead) mark(t.m, 'red');\n    const P = A.player; const b = Math.floor(ui.t * 3) % 2; ui.rect(ox + L.col(P.pos.x) * s - 1, oy + L.row(P.pos.z) * s - 1, 3, 3, b ? 'sand' : 'white');\n    ui.text(10, 28, A.def.title ?? A.id, { color: 'sand' }); ui.text(10, 40, A.objective, { color: 'mist' }); ui.text(10, ui.H - 34, `LOUDSPEAKERS ${run.tannoys.length}/15`, { color: 'mist' }); ui.prompts([['back', 'CLOSE']]);\n  }\n  filesTab(ui) {\n    const run = this.A.run; if (!run.notes.length) { ui.center(90, 'NO FILES YET', { color: 'slate' }); ui.prompts([['back', 'CLOSE']]); return; }\n    ui.list(this.s, run.notes.map((id) => ({ label: NOTES[id].title })), { x: 16, y: 44, w: 200, rowH: 17, max: 6, noConfirm: true }); const n = NOTES[run.notes[this.s.focus]]; const x = 232; ui.panel(x, 40, ui.W - x - 12, 120, { bg: 'white', border: 'sand' }); ui.text(x + 8, 48, n.title, { color: 'plum', shadow: false }); let y = 64; for (const l of n.lines) y += ui.para(x + 8, y, l, ui.W - x - 28, { color: 'ink', shadow: false }) * 10 + 3; ui.prompts([['back', 'CLOSE']]);\n  }\n  radioTab(ui) {\n    const A = this.A, safe = (A.safeRooms ?? []).some((m) => Math.hypot(m.x - A.player.pos.x, m.z - A.player.pos.z) < 8);\n    const px = 40, py = 50; const a = iconFor('pym'), b = iconFor('max'); ui.hud.sprite(px, py, a.rows, a.colors, { scale: 2 }); ui.hud.sprite(ui.W - px - 64, py, b.rows, b.colors, { scale: 2 }); ui.center(52, 'CLAIMS DESK', { color: 'cyan' });\n    ui.para(px + 76, 70, A.def.hint ? PYM_HINTS[A.def.hint] : PYM_HINTS.general, ui.W - 2 * px - 152, { color: safe ? 'white' : 'slate' }); ui.center(136, safe ? 'THE LINE IS CLEAR' : 'LONG CALLS ONLY IN DRY ROOMS. SHORT HINT ON HOLD.', { color: 'sand' });\n    const i = ui.list(this.s, [{ label: 'CALL THE DESK' }], { x: ui.W / 2 - 70, y: 156, w: 140, rowH: 16 }); if (i === 0) { A.closeMenu(); A.radio(A.def.hint ?? 'general'); A.app.mix.play('onhold'); A.ctx.tweens.call(6, () => A.app.mix.play(A.def.music ?? null)); return; }\n    ui.prompts([['confirm', 'CALL'], ['back', 'CLOSE']]);\n  }\n}\nfunction BIND_CLOSE(ui) { return ui.input.wasPressed('Tab') || ui.input.wasPressed('KeyI') || ui.input.wasPressed('PadTriangle') && !ui._t; }\nE\ncat > src/screens/shop.js <<'E'\n// Mr. Fathom. Tabs BUY, SELL, TUNE. Six rows, one big item panel, his helmet and a line of text.\nimport { ITEMS } from '../data/items.js';\nimport { WEAPONS, TUNE_NAME, TUNE_STATS, WEAPON_ORDER } from '../data/weapons.js';\nimport { CASE_SIZES, SHOP_BARKS, STOCK } from '../data/shop.js';\nimport { addItem, ammoOf, removeItem, sellPrice, sellTreasure, treasureValue, ownedWeapons } from '../core/run.js';\nimport { iconFor } from '../models/icons.js';\nimport { VoiceLine } from '../audio/voice.js';\nexport function openShop(A, f) { A.openMenu(new ShopScreen(A, f)); }\nexport function buy(run, id) {\n  if (CASE_SIZES[id]) { const c = CASE_SIZES[id]; if (run.money < c.price || run.grid.w >= c.w) return 'poor'; run.money -= c.price; run.grid = { w: c.w, h: c.h }; return 'ok'; }\n  const d = ITEMS[id]; const price = d.kind === 'weapon' ? WEAPONS[d.weapon].price : d.price;\n  if (run.money < price) return 'poor';\n  const left = addItem(run, id, d.gives ?? 1); if (left > 0) return 'full';\n  run.money -= price; return 'ok';\n}\nexport function tunePrice(id, stat, lvl) { const base = WEAPONS[id].tune; return base[Math.min(3, lvl)] * (stat === 'power' ? 1.2 : 1) | 0; }\nexport function tune(run, id, stat) { const st = run.weapons[id]; st.tune ??= {}; const l = st.tune[stat] || 0; if (l >= 4) return 'max'; const p = tunePrice(id, stat, l); if (run.money < p) return 'poor'; run.money -= p; st.tune[stat] = l + 1; return 'ok'; }\nexport function grantRewards(run) { const out = []; const n = run.tannoys.length; if (n >= 5 && !run.rewards.includes(5)) { run.rewards.push(5); run.money += 1000; out.push('5 LOUDSPEAKERS: 1000 D'); } if (n >= 10 && !run.rewards.includes(10)) { run.rewards.push(10); const next = run.grid.w < 12 ? CASE_SIZES.case1 : CASE_SIZES.case2; run.grid = { w: next.w, h: next.h }; out.push('10 LOUDSPEAKERS: A BIGGER CASE'); } if (n >= 15 && !run.rewards.includes(15)) { run.rewards.push(15); run.valuables.push('blackpearl'); out.push('15 LOUDSPEAKERS: A BLACK PEARL'); } return out; }\nexport class ShopScreen {\n  constructor(A, f) { this.A = A; this.f = f; this.s = { tab: 0, focus: 0 }; this.w = 0; this.line(A.rng.pick(SHOP_BARKS.greet)); A.app.mix.play('shop', 0.2); A.ctx.audio.play('bubble'); this.rewards = grantRewards(A.run); if (this.rewards.length) this.line(`A GIFT FOR THE COLLECTOR. ${this.rewards[0]}`); }\n  line(t) { this.bark = { text: t, n: 0, voice: new VoiceLine(this.A.ctx.audio, 'FATHOM', t, () => this.A.app.settings.voice) }; }\n  update(ui) {\n    const A = this.A, run = A.run; ui.rect(0, 0, ui.W, ui.H, 'ink'); ui.tabs(this.s, ['BUY', 'SELL', 'TUNE'], 10);\n    const m = `${run.money} D`, mw = ui.measure(m, 2); ui.text(ui.W - mw.width - 8, 26, m, { scale: 2, color: 'sand' });\n    // Helmet and bark\n    const b = this.bark; b.n = Math.min(b.text.length, b.n + 0.5); b.voice.tick(Math.floor(b.n)); const h = iconFor('helmet'); const hy = ui.H - 68; ui.hud.sprite(10, hy, h.rows, h.colors, { scale: 1 }); ui.panel(46, hy, ui.W - 56, 34, { bg: 'night', border: 'teal' }); ui.para(52, hy + 5, b.text.slice(0, Math.floor(b.n)), ui.W - 70, { color: 'lime' });\n    const t = this.s.tab; if (t === 0) this.buyTab(ui); else if (t === 1) this.sellTab(ui); else this.tuneTab(ui);\n    if (ui.back) { A.ctx.audio.play('bubble'); A.say('FATHOM', A.rng.pick(SHOP_BARKS.leave), 1.5); A.app.mix.play(A.def.music ?? null, 0.3); A.closeMenu(); }\n  }\n  panel(ui, id, x, y, extra) {\n    const ic = iconFor(id); const big = ic.h <= 28 && ic.w <= 56 ? 2 : 1; ui.hud.sprite(x, y, ic.rows, ic.colors, { scale: big }); const name = CASE_SIZES[id]?.name ?? ITEMS[id].name; const dy = y + ic.h * big + 6; ui.text(x, dy, name, { color: 'white' });\n    const about = CASE_SIZES[id] ? [`GRID ${CASE_SIZES[id].w} BY ${CASE_SIZES[id].h}.`] : ITEMS[id].kind === 'weapon' ? WEAPONS[ITEMS[id].weapon].about : ITEMS[id].about ?? []; let yy = dy + 12; for (const l of about) yy += ui.para(x, yy, l, ui.W - x - 10, { color: 'mist' }) * 10; if (extra) ui.text(x, yy + 2, extra, { color: 'sand' });\n  }\n  buyTab(ui) {\n    const A = this.A, run = A.run, list = (STOCK[Math.min(3, run.chapter)] ?? STOCK[1]).filter((id) => { if (CASE_SIZES[id]) return run.grid.w < CASE_SIZES[id].w; const d = ITEMS[id]; if (d.kind === 'weapon') return !run.items.some((i) => i.id === id); if (d.kind === 'key') return !run.keys.includes(id); return true; });\n    const price = (id) => CASE_SIZES[id]?.price ?? (ITEMS[id].kind === 'weapon' ? WEAPONS[ITEMS[id].weapon].price : ITEMS[id].price);\n    const items = list.map((id) => ({ label: CASE_SIZES[id]?.name ?? ITEMS[id].name, value: `${price(id)}`, valueColor: run.money >= price(id) ? 'sand' : 'red' })); const i = ui.list(this.s, items, { x: 10, y: 46, w: 214, rowH: 17, max: 6 });\n    const id = list[this.s.focus]; if (id) this.panel(ui, id, 238, 46);\n    if (i >= 0 && id) { const r = buy(run, id); if (r === 'ok') { A.ctx.audio.play('coins'); this.line(A.rng.pick(SHOP_BARKS.buy)); } else if (r === 'full') { A.ctx.audio.play('uideny'); this.line('NO ROOM IN THAT CASE, FRIEND. ARRANGE IT OR SELL SOMETHING.'); } else { A.ctx.audio.play('uideny'); this.line(A.rng.pick(SHOP_BARKS.poor)); } }\n    ui.prompts([['confirm', 'BUY'], ['back', 'LEAVE']]);\n  }\n  sellTab(ui) {\n    const A = this.A, run = A.run; const owned = ownedWeapons(run); const items = [...run.valuables.map((id, n) => ({ id, tr: true, n })), ...run.items.filter((it) => !(ITEMS[it.id].kind === 'weapon' && owned.length <= 1)).map((it) => ({ it, id: it.id }))]; const rows = items.map((r) => ({ label: ITEMS[r.id].name, value: `${r.tr ? treasureValue(run, r.id) : sellPrice(run, r.it)}` }));\n    if (!rows.length) { ui.text(16, 60, 'NOTHING TO SELL', { color: 'slate' }); ui.prompts([['back', 'LEAVE']]); return; }\n    const i = ui.list(this.s, rows, { x: 10, y: 46, w: 214, rowH: 17, max: 6 }); const r = items[this.s.focus]; if (r) this.panel(ui, r.id, 238, 46, r.tr ? 'FULL PRICE: TREASURE' : 'HALF PRICE');\n    if (i >= 0 && r) { if (r.tr) sellTreasure(run, r.id); else { run.money += sellPrice(run, r.it); if (run.weapon === r.id) { removeItem(run, r.it); const w = ownedWeapons(run)[0]; if (w) A.player.setWeapon(w); } else removeItem(run, r.it); } A.ctx.audio.play('coins'); this.line(r.tr ? 'A FINE PIECE. I KNOW A WIDOW WHO COLLECTS.' : A.rng.pick(SHOP_BARKS.sell)); }\n    ui.prompts([['confirm', 'SELL'], ['back', 'LEAVE']]);\n  }\n  tuneTab(ui) {\n    const A = this.A, run = A.run, list = ownedWeapons(run); if (!list.length) return; this.w = Math.max(0, Math.min(list.length - 1, this.w)); if (ui.nav.left) { this.w = (this.w - 1 + list.length) % list.length; ui.sound('uimove'); } if (ui.nav.right) { this.w = (this.w + 1) % list.length; ui.sound('uimove'); }\n    const id = list[this.w], st = run.weapons[id]; st.tune ??= {}; const rows = TUNE_STATS.map((s) => { const l = st.tune[s] || 0; return { label: TUNE_NAME[s], value: l >= 4 ? 'MAX' : `${tunePrice(id, s, l)}` }; });\n    ui.center(30, `< ${WEAPONS[id].name} >`, { color: 'white' }); const i = ui.list(this.s, rows, { x: 10, y: 54, w: 214, rowH: 20 });\n    TUNE_STATS.forEach((s, k) => { const l = st.tune[s] || 0; for (let n = 0; n < 4; n++) ui.rect(120 + n * 10, 56 + k * 20, 8, 7, n < l ? 'sand' : 'night'); });\n    const ic = iconFor(id); ui.hud.sprite(238, 46, ic.rows, ic.colors); ui.para(238, 84, TUNE_STATS.every((s) => (st.tune[s] || 0) >= 4) ? `PERK ON: ${WEAPONS[id].perk}` : `FILL ALL FOUR: ${WEAPONS[id].perk}`, ui.W - 248, { color: 'sand' });\n    if (i >= 0) { const r = tune(run, id, TUNE_STATS[i]); if (r === 'ok') { A.ctx.audio.play('reload3'); this.line(A.rng.pick(SHOP_BARKS.tune)); } else { A.ctx.audio.play('uideny'); this.line(r === 'max' ? 'SHE WILL TAKE NO MORE, FRIEND.' : A.rng.pick(SHOP_BARKS.poor)); } }\n    ui.prompts([['confirm', 'TUNE'], ['left', 'WEAPON'], ['back', 'LEAVE']]);\n  }\n}\nE\ncat > src/screens/settings.js <<'E'\n// Paged, not dense. Same screen for every input.\nimport { DEFAULT_SETTINGS, storeSettings } from '../core/save.js';\nimport { TUNING } from '../data/tuning.js';\nconst LOOKS = ['native', 'spooky', 'ps1_horror', 'noir'];\nconst PAGES = ['SOUND', 'CONTROLS', 'PICTURE'];\nexport class SettingsScreen {\n  constructor(app) { this.app = app; this.s = { tab: 0, focus: 0 }; this.done = false; }\n  rows(tab) {\n    const S = this.app.settings;\n    if (tab === 0) return [{ k: 'music', label: 'MUSIC', min: 0, max: 1 }, { k: 'sfx', label: 'SOUND EFFECTS', min: 0, max: 1 }, { k: 'voice', label: 'VOICES', min: 0, max: 1 }, { k: 'master', label: 'MASTER', min: 0, max: 1 }, { reset: true, label: 'RESET ALL SETTINGS' }];\n    if (tab === 1) return [{ k: 'padAim', label: 'AIM SPEED, PAD', min: 0.3, max: 2 }, { k: 'mouseAim', label: 'AIM SPEED, MOUSE', min: 0.3, max: 2 }, { k: 'aimAssist', label: 'AIM ASSIST', min: 0, max: 2 }, { k: 'invertY', label: 'INVERT Y', opts: [false, true], names: ['OFF', 'ON'] }, { k: 'glyphs', label: 'CONTROLLER GLYPHS', opts: ['ps', 'xbox'], names: ['PLAYSTATION', 'XBOX'] }];\n    return [{ k: 'shake', label: 'SCREEN SHAKE', min: 0, max: 1.5 }, { k: 'look', label: 'LOOK', opts: LOOKS, names: LOOKS.map((l) => l.toUpperCase().replace('_', ' ')) }, { k: 'pixelSize', label: 'PIXEL SIZE', opts: ['fine', 'chunky'], names: ['FINE', 'CHUNKY'] }, { k: 'quality', label: 'QUALITY', opts: ['low', 'medium', 'high'], names: ['LOW', 'MEDIUM', 'HIGH'] }, { k: 'fps', label: 'FRAME RATE', opts: [60, 30, 0], names: ['60', '30', 'DISPLAY'] }, { full: true, label: 'FULLSCREEN' }];\n  }\n  update(ui) {\n    const app = this.app, S = app.settings; ui.rect(0, 0, ui.W, ui.H, 'ink'); ui.center(26, 'SETTINGS', { scale: 2, color: 'sand' }); const tab = ui.tabs(this.s, PAGES, 46); const rows = this.rows(tab);\n    const display = rows.map((r) => ({ label: r.label })); const x = Math.round(ui.W / 2 - 170), y = 68; const i = ui.list(this.s, display, { x, y, w: 340, rowH: 20, noConfirm: true });\n    rows.forEach((r, k) => {\n      const ry = y + k * 20 + 4, on = this.s.focus === k;\n      if (r.min != null) { const nv = ui.slider(x + 170, ry, 110, S[r.k], r.min, r.max, { def: DEFAULT_SETTINGS[r.k] }); if (nv !== S[r.k]) { S[r.k] = nv; this.apply(); } ui.text(x + 290, ry, `${Math.round(S[r.k] * 100)}%`, { color: on ? 'white' : 'mist' }); if (on) { const st = (r.max - r.min) / 20; if (ui.nav.left) { S[r.k] = Math.max(r.min, S[r.k] - st); this.apply(); ui.sound('uimove'); } if (ui.nav.right) { S[r.k] = Math.min(r.max, S[r.k] + st); this.apply(); ui.sound('uimove'); } } }\n      else if (r.opts) { const n = r.opts.indexOf(S[r.k]); ui.text(x + 170, ry, `< ${r.names[Math.max(0, n)]} >`, { color: on ? 'white' : 'mist' }); const step = (d) => { S[r.k] = r.opts[(Math.max(0, n) + d + r.opts.length) % r.opts.length]; this.apply(); ui.sound('uimove'); }; if (on && ui.nav.left) step(-1); if (on && (ui.nav.right || ui.confirm)) step(1); if (ui.click && ui.within(x + 170, ry - 4, 150, 16, ui.cx, ui.cy)) step(1); }\n    });\n    const r = rows[this.s.focus]; if (ui.confirm || (ui.click && ui.within(x, y + this.s.focus * 20 - 2, 170, 18, ui.cx, ui.cy))) { if (r?.reset) { Object.assign(S, DEFAULT_SETTINGS); this.apply(); ui.sound('uiconfirm'); } if (r?.full) app.toggleFullscreen(); }\n    ui.prompts([['confirm', 'CHANGE'], ['left', 'ADJUST'], ['back', 'BACK']]);\n    if (ui.back) { ui.sound('uiback'); this.done = true; }\n  }\n  apply() { const app = this.app; storeSettings(app.settings); app.applySettings(); }\n}\nE\ncat > src/screens/about.js <<'E'\n// Paged. Source Information, Testing Feedback, Engine Feedback, Prompt Feedback, Credits.\nimport { ABOUT_PAGES } from '../data/about.js';\nexport class AboutScreen {\n  constructor(app) { this.app = app; this.s = { tab: 0 }; this.scroll = 0; this.done = false; }\n  update(ui) {\n    ui.rect(0, 0, ui.W, ui.H, 'ink'); const titles = ABOUT_PAGES.map((p) => p.tab); const prev = this.s.tab; const tab = ui.tabs(this.s, titles, 10); if (tab !== prev) this.scroll = 0; const page = ABOUT_PAGES[tab]; const W = Math.min(ui.W - 40, 420), x = Math.round(ui.W / 2 - W / 2), top = 28, bottom = ui.H - 22;\n    const lines = []; for (const [k, v] of page.rows) { if (k) lines.push({ t: k, c: 'sand' }); for (const l of ui.wrap(v, W)) lines.push({ t: l, c: 'white' }); lines.push({ t: '', c: 'white' }); }\n    const vis = Math.floor((bottom - top) / 10); const maxS = Math.max(0, lines.length - vis);\n    if (ui.nav.down) this.scroll++; if (ui.nav.up) this.scroll--; if (ui.wheel) this.scroll += Math.sign(ui.wheel) * 2; this.scroll = Math.max(0, Math.min(maxS, this.scroll));\n    for (let i = 0; i < vis && i + this.scroll < lines.length; i++) { const L = lines[i + this.scroll]; ui.text(x, top + i * 10, L.t, { color: L.c }); }\n    if (this.scroll > 0) ui.text(ui.W - 14, top, '^', { color: 'sand' }); if (this.scroll < maxS) ui.text(ui.W - 14, bottom - 10, 'V', { color: 'sand' });\n    ui.prompts([['up', 'SCROLL'], ['back', 'BACK']]); if (ui.back) { ui.sound('uiback'); this.done = true; }\n  }\n}\nE\ncat > src/screens/dev.js <<'E'\n// Dev mode: tools, teleport, spawn, live balance sliders. Same pixel UI.\nimport { TUNING, TUNING_DEFS, TUNING_DEFAULT, resetTuning } from '../data/tuning.js';\nimport { SPAWNABLE, ENEMIES } from '../data/enemies.js';\nimport { TELEPORTS } from '../data/levels/areas.js';\nimport { ITEMS } from '../data/items.js';\nimport { save } from '../core/save.js';\nimport { addItem } from '../core/run.js';\nexport class DevScreen {\n  constructor(A) { this.A = A; this.s = { tab: 0, focus: 0 }; this.page = 0; this.done = false; A.app.devUsed = true; }\n  update(ui) {\n    ui.rect(0, 0, ui.W, ui.H, 'ink'); const tab = ui.tabs(this.s, ['TOOLS', 'TELEPORT', 'SPAWN', 'BALANCE'], 10); [this.tools, this.teleport, this.spawn, this.balance][tab].call(this, ui); if (ui.back) { ui.sound('uiback'); this.done = true; }\n  }\n  tools(ui) {\n    const A = this.A, P = A.player, e = A.ctx.engine; const on = (b) => (b ? 'ON' : 'OFF');\n    const rows = [\n      { label: 'GOD MODE', value: on(P.god), f: () => { P.god = !P.god; } }, { label: 'NO-CLIP', value: on(P.noclip), f: () => { P.noclip = !P.noclip; } }, { label: 'INFINITE AMMO', value: on(A.infiniteAmmo), f: () => { A.infiniteAmmo = !A.infiniteAmmo; } }, { label: 'ONE-HIT KILLS', value: on(A.oneHit), f: () => { A.oneHit = !A.oneHit; } }, { label: 'FREEZE AI', value: on(A.frozenAI), f: () => { A.frozenAI = !A.frozenAI; } },\n      { label: 'SHOW HIT ZONES', value: on(A.showZones), f: () => { A.app.dev.toggleZones(A); } }, { label: 'SHOW NAV AND FLOW', value: on(A.showNav), f: () => { A.app.dev.toggleNav(A); } }, { label: 'SHOW TRIGGERS', value: on(A.showTriggers), f: () => { A.app.dev.toggleTriggers(A); } },\n      { label: 'GAME SPEED', value: `${A.savedScale ?? 1}`, f: () => { const L = [0.25, 0.5, 1, 2], k = L.indexOf(A.savedScale ?? 1); A.savedScale = L[(k + 1) % 4]; } },\n      { label: 'SKIP CUTSCENE', f: () => { A.cutscene?.skip(); if (A.dialog.active) A.dialog.skip(); } }, { label: 'HEAL', f: () => { A.run.health = A.run.maxHealth; if (A.dame) A.dame.hp = A.dame.maxHp; } }, { label: 'GIVE 10,000 DOUBLOONS', f: () => { A.run.money += 10000; } },\n      { label: 'GIVE ALL WEAPONS AND ITEMS', f: () => { A.run.grid = { w: 14, h: 8 }; for (const id of Object.keys(ITEMS)) { const d = ITEMS[id]; if (d.kind === 'weapon' && !A.run.items.some((i) => i.id === id)) addItem(A.run, id); else if (d.kind === 'treasure' || d.kind === 'key') addItem(A.run, id); else if (d.kind === 'ammo') addItem(A.run, id, d.max); } } },\n      { label: 'FILL CASE', f: () => { let g = 0; while (g++ < 200 && addItem(A.run, 'samphire') === 0); } }, { label: 'KILL ALL', f: () => { for (const x of [...A.enemies]) if (!x.dead) x.die({}); } }, { label: 'UNLOCK ALL', f: () => { for (const d of A.level.doors) A.level.openDoor(d, null, true); for (const k in A.level.gates) { const g = A.level.gates[k]; if (g.q) A.level.openGate(g); } } },\n      { label: 'ENGINE DEBUG PANEL', value: on(e.debugShown), f: () => { e.showDebug?.(!e.debugShown); } }, { label: 'RESET ALL COUNTERS', f: () => { A.run.stats.kills = 0; } },\n    ];\n    const i = ui.list(this.s, rows, { x: 40, y: 34, w: 300, rowH: 15, max: 12 }); if (i >= 0) rows[i].f();\n    ui.text(350, 40, `RANK ${A.rank()}`, { color: 'sand' }); ui.text(350, 52, `ALIVE ${A.enemies.filter((x) => !x.dead).length}`, { color: 'sand' }); ui.text(350, 64, `TOKENS ${A.tokensHeld}/${A.maxTokens()}`, { color: 'sand' }); ui.prompts([['confirm', 'TOGGLE'], ['back', 'BACK']]);\n  }\n  teleport(ui) {\n    const rows = TELEPORTS.map((t) => ({ label: t.label })); const i = ui.list(this.s, rows, { x: 60, y: 34, w: 300, rowH: 15, max: 13 }); ui.prompts([['confirm', 'GO'], ['back', 'BACK']]); if (i >= 0) { const A = this.A, t = TELEPORTS[i]; A.menu = null; A.ctx.engine.timeScale = 1; A.app.teleport(t); }\n  }\n  spawn(ui) {\n    const rows = SPAWNABLE.map((t) => ({ label: ENEMIES[t].name })); const i = ui.list(this.s, rows, { x: 60, y: 34, w: 300, rowH: 15, max: 13 }); ui.prompts([['confirm', 'SPAWN AT THE LASER DOT'], ['back', 'BACK']]);\n    if (i >= 0) { const A = this.A, P = A.player; const at = P.dotOn ? P.dot : { x: P.pos.x + Math.sin(P.camYaw) * 5, z: P.pos.z + Math.cos(P.camYaw) * 5 }; A.spawnEnemy(SPAWNABLE[i], at.x, at.z, { floor: P.floor }); }\n  }\n  balance(ui) {\n    const keys = Object.keys(TUNING_DEFS), perPage = 8, pages = Math.ceil(keys.length / perPage); const start = this.page * perPage, list = keys.slice(start, start + perPage); const rows = list.map((k) => ({ label: k.replace(/([A-Z])/g, ' $1').toUpperCase() })); rows.push({ label: 'RESET ALL' });\n    const x = Math.round(ui.W / 2 - 200), y = 34; const i = ui.list(this.s, rows, { x, y, w: 400, rowH: 21, noConfirm: true });\n    list.forEach((k, n) => { const [def, min, max] = TUNING_DEFS[k], ry = y + n * 21 + 4; const nv = ui.slider(x + 180, ry, 100, TUNING[k], min, max, { def }); if (nv !== TUNING[k]) { TUNING[k] = nv; this.persist(); } ui.text(x + 290, ry, TUNING[k].toFixed(2), { color: 'white' }); ui.text(x + 330, ry, `DEF ${def}`, { color: 'slate' }); if (this.s.focus === n) { const st = (max - min) / 40; if (ui.nav.left) { TUNING[k] = Math.max(min, TUNING[k] - st); this.persist(); ui.sound('uimove'); } if (ui.nav.right) { TUNING[k] = Math.min(max, TUNING[k] + st); this.persist(); ui.sound('uimove'); } if (ui.tertiary) { TUNING[k] = TUNING_DEFAULT[k]; this.persist(); ui.sound('uiback'); } } });\n    if (ui.confirm && this.s.focus === list.length) { resetTuning(); this.persist(); ui.sound('uiconfirm'); }\n    if (ui.click && ui.within(x, y + list.length * 21 - 2, 200, 18, ui.cx, ui.cy)) { resetTuning(); this.persist(); }\n    if (ui.secondary) { this.page = (this.page + 1) % pages; this.s.focus = 0; ui.sound('uimove'); }\n    ui.text(x, ui.H - 32, `PAGE ${this.page + 1}/${pages}`, { color: 'slate' }); ui.prompts([['left', 'ADJUST'], ['tertiary', 'RESET ONE'], ['secondary', 'NEXT PAGE'], ['back', 'BACK']]);\n  }\n  persist() { save.set('tuning', { ...TUNING }); }\n}\nE\necho ok","description":"Write icons, Case, Shop, pause, settings, about, dev screens"}}}
