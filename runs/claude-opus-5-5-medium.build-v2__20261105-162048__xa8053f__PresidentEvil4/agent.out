- boss.px, boss.pos.z - boss.railZ); if (d < 2.4) { b.wantCmd = true; } } const side = P.pos.x < 0 ? -1 : 1; const gx = boss.reload <= 0 ? (Math.abs(P.pos.x - zx[0]) < Math.abs(P.pos.x - zx[1]) ? zx[0] : zx[1]) : boss.pos.x + 9 * Math.sign(P.pos.x - boss.pos.x || 1); return { x: gx, z: a.level.wz(18) + (P.pos.z > 0 ? 4.5 : -4.5), r: 1.5 }; } return { x: boss.pos.x - Math.sin(boss.yaw) * 7, z: boss.pos.z - Math.cos(boss.yaw) * 7, r: 2 }; } if (!b.shopDone.has('y')) { b.shopDone.add('y'); botShop(a, b); } return GO(a, 17.5, 2.5, { r: 0.6 }); },\n  causeway(a, b) { const S = a.tide; if (S?.gate) return GO(a, 7.5, 0.8, { r: 0.4 }); return GO(a, 7.5, 4, { r: 1 }); },\n  abbey(a, b) { const P = a.player, L = a.level; if (!a.lensSolved) { if (P.pos.z > L.wz(32)) return GO(a, 22, 31, { r: 1 }); const s = a.statues.find((x) => x.step !== x.target); if (s) return { x: s.m.x, z: s.m.z + 1.6, r: 1.2, press: true, pressAny: true }; } if (!a.cryptDone) { if (a.cryptOn) return { wait: true }; return GO(a, 22, 11, { r: 1 }); } if (!b.shopDone.has('a')) { b.shopDone.add('a'); botShop(a, b); } if (L.row(P.pos.z) > 7) return GO(a, 21.5, 6, { r: 1 }); return GO(a, 21.5, 1.4, { r: 1, press: true }); },\n  nave(a, b) { const boss = a.boss, P = a.player, L = a.level; if (!boss) return GO(a, 13.5, 38, { r: 1 }); if (!boss.dead) { if (boss.phase === 2 && boss.locks.every((l) => l.dead)) return { x: boss.pos.x, z: boss.pos.z + 3.4, r: 2.6, press: true, pressAny: true }; if (boss.phase === 3) return GO(a, 14, 24, { r: 1 }); const dd = boss.pos.distanceTo(P.pos); if (dd < 8) return { x: P.pos.x + (P.pos.x - boss.pos.x), z: P.pos.z + (P.pos.z - boss.pos.z), r: 1 }; return { wait: true }; } return GO(a, 25, 6, { r: 0.4 }); },\n  launch(a, b) { return { wait: true }; },\n};\nE\ncat > src/data/about.js <<'E'\n// One source for the About screen and exit-interview.json. Filled in with real answers at the end.\nexport const SOURCE_INFO = {\n  date: '2026-11-05 16:20:48', source: 'Resident Evil 4', plan: 'PLAN.md', genre: 'Third-person action-horror shooter with crowd control, resource management and an escort', perspective: 'Over-the-shoulder third person with a laser sight; letterboxed cinematic cameras; one on-rails shooting finale',\n  tech: 'Riftlight pixel-engine 0.46.0 (three.js r186 WebGPU, Rapier), plain JavaScript modules bundled with esbuild, AI Hub session client 1.4.0', artDirection: 'The engine native pixel style at 480 by 270 with a soft vignette: palette toon materials, data-driven puppets and props, plus library props for generic things', animation: 'Engine clip system on the hero rig: masked upper and lower layers, about 60 new clips and gaits, spring-chain scarf, ragdolls, head look', audio: 'All code. Song data for ten original pieces at 10 percent music by default, about 60 synthesised sound effects, Animalese-style gibberish voices per speaker', online: 'AI Hub Session Protocol v1 shared-world co-op (1 to 4); standalone parties over BroadcastChannel and WebRTC invite codes with a public STUN server',\n  testing: 'Headless node scripts and Playwright browsers on this computer, behind one command; stand-ins for pad, touch, audio and second player; no subagents for review', research: 'Read the design plan, the engine kit guide, API and assets docs, and the AI Hub protocol README. No web research on the source.', environment: 'Claude Code CLI (headless); Linux', model: 'Anthropic, claude-opus-5-5, reasoning effort medium', usage: 'added on import',\n};\nconst LABEL = { date: 'DATE', source: 'SOURCE', plan: 'PLAN', genre: 'GENRE', perspective: 'PERSPECTIVE', tech: 'TECH', artDirection: 'ART DIRECTION', animation: 'ANIMATION', audio: 'AUDIO', online: 'ONLINE', testing: 'TESTING', research: 'RESEARCH', environment: 'ENVIRONMENT', model: 'MODEL', usage: 'USAGE' };\nexport const TESTING_FEEDBACK = [['How many issues did testing catch?', 'unknown'], ['How many would be considered critical issues / game breaking?', 'unknown'], ['What was the most helpful test you ran?', 'unknown'], ['What was the least helpful test you ran?', 'unknown']];\nexport const ENGINE_FEEDBACK = [['What did you like most about the engine?', 'unknown'], ['Did you get stuck or guess wrong?', 'unknown'], ['What was the most important thing you had to build yourself?', 'unknown'], ['What was the hardest part about using the engine?', 'unknown'], ['What did you change in the engine, and why? (none if nothing)', 'none'], ['If you could change one thing about the engine, what would it be?', 'unknown']];\nexport const PROMPT_FEEDBACK = [['What did you like most about this prompt?', 'unknown'], ['What was confusing?', 'unknown'], ['What was the hardest thing to do?', 'unknown'], ['What would you change in this prompt?', 'unknown']];\nexport const CREDITS = [['ENGINE', 'Riftlight pixel-engine 0.46.0 by Michael Crosato, MIT licence, as it ships.'], ['THREE.JS', 'three.js r186, MIT licence. Ships inside the engine.'], ['RAPIER', 'Rapier physics by Dimforge, Apache 2.0 licence. Ships inside the engine.'], ['AI HUB', 'AI Hub Session Protocol v1 client, unmodified.'], ['ORIGINAL WORK', 'An original game inspired by the genre and mechanics of Resident Evil 4. Everything seen and heard here was written for this game.'], ['USAGE', 'added on import']];\nconst q = (x) => x.map(([k, v]) => [k, v]);\nexport const ABOUT_PAGES = [{ tab: 'SOURCE', rows: Object.keys(SOURCE_INFO).map((k) => [LABEL[k], SOURCE_INFO[k]]) }, { tab: 'TESTING', rows: q(TESTING_FEEDBACK) }, { tab: 'ENGINE', rows: q(ENGINE_FEEDBACK) }, { tab: 'PROMPT', rows: q(PROMPT_FEEDBACK) }, { tab: 'CREDITS', rows: q(CREDITS) }];\nexport const CREDIT_LINES = [['POLICY 7741: CLOSED', 'sand', 2], [''], ['MAX RANSOM', 'white'], ['FIELD ADJUSTER, OSTRANDER MUTUAL'], [''], ['DAME OTTOLINE VANE', 'white'], ['THE INSURED'], [''], ['COMMODORE ANSELM THOLE', 'white'], ['ON THE AIR'], [''], ['MR. FATHOM', 'white'], ['GOODS OF NO FIXED DESCRIPTION'], [''], ['MR. PYM', 'white'], ['PLEASE HOLD'], [''], ['BUILT ON RIFTLIGHT PIXEL-ENGINE 0.46.0', 'sand'], ['THREE.JS R186  RAPIER'], ['ALL MUSIC, SOUND AND VOICES WRITTEN IN CODE'], [''], ['YOUR CALL IS IMPORTANT TO OSTRANDER MUTUAL', 'cyan']];\nexport const AI_HUB = { type: 'Game', genre: 'Horror', source: 'Resident Evil 4', series: 'Resident Evil', players: '1–4', controls: 'Pad: L2 aim, R2 fire, Cross kick and action, Circle run. Keyboard and mouse: WASD, right mouse aim, left mouse fire, E action, Shift run.', tags: ['3d', 'third-person', 'horror', 'co-op', 'boss fights', 'pixel art'] };\nE\ncat > src/main.js <<'E'\n// Page entry: session or standalone, Engine.start, first scene.\nimport { Engine, PALETTE, withUrlOptions } from '../pixel-engine.js';\nimport { SLUG } from './config.js';\nimport { app, NATIVE_LOOK } from './core/app.js';\nimport { Area } from './game/area.js';\nimport { Launch } from './game/launch.js';\nimport { TitleScene } from './screens/title.js';\nimport { PauseMenu } from './screens/pause.js';\nimport { AttractDirector } from './screens/attract.js';\nimport { device } from './core/device.js';\nimport { startSession } from './net/session.js';\napp.factories = { area: Area, launch: Launch, title: TitleScene }; app.PauseMenu = PauseMenu;\napp.startAttract = (touch) => { if (app.attract) return; const d = new AttractDirector(app, !!touch); d.start(); };\nexport const startOptions = () => withUrlOptions({ container: document.getElementById('app'), camera: { preset: 'third', fov: 55 }, look: NATIVE_LOOK, quality: 'high', touch: false, settings: { button: false, key: SLUG }, debugUI: false, background: PALETTE.ink });\nasync function startStandalone() {\n  const engine = await Engine.start(new TitleScene(app), startOptions()); app.attach(engine); window.__APP__ = app; const params = new URLSearchParams(location.search);\n  if (params.get('g_area')) { app.run = (await import('./core/run.js')).newRun(); await app.goArea(params.get('g_area'), { jump: params.get('g_jump') || undefined, fromSave: true }); }\n}\nasync function boot() {\n  if (window.AIHub?.active) { const info = await window.AIHub.connect({ mode: 'shared-world', seats: [1, 4], card: true }); if (info) return startSession(info); }\n  return startStandalone();\n}\nboot().catch((e) => { console.error(e); const d = document.createElement('div'); d.style.cssText = 'position:fixed;inset:0;display:flex;align-items:center;justify-content:center;color:#f4f4f4;background:#1a1c2c;font:20px monospace;padding:40px;text-align:center'; d.textContent = `Failed to start: ${e?.message ?? e}. This game needs WebGPU: a recent Chrome or Edge, Safari 26, or Firefox on Windows.`; document.body.append(d); });\nE\nmkdir -p src/net; cat > src/net/session.js <<'E'\nexport function startSession() {}\nE\ncat > src/screens/lobby.js <<'E'\nexport class LobbyScreen { constructor(app) { this.done = true; } update() {} }\nE\ncat > tools/smoke.mjs <<'E'\nimport { Engine } from '../pixel-engine.js';\nimport { app } from '../src/core/app.js';\nimport { Area } from '../src/game/area.js';\nimport { Launch } from '../src/game/launch.js';\nimport { TitleScene } from '../src/screens/title.js';\nimport { PauseMenu } from '../src/screens/pause.js';\nimport { newRun } from '../src/core/run.js';\nimport { readFile } from 'node:fs/promises';\napp.factories = { area: Area, launch: Launch, title: TitleScene }; app.PauseMenu = PauseMenu; app.startAttract = () => {};\nconst assets = async (p) => new Uint8Array(await readFile(new URL('../' + p, import.meta.url))).buffer;\napp.run = newRun();\nconst id = process.argv[2] || 'quay', jump = process.argv[3];\nconst engine = await Engine.headless(new TitleScene(app), { assets, camera: { preset: 'third', fov: 55 } }); app.attach(engine);\nawait app.goArea(id, { jump, fromSave: true });\nfor (let i = 0; i < 300; i++) { engine.step(1); }\nconsole.log(engine.state().status, engine.errors); console.log(engine.game.player.pos); process.exit(0);\nE\ntimeout 100 node tools/smoke.mjs 2>&1 | grep -v \"^file://\\|^\\s*$\\|\\`);