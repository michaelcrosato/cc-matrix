.22, 0], 'rag'), b([0.06, 0.08, 0.06], [0, 0.29, 0], 'fire', { glow: true })]);\nexport const wSaw = f('w-saw', \"The Flenser's steam saw\", { steel: 'mist', body: 'plum', dark: 'ink', pipe: 'slate' }, [b([0.14, 0.2, 0.34], [0, 0, 0.1], 'body'), { group: [{ cyl: [0.62, 0.04, 0.62], at: [0, 0, 0], rot: [0, 0, 90], c: 'steel', seg: 12 }, b([0.05, 0.1, 0.7], [0, 0, 0], 'dark'), b([0.05, 0.7, 0.1], [0, 0, 0], 'dark')], name: 'Blade', pivot: true, at: [0, 0.02, 0.48] }, b([0.06, 0.06, 0.3], [0, 0.14, 0.02], 'pipe')]);\nexport const wGaff = f('w-gaff', 'Gaff hook', { wood: 'orange', steel: 'mist' }, [b([0.05, 0.05, 0.74], [0, 0, 0.26], 'wood'), b([0.05, 0.18, 0.05], [0, 0.08, 0.64], 'steel'), b([0.05, 0.05, 0.1], [0, 0.17, 0.6], 'steel')]);\nexport const wBoathook = f('w-boathook', 'Boathook', { wood: 'sand', steel: 'slate' }, [b([0.05, 0.05, 1.3], [0, 0, 0.45], 'wood'), b([0.05, 0.14, 0.05], [0, 0.06, 1.1], 'steel'), { cone: [0.07, 0.14, 0.07], at: [0, 0, 1.16], rot: [90, 0, 0], c: 'steel' }]);\nexport const wFlail = f('w-flail', 'Monk flail', { wood: 'plum', steel: 'slate' }, [b([0.05, 0.05, 0.42], [0, 0, 0.14], 'wood'), b([0.04, 0.04, 0.26], [0, -0.06, 0.45], 'steel', { rot: [20, 0, 0] }), { ball: [0.18, 0.18, 0.18], at: [0, -0.13, 0.6], c: 'steel' }]);\nexport const wShield = f('w-shield', 'Abbey shield with a cross of salt', { face: 'plum', rim: 'slate', mark: 'sand' }, [b([0.7, 1.0, 0.07], [0, 0, 0], 'face'), b([0.76, 0.08, 0.09], [0, 0.5, 0], 'rim'), b([0.76, 0.08, 0.09], [0, -0.5, 0], 'rim'), b([0.1, 0.6, 0.09], [0, 0, 0], 'mark'), b([0.4, 0.1, 0.09], [0, 0.1, 0], 'mark')]);\nexport const wHalberd = f('w-halberd', 'Long halberd', { wood: 'night', steel: 'mist' }, [b([0.06, 0.06, 1.9], [0, 0, 0.6], 'wood'), b([0.05, 0.42, 0.26], [0, 0.1, 1.45], 'steel'), { cone: [0.08, 0.3, 0.08], at: [0, 0, 1.65], rot: [90, 0, 0], c: 'steel' }]);\nexport const wAnchor = f('w-anchor', \"The Bosun's anchor\", { iron: 'night', hi: 'slate' }, [b([0.16, 0.16, 1.4], [0, 0, 0.8], 'iron'), b([1.1, 0.16, 0.16], [0, 0, 1.45], 'iron'), { cone: [0.2, 0.3, 0.2], at: [0.62, 0, 1.32], rot: [-90, 0, 0], c: 'hi' }, { cone: [0.2, 0.3, 0.2], at: [-0.62, 0, 1.32], rot: [-90, 0, 0], c: 'hi' }, { torus: [0.3, 0.08, 0.3], at: [0, 0, 0.1], rot: [90, 0, 0], c: 'hi' }]);\nexport const wHelmet = f('w-helmet', \"Reliquary knight's helmet\", { steel: 'mist', slit: 'ink', band: 'orange' }, [{ cyl: [0.38, 0.36, 0.38], at: [0, 0.14, 0], c: 'steel' }, b([0.26, 0.05, 0.04], [0, 0.17, 0.19], 'slit'), b([0.05, 0.14, 0.05], [0, 0.38, 0], 'band')]);\nexport const wMic = f('w-mic', 'Brass broadcast microphone', { brass: 'sand', cable: 'night' }, [{ cyl: [0.1, 0.2, 0.1], at: [0, 0, 0], c: 'brass' }, { ball: [0.14, 0.14, 0.14], at: [0, 0.14, 0], c: 'brass' }, b([0.04, 0.04, 0.2], [0, -0.1, -0.1], 'cable')]);\nexport const WEAPON_MODELS = { wPistol, wScatter, wRifle, wHarpoon, wBolt, wKnife, wFlare, wDepth, wBottle, wSaw, wGaff, wBoathook, wFlail, wShield, wHalberd, wAnchor, wHelmet, wMic };\nE\ncat > src/models/props.js <<'E'\n// Original props. Generic ones come from the engine's library via `use`.\nimport { model } from '../../pixel-engine.js';\nconst b = (box, at, c, more) => ({ box, at, c, ...more });\nconst m = (id, about, tags, palette, parts, extra = {}) => model({ id, about, tags, palette, parts, ...extra });\nexport const tannoy = m('tannoy', 'Tannoy horn on a tall pole', ['prop'], { pole: 'slate', horn: 'mist', dark: 'night', wire: 'ink' }, [{ cyl: [0.14, 4.2, 0.14], at: [0, 2.1, 0], c: 'pole' }, { group: [{ cone: [0.7, 0.6, 0.7], at: [0, 4.2, 0.28], rot: [-90, 0, 0], c: 'horn' }, b([0.2, 0.2, 0.3], [0, 4.2, -0.14], 'dark')], name: 'Horn', pivot: true }, b([0.5, 0.08, 0.08], [0, 3.8, 0], 'wire')], { collider: 'none' });\nexport const foghorn = m('foghorn', 'The Foghorn tower, 20 m, on a rock', ['backdrop'], { stone: 'slate', dark: 'night', horn: 'sand', glow: 'orange', band: 'red' }, [{ cyl: [5, 16, 5], at: [0, 8, 0], top: 0.7, c: 'stone', seg: 10 }, { cyl: [5.2, 1.4, 5.2], at: [0, 5, 0], top: 0.85, c: 'band', seg: 10 }, { cyl: [4.2, 2, 4.2], at: [0, 17, 0], c: 'dark', seg: 10 }, { cone: [4.6, 2, 4.6], at: [0, 19, 0], c: 'stone', seg: 10 }, { cone: [3.2, 4, 3.2], at: [-3, 17, 0], rot: [0, 0, 90], c: 'horn' }, b([1, 0.9, 4.3], [0, 17, 0], 'glow', { glow: true })], { collider: 'none' });\nexport const mailboat = m('mailboat', 'The mail boat, sinking and burning', ['prop', 'boat'], { hull: 'night', trim: 'white', cab: 'sand', mast: 'ink', red: 'red' }, [b([2.6, 1.2, 8], [0, 0.6, 0], 'hull'), { cone: [2.6, 2, 1.5], at: [0, 0.6, 4.6], rot: [90, 0, 0], c: 'hull' }, b([2.7, 0.14, 8.1], [0, 1.2, 0], 'trim'), b([1.8, 1.4, 2.6], [0, 1.9, -1], 'cab'), { cyl: [0.14, 4, 0.14], at: [0, 3, 1], c: 'mast' }, b([2.7, 0.1, 8.1], [0, 0.4, 0], 'red')], { collider: 'none' });\nexport const rowboat = m('rowboat', 'A rowboat', ['prop', 'boat'], { hull: 'orange', trim: 'sand', dark: 'night' }, [b([1.2, 0.5, 3.2], [0, 0.25, 0], 'hull'), { cone: [1.2, 0.8, 0.5], at: [0, 0.25, 1.8], rot: [90, 0, 0], c: 'hull' }, b([1.0, 0.1, 3], [0, 0.46, 0], 'dark'), b([1.1, 0.1, 0.3], [0, 0.5, -0.6], 'trim'), b([1.1, 0.1, 0.3], [0, 0.5, 0.5], 'trim')]);\nexport const lobsterpot = m('lobsterpot', 'A wicker lobster pot', ['prop', 'hide'], { wick: 'orange', dark: 'plum', rope: 'sand' }, [{ cyl: [0.9, 0.9, 0.9], at: [0, 0.45, 0], c: 'wick', seg: 8 }, { cyl: [0.94, 0.08, 0.94], at: [0, 0.2, 0], c: 'dark', seg: 8 }, { cyl: [0.94, 0.08, 0.94], at: [0, 0.65, 0], c: 'dark', seg: 8 }, { cyl: [0.5, 0.08, 0.5], at: [0, 0.94, 0], c: 'rope', seg: 8 }], { collider: 'cyl' });\nexport const dryingRack = m('drying-rack', 'A drying rack hung with split fish', ['prop'], { wood: 'orange', fish: 'mist', dark: 'night' }, [{ mirror: [b([0.12, 2.2, 0.12], [1.4, 1.1, 0], 'wood')], axis: 'x' }, b([3, 0.1, 0.1], [0, 2.1, 0], 'wood'), b([3, 0.08, 0.08], [0, 1.6, 0], 'wood'), ...[-1.1, -0.6, -0.1, 0.4, 0.9].flatMap((x) => [b([0.16, 0.5, 0.05], [x, 1.8, 0], 'fish'), b([0.16, 0.4, 0.05], [x + 0.2, 1.3, 0],