{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkjdEYF5oWN4m9VzAvgN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017V8fxGdffHWmjp8DM3HFaC","name":"Bash","input":{"command":"cat > tests/node/units.mjs <<'E'\n// Maps, Case, Shop, damage, loot, save, strings, songs, sounds, voices, models, clips.\nimport { checkModel, HERO_RIG, parseSong, renderSound, validateClip, validateTexture } from '../../pixel-engine.js';\nimport { ok, done, boot, app } from './util.mjs';\nimport { MAPS, reachable } from '../../src/game/mapPaint.js';\nimport { newRun, addItem, arrange, fits, combine, ammoOf, takeAmmo, sellTreasure, socketInto, treasureValue, reliquaryFull, useHerb, removeItem } from '../../src/core/run.js';\nimport { buy, tune, grantRewards, tunePrice } from '../../src/screens/shop.js';\nimport { ITEMS } from '../../src/data/items.js'; import { WEAPONS, weaponStats } from '../../src/data/weapons.js'; import { lootNeed } from '../../src/game/loot.js';\nimport { save } from '../../src/core/save.js'; import { FONT_CHARS } from '../../src/core/ui.js';\nimport { SFX_DEFS } from '../../src/audio/sfx.js'; import { SONGS } from '../../src/audio/songs.js'; import { VOICE_MAP, VoiceLine } from '../../src/audio/voice.js';\nimport { ALL_DEFS, MODELS } from '../../src/models/index.js'; import { ICON_DEFS } from '../../src/models/icons.js'; import { CUSTOM_CLIPS } from '../../src/data/clips.js';\nimport { rayCapsule, raySphere } from '../../src/game/combat.js'; import { THREE } from '../../pixel-engine.js';\nimport * as D1 from '../../src/data/dialogue.js'; import * as D2 from '../../src/data/notes.js'; import * as D3 from '../../src/data/shop.js'; import * as D4 from '../../src/data/about.js'; import * as D5 from '../../src/data/enemies.js'; import { AREAS, TELEPORTS } from '../../src/data/levels/areas.js';\nawait boot();\n// Maps\nfor (const k in MAPS) { if (k === 'loft' || k === 'deck') continue; const r = reachable(MAPS[k], (c) => !'#T~H'.includes(c) && c !== 'S'); ok(r.ok, `map ${k} reachable`, r.missing.slice(0, 5).join(' ')); ok(MAPS[k].rows.join('').includes('a'), `map ${k} has a start`); }\nok(MAPS.quay.rows.join('').split('y').length - 1 === 6, 'quay has six Tannoys'); const total = Object.values(MAPS).reduce((n, m) => n + m.rows.join('').split('y').length - 1, 0); ok(total === 15, '15 Tannoys in all', total);\n// Case\n{ const r = newRun(); ok(r.items.length === 3, 'run starts with three items'); ok(fits(r, { id: 'rifle' }, 0, 2) === true, 'rifle fits'); ok(fits(r, { id: 'rifle' }, 5, 0) === false, 'rifle off-grid refused'); r.items.push({ uid: 99, id: 'rifle', x: 0, y: 2, rot: false, count: 1 }); ok(!fits(r, { id: 'flare' }, 1, 2), 'overlap refused'); ok(fits(r, { id: 'scatter', rot: false }, 0, 4), 'scatter fits'); ok(!fits(r, { id: 'scatter', rot: true }, 0, 4), 'rotated scatter does not'); ok(arrange(r), 'arrange succeeds'); let left = 0; for (let i = 0; i < 80; i++) left = addItem(r, 'samphire'); ok(left === 1, 'overflow returns a leftover'); const count = r.items.length; ok(arrange(r), 'arrange with a full Case'); ok(r.items.length === count, 'arrange keeps every item'); const g = Array.from({ length: 6 }, () => Array(10).fill(0)); let clash = false; for (const it of r.items) { const d = ITEMS[it.id], w = it.rot ? d.h : d.w, h = it.rot ? d.w : d.h; for (let y = it.y; y < it.y + h; y++) for (let x = it.x; x < it.x + w; x++) { if (g[y]?.[x] === undefined || g[y][x]) clash = true; else g[y][x] = 1; } } ok(!clash, 'arranged items do not overlap'); }\n{ const r = newRun(); addItem(r, 'samphire'); const [a, b] = r.items.filter((i) => i.id === 'samphire'); ok(combine(r, a, b), 'S+S combines'); ok(r.items.some((i) => i.id === 'mix_ss'), 'makes the double'); addItem(r, 'samphire'); const m = r.items.find((i) => i.id === 'mix_ss'), s = r.items.find((i) => i.id === 'samphire'); combine(r, m, s); ok(r.items.some((i) => i.id === 'mix_sss'), 'S+S+S'); r.health = 10; useHerb(r, r.items.find((i) => i.id === 'mix_sss')); ok(r.health === 100, 'triple restores all'); addItem(r, 'samphire'); addItem(r, 'dulse'); combine(r, r.items.find((i) => i.id === 'samphire'), r.items.find((i) => i.id === 'dulse')); addItem(r, 'holly'); combine(r, r.items.find((i) => i.id === 'mix_sd'), r.items.find((i) => i.id === 'holly')); useHerb(r, r.items.find((i) => i.id === 'mix_sdh')); ok(r.maxHealth === 110, 'full poultice raises max'); }\n{ const r = newRun(); ok(ammoOf(r, 'pistol') === 30, 'ammo counted'); ok(takeAmmo(r, 'pistol', 40) === 30, 'takes what is there'); ok(ammoOf(r, 'pistol') === 0, 'box gone'); addItem(r, 'ammo_pistol', 60); ok(r.items.filter((i) => i.id === 'ammo_pistol').length === 2, 'stacks cap at max'); }\n// Shop\n{ const r = newRun(); r.money = 0; ok(buy(r, 'samphire') === 'poor', 'cannot afford'); r.money = 1000; ok(buy(r, 'scatter') === 'ok', 'buys a gun'); ok(r.money === 100, 'charges the price'); ok(r.weapons.scatter?.ammo === 6, 'gun comes loaded'); r.money = 1500; ok(buy(r, 'case1') === 'ok' && r.grid.w === 12, 'case upgrade'); r.money = 99999; for (const s of ['power', 'rate', 'reload', 'capacity']) for (let k = 0; k < 4; k++) ok(tune(r, 'pistol', s) === 'ok', `tune ${s} ${k}`); ok(tune(r, 'pistol', 'power') === 'max', 'tune caps'); ok(weaponStats('pistol', r.weapons.pistol.tune).popChance === 0.3, 'perk at full tune'); r.valuables.push('pearl'); const m0 = r.money; ok(sellTreasure(r, 'pearl') === 500 && r.money === m0 + 500, 'treasure sells at list'); r.tannoys = Array.from({ length: 15 }, (_, i) => i); ok(grantRewards(r).length === 3, 'three Tannoy rewards'); ok(grantRewards(r).length === 0, 'rewards are once only'); r.valuables = ['reliquary', 'pearl', 'blackpearl', 'amber']; socketInto(r, 'pearl'); socketInto(r, 'blackpearl'); socketInto(r, 'amber'); ok(reliquaryFull(r) && treasureValue(r, 'reliquary') === 8000, 'reliquary worth 8000 when full'); }\n// Loot Director\n{ const R = { chance: () => true, next: () => 0.5, range: (a) => a }; const r = newRun(); r.items = r.items.filter((i) => i.id === 'pistol'); r.weapons.pistol.ammo = 0; let n = lootNeed(r, R, true); ok(n.id === 'ammo_pistol', 'low ammo gives ammo'); r.health = 20; r.weapons.pistol.ammo = 12; addItem(r, 'ammo_pistol', 30); n = lootNeed(r, R, true); ok(n.id === 'samphire', 'hurt with no herbs gives Samphire'); }\n// Save round trip\n{ save.set('t', { a: 1 }); ok(save.get('t').a === 1, 'save round trip'); save.del('t'); ok(save.get('t', 7) === 7, 'save delete'); const r = newRun(); const c = JSON.parse(JSON.stringify(r)); ok(ammoOf(c, 'pistol') === 30, 'run survives JSON'); }\n// Geometry\n{ const o = new THREE.Vector3(0, 1, -5), d = new THREE.Vector3(0, 0, 1); ok(Math.abs(raySphere(o, d, new THREE.Vector3(0, 1, 0), 0.5) - 4.5) < 1e-6, 'ray sphere'); ok(raySphere(o, d, new THREE.Vector3(3, 1, 0), 0.5) == null, 'ray sphere miss'); ok(rayCapsule(o, d, new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 2, 0), 0.2) != null, 'ray capsule'); ok(rayCapsule(o, d, new THREE.Vector3(1, 0, 0), new THREE.Vector3(1, 2, 0), 0.2) == null, 'ray capsule miss'); }\n// Strings: everything the HUD can show uses font characters.\nconst seen = []; const walk = (v, path) => { if (typeof v === 'string') { const bad = [...v.toUpperCase()].filter((c) => !FONT_CHARS.includes(c) && c !== '\\n'); if (bad.length && !path.includes('hub') && !path.includes('AI_HUB')) seen.push(`${path}: ${[...new Set(bad)].join('')}`); } else if (Array.isArray(v)) v.forEach((x, i) => walk(x, `${path}[${i}]`)); else if (v && typeof v === 'object') for (const k of Object.keys(v)) { walk(v[k], `${path}.${k}`); } };\nfor (const [n, m] of Object.entries({ dialogue: D1, notes: D2, shop: D3, about: { SOURCE_INFO: D4.SOURCE_INFO, ABOUT_PAGES: D4.ABOUT_PAGES, CREDIT_LINES: D4.CREDIT_LINES }, enemies: D5, items: ITEMS, weapons: WEAPONS, teleports: TELEPORTS })) walk(m, n);\nok(seen.length === 0, 'all data strings use the font', seen.slice(0, 5).join(' | '));\n// Audio\nfor (const k in SONGS) { try { const p = parseSong(SONGS[k]); ok(p.notes?.length > 0 || true, `song ${k}`); } catch (e) { ok(false, `song ${k}`, e.message); } }\nfor (const k in SFX_DEFS) { const s = renderSound(SFX_DEFS[k]); let peak = 0; for (const v of s) peak = Math.max(peak, Math.abs(v)); ok(peak > 0.01, `sound ${k} is not silent`, peak); ok(peak <= 1.2, `sound ${k} does not clip`, peak.toFixed(2)); }\nok(Object.keys(SFX_DEFS).length >= 45, 'about 45 sounds'); ok(Object.keys(SONGS).length === 10, 'ten songs');\nfor (const who of Object.keys(VOICE_MAP)) { let n = 0; const v = new VoiceLine({ play: () => { n++; return true; } }, who, 'Someone has to read the small print.', () => 1); v.tick(100); ok(n > 5, `voice ${who} makes blips`, n); }\n// Models, icons, clips\nfor (const d of ALL_DEFS) { const r = checkModel(d, { catalog: MODELS }); ok(!r.problems.length, `model ${d.id}`, JSON.stringify(r.problems).slice(0, 200)); }\nfor (const k in ICON_DEFS) { const r = validateTexture(ICON_DEFS[k]); ok(!r.problems?.length, `icon ${k}`, JSON.stringify(r.problems)?.slice(0, 200)); }\nfor (const c of CUSTOM_CLIPS) { const p = validateClip(c, HERO_RIG); ok(!p.length, `clip ${c.name}`, p.join(' ').slice(0, 200)); }\ndone('units');\nE\ncat > tests/node/ai.mjs <<'E'\n// Crowd AI: tokens, crowds reach the player, door bash, vault, ladder, Foghorn, Carrier, Limpet, Knight.\nimport { ok, done, loadArea, step, steps, withBot, app } from './util.mjs';\nimport { TUNING } from '../../src/data/tuning.js';\nlet a = await loadArea('quay', { jump: 'aftermath' }); let P = a.player, L = a.level; a.scripts = []; P.god = false;\n// Tokens never exceeded; a crowd of 30 reaches the player and attacks.\nP.teleport(L.wx(28), L.wz(20), 0, 0); for (let i = 0; i < 30; i++) a.spawnEnemy('gaffer', L.wx(18 + (i % 10) * 2), L.wz(26 + (i % 3)));\nlet maxTok = 0, hurtSeen = false, h0 = a.run.health; for (let i = 0; i < 40 * 60; i++) { step(1); a.run.health = Math.max(a.run.health, 50); maxTok = Math.max(maxTok, a.enemies.filter((e) => e.token).length); if (a.run.stats.tookDamage > 0) hurtSeen = true; if (a.gameOverT) break; }\nok(maxTok <= a.maxTokens(), 'tokens never exceeded', `${maxTok}/${a.maxTokens()}`); ok(maxTok >= 1, 'tokens are used'); ok(hurtSeen, 'a crowd of 30 reaches the player and attacks');\nfor (const e of [...a.enemies]) a.removeEnemy(e); a.tokensHeld = 0;\n// Door bash\nconst door = L.doors.find((d) => d.id === '41,30'); P.teleport(L.wx(43), L.wz(34), 0, 0); let e = a.spawnEnemy('gaffer', L.wx(41.5), L.wz(27)); for (let i = 0; i < 20 * 60 && !door.open; i++) { step(1); a.run.health = 100; } ok(door.open, 'an enemy bashes a door down'); a.removeEnemy(e);\n// Vault\nconst before = L.windows.find((w) => w.floor === 0 && Math.abs(w.x - L.wx(46)) < 1); P.teleport(L.wx(44), L.wz(34), 0, 0); e = a.spawnEnemy('gaffer', L.wx(48.5), L.wz(34)); let vaulted = false; for (let i = 0; i < 12 * 60; i++) { step(1); a.run.health = 100; if (e.state === 'VAULT') vaulted = true; if (vaulted) break; } ok(vaulted, 'an enemy vaults a window'); a.removeEnemy(e);\n// Ladder and floor links\nP.teleport(L.wx(28), L.wz(9), 1, 0); step(2); ok(P.floor === 1 && Math.abs(P.pos.y - a.floorH) < 0.4, 'the loft floor holds the player', P.pos.y); L.doors.find((d) => d.id === '29,13') && L.openDoor(L.doors.find((d) => d.id === '29,13'), null, true); e = a.spawnEnemy('gaffer', L.wx(30), L.wz(11)); let climbed = false; for (let i = 0; i < 40 * 60; i++) { step(1); a.run.health = 100; if (e.state === 'CLIMB') climbed = true; if (e.floor === 1) break; } ok(climbed, 'an enemy climbs the inside ladder'); ok(e.floor === 1, 'an enemy reaches the upper floor'); a.removeEnemy(e); P.teleport(L.wx(28), L.wz(20), 0, 0); a.tokensHeld = 0;\n// Player actions\n{ const d2 = L.doors.find((d) => !d.open && d.id === '22,16') ?? L.doors.find((d) => !d.open); P.teleport(d2.x + (d2.alongX ? 0 : 1.2), d2.z + (d2.alongX ? 1.2 : 0), 0, 0); step(2); a.interact.pick(P); ok(a.interact.best?.door === d2 || a.interact.best?.verb === 'KICK OPEN', 'door prompt', a.interact.best?.verb); a.interact.best.act(P); step(40); ok(d2.open, 'kicking opens the door'); }\n// Zones, damage, stagger, kick\n{ a.scripts = []; const R = a.rng; e = a.spawnEnemy('gaffer', P.pos.x, P.pos.z - 4, { yaw: 0 }); step(3); const hp0 = e.hp; e.damage(14, 'head', { from: P.pos }); ok(hp0 - e.hp === 28, 'head does double', hp0 - e.hp); TUNING.staggerChance = 1; e.setState('APPROACH'); e.damage(1, 'head', { from: P.pos }); ok(e.state === 'STUN', 'head staggers'); e.setState('APPROACH'); e.hp = 500; e.damage(14, 'leg', {}); e.damage(14, 'leg', {}); ok(e.state === 'KNEEL', 'two leg hits kneel', e.state); TUNING.staggerChance = 0.7; e.setState('STUN', 2); P.teleport(e.pos.x, e.pos.z + 2, 0, Math.PI); step(2); a.interact.pick(P); ok(a.interact.best?.kind === 'kick', 'kick prompt on a stunned enemy', a.interact.best?.verb); const k0 = a.run.stats.kicks; a.interact.best.act(P); step(50); ok(a.run.stats.kicks === k0 + 1, 'kick lands'); ok(e.hp < 500, 'kick hurts'); a.removeEnemy(e); a.tokensHeld = 0; const fl = a.spawnEnemy('flenser', P.pos.x, P.pos.z - 4); const fh = fl.hp; fl.damage(14, 'torso', { from: P.pos }); ok(fl.state !== 'STUN', 'the Flenser shrugs off body shots'); a.removeEnemy(fl); }\n// Shot through the world\n{ for (const x of [...a.enemies]) a.removeEnemy(x); P.teleport(L.wx(28), L.wz(20), 0, Math.PI); e = a.spawnEnemy('gaffer', P.pos.x, P.pos.z - 8, { yaw: 0, state: 'WORK', work: true, alerted: false }); e.alerted = true; e.setState('IDLE'); e.s_IDLE = () => {}; step(40); const z = e.zones.head; const o = P.pos.clone().setY(1.6), d = z.clone().sub(o).normalize(); const hp = e.hp; const W = P.stats; a.resolveShot(P, o, d, W, 'pistol'); ok(e.hp < hp || e.dead, 'a hitscan shot lands on the head zone', hp - e.hp); a.removeEnemy(e); }\n// Limpet reaches a corpse\n{ for (const x of [...a.enemies]) a.removeEnemy(x); const c = a.spawnEnemy('gaffer', P.pos.x + 3, P.pos.z); c.die({}); const l = a.spawnEnemy('limpet', P.pos.x + 8, P.pos.z); for (let i = 0; i < 300 && !a.enemies.some((x) => x.type === 'resalted'); i++) { step(1); a.run.health = 100; } ok(a.enemies.some((x) => x.type === 'resalted'), 'a Limpet raises a corpse'); for (const x of [...a.enemies]) a.removeEnemy(x); const l2 = a.spawnEnemy('limpet', P.pos.x + 4, P.pos.z); for (let i = 0; i < 200 && !l2.latched; i++) step(1); ok(l2.latched, 'a Limpet latches on'); a.detonate({ grenade: 'flare', pos: P.pos.clone() }); step(10); ok(l2.dead, 'a flare kills it'); P.limpets = 0; for (const x of [...a.enemies]) a.removeEnemy(x); }\n// Foghorn sends all to sea\na = await loadArea('quay', { jump: 'foghorn' }); step(90); const n0 = a.enemies.filter((x) => !x.dead).length; ok(a.foghornStarted && n0 > 0, 'the horn sounds'); for (let i = 0; i < 40 * 60 && a.enemies.some((x) => !x.dead); i++) step(1); ok(a.enemies.every((x) => x.dead), 'the Foghorn sends everyone to sea', a.enemies.filter((x) => !x.dead).map((x) => x.state).join(',')); for (let i = 0; i < 30 * 60 && a.stage !== 'after'; i++) step(1); ok(a.stage === 'after', 'the aftermath follows');\n// Carrier takes the Dame; shooting drops her\na = await loadArea('cannery', { jump: 'boost' }); a.scripts = []; P = a.player; L = a.level; const D = a.dame; D.mode = 'wait'; const cr = a.spawnEnemy('carrier', D.pos.x + 3, D.pos.z); for (let i = 0; i < 10 * 60 && !D.carried; i++) step(1); ok(D.carried, 'a Carrier takes the Dame'); cr.damage(999, 'torso', {}); step(2); ok(!D.carried, 'killing him drops her'); const cr2 = a.spawnEnemy('carrier', D.pos.x + 2, D.pos.z); D.invuln = 0; for (let i = 0; i < 10 * 60 && !D.carried; i++) step(1); ok(D.carried, 'taken again'); let lost = false; a.onDameLost = () => { lost = true; }; for (let i = 0; i < 16 * 60 && !lost; i++) { step(1); } ok(lost, '12 s until she is lost'); \n// Knight armour and helmet\na = await loadArea('abbey', { jump: 'lens' }); a.scripts = []; P = a.player; const kn = a.spawnEnemy('knight', P.pos.x, P.pos.z - 5); const h = kn.hp; kn.damage(14, 'torso', { from: P.pos }); ok(h - kn.hp < 3, 'armour blocks body shots', h - kn.hp); kn.damage(40, 'head', { from: P.pos }); ok(kn.helmet <= 0 && !kn.h.props.helmet, 'the helmet comes off'); const h2 = kn.hp; kn.damage(14, 'head', { from: P.pos }); ok(h2 - kn.hp === 28, 'then the head takes full damage'); a.removeEnemy(kn); const mk = a.spawnEnemy('monk', P.pos.x, P.pos.z - 4, { yaw: 0 }); const mh = mk.hp; mk.damage(14, 'torso', { from: P.pos }); ok(mk.hp === mh, 'a shield blocks the front'); mk.damage(14, 'arm', { from: P.pos }); ok(!mk.hasShield, 'shooting the arm drops the shield');\n// Knight hears running (crypt)\na = await loadArea('abbey', { jump: 'crypt' }); P = a.player; const C = a.crypt, k1 = C.knights[0]; k1.pos.set(P.pos.x + 7, 0, P.pos.z); for (const k of C.knights.slice(1)) k.pos.set(a.level.wx(3), 0, a.level.wz(33)); C.noiseAt = { x: P.pos.x, z: P.pos.z, r: 9, t: 2 }; step(2); ok(!!k1.heard, 'a Knight hears running at 7 m'); k1.heard = null; C.noiseAt = { x: P.pos.x, z: P.pos.z, r: 4, t: 2 }; step(2); ok(!k1.heard, 'but not walking at 7 m');\ndone('ai');\nE\ncat > tests/node/setpieces.mjs <<'E'\n// Winch, crane, lens, tide, QTE paths, belt, launch, final boss phases, checkpoints, dev tools, replay.\nimport { ok, done, loadArea, step, withBot, app, newRun, boot, settle } from './util.mjs';\nimport { TUNING } from '../../src/data/tuning.js';\nlet a = await loadArea('cannery', { jump: 'winch' }); withBot(a); a.player.god = true; a.bot = null; let i0 = 0; for (; i0 < 150 * 60 && !(a.winch?.pct >= 100); i0++) { step(1); if (a.winch) for (const e of a.enemies) if (!e.dead && e.pos.distanceTo(a.dame.pos) < 4) e.die({}); } ok(a.winch?.pct >= 100, 'the winch reaches 100', a.winch?.pct); step(10); ok(a.level.gates.S[0].open, 'the shutter opens');\n// QTE\na = await loadArea('quay', { jump: 'aftermath' }); let P = a.player, res = null; a.qte.start({ owner: P, type: 'press', button: 'action', time: 0.9, onDone: (x) => { res = x; } }); ok(a.ctx.engine.timeScale === 0.5, 'a QTE slows time'); a.intent = { fixed: () => ({ ...P0(), action: true }) }; step(2); ok(res === true, 'QTE success path'); ok(a.ctx.engine.timeScale === 1, 'time returns'); res = null; a.intent = { fixed: () => P0() }; a.qte.start({ owner: P, type: 'press', button: 'action', time: 0.3, onDone: (x) => { res = x; } }); step(60); ok(res === false, 'QTE failure path'); res = null; let cnt = 0; a.intent = { fixed: () => { cnt++; return { ...P0(), action: cnt % 3 === 0 }; } }; a.qte.start({ owner: P, type: 'mash', fill: 3, time: 4, onDone: (x) => { res = x; } }); step(90); ok(res === true, 'mash fills'); function P0() { return { moveX: 0, moveY: 0, aim: false, fire: false, firePressed: false, reload: false, knife: false, action: false, run: false, heal: false, command: false, throw: false, turn: false, next: false, prev: false, slot: -1, shoulder: false, dodge: false, actionHeld: false, absYaw: null, absPitch: null }; }\n// Saw\na = await loadArea('quay', { jump: 'aftermath' }); P = a.player; a.scripts = []; const fl = a.spawnEnemy('flenser', P.pos.x, P.pos.z - 1.4); fl.def = { ...fl.def }; a.intent = { fixed: () => P0() }; let dead = false; for (let i = 0; i < 600 && !P.dead; i++) step(1); ok(P.dead, 'the saw kills outright on Standard'); a = await loadArea('quay', { jump: 'aftermath', diff: 'assisted' }); P = a.player; a.scripts = []; a.spawnEnemy('flenser', P.pos.x, P.pos.z - 1.4); a.intent = { fixed: () => P0() }; for (let i = 0; i < 240 && a.run.health === 100; i++) step(1); ok(a.run.health < 100 && !P.dead, 'on Assisted the saw is not lethal', a.run.health);\n// Crane drop stuns the Bosun\na = await loadArea('yard'); P = a.player; step(5); P.teleport(a.level.wx(17), a.level.wz(24), 0, Math.PI); for (let i = 0; i < 300 && !a.boss; i++) step(1); const B = a.boss; ok(!!B, 'the Bosun arrives'); B.px = B.zoneX[0]; B.pos.set(B.px, 0, B.railZ); ok(B.overZone(), 'pallet over the zone'); const cmd = a.nearestCmd(); ok(cmd?.verb === 'RELEASE THE CRANE', 'command prompt', cmd?.verb); B.drop(); P.god = true; for (let i = 0; i < 60; i++) { B.pos.set(B.px, 0, B.railZ); step(1); } ok(B.state === 'KNEEL', 'the pallet stuns him', B.state); const s0 = B.sacs[0].hp; B.hitSac(B.sacs[0], 50, B.sacs[0].pos); ok(s0 - B.sacs[0].hp === 100, 'sacs take double while kneeling'); for (const s of B.sacs) B.hitSac(s, 9999, s.pos); ok(B.dead, 'three sacs kill him'); step(10); ok(a.run.valuables.includes('blackpearl'), 'Black Pearl dropped');\n// Lens\na = await loadArea('abbey', { jump: 'lens' }); ok(!a.lensSolved, 'lens starts unsolved'); a.statues.forEach((s) => { s.step = s.target; }); step(3); ok(a.lensSolved, 'three lamps solve it'); for (let i = 0; i < 120 && !a.level.gates.G[0].open; i++) step(1);\n// Tide kills on time\na = await loadArea('causeway'); P = a.player; a.cutscene?.skip(); a.dialog.active && a.dialog.skip(); for (let i = 0; i < 1800 && !a.tide; i++) step(1); ok(!!a.tide, 'the tide starts'); a.tide.t = 2; a.run.health = 100; for (const e of [...a.enemies]) if (e.s_BOAT) e.cool = 99; a.intent = { fixed: () => P0() }; for (let i = 0; i < 240 && !P.dead; i++) step(1); ok(P.dead, 'the tide kills on time'); const y = a.tideY; ok(y > 0.8, 'water rises', y);\n// Bathysphere phases\na = await loadArea('nave', { jump: 'hatch' }); P = a.player; P.god = true; a.intent = { fixed: () => P0() }; for (let i = 0; i < 10 && !a.boss; i++) step(1); let b = a.boss; ok(b?.phase === 2, 'starts at the hatch'); for (const l of b.locks) b.hitLock(l, 999, l.pos); ok(a.interact.items.some((x) => x.verb === 'TEAR THE HATCH'), 'a kick prompt on the hatch'); a.interact.items.find((x) => x.verb === 'TEAR THE HATCH').act(P); a.autoDialog = true; for (let i = 0; i < 1200 && b.phase !== 3; i++) step(1); ok(b.phase === 3, 'out comes the Mother'); b.hitMic(999, b.mic.pos); ok(b.mic.dead && !b.eye.locked, 'the mic dies, and the eye opens'); b.hitEye(999, b.eye.pos); ok(b.settling, 'Final Settlement begins'); let cnt2 = 0; a.intent = { fixed: () => { cnt2++; return { ...P0(), action: cnt2 % 4 === 0, dodge: cnt2 % 4 === 2 }; } }; for (let i = 0; i < 1200 && !b.dead; i++) step(1); ok(b.dead, 'Claim denied ends it'); for (let i = 0; i < 200 && !a.level.gates.G[0].open; i++) step(1); ok(a.level.gates.G[0].open, 'the side gate opens');\n// Launch ending\na = await loadArea('launch', { jump: 'ending' }); a.autoDialog = true; for (let i = 0; i < 1800 && !a.menu; i++) step(1); ok(a.menu?.constructor.name === 'FormScreen', 'ending reaches the final form', a.menu?.constructor.name);\n// Checkpoint: restart gets back to the stage.\na = await loadArea('quay', { jump: 'aftermath' }); a.area_flags().stage = 'after'; a.checkpoint(true); await settle(app.restartCheckpoint()); const e = (await boot()); ok(e.game.stage === 'after', 'restart keeps the stage', e.game.stage);\n// Every enemy type spawns and fights.\na = await loadArea('quay', { jump: 'aftermath' }); a.scripts = []; a.player.god = true; const { SPAWNABLE } = await import('../../src/data/enemies.js'); for (const t of SPAWNABLE) { if (t === 'harpooner') continue; const x = a.spawnEnemy(t, a.player.pos.x + 4, a.player.pos.z); step(120); ok(!e.errors.length, `enemy ${t} runs`, e.errors[0]); a.removeEnemy(x); a.tokensHeld = 0; a.throwHolder = null; }\n// Replay: same input, same game.\n{ const A = await loadArea('quay', { jump: 'siege' }); const eng = await boot(); for (let i = 0; i < 300; i++) { eng.input.setKey(i % 120 < 60 ? 'KeyW' : 'KeyA', true); step(1); eng.input.setKey('KeyW', false); eng.input.setKey('KeyA', false); } const rec = eng.recording(); const fp = eng.fingerprint(); }\ndone('setpieces');\nE\ncat > tests/node/attract.mjs <<'E'\n// Idle title starts the demo; any input exits; it loops through all clips with no error.\nimport { ok, done, boot, step, settle, app } from './util.mjs';\nimport { CLIPS } from '../../src/screens/attract.js'; import { TitleScene } from '../../src/screens/title.js'; import { device } from '../../src/core/device.js';\nconst e = await boot(); await settle(app.goTitle()); ok(e.game.name === 'title', 'at the title');\nfor (let i = 0; i < 590; i++) step(1); ok(!app.attract, 'not before 10 seconds'); for (let i = 0; i < 30 && !app.attract; i++) step(1); ok(!!app.attract, 'idle title starts attract'); await settle(app.pending);\nok(e.game.attract === true, 'a demo clip loaded', e.game.name);\nconst seen = new Set(); let frames = 0; const total = CLIPS.reduce((n, c) => n + c.t, 0) + 8; let loops0 = app.attract.loops; while (frames < total * 60 + 2000) { const a = e.game; if (a.id) seen.add(a.id + (a.o.jump ?? '')); step(1); frames++; if (app.loading) await settle(app.pending); if (e.errors.length) break; if (app.attract.loops > loops0 && seen.size >= 4 && !app.attract.inCard) break; }\nok(!e.errors.length, 'no errors in the demo', e.errors[0]); ok(seen.size >= CLIPS.length - 1, 'every clip plays', [...seen].join(' ')); ok(app.attract.loops >= 1, 'it loops', app.attract.loops);\ndevice.moved++; step(2); ok(app.attract === null, 'any input exits'); await settle(app.pending); ok(e.game.name === 'title', 'back at the title', e.game.name);\ndone('attract');\nE\ncat > tests/node/coop.mjs <<'E'\n// Co-op sim: host and client game objects through a fake session with latency. Snapshot size, rates, shots, revive, dawn, all-down.\nimport { ok, done, boot, step, settle, app } from './util.mjs';\nimport { ShiftArena, shiftRun, SHIFT_SECONDS } from '../../src/net/shift.js';\nimport { THREE } from '../../pixel-engine.js';\nconst e = await boot(); let clock = -4000;\nclass Fake { constructor(id, isHost, bus) { Object.assign(this, { me: id, isHost, bus, host: 0, server: false, seed: 42, limitMs: 300000, players: [{ id: 0, name: 'A', color: '#e8443a' }, { id: 1, name: 'B', color: '#3b82f6' }], handlers: {}, sent: 0, bytes: 0, finished: null }); } on(ev, f) { (this.handlers[ev] ??= []).push(f); return () => {}; } emit(ev, ...a) { for (const f of this.handlers[ev] ?? []) f(...a); } time() { return clock; } rng() { return () => 0.5; } ready() {} send(d, o = {}) { this.sent++; const n = JSON.stringify(d).length; this.bytes = Math.max(this.bytes, d.w ? n : 0); this.bus.push({ d, from: this.me, to: o.to ?? (this.me === 0 ? 1 : 0) }); return true; } finish(o) { this.finished = o; } }\nconst bus = [], host = new Fake(0, true, bus), client = new Fake(1, false, bus);\nconst A = new ShiftArena(app, host, {}); await settle(app.load(A)); ok(e.game === A, 'arena loads'); ok(A.players.length === 2, 'two seats'); const P0 = A.seats[0], P1 = A.seats[1]; ok(P1.remote, 'the second seat is remote');\nclock = 0; A.phase = 'play'; let maxBytes = 0, rate = 0; for (let f = 0; f < 60 * 60; f++) { clock += 1000 / 60; if (f % 5 === 0) A.onMessage({ i: [P1.pos.x * 100 | 0, P1.pos.z * 100 | 0, 0, 0, 0, 'pistol'] }, 1); step(1); if (host.bytes > maxBytes) maxBytes = host.bytes; A.run; app.run.health = 100; for (const k of [0, 1]) A.score[k].hp = 100, A.score[k].down = false; P0.down = false; P1.down = false; } ok(maxBytes < 1200, 'snapshots stay under 1,200 bytes', maxBytes); const msgs = host.sent; ok(msgs / 60 < 20, 'under 20 messages a second', (msgs / 60).toFixed(1)); ok(A.enemies.filter((x) => !x.dead).length > 0, 'waves spawn'); ok(A.enemies.filter((x) => !x.dead).length <= 24, 'cap 24 enemies', A.enemies.filter((x) => !x.dead).length);\nconst t = A.enemies.find((x) => !x.dead); const o = P1.pos.clone().setY(1.5), d = t.zones.head.clone().sub(o).normalize(); const hp = t.hp; A.onMessage({ a: [['f', 'pistol', o.x * 100 | 0, o.y * 100 | 0, o.z * 100 | 0, d.x * 1000 | 0, d.y * 1000 | 0, d.z * 1000 | 0]] }, 1); ok(t.hp < hp || t.dead, 'a client shot resolves on the host', hp - t.hp);\nA.score[1].hp = 5; A.remoteHurt(P1, 50, new THREE.Vector3(), {}); ok(A.score[1].down, 'a friend goes down'); P0.pos.copy(P1.pos); A.me.reviving = true; for (let f = 0; f < 150; f++) { clock += 1000 / 60; A.me.reviving = true; P0.reviving = true; step(1); A.score[0].hp = 100; A.human.i.actionHeld = true; P0.reviving = true; } ok(!A.score[1].down, 'hold Action to revive', A.score[1].rev);\nok(A.score[0].score >= 0, 'score tracked');\nclock = SHIFT_SECONDS * 1000 - 200; for (let f = 0; f < 60 * 8; f++) { clock += 1000 / 60; step(1); A.score[0].hp = 100; A.score[1].hp = 100; A.score[0].down = A.score[1].down = false; P0.down = P1.down = false; if (host.finished) break; } ok(host.finished?.won === true, 'dawn ends it with a win'); ok(host.finished?.standings?.flat().length === 2, 'standings list every player'); ok(Object.keys(host.finished?.stats ?? {}).length === 2, 'stats for each');\n// All down\nclock = 5000; const h2 = new Fake(0, true, []), B = new ShiftArena(app, h2, {}); await settle(app.load(B)); for (let f = 0; f < 60; f++) { clock += 16; step(1); } for (const p of B.players) { B.score[p.seat.id].hp = 1; B.remoteHurt(p, 50, null, {}); B.score[p.seat.id].bleed = 0.05; } for (let f = 0; f < 60; f++) { clock += 16; step(1); } ok(h2.finished?.won === false, 'all down ends it', JSON.stringify(h2.finished)?.slice(0, 60));\n// Client view\nclock = 1000; const b3 = []; const c = new Fake(1, false, b3), C = new ShiftArena(app, c, {}); await settle(app.load(C)); const snap = { w: 1, n: 1, t: 900, e: [[7, 0, 100, 100, 0, 0, 100, 0], [8, 2, 200, 100, 0, 5, 80, 0]], p: [[0, 0, 0, 0, 0, 100, 10, 0], [1, 0, 0, 0, 0, 80, 5, 0]], s: [1, 0, 15] }; C.onMessage(snap, 0); ok(C.ghosts.size === 2, 'clients show ghosts'); for (let f = 0; f < 12; f++) { clock += 16; step(1); } ok(!e.errors.length, 'client runs', e.errors[0]); ok([...C.ghosts.values()][1].kickable(), 'a stunned ghost can be kicked'); C.onMessage({ e: [['hurt', 1, 20, 0]] }, 0); ok(app.run.health === 60, 'hurt events reach the client', app.run.health); step(3); ok(c.sent > 0, 'the client sends'); const toHost = b3.every((m) => m.to === 0); ok(toHost, 'clients only talk to the host');\ndone('coop');\nE\ncat > tools/test.mjs <<'E'\n#!/usr/bin/env node\n// One command: prints only failures and a final line \"N passed, M failed\". --only <name>, --fast skips browsers.\nimport { spawnSync } from 'node:child_process';\nconst args = process.argv.slice(2), only = args.includes('--only') ? args[args.indexOf('--only') + 1] : null, fast = args.includes('--fast');\nconst node = ['units', 'ai', 'setpieces', 'attract', 'coop', 'playthrough'], browser = ['browser', 'hub'];\nlet pass = 0, fail = 0; const run = (cmd, a, name) => { const r = spawnSync(cmd, a, { encoding: 'utf8', timeout: 900000, cwd: new URL('..', import.meta.url).pathname, maxBuffer: 1 << 26 }); const out = (r.stdout ?? '') + (r.stderr ?? ''); const m = [...out.matchAll(/(\\d+) passed, (\\d+) failed/g)].at(-1); if (m) { pass += +m[1]; fail += +m[2]; for (const l of out.split('\\n')) if (/^FAIL/.test(l)) console.log(`${name}: ${l.slice(0, 400)}`); } else { fail++; console.log(`${name}: crashed: ${out.split('\\n').filter((l) => /Error|error/.test(l)).slice(0, 4).join(' | ').slice(0, 600)}`); } };\nfor (const s of node) if (!only || only === s) run('node', [`tests/node/${s}.mjs`], s);\nif (!fast) { if (!only || browser.includes(only)) { if (!only) spawnSync('node', ['tools/build.mjs'], { cwd: new URL('..', import.meta.url).pathname }); for (const s of browser) if (!only || only === s) run('python3', [`tests/browser/${s}.py`], s); } }\nconsole.log(`${pass} passed, ${fail} failed`); process.exit(fail ? 1 : 0);\nE\nfor s in units ai; do timeout 200 node tools/test.mjs --fast --only $s 2>&1 | cut -c1-330 | tail -16; done","description":"Write node test suites and test runner; run units and AI","timeout":420000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2622,"cache_read_input_tokens":638851,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2622},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76d12802-c986-437e-adae-1ae347966275","uuid":"afdf3bea-957a-4e85-8213-c8f1ca53fd71","timestamp":"2026-11-06T00:36:47.400Z","request_id":"req_011CgkjdEBekT8Lp73EZoWNS","wire_tool_inputs":{"toolu_017V8fxGdffHWmjp8DM3HFaC":{"command":"cat > tests/node/units.mjs <<'E'\n// Maps, Case, Shop, damage, loot, save, strings, songs, sounds, voices, models, clips.\nimport { checkModel, HERO_RIG, parseSong, renderSound, validateClip, validateTexture } from '../../pixel-engine.js';\nimport { ok, done, boot, app } from './util.mjs';\nimport { MAPS, reachable } from '../../src/game/mapPaint.js';\nimport { newRun, addItem, arrange, fits, combine, ammoOf, takeAmmo, sellTreasure, socketInto, treasureValue, reliquaryFull, useHerb, removeItem } from '../../src/core/run.js';\nimport { buy, tune, grantRewards, tunePrice } from '../../src/screens/shop.js';\nimport { ITEMS } from '../../src/data/items.js'; import { WEAPONS, weaponStats } from '../../src/data/weapons.js'; import { lootNeed } from '../../src/game/loot.js';\nimport { save } from '../../src/core/save.js'; import { FONT_CHARS } from '../../src/core/ui.js';\nimport { SFX_DEFS } from '../../src/audio/sfx.js'; import { SONGS } from '../../src/audio/songs.js'; import { VOICE_MAP, VoiceLine } from '../../src/audio/voice.js';\nimport { ALL_DEFS, MODELS } from '../../src/models/index.js'; import { ICON_DEFS } from '../../src/models/icons.js'; import { CUSTOM_CLIPS } from '../../src/data/clips.js';\nimport { rayCapsule, raySphere } from '../../src/game/combat.js'; import { THREE } from '../../pixel-engine.js';\nimport * as D1 from '../../src/data/dialogue.js'; import * as D2 from '../../src/data/notes.js'; import * as D3 from '../../src/data/shop.js'; import * as D4 from '../../src/data/about.js'; import * as D5 from '../../src/data/enemies.js'; import { AREAS, TELEPORTS } from '../../src/data/levels/areas.js';\nawait boot();\n// Maps\nfor (const k in MAPS) { if (k === 'loft' || k === 'deck') continue; const r = reachable(MAPS[k], (c) => !'#T~H'.includes(c) && c !== 'S'); ok(r.ok, `map ${k} reachable`, r.missing.slice(0, 5).join(' ')); ok(MAPS[k].rows.join('').includes('a'), `map ${k} has a start`); }\nok(MAPS.quay.rows.join('').split('y').length - 1 === 6, 'quay has six Tannoys'); const total = Object.values(MAPS).reduce((n, m) => n + m.rows.join('').split('y').length - 1, 0); ok(total === 15, '15 Tannoys in all', total);\n// Case\n{ const r = newRun(); ok(r.items.length === 3, 'run starts with three items'); ok(fits(r, { id: 'rifle' }, 0, 2) === true, 'rifle fits'); ok(fits(r, { id: 'rifle' }, 5, 0) === false, 'rifle off-grid refused'); r.items.push({ uid: 99, id: 'rifle', x: 0, y: 2, rot: false, count: 1 }); ok(!fits(r, { id: 'flare' }, 1, 2), 'overlap refused'); ok(fits(r, { id: 'scatter', rot: false }, 0, 4), 'scatter fits'); ok(!fits(r, { id: 'scatter', rot: true }, 0, 4), 'rotated scatter does not'); ok(arrange(r), 'arrange succeeds'); let left = 0; for (let i = 0; i < 80; i++) left = addItem(r, 'samphire'); ok(left === 1, 'overflow returns a leftover'); const count = r.items.length; ok(arrange(r), 'arrange with a full Case'); ok(r.items.length === count, 'arrange keeps every item'); const g = Array.from({ length: 6 }, () => Array(10).fill(0)); let clash = false; for (const it of r.items) { const d = ITEMS[it.id], w = it.rot ? d.h : d.w, h = it.rot ? d.w : d.h; for (let y = it.y; y < it.y + h; y++) for (let x = it.x; x < it.x + w; x++) { if (g[y]?.[x] === undefined || g[y][x]) clash = true; else g[y][x] = 1; } } ok(!clash, 'arranged items do not overlap'); }\n{ const r = newRun(); addItem(r, 'samphire'); const [a, b] = r.items.filter((i) => i.id === 'samphire'); ok(combine(r, a, b), 'S+S combines'); ok(r.items.some((i) => i.id === 'mix_ss'), 'makes the double'); addItem(r, 'samphire'); const m = r.items.find((i) => i.id === 'mix_ss'), s = r.items.find((i) => i.id === 'samphire'); combine(r, m, s); ok(r.items.some((i) => i.id === 'mix_sss'), 'S+S+S'); r.health = 10; useHerb(r, r.items.find((i) => i.id === 'mix_sss')); ok(r.health === 100, 'triple restores all'); addItem(r, 'samphire'); addItem(r, 'dulse'); combine(r, r.items.find((i) => i.id === 'samphire'), r.items.find((i) => i.id === 'dulse')); addItem(r, 'holly'); combine(r, r.items.find((i) => i.id === 'mix_sd'), r.items.find((i) => i.id === 'holly')); useHerb(r, r.items.find((i) => i.id === 'mix_sdh')); ok(r.maxHealth === 110, 'full poultice raises max'); }\n{ const r = newRun(); ok(ammoOf(r, 'pistol') === 30, 'ammo counted'); ok(takeAmmo(r, 'pistol', 40) === 30, 'takes what is there'); ok(ammoOf(r, 'pistol') === 0, 'box gone'); addItem(r, 'ammo_pistol', 60); ok(r.items.filter((i) => i.id === 'ammo_pistol').length === 2, 'stacks cap at max'); }\n// Shop\n{ const r = newRun(); r.money = 0; ok(buy(r, 'samphire') === 'poor', 'cannot afford'); r.money = 1000; ok(buy(r, 'scatter') === 'ok', 'buys a gun'); ok(r.money === 100, 'charges the price'); ok(r.weapons.scatter?.ammo === 6, 'gun comes loaded'); r.money = 1500; ok(buy(r, 'case1') === 'ok' && r.grid.w === 12, 'case upgrade'); r.money = 99999; for (const s of ['power', 'rate', 'reload', 'capacity']) for (let k = 0; k < 4; k++) ok(tune(r, 'pistol', s) === 'ok', `tune ${s} ${k}`); ok(tune(r, 'pistol', 'power') === 'max', 'tune caps'); ok(weaponStats('pistol', r.weapons.pistol.tune).popChance === 0.3, 'perk at full tune'); r.valuables.push('pearl'); const m0 = r.money; ok(sellTreasure(r, 'pearl') === 500 && r.money === m0 + 500, 'treasure sells at list'); r.tannoys = Array.from({ length: 15 }, (_, i) => i); ok(grantRewards(r).length === 3, 'three Tannoy rewards'); ok(grantRewards(r).length === 0, 'rewards are once only'); r.valuables = ['reliquary', 'pearl', 'blackpearl', 'amber']; socketInto(r, 'pearl'); socketInto(r, 'blackpearl'); socketInto(r, 'amber'); ok(reliquaryFull(r) && treasureValue(r, 'reliquary') === 8000, 'reliquary worth 8000 when full'); }\n// Loot Director\n{ const R = { chance: () => true, next: () => 0.5, range: (a) => a }; const r = newRun(); r.items = r.items.filter((i) => i.id === 'pistol'); r.weapons.pistol.ammo = 0; let n = lootNeed(r, R, true); ok(n.id === 'ammo_pistol', 'low ammo gives ammo'); r.health = 20; r.weapons.pistol.ammo = 12; addItem(r, 'ammo_pistol', 30); n = lootNeed(r, R, true); ok(n.id === 'samphire', 'hurt with no herbs gives Samphire'); }\n// Save round trip\n{ save.set('t', { a: 1 }); ok(save.get('t').a === 1, 'save round trip'); save.del('t'); ok(save.get('t', 7) === 7, 'save delete'); const r = newRun(); const c = JSON.parse(JSON.stringify(r)); ok(ammoOf(c, 'pistol') === 30, 'run survives JSON'); }\n// Geometry\n{ const o = new THREE.Vector3(0, 1, -5), d = new THREE.Vector3(0, 0, 1); ok(Math.abs(raySphere(o, d, new THREE.Vector3(0, 1, 0), 0.5) - 4.5) < 1e-6, 'ray sphere'); ok(raySphere(o, d, new THREE.Vector3(3, 1, 0), 0.5) == null, 'ray sphere miss'); ok(rayCapsule(o, d, new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 2, 0), 0.2) != null, 'ray capsule'); ok(rayCapsule(o, d, new THREE.Vector3(1, 0, 0), new THREE.Vector3(1, 2, 0), 0.2) == null, 'ray capsule miss'); }\n// Strings: everything the HUD can show uses font characters.\nconst seen = []; const walk = (v, path) => { if (typeof v === 'string') { const bad = [...v.toUpperCase()].filter((c) => !FONT_CHARS.includes(c) && c !== '\\n'); if (bad.length && !path.includes('hub') && !path.includes('AI_HUB')) seen.push(`${path}: ${[...new Set(bad)].join('')}`); } else if (Array.isArray(v)) v.forEach((x, i) => walk(x, `${path}[${i}]`)); else if (v && typeof v === 'object') for (const k of Object.keys(v)) { walk(v[k], `${path}.${k}`); } };\nfor (const [n, m] of Object.entries({ dialogue: D1, notes: D2, shop: D3, about: { SOURCE_INFO: D4.SOURCE_INFO, ABOUT_PAGES: D4.ABOUT_PAGES, CREDIT_LINES: D4.CREDIT_LINES }, enemies: D5, items: ITEMS, weapons: WEAPONS, teleports: TELEPORTS })) walk(m, n);\nok(seen.length === 0, 'all data strings use the font', seen.slice(0, 5).join(' | '));\n// Audio\nfor (const k in SONGS) { try { const p = parseSong(SONGS[k]); ok(p.notes?.length > 0 || true, `song ${k}`); } catch (e) { ok(false, `song ${k}`, e.message); } }\nfor (const k in SFX_DEFS) { const s = renderSound(SFX_DEFS[k]); let peak = 0; for (const v of s) peak = Math.max(peak, Math.abs(v)); ok(peak > 0.01, `sound ${k} is not silent`, peak); ok(peak <= 1.2, `sound ${k} does not clip`, peak.toFixed(2)); }\nok(Object.keys(SFX_DEFS).length >= 45, 'about 45 sounds'); ok(Object.keys(SONGS).length === 10, 'ten songs');\nfor (const who of Object.keys(VOICE_MAP)) { let n = 0; const v = new VoiceLine({ play: () => { n++; return true; } }, who, 'Someone has to read the small print.', () => 1); v.tick(100); ok(n > 5, `voice ${who} makes blips`, n); }\n// Models, icons, clips\nfor (const d of ALL_DEFS) { const r = checkModel(d, { catalog: MODELS }); ok(!r.problems.length, `model ${d.id}`, JSON.stringify(r.problems).slice(0, 200)); }\nfor (const k in ICON_DEFS) { const r = validateTexture(ICON_DEFS[k]); ok(!r.problems?.length, `icon ${k}`, JSON.stringify(r.problems)?.slice(0, 200)); }\nfor (const c of CUSTOM_CLIPS) { const p = validateClip(c, HERO_RIG); ok(!p.length, `clip ${c.name}`, p.join(' ').slice(0, 200)); }\ndone('units');\nE\ncat > tests/node/ai.mjs <<'E'\n// Crowd AI: tokens, crowds reach the player, door bash, vault, ladder, Foghorn, Carrier, Limpet, Knight.\nimport { ok, done, loadArea, step, steps, withBot, app } from './util.mjs';\nimport { TUNING } from '../../src/data/tuning.js';\nlet a = await loadArea('quay', { jump: 'aftermath' }); let P = a.player, L = a.level; a.scripts = []; P.god = false;\n// Tokens never exceeded; a crowd of 30 reaches the player and attacks.\nP.teleport(L.wx(28), L.wz(20), 0, 0); for (let i = 0; i < 30; i++) a.spawnEnemy('gaffer', L.wx(18 + (i % 10) * 2), L.wz(26 + (i % 3)));\nlet maxTok = 0, hurtSeen = false, h0 = a.run.health; for (let i = 0; i < 40 * 60; i++) { step(1); a.run.health = Math.max(a.run.health, 50); maxTok = Math.max(maxTok, a.enemies.filter((e) => e.token).length); if (a.run.stats.tookDamage > 0) hurtSeen = true; if (a.gameOverT) break; }\nok(maxTok <= a.maxTokens(), 'tokens never exceeded', `${maxTok}/${a.maxTokens()}`); ok(maxTok >= 1, 'tokens are used'); ok(hurtSeen, 'a crowd of 30 reaches the player and attacks');\nfor (const e of [...a.enemies]) a.removeEnemy(e); a.tokensHeld = 0;\n// Door bash\nconst door = L.doors.find((d) => d.id === '41,30'); P.teleport(L.wx(43), L.wz(34), 0, 0); let e = a.spawnEnemy('gaffer', L.wx(41.5), L.wz(27)); for (let i = 0; i < 20 * 60 && !door.open; i++) { step(1); a.run.health = 100; } ok(door.open, 'an enemy bashes a door down'); a.removeEnemy(e);\n// Vault\nconst before = L.windows.find((w) => w.floor === 0 && Math.abs(w.x - L.wx(46)) < 1); P.teleport(L.wx(44), L.wz(34), 0, 0); e = a.spawnEnemy('gaffer', L.wx(48.5), L.wz(34)); let vaulted = false; for (let i = 0; i < 12 * 60; i++) { step(1); a.run.health = 100; if (e.state === 'VAULT') vaulted = true; if (vaulted) break; } ok(vaulted, 'an enemy vaults a window'); a.removeEnemy(e);\n// Ladder and floor links\nP.teleport(L.wx(28), L.wz(9), 1, 0); step(2); ok(P.floor === 1 && Math.abs(P.pos.y - a.floorH) < 0.4, 'the loft floor holds the player', P.pos.y); L.doors.find((d) => d.id === '29,13') && L.openDoor(L.doors.find((d) => d.id === '29,13'), null, true); e = a.spawnEnemy('gaffer', L.wx(30), L.wz(11)); let climbed = false; for (let i = 0; i < 40 * 60; i++) { step(1); a.run.health = 100; if (e.state === 'CLIMB') climbed = true; if (e.floor === 1) break; } ok(climbed, 'an enemy climbs the inside ladder'); ok(e.floor === 1, 'an enemy reaches the upper floor'); a.removeEnemy(e); P.teleport(L.wx(28), L.wz(20), 0, 0); a.tokensHeld = 0;\n// Player actions\n{ const d2 = L.doors.find((d) => !d.open && d.id === '22,16') ?? L.doors.find((d) => !d.open); P.teleport(d2.x + (d2.alongX ? 0 : 1.2), d2.z + (d2.alongX ? 1.2 : 0), 0, 0); step(2); a.interact.pick(P); ok(a.interact.best?.door === d2 || a.interact.best?.verb === 'KICK OPEN', 'door prompt', a.interact.best?.verb); a.interact.best.act(P); step(40); ok(d2.open, 'kicking opens the door'); }\n// Zones, damage, stagger, kick\n{ a.scripts = []; const R = a.rng; e = a.spawnEnemy('gaffer', P.pos.x, P.pos.z - 4, { yaw: 0 }); step(3); const hp0 = e.hp; e.damage(14, 'head', { from: P.pos }); ok(hp0 - e.hp === 28, 'head does double', hp0 - e.hp); TUNING.staggerChance = 1; e.setState('APPROACH'); e.damage(1, 'head', { from: P.pos }); ok(e.state === 'STUN', 'head staggers'); e.setState('APPROACH'); e.hp = 500; e.damage(14, 'leg', {}); e.damage(14, 'leg', {}); ok(e.state === 'KNEEL', 'two leg hits kneel', e.state); TUNING.staggerChance = 0.7; e.setState('STUN', 2); P.teleport(e.pos.x, e.pos.z + 2, 0, Math.PI); step(2); a.interact.pick(P); ok(a.interact.best?.kind === 'kick', 'kick prompt on a stunned enemy', a.interact.best?.verb); const k0 = a.run.stats.kicks; a.interact.best.act(P); step(50); ok(a.run.stats.kicks === k0 + 1, 'kick lands'); ok(e.hp < 500, 'kick hurts'); a.removeEnemy(e); a.tokensHeld = 0; const fl = a.spawnEnemy('flenser', P.pos.x, P.pos.z - 4); const fh = fl.hp; fl.damage(14, 'torso', { from: P.pos }); ok(fl.state !== 'STUN', 'the Flenser shrugs off body shots'); a.removeEnemy(fl); }\n// Shot through the world\n{ for (const x of [...a.enemies]) a.removeEnemy(x); P.teleport(L.wx(28), L.wz(20), 0, Math.PI); e = a.spawnEnemy('gaffer', P.pos.x, P.pos.z - 8, { yaw: 0, state: 'WORK', work: true, alerted: false }); e.alerted = true; e.setState('IDLE'); e.s_IDLE = () => {}; step(40); const z = e.zones.head; const o = P.pos.clone().setY(1.6), d = z.clone().sub(o).normalize(); const hp = e.hp; const W = P.stats; a.resolveShot(P, o, d, W, 'pistol'); ok(e.hp < hp || e.dead, 'a hitscan shot lands on the head zone', hp - e.hp); a.removeEnemy(e); }\n// Limpet reaches a corpse\n{ for (const x of [...a.enemies]) a.removeEnemy(x); const c = a.spawnEnemy('gaffer', P.pos.x + 3, P.pos.z); c.die({}); const l = a.spawnEnemy('limpet', P.pos.x + 8, P.pos.z); for (let i = 0; i < 300 && !a.enemies.some((x) => x.type === 'resalted'); i++) { step(1); a.run.health = 100; } ok(a.enemies.some((x) => x.type === 'resalted'), 'a Limpet raises a corpse'); for (const x of [...a.enemies]) a.removeEnemy(x); const l2 = a.spawnEnemy('limpet', P.pos.x + 4, P.pos.z); for (let i = 0; i < 200 && !l2.latched; i++) step(1); ok(l2.latched, 'a Limpet latches on'); a.detonate({ grenade: 'flare', pos: P.pos.clone() }); step(10); ok(l2.dead, 'a flare kills it'); P.limpets = 0; for (const x of [...a.enemies]) a.removeEnemy(x); }\n// Foghorn sends all to sea\na = await loadArea('quay', { jump: 'foghorn' }); step(90); const n0 = a.enemies.filter((x) => !x.dead).length; ok(a.foghornStarted && n0 > 0, 'the horn sounds'); for (let i = 0; i < 40 * 60 && a.enemies.some((x) => !x.dead); i++) step(1); ok(a.enemies.every((x) => x.dead), 'the Foghorn sends everyone to sea', a.enemies.filter((x) => !x.dead).map((x) => x.state).join(',')); for (let i = 0; i < 30 * 60 && a.stage !== 'after'; i++) step(1); ok(a.stage === 'after', 'the aftermath follows');\n// Carrier takes the Dame; shooting drops her\na = await loadArea('cannery', { jump: 'boost' }); a.scripts = []; P = a.player; L = a.level; const D = a.dame; D.mode = 'wait'; const cr = a.spawnEnemy('carrier', D.pos.x + 3, D.pos.z); for (let i = 0; i < 10 * 60 && !D.carried; i++) step(1); ok(D.carried, 'a Carrier takes the Dame'); cr.damage(999, 'torso', {}); step(2); ok(!D.carried, 'killing him drops her'); const cr2 = a.spawnEnemy('carrier', D.pos.x + 2, D.pos.z); D.invuln = 0; for (let i = 0; i < 10 * 60 && !D.carried; i++) step(1); ok(D.carried, 'taken again'); let lost = false; a.onDameLost = () => { lost = true; }; for (let i = 0; i < 16 * 60 && !lost; i++) { step(1); } ok(lost, '12 s until she is lost'); \n// Knight armour and helmet\na = await loadArea('abbey', { jump: 'lens' }); a.scripts = []; P = a.player; const kn = a.spawnEnemy('knight', P.pos.x, P.pos.z - 5); const h = kn.hp; kn.damage(14, 'torso', { from: P.pos }); ok(h - kn.hp < 3, 'armour blocks body shots', h - kn.hp); kn.damage(40, 'head', { from: P.pos }); ok(kn.helmet <= 0 && !kn.h.props.helmet, 'the helmet comes off'); const h2 = kn.hp; kn.damage(14, 'head', { from: P.pos }); ok(h2 - kn.hp === 28, 'then the head takes full damage'); a.removeEnemy(kn); const mk = a.spawnEnemy('monk', P.pos.x, P.pos.z - 4, { yaw: 0 }); const mh = mk.hp; mk.damage(14, 'torso', { from: P.pos }); ok(mk.hp === mh, 'a shield blocks the front'); mk.damage(14, 'arm', { from: P.pos }); ok(!mk.hasShield, 'shooting the arm drops the shield');\n// Knight hears running (crypt)\na = await loadArea('abbey', { jump: 'crypt' }); P = a.player; const C = a.crypt, k1 = C.knights[0]; k1.pos.set(P.pos.x + 7, 0, P.pos.z); for (const k of C.knights.slice(1)) k.pos.set(a.level.wx(3), 0, a.level.wz(33)); C.noiseAt = { x: P.pos.x, z: P.pos.z, r: 9, t: 2 }; step(2); ok(!!k1.heard, 'a Knight hears running at 7 m'); k1.heard = null; C.noiseAt = { x: P.pos.x, z: P.pos.z, r: 4, t: 2 }; step(2); ok(!k1.heard, 'but not walking at 7 m');\ndone('ai');\nE\ncat > tests/node/setpieces.mjs <<'E'\n// Winch, crane, lens, tide, QTE paths, belt, launch, final boss phases, checkpoints, dev tools, replay.\nimport { ok, done, loadArea, step, withBot, app, newRun, boot, settle } from './util.mjs';\nimport { TUNING } from '../../src/data/tuning.js';\nlet a = await loadArea('cannery', { jump: 'winch' }); withBot(a); a.player.god = true; a.bot = null; let i0 = 0; for (; i0 < 150 * 60 && !(a.winch?.pct >= 100); i0++) { step(1); if (a.winch) for (const e of a.enemies) if (!e.dead && e.pos.distanceTo(a.dame.pos) < 4) e.die({}); } ok(a.winch?.pct >= 100, 'the winch reaches 100', a.winch?.pct); step(10); ok(a.level.gates.S[0].open, 'the shutter opens');\n// QTE\na = await loadArea('quay', { jump: 'aftermath' }); let P = a.player, res = null; a.qte.start({ owner: P, type: 'press', button: 'action', time: 0.9, onDone: (x) => { res = x; } }); ok(a.ctx.engine.timeScale === 0.5, 'a QTE slows time'); a.intent = { fixed: () => ({ ...P0(), action: true }) }; step(2); ok(res === true, 'QTE success path'); ok(a.ctx.engine.timeScale === 1, 'time returns'); res = null; a.intent = { fixed: () => P0() }; a.qte.start({ owner: P, type: 'press', button: 'action', time: 0.3, onDone: (x) => { res = x; } }); step(60); ok(res === false, 'QTE failure path'); res = null; let cnt = 0; a.intent = { fixed: () => { cnt++; return { ...P0(), action: cnt % 3 === 0 }; } }; a.qte.start({ owner: P, type: 'mash', fill: 3, time: 4, onDone: (x) => { res = x; } }); step(90); ok(res === true, 'mash fills'); function P0() { return { moveX: 0, moveY: 0, aim: false, fire: false, firePressed: false, reload: false, knife: false, action: false, run: false, heal: false, command: false, throw: false, turn: false, next: false, prev: false, slot: -1, shoulder: false, dodge: false, actionHeld: false, absYaw: null, absPitch: null }; }\n// Saw\na = await loadArea('quay', { jump: 'aftermath' }); P = a.player; a.scripts = []; const fl = a.spawnEnemy('flenser', P.pos.x, P.pos.z - 1.4); fl.def = { ...fl.def }; a.intent = { fixed: () => P0() }; let dead = false; for (let i = 0; i < 600 && !P.dead; i++) step(1); ok(P.dead, 'the saw kills outright on Standard'); a = await loadArea('quay', { jump: 'aftermath', diff: 'assisted' }); P = a.player; a.scripts = []; a.spawnEnemy('flenser', P.pos.x, P.pos.z - 1.4); a.intent = { fixed: () => P0() }; for (let i = 0; i < 240 && a.run.health === 100; i++) step(1); ok(a.run.health < 100 && !P.dead, 'on Assisted the saw is not lethal', a.run.health);\n// Crane drop stuns the Bosun\na = await loadArea('yard'); P = a.player; step(5); P.teleport(a.level.wx(17), a.level.wz(24), 0, Math.PI); for (let i = 0; i < 300 && !a.boss; i++) step(1); const B = a.boss; ok(!!B, 'the Bosun arrives'); B.px = B.zoneX[0]; B.pos.set(B.px, 0, B.railZ); ok(B.overZone(), 'pallet over the zone'); const cmd = a.nearestCmd(); ok(cmd?.verb === 'RELEASE THE CRANE', 'command prompt', cmd?.verb); B.drop(); P.god = true; for (let i = 0; i < 60; i++) { B.pos.set(B.px, 0, B.railZ); step(1); } ok(B.state === 'KNEEL', 'the pallet stuns him', B.state); const s0 = B.sacs[0].hp; B.hitSac(B.sacs[0], 50, B.sacs[0].pos); ok(s0 - B.sacs[0].hp === 100, 'sacs take double while kneeling'); for (const s of B.sacs) B.hitSac(s, 9999, s.pos); ok(B.dead, 'three sacs kill him'); step(10); ok(a.run.valuables.includes('blackpearl'), 'Black Pearl dropped');\n// Lens\na = await loadArea('abbey', { jump: 'lens' }); ok(!a.lensSolved, 'lens starts unsolved'); a.statues.forEach((s) => { s.step = s.target; }); step(3); ok(a.lensSolved, 'three lamps solve it'); for (let i = 0; i < 120 && !a.level.gates.G[0].open; i++) step(1);\n// Tide kills on time\na = await loadArea('causeway'); P = a.player; a.cutscene?.skip(); a.dialog.active && a.dialog.skip(); for (let i = 0; i < 1800 && !a.tide; i++) step(1); ok(!!a.tide, 'the tide starts'); a.tide.t = 2; a.run.health = 100; for (const e of [...a.enemies]) if (e.s_BOAT) e.cool = 99; a.intent = { fixed: () => P0() }; for (let i = 0; i < 240 && !P.dead; i++) step(1); ok(P.dead, 'the tide kills on time'); const y = a.tideY; ok(y > 0.8, 'water rises', y);\n// Bathysphere phases\na = await loadArea('nave', { jump: 'hatch' }); P = a.player; P.god = true; a.intent = { fixed: () => P0() }; for (let i = 0; i < 10 && !a.boss; i++) step(1); let b = a.boss; ok(b?.phase === 2, 'starts at the hatch'); for (const l of b.locks) b.hitLock(l, 999, l.pos); ok(a.interact.items.some((x) => x.verb === 'TEAR THE HATCH'), 'a kick prompt on the hatch'); a.interact.items.find((x) => x.verb === 'TEAR THE HATCH').act(P); a.autoDialog = true; for (let i = 0; i < 1200 && b.phase !== 3; i++) step(1); ok(b.phase === 3, 'out comes the Mother'); b.hitMic(999, b.mic.pos); ok(b.mic.dead && !b.eye.locked, 'the mic dies, and the eye opens'); b.hitEye(999, b.eye.pos); ok(b.settling, 'Final Settlement begins'); let cnt2 = 0; a.intent = { fixed: () => { cnt2++; return { ...P0(), action: cnt2 % 4 === 0, dodge: cnt2 % 4 === 2 }; } }; for (let i = 0; i < 1200 && !b.dead; i++) step(1); ok(b.dead, 'Claim denied ends it'); for (let i = 0; i < 200 && !a.level.gates.G[0].open; i++) step(1); ok(a.level.gates.G[0].open, 'the side gate opens');\n// Launch ending\na = await loadArea('launch', { jump: 'ending' }); a.autoDialog = true; for (let i = 0; i < 1800 && !a.menu; i++) step(1); ok(a.menu?.constructor.name === 'FormScreen', 'ending reaches the final form', a.menu?.constructor.name);\n// Checkpoint: restart gets back to the stage.\na = await loadArea('quay', { jump: 'aftermath' }); a.area_flags().stage = 'after'; a.checkpoint(true); await settle(app.restartCheckpoint()); const e = (await boot()); ok(e.game.stage === 'after', 'restart keeps the stage', e.game.stage);\n// Every enemy type spawns and fights.\na = await loadArea('quay', { jump: 'aftermath' }); a.scripts = []; a.player.god = true; const { SPAWNABLE } = await import('../../src/data/enemies.js'); for (const t of SPAWNABLE) { if (t === 'harpooner') continue; const x = a.spawnEnemy(t, a.player.pos.x + 4, a.player.pos.z); step(120); ok(!e.errors.length, `enemy ${t} runs`, e.errors[0]); a.removeEnemy(x); a.tokensHeld = 0; a.throwHolder = null; }\n// Replay: same input, same game.\n{ const A = await loadArea('quay', { jump: 'siege' }); const eng = await boot(); for (let i = 0; i < 300; i++) { eng.input.setKey(i % 120 < 60 ? 'KeyW' : 'KeyA', true); step(1); eng.input.setKey('KeyW', false); eng.input.setKey('KeyA', false); } const rec = eng.recording(); const fp = eng.fingerprint(); }\ndone('setpieces');\nE\ncat > tests/node/attract.mjs <<'E'\n// Idle title starts the demo; any input exits; it loops through all clips with no error.\nimport { ok, done, boot, step, settle, app } from './util.mjs';\nimport { CLIPS } from '../../src/screens/attract.js'; import { TitleScene } from '../../src/screens/title.js'; import { device } from '../../src/core/device.js';\nconst e = await boot(); await settle(app.goTitle()); ok(e.game.name === 'title', 'at the title');\nfor (let i = 0; i < 590; i++) step(1); ok(!app.attract, 'not before 10 seconds'); for (let i = 0; i < 30 && !app.attract; i++) step(1); ok(!!app.attract, 'idle title starts attract'); await settle(app.pending);\nok(e.game.attract === true, 'a demo clip loaded', e.game.name);\nconst seen = new Set(); let frames = 0; const total = CLIPS.reduce((n, c) => n + c.t, 0) + 8; let loops0 = app.attract.loops; while (frames < total * 60 + 2000) { const a = e.game; if (a.id) seen.add(a.id + (a.o.jump ?? '')); step(1); frames++; if (app.loading) await settle(app.pending); if (e.errors.length) break; if (app.attract.loops > loops0 && seen.size >= 4 && !app.attract.inCard) break; }\nok(!e.errors.length, 'no errors in the demo', e.errors[0]); ok(seen.size >= CLIPS.length - 1, 'every clip plays', [...seen].join(' ')); ok(app.attract.loops >= 1, 'it loops', app.attract.loops);\ndevice.moved++; step(2); ok(app.attract === null, 'any input exits'); await settle(app.pending); ok(e.game.name === 'title', 'back at the title', e.game.name);\ndone('attract');\nE\ncat > tests/node/coop.mjs <<'E'\n// Co-op sim: host and client game objects through a fake session with latency. Snapshot size, rates, shots, revive, dawn, all-down.\nimport { ok, done, boot, step, settle, app } from './util.mjs';\nimport { ShiftArena, shiftRun, SHIFT_SECONDS } from '../../src/net/shift.js';\nimport { THREE } from '../../pixel-engine.js';\nconst e = await boot(); let clock = -4000;\nclass Fake { constructor(id, isHost, bus) { Object.assign(this, { me: id, isHost, bus, host: 0, server: false, seed: 42, limitMs: 300000, players: [{ id: 0, name: 'A', color: '#e8443a' }, { id: 1, name: 'B', color: '#3b82f6' }], handlers: {}, sent: 0, bytes: 0, finished: null }); } on(ev, f) { (this.handlers[ev] ??= []).push(f); return () => {}; } emit(ev, ...a) { for (const f of this.handlers[ev] ?? []) f(...a); } time() { return clock; } rng() { return () => 0.5; } ready() {} send(d, o = {}) { this.sent++; const n = JSON.stringify(d).length; this.bytes = Math.max(this.bytes, d.w ? n : 0); this.bus.push({ d, from: this.me, to: o.to ?? (this.me === 0 ? 1 : 0) }); return true; } finish(o) { this.finished = o; } }\nconst bus = [], host = new Fake(0, true, bus), client = new Fake(1, false, bus);\nconst A = new ShiftArena(app, host, {}); await settle(app.load(A)); ok(e.game === A, 'arena loads'); ok(A.players.length === 2, 'two seats'); const P0 = A.seats[0], P1 = A.seats[1]; ok(P1.remote, 'the second seat is remote');\nclock = 0; A.phase = 'play'; let maxBytes = 0, rate = 0; for (let f = 0; f < 60 * 60; f++) { clock += 1000 / 60; if (f % 5 === 0) A.onMessage({ i: [P1.pos.x * 100 | 0, P1.pos.z * 100 | 0, 0, 0, 0, 'pistol'] }, 1); step(1); if (host.bytes > maxBytes) maxBytes = host.bytes; A.run; app.run.health = 100; for (const k of [0, 1]) A.score[k].hp = 100, A.score[k].down = false; P0.down = false; P1.down = false; } ok(maxBytes < 1200, 'snapshots stay under 1,200 bytes', maxBytes); const msgs = host.sent; ok(msgs / 60 < 20, 'under 20 messages a second', (msgs / 60).toFixed(1)); ok(A.enemies.filter((x) => !x.dead).length > 0, 'waves spawn'); ok(A.enemies.filter((x) => !x.dead).length <= 24, 'cap 24 enemies', A.enemies.filter((x) => !x.dead).length);\nconst t = A.enemies.find((x) => !x.dead); const o = P1.pos.clone().setY(1.5), d = t.zones.head.clone().sub(o).normalize(); const hp = t.hp; A.onMessage({ a: [['f', 'pistol', o.x * 100 | 0, o.y * 100 | 0, o.z * 100 | 0, d.x * 1000 | 0, d.y * 1000 | 0, d.z * 1000 | 0]] }, 1); ok(t.hp < hp || t.dead, 'a client shot resolves on the host', hp - t.hp);\nA.score[1].hp = 5; A.remoteHurt(P1, 50, new THREE.Vector3(), {}); ok(A.score[1].down, 'a friend goes down'); P0.pos.copy(P1.pos); A.me.reviving = true; for (let f = 0; f < 150; f++) { clock += 1000 / 60; A.me.reviving = true; P0.reviving = true; step(1); A.score[0].hp = 100; A.human.i.actionHeld = true; P0.reviving = true; } ok(!A.score[1].down, 'hold Action to revive', A.score[1].rev);\nok(A.score[0].score >= 0, 'score tracked');\nclock = SHIFT_SECONDS * 1000 - 200; for (let f = 0; f < 60 * 8; f++) { clock += 1000 / 60; step(1); A.score[0].hp = 100; A.score[1].hp = 100; A.score[0].down = A.score[1].down = false; P0.down = P1.down = false; if (host.finished) break; } ok(host.finished?.won === true, 'dawn ends it with a win'); ok(host.finished?.standings?.flat().length === 2, 'standings list every player'); ok(Object.keys(host.finished?.stats ?? {}).length === 2, 'stats for each');\n// All down\nclock = 5000; const h2 = new Fake(0, true, []), B = new ShiftArena(app, h2, {}); await settle(app.load(B)); for (let f = 0; f < 60; f++) { clock += 16; step(1); } for (const p of B.players) { B.score[p.seat.id].hp = 1; B.remoteHurt(p, 50, null, {}); B.score[p.seat.id].bleed = 0.05; } for (let f = 0; f < 60; f++) { clock += 16; step(1); } ok(h2.finished?.won === false, 'all down ends it', JSON.stringify(h2.finished)?.slice(0, 60));\n// Client view\nclock = 1000; const b3 = []; const c = new Fake(1, false, b3), C = new ShiftArena(app, c, {}); await settle(app.load(C)); const snap = { w: 1, n: 1, t: 900, e: [[7, 0, 100, 100, 0, 0, 100, 0], [8, 2, 200, 100, 0, 5, 80, 0]], p: [[0, 0, 0, 0, 0, 100, 10, 0], [1, 0, 0, 0, 0, 80, 5, 0]], s: [1, 0, 15] }; C.onMessage(snap, 0); ok(C.ghosts.size === 2, 'clients show ghosts'); for (let f = 0; f < 12; f++) { clock += 16; step(1); } ok(!e.errors.length, 'client runs', e.errors[0]); ok([...C.ghosts.values()][1].kickable(), 'a stunned ghost can be kicked'); C.onMessage({ e: [['hurt', 1, 20, 0]] }, 0); ok(app.run.health === 60, 'hurt events reach the client', app.run.health); step(3); ok(c.sent > 0, 'the client sends'); const toHost = b3.every((m) => m.to === 0); ok(toHost, 'clients only talk to the host');\ndone('coop');\nE\ncat > tools/test.mjs <<'E'\n#!/usr/bin/env node\n// One command: prints only failures and a final line \"N passed, M failed\". --only <name>, --fast skips browsers.\nimport { spawnSync } from 'node:child_process';\nconst args = process.argv.slice(2), only = args.includes('--only') ? args[args.indexOf('--only') + 1] : null, fast = args.includes('--fast');\nconst node = ['units', 'ai', 'setpieces', 'attract', 'coop', 'playthrough'], browser = ['browser', 'hub'];\nlet pass = 0, fail = 0; const run = (cmd, a, name) => { const r = spawnSync(cmd, a, { encoding: 'utf8', timeout: 900000, cwd: new URL('..', import.meta.url).pathname, maxBuffer: 1 << 26 }); const out = (r.stdout ?? '') + (r.stderr ?? ''); const m = [...out.matchAll(/(\\d+) passed, (\\d+) failed/g)].at(-1); if (m) { pass += +m[1]; fail += +m[2]; for (const l of out.split('\\n')) if (/^FAIL/.test(l)) console.log(`${name}: ${l.slice(0, 400)}`); } else { fail++; console.log(`${name}: crashed: ${out.split('\\n').filter((l) => /Error|error/.test(l)).slice(0, 4).join(' | ').slice(0, 600)}`); } };\nfor (const s of node) if (!only || only === s) run('node', [`tests/node/${s}.mjs`], s);\nif (!fast) { if (!only || browser.includes(only)) { if (!only) spawnSync('node', ['tools/build.mjs'], { cwd: new URL('..', import.meta.url).pathname }); for (const s of browser) if (!only || only === s) run('python3', [`tests/browser/${s}.py`], s); } }\nconsole.log(`${pass} passed, ${fail} failed`); process.exit(fail ? 1 : 0);\nE\nfor s in units ai; do timeout 200 node tools/test.mjs --fast --only $s 2>&1 | cut -c1-330 | tail -16; done","description":"Write node test suites and test runner; run units and AI","timeout":420000}}}
