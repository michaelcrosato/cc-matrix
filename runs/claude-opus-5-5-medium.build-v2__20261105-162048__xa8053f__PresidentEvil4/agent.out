{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgkfrex5Lci92oRLxyXwn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RLm6izd2NYg45RFTfcg9bF","name":"Bash","input":{"command":"cat > src/game/director.js <<'E'\n// Beats are a small step language. A new chapter is a new data file: see docs/CONTENT.md.\n// Steps: {wait}, {until}, {run}, {zone}, {scene,shots}, {lines}, {say}, {objective}, {music}, {flag}, {spawn}, {wave}, {waitWave}, {openGate}, {hint}, {radio}, {checkpoint}, {cover}.\nimport { PYM_HINTS, PYM_OPEN, SCENES } from '../data/dialogue.js';\nexport class Script {\n  constructor(area, steps, o = {}) { this.area = area; this.steps = steps; this.i = 0; this.t = 0; this.id = o.id; this.done = false; this.started = false; this.onDone = o.onDone; }\n  fixed(dt) {\n    const A = this.area;\n    for (let guard = 0; guard < 40 && !this.done; guard++) {\n      const s = this.steps[this.i]; if (!s) { this.done = true; if (this.id) A.markBeat(this.id); this.onDone?.(); return; }\n      if (!this.started) { this.started = true; this.t = 0; this.begin(s); }\n      this.t += guard === 0 ? dt : 0;\n      if (!this.ready(s)) return;\n      this.i++; this.started = false;\n    }\n  }\n  begin(s) {\n    const A = this.area;\n    if (s.run) s.run(A);\n    if (s.objective !== undefined) A.setObjective(s.objective);\n    if (s.music !== undefined) A.app.mix.play(s.music);\n    if (s.flag) A.run.flags[s.flag] = true;\n    if (s.openGate) A.openGateNamed(s.openGate);\n    if (s.hint) A.showHint(s.hint);\n    if (s.radio) A.radio(s.radio);\n    if (s.spawn) for (const [type, col, row, o] of s.spawn) A.spawnEnemy(type, A.level.wx(col), A.level.wz(row), o);\n    if (s.wave) this.waveObj = A.startWave(s.wave);\n    if (s.scene) { A.player && (A.player.locked = true); A.playCutscene({ shots: typeof s.shots === 'function' ? s.shots(A) : s.shots, lines: SCENES[s.scene], cues: s.cues, duration: s.duration }); }\n    if (s.lines) A.sayLines(SCENES[s.lines]);\n    if (s.say) A.say(s.say[0], s.say[1], s.say[2]);\n    if (s.checkpoint) A.checkpoint();\n    if (s.cover) A.fadeOut = s.cover;\n  }\n  ready(s) {\n    const A = this.area;\n    if (s.wait != null && this.t < s.wait) return false;\n    if (s.until && !s.until(A)) return false;\n    if (s.zone) { const P = A.player, [x0, y0, x1, y1] = s.zone, c = A.level.col(P.pos.x), r = A.level.row(P.pos.z); if (P.floor || c < x0 || c > x1 || r < y0 || r > y1) return false; }\n    if (s.scene) { if (A.cutscene && !A.cutscene.finished) return false; A.endCutscene(); if (A.player) A.player.locked = false; }\n    if (s.lines && s.block && A.subsBusy()) return false;\n    if (s.waitWave && !(this.waveObj?.finished)) return false;\n    return true;\n  }\n}\n/** Spawns a list through doors, respecting maxActive. */\nexport class Wave {\n  constructor(area, o) { this.area = area; this.o = o; this.queue = []; for (const [type, n, extra] of o.groups) for (let k = 0; k < n; k++) this.queue.push({ type, extra }); if (o.shuffle !== false) area.rng.shuffle(this.queue); this.every = o.every ?? 1.2; this.t = o.delay ?? 0; this.alive = 0; this.spawned = []; }\n  get finished() { return !this.queue.length && this.spawned.every((e) => e.dead) && !this.stopped || this.stopped; }\n  fixed(dt) {\n    if (this.stopped || !this.queue.length) return; this.t -= dt * (1 + (this.area.rank() - 2) * 0.08); if (this.t > 0) return;\n    const A = this.area, cap = this.o.maxActive ?? A.maxActiveNow(); if (A.enemies.filter((e) => !e.dead).length >= cap) { this.t = 0.4; return; }\n    const q = this.queue.shift(); const doors = this.o.doors ?? '12345'; const spot = this.o.at ? A.rng.pick(this.o.at) : this.pickDoor(doors); if (!spot) return;\n    const e = A.spawnEnemy(q.type, spot.x + A.rng.range(-0.3, 0.3), spot.z + A.rng.range(-0.3, 0.3), { ...(this.o.spawnOpt || {}), ...(q.extra || {}) }); this.spawned.push(e); this.t = this.every;\n  }\n  pickDoor(doors) { const A = this.area, P = A.player; const list = doors.split('').map((d) => A.level.spawns[d]).filter(Boolean); if (!list.length) return null; const far = list.filter((s) => !P || Math.hypot(s.x - P.pos.x, s.z - P.pos.z) > 7); return A.rng.pick(far.length ? far : list); }\n  stop() { this.stopped = true; this.queue = []; }\n}\nexport const pymLine = (key) => [{ who: 'PYM', text: PYM_OPEN }, { who: 'PYM', text: PYM_HINTS[key] ?? PYM_HINTS.general }];\nE\ncat > src/game/hud.js <<'E'\n// Sparse. Gone during cutscenes. Never dense. Bottom left coverage, bottom right ammo, one prompt.\nimport { THREE } from '../../pixel-engine.js';\nimport { WEAPONS } from '../data/weapons.js';\nimport { ITEMS } from '../data/items.js';\nimport { ammoOf, statsOf, count } from '../core/run.js';\nimport { codeFor, glyphWidth } from '../core/ui.js';\nimport { iconFor } from '../models/icons.js';\nconst p3 = new THREE.Vector3();\nexport function project(cam, W, H, v) { p3.copy(v).project(cam); return [(p3.x + 1) / 2 * W, (1 - p3.y) / 2 * H, p3.z]; }\nexport function drawHud(A, ui) {\n  const P = A.player, run = A.run, W = ui.W, H = ui.H; if (!P) return;\n  const cinematic = A.cutscene || (P.locked && A.dialog.active);\n  if (A.hideHud || cinematic) return;\n  // Coverage\n  const k = run.health / run.maxHealth, low = k < 0.25, x = 8; let y = H - 22;\n  ui.text(x, y - 10, low && Math.floor(ui.t * 3) % 2 ? 'LAPSED' : 'COVERAGE', { color: low ? 'red' : 'mist' });\n  ui.bar(x, y, 92, 6, k, low ? 'red' : k < 0.5 ? 'orange' : 'lime');\n  if (A.dame?.active) { const dk = A.dame.hp / A.dame.maxHp; ui.text(x, y + 8, 'DAME', { color: A.dame.carried ? 'red' : 'mist' }); ui.bar(x + 30, y + 9, 62, 4, dk, dk < 0.3 ? 'red' : 'sand'); }\n  // Ammo\n  const id = run.weapon, st = run.weapons[id], S = statsOf(run, id); const am = A.infiniteAmmo ? '--' : `${st.ammo}/${ammoOf(run, id)}`; const m = ui.measure(am, 2);\n  ui.text(W - 8 - m.width, H - 22, am, { scale: 2, color: st.ammo === 0 ? 'red' : 'white' });\n  const ic = iconFor(id); ui.hud.sprite(W - 12 - m.width - ic.w, H - 24, ic.rows, ic.colors);\n  const gren = run.items.filter((i) => ITEMS[i.id].kind === 'grenade').length; if (gren) ui.text(W - 8 - 42, H - 34, `GRENADES ${gren}`.slice(0, 11), { color: 'sand' });\n  if (P.reloadT > 0) { ui.text(W / 2 - 24, H - 58, 'RELOADING', { color: 'sand' }); ui.bar(W / 2 - 24, H - 49, 54, 2, 1 - P.reloadT / P.reloadMax, 'sand'); }\n  // Money\n  if (A.moneyShow > 0) { const t = `${run.money} D`; const mm = ui.measure(t); ui.text(W - 8 - mm.width, 8, t, { color: 'sand' }); }\n  // Objective\n  if (A.objT > 0 && A.objective) ui.text(8, 8, A.objective, { color: 'sand' });\n  // Prompt\n  const best = A.interact.best;\n  if (best && !P.action && !A.qte.active && !P.aiming) drawPrompt(ui, 'action', best.verb ?? best.label);\n  else if (best?.enemy && !A.qte.active && !P.action) drawPrompt(ui, 'action', best.verb);\n  else if (A.cmdPrompt && !P.action && !A.qte.active) drawPrompt(ui, 'command', A.cmdPrompt, H - 62);\n  // Laser dot\n  if (P.dotOn && !P.stats.scope) {\n    const [dx, dy, dz] = project(A.ctx.camera.camera, W, H, P.dot); if (dz < 1) { const c = P.dotZone === 'head' ? 'lime' : P.dotZone === 'leg' ? 'sand' : 'red'; ui.rect(dx - 1, dy - 1, 3, 3, c); ui.rect(dx, dy, 1, 1, 'white'); }\n  }\n  if (P.dotOn && P.stats.scope) drawScope(ui);\n  // Low health\n  if (low) { const a = Math.floor(ui.t * 2.4) % 2; if (a) { ui.rect(0, 0, W, 2, 'red'); ui.rect(0, H - 2, W, 2, 'red'); ui.rect(0, 0, 2, H, 'red'); ui.rect(W - 2, 0, 2, H, 'red'); } }\n  // Damage direction\n  if (P.hitDirT > 0) { const d = P.hitDir - P.camYaw, sx = Math.sin(-d), cy = Math.cos(d); const hx = W / 2 + sx * (W / 2 - 20), hy = H / 2 - cy * (H / 2 - 20); for (let i = -2; i <= 2; i++) ui.rect(hx + i * 6 * cy, hy + i * 6 * sx, 6, 3, 'red'); }\n  // Dame taken\n  if (A.dame?.carried) { ui.center(24, `DAME TAKEN ${Math.ceil(A.dame.lostT)}`, { color: 'red', scale: 2 }); }\n  if (P.limpets > 0 && Math.floor(ui.t * 4) % 2) ui.center(44, 'LIMPET ON YOU', { color: 'lime' });\n  // Pointer\n  if (A.needClick && !A.attract) ui.center(H / 2 + 24, 'CLICK TO AIM', { color: 'sand' });\n  A.extraHud?.(ui);\n}\nfunction drawScope(ui) { const W = ui.W, H = ui.H, r = H / 2 - 20, cx = W / 2, cy = H / 2; for (let y = 0; y < H; y += 2) { const dy = y - cy, half = Math.abs(dy) < r ? Math.sqrt(r * r - dy * dy) : 0; if (half === 0) { ui.rect(0, y, W, 2, 'ink'); continue; } ui.rect(0, y, cx - half, 2, 'ink'); ui.rect(cx + half, y, W - cx - half, 2, 'ink'); } ui.rect(cx - 40, cy, 80, 1, 'ink'); ui.rect(cx, cy - 40, 1, 80, 'ink'); ui.rect(cx - 1, cy - 1, 3, 3, 'red'); }\nexport function drawPrompt(ui, action, verb, y = ui.H - 44) { const code = codeFor(action), gw = glyphWidth(code), m = ui.measure(verb); const tot = gw + 4 + m.width, x = Math.round(ui.W / 2 - tot / 2); ui.rect(x - 4, y - 2, tot + 8, 15, 'ink'); ui.glyph(code, x, y); ui.text(x + gw + 4, y + 2, verb, { color: 'white' }); }\nexport function drawQte(A, ui) {\n  const q = A.qte; if (!q.active) return; const o = q.opt, cx = ui.W / 2, cy = ui.H / 2 - 16, k = Math.max(0, q.t / q.max), r = 10 + Math.round(16 * k);\n  for (let i = 0; i < 28; i++) { const a = (i / 28) * Math.PI * 2; ui.rect(cx + Math.cos(a) * r - 1, cy + Math.sin(a) * r - 1, 2, 2, k < 0.33 ? 'red' : 'white'); }\n  const act = o.type === 'alternate' ? (q.want === 0 ? 'action' : 'dodge') : (o.button === 'dodge' ? 'dodge' : 'action'); const code = codeFor(act), gw = glyphWidth(code); ui.glyph(code, Math.round(cx - gw / 2), cy - 5);\n  ui.center(cy + r + 6, o.label ?? (o.type === 'mash' ? 'MASH' : 'NOW'), { color: 'sand' });\n  if (o.type !== 'press') ui.bar(cx - 30, cy + r + 16, 60, 3, q.fill / (o.fill ?? 8), 'sand');\n}\nexport function drawSubs(A, ui) {\n  let y = 22; for (const s of A.subs) { const lines = ui.wrap(s.text.slice(0, Math.floor(s.n)), Math.min(ui.W - 40, 360)); for (const l of lines) { const m = ui.measure(l); ui.rect(ui.W / 2 - m.width / 2 - 2, y - 1, m.width + 4, 9, 'ink'); ui.text(ui.W / 2 - m.width / 2, y, l, { color: s.color }); y += 9; } y += 2; }\n  for (const b of A.barks) { const m = ui.measure(b.text); if (b.screen) ui.text(b.screen[0] - m.width / 2, b.screen[1], b.text, { color: b.color ?? 'orange' }); }\n  if (A.hintText && A.hintT > 0) { const m = ui.measure(A.hintText); const x = ui.W / 2 - m.width / 2; ui.rect(x - 5, ui.H - 76, m.width + 10, 13, 'navy'); ui.text(x, ui.H - 73, A.hintText, { color: 'white' }); }\n}\nE\ncat > src/game/area.js <<'E'\n// One level: all the systems meet here. Each area is one Game loaded with engine.loadGame.\nimport { PALETTE, spatialize, THREE, toonMaterial, setLookLayer, glowMaterial } from '../../pixel-engine.js';\nimport { AREAS, TANNOY_INDEX } from '../data/levels/areas.js';\nimport { TUNING } from '../data/tuning.js';\nimport { GRENADES, WEAPONS } from '../data/weapons.js';\nimport { ITEMS } from '../data/items.js';\nimport { BARKS, CHAPTERS, COLORS, SCENES, TANNOY_LINES, HINTS } from '../data/dialogue.js';\nimport { addItem, ammoOf, diff, statsOf } from '../core/run.js';\nimport { BIND, HumanIntent, BotIntent } from '../core/intent.js';\nimport { device, pollPads, rumble } from '../core/device.js';\nimport { registerSfx } from '../audio/sfx.js';\nimport { registerVoices, VoiceLine, bark } from '../audio/voice.js';\nimport { Level } from './levelBuild.js';\nimport { addBackdrops, addWater, applyMood } from './world.js';\nimport { FX, registerParticles } from './fx.js';\nimport { Player, CAM } from './player.js';\nimport { Enemy } from './enemy.js';\nimport { Dame } from './companion.js';\nimport { Interact } from './interact.js';\nimport { QTE } from './qte.js';\nimport { Cutscene, Dialog } from './cutscene.js';\nimport { Script, Wave, pymLine } from './director.js';\nimport { castShot, raySphere, pointAt } from './combat.js';\nimport { lootNeed } from './loot.js';\nimport { drawHud, drawQte, drawSubs, project } from './hud.js';\nimport { buildProp } from './actor.js';\nimport { openCase, openMapTab } from '../screens/case.js';\nimport { openShop } from '../screens/shop.js';\nimport { PauseMenu } from '../screens/pause.js';\nimport { DeniedScreen } from '../screens/denied.js';\nimport { FormScreen } from '../screens/form.js';\nconst dir = new THREE.Vector3(), right = new THREE.Vector3(), pos = new THREE.Vector3(), tmp = new THREE.Vector3(), look = new THREE.Vector3();\nexport class Area {\n  constructor(app, id, o = {}) {\n    this.app = app; this.id = id; this.o = o; this.name = `area-${id}`; this.def = AREAS[id]; this.attract = !!o.attract; this.floorH = 3.2; this.silent = false;\n    this.enemies = []; this.players = []; this.shootables = []; this.waters = []; this.ragdolls = []; this.corpses = []; this.drops = []; this.projectiles = []; this.fires = []; this.scripts = []; this.waves = []; this.subs = []; this.barks = []; this.tokensHeld = 0; this.throwHolder = null; this.moneyShow = 0; this.objT = 0; this.objective = ''; this.hintT = 0; this.quietBarks = 0; this.barkCD = 0; this.barkMaxT = 0; this.menu = null; this.cutscene = null; this.commandSpots = []; this.tannoys = []; this.fathoms = []; this.statues = []; this.time = 0; this.deathT = 0; this.calm = false; this.fadeOut = null; this.runStart = 0; this.dropN = 0;\n  }\n  get run() { return this.app.run; }\n  async setup(ctx) {\n    this.ctx = ctx; this.rng = ctx.random.fork('gameplay'); this.cosmetic = ctx.random.fork('cosmetic'); this.headless = !ctx.engine.gpu; this.app.area = this;\n    registerSfx(ctx.audio); registerVoices(ctx.audio); registerParticles(ctx);\n    const def = this.def; this.fx = new FX(ctx); this.interact = new Interact(this); this.qte = new QTE(this); this.dialog = new Dialog(this); this.level = new Level(this, def);\n    applyMood(this, def.mood); this.level.build();\n    if (def.water !== false) addWater(this, Math.max(this.level.W + 140, 200), Math.max(this.level.H + 140, 200), def.waterY ?? -0.35, def.waterOpt ?? {});\n    if (def.backdrops) addBackdrops(this, def.backdrops);\n    this.setupMarkers();\n    const a = this.level.markers.a[0] ?? { x: 0, z: 0 }; const ent = this.o.at; const sx = ent ? ent[0] : a.x, sz = ent ? ent[1] : a.z;\n    this.player = new Player(this, sx, sz, { yaw: this.o.yaw ?? def.startYaw ?? Math.PI, floor: this.o.floor ?? 0 }); this.players = [this.player]; this.player.camYaw = this.player.yaw; this.setupCamera();\n    this.human = new HumanIntent(); this.intent = this.attract || this.o.bot ? new BotIntent() : this.human;\n    this.restoreFlags();\n    def.setup?.(this);\n    if (def.dame && (this.run.flags.dameFree || def.dame === 'always')) this.spawnDame();\n    if (def.music !== undefined && !this.o.noMusic) this.app.mix.play(def.music);\n    for (const l of def.loops ?? []) { const v = ctx.audio.loop(l, { volume: { rain: 0.8, sea: 0.5, conveyor: 0.6 }[l] ?? 0.5 }); v.set({ volume: this.app.settings.sfx }); }\n    this.gullT = 3;\n    if (!this.o.fromSave && !this.attract) this.checkpoint();\n    if (this.o.jump) def.jumps?.[this.o.jump]?.(this);\n    else if (!this.attract || this.o.runBeats) this.startBeats();\n    if (this.attract && this.o.attractStart) this.o.attractStart(this);\n    this.chapterCard = (!this.o.fromSave && !this.attract && def.chapterCard) ? { text: CHAPTERS[def.chapterCard], t: 3.6 } : null;\n  }\n  ready(ctx) { if (typeof window !== 'undefined') window.__GAME__ = this; ctx.input.preventKeys.add('Tab'); }\n  // ----- camera\n  setupCamera() {\n    const rig = this.ctx.camera, A = this; rig.zoomable = false; rig.focus; const c = this.player.cam;\n    rig.step = (u) => {\n      const P = A.player; if (!P) return;\n      if (A.cutscene || A.camOverride) { const s = A.camOverride ? A.camOverride() : A.cutscene.camera(); if (s) { rig.camera.position.set(...s.position); rig.camera.lookAt(...s.target); rig.focus.set(...s.target); if (rig.camera.fov !== s.fov) { rig.camera.fov = s.fov; rig.camera.updateProjectionMatrix(); } return; } }\n      const cc = P.cam, y = P.camYaw, pi = P.camPitch + P.recoil; dir.set(Math.sin(y) * Math.cos(pi), Math.sin(pi), Math.cos(y) * Math.cos(pi)); right.set(-Math.cos(y), 0, Math.sin(y));\n      pos.copy(u.target).addScaledVector(dir, -cc.dist).addScaledVector(right, cc.side * P.shoulder); pos.y += cc.up;\n      tmp.copy(pos).sub(u.target); const len = tmp.length(); tmp.normalize(); const hit = u.world.raycast?.(u.target, tmp, len); if (hit != null) pos.copy(u.target).addScaledVector(tmp, Math.max(0.4, hit - 0.2));\n      rig.focus.copy(u.target); rig.camera.position.copy(pos); (P.rigPos ??= new THREE.Vector3()).copy(pos); if (rig.camera.fov !== cc.fov) { rig.camera.fov = cc.fov; rig.camera.updateProjectionMatrix(); }\n      rig.camera.lookAt(look.copy(pos).addScaledVector(dir, 12)); P.root.visible = (pos.distanceTo(u.target) > 0.9) && !(P.aiming && P.stats?.scope);\n    };\n  }\n  cameraTarget() { const P = this.player; if (!P) return (this._t ??= new THREE.Vector3()); this._t ??= new THREE.Vector3(); return this._t.set(P.root.position.x, P.root.position.y + 1.3, P.root.position.z); }\n  // ----- markers\n  setupMarkers() {\n    const L = this.level, M = L.markers, def = this.def, ctx = this.ctx;\n    M.t.forEach((m) => this.addTelegraph(m));\n    M.m.forEach((m, i) => this.addFathom(m, i));\n    M.y.forEach((m, i) => this.addTannoy(m, (TANNOY_INDEX[this.id] ?? 0) + i));\n    M.$.forEach((m, i) => this.addChest(m, i));\n    for (const [col, row] of def.barrels ?? []) this.addBarrel(L.wx(col), L.wz(row));\n    for (const s of def.hideSpots ?? []) { const x = L.wx(s[0]), z = L.wz(s[1]); L.addSolidProp(s[2] ?? 'lobsterpot', x, z); this.commandSpots.push({ x, z, verb: 'HIDE', when: () => this.dame && !this.dame.hidden && !this.dame.carried, act: () => { this.dame.hide({ x, z }); } }); }\n    for (const [id, col, row, turn, o] of def.props ?? []) L.addSolidProp(id, L.wx(col), L.wz(row), turn ?? 0, o ?? {});\n    for (const [id, col, row, turn, o] of def.decor ?? []) L.addProp(id, L.wx(col), L.wz(row), turn ?? 0, o ?? {});\n    for (const