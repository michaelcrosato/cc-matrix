n  return CLIPS;\n}\nconst clipOf = (name, kind) => { const c = sharedClips()[name]; if (!c) throw new Error(`no clip ${name}`); if (kind === 'full') return c.full; c[kind] ??= mask(c.full, kind === 'upper' ? UPPER : LOWER, `${name}:${kind}`); return c[kind]; };\nconst FLASH = () => glowMaterial(PALETTE.white);\nexport function buildProp(id, opts = {}) { const b = buildModel(id, { catalog: MODELS, ...opts }); b.object.traverse((m) => { if (m.isMesh) m.castShadow = opts.shadow ?? true; }); return b; }\nconst v = new THREE.Vector3();\nexport class Humanoid {\n  constructor(ctx, modelId, o = {}) {\n    this.ctx = ctx; this.id = modelId; const b = buildModel(modelId, { catalog: MODELS, palette: o.palette });\n    this.root = b.object; this.scale = o.scale ?? 1; this.root.scale.setScalar(this.scale);\n    this.root.traverse((m) => { if (m.isMesh) { m.castShadow = true; } });\n    setLookLayer(this.root, 'actors'); ctx.scene.add(this.root);\n    this.mixer = new THREE.AnimationMixer(this.root); this.layered = !!o.layered; this.actions = {}; this.cur = {}; this.joints = {};\n    for (const n of HERO_RIG.joints) this.joints[n] = this.root.getObjectByName(n);\n    this.meshes = []; this.root.traverse((m) => { if (m.isMesh) this.meshes.push(m); });\n    this.flashT = 0; this.props = {}; this.popped = false;\n  }\n  _action(name, kind) { const k = `${name}:${kind}`; return (this.actions[k] ??= this.mixer.clipAction(clipOf(name, kind))); }\n  _go(layer, name, kind, o) {\n    const a = this._action(name, kind), cur = this.cur[layer];\n    if (cur === a && !o.restart) { if (o.timeScale != null) a.timeScale = o.timeScale; return a; }\n    const once = o.once ?? !sharedClips()[name].def?.loop;\n    a.reset(); a.setLoop(once ? THREE.LoopOnce : THREE.LoopRepeat, Infinity); a.clampWhenFinished = once; a.timeScale = o.timeScale ?? 1; a.enabled = true; a.play();\n    if (cur) cur.crossFadeTo(a, o.fade ?? 0.14, false);\n    this.cur[layer] = a; this.curName = name; return a;\n  }\n  /** Whole body (legs and, unless an upper override is on, the rest). */\n  play(name, o = {}) {\n    this.baseName = name;\n    if (this.layered) { this._go('lower', name, 'lower', o); if (!this.upperName) this._go('upper', name, 'upper', o); } else this._go('full', name, 'full', o);\n  }\n  setTimeScale(ts) { for (const k in this.cur) if (k !== 'upper' || !this.upperName) this.cur[k].timeScale = ts; }\n  /** Upper-body override: aim, reload, recoil. null gives the upper body back to the base clip. */\n  playUpper(name, o = {}) {\n    if (!this.layered) return;\n    if (name === this.upperName && !o.restart) return;\n    this.upperName = name;\n    this._go('upper', name || this.baseName || 'Idle', 'upper', o);\n  }\n  clipDone(layer = this.layered ? 'lower' : 'full') { const a = this.cur[layer]; return !a || !a.isRunning(); }\n  flash(frames = 2) { if (this.flashT > 0) { this.flashT = frames; return; } this.flashT = frames; for (const m of this.meshes) { m.userData.mat = m.material; m.material = FLASH(); } }\n  update(dt) {\n    this.mixer.update(dt);\n    if (this.flashT > 0 && --this.flashT <= 0) for (const m of this.meshes) if (m.userData.mat) m.material = m.userData.mat;\n    if (this.popped && this.joints.Head) this.joints.Head.scale.setScalar(0.001);\n  }\n  /** Attach a model to a joint. Weapons point along +Z: rot x=90 for a hand. */\n  attach(joint, id, o = {}) {\n    const b = buildProp(id, { shadow: true }); const p = b.object; p.position.set(...(o.at ?? [0, -0.05, 0])); p.rotation.set(...(o.rot ?? [Math.PI / 2, 0, 0]).map((x) => x)); if (o.scale) p.scale.setScalar(o.scale);\n    this.joints[joint].add(p); this.props[o.as ?? id] = p; p.traverse((m) => { if (m.isMesh) this.meshes.push(m); }); setLookLayer(p, 'actors');\n    return p;\n  }\n  detach(name) { const p = this.props[name]; if (!p) return null; p.parent?.remove(p); p.traverse((m) => { if (m.isMesh) { const i = this.meshes.indexOf(m); if (i >= 0) this.meshes.splice(i, 1); } }); delete this.props[name]; return p; }\n  jointPos(name, out = new THREE.Vector3()) { const j = this.joints[name]; j.getWorldPosition(out); return out; }\n  remove() { this.ctx.scene.remove(this.root); this.mixer.stopAllAction(); }\n}\nexport { v as tmpV };\nE\ncat > src/game/fx.js <<'E'\n// Particles, decals, impact helpers.\nimport { Decals, PALETTE, THREE } from '../../pixel-engine.js';\nexport const PARTICLE_DEFS = {\n  chunk: { count: [4, 7], life: [0.25, 0.6], speed: [1.5, 4], gravity: 9, size: [2, 1], colors: ['plum', 'teal', 'night'] },\n  salt: { count: [6, 9], life: [0.3, 0.7], speed: [1, 3], gravity: 8, size: [1, 1], colors: ['white', 'mist'] },\n  spark: { count: [4, 8], life: [0.1, 0.3], speed: [2, 6], gravity: 8, size: [1, 1], colors: ['white', 'sand', 'orange'] },\n  splinter: { count: [8, 14], life: [0.4, 0.8], speed: [2, 5], gravity: 11, size: [2, 1], colors: ['orange', 'plum'] },\n  fire: { count: [5, 9], life: [0.3, 0.8], speed: [0.6, 1.8], gravity: -3, size: [2, 1], colors: ['sand', 'orange', 'red', 'night'], radius: 0.4 },\n  blast: { count: [26, 36], life: [0.3, 0.9], speed: [3, 9], gravity: 4, drag: 2, size: [3, 1], colors: ['white', 'sand', 'orange', 'red', 'night'] },\n  splash: { count: [10, 16], life: [0.3, 0.7], speed: [1, 3.4], gravity: 9, size: [1, 1], colors: ['white', 'cyan', 'blue'], direction: [0, 1, 0], spread: 40 },\n  steam: { count: [6, 10], life: [0.5, 1.1], speed: [1, 2.4], gravity: -1.5, drag: 1, size: [3, 2], colors: ['white', 'mist', 'slate'], radius: 0.2 },\n  breath: { count: [1, 2], life: [0.4, 0.8], speed: [0.2, 0.5], gravity: -0.5, size: [2, 1], colors: ['white', 'mist'] },\n  flare: { count: [20, 30], life: [0.3, 1], speed: [2, 6], gravity: 2, size: [2, 1], colors: ['white', 'cyan', 'white', 'sky'] },\n  glass: { count: [10, 14], life: [0.3, 0.6], speed: [1.5, 4], gravity: 11, size: [1, 1], colors: ['cyan', 'white', 'sky'] },\n  brine: { count: [6, 10], life: [0.3, 0.7], speed: [1.5, 3.4], gravity: 8, size: [2, 1], colors: ['lime', 'green'] },\n  feathers: { count: [10, 14], life: [0.8, 1.6], speed: [0.8, 2], gravity: 1, size: [1, 1], colors: ['white', 'mist'] },\n};\nexport function registerParticles(ctx) { for (const k in PARTICLE_DEFS) ctx.particles.register(k, PARTICLE_DEFS[k]); }\nexport class FX {\n  constructor(ctx) { this.ctx = ctx; this.decals = new Decals(ctx.scene, { capacity: 120 }); this.up = new THREE.Vector3(0, 1, 0); }\n  shot(at) { this.ctx.lights.request({ position: at, color: 0xffc060, intensity: 8, radius: 6, lifetime: 0.06, fadeIn: 0, fadeOut: 0.04 }); }\n  impact(p, n) { this.ctx.particles.burst('impact', p); this.decals.add('scorch', p, n ?? this.up, { size: 0.28, life: 15 }); }\n  blood(p, salt) { this.ctx.particles.burst(salt ? 'salt' : 'chunk', p); this.decals.add('splat', { x: p.x, y: 0.02, z: p.z }, this.up, { size: 0.7, color: salt ? PALETTE.white : PALETTE.plum, life: 25 }); }\n  blast(p, r = 3) {\n    const c = this.ctx; c.particles.burst('blast', p, { scale: r / 3 }); c.lights.request({ position: p, color: 0xff9040, intensity: 22, radius: r * 4, lifetime: 0.3 });\n    c.engine.screen?.flash?.('white', { duration: 0.05 }); this.decals.add('scorch', { x: p.x, y: 0.02, z: p.z }, this.up, { size: r, life: 40 }); c.engine.screen?.shockwave?.(p, { radius: 0.3 });\n  }\n  update(dt) { this.decals.update(dt); }\n}\nE\ncat > src/game/world.js <<'E'\n// Moods: sky, sun, ambient, fog, rain, water, backdrops.\nimport { applySky, groundFog, PALETTE, Precipitation, skyAt, THREE, WAVES_CALM, WAVES_CHOPPY, WaterSurface } from '../../pixel-engine.js';\nimport { buildProp } from './actor.js';\nexport const MOODS = {\n  dusk: { hour: 18.6, sun: 1.0, ambient: 1.1, fog: [0x4a3a5a, 1.2, 0.55, 12, 70], bg: PALETTE.plum, gulls: true },\n  rain: { hour: 21.5, sun: 0.5, ambient: 1.0, fog: [PALETTE.night, 2.0, 0.7, 8, 46], bg: PALETTE.ink, rain: true },\n  abbey: { hour: 2, sun: 0.25, ambient: 0.8, fog: [PALETTE.ink, 0.8, 0.5, 10, 40], bg: PALETTE.ink, moon: [0.4, 0.8, 0.3] },\n  moon: { hour: 2, sun: 0.45, ambient: 0.95, fog: [PALETTE.navy, 1.2, 0.55, 14, 60], bg: PALETTE.ink, moon: [-0.5, 0.7, -0.4] },\n  indoor: { hour: 21.5, sun: 0.12, ambient: 1.05, fog: [PALETTE.ink, 0.6, 0.45, 12, 44], bg: PALETTE.ink },\n  cold: { hour: 21.5, sun: 0.1, ambient: 1.25, fog: [PALETTE.navy, 1.2, 0.5, 8, 30], bg: PALETTE.ink },\n  dawn: { hour: 6.5, sun: 1.2, ambient: 1.2, fog: [0x94b0c2, 1, 0.3, 30, 120], bg: PALETTE.sky },\n  title: { hour: 19.4, sun: 0.5, ambient: 0.9, fog: [PALETTE.night, 2, 0.75, 10, 60], bg: PALETTE.night },\n};\nexport function applyMood(area, name) {\n  const { ctx } = area, m = MOODS[name], e = ctx.engine; area.moodName = name;\n  applySky(e, skyAt(m.hour)); e.sun.intensity = m.sun; e.ambient.intensity = m.ambient; ctx.scene.background = new THREE.Color(m.bg);\n  if (m.moon) e.setSunDirection(m.moon);\n  const [color, top, amount, near, far] = m.fog;\n  area.mist = groundFog({ color, top, amount, near, far }); ctx.scene.fogNode = area.mist.node;\n  if (m.rain && !area.rain) { area.rain = new Precipitation({ kind: 'rain', count: 900, area: [36, 14, 36], color: PALETTE.slate }); area.rain.wind.set(3, 1); ctx.scene.add(area.rain); }\n}\nexport function addWater(area, w, d, y = -0.35, o = {}) {\n  const water = new WaterSurface({ size: [w, d], at: [o.x ?? 0, y, o.z ?? 0], segments: [Math.min(160, Math.ceil(w)), Math.min(160, Math.ceil(d))], waves: o.choppy ? WAVES_CHOPPY : WAVES_CALM, deep: o.deep ?? PALETTE.navy, shallow: o.shallow ?? PALETTE.blue, foam: PALETTE.mist });\n  area.ctx.scene.add(water); area.waters.push(water); return water;\n}\nexport function place(area, id, x, y, z, turn = 0, opts = {}) { const b = buildProp(id, opts); b.object.position.set(x, y, z); b.object.rotation.y = turn; area.ctx.scene.add(b.object); return b; }\n/** Far silhouettes so the world doesn't end at a plane. */\nexport function addBackdrops(area, list) { for (const [id, x, y, z, t, s] of list) { const b = place(area, id, x, y, z, t ?? 0, { shadow: false }); if (s) b.object.scale.setScalar(s); } }\nE\ncat > src/game/combat.js <<'E'\n// Ray tests against hit zones and shootables. Damage, stagger, kicks, explosions.\nimport { THREE } from '../../pixel-engine.js';\nconst a = new THREE.Vector3(), b = new THREE.Vector3(), w = new THREE.Vector3(), u = new THREE.Vector3();\n/** Distance along a unit ray to a sphere, or null. */\nexport function raySphere(o, d, c, r) {\n  const mx = o.x - c.x, my = o.y - c.y, mz = o.z - c.z, B = mx * d.x + my * d.y + mz * d.z, C = mx * mx + my * my + mz * mz - r * r;\n  if (C > 0 && B > 0) return null; const D = B * B - C; if (D < 0) return null; const t = -B - Math.sqrt(D); return t < 0 ? 0 : t;\n}\n/** Distance along a unit ray to a capsule (segment p-q, radius r), or null. Closest approach of two lines. */\nexport function rayCapsule(o, d, p, q, r) {\n  u.subVectors(q, p); w.subVectors(o, p); const A = u.dot(u), B = u.dot(d), D = u.dot(w), E = d.dot(w), den = A - B * B;\n  let s = den > 1e-6 ? (D - B * E) / den : 0; s = Math.max(0, Math.min(1, s));\n  a.copy(p).addScaledVector(u, s);\n  return raySphere(o, d, a, r);\n}\n/** Nearest zone of one enemy hit by a ray: {t, zone}. */\nexport function rayEnemy(o, d, e, assistHead = 0) {\n  const z = e.zones; if (!z) return null; let best = null;\n  const check = (t, zone) => { if (t != null && (!best || t < best.t)) best = { t, zone }; };\n  check(raySphere(o, d, z.head, z.headR + assistHead), 'head');\n  if (e.crawler) return best;\n  check(rayCapsule(o, d, z.pelvis, z.neck, z.torsoR), 'torso');\n  check(rayCapsule(o, d, z.armRa, z.armRb, z.armR), 'arm'); check(rayCapsule(o, d, z.armLa, z.armLb, z.armR), 'arm');\n  check(rayCapsule(o, d, z.legRa, z.legRb, z.legR), 'leg'); check(rayCapsule(o, d, z.legLa, z.legLb, z.legR), 'leg');\n  return best;\n}\nexport const ZONE_MULT = { head: 2, torso: 1, arm: 0.7, leg: 0.7 };\n/** Cast one shot through the world. Returns ordered hits: [{t, enemy, zone}|{t, shootable}] then wall. */\nexport function castShot(area, o, d, maxPierce = 0, range = 80, assistHead = 0, ignore = null) {\n  const hits = []; const world = area.ctx.physics.castRay(o, d, range, ['player', 'enemy', 'noBullet']); const wallT = world ? world.distance : range;\n  for (const e of area.enemies) { if (e.dead || e === ignore) continue; const r = rayEnemy(o, d, e, assistHead); if (r && r.t < wallT) hits.push({ t: r.t, enemy: e, zone: r.zone }); }\n  for (const s of area.shootables) { if (s.dead) continue; const t = raySphere(o, d, s.pos, s.r); if (t != null && t < wallT + (s.through ?? 0.4)) hits.push({ t, shootable: s }); }\n  if (area.boss?.rayParts) for (const h of area.boss.rayParts(o, d)) if (h.t < wallT) hits.push(h);\n  hits.sort((x, y) => x.t - y.t);\n  return { hits, world, wallT };\n}\nexport const pointAt = (o, d, t, out = new THREE.Vector3()) => out.copy(o).addScaledVector(d, t);\nE\ncat \"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-162048__xa8053f/tmp/claude-1000/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-162048--xa8053f-work/76d12802-c986-437e-adae-1ae347966275/tasks/br8csve2l.output\" | cut -c1-200 | tail -30","description":"Write Humanoid, particle effects, moods, combat ray tests"}}}
