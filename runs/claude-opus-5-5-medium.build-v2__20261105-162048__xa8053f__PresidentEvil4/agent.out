f (dd < 30 && 40 - dd > bs) { bs = 40 - dd; best = { aim: s.pos, shootable: s, dist: dd }; } } }\n    if (best) return best;\n    for (const e of a.enemies) { if (e.dead || e.floor !== P.floor) continue; const dist = e.pos.distanceTo(P.pos); if (dist > 22) continue; if (!a.los(P.pos, e.pos, P.floor)) continue; if (e.state === 'WORK' && dist > 10) continue; let s = -dist; if (e.type === 'carrier') s += 30; if (e.def.saw) s += 6; if (s > bs) { bs = s; best = e; } }\n    return best ? { enemy: best, aim: this.aimPoint(best), dist: best.pos.distanceTo(P.pos) } : null;\n  }\n  aimPoint(e) { const z = e.zones; if (e.crawler) return z.head; if (e.type === 'knight') return z.head; if (e.hasShield) return z.armLb ?? z.head; return z.head; }\n  bossPart() { const a = this.a, b = a.boss, P = a.player; if (b.sacs) { if (b.state !== 'KNEEL') return null; const s = b.sacs.find((x) => !x.dead); return s ? { aim: s.pos, part: true, boss: true, dist: b.pos.distanceTo(P.pos) } : null; } if (b.valves) { if (b.phase === 1) { let bv = null; for (const v of b.valves) if (!v.dead && (!bv || v.hp < bv.hp)) bv = v; return bv ? { aim: bv.pos, part: true, boss: true, dist: bv.pos.distanceTo(P.pos) } : null; } if (b.phase === 2) { const l = b.locks.find((x) => !x.dead); if (l) return { aim: l.pos, part: true, boss: true, dist: l.pos.distanceTo(P.pos) }; return null; } if (b.phase === 3) { const q = !b.mic.dead ? b.mic : b.eye; return { aim: q.pos, part: true, boss: true, dist: q.pos.distanceTo(P.pos) }; } } return null; }\n  fight(t, dt, i) {\n    const a = this.a, P = a.player, A = t.aim; const dist = t.dist; const e = t.enemy;\n    // Back off if crowded. Knife limpets. Run when surrounded.\n    const close = a.enemies.filter((x) => !x.dead && !x.crawler && x.pos.distanceTo(P.pos) < 2.2).length;\n    if (P.limpets > 0 && a.interact.best) { i.action = true; return; }\n    if (close >= 2 || (e && e.def.saw && dist < 3.5) || (a.boss && t.boss && a.boss.pos.distanceTo(P.pos) < 5 && a.boss.state 