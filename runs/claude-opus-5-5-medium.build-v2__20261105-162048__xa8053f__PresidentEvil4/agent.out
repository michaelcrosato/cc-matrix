 Torso: [4, 0, 0], ArmR: [-170, 0, 0], ForearmR: [-10, 0, 0], ArmL: [-170, 0, 0], ForearmL: [-10, 0, 0] }], [30, {}]]),\n  clip('Stagger', 14, [[0, { Torso: [-20, 0, 8], Head: [-12, 0, 0], ArmR: [-30, 0, -30], ArmL: [-30, 0, 30], LegL: [20, 0, 0] }], [14, {}]], { fast: true }),\n  clip('KnockedDown', 22, [[0, { Pelvis: { r: [-20, 0, 0], p: [0, -0.05, 0], s: 1 }, Torso: [-16, 0, 0] }], [8, { Pelvis: { r: [-80, 0, 0], p: [0, -0.42, -0.2], s: 1 }, ArmR: [-90, 0, -40], ArmL: [-90, 0, 40], LegR: [-40, 0, 0], ShinR: [30, 0, 0] }], [22, { Pelvis: { r: [-88, 0, 0], p: [0, -0.5, -0.26], s: 1 }, ArmR: [-20, 0, -60], ArmL: [-20, 0, 60], LegR: [-6, 0, 0], LegL: [-12, 0, 0], ShinL: [10, 0, 0] }]], { fast: true }),\n  clip('StampForm', 26, [[0, { ArmR: [-150, 0, 0], ForearmR: [-40, 0, 0], Torso: [-6, 0, 0] }], [12, { ArmR: [-170, 0, 0], ForearmR: [-20, 0, 0], Torso: [-10, 0, 0] }], [16, { ArmR: [-70, 0, 0], ForearmR: [-4, 0, 0], Torso: [34, 0, 0], Head: [10, 0, 0] }], [26, { ArmR: [-70, 0, 0], Torso: [20, 0, 0] }]], { fast: true }),\n  // Islanders\n  gaitClip(HERO_RIG, { name: 'Shamble', frames: 40, speed: 1.1, stance: 0.62, hip: -0.05, bob: 0.02, lift: 0.04, lean: 16, sway: 7, head: 8, arms: { swing: 8, elbow: 30 } }),\n  gaitClip(HERO_RIG, { name: 'Lurch', frames: 18, speed: 2.8, stance: 0.42, hip: -0.06, bob: 0.03, lift: 0.08, lean: 24, sway: 6, head: 2, arms: { swing: 30, elbow: 70 } }),\n  gaitClip(HERO_RIG, { name: 'DameWalk', frames: 20, speed: 2.6, stance: 0.6, hip: -0.02, bob: 0.015, lift: 0.04, lean: 3, sway: 3, head: -3, arms: { swing: 6, elbow: 8 } }),\n  gaitClip(HERO_RIG, { name: 'KnightWalk', frames: 46, speed: 0.9, stance: 0.68, hip: -0.05, bob: 0.03, lift: 0.05, lean: 8, sway: 10, head: 4, arms: { swing: 4, elbow: 22 } }),\n  gaitClip(HERO_RIG, { name: 'BosunDrag', frames: 44, speed: 1.0, stance: 0.68, hip: -0.05, bob: 0.03, lift: 0.04, lean: 20, sway: 12, head: 8, arms: { swing: 6, elbow: 18 } }),\n  gaitClip(HERO_RIG, { name: 'BathyWalk', frames: 36, speed: 1.