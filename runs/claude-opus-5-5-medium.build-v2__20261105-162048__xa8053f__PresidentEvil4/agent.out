{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgtqVFNk91ct3JNqYTK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Neqd6cEvUzun98VxsREoTH","name":"Bash","input":{"command":"cat >> src/data/levels/quay.js <<'E'\nimport { AFTER_STEPS_REF } from '../../game/setpieces.js';\nAFTER_STEPS_REF.steps = AFTER_STEPS;\nE\ncat > src/game/bosses/bosun.js <<'E'\n// The Bosun and the crane. Three brine sacs. Drop the pallet on him, then shoot his back.\nimport { RAPIER, THREE } from '../../../pixel-engine.js';\nimport { TUNING } from '../../data/tuning.js';\nimport { addItem } from '../../core/run.js';\nimport { Humanoid, buildProp } from '../actor.js';\nimport { rayCapsule, raySphere } from '../combat.js';\nconst v = new THREE.Vector3();\nconst SAC_OFF = [[-0.17, 0.46, -0.21], [0.17, 0.46, -0.21], [0, 0.2, -0.21]];\nexport class Bosun {\n  constructor(a) {\n    this.a = a; const L = a.level, S = 2.6; this.scale = S; this.h = new Humanoid(a.ctx, 'bosun', { scale: S }); this.root = this.h.root; this.h.attach('HandR', 'w-anchor', { as: 'anchor' }); this.pos = new THREE.Vector3(L.wx(17.5), 0, L.wz(6)); this.prev = this.pos.clone(); this.yaw = 0; this.state = 'ROAR'; this.t = 2; this.speed = 1.1; this.phase = 1; this.hp = 1; this.dead = false; this.sacs = [0, 1, 2].map((i) => ({ i, hp: 180, dead: false, pos: new THREE.Vector3(), obj: this.root.getObjectByName(`Sac${i}`) })); this.kneel = 0; this.hideT = 0; this.addsT = 40; this.cool = 2; this.lastLOS = 0; this.h.play('BosunRoar');\n    a.ctx.audio.play('bellow'); const P = a.ctx.physics; this.body = P.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(this.pos.x, 1.6, this.pos.z)); const c = P.world.createCollider(RAPIER.ColliderDesc.capsule(1.1, 0.75), this.body); P.tag(c, 'noCamera', 'enemy');\n    // Crane\n    const k = L.markers.k[0]; L.addSolidProp('crane-cab', k.x, k.z, 1.57); this.railZ = L.wz(18); this.x0 = L.wx(5); this.x1 = L.wx(30); this.palletDir = 1; this.px = this.x0; this.reload = 0; this.dropT = 0; this.zones = L.markers.z; this.zoneX = [L.wx(14), L.wx(23)];\n    this.pallet = buildProp('pallet'); this.pallet.object.position.set(this.px, 8, this.railZ); a.ctx.scene.add(this.pallet.object); this.palletY = 8;\n    for (const col of [13, 14, 15, 22, 23, 24]) for (const row of [17, 18, 19]) { const m = new THREE.Mesh(new THREE.BoxGeometry(0.96, 0.02, 0.96), this.yellow()); m.position.set(L.wx(col), 0.03, L.wz(row)); a.ctx.scene.add(m); }\n    a.dame.hide({ x: k.x, z: k.z }); a.dame.spot = null; a.dame.hidden = true; a.dame.mode = 'hide'; a.commandSpots.push({ x: 0, z: 0, radius: 400, verb: 'RELEASE THE CRANE', when: () => !this.dead && this.reload <= 0 && this.overZone(), act: () => this.drop() }); a.commandSpots.at(-1).any = true;\n    this.lamp = a.ctx.lights.request({ position: [this.px, 7, this.railZ], color: 0xffd040, intensity: 0, radius: 12 }); this.barT = 1; a.bossBar = this; a.extraHud = (ui) => this.hud(ui); a.nearestCmd = () => { const s = a.commandSpots.find((c) => c.radius === 400); return s && s.when() ? s : null; };\n    a.ctx.tweens.call(0.1, () => a.say('COMMODORE', 'BOSUN. DO THE THING WITH THE ANCHOR.', 2));\n  }\n  yellow() { return this.a.ctx.engine ? this._y ??= new THREE.MeshBasicNodeMaterial?.({ color: 0xdecf2c }) ?? null : null; }\n  overZone() { return this.zoneX.some((x) => Math.abs(this.px - x) < 1.6); }\n  drop() { const a = this.a; this.reload = 15; this.dropT = 0.7; a.ctx.audio.play('chain'); a.ctx.audio.play('crane'); a.say('DAME', 'Mind your head, young woman.', 1); }\n  hud(ui) { if (this.dead) return; const k = this.sacs.filter((s) => !s.dead).length; const label = this.kneel > 0 ? 'SACS EXPOSED. SHOOT!' : this.reload > 0 ? `PALLET RELOADS ${Math.ceil(this.reload)}` : this.overZone() ? 'PALLET OVER THE ZONE: COMMAND THE DAME' : 'PALLET TRAVELLING'; ui.center(8, 'THE BOSUN', { color: 'red' }); for (let i = 0; i < 3; i++) { ui.bar(ui.W / 2 - 62 + i * 42, 18, 40, 4, this.sacs[i].hp / 180, 'lime'); } ui.center(26, label, { color: this.kneel > 0 ? 'lime' : this.overZone() && this.reload <= 0 ? 'sand' : 'mist' }); }\n  fixed(dt) {\n    if (this.dead) return; const a = this.a; this.prev.copy(this.pos); this.t -= dt; this.cool -= dt; this.reload = Math.max(0, this.reload - dt);\n    if (!this.dropT) { this.px += this.palletDir * 3.2 * dt; if (this.px > this.x1) this.palletDir = -1; if (this.px < this.x0) this.palletDir = 1; }\n    if (this.dropT > 0) { this.dropT -= dt; this.palletY = 8 * Math.max(0, this.dropT / 0.7) ** 2; if (this.dropT <= 0) this.palletLand(); } else if (this.palletY < 8) { this.palletY = Math.min(8, this.palletY + dt * 0.6); }\n    this.pallet.object.position.set(this.px, this.palletY, this.railZ); this.lamp.intensity = this.overZone() && this.reload <= 0 ? 16 : 0; this.lamp.position?.set?.(this.px, 6, this.railZ);\n    const T = a.nearestPlayer(this.pos); if (!T) return; const d = Math.hypot(T.pos.x - this.pos.x, T.pos.z - this.pos.z);\n    if (this.phase >= 2) { this.addsT -= dt; if (this.addsT <= 0) { this.addsT = 40; for (let i = 0; i < 4; i++) { const s = a.level.markers.a[0]; a.spawnEnemy('gaffer', s.x + i - 2, s.z - 2); } } }\n    const fac = 1 + (3 - this.sacs.filter((s) => !s.dead).length) * 0.15;\n    switch (this.state) {\n      case 'ROAR': if (this.t <= 0) this.go('WALK'); break;\n      case 'WALK': { this.face(T.pos, 3 * dt); const ok = a.los(this.pos, T.pos, 0); this.hideT = ok ? 0 : this.hideT + dt; if (d > 2.5) this.move(T, dt, this.speed * fac); this.pickAttack(T, d); break; }\n      case 'SWEEP': this.face(T.pos, 2 * dt); if (this.t <= 0.26 && !this.hit) { this.hit = true; a.ctx.audio.play('kickwhoosh'); if (d < 7.3 && !T.dead) { if (d < 4.2) this.closeSweep(T); else T.hurt(45, this.pos, { knock: true }); } a.ctx.engine.shake.add(0.3); } if (this.t <= 0) { if (this.phase >= 3 && !this.dbl) { this.dbl = true; this.go('SWEEP', 1.1); } else { this.dbl = false; this.go('WALK'); this.cool = 2; } } break;\n      case 'THROW': this.face(T.pos, 2 * dt); if (this.t < 0.4 && !this.hit) { this.hit = true; this.throwAnchor(T); } if (this.t <= 0) { this.go('WALK'); this.cool = 2.5; } break;\n      case 'STOMP': if (this.t < 0.3 && !this.hit) { this.hit = true; a.ctx.audio.play('palletdrop'); a.ctx.engine.shake.add(0.5); a.ctx.particles.burst('dust', this.pos, { count: 20 }); if (d < 3.4) T.hurt(25, this.pos, { knock: true }); } if (this.t <= 0) { this.go('WALK'); this.cool = 1.8; } break;\n      case 'GRAB': this.face(T.pos, dt); if (this.t <= 0.3 && !this.hit) { this.hit = true; if (d < 3.4) this.grabPlayer(T); } if (this.t <= 0) { this.go('WALK'); this.cool = 3; } break;\n      case 'KNEEL': this.kneel -= dt; if (this.kneel <= 0) { this.go('ROAR', 1); a.ctx.audio.play('bellow'); } break;\n    }\n    this.body.setNextKinematicTranslation({ x: this.pos.x, y: 1.6, z: this.pos.z });\n  }\n  closeSweep(T) { const a = this.a; if (a.qte.active || T.god) return T.hurt(45, this.pos, { knock: true }); a.qte.start({ owner: T, type: 'press', button: 'dodge', label: 'DODGE', time: TUNING.qteWindow, onDone: (ok) => { if (ok) { T.invuln = 1; a.ctx.audio.play('kickwhoosh'); } else T.hurt(45, this.pos, { knock: true }); } }); }\n  grabPlayer(T) { const a = this.a; if (a.qte.active || T.god) return; T.locked = true; a.ctx.audio.play('hurtmax'); a.qte.start({ owner: T, type: 'mash', label: 'BREAK FREE', fill: 9, drain: 0.6, time: 4, mashTimeoutOk: false, onDone: (ok) => { T.locked = false; if (!ok) T.hurt(60, this.pos, { knock: true }); else T.invuln = 1; } }); }\n  pickAttack(T, d) { if (this.cool > 0) return; const R = this.a.rng; if (this.hideT > 4 || (d > 8 && d < 18 && R.chance(0.6))) { this.hideT = 0; this.go('THROW', 1.5); return; } if (d < 3 && R.chance(0.3)) { this.go('GRAB', 0.9); return; } if (d < 3.2) { this.go('STOMP', 0.9); return; } if (d < 7) { this.go('SWEEP', 1.25); return; } this.cool = 0.5; }\n  throwAnchor(T) { const a = this.a, from = this.h.jointPos('HandR'), to = T.pos.clone(); const air = 1.0, g = 14; const pr = a.addProjectile({ kind: 'anchor', model: 'w-anchor', pos: from, vel: new THREE.Vector3((to.x - from.x) / air, (to.y - from.y) / air + 0.5 * g * air, (to.z - from.z) / air), g, life: air, r: 0.01, stops: false, onLand: (p) => { a.ctx.audio.play('palletdrop', a.spatialPlay(p.pos)); a.ctx.engine.shake.add(0.5); a.ctx.particles.burst('dust', p.pos, { count: 20 }); for (const P of a.players) if (Math.hypot(P.pos.x - p.pos.x, P.pos.z - p.pos.z) < 2) P.hurt(40, p.pos, { knock: true }); } }); pr.dead = true; this.h.props.anchor.visible = false; a.ctx.tweens.call(air + 2, () => { if (this.h.props.anchor) this.h.props.anchor.visible = true; a.ctx.audio.play('chain', a.spatialPlay(this.pos, 0.6)); }); a.addTelegraphMark(to.clone().setY(0.04), air); a.ctx.audio.play('kickwhoosh'); }\n  palletLand() { const a = this.a; a.ctx.audio.play('palletdrop'); a.ctx.engine.shake.add(0.8); a.ctx.particles.burst('dust', [this.px, 0.3, this.railZ], { count: 30 }); const d = Math.hypot(this.pos.x - this.px, this.pos.z - this.railZ); if (d < 2.6) this.stagger(8); for (const e of a.enemies) if (!e.dead && Math.hypot(e.pos.x - this.px, e.pos.z - this.railZ) < 2) e.damage(200, 'torso', { explosive: true }); for (const P of a.players) if (Math.hypot(P.pos.x - this.px, P.pos.z - this.railZ) < 1.6) P.hurt(40, [this.px], { knock: true }); }\n  stagger(t) { this.kneel = t; this.go('KNEEL', t); this.a.ctx.engine.hitstop(0.1); this.a.ctx.audio.play('bellow'); this.a.say('MAX', 'Falling objects. Clause nine.', 1.5); }\n  explosion(p, r) { if (this.state !== 'KNEEL' && this.pos.distanceTo(p) < r + 2) this.stagger(4); }\n  go(s, t = 1) { this.state = s; this.t = t; this.hit = false; this.anim = null; }\n  face(p, k) { const want = Math.atan2(p.x - this.pos.x, p.z - this.pos.z); let d = want - this.yaw; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; this.yaw += d * Math.min(1, k); }\n  move(T, dt, sp) { const a = this.a, nav = a.flowNav(0, T), o = [0, 0]; if (!nav.flowDirection(this.pos.x, this.pos.z, o)) return; const nx = this.pos.x + o[0] * sp * dt, nz = this.pos.z + o[1] * sp * dt; if (a.level.enemyCanStand(nx, this.pos.z, 0)) this.pos.x = nx; if (a.level.enemyCanStand(this.pos.x, nz, 0)) this.pos.z = nz; }\n  rayParts(o, d) {\n    if (this.dead) return []; const out = [], J = this.h.joints, S = this.scale; for (const s of this.sacs) { if (s.dead) continue; const t = raySphere(o, d, s.pos, 0.34 * S * (this.kneel > 0 ? 1.4 : 1)); if (t != null) out.push({ t, part: { hit: (dmg, pt) => this.hitSac(s, dmg, pt) }, zone: 'head' }); }\n    const pelvis = J.Pelvis.getWorldPosition(new THREE.Vector3()), head = J.Head.getWorldPosition(new THREE.Vector3()); const t = rayCapsule(o, d, pelvis, head, 0.32 * S); if (t != null) out.push({ t: t + 0.02, part: { hit: (dmg, pt, wid) => this.hitBody(dmg, pt, wid) }, zone: 'torso' }); return out;\n  }\n  hitSac(s, dmg, pt) { const a = this.a, k = this.kneel > 0 ? 2 : 1; s.hp -= dmg * k; a.ctx.particles.burst('brine', pt); a.ctx.audio.play('bodyhit'); this.h.flash(); if (s.hp <= 0) { s.dead = true; if (s.obj) s.obj.visible = false; a.fx.blast(pt, 1.6); a.ctx.audio.play('headpop'); a.ctx.audio.play('bellow'); const left = this.sacs.filter((x) => !x.dead).length; this.phase = 4 - left; if (a.rain && this.phase >= 3) a.rain.intensity = 1; if (left === 0) this.die(); else this.go('ROAR', 1.2); } }\n  hitBody(dmg, pt, wid) { const a = this.a; a.ctx.particles.burst('spark', pt, { count: 3 }); a.ctx.audio.play('armorping', { volume: 0.5 }); if (wid === 'harpoon' && this.kneel > 0) this.kneel += 3; const s = this.sacs.find((x) => !x.dead); if (s) { s.hp -= dmg * 0.04; this.h.flash(1); } }\n  knifeHit(P) { if (Math.hypot(P.pos.x - this.pos.x, P.pos.z - this.pos.z) < 2.6) { const s = this.sacs.find((x) => !x.dead); if (s && this.kneel > 0) this.hitSac(s, 12, this.h.jointPos('Torso')); } }\n  die() { const a = this.a; this.dead = true; this.go('DEAD'); a.ctx.physics.remove(this.body); this.h.play('Death', { fade: 0.1 }); a.ctx.engine.hitstop(0.15); a.ctx.engine.shake.add(1); a.ctx.engine.screen?.shockwave?.(this.pos, { radius: 0.6 }); a.ctx.audio.play('palletdrop'); addItem(a.run, 'blackpearl'); a.say('MAX', 'Black Pearl. For the file.', 2); a.spawnDrop(this.pos.x, this.pos.z + 2, { money: 2000 }); for (const e of a.enemies) if (!e.dead) e.die({}); a.extraHud = null; a.nearestCmd = () => null; a.dame.unhide(); a.dame.hidden = false; a.dame.mode = 'follow'; a.dame.pos.set(a.level.markers.k[0].x + 1.2, 0, a.level.markers.k[0].z + 1.2); a.dame.prev.copy(a.dame.pos); this.lamp.release?.(); }\n  update(dt) {\n    const a = this.a, A = a.ctx.physics.alpha; this.root.position.lerpVectors(this.prev, this.pos, this.dead ? 1 : A); this.root.rotation.y = this.yaw; if (this.dead) { this.h.update(dt); return; }\n    const c = { ROAR: 'BosunRoar', WALK: 'BosunDrag', SWEEP: 'BosunSweep', THROW: 'BosunThrow', STOMP: 'BosunStomp', GRAB: 'Grapple', KNEEL: 'BosunKneel' }[this.state]; if (this.anim !== c) { this.anim = c; this.h.play(c, { restart: true, timeScale: c === 'BosunDrag' ? this.speed * 1.2 : 1 }); } this.h.update(dt);\n    this.root.updateWorldMatrix(true, true); for (const s of this.sacs) { v.set(...SAC_OFF[s.i]); s.pos.copy(v).applyMatrix4(this.h.joints.Torso.matrixWorld); }\n  }\n}\nE\nsed -i \"s/yellow() { return this.a.ctx.engine ? this._y ??= new THREE.MeshBasicNodeMaterial?.({ color: 0xdecf2c }) ?? null : null; }/yellow() { return glowMaterial(PALETTE.sand); }/; s/import { RAPIER, THREE } from '..\\/..\\/..\\/pixel-engine.js';/import { glowMaterial, PALETTE, RAPIER, THREE } from '..\\/..\\/..\\/pixel-engine.js';/\" src/game/bosses/bosun.js\ncat > src/game/bosses/bathysphere.js <<'E'\n// The walking Bathysphere of Saint Orrin, the hatch, and the Mother. Plumbing, Hatch, Mother, Final Settlement.\nimport { RAPIER, THREE } from '../../../pixel-engine.js';\nimport { TUNING } from '../../data/tuning.js';\nimport { SCENES } from '../../data/dialogue.js';\nimport { Humanoid, buildProp } from '../actor.js';\nimport { rayCapsule, raySphere } from '../combat.js';\nimport { addWater } from '../world.js';\nconst VALVES = [['ArmR', 0, 0.05, 0], ['ArmL', 0, 0.05, 0], ['LegR', 0, -0.1, 0.1], ['LegL', 0, -0.1, 0.1]];\nexport class Bathysphere {\n  constructor(a, start = 1) {\n    this.a = a; const L = a.level, S = 2.4; this.scale = S; this.h = new Humanoid(a.ctx, 'bathysphere', { scale: S }); this.root = this.h.root; this.pos = new THREE.Vector3(L.wx(14), 0, L.wz(14)); this.prev = this.pos.clone(); this.yaw = 0; this.phase = 1; this.state = 'INTRO'; this.t = 1; this.cool = 2; this.dead = false; this.speed = 1.3; this.jet = 0;\n    this.valves = VALVES.map(([j, x, y, z]) => ({ j, off: new THREE.Vector3(x, y, z), hp: 140, dead: false, pos: new THREE.Vector3() })); this.locks = [0, 1, 2].map((i) => ({ i, hp: 60, dead: false, pos: new THREE.Vector3() })); this.water = addWater(a, 400, 400, -0.12); this.waterY = -0.12; this.h.play('Idle');\n    const figure = new Humanoid(a.ctx, 'commodore', { scale: 0.34 }); figure.play('SeatedAtMic'); this.figure = figure; this.h.joints.Torso.add(figure.root); figure.root.position.set(0, 0.28, 0.18); const ch = buildProp('mic-armchair'); ch.object.scale.setScalar(0.34); ch.object.position.set(0, 0.26, 0.05); this.h.joints.Torso.add(ch.object); this.chair = ch.object;\n    const P = a.ctx.physics; this.body = P.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(this.pos.x, 1.6, this.pos.z)); P.tag(P.world.createCollider(RAPIER.ColliderDesc.capsule(0.9, 1.3), this.body), 'noCamera', 'enemy');\n    this.columns = L.rows.flatMap((r, y) => [...r].map((c, x) => (c === 'H' ? [x, y] : null))).filter(Boolean); a.extraHud = (ui) => this.hud(ui);\n    if (start === 2) { for (const v of this.valves) v.dead = true; this.enterHatch(); } if (start === 3) { this.toMother(); }\n  }\n  hud(ui) { if (this.dead) return; if (this.phase === 1) { ui.center(8, 'THE BATHYSPHERE', { color: 'orange' }); this.valves.forEach((v, i) => ui.bar(ui.W / 2 - 62 + i * 31, 18, 29, 4, v.hp / 140, v.dead ? 'night' : 'red')); } else if (this.phase === 2) { ui.center(8, 'THE HATCH', { color: 'orange' }); this.locks.forEach((v, i) => ui.bar(ui.W / 2 - 62 + i * 42, 18, 40, 4, v.hp / 60, 'sand')); if (this.locks.every((l) => l.dead)) ui.center(26, 'GET CLOSE AND KICK', { color: 'lime' }); } else { ui.center(8, 'THE MOTHER', { color: 'lime' }); ui.bar(ui.W / 2 - 60, 18, 56, 4, (this.mic?.hp ?? 0) / 200, 'sand'); ui.bar(ui.W / 2 + 4, 18, 56, 4, (this.eye?.hp ?? 0) / 400, 'orange'); } }\n  fixed(dt) {\n    if (this.dead) return; const a = this.a; this.prev.copy(this.pos); this.t -= dt; this.cool -= dt; const T = a.nearestPlayer(this.pos); if (!T) return; const d = Math.hypot(T.pos.x - this.pos.x, T.pos.z - this.pos.z);\n    if (this.water.position.y < this.waterY) this.water.position.y += dt * 0.08; else this.water.position.y = this.waterY;\n    if (this.phase === 3) return this.motherFixed(dt, T, d);\n    const L = a.level;\n    switch (this.state) {\n      case 'INTRO': if (this.t <= 0) this.go('WALK'); break;\n      case 'WALK': this.face(T.pos, 2.2 * dt); if (d > 3.5) this.walk(T, dt, this.speed); if (this.cool <= 0) { const R = a.rng; if (d < 3.6) this.go('STOMP', 0.9); else if (d < 7 && R.chance(0.5)) { this.go('JET', 1.3); a.ctx.audio.play('steam'); } else if (d > 7 && R.chance(0.45)) { this.go('CHARGEWIND', 1.1); a.ctx.audio.play('whistle'); } else this.go('RIVET', 1.1); } break;\n      case 'STOMP': if (this.t < 0.3 && !this.hit) { this.hit = true; a.ctx.audio.play('palletdrop'); a.ctx.engine.shake.add(0.5); a.ctx.particles.burst('dust', this.pos, { count: 18 }); if (d < 4.2) T.hurt(25, this.pos, { knock: true }); } if (this.t <= 0) { this.go('WALK'); this.cool = 1.5; } break;\n      case 'JET': { this.face(T.pos, 1.5 * dt); const fx = Math.sin(this.yaw), fz = Math.cos(this.yaw); a.ctx.particles.burst('steam', [this.pos.x + fx * 2, 1.4, this.pos.z + fz * 2], { count: 3, direction: [fx, 0, fz], speed: 2.4 }); if (d < 6.5 && ((T.pos.x - this.pos.x) * fx + (T.pos.z - this.pos.z) * fz) / (d || 1) > 0.75) { if (!this.hit) { this.hit = true; T.hurt(30, this.pos, {}); T.slowT = 2.5; } } if (this.t <= 0) { this.go('WALK'); this.cool = 2.2; } break; }\n      case 'RIVET': this.face(T.pos, 2 * dt); if (this.t < 0.7 && !this.r1) { this.r1 = 1; this.rivet(T); } if (this.t < 0.45 && this.r1 === 1) { this.r1 = 2; this.rivet(T); } if (this.t < 0.2 && this.r1 === 2) { this.r1 = 3; this.rivet(T); } if (this.t <= 0) { this.r1 = 0; this.go('WALK'); this.cool = 2; } break;\n      case 'CHARGEWIND': this.face(T.pos, 3 * dt); if (this.t <= 0) { this.go('CHARGE', 3); this.cdx = Math.sin(this.yaw); this.cdz = Math.cos(this.yaw); } break;\n      case 'CHARGE': { const nx = this.pos.x + this.cdx * 8 * dt, nz = this.pos.z + this.cdz * 8 * dt; const ok = L.enemyCanStand(nx, nz, 0); if (Math.hypot(T.pos.x - this.pos.x, T.pos.z - this.pos.z) < 2.2 && !this.hit) { this.hit = true; T.hurt(40, this.pos, { knock: true }); } if (!ok || this.t <= 0) { const col = L.charAt(nx, nz) === 'H'; if (col) this.shatter(nx, nz); this.go('STUNNED', col ? 3 : 1); a.ctx.audio.play('brass'); a.ctx.engine.shake.add(col ? 0.7 : 0.3); } else { this.pos.x = nx; this.pos.z = nz; a.ctx.particles.burst('dust', this.pos, { count: 1 }); } break; }\n      case 'STUNNED': if (this.t <= 0) { this.go('WALK'); this.cool = 1; } break;\n      case 'SAG': for (const lk of this.locks) if (!lk.dead) break; break;\n    }\n    this.body.setNextKinematicTranslation({ x: this.pos.x, y: 1.6, z: this.pos.z });\n  }\n  shatter(x, z) { const a = this.a, L = a.level; a.ctx.particles.burst('splinter', [x, 1, z], { colors: ['slate', 'mist'], count: 30 }); }\n  rivet(T) { const a = this.a, from = this.pos.clone().setY(2.6), to = T.pos.clone().setY(1.2), d = to.clone().sub(from).normalize().multiplyScalar(14); const p = a.addProjectile({ kind: 'rivet', model: 'w-bolt', pos: from, vel: d, g: 0, life: 1.6, r: 0.5, dmg: 12, faces: true }); a.ctx.audio.play('brass', a.spatialPlay(from, 0.5)); }\n  go(s, t = 1) { this.state = s; this.t = t; this.hit = false; this.anim = null; }\n  face(p, k) { const want = Math.atan2(p.x - this.pos.x, p.z - this.pos.z); let d = want - this.yaw; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; this.yaw += d * Math.min(1, k); }\n  walk(T, dt, sp) { const a = this.a, nav = a.flowNav(0, T), o = [0, 0]; if (!nav.flowDirection(this.pos.x, this.pos.z, o)) return; const nx = this.pos.x + o[0] * sp * dt, nz = this.pos.z + o[1] * sp * dt; if (a.level.enemyCanStand(nx, this.pos.z, 0)) this.pos.x = nx; if (a.level.enemyCanStand(this.pos.x, nz, 0)) this.pos.z = nz; }\n  rayParts(o, d) {\n    const out = []; if (this.dead) return out; if (this.phase === 1) for (const v of this.valves) { if (v.dead) continue; const t = raySphere(o, d, v.pos, 0.42); if (t != null) out.push({ t, part: { hit: (dmg, pt) => this.hitValve(v, dmg, pt) } }); }\n    if (this.phase === 2) for (const lk of this.locks) { if (lk.dead) continue; const t = raySphere(o, d, lk.pos, 0.4); if (t != null) out.push({ t, part: { hit: (dmg, pt) => this.hitLock(lk, dmg, pt) } }); }\n    if (this.phase === 3) { for (const p of [this.mic, this.eye]) { if (!p || p.dead || p.locked) continue; const t = raySphere(o, d, p.pos, p.r); if (t != null) out.push({ t, part: { hit: (dmg, pt) => p.hit(dmg, pt) } }); } const t = raySphere(o, d, this.motherC, 2.4); if (t != null) out.push({ t: t + 0.05, part: { hit: (dmg, pt) => { this.a.ctx.particles.burst('spark', pt, { count: 2 }); this.a.ctx.audio.play('armorping', { volume: 0.4 }); } } }); }\n    else { const c = this.h.joints.Torso.getWorldPosition(new THREE.Vector3()); c.y += 1.0; const t = raySphere(o, d, c, 1.25); if (t != null) out.push({ t: t + 0.02, part: { hit: (dmg, pt) => { this.a.ctx.particles.burst('spark', pt, { count: 3 }); this.a.ctx.audio.play('armorping', { volume: 0.5 }); } } }); }\n    return out;\n  }\n  hitValve(v, dmg, pt) { const a = this.a; v.hp -= dmg; a.ctx.particles.burst('steam', pt); a.ctx.audio.play('armorping'); this.h.flash(1); if (v.hp <= 0) { v.dead = true; a.fx.blast(pt, 1.4); a.ctx.audio.play('steam'); a.ctx.audio.play('brass'); this.waterY += 0.15; const L = a.level; for (let i = 0; i < 4; i++) { const m = a.rng.pick([[5, 44], [22, 44], [4, 6], [23, 6]]); a.spawnEnemy('monk', L.wx(m[0]) + i * 0.5, L.wz(m[1])); } a.say('COMMODORE', a.rng.pick(['THOSE ARE ORIGINAL FITTINGS!', 'THAT VALVE WAS BLESSED!', 'DO YOU KNOW WHAT BRASS COSTS?', 'I SHALL WRITE TO YOUR EMPLOYERS!']), 2); if (this.valves.every((x) => x.dead)) this.enterHatch(); } }\n  enterHatch() { const a = this.a; this.phase = 2; this.go('SAG', 999); this.h.play('BathySag', { fade: 0.4 }); this.anim = 'BathySag'; a.setObjective('THREE LOCKS ON THE HATCH. SHOOT THEM.'); a.ctx.audio.play('steam'); }\n  hitLock(lk, dmg, pt) { const a = this.a; lk.hp -= dmg; a.ctx.particles.burst('spark', pt); a.ctx.audio.play('brass'); if (lk.hp <= 0) { lk.dead = true; a.ctx.audio.play('kickhit'); if (this.locks.every((l) => l.dead)) { a.setObjective('KICK THE HATCH.'); this.kick = a.interact.add({ x: this.pos.x, z: this.pos.z, radius: 4, priority: 9, any: true, verb: 'TEAR THE HATCH', act: () => { a.interact.remove(this.kick); this.hatchScene(); return true; } }); } } }\n  hatchScene() {\n    const a = this.a, P = a.player, c = [this.pos.x, 2.6, this.pos.z]; P.locked = true; for (const e of [...a.enemies]) if (!e.dead) e.die({}); a.addScript([{ scene: 'hatch', duration: 7, shots: () => [{ at: 0, position: [c[0] + 3, 2.8, c[2] + 4], target: c, fov: 40 }, { at: 7, position: [c[0] + 1.2, 2.8, c[2] + 2], target: c, fov: 26 }], cues: [{ at: 1.5, run: () => { a.ctx.audio.play('brass'); a.ctx.audio.play('kickhit'); a.ctx.engine.shake.add(0.5); P.teleport(this.pos.x + 2, this.pos.z + 3); } }] }, { run: () => this.toMother() }]);\n  }\n  toMother() {\n    const a = this.a, L = a.level; this.phase