, id) => a.level.doors.find((d) => d.id === id);\nexport const CANNERY = {\n  map: 'cannery', title: 'THOLE CANNERY', mood: 'indoor', music: 'explore', loops: ['conveyor'], chapter: 2, hint: 'barrel', startYaw: Math.PI, water: false, wallH: 7, belts: { north: 1.5, south: -1.5 }, fathomYaw: Math.PI / 2, dame: true, treasure: ['tusk', 'reliquary'],\n  hideSpots: [[8, 22, 'lobsterpot'], [38, 12, 'lobsterpot'], [38, 24, 'lobsterpot'], [8, 12, 'lobsterpot']], barrels: [[8, 18], [39, 19], [19, 24]], groundItems: [['ammo_pistol', 19, 11, 12], ['samphire', 30, 11, 1], ['depth', 2, 13, 1]], notes: [{ id: 'timesheet', col: 34, row: 28, y: 0.86 }],\n  theme: { '_': 'metal-plates', '#': 'bricks', H: 'rust' },\n  decor: [['gut-table', 13, 11.5], ['gut-table', 25, 24.5], ['gut-table', 33, 24.5], ['steam-pipe', 7, 11], ['steam-pipe', 40.5, 24], ['steam-pipe', 18, 11], ['steam-pipe', 28, 24.5], ['can-press', 39.5, 13.5, 0], ['steam-pipe', 7, 24], ['crate-stack', 7.5, 25], ['barrel', 41, 25], ['telegraph-none', 0, 0], ['ice-block', 35.5, 3], ['ice-block', 36, 7], ['ice-block', 43, 7], ['ice-block', 43.5, 6], ['ice-block', 39, 3], ['hoist-chain', 12, 9.8], ['desk', 34, 28], ['chair', 34, 29], ['shelf', 38, 27], ['sack', 19, 30], ['crate', 28, 33], ['crate-stack', 28, 28]].filter((p) => p[0] !== 'telegraph-none'),\n  lamps: [['hanging-lantern', 14, 16, { y: 3.4, intensity: 14, radius: 14 }], ['hanging-lantern', 30, 16, { y: 3.4, intensity: 14, radius: 14 }], ['hanging-lantern', 24, 30, { y: 2.4, intensity: 12, radius: 12 }], ['hanging-lantern', 9, 5, { y: 3.4, intensity: 10, radius: 10 }], ['hanging-lantern', 24, 6, { y: 3.4, intensity: 12, radius: 12 }], ['wall-lantern', 2, 13, { intensity: 8, radius: 7 }], ['hanging-lantern', 40, 4, { y: 3.4, intensity: 7, radius: 9, color: 0x70c0ff }], ['hanging-lantern', 44, 17, { y: 2.4, intensity: 8, radius: 8 }]],\n  dress: { wall: ['barrel', 'crate', 'sack', 'bucket', 'fish-crate', 'can-tin'], open: ['can-tin', 'puddle'] },\n  setup(a) { coldRoomSetup(a); },\n  jumps: {\n    flenser: (a) => { a.player.teleport(a.level.wx(14), a.level.wz(16), 0, -Math.PI / 2); a.addScript(FLENSER_STEPS); },\n    cold: (a) => { addKey(a); a.player.teleport(a.level.wx(38), a.level.wz(11), 0, Math.PI); a.addScript(COLD_STEPS); },\n    boost: (a) => { a.run.flags.dameFree = true; a.spawnDame(); a.player.teleport(a.level.wx(14), a.level.wz(11), 0, -Math.PI / 2); a.dame.pos.set(a.level.wx(16), 0, a.level.wz(11)); a.addScript(BOOST_STEPS); },\n    winch: (a) => { a.run.flags.dameFree = true; a.spawnDame(); a.level.openDoor(doorOf(a, WINCH_DOOR), null, true); a.player.teleport(a.level.wx(9), a.level.wz(7), 0, 0); a.dame.pos.set(a.level.wx(8), 0, a.level.wz(5)); a.addScript(WINCH_STEPS); },\n    belt: (a) => { a.run.flags.dameFree = true; a.spawnDame(); a.player.teleport(a.level.wx(20), a.level.wz(17) , 0, Math.PI); a.addScript(BELT_STEPS); },\n  },\n  beats: [{ id: 'cannery-main', skip: (a) => { if (a.run.flags.dameFree) a.spawnDame?.(); }, steps: [\n    { objective: 'THE HALL. FIND THE INSURED.' }, { until: (a) => a.player.pos.z < a.level.wz(26) }, { music: 'combat' },\n    { wave: { groups: [['gaffer', 10], ['bottler', 2]], doors: '13', every: 1.2, maxActive: 8 } }, { say: ['COMMODORE', 'A MESSAGE FROM THE CANNERY: WE ARE HIRING.'] },\n    { until: (a) => (a.killCount ?? 0) >= 8 }, { run: (a) => a.addScript(FLENSER_STEPS) },\n  ] }],\n};\nfunction addKey(a) { if (!a.run.keys.includes('coldkey')) a.run.keys.push('coldkey'); }\nconst FLENSER_STEPS = [\n  { run: (a) => { const d = doorOf(a, SAW_DOOR); a.level.breakDoor(d, { pos: a.player.pos }); a.ctx.audio.play('doorkick'); a.ctx.engine.shake.add(0.5); a.flenser = a.spawnEnemy('flenser', a.level.wx(4), a.level.wz(16)); a.flenser.onDeath = () => {}; } }, { objective: 'YOU HEARD HIM FIRST. KILL HIM FOR THE KEY.' }, { until: (a) => a.flenser?.dead }, { run: (a) => { a.spawnDrop(a.flenser.pos.x, a.flenser.pos.z, { id: 'coldkey', count: 1 }); a.app.mix.play('explore'); a.addScript(COL