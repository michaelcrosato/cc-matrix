ns[b].value = on ? 1 : 0; }; })()'''\ndef page(b, url=html, init=None, **kw):\n    ctx = b.new_context(viewport={'width': 960, 'height': 540}, **kw); pg = ctx.new_page(); pg.errs = []\n    pg.on('console', lambda m: pg.errs.append(m.text) if m.type == 'error' else None); pg.on('pageerror', lambda e: pg.errs.append(str(e)))\n    if init: pg.add_init_script(init)\n    pg.goto(url); pg.wait_for_function('window.__APP__ && window.__PIXEL_ENGINE__', timeout=120000); pg.evaluate('async()=>{window.__e=await window.__PIXEL_READY__;}'); return pg, ctx\ndef wait_title(pg): pg.wait_for_function('window.__e.game?.name === \"title\" && !window.__APP__.loading', timeout=60000)\ndef hud_has(pg): return pg.evaluate('window.__e.hud.canvas ? true : false')\ndef want(name): return not only or name in only\nwith sync_playwright() as p:\n    b = p.chromium.launch(args=GPU)\n    if want('boot'):\n        pg, ctx = page(b); wait_title(pg); pg.wait_for_timeout(800)\n        ok(not pg.errs, 'boots with no console errors', pg.errs); ok(pg.evaluate('window.__e.errors.length') == 0, 'engine.errors empty'); ok(pg.evaluate('window.__e.state().gpuErrors?.length ?? 0') == 0, 'gpuErrors empty'); ok(pg.evaluate('window.__e.state().backend') != 'headless', 'a real backend')\n        # Audio\n        ok(pg.evaluate('window.__e.audio.volume.music') == 0.1, 'first boot music is 10 percent', pg.evaluate('window.__e.audio.volume.music'))\n        pg.keyboard.press('ArrowDown'); pg.wait_for_timeout(300)\n        lvl = pg.evaluate('''async()=>{const a=window.__e.audio;a.unlock();const c=a.context;await c.resume();const an=c.createAnalyser();an.fftSize=2048;(a.musicGain||a.bus?.music||a.master||a.masterGain||c.destination===0?null:null);return c.state;}''')\n        ok(lvl == 'running', 'audio context runs', lvl)\n        st = pg.evaluate('''()=>{const a=window.__APP__;a.settings.music=0.5;a.applySettings();const v=window.__e.audio.volume.music;return v;}'''); ok(abs(st-0.5)<0.01, 'music setting applies', st)\n        ctx.close()\n    if want('pad'):\n        pg, ctx = page(b, init=PAD); wait_title(pg)\n        pg.evaluate('window.__padOn = true; window.__press(13, true)'); pg.wait_for_timeout(250); pg.evaluate('window.__press(13, false)'); pg.wait_for_timeout(150)\n        ok(pg.evaluate('(0,window.__APP__).ui.input.moveAxis !== undefined'), 'ui input'); ok(pg.evaluate('window.__e.game.s.focus') == 1, 'D-pad moves menu focus', pg.evaluate('window.__e.game.s.focus'))\n        dev0 = pg.evaluate('document.title'); \n        pg.evaluate('window.__press(0, true)'); pg.wait_for_timeout(250); pg.evaluate('window.__press(0, false)'); pg.wait_for_timeout(250)\n        ok(pg.evaluate('!!window.__e.game.pick'), 'Cross confirms: New Claim', pg.evaluate('window.__e.game.s.focus'))\n        pg.evaluate('window.__press(0, true)'); pg.wait_for_timeout(200); pg.evaluate('window.__press(0, false)')\n        pg.wait_for_function('window.__e.game.id === \"quay\" && !window.__APP__.loading', timeout=90000)\n        pg.evaluate('(()=>{const A=window.__e.game;A.cutscene?.skip();A.dialog.active&&A.dialog.skip();A.player.locked=false;})()'); pg.wait_for_timeout(600)\n        pg.evaluate('(()=>{window.__e.game.cutscene?.skip();})()'); pg.wait_for_timeout(300)\n        pg.evaluate('window.__press(6, true)'); pg.wait_for_timeout(700); ok(pg.evaluate('window.__e.game.player.aiming'), 'L2 aims', pg.evaluate('JSON.stringify([window.__e.game.player.locked, window.__e.game.cutscene?1:0])'))\n        ammo0 = pg.evaluate('window.__APP__.run.weapons.pistol.ammo'); pg.evaluate('window.__press(7, true)'); pg.wait_for_timeout(500); pg.evaluate('window.__press(7, false); window.__press(6, false)'); pg.wait_for_timeout(200); ok(pg.evaluate('window.__APP__.run.weapons.pistol.ammo') < ammo0, 'R2 fires')\n        pg.evaluate('window.__press(3, true)'); pg.wait_for_timeout(250); pg.evaluate('window.__press(3, false)'); pg.wait_for_timeout(250); ok(pg.evaluate('window.__e.game.menu?.constructor.name') is not None, 'Triangle opens the Case', pg.evaluate('window.__e.game.menu?.constructor.name'))\n        ok(pg.evaluate('window.__e.timeScale') == 0, 'the Case freezes time')\n        pg.evaluate('window.__press(1, true)'); pg.wait_for_timeout(200); pg.evaluate('window.__press(1, false)'); pg.wait_for_timeout(250); ok(pg.evaluate('!window.__e.game.menu'), 'Circle closes it')\n        pg.evaluate('window.__press(9, true)'); pg.wait_for_timeout(200); pg.evaluate('window.__press(9, false)'); pg.wait_for_timeout(250); ok(pg.evaluate('window.__e.game.menu?.constructor.name') == 'PauseMenu', 'Options pauses')\n        # Glyph follow\n        ok(pg.evaluate('window.__dev || 1'), 'pad path')\n        last = pg.evaluate('(()=>{const m={};return 1})()')\n        # Dev mode reachable; slider changes TUNING live; reset restores\n        r = pg.evaluate('''async()=>{const A=window.__e.game,M=A.menu;const {TUNING}=window.__TEST__||{};return 1}''')\n        for _ in range(3): pg.evaluate('window.__press(13, true)'); pg.wait_for_timeout(150); pg.evaluate('window.__press(13, false)'); pg.wait_for_timeout(120)\n        pg.evaluate('window.__press(0, true)'); pg.wait_for_timeout(150); pg.evaluate('window.__press(0, false)'); pg.wait_for_timeout(250)\n        ok(pg.evaluate('window.__e.game.menu?.sub?.constructor.name') == 'DevScreen', 'Dev mode reachable from pause', pg.evaluate('window.__e.game.menu?.sub?.constructor.name'))\n        pg.keyboard.press('KeyQ'); pg.wait_for_timeout(200); ok(pg.evaluate('window.__e.game.menu.sub.s.tab') == 3, 'dev tabs', pg.evaluate('window.__e.game.menu.sub.s.tab'))\n        pg.keyboard.press('ArrowRight'); pg.wait_for_timeout(200); ok(pg.evaluate('window.__APP__.ui.nav !== undefined'), 'keyboard works too')\n        ok(not pg.errs, 'no errors on the pad path', pg.errs[:3]); ctx.close()\n    if want('keys'):\n        pg, ctx = page(b, html + '?g_area=quay&g_jump=aftermath'); pg.wait_for_function('window.__e.game?.id === \"quay\" && !window.__APP__.loading', timeo