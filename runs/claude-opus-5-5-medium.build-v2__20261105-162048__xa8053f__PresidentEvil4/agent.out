this.pos.x, 1.6, this.pos.z)); P.tag(P.world.createCollider(RAPIER.ColliderDesc.capsule(0.9, 1.3), this.body), 'noCamera', 'enemy');\n    this.columns = L.rows.flatMap((r, y) => [...r].map((c, x) => (c === 'H' ? [x, y] : null))).filter(Boolean); a.extraHud = (ui) => this.hud(ui);\n    if (start === 2) { for (const v of this.valves) v.dead = true; this.enterHatch(); } if (start === 3) { this.toMother(); }\n  }\n  hud(ui) { if (this.dead) return; if (this.phase === 1) { ui.center(8, 'THE BATHYSPHERE', { color: 'orange' }); this.valves.forEach((v, i) => ui.bar(ui.W / 2 - 62 + i * 31, 18, 29, 4, v.hp / 140, v.dead ? 'night' : 'red')); } else if (this.phase === 2) { ui.center(8, 'THE HATCH', { color: 'orange' }); this.locks.forEach((v, i) => ui.bar(ui.W / 2 - 62 + i * 42, 18, 40, 4, v.hp / 60, 'sand')); if (this.locks.every((l) => l.dead)) ui.center(26, 'GET CLOSE AND KICK', { color: 'lime' }); } else { ui.center(8, 'THE MOTHER', { color: 'lime' }); ui.bar(ui.W / 2 - 60, 18, 56, 4, (this.mic?.hp ?? 0) / 200, 'sand'); ui.bar(ui.W / 2 + 4, 18, 56, 4, (this.eye?.hp ?? 0) / 400, 'orange'); } }\n  fixed(dt) {\n    if (this.dead) return; const a = this.a; this.prev.copy(this.pos); this.t -= dt; this.cool -= dt; const T = a.nearestPlayer(this.pos); if (!T) return; const d = Math.hypot(T.pos.x - this.pos.x, T.pos.z - this.pos.z);\n    if (this.water.position.y < this.waterY) this.water.position.y += dt * 0.08; else this.water.position.y = this.waterY;\n    if (this.phase === 3) return this.motherFixed(dt, T, d);\n    const L = a.level;\n    switch (this.state) {\n      case 'INTRO': if (this.t <= 0) this.go('WALK'); break;\n      case 'WALK': this.face(T.pos, 2.2 * dt); if (d > 3.5) this.walk(T, dt, this.speed); if (this.cool <= 0) { const R = a.rng; if (d < 3.6) this.go('STOMP', 0.9); else if (d < 7 && R.chance(0.5)) { this.go('JET', 1.3); a.ctx.audio.play('steam'); } else if (d > 7 && R.chance(0.45)) { this.go('CHARGEWIND', 1.1); a.ctx.audio.play('whistle'); } else this.go('RIVET', 1.1); } break;\n      case 'STOMP': if (this.t < 0.3 && !this.hit) { this.hit = true; a.ctx.audio.play('palletdrop'); a.ctx.engine.shake.add(0.5); a.ctx.particles.burst('dust', this.pos, { count: 18 }); if (d < 4.2) T.hurt(25, this.pos, { knock: true }); } if (this.t <= 0) { this.go('WALK'); this.cool = 1.5; } break;\n      case 'JET': { this.face(T.pos, 1.5 * dt); const fx = Math.sin(this.yaw), fz = Math.cos(this.yaw); a.ctx.particles.burst('steam', [this.pos.x + fx * 2, 1.4, this.pos.z + fz * 2], { count: 3, direction: [fx, 0, fz], speed: 2.4 }); if (d < 6.5 && ((T.pos.x - this.pos.x) * fx + (T.pos.z - this.pos.z) * fz) / (d || 1) > 0.75) { if (!this.hit) { this.hit = true; T.hurt(30, this.pos, {}); T.slowT = 2.5; } } if (this.t <= 0) { this.go('WALK'); this.cool = 2.2; } break; }\n      case 'RIVET': this.face(T.pos, 2 * dt); if (this.t < 0.7 && !this.r1) { this.r1 = 1; this.rivet(T); } if (this.t < 0.45 && this.r1 === 1) { this.r1 = 2; this.rivet(T); } if (this.t < 0.2 && this.r1 === 2) { this.r1 = 3; this.rivet(T); } if (this.t <= 0) { this.r1 = 0; this.go('WALK'); this.cool = 2; } break;\n      case 'CHARGEWIND': this.face(T.pos, 3 * dt); if (this.t <= 0) { this.go('CHARGE', 3); this.cdx = Math.sin(this.yaw); this.cdz = Math.cos(this.yaw); } break;\n      case 'CHARGE': { const nx = this.pos.x + this.cdx * 8 * dt, nz = this.pos.z + this.cdz * 8 * dt; const ok = L.enemyCanStand(nx, nz, 0); if (Math.hypot(T.pos.x - this.pos.x, T.pos.z - this.pos.z) < 2.2 && !this.hit) { this.hit = true; T.hurt(40, this.pos, { knock: true }); } if (!ok || this.t <= 0) { const col = L.charAt(nx, nz) === 'H'; if (col) this.shatter(nx, nz); this.go('STUNNED', col ? 3 : 1); a.ctx.audio.play('brass'); a.ctx.engine.shake.add(col ? 0.7 : 0.3); } else { this.pos.x = nx; this.pos.z = nz; a.ctx.particles.burst('dust', this.pos, { count: 1 }); } break; }\n      case 'STUNNED': if (this.t <= 0) { this.go('WALK'); this.cool = 1; } break;\n      case 'SAG': for (const lk of this.locks) if (!lk.dead) break; break;\n    }\n    this.body.setNextKinematicTranslation({ x: this.pos.x, y: 1.6, z: this.pos.z });\n  }\n  shatter(x, z) { const a = this.a, L = a.level; a.ctx.particles.burst('splinter', [x, 1, z], { colors: ['slate', 'mist'], count: 30 }); }\n  rivet(T) { const a = this.a, from = this.pos.clone().setY(2.6), to = T.pos.clone().setY(1.2), d = to.clone().sub(from).normalize().multiplyScalar(14); const p = a.addProjectile({ kind: 'rivet', model: 'w-bolt', pos: from, vel: d, g: 0, life: 1.6, r: 0.5, dmg: 12, faces: true }); a.ctx.audio.play('brass', a.spatialPlay(from, 0.5)); }\n  go(s, t = 1) { this.state = s; this.t = t; this.hit = false; this.anim = null; }\n  face(p, k) { const want = Math.atan2(p.x - this.pos.x, p.z - this.pos.z); let d = want - this.yaw; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; this.yaw += d * Math.min(1, k); }\n  walk(T, dt, sp) { const a = this.a, nav = a.flowNav(0, T), o = [0, 0]; if (!nav.flowDirection(this.pos.x, this.pos.z, o)) return; const nx = this.pos.x + o[0] * sp * dt, nz = this.pos.z + o[1] * sp * dt; if (a.level.enemyCanStand(nx, this.pos.z, 0)) this.pos.x = nx; if (a.level.enemyCanStand(this.pos.x, nz, 0)) this.pos.z = nz; }\n  rayParts(o, d) {\n    const out = []; if (this.dead) return out; if (this.phase === 1) for (const v of this.valves) { if (v.dead) continue; const t = raySphere(o, d, v.pos, 0.42); if (t != null) out.push({ t, part: { hit: (dmg, pt) => this.hitValve(v, dmg, pt) } }); }\n    if (this.phase === 2) for (const lk of this.locks) { if (lk.dead) continue; const t = raySphere(o, d, lk.pos, 0.4); if (t != null) out.push({ t, part: { hit: (dmg, pt) => this.hitLock(lk, dmg, pt) } }); }\n    if (this.phase === 3) { for (const p of [this.mic, this.eye]) { if (!p || p.dead || p.locked) continue; const t = raySphere(o, d, p.pos, p.r); if (t != null) out.push({ t, part: { hit: (dmg, pt) => p.hit(dmg, pt) } }); } const t = raySphere(o, d, this.motherC, 2.4); if (t != null) out.push({ t: t + 0.05, part: { hit: (dmg, pt) => { this.a.ctx.particles.burst('spark', pt, { count: 2 }); this.a.ctx.audio.play('armorping', { volume: 0.4 }); } } }); }\n    else { const c = this.h.joints.Torso.getWorldPosition(new THREE.Vector3()); c.y += 1.0; const t = raySphere(o, d, c, 1.25); if (t != null) out.push({ t: t + 0.02, part: { hit: (dmg, pt) => { this.a.ctx.particles.burst('spark', pt, { count: 3 }); this.a.ctx.audio.play('armorping', { volume: 0.5 }); } } }); }\n    return out;\n  }\n  hitValve(v, dmg, pt) { const a = this.a; v.hp -= dmg; a.ctx.particles.burst('steam', pt); a.ctx.audio.play('armorping'); this.h.flash(1); if (v.hp <= 0) { v.dead = true; a.fx.blast(pt, 1.4); a.ctx.audio.play('steam'); a.ctx.audio.play('brass'); this.waterY += 0.15; const L = a.level; for (let i = 0; i < 4; i++) { const m = a.rng.pick([[5, 44], [22, 44], [4, 6], [23, 6]]); a.spawnEnemy('monk', L.wx(m[0]) + i * 0.5, L.wz(m[1])); } a.say('COMMODORE', a.rng.pick(['THOSE ARE ORIGINAL FITTINGS!', 'THAT VALVE WAS BLESSED!', 'DO YOU KNOW WHAT BRASS COSTS?', 'I SHALL WRITE TO YOUR EMPLOYERS!']), 2); if (this.valves.every((x) => x.dead)) this.enterHatch(); } }\n  enterHatch() { const a = this.a; this.phase = 2; this.go('SAG', 999); this.h.play('BathySag', { fade: 0.4 }); this.anim = 'BathySag'; a.setObjective('THREE LOCKS ON THE HATCH. SHOOT THEM.'); a.ctx.audio.play('steam'); }\n  hitLock(lk, dmg, pt) { const a = this.a; lk.hp -= dmg; a.ctx.particles.burst('spark', pt); a.ctx.audio.play('brass'); if (lk.hp <= 0) { lk.dead = true; a.ctx.audio.play('kickhit'); if (this.locks.every((l) => l.dead)) { a.setObjective('KICK THE HATCH.'); this.kick = a.interact.add({ x: this.pos.x, z: this.pos.z, radius: 4, priority: 9, any: true, verb: 'TEAR THE HATCH', act: () => { a.interact.remove(this.kick); this.hatchScene(); return true; } }); } } }\n  hatchScene() {\n    const a = this.a, P = a.player, c = [this.pos.x, 2.6, this.pos.z]; P.locked = true; for (const e of [...a.enemies]) if (!e.dead) e.die({}); a.addScript([{ scene: 'hatch', duration: 7, shots: () => [{ at: 0, position: [c[0] + 3, 2.8, c[2] + 4], target: c, fov: 40 }, { at: 7, position: [c[0] + 1.2, 2.8, c[2] + 2], target: c, fov: 26 }], cues: [{ at: 1.5, run: () => { a.ctx.audio.play('brass'); a.ctx.audio.play('kickhit'); a.ctx.engine.shake.add(0.5); P.teleport(this.pos.x + 2, this.pos.z + 3); } }] }, { run: () => this.toMother() }]);\n  }\n  toMother() {\n    const a = this.a, L = a.level; this.phase = 3; this.state = 'MOTHER'; this.root.visible = false; a.ctx.physics.remove(this.body); this.body = null; const at = new THREE.Vector3(L.wx(14), 0, L.wz(13)); this.motherObj = buildProp('mother', { shadow: true }); this.motherObj.object.position.copy(at); a.ctx.scene.add(this.motherObj.object); a.ctx.audio.play('sting'); this.motherC = at.clone().setY(1.4); const P = a.player; P.locked = false; P.teleport(L.wx(14), L.wz(24), 0, Math.PI); a.setObjective('THE MICROPHONE. THEN THE EYE.'); this.body2 = a.ctx.physics.addStaticBox({ position: [at.x, 1.3, at.z], halfExtents: [2, 1.3, 2] }); a.ctx.physics.tag(this.body2, 'noCamera', 'noBullet');\n    this.mic = { hp: 200, r: 0.42, pos: at.clone().set(at.x, 3.5, at.z + 0.72), hit: (dmg, pt) => this.hitMic(dmg, pt) }; this.eye = { hp: 400, r: 0.7, locked: true, pos: at.clone().set(at.x, 1.5, at.z + 2.05), hit: (dmg, pt) => this.hitEye(dmg, pt) }; this.spitT = 2; this.birthT = 5; this.talkT = 3; a.ctx.lights.request({ position: [at.x, 3, at.z + 3], color: 0x90ff60, intensity: 14, radius: 12, flicker: 'pulse' });\n    this.lines = ['THIS ISLAND HAS BEEN IN MY FAMILY FOR- ', 'I AM THE VOICE OF SKERRY HOLM AND I WILL NOT BE- ', 'THE NEXT PIECE OF MUSIC IS NUMBER NINE- ']; this.lineI = 0; a.boss = this;\n  }\n  flare(at, r) { for (const e of this.a.enemies) if (e.crawler && !e.dead) e.die({}); }\n  motherFixed(dt, T, d) {\n    const a = this.a; this.spitT -= dt; this.birthT -= dt; this.talkT -= dt;\n    if (this.settling) return; if (this.spitT <= 0) { this.spitT = a.rng.range(2, 3.4); const from = this.motherC.clone().setY(2.6), to = T.pos.clone(), air = 1.1, g = 12; a.addProjectile({ kind: 'glob', model: 'w-bottle', pos: from, vel: new THREE.Vector3((to.x - from.x) / air, (to.y - from.y) / air + 0.5 * g * air, (to.z - from.z) / air), g, life: air, r: 0.5, dmg: 20 }); a.ctx.audio.play('splash', { volume: 0.5 }); a.addTelegraphMark(to.clone().setY(0.1), air); }\n    if (this.birthT <= 0) { this.birthT = 7; const k = a.enemies.filter((e) => e.crawler && !e.dead).length; if (k < 5) for (let i = 0; i < 3; i++) a.spawnEnemy('limpet', this.motherC.x + (i - 1) * 1.6, this.motherC.z + 2.6); a.say('MAX', 'Dependants. Not covered.', 1.2); }\n    if (this.talkT <= 0 && !this.mic.dead) { this.talkT = 6; a.say('COMMODORE', this.lines[this.lineI++ % 3], 2); }\n    if (this.motherObj) { const o = this.motherObj.object, f = o.getObjectByName('Fused'); if (f) f.rotation.x = Math.sin(a.time * 2) * 0.03; const ey = o.getObjectByName('Eye'); if (ey && !this.eye.locked) ey.scale.y = 0.8 + Math.sin(a.time * 3) * 0.2; }\n  }\n  hitMic(dmg, pt) { const a = this.a, m = this.mic; m.hp -= dmg; a.ctx.particles.burst('spark', pt); a.ctx.audio.play('brass'); if (m.hp <= 0 && !m.dead) { m.dead = true; const o = this.motherObj.object.getObjectByName('Mic'); if (o) o.visible = false; for (const s of a.subs) if (s.who === 'COMMODORE') { s.text = s.text.slice(0, Math.floor(s.n)) + '-'; s.t = 1; } a.ctx.audio.play('tannoybreak'); a.app.mix.play(null, 0.1); this.eye.locked = false; a.silent = false; a.ctx.tweens.call(2.2, () => { a.say('COMMODORE', 'NOT FOR LONG. NOT FOR LONG. NOT FOR LONG.', 3); a.setObjective('IT WAS NEVER THE MICROPHONE. THE EYE.'); }); a.ctx.tweens.call(5, () => a.app.mix.play('boss', 0.5)); } }\n  hitEye(dmg, pt) { const a = this.a, E = this.eye; if (this.settling) return; E.hp -= dmg; a.ctx.particles.burst('brine', pt); a.ctx.audio.play('bodyhit'); if (E.hp <= 0) this.settlement(); }\n  settlement() {\n    const a = this.a, P = a.player, c = this.motherC; this.settling = true; for (const e of [...a.enemies]) if (!e.dead) e.die({}); for (const p of [...a.projectiles]) a.killProjectile(p); a.app.mix.play(null, 0.2); P.locked = true; P.aiming = false; a.extraHud = null; P.teleport(c.x, c.z + 4.2, 0, Math.PI);\n    a.camOverride = () => ({ position: [c.x + 2.2, 1.8, c.z + 6.4], target: [c.x, 1.6, c.z + 2], fov: 42 });\n    const q = (o, done) => a.qte.start({ owner: P, slow: false, time: TUNING.qteWindow * 1.6, ...o, onDone: (ok) => { if (!ok) { a.say('MAX', a.rng.pick(['Adjusting.', 'One moment, please.']), 1); a.ctx.tweens.call(0.7, () => q(o, done)); } else { a.ctx.audio.play('kickhit'); a.ctx.engine.shake.add(0.4); done(); } } });\n    q({ type: 'press', button: 'action', label: 'SERVE NOTICE' }, () => q({ type: 'press', button: 'dodge', label: 'MIND THE COAT' }, () => q({ type: 'mash', label: 'STAMP IT', fill: 8, time: 5, drain: 0.4, mashTimeoutOk: false }, () => this.finish())));\n  }\n  finish() {\n    const a = this.a, P = a.player; a.ctx.audio.play('stamp'); a.ctx.engine.hitstop(0.2); a.ctx.engine.shake.add(1); a.ctx.engine.screen?.flash?.('white', { duration: 0.2 }); P.startAction('stamp', 1); P.locked = true; a.dialog.start(SCENES.settlement, { lock: true, done: () => {} });\n    a.ctx.tweens.call(2.2, () => { const o = this.motherObj.object; a.ctx.tweens.to(o.position, { y: -4 }, { duration: 3 }); a.ctx.audio.play('rumble'); a.ctx.particles.burst('brine', this.motherC, { count: 30 }); this.waterY = 0.25; a.ctx.engine.shake.add(0.6); });\n    a.ctx.tweens.call(4.4, () => { a.camOverride = null; P.locked = false; a.ctx.physics.remove(this.body2); this.dead = true; a.say('PYM', 'Ms. Ransom, the building appears to be leaving. Please proceed to the side gate.', 3); a.app.mix.play('tide', 0.3); });\n  }\n  update(dt) {\n    const a = this.a; if (this.phase === 3 || this.dead) return; const A = a.ctx.physics.alpha; this.root.position.lerpVectors(this.prev, this.pos, A); this.root.rotation.y = this.yaw; const c = { INTRO: 'BathyWalk', WALK: 'BathyWalk', STOMP: 'BosunStomp', JET: 'BosunRoar', RIVET: 'Punch', CHARGEWIND: 'BosunRoar', CHARGE: 'BathyCharge', STUNNED: 'BathySag', SAG: 'BathySag' }[this.state]; if (this.anim !== c) { this.anim = c; this.h.play(c, { restart: true }); } this.h.update(dt); this.figure.update(dt);\n    this.root.updateWorldMatrix(true, true); for (const v of this.valves) { v.pos.copy(v.off).applyMatrix4(this.h.joints[v.j].matrixWorld); } const tp = this.h.joints.Torso; for (const lk of this.locks) { lk.pos.set(Math.cos(lk.i * 2.09) * 0.2, 0.98, Math.sin(lk.i * 2.09) * 0.2).applyMatrix4(tp.matrixWorld); }\n  }\n}\nE\ncat > src/game/launch.js <<'E'\n// The Launch, on rails. Stern deck, free aim. The world scrolls past; the Dame drives. Then dawn.\nimport { PALETTE, THREE, applySky, skyAt, setLookLayer, toonMaterial } from '../../pixel-engine.js';\nimport { TUNING } from '../data/tuning.js';\nimport { SCENES } from '../data/dialogue.js';\nimport { Area } from './area.js';\nimport { Humanoid, buildProp } from './actor.js';\nimport { MOODS, applyMood } from './world.js';\nimport { FormScreen } from '../screens/form.js';\nimport { CreditsScreen } from '../screens/credits.js';\nconst SPEED = 14;\nexport class Launch extends Area {\n  constructor(app, id, o = {}) { super(app, id, o); this.def = { map: 'deck', title: 'THE LAUNCH', mood: 'moon', music: 'boss', hint: 'general', water: true, waterY: -1.05, waterOpt: { choppy: true }, loops: ['sea'], startYaw: Math.PI, chapter: 4, noDress: true, theme: { '=': 'deck' } }; this.scroll = []; this.lt = 0; this.table = []; this.ended = false; }\n  async setup(ctx) {\n    await super.setup(ctx); const P = this.player; P.noMove = true; const hull = buildProp('launch-hull'); hull.object.position.set(0, -1.03, 0); ctx.scene.add(hull.object); this.hull = hull.object; this.interact.items.length = 0;\n    this.dameM = new Humanoid(ctx, 'dame', { scale: 0.82 }); this.dameM.root.position.set(0, 0, 3.6); this.dameM.root.rotation.y = 0; this.dameM.play('DameHoist'); ctx.lights.request({ position: [0, 2.6, 2.5], color: 0xffd080, intensity: 6, radius: 9 });\n    P.teleport(0, -2.2, 0, Math.PI); this.camYaw = Math.PI; this.fillLight = 1;\n    for (let i = 0; i < 16; i++) this.spawnStack(-70 + i * 16, this.rng.chance(0.5) ? 1 : -1);\n    const T = this.table; const t = (at, fn) => T.push({ at, fn }); for (const at of [6, 26, 46, 66]) t(at, () => this.spawnBoat()); for (const at of [11, 17, 22, 32, 40, 51, 58, 70]) t(at, () => this.spawnMine()); for (const at of [28, 55, 76]) t(at, () => this.spawnRock()); for (const at of [20, 44, 62]) t(at, () => this.spawnLimpets()); t(70, () => this.startDawn()); t(84, () => this.arch()); T.sort((a, b) => a.at - b.at);\n    if (this.o.jump === 'ending') { this.lt = 200; this.table.length = 0; this.startDawn(1); this.ctx.tweens.call(0.2, () => this.ending()); }\n    this.app.mix.play('boss'); this.setObjective('KEEP THEM OFF THE LAUNCH.'); this.bumpT = 0;\n    this.say('DAME', 'I am driving. Do not distract me.', 2);\n  }\n  spawnStack(z, side) { const id = this.rng.chance(0.75) ? 'sea-stack' : 'backdrop-cliff'; const b = buildProp(id, { shadow: false }); b.object.position.set(side * this.rng.range(16, 44), -2, z); b.object.rotation.y = this.rng.range(0, 6); this.ctx.scene.add(b.object); this.scroll.push({ o: b.object, loop: true, side }); }\n  spawnBoat() {\n    const side = this.rng.chance(0.5) ? 1 : -1; const r = buildProp('rowboat'); this.ctx.scene.add(r.object); const e = this.spawnEnemy('harpooner', side * 9, -44, { state: 'BOAT' }); e.boat = r.object; e.cool = 3; e.tz = this.rng.range(-20, -14); e.s_BOAT = function (dt) { const a = this.area; this.pos.z += (this.tz - this.pos.z) * Math.min(1, dt * 0.6); this.pos.x = side * (7 + Math.sin(a.time * 0.7 + this.id) * 3); this.pos.y = -0.6 + Math.sin(a.time * 2 + this.id) * 0.1; this.boat.position.set(this.pos.x, -1, this.pos.z); this.boat.rotation.y = Math.sin(a.time * 2) * 0.1; const P = a.player; this.face(P.pos, 0.2); if (this.cool <= 0 && !this.wind) { this.wind = 1.4; a.ctx.lights.request({ position: this.pos.clone().setY(1), color: 0xff3020, intensity: 10, radius: 4, lifetime: 1.2 }); a.ctx.audio.play('armorping', { volume: 0.4 }); } if (this.wind > 0) { this.wind -= dt; if (this.wind <= 0) { this.wind = 0; this.cool = 5.5; a.spawnThrow(this, P); } } }; const die0 = e.die.bind(e); e.die = (info, head) => { die0(info, head); this.ctx.tweens.to(r.object.position, { y: -3 }, { duration: 2 }); this.ctx.tweens.call(2, () => this.ctx.scene.remove(r.object)); };\n  }\n  spawnMine() { const x = this.rng.range(-5, 5); const p = this.addProjectile({ kind: 'mine', model: 'mine', pos: new THREE.Vector3(x, -1, -46), vel: new THREE.Vector3(-x / 8, 0, 6), g: 0, life: 8, r: 0.9, stops: true, counts: true, onLand: (m) => { this.fx.blast(m.pos, 3); this.ctx.audio.play('depthcharge'); this.ctx.engine.shake.add(0.8); if (m.pos.z > -7) this.player.hurt(25, m.pos, { knock: true }); this.say('MAX', 'Excess applies.', 1); } }); p.obj.rotation.set(0, 0, 0); p.spinless = true; }\n  spawnRock() { const x = this.rng.range(-2, 2), z = -2; const from = new THREE.Vector3(x + this.rng.range(-3, 3), 22, z - 6); const p = this.addProjectile({ kind: 'rock', model: 'boulders', pos: from, vel: new THREE.Vector3((x - from.x) / 2.6, -7, 2.3), g: 0, life: 2.6, r: 1.5, stops: true, onLand: () => { this.ctx.audio.play('palletdrop'); this.ctx.engine.shake.add(0.8); this.qte.start({ owner: this.player, type: 'press', button: 'dodge', label: 'DODGE', time: TUNING.qteWindow * 1.2, onDone: (ok) => { if (!ok) this.player.hurt(30, from, { knock: true }); } }); } }); this.ctx.audio.play('rumble', { volume: 0.5 }); this.say('DAME', 'Rock.', 1); }\n  spawnLimpets() { for (let i = 0; i < 3; i++) this.spawnEnemy('limpet', -1.2 + i * 1.2, -3.8, {}); this.ctx.audio.play('skitter'); this.say('MAX', 'Stowaways.', 1); }\n  startDawn(k = 0) { const m = MOODS.dawn; this.dawnT = k; this.dawnOn = true; this.ctx.engine.setSunDirection([0.3, 0.3, 1]); }\n  arch() { const b = buildProp('arch-rock', { shadow: false }); b.object.position.set(0, -2, 40); this.ctx.scene.add(b.object); this.scroll.push({ o: b.object }); this.ctx.audio.play('rumble'); this.qte.start({ owner: this.player, type: 'press', button: 'action', label: 'HOLD ON', time: 2.4, onDone: (ok) => { if (!ok) this.player.hurt(25, null, { knock: true }); this.ctx.engine.shake.add(0.9); this.ctx.audio.play('palletdrop'); this.ctx.tweens.call(2.2, () => this.ending()); } }); }\n  ending() {\n    if (this.ended) return; this.ended = true; for (const e of [...this.enemies]) if (!e.dead) e.die({}); this.table.length = 0; for (const p of [...this.projectiles]) this.killProjectile(p); this.app.mix.play('dawn', 0.4); this.extraHud = null; const P = this.player; P.locked = true; P.aiming = false; P.teleport(0.7, 0.1, 0, 0.1); P.h.upperName = null; P.h.play('Idle'); this.dameM.root.position.set(-0.6, 0, 0.6); this.dameM.root.rotation.y = 2.4; this.dameM.play('DameIdle');\n    this.addScript([{ wait: 0.6 }, { scene: 'ending', duration: 16, shots: () => [{ at: 0, position: [3.2, 1.8, -2.4], target: [0, 1.1, 0.4], fov: 42 }, { at: 8, position: [2.4, 1.6, -1.4], target: [0.3, 1.2, 0.4], fov: 34 }, { at: 16, position: [4, 3, -6], target: [0, 1.4, 2], fov: 45 }] }, { run: () => { this.openMenu(new FormScreen(this, () => this.credits(), { title: 'FINAL CLAIM FORM' })); } }]);\n  }\n  credits() { this.openMenu(new CreditsScreen(this)); }\n  fixedUpdate(ctx, dt) {\n    super.fixedUpdate(ctx, dt); if (this.menu) return; this.lt += dt; const T = this.table; while (T.length && T[0].at <= this.lt) T.shift().fn(); for (const s of this.scroll) { s.o.position.z -= SPEED * dt; if (s.loop && s.o.position.z < -90) { s.o.position.z += 170; } }\n    this.bumpT = (this.bumpT ?? 0) + dt; for (const e of this.enemies) { if (e.crawler && !e.dead && e.pos.z > 2.4) e.pos.z = 2.4; }\n    if (this.dawnOn && this.dawnT < 1) { this.dawnT = Math.min(1, this.dawnT + dt / 12); this.dawnApply(); }\n    if (this.lt > 120 && !this.ended) this.ending();\n  }\n  dawnApply() { const e = this.ctx.engine, k = this.dawnT, m = MOODS.dawn; const h = 2 + (6.5 - 2) * k; const s = skyAt(h); applySky(e, s); e.sun.intensity = 0.45 + (m.sun - 0.45) * k; e.ambient.intensity = 0.95 + (m.ambient - 0.95) * k; this.ctx.scene.background = new THREE.Color(PALETTE.ink).lerp(new THREE.Color(PALETTE.sky), k); this.mist.color.value.setHex(0x29366f).lerp(new THREE.Color(m.fog[0]), k); this.mist.amount.value = 0.55 + (m.fog[2] - 0.55) * k; }\n  update(ctx, dt) { super.update(ctx, dt); if (this.menu) return; this.dameM.update(dt); const t = this.time; this.hull.rotation.z = Math.sin(t * 1.3) * 0.03; this.hull.rotation.x = Math.sin(t * 0.9) * 0.02; if (!this.ended) { this.wakeT = (this.wakeT ?? 0) - dt; if (this.wakeT <= 0) { this.wakeT = 0.1; ctx.particles.burst('splash', [this.rng.range(-1.2, 1.2), -1, -4.6], { count: 3 }); } } }\n}\nE\ncat > src/screens/credits.js <<'E'\n// On-hold jingle over black, the credits, and one last shot.\nimport { CREDIT_LINES } from '../data/about.js';\nimport { buildProp } from '../game/actor.js';\nimport { SCENES } from '../data/dialogue.js';\nexport class CreditsScreen {\n  constructor(A) { this.A = A; this.t = 0; A.app.mix.play('onhold', 0.1); }\n  update(ui) {\n    this.t += 1 / 60; const A = this.A; const lines = CREDIT_LINES; const y0 = ui.H - this.t * 14; if (this.t < 2 + (lines.length * 12 + ui.H) / 14) { ui.rect(0, 0, ui.W, ui.H, 'ink'); lines.forEach((l, i) => { const y = y0 + i * 12; if (y > -10 && y < ui.H) ui.center(y, l[0], { color: l[1] ?? 'mist', scale: l[2] ?? 1 }); }); ui.prompts([['confirm', 'SKIP']]); if (ui.confirm || ui.click) this.t = 9999; return; }\n    if (!this.shot) { this.shot = 0.001; A.menu = this; A.ctx.engine.timeScale = 1; A.ctx.scene.background; this.limpet = buildProp('limpet'); this.limpet.object.position.set(0.2, -0.3, -3.8); this.limpet.object.scale.setScalar(1.2); A.ctx.scene.add(this.limpet.object); A.camOverride = () => ({ position: [0.5, 0.5, -5.2], target: [0.2, -0.2, -3.8], fov: 26 }); A.hideHud = true; }\n    this.shot += 1 / 60; const o = this.limpet.object; o.scale.y = 1.2 + Math.min(1, this.shot / 4) * 0.5; ui.hud.clear();\n    if (this.shot > 6 || ((ui.confirm || ui.click) && this.shot > 0.5)) { A.menu = null; A.app.saveClear?.(); A.app.goTitle(); }\n  }\n}\nE\necho ok","description":"Write Bosun, Bathysphere, Launch and credits"}}}
