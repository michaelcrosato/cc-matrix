__padOn = false; navigator.getGamepads = () => (window.__padOn ? [window.__pad] : []); window.__press = (b, on) => { window.__pad.buttons[b].pressed = on; window.__pad.buttons[b].value = on ? 1 : 0; }; })()'''\ndef page(b, url=html, init=None, **kw):\n    ctx = b.new_context(viewport={'width': 960, 'height': 540}, **kw); pg = ctx.new_page(); pg.errs = []\n    pg.on('console', lambda m: pg.errs.append(m.text) if m.type == 'error' else None); pg.on('pageerror', lambda e: pg.errs.append(str(e)))\n    if init: pg.add_init_script(init)\n    pg.goto(url); pg.wait_for_function('window.__APP__ && window.__PIXEL_ENGINE__', timeout=120000); pg.evaluate('async()=>{window.__e=await window.__PIXEL_READY__;}'); return pg, ctx\ndef wait_title(pg): pg.wait_for_function('window.__e.game?.name === \"title\" && !window.__APP__.loading', timeout=60000)\ndef hud_has(pg): return pg.evaluate('window.__e.hud.canvas ? true : false')\ndef want(name): return not only or name in only\nwith sync_playwright() as p:\n    b = p.chromium.launch(args=GPU)\n    if want('boot'):\n        pg, ctx = page(b); wait_title(pg); pg.wait_for_timeout(800)\n        ok(not pg.errs, 'boots with no console errors', pg.errs); ok(pg.evaluate('window.__e.errors.length') == 0, 'engine.errors empty'); ok(pg.evaluate('window.__e.state().gpuErrors?.length ?? 0') == 0, 'gpuErrors empty'); ok(pg.evaluate('window.__e.state().backend') != 'headless', 'a real backend')\n        # Audio\n        ok(pg.evaluate('window.__e.audio.volume.music') == 0.1, 'first boot music is 10 percent', pg.evaluate('window.__e.audio.volume.music'))\n        pg.keyboard.press('ArrowDown'); pg.wait_for_timeout(300)\n        lvl = pg.evaluate('''async()=>{const a=window.__e.audio;a.unlock();const c=a.context;await c.resume();const an=c.createAnalyser();an.fftSize=2048;(a.musicGain||a.bus?.music||a.master||a.masterGain||c.destination===0?null:null);return c.state;}''')\n        ok(lvl == 'running', 'audio context runs', lvl)\n        st = pg.evaluate('''()=>{const a=window.__APP__;a.settings.music=0.5;a.applySettings();const v=window.__e.audio.volume.music;return v;}'''); ok(abs(st-0.5)<0.01, 'music setting applies', st)\n        ctx.close()\n    if want('pad'):\n        pg, ctx = page(b, init=PAD); wait_title(pg)\n        pg.evaluate('window.__padOn = true; window.__press(13, true)'); pg.wait_for_timeout(250); pg.evaluate('window.__press(13, false)'); pg.wait_for_timeout(150)\n        ok(pg.evaluate('(0,window.__APP__).ui.input.moveAxis !== undefined'), 'ui input'); ok(pg.evaluate('window.__e.game.s.focus') == 1, 'D-pad moves menu focus', pg.evaluate('window.__e.game.s.focus'))\n        dev0 = pg.evaluate('document.title'); \n        pg.evaluate('window.__press(0, true)'); pg.wait_for_timeout(250); pg.evaluate('window.__press(0, false)'); pg.wait_for_timeout(250)\n        ok(pg.evaluate('!!window.__e.game.pick'), 'Cross confirms: New Claim', pg.evaluate('window.__e.game.s.focus'))\n        pg.evaluate('window.__press(0, true)'); pg.wait_for_timeout(200); pg.evaluate('window.__press(0, false)')\n        pg.wait_for_function('window.__e.game.id === \"quay\" && !window.__APP__.loading', timeout=90000)\n        pg.evaluate('(()=>{const A=window.__e.game;A.cutscene?.skip();A.dialog.active&&A.dialog.skip();A.player.locked=false;})()'); pg.wait_for_timeout(600)\n        pg.evaluate('(()=>{window.__e.game.cutscene?.skip();})()'); pg.wait_for_timeout(300)\n        pg.evaluate('window.__press(6, true)'); pg.wait_for_timeout(700); ok(pg.evaluate('window.__e.game.player.aiming'), 'L2 aims', pg.evaluate('JSON.stringify([window.__e.game.player.locked, window.__e.game.cutscene?1:0])'))\n        ammo0 = pg.evaluate('window.__APP__.run.weapons.pistol.ammo'); pg.evaluate('window.__press(7, true)'); pg.wait_for_timeout(500); pg.evaluate('window.__press(7, false); window.__press(6, false)'); pg.wait_for_timeout(200); ok(pg.evaluate('window.__APP__.run.weapons.pistol.ammo') < ammo0, 'R2 fires')\n        pg.evaluate('window.__press(3, true)'); pg.wait_for_timeout(250); pg.evaluate('window.__press(3, false)'); pg.wait_for_timeout(250); ok(pg.evaluate('window.__e.game.menu?.constructor.name') is not None, 'Triangle opens the Case', pg.evaluate('window.__e.game.menu?.constructor.name'))\n        ok(pg.evaluate('window.__e.timeScale') == 0, 'the Case freezes time')\n        pg.evaluate('window.__press(1, true)'); pg.wait_for_timeout(200); pg.evaluate('window.__press(1, false)'); pg.wait_for_timeout(250); ok(pg.evaluate('!window.__e.game.menu'), 'Circle closes it')\n        pg.evaluate('window.__press(9, true)'); pg.wait_for_timeout(200); pg.evaluate('window.__press(9, false)'); pg.wait_for_timeout(250); ok(pg.evaluate('window.__e.game.menu?.constructor.name') == 'PauseMenu', 'Options pauses')\n        # Glyph follow\n        ok(pg.evaluate('window.__dev || 1'), 'pad path')\n        last = pg.evaluate('(()=>{const m={};return 1})()')\n        # Dev mode reachable; slider changes TUNING live; reset restores\n        r = pg.evaluate('''async()=>{const A=window.__e.game,M=A.menu;const {TUNING}=window.__TEST__||{};return 1}''')\n        for _ in range(3): pg.evaluate('window.__press(13, true)'); pg.wait_for_timeout(150); pg.evaluate('window.__press(13, false)'); pg.wait_for_timeout(120)\n        pg.evaluate('window.__press(0, true)'); pg.wait_for_timeout(150); pg.evaluate('window.__press(0, false)'); pg.wait_for_timeout(250)\n        ok(pg.evaluate('window.__e.game.menu?.sub?.constructor.name') == 'DevScreen', 'Dev mode reachable from pause', pg.evaluate('window.__e.game.menu?.sub?.constructor.name'))\n        pg.keyboard.press('KeyQ'); pg.wait_for_timeout(200); ok(pg.evaluate('window.__e.game.menu.sub.s.tab') == 3, 'dev tabs', pg.evaluate('window.__e.game.menu.sub.s.tab'))\n        pg.keyboard.press('ArrowRight'); pg.wait_for_timeout(200); ok(pg.evaluate('window.__APP__.ui.nav !== undefined'), 'keyboard works too')\n        ok(not pg.errs, 'no errors on the pad path', pg.errs[:3]); ctx.close()\n    if want('keys'):\n        pg, ctx = page(b, html + '?g_area=quay&g_jump=aftermath'); pg.wait_for_function('window.__e.game?.id === \"quay\" && !window.__APP__.loading', timeout=120000); pg.wait_for_timeout(500)\n        x0 = pg.evaluate('window.__e.game.player.pos.z'); pg.keyboard.down('KeyW'); pg.wait_for_timeout(1200); pg.keyboard.up('KeyW'); ok(pg.evaluate('window.__e.game.player.pos.z') != x0, 'WASD moves', x0)\n        pg.mouse.move(400, 300); pg.mouse.click(400, 300); pg.wait_for_timeout(300); yaw0 = pg.evaluate('window.__e.game.player.camYaw'); pg.evaluate('window.__e.input.addPointer(50,0)'); pg.wait_for_timeout(120); ok(abs(pg.evaluate('window.__e.game.player.camYaw') - yaw0) > 0.01, 'the mouse looks', yaw0)\n        pg.mouse.down(button='right'); pg.wait_for_timeout(500); ok(pg.evaluate('window.__e.game.player.aiming'), 'right mouse aims'); pg.mouse.up(button='right')\n        pg.keyboard.press('KeyI'); pg.wait_for_timeout(300); ok(pg.evaluate('window.__e.game.menu?.constructor.name') == 'CaseScreen', 'I opens the Case'); pg.mouse.move(100, 200); pg.wait_for_timeout(200); pg.keyboard.press('Escape'); pg.wait_for_timeout(300); ok(pg.evaluate('!window.__e.game.menu'), 'Esc closes it'); ok(not pg.errs, 'no errors with keys and mouse', pg.errs[:3]); ctx.close()\n    if want('menu'):\n        pg, ctx = page(b); wait_title(pg)\n        pg.mouse.move(480, 300); pg.wait_for_timeout(120); pg.mouse.move(480, 262); pg.wait_for_timeout(200); f0 = pg.evaluate('window.__e.game.s.focus'); pg.mouse.move(480, 302); pg.wait_for_timeout(250); f1 = pg.evaluate('window.__e.game.s.focus'); ok(f0 != f1, 'hover moves the focus', [f0, f1])\n        # Open About by keyboard\n        for _ in range(4): pg.keyboard.press('ArrowDown'); pg.wait_for_timeout(120)\n        focus = pg.evaluate('window.__e.game.s.focus'); pg.evaluate('(()=>{const g=window.__e.game;g.s.focus=g.items().findIndex(i=>i.id===\"about\")})()'); pg.keyboard.press('Enter'); pg.wait_for_timeout(300); ok(pg.evaluate('window.__e.game.sub?.constructor.name') == 'AboutScreen', 'About opens', focus)\n        ok(pg.evaluate('window.__e.game.sub.s.tab') == 0, 'About starts on Source'); labels = 0\n        for _ in range(4): pg.keyboard.press('KeyE'); pg.wait_for_timeout(120); labels += 1\n        ok(pg.evaluate('window.__e.game.sub.s.tab') == 4, 'About has five pages', pg.evaluate('window.__e.game.sub.s.tab')); pg.keyboard.press('Escape'); pg.wait_for_timeout(200)\n        # Attract: 10 s idle then any key exits. Use idle poke to avoid a long wait.\n        pg.evaluate('window.__e.game.idle = 9.6'); pg.wait_for_function('!!window.__APP__.attract', timeout=30000); ok(True, 'attract starts on idle'); pg.wait_for_function('window.__e.game?.attract === true && !window.__APP__.loading', timeout=120000); pg.wait_for_timeout(600); pg.keyboard.press('KeyX'); pg.wait_for_function('!window.__APP__.attract', timeout=30000); ok(True, 'any key exits attract'); pg.wait_for_function('window.__e.game?.name === \"title\"', timeout=60000); ok(not pg.errs, 'no errors in attract', pg.errs[:3]); ctx.close()\n    if want('phone'):\n        ctx0 = p.devices['iPhone 13']; pg, ctx = page(b, **{k: v for k, v in ctx0.items() if k in ('user_agent', 'has_touch', 'is_mobile', 'device_scale_factor')})\n        pg.wait_for_function('!!window.__APP__.attract || window.__e.game?.attract === true', timeout=120000); pg.wait_for_function('window.__e.game?.attract === true && !window.__APP__.loading', timeout=120000); pg.wait_for_timeout(600); ok(pg.evaluate('!!window.__APP__.attract.touch'), 'touch-only runs attract with the panel', pg.evaluate('navigator.maxTouchPoints'))\n        ok(pg.evaluate('!window.__e.touch'), 'no touch controls'); pg.touchscreen.tap(100, 100); pg.wait_for_timeout(400); ok(pg.evaluate('!!window.__APP__.attract'), 'a tap does not exit attract')\n        # Settings button: centre of the panel\n        pos = pg.evaluate('(()=>{const h=window.__e.hud,c=h.canvas.getBoundingClientRect();return [c.left+c.width/2, c.top+c.height*((92+28+9)/h.height)]})()'); pg.touchscreen.tap(pos[0], pos[1]); pg.wait_for_timeout(500); ok(pg.evaluate('!!window.__APP__.attract.settings'), 'the settings button opens Settings', pos); ok(not pg.errs, 'no errors on phone', pg.errs[:3]); ctx.close()\n    if want('party'):\n        ctx = b.new_context(viewport={'width': 800, 'height': 450}); a = ctx.new_page(); c = ctx.new_page(); errs = []\n        for pg in (a, c):\n            pg.on('pageerror', lambda e: errs.append(str(e)))\n            pg.goto(html); pg.wait_for_function('window.__APP__ && window.__PIXEL_ENGINE__', timeout=120000); pg.evaluate('async()=>{window.__e=await window.__PIXEL_READY__;}'); pg.wait_for_function('window.__e.game?.name === \"title\"', timeout=60000)\n        def lobby(pg): pg.evaluate('(()=>{const g=window.__e.game;g.s.focus=g.items().findIndex(i=>i.id===\"shift\")})()'); pg.keyboard.press('Enter'); pg.wait_for_timeout(250)\n        lobby(a); ok(a.evaluate('window.__e.game.sub?.constructor.name') == 'LobbyScreen', 'Night Shift opens the lobby'); a.keyboard.press('ArrowDown'); a.wait_for_timeout(120); a.keyboard.press('Enter'); a.wait_for_timeout(600); ok(a.evaluate('window.__e.game.sub.mode') == 'host', 'host party')\n        lobby(c); c.keyboard.press('ArrowDown'); c.wait_for_timeout(120); c.keyboard.press('ArrowDown'); c.wait_for_timeout(120); c.keyboard.press('Enter'); c.wait_for_timeout(1500); ok(c.evaluate('window.__e.game.sub.S.hosts.size') >= 1, 'the guest lists the host by itself')\n        c.evaluate('window.__e.game.sub.s.focus=0'); c.keyboard.press('Enter'); a.wait_for_function('window.__e.game.sub.S.lobby.length === 2', timeout=20000); ok(True, 'the seat fills')\n        a.evaluate('window.__e.game.sub.s.focus=0'); a.bring_to_front(); a.keyboard.press('Enter'); a.wait_for_function('window.__e.game.name === \"area-shift\" && !window.__APP__.loading', timeout=120000); c.bring_to_front(); c.wait_for_function('window.__e.game.name === \"area-shift\" && !window.__APP__.loading', timeout=120000); ok(True, 'both load the quay')\n        a.bring_to_front(); a.wait_for_function('window.__e.game.session.time() > 1000', timeout=30000); a.wait_for_timeout(2500); ok(a.evaluate('window.__e.game.enemies.length') > 0, 'the host has enemies'); c.bring_to_front(); c.wait_for_timeout(2500); ok(c.evaluate('window.__e.game.ghosts.size') > 0, 'the client sees ghosts', c.evaluate('window.__e.game.ghosts.size'))\n        a.evaluate('window.__e.game.finishRound(true, \"dawn\")'); a.wait_for_timeout(600); c.wait_for_function('!!window.__e.game.results', timeout=20000); ok(True, 'results reach the guest'); ok(a.evaluate('!!window.__e.game.results'), 'results on the host'); ok(not errs, 'no errors in the party', errs[:3]); ctx.close()\n    if want('rtc'):\n        ctx = b.new_context(viewport={'width': 800, 'height': 450}); a = ctx.new_page(); c = ctx.new_page(); errs = []; u = html + '?g_nostun=1'\n        for pg in (a, c):\n            pg.on('pageerror', lambda e: errs.append(str(e)))\n            pg.goto(u); pg.wait_for_function('window.__APP__ && window.__PIXEL_ENGINE__', timeout=120000); pg.evaluate('async()=>{window.__e=await window.__PIXEL_READY__;}'); pg.wait_for_function('window.__e.game?.name === \"title\"', timeout=60000)\n        code = a.evaluate('''async()=>{const {LobbyScreen}=window.__TEST_MODS__||{};const g=window.__e.game;g.s.focus=g.items().findIndex(i=>i.id===\"shift\");return 1}'''); a.keyboard.press('Enter'); a.wait_for_timeout(250); a.keyboard.press('ArrowDown'); a.wait_for_timeout(120); a.keyboard.press('Enter'); a.wait_for_timeout(500)\n        offer = a.evaluate('window.__e.game.sub.S.makeOffer()'); c.evaluate('(()=>{const g=window.__e.game;g.s.focus=g.items().findIndex(i=>i.id===\"shift\")})()'); c.keyboard.press('Enter'); c.wait_for_timeout(250); c.keyboard.press('ArrowDown'); c.wait_for_timeout(100); c.keyboard.press('ArrowDown'); c.wait_for_timeout(100); c.keyboard.press('Enter'); c.wait_for_timeout(400)\n        ok(len(offer) < 8000, 'an invite code is a sane size', len(offer)); c.evaluate('window.__e.game.sub.S.bc?.close(); window.__e.game.sub.S.bc=null'); a.evaluate('window.__e.game.sub.S.bc?.close(); window.__e.game.sub.S.bc=null')\n        ans = c.evaluate('(code)=>window.__e.game.sub.S.answerOffer(code)', offer); ok(len(ans) > 50, 'the guest answers'); a.evaluate('(code)=>window.__e.game.sub.S.acceptAnswer(code)', ans); a.wait_for_function('window.__e.game.sub.S.lobby.length === 2', timeout=20000); ok(True, 'WebRTC seat fills'); a.evaluate('window.__e.game.sub.s.focus=0'); a.bring_to_front(); a.keyboard.press('Enter'); c.wait_for_function('window.__e.game.name === \"area-shift\"', timeout=120000); ok(True, 'the guest starts over WebRTC'); c.bring_to_front(); c.wait_for_timeout(6000); ok(c.evaluate('window.__e.game.ghosts.size') > 0, 'snapshots arrive over WebRTC', c.evaluate('window.__e.game.ghosts.size')); ok(not errs, 'no errors over WebRTC', errs[:3]); ctx.close()\n    b.close()\n    if want('nogpu'):\n        for kind in ('firefox', 'webkit'):\n            br = getattr(p, kind).launch(); pg = br.new_page(); errs = []; pg.on('pageerror', lambda e: errs.append(str(e))); pg.goto(html); pg.wait_for_timeout(5000); t = pg.evaluate('document.body.innerText'); ok('WebGPU' in t or 'webgpu' in t.lower(), f'{kind} shows the clear message', t[:200]); br.close()\n# exit interview\ntry: j = json.load(open(root + '/exit-interview.json')); ok('sourceInformation' in j and 'aiHub' in j, 'exit interview parses')\nexcept Exception as e: ok(False, 'exit interview parses', e)\nprint(f'{P} passed, {F} failed')\nsys.exit(1 if F else 0)\nE\nnode tools/build.mjs | tail -1; timeout 300 python3 tests/browser/browser.py boot pad keys 2>&1 | tail -22 | cut -c1-300","description":"Write browser tests and run boot, pad, keyboard groups","timeout":360000}}}
