{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgknQDK41kBEnVpD2RNBA","type":"message","role":"assistant","content":[{"type":"text","text":"The stop check has a point, and looking again I found more gaps than it listed:\n- The replay test records but never compares.\n- The glyph and slider browser checks are placeholders.\n- There's no reachability check.\n- Some captures are missing.\n- The issue count is an estimate.\n\nI'm also implementing the plan items I'd simplified rather than leaving them disclosed: breakable columns and crate stacks, the harpoon through the chain, and a curved launch route."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":3151,"cache_read_input_tokens":756629,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3151},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76d12802-c986-437e-adae-1ae347966275","uuid":"bad910f4-b777-490d-bb6f-009d5c9c022e","timestamp":"2026-11-06T01:11:32.974Z","request_id":"req_011CgknQD1htTKhS8kTeQ1uc"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgknQDK41kBEnVpD2RNBA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01U4WGNBTUqBA9qAK4X3cgvy","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-162048__xa8053f/work/PresidentEvil4-*/ && npm install --silent 2>&1 | tail -1\npython3 - <<'P'\np='src/game/levelBuild.js';s=open(p).read()\ns=s.replace(\"\"\"const cx = q.x + q.w / 2 - this.W / 2, cz = q.y + q.h / 2 - this.H / 2; P.addStaticBox({ position: [cx, 0.5, cz], halfExtents: [q.w / 2, 0.5, q.h / 2] });\n      meshes.push(texBox(q.w, 1, q.h, cx, 0.5, cz, theme.H)); meshes.push(texBox(q.w + 0.06, 0.1, q.h + 0.06, cx, 0.98, cz, 'rough-boards'));\"\"\",\"\"\"const cx = q.x + q.w / 2 - this.W / 2, cz = q.y + q.h / 2 - this.H / 2, col = P.addStaticBox({ position: [cx, 0.5, cz], halfExtents: [q.w / 2, 0.5, q.h / 2] });\n      const a0 = texBox(q.w, 1, q.h, cx, 0.5, cz, theme.H), b0 = texBox(q.w + 0.06, 0.1, q.h + 0.06, cx, 0.98, cz, 'rough-boards');\n      if (this.def.breakCover && q.w <= (this.def.breakCover) && q.h <= (this.def.breakCover)) { ctx.scene.add(a0, b0); (this.covers ??= []).push({ q, col, meshes: [a0, b0], x: cx, z: cz, broken: false }); } else meshes.push(a0, b0);\"\"\")\ns=s.replace(\"  beltAt(x, z, floor = 0) {\",\"\"\"  /** Low cover that can be smashed: nave columns, yard crate stacks. */\n  coverNear(x, z, r = 0) { return this.covers?.find((c) => !c.broken && Math.abs(x - c.x) <= c.q.w / 2 + r && Math.abs(z - c.z) <= c.q.h / 2 + r) ?? null; }\n  breakCover(c) { if (c.broken) return; c.broken = true; this.ctx.physics.remove(c.col); for (const m of c.meshes) this.ctx.scene.remove(m); for (let y = c.q.y; y < c.q.y + c.q.h; y++) for (let x = c.q.x; x < c.q.x + c.q.w; x++) { this.setNav(x, y, true); this.sight.setOpen(x, y, true); } this.ctx.particles.burst('splinter', [c.x, 0.8, c.z], { count: 30, colors: ['slate', 'mist', 'orange'] }); this.ctx.audio.play('cratebreak', this.area.spatialPlay({ x: c.x, y: 1, z: c.z })); }\n  beltAt(x, z, floor = 0) {\"\"\")\nopen(p,'w').write(s)\np='src/data/levels/chapter2.js';s=open(p).read()\ns=s.replace(\"map: 'yard', title:\",\"map: 'yard', breakCover: 4, title:\")\nopen(p,'w').write(s)\np='src/data/levels/chapter3.js';s=open(p).read()\ns=s.replace(\"map: 'nave', title:\",\"map: 'nave', breakCover: 2, title:\")\nopen(p,'w').write(s)\np='src/game/bosses/bathysphere.js';s=open(p).read()\ns=s.replace(\"const col = L.charAt(nx, nz) === 'H'; if (col) this.shatter(nx, nz);\",\"const cov = L.coverNear(nx, nz, 1.2), col = !!cov; if (cov) L.breakCover(cov);\")\ns=s.replace(\"  shatter(x, z) { const a = this.a, L = a.level; a.ctx.particles.burst('splinter', [x, 1, z], { colors: ['slate', 'mist'], count: 30 }); }\\n\",\"\")\nopen(p,'w').write(s)\np='src/game/bosses/bosun.js';s=open(p).read()\ns=s.replace(\"a.ctx.particles.burst('dust', p.pos, { count: 20 }); for (const P of a.players)\",\"a.ctx.particles.burst('dust', p.pos, { count: 20 }); const cov = a.level.coverNear(p.pos.x, p.pos.z, 1.5); if (cov) a.level.breakCover(cov); for (const P of a.players)\")\ns=s.replace(\"if (wid === 'harpoon' && this.kneel > 0) this.kneel += 3; \",\"\")\ns=s.replace(\"const pelvis = J.Pelvis.getWorldPosition(new THREE.Vector3())\",\"if (this.kneel > 0 && !this.chainHit) { const t = raySphere(o, d, v.set(this.px, 3.6, this.railZ), 0.7); if (t != null) out.push({ t, part: { hit: (dmg, pt, wid) => this.hitChain(pt, wid) } }); }\\n    const pelvis = J.Pelvis.getWorldPosition(new THREE.Vector3())\")\ns=s.replace(\"  hitBody(dmg, pt, wid) {\",\"  /** A harpoon through the chain pins the pallet on him: 3 more seconds. */\\n  hitChain(pt, wid) { const a = this.a; a.ctx.particles.burst('spark', pt); a.ctx.audio.play('chain'); if (wid === 'harpoon') { this.chainHit = true; this.kneel += 3; this.t += 3; } }\\n  hitBody(dmg, pt, wid) {\")\ns=s.replace(\"stagger(t) { this.kneel = t;\",\"stagger(t) { this.chainHit = false; this.kneel = t;\")\nopen(p,'w').write(s)\np='src/game/launch.js';s=open(p).read()\ns=s.replace(\"for (const s of this.scroll) { s.o.position.z -= SPEED * dt;\",\"const bend = Math.cos(this.lt * 0.35) * 4; this.bend = bend; for (const s of this.scroll) { s.o.position.x += bend * dt; if (s.loop && Math.abs(s.o.position.x) > 70) s.o.position.x *= -0.8; s.o.position.z -= SPEED * dt;\")\ns=s.replace(\"this.hull.rotation.z = Math.sin(t * 1.3) * 0.03;\",\"this.hull.rotation.z = Math.sin(t * 1.3) * 0.03 - (this.bend ?? 0) * 0.012;\")\nopen(p,'w').write(s)\n# data cleanup + test hooks\np='src/data/enemies.js';s=open(p).read()\nimport re\ns=re.sub(r\"  ansgar: \\{.*\\n\",\"\",s)\nopen(p,'w').write(s)\np='src/core/app.js';s=open(p).read()\ns=s.replace(\"import { resetTuning } from '../data/tuning.js';\",\"import { resetTuning, TUNING, TUNING_DEFAULT } from '../data/tuning.js';\")\ns=s.replace(\"import { attachDevice, device } from './device.js';\",\"import { attachDevice, device } from './device.js';\\nimport { codeFor, glyphLabel } from './ui.js';\")\ns=s.replace(\"this.factories = {}; }\",\"this.factories = {}; this.test = { TUNING, TUNING_DEFAULT, device, codeFor, glyphLabel: (c) => glyphLabel(c, this.settings.glyphs === 'xbox') }; }\")\nopen(p,'w').write(s)\np='src/core/ui.js';s=open(p).read()\ns=s.replace(\"export function drawGlyph(ui, code, x, y) {\",\"/** What a glyph shows: symbol or letter on the button, or the pill's or keycap's text. */\\nexport function glyphLabel(code, xbox) { if (code in PS) return (xbox ? XB : PS)[code][1]; if (code.startsWith('Pad')) return (xbox ? PILL_XB : PILL_PS)[code] ?? '?'; if (code.startsWith('Mouse')) return code; return KEYNAME[code] ?? code.replace('Key', ''); }\\nexport function drawGlyph(ui, code, x, y) {\")\nopen(p,'w').write(s)\n# tests: replay, chain, cover\np='tests/node/setpieces.mjs';s=open(p).read()\na=s.index(\"// Replay: same input\"); b=s.index(\"done('setpieces');\")\ns=s[:a]+\"\"\"// Breakable cover, the chain.\n{ const N = await loadArea('nave'); const c0 = N.level.covers[0]; ok(N.level.covers.length === 8, 'eight nave columns', N.level.covers.length); ok(!N.navOf(0, 0).isOpen(c0.q.x, c0.q.y), 'a column blocks'); N.level.breakCover(c0); ok(N.navOf(0, 0).isOpen(c0.q.x, c0.q.y), 'a shattered column opens up'); const Y = await loadArea('yard'); Y.player.teleport(Y.level.wx(17), Y.level.wz(24), 0, Math.PI); for (let i = 0; i < 300 && !Y.boss; i++) step(1); const Bo = Y.boss; ok(Y.level.covers.length >= 6, 'yard stacks can break', Y.level.covers?.length); Bo.stagger(8); const k = Bo.kneel; Bo.hitChain(Bo.pos, 'pistol'); ok(Bo.kneel === k, 'only a harpoon pins the chain'); Bo.hitChain(Bo.pos, 'harpoon'); ok(Bo.kneel === k + 3, 'a harpoon through the chain adds 3 s'); }\n// Replay: record 60 s of a siege, replay, compare.\n{ const { Area } = await import('../../src/game/area.js'); const eng = await boot(); const run0 = JSON.stringify(newRun()); const mk = () => new Area(app, 'quay', { jump: 'siege', fromSave: true }); app.run = JSON.parse(run0); await settle(app.load(mk())); for (let i = 0; i < 3600; i++) { const k = ['KeyW', 'KeyA', 'KeyS', 'KeyD'][Math.floor(i / 90) % 4]; for (const c of ['KeyW', 'KeyA', 'KeyS', 'KeyD']) eng.input.setKey(c, c === k); eng.input.setKey('MouseRight', i % 400 > 340); eng.input.setKey('MouseLeft', i % 400 > 360); step(1); if (eng.game.menu) break; } for (const c of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'MouseRight', 'MouseLeft']) eng.input.setKey(c, false); const rec = eng.recording(), fp = eng.fingerprint(), st = eng.game.status(); app.run = JSON.parse(run0); await eng.replay(rec, () => { app.run = JSON.parse(run0); return eng.loadGame(mk()); }); ok(eng.fingerprint() === fp, 'a replayed siege ends the same', `${st} / ${eng.game.status()}`); }\n\"\"\"+s[b:]\nopen(p,'w').write(s)\nP\ncat > tests/node/reach.mjs <<'E'\n// PLAN section 17: every enemy, weapon and item in the data is in the game and reachable in play.\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\nimport { ok, done, boot, loadArea, step, newRun } from './util.mjs';\nimport { ENEMIES } from '../../src/data/enemies.js'; import { ITEMS, combineRecipes } from '../../src/data/items.js'; import { WEAPONS, GRENADES } from '../../src/data/weapons.js'; import { STOCK, CASE_SIZES } from '../../src/data/shop.js'; import { NOTES } from '../../src/data/notes.js'; import { AREAS } from '../../src/data/levels/areas.js'; import { SONGS } from '../../src/audio/songs.js'; import { HUMANS, CREATURES, WEAPON_MODELS, PROPS } from '../../src/models/index.js'; import { CUSTOM_CLIPS } from '../../src/data/clips.js'; import { SFX_DEFS } from '../../src/audio/sfx.js'; import { buy } from '../../src/screens/shop.js';\nawait boot();\nconst src = []; const walk = (d) => { for (const f of readdirSync(d)) { const p = `${d}/${f}`; if (statSync(p).isDirectory()) walk(p); else if (/\\.js$/.test(f)) src.push(readFileSync(p, 'utf8')); } }; walk(new URL('../../src', import.meta.url).pathname); const code = src.join('\\n');\nconst used = (id) => code.split(`'${id}'`).length - 1;\n// Enemies: spawned by a level step or by a system.\nconst spawners = code.match(/(spawn(?:Enemy)?\\(|spawn: \\[|groups: \\[)[^\\n]{0,4000}/g).join(' ');\nfor (const k in ENEMIES) ok(spawners.includes(`'${k}'`), `enemy ${k} is spawned in play`);\n// Weapons: on sale, or the start weapon.\nconst stock = new Set(Object.values(STOCK).flat()); for (const k in WEAPONS) ok(k === 'pistol' || stock.has(k), `weapon ${k} on sale`);\n// Items: on sale, in a chest, on the ground, made by a recipe, or dropped by the director or a boss.\nconst given = new Set(stock); for (const d of Object.values(AREAS)) { for (const t of d.treasure ?? []) given.add(t); for (const g of d.groundItems ?? []) given.add(g[0]); } for (const r of combineRecipes) given.add(r.to); given.add('pistol'); given.add('ammo_pistol'); given.add('coldkey'); given.add('blackpearl');\nok(code.includes(\"{ id: 'coldkey'\"), 'the Flenser drops the key'); ok(code.includes(\"addItem(a.run, 'blackpearl')\"), 'the Bosun drops a Black Pearl');\nfor (const k in ITEMS) ok(given.has(k), `item ${k} can be got`); for (const k of stock) ok(ITEMS[k] || CASE_SIZES[k], `stock ${k} exists`);\nfor (const k in GRENADES) ok(ITEMS[k]?.grenade === k, `grenade ${k} is an item`);\nfor (const r of combineRecipes) for (const f of r.from) ok(given.has(f), `recipe input ${f}`);\n// Buying everything in the last stock works with the biggest Case.\n{ const r = newRun(); r.chapter = 3; r.money = 1e6; r.grid = { w: 14, h: 8 }; for (const k of STOCK[3]) { if (CASE_SIZES[k]) continue; ok(buy(r, k) === 'ok', `can buy ${k}`); } }\n// Notes, songs, sounds, models, clips: all used.\nconst placed = Object.values(AREAS).flatMap((d) => (d.notes ?? []).map((n) => n.id)); for (const k in NOTES) ok(placed.includes(k), `note ${k} placed`);\nfor (const k in SONGS) ok(used(k) > 1 || code.includes(`play(\"${k}\"`), `song ${k} played`);\nfor (const k in SFX_DEFS) ok(new RegExp(`'${k}'`).test(code.replace(/export const SFX_DEFS[\\s\\S]*?\\n};/, '')), `sound ${k} played`);\nconst idsOf = (o) => Object.values(o).map((d) => d.id); const noDefs = code.replace(/export const \\w+ = (?:puppet|model|m|f)\\('[^']+'/g, ''); for (const id of [...idsOf(HUMANS), ...idsOf(CREATURES), ...idsOf(WEAPON_MODELS), ...idsOf(PROPS)]) ok(noDefs.includes(`'${id}'`), `model ${id} placed`);\nfor (const c of CUSTOM_CLIPS) ok(used(c.name) > 0 && code.replace(/name: '[A-Za-z]+'/g, '').replace(/(?:clip|hold)\\('[A-Za-z]+'/g, '').includes(`'${c.name}'`), `clip ${c.name} played`);\n// Every area and teleport loads without error.\nconst { TELEPORTS } = await import('../../src/data/levels/areas.js'); const e = await boot(); for (const t of TELEPORTS) { const a = await loadArea(t.area, { jump: t.jump }); step(30); ok(!e.errors.length, `teleport ${t.label}`, e.errors[0]); }\ndone('reach');\nE\nsed -i \"s/const node = \\['units', 'ai', 'setpieces', 'attract', 'coop', 'playthrough'\\]/const node = ['units', 'reach', 'ai', 'setpieces', 'attract', 'coop', 'playthrough']/\" tools/test.mjs\ntimeout 200 node tests/node/reach.mjs 2>&1 | grep -v \"^file\\|\\`);for\\|^ *\\^$\" | cut -c1-200 | tail -40; timeout 250 node tests/node/setpieces.mjs 2>&1 | grep -v \"^file\\|\\`);for\\|^ *\\^$\"| cut -c1-300 | tail -8","description":"Add breakable cover, chain, curve; write reachability and real replay tests","timeout":500000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":3151,"cache_read_input_tokens":756629,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3151},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76d12802-c986-437e-adae-1ae347966275","uuid":"b5d6e44b-e6e1-4cb7-8605-87af0f173405","timestamp":"2026-11-06T01:12:17.977Z","request_id":"req_011CgknQD1htTKhS8kTeQ1uc","wire_tool_inputs":{"toolu_01U4WGNBTUqBA9qAK4X3cgvy":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-162048__xa8053f/work/PresidentEvil4-*/ && npm install --silent 2>&1 | tail -1\npython3 - <<'P'\np='src/game/levelBuild.js';s=open(p).read()\ns=s.replace(\"\"\"const cx = q.x + q.w / 2 - this.W / 2, cz = q.y + q.h / 2 - this.H / 2; P.addStaticBox({ position: [cx, 0.5, cz], halfExtents: [q.w / 2, 0.5, q.h / 2] });\n      meshes.push(texBox(q.w, 1, q.h, cx, 0.5, cz, theme.H)); meshes.push(texBox(q.w + 0.06, 0.1, q.h + 0.06, cx, 0.98, cz, 'rough-boards'));\"\"\",\"\"\"const cx = q.x + q.w / 2 - this.W / 2, cz = q.y + q.h / 2 - this.H / 2, col = P.addStaticBox({ position: [cx, 0.5, cz], halfExtents: [q.w / 2, 0.5, q.h / 2] });\n      const a0 = texBox(q.w, 1, q.h, cx, 0.5, cz, theme.H), b0 = texBox(q.w + 0.06, 0.1, q.h + 0.06, cx, 0.98, cz, 'rough-boards');\n      if (this.def.breakCover && q.w <= (this.def.breakCover) && q.h <= (this.def.breakCover)) { ctx.scene.add(a0, b0); (this.covers ??= []).push({ q, col, meshes: [a0, b0], x: cx, z: cz, broken: false }); } else meshes.push(a0, b0);\"\"\")\ns=s.replace(\"  beltAt(x, z, floor = 0) {\",\"\"\"  /** Low cover that can be smashed: nave columns, yard crate stacks. */\n  coverNear(x, z, r = 0) { return this.covers?.find((c) => !c.broken && Math.abs(x - c.x) <= c.q.w / 2 + r && Math.abs(z - c.z) <= c.q.h / 2 + r) ?? null; }\n  breakCover(c) { if (c.broken) return; c.broken = true; this.ctx.physics.remove(c.col); for (const m of c.meshes) this.ctx.scene.remove(m); for (let y = c.q.y; y < c.q.y + c.q.h; y++) for (let x = c.q.x; x < c.q.x + c.q.w; x++) { this.setNav(x, y, true); this.sight.setOpen(x, y, true); } this.ctx.particles.burst('splinter', [c.x, 0.8, c.z], { count: 30, colors: ['slate', 'mist', 'orange'] }); this.ctx.audio.play('cratebreak', this.area.spatialPlay({ x: c.x, y: 1, z: c.z })); }\n  beltAt(x, z, floor = 0) {\"\"\")\nopen(p,'w').write(s)\np='src/data/levels/chapter2.js';s=open(p).read()\ns=s.replace(\"map: 'yard', title:\",\"map: 'yard', breakCover: 4, title:\")\nopen(p,'w').write(s)\np='src/data/levels/chapter3.js';s=open(p).read()\ns=s.replace(\"map: 'nave', title:\",\"map: 'nave', breakCover: 2, title:\")\nopen(p,'w').write(s)\np='src/game/bosses/bathysphere.js';s=open(p).read()\ns=s.replace(\"const col = L.charAt(nx, nz) === 'H'; if (col) this.shatter(nx, nz);\",\"const cov = L.coverNear(nx, nz, 1.2), col = !!cov; if (cov) L.breakCover(cov);\")\ns=s.replace(\"  shatter(x, z) { const a = this.a, L = a.level; a.ctx.particles.burst('splinter', [x, 1, z], { colors: ['slate', 'mist'], count: 30 }); }\\n\",\"\")\nopen(p,'w').write(s)\np='src/game/bosses/bosun.js';s=open(p).read()\ns=s.replace(\"a.ctx.particles.burst('dust', p.pos, { count: 20 }); for (const P of a.players)\",\"a.ctx.particles.burst('dust', p.pos, { count: 20 }); const cov = a.level.coverNear(p.pos.x, p.pos.z, 1.5); if (cov) a.level.breakCover(cov); for (const P of a.players)\")\ns=s.replace(\"if (wid === 'harpoon' && this.kneel > 0) this.kneel += 3; \",\"\")\ns=s.replace(\"const pelvis = J.Pelvis.getWorldPosition(new THREE.Vector3())\",\"if (this.kneel > 0 && !this.chainHit) { const t = raySphere(o, d, v.set(this.px, 3.6, this.railZ), 0.7); if (t != null) out.push({ t, part: { hit: (dmg, pt, wid) => this.hitChain(pt, wid) } }); }\\n    const pelvis = J.Pelvis.getWorldPosition(new THREE.Vector3())\")\ns=s.replace(\"  hitBody(dmg, pt, wid) {\",\"  /** A harpoon through the chain pins the pallet on him: 3 more seconds. */\\n  hitChain(pt, wid) { const a = this.a; a.ctx.particles.burst('spark', pt); a.ctx.audio.play('chain'); if (wid === 'harpoon') { this.chainHit = true; this.kneel += 3; this.t += 3; } }\\n  hitBody(dmg, pt, wid) {\")\ns=s.replace(\"stagger(t) { this.kneel = t;\",\"stagger(t) { this.chainHit = false; this.kneel = t;\")\nopen(p,'w').write(s)\np='src/game/launch.js';s=open(p).read()\ns=s.replace(\"for (const s of this.scroll) { s.o.position.z -= SPEED * dt;\",\"const bend = Math.cos(this.lt * 0.35) * 4; this.bend = bend; for (const s of this.scroll) { s.o.position.x += bend * dt; if (s.loop && Math.abs(s.o.position.x) > 70) s.o.position.x *= -0.8; s.o.position.z -= SPEED * dt;\")\ns=s.replace(\"this.hull.rotation.z = Math.sin(t * 1.3) * 0.03;\",\"this.hull.rotation.z = Math.sin(t * 1.3) * 0.03 - (this.bend ?? 0) * 0.012;\")\nopen(p,'w').write(s)\n# data cleanup + test hooks\np='src/data/enemies.js';s=open(p).read()\nimport re\ns=re.sub(r\"  ansgar: \\{.*\\n\",\"\",s)\nopen(p,'w').write(s)\np='src/core/app.js';s=open(p).read()\ns=s.replace(\"import { resetTuning } from '../data/tuning.js';\",\"import { resetTuning, TUNING, TUNING_DEFAULT } from '../data/tuning.js';\")\ns=s.replace(\"import { attachDevice, device } from './device.js';\",\"import { attachDevice, device } from './device.js';\\nimport { codeFor, glyphLabel } from './ui.js';\")\ns=s.replace(\"this.factories = {}; }\",\"this.factories = {}; this.test = { TUNING, TUNING_DEFAULT, device, codeFor, glyphLabel: (c) => glyphLabel(c, this.settings.glyphs === 'xbox') }; }\")\nopen(p,'w').write(s)\np='src/core/ui.js';s=open(p).read()\ns=s.replace(\"export function drawGlyph(ui, code, x, y) {\",\"/** What a glyph shows: symbol or letter on the button, or the pill's or keycap's text. */\\nexport function glyphLabel(code, xbox) { if (code in PS) return (xbox ? XB : PS)[code][1]; if (code.startsWith('Pad')) return (xbox ? PILL_XB : PILL_PS)[code] ?? '?'; if (code.startsWith('Mouse')) return code; return KEYNAME[code] ?? code.replace('Key', ''); }\\nexport function drawGlyph(ui, code, x, y) {\")\nopen(p,'w').write(s)\n# tests: replay, chain, cover\np='tests/node/setpieces.mjs';s=open(p).read()\na=s.index(\"// Replay: same input\"); b=s.index(\"done('setpieces');\")\ns=s[:a]+\"\"\"// Breakable cover, the chain.\n{ const N = await loadArea('nave'); const c0 = N.level.covers[0]; ok(N.level.covers.length === 8, 'eight nave columns', N.level.covers.length); ok(!N.navOf(0, 0).isOpen(c0.q.x, c0.q.y), 'a column blocks'); N.level.breakCover(c0); ok(N.navOf(0, 0).isOpen(c0.q.x, c0.q.y), 'a shattered column opens up'); const Y = await loadArea('yard'); Y.player.teleport(Y.level.wx(17), Y.level.wz(24), 0, Math.PI); for (let i = 0; i < 300 && !Y.boss; i++) step(1); const Bo = Y.boss; ok(Y.level.covers.length >= 6, 'yard stacks can break', Y.level.covers?.length); Bo.stagger(8); const k = Bo.kneel; Bo.hitChain(Bo.pos, 'pistol'); ok(Bo.kneel === k, 'only a harpoon pins the chain'); Bo.hitChain(Bo.pos, 'harpoon'); ok(Bo.kneel === k + 3, 'a harpoon through the chain adds 3 s'); }\n// Replay: record 60 s of a siege, replay, compare.\n{ const { Area } = await import('../../src/game/area.js'); const eng = await boot(); const run0 = JSON.stringify(newRun()); const mk = () => new Area(app, 'quay', { jump: 'siege', fromSave: true }); app.run = JSON.parse(run0); await settle(app.load(mk())); for (let i = 0; i < 3600; i++) { const k = ['KeyW', 'KeyA', 'KeyS', 'KeyD'][Math.floor(i / 90) % 4]; for (const c of ['KeyW', 'KeyA', 'KeyS', 'KeyD']) eng.input.setKey(c, c === k); eng.input.setKey('MouseRight', i % 400 > 340); eng.input.setKey('MouseLeft', i % 400 > 360); step(1); if (eng.game.menu) break; } for (const c of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'MouseRight', 'MouseLeft']) eng.input.setKey(c, false); const rec = eng.recording(), fp = eng.fingerprint(), st = eng.game.status(); app.run = JSON.parse(run0); await eng.replay(rec, () => { app.run = JSON.parse(run0); return eng.loadGame(mk()); }); ok(eng.fingerprint() === fp, 'a replayed siege ends the same', `${st} / ${eng.game.status()}`); }\n\"\"\"+s[b:]\nopen(p,'w').write(s)\nP\ncat > tests/node/reach.mjs <<'E'\n// PLAN section 17: every enemy, weapon and item in the data is in the game and reachable in play.\nimport { readdirSync, readFileSync, statSync } from 'node:fs';\nimport { ok, done, boot, loadArea, step, newRun } from './util.mjs';\nimport { ENEMIES } from '../../src/data/enemies.js'; import { ITEMS, combineRecipes } from '../../src/data/items.js'; import { WEAPONS, GRENADES } from '../../src/data/weapons.js'; import { STOCK, CASE_SIZES } from '../../src/data/shop.js'; import { NOTES } from '../../src/data/notes.js'; import { AREAS } from '../../src/data/levels/areas.js'; import { SONGS } from '../../src/audio/songs.js'; import { HUMANS, CREATURES, WEAPON_MODELS, PROPS } from '../../src/models/index.js'; import { CUSTOM_CLIPS } from '../../src/data/clips.js'; import { SFX_DEFS } from '../../src/audio/sfx.js'; import { buy } from '../../src/screens/shop.js';\nawait boot();\nconst src = []; const walk = (d) => { for (const f of readdirSync(d)) { const p = `${d}/${f}`; if (statSync(p).isDirectory()) walk(p); else if (/\\.js$/.test(f)) src.push(readFileSync(p, 'utf8')); } }; walk(new URL('../../src', import.meta.url).pathname); const code = src.join('\\n');\nconst used = (id) => code.split(`'${id}'`).length - 1;\n// Enemies: spawned by a level step or by a system.\nconst spawners = code.match(/(spawn(?:Enemy)?\\(|spawn: \\[|groups: \\[)[^\\n]{0,4000}/g).join(' ');\nfor (const k in ENEMIES) ok(spawners.includes(`'${k}'`), `enemy ${k} is spawned in play`);\n// Weapons: on sale, or the start weapon.\nconst stock = new Set(Object.values(STOCK).flat()); for (const k in WEAPONS) ok(k === 'pistol' || stock.has(k), `weapon ${k} on sale`);\n// Items: on sale, in a chest, on the ground, made by a recipe, or dropped by the director or a boss.\nconst given = new Set(stock); for (const d of Object.values(AREAS)) { for (const t of d.treasure ?? []) given.add(t); for (const g of d.groundItems ?? []) given.add(g[0]); } for (const r of combineRecipes) given.add(r.to); given.add('pistol'); given.add('ammo_pistol'); given.add('coldkey'); given.add('blackpearl');\nok(code.includes(\"{ id: 'coldkey'\"), 'the Flenser drops the key'); ok(code.includes(\"addItem(a.run, 'blackpearl')\"), 'the Bosun drops a Black Pearl');\nfor (const k in ITEMS) ok(given.has(k), `item ${k} can be got`); for (const k of stock) ok(ITEMS[k] || CASE_SIZES[k], `stock ${k} exists`);\nfor (const k in GRENADES) ok(ITEMS[k]?.grenade === k, `grenade ${k} is an item`);\nfor (const r of combineRecipes) for (const f of r.from) ok(given.has(f), `recipe input ${f}`);\n// Buying everything in the last stock works with the biggest Case.\n{ const r = newRun(); r.chapter = 3; r.money = 1e6; r.grid = { w: 14, h: 8 }; for (const k of STOCK[3]) { if (CASE_SIZES[k]) continue; ok(buy(r, k) === 'ok', `can buy ${k}`); } }\n// Notes, songs, sounds, models, clips: all used.\nconst placed = Object.values(AREAS).flatMap((d) => (d.notes ?? []).map((n) => n.id)); for (const k in NOTES) ok(placed.includes(k), `note ${k} placed`);\nfor (const k in SONGS) ok(used(k) > 1 || code.includes(`play(\"${k}\"`), `song ${k} played`);\nfor (const k in SFX_DEFS) ok(new RegExp(`'${k}'`).test(code.replace(/export const SFX_DEFS[\\s\\S]*?\\n};/, '')), `sound ${k} played`);\nconst idsOf = (o) => Object.values(o).map((d) => d.id); const noDefs = code.replace(/export const \\w+ = (?:puppet|model|m|f)\\('[^']+'/g, ''); for (const id of [...idsOf(HUMANS), ...idsOf(CREATURES), ...idsOf(WEAPON_MODELS), ...idsOf(PROPS)]) ok(noDefs.includes(`'${id}'`), `model ${id} placed`);\nfor (const c of CUSTOM_CLIPS) ok(used(c.name) > 0 && code.replace(/name: '[A-Za-z]+'/g, '').replace(/(?:clip|hold)\\('[A-Za-z]+'/g, '').includes(`'${c.name}'`), `clip ${c.name} played`);\n// Every area and teleport loads without error.\nconst { TELEPORTS } = await import('../../src/data/levels/areas.js'); const e = await boot(); for (const t of TELEPORTS) { const a = await loadArea(t.area, { jump: t.jump }); step(30); ok(!e.errors.length, `teleport ${t.label}`, e.errors[0]); }\ndone('reach');\nE\nsed -i \"s/const node = \\['units', 'ai', 'setpieces', 'attract', 'coop', 'playthrough'\\]/const node = ['units', 'reach', 'ai', 'setpieces', 'attract', 'coop', 'playthrough']/\" tools/test.mjs\ntimeout 200 node tests/node/reach.mjs 2>&1 | grep -v \"^file\\|\\`);for\\|^ *\\^$\" | cut -c1-200 | tail -40; timeout 250 node tests/node/setpieces.mjs 2>&1 | grep -v \"^file\\|\\`);for\\|^ *\\^$\"| cut -c1-300 | tail -8","description":"Add breakable cover, chain, curve; write reachability and real replay tests","timeout":500000}}}
