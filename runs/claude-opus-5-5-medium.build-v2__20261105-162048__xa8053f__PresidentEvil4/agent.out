 'window.__e.game.name === \"area-shift\" && !window.__APP__.loading', 90000), 'solo Night Shift loads'); ok(until(pg, 'window.__e.game.session.time() > 500', 30000), 'the clock runs'); ok(until(pg, 'window.__e.game.enemies.filter(e=>!e.dead).length > 0', 30000), 'waves come'); pg.keyboard.press('Escape'); ok(until(pg, 'window.__e.game.overlay?.constructor.name == \"SettingsScreen\"'), 'Esc opens Settings without pausing'); ok(pg.evaluate('window.__e.timeScale') == 1, 'the world keeps running'); pg.keyboard.press('Escape'); ok(until(pg, '!window.__e.game.overlay'), 'Settings closes'); pg.evaluate('window.__e.game.finishRound(true, \"dawn\")'); ok(until(pg, '!!window.__e.game.results'), 'results screen'); pg.keyboard.press('Enter'); ok(until(pg, 'window.__e.game.name === \"title\"', 60000), 'back to the title'); ok(pg.evaluate('window.__APP__.ui !== null'), 'ui'); ok(not pg.errs, 'no errors solo', pg.errs[:3]); ctx.close()\n    if want('phone'):\"\"\")\nopen(p,'w').write(s)\nP\nnode tools/build.mjs | tail -1; timeout 200 python3 tests/browser/browser.py solo 2>&1 | grep -v \"^  \\|^    \\|Traceback\\|\\^\" | tail -6 | cut -c1-300\nSK=\"A.cutscene&&A.cutscene.skip();A.dialog.active&&A.dialog.skip();A.player.locked=false;A.player.god=true;\"\ntools/caps.sh k43 quay aftermath \"$SK A.ctx.input.setKey('KeyI',true);\" 4 720 540; tools/caps.sh s43 quay aftermath \"$SK A.run.seen.fathom=true; A.talkFathom(A.fathoms[0]);\" 60 720 540; tools/caps.sh d43 quay aftermath \"$SK A.ctx.input.setKey('Escape',true);\" 4 720 540; tools/caps.sh sign cannery \"\" \"$SK A.player.teleport(A.level.wx(23.5),A.level.wz(17),0,Math.PI);A.player.camPitch=0.2;\" 40","description":"Apply polish, add solo test, capture at 4:3","timeout":590000}}}
