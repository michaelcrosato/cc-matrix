{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkemBpfxkqQW938qojTH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UKYe4kCEqsxubu1o8vnonu","name":"Bash","input":{"command":"cat > src/data/clips.js <<'E'\n// New clips on the hero rig (ClipDef data). Rotations in degrees. Negative X on an arm raises it forward.\nimport { gaitClip, HERO_RIG, HERO_CLIPS } from '../../pixel-engine.js';\nconst clip = (name, frames, keys, more = {}) => ({ name, frames, keys, ...more });\nconst hold = (name, pose, frames = 30, more = {}) => clip(name, frames, [[0, pose], [frames, pose]], { loop: true, ...more });\nconst P = (y, r = [0, 0, 0]) => ({ r, p: [0, y, 0], s: 1 });\nconst aimPose = { Torso: [4, 12, 0], Head: [0, -10, 0], ArmR: [-88, 12, 0], ForearmR: [-6, 0, 0], ArmL: [-72, -30, 0], ForearmL: [-34, 0, 0] };\nconst longPose = { Torso: [6, 20, 0], Head: [2, -18, 0], ArmR: [-70, 18, 0], ForearmR: [-36, 0, 0], ArmL: [-82, -22, 0], ForearmL: [-14, 0, 0] };\nconst stance = { LegR: [-8, 0, -4], ShinR: [12, 0, 0], FootR: [-4, 0, 0], LegL: [10, 0, 4], ShinL: [6, 0, 0], Pelvis: P(-0.02) };\nexport const CUSTOM_CLIPS = [\n  // Max\n  hold('AimPistol', { ...aimPose, ...stance }),\n  hold('AimLong', { ...longPose, ...stance }),\n  clip('FirePistol', 6, [[0, { ArmR: [-104, 12, 0], ForearmR: [-14, 0, 0], ArmL: [-84, -30, 0], Torso: [0, 12, 0] }], [6, { ...aimPose }]], { fast: true }),\n  clip('FireLong', 8, [[0, { ...longPose, Torso: [-4, 24, 0], ArmR: [-84, 18, 0] }], [8, { ...longPose }]], { fast: true }),\n  clip('ReloadPistol', 40, [[0, aimPose], [8, { ...aimPose, ArmR: [-50, 10, 0], ForearmR: [-70, 0, 0], ArmL: [-40, -20, 0], ForearmL: [-40, 0, 0], Head: [18, -6, 0] }], [20, { ...aimPose, ArmR: [-50, 10, 0], ForearmR: [-70, 0, 0], ArmL: [-10, 10, 0], ForearmL: [-60, 0, 0], Head: [18, -6, 0] }], [30, { ...aimPose, ArmR: [-50, 10, 0], ForearmR: [-80, 0, 0], ArmL: [-52, -30, 0], ForearmL: [-80, 0, 0], Head: [18, -6, 0] }], [40, aimPose]]),\n  clip('ReloadPump', 40, [[0, longPose], [10, { ...longPose, ArmL: [-40, -10, 0], ForearmL: [-90, 0, 0], Head: [14, -18, 0] }], [20, { ...longPose, ArmL: [-10, 10, 0], ForearmL: [-40, 0, 0] }], [30, { ...longPose, ArmL: [-70, -22, 0], ForearmL: [-40, 0, 0] }], [34, { ...longPose, ArmL: [-90, -22, 0], ForearmL: [-14, 0, 0] }], [40, longPose]]),\n  clip('ReloadBolt', 40, [[0, longPose], [12, { ...longPose, ArmR: [-90, 0, -20], ForearmR: [-60, 0, 0] }], [24, { ...longPose, ArmR: [-60, 30, -20], ForearmR: [-90, 0, 0] }], [40, longPose]]),\n  clip('Roundhouse', 22, [\n    [0, { Pelvis: { r: [0, 0, 0], p: [0, -0.02, 0], s: 1 }, ArmR: [-30, 0, -30], ArmL: [-30, 0, 30] }],\n    [5, { Pelvis: { r: [0, 80, -8], p: [0, -0.02, 0], s: 1 }, Torso: [0, 30, -6], ArmR: [-40, 0, -50], ArmL: [-40, 0, 50], LegR: [-30, 0, -20], ShinR: [80, 0, 0], ShinL: [20, 0, 0] }],\n    [10, { Pelvis: { r: [0, 200, -24], p: [0, 0.04, 0], s: 1 }, Torso: [0, 10, -14], ArmR: [-20, 0, -70], ArmL: [-20, 0, 70], LegR: [-80, 0, -60], ShinR: [8, 0, 0], ShinL: [8, 0, 0] }],\n    [15, { Pelvis: { r: [0, 300, -14], p: [0, 0.02, 0], s: 1 }, Torso: [0, -10, -8], ArmR: [-30, 0, -50], ArmL: [-30, 0, 50], LegR: [-50, 0, -40], ShinR: [40, 0, 0] }],\n    [22, { Pelvis: { r: [0, 360, 0], p: [0, 0, 0], s: 1 } }]], { fast: true }),\n  clip('HipThrow', 24, [[0, { Torso: [20, 0, 0], ArmR: [-70, 0, 0], ArmL: [-70, 0, 0], Pelvis: P(-0.1) , LegR: [-20, 0, 0], ShinR: [40, 0, 0], LegL: [-20, 0, 0], ShinL: [40, 0, 0] }], [10, { Torso: [50, 40, 0], ArmR: [-120, 0, 0], ArmL: [-40, 0, 0], Pelvis: P(-0.14), LegR: [-34, 0, 0], ShinR: [60, 0, 0], LegL: [-34, 0, 0], ShinL: [60, 0, 0] }], [16, { Torso: [40, -40, 0], ArmR: [-20, 0, 0], ArmL: [-90, 0, 0], Pelvis: P(-0.08) }], [24, {}]], { fast: true }),\n  clip('KnifeSlash', 12, [[0, { Torso: [0, -30, 0], ArmR: [-90, -40, -40], ForearmR: [-40, 0, 0] }], [5, { Torso: [8, 34, 0], ArmR: [-80, 40, -10], ForearmR: [-8, 0, 0] }], [12, {}]], { fast: true }),\n  clip('DoorKick', 16, [[0, { Le