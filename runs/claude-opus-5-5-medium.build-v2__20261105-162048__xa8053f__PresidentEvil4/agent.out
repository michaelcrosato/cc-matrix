const s = (wave, freq, freqEnd, decay, volume, more = {}) => ({ wave, freq, freqEnd, decay, volume, ...more });\nexport const SFX_DEFS = {\n  pistol: { ...s('square', 900, 140, 0.09, 0.3, { duty: 0.25 }), layers: [n(9000, 0.11, 0.42), s('triangle', 150, 50, 0.16, 0.5)] },\n  scatter: { ...s('square', 400, 60, 0.18, 0.3), layers: [n(6000, 0.32, 0.6), s('triangle', 110, 36, 0.3, 0.7)] },\n  rifle: { ...s('square', 1500, 110, 0.07, 0.32, { duty: 0.125 }), layers: [n(11000, 0.2, 0.5), s('sine', 90, 44, 0.42, 0.45), n(1500, 0.5, 0.14, { delay: 0.06 })] },\n  harpoon: { ...s('saw', 320, 90, 0.2, 0.3, { vibrato: { depth: 3, rate: 40 } }), layers: [s('triangle', 150, 60, 0.15, 0.5, { delay: 0.05 }), n(3000, 0.06, 0.3)] },\n  dryclick: s('square', 1800, 1500, 0.02, 0.22),\n  reload1: { ...s('square', 1200, 900, 0.03, 0.18), layers: [n(7000, 0.02, 0.14)] },\n  reload2: { ...s('square', 700, 500, 0.04, 0.2), layers: [s('square', 1400, 1200, 0.03, 0.14, { delay: 0.1 })] },\n  reload3: { ...s('square', 500, 380, 0.05, 0.24), layers: [n(5000, 0.03, 0.2), s('square', 1000, 800, 0.03, 0.2, { delay: 0.14 })] },\n  kickwhoosh: { ...n(1800, 0.2, 0.24, { attack: 0.05 }), layers: [s('sine', 300, 140, 0.2, 0.14)] },\n  kickhit: { ...s('triangle', 190, 44, 0.2, 0.75), layers: [n(2600, 0.1, 0.44)] },\n  knife: { ...n(9000, 0.09, 0.26, { attack: 0.02 }), layers: [s('square', 2200, 1200, 0.05, 0.08)] },\n  bodyhit: { ...s('triangle', 240, 80, 0.08, 0.5), layers: [n(1800, 0.06, 0.3)] },\n  headpop: { ...s('sine', 620, 110, 0.14, 0.5), layers: [n(3200, 0.2, 0.46), s('triangle', 90, 40, 0.2, 0.5)] },\n  armorping: { ...s('square', 2400, 1900, 0.09, 0.2, { duty: 0.125 }), layers: [s('sine', 3600, 3000, 0.16, 0.12)] },\n  grunt: { ...s('saw', 150, 90, 0.16, 0.28), layers: [n(900, 0.1, 0.1)] },\n  dyegrunt: { ...s('saw', 170, 60, 0.4, 0.3, { vibrato: { depth: 1, rate: 12 } }), layers: [n(700, 0.3, 0.1)] },\n  doorkick: { ...s('triangle', 130, 50, 0.2, 0.7), layers: [n(1200, 0.24, 0.5), s('square', 240, 90, 0.08, 0.18)] },\n  glass: { ...n(14000, 0.3, 0.36), layers: [s('sine', 3400, 2600, 0.14, 0.18), s('sine', 5200, 4400, 0.2, 0.14, { delay: 0.05 })] },\n  ladder: { ...s('square', 320, 240, 0.05, 0.16), layers: [s('square', 280, 210, 0.05, 0.14, { delay: 0.25 }), s('square', 300, 220, 0.05, 0.14, { delay: 0.5 })] },\n  ladderfall: { ...s('triangle', 160, 60, 0.3, 0.5), layers: [n(1500, 0.4, 0.4)] },\n  cratebreak: { ...n(2200, 0.22, 0.46), layers: [s('square', 300, 90, 0.1, 0.18)] },\n  barrel: { ...s('triangle', 120, 28, 0.7, 0.9), layers: [n(4000, 0.7, 0.75), s('saw', 80, 30, 0.5, 0.4)] },\n  flare: { ...n(11000, 1.0, 0.32, { attack: 0.05 }), layers: [s('sine', 2800, 5200, 0.4, 0.1)] },\n  depthcharge: { ...s('sine', 70, 22, 1.0, 0.95), layers: [n(2400, 0.7, 0.7), s('triangle', 200, 40, 0.3, 0.4)] },\n  bottle: { ...n(10000, 0.2, 0.3), layers: [s('sine', 4200, 3400, 0.1, 0.14), n(1400, 0.6, 0.3, { delay: 0.04 })] },\n  fireloop: { ...n(800, 0.5, 0.12, { attack: 0.2, sustain: 1 }) },\n  tannoyon: { ...n(5000, 0.14, 0.14), layers: [s('square', 120, 118, 0.2, 0.08, { crush: 4 })] },\n  tannoyoff: { ...s('square', 900, 90, 0.2, 0.2, { crush: 4 }), layers: [n(7000, 0.3, 0.26)] },\n  tannoybreak: { ...s('saw', 1800, 80, 0.32, 0.3, { crush: 4 }), layers: [n(9000, 0.32, 0.4), s('square', 3000, 2000, 0.05, 0.16, { delay: 0.1 })] },\n  foghorn: { ...s('saw', 66, 58, 3.2, 0.8, { attack: 0.5, sustain: 2.4 }), layers: [s('saw', 49.5, 46, 3.4, 0.7, { attack: 0.6, sustain: 2.4 }), s('square', 99, 92, 3, 0.26, { attack: 0.7, sustain: 2, duty: 0.25 }), s('sine', 33, 31, 3.6, 0.95, { attack: 0.8, sustain: 2.6 }), n(120, 3.4, 0.22, { attack: 1, sustain: 2 })] },\n  sawloop: { wave: 'saw', freq: 110, decay: 0.8, attack: 0.05, sustain: 1, volume: 0.42, vibrato: { depth: 1.2, rate: 34 }, layers: [{ wave: 'noise', freq: 2400, decay: 0.8, sustain: 1, volume: 0.16 }, { wave: 'square', freq: 220, decay: 0.8, sustain: 1, volume: 0.09, vibrato: { depth: 2, rate: 34 } }] },\n  sawswing: { ...s('saw', 180, 420, 0.4, 0.5, { vibrato: { depth: 2, rate: 40 } }), layers: [n(5000, 0.3, 0.3)] },\n  steam: { ...n(7000, 0.9, 0.34, { attack: 0.05, sustain: 0.3 }) },\n  rain: { ...n(12000, 1, 0.13, { sustain: 1, attack: 0.3 }) },\n  sea: { ...n(400, 2.2, 0.2, { attack: 1, sustain: 0.8 }) },\n  gull: { ...s('sine', 1500, 980, 0.34, 0.1, { vibrato: { depth: 1.4, rate: 22 } }), layers: [s('sine', 1300, 860, 0.3, 0.08, { delay: 0.32, vibrato: { depth: 1.4, rate: 22 } })] },\n  conveyor: { wave: 'square', freq: 60, decay: 0.6, sustain: 1, volume: 0.1, duty: 0.125, vibrato: { depth: 1, rate: 9 }, layers: [{ wave: 'noise', freq: 900, decay: 0.6, sustain: 1, volume: 0.06 }] },\n  crane: { ...s('saw', 90, 120, 0.8, 0.22, { vibrato: { depth: 1, rate: 8 } }), layers: [s('square', 700, 640, 0.1, 0.06)] },\n  chain: { ...s('square', 2400, 1800, 0.04, 0.15, { duty: 0.125 }), layers: [s('square', 2100, 1600, 0.04, 0.14, { delay: 0.07, duty: 0.125 }), s('square', 2500, 1900, 0.04, 0.12, { delay: 0.15, duty: 0.125 })] },\n  palletdrop: { ...s('triangle', 90, 24, 0.8, 0.9), layers: [n(1600, 0.5, 0.6), s('square', 1400, 900, 0.12, 0.2)] },\n  telegraph: { ...s('square', 1400, 1400, 0.03, 0.14), layers: [s('square', 1400, 1400, 0.03, 0.14, { delay: 0.1 }), s('square', 1400, 1400, 0.09, 0.14, { delay: 0.2 }), s('square', 1400, 1400, 0.03, 0.14, { delay: 0.36 })] },\n  bubble: { ...s('sine', 300, 900, 0.1, 0.24), layers: [s('sine', 420, 1100, 0.09, 0.16, { delay: 0.12 })] },\n  bubbleloop: { wave: 'sine', freq: 180, decay: 0.8, sustain: 1, volume: 0.1, vibrato: { depth: 8, rate: 7 } },\n  uimove: s('square', 780, 780, 0.03, 0.12, { duty: 0.25 }),\n  uiconfirm: { ...s('square', 660, 660, 0.05, 0.16, { duty: 0.25 }), layers: [s('square', 990, 990, 0.08, 0.16, { delay: 0.05, duty: 0.25 })] },\n  uiback: s('square', 520, 330, 0.08, 0.14, { duty: 0.25 }),\n  uideny: s('square', 180, 150, 0.12, 0.2),\n  stamp: { ...s('triangle', 140, 42, 0.22, 0.85), layers: [n(1000, 0.12, 0.45), s('square', 90, 50, 0.08, 0.2)] },\n  qtepop: { ...s('square', 880, 1320, 0.08, 0.22, { duty: 0.25 }), layers: [n(8000, 0.03, 0.1)] },\n  qtefail: s('saw', 200, 70, 0.3, 0.3),\n  heartbeat: { ...s('sine', 62, 40, 0.14, 0.75), layers: [s('sine', 52, 36, 0.16, 0.6, { delay: 0.2 })] },\n  skitter: { ...n(6000, 0.04, 0.16), layers: [n(7000, 0.03, 0.14, { delay: 0.05 }), n(5000, 0.04, 0.14, { delay: 0.11 })] },\n  pickup: { ...s('triangle', 640, 640, 0.06, 0.22), layers: [s('triangle', 960, 960, 0.1, 0.22, { delay: 0.06 })] },\n  coins: { ...s('square', 1600, 1600, 0.05, 0.12, { duty: 0.25 }), layers: [s('square', 2100, 2100, 0.08, 0.12, { delay: 0.05, duty: 0.25 })] },\n  hurtmax: { ...s('saw', 240, 120, 0.2, 0.4), layers: [n(2000, 0.1, 0.3)] },\n  sting: { ...s('saw', 110, 55, 1.2, 0.5, { attack: 0.01 }), layers: [s('saw', 116.5, 58, 1.2, 0.45), s('square', 220, 110, 1, 0.2)] },\n  splash: { ...n(4000, 0.5, 0.4, { attack: 0.02 }), layers: [s('sine', 240, 90, 0.2, 0.3)] },\n  rumble: { ...s('sine', 44, 30, 2.4, 0.9, { attack: 0.3, sustain: 1 }), layers: [n(180, 2.4, 0.42, { attack: 0.4, sustain: 1 })] },\n  gatewheel: { ...s('square', 230, 200, 0.12, 0.2), layers: [s('square', 200, 180, 0.12, 0.18, { delay: 0.2 })] },\n  bellow: { ...s('saw', 60, 42, 1.3, 0.75, { attack: 0.1, sustain: 0.4, vibrato: { depth: 1, rate: 7 } }), layers: [n(300, 1.2, 0.2), s('square', 90, 62, 1.2, 0.2)] },\n  whistle: { ...s('sine', 1200, 2200, 0.8, 0.3, { vibrato: { depth: 1, rate: 22 } }) },\n  brass: { ...s('triangle', 300, 200, 0.2, 0.5), layers: [s('square', 700, 500, 0.15, 0.2), n(4000, 0.2, 0.3)] },\n  horndrop: { ...s('sine', 40, 28, 1.6, 0.7, { attack: 0.3 }) },\n};\nexport function registerSfx(audio) { for (const k in SFX_DEFS) audio.register(k, SFX_DEFS[k]); }\nE\ncat > src/audio/songs.js <<'E'\n// Original compositions, Song data. Authored loud (0.5-0.8) so they carry at the default 10 percent music volume.\nconst r = (s, n) => Array(n).fill(s).join(' ');\nconst drone = { wave: 'saw', attack: 0.3, decay: 1.2, volume: 0.42 }, bell = { wave: 'triangle', decay: 1.5, volume: 0.66 }, pluck = { wave: 'triangle', decay: 0.36, volume: 0.75 };\nconst sq = { wave: 'square', duty: 0.25, decay: 0.16, volume: 0.42 }, bass = { wave: 'square', duty: 0.5, decay: 0.2, volume: 0.6 }, hat = { wave: 'noise', decay: 0.04, volume: 0.28 }, kick = { wave: 'triangle', decay: 0.14, volume: 0.9 }, snare = { wave: 'noise', decay: 0.12, volume: 0.42 };\nexport const SONGS = {\n  title: { bpm: 66, stepsPerBeat: 2, tracks: { drone, bell, lead: { wave: 'triangle', decay: 0.9, volume: 0.52 } }, patterns: {\n    a: { drone: 'D2 - - - - - - - A1 - - - - - - -', bell: 'D3 . . . . . . . . . . . A2 . . .', lead: '. . . . F4 . E4 . . . D4 . . . . .' },\n    b: { drone: 'Bb1 - - - - - - - A1 - - - - - - -', bell: 'D3 . . . . . . . Bb2 . . . A2 . . .', lead: '. . A4 . G4 . F4 . . . E4 . . . C#4 .' } }, order: ['a', 'a', 'b', 'a'] },\n  explore: { bpm: 72, tracks: { bass: pluck, lead: { wave: 'triangle', decay: 0.7, volume: 0.42 }, air: { wave: 'noise', decay: 0.5, attack: 0.1, volume: 0.05 } }, patterns: {\n    a: { bass: 'A1 . . . . . . . . . . . E2 . . . A1 . . . . . . . . . . . . . . .', lead: r('.', 32), air: 'C7 ' + r('.', 31) },\n    b: { bass: 'A1 . . . . . . . . . . . E2 . . . F1 . . . . . . . E1 . . . . . . .', lead: '. . . . C4 . . . B3 . . . . . . . . . . . E4 . . . D#4 . . . . . . .', air: 'C7 ' + r('.', 31) } }, order: ['a', 'b', 'a', 'a', 'b'] },\n  combat: { bpm: 132, tracks: { o: sq, bass, hat, kick, sn: snare }, patterns: {\n    a: { o: 'E3 E3 G3 E3 B3 E3 G3 E3 E3 E3 G3 E3 C4 B3 G3 E3', bass: 'E2 . . E2 . . E2 . E2 . . E2 . . G2 .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8', kick: 'C2 . . . . . C2 . C2 . . . . . C2 .', sn: '. . . . C6 . . . . . . . C6 . . .' },\n    b: { o: 'C3 C3 E3 C3 G3 C3 E3 C3 B2 B2 D#3 B2 F#3 B2 D#3 F#3', bass: 'C2 . . C2 . . C2 . B1 . . B1 . . B1 .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8', kick: 'C2 . . . . . C2 . C2 . . . . . C2 .', sn: '. . . . C6 . . . . . . . C6 . C6 .' } }, order: ['a', 'a', 'b', 'a'] },\n  siege: { bpm: 120, tracks: { bass, kick, sn: snare, chant: { wave: 'saw', attack: 0.04, decay: 0.3, volume: 0.42, vibrato: { depth: 0.4, rate: 5 } }, chant2: { wave: 'square', duty: 0.25, attack: 0.04, decay: 0.3, volume: 0.26 } }, patterns: {\n    a: { bass: 'D2 . . . D2 . . . F2 . . . E2 . . .', kick: 'C2 . . C2 . . C2 . C2 . . C2 . . C2 .', sn: '. . . . C6 . . . . . . . C6 . . .', chant: 'D3 . D3 . F3 . D3 . . . E3 . D3 . . .', chant2: 'A2 . A2 . C3 . A2 . . . B2 . A2 . . .' },\n    b: { bass: 'Bb1 . . . Bb1 . . . A1 . . . A1 . . .', kick: 'C2 . . C2 . . C2 . C2 . C2 C2 . . C2 .', sn: '. . . . C6 . . . . . . . C6 . C6 .', chant: 'F3 . F3 . G3 . F3 . E3 . E3 . C#3 . . .', chant2: 'D3 . D3 . D3 . D3 . C#3 . C#3 . A2 . . .' } }, order: ['a', 'a', 'b', 'a'] },\n  shop: { bpm: 104, tracks: { acc: { wave: 'square', duty: 0.25, decay: 0.2, volume: 0.42, vibrato: { depth: 0.18, rate: 9 } }, acc2: { wave: 'square', duty: 0.5, decay: 0.2, volume: 0.22, vibrato: { depth: 0.3, rate: 7 } }, oom: { wave: 'triangle', decay: 0.18, volume: 0.7 }, pah: { wave: 'square', duty: 0.25, decay: 0.08, volume: 0.22 } }, patterns: {\n    a: { acc: 'G4 . B4 . D5 . B4 . A4 . C5 . E5 . C5 .', acc2: 'D4 . G4 . B4 . G4 . F#4 . A4 . C5 . A4 .', oom: 'G2 . . . D2 . . . D2 . . . A2 . . .', pah: '. . G3 . . . B3 . . . F#3 . . . C4 .' },\n    b: { acc: 'B4 . D5 . G5 . D5 . E5 D5 C5 . A4 . F#4 .', acc2: 'G4 . B4 . D5 . B4 . C5 B4 A4 . F#4 . D4 .', oom: 'G2 . . . B2 . . . C3 . . . D3 . . .', pah: '. . D4 . . . D4 . . . E4 . . . F#4 .' } }, order: ['a', 'b', 'a', 'b'] },\n  safe: { bpm: 60, stepsPerBeat: 2, tracks: { ch: { wave: 'triangle', attack: 0.1, decay: 1.4, volume: 0.48 }, ch2: { wave: 'triangle', attack: 0.1, decay: 1.4, volume: 0.36 }, tick: { wave: 'square', duty: 0.125, decay: 0.03, volume: 0.06 } }, patterns: {\n    a: { ch: 'E4 . . . D4 . . . C4 . . . D4 . . .', ch2: 'C3 . . . G2 . . . A2 . . . G2 . . .', tick: 'C6 . C6 C6 . . C6 . C6 . . C6 C6 . . .' } }, order: ['a'] },\n  boss: { bpm: 150, tracks: { brass: { wave: 'saw', attack: 0.01, decay: 0.2, volume: 0.42 }, bass, toll: { wave: 'triangle', decay: 1, volume: 0.62 }, hat, kick, sn: snare }, patterns: {\n    a: { brass: 'C4 . C4 Eb4 . C4 G4 . F4 . Eb4 . D4 . B3 .', bass: 'C2 C2 . C2 C2 . C2 . Ab1 Ab1 . Ab1 G1 . G1 .', toll: 'C3 . . . . . . . . . . . . . . .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', kick: 'C2 . . C2 . . C2 . C2 . . C2 . . C2 .', sn: '. . . . C6 . . . . . . . C6 . . .' },\n    b: { brass: 'Ab4 . G4 F4 . Eb4 F4 . G4 . C5 . B4 . G4 .', bass: 'F1 F1 . F1 F1 . F1 . G1 G1 . G1 G1 . B1 .', toll: 'C3 . . . . . . . . . . . . . . .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', kick: 'C2 . . C2 . . C2 . C2 . . C2 . C2 C2 .', sn: '. . . . C6 . . . . . . . C6 . C6 C6' } }, order: ['a', 'a', 'b', 'a'] },\n  onhold: { bpm: 96, tracks: { vib: { wave: 'sine', decay: 0.5, volume: 0.75, vibrato: { depth: 0.2, rate: 6 } }, pad: { wave: 'triangle', attack: 0.05, decay: 0.6, volume: 0.42 }, bass: { wave: 'triangle', decay: 0.26, volume: 0.62 }, tick: { wave: 'noise', decay: 0.02, volume: 0.1 } }, patterns: {\n    a: { vib: 'E5 . G5 . A5 . G5 E5 . . D5 . E5 . C5 .', pad: 'C4 . . . E4 . . . F4 . . . G4 . . .', bass: 'C3 . . . G2 . . . F2 . . . G2 . . .', tick: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' },\n    b: { vib: 'A5 . C6 . A5 G5 E5 . D5 E5 F5 . E5 . D5 .', pad: 'A3 . . . C4 . . . D4 . . . G3 . . .', bass: 'A2 . . . E2 . . . D2 . . . G2 . . .', tick: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .' } }, order: ['a', 'b'] },\n  tide: { bpm: 112, tracks: { b: bass, o: { wave: 'square', duty: 0.125, decay: 0.14, volume: 0.32 }, hat, kick }, patterns: {\n    a: { b: 'A1 . A1 . A1 . A1 . A1 . A1 . A1 . A1 .', o: 'E4 . . E4 F4 . . . E4 . . E4 F4 . G4 .', hat: 'C8 . . . C8 . . . C8 . . . C8 . C8 .', kick: 'C2 . . . . . . . C2 . . . . . . .' },\n    b: { b: 'Bb1 . Bb1 . Bb1 . Bb1 . Bb1 . Bb1 . Bb1 . Bb1 .', o: 'F4 . . F4 Gb4 . . . F4 . . F4 Gb4 . Ab4 .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', kick: 'C2 . . . C2 . . . C2 . . . C2 . . .' },\n    c: { b: 'B1 . B1 . B1 . B1 . B1 . B1 . B1 . B1 .', o: 'F#4 . . F#4 G4 . . . F#4 . . F#4 G4 . A4 .', hat: 'C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8 C8', kick: 'C2 . C2 . C2 . C2 . C2 . C2 . C2 . C2 .' } }, order: ['a', 'a', 'b', 'b', 'c', 'c'] },\n  dawn: { bpm: 80, stepsPerBeat: 2, loop: false, tracks: { h: { wave: 'triangle', attack: 0.1, decay: 1.8, volume: 0.6 }, b: { wave: 'triangle', attack: 0.1, decay: 2, volume: 0.48 } }, patterns: {\n    a: { h: 'A4 . . . C#5 . . . E5 . . . . . . .', b: 'A2 . . . E3 . . . A3 . . . . . . .' }, b: { h: 'F#5 . . . E5 . . . E5 - - - - - - -', b: 'D3 . . . E3 . . . A2 - - - - - - -' } }, order: ['a', 'b'] },\n};\nE\ncat > src/audio/voice.js <<'E'\n// Animalese-style gibberish: one syllable every 2 letters. Same word, same pitch. Falls at '.', rises at '?', louder at '!'.\nconst hashWord = (w) => { let h = 7; for (let i = 0; i < w.length; i++) h = (h * 31 + w.charCodeAt(i)) | 0; return Math.abs(h); };\nconst RECIPES = {\n  MAX: { wave: 'triangle', freq: 170, decay: 0.06, volume: 0.42 },\n  DAME: { wave: 'square', duty: 0.25, freq: 320, decay: 0.05, volume: 0.28, vibrato: { depth: 1, rate: 22 } },\n  COMMODORE: { wave: 'square', freq: 260, decay: 0.07, volume: 0.28, crush: 8, layers: [{ wave: 'noise', freq: 5000, decay: 0.05, volume: 0.05 }] },\n  FATHOM: { wave: 'triangle', freq: 110, decay: 0.14, volume: 0.5 },\n  PYM: { wave: 'sine', freq: 200, decay: 0.06, volume: 0.46, crush: 6 },\n  ISLANDER: { wave: 'saw', freq: 120, decay: 0.09, volume: 0.28 },\n  MONK: { wave: 'sine', freq: 90, decay: 0.2, volume: 0.32, layers: [{ wave: 'sine', freq: 135, decay: 0.2, volume: 0.22 }, { wave: 'sine', freq: 180, decay: 0.2, volume: 0.16 }] },\n  BOSUN: { wave: 'saw', freq: 60, decay: 0.4, volume: 0.5 },\n};\nconst VOWELS = [1, 0.93, 1.06, 0.88, 1.12];\nconst CONS = [{ wave: 'noise', freq: 7000, decay: 0.012, volume: 0.1 }, { wave: 'square', freq: 600, freqEnd: 300, decay: 0.012, volume: 0.06 }];\nexport const VOICE_MAP = { MAX: 'MAX', DAME: 'DAME', COMMODORE: 'COMMODORE', FATHOM: 'FATHOM', PYM: 'PYM', NILS: 'ISLANDER', MENDER: 'ISLANDER', ANSGAR: 'ISLANDER', ISLANDER: 'ISLANDER', MONK: 'MONK', BOSUN: 'BOSUN' };\nexport function registerVoices(audio) {\n  for (const sp in RECIPES) for (let v = 0; v < 5; v++) for (let c = 0; c < 2; c++) {\n    const base = RECIPES[sp];\n    audio.register(`v_${sp}_${v}_${c}`, { ...base, freq: base.freq * VOWELS[v], layers: [...(base.layers || []), CONS[c]] });\n  }\n  audio.register('v_bubble', { wave: 'sine', freq: 300, freqEnd: 800, decay: 0.07, volume: 0.2 });\n}\n/** Voices one line of text as it types: call tick(n) with the number of characters shown so far. */\nexport class VoiceLine {\n  constructor(audio, who, text, gain = () => 1) { this.audio = audio; this.sp = VOICE_MAP[who] || 'ISLANDER'; this.text = text; this.gain = gain; this.i = 0; this.count = 0; }\n  tick(shown) {\n    while (this.i < shown && this.i < this.text.length) {\n      const ch = this.text[this.i];\n      if (/[A-Za-z0-9]/.test(ch) && this.i % 2 === 0) {\n        let a = this.i, b = this.i;\n        while (a > 0 && /\\w/.test(this.text[a - 1])) a--;\n        while (b < this.text.length && /\\w/.test(this.text[b])) b++;\n        const word = this.text.slice(a, b).toLowerCase(), h = hashWord(word);\n        const rest = this.text.slice(b); const end = rest[0];\n        let pitch = (h % 7) - 3, vol = 1;\n        if (end === '.' ) pitch -= 3; if (end === '?') pitch += 4; if (end === '!') vol = 1.3;\n        if (this.sp === 'PYM') pitch = 0;\n        if (this.sp === 'COMMODORE') vol *= 1.1;\n        this.audio.play(`v_${this.sp}_${(h + this.i) % 5}_${(this.i >> 1) % 2}`, { pitch, volume: Math.min(1, vol * this.gain()) });\n        this.count++;\n        if (this.sp === 'FATHOM' && this.count % 5 === 0) this.audio.play('v_bubble', { volume: this.gain(), pitch: (h % 5) });\n      }\n      this.i++;\n    }\n  }\n}\nexport function bark(audio, who, text, o = {}, gain = 1) { const sp = VOICE_MAP[who] || 'ISLANDER'; const h = hashWord(text); audio.play(`v_${sp}_${h % 5}_${h % 2}`, { pitch: (h % 5) - 2, volume: (o.volume ?? 1) * gain, pan: o.pan ?? 0 }); }\nE\ncat > src/audio/mix.js <<'E'\n// Fades between songs. Silence is part of the score.\nimport { SONGS } from './songs.js';\nexport class Mix {\n  constructor(app) { this.app = app; this.current = null; this.scale = 1; this.fade = null; }\n  /** Play a song by name (null: silence), fading through the user's level. */\n  play(name, fade = 0.6) { if (name === this.current && !this.fade) return; this.fade = { to: name, t: 0, dur: fade, phase: this.current ? 'out' : 'in' }; if (!this.current) this._swap(name); }\n  _swap(name) { const a = this.app.engine.audio; this.current = name; if (name) a.playMusic(SONGS[name], name); else a.stopMusic(); }\n  update(dt) {\n    if (!this.fade) return;\n    const f = this.fade; f.t += dt;\n    const k = Math.min(1, f.t / Math.max(0.01, f.dur));\n    if (f.phase === 'out') { this.setScale(1 - k); if (k >= 1) { this._swap(f.to); f.phase = 'in'; f.t = 0; } } else { this.setScale(k); if (k >= 1) { this.fade = null; this.setScale(1); } }\n  }\n  setScale(s) { this.scale = s; this.app.engine.audio.setVolume('music', this.app.settings.music * s); }\n  stop() { this.fade = null; this.current = null; const a = this.app.engine.audio; a.stopMusic(); }\n}\nE\ncat \"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build-v2__20261105-162048__xa8053f/tmp/claude-1000/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build-v2--20261105-162048--xa8053f-work/76d12802-c986-437e-adae-1ae347966275/tasks/br8csve2l.output\" | cut -c1-260 | tail -30","description":"Write clips, sound effects, songs, voices, music mixer"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26883,"cache_read_input_tokens":195289,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26883},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76d12802-c986-437e-adae-1ae347966275","uuid":"7f054bb6-6957-40c3-97c3-0147314f41d0","timestamp":"2026-11-05T23:33:48.045Z","request_id":"req_011CgkemBb2RxpYSE29JccnY","wire_tool_inputs":{"toolu_01UKYe4kCEqsxubu1o8vnonu":{"command":"cat > src/data/clips.js <<'E'\n// New clips on the hero rig (ClipDef data). Rotations in degrees. Negative X on an arm raises it forward.\nimport { gaitClip, HERO_RIG, HERO_CLIPS } from '../../pixel-engine.js';\nconst clip = (name, frames, keys, more = {}) => ({ name, frames, keys, ...more });\nconst hold = (name, pose, frames = 30, more = {}) => clip(name, frames, [[0, pose], [frames, pose]], { loop: true, ...more });\nconst P = (y, r = [0, 0, 0]) => ({ r, p: [0, y, 0], s: 1 });\nconst aimPose = { Torso: [4, 12, 0], Head: [0, -10, 0], ArmR: [-88, 12, 0], ForearmR: [-6, 0, 0], ArmL: [-72, -30, 0], ForearmL: [-34, 0, 0] };\nconst longPose = { Torso: [6, 20, 0], Head: [2, -18, 0], ArmR: [-70, 18, 0], ForearmR: [-36, 0, 0], ArmL: [-82, -22, 0], ForearmL: [-14, 0, 0] };\nconst stance = { LegR: [-8, 0, -4], ShinR: [12, 0, 0], FootR: [-4, 0, 0], LegL: [10, 0, 4], ShinL: [6, 0, 0], Pelvis: P(-0.02) };\nexport const CUSTOM_CLIPS = [\n  // Max\n  hold('AimPistol', { ...aimPose, ...stance }),\n  hold('AimLong', { ...longPose, ...stance }),\n  clip('FirePistol', 6, [[0, { ArmR: [-104, 12, 0], ForearmR: [-14, 0, 0], ArmL: [-84, -30, 0], Torso: [0, 12, 0] }], [6, { ...aimPose }]], { fast: true }),\n  clip('FireLong', 8, [[0, { ...longPose, Torso: [-4, 24, 0], ArmR: [-84, 18, 0] }], [8, { ...longPose }]], { fast: true }),\n  clip('ReloadPistol', 40, [[0, aimPose], [8, { ...aimPose, ArmR: [-50, 10