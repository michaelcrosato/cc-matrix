{ CAM };\nE\ncat > src/game/qte.js <<'E'\n// Quick-time events: a large glyph in a shrinking ring. Read from the Intent so bots and players share it.\nimport { TUNING } from '../data/tuning.js';\nexport class QTE {\n  constructor(area) { this.area = area; this.active = false; this.opt = null; this.t = 0; this.fill = 0; this.count = 0; this.queue = []; }\n  /** type: press | mash | alternate. button: action or dodge. */\n  start(o) { if (this.active) { this.queue.push(o); return; } this.opt = o; this.owner = o.owner ?? this.area.player; this.active = true; this.t = o.time ?? TUNING.qteWindow; this.max = this.t; this.fill = 0; this.want = 0; const A = this.area; this.savedScale = A.ctx.engine.timeScale; if (o.slow !== false) A.ctx.engine.timeScale = 0.5; A.ctx.audio.play('qtepop'); }\n  feed(i) {\n    const o = this.opt, pressAction = i.action, pressDodge = i.dodge; i.action = false; i.dodge = false; i.knife = false; i.reload = false; i.command = false; i.heal = false; i.throw = false; i.turn = false;\n    if (o.type === 'press') { const hit = o.button === 'dodge' ? pressDodge : pressAction, wrong = o.button === 'dodge' ? pressAction : pressDodge; if (hit) this.finish(true); else if (wrong && o.strict) this.finish(false); }\n    else if (o.type === 'mash') { if (pressAction || pressDodge) { this.fill += 1; this.area.ctx.audio.play('uimove'); } }\n    else if (o.type === 'alternate') { const w = this.want === 0 ? pressAction : pressDodge; if (w) { this.fill += 1; this.want = 1 - this.want; this.area.ctx.audio.play('uimove'); } }\n    this.tickFill = true;\n  }\n  fixed(dt) {\n    if (!this.active) return; const o = this.opt; this.t -= dt; o.onTick?.(dt);\n    if (o.type !== 'press') { this.fill = Math.max(0, this.fill - (o.drain ?? 0) * dt); if (this.fill >= (o.fill ?? 8)) { this.finish(true); return; } }\n    if (this.t <= 0) this.finish(o.type !== 'press' && o.timeoutWins !== false ? (o.mashTimeoutOk ?? true) : false);\n  }\n  finish(ok) { const o = this.opt, A = this.area; this.active = false; this.opt = null; if (A.ctx.engine.timeScale === 0.5) A.ctx.engine.timeScale = this.savedScale || 1; A.ctx.audio.play(ok ? 'uiconfirm' : 'qtefail'); A.stats?.(ok); o.onDone?.(ok); if (!this.active && this.queue.length) this.start(this.queue.shift()); }\n  cancel() { this.active = false; this.opt = null; this.queue = []; if (this.area.ctx.engine.timeScale === 0.5) this.area.ctx.engine.timeScale = 1; }\n}\nE\ncat > src/game/companion.js <<'E'\n// Dame Ottoline. Never impressed, never thanks anyone. Same interface as a target: pos, floor, hurt.\nimport { THREE } from '../../pixel-engine.js';\nimport { TUNING } from '../data/tuning.js';\nimport { BARKS } from '../data/dialogue.js';\nimport { Humanoid } from './actor.js';\nexport class Dame {\n  constructor(area, x, z) {\n    this.area = area; this.h = new Humanoid(area.ctx, 'dame', { scale: 0.82 }); this.root = this.h.root; this.pos = new THREE.Vector3(x, 0, z); this.prev = this.pos.clone(); this.floor = 0; this.yaw = 0; this.mode = 'follow'; this.active = true; this.hidden = false; this.carried = false; this.path = null; this.pathI = 0; this.pathT = 0; this.hp = area.run.dameHp ?? TUNING.dameHp; this.barkT = 8; this.machine = null; this.anim = null; this.invuln = 0; this.lostT = 0;\n    this.h.play('DameIdle');\n  }\n  get maxHp() { return TUNING.dameHp; }\n  canBeTaken() { return this.active && !this.hidden && !this.carried && !this.machine && this.invuln <= 0; }\n  setMode(m) { const A = this.area; this.mode = m; this.machine = null; if (this.hidden && m !== 'hide') this.unhide(); A.dameBark(BARKS.dame[m === 'follow' ? 'follow' : m === 'wait' ? 'wait' : 'hide']); }\n  hide(spot) { this.hidden = true; this.mode = 'hide'; this.pos.set(spot.x, 0, spot.z); this.prev.copy(this.pos); this.spot = spot; this.root.visible = false; this.area.dameBark(BARKS.dame.hide); this.area.ctx.audio.play('cratebreak', { volume: 0.2 }); }\n  unhide() { this.hidden = false; this.root.visible = true; this.spot = null; this.area.ctx.audio.play('cratebreak', { volume: 0.2 }); }\n  takenBy(e) { this.carried = true; this.carriedBy = e; this.lostT = TUNING.dameGrabTime; this.machine = null; this.area.dameBark(BARKS.dame.grabbed); this.area.onDameTaken?.(e); }\n  dropped() { const e = this.carriedBy; this.carried = false; this.carriedBy = null; this.invuln = 2.5; this.mode = 'follow'; this.path = null; if (e) { this.pos.copy(e.pos); this.pos.y = 0; this.prev.copy(this.pos); e.path = null; } this.area.ctx.audio.play('hurtmax', { volume: 0.5, pitch: 5 }); }\n  hurt(amount, from, o = {}) {\n    const A = this.area; if (this.invuln > 0 && !o.dot || A.cheatGod || A.player?.god) return false; this.hp -= amount; if (!o.dot) { this.invuln = 0.5; this.h.flash(); A.addDeduction(Math.round(amount * 5)); A.dameBark(BARKS.dame.hurt); A.ctx.audio.play('hurtmax', { volume: 0.6, pitch: 6 }); A.run.stats.tookDamage; }\n    A.run.dameHp = this.hp; if (this.hp <= 0) { this.hp = 0; A.onDameDead?.(); } return true;\n  }\n  fixed(dt) {\n    const A = this.area; this.prev.copy(this.pos); if (!this.active) return; if (this.invuln > 0) this.invuln -= dt; this.barkT -= dt;\n    if (this.carried) { const e = this.carriedBy; if (!e || e.dead) { this.dropped(); return; } this.pos.set(e.pos.x, 1.0 * e.scale, e.pos.z); this.yaw = e.yaw + Math.PI / 2; this.lostT -= dt; if (this.lostT <= 0) A.onDameLost?.(); return; }\n    this.pos.y = 0;\n    if (this.hidden) { this.moving = 0; return; }\n    if (this.machine) { const m = this.machine; this.face(m.x, m.z, dt); this.moving = 0; return; }\n    if (this.goal) { if (this.walkTo(this.goal.x, this.goal.z, dt, this.goal.run ? 3.8 : 2.6)) { const g = this.goal; this.goal = null; g.done?.(); } return; }\n    const P = A.player; if (this.mode === 'wait' || !P) { this.moving = 0; if (P) this.face(P.pos.x, P.pos.z, dt); this.idleBark(); return; }\n    const d = Math.hypot(P.pos.x - this.pos.x, P.pos.z - this.pos.z);\n    if (P.floor !== this.floor) { this.moving = 0; return; }\n    if (P.aiming && d < 4) { const dot = (this.pos.x - P.pos.x) * Math.sin(P.camYaw) + (this.pos.z - P.pos.z) * Math.cos(P.camYaw), side = (this.pos.x - P.pos.x) * -Math.cos(P.camYaw) + (this.pos.z - P.pos.z) * Math.sin(P.camYaw); if (dot > 0 && Math.abs(side) < 0.9) { const sx = -Math.cos(P.camYaw) * Math.sign(side || 1), sz = Math.sin(P.camYaw) * Math.sign(side || 1); this.move(sx, sz, dt, 2.6); return; } }\n    if (d > 4) { this.pathT -= dt; if (this.pathT <= 0 || !this.path) { this.path = A.navOf(0, 0).path([this.pos.x, 0, this.pos.z], [P.pos.x, 0, P.pos.z]); this.pathI = 1; this.pathT = 0.5; } this.followPath(dt, d > 8 ? 3.8 : 2.6); }\n    else if (d < 1.6) { const dx = this.pos.x - P.pos.x, dz = this.pos.z - P.pos.z, L = d || 1; this.move(dx / L, dz / L, dt, 2); } else { this.moving = 0; this.face(P.pos.x, P.pos.z, dt); this.idleBark(); }\n    if (d > 30) { const b = P.pos; this.pos.set(b.x - Math.sin(P.yaw) * 1.5, 0, b.z - Math.cos(P.yaw) * 1.5); this.path = null; }\n  }\n  idleBark() { if (this.barkT <= 0) { this.barkT = this.area.rng.range(18, 34); this.area.dameBark(BARKS.dame.idle); } }\n  walkTo(x, z, dt, sp) { const dx = x - this.pos.x, dz = z - this.pos.z, L = Math.hypot(dx, dz); if (L < 0.4) return true; if (!this.path || this.pathT <= 0 || this.pathGoal !== x + z) { this.pathGoal = x + z; this.path = this.area.navOf(0, 0).path([this.pos.x, 0, this.pos.z], [x, 0, z]); this.pathI = 1; this.pathT = 1; } this.pathT -= dt; if (this.path) this.followPath(dt, sp); else this.move(dx / L, dz / L, dt, sp); return false; }\n  followPath(dt, sp) { const p = this.path; if (!p || this.pathI >= p.length) { this.moving = 0; return; } const w = p[this.pathI], dx = w[0] - this.pos.x, dz = w[2] - this.pos.z, L = Math.hypot(dx, dz); if (L < 0.3) { this.pathI++; return; } this.move(dx / L, dz / L, dt, sp); }\n  move(dx, dz, dt, sp) { const A = this.area, nx = this.pos.x + dx * sp * dt, nz = this.pos.z + dz * sp * dt; const ok = (x, z) => A.level.enemyCanStand(x, z, 0) && !this.closedDoorAt(x, z); if (ok(nx, this.pos.z)) this.pos.x = nx; if (ok(this.pos.x, nz)) this.pos.z = nz; this.yaw = Math.atan2(dx, dz); this.moving = sp; }\n  closedDoorAt(x, z) { const o = this.area.level.barrierAt(x, z, 0); return !!o; }\n  face(x, z, dt) { const want = Math.atan2(x - this.pos.x, z - this.pos.z); let d = want - this.yaw; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; this.yaw += d * Math.min(1, 6 * dt); }\n  update(dt) {\n    const a = this.area.ctx.physics.alpha; this.root.position.lerpVectors(this.prev, this.pos, a); this.root.rotation.y = this.yaw;\n    let c = 'DameIdle', o = {}; if (this.carried) c = 'LieIdle'; else if (this.machine) c = this.machine.clip ?? 'DameHoist'; else if (this.moving > 0) { c = 'DameWalk'; o.timeScale = this.moving / 2.6 / 0.82; }\n    if (this.anim !== c) { this.anim = c; this.h.play(c, o); } this.h.update(dt);\n  }\n}\nE\ncat > src/game/interact.js <<'E'\n// One context prompt. Priority: Kick/Takedown > ladder knock > door > window > push > pick up > talk > telegraph.\nimport { THREE } from '../../pixel-engine.js';\nexport class Interact {\n  constructor(area) { this.area = area; this.items = []; this.best = null; this.bestEnemy = null; }\n  add(it) { it.priority ??= 5; it.radius ??= 1.6; it.floor ??= 0; this.items.push(it); return it; }\n  remove(it) { const i = this.items.indexOf(it); if (i >= 0) this.items.splice(i, 1); }\n  /** Picks the best target for a player. Fills this.best with {verb, act} */\n  pick(P) {\n    const A = this.area; let best = null, bs = -1e9; const fx = Math.sin(P.yaw), fz = Math.cos(P.yaw);\n    // Enemies first.\n    for (const e of A.enemies) {\n      if (e.dead || e.floor !== P.floor) continue; const dx = e.pos.x - P.pos.x, dz = e.pos.z - P.pos.z, d = Math.hypot(dx, dz);\n      if (e.latched && e.target === P) { const s = 1000; if (s > bs) { bs = s; best = { verb: 'KICK OFF', act: () => { e.die({}); A.ctx.audio.play('kickhit'); P.limpets = Math.max(0, (P.limpets ?? 1)); return true; }, enemy: e }; } continue; }\n      const front = d < 0.01 ? 1 : (dx * fx + dz * fz) / d;\n      if (e.kickable() && d < 2.6 && front > 0.05) { const s = 900 - d; if (s > bs) { bs = s; best = { verb: 'KICK', kind: 'kick', enemy: e, act: () => this.doKick(P, e, 'kick') }; } }\n      else if (e.takedownable() && d < 2.0 && front > 0.05) { const s = 880 - d; if (s > bs) { bs = s; best = { verb: 'TAKEDOWN', kind: 'takedown', enemy: e, act: () => this.doKick(P, e, 'takedown') }; } }\n    }\n    for (const it of this.items) {\n      if (it.disabled || (it.when && !it.when())) continue; if ((it.floor ?? 0) !== P.floor) continue;\n      const dx = it.x - P.pos.x, dz = it.z - P.pos.z, d = Math.hypot(dx, dz); if (d > it.radius) continue;\n      const front = d < 0.3 ? 1 : (dx * fx + dz * fz) / d; if (front < 0.34 && !it.any) continue; // +-70 degrees\n      const s = it.priority * 100 - d; if (s > bs) { bs = s; best = it; }\n    }\n    this.best = best; return best;\n  }\n  fire(P) { const b = this.pick(P); if (!b) return false; return b.act(P) !== false; }\n  doKick(P, e, kind) { P.yaw = Math.atan2(e.pos.x - P.pos.x, e.pos.z - P.pos.z); P.invuln = 0.5; P.startAction('kick', kind === 'kick' ? 0.6 : 0.8, { target: e, kind }); this.area.ctx.audio.play('kickwhoosh'); if (kind === 'takedown') P.h.play('HipThrow', { restart: true, fade: 0.05 }); return true; }\n}\nE\ncat > src/game/cutscene.js <<'E'\n// Dialogue box and cutscene camera. Timeline drives shots, cues and letterbox. Hold confirm to skip.\nimport { Timeline } from '../../pixel-engine.js';\nimport { COLORS, SCENES } from '../data/dialogue.js';\nimport { VoiceLine } from '../audio/voice.js';\nexport class Dialog {\n  constructor(area) { this.area = area; this.lines = null; this.i = 0; this.n = 0; this.auto = 0; this.voice = null; this.done = null; this.lock = false; }\n  get active() { return !!this.lines; }\n  start(lines, o = {}) { this.lines = lines; this.i = 0; this.done = o.done; this.lock = o.lock ?? true; this.auto = o.autoAdvance ?? 0; this.begin(); }\n  begin() { const l = this.lines[this.i]; this.n = 0; this.hold = 0; const app = this.area.app; this.voice = new VoiceLine(this.area.ctx.audio, l.who, l.text, () => app.settings.voice); }\n  /** Per frame, real time. confirm: was the advance button pressed. */\n  update(dt, confirm) {\n    if (!this.lines) return; const l = this.lines[this.i], len = l.text.length;\n    this.n = Math.min(len, this.n + dt * 30 * (this.area.fastText ? 6 : 1)); this.voice.tick(Math.floor(this.n));\n    const finished = this.n >= len; if (finished) this.hold += dt;\n    const autoWait = this.area.autoDialog ? 0.25 : (this.lock ? 7 + len / 40 : 2.2 + len / 30);\n    if (confirm) { if (!finished) { this.n = len; this.voice.i = len; } else this.next(); } else if (finished && this.hold > autoWait) this.next();\n  }\n  next() { this.i++; if (this.i >= this.lines.length) this.end(); else this.begin(); }\n  end() { const d = this.done; this.lines = null; this.done = null; d?.(); }\n  skip() { this.lines = null; const d = this.done; this.done = null; d?.(); }\n  draw(ui) {\n    if (!this.lines) return; const l = this.lines[this.i], W = ui.W, H = ui.H; const w = Math.min(W - 40, 400), x = (W - w) / 2, y = H - 66 - (this.area.player?.locked ? 0 : 0);\n    ui.panel(x, y, w, 50, { bg: 'ink', border: 'slate' });\n    ui.text(x + 8, y + 5, l.who, { color: COLORS[l.who] ?? 'mist' });\n    const shown = l.text.slice(0, Math.floor(this.n)); const lines = ui.wrap(l.text, w - 16); let left = shown.length; lines.forEach((t, i) => { const s = t.slice(0, Math.max(0, left)); left -= t.length + 1; ui.text(x + 8, y + 16 + i * 10, s, { color: 'white' }); });\n    if (this.n >= l.text.length && Math.floor(ui.t * 3) % 2) ui.action('confirm', x + w - 16, y + 37);\n  }\n}\n/** A scripted shot list with letterbox. Dialogue may run alongside. */\nexport class Cutscene {\n  constructor(area, o) { this.area = area; this.o = o; this.tl = new Timeline({ shots: o.shots, cues: o.cues ?? [], duration: o.duration, onEnd: () => { this.ended = true; } }); this.tl.play(); this.ended = false; this.linesDone = !o.lines; this.skipHold = 0; if (o.lines) area.dialog.start(o.lines, { lock: true, done: () => { this.linesDone = true; } }); }\n  get finished() { return this.ended && this.linesDone; }\n  update(dt, holding) {\n    const A = this.area; if (!this.linesDone && this.tl.time >= this.tl.duration - 0.05) { this.tl.pause(); this.tl.time = this.tl.duration - 0.05; } else if (this.tl.time < this.tl.duration - 0.05 && !this.tl.playing && !this.ended) this.tl.play();\n    if (this.linesDone && !this.tl.playing && !this.ended) { this.tl.play(); }\n    this.tl.update(dt);\n    if (holding) { this.skipHold += dt; if (this.skipHold >= 0.6) this.skip(); } else this.skipHold = 0;\n  }\n  skip() { if (this.ended && this.linesDone) return; this.area.dialog.active && this.area.dialog.skip(); this.linesDone = true; this.tl.skip(); this.ended = true; }\n  camera() { return this.tl.camera(); }\n  bars() { return this.ended ? 0 : this.tl.bars(); }\n}\nexport function sceneLines(name) { return SCENES[name]; }\nE\necho done","description":"Write player, QTE, companion, interact, cutscene systems"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":19666,"cache_read_input_tokens":293687,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":19666},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76d12802-c986-437e-adae-1ae347966275","uuid":"cd384517-8dbe-49e2-a723-736c29e6a622","timestamp":"2026-11-05T23:44:58.575Z","request_id":"req_011CgkfgKXz7hMAHfALyU6kT","wire_tool_inputs":{"toolu_01ND6pis9mYNVwdrxCArPcbW":{"command":"cat > src/game/player.js <<'E'\n// Max Ransom. Reads an Intent, never the keyboard. Plant your feet: you cannot move while aiming.\nimport { CharacterController, glowMaterial, SpringChain, THREE, toonMaterial, PALETTE, setLookLayer } from '../../pixel-engine.js';\nimport { TUNING } from '../data/tuning.js';\nimport { WEAPONS, GRENADES } from '../data/weapons.js';\nimport { ITEMS } from '../data/items.js';\nimport { BARKS } from '../data/dialogue.js';\nimport { ammoOf, bestHerb, count, diff, ownedWeapons, removeItem, statsOf, takeAmmo, useHerb } from '../core/run.js';\nimport { device, rumble } from '../core/device.js';\nimport { castShot, pointAt } from './combat.js';\nimport { Humanoid } from './actor.js';\nconst v = new THREE.Vector3(), v2 = new THREE.Vector3();\nconst MODEL_OF = { pistol: 'w-pistol', scatter: 'w-scatter', rifle: 'w-rifle', harpoon: 'w-harpoon' };\nconst FIRE_SND = { pistol: 'pistol', scatter: 'scatter', rifle: 'rifle', harpoon: 'harpoon' };\nconst CAM = { explore: { dist: 4.0, up: 0.45, side: 0.55, fov: 55 }, aim: { dist: 2.9, up: 0.1, side: 0.95, fov: 42 }, scope: { dist: 0.3, up: 0.28, side: 0.25, fov: 16 } };\nexport class Player {\n  constructor(area, x, z, o = {}) {\n    this.area = area; const P = area.ctx.physics; this.index = o.index ?? 0; this.floor = o.floor ?? 0; this.remote = !!o.remote; this.model = o.model ?? 'max'; this.god = false; this.noclip = false;\n    this.pos = new THREE.Vector3(x, this.floor * area.floorH, z); this.prev = this.pos.clone(); this.vel = new THREE.Vector3(); this.yaw = o.yaw ?? Math.PI; this.camYaw = this.yaw; this.camPitch = 0; this.modelYaw = this.yaw;\n    if (!this.remote) { this.body = new CharacterController(P, { position: [x, this.pos.y, z], speed: 12, radius: 0.3, halfHeight: 0.5 }); P.tag(this.body.collider, 'noCamera', 'player'); }\n    this.h = new Humanoid(area.ctx, this.model, { layered: true, palette: o.palette }); this.root = this.h.root; this.fire = 0; this.reloadT = 0; this.action = null; this.actionT = 0; this.locked = false; this.invuln = 0; this.dead = false; this.limpets = 0; this.slowT = 0; this.shake = 0; this.aiming = false; this.recoil = 0; this.aimK = 0; this.sway = 0; this.lastDamage = area.ctx.time; this.hitDir = null; this.hitDirT = 0; this.shots = 0; this.lowT = 0; this.heartT = 0; this.gripBy = null; this.chainWeapon = null; this.reach = 1; this.dot = new THREE.Vector3(); this.dotZone = null; this.dotOn = false; this.shoulder = 1; this.flash = 0;\n    this.laser = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.02, 1), glowMaterial(PALETTE.red)); this.laser.castShadow = false; this.laser.visible = false; area.ctx.scene.add(this.laser);\n    this.setWeaponModel(); this.h.play('Idle');\n    // Scarf: spring chain tail. The camera sits behind her all game: her back is her best side.\n    this.scarf = new SpringChain({ segments: 5, length: 0.11 }); this.scarfMeshes = [];\n    const col = o.scarf ?? PALETTE.red; const mat = toonMaterial(col);\n    for (let i = 0; i < 5; i++) { const m = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.05, 0.13 - i * 0.012), mat); m.castShadow = true; setLookLayer(m, 'actors'); area.ctx.scene.add(m); this.scarfMeshes.push(m); }\n    this.light = area.ctx.lights.request({ follow: this.root, offset: [0.3, 1.8, 0.5], color: 0xffe0a0, intensity: area.fillLight ?? 1.2, radius: 5, priority: 8 });\n    this.cam = { ...CAM.explore }; this.camTarget = new THREE.Vector3();\n    this.h.update(0);\n  }\n  get run() { return this.area.run; }\n  get weapon() { return this.run.weapon; }\n  get stats() { return statsOf(this.run, this.weapon); }\n  get wstate() { return this.run.weapons[this.weapon]; }\n  setWeaponModel() { this.h.detach('gun'); if (!this.remote || true) { const id = this.area.weaponOf?.(this) ?? this.weapon; this.h.attach('HandR', MODEL_OF[id] ?? 'w-pistol', { as: 'gun' }); this.gunId = id; } }\n  teleport(x, z, floor = this.floor, yaw = null) { this.floor = floor; this.pos.set(x, floor * this.area.floorH, z); this.prev.copy(this.pos); this.vel.set(0, 0, 0); this.body?.teleport([x, this.pos.y, z]); if (yaw != null) { this.camYaw = this.yaw = this.modelYaw = yaw; } }\n  /** Fixed step. */\n  fixed(dt, i) {\n    const A = this.area; if (this.remote) return; this.prev.copy(this.pos);\n    if (this.invuln > 0) this.invuln -= dt; if (this.fire > 0) this.fire -= dt; if (this.slowT > 0) this.slowT -= dt; this.hitDirT = Math.max(0, this.hitDirT - dt); this.flash = Math.max(0, this.flash - dt);\n    if (i.absYaw != null) { this.camYaw = i.absYaw; i.absYaw = null; } if (i.absPitch != null) { this.camPitch = i.absPitch; i.absPitch = null; }\n    let mx = 0, mz = 0;\n    if (this.dead) { this.drive(dt, 0, 0); return; }\n    if (A.qte.active && A.qte.owner === this) { A.qte.feed(i); this.drive(dt, 0, 0); return; }\n    if (this.locked) { this.aiming = false; this.drive(dt, 0, 0); return; }\n    if (this.reloadT > 0) { this.reloadT -= dt * TUNING.reloadSpeed; if (this.reloadT <= 0) this.finishReload(); }\n    if (this.action) { this.tickAction(dt, i); return; }\n    // Aiming\n    const canAim = i.aim && !this.grabbed; const wasAim = this.aiming; this.aiming = canAim; if (this.aiming && !wasAim) this.area.onAim?.(this);\n    if (i.turn && !this.aiming) { this.startAction('quickturn', 0.3); this.turnFrom = this.camYaw; this.turnTo_ = this.camYaw + Math.PI; i.turn = false; return; }\n    if (i.next || i.prev || i.slot >= 0) this.cycleWeapon(i);\n    if (i.shoulder) { this.shoulder = -this.shoulder; i.shoulder = false; }\n    if (i.reload) { this.startReload(); i.reload = false; }\n    if (i.heal) { this.quickHeal(); i.heal = false; }\n    if (i.command) { A.command?.(); i.command = false; }\n    if (this.aiming) {\n      if (i.throw) { this.throwGrenade(); i.throw = false; }\n      if ((i.fire || i.firePressed) && this.fire <= 0 && this.reloadT <= 0) this.shoot();\n      else if (i.firePressed && this.reloadT > 0) { /* still reloading */ }\n    } else i.throw = false;\n    if (i.knife && !this.aiming) { this.startAction('knife'