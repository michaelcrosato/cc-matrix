teleport(a.level.wx(14), a.level.wz(16), 0, -Math.PI / 2); a.addScript(FLENSER_STEPS); },\n    cold: (a) => { addKey(a); a.player.teleport(a.level.wx(38), a.level.wz(11), 0, Math.PI); a.addScript(COLD_STEPS); },\n    boost: (a) => { a.run.flags.dameFree = true; a.spawnDame(); a.player.teleport(a.level.wx(14), a.level.wz(11), 0, -Math.PI / 2); a.dame.pos.set(a.level.wx(16), 0, a.level.wz(11)); a.addScript(BOOST_STEPS); },\n    winch: (a) => { a.run.flags.dameFree = true; a.spawnDame(); a.level.openDoor(doorOf(a, WINCH_DOOR), null, true); a.player.teleport(a.level.wx(9), a.level.wz(7), 0, 0); a.dame.pos.set(a.level.wx(8), 0, a.level.wz(5)); a.addScript(WINCH_STEPS); },\n    belt: (a) => { a.run.flags.dameFree = true; a.spawnDame(); a.player.teleport(a.level.wx(20), a.level.wz(17) , 0, Math.PI); a.addScript(BELT_STEPS); },\n  },\n  beats: [{ id: 'cannery-main', skip: (a) => { if (a.run.flags.dameFree) a.spawnDame?.(); }, steps: [\n    { objective: 'THE HALL. FIND THE INSURED.' }, { until: (a) => a.player.pos.z < a.level.wz(26) }, { music: 'combat' },\n    { wave: { groups: [['gaffer', 10], ['bottler', 2]], doors: '13', every: 1.2, maxActive: 8 } }, { say: ['COMMODORE', 'A MESSAGE FROM THE CANNERY: WE ARE HIRING.'] },\n    { until: (a) => (a.killCount ?? 0) >= 8 }, { run: (a) => a.addScript(FLENSER_STEPS) },\n  ] }],\n};\nfunction addKey(a) { if (!a.run.keys.includes('coldkey')) a.run.keys.push('coldkey'); }\nconst FLENSER_STEPS = [\n  { run: (a) => { const d = doorOf(a, SAW_DOOR); a.level.breakDoor(d, { pos: a.player.pos }); a.ctx.audio.play('doorkick'); a.ctx.engine.shake.add(0.5); a.flenser = a.spawnEnemy('flenser', a.level.wx(4), a.level.wz(16)); a.flenser.onDeath = () => {}; } }, { objective: 'YOU HEARD HIM FIRST. KILL HIM FOR THE KEY.' }, { until: (a) => a.flenser?.dead }, { run: (a) => { a.spawnDrop(a.flenser.pos.x, a.flenser.pos.z, { id: 'coldkey', count: 1 }); a.app.mix.play('explore'); a.addScript(COLD_STEPS); a.checkpoint(true); } },\n];\nconst COLD_STEPS = [\n  { objective: 'THE COLD ROOM. NORTH EAST.' }, { until: (a) => a.run.keys.includes('coldkey') }, { until: (a) => doorOf(a, COLD_DOOR).open }, { music: null }, { run: (a) => { a.cold = true; a.silent = true; } }, { zone: [34, 2, 44, 8] },\n  { run: (a) => { a.dameStatic?.remove(); a.run.flags.dameFree = true; a.spawnDame(); } },\n  { scene: 'coldroom', duration: 12, shots: (a) => [{ at: 0, position: c(a, 38, 7, 1.7), target: c(a, 41, 4, 0.9), fov: 45 }, { at: 12, position: c(a, 40, 6.5, 1.4), target: c(a, 41, 4, 1), fov: 34 }] },\n  { run: (a) => { a.silent = false; a.showHint('dame'); a.checkpoint(true); a.dame.setMode('follow'); a.addScript(BOOST_STEPS); } },\n];\nconst BOOST_STEPS = [\n  { music: 'explore' }, { objective: 'THE WINCH ROOM IS CHAINED FROM ABOVE. BOOST THE DAME AT THE HOIST.' },\n  { run: (a) => { const u = a.level.markers.u[0]; a.boostDone = false; a.commandSpots.push({ x: u.x, z: u.z, verb: 'BOOST', radius: 2.6, when: () => !a.boostDone && a.dame && !a.dame.carried, act: () => { a.boostDone = true; a.player.startAction('boost', 1); a.dame.goal = null; a.dame.pos.set(u.x, 0, u.z); a.dame.root.position.y = 0; a.dameBark(['Eyes front, young woman.']); a.ctx.tweens.call(1, () => { a.level.openDoor(doorOf(a, WINCH_DOOR), a.player.pos); a.ctx.audio.play('chain'); }); } }); } },\n  { until: (a) => a.boostDone }, { wait: 1.2 }, { run: (a) => { const e = a.spawnEnemy('carrier', a.level.wx(43), a.level.wz(18)); a.level.openDoor(doorOf(a, EAST_DOOR), e.pos); a.carrierE = e; a.radio('general'); } }, { say: ['MAX', 'Shoot the big one. Mind the coat.'] }, { until: (a) => a.carrierE?.dead || !a.dame?.carried && a.time > 99999 }, { run: (a) => a.addScript(WINCH_STEPS) },\n];\nconst WINCH_STEPS = [\n  { objective: 'WINCH ROOM. THE DAME RAISES THE SHUTTER. HOLD THE DOOR.' }, { run: (a) => { const w = a.level.markers.w[0]; a.dame.goal = { x: w.x + 0.8, z: w.z + 0.8, done: () => { a.dame.machine = { x: w.x, z: w.z, clip: 'DameHoist' }; } }; addWinch(a); } }, { until: (a) => a.dame.machine },\n  { music: 'combat' }, { run: (a) => { a.winch.on = true; a.checkpoint(true); } },\n  { wave: { groups: [['gaffer', 8], ['runner', 6], ['carrier', 1], ['bottler', 2]], doors: '123', every: 3.5, maxActive: 9 } },\n  { until: (a) => a.winch.pct >= 100 }, { run: (a) => { a.winch.on = false; a.dame.machine = null; a.dame.setMode('follow'); a.level.openGate(a.level.gates.S[0]); for (const w of a.waves) w.stop(); a.say('DAME', 'Done. Do try to keep up.', 2); a.app.mix.play('explore'); a.addScript(BELT_STEPS); } },\n];\nconst BELT_STEPS = [\n  { objective: 'THE SHUTTER IS UP. CROSS THE HALL.' }, { until: (a) => { const r = a.level.row(a.player.pos.z), cc = a.level.col(a.player.pos.x); return r <= 15 && r >= 10 && cc >= 8 && cc <= 38; } }, { run: (a) => beltFight(a) }, { until: (a) => a.beltDone },\n  { run: (a) => { a.checkpoint(true); a.say('PYM', 'Workplace incident logged. Please do not touch the can.', 2); } }, { objective: 'NORTH CORRIDOR. THROUGH THE SHUTTER.' }, { until: (a) => a.level.row(a.player.pos.z) <= 2 }, { run: (a) => a.go('yard') }, { wait: 9999 },\n];\nexport const YARD = {\n  map: 'yard', title: 'CANNERY YARD', mood: 'rain', music: 'boss', loops: ['rain'], chapter: 2, hint: 'bosun', startYaw: Math.PI, dame: 'always', fathomYaw: -2.4, waterY: -5, treasure: ['blackpearl'], barrels: [[11, 7], [24, 7], [11, 28], [24, 28], [5, 15], [30, 21]],\n  groundItems: [['ammo_pistol', 15, 9, 12], ['samphire', 20, 26, 1]], notes: [{ id: 'receipt', col: 4, row: 4, y: 0.6 }],\n  theme: { '#': 'bricks', H: 'rust', r: 'metal-plates' }, decor: [['gantry', 18, 18], ['steam-pipe', 3, 25], ['steam-pipe', 32, 10], ['crate-stack', 3, 31], ['crate-stack', 32, 31], ['barrel', 31, 25], ['dead-tree', 5, 30]],\n  lamps: [['lamp-post', 5, 6], ['lamp-post', 30, 6], ['lamp-post', 5, 29], ['lamp-post', 30, 29], ['brazier', 18, 8, { intensity: 14, radius: 12, color: 0xff8030 }], ['brazier', 18, 27, { intensity: 14, radius: 12, color: 0xff8030 }]],\n  dress: { wall: ['barrel', 'crate', 'sack', 'bucket', 'can-tin'], open: ['puddle', 'can-tin'] }, backdrops: [['backdrop-cliff', -40, -3, -40], ['backdrop-cliff', 40, -3, -40, 1], ['abbey-far', 0, -2, -80]],\n  setup(a) {},\n  beats: [{ id: 'yard-main', steps: [\n    { run: (a) => { a.dame.setMode('wait'); const k = a.level.markers.k[0]; a.dame.pos.set(k.x + 1, 0, k.z + 1); } },\n    { until: (a) => a.player.pos.z < a.level.wz(30) }, { run: (a) => bosunBoss(a) }, { objective: 'DROP THE PALLET ON HIM. COMMAND THE DAME.' }, { until: (a) => a.boss?.dead }, { wait: 2 },\n    { music: 'explore' }, { scene: 'bosundead', duration: 3, shots: (a) => [{ at: 0, position: c(a, 20, 24, 2.4), target: [a.boss.pos.x, 0.8, a.boss.pos.z], fov: 45 }, { at: 3, position: c(a, 21, 25, 3), target: [a.boss.pos.x, 0.6, a.boss.pos.z], fov: 40 }] },\n    { run: (a) => a.dame.setMode('follow') }, { wait: 1 },\n    { scene: 'afterbosun', duration: 10, shots: (a) => { const k = a.level.markers.k[0]; return [{ at: 0, position: [k.x + 3, 1.6, k.z + 3], target: [k.x + 1, 1, k.z + 1], fov: 42 }, { at: 10, position: [k.x + 2.5, 1.4, k.z + 2.4], target: [k.x + 1, 1, k.z + 1], fov: 32 }]; } },\n    { run: (a) => { a.checkpoint(true); a.level.openGate(a.level.gates.G[0]); } }, { objective: 'MR. FATHOM, THEN THE NORTH GATE.' }, { until: (a) => a.level.row(a.player.pos.z) <= 3 }, { run: (a) => a.showForm(() => a.app.nextChapter('causeway', 3)) }, { wait: 9999 },\n  ] }],\n};\nE\ncat > src/data/levels/chapter3.js <<'E'\n// Chapter 3: CLAIM 3: ACT OF COMMODORE, and the Final Settlement.\nimport { bathysphereBoss, cryptStart, lensSetup, tideStart } from '../../game/setpieces.js';\nconst c = (a, col, row, y = 1.5) => [a.level.wx(col), y, a.level.wz(row)];\nexport const CAUSEWAY = {\n  map: 'causeway', title: 'THE CAUSEWAY', mood: 'moon', music: 'tide', loops: ['sea'], chapter: 3, chapterCard: 3, hint: 'tide', startYaw: Math.PI, dame: 'always', fathomYaw: 1.57, waterY: -0.6, waterOpt: { deep: 0x29366f }, treasure: ['pearl'], theme: { '.': 'dry-stone', ',': 'basalt', '%': 'shallow-water' }, groundItems: [['ammo_pistol', 13, 36, 12], ['samphire', 2, 64, 1]],\n  decor: [['bollard', 5.2, 80], ['bollard', 10.8, 72], ['bollard', 5.2, 50], ['bollard', 10.8, 40], ['bollard', 5.2, 20], ['bollard', 10.8, 12], ['rock', 2, 62], ['boulders', 13, 39], ['abbey-far', 8, -28, 0], ['dead-tree', 3, 67]], lamps: [['lamp-post', 5, 86], ['lamp-post', 10, 60], ['lamp-post', 5, 34], ['lamp-post', 10, 8], ['brazier', 1, 63, { intensity: 10, radius: 10, color: 0xff8030 }]],\n  backdrops: [['backdrop-cliff', -60, -3, 30], ['backdrop-cliff', 60, -3, -30, 1], ['sea-stack', -20, -2, 10], ['sea-stack', 22, -2, -22, 1], ['sea-stack', 20, -2, 34]],\n  setup(a) {}, beats: [{ id: 'causeway-main', steps: [\n    { scene: 'causeway', duration: 7, shots: (a) => [{ at: 0, position: c(a, 8, 90, 2.4), target: c(a, 8, 40, 5), fov: 50 }, { at: 7, position: c(a, 8, 96, 2.2), target: c(a, 7, 92, 1.4), fov: 50 }] }, { run: tideStart }, { objective: 'REACH THE ABBEY GATE BEFORE THE TIDE.' },\n  ] }],\n};\nexport const ABBEY = {\n  map: 'abbey', title: 'THE ABBEY OF SAINT ORRIN', mood: 'abbey', music: 'explore', chapter: 3, hint: 'lens', startYaw: Math.PI, dame: 'always', water: false, wallH: 9, fathomYaw: -1.57, treasure: ['amber', 'tusk'], theme: { '_': 'flagstones', ',': 'moss', '#': 'dry-stone', H: 'dry-stone' }, groundItems: [['ammo_shells', 11, 10, 6], ['samphire', 33, 29, 1], ['oil', 13, 30, 1]], notes: [{ id: 'hymn', col: 4, row: 25, y: 0.05 }, { id: 'page40', col: 41, row: 20, y: 0.05 }],\n  hideSpots: [[9, 28, 'barrel'], [34, 11, 'barrel']],\n  decor: [['stained-glass', 22, 8.2, 0, {}], ['stained-glass', 8.2, 20, 1.57], ['stained-glass', 35, 12, -1.57], ['stained-glass', 35, 27, -1.57], ['column', 12.5, 12.5], ['column', 16.5, 12.5], ['column', 27.5, 12.5], ['column', 31.5, 12.5], ['column', 12.5, 27.5], ['column', 16.5, 27.5], ['column', 27.5, 27.5], ['column', 31.5, 27.5], ['column', 12.5, 18.5], ['column', 31.5, 18.5], ['column', 12.5, 22.5], ['column', 31.5, 22.5], ['sarcophagus', 3.5, 18], ['sarcophagus', 3.5, 30], ['wall-chains', 1.5, 22], ['cobweb', 5, 12], ['cobweb', 2, 34], ['cage', 5, 24], ['shelf', 41, 15], ['table', 39, 22], ['banner', 38, 26], ['pew', 22, 4, 0], ['banner', 21, 1.5], ['tombstone', 20, 15], ['tombstone', 24, 22], ['tombstone', 18, 24], ['tall-grass', 26, 16], ['tall-grass', 17, 20]], lamps: [['candles', 20, 9, { intensity: 8, radius: 8, color: 0xffb060 }], ['candles', 24, 9, { intensity: 8, radius: 8, color: 0xffb060 }], ['brazier', 9, 10, { intensity: 11, radius: 11, color: 0xff8030 }], ['brazier', 34, 10, { intensity: 11, radius: 11, color: 0xff8030 }], ['brazier', 9, 30, { intensity: 11, radius: 11, color: 0xff8030 }], ['brazier', 34, 30, { intensity: 11, radius: 11, color: 0xff8030 }], ['candles', 22, 34, { intensity: 8, radius: 8, color: 0xffb060 }], ['candles', 2, 20, { intensity: 3.5, radius: 5, color: 0xffb060 }], ['candles', 5, 31, { intensity: 3.5, radius: 5, color: 0xffb060 }], ['candles', 40, 16, { intensity: 8, radius: 9, color: 0xffb060 }], ['candles', 22, 5, { intensity: 8, radius: 9, color: 0xffb060 }]],\n  dress: { wall: ['candles', 'cobweb', 'sack'], open: ['tall-grass', 'puddle'] }, backdrops: [['abbey-far', 0, -2, -70, 0], ['backdrop-cliff', 60, -3, 10, 1], ['backdrop-cliff', -60, -3, 10, 1]],\n  setup(a) { lensSetup(a); },\n  jumps: { lens: (a) => { a.player.teleport(a.level.wx(22), a.level.wz(28), 0, Math.PI); }, crypt: (a) => { a.player.teleport(a.level.wx(9), a.level.wz(20), 0, Math.PI); a.lensSolved = true; cryptStart(a); }, armoury: (a) => { a.lensSolved = true; a.player.teleport(a.level.wx(33), a.level.wz(20), 0, -1.57); a.level.openGate(a.level.gates.G[0]); a.cryptDone = true; } },\n  beats: [{ id: 'abbey-main', steps: [\n    { objective: 'THE ABBEY. THREE LAMPS AND A GATE.' }, { until: (a) => a.player.pos.z < a.level.wz(32) }, { music: 'explore' }, { spawn: [['monk', 18, 16], ['monk', 26, 22], ['monk', 14, 26], ['monk', 30, 14], ['knight', 22, 15], ['monk', 20, 10]] }, { say: ['COMMODORE', 'THE ABBEY GIFT SHOP IS NOW OPEN.'] },\n    { until: (a) => a.lensSolved }, { openGate: 'G' }, { say: ['COMMODORE', 'OH, WELL DONE. THE LAST PERSON TOOK NINE YEARS.'] }, { spawn: [['knight', 30, 26], ['monk', 12, 16]] }, { objective: 'THE GATE IS OPEN.' }, { until: (a) => a.level.row(a.player.pos.z) <= 12 }, { run: cryptStart }, { until: (a) => a.cryptDone }, { run: (a) => a.addScript(AFTER_CRYPT) },\n  ] }],\n};\nconst AFTER_CRYPT = [\n  { objective: 'ARMOURY TO THE EAST. THE NAVE IS NORTH.' }, { until: (a) => a.level.row(a.player.pos.z) <= 1 && a.level.doors.some((d) => d.id === '21,0' && d.open) }, { run: (a) => a.go('nave') }, { wait: 9999 },\n];\nexport const NAVE = {\n  map: 'nave', title: 'THE NAVE', mood: 'abbey', music: 'boss', chapter: 4, chapterCard: 4, hint: 'general', startYaw: Math.PI, dame: 'always', water: false, wallH: 10, theme: { '_': 'flagstones', H: 'dry-stone', '#': 'dry-stone' }, treasure: ['reliquary'], groundItems: [['ammo_pistol', 4, 40, 12], ['ammo_shells', 23, 40, 6], ['samphire', 4, 12, 1], ['firstaid', 23, 12, 1], ['flare', 13, 40, 1]],\n  decor: [['organ', 14, 3], ['stained-glass', 2.2, 14, 1.57], ['stained-glass', 2.2, 26, 1.57], ['stained-glass', 2.2, 38, 1.57], ['stained-glass', 25.8, 14, -1.57], ['stained-glass', 25.8, 26, -1.57], ['stained-glass', 25.8, 38, -1.57], ['pew', 5, 22, 0], ['pew', 22, 22, 0], ['pew', 5, 30, 0], ['pew', 22, 30, 0], ['pew', 5, 38, 0], ['pew', 22, 38, 0], ['font', 14, 8], ['altar', 14, 6.5], ['banner', 6, 3], ['banner', 21, 3], ['candles', 7, 8], ['candles', 20, 8]], lamps: [['brazier', 4, 8, { intensity: 14, radius: 14, color: 0xff8030 }], ['brazier', 23, 8, { intensity: 14, radius: 14, color: 0xff8030 }], ['brazier', 4, 24, { intensity: 14, radius: 14, color: 0xff8030 }], ['brazier', 23, 24, { intensity: 14, radius: 14, color: 0xff8030 }], ['brazier', 4, 42, { intensity: 12, radius: 12, color: 0xff8030 }], ['brazier', 23, 42, { intensity: 12, radius: 12, color: 0xff8030 }]],\n  backdrops: [], setup(a) {}, jumps: { hatch: (a) => { a.bossStart = 2; a.addScript(BOSS_STEPS); }, mother: (a) => { a.bossStart = 3; a.addScript(BOSS_STEPS); } },\n  beats: [{ id: 'nave-main', steps: [\n    { until: (a) => a.player.pos.z < a.level.wz(40) }, { run: (a) => a.app.mix.play(null) }, { scene: 'finalboss', duration: 8, shots: (a) => [{ at: 0, position: c(a, 13, 40, 2), target: c(a, 14, 14, 2.5), fov: 50 }, { at: 8, position: c(a, 14, 26, 1), target: c(a, 14, 14, 3.5), fov: 40 }] }, { run: (a) => { a.addScript(BOSS_STEPS); } },\n  ] }],\n};\nconst BOSS_STEPS = [{ run: bathysphereBoss }, { music: 'boss' }, { objective: 'THE VALVES. SHOOT THE VALVES.' }, { until: (a) => a.boss?.dead }, { checkpoint: true }, { objective: 'THE SIDE GATE. RUN.' }, { openGate: 'G' }, { until: (a) => a.level.col(a.player.pos.x) >= 25 && a.level.row(a.player.pos.z) <= 7 }, { run: (a) => a.go('launch') }, { wait: 9999 }];\nexport const LAUNCH = { map: 'deck', custom: true };\nE\npython3 - <<'P'\ns=open('src/data/levels/maps.js').read()\ns=s.replace(\"`;\\n\",\"\\nmap deck 9 13 ~\\nR 2 2 6 10 = | P 4 8 a\\n`;\\n\",1)\nopen('src/data/levels/maps.js','w').write(s)\nP\ngrep -n \"basalt\\|shallow-water\\|\\`moss\\|\\`rust\\`\\|\\`bricks\" ../_kit/pixel-engine/LIBRARY.md | cut -c1-70 | head; echo ok","description":"Write area data for all three chapters"}}}
