axP);\n      if (d < 0 && st.v < 1) break;\n      DH.trainStep(st, n, h, this.env(s)); s += st.v / 3.6 * h; t += h;\n      if (st.v < .05 && d > 3 && n <= 0) n = 1;\"\"\"\nnew=\"\"\"      if (d < 40 && st.v < 12) n = st.v < 4.5 ? -1 : -3; else n = this.law(st.v, vt, [d, 0], maxB, maxP);\n      if (st.v < .5 && d >= 3 && n <= 0) n = 1;   // a quick estimate: never stall short of the mark\n      DH.trainStep(st, n, h, this.env(s)); s += st.v / 3.6 * h; t += h;\"\"\"\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\nEOF\nnode /tmp/dh-cap.mjs S1; node /tmp/dh-cap.mjs S5","description":"Sort signals by distance; fix the arrival simulation","timeout":200000}}}
