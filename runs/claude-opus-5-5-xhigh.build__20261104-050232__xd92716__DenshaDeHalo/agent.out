= 0; i < 14; i++) { const x = -Wh * .8 + ((i * 37) % 100) / 100 * Wh * 1.6, y = hY(x) * (.3 + ((i * 53) % 60) / 100); if (x > w0 - 2 && x < w1 + 2 && y < Hm + 3) continue; m.disc(x, y, 2.2 + (i % 3), i % 2 ? T0.sh : T0.lt); } m.line(-Wh, -.2, Wh, -.2, T0.deep); }\n  m.rect(w0 - 1.2, 0, w0, Hm + .6, rock); m.rect(w1, 0, w1 + 1.2, Hm + .6, rock);\n  for (let i = 0; i < 10; i++) { const x0 = w0 - 1.2 + i / 10 * (w1 - w0 + 2.4), x1 = x0 + (w1 - w0 + 2.4) / 10; m.rect(x0, mouthTop(E.clamp((x0 + x1) / 2, w0, w1)) - .2, x1, mouthTop(E.clamp((x0 + x1) / 2, w0, w1)) + 1.2, i % 2 ? rock : E.tones(rock).sh); }\n  if (k > 4) m.text(th.label || '', (w0 + w1) / 2, mouthTop((w0 + w1) / 2) + 1.05, '#3a3a36', { font: 'tiny' });\n}, { w: 10, h: 9, near: 3 });\n\"\"\"\ns=s.replace(old,new)\ns=s.replace(\"maple: { trunk: '#5a3a28', leaf: '#d8502a', h: 6, r: 2.4 },\",\"maple: { trunk: '#5a3a28', leaf: '#b8563a', h: 6, r: 2.2 },\")\nopen(p,'w').write(s)\np='src/21b-route-builders.js'; s=open(p).read()\nold=\"\"\"      const nT = set.t.length ? Math.floor(r() * 3) : 0;\n      for (let i = 0; i < nT; i++) addThing(A.thing('tree', { s: s + r() * 50, x: edge + side * (4.5 + r() * (set.gap - 2)), sp: set.t[Math.floor(r() * set.t.length)], size: .8 + r() * .5, y: low }));\n      if (set.props.length && r() < .55) {\n        const pk = set.props[Math.floor(r() * set.props.length)], far = pk === 'crane' || pk === 'greenhouse' || pk === 'containers';\n        addThing(A.thing(pk, { s: s + 5 + r() * 40, x: edge + side * (far ? set.gap + 14 + r() * 20 : 4 + r() * 3), seed: Math.floor(r() * 50), y: low, rows: 1 + Math.floor(r() * 3), n: 2 + Math.floor(r() * 3), col: ['#f2c230', '#e84a6a', '#3aa0e0'][Math.floor(r() * 3)] }));\n      }\"\"\"\nnew=\"\"\"      const nT = set.t.length ? Math.floor(r() * 3) : 0;\n      for (let i = 0; i < nT; i++) addThing(A.thing('tree', { s: s + r() * 50, x: edge + side * (7 + r() * Math.max(2, set.gap)), sp: set.t[Math.floor(r() * set.t.length)], size: .8 + r() * .4, y