ent: 'node' },\n    performance: { now: () => Date.now() }, setTimeout, clearTimeout, setInterval, clearInterval, queueMicrotask, Promise };\n  ctx.window = ctx; ctx.self = ctx; ctx.globalThis = ctx;\n  if (o.AIHub) ctx.AIHub = o.AIHub;\n  vm.createContext(ctx);\n  vm.runInContext(ENGINE, ctx, { filename: 'engine/my-3d2dge.js' });\n  vm.runInContext(GAME, ctx, { filename: 'build/game.js' });\n  const E = ctx.My3D2dge, H = ctx.__thugby || {};\n  return { ctx, E, TT: H.TT, game: H.game || E.current };\n}\nEOF\nnode build.mjs && cat > /tmp/tt_smoke.mjs <<'EOF'\nimport { load } from '/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-065121__xa7e588/work/ThugbyTurbo-Rugby-claude-opus-5-5-xhigh-20261104-065121/test/lib/load.mjs';\nconst { TT } = load({ onError: a => console.log('ERR', ...a) });\nconst counts = {};\nTT.bus.on('*', (d, n) => { counts[n] = (counts[n] || 0) + 1; });\nfor (const seed of [1, 2, 3]) {\n  const m = new TT.Match({ home: 'mud', away: 'gul', venue: 'docks', seed, halfLen: 60, skipIntro: true });\n  let steps = 0; const phases = {};\n  try {\n    while (!m.over && steps < 120 * 600) { m.step(1 / 120); steps++; phases[m.phase] = (phases[m.phase] || 0) + 1; }\n  } catch (e) { console.log('THROW at', m.phase, m.sub, e.stack.split('\\n').slice(0, 6).join('\\n')); }\n  console.log('seed', seed, 'over', m.over, 'score', m.score, 'secs', (steps / 120).toFixed(0), 'half', m.half, JSON.stringify(Object.fromEntries(Object.entries(phases).map(([k, v]) => [k, Math.round(v / 120)]))), 'wd', m.counts.watchdog || 0);\n}\nconsole.log(JSON.stringify(counts));\nEOF\nnode /tmp/tt_smoke.mjs","description":"Build and run a headless CPU-vs-CPU smoke test","timeout":300000}}}
