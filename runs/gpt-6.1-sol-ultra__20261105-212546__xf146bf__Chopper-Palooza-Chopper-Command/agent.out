{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > tests/core-check.py <<'PY'\nimport json, threading, sys, os\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parents[1]\nos.chdir(ROOT)\nclass Quiet(SimpleHTTPRequestHandler):\n def log_message(self,*args): pass\nserver=ThreadingHTTPServer(('127.0.0.1',0),Quiet)\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nurl=f'http://127.0.0.1:{server.server_port}/index.html'\nchecks=[]; errors=[]\ndef check(name,condition,detail=''):\n checks.append({'name':name,'pass':bool(condition),'detail':detail if not condition else ''})\n if not condition: print(f'FAIL {name}: {detail}')\nPAD=\\\"\\\"\\\"window.__pads=[null,null];navigator.getGamepads=()=>window.__pads;window.makePad=(i)=>({id:'DualSense emulated',index:i,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),timestamp:0});\\\"\\\"\\\"\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n context=browser.new_context(viewport={'width':1280,'height':720})\n context.add_init_script(PAD)\n page=context.new_page();page.on('pageerror',lambda e:errors.append(str(e)))\n try:\n  page.goto(url);page.wait_for_function('window.__game?.ready',timeout=60000)\n  check('game identity',page.title()=='Chopper Palooza')\n  check('WebGPU backend',page.evaluate('__game.backend')=='WebGPU')\n  check('Rapier version',page.evaluate('__game.physicsVersion')=='0.19.3')\n  check('native animation clips',page.evaluate('__game.diagnostics.animations')>=3)\n  page.get_by_role('button',name='SETTINGS',exact=True).first.click()\n  check('music default',page.locator('#music').input_value()=='10')\n  page.locator('#music').fill('18');check('music live setting',page.evaluate('__game.audio.diagnostics().musicVolume')==.18)\n  page.locator('#music').fill('10');page.locator('#settingsScreen [data-action=back]').click()\n  page.evaluate('__game.start()')\n  s=page.evaluate('__game.state');check('fresh patrol',len(s['trucks'])==6 and len(s['ships'])==1 and len(s['pilots'])==2)\n  page.keyboard.down('d');page.evaluate('__game.step(1)');page.keyboard.up('d');s=page.evaluate('__game.state');check('keyboard flight',s['ships'][0]['x']>10)\n  page.keyboard.down('w');page.evaluate('__game.step(4)');page.keyboard.up('w');check('ceiling clamp',page.evaluate('__game.state.ships[0].y')<=33)\n  page.keyboard.down('Space');page.evaluate('__game.step(.5)');page.keyboard.up('Space');check('manual weapon',page.evaluate('__game.diagnostics.shotsFired')>=3)\n  page.evaluate('__game.start();__game.setShip(0,14);__game.spawn(\\\"heli\\\",8,14);__game.flare()');s=page.evaluate('__game.state');check('flare hits hostiles',s['kills']==1 and s['ships'][0]['flares']==2 and s['score']>=150)\n  page.evaluate('__game.start();__game.setShip(22,4);__game.step(1.2)');s=page.evaluate('__game.state');check('hover rescue',s['rescues']>=1 and s['ships'][0]['flares']==4 and s['score']>=600)\n  page.evaluate('__game.start();__game.setShip(0,14);__game.damageShip(120)');s=page.evaluate('__game.state');check('reserve respawn',s['ships'][0]['lives']==1 and s['ships'][0]['hp']==100)\n  page.evaluate('__game.setShip(0,14);__game.damageShip(120);__game.setShip(0,14);__game.damageShip(120)');check('ship loss debrief',page.evaluate('__game.mode')=='debrief' and not page.evaluate('__game.state.won'))\n  page.evaluate('__game.start();for(let i=0;i<6;i++)__game.damageTruck(i,1000)');check('convoy loss debrief',page.evaluate('__game.mode')=='debrief')\n  page.evaluate('__game.start();__game.pause()');page.locator('#pauseScreen [data-action=dev]').click()\n  page.locator('#dev-speed').fill('25');check('live balance slider',page.evaluate('__game.tuneValues.speed')==25)\n  page.locator('#devScreen [data-action=resetTune]').click();check('balance reset',page.evaluate('__game.tuneValues.speed')==17)\n  page.locator('#devScreen [data-action=back]').click();page.locator('#pauseScreen [data-action=resume]').click()\n  page.evaluate('__pads[0]=makePad(0);__pads[0].axes[0]=1;__game.step(1)');check('gamepad flight',page.evaluate('__game.state.ships[0].x')>10)\n  page.evaluate('__pads[0].axes[0]=0;__pads[0].buttons[9].pressed=true');page.wait_for_timeout(100);page.evaluate('__pads[0].buttons[9].pressed=false');check('gamepad pause',page.evaluate('__game.screen()')=='pause')\n  page.evaluate('__pads[0].buttons[13].pressed=true');page.wait_for_timeout(70);page.evaluate('__pads[0].buttons[13].pressed=false;__pads[0].buttons[0].pressed=true');page.wait_for_timeout(80);page.evaluate('__pads[0].buttons[0].pressed=false');check('gamepad menu navigation',page.evaluate('__game.screen()')=='settings')\n  page.locator('#glyphs').select_option('xbox');page.evaluate('__pads[0].axes[0]=.3');page.wait_for_timeout(60);page.evaluate('__pads[0].axes[0]=0');check('Xbox prompts', 'RT FIRE' in page.locator('#controls').inner_text())\n  page.locator('#glyphs').select_option('ps');page.evaluate('__game.menu(\\\"none\\\");__pads[1]=makePad(1);__pads[1].buttons[0].pressed=true');page.wait_for_timeout(90);page.evaluate('__pads[1].buttons[0].pressed=false');check('second pad join',len(page.evaluate('__game.state.ships'))==2)\n  page.evaluate('__pads=[null,null];__game.start();__game.upgrade(\\\"gun\\\");__game.upgrade(\\\"armor\\\")');s=page.evaluate('__game.state');check('field upgrades',s['stage']==2 and s['ships'][0]['maxHp']==125 and page.evaluate('__game.tuneValues.upgradePower')>1)\n  page.evaluate('__game.start()');check('run upgrades reset',page.evaluate('__game.tuneValues.upgradePower')==1 and page.evaluate('__game.tuneValues.upgradeSpeed')==1)\n  # The same input pilot used by attract mode flies and fights the entire campaign through Rapier.\n  page.evaluate('__game.start();__game.invincible(true);__game.pilot(true)')\n  campaign=page.evaluate('__game.step(260)')\n  check('whole campaign victory',campaign['won'] and campaign['finished'],json.dumps({k:campaign[k] for k in ['stage','totalTime','kills','rescues','finished','won']}))\n  check('all sectors and carrier',campaign['stage']==3 and campaign['bossSeen'] and campaign['upgrades']==3)\n  check('campaign real collisions',campaign['kills']>=12 and campaign['score']>=10000 and page.evaluate('__game.diagnostics.shotsFired')>100)\n  check('campaign rescue feature',campaign['rescues']>=1)\n  check('network packet size',len(json.dumps(campaign).encode())<15500)\n  page.evaluate('__game.pilot(false);__game.invincible(false)')\n  audio=page.evaluate('__game.offlineAudio()');check('offline procedural audio',audio['finite'] and .001<audio['rms']<.5 and audio['peak']<=1,str(audio))\n  page.evaluate('__game.title()');page.wait_for_function('__game.mode===\\\"attract\\\"',timeout=15000);check('10 second attract entry',page.evaluate('__game.mode')=='attract')\n  page.keyboard.press('ArrowRight');check('attract input exits',page.evaluate('__game.mode')=='title')\n  # Standalone main-game integration, as opposed to adapter-only traffic checks.\n  page.locator('[data-action=online]').first.click();page.locator('[data-action=host]').click();page.wait_for_function('document.getElementById(\\\"roomDisplay\\\").textContent.length===6');code=page.locator('#roomDisplay').inner_text()\n  guest=context.new_page();guest.on('pageerror',lambda e:errors.append(str(e)));guest.goto(url);guest.wait_for_function('window.__game?.ready',timeout=60000);guest.locator('[data-action=online]').first.click();guest.locator('#roomCode').fill(code);guest.locator('[data-action=join]').click();page.wait_for_function('__game.online.connected',timeout=15000);guest.wait_for_function('__game.online.connected',timeout=15000);guest.wait_for_timeout(350)\n  check('standalone two-player patrol',len(page.evaluate('__game.state.ships'))==2 and len(guest.evaluate('__game.state.ships'))==2)\n  x=page.evaluate('__game.state.ships[1].x');guest.keyboard.down('d');guest.wait_for_timeout(750);guest.keyboard.up('d');moved=page.evaluate('__game.state.ships[1].x');check('guest input reaches authority',moved>x+3,f'{x}->{moved}')\n  page.locator('#pauseButton').click();guest.wait_for_timeout(250);check('guest sees host pause',guest.locator('#attract').is_visible())\n  page.locator('#pauseScreen [data-action=title]').click();guest.wait_for_timeout(400);check('guest disconnect safe',guest.evaluate('__game.mode')=='disconnected' and guest.evaluate('__game.screen()')=='online');guest.close()\n  check('no browser runtime errors',not errors,'; '.join(errors))\n  # Test final standalone file directly, with no server required.\n  page.goto((ROOT.parent/(ROOT.name+'.html')).as_uri());page.wait_for_function('window.__game?.ready',timeout=60000);check('single file boot',page.title()=='Chopper Palooza' and page.evaluate('__game.ready'))\n  context.close()\n  touch=browser.new_context(viewport={'width':844,'height':390},has_touch=True,is_mobile=True,device_scale_factor=1)\n  mobile=touch.new_page();mobile.goto(url);mobile.wait_for_function('window.__game?.ready',timeout=60000);mobile.locator('[data-action=start]').tap();mobile.evaluate('__game.invincible(true)')\n  mobile.dispatch_event('#game','pointerdown',{'pointerId':7,'pointerType':'touch','clientX':110,'clientY':250,'bubbles':True});mobile.dispatch_event('#game','pointermove',{'pointerId':7,'pointerType':'touch','clientX':170,'clientY':210,'bubbles':True});mobile.wait_for_timeout(300)\n  check('touch flight and assistance',mobile.evaluate('__game.state.ships[0].x')>1 and mobile.evaluate('__game.diagnostics.shotsFired')>0)\n  check('touch minimal HUD',mobile.locator('#radarFrame').is_hidden())\n  mobile.dispatch_event('#game','pointerup',{'pointerId':7,'pointerType':'touch','clientX':170,'clientY':210,'bubbles':True});touch.close()\n except Exception as e: check('test execution',False,str(e))\n finally: browser.close();server.shutdown()\nPath('tests/core-results.json').write_text(json.dumps(checks,indent=2))\nfailed=sum(not c['pass'] for c in checks)\nprint(f'{len(checks)-failed}/{len(checks)} core checks passed')\nsys.exit(bool(failed))\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/core-check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > tests/core-check.py <<'PY'\nimport json, threading, sys, os\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parents[1]\nos.chdir(ROOT)\nclass Quiet(SimpleHTTPRequestHandler):\n def log_message(self,*args): pass\nserver=ThreadingHTTPServer(('127.0.0.1',0),Quiet)\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nurl=f'http://127.0.0.1:{server.server_port}/index.html'\nchecks=[]; errors=[]\ndef check(name,condition,detail=''):\n checks.append({'name':name,'pass':bool(condition),'detail':detail if not condition else ''})\n if not condition: print(f'FAIL {name}: {detail}')\nPAD=\\\"\\\"\\\"window.__pads=[null,null];navigator.getGamepads=()=>window.__pads;window.makePad=(i)=>({id:'DualSense emulated',index:i,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),timestamp:0});\\\"\\\"\\\"\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n context=browser.new_context(viewport={'width':1280,'height':720})\n context.add_init_script(PAD)\n page=context.new_page();page.on('pageerror',lambda e:errors.append(str(e)))\n try:\n  page.goto(url);page.wait_for_function('window.__game?.ready',timeout=60000)\n  check('game identity',page.title()=='Chopper Palooza')\n  check('WebGPU backend',page.evaluate('__game.backend')=='WebGPU')\n  check('Rapier version',page.evaluate('__game.physicsVersion')=='0.19.3')\n  check('native animation clips',page.evaluate('__game.diagnostics.animations')>=3)\n  page.get_by_role('button',name='SETTINGS',exact=True).first.click()\n  check('music default',page.locator('#music').input_value()=='10')\n  page.locator('#music').fill('18');check('music live setting',page.evaluate('__game.audio.diagnostics().musicVolume')==.18)\n  page.locator('#music').fill('10');page.locator('#settingsScreen [data-action=back]').click()\n  page.evaluate('__game.start()')\n  s=page.evaluate('__game.state');check('fresh patrol',len(s['trucks'])==6 and len(s['ships'])==1 and len(s['pilots'])==2)\n  page.keyboard.down('d');page.evaluate('__game.step(1)');page.keyboard.up('d');s=page.evaluate('__game.state');check('keyboard flight',s['ships'][0]['x']>10)\n  page.keyboard.down('w');page.evaluate('__game.step(4)');page.keyboard.up('w');check('ceiling clamp',page.evaluate('__game.state.ships[0].y')<=33)\n  page.keyboard.down('Space');page.evaluate('__game.step(.5)');page.keyboard.up('Space');check('manual weapon',page.evaluate('__game.diagnostics.shotsFired')>=3)\n  page.evaluate('__game.start();__game.setShip(0,14);__game.spawn(\\\"heli\\\",8,14);__game.flare()');s=page.evaluate('__game.state');check('flare hits hostiles',s['kills']==1 and s['ships'][0]['flares']==2 and s['score']>=150)\n  page.evaluate('__game.start();__game.setShip(22,4);__game.step(1.2)');s=page.evaluate('__game.state');check('hover rescue',s['rescues']>=1 and s['ships'][0]['flares']==4 and s['score']>=600)\n  page.evaluate('__game.start();__game.setShip(0,14);__game.damageShip(120)');s=page.evaluate('__game.state');check('reserve respawn',s['ships'][0]['lives']==1 and s['ships'][0]['hp']==100)\n  page.evaluate('__game.setShip(0,14);__game.damageShip(120);__game.setShip(0,14);__game.damageShip(120)');check('ship loss debrief',page.evaluate('__game.mode')=='debrief' and not page.evaluate('__game.state.won'))\n  page.evaluate('__game.start();for(let i=0;i<6;i++)__game.damageTruck(i,1000)');check('convoy loss debrief',page.evaluate('__game.mode')=='debrief')\n  page.evaluate('__game.start();__game.pause()');page.locator('#pauseScreen [data-action=dev]').click()\n  page.locator('#dev-speed').fill('25');check('live balance slider',page.evaluate('__game.tuneValues.speed')==25)\n  page.locator('#devScreen [data-action=resetTune]').click();check('balance reset',page.evaluate('__game.tuneValues.speed')==17)\n  page.locator('#devScreen [data-action=back]').click();page.locator('#pauseScreen [data-action=resume]').click()\n  page.evaluate('__pads[0]=makePad(0);__pads[0].axes[0]=1;__game.step(1)');check('gamepad flight',page.evaluate('__game.state.ships[0].x')>10)\n  page.evaluate('__pads[0].axes[0]=0;__pads[0].buttons[9].pressed=true');page.wait_for_timeout(100);page.evaluate('__pads[0].buttons[9].pressed=false');check('gamepad pause',page.evaluate('__game.screen()')=='pause')\n  page.evaluate('__pads[0].buttons[13].pressed=true');page.wait_for_timeout(70);page.evaluate('__pads[0].buttons[13].pressed=false;__pads[0].buttons[0].pressed=true');page.wait_for_timeout(80);page.evaluate('__pads[0].buttons[0].pressed=false');check('gamepad menu navigation',page.evaluate('__game.screen()')=='settings')\n  page.locator('#glyphs').select_option('xbox');page.evaluate('__pads[0].axes[0]=.3');page.wait_for_timeout(60);page.evaluate('__pads[0].axes[0]=0');check('Xbox prompts', 'RT FIRE' in page.locator('#controls').inner_text())\n  page.locator('#glyphs').select_option('ps');page.evaluate('__game.menu(\\\"none\\\");__pads[1]=makePad(1);__pads[1].buttons[0].pressed=true');page.wait_for_timeout(90);page.evaluate('__pads[1].buttons[0].pressed=false');check('second pad join',len(page.evaluate('__game.state.ships'))==2)\n  page.evaluate('__pads=[null,null];__game.start();__game.upgrade(\\\"gun\\\");__game.upgrade(\\\"armor\\\")');s=page.evaluate('__game.state');check('field upgrades',s['stage']==2 and s['ships'][0]['maxHp']==125 and page.evaluate('__game.tuneValues.upgradePower')>1)\n  page.evaluate('__game.start()');check('run upgrades reset',page.evaluate('__game.tuneValues.upgradePower')==1 and page.evaluate('__game.tuneValues.upgradeSpeed')==1)\n  # The same input pilot used by attract mode flies and fights the entire campaign through Rapier.\n  page.evaluate('__game.start();__game.invincible(true);__game.pilot(true)')\n  campaign=page.evaluate('__game.step(260)')\n  check('whole campaign victory',campaign['won'] and campaign['finished'],json.dumps({k:campaign[k] for k in ['stage','totalTime','kills','rescues','finished','won']}))\n  check('all sectors and carrier',campaign['stage']==3 and campaign['bossSeen'] and campaign['upgrades']==3)\n  check('campaign real collisions',campaign['kills']>=12 and campaign['score']>=10000 and page.evaluate('__game.diagnostics.shotsFired')>100)\n  check('campaign rescue feature',campaign['rescues']>=1)\n  check('network packet size',len(json.dumps(campaign).encode())<15500)\n  page.evaluate('__game.pilot(false);__game.invincible(false)')\n  audio=page.evaluate('__game.offlineAudio()');check('offline procedural audio',audio['finite'] and .001<audio['rms']<.5 and audio['peak']<=1,str(audio))\n  page.evaluate('__game.title()');page.wait_for_function('__game.mode===\\\"attract\\\"',timeout=15000);check('10 second attract entry',page.evaluate('__game.mode')=='attract')\n  page.keyboard.press('ArrowRight');check('attract input exits',page.evaluate('__game.mode')=='title')\n  # Standalone main-game integration, as opposed to adapter-only traffic checks.\n  page.locator('[data-action=online]').first.click();page.locator('[data-action=host]').click();page.wait_for_function('document.getElementById(\\\"roomDisplay\\\").textContent.length===6');code=page.locator('#roomDisplay').inner_text()\n  guest=context.new_page();guest.on('pageerror',lambda e:errors.append(str(e)));guest.goto(url);guest.wait_for_function('window.__game?.ready',timeout=60000);guest.locator('[data-action=online]').first.click();guest.locator('#roomCode').fill(code);guest.locator('[data-action=join]').click();page.wait_for_function('__game.online.connected',timeout=15000);guest.wait_for_function('__game.online.connected',timeout=15000);guest.wait_for_timeout(350)\n  check('standalone two-player patrol',len(page.evaluate('__game.state.ships'))==2 and len(guest.evaluate('__game.state.ships'))==2)\n  x=page.evaluate('__game.state.ships[1].x');guest.keyboard.down('d');guest.wait_for_timeout(750);guest.keyboard.up('d');moved=page.evaluate('__game.state.ships[1].x');check('guest input reaches authority',moved>x+3,f'{x}->{moved}')\n  page.locator('#pauseButton').click();guest.wait_for_timeout(250);check('guest sees host pause',guest.locator('#attract').is_visible())\n  page.locator('#pauseScreen [data-action=title]').click();guest.wait_for_timeout(400);check('guest disconnect safe',guest.evaluate('__game.mode')=='disconnected' and guest.evaluate('__game.screen()')=='online');guest.close()\n  check('no browser runtime errors',not errors,'; '.join(errors))\n  # Test final standalone file directly, with no server required.\n  page.goto((ROOT.parent/(ROOT.name+'.html')).as_uri());page.wait_for_function('window.__game?.ready',timeout=60000);check('single file boot',page.title()=='Chopper Palooza' and page.evaluate('__game.ready'))\n  context.close()\n  touch=browser.new_context(viewport={'width':844,'height':390},has_touch=True,is_mobile=True,device_scale_factor=1)\n  mobile=touch.new_page();mobile.goto(url);mobile.wait_for_function('window.__game?.ready',timeout=60000);mobile.locator('[data-action=start]').tap();mobile.evaluate('__game.invincible(true)')\n  mobile.dispatch_event('#game','pointerdown',{'pointerId':7,'pointerType':'touch','clientX':110,'clientY':250,'bubbles':True});mobile.dispatch_event('#game','pointermove',{'pointerId':7,'pointerType':'touch','clientX':170,'clientY':210,'bubbles':True});mobile.wait_for_timeout(300)\n  check('touch flight and assistance',mobile.evaluate('__game.state.ships[0].x')>1 and mobile.evaluate('__game.diagnostics.shotsFired')>0)\n  check('touch minimal HUD',mobile.locator('#radarFrame').is_hidden())\n  mobile.dispatch_event('#game','pointerup',{'pointerId':7,'pointerType':'touch','clientX':170,'clien