{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '260,310p' audio.js && sed -n '65,85p' visuals.js && sed -n '570,600p' main.js && cat tests/hub-check.py | head -80\"","aggregated_output":"\t\t\tcase \"shoot\":\n\t\t\t\ttone(740 + this.random() * 80, 0.065, 0.105, \"triangle\", 0, 210);\n\t\t\t\tthis.noise(0.045, 0.12, t, 1900);\n\t\t\t\tbreak;\n\t\t\tcase \"hit\":\n\t\t\t\tthis.noise(0.12, 0.31, t, 1100);\n\t\t\t\ttone(170, 0.13, 0.18, \"square\", 0, 65);\n\t\t\t\tbreak;\n\t\t\tcase \"boom\":\n\t\t\t\tthis.noise(0.65, 0.9, t, 470, null, \"lowpass\");\n\t\t\t\tthis.noise(0.24, 0.36, t, 1700);\n\t\t\t\ttone(132, 0.48, 0.45, \"sine\", 0, 28);\n\t\t\t\tbreak;\n\t\t\tcase \"rescue\":\n\t\t\tcase \"pickup\":\n\t\t\t\t[523.25, 659.25, 783.99, 1046.5].forEach((n, i) =>\n\t\t\t\t\ttone(n, 0.22, 0.15, \"triangle\", i * 0.08),\n\t\t\t\t);\n\t\t\t\tbreak;\n\t\t\tcase \"flare\":\n\t\t\t\tthis.noise(0.7, 0.6, t, 2600);\n\t\t\t\ttone(190, 0.45, 0.24, \"sine\", 0, 1200);\n\t\t\t\ttone(850, 0.5, 0.1, \"triangle\", 0.06, 90);\n\t\t\t\tbreak;\n\t\t\tcase \"menu\":\n\t\t\t\ttone(660, 0.07, 0.09, \"sine\");\n\t\t\t\ttone(880, 0.05, 0.07, \"sine\", 0.04);\n\t\t\t\tbreak;\n\t\t\tcase \"start\":\n\t\t\t\t[220, 330, 440, 660].forEach((n, i) =>\n\t\t\t\t\ttone(n, 0.26, 0.17, \"triangle\", i * 0.09),\n\t\t\t\t);\n\t\t\t\tbreak;\n\t\t\tcase \"victory\":\n\t\t\t\t[440, 554.37, 659.25, 880, 659.25, 880, 1108.73].forEach((n, i) =>\n\t\t\t\t\ttone(n, i === 6 ? 0.8 : 0.32, 0.17, \"triangle\", i * 0.16),\n\t\t\t\t);\n\t\t\t\tbreak;\n\t\t\tcase \"loss\":\n\t\t\t\t[440, 392, 329.63, 220].forEach((n, i) =>\n\t\t\t\t\ttone(n, 0.47, 0.17, \"triangle\", i * 0.22),\n\t\t\t\t);\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\ttone(440, 0.08, 0.06, \"sine\");\n\t\t}\n\t}\n\n\tvoice(seed = \"copy\") {\n\t\tif (!this.ready) return;\n\t\tconst c = this.context,\n\t\tcolor,\n\t\toutline,\n\t);\n\tm.position.copy(start).add(end).multiplyScalar(0.5);\n\tm.quaternion.setFromUnitVectors(\n\t\tnew THREE.Vector3(0, 1, 0),\n\t\tend.sub(start).normalize(),\n\t);\n\tparent.add(m);\n\treturn m;\n}\nfunction profile(parent, points, depth, color, z = 0) {\n\tconst s = new THREE.Shape();\n\tpoints.forEach(([x, y], i) => (i ? s.lineTo(x, y) : s.moveTo(x, y)));\n\ts.closePath();\n\tconst geo = new THREE.ExtrudeGeometry(s, { depth, bevelEnabled: false });\n\tgeo.translate(0, 0, -depth / 2);\n\tconst m = mesh(geo, color);\n\tm.position.z = z;\n\tparent.add(m);\n\treturn m;\n\t\t\ttoast(\n\t\t\t\t\"BACK IN THE AIR\",\n\t\t\t\t`${e.lives} REPLACEMENT${e.lives === 1 ? \"\" : \"S\"} LEFT`,\n\t\t\t);\n\t\t} else {\n\t\t\te.hp = 0;\n\t\t\te.inactive = true;\n\t\t\te.mesh.visible = false;\n\t\t\tif (ships.every((s) => s.inactive))\n\t\t\t\tendGame(false, \"Out of choppers. The convoy will remember you.\");\n\t\t}\n\t} else if (e.type === \"truck\") {\n\t\te.hp = 0;\n\t\tburst(e.x, 2, palette.coral, 35, 1.7);\n\t\te.mesh.rotation.z = -0.1;\n\t\te.mesh.children.forEach((m) => {\n\t\t\tif (m.material?.color)\n\t\t\t\t(m.material = m.material.clone()), m.material.color.multiplyScalar(0.5);\n\t\t});\n\t\taudio.sfx(\"boom\");\n\t\tradio(\"Truck down! Keep those raiders off the road.\", 3);\n\t\tif (trucks.every((t) => t.hp <= 0))\n\t\t\tendGame(false, \"The road went quiet. Every truck was lost.\");\n\t} else {\n\t\tcombo = comboTime > 0 ? combo + 1 : 1;\n\t\tcomboTime = 2.5;\n\t\tkills++;\n\t\tscore +=\n\t\t\t(e.type === \"boss\"\n\t\t\t\t? 8000\n\t\t\t\t: e.kind === \"ace\"\n\"\"\"Run the unmodified AI Hub harness against the bundled game.\n\nUses one browser, one harness page at a time, and a temporary OS-assigned\nloopback port. All files and the result record stay in this game folder.\n\"\"\"\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nimport json\nfrom pathlib import Path\nfrom threading import Thread\nfrom urllib.parse import urlencode\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent.parent\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef run():\n    failures = []\n    total = 0\n    records = []\n    server = ThreadingHTTPServer(\n        ('127.0.0.1', 0), partial(QuietHandler, directory=str(ROOT))\n    )\n    Thread(target=server.serve_forever, daemon=True).start()\n    origin = f'http://127.0.0.1:{server.server_port}'\n    try:\n        if not (ROOT / 'index.html').is_file():\n            raise FileNotFoundError('Run npm run build before the Hub checks.')\n        with sync_playwright() as playwright:\n            browser = playwright.chromium.launch(\n                headless=True,\n                args=[\n                    '--enable-unsafe-webgpu',\n                    '--enable-features=Vulkan',\n                    '--use-webgpu-adapter=swiftshader',\n                    '--autoplay-policy=no-user-gesture-required',\n                ],\n            )\n            try:\n                for scenario in ('standard', 'host-leave', 'server'):\n                    context = browser.new_context(\n                        viewport={'width': 900, 'height': 560},\n                        device_scale_factor=1,\n                        ignore_https_errors=True,\n                    )\n                    try:\n                        page = context.new_page()\n                        query = urlencode({\n                            'game': '../index.html',\n                            'players': 2,\n                            'auto': 1,\n                            'limit': 10,\n                            'play': 4000,\n                            'latency': 150,\n                            'jitter': 50,\n                            'loss': 5,\n                            'scenario': scenario,\n                        })\n                        page.goto(\n                            f'{origin}/hub-reference/harness.html?{query}',\n                            wait_until='domcontentloaded',\n                        )\n                        if page.title() != 'AI Hub Session Harness':\n                            raise RuntimeError('Loopback page is not the AI Hub harness')\n                        page.wait_for_function(\n                            'document.body.dataset.complete === \"true\"',\n                            timeout=120_000,\n                        )\n                        report = page.evaluate('window.__hubCheck')\n                        gameplay = []\n                        for frame in page.frames[1:]:\n                            sample = frame.evaluate('''() => {\n                              const game = window.__game;\n                              if (!game?.ready) return null;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='main.js';s=open(p).read();s=s.replace('if (event.detail > 0) inputUsed(\\\"keyboard\\\");','if (event.detail > 0) inputUsed(event.pointerType === \\\"touch\\\" ? \\\"touch\\\" : \\\"keyboard\\\");')\ns=s.replace('(m.material = m.material.clone()), m.material.color.multiplyScalar(0.5);','{m.material = m.material.clone();m.material.color.multiplyScalar(0.5);}')\nneedle='window.addEventListener(\\\"contextmenu\\\", (e) => e.preventDefault());'\ns=s.replace(needle,needle+'\\\\nwindow.addEventListener(\\\"pointermove\\\",e=>{if(e.pointerType\"'!==\"touch\"&&(gameMode===\"title\"||gameMode===\"attract\")){inputUsed(\"keyboard\");if(gameMode===\"attract\")title()}});'\"')\ns=s.replace('updateHUD();\\\\n\\\\tif (online.connected)', '\"'$ (\"touchHint\").style.opacity=totalTime>10?\"0\":\"1\";'\"\\\\n\\\\tupdateHUD();\\\\n\\\\tif (online.connected)')\nopen(p,'w').write(s)\np='audio.js';s=open(p).read();s=s.replace('=>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\ttone(', '=> {\\\\n\\\\t\\\\t\\\\t\\\\t\\\\ttone(');s=s.replace('i * 0.08),\\\\n\\\\t\\\\t\\\\t\\\\t);','i * 0.08);},\\\\n\\\\t\\\\t\\\\t\\\\t);').replace('i * 0.09),\\\\n\\\\t\\\\t\\\\t\\\\t);','i * 0.09);},\\\\n\\\\t\\\\t\\\\t\\\\t);').replace('i * 0.16),\\\\n\\\\t\\\\t\\\\t\\\\t);','i * 0.16);},\\\\n\\\\t\\\\t\\\\t\\\\t);').replace('i * 0.22),\\\\n\\\\t\\\\t\\\\t\\\\t);','i * 0.22);},\\\\n\\\\t\\\\t\\\\t\\\\t);');open(p,'w').write(s)\np='visuals.js';s=open(p).read().replace('points.forEach(([x, y], i) => (i ? s.lineTo(x, y) : s.moveTo(x, y)));','points.forEach(([x, y], i) => {if(i)s.lineTo(x,y);else s.moveTo(x,y)});');open(p,'w').write(s)\np='index.template.html';s=open(p).read().replace('TAP RIGHT: FLARE','DOUBLE-TAP RIGHT: FLARE').replace('#convoyHud{position:', '#convoyHud{background:#103137dd;padding:10px 15px;position:').replace('HOW TO FLY</button>', 'HOW TO FLY</button>');open(p,'w').write(s)\np='tests/core-check.py';s=open(p).read().replace(\\\"check('whole campaign victory',\\\", \\\"Path('tests/playthrough.json').write_text(json.dumps(campaign,indent=2))\\\\n  check('whole campaign victory',\\\")\ns=s.replace(\\\"page.keyboard.press('ArrowRight');check('attract input exits'\\\", \\\"page.evaluate('__game.step(230)');check('attract loop remains healthy',page.evaluate('__game.mode')=='attract' and page.evaluate('__game.state.totalTime')<210)\\\\n  page.keyboard.press('ArrowRight');check('attract input exits'\\\")\n# Capture runtime errors after the touch context too, as it exercises a separate input path.\nopen(p,'w').write(s)\nPY\nbiome format --write main.js audio.js visuals.js > /dev/null\ncat > tests/run_tests.py <<'PY'\n\\\"\\\"\\\"Single quiet entry point for all game, audio, controller and network checks.\\\"\\\"\\\"\nimport os,re,subprocess,sys\nfrom pathlib import Path\nroot=Path(__file__).resolve().parents[1];os.chdir(root)\ntotal=passed=0\nfor script in ['tests/core-check.py','hub-reference/test-online.py','tests/hub-check.py']:\n p=subprocess.run([sys.executable,script],capture_output=True,text=True)\n output=p.stdout+p.stderr\n match=re.search(r'(\\\\d+)\\\\s*/\\\\s*(\\\\d+)[\"'^'\"\\\\n]*(?:passed|checks)',output,re.I)\n if match: passed+=int(match[1]);total+=int(match[2])\n else:\n  # The adapter runner emits \\\"13/13 online checks passed\\\"; other forms are a failure.\n  total+=1\n if p.returncode:\n  lines=[l for l in output.splitlines() if l.startswith('FAIL')]\n  print('\\\\n'.join(lines) if lines else f'FAIL {script}: {output[-2500:]}')\nprint(f'{passed}/{total} checks passed')\nsys.exit(passed\"'!=total)\nPY\nnode -e \"const fs=require('\"'fs');const p=JSON.parse(fs.readFileSync('package.json'));p.scripts.test='/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/run_tests.py';fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\\\n')\\\"\nnpm run build && npm test\"","aggregated_output":"","exit_code":null,"status":"in_prog