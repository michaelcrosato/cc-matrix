)){if(focus?.tagName==='BUTTON')focus.click();else if(focus?.type==='checkbox'){focus.checked=\"'!focus.checked;focus.dispatchEvent(new Event('\"'change'))}else if(focus?.tagName==='SELECT'){focus.selectedIndex=(focus.selectedIndex+1)%focus.options.length;focus.dispatchEvent(new Event('change'))}}if(pressed(1)&&screen\"'!=='\"'title')menuBack()}gamepadPrev[i]=p.buttons.map(b=>b.pressed)}}\nfunction resize(){if(\"'!renderer)return;const aspect=innerWidth/innerHeight;const h=aspect<1?59:43;camera.left=-h*aspect/2;camera.right=h*aspect/2;camera.top=h/2;camera.bottom=-h/2;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)}window.addEventListener('\"'resize',resize);\nfunction animate(ms){const dt=Math.min(.06,(ms-lastTick)/1000||.016);lastTick=ms;idle+=dt;pollGamepad(dt);if(screen==='title'&&idle>10&&\"'!online.hub)startGame(true);if(online.connected&&!online.isHost){if(!online.ended)online.sendInput(readInput(0));for(const e of entities)e.mesh.userData.mixer?.update(dt)}else if(!testMode){accum+=dt;while(accum>=1/60){simulate(1/60);accum-=1/60}}if(gameMode==='\"'title'){const s=ships[0];if(s){s.y=17+Math.sin(ms*.001)*.6;s.mesh.position.set(18,s.y,3);s.mesh.rotation.z=Math.sin(ms*.0006)*.04;s.mesh.userData.mixer?.update(dt)}for(const e of entities)if(e\"'!==s)e.mesh.userData.mixer?.update(dt);for(let i=0;i<trucks.length;i++){trucks[i].mesh.position.x=-13+i*12+Math.sin(ms*.0001)*2}}\nconst followed=ships[online.connected?online.seat:0]||ships[0];let target=gameMode==='\"'title'?5:followed?followed.x+followed.face*9:0;if(Math.abs(cameraX-target)>120)cameraX=target;cameraX=THREE.MathUtils.damp(cameraX,target,3,dt);shake=Math.max(0,shake-dt);flash=Math.max(0,flash-dt*2);const j=settings.reducedShake?0:shake;camera.position.set(cameraX+Math.sin(ms*.09)*j,19+Math.cos(ms*.12)*j,70);camera.lookAt(cameraX,18,0);worldVisual.update(dt,cameraX,ms/1000);if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)\"'$('\"'toast').classList.remove('show')}if(radioTimer>0){radioTimer-=dt;if(radioTimer<=0)\"'$('\"'radio').style.display='none'}\"'$('\"'damageFlash').style.opacity=flash;audio.update(dt,{playing:screen==='none'&&gameMode==='play'&&\"'!online.ended,throttle:Math.hypot(followed?.vx||0,followed?.vy||0)/25,danger:trucks.filter(t=>t.hp>0).length<3,boss:stage===3});updateHUD();if(online.connected)online.tick(dt,getSnapshot());renderer.render(scene,camera)}\nasync function init(){try{initUI();await RAPIER.init();physics=new RAPIER.World({x:0,y:0,z:0});queue=new RAPIER.EventQueue(true);scene=new THREE.Scene();scene.background=new THREE.Color(palette.sky);scene.fog=new THREE.Fog(palette.sky,110,260);camera=new THREE.OrthographicCamera(-40,40,21.5,-21.5,.1,300);renderer=new THREE.WebGPURenderer({canvas:$('\"'game'),antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=.9;await renderer.init();worldVisual=createWorld(scene);resize();title();\"'$('\"'loading').style.display='none';renderer.setAnimationLoop(animate);await online.initHub();window.__game={ready:true,get state(){return getSnapshot()},get mode(){return gameMode},get backend(){return renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2 fallback'},get physicsVersion(){return RAPIER.version()},get audio(){return audio},get online(){return{role:online.role,hub:online.hub,connected:online.connected,server:online.server,canPlay:online.canPlay}},start:()=>{testMode=true;startGame()},step:seconds=>{testMode=true;for(let i=0;i<Math.round(seconds*60);i++)simulate(1/60);updateHUD();return getSnapshot()},realtime:()=>{testMode=false},pilot:value=>{testPilot=value},tune:values=>{Object.assign(tune,values);syncDev()},invincible:value=>{godMode=value},spawn:(kind,x,y)=>{const e=spawnEnemy(kind,x,y);return e.id},damageShip:amount=>damage(ships[0],amount),damageTruck:(index,amount)=>damage(trucks[index],amount),setShip:(x,y)=>{ships[0].x=x;ships[0].y=y;ships[0].inv=0},flare:()=>flare(ships[0]),rescue:()=>spawnPilot(ships[0].x),boss:spawnBoss,upgrade:applyUpgrade,pause,screen:()=>screen,menu:name=>showScreen(name),title,devDefaults:()=>({...defaults}),get tuneValues(){return{...tune}},get diagnostics(){return{entities:entities.length,physicsBodies:physics.bodies.len(),animations:entities.filter(e=>e.mesh.userData.mixer).length,audio:audio.diagnostics(),shotsFired,combo,pilots:pilots.length,testMode}},offlineAudio:async()=>{const ctx=new OfflineAudioContext(2,96000,48000);const a=new AudioEngine({context:ctx});await a.start();a.update(.016,{playing:true,throttle:1,boss:true});for(const n of ['shoot','hit','boom','rescue','flare','pickup','menu','start','victory','loss'])a.sfx(n);a.voice('Lucky');const buf=await ctx.startRendering();let sum=0,peak=0,finite=true;for(const v of buf.getChannelData(0)){sum+=v*v;peak=Math.max(peak,Math.abs(v));if(\"'!Number.isFinite(v))finite=false}return{rms:Math.sqrt(sum/buf.length),peak,finite,stats:a.diagnostics()}}};}catch(error){console.error(error);$('\"'loading').style.display='flex';\"'$('\"'loadError').textContent='Unable to start the patrol: '+error.message+'. Use a browser with WebGPU or WebGL 2 enabled.';globalThis.AIHub?.fail?.(error.message);window.__game={ready:false,error:error.message}}}\ninit();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The flight, combat, rescue, and campaign systems are now connected. The game also has native rotor animations, procedural music and radio chatter, local co-op, and AI Hub networking. I’m moving into browser checks next: a full campaign playthrough, damage and rescue behavior, controller navigation, and two-player synchronization."}}
