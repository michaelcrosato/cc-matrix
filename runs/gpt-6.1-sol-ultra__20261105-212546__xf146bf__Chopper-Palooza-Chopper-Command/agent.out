{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > index.template.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<!-- HUB_SESSION -->\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:players\" content=\"1-2\"><meta name=\"hub:mode\" content=\"shared-world\"><meta name=\"hub:genre\" content=\"Shooter\"><meta name=\"hub:goal\" content=\"Escort the convoy, rescue pilots, destroy the command carrier.\"><meta name=\"hub:howto\" content=\"Left stick flies; R2 fires; Circle flares; Cross rescues. WASD, mouse, Q, E on keyboard.\"><meta name=\"hub:minutes\" content=\"5\"><meta name=\"hub:requires\" content=\"webgpu\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\"><meta name=\"theme-color\" content=\"#102f35\"><title>Chopper Palooza</title>\n<style>\n:root{--ink:#10333a;--paper:#fff0cf;--gold:#ffc757;--red:#f27151;--mint:#67dbc0;--line:rgba(255,240,207,.24)}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:var(--ink);color:var(--paper);font-family:Trebuchet MS,Arial,sans-serif;user-select:none}button,input,select{font:inherit}button{cursor:pointer}canvas#game{position:fixed;inset:0;width:100%;height:100%;touch-action:none}button{color:var(--paper);border:1px solid var(--line);background:#153b40;padding:15px 24px;text-align:left;font-size:21px;font-weight:800;letter-spacing:.03em;border-radius:3px;transition:background .12s,transform .12s;min-height:58px}button:hover,button:focus-visible{background:var(--gold);color:var(--ink);outline:3px solid var(--paper);outline-offset:3px;transform:translateX(3px)}button.primary{background:var(--gold);color:var(--ink);border-color:var(--gold)}button.small{font-size:16px;min-height:42px;padding:9px 15px}.screen{display:none;position:fixed;inset:0;z-index:10;align-items:center;justify-content:center;background:rgba(7,29,34,.83);backdrop-filter:blur(6px);padding:32px}.screen.open{display:flex}.panel{width:min(680px,94vw);max-height:92vh;overflow-y:auto;padding:34px 42px;background:#12343bee;border:1px solid #789484;box-shadow:12px 12px 0 #071e2666}.eyebrow{font-size:14px;font-weight:900;letter-spacing:.26em;color:var(--gold);text-transform:uppercase}h1,h2,h3,p{margin:0}h2{font-size:48px;letter-spacing:-.04em;margin:8px 0 22px;text-transform:uppercase;font-style:italic}h3{font-size:22px;margin:14px 0 8px}p{font-size:19px;line-height:1.5;color:#e1e4d3}.stack{display:grid;gap:10px}.row{display:flex;gap:12px;align-items:center}.row>*{flex:1}.back{margin-top:20px;width:100%}.muted{color:#a4bdba;font-size:15px}.labelrow{display:flex;justify-content:space-between;gap:20px;font-size:19px;margin-top:18px}input[type=range]{width:100%;accent-color:var(--gold);height:26px;cursor:pointer}input[type=checkbox]{accent-color:var(--gold);width:24px;height:24px}select,input[type=text]{background:#214b4c;color:var(--paper);border:1px solid #789484;padding:12px;font-size:21px;min-width:0}input[type=text]{text-transform:uppercase;letter-spacing:.15em;width:100%}#titleScreen{background:linear-gradient(90deg,rgba(10,39,44,.97) 0%,rgba(10,39,44,.91) 32%,rgba(10,39,44,.18) 72%,transparent);backdrop-filter:none;justify-content:flex-start;padding:5vw}#titleBody{width:550px;max-width:53vw}#titleScreen h1{font-size:clamp(60px,7.8vw,124px);font-weight:1000;line-height:.86;letter-spacing:-.075em;font-style:italic;margin:26px 0 25px;filter:drop-shadow(5px 6px 0 #0b2329)}#titleScreen h1 span{color:var(--gold)}#titleScreen .tagline{font-size:clamp(17px,1.65vw,26px);font-weight:900;letter-spacing:.04em;margin-bottom:32px}#titleScreen .stack{max-width:380px}.edition{position:absolute;right:36px;top:32px;text-align:right;font-size:13px;letter-spacing:.2em;color:#284e4e;font-weight:900;line-height:1.8}.edition strong{font-size:23px;letter-spacing:.04em}#titleFooter{position:absolute;bottom:26px;left:5vw;font-size:13px;letter-spacing:.08em;color:#90aaa7}.stripe{display:inline-block;width:37px;height:8px;background:var(--gold);transform:skewX(-25deg);margin-right:5px}#hud{pointer-events:none;display:none;position:fixed;inset:0;z-index:3;padding:23px 30px}#hud.visible{display:block}.hud-top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.hud-card{background:rgba(13,46,51,.94);border:1px solid #839f90;padding:13px 18px;box-shadow:4px 5px 0 #092a3033}.pilot-hud{width:250px}.hud-small{font-size:12px;letter-spacing:.2em;color:#a3c4ba;font-weight:900}.hud-big{font-size:25px;font-weight:900;letter-spacing:.04em}.hull{display:flex;gap:4px;margin-top:10px}.hull i{flex:1;height:10px;background:var(--mint)}.hull i.off{background:#315359}#score{color:var(--gold);font-variant-numeric:tabular-nums}.mission{text-align:center;position:absolute;left:50%;top:24px;transform:translateX(-50%);min-width:280px}.mission .eyebrow{font-size:12px}.mission b{font-size:19px;display:block;margin-top:5px}#radarFrame{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);width:min(480px,40vw);padding:9px 12px 7px;background:#103137ed;border:1px solid #809e8c}#radar{width:100%;height:65px;display:block}#radarFrame .hud-small{font-size:10px;display:flex;justify-content:space-between}#controls{position:absolute;bottom:27px;left:30px;font-size:15px;line-height:1.9;text-shadow:1px 2px 1px #10333a;font-weight:800}#convoyHud{position:absolute;right:30px;bottom:27px;text-align:right}.truck-icons{display:flex;gap:7px;justify-content:flex-end;margin:9px 0}.truck-icons i{width:25px;height:15px;background:var(--gold);border:2px solid var(--paper);display:block;transform:skewX(-8deg)}.truck-icons i.dead{background:#6a4c41;border-color:#9b7660}#pauseButton{position:fixed;right:28px;top:104px;z-index:6;display:none;min-height:38px;padding:7px 13px;font-size:14px}#toast{position:fixed;top:24%;left:50%;transform:translateX(-50%);z-index:7;text-align:center;pointer-events:none;opacity:0;transition:opacity .2s;min-width:380px}#toast.show{opacity:1}#toast strong{font-size:36px;font-weight:1000;font-style:italic;letter-spacing:-.03em;display:block;text-shadow:3px 3px #163638}#toast span{font-size:17px;background:var(--ink);padding:6px 15px;display:inline-block;margin-top:8px;color:var(--gold)}#radio{position:fixed;left:30px;bottom:142px;z-index:4;max-width:420px;padding:14px 20px;background:#10373aeb;border-left:5px solid var(--gold);display:none}#radio b{font-size:12px;letter-spacing:.17em;color:var(--gold)}#radio p{font-size:17px;line-height:1.4;margin-top:5px}#bossHud{display:none;position:fixed;bottom:122px;left:50%;transform:translateX(-50%);width:340px;z-index:4;text-align:center}#bossHud .bar{height:11px;background:#243e42;border:1px solid #f5c388;margin-top:6px}#bossFill{height:100%;background:var(--red)}#attract{display:none;position:fixed;bottom:130px;left:50%;transform:translateX(-50%);z-index:5;background:var(--gold);color:var(--ink);padding:12px 24px;font-size:17px;letter-spacing:.08em;font-weight:900;animation:blink 2s infinite}#loading{position:fixed;inset:0;background:var(--ink);z-index:100;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:20px}#loading strong{font-size:38px;font-style:italic;color:var(--gold)}#loading p{font-size:17px}#loadError{max-width:650px;text-align:center}#touchHint{position:fixed;bottom:18px;left:20px;right:20px;text-align:center;font-size:13px;pointer-events:none;display:none;color:#f9edcf;z-index:5}#rescueAction{position:fixed;bottom:23%;right:10%;z-index:6;display:none;border-radius:50%;width:90px;height:90px;text-align:center;font-size:15px;padding:0;background:var(--gold);color:var(--ink)}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.info-grid article{border:1px solid var(--line);padding:18px}.info-grid p{font-size:17px}#creditsPanel{width:min(900px,94vw)}.credit-line{font-size:16px;line-height:1.6;border-bottom:1px solid #ffffff13;padding:5px 0;user-select:text}.credit-line b{color:var(--gold)}#netStatus{min-height:50px;font-size:17px;color:var(--mint);margin:16px 0}#roomDisplay{font-size:35px;color:var(--gold);letter-spacing:.1em}#debriefStats{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin:20px 0}.stat{background:#20494a;padding:18px}.stat b{font-size:33px;display:block;color:var(--gold)}.stat span{font-size:14px;letter-spacing:.08em}.dev-note{font-size:13px;color:#a4b8ae;margin-bottom:8px}#damageFlash{position:fixed;inset:0;pointer-events:none;z-index:2;box-shadow:inset 0 0 90px #f16751;opacity:0}@keyframes blink{50%{opacity:.55}}@media(max-height:700px){.screen{padding:15px}.panel{padding:23px 30px}button{min-height:47px;padding:10px 18px;font-size:18px}h2{font-size:37px;margin-bottom:15px}#titleScreen h1{margin:15px 0}.tagline{margin-bottom:20px!important}#titleFooter{bottom:12px}.labelrow{margin-top:11px}#radio{bottom:126px}}@media(max-width:750px){#titleBody{max-width:75vw}#titleScreen h1{font-size:clamp(52px,12vw,90px)}#titleScreen .stack{max-width:300px}.edition{font-size:9px;right:15px;top:16px}.edition strong{font-size:15px}#hud{padding:12px}.pilot-hud{width:155px}.hud-card{padding:9px 11px}.hud-big{font-size:18px}.hud-small{font-size:10px}.mission{top:15px;min-width:170px}.mission b{font-size:13px}.mission .eyebrow{font-size:9px}#scoreCard{min-width:90px}#controls{display:none}#radarFrame{width:43vw;bottom:18px}#convoyHud{right:13px;bottom:20px}.truck-icons{gap:3px}.truck-icons i{width:15px;height:11px}#radio{left:14px;bottom:116px;max-width:280px;padding:10px 12px}#radio p{font-size:14px}#radio b{font-size:10px}.info-grid{grid-template-columns:1fr}.panel{padding:22px}#titleFooter{font-size:9px}#toast strong{font-size:28px}#pauseButton{right:13px;top:85px}#bossHud{bottom:112px;width:250px}}\n</style></head><body>\n<canvas id=\"game\" aria-label=\"Chopper Palooza game battlefield\"></canvas><div id=\"damageFlash\"></div>\n<div id=\"loading\"><div class=\"eyebrow\">DESERT AIR PATROL · 1982 / REIMAGINED</div><strong>CHOPPER PALOOZA</strong><p id=\"loadError\">Warming up the rotors…</p></div>\n<div id=\"hud\"><div class=\"hud-top\"><div class=\"hud-card pilot-hud\"><div class=\"hud-small\" id=\"pilotLabel\">01 / LUCKY</div><div class=\"hud-big\" id=\"lifeLabel\">HULL 100</div><div id=\"hull\" class=\"hull\"></div></div><div class=\"mission\"><div class=\"eyebrow\" id=\"sectorLabel\">SECTOR 01 / DUST UP</div><b id=\"objective\">KEEP THE CONVOY ROLLING</b></div><div class=\"hud-card\" id=\"scoreCard\"><div class=\"hud-small\">HIGH <span id=\"highScore\">000000</span></div><div class=\"hud-big\" id=\"score\">000000</div></div></div><div id=\"controls\"></div><div id=\"radarFrame\"><div class=\"hud-small\"><span>TACTICAL RADAR</span><span>◀ 180 KM ▶</span></div><canvas id=\"radar\" width=\"620\" height=\"82\"></canvas></div><div id=\"convoyHud\"><div class=\"hud-small\">CONVOY INTEGRITY</div><div id=\"trucks\" class=\"truck-icons\"></div><div id=\"cargoLabel\" class=\"hud-big\">6 / 6</div></div></div>\n<button id=\"pauseButton\" aria-label=\"Pause game\">Ⅱ MENU</button><div id=\"toast\"><strong></strong><span></span></div><div id=\"radio\"><b>● CONVOY RADIO / DUSTY</b><p></p></div><div id=\"bossHud\"><div class=\"hud-small\">COMMAND CARRIER / THE BIG CHOP</div><div class=\"bar\"><div id=\"bossFill\"></div></div></div><div id=\"attract\">LIVE DEMO · PRESS ANY BUTTON TO FLY</div><div id=\"touchHint\">LEFT THUMB: FLY · RIGHT THUMB: AIM · AUTO FIRE & RESCUE · TAP RIGHT: FLARE</div><button id=\"rescueAction\">RESCUE</button>\n<section id=\"titleScreen\" class=\"screen open\"><div id=\"titleBody\"><div class=\"eyebrow\"><i class=\"stripe\"></i><i class=\"stripe\"></i> DESERT AIR PATROL</div><h1>CHOPPER<br><span>PALOOZA</span></h1><p class=\"tagline\">KEEP THE CONVOY ROLLING.</p><div class=\"stack\"><button class=\"primary\" data-action=\"start\">SCRAMBLE <span style=\"float:right\">↗</span></button><button data-action=\"online\">FLY WITH A WINGMATE</button><div class=\"row\"><button class=\"small\" data-action=\"help\">HOW TO FLY</button><button class=\"small\" data-action=\"settings\">SETTINGS</button><button class=\"small\" data-action=\"about\">ABOUT</button></div></div></div><div class=\"edition\">A SIX-TRUCK ROAD TRIP<br><strong>ONE VERY LOUD ESCORT.</strong><br>ARCADE CAMPAIGN · 1–2 PILOTS</div><div id=\"titleFooter\">INSPIRED BY CHOPPER COMMAND (1982) &nbsp; / &nbsp; CODE, ROTORS & A LITTLE DUST.</div></section>\n<section id=\"pauseScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">ROTORS ON HOLD</div><h2>Take a breather.</h2><div class=\"stack\"><button class=\"primary\" data-action=\"resume\">RETURN TO PATROL</button><button data-action=\"settings\">SETTINGS</button><button data-action=\"dev\">DEVELOPER HANGAR</button><button data-action=\"restart\">RESTART PATROL</button><button data-action=\"title\">BACK TO TITLE</button></div></div></section>\n<section id=\"settingsScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">MAKE YOURSELF AT HOME</div><h2>Flight settings</h2><label class=\"labelrow\">Music <output id=\"musicValue\">10%</output></label><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"10\"><label class=\"labelrow\">Effects & radio <output id=\"sfxValue\">65%</output></label><input id=\"sfx\" type=\"range\" min=\"0\" max=\"100\" value=\"65\"><label class=\"labelrow\" for=\"glyphs\">Controller prompts <select id=\"glyphs\"><option value=\"ps\">PlayStation</option><option value=\"xbox\">Xbox</option></select></label><label class=\"labelrow\">Automatic fire <input id=\"autoFire\" type=\"checkbox\"></label><label class=\"labelrow\">Reduce camera shake <input id=\"reducedShake\" type=\"checkbox\"></label><button class=\"back\" data-action=\"back\">BACK</button></div></section>\n<section id=\"helpScreen\" class=\"screen\"><div class=\"panel\" style=\"width:min(880px,94vw)\"><div class=\"eyebrow\">FLIGHT SCHOOL / THREE SIMPLE ORDERS</div><h2>Keep it airborne.</h2><div class=\"info-grid\"><article><h3>01 / Fly & fight</h3><p id=\"helpControls\">WASD or arrows to fly. Aim with your mouse and hold click, Space or J to fire. Shift boosts.</p></article><article><h3>02 / Guard the road</h3><p>Red radar blips are hostiles. Follow them off screen before they reach your six trucks. You have two replacement helicopters.</p></article><article><h3>03 / Bring them home</h3><p id=\"helpRescue\">Hover low beside a waving pilot to rescue automatically, or press E. Each rescue repairs your hull and earns a flare.</p></article><article><h3>When it gets crowded…</h3><p id=\"helpFlare\">Q releases a flare: enemy shots vanish and nearby hostiles take a hit. Beat three sectors, pick field upgrades, then stop the carrier.</p></article></div><button class=\"back primary\" data-action=\"back\">READY TO FLY</button></div></section>\n<section id=\"onlineScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">TWO CHOPPERS / ONE CONVOY</div><h2>Find your wingmate</h2><p>Share a flight code for online co-op, or join a friend’s patrol. The host flies Lucky; the guest flies Patches.</p><div id=\"netStatus\">A second local controller can join during play with × / A.</div><div id=\"roomDisplay\"></div><div class=\"stack\"><button class=\"primary\" data-action=\"host\">HOST A PATROL</button><div class=\"row\"><input id=\"roomCode\" type=\"text\" maxlength=\"16\" placeholder=\"FLIGHT CODE\" aria-label=\"Flight code\"><button data-action=\"join\">JOIN</button></div><button id=\"netLaunch\" data-action=\"netStart\" style=\"display:none\">SCRAMBLE TOGETHER</button></div><p class=\"muted\" style=\"margin-top:18px\">Online uses WebRTC and public PeerJS signaling. A network connection is required. AI Hub sessions connect automatically.</p><button class=\"back\" data-action=\"back\">BACK</button></div></section>\n<section id=\"upgradeScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">FIELD REQUISITION / PICK ONE</div><h2 id=\"upgradeTitle\">Nice flying, ace.</h2><p style=\"margin-bottom:22px\">The road crew patched your hull. Take a little something for the next leg.</p><div class=\"stack\"><button class=\"primary\" data-action=\"upgradeGun\">HOT BARRELS <span class=\"muted\">/ +30% weapon power</span></button><button data-action=\"upgradeArmor\">SECOND WIND <span class=\"muted\">/ +25 hull & +15% speed</span></button></div></div></section>\n<section id=\"devScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">LIVE TOOLS / PAUSE MENU ACCESS</div><h2>Developer hangar</h2><div class=\"dev-note\">Changes apply immediately. Exit the hangar to test them in flight.</div><div id=\"devSliders\"></div><label class=\"labelrow\">Invincible pilots & convoy <input id=\"godMode\" type=\"checkbox\"></label><div class=\"row\" style=\"margin-top:15px\"><button class=\"small\" data-action=\"nextSector\">NEXT SECTOR</button><button class=\"small\" data-action=\"spawnBoss\">CALL CARRIER</button></div><div class=\"row\" style=\"margin-top:8px\"><button class=\"small\" data-action=\"heal\">REPAIR ALL</button><button class=\"small\" data-action=\"clear\">CLEAR HOSTILES</button></div><div class=\"row\" style=\"margin-top:8px\"><button class=\"small\" data-action=\"resetTune\">RESET DEFAULTS</button><button class=\"small\" data-action=\"victory\">TEST VICTORY</button></div><button class=\"back primary\" data-action=\"back\">BACK TO PAUSE</button></div></section>\n<section id=\"debriefScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\" id=\"debriefEyebrow\">PATROL COMPLETE</div><h2 id=\"debriefTitle\">Convoy delivered.</h2><p id=\"debriefMessage\"></p><div id=\"debriefStats\"></div><div class=\"stack\"><button class=\"primary\" data-action=\"restart\">ANOTHER SORTIE</button><button data-action=\"title\">RETURN TO TITLE</button></div></div></section>\n<section id=\"aboutScreen\" class=\"screen\"><div class=\"panel\" id=\"creditsPanel\"><div class=\"eyebrow\">THE PEOPLE BEHIND THE PROPELLERS</div><h2>About this patrol</h2><div id=\"credits\"></div><button class=\"back\" data-action=\"back\">BACK</button></div></section>\n<script type=\"module\">/* GAME_BUNDLE */</script>\n</body></html>\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > index.template.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n<!-- HUB_SESSION -->\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:players\" content=\"1-2\"><meta name=\"hub:mode\" content=\"shared-world\"><meta name=\"hub:genre\" content=\"Shooter\"><meta name=\"hub:goal\" content=\"Escort the convoy, rescue pilots, destroy the command carrier.\"><meta name=\"hub:howto\" content=\"Left stick flies; R2 fires; Circle flares; Cross rescues. WASD, mouse, Q, E on keyboard.\"><meta name=\"hub:minutes\" content=\"5\"><meta name=\"hub:requires\" content=\"webgpu\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\"><meta name=\"theme-color\" content=\"#102f35\"><title>Chopper Palooza</title>\n<style>\n:root{--ink:#10333a;--paper:#fff0cf;--gold:#ffc757;--red:#f27151;--mint:#67dbc0;--line:rgba(255,240,207,.24)}*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:var(--ink);color:var(--paper);font-family:Trebuchet MS,Arial,sans-serif;user-select:none}button,input,select{font:inherit}button{cursor:pointer}canvas#game{position:fixed;inset:0;width:100%;height:100%;touch-action:none}button{color:var(--paper);border:1px solid var(--line);background:#153b40;padding:15px 24px;text-align:left;font-size:21px;font-weight:800;letter-spacing:.03em;border-radius:3px;transition:background .12s,transform .12s;min-height:58px}button:hover,button:focus-visible{background:var(--gold);color:var(--ink);outline:3px solid var(--paper);outline-offset:3px;transform:translateX(3px)}button.primary{background:var(--gold);color:var(--ink);border-color:var(--gold)}button.small{font-size:16px;min-height:42px;padding:9px 15px}.screen{display:none;position:fixed;inset:0;z-index:10;align-items:center;justify-content:center;background:rgba(7,29,34,.83);backdrop-filter:blur(6px);padding:32px}.screen.open{display:flex}.panel{width:min(680px,94vw);max-height:92vh;overflow-y:auto;padding:34px 42px;background:#12343bee;border:1px solid #789484;box-shadow:12px 12px 0 #071e2666}.eyebrow{font-size:14px;font-weight:900;letter-spacing:.26em;color:var(--gold);text-transform:uppercase}h1,h2,h3,p{margin:0}h2{font-size:48px;letter-spacing:-.04em;margin:8px 0 22px;text-transform:uppercase;font-style:italic}h3{font-size:22px;margin:14px 0 8px}p{font-size:19px;line-height:1.5;color:#e1e4d3}.stack{display:grid;gap:10px}.row{display:flex;gap:12px;align-items:center}.row>*{flex:1}.back{margin-top:20px;width:100%}.muted{color:#a4bdba;font-size:15px}.labelrow{display:flex;justify-content:space-between;gap:20px;font-size:19px;margin-top:18px}input[type=range]{width:100%;accent-color:var(--gold);height:26px;cursor:pointer}input[type=checkbox]{accent-color:var(--gold);width:24px;height:24px}select,input[type=text]{background:#214b4c;color:var(--paper);border:1px solid #789484;padding:12px;font-size:21px;min-width:0}input[type=text]{text-transform:uppercase;letter-spacing:.15em;width:100%}#titleScreen{background:linear-gradient(90deg,rgba(10,39,44,.97) 0%,rgba(10,39,44,.91) 32%,rgba(10,39,44,.18) 72%,transparent);backdrop-filter:none;justify-content:flex-start;padding:5vw}#titleBody{width:550px;max-width:53vw}#titleScreen h1{font-size:clamp(60px,7.8vw,124px);font-weight:1000;line-height:.86;letter-spacing:-.075em;font-style:italic;margin:26px 0 25px;filter:drop-shadow(5px 6px 0 #0b2329)}#titleScreen h1 span{color:var(--gold)}#titleScreen .tagline{font-size:clamp(17px,1.65vw,26px);font-weight:900;letter-spacing:.04em;margin-bottom:32px}#titleScreen .stack{max-width:380px}.edition{position:absolute;right:36px;top:32px;text-align:right;font-size:13px;letter-spacing:.2em;color:#284e4e;font-weight:900;line-height:1.8}.edition strong{font-size:23px;letter-spacing:.04em}#titleFooter{position:absolute;bottom:26px;left:5vw;font-size:13px;letter-spacing:.08em;color:#90aaa7}.stripe{display:inline-block;width:37px;height:8px;background:var(--gold);transform:skewX(-25deg);margin-right:5px}#hud{pointer-events:none;display:none;position:fixed;inset:0;z-index:3;padding:23px 30px}#hud.visible{display:block}.hud-top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.hud-card{background:rgba(13,46,51,.94);border:1px solid #839f90;padding:13px 18px;box-shadow:4px 5px 0 #092a3033}.pilot-hud{width:250px}.hud-small{font-size:12px;letter-spacing:.2em;color:#a3c4ba;font-weight:900}.hud-big{font-size:25px;font-weight:900;letter-spacing:.04em}.hull{display:flex;gap:4px;margin-top:10px}.hull i{flex:1;height:10px;background:var(--mint)}.hull i.off{background:#315359}#score{color:var(--gold);font-variant-numeric:tabular-nums}.mission{text-align:center;position:absolute;left:50%;top:24px;transform:translateX(-50%);min-width:280px}.mission .eyebrow{font-size:12px}.mission b{font-size:19px;display:block;margin-top:5px}#radarFrame{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);width:min(480px,40vw);padding:9px 12px 7px;background:#103137ed;border:1px solid #809e8c}#radar{width:100%;height:65px;display:block}#radarFrame .hud-small{font-size:10px;display:flex;justify-content:space-between}#controls{position:absolute;bottom:27px;left:30px;font-size:15px;line-height:1.9;text-shadow:1px 2px 1px #10333a;font-weight:800}#convoyHud{position:absolute;right:30px;bottom:27px;text-align:right}.truck-icons{display:flex;gap:7px;justify-content:flex-end;margin:9px 0}.truck-icons i{width:25px;height:15px;background:var(--gold);border:2px solid var(--paper);display:block;transform:skewX(-8deg)}.truck-icons i.dead{background:#6a4c41;border-color:#9b7660}#pauseButton{position:fixed;right:28px;top:104px;z-index:6;display:none;min-height:38px;padding:7px 13px;font-size:14px}#toast{position:fixed;top:24%;left:50%;transform:translateX(-50%);z-index:7;text-align:center;pointer-events:none;opacity:0;transition:opacity .2s;min-width:380px}#toast.show{opacity:1}#toast strong{font-size:36px;font-weight:1000;font-style:italic;letter-spacing:-.03em;display:block;text-shadow:3px 3px #163638}#toast span{font-size:17px;background:var(--ink);padding:6px 15px;display:inline-block;margin-top:8px;color:var(--gold)}#radio{position:fixed;left:30px;bottom:142px;z-index:4;max-width:420px;padding:14px 20px;background:#10373aeb;border-left:5px solid var(--gold);display:none}#radio b{font-size:12px;letter-spacing:.17em;color:var(--gold)}#radio p{font-size:17px;line-height:1.4;margin-top:5px}#bossHud{display:none;position:fixed;bottom:122px;left:50%;transform:translateX(-50%);width:340px;z-index:4;text-align:center}#bossHud .bar{height:11px;background:#243e42;border:1px solid #f5c388;margin-top:6px}#bossFill{height:100%;background:var(--red)}#attract{display:none;position:fixed;bottom:130px;left:50%;transform:translateX(-50%);z-index:5;background:var(--gold);color:var(--ink);padding:12px 24px;font-size:17px;letter-spacing:.08em;font-weight:900;animation:blink 2s infinite}#loading{position:fixed;inset:0;background:var(--ink);z-index:100;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:20px}#loading strong{font-size:38px;font-style:italic;color:var(--gold)}#loading p{font-size:17px}#loadError{max-width:650px;text-align:center}#touchHint{position:fixed;bottom:18px;left:20px;right:20px;text-align:center;font-size:13px;pointer-events:none;display:none;color:#f9edcf;z-index:5}#rescueAction{position:fixed;bottom:23%;right:10%;z-index:6;display:none;border-radius:50%;width:90px;height:90px;text-align:center;font-size:15px;padding:0;background:var(--gold);color:var(--ink)}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.info-grid article{border:1px solid var(--line);padding:18px}.info-grid p{font-size:17px}#creditsPanel{width:min(900px,94vw)}.credit-line{font-size:16px;line-height:1.6;border-bottom:1px solid #ffffff13;padding:5px 0;user-select:text}.credit-line b{color:var(--gold)}#netStatus{min-height:50px;font-size:17px;color:var(--mint);margin:16px 0}#roomDisplay{font-size:35px;color:var(--gold);letter-spacing:.1em}#debriefStats{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin:20px 0}.stat{background:#20494a;padding:18px}.stat b{font-size:33px;display:block;color:var(--gold)}.stat span{font-size:14px;letter-spacing:.08em}.dev-note{font-size:13px;color:#a4b8ae;margin-bottom:8px}#damageFlash{position:fixed;inset:0;pointer-events:none;z-index:2;box-shadow:inset 0 0 90px #f16751;opacity:0}@keyframes blink{50%{opacity:.55}}@media(max-height:700px){.screen{padding:15px}.panel{padding:23px 30px}button{min-height:47px;padding:10px 18px;font-size:18px}h2{font-size:37px;margin-bottom:15px}#titleScreen h1{margin:15px 0}.tagline{margin-bottom:20px!important}#titleFooter{bottom:12px}.labelrow{margin-top:11px}#radio{bottom:126px}}@media(max-width:750px){#titleBody{max-width:75vw}#titleScreen h1{font-size:clamp(52px,12vw,90px)}#titleScreen .stack{max-width:300px}.edition{font-size:9px;right:15px;top:16px}.edition strong{font-size:15px}#hud{padding:12px}.pilot-hud{width:155px}.hud-card{padding:9px 11px}.hud-big{font-size:18px}.hud-small{font-size:10px}.mission{top:15px;min-width:170px}.mission b{font-size:13px}.mission .eyebrow{font-size:9px}#scoreCard{min-width:90px}#controls{display:none}#radarFrame{width:43vw;bottom:18px}#convoyHud{right:13px;bottom:20px}.truck-icons{gap:3px}.truck-icons i{width:15px;height:11px}#radio{left:14px;bottom:116px;max-width:280px;padding:10px 12px}#radio p{font-size:14px}#radio b{font-size:10px}.info-grid{grid-template-columns:1fr}.panel{padding:22px}#titleFooter{font-size:9px}#toast strong{font-size:28px}#pauseButton{right:13px;top:85px}#bossHud{bottom:112px;width:250px}}\n</style></head><body>\n<canvas id=\"game\" aria-label=\"Chopper Palooza game battlefield\"></canvas><div id=\"damageFlash\"></div>\n<div id=\"loading\"><div class=\"eyebrow\">DESERT AIR PATROL · 1982 / REIMAGINED</div><strong>CHOPPER PALOOZA</strong><p id=\"loadError\">Warming up the rotors…</p></div>\n<div id=\"hud\"><div class=\"hud-top\"><div class=\"hud-card pilot-hud\"><div class=\"hud-small\" id=\"pilotLabel\">01 / LUCKY</div><div class=\"hud-big\" id=\"lifeLabel\">HULL 100</div><div id=\"hull\" class=\"hull\"></div></div><div class=\"mission\"><div class=\"eyebrow\" id=\"sectorLabel\">SECTOR 01 / DUST UP</div><b id=\"objective\">KEEP THE CONVOY ROLLING</b></div><div class=\"hud-card\" id=\"scoreCard\"><div class=\"hud-small\">HIGH <span id=\"highScore\">000000</span></div><div class=\"hud-big\" id=\"score\">000000</div></div></div><div id=\"controls\"></div><div id=\"radarFrame\"><div class=\"hud-small\"><span>TACTICAL RADAR</span><span>◀ 180 KM ▶</span></div><canvas id=\"radar\" width=\"620\" height=\"82\"></canvas></div><div id=\"convoyHud\"><div class=\"hud-small\">CONVOY INTEGRITY</div><div id=\"trucks\" class=\"truck-icons\"></div><div id=\"cargoLabel\" class=\"hud-big\">6 / 6</div></div></div>\n<button id=\"pauseButton\" aria-label=\"Pause game\">Ⅱ MENU</button><div id=\"toast\"><strong></strong><span></span></div><div id=\"radio\"><b>● CONVOY RADIO / DUSTY</b><p></p></div><div id=\"bossHud\"><div class=\"hud-small\">COMMAND CARRIER / THE BIG CHOP</div><div class=\"bar\"><div id=\"bossFill\"></div></div></div><div id=\"attract\">LIVE DEMO · PRESS ANY BUTTON TO FLY</div><div id=\"touchHint\">LEFT THUMB: FLY · RIGHT THUMB: AIM · AUTO FIRE & RESCUE · TAP RIGHT: FLARE</div><button id=\"rescueAction\">RESCUE</button>\n<section id=\"titleScreen\" class=\"screen open\"><div id=\"titleBody\"><div class=\"eyebrow\"><i class=\"stripe\"></i><i class=\"stripe\"></i> DESERT AIR PATROL</div><h1>CHOPPER<br><span>PALOOZA</span></h1><p class=\"tagline\">KEEP THE CONVOY ROLLING.</p><div class=\"stack\"><button class=\"primary\" data-action=\"start\">SCRAMBLE <span style=\"float:right\">↗</span></button><button data-action=\"online\">FLY WITH A WINGMATE</button><div class=\"row\"><button class=\"small\" data-action=\"help\">HOW TO FLY</button><button class=\"small\" data-action=\"settings\">SETTINGS</button><button class=\"small\" data-action=\"about\">ABOUT</button></div></div></div><div class=\"edition\">A SIX-TRUCK ROAD TRIP<br><strong>ONE VERY LOUD ESCORT.</strong><br>ARCADE CAMPAIGN · 1–2 PILOTS</div><div id=\"titleFooter\">INSPIRED BY CHOPPER COMMAND (1982) &nbsp; / &nbsp; CODE, ROTORS & A LITTLE DUST.</div></section>\n<section id=\"pauseScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">ROTORS ON HOLD</div><h2>Take a breather.</h2><div class=\"stack\"><button class=\"primary\" data-action=\"resume\">RETURN TO PATROL</button><button data-action=\"settings\">SETTINGS</button><button data-action=\"dev\">DEVELOPER HANGAR</button><button data-action=\"restart\">RESTART PATROL</button><button data-action=\"title\">BACK TO TITLE</button></div></div></section>\n<section id=\"settingsScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">MAKE YOURSELF AT HOME</div><h2>Flight settings</h2><label class=\"labelrow\">Music <output id=\"musicValue\">10%</output></label><input id=\"music\" type=\"range\" min=\"0\" max=\"100\" value=\"10\"><label class=\"labelrow\">Effects & radio <output id=\"sfxValue\">65%</output></label><input id=\"sfx\" type=\"range\" min=\"0\" max=\"100\" value=\"65\"><label class=\"labelrow\" for=\"glyphs\">Controller prompts <select id=\"glyphs\"><option value=\"ps\">PlayStation</option><option value=\"xbox\">Xbox</option></select></label><label class=\"labelrow\">Automatic fire <input id=\"autoFire\" type=\"checkbox\"></label><label class=\"labelrow\">Reduce camera shake <input id=\"reducedShake\" type=\"checkbox\"></label><button class=\"back\" data-action=\"back\">BACK</button></div></section>\n<section id=\"helpScreen\" class=\"screen\"><div class=\"panel\" style=\"width:min(880px,94vw)\"><div class=\"eyebrow\">FLIGHT SCHOOL / THREE SIMPLE ORDERS</div><h2>Keep it airborne.</h2><div class=\"info-grid\"><article><h3>01 / Fly & fight</h3><p id=\"helpControls\">WASD or arrows to fly. Aim with your mouse and hold click, Space or J to fire. Shift boosts.</p></article><article><h3>02 / Guard the road</h3><p>Red radar blips are hostiles. Follow them off screen before they reach your six trucks. You have two replacement helicopters.</p></article><article><h3>03 / Bring them home</h3><p id=\"helpRescue\">Hover low beside a waving pilot to rescue automatically, or press E. Each rescue repairs your hull and earns a flare.</p></article><article><h3>When it gets crowded…</h3><p id=\"helpFlare\">Q releases a flare: enemy shots vanish and nearby hostiles take a hit. Beat three sectors, pick field upgrades, then stop the carrier.</p></article></div><button class=\"back primary\" data-action=\"back\">READY TO FLY</button></div></section>\n<section id=\"onlineScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">TWO CHOPPERS / ONE CONVOY</div><h2>Find your wingmate</h2><p>Share a flight code for online co-op, or join a friend’s patrol. The host flies Lucky; the guest flies Patches.</p><div id=\"netStatus\">A second local controller can join during play with × / A.</div><div id=\"roomDisplay\"></div><div class=\"stack\"><button class=\"primary\" data-action=\"host\">HOST A PATROL</button><div class=\"row\"><input id=\"roomCode\" type=\"text\" maxlength=\"16\" placeholder=\"FLIGHT CODE\" aria-label=\"Flight code\"><button data-action=\"join\">JOIN</button></div><button id=\"netLaunch\" data-action=\"netStart\" style=\"display:none\">SCRAMBLE TOGETHER</button></div><p class=\"muted\" style=\"margin-top:18px\">Online uses WebRTC and public PeerJS signaling. A network connection is required. AI Hub sessions connect automatically.</p><button class=\"back\" data-action=\"back\">BACK</button></div></section>\n<section id=\"upgradeScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">FIELD REQUISITION / PICK ONE</div><h2 id=\"upgradeTitle\">Nice flying, ace.</h2><p style=\"margin-bottom:22px\">The road crew patched your hull. Take a little something for the next leg.</p><div class=\"stack\"><button class=\"primary\" data-action=\"upgradeGun\">HOT BARRELS <span class=\"muted\">/ +30% weapon power</span></button><button data-action=\"upgradeArmor\">SECOND WIND <span class=\"muted\">/ +25 hull & +15% speed</span></button></div></div></section>\n<section id=\"devScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\">LIVE TOOLS / PAUSE MENU ACCESS</div><h2>Developer hangar</h2><div class=\"dev-note\">Changes apply immediately. Exit the hangar to test them in flight.</div><div id=\"devSliders\"></div><label class=\"labelrow\">Invincible pilots & convoy <input id=\"godMode\" type=\"checkbox\"></label><div class=\"row\" style=\"margin-top:15px\"><button class=\"small\" data-action=\"nextSector\">NEXT SECTOR</button><button class=\"small\" data-action=\"spawnBoss\">CALL CARRIER</button></div><div class=\"row\" style=\"margin-top:8px\"><button class=\"small\" data-action=\"heal\">REPAIR ALL</button><button class=\"small\" data-action=\"clear\">CLEAR HOSTILES</button></div><div class=\"row\" style=\"margin-top:8px\"><button class=\"small\" data-action=\"resetTune\">RESET DEFAULTS</button><button class=\"small\" data-action=\"victory\">TEST VICTORY</button></div><button class=\"back primary\" data-action=\"back\">BACK TO PAUSE</button></div></section>\n<section id=\"debriefScreen\" class=\"screen\"><div class=\"panel\"><div class=\"eyebrow\" id=\"debriefEyebrow\">PATROL COMPLETE</div><h2 id=\"debriefTitle\">Convoy delivered.</h2><p id=\"debriefMessage\"></p><div id=\"debriefStats\"></div><div class=\"stack\"><button class=\"primary\" data-action=\"restart\">ANOTHER SORTIE</button><button data-action=\"title\">RETURN TO TITLE</button></div></div></section>\n<section id=\"aboutScreen\" class=\"screen\"><div class=\"panel\" id=\"creditsPanel\"><div class=\"eyebrow\">THE PEOPLE BEHIND THE PROPELLERS</div><h2>About this patrol</h2><div id=\"credits\"></div><button class=\"back\" data-action=\"back\">BACK</button></div></section>\n<script type=\"module\">/* GAME_BUNDLE */</script>\n</body></html>\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' visuals.js && sed -n '1,125p' online.js && cat hub-reference/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' visuals.js && sed -n '1,125p' online.js && cat hub-reference/README.md\"","aggregated_output":"import * as THREE from 'three';\n\nexport const palette = Object.freeze({ink:0x233c43,sky:0xf6e5be,cream:0xfff0c9,sand:0xdca35f,coral:0xe67555,teal:0x24b4a4,tealDark:0x237b7c,yellow:0xf5ca57,white:0xfff8df,night:0x29505b});\nconst inkMaterial = new THREE.MeshBasicMaterial({color:palette.ink,side:THREE.BackSide});\nconst materials = new Map();\nfunction material(color,emissive=false){\n  const key=`${color}-${emissive}`;\n  if(!materials.has(key)) materials.set(key,emissive ? new THREE.MeshBasicMaterial({color}) : new THREE.MeshStandardMaterial({color,flatShading:true,roughness:1,metalness:0}));\n  return materials.get(key);\n}\nfunction mesh(geometry,color,outline=true,emissive=false){\n  const object=new THREE.Mesh(geometry,material(color,emissive));\n  if(outline){const ink=new THREE.Mesh(geometry,inkMaterial);ink.scale.setScalar(1.045);object.add(ink);}\n  object.castShadow=true;object.receiveShadow=true;\n  return object;\n}\nfunction box(parent,x,y,z,w,h,d,color,outline=true){const m=mesh(new THREE.BoxGeometry(w,h,d),color,outline);m.position.set(x,y,z);parent.add(m);return m;}\nfunction ellipsoid(parent,x,y,z,rx,ry,rz,color,detail=1){const m=mesh(new THREE.IcosahedronGeometry(1,detail),color);m.scale.set(rx,ry,rz);m.position.set(x,y,z);parent.add(m);return m;}\nfunction rod(parent,a,b,r,color,outline=true){const start=new THREE.Vector3(...a),end=new THREE.Vector3(...b);const m=mesh(new THREE.CylinderGeometry(r,r,end.distanceTo(start),6),color,outline);m.position.copy(start).add(end).multiplyScalar(.5);m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),end.sub(start).normalize());parent.add(m);return m;}\nfunction profile(parent,points,depth,color,z=0){const s=new THREE.Shape();points.forEach(([x,y],i)=>i?s.lineTo(x,y):s.moveTo(x,y));s.closePath();const geo=new THREE.ExtrudeGeometry(s,{depth,bevelEnabled:false});geo.translate(0,0,-depth/2);const m=mesh(geo,color);m.position.z=z;parent.add(m);return m;}\nfunction rotor(parent,name,x,y,z,size,color=palette.ink){const g=new THREE.Group();g.name=name;g.position.set(x,y,z);parent.add(g);box(g,0,0,0,size,.065,.19,color,false);box(g,0,0,0,.19,.065,size*.76,color,false);ellipsoid(g,0,.08,0,.22,.15,.22,palette.cream,0);return g;}\nfunction animated(group,tracks,duration){const mixer=new THREE.AnimationMixer(group);const clip=new THREE.AnimationClip('mechanical-motion',duration,tracks);mixer.clipAction(clip).play();group.userData.mixer=mixer;group.userData.clip=clip;return group;}\n\nexport function createHelicopter(color=palette.teal,isEnemy=false){\n  const g=new THREE.Group();g.name=isEnemy?'Raider':'Palooza One';\n  profile(g,[[-1.9,-.35],[-1.65,.65],[-.6,1.03],[1.1,.92],[2.02,.2],[1.76,-.57],[.1,-.85],[-1.2,-.69]],1.15,color);\n  profile(g,[[.12,.77],[1.03,.7],[1.66,.16],[.3,.05]],.025,isEnemy?0x522f44:0x183f50,.61);\n  profile(g,[[-.78,.73],[-.1,.77],[.05,.08],[-.85,.1]],.025,isEnemy?0x733b50:0x4fc3cc,.62);\n  rod(g,[.23,.74,.65],[.34,.04,.65],.045,palette.cream,false);\n  profile(g,[[-1.65,.2],[-3.85,.74],[-4.2,.48],[-1.75,-.32]],.35,color);\n  profile(g,[[-3.78,.57],[-3.94,1.45],[-4.4,1.55],[-4.18,.37],[-3.7,.18]],.24,isEnemy?palette.yellow:palette.coral);\n  box(g,-1.1,1.04,0,1.15,.27,.83,palette.cream);\n  rod(g,[-.38,1.03,0],[-.38,1.65,0],.09,palette.ink);\n  rotor(g,'mainRotor',-.38,1.67,0,7.8);\n  const tail=new THREE.Group();tail.name='tailRotor';tail.position.set(-3.96,.71,.32);g.add(tail);\n  box(tail,0,0,0,1.25,.105,.075,palette.cream);box(tail,0,0,0,.105,1.25,.075,palette.cream);\n  ellipsoid(tail,0,0,.06,.14,.14,.1,palette.ink,0);\n  for(const z of [-.64,.64]){rod(g,[-1,-.6,z],[-1.3,-1.22,z],.055,palette.ink);rod(g,[.85,-.61,z],[.63,-1.22,z],.055,palette.ink);rod(g,[-1.7,-1.22,z],[1.43,-1.22,z],.07,palette.cream);rod(g,[1.43,-1.22,z],[1.67,-1.04,z],.07,palette.cream);}\n  box(g,-.8,-.28,.6,.55,.12,.06,palette.cream,false);\n  box(g,.64,-.83,.04,1.23,.16,.49,palette.coral);\n  rod(g,[1.27,-.57,.2],[2.36,-.57,.2],.115,palette.ink);\n  ellipsoid(g,-2.7,.53,.22,.13,.13,.13,isEnemy?palette.yellow:palette.coral,0);\n  return animated(g,[new THREE.NumberKeyframeTrack('mainRotor.rotation[y]',[0,.18],[0,Math.PI*2]),new THREE.NumberKeyframeTrack('tailRotor.rotation[z]',[0,.18],[0,-Math.PI*6])],.18);\n}\n\nexport function createTruck(){\n  const g=new THREE.Group();g.name='Convoy';\n  box(g,-.8,1.27,0,3.13,1.64,1.72,palette.cream);\n  box(g,-.8,1.27,.885,2.9,.22,.05,palette.coral,false);\n  box(g,1.4,.94,0,1.55,1.33,1.66,palette.coral);\n  profile(g,[[.7,1.5],[.99,2.13],[1.76,2.13],[2.15,1.48]],1.63,palette.coral);\n  profile(g,[[1.06,1.93],[1.67,1.93],[1.94,1.53],[.87,1.53]],.025,0x345663,.84);\n  box(g,0,.49,0,4.6,.35,1.75,palette.ink);\n  for(const x of [-1.66,1.38])for(const z of [-.9,.9]){\n    const tire=mesh(new THREE.CylinderGeometry(.48,.48,.24,10),palette.ink);tire.rotation.x=Math.PI/2;tire.position.set(x,.5,z);g.add(tire);\n    const hub=mesh(new THREE.CylinderGeometry(.2,.2,.27,8),palette.sand,false);hub.rotation.x=Math.PI/2;hub.position.copy(tire.position);g.add(hub);\n  }\n  box(g,2.19,1.04,.65,.12,.3,.31,palette.yellow,false);\n  box(g,-.82,1.61,.91,.56,.57,.035,palette.teal,false);\n  box(g,-.82,1.61,.94,.13,.38,.02,palette.cream,false);box(g,-.82,1.61,.94,.38,.13,.02,palette.cream,false);\n  return g;\n}\n\nexport function createJet(){\n  const g=new THREE.Group();g.name='Sunlance';\n  profile(g,[[-3,-.18],[-2.1,.38],[1.55,.48],[3.15,-.13],[1.6,-.49],[-1.83,-.49]],.78,palette.yellow);\n  profile(g,[[-1.35,.25],[-1.73,1.41],[-2.29,1.49],[-2.12,.12]],.21,palette.coral);\n  profile(g,[[.34,.43],[.96,.88],[1.69,.67],[2.12,.39]],.61,palette.night);\n  profile(g,[[-1,-.1],[.34,-1.24],[1.22,-1.24],[.7,-.12]],.18,palette.coral,.65);\n  box(g,-2.73,-.19,0,.4,.41,.57,palette.ink);\n  const fire=ellipsoid(g,-3.15,-.17,0,.63,.2,.22,palette.coral,0);fire.name='jetFlame';\n  return animated(g,[new THREE.NumberKeyframeTrack('jetFlame.scale[x]',[0,.11,.22],[.5,.8,.5])],.22);\n}\n\nexport function createBoss(){\n  const g=new THREE.Group();g.name='The Big Chop';\n  profile(g,[[-7,-.1],[-6,2.1],[-3,2.8],[3.8,2.55],[7,1.3],[7.8,-.1],[5.8,-2],[-4.5,-2]],3.2,palette.night);\n  profile(g,[[-5.8,1.55],[-3,2.2],[3.5,2.05],[6,1.2],[5.7,.45],[-5.5,.52]],.06,palette.coral,1.67);\n  for(let i=0;i<6;i++)box(g,-4.15+i*1.65,1.25,1.75,1.03,.6,.12,i%2?palette.yellow:palette.cream);\n  box(g,0,-.3,1.7,6.2,.6,.16,palette.cream);\n  box(g,0,-.3,1.81,1.2,.87,.06,palette.coral);\n  for(const x of [-5.1,5.1]){\n    box(g,x,-2.1,.1,2.2,1.23,2.2,palette.coral);\n    for(const z of [-.8,.8])rod(g,[x,-2.3,z],[x,-3,z],.32,palette.ink);\n    box(g,x,2.4,0,2.7,.4,2.3,palette.cream);\n    rod(g,[x,2.5,0],[x,3.27,0],.17,palette.ink);\n    rotor(g,x<0?'bossRotorL':'bossRotorR',x,3.3,0,8.5);\n  }\n  for(let i=0;i<5;i++)box(g,-3.5+i*1.75,-1.2,1.72,.7,.28,.06,palette.yellow,false);\n  profile(g,[[-6.5,.7],[-7.4,3.55],[-8.6,3.72],[-8.1,.11]],.5,palette.coral);\n  return animated(g,[new THREE.NumberKeyframeTrack('bossRotorL.rotation[y]',[0,.24],[0,Math.PI*2]),new THREE.NumberKeyframeTrack('bossRotorR.rotation[y]',[0,.24],[0,-Math.PI*2])],.24);\n}\n\nexport function createPilot(){\n  const g=new THREE.Group();g.name='Stranded pilot';\n  box(g,0,.75,0,.48,.65,.34,palette.teal);\n  ellipsoid(g,0,1.34,0,.34,.34,.3,palette.cream,1);\n  box(g,.06,1.39,.28,.35,.17,.08,palette.night,false);\n  rod(g,[-.13,.49,0],[-.19,.08,0],.105,palette.ink);rod(g,[.13,.49,0],[.22,.08,0],.105,palette.ink);\n  rod(g,[-.25,.94,0],[-.52,.62,0],.09,palette.cream);\n  const arm=new THREE.Group();arm.name='wavingArm';arm.position.set(.25,1,0);g.add(arm);rod(arm,[0,0,0],[.16,.49,0],.09,palette.cream);\n  const flag=new THREE.Group();flag.name='rescueFlag';flag.position.set(-.8,0,0);g.add(flag);rod(flag,[0,0,0],[0,2.7,0],.035,palette.ink,false);profile(flag,[[0,2.6],[1.1,2.43],[0,2.1]],.025,palette.coral,.08);\n  return animated(g,[new THREE.NumberKeyframeTrack('wavingArm.rotation[z]',[0,.4,.8],[-.6,.45,-.6])],.8);\n}\n\nfunction mesa(parent,x,y,z,w,h,color){\n  const pts=[[-.55*w,0],[-.5*w,.16*h],[-.34*w,.21*h],[-.28*w,.76*h],[-.13*w,h],[.22*w,h],[.34*w,.84*h],[.36*w,.36*h],[.5*w,.25*h],[.61*w,0]];\n  const m=profile(parent,pts,3,color);m.position.set(x,y,z);\n  // Horizontal strata and ochre facets read as hand-painted canyon walls.\n  const strata=profile(parent,[[-.3*w,.64*h],[.32*w,.64*h],[.33*w,.58*h],[-.31*w,.58*h]],.05,0xcf895f,2.05);strata.position.set(x,y,z);\n  const top=profile(parent,[[-.13*w,h],[.22*w,h],[.26*w,.91*h],[-.19*w,.91*h]],.08,0xf2b978,2.06);top.position.set(x,y,z);\n}\nfunction cactus(parent,x,z,height=2){const g=new THREE.Group();g.position.set(x,0,z);parent.add(g);const c=0x527c6a;rod(g,[0,0,0],[0,height,0],.15,c);rod(g,[-.03,height*.5,0],[-.62,height*.5,0],.12,c);rod(g,[-.62,height*.5,0],[-.62,height*.78,0],.12,c);rod(g,[.03,height*.33,0],[.54,height*.33,0],.11,c);rod(g,[.54,height*.33,0],[.54,height*.66,0],.11,c);return g;}\nexport function createWorld(scene){\n  const group=new THREE.Group();group.name='Desert ink diorama';scene.add(group);\n  const clouds=[];\n  const sun=mesh(new THREE.CircleGeometry(6.8,64),palette.yellow,false,true);sun.position.set(35,28,-45);group.add(sun);\n  const ring=new THREE.Mesh(new THREE.RingGeometry(7.4,7.52,64),material(palette.coral,true));ring.position.copy(sun.position);ring.position.z-=.1;group.add(ring);\n  for(let i=0;i<14;i++){\n    const x=-210+i*33;\n    mesa(group,x,-1,-32,26+9*Math.sin(i*3.7),8+8*(.5+.5*Math.sin(i*2.3)),i%2?0xdb9e79:0xd5a985);\n  }\n  for(let i=0;i<12;i++)mesa(group,-205+i*39,-.8,-19,15+7*Math.sin(i*2.7),5+7*(.5+.5*Math.sin(i*4.1)),i%2?0xbf7555:0xca825a);\n  // Ground and the convoy's ink-edged road.\n  box(group,0,-3,-5,540,6,60,palette.sand,false);\n  box(group,0,-.02,0,540,.15,5.1,0x835b4b,false);\n  box(group,0,.07,2.69,540,.08,.13,palette.cream,false);\n  box(group,0,.07,-2.69,540,.08,.13,palette.cream,false);\n  for(let i=-44;i<45;i++)box(group,i*6,.085,0,2.2,.06,.12,0xe1b47c,false);\n  for(let i=0;i<58;i++){\n    const x=-230+i*8.3;\n    if(i%3!==0)cactus(group,x,-5-(i%5)*1.6,1.2+(i%4)*.47);\n    const rock=ellipsoid(group,x+3,.25,-3.6-(i%4)*2.2,.7+(i%3)*.36,.4+(i%2)*.3,.5, i%2?0xd08a56:0xe6b36f,0);rock.rotation.y=i;\n  }\n  for(let i=0;i<13;i++){\n    const cloud=new THREE.Group();cloud.position.set(-200+i*35,24+(i%3)*4.8,-36);group.add(cloud);\n    const width=3+(i%3)*1.2;\n    ellipsoid(cloud,0,0,0,width,1,1,palette.white,1);\n    ellipsoid(cloud,-width*.4,.5,0,width*.6,1.3,1.1,palette.white,1);\n    ellipsoid(cloud,width*.3,.45,0,width*.48,1.1,1,palette.white,1);\n    clouds.push(cloud);\n  }\n  // Telegraph poles and broken roadside equipment establish the convoy route.\n  for(let i=-6;i<=6;i++){\n    const x=i*35+8;\n    rod(group,[x,0,-8],[x,5.6,-8],.12,0x805846);\n    box(group,x,5.3,-8,3.1,.15,.14,0x805846,false);\n    for(const dx of [-1,1])box(group,x+dx,5.5,-8,.16,.4,.16,palette.cream,false);\n  }\n  const ambient=new THREE.HemisphereLight(0xfff4d5,0xc48550,2.25);scene.add(ambient);\n  const key=new THREE.DirectionalLight(0xfff1cd,3.0);key.position.set(-30,55,36);scene.add(key);\n  const fill=new THREE.DirectionalLight(0x8ed6cc,.75);fill.position.set(20,12,-20);scene.add(fill);\n  return {group,sun,clouds,update(dt,cameraX,time){sun.position.x=35+cameraX*.53;ring.position.x=sun.position.x;for(let i=0;i<clouds.length;i++){clouds[i].position.x=-200+i*35+Math.sin(time*.014+i)*3;}}};\n}\n/* Chopper Palooza networking: AI Hub Session Protocol v1 + standalone WebRTC. */\nlet peerLibrary;\nconst loadPeer = () => {\n  if (globalThis.Peer) return Promise.resolve(globalThis.Peer);\n  if (peerLibrary) return peerLibrary;\n  peerLibrary = new Promise((resolve, reject) => {\n    const script = document.createElement('script');\n    const timeout = setTimeout(() => reject(new Error('Internet signaling timed out')), 10000);\n    script.src = 'https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js';\n    script.onload = () => { clearTimeout(timeout); resolve(globalThis.Peer); };\n    script.onerror = () => { clearTimeout(timeout); reject(new Error('Internet signaling unavailable')); };\n    document.head.appendChild(script);\n  });\n  return peerLibrary;\n};\n\nexport function createOnline(callbacks = {}) {\n  const call = (name, ...args) => callbacks[name]?.(...args);\n  const randomID = () => Array.from(crypto.getRandomValues(new Uint8Array(6)), n => n.toString(16).padStart(2, '0')).join('');\n  const client = randomID();\n  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  let role = 'solo', room = '', connected = false, hub = false, server = false;\n  let info = null, started = false, ended = false, reported = false;\n  let channel = null, peer = null, connection = null, timer = null;\n  let generation = 0, seq = 0, lastState = null, remoteClient = '', lastRemote = 0;\n  let input = { x: 0, y: 0, fire: false, flare: false, rescue: false };\n  let stateClock = 0, inputClock = 0, lastSeq = new Map();\n  let players = [];\n  const status = text => call('onStatus', text);\n  const cleanInput = value => ({\n    x: Math.max(-1, Math.min(1, Number(value?.x) || 0)),\n    y: Math.max(-1, Math.min(1, Number(value?.y) || 0)),\n    fire: !!value?.fire, flare: !!value?.flare, rescue: !!value?.rescue,\n    aimX: Number.isFinite(value?.aimX) ? value.aimX : null,\n    aimY: Number.isFinite(value?.aimY) ? value.aimY : null,\n  });\n  const send = (kind, data = {}) => {\n    if (ended) return;\n    const packet = { v: 1, kind, room, client, seq: ++seq, ...data };\n    if (hub) {\n      if (kind === 'state') globalThis.AIHub.send(packet);\n      else if (kind === 'input') globalThis.AIHub.send(packet, { to: info.host });\n      return;\n    }\n    if (channel) channel.postMessage(packet);\n    if (connection?.open) connection.send(packet);\n  };\n  const begin = () => {\n    if (started) return;\n    started = true;\n    call('onStart');\n  };\n  const disconnectRemote = reason => {\n    if (!connected) return;\n    connected = false;\n    remoteClient = '';\n    call('onInput', cleanInput(null), 1);\n    call('onDisconnect', reason);\n    status(reason);\n  };\n  const receive = (packet, from = null) => {\n    if (ended || !packet || packet.v !== 1 || (!hub && packet.room !== room)) return;\n    if (packet.client === client) return;\n    if (packet.target && packet.target !== client) return;\n    if (packet.seq <= (lastSeq.get(packet.client) || -1)) return;\n    lastSeq.set(packet.client, packet.seq);\n    if (hub) {\n      if (role === 'host' && packet.kind === 'input') {\n        const seat = info.players.findIndex(player => player.id === from);\n        if (seat >= 0) call('onInput', cleanInput(packet.input), seat);\n      } else if (role === 'guest' && packet.kind === 'state' && from === info.host) {\n        lastState = packet.state;\n        call('onState', packet.state);\n      }\n      return;\n    }\n    if (role === 'host' && packet.kind === 'hello') {\n      if (remoteClient && remoteClient !== packet.client) {\n        send('full', { target: packet.client });\n        return;\n      }\n      remoteClient = packet.client;\n      lastRemote = performance.now();\n      const first = !connected;\n      connected = true;\n      send('welcome', { target: remoteClient, seat: 1 });\n      if (first) {\n        status(`WINGMATE CONNECTED · ${room}`);\n        begin();\n      }\n    } else if (role === 'guest' && packet.kind === 'welcome') {\n      const first = !connected;\n      connected = true;\n      lastRemote = performance.now();\n      if (first) {\n        status(`FORMATION LINKED · ${room}`);\n        begin();\n      }\n    } else if (role === 'host' && packet.kind === 'input' && packet.client === remoteClient) {\n      lastRemote = performance.now();\n      call('onInput', cleanInput(packet.input), 1);\n    } else if (role === 'guest' && packet.kind === 'state') {\n      lastRemote = performance.now();\n      lastState = packet.state;\n      call('onState', packet.state);\n    } else if (packet.kind === 'bye') {\n      disconnectRemote('WINGMATE LEFT · continue solo or reconnect');\n    } else if (packet.kind === 'full') {\n      status('THIS FLIGHT IS FULL · two pilots maximum');\n    }\n  };\n  const setupLocal = () => {\n    try {\n      channel = new BroadcastChannel(`chopper-palooza-v1-${room}`);\n      channel.onmessage = event => receive(event.data);\n    } catch (_) { channel = null; }\n    timer = setInterval(() => {\n      if (role === 'guest') send('hello');\n      if (connected && performance.now() - lastRemote > 8000) disconnectRemote('LINK LOST · reconnect with the room code');\n    }, 1000);\n    if (role === 'guest') send('hello');\n  };\n  const setupPeer = async token => {\n    try {\n      const Peer = await loadPeer();\n# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card, longer if one asks for more time: what\n   the game is, how to win, the controls. The card is the hub's, from the\n   game's tags, or the game's own (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. A player can ask for more time, which adds\nten seconds; while more than half of them are asking, the countdown holds.\nBy default the hub shows its own card over the game. A game can make the\ncard its own, as part of the game:\n\n```js\nAIHub.connect({ mode, seats, card: true });\n```\n\nThe hub's card then steps aside when the game calls `ready()`, and the game's\nscreen is the card until `start`. How it looks and sounds is the game's: its\ntitle, its music, its world, the players lining up. Introduce the game the way\nit deserves.\n\nWhile it is on, the card shows:\n\n- the game's name;\n- the players, each in their colour, and which of them are ready;\n- how to win the round;\n- the controls this player will use;\n- the time left, from the `card` event.\n\nAnd it takes two answers, from the keyboard, a controller, or a tap or click\non the card:\n\n- **Ready**: Enter, Cross (button 0), or a tap on Ready:\n  `AIHub.answer('ready')`.\n- **More time**: Triangle (button 3), a key the card names, or a tap on More\n  time: `AIHub.answer('more')`. Answering `more` again takes it back.\n\nNothing done on the card changes the round. It has no menus, settings or\nchoices, and play begins only at `start`. In parallel and ghost it draws no\nnumbers from `Math.random`, which would change the round's start: use\n`AIHub.rng('card')`.\n\n`card` arrives whenever it changes, and every second while the countdown runs:\n\n| Field | |\n|---|---|\n| `left` | milliseconds until the round starts by itself; `null` while paused or starting |\n| `paused` | `true` while most players asked for more time |\n| `starting` | `true` once the countdown is over or everyone is ready: `start` follows when every game has loaded |\n| `ready` | the ids of the players who are ready |\n| `asking` | how many players asked for more time (never who) |\n| `asked` | `true` when this player asked for more time |\n\n### The start\n\n`start` arrives when the round starts. Play begins three seconds later, when\n`AIHub.time()` reaches 0. `AIHub.time()` is the same timeline on every device,\ngive or take about 15 ms: negative during the countdown, `-Infinity` before\n`start`.\n\n### Reporting\n\n- `AIHub.progress({ score, label })`, in parallel and ghost: the player's\n  standing during the round. `score` is a number, higher is ahead; `label` is\n  text for the hub's scoreboard. The hub takes the latest about once a second.\n- `AIHub.result({ time })` or `AIHub.result({ score })`, in parallel and\n  ghost, once, when the player's round is over. `time` is milliseconds of\n  `AIHub.time()`, lower wins; `score` is a number, higher wins.\n- `AIHub.finish({ standings, scores, won })`, in a shared world, called once,\n  by the host only:\n  - `standings`: arrays of player ids, best first; players in the same array\n    tie. It lists every player still in the round once; anyone left out is\n    placed last.\n  - `scores` (optional): `{ id: number }`, shown on the scoreboard.\n  - `won` (optional): `true` or `false` when the round is a team result.\n\n### Time-up and the end\n\n- The hub may call time while the round is still going. On `time-up`, the\n  game reports within `graceMs`: a `result()` in parallel and ghost, a\n  `finish()` from the host in a shared world. A shared world with no\n  `finish()` by then is void.\n- `end` is the last message of a round. After it, the game takes no input and\n  sends nothing, and its sound stops. The hub shows its results over the\n  game, then removes it.\n\n| `end` reason | |\n|---|---|\n| `finished` | the round counted; `standings` is the final order |\n| `void` | it didn't count (no result, a fatal error, skipped) |\n| `host-left` | the host of a shared world left |\n| `sat-out` | this player missed the ready deadline |\n| `session-ended` | the session closed |\n\n### Leaving\n\n- `leave` arrives with `{ id, reason }` when a player leaves: `left`,\n  `disconnected`, `not-ready` or `kicked`. It is final for the round.\n- A parallel or ghost round goes on whoever leaves, the host included.\n- A shared-world round is void when its host leaves, isn't ready, or has its\n  tab hidden for more than 20 seconds.\n- `AIHub.fail(message)`: the game cannot run in this browser. From the host\n  of a shared world it voids the round; from any other copy it counts as\n  that player leaving.\n\n### Scoring\n\n- Parallel and ghost: players with a `time` rank first, lowest first; then\n  the rest by `score`. A player with no result is ranked by their last\n  progress.\n- Shared world: the host's `standings`. With `won`, the results show a team\n  result instead of medals.\n- Each player gets one point for every player they beat.\n\n`result()` and `finish()` may also carry `stats` and `awards`, shown with the\nresults:\n\n- in `result()`: `stats` is `{ name: value }` and `awards` is\n  `[{ title, detail }]`, for this player;\n- in `finish()`: `stats` is `{ id: { name: value } }` and `awards` is\n  `[{ id, title, detail }]`, for each player.\n\nPlaces and points come only from the standings, `time` and `score`.\n\n---\n\n## Sending data between copies\n\n### Parallel\n\nThe copies send nothing to each other. `send()` is not used.\n\n### Ghost\n\nEach copy sends its own player's position and what the player is doing to\nthe other copies with `send()`. Each copy shows the other players' characters\nonly while they are in the same area of the game as its own player, and those\ncharacters do not affect its world. `Math.random` is seeded as in parallel.\n\n### Shared world\n\n- The host's copy (`AIHub.isHost`) runs the world. The other copies send the\n  host what their own player does, and show the world the host sends them.\n- The hub can run the host's copy with no player of its own: `AIHub.server`\n  is `true` and `AIHub.me` is not among `AIHub.players`. The host's copy runs\n  the world in that case too, with no local player, camera or input.\n- `Math.random` is not seeded. `AIHub.rng(label)` gives the same numbers on\n  every copy.\n\n### `send()` and `message`\n\n- `AIHub.send(data, { to, reliable })` sends `data` to every other copy, or\n  to the one player `to`. It returns `false` when the message is dropped.\n- `AIHub.on('message', (data, from) => …)` receives it; `from` is the\n  sender's player id. A copy never receives its own messages. Messages sent\n  before another copy has loaded are queued for it.\n- `data` is JSON, at most 16 KB.\n- At most 20 messages a second leave each copy, with bursts up to 40; the\n  client drops the rest.\n- Reliable messages (the default) arrive in the order they were sent.\n  Messages sent with `reliable: false` may be lost or arrive out of order. An\n  unreliable message larger than about 1,200 bytes travels as several packets\n  and is lost whole if any of them is.\n\n---\n\n## Rules\n\nIn a session:\n\n- **Network only through the hub.** No WebSocket, WebRTC, or `fetch` to a\n  game server or public broker. Loading the game's own files is fine.\n- **No communication between players.** No chat, voice, emotes or custom\n  names. Names come from the hub.\n- **The page stays.** No `alert`, `confirm` or `prompt`; no `window.open`,\n  new tabs or navigating away. Quitting, restarting or returning to a title\n  screen does nothing; the hub starts and ends rounds.\n- **Create + Options is the hub's.** On a controller, holding the two\n  together opens the hub's corner bar; the game ignores Options while Create\n  is held.\n\nEverything on this page applies only in a session (`AIHub.active`). Outside\none, the game is not affected.\n\n---\n\n## Test it\n\nThe harness plays the hub: it loads the game 1–4 times on a simulated network\nand runs the checks the hub runs when a game joins the library. Serve it next\nto the game:\n\n```bash\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/bridge.js\ncurl -fsSO https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/round.js\npython3 -m http.server 8000\n```\n\nThen open `http://localhost:8000/harness.html?game=GAME.html&players=2&auto=1`.\nThe hub's own test also runs ghost and shared-world games with\n`&players=4&latency=150&jitter=50&loss=5&auto=1`, again with\n`&scenario=host-leave`, and shared worlds once more with\n`&players=2&scenario=server`.\n\nThe checklist fills in as it runs. **A game passes when\n`window.__hubCheck.pass` is true**; `document.body.dataset.complete` becomes\n`\"true\"` at the end. It checks:\n\n- the tags, `connect()`, `ready()` with no key press, and the start;\n- with the game's own card, that Enter answers Ready;\n- parallel and ghost: `Math.random` the same on every copy, and progress from\n  every copy; parallel sends nothing, ghost sends;\n- shared world: traffic both ways, and a round hosted by a copy with no\n  player of its own;\n- a player leaving, the host leaving, time-up, a valid result, and every copy\n  told the round ended;\n- no protocol problems, errors, dialogs, popups or sockets.\n\n**New round**, **Time up**, **Remove player** and **Hide host tab** run the\ncases by hand; clicking a player's frame gives it the keyboard and mouse.\n`&limit=` sets the round's length in seconds and `&seed=` fixes the seed. The\ngame is served from the harness's own origin.\n\nIn the AI Hub repository, `node scripts/hub-check.mjs <game>` runs the same\nchecks with Playwright, then opens the game outside a session to see it still\nruns there.\n\n---\n\n## Reference\n\n### Tags\n\n| Tag | |\n|---|---|\n| `hub:session` | `1`: this protocol |\n| `hub:session-players` | `MIN-MAX`: the number of players the game takes in a session |\n| `hub:session-mode` | `parallel`, `ghost` or `shared-world` |\n| `hub:session-goal` | how to win, shown on the hub's card |\n| `hub:session-howto` | the controls, shown on the hub's card |\n| `hub:session-minutes` | optional: how many minutes a round takes |\n| `hub:webgpu` | optional: `required` when the game cannot run without WebGPU |\n\n### API\n\n| | |\n|---|---|\n| `AIHub.active` | `true` in a session, from the first line |\n| `AIHub.connect({ mode, seats, card? })` | → `Promise<info \\| null>`; `null`: no hub. `card: true`: the game shows its own card |\n| `AIHub.ready()` | once, when the round can start |\n| `AIHub.answer('ready' \\| 'more')` | on the game's own card, before `start` |\n| `AIHub.time()` | milliseconds since play began: negative in the countdown, `-Infinity` before `start` |\n| `AIHub.on(event, fn)` | returns a function that removes the handler |\n| `AIHub.progress({ score, label })` | parallel and ghost |\n| `AIHub.result({ time \\| score, stats?, awards? })` | parallel and ghost, once |\n| `AIHub.finish({ standings, scores?, won?, stats?, awards? })` | shared world, the host, once |\n| `AIHub.send(data, { to, reliable })` | ghost and shared world |\n| `AIHub.rng(label)` | a generator of numbers in `[0, 1)`, the same on every copy, one stream per label |\n| `AIHub.seeded` | `true` when the client seeded `Math.random` |\n| `AIHub.fail(message)` | the game cannot run in this browser |\n\n`AIHub.probe()` and `AIHub.inspect()` exist for older games; the hub does not\nread them.\n\n| Event | Arguments |\n|---|---|\n| `card` | `{ left, paused, starting, ready, asking, asked }`, with the game's own card |\n| `start` | `{ in }`: milliseconds until play begins |\n| `message` | `data, from` |\n| `leave` | `{ id, reason }` |\n| `time-up` | `{ graceMs }` |\n| `end` | `{ reason, standings }` |\n\nEvents that arrive before a handler is attached are kept, and delivered in\norder when the first handler is attached. Fields and events a newer hub adds\nreach the game through the client unchanged.\n\n### Versions\n\nThis is protocol **1**, client **1.4.0**. Changes within version 1 only add:\ngames on older clients keep working. A change that would break a game becomes\nprotocol 2, with its own `hub:session` value.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {createWorld,createHelicopter,createTruck,createJet,createBoss,createPilot,palette} from './visuals.js';\nimport {AudioEngine} from './audio.js';\nimport {createOnline} from './online.js';\nimport report from './report.json';\n\nconst \"'$=id=>document.getElementById(id), clamp=(v,a,b)=>Math.max(a,Math.min(b,v)), wrap=x=>((x+100)%200+200)%200-100, delta=(a,b)=>wrap(a-b), dist=(a,b)=>Math.hypot(delta(a.x,b.x),a.y-b.y);\nlet rng=724832;function random(){rng=(Math.imul(rng,1664525)+1013904223)>>>0;return rng/4294967296}const rand=(a,b)=>a+random()*(b-a);\nconst defaults={speed:17,spawnRate:1,damage:1,armor:1,power:1,timeScale:1};let tune={...defaults},godMode=false;\nlet settings={music:.1,sfx:.65,glyphs:'\"'ps',autoFire:false,reducedShake:false};try{settings={...settings,...JSON.parse(localStorage.getItem('palooza-settings')||'{}')}}catch{}\nlet high=0;try{high=+localStorage.getItem('palooza-high')||0}catch{}\nconst audio=new AudioEngine();audio.setVolume(settings.music,settings.sfx);\nconst keys=new Set();let lastInput='keyboard',mouse={x:0,y:0,down:false,active:false},touch={active:false,id:null,x:0,y:0,baseX:0,baseY:0,aimId:null,aimX:1,aimY:0},idle=0,screen='title',backTarget='title',gameMode='title',lastTick=0,accum=0,cameraX=0,toastTimer=0,radioTimer=0,shake=0,flash=0,gamepadPrev=[],navClock=0,flareLatch=false,pauseLatch=false,rescueNear=false,localCoop=false,testMode=false,testPilot=false,lastSnapshot=null,remoteInputs={};\nlet renderer,scene,camera,worldVisual,physics,queue;let entities=[],particles=[],pilots=[],ships=[],trucks=[],boss=null,uid=1;\nlet stage=0,stageTime=0,totalTime=0,spawnClock=0,score=0,kills=0,rescues=0,shotsFired=0,combo=0,comboTime=0,upgrades=0,bossSeen=false,won=false,lossReason='',attractClock=0,finished=false;\nconst sectorNames=['DUST UP','CROSSWIND','RED ROCK RUN','THE BIG CHOP'];const stageLengths=[43,49,55];\nconst online=createOnline({\n onStatus(t){\"'$('\"'netStatus').textContent=t;\"'$('\"'roomDisplay').textContent=online.room||'';\"'$('\"'netLaunch').style.display=online.role==='host'?'block':'none'},\n onStart(){startGame(false,true)},onInput(input,seat){remoteInputs[seat]=input},onState(state){lastSnapshot=state;applySnapshot(state)},\n onHub(){showScreen('none');\"'$('\"'loading').style.display='none';gameMode='waiting'},\n onTimeUp(){if(online.isHost)endGame(trucks.some(t=>t.hp>0),'The patrol clock ran out. The convoy made it this far.')},\n onEnd(){gameMode='ended';audio.setVolume(0,0);keys.clear();mouse.down=false},\n onDisconnect(){remoteInputs={};if(ships[1])ships[1].inactive=true;radio('Wingmate signed off. You have the patrol, Lucky.');}\n});\nfunction saveSettings(){try{localStorage.setItem('palooza-settings',JSON.stringify(settings))}catch{}audio.setVolume(settings.music,settings.sfx)}\nfunction inputUsed(type){idle=0;if(lastInput\"'!==type){lastInput=type;updatePrompts()}}\nfunction toast(title,sub='\"'',time=3){\"'$('\"'toast').querySelector('strong').textContent=title;\"'$('\"'toast').querySelector('span').textContent=sub;\"'$('\"'toast').classList.add('show');toastTimer=time}\nfunction radio(text,time=5){\"'$('\"'radio').querySelector('p').textContent=text;\"'$('\"'radio').style.display='block';radioTimer=time;if(gameMode\"'!=='\"'attract')audio.voice(text)}\nfunction showScreen(name){screen=name;for(const s of document.querySelectorAll('.screen'))s.classList.toggle('open',s.id===name+'Screen');if(name\"'!=='\"'none'){mouse.down=false;keys.clear();const b=\"'$(name+'\"'Screen')?.querySelector('button,input,select');b?.focus({preventScroll:true})}\"'$('\"'pauseButton').style.display=gameMode==='play'&&name==='none'?'block':'none'}\nfunction updatePrompts(){const pad=lastInput==='gamepad',xbox=settings.glyphs==='xbox';\"'$('\"'controls').innerHTML=lastInput==='touch'?'':pad?\"'`${xbox?'\"'RT':'R2'} FIRE &nbsp; \"'${xbox?'\"'B':'○'} FLARE<br>\"'${xbox?'\"'LT':'L2'} BOOST &nbsp; \"'${xbox?'\"'A':'×'} RESCUE\"'`:'\"'WASD FLY &nbsp; CLICK / SPACE FIRE<br>SHIFT BOOST &nbsp; Q FLARE &nbsp; E RESCUE';\"'$('\"'helpControls').textContent=pad?\"'`Left stick flies. Right stick aims. ${xbox?'\"'RT / X':'R2 / □'} fires; \"'${xbox?'\"'LT':'L2'} boosts. Options pauses.\"'`:'\"'WASD or arrows to fly. Aim with your mouse and hold click, Space or J to fire. Shift boosts.';\"'$('\"'helpRescue').textContent=\"'`Hover low beside a waving pilot to rescue automatically, or press ${pad?(xbox?'\"'A':'×'):'E'}. Each rescue repairs your hull and earns a flare.\"'`;$('\"'helpFlare').textContent=\"'`${pad?(xbox?'\"'B':'○'):'Q'} releases a flare: enemy shots vanish and nearby hostiles take a hit. Beat three sectors, pick field upgrades, then stop the carrier.\"'`;$('\"'touchHint').style.display=lastInput==='touch'&&screen==='none'&&gameMode==='play'?'block':'none'}\nfunction removeEntity(e){if(e.dead)return;e.dead=true;scene.remove(e.mesh);if(e.body){physics.removeRigidBody(e.body);e.body=null}if(e.temporary)e.mesh.geometry?.dispose()}\nfunction clearWorld(){for(const e of entities)removeEntity(e);for(const p of particles){scene.remove(p.mesh);p.mesh.geometry?.dispose()}for(const p of pilots)scene.remove(p.mesh);entities=[];particles=[];pilots=[];ships=[];trucks=[];boss=null;physics.free();queue.free();physics=new RAPIER.World({x:0,y:0,z:0});queue=new RAPIER.EventQueue(true)}\nfunction bodyFor(e,hx,hy,offset=0){e.body=physics.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(e.x,e.y+offset,0));e.collider=physics.createCollider(RAPIER.ColliderDesc.cuboid(hx,hy,.8).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS).setActiveCollisionTypes(RAPIER.ActiveCollisionTypes.ALL),e.body);e.offset=offset;e.collider.userData=e;entities.push(e);return e}\nconst colliders=new Map();function addEntity(e,hx,hy,offset=0){scene.add(e.mesh);bodyFor(e,hx,hy,offset);colliders.set(e.collider.handle,e);return e}\nfunction makeShip(index){const e={id:uid++,type:'ship',index,x:index? -7:0,y:14,hp:100,maxHp:100,lives:2,flares:3,inv:2,cool:0,boost:1,face:1,aimX:1,aimY:0,vx:0,vy:0,rescueClock:0,inactive:false,mesh:createHelicopter(index?0xf5ca57:palette.teal)};e.mesh.position.set(e.x,e.y,2+index*.2);ships.push(e);addEntity(e,1.55,.65);return e}\nfunction startGame(attract=false,network=false){if(\"'!physics)return;clearWorld();colliders.clear();rng=724832;uid=1;stage=0;stageTime=0;totalTime=0;spawnClock=1;score=0;kills=0;rescues=0;shotsFired=0;combo=0;comboTime=0;upgrades=0;bossSeen=false;won=false;finished=false;lossReason='\"'';attractClock=0;remoteInputs={};localCoop=false;gameMode=attract?'attract':'play';showScreen('none');const count=network?Math.max(1,online.players.length||2):1;for(let i=0;i<count;i++)makeShip(i);for(let i=0;i<6;i++){const e={id:uid++,type:'truck',x:-23+i*8,y:.12,hp:100,mesh:createTruck()};trucks.push(e);addEntity(e,2,1,1)}spawnPilot(22);spawnPilot(-62);cameraX=0;\"'$('\"'hud').classList.add('visible');\"'$('\"'attract').style.display=attract?'block':'none';\"'$('\"'bossHud').style.display='none';audio.start();if(\"'!attract){audio.sfx('\"'start');toast('SCRAMBLE, LUCKY\"'!'\"','SECTOR 01 / DUST UP');radio('Six trucks. One long road. Keep the sky clear, Lucky.')}updatePrompts();updateHUD()}\nfunction title(){if(online.hub)return;online.leave();gameMode='title';finished=false;showScreen('title');\"'$('\"'hud').classList.remove('visible');\"'$('\"'attract').style.display='none';\"'$('\"'bossHud').style.display='none';\"'$('\"'radio').style.display='none';\"'$('\"'rescueAction').style.display='none';\"'$('\"'toast').classList.remove('show');idle=0;if(physics){clearWorld();colliders.clear();const ship=makeShip(0);ship.x=18;ship.y=17;ship.mesh.scale.setScalar(1.8);for(let i=0;i<5;i++){const t={id:uid++,type:'truck',x:-5+i*11,y:.12,hp:100,mesh:createTruck()};trucks.push(t);addEntity(t,2,1,1)}cameraX=0;spawnEnemy('heli',-26,23);spawnEnemy('jet',36,28)}}\nfunction spawnPilot(x){const mesh=createPilot();mesh.position.set(x,.2,3);scene.add(mesh);pilots.push({id:uid++,x,y:.2,mesh,clock:0})}\nfunction spawnEnemy(kind='heli',x=null,y=null){const p=ships[0]||{x:0};if(x===null)x=wrap(p.x+(random()>.5?1:-1)*rand(34,58));if(y===null)y=rand(18,31);const e={id:uid++,type:'enemy',kind,x,y,baseY:y,hp:kind==='jet'?48:kind==='ace'?110:65,maxHp:kind==='ace'?110:65,face:random()>.5?1:-1,vx:0,vy:0,cool:rand(1,3),age:0,inv:0,mesh:kind==='jet'?createJet():createHelicopter(kind==='ace'?0x795274:palette.coral,true)};if(kind\"'!=='\"'jet')e.mesh.scale.setScalar(.85);addEntity(e,kind==='jet'?2:1.6,.75);return e}\nfunction spawnBoss(){if(boss)return;for(const e of entities.filter(e=>e.type==='enemy'))removeEntity(e);stage=3;stageTime=0;bossSeen=true;boss={id:uid++,type:'boss',x:wrap((ships[0]?.x||0)+27),y:24,hp:1500,maxHp:1500,age:0,cool:1,face:-1,mesh:createBoss()};addEntity(boss,7,2.6);\"'$('\"'bossHud').style.display='block';toast('THE BIG CHOP','Take down the command carrier.');radio('That is a very large helicopter. You know what to do.');audio.voice('big chop')}\nfunction bullet(source,vx,vy,hostile=false,damage=20,xoff=null,yoff=0){const x=wrap(source.x+(xoff??(Math.sign(vx)*2.5))),y=source.y+yoff;const mesh=new THREE.Mesh(new THREE.BoxGeometry(hostile?.6:1.75,hostile?.35:.16,.2),new THREE.MeshBasicMaterial({color:hostile?0xf7714a:0xfff4b0}));const e={id:uid++,type:'bullet',hostile,owner:source.index??-1,x,y,vx,vy,hp:1,damage,age:0,mesh,temporary:true};mesh.rotation.z=Math.atan2(vy,vx);addEntity(e,hostile?.3:.8,hostile?.2:.15);if(\"'!hostile){shotsFired++;if(shotsFired%2===0)audio.sfx('\"'shoot')}return e}\nfunction burst(x,y,color=palette.coral,count=20,size=1){for(let i=0;i<count;i++){const mesh=new THREE.Mesh(new THREE.BoxGeometry(1,1,.5),new THREE.MeshBasicMaterial({color:i%4===0?palette.cream:i%3===0?palette.ink:color,transparent:true}));const a=rand(0,Math.PI*2),s=rand(3,13)*size;mesh.position.set(x,y,3);const scale=rand(.14,.65)*size;mesh.scale.setScalar(scale);scene.add(mesh);particles.push({mesh,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:rand(.25,.85),max:.85,spin:rand(-8,8)})}shake=Math.max(shake,.2*size)}\nfunction damage(e,amount,owner=0){if(e.dead||e.hp<=0)return;if((godMode||gameMode==='attract')&&(e.type==='ship'||e.type==='truck'))return;if(e.type==='ship'&&e.inv>0)return;e.hp-=amount;if(e.type==='ship'){e.inv=.6;flash=.5;shake=.45;audio.sfx('hit')}if(e.type==='truck')amount/=tune.armor;if(e.hp>0){if(e.type==='enemy'||e.type==='boss')burst(e.x,e.y,palette.yellow,4,.35);return}if(e.type==='ship'){burst(e.x,e.y,palette.teal,35,1.5);audio.sfx('boom');if(e.lives>0){e.lives--;e.hp=e.maxHp;e.x=trucks.find(t=>t.hp>0)?.x||0;e.y=17;e.inv=3;e.flares=Math.max(2,e.flares);toast('BACK IN THE AIR',\"'`${e.lives} REPLACEMENT${e.lives===1?'\"'':'S'} LEFT\"'`)}else{e.hp=0;e.inactive=true;e.mesh.visible=false;if(ships.every(s=>s.inactive))endGame(false,'\"'Out of choppers. The convoy will remember you.')}}else if(e.type==='truck'){e.hp=0;burst(e.x,2,palette.coral,35,1.7);e.mesh.rotation.z=-.1;e.mesh.children.forEach(m=>{if(m.material?.color)m.material=m.material.clone(),m.material.color.multiplyScalar(.5)});audio.sfx('boom');radio('Truck down\"'! Keep those raiders off the road.'\"',3);if(trucks.every(t=>t.hp<=0))endGame(false,'The road went quiet. Every truck was lost.')}else{combo=comboTime>0?combo+1:1;comboTime=2.5;kills++;score+=(e.type==='boss'?8000:e.kind==='ace'?350:e.kind==='jet'?200:150)*Math.min(combo,5);burst(e.x,e.y,e.type==='boss'?palette.yellow:palette.coral,e.type==='boss'?80:24,e.type==='boss'?3:1);audio.sfx('boom');removeEntity(e);if(e.type==='boss'){endGame(true,'You brought the convoy home. Dusty says the next tank of fuel is on him.')}else if(kills%5===0&&pilots.length<4)spawnPilot(e.x)}}\nfunction flare(ship){if(ship.flares<=0||ship.inactive)return;ship.flares--;audio.sfx('flare');burst(ship.x,ship.y,palette.cream,45,2.2);for(const e of [...entities])if(e.type==='bullet'&&e.hostile)removeEntity(e);else if((e.type==='enemy'||e.type==='boss')&&Math.abs(delta(e.x,ship.x))<43)damage(e,e.type==='boss'?150:120,ship.index);toast('SKY CLEAR\"'!'\"','FLARE DEPLOYED',1.4)}\nfunction rescuePilot(p,ship){scene.remove(p.mesh);pilots=pilots.filter(x=>x\"'!==p);rescues++;score+=600;ship.hp=Math.min(ship.maxHp,ship.hp+30);ship.flares=Math.min(5,ship.flares+1);audio.sfx('\"'rescue');burst(ship.x,ship.y,palette.teal,15,.7);toast('PILOT ABOARD','+600 / HULL REPAIRED / +1 FLARE',2);if(rescues===1)radio('Good catch, Lucky\"'! That pilot owes you lunch.'\"',3)}\nfunction pilotAI(ship){let target=entities.filter(e=>(e.type==='enemy'||e.type==='boss')&&\"'!e.dead).sort((a,b)=>dist(a,ship)-dist(b,ship))[0];const p=pilots.sort((a,b)=>Math.abs(delta(a.x,ship.x))-Math.abs(delta(b.x,ship.x)))[0];if(p&&((totalTime%28)<8||!target))target={...p,y:4.1,rescue:true};if(!target)target={x:trucks[3]?.x||0,y:17};const dx=delta(target.x,ship.x),dy=target.y-ship.y;let x=clamp(dx*.3,-1,1),y=clamp(dy*.5,-1,1);if(!target.rescue&&Math.abs(dx)<19)x=0;const aimDX=target.rescue?ship.face:dx;return {x,y,fire:!target.rescue,flare:entities.filter(e=>e.type==='\"'bullet'&&e.hostile&&dist(e,ship)<10).length>3&&ship.flares>0,rescue:true,boost:Math.abs(dx)>35,aimX:Math.abs(aimDX)<.1?ship.face:Math.sign(aimDX),aimY:target.rescue?0:clamp(dy/Math.max(5,Math.abs(dx)),-.75,.75)}}\nfunction readInput(index=0){const pads=navigator.getGamepads?.()||[];const pad=pads[index];const dead=v=>Math.abs(v||0)>.16?v:0;let x=0,y=0,fire=false,flare=false,rescue=false,boost=false,aimX=0,aimY=0;if(index===0){x=(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0);y=(keys.has('KeyW')||keys.has('ArrowUp')?1:0)-(keys.has('KeyS')||keys.has('ArrowDown')?1:0);fire=keys.has('Space')||keys.has('KeyJ')||mouse.down||settings.autoFire;flare=keys.has('KeyQ');rescue=keys.has('KeyE');boost=keys.has('ShiftLeft')||keys.has('ShiftRight');if(mouse.active&&lastInput==='keyboard'){const ship=ships[index];if(ship){const v=new THREE.Vector3(mouse.x,mouse.y,0).unproject(camera);const dx=v.x-ship.x;aimX=Math.sign(dx)||ship.face;aimY=clamp((v.y-ship.y)/Math.max(3,Math.abs(dx)),-.8,.8)}}if(touch.active){x=clamp((touch.x-touch.baseX)/60,-1,1);y=clamp((touch.baseY-touch.y)/60,-1,1);fire=true;rescue=true;aimX=touch.aimId\"'!==null?touch.aimX:ships[0]?.face||1;aimY=touch.aimId!==null?touch.aimY:0}}\nif(pad){const px=dead(pad.axes[0]),py=-dead(pad.axes[1]);if(px||py){x=px;y=py;inputUsed('\"'gamepad')}const ax=dead(pad.axes[2]),ay=-dead(pad.axes[3]);if(ax||ay){aimX=Math.sign(ax)||ships[index]?.face||1;aimY=clamp(ay/Math.max(.35,Math.abs(ax)),-.8,.8);inputUsed('gamepad')}fire=fire||\"'!!pad.buttons[7]?.pressed||!!pad.buttons[2]?.pressed;flare=flare||!!pad.buttons[1]?.pressed;rescue=rescue||!!pad.buttons[0]?.pressed;boost=boost||!!pad.buttons[6]?.pressed;if(pad.buttons.some(b=>b.pressed))inputUsed('\"'gamepad')}\nreturn{x,y,fire,flare,rescue,boost,aimX,aimY}}\nfunction updateShip(ship,dt,input){if(ship.inactive)return;ship.inv=Math.max(0,ship.inv-dt);ship.cool-=dt;const boosting=input.boost&&ship.boost>.05;ship.boost=clamp(ship.boost+dt*(boosting?-.35:.2),0,1);const speed=tune.speed*(boosting?1.65:1);const len=Math.max(1,Math.hypot(input.x,input.y));ship.vx=THREE.MathUtils.damp(ship.vx,input.x/len*speed,8,dt);ship.vy=THREE.MathUtils.damp(ship.vy,input.y/len*speed,8,dt);ship.x=wrap(ship.x+ship.vx*dt);ship.y=clamp(ship.y+ship.vy*dt,3.2,33);if(Math.abs(input.x)>.1)ship.face=Math.sign(input.x);if(input.aimX){ship.face=Math.sign(input.aimX);ship.aimX=ship.face;ship.aimY=input.aimY||0}else{ship.aimX=ship.face;ship.aimY=0}ship.mesh.rotation.y=ship.face===1?0:Math.PI;ship.mesh.rotation.z=-ship.vx*.008;ship.mesh.visible=ship.inv<=0||Math.floor(ship.inv*12)%2===0;if(input.fire&&ship.cool<=0){const len=Math.hypot(ship.aimX,ship.aimY);bullet(ship,ship.aimX/len*72,ship.aimY/len*72,false,20*tune.power,ship.face*2.8,-.45);ship.cool=.145}if(input.flare&&\"'!ship.flareWas)flare(ship);ship.flareWas=input.flare;\nfor(const p of pilots){if(Math.abs(delta(p.x,ship.x))<3.5&&ship.y<6.3){rescueNear=true;p.clock+=dt;if(input.rescue||p.clock>.85)rescuePilot(p,ship)}}}\nfunction stageComplete(){if(stage>=3)return;if(gameMode==='\"'attract'||testPilot||online.hub){applyUpgrade('gun');return}showScreen('upgrade');audio.sfx('pickup');\"'$('\"'upgradeTitle').textContent=stage===0?'Dust settled.':'Still in one piece.';radio('Next sector ahead. The crew has a present for you.',3)}\nfunction applyUpgrade(type){if(type==='gun')tune.power*=1.3;else{tune.speed*=1.15;for(const s of ships)s.maxHp+=25}upgrades++;for(const s of ships){s.hp=s.maxHp;s.flares=Math.min(5,s.flares+1);s.inv=2}for(const t of trucks)if(t.hp>0)t.hp=Math.min(100,t.hp+30);stage++;stageTime=0;spawnClock=2;for(const e of entities)if(e.type==='bullet'&&e.hostile)removeEntity(e);showScreen('none');if(stage===3)spawnBoss();else{toast('SECTOR 0'+(stage+1),sectorNames[stage]);spawnPilot(wrap(ships[0].x+32));radio(stage===1?'Jets inbound. Watch the radar; they are quick.':'Red Rock pass. The raider aces are waiting.',4)}syncDev()}\nfunction simulate(dt){if(finished||\"'!['\"'play','attract'].includes(gameMode)||screen\"'!=='\"'none'||\"'!online.canPlay)return;dt*=tune.timeScale;totalTime+=dt;stageTime+=dt;attractClock+=dt;comboTime-=dt;rescueNear=false;for(const p of pilots)p.clock=Math.max(0,p.clock-dt*.15);\nfor(let i=0;i<ships.length;i++){const remote=online.connected&&(online.server||i!==online.seat);let input=remote?(remoteInputs[i]||{}):readInput(i);if(gameMode==='\"'attract'||testPilot)input=pilotAI(ships[i]);updateShip(ships[i],dt,{x:0,y:0,...input})}\nfor(let i=0;i<trucks.length;i++){const t=trucks[i];if(t.hp>0){t.x=wrap(t.x+1.3*dt);t.mesh.position.y=.12+Math.sin(totalTime*12+i)*.025;if(random()<dt*4)trail(t.x-2,.5)}}\nspawnClock-=dt;if(stage<3&&spawnClock<=0){spawnClock=(stage===0?3.7:stage===1?3.1:2.8)/tune.spawnRate;if(entities.filter(e=>e.type==='enemy'&&\"'!e.dead).length<13){spawnEnemy(stage===2&&random()>.5?'\"'ace':stage>0&&random()>.45?'jet':'heli');if(stage>0&&random()>.6)spawnEnemy('heli')}}\nfor(const e of [...entities]){if(e.dead)continue;if(e.type==='enemy'){e.age+=dt;e.cool-=dt;const target=trucks.filter(t=>t.hp>0).sort((a,b)=>Math.abs(delta(a.x,e.x))-Math.abs(delta(b.x,e.x)))[0]||ships[0];if(e.kind==='jet'){e.x=wrap(e.x+e.face*(stage===2?19:16)*dt);e.y=e.baseY+Math.sin(e.age*1.5)*1.4;if(Math.abs(delta(target.x,e.x))<8&&e.cool<=0){bullet(e,e.face*2,-22,true,24,0,-1);e.cool=1.5}if(e.age>17)removeEntity(e)}else{const dx=delta(target.x,e.x);e.face=Math.sign(dx)||1;e.x=wrap(e.x+clamp(dx,-7,7)*dt*.7);e.y=clamp(e.baseY+Math.sin(e.age*1.4+e.id)*2.6,10,31);if(e.cool<=0){const dx=delta(target.x,e.x),dy=2-e.y,len=Math.hypot(dx,dy);bullet(e,dx/len*19,dy/len*19,true,e.kind==='ace'?22:16,0,-.8);e.cool=e.kind==='ace'?1.7:2.6}}e.mesh.rotation.y=e.face===1?0:Math.PI;e.mesh.rotation.z=e.kind==='jet'?Math.sin(e.age)*.04:Math.sin(e.age*1.5)*.06;\n}else if(e.type==='boss'){e.age+=dt;e.cool-=dt;const p=ships.find(s=>\"'!s.inactive)||ships[0];const targetX=wrap(p.x+24);e.x=wrap(e.x+clamp(delta(targetX,e.x),-6,6)*dt);e.y=23+Math.sin(e.age*.6)*4;if(e.cool<=0){e.cool=e.hp<e.maxHp*.5?.85:1.5;for(let j=-1;j<=1;j++){const dx=delta(p.x,e.x),dy=p.y-e.y+j*5,len=Math.hypot(dx,dy);bullet(e,dx/len*22,dy/len*22,true,15,-6,-1)}const t=trucks.filter(t=>t.hp>0)[Math.floor(random()*trucks.filter(t=>t.hp>0).length)];if(t)bullet(e,delta(t.x,e.x)*.5,-17,true,20,0,-3)}if(e.age>9&&e.age%14<dt&&entities.filter(e=>e.type==='\"'enemy'&&\"'!e.dead).length<4)spawnEnemy('\"'jet',wrap(e.x+22),29);\n}else if(e.type==='bullet'){e.age+=dt;e.x=wrap(e.x+e.vx*dt);e.y+=e.vy*dt;if(e.age>(e.hostile?6:1.45)||e.y<.3||e.y>38){if(e.hostile&&e.y<.3)burst(e.x,.4,palette.sand,4,.4);removeEntity(e)}}\nif(\"'!e.dead){e.mesh.position.x=e.x;if(e.type!=='\"'truck')e.mesh.position.y=e.y;e.mesh.position.z=e.type==='bullet'?2.5:e.type==='truck'?0:2;e.body.setNextKinematicTranslation({x:e.x,y:e.y+(e.offset||0),z:0});e.mesh.userData.mixer?.update(dt)}}\nphysics.timestep=dt;physics.step(queue);queue.drainCollisionEvents((h1,h2,started)=>{if(\"'!started)return;const a=colliders.get(h1),b=colliders.get(h2);if(!a||!b||a.dead||b.dead)return;const shot=a.type==='\"'bullet'?a:b.type==='bullet'?b:null,target=shot===a?b:a;if(shot){const allowed=shot.hostile?(target.type==='ship'||target.type==='truck'):(target.type==='enemy'||target.type==='boss');if(allowed){damage(target,shot.damage*(shot.hostile?tune.damage:1)/(target.type==='truck'?tune.armor:1),shot.owner);removeEntity(shot)}}else if(a.type==='ship'&&(b.type==='enemy'||b.type==='boss'))damage(a,22*tune.damage);else if(b.type==='ship'&&(a.type==='enemy'||a.type==='boss'))damage(b,22*tune.damage)});entities=entities.filter(e=>\"'!e.dead);for(const [h,e]of colliders)if(e.dead)colliders.delete(h);\nfor(const p of pilots)p.mesh.userData.mixer?.update(dt);updateParticles(dt);if(stage<3&&stageTime>=stageLengths[stage])stageComplete();if(gameMode==='\"'attract'&&(attractClock>210||finished))startGame(true);\"'$('\"'rescueAction').style.display=lastInput==='touch'&&rescueNear?'block':'none'}\nfunction trail(x,y){if(particles.length>350)return;const mesh=new THREE.Mesh(new THREE.BoxGeometry(.4,.3,.1),new THREE.MeshBasicMaterial({color:palette.cream,transparent:true,opacity:.4}));mesh.position.set(x,y,1);scene.add(mesh);particles.push({mesh,vx:-1,vy:.5,life:.8,max:.8,spin:0})}\nfunction updateParticles(dt){for(const p of particles){p.life-=dt;p.mesh.position.x+=p.vx*dt;p.mesh.position.y+=p.vy*dt;p.vy-=dt*8;p.mesh.rotation.z+=p.spin*dt;p.mesh.material.opacity=Math.max(0,p.life/p.max);if(p.life<=0){scene.remove(p.mesh);p.mesh.geometry.dispose();p.mesh.material.dispose()}}particles=particles.filter(p=>p.life>0)}\nfunction endGame(victory,reason=''){if(finished)return;if(gameMode==='attract'){startGame(true);return}finished=true;won=victory;lossReason=reason;gameMode='debrief';score+=victory?trucks.filter(t=>t.hp>0).length*1000+rescues*200:0;if(score>high){high=score;try{localStorage.setItem('palooza-high',high)}catch{}}\"'$('\"'debriefEyebrow').textContent=victory?'PATROL COMPLETE / ROAD CLEAR':'PATROL ENDED / RETRY READY';\"'$('\"'debriefTitle').textContent=victory?'Convoy delivered.':'A rough landing.';\"'$('\"'debriefMessage').textContent=reason;\"'$('\"'debriefStats').innerHTML=\"'`<div class=\"stat\"><b>${String(score).padStart(6,'\"'0')}</b><span>FINAL SCORE</span></div><div class=\\\"stat\\\"><b>\"'${trucks.filter(t=>t.hp>0).length} / 6</b><span>TRUCKS DELIVERED</span></div><div class=\"stat\"><b>${kills}</b><span>HOSTILES DOWN</span></div><div class=\"stat\"><b>${rescues}</b><span>PILOTS RECOVERED</span></div>`;if(!online.hub)showScreen('\"'debrief');audio.sfx(victory?'victory':'loss');if(victory)radio('Road clear\"'! Six wheels down, rotors up. Nice work, Lucky.'\"',6);online.finish(score,victory,{Kills:kills,Rescues:rescues,Convoy:trucks.filter(t=>t.hp>0).length})}\nfunction getSnapshot(){return{v:1,mode:gameMode,screen,stage,stageTime,totalTime,score,kills,rescues,upgrades,won,finished,bossSeen,ships:ships.map(s=>({id:s.id,x:s.x,y:s.y,hp:s.hp,maxHp:s.maxHp,lives:s.lives,flares:s.flares,face:s.face,inv:s.inv,inactive:s.inactive})),trucks:trucks.map(t=>({id:t.id,x:t.x,y:t.y,hp:t.hp})),enemies:entities.filter(e=>e.type==='enemy'||e.type==='boss').map(e=>({id:e.id,x:e.x,y:e.y,hp:e.hp,maxHp:e.maxHp,type:e.type,kind:e.kind,face:e.face})),bullets:entities.filter(e=>e.type==='bullet').slice(-70).map(e=>({id:e.id,x:e.x,y:e.y,vx:e.vx,vy:e.vy,hostile:e.hostile})),pilots:pilots.map(p=>({id:p.id,x:p.x,y:p.y}))}}\nfunction applySnapshot(s){if(online.isHost||\"'!s?.v)return;const was=gameMode;gameMode=s.mode;stage=s.stage;stageTime=s.stageTime;totalTime=s.totalTime;score=s.score;kills=s.kills;rescues=s.rescues;won=s.won;finished=s.finished;bossSeen=s.bossSeen;$('\"'hud').classList.add('visible');if(s.finished&&was\"'!=='\"'debrief'){finished=false;endGame(s.won,s.won?'Convoy delivered. Good flying, wingmate.':'The patrol ended. Time for another sortie.')}if(\"'!s.finished)showScreen('\"'none');const all=[...s.ships.map((e,i)=>({...e,type:'ship',index:i})),...s.trucks.map(e=>({...e,type:'truck'})),...s.enemies,...s.bullets.map(e=>({...e,type:'bullet'}))];const wanted=new Set(all.map(e=>e.id));for(const e of entities)if(\"'!wanted.has(e.id))removeEntity(e);entities=entities.filter(e=>!e.dead);for(const data of all){let e=entities.find(e=>e.id===data.id);if(!e){const mesh=data.type==='\"'ship'?createHelicopter(data.index?palette.yellow:palette.teal):data.type==='truck'?createTruck():data.type==='boss'?createBoss():data.type==='bullet'?new THREE.Mesh(new THREE.BoxGeometry(1,.18,.18),new THREE.MeshBasicMaterial({color:data.hostile?palette.coral:palette.cream})):data.kind==='jet'?createJet():createHelicopter(palette.coral,true);e={...data,mesh};scene.add(mesh);entities.push(e)}Object.assign(e,data);e.mesh.position.set(data.x,data.y,data.type==='truck'?0:2);e.mesh.rotation.y=data.face===-1?Math.PI:0;e.mesh.visible=\"'!data.inactive;if(data.type==='\"'bullet')e.mesh.rotation.z=Math.atan2(data.vy,data.vx)}ships=entities.filter(e=>e.type==='ship').sort((a,b)=>a.index-b.index);trucks=entities.filter(e=>e.type==='truck');boss=entities.find(e=>e.type==='boss');for(const p of pilots)if(\"'!s.pilots.some(a=>a.id===p.id))scene.remove(p.mesh);pilots=pilots.filter(p=>s.pilots.some(a=>a.id===p.id));for(const p of s.pilots)if(!pilots.some(a=>a.id===p.id)){const mesh=createPilot();mesh.position.set(p.x,p.y,3);scene.add(mesh);pilots.push({...p,mesh})}}\nfunction updateHUD(){const me=ships[online.connected?online.seat:0]||ships[0];if(!me)return;$('\"'pilotLabel').textContent=\"'`0${(me.index||0)+1} / ${me.index?'\"'PATCHES':'LUCKY'} · \"'${me.lives} SPARES`;$('\"'lifeLabel').textContent=\"'`HULL ${Math.ceil(Math.max(0,me.hp))}  /  ✦ ${me.flares}`;$('\"'hull').innerHTML=Array.from({length:10},(_,i)=>\"'`<i class=\"${me.hp/me.maxHp*10>i?'\"'':'off'}\\\"></i>\"'`).join('\"'');\"'$('\"'score').textContent=String(score).padStart(6,'0');\"'$('\"'highScore').textContent=String(Math.max(high,score)).padStart(6,'0');\"'$('\"'sectorLabel').textContent=\"'`SECTOR 0${Math.min(4,stage+1)} / ${sectorNames[stage]}`;$('\"'objective').textContent=stage===3?'DESTROY THE COMMAND CARRIER':\"'`ESCORT THE CONVOY · ${Math.max(0,Math.ceil(stageLengths[stage]-stageTime))}s`;$('\"'trucks').innerHTML=trucks.map(t=>\"'`<i class=\"${t.hp>0?'\"'':'dead'}\\\"></i>\"'`).join('\"'');\"'$('\"'cargoLabel').textContent=\"'`${trucks.filter(t=>t.hp>0).length} / 6`;$('\"'bossHud').style.display=boss&&\"'!boss.dead?'\"'block':'none';if(boss)\"'$('\"'bossFill').style.width=clamp(boss.hp/boss.maxHp*100,0,100)+'%';drawRadar()}\nfunction drawRadar(){const c=\"'$('\"'radar'),ctx=c.getContext('2d');ctx.clearRect(0,0,c.width,c.height);ctx.strokeStyle='#4a7370';ctx.lineWidth=1;for(let i=0;i<10;i++){ctx.beginPath();ctx.moveTo(i*62,0);ctx.lineTo(i*62,82);ctx.stroke()}ctx.fillStyle='#23494a';ctx.fillRect(0,66,620,16);const xy=e=>[(e.x+100)/200*620,67-e.y/35*60];for(const t of trucks){const[x,y]=xy(t);ctx.fillStyle=t.hp>0?'#ffc757':'#6f5148';ctx.fillRect(x-4,67,9,5)}for(const p of pilots){const[x,y]=xy(p);ctx.fillStyle='#fff0cf';ctx.fillRect(x-2,60,4,5)}for(const e of entities.filter(e=>e.type==='enemy'||e.type==='boss')){const[x,y]=xy(e);ctx.fillStyle=e.type==='boss'?'#ff4f45':'#f27151';ctx.beginPath();ctx.moveTo(x,y-4);ctx.lineTo(x+5,y+3);ctx.lineTo(x-5,y+3);ctx.fill()}for(const s of ships){if(s.inactive)continue;const[x,y]=xy(s);ctx.fillStyle=s.index?'#ffc757':'#67dbc0';ctx.beginPath();ctx.arc(x,y,4,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#fff0cf';ctx.strokeRect(x-7,y-7,14,14)}const left=(cameraX-camera.right+100)/200*620,right=(cameraX+camera.right+100)/200*620;ctx.strokeStyle='#a5d1b477';ctx.strokeRect(left,1,right-left,78)}\nfunction menuBack(){if(screen==='pause')resume();else if(screen==='dev')showScreen('pause');else if(screen==='title')return;else showScreen(backTarget)}\nfunction pause(){if(online.hub||gameMode\"'!=='\"'play')return;if(screen==='none'){showScreen('pause');audio.sfx('menu')}else if(screen==='pause')resume()}\nfunction resume(){showScreen('none');audio.sfx('menu');updatePrompts()}\nfunction syncDev(){for(const [key]of Object.entries(defaults)){const v=\"'$('\"'dev-'+key);if(v){v.value=tune[key];\"'$('\"'value-'+key).textContent=Number(tune[key]).toFixed(key==='speed'?0:2)}}\"'$('\"'godMode').checked=godMode}\nfunction initUI(){const specs=[['speed','Flight speed',8,32,1],['spawnRate','Enemy traffic',.25,3,.05],['damage','Incoming damage',.1,3,.05],['armor','Convoy armor',.25,4,.05],['power','Weapon power',.25,4,.05],['timeScale','Simulation speed',.25,3,.05]];\"'$('\"'devSliders').innerHTML=specs.map(([k,l,a,b,s])=>\"'`<label class=\"labelrow\" for=\"dev-${k}\">${l}<output id=\"value-${k}\">${tune[k]}</output></label><input type=\"range\" id=\"dev-${k}\" min=\"${a}\" max=\"${b}\" step=\"${s}\" value=\"${tune[k]}\">`).join('\"'');for(const[k]of specs)\"'$('\"'dev-'+k).addEventListener('input',e=>{tune[k]=+e.target.value;syncDev()});\"'$('\"'godMode').onchange=e=>godMode=e.target.checked;for(const k of ['music','sfx']){const e=\"'$(k);e.value=settings[k]*100;$(k+'\"'Value').textContent=Math.round(settings[k]*100)+'%';e.oninput=()=>{settings[k]=+e.value/100;\"'$(k+'\"'Value').textContent=e.value+'%';saveSettings()}}for(const k of ['autoFire','reducedShake']){\"'$(k).checked=settings[k];$(k).onchange=e=>{settings[k]=e.target.checked;saveSettings()}}$('\"'glyphs').value=settings.glyphs;\"'$('\"'glyphs').onchange=e=>{settings.glyphs=e.target.value;saveSettings();updatePrompts()};\"'$('\"'pauseButton').onclick=pause;\"'$('\"'rescueAction').onclick=()=>{if(ships[0])for(const p of [...pilots])if(Math.abs(delta(p.x,ships[0].x))<4)rescuePilot(p,ships[0])};\nfor(const b of document.querySelectorAll('[data-action]'))b.addEventListener('click',async()=>{audio.start();audio.sfx('menu');inputUsed('keyboard');const action=b.dataset.action;if(['settings','help','about','online'].includes(action)){backTarget=screen==='pause'?'pause':'title';showScreen(action);return}if(action==='back'){menuBack();return}if(action==='start')startGame();if(action==='resume')resume();if(action==='dev'){syncDev();showScreen('dev')}if(action==='restart'&&\"'!online.hub)startGame(false,online.connected);if(action==='\"'title')title();if(action==='upgradeGun')applyUpgrade('gun');if(action==='upgradeArmor')applyUpgrade('armor');if(action==='host'){b.disabled=true;try{const code=await online.host();\"'$('\"'roomDisplay').textContent=code;\"'$('\"'netLaunch').style.display='block'}catch(e){\"'$('\"'netStatus').textContent=e.message}b.disabled=false}if(action==='join')await online.join(\"'$('\"'roomCode').value);if(action==='netStart')startGame(false,true);if(action==='nextSector'){if(stage<3)applyUpgrade('gun');else toast('FINAL SECTOR','The carrier is already here.');showScreen('dev')}if(action==='spawnBoss'){spawnBoss();showScreen('none')}if(action==='heal'){for(const s of ships){s.hp=s.maxHp;s.flares=5;s.lives=2;s.inactive=false;s.mesh.visible=true}for(const t of trucks)t.hp=100;toast('REPAIRED','ALL PILOTS & TRUCKS')}if(action==='clear'){for(const e of entities)if(e.type==='enemy'||e.type==='bullet')removeEntity(e);toast('CLEAR SKIES','HOSTILES REMOVED')}if(action==='resetTune'){tune={...defaults};godMode=false;syncDev()}if(action==='victory')endGame(true,'Developer hangar: victory screen check.');});\nfor(const b of document.querySelectorAll('button,input,select'))b.addEventListener('pointerenter',()=>{if(document.activeElement\"'!==b)b.focus({preventScroll:true})});let html='\"'<h3>Source Information</h3>';for(const[k,v]of Object.entries(report.sourceInformation))html+=\"'`<div class=\"credit-line\"><b>${k.replace(/([A-Z])/g,'\"' \"'$1'\"')}:</b> \"'${v}</div>`;for(const [k,label]of [['\"'testingFeedback','Testing Feedback'],['engineFeedback','Engine Feedback'],['promptFeedback','Prompt Feedback']]){html+=\"'`<h3>${label}</h3>`;for(const a of report[k])html+=`<div class=\"credit-line\">${a}</div>`}$('\"'credits').innerHTML=html;updatePrompts()}\nfunction inputEvent(e){inputUsed(e.pointerType==='touch'?'touch':'keyboard');if(gameMode==='attract'){e.preventDefault();title();return true}return false}\nwindow.addEventListener('keydown',e=>{if(inputEvent(e))return;if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Escape','Tab'].includes(e.code)&&e.target.tagName\"'!=='\"'INPUT')e.preventDefault();if(e.code==='Escape'||e.code==='KeyP'){if(screen==='none')pause();else menuBack();return}keys.add(e.code);if(screen\"'!=='\"'none'){if(['ArrowDown','ArrowUp','Tab'].includes(e.code))navigate(e.code==='ArrowUp'||e.shiftKey?-1:1);if(e.code==='Enter'||e.code==='Space'){if(document.activeElement?.tagName==='BUTTON')document.activeElement.click()}}});window.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();mouse.down=false;if(gameMode==='play'&&screen==='none'&&\"'!online.connected)pause()});window.addEventListener('\"'pointerdown',e=>{inputEvent(e);if(\"'!audio.ctx)audio.start()},{capture:true});$('\"'game').addEventListener('pointermove',e=>{if(e.pointerType==='touch'){if(e.pointerId===touch.id){touch.x=e.clientX;touch.y=e.clientY}else if(e.pointerId===touch.aimId){const dx=e.clientX-innerWidth*.75,dy=innerHeight*.5-e.clientY;touch.aimX=Math.sign(dx)||1;touch.aimY=clamp(dy/Math.max(20,Math.abs(dx)),-.8,.8)}return}inputUsed('keyboard');mouse.x=e.clientX/innerWidth*2-1;mouse.y=-e.clientY/innerHeight*2+1;mouse.active=true});\"'$('\"'game').addEventListener('pointerdown',e=>{if(screen\"'!=='\"'none')return;if(e.pointerType==='touch'){inputUsed('touch');if(e.clientX<innerWidth*.55&&touch.id===null){touch.active=true;touch.id=e.pointerId;touch.baseX=touch.x=e.clientX;touch.baseY=touch.y=e.clientY}else{touch.aimId=e.pointerId;touch.aimX=e.clientX>innerWidth*.75?1:-1;touch.aimY=0;if(ships[0]&&e.timeStamp-(touch.lastTap||0)<330)flare(ships[0]);touch.lastTap=e.timeStamp}\"'$('\"'game').setPointerCapture(e.pointerId)}else{mouse.down=true;mouse.active=true}});window.addEventListener('pointerup',e=>{mouse.down=false;if(e.pointerId===touch.id){touch.active=false;touch.id=null}if(e.pointerId===touch.aimId)touch.aimId=null});window.addEventListener('contextmenu',e=>e.preventDefault());\nfunction navigate(dir){const s=\"'$(screen+'\"'Screen');if(\"'!s)return;const items=[...s.querySelectorAll('\"'button,input,select')].filter(e=>\"'!e.disabled&&getComputedStyle(e).display!=='\"'none'&&e.offsetParent\"'!==null);const i=items.indexOf(document.activeElement);items[(i+dir+items.length)%items.length]?.focus({preventScroll:true});audio.sfx('\"'menu')}\nfunction pollGamepad(dt){navClock-=dt;const pads=navigator.getGamepads?.()||[];for(let i=0;i<Math.min(pads.length,2);i++){const p=pads[i];if(\"'!p)continue;const prev=gamepadPrev[i]||[];const pressed=b=>p.buttons[b]?.pressed&&!prev[b];const any=p.buttons.some(b=>b.pressed)||p.axes.some(a=>Math.abs(a)>.2);if(any){inputUsed('\"'gamepad');if(gameMode==='attract'){title();gamepadPrev[i]=p.buttons.map(b=>b.pressed);continue}}if(i===1&&pressed(0)&&gameMode==='play'&&ships.length===1&&\"'!online.connected){makeShip(1);localCoop=true;toast('\"'PATCHES REPORTING','WINGMATE JOINED / SHARED SCORE')}if(pressed(9)&&\"'!p.buttons[8]?.pressed){if(screen==='\"'none')pause();else if(screen==='pause')resume();else if(screen\"'!=='\"'title')menuBack()}if(screen\"'!=='\"'none'){const dir=p.axes[1]>.5||p.buttons[13]?.pressed?1:p.axes[1]<-.5||p.buttons[12]?.pressed?-1:0;if(dir&&navClock<=0){navigate(dir);navClock=.2}const focus=document.activeElement;if(focus?.tagName==='INPUT'&&focus.type==='range'&&navClock<=0){const lr=p.axes[0]>.5||p.buttons[15]?.pressed?1:p.axes[0]<-.5||p.buttons[14]?.pressed?-1:0;if(lr){focus.value=clamp(+focus.value+lr*(+focus.step||1),+focus.min,+focus.max);focus.dispatchEvent(new Event('input'));navClock=.12}}if(pressed(0)){if(focus?.tagName==='BUTTON')focus.click();else if(focus?.type==='checkbox'){focus.checked=\"'!focus.checked;focus.dispatchEvent(new Event('\"'change'))}else if(focus?.tagName==='SELECT'){focus.selectedIndex=(focus.selectedIndex+1)%focus.options.length;focus.dispatchEvent(new Event('change'))}}if(pressed(1)&&screen\"'!=='\"'title')menuBack()}gamepadPrev[i]=p.buttons.map(b=>b.pressed)}}\nfunction resize(){if(\"'!renderer)return;const aspect=innerWidth/innerHeight;const h=aspect<1?59:43;camera.left=-h*aspect/2;camera.right=h*aspect/2;camera.top=h/2;camera.bottom=-h/2;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)}window.addEventListener('\"'resize',resize);\nfunction animate(ms){const dt=Math.min(.06,(ms-lastTick)/1000||.016);lastTick=ms;idle+=dt;pollGamepad(dt);if(screen==='title'&&idle>10&&\"'!online.hub)startGame(true);if(online.connected&&!online.isHost){if(!online.ended)online.sendInput(readInput(0));for(const e of entities)e.mesh.userData.mixer?.update(dt)}else if(!testMode){accum+=dt;while(accum>=1/60){simulate(1/60);accum-=1/60}}if(gameMode==='\"'title'){const s=ships[0];if(s){s.y=17+Math.sin(ms*.001)*.6;s.mesh.position.set(18,s.y,3);s.mesh.rotation.z=Math.sin(ms*.0006)*.04;s.mesh.userData.mixer?.update(dt)}for(const e of entities)if(e\"'!==s)e.mesh.userData.mixer?.update(dt);for(let i=0;i<trucks.length;i++){trucks[i].mesh.position.x=-13+i*12+Math.sin(ms*.0001)*2}}\nconst followed=ships[online.connected?online.seat:0]||ships[0];let target=gameMode==='\"'title'?5:followed?followed.x+followed.face*9:0;if(Math.abs(cameraX-target)>120)cameraX=target;cameraX=THREE.MathUtils.damp(cameraX,target,3,dt);shake=Math.max(0,shake-dt);flash=Math.max(0,flash-dt*2);const j=settings.reducedShake?0:shake;camera.position.set(cameraX+Math.sin(ms*.09)*j,19+Math.cos(ms*.12)*j,70);camera.lookAt(cameraX,18,0);worldVisual.update(dt,cameraX,ms/1000);if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)\"'$('\"'toast').classList.remove('show')}if(radioTimer>0){radioTimer-=dt;if(radioTimer<=0)\"'$('\"'radio').style.display='none'}\"'$('\"'damageFlash').style.opacity=flash;audio.update(dt,{playing:screen==='none'&&gameMode==='play'&&\"'!online.ended,throttle:Math.hypot(followed?.vx||0,followed?.vy||0)/25,danger:trucks.filter(t=>t.hp>0).length<3,boss:stage===3});updateHUD();if(online.connected)online.tick(dt,getSnapshot());renderer.render(scene,camera)}\nasync function init(){try{initUI();await RAPIER.init();physics=new RAPIER.World({x:0,y:0,z:0});queue=new RAPIER.EventQueue(true);scene=new THREE.Scene();scene.background=new THREE.Color(palette.sky);scene.fog=new THREE.Fog(palette.sky,110,260);camera=new THREE.OrthographicCamera(-40,40,21.5,-21.5,.1,300);renderer=new THREE.WebGPURenderer({canvas:$('\"'game'),antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=.9;await renderer.init();worldVisual=createWorld(scene);resize();title();\"'$('\"'loading').style.display='none';renderer.setAnimationLoop(animate);await online.initHub();window.__game={ready:true,get state(){return getSnapshot()},get mode(){return gameMode},get backend(){return renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2 fallback'},get physicsVersion(){return RAPIER.version()},get audio(){return audio},get online(){return{role:online.role,hub:online.hub,connected:online.connected,server:online.server,canPlay:online.canPlay}},start:()=>{testMode=true;startGame()},step:seconds=>{testMode=true;for(let i=0;i<Math.round(seconds*60);i++)simulate(1/60);updateHUD();return getSnapshot()},realtime:()=>{testMode=false},pilot:value=>{testPilot=value},tune:values=>{Object.assign(tune,values);syncDev()},invincible:value=>{godMode=value},spawn:(kind,x,y)=>{const e=spawnEnemy(kind,x,y);return e.id},damageShip:amount=>damage(ships[0],amount),damageTruck:(index,amount)=>damage(trucks[index],amount),setShip:(x,y)=>{ships[0].x=x;ships[0].y=y;ships[0].inv=0},flare:()=>flare(ships[0]),rescue:()=>spawnPilot(ships[0].x),boss:spawnBoss,upgrade:applyUpgrade,pause,screen:()=>screen,menu:name=>showScreen(name),title,devDefaults:()=>({...defaults}),get tuneValues(){return{...tune}},get diagnostics(){return{entities:entities.length,physicsBodies:physics.bodies.len(),animations:entities.filter(e=>e.mesh.userData.mixer).length,audio:audio.diagnostics(),shotsFired,combo,pilots:pilots.length,testMode}},offlineAudio:async()=>{const ctx=new OfflineAudioContext(2,96000,48000);const a=new AudioEngine({context:ctx});await a.start();a.update(.016,{playing:true,throttle:1,boss:true});for(const n of ['shoot','hit','boom','rescue','flare','pickup','menu','start','victory','loss'])a.sfx(n);a.voice('Lucky');const buf=await ctx.startRendering();let sum=0,peak=0,finite=true;for(const v of buf.getChannelData(0)){sum+=v*v;peak=Math.max(peak,Math.abs(v));if(\"'!Number.isFinite(v))finite=false}return{rms:Math.sqrt(sum/buf.length),peak,finite,stats:a.diagnostics()}}};}catch(error){console.error(error);$('\"'loading').style.display='flex';\"'$('\"'loadError').textContent='Unable to start the patrol: '+error.message+'. Use a browser with WebGPU or WebGL 2 enabled.';globalThis.AIHub?.fail?.(error.message);window.__game={ready:false,error:error.message}}}\ninit();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {createWorld,createHelicopter,createTruck,createJet,createBoss,createPilot,palette} from './visuals.js';\nimport {AudioEngine} from './audio.js';\nimport {createOnline} from './online.js';\nimport report from './report.json';\n\nconst \"'$=id=>document.getElementById(id), clamp=(v,a,b)=>Math.max(a,Math.min(b,v)), wrap=x=>((x+100)%200+200)%200-100, delta=(a,b)=>wrap(a-b), dist=(a,b)=>Math.hypot(delta(a.x,b.x),a.y-b.y);\nlet rng=724832;function random(){rng=(Math.imul(rng,1664525)+1013904223)>>>0;return rng/4294967296}const rand=(a,b)=>a+random()*(b-a);\nconst defaults={speed:17,spawnRate:1,damage:1,armor:1,power:1,timeScale:1};let tune={...defaults},godMode=false;\nlet settings={music:.1,sfx:.65,glyphs:'\"'ps',autoFire:false,reducedShake:false};try{settings={...settings,...JSON.parse(localStorage.getItem('palooza-settings')||'{}')}}catch{}\nlet high=0;try{high=+localStorage.getItem('palooza-high')||0}catch{}\nconst audio=new AudioEngine();audio.setVolume(settings.music,settings.sfx);\nconst keys=new Set();let lastInput='keyboard',mouse={x:0,y:0,down:false,active:false},touch={active:false,id:null,x:0,y:0,baseX:0,baseY:0,aimId:null,aimX:1,aimY:0},idle=0,screen='title',backTarget='title',gameMode='title',lastTick=0,accum=0,cameraX=0,toastTimer=0,radioTimer=0,shake=0,flash=0,gamepadPrev=[],navClock=0,flareLatch=false,pauseLatch=false,rescueNear=false,localCoop=false,testMode=false,testPilot=false,lastSnapshot=null,remoteInputs={};\nlet renderer,scene,camera,worldVisual,physics,queue;let entities=[],particles=[],pilots=[],ships=[],trucks=[],boss=null,uid=1;\nlet stage=0,stageTime=0,totalTime=0,spawnClock=0,score=0,kills=0,rescues=0,shotsFired=0,combo=0,comboTime=0,upgrades=0,bossSeen=false,won=false,lossReason='',attractClock=0,finished=false;\nconst sectorNames=['DUST UP','CROSSWIND','RED ROCK RUN','THE BIG CHOP'];const stageLengths=[43,49,55];\nconst online=createOnline({\n onStatus(t){\"'$('\"'netStatus').textContent=t;\"'$('\"'roomDisplay').textContent=online.room||'';\"'$('\"'netLaunch').style.display=online.role==='host'?'block':'none'},\n onStart(){startGame(false,true)},onInput(input,seat){remoteInputs[seat]=input},onState(state){lastSnapshot=state;applySnapshot(state)},\n onHub(){showScreen('none');\"'$('\"'loading').style.display='none';gameMode='waiting'},\n onTimeUp(){if(online.isHost)endGame(trucks.some(t=>t.hp>0),'The patrol clock ran out. The convoy made it this far.')},\n onEnd(){gameMode='ended';audio.setVolume(0,0);keys.clear();mouse.down=false},\n onDisconnect(){remoteInputs={};if(ships[1])ships[1].inactive=true;radio('Wingmate signed off. You have the patrol, Lucky.');}\n});\nfunction saveSettings(){try{localStorage.setItem('palooza-settings',JSON.stringify(settings))}catch{}audio.setVolume(settings.music,settings.sfx)}\nfunction inputUsed(type){idle=0;if(lastInput\"'!==type){lastInput=type;updatePrompts()}}\nfunction toast(title,sub='\"'',time=3){\"'$('\"'toast').querySelector('strong').textContent=title;\"'$('\"'toast').querySelector('span').textContent=sub;\"'$('\"'toast').classList.add('show');toastTimer=time}\nfunction radio(text,time=5){\"'$('\"'radio').querySelector('p').textContent=text;\"'$('\"'radio').style.display='block';radioTimer=time;if(gameMode\"'!=='\"'attract')audio.voice(text)}\nfunction showScreen(name){screen=name;for(const s of document.querySelectorAll('.screen'))s.classList.toggle('open',s.id===name+'Screen');if(name\"'!=='\"'none'){mouse.down=false;keys.clear();const b=\"'$(name+'\"'Screen')?.querySelector('button,input,select');b?.focus({preventScroll:true})}\"'$('\"'pauseButton').style.display=gameMode==='play'&&name==='none'?'block':'none'}\nfunction updatePrompts(){const pad=lastInput==='gamepad',xbox=settings.glyphs==='xbox';\"'$('\"'controls').innerHTML=lastInput==='touch'?'':pad?\"'`${xbox?'\"'RT':'R2'} FIRE &nbsp; \"'${xbox?'\"'B':'○'} FLARE<br>\"'${xbox?'\"'LT':'L2'} BOOST &nbsp; \"'${xbox?'\"'A':'×'} RESCUE\"'`:'\"'WASD FLY &nbsp; CLICK / SPACE FIRE<br>SHIFT BOOST &nbsp; Q FLARE &nbsp; E RESCUE';\"'$('\"'helpControls').textContent=pad?\"'`Left stick flies. Right stick aims. ${xbox?'\"'RT / X':'R2 / □'} fires; \"'${xbox?'\"'LT':'L2'} boosts. Options pauses.\"'`:'\"'WASD or arrows to fly. Aim with your mouse and hold click, Space or J to fire. Shift boosts.';\"'$('\"'helpRescue').textContent=\"'`Hover low beside a waving pilot to rescue automatically, or press ${pad?(xbox?'\"'A':'×'):'E'}. Each rescue repairs your hull and earns a flare.\"'`;$('\"'helpFlare').textContent=\"'`${pad?(xbox?'\"'B':'○'):'Q'} releases a flare: enemy shots vanish and nearby hostiles take a hit. Beat three sectors, pick field upgrades, then stop the carrier.\"'`;$('\"'touchHint').style.display=lastInput==='touch'&&screen==='none'&&gameMode==='play'?'block':'none'}\nfunction removeEntity(e){if(e.dead)return;e.dead=true;scene.remove(e.mesh);if(e.body){physics.removeRigidBody(e.body);e.body=null}if(e.temporary)e.mesh.geometry?.dispose()}\nfunction clearWorld(){for(const e of entities)removeEntity(e);for(const p of particles){scene.remove(p.mesh);p.mesh.geometry?.dispose()}for(const p of pilots)scene.remove(p.mesh);entities=[];particles=[];pilots=[];ships=[];trucks=[];boss=null;physics.free();queue.free();physics=new RAPIER.World({x:0,y:0,z:0});queue=new RAPIER.EventQueue(true)}\nfunction bodyFor(e,hx,hy,offset=0){e.body=physics.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(e.x,e.y+offset,0));e.collider=physics.createCollider(RAPIER.ColliderDesc.cuboid(hx,hy,.8).setSensor(true).setActiveEvents(RAPIER.ActiveEvents.COLLISION_EVENTS).setActiveCollisionTypes(RAPIER.ActiveCollisionTypes.ALL),e.body);e.offset=offset;e.collider.userData=e;entities.push(e);return e}\nconst colliders=new Map();function addEntity(e,hx,hy,offset=0){scene.add(e.mesh);bodyFor(e,hx,hy,offset);colliders.set(e.collider.handle,e);return e}\nfunction makeShip(index){const e={id:uid++,type:'ship',index,x:index? -7:0,y:14,hp:100,maxHp:100,lives:2,flares:3,inv:2,cool:0,boost:1,face:1,aimX:1,aimY:0,vx:0,vy:0,rescueClock:0,inactive:false,mesh:createHelicopter(index?0xf5ca57:palette.teal)};e.mesh.position.set(e.x,e.y,2+index*.2);ships.push(e);addEntity(e,1.55,.65);return e}\nfunction startGame(attract=false,network=false){if(\"'!physics)return;clearWorld();colliders.clear();rng=724832;uid=1;stage=0;stageTime=0;totalTime=0;spawnClock=1;score=0;kills=0;rescues=0;shotsFired=0;combo=0;comboTime=0;upgrades=0;bossSeen=false;won=false;finished=false;lossReason='\"'';attractClock=0;remoteInputs={};localCoop=false;gameMode=attract?'attract':'play';showScreen('none');const count=network?Math.max(1,online.players.length||2):1;for(let i=0;i<count;i++)makeShip(i);for(let i=0;i<6;i++){const e={id:uid++,type:'truck',x:-23+i*8,y:.12,hp:100,mesh:createTruck()};trucks.push(e);addEntity(e,2,1,1)}spawnPilot(22);spawnPilot(-62);cameraX=0;\"'$('\"'hud').classList.add('visible');\"'$('\"'attract').style.display=attract?'block':'none';\"'$('\"'bossHud').style.display='none';audio.start();if(\"'!attract){audio.sfx('\"'start');toast('SCRAMBLE, LUCKY\"'!'\"','SECTOR 01 / DUST UP');radio('Six trucks. One long road. Keep the sky clear, Lucky.')}updatePrompts();updateHUD()}\nfunction title(){if(online.hub)return;online.leave();gameMode='title';finished=false;showScreen('title');\"'$('\"'hud').classList.remove('visible');\"'$('\"'attract').style.display='none';\"'$('\"'bossHud').style.display='none';\"'$('\"'radio').style.display='none';\"'$('\"'rescueAction').style.display='none';\"'$('\"'toast').classList.remove('show');idle=0;if(physics){clearWorld();colliders.clear();const ship=makeShip(0);ship.x=18;ship.y=17;ship.mesh.scale.setScalar(1.8);for(let i=0;i<5;i++){const t={id:uid++,type:'truck',x:-5+i*11,y:.12,hp:100,mesh:createTruck()};trucks.push(t);addEntity(t,2,1,1)}cameraX=0;spawnEnemy('heli',-26,23);spawnEnemy('jet',36,28)}}\nfunction spawnPilot(x){const mesh=createPilot();mesh.position.set(x,.2,3);scene.add(mesh);pilots.push({id:uid++,x,y:.2,mesh,clock:0})}\nfunction spawnEnemy(kind='heli',x=null,y=null){const p=ships[0]||{x:0};if(x===null)x=wrap(p.x+(random()>.5?1:-1)*rand(34,58));if(y===null)y=rand(18,31);const e={id:uid++,type:'enemy',kind,x,y,baseY:y,hp:kind==='jet'?48:kind==='ace'?110:65,maxHp:kind==='ace'?110:65,face:random()>.5?1:-1,vx:0,vy:0,cool:rand(1,3),age:0,inv:0,mesh:kind==='jet'?createJet():createHelicopter(kind==='ace'?0x795274:palette.coral,true)};if(kind\"'!=='\"'jet')e.mesh.scale.setScalar(.85);addEntity(e,kind==='jet'?2:1.6,.75);return e}\nfunction spawnBoss(){if(boss)return;for(const e of entities.filter(e=>e.type==='enemy'))removeEntity(e);stage=3;stageTime=0;bossSeen=true;boss={id:uid++,type:'boss',x:wrap((ships[0]?.x||0)+27),y:24,hp:1500,maxHp:1500,age:0,cool:1,face:-1,mesh:createBoss()};addEntity(boss,7,2.6);\"'$('\"'bossHud').style.display='block';toast('THE BIG CHOP','Take down the command carrier.');radio('That is a very large helicopter. You know what to do.');audio.voice('big chop')}\nfunction bullet(source,vx,vy,hostile=false,damage=20,xoff=null,yoff=0){const x=wrap(source.x+(xoff??(Math.sign(vx)*2.5))),y=source.y+yoff;const mesh=new THREE.Mesh(new THREE.BoxGeometry(hostile?.6:1.75,hostile?.35:.16,.2),new THREE.MeshBasicMaterial({color:hostile?0xf7714a:0xfff4b0}));const e={id:uid++,type:'bullet',hostile,owner:source.index??-1,x,y,vx,vy,hp:1,damage,age:0,mesh,temporary:true};mesh.rotation.z=Math.atan2(vy,vx);addEntity(e,hostile?.3:.8,hostile?.2:.15);if(\"'!hostile){shotsFired++;if(shotsFired%2===0)audio.sfx('\"'shoot')}return e}\nfunction burst(x,y,color=palette.coral,count=20,size=1){for(let i=0;i<count;i++){const mesh=new THREE.Mesh(new THREE.BoxGeometry(1,1,.5),new THREE.MeshBasicMaterial({color:i%4===0?palette.cream:i%3===0?palette.ink:color,transparent:true}));const a=rand(0,Math.PI*2),s=rand(3,13)*size;mesh.position.set(x,y,3);const scale=rand(.14,.65)*size;mesh.scale.setScalar(scale);scene.add(mesh);particles.push({mesh,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:rand(.25,.85),max:.85,spin:rand(-8,8)})}shake=Math.max(shake,.2*size)}\nfunction damage(e,amount,owner=0){if(e.dead||e.hp<=0)return;if((godMode||gameMode==='attract')&&(e.type==='ship'||e.type==='truck'))return;if(e.type==='ship'&&e.inv>0)return;e.hp-=amount;if(e.type==='ship'){e.inv=.6;flash=.5;shake=.45;audio.sfx('hit')}if(e.type==='truck')amount/=tune.armor;if(e.hp>0){if(e.type==='enemy'||e.type==='boss')burst(e.x,e.y,palette.yellow,4,.35);return}if(e.type==='ship'){burst(e.x,e.y,palette.teal,35,1.5);audio.sfx('boom');if(e.lives>0){e.lives--;e.hp=e.maxHp;e.x=trucks.find(t=>t.hp>0)?.x||0;e.y=17;e.inv=3;e.flares=Math.max(2,e.flares);toast('BACK IN THE AIR',\"'`${e.lives} REPLACEMENT${e.lives===1?'\"'':'S'} LEFT\"'`)}else{e.hp=0;e.inactive=true;e.mesh.visible=false;if(ships.every(s=>s.inactive))endGame(false,'\"'Out of choppers. The convoy will remember you.')}}else if(e.type==='truck'){e.hp=0;burst(e.x,2,palette.coral,35,1.7);e.mesh.rotation.z=-.1;e.mesh.children.forEach(m=>{if(m.material?.color)m.material=m.material.clone(),m.material.color.multiplyScalar(.5)});audio.sfx('boom');radio('Truck down\"'! Keep those raiders off the road.'\"',3);if(trucks.every(t=>t.hp<=0))endGame(false,'The road went quiet. Every truck was lost.')}else{combo=comboTime>0?combo+1:1;comboTime=2.5;kills++;score+=(e.type==='boss'?8000:e.kind==='ace'?350:e.kind==='jet'?200:150)*Math.min(combo,5);burst(e.x,e.y,e.type==='boss'?palette.yellow:palette.coral,e.type==='boss'?80:24,e.type==='boss'?3:1);audio.sfx('boom');removeEntity(e);if(e.type==='boss'){endGame(true,'You brought the convoy home. Dusty says the next tank of fuel is on him.')}else if(kills%5===0&&pilots.length<4)spawnPilot(e.x)}}\nfunction flare(ship){if(ship.flares<=0||ship.inactive)return;ship.flares--;audio.sfx('flare');burst(ship.x,ship.y,palette.cream,45,2.2);for(const e of [...entities])if(e.type==='bullet'&&e.hostile)removeEntity(e);else if((e.type==='enemy'||e.type==='boss')&&Math.abs(delta(e.x,ship.x))<43)damage(e,e.type==='boss'?150:120,ship.index);toast('SKY CLEAR\"'!'\"','FLARE DEPLOYED',1.4)}\nfunction rescuePilot(p,ship){scene.remove(p.mesh);pilots=pilots.filter(x=>x\"'!==p);rescues++;score+=600;ship.hp=Math.min(ship.maxHp,ship.hp+30);ship.flares=Math.min(5,ship.flares+1);audio.sfx('\"'rescue');burst(ship.x,ship.y,palette.teal,15,.7);toast('PILOT ABOARD','+600 / HULL REPAIRED / +1 FLARE',2);if(rescues===1)radio('Good catch, Lucky\"'! That pilot owes you lunch.'\"',3)}\nfunction pilotAI(ship){let target=entities.filter(e=>(e.type==='enemy'||e.type==='boss')&&\"'!e.dead).sort((a,b)=>dist(a,ship)-dist(b,ship))[0];const p=pilots.sort((a,b)=>Math.abs(delta(a.x,ship.x))-Math.abs(delta(b.x,ship.x)))[0];if(p&&((totalTime%28)<8||!target))target={...p,y:4.1,rescue:true};if(!target)target={x:trucks[3]?.x||0,y:17};const dx=delta(target.x,ship.x),dy=target.y-ship.y;let x=clamp(dx*.3,-1,1),y=clamp(dy*.5,-1,1);if(!target.rescue&&Math.abs(dx)<19)x=0;const aimDX=target.rescue?ship.face:dx;return {x,y,fire:!target.rescue,flare:entities.filter(e=>e.type==='\"'bullet'&&e.hostile&&dist(e,ship)<10).length>3&&ship.flares>0,rescue:true,boost:Math.abs(dx)>35,aimX:Math.abs(aimDX)<.1?ship.face:Math.sign(aimDX),aimY:target.rescue?0:clamp(dy/Math.max(5,Math.abs(dx)),-.75,.75)}}\nfunction readInput(index=0){const pads=navigator.getGamepads?.()||[];const pad=pads[index];const dead=v=>Math.abs(v||0)>.16?v:0;let x=0,y=0,fire=false,flare=false,rescue=false,boost=false,aimX=0,aimY=0;if(index===0){x=(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0);y=(keys.has('KeyW')||keys.has('ArrowUp')?1:0)-(keys.has('KeyS')||keys.has('ArrowDown')?1:0);fire=keys.has('Space')||keys.has('KeyJ')||mouse.down||settings.autoFire;flare=keys.has('KeyQ');rescue=keys.has('KeyE');boost=keys.has('ShiftLeft')||keys.has('ShiftRight');if(mouse.active&&lastInput==='keyboard'){const ship=ships[index];if(ship){const v=new THREE.Vector3(mouse.x,mouse.y,0).unproject(camera);const dx=v.x-ship.x;aimX=Math.sign(dx)||ship.face;aimY=clamp((v.y-ship.y)/Math.max(3,Math.abs(dx)),-.8,.8)}}if(touch.active){x=clamp((touch.x-touch.baseX)/60,-1,1);y=clamp((touch.baseY-touch.y)/60,-1,1);fire=true;rescue=true;aimX=touch.aimId\"'!==null?touch.aimX:ships[0]?.face||1;aimY=touch.aimId!==null?touch.aimY:0}}\nif(pad){const px=dead(pad.axes[0]),py=-dead(pad.axes[1]);if(px||py){x=px;y=py;inputUsed('\"'gamepad')}const ax=dead(pad.axes[2]),ay=-dead(pad.axes[3]);if(ax||ay){aimX=Math.sign(ax)||ships[index]?.face||1;aimY=clamp(ay/Math.max(.35,Math.abs(ax)),-.8,.8);inputUsed('gamepad')}fire=fire||\"'!!pad.buttons[7]?.pressed||!!pad.buttons[2]?.pressed;flare=flare||!!pad.buttons[1]?.pressed;rescue=rescue||!!pad.buttons[0]?.pressed;boost=boost||!!pad.buttons[6]?.pressed;if(pad.buttons.some(b=>b.pressed))inputUsed('\"'gamepad')}\nreturn{x,y,fire,flare,rescue,boost,aimX,aimY}}\nfunction updateShip(ship,dt,input){if(ship.inactive)return;ship.inv=Math.max(0,ship.inv-dt);ship.cool-=dt;const boosting=input.boost&&ship.boost>.05;ship.boost=clamp(ship.boost+dt*(boosting?-.35:.2),0,1);const speed=tune.speed*(boosting?1.65:1);const len=Math.max(1,Math.hypot(input.x,input.y));ship.vx=THREE.MathUtils.damp(ship.vx,input.x/len*speed,8,dt);ship.vy=THREE.MathUtils.damp(ship.vy,input.y/len*speed,8,dt);ship.x=wrap(ship.x+ship.vx*dt);ship.y=clamp(ship.y+ship.vy*dt,3.2,33);if(Math.abs(input.x)>.1)ship.face=Math.sign(input.x);if(input.aimX){ship.face=Math.sign(input.aimX);ship.aimX=ship.face;ship.aimY=input.aimY||0}else{ship.aimX=ship.face;ship.aimY=0}ship.mesh.rotation.y=ship.face===1?0:Math.PI;ship.mesh.rotation.z=-ship.vx*.008;ship.mesh.visible=ship.inv<=0||Math.floor(ship.inv*12)%2===0;if(input.fire&&ship.cool<=0){const len=Math.hypot(ship.aimX,ship.aimY);bullet(ship,ship.aimX/len*72,ship.aimY/len*72,false,20*tune.power,ship.face*2.8,-.45);ship.cool=.145}if(input.flare&&\"'!ship.flareWas)flare(ship);ship.flareWas=input.flare;\nfor(const p of pilots){if(Math.abs(delta(p.x,ship.x))<3.5&&ship.y<6.3){rescueNear=true;p.clock+=dt;if(input.rescue||p.clock>.85)rescuePilot(p,ship)}}}\nfunction stageComplete(){if(stage>=3)return;if(gameMode==='\"'attract'||testPilot||online.hub){applyUpgrade('gun');return}showScreen('upgrade');audio.sfx('pickup');\"'$('\"'upgradeTitle').textContent=stage===0?'Dust settled.':'Still in one piece.';radio('Next sector ahead. The crew has a present for you.',3)}\nfunction applyUpgrade(type){if(type==='gun')tune.power*=1.3;else{tune.speed*=1.15;for(const s of ships)s.maxHp+=25}upgrades++;for(const s of ships){s.hp=s.maxHp;s.flares=Math.min(5,s.flares+1);s.inv=2}for(const t of trucks)if(t.hp>0)t.hp=Math.min(100,t.hp+30);stage++;stageTime=0;spawnClock=2;for(const e of entities)if(e.type==='bullet'&&e.hostile)removeEntity(e);showScreen('none');if(stage===3)spawnBoss();else{toast('SECTOR 0'+(stage+1),sectorNames[stage]);spawnPilot(wrap(ships[0].x+32));radio(stage===1?'Jets inbound. Watch the radar; they are quick.':'Red Rock pass. The raider aces are waiting.',4)}syncDev()}\nfunction simulate(dt){if(finished||\"'!['\"'play','attract'].includes(gameMode)||screen\"'!=='\"'none'||\"'!online.canPlay)return;dt*=tune.timeScale;totalTime+=dt;stageTime+=dt;attractClock+=dt;comboTime-=dt;rescueNear=false;for(const p of pilots)p.clock=Math.max(0,p.clock-dt*.15);\nfor(let i=0;i<ships.length;i++){const remote=online.connected&&(online.server||i!==online.seat);let input=remote?(remoteInputs[i]||{}):readInput(i);if(gameMode==='\"'attract'||testPilot)input=pilotAI(ships[i]);updateShip(ships[i],dt,{x:0,y:0,...input})}\nfor(let i=0;i<trucks.length;i++){const t=trucks[i];if(t.hp>0){t.x=wrap(t.x+1.3*dt);t.mesh.position.y=.12+Math.sin(totalTime*12+i)*.025;if(random()<dt*4)trail(t.x-2,.5)}}\nspawnClock-=dt;if(stage<3&&spawnClock<=0){spawnClock=(stage===0?3.7:stage===1?3.1:2.8)/tune.spawnRate;if(entities.filter(e=>e.type==='enemy'&&\"'!e.dead).length<13){spawnEnemy(stage===2&&random()>.5?'\"'ace':stage>0&&random()>.45?'jet':'heli');if(stage>0&&random()>.6)spawnEnemy('heli')}}\nfor(const e of [...entities]){if(e.dead)continue;if(e.type==='enemy'){e.age+=dt;e.cool-=dt;const target=trucks.filter(t=>t.hp>0).sort((a,b)=>Math.abs(delta(a.x,e.x))-Math.abs(delta(b.x,e.x)))[0]||ships[0];if(e.kind==='jet'){e.x=wrap(e.x+e.face*(stage===2?19:16)*dt);e.y=e.baseY+Math.sin(e.age*1.5)*1.4;if(Math.abs(delta(target.x,e.x))<8&&e.cool<=0){bullet(e,e.face*2,-22,true,24,0,-1);e.cool=1.5}if(e.age>17)removeEntity(e)}else{const dx=delta(target.x,e.x);e.face=Math.sign(dx)||1;e.x=wrap(e.x+clamp(dx,-7,7)*dt*.7);e.y=clamp(e.baseY+Math.sin(e.age*1.4+e.id)*2.6,10,31);if(e.cool<=0){const dx=delta(target.x,e.x),dy=2-e.y,len=Math.hypot(dx,dy);bullet(e,dx/len*19,dy/len*19,true,e.kind==='ace'?22:16,0,-.8);e.cool=e.kind==='ace'?1.7:2.6}}e.mesh.rotation.y=e.face===1?0:Math.PI;e.mesh.rotation.z=e.kind==='jet'?Math.sin(e.age)*.04:Math.sin(e.age*1.5)*.06;\n}else if(e.type==='boss'){e.age+=dt;e.cool-=dt;const p=ships.find(s=>\"'!s.inactive)||ships[0];const targetX=wrap(p.x+24);e.x=wrap(e.x+clamp(delta(targetX,e.x),-6,6)*dt);e.y=23+Math.sin(e.age*.6)*4;if(e.cool<=0){e.cool=e.hp<e.maxHp*.5?.85:1.5;for(let j=-1;j<=1;j++){const dx=delta(p.x,e.x),dy=p.y-e.y+j*5,len=Math.hypot(dx,dy);bullet(e,dx/len*22,dy/len*22,true,15,-6,-1)}const t=trucks.filter(t=>t.hp>0)[Math.floor(random()*trucks.filter(t=>t.hp>0).length)];if(t)bullet(e,delta(t.x,e.x)*.5,-17,true,20,0,-3)}if(e.age>9&&e.age%14<dt&&entities.filter(e=>e.type==='\"'enemy'&&\"'!e.dead).length<4)spawnEnemy('\"'jet',wrap(e.x+22),29);\n}else if(e.type==='bullet'){e.age+=dt;e.x=wrap(e.x+e.vx*dt);e.y+=e.vy*dt;if(e.age>(e.hostile?6:1.45)||e.y<.3||e.y>38){if(e.hostile&&e.y<.3)burst(e.x,.4,palette.sand,4,.4);removeEntity(e)}}\nif(\"'!e.dead){e.mesh.position.x=e.x;if(e.type!=='\"'truck')e.mesh.position.y=e.y;e.mesh.position.z=e.type==='bullet'?2.5:e.type==='truck'?0:2;e.body.setNextKinematicTranslation({x:e.x,y:e.y+(e.offset||0),z:0});e.mesh.userData.mixer?.update(dt)}}\nphysics.timestep=dt;physics.step(queue);queue.drainCollisionEvents((h1,h2,started)=>{if(\"'!started)return;const a=colliders.get(h1),b=colliders.get(h2);if(!a||!b||a.dead||b.dead)return;const shot=a.type==='\"'bullet'?a:b.type==='bullet'?b:null,target=shot===a?b:a;if(shot){const allowed=shot.hostile?(target.type==='ship'||target.type==='truck'):(target.type==='enemy'||target.type==='boss');if(allowed){damage(target,shot.damage*(shot.hostile?tune.damage:1)/(target.type==='truck'?tune.armor:1),shot.owner);removeEntity(shot)}}else if(a.type==='ship'&&(b.type==='enemy'||b.type==='boss'))damage(a,22*tune.damage);else if(b.type==='ship'&&(a.type==='enemy'||a.type==='boss'))damage(b,22*tune.damage)});entities=entities.filter(e=>\"'!e.dead);for(const [h,e]of colliders)if(e.dead)colliders.delete(h);\nfor(const p of pilots)p.mesh.userData.mixer?.update(dt);updateParticles(dt);if(stage<3&&stageTime>=stageLengths[stage])stageComplete();if(gameMode==='\"'attract'&&(attractClock>210||finished))startGame(true);\"'$('\"'rescueAction').style.display=lastInput==='touch'&&rescueNear?'block':'none'}\nfunction trail(x,y){if(particles.length>350)return;const mesh=new THREE.Mesh(new THREE.BoxGeometry(.4,.3,.1),new THREE.MeshBasicMaterial({color:palette.cream,transparent:true,opacity:.4}));mesh.position.set(x,y,1);scene.add(mesh);particles.push({mesh,vx:-1,vy:.5,life:.8,max:.8,spin:0})}\nfunction updateParticles(dt){for(const p of particles){p.life-=dt;p.mesh.position.x+=p.vx*dt;p.mesh.position.y+=p.vy*dt;p.vy-=dt*8;p.mesh.rotation.z+=p.spin*dt;p.mesh.material.opacity=Math.max(0,p.life/p.max);if(p.life<=0){scene.remove(p.mesh);p.mesh.geometry.dispose();p.mesh.material.dispose()}}particles=particles.filter(p=>p.life>0)}\nfunction endGame(victory,reason=''){if(finished)return;if(gameMode==='attract'){startGame(true);return}finished=true;won=victory;lossReason=reason;gameMode='debrief';score+=victory?trucks.filter(t=>t.hp>0).length*1000+rescues*200:0;if(score>high){high=score;try{localStorage.setItem('palooza-high',high)}catch{}}\"'$('\"'debriefEyebrow').textContent=victory?'PATROL COMPLETE / ROAD CLEAR':'PATROL ENDED / RETRY READY';\"'$('\"'debriefTitle').textContent=victory?'Convoy delivered.':'A rough landing.';\"'$('\"'debriefMessage').textContent=reason;\"'$('\"'debriefStats').innerHTML=\"'`<div class=\"stat\"><b>${String(score).padStart(6,'\"'0')}</b><span>FINAL SCORE</span></div><div class=\\\"stat\\\"><b>\"'${trucks.filter(t=>t.hp>0).length} / 6</b><span>TRUCKS DELIVERED</span></div><div class=\"stat\"><b>${kills}</b><span>HOSTILES DOWN</span></div><div class=\"stat\"><b>${rescues}</b><span>PILOTS RECOVERED</span></div>`;if(!online.hub)showScreen('\"'debrief');audio.sfx(victory?'victory':'loss');if(victory)radio('Road clear\"'! Six wheels down, rotors up. Nice work, Lucky.'\"',6);online.finish(score,victory,{Kills:kills,Rescues:rescues,Convoy:trucks.filter(t=>t.hp>0).length})}\nfunction getSnapshot(){return{v:1,mode:gameMode,screen,stage,stageTime,totalTime,score,kills,rescues,upgrades,won,finished,bossSeen,ships:ships.map(s=>({id:s.id,x:s.x,y:s.y,hp:s.hp,maxHp:s.maxHp,lives:s.lives,flares:s.flares,face:s.face,inv:s.inv,inactive:s.inactive})),trucks:trucks.map(t=>({id:t.id,x:t.x,y:t.y,hp:t.hp})),enemies:entities.filter(e=>e.type==='enemy'||e.type==='boss').map(e=>({id:e.id,x:e.x,y:e.y,hp:e.hp,maxHp:e.maxHp,type:e.type,kind:e.kind,face:e.face})),bullets:entities.filter(e=>e.type==='bullet').slice(-70).map(e=>({id:e.id,x:e.x,y:e.y,vx:e.vx,vy:e.vy,hostile:e.hostile})),pilots:pilots.map(p=>({id:p.id,x:p.x,y:p.y}))}}\nfunction applySnapshot(s){if(online.isHost||\"'!s?.v)return;const was=gameMode;gameMode=s.mode;stage=s.stage;stageTime=s.stageTime;totalTime=s.totalTime;score=s.score;kills=s.kills;rescues=s.rescues;won=s.won;finished=s.finished;bossSeen=s.bossSeen;$('\"'hud').classList.add('visible');if(s.finished&&was\"'!=='\"'debrief'){finished