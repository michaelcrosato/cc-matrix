', label: 'Gentle Mode', type: 'toggle', value: false, group: 'Comfort', help: 'A larger ring and a calmer body', apply: (g, v) => { if (v && G.caption && g.sceneName && !/^(title)$/.test(g.sceneName)) G.caption(G.tareSay('gentle'), 'Tare', 4); } },\")\ns=s.replace(\"G.attach(game);\",\"G.attach(game);\\nconst _pause = game.pause.bind(game); game.pause = function () { if (G.S && !G.inSession) G.S.pauses = (G.S.pauses || 0) + 1; return _pause.apply(null, arguments); };\")\nopen(p,'w').write(s)\np='game/core.js'; s=open(p).read()\ns=s.replace(\"G.loadSlot\",\"G.loadSlot\") \nopen(p,'w').write(s)\np='game/scenes/title.js'; s=open(p).read()\ns=s.replace(\"G.loadSlot = i => { try { G.game.saves.load(i); } catch (e) {} G.S.slot = i; G.noSave = false; };\",\"G.loadSlot = i => { try { G.game.saves.load(i); } catch (e) {} G.S.slot = i; G.noSave = false; const d = G.S.last ? Math.floor((Date.now() - G.S.last) / 86400000) : 0; if (d >= 2) G.S.absence = d; G.S.last = Date.now(); };\")\nopen(p,'w').write(s)\np='game/core.js'; s=open(p).read()\ns=s.replace(\"G.saveNow = () => { if (G.inSession || G.noSave) return; try {\",\"G.saveNow = () => { if (G.inSession || G.noSave) return; G.S.last = Date.now(); try {\")\nopen(p,'w').write(s)\np='game/scenes/island.js'; s=open(p).read()\ns=s.replace(\"if (G.S.pauses > 2 && !this.paused) { }\",\"if (G.S.pauses > 2 && G.S.pauseSaid !== G.S.day && !G.cap) { G.S.pauseSaid = G.S.day; G.caption(G.tareSay('paused', { n: G.S.pauses }), 'Tare', 4.5); }\")\nopen(p,'w').write(s)\np='game/scenes/day.js'; s=open(p).read()\ns=s.replace(\"update(dt) { this.t += dt; G.tick(dt); this.tare.update(dt); this.fig.update(dt); G.gerald.update(dt);\",\"update(dt) { this.t += dt; G.tick(dt); this.tare.update(dt); this.fig.update(dt); G.gerald.update(dt); if (this.t > 6 && !this.tipSaid && this.stage === 'recap' && G.game.settings.tips !== false) { this.tipSaid = true; G.caption(G.line(G.LINES.tare.tips), 'Tare', 5); }\")\ns=s.replace(\"const S = G.S; S.day++; S.do