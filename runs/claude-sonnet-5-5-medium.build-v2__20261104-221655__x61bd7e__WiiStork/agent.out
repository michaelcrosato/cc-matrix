at('left') && this.page > 0) { this.page--; G.snd('tick'); } if (i.pressed('cancel')) { G.snd('back'); G.game.go('title'); }\n    const c = i.clicked && i.clicked(); if (c) { const R = this.rects; const hit = k => R[k] && c[0] >= R[k][0] && c[0] < R[k][0] + R[k][2] && c[1] >= R[k][1] && c[1] < R[k][1] + R[k][3]; if (hit('next') && this.page < this.pages.length - 1) this.page++; else if (hit('prev') && this.page > 0) this.page--; else if (hit('back')) G.game.go('title'); } },\n  draw(r) {\n    G.game.focus(0, 0, 18); G.rooms.reception(r, this.t); const W = r.W, H = r.H, pg = this.pages[this.page];\n    r.overlay(g => {\n      G.rr(g, 14, 8, W - 28, H - 40, 'rgba(255,255,255,.97)'); G.txt(g, 'About / Credits', W / 2, 12, C.MUTED, { align: 'center' }); G.txt(g, pg.title, W / 2, 22, C.ACC2, { align: 'center', scale: 2 });\n      let y = 44; for (const [q, a] of pg.rows) { G.txt(g, q, 28, y, C.ACC2); y += 10; const lines = G.wrap(a, W - 72, 1).slice(0, 4); for (const l of lines) { G.txt(g, l, 28, y, C.INK); y += 9; } y += 6; }\n      this.rects = { prev: [20, H - 28, 50, 14], next: [W - 70, H - 28, 50, 14], back: [W / 2 - 25, H - 28, 50, 14] };\n      G.rr(g, 20, H - 28, 50, 14, this.page > 0 ? C.ACC : '#c8dde2'); G.txt(g, 'Prev', 45, H - 25, '#fff', { align: 'center' }); G.rr(g, W - 70, H - 28, 50, 14, this.page < this.pages.length - 1 ? C.ACC : '#c8dde2'); G.txt(g, 'Next', W - 45, H - 25, '#fff', { align: 'center' }); G.rr(g, W / 2 - 25, H - 28, 50, 14, '#8a8f98'); G.txt(g, 'Back', W / 2, H - 25, '#fff', { align: 'center' }); G.txt(g, (this.page + 1) + ' / ' + this.pages.length, W / 2, H - 38, C.MUTED, { align: 'center' });\n    });\n    G.prompt(r, [['confirm', 'Next'], ['cancel', 'Back']]);\n  }\n};\n})();\nEOF\npython3 - <<'EOF'\np='game/main.js'; s=open(p).read()\ns=s.replace(\"G.start = () => game.start(\",\"G.start = () => { G.wrapDev(G.scenes); return game.start(\").replace(\"steps: G.boot } });\",\"steps: G.boot } }); };\")\ns=s.replace(\"if (!window.__noStart)