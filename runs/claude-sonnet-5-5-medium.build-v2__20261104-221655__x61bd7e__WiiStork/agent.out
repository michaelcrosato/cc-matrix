-mod{zoom:2}}\n.esh button:focus,.esh input:focus{outline:3px solid var(--accent);outline-offset:2px}\n[data-sys=need]{background:rgba(5,3,12,.35)!important;align-items:flex-end!important}`;\n  const boot = (R('engine/game/index.html').match(/<div id=\"e3-boot\"[\\s\\S]*?<\\/div>\\s*(?=<canvas)/) || [''])[0].replace(/ROOFTOP/g, ai.name).replace(/<span>Starting[^<]*<\\/span>/, '<span>Zeroing the scale</span>');\n  const head = `<meta charset=\"utf-8\">\\n<script>${esc(R('vendor/session.js'))}</script>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>${ai.name} — ${ai.tagline}</title>\n<meta name=\"description\" content=\"${ai.description.replace(/\"/g, '&quot;')}\">\n<meta name=\"theme-color\" content=\"#2cc6e6\">\n<meta name=\"hub:type\" content=\"Game\"><meta name=\"hub:players\" content=\"1–4\"><meta name=\"hub:source\" content=\"Wii Fit\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"Stay steadiest over 3 exercises; most points wins\">\n<meta name=\"hub:session-howto\" content=\"Lean: left stick, WASD or mouse. Breathe: R2, Space or click\">\n<style>${css}</style>`;\n  const about = `window.G=window.G||{};G.ABOUT=${JSON.stringify(iv).replace(/</g, '\\\\u003c')};`;\n  const scripts = FILES.map(f => `<script>/* ${f} */\\n${f === 'game/core.js' ? about + '\\n' : ''}${esc(R(f))}</script>`).join('\\n');\n  return `<!doctype html>\\n<html lang=\"en\">\\n<head>\\n${head}\\n</head>\\n<body>\\n${boot}\\n<canvas id=\"screen\"></canvas>\\n${scripts}\\n</body>\\n</html>\\n`;\n}\nif (process.argv[1] && process.argv[1].endsWith('build.mjs')) {\n  const out = process.argv[2] || '../WiiStork-WiiFit-claude-sonnet-5-5-medium-20261104-221655.html';\n  const html = bundle(); writeFileSync(new URL(out, import.meta.url), html); writeFileSync(new URL('tests/hub/game.html', import.meta.url), html);\n  console.log('built', out, (html.length / 1024) | 0, 'KB');\n}\nEOF\ncat > exit-interview.json <<'EOF'\n{\"sourceInformation\":{\"date\":\"2026-11-04 22:16:55\",\"source\":\"Wii Fit\",\"plan\":\"PLAN.md\",\"genre\":\"Sports (exercise minigame collection with a light life-sim routine)\",\"perspective\":\"Per activity: fixed 2.5D brawler camera in the studio, three-quarter island, Mode 7 slalom, pseudo-3D road jog, steep tray view, side view laundry line\",\"tech\":\"my-3D2dge handoff engine v0.89.0 (Canvas 2D, no WebGL), Mocap clips, plain JavaScript scripts on one global, AI Hub session client\",\"artDirection\":\"Engine-native 3D skeleton puppets drawn as crisp pixel art at PS1 resolution, moved into bright daylight; hand-drawn Tare, Gerald, Plate and props\",\"animation\":\"Engine Humanoid rigs with motion-capture clips (Mesh2Motion, CMU) plus hand-posed IK bodies for hoop, step and lunge\",\"audio\":\"All music, sound effects and Animalese-style voices synthesized in code with Web Audio; music at 10% volume by default\",\"online\":\"AI Hub ghost session (1 to 4 players) through the hub client; local Class for 2 to 4 players on one screen\",\"testing\":\"unknown\",\"research\":\"Read the supplied plan, the engine API card and the AI Hub session protocol README; no other research\",\"environment\":\"Claude Code CLI (headless); Linux\",\"model\":\"Anthropic, claude-sonnet-5-5, reasoning effort medium\",\"usage\":\"added on import\"},\"testingFeedback\":[\"unknown\",\"unknown\",\"unknown\",\"unknown\"],\"engineFeedback\":[\"unknown\",\"unknown\",\"unknown\",\"unknown\",\"unknown\",\"unknown\"],\"promptFeedback\":[\"unknown\",\"unknown\",\"unknown\",\"unknown\"],\"aiHub\":{\"name\":\"Wii Stork\",\"tagline\":\"Gently, or not at all\",\"description\":\"A deadpan five-day stay at a wellness retreat where one skill, your balance, drives twelve short exercises, coached by a needy talking scale.\",\"type\":\"Game\",\"