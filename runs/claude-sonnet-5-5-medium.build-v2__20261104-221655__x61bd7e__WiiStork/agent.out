130, 10, 6, '#f6f6f6'); px.rect(g, gx + 8, 112, 3, 16, '#f6f6f6'); px.disc(g, gx + 10, 111, 3, '#f6f6f6'); px.rect(g, gx + 12, 111, 5, 2, '#f5b700'); } }); }\\n    if (run.T.blender) { const p = r.w(-80, -10, 0);\")\ns=s.replace(\"result(run, c) { const s = c.bal.steadiness,\",\"result(run, c) { if (run.T.duel) { run.won = run.won || (!c.out && run.herFlame < c.flame && run.time >= run.dur - .01 && c.flame > .5); const s0 = c.bal.steadiness; return { pct: run.won ? 1 : G.clamp(.5 * s0 + .3 * c.flame, 0, .9), detail: run.won ? 'Her flame went first' : 'The flame stays. The contest does not' }; } const s = c.bal.steadiness,\")\ns=s.replace(\"})();\\n\",\"G.activity(Object.assign({}, G.acts.candle, { id: 'duel', discipline: 'Duel', name: 'The Grand Stillness', room: 'raft', song: 'duel', card: 'A candle duel with Gertrude, on a raft, at dusk. Distractions will arrive. Do not mind them.', tiers: [{ set: 'candle', dur: 90, duel: true }], tier2Name: undefined }));\\n})();\\n\",1) if False else s\nopen(p,'w').write(s)\nEOF\ntail -c 300 game/activities/candle.js"}}}
