tory'); this.pages = [['Wii Stork', 'The Institute for Gentle Improvement', 'Five days. One skill. A scale that wrote you a card.'], ['Source', 'Inspired by Wii Fit', 'Everything here is new: the cast, the island, the jokes.'], ['Engine', 'my-3D2dge v0.89.0', 'Skeletons drawn as pixel art. Dialog, Road, Mode 7, Physics, Rhythm modules.'], ['Motion', 'Mesh2Motion and Quaternius (CC0)', 'CMU Graphics Lab Motion Capture Database'], ['Sound', 'Every note and every Animalese word', 'Written in code. No files. Music at ten percent, on purpose.'], ['Thank you', 'Tare, Gerald, Birch, Alder, Gertrude, Dennis', 'And you. You are the one who came.']]; },\n  update(dt) { this.t += dt; this.pt += dt; this.fig.update(dt); const input = G.game.input; if ((this.pt > 4.5 || input.pressed('confirm') || (input.clicked && input.clicked())) && this.pt > .6) { this.page++; this.pt = 0; if (this.page >= this.pages.length) { G.game.go(this.back || (G.S.free ? 'island' : 'title'), { from: 'bungalow' }); } } },\n  draw(r) { G.game.focus(0, 0, 18); G.rooms.deck(r, this.t); const W = r.W, pg = this.pages[Math.min(this.page, this.pages.length - 1)]; this.fig.draw(r); r.overlay(g => { const a = G.clamp(Math.min(this.pt * 2, (4.5 - this.pt) * 2), 0, 1); px.blend(g, a, 'normal', () => { G.rr(g, W / 2 - 150, 20, 300, 62, 'rgba(255,255,255,.96)'); G.txt(g, pg[0], W / 2, 26, C.ACC2, { align: 'center', scale: 3 }); G.txt(g, pg[1], W / 2, 52, C.INK, { align: 'center' }); G.txt(g, pg[2], W / 2, 64, C.MUTED, { align: 'center' }); }); }); G.prompt(r, [['confirm', 'Next']]); }\n};\n})();\nEOF\nsed -i \"s#'game/scenes/session.js', 'game/scenes/title.js'#'game/scenes/session.js', 'game/scenes/title.js'#\" build.mjs; node build.mjs | tail -1; cat > tests/t3.mjs <<'EOF'\nimport { loadGame } from './lib.mjs';\nconst { G, game } = loadGame(); const errs = () => game.errors.map(e => e.where + ': ' + e.message).slice(0, 3);\nconst S = G.S; S.started = true; S.arrived = true; S.inst = 'birch'; S.spine = [71]; S.day