r: 1, mode: 'free' }); game.advance(.5);\nconsole.log('scene', game.sceneName, game.errors.map(e => e.where + ': ' + e.message));\nfor (const sk of ['passive', 'poor', 'average', 'good', 'expert']) {\n  game.go('act_stork', { tier: 1, mode: 'free', seed: 3 }); game.advance(.3);\n  // skip card, demo\n  game.input.tap('confirm'); game.advance(.1); game.input.tap('confirm'); game.advance(.1);\n  const run = G.curRun; if (sk !== 'passive') run.cs[0].bot = new G.Bot(sk, G.E.rng(4));\n  game.advance(3.2);\n  let n = 0; while (!run.done && n++ < 100) game.advance(1);\n  const c = run.cs[0]; console.log(sk, 'pct', run.cs[0].pct.toFixed(2), 'steady', c.bal.steadiness.toFixed(2), 'falls', c.bal.falls, 'stars', G.starsOf(c.pct, run.def, 1), game.sceneName);\n}\nconsole.log(game.errors.map(e => e.where + ': ' + e.message).slice(0, 5));\nEOF\nnode tests/t1.mjs 2>&1 | head -30"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2079,"cache_read_input_tokens":202513,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2079},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1eb76a49-6bce-4550-b1b7-5878361cc243","uuid":"d6c130be-392a-4f06-bafe-a6dfd67373cc","timestamp":"2026-11-05T05:27:13.485Z","request_id":"req_011CgjE8fzzCxbnA4Zq8hqnm","wire_tool_inputs":{"toolu_01EbhHtgG4wAJzHbnDDQ5Xsj":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-sonnet-5-5-medium.build-v2__20261104-221655__x61bd7e/work/WiiStork*/ && cat > tests/lib.mjs <<'EOF'\nimport vm from 'node:vm'; import { readFileSync, existsSync } from 'node:fs';\nimport { FILES } from '../build.mjs';\nconst R = f => readFileSync(new URL('../' + f, import.meta.url), 'utf8');\nexport function loadGame(o) {\n  o = o || {};\n  const store = {};\n  