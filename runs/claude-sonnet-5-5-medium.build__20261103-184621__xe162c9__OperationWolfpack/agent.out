d features** (below): the pause menu, settings, key rebinding, full screen and pausing on focus loss come with every game. Adjust them with `new E.Game({ menu: {...} })`.\n97:  menu: {\n117:- Saves: `game.saves` (three slots and an autosave with their place, level and time played; versioned; `menu: { saves: true }` for the pause menu's Save and Load and the standard screen, which asks before a save is lost), written at checkpoints and save points (not on page close).\n659:- No pause menu, settings screen, key rebinding or full-screen code of your own: they're standard. Your settings, names and menu items go in `new E.Game({ menu: {...} })`; prompts come from `game.input.label(action)`.\n3020:class Settings {\n3021-  /**\n3022-   * game.settings: the player's choices, one property each (game.settings.volume), with the game's own (o.menu.settings)\n3023-   * beside the standard ones (STANDARD_SETTINGS). Saved with E.store under 'settings:' + the game's id, with a version;\n3024-   * on load every value is checked and a bad one falls back to its default. Where storage is blocked the game plays on\n3025-   * with the defaults (saved: false)\n3026-   */\n3027-  constructor(game, own = []) {\n3028-    const hide = (k, v) => Object.defineProperty(this, k, { value: v, writable: true });\n3029-    hide('_g', game); hide('_specs', {}); hide('_saved', {}); hide('_key', 'settings:' + (game.o.id || (typeof location !== 'undefined' && location.pathname) || 'game'));\n3030-    hide('saved', true);\n3031-    /** onChange(key, value): called after every change (E.Shell's settings.onChange goes through it) */\n3032-    hide('onChange', null);\n3033-    const raw = store.get(this._key, null);\n3034-    hide('_raw', raw && typeof raw === 'object' && raw.values && typeof raw.values === 'object' ? raw.values : {});   // (a newer version's values are checked like the rest)\n3035-    if (!(raw && raw.v >= 2) && this._raw.fullscreen === false) delete this._raw.fullscreen;\n3036-    game.input._settings = this; game.input._onBindings = b => this.set('bindings', b);\n3037-    for (const k in STANDARD_SETTINGS) this.define(Object.assign({ key: k }, STANDARD_SETTINGS[k]));\n3038-    for (const sp of own) this.define(sp);\n3039-  }\n3040-  /** add a setting: { key, label, type: 'toggle' | 'slider' | 'select', value, min, max, step, options: [[value,\n3041-   *  label]] or [value], help, group: 'Game', apply(game, value) }. Its saved value is loaded (when it is a valid one) and\n3042-   *  applied; it shows on the settings screen. Returns its value */\n3043-  define(sp) {\n3044-    if (!sp || !sp.key || typeof sp.key !== 'string') { warn('setting', 'a setting needs a key: { key: \"hints\", label: \"Hints\", value: true }'); return undefined; }\n3045-    if (sp.key in Settings.prototype || sp.key === 'saved' || sp.key === 'onChange' || sp.key[0] === '_') { warn('setting:' + sp.key, 'a setting cannot be called \"' + sp.key + '\" (a name the sett\n3046-    const s = Object.assign({ group: 'Game', type: sp.options ? 'select' : typeof sp.value === 'number' ? 'slider' : typeof sp.value === 'boolean' || sp.value === undefined ? 'toggle' : 'value' }\n3047-    this._specs[s.key] = s;\n3048-    const saved = settingValue(s, this._raw[s.key]);\n3049-    if (saved !== undefined) this._saved[s.key] = saved;\n3050-    this[s.key] = saved !== undefined ? saved : this.default(s.key);\n3051-    this._apply(s.key);\n3052-    return this[s.key];\n3053-  }\n3054-  /** a setting's default value */\n3055-  default(key) { const s = this._specs[key]; if (!s) return undefined; const v = typeof s.value === 'function' ? s.value(this._g) : s.value; return v === undefined && s.type === 'toggle' ? false \n3056-  /** the spec a setting was defined with (its label, type, range, options), or undefined */\n3057-  spec(key) { return this._specs[key]; }\n3058-  /** the keys of a group's settings, in order ('Display', 'Sound', 'Comfort', 'Controller', 'Touch', 'Game'), or every key */\n3059-  