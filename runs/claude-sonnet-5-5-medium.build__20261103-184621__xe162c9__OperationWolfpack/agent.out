'cutscene','ending','scores','dev','attract']\nims=[Image.open(f's-{n}.png').crop((0,0,960,540)).resize((480,270)) for n in names]\ncols=3; rows=(len(ims)+cols-1)//cols\nsheet=Image.new('RGB',(480*cols,270*rows))\nfor i,im in enumerate(ims): sheet.paste(im,((i%cols)*480,(i//cols)*270))\nsheet.save('sheet.png'); print(sheet.size)\nEOF"}}}
