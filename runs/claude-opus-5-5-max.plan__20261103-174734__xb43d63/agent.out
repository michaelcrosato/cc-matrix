1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.","stderr":"\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174734__xb43d63/work","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016mZGDk9a6KYCM3X615FyZb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
