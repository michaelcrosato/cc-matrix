e) {\n206\t      warn('could not reach the hub: ' + e.message);\n207\t    }\n208\t  }\n209\t\n210\t  function emit(type, args) {\n211\t    var list = handlers[type];\n212\t    if (!list || !list.length || pending[type]) {\n213\t      (pending[type] = pending[type] || []).push(args);\n214\t      return;\n215\t    }\n216\t    for (var i = 0; i < list.length; i++) {\n217\t      try {\n218\t        list[i].apply(null, args);\n219\t      } catch (e) {\n220\t        setTimeout(function () {\n221\t          throw e;\n222\t        });\n223\t      }\n224\t    }\n225\t  }\n226\t\n227\t  function onMessage(event) {\n228\t    if (event.source !== root.parent) return;\n229\t    var m = event.data;\n230\t    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n231\t    if (m.type === 'welcome') {\n232\t      if (welcomed) return;\n233\t      welcomed = true;\n234\t      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n235\t      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n236\t      for (var key in m) {\n237\t        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n238\t        hub[key] = m[key];\n239\t      }\n240\t      hub.players = (m.players || []).slice();\n241\t      hub.seed = m.seed >>> 0;\n242\t      hub.isHost = m.me === m.host;\n243\t      hub.splash = m.splash === true;\n244\t      if (m.limits) {\n245\t        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n246\t        tokens = limits.burst;\n247\t      }\n248\t      if (connecting) connecting.resolve(info());\n249\t      return;\n250\t    }\n251\t    if (m.type === 'fullscreen') {\n252\t      fullscreenOn = m.on === true;\n253\t      try {\n254\t        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n255\t      } catch (e) {}\n256\t      return;\n257\t    }\n258\t    if (!welcomed || ended) return;\n259\t    if (m.type === 'start') {\n260\t      goAt = now() + Number(m.in || 0);\n261\t      emit('start', [{ in: Number(m.in || 0) }]);\n262\t    } else if (m.type === 'message') {\n263\t      emit('message', [m.data, m.from]);\n264\t    } else if (m.type === 'leave') {\n265\t      hub.players = hub.players.filter(function (p) {\n266\t        return p.id !== m.id;\n267\t      });\n268\t      emit('leave', [{ id: m.id, reason: m.reason }]);\n269\t    } else if (m.type === 'time-up') {\n270\t      emit('time-up', [{ graceMs: m.graceMs }]);\n271\t    } else if (m.type === 'end') {\n272\t      ended = true;\n273\t      if (progressTimer) clearTimeout(progressTimer);\n274\t      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n275\t    } else {\n276\t      // An event this client has never heard of: hand it on as it came.\n277\t      var detail = {};\n278\t      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n279\t      emit(m.type, [detail]);\n280\t    }\n281\t  }\n282\t\n283\t  function info() {\n284\t    var out = {};\n285\t    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n286\t    out.players = hub.players.slice();\n287\t    return out;\n288\t  }\n289\t\n290\t  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n291\t  hub.connect = function (opts) {\n292\t    if (connecting) return connecting.promise;\n293\t    var done;\n294\t    var promise = new Promise(function (resolve) {\n295\t      done = resolve;\n296\t    });\n297\t    connecting = { promise: promise, resolve: done };\n298\t    if (!hub.active) {\n299\t      done(null);\n300\t      return promise;\n301\t    }\n302\t    opts = opts || {};\n303\t    root.addEventListener('message', onMessage);\n304\t    var started = now();\n305\t    var hello = function () {\n306\t      if (welcomed) return;\n307\t      if (now() - started > HELLO_TIMEOUT_MS) {\n308\t        standAlone();\n309\t        warn('no hub answered; playing normally');\n310\t        done(null);\n311\t        return;\n312\t      }\n313\t      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n314\t      setTimeout(hello, HELLO_EVERY_MS);\n315\t    };\n316\t    hello();\n317\t    return promise;\n318\t  };\n319\t\n320\t  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n321\t  hub.ready = function () {\n322\t    if (!welcomed || sentReady || ended) return;\n323\t    sentReady = true;\n324\t    post('ready', {});\n325\t  };\n326\t\n327\t  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n328\t  hub.answer = function (what) {\n329\t    if (!welcomed || ended || goAt !== null) return;\n330\t    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n331\t    post('answer', { answer: what });\n332\t  };\n333\t\n334\t  hub.on = function (type, fn) {\n335\t    (handlers[type] = handlers[type] || []).push(fn);\n336\t    if (pending[type] && !pending[type].flushing) {\n337\t      pending[type].flushing = true;\n338\t      setTimeout(function () {\n339\t        var queued = pending[type];\n340\t        delete pending[type];\n341\t        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n342\t      });\n343\t    }\n344\t    return function () {\n345\t      var list = handlers[type] || [];\n346\t      var at = list.indexOf(fn);\n347\t      if (at !== -1) list.splice(at, 1);\n348\t    };\n349\t  };\n350\t\n351\t  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n352\t  hub.send = function (data, opts) {\n353\t    if (!welcomed || ended) return false;\n354\t    opts = opts || {};\n355\t    var text;\n356\t    try {\n357\t      text = JSON.stringify(data);\n358\t    } catch (e) {\n359\t      warn('send: data is not JSON');\n360\t      return false;\n361\t    }\n362\t    if (text === undefined) return false;\n363\t    if (text.length > limits.maxBytes) {\n364\t      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n365\t      return false;\n366\t    }\n367\t    var t = now();\n368\t    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n369\t    refilled = t;\n370\t    if (tokens < 1) {\n371\t      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n372\t      return false;\n373\t    }\n374\t    tokens -= 1;\n375\t    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n376\t    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n377\t    post('send', fields);\n378\t    return true;\n379\t  };\n380\t\n381\t  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n382\t  hub.time = function () {\n383\t    return goAt === null ? -Infinity : now() - goAt;\n384\t  };\n385\t\n386\t  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n387\t  hub.rng = function (label) {\n388\t    var h = 2166136261;\n389\t    var s = String(label === undefined ? '' : label);\n390\t    for (var i = 0; i < s.length; i++) {\n391\t      h ^= s.charCodeAt(i);\n392\t      h = Math.imul(h, 16777619);\n393\t    }\n394\t    return generator((hub.seed ^ h) >>> 0);\n395\t  };\n396\t\n397\t  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n398\t  function finite(v) {\n399\t    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n400\t  }\n401\t\n402\t  /**\n403\t   * The whole outcome as plain JSON, field by field: the hub checks and trims\n404\t   * it, so new optional fields need no new client. A field that is not JSON\n405\t   * (a cycle, a BigInt) is left out,