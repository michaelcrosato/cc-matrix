{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WJLgMa3kvrzPVqLvknGiVP","type":"tool_result","content":"1\t/**\n2\t * round.js — one round of an AI Hub session, run by the hub that coordinates\n3\t * it (the harness page, or the session host's tab).\n4\t *\n5\t * It never touches the network or a frame itself: every message for a game\n6\t * goes out through `deliver(key, msg)`, and everything the games report comes\n7\t * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\n8\t * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\n9\t * without waiting for one.\n10\t *\n11\t * Players are known by `key` (whatever the session calls them); games see\n12\t * contiguous ids 0..N-1 in slot order.\n13\t */\n14\t\n15\texport const TIMINGS = Object.freeze({\n16\t  helloMs: 10_000,\n17\t  readyMs: 45_000,\n18\t  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n19\t  loadGraceMs: 20_000,\n20\t  countdownMs: 3_000,\n21\t  graceMs: 5_000,\n22\t  hiddenMs: 20_000,\n23\t  maxRoundMs: 15 * 60_000,\n24\t});\n25\t\n26\t/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\n27\texport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n28\t\n29\texport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n30\t\n31\t/** Each mode's name on screen. */\n32\texport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n33\t\n34\t/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\n35\tconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n36\t\n37\t/** The mode a tag or a hello names, older tags included; null for anything else. */\n38\texport function modeOf(word) {\n39\t  const w = String(word ?? '').trim().toLowerCase();\n40\t  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\n41\t}\n42\t\n43\t/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\n44\texport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n45\t\n46\t/**\n47\t * Whether a game's round carries the seed in its address, so the client seeds\n48\t * Math.random and every copy starts the same: read from the game's own tag,\n49\t * parallel or ghost. A game still tagged race was built for an unseeded start\n50\t * (ids it makes from Math.random must differ between its copies), so it keeps one.\n51\t */\n52\texport const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n53\t\n54\tconst REAL_CLOCK = {\n55\t  now: () => Date.now(),\n56\t  setTimeout: (fn, ms) => setTimeout(fn, ms),\n57\t  clearTimeout: (handle) => clearTimeout(handle),\n58\t};\n59\t\n60\t/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\n61\texport function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n62\t  const typical = Number(minutes);\n63\t  if (!(typical > 0)) return maxRoundMs;\n64\t  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\n65\t}\n66\t\n67\t/**\n68\t * Parallel and ghost order: finishers by time, then the rest by score,\n69\t * then anyone who reported nothing, tied last. Equal times or scores share a\n70\t * place.\n71\t */\n72\texport function rankResults(results, ids) {\n73\t  const timed = [];\n74\t  const scored = [];\n75\t  const silent = [];\n76\t  for (const id of ids) {\n77\t    const r = results.get(id);\n78\t    if (r && Number.isFinite(r.time)) timed.push([id, r.time]);\n79\t    else if (r && Number.isFinite(r.score)) scored.push([id, r.score]);\n80\t    else silent.push(id);\n81\t  }\n82\t  const groups = (list, order) => {\n83\t    list.sort((a, b) => order * (a[1] - b[1]) || a[0] - b[0]);\n84\t    const out = [];\n85\t    for (const [id, value] of list) {\n86\t      const last = out[out.length - 1];\n87\t      if (last && last.value === value) last.ids.push(id);\n88\t      else out.push({ value, ids: [id] });\n89\t    }\n90\t    return out.map((g) => g.ids);\n91\t  };\n92\t  return [...groups(timed, 1), ...groups(scored, -1), ...(silent.length ? [silent] : [])];\n93\t}\n94\t\n95\t/** A time or score as a number: finite, given as a number or as text; NaN for null, '' or true, which Number() would make 0. */\n96\tconst asNumber = (v) => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '') ? Number(v) : NaN);\n97\t\n98\t/** The protocol's limits on a round's highlights (README §10). */\n99\texport const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\n100\t\n101\t/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\n102\texport function cleanStats(stats) {\n103\t  if (!stats || typeof stats !== 'object' || Array.isArray(stats)) return null;\n104\t  const out = {};\n105\t  for (const [name, value] of Object.entries(stats).slice(0, HIGHLIGHTS.stats)) {\n106\t    const label = String(name).trim().slice(0, HIGHLIGHTS.statName);\n107\t    if (!label) continue;\n108\t    if (typeof value === 'number' && Number.isFinite(value)) out[label] = value;\n109\t    else if (typeof value === 'string' && value.trim()) out[label] = value.trim().slice(0, HIGHLIGHTS.statText);\n110\t  }\n111\t  return Object.keys(out).length ? out : null;\n112\t}\n113\t\n114\t/**\n115\t * Awards, trimmed: `{ id, title, detail? }`, at most three a player, for\n116\t * players of this round. A result's awards are about its own player: `self` is its id.\n117\t */\n118\texport function cleanAwards(awards, ids, self = null) {\n119\t  if (!Array.isArray(awards)) return [];\n120\t  const given = new Map();\n121\t  const out = [];\n122\t  for (const a of awards) {\n123\t    const id = self ?? a?.id;\n124\t    const title = String(a?.title ?? '').trim().slice(0, HIGHLIGHTS.title);\n125\t    if (!title || !ids.includes(id) || (given.get(id) || 0) >= HIGHLIGHTS.awards) continue;\n126\t    given.set(id, (given.get(id) || 0) + 1);\n127\t    const detail = String(a.detail ?? '').trim().slice(0, HIGHLIGHTS.detail);\n128\t    out.push(detail ? { id, title, detail } : { id, title });\n129\t  }\n130\t  return out;\n131\t}\n132\t\n133\t/**\n134\t * Check a host's standings: groups of ids, best first, every present player\n135\t * exactly once. Players already gone may be placed or left out; whoever is\n136\t * left out lands in a last group of their own.\n137\t */\n138\texport function checkStandings(standings, presentIds, allIds) {\n139\t  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\n140\t  const all = new Set(allIds);\n141\t  const seen = new Set();\n142\t  const groups = [];\n143\t  for (const group of standings) {\n144\t    const ids = Array.isArray(group) ? group : [group];\n145\t    const kept = [];\n146\t    for (const id of ids) {\n147\t      if (!Number.isInteger(id) || !all.has(id)) return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\n148\t      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\n149\t      seen.add(id);\n150\t      kept.push(id);\n151\t    }\n152\t    if (kept.length) groups.push(kept);\n153\t  }\n154\t  const missing = presentIds.filter((id) => !seen.has(id));\n155\t  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\n156\t  const absent = allIds.filter((id) => !seen.has(id));\n157\t  if (absent.length) groups.push(absent);\n158\t  return { ok: true, standings: groups };\n159\t}\n160\t\n161\t/**\n162\t * @param {object} o\n163\t * @param {number} o.round            round number, carried on every message\n164\t * @param {{key:string, slot:number, name:string}[]} o.players\n165\t * @param {string} o.hostKey          whose game runs a shared world\n166\t * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\n167\t *                                    instead (a server): one more copy after the players, welcomed\n168\t *                                    with server: true, never ranked; the round is void if it goes\n169\t * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\n170\t * @param {number} o.seed\n171\t * @param {number} o.limitMs\n172\t * @param {{now:()=>number, setTimeout:Function, clearTimeout:Function}} [o.clock]\n173\t * @param {(key:string, msg:object) => void} o.deliver\n174\t * @param {(status:object) => void} [o.onStatus]\n175\t * @param {(record:object) => void} [o.onEnd]\n176\t * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\n177\t *                                    games ready up once loaded, and the round starts on release()\n178\t */\n179\texport function createRound({\n180\t  round,\n181\t  players,\n182\t  hostKey,\n183\t  mode = null,\n184\t  seed,\n185\t  limitMs,\n186\t  clock = REAL_CLOCK,\n187\t  deliver,\n188\t  onStatus = () => {},\n189\t  onEnd = () => {},\n190\t  timings = TIMINGS,\n191\t  gate = false,\n192\t  serverKey = null,\n193\t}) {\n194\t  mode = modeOf(mode);\n195\t  const t = { ...TIMINGS, ...timings };\n196\t  const seats = [...players]\n197\t    .sort((a, b) => a.slot - b.slot)\n198\t    .map((p, id) => ({\n199\t      id,\n200\t      key: p.key,\n201\t      slot: p.slot,\n202\t      name: p.name,\n203\t      color: SLOT_COLORS[p.slot % SLOT_COLORS.length],\n204\t      hello: false,\n205\t      ready: false,\n206\t      out: null,\n207\t      result: null,\n208\t      /** The last progress score the hub saw: the result of a player who never reports one. */\n209\t      progress: null,\n210\t      stats: null,\n211\t      awards: [],\n212\t      caps: null,\n213\t      hidden: null,\n214\t    }));\n215\t  const server = serverKey\n216\t    ? { id: seats.length, key: serverKey, slot: null, name: 'Server', color: null, hello: false, ready: false, out: null, result: null, progress: null, stats: null, awards: [], caps: null, hidden: null }\n217\t    : null;\n218\t  /** Every copy in the round: the players, then the server when there is one. */\n219\t  const copies = server ? [...seats, server] : seats;\n220\t  const byKey = new Map(copies.map((s) => [s.key, s]));\n221\t  const ids = seats.map((s) => s.id);\n222\t  const host = server ?? byKey.get(hostKey) ?? seats[0];\n223\t  const timers = new Set();\n224\t  const issues = [];\n225\t  let phase = 'loading';\n226\t  let goAt = null;\n227\t  let record = null;\n228\t  let released = !gate;\n229\t\n230\t  const later = (ms, fn) => {\n231\t    const handle = clock.setTimeout(() => {\n232\t      timers.delete(handle);\n233\t      fn();\n234\t    }, Math.max(0, ms));\n235\t    timers.add(handle);\n236\t    return handle;\n237\t  };\n238\t  const cancel = (handle) => {\n239\t    if (handle == null) return;\n240\t    clock.clearTimeout(handle);\n241\t    timers.delete(handle);\n242\t  };\n243\t\n244\t  /** The players still in the round. */\n245\t  const present = () => seats.filter((s) => !s.out);\n246\t  /** The copies still in the round: the players, and the server. */\n247\t  const presentCopies = () => copies.filter((s) => !s.out);\n248\t  const selfReported = () => SELF_REPORTED.includes(mode);\n249\t  const needsHost = () => !selfReported();\n250\t  const send = (seat, msg) => deliver(seat.key, { round, ...msg });\n251\t  const toPresent = (msg, except = null) => {\n252\t    for (const s of presentCopies()) if (s !== except && s.hello) send(s, msg);\n253\t  };\n254\t  const issue = (seat, problem) => {\n255\t    issues.push({ key: seat?.key ?? null, id: seat?.id ?? null, problem });\n256\t    status();\n257\t  };\n258\t\n259\t  function status() {\n260\t    onStatus({\n261\t      round,\n262\t      phase,\n263\t      mode,\n264\t      host: host.id,\n265\t      goAt,\n266\t      gate,\n267\t      released,\n268\t      players: seats.map((s) => ({\n269\t        id: s.id,\n270\t        key: s.key,\n271\t        slot: s.slot,\n272\t        name: s.name,\n273\t        color: s.color,\n274\t        hello: s.hello,\n275\t        ready: s.ready,\n276\t        out: s.out,\n277\t        result: s.result,\n278\t        client: s.caps?.client ?? null,\n279\t      })),\n280\t      server: server && { id: server.id, key: server.key, hello: server.hello, ready: server.ready, out: server.out, client: server.caps?.client ?? null },\n281\t      issues: issues.slice(),\n282\t    });\n283\t  }\n284\t\n285\t  function welcome(seat) {\n286\t    send(seat, {\n287\t      type: 'welcome',\n288\t      me: seat.id,\n289\t      host: host.id,\n290\t      players: seats.map((s) => ({ id: s.id, name: s.name, color: s.color })),\n291\t      keys: copies.map((s) => s.key),\n292\t      mode,\n293\t      seed: seed >>> 0,\n294\t      limitMs,\n295\t      ...(gate ? { splash: true } : {}),\n296\t      ...(seat === server ? { server: true } : {}),\n297\t    });\n298\t    for (const s of seats) if (s.out) send(seat, { type: 'leave', id: s.id, reason: s.out });\n299\t  }\n300\t\n301\t  function markOut(seat, reason) {\n302\t    if (seat.out || phase === 'ended') return;\n303\t    seat.out = reason;\n304\t    cancel(seat.hidden);\n305\t    seat.hidden = null;\n306\t    toPresent({ type: 'leave', id: seat.id, reason });\n307\t    // A player who sat out is still at the hub: tell their game it is over for them.\n308\t    if (reason === 'not-ready' && seat.hello) send(seat, { type: 'end', reason: 'sat-out' });\n309\t  }\n310\t\n311\t  function settle() {\n312\t    if (phase === 'ended') return;\n313\t    const left = present();\n314\t    if (!left.length) return finishVoid('no-players');\n315\t    if (needsHost() && host.out) {\n316\t      return finishVoid(host.out === 'not-ready' ? 'host-not-ready' : 'host-left', phase === 'loading' ? 'void' : 'host-left');\n317\t    }\n318\t    if (phase === 'loading') {\n319\t      if (released && presentCopies().every((s) => s.ready)) begin();\n320\t      return;\n321\t    }\n322\t    if (selfReported() && left.every((s) => s.result)) finishResults();\n323\t  }\n324\t\n325\t  function begin() {\n326\t    phase = 'countdown';\n327\t    goAt = clock.now() + t.countdownMs;\n328\t    toPresent({ type: 'start', at: goAt });\n329\t    later(t.countdownMs, () => {\n330\t      if (phase === 'countdown') {\n331\t        phase = 'playing';\n332\t        status();\n333\t      }\n334\t    });\n335\t    later(t.countdownMs + limitMs, timeUp);\n336\t    status();\n337\t  }\n338\t\n339\t  function timeUp() {\n340\t    if (phase === 'ended' || phase === 'grace') return;\n341\t    phase = 'grace';\n342\t    toPresent({ type: 'time-up', graceMs: t.graceMs });\n343\t    later(t.graceMs, () => {\n344\t      if (phase === 'ended') return;\n345\t      if (selfReported()) finishResults();\n346\t      else finishVoid('no-result');\n347\t    });\n348\t    status();\n349\t  }\n350\t\n351\t  function finishResults() {\n352\t    // A player still here who never reported is ranked by the last progress the hub saw from them.\n353\t    const results = new Map(\n354\t      seats.filter((s) => s.result || (!s.out && Number.isFinite(s.progress))).map((s) => [s.id, s.result ?? { score: s.progress, fallback: true }])\n355\t    );\n356\t    // Whoever reported and then left keeps their place: only those who left with nothing count as beaten.\n357\t    const ranked = rankResults(results, seats.filter((s) => !s.out || s.result).map((s) => s.id));\n358\t    const gone = seats.filter((s) => s.out && !s.result).map((s) => s.id);\n359\t    const scores = {};\n360\t    for (const [id, r] of results) scores[id] = Number.isFinite(r.time) ? r.time : r.score;\n361\t    const stats = Object.fromEntries(seats.filter((s) => s.stats).map((s) => [s.id, s.stats]));\n362\t    const awards = seats.flatMap((s) => s.awards);\n363\t    finishPlayed(gone.length ? [...ranked, gone] : ranked, { scores, results: Object.fromEntries(results), stats, awards });\n364\t  }\n365\t\n366\t  function finishPlayed(standings, extra = {}) {\n367\t    end({ status: 'played', reason: 'finished', endReason: 'finished', standings, ...extra });\n368\t  }\n369\t\n370\t  function finishVoid(reason, endReason = 'void') {\n371\t    end({ status: 'void', reason, endReason, standings: null });\n372\t  }\n373\t\n374\t  function end(outcome) {\n375\t    if (phase === 'ended') return;\n376\t    phase = 'ended';\n377\t    for (const handle of timers) clock.clearTimeout(handle);\n378\t    timers.clear();\n379\t    const msg = { type: 'end', reason: outcome.endReason };\n380\t    if (outcome.standings) msg.standings = outcome.standings;\n381\t    toPresent(msg);\n382\t    record = {\n383\t      round,\n384\t      mode,\n385\t      hostId: host.id,\n386\t      ...outcome,\n387\t      players: seats.map((s) => ({ id: s.id, key: s.key, slot: s.slot, name: s.name, color: s.color, out: s.out })),\n388\t      issues: issues.slice(),\n389\t    };\n390\t    status();\n391\t    onEnd(record);\n392\t  }\n393\t\n394\t  function receive(key, msg) {\n395\t    const seat = byKey.get(key);\n396\t    if (!seat || !msg || typeof msg.type !== 'string' || phase === 'ended' || seat.out) return;\n397\t    switch (msg.type) {\n398\t      case 'hello': {\n399\t        if (seat.hello) return;\n400\t        seat.hello = true;\n401\t        seat.caps = { v: msg.v, client: msg.client, mode: msg.mode ?? null, seats: msg.seats ?? null, card: msg.card === true };\n402\t        if (msg.v !== 1) issue(seat, `hello speaks protocol ${JSON.stringify(msg.v)}, not 1`);\n403\t        const said = modeOf(msg.mode);\n404\t        if (!mode && said) mode = said;\n405\t        else if (msg.mode && said !== mode) issue(seat, `hello says mode ${msg.mode}, the round is ${mode}`);\n406\t        welcome(seat);\n407\t        status();\n408\t        return;\n409\t      }\n410\t      case 'ready':\n411\t        if (!seat.hello || seat.ready || phase !== 'loading') return;\n412\t        seat.ready = true;\n413\t        status();\n414\t        return settle();\n415\t      case 'result': {\n416\t        if (!selfReported()) return issue(seat, `result is for parallel and ghost; this round is ${mode}`);\n417\t        if (phase === 'loading') return issue(seat, 'result before start');\n418\t        if (seat.result) return;\n419\t        const time = asNumber(msg.time);\n420\t        const score = asNumber(msg.score);\n421\t        if (Number.isFinite(time)) seat.result = { time };\n422\t        else if (Number.isFinite(score)) seat.result = { score };\n423\t        else return issue(seat, 'result needs a finite time or score');\n424\t        seat.stats = cleanStats(msg.stats);\n425\t        seat.awards = cleanAwards(msg.awards, ids, seat.id);\n426\t        status();\n427\t        return settle();\n428\t      }\n429\t      case 'finish': {\n430\t        if (selfReported()) return issue(seat, `finish is for a shared world; ${mode} games report result`);\n431\t        if (seat !== host) return issue(seat, 'finish from a player who is not the host');\n432\t        if (phase === 'loading') return issue(seat, 'finish before start');\n433\t        const checked = checkStandings(msg.standings, present().map((s) => s.id), ids);\n434\t        if (!checked.ok) return issue(seat, `finish ignored: ${checked.problem}`);\n435\t        const scores = msg.scores && typeof msg.scores === 'object' ? msg.scores : undefined;\n436\t        const given = msg.stats && typeof msg.stats === 'object' ? msg.stats : {};\n437\t        const stats = Object.fromEntries(ids.map((id) => [id, cleanStats(given[id])]).filter(([, v]) => v));\n438\t        const awards = cleanAwards(msg.awards, ids);\n439\t        // won makes it a team result; a game tagged co-op that leaves it out lost, as co-op always read it.\n440\t        const won = typeof msg.won === 'boolean' ? msg.won : seat.caps?.mode === 'co-op' ? false : undefined;\n441\t        return finishPlayed(checked.standings, { scores, won, stats, awards });\n442\t      }\n443\t      case 'error':\n444\t        issue(seat, `game error: ${String(msg.message || '').slice(0, 200)}`);\n445\t        if (msg.fatal) {\n446\t          if (needsHost() && seat === host) return finishVoid('host-error');\n447\t          markOut(seat, 'disconnected');\n448\t          status();\n449\t          settle();\n450\t        }\n451\t        return;\n452\t      case 'vis':\n453\t        if (seat !== host || !needsHost()) return;\n454\t        if (msg.hidden && seat.hidden == null && phase !== 'loading') {\n455\t          seat.hidden = later(t.hiddenMs, () => finishVoid('host-hidden'));\n456\t        } else if (!msg.hidden) {\n457\t          cancel(seat.hidden);\n458\t          seat.hidden = null;\n459\t        }\n460\t        return;\n461\t      default:\n462\t        return issue(seat, `unknown message type ${JSON.stringify(msg.type)}`);\n463\t    }\n464\t  }\n465\t\n466\t  function leave(key, reason = 'left') {\n467\t    const seat = byKey.get(key);\n468\t    if (!seat || seat.out || phase === 'ended') return;\n469\t    markOut(seat, reason);\n470\t    status();\n471\t    settle();\n472\t  }\n473\t\n474\t  const sitOut = (test) => () => {\n475\t    if (phase !== 'loading') return;\n476\t    for (const s of copies) if (test(s) && !s.out) markOut(s, 'not-ready');\n477\t    status();\n478\t    settle();\n479\t  };\n480\t\n481\t  function startRound() {\n482\t    // A gated round waits on the hub's splash, however long it holds: only\n483\t    // release() starts the clock on the games that are still loading.\n484\t    if (!gate) {\n485\t      later(t.helloMs, sitOut((s) => !s.hello));\n486\t      later(t.readyMs, sitOut((s) => !s.ready));\n487\t    }\n488\t    status();\n489\t  }\n490\t\n491\t  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\n492\t  function release() {\n493\t    if (released || phase !== 'loading') return;\n494\t    released = true;\n495\t    later(t.loadGraceMs, sitOut((s) => !s.ready));\n496\t    status();\n497\t    settle();\n498\t  }\n499\t\n500\t  startRound();\n501\t\n502\t  return {\n503\t    receive,\n504\t    leave,\n505\t    release,\n506\t    /** Call time now, as the cap would: the host pressed \"End round\". */\n507\t    timeUp() {\n508\t      if (phase === 'countdown' || phase === 'playing') timeUp();\n509\t    },\n510\t    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\n511\t    progress(id, score) {\n512\t      const seat = seats[id];\n513\t      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\n514\t    },\n515\t    /** End the round now: the session ended, or the host skipped this game. */\n516\t    abort(reason = 'skipped') {\n517\t      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\n518\t    },\n519\t    get phase() {\n520\t      return phase;\n521\t    },\n522\t    get released() {\n523\t      return released;\n524\t    },\n525\t    get record() {\n526\t      return record;\n527\t    },\n528\t    get mode() {\n529\t      return mode;\n530\t    },\n531\t    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\n532\t  };\n533\t}\n534\t"}]},"parent_tool_use_id":null,"session_id":"05c1fc6a-91e2-4dc5-aada-febbecf3984e","uuid":"38aa9c97-6dda-4cd7-a8bb-eb77e5371c20","timestamp":"2026-11-04T00:51:07.637Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.cache/plan-xb43d63-research/hub/repo/lib/hub/round.js","content":"/**\n * round.js — one round of an AI Hub session, run by the hub that coordinates\n * it (the harness page, or the session host's tab).\n *\n * It never touches the network or a frame itself: every message for a game\n * goes out through `deliver(key, msg)`, and everything the games report comes\n * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\n * without waiting for one.\n *\n * Players are known by `key` (whatever the session calls them); games see\n * contiguous ids 0..N-1 in slot order.\n */\n\nexport const TIMINGS = Object.freeze({\n  helloMs: 10_000,\n  readyMs: 45_000,\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n  loadGraceMs: 20_000,\n  countdownMs: 3_000,\n  graceMs: 5_000,\n  hiddenMs: 20_000,\n  maxRoundMs: 15 * 60_000,\n});\n\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n\n/** Each mode's name on screen. */\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n\n/** The mode a tag or a hello names, older tags included; null for anything else. */\nexport function modeOf(word) {\n  const w = String(word ?? '').trim().toLowerCase();\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\n}\n\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n\n/**\n * Whether a game's round carries the seed in its address, so the client seeds\n * Math.random and every copy starts the same: read from the game's own tag,\n * parallel or ghost. A game still tagged race was built for an unseeded start\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\n */\nexport const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n\nconst REAL_CLOCK = {\n  now: () => Date.now(),\n  setTimeout: (fn, ms) => setTimeout(fn, ms),\n  clearTimeout: (handle) => clearTimeout(handle),\n};\n\n/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\nexport function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n  const typical = Number(minutes);\n  if (!(typical > 0)) return maxRoundMs;\n  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\n}\n\n/**\n * Parallel and ghost order: finishers by time, then the rest by score,\n * then anyone who reported nothing, tied last. Equal times or scores share a\n * place.\n */\nexport function rankResults(results, ids) {\n  const timed = [];\n  const scored = [];\n  const silent = [];\n  for (const id of ids) {\n    const r = results.get(id);\n    if (r && Number.isFinite(r.time)) timed.push([id, r.time]);\n    else if (r && Number.isFinite(r.score)) scored.push([id, r.score]);\n    else silent.push(id);\n  }\n  const groups = (list, order) => {\n    list.sort((a, b) => order * (a[1] - b[1]) || a[0] - b[0]);\n    const out = [];\n    for (const [id, value] of list) {\n      const last = out[out.length - 1];\n      if (last && last.value === value) last.ids.push(id);\n      else out.push({ value, ids: [id] });\n    }\n    return out.map((g) => g.ids);\n  };\n  return [...groups(timed, 1), ...groups(scored, -1), ...(silent.length ? [silent] : [])];\n}\n\n/** A time or score as a number: finite, given as a number or as text; NaN for null, '' or true, which Number() would make 0. */\nconst asNumber = (v) => (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '') ? Number(v) : NaN);\n\n/** The protocol's limits on a round's highlights (README §10). */\nexport const HIGHLIGHTS = Object.freeze({ stats: 6, statName: 16, statText: 16, awards: 3, title: 24, detail: 40 });\n\n/** One player's stats, trimmed: up to six names, each a finite number or a short text. Null when none survive. */\nexport function cleanStats(stats) {\n  if (!stats || typeof stats !== 'object' || Array.isArray(stats)) return null;\n  const out = {};\n  for (const [name, value] of Object.entries(stats).slice(0, HIGHLIGHTS.stats)) {\n    const label = String(name).trim().slice(0, HIGHLIGHTS.statName);\n    if (!label) continue;\n    if (typeof value === 'number' && Number.isFinite(value)) out[label] = value;\n    else if (typeof value === 'string' && value.trim()) out[label] = value.trim().slice(0, HIGHLIGHTS.statText);\n  }\n  return Object.keys(out).length ? out : null;\n}\n\n/**\n * Awards, trimmed: `{ id, title, detail? }`, at most three a player, for\n * players of this round. A result's awards are about its own player: `self` is its id.\n */\nexport function cleanAwards(awards, ids, self = null) {\n  if (!Array.isArray(awards)) return [];\n  const given = new Map();\n  const out = [];\n  for (const a of awards) {\n    const id = self ?? a?.id;\n    const title = String(a?.title ?? '').trim().slice(0, HIGHLIGHTS.title);\n    if (!title || !ids.includes(id) || (given.get(id) || 0) >= HIGHLIGHTS.awards) continue;\n    given.set(id, (given.get(id) || 0) + 1);\n    const detail = String(a.detail ?? '').trim().slice(0, HIGHLIGHTS.detail);\n    out.push(detail ? { id, title, detail } : { id, title });\n  }\n  return out;\n}\n\n/**\n * Check a host's standings: groups of ids, best first, every present player\n * exactly once. Players already gone may be placed or left out; whoever is\n * left out lands in a last group of their own.\n */\nexport function checkStandings(standings, presentIds, allIds) {\n  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\n  const all = new Set(allIds);\n  const seen = new Set();\n  const groups = [];\n  for (const group of standings) {\n    const ids = Array.isArray(group) ? group : [group];\n    const kept = [];\n    for (const id of ids) {\n      if (!Number.isInteger(id) || !all.has(id)) return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\n      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\n      seen.add(id);\n      kept.push(id);\n    }\n    if (kept.length) groups.push(kept);\n  }\n  const missing = presentIds.filter((id) => !seen.has(id));\n  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\n  const absent = allIds.filter((id) => !seen.has(id));\n  if (absent.length) groups.push(absent);\n  return { ok: true, standings: groups };\n}\n\n/**\n * @param {object} o\n * @param {number} o.round            round number, carried on every message\n * @param {{key:string, slot:number, name:string}[]} o.players\n * @param {string} o.hostKey          whose game runs a shared world\n * @param {string} [o.serverKey]      a copy with no player of its own that runs the shared world\n *                                    instead (a server): one more copy after the players, welcomed\n *                                    with server: true, never ranked; the round is void if it goes\n * @param {string|null} o.mode        parallel | ghost | shared-world, or an older tag (modeOf); null takes the first hello's\n * @param {number} o.seed\n * @param {number} o.limitMs\n * @param {{now:()=>number, setTimeout:Function, clearTimeout:Function}} [o.clock]\n * @param {(key:string, msg:object) => void} o.deliver\n * @param {(status:object) => void} [o.onStatus]\n * @param {(record:object) => void} [o.onEnd]\n * @param {boolean} [o.gate]          the hub shows a splash and collects the players' ready itself:\n *                                    games ready up once loaded, and the round starts on release()\n */\nexport function createRound({\n  round,\n  players,\n  hostKey,\n  mode = null,\n  seed,\n  limitMs,\n  clock = REAL_CLOCK,\n  deliver,\n  onStatus = () => {},\n  onEnd = () => {},\n  timings = TIMINGS,\n  gate = false,\n  serverKey = null,\n}) {\n  mode = modeOf(mode);\n  const t = { ...TIMINGS, ...timings };\n  const seats = [...players]\n    .sort((a, b) => a.slot - b.slot)\n    .map((p, id) => ({\n      id,\n      key: p.key,\n      slot: p.slot,\n      name: p.name,\n      color: SLOT_COLORS[p.slot % SLOT_COLORS.length],\n      hello: false,\n      ready: false,\n      out: null,\n      result: null,\n      /** The last progress score the hub saw: the result of a player who never reports one. */\n      progress: null,\n      stats: null,\n      awards: [],\n      caps: null,\n      hidden: null,\n    }));\n  const server = serverKey\n    ? { id: seats.length, key: serverKey, slot: null, name: 'Server', color: null, hello: false, ready: false, out: null, result: null, progress: null, stats: null, awards: [], caps: null, hidden: null }\n    : null;\n  /** Every copy in the round: the players, then the server when there is one. */\n  const copies = server ? [...seats, server] : seats;\n  const byKey = new Map(copies.map((s) => [s.key, s]));\n  const ids = seats.map((s) => s.id);\n  const host = server ?? byKey.get(hostKey) ?? seats[0];\n  const timers = new Set();\n  const issues = [];\n  let phase = 'loading';\n  let goAt = null;\n  let record = null;\n  let released = !gate;\n\n  const later = (ms, fn) => {\n    const handle = clock.setTimeout(() => {\n      timers.delete(handle);\n      fn();\n    }, Math.max(0, ms));\n    timers.add(handle);\n    return handle;\n  };\n  const cancel = (handle) => {\n    if (handle == null) return;\n    clock.clearTimeout(handle);\n    timers.delete(handle);\n  };\n\n  /** The players still in the round. */\n  const present = () => seats.filter((s) => !s.out);\n  /** The copies still in the round: the players, and the server. */\n  const presentCopies = () => copies.filter((s) => !s.out);\n  const selfReported = () => SELF_REPORTED.includes(mode);\n  const needsHost = () => !selfReported();\n  const send = (seat, msg) => deliver(seat.key, { round, ...msg });\n  const toPresent = (msg, except = null) => {\n    for (const s of presentCopies()) if (s !== except && s.hello) send(s, msg);\n  };\n  const issue = (seat, problem) => {\n    issues.push({ key: seat?.key ?? null, id: seat?.id ?? null, problem });\n    status();\n  };\n\n  function status() {\n    onStatus({\n      round,\n      phase,\n      mode,\n      host: host.id,\n      goAt,\n      gate,\n      released,\n      players: seats.map((s) => ({\n        id: s.id,\n        key: s.key,\n        slot: s.slot,\n        name: s.name,\n        color: s.color,\n        hello: s.hello,\n        ready: s.ready,\n        out: s.out,\n        result: s.result,\n        client: s.caps?.client ?? null,\n      })),\n      server: server && { id: server.id, key: server.key, hello: server.hello, ready: server.ready, out: server.out, client: server.caps?.client ?? null },\n      issues: issues.slice(),\n    });\n  }\n\n  function welcome(seat) {\n    send(seat, {\n      type: 'welcome',\n      me: seat.id,\n      host: host.id,\n      players: seats.map((s) => ({ id: s.id, name: s.name, color: s.color })),\n      keys: copies.map((s) => s.key),\n      mode,\n      seed: seed >>> 0,\n      limitMs,\n      ...(gate ? { splash: true } : {}),\n      ...(seat === server ? { server: true } : {}),\n    });\n    for (const s of seats) if (s.out) send(seat, { type: 'leave', id: s.id, reason: s.out });\n  }\n\n  function markOut(seat, reason) {\n    if (seat.out || phase === 'ended') return;\n    seat.out = reason;\n    cancel(seat.hidden);\n    seat.hidden = null;\n    toPresent({ type: 'leave', id: seat.id, reason });\n    // A player who sat out is still at the hub: tell their game it is over for them.\n    if (reason === 'not-ready' && seat.hello) send(seat, { type: 'end', reason: 'sat-out' });\n  }\n\n  function settle() {\n    if (phase === 'ended') return;\n    const left = present();\n    if (!left.length) return finishVoid('no-players');\n    if (needsHost() && host.out) {\n      return finishVoid(host.out === 'not-ready' ? 'host-not-ready' : 'host-left', phase === 'loading' ? 'void' : 'host-left');\n    }\n    if (phase === 'loading') {\n      if (released && presentCopies().every((s) => s.ready)) begin();\n      return;\n    }\n    if (selfReported() && left.every((s) => s.result)) finishResults();\n  }\n\n  function begin() {\n    phase = 'countdown';\n    goAt = clock.now() + t.countdownMs;\n    toPresent({ type: 'start', at: goAt });\n    later(t.countdownMs, () => {\n      if (phase === 'countdown') {\n        phase = 'playing';\n        status();\n      }\n    });\n    later(t.countdownMs + limitMs, timeUp);\n    status();\n  }\n\n  function timeUp() {\n    if (phase === 'ended' || phase === 'grace') return;\n    phase = 'grace';\n    toPresent({ type: 'time-up', graceMs: t.graceMs });\n    later(t.graceMs, () => {\n      if (phase === 'ended') return;\n      if (selfReported()) finishResults();\n      else finishVoid('no-result');\n    });\n    status();\n  }\n\n  function finishResults() {\n    // A player still here who never reported is ranked by the last progress the hub saw from them.\n    const results = new Map(\n      seats.filter((s) => s.result || (!s.out && Number.isFinite(s.progress))).map((s) => [s.id, s.result ?? { score: s.progress, fallback: true }])\n    );\n    // Whoever reported and then left keeps their place: only those who left with nothing count as beaten.\n    const ranked = rankResults(results, seats.filter((s) => !s.out || s.result).map((s) => s.id));\n    const gone = seats.filter((s) => s.out && !s.result).map((s) => s.id);\n    const scores = {};\n    for (const [id, r] of results) scores[id] = Number.isFinite(r.time) ? r.time : r.score;\n    const stats = Object.fromEntries(seats.filter((s) => s.stats).map((s) => [s.id, s.stats]));\n    const awards = seats.flatMap((s) => s.awards);\n    finishPlayed(gone.length ? [...ranked, gone] : ranked, { scores, results: Object.fromEntries(results), stats, awards });\n  }\n\n  function finishPlayed(standings, extra = {}) {\n    end({ status: 'played', reason: 'finished', endReason: 'finished', standings, ...extra });\n  }\n\n  function finishVoid(reason, endReason = 'void') {\n    end({ status: 'void', reason, endReason, standings: null });\n  }\n\n  function end(outcome) {\n    if (phase === 'ended') return;\n    phase = 'ended';\n    for (const handle of timers) clock.clearTimeout(handle);\n    timers.clear();\n    const msg = { type: 'end', reason: outcome.endReason };\n    if (outcome.standings) msg.standings = outcome.standings;\n    toPresent(msg);\n    record = {\n      round,\n      mode,\n      hostId: host.id,\n      ...outcome,\n      players: seats.map((s) => ({ id: s.id, key: s.key, slot: s.slot, name: s.name, color: s.color, out: s.out })),\n      issues: issues.slice(),\n    };\n    status();\n    onEnd(record);\n  }\n\n  function receive(key, msg) {\n    const seat = byKey.get(key);\n    if (!seat || !msg || typeof msg.type !== 'string' || phase === 'ended' || seat.out) return;\n    switch (msg.type) {\n      case 'hello': {\n        if (seat.hello) return;\n        seat.hello = true;\n        seat.caps = { v: msg.v, client: msg.client, mode: msg.mode ?? null, seats: msg.seats ?? null, card: msg.card === true };\n        if (msg.v !== 1) issue(seat, `hello speaks protocol ${JSON.stringify(msg.v)}, not 1`);\n        const said = modeOf(msg.mode);\n        if (!mode && said) mode = said;\n        else if (msg.mode && said !== mode) issue(seat, `hello says mode ${msg.mode}, the round is ${mode}`);\n        welcome(seat);\n        status();\n        return;\n      }\n      case 'ready':\n        if (!seat.hello || seat.ready || phase !== 'loading') return;\n        seat.ready = true;\n        status();\n        return settle();\n      case 'result': {\n        if (!selfReported()) return issue(seat, `result is for parallel and ghost; this round is ${mode}`);\n        if (phase === 'loading') return issue(seat, 'result before start');\n        if (seat.result) return;\n        const time = asNumber(msg.time);\n        const score = asNumber(msg.score);\n        if (Number.isFinite(time)) seat.result = { time };\n        else if (Number.isFinite(score)) seat.result = { score };\n        else return issue(seat, 'result needs a finite time or score');\n        seat.stats = cleanStats(msg.stats);\n        seat.awards = cleanAwards(msg.awards, ids, seat.id);\n        status();\n        return settle();\n      }\n      case 'finish': {\n        if (selfReported()) return issue(seat, `finish is for a shared world; ${mode} games report result`);\n        if (seat !== host) return issue(seat, 'finish from a player who is not the host');\n        if (phase === 'loading') return issue(seat, 'finish before start');\n        const checked = checkStandings(msg.standings, present().map((s) => s.id), ids);\n        if (!checked.ok) return issue(seat, `finish ignored: ${checked.problem}`);\n        const scores = msg.scores && typeof msg.scores === 'object' ? msg.scores : undefined;\n        const given = msg.stats && typeof msg.stats === 'object' ? msg.stats : {};\n        const stats = Object.fromEntries(ids.map((id) => [id, cleanStats(given[id])]).filter(([, v]) => v));\n        const awards = cleanAwards(msg.awards, ids);\n        // won makes it a team result; a game tagged co-op that leaves it out lost, as co-op always read it.\n        const won = typeof msg.won === 'boolean' ? msg.won : seat.caps?.mode === 'co-op' ? false : undefined;\n        return finishPlayed(checked.standings, { scores, won, stats, awards });\n      }\n      case 'error':\n        issue(seat, `game error: ${String(msg.message || '').slice(0, 200)}`);\n        if (msg.fatal) {\n          if (needsHost() && seat === host) return finishVoid('host-error');\n          markOut(seat, 'disconnected');\n          status();\n          settle();\n        }\n        return;\n      case 'vis':\n        if (seat !== host || !needsHost()) return;\n        if (msg.hidden && seat.hidden == null && phase !== 'loading') {\n          seat.hidden = later(t.hiddenMs, () => finishVoid('host-hidden'));\n        } else if (!msg.hidden) {\n          cancel(seat.hidden);\n          seat.hidden = null;\n        }\n        return;\n      default:\n        return issue(seat, `unknown message type ${JSON.stringify(msg.type)}`);\n    }\n  }\n\n  function leave(key, reason = 'left') {\n    const seat = byKey.get(key);\n    if (!seat || seat.out || phase === 'ended') return;\n    markOut(seat, reason);\n    status();\n    settle();\n  }\n\n  const sitOut = (test) => () => {\n    if (phase !== 'loading') return;\n    for (const s of copies) if (test(s) && !s.out) markOut(s, 'not-ready');\n    status();\n    settle();\n  };\n\n  function startRound() {\n    // A gated round waits on the hub's splash, however long it holds: only\n    // release() starts the clock on the games that are still loading.\n    if (!gate) {\n      later(t.helloMs, sitOut((s) => !s.hello));\n      later(t.readyMs, sitOut((s) => !s.ready));\n    }\n    status();\n  }\n\n  /** The splash is over: start as soon as every game has loaded, and wait loadGraceMs at most for the slow ones. */\n  function release() {\n    if (released || phase !== 'loading') return;\n    released = true;\n    later(t.loadGraceMs, sitOut((s) => !s.ready));\n    status();\n    settle();\n  }\n\n  startRound();\n\n  return {\n    receive,\n    leave,\n    release,\n    /** Call time now, as the cap would: the host pressed \"End round\". */\n    timeUp() {\n      if (phase === 'countdown' || phase === 'playing') timeUp();\n    },\n    /** A player's progress score, as the hub's scoreboard saw it (parallel and ghost). */\n    progress(id, score) {\n      const seat = seats[id];\n      if (seat && !seat.out && !seat.result && Number.isFinite(score) && phase !== 'ended') seat.progress = score;\n    },\n    /** End the round now: the session ended, or the host skipped this game. */\n    abort(reason = 'skipped') {\n      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\n    },\n    get phase() {\n      return phase;\n    },\n    get released() {\n      return released;\n    },\n    get record() {\n      return record;\n    },\n    get mode() {\n      return mode;\n    },\n    seats: () => seats.map((s) => ({ ...s, hidden: undefined })),\n  };\n}\n","numLines":534,"startLine":1,"totalLines":534}},"tool_result_meta":[{"id":"toolu_01WJLgMa3kvrzPVqLvknGiVP","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
