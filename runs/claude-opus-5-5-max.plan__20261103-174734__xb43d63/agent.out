chDeg + ':' + view.scale;\n5542:    const view = r.view, key = view.id + ':' + view.yawDeg + ':' + view.pitchDeg + ':' + view.scale + ':' + this.version + ':' + (this.light || ''), wc = this._wcs || (this._wcs = new Map());\n6311:    if (Math.abs(view.yawDeg % 360) > 1) warn('pmap:yaw', 'PlatformMap is drawn for views with yaw 0 (side, brawler, or a custom tilted side view); other views look wrong');\n6312:    const key = view.id + ':' + view.yawDeg + ':' + view.pitchDeg + ':' + view.scale + ':' + view.zBoost + ':' + this.version;\n8491:const viewKey = v => v.id + ':' + v.yawDeg + ':' + v.pitchDeg + ':' + v.scale + ':' + v.zBoost;\n12394:      const v = this.view(k), f = Math.round((o.facing === undefined ? Math.PI / 2 : o.facing) / Math.PI * 8) / 8 * Math.PI, key = id + ':' + v.scale + ':' + v.yawDeg + ':' + v.pitchDeg + ':' + f + ':' + (o.size || 1);\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan__20261103-174734__xb43d63/work","is_error":false}]},"parent_tool_use_id":null,"session_id":"05c1fc6a-91e2-4dc5-aada-febbecf3984e","uuid":"46a4fddd-31fb-40e4-9a8b-d0e9bb88f1fa","timestamp":"2026-11-04T00:52:28.398Z","tool_use_result":{"stdout":"552:  /** change the angles and scale in place (game.setView and rotateView use their own copies); returns the view */\n554:    /** yawDeg: the turn about the up axis, degrees (0: north is up the screen; iso is 45); pitchDeg: the tilt, 0\n557:    this.yawDeg = yaw; this.pitchDeg = pitch; this.scale = scale; this.zBoost = zBoost;\n560:    this.yaw = w; this.pitch = p;\n616:  const cp = P || 30, key = view.yawDeg + ':' + view.pitchDeg + ':' + view.scale + ':' + view.zBoost + ':' + cp;\n620:  if (!v) { v = new View(view.id, view.label, view.yawDeg, cp, view.scale, h / Math.cos(cp * DEG)); _cviews.set(key, v); }\n1838:      const st = this._stamp('s' + v.id + v.pitchDeg + v.yawDeg + v.scale + ':' + R + ':' + A + color + st2, () => {\n2319:     *  view (rotateView) */\n2320:    this.zoom = 1; this.yaw = 0