[];this.time=0;this.rescued=0;this.score=0;this.kills=0;this.charges=0;this.shotsFired=0;this.status='playing';this.fxEvents=[];this.seq=0;this.titleGroup.visible=false;}\n  removePlayer(id){const p=this.players.find(x=>x.id===id);if(\"'!p)return;if(p.carrying!==null){const c=this.crew[p.carrying];c.state='\"'waiting';c.carrier=null;p.carrying=null;}this.physics.removeRigidBody(p.body);p.model.root.removeFromParent();p.rope.removeFromParent();this.players=this.players.filter(p=>p.id\"'!==id);}\n  setPosition(p,x,y){p.body.setTranslation({x,y,z:0},true);p.body.setLinvel({x:0,y:0,z:0},true);p.x=x;p.y=y;p.vx=0;p.vy=0;}\n  openGate(gate){if(gate.open)return;gate.open=true;gate.group.visible=false;gate.collider.setEnabled(false);this.burst(gate.x,gate.y,0xd3a16b,34,5);this.score+=100;this.emit('\"'gate',{id:gate.id});}\n  burst(x,y,color,count=12,speed=3){for(let i=0;i<count;i++){const m=mesh(i%3===0?ROCK:BOX,color,this.fxGroup,x,y,.6+rnd(),false);const s=.04+rnd()*.18;m.scale.set(s,s,s);const a=rnd()*Math.PI*2,v=speed*(.3+rnd());this.particles.push({mesh:m,x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,life:.5+rnd()*.8,max:1.3});}}\n  shoot(p,hostile=false){if(p.shootCool>0)return;p.shootCool=.155;this.shotsFired++;const dx=p.aimX,dy=p.aimY;const x=p.x+dx*.68,y=p.y+.23+dy*.55;this.makeShot(x,y,dx,dy,false,p.id);this.emit('shot',{x,y});}\n  makeShot(x,y,dx,dy,hostile=false,owner=-1){const m=orb(this.fxGroup,x,y,.7,hostile?.17:.21,hostile?.17:.065,.065,hostile?0xff795f:0xb8ffe1,false);m.rotation.z=Math.atan2(dy,dx);this.shots.push({id:this.nextId++,x,y,dx,dy,hostile,owner,life:hostile?4:.67,mesh:m});}\n  plantBomb(p){if(p.bombCool>0||p.bombs<=0)return false;p.bombs--;p.bombCool=.65;this.charges++;const x=p.x+p.face*.65,y=p.y-.3;const body=this.physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,y,0).setLinvel(p.face*2.1,2.2,0).setCcdEnabled(true));body.setEnabledTranslations(true,true,false,true);this.physics.createCollider(RAPIER.ColliderDesc.ball(.17).setRestitution(.35).setFriction(.7).setCollisionGroups(0x00040001),body);const group=new THREE.Group();this.fxGroup.add(group);box(group,0,0,0,.29,.4,.28,0xff8d65);box(group,0,.1,.16,.31,.09,.03,0xffdf9d);const fuse=cylinder(group,0,.28,0,.025,.2,0xffe6a3);const b={id:this.nextId++,body,mesh:group,fuse:1.7,owner:p.id,x,y};this.bombs.push(b);this.emit('bomb',{x,y});return true;}\n  explode(b){const r=this.tuning.blastRadius;this.burst(b.x,b.y,0xffc168,35,7);this.burst(b.x,b.y,0xff8461,18,5);this.emit('blast',{x:b.x,y:b.y,r});for(const g of this.gates){const dx=Math.abs(b.x-g.x),dy=Math.max(0,Math.abs(b.y-g.y)-g.h/2);if(Math.hypot(dx,dy)<r)this.openGate(g);}for(const e of this.enemies)if(e.alive&&distance(e,b)<r)this.hitEnemy(e,5,b.owner);for(const p of this.players)if(distance(p,b)<r*.8)this.hurt(p,1,'charge');b.mesh.removeFromParent();this.physics.removeRigidBody(b.body);}\n  hitEnemy(e,amount,owner){e.health-=amount;this.burst(e.x,e.y,e.kind==='bat'?0xc79bbd:0xc4ce9a,5,2);if(e.health<=0){e.alive=false;e.model.root.visible=false;this.kills++;this.score+=75;const p=this.players.find(p=>p.id===owner);if(p)p.contribution+=75;this.burst(e.x,e.y,0xe1ba84,11,3);this.emit('kill',{x:e.x,y:e.y});}}\n  hurt(p,amount=1,reason='creature'){if(p.invuln>0||this.tuning.god||this.demo)return;p.health-=Math.max(0,Math.round(amount*this.tuning.damage));if(this.tuning.damage===0)return;p.invuln=1.7;this.burst(p.x,p.y,0xff8c68,9,3);this.emit('hurt',{id:p.id,reason});if(p.health<=0){p.downs++;p.lives--;if(p.carrying\"'!==null){const c=this.crew[p.carrying];c.state='\"'waiting';c.carrier=null;p.carrying=null;}if(p.lives<=0&&this.players.length===1){this.status='lost';this.emit('lost');return;}p.health=5;p.air=180;p.fuel=100;p.bombs=5;p.invuln=3;this.setPosition(p,-11.8,3);this.score=Math.max(0,this.score-200);this.emit('respawn',{id:p.id});}}\n  interaction(p){if(distance(p,this.lift)<3.4){if(p.carrying\"'!==null)return {type:'\"'deliver',text:'Bring crew into the lift'};return {type:'refill',text:'Top up your kit'};}if(p.carrying===null){const c=this.crew.find(c=>c.state==='waiting'&&distance(p,c)<2.15);if(c)return {type:'rescue',id:c.id,text:'Rescue '+c.name};}const g=this.gates.find(g=>\"'!g.open&&Math.abs(p.x-g.x)<2.9&&Math.abs(p.y-g.y)<g.h/2+.5);if(g&&p.bombs>0)return {type:'\"'bomb',id:g.id,text:'Plant charge · move clear'};const s=this.stations.find(s=>distance(s,p)<1.8);if(s)return {type:'refill',text:'Refill fuel, air & charges'};return null;}\n  interact(p){if(p.interactCool>0)return false;p.interactCool=.35;const action=this.interaction(p);if(\"'!action)return false;if(action.type==='\"'rescue'){const c=this.crew[action.id];c.state='carried';c.carrier=p.id;p.carrying=c.id;this.score+=150;p.contribution+=150;this.emit('rescue',{id:c.id,player:p.id,quip:c.quip,x:c.x,y:c.y});return true;}if(action.type==='deliver'){this.deliver(p);return true;}if(action.type==='refill'){this.refill(p,true);return true;}if(action.type==='bomb')return this.plantBomb(p);return false;}\n  refill(p,force=false){if(p.refillCool>0&&\"'!force)return;if(p.fuel<90||p.air<165||p.bombs<5||p.health<5){p.fuel=100;p.air=180;p.bombs=5;p.health=5;p.refillCool=4;this.emit('\"'refill',{id:p.id});}}\n  deliver(p){if(p.carrying===null)return;const c=this.crew[p.carrying];c.state='safe';c.carrier=null;c.model.root.position.set(-14+this.rescued*1.3,2.15,.4);p.carrying=null;p.rope.visible=false;this.rescued++;this.score+=1000;p.contribution+=1000;this.refill(p,true);this.emit('deliver',{id:c.id,rescued:this.rescued});if(this.rescued===3){this.status='won';this.score+=Math.max(0,Math.round(1800-this.time*2));this.emit('win',{score:this.score,time:this.time});}}\n  step(dt,inputs={}){if(this.status\"'!=='\"'playing')return;this.time+=dt;\n    for(const p of this.players){const input=inputs[p.id]||{};p.invuln=Math.max(0,p.invuln-dt);p.shootCool=Math.max(0,p.shootCool-dt);p.bombCool=Math.max(0,p.bombCool-dt);p.interactCool=Math.max(0,p.interactCool-dt);p.refillCool=Math.max(0,p.refillCool-dt);p.water=p.x<-9.2&&p.x>-16.9&&p.y<-24.5&&p.y>-26.8;\n      const pos=p.body.translation();p.x=pos.x;p.y=pos.y;const ray=new RAPIER.Ray({x:p.x,y:p.y,z:0},{x:0,y:-1,z:0});p.grounded=\"'!!this.physics.castRay(ray,.83,true,undefined,0x00010001,p.collider,p.body);const vel=p.body.linvel();p.vx=vel.x;p.vy=vel.y;\n      if(input.aimX!==undefined&&Math.hypot(input.aimX,input.aimY||0)>.15){const len=Math.hypot(input.aimX,input.aimY||0);p.aimX=input.aimX/len;p.aimY=(input.aimY||0)/len;p.face=p.aimX<-.12?-1:p.aimX>.12?1:p.face;}else if(Math.abs(input.move||0)>.15){p.face=input.move<0?-1:1;p.aimX=p.face;p.aimY=0;}\n      const noclip=this.tuning.noclip||this.demo;if(noclip){p.collider.setEnabled(false);p.body.setGravityScale(0,true);p.body.setLinvel({x:(input.move||0)*this.tuning.moveSpeed,y:(input.vertical??(input.jet?1:input.down?-1:0))*7,z:0},true);p.thrusting=!!input.jet;}else{p.collider.setEnabled(true);p.body.setGravityScale(p.water?.4:1,true);const max=this.tuning.moveSpeed*(p.carrying!==null?.9:1)*(p.water?.68:1);const vx=lerp(vel.x,(input.move||0)*max,Math.min(1,dt*(p.grounded?18:9)));p.thrusting=!!input.jet&&p.fuel>0;let vy=vel.y;\n        if(p.thrusting){vy=Math.min(p.water?5.6:7.4,vy+this.tuning.jetThrust*dt);p.fuel=Math.max(0,p.fuel-dt*this.tuning.fuelDrain*(p.carrying!==null?1.08:1));}else{p.fuel=Math.min(100,p.fuel+dt*(p.grounded?34:5));if(input.down)vy-=15*dt;}if(p.water)vy=Math.max(vy,-3.5);p.body.setLinvel({x:vx,y:Math.max(-9,vy),z:0},true);}\n      if(input.fire)this.shoot(p);if(input.bomb)this.plantBomb(p);if(input.interact)this.interact(p);p.air=Math.max(0,p.air-dt*this.tuning.airDrain*(p.water?2.4:1));if(p.air===0)this.hurt(p,1,'\"'air');\n    }\n    this.physics.timestep=dt;this.physics.step();\n    for(const p of this.players){const pos=p.body.translation();p.x=clamp(pos.x,-19,19);p.y=clamp(pos.y,-58.4,9);if(pos.x\"'!==p.x||pos.y!==p.y)p.body.setTranslation({x:p.x,y:p.y,z:0},true);const vel=p.body.linvel();p.vx=vel.x;p.vy=vel.y;if(p.y<-48.1&&p.y>-49.5&&p.x>7.3&&p.x<14.2)this.hurt(p,1,'\"'lava');const ventOn=Math.sin(this.time*1.5)>.35;if(ventOn&&Math.abs(p.x-11)<.8&&p.y>-48.2&&p.y<-44.5)this.hurt(p,1,'steam');if(distance(p,this.lift)<2.6){if(p.carrying\"'!==null)this.deliver(p);this.refill(p);}for(const s of this.stations)if(distance(p,s)<1.2)this.refill(p);}\n    for(const e of this.enemies){if(!e.alive)continue;const target=this.players.reduce((a,p)=>!a||distance(p,e)<distance(a,e)?p:a,null);e.phase+=dt;const speed=this.tuning.enemySpeed;if(e.kind==='\"'bat'){let tx=e.homeX+Math.sin(e.phase*1.2)*1.8,ty=e.homeY+Math.sin(e.phase*1.8)*.65;if(target&&distance(e,target)<6.5){tx=target.x;ty=target.y+.3;}const a=Math.atan2(ty-e.y,tx-e.x);e.x+=Math.cos(a)*dt*1.65*speed;e.y+=Math.sin(a)*dt*1.65*speed;}else if(e.kind==='spider'){e.x=e.homeX+Math.sin(e.phase*.8*speed)*2.1;}else{e.x=e.homeX+Math.sin(e.phase*.65)*.7;e.y=e.homeY+Math.sin(e.phase)*.5;e.cool-=dt;if(target&&distance(e,target)<10&&e.cool<=0){const d=distance(e,target);this.makeShot(e.x,e.y,(target.x-e.x)/d,(target.y-e.y)/d,true);e.cool=2.3;}}\n      if(target&&distance(e,target)<.85)this.hurt(target,1,'creature');}\n    for(let i=this.shots.length-1;i>=0;i--){const s=this.shots[i];s.life-=dt;const speed=s.hostile?5:29;const len=speed*dt;const ray=new RAPIER.Ray({x:s.x,y:s.y,z:0},{x:s.dx,y:s.dy,z:0});const hit=this.physics.castRay(ray,len,true,undefined,0x00010001);s.x+=s.dx*len;s.y+=s.dy*len;let dead=\"'!!hit||s.life<=0;if(!dead){if(s.hostile){const p=this.players.find(p=>distance(p,s)<.7);if(p){this.hurt(p,1,'\"'spore');dead=true;}}else{const e=this.enemies.find(e=>e.alive&&distance(e,s)<.62);if(e){this.hitEnemy(e,1,s.owner);dead=true;}}}if(dead){s.mesh.removeFromParent();this.shots.splice(i,1);}}\n    for(let i=this.bombs.length-1;i>=0;i--){const b=this.bombs[i];const pos=b.body.translation();b.x=pos.x;b.y=pos.y;b.fuse-=dt;if(b.fuse<=0){this.explode(b);this.bombs.splice(i,1);}}\n    for(const c of this.crew)if(c.state==='carried'){const p=this.players.find(p=>p.id===c.carrier);if(p){c.model.root.position.set(lerp(c.model.root.position.x,p.x-p.face*.8,Math.min(1,dt*9)),lerp(c.model.root.position.y,p.y-1,Math.min(1,dt*9)),.15);}}\n  }\n  animate(dt){for(const p of this.players){p.model.root.position.set(p.x,p.y,.3);const state=p.thrusting?'fly':p.grounded&&Math.abs(p.vx)>.5?'walk':'idle';const aim=Math.atan2(p.aimY,p.aimX*p.face);p.model.animate(dt,state,p.face,aim);p.model.root.visible=p.invuln<=0||Math.sin(this.time*30)>-.3;const c=p.carrying\"'!==null?this.crew[p.carrying]:null;p.rope.visible=!!c;if(c){const a=p.rope.geometry.attributes.position;a.setXYZ(0,p.x,p.y-.2,.6);a.setXYZ(1,c.model.root.position.x,c.model.root.position.y+.5,.5);a.needsUpdate=true;p.rope.geometry.computeBoundingSphere();}}\n    for(const c of this.crew){c.model.animate(dt,c.state==='\"'carried'?'fly':c.state==='safe'?'wave':'wave',c.x<0?-1:1);c.model.root.scale.setScalar(c.state==='carried'?.74:1);if(c.state==='waiting')c.model.root.position.set(c.x,c.y,.2);}\n    for(const e of this.enemies){e.model.root.position.set(e.x,e.y,.35);e.model.mixer.update(dt);}\n    for(const s of this.shots)s.mesh.position.set(s.x,s.y,.7);\n    for(const b of this.bombs){b.mesh.position.set(b.x,b.y,.8);b.mesh.rotation.z=b.body.rotation().z;b.mesh.scale.setScalar(b.fuse<.5?1+Math.sin(b.fuse*65)*.14:1);}\n    for(let i=this.particles.length-1;i>=0;i--){const p=this.particles[i];p.life-=dt;p.vy-=8*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.mesh.position.x=p.x;p.mesh.position.y=p.y;p.mesh.rotation.z+=dt*3;if(p.life<.25)p.mesh.scale.multiplyScalar(Math.max(.1,1-dt*5));if(p.life<=0){p.mesh.removeFromParent();this.particles.splice(i,1);}}\n    this.steam.visible=Math.sin(this.time*1.5)>.35;this.steam.children.forEach((m,i)=>{m.position.y=-48+((this.time*3+i*.6)%4.3);m.scale.x=.7+((this.time+i*.5)%1)*.5;});this.lava.children.forEach((m,i)=>{if(i)m.position.y=-48.58+Math.sin(this.time*3+i)*.045;});if(this.titleGroup.visible){this.titleHero.animate(dt,'fly',1,.04);this.titleHero.root.position.y=-5.5+Math.sin(performance.now()*.0013)*.18;this.titleBuddy.animate(dt,'wave',-1);}}\n  snapshot(){return {t:round(this.time),status:this.status,rescued:this.rescued,score:this.score,kills:this.kills,charges:this.charges,shotsFired:this.shotsFired,gates:this.gates.map(g=>g.open),crew:this.crew.map(c=>({s:c.state,c:c.carrier,x:round(c.model.root.position.x),y:round(c.model.root.position.y)})),players:this.players.map(p=>({id:p.id,x:round(p.x),y:round(p.y),vx:round(p.vx),vy:round(p.vy),face:p.face,ax:round(p.aimX),ay:round(p.aimY),health:p.health,lives:p.lives,fuel:round(p.fuel),air:round(p.air),bombs:p.bombs,carrying:p.carrying,invuln:round(p.invuln),grounded:p.grounded,thrusting:p.thrusting,contribution:p.contribution,downs:p.downs})),enemies:this.enemies.map(e=>({id:e.id,x:round(e.x),y:round(e.y),alive:e.alive,health:e.health})),shots:this.shots.map(s=>({id:s.id,x:round(s.x),y:round(s.y),dx:s.dx,dy:s.dy,hostile:s.hostile,owner:s.owner,life:round(s.life)})),bombs:this.bombs.map(b=>({id:b.id,x:round(b.x),y:round(b.y),fuse:round(b.fuse)})),fx:this.fxEvents};}\n  applySnapshot(s){this.time=s.t;this.status=s.status;this.rescued=s.rescued;this.score=s.score;this.kills=s.kills;this.charges=s.charges;this.shotsFired=s.shotsFired;for(const p of [...this.players])if(\"'!s.players.some(n=>n.id===p.id))this.removePlayer(p.id);for(const n of s.players){let p=this.players.find(p=>p.id===n.id)||this.addPlayer(n.id);Object.assign(p,n,{aimX:n.ax,aimY:n.ay});p.body.setTranslation({x:p.x,y:p.y,z:0},true);}s.gates.forEach((o,i)=>{this.gates[i].open=o;this.gates[i].group.visible=!o;this.gates[i].collider.setEnabled(!o);});s.crew.forEach((n,i)=>{const c=this.crew[i];c.state=n.s;c.carrier=n.c;c.model.root.position.set(n.x,n.y,.2);});s.enemies.forEach((n,i)=>{Object.assign(this.enemies[i],n);this.enemies[i].model.root.visible=n.alive;});for(const shot of this.shots)shot.mesh.removeFromParent();this.shots=s.shots.map(n=>{const m=orb(this.fxGroup,n.x,n.y,.7,n.hostile?.17:.21,n.hostile?.17:.065,.065,n.hostile?0xff795f:0xb8ffe1,false);m.rotation.z=Math.atan2(n.dy,n.dx);return {...n,mesh:m};});for(const b of this.bombs){b.mesh.removeFromParent();if(b.body)this.physics.removeRigidBody(b.body);}this.bombs=s.bombs.map(n=>{const m=box(this.fxGroup,n.x,n.y,.8,.3,.4,.3,0xff8d65);return {...n,mesh:m,body:{rotation:()=>({z:0})}};});for(const e of s.fx||[])if(e.seq>this.seq){if(e.type==='\"'blast')this.burst(e.x,e.y,0xffb875,25,6);if(e.type==='kill')this.burst(e.x,e.y,0xc9b28a,10,3);this.events?.(e.type,e);this.seq=e.seq;}}\n}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > HERO-Another-Day-HERO-1984-gpt-6.1-sol-max-20261105-191348/world.js <<'JS'\nconst INK=0x061b24, COLORS=[0xffc168,0x82d7df,0xd3a1ed,0x9ae2c7];\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst distance=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);\nconst round=n=>Math.round(n*100)/100;\nconst seeded=(s)=>()=>{s=(Math.imul(s,1664525)+1013904223)>>>0;return s/4294967296;};\nconst rnd=seeded(198411);\nconst MAT=new Map();\nfunction cel(hex){if(MAT.has(hex))return MAT.get(hex);const {color,normalWorld,vec3}=THREE.TSL;const m=new THREE.MeshBasicNodeMaterial();const n=normalWorld.dot(vec3(.35,.68,1).normalize()).mul(.5).add(.5).mul(3).floor().div(3).mul(.5).add(.5);m.colorNode=color(hex).mul(n);MAT.set(hex,m);return m;}\nconst inkMat=new THREE.MeshBasicMaterial({color:INK,side:THREE.BackSide});\nconst glowMat=(color,opacity=.2)=>new THREE.MeshBasicMaterial({color,transparent:true,opacity,depthWrite:false,side:THREE.DoubleSide,blending:THREE.AdditiveBlending});\nfunction mesh(geo,color,parent,x=0,y=0,z=0,outline=true){const m=new THREE.Mesh(geo,cel(color));m.position.set(x,y,z);if(parent)parent.add(m);if(outline){const o=new THREE.Mesh(geo,inkMat);o.scale.setScalar(1.055);m.add(o);}return m;}\nconst BOX=new THREE.BoxGeometry(1,1,1),SPHERE=new THREE.SphereGeometry(1,12,8),ROCK=new THREE.DodecahedronGeometry(1,0);\nfunction box(parent,x,y,z,w,h,d,color,outline=true){const m=mesh(BOX,color,parent,x,y,z,outline);m.scale.set(w,h,d);return m;}\nfunction orb(parent,x,y,z,w,h,d,color,outline=true){const m=mesh(SPHERE,color,parent,x,y,z,outline);m.scale.set(w,h,d);return m;}\nfunction line(parent,points,color=INK,width=1,opacity=1){const geo=new THREE.BufferGeometry().setFromPoints(points.map(p=>new THREE.Vector3(...p)));const l=new THREE.Line(geo,new THREE.LineBasicMaterial({color,linewidth:width,transparent:opacity<1,opacity}));parent.add(l);return l;}\nfunction cylinder(parent,x,y,z,r,h,color,segments=8){return mesh(new THREE.CylinderGeometry(r,r,h,segments),color,parent,x,y,z);}\nfunction sign(parent,text,x,y,w=3.6,h=.8,color='#9ae2c7',sub=''){const c=document.createElement('canvas');c.width=768;c.height=Math.round(768*h/w);const ctx=c.getContext('2d');ctx.fillStyle='#092832';ctx.fillRect(0,0,c.width,c.height);ctx.strokeStyle=color;ctx.lineWidth=10;ctx.strokeRect(6,6,c.width-12,c.height-12);ctx.fillStyle=color;ctx.textAlign='center';ctx.textBaseline='middle';ctx.font='900 '+Math.round(c.height*(sub?.39:.53))+'px Arial';ctx.fillText(text,c.width/2,c.height*(sub?.39:.52));if(sub){ctx.font='bold '+Math.round(c.height*.17)+'px Arial';ctx.fillText(sub,c.width/2,c.height*.77);}const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;const m=new THREE.Mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshBasicMaterial({map:t,transparent:true}));m.position.set(x,y,1.85);parent.add(m);return m;}\nfunction makePerson(color=COLORS[0],miner=false){const root=new THREE.Group();const body=new THREE.Group();body.name='Suit';root.add(body);\n  const suit=miner?0xc08053:0x4c9d92;\n  box(body,0,.02,0,.66,.72,.44,suit);box(body,0,-.21,.25,.52,.12,.08,0x183f4b);box(body,.03,.24,.265,.14,.15,.04,0xf6e6bc);\n  const head=new THREE.Group();head.name='Head';head.position.y=.6;body.add(head);\n  orb(head,0,.11,0,.46,.4,.37,color);box(head,0,-.01,.3,.72,.25,.22,0x102c39);box(head,.12,.02,.425,.37,.055,.02,0xb1f2df,false);box(head,0,-.2,.2,.29,.13,.21,0x193943);\n  box(head,0,.31,.1,.45,.07,.35,0xedd19a);cylinder(head,0,.25,.38,.14,.2,0xede9cf).rotation.x=Math.PI/2;orb(head,0,.25,.5,.105,.1,.04,0xd8ffe9,false);\n  for(const [name,x] of [['LegL',-.2],['LegR',.2]]){const g=new THREE.Group();g.name=name;g.position.set(x,-.3,0);body.add(g);box(g,0,-.18,0,.24,.4,.29,suit);box(g,.025,-.43,.07,.29,.22,.43,0x173b46);box(g,.025,-.51,.08,.31,.065,.45,color);}\n  for(const [name,x] of [['ArmL',-.43],['ArmR',.43]]){const g=new THREE.Group