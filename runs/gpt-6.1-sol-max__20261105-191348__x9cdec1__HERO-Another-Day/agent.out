olumn;justify-content:center;width:48%;max-width:640px}.division{display:flex;align-items:center;gap:12px;font-size:11px;font-weight:850;letter-spacing:2.5px;color:var(--mint);margin-bottom:26px}.division:before{content:\\\"✚\\\";display:grid;place-items:center;border:1px solid #64978c;border-radius:50%;width:30px;height:30px;font-size:21px}.title-logo{font-size:clamp(62px,7.5vw,126px);font-weight:1000;line-height:.88;letter-spacing:-7px;color:var(--paper);text-shadow:5px 6px 0 #041d26;transform:skewX(-7deg);margin-left:-3px}.title-sub{font-size:clamp(27px,3.1vw,52px);font-weight:950;letter-spacing:4px;line-height:1.2;color:var(--gold);margin-top:10px;transform:skewX(-7deg);white-space:nowrap}.title-tagline{margin-top:20px;font-size:17px;line-height:1.65;color:#b5c8bf;max-width:340px}.menu-list{display:flex;flex-direction:column;align-items:stretch;gap:9px;margin-top:31px;width:310px;max-width:100%}.menu-button{position:relative;text-align:left;display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:48px;padding:12px 17px;border:1px solid transparent;border-radius:3px;color:var(--paper);background:transparent;font-size:18px;font-weight:750;transition:background .12s,color .12s,transform .12s}.menu-button .arrow{opacity:.3;font-size:21px}.menu-button.focused,.menu-button:hover,.menu-button:focus-visible{border-color:var(--gold);background:var(--gold);color:var(--ink);outline:none;transform:translateX(5px)}.menu-button.focused .arrow,.menu-button:hover .arrow{opacity:1}.menu-button.primary{border-color:#e5b36988}.menu-button.danger{color:var(--red)}.menu-button.danger.focused{background:var(--red);color:var(--ink);border-color:var(--red)}.title-bottom{position:absolute;bottom:4%;left:7%;right:4%;display:flex;align-items:flex-end;justify-content:space-between;gap:20px;color:#84a49d;font-size:11px;letter-spacing:1.2px}.title-caption{text-align:right;font-size:12px;letter-spacing:1.5px;color:var(--paper);line-height:1.9;border-right:3px solid va