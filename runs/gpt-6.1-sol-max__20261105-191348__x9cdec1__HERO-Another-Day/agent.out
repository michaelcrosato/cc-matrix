, ZeroStencilOp, createCanvasElement, defaultBuildStages, defaultShaderStages, shaderStages, vectorComponents };\nlet A;const I=new Array(128).fill(void 0);function g(A){return I[A]}I.push(void 0,null,!0,!1);let C=I.length;function B(A){C===I.length&&I.push(I.length+1);const g=C;return C=I[g],I[g]=A,g}function Q(I,g){try{return I.apply(this,g)}catch(I){A.__wbindgen_export_0(B(I))}}const E=\"undefined\"!=typeof TextDecoder?new TextDecoder(\"utf-8\",{ignoreBOM:!0,fatal:!0}):{decode:()=>{throw Error(\"TextDecoder not available\")}};\"undefined\"!=typeof TextDecoder&&E.decode();let i=null;function D(I,g){return I>>>=0,  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n</body>\n</html>\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"The title draw selected **H.E.R.O. Another Day**. The slice will have three rescue routes, with breakable rubble, cave creatures, flooded workings, and a lava chamber. I’m embedding the engine and physics dependencies so the final HTML can also run without downloading assets.\n"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > HERO-Another-Day-HERO-1984-gpt-6.1-sol-max-20261105-191348/package.json <<'EOF'\n{\n  \\\"name\\\": \\\"hero-another-day\\\",\n  \\\"version\\\": \\\"1.0.0\\\",\n  \\\"private\\\": true,\n  \\\"type\\\": \\\"module\\\",\n  \\\"scripts\\\": {\n    \\\"build\\\": \\\"python3 build.py\\\",\n    \\\"test\\\": \\\"/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/run.py\\\"\n  }\n}\nEOF\ncat > HERO-Another-Day-HERO-1984-gpt-6.1-sol-max-20261105-191348/build.py <<'PY'\nfrom pathlib import Path\nimport base64\n\nROOT = Path(__file__).resolve().parent\nNAME = ROOT.name\nhtml = (ROOT / 'shell.html').read_text()\nhtml = html.replace('<\"'!--SESSION-->'\"', '<script>\\\\n' + (ROOT / 'vendor/session.js').read_text() + '\\\\n</script>')\nhtml = html.replace('/*STYLES*/', (ROOT / 'style.css').read_text())\nlibs = {key: base64.b64encode((ROOT / ('vendor/' + file)).read_bytes()).decode() for key, file in [('core', 'three.core.js'), ('three', 'three.webgpu.js'), ('rapier', 'rapier.mjs')]}\nboot = \\\"const embedded=\\\" + repr(libs) + \\\";\\\\n\\\" + r'''\nconst moduleURL = (source) => URL.createObjectURL(new Blob([source], {type:'text/javascript'}));\nconst decodeModule = (b64) => new TextDecoder().decode(Uint8Array.from(atob(b64), c => c.charCodeAt(0)));\nconst coreURL = moduleURL(decodeModule(embedded.core));\nconst threeURL = moduleURL(decodeModule(embedded.three).replaceAll(\\\"'./three.core.js'\\\", JSON.stringify(coreURL)));\nconst [THREE, rapierModule] = await Promise.all([import(threeURL), import(moduleURL(decodeModule(embedded.rapier)))]);\nconst RAPIER = rapierModule.default;\nawait RAPIER.init();\n'''\njs = boot + '\\\\n' + (ROOT / 'audio.js').read_text() + '\\\\n' + (ROOT / 'world.js').read_text() + '\\\\n' + (ROOT / 'game.js').read_text()\nhtml = html.replace('/*GAME*/', js)\n(ROOT.parent / (NAME + '.html')).write_text(html)\nprint('Built ' + NAME + '.html')\nPY\ncat > HERO-Another-Day-HERO-1984-gpt-6.1-sol-max-20261105-191348/shell.html <<'HTML'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<!--SESSION-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no\">\n<meta name=\"theme-color\" content=\"#092c36\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Rescue all three miners and bring them back to the surface lift. Work together; everybody gets home.\">\n<meta name=\"hub:session-howto\" content=\"Move: left stick / A,D. Jetpack: Cross / Space. Aim: right stick / mouse. Pulse: R2 / left click. Charge: Square / E. Rescue: Triangle / F.\">\n<meta name=\"hub:session-minutes\" content=\"7\">\n<title>H.E.R.O. Another Day</title>\n<style>/*STYLES*/</style>\n</head>\n<body>\n<canvas id=\"game\" aria-label=\"Side-view cave rescue game\"></canvas>\n<div id=\"grain\" aria-hidden=\"true\"></div>\n<div id=\"vignette\" aria-hidden=\"true\"></div>\n<div id=\"loading\"><div class=\"loading-mark\">H<span>+</span></div><div class=\"eyebrow\">SUBSURFACE RESCUE DIVISION</div><h1>Checking your kit.</h1><p id=\"loadStatus\">Preparing the mine, jetpacks &amp; one very long shift…</p><div class=\"loadline\"></div></div>\n<div id=\"hud\" hidden>\n  <div class=\"hud-top\">\n    <div class=\"pilot-block\"><div class=\"eyebrow\">RESCUE DIVISION <span class=\"accent\">/ 07</span></div><div id=\"hearts\" class=\"hearts\"></div><div class=\"fuel-label\"><span>JET FUEL</span><span id=\"fuelText\">100%</span></div><div class=\"meter\"><i id=\"fuelFill\"></i></div></div>\n    <div class=\"mission-block\"><span class=\"eyebrow\">BRING EVERYBODY HOME</span><div class=\"crew-count\"><strong id=\"rescueCount\">0</strong><span>/ 3 CREW</span></div><div id=\"crewDots\"></div></div>\n    <div class=\"depth-block\"><div class=\"eyebrow\">BELOW SURFACE</div><div class=\"depth-number\"><strong id=\"depthText\">000</strong><span>m</span></div><div id=\"airText\">AIR 02:40</div></div>\n  </div>\n  <div id=\"objective\"><span class=\"objective-dot\"></span><span id=\"objectiveText\">Find the missing crew.</span></div>\n  <div id=\"markers\" aria-hidden=\"true\"></div>\n  <div id=\"context\" hidden></div>\n  <div id=\"sector\"><span class=\"eyebrow\" id=\"sectorNo\">SECTOR 01</span><strong id=\"sectorName\">THE CHALK GALLERIES</strong><span id=\"sectorHint\">A little light goes a long way.</span></div>\n  <div id=\"minimap\" aria-label=\"Mine depth map\"><div class=\"map-title\">↓ SHAFT</div><div class=\"map-shaft\"></div><i class=\"map-branch b1\"></i><i class=\"map-branch b2\"></i><i class=\"map-branch b3\"></i><i id=\"mapPilot\"></i><i id=\"mapCrew1\" class=\"map-crew c1\"></i><i id=\"mapCrew2\" class=\"map-crew c2\"></i><i id=\"mapCrew3\" class=\"map-crew c3\"></i></div>\n  <div id=\"controlStrip\"></div><button id=\"pauseButton\" class=\"icon-button\" aria-label=\"Pause\">Ⅱ</button>\n  <div id=\"coopStatus\"></div>\n</div>\n<div id=\"toast\" role=\"status\"></div>\n<div id=\"demoBadge\" hidden><span class=\"red-dot\"></span><b>ON THE JOB</b><span>AUTOPILOT DEMO · ANY INPUT TO RETURN</span></div>\n<div id=\"screen\" hidden></div>\n<div id=\"touchContext\" hidden><button id=\"touchAction\">RESCUE</button></div>\n<div id=\"touchHint\" hidden>LEFT THUMB · MOVE &amp; FLY <span>RIGHT THUMB · AIM &amp; FIRE</span></div>\n<div id=\"touchRings\" aria-hidden=\"true\"></div>\n<div id=\"bootError\" hidden></div>\n<script>window.addEventListener('\"'error',function(e){if(\"'!window.__gameReady){document.getElementById('\"'bootError').hidden=false;document.getElementById('bootError').textContent='Unable to start: '+e.message+' · Try a browser with WebGPU or WebGL 2.';}});window.addEventListener('unhandledrejection',function(e){if(\"'!window.__gameReady){document.getElementById('\"'bootError').hidden=false;document.getElementById('bootError').textContent='Unable to start: '+(e.reason?.message||e.reason);}});</script>\n<script type=\\\"module\\\">/*GAME*/</script>\n</body>\n</html>\nHTML\ncat > HERO-Another-Day-HERO-1984-gpt-6.1-sol-max-20261105-191348/style.css <<'CSS'\n:root{color-scheme:dark;--ink:#061b24;--panel:#0a303b;--paper:#f5ebd3;--dim:#9db5b5;--mint:#9ae2c7;--gold:#ffc168;--red:#ff785f;--line:rgba(193,224,215,.22);font-family:Inter,\\\"Arial\\\",sans-serif;font-weight:600;color:var(--paper)}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink)}button,input{font:inherit}button{cursor:pointer}button:disabled{cursor:default;opacity:.5}button,input,a{-webkit-tap-highlight-color:transparent}button:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:4px}[hidden]{display:none\"'!important}#game{position:absolute;inset:0;width:100%;height:100%;touch-action:none}#grain{position:absolute;inset:0;pointer-events:none;opacity:.055;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='\"'0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.78' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E\\\");z-index:4}#vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 55% 48%,transparent 45%,rgba(1,12,20,.48) 100%);z-index:3}#loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;background:#092b35;z-index:99;padding:2rem;text-align:center}.loading-mark{font-size:90px;font-weight:950;position:relative;color:var(--gold);letter-spacing:-10px;margin-right:16px}.loading-mark span{font-size:42px;position:relative;top:-35px;left:8px}h1,h2,h3,p{margin:0}#loading h1{margin:20px 0 12px;font-size:40px;letter-spacing:-1.5px}#loading p{color:var(--dim);font-size:18px;max-width:500px;line-height:1.5}.loadline{width:180px;height:4px;background:#1f4850;margin-top:30px;overflow:hidden}.loadline:after{content:\\\"\\\";display:block;width:40%;height:100%;background:var(--mint);animation:loading 1.5s ease-in-out infinite}@keyframes loading{from{transform:translateX(-100%)}to{transform:translateX(350%)}}.eyebrow{font-size:12px;font-weight:800;letter-spacing:2.5px;line-height:1.5;color:var(--dim);text-transform:uppercase}.accent{color:var(--gold)}#hud{position:absolute;inset:0;pointer-events:none;z-index:5}.hud-top{position:absolute;left:3.3%;right:3.3%;top:4%;display:flex;justify-content:space-between;align-items:flex-start;filter:drop-shadow(0 2px 5px #041c25)}.pilot-block{width:210px}.hearts{display:flex;gap:6px;margin:10px 0 14px;height:22px}.hearts span{color:var(--red);font-size:22px;line-height:1}.hearts .lost{color:#36616a}.fuel-label{display:flex;justify-content:space-between;font-size:11px;letter-spacing:1.3px;margin-bottom:6px}.meter{height:9px;background:#122e38;border:1px solid #527678;transform:skewX(-10deg)}.meter i{display:block;background:var(--mint);height:100%;width:100%;transition:width .1s}.meter.low i{background:var(--red)}.mission-block{text-align:center}.crew-count{display:flex;gap:12px;align-items:center;justify-content:center;margin:4px 0}.crew-count strong{font-size:47px;line-height:1;font-weight:950;letter-spacing:-2px}.crew-count>span{font-size:16px;letter-spacing:2px;color:var(--dim)}#crewDots{display:flex;gap:9px;justify-content:center;margin-top:10px}.crew-chip{width:38px;height:9px;border:1px solid #b2c7bb;background:#163e48;transform:skewX(-14deg)}.crew-chip.carried{background:var(--gold)}.crew-chip.safe{background:var(--mint);border-color:var(--mint)}.depth-block{text-align:right;min-width:160px}.depth-number{display:flex;align-items:baseline;justify-content:flex-end;gap:6px}.depth-number strong{font-size:48px;font-weight:950;letter-spacing:-2px;line-height:1.2}.depth-number span{color:var(--mint);font-size:24px}#airText{color:var(--mint);font-size:13px;letter-spacing:1px;margin-top:9px}#objective{position:absolute;top:19%;left:50%;transform:translateX(-50%);font-size:15px;display:flex;gap:10px;align-items:center;background:#082833dc;border:1px solid #54707866;padding:10px 18px;border-radius:30px;white-space:nowrap}.objective-dot{width:6px;height:6px;display:block;background:var(--gold);border-radius:50%;box-shadow:0 0 10px #ffc168}#sector{position:absolute;left:3.3%;bottom:10%;display:flex;flex-direction:column;gap:5px;text-shadow:0 2px 8px #031b22}#sector strong{font-weight:900;letter-spacing:.5px;font-size:22px}#sector>span:last-child{color:#c0cec4;font-size:13px}#controlStrip{position:absolute;bottom:3.6%;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:22px;white-space:nowrap;font-size:13px;color:#bfd2ca;text-shadow:0 2px 4px #00131c}.key{border:1px solid #70958f;border-bottom-width:3px;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;min-width:27px;padding:2px 6px;color:var(--paper);font-size:12px;font-weight:850;margin-right:6px;background:#0c303bcc}.glyph{display:inline-block;min-width:25px;text-align:center;font-size:22px;line-height:1;vertical-align:middle;color:var(--gold);margin-right:5px}.icon-button{width:45px;height:45px;background:#092e39c9;border:1px solid #597478;color:var(--paper);border-radius:50%;font-size:19px;display:grid;place-items:center;pointer-events:auto}#pauseButton{position:absolute;right:3.3%;bottom:3.3%}#coopStatus{position:absolute;left:3.3%;top:22%;font-size:12px;letter-spacing:1px;max-width:240px;color:var(--mint);line-height:1.7}#context{position:absolute;left:50%;bottom:21%;transform:translateX(-50%);background:var(--paper);color:var(--ink);padding:13px 23px;border:3px solid var(--ink);box-shadow:5px 5px 0 #051b24;font-size:18px;font-weight:850;white-space:nowrap}#context .key{background:var(--ink);border-color:var(--ink);color:var(--paper)}#context .glyph{color:var(--ink)}#minimap{position:absolute;right:4%;bottom:13%;width:92px;height:162px;opacity:.9}.map-title{font-size:10px;letter-spacing:2px;text-align:center;color:var(--dim);margin-bottom:12px}.map-shaft{position:absolute;left:44px;top:30px;height:126px;width:7px;border-left:1px solid #8aac9b;border-right:1px solid #8aac9b;background:#214852}.map-branch{position:absolute;height:5px;background:#42616a;width:26px;left:50px}.b1{top:50px}.b2{top:87px;left:18px}.b3{top:137px}.map-crew{position:absolute;width:6px;height:6px;background:var(--gold);transform:rotate(45deg)}.c1{top:49px;left:78px}.c2{top:86px;left:11px}.c3{top:136px;left:78px}#mapPilot{position:absolute;top:30px;left:44px;width:8px;height:8px;border-radius:50%;background:var(--mint);border:1px solid #e6ffe2;box-shadow:0 0 8px #9ae2c7}#toast{position:absolute;bottom:15%;left:50%;transform:translate(-50%,20px);opacity:0;z-index:35;padding:14px 26px;max-width:80%;background:#072633ed;border:1px solid #829d8a;color:var(--paper);font-size:18px;transition:opacity .2s,transform .2s;text-align:center;pointer-events:none}#toast.show{opacity:1;transform:translate(-50%,0)}#demoBadge{position:absolute;left:50%;top:4%;transform:translateX(-50%);z-index:8;display:flex;align-items:center;gap:13px;padding:15px 24px;background:#082630e8;border:1px solid #90b4aa;white-space:nowrap;font-size:13px;letter-spacing:1.5px}#demoBadge>span:last-child{color:var(--dim);font-size:11px}.red-dot{width:8px;height:8px;background:var(--red);border-radius:50%;animation:blink 1s steps(2) infinite}@keyframes blink{50%{opacity:.2}}#screen{position:absolute;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;padding:4%;background:linear-gradient(110deg,rgba(3,22,31,.87),rgba(2,22,31,.5));overflow:hidden}#screen.title-screen{justify-content:flex-start;background:linear-gradient(90deg,rgba(3,23,31,.97) 0%,rgba(5,28,36,.92) 31%,rgba(5,28,36,.1) 68%);padding-left:7%;align-items:stretch}.title-wrap{display:flex;flex-direction:column;justify-content:center;width:48%;max-width:640px}.division{display:flex;align-items:center;gap:12px;font-size:11px;font-weight:850;letter-spacing:2.5px;color:var(--mint);margin-bottom:26px}.division:before{content:\\\"✚\\\";display:grid;place-items:center;border:1px solid #64978c;border-radius:50%;width:30px;height:30px;font-size:21px}.title-logo{font-size:clamp(62px,7.5vw,126px);font-weight:1000;line-height:.88;letter-spacing:-7px;color:var(--paper);text-shadow:5px 6px 0 #041d26;transform:skewX(-7deg);margin-left:-3px}.title-sub{font-size:clamp(27px,3.1vw,52px);font-weight:950;letter-spacing:4px;line-height:1.2;color:var(--gold);margin-top:10px;transform:skewX(-7deg);white-space:nowrap}.title-tagline{margin-top:20px;font-size:17px;line-height:1.65;color:#b5c8bf;max-width:340px}.menu-list{display:flex;flex-direction:column;align-items:stretch;gap:9px;margin-top:31px;width:310px;max-width:100%}.menu-button{position:relative;text-align:left;display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:48px;padding:12px 17px;border:1px solid transparent;border-radius:3px;color:var(--paper);background:transparent;font-size:18px;font-weight:750;transition:background .12s,color .12s,transform .12s}.menu-button .arrow{opacity:.3;font-size:21px}.menu-button.focused,.menu-button:hover,.menu-button:focus-visible{border-color:var(--gold);background:var(--gold);color:var(--ink);outline:none;transform:translateX(5px)}.menu-button.focused .arrow,.menu-button:hover .arrow{opacity:1}.menu-button.primary{border-color:#e5b36988}.menu-button.danger{color:var(--red)}.menu-button.danger.focused{background:var(--red);color:var(--ink);border-color:var(--red)}.title-bottom{position:absolute;bottom:4%;left:7%;right:4%;display:flex;align-items:flex-end;justify-content:space-between;gap:20px;color:#84a49d;font-size:11px;letter-spacing:1.2px}.title-caption{text-align:right;font-size:12px;letter-spacing:1.5px;color:var(--paper);line-height:1.9;border-right:3px solid var(