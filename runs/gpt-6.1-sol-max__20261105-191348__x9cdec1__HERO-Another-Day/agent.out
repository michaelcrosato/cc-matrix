{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > HERO-Another-Day-HERO-1984-gpt-6.1-sol-max-20261105-191348/audio.js <<'JS'\nclass SynthAudio {\n  constructor() {\n    this.ctx=null;this.masterVolume=.7;this.musicVolume=.1;this.sfxVolume=.75;this.enabled=false;this.muted=false;this.beat=0;this.nextBeat=0;this.sector=0;this.voicesPlayed=0;this.soundsPlayed=0;this.musicNotes=0;\n  }\n  setup(ctx) {\n    this.ctx=ctx;this.master=ctx.createGain();this.master.gain.value=this.masterVolume;this.master.connect(ctx.destination);\n    this.music=ctx.createGain();this.music.gain.value=this.musicVolume;this.music.connect(this.master);\n    this.effects=ctx.createGain();this.effects.gain.value=this.sfxVolume;this.effects.connect(this.master);\n    this.analyser=ctx.createAnalyser();this.analyser.fftSize=256;this.master.connect(this.analyser);\n    const n=ctx.sampleRate;this.noise=ctx.createBuffer(1,n,ctx.sampleRate);const d=this.noise.getChannelData(0);let s=4321;for(let i=0;i<n;i++){s=(Math.imul(s,1664525)+1013904223)>>>0;d[i]=(s/4294967296)*2-1;}\n    this.nextBeat=ctx.currentTime+.08;\n  }\n  async unlock(){if(\"'!this.ctx)this.setup(new (window.AudioContext||window.webkitAudioContext)());await this.ctx.resume();this.enabled=true;}\n  setLevels(){if(!this.ctx)return;this.master.gain.setTargetAtTime(this.muted?0:this.masterVolume,this.ctx.currentTime,.04);this.music.gain.setTargetAtTime(this.musicVolume,this.ctx.currentTime,.05);this.effects.gain.setTargetAtTime(this.sfxVolume,this.ctx.currentTime,.03);}\n  tone(freq,duration=.12,type='\"'sine',volume=.15,at=null,dest=null,endFreq=null){if(\"'!this.ctx)return;const t=at??this.ctx.currentTime;const o=this.ctx.createOscillator(),g=this.ctx.createGain();o.type=type;o.frequency.setValueAtTime(Math.max(20,freq),t);if(endFreq)o.frequency.exponentialRampToValueAtTime(Math.max(20,endFreq),t+duration);g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(volume,t+.006);g.gain.exponentialRampToValueAtTime(.0001,t+duration);o.connect(g);g.connect(dest||this.effects);o.start(t);o.stop(t+duration+.01);return o;}\n  hiss(duration,volume,cutoff=1500,at=null,dest=null){if(!this.ctx)return;const t=at??this.ctx.currentTime;const s=this.ctx.createBufferSource(),f=this.ctx.createBiquadFilter(),g=this.ctx.createGain();s.buffer=this.noise;f.type='\"'lowpass';f.frequency.setValueAtTime(cutoff,t);f.frequency.exponentialRampToValueAtTime(80,t+duration);g.gain.setValueAtTime(volume,t);g.gain.exponentialRampToValueAtTime(.0001,t+duration);s.connect(f);f.connect(g);g.connect(dest||this.effects);s.start(t);s.stop(t+duration);}\n  effect(name){if(\"'!this.ctx||this.muted)return;this.soundsPlayed++;const t=this.ctx.currentTime;\n    if(name==='\"'shot'){this.tone(940,.085,'sawtooth',.07,t,null,230);this.tone(1360,.045,'sine',.06,t);}\n    if(name==='bomb'){this.tone(260,.12,'square',.08,t,null,130);this.tone(520,.09,'square',.04,t+.12);}\n    if(name==='tick')this.tone(900,.045,'square',.045,t);\n    if(name==='blast'){this.hiss(.75,.46,2800);this.tone(105,.65,'sine',.4,t,null,24);this.tone(48,.45,'triangle',.22,t);}\n    if(name==='hurt'){this.tone(200,.3,'sawtooth',.13,t,null,60);this.hiss(.18,.13,700);}\n    if(name==='kill'){this.tone(520,.1,'square',.07,t,null,120);this.hiss(.15,.1,1500);}\n    if(name==='refill'){[0,4,7,12].forEach((n,i)=>this.tone(330*2**(n/12),.22,'triangle',.1,t+i*.07));}\n    if(name==='rescue'){[0,7,12].forEach((n,i)=>this.tone(440*2**(n/12),.28,'sine',.12,t+i*.11));this.voice(1,t+.1);}\n    if(name==='deliver'){[0,4,7,12,16].forEach((n,i)=>this.tone(330*2**(n/12),.4,'triangle',.13,t+i*.1));this.voice(2,t+.3);}\n    if(name==='win'){[0,4,7,12,7,12,16,19,24].forEach((n,i)=>this.tone(262*2**(n/12),.7,'triangle',.16,t+i*.13));this.voice(3,t+.7);}\n    if(name==='click')this.tone(580,.055,'sine',.075,t,null,760);\n    if(name==='low')this.tone(180,.16,'triangle',.1,t);\n    if(name==='splash'){this.hiss(.45,.19,2200);this.tone(260,.15,'sine',.07,t,null,80);}\n  }\n  voice(seed=0,at=null){if(\"'!this.ctx||this.muted)return;this.voicesPlayed++;const t=at??this.ctx.currentTime;const syllables=[1,1.35,.88,1.5,1.1,.77];for(let i=0;i<6;i++){const start=t+i*.085;const f=this.ctx.createBiquadFilter();f.type='\"'bandpass';f.frequency.value=850+((seed+i*3)%5)*300;f.Q.value=2;f.connect(this.effects);this.tone((180+seed*29)*syllables[(i+seed)%6],.075,'sawtooth',.18,start,f);}}\n  musicStep(t,b){const root=[130.81,110,87.31][this.sector%3];const progression=[0,0,-5,-2][Math.floor(b/16)%4];const r=root*2**(progression/12);const notes=[0,7,12,15,7,10,12,7,0,7,15,19,12,10,7,3];if(b%2===0){this.tone(r/2,.4,'triangle',.31,t,this.music);this.tone(70,.1,'sine',.36,t,this.music,35);}if(b%4===2)this.hiss(.14,.12,1300,t,this.music);this.hiss(.035,.045,4000,t,this.music);this.tone(r*2**(notes[b%16]/12),.32,'sine',.22,t,this.music);if(b%8===0){[0,3,7].forEach(n=>this.tone(r*2**(n/12),1.5,'triangle',.055,t,this.music));}this.musicNotes++;}\n  update(){if(\"'!this.ctx||!this.enabled||this.muted)return;const now=this.ctx.currentTime;if(this.nextBeat<now-.4)this.nextBeat=now+.03;while(this.nextBeat<now+.12){this.musicStep(this.nextBeat,this.beat++);this.nextBeat+=60/108/2;}}\n  stop(){this.muted=true;this.setLevels();}\n  async probe(){const a=new SynthAudio();const c=new OfflineAudioContext(1,48000*2,48000);a.setup(c);a.enabled=true;for(let i=0;i<6;i++)a.musicStep(.05+i*.277,i);a.effect('\"'shot');a.voice(2,.4);a.effect('blast');const buffer=await c.startRendering();let energy=0,peak=0;const data=buffer.getChannelData(0);for(const n of data){energy+=n*n;peak=Math.max(peak,Math.abs(n));}return {rms:Math.sqrt(energy/data.length),peak,musicDefault:a.musicVolume,voiceSyllables:6,sampleRate:buffer.sampleRate};}\n}\nconst audio=new SynthAudio();\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
