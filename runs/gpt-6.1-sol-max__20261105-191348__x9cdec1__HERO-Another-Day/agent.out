,-.1,-.2],.8),tracks('LegR.rotation[z]',[.25,.1,.2,.35,.25],.8),tracks('Scarf.rotation[z]',[-.8,-.5,-.9,-.6,-.8],.8)]);\n  const wave=new THREE.AnimationClip('signal',1.2,[tracks('ArmL.rotation[z]',[-2.1,-2.7,-2.1,-2.7,-2.1],1.2),tracks('ArmR.rotation[z]',[.2,.1,.2,.3,.2],1.2)]);\n  const spin=new THREE.AnimationClip('rotor',.18,[new THREE.NumberKeyframeTrack('Rotor.rotation[y]',[0,.18],[0,Math.PI*2])]);\n  const actions={idle:mixer.clipAction(idle),walk:mixer.clipAction(walk),fly:mixer.clipAction(fly),wave:mixer.clipAction(wave)};for(const [key,a] of Object.entries(actions)){a.play();a.setEffectiveWeight(key===(miner?'wave':'idle')?1:0);}mixer.clipAction(spin).play();\n  return {root,body,head,gun,flames,mixer,actions,halo,animate(dt,state='idle',face=1,aim=0){mixer.update(dt);for(const [key,a] of Object.entries(actions))a.setEffectiveWeight(lerp(a.getEffectiveWeight(),key===state?1:0,Math.min(1,dt*12)));root.scale.x=Math.abs(root.scale.x)*face;gun.rotation.z=aim;flames.visible=state==='fly';if(flames.visible)flames.scale.y=.8+Math.sin(performance.now()*.04)*.25;body.rotation.z=lerp(body.rotation.z,state==='fly'?-face*.08:0,Math.min(1,dt*7));}};\n}\nfunction makeEnemy(kind){const g=new THREE.Group();const mixer=new THREE.AnimationMixer(g);let clip;\n  if(kind==='bat'){orb(g,0,0,0,.35,.28,.2,0xb784ac);for(const x of [-.13,.13])orb(g,x,.06,.19,.055,.07,.045,0xffc168,false);for(let s of [-1,1]){const wing=new THREE.Group();wing.name=s===-1?'WingL':'WingR';g.add(wing);const shape=new THREE.Shape();shape.moveTo(0,.1);shape.lineTo(s*.9,.45);shape.lineTo(s*.7,-.25);shape.lineTo(s*.4,-.05);shape.lineTo(0,-.15);const geo=new THREE.ExtrudeGeometry(shape,{depth:.08,bevelEnabled:false});mesh(geo,0x685b87,wing);mesh(new THREE.ConeGeometry(.1,.27,4),0xc187b6,g,s*.18,.31,0);}\n    clip=new THREE.AnimationClip('wingbeat',.4,[new THREE.NumberKeyframeTrack('WingL.rotation[z]',[0,.2,.4],[.4,-.65,.4]),new THREE.NumberKeyframeTrack('WingR.rotation[z]',[0,.2,.4],[-.4,.65,-.4])]);\n  } else if(kind==='spider'){orb(g,0,0,0,.4,.28,.25,0xd59467);orb(g,.31,.02,.15,.17,.17,.16,0x3d6870);for(let i=0;i<6;i++){const side=i<3?-1:1;const leg=new THREE.Group();leg.name='L'+i;g.add(leg);const x=(i%3-1)*.25;line(leg,[[x,0,.08],[x+side*.3,-.03,.1],[x+side*.5,-.28,.1]],0x152c37);box(leg,x+side*.28,-.04,.05,.5,.07,.08,0x243f48).rotation.z=side*.2;}\n    clip=new THREE.AnimationClip('skitter',.35,Array.from({length:6},(_,i)=>new THREE.NumberKeyframeTrack('L'+i+'.rotation[z]',[0,.175,.35],[i%2?.18:-.18,i%2?-.18:.18,i%2?.18:-.18])));\n  }else{orb(g,0,0,0,.46,.48,.32,0x6eb3a0);for(let i=0;i<6;i++){const a=i*Math.PI/3;const p=mesh(new THREE.ConeGeometry(.14,.5,4),0xf4b17d,g,Math.cos(a)*.45,Math.sin(a)*.45,0);p.rotation.z=a-Math.PI/2;}orb(g,0,0,.29,.22,.22,.11,0x132f3a);orb(g,0,0,.41,.1,.1,.03,0xff8061,false);clip=new THREE.AnimationClip('spore',2,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,1,2],[-.08,.08,-.08])]);}\n  mixer.clipAction(clip).play();return {root:g,mixer};\n}\nconst DEFAULT_TUNING={moveSpeed:6.2,jetThrust:38,fuelDrain:18,airDrain:1,damage:1,blastRadius:4.2,enemySpeed:1,god:false,noclip:false};\nconst CREW_DATA=[{name:'PIP',x:16,y:-9.64,sector:0,color:0xffc168,quip:'THOUGHT YOU’D NEVER CLOCK IN.'},{name:'DOT',x:-16,y:-25.64,sector:1,color:0x90d6da,quip:'MY SOCKS HAVE CLOCKED OUT.'},{name:'GUS',x:16,y:-48.14,sector:2,color:0xc0a1df,quip:'LET’S CALL THAT A WARM-UP.'}];\nclass RescueWorld {\n  constructor(scene,onEvent){this.scene=scene;this.events=onEvent;this.tuning={...DEFAULT_TUNING};this.group=new THREE.Group();scene.add(this.group);this.fxGroup=new THREE.Group();scene.add(this.fxGroup);this.physics=new RAPIER.World({x:0,y:-18,z:0});this.physics.timestep=1/60;this.statics=[];this.gates=[];this.players=[];this.enemies=[];this.crew=[];this.shots=[];this.bombs=[];this.particles=[];this.stations=[];this.time=0;this.rescued=0;this.score=0;this.kills=0;this.charges=0;this.shotsFired=0;this.status='idle';this.nextId=1;this.demo=false;this.seq=0;this.fxEvents=[];this.build();this.reset([0]);}\n  emit(type,data={}){this.events?.(type,data);if(['blast','rescue','deliver','kill','shot','hurt','refill'].includes(type)){this.fxEvents.push({seq:++this.seq,type,...data});if(this.fxEvents.length>8)this.fxEvents.shift();}}\n  fixedBox(x,y,w,h,visual=true,color=0x28525a){const body=this.physics.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x,y,0));const c=this.physics.createCollider(RAPIER.ColliderDesc.cuboid(w/2,h/2,1.5).setFriction(.8).setCollisionGroups(0x0001ffff),body);this.statics.push({body,collider:c,x,y,w,h});if(visual)box(this.group,x,y,-.45,w,h,2.6,color);return {body,collider:c};}\n  rockWall(x,y,w,h,color){this.fixedBox(x,y,w,h,true,color);const count=Math.max(8,Math.round(w*h/7));for(let i=0;i<count;i++){const px=x+(rnd()-.5)*(w-.5),py=y+(rnd()-.5)*(h-.4);const m=mesh(ROCK,i%3===0?color+0x050807:color,this.group,px,py,1.1,false);m.scale.set(.6+rnd()*1.3,.35+rnd()*.6,.08+rnd()*.16);m.rotation.z=rnd()*6;}\n    for(let j=0;j<Math.max(6,h/1.6);j++){const px=x+(rnd()-.5)*w,py=y+(rnd()-.5)*h;line(this.group,[[px-.2,py,1.34],[px+.3,py+.1,1.34],[px+.55,py-.13,1.34]],0x102e39,1,.65);}const edge=x<0?x+w/2:x-w/2;for(let j=0;j<h;j+=.9){const m=mesh(ROCK,color,this.group,edge+(x<0?-.2:.2),y-h/2+j+.3,0);m.scale.set(.35+rnd()*.3,.65,1.4);m.rotation.z=rnd();}}\n  build(){\n    box(this.group,0,-27,-5.6,48,82,.4,0x061e2a,false);const zones=[{y:-7.3,h:15,col:0x143b48},{y:-23,h:17,col:0x163c4b},{y:-44,h:20,col:0x2e3544}];for(const z of zones){box(this.group,0,z.y,-4.9,38,z.h,.2,z.col,false);for(let i=0;i<30;i++){const m=mesh(ROCK,z.col+0x030504,this.group,(rnd()-.5)*37,z.y+(rnd()-.5)*z.h,-4.5,false);m.scale.set(1+rnd()*2,.5+rnd(),.13);m.rotation.z=rnd()*6;}}\n    this.rockWall(-12.25,-8.35,15.5,19.3,0x2b5960);this.rockWall(12.25,-.35,15.5,3.3,0x2b5960);this.rockWall(12.25,-24.25,15.5,27.5,0x26505d);this.rockWall(-12.25,-42.75,15.5,32.5,0x263f4e);this.rockWall(12.25,-54,15.5,10,0x4b414d);\n    this.fixedBox(-20.5,-26,.8