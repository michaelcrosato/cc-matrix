{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport {randomInt} from 'node:crypto';\nconst titles=['H.E.L.P.','H.E.R.O.I.C.','H.E.R.O. Below','H.E.L.L.O. Below','H.E.R.O. Shift','H.O.L.E.','H.E.R.O. Overtime','H.E.R.O. Down Under','H.E.A.V.E.','H.E.R.O. Depth Charge','H.E.R.O. After Hours','H.E.R.O. in a Hard Hat','H.E.R.O. Minus One','H.E.R.O. Deep Trouble','H.E.R.O. Going Down','H.E.R.O. Underground Union','H.E.R.O. With Benefits','H.E.R.O. Graveyard Shift','H.E.R.O. Hot Work','H.E.R.O. Rescue Rota','H.E.R.O. Lift Off','H.E.R.O. Rock Bottom','H.E.R.O. Cave Duty','H.E.R.O. The Night Shift','H.E.R.O. Zero Visibility','H.E.R.O. Another Day','H.E.R.O. Below the Line','H.E.R.O. Short Fuse','H.E.R.O. Hazard Pay','H.E.R.O. Deep End','H.E.R.O. Downward Mobility','H.E.R.O. Oops All Caves','H.E.R.O. Unscheduled Descent','H.E.R.O. Rock and Rescue','H.E.R.O. Coal Call','H.E.R.O. Lower Management','H.E.R.O. Hold My Helmet','H.E.R.O. Rescue Receipt','H.E.R.O. Cave In Club','H.E.R.O. On the Rocks','H.E.R.O. Big Drill Energy','H.E.R.O. Last Lift','H.E.R.O. Subsurface Service','H.E.R.O. Depth Perception','H.E.R.O. Tunnel Vision','H.E.R.O. Going Underground','H.E.R.O. In Too Deep','H.E.R.O. Pressure Drop','H.E.R.O. Beneath & Beyond','H.E.R.O. All in a Day’s Work'];\nconst index=randomInt(titles.length); const title=titles[index]; const slug=title.replace(/[\"'^a-zA-Z0-9 ]/g,'\"'').replace(/ +/g,'-'); console.log(JSON.stringify({title,slug,draw:index+1,total:titles.length}));\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
