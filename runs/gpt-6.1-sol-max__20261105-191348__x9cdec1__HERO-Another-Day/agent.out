lace(\\\"p.rope.removeFromParent();this.players=\\\", \\\"p.rope.removeFromParent();p.beam.removeFromParent();this.players=\\\")\ns=s.replace(\\\"const c=p.carrying\"'!==null?this.crew[p.carrying]:null;p.rope.visible\", \"p.beam.visible=p.y<-15;p.beam.position.set(p.x,p.y+.5,-.8);p.beam.rotation.z=Math.atan2(p.aimY,p.aimX);const c=p.carrying!==null?this.crew[p.carrying]:null;p.rope.visible\")\np.write_text(s)\np=Path('\"'tests/run.py')\ns=p.read_text().replace(\\\"'--use-webgpu-adapter=swiftshader',\\\", \\\"'--use-webgpu-adapter=swiftshader','--use-angle=swiftshader','--disable-gpu-watchdog',\\\",1)\ninsert=r'''\n        def test_rooms():\n            a=context.new_page();b=context.new_page()\n            try:\n                ready(a,origin+'/'+GAME.name+'?renderer=webgl')\n                ready(b,origin+'/'+GAME.name+'?renderer=webgl')\n                a.evaluate(\\\"__game.testing.roomHost('TST234')\\\")\n                b.evaluate(\\\"__game.testing.roomJoin('TST234')\\\")\n                a.wait_for_function('__game.state().players.length===2',timeout=8000)\n                b.wait_for_function('__game.state().net.id===1',timeout=8000)\n                a.evaluate('__game.testing.roomBegin()')\n                b.wait_for_function('__game.state().phase===\\\"game\\\"',timeout=8000)\n                b.keyboard.down('KeyD');b.keyboard.down('Space');b.keyboard.down('KeyJ')\n                b.wait_for_timeout(1000)\n                b.keyboard.up('KeyD');b.keyboard.up('Space');b.keyboard.up('KeyJ')\n                ss=a.evaluate('__game.state()')\n                pp=next(p for p in ss['players'] if p['id']==1)\n                require(pp['x']>-10,'remote control did not move host-owned hero')\n                require(ss['shotsFired']>0,'remote fire not applied')\n                a.evaluate('__game.testing.position(2.3,-8.5,1)')\n                b.wait_for_timeout(350)\n                b.keyboard.press('KeyE')\n                a.wait_for_function('__game.state().charges>0',timeout=6000)\n                a.wait_for_function('__game.state().gates[0]===true',timeout=8000)\n                b.wait_for_function('__game.state().gates[0]===true',timeout=8000)\n                b.close()\n                a.wait_for_function('__game.state().players.length===1',timeout=6000)\n            finally:\n                if not b.is_closed():b.close()\n                a.close()\n        check('standalone shared-world room, remote actions and departure',test_rooms)\n        def test_touch():\n            mobile=browser.new_context(viewport={'width':932,'height':430},has_touch=True,is_mobile=True,device_scale_factor=1)\n            q=mobile.new_page();ee=[]\n            q.on('pageerror',lambda e:ee.append(str(e)))\n            try:\n                ready(q,origin+'/'+GAME.name+'?renderer=webgl')\n                q.get_by_role('button',name='Start shift',exact=True).tap()\n                q.evaluate('__game.testing.position(0,-7)')\n                session=mobile.new_cdp_session(q)\n                session.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':130,'y':300,'id':0},{'x':760,'y':280,'id':1}]})\n                session.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':177,'y':240,'id':0},{'x':815,'y':265,'id':1}]})\n                q.wait_for_timeout(650)\n                state=q.evaluate('__game.state()')\n                session.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n                require(state['input']=='touch','touch input mode missing')\n                require(state['players'][0]['fuel']<98 and state['shotsFired']>0,'multitouch did not fly and fire')\n                require(not q.locator('#touchContext').is_visible(),'context action should be hidden away from targets')\n                q.get_by_role('button',name='Pause',exact=True).tap()\n                require(q.get_by_text('Take a breather.',exact=True).is_visible(),'touch pause did not work')\n                if '--visual' in sys.argv:q.screenshot(path=str(DEV/'tests/touch-pause.png'))\n                require(not ee,str(ee))\n            finally:mobile.close()\n        check('multitouch invisible sticks and contextual controls',test_touch)\n        for players,scenario,impaired in [(2,'standard',False),(4,'standard',True),(4,'host-leave',True),(2,'server',False)]:\n            def hub_check(players=players,scenario=scenario,impaired=impaired):\n                h=context.new_page()\n                try:\n                    params={'game':'../../'+GAME.name,'players':players,'auto':1,'play':4000,'scenario':scenario}\n                    if impaired:params.update(latency=150,jitter=50,loss=5)\n                    h.goto(origin+'/'+DEV.name+'/vendor/harness.html?'+urlencode(params),wait_until='domcontentloaded')\n                    h.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=100000)\n                    report=h.evaluate('window.__hubCheck')\n                    (DEV/f'tests/hub-{players}-{scenario}.json').write_text(json.dumps(report,indent=2))\n                    require(report['pass'],str([c for c in report['checks'] if not c['pass']]))\n                    ended_frames=[f for f in h.frames[1:] if 'aihub=' in f.url]\n                    for f in ended_frames:\n                        try:\n                            require(f.evaluate('window.__game?.state().phase')=='end','round end did not freeze game')\n                        except Exception as ex:\n                            if 'detached' not in str(ex):raise\n                finally:h.close()\n            check(f'AI Hub {players} players / {scenario}'+(' / impaired network' if impaired else ''),hub_check)\n'''\ns=s.replace(\\\"        browser.close()\\\\n    print(f'{COUNT-len(FAILURES)}\\\",insert+\\\"\\\\n        browser.close()\\\\n    print(f'{COUNT-len(FAILURES)}\\\",1)\np.write_text(s)\nPY\npython3 build.py\nnpm run --silent test -- --visual\"","aggregated_output":"B