');\n        if (blink) { hud.text(x, y + 2, 'PRESS ', { color: 'white' }); drawGlyph(hud, x + 36, y, name); }\"\"\")])\npatch('src/net/round.js',[\n(\"\"\"const nm = a.glyph(act, x); const w = drawGlyph(h, cx, y, nm);\"\"\",\"\"\"const nm = a.glyph(act, x); g.ui.menu.note(act, nm, txt); const w = drawGlyph(h, cx, y, nm);\"\"\"),\n(\"\"\"    drawGlyph(h, 68, by + 6, a.glyph('confirm', x));\"\"\",\"\"\"    g.ui.menu.note('confirm', a.glyph('confirm', x), 'READY'); g.ui.menu.note(null, a.device === 'pad' ? (x ? 'Y' : 'TRIANGLE') : 'M', 'MORE TIME');\n    drawGlyph(h, 68, by + 6, a.glyph('confirm', x));\"\"\"),\n])\npatch('src/ui/ui.js',[\n(\"\"\"const s = { id: 'black', cover: true, noBack: true, hints: [], items: [],\"\"\",\"\"\"const s = { id: 'black', cover: true, noBack: true, hints: [['confirm', 'SKIP']], items: [],\"\"\"),\n(\"\"\"      draw: (hud) => { const lines = wrap(text, hud.width - 80);\"\"\",\"\"\"      draw: (hud, m, sc) => { m.footer(hud, sc); const lines = wrap(text, hud.width - 80);\"\"\"),\n(\"\"\"this.menu.push({ id: 'epigraph', cover: 'ink', noBack: true, items: [], hints: [], text: line,\"\"\",\"\"\"this.menu.push({ id: 'epigraph', cover: 'ink', noBack: true, items: [], hints: [['confirm', 'SKIP']], text: line,\"\"\"),\n(\"\"\"      draw: (hud) => { const lines = wrap(line, hud.width - 100);\"\"\",\"\"\"      draw: (hud, m, sc) => { m.footer(hud, sc); const lines = wrap(line, hud.width - 100);\"\"\"),\n])\npatch('src/game.js',[\n(\"\"\"  collectPrompts(ctx) {\n    const h = this.hud, a = this.actions;\n    h.prompts.length = 0;\"\"\",\"\"\"  collectPrompts(ctx) {\n    const h = this.hud, a = this.actions;\n    h.prompts.length = 0; this.ui.menu.noted.length = 0; drawnGlyphs.length = 0;\"\"\"),\n(\"\"\"prompts: this.hud.prompts.map((p) => ({ act: p.act, glyph: p.glyph, text: p.text })),\"\"\",\"\"\"prompts: [...this.hud.prompts.map((p) => ({ act: p.act, glyph: p.glyph, text: p.text })), ...this.ui.menu.noted], glyphsOnScreen: [...drawnGlyphs],\"\