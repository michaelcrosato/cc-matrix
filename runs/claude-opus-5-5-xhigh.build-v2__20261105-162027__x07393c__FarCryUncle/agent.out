.ok(`stock clip ${n}`, !!someone.anim.act('upper', n) && !!someone.anim.act('lower', n));\n  // The step types the plan names, and its weapon table.\"\"\")\nopen('tests/suites/static.mjs','w').write(s)\nEOF\ngrep -n \"pixel-engine.js'\" tests/suites/static.mjs | head -2 | cut -c1-220\ngrep -n \"^export const FAUNA_RIG\\|^export const PEOPLE_CLIPS\\|^import\" src/art/clips.js | cut -c1-120","description":"Lift flagged clips off the floor and add clip checks"}}}
