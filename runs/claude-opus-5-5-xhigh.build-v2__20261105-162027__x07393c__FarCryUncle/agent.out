{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkhADo7MMpq1beNYQoZc","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Rfr3NdC8qYRXjqX1p4hgic","name":"Bash","input":{"command":"set -e\npython3 - <<'EOF'\np='src/world/ground.js'; s=open(p).read()\ns=s.replace(\"\"\"    for (const p of Object.values(POSTS)) this.forRadiusCells(p.at[0], p.at[1], 12, (i, jit) => { if (kind[i] !== K.WATER && jit) kind[i] = K.DIRT; });\n\"\"\",\"\"\"    for (const p of Object.values(POSTS)) this.forRadiusCells(p.at[0], p.at[1], 12, (i, jit) => { if (kind[i] !== K.WATER && jit) kind[i] = K.DIRT; });\n    // Tanks stand in dry weeds: that is how a grass fire reaches them.\n    for (const site of Object.values(SITES)) if (site.tanks) for (const [dx, dz] of site.tanks) this.forRadiusCells(site.at[0] + dx, site.at[1] + dz, 9, (i) => { kind[i] = K.GRASS; });\n    if (SITES['east-siding']) this.forRadiusCells(SITES['east-siding'].at[0] + 8, SITES['east-siding'].at[1] - 32, 22, (i) => { kind[i] = K.GRASS; });\n\"\"\")\nopen(p,'w').write(s)\np='src/world/world.js'; s=open(p).read()\ns=s.replace(\"const DYNAMIC = new Set(['boom-gate', 'post-cage', 'fuel-tank', 'oil-drum', 'table-lamp']);\",\"const DYNAMIC = new Set(['boom-gate', 'post-cage', 'fuel-tank', 'oil-drum', 'table-lamp', 'bunker']);\")\ns=s.replace(\"\"\"export const EXPLOSIVE = { 'oil-drum': { radius: 4, damage: 90, hp: 30, fire: 5 }, 'fuel-tank': { radius: 13, damage: 300, hp: 80, fire: 14 } };\"\"\",\"\"\"export const EXPLOSIVE = { 'oil-drum': { radius: 4, damage: 90, hp: 30, fire: 5 }, 'fuel-tank': { radius: 13, damage: 300, hp: 80, fire: 14 }, bunker: { radius: 12, damage: 260, hp: 160, fire: 12 } };\"\"\")\ns=s.replace(\"\"\"      if (EXPLOSIVE[id]) this.addExplosive(id, e);\n\"\"\",\"\"\"      if (EXPLOSIVE[id]) { const ex = this.addExplosive(id, e); if (id === 'bunker') { ex.tag = 'ammo-bunker'; this.game.fire.setFuel(x, z, F.BUILDING); } else this.game.fire.setFuel(x, z, F.BUILDING); }\n\"\"\")\ns=s.replace(\"\"\"        this.addDynamic(ctx, e); this.addExplosive('fuel-tank', e, 'fuel-tank');\n\"\"\",\"\"\"        this.addDynamic(ctx, e); this.addExplosive('fuel-tank', e, 'fuel-tank'); this.game.fire.setFuel(e.x, e.z, F.BUILDING);\n\"\"\")\ns=s.replace(\"\"\"      const [dx, dz] = local(5.5, 0); const drum = this.place('oil-drum', dx, dz, 0, { list: [] }); this.addDynamic(ctx, drum); this.addExplosive('oil-drum', drum);\n\"\"\",\"\"\"      const [dx, dz] = local(5.5, 0); const drum = this.place('oil-drum', dx, dz, 0, { list: [] }); this.addDynamic(ctx, drum); this.addExplosive('oil-drum', drum);\n      this.game.fire.setFuel(dx, dz, F.BUILDING);\n\"\"\")\ns=s.replace(\"\"\"  /** Back to the map as drawn: no fire, no scars, tanks whole. */\"\"\",\"\"\"  /** The deck of a bridge has a wood floor underfoot. */\n  onDeck(f) { for (const b of Object.values(this.bridges)) if (Math.hypot(f.x - b.x, f.z - b.z) < 15 && f.y > RIVER_Y + 1.2) return true; return false; }\n  /** Back to the map as drawn: no fire, no scars, tanks whole. */\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/missions/story.js <<'EOF'\n// What the campaign remembers.\nexport const makeStory = () => ({\n  stones: 0, pass: null, truce: true, war: false, feverRunning: false, flags: {}, trigsDone: new Set(), casesDone: new Set(), halts: new Set(), unlocked: new Set(['m38', 'cane']), safehouses: new Set(), odileRefuses: false, runsDone: 0, act: 1, trackerOwned: false, stonesEarned: 0, stockInLockers: false, smokeUntil: 0, noPatrols: false, ending: null,\n  chose: {}, holdFireFaction: null, sheet: null,\n});\nexport const storyToJson = (s) => ({ ...s, trigsDone: [...s.trigsDone], casesDone: [...s.casesDone], halts: [...s.halts], unlocked: [...s.unlocked], safehouses: [...s.safehouses] });\nexport const storyFromJson = (j) => ({ ...makeStory(), ...j, trigsDone: new Set(j.trigsDone), casesDone: new Set(j.casesDone), halts: new Set(j.halts), unlocked: new Set(j.unlocked), safehouses: new Set(j.safehouses) });\nEOF\ncat > src/missions/ledger.js <<'EOF'\n// The Ledger: five big lines, written as Harrow would write it.\nexport class Ledger {\n  v = { moved: 0, paid: 0, friends: 0, stones: 0, cells: 0 }; notes = [];\n  constructor(game) { this.game = game; }\n  reset() { this.v = { moved: 0, paid: 0, friends: 0, stones: 0, cells: 0 }; this.notes = []; }\n  add(k, n) { this.v[k] = (this.v[k] ?? 0) + n; }\n  note(kind, a, b) { this.notes.push([kind, a, b]); }\n  hectares() { return Math.round(this.game.fire.counts.burnt * 0.25 * 10) / 10; }\n  lines() {\n    const v = this.v;\n    return [\n      { big: `${this.hectares()} HECTARES`, small: 'BURNED, BY MY COUNT. THE GREEN COMES BACK FASTER THAN THE PEOPLE.' },\n      { big: `${v.moved} PEOPLE`, small: 'MOVED OFF THEIR LAND. THE SHEET SHOWS WHERE THEY WERE.' },\n      { big: `${v.paid} MEN`, small: 'YOU WERE PAID TO KILL. THE INVOICES AGREE.' },\n      { big: `${v.friends} FRIENDS`, small: 'LOST. THESE ARE NOT ON ANY SHEET.' },\n      { big: `${v.stones} STONES`, small: 'EARNED. ROUGH. NOTHING HERE IS CUT.' },\n    ];\n  }\n  toJson() { return { v: this.v, notes: this.notes }; }\n  fromJson(j) { this.v = j.v; this.notes = j.notes; }\n}\nEOF\ncat > src/actors/npc.js <<'EOF'\n// People who stand where they stand: the givers, Tibor, Bakr, buddies at the bar.\nimport { makePerson } from './rig.js';\nimport { SITES } from '../content/sites.js';\nconst IDLE = { odile: 'SmokeIdle', tibor: 'Shrug', bakr: 'Idle', vance: 'CleanRifleIdle', ansa: 'TeachPoint', harrow: 'WriteAtDesk', ines: 'Idle', dov: 'Idle', mags: 'Idle' };\nexport class Npc {\n  active = true;\n  constructor(game, who, x, z, yaw) { this.game = game; this.who = who; this.x = x; this.z = z; this.yaw = yaw; this.y = game.world.heightAt(x, z); }\n  build(ctx) {\n    const g = this.game;\n    if (!g.views) return;\n    const p = makePerson(this.who);\n    this.view = p;\n    p.object.position.set(this.x, this.y, this.z);\n    p.object.rotation.y = (this.yaw * Math.PI) / 180;\n    ctx.scene.add(p.object);\n    p.anim.set(IDLE[this.who] ?? 'Idle');\n    p.anim.mixer.update(Math.random === 0 ? 0 : 0.01);\n  }\n  place(x, z, yawDeg) { this.x = x; this.z = z; this.y = this.game.world.heightAt(x, z); if (this.view) { this.view.object.position.set(x, this.y, z); if (yawDeg != null) this.view.object.rotation.y = (yawDeg * Math.PI) / 180; } }\n  setActive(v) { this.active = v; if (this.view) this.view.object.visible = v; }\n  play(name) { this.view?.anim.set(name); }\n  head() { return [this.x, this.y + 1.55, this.z]; }\n  update(ctx, dt) {\n    if (!this.active || !this.view) return;\n    const cam = this.game.camPos;\n    if (Math.hypot(this.x - cam.x, this.z - cam.z) < 90) this.view.anim.update(dt);\n  }\n}\nexport class Npcs {\n  byWho = {};\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game;\n    for (const site of Object.values(SITES)) {\n      for (const n of site.npcs ?? []) {\n        const npc = new Npc(g, n.who, site.at[0] + n.dx, site.at[1] + n.dz, n.yaw);\n        npc.build(ctx);\n        npc.siteKey = site.key;\n        this.byWho[n.who] = npc;\n      }\n    }\n    // Buddies at the bar, when you have met them.\n    const bar = SITES['mile-forty'];\n    [['ines', -26, -30, 20], ['dov', -18, -29, -20], ['mags', -38, -2, 80]].forEach(([who, dx, dz, yaw]) => {\n      const npc = new Npc(g, who, bar.at[0] + dx, bar.at[1] + dz, yaw);\n      npc.build(ctx);\n      npc.setActive(false);\n      this.byWho[who] = npc;\n    });\n  }\n  update(ctx, dt) { for (const n of Object.values(this.byWho)) n.update(ctx, dt); }\n  /** Who is around right now follows the story. */\n  sync() {\n    const g = this.game;\n    for (const id of ['ines', 'dov', 'mags']) {\n      const b = g.actors.buddy(id), n = this.byWho[id];\n      n.setActive(!!b && b.met && !b.dead && !b.active && g.clock.abs >= b.woundedUntil);\n    }\n    if (this.byWho.harrow) this.byWho.harrow.setActive(!g.story.flags.harrowDead);\n    const truceBroke = !g.story.truce;\n    this.byWho.tibor.setActive(!truceBroke);\n  }\n}\nEOF\ncat > src/content/missions.js <<'EOF'\n// Contracts as data. Step types are in missions/steps.js. Scripts are named coroutines in missions/scripts.js.\n// `ops` are applied in order when a mission completes, and quietly when dev mode jumps past it.\nexport const MISSION_ORDER = ['m0', 'm1', 'm2', 'm3', 'm4', 'm5', 'm6', 'm7', 'm8', 'm9', 'end'];\nexport const MISSIONS = {\n  m0: { id: 'm0', title: 'THE GOODS LINE', giver: null, requires: [], auto: true, act: 1, steps: [{ do: 'script', name: 'm0', text: 'RIDE IN. LOOK AT THE MAP.' }], next: 'm1', ops: [{ flag: 'arrived' }] },\n  m1: { id: 'm1', title: 'MERCY RUN', giver: 'odile', requires: ['m0'], auto: true, act: 1, pay: 5, steps: [\n    { do: 'script', name: 'm1Wake', text: 'TAKE THE TABLET' },\n    { do: 'talk', who: 'odile', lines: 'm1.brief', text: 'HEAR HER OUT' },\n    { do: 'script', name: 'm1Gear', text: 'THE TRUCK IS OUTSIDE' },\n    { do: 'enter', tag: 'm1-truck', text: 'GET IN THE TRUCK' },\n    { do: 'goto', site: 'three-wells', r: 34, text: 'DRIVE THE MEDICINE TO THREE WELLS' },\n    { do: 'use', id: 'wells-drop', site: 'three-wells', dx: 3, dz: 4, y: 1, verb: 'LEAVE THE MEDICINE', text: 'LEAVE THE CRATE BY THE WELL' },\n    { do: 'goto', at: [-200, 30], r: 62, text: 'BACK TO MILE FORTY. THE ROAD GOES BY P2.' },\n    { do: 'script', name: 'm1Ambush', text: 'THEY HAVE MANNED P2' },\n    { do: 'goto', site: 'mile-forty', r: 50, text: 'BACK TO THE CLINIC' },\n    { do: 'report', to: 'odile', lines: 'm1.done', text: 'REPORT TO ODILE' },\n  ], ops: [{ tablets: 3 }, { safehouse: 'pump-shed' }, { meet: 'mags' }, { mapSee: 'pump-shed' }, { mapSee: 'ranger-post' }, { mapSee: 'three-wells' }], next: null },\n  m2: { id: 'm2', title: 'A CAGE AT THE POST', giver: 'tibor', requires: ['m1'], act: 1, pay: 8, brief: 'm2.brief', steps: [\n    { do: 'goto', site: 'ranger-post', r: 130, text: 'SCOUT THE RANGER POST. BEST AT NIGHT.', hint: 'mono' },\n    { do: 'use', id: 'cage', site: 'ranger-post', dx: 12, dz: 9.6, y: 1, hold: 3, verb: 'OPEN THE CAGE', text: 'OPEN THE CAGE' },\n    { do: 'script', name: 'm2Free', text: 'SHE IS OUT' },\n    { do: 'kill', squad: 'ranger-post', text: 'CLEAR THE POST' },\n    { do: 'report', to: 'tibor', lines: 'm2.done', text: 'BACK TO TIBOR' },\n  ], ops: [{ meet: 'ines' }, { meet: 'dov' }, { safehouse: 'ranger-post' }, { act: 2 }, { mapSee: 'fort-clement' }, { mapSee: 'granary' }, { unlock: 'tractor' }, { notice: 'THE COLONEL AND THE MOTHER BOTH WANT A WORD. BOTH OF THEM PAY.' }] },\n  m3: { id: 'm3', title: 'FUEL FOR THE PEACE', giver: 'vance', requires: ['m2'], act: 2, pay: 15, pass: 'concord', wind: { dir: [0.3, 0.95], speed: 5 }, brief: 'm3.brief', give: { guns: ['flare'] },\n    alt: { buddy: 'ines', call: 'm3.alt', bonus: 5, at: 0, steps: [{ do: 'script', name: 'm3Tanker', text: 'TAKE THE TANKER AT P3' }] },\n    steps: [\n      { do: 'goto', site: 'east-siding', r: 140, text: 'REACH THE SIDING. THE WIND WILL CARRY IT.' },\n      { do: 'destroy', tag: 'fuel-tank', n: 3, text: 'BURN THE TANKS' },\n      { do: 'leave', site: 'east-siding', r: 200, text: 'GET OUT' },\n      { do: 'report', to: 'vance', lines: 'm3.done', text: 'REPORT TO VANCE' },\n    ], ops: [{ burnStrip: 'A' }, { flag: 'scarA' }, { smoke: [430, -60] }, { mapSee: 'east-siding' }] },\n  m4: { id: 'm4', title: 'SEED MONEY', giver: 'ansa', requires: ['m2'], act: 2, pay: 20, pass: 'harvest', brief: 'm4.brief',\n    alt: { buddy: 'dov', call: 'm4.alt', bonus: 5, at: 0, steps: [{ do: 'script', name: 'm4Dov', text: 'PLANT DOV\\'S CHARGES ON THE BRIDGE' }] },\n    steps: [\n      { do: 'script', name: 'm4Convoy', text: 'THE PAYROLL CROSSES THE SALT PAN' },\n      { do: 'destroy', tag: 'payroll', n: 1, text: 'STOP THE CONVOY. BLOW THE TRUCK.' },\n      { do: 'script', name: 'm4Case', text: 'FIND THE CASE WITH THE TRACKER' },\n      { do: 'collect', id: 'payroll-case', text: 'THE CASE IS IN THE SALT. HOLD THE TRACKER UP.' },\n      { do: 'report', to: 'ansa', lines: 'm4.done', text: 'REPORT TO ANSA' },\n    ], ops: [{ flag: 'tracker' }, { mapSee: 'salt-pan' }] },\n  m5: { id: 'm5', title: 'THE WATER QUESTION', giver: 'vance', requires: ['m3'], act: 2, pay: 20, pass: 'concord', brief: 'm5.brief', give: { charges: 2 },\n    alt: { buddy: 'mags', call: 'm5.alt', bonus: 0, payOverride: 10, at: 1, steps: [\n      { do: 'use', id: 'bypass', site: 'pump-station', dx: 1.6, dz: 0, y: 1.2, hold: 2, verb: 'OPEN THE BYPASS', text: 'OPEN THE BYPASS VALVE' },\n      { do: 'script', name: 'm5Hold', text: 'HOLD THE PUMP HOUSE' },\n    ] },\n    steps: [\n      { do: 'goto', site: 'pump-station', r: 60, text: 'REACH THE PUMP ON THE MERCY' },\n      { do: 'blast', site: 'pump-station', r: 12, text: 'PLANT A CHARGE ON THE PUMP. HOLD THROW.' },\n      { do: 'leave', site: 'pump-station', r: 120, text: 'LEAVE IT' },\n      { do: 'report', to: 'vance', lines: null, text: 'REPORT TO VANCE' },\n    ], onDoneScript: 'm5After', ops: [{ mapSee: 'pump-station' }] },\n  m6: { id: 'm6', title: 'THE LONG FIELD', giver: 'ansa', requires: ['m4'], act: 2, pay: 25, pass: 'harvest', hour: 21.5, wind: { dir: [0.9, 0.2], speed: 4 }, brief: 'm6.brief', steps: [\n    { do: 'script', name: 'm6Buddy', text: 'TAKE SOMEONE' },\n    { do: 'goto', site: 'long-field', r: 120, text: 'REACH THE LONG FIELD' },\n    { do: 'script', name: 'm6Burn', text: 'BURN THE CROP' },\n    { do: 'destroy', tag: 'ammo-bunker', n: 1, text: 'BLOW THE BUNKER' },\n    { do: 'leave', site: 'long-field', r: 190, text: 'GET OUT' },\n    { do: 'report', to: 'ansa', lines: 'm6.done', text: 'REPORT TO ANSA' },\n  ], ops: [{ burnStrip: 'B' }, { flag: 'scarB' }, { mapSee: 'long-field' }] },\n  m7: { id: 'm7', title: 'THE CUT', giver: 'note', requires: ['m3', 'm4', 'm5', 'm6'], act: 3, pay: 15, brief: 'm7.note',\n    alt: { buddy: 'any', call: 'm7.alt', bonus: 0, at: 0, steps: [{ do: 'script', name: 'm7Road', text: 'THEY HOLD THE EAST ROAD. GO IN BY THE PIT.' }] },\n    steps: [\n      { do: 'script', name: 'm7War', text: 'THE TRUCE IS OVER' },\n      { do: 'goto', site: 'the-cut', r: 90, text: 'REACH THE CUT' },\n      { do: 'use', id: 'ledger-book', site: 'the-cut', dx: 60, dz: -39.4, y: 1, verb: 'TAKE HIS LEDGER', text: 'THE SLUICE HOUSE. TAKE HIS LEDGER.' },\n      { do: 'script', name: 'm7Read', text: 'READ IT' },\n      { do: 'leave', site: 'the-cut', r: 230, text: 'GET OUT OF THE MINE' },\n    ], ops: [{ burnStrip: 'C' }, { flag: 'scarC' }, { truce: false }, { stock: true }, { act: 3 }, { mapSee: 'the-cut' }, { mapSee: 'observatory' }, { script: 'm7After' }] },\n  m8: { id: 'm8', title: 'LAST TRAIN', giver: 'odile', requires: ['m7'], act: 3, pay: 10, brief: 'm8.brief', steps: [\n    { do: 'script', name: 'm8Hold', text: 'HOLD THE PLATFORM WHILE THEY BOARD' },\n    { do: 'script', name: 'm8Ride', text: 'THE FLATCAR GUN. KEEP THEM OFF THE TRAIN.' },\n  ], ops: [{ flag: 'column' }, { moved: 600 }, { mapSee: 'the-pass' }, { script: 'm8After' }] },\n  m9: { id: 'm9', title: 'THE SURVEYOR', giver: 'note', requires: ['m8'], act: 3, pay: 0, hour: 23, weather: 'storm', steps: [\n    { do: 'goto', site: 'observatory', r: 46, text: 'CLIMB TO THE OBSERVATORY' },\n    { do: 'use', id: 'harrow-table', site: 'observatory', dx: 0, dz: 3.6, y: 1.2, verb: 'SIT DOWN', text: 'HE IS AT THE TABLE' },\n    { do: 'script', name: 'm9Scene', text: 'THE SURVEYOR' },\n  ], next: 'end', ops: [] },\n  end: { id: 'end', title: 'THE PASS', giver: null, requires: ['m9'], auto: true, act: 3, pay: 0, hour: 4.6, steps: [{ do: 'script', name: 'endPass', text: 'THE PASS' }], ops: [] },\n  mr1: { id: 'mr1', side: true, title: 'A CRATE FOR THE WEST CUTTING', giver: 'odile', requires: ['m1'], pay: 0, brief: 'odile.run', timer: 300, carry: true, steps: [{ do: 'goto', at: [-296, 96], r: 14, text: 'CARRY THE CRATE TO THE WEST CUTTING' }, { do: 'use', id: 'drop-mr1', at: [-296, 96], y: 1, verb: 'LEAVE THE CRATE', text: 'LEAVE THE CRATE' }], ops: [{ mercy: true }] },\n  mr2: { id: 'mr2', side: true, title: 'A CRATE FOR THE BACK ROAD', giver: 'odile', requires: ['m1'], pay: 0, brief: 'odile.run', timer: 300, carry: true, steps: [{ do: 'goto', at: [120, 110], r: 14, text: 'CARRY THE CRATE TO THE BOTTLE TREE' }, { do: 'use', id: 'drop-mr2', at: [120, 110], y: 1, verb: 'LEAVE THE CRATE', text: 'LEAVE THE CRATE' }], ops: [{ mercy: true }] },\n  mr3: { id: 'mr3', side: true, title: 'A CRATE FOR THE FORD', giver: 'odile', requires: ['m1'], pay: 0, brief: 'odile.run', timer: 300, carry: true, steps: [{ do: 'goto', at: [-68, 340], r: 14, text: 'CARRY THE CRATE OVER THE FORD' }, { do: 'use', id: 'drop-mr3', at: [-68, 340], y: 1, verb: 'LEAVE THE CRATE', text: 'LEAVE THE CRATE' }], ops: [{ mercy: true }] },\n};\nexport const GIVER_LINES = { odile: 'odile.idle', tibor: 'tibor.idle', vance: 'vance.idle', ansa: 'ansa.idle', bakr: 'bakr.idle', ines: 'ines.idle', dov: 'dov.idle', mags: 'mags.idle' };\nEOF\ncat > src/missions/steps.js <<'EOF'\n// Step types. A step shows its text at the top for 5 s when it starts, and always in the map margin. Bots drive these same steps.\nimport { SITES, POSTS } from '../content/sites.js';\nconst siteAt = (s) => (s.site ? SITES[s.site].at : s.at);\nconst dist = (g, a) => { const f = g.hasPlayer ? g.player.feet : { x: 0, z: 0 }; return Math.hypot(f.x - a[0], f.z - a[1]); };\nconst seatDist = (g, a) => { const v = g.driving.vehicle; const f = v ?? g.player.feet; return Math.hypot(f.x - a[0], f.z - a[1]); };\nexport const STEPS = {\n  goto: {\n    enter(r, s, g) { const a = siteAt(s); g.map.setWaypoint(a[0], a[1]); if (s.site) g.map.see(s.site); },\n    tick(r, s, g) { return seatDist(g, siteAt(s)) <= s.r; },\n  },\n  leave: {\n    enter(r, s, g) {},\n    tick(r, s, g) { return seatDist(g, siteAt(s)) >= s.r; },\n  },\n  talk: {\n    enter(r, s, g) { const n = g.npcs.byWho[s.who]; if (n) g.map.setWaypoint(n.x, n.z); s._state = 'wait'; g.player.frozen = false; g.dialogue.play(s.lines, { onEnd: () => { s._state = 'done'; } }); g.faceNpc(n); },\n    tick(r, s, g) { return s._state === 'done'; },\n    exit(r, s, g) { g.faceNpc(null); },\n  },\n  report: {\n    enter(r, s, g) {\n      const n = g.npcs.byWho[s.to];\n      s._state = 'go';\n      if (n) {\n        g.map.setWaypoint(n.x, n.z);\n        s._u = g.interact.add({ tag: 'mission', x: n.x, y: n.y + 1.5, z: n.z, r: 3.4, wide: true, verb: () => `REPORT TO ${s.to.toUpperCase()}`, onUse: () => {\n          g.interact.remove(s._u); s._u = null; s._state = 'talking'; g.faceNpc(n);\n          if (s.lines) g.dialogue.play(s.lines, { onEnd: () => { s._state = 'done'; } });\n          else s._state = 'done';\n        } });\n      } else s._state = 'done';\n    },\n    tick(r, s, g) { return s._state === 'done'; },\n    exit(r, s, g) { if (s._u) g.interact.remove(s._u); g.faceNpc(null); },\n  },\n  use: {\n    enter(r, s, g) {\n      const a = siteAt(s), x = a[0] + (s.dx ?? 0), z = a[1] + (s.dz ?? 0);\n      g.map.setWaypoint(x, z);\n      s._done = false;\n      s._u = g.interact.add({ tag: 'mission', id: s.id, x, y: g.world.heightAt(x, z) + (s.y ?? 1), z, r: s.reach ?? 2.8, wide: true, hold: s.hold, verb: () => s.verb, onStart: () => { g.vm.showProp(); g.vm.play('Open', { keep: true }); }, onCancel: () => { g.vm.endAction(); g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); }, onUse: () => { if (s.hold) { g.vm.endAction(); g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); } s._done = true; g.events.emit('step-used', s.id); } });\n    },\n    tick(r, s) { return s._done; },\n    exit(r, s, g) { if (s._u) g.interact.remove(s._u); },\n  },\n  deliver: { enter(r, s, g) { STEPS.goto.enter(r, s, g); }, tick(r, s, g) { return dist(g, siteAt(s)) <= s.r; } },\n  enter: {\n    enter(r, s, g) { const v = r.tags[s.tag]; if (v) g.map.setWaypoint(v.x, v.z); },\n    tick(r, s, g) { return g.driving.vehicle && g.driving.vehicle === r.tags[s.tag]; },\n  },\n  destroy: {\n    enter(r, s, g) { s._n = 0; for (const ex of g.world.explosives) if (ex.tag === s.tag && !ex.alive) s._n++; s._off = g.events.on('destroyed', (tag) => { if (tag === s.tag) s._n++; }); const t = g.world.explosives.find((e) => e.tag === s.tag); if (t) g.map.setWaypoint(t.x, t.z); },\n    tick(r, s) { return s._n >= s.n; },\n    exit(r, s) { s._off?.(); },\n  },\n  blast: {\n    enter(r, s, g) { const a = siteAt(s); s._hit = false; g.map.setWaypoint(a[0], a[1]); s._off = g.events.on('blast', (x, z) => { if (Math.hypot(x - a[0], z - a[1]) < s.r) s._hit = true; }); },\n    tick(r, s) { return s._hit; },\n    exit(r, s) { s._off?.(); },\n  },\n  kill: {\n    enter(r, s, g) { const sq = g.actors.squads.get(s.squad); if (sq) { sq.forceLive = true; g.map.setWaypoint(sq.def.at[0], sq.def.at[1]); } },\n    tick(r, s, g) { const sq = g.actors.squads.get(s.squad); return !sq || sq.alive <= (s.left ?? 0); },\n    exit(r, s, g) { const sq = g.actors.squads.get(s.squad); if (sq) sq.forceLive = false; },\n  },\n  collect: {\n    enter(r, s, g) { s._got = false; s._off = g.events.on('collected', (id) => { if (id === s.id) s._got = true; }); },\n    tick(r, s) { return s._got; },\n    exit(r, s) { s._off?.(); },\n  },\n  hold: { enter(r, s, g) { s._t = s.seconds; const a = siteAt(s); g.map.setWaypoint(a[0], a[1]); }, tick(r, s, g, dt) { if (seatDist(g, siteAt(s)) <= s.r) s._t -= dt; return s._t <= 0; } },\n  timer: { enter(r, s) { s._t = s.seconds; }, tick(r, s, g, dt) { s._t -= dt; return s._t <= 0; } },\n  choice: {\n    enter(r, s, g) { s._picked = null; g.ui.choice(s.prompt, s.options.map((o) => ({ label: o.label, onSelect: () => { s._picked = o.id; g.story.chose[s.key] = o.id; o.run?.(g); } }))); },\n    tick(r, s) { return s._picked != null; },\n  },\n  script: {\n    enter(r, s, g) { s._gen = r.scripts[s.name](g, r, s); s._wait = 0; s._done = false; s._pred = null; },\n    tick(r, s, g, dt) {\n      if (s._pred) { if (!s._pred()) return false; s._pred = null; }\n      if (s._wait > 0) { s._wait -= dt; if (s._wait > 0) return false; }\n      const { value, done } = s._gen.next();\n      if (done) return true;\n      if (typeof value === 'number') s._wait = value;\n      else if (typeof value === 'function') s._pred = value;\n      return false;\n    },\n    exit(r, s) { s._gen = null; },\n  },\n};\nexport const STEP_NAMES = Object.keys(STEPS);\nEOF\ncat > src/missions/runner.js <<'EOF'\n// Runs one contract at a time, offers others, pays, saves. Data in content/missions.js.\nimport { TUNING } from '../core/tuning.js';\nimport { MISSIONS, MISSION_ORDER } from '../content/missions.js';\nimport { SITES } from '../content/sites.js';\nimport { STRIPS } from '../content/roads.js';\nimport { LINES } from '../content/dialogue.js';\nimport { STEPS } from './steps.js';\nimport { makeScripts } from './scripts.js';\nimport { WEAPONS } from '../content/weapons.js';\nexport class MissionRunner {\n  active = null; stepI = 0; done = new Set(); stepsNow = []; tags = {}; altTaken = false; timer = 0; pendingOffer = null; timerFailed = false;\n  constructor(game) { this.game = game; this.scripts = makeScripts(); }\n  reset() { this.abort(); this.done.clear(); this.tags = {}; this.altTaken = false; }\n  isDone(id) { return this.done.has(id); }\n  canStart(m) {\n    if (this.done.has(m.id) && !m.side) return false;\n    if (m.side && this.done.has(m.id)) return false;\n    return m.requires.every((r) => this.done.has(r));\n  }\n  available(giver) { return Object.values(MISSIONS).filter((m) => !m.auto && this.canStart(m) && (giver == null || m.giver === giver)); }\n  /** A short FP scene: the camera holds on the giver, subtitles, then Accept or Not Yet. */\n  offer(m, npc) {\n    const g = this.game;\n    if (this.active) return;\n    const after = () => {\n      g.faceNpc(null);\n      g.ui.choice(m.title, [{ label: 'ACCEPT', id: 'accept', onSelect: () => this.start(m.id) }, { label: 'NOT YET', id: 'notyet', onSelect: () => {} }]);\n    };\n    if (npc) g.faceNpc(npc);\n    if (m.brief && LINES[m.brief]?.length) g.dialogue.play(m.brief, { onEnd: after });\n    else after();\n  }\n  start(id) {\n    const g = this.game, m = MISSIONS[id];\n    this.active = m;\n    this.stepI = 0;\n    this.altTaken = false;\n    this.altOffered = false;\n    this.stepsNow = m.steps.map((s) => ({ ...s }));\n    this.timer = m.timer ?? 0; this.timerFailed = false;\n    if (m.pass) g.story.pass = m.pass;\n    if (m.wind) g.wind.pin(m.wind.dir, m.wind.speed);\n    if (m.hour != null) g.clock.set(m.hour);\n    if (m.weather) g.sky.setWeather(m.weather);\n    if (m.give?.guns) for (const w of m.give.guns) { if (!g.weapons.slots[WEAPONS[w].slot] || WEAPONS[w].slot !== 'sidearm') g.weapons.give(w, 100); else g.weapons.give(w, 100, false); g.story.unlocked.add(w); }\n    if (m.give?.charges) g.weapons.charges = Math.max(g.weapons.charges, m.give.charges);\n    if (m.carry) g.notice('A CRATE ON YOUR SHOULDER', 3);\n    // Dov's perk: 2 free charges per mission.\n    const dov = g.actors.buddy('dov');\n    if (dov?.met && !dov.dead && !m.side) g.weapons.charges = Math.max(g.weapons.charges, 2);\n    g.events.emit('mission-start', id);\n    this.enterStep();\n    this.checkAlt();\n  }\n  checkAlt() {\n    const g = this.game, m = this.active;\n    if (!m?.alt || this.altOffered) return;\n    if (this.stepI !== m.alt.at) return;\n    const buddy = this.altBuddy(m);\n    this.altOffered = true;\n    if (!buddy) return; // Write their missions so the alternate plan just doesn't arrive.\n    g.after(8, () => {\n      if (this.active !== m) return;\n      g.sfx.play('radio-squelch');\n      const lines = m.id === 'm7' ? [['', 'THE RADIO GIVES A SHORT CRACK.'], [buddy.id, `${buddy.name}. WE WILL HOLD THE EAST ROAD. YOU GO IN BY THE PIT.`]] : m.alt.call;\n      g.dialogue.play(lines, { onEnd: () => {\n        if (this.active !== m) return;\n        g.ui.choice('A BETTER PLAN', [\n          { label: 'DO IT THEIR WAY', id: 'alt', onSelect: () => this.takeAlt(buddy) },\n          { label: 'IGNORE IT', id: 'ignore', onSelect: () => {} },\n        ], { overlay: true });\n      } });\n    });\n  }\n  altBuddy(m) {\n    const g = this.game, a = m.alt;\n    if (a.buddy === 'any') return g.actors.buddies.find((b) => b.met && !b.dead && g.clock.abs >= b.woundedUntil) ?? null;\n    const b = g.actors.buddy(a.buddy);\n    return b && b.met && !b.dead && g.clock.abs >= b.woundedUntil ? b : null;\n  }\n  takeAlt(buddy) {\n    const g = this.game, m = this.active;\n    this.altTaken = true;\n    this.altBuddyNow = buddy;\n    buddy.trust++;\n    const at = Math.max(this.stepI, m.alt.at);\n    const inserted = m.alt.steps.map((s) => ({ ...s }));\n    if (this.stepI === at) { this.exitStep(); this.stepsNow.splice(at, 0, ...inserted); this.enterStep(); }\n    else this.stepsNow.splice(at, 0, ...inserted);\n    if (m.id !== 'm7') {\n      const f = g.player.feet;\n      buddy.spawn(g.ctx, f.x + 3, f.z + 3, { hp: 200 });\n    }\n    g.events.emit('alt-taken', m.id, buddy.id);\n  }\n  currentStep() { return this.active ? this.stepsNow[this.stepI] : null; }\n  enterStep() {\n    const g = this.game, s = this.currentStep();\n    if (!s) { this.complete(); return; }\n    STEPS[s.do].enter(this, s, g);\n    if (s.text) g.stepBanner(s.text);\n    g.map.setMargin([this.active.title, '', s.text ?? '']);\n    g.events.emit('step', this.active.id, this.stepI, s.do);\n  }\n  exitStep() { const s = this.currentStep(); if (s) STEPS[s.do].exit?.(this, s, this.game); }\n  /** Dev mode's \"complete current step\". */\n  forceStep() { if (this.active) { this.exitStep(); this.stepI++; this.afterAdvance(); } }\n  afterAdvance() {\n    if (!this.active) return;\n    if (this.stepI >= this.stepsNow.length) this.complete();\n    else { this.enterStep(); this.checkAlt(); }\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, m = this.active;\n    if (!m) return;\n    if (m.timer) {\n      this.timer -= dt;\n      if (this.timer <= 0) { this.failSide(); return; }\n    }\n    const s = this.currentStep();\n    if (!s) return;\n    if (STEPS[s.do].tick(this, s, g, dt)) {\n      STEPS[s.do].exit?.(this, s, g);\n      this.stepI++;\n      this.afterAdvance();\n    }\n  }\n  failSide() {\n    const g = this.game, m = this.active;\n    this.exitStep();\n    this.active = null;\n    g.map.setWaypoint(null);\n    g.map.setMargin([]);\n    // Fail and she says nothing, which is worse.\n    g.stepBanner('TOO LATE');\n    g.story.flags.lateCount = (g.story.flags.lateCount ?? 0) + 1;\n    g.events.emit('mission-failed', m.id);\n    g.interact.clearTagged('mission');\n  }\n  applyOps(ops, quiet) {\n    const g = this.game, st = g.story;\n    for (const o of ops ?? []) {\n      if (o.burnStrip) g.fire.burnStrip(STRIPS[o.burnStrip].pts, STRIPS[o.burnStrip].width);\n      if (o.flag) st.flags[o.flag] = true;\n      if (o.smoke) st.smokeUntil = g.clock.abs + 24, st.smokeAt = o.smoke;\n      if (o.mapSee) g.map.see(o.mapSee);\n      if (o.tablets != null) g.body.tablets += o.tablets;\n      if (o.safehouse) st.safehouses.add(o.safehouse);\n      if (o.meet) { const b = g.actors.buddy(o.meet); if (b) b.met = true; }\n      if (o.act) { st.act = o.act; g.body.feverAct = o.act; }\n      if (o.unlock) st.unlocked.add(o.unlock);\n      if (o.truce === false) { st.truce = false; st.war = true; }\n      if (o.stock) st.stockInLockers = true;\n      if (o.moved) g.ledger.add('moved', o.moved);\n      if (o.notice && !quiet) g.notice(o.notice, 5);\n      if (o.script && this.scripts[o.script]) { const gen = this.scripts[o.script](g, this, null); let r = gen.next(); while (!r.done) r = gen.next(); }\n      if (o.mercy) {\n        st.runsDone++;\n        if (st.odileRefuses) { st.odileRefuses = false; if (!quiet) g.notice('NOTHING. SHE LOOKS AT YOU. NOTHING.', 4); }\n        else { g.body.tablets += 4; if (!quiet) { g.say('odile', 'FOUR. COUNT THEM. I DID.', 3); g.sfx.play('tablet-bottle'); } }\n      }\n    }\n    g.npcs.sync();\n  }\n  pay(n) {\n    const g = this.game;\n    const a = Math.round(n * TUNING.stonesReward);\n    if (a <= 0) return 0;\n    g.story.stones += a;\n    g.ledger.add('stones', a);\n    return a;\n  }\n  complete() {\n    const g = this.game, m = this.active;\n    if (!m) return;\n    this.exitStep();\n    this.active = null;\n    this.done.add(m.id);\n    g.interact.clearTagged('mission');\n    g.map.setWaypoint(null);\n    g.map.setMargin([]);\n    if (m.wind) g.wind.unpin();\n    let pay = m.pay ?? 0;\n    if (this.altTaken && m.alt?.payOverride != null) pay = m.alt.payOverride;\n    if (this.altTaken && m.alt?.bonus) pay += m.alt.bonus;\n    const paid = this.pay(pay);\n    if (paid > 0) { g.stepBanner(`${m.title}: ${paid} STONES`); g.sfx.play('ui-stone'); }\n    else if (!m.side) g.stepBanner(`${m.title}: DONE`);\n    this.applyOps(m.ops);\n    if (m.onDoneScript) { const gen = this.scripts[m.onDoneScript](g, this, null); let r = gen.next(); while (!r.done) r = gen.next(); }\n    if (this.altBuddyNow && !this.altBuddyNow.dead) { this.altBuddyNow.despawn(); }\n    this.altBuddyNow = null;\n    g.story.pass = null;\n    g.events.emit('mission-done', m.id);\n    g.save.write('mission');\n    if (m.next) this.start(m.next);\n  }\n  abort() {\n    if (this.active) this.exitStep();\n    this.active = null;\n    this.game.interact.clearTagged('mission');\n  }\n  /** Jump: every mission before this is applied quietly, so the world is in the right state. */\n  prepareJump(id) {\n    const g = this.game;\n    const order = MISSION_ORDER;\n    const i = order.indexOf(id);\n    const m = MISSIONS[id];\n    const before = new Set();\n    const addReq = (mid) => { if (before.has(mid)) return; before.add(mid); for (const r of MISSIONS[mid].requires) addReq(r); };\n    for (const r of m.requires) addReq(r);\n    for (const mid of order) {\n      if (!before.has(mid)) continue;\n      this.done.add(mid);\n      this.applyOps(MISSIONS[mid].ops, true);\n      const mm = MISSIONS[mid];\n      if (mm.give?.guns) for (const w of mm.give.guns) g.story.unlocked.add(w);\n    }\n    return m;\n  }\n}\nEOF\ncat > src/missions/scripts.js <<'EOF'\n// The scripted pieces, as coroutines: yield seconds, or a predicate to wait on. Driven once per fixed step, so they replay.\nimport { SITES, POSTS } from '../content/sites.js';\nimport { ROADS, RAIL, STRIPS } from '../content/roads.js';\nimport { CONTRACT_NOTE } from '../content/notes.js';\nimport { LINES } from '../content/dialogue.js';\nimport { TUNING } from '../core/tuning.js';\nimport { polyLength, pointAlong } from '../world/ground.js';\nimport { S, FN } from '../world/fire.js';\nconst until = (f) => f;\nconst hearing = (g) => () => !g.dialogue.active;\nfunction* say(g, key) { g.dialogue.play(key); yield hearing(g); }\nfunction eventFlag(g, name) { const o = { hit: false }; o.off = g.events.on(name, () => { o.hit = true; }); return o; }\n\nexport function makeScripts() {\n  return {\n    // ---- M0: the flatcar in, the map, the margin, the platform, the fall ----\n    * m0(g, r) {\n      const tr = g.train;\n      g.clock.set(18.2); g.wind.pin([0.9, 0.2], 3.5);\n      tr.place(tr.sAt(-420, 104));\n      g.player.seatOnTrain(1, [0.7, 2.25, 1.6], false, 0.1);\n      tr.run(tr.sAt(0, 70), 9);\n      g.music.force('title', g.realT);\n      g.skipPrompt = true;\n      yield 1.5;\n      yield* say(g, 'm0.ride');\n      yield* say(g, 'm0.map');\n      g.mapHint = true;\n      const up = eventFlag(g, 'map-up');\n      g.map.addNote(CONTRACT_NOTE);\n      g.map.setMargin(['THE GOODS LINE', '', 'RAISE THE MAP']);\n      g.stepBanner('RAISE THE MAP');\n      yield () => up.hit || g.dev.skipScript;\n      up.off();\n      g.mapHint = false;\n      g.map.dirty = true;\n      yield 3;\n      yield* say(g, 'm0.note');\n      yield () => !tr.moving || g.dev.skipScript;\n      g.map.raise(false);\n      yield* say(g, 'm0.platform');\n      g.player.leaveTrain(6, 62);\n      g.player.setYaw(Math.PI, 0);\n      g.body.startFever({ limit: 999, silent: true });\n      g.stepBanner('THE FEVER');\n      yield 3.5;\n      g.fall();\n      yield 2.2;\n      g.body.fever = 'none'; g.body.feverOn = false; g.body.swim = 0; g.cam.roll = 0;\n      g.skipPrompt = false;\n    },\n    // ---- M1 ----\n    * m1Wake(g) {\n      const site = SITES['mile-forty'];\n      g.player.teleport(site.at[0] - 42, site.at[1] - 12);\n      g.player.setYaw(-1.0, 0);\n      g.clock.set(7.5);\n      g.wind.unpin();\n      g.wake();\n      g.body.tablets = 3;\n      g.body.hp = 100;\n      g.body.startFever({ limit: 9999, silent: true });\n      yield 1.2;\n      g.faceNpc(g.npcs.byWho.odile);\n      yield* say(g, 'm1.wake');\n      g.faceNpc(null);\n      g.tabletHint = true;\n      g.stepBanner('TAKE THE TABLET');\n      const t = eventFlag(g, 'tablet');\n      yield () => t.hit;\n      t.off();\n      g.tabletHint = false;\n      yield () => g.body.fever === 'none';\n      g.body.tablets = 0;\n      g.story.feverRunning = true;\n      g.body.scheduleFever();\n    },\n    * m1Gear(g, r) {\n      g.weapons.give('m38', 100, false);\n      g.weapons.give('tractor', 45, true);\n      g.story.unlocked.add('tractor');\n      g.body.syrettes = 3;\n      const site = SITES['mile-forty'];\n      r.tags['m1-truck'] = g.vehicles.spawn('pickup', site.at[0] - 44, site.at[1] + 14, 1.5);\n      g.map.setWaypoint(site.at[0] - 44, site.at[1] + 14);\n      g.notice('A RETURNED RIFLE. CONDITION: RETURNED.', 3);\n      yield 0.5;\n    },\n    * m1Ambush(g, r) {\n      const v = r.tags['m1-truck'];\n      const sq = g.actors.squads.get('p2');\n      sq.alive = Math.max(sq.alive, 4); sq.clearedAt = null; sq.forceLive = true; sq.disabled = false;\n      g.story.flags.p2Manned = true;\n      // The truck is hit and stalls.\n      if (v && v.driver === 'player') {\n        g.damage.blast(v.x + Math.sin(v.yaw) * 8, v.y, v.z + Math.cos(v.yaw) * 8, 3, 1, 'world', { fire: 0 });\n        v.hp = 1; v.onFire = 0; v.stall(); v.lastVel = 0;\n        g.stepBanner('THE TRUCK IS DEAD. GET OUT.');\n        g.ctx.engine.shake.add(0.5);\n        yield () => !g.driving.vehicle || g.dev.skipScript;\n      } else if (v) { v.hp = 1; v.onFire = 0; v.stall(); }\n      g.weapons.scriptJamAt = 5; g.weapons.scriptShots = 0;\n      g.equipBest();\n      g.stepBanner('SHOOT THEM. THE RIFLE WAS RETURNED FOR A REASON.');\n      const jam = eventFlag(g, 'jam');\n      yield () => jam.hit || sq.alive <= 0;\n      jam.off();\n      if (g.weapons.gun?.jam > 0) {\n        g.stepBanner('IT JAMMED. PRESS RELOAD UNTIL IT CLEARS.');\n        yield () => !(g.weapons.gun?.jam > 0);\n      }\n      g.stepBanner('CLEAR THE POST');\n      yield () => sq.alive <= 0;\n      sq.forceLive = false;\n      if (g.body.hp > 60) { g.body.hp = 55; g.body.lastHit = g.time; }\n      g.stepBanner('YOU ARE BLEEDING. USE A SYRETTE.');\n      g.healHint = true;\n      const syr = eventFlag(g, 'syrette');\n      yield () => syr.hit || g.dev.skipScript;\n      syr.off(); g.healHint = false;\n      if (v && v.alive) {\n        v.stalled = true; v.hp = Math.min(v.hp, 10);\n        g.map.setWaypoint(v.x, v.z);\n        g.stepBanner('REPAIR THE TRUCK. HOLD USE AT THE BONNET.');\n        const rep = eventFlag(g, 'vehicle-repaired');\n        yield () => rep.hit || !v.alive || g.dev.skipScript;\n        rep.off();\n      }\n      g.mapMargin?.('');\n    },\n    // ---- M2 ----\n    * m2Free(g, r) {\n      const site = SITES['ranger-post'];\n      const ines = g.actors.buddy('ines');\n      ines.met = true;\n      ines.spawn(g.ctx, site.at[0] + 12, site.at[1] + 8, { hp: 200 });\n      g.world.openCage();\n      yield* say(g, 'm2.cage');\n      const sq = g.actors.squads.get('ranger-post');\n      sq.forceLive = true;\n      for (const s of sq.members) if (!s.dead) s.alertTo(g.player.feet.x, g.player.feet.z, 'player');\n    },\n    // ---- M3 ----\n    * m3Tanker(g, r) {\n      const p3 = POSTS.p3;\n      const v = g.vehicles.spawn('tanker', p3.at[0] + 14, p3.at[1] + 10, 1.4, { paint: 'red', hood: 'plum', roof: 'plum' });\n      r.tags.tanker = v;\n      g.map.setWaypoint(v.x, v.z);\n      g.story.holdFireFaction = 'harvest';\n      g.stepBanner('TAKE THE TANKER AT P3');\n      yield () => g.driving.vehicle === v || !v.alive || g.dev.skipScript;\n      if (!v.alive) { g.story.holdFireFaction = null; return; }\n      const es = SITES['east-siding'];\n      g.map.setWaypoint(es.at[0], es.at[1]);\n      g.stepBanner('DRIVE IT INTO THE SIDING. THEY WILL WAVE AT FUEL.');\n      yield () => Math.hypot(v.x - es.at[0], v.z - es.at[1]) < 32 || !v.alive || g.dev.skipScript;\n      g.stepBanner('GET OUT AND SHOOT IT. RUN.');\n      g.story.holdFireFaction = null;\n      const sq = g.actors.squads.get('east-siding');\n      sq.angry = true;\n      yield 0.2;\n    },\n    // ---- M4 ----\n    * m4Convoy(g, r) {\n      const useBridge = !!r.tags.onBridge;\n      const pts = useBridge ? [...ROADS.back.pts].reverse() : ROADS.saltLoop.pts;\n      const L = polyLength(pts);\n      const mk = (kind, off, tag) => {\n        const at = pointAlong(pts, off, [0, 0, 0]);\n        const v = g.vehicles.spawn(kind, at[0], at[1], at[2], kind === 'truck' ? { paint: 'slate', hood: 'night', roof: 'night', canvas: 'mist' } : { paint: 'slate', hood: 'night', roof: 'mist' });\n        v.driver = 'ai'; v.faction = 'concord'; v.crew = kind === 'technical' ? 2 : 0; v.aiSpeed = 9;\n        v.patrol = { pts, L, s: off, dir: 1, loop: !useBridge };\n        v.convoy = true;\n        if (tag) r.tags[tag] = v;\n        return v;\n      };\n      mk('technical', useBridge ? 60 : 110, 'c1');\n      const truck = mk('truck', useBridge ? 40 : 90, 'payroll');\n      mk('technical', useBridge ? 20 : 70, 'c2');\n      g.world.markPayroll(truck);\n      g.map.setWaypoint(truck.x, truck.z);\n      g.map.see('salt-pan');\n      yield 0.5;\n    },\n    * m4Dov(g, r) {\n      const b = SITES['salt-pan'];\n      const dov = g.actors.buddy('dov');\n      g.weapons.charges = Math.max(g.weapons.charges, 2);\n      r.tags.onBridge = true;\n      g.map.setWaypoint(120, 230);\n      g.stepBanner('PLANT DOV\\'S CHARGES ON THE BRIDGE. HOLD THROW.');\n      const pl = eventFlag(g, 'planted');\n      yield () => (pl.hit && Math.hypot(g.player.feet.x - 120, g.player.feet.z - 230) < 30) || g.dev.skipScript;\n      pl.off();\n      g.stepBanner('WAIT. THROW AGAIN WHEN THE TRUCK IS ON IT.');\n      yield 0.2;\n    },\n    * m4Case(g, r) {\n      const t = r.tags.payroll;\n      const at = t ? [t.x, t.z] : [200, 470];\n      const a = g.rng.story.range(0, 6.28), d = g.rng.story.range(16, 28);\n      const x = at[0] + Math.cos(a) * d, z = at[1] + Math.sin(a) * d;\n      g.places.spawnStoryCase('payroll-case', x, z, 10);\n      g.story.trackerOwned = true;\n      g.dialogue.play('m4.tracker');\n      g.trackerHint = true;\n      yield () => !g.dialogue.active;\n      yield 0.5;\n    },\n    // ---- M5 ----\n    * m5Hold(g, r) {\n      const s = SITES['pump-station'];\n      const sq = g.actors.squads.get('pump-station');\n      sq.forceLive = true;\n      if (sq.alive < 6) sq.alive = 6;\n      g.story.flags.m5Hold = true;\n      g.squadsAlertAll('pump-station');\n      g.holdT = 60;\n      g.stepBanner('HOLD THE PUMP HOUSE. THE CISTERN IS FILLING.');\n      yield () => { if (Math.hypot(g.player.feet.x - s.at[0], g.player.feet.z - s.at[1]) < 34) g.holdT -= 1 / 60; return g.holdT <= 0 || g.dev.skipScript; };\n      g.holdT = 0;\n      g.story.flags.cisternFull = true;\n      sq.forceLive = false;\n      g.stepBanner('THE CISTERN IS FULL. NOW BLOW THE PUMP.');\n    },\n    * m5After(g, r) {\n      if (g.story.flags.cisternFull) {\n        g.dialogue.play('m5.done.wet');\n      } else {\n        g.dialogue.play('m5.done.dry');\n        g.actors.civilians.emptyVillage();\n        g.story.odileRefuses = true;\n        g.story.flags.wellsEmpty = true;\n        g.world.darkenVillage?.();\n      }\n    },\n    // ---- M6 ----\n    * m6Buddy(g, r) {\n      const best = g.actors.liveBuddies().filter((b) => g.clock.abs >= b.woundedUntil).sort((a, b) => b.trust - a.trust)[0];\n      const b = best ?? g.actors.buddy('pell');\n      if (b.id === 'pell') b.met = false;\n      const f = g.player.feet;\n      b.spawn(g.ctx, f.x + 2.5, f.z + 2.5, { hp: 200 });\n      r.tags.m6buddy = b;\n      g.say(b.id, b.id === 'pell' ? 'THE MOTHER SENT ME. YOU WILL NOT LIKE ME.' : 'I HEARD. I AM COMING. DO NOT SAY ANYTHING.', 3);\n      yield 3;\n    },\n    * m6Burn(g, r) {\n      const site = SITES['long-field'], b = r.tags.m6buddy, fire = g.fire;\n      // Count the crop cells.\n      const cells = [];\n      for (let id = 0; id < FN * FN; id++) { const x = fire.wx(id), z = fire.wz(id); if (Math.abs(x - site.at[0]) < 90 && Math.abs(z - site.at[1]) < 60 && fire.fuel[id] > 0) cells.push(id); }\n      g.map.setWaypoint(site.at[0], site.at[1]);\n      const frac = () => { let n = 0; for (const id of cells) if (fire.state[id] !== S.FRESH) n++; return n / Math.max(1, cells.length); };\n      g.burnFrac = frac;\n      yield () => frac() >= 0.1 || g.dev.skipScript;\n      g.stepBanner('IT IS GOING. THE WIND IS CARRYING IT.');\n      yield () => frac() >= 0.5 || g.dev.skipScript;\n      g.wind.pin([-0.9, -0.2], 7);\n      g.dialogue.play('m6.turn');\n      g.music.setMood('fight');\n      yield 1.2;\n      // They go down on fire. Finish it, or spend a syrette and watch them burn out.\n      const f = g.player.feet;\n      if (b && !b.dead) {\n        if (Math.hypot(b.x - f.x, b.z - f.z) > 25) b.cc.teleport([f.x + 8, g.world.heightAt(f.x + 8, f.z + 8) + 0.1, f.z + 8]);\n        b.x = b.cc.feet.x; b.z = b.cc.feet.z;\n        b.fireProof = true;\n        b.goDown(true);\n        g.map.setWaypoint(b.x, b.z);\n        g.dialogue.play('m6.choice');\n        g.stepBanner('SYRETTE, OR FINISH IT');\n        const sv = eventFlag(g, 'buddy-saved'), dd = eventFlag(g, 'buddy-dead');\n        yield () => sv.hit || dd.hit || g.dev.skipScript;\n        sv.off(); dd.off();\n        b.fireProof = false;\n        if (b.id === 'pell' && !b.dead) b.despawn();\n      }\n      g.music.setMood(null);\n      const bunker = g.world.explosives.find((e) => e.tag === 'ammo-bunker');\n      g.map.setWaypoint(bunker.x, bunker.z);\n    },\n    // ---- M7 ----\n    * m7War(g, r) {\n      g.story.war = true; g.story.pass = null; g.story.truce = false;\n      g.clock.set(16);\n      const cut = SITES['the-cut'];\n      const sq1 = g.actors.addSquadDef('cut-harvest', { faction: 'harvest', n: 10, at: [cut.at[0] + 62, cut.at[1] + 28], noReman: true, duty: 'patrol' });\n      const sq2 = g.actors.squads.get('the-cut');\n      sq1.forceLive = true; sq2.forceLive = true; sq2.alive = Math.max(sq2.alive, 10);\n      r.tags.cutTech = g.vehicles.spawn('technical', 250, -262, -0.7, { paint: 'orange', hood: 'red', roof: 'sand' });\n      g.notice('A TECHNICAL ON THE ROAD. NOBODY IS IN IT.', 3);\n      g.fire.ignite(cut.at[0] + 110, cut.at[1] + 30, 6, 'world');\n      g.fire.ignite(cut.at[0] - 110, cut.at[1] + 50, 6, 'world');\n      g.map.setWaypoint(cut.at[0], cut.at[1]);\n      yield 0.2;\n    },\n    * m7Road(g, r) {\n      const b = r.altBuddyNow;\n      if (b) { b.spawn(g.ctx, 255, -240, { hp: 200, following: false, goal: { x: 248, z: -272 } }); b.trust++; }\n      yield 0.2;\n    },\n    * m7Read(g, r) {\n      g.dialogue.play('m7.ledger');\n      yield () => !g.dialogue.active;\n    },\n    * m7After(g) {\n      g.story.war = true;\n      if (g.npcs?.byWho.tibor) g.npcs.byWho.tibor.setActive(false);\n    },\n    // ---- M8 ----\n    * m8Hold(g, r) {\n      const s = SITES['mile-forty'];\n      const px = s.at[0], pz = s.at[1] + 28;\n      g.map.setWaypoint(px, pz);\n      g.world.setCrowdAtPlatform(true);\n      g.shelling = { at: [s.at[0], s.at[1]], r: 55, every: 4.5, t: 3 };\n      g.noTruceHere = true;\n      g.story.noPatrols = true;\n      g.vehicles.stopPatrols();\n      const squads = [];\n      const wave = (key, faction, ax, az) => {\n        const sq = g.actors.addSquadDef(key, { faction, n: 7, at: [ax, az], noReman: true, duty: 'march' });\n        sq.forceLive = true; squads.push(sq);\n        return sq;\n      };\n      wave('m8a', 'concord', s.at[0] - 90, s.at[1] - 55);\n      yield 1;\n      g.holdT = 120;\n      g.stepBanner('HOLD THE PLATFORM');\n      const marks = [[100, 0], [75, 1], [40, 2], [10, 3]];\n      let said = 0, wn = 0;\n      for (;;) {\n        const f = g.player.feet;\n        const nearby = Math.hypot(f.x - px, f.z - pz) < 70 || g.dev.god;\n        if (nearby || g.player.seat) g.holdT -= 1 / 60;\n        if (said < marks.length && g.holdT <= marks[said][0]) { const line = LINES['m8.board'][marks[said][1]]; g.say(line[0], line[1], 3); g.voice.say(line[0], line[1]); said++; }\n        if (wn < 2 && g.holdT <= 80 - wn * 40) { wn++; wave(`m8w${wn}`, wn === 1 ? 'harvest' : 'concord', s.at[0] + (wn === 1 ? 95 : -70), s.at[1] - 40 * wn); }\n        for (const sq of squads) for (const m of sq.members) if (!m.dead && m.duty === 'march' && !m.marchTo && m.state !== 'alert') { m.marchTo = { x: px + g.rng.ai.range(-16, 16), z: pz - g.rng.ai.range(6, 14) }; }\n        if (g.holdT <= 0 || g.dev.skipScript) break;\n        yield 0;\n      }\n      g.holdT = 0;\n      g.world.setCrowdAtPlatform(false);\n      for (const sq of squads) sq.forceLive = false;\n      g.shelling = null;\n      g.dialogue.play('m8.ride');\n      g.stepBanner('GET TO THE FLATCAR');\n      const tr = g.train;\n      tr.place(tr.sAt(s.at[0], s.at[1] + 30));\n      r.tags.flatUse = g.interact.add({ tag: 'mission', liveAt: () => { const c = tr.cars[3]; return [c.x, c.y + 1, c.z]; }, r: 7, wide: true, verb: () => 'CLIMB ON THE GUN', onUse: () => { r.tags.onFlat = true; } });\n      g.map.setWaypoint(tr.cars[3].x, tr.cars[3].z);\n      yield () => r.tags.onFlat || g.dev.skipScript;\n      g.interact.remove(r.tags.flatUse);\n    },\n    * m8Ride(g, r) {\n      const tr = g.train;\n      g.player.seatOnTrain(3, [0, 2.3, 1.2], true, 0.15);\n      g.weapons.mounted = { turret: () => { const c = tr.cars[3]; if (c.turret) c.turret.rotation.y = g.player.yaw - c.yaw + Math.PI; } };\n      tr.whistle();\n      const goal = tr.sAt(425, -58);\n      const L = Math.abs(goal - tr.s);\n      tr.run(goal, L / 58);\n      g.holdT = 60;\n      // Technicals and riflemen along the line, on rails, under fire.\n      g.story.pass = null;\n      const line = [[120, 25, 'harvest'], [190, 2, 'concord'], [250, -24, 'harvest'], [330, -60, 'concord'], [390, -80, 'harvest']];\n      line.forEach(([x, z, f], i) => { const sq = g.actors.addSquadDef(`m8r${i}`, { faction: f, n: 4, at: [x, z], noReman: true }); sq.forceLive = true; });\n      const a = g.vehicles.spawn('technical', 110, 44, 1.4, { paint: 'slate', hood: 'night', roof: 'mist' }); a.driver = 'ai'; a.faction = 'concord'; a.crew = 0; a.aiSpeed = 11; a.patrol = { pts: [[110, 50], [240, 20], [320, 0], [420, -40]], L: 340, s: 0, dir: 1 };\n      r.tags.m8car = a;\n      yield () => { g.holdT -= 1 / 60; return !tr.moving || g.dev.skipScript; };\n      g.holdT = 0;\n      g.weapons.mounted = null;\n      for (let i = 0; i < 5; i++) { const sq = g.actors.squads.get(`m8r${i}`); if (sq) sq.forceLive = false; }\n      if (a.alive) g.vehicles.remove(a);\n      g.player.leaveTrain(415, -48);\n      g.dialogue.play('m8.done');\n      g.story.noPatrols = false;\n      yield () => !g.dialogue.active;\n    },\n    * m8After(g) { g.story.flags.columnWalking = true; g.world.startColumn(); },\n    // ---- M9 ----\n    * m9Scene(g, r) {\n      const n = g.npcs.byWho.harrow;\n      g.ending.harrowScene(n);\n      yield () => g.ending.sceneStep >= 1 || g.dev.skipScript;\n      g.dialogue.play('m9.scene');\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.ending.layMap();\n      g.dialogue.play('m9.lay');\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.dialogue.play('m9.offer');\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.dialogue.stopAll();\n      let shot = null;\n      g.ui.choice('FINISH YOUR CONTRACT?', [{ label: 'SHOOT HIM', id: 'shoot', onSelect: () => { shot = true; } }, { label: 'LEAVE HIM THE LAMP', id: 'spare', onSelect: () => { shot = false; } }], { noBack: true });\n      yield () => shot != null;\n      g.story.chose.shoot = shot;\n      if (shot) {\n        g.ending.shootHarrow();\n        g.dialogue.play('m9.shot');\n        g.ledger.add('paid', 1);\n        g.ledger.note('harrow', 'shot');\n      } else {\n        g.dialogue.play('m9.spared');\n        g.ledger.note('harrow', 'spared');\n      }\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.dialogue.play('m9.sheet');\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.dialogue.stopAll();\n      let sheet = null;\n      g.ui.choice('WHO GETS THE SHEET?', [{ label: 'WALK OUT WITH IT', id: 'alone', onSelect: () => { sheet = 'alone'; } }, { label: 'GIVE IT TO THE COLUMN', id: 'column', onSelect: () => { sheet = 'column'; } }], { noBack: true });\n      yield () => sheet != null;\n      g.story.sheet = sheet;\n      g.body.tablets += 6;\n      g.ending.endHarrowScene();\n      yield 0.5;\n    },\n    // ---- The Pass ----\n    * endPass(g, r) {\n      g.sky.setWeather('clear');\n      g.clock.set(4.6);\n      g.story.war = true; g.story.pass = null;\n      const sheet = g.story.sheet ?? 'alone';\n      const pass = SITES['the-pass'];\n      g.player.teleport(-400, -360);\n      g.player.setYaw(Math.atan2(190, 70), 0);\n      g.endingMusic = false;\n      if (sheet === 'column') {\n        g.map.setWaypoint(-430, -382);\n        g.world.setColumnHead(-436, -388);\n        g.stepBanner('TAKE THE SHEET TO THE COLUMN');\n        let given = false;\n        const u = g.interact.add({ tag: 'mission', x: -436, y: g.world.heightAt(-436, -388) + 1.4, z: -388, r: 5, wide: true, verb: () => 'GIVE THEM THE SHEET', onUse: () => { given = true; } });\n        yield () => given || g.dev.skipScript;\n        g.interact.remove(u);\n        g.dialogue.play('end.column');\n        g.world.columnGoesThrough();\n        g.ledger.add('moved', 600);\n        yield () => !g.dialogue.active;\n        g.stepBanner('HOLD BEHIND THEM');\n        g.map.setWaypoint(-520, -420);\n      } else {\n        g.dialogue.play('end.alone');\n        g.map.setWaypoint(pass.at[0], pass.at[1]);\n        g.stepBanner('WALK TO THE PASS');\n      }\n      const px = sheet === 'column' ? -520 : -565, pz = sheet === 'column' ? -420 : -425;\n      yield () => Math.hypot(g.player.feet.x - px, g.player.feet.z - pz) < 26 || g.dev.skipScript;\n      // Pursuit from both armies.\n      for (const [k, f, x, z] of [['endA', 'concord', px + 70, pz + 30], ['endB', 'harvest', px + 90, pz - 40]]) {\n        const sq = g.actors.addSquadDef(k, { faction: f, n: 6, at: [x, z], noReman: true, duty: 'march' });\n        sq.forceLive = true;\n      }\n      g.stepBanner(sheet === 'column' ? 'HOLD THE PASS' : 'THEY ARE BEHIND YOU');\n      g.holdT = 45;\n      yield () => { g.holdT -= 1 / 60; return g.holdT <= 0 || g.dev.skipScript; };\n      g.holdT = 0;\n      // The surviving buddies come for the stones.\n      const friends = g.actors.liveBuddies();\n      for (const b of friends) {\n        yield 1.5;\n        const key = `end.${b.id}`;\n        b.spawn(g.ctx, px + g.rng.story.range(8, 14), pz + g.rng.story.range(-14, 14), { hp: 200, following: false, goal: null });\n        b.isHostile = false;\n        g.faceActor(b);\n        g.dialogue.play(key);\n        yield () => !g.dialogue.active || g.dev.skipScript;\n        g.faceActor(null);\n        let answer = null;\n        if (b.trust >= 3) {\n          g.ui.choice(`${b.name} OFFERS TO SPLIT IT`, [{ label: 'SPLIT THE STONES', id: 'split', onSelect: () => { answer = 'split'; } }, { label: 'REFUSE', id: 'refuse', onSelect: () => { answer = 'refuse'; } }], { noBack: true });\n          yield () => answer != null;\n        } else answer = 'refuse';\n        if (answer === 'split') {\n          g.story.stones = Math.floor(g.story.stones / 2);\n          g.say(b.id, 'THAT IS FAIR. THAT IS WHAT I WILL TELL THEM.', 3);\n          g.ledger.note('split', b.id);\n          b.goal = { x: b.x + 60, z: b.z + 60 };\n          yield 3;\n          b.despawn();\n        } else {\n          g.dialogue.play('end.refuse');\n          b.turnOn('player');\n          g.map.setWaypoint(b.x, b.z);\n          g.stepBanner(`${b.name} DRAWS`);\n          yield () => b.dead || g.dev.skipScript;\n          if (!b.dead) b.killed('pass');\n          g.say('', `${b.name} HAS STOPPED OWING ANYONE.`, 3);\n          yield 2;\n        }\n      }\n      // The last grass is yours to light.\n      g.dialogue.play('end.light');\n      g.weapons.give('flare', 100, true);\n      if (g.weapons.gun?.mag === 0) g.weapons.gun.mag = 1;\n      g.stepBanner('LIGHT THE GRASS');\n      g.wind.pin([0.9, 0.5], 6);\n      const before = g.fire.counts.lit;\n      yield () => g.fire.counts.lit > before || g.dev.skipScript;\n      yield 5;\n      g.ending.finish(sheet);\n      yield () => false;\n    },\n  };\n}\nEOF\necho ok","description":"Write story, missions, step types, runner and scripted coroutines"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18767,"cache_read_input_tokens":457667,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18767},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"c00bd686-67eb-4b67-842a-344d29074daf","timestamp":"2026-11-06T00:06:46.613Z","request_id":"req_011CgkhADWjUizNhU8WjtJr6","wire_tool_inputs":{"toolu_01Rfr3NdC8qYRXjqX1p4hgic":{"command":"set -e\npython3 - <<'EOF'\np='src/world/ground.js'; s=open(p).read()\ns=s.replace(\"\"\"    for (const p of Object.values(POSTS)) this.forRadiusCells(p.at[0], p.at[1], 12, (i, jit) => { if (kind[i] !== K.WATER && jit) kind[i] = K.DIRT; });\n\"\"\",\"\"\"    for (const p of Object.values(POSTS)) this.forRadiusCells(p.at[0], p.at[1], 12, (i, jit) => { if (kind[i] !== K.WATER && jit) kind[i] = K.DIRT; });\n    // Tanks stand in dry weeds: that is how a grass fire reaches them.\n    for (const site of Object.values(SITES)) if (site.tanks) for (const [dx, dz] of site.tanks) this.forRadiusCells(site.at[0] + dx, site.at[1] + dz, 9, (i) => { kind[i] = K.GRASS; });\n    if (SITES['east-siding']) this.forRadiusCells(SITES['east-siding'].at[0] + 8, SITES['east-siding'].at[1] - 32, 22, (i) => { kind[i] = K.GRASS; });\n\"\"\")\nopen(p,'w').write(s)\np='src/world/world.js'; s=open(p).read()\ns=s.replace(\"const DYNAMIC = new Set(['boom-gate', 'post-cage', 'fuel-tank', 'oil-drum', 'table-lamp']);\",\"const DYNAMIC = new Set(['boom-gate', 'post-cage', 'fuel-tank', 'oil-drum', 'table-lamp', 'bunker']);\")\ns=s.replace(\"\"\"export const EXPLOSIVE = { 'oil-drum': { radius: 4, damage: 90, hp: 30, fire: 5 }, 'fuel-tank': { radius: 13, damage: 300, hp: 80, fire: 14 } };\"\"\",\"\"\"export const EXPLOSIVE = { 'oil-drum': { radius: 4, damage: 90, hp: 30, fire: 5 }, 'fuel-tank': { radius: 13, damage: 300, hp: 80, fire: 14 }, bunker: { radius: 12, damage: 260, hp: 160, fire: 12 } };\"\"\")\ns=s.replace(\"\"\"      if (EXPLOSIVE[id]) this.addExplosive(id, e);\n\"\"\",\"\"\"      if (EXPLOSIVE[id]) { const ex = this.addExplosive(id, e); if (id === 'bunker') { ex.tag = 'ammo-bunker'; this.game.fire.setFuel(x, z, F.BUILDING); } else this.game.fire.setFuel(x, z, F.BUILDING); }\n\"\"\")\ns=s.replace(\"\"\"        this.addDynamic(ctx, e); this.addExplosive('fuel-tank', e, 'fuel-tank');\n\"\"\",\"\"\"        this.addDynamic(ctx, e); this.addExplosive('fuel-tank', e, 'fuel-tank'); this.game.fire.setFuel(e.x, e.z, F.BUILDING);\n\"\"\")\ns=s.replace(\"\"\"      const [dx, dz] = local(5.5, 0); const drum = this.place('oil-drum', dx, dz, 0, { list: [] }); this.addDynamic(ctx, drum); this.addExplosive('oil-drum', drum);\n\"\"\",\"\"\"      const [dx, dz] = local(5.5, 0); const drum = this.place('oil-drum', dx, dz, 0, { list: [] }); this.addDynamic(ctx, drum); this.addExplosive('oil-drum', drum);\n      this.game.fire.setFuel(dx, dz, F.BUILDING);\n\"\"\")\ns=s.replace(\"\"\"  /** Back to the map as drawn: no fire, no scars, tanks whole. */\"\"\",\"\"\"  /** The deck of a bridge has a wood floor underfoot. */\n  onDeck(f) { for (const b of Object.values(this.bridges)) if (Math.hypot(f.x - b.x, f.z - b.z) < 15 && f.y > RIVER_Y + 1.2) return true; return false; }\n  /** Back to the map as drawn: no fire, no scars, tanks whole. */\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/missions/story.js <<'EOF'\n// What the campaign remembers.\nexport const makeStory = () => ({\n  stones: 0, pass: null, truce: true, war: false, feverRunning: false, flags: {}, trigsDone: new Set(), casesDone: new Set(), halts: new Set(), unlocked: new Set(['m38', 'cane']), safehouses: new Set(), odileRefuses: false, runsDone: 0, act: 1, trackerOwned: false, stonesEarned: 0, stockInLockers: false, smokeUntil: 0, noPatrols: false, ending: null,\n  chose: {}, holdFireFaction: null, sheet: null,\n});\nexport const storyToJson = (s) => ({ ...s, trigsDone: [...s.trigsDone], casesDone: [...s.casesDone], halts: [...s.halts], unlocked: [...s.unlocked], safehouses: [...s.safehouses] });\nexport const storyFromJson = (j) => ({ ...makeStory(), ...j, trigsDone: new Set(j.trigsDone), casesDone: new Set(j.casesDone), halts: new Set(j.halts), unlocked: new Set(j.unlocked), safehouses: new Set(j.safehouses) });\nEOF\ncat > src/missions/ledger.js <<'EOF'\n// The Ledger: five big lines, written as Harrow would write it.\nexport class Ledger {\n  v = { moved: 0, paid: 0, friends: 0, stones: 0, cells: 0 }; notes = [];\n  constructor(game) { this.game = game; }\n  reset() { this.v = { moved: 0, paid: 0, friends: 0, stones: 0, cells: 0 }; this.notes = []; }\n  add(k, n) { this.v[k] = (this.v[k] ?? 0) + n; }\n  note(kind, a, b) { this.notes.push([kind, a, b]); }\n  hectares() { return Math.round(this.game.fire.counts.burnt * 0.25 * 10) / 10; }\n  lines() {\n    const v = this.v;\n    return [\n      { big: `${this.hectares()} HECTARES`, small: 'BURNED, BY MY COUNT. THE GREEN COMES BACK FASTER THAN THE PEOPLE.' },\n      { big: `${v.moved} PEOPLE`, small: 'MOVED OFF THEIR LAND. THE SHEET SHOWS WHERE THEY WERE.' },\n      { big: `${v.paid} MEN`, small: 'YOU WERE PAID TO KILL. THE INVOICES AGREE.' },\n      { big: `${v.friends} FRIENDS`, small: 'LOST. THESE ARE NOT ON ANY SHEET.' },\n      { big: `${v.stones} STONES`, small: 'EARNED. ROUGH. NOTHING HERE IS CUT.' },\n    ];\n  }\n  toJson() { return { v: this.v, notes: this.notes }; }\n  fromJson(j) { this.v = j.v; this.notes = j.notes; }\n}\nEOF\ncat > src/actors/npc.js <<'EOF'\n// People who stand where they stand: the givers, Tibor, Bakr, buddies at the bar.\nimport { makePerson } from './rig.js';\nimport { SITES } from '../content/sites.js';\nconst IDLE = { odile: 'SmokeIdle', tibor: 'Shrug', bakr: 'Idle', vance: 'CleanRifleIdle', ansa: 'TeachPoint', harrow: 'WriteAtDesk', ines: 'Idle', dov: 'Idle', mags: 'Idle' };\nexport class Npc {\n  active = true;\n  constructor(game, who, x, z, yaw) { this.game = game; this.who = who; this.x = x; this.z = z; this.yaw = yaw; this.y = game.world.heightAt(x, z); }\n  build(ctx) {\n    const g = this.game;\n    if (!g.views) return;\n    const p = makePerson(this.who);\n    this.view = p;\n    p.object.position.set(this.x, this.y, this.z);\n    p.object.rotation.y = (this.yaw * Math.PI) / 180;\n    ctx.scene.add(p.object);\n    p.anim.set(IDLE[this.who] ?? 'Idle');\n    p.anim.mixer.update(Math.random === 0 ? 0 : 0.01);\n  }\n  place(x, z, yawDeg) { this.x = x; this.z = z; this.y = this.game.world.heightAt(x, z); if (this.view) { this.view.object.position.set(x, this.y, z); if (yawDeg != null) this.view.object.rotation.y = (yawDeg * Math.PI) / 180; } }\n  setActive(v) { this.active = v; if (this.view) this.view.object.visible = v; }\n  play(name) { this.view?.anim.set(name); }\n  head() { return [this.x, this.y + 1.55, this.z]; }\n  update(ctx, dt) {\n    if (!this.active || !this.view) return;\n    const cam = this.game.camPos;\n    if (Math.hypot(this.x - cam.x, this.z - cam.z) < 90) this.view.anim.update(dt);\n  }\n}\nexport class Npcs {\n  byWho = {};\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game;\n    for (const site of Object.values(SITES)) {\n      for (const n of site.npcs ?? []) {\n        const npc = new Npc(g, n.who, site.at[0] + n.dx, site.at[1] + n.dz, n.yaw);\n        npc.build(ctx);\n        npc.siteKey = site.key;\n        this.byWho[n.who] = npc;\n      }\n    }\n    // Buddies at the bar, when you have met them.\n    const bar = SITES['mile-forty'];\n    [['ines', -26, -30, 20], ['dov', -18, -29, -20], ['mags', -38, -2, 80]].forEach(([who, dx, dz, yaw]) => {\n      const npc = new Npc(g, who, bar.at[0] + dx, bar.at[1] + dz, yaw);\n      npc.build(ctx);\n      npc.setActive(false);\n      this.byWho[who] = npc;\n    });\n  }\n  update(ctx, dt) { for (const n of Object.values(this.byWho)) n.update(ctx, dt); }\n  /** Who is around right now follows the story. */\n  sync() {\n    const g = this.game;\n    for (const id of ['ines', 'dov', 'mags']) {\n      const b = g.actors.buddy(id), n = this.byWho[id];\n      n.setActive(!!b && b.met && !b.dead && !b.active && g.clock.abs >= b.woundedUntil);\n    }\n    if (this.byWho.harrow) this.byWho.harrow.setActive(!g.story.flags.harrowDead);\n    const truceBroke = !g.story.truce;\n    this.byWho.tibor.setActive(!truceBroke);\n  }\n}\nEOF\ncat > src/content/missions.js <<'EOF'\n// Contracts as data. Step types are in missions/steps.js. Scripts are named coroutines in missions/scripts.js.\n// `ops` are applied in order when a mission completes, and quietly when dev mode jumps past it.\nexport const MISSION_ORDER = ['m0', 'm1', 'm2', 'm3', 'm4', 'm5', 'm6', 'm7', 'm8', 'm9', 'end'];\nexport const MISSIONS = {\n  m0: { id: 'm0', title: 'THE GOODS LINE', giver: null, requires: [], auto: true, act: 1, steps: [{ do: 'script', name: 'm0', text: 'RIDE IN. LOOK AT THE MAP.' }], next: 'm1', ops: [{ flag: 'arrived' }] },\n  m1: { id: 'm1', title: 'MERCY RUN', giver: 'odile', requires: ['m0'], auto: true, act: 1, pay: 5, steps: [\n    { do: 'script', name: 'm1Wake', text: 'TAKE THE TABLET' },\n    { do: 'talk', who: 'odile', lines: 'm1.brief', text: 'HEAR HER OUT' },\n    { do: 'script', name: 'm1Gear', text: 'THE TRUCK IS OUTSIDE' },\n    { do: 'enter', tag: 'm1-truck', text: 'GET IN THE TRUCK' },\n    { do: 'goto', site: 'three-wells', r: 34, text: 'DRIVE THE MEDICINE TO THREE WELLS' },\n    { do: 'use', id: 'wells-drop', site: 'three-wells', dx: 3, dz: 4, y: 1, verb: 'LEAVE THE MEDICINE', text: 'LEAVE THE CRATE BY THE WELL' },\n    { do: 'goto', at: [-200, 30], r: 62, text: 'BACK TO MILE FORTY. THE ROAD GOES BY P2.' },\n    { do: 'script', name: 'm1Ambush', text: 'THEY HAVE MANNED P2' },\n    { do: 'goto', site: 'mile-forty', r: 50, text: 'BACK TO THE CLINIC' },\n    { do: 'report', to: 'odile', lines: 'm1.done', text: 'REPORT TO ODILE' },\n  ], ops: [{ tablets: 3 }, { safehouse: 'pump-shed' }, { meet: 'mags' }, { mapSee: 'pump-shed' }, { mapSee: 'ranger-post' }, { mapSee: 'three-wells' }], next: null },\n  m2: { id: 'm2', title: 'A CAGE AT THE POST', giver: 'tibor', requires: ['m1'], act: 1, pay: 8, brief: 'm2.brief', steps: [\n    { do: 'goto', site: 'ranger-post', r: 130, text: 'SCOUT THE RANGER POST. BEST AT NIGHT.', hint: 'mono' },\n    { do: 'use', id: 'cage', site: 'ranger-post', dx: 12, dz: 9.6, y: 1, hold: 3, verb: 'OPEN THE CAGE', text: 'OPEN THE CAGE' },\n    { do: 'script', name: 'm2Free', text: 'SHE IS OUT' },\n    { do: 'kill', squad: 'ranger-post', text: 'CLEAR THE POST' },\n    { do: 'report', to: 'tibor', lines: 'm2.done', text: 'BACK TO TIBOR' },\n  ], ops: [{ meet: 'ines' }, { meet: 'dov' }, { safehouse: 'ranger-post' }, { act: 2 }, { mapSee: 'fort-clement' }, { mapSee: 'granary' }, { unlock: 'tractor' }, { notice: 'THE COLONEL AND THE MOTHER BOTH WANT A WORD. BOTH OF THEM PAY.' }] },\n  m3: { id: 'm3', title: 'FUEL FOR THE PEACE', giver: 'vance', requires: ['m2'], act: 2, pay: 15, pass: 'concord', wind: { dir: [0.3, 0.95], speed: 5 }, brief: 'm3.brief', give: { guns: ['flare'] },\n    alt: { buddy: 'ines', call: 'm3.alt', bonus: 5, at: 0, steps: [{ do: 'script', name: 'm3Tanker', text: 'TAKE THE TANKER AT P3' }] },\n    steps: [\n      { do: 'goto', site: 'east-siding', r: 140, text: 'REACH THE SIDING. THE WIND WILL CARRY IT.' },\n      { do: 'destroy', tag: 'fuel-tank', n: 3, text: 'BURN THE TANKS' },\n      { do: 'leave', site: 'east-siding', r: 200, text: 'GET OUT' },\n      { do: 'report', to: 'vance', lines: 'm3.done', text: 'REPORT TO VANCE' },\n    ], ops: [{ burnStrip: 'A' }, { flag: 'scarA' }, { smoke: [430, -60] }, { mapSee: 'east-siding' }] },\n  m4: { id: 'm4', title: 'SEED MONEY', giver: 'ansa', requires: ['m2'], act: 2, pay: 20, pass: 'harvest', brief: 'm4.brief',\n    alt: { buddy: 'dov', call: 'm4.alt', bonus: 5, at: 0, steps: [{ do: 'script', name: 'm4Dov', text: 'PLANT DOV\\'S CHARGES ON THE BRIDGE' }] },\n    steps: [\n      { do: 'script', name: 'm4Convoy', text: 'THE PAYROLL CROSSES THE SALT PAN' },\n      { do: 'destroy', tag: 'payroll', n: 1, text: 'STOP THE CONVOY. BLOW THE TRUCK.' },\n      { do: 'script', name: 'm4Case', text: 'FIND THE CASE WITH THE TRACKER' },\n      { do: 'collect', id: 'payroll-case', text: 'THE CASE IS IN THE SALT. HOLD THE TRACKER UP.' },\n      { do: 'report', to: 'ansa', lines: 'm4.done', text: 'REPORT TO ANSA' },\n    ], ops: [{ flag: 'tracker' }, { mapSee: 'salt-pan' }] },\n  m5: { id: 'm5', title: 'THE WATER QUESTION', giver: 'vance', requires: ['m3'], act: 2, pay: 20, pass: 'concord', brief: 'm5.brief', give: { charges: 2 },\n    alt: { buddy: 'mags', call: 'm5.alt', bonus: 0, payOverride: 10, at: 1, steps: [\n      { do: 'use', id: 'bypass', site: 'pump-station', dx: 1.6, dz: 0, y: 1.2, hold: 2, verb: 'OPEN THE BYPASS', text: 'OPEN THE BYPASS VALVE' },\n      { do: 'script', name: 'm5Hold', text: 'HOLD THE PUMP HOUSE' },\n    ] },\n    steps: [\n      { do: 'goto', site: 'pump-station', r: 60, text: 'REACH THE PUMP ON THE MERCY' },\n      { do: 'blast', site: 'pump-station', r: 12, text: 'PLANT A CHARGE ON THE PUMP. HOLD THROW.' },\n      { do: 'leave', site: 'pump-station', r: 120, text: 'LEAVE IT' },\n      { do: 'report', to: 'vance', lines: null, text: 'REPORT TO VANCE' },\n    ], onDoneScript: 'm5After', ops: [{ mapSee: 'pump-station' }] },\n  m6: { id: 'm6', title: 'THE LONG FIELD', giver: 'ansa', requires: ['m4'], act: 2, pay: 25, pass: 'harvest', hour: 21.5, wind: { dir: [0.9, 0.2], speed: 4 }, brief: 'm6.brief', steps: [\n    { do: 'script', name: 'm6Buddy', text: 'TAKE SOMEONE' },\n    { do: 'goto', site: 'long-field', r: 120, text: 'REACH THE LONG FIELD' },\n    { do: 'script', name: 'm6Burn', text: 'BURN THE CROP' },\n    { do: 'destroy', tag: 'ammo-bunker', n: 1, text: 'BLOW THE BUNKER' },\n    { do: 'leave', site: 'long-field', r: 190, text: 'GET OUT' },\n    { do: 'report', to: 'ansa', lines: 'm6.done', text: 'REPORT TO ANSA' },\n  ], ops: [{ burnStrip: 'B' }, { flag: 'scarB' }, { mapSee: 'long-field' }] },\n  m7: { id: 'm7', title: 'THE CUT', giver: 'note', requires: ['m3', 'm4', 'm5', 'm6'], act: 3, pay: 15, brief: 'm7.note',\n    alt: { buddy: 'any', call: 'm7.alt', bonus: 0, at: 0, steps: [{ do: 'script', name: 'm7Road', text: 'THEY HOLD THE EAST ROAD. GO IN BY THE PIT.' }] },\n    steps: [\n      { do: 'script', name: 'm7War', text: 'THE TRUCE IS OVER' },\n      { do: 'goto', site: 'the-cut', r: 90, text: 'REACH THE CUT' },\n      { do: 'use', id: 'ledger-book', site: 'the-cut', dx: 60, dz: -39.4, y: 1, verb: 'TAKE HIS LEDGER', text: 'THE SLUICE HOUSE. TAKE HIS LEDGER.' },\n      { do: 'script', name: 'm7Read', text: 'READ IT' },\n      { do: 'leave', site: 'the-cut', r: 230, text: 'GET OUT OF THE MINE' },\n    ], ops: [{ burnStrip: 'C' }, { flag: 'scarC' }, { truce: false }, { stock: true }, { act: 3 }, { mapSee: 'the-cut' }, { mapSee: 'observatory' }, { script: 'm7After' }] },\n  m8: { id: 'm8', title: 'LAST TRAIN', giver: 'odile', requires: ['m7'], act: 3, pay: 10, brief: 'm8.brief', steps: [\n    { do: 'script', name: 'm8Hold', text: 'HOLD THE PLATFORM WHILE THEY BOARD' },\n    { do: 'script', name: 'm8Ride', text: 'THE FLATCAR GUN. KEEP THEM OFF THE TRAIN.' },\n  ], ops: [{ flag: 'column' }, { moved: 600 }, { mapSee: 'the-pass' }, { script: 'm8After' }] },\n  m9: { id: 'm9', title: 'THE SURVEYOR', giver: 'note', requires: ['m8'], act: 3, pay: 0, hour: 23, weather: 'storm', steps: [\n    { do: 'goto', site: 'observatory', r: 46, text: 'CLIMB TO THE OBSERVATORY' },\n    { do: 'use', id: 'harrow-table', site: 'observatory', dx: 0, dz: 3.6, y: 1.2, verb: 'SIT DOWN', text: 'HE IS AT THE TABLE' },\n    { do: 'script', name: 'm9Scene', text: 'THE SURVEYOR' },\n  ], next: 'end', ops: [] },\n  end: { id: 'end', title: 'THE PASS', giver: null, requires: ['m9'], auto: true, act: 3, pay: 0, hour: 4.6, steps: [{ do: 'script', name: 'endPass', text: 'THE PASS' }], ops: [] },\n  mr1: { id: 'mr1', side: true, title: 'A CRATE FOR THE WEST CUTTING', giver: 'odile', requires: ['m1'], pay: 0, brief: 'odile.run', timer: 300, carry: true, steps: [{ do: 'goto', at: [-296, 96], r: 14, text: 'CARRY THE CRATE TO THE WEST CUTTING' }, { do: 'use', id: 'drop-mr1', at: [-296, 96], y: 1, verb: 'LEAVE THE CRATE', text: 'LEAVE THE CRATE' }], ops: [{ mercy: true }] },\n  mr2: { id: 'mr2', side: true, title: 'A CRATE FOR THE BACK ROAD', giver: 'odile', requires: ['m1'], pay: 0, brief: 'odile.run', timer: 300, carry: true, steps: [{ do: 'goto', at: [120, 110], r: 14, text: 'CARRY THE CRATE TO THE BOTTLE TREE' }, { do: 'use', id: 'drop-mr2', at: [120, 110], y: 1, verb: 'LEAVE THE CRATE', text: 'LEAVE THE CRATE' }], ops: [{ mercy: true }] },\n  mr3: { id: 'mr3', side: true, title: 'A CRATE FOR THE FORD', giver: 'odile', requires: ['m1'], pay: 0, brief: 'odile.run', timer: 300, carry: true, steps: [{ do: 'goto', at: [-68, 340], r: 14, text: 'CARRY THE CRATE OVER THE FORD' }, { do: 'use', id: 'drop-mr3', at: [-68, 340], y: 1, verb: 'LEAVE THE CRATE', text: 'LEAVE THE CRATE' }], ops: [{ mercy: true }] },\n};\nexport const GIVER_LINES = { odile: 'odile.idle', tibor: 'tibor.idle', vance: 'vance.idle', ansa: 'ansa.idle', bakr: 'bakr.idle', ines: 'ines.idle', dov: 'dov.idle', mags: 'mags.idle' };\nEOF\ncat > src/missions/steps.js <<'EOF'\n// Step types. A step shows its text at the top for 5 s when it starts, and always in the map margin. Bots drive these same steps.\nimport { SITES, POSTS } from '../content/sites.js';\nconst siteAt = (s) => (s.site ? SITES[s.site].at : s.at);\nconst dist = (g, a) => { const f = g.hasPlayer ? g.player.feet : { x: 0, z: 0 }; return Math.hypot(f.x - a[0], f.z - a[1]); };\nconst seatDist = (g, a) => { const v = g.driving.vehicle; const f = v ?? g.player.feet; return Math.hypot(f.x - a[0], f.z - a[1]); };\nexport const STEPS = {\n  goto: {\n    enter(r, s, g) { const a = siteAt(s); g.map.setWaypoint(a[0], a[1]); if (s.site) g.map.see(s.site); },\n    tick(r, s, g) { return seatDist(g, siteAt(s)) <= s.r; },\n  },\n  leave: {\n    enter(r, s, g) {},\n    tick(r, s, g) { return seatDist(g, siteAt(s)) >= s.r; },\n  },\n  talk: {\n    enter(r, s, g) { const n = g.npcs.byWho[s.who]; if (n) g.map.setWaypoint(n.x, n.z); s._state = 'wait'; g.player.frozen = false; g.dialogue.play(s.lines, { onEnd: () => { s._state = 'done'; } }); g.faceNpc(n); },\n    tick(r, s, g) { return s._state === 'done'; },\n    exit(r, s, g) { g.faceNpc(null); },\n  },\n  report: {\n    enter(r, s, g) {\n      const n = g.npcs.byWho[s.to];\n      s._state = 'go';\n      if (n) {\n        g.map.setWaypoint(n.x, n.z);\n        s._u = g.interact.add({ tag: 'mission', x: n.x, y: n.y + 1.5, z: n.z, r: 3.4, wide: true, verb: () => `REPORT TO ${s.to.toUpperCase()}`, onUse: () => {\n          g.interact.remove(s._u); s._u = null; s._state = 'talking'; g.faceNpc(n);\n          if (s.lines) g.dialogue.play(s.lines, { onEnd: () => { s._state = 'done'; } });\n          else s._state = 'done';\n        } });\n      } else s._state = 'done';\n    },\n    tick(r, s, g) { return s._state === 'done'; },\n    exit(r, s, g) { if (s._u) g.interact.remove(s._u); g.faceNpc(null); },\n  },\n  use: {\n    enter(r, s, g) {\n      const a = siteAt(s), x = a[0] + (s.dx ?? 0), z = a[1] + (s.dz ?? 0);\n      g.map.setWaypoint(x, z);\n      s._done = false;\n      s._u = g.interact.add({ tag: 'mission', id: s.id, x, y: g.world.heightAt(x, z) + (s.y ?? 1), z, r: s.reach ?? 2.8, wide: true, hold: s.hold, verb: () => s.verb, onStart: () => { g.vm.showProp(); g.vm.play('Open', { keep: true }); }, onCancel: () => { g.vm.endAction(); g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); }, onUse: () => { if (s.hold) { g.vm.endAction(); g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); } s._done = true; g.events.emit('step-used', s.id); } });\n    },\n    tick(r, s) { return s._done; },\n    exit(r, s, g) { if (s._u) g.interact.remove(s._u); },\n  },\n  deliver: { enter(r, s, g) { STEPS.goto.enter(r, s, g); }, tick(r, s, g) { return dist(g, siteAt(s)) <= s.r; } },\n  enter: {\n    enter(r, s, g) { const v = r.tags[s.tag]; if (v) g.map.setWaypoint(v.x, v.z); },\n    tick(r, s, g) { return g.driving.vehicle && g.driving.vehicle === r.tags[s.tag]; },\n  },\n  destroy: {\n    enter(r, s, g) { s._n = 0; for (const ex of g.world.explosives) if (ex.tag === s.tag && !ex.alive) s._n++; s._off = g.events.on('destroyed', (tag) => { if (tag === s.tag) s._n++; }); const t = g.world.explosives.find((e) => e.tag === s.tag); if (t) g.map.setWaypoint(t.x, t.z); },\n    tick(r, s) { return s._n >= s.n; },\n    exit(r, s) { s._off?.(); },\n  },\n  blast: {\n    enter(r, s, g) { const a = siteAt(s); s._hit = false; g.map.setWaypoint(a[0], a[1]); s._off = g.events.on('blast', (x, z) => { if (Math.hypot(x - a[0], z - a[1]) < s.r) s._hit = true; }); },\n    tick(r, s) { return s._hit; },\n    exit(r, s) { s._off?.(); },\n  },\n  kill: {\n    enter(r, s, g) { const sq = g.actors.squads.get(s.squad); if (sq) { sq.forceLive = true; g.map.setWaypoint(sq.def.at[0], sq.def.at[1]); } },\n    tick(r, s, g) { const sq = g.actors.squads.get(s.squad); return !sq || sq.alive <= (s.left ?? 0); },\n    exit(r, s, g) { const sq = g.actors.squads.get(s.squad); if (sq) sq.forceLive = false; },\n  },\n  collect: {\n    enter(r, s, g) { s._got = false; s._off = g.events.on('collected', (id) => { if (id === s.id) s._got = true; }); },\n    tick(r, s) { return s._got; },\n    exit(r, s) { s._off?.(); },\n  },\n  hold: { enter(r, s, g) { s._t = s.seconds; const a = siteAt(s); g.map.setWaypoint(a[0], a[1]); }, tick(r, s, g, dt) { if (seatDist(g, siteAt(s)) <= s.r) s._t -= dt; return s._t <= 0; } },\n  timer: { enter(r, s) { s._t = s.seconds; }, tick(r, s, g, dt) { s._t -= dt; return s._t <= 0; } },\n  choice: {\n    enter(r, s, g) { s._picked = null; g.ui.choice(s.prompt, s.options.map((o) => ({ label: o.label, onSelect: () => { s._picked = o.id; g.story.chose[s.key] = o.id; o.run?.(g); } }))); },\n    tick(r, s) { return s._picked != null; },\n  },\n  script: {\n    enter(r, s, g) { s._gen = r.scripts[s.name](g, r, s); s._wait = 0; s._done = false; s._pred = null; },\n    tick(r, s, g, dt) {\n      if (s._pred) { if (!s._pred()) return false; s._pred = null; }\n      if (s._wait > 0) { s._wait -= dt; if (s._wait > 0) return false; }\n      const { value, done } = s._gen.next();\n      if (done) return true;\n      if (typeof value === 'number') s._wait = value;\n      else if (typeof value === 'function') s._pred = value;\n      return false;\n    },\n    exit(r, s) { s._gen = null; },\n  },\n};\nexport const STEP_NAMES = Object.keys(STEPS);\nEOF\ncat > src/missions/runner.js <<'EOF'\n// Runs one contract at a time, offers others, pays, saves. Data in content/missions.js.\nimport { TUNING } from '../core/tuning.js';\nimport { MISSIONS, MISSION_ORDER } from '../content/missions.js';\nimport { SITES } from '../content/sites.js';\nimport { STRIPS } from '../content/roads.js';\nimport { LINES } from '../content/dialogue.js';\nimport { STEPS } from './steps.js';\nimport { makeScripts } from './scripts.js';\nimport { WEAPONS } from '../content/weapons.js';\nexport class MissionRunner {\n  active = null; stepI = 0; done = new Set(); stepsNow = []; tags = {}; altTaken = false; timer = 0; pendingOffer = null; timerFailed = false;\n  constructor(game) { this.game = game; this.scripts = makeScripts(); }\n  reset() { this.abort(); this.done.clear(); this.tags = {}; this.altTaken = false; }\n  isDone(id) { return this.done.has(id); }\n  canStart(m) {\n    if (this.done.has(m.id) && !m.side) return false;\n    if (m.side && this.done.has(m.id)) return false;\n    return m.requires.every((r) => this.done.has(r));\n  }\n  available(giver) { return Object.values(MISSIONS).filter((m) => !m.auto && this.canStart(m) && (giver == null || m.giver === giver)); }\n  /** A short FP scene: the camera holds on the giver, subtitles, then Accept or Not Yet. */\n  offer(m, npc) {\n    const g = this.game;\n    if (this.active) return;\n    const after = () => {\n      g.faceNpc(null);\n      g.ui.choice(m.title, [{ label: 'ACCEPT', id: 'accept', onSelect: () => this.start(m.id) }, { label: 'NOT YET', id: 'notyet', onSelect: () => {} }]);\n    };\n    if (npc) g.faceNpc(npc);\n    if (m.brief && LINES[m.brief]?.length) g.dialogue.play(m.brief, { onEnd: after });\n    else after();\n  }\n  start(id) {\n    const g = this.game, m = MISSIONS[id];\n    this.active = m;\n    this.stepI = 0;\n    this.altTaken = false;\n    this.altOffered = false;\n    this.stepsNow = m.steps.map((s) => ({ ...s }));\n    this.timer = m.timer ?? 0; this.timerFailed = false;\n    if (m.pass) g.story.pass = m.pass;\n    if (m.wind) g.wind.pin(m.wind.dir, m.wind.speed);\n    if (m.hour != null) g.clock.set(m.hour);\n    if (m.weather) g.sky.setWeather(m.weather);\n    if (m.give?.guns) for (const w of m.give.guns) { if (!g.weapons.slots[WEAPONS[w].slot] || WEAPONS[w].slot !== 'sidearm') g.weapons.give(w, 100); else g.weapons.give(w, 100, false); g.story.unlocked.add(w); }\n    if (m.give?.charges) g.weapons.charges = Math.max(g.weapons.charges, m.give.charges);\n    if (m.carry) g.notice('A CRATE ON YOUR SHOULDER', 3);\n    // Dov's perk: 2 free charges per mission.\n    const dov = g.actors.buddy('dov');\n    if (dov?.met && !dov.dead && !m.side) g.weapons.charges = Math.max(g.weapons.charges, 2);\n    g.events.emit('mission-start', id);\n    this.enterStep();\n    this.checkAlt();\n  }\n  checkAlt() {\n    const g = this.game, m = this.active;\n    if (!m?.alt || this.altOffered) return;\n    if (this.stepI !== m.alt.at) return;\n    const buddy = this.altBuddy(m);\n    this.altOffered = true;\n    if (!buddy) return; // Write their missions so the alternate plan just doesn't arrive.\n    g.after(8, () => {\n      if (this.active !== m) return;\n      g.sfx.play('radio-squelch');\n      const lines = m.id === 'm7' ? [['', 'THE RADIO GIVES A SHORT CRACK.'], [buddy.id, `${buddy.name}. WE WILL HOLD THE EAST ROAD. YOU GO IN BY THE PIT.`]] : m.alt.call;\n      g.dialogue.play(lines, { onEnd: () => {\n        if (this.active !== m) return;\n        g.ui.choice('A BETTER PLAN', [\n          { label: 'DO IT THEIR WAY', id: 'alt', onSelect: () => this.takeAlt(buddy) },\n          { label: 'IGNORE IT', id: 'ignore', onSelect: () => {} },\n        ], { overlay: true });\n      } });\n    });\n  }\n  altBuddy(m) {\n    const g = this.game, a = m.alt;\n    if (a.buddy === 'any') return g.actors.buddies.find((b) => b.met && !b.dead && g.clock.abs >= b.woundedUntil) ?? null;\n    const b = g.actors.buddy(a.buddy);\n    return b && b.met && !b.dead && g.clock.abs >= b.woundedUntil ? b : null;\n  }\n  takeAlt(buddy) {\n    const g = this.game, m = this.active;\n    this.altTaken = true;\n    this.altBuddyNow = buddy;\n    buddy.trust++;\n    const at = Math.max(this.stepI, m.alt.at);\n    const inserted = m.alt.steps.map((s) => ({ ...s }));\n    if (this.stepI === at) { this.exitStep(); this.stepsNow.splice(at, 0, ...inserted); this.enterStep(); }\n    else this.stepsNow.splice(at, 0, ...inserted);\n    if (m.id !== 'm7') {\n      const f = g.player.feet;\n      buddy.spawn(g.ctx, f.x + 3, f.z + 3, { hp: 200 });\n    }\n    g.events.emit('alt-taken', m.id, buddy.id);\n  }\n  currentStep() { return this.active ? this.stepsNow[this.stepI] : null; }\n  enterStep() {\n    const g = this.game, s = this.currentStep();\n    if (!s) { this.complete(); return; }\n    STEPS[s.do].enter(this, s, g);\n    if (s.text) g.stepBanner(s.text);\n    g.map.setMargin([this.active.title, '', s.text ?? '']);\n    g.events.emit('step', this.active.id, this.stepI, s.do);\n  }\n  exitStep() { const s = this.currentStep(); if (s) STEPS[s.do].exit?.(this, s, this.game); }\n  /** Dev mode's \"complete current step\". */\n  forceStep() { if (this.active) { this.exitStep(); this.stepI++; this.afterAdvance(); } }\n  afterAdvance() {\n    if (!this.active) return;\n    if (this.stepI >= this.stepsNow.length) this.complete();\n    else { this.enterStep(); this.checkAlt(); }\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, m = this.active;\n    if (!m) return;\n    if (m.timer) {\n      this.timer -= dt;\n      if (this.timer <= 0) { this.failSide(); return; }\n    }\n    const s = this.currentStep();\n    if (!s) return;\n    if (STEPS[s.do].tick(this, s, g, dt)) {\n      STEPS[s.do].exit?.(this, s, g);\n      this.stepI++;\n      this.afterAdvance();\n    }\n  }\n  failSide() {\n    const g = this.game, m = this.active;\n    this.exitStep();\n    this.active = null;\n    g.map.setWaypoint(null);\n    g.map.setMargin([]);\n    // Fail and she says nothing, which is worse.\n    g.stepBanner('TOO LATE');\n    g.story.flags.lateCount = (g.story.flags.lateCount ?? 0) + 1;\n    g.events.emit('mission-failed', m.id);\n    g.interact.clearTagged('mission');\n  }\n  applyOps(ops, quiet) {\n    const g = this.game, st = g.story;\n    for (const o of ops ?? []) {\n      if (o.burnStrip) g.fire.burnStrip(STRIPS[o.burnStrip].pts, STRIPS[o.burnStrip].width);\n      if (o.flag) st.flags[o.flag] = true;\n      if (o.smoke) st.smokeUntil = g.clock.abs + 24, st.smokeAt = o.smoke;\n      if (o.mapSee) g.map.see(o.mapSee);\n      if (o.tablets != null) g.body.tablets += o.tablets;\n      if (o.safehouse) st.safehouses.add(o.safehouse);\n      if (o.meet) { const b = g.actors.buddy(o.meet); if (b) b.met = true; }\n      if (o.act) { st.act = o.act; g.body.feverAct = o.act; }\n      if (o.unlock) st.unlocked.add(o.unlock);\n      if (o.truce === false) { st.truce = false; st.war = true; }\n      if (o.stock) st.stockInLockers = true;\n      if (o.moved) g.ledger.add('moved', o.moved);\n      if (o.notice && !quiet) g.notice(o.notice, 5);\n      if (o.script && this.scripts[o.script]) { const gen = this.scripts[o.script](g, this, null); let r = gen.next(); while (!r.done) r = gen.next(); }\n      if (o.mercy) {\n        st.runsDone++;\n        if (st.odileRefuses) { st.odileRefuses = false; if (!quiet) g.notice('NOTHING. SHE LOOKS AT YOU. NOTHING.', 4); }\n        else { g.body.tablets += 4; if (!quiet) { g.say('odile', 'FOUR. COUNT THEM. I DID.', 3); g.sfx.play('tablet-bottle'); } }\n      }\n    }\n    g.npcs.sync();\n  }\n  pay(n) {\n    const g = this.game;\n    const a = Math.round(n * TUNING.stonesReward);\n    if (a <= 0) return 0;\n    g.story.stones += a;\n    g.ledger.add('stones', a);\n    return a;\n  }\n  complete() {\n    const g = this.game, m = this.active;\n    if (!m) return;\n    this.exitStep();\n    this.active = null;\n    this.done.add(m.id);\n    g.interact.clearTagged('mission');\n    g.map.setWaypoint(null);\n    g.map.setMargin([]);\n    if (m.wind) g.wind.unpin();\n    let pay = m.pay ?? 0;\n    if (this.altTaken && m.alt?.payOverride != null) pay = m.alt.payOverride;\n    if (this.altTaken && m.alt?.bonus) pay += m.alt.bonus;\n    const paid = this.pay(pay);\n    if (paid > 0) { g.stepBanner(`${m.title}: ${paid} STONES`); g.sfx.play('ui-stone'); }\n    else if (!m.side) g.stepBanner(`${m.title}: DONE`);\n    this.applyOps(m.ops);\n    if (m.onDoneScript) { const gen = this.scripts[m.onDoneScript](g, this, null); let r = gen.next(); while (!r.done) r = gen.next(); }\n    if (this.altBuddyNow && !this.altBuddyNow.dead) { this.altBuddyNow.despawn(); }\n    this.altBuddyNow = null;\n    g.story.pass = null;\n    g.events.emit('mission-done', m.id);\n    g.save.write('mission');\n    if (m.next) this.start(m.next);\n  }\n  abort() {\n    if (this.active) this.exitStep();\n    this.active = null;\n    this.game.interact.clearTagged('mission');\n  }\n  /** Jump: every mission before this is applied quietly, so the world is in the right state. */\n  prepareJump(id) {\n    const g = this.game;\n    const order = MISSION_ORDER;\n    const i = order.indexOf(id);\n    const m = MISSIONS[id];\n    const before = new Set();\n    const addReq = (mid) => { if (before.has(mid)) return; before.add(mid); for (const r of MISSIONS[mid].requires) addReq(r); };\n    for (const r of m.requires) addReq(r);\n    for (const mid of order) {\n      if (!before.has(mid)) continue;\n      this.done.add(mid);\n      this.applyOps(MISSIONS[mid].ops, true);\n      const mm = MISSIONS[mid];\n      if (mm.give?.guns) for (const w of mm.give.guns) g.story.unlocked.add(w);\n    }\n    return m;\n  }\n}\nEOF\ncat > src/missions/scripts.js <<'EOF'\n// The scripted pieces, as coroutines: yield seconds, or a predicate to wait on. Driven once per fixed step, so they replay.\nimport { SITES, POSTS } from '../content/sites.js';\nimport { ROADS, RAIL, STRIPS } from '../content/roads.js';\nimport { CONTRACT_NOTE } from '../content/notes.js';\nimport { LINES } from '../content/dialogue.js';\nimport { TUNING } from '../core/tuning.js';\nimport { polyLength, pointAlong } from '../world/ground.js';\nimport { S, FN } from '../world/fire.js';\nconst until = (f) => f;\nconst hearing = (g) => () => !g.dialogue.active;\nfunction* say(g, key) { g.dialogue.play(key); yield hearing(g); }\nfunction eventFlag(g, name) { const o = { hit: false }; o.off = g.events.on(name, () => { o.hit = true; }); return o; }\n\nexport function makeScripts() {\n  return {\n    // ---- M0: the flatcar in, the map, the margin, the platform, the fall ----\n    * m0(g, r) {\n      const tr = g.train;\n      g.clock.set(18.2); g.wind.pin([0.9, 0.2], 3.5);\n      tr.place(tr.sAt(-420, 104));\n      g.player.seatOnTrain(1, [0.7, 2.25, 1.6], false, 0.1);\n      tr.run(tr.sAt(0, 70), 9);\n      g.music.force('title', g.realT);\n      g.skipPrompt = true;\n      yield 1.5;\n      yield* say(g, 'm0.ride');\n      yield* say(g, 'm0.map');\n      g.mapHint = true;\n      const up = eventFlag(g, 'map-up');\n      g.map.addNote(CONTRACT_NOTE);\n      g.map.setMargin(['THE GOODS LINE', '', 'RAISE THE MAP']);\n      g.stepBanner('RAISE THE MAP');\n      yield () => up.hit || g.dev.skipScript;\n      up.off();\n      g.mapHint = false;\n      g.map.dirty = true;\n      yield 3;\n      yield* say(g, 'm0.note');\n      yield () => !tr.moving || g.dev.skipScript;\n      g.map.raise(false);\n      yield* say(g, 'm0.platform');\n      g.player.leaveTrain(6, 62);\n      g.player.setYaw(Math.PI, 0);\n      g.body.startFever({ limit: 999, silent: true });\n      g.stepBanner('THE FEVER');\n      yield 3.5;\n      g.fall();\n      yield 2.2;\n      g.body.fever = 'none'; g.body.feverOn = false; g.body.swim = 0; g.cam.roll = 0;\n      g.skipPrompt = false;\n    },\n    // ---- M1 ----\n    * m1Wake(g) {\n      const site = SITES['mile-forty'];\n      g.player.teleport(site.at[0] - 42, site.at[1] - 12);\n      g.player.setYaw(-1.0, 0);\n      g.clock.set(7.5);\n      g.wind.unpin();\n      g.wake();\n      g.body.tablets = 3;\n      g.body.hp = 100;\n      g.body.startFever({ limit: 9999, silent: true });\n      yield 1.2;\n      g.faceNpc(g.npcs.byWho.odile);\n      yield* say(g, 'm1.wake');\n      g.faceNpc(null);\n      g.tabletHint = true;\n      g.stepBanner('TAKE THE TABLET');\n      const t = eventFlag(g, 'tablet');\n      yield () => t.hit;\n      t.off();\n      g.tabletHint = false;\n      yield () => g.body.fever === 'none';\n      g.body.tablets = 0;\n      g.story.feverRunning = true;\n      g.body.scheduleFever();\n    },\n    * m1Gear(g, r) {\n      g.weapons.give('m38', 100, false);\n      g.weapons.give('tractor', 45, true);\n      g.story.unlocked.add('tractor');\n      g.body.syrettes = 3;\n      const site = SITES['mile-forty'];\n      r.tags['m1-truck'] = g.vehicles.spawn('pickup', site.at[0] - 44, site.at[1] + 14, 1.5);\n      g.map.setWaypoint(site.at[0] - 44, site.at[1] + 14);\n      g.notice('A RETURNED RIFLE. CONDITION: RETURNED.', 3);\n      yield 0.5;\n    },\n    * m1Ambush(g, r) {\n      const v = r.tags['m1-truck'];\n      const sq = g.actors.squads.get('p2');\n      sq.alive = Math.max(sq.alive, 4); sq.clearedAt = null; sq.forceLive = true; sq.disabled = false;\n      g.story.flags.p2Manned = true;\n      // The truck is hit and stalls.\n      if (v && v.driver === 'player') {\n        g.damage.blast(v.x + Math.sin(v.yaw) * 8, v.y, v.z + Math.cos(v.yaw) * 8, 3, 1, 'world', { fire: 0 });\n        v.hp = 1; v.onFire = 0; v.stall(); v.lastVel = 0;\n        g.stepBanner('THE TRUCK IS DEAD. GET OUT.');\n        g.ctx.engine.shake.add(0.5);\n        yield () => !g.driving.vehicle || g.dev.skipScript;\n      } else if (v) { v.hp = 1; v.onFire = 0; v.stall(); }\n      g.weapons.scriptJamAt = 5; g.weapons.scriptShots = 0;\n      g.equipBest();\n      g.stepBanner('SHOOT THEM. THE RIFLE WAS RETURNED FOR A REASON.');\n      const jam = eventFlag(g, 'jam');\n      yield () => jam.hit || sq.alive <= 0;\n      jam.off();\n      if (g.weapons.gun?.jam > 0) {\n        g.stepBanner('IT JAMMED. PRESS RELOAD UNTIL IT CLEARS.');\n        yield () => !(g.weapons.gun?.jam > 0);\n      }\n      g.stepBanner('CLEAR THE POST');\n      yield () => sq.alive <= 0;\n      sq.forceLive = false;\n      if (g.body.hp > 60) { g.body.hp = 55; g.body.lastHit = g.time; }\n      g.stepBanner('YOU ARE BLEEDING. USE A SYRETTE.');\n      g.healHint = true;\n      const syr = eventFlag(g, 'syrette');\n      yield () => syr.hit || g.dev.skipScript;\n      syr.off(); g.healHint = false;\n      if (v && v.alive) {\n        v.stalled = true; v.hp = Math.min(v.hp, 10);\n        g.map.setWaypoint(v.x, v.z);\n        g.stepBanner('REPAIR THE TRUCK. HOLD USE AT THE BONNET.');\n        const rep = eventFlag(g, 'vehicle-repaired');\n        yield () => rep.hit || !v.alive || g.dev.skipScript;\n        rep.off();\n      }\n      g.mapMargin?.('');\n    },\n    // ---- M2 ----\n    * m2Free(g, r) {\n      const site = SITES['ranger-post'];\n      const ines = g.actors.buddy('ines');\n      ines.met = true;\n      ines.spawn(g.ctx, site.at[0] + 12, site.at[1] + 8, { hp: 200 });\n      g.world.openCage();\n      yield* say(g, 'm2.cage');\n      const sq = g.actors.squads.get('ranger-post');\n      sq.forceLive = true;\n      for (const s of sq.members) if (!s.dead) s.alertTo(g.player.feet.x, g.player.feet.z, 'player');\n    },\n    // ---- M3 ----\n    * m3Tanker(g, r) {\n      const p3 = POSTS.p3;\n      const v = g.vehicles.spawn('tanker', p3.at[0] + 14, p3.at[1] + 10, 1.4, { paint: 'red', hood: 'plum', roof: 'plum' });\n      r.tags.tanker = v;\n      g.map.setWaypoint(v.x, v.z);\n      g.story.holdFireFaction = 'harvest';\n      g.stepBanner('TAKE THE TANKER AT P3');\n      yield () => g.driving.vehicle === v || !v.alive || g.dev.skipScript;\n      if (!v.alive) { g.story.holdFireFaction = null; return; }\n      const es = SITES['east-siding'];\n      g.map.setWaypoint(es.at[0], es.at[1]);\n      g.stepBanner('DRIVE IT INTO THE SIDING. THEY WILL WAVE AT FUEL.');\n      yield () => Math.hypot(v.x - es.at[0], v.z - es.at[1]) < 32 || !v.alive || g.dev.skipScript;\n      g.stepBanner('GET OUT AND SHOOT IT. RUN.');\n      g.story.holdFireFaction = null;\n      const sq = g.actors.squads.get('east-siding');\n      sq.angry = true;\n      yield 0.2;\n    },\n    // ---- M4 ----\n    * m4Convoy(g, r) {\n      const useBridge = !!r.tags.onBridge;\n      const pts = useBridge ? [...ROADS.back.pts].reverse() : ROADS.saltLoop.pts;\n      const L = polyLength(pts);\n      const mk = (kind, off, tag) => {\n        const at = pointAlong(pts, off, [0, 0, 0]);\n        const v = g.vehicles.spawn(kind, at[0], at[1], at[2], kind === 'truck' ? { paint: 'slate', hood: 'night', roof: 'night', canvas: 'mist' } : { paint: 'slate', hood: 'night', roof: 'mist' });\n        v.driver = 'ai'; v.faction = 'concord'; v.crew = kind === 'technical' ? 2 : 0; v.aiSpeed = 9;\n        v.patrol = { pts, L, s: off, dir: 1, loop: !useBridge };\n        v.convoy = true;\n        if (tag) r.tags[tag] = v;\n        return v;\n      };\n      mk('technical', useBridge ? 60 : 110, 'c1');\n      const truck = mk('truck', useBridge ? 40 : 90, 'payroll');\n      mk('technical', useBridge ? 20 : 70, 'c2');\n      g.world.markPayroll(truck);\n      g.map.setWaypoint(truck.x, truck.z);\n      g.map.see('salt-pan');\n      yield 0.5;\n    },\n    * m4Dov(g, r) {\n      const b = SITES['salt-pan'];\n      const dov = g.actors.buddy('dov');\n      g.weapons.charges = Math.max(g.weapons.charges, 2);\n      r.tags.onBridge = true;\n      g.map.setWaypoint(120, 230);\n      g.stepBanner('PLANT DOV\\'S CHARGES ON THE BRIDGE. HOLD THROW.');\n      const pl = eventFlag(g, 'planted');\n      yield () => (pl.hit && Math.hypot(g.player.feet.x - 120, g.player.feet.z - 230) < 30) || g.dev.skipScript;\n      pl.off();\n      g.stepBanner('WAIT. THROW AGAIN WHEN THE TRUCK IS ON IT.');\n      yield 0.2;\n    },\n    * m4Case(g, r) {\n      const t = r.tags.payroll;\n      const at = t ? [t.x, t.z] : [200, 470];\n      const a = g.rng.story.range(0, 6.28), d = g.rng.story.range(16, 28);\n      const x = at[0] + Math.cos(a) * d, z = at[1] + Math.sin(a) * d;\n      g.places.spawnStoryCase('payroll-case', x, z, 10);\n      g.story.trackerOwned = true;\n      g.dialogue.play('m4.tracker');\n      g.trackerHint = true;\n      yield () => !g.dialogue.active;\n      yield 0.5;\n    },\n    // ---- M5 ----\n    * m5Hold(g, r) {\n      const s = SITES['pump-station'];\n      const sq = g.actors.squads.get('pump-station');\n      sq.forceLive = true;\n      if (sq.alive < 6) sq.alive = 6;\n      g.story.flags.m5Hold = true;\n      g.squadsAlertAll('pump-station');\n      g.holdT = 60;\n      g.stepBanner('HOLD THE PUMP HOUSE. THE CISTERN IS FILLING.');\n      yield () => { if (Math.hypot(g.player.feet.x - s.at[0], g.player.feet.z - s.at[1]) < 34) g.holdT -= 1 / 60; return g.holdT <= 0 || g.dev.skipScript; };\n      g.holdT = 0;\n      g.story.flags.cisternFull = true;\n      sq.forceLive = false;\n      g.stepBanner('THE CISTERN IS FULL. NOW BLOW THE PUMP.');\n    },\n    * m5After(g, r) {\n      if (g.story.flags.cisternFull) {\n        g.dialogue.play('m5.done.wet');\n      } else {\n        g.dialogue.play('m5.done.dry');\n        g.actors.civilians.emptyVillage();\n        g.story.odileRefuses = true;\n        g.story.flags.wellsEmpty = true;\n        g.world.darkenVillage?.();\n      }\n    },\n    // ---- M6 ----\n    * m6Buddy(g, r) {\n      const best = g.actors.liveBuddies().filter((b) => g.clock.abs >= b.woundedUntil).sort((a, b) => b.trust - a.trust)[0];\n      const b = best ?? g.actors.buddy('pell');\n      if (b.id === 'pell') b.met = false;\n      const f = g.player.feet;\n      b.spawn(g.ctx, f.x + 2.5, f.z + 2.5, { hp: 200 });\n      r.tags.m6buddy = b;\n      g.say(b.id, b.id === 'pell' ? 'THE MOTHER SENT ME. YOU WILL NOT LIKE ME.' : 'I HEARD. I AM COMING. DO NOT SAY ANYTHING.', 3);\n      yield 3;\n    },\n    * m6Burn(g, r) {\n      const site = SITES['long-field'], b = r.tags.m6buddy, fire = g.fire;\n      // Count the crop cells.\n      const cells = [];\n      for (let id = 0; id < FN * FN; id++) { const x = fire.wx(id), z = fire.wz(id); if (Math.abs(x - site.at[0]) < 90 && Math.abs(z - site.at[1]) < 60 && fire.fuel[id] > 0) cells.push(id); }\n      g.map.setWaypoint(site.at[0], site.at[1]);\n      const frac = () => { let n = 0; for (const id of cells) if (fire.state[id] !== S.FRESH) n++; return n / Math.max(1, cells.length); };\n      g.burnFrac = frac;\n      yield () => frac() >= 0.1 || g.dev.skipScript;\n      g.stepBanner('IT IS GOING. THE WIND IS CARRYING IT.');\n      yield () => frac() >= 0.5 || g.dev.skipScript;\n      g.wind.pin([-0.9, -0.2], 7);\n      g.dialogue.play('m6.turn');\n      g.music.setMood('fight');\n      yield 1.2;\n      // They go down on fire. Finish it, or spend a syrette and watch them burn out.\n      const f = g.player.feet;\n      if (b && !b.dead) {\n        if (Math.hypot(b.x - f.x, b.z - f.z) > 25) b.cc.teleport([f.x + 8, g.world.heightAt(f.x + 8, f.z + 8) + 0.1, f.z + 8]);\n        b.x = b.cc.feet.x; b.z = b.cc.feet.z;\n        b.fireProof = true;\n        b.goDown(true);\n        g.map.setWaypoint(b.x, b.z);\n        g.dialogue.play('m6.choice');\n        g.stepBanner('SYRETTE, OR FINISH IT');\n        const sv = eventFlag(g, 'buddy-saved'), dd = eventFlag(g, 'buddy-dead');\n        yield () => sv.hit || dd.hit || g.dev.skipScript;\n        sv.off(); dd.off();\n        b.fireProof = false;\n        if (b.id === 'pell' && !b.dead) b.despawn();\n      }\n      g.music.setMood(null);\n      const bunker = g.world.explosives.find((e) => e.tag === 'ammo-bunker');\n      g.map.setWaypoint(bunker.x, bunker.z);\n    },\n    // ---- M7 ----\n    * m7War(g, r) {\n      g.story.war = true; g.story.pass = null; g.story.truce = false;\n      g.clock.set(16);\n      const cut = SITES['the-cut'];\n      const sq1 = g.actors.addSquadDef('cut-harvest', { faction: 'harvest', n: 10, at: [cut.at[0] + 62, cut.at[1] + 28], noReman: true, duty: 'patrol' });\n      const sq2 = g.actors.squads.get('the-cut');\n      sq1.forceLive = true; sq2.forceLive = true; sq2.alive = Math.max(sq2.alive, 10);\n      r.tags.cutTech = g.vehicles.spawn('technical', 250, -262, -0.7, { paint: 'orange', hood: 'red', roof: 'sand' });\n      g.notice('A TECHNICAL ON THE ROAD. NOBODY IS IN IT.', 3);\n      g.fire.ignite(cut.at[0] + 110, cut.at[1] + 30, 6, 'world');\n      g.fire.ignite(cut.at[0] - 110, cut.at[1] + 50, 6, 'world');\n      g.map.setWaypoint(cut.at[0], cut.at[1]);\n      yield 0.2;\n    },\n    * m7Road(g, r) {\n      const b = r.altBuddyNow;\n      if (b) { b.spawn(g.ctx, 255, -240, { hp: 200, following: false, goal: { x: 248, z: -272 } }); b.trust++; }\n      yield 0.2;\n    },\n    * m7Read(g, r) {\n      g.dialogue.play('m7.ledger');\n      yield () => !g.dialogue.active;\n    },\n    * m7After(g) {\n      g.story.war = true;\n      if (g.npcs?.byWho.tibor) g.npcs.byWho.tibor.setActive(false);\n    },\n    // ---- M8 ----\n    * m8Hold(g, r) {\n      const s = SITES['mile-forty'];\n      const px = s.at[0], pz = s.at[1] + 28;\n      g.map.setWaypoint(px, pz);\n      g.world.setCrowdAtPlatform(true);\n      g.shelling = { at: [s.at[0], s.at[1]], r: 55, every: 4.5, t: 3 };\n      g.noTruceHere = true;\n      g.story.noPatrols = true;\n      g.vehicles.stopPatrols();\n      const squads = [];\n      const wave = (key, faction, ax, az) => {\n        const sq = g.actors.addSquadDef(key, { faction, n: 7, at: [ax, az], noReman: true, duty: 'march' });\n        sq.forceLive = true; squads.push(sq);\n        return sq;\n      };\n      wave('m8a', 'concord', s.at[0] - 90, s.at[1] - 55);\n      yield 1;\n      g.holdT = 120;\n      g.stepBanner('HOLD THE PLATFORM');\n      const marks = [[100, 0], [75, 1], [40, 2], [10, 3]];\n      let said = 0, wn = 0;\n      for (;;) {\n        const f = g.player.feet;\n        const nearby = Math.hypot(f.x - px, f.z - pz) < 70 || g.dev.god;\n        if (nearby || g.player.seat) g.holdT -= 1 / 60;\n        if (said < marks.length && g.holdT <= marks[said][0]) { const line = LINES['m8.board'][marks[said][1]]; g.say(line[0], line[1], 3); g.voice.say(line[0], line[1]); said++; }\n        if (wn < 2 && g.holdT <= 80 - wn * 40) { wn++; wave(`m8w${wn}`, wn === 1 ? 'harvest' : 'concord', s.at[0] + (wn === 1 ? 95 : -70), s.at[1] - 40 * wn); }\n        for (const sq of squads) for (const m of sq.members) if (!m.dead && m.duty === 'march' && !m.marchTo && m.state !== 'alert') { m.marchTo = { x: px + g.rng.ai.range(-16, 16), z: pz - g.rng.ai.range(6, 14) }; }\n        if (g.holdT <= 0 || g.dev.skipScript) break;\n        yield 0;\n      }\n      g.holdT = 0;\n      g.world.setCrowdAtPlatform(false);\n      for (const sq of squads) sq.forceLive = false;\n      g.shelling = null;\n      g.dialogue.play('m8.ride');\n      g.stepBanner('GET TO THE FLATCAR');\n      const tr = g.train;\n      tr.place(tr.sAt(s.at[0], s.at[1] + 30));\n      r.tags.flatUse = g.interact.add({ tag: 'mission', liveAt: () => { const c = tr.cars[3]; return [c.x, c.y + 1, c.z]; }, r: 7, wide: true, verb: () => 'CLIMB ON THE GUN', onUse: () => { r.tags.onFlat = true; } });\n      g.map.setWaypoint(tr.cars[3].x, tr.cars[3].z);\n      yield () => r.tags.onFlat || g.dev.skipScript;\n      g.interact.remove(r.tags.flatUse);\n    },\n    * m8Ride(g, r) {\n      const tr = g.train;\n      g.player.seatOnTrain(3, [0, 2.3, 1.2], true, 0.15);\n      g.weapons.mounted = { turret: () => { const c = tr.cars[3]; if (c.turret) c.turret.rotation.y = g.player.yaw - c.yaw + Math.PI; } };\n      tr.whistle();\n      const goal = tr.sAt(425, -58);\n      const L = Math.abs(goal - tr.s);\n      tr.run(goal, L / 58);\n      g.holdT = 60;\n      // Technicals and riflemen along the line, on rails, under fire.\n      g.story.pass = null;\n      const line = [[120, 25, 'harvest'], [190, 2, 'concord'], [250, -24, 'harvest'], [330, -60, 'concord'], [390, -80, 'harvest']];\n      line.forEach(([x, z, f], i) => { const sq = g.actors.addSquadDef(`m8r${i}`, { faction: f, n: 4, at: [x, z], noReman: true }); sq.forceLive = true; });\n      const a = g.vehicles.spawn('technical', 110, 44, 1.4, { paint: 'slate', hood: 'night', roof: 'mist' }); a.driver = 'ai'; a.faction = 'concord'; a.crew = 0; a.aiSpeed = 11; a.patrol = { pts: [[110, 50], [240, 20], [320, 0], [420, -40]], L: 340, s: 0, dir: 1 };\n      r.tags.m8car = a;\n      yield () => { g.holdT -= 1 / 60; return !tr.moving || g.dev.skipScript; };\n      g.holdT = 0;\n      g.weapons.mounted = null;\n      for (let i = 0; i < 5; i++) { const sq = g.actors.squads.get(`m8r${i}`); if (sq) sq.forceLive = false; }\n      if (a.alive) g.vehicles.remove(a);\n      g.player.leaveTrain(415, -48);\n      g.dialogue.play('m8.done');\n      g.story.noPatrols = false;\n      yield () => !g.dialogue.active;\n    },\n    * m8After(g) { g.story.flags.columnWalking = true; g.world.startColumn(); },\n    // ---- M9 ----\n    * m9Scene(g, r) {\n      const n = g.npcs.byWho.harrow;\n      g.ending.harrowScene(n);\n      yield () => g.ending.sceneStep >= 1 || g.dev.skipScript;\n      g.dialogue.play('m9.scene');\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.ending.layMap();\n      g.dialogue.play('m9.lay');\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.dialogue.play('m9.offer');\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.dialogue.stopAll();\n      let shot = null;\n      g.ui.choice('FINISH YOUR CONTRACT?', [{ label: 'SHOOT HIM', id: 'shoot', onSelect: () => { shot = true; } }, { label: 'LEAVE HIM THE LAMP', id: 'spare', onSelect: () => { shot = false; } }], { noBack: true });\n      yield () => shot != null;\n      g.story.chose.shoot = shot;\n      if (shot) {\n        g.ending.shootHarrow();\n        g.dialogue.play('m9.shot');\n        g.ledger.add('paid', 1);\n        g.ledger.note('harrow', 'shot');\n      } else {\n        g.dialogue.play('m9.spared');\n        g.ledger.note('harrow', 'spared');\n      }\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.dialogue.play('m9.sheet');\n      yield () => !g.dialogue.active || g.dev.skipScript;\n      g.dialogue.stopAll();\n      let sheet = null;\n      g.ui.choice('WHO GETS THE SHEET?', [{ label: 'WALK OUT WITH IT', id: 'alone', onSelect: () => { sheet = 'alone'; } }, { label: 'GIVE IT TO THE COLUMN', id: 'column', onSelect: () => { sheet = 'column'; } }], { noBack: true });\n      yield () => sheet != null;\n      g.story.sheet = sheet;\n      g.body.tablets += 6;\n      g.ending.endHarrowScene();\n      yield 0.5;\n    },\n    // ---- The Pass ----\n    * endPass(g, r) {\n      g.sky.setWeather('clear');\n      g.clock.set(4.6);\n      g.story.war = true; g.story.pass = null;\n      const sheet = g.story.sheet ?? 'alone';\n      const pass = SITES['the-pass'];\n      g.player.teleport(-400, -360);\n      g.player.setYaw(Math.atan2(190, 70), 0);\n      g.endingMusic = false;\n      if (sheet === 'column') {\n        g.map.setWaypoint(-430, -382);\n        g.world.setColumnHead(-436, -388);\n        g.stepBanner('TAKE THE SHEET TO THE COLUMN');\n        let given = false;\n        const u = g.interact.add({ tag: 'mission', x: -436, y: g.world.heightAt(-436, -388) + 1.4, z: -388, r: 5, wide: true, verb: () => 'GIVE THEM THE SHEET', onUse: () => { given = true; } });\n        yield () => given || g.dev.skipScript;\n        g.interact.remove(u);\n        g.dialogue.play('end.column');\n        g.world.columnGoesThrough();\n        g.ledger.add('moved', 600);\n        yield () => !g.dialogue.active;\n        g.stepBanner('HOLD BEHIND THEM');\n        g.map.setWaypoint(-520, -420);\n      } else {\n        g.dialogue.play('end.alone');\n        g.map.setWaypoint(pass.at[0], pass.at[1]);\n        g.stepBanner('WALK TO THE PASS');\n      }\n      const px = sheet === 'column' ? -520 : -565, pz = sheet === 'column' ? -420 : -425;\n      yield () => Math.hypot(g.player.feet.x - px, g.player.feet.z - pz) < 26 || g.dev.skipScript;\n      // Pursuit from both armies.\n      for (const [k, f, x, z] of [['endA', 'concord', px + 70, pz + 30], ['endB', 'harvest', px + 90, pz - 40]]) {\n        const sq = g.actors.addSquadDef(k, { faction: f, n: 6, at: [x, z], noReman: true, duty: 'march' });\n        sq.forceLive = true;\n      }\n      g.stepBanner(sheet === 'column' ? 'HOLD THE PASS' : 'THEY ARE BEHIND YOU');\n      g.holdT = 45;\n      yield () => { g.holdT -= 1 / 60; return g.holdT <= 0 || g.dev.skipScript; };\n      g.holdT = 0;\n      // The surviving buddies come for the stones.\n      const friends = g.actors.liveBuddies();\n      for (const b of friends) {\n        yield 1.5;\n        const key = `end.${b.id}`;\n        b.spawn(g.ctx, px + g.rng.story.range(8, 14), pz + g.rng.story.range(-14, 14), { hp: 200, following: false, goal: null });\n        b.isHostile = false;\n        g.faceActor(b);\n        g.dialogue.play(key);\n        yield () => !g.dialogue.active || g.dev.skipScript;\n        g.faceActor(null);\n        let answer = null;\n        if (b.trust >= 3) {\n          g.ui.choice(`${b.name} OFFERS TO SPLIT IT`, [{ label: 'SPLIT THE STONES', id: 'split', onSelect: () => { answer = 'split'; } }, { label: 'REFUSE', id: 'refuse', onSelect: () => { answer = 'refuse'; } }], { noBack: true });\n          yield () => answer != null;\n        } else answer = 'refuse';\n        if (answer === 'split') {\n          g.story.stones = Math.floor(g.story.stones / 2);\n          g.say(b.id, 'THAT IS FAIR. THAT IS WHAT I WILL TELL THEM.', 3);\n          g.ledger.note('split', b.id);\n          b.goal = { x: b.x + 60, z: b.z + 60 };\n          yield 3;\n          b.despawn();\n        } else {\n          g.dialogue.play('end.refuse');\n          b.turnOn('player');\n          g.map.setWaypoint(b.x, b.z);\n          g.stepBanner(`${b.name} DRAWS`);\n          yield () => b.dead || g.dev.skipScript;\n          if (!b.dead) b.killed('pass');\n          g.say('', `${b.name} HAS STOPPED OWING ANYONE.`, 3);\n          yield 2;\n        }\n      }\n      // The last grass is yours to light.\n      g.dialogue.play('end.light');\n      g.weapons.give('flare', 100, true);\n      if (g.weapons.gun?.mag === 0) g.weapons.gun.mag = 1;\n      g.stepBanner('LIGHT THE GRASS');\n      g.wind.pin([0.9, 0.5], 6);\n      const before = g.fire.counts.lit;\n      yield () => g.fire.counts.lit > before || g.dev.skipScript;\n      yield 5;\n      g.ending.finish(sheet);\n      yield () => false;\n    },\n  };\n}\nEOF\necho ok","description":"Write story, missions, step types, runner and scripted coroutines"}}}
