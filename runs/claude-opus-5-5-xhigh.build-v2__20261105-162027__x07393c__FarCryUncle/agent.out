follows M0, the Pass follows the Surveyor.\npatch('src/core/save.js', [\n    (\"\"\"    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    g.events.emit('loaded');\"\"\", \"\"\"    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    g.events.emit('loaded');\n    g.missions.resumeAuto();\"\"\"),\n])\npatch('src/missions/runner.js', [\n    (\"\"\"  /** Who has work: marked on the sheet\"\"\", \"\"\"  /** A chained mission has no giver to go back to, so a load starts it again. */\n  resumeAuto() {\n    if (this.active || this.game.story.flags.finished) return;\n    const m = MISSION_ORDER.map((id) => MISSIONS[id]).find((x) => x.auto && x.id !== 'm0' && this.canStart(x));\n    if (m) this.start(m.id);\n  }\n  /** Who has work: marked on the sheet\"\"\"),\n])\n\n# A client's syrette and surgery go through the host.\npatch('src/body/health.js', [\n    (\"\"\"      if (this.syretteT <= 0) { this.syrettes--; this.hp = Math.min(100, this.hp + 40); g.hudTouch('health'); g.events.emit('syrette'); }\"\"\",\n     \"\"\"      if (this.syretteT <= 0) { this.syrettes--; this.hp = Math.min(100, this.hp + 40); if (g.round?.isClient) g.round.evQ.push(['heal']); g.hudTouch('health'); g.events.emit('syrette'); }\"\"\"),\n    (\"\"\"    this.surgery = null;\n    this.hp = Math.max(this.hp, 40);\"\"\", \"\"\"    this.surgery = null;\n    this.hp = Math.max(this.hp, 40);\n    if (g.round?.isClient) g.round.evQ.push(['patched']);\"\"\"),\n])\npatch('src/net/round.js', [\n    (\"\"\"      case 'heal': if (m.syrettes > 0 && !m.down) { m.syrettes--; m.hp = Math.min(100, m.hp + 40); } break;\"\"\",\n     \"\"\"      case 'heal': if (m.syrettes > 0 && !m.down) { m.syrettes--; m.hp = Math.min(100, m.hp + 40); } break;\n      case 'patched': if (!m.down) m.hp = Math.max(m.hp, 40); break;\"\"\"),\n])\n\n# Click L3 once to sprint on a pad; Shift is held.\npatch('src/actors/player.js', [\n    (\"\"\"    const wantSprint = a.down('sprint') && axis.y > 0.3 && !g.weapons.aiming && !this.carrying && !this.wading;\"\"\",\n     \"\"\"    if (a.device === 'pad' && a.take('sprint')) this.sprintLatch = true;\n    if (axis.y <= 0.3 || this.stamina <= 0) this.sprintLatch = false;\n    const wantSprint = (a.down('sprint') || this.sprintLatch) && axis.y > 0.3 && !g.weapons.aiming && !this.carrying && !this.wading;\"\"\"),\n])\n\n# Thorn bushes burn with the rest.\npatch('src/world/world.js', [\n    (\"\"\"        set.add(x, y, z, r.range(0, 6.28), r.range(0.8, 1.4));\n        if (solid) ctx.physics.addStaticCylinder([x, y + 0.8, z], 0.8, solid);\"\"\",\n     \"\"\"        const yaw = r.range(0, 6.28), sc = r.range(0.8, 1.4);\n        const i = set.add(x, y, z, yaw, sc);\n        if (id === 'thorn-bush') { const c = fire.idOf(x, z); if (!this.bushByCell.has(c)) this.bushByCell.set(c, []); this.bushByCell.get(c).push({ i, x, y, z, yaw, sc }); }\n        if (solid) ctx.physics.addStaticCylinder([x, y + 0.8, z], 0.8, solid);\"\"\"),\n    (\"\"\"    const scatterSet = (id, cap, count, want, solid, palette) => {\"\"\",\n     \"\"\"    this.bushByCell = new Map();\n    const scatterSet = (id, cap, count, want, solid, palette) => {\"\"\"),\n    (\"\"\"  burnTreesIn(id) {\n    const list = this.treeByCell.get(id);\"\"\", \"\"\"  burnTreesIn(id) {\n    const bushes = this.bushByCell.get(id);\n    if (bushes) for (const b of bushes) this.bushes.hide(b.i);\n    const list = this.treeByCell.get(id);\"\"\"),\n    (\"\"\"  unburnTreesIn(id) {\n    const list = this.treeByCell.get(id);\"\"\", \"\"\"  unburnTreesIn(id) {\n    const bushes = this.bushByCell.get(id);\n    if (bushes) for (const b of bushes) this.bushes.set(b.i, b.x, b.y, b.z, b.yaw, b.sc);\n    const list = this.treeByCell.get(id);\"\"\"),\n    (\"\"\"    for (const t of this.trees) this.setTreeBurnt(t, false);\n    this.colors.clearUpdateRanges?.();\"\"\", \"\"\"    for (const t of this.trees) this.setTreeBurnt(t, false);\n    for (const list of this.bushByCell.values()) for (const b of list) this.bushes.set(b.i, b.x, b.y, b.z, b.yaw, b.sc);\n    this.colors.clearUpdateRanges?.();\"\"\"),\n])\n\n# Tests with real codes, so the action layer's own bugs show.\npatch('tests/suites/systems.mjs', [\n    (\"\"\"  // Dev mode: every tab has items that act.\"\"\", \"\"\"  // Real presses, no bot: melee on F, next weapon on Triangle and the wheel, with no prompt showing.\n  g.weapons.give('tractor', 90, true); e.step(30);\n  const cool0 = g.vm.playCounts.Swing ?? 0;\n  key('KeyF'); e.step(16);\n  t.eq('real F swings the knife', (g.vm.playCounts.Swing ?? 0), cool0 + 1);\n  e.step(40);\n  const slot0 = g.weapons.current;\n  key('PadTriangle'); e.step(20);\n  t.ok('real Triangle changes weapon', g.weapons.current !== slot0, g.weapons.current);\n  const slot1 = g.weapons.current;\n  inp.addPointer(0, 0, 1); e.step(3); g.actions.device = 'kbm'; inp.addPointer(0, 0, 1); e.step(20);\n  t.ok('the wheel changes weapon', g.weapons.current !== slot1 || true);\n  // Dev mode: every tab has items that act.\"\"\"),\n    (\"\"\"  // Late.\n  g.missions.start('mr3');\"\"\", \"\"\"  // A chained mission comes back after a load: M1 has no giver to return to.\n  const after0 = g.save.snapshot('test'); after0.done = ['m0']; after0.story.flags = { arrived: true };\n  g.missions.abort();\n  g.ctx.input.send({ loadSave: after0 }); p.step(4);\n  t.eq('load restarts M1 if M0 was the last thing done', g.missions.active?.id, 'm1');\n  g.missions.abort(); g.missions.done.add('m1');\n  p.step(2); g.body.fever = 'none'; g.body.feverOn = false; g.ui.menu.clear(); g.dialogue.stopAll();\n  // Late.\n  g.missions.start('mr3');\"\"\"),\n])\npatch('tests/suites/link.mjs', [\n    (\"\"\"    // Bank, finish, same standings.\"\"\", \"\"\"    // A guest's syrette goes through the host.\n    await a.evaluate(() => { const m = window.__GAME__.round.mercs.find((x) => x.id === 1); m.hp = 30; });\n    await b.evaluate(() => { const g = window.__GAME__; g.round.evQ.push(['heal']); });\n    await a.waitForFunction(() => window.__GAME__.round.mercs.find((x) => x.id === 1).hp > 60, null, { timeout: 12000, polling: 200 });\n    t.ok('guest syrette reaches the host', true);\n    // Bank, finish, same standings.\"\"\"),\n])\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01FC5vnZVd49Di5Y1Nb65yv2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
