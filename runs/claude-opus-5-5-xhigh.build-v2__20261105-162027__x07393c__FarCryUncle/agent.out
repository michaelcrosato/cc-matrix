 = model(\")\ns=s[:i]+\"\"\"// Fort Clement: the library's coursed stone over a solid core, a walkway on top, a parapet on the outer (-z) side.\nconst fortRun = (from, to, h = 5) => {\n  const out = [{ box: [to - from, h, 1.2], at: [(from + to) / 2, h / 2, 0], c: 'dark' }];\n  for (let x = from; x < to; x += 6) { const l = Math.min(6, to - x); for (const z of [-0.47, 0.47]) out.push({ use: 'stone-wall', params: { length: l, height: h }, at: [x + l / 2, 0, z], collide: false }); }\n  for (let x = from; x < to; x += 8) { const m = Math.min(8, to - x); out.push({ use: 'battlement', params: { merlons: m }, at: [x + m / 2, h, -0.39], collide: false }); }\n  return out;\n};\nexport const fortWall = model({ id: 'fort-wall', about: 'A colonial stone wall of Fort Clement, gate in the middle', tags: ['building'], collider: 'parts', palette: { stone: 'mist', dark: 'slate' },\n  parts: [...fortRun(-36, -4), ...fortRun(4, 36), { box: [8.2, 1.8, 1.2], at: [0, 5.1, 0], c: 'stone', collide: false }, { use: 'battlement', params: { merlons: 8 }, at: [0, 6, -0.39], collide: false }, { box: [0.3, 0.6, 0.1], at: [-4.2, 3.2, 0.64], c: 'dark', collide: false }] });\nexport const fortWallSide = model({ id: 'fort-wall-side', about: 'A plain length of the fort wall', tags: ['building'], collider: 'parts', palette: { stone: 'mist', dark: 'slate' }, parts: fortRun(-38, 38) });\n\"\"\"+s[j:]\nopen('src/art/models.js','w').write(s)\npatch('src/content/sites.js',[(\"\"\"['stone-wall', -28, 24, 90], ['stone-wall', 28, 24, 90], ['battlement', -24, 32, 0], ['battlement', 24, 32, 0], \"\"\",\"\" ),\n(\"\"\"['fort-wall-side', 38, 0, 90]\"\"\",\"\"\"['fort-wall-side', 38, 0, -90]\"\"\"),])\npatch('tests/suites/systems.mjs',[(\"\"\"  // Into the gears and back: the shifter clip of hand position runs on speed.\n\"\"\",\"\"),\n(\"\"\"const TRUCK_AT_X = 150, TRUCK_AT_Z = -204;\"\"\",\"\"\"// The cab as you see it: hands where the eye can find them, and the right one goes to the lever on a gear change.\nasync function cabHandsWork(t) {\n  const { game: g, engine: e } = await boot({ forceViews: true, seed: 1 });\n  g.startNew(); e.step(5); g.dev.startMission('m3'); e.step(5); g.ui.menu.clear(); g.dialogue.stopAll();\n  g.player.teleport(90, 65);\n  const v = g.vehicles.spawn('technical', 95, 66, 1.3); e.step(30); g.driving.enter(v); e.step(10);\n  const cab = g.vehicles, cam = g.ctx.camera.three ?? g.ctx.camera.camera ?? g.ctx.camera;\n  const seen = (o) => { const n = o.getWorldPosition(new THREE.Vector3()).project(cam); return Math.abs(n.x) < 1 && Math.abs(n.y) < 1; };\n  e.step(2);\n  t.ok('both hands are in frame on the wheel', seen(cab.cabGripL) && seen(cab.cabGripR));\n  t.ok('the lever is in frame', seen(cab.cabShifter.children.at(-1)));\n  const toHand = (arm, part) => { const end = arm.localToWorld(new THREE.Vector3(0, 0, 1)); return end.distanceTo(part.getWorldPosition(new THREE.Vector3())); };\n  t.near('the left forearm reaches its hand', toHand(cab.cabArmL, cab.cabGripL), 0, 0.01);\n  v.car.speed = 0; g.driving.gear = 0; g.driving.shiftT = 0;\n  v.car.speed = 9; g.driving.shiftT = 0; e.step(1);\n  const mid = () => { g.driving.shiftT = 0.25; e.step(1); };\n  mid();\n  t.ok('mid shift the right hand has left the wheel', !cab.cabGripR.visible && cab.cabHandR.visible);\n  t.ok('mid shift the lever is thrown', Math.abs(cab.cabShifter.rotation.x) > 0.1);\n  t.near('the right forearm reaches the moving hand', toHand(cab.cabArmR, cab.cabHandR), 0, 0.01);\n  g.driving.shiftT = 0; e.step(2);\n  t.ok('then it is back on the wheel', cab.cabGripR.visible && !cab.cabHandR.visible);\n  e.dispose();\n}\nconst TRUCK_AT_X = 150, TRUCK_AT_Z = -204;\"\"\"),\n(\"\"\"export async function run(t) {\"\"\",\"\"\"export async function run(t) {\n  await cabHandsWork(t);\"\"\"),\n])\nEOF\ngrep -n \"^import.*THREE\\|pixel-engine\" tests/suites/systems.mjs | head -3 | cut -c1-150\ncat > /dev/null <<'EOF'\nEOF\ncat > tools/tmp-fort.mjs <<'EOF'\nimport { buildModel, THREE } from '../pix