{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkeHGf6VU2LoeyqeenZv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UWDxrfX2SZJGoZcCH7T8aR","name":"Bash","input":{"command":"set -e\ncat > src/content/tuning-defaults.js <<'EOF'\n// Every balance number that dev mode exposes. Systems read TUNING.x at the moment of use and never cache it.\nexport const SLIDERS = [\n  { key: 'playerSpeed', label: 'PLAYER SPEED', def: 1, min: 0.5, max: 2, step: 0.05 },\n  { key: 'playerDamageTaken', label: 'DAMAGE TAKEN', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'weaponDamage', label: 'WEAPON DAMAGE', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'enemyHealth', label: 'ENEMY HEALTH', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'enemyAccuracy', label: 'ENEMY ACCURACY', def: 1, min: 0.25, max: 3, step: 0.05 },\n  { key: 'enemyVision', label: 'ENEMY VISION M', def: 90, min: 20, max: 200, step: 5 },\n  { key: 'enemyReaction', label: 'ENEMY REACTION S', def: 0.45, min: 0.1, max: 2, step: 0.05 },\n  { key: 'wearRate', label: 'WEAR RATE', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'jamRate', label: 'JAM RATE', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'fireSpread', label: 'FIRE SPREAD', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'fireDamage', label: 'FIRE DAMAGE HP/S', def: 8, min: 0, max: 30, step: 1 },\n  { key: 'windEffect', label: 'WIND EFFECT', def: 1, min: 0, max: 3, step: 0.05 },\n  { key: 'feverMinutes', label: 'FEVER MINUTES', def: 12, min: 2, max: 40, step: 1 },\n  { key: 'vehicleTopSpeed', label: 'VEHICLE TOP SPEED', def: 26, min: 10, max: 45, step: 1 },\n  { key: 'vehicleToughness', label: 'VEHICLE TOUGHNESS', def: 1, min: 0.25, max: 4, step: 0.05 },\n  { key: 'stonesReward', label: 'STONES REWARD', def: 1, min: 0, max: 5, step: 0.1 },\n  { key: 'buddyWoundChance', label: 'BUDDY WOUND CHANCE', def: 0.15, min: 0, max: 1, step: 0.05 },\n  { key: 'dayMinutes', label: 'DAY MINUTES', def: 30, min: 2, max: 120, step: 1 },\n  { key: 'postRemanHours', label: 'POST REMAN HOURS', def: 24, min: 1, max: 96, step: 1 },\n  { key: 'regrowHours', label: 'REGROW HOURS', def: 48, min: 1, max: 200, step: 1 },\n];\nexport const TUNING_DEFAULTS = Object.fromEntries(SLIDERS.map((s) => [s.key, s.def]));\nEOF\ncat > src/core/tuning.js <<'EOF'\nimport { TUNING_DEFAULTS } from '../content/tuning-defaults.js';\nexport const TUNING = { ...TUNING_DEFAULTS };\nexport const resetTuning = (key) => {\n  if (key) TUNING[key] = TUNING_DEFAULTS[key];\n  else Object.assign(TUNING, TUNING_DEFAULTS);\n};\nEOF\ncat > src/core/events.js <<'EOF'\n// A tiny event bus: systems announce, missions and the Ledger listen.\nexport class Events {\n  map = new Map();\n  on(name, fn) { if (!this.map.has(name)) this.map.set(name, new Set()); this.map.get(name).add(fn); return () => this.map.get(name).delete(fn); }\n  emit(name, ...args) { const s = this.map.get(name); if (s) for (const fn of [...s]) fn(...args); }\n  clear() { this.map.clear(); }\n}\nEOF\ncat > src/core/rng.js <<'EOF'\n// Small deterministic helpers. Gameplay randomness comes from ctx.random.fork(name); these are pure hashes.\nexport function hash2(x, z) {\n  let h = Math.imul(x | 0, 374761393) + Math.imul(z | 0, 668265263);\n  h = Math.imul(h ^ (h >>> 13), 1274126177);\n  return ((h ^ (h >>> 16)) >>> 0) / 4294967296;\n}\nexport function hashStr(s) {\n  let h = 2166136261;\n  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }\n  return h >>> 0;\n}\nexport const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);\nexport const lerp = (a, b, t) => a + (b - a) * t;\nexport const smooth = (t) => { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); };\nexport const dist2d = (ax, az, bx, bz) => Math.hypot(ax - bx, az - bz);\nexport const wrapAngle = (a) => { while (a > Math.PI) a -= Math.PI * 2; while (a < -Math.PI) a += Math.PI * 2; return a; };\nEOF\ncat > src/core/look.js <<'EOF'\n// The first-person step, replacing the rig's: Q and E stay ours, scenes and chase cameras override it.\nexport function installLook(ctx, cam) {\n  const rig = ctx.camera;\n  if (rig.preset !== 'first') return;\n  rig.step = function (u) {\n    if (cam.override) {\n      this.camera.position.set(...cam.override.position);\n      this.camera.lookAt(...cam.override.target);\n      this.focus.copy(this.camera.position);\n      return;\n    }\n    const k = cam.enabled ? 1 : 0;\n    const scaleX = cam.padFrame ? cam.sensPad : cam.sensMouse;\n    const assist = cam.padFrame ? cam.assist : 1;\n    this.yaw -= u.input.mouseDelta.x * 0.0025 * scaleX * assist * k * cam.lookScale;\n    this.pitch = Math.max(-1.45, Math.min(1.45, this.pitch - u.input.mouseDelta.y * 0.0025 * scaleX * assist * (cam.invertY ? -1 : 1) * k * cam.lookScale));\n    this.yaw += cam.kickYaw; this.pitch = Math.max(-1.45, Math.min(1.45, this.pitch + cam.kickPitch));\n    cam.kickYaw = 0; cam.kickPitch = 0;\n    this.focus.copy(u.target);\n    this.camera.position.copy(u.eye);\n    this.camera.rotation.order = 'YXZ';\n    this.camera.rotation.set(this.pitch, this.yaw, cam.roll);\n  };\n}\nexport const makeCamState = () => ({ override: null, enabled: true, sensPad: 1, sensMouse: 1, invertY: false, padFrame: false, assist: 1, lookScale: 1, roll: 0, kickYaw: 0, kickPitch: 0 });\nEOF\ncat > src/content/roads.js <<'EOF'\n// Polylines as data: [x, z] pairs. `w` is the flattened half width; `track` draws thin on the map.\nexport const ROADS = {\n  north: { pts: [[0, 40], [60, -20], [90, -80], [60, -130], [40, -170], [150, -200], [280, -210], [240, -280], [190, -310]] },\n  west: { pts: [[0, 40], [-100, 35], [-200, 30], [-240, 120], [-260, 240], [-300, 320], [-330, 390]] },\n  fort: { pts: [[-200, 30], [-260, -30], [-320, -90], [-380, -140], [-430, -180], [-400, -250], [-330, -290], [-260, -300]] },\n  east: { pts: [[0, 40], [90, 65], [170, 90], [250, 80], [320, 60]] },\n  granary: { pts: [[320, 60], [350, 160], [400, 280]] },\n  siding: { pts: [[320, 60], [380, 0], [430, -60], [470, -180]] },\n  salt: { pts: [[400, 280], [350, 340], [300, 390], [200, 470], [120, 505]] },\n  saltLoop: { pts: [[300, 390], [200, 470], [120, 505], [110, 430], [200, 395], [300, 390]], track: true, loop: true },\n  back: { pts: [[0, 40], [60, 130], [120, 230], [210, 320], [300, 390]] },\n  pass: { pts: [[-260, -300], [-400, -370], [-520, -420], [-590, -430]], track: true },\n  obs: { pts: [[150, -300], [110, -360], [60, -400], [-30, -420], [-60, -480], [-130, -470], [-100, -520], [-130, -520]], track: true },\n  ford: { pts: [[0, 40], [-30, 160], [-60, 300], [-70, 380], [-140, 430]], track: true },\n};\nexport const RAIL = {\n  main: [[-640, 110], [-300, 100], [0, 70], [200, 30], [270, -5], [430, -60], [640, -110]],\n  spur: [[215, 20], [205, -120], [190, -250], [180, -285]],\n};\nexport const RIVER = [[600, -640], [420, -320], [300, -120], [250, 80], [120, 230], [-60, 300], [-240, 380], [-420, 430], [-640, 470]];\nexport const RIVER_Y = 38;\nexport const BRIDGES = [{ id: 'bridge-east', at: [250, 80], road: 'east' }, { id: 'bridge-back', at: [120, 230], road: 'back' }];\nexport const RAIL_BRIDGE = { at: [270, -5] };\nexport const FORD = { at: [-60, 300], r: 16 };\n// Story scars. Together they are one line across the Kettle, which is the plot.\nexport const STRIPS = {\n  A: { pts: [[430, -60], [330, -190], [220, -280], [150, -300]], width: 18 },\n  C: { pts: [[150, -300], [60, -330], [-20, -335]], width: 18 },\n  B: { pts: [[-20, -335], [-140, -330], [-260, -300], [-400, -370], [-520, -420], [-590, -430]], width: 18 },\n};\nEOF\ncat > src/content/sites.js <<'EOF'\n// Every place in the Kettle, as data. `r`: flatten radius. `props`: [modelId, dx, dz, turnDegrees, options]. `squad`: who holds it.\nconst sb = (dx, dz, t = 0) => ['sandbag-run', dx, dz, t];\nexport const SITES = {\n  'mile-forty': { name: 'MILE FORTY', at: [0, 40], r: 78, map: 'town', noFire: 70,\n    props: [\n      ['station', -6, 28, 0], ['signal-mast', 40, 33, 0], ['clinic-tent', -46, -8, 90], ['shack', 34, -22, 200], ['bar', -22, -40, 180],\n      ['market-stall', 10, 6, 20], ['market-stall', -14, 8, -15], ['market-stall', 4, -8, 170], ['notice-board', 0, 18, 0], ['well', 12, -30, 0], ['lamp-post', -8, 14, 0], ['lamp-post', 24, 4, 0],\n      ['crate', 40, -22, 10], ['crate', 42, -19, 40], ['barrel', 38, -28, 0], ['sack', -30, -2, 0], ['sack', -32, -1, 30], ['shack', -60, 34, 90], ['shack', 60, 10, -90], ['radio-mast', -70, -36, 0],\n    ],\n    use: [\n      { id: 'tibor', kind: 'shop', dx: 34, dz: -16, verb: 'SEE TIBOR' },\n      { id: 'board', kind: 'board', dx: 0, dz: 17, verb: 'READ THE NOTICE BOARD' },\n      { id: 'bar-buddies', kind: 'bar', dx: -22, dz: -32, verb: 'WHO IS AT THE BAR' },\n    ],\n    npcs: [ { who: 'odile', dx: -40, dz: -8, yaw: 90 }, { who: 'tibor', dx: 34, dz: -18, yaw: 0 }, { who: 'bakr', dx: 8, dz: 30, yaw: 180 } ],\n    halts: 'halt-mile',\n  },\n  'pump-shed': { name: 'PUMP SHED', at: [-120, 150], r: 22, map: 'house', safehouse: true, starts: true,\n    props: [['shack', 0, 0, 30], ['oil-drum', 7, 4, 0], ['oil-drum', 8, 2, 0], ['crate', -6, 6, 15], ['acacia-a', 14, -8, 0]],\n    safe: { bed: [2, -1], locker: [-2, -1], crate: [3, 2], wall: [0, -3] },\n  },\n  'ranger-post': { name: 'RANGER POST', at: [40, -170], r: 34, map: 'post', faction: 'concord', safehouseAfter: 'm2',\n    props: [['barracks', -10, -14, 10], ['watchtower', 16, -18, 0], ['cage', 12, 8, 0], sb(-16, 12, 0), sb(-8, 16, 20), sb(20, 14, -30), ['crate', -2, 2, 0], ['oil-drum', 2, -2, 0], ['radio-mast', -22, -2, 0]],\n    squad: { faction: 'concord', n: 8, tower: [16, -18] }, safe: { bed: [-12, -14], locker: [-8, -14], crate: [-5, -11], wall: [-10, -18] },\n    cover: [[-16, 12], [-8, 16], [20, 14], [-2, 2]], tag: 'ranger',\n  },\n  'water-tower': { name: 'WATER TOWER', at: [470, -180], r: 34, map: 'house', faction: 'harvest', safehouse: true, guarded: true,\n    props: [['water-tower', 0, -8, 0], ['shack', -14, 8, 80], ['shack