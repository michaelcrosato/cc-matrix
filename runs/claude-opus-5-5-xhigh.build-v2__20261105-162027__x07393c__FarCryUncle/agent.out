erRunning = true; g.story.stones = 50; g.body.tablets = 0; g.body.hp = 100; g.dev.god = true;\n  const at = g.player.feet.clone();\n  g.body.startFever();\n  t.eq('the fever comes in the last act too', g.body.fever, 'on');\n  p.step(60 * 27);\n  t.eq('ignored, it drops you and it is over', g.body.fever, 'none');\n  p.step(60 * 3);\n  t.eq('it costs you a fifth of your stones', g.story.stones, 40);\n  t.eq('the mission goes on', g.state().mission, 'm8');\n  t.near('you get up where you fell', Math.hypot(g.player.feet.x - at.x, g.player.feet.z - at.z), 0, 25);\n  t.ok('and you can move again', !g.player.frozen);\n  e.dispose();\n}\nconst TRUCK_AT_X = 150, TRUCK_AT_Z = -204;\"\"\",1)\nopen('tests/suites/systems.mjs','w').write(s)\ns=open('tests/suites/static.mjs').read()\na=\"  // The step types the plan names, and its weapon table.\\n\"\nassert a in s\ns=s.replace(a,\"\"\"  // M3's wind is the plan's own.\n  const { MISSIONS: M } = await import('../../src/content/missions.js');\n  t.eq('M3 wind is the plan\\\\'s', JSON.stringify(M.m3.wind), JSON.stringify({ dir: [-0.8, -0.6], speed: 5 }));\n\"\"\"+a,1)\nopen('tests/suites/static.mjs','w').write(s)\ns=open('tools/shots.mjs').read()\na=\"  cab: `\"\ns=s.replace(a,\"\"\"  fogplan: `g.dev.startMission('m2'); e.step(5); g.ui.menu.clear(); g.dialogue.stopAll(); g.clock.set(10); g.player.teleport(90,65); g.player.setYaw(1.3,-0.02); e.step(40); const f=g.sky.fog; f.top.value=-60; f.amount.value=0.55; e.step(10);`,\n  fogmine: `g.dev.startMission('m2'); e.step(5); g.ui.menu.clear(); g.dialogue.stopAll(); g.clock.set(10); g.player.teleport(90,65); g.player.setYaw(1.3,-0.02); e.step(40); const f=g.sky.fog; f.top.value=1; f.amount.value=0.55; e.step(10);`,\n  cab: `\"\"\",1)\nopen('tools/shots.mjs','w').write(s)\ns=open('tests/ISSUES.md').read().rstrip('\\n')\ns+=\"\"\"\n- M3's wind had been changed from the plan's to suit where I put the tanks. With the plan's wind only 2 of 12 upwind fires reached a tank, because the road and t