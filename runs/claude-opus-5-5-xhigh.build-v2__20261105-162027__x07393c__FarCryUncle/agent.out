{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgVMQfYXAr4XkuwHguV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DUA6Wf2mgNYZ2PHWVQub7H","name":"Bash","input":{"command":"set -e\ncat > ../PROGRESS.md <<'EOF'\n# PROGRESS (read me first after a context reset)\n\nTitle: **Far Cry Uncle** (item 7 of 50 from a real RNG draw).\nDev folder: `FarCryUncle-FarCry2-claude-opus-5-5-xhigh-20261105-162027/`\nDeliverable: `FarCryUncle-FarCry2-claude-opus-5-5-xhigh-20261105-162027.html` + `exit-interview.json` in this folder (work root).\nEngine: 0.46.0 (same as plan). Plan file: PLAN.md. Brief: TASK.md.\nTest: `cd <dev> && node tests/run.mjs [--all] [--only suite]`. Build: `node tools/build.mjs --verbose`.\n\n## Status by build step (PLAN section 25)\n- [x] 0 Pipeline (hub suite passed with a blank game)\n- [ ] 1 Walk  - world/* written, player written; not yet integrated in game.js\n- [ ] 2 Shoot - combat/*, body/health.js, actors/soldier.js etc written; not integrated\n- [ ] 3 Burn  - world/fire.js, fireview.js written\n- [ ] 4 Drive\n- [ ] 5 World\n- [ ] 6 Story\n- [ ] 7 Shell\n- [ ] 8 Multiplayer\n- [ ] 9 Polish\n- [ ] 10 Ship\n\n## Notes\n- src/game.js is still the Step 0 blank; the real one wires everything.\n- Art: src/art/models.js (world), viewmodels.js (hands, GUN_PARTS, HANDS_CLIPS), clips.js (people).\nEOF\ncat > src/vehicles/vehicle.js <<'EOF'\n// Pickup, technical, cargo truck, tanker on the engine's Vehicle. They rust and stall like everything else.\nimport { THREE, Vehicle, buildModel, setLookLayer, spatialize, RAPIER } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { MODELS } from '../art/models.js';\nimport { ROADS } from '../content/roads.js';\nimport { pointAlong, polyLength } from '../world/ground.js';\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\nconst { Vector3, Quaternion, Group } = THREE;\nconst _p = new Vector3(), _q = new Quaternion(), _v = new Vector3(), _f = new Vector3();\nexport const KINDS = {\n  pickup: { model: 'pickup', o: { size: [0.95, 0.45, 2.2], mass: 12, power: 160, topSpeed: 26, wheelRadius: 0.42, suspension: 0.45, stiffness: 30, grip: 2.6 }, seat: [0.42, 0.72, 0.1], door: [1.6, 0, 0], bonnet: [0, 0, 3.0], hpK: 1 },\n  technical: { model: 'technical', o: { size: [0.95, 0.45, 2.2], mass: 13, power: 165, topSpeed: 25, wheelRadius: 0.42, suspension: 0.45, stiffness: 30, grip: 2.6 }, seat: [0.42, 0.72, 0.1], door: [1.6, 0, 0], bonnet: [0, 0, 3.0], gunSeat: [0, 1.5, -1.5], hpK: 1.2 },\n  truck: { model: 'truck', o: { size: [1.1, 0.55, 3.1], mass: 24, power: 240, topSpeed: 18, wheelRadius: 0.46, suspension: 0.5, stiffness: 38, grip: 2.4 }, seat: [0.5, 1, 1.1], door: [1.9, 0, 1], bonnet: [0, 0, 3.8], hpK: 1.5 },\n  tanker: { model: 'tanker', o: { size: [1.1, 0.55, 3.1], mass: 26, power: 240, topSpeed: 17, wheelRadius: 0.46, suspension: 0.5, stiffness: 38, grip: 2.4 }, seat: [0.5, 1, 1.1], door: [1.9, 0, 1], bonnet: [0, 0, 3.8], hpK: 1.2, explosive: true },\n};\nexport const WRECK = { pickup: { paint: 'ink', hood: 'night', roof: 'night', lamp: 'night', dark: 'ink' }, technical: { paint: 'ink', hood: 'night', roof: 'night', lamp: 'night', dark: 'ink', gun: 'ink' }, truck: { paint: 'ink', hood: 'night', roof: 'night', lamp: 'night', slat: 'night', canvas: 'plum', dark: 'ink' }, tanker: { paint: 'ink', hood: 'night', roof: 'night', lamp: 'night', tank: 'night', band: 'plum', dark: 'ink' } };\nlet NEXT = 1;\nexport class Vehicle2 {\n  kind2 = 'vehicle'; hp = 100; alive = true; stalled = false; driver = null; x = 0; z = 0; y = 0; onFire = 0; explodeIn = 0; cough = 0; smokeT = 0; lastVel = 0; crew = 0; speed = 0;\n  constructor(game, kind, at, yaw, palette) {\n    const ctx = game.ctx;\n    this.id = NEXT++;\n    this.game = game; this.kind = kind; this.def = KINDS[kind];\n    const y = game.world.heightAt(at[0], at[1]) + 1.1;\n    this.car = new Vehicle(ctx.physics, { ...this.def.o, at: [at[0], y, at[1]], yaw });\n    this.x = at[0]; this.z = at[1]; this.y = y;\n    this.collider = this.car.body.collider(0);\n    game.hitMap.set(this.collider.handle, { kind: 'vehicle', ref: this });\n    if (game.views) {\n      const build = buildModel(this.def.model, { catalog: MODELS, palette });\n      this.object = build.object;\n      setLookLayer(this.object, 'actors');\n      this.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = false; } });\n      ctx.scene.add(this.object);\n      ctx.physics.bind(this.car.body, this.object);\n      this.wheels = [0, 1, 2, 3].map(() => {\n        const w = buildModel('wheel', { catalog: MODELS }).object;\n        setLookLayer(w, 'actors');\n        w.traverse((o) => { if (o.isMesh) o.castShadow = true; });\n        this.object.add(w);\n        return w;\n      });\n      this.turret = this.object.getObjectByName('Turret');\n    }\n  }\n  get yaw() { return this.car.yaw; }\n  hurt(a, source) {\n    const g = this.game;\n    if (!this.alive) return;\n    if (g.dev.god && this.driver === 'player') return;\n    this.hp -= (a / TUNING.vehicleToughness) / this.def.hpK;\n    if (this.driver === 'player') { g.hudTouch('vehicle'); g.rumble(0.3, 0.08); }\n    if (this.hp <= 10 && this.onFire <= 0 && this.hp > 0 && source !== 'stall-script') { this.onFire = 8; g.events.emit('vehicle-burning', this); }\n    if (this.hp <= 0) {\n      this.hp = 0;\n      if (this.onFire > 0 || source === 'rocket' || source === 'blast' || this.def.explosive) this.explode();\n      else this.stall();\n    }\n  }\n  stall() {\n    if (this.stalled) return;\n    this.stalled = true;\n    this.game.sfx.at('starter-cough', this.x, this.z, { max: 60 });\n    this.game.events.emit('vehicle-stalled', this);\n  }\n  explode() {\n    const g = this.game;\n    if (!this.alive) return;\n    this.alive = false; this.stalled = true;\n    g.damage.blast(this.x, this.y + 0.8, this.z, this.def.explosive ? 14 : 7, this.def.explosive ? 260 : 120, 'world', { fire: this.def.explosive ? 12 : 5 });\n    if (this.driver === 'player') { g.driving.eject(); g.body.hurt(70, 'blast'); }\n    g.events.emit('vehicle-destroyed', this);\n    // Swap to the burnt palette.\n    if (this.object) {\n      const pal = WRECK[this.kind];\n      const old = this.object;\n      const w = buildModel(this.def.model, { catalog: MODELS, palette: pal }).object;\n      setLookLayer(w, 'actors');\n      w.traverse((o) => { if (o.isMesh) o.castShadow = true; });\n      g.ctx.physics.unbind(old);\n      g.ctx.scene.remove(old);\n      g.ctx.scene.add(w);\n      g.ctx.physics.bind(this.car.body, w);\n      this.object = w; this.wheels = []; this.turret = null;\n    }\n    this.onFire = 0;\n    g.after(1, () => g.fire.ignite(this.x, this.z, 4, 'world'));\n  }\n  /** Full repair overnight, partial at the bonnet: back to 50 HP. */\n  repair(to = 50) { this.hp = Math.max(this.hp, to); this.stalled = false; this.onFire = 0; this.explodeIn = 0; this.cough = 3.2; this.game.events.emit('vehicle-repaired', this); }\n  place(x, z, yaw) {\n    const y = this.game.world.heightAt(x, z) + 1.1;\n    this.car.reset([x, y, z], yaw);\n    this.x = x; this.z = z; this.y = y;\n  }\n  fixedUpdate(ctx, dt, input) {\n    const g = this.game;\n    const t = this.car.body.translation();\n    this.x = t.x; this.y = t.y; this.z = t.z;\n    if (!this.alive) { this.car.drive({ throttle: 0, steer: 0, brake: true }, dt); return; }\n    this.car.o.topSpeed = (this.def.o.topSpeed / 26) * TUNING.vehicleTopSpeed;\n    const inRiver = g.ground.isWater(this.x, this.z) && !g.ground.isFord(this.x, this.z) && this.y < 40.2;\n    let powerK = 1;\n    if (this.hp < 35) powerK = 0.6;\n    if (this.stalled || inRiver) powerK = 0;\n    if (this.cough > 0) { this.cough -= dt; powerK *= 0.6 + 0.4 * Math.abs(Math.sin(this.cough * 9)); }\n    const inp = input ?? { throttle: 0, steer: 0, brake: true };\n    this.car.o.power = this.def.o.power;\n    const throttle = inp.throttle * powerK;\n    this.car.drive({ throttle, steer: inp.steer, brake: inp.brake, handbrake: inp.handbrake }, dt);\n    this.speed = this.car.speed;\n    // Collisions: a hard stop over 8 m/s hurts.\n    const v = this.car.body.linvel();\n    const sp = Math.hypot(v.x, v.y, v.z);\n    const dv = this.lastVel - sp;\n    if (dv > 8) { this.hurt(dv * 2.2, 'crash'); if (this.driver === 'player') { ctx.engine.shake.add(clamp(dv * 0.04, 0.2, 0.8)); g.sfx.play('crash', { volume: 0.9 }); g.body.hurt(dv * 0.5, 'crash'); } }\n    this.lastVel = sp;\n    // Fire.\n    if (g.fire.isBurning(this.x, this.z)) this.hurt(6 * dt, 'fire');\n    if (this.onFire > 0) {\n      this.onFire -= dt;\n      if (this.onFire <= 0) this.explode();\n    }\n    // Smoke and flames.\n    if ((this.smokeT -= dt) <= 0) {\n      this.smokeT = 0.12;\n      const fx = Math.sin(this.yaw), fz = Math.cos(this.yaw), L = this.def.o.size[2] * 0.8;\n      if (this.hp < 35 && this.alive) ctx.particles.burst('vehicle-smoke', [this.x + fx * L, this.y + 0.9, this.z + fz * L]);\n      if (this.hp <= 10 || this.onFire > 0) ctx.particles.burst('vehicle-flame', [this.x + fx * L, this.y + 0.9, this.z + fz * L], { count: 3 });\n    }\n  }\n  update(ctx, dt) {\n    if (!this.object) return;\n    if (this.wheels) for (let i = 0; i < this.wheels.length; i++) { this.car.wheelPose(i, _p, _q, true); this.wheels[i].position.copy(_p); this.wheels[i].quaternion.copy(_q); }\n  }\n  dispose() {\n    const g = this.game;\n    if (this.object) { g.ctx.physics.unbind(this.object); g.ctx.scene.remove(this.object); }\n    g.hitMap.delete(this.collider.handle);\n    this.car.dispose();\n  }\n}\nEOF\ncat > src/vehicles/driving.js <<'EOF'\n// Getting in and out, the cab, the wheel in your hands, the map at speed, the chase camera, the mounted gun, the bonnet.\nimport { THREE, buildModel, setLookLayer, spatialize } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { cabHands } from '../art/viewmodels.js';\nimport { Vehicle2, KINDS } from './vehicle.js';\nimport { ROADS } from '../content/roads.js';\nimport { pointAlong, polyLength } from '../world/ground.js';\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\nconst { Vector3, Quaternion, Group } = THREE;\nconst _v = new Vector3(), _q = new Quaternion();\nconst PATROLS = [\n  { road: 'north', kind: 'technical', faction: 'concord', palette: { paint: 'slate', hood: 'night', roof: 'mist' } },\n  { road: 'east', kind: 'technical', faction: 'harvest', palette: { paint: 'orange', hood: 'red', roof: 'sand' } },\n  { road: 'fort', kind: 'pickup', faction: 'concord', palette: { paint: 'slate', hood: 'night', roof: 'mist' } },\n  { road: 'salt', kind: 'technical', faction: 'harvest', palette: { paint: 'orange', hood: 'red', roof: 'sand' } },\n];\nexport class Vehicles {\n  list = []; patrols = []; chase = false; steerVis = 0; engine = null; gravelV = null; repairT = 0; repairing = null; hasKit = false;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game;\n    if (g.views) {\n      this.cab = buildModel(cabHands);\n      setLookLayer(this.cab.object, 'actors');\n      this.cab.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n      this.cabWheel = this.cab.object.getObjectByName('Wheel');\n      this.cabArrow = this.cab.object.getObjectByName('DashArrow');\n      this.cabRest = this.cabWheel.rotation.z;\n      this.cab.object.visible = false;\n      ctx.scene.add(this.cab.object);\n    }\n  }\n  spawn(kind, x, z, yaw = 0, palette) {\n    const v = new Vehicle2(this.game, kind, [x, z], yaw, palette);\n    this.list.push(v);\n    this.game.interact.add({ vehicle: v, x, y: 0, z, r: 3.2, wide: true, track: () => { const yw = v.yaw; const d = v.def.door; return [v.x + Math.cos(yw) * d[0] + Math.sin(yw) * d[2], v.y, v.z - Math.sin(yw) * d[0] + Math.cos(yw) * d[2]]; },\n      when: () => v.alive && !this.game.player.seat && v.driver == null, verb: () => (v.stalled ? 'CLIMB IN THE DEAD TRUCK' : 'GET IN'), onUse: () => this.game.driving.enter(v) });\n    this.game.interact.add({ vehicle: v, x, y: 0, z, r: 2.8, wide: true, hold: () => (this.hasKit ? 1.5 : 3), track: () => { const yw = v.yaw, d = v.def.bonnet; return [v.x + Math.sin(yw) * d[2], v.y, v.z + Math.cos(yw) * d[2]]; },\n      when: () => v.alive && !this.game.player.seat && (v.stalled || v.hp < 50), verb: () => 'OPEN THE BONNET', tick: (dt, t) => this.game.driving.wrenchTick(v, dt, t), onStart: () => this.game.driving.wrenchStart(v), onCancel: () => this.game.driving.wrenchEnd(), onUse: () => { this.game.driving.wrenchEnd(); v.repair(50); this.game.sfx.play('starter-cough'); } });\n    return v;\n  }\n  remove(v) {\n    const i = this.list.indexOf(v);\n    if (i >= 0) this.list.splice(i, 1);\n    for (const u of [...this.game.interact.list]) if (u.vehicle === v) this.game.interact.remove(u);\n    v.dispose();\n  }\n  /** Keep the road alive: patrol technicals follow their polylines, simulated within 400 m. */\n  startPatrols() {\n    const g = this.game;\n    for (const def of PATROLS) {\n      const pts = ROADS[def.road].pts, L = polyLength(pts), at = [0, 0, 0];\n      const s = g.rng.ai.range(0, L);\n      pointAlong(pts, s, at);\n      this.patrols.push({ def, pts, L, s, dir: 1, v: null, x: at[0], z: at[1], crewOut: false });\n    }\n  }\n  stopPatrols() { for (const p of this.patrols) if (p.v) this.remove(p.v); this.patrols.length = 0; }\n  stepPatrols(ctx, dt) {\n    const g = this.game, f = g.anchor();\n    for (const p of this.patrols) {\n      const d = Math.hypot(p.x - f.x, p.z - f.z);\n      if (!p.v) {\n        // A counter: it keeps its schedule when no one is looking.\n        p.s += p.dir * 11 * dt;\n        if (p.s > p.L) { p.s = p.L; p.dir = -1; } else if (p.s < 0) { p.s = 0; p.dir = 1; }\n        const at = pointAlong(p.pts, p.s, [0, 0, 0]);\n        p.x = at[0]; p.z = at[1];\n        if (d < 380 && d > 90 && !g.story.noPatrols) { p.v = this.spawn(p.def.kind, p.x, p.z, p.dir > 0 ? at[2] : at[2] + Math.PI, p.def.palette); p.v.patrol = p; p.v.driver = 'ai'; p.v.faction = p.def.faction; p.v.crew = 2; }\n        continue;\n      }\n      if (!p.v.alive || p.v.driver === 'player') { p.v.driver = p.v.driver === 'ai' ? null : p.v.driver; p.v.patrol = null; p.v = null; p.s = 0; p.x = 9999; p.z = 9999; p.dead = true; continue; }\n      p.x = p.v.x; p.z = p.v.z;\n      if (d > 420) { this.remove(p.v); p.v = null; }\n    }\n    this.patrols = this.patrols.filter((p) => !p.dead);\n  }\n  stepAI(ctx, v, dt) {\n    const g = this.game, p = v.patrol;\n    // Which way along the line, with a look-ahead point.\n    if (!v.path) v.path = p?.pts;\n    const pts = v.path;\n    if (!pts) { v.fixedUpdate(ctx, dt, { throttle: 0, steer: 0, brake: true }); return; }\n    if (p) {\n      const look = 14;\n      let best = 0, bd = 1e9, s = 0;\n      for (let i = 0; i + 1 < pts.length; i++) {\n        const [ax, az] = pts[i], [bx, bz] = pts[i + 1], dx = bx - ax, dz = bz - az, l = Math.hypot(dx, dz);\n        const t = clamp(((v.x - ax) * dx + (v.z - az) * dz) / (l * l), 0, 1), px = ax + dx * t, pz = az + dz * t, d = Math.hypot(v.x - px, v.z - pz);\n        if (d < bd) { bd = d; best = s + t * l; }\n        s += l;\n      }\n      p.s = best;\n      if (p.s > p.L - 12) p.dir = -1; else if (p.s < 12) p.dir = 1;\n      const at = pointAlong(pts, clamp(p.s + p.dir * look, 0, p.L), [0, 0, 0]);\n      v.aiGoal = { x: at[0], z: at[1] };\n    }\n    // Chase if the driver is alert, and dismount at 25 m.\n    const hostile = g.hasPlayer && g.actors.hostileToPlayer({ faction: v.faction, squad: null }) && !g.dev.invisible;\n    const pd = Math.hypot(g.player.feet.x - v.x, g.player.feet.z - v.z);\n    if (hostile && pd < 70 && g.actors.visionFor({ role: 'rifle' }, { kind: 'player' }, pd) > pd) {\n      v.chasing = true;\n      if (pd < 25 && v.crew > 0 && !v.stopped) { v.stopped = true; this.dismount(ctx, v); }\n      else if (!v.stopped) v.aiGoal = { x: g.player.feet.x, z: g.player.feet.z };\n    }\n    if (v.stopped) { v.fixedUpdate(ctx, dt, { throttle: 0, steer: 0, brake: true }); return; }\n    const goal = v.aiGoal;\n    if (!goal) { v.fixedUpdate(ctx, dt, { throttle: 0, steer: 0, brake: true }); return; }\n    const want = Math.atan2(goal.x - v.x, goal.z - v.z), err = wrapAngle(want - v.yaw);\n    const steer = clamp(-err * 1.6, -1, 1);\n    const target = v.aiSpeed ?? (Math.abs(err) > 0.5 ? 7 : 14);\n    const throttle = clamp((target - v.car.speed) * 0.5, -1, 1);\n    v.fixedUpdate(ctx, dt, { throttle, steer, brake: false });\n    if (v.car.speed < 0.6 && throttle > 0.3) { v.stuckT = (v.stuckT ?? 0) + dt; if (v.stuckT > 3) { v.stuckT = 0; v.car.reset([v.x, g.world.heightAt(v.x, v.z) + 1.1, v.z], want); } }\n    else v.stuckT = 0;\n  }\n  dismount(ctx, v) {\n    const g = this.game;\n    const squadKey = `crew${v.id}`;\n    const sq = g.actors.addSquadDef(squadKey, { faction: v.faction, n: v.crew, at: [v.x, v.z], noReman: true });\n    sq.live = true;\n    for (let i = 0; i < v.crew; i++) {\n      const s = g.actors.makeSoldier(ctx, { faction: v.faction, role: 'rifle', x: v.x + (i ? 2 : -2), z: v.z + 1.5, yaw: v.yaw, squad: sq });\n      s.alertTo(g.player.feet.x, g.player.feet.z, 'player');\n      s.targetInfo = g.actors.playerInfo();\n      sq.members.push(s);\n    }\n    v.crew = 0;\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game;\n    if (g.tick % 3 === 0) this.stepPatrols(ctx, dt * 3);\n    for (const v of this.list) {\n      if (v.driver === 'player') continue;\n      if (v.driver === 'ai') this.stepAI(ctx, v, dt);\n      else v.fixedUpdate(ctx, dt, { throttle: 0, steer: 0, brake: true });\n    }\n  }\n  update(ctx, dt) { for (const v of this.list) v.update(ctx, dt); }\n  reset() { this.stopPatrols(); for (const v of [...this.list]) this.remove(v); }\n}\nexport class Driving {\n  seat = null; chase = false; steer = 0; gunning = false; wrench = null; repairT = 0;\n  constructor(game) { this.game = game; }\n  get vehicle() { return this.seat?.v ?? null; }\n  enter(v) {\n    const g = this.game, p = g.player;\n    v.driver = 'player';\n    this.seat = { v, feet: () => _v.set(v.x, v.y - 0.3, v.z), eye: (out) => this.eyeOf(v, out) };\n    p.seat = this.seat;\n    p.cc.collider.setEnabled(false);\n    g.vm.setVisible(false);\n    if (g.views) { g.vehicles.cab.object.visible = true; v.object.add(g.vehicles.cab.object); const s = v.def.seat; g.vehicles.cab.object.position.set(s[0], s[1] - 0.2, s[2] + 0.28); }\n    this.gunning = false; this.chase = false;\n    g.sfx.play('door', { volume: 0.7 });\n    if (!this.engine || this.engine.stopped) this.engine = g.ctx.audio.loop('engine-loop', { volume: 0.4 });\n    g.events.emit('vehicle-enter', v);\n    p.setYaw(v.yaw + Math.PI, 0);\n    g.hudTouch('vehicle');\n  }\n  eyeOf(v, out) {\n    const s = this.gunning ? v.def.gunSeat : v.def.seat;\n    _q.copy(v.object ? v.object.quaternion : _q.set(0, 0, 0, 1));\n    if (!v.object) { const r = v.car.body.rotation(); _q.set(r.x, r.y, r.z, r.w); }\n    out.set(s[0], s[1], s[2]).applyQuaternion(_q);\n    const bx = v.object ? v.object.position.x : v.x, by = v.object ? v.object.position.y : v.y, bz = v.object ? v.object.position.z : v.z;\n    out.x += bx; out.y += by; out.z += bz;\n    return out;\n  }\n  eject() {\n    const g = this.game, p = g.player, v = this.vehicle;\n    if (!v) return;\n    v.driver = null;\n    if (v.alive) { const c = v.car.body; }\n    const yw = v.yaw, d = v.def.door;\n    const x = v.x + Math.cos(yw) * d[0] + Math.sin(yw) * d[2], z = v.z - Math.sin(yw) * d[0] + Math.cos(yw) * d[2];\n    p.seat = null;\n    this.seat = null; this.gunning = false; g.weapons.mounted = null;\n    p.cc.collider.setEnabled(true);\n    p.teleport(x, z);\n    g.cam.override = null;\n    g.vm.setVisible(true);\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    if (g.views) { g.vehicles.cab.object.visible = false; g.ctx.scene.add(g.vehicles.cab.object); }\n    this.engine?.stop(); this.engine = null;\n    g.sfx.play('door', { volume: 0.5 });\n    g.events.emit('vehicle-exit', v);\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions, v = this.vehicle;\n    if (!v) return;\n    // Swap to the gun; the truck rolls on with no driver, and that is your problem.\n    if (g.canActSeated()) {\n      if (a.take('exit') && !g.interact.current) { this.eject(); return; }\n      if (v.def.gunSeat && a.take('swap')) {\n        this.gunning = !this.gunning;\n        if (this.gunning) {\n          g.weapons.mounted = { turret: () => { if (v.turret) { v.turret.rotation.y = g.player.yaw - v.yaw + Math.PI; } } };\n          if (g.views) g.vehicles.cab.object.visible = false;\n          g.sfx.play('gun-equip');\n          g.events.emit('gun-seat', v);\n        } else {\n          g.weapons.mounted = null;\n          if (g.views) g.vehicles.cab.object.visible = true;\n        }\n      }\n      if (a.take('chase')) this.chase = !this.chase;\n    }\n    let input;\n    if (this.gunning) input = { throttle: 0, steer: 0, brake: false };\n    else {\n      const axis = a.axis();\n      const gas = g.mapCursorActive() && a.device === 'pad' ? a.analog('gas') : a.analog('gas');\n      const br = a.analog('brake');\n      const steerAxis = axis.x;\n      this.steer = lerp(this.steer, steerAxis, 1 - Math.exp(-dt * 7));\n      input = { throttle: gas - br, steer: -this.steer, brake: false, handbrake: a.down('handbrake') };\n      if (gas === 0 && br === 0) input.brake = false;\n    }\n    if (a.down('handbrake') && !this.gunning) input.handbrake = true;\n    v.fixedUpdate(ctx, dt, input);\n    if (Math.abs(v.car.speed) > 3 && g.ground.kindAt(v.x, v.z) !== 1) { /* gravel plays by the engine note */ }\n    if (a.take('jump')) { /* handbrake is held, not pressed */ }\n  }\n  /** Horn on the pad's L3, Shift on keys. */\n  update(ctx, dt) {\n    const g = this.game, v = this.vehicle;\n    if (!v) { return; }\n    const speed = Math.abs(v.car.speed);\n    if (this.engine) this.engine.set({ volume: v.stalled ? 0 : 0.28 + clamp(speed / 26, 0, 1) * 0.3, pitch: -6 + clamp(speed / 26, 0, 1) * 16 - (v.hp < 35 ? 2 : 0) });\n    if (g.actions.tapped('sprint')) g.sfx.play('horn', { volume: 0.8 });\n    if (g.views) {\n      const cab = g.vehicles;\n      if (cab.cabWheel) { cab.cabWheel.rotation.z = cab.cabRest + this.steer * 1.4; }\n      if (cab.cabArrow && g.map.waypoint) { const want = Math.atan2(g.map.waypoint[0] - v.x, g.map.waypoint[1] - v.z); cab.cabArrow.rotation.y = wrapAngle(want - v.yaw); }\n    }\n    // The chase camera lives in the camera step, by override.\n    if (this.chase && !this.gunning) {\n      const yw = v.yaw, d = 9, h = 3.6;\n      const o = v.object ? v.object.position : _v.set(v.x, v.y, v.z);\n      g.cam.override = { position: [o.x - Math.sin(yw) * d, o.y + h, o.z - Math.cos(yw) * d], target: [o.x + Math.sin(yw) * 3, o.y + 1, o.z + Math.cos(yw) * 3] };\n      if (g.views) cab.cab.object.visible = false;\n    } else if (g.cam.override && !g.scene.active) { g.cam.override = null; if (g.views && !this.gunning) g.vehicles.cab.object.visible = true; }\n  }\n  wrenchStart(v) {\n    const g = this.game;\n    g.vm.showProp('p-wrench'); g.vm.play('Wrench', { keep: true });\n    g.player.frozen = true;\n    this.wrench = v;\n  }\n  wrenchTick(v, dt, t) {\n    const g = this.game;\n    if ((this.wrenchS = (this.wrenchS ?? 0) - dt) <= 0) {\n      this.wrenchS = 0.42;\n      g.sfx.play('wrench', { volume: 0.7, pitch: g.rng.fx.range(-2, 2) });\n      const yw = v.yaw, d = v.def.bonnet;\n      g.ctx.particles.burst('wrench-spark', [v.x + Math.sin(yw) * d[2] * 0.7, v.y + 0.6, v.z + Math.cos(yw) * d[2] * 0.7]);\n    }\n  }\n  wrenchEnd() {\n    const g = this.game;\n    if (!this.wrench) return;\n    this.wrench = null;\n    g.player.frozen = false;\n    g.vm.endAction();\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n  }\n}\nEOF\ncat > src/vehicles/train.js <<'EOF'\n// Old Bakr's goods train: a kinematic string of cars moved along the railway polyline.\nimport { THREE, buildModel, setLookLayer, RAPIER } from '../../pixel-engine.js';\nimport { MODELS } from '../art/models.js';\nimport { RAIL, RIVER_Y, RAIL_BRIDGE } from '../content/roads.js';\nimport { pointAlong, polyLength } from '../world/ground.js';\nimport { clamp, lerp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst CARS = [{ model: 'locomotive', off: 0 }, { model: 'flatcar', off: -11.5 }, { model: 'boxcar', off: -22.5 }, { model: 'flatcar', off: -33.5, hasGun: true }];\nexport class Train {\n  s = 0; speed = 0; target = 0; cars = []; pts = RAIL.main; L = polyLength(RAIL.main); rideCar = 3; clackT = 0; moving = false; whistleN = 0; stopAt = null;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game;\n    for (const c of CARS) {\n      const car = { ...c, x: 0, y: 0, z: 0, yaw: 0, object: null };\n      const body = ctx.physics.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0, -30, 0));\n      const half = c.model === 'locomotive' ? [1.35, 1.6, 5.5] : c.model === 'boxcar' ? [1.35, 1.7, 5] : [1.35, 0.3, 5];\n      const col = ctx.physics.world.createCollider(RAPIER.ColliderDesc.cuboid(half[0], half[1], half[2]).setTranslation(0, half[1] + 0.1, 0), body);\n      car.body = body; car.half = half;\n      g.hitMap.set(col.handle, { kind: 'train', ref: car });\n      if (g.views) {\n        const b = buildModel(c.model, { catalog: MODELS });\n        car.object = b.object;\n        setLookLayer(car.object, 'actors');\n        car.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = false; } });\n        ctx.scene.add(car.object);\n        if (c.hasGun) {\n          const mg = buildModel('flat-mg', { catalog: MODELS });\n          setLookLayer(mg.object, 'actors');\n          mg.object.position.set(0, 0.65, 1.8);\n          car.object.add(mg.object);\n          car.turret = mg.object.getObjectByName('Turret');\n        }\n      }\n      this.cars.push(car);\n    }\n    this.place(this.sAt(0, 70));\n  }\n  /** Distance along the main line nearest a world point. */\n  sAt(x, z) {\n    let best = 0, bd = 1e12, s = 0;\n    const pts = this.pts;\n    for (let i = 0; i + 1 < pts.length; i++) {\n      const [ax, az] = pts[i], [bx, bz] = pts[i + 1], dx = bx - ax, dz = bz - az, l = Math.hypot(dx, dz);\n      const t = clamp(((x - ax) * dx + (z - az) * dz) / (l * l), 0, 1), d = Math.hypot(x - (ax + dx * t), z - (az + dz * t));\n      if (d < bd) { bd = d; best = s + t * l; }\n      s += l;\n    }\n    return best;\n  }\n  railY(x, z) {\n    if (Math.hypot(x - RAIL_BRIDGE.at[0], z - RAIL_BRIDGE.at[1]) < 18) return RIVER_Y + 2 + 0.75;\n    return this.game.world.heightAt(x, z) + 0.75;\n  }\n  place(s) {\n    this.s = s;\n    const p = [0, 0, 0];\n    for (const c of this.cars) {\n      pointAlong(this.pts, clamp(s + c.off, 0, this.L), p);\n      c.x = p[0]; c.z = p[1]; c.yaw = p[2]; c.y = this.railY(p[0], p[1]);\n      c.body.setNextKinematicTranslation({ x: c.x, y: c.y, z: c.z });\n      c.body.setTranslation({ x: c.x, y: c.y, z: c.z }, true);\n      const h = c.yaw / 2;\n      c.body.setRotation({ x: 0, y: Math.sin(h), z: 0, w: Math.cos(h) }, true);\n      if (c.object) { c.object.position.set(c.x, c.y, c.z); c.object.rotation.y = c.yaw; }\n    }\n  }\n  run(toS, speed = 11) { this.goalS = toS; this.target = speed; this.moving = true; }\n  fixedUpdate(ctx, dt) {\n    const g = this.game;\n    if (!this.moving && this.speed === 0) return;\n    const dir = this.goalS >= this.s ? 1 : -1;\n    const left = Math.abs(this.goalS - this.s);\n    const want = left < 25 ? Math.max(1.2, this.target * (left / 25)) : this.target;\n    this.speed = lerp(this.speed, want, 1 - Math.exp(-dt * 0.7));\n    this.s += dir * this.speed * dt;\n    if (left < 0.5) { this.s = this.goalS; this.speed = 0; this.moving = false; g.events.emit('train-stopped'); }\n    this.place(this.s);\n    this.clackT -= this.speed * dt;\n    if (this.clackT <= 0) { this.clackT = 6; g.sfx.at('train-clack', this.cars[0].x, this.cars[0].z, { max: 220, volume: 0.9 }); }\n  }\n  whistle() { const c = this.cars[0]; this.game.sfx.at('train-whistle', c.x, c.z, { max: 900, volume: 1 }); }\n  /** Stand on a car: eye and feet follow it. Returns the seat. */\n  seatOn(index, offset = [0, 2.3, 0]) {\n    const car = this.cars[index];\n    const v = new Vector3();\n    return {\n      car, invuln: false,\n      feet: () => v.set(car.x, car.y + 0.8, car.z),\n      eye: (out) => {\n        const s = Math.sin(car.yaw), co = Math.cos(car.yaw);\n        out.set(car.x + offset[0] * co + offset[2] * s, car.y + offset[1], car.z - offset[0] * s + offset[2] * co);\n        return out;\n      },\n    };\n  }\n}\nEOF\ncat > src/actors/interact.js <<'EOF'\n// The use scan: within 2.5 m and 25 degrees of the view centre, one prompt. Some are hold-to-use with a ring that fills.\nimport { THREE } from '../../pixel-engine.js';\nimport { clamp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst _f = new Vector3();\nexport class Interact {\n  list = []; current = null; holdT = 0; holding = null;\n  constructor(game) { this.game = game; }\n  add(u) { this.list.push(u); return u; }\n  remove(u) { const i = this.list.indexOf(u); if (i >= 0) this.list.splice(i, 1); if (this.current === u) this.current = null; if (this.holding === u) this.holding = null; }\n  clearTagged(tag) { this.list = this.list.filter((u) => u.tag !== tag); }\n  scan() {\n    const g = this.game;\n    const eye = g.player.eye;\n    const fwd = g.player.forward(_f);\n    let best = null, bs = -1;\n    for (const u of this.list) {\n      if (u.when && !u.when()) continue;\n      let x = u.x, y = u.y, z = u.z;\n      if (u.track) { const t = u.track(); x = t[0]; y = t[1]; z = t[2]; u.x = x; u.y = y; u.z = z; }\n      if (u.liveAt) { const t = u.liveAt(); x = t[0]; y = t[1]; z = t[2]; u.x = x; u.y = y; u.z = z; }\n      const dx = x - eye.x, dy = y - eye.y, dz = z - eye.z, d = Math.hypot(dx, dy, dz);\n      const r = u.r ?? 2.5;\n      if (d > r) continue;\n      const flatD = Math.hypot(dx, dz);\n      const cos = d > 0.01 ? (dx * fwd.x + dy * fwd.y + dz * fwd.z) / d : 1;\n      const coneOK = u.wide ? (flatD > 0.01 ? (dx * fwd.x + dz * fwd.z) / (flatD * Math.max(0.3, Math.hypot(fwd.x, fwd.z))) : 1) > 0.5 : cos > Math.cos((25 * Math.PI) / 180);\n      if (!coneOK && d > 1) continue;\n      const score = cos - d * 0.1;\n      if (score > bs) { bs = score; best = u; }\n    }\n    return best;\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions;\n    const active = g.canAct() && !g.mapUp;\n    const u = active ? this.scan() : null;\n    if (u !== this.current) { this.cancelHold(); this.current = u; }\n    if (!u) { a.take('alt'); return; }\n    if (u.onAlt && a.take('alt')) { u.onAlt(); return; }\n    if (u.enabled && !u.enabled()) { if (a.take('use')) g.sfx.play('ui-back', { volume: 0.3 }); return; }\n    const hold = typeof u.hold === 'function' ? u.hold() : u.hold;\n    if (hold) {\n      if (a.down('use')) {\n        if (this.holding !== u) { this.holding = u; this.holdT = 0; u.onStart?.(); }\n        this.holdT += dt;\n        u.tick?.(dt, this.holdT / hold);\n        if (this.holdT >= hold) { const h = this.holding; this.holding = null; this.holdT = 0; h.onUse(); g.events.emit('used', h); }\n      } else this.cancelHold();\n      a.take('use');\n    } else if (a.take('use')) { u.onUse(); g.events.emit('used', u); }\n  }\n  cancelHold() { if (this.holding) { this.holding.onCancel?.(); this.holding = null; this.holdT = 0; } }\n  /** Fraction of the ring filled. */\n  holdFrac() { if (!this.holding) return 0; const hold = typeof this.holding.hold === 'function' ? this.holding.hold() : this.holding.hold; return clamp(this.holdT / hold, 0, 1); }\n}\nEOF\ncat > src/core/clock.js <<'EOF'\n// Game time. A full day takes TUNING.dayMinutes real minutes. Absolute hours run on for regrowth and re-manning.\nimport { TUNING } from './tuning.js';\nexport class Clock {\n  hour = 16.5; abs = 16.5; day = 0; frozen = false; skyT = 0;\n  constructor(game) { this.game = game; }\n  set(hour) { this.abs += ((hour - this.hour + 24) % 24); this.hour = hour; this.onRoll(); this.game.sky?.apply(this.game.ctx, this.hour); }\n  advance(hours) { this.abs += hours; this.hour = (this.hour + hours) % 24; this.onRoll(); this.game.sky?.apply(this.game.ctx, this.hour); }\n  onRoll() { const d = Math.floor(this.abs / 24); if (d !== this.day) { this.day = d; this.game.fire.dayRoll?.(); this.game.events?.emit('day-roll', d); } this.game.fire.hours = this.abs; }\n  isNight() { return this.hour < 5.4 || this.hour > 19.6; }\n  step(dt) {\n    if (this.frozen) return;\n    const h = (24 / (TUNING.dayMinutes * 60)) * dt;\n    this.hour = (this.hour + h) % 24; this.abs += h;\n    this.game.fire.hours = this.abs;\n    const d = Math.floor(this.abs / 24);\n    if (d !== this.day) this.onRoll();\n  }\n}\nEOF\necho done","description":"Write vehicles, driving, train, interaction and clock"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28952,"cache_read_input_tokens":377604,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28952},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"f02fa4c2-6a9e-4f24-88f1-46d4d8f575b3","timestamp":"2026-11-05T23:55:15.276Z","request_id":"req_011CgkgVM8JDFczzhGp38zj1","wire_tool_inputs":{"toolu_01DUA6Wf2mgNYZ2PHWVQub7H":{"command":"set -e\ncat > ../PROGRESS.md <<'EOF'\n# PROGRESS (read me first after a context reset)\n\nTitle: **Far Cry Uncle** (item 7 of 50 from a real RNG draw).\nDev folder: `FarCryUncle-FarCry2-claude-opus-5-5-xhigh-20261105-162027/`\nDeliverable: `FarCryUncle-FarCry2-claude-opus-5-5-xhigh-20261105-162027.html` + `exit-interview.json` in this folder (work root).\nEngine: 0.46.0 (same as plan). Plan file: PLAN.md. Brief: TASK.md.\nTest: `cd <dev> && node tests/run.mjs [--all] [--only suite]`. Build: `node tools/build.mjs --verbose`.\n\n## Status by build step (PLAN section 25)\n- [x] 0 Pipeline (hub suite passed with a blank game)\n- [ ] 1 Walk  - world/* written, player written; not yet integrated in game.js\n- [ ] 2 Shoot - combat/*, body/health.js, actors/soldier.js etc written; not integrated\n- [ ] 3 Burn  - world/fire.js, fireview.js written\n- [ ] 4 Drive\n- [ ] 5 World\n- [ ] 6 Story\n- [ ] 7 Shell\n- [ ] 8 Multiplayer\n- [ ] 9 Polish\n- [ ] 10 Ship\n\n## Notes\n- src/game.js is still the Step 0 blank; the real one wires everything.\n- Art: src/art/models.js (world), viewmodels.js (hands, GUN_PARTS, HANDS_CLIPS), clips.js (people).\nEOF\ncat > src/vehicles/vehicle.js <<'EOF'\n// Pickup, technical, cargo truck, tanker on the engine's Vehicle. They rust and stall like everything else.\nimport { THREE, Vehicle, buildModel, setLookLayer, spatialize, RAPIER } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { MODELS } from '../art/models.js';\nimport { ROADS } from '../content/roads.js';\nimport { pointAlong, polyLength } from '../world/ground.js';\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\nconst { Vector3, Quaternion, Group } = THREE;\nconst _p = new Vector3(), _q = new Quaternion(), _v = new Vector3(), _f = new Vector3();\nexport const KINDS = {\n  pickup: { model: 'pickup', o: { size: [0.95, 0.45, 2.2], mass: 12, power: 160, topSpeed: 26, wheelRadius: 0.42, suspension: 0.45, stiffness: 30, grip: 2.6 }, seat: [0.42, 0.72, 0.1], door: [1.6, 0, 0], bonnet: [0, 0, 3.0], hpK: 1 },\n  technical: { model: 'technical', o: { size: [0.95, 0.45, 2.2], mass: 13, power: 165, topSpeed: 25, wheelRadius: 0.42, suspension: 0.45, stiffness: 30, grip: 2.6 }, seat: [0.42, 0.72, 0.1], door: [1.6, 0, 0], bonnet: [0, 0, 3.0], gunSeat: [0, 1.5, -1.5], hpK: 1.2 },\n  truck: { model: 'truck', o: { size: [1.1, 0.55, 3.1], mass: 24, power: 240, topSpeed: 18, wheelRadius: 0.46, suspension: 0.5, stiffness: 38, grip: 2.4 }, seat: [0.5, 1, 1.1], door: [1.9, 0, 1], bonnet: [0, 0, 3.8], hpK: 1.5 },\n  tanker: { model: 'tanker', o: { size: [1.1, 0.55, 3.1], mass: 26, power: 240, topSpeed: 17, wheelRadius: 0.46, suspension: 0.5, stiffness: 38, grip: 2.4 }, seat: [0.5, 1, 1.1], door: [1.9, 0, 1], bonnet: [0, 0, 3.8], hpK: 1.2, explosive: true },\n};\nexport const WRECK = { pickup: { paint: 'ink', hood: 'night', roof: 'night', lamp: 'night', dark: 'ink' }, technical: { paint: 'ink', hood: 'night', roof: 'night', lamp: 'night', dark: 'ink', gun: 'ink' }, truck: { paint: 'ink', hood: 'night', roof: 'night', lamp: 'night', slat: 'night', canvas: 'plum', dark: 'ink' }, tanker: { paint: 'ink', hood: 'night', roof: 'night', lamp: 'night', tank: 'night', band: 'plum', dark: 'ink' } };\nlet NEXT = 1;\nexport class Vehicle2 {\n  kind2 = 'vehicle'; hp = 100; alive = true; stalled = false; driver = null; x = 0; z = 0; y = 0; onFire = 0; explodeIn = 0; cough = 0; smokeT = 0; lastVel = 0; crew = 0; speed = 0;\n  constructor(game, kind, at, yaw, palette) {\n    const ctx = game.ctx;\n    this.id = NEXT++;\n    this.game = game; this.kind = kind; this.def = KINDS[kind];\n    const y = game.world.heightAt(at[0], at[1]) + 1.1;\n    this.car = new Vehicle(ctx.physics, { ...this.def.o, at: [at[0], y, at[1]], yaw });\n    this.x = at[0]; this.z = at[1]; this.y = y;\n    this.collider = this.car.body.collider(0);\n    game.hitMap.set(this.collider.handle, { kind: 'vehicle', ref: this });\n    if (game.views) {\n      const build = buildModel(this.def.model, { catalog: MODELS, palette });\n      this.object = build.object;\n      setLookLayer(this.object, 'actors');\n      this.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = false; } });\n      ctx.scene.add(this.object);\n      ctx.physics.bind(this.car.body, this.object);\n      this.wheels = [0, 1, 2, 3].map(() => {\n        const w = buildModel('wheel', { catalog: MODELS }).object;\n        setLookLayer(w, 'actors');\n        w.traverse((o) => { if (o.isMesh) o.castShadow = true; });\n        this.object.add(w);\n        return w;\n      });\n      this.turret = this.object.getObjectByName('Turret');\n    }\n  }\n  get yaw() { return this.car.yaw; }\n  hurt(a, source) {\n    const g = this.game;\n    if (!this.alive) return;\n    if (g.dev.god && this.driver === 'player') return;\n    this.hp -= (a / TUNING.vehicleToughness) / this.def.hpK;\n    if (this.driver === 'player') { g.hudTouch('vehicle'); g.rumble(0.3, 0.08); }\n    if (this.hp <= 10 && this.onFire <= 0 && this.hp > 0 && source !== 'stall-script') { this.onFire = 8; g.events.emit('vehicle-burning', this); }\n    if (this.hp <= 0) {\n      this.hp = 0;\n      if (this.onFire > 0 || source === 'rocket' || source === 'blast' || this.def.explosive) this.explode();\n      else this.stall();\n    }\n  }\n  stall() {\n    if (this.stalled) return;\n    this.stalled = true;\n    this.game.sfx.at('starter-cough', this.x, this.z, { max: 60 });\n    this.game.events.emit('vehicle-stalled', this);\n  }\n  explode() {\n    const g = this.game;\n    if (!this.alive) return;\n    this.alive = false; this.stalled = true;\n    g.damage.blast(this.x, this.y + 0.8, this.z, this.def.explosive ? 14 : 7, this.def.explosive ? 260 : 120, 'world', { fire: this.def.explosive ? 12 : 5 });\n    if (this.driver === 'player') { g.driving.eject(); g.body.hurt(70, 'blast'); }\n    g.events.emit('vehicle-destroyed', this);\n    // Swap to the burnt palette.\n    if (this.object) {\n      const pal = WRECK[this.kind];\n      const old = this.object;\n      const w = buildModel(this.def.model, { catalog: MODELS, palette: pal }).object;\n      setLookLayer(w, 'actors');\n      w.traverse((o) => { if (o.isMesh) o.castShadow = true; });\n      g.ctx.physics.unbind(old);\n      g.ctx.scene.remove(old);\n      g.ctx.scene.add(w);\n      g.ctx.physics.bind(this.car.body, w);\n      this.object = w; this.wheels = []; this.turret = null;\n    }\n    this.onFire = 0;\n    g.after(1, () => g.fire.ignite(this.x, this.z, 4, 'world'));\n  }\n  /** Full repair overnight, partial at the bonnet: back to 50 HP. */\n  repair(to = 50) { this.hp = Math.max(this.hp, to); this.stalled = false; this.onFire = 0; this.explodeIn = 0; this.cough = 3.2; this.game.events.emit('vehicle-repaired', this); }\n  place(x, z, yaw) {\n    const y = this.game.world.heightAt(x, z) + 1.1;\n    this.car.reset([x, y, z], yaw);\n    this.x = x; this.z = z; this.y = y;\n  }\n  fixedUpdate(ctx, dt, input) {\n    const g = this.game;\n    const t = this.car.body.translation();\n    this.x = t.x; this.y = t.y; this.z = t.z;\n    if (!this.alive) { this.car.drive({ throttle: 0, steer: 0, brake: true }, dt); return; }\n    this.car.o.topSpeed = (this.def.o.topSpeed / 26) * TUNING.vehicleTopSpeed;\n    const inRiver = g.ground.isWater(this.x, this.z) && !g.ground.isFord(this.x, this.z) && this.y < 40.2;\n    let powerK = 1;\n    if (this.hp < 35) powerK = 0.6;\n    if (this.stalled || inRiver) powerK = 0;\n    if (this.cough > 0) { this.cough -= dt; powerK *= 0.6 + 0.4 * Math.abs(Math.sin(this.cough * 9)); }\n    const inp = input ?? { throttle: 0, steer: 0, brake: true };\n    this.car.o.power = this.def.o.power;\n    const throttle = inp.throttle * powerK;\n    this.car.drive({ throttle, steer: inp.steer, brake: inp.brake, handbrake: inp.handbrake }, dt);\n    this.speed = this.car.speed;\n    // Collisions: a hard stop over 8 m/s hurts.\n    const v = this.car.body.linvel();\n    const sp = Math.hypot(v.x, v.y, v.z);\n    const dv = this.lastVel - sp;\n    if (dv > 8) { this.hurt(dv * 2.2, 'crash'); if (this.driver === 'player') { ctx.engine.shake.add(clamp(dv * 0.04, 0.2, 0.8)); g.sfx.play('crash', { volume: 0.9 }); g.body.hurt(dv * 0.5, 'crash'); } }\n    this.lastVel = sp;\n    // Fire.\n    if (g.fire.isBurning(this.x, this.z)) this.hurt(6 * dt, 'fire');\n    if (this.onFire > 0) {\n      this.onFire -= dt;\n      if (this.onFire <= 0) this.explode();\n    }\n    // Smoke and flames.\n    if ((this.smokeT -= dt) <= 0) {\n      this.smokeT = 0.12;\n      const fx = Math.sin(this.yaw), fz = Math.cos(this.yaw), L = this.def.o.size[2] * 0.8;\n      if (this.hp < 35 && this.alive) ctx.particles.burst('vehicle-smoke', [this.x + fx * L, this.y + 0.9, this.z + fz * L]);\n      if (this.hp <= 10 || this.onFire > 0) ctx.particles.burst('vehicle-flame', [this.x + fx * L, this.y + 0.9, this.z + fz * L], { count: 3 });\n    }\n  }\n  update(ctx, dt) {\n    if (!this.object) return;\n    if (this.wheels) for (let i = 0; i < this.wheels.length; i++) { this.car.wheelPose(i, _p, _q, true); this.wheels[i].position.copy(_p); this.wheels[i].quaternion.copy(_q); }\n  }\n  dispose() {\n    const g = this.game;\n    if (this.object) { g.ctx.physics.unbind(this.object); g.ctx.scene.remove(this.object); }\n    g.hitMap.delete(this.collider.handle);\n    this.car.dispose();\n  }\n}\nEOF\ncat > src/vehicles/driving.js <<'EOF'\n// Getting in and out, the cab, the wheel in your hands, the map at speed, the chase camera, the mounted gun, the bonnet.\nimport { THREE, buildModel, setLookLayer, spatialize } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { cabHands } from '../art/viewmodels.js';\nimport { Vehicle2, KINDS } from './vehicle.js';\nimport { ROADS } from '../content/roads.js';\nimport { pointAlong, polyLength } from '../world/ground.js';\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\nconst { Vector3, Quaternion, Group } = THREE;\nconst _v = new Vector3(), _q = new Quaternion();\nconst PATROLS = [\n  { road: 'north', kind: 'technical', faction: 'concord', palette: { paint: 'slate', hood: 'night', roof: 'mist' } },\n  { road: 'east', kind: 'technical', faction: 'harvest', palette: { paint: 'orange', hood: 'red', roof: 'sand' } },\n  { road: 'fort', kind: 'pickup', faction: 'concord', palette: { paint: 'slate', hood: 'night', roof: 'mist' } },\n  { road: 'salt', kind: 'technical', faction: 'harvest', palette: { paint: 'orange', hood: 'red', roof: 'sand' } },\n];\nexport class Vehicles {\n  list = []; patrols = []; chase = false; steerVis = 0; engine = null; gravelV = null; repairT = 0; repairing = null; hasKit = false;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game;\n    if (g.views) {\n      this.cab = buildModel(cabHands);\n      setLookLayer(this.cab.object, 'actors');\n      this.cab.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n      this.cabWheel = this.cab.object.getObjectByName('Wheel');\n      this.cabArrow = this.cab.object.getObjectByName('DashArrow');\n      this.cabRest = this.cabWheel.rotation.z;\n      this.cab.object.visible = false;\n      ctx.scene.add(this.cab.object);\n    }\n  }\n  spawn(kind, x, z, yaw = 0, palette) {\n    const v = new Vehicle2(this.game, kind, [x, z], yaw, palette);\n    this.list.push(v);\n    this.game.interact.add({ vehicle: v, x, y: 0, z, r: 3.2, wide: true, track: () => { const yw = v.yaw; const d = v.def.door; return [v.x + Math.cos(yw) * d[0] + Math.sin(yw) * d[2], v.y, v.z - Math.sin(yw) * d[0] + Math.cos(yw) * d[2]]; },\n      when: () => v.alive && !this.game.player.seat && v.driver == null, verb: () => (v.stalled ? 'CLIMB IN THE DEAD TRUCK' : 'GET IN'), onUse: () => this.game.driving.enter(v) });\n    this.game.interact.add({ vehicle: v, x, y: 0, z, r: 2.8, wide: true, hold: () => (this.hasKit ? 1.5 : 3), track: () => { const yw = v.yaw, d = v.def.bonnet; return [v.x + Math.sin(yw) * d[2], v.y, v.z + Math.cos(yw) * d[2]]; },\n      when: () => v.alive && !this.game.player.seat && (v.stalled || v.hp < 50), verb: () => 'OPEN THE BONNET', tick: (dt, t) => this.game.driving.wrenchTick(v, dt, t), onStart: () => this.game.driving.wrenchStart(v), onCancel: () => this.game.driving.wrenchEnd(), onUse: () => { this.game.driving.wrenchEnd(); v.repair(50); this.game.sfx.play('starter-cough'); } });\n    return v;\n  }\n  remove(v) {\n    const i = this.list.indexOf(v);\n    if (i >= 0) this.list.splice(i, 1);\n    for (const u of [...this.game.interact.list]) if (u.vehicle === v) this.game.interact.remove(u);\n    v.dispose();\n  }\n  /** Keep the road alive: patrol technicals follow their polylines, simulated within 400 m. */\n  startPatrols() {\n    const g = this.game;\n    for (const def of PATROLS) {\n      const pts = ROADS[def.road].pts, L = polyLength(pts), at = [0, 0, 0];\n      const s = g.rng.ai.range(0, L);\n      pointAlong(pts, s, at);\n      this.patrols.push({ def, pts, L, s, dir: 1, v: null, x: at[0], z: at[1], crewOut: false });\n    }\n  }\n  stopPatrols() { for (const p of this.patrols) if (p.v) this.remove(p.v); this.patrols.length = 0; }\n  stepPatrols(ctx, dt) {\n    const g = this.game, f = g.anchor();\n    for (const p of this.patrols) {\n      const d = Math.hypot(p.x - f.x, p.z - f.z);\n      if (!p.v) {\n        // A counter: it keeps its schedule when no one is looking.\n        p.s += p.dir * 11 * dt;\n        if (p.s > p.L) { p.s = p.L; p.dir = -1; } else if (p.s < 0) { p.s = 0; p.dir = 1; }\n        const at = pointAlong(p.pts, p.s, [0, 0, 0]);\n        p.x = at[0]; p.z = at[1];\n        if (d < 380 && d > 90 && !g.story.noPatrols) { p.v = this.spawn(p.def.kind, p.x, p.z, p.dir > 0 ? at[2] : at[2] + Math.PI, p.def.palette); p.v.patrol = p; p.v.driver = 'ai'; p.v.faction = p.def.faction; p.v.crew = 2; }\n        continue;\n      }\n      if (!p.v.alive || p.v.driver === 'player') { p.v.driver = p.v.driver === 'ai' ? null : p.v.driver; p.v.patrol = null; p.v = null; p.s = 0; p.x = 9999; p.z = 9999; p.dead = true; continue; }\n      p.x = p.v.x; p.z = p.v.z;\n      if (d > 420) { this.remove(p.v); p.v = null; }\n    }\n    this.patrols = this.patrols.filter((p) => !p.dead);\n  }\n  stepAI(ctx, v, dt) {\n    const g = this.game, p = v.patrol;\n    // Which way along the line, with a look-ahead point.\n    if (!v.path) v.path = p?.pts;\n    const pts = v.path;\n    if (!pts) { v.fixedUpdate(ctx, dt, { throttle: 0, steer: 0, brake: true }); return; }\n    if (p) {\n      const look = 14;\n      let best = 0, bd = 1e9, s = 0;\n      for (let i = 0; i + 1 < pts.length; i++) {\n        const [ax, az] = pts[i], [bx, bz] = pts[i + 1], dx = bx - ax, dz = bz - az, l = Math.hypot(dx, dz);\n        const t = clamp(((v.x - ax) * dx + (v.z - az) * dz) / (l * l), 0, 1), px = ax + dx * t, pz = az + dz * t, d = Math.hypot(v.x - px, v.z - pz);\n        if (d < bd) { bd = d; best = s + t * l; }\n        s += l;\n      }\n      p.s = best;\n      if (p.s > p.L - 12) p.dir = -1; else if (p.s < 12) p.dir = 1;\n      const at = pointAlong(pts, clamp(p.s + p.dir * look, 0, p.L), [0, 0, 0]);\n      v.aiGoal = { x: at[0], z: at[1] };\n    }\n    // Chase if the driver is alert, and dismount at 25 m.\n    const hostile = g.hasPlayer && g.actors.hostileToPlayer({ faction: v.faction, squad: null }) && !g.dev.invisible;\n    const pd = Math.hypot(g.player.feet.x - v.x, g.player.feet.z - v.z);\n    if (hostile && pd < 70 && g.actors.visionFor({ role: 'rifle' }, { kind: 'player' }, pd) > pd) {\n      v.chasing = true;\n      if (pd < 25 && v.crew > 0 && !v.stopped) { v.stopped = true; this.dismount(ctx, v); }\n      else if (!v.stopped) v.aiGoal = { x: g.player.feet.x, z: g.player.feet.z };\n    }\n    if (v.stopped) { v.fixedUpdate(ctx, dt, { throttle: 0, steer: 0, brake: true }); return; }\n    const goal = v.aiGoal;\n    if (!goal) { v.fixedUpdate(ctx, dt, { throttle: 0, steer: 0, brake: true }); return; }\n    const want = Math.atan2(goal.x - v.x, goal.z - v.z), err = wrapAngle(want - v.yaw);\n    const steer = clamp(-err * 1.6, -1, 1);\n    const target = v.aiSpeed ?? (Math.abs(err) > 0.5 ? 7 : 14);\n    const throttle = clamp((target - v.car.speed) * 0.5, -1, 1);\n    v.fixedUpdate(ctx, dt, { throttle, steer, brake: false });\n    if (v.car.speed < 0.6 && throttle > 0.3) { v.stuckT = (v.stuckT ?? 0) + dt; if (v.stuckT > 3) { v.stuckT = 0; v.car.reset([v.x, g.world.heightAt(v.x, v.z) + 1.1, v.z], want); } }\n    else v.stuckT = 0;\n  }\n  dismount(ctx, v) {\n    const g = this.game;\n    const squadKey = `crew${v.id}`;\n    const sq = g.actors.addSquadDef(squadKey, { faction: v.faction, n: v.crew, at: [v.x, v.z], noReman: true });\n    sq.live = true;\n    for (let i = 0; i < v.crew; i++) {\n      const s = g.actors.makeSoldier(ctx, { faction: v.faction, role: 'rifle', x: v.x + (i ? 2 : -2), z: v.z + 1.5, yaw: v.yaw, squad: sq });\n      s.alertTo(g.player.feet.x, g.player.feet.z, 'player');\n      s.targetInfo = g.actors.playerInfo();\n      sq.members.push(s);\n    }\n    v.crew = 0;\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game;\n    if (g.tick % 3 === 0) this.stepPatrols(ctx, dt * 3);\n    for (const v of this.list) {\n      if (v.driver === 'player') continue;\n      if (v.driver === 'ai') this.stepAI(ctx, v, dt);\n      else v.fixedUpdate(ctx, dt, { throttle: 0, steer: 0, brake: true });\n    }\n  }\n  update(ctx, dt) { for (const v of this.list) v.update(ctx, dt); }\n  reset() { this.stopPatrols(); for (const v of [...this.list]) this.remove(v); }\n}\nexport class Driving {\n  seat = null; chase = false; steer = 0; gunning = false; wrench = null; repairT = 0;\n  constructor(game) { this.game = game; }\n  get vehicle() { return this.seat?.v ?? null; }\n  enter(v) {\n    const g = this.game, p = g.player;\n    v.driver = 'player';\n    this.seat = { v, feet: () => _v.set(v.x, v.y - 0.3, v.z), eye: (out) => this.eyeOf(v, out) };\n    p.seat = this.seat;\n    p.cc.collider.setEnabled(false);\n    g.vm.setVisible(false);\n    if (g.views) { g.vehicles.cab.object.visible = true; v.object.add(g.vehicles.cab.object); const s = v.def.seat; g.vehicles.cab.object.position.set(s[0], s[1] - 0.2, s[2] + 0.28); }\n    this.gunning = false; this.chase = false;\n    g.sfx.play('door', { volume: 0.7 });\n    if (!this.engine || this.engine.stopped) this.engine = g.ctx.audio.loop('engine-loop', { volume: 0.4 });\n    g.events.emit('vehicle-enter', v);\n    p.setYaw(v.yaw + Math.PI, 0);\n    g.hudTouch('vehicle');\n  }\n  eyeOf(v, out) {\n    const s = this.gunning ? v.def.gunSeat : v.def.seat;\n    _q.copy(v.object ? v.object.quaternion : _q.set(0, 0, 0, 1));\n    if (!v.object) { const r = v.car.body.rotation(); _q.set(r.x, r.y, r.z, r.w); }\n    out.set(s[0], s[1], s[2]).applyQuaternion(_q);\n    const bx = v.object ? v.object.position.x : v.x, by = v.object ? v.object.position.y : v.y, bz = v.object ? v.object.position.z : v.z;\n    out.x += bx; out.y += by; out.z += bz;\n    return out;\n  }\n  eject() {\n    const g = this.game, p = g.player, v = this.vehicle;\n    if (!v) return;\n    v.driver = null;\n    if (v.alive) { const c = v.car.body; }\n    const yw = v.yaw, d = v.def.door;\n    const x = v.x + Math.cos(yw) * d[0] + Math.sin(yw) * d[2], z = v.z - Math.sin(yw) * d[0] + Math.cos(yw) * d[2];\n    p.seat = null;\n    this.seat = null; this.gunning = false; g.weapons.mounted = null;\n    p.cc.collider.setEnabled(true);\n    p.teleport(x, z);\n    g.cam.override = null;\n    g.vm.setVisible(true);\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    if (g.views) { g.vehicles.cab.object.visible = false; g.ctx.scene.add(g.vehicles.cab.object); }\n    this.engine?.stop(); this.engine = null;\n    g.sfx.play('door', { volume: 0.5 });\n    g.events.emit('vehicle-exit', v);\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions, v = this.vehicle;\n    if (!v) return;\n    // Swap to the gun; the truck rolls on with no driver, and that is your problem.\n    if (g.canActSeated()) {\n      if (a.take('exit') && !g.interact.current) { this.eject(); return; }\n      if (v.def.gunSeat && a.take('swap')) {\n        this.gunning = !this.gunning;\n        if (this.gunning) {\n          g.weapons.mounted = { turret: () => { if (v.turret) { v.turret.rotation.y = g.player.yaw - v.yaw + Math.PI; } } };\n          if (g.views) g.vehicles.cab.object.visible = false;\n          g.sfx.play('gun-equip');\n          g.events.emit('gun-seat', v);\n        } else {\n          g.weapons.mounted = null;\n          if (g.views) g.vehicles.cab.object.visible = true;\n        }\n      }\n      if (a.take('chase')) this.chase = !this.chase;\n    }\n    let input;\n    if (this.gunning) input = { throttle: 0, steer: 0, brake: false };\n    else {\n      const axis = a.axis();\n      const gas = g.mapCursorActive() && a.device === 'pad' ? a.analog('gas') : a.analog('gas');\n      const br = a.analog('brake');\n      const steerAxis = axis.x;\n      this.steer = lerp(this.steer, steerAxis, 1 - Math.exp(-dt * 7));\n      input = { throttle: gas - br, steer: -this.steer, brake: false, handbrake: a.down('handbrake') };\n      if (gas === 0 && br === 0) input.brake = false;\n    }\n    if (a.down('handbrake') && !this.gunning) input.handbrake = true;\n    v.fixedUpdate(ctx, dt, input);\n    if (Math.abs(v.car.speed) > 3 && g.ground.kindAt(v.x, v.z) !== 1) { /* gravel plays by the engine note */ }\n    if (a.take('jump')) { /* handbrake is held, not pressed */ }\n  }\n  /** Horn on the pad's L3, Shift on keys. */\n  update(ctx, dt) {\n    const g = this.game, v = this.vehicle;\n    if (!v) { return; }\n    const speed = Math.abs(v.car.speed);\n    if (this.engine) this.engine.set({ volume: v.stalled ? 0 : 0.28 + clamp(speed / 26, 0, 1) * 0.3, pitch: -6 + clamp(speed / 26, 0, 1) * 16 - (v.hp < 35 ? 2 : 0) });\n    if (g.actions.tapped('sprint')) g.sfx.play('horn', { volume: 0.8 });\n    if (g.views) {\n      const cab = g.vehicles;\n      if (cab.cabWheel) { cab.cabWheel.rotation.z = cab.cabRest + this.steer * 1.4; }\n      if (cab.cabArrow && g.map.waypoint) { const want = Math.atan2(g.map.waypoint[0] - v.x, g.map.waypoint[1] - v.z); cab.cabArrow.rotation.y = wrapAngle(want - v.yaw); }\n    }\n    // The chase camera lives in the camera step, by override.\n    if (this.chase && !this.gunning) {\n      const yw = v.yaw, d = 9, h = 3.6;\n      const o = v.object ? v.object.position : _v.set(v.x, v.y, v.z);\n      g.cam.override = { position: [o.x - Math.sin(yw) * d, o.y + h, o.z - Math.cos(yw) * d], target: [o.x + Math.sin(yw) * 3, o.y + 1, o.z + Math.cos(yw) * 3] };\n      if (g.views) cab.cab.object.visible = false;\n    } else if (g.cam.override && !g.scene.active) { g.cam.override = null; if (g.views && !this.gunning) g.vehicles.cab.object.visible = true; }\n  }\n  wrenchStart(v) {\n    const g = this.game;\n    g.vm.showProp('p-wrench'); g.vm.play('Wrench', { keep: true });\n    g.player.frozen = true;\n    this.wrench = v;\n  }\n  wrenchTick(v, dt, t) {\n    const g = this.game;\n    if ((this.wrenchS = (this.wrenchS ?? 0) - dt) <= 0) {\n      this.wrenchS = 0.42;\n      g.sfx.play('wrench', { volume: 0.7, pitch: g.rng.fx.range(-2, 2) });\n      const yw = v.yaw, d = v.def.bonnet;\n      g.ctx.particles.burst('wrench-spark', [v.x + Math.sin(yw) * d[2] * 0.7, v.y + 0.6, v.z + Math.cos(yw) * d[2] * 0.7]);\n    }\n  }\n  wrenchEnd() {\n    const g = this.game;\n    if (!this.wrench) return;\n    this.wrench = null;\n    g.player.frozen = false;\n    g.vm.endAction();\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n  }\n}\nEOF\ncat > src/vehicles/train.js <<'EOF'\n// Old Bakr's goods train: a kinematic string of cars moved along the railway polyline.\nimport { THREE, buildModel, setLookLayer, RAPIER } from '../../pixel-engine.js';\nimport { MODELS } from '../art/models.js';\nimport { RAIL, RIVER_Y, RAIL_BRIDGE } from '../content/roads.js';\nimport { pointAlong, polyLength } from '../world/ground.js';\nimport { clamp, lerp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst CARS = [{ model: 'locomotive', off: 0 }, { model: 'flatcar', off: -11.5 }, { model: 'boxcar', off: -22.5 }, { model: 'flatcar', off: -33.5, hasGun: true }];\nexport class Train {\n  s = 0; speed = 0; target = 0; cars = []; pts = RAIL.main; L = polyLength(RAIL.main); rideCar = 3; clackT = 0; moving = false; whistleN = 0; stopAt = null;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game;\n    for (const c of CARS) {\n      const car = { ...c, x: 0, y: 0, z: 0, yaw: 0, object: null };\n      const body = ctx.physics.world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0, -30, 0));\n      const half = c.model === 'locomotive' ? [1.35, 1.6, 5.5] : c.model === 'boxcar' ? [1.35, 1.7, 5] : [1.35, 0.3, 5];\n      const col = ctx.physics.world.createCollider(RAPIER.ColliderDesc.cuboid(half[0], half[1], half[2]).setTranslation(0, half[1] + 0.1, 0), body);\n      car.body = body; car.half = half;\n      g.hitMap.set(col.handle, { kind: 'train', ref: car });\n      if (g.views) {\n        const b = buildModel(c.model, { catalog: MODELS });\n        car.object = b.object;\n        setLookLayer(car.object, 'actors');\n        car.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = false; } });\n        ctx.scene.add(car.object);\n        if (c.hasGun) {\n          const mg = buildModel('flat-mg', { catalog: MODELS });\n          setLookLayer(mg.object, 'actors');\n          mg.object.position.set(0, 0.65, 1.8);\n          car.object.add(mg.object);\n          car.turret = mg.object.getObjectByName('Turret');\n        }\n      }\n      this.cars.push(car);\n    }\n    this.place(this.sAt(0, 70));\n  }\n  /** Distance along the main line nearest a world point. */\n  sAt(x, z) {\n    let best = 0, bd = 1e12, s = 0;\n    const pts = this.pts;\n    for (let i = 0; i + 1 < pts.length; i++) {\n      const [ax, az] = pts[i], [bx, bz] = pts[i + 1], dx = bx - ax, dz = bz - az, l = Math.hypot(dx, dz);\n      const t = clamp(((x - ax) * dx + (z - az) * dz) / (l * l), 0, 1), d = Math.hypot(x - (ax + dx * t), z - (az + dz * t));\n      if (d < bd) { bd = d; best = s + t * l; }\n      s += l;\n    }\n    return best;\n  }\n  railY(x, z) {\n    if (Math.hypot(x - RAIL_BRIDGE.at[0], z - RAIL_BRIDGE.at[1]) < 18) return RIVER_Y + 2 + 0.75;\n    return this.game.world.heightAt(x, z) + 0.75;\n  }\n  place(s) {\n    this.s = s;\n    const p = [0, 0, 0];\n    for (const c of this.cars) {\n      pointAlong(this.pts, clamp(s + c.off, 0, this.L), p);\n      c.x = p[0]; c.z = p[1]; c.yaw = p[2]; c.y = this.railY(p[0], p[1]);\n      c.body.setNextKinematicTranslation({ x: c.x, y: c.y, z: c.z });\n      c.body.setTranslation({ x: c.x, y: c.y, z: c.z }, true);\n      const h = c.yaw / 2;\n      c.body.setRotation({ x: 0, y: Math.sin(h), z: 0, w: Math.cos(h) }, true);\n      if (c.object) { c.object.position.set(c.x, c.y, c.z); c.object.rotation.y = c.yaw; }\n    }\n  }\n  run(toS, speed = 11) { this.goalS = toS; this.target = speed; this.moving = true; }\n  fixedUpdate(ctx, dt) {\n    const g = this.game;\n    if (!this.moving && this.speed === 0) return;\n    const dir = this.goalS >= this.s ? 1 : -1;\n    const left = Math.abs(this.goalS - this.s);\n    const want = left < 25 ? Math.max(1.2, this.target * (left / 25)) : this.target;\n    this.speed = lerp(this.speed, want, 1 - Math.exp(-dt * 0.7));\n    this.s += dir * this.speed * dt;\n    if (left < 0.5) { this.s = this.goalS; this.speed = 0; this.moving = false; g.events.emit('train-stopped'); }\n    this.place(this.s);\n    this.clackT -= this.speed * dt;\n    if (this.clackT <= 0) { this.clackT = 6; g.sfx.at('train-clack', this.cars[0].x, this.cars[0].z, { max: 220, volume: 0.9 }); }\n  }\n  whistle() { const c = this.cars[0]; this.game.sfx.at('train-whistle', c.x, c.z, { max: 900, volume: 1 }); }\n  /** Stand on a car: eye and feet follow it. Returns the seat. */\n  seatOn(index, offset = [0, 2.3, 0]) {\n    const car = this.cars[index];\n    const v = new Vector3();\n    return {\n      car, invuln: false,\n      feet: () => v.set(car.x, car.y + 0.8, car.z),\n      eye: (out) => {\n        const s = Math.sin(car.yaw), co = Math.cos(car.yaw);\n        out.set(car.x + offset[0] * co + offset[2] * s, car.y + offset[1], car.z - offset[0] * s + offset[2] * co);\n        return out;\n      },\n    };\n  }\n}\nEOF\ncat > src/actors/interact.js <<'EOF'\n// The use scan: within 2.5 m and 25 degrees of the view centre, one prompt. Some are hold-to-use with a ring that fills.\nimport { THREE } from '../../pixel-engine.js';\nimport { clamp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst _f = new Vector3();\nexport class Interact {\n  list = []; current = null; holdT = 0; holding = null;\n  constructor(game) { this.game = game; }\n  add(u) { this.list.push(u); return u; }\n  remove(u) { const i = this.list.indexOf(u); if (i >= 0) this.list.splice(i, 1); if (this.current === u) this.current = null; if (this.holding === u) this.holding = null; }\n  clearTagged(tag) { this.list = this.list.filter((u) => u.tag !== tag); }\n  scan() {\n    const g = this.game;\n    const eye = g.player.eye;\n    const fwd = g.player.forward(_f);\n    let best = null, bs = -1;\n    for (const u of this.list) {\n      if (u.when && !u.when()) continue;\n      let x = u.x, y = u.y, z = u.z;\n      if (u.track) { const t = u.track(); x = t[0]; y = t[1]; z = t[2]; u.x = x; u.y = y; u.z = z; }\n      if (u.liveAt) { const t = u.liveAt(); x = t[0]; y = t[1]; z = t[2]; u.x = x; u.y = y; u.z = z; }\n      const dx = x - eye.x, dy = y - eye.y, dz = z - eye.z, d = Math.hypot(dx, dy, dz);\n      const r = u.r ?? 2.5;\n      if (d > r) continue;\n      const flatD = Math.hypot(dx, dz);\n      const cos = d > 0.01 ? (dx * fwd.x + dy * fwd.y + dz * fwd.z) / d : 1;\n      const coneOK = u.wide ? (flatD > 0.01 ? (dx * fwd.x + dz * fwd.z) / (flatD * Math.max(0.3, Math.hypot(fwd.x, fwd.z))) : 1) > 0.5 : cos > Math.cos((25 * Math.PI) / 180);\n      if (!coneOK && d > 1) continue;\n      const score = cos - d * 0.1;\n      if (score > bs) { bs = score; best = u; }\n    }\n    return best;\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions;\n    const active = g.canAct() && !g.mapUp;\n    const u = active ? this.scan() : null;\n    if (u !== this.current) { this.cancelHold(); this.current = u; }\n    if (!u) { a.take('alt'); return; }\n    if (u.onAlt && a.take('alt')) { u.onAlt(); return; }\n    if (u.enabled && !u.enabled()) { if (a.take('use')) g.sfx.play('ui-back', { volume: 0.3 }); return; }\n    const hold = typeof u.hold === 'function' ? u.hold() : u.hold;\n    if (hold) {\n      if (a.down('use')) {\n        if (this.holding !== u) { this.holding = u; this.holdT = 0; u.onStart?.(); }\n        this.holdT += dt;\n        u.tick?.(dt, this.holdT / hold);\n        if (this.holdT >= hold) { const h = this.holding; this.holding = null; this.holdT = 0; h.onUse(); g.events.emit('used', h); }\n      } else this.cancelHold();\n      a.take('use');\n    } else if (a.take('use')) { u.onUse(); g.events.emit('used', u); }\n  }\n  cancelHold() { if (this.holding) { this.holding.onCancel?.(); this.holding = null; this.holdT = 0; } }\n  /** Fraction of the ring filled. */\n  holdFrac() { if (!this.holding) return 0; const hold = typeof this.holding.hold === 'function' ? this.holding.hold() : this.holding.hold; return clamp(this.holdT / hold, 0, 1); }\n}\nEOF\ncat > src/core/clock.js <<'EOF'\n// Game time. A full day takes TUNING.dayMinutes real minutes. Absolute hours run on for regrowth and re-manning.\nimport { TUNING } from './tuning.js';\nexport class Clock {\n  hour = 16.5; abs = 16.5; day = 0; frozen = false; skyT = 0;\n  constructor(game) { this.game = game; }\n  set(hour) { this.abs += ((hour - this.hour + 24) % 24); this.hour = hour; this.onRoll(); this.game.sky?.apply(this.game.ctx, this.hour); }\n  advance(hours) { this.abs += hours; this.hour = (this.hour + hours) % 24; this.onRoll(); this.game.sky?.apply(this.game.ctx, this.hour); }\n  onRoll() { const d = Math.floor(this.abs / 24); if (d !== this.day) { this.day = d; this.game.fire.dayRoll?.(); this.game.events?.emit('day-roll', d); } this.game.fire.hours = this.abs; }\n  isNight() { return this.hour < 5.4 || this.hour > 19.6; }\n  step(dt) {\n    if (this.frozen) return;\n    const h = (24 / (TUNING.dayMinutes * 60)) * dt;\n    this.hour = (this.hour + h) % 24; this.abs += h;\n    this.game.fire.hours = this.abs;\n    const d = Math.floor(this.abs / 24);\n    if (d !== this.day) this.onRoll();\n  }\n}\nEOF\necho done","description":"Write vehicles, driving, train, interaction and clock"}}}
