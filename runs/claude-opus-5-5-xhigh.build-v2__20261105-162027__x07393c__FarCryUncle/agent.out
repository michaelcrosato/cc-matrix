NGINE__.fps }));\nconsole.log(JSON.stringify(st).slice(0, 700));\nif (errs.length) console.log('ERRORS', errs.slice(0, 6).join('\\n'));\nawait browser.close();\nEOF\nnode tools/build.mjs --verbose 2>&1 | tail -3\ntimeout 200 node tools/shot.mjs title \"e.step(200); return g.state().screen\" 12 2>&1 | cut -c1-1200","description":"Build the single file and screenshot the title in Chromium","timeout":220000}}}
