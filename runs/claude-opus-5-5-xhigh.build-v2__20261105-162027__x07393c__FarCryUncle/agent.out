) => g.missions.active?.id !== T, 60 * 30, 'ride ends');\n  t.ok('off the train at the end', !g.player.seat);\n  delete MISSIONS[T]; g.missions.done.delete(T); dov.despawn(); g.dialogue.stopAll();\n  // Late.\n  g.missions.start('mr3');\"\"\"),\n(\"\"\"import { WEAPONS } from '../../src/content/weapons.js';\"\"\",\"\"\"import { WEAPONS } from '../../src/content/weapons.js';\nimport { MISSIONS } from '../../src/content/missions.js';\"\"\"),\n(\"\"\"  // Chase camera.\"\"\",\"\"\"  // Into the gears and back: the shifter clip of hand position runs on speed.\n  // Chase camera.\"\"\"),\n])\npatch('tests/suites/static.mjs',[(\"\"\"  // Every TUNING key has a slider or a reason.\"\"\",\"\"\"  // The step types the plan names, and its weapon table.\n  for (const k of ['goto', 'leave', 'talk', 'report', 'use', 'deliver', 'destroy', 'kill', 'collect', 'steal', 'hold', 'escort', 'ride', 'timer', 'choice', 'script']) t.ok(`step type ${k}`, !!STEPS[k]);\n  const TABLE = { m38: [6, 36, 3, 34, 45, 0.5], flare: [1, 8, 0.6, 12, 70, 0], tractor: [30, 150, 9, 24, 110, 0.35], mule: [6, 36, 1.1, 9, 22, 0.8], empire: [5, 30, 0.8, 95, 320, 1], weed: [120, 240, 30, 28, 14, 0.12], tube: [1, 5, 0.4, 180, 160, 2] };\n  for (const [id, [mag, res, rate, dmg, range, wear]] of Object.entries(TABLE)) { const w = WEAPONS[id]; t.ok(`${id} as tabled`, w.mag === mag && w.reserve === res && w.rate === rate && w.damage === dmg && w.range === range && w.wear === wear, JSON.stringify(w)); }\n  t.eq('mule has ten pellets', WEAPONS.mule.pellets, 10);\n  // Every TUNING key has a slider or a reason.\"\"\")])\n# WebKit iPhone: the closest thing here to iOS Safari.\npatch('tests/suites/browser.mjs',[(\"\"\"  } finally { await browser.close(); }\"\"\",\"\"\"  } finally { await browser.close(); }\n  // WebKit with an iPhone profile, the closest thing here to iOS Safari. The engine needs WebGPU, so it may refuse politely.\n  const wk = await webkit.launch();\n  try {\n    const { defaultBrowserType, ...iphone } = devices['iPhone 14'];\n    const ctxW = await wk.newContext({ ...iphone });\n    const pW = await ctxW.newPage();\n    const uncaught = [];\n    pW.on('pageerror', (e) => uncaught.push(e.message));\n    await pW.goto(`file://${OUT}`);\n    const res = await pW.waitForFunction(() => { const t = document.body.innerText || ''; return window.__GAME__ ? 'game' : (/webgpu/i.test(t) ? 'refused' : null); }, null, { timeout: 90000, polling: 500 }).then((h) => h.jsonValue()).catch(() => 'nothing');\n    t.ok('WebKit iPhone: the game runs or says why it cannot', res === 'game' || res === 'refused', res);\n    if (res === 'game') t.eq('WebKit iPhone: the gate', await pW.evaluate(() => { const e = window.__PIXEL_ENGINE__; e.manual = true; e.step(200); return window.__GAME__.state().screen; }), 'gate');\n    t.ok('WebKit iPhone: nothing uncaught', uncaught.length === 0, uncaught[0]);\n    await ctxW.close();\n  } finally { await wk.close(); }\"\"\"),\n(\"\"\"import { devices } from 'playwright';\"\"\",\"\"\"import { devices, webkit } from 'playwright';\"\"\")])\np='tests/run.mjs'; s=open(p).read()\ns=s.replace(\"const ORDER = ['static', 'systems', 'playthrough', 'soak', 'replay', 'browser', 'hub', 'link'];\",\"const ORDER = ['static', 'kit', 'systems', 'playthrough', 'soak', 'replay', 'browser', 'hub', 'link'];\")\nopen(p,'w').write(s)\nEOF\ncat > tests/suites/kit.mjs <<'EOF'\n// The kit's own tools, as its guide asks before handing back: the headless replay, the real page, the model sheets.\nimport { spawnSync } from 'node:child_process';\nimport { ROOT } from '../lib/paths.mjs';\nexport const name = 'kit';\nexport const covers = ['src', 'pixel-engine.js', 'check.mjs', 'index.html'];\nconst run = (...args) => spawnSync('node', ['check.mjs', ...args], { cwd: ROOT, encoding: 'utf8', timeout: 400000, maxBuffer: 1 << 26 });\nconst tail = (r) => `${r.stdout ?? ''}${r.stderr ?? ''}`.split('\\n').filter((l) => l.length < 300).slice(-6).join(' | ');\nexport async function run_(t) { return t; }\nexport async function run(t) {\n  const keys = 'Enter*2,KeyW*30,Enter*2,KeyS*10,Enter*4';\n  const h = run('--headless', 'src/game.js', '--keys', keys);\n  t.eq('check.mjs --headless: plays and replays the same', h.status, 0, tail(h));\n  const s = run('--sheets', 'src/art/models.js');\n  t.eq('check.mjs --sheets: no model problems', s.status, 0, tail(s));\n  const p = run('index.html', '--keys', keys);\n  t.eq('check.mjs: the page runs, draws a real picture', p.status, 0, tail(p));\n}\nEOF\nsed -i '/export async function run_(t) { return t; }/d' tests/suites/kit.mjs\ntimeout 560 node tests/run.mjs --only kit 2>&1 | grep -v '^`\\|WebGPURenderer\\|^file:' | grep -v 'pixel-engine.js:' | cut -c1-700 | grep -v '^    at' | tail -8","description":"Add missing step types, shifter, muffle, holster, kit suite; run kit","timeout":580000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5256,"cache_read_input_tokens":955851,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5256},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"d97afc94-d138-44a2-82ce-61968338ad8e","timestamp":"2026-11-06T02:50:37.584Z","request_id":"req_011CgkuvAZG27dMuvNmrCHYd","wire_tool_inputs":{"toolu_0183JsLRmWB4ag4JQj6qpB4W":{"command":"set -e\nrmdir src/ui/screens\npython3 - <<'EOF'\ndef patch(p, pairs):\n    s=open(p).read()\n    for a,b in pairs:\n        assert a in s, (p, a[:80])\n        s=s.replace(a,b)\n    open(p,'w').write(s)\n# ---- the step types the plan names ----\npatch('src/missions/steps.js',[(\"\"\"  destroy: {\n    enter(r, s, g) { s._n = 0;\"\"\",\"\"\"  /** Take a vehicle that isn't yours. The story cares that you are driving it. */\n  steal: {\n    enter(r, s, g) { const v = r.tags[s.tag]; if (v) g.map.setWaypoint(v.x, v.z); },\n    tick(r, s, g) { const v = r.tags[s.tag]; return !v || !v.alive || g.driving.vehicle === v; },\n  },\n  /** Someone walks to a place, and only while you stay with them. */\n  escort: {\n    enter(r, s, g) {\n      const b = g.actors.buddy(s.who), f = g.player.feet;\n      if (!b.active) b.spawn(g.ctx, f.x + 3, f.z + 3, { hp: 200, following: false });\n      b.following = false;\n      g.map.setWaypoint(s.to[0], s.to[1]);\n      s._b = b;\n    },\n    tick(r, s, g) {\n      const b = s._b, f = g.player.feet;\n      if (b.dead) return true;\n      const near = Math.hypot(b.x - f.x, b.z - f.z) < (s.leash ?? 70);\n      b.goal = near && !b.isDown ? { x: s.to[0], z: s.to[1] } : null;\n      return Math.hypot(b.x - s.to[0], b.z - s.to[1]) < (s.r ?? 6);\n    },\n    exit(r, s) { if (s._b) { s._b.goal = null; s._b.following = true; } },\n  },\n  /** On Old Bakr's train to where it is going, and off at the end. */\n  ride: {\n    enter(r, s, g) {\n      const tr = g.train;\n      if (s.from) tr.place(tr.sAt(s.from[0], s.from[1]));\n      g.player.seatOnTrain(s.car ?? 1, s.offset ?? [1, 2.2, 1.4]);\n      tr.run(tr.sAt(s.to[0], s.to[1]), s.speed ?? 11);\n      tr.whistle();\n      g.map.setWaypoint(s.to[0], s.to[1]);\n    },\n    tick(r, s, g) { return !g.train.moving; },\n    exit(r, s, g) { g.player.leaveTrain(g.train.cars[s.car ?? 1].x + 4, g.train.cars[s.car ?? 1].z + 4); },\n  },\n  destroy: {\n    enter(r, s, g) { s._n = 0;\"\"\")])\npatch('src/content/missions.js',[(\"\"\"alt: { buddy: 'ines', call: 'm3.alt', bonus: 5, at: 0, steps: [{ do: 'script', name: 'm3Tanker', text: 'TAKE THE TANKER AT P3' }] },\"\"\",\"\"\"alt: { buddy: 'ines', call: 'm3.alt', bonus: 5, at: 0, steps: [{ do: 'script', name: 'm3TankerAt', text: 'TAKE THE TANKER AT P3' }, { do: 'steal', tag: 'tanker', text: 'TAKE THE TANKER AT P3' }, { do: 'script', name: 'm3TankerIn', text: 'DRIVE IT INTO THE SIDING. THEY WILL WAVE AT FUEL.' }] },\"\"\")])\ns=open('src/missions/scripts.js').read()\ni=s.index(\"    * m3Tanker(g, r) {\"); j=s.index(\"    // ---- M4 ----\")\ns=s[:i]+\"\"\"    * m3TankerAt(g, r) {\n      const p3 = POSTS.p3;\n      r.tags.tanker = g.vehicles.spawn('tanker', p3.at[0] + 14, p3.at[1] + 10, 1.4, { paint: 'red', hood: 'plum', roof: 'plum' });\n      g.story.holdFireFaction = 'harvest';\n      yield 0.1;\n    },\n    * m3TankerIn(g, r) {\n      const v = r.tags.tanker, es = SITES['east-siding'];\n      if (!v?.alive) { g.story.holdFireFaction = null; return; }\n      g.map.setWaypoint(es.at[0], es.at[1]);\n      yield () => Math.hypot(v.x - es.at[0], v.z - es.at[1]) < 32 || !v.alive || g.dev.skipScript;\n      g.stepBanner('GET OUT AND SHOOT IT. RUN.');\n      g.story.holdFireFaction = null;\n      g.actors.squads.get('east-siding').angry = true;\n      yield 0.2;\n    },\n\"\"\"+s[j:]\nopen('src/missions/scripts.js','w').write(s)\n# ---- a hand on the wheel and the shifter ----\npatch('src/art/viewmodels.js',[(\"\"\"      b(0.055, 0.08, 0.06, -0.17, 0, 0, 'skin'), b(0.055, 0.08, 0.06, 0.17, 0, 0, 'skin'),\n    ], [0, -0.25, 0.42], [-24, 0, 0]),\n    b(0.09, 0.09, 0.44, -0.22, -0.38, 0.2, 'sleeve', [24, -10, 0]), b(0.09, 0.09, 0.44, 0.22, -0.38, 0.2, 'sleeve', [24, 10, 0]),\"\"\",\"\"\"      piv('GripR', [b(0.055, 0.08, 0.06, -0.17, 0, 0, 'skin')]), b(0.055, 0.08, 0.06, 0.17, 0, 0, 'skin'),\n    ], [0, -0.25, 0.42], [-24, 0, 0]),\n    b(0.09, 0.09, 0.44, 0.22, -0.38, 0.2, 'sleeve', [24, 10, 0]),\n    piv('Shifter', [b(0.03, 0.2, 0.03, 0, 0.1, 0, 'hub'), b(0.06, 0.06, 0.06, 0, 0.21, 0, 'dash')], [-0.36, -0.46, 0.4]),\n    piv('ArmShift', [b(0.09, 0.09, 0.44, 0, 0, -0.2, 'sleeve'), b(0.06, 0.07, 0.07, 0, 0, -0.44, 'skin')], [-0.26, -0.5, 0.04], [24, 10, 0]),\"\"\")])\npatch('src/vehicles/driving.js',[(\"\"\"      this.cabRest = this.cabWheel.rotation.z;\"\"\",\"\"\"      this.cabRest = this.cabWheel.rotation.z;\n      this.cabShifter = this.cab.object.getObjectByName('Shifter');\n      this.cabArm = this.cab.object.getObjectByName('ArmShift');\n      this.cabGrip = this.cab.object.getObjectByName('GripR');\n      this.cabArmRest = this.cabArm.position.clone();\"\"\"),\n(\"\"\"      if (cab.cabWheel) { cab.cabWheel.rotation.z = cab.cabRest + this.steer * 1.4; }\"\"\",\"\"\"      if (cab.cabWheel) { cab.cabWheel.rotation.z = cab.cabRest + this.steer * 1.4; }\n      // Through the gears: the right hand leaves the wheel for the lever and back.\n      const gear = Math.floor(speed / 7);\n      if (gear !== this.gear) { if (this.gear != null) { this.shiftT = 0.5; this.shiftDir = gear > this.gear ? 1 : -1; g.sfx.play('gun-mag', { volume: 0.25, pitch: -8 }); } this.gear = gear; }\n      this.shiftT = Math.max(0, (this.shiftT ?? 0) - dt);\n      const k = Math.sin(Math.min(1, this.shiftT / 0.5) * Math.PI);\n      cab.cabArm.position.set(cab.cabArmRest.x - k * 0.08, cab.cabArmRest.y + (1 - k) * 0.12, cab.cabArmRest.z + (1 - k) * 0.02 - k * 0.02);\n      cab.cabGrip.visible = k < 0.15;\n      cab.cabShifter.rotation.x = k * 0.4 * (this.shiftDir ?? 1);\"\"\")])\n# ---- muffle what is behind the hill ----\npatch('src/audio/sfx.js',[(\"\"\"  startLoop(key, name, o) {\"\"\",\"\"\"  /** Is the land or a wall between your ears and this place? Asked rarely, for loops. */\n  blocked(x, z) {\n    const g = this.game, cam = g.camPos, y = g.world.heightAt(x, z) + 2.5;\n    _o.set(cam.x, cam.y, cam.z); _d.set(x - cam.x, y - cam.y, z - cam.z);\n    const l = _d.length();\n    if (l < 3) return false;\n    _d.multiplyScalar(1 / l);\n    const hit = g.ctx.physics.castRay(_o, _d, l, [], g.player.cc?.body);\n    return !!hit && hit.distance < l - 3;\n  }\n  startLoop(key, name, o) {\"\"\"),\n(\"\"\"import { clamp } from '../core/rng.js';\"\"\",\"\"\"import { THREE } from '../../pixel-engine.js';\nimport { clamp } from '../core/rng.js';\nconst _o = new THREE.Vector3(), _d = new THREE.Vector3();\"\"\")])\npatch('src/world/fireview.js',[(\"\"\"      this.loop.set({ volume: clamp(s.gain * clamp(c.n / 20, 0.25, 1), 0, 1), pan: s.pan });\"\"\",\"\"\"      if ((this.muffleT = (this.muffleT ?? 0) - dt) <= 0) { this.muffleT = 0.5; this.muffled = g.sfx.blocked(c.x, c.z); }\n      this.loop.set({ volume: clamp(s.gain * clamp(c.n / 20, 0.25, 1), 0, 1), pan: s.pan, muffle: this.muffled ? 0.8 : 0 });\"\"\")])\npatch('src/vehicles/driving.js',[(\"\"\"      this.aiEngine.set({ volume: s.gain * 0.55, pan: s.pan, pitch: -4 + Math.min(1, Math.abs(best.car.speed) / 20) * 12 });\"\"\",\"\"\"      if ((this.muffleT = (this.muffleT ?? 0) - 1 / 60) <= 0) { this.muffleT = 0.5; this.muffled = g.sfx.blocked(best.x, best.z); }\n      this.aiEngine.set({ volume: s.gain * 0.55, pan: s.pan, pitch: -4 + Math.min(1, Math.abs(best.car.speed) / 20) * 12, muffle: this.muffled ? 0.8 : 0 });\"\"\")])\n# ---- sling the gun at the town limit ----\npatch('src/combat/viewmodel.js',[(\"\"\"    // Lower the gun while someone is talking at you.\"\"\",\"\"\"    // At the town limit the gun goes over your shoulder, and comes back at the other side.\n    const slung = !!g.weapons.slung;\n    if (slung !== this.wasSlung) { this.wasSlung = slung; if (!this.action && !g.player.seat && this.gunId && !g.mapUp) this.play(slung ? 'Holster' : 'Equip'); }\n    // Lower the gun while someone is talking at you.\"\"\")])\n# ---- the library's colonial pieces at the fort ----\npatch('src/content/sites.js',[(\"\"\"['office', 0, -24, 0], ['stool', 0, -20.2, 0],\"\"\",\"\"\"['stone-wall', -28, 24, 90], ['stone-wall', 28, 24, 90], ['battlement', -24, 32, 0], ['battlement', 24, 32, 0], ['office', 0, -24, 0], ['stool', 0, -20.2, 0],\"\"\")])\npatch('DESIGNERS.md',[(\"\"\"Step types are `goto leave talk report use deliver enter destroy blast kill collect hold timer choice script`.\"\"\",\"\"\"Step types are `goto leave talk report use deliver enter steal escort ride destroy blast kill collect hold timer choice script`.\"\"\")])\n# ---- tests ----\npatch('tests/suites/systems.mjs',[(\"\"\"  // Late.\n  g.missions.start('mr3');\"\"\",\"\"\"  // The step types no story mission happens to need: a designer can still write them as data.\n  const T = 'test-steps';\n  MISSIONS[T] = { id: T, side: true, title: 'TEST', giver: null, requires: [], pay: 0, steps: [\n    { do: 'steal', tag: 'stolen', text: 'STEAL' },\n    { do: 'escort', who: 'dov', to: [-290, 100], r: 6, text: 'ESCORT' },\n    { do: 'ride', from: [-420, 104], to: [-340, 102], speed: 16, text: 'RIDE' },\n  ], ops: [] };\n  const stolen = g.vehicles.spawn('pickup', -300, 96, 0); p.step(20);\n  g.missions.tags.stolen = stolen;\n  g.missions.start(T); p.step(2);\n  t.eq('steal waits', g.missions.currentStep()?.do, 'steal');\n  g.driving.enter(stolen); p.step(3);\n  t.eq('driving it is stealing it', g.missions.currentStep()?.do, 'escort');\n  g.driving.eject(); p.step(2);\n  const dov = g.actors.buddy('dov'); const leashAt = g.player.feet.clone();\n  g.player.teleport(leashAt.x + 200, leashAt.z); p.step(30);\n  const dx0 = dov.x; p.step(60);\n  t.near('an escort waits if you leave', Math.abs(dov.x - dx0), 0, 0.5);\n  g.player.teleport(dov.x + 4, dov.z + 4); p.step(2);\n  p.until(() => g.missions.currentStep()?.do === 'ride', 60 * 40, 'escort arrives');\n  t.ok('riding a seat', !!g.player.seat && g.player.trainSeat != null);\n  p.until(() => g.missions.active?.id !== T, 60 * 30, 'ride ends');\n  t.ok('off the train at the end', !g.player.seat);\n  delete MISSIONS[T]; g.missions.done.delete(T); dov.despawn(); g.dialogue.stopAll();\n  // Late.\n  g.missions.start('mr3');\"\"\"),\n(\"\"\"import { WEAPONS } from '../../src/content/weapons.js';\"\"\",\"\"\"import { WEAPONS } from '../../src/content/weapons.js';\nimport { MISSIONS } from '../../src/content/missions.js';\"\"\"),\n(\"\"\"  // Chase camera.\"\"\",\"\"\"  // Into the gears and back: the shifter clip of hand position runs on speed.\n  // Chase camera.\"\"\"),\n])\npatch('tests/suites/static.mjs',[(\"\"\"  // Every TUNING key has a slider or a reason.\"\"\",\"\"\"  // The step types the plan names, and its weapon table.\n  for (const k of ['goto', 'leave', 'talk', 'report', 'use', 'deliver', 'destroy', 'kill', 'collect', 'steal', 'hold', 'escort', 'ride', 'timer', 'choice', 'script']) t.ok(`step type ${k}`, !!STEPS[k]);\n  const TABLE = { m38: [6, 36, 3, 34, 45, 0.5], flare: [1, 8, 0.6, 12, 70, 0], tractor: [30, 150, 9, 24, 110, 0.35], mule: [6, 36, 1.1, 9, 22, 0.8], empire: [5, 30, 0.8, 95, 320, 1], weed: [120, 240, 30, 28, 14, 0.12], tube: [1, 5, 0.4, 180, 160, 2] };\n  for (const [id, [mag, res, rate, dmg, range, wear]] of Object.entries(TABLE)) { const w = WEAPONS[id]; t.ok(`${id} as tabled`, w.mag === mag && w.reserve === res && w.rate === rate && w.damage === dmg && w.range === range && w.wear === wear, JSON.stringify(w)); }\n  t.eq('mule has ten pellets', WEAPONS.mule.pellets, 10);\n  // Every TUNING key has a slider or a reason.\"\"\")])\n# WebKit iPhone: the closest thing here to iOS Safari.\npatch('tests/suites/browser.mjs',[(\"\"\"  } finally { await browser.close(); }\"\"\",\"\"\"  } finally { await browser.close(); }\n  // WebKit with an iPhone profile, the closest thing here to iOS Safari. The engine needs WebGPU, so it may refuse politely.\n  const wk = await webkit.launch();\n  try {\n    const { defaultBrowserType, ...iphone } = devices['iPhone 14'];\n    const ctxW = await wk.newContext({ ...iphone });\n    const pW = await ctxW.newPage();\n    const uncaught = [];\n    pW.on('pageerror', (e) => uncaught.push(e.message));\n    await pW.goto(`file://${OUT}`);\n    const res = await pW.waitForFunction(() => { const t = document.body.innerText || ''; return window.__GAME__ ? 'game' : (/webgpu/i.test(t) ? 'refused' : null); }, null, { timeout: 90000, polling: 500 }).then((h) => h.jsonValue()).catch(() => 'nothing');\n    t.ok('WebKit iPhone: the game runs or says why it cannot', res === 'game' || res === 'refused', res);\n    if (res === 'game') t.eq('WebKit iPhone: the gate', await pW.evaluate(() => { const e = window.__PIXEL_ENGINE__; e.manual = true; e.step(200); return window.__GAME__.state().screen; }), 'gate');\n    t.ok('WebKit iPhone: nothing uncaught', uncaught.length === 0, uncaught[0]);\n    await ctxW.close();\n  } finally { await wk.close(); }\"\"\"),\n(\"\"\"import { devices } from 'playwright';\"\"\",\"\"\"import { devices, webkit } from 'playwright';\"\"\")])\np='tests/run.mjs'; s=open(p).read()\ns=s.replace(\"const ORDER = ['static', 'systems', 'playthrough', 'soak', 'replay', 'browser', 'hub', 'link'];\",\"const ORDER = ['static', 'kit', 'systems', 'playthrough', 'soak', 'replay', 'browser', 'hub', 'link'];\")\nopen(p,'w').write(s)\nEOF\ncat > tests/suites/kit.mjs <<'EOF'\n// The kit's own tools, as its guide asks before handing back: the headless replay, the real page, the model sheets.\nimport { spawnSync } from 'node:child_process';\nimport { ROOT } from '../lib/paths.mjs';\nexport const name = 'kit';\nexport const covers = ['src', 'pixel-engine.js', 'check.mjs', 'index.html'];\nconst run = (...args) => spawnSync('node', ['check.mjs', ...args], { cwd: ROOT, encoding: 'utf8', timeout: 400000, maxBuffer: 1 << 26 });\nconst tail = (r) => `${r.stdout ?? ''}${r.stderr ?? ''}`.split('\\n').filter((l) => l.length < 300).slice(-6).join(' | ');\nexport async function run_(t) { return t; }\nexport async function run(t) {\n  const keys = 'Enter*2,KeyW*30,Enter*2,KeyS*10,Enter*4';\n  const h = run('--headless', 'src/game.js', '--keys', keys);\n  t.eq('check.mjs --headless: plays and replays the same', h.status, 0, tail(h));\n  const s = run('--sheets', 'src/art/models.js');\n  t.eq('check.mjs --sheets: no model problems', s.status, 0, tail(s));\n  const p = run('index.html', '--keys', keys);\n  t.eq('check.mjs: the page runs, draws a real picture', p.status, 0, tail(p));\n}\nEOF\nsed -i '/export async function run_(t) { return t; }/d' tests/suites/kit.mjs\ntimeout 560 node tests/run.mjs --only kit 2>&1 | grep -v '^`\\|WebGPURenderer\\|^file:' | grep -v 'pixel-engine.js:' | cut -c1-700 | grep -v '^    at' | tail -8","description":"Add missing step types, shifter, muffle, holster, kit suite; run kit","timeout":580000}}}
