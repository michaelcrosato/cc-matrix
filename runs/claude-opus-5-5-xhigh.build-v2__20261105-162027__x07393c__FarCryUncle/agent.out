{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkhppuJ2BCdxKjtrWRiE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LVycwkGRpX3eFjujbFPkDq","name":"Bash","input":{"command":"set -e\ncat > src/dev/devmode.js <<'EOF'\n// Dev mode, from the pause menu: tabs over the world, playing or frozen. Cheats, teleports, spawns, world, missions, live balance sliders, debug.\nimport { SLIDERS, TUNING_DEFAULTS } from '../content/tuning-defaults.js';\nimport { TUNING, resetTuning } from '../core/tuning.js';\nimport { SITES, POSTS, CASES, HALTS, TRIGS } from '../content/sites.js';\nimport { MISSIONS, MISSION_ORDER } from '../content/missions.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { BUDDIES } from '../actors/buddy.js';\nimport { FN } from '../world/fire.js';\nimport { SAFE_X, SAFE_Y } from '../ui/menu.js';\nconst TABS = ['CHEATS', 'TELEPORT', 'SPAWN', 'WORLD', 'MISSION', 'BALANCE', 'DEBUG'];\nexport class DevMode {\n  god = false; infiniteAmmo = false; noJams = false; noFever = false; noWear = false; invisible = false; noclip = false; oneHit = false; frozen = true; fireOverlay = false; navOverlay = false; aiText = false; skipScript = false; freeCam = false; balancePage = 0; lastStatus = ''; statusShown = false;\n  constructor(game) { this.game = game; }\n  crosshair() {\n    const g = this.game, e = g.player.eye, f = g.player.forward();\n    _o.set(e.x, e.y, e.z); _d.set(f.x, f.y, f.z);\n    const hit = g.ctx.physics.castRay(_o, _d, 800, [], g.player.cc?.body);\n    if (!hit) return { x: e.x + f.x * 30, y: e.y, z: e.z + f.z * 30 };\n    return { x: e.x + f.x * hit.distance, y: e.y + f.y * hit.distance, z: e.z + f.z * hit.distance };\n  }\n  teleport(x, z) { const g = this.game; if (g.player.seat) g.driving.eject(); g.player.flying = false; g.player.teleport(x, z); }\n  teleportSite(key) { const s = SITES[key] ?? POSTS[key]; this.teleport(s.at[0], s.at[1] + (s.r ? Math.min(s.r, 20) : 12)); }\n  startMission(id) {\n    const g = this.game;\n    g.dialogue.stopAll();\n    g.ui.menu.clear();\n    g.engineResume();\n    g.resetCampaign({ keepScene: true });\n    g.mode = 'campaign';\n    const m = g.missions.prepareJump(id);\n    g.setupForJump(m);\n    g.missions.start(id);\n    return m;\n  }\n  completeStep() { this.game.missions.forceStep(); }\n  // ---- tab contents ----\n  items(tab) {\n    const g = this.game, w = g.weapons;\n    const toggle = (k, label) => ({ id: k, label, small: true, choices: { options: [true, false], get: () => this[k], set: (v) => { this[k] = v; this.applyCheats(); }, format: (v) => (v ? 'ON' : 'OFF') } });\n    const act = (id, label, fn) => ({ id, label, small: true, onSelect: fn });\n    switch (TABS[tab]) {\n      case 'CHEATS': return [toggle('god', 'GOD MODE'), toggle('infiniteAmmo', 'INFINITE AMMO'), toggle('noJams', 'NO JAMS'), toggle('noFever', 'NO FEVER'), toggle('invisible', 'INVISIBLE TO AI'), toggle('noclip', 'NOCLIP FLY')];\n      case 'TELEPORT': return [\n        { id: 'tp-site', label: 'SITE', small: true, ...this.cycler('tpSite', Object.keys(SITES), (k) => SITES[k].name, (k) => this.teleportSite(k)) },\n        { id: 'tp-post', label: 'POST', small: true, ...this.cycler('tpPost', Object.keys(POSTS), (k) => POSTS[k].name, (k) => this.teleportSite(k)) },\n        { id: 'tp-case', label: 'CASE', small: true, ...this.cycler('tpCase', CASES.map((c) => c.id), (k) => k.toUpperCase(), (k) => { const c = CASES.find((x) => x.id === k); this.teleport(c.at[0] + 2, c.at[1] + 2); }) },\n        act('tp-cross', 'THE CROSSHAIR POINT', () => { const c = this.crosshair(); this.teleport(c.x, c.z); }),\n      ];\n      case 'SPAWN': return [\n        act('sp-concord', 'SQUAD OF CONCORD', () => this.spawnSquad('concord')), act('sp-harvest', 'SQUAD OF HARVEST', () => this.spawnSquad('harvest')),\n        act('sp-pickup', 'PICKUP', () => this.spawnVehicle('pickup')), act('sp-technical', 'TECHNICAL', () => this.spawnVehicle('technical')), act('sp-truck', 'TRUCK', () => this.spawnVehicle('truck')),\n        act('sp-case', 'A STONE CASE', () => { const c = this.crosshair(); g.places.spawnStoryCase(`dev${g.tick}`, c.x, c.z, 3); }),\n        { id: 'sp-buddy', label: 'A BUDDY', small: true, ...this.cycler('spBuddy', ['ines', 'dov', 'mags'], (k) => BUDDIES[k].name, (k) => { const f = g.player.feet, b = g.actors.buddy(k); b.met = true; b.dead = false; b.spawn(g.ctx, f.x + 3, f.z + 3, { hp: 200 }); }) },\n      ];\n      case 'WORLD': return [\n        { id: 'hour', label: 'HOUR', small: true, slider: { min: 0, max: 23.9, step: 0.25, get: () => g.clock.hour, set: (v) => { g.clock.hour = v; g.sky.apply(g.ctx, v); }, format: (v) => v.toFixed(1) } },\n        { id: 'windDir', label: 'WIND DIRECTION', small: true, slider: { min: 0, max: 6.25, step: 0.1, get: () => ((g.wind.dir % 6.283) + 6.283) % 6.283, set: (v) => { g.wind.dir = v; if (g.wind.pinned) g.wind.pinned.dir = v; }, format: (v) => `${Math.round((v * 180) / Math.PI)}` } },\n        { id: 'windSpeed', label: 'WIND SPEED', small: true, slider: { min: 0, max: 8, step: 0.25, get: () => g.wind.speed, set: (v) => { g.wind.speed = v; if (g.wind.pinned) g.wind.pinned.speed = v; }, format: (v) => v.toFixed(1) } },\n        { id: 'weather', label: 'WEATHER', small: true, choices: { options: ['clear', 'dust', 'storm'], get: () => g.sky.kind ?? 'clear', set: (v) => { g.sky.setWeather(v); g.sky.apply(g.ctx, g.clock.hour); }, format: (v) => v.toUpperCase() } },\n        act('ignite', 'IGNITE AT THE CROSSHAIR', () => { const c = this.crosshair(); g.fire.ignite(c.x, c.z, 4, 'player'); }),\n        act('extinguish', 'EXTINGUISH ALL', () => g.fire.extinguishAll()),\n        act('regrow', 'REGROW ALL', () => g.world.regrowAll()),\n        act('sleep6', 'SLEEP + 6 H', () => g.clock.advance(6)),\n      ];\n      case 'MISSION': return [\n        { id: 'ms-start', label: 'START', small: true, ...this.cycler('msStart', [...MISSION_ORDER, 'mr1', 'mr2', 'mr3'], (k) => MISSIONS[k].title, (k) => this.startMission(k)) },\n        act('ms-step', 'COMPLETE CURRENT STEP', () => this.completeStep()),\n        act('give-stones', 'GIVE 20 STONES', () => { g.story.stones += 20; }),\n        act('give-tablets', 'GIVE 5 TABLETS, 5 SYRETTES', () => { g.body.tablets += 5; g.body.syrettes = g.body.maxSyrettes = 5; }),\n        act('give-guns', 'ALL GUNS', () => this.giveAll()),\n        act('break', 'BREAK THIS GUN', () => { if (w.gun) { w.gun.cond = 1; g.vm.updateWear(); } }),\n        act('jam', 'FORCE A JAM', () => { if (w.gun && w.def.mag) w.gun.jam = 3; }),\n        act('fever', 'FORCE THE FEVER', () => { g.story.feverRunning = true; g.body.startFever(); }),\n        act('downbuddy', 'DOWN A BUDDY', () => { const b = g.actors.buddies.find((x) => x.active && !x.isDown); if (b) b.goDown(false); }),\n        { id: 'flag', label: 'STORY FLAG', small: true, ...this.cycler('flag', ['truce', 'war', 'wellsEmpty', 'columnWalking'], (k) => k.toUpperCase(), (k) => { if (k === 'truce') g.story.truce = !g.story.truce; else if (k === 'war') g.story.war = !g.story.war; else g.story.flags[k] = !g.story.flags[k]; }) },\n      ];\n      case 'BALANCE': return this.balanceItems();\n      case 'DEBUG': return [\n        toggle('fireOverlay', 'FIRE GRID OVERLAY'), toggle('navOverlay', 'NAV OVERLAY'), toggle('aiText', 'AI STATE OVER HEADS'),\n        act('debugPanel', 'ENGINE DEBUG PANEL', () => g.ctx.engine.showDebug(!g.ctx.engine.debugShown)),\n        { id: 'free', label: 'FREE CAMERA', small: true, choices: { options: [false, true], get: () => this.freeCam, set: (v) => this.setFreeCam(v), format: (v) => (v ? 'ON' : 'OFF') } },\n        act('quicksave', 'QUICK SAVE', () => { g.save.write('quick'); g.notice('SAVED', 1.5); }),\n        act('quickload', 'QUICK LOAD', () => { g.ui.menu.clear(); g.engineResume(); g.save.requestLoad(); }),\n        { id: 'frozen', label: 'WORLD', small: true, choices: { options: [true, false], get: () => this.frozen, set: (v) => { this.frozen = v; g.applyTimeScale(); }, format: (v) => (v ? 'FROZEN' : 'PLAYING') } },\n      ];\n      default: return [];\n    }\n  }\n  cycler(key, list, fmt, go) {\n    this.sel = this.sel ?? {};\n    if (this.sel[key] == null) this.sel[key] = 0;\n    return {\n      value: () => fmt(list[this.sel[key]]),\n      onLeft: () => { this.sel[key] = (this.sel[key] - 1 + list.length) % list.length; this.game.sfx.play('ui-move'); },\n      onRight: () => { this.sel[key] = (this.sel[key] + 1) % list.length; this.game.sfx.play('ui-move'); },\n      onSelect: () => go(list[this.sel[key]]),\n    };\n  }\n  balanceItems() {\n    const per = 9, start = this.balancePage * per;\n    const list = SLIDERS.slice(start, start + per).map((s) => ({\n      id: s.key, label: s.label, small: true, key: s.key,\n      slider: { min: s.min, max: s.max, step: s.step, get: () => TUNING[s.key], set: (v) => { TUNING[s.key] = Math.round(v / s.step) * s.step; if (s.key === 'vehicleTopSpeed') this.game.events.emit('tuning', s.key); }, format: (v) => (s.step < 1 ? v.toFixed(2) : String(Math.round(v))) },\n    }));\n    if (SLIDERS.length > per) list.push({ id: 'more', label: `MORE (${this.balancePage + 1}/${Math.ceil(SLIDERS.length / per)})`, small: true, onSelect: () => { this.balancePage = (this.balancePage + 1) % Math.ceil(SLIDERS.length / per); } });\n    list.push({ id: 'resetAll', label: 'RESET TO DEFAULTS', small: true, onSelect: () => { resetTuning(); this.game.notice('EVERYTHING AS IT SHIPPED.', 2); } });\n    return list;\n  }\n  spawnSquad(faction) {\n    const g = this.game, c = this.crosshair();\n    const key = `dev${g.tick}`;\n    const sq = g.actors.addSquadDef(key, { faction, n: 4, at: [c.x, c.z], noReman: true });\n    sq.forceLive = true; g.actors.liveSquad(g.ctx, sq);\n  }\n  spawnVehicle(kind) { const g = this.game, f = g.player.feet, fw = g.player.forward(); g.vehicles.spawn(kind, f.x + fw.x * 6, f.z + fw.z * 6, g.player.yaw); }\n  giveAll() {\n    const g = this.game, w = g.weapons;\n    for (const id of ['flare', 'tractor', 'mule', 'empire', 'weed', 'tube', 'm38']) { g.story.unlocked.add(id); }\n    w.give('m38', 100); w.give('empire', 100); w.give('tube', 100);\n    w.bottles = 3; w.charges = 2; g.story.unlocked.add('molotov');\n    g.story.trackerOwned = true;\n  }\n  applyCheats() {\n    const g = this.game, p = g.player;\n    if (p.flying !== this.noclip) { p.flying = this.noclip; if (p.cc) p.cc.collider.setEnabled(!this.noclip); }\n  }\n  setFreeCam(v) {\n    const g = this.game;\n    this.freeCam = v;\n    if (v) g.ctx.engine.setCamera({ preset: 'free' }, { syncUrl: false });\n    else g.ctx.engine.setCamera({ preset: 'first', fov: g.settings.fov }, { syncUrl: false });\n  }\n  open() {\n    const g = this.game;\n    g.ui.menu.push({\n      id: 'dev', title: 'DEV MODE', tabs: TABS, dim: 0, overlayWorld: true,\n      items: (s) => this.items(s.tab),\n      resetOne: (it) => { if (it?.key) { resetTuning(it.key); g.sfx.play('ui-confirm'); } },\n      hints: [['confirm', 'DO'], ['resetOne', 'RESET ONE'], ['back', 'BACK']],\n      onBack: () => { g.ui.menu.pop(); },\n      draw: (hud, m, s) => {\n        hud.rect(0, 0, hud.width, 42, 'ink');\n        m.title(hud, { title: 'DEV MODE' });\n        hud.text(hud.width - SAFE_X - 40 * 6, SAFE_Y + 3, g.status().slice(0, 40), { color: 'mist' });\n        m.drawTabs(hud, s, 30);\n        hud.rect(0, 42, hud.width * 0.72, hud.height - 42, 'ink');\n        let y = 48;\n        const items = m.itemsOf(s);\n        items.forEach((it, i) => { y += m.itemRow(hud, it, i, y, s.focus === i, SAFE_X, hud.width * 0.72 - SAFE_X - 8); });\n        const c = this.crosshair();\n        const counts = `ACTORS ${g.actors.anyStateCounts()}  BURNING ${g.fire.counts.burning}  BURNT ${g.fire.counts.burnt}  X ${Math.round(c.x)} Z ${Math.round(c.z)}`;\n        hud.text(SAFE_X, hud.height - SAFE_Y - 22, counts, { color: 'mist' });\n        m.footer(hud, s);\n      },\n    });\n  }\n  draw(hud) {\n    const g = this.game;\n    if (this.fireOverlay) this.drawGrid(hud, (x, z) => { const id = g.fire.idOf(x, z); if (id < 0) return null; const st = g.fire.state[id]; return st === 1 ? 'orange' : st === 2 ? 'ink' : st === 3 ? 'lime' : g.fire.fuel[id] ? 'sand' : null; });\n    if (this.navOverlay) this.drawGrid(hud, (x, z) => (g.world.nav.walkable(x, z) ? null : 'red'));\n  }\n  drawGrid(hud, fn) {\n    const g = this.game, f = g.player.feet, s = 3, n = 26;\n    const ox = hud.width - SAFE_X - n * 2 * s - 2, oy = SAFE_Y + 40;\n    hud.rect(ox - 1, oy - 1, n * 2 * s + 2, n * 2 * s + 2, 'night');\n    for (let j = -n; j < n; j++) for (let i = -n; i < n; i++) {\n      const c = fn(f.x + i * 5, f.z + j * 5);\n      if (c) hud.rect(ox + (i + n) * s, oy + (j + n) * s, s, s, c);\n    }\n    hud.rect(ox + n * s, oy + n * s, s, s, 'white');\n  }\n}\nimport { THREE } from '../../pixel-engine.js';\nconst _o = new THREE.Vector3(), _d = new THREE.Vector3();\nEOF\ncat > src/attract/beats.js <<'EOF'\n// The attract reel, as data: a list of beats. Each sets a place and an hour, then cheats its way through something worth seeing.\n// Run by the director, in the real game, with god mode and bot input through the same action layer.\nimport { SITES, POSTS } from '../content/sites.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { pointAlong, polyLength } from '../world/ground.js';\nimport { ROADS } from '../content/roads.js';\nconst look = (g, x, y, z) => { const e = g.player.eye, dx = x - e.x, dy = y - e.y, dz = z - e.z; g.player.setYaw(Math.atan2(-dx, -dz), Math.atan2(dy, Math.hypot(dx, dz))); };\nfunction squadAt(g, key, faction, x, z, n = 4) { const sq = g.actors.addSquadDef(key, { faction, n, at: [x, z], noReman: true }); sq.forceLive = true; g.actors.liveSquad(g.ctx, sq); return sq; }\nexport const BEATS = [\n  { id: 'drive-map', seconds: 12, hour: 18, * run(g, d, bot) {\n    const pts = ROADS.west.pts, p = pointAlong(pts, 60, [0, 0, 0]);\n    const v = g.vehicles.spawn('technical', p[0], p[1], p[2], { paint: 'orange', hood: 'red', roof: 'sand' });\n    d.keep.push(v);\n    g.driving.enter(v);\n    bot.analog.gas = 0.85;\n    for (let i = 0; i < 120; i++) { d.steerAlong(v, pts); yield 0; }\n    g.map.setWaypoint(-260, 240);\n    g.map.raise(true);\n    for (;;) { d.steerAlong(v, pts); yield 0; }\n  } },\n  { id: 'jam-fight', seconds: 13, hour: 15, * run(g, d, bot) {\n    const P = POSTS.p2;\n    g.player.teleport(P.at[0] + 22, P.at[1] + 22);\n    g.weapons.give('tractor', 28, true);\n    squadAt(g, 'attract-a', 'concord', P.at[0] + 2, P.at[1] + 2, 4);\n    look(g, P.at[0], g.player.eye.y - 0.2, P.at[1]);\n    yield 1;\n    bot.hold('fire');\n    g.weapons.scriptJamAt = 10; g.weapons.scriptShots = 0;\n    for (let i = 0; i < 90; i++) { d.aimNearest(); yield 0; if (g.weapons.gun.jam) break; }\n    bot.hold('fire', false);\n    for (let i = 0; i < 3; i++) { yield 0.5; bot.press('reload'); }\n    yield 0.8;\n    bot.hold('fire');\n    for (;;) { d.aimNearest(); yield 0; }\n  } },\n  { id: 'flare-grass', seconds: 14, hour: 16.5, wind: [0.9, 0.3, 6], * run(g, d, bot) {\n    const x = -130, z = 120;\n    g.player.teleport(x, z);\n    g.weapons.give('flare', 100, true);\n    g.player.setYaw(-1.2, 0.03);\n    squadAt(g, 'attract-b', 'harvest', x + 34, z + 6, 5);\n    yield 1;\n    bot.press('fire');\n    yield 2.5;\n    look(g, x + 30, g.player.eye.y, z + 6);\n    yield 1.2;\n    for (const s of g.actors.soldiers) if (s.active && !s.dead && s.squad?.key === 'attract-b') s.ignite();\n    for (;;) yield 0;\n  } },\n  { id: 'night-field', seconds: 13, hour: 22, wind: [0.9, 0.2, 5], * run(g, d, bot) {\n    const s = SITES['long-field'];\n    for (const [dx, dz] of [[-70, -40], [-70, 0], [-70, 40], [-40, -30], [-40, 30]]) g.fire.ignite(s.at[0] + dx, s.at[1] + dz, 8, 'world');\n    for (let i = 0; i < 4 * 12; i++) g.fire.tick(g.wind, 0.25);\n    const pts = [[s.at[0] - 120, s.at[1] + 80], [s.at[0] + 120, s.at[1] + 80]];\n    const v = g.vehicles.spawn('pickup', pts[0][0], pts[0][1], Math.PI / 2);\n    d.keep.push(v);\n    g.driving.enter(v);\n    g.driving.chase = true;\n    bot.analog.gas = 0.9;\n    for (;;) { d.steerAlong(v, pts); yield 0; }\n  } },\n  { id: 'fever', seconds: 10, hour: 13, * run(g, d, bot) {\n    g.player.teleport(-260, 225);\n    g.player.setYaw(0.2, -0.05);\n    g.weapons.give('tractor', 80, true);\n    g.body.tablets = 2;\n    g.story.feverRunning = true;\n    g.dev.noFever = false;\n    g.body.startFever({ limit: 999 });\n    yield 4;\n    bot.hold('tablet');\n    yield 1.4;\n    bot.hold('tablet', false);\n    for (;;) yield 0;\n  } },\n  { id: 'surgery', seconds: 7, hour: 11, * run(g, d, bot) {\n    g.player.teleport(90, -60);\n    g.player.setYaw(2, -0.1);\n    g.body.hp = 12;\n    g.body.lastDamage = 'bullet';\n    yield 0.4;\n    bot.press('heal');\n    for (;;) yield 0;\n  } },\n  { id: 'scoped', seconds: 10, hour: 12, * run(g, d, bot) {\n    const P = POSTS.p5;\n    g.player.teleport(P.at[0] - 120, P.at[1] - 30);\n    g.weapons.give('empire', 100, true);\n    const sq = squadAt(g, 'attract-c', 'concord', P.at[0], P.at[1], 4);\n    yield 0.5;\n    d.aimNearest();\n    bot.hold('aim');\n    yield 2;\n    for (;;) { d.aimNearest(); bot.press('fire'); yield 1.6; }\n  } },\n  { id: 'rescue', seconds: 12, hour: 10, * run(g, d, bot) {\n    g.player.teleport(-210, 80);\n    g.player.setYaw(0.4, 0);\n    g.weapons.give('tractor', 70, true);\n    const b = g.actors.buddy('ines'); b.met = true; b.dead = false; b.spentUntil = 0; b.woundedUntil = 0;\n    const was = g.dev.god; g.dev.god = false;\n    g.body.hp = 1;\n    g.body.hurt(10, 'bullet');\n    g.dev.god = was;\n    yield 5.2;\n    b.goDown(false);\n    g.player.teleport(b.x + 2, b.z);\n    look(g, b.x, b.y + 0.7, b.z);\n    for (;;) yield 0;\n  } },\n  { id: 'tracker', seconds: 10, hour: 9, * run(g, d, bot) {\n    const c = [-145, 435];\n    g.player.teleport(c[0] + 24, c[1] + 8);\n    g.story.trackerOwned = true;\n    look(g, c[0], g.player.eye.y - 0.5, c[1]);\n    g.fire.burnStrip([[c[0] - 12, c[1]], [c[0] + 20, c[1] + 6]], 16);\n    yield 0.4;\n    bot.press('tracker');\n    bot.move.y = 0.7;\n    for (;;) { look(g, c[0], g.player.eye.y - 0.7, c[1]); yield 0; }\n  } },\n  { id: 'train-mg', seconds: 12, hour: 17, * run(g, d, bot) {\n    const tr = g.train;\n    tr.place(tr.sAt(-40, 75));\n    g.player.seatOnTrain(3, [0, 2.3, 1.2], true, 0.15);\n    g.weapons.mounted = { turret: () => { const c = tr.cars[3]; if (c.turret) c.turret.rotation.y = g.player.yaw - c.yaw + Math.PI; } };\n    tr.run(tr.sAt(300, -15), 12);\n    squadAt(g, 'attract-d', 'harvest', 60, 80, 5);\n    squadAt(g, 'attract-e', 'concord', 150, 60, 5);\n    yield 0.6;\n    bot.hold('fire');\n    for (;;) { d.aimNearest(); yield 0; }\n  } },\n  { id: 'rack', seconds: 9, hour: 11, * run(g, d, bot) {\n    const n = g.npcs.byWho.tibor;\n    g.player.teleport(n.x + 1, n.z + 3.5);\n    look(g, n.x, n.y + 1.4, n.z);\n    g.story.stones = 40;\n    yield 1;\n    g.ui.openRack();\n    for (let i = 0; i < 4; i++) { yield 1.6; g.ui.menu.top?.onSide?.(1, g.ui.menu.top); }\n    for (;;) yield 0;\n  } },\n  { id: 'map-table', seconds: 9, hour: 22, * run(g, d, bot) {\n    const s = SITES.observatory;\n    g.player.teleport(s.at[0], s.at[1] + 3.5);\n    for (const k of ['A', 'B', 'C']) g.missions.applyOps([{ burnStrip: k }], true);\n    g.ending.endScene = false;\n    g.ending.harrowScene(g.npcs.byWho.harrow);\n    yield 1.5;\n    g.ending.layMap();\n    for (;;) yield 0;\n  } },\n  { id: 'title-card', seconds: 6, hour: 18.5, title: true, wind: [0.9, 0.3, 5], * run(g, d, bot) {\n    const s = SITES['long-field'];\n    g.fire.ignite(s.at[0], s.at[1], 18, 'world');\n    for (let i = 0; i < 4 * 8; i++) g.fire.tick(g.wind, 0.25);\n    g.player.teleport(s.at[0] + 110, s.at[1] + 80);\n    look(g, s.at[0], g.player.eye.y + 2, s.at[1]);\n    for (;;) yield 0;\n  } },\n];\nEOF\ncat > src/attract/director.js <<'EOF'\n// After 10 seconds with no input on the title or main menu: a looping demo using the real game, god mode, bot input and teleports. Any input exits.\nimport { BEATS } from './beats.js';\nimport { Bot } from '../core/actions.js';\nimport { wrapAngle, clamp } from '../core/rng.js';\nconst IDLE_FRAMES = 600;\nexport class Attract {\n  active = false; idleFrames = 0; beatI = 0; t = 0; gen = null; wait = 0; pred = null; keep = []; loops = 0; returnTo = null;\n  constructor(game) { this.game = game; this.bot = new Bot(); }\n  /** Runs in update: counts frames with no input on the title or main menu. */\n  tick(ctx, inputSeen) {\n    const g = this.game;\n    if (this.active) { if (inputSeen) this.stop(); return; }\n    const top = g.ui.menu.top;\n    const eligible = g.mode === 'title' && top && top.attractIdle && g.ui.menu.stack.length === 1;\n    if (!eligible || inputSeen) { this.idleFrames = 0; return; }\n    this.idleFrames++;\n    if (this.idleFrames > IDLE_FRAMES) this.start();\n  }\n  start() {\n    const g = this.game;\n    this.active = true; this.beatI = 0; this.loops = 0;\n    this.returnTo = g.ui.menu.top?.id;\n    g.ui.menu.clear();\n    g.save.disabled = true;\n    g.mode = 'attract';\n    g.actions.bot = this.bot; this.bot.clear();\n    g.dev.god = true; g.dev.infiniteAmmo = true; g.dev.noJams = false; g.dev.noWear = true;\n    g.setSeated(false);\n    g.engineResume();\n    this.beginBeat();\n    g.events.emit('attract-start');\n  }\n  stop() {\n    const g = this.game;\n    if (!this.active) return;\n    this.active = false;\n    this.gen = null;\n    g.actions.bot = null; this.bot.clear();\n    g.dev.god = false; g.dev.infiniteAmmo = false; g.dev.noWear = false;\n    g.ctx.engine.screen.clear();\n    g.events.emit('attract-stop');\n    g.resetCampaign({ keepScene: true });\n    g.save.disabled = false;\n    g.mode = 'title';\n    g.shell.enterTitle();\n    if (this.returnTo === 'main') { g.ui.menu.clear(); g.ui.menu.push(g.shell.mainMenu()); }\n    this.idleFrames = 0;\n    g.setupTitleScene();\n  }\n  beginBeat() {\n    const g = this.game;\n    const b = BEATS[this.beatI];\n    this.cleanupBeat();\n    g.resetCampaign({ keepScene: true, keepAttract: true });\n    g.mode = 'attract';\n    g.dev.god = true; g.dev.infiniteAmmo = true; g.dev.noWear = true;\n    g.story.flags.arrived = true;\n    g.body.syrettes = 5; g.body.tablets = 2;\n    g.weapons.give('m38', 100, false);\n    g.weapons.give('tractor', 70, true);\n    g.clock.set(b.hour);\n    g.clock.hour = b.hour;\n    if (b.wind) g.wind.pin([b.wind[0], b.wind[1]], b.wind[2]);\n    g.sky.apply(g.ctx, b.hour);\n    g.sky.setWeather('clear');\n    this.t = 0; this.wait = 0; this.pred = null;\n    this.bot.clear();\n    this.gen = b.run(g, this, this.bot);\n    g.hudHidden = false;\n    g.titleOverlay = !!b.title;\n    g.events.emit('attract-beat', b.id);\n    g.ctx.engine.screen.reveal('dither', { duration: 0.35 });\n  }\n  cleanupBeat() {\n    const g = this.game;\n    if (g.ui.menu.open) g.ui.menu.clear();\n    if (g.player.seat) { if (g.driving.vehicle) g.driving.eject(); else g.player.leaveTrain(g.player.feet.x, g.player.feet.z); }\n    g.map.raise(false);\n    g.weapons.mounted = null;\n    g.ending.endScene = true; g.scene.stop(); g.ending.endScene = false;\n    if (g.ending.tableMap) { g.ctx.scene.remove(g.ending.tableMap); g.ending.tableMap = null; }\n    g.map.glowScar = false;\n    g.places.setTracker(false);\n    this.keep = [];\n    g.titleOverlay = false;\n  }\n  /** Fixed step: run the reel. */\n  fixedUpdate(ctx, dt) {\n    if (!this.active) return;\n    const g = this.game, b = BEATS[this.beatI];\n    this.t += dt;\n    if (this.t >= b.seconds) {\n      this.beatI = (this.beatI + 1) % BEATS.length;\n      if (this.beatI === 0) this.loops++;\n      ctx.engine.screen.cover('dither', { duration: 0.25 });\n      g.after(0.28, () => { if (this.active) this.beginBeat(); });\n      this.t = -1e9;\n      this.gen = null;\n      return;\n    }\n    if (!this.gen) return;\n    if (this.pred) { if (!this.pred()) return; this.pred = null; }\n    if (this.wait > 0) { this.wait -= dt; if (this.wait > 0) return; }\n    const { value, done } = this.gen.next();\n    if (done) { this.gen = null; return; }\n    if (typeof value === 'number') this.wait = value;\n    else if (typeof value === 'function') this.pred = value;\n  }\n  aimNearest() {\n    const g = this.game, e = g.player.eye;\n    let best = null, bd = 400;\n    for (const s of g.actors.soldiers) { if (!s.active || s.dead) continue; const d = Math.hypot(s.x - e.x, s.z - e.z); if (d < bd) { bd = d; best = s; } }\n    if (!best) return;\n    const dx = best.x - e.x, dy = best.y + 1.2 - e.y, dz = best.z - e.z;\n    const wy = Math.atan2(-dx, -dz), wp = Math.atan2(dy, Math.hypot(dx, dz));\n    const rig = g.ctx.camera;\n    rig.yaw += wrapAngle(wy - rig.yaw) * 0.08; rig.pitch += (wp - rig.pitch) * 0.08;\n  }\n  steerAlong(v, pts) {\n    const bot = this.bot;\n    let bd = 1e9, ti = 0, s = 0;\n    for (let i = 0; i + 1 < pts.length; i++) { const d = Math.hypot(pts[i + 1][0] - v.x, pts[i + 1][1] - v.z); if (d < bd && d > 14) { bd = d; ti = i + 1; } }\n    const [tx, tz] = pts[ti];\n    const err = wrapAngle(Math.atan2(tx - v.x, tz - v.z) - v.yaw);\n    bot.move = { x: clamp(err * 1.5, -1, 1), y: 0 };\n  }\n}\nEOF\ncat > src/content/about.js <<'EOF'\n// The About and Credits text, paged. The brief's questions and honest answers, in order.\nexport const SOURCE_INFO = [\n  ['DATE', '2026-11-05 16:20:27'],\n  ['SOURCE', 'FAR CRY 2'],\n  ['PLAN', 'PLAN.MD'],\n  ['GENRE AND PERSPECTIVE', 'OPEN-WORLD FIRST-PERSON SHOOTER WITH SURVIVAL PRESSURE AND SYSTEMIC FIRE. FIRST PERSON, WITH A CHASE CAMERA IN VEHICLES ONLY.'],\n  ['TECH', 'PIXEL ENGINE 0.46.0 (RIFTLIGHT KIT), THREE.JS R186 (WEBGPU), RAPIER 0.20, ESBUILD 0.28, PLAYWRIGHT 1.63 FOR TESTS, OUR OWN GAME SYSTEMS IN JAVASCRIPT.'],\n  ['ART DIRECTION', 'THE ENGINE\\'S 3D-AS-PIXEL-ART PIPELINE AT 480X270, TOON MATERIALS, SWEETIE 16 PALETTE. NEW PEOPLE, GUNS, VEHICLES, BUILDINGS AND TREES AS DATA; LIBRARY PROPS FOR THE GENERIC ONES.'],\n  ['ANIMATION', 'THE ENGINE\\'S CLIPDEF SYSTEM AT 30 FPS, HERO CLIPS FOR PEOPLE, NEW KEYED CLIPS ON THE PEOPLE RIG AND A FIRST-PERSON HANDS RIG, RAGDOLLS, PROCEDURAL SWAY AND RECOIL.'],\n  ['AUDIO', 'ALL WRITTEN IN CODE. SOUNDDEF SYNTHESIS FOR EFFECTS, SONG DATA FOR SEVEN ORIGINAL TRACKS, GENERATED GIBBERISH VOICES. NO AUDIO FILES. MUSIC DEFAULTS TO 10%.'],\n  ['ONLINE', 'AI HUB SESSION PROTOCOL V1, SHARED WORLD, 1 TO 4 PLAYERS. ON ITS OWN: SOLO WITH AI MERCS, AND TWO WINDOWS ON ONE COMPUTER BY BROADCASTCHANNEL.'],\n  ['TESTING', 'HEADLESS NODE AND PLAYWRIGHT CHROMIUM, WEBGPU IN SOFTWARE. ONE COMMAND THAT PRINTS FAILURES AND A COUNT. SCREENSHOTS ONLY FOR WHAT A SCRIPT CANNOT CHECK. NO REVIEW SUBAGENTS.'],\n  ['RESEARCH', 'NONE BEYOND THE PLAN, THE ENGINE KIT\\'S DOCS AND THE AI HUB PROTOCOL.'],\n  ['ENVIRONMENT', 'CLAUDE CODE CLI (HEADLESS); LINUX'],\n  ['MODEL', 'ANTHROPIC, CLAUDE-OPUS-5-5, REASONING EFFORT XHIGH'],\n  ['USAGE', 'ADDED ON IMPORT'],\n];\nexport const TESTING_FEEDBACK = [\n  ['HOW MANY ISSUES DID TESTING CATCH?', ''],\n  ['HOW MANY WOULD BE CONSIDERED CRITICAL ISSUES / GAME BREAKING?', ''],\n  ['WHAT WAS THE MOST HELPFUL TEST YOU RAN?', ''],\n  ['WHAT WAS THE LEAST HELPFUL TEST YOU RAN?', ''],\n];\nexport const ENGINE_FEEDBACK = [\n  ['WHAT DID YOU LIKE MOST ABOUT THE ENGINE?', ''],\n  ['DID YOU GET STUCK OR GUESS WRONG?', ''],\n  ['WHAT WAS THE MOST IMPORTANT THING YOU HAD TO BUILD YOURSELF?', ''],\n  ['WHAT WAS THE HARDEST PART ABOUT USING THE ENGINE?', ''],\n  ['WHAT DID YOU CHANGE IN THE ENGINE, AND WHY? (NONE IF NOTHING)', ''],\n  ['IF YOU COULD CHANGE ONE THING ABOUT THE ENGINE, WHAT WOULD IT BE?', ''],\n];\nexport const PROMPT_FEEDBACK = [\n  ['WHAT DID YOU LIKE MOST ABOUT THIS PROMPT?', ''],\n  ['WHAT WAS CONFUSING?', ''],\n  ['WHAT WAS THE HARDEST THING TO DO?', ''],\n  ['WHAT WOULD YOU CHANGE IN THIS PROMPT?', ''],\n];\nexport const CREDITS_LINES = [\n  'PIXEL ENGINE (MIT)', 'THREE.JS (MIT)', 'RAPIER (APACHE-2.0)', 'THE AI HUB SESSION CLIENT',\n  'INSPIRED BY FAR CRY 2; NOT AFFILIATED',\n];\nEOF\ncat > src/ui/about.js <<'EOF'\n// Turns the about content into pages: one idea per screen, paged, never a table.\nimport { SOURCE_INFO, TESTING_FEEDBACK, ENGINE_FEEDBACK, PROMPT_FEEDBACK, CREDITS_LINES } from '../content/about.js';\nimport { GAME_TITLE } from '../content/title.js';\nconst up = (s) => String(s).toUpperCase();\nexport class About {\n  pages() {\n    const out = [];\n    const si = [];\n    for (let i = 0; i < SOURCE_INFO.length; i += 3) {\n      const page = [{ text: 'SOURCE INFORMATION', color: 'orange' }];\n      for (const [k, v] of SOURCE_INFO.slice(i, i + 3)) { page.push({ text: k, color: 'sand' }); page.push({ text: up(v), color: 'white' }); }\n      out.push(page);\n    }\n    const qa = (title, list) => {\n      for (let i = 0; i < list.length; i += 2) {\n        const page = [{ text: title, color: 'orange' }];\n        for (const [q, a] of list.slice(i, i + 2)) { page.push({ text: q, color: 'sand' }); page.push({ text: up(a), color: 'white' }); }\n        out.push(page);\n      }\n    };\n    qa('TESTING FEEDBACK', TESTING_FEEDBACK);\n    qa('ENGINE FEEDBACK', ENGINE_FEEDBACK);\n    qa('PROMPT FEEDBACK', PROMPT_FEEDBACK);\n    out.push(...this.creditPages());\n    return out;\n  }\n  creditPages() {\n    return [[{ text: up(GAME_TITLE), color: 'orange', scale: 2 }, ...CREDITS_LINES.map((t) => ({ text: t, color: 'white' }))]];\n  }\n}\nEOF\necho ok","description":"Write dev mode, attract reel and director, about pages"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18016,"cache_read_input_tokens":525721,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18016},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"f45d1551-7390-4b85-b58d-dca43755f2f8","timestamp":"2026-11-06T00:12:37.926Z","request_id":"req_011CgkhppduV8bE4awZKcuEB","wire_tool_inputs":{"toolu_01LVycwkGRpX3eFjujbFPkDq":{"command":"set -e\ncat > src/dev/devmode.js <<'EOF'\n// Dev mode, from the pause menu: tabs over the world, playing or frozen. Cheats, teleports, spawns, world, missions, live balance sliders, debug.\nimport { SLIDERS, TUNING_DEFAULTS } from '../content/tuning-defaults.js';\nimport { TUNING, resetTuning } from '../core/tuning.js';\nimport { SITES, POSTS, CASES, HALTS, TRIGS } from '../content/sites.js';\nimport { MISSIONS, MISSION_ORDER } from '../content/missions.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { BUDDIES } from '../actors/buddy.js';\nimport { FN } from '../world/fire.js';\nimport { SAFE_X, SAFE_Y } from '../ui/menu.js';\nconst TABS = ['CHEATS', 'TELEPORT', 'SPAWN', 'WORLD', 'MISSION', 'BALANCE', 'DEBUG'];\nexport class DevMode {\n  god = false; infiniteAmmo = false; noJams = false; noFever = false; noWear = false; invisible = false; noclip = false; oneHit = false; frozen = true; fireOverlay = false; navOverlay = false; aiText = false; skipScript = false; freeCam = false; balancePage = 0; lastStatus = ''; statusShown = false;\n  constructor(game) { this.game = game; }\n  crosshair() {\n    const g = this.game, e = g.player.eye, f = g.player.forward();\n    _o.set(e.x, e.y, e.z); _d.set(f.x, f.y, f.z);\n    const hit = g.ctx.physics.castRay(_o, _d, 800, [], g.player.cc?.body);\n    if (!hit) return { x: e.x + f.x * 30, y: e.y, z: e.z + f.z * 30 };\n    return { x: e.x + f.x * hit.distance, y: e.y + f.y * hit.distance, z: e.z + f.z * hit.distance };\n  }\n  teleport(x, z) { const g = this.game; if (g.player.seat) g.driving.eject(); g.player.flying = false; g.player.teleport(x, z); }\n  teleportSite(key) { const s = SITES[key] ?? POSTS[key]; this.teleport(s.at[0], s.at[1] + (s.r ? Math.min(s.r, 20) : 12)); }\n  startMission(id) {\n    const g = this.game;\n    g.dialogue.stopAll();\n    g.ui.menu.clear();\n    g.engineResume();\n    g.resetCampaign({ keepScene: true });\n    g.mode = 'campaign';\n    const m = g.missions.prepareJump(id);\n    g.setupForJump(m);\n    g.missions.start(id);\n    return m;\n  }\n  completeStep() { this.game.missions.forceStep(); }\n  // ---- tab contents ----\n  items(tab) {\n    const g = this.game, w = g.weapons;\n    const toggle = (k, label) => ({ id: k, label, small: true, choices: { options: [true, false], get: () => this[k], set: (v) => { this[k] = v; this.applyCheats(); }, format: (v) => (v ? 'ON' : 'OFF') } });\n    const act = (id, label, fn) => ({ id, label, small: true, onSelect: fn });\n    switch (TABS[tab]) {\n      case 'CHEATS': return [toggle('god', 'GOD MODE'), toggle('infiniteAmmo', 'INFINITE AMMO'), toggle('noJams', 'NO JAMS'), toggle('noFever', 'NO FEVER'), toggle('invisible', 'INVISIBLE TO AI'), toggle('noclip', 'NOCLIP FLY')];\n      case 'TELEPORT': return [\n        { id: 'tp-site', label: 'SITE', small: true, ...this.cycler('tpSite', Object.keys(SITES), (k) => SITES[k].name, (k) => this.teleportSite(k)) },\n        { id: 'tp-post', label: 'POST', small: true, ...this.cycler('tpPost', Object.keys(POSTS), (k) => POSTS[k].name, (k) => this.teleportSite(k)) },\n        { id: 'tp-case', label: 'CASE', small: true, ...this.cycler('tpCase', CASES.map((c) => c.id), (k) => k.toUpperCase(), (k) => { const c = CASES.find((x) => x.id === k); this.teleport(c.at[0] + 2, c.at[1] + 2); }) },\n        act('tp-cross', 'THE CROSSHAIR POINT', () => { const c = this.crosshair(); this.teleport(c.x, c.z); }),\n      ];\n      case 'SPAWN': return [\n        act('sp-concord', 'SQUAD OF CONCORD', () => this.spawnSquad('concord')), act('sp-harvest', 'SQUAD OF HARVEST', () => this.spawnSquad('harvest')),\n        act('sp-pickup', 'PICKUP', () => this.spawnVehicle('pickup')), act('sp-technical', 'TECHNICAL', () => this.spawnVehicle('technical')), act('sp-truck', 'TRUCK', () => this.spawnVehicle('truck')),\n        act('sp-case', 'A STONE CASE', () => { const c = this.crosshair(); g.places.spawnStoryCase(`dev${g.tick}`, c.x, c.z, 3); }),\n        { id: 'sp-buddy', label: 'A BUDDY', small: true, ...this.cycler('spBuddy', ['ines', 'dov', 'mags'], (k) => BUDDIES[k].name, (k) => { const f = g.player.feet, b = g.actors.buddy(k); b.met = true; b.dead = false; b.spawn(g.ctx, f.x + 3, f.z + 3, { hp: 200 }); }) },\n      ];\n      case 'WORLD': return [\n        { id: 'hour', label: 'HOUR', small: true, slider: { min: 0, max: 23.9, step: 0.25, get: () => g.clock.hour, set: (v) => { g.clock.hour = v; g.sky.apply(g.ctx, v); }, format: (v) => v.toFixed(1) } },\n        { id: 'windDir', label: 'WIND DIRECTION', small: true, slider: { min: 0, max: 6.25, step: 0.1, get: () => ((g.wind.dir % 6.283) + 6.283) % 6.283, set: (v) => { g.wind.dir = v; if (g.wind.pinned) g.wind.pinned.dir = v; }, format: (v) => `${Math.round((v * 180) / Math.PI)}` } },\n        { id: 'windSpeed', label: 'WIND SPEED', small: true, slider: { min: 0, max: 8, step: 0.25, get: () => g.wind.speed, set: (v) => { g.wind.speed = v; if (g.wind.pinned) g.wind.pinned.speed = v; }, format: (v) => v.toFixed(1) } },\n        { id: 'weather', label: 'WEATHER', small: true, choices: { options: ['clear', 'dust', 'storm'], get: () => g.sky.kind ?? 'clear', set: (v) => { g.sky.setWeather(v); g.sky.apply(g.ctx, g.clock.hour); }, format: (v) => v.toUpperCase() } },\n        act('ignite', 'IGNITE AT THE CROSSHAIR', () => { const c = this.crosshair(); g.fire.ignite(c.x, c.z, 4, 'player'); }),\n        act('extinguish', 'EXTINGUISH ALL', () => g.fire.extinguishAll()),\n        act('regrow', 'REGROW ALL', () => g.world.regrowAll()),\n        act('sleep6', 'SLEEP + 6 H', () => g.clock.advance(6)),\n      ];\n      case 'MISSION': return [\n        { id: 'ms-start', label: 'START', small: true, ...this.cycler('msStart', [...MISSION_ORDER, 'mr1', 'mr2', 'mr3'], (k) => MISSIONS[k].title, (k) => this.startMission(k)) },\n        act('ms-step', 'COMPLETE CURRENT STEP', () => this.completeStep()),\n        act('give-stones', 'GIVE 20 STONES', () => { g.story.stones += 20; }),\n        act('give-tablets', 'GIVE 5 TABLETS, 5 SYRETTES', () => { g.body.tablets += 5; g.body.syrettes = g.body.maxSyrettes = 5; }),\n        act('give-guns', 'ALL GUNS', () => this.giveAll()),\n        act('break', 'BREAK THIS GUN', () => { if (w.gun) { w.gun.cond = 1; g.vm.updateWear(); } }),\n        act('jam', 'FORCE A JAM', () => { if (w.gun && w.def.mag) w.gun.jam = 3; }),\n        act('fever', 'FORCE THE FEVER', () => { g.story.feverRunning = true; g.body.startFever(); }),\n        act('downbuddy', 'DOWN A BUDDY', () => { const b = g.actors.buddies.find((x) => x.active && !x.isDown); if (b) b.goDown(false); }),\n        { id: 'flag', label: 'STORY FLAG', small: true, ...this.cycler('flag', ['truce', 'war', 'wellsEmpty', 'columnWalking'], (k) => k.toUpperCase(), (k) => { if (k === 'truce') g.story.truce = !g.story.truce; else if (k === 'war') g.story.war = !g.story.war; else g.story.flags[k] = !g.story.flags[k]; }) },\n      ];\n      case 'BALANCE': return this.balanceItems();\n      case 'DEBUG': return [\n        toggle('fireOverlay', 'FIRE GRID OVERLAY'), toggle('navOverlay', 'NAV OVERLAY'), toggle('aiText', 'AI STATE OVER HEADS'),\n        act('debugPanel', 'ENGINE DEBUG PANEL', () => g.ctx.engine.showDebug(!g.ctx.engine.debugShown)),\n        { id: 'free', label: 'FREE CAMERA', small: true, choices: { options: [false, true], get: () => this.freeCam, set: (v) => this.setFreeCam(v), format: (v) => (v ? 'ON' : 'OFF') } },\n        act('quicksave', 'QUICK SAVE', () => { g.save.write('quick'); g.notice('SAVED', 1.5); }),\n        act('quickload', 'QUICK LOAD', () => { g.ui.menu.clear(); g.engineResume(); g.save.requestLoad(); }),\n        { id: 'frozen', label: 'WORLD', small: true, choices: { options: [true, false], get: () => this.frozen, set: (v) => { this.frozen = v; g.applyTimeScale(); }, format: (v) => (v ? 'FROZEN' : 'PLAYING') } },\n      ];\n      default: return [];\n    }\n  }\n  cycler(key, list, fmt, go) {\n    this.sel = this.sel ?? {};\n    if (this.sel[key] == null) this.sel[key] = 0;\n    return {\n      value: () => fmt(list[this.sel[key]]),\n      onLeft: () => { this.sel[key] = (this.sel[key] - 1 + list.length) % list.length; this.game.sfx.play('ui-move'); },\n      onRight: () => { this.sel[key] = (this.sel[key] + 1) % list.length; this.game.sfx.play('ui-move'); },\n      onSelect: () => go(list[this.sel[key]]),\n    };\n  }\n  balanceItems() {\n    const per = 9, start = this.balancePage * per;\n    const list = SLIDERS.slice(start, start + per).map((s) => ({\n      id: s.key, label: s.label, small: true, key: s.key,\n      slider: { min: s.min, max: s.max, step: s.step, get: () => TUNING[s.key], set: (v) => { TUNING[s.key] = Math.round(v / s.step) * s.step; if (s.key === 'vehicleTopSpeed') this.game.events.emit('tuning', s.key); }, format: (v) => (s.step < 1 ? v.toFixed(2) : String(Math.round(v))) },\n    }));\n    if (SLIDERS.length > per) list.push({ id: 'more', label: `MORE (${this.balancePage + 1}/${Math.ceil(SLIDERS.length / per)})`, small: true, onSelect: () => { this.balancePage = (this.balancePage + 1) % Math.ceil(SLIDERS.length / per); } });\n    list.push({ id: 'resetAll', label: 'RESET TO DEFAULTS', small: true, onSelect: () => { resetTuning(); this.game.notice('EVERYTHING AS IT SHIPPED.', 2); } });\n    return list;\n  }\n  spawnSquad(faction) {\n    const g = this.game, c = this.crosshair();\n    const key = `dev${g.tick}`;\n    const sq = g.actors.addSquadDef(key, { faction, n: 4, at: [c.x, c.z], noReman: true });\n    sq.forceLive = true; g.actors.liveSquad(g.ctx, sq);\n  }\n  spawnVehicle(kind) { const g = this.game, f = g.player.feet, fw = g.player.forward(); g.vehicles.spawn(kind, f.x + fw.x * 6, f.z + fw.z * 6, g.player.yaw); }\n  giveAll() {\n    const g = this.game, w = g.weapons;\n    for (const id of ['flare', 'tractor', 'mule', 'empire', 'weed', 'tube', 'm38']) { g.story.unlocked.add(id); }\n    w.give('m38', 100); w.give('empire', 100); w.give('tube', 100);\n    w.bottles = 3; w.charges = 2; g.story.unlocked.add('molotov');\n    g.story.trackerOwned = true;\n  }\n  applyCheats() {\n    const g = this.game, p = g.player;\n    if (p.flying !== this.noclip) { p.flying = this.noclip; if (p.cc) p.cc.collider.setEnabled(!this.noclip); }\n  }\n  setFreeCam(v) {\n    const g = this.game;\n    this.freeCam = v;\n    if (v) g.ctx.engine.setCamera({ preset: 'free' }, { syncUrl: false });\n    else g.ctx.engine.setCamera({ preset: 'first', fov: g.settings.fov }, { syncUrl: false });\n  }\n  open() {\n    const g = this.game;\n    g.ui.menu.push({\n      id: 'dev', title: 'DEV MODE', tabs: TABS, dim: 0, overlayWorld: true,\n      items: (s) => this.items(s.tab),\n      resetOne: (it) => { if (it?.key) { resetTuning(it.key); g.sfx.play('ui-confirm'); } },\n      hints: [['confirm', 'DO'], ['resetOne', 'RESET ONE'], ['back', 'BACK']],\n      onBack: () => { g.ui.menu.pop(); },\n      draw: (hud, m, s) => {\n        hud.rect(0, 0, hud.width, 42, 'ink');\n        m.title(hud, { title: 'DEV MODE' });\n        hud.text(hud.width - SAFE_X - 40 * 6, SAFE_Y + 3, g.status().slice(0, 40), { color: 'mist' });\n        m.drawTabs(hud, s, 30);\n        hud.rect(0, 42, hud.width * 0.72, hud.height - 42, 'ink');\n        let y = 48;\n        const items = m.itemsOf(s);\n        items.forEach((it, i) => { y += m.itemRow(hud, it, i, y, s.focus === i, SAFE_X, hud.width * 0.72 - SAFE_X - 8); });\n        const c = this.crosshair();\n        const counts = `ACTORS ${g.actors.anyStateCounts()}  BURNING ${g.fire.counts.burning}  BURNT ${g.fire.counts.burnt}  X ${Math.round(c.x)} Z ${Math.round(c.z)}`;\n        hud.text(SAFE_X, hud.height - SAFE_Y - 22, counts, { color: 'mist' });\n        m.footer(hud, s);\n      },\n    });\n  }\n  draw(hud) {\n    const g = this.game;\n    if (this.fireOverlay) this.drawGrid(hud, (x, z) => { const id = g.fire.idOf(x, z); if (id < 0) return null; const st = g.fire.state[id]; return st === 1 ? 'orange' : st === 2 ? 'ink' : st === 3 ? 'lime' : g.fire.fuel[id] ? 'sand' : null; });\n    if (this.navOverlay) this.drawGrid(hud, (x, z) => (g.world.nav.walkable(x, z) ? null : 'red'));\n  }\n  drawGrid(hud, fn) {\n    const g = this.game, f = g.player.feet, s = 3, n = 26;\n    const ox = hud.width - SAFE_X - n * 2 * s - 2, oy = SAFE_Y + 40;\n    hud.rect(ox - 1, oy - 1, n * 2 * s + 2, n * 2 * s + 2, 'night');\n    for (let j = -n; j < n; j++) for (let i = -n; i < n; i++) {\n      const c = fn(f.x + i * 5, f.z + j * 5);\n      if (c) hud.rect(ox + (i + n) * s, oy + (j + n) * s, s, s, c);\n    }\n    hud.rect(ox + n * s, oy + n * s, s, s, 'white');\n  }\n}\nimport { THREE } from '../../pixel-engine.js';\nconst _o = new THREE.Vector3(), _d = new THREE.Vector3();\nEOF\ncat > src/attract/beats.js <<'EOF'\n// The attract reel, as data: a list of beats. Each sets a place and an hour, then cheats its way through something worth seeing.\n// Run by the director, in the real game, with god mode and bot input through the same action layer.\nimport { SITES, POSTS } from '../content/sites.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { pointAlong, polyLength } from '../world/ground.js';\nimport { ROADS } from '../content/roads.js';\nconst look = (g, x, y, z) => { const e = g.player.eye, dx = x - e.x, dy = y - e.y, dz = z - e.z; g.player.setYaw(Math.atan2(-dx, -dz), Math.atan2(dy, Math.hypot(dx, dz))); };\nfunction squadAt(g, key, faction, x, z, n = 4) { const sq = g.actors.addSquadDef(key, { faction, n, at: [x, z], noReman: true }); sq.forceLive = true; g.actors.liveSquad(g.ctx, sq); return sq; }\nexport const BEATS = [\n  { id: 'drive-map', seconds: 12, hour: 18, * run(g, d, bot) {\n    const pts = ROADS.west.pts, p = pointAlong(pts, 60, [0, 0, 0]);\n    const v = g.vehicles.spawn('technical', p[0], p[1], p[2], { paint: 'orange', hood: 'red', roof: 'sand' });\n    d.keep.push(v);\n    g.driving.enter(v);\n    bot.analog.gas = 0.85;\n    for (let i = 0; i < 120; i++) { d.steerAlong(v, pts); yield 0; }\n    g.map.setWaypoint(-260, 240);\n    g.map.raise(true);\n    for (;;) { d.steerAlong(v, pts); yield 0; }\n  } },\n  { id: 'jam-fight', seconds: 13, hour: 15, * run(g, d, bot) {\n    const P = POSTS.p2;\n    g.player.teleport(P.at[0] + 22, P.at[1] + 22);\n    g.weapons.give('tractor', 28, true);\n    squadAt(g, 'attract-a', 'concord', P.at[0] + 2, P.at[1] + 2, 4);\n    look(g, P.at[0], g.player.eye.y - 0.2, P.at[1]);\n    yield 1;\n    bot.hold('fire');\n    g.weapons.scriptJamAt = 10; g.weapons.scriptShots = 0;\n    for (let i = 0; i < 90; i++) { d.aimNearest(); yield 0; if (g.weapons.gun.jam) break; }\n    bot.hold('fire', false);\n    for (let i = 0; i < 3; i++) { yield 0.5; bot.press('reload'); }\n    yield 0.8;\n    bot.hold('fire');\n    for (;;) { d.aimNearest(); yield 0; }\n  } },\n  { id: 'flare-grass', seconds: 14, hour: 16.5, wind: [0.9, 0.3, 6], * run(g, d, bot) {\n    const x = -130, z = 120;\n    g.player.teleport(x, z);\n    g.weapons.give('flare', 100, true);\n    g.player.setYaw(-1.2, 0.03);\n    squadAt(g, 'attract-b', 'harvest', x + 34, z + 6, 5);\n    yield 1;\n    bot.press('fire');\n    yield 2.5;\n    look(g, x + 30, g.player.eye.y, z + 6);\n    yield 1.2;\n    for (const s of g.actors.soldiers) if (s.active && !s.dead && s.squad?.key === 'attract-b') s.ignite();\n    for (;;) yield 0;\n  } },\n  { id: 'night-field', seconds: 13, hour: 22, wind: [0.9, 0.2, 5], * run(g, d, bot) {\n    const s = SITES['long-field'];\n    for (const [dx, dz] of [[-70, -40], [-70, 0], [-70, 40], [-40, -30], [-40, 30]]) g.fire.ignite(s.at[0] + dx, s.at[1] + dz, 8, 'world');\n    for (let i = 0; i < 4 * 12; i++) g.fire.tick(g.wind, 0.25);\n    const pts = [[s.at[0] - 120, s.at[1] + 80], [s.at[0] + 120, s.at[1] + 80]];\n    const v = g.vehicles.spawn('pickup', pts[0][0], pts[0][1], Math.PI / 2);\n    d.keep.push(v);\n    g.driving.enter(v);\n    g.driving.chase = true;\n    bot.analog.gas = 0.9;\n    for (;;) { d.steerAlong(v, pts); yield 0; }\n  } },\n  { id: 'fever', seconds: 10, hour: 13, * run(g, d, bot) {\n    g.player.teleport(-260, 225);\n    g.player.setYaw(0.2, -0.05);\n    g.weapons.give('tractor', 80, true);\n    g.body.tablets = 2;\n    g.story.feverRunning = true;\n    g.dev.noFever = false;\n    g.body.startFever({ limit: 999 });\n    yield 4;\n    bot.hold('tablet');\n    yield 1.4;\n    bot.hold('tablet', false);\n    for (;;) yield 0;\n  } },\n  { id: 'surgery', seconds: 7, hour: 11, * run(g, d, bot) {\n    g.player.teleport(90, -60);\n    g.player.setYaw(2, -0.1);\n    g.body.hp = 12;\n    g.body.lastDamage = 'bullet';\n    yield 0.4;\n    bot.press('heal');\n    for (;;) yield 0;\n  } },\n  { id: 'scoped', seconds: 10, hour: 12, * run(g, d, bot) {\n    const P = POSTS.p5;\n    g.player.teleport(P.at[0] - 120, P.at[1] - 30);\n    g.weapons.give('empire', 100, true);\n    const sq = squadAt(g, 'attract-c', 'concord', P.at[0], P.at[1], 4);\n    yield 0.5;\n    d.aimNearest();\n    bot.hold('aim');\n    yield 2;\n    for (;;) { d.aimNearest(); bot.press('fire'); yield 1.6; }\n  } },\n  { id: 'rescue', seconds: 12, hour: 10, * run(g, d, bot) {\n    g.player.teleport(-210, 80);\n    g.player.setYaw(0.4, 0);\n    g.weapons.give('tractor', 70, true);\n    const b = g.actors.buddy('ines'); b.met = true; b.dead = false; b.spentUntil = 0; b.woundedUntil = 0;\n    const was = g.dev.god; g.dev.god = false;\n    g.body.hp = 1;\n    g.body.hurt(10, 'bullet');\n    g.dev.god = was;\n    yield 5.2;\n    b.goDown(false);\n    g.player.teleport(b.x + 2, b.z);\n    look(g, b.x, b.y + 0.7, b.z);\n    for (;;) yield 0;\n  } },\n  { id: 'tracker', seconds: 10, hour: 9, * run(g, d, bot) {\n    const c = [-145, 435];\n    g.player.teleport(c[0] + 24, c[1] + 8);\n    g.story.trackerOwned = true;\n    look(g, c[0], g.player.eye.y - 0.5, c[1]);\n    g.fire.burnStrip([[c[0] - 12, c[1]], [c[0] + 20, c[1] + 6]], 16);\n    yield 0.4;\n    bot.press('tracker');\n    bot.move.y = 0.7;\n    for (;;) { look(g, c[0], g.player.eye.y - 0.7, c[1]); yield 0; }\n  } },\n  { id: 'train-mg', seconds: 12, hour: 17, * run(g, d, bot) {\n    const tr = g.train;\n    tr.place(tr.sAt(-40, 75));\n    g.player.seatOnTrain(3, [0, 2.3, 1.2], true, 0.15);\n    g.weapons.mounted = { turret: () => { const c = tr.cars[3]; if (c.turret) c.turret.rotation.y = g.player.yaw - c.yaw + Math.PI; } };\n    tr.run(tr.sAt(300, -15), 12);\n    squadAt(g, 'attract-d', 'harvest', 60, 80, 5);\n    squadAt(g, 'attract-e', 'concord', 150, 60, 5);\n    yield 0.6;\n    bot.hold('fire');\n    for (;;) { d.aimNearest(); yield 0; }\n  } },\n  { id: 'rack', seconds: 9, hour: 11, * run(g, d, bot) {\n    const n = g.npcs.byWho.tibor;\n    g.player.teleport(n.x + 1, n.z + 3.5);\n    look(g, n.x, n.y + 1.4, n.z);\n    g.story.stones = 40;\n    yield 1;\n    g.ui.openRack();\n    for (let i = 0; i < 4; i++) { yield 1.6; g.ui.menu.top?.onSide?.(1, g.ui.menu.top); }\n    for (;;) yield 0;\n  } },\n  { id: 'map-table', seconds: 9, hour: 22, * run(g, d, bot) {\n    const s = SITES.observatory;\n    g.player.teleport(s.at[0], s.at[1] + 3.5);\n    for (const k of ['A', 'B', 'C']) g.missions.applyOps([{ burnStrip: k }], true);\n    g.ending.endScene = false;\n    g.ending.harrowScene(g.npcs.byWho.harrow);\n    yield 1.5;\n    g.ending.layMap();\n    for (;;) yield 0;\n  } },\n  { id: 'title-card', seconds: 6, hour: 18.5, title: true, wind: [0.9, 0.3, 5], * run(g, d, bot) {\n    const s = SITES['long-field'];\n    g.fire.ignite(s.at[0], s.at[1], 18, 'world');\n    for (let i = 0; i < 4 * 8; i++) g.fire.tick(g.wind, 0.25);\n    g.player.teleport(s.at[0] + 110, s.at[1] + 80);\n    look(g, s.at[0], g.player.eye.y + 2, s.at[1]);\n    for (;;) yield 0;\n  } },\n];\nEOF\ncat > src/attract/director.js <<'EOF'\n// After 10 seconds with no input on the title or main menu: a looping demo using the real game, god mode, bot input and teleports. Any input exits.\nimport { BEATS } from './beats.js';\nimport { Bot } from '../core/actions.js';\nimport { wrapAngle, clamp } from '../core/rng.js';\nconst IDLE_FRAMES = 600;\nexport class Attract {\n  active = false; idleFrames = 0; beatI = 0; t = 0; gen = null; wait = 0; pred = null; keep = []; loops = 0; returnTo = null;\n  constructor(game) { this.game = game; this.bot = new Bot(); }\n  /** Runs in update: counts frames with no input on the title or main menu. */\n  tick(ctx, inputSeen) {\n    const g = this.game;\n    if (this.active) { if (inputSeen) this.stop(); return; }\n    const top = g.ui.menu.top;\n    const eligible = g.mode === 'title' && top && top.attractIdle && g.ui.menu.stack.length === 1;\n    if (!eligible || inputSeen) { this.idleFrames = 0; return; }\n    this.idleFrames++;\n    if (this.idleFrames > IDLE_FRAMES) this.start();\n  }\n  start() {\n    const g = this.game;\n    this.active = true; this.beatI = 0; this.loops = 0;\n    this.returnTo = g.ui.menu.top?.id;\n    g.ui.menu.clear();\n    g.save.disabled = true;\n    g.mode = 'attract';\n    g.actions.bot = this.bot; this.bot.clear();\n    g.dev.god = true; g.dev.infiniteAmmo = true; g.dev.noJams = false; g.dev.noWear = true;\n    g.setSeated(false);\n    g.engineResume();\n    this.beginBeat();\n    g.events.emit('attract-start');\n  }\n  stop() {\n    const g = this.game;\n    if (!this.active) return;\n    this.active = false;\n    this.gen = null;\n    g.actions.bot = null; this.bot.clear();\n    g.dev.god = false; g.dev.infiniteAmmo = false; g.dev.noWear = false;\n    g.ctx.engine.screen.clear();\n    g.events.emit('attract-stop');\n    g.resetCampaign({ keepScene: true });\n    g.save.disabled = false;\n    g.mode = 'title';\n    g.shell.enterTitle();\n    if (this.returnTo === 'main') { g.ui.menu.clear(); g.ui.menu.push(g.shell.mainMenu()); }\n    this.idleFrames = 0;\n    g.setupTitleScene();\n  }\n  beginBeat() {\n    const g = this.game;\n    const b = BEATS[this.beatI];\n    this.cleanupBeat();\n    g.resetCampaign({ keepScene: true, keepAttract: true });\n    g.mode = 'attract';\n    g.dev.god = true; g.dev.infiniteAmmo = true; g.dev.noWear = true;\n    g.story.flags.arrived = true;\n    g.body.syrettes = 5; g.body.tablets = 2;\n    g.weapons.give('m38', 100, false);\n    g.weapons.give('tractor', 70, true);\n    g.clock.set(b.hour);\n    g.clock.hour = b.hour;\n    if (b.wind) g.wind.pin([b.wind[0], b.wind[1]], b.wind[2]);\n    g.sky.apply(g.ctx, b.hour);\n    g.sky.setWeather('clear');\n    this.t = 0; this.wait = 0; this.pred = null;\n    this.bot.clear();\n    this.gen = b.run(g, this, this.bot);\n    g.hudHidden = false;\n    g.titleOverlay = !!b.title;\n    g.events.emit('attract-beat', b.id);\n    g.ctx.engine.screen.reveal('dither', { duration: 0.35 });\n  }\n  cleanupBeat() {\n    const g = this.game;\n    if (g.ui.menu.open) g.ui.menu.clear();\n    if (g.player.seat) { if (g.driving.vehicle) g.driving.eject(); else g.player.leaveTrain(g.player.feet.x, g.player.feet.z); }\n    g.map.raise(false);\n    g.weapons.mounted = null;\n    g.ending.endScene = true; g.scene.stop(); g.ending.endScene = false;\n    if (g.ending.tableMap) { g.ctx.scene.remove(g.ending.tableMap); g.ending.tableMap = null; }\n    g.map.glowScar = false;\n    g.places.setTracker(false);\n    this.keep = [];\n    g.titleOverlay = false;\n  }\n  /** Fixed step: run the reel. */\n  fixedUpdate(ctx, dt) {\n    if (!this.active) return;\n    const g = this.game, b = BEATS[this.beatI];\n    this.t += dt;\n    if (this.t >= b.seconds) {\n      this.beatI = (this.beatI + 1) % BEATS.length;\n      if (this.beatI === 0) this.loops++;\n      ctx.engine.screen.cover('dither', { duration: 0.25 });\n      g.after(0.28, () => { if (this.active) this.beginBeat(); });\n      this.t = -1e9;\n      this.gen = null;\n      return;\n    }\n    if (!this.gen) return;\n    if (this.pred) { if (!this.pred()) return; this.pred = null; }\n    if (this.wait > 0) { this.wait -= dt; if (this.wait > 0) return; }\n    const { value, done } = this.gen.next();\n    if (done) { this.gen = null; return; }\n    if (typeof value === 'number') this.wait = value;\n    else if (typeof value === 'function') this.pred = value;\n  }\n  aimNearest() {\n    const g = this.game, e = g.player.eye;\n    let best = null, bd = 400;\n    for (const s of g.actors.soldiers) { if (!s.active || s.dead) continue; const d = Math.hypot(s.x - e.x, s.z - e.z); if (d < bd) { bd = d; best = s; } }\n    if (!best) return;\n    const dx = best.x - e.x, dy = best.y + 1.2 - e.y, dz = best.z - e.z;\n    const wy = Math.atan2(-dx, -dz), wp = Math.atan2(dy, Math.hypot(dx, dz));\n    const rig = g.ctx.camera;\n    rig.yaw += wrapAngle(wy - rig.yaw) * 0.08; rig.pitch += (wp - rig.pitch) * 0.08;\n  }\n  steerAlong(v, pts) {\n    const bot = this.bot;\n    let bd = 1e9, ti = 0, s = 0;\n    for (let i = 0; i + 1 < pts.length; i++) { const d = Math.hypot(pts[i + 1][0] - v.x, pts[i + 1][1] - v.z); if (d < bd && d > 14) { bd = d; ti = i + 1; } }\n    const [tx, tz] = pts[ti];\n    const err = wrapAngle(Math.atan2(tx - v.x, tz - v.z) - v.yaw);\n    bot.move = { x: clamp(err * 1.5, -1, 1), y: 0 };\n  }\n}\nEOF\ncat > src/content/about.js <<'EOF'\n// The About and Credits text, paged. The brief's questions and honest answers, in order.\nexport const SOURCE_INFO = [\n  ['DATE', '2026-11-05 16:20:27'],\n  ['SOURCE', 'FAR CRY 2'],\n  ['PLAN', 'PLAN.MD'],\n  ['GENRE AND PERSPECTIVE', 'OPEN-WORLD FIRST-PERSON SHOOTER WITH SURVIVAL PRESSURE AND SYSTEMIC FIRE. FIRST PERSON, WITH A CHASE CAMERA IN VEHICLES ONLY.'],\n  ['TECH', 'PIXEL ENGINE 0.46.0 (RIFTLIGHT KIT), THREE.JS R186 (WEBGPU), RAPIER 0.20, ESBUILD 0.28, PLAYWRIGHT 1.63 FOR TESTS, OUR OWN GAME SYSTEMS IN JAVASCRIPT.'],\n  ['ART DIRECTION', 'THE ENGINE\\'S 3D-AS-PIXEL-ART PIPELINE AT 480X270, TOON MATERIALS, SWEETIE 16 PALETTE. NEW PEOPLE, GUNS, VEHICLES, BUILDINGS AND TREES AS DATA; LIBRARY PROPS FOR THE GENERIC ONES.'],\n  ['ANIMATION', 'THE ENGINE\\'S CLIPDEF SYSTEM AT 30 FPS, HERO CLIPS FOR PEOPLE, NEW KEYED CLIPS ON THE PEOPLE RIG AND A FIRST-PERSON HANDS RIG, RAGDOLLS, PROCEDURAL SWAY AND RECOIL.'],\n  ['AUDIO', 'ALL WRITTEN IN CODE. SOUNDDEF SYNTHESIS FOR EFFECTS, SONG DATA FOR SEVEN ORIGINAL TRACKS, GENERATED GIBBERISH VOICES. NO AUDIO FILES. MUSIC DEFAULTS TO 10%.'],\n  ['ONLINE', 'AI HUB SESSION PROTOCOL V1, SHARED WORLD, 1 TO 4 PLAYERS. ON ITS OWN: SOLO WITH AI MERCS, AND TWO WINDOWS ON ONE COMPUTER BY BROADCASTCHANNEL.'],\n  ['TESTING', 'HEADLESS NODE AND PLAYWRIGHT CHROMIUM, WEBGPU IN SOFTWARE. ONE COMMAND THAT PRINTS FAILURES AND A COUNT. SCREENSHOTS ONLY FOR WHAT A SCRIPT CANNOT CHECK. NO REVIEW SUBAGENTS.'],\n  ['RESEARCH', 'NONE BEYOND THE PLAN, THE ENGINE KIT\\'S DOCS AND THE AI HUB PROTOCOL.'],\n  ['ENVIRONMENT', 'CLAUDE CODE CLI (HEADLESS); LINUX'],\n  ['MODEL', 'ANTHROPIC, CLAUDE-OPUS-5-5, REASONING EFFORT XHIGH'],\n  ['USAGE', 'ADDED ON IMPORT'],\n];\nexport const TESTING_FEEDBACK = [\n  ['HOW MANY ISSUES DID TESTING CATCH?', ''],\n  ['HOW MANY WOULD BE CONSIDERED CRITICAL ISSUES / GAME BREAKING?', ''],\n  ['WHAT WAS THE MOST HELPFUL TEST YOU RAN?', ''],\n  ['WHAT WAS THE LEAST HELPFUL TEST YOU RAN?', ''],\n];\nexport const ENGINE_FEEDBACK = [\n  ['WHAT DID YOU LIKE MOST ABOUT THE ENGINE?', ''],\n  ['DID YOU GET STUCK OR GUESS WRONG?', ''],\n  ['WHAT WAS THE MOST IMPORTANT THING YOU HAD TO BUILD YOURSELF?', ''],\n  ['WHAT WAS THE HARDEST PART ABOUT USING THE ENGINE?', ''],\n  ['WHAT DID YOU CHANGE IN THE ENGINE, AND WHY? (NONE IF NOTHING)', ''],\n  ['IF YOU COULD CHANGE ONE THING ABOUT THE ENGINE, WHAT WOULD IT BE?', ''],\n];\nexport const PROMPT_FEEDBACK = [\n  ['WHAT DID YOU LIKE MOST ABOUT THIS PROMPT?', ''],\n  ['WHAT WAS CONFUSING?', ''],\n  ['WHAT WAS THE HARDEST THING TO DO?', ''],\n  ['WHAT WOULD YOU CHANGE IN THIS PROMPT?', ''],\n];\nexport const CREDITS_LINES = [\n  'PIXEL ENGINE (MIT)', 'THREE.JS (MIT)', 'RAPIER (APACHE-2.0)', 'THE AI HUB SESSION CLIENT',\n  'INSPIRED BY FAR CRY 2; NOT AFFILIATED',\n];\nEOF\ncat > src/ui/about.js <<'EOF'\n// Turns the about content into pages: one idea per screen, paged, never a table.\nimport { SOURCE_INFO, TESTING_FEEDBACK, ENGINE_FEEDBACK, PROMPT_FEEDBACK, CREDITS_LINES } from '../content/about.js';\nimport { GAME_TITLE } from '../content/title.js';\nconst up = (s) => String(s).toUpperCase();\nexport class About {\n  pages() {\n    const out = [];\n    const si = [];\n    for (let i = 0; i < SOURCE_INFO.length; i += 3) {\n      const page = [{ text: 'SOURCE INFORMATION', color: 'orange' }];\n      for (const [k, v] of SOURCE_INFO.slice(i, i + 3)) { page.push({ text: k, color: 'sand' }); page.push({ text: up(v), color: 'white' }); }\n      out.push(page);\n    }\n    const qa = (title, list) => {\n      for (let i = 0; i < list.length; i += 2) {\n        const page = [{ text: title, color: 'orange' }];\n        for (const [q, a] of list.slice(i, i + 2)) { page.push({ text: q, color: 'sand' }); page.push({ text: up(a), color: 'white' }); }\n        out.push(page);\n      }\n    };\n    qa('TESTING FEEDBACK', TESTING_FEEDBACK);\n    qa('ENGINE FEEDBACK', ENGINE_FEEDBACK);\n    qa('PROMPT FEEDBACK', PROMPT_FEEDBACK);\n    out.push(...this.creditPages());\n    return out;\n  }\n  creditPages() {\n    return [[{ text: up(GAME_TITLE), color: 'orange', scale: 2 }, ...CREDITS_LINES.map((t) => ({ text: t, color: 'white' }))]];\n  }\n}\nEOF\necho ok","description":"Write dev mode, attract reel and director, about pages"}}}
