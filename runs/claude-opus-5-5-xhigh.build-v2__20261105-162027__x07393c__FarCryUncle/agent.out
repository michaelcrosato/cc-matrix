{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkhfETc6bydcPqAgAbiC","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14102,"cache_read_input_tokens":511619,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14102},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"0e6ece9e-a931-444d-8005-831ea56726ea","timestamp":"2026-11-06T00:08:40.024Z","request_id":"req_011CgkhfEDDgjAkY9czGMRDt","thinking_duration_ms":1842,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkhfETc6bydcPqAgAbiC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LGtDRHkjoFGB6w8cF4Dx8Q","name":"Bash","input":{"command":"set -e\ncat > src/ui/hud.js <<'EOF'\n// The in-play HUD: minimal, hides 6 s after it last changed. Prompts follow the device used last.\nimport { THREE } from '../../pixel-engine.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { NAMES, SPEAKER_COLOR } from '../content/dialogue.js';\nimport { ACT } from '../core/actions.js';\nimport { drawGlyph, glyphWidth } from './glyphs.js';\nimport { wrap } from './pixfont.js';\nimport { clamp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst _v = new Vector3();\nconst GUN_ICON = ['.....oooooo.', 'oooooooooooo', 'oooooo.o....', '..oo.o......', '..oo........'];\nconst SYRETTE = ['..o..', '..o..', '.ooo.', '.oxo.', '.oxo.', '.ooo.', '..o..'];\nconst TABLET = ['.ooo.', 'ooooo', 'ox.xo', 'ooooo', '.ooo.'];\nexport const SAFE_X = 24, SAFE_Y = 14;\nexport class GameHud {\n  touched = -99; bannerT = 0; banner = ''; noticeT = 0; noticeText = ''; prompts = []; muzzle = 0; jamT = 0;\n  constructor(game) { this.game = game; }\n  touch() { this.touched = this.game.realT; }\n  addPrompt(act, text, extra) { const g = this.game; this.prompts.push({ act, text, glyph: g.actions.glyph(act, g.settings.glyphs === 'xb'), ...extra }); }\n  draw(ctx, dt) {\n    const g = this.game, h = ctx.hud;\n    this.bannerT = Math.max(0, this.bannerT - dt);\n    this.noticeT = Math.max(0, this.noticeT - dt);\n    this.jamT = Math.max(0, this.jamT - dt);\n    g.subtitle.t = Math.max(0, g.subtitle.t - dt);\n    if (g.hudHidden) return;\n    this.world(ctx);\n    if (g.scene.active && g.scene.bars > 0.05) this.bars(h, g.scene.bars);\n    const scoped = g.weapons.aiming && g.weapons.def.scoped && g.weapons.aimT > 0.6;\n    if (scoped || g.monoT > 0.5) this.scopeMask(h);\n    if (g.body.burnScreen > 0.01) this.burnEdges(h, g.body.burnScreen);\n    if (g.body.hurtFlash > 0.4 && !g.settings.reduceFlashes) this.hurtEdges(h);\n    if (g.body.dirFlash > 0) this.damageDir(h);\n    const show = g.realT - this.touched < 6 || g.body.hp < 100 || g.weapons.reloading > 0 || g.weapons.gun?.jam > 0;\n    if (g.hasPlayer && !g.scene.active) {\n      if (show) { this.vitals(h); this.ammo(h); }\n      this.reticle(h, ctx);\n    }\n    this.banners(h);\n    this.subtitles(h);\n    this.promptRow(h);\n    this.holdRing(h, ctx);\n  }\n  vitals(h) {\n    const g = this.game, b = g.body;\n    const x = SAFE_X, y = h.height - SAFE_Y - 11;\n    for (let i = 0; i < 5; i++) {\n      const v = clamp((b.hp - i * 20) / 20, 0, 1);\n      h.rect(x + i * 15, y, 13, 6, 'ink');\n      h.rect(x + i * 15 + 1, y + 1, 11, 4, 'night');\n      if (v > 0) h.rect(x + i * 15 + 1, y + 1, Math.round(11 * v), 4, b.hp < 20 ? 'red' : b.burning ? 'orange' : 'sand');\n    }\n    h.sprite(x, y - 10, SYRETTE, { o: 'white', x: 'red' });\n    h.text(x + 8, y - 9, String(b.syrettes), { color: 'white' });\n    h.sprite(x + 22, y - 9, TABLET, { o: 'white', x: 'ink' });\n    h.text(x + 30, y - 9, String(b.tablets), { color: b.feverOn ? 'orange' : 'white' });\n    if (g.story?.stones != null && g.mode !== 'round' && g.realT - this.touched < 6) { h.text(x + 46, y - 9, `${g.story.stones} STONES`, { color: 'sand' }); }\n  }\n  ammo(h) {\n    const g = this.game, w = g.weapons;\n    if (g.round?.carrying) { /* a case in your hands shows on the Cash Run bar */ }\n    if (w.mounted) {\n      const x = h.width - SAFE_X - 60, y = h.height - SAFE_Y - 8;\n      h.rect(x, y, 60, 6, 'ink'); h.rect(x + 1, y + 1, Math.round(58 * w.heat), 4, w.overheated ? 'red' : 'orange');\n      h.text(x, y - 10, 'MOUNTED MG', { color: 'white' });\n      return;\n    }\n    const gun = w.gun, def = w.def;\n    if (!gun) return;\n    const color = w.condColor();\n    const right = h.width - SAFE_X;\n    if (def.cls === 'melee') { h.text(right - def.name.length * 6, h.height - SAFE_Y - 8, def.name, { color: 'mist' }); }\n    else {\n      const mag = String(Math.ceil(gun.mag)), res = String(gun.reserve);\n      const tw = (mag.length + 1 + res.length) * 6;\n      h.text(right - tw - 0, h.height - SAFE_Y - 14, mag, { scale: 1, color: gun.mag === 0 ? 'red' : 'white' });\n      h.text(right - res.length * 6, h.height - SAFE_Y - 14, res, { color: 'mist' });\n      h.text(right - tw + mag.length * 6, h.height - SAFE_Y - 14, '/', { color: 'slate' });\n      h.sprite(right - tw - 18, h.height - SAFE_Y - 14, GUN_ICON, { o: color });\n      h.text(right - def.name.length * 6, h.height - SAFE_Y - 6, def.name, { color: 'mist' });\n    }\n    const y = h.height - SAFE_Y - 26;\n    if (w.bottles || w.charges || w.placed.length) {\n      const t = `BOTTLES ${w.bottles}  CHARGES ${w.charges}${w.placed.length ? ` SET ${w.placed.length}` : ''}`;\n      h.text(right - t.length * 6, y, t, { color: 'mist' });\n    }\n    if (g.actions.bot?.only !== true && (gun.jam > 0 || this.jamT > 0)) { /* prompt added in promptRow */ }\n  }\n  reticle(h, ctx) {\n    const g = this.game, w = g.weapons;\n    if (g.mapUp || g.inMonocular()) return;\n    if (w.def.scoped && w.aimT > 0.5) return;\n    const cx = (h.width / 2) | 0, cy = (h.height / 2) | 0;\n    const col = g.interact.current ? 'lime' : 'white';\n    h.rect(cx, cy, 1, 1, col);\n    if (g.fx.markerT > 0) {\n      const c = g.fx.markerHead ? 'red' : 'white', r = 4;\n      for (let i = 2; i <= r; i++) { h.rect(cx - i, cy - i, 1, 1, c); h.rect(cx + i, cy - i, 1, 1, c); h.rect(cx - i, cy + i, 1, 1, c); h.rect(cx + i, cy + i, 1, 1, c); }\n    }\n  }\n  bars(h, k) {\n    const hh = Math.round(20 * k);\n    h.rect(0, 0, h.width, hh, 'ink'); h.rect(0, h.height - hh, h.width, hh, 'ink');\n  }\n  scopeMask(h) {\n    const cx = h.width / 2, cy = h.height / 2, r = Math.floor(h.height * 0.42);\n    for (let y = 0; y < h.height; y++) {\n      const dy = y - cy, half = Math.abs(dy) >= r ? 0 : Math.sqrt(r * r - dy * dy) | 0;\n      if (!half) { h.rect(0, y, h.width, 1, 'ink'); continue; }\n      h.rect(0, y, Math.max(0, cx - half), 1, 'ink'); h.rect(cx + half, y, Math.max(0, h.width - cx - half), 1, 'ink');\n    }\n    h.rect(cx - r, cy, r * 2, 1, 'ink'); h.rect(cx, cy - r, 1, r * 2, 'ink');\n  }\n  burnEdges(h, k) {\n    const r = this.game.rng.fx, w = h.width, H = h.height;\n    for (let x = 0; x < w; x += 7) {\n      const up = 6 + (r.next() * 26 * k) | 0;\n      h.rect(x, H - up, 7, up, r.next() > 0.5 ? 'orange' : 'red');\n      h.rect(x + 1, H - (up >> 1), 5, up >> 1, 'sand');\n      if (x % 3 === 0) { const d = (r.next() * 12 * k) | 0; h.rect(x, 0, 7, d, 'red'); }\n    }\n  }\n  hurtEdges(h) {\n    const w = h.width, H = h.height, t = 4;\n    h.rect(0, 0, w, t, 'red'); h.rect(0, H - t, w, t, 'red'); h.rect(0, 0, t, H, 'red'); h.rect(w - t, 0, t, H, 'red');\n  }\n  damageDir(h) {\n    const g = this.game;\n    const a = g.body.lastDir - g.player.yaw + Math.PI;\n    const cx = h.width / 2, cy = h.height / 2, r = 46;\n    const x = cx + Math.sin(a) * r, y = cy - Math.cos(a) * r;\n    for (let i = 0; i < 5; i++) h.rect(x - 2 + Math.cos(a) * (i - 2) * 2, y - 1 + Math.sin(a) * (i - 2) * 2, 2, 2, 'red');\n  }\n  banners(h) {\n    const g = this.game;\n    if (this.bannerT > 0) { const t = this.banner; const lines = wrap(t, h.width - 80); let y = SAFE_Y; for (const l of lines) { h.text(((h.width - l.length * 6) / 2) | 0, y, l, { color: 'sand', shadow: 'ink' }); y += 10; } }\n    if (this.noticeT > 0) { const lines = wrap(this.noticeText, h.width - 80); let y = SAFE_Y + 24; for (const l of lines) { h.text(((h.width - l.length * 6) / 2) | 0, y, l, { color: 'white', shadow: 'ink' }); y += 10; } }\n    const m = g.missions?.active;\n    if (m?.timer) { const t = Math.max(0, Math.ceil(g.missions.timer)); const s = `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`; h.text(h.width - SAFE_X - s.length * 6 * 2, SAFE_Y, s, { scale: 2, color: t < 60 ? 'red' : 'white' }); }\n    if (g.holdT > 0) { const t = Math.ceil(g.holdT); const s = `${t}`; h.text(h.width - SAFE_X - s.length * 6 * 2, SAFE_Y, s, { scale: 2, color: 'sand' }); }\n    if (g.mode === 'attract') { h.rect(SAFE_X - 3, SAFE_Y - 2, 34, 11, 'red'); h.text(SAFE_X, SAFE_Y, 'DEMO', { color: 'white', shadow: false }); }\n  }\n  subtitles(h) {\n    const g = this.game, s = g.subtitle;\n    if (s.t <= 0 || !s.text) return;\n    const scale = g.settings.subtitleSize;\n    const lines = wrap(s.text, Math.min(h.width - 60, 60 * 6 * scale), scale).slice(0, 2);\n    const y0 = h.height - SAFE_Y - 40 - lines.length * 9 * scale - (g.scene.active ? 8 : 0);\n    const name = NAMES[s.who] ?? '';\n    const lh = 9 * scale;\n    let maxw = 0; for (const l of lines) maxw = Math.max(maxw, l.length * 6 * scale);\n    const bx = ((h.width - maxw) / 2) | 0;\n    if (name) h.text(bx, y0 - 10, name, { color: SPEAKER_COLOR[s.who] ?? 'white', shadow: 'ink' });\n    lines.forEach((l, i) => h.text(((h.width - l.length * 6 * scale) / 2) | 0, y0 + i * lh, l, { color: 'white', scale, shadow: 'ink' }));\n  }\n  promptRow(h) {\n    const list = this.prompts;\n    if (!list.length) return;\n    let total = 0;\n    for (const p of list) total += glyphWidth(p.glyph) + 3 + p.text.length * 6 + 10;\n    let x = ((h.width - total + 10) / 2) | 0;\n    const y = h.height - SAFE_Y - 24;\n    for (const p of list) {\n      const w = drawGlyph(h, x, y, p.glyph);\n      h.text(x + w + 3, y + 2, p.text, { color: p.dim ? 'slate' : 'white', shadow: 'ink' });\n      x += w + 3 + p.text.length * 6 + 10;\n    }\n  }\n  holdRing(h, ctx) {\n    const f = this.game.interact.holdFrac();\n    if (f <= 0) return;\n    const cx = h.width / 2, cy = h.height / 2, n = 28, r = 12;\n    for (let i = 0; i < n; i++) {\n      const a = (i / n) * Math.PI * 2 - Math.PI / 2;\n      h.rect(cx + Math.cos(a) * r, cy + Math.sin(a) * r, 2, 2, i / n <= f ? 'sand' : 'night');\n    }\n  }\n  /** Things in the world drawn by projection: ? and ! over soldiers, a pixel cross over a downed friend. */\n  world(ctx) {\n    const g = this.game, h = ctx.hud, cam = ctx.camera.camera;\n    if (g.scene.active) return;\n    const project = (x, y, z) => {\n      _v.set(x, y, z).project(cam);\n      if (_v.z > 1 || _v.z < -1) return null;\n      return [((_v.x + 1) / 2) * h.width, ((1 - _v.y) / 2) * h.height];\n    };\n    for (const s of g.actors.soldiers) {\n      if (!s.active || s.dead || g.mode === 'attract') continue;\n      const d = Math.hypot(s.x - g.camPos.x, s.z - g.camPos.z);\n      if (d > 40) continue;\n      if (s.state === 'idle' && s.suspicion < 0.3) continue;\n      const p = project(s.x, s.y + 2.05, s.z);\n      if (!p) continue;\n      h.text(p[0] - 3, p[1] - 4, s.state === 'alert' ? '!' : '?', { color: s.state === 'alert' ? 'red' : 'sand', shadow: 'ink' });\n    }\n    for (const b of g.actors.buddies) {\n      if (!b.active || !b.isDown) continue;\n      const p = project(b.x, b.y + 1.4, b.z);\n      if (!p) continue;\n      h.rect(p[0] - 1, p[1] - 4, 3, 9, 'red'); h.rect(p[0] - 4, p[1] - 1, 9, 3, 'red');\n    }\n    if (g.dev.aiText) {\n      for (const s of g.actors.soldiers) {\n        if (!s.active || s.dead) continue;\n        const p = project(s.x, s.y + 2.3, s.z);\n        if (p && Math.hypot(s.x - g.camPos.x, s.z - g.camPos.z) < 120) h.text(p[0] - 12, p[1] - 12, `${s.state} ${Math.round(s.hp)}`, { color: 'cyan' });\n      }\n    }\n    g.round?.drawWorldHud?.(ctx, project);\n  }\n}\nEOF\ncat > src/ui/ui.js <<'EOF'\n// Screens: choices, Tibor's rack, locker, bed, notice board, halts, wall, ledger, game over, ending card, credits. Title and pause live in shell.js.\nimport { THREE, buildModel, setLookLayer } from '../../pixel-engine.js';\nimport { WEAPONS, THROWN, UPGRADES, SLOT_ORDER } from '../content/weapons.js';\nimport { Menu, SAFE_X, SAFE_Y } from './menu.js';\nimport { rackDefs } from '../art/viewmodels.js';\nimport { SITES, HALTS } from '../content/sites.js';\nimport { MISSIONS } from '../content/missions.js';\nimport { LINES } from '../content/dialogue.js';\nimport { EPIGRAPHS } from '../content/notes.js';\nimport { drawGlyph, glyphWidth } from './glyphs.js';\nimport { wrap } from './pixfont.js';\nimport { clamp } from '../core/rng.js';\nconst TIMES = { DAWN: 5.5, NOON: 12, DUSK: 18, MIDNIGHT: 0 };\nexport class UI {\n  constructor(game) { this.game = game; this.menu = new Menu(game); }\n  get open() { return this.menu.open; }\n  // ---- two big buttons at most ----\n  choice(title, options, { noBack = true } = {}) {\n    const g = this.game;\n    const s = {\n      id: 'choice', title, overlayWorld: true, noBack,\n      items: options.map((o) => ({ id: o.id ?? o.label, label: o.label, onSelect: () => { this.menu.pop(); o.onSelect?.(); } })),\n      draw: (hud, m, sc) => {\n        const y0 = hud.height - 96;\n        hud.rect(0, y0 - 16, hud.width, 90, 'ink');\n        hud.text(((hud.width - title.length * 12) / 2) | 0, y0 - 12, title, { scale: 2, color: 'sand', shadow: false });\n        let y = y0 + 8;\n        sc.items.forEach((it, i) => {\n          const focused = sc.focus === i;\n          hud.rect(60, y, hud.width - 120, 20, focused ? 'orange' : 'night');\n          hud.text(((hud.width - it.label.length * 12) / 2) | 0, y + 3, it.label, { scale: 2, color: focused ? 'ink' : 'white', shadow: false });\n          m.regions.push({ x: 60, y, w: hud.width - 120, h: 20, index: i });\n          y += 24;\n        });\n      },\n    };\n    this.menu.push(s);\n    return s;\n  }\n  // ---- Bed ----\n  openBed(key) {\n    const g = this.game, opts = Object.entries(TIMES);\n    this.menu.push({\n      id: 'bed', title: 'SLEEP UNTIL', subtitle: 'IT SAVES. THE FEVER DOES NOT SLEEP.', overlayWorld: true,\n      items: [...opts.map(([label, h]) => ({ id: label.toLowerCase(), label, onSelect: () => { this.menu.pop(); g.sleepTo(h, key); } })), { id: 'leave', label: 'LEAVE', onSelect: () => this.menu.pop() }],\n    });\n  }\n  // ---- Locker: one row per slot, left/right picks ----\n  openLocker() {\n    const g = this.game, w = g.weapons;\n    const row = (slot) => {\n      const options = Object.values(WEAPONS).filter((d) => d.slot === slot && g.story.unlocked.has(d.id)).map((d) => d.id);\n      return {\n        id: slot, label: slot.toUpperCase(),\n        choices: { options: options.length ? options : ['none'], get: () => w.slots[slot]?.id ?? (options[0] ?? 'none'), set: (id) => { if (id !== 'none') { w.give(id, 100, slot === w.current); } }, format: (id) => (id === 'none' ? 'NOTHING' : WEAPONS[id].name) },\n      };\n    };\n    this.menu.push({\n      id: 'locker', title: 'LOCKER', subtitle: 'WHAT YOU HAVE BOUGHT COMES CLEAN. HE KEEPS IT THAT WAY.', overlayWorld: true,\n      items: () => [row('sidearm'), row('main'), row('special'), ...(g.story.stockInLockers ? [{ id: 'stock', label: \"TIBOR'S STOCK\", onSelect: () => this.openRack() }] : []), { id: 'done', label: 'CLOSE', onSelect: () => this.menu.pop() }],\n      hints: [['menuLeft', 'CHOOSE'], ['back', 'CLOSE']],\n    });\n  }\n  openWall() {\n    const g = this.game;\n    const dead = g.actors.buddies.filter((b) => b.dead);\n    g.dialogue.play(dead.length ? [['', `SCRATCHED INTO THE PLANK: ${dead.map((b) => b.name).join(', ')}.`], ['', 'A GUN LEANS UNDER IT. NOBODY HAS TOUCHED IT.']] : 'wall.empty');\n  }\n  // ---- Tibor's rack: one gun at a time, large, three bars ----\n  rackList() {\n    const out = [];\n    for (const d of Object.values(WEAPONS)) if (d.price > 0) out.push({ kind: 'gun', id: d.id, name: d.name, price: d.price, def: d });\n    out.push({ kind: 'throw', id: 'molotov', name: 'BOTTLE', price: THROWN.molotov.price, about: 'A RAG AND SOMETHING THAT BURNS. CARRY THREE.' });\n    out.push({ kind: 'throw', id: 'charge', name: 'REMOTE CHARGE', price: THROWN.charge.price, about: 'HOLD THROW TO PLANT. THROW AGAIN TO REGRET IT.' });\n    for (const u of Object.values(UPGRADES)) out.push({ kind: 'up', id: u.id, name: u.name, price: u.price, about: u.about });\n    return out;\n  }\n  owned(item) {\n    const g = this.game;\n    if (item.kind === 'gun') return g.story.unlocked.has(item.id);\n    if (item.kind === 'up') return !!g.story.flags[`up-${item.id}`];\n    return false;\n  }\n  buy(item) {\n    const g = this.game, st = g.story, w = g.weapons;\n    if (item.kind === 'gun' && st.unlocked.has(item.id)) { w.give(item.id, 100, true); g.events.emit('rack-take', item.id); return true; }\n    if (this.owned(item)) return false;\n    if (st.stones < item.price) { g.sfx.play('ui-back'); g.notice('HE SHAKES HIS HEAD. NOT ENOUGH STONES.', 2); return false; }\n    st.stones -= item.price;\n    if (item.kind === 'gun') { st.unlocked.add(item.id); w.give(item.id, 100, true); }\n    else if (item.id === 'molotov') { st.unlocked.add('molotov'); w.bottles = Math.min(3, w.bottles + 1); }\n    else if (item.id === 'charge') w.charges = Math.min(2, w.charges + 1);\n    else if (item.id === 'cleaning') { st.flags['up-cleaning'] = true; w.hasCleaning = true; }\n    else if (item.id === 'pouch') { st.flags['up-pouch'] = true; g.body.maxSyrettes = 5; g.body.syrettes = Math.max(g.body.syrettes, 3); }\n    else if (item.id === 'belt') { st.flags['up-belt'] = true; w.hasBelt = true; }\n    else if (item.id === 'vkit') { st.flags['up-vkit'] = true; g.vehicles.hasKit = true; }\n    g.sfx.play('ui-stone');\n    g.events.emit('bought', item.id);\n    return true;\n  }\n  openRack() {\n    const g = this.game, ctx = g.ctx, list = this.rackList();\n    const pivot = new THREE.Group();\n    const cam = ctx.camera.camera;\n    cam.add(pivot);\n    pivot.position.set(0, 0.03, -0.62);\n    let shown = null;\n    const showGun = (item) => {\n      if (shown) { pivot.remove(shown); shown = null; }\n      if (item.kind !== 'gun') return;\n      const b = buildModel(rackDefs[item.id]);\n      setLookLayer(b.object, 'actors');\n      b.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n      b.object.rotation.y = Math.PI / 2;\n      b.object.position.x = 0.18;\n      pivot.add(b.object);\n      shown = b.object;\n    };\n    const line = g.dialogue.pick('tibor.idle');\n    const s = {\n      id: 'rack', title: \"TIBOR'S RACK\", index: 0, overlayWorld: true, list,\n      onOpen: () => { g.vm.setVisible(false); showGun(list[0]); if (line) { g.say('tibor', line, 3); g.voice.say('tibor', line); } },\n      onClose: () => { cam.remove(pivot); g.vm.setVisible(!g.player.seat); },\n      onSide: (d, sc) => { sc.index = (sc.index + d + list.length) % list.length; showGun(list[sc.index]); g.sfx.play('ui-move'); },\n      update: (c, dt, sc) => { pivot.rotation.y = Math.sin(this.menu.frame * 0.015) * 0.25; pivot.rotation.x = 0.25; },\n      items: (sc) => {\n        const it = list[sc.index];\n        const verb = it.kind === 'gun' && g.story.unlocked.has(it.id) ? 'TAKE A CLEAN ONE' : this.owned(it) ? 'YOU HAVE IT' : `BUY FOR ${it.price}`;\n        return [{ id: 'buy', label: verb, enabled: !(this.owned(it) && it.kind !== 'gun') && (this.owned(it) || g.story.stones >= it.price), focusable: true, onSelect: () => this.buy(it) }, { id: 'leave', label: 'LEAVE', onSelect: () => this.menu.pop() }];\n      },\n      hints: [['menuLeft', 'NEXT'], ['confirm', 'CHOOSE'], ['back', 'LEAVE']],\n      draw: (hud, m, sc) => {\n        const it = list[sc.index];\n        m.title(hud, { title: it.name });\n        hud.text(hud.width - SAFE_X - `${g.story.stones} STONES`.length * 6, SAFE_Y + 4, `${g.story.stones} STONES`, { color: 'sand' });\n        let y = hud.height - 112;\n        if (it.kind === 'gun') {\n          for (const [lab, v] of [['DAMAGE', it.def.damageBar], ['RANGE', it.def.rangeBar], ['RELIABILITY', it.def.reliabilityBar]]) {\n            hud.text(SAFE_X, y, lab, { color: 'white' });\n            for (let i = 0; i < 5; i++) hud.rect(SAFE_X + 78 + i * 16, y, 14, 7, i < v ? 'sand' : 'night');\n            y += 11;\n          }\n        } else { for (const l of wrap(it.about, hud.width - SAFE_X * 2)) { hud.text(SAFE_X, y, l, { color: 'white' }); y += 10; } y = hud.height - 79; }\n        const items = m.itemsOf(sc);\n        y = hud.height - 76;\n        items.forEach((row, i) => { y += m.itemRow(hud, row, i, y, sc.focus === i); });\n        m.regions.push({ x: 0, y: 30, w: hud.width / 3, h: 90, action: () => sc.onSide(-1, sc) });\n        m.regions.push({ x: (hud.width * 2) / 3, y: 30, w: hud.width / 3, h: 90, action: () => sc.onSide(1, sc) });\n        m.footer(hud, sc);\n      },\n    };\n    this.menu.push(s);\n  }\n  // ---- The notice board: contracts, one at a time ----\n  openBoard() {\n    const g = this.game;\n    const list = g.missions.available();\n    const items = list.slice(0, 5).map((m) => ({ id: m.id, label: m.title, small: true, enabled: !g.missions.active, onSelect: () => { this.menu.pop(); g.missions.offer(m, null); } }));\n    items.push({ id: 'leave', label: 'LEAVE', onSelect: () => this.menu.pop() });\n    this.menu.push({ id: 'board', title: 'NOTICE BOARD', subtitle: list.length ? 'WORK. THE PAPER IS OLDER THAN THE WAR.' : 'NOTHING TODAY. THE NAILS ARE STILL GOOD.', overlayWorld: true, items });\n  }\n  // ---- Rail halts ----\n  openHalts(from) {\n    const g = this.game;\n    const items = Object.entries(HALTS).filter(([k]) => k !== from).map(([k, h]) => ({ id: k, label: h.name, enabled: g.story.halts.has(k) && g.story.stones >= 1, focusable: true, onSelect: () => { this.menu.pop(); g.railTravel(k); } }));\n    items.push({ id: 'leave', label: 'LEAVE', onSelect: () => this.menu.pop() });\n    this.menu.push({ id: 'halts', title: HALTS[from].name, subtitle: 'ONE STONE. ONE HOUR. YOU WILL HEAR ABOUT IT.', overlayWorld: true, items });\n  }\n  // ---- Bakr on a black screen with clacking wheels ----\n  blackTalk(text, who, seconds, onEnd) {\n    const g = this.game;\n    let t = 0;\n    const s = { id: 'black', cover: true, noBack: true, hints: [], items: [], onConfirm: () => { t = seconds; },\n      update: (c, dt) => { t += dt; if (t >= seconds) { this.menu.pop(); onEnd(); } },\n      tapAnywhere: () => { t = seconds; },\n      draw: (hud) => { const lines = wrap(text, hud.width - 80); let y = (hud.height / 2 - lines.length * 5) | 0; if (who) hud.text(40, y - 12, who, { color: 'sand' }); for (const l of lines) { hud.text(40, y, l, { color: 'white' }); y += 10; } } };\n    this.menu.push(s);\n  }\n  // ---- The Ledger ----\n  openLedger(onClose) {\n    const g = this.game;\n    this.menu.push({\n      id: 'ledger', overlayWorld: true, onBack: () => { this.menu.pop(); onClose?.(); },\n      hints: [['back', 'CLOSE']], items: [],\n      onConfirm: () => { this.menu.pop(); onClose?.(); },\n      draw: (hud, m, sc) => {\n        hud.rect(30, 10, hud.width - 60, hud.height - 30, 'sand');\n        hud.rect(32, 12, hud.width - 64, hud.height - 34, 'mist');\n        hud.rect(34, 14, hud.width - 68, hud.height - 38, 'sand');\n        hud.text(44, 20, 'THE LEDGER', { scale: 2, color: 'plum', shadow: false });\n        let y = 42;\n        for (const l of g.ledger.lines()) {\n          hud.text(44, y, l.big, { scale: 2, color: 'ink', shadow: false });\n          hud.text(44, y + 16, l.small, { color: 'plum', shadow: false });\n          y += 34;\n        }\n        hud.text(hud.width - 44 - 6 * 5, hud.height - 40, 'E.H.', { color: 'plum', shadow: false });\n        m.footer(hud, sc);\n      },\n    });\n  }\n  // ---- Game over ----\n  openGameOver() {\n    const g = this.game;\n    this.menu.push({\n      id: 'gameover', cover: 'ink', noBack: true,\n      items: () => [{ id: 'continue', label: 'CONTINUE', enabled: g.save.exists() || !!g.save.lastWritten, onSelect: () => { this.menu.clear(); g.save.requestLoad(); } }, { id: 'title', label: 'TITLE', onSelect: () => { this.menu.clear(); g.toTitle(); } }],\n      draw: (hud, m, sc) => {\n        const t1 = 'YOU DIED IN THE SORREL.', t2 = 'THE PAPERWORK WILL TAKE LONGER.';\n        hud.text(((hud.width - t1.length * 12) / 2) | 0, 70, t1, { scale: 2, color: 'red' });\n        hud.text(((hud.width - t2.length * 6) / 2) | 0, 92, t2, { color: 'mist' });\n        let y = 136;\n        m.itemsOf(sc).forEach((it, i) => { y += m.itemRow(hud, it, i, y, sc.focus === i); });\n      },\n    });\n  }\n  // ---- Ending card, then Ledger, then credits, then title ----\n  openEnding(sheet) {\n    const g = this.game;\n    const text = sheet === 'column'\n      ? 'THEY CROSSED AT FIRST LIGHT, WALKING ON ASH. NOBODY HAS ASKED WHO LIT IT. THE FEVER IS NOT FINISHED WITH YOU, AND YOU ARE OUT OF TABLETS. IT IS A GOOD VIEW.'\n      : 'YOU REACHED THE BORDER WITH A CASE OF STONES AND A MAP NOBODY ELSE WILL EVER USE. THE GUARD ASKS YOUR TRADE. YOU TELL HIM: SURVEYOR.';\n    this.menu.clear();\n    this.menu.push({\n      id: 'ending', cover: 'ink', noBack: true, items: [], hints: [['confirm', 'GO ON']],\n      onConfirm: () => { this.menu.pop(); this.openLedger(() => this.openCredits(() => g.toTitle())); },\n      tapAnywhere: function () { this.onConfirm(); },\n      draw: (hud, m, sc) => {\n        const lines = wrap(text, hud.width - 100);\n        let y = (hud.height / 2 - lines.length * 6) | 0;\n        for (const l of lines) { hud.text(50, y, l, { color: 'white' }); y += 12; }\n        m.footer(hud, sc);\n      },\n    });\n    g.events.emit('ending-card', sheet);\n  }\n  openCredits(onDone) {\n    const g = this.game;\n    const pages = g.about.creditPages();\n    this.menu.push({ id: 'credits', cover: 'ink', title: 'CREDITS', pages, items: [], onBack: () => { this.menu.pop(); onDone?.(); }, hints: [['menuRight', 'PAGE'], ['back', 'DONE']], onConfirm: (s) => { if (s.page < s.pages.length - 1) this.menu.turnPage(s, 1); else { this.menu.pop(); onDone?.(); } } });\n  }\n  /** A black screen with one Harrow epigraph. */\n  epigraph(seconds, onEnd) {\n    const g = this.game;\n    const line = EPIGRAPHS[g.rng.look.int(0, EPIGRAPHS.length - 1)];\n    let t = 0;\n    this.menu.push({ id: 'epigraph', cover: 'ink', noBack: true, items: [], hints: [], text: line, onConfirm: () => { t = seconds; }, tapAnywhere: () => { t = seconds; },\n      update: (c, dt) => { t += Math.max(dt, 1 / 60); if (t >= seconds) { this.menu.pop(); onEnd?.(); } },\n      draw: (hud) => { const lines = wrap(line, hud.width - 100); let y = (hud.height / 2 - lines.length * 6) | 0; for (const l of lines) { hud.text(50, y, l, { color: 'mist' }); y += 12; } hud.text(50, y + 8, \"FROM HARROW'S FIELD NOTES\", { color: 'slate' }); } });\n  }\n  update(ctx, realDt) { this.menu.update(ctx, realDt); }\n  draw(hud) { this.menu.draw(hud); }\n}\nEOF\ncat > src/ui/shell.js <<'EOF'\n// Title, main menu, pause, settings: every screen by pad, keyboard and mouse. Touch-only devices get the notice and a Settings button.\nimport { Menu, SAFE_X, SAFE_Y } from './menu.js';\nimport { GAME_TITLE } from '../content/title.js';\nimport { DEFAULT_SETTINGS, storeSettings } from '../core/save.js';\nimport { drawGlyph, glyphWidth } from './glyphs.js';\nexport const NOTICE_TOUCH = 'Controller or keyboard required';\nexport function isTouchOnly() {\n  if (typeof matchMedia === 'undefined') return false;\n  try { return matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; } catch { return false; }\n}\nexport class Shell {\n  titleFrames = 0; idle = 0; pressed = false; gate = false;\n  constructor(game) { this.game = game; }\n  get ui() { return this.game.ui; }\n  get menu() { return this.game.ui.menu; }\n  enterTitle() {\n    const g = this.game;\n    this.pressed = false;\n    this.idle = 0;\n    this.menu.clear();\n    this.gate = isTouchOnly() && !this.padConnected() && !g.options.forceNoGate;\n    if (this.gate) this.pushGate();\n    else this.menu.push(this.titleScreen());\n  }\n  padConnected() { const n = typeof navigator !== 'undefined' ? navigator : null; try { const pads = n?.getGamepads?.() ?? []; for (const p of pads) if (p && p.connected) return true; } catch { /* no pads */ } return false; }\n  titleScreen() {\n    const g = this.game;\n    return {\n      id: 'title', noBack: true, items: [], attractIdle: true, hints: [],\n      onConfirm: () => { this.pressed = true; this.menu.pop(); this.menu.push(this.mainMenu()); },\n      tapAnywhere: () => { this.pressed = true; this.menu.pop(); this.menu.push(this.mainMenu()); },\n      update: (c, dt, s) => { for (const code of ['Space', 'KeyE', 'PadSquare', 'PadTriangle', 'PadOptions', 'Escape']) if (c.input.wasPressed(code)) { s.onConfirm(); return; } },\n      draw: (hud, m, s) => {\n        this.logo(hud);\n        const name = g.actions.glyph('confirm', g.settings.glyphs === 'xb');\n        const blink = (m.frame >> 5) & 1;\n        const w = 6 * 6 + 4 + glyphWidth(name);\n        const x = ((hud.width - w) / 2) | 0, y = hud.height - 40;\n        if (blink) { hud.text(x, y + 2, 'PRESS ', { color: 'white' }); drawGlyph(hud, x + 36, y, name); }\n      },\n    };\n  }\n  logo(hud) {\n    let scale = 4;\n    if (GAME_TITLE.length * 6 * scale > hud.width - 40) scale = 3;\n    const w = GAME_TITLE.length * 6 * scale;\n    hud.text(((hud.width - w) / 2) | 0, 42, GAME_TITLE, { scale, color: 'sand', shadow: 'plum' });\n    const sub = 'A MAP IS A PROMISE';\n    hud.text(((hud.width - sub.length * 6) / 2) | 0, 42 + 8 * scale + 4, sub, { color: 'mist' });\n  }\n  mainMenu() {\n    const g = this.game;\n    return {\n      id: 'main', noBack: true, attractIdle: true,\n      items: () => {\n        const list = [];\n        if (g.save.exists()) list.push({ id: 'continue', label: 'CONTINUE', onSelect: () => g.startContinue() });\n        list.push({ id: 'new', label: 'NEW GAME', onSelect: () => g.startNew() });\n        list.push({ id: 'cash', label: 'CASH RUN', onSelect: () => this.openCashRun() });\n        list.push({ id: 'settings', label: 'SETTINGS', onSelect: () => this.openSettings() });\n        list.push({ id: 'about', label: 'ABOUT AND CREDITS', onSelect: () => this.openAbout() });\n        return list;\n      },\n      hints: [['confirm', 'SELECT']],\n      draw: (hud, m, s) => {\n        this.logo(hud);\n        let y = 100;\n        m.itemsOf(s).forEach((it, i) => { y += m.itemRow(hud, it, i, y, s.focus === i); });\n        m.footer(hud, s);\n      },\n    };\n  }\n  pushGate() {\n    const g = this.game;\n    this.menu.push({\n      id: 'gate', noBack: true, attractIdle: true,\n      items: [{ id: 'settings', label: 'SETTINGS', onSelect: () => this.openSettings() }],\n      hints: [],\n      draw: (hud, m, s) => {\n        this.logo(hud);\n        const t = NOTICE_TOUCH.toUpperCase();\n        hud.text(((hud.width - t.length * 6) / 2) | 0, 112, t, { color: 'orange' });\n        const w = 200, x = ((hud.width - w) / 2) | 0, y = 136;\n        hud.rect(x, y, w, 28, 'orange');\n        hud.text(((hud.width - 8 * 12) / 2) | 0, y + 7, 'SETTINGS', { scale: 2, color: 'ink', shadow: false });\n        m.regions.push({ x, y, w, h: 28, index: 0 });\n      },\n    });\n  }\n  /** A key press or pad connecting clears the gate and shows the normal title. */\n  stepGate() {\n    if (!this.gate) return;\n    const g = this.game, inp = g.ctx.input;\n    const st = inp.state();\n    const key = st.held.some((c) => c !== 'Touch' && !c.startsWith('Mouse')) || st.queued.some(([c]) => c !== 'Touch' && !c.startsWith('Mouse'));\n    if (key || this.padConnected()) {\n      this.gate = false;\n      if (this.menu.top?.id === 'gate') { this.menu.pop(); this.menu.push(this.titleScreen()); }\n    }\n  }\n  openPause() {\n    const g = this.game;\n    const hub = g.options.session?.kind === 'hub';\n    const items = () => hub ? [\n      { id: 'resume', label: 'RESUME', onSelect: () => g.resume() },\n      { id: 'settings', label: 'SETTINGS', onSelect: () => this.openSettings() },\n    ] : [\n      { id: 'resume', label: 'RESUME', onSelect: () => g.resume() },\n      { id: 'ledger', label: 'LEDGER', onSelect: () => this.ui.openLedger() },\n      { id: 'settings', label: 'SETTINGS', onSelect: () => this.openSettings() },\n      { id: 'dev', label: 'DEV MODE', onSelect: () => g.dev.open() },\n      { id: 'about', label: 'ABOUT AND CREDITS', onSelect: () => this.openAbout() },\n      { id: 'quit', label: 'QUIT TO TITLE', onSelect: () => g.toTitle() },\n    ];\n    this.menu.push({ id: 'pause', title: 'PAUSED', dim: 0.5, items, onBack: () => g.resume(), pausesWorld: true, hints: [['confirm', 'SELECT'], ['back', 'RESUME']] });\n  }\n  openCashRun() {\n    const g = this.game;\n    this.menu.push({\n      id: 'cash', title: 'CASH RUN', subtitle: 'SIX CASES IN A BURNING VALLEY. MOST STONES WINS. FRIENDLY FIRE IS ON.', dim: 0.5, blurb: 'FRIENDS ONLINE PLAY THROUGH AI HUB.',\n      items: [\n        { id: 'solo', label: 'SOLO WITH HIRED GUNS', onSelect: () => g.startRound('solo') },\n        { id: 'host', label: 'HOST ON THIS COMPUTER', onSelect: () => g.startRound('host') },\n        { id: 'join', label: 'JOIN ON THIS COMPUTER', onSelect: () => g.startRound('join') },\n      ],\n    });\n  }\n  openAbout() {\n    const g = this.game;\n    this.menu.push({ id: 'about', cover: 'ink', title: 'ABOUT AND CREDITS', pages: g.about.pages(), items: [], attractExempt: true, hints: [['menuRight', 'PAGE'], ['back', 'BACK']] });\n  }\n  // ---- Settings: Sound, Controls, Picture, Comfort ----\n  setting(key) { return { get: () => this.game.settings[key], set: (v) => { this.game.settings[key] = v; this.game.applySettings(); } }; }\n  openSettings() {\n    const g = this.game, S = (key, min, max, step, format) => ({ ...this.setting(key), min, max, step, format });\n    const pct = (v) => `${Math.round(v * 100)}%`;\n    const onOff = (key) => ({ options: [true, false], ...this.setting(key), format: (v) => (v ? 'ON' : 'OFF') });\n    const tabs = ['SOUND', 'CONTROLS', 'PICTURE', 'COMFORT'];\n    const pages = [\n      () => [\n        { id: 'music', label: 'MUSIC', slider: S('music', 0, 1, 0.05, pct) }, { id: 'sfx', label: 'EFFECTS', slider: S('sfx', 0, 1, 0.05, pct) }, { id: 'voices', label: 'VOICES', slider: S('voices', 0, 1, 0.05, pct) },\n        { id: 'reset', label: 'RESET TO DEFAULTS', onSelect: () => this.resetSettings() },\n      ],\n      () => [\n        { id: 'sensPad', label: 'LOOK, PAD', slider: S('sensPad', 0.25, 3, 0.05, (v) => v.toFixed(2)), small: true }, { id: 'sensMouse', label: 'LOOK, MOUSE', slider: S('sensMouse', 0.25, 3, 0.05, (v) => v.toFixed(2)), small: true },\n        { id: 'invertY', label: 'INVERT Y', choices: onOff('invertY'), small: true }, { id: 'aimAssist', label: 'AIM ASSIST', choices: onOff('aimAssist'), small: true }, { id: 'rumble', label: 'RUMBLE', choices: onOff('rumble'), small: true },\n        { id: 'glyphs', label: 'GLYPHS', choices: { options: ['ps', 'xb'], ...this.setting('glyphs'), format: (v) => (v === 'ps' ? 'PLAYSTATION' : 'XBOX') }, small: true },\n        { id: 'reset', label: 'RESET TO DEFAULTS', small: true, onSelect: () => this.resetSettings() },\n      ],\n      () => [\n        { id: 'fullscreen', label: 'FULLSCREEN', onSelect: () => g.toggleFullscreen() },\n        { id: 'pixelSize', label: 'PIXEL SIZE', choices: { options: ['fine', 'chunky'], ...this.setting('pixelSize'), format: (v) => v.toUpperCase() } },\n        { id: 'quality', label: 'QUALITY', choices: { options: ['auto', 'low', 'medium', 'high'], ...this.setting('quality'), format: (v) => v.toUpperCase() } },\n        { id: 'fov', label: 'FIELD OF VIEW', slider: S('fov', 50, 90, 1, (v) => String(Math.round(v))) },\n        { id: 'reset', label: 'RESET TO DEFAULTS', onSelect: () => this.resetSettings() },\n      ],\n      () => [\n        { id: 'subtitleSize', label: 'SUBTITLE SIZE', choices: { options: [1, 2], ...this.setting('subtitleSize'), format: (v) => (v === 1 ? 'SMALL' : 'LARGE') } },\n        { id: 'reduceFlashes', label: 'REDUCE FLASHES', choices: onOff('reduceFlashes') }, { id: 'feverReduced', label: 'FEVER EFFECTS LESS', choices: onOff('feverReduced') },\n        { id: 'reset', label: 'RESET TO DEFAULTS', onSelect: () => this.resetSettings() },\n      ],\n    ];\n    this.menu.push({ id: 'settings', title: 'SETTINGS', cover: g.mode === 'title' ? false : false, dim: 0.5, tabs, attractExempt: true, items: (s) => pages[s.tab](), hints: [['confirm', 'CHANGE'], ['back', 'BACK']], onBack: () => { storeSettings(g.settings); this.menu.pop(); } });\n  }\n  resetSettings() {\n    const g = this.game;\n    Object.assign(g.settings, DEFAULT_SETTINGS);\n    g.applySettings();\n    storeSettings(g.settings);\n    g.notice('DEFAULTS. EVEN THE MUSIC.', 2);\n  }\n}\nEOF\necho ok","description":"Write HUD, in-world screens and title, pause, settings shell"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14102,"cache_read_input_tokens":511619,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14102},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"664a3176-1f84-4336-8ff2-5ac526beb8e0","timestamp":"2026-11-06T00:10:47.423Z","request_id":"req_011CgkhfEDDgjAkY9czGMRDt","wire_tool_inputs":{"toolu_01LGtDRHkjoFGB6w8cF4Dx8Q":{"command":"set -e\ncat > src/ui/hud.js <<'EOF'\n// The in-play HUD: minimal, hides 6 s after it last changed. Prompts follow the device used last.\nimport { THREE } from '../../pixel-engine.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { NAMES, SPEAKER_COLOR } from '../content/dialogue.js';\nimport { ACT } from '../core/actions.js';\nimport { drawGlyph, glyphWidth } from './glyphs.js';\nimport { wrap } from './pixfont.js';\nimport { clamp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst _v = new Vector3();\nconst GUN_ICON = ['.....oooooo.', 'oooooooooooo', 'oooooo.o....', '..oo.o......', '..oo........'];\nconst SYRETTE = ['..o..', '..o..', '.ooo.', '.oxo.', '.oxo.', '.ooo.', '..o..'];\nconst TABLET = ['.ooo.', 'ooooo', 'ox.xo', 'ooooo', '.ooo.'];\nexport const SAFE_X = 24, SAFE_Y = 14;\nexport class GameHud {\n  touched = -99; bannerT = 0; banner = ''; noticeT = 0; noticeText = ''; prompts = []; muzzle = 0; jamT = 0;\n  constructor(game) { this.game = game; }\n  touch() { this.touched = this.game.realT; }\n  addPrompt(act, text, extra) { const g = this.game; this.prompts.push({ act, text, glyph: g.actions.glyph(act, g.settings.glyphs === 'xb'), ...extra }); }\n  draw(ctx, dt) {\n    const g = this.game, h = ctx.hud;\n    this.bannerT = Math.max(0, this.bannerT - dt);\n    this.noticeT = Math.max(0, this.noticeT - dt);\n    this.jamT = Math.max(0, this.jamT - dt);\n    g.subtitle.t = Math.max(0, g.subtitle.t - dt);\n    if (g.hudHidden) return;\n    this.world(ctx);\n    if (g.scene.active && g.scene.bars > 0.05) this.bars(h, g.scene.bars);\n    const scoped = g.weapons.aiming && g.weapons.def.scoped && g.weapons.aimT > 0.6;\n    if (scoped || g.monoT > 0.5) this.scopeMask(h);\n    if (g.body.burnScreen > 0.01) this.burnEdges(h, g.body.burnScreen);\n    if (g.body.hurtFlash > 0.4 && !g.settings.reduceFlashes) this.hurtEdges(h);\n    if (g.body.dirFlash > 0) this.damageDir(h);\n    const show = g.realT - this.touched < 6 || g.body.hp < 100 || g.weapons.reloading > 0 || g.weapons.gun?.jam > 0;\n    if (g.hasPlayer && !g.scene.active) {\n      if (show) { this.vitals(h); this.ammo(h); }\n      this.reticle(h, ctx);\n    }\n    this.banners(h);\n    this.subtitles(h);\n    this.promptRow(h);\n    this.holdRing(h, ctx);\n  }\n  vitals(h) {\n    const g = this.game, b = g.body;\n    const x = SAFE_X, y = h.height - SAFE_Y - 11;\n    for (let i = 0; i < 5; i++) {\n      const v = clamp((b.hp - i * 20) / 20, 0, 1);\n      h.rect(x + i * 15, y, 13, 6, 'ink');\n      h.rect(x + i * 15 + 1, y + 1, 11, 4, 'night');\n      if (v > 0) h.rect(x + i * 15 + 1, y + 1, Math.round(11 * v), 4, b.hp < 20 ? 'red' : b.burning ? 'orange' : 'sand');\n    }\n    h.sprite(x, y - 10, SYRETTE, { o: 'white', x: 'red' });\n    h.text(x + 8, y - 9, String(b.syrettes), { color: 'white' });\n    h.sprite(x + 22, y - 9, TABLET, { o: 'white', x: 'ink' });\n    h.text(x + 30, y - 9, String(b.tablets), { color: b.feverOn ? 'orange' : 'white' });\n    if (g.story?.stones != null && g.mode !== 'round' && g.realT - this.touched < 6) { h.text(x + 46, y - 9, `${g.story.stones} STONES`, { color: 'sand' }); }\n  }\n  ammo(h) {\n    const g = this.game, w = g.weapons;\n    if (g.round?.carrying) { /* a case in your hands shows on the Cash Run bar */ }\n    if (w.mounted) {\n      const x = h.width - SAFE_X - 60, y = h.height - SAFE_Y - 8;\n      h.rect(x, y, 60, 6, 'ink'); h.rect(x + 1, y + 1, Math.round(58 * w.heat), 4, w.overheated ? 'red' : 'orange');\n      h.text(x, y - 10, 'MOUNTED MG', { color: 'white' });\n      return;\n    }\n    const gun = w.gun, def = w.def;\n    if (!gun) return;\n    const color = w.condColor();\n    const right = h.width - SAFE_X;\n    if (def.cls === 'melee') { h.text(right - def.name.length * 6, h.height - SAFE_Y - 8, def.name, { color: 'mist' }); }\n    else {\n      const mag = String(Math.ceil(gun.mag)), res = String(gun.reserve);\n      const tw = (mag.length + 1 + res.length) * 6;\n      h.text(right - tw - 0, h.height - SAFE_Y - 14, mag, { scale: 1, color: gun.mag === 0 ? 'red' : 'white' });\n      h.text(right - res.length * 6, h.height - SAFE_Y - 14, res, { color: 'mist' });\n      h.text(right - tw + mag.length * 6, h.height - SAFE_Y - 14, '/', { color: 'slate' });\n      h.sprite(right - tw - 18, h.height - SAFE_Y - 14, GUN_ICON, { o: color });\n      h.text(right - def.name.length * 6, h.height - SAFE_Y - 6, def.name, { color: 'mist' });\n    }\n    const y = h.height - SAFE_Y - 26;\n    if (w.bottles || w.charges || w.placed.length) {\n      const t = `BOTTLES ${w.bottles}  CHARGES ${w.charges}${w.placed.length ? ` SET ${w.placed.length}` : ''}`;\n      h.text(right - t.length * 6, y, t, { color: 'mist' });\n    }\n    if (g.actions.bot?.only !== true && (gun.jam > 0 || this.jamT > 0)) { /* prompt added in promptRow */ }\n  }\n  reticle(h, ctx) {\n    const g = this.game, w = g.weapons;\n    if (g.mapUp || g.inMonocular()) return;\n    if (w.def.scoped && w.aimT > 0.5) return;\n    const cx = (h.width / 2) | 0, cy = (h.height / 2) | 0;\n    const col = g.interact.current ? 'lime' : 'white';\n    h.rect(cx, cy, 1, 1, col);\n    if (g.fx.markerT > 0) {\n      const c = g.fx.markerHead ? 'red' : 'white', r = 4;\n      for (let i = 2; i <= r; i++) { h.rect(cx - i, cy - i, 1, 1, c); h.rect(cx + i, cy - i, 1, 1, c); h.rect(cx - i, cy + i, 1, 1, c); h.rect(cx + i, cy + i, 1, 1, c); }\n    }\n  }\n  bars(h, k) {\n    const hh = Math.round(20 * k);\n    h.rect(0, 0, h.width, hh, 'ink'); h.rect(0, h.height - hh, h.width, hh, 'ink');\n  }\n  scopeMask(h) {\n    const cx = h.width / 2, cy = h.height / 2, r = Math.floor(h.height * 0.42);\n    for (let y = 0; y < h.height; y++) {\n      const dy = y - cy, half = Math.abs(dy) >= r ? 0 : Math.sqrt(r * r - dy * dy) | 0;\n      if (!half) { h.rect(0, y, h.width, 1, 'ink'); continue; }\n      h.rect(0, y, Math.max(0, cx - half), 1, 'ink'); h.rect(cx + half, y, Math.max(0, h.width - cx - half), 1, 'ink');\n    }\n    h.rect(cx - r, cy, r * 2, 1, 'ink'); h.rect(cx, cy - r, 1, r * 2, 'ink');\n  }\n  burnEdges(h, k) {\n    const r = this.game.rng.fx, w = h.width, H = h.height;\n    for (let x = 0; x < w; x += 7) {\n      const up = 6 + (r.next() * 26 * k) | 0;\n      h.rect(x, H - up, 7, up, r.next() > 0.5 ? 'orange' : 'red');\n      h.rect(x + 1, H - (up >> 1), 5, up >> 1, 'sand');\n      if (x % 3 === 0) { const d = (r.next() * 12 * k) | 0; h.rect(x, 0, 7, d, 'red'); }\n    }\n  }\n  hurtEdges(h) {\n    const w = h.width, H = h.height, t = 4;\n    h.rect(0, 0, w, t, 'red'); h.rect(0, H - t, w, t, 'red'); h.rect(0, 0, t, H, 'red'); h.rect(w - t, 0, t, H, 'red');\n  }\n  damageDir(h) {\n    const g = this.game;\n    const a = g.body.lastDir - g.player.yaw + Math.PI;\n    const cx = h.width / 2, cy = h.height / 2, r = 46;\n    const x = cx + Math.sin(a) * r, y = cy - Math.cos(a) * r;\n    for (let i = 0; i < 5; i++) h.rect(x - 2 + Math.cos(a) * (i - 2) * 2, y - 1 + Math.sin(a) * (i - 2) * 2, 2, 2, 'red');\n  }\n  banners(h) {\n    const g = this.game;\n    if (this.bannerT > 0) { const t = this.banner; const lines = wrap(t, h.width - 80); let y = SAFE_Y; for (const l of lines) { h.text(((h.width - l.length * 6) / 2) | 0, y, l, { color: 'sand', shadow: 'ink' }); y += 10; } }\n    if (this.noticeT > 0) { const lines = wrap(this.noticeText, h.width - 80); let y = SAFE_Y + 24; for (const l of lines) { h.text(((h.width - l.length * 6) / 2) | 0, y, l, { color: 'white', shadow: 'ink' }); y += 10; } }\n    const m = g.missions?.active;\n    if (m?.timer) { const t = Math.max(0, Math.ceil(g.missions.timer)); const s = `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`; h.text(h.width - SAFE_X - s.length * 6 * 2, SAFE_Y, s, { scale: 2, color: t < 60 ? 'red' : 'white' }); }\n    if (g.holdT > 0) { const t = Math.ceil(g.holdT); const s = `${t}`; h.text(h.width - SAFE_X - s.length * 6 * 2, SAFE_Y, s, { scale: 2, color: 'sand' }); }\n    if (g.mode === 'attract') { h.rect(SAFE_X - 3, SAFE_Y - 2, 34, 11, 'red'); h.text(SAFE_X, SAFE_Y, 'DEMO', { color: 'white', shadow: false }); }\n  }\n  subtitles(h) {\n    const g = this.game, s = g.subtitle;\n    if (s.t <= 0 || !s.text) return;\n    const scale = g.settings.subtitleSize;\n    const lines = wrap(s.text, Math.min(h.width - 60, 60 * 6 * scale), scale).slice(0, 2);\n    const y0 = h.height - SAFE_Y - 40 - lines.length * 9 * scale - (g.scene.active ? 8 : 0);\n    const name = NAMES[s.who] ?? '';\n    const lh = 9 * scale;\n    let maxw = 0; for (const l of lines) maxw = Math.max(maxw, l.length * 6 * scale);\n    const bx = ((h.width - maxw) / 2) | 0;\n    if (name) h.text(bx, y0 - 10, name, { color: SPEAKER_COLOR[s.who] ?? 'white', shadow: 'ink' });\n    lines.forEach((l, i) => h.text(((h.width - l.length * 6 * scale) / 2) | 0, y0 + i * lh, l, { color: 'white', scale, shadow: 'ink' }));\n  }\n  promptRow(h) {\n    const list = this.prompts;\n    if (!list.length) return;\n    let total = 0;\n    for (const p of list) total += glyphWidth(p.glyph) + 3 + p.text.length * 6 + 10;\n    let x = ((h.width - total + 10) / 2) | 0;\n    const y = h.height - SAFE_Y - 24;\n    for (const p of list) {\n      const w = drawGlyph(h, x, y, p.glyph);\n      h.text(x + w + 3, y + 2, p.text, { color: p.dim ? 'slate' : 'white', shadow: 'ink' });\n      x += w + 3 + p.text.length * 6 + 10;\n    }\n  }\n  holdRing(h, ctx) {\n    const f = this.game.interact.holdFrac();\n    if (f <= 0) return;\n    const cx = h.width / 2, cy = h.height / 2, n = 28, r = 12;\n    for (let i = 0; i < n; i++) {\n      const a = (i / n) * Math.PI * 2 - Math.PI / 2;\n      h.rect(cx + Math.cos(a) * r, cy + Math.sin(a) * r, 2, 2, i / n <= f ? 'sand' : 'night');\n    }\n  }\n  /** Things in the world drawn by projection: ? and ! over soldiers, a pixel cross over a downed friend. */\n  world(ctx) {\n    const g = this.game, h = ctx.hud, cam = ctx.camera.camera;\n    if (g.scene.active) return;\n    const project = (x, y, z) => {\n      _v.set(x, y, z).project(cam);\n      if (_v.z > 1 || _v.z < -1) return null;\n      return [((_v.x + 1) / 2) * h.width, ((1 - _v.y) / 2) * h.height];\n    };\n    for (const s of g.actors.soldiers) {\n      if (!s.active || s.dead || g.mode === 'attract') continue;\n      const d = Math.hypot(s.x - g.camPos.x, s.z - g.camPos.z);\n      if (d > 40) continue;\n      if (s.state === 'idle' && s.suspicion < 0.3) continue;\n      const p = project(s.x, s.y + 2.05, s.z);\n      if (!p) continue;\n      h.text(p[0] - 3, p[1] - 4, s.state === 'alert' ? '!' : '?', { color: s.state === 'alert' ? 'red' : 'sand', shadow: 'ink' });\n    }\n    for (const b of g.actors.buddies) {\n      if (!b.active || !b.isDown) continue;\n      const p = project(b.x, b.y + 1.4, b.z);\n      if (!p) continue;\n      h.rect(p[0] - 1, p[1] - 4, 3, 9, 'red'); h.rect(p[0] - 4, p[1] - 1, 9, 3, 'red');\n    }\n    if (g.dev.aiText) {\n      for (const s of g.actors.soldiers) {\n        if (!s.active || s.dead) continue;\n        const p = project(s.x, s.y + 2.3, s.z);\n        if (p && Math.hypot(s.x - g.camPos.x, s.z - g.camPos.z) < 120) h.text(p[0] - 12, p[1] - 12, `${s.state} ${Math.round(s.hp)}`, { color: 'cyan' });\n      }\n    }\n    g.round?.drawWorldHud?.(ctx, project);\n  }\n}\nEOF\ncat > src/ui/ui.js <<'EOF'\n// Screens: choices, Tibor's rack, locker, bed, notice board, halts, wall, ledger, game over, ending card, credits. Title and pause live in shell.js.\nimport { THREE, buildModel, setLookLayer } from '../../pixel-engine.js';\nimport { WEAPONS, THROWN, UPGRADES, SLOT_ORDER } from '../content/weapons.js';\nimport { Menu, SAFE_X, SAFE_Y } from './menu.js';\nimport { rackDefs } from '../art/viewmodels.js';\nimport { SITES, HALTS } from '../content/sites.js';\nimport { MISSIONS } from '../content/missions.js';\nimport { LINES } from '../content/dialogue.js';\nimport { EPIGRAPHS } from '../content/notes.js';\nimport { drawGlyph, glyphWidth } from './glyphs.js';\nimport { wrap } from './pixfont.js';\nimport { clamp } from '../core/rng.js';\nconst TIMES = { DAWN: 5.5, NOON: 12, DUSK: 18, MIDNIGHT: 0 };\nexport class UI {\n  constructor(game) { this.game = game; this.menu = new Menu(game); }\n  get open() { return this.menu.open; }\n  // ---- two big buttons at most ----\n  choice(title, options, { noBack = true } = {}) {\n    const g = this.game;\n    const s = {\n      id: 'choice', title, overlayWorld: true, noBack,\n      items: options.map((o) => ({ id: o.id ?? o.label, label: o.label, onSelect: () => { this.menu.pop(); o.onSelect?.(); } })),\n      draw: (hud, m, sc) => {\n        const y0 = hud.height - 96;\n        hud.rect(0, y0 - 16, hud.width, 90, 'ink');\n        hud.text(((hud.width - title.length * 12) / 2) | 0, y0 - 12, title, { scale: 2, color: 'sand', shadow: false });\n        let y = y0 + 8;\n        sc.items.forEach((it, i) => {\n          const focused = sc.focus === i;\n          hud.rect(60, y, hud.width - 120, 20, focused ? 'orange' : 'night');\n          hud.text(((hud.width - it.label.length * 12) / 2) | 0, y + 3, it.label, { scale: 2, color: focused ? 'ink' : 'white', shadow: false });\n          m.regions.push({ x: 60, y, w: hud.width - 120, h: 20, index: i });\n          y += 24;\n        });\n      },\n    };\n    this.menu.push(s);\n    return s;\n  }\n  // ---- Bed ----\n  openBed(key) {\n    const g = this.game, opts = Object.entries(TIMES);\n    this.menu.push({\n      id: 'bed', title: 'SLEEP UNTIL', subtitle: 'IT SAVES. THE FEVER DOES NOT SLEEP.', overlayWorld: true,\n      items: [...opts.map(([label, h]) => ({ id: label.toLowerCase(), label, onSelect: () => { this.menu.pop(); g.sleepTo(h, key); } })), { id: 'leave', label: 'LEAVE', onSelect: () => this.menu.pop() }],\n    });\n  }\n  // ---- Locker: one row per slot, left/right picks ----\n  openLocker() {\n    const g = this.game, w = g.weapons;\n    const row = (slot) => {\n      const options = Object.values(WEAPONS).filter((d) => d.slot === slot && g.story.unlocked.has(d.id)).map((d) => d.id);\n      return {\n        id: slot, label: slot.toUpperCase(),\n        choices: { options: options.length ? options : ['none'], get: () => w.slots[slot]?.id ?? (options[0] ?? 'none'), set: (id) => { if (id !== 'none') { w.give(id, 100, slot === w.current); } }, format: (id) => (id === 'none' ? 'NOTHING' : WEAPONS[id].name) },\n      };\n    };\n    this.menu.push({\n      id: 'locker', title: 'LOCKER', subtitle: 'WHAT YOU HAVE BOUGHT COMES CLEAN. HE KEEPS IT THAT WAY.', overlayWorld: true,\n      items: () => [row('sidearm'), row('main'), row('special'), ...(g.story.stockInLockers ? [{ id: 'stock', label: \"TIBOR'S STOCK\", onSelect: () => this.openRack() }] : []), { id: 'done', label: 'CLOSE', onSelect: () => this.menu.pop() }],\n      hints: [['menuLeft', 'CHOOSE'], ['back', 'CLOSE']],\n    });\n  }\n  openWall() {\n    const g = this.game;\n    const dead = g.actors.buddies.filter((b) => b.dead);\n    g.dialogue.play(dead.length ? [['', `SCRATCHED INTO THE PLANK: ${dead.map((b) => b.name).join(', ')}.`], ['', 'A GUN LEANS UNDER IT. NOBODY HAS TOUCHED IT.']] : 'wall.empty');\n  }\n  // ---- Tibor's rack: one gun at a time, large, three bars ----\n  rackList() {\n    const out = [];\n    for (const d of Object.values(WEAPONS)) if (d.price > 0) out.push({ kind: 'gun', id: d.id, name: d.name, price: d.price, def: d });\n    out.push({ kind: 'throw', id: 'molotov', name: 'BOTTLE', price: THROWN.molotov.price, about: 'A RAG AND SOMETHING THAT BURNS. CARRY THREE.' });\n    out.push({ kind: 'throw', id: 'charge', name: 'REMOTE CHARGE', price: THROWN.charge.price, about: 'HOLD THROW TO PLANT. THROW AGAIN TO REGRET IT.' });\n    for (const u of Object.values(UPGRADES)) out.push({ kind: 'up', id: u.id, name: u.name, price: u.price, about: u.about });\n    return out;\n  }\n  owned(item) {\n    const g = this.game;\n    if (item.kind === 'gun') return g.story.unlocked.has(item.id);\n    if (item.kind === 'up') return !!g.story.flags[`up-${item.id}`];\n    return false;\n  }\n  buy(item) {\n    const g = this.game, st = g.story, w = g.weapons;\n    if (item.kind === 'gun' && st.unlocked.has(item.id)) { w.give(item.id, 100, true); g.events.emit('rack-take', item.id); return true; }\n    if (this.owned(item)) return false;\n    if (st.stones < item.price) { g.sfx.play('ui-back'); g.notice('HE SHAKES HIS HEAD. NOT ENOUGH STONES.', 2); return false; }\n    st.stones -= item.price;\n    if (item.kind === 'gun') { st.unlocked.add(item.id); w.give(item.id, 100, true); }\n    else if (item.id === 'molotov') { st.unlocked.add('molotov'); w.bottles = Math.min(3, w.bottles + 1); }\n    else if (item.id === 'charge') w.charges = Math.min(2, w.charges + 1);\n    else if (item.id === 'cleaning') { st.flags['up-cleaning'] = true; w.hasCleaning = true; }\n    else if (item.id === 'pouch') { st.flags['up-pouch'] = true; g.body.maxSyrettes = 5; g.body.syrettes = Math.max(g.body.syrettes, 3); }\n    else if (item.id === 'belt') { st.flags['up-belt'] = true; w.hasBelt = true; }\n    else if (item.id === 'vkit') { st.flags['up-vkit'] = true; g.vehicles.hasKit = true; }\n    g.sfx.play('ui-stone');\n    g.events.emit('bought', item.id);\n    return true;\n  }\n  openRack() {\n    const g = this.game, ctx = g.ctx, list = this.rackList();\n    const pivot = new THREE.Group();\n    const cam = ctx.camera.camera;\n    cam.add(pivot);\n    pivot.position.set(0, 0.03, -0.62);\n    let shown = null;\n    const showGun = (item) => {\n      if (shown) { pivot.remove(shown); shown = null; }\n      if (item.kind !== 'gun') return;\n      const b = buildModel(rackDefs[item.id]);\n      setLookLayer(b.object, 'actors');\n      b.object.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.frustumCulled = false; } });\n      b.object.rotation.y = Math.PI / 2;\n      b.object.position.x = 0.18;\n      pivot.add(b.object);\n      shown = b.object;\n    };\n    const line = g.dialogue.pick('tibor.idle');\n    const s = {\n      id: 'rack', title: \"TIBOR'S RACK\", index: 0, overlayWorld: true, list,\n      onOpen: () => { g.vm.setVisible(false); showGun(list[0]); if (line) { g.say('tibor', line, 3); g.voice.say('tibor', line); } },\n      onClose: () => { cam.remove(pivot); g.vm.setVisible(!g.player.seat); },\n      onSide: (d, sc) => { sc.index = (sc.index + d + list.length) % list.length; showGun(list[sc.index]); g.sfx.play('ui-move'); },\n      update: (c, dt, sc) => { pivot.rotation.y = Math.sin(this.menu.frame * 0.015) * 0.25; pivot.rotation.x = 0.25; },\n      items: (sc) => {\n        const it = list[sc.index];\n        const verb = it.kind === 'gun' && g.story.unlocked.has(it.id) ? 'TAKE A CLEAN ONE' : this.owned(it) ? 'YOU HAVE IT' : `BUY FOR ${it.price}`;\n        return [{ id: 'buy', label: verb, enabled: !(this.owned(it) && it.kind !== 'gun') && (this.owned(it) || g.story.stones >= it.price), focusable: true, onSelect: () => this.buy(it) }, { id: 'leave', label: 'LEAVE', onSelect: () => this.menu.pop() }];\n      },\n      hints: [['menuLeft', 'NEXT'], ['confirm', 'CHOOSE'], ['back', 'LEAVE']],\n      draw: (hud, m, sc) => {\n        const it = list[sc.index];\n        m.title(hud, { title: it.name });\n        hud.text(hud.width - SAFE_X - `${g.story.stones} STONES`.length * 6, SAFE_Y + 4, `${g.story.stones} STONES`, { color: 'sand' });\n        let y = hud.height - 112;\n        if (it.kind === 'gun') {\n          for (const [lab, v] of [['DAMAGE', it.def.damageBar], ['RANGE', it.def.rangeBar], ['RELIABILITY', it.def.reliabilityBar]]) {\n            hud.text(SAFE_X, y, lab, { color: 'white' });\n            for (let i = 0; i < 5; i++) hud.rect(SAFE_X + 78 + i * 16, y, 14, 7, i < v ? 'sand' : 'night');\n            y += 11;\n          }\n        } else { for (const l of wrap(it.about, hud.width - SAFE_X * 2)) { hud.text(SAFE_X, y, l, { color: 'white' }); y += 10; } y = hud.height - 79; }\n        const items = m.itemsOf(sc);\n        y = hud.height - 76;\n        items.forEach((row, i) => { y += m.itemRow(hud, row, i, y, sc.focus === i); });\n        m.regions.push({ x: 0, y: 30, w: hud.width / 3, h: 90, action: () => sc.onSide(-1, sc) });\n        m.regions.push({ x: (hud.width * 2) / 3, y: 30, w: hud.width / 3, h: 90, action: () => sc.onSide(1, sc) });\n        m.footer(hud, sc);\n      },\n    };\n    this.menu.push(s);\n  }\n  // ---- The notice board: contracts, one at a time ----\n  openBoard() {\n    const g = this.game;\n    const list = g.missions.available();\n    const items = list.slice(0, 5).map((m) => ({ id: m.id, label: m.title, small: true, enabled: !g.missions.active, onSelect: () => { this.menu.pop(); g.missions.offer(m, null); } }));\n    items.push({ id: 'leave', label: 'LEAVE', onSelect: () => this.menu.pop() });\n    this.menu.push({ id: 'board', title: 'NOTICE BOARD', subtitle: list.length ? 'WORK. THE PAPER IS OLDER THAN THE WAR.' : 'NOTHING TODAY. THE NAILS ARE STILL GOOD.', overlayWorld: true, items });\n  }\n  // ---- Rail halts ----\n  openHalts(from) {\n    const g = this.game;\n    const items = Object.entries(HALTS).filter(([k]) => k !== from).map(([k, h]) => ({ id: k, label: h.name, enabled: g.story.halts.has(k) && g.story.stones >= 1, focusable: true, onSelect: () => { this.menu.pop(); g.railTravel(k); } }));\n    items.push({ id: 'leave', label: 'LEAVE', onSelect: () => this.menu.pop() });\n    this.menu.push({ id: 'halts', title: HALTS[from].name, subtitle: 'ONE STONE. ONE HOUR. YOU WILL HEAR ABOUT IT.', overlayWorld: true, items });\n  }\n  // ---- Bakr on a black screen with clacking wheels ----\n  blackTalk(text, who, seconds, onEnd) {\n    const g = this.game;\n    let t = 0;\n    const s = { id: 'black', cover: true, noBack: true, hints: [], items: [], onConfirm: () => { t = seconds; },\n      update: (c, dt) => { t += dt; if (t >= seconds) { this.menu.pop(); onEnd(); } },\n      tapAnywhere: () => { t = seconds; },\n      draw: (hud) => { const lines = wrap(text, hud.width - 80); let y = (hud.height / 2 - lines.length * 5) | 0; if (who) hud.text(40, y - 12, who, { color: 'sand' }); for (const l of lines) { hud.text(40, y, l, { color: 'white' }); y += 10; } } };\n    this.menu.push(s);\n  }\n  // ---- The Ledger ----\n  openLedger(onClose) {\n    const g = this.game;\n    this.menu.push({\n      id: 'ledger', overlayWorld: true, onBack: () => { this.menu.pop(); onClose?.(); },\n      hints: [['back', 'CLOSE']], items: [],\n      onConfirm: () => { this.menu.pop(); onClose?.(); },\n      draw: (hud, m, sc) => {\n        hud.rect(30, 10, hud.width - 60, hud.height - 30, 'sand');\n        hud.rect(32, 12, hud.width - 64, hud.height - 34, 'mist');\n        hud.rect(34, 14, hud.width - 68, hud.height - 38, 'sand');\n        hud.text(44, 20, 'THE LEDGER', { scale: 2, color: 'plum', shadow: false });\n        let y = 42;\n        for (const l of g.ledger.lines()) {\n          hud.text(44, y, l.big, { scale: 2, color: 'ink', shadow: false });\n          hud.text(44, y + 16, l.small, { color: 'plum', shadow: false });\n          y += 34;\n        }\n        hud.text(hud.width - 44 - 6 * 5, hud.height - 40, 'E.H.', { color: 'plum', shadow: false });\n        m.footer(hud, sc);\n      },\n    });\n  }\n  // ---- Game over ----\n  openGameOver() {\n    const g = this.game;\n    this.menu.push({\n      id: 'gameover', cover: 'ink', noBack: true,\n      items: () => [{ id: 'continue', label: 'CONTINUE', enabled: g.save.exists() || !!g.save.lastWritten, onSelect: () => { this.menu.clear(); g.save.requestLoad(); } }, { id: 'title', label: 'TITLE', onSelect: () => { this.menu.clear(); g.toTitle(); } }],\n      draw: (hud, m, sc) => {\n        const t1 = 'YOU DIED IN THE SORREL.', t2 = 'THE PAPERWORK WILL TAKE LONGER.';\n        hud.text(((hud.width - t1.length * 12) / 2) | 0, 70, t1, { scale: 2, color: 'red' });\n        hud.text(((hud.width - t2.length * 6) / 2) | 0, 92, t2, { color: 'mist' });\n        let y = 136;\n        m.itemsOf(sc).forEach((it, i) => { y += m.itemRow(hud, it, i, y, sc.focus === i); });\n      },\n    });\n  }\n  // ---- Ending card, then Ledger, then credits, then title ----\n  openEnding(sheet) {\n    const g = this.game;\n    const text = sheet === 'column'\n      ? 'THEY CROSSED AT FIRST LIGHT, WALKING ON ASH. NOBODY HAS ASKED WHO LIT IT. THE FEVER IS NOT FINISHED WITH YOU, AND YOU ARE OUT OF TABLETS. IT IS A GOOD VIEW.'\n      : 'YOU REACHED THE BORDER WITH A CASE OF STONES AND A MAP NOBODY ELSE WILL EVER USE. THE GUARD ASKS YOUR TRADE. YOU TELL HIM: SURVEYOR.';\n    this.menu.clear();\n    this.menu.push({\n      id: 'ending', cover: 'ink', noBack: true, items: [], hints: [['confirm', 'GO ON']],\n      onConfirm: () => { this.menu.pop(); this.openLedger(() => this.openCredits(() => g.toTitle())); },\n      tapAnywhere: function () { this.onConfirm(); },\n      draw: (hud, m, sc) => {\n        const lines = wrap(text, hud.width - 100);\n        let y = (hud.height / 2 - lines.length * 6) | 0;\n        for (const l of lines) { hud.text(50, y, l, { color: 'white' }); y += 12; }\n        m.footer(hud, sc);\n      },\n    });\n    g.events.emit('ending-card', sheet);\n  }\n  openCredits(onDone) {\n    const g = this.game;\n    const pages = g.about.creditPages();\n    this.menu.push({ id: 'credits', cover: 'ink', title: 'CREDITS', pages, items: [], onBack: () => { this.menu.pop(); onDone?.(); }, hints: [['menuRight', 'PAGE'], ['back', 'DONE']], onConfirm: (s) => { if (s.page < s.pages.length - 1) this.menu.turnPage(s, 1); else { this.menu.pop(); onDone?.(); } } });\n  }\n  /** A black screen with one Harrow epigraph. */\n  epigraph(seconds, onEnd) {\n    const g = this.game;\n    const line = EPIGRAPHS[g.rng.look.int(0, EPIGRAPHS.length - 1)];\n    let t = 0;\n    this.menu.push({ id: 'epigraph', cover: 'ink', noBack: true, items: [], hints: [], text: line, onConfirm: () => { t = seconds; }, tapAnywhere: () => { t = seconds; },\n      update: (c, dt) => { t += Math.max(dt, 1 / 60); if (t >= seconds) { this.menu.pop(); onEnd?.(); } },\n      draw: (hud) => { const lines = wrap(line, hud.width - 100); let y = (hud.height / 2 - lines.length * 6) | 0; for (const l of lines) { hud.text(50, y, l, { color: 'mist' }); y += 12; } hud.text(50, y + 8, \"FROM HARROW'S FIELD NOTES\", { color: 'slate' }); } });\n  }\n  update(ctx, realDt) { this.menu.update(ctx, realDt); }\n  draw(hud) { this.menu.draw(hud); }\n}\nEOF\ncat > src/ui/shell.js <<'EOF'\n// Title, main menu, pause, settings: every screen by pad, keyboard and mouse. Touch-only devices get the notice and a Settings button.\nimport { Menu, SAFE_X, SAFE_Y } from './menu.js';\nimport { GAME_TITLE } from '../content/title.js';\nimport { DEFAULT_SETTINGS, storeSettings } from '../core/save.js';\nimport { drawGlyph, glyphWidth } from './glyphs.js';\nexport const NOTICE_TOUCH = 'Controller or keyboard required';\nexport function isTouchOnly() {\n  if (typeof matchMedia === 'undefined') return false;\n  try { return matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; } catch { return false; }\n}\nexport class Shell {\n  titleFrames = 0; idle = 0; pressed = false; gate = false;\n  constructor(game) { this.game = game; }\n  get ui() { return this.game.ui; }\n  get menu() { return this.game.ui.menu; }\n  enterTitle() {\n    const g = this.game;\n    this.pressed = false;\n    this.idle = 0;\n    this.menu.clear();\n    this.gate = isTouchOnly() && !this.padConnected() && !g.options.forceNoGate;\n    if (this.gate) this.pushGate();\n    else this.menu.push(this.titleScreen());\n  }\n  padConnected() { const n = typeof navigator !== 'undefined' ? navigator : null; try { const pads = n?.getGamepads?.() ?? []; for (const p of pads) if (p && p.connected) return true; } catch { /* no pads */ } return false; }\n  titleScreen() {\n    const g = this.game;\n    return {\n      id: 'title', noBack: true, items: [], attractIdle: true, hints: [],\n      onConfirm: () => { this.pressed = true; this.menu.pop(); this.menu.push(this.mainMenu()); },\n      tapAnywhere: () => { this.pressed = true; this.menu.pop(); this.menu.push(this.mainMenu()); },\n      update: (c, dt, s) => { for (const code of ['Space', 'KeyE', 'PadSquare', 'PadTriangle', 'PadOptions', 'Escape']) if (c.input.wasPressed(code)) { s.onConfirm(); return; } },\n      draw: (hud, m, s) => {\n        this.logo(hud);\n        const name = g.actions.glyph('confirm', g.settings.glyphs === 'xb');\n        const blink = (m.frame >> 5) & 1;\n        const w = 6 * 6 + 4 + glyphWidth(name);\n        const x = ((hud.width - w) / 2) | 0, y = hud.height - 40;\n        if (blink) { hud.text(x, y + 2, 'PRESS ', { color: 'white' }); drawGlyph(hud, x + 36, y, name); }\n      },\n    };\n  }\n  logo(hud) {\n    let scale = 4;\n    if (GAME_TITLE.length * 6 * scale > hud.width - 40) scale = 3;\n    const w = GAME_TITLE.length * 6 * scale;\n    hud.text(((hud.width - w) / 2) | 0, 42, GAME_TITLE, { scale, color: 'sand', shadow: 'plum' });\n    const sub = 'A MAP IS A PROMISE';\n    hud.text(((hud.width - sub.length * 6) / 2) | 0, 42 + 8 * scale + 4, sub, { color: 'mist' });\n  }\n  mainMenu() {\n    const g = this.game;\n    return {\n      id: 'main', noBack: true, attractIdle: true,\n      items: () => {\n        const list = [];\n        if (g.save.exists()) list.push({ id: 'continue', label: 'CONTINUE', onSelect: () => g.startContinue() });\n        list.push({ id: 'new', label: 'NEW GAME', onSelect: () => g.startNew() });\n        list.push({ id: 'cash', label: 'CASH RUN', onSelect: () => this.openCashRun() });\n        list.push({ id: 'settings', label: 'SETTINGS', onSelect: () => this.openSettings() });\n        list.push({ id: 'about', label: 'ABOUT AND CREDITS', onSelect: () => this.openAbout() });\n        return list;\n      },\n      hints: [['confirm', 'SELECT']],\n      draw: (hud, m, s) => {\n        this.logo(hud);\n        let y = 100;\n        m.itemsOf(s).forEach((it, i) => { y += m.itemRow(hud, it, i, y, s.focus === i); });\n        m.footer(hud, s);\n      },\n    };\n  }\n  pushGate() {\n    const g = this.game;\n    this.menu.push({\n      id: 'gate', noBack: true, attractIdle: true,\n      items: [{ id: 'settings', label: 'SETTINGS', onSelect: () => this.openSettings() }],\n      hints: [],\n      draw: (hud, m, s) => {\n        this.logo(hud);\n        const t = NOTICE_TOUCH.toUpperCase();\n        hud.text(((hud.width - t.length * 6) / 2) | 0, 112, t, { color: 'orange' });\n        const w = 200, x = ((hud.width - w) / 2) | 0, y = 136;\n        hud.rect(x, y, w, 28, 'orange');\n        hud.text(((hud.width - 8 * 12) / 2) | 0, y + 7, 'SETTINGS', { scale: 2, color: 'ink', shadow: false });\n        m.regions.push({ x, y, w, h: 28, index: 0 });\n      },\n    });\n  }\n  /** A key press or pad connecting clears the gate and shows the normal title. */\n  stepGate() {\n    if (!this.gate) return;\n    const g = this.game, inp = g.ctx.input;\n    const st = inp.state();\n    const key = st.held.some((c) => c !== 'Touch' && !c.startsWith('Mouse')) || st.queued.some(([c]) => c !== 'Touch' && !c.startsWith('Mouse'));\n    if (key || this.padConnected()) {\n      this.gate = false;\n      if (this.menu.top?.id === 'gate') { this.menu.pop(); this.menu.push(this.titleScreen()); }\n    }\n  }\n  openPause() {\n    const g = this.game;\n    const hub = g.options.session?.kind === 'hub';\n    const items = () => hub ? [\n      { id: 'resume', label: 'RESUME', onSelect: () => g.resume() },\n      { id: 'settings', label: 'SETTINGS', onSelect: () => this.openSettings() },\n    ] : [\n      { id: 'resume', label: 'RESUME', onSelect: () => g.resume() },\n      { id: 'ledger', label: 'LEDGER', onSelect: () => this.ui.openLedger() },\n      { id: 'settings', label: 'SETTINGS', onSelect: () => this.openSettings() },\n      { id: 'dev', label: 'DEV MODE', onSelect: () => g.dev.open() },\n      { id: 'about', label: 'ABOUT AND CREDITS', onSelect: () => this.openAbout() },\n      { id: 'quit', label: 'QUIT TO TITLE', onSelect: () => g.toTitle() },\n    ];\n    this.menu.push({ id: 'pause', title: 'PAUSED', dim: 0.5, items, onBack: () => g.resume(), pausesWorld: true, hints: [['confirm', 'SELECT'], ['back', 'RESUME']] });\n  }\n  openCashRun() {\n    const g = this.game;\n    this.menu.push({\n      id: 'cash', title: 'CASH RUN', subtitle: 'SIX CASES IN A BURNING VALLEY. MOST STONES WINS. FRIENDLY FIRE IS ON.', dim: 0.5, blurb: 'FRIENDS ONLINE PLAY THROUGH AI HUB.',\n      items: [\n        { id: 'solo', label: 'SOLO WITH HIRED GUNS', onSelect: () => g.startRound('solo') },\n        { id: 'host', label: 'HOST ON THIS COMPUTER', onSelect: () => g.startRound('host') },\n        { id: 'join', label: 'JOIN ON THIS COMPUTER', onSelect: () => g.startRound('join') },\n      ],\n    });\n  }\n  openAbout() {\n    const g = this.game;\n    this.menu.push({ id: 'about', cover: 'ink', title: 'ABOUT AND CREDITS', pages: g.about.pages(), items: [], attractExempt: true, hints: [['menuRight', 'PAGE'], ['back', 'BACK']] });\n  }\n  // ---- Settings: Sound, Controls, Picture, Comfort ----\n  setting(key) { return { get: () => this.game.settings[key], set: (v) => { this.game.settings[key] = v; this.game.applySettings(); } }; }\n  openSettings() {\n    const g = this.game, S = (key, min, max, step, format) => ({ ...this.setting(key), min, max, step, format });\n    const pct = (v) => `${Math.round(v * 100)}%`;\n    const onOff = (key) => ({ options: [true, false], ...this.setting(key), format: (v) => (v ? 'ON' : 'OFF') });\n    const tabs = ['SOUND', 'CONTROLS', 'PICTURE', 'COMFORT'];\n    const pages = [\n      () => [\n        { id: 'music', label: 'MUSIC', slider: S('music', 0, 1, 0.05, pct) }, { id: 'sfx', label: 'EFFECTS', slider: S('sfx', 0, 1, 0.05, pct) }, { id: 'voices', label: 'VOICES', slider: S('voices', 0, 1, 0.05, pct) },\n        { id: 'reset', label: 'RESET TO DEFAULTS', onSelect: () => this.resetSettings() },\n      ],\n      () => [\n        { id: 'sensPad', label: 'LOOK, PAD', slider: S('sensPad', 0.25, 3, 0.05, (v) => v.toFixed(2)), small: true }, { id: 'sensMouse', label: 'LOOK, MOUSE', slider: S('sensMouse', 0.25, 3, 0.05, (v) => v.toFixed(2)), small: true },\n        { id: 'invertY', label: 'INVERT Y', choices: onOff('invertY'), small: true }, { id: 'aimAssist', label: 'AIM ASSIST', choices: onOff('aimAssist'), small: true }, { id: 'rumble', label: 'RUMBLE', choices: onOff('rumble'), small: true },\n        { id: 'glyphs', label: 'GLYPHS', choices: { options: ['ps', 'xb'], ...this.setting('glyphs'), format: (v) => (v === 'ps' ? 'PLAYSTATION' : 'XBOX') }, small: true },\n        { id: 'reset', label: 'RESET TO DEFAULTS', small: true, onSelect: () => this.resetSettings() },\n      ],\n      () => [\n        { id: 'fullscreen', label: 'FULLSCREEN', onSelect: () => g.toggleFullscreen() },\n        { id: 'pixelSize', label: 'PIXEL SIZE', choices: { options: ['fine', 'chunky'], ...this.setting('pixelSize'), format: (v) => v.toUpperCase() } },\n        { id: 'quality', label: 'QUALITY', choices: { options: ['auto', 'low', 'medium', 'high'], ...this.setting('quality'), format: (v) => v.toUpperCase() } },\n        { id: 'fov', label: 'FIELD OF VIEW', slider: S('fov', 50, 90, 1, (v) => String(Math.round(v))) },\n        { id: 'reset', label: 'RESET TO DEFAULTS', onSelect: () => this.resetSettings() },\n      ],\n      () => [\n        { id: 'subtitleSize', label: 'SUBTITLE SIZE', choices: { options: [1, 2], ...this.setting('subtitleSize'), format: (v) => (v === 1 ? 'SMALL' : 'LARGE') } },\n        { id: 'reduceFlashes', label: 'REDUCE FLASHES', choices: onOff('reduceFlashes') }, { id: 'feverReduced', label: 'FEVER EFFECTS LESS', choices: onOff('feverReduced') },\n        { id: 'reset', label: 'RESET TO DEFAULTS', onSelect: () => this.resetSettings() },\n      ],\n    ];\n    this.menu.push({ id: 'settings', title: 'SETTINGS', cover: g.mode === 'title' ? false : false, dim: 0.5, tabs, attractExempt: true, items: (s) => pages[s.tab](), hints: [['confirm', 'CHANGE'], ['back', 'BACK']], onBack: () => { storeSettings(g.settings); this.menu.pop(); } });\n  }\n  resetSettings() {\n    const g = this.game;\n    Object.assign(g.settings, DEFAULT_SETTINGS);\n    g.applySettings();\n    storeSettings(g.settings);\n    g.notice('DEFAULTS. EVEN THE MUSIC.', 2);\n  }\n}\nEOF\necho ok","description":"Write HUD, in-world screens and title, pause, settings shell"}}}
