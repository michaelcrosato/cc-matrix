{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkftrBZcP8NXSWdET3NY","type":"message","role":"assistant","content":[{"type":"text","text":"All the art data checks out: 33 hand clips and 97 people clips compile with no problems. Next is the gameplay core: player, weapons and wear, damage, the body and fever, soldiers and their AI."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":33303,"cache_read_input_tokens":310529,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":33303},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"1596f5b4-b92b-4198-9550-9fbfea2f74c6","timestamp":"2026-11-05T23:45:31.464Z","request_id":"req_011CgkftqrTtSknio62U875s"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkftrBZcP8NXSWdET3NY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013Tc5io4bkqixQknXUeQEFE","name":"Bash","input":{"command":"set -e\ncat > src/actors/player.js <<'EOF'\n// The player: a grounded capsule, stance, stamina, footsteps, the use scan. No visible body.\nimport { THREE, CharacterController } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { K } from '../world/ground.js';\nimport { RIVER_Y } from '../content/roads.js';\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\nimport { F } from '../world/fire.js';\nconst { Vector3 } = THREE;\nconst _v = new Vector3(), _f = new Vector3(), _r = new Vector3();\nexport class Player {\n  stance = 'stand'; walkToggle = false; sprinting = false; stamina = 6; eyeH = 1.55; noise = 0; wading = false; inGrass = false; moving = false; speedNow = 0;\n  stepDist = 0; prevY = 0; airFrom = null; bob = 0; bobAmp = 0; landDip = 0; litUntil = 0; seat = null; frozen = false; carrying = null; hidden = false; flying = false;\n  constructor(game) { this.game = game; this.feet = new Vector3(); this.eye = new Vector3(); this.move = new Vector3(); }\n  build(ctx, at = [-120, 60, 150]) {\n    const y = this.game.world.heightAt(at[0], at[2]) + 0.3;\n    this.cc = new CharacterController(ctx.physics, { position: [at[0], y, at[2]], radius: 0.34, halfHeight: 0.56, speed: 5.4, jumpSpeed: 8, gravity: -24 });\n    ctx.physics.tag(this.cc.collider, 'player');\n    this.game.hitMap.set(this.cc.collider.handle, { kind: 'player', ref: this });\n    this.feet.copy(this.cc.feet);\n  }\n  teleport(x, z, y) {\n    const g = this.game;\n    const yy = y ?? g.world.heightAt(x, z) + 0.2;\n    this.cc.teleport([x, yy, z]);\n    this.cc.velocity.set(0, 0, 0);\n    this.feet.set(x, yy, z);\n    this.airFrom = null;\n    g.fireView?.sweep();\n    if (g.grass) g.grass.primeAll = true;\n  }\n  setYaw(y, p = 0) { const rig = this.game.ctx.camera; rig.yaw = y; rig.pitch = p; }\n  get yaw() { return this.game.ctx.camera.yaw ?? 0; }\n  get pitch() { return this.game.ctx.camera.pitch ?? 0; }\n  forward(out = _f) { const y = this.yaw, p = this.pitch; return out.set(-Math.sin(y) * Math.cos(p), Math.sin(p), -Math.cos(y) * Math.cos(p)); }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions;\n    if (this.seat) { this.feet.copy(this.seat.feet()); this.noise = 0; return; }\n    if (this.flying) { this.fly(ctx, dt); return; }\n    const axis = this.frozen || g.scene.locksMove ? { x: 0, y: 0 } : a.axis();\n    const yaw = this.yaw;\n    const fx = -Math.sin(yaw), fz = -Math.cos(yaw), rx = Math.cos(yaw), rz = -Math.sin(yaw);\n    const tilt = Math.min(1, Math.hypot(axis.x, axis.y));\n    if (!this.frozen && !g.scene.locksMove) {\n      if (a.take('crouch')) this.stance = this.stance === 'crouch' ? 'stand' : 'crouch';\n      if (g.ctx.input.consumePress('CapsLock')) this.walkToggle = !this.walkToggle;\n    }\n    this.wading = g.ground.isWater(this.feet.x, this.feet.z) && this.feet.y < RIVER_Y - 0.1;\n    const padTilted = a.device === 'pad' && tilt > 0.05 && tilt < 0.62;\n    const walking = this.walkToggle || padTilted;\n    const wantSprint = a.down('sprint') && axis.y > 0.3 && !g.weapons.aiming && !this.carrying && !this.wading;\n    let speed = 5.4;\n    if (this.stance === 'crouch') speed = 2.0;\n    else if (walking) speed = 3.6;\n    this.sprinting = false;\n    if (wantSprint && this.stamina > 0 && this.stance !== 'crouch') { this.sprinting = true; speed = 7.4; this.stamina = Math.max(0, this.stamina - dt); }\n    else this.stamina = Math.min(6, this.stamina + dt * (6 / 8));\n    if (this.wading) speed = Math.min(speed, 2.7);\n    if (this.carrying) speed *= 0.85;\n    speed *= TUNING.playerSpeed * (g.weapons.aiming ? 0.72 : 1) * g.body.moveFactor();\n    this.cc.speed = speed;\n    this.move.set(fx * axis.y + rx * axis.x, 0, fz * axis.y + rz * axis.x);\n    const ml = this.move.length();\n    if (ml > 1) this.move.multiplyScalar(1 / ml);\n    this.moving = ml > 0.05 && !this.frozen;\n    const jump = !this.frozen && !g.scene.locksMove && !g.mapUp && a.take('jump');\n    this.cc.setInput(this.move, jump, a.down('jump'));\n    const wasGrounded = this.cc.grounded;\n    this.cc.fixedUpdate(dt);\n    this.feet.copy(this.cc.feet);\n    // Falling.\n    if (!this.cc.grounded && this.airFrom === null) this.airFrom = this.feet.y;\n    if (this.cc.grounded && this.airFrom !== null) {\n      const drop = this.airFrom - this.feet.y;\n      this.airFrom = null;\n      if (drop > 1.2) { this.landDip = clamp(drop * 0.05, 0.03, 0.2); g.sfx.play('land', { volume: 0.5 }); }\n      if (drop > 6) g.body.hurt((drop - 6) * 9, 'fall');\n    }\n    if (this.feet.y < 5) { this.teleport(this.feet.x, this.feet.z); }\n    // Noise and footsteps.\n    const k = g.ground.kindAt(this.feet.x, this.feet.z);\n    this.inGrass = (k === K.CROP || k === K.GRASS || k === K.WOOD) && !g.fire.isBurnt(this.feet.x, this.feet.z);\n    this.speedNow = this.moving && this.cc.grounded ? speed : 0;\n    this.noise = !this.moving ? 0 : this.sprinting ? 40 : (this.stance === 'crouch' || walking) ? 0 : 25;\n    this.stepDist += this.speedNow * dt;\n    const stride = this.sprinting ? 2.5 : this.stance === 'crouch' ? 1.5 : 1.9;\n    if (this.stepDist > stride) {\n      this.stepDist = 0;\n      const surf = this.wading ? 'water' : (k === K.ROAD || k === K.RAIL || k === K.TRACK) ? 'road' : (k === K.GRASS || k === K.CROP || k === K.WOOD || k === K.BANK) ? (g.fire.isBurnt(this.feet.x, this.feet.z) ? 'dirt' : 'grass') : (g.world.onDeck?.(this.feet) ? 'wood' : 'dirt');\n      g.sfx.play(`step-${surf}`, { volume: this.stance === 'crouch' ? 0.2 : this.sprinting ? 0.55 : 0.36 });\n    }\n    // Being in a burning cell.\n    if (g.fire.isBurning(this.feet.x, this.feet.z) && !this.wading) g.body.catchFire();\n  }\n  fly(ctx, dt) {\n    const g = this.game, a = g.actions, axis = a.axis();\n    const fwd = this.forward(_f), rx = Math.cos(this.yaw), rz = -Math.sin(this.yaw), sp = a.down('sprint') ? 60 : 22;\n    this.feet.x += (fwd.x * axis.y + rx * axis.x) * sp * dt;\n    this.feet.y += (fwd.y * axis.y + (a.down('jump') ? 1 : 0) - (a.down('crouch') ? 1 : 0)) * sp * dt;\n    this.feet.z += (fwd.z * axis.y + rz * axis.x) * sp * dt;\n    this.feet.y = Math.max(this.feet.y, g.world.heightAt(this.feet.x, this.feet.z) + 0.2);\n    this.cc.teleport([this.feet.x, this.feet.y, this.feet.z]);\n    this.noise = 0;\n  }\n  /** Visual eye height and bob. `alpha`-blended feet keep the camera smooth. */\n  update(ctx, dt) {\n    const g = this.game;\n    if (this.seat) { this.seat.eye(this.eye); return this.eye; }\n    const want = this.stance === 'crouch' ? 0.95 : 1.55;\n    this.eyeH = lerp(this.eyeH, want, 1 - Math.exp(-dt * 10));\n    const feet = this.flying ? this.feet : this.cc.interpolatedFeet(ctx.physics.alpha);\n    const sway = this.game.body.bodySway ?? 0;\n    this.landDip = lerp(this.landDip, 0, 1 - Math.exp(-dt * 8));\n    this.eye.set(feet.x, feet.y + this.eyeH - this.landDip - (this.wading ? 0.3 : 0), feet.z);\n    this.bob += this.speedNow * dt * 1.8;\n    this.bobAmp = lerp(this.bobAmp, this.speedNow > 0 ? clamp(this.speedNow / 7, 0.3, 1) : 0, 1 - Math.exp(-dt * 8));\n    return this.eye;\n  }\n}\nEOF\ncat > src/combat/damage.js <<'EOF'\n// Who gets hurt by what. Bullets by ray, blasts by radius. Sim only; pictures through the feedback helpers.\nimport { THREE } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst _o = new Vector3(), _d = new Vector3(), _h = new Vector3();\nexport class Damage {\n  hitFlash = 0; lastHitAt = -9;\n  constructor(game) { this.game = game; }\n  /** One bullet. Returns what it hit. `who` is 'player', a soldier, a buddy or a seat id in a round. */\n  bullet(fromX, fromY, fromZ, dx, dy, dz, range, damage, who, opts = {}) {\n    const g = this.game, ctx = g.ctx;\n    _o.set(fromX, fromY, fromZ); _d.set(dx, dy, dz).normalize();\n    const exclude = who?.cc?.body ?? (who === 'player' ? g.player.cc?.body : undefined);\n    const hit = ctx.physics.castRay(_o, _d, range, [], exclude);\n    if (!hit) return null;\n    const px = fromX + _d.x * hit.distance, py = fromY + _d.y * hit.distance, pz = fromZ + _d.z * hit.distance;\n    const ent = g.hitMap.get(hit.collider.handle);\n    const res = { x: px, y: py, z: pz, ent, distance: hit.distance };\n    if (!ent) { g.fx.impact(px, py, pz, hit.normal, 'dirt', opts); return res; }\n    switch (ent.kind) {\n      case 'soldier': {\n        const s = ent.ref;\n        if (s.dead) return res;\n        const zone = py - s.y;\n        const m = zone > 1.48 ? 2.5 : zone < 0.68 ? 0.7 : 1;\n        if (who === 'player' || opts.seat != null) g.fx.hitMarker(m > 1);\n        s.hurt(damage * m, who, _d, m > 1 ? 'head' : 'body', opts);\n        g.fx.impact(px, py, pz, hit.normal, 'flesh', opts);\n        break;\n      }\n      case 'player':\n        if (who !== 'player') g.body.hurt(damage, 'bullet', [fromX, fromZ], opts);\n        g.fx.impact(px, py, pz, hit.normal, 'flesh', opts);\n        break;\n      case 'buddy':\n        if (who !== 'player' || !g.story?.noFriendlyFire) ent.ref.hurt(damage, who);\n        g.fx.impact(px, py, pz, hit.normal, 'flesh', opts);\n        break;\n      case 'civilian':\n        ent.ref.flee(fromX, fromZ);\n        g.fx.impact(px, py, pz, hit.normal, 'dirt', opts);\n        break;\n      case 'vehicle':\n        ent.ref.hurt(damage * 0.35, 'bullet');\n        g.fx.impact(px, py, pz, hit.normal, 'metal', opts);\n        break;\n      case 'explosive': {\n        const ex = ent.ref;\n        ex.hp -= damage;\n        g.fx.impact(px, py, pz, hit.normal, 'metal', opts);\n        if (ex.hp <= 0) this.explode(ex, 'bullet', who);\n        break;\n      }\n      case 'merc':\n        g.round?.hitMerc(ent.ref, damage, opts, who);\n        g.fx.impact(px, py, pz, hit.normal, 'flesh', opts);\n        break;\n      default:\n        g.fx.impact(px, py, pz, hit.normal, 'dirt', opts);\n    }\n    return res;\n  }\n  /** A blast: hurts everything in range, lights the grass, chains tanks. */\n  blast(x, y, z, radius, damage, who, opts = {}) {\n    const g = this.game, ctx = g.ctx;\n    g.fx.explosion(x, y, z, radius);\n    if (opts.fire !== 0) g.fire.ignite(x, z, opts.fire ?? radius * 0.8, who === 'player' ? 'player' : 'world');\n    // Soldiers.\n    for (const s of g.actors.soldiers) {\n      if (s.dead || !s.active) continue;\n      const d = Math.hypot(s.x - x, s.y - y, s.z - z);\n      if (d < radius * 1.3) {\n        const f = clamp(1 - d / (radius * 1.3), 0.15, 1);\n        _d.set(s.x - x, Math.abs(s.y - y) + 1.2, s.z - z).normalize();\n        s.hurt(damage * f, who, _d, 'blast', { blast: 1 });\n        if (d < radius * 0.7) s.ignite();\n      }\n    }\n    for (const b of g.actors.buddies) {\n      if (!b.active || b.down || b.dead) continue;\n      const d = Math.hypot(b.x - x, b.z - z);\n      if (d < radius) b.hurt(damage * (1 - d / radius) * 0.5, who);\n    }\n    // The player.\n    if (g.hasPlayer) {\n      const f = g.player.feet, d = Math.hypot(f.x - x, f.y + 0.9 - y, f.z - z);\n      if (d < radius * 1.2) {\n        const v = clamp(1 - d / (radius * 1.2), 0.1, 1);\n        g.body.hurt(damage * v * 0.42, 'blast', [x, z]);\n        ctx.engine.shake.add(v * 0.9);\n      } else if (d < radius * 8) ctx.engine.shake.add(clamp(0.5 - d / (radius * 16), 0, 0.5));\n    }\n    // Vehicles.\n    for (const v of g.vehicles.list) {\n      if (!v.alive) continue;\n      const d = Math.hypot(v.x - x, v.z - z);\n      if (d < radius * 1.2) v.hurt(damage * clamp(1 - d / (radius * 1.2), 0.15, 1), 'blast');\n    }\n    // Chains.\n    for (const ex of g.world.explosives) {\n      if (!ex.alive) continue;\n      if (Math.hypot(ex.x - x, ex.z - z) < radius) { ex.hp -= damage; if (ex.hp <= 0) g.after(0.12 + Math.hypot(ex.x - x, ex.z - z) * 0.02, () => this.explode(ex, 'chain', who)); }\n    }\n    g.round?.blastAt?.(x, y, z, radius, damage, who, opts);\n    ctx.physics.explode([x, y, z], { radius: radius * 1.4, impulse: 14 });\n    g.actors.heardGunshot(x, z, radius * 16);\n    g.events.emit('blast', x, z, radius);\n  }\n  explode(ex, cause, who) {\n    if (!ex.alive) return;\n    ex.alive = false;\n    ex.object.visible = false;\n    for (const c of ex.colliders) { c.setEnabled?.(false); }\n    this.game.events.emit('destroyed', ex.tag ?? ex.id, ex);\n    this.blast(ex.x, ex.y + 1.2, ex.z, ex.def.radius, ex.def.damage, who ?? (cause === 'fire' ? 'fire' : 'world'), { fire: ex.def.fire });\n    this.game.fx.scorch(ex.x, ex.y, ex.z, ex.def.radius);\n  }\n  restore(ex) {\n    ex.alive = true; ex.hp = ex.def.hp; ex.object.visible = true;\n    for (const c of ex.colliders) c.setEnabled?.(true);\n  }\n}\nEOF\ncat > src/combat/projectiles.js <<'EOF'\n// Flares, bottles and rockets: integrated per fixed step, one ray per step. Hit and light.\nimport { THREE, glowMaterial, PALETTE, buildModel, toonMaterial } from '../../pixel-engine.js';\nconst { Vector3, Mesh, BoxGeometry, SphereGeometry } = THREE;\nconst _o = new Vector3(), _d = new Vector3();\nconst KIND = {\n  flare: { speed: 42, gravity: 11, color: PALETTE.orange, size: 0.14, life: 6, trail: 'ember' },\n  bottle: { speed: 18, gravity: 12, color: PALETTE.teal, size: 0.12, life: 5 },\n  rocket: { speed: 62, gravity: 1.2, color: PALETTE.sand, size: 0.2, life: 4, trail: 'fire-smoke' },\n  soldier_rocket: { speed: 44, gravity: 1.2, color: PALETTE.sand, size: 0.2, life: 4, trail: 'fire-smoke' },\n};\nexport class Projectiles {\n  list = []; pool = [];\n  constructor(game) { this.game = game; }\n  spawn(kind, x, y, z, dx, dy, dz, who, opts = {}) {\n    const def = KIND[kind];\n    const g = this.game;\n    let mesh = null;\n    if (g.views) {\n      mesh = new Mesh(new BoxGeometry(def.size, def.size, def.size * 2), kind === 'bottle' ? toonMaterial(def.color) : glowMaterial(def.color));\n      mesh.position.set(x, y, z); g.ctx.scene.add(mesh);\n    }\n    const l = Math.hypot(dx, dy, dz) || 1;\n    const sp = opts.speed ?? def.speed;\n    const p = { kind, def, x, y, z, vx: (dx / l) * sp, vy: (dy / l) * sp, vz: (dz / l) * sp, t: 0, who, mesh, opts, light: null };\n    if (g.views && kind === 'flare') p.light = g.ctx.lights.request({ position: [x, y, z], color: 0xff7a30, intensity: 12, radius: 18, flicker: 'torch' });\n    this.list.push(p);\n    return p;\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game;\n    const rays = ctx.physics;\n    for (let i = this.list.length - 1; i >= 0; i--) {\n      const p = this.list[i];\n      p.t += dt;\n      p.vy -= p.def.gravity * dt;\n      const dx = p.vx * dt, dy = p.vy * dt, dz = p.vz * dt, len = Math.hypot(dx, dy, dz);\n      _o.set(p.x, p.y, p.z); _d.set(dx / len, dy / len, dz / len);\n      const exclude = p.who === 'player' ? g.player?.cc?.body : p.who?.cc?.body;\n      const hit = rays.castRay(_o, _d, len + 0.05, [], exclude);\n      if (hit || p.t > p.def.life) {\n        const hx = hit ? p.x + _d.x * hit.distance : p.x, hy = hit ? p.y + _d.y * hit.distance : p.y, hz = hit ? p.z + _d.z * hit.distance : p.z;\n        this.impact(p, hx, hy, hz, hit);\n        this.remove(i);\n        continue;\n      }\n      p.x += dx; p.y += dy; p.z += dz;\n      if (p.def.trail && ((p.t * 30) | 0) % 2 === 0) ctx.particles.burst(p.def.trail, [p.x, p.y, p.z], { count: 1 });\n      if (p.mesh) { p.mesh.position.set(p.x, p.y, p.z); p.mesh.lookAt(p.x + p.vx, p.y + p.vy, p.z + p.vz); }\n      if (p.light) p.light.position.set(p.x, p.y, p.z);\n    }\n  }\n  impact(p, x, y, z, hit) {\n    const g = this.game;\n    const who = p.who;\n    const src = who === 'player' || p.opts.seat != null ? 'player' : 'world';\n    const ent = hit ? g.hitMap.get(hit.collider.handle) : null;\n    if (p.kind === 'flare') {\n      g.fire.ignite(x, z, 3, src);\n      if (ent?.kind === 'soldier') { ent.ref.hurt(12, who, _d, 'body', p.opts); ent.ref.ignite(); }\n      if (ent?.kind === 'merc') { g.round?.hitMerc(ent.ref, 12, p.opts, who); }\n      g.sfx.at('flare-hiss', x, z, { volume: 0.5, max: 60 });\n      g.ctx.particles.burst('ember', [x, y + 0.2, z], { count: 12 });\n    } else if (p.kind === 'bottle') {\n      g.fire.ignite(x, z, 4, src);\n      g.sfx.at('bottle-smash', x, z, { max: 60 });\n      g.ctx.particles.burst('ember', [x, y + 0.3, z], { count: 20 });\n      g.fx.scorch(x, y, z, 2.5);\n      if (ent?.kind === 'soldier') ent.ref.ignite();\n      for (const s of g.actors.soldiers) if (s.active && !s.dead && Math.hypot(s.x - x, s.z - z) < 3.2) s.ignite();\n    } else {\n      g.damage.blast(x, y + 0.4, z, 6, 180, who, { ...p.opts, fire: 5 });\n      if (ent?.kind === 'vehicle') ent.ref.hurt(160, 'rocket');\n    }\n    g.events.emit('impact', p.kind, x, z);\n  }\n  remove(i) {\n    const p = this.list[i];\n    if (p.mesh) { this.game.ctx.scene.remove(p.mesh); p.mesh.geometry.dispose(); }\n    p.light?.release();\n    this.list.splice(i, 1);\n  }\n  clear() { for (let i = this.list.length - 1; i >= 0; i--) this.remove(i); }\n}\nEOF\ncat > src/combat/weapons.js <<'EOF'\n// The player's guns: wear, jams, things falling apart, throws. The source's spirit made precise (PLAN section 8).\nimport { THREE, Decals } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { WEAPONS, THROWN, SLOT_ORDER } from '../content/weapons.js';\nimport { clamp, lerp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst _f = new Vector3(), _o = new Vector3();\nexport const newGun = (id, cond = 100) => { const d = WEAPONS[id]; return { id, cond, mag: d.mag ?? 0, reserve: d.reserve ?? 0, jam: 0 }; };\nexport const jamChance = (cond) => TUNING.jamRate * 0.12 * Math.pow(1 - cond / 100, 2);\n\nexport class Weapons {\n  slots = { melee: { id: 'cane', cond: 100, mag: 0, reserve: 0, jam: 0 }, sidearm: null, main: null, special: null };\n  current = 'melee'; cool = 0; lock = 0; aiming = false; aimT = 0; reloading = 0; shotsFired = 0; bottles = 0; charges = 0; placed = []; plantHold = 0; throwHeld = false; streamT = 0; lastNoise = 0; tracerN = 0; scriptJamAt = 0; scriptShots = 0; heat = 0; overheated = false; mounted = null; lit = 0; hasCleaning = false; hasBelt = false; flameOn = false; flameT = 0; leakT = 0;\n  constructor(game) { this.game = game; }\n  get gun() { return this.slots[this.current]; }\n  get def() { return WEAPONS[this.gun?.id ?? 'cane']; }\n  give(id, cond = 100, equip = false) {\n    const d = WEAPONS[id];\n    const old = this.slots[d.slot];\n    const g = newGun(id, cond);\n    if (this.hasBelt && g.reserve) g.reserve = Math.round(g.reserve * 1.5);\n    this.slots[d.slot] = g;\n    if (equip || !old) this.equip(d.slot);\n    return g;\n  }\n  equip(slot) {\n    if (!this.slots[slot]) return false;\n    if (this.current !== slot || this.game.vm.gunId !== this.slots[slot].id) { this.current = slot; this.game.sfx.play('gun-equip', { volume: 0.35 }); this.lock = Math.max(this.lock, 0.25); this.reloading = 0; this.game.vm.showGun(this.slots[slot].id, true); this.flameStop(); }\n    return true;\n  }\n  cycle(dir = 1) {\n    const order = SLOT_ORDER.filter((s) => this.slots[s]);\n    const i = order.indexOf(this.current);\n    if (order.length) this.equip(order[(i + dir + order.length) % order.length]);\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions;\n    this.cool -= dt; this.lock -= dt;\n    if (this.mounted) { this.mountedStep(ctx, dt); return; }\n    const canAct = g.canAct();\n    // Slots.\n    if (canAct) {\n      if (a.take('next')) this.cycle(1);\n      for (let i = 0; i < 4; i++) if (ctx.input.consumePress(`Digit${i + 1}`)) this.equip(SLOT_ORDER[i]);\n      if (g.wheelStep) { this.cycle(g.wheelStep > 0 ? 1 : -1); g.wheelStep = 0; }\n    }\n    const gun = this.gun, def = this.def;\n    this.aiming = canAct && a.down('aim') && def.cls !== 'melee' && !g.player.sprinting && this.lock <= 0 && !g.mapUp;\n    this.aimT = lerp(this.aimT, this.aiming ? 1 : 0, 1 - Math.exp(-dt * 12));\n    // Reload ends.\n    if (this.reloading > 0) {\n      this.reloading -= dt;\n      if (this.reloading <= 0) this.finishReload();\n    }\n    if (g.inMonocular()) { this.flameStop(); return; }\n    if (canAct) {\n      this.throwing(ctx, dt);\n      if (a.take('melee') && this.lock <= 0) this.swing(ctx);\n      // Reload is Square on a pad only when no use prompt is showing; R on keys always.\n      const padSquareFree = !g.interact.current;\n      if ((ctx.input.consumePress('KeyR') || (padSquareFree && ctx.input.consumePress('PadSquare')) || g.actions.bot?.queue.delete('reload')) && this.lock <= 0) this.reloadPress(ctx);\n    }\n    // Fire.\n    const wants = canAct && (def.cls === 'melee' ? a.take('fire') : def.auto ? a.down('fire') : a.take('fire'));\n    if (def.stream) this.streamStep(ctx, dt, wants && this.reloading <= 0 && this.lock <= 0 && !gun.jam);\n    else if (wants && this.lock <= 0 && this.reloading <= 0) {\n      if (def.cls === 'melee') this.swing(ctx);\n      else if (this.cool <= 0) this.shoot(ctx);\n    }\n    // A bad gun rattles.\n    if (gun && gun.cond < 10 && def.wear > 0 && g.player.speedNow > 5 && g.tick % 40 === 0) g.sfx.play('gun-rattle', { volume: 0.25 });\n  }\n  /** One press on a jammed gun works it loose a little; on a clean one it reloads. */\n  reloadPress(ctx) {\n    const gun = this.gun, def = this.def, g = this.game;\n    if (!gun || def.cls === 'melee') return;\n    if (gun.jam > 0) {\n      gun.jam--;\n      this.lock = 0.62;\n      g.vm.play(def.cls === 'pistol' ? 'UnjamPistol' : 'UnjamRifle');\n      g.sfx.play('gun-slap', { volume: 0.7 });\n      g.after(0.25, () => g.sfx.play('gun-rack', { volume: 0.7 }));\n      if (gun.jam === 0) { g.events.emit('unjammed'); g.notice('', 0); g.after(0.3, () => g.sfx.play('gun-mag', { volume: 0.3 })); }\n      return;\n    }\n    if (this.reloading > 0 || gun.mag >= def.mag || gun.reserve <= 0) return;\n    this.reloading = def.reload;\n    this.lock = 0;\n    const clip = gun.id === 'mule' ? 'ReloadPump' : gun.id === 'empire' ? 'ReloadBolt' : gun.id === 'm38' ? 'ReloadRevolver' : gun.id === 'flare' ? 'ReloadFlare' : gun.id === 'tube' ? 'ReloadTube' : 'ReloadRifle';\n    g.vm.play(clip);\n    g.sfx.play(gun.id === 'm38' ? 'gun-cylinder' : gun.id === 'mule' ? 'gun-shell' : 'gun-mag', { volume: 0.6 });\n    if (gun.id === 'mule') for (let i = 1; i < 4; i++) g.after(i * 0.55, () => g.sfx.play('gun-shell', { volume: 0.5 }));\n    else g.after(def.reload * 0.7, () => g.sfx.play('gun-rack', { volume: 0.5 }));\n    g.events.emit('reload-start');\n  }\n  finishReload() {\n    const gun = this.gun, def = this.def;\n    if (!gun || !def.mag) return;\n    const need = def.mag - gun.mag, take = Math.min(need, gun.reserve);\n    gun.mag += take; gun.reserve -= take;\n    this.game.events.emit('reloaded');\n  }\n  aimDir(out = _f) { return this.game.player.forward(out); }\n  muzzleWorld(out = _o) { return out.copy(this.game.player.eye); }\n  shoot(ctx) {\n    const g = this.game, gun = this.gun, def = this.def;\n    if (gun.jam > 0) { g.sfx.play('gun-jam', { volume: 0.7 }); this.cool = 0.25; g.showJam(); return; }\n    if (gun.mag <= 0) {\n      g.sfx.play('gun-jam', { volume: 0.4, pitch: 4 }); this.cool = 0.25;\n      if (gun.reserve > 0) this.reloadPress(ctx);\n      return;\n    }\n    this.cool = 1 / def.rate;\n    gun.mag--;\n    this.shotsFired++;\n    // Wear and the jam roll: one per shot, seeded.\n    const wearK = TUNING.wearRate * (this.hasCleaning ? 0.6 : 1);\n    if (def.wear > 0 && !g.dev.noWear) gun.cond = clamp(gun.cond - def.wear * wearK, 0, 100);\n    let jammed = false;\n    if (this.scriptJamAt > 0) { this.scriptShots++; if (this.scriptShots >= this.scriptJamAt) { jammed = true; this.scriptJamAt = 0; this.scriptShots = 0; } }\n    else if (!g.dev.noJams && def.wear > 0 && g.rng.gun.next() < jamChance(gun.cond)) jammed = true;\n    // The shot itself.\n    const eye = g.player.eye, fwd = this.aimDir();\n    const sp = (def.spread * (this.aiming ? 0.3 : 1) * (g.player.moving ? 1.25 : 1)) * (Math.PI / 180);\n    const r = g.rng.gun;\n    if (def.projectile) {\n      const kind = def.projectile;\n      g.projectiles.spawn(kind, eye.x + fwd.x * 0.8, eye.y + fwd.y * 0.8 - 0.08, eye.z + fwd.z * 0.8, fwd.x + r.range(-sp, sp), fwd.y + r.range(-sp, sp) + (kind === 'flare' ? 0.04 : 0), fwd.z + r.range(-sp, sp), 'player');\n    } else {\n      const pellets = def.pellets ?? 1;\n      for (let i = 0; i < pellets; i++) {\n        const dx = fwd.x + r.range(-sp, sp), dy = fwd.y + r.range(-sp, sp), dz = fwd.z + r.range(-sp, sp);\n        const dmg = def.damage * TUNING.weaponDamage;\n        const hit = g.damage.bullet(eye.x, eye.y, eye.z, dx, dy, dz, def.range, dmg, 'player');\n        if (i === 0 && ++this.tracerN % 3 === 0 && hit) g.fx.tracerFromView(hit.x, hit.y, hit.z);\n      }\n    }\n    // Feedback.\n    g.vm.fire();\n    g.sfx.play(def.sound, { volume: 0.8 });\n    g.fx.muzzleFlash(def);\n    g.player.litUntil = g.time + 0.5;\n    ctx.engine.shake.add(clamp(def.kick * 6, 0.03, 0.35));\n    g.cam.kickPitch += def.kick * (this.aiming ? 0.55 : 1) * (1 + r.range(0, 0.3));\n    g.cam.kickYaw += r.range(-1, 1) * def.kick * 0.25;\n    g.rumble(0.3 + def.kick * 6, 0.06);\n    if (gun.cond < 30 && def.wear > 0) g.fx.gunSmoke();\n    g.actors.heardGunshot(eye.x, eye.z, def.hear, 'player');\n    g.events.emit('shot', gun.id);\n    g.hudTouch('ammo');\n    if (jammed) {\n      gun.jam = r.int(2, 4);\n      g.events.emit('jam');\n      g.sfx.play('gun-jam', { volume: 0.7 });\n      g.showJam();\n    }\n    if (def.wear > 0 && gun.cond <= 0) this.fallApart();\n  }\n  fallApart() {\n    const g = this.game;\n    const slot = this.current;\n    g.vm.play('FallApart');\n    g.sfx.play('gun-apart', { volume: 0.9 });\n    g.ledger.note('guns');\n    g.events.emit('gun-apart', this.slots[slot].id);\n    this.lock = 1.4;\n    g.after(1.3, () => {\n      this.slots[slot] = null;\n      if (this.current === slot) { this.current = 'melee'; g.vm.showGun('cane', true); }\n    });\n  }\n  flameStop() { if (this.flameOn) { this.flameOn = false; this.game.sfx.stopLoop('flamer'); } }\n  streamStep(ctx, dt, wants) {\n    const g = this.game, gun = this.gun, def = this.def;\n    if (!wants || gun.mag <= 0) { this.flameStop(); if (wants && gun.mag <= 0) { if (gun.reserve > 0) this.reloadPress(ctx); else if (g.tick % 40 === 0) g.sfx.play('gun-jam', { volume: 0.4 }); } return; }\n    if (!this.flameOn) { this.flameOn = true; g.sfx.play('flamer-start', { volume: 0.7 }); g.sfx.startLoop('flamer', 'flamer-loop', { volume: 0.7 }); }\n    gun.mag = Math.max(0, gun.mag - 30 * dt);\n    if (!g.dev.noWear) gun.cond = clamp(gun.cond - def.wear * 30 * dt * TUNING.wearRate * (this.hasCleaning ? 0.6 : 1), 0, 100);\n    const eye = g.player.eye, fwd = this.aimDir();\n    // Lights everything in its cone.\n    const reach = def.range;\n    this.flameT -= dt;\n    if (this.flameT <= 0) {\n      this.flameT = 0.1;\n      const t = g.rng.gun.range(0.35, 1) * reach;\n      g.fire.ignite(eye.x + fwd.x * t, eye.z + fwd.z * t, 2.5, 'player');\n      for (const s of g.actors.soldiers) {\n        if (!s.active || s.dead) continue;\n        const dx = s.x - eye.x, dz = s.z - eye.z, d = Math.hypot(dx, dz);\n        if (d < reach && (dx * fwd.x + dz * fwd.z) / (d || 1) > 0.9) { s.hurt(def.damage * TUNING.weaponDamage * 0.1, 'player', fwd, 'body', {}); if (d < reach * 0.7) s.ignite(); }\n      }\n      for (const v of g.vehicles.list) { if (v.alive && Math.hypot(v.x - eye.x, v.z - eye.z) < reach) { const dx = v.x - eye.x, dz = v.z - eye.z, d = Math.hypot(dx, dz) || 1; if ((dx * fwd.x + dz * fwd.z) / d > 0.9) v.hurt(1.2, 'fire'); } }\n      for (const ex of g.world.explosives) { if (ex.alive && Math.hypot(ex.x - eye.x, ex.z - eye.z) < reach) { const dx = ex.x - eye.x, dz = ex.z - eye.z, d = Math.hypot(dx, dz) || 1; if ((dx * fwd.x + dz * fwd.z) / d > 0.9) { ex.hp -= 4; if (ex.hp <= 0) g.damage.explode(ex, 'fire', 'player'); } } }\n      g.actors.heardGunshot(eye.x, eye.z, def.hear, 'player');\n    }\n    g.player.litUntil = g.time + 0.5;\n    g.fx.flamerStream(eye, fwd);\n    // Below 20 it can leak and light you.\n    if (gun.cond < 20 && !g.dev.noJams && g.rng.gun.chance(dt * 0.25)) { g.body.catchFire(); g.say('', 'IT LEAKS.', 1.6); }\n    if (gun.cond <= 0) { this.flameStop(); this.fallApart(); }\n    g.vm.flame = 1;\n  }\n  swing(ctx) {\n    const g = this.game, eye = g.player.eye, fwd = this.aimDir();\n    if (this.cool > 0) return;\n    this.cool = 1 / 1.6; this.lock = 0.28;\n    g.vm.showGun('cane', false);\n    g.vm.play('Swing');\n    g.sfx.play('knife-swing', { volume: 0.6 });\n    g.after(0.13, () => {\n      const hit = g.damage.bullet(eye.x, eye.y, eye.z, fwd.x, fwd.y, fwd.z, 2.2, 0, 'player', { melee: true, silent: true });\n      const ent = hit?.ent;\n      if (ent?.kind === 'soldier' && !ent.ref.dead) {\n        const s = ent.ref;\n        const behind = s.fromBehind(eye.x, eye.z);\n        s.hurt((behind ? 999 : 55) * TUNING.weaponDamage, 'player', fwd, behind ? 'stealth' : 'body', {});\n        g.sfx.play('hit-flesh', { volume: 0.8 });\n        g.events.emit('melee', s, behind);\n      } else if (ent?.kind === 'merc') { g.round?.hitMerc(ent.ref, 55 * TUNING.weaponDamage, {}, 'player'); }\n      else if (hit) g.sfx.play('hit-metal', { volume: 0.25 });\n    });\n    if (this.current !== 'melee') g.after(0.55, () => g.vm.showGun(this.gun?.id ?? 'cane', false));\n  }\n  throwing(ctx, dt) {\n    const g = this.game, a = g.actions;\n    const down = a.down('throw');\n    if (down) {\n      this.plantHold += dt;\n      if (this.plantHold > 0.7 && !this.planted && this.charges > 0 && this.placed.length < 2) {\n        this.planted = true;\n        this.plant(ctx);\n      }\n    } else if (this.plantHold > 0) {\n      const short = this.plantHold <= 0.7;\n      this.plantHold = 0; this.planted = false;\n      a.take('throw');\n      if (short && this.lock <= 0) {\n        if (this.placed.length) this.detonate(ctx);\n        else if (this.bottles > 0) this.throwBottle(ctx);\n        else if (this.charges > 0) g.notice('HOLD TO PLANT', 1.5);\n      }\n    }\n  }\n  throwBottle(ctx) {\n    const g = this.game, eye = g.player.eye, fwd = this.aimDir();\n    this.bottles--;\n    this.lock = 0.55;\n    g.vm.showProp('p-bottle'); g.vm.play('Throw');\n    g.sfx.play('whoosh', { volume: 0.4 });\n    g.after(0.28, () => g.projectiles.spawn('bottle', eye.x + fwd.x, eye.y + fwd.y, eye.z + fwd.z, fwd.x, fwd.y + 0.22, fwd.z, 'player'));\n    g.after(0.65, () => g.vm.showGun(this.gun?.id ?? 'cane', false));\n    g.events.emit('throw');\n  }\n  plant(ctx) {\n    const g = this.game, f = g.player.feet, fwd = this.aimDir();\n    this.charges--;\n    this.lock = 1.3;\n    g.vm.showProp('p-charge'); g.vm.play('Plant');\n    g.sfx.play('gun-mag', { volume: 0.5 });\n    g.player.frozen = true;\n    g.after(1.2, () => {\n      g.player.frozen = false;\n      const x = f.x + fwd.x * 0.9, z = f.z + fwd.z * 0.9, y = g.world.heightAt(x, z);\n      const obj = g.fx.chargeProp(x, y, z);\n      this.placed.push({ x, y, z, obj });\n      g.vm.showGun(this.gun?.id ?? 'cane', false);\n      g.events.emit('planted', x, z);\n    });\n  }\n  detonate(ctx) {\n    const g = this.game;\n    g.vm.showProp('p-det'); g.vm.play('Detonate');\n    g.sfx.play('gun-jam', { volume: 0.8, pitch: -6 });\n    this.lock = 0.4;\n    const list = this.placed; this.placed = [];\n    g.after(0.2, () => {\n      for (const c of list) {\n        g.fx.removeProp(c.obj);\n        g.damage.blast(c.x, c.y + 0.4, c.z, THROWN.charge.blast, THROWN.charge.damage, 'player', { fire: 6 });\n      }\n      g.events.emit('detonated', list);\n    });\n    g.after(0.6, () => g.vm.showGun(this.gun?.id ?? 'cane', false));\n  }\n  /** The technical's gun and the flatcar's: no ammunition, overheats at 6 s, cools in 4 s. */\n  mountedStep(ctx, dt) {\n    const g = this.game, a = g.actions, def = WEAPONS.mg, m = this.mounted;\n    const wants = a.down('fire');\n    if (this.overheated) { this.heat -= dt / def.cool; if (this.heat <= 0) { this.heat = 0; this.overheated = false; } }\n    else if (wants && this.cool <= 0) {\n      this.cool = 1 / def.rate;\n      this.heat += (1 / def.rate) / def.overheat;\n      if (this.heat >= 1) { this.heat = 1; this.overheated = true; g.sfx.play('gun-jam', { volume: 0.6 }); g.notice('TOO HOT', 1.2); }\n      const eye = g.player.eye, fwd = this.aimDir(), r = g.rng.gun, sp = (def.spread * Math.PI) / 180;\n      const hit = g.damage.bullet(eye.x + fwd.x * 1.4, eye.y + fwd.y * 1.4, eye.z + fwd.z * 1.4, fwd.x + r.range(-sp, sp), fwd.y + r.range(-sp, sp), fwd.z + r.range(-sp, sp), def.range, def.damage * TUNING.weaponDamage, 'player');\n      if (hit && ++this.tracerN % 3 === 0) { g.fx.tracerFromView(hit.x, hit.y, hit.z); if (g.rng.gun.chance(0.08)) g.fire.ignite(hit.x, hit.z, 1, 'player'); }\n      g.sfx.play(def.sound, { volume: 0.7 });\n      g.fx.muzzleFlash(def);\n      ctx.engine.shake.add(0.07);\n      g.cam.kickPitch += def.kick; g.cam.kickYaw += r.range(-1, 1) * def.kick * 0.4;\n      g.rumble(0.35, 0.05);\n      g.actors.heardGunshot(eye.x, eye.z, def.hear, 'player');\n      g.player.litUntil = g.time + 0.5;\n      m.turret?.();\n      g.events.emit('shot', 'mg');\n    } else if (!wants) this.heat = Math.max(0, this.heat - dt / def.cool);\n  }\n  /** What's on the HUD: the small gun icon goes white, orange, red. */\n  condColor() {\n    const c = this.gun?.cond ?? 100;\n    return c >= 60 ? 'white' : c >= 30 ? 'orange' : 'red';\n  }\n  resetLoadout() {\n    this.slots = { melee: { id: 'cane', cond: 100, mag: 0, reserve: 0, jam: 0 }, sidearm: null, main: null, special: null };\n    this.current = 'melee'; this.bottles = 0; this.charges = 0; this.placed = []; this.hasCleaning = false; this.hasBelt = false; this.mounted = null; this.heat = 0; this.reloading = 0; this.lock = 0; this.scriptJamAt = 0; this.scriptShots = 0; this.flameStop();\n  }\n  snapshot() { return { slots: JSON.parse(JSON.stringify(this.slots)), current: this.current, bottles: this.bottles, charges: this.charges, hasCleaning: this.hasCleaning, hasBelt: this.hasBelt }; }\n  restoreData(d) { this.slots = d.slots; this.current = d.current; this.bottles = d.bottles; this.charges = d.charges; this.hasCleaning = d.hasCleaning; this.hasBelt = d.hasBelt; }\n}\nEOF\ncat > src/combat/viewmodel.js <<'EOF'\n// The hands and what they hold: one model on a custom rig, parented to the camera, played with the engine's clips.\nimport { THREE, buildModel, compileClips, setLookLayer, toonMaterial, PALETTE } from '../../pixel-engine.js';\nimport { handsDef, HANDS_CLIPS, HANDS_RIG, GUN_PARTS } from '../art/viewmodels.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { clamp, lerp } from '../core/rng.js';\nconst { AnimationMixer, LoopOnce, LoopRepeat, Group, Vector3, Euler } = THREE;\nconst PROPS = ['p-syrette', 'p-pliers', 'p-bullet', 'p-knife', 'p-lighter', 'p-flame', 'p-wrench', 'p-bottle', 'p-charge', 'p-det', 'p-tablet', 'p-finish', 'p-trk', 'led-off', 'led-on', 'p-mono', 'p-pill', 'w-arm', 'w-burn', 'w-thigh'];\nconst HOLD = { rifle: 'HoldRifle', pistol: 'HoldPistol', tube: 'HoldTube', melee: 'HoldMelee', none: 'HoldNone' };\nexport class ViewModel {\n  gunId = null; holdName = 'HoldNone'; action = null; actionName = ''; kick = 0; kickRot = 0; adsT = 0; flash = 0; propsOn = new Set(); flame = 0; playCounts = {};\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const b = buildModel(handsDef);\n    this.root = b.object;\n    this.group = new Group();\n    this.group.add(this.root);\n    setLookLayer(this.group, 'actors');\n    this.root.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.receiveShadow = false; o.frustumCulled = false; } });\n    ctx.scene.add(ctx.camera.camera);\n    ctx.camera.camera.add(this.group);\n    this.named = {};\n    this.root.traverse((o) => { if (o.name) this.named[o.name] = o; });\n    this.clips = {};\n    for (const c of compileClips(HANDS_CLIPS, HANDS_RIG, this.root)) this.clips[c.name] = c;\n    this.mixer = new AnimationMixer(this.root);\n    this.actions = {};\n    for (const [name, clip] of Object.entries(this.clips)) { const a = this.mixer.clipAction(clip); this.actions[name] = a; }\n    this.hold(this.holdName, 0);\n    this.hideAll();\n    // The map: DataTexture plane, drawn by world/map-texture.js, under MapJ.\n    this.mapJoint = this.named.MapJ;\n    this.named.Leg.visible = false; this.mapJoint.visible = false;\n    for (const p of PROPS) if (this.named[p]) this.named[p].visible = false;\n  }\n  attach(cam) { cam.add(this.group); }\n  hideAll() {\n    for (const id of Object.keys(GUN_PARTS)) for (const pre of ['g-', 'rust-', 'tape-', 'm-', 'b-']) { const n = this.named[`${pre}${id}`]; if (n) n.visible = false; }\n    for (const p of this.propsOn) if (this.named[p]) this.named[p].visible = false;\n    this.propsOn.clear();\n  }\n  setVisible(v) { this.group.visible = v; }\n  showGun(id, withEquip) {\n    this.hideAll();\n    this.gunId = id;\n    if (!id) { this.hold('HoldNone', 0.15); return; }\n    for (const pre of ['g-', 'm-', 'b-']) { const n = this.named[`${pre}${id}`]; if (n) n.visible = true; }\n    const def = WEAPONS[id];\n    this.hold(HOLD[def?.cls ?? 'rifle'] ?? 'HoldRifle', 0.12);\n    if (withEquip) this.play('Equip');\n    this.updateWear(true);\n  }\n  showProp(...names) {\n    this.hideAll();\n    this.gunId = null;\n    for (const p of names) { if (this.named[p]) { this.named[p].visible = true; this.propsOn.add(p); } }\n  }\n  /** Rust and tape parts follow the condition of the gun: the only condition readout that counts. */\n  updateWear(force) {\n    const id = this.gunId; if (!id) return;\n    const cond = this.game.weapons.gun?.cond ?? 100;\n    const r = this.named[`rust-${id}`], t = this.named[`tape-${id}`];\n    if (r) r.visible = cond < 60; if (t) t.visible = cond < 30;\n  }\n  hold(name, fade = 0.2) {\n    const next = this.actions[name];\n    if (!next) return;\n    if (this.holdName === name && next.isRunning()) return;\n    const prev = this.actions[this.holdName];\n    next.reset().setLoop(LoopRepeat).play();\n    if (prev && prev !== next) { if (this.action) { prev.stop(); next.setEffectiveWeight(this.action ? 0 : 1); } else prev.crossFadeTo(next, fade, false); }\n    this.holdName = name;\n  }\n  /** A one-shot over the hold. Back to the hold when it ends. */\n  play(name, { speed = 1, fade = 0.06, keep = false, onEnd } = {}) {\n    const a = this.actions[name];\n    if (!a) return 0;\n    this.playCounts[name] = (this.playCounts[name] ?? 0) + 1;\n    const cur = this.action ?? this.actions[this.holdName];\n    a.reset();\n    const loop = this.clips[name].tracks.length && /(MapHold|TrackerUp|Wrench|Open)$/.test(name);\n    a.setLoop(loop ? LoopRepeat : LoopOnce, Infinity);\n    a.clampWhenFinished = true;\n    a.timeScale = speed;\n    a.setEffectiveWeight(1);\n    a.play();\n    if (cur && cur !== a) { cur.crossFadeTo(a, fade, false); }\n    this.action = a; this.actionName = name; this.keepAction = keep; this.onEnd = onEnd ?? null;\n    return this.clips[name].duration / speed;\n  }\n  endAction(fade = 0.15) {\n    const a = this.action; if (!a) return;\n    const h = this.actions[this.holdName];\n    h.enabled = true; h.setEffectiveWeight(1); h.play();\n    a.crossFadeTo(h, fade, false);\n    this.action = null; this.actionName = ''; this.keepAction = false;\n    const f = this.onEnd; this.onEnd = null;\n    f?.();\n  }\n  fire() {\n    this.kick = 1; this.flash = 1;\n    const id = this.gunId;\n    if (id === 'mule' || id === 'empire') this.pumpAfter = 0.32;\n  }\n  update(ctx, dt, realDt) {\n    const g = this.game;\n    this.mixer.update(dt);\n    if (this.action && !this.keepAction) {\n      const a = this.action;\n      if (a.loop !== LoopRepeat && (!a.isRunning() || a.time >= this.clips[this.actionName].duration - 1e-3)) this.endAction();\n    }\n    if (this.pumpAfter > 0) { this.pumpAfter -= dt; if (this.pumpAfter <= 0 && !this.action) { this.play(this.gunId === 'empire' ? 'UnjamPistol' : 'UnjamRifle', { speed: 1.6 }); g.sfx.play('gun-rack', { volume: 0.45 }); } }\n    // Procedural over the mixer: bob, sway, kick, ADS, fever swim.\n    const p = g.player;\n    const t = g.time;\n    const a = g.weapons.aimT;\n    const bx = Math.cos(p.bob) * 0.012 * p.bobAmp * (1 - a * 0.85), by = Math.abs(Math.sin(p.bob)) * 0.014 * p.bobAmp * (1 - a * 0.85);\n    const swayX = Math.sin(t * 0.8) * 0.003, swayY = Math.sin(t * 1.3) * 0.003;\n    const md = ctx.input.mouseDelta;\n    this.lagX = lerp(this.lagX ?? 0, clamp(-md.x * 0.0004, -0.025, 0.025), 1 - Math.exp(-dt * 12));\n    this.lagY = lerp(this.lagY ?? 0, clamp(md.y * 0.0004, -0.02, 0.02), 1 - Math.exp(-dt * 12));\n    this.kick = lerp(this.kick, 0, 1 - Math.exp(-dt * 16));\n    this.flash = Math.max(0, this.flash - dt * 12);\n    const def = WEAPONS[this.gunId] ?? {};\n    const hardness = def.kick ? clamp(def.kick * 30, 0.2, 1.4) : 0;\n    // ADS: bring the weapon to centre. Rest is x 0.16, y -0.15; centre is x 0, y a little under the eye.\n    const adsX = -0.16 * a, adsY = (def.scoped ? 0.0 : 0.07) * a, adsZ = 0.12 * a;\n    const fever = g.body.swim ?? 0;\n    this.group.position.set(bx + swayX + this.lagX + adsX + Math.sin(t * 1.7) * 0.02 * fever, -by + swayY + this.lagY + adsY + Math.sin(t * 1.1) * 0.016 * fever - p.landDip * 0.6, this.kick * 0.05 * hardness + adsZ);\n    this.group.rotation.set(this.kick * 0.09 * hardness, 0, Math.sin(t * 0.9) * 0.012 * fever);\n    if (def.scoped && a > 0.6) this.root.visible = false; else this.root.visible = true;\n    this.updateWear();\n  }\n}\nEOF\ncat > src/combat/fx.js <<'EOF'\n// Feedback: impacts, tracers, flashes, marks. Pure presentation, driven by the sim's events; safe with no views.\nimport { THREE, Decals, Trail, glowMaterial, PALETTE, buildModel, setLookLayer } from '../../pixel-engine.js';\nimport { MODELS } from '../art/models.js';\nimport { clamp } from '../core/rng.js';\nconst { Vector3, Mesh, BoxGeometry, Group } = THREE;\nconst _n = new Vector3();\nexport class Fx {\n  tracers = []; markerT = 0; markerHead = false; pool = [];\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const p = ctx.particles;\n    p.register('blood', { count: [6, 12], life: [0.25, 0.6], speed: [1.5, 4], spread: 50, gravity: 12, size: [1, 1], colors: ['red', 'red', 'plum'], max: 300 });\n    p.register('dirt-hit', { count: [4, 8], life: [0.2, 0.5], speed: [1.5, 3.5], spread: 40, gravity: 10, size: [1, 1], colors: ['sand', 'orange', 'plum'], max: 200 });\n    p.register('spark', { count: [4, 8], life: [0.1, 0.3], speed: [3, 7], spread: 60, gravity: 10, size: [1, 1], colors: ['white', 'sand', 'orange'], max: 300 });\n    p.register('blast', { count: [24, 36], life: [0.4, 0.9], speed: [5, 14], spread: 180, gravity: 4, drag: 2, size: [3, 1], colors: ['white', 'sand', 'orange', 'red', 'night'], max: 300 });\n    p.register('gun-smoke', { count: [1, 2], life: [0.4, 0.8], speed: [0.3, 0.8], direction: [0, 1, 0], spread: 30, gravity: -0.4, size: [1, 2], colors: ['mist', 'slate'], max: 80 });\n    p.register('flame-jet', { count: [2, 3], life: [0.12, 0.3], speed: [10, 16], spread: 7, gravity: -2, size: [3, 1], colors: ['white', 'sand', 'orange', 'red'], max: 300 });\n    p.register('vehicle-smoke', { count: [1, 2], life: [0.8, 1.6], speed: [1, 2], direction: [0, 1, 0], spread: 16, gravity: -1, size: [2, 5], colors: ['night', 'slate', 'mist'], max: 200 });\n    p.register('vehicle-flame', { count: [1, 3], life: [0.2, 0.5], speed: [1.5, 3], direction: [0, 1, 0], spread: 20, gravity: -3, size: [2, 1], colors: ['white', 'sand', 'orange', 'red'], max: 200 });\n    p.register('dust-wind', { count: [2, 3], life: [1, 2.2], speed: [3, 7], direction: [1, 0.05, 0], spread: 10, size: [1, 2], colors: ['sand', 'orange'], radius: 22, max: 300 });\n    p.register('wrench-spark', { count: [3, 5], life: [0.1, 0.25], speed: [2, 4], spread: 70, gravity: 10, size: [1, 1], colors: ['white', 'sand'], max: 80 });\n    if (this.game.views) this.decals = new Decals(ctx.scene, { capacity: 96 });\n    this.tracerMat = glowMaterial(PALETTE.sand);\n  }\n  impact(x, y, z, normal, kind, opts = {}) {\n    const g = this.game;\n    const name = kind === 'flesh' ? 'blood' : kind === 'metal' ? 'spark' : 'dirt-hit';\n    if (!opts.silent) {\n      g.ctx.particles.burst(name, [x, y, z], { direction: [normal?.x ?? 0, normal?.y ?? 1, normal?.z ?? 0] });\n      const d = Math.hypot(x - g.camPos.x, z - g.camPos.z);\n      if (kind === 'flesh') g.sfx.at('hit-flesh', x, z, { max: 40, volume: 0.6 });\n      else if (kind === 'metal') g.sfx.at('hit-metal', x, z, { max: 50, volume: 0.6 });\n      else if (d < 30 && g.rng.fx.chance(0.2)) g.sfx.at('ricochet', x, z, { max: 40, volume: 0.45 });\n    }\n    if (kind === 'flesh') g.ctx.engine.hitstop(0.02);\n    if (kind === 'dirt' && this.decals && normal) this.decals.add('crack', { x, y, z }, normal, { size: 0.25 });\n  }\n  tracerFromView(x, y, z) {\n    const eye = this.game.player.eye;\n    this.tracer(eye.x, eye.y - 0.12, eye.z, x, y, z);\n  }\n  tracer(ax, ay, az, bx, by, bz) {\n    if (!this.game.views) return;\n    const l = Math.hypot(bx - ax, by - ay, bz - az);\n    const m = this.pool.pop() ?? new Mesh(new BoxGeometry(0.035, 0.035, 1), this.tracerMat);\n    m.scale.z = Math.min(l, 8);\n    m.position.set(ax, ay, az);\n    m.lookAt(bx, by, bz);\n    this.game.ctx.scene.add(m);\n    this.tracers.push({ m, ax, ay, az, dx: (bx - ax) / l, dy: (by - ay) / l, dz: (bz - az) / l, l, t: 0, speed: 240 });\n  }\n  hitMarker(head) { this.markerT = 0.16; this.markerHead = head; this.game.sfx.play('hit-marker', { volume: 0.3 }); this.game.rumble(0.25, 0.04); }\n  muzzleFlash(def) {\n    const g = this.game;\n    if (!g.views) return;\n    const e = g.player.eye;\n    g.ctx.lights.request({ position: [e.x, e.y, e.z], color: 0xffd090, intensity: 18, radius: 14, lifetime: 0.06, fadeIn: 0, fadeOut: 0.05 });\n    g.hud.muzzle = 0.05;\n    const m = g.vm.named?.flash;\n    if (m) m.visible = true;\n  }\n  gunSmoke() { const g = this.game, e = g.player.eye, f = g.player.forward(_n); g.ctx.particles.burst('gun-smoke', [e.x + f.x * 0.7, e.y - 0.1 + f.y * 0.7, e.z + f.z * 0.7]); }\n  flamerStream(eye, fwd) {\n    const g = this.game;\n    g.ctx.particles.burst('flame-jet', [eye.x + fwd.x * 0.9, eye.y + fwd.y * 0.9 - 0.14, eye.z + fwd.z * 0.9], { direction: [fwd.x, fwd.y + 0.02, fwd.z] });\n    if (g.views && !this.flameLight?.alive) this.flameLight = g.ctx.lights.request({ position: [eye.x, eye.y, eye.z], color: 0xff7a30, intensity: 18, radius: 22, lifetime: 0.25, flicker: 'torch' });\n    else if (this.flameLight) { this.flameLight.lifetime = 0.25; this.flameLight.position.set(eye.x + fwd.x * 4, eye.y, eye.z + fwd.z * 4); }\n  }\n  explosion(x, y, z, r) {\n    const g = this.game, ctx = g.ctx;\n    ctx.particles.burst('blast', [x, y, z], { count: Math.round(clamp(r * 6, 18, 60)) });\n    ctx.particles.burst('fire-smoke', [x, y, z], { count: Math.round(clamp(r * 3, 8, 28)) });\n    if (g.views) {\n      ctx.lights.request({ position: [x, y + 2, z], color: 0xffa040, intensity: clamp(r * 8, 20, 60), radius: r * 5, lifetime: 0.35, fadeIn: 0 });\n      ctx.engine.screen.shockwave([x, y, z], { radius: clamp(r * 0.03, 0.15, 0.5) });\n      if (!g.settings.reduceFlashes && Math.hypot(x - g.camPos.x, z - g.camPos.z) < r * 6) ctx.engine.screen.flash('white', { duration: 0.08 });\n    }\n    g.sfx.at(r > 8 ? 'explosion-big' : 'explosion', x, z, { max: r > 8 ? 500 : 300, volume: 1 });\n    g.rumble(0.8, 0.25);\n  }\n  scorch(x, y, z, r) { if (this.decals) this.decals.add('scorch', { x, y: y + 0.05, z }, { x: 0, y: 1, z: 0 }, { size: r }); }\n  chargeProp(x, y, z) {\n    const g = this.game;\n    if (!g.views) return null;\n    const m = new Mesh(new BoxGeometry(0.34, 0.14, 0.24), glowMaterial(PALETTE.plum));\n    m.position.set(x, y + 0.07, z);\n    g.ctx.scene.add(m);\n    return m;\n  }\n  removeProp(o) { if (o) this.game.ctx.scene.remove(o); }\n  update(ctx, dt) {\n    this.markerT = Math.max(0, this.markerT - dt);\n    for (let i = this.tracers.length - 1; i >= 0; i--) {\n      const t = this.tracers[i];\n      t.t += dt * t.speed;\n      if (t.t >= t.l) { ctx.scene.remove(t.m); this.pool.push(t.m); this.tracers.splice(i, 1); continue; }\n      t.m.position.set(t.ax + t.dx * t.t, t.ay + t.dy * t.t, t.az + t.dz * t.t);\n    }\n    this.decals?.update(dt);\n  }\n}\nEOF\ncat > src/body/health.js <<'EOF'\n// Your body: five segments, syrettes, four field surgeries, burning, going down, and blackwater fever on a timetable.\nimport { THREE } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp, lerp } from '../core/rng.js';\nconst SURGERIES = [\n  { clip: 'Surgery1', props: ['p-pliers', 'w-arm'], extra: 'p-bullet', sounds: [[0.8, 'pliers'], [1.6, 'grunt'], [2.1, 'pliers'], [2.7, 'grunt-big']], blood: [2.8] , line: 'PLIERS.' },\n  { clip: 'Surgery2', props: ['p-knife', 'w-thigh'], leg: true, sounds: [[1, 'knife-dig'], [1.8, 'grunt'], [2.3, 'knife-dig'], [2.9, 'grunt-big']], blood: [1.3, 2.5], line: 'THERE IS METAL IN THE THIGH.' },\n  { clip: 'Surgery3', props: [], sounds: [[2.1, 'finger-snap'], [2.2, 'grunt-big']], blood: [], line: 'THE FINGER GOES BACK.' },\n  { clip: 'Surgery4', props: ['p-lighter', 'p-flame', 'w-burn'], sounds: [[0.6, 'lighter'], [1.4, 'cauterise'], [2.1, 'grunt'], [2.8, 'grunt-big']], blood: [], line: 'SKIN IS ONLY A SUGGESTION.' },\n];\nconst FEVER_LINES = ['THE FEVER.', 'THE FEVER AGAIN.', 'THE GROUND MOVES. IT IS NOT THE GROUND.', 'THE TIMETABLE RUNS ON TIME.', 'YOU ARE LATE ALREADY.'];\nexport class Body {\n  hp = 100; syrettes = 3; maxSyrettes = 3; tablets = 0; lastHit = -99; burning = 0; burnClear = 0; heartT = 0; syretteT = 0; syretteLock = 0; surgery = null; surgeryT = 0; surgeryIndex = 0; lastDamage = 'bullet'; dead = false; swim = 0;\n  fever = 'none'; feverIn = 0; feverT = 0; feverAct = 1; feverOn = false; tabletHold = 0; clearT = 0; feverLineN = 0; heartVoice = null; colorDrain = 0; downT = 0; healHold = 0; heartbeatT = 0; burnScreen = 0; hurtFlash = 0; lastDir = 0;\n  constructor(game) { this.game = game; }\n  get segments() { return Math.ceil(this.hp / 20); }\n  moveFactor() { return this.surgery ? 0 : (this.feverOn ? 0.82 : 1); }\n  resetAll() {\n    this.hp = 100; this.syrettes = 3; this.maxSyrettes = 3; this.tablets = 0; this.burning = 0; this.surgery = null; this.dead = false; this.fever = 'none'; this.feverOn = false; this.swim = 0; this.feverIn = 0; this.feverAct = 1; this.colorDrain = 0; this.hurtFlash = 0; this.burnScreen = 0; this.lastHit = -99;\n  }\n  scheduleFever() {\n    const r = this.game.rng.fever;\n    const shrink = this.feverAct - 1;\n    this.feverIn = Math.max(1, TUNING.feverMinutes - shrink + r.range(-2, 2)) * 60;\n  }\n  hurt(amount, kind = 'bullet', from, opts) {\n    const g = this.game;\n    if (g.dev.god || this.dead || g.player.seat?.invuln) return;\n    const a = amount * TUNING.playerDamageTaken;\n    if (a <= 0) return;\n    this.hp = Math.max(0, this.hp - a);\n    this.lastHit = g.time;\n    this.lastDamage = kind;\n    this.hurtFlash = 1;\n    if (from) { const dx = from[0] - g.player.feet.x, dz = from[1] - g.player.feet.z; this.lastDir = Math.atan2(dx, dz); this.dirFlash = 1; }\n    g.sfx.play(kind === 'fire' ? 'grunt' : 'grunt', { volume: 0.5, pitch: g.rng.fx.range(-2, 2) });\n    g.ctx.engine.shake.add(clamp(a * 0.02, 0.05, 0.4));\n    g.rumble(0.5, 0.1);\n    g.hudTouch('health');\n    if (this.surgery && kind !== 'fire') this.interruptSurgery();\n    if (this.hp <= 0) this.down();\n  }\n  catchFire() {\n    if (this.game.dev.god) return;\n    if (this.burning <= 0) { this.game.sfx.play('grunt-big', { volume: 0.6 }); this.game.events.emit('player-burning'); }\n    this.burning = 1; this.burnClear = 0;\n  }\n  useSyrette() {\n    const g = this.game;\n    if (this.syrettes <= 0 || this.syretteT > 0 || this.surgery) return false;\n    this.syretteT = 0.8;\n    g.vm.showProp('p-syrette');\n    g.vm.named.Leg.visible = true;\n    g.vm.play('Syrette', { onEnd: () => { g.vm.named.Leg.visible = false; g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); } });\n    g.sfx.play('syrette', { volume: 0.7 });\n    return true;\n  }\n  startSurgery() {\n    const g = this.game;\n    if (this.surgery || this.dead) return false;\n    let which = this.surgeryIndex++ % 3;\n    if (this.lastDamage === 'fire') which = 3;\n    const s = SURGERIES[which];\n    this.surgery = s; this.surgeryT = 0; this.surgeryKind = which;\n    this.surgerySounds = [...s.sounds]; this.surgeryBlood = [...s.blood];\n    g.vm.showProp(...s.props);\n    if (s.leg) g.vm.named.Leg.visible = true;\n    const dur = g.vm.play(s.clip, { keep: true });\n    this.surgeryDur = dur;\n    g.events.emit('surgery', which);\n    g.say('', s.line, 2.2);\n    return true;\n  }\n  interruptSurgery() {\n    const g = this.game;\n    this.surgery = null;\n    g.vm.named.Leg.visible = false;\n    g.vm.endAction();\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    g.notice('INTERRUPTED', 1.2);\n  }\n  finishSurgery() {\n    const g = this.game;\n    this.surgery = null;\n    this.hp = Math.max(this.hp, 40);\n    g.vm.named.Leg.visible = false;\n    g.vm.endAction();\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    g.hudTouch('health');\n    g.events.emit('surgery-done');\n  }\n  down() {\n    const g = this.game;\n    if (this.dead) return;\n    this.interruptIfAny();\n    g.events.emit('player-down');\n    if (g.round) { g.round.localDown(); return; }\n    const buddy = g.actors.rescuer();\n    if (buddy) g.actors.startRescue(buddy);\n    else { this.dead = true; g.gameOver(); }\n  }\n  interruptIfAny() { if (this.surgery) this.interruptSurgery(); }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions;\n    const time = g.time;\n    // Regeneration only to the top of the current segment, 5 s after damage.\n    if (time - this.lastHit > 5 && this.hp > 0 && !this.burning) {\n      const top = Math.min(100, Math.ceil(this.hp / 20) * 20);\n      if (this.hp < top) this.hp = Math.min(top, this.hp + dt * 6);\n    }\n    // Burning.\n    if (this.burning > 0) {\n      const onFuel = g.fire.state[g.fire.idOf(g.player.feet.x, g.player.feet.z)] === 1;\n      if (!onFuel) this.burnClear += dt; else this.burnClear = 0;\n      if (g.player.wading || this.burnClear >= 2) this.burning = 0;\n      else this.hurt(TUNING.fireDamage * dt, 'fire');\n      this.burnScreen = 1;\n    } else this.burnScreen = Math.max(0, this.burnScreen - dt * 2);\n    this.hurtFlash = Math.max(0, this.hurtFlash - dt * 3);\n    if (this.dirFlash > 0) this.dirFlash -= dt * 1.4;\n    // Syrette and surgery.\n    if (this.syretteT > 0) {\n      this.syretteT -= dt;\n      if (this.syretteT <= 0) { this.syrettes--; this.hp = Math.min(100, this.hp + 40); g.hudTouch('health'); g.events.emit('syrette'); }\n    }\n    if (g.canAct() && !g.mapUp) {\n      if (a.take('heal')) {\n        if (this.hp < 20) this.startSurgery();\n        else if (this.syrettes > 0 && this.hp < 100) this.useSyrette();\n        else if (this.syrettes <= 0) { g.notice('NO SYRETTES', 1.2); }\n      }\n    }\n    if (this.surgery) {\n      this.surgeryT += dt;\n      while (this.surgerySounds.length && this.surgerySounds[0][0] <= this.surgeryT) { const [, s] = this.surgerySounds.shift(); g.sfx.play(s, { volume: 0.8 }); }\n      while (this.surgeryBlood.length && this.surgeryBlood[0] <= this.surgeryT) { this.surgeryBlood.shift(); const e = g.player.eye, f = g.player.forward(); ctx.particles.burst('blood', [e.x + f.x * 0.45, e.y + f.y * 0.45 - 0.05, e.z + f.z * 0.45], { count: 18, direction: [0, 0.3, 0] }); }\n      if (this.surgery.extra && this.surgeryT > 2.8) g.vm.named[this.surgery.extra].visible = true;\n      if (this.surgeryT >= this.surgeryDur) this.finishSurgery();\n    }\n    // Heartbeat below 20.\n    const low = this.hp < 20 && this.hp > 0;\n    this.colorDrain = lerp(this.colorDrain, low ? 1 : 0, 1 - Math.exp(-dt * 3));\n    if (low) { this.heartbeatT -= dt; if (this.heartbeatT <= 0) { this.heartbeatT = 0.8; g.sfx.play('heartbeat', { volume: 0.8 }); g.rumble(0.3, 0.05); } }\n    this.feverStep(ctx, dt);\n  }\n  feverStep(ctx, dt) {\n    const g = this.game, a = g.actions;\n    if (g.round || g.dev.noFever) { if (this.feverOn) this.clearFever(); return; }\n    if (!g.story.feverRunning) return;\n    if (this.fever === 'none') {\n      if (!g.actors.scriptedFeverHold) this.feverIn -= dt;\n      if (this.feverIn <= 0) this.startFever();\n    } else if (this.fever === 'on') {\n      this.feverT += dt;\n      this.swim = lerp(this.swim, g.settings.feverReduced ? 0.4 : 1, 1 - Math.exp(-dt * 1.2));\n      this.heartbeatT -= dt;\n      if (this.heartbeatT <= 0) { this.heartbeatT = 0.9; g.sfx.play('heartbeat', { volume: 0.6 }); }\n      // Tablet: hold 1 s.\n      if (g.canAct() && a.down('tablet') && this.tablets > 0) {\n        if (this.tabletHold === 0) { g.vm.showProp('p-tablet', 'p-pill'); g.vm.play('Tablet', { onEnd: () => g.vm.showGun(g.weapons.gun?.id ?? 'cane', false) }); g.sfx.play('tablet-bottle', { volume: 0.6 }); }\n        this.tabletHold += dt;\n        if (this.tabletHold >= 1) { this.tablets--; this.tabletHold = 0; this.fever = 'clearing'; this.clearT = 5; g.events.emit('tablet'); g.sfx.play('tablet-swallow', { volume: 0.5 }); g.hudTouch('health'); }\n      } else this.tabletHold = 0;\n      const limit = this.feverLimit ?? 25;\n      if (this.feverT > limit) this.collapse();\n    } else if (this.fever === 'clearing') {\n      this.clearT -= dt;\n      this.swim = lerp(this.swim, 0, 1 - Math.exp(-dt * 1.4));\n      if (this.clearT <= 0) this.clearFever();\n    }\n    this.bodySway = this.swim;\n    const cam = g.cam;\n    if (this.swim > 0.01) {\n      const t = g.time;\n      cam.roll = Math.sin(t * 0.7) * 0.05 * this.swim;\n      cam.kickYaw += Math.sin(t * 0.9) * 0.0012 * this.swim;\n      cam.kickPitch += Math.cos(t * 1.1) * 0.0009 * this.swim;\n    } else cam.roll = 0;\n  }\n  startFever(opts = {}) {\n    const g = this.game;\n    this.fever = 'on'; this.feverOn = true; this.feverT = 0; this.tabletHold = 0;\n    this.feverLimit = opts.limit ?? 25;\n    if (!opts.silent) g.say('', FEVER_LINES[this.feverLineN++ % FEVER_LINES.length], 3);\n    g.sfx.play('fever-onset', { volume: 0.7 });\n    g.music.setMood?.('fever');\n    g.events.emit('fever-start');\n  }\n  clearFever() {\n    const g = this.game;\n    this.fever = 'none'; this.feverOn = false; this.swim = 0; g.cam.roll = 0; this.bodySway = 0;\n    this.scheduleFever();\n    g.events.emit('fever-clear');\n    g.music.setMood?.(null);\n  }\n  /** Ignored for 25 s or no tablets: you wake at the nearest safehouse or the clinic hours later, with 20% of your stones gone. */\n  collapse() {\n    const g = this.game;\n    this.fever = 'none'; this.feverOn = false; this.swim = 0; g.cam.roll = 0;\n    this.scheduleFever();\n    g.events.emit('fever-collapse');\n    g.collapseAway();\n  }\n}\nEOF\necho ok","description":"Write player, damage, projectiles, weapons, viewmodel, effects, body"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":33303,"cache_read_input_tokens":310529,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":33303},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"c1c5b9a6-0974-4907-98d6-db0403f9dc4b","timestamp":"2026-11-05T23:49:10.265Z","request_id":"req_011CgkftqrTtSknio62U875s","wire_tool_inputs":{"toolu_013Tc5io4bkqixQknXUeQEFE":{"command":"set -e\ncat > src/actors/player.js <<'EOF'\n// The player: a grounded capsule, stance, stamina, footsteps, the use scan. No visible body.\nimport { THREE, CharacterController } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { K } from '../world/ground.js';\nimport { RIVER_Y } from '../content/roads.js';\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\nimport { F } from '../world/fire.js';\nconst { Vector3 } = THREE;\nconst _v = new Vector3(), _f = new Vector3(), _r = new Vector3();\nexport class Player {\n  stance = 'stand'; walkToggle = false; sprinting = false; stamina = 6; eyeH = 1.55; noise = 0; wading = false; inGrass = false; moving = false; speedNow = 0;\n  stepDist = 0; prevY = 0; airFrom = null; bob = 0; bobAmp = 0; landDip = 0; litUntil = 0; seat = null; frozen = false; carrying = null; hidden = false; flying = false;\n  constructor(game) { this.game = game; this.feet = new Vector3(); this.eye = new Vector3(); this.move = new Vector3(); }\n  build(ctx, at = [-120, 60, 150]) {\n    const y = this.game.world.heightAt(at[0], at[2]) + 0.3;\n    this.cc = new CharacterController(ctx.physics, { position: [at[0], y, at[2]], radius: 0.34, halfHeight: 0.56, speed: 5.4, jumpSpeed: 8, gravity: -24 });\n    ctx.physics.tag(this.cc.collider, 'player');\n    this.game.hitMap.set(this.cc.collider.handle, { kind: 'player', ref: this });\n    this.feet.copy(this.cc.feet);\n  }\n  teleport(x, z, y) {\n    const g = this.game;\n    const yy = y ?? g.world.heightAt(x, z) + 0.2;\n    this.cc.teleport([x, yy, z]);\n    this.cc.velocity.set(0, 0, 0);\n    this.feet.set(x, yy, z);\n    this.airFrom = null;\n    g.fireView?.sweep();\n    if (g.grass) g.grass.primeAll = true;\n  }\n  setYaw(y, p = 0) { const rig = this.game.ctx.camera; rig.yaw = y; rig.pitch = p; }\n  get yaw() { return this.game.ctx.camera.yaw ?? 0; }\n  get pitch() { return this.game.ctx.camera.pitch ?? 0; }\n  forward(out = _f) { const y = this.yaw, p = this.pitch; return out.set(-Math.sin(y) * Math.cos(p), Math.sin(p), -Math.cos(y) * Math.cos(p)); }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions;\n    if (this.seat) { this.feet.copy(this.seat.feet()); this.noise = 0; return; }\n    if (this.flying) { this.fly(ctx, dt); return; }\n    const axis = this.frozen || g.scene.locksMove ? { x: 0, y: 0 } : a.axis();\n    const yaw = this.yaw;\n    const fx = -Math.sin(yaw), fz = -Math.cos(yaw), rx = Math.cos(yaw), rz = -Math.sin(yaw);\n    const tilt = Math.min(1, Math.hypot(axis.x, axis.y));\n    if (!this.frozen && !g.scene.locksMove) {\n      if (a.take('crouch')) this.stance = this.stance === 'crouch' ? 'stand' : 'crouch';\n      if (g.ctx.input.consumePress('CapsLock')) this.walkToggle = !this.walkToggle;\n    }\n    this.wading = g.ground.isWater(this.feet.x, this.feet.z) && this.feet.y < RIVER_Y - 0.1;\n    const padTilted = a.device === 'pad' && tilt > 0.05 && tilt < 0.62;\n    const walking = this.walkToggle || padTilted;\n    const wantSprint = a.down('sprint') && axis.y > 0.3 && !g.weapons.aiming && !this.carrying && !this.wading;\n    let speed = 5.4;\n    if (this.stance === 'crouch') speed = 2.0;\n    else if (walking) speed = 3.6;\n    this.sprinting = false;\n    if (wantSprint && this.stamina > 0 && this.stance !== 'crouch') { this.sprinting = true; speed = 7.4; this.stamina = Math.max(0, this.stamina - dt); }\n    else this.stamina = Math.min(6, this.stamina + dt * (6 / 8));\n    if (this.wading) speed = Math.min(speed, 2.7);\n    if (this.carrying) speed *= 0.85;\n    speed *= TUNING.playerSpeed * (g.weapons.aiming ? 0.72 : 1) * g.body.moveFactor();\n    this.cc.speed = speed;\n    this.move.set(fx * axis.y + rx * axis.x, 0, fz * axis.y + rz * axis.x);\n    const ml = this.move.length();\n    if (ml > 1) this.move.multiplyScalar(1 / ml);\n    this.moving = ml > 0.05 && !this.frozen;\n    const jump = !this.frozen && !g.scene.locksMove && !g.mapUp && a.take('jump');\n    this.cc.setInput(this.move, jump, a.down('jump'));\n    const wasGrounded = this.cc.grounded;\n    this.cc.fixedUpdate(dt);\n    this.feet.copy(this.cc.feet);\n    // Falling.\n    if (!this.cc.grounded && this.airFrom === null) this.airFrom = this.feet.y;\n    if (this.cc.grounded && this.airFrom !== null) {\n      const drop = this.airFrom - this.feet.y;\n      this.airFrom = null;\n      if (drop > 1.2) { this.landDip = clamp(drop * 0.05, 0.03, 0.2); g.sfx.play('land', { volume: 0.5 }); }\n      if (drop > 6) g.body.hurt((drop - 6) * 9, 'fall');\n    }\n    if (this.feet.y < 5) { this.teleport(this.feet.x, this.feet.z); }\n    // Noise and footsteps.\n    const k = g.ground.kindAt(this.feet.x, this.feet.z);\n    this.inGrass = (k === K.CROP || k === K.GRASS || k === K.WOOD) && !g.fire.isBurnt(this.feet.x, this.feet.z);\n    this.speedNow = this.moving && this.cc.grounded ? speed : 0;\n    this.noise = !this.moving ? 0 : this.sprinting ? 40 : (this.stance === 'crouch' || walking) ? 0 : 25;\n    this.stepDist += this.speedNow * dt;\n    const stride = this.sprinting ? 2.5 : this.stance === 'crouch' ? 1.5 : 1.9;\n    if (this.stepDist > stride) {\n      this.stepDist = 0;\n      const surf = this.wading ? 'water' : (k === K.ROAD || k === K.RAIL || k === K.TRACK) ? 'road' : (k === K.GRASS || k === K.CROP || k === K.WOOD || k === K.BANK) ? (g.fire.isBurnt(this.feet.x, this.feet.z) ? 'dirt' : 'grass') : (g.world.onDeck?.(this.feet) ? 'wood' : 'dirt');\n      g.sfx.play(`step-${surf}`, { volume: this.stance === 'crouch' ? 0.2 : this.sprinting ? 0.55 : 0.36 });\n    }\n    // Being in a burning cell.\n    if (g.fire.isBurning(this.feet.x, this.feet.z) && !this.wading) g.body.catchFire();\n  }\n  fly(ctx, dt) {\n    const g = this.game, a = g.actions, axis = a.axis();\n    const fwd = this.forward(_f), rx = Math.cos(this.yaw), rz = -Math.sin(this.yaw), sp = a.down('sprint') ? 60 : 22;\n    this.feet.x += (fwd.x * axis.y + rx * axis.x) * sp * dt;\n    this.feet.y += (fwd.y * axis.y + (a.down('jump') ? 1 : 0) - (a.down('crouch') ? 1 : 0)) * sp * dt;\n    this.feet.z += (fwd.z * axis.y + rz * axis.x) * sp * dt;\n    this.feet.y = Math.max(this.feet.y, g.world.heightAt(this.feet.x, this.feet.z) + 0.2);\n    this.cc.teleport([this.feet.x, this.feet.y, this.feet.z]);\n    this.noise = 0;\n  }\n  /** Visual eye height and bob. `alpha`-blended feet keep the camera smooth. */\n  update(ctx, dt) {\n    const g = this.game;\n    if (this.seat) { this.seat.eye(this.eye); return this.eye; }\n    const want = this.stance === 'crouch' ? 0.95 : 1.55;\n    this.eyeH = lerp(this.eyeH, want, 1 - Math.exp(-dt * 10));\n    const feet = this.flying ? this.feet : this.cc.interpolatedFeet(ctx.physics.alpha);\n    const sway = this.game.body.bodySway ?? 0;\n    this.landDip = lerp(this.landDip, 0, 1 - Math.exp(-dt * 8));\n    this.eye.set(feet.x, feet.y + this.eyeH - this.landDip - (this.wading ? 0.3 : 0), feet.z);\n    this.bob += this.speedNow * dt * 1.8;\n    this.bobAmp = lerp(this.bobAmp, this.speedNow > 0 ? clamp(this.speedNow / 7, 0.3, 1) : 0, 1 - Math.exp(-dt * 8));\n    return this.eye;\n  }\n}\nEOF\ncat > src/combat/damage.js <<'EOF'\n// Who gets hurt by what. Bullets by ray, blasts by radius. Sim only; pictures through the feedback helpers.\nimport { THREE } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst _o = new Vector3(), _d = new Vector3(), _h = new Vector3();\nexport class Damage {\n  hitFlash = 0; lastHitAt = -9;\n  constructor(game) { this.game = game; }\n  /** One bullet. Returns what it hit. `who` is 'player', a soldier, a buddy or a seat id in a round. */\n  bullet(fromX, fromY, fromZ, dx, dy, dz, range, damage, who, opts = {}) {\n    const g = this.game, ctx = g.ctx;\n    _o.set(fromX, fromY, fromZ); _d.set(dx, dy, dz).normalize();\n    const exclude = who?.cc?.body ?? (who === 'player' ? g.player.cc?.body : undefined);\n    const hit = ctx.physics.castRay(_o, _d, range, [], exclude);\n    if (!hit) return null;\n    const px = fromX + _d.x * hit.distance, py = fromY + _d.y * hit.distance, pz = fromZ + _d.z * hit.distance;\n    const ent = g.hitMap.get(hit.collider.handle);\n    const res = { x: px, y: py, z: pz, ent, distance: hit.distance };\n    if (!ent) { g.fx.impact(px, py, pz, hit.normal, 'dirt', opts); return res; }\n    switch (ent.kind) {\n      case 'soldier': {\n        const s = ent.ref;\n        if (s.dead) return res;\n        const zone = py - s.y;\n        const m = zone > 1.48 ? 2.5 : zone < 0.68 ? 0.7 : 1;\n        if (who === 'player' || opts.seat != null) g.fx.hitMarker(m > 1);\n        s.hurt(damage * m, who, _d, m > 1 ? 'head' : 'body', opts);\n        g.fx.impact(px, py, pz, hit.normal, 'flesh', opts);\n        break;\n      }\n      case 'player':\n        if (who !== 'player') g.body.hurt(damage, 'bullet', [fromX, fromZ], opts);\n        g.fx.impact(px, py, pz, hit.normal, 'flesh', opts);\n        break;\n      case 'buddy':\n        if (who !== 'player' || !g.story?.noFriendlyFire) ent.ref.hurt(damage, who);\n        g.fx.impact(px, py, pz, hit.normal, 'flesh', opts);\n        break;\n      case 'civilian':\n        ent.ref.flee(fromX, fromZ);\n        g.fx.impact(px, py, pz, hit.normal, 'dirt', opts);\n        break;\n      case 'vehicle':\n        ent.ref.hurt(damage * 0.35, 'bullet');\n        g.fx.impact(px, py, pz, hit.normal, 'metal', opts);\n        break;\n      case 'explosive': {\n        const ex = ent.ref;\n        ex.hp -= damage;\n        g.fx.impact(px, py, pz, hit.normal, 'metal', opts);\n        if (ex.hp <= 0) this.explode(ex, 'bullet', who);\n        break;\n      }\n      case 'merc':\n        g.round?.hitMerc(ent.ref, damage, opts, who);\n        g.fx.impact(px, py, pz, hit.normal, 'flesh', opts);\n        break;\n      default:\n        g.fx.impact(px, py, pz, hit.normal, 'dirt', opts);\n    }\n    return res;\n  }\n  /** A blast: hurts everything in range, lights the grass, chains tanks. */\n  blast(x, y, z, radius, damage, who, opts = {}) {\n    const g = this.game, ctx = g.ctx;\n    g.fx.explosion(x, y, z, radius);\n    if (opts.fire !== 0) g.fire.ignite(x, z, opts.fire ?? radius * 0.8, who === 'player' ? 'player' : 'world');\n    // Soldiers.\n    for (const s of g.actors.soldiers) {\n      if (s.dead || !s.active) continue;\n      const d = Math.hypot(s.x - x, s.y - y, s.z - z);\n      if (d < radius * 1.3) {\n        const f = clamp(1 - d / (radius * 1.3), 0.15, 1);\n        _d.set(s.x - x, Math.abs(s.y - y) + 1.2, s.z - z).normalize();\n        s.hurt(damage * f, who, _d, 'blast', { blast: 1 });\n        if (d < radius * 0.7) s.ignite();\n      }\n    }\n    for (const b of g.actors.buddies) {\n      if (!b.active || b.down || b.dead) continue;\n      const d = Math.hypot(b.x - x, b.z - z);\n      if (d < radius) b.hurt(damage * (1 - d / radius) * 0.5, who);\n    }\n    // The player.\n    if (g.hasPlayer) {\n      const f = g.player.feet, d = Math.hypot(f.x - x, f.y + 0.9 - y, f.z - z);\n      if (d < radius * 1.2) {\n        const v = clamp(1 - d / (radius * 1.2), 0.1, 1);\n        g.body.hurt(damage * v * 0.42, 'blast', [x, z]);\n        ctx.engine.shake.add(v * 0.9);\n      } else if (d < radius * 8) ctx.engine.shake.add(clamp(0.5 - d / (radius * 16), 0, 0.5));\n    }\n    // Vehicles.\n    for (const v of g.vehicles.list) {\n      if (!v.alive) continue;\n      const d = Math.hypot(v.x - x, v.z - z);\n      if (d < radius * 1.2) v.hurt(damage * clamp(1 - d / (radius * 1.2), 0.15, 1), 'blast');\n    }\n    // Chains.\n    for (const ex of g.world.explosives) {\n      if (!ex.alive) continue;\n      if (Math.hypot(ex.x - x, ex.z - z) < radius) { ex.hp -= damage; if (ex.hp <= 0) g.after(0.12 + Math.hypot(ex.x - x, ex.z - z) * 0.02, () => this.explode(ex, 'chain', who)); }\n    }\n    g.round?.blastAt?.(x, y, z, radius, damage, who, opts);\n    ctx.physics.explode([x, y, z], { radius: radius * 1.4, impulse: 14 });\n    g.actors.heardGunshot(x, z, radius * 16);\n    g.events.emit('blast', x, z, radius);\n  }\n  explode(ex, cause, who) {\n    if (!ex.alive) return;\n    ex.alive = false;\n    ex.object.visible = false;\n    for (const c of ex.colliders) { c.setEnabled?.(false); }\n    this.game.events.emit('destroyed', ex.tag ?? ex.id, ex);\n    this.blast(ex.x, ex.y + 1.2, ex.z, ex.def.radius, ex.def.damage, who ?? (cause === 'fire' ? 'fire' : 'world'), { fire: ex.def.fire });\n    this.game.fx.scorch(ex.x, ex.y, ex.z, ex.def.radius);\n  }\n  restore(ex) {\n    ex.alive = true; ex.hp = ex.def.hp; ex.object.visible = true;\n    for (const c of ex.colliders) c.setEnabled?.(true);\n  }\n}\nEOF\ncat > src/combat/projectiles.js <<'EOF'\n// Flares, bottles and rockets: integrated per fixed step, one ray per step. Hit and light.\nimport { THREE, glowMaterial, PALETTE, buildModel, toonMaterial } from '../../pixel-engine.js';\nconst { Vector3, Mesh, BoxGeometry, SphereGeometry } = THREE;\nconst _o = new Vector3(), _d = new Vector3();\nconst KIND = {\n  flare: { speed: 42, gravity: 11, color: PALETTE.orange, size: 0.14, life: 6, trail: 'ember' },\n  bottle: { speed: 18, gravity: 12, color: PALETTE.teal, size: 0.12, life: 5 },\n  rocket: { speed: 62, gravity: 1.2, color: PALETTE.sand, size: 0.2, life: 4, trail: 'fire-smoke' },\n  soldier_rocket: { speed: 44, gravity: 1.2, color: PALETTE.sand, size: 0.2, life: 4, trail: 'fire-smoke' },\n};\nexport class Projectiles {\n  list = []; pool = [];\n  constructor(game) { this.game = game; }\n  spawn(kind, x, y, z, dx, dy, dz, who, opts = {}) {\n    const def = KIND[kind];\n    const g = this.game;\n    let mesh = null;\n    if (g.views) {\n      mesh = new Mesh(new BoxGeometry(def.size, def.size, def.size * 2), kind === 'bottle' ? toonMaterial(def.color) : glowMaterial(def.color));\n      mesh.position.set(x, y, z); g.ctx.scene.add(mesh);\n    }\n    const l = Math.hypot(dx, dy, dz) || 1;\n    const sp = opts.speed ?? def.speed;\n    const p = { kind, def, x, y, z, vx: (dx / l) * sp, vy: (dy / l) * sp, vz: (dz / l) * sp, t: 0, who, mesh, opts, light: null };\n    if (g.views && kind === 'flare') p.light = g.ctx.lights.request({ position: [x, y, z], color: 0xff7a30, intensity: 12, radius: 18, flicker: 'torch' });\n    this.list.push(p);\n    return p;\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game;\n    const rays = ctx.physics;\n    for (let i = this.list.length - 1; i >= 0; i--) {\n      const p = this.list[i];\n      p.t += dt;\n      p.vy -= p.def.gravity * dt;\n      const dx = p.vx * dt, dy = p.vy * dt, dz = p.vz * dt, len = Math.hypot(dx, dy, dz);\n      _o.set(p.x, p.y, p.z); _d.set(dx / len, dy / len, dz / len);\n      const exclude = p.who === 'player' ? g.player?.cc?.body : p.who?.cc?.body;\n      const hit = rays.castRay(_o, _d, len + 0.05, [], exclude);\n      if (hit || p.t > p.def.life) {\n        const hx = hit ? p.x + _d.x * hit.distance : p.x, hy = hit ? p.y + _d.y * hit.distance : p.y, hz = hit ? p.z + _d.z * hit.distance : p.z;\n        this.impact(p, hx, hy, hz, hit);\n        this.remove(i);\n        continue;\n      }\n      p.x += dx; p.y += dy; p.z += dz;\n      if (p.def.trail && ((p.t * 30) | 0) % 2 === 0) ctx.particles.burst(p.def.trail, [p.x, p.y, p.z], { count: 1 });\n      if (p.mesh) { p.mesh.position.set(p.x, p.y, p.z); p.mesh.lookAt(p.x + p.vx, p.y + p.vy, p.z + p.vz); }\n      if (p.light) p.light.position.set(p.x, p.y, p.z);\n    }\n  }\n  impact(p, x, y, z, hit) {\n    const g = this.game;\n    const who = p.who;\n    const src = who === 'player' || p.opts.seat != null ? 'player' : 'world';\n    const ent = hit ? g.hitMap.get(hit.collider.handle) : null;\n    if (p.kind === 'flare') {\n      g.fire.ignite(x, z, 3, src);\n      if (ent?.kind === 'soldier') { ent.ref.hurt(12, who, _d, 'body', p.opts); ent.ref.ignite(); }\n      if (ent?.kind === 'merc') { g.round?.hitMerc(ent.ref, 12, p.opts, who); }\n      g.sfx.at('flare-hiss', x, z, { volume: 0.5, max: 60 });\n      g.ctx.particles.burst('ember', [x, y + 0.2, z], { count: 12 });\n    } else if (p.kind === 'bottle') {\n      g.fire.ignite(x, z, 4, src);\n      g.sfx.at('bottle-smash', x, z, { max: 60 });\n      g.ctx.particles.burst('ember', [x, y + 0.3, z], { count: 20 });\n      g.fx.scorch(x, y, z, 2.5);\n      if (ent?.kind === 'soldier') ent.ref.ignite();\n      for (const s of g.actors.soldiers) if (s.active && !s.dead && Math.hypot(s.x - x, s.z - z) < 3.2) s.ignite();\n    } else {\n      g.damage.blast(x, y + 0.4, z, 6, 180, who, { ...p.opts, fire: 5 });\n      if (ent?.kind === 'vehicle') ent.ref.hurt(160, 'rocket');\n    }\n    g.events.emit('impact', p.kind, x, z);\n  }\n  remove(i) {\n    const p = this.list[i];\n    if (p.mesh) { this.game.ctx.scene.remove(p.mesh); p.mesh.geometry.dispose(); }\n    p.light?.release();\n    this.list.splice(i, 1);\n  }\n  clear() { for (let i = this.list.length - 1; i >= 0; i--) this.remove(i); }\n}\nEOF\ncat > src/combat/weapons.js <<'EOF'\n// The player's guns: wear, jams, things falling apart, throws. The source's spirit made precise (PLAN section 8).\nimport { THREE, Decals } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { WEAPONS, THROWN, SLOT_ORDER } from '../content/weapons.js';\nimport { clamp, lerp } from '../core/rng.js';\nconst { Vector3 } = THREE;\nconst _f = new Vector3(), _o = new Vector3();\nexport const newGun = (id, cond = 100) => { const d = WEAPONS[id]; return { id, cond, mag: d.mag ?? 0, reserve: d.reserve ?? 0, jam: 0 }; };\nexport const jamChance = (cond) => TUNING.jamRate * 0.12 * Math.pow(1 - cond / 100, 2);\n\nexport class Weapons {\n  slots = { melee: { id: 'cane', cond: 100, mag: 0, reserve: 0, jam: 0 }, sidearm: null, main: null, special: null };\n  current = 'melee'; cool = 0; lock = 0; aiming = false; aimT = 0; reloading = 0; shotsFired = 0; bottles = 0; charges = 0; placed = []; plantHold = 0; throwHeld = false; streamT = 0; lastNoise = 0; tracerN = 0; scriptJamAt = 0; scriptShots = 0; heat = 0; overheated = false; mounted = null; lit = 0; hasCleaning = false; hasBelt = false; flameOn = false; flameT = 0; leakT = 0;\n  constructor(game) { this.game = game; }\n  get gun() { return this.slots[this.current]; }\n  get def() { return WEAPONS[this.gun?.id ?? 'cane']; }\n  give(id, cond = 100, equip = false) {\n    const d = WEAPONS[id];\n    const old = this.slots[d.slot];\n    const g = newGun(id, cond);\n    if (this.hasBelt && g.reserve) g.reserve = Math.round(g.reserve * 1.5);\n    this.slots[d.slot] = g;\n    if (equip || !old) this.equip(d.slot);\n    return g;\n  }\n  equip(slot) {\n    if (!this.slots[slot]) return false;\n    if (this.current !== slot || this.game.vm.gunId !== this.slots[slot].id) { this.current = slot; this.game.sfx.play('gun-equip', { volume: 0.35 }); this.lock = Math.max(this.lock, 0.25); this.reloading = 0; this.game.vm.showGun(this.slots[slot].id, true); this.flameStop(); }\n    return true;\n  }\n  cycle(dir = 1) {\n    const order = SLOT_ORDER.filter((s) => this.slots[s]);\n    const i = order.indexOf(this.current);\n    if (order.length) this.equip(order[(i + dir + order.length) % order.length]);\n  }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions;\n    this.cool -= dt; this.lock -= dt;\n    if (this.mounted) { this.mountedStep(ctx, dt); return; }\n    const canAct = g.canAct();\n    // Slots.\n    if (canAct) {\n      if (a.take('next')) this.cycle(1);\n      for (let i = 0; i < 4; i++) if (ctx.input.consumePress(`Digit${i + 1}`)) this.equip(SLOT_ORDER[i]);\n      if (g.wheelStep) { this.cycle(g.wheelStep > 0 ? 1 : -1); g.wheelStep = 0; }\n    }\n    const gun = this.gun, def = this.def;\n    this.aiming = canAct && a.down('aim') && def.cls !== 'melee' && !g.player.sprinting && this.lock <= 0 && !g.mapUp;\n    this.aimT = lerp(this.aimT, this.aiming ? 1 : 0, 1 - Math.exp(-dt * 12));\n    // Reload ends.\n    if (this.reloading > 0) {\n      this.reloading -= dt;\n      if (this.reloading <= 0) this.finishReload();\n    }\n    if (g.inMonocular()) { this.flameStop(); return; }\n    if (canAct) {\n      this.throwing(ctx, dt);\n      if (a.take('melee') && this.lock <= 0) this.swing(ctx);\n      // Reload is Square on a pad only when no use prompt is showing; R on keys always.\n      const padSquareFree = !g.interact.current;\n      if ((ctx.input.consumePress('KeyR') || (padSquareFree && ctx.input.consumePress('PadSquare')) || g.actions.bot?.queue.delete('reload')) && this.lock <= 0) this.reloadPress(ctx);\n    }\n    // Fire.\n    const wants = canAct && (def.cls === 'melee' ? a.take('fire') : def.auto ? a.down('fire') : a.take('fire'));\n    if (def.stream) this.streamStep(ctx, dt, wants && this.reloading <= 0 && this.lock <= 0 && !gun.jam);\n    else if (wants && this.lock <= 0 && this.reloading <= 0) {\n      if (def.cls === 'melee') this.swing(ctx);\n      else if (this.cool <= 0) this.shoot(ctx);\n    }\n    // A bad gun rattles.\n    if (gun && gun.cond < 10 && def.wear > 0 && g.player.speedNow > 5 && g.tick % 40 === 0) g.sfx.play('gun-rattle', { volume: 0.25 });\n  }\n  /** One press on a jammed gun works it loose a little; on a clean one it reloads. */\n  reloadPress(ctx) {\n    const gun = this.gun, def = this.def, g = this.game;\n    if (!gun || def.cls === 'melee') return;\n    if (gun.jam > 0) {\n      gun.jam--;\n      this.lock = 0.62;\n      g.vm.play(def.cls === 'pistol' ? 'UnjamPistol' : 'UnjamRifle');\n      g.sfx.play('gun-slap', { volume: 0.7 });\n      g.after(0.25, () => g.sfx.play('gun-rack', { volume: 0.7 }));\n      if (gun.jam === 0) { g.events.emit('unjammed'); g.notice('', 0); g.after(0.3, () => g.sfx.play('gun-mag', { volume: 0.3 })); }\n      return;\n    }\n    if (this.reloading > 0 || gun.mag >= def.mag || gun.reserve <= 0) return;\n    this.reloading = def.reload;\n    this.lock = 0;\n    const clip = gun.id === 'mule' ? 'ReloadPump' : gun.id === 'empire' ? 'ReloadBolt' : gun.id === 'm38' ? 'ReloadRevolver' : gun.id === 'flare' ? 'ReloadFlare' : gun.id === 'tube' ? 'ReloadTube' : 'ReloadRifle';\n    g.vm.play(clip);\n    g.sfx.play(gun.id === 'm38' ? 'gun-cylinder' : gun.id === 'mule' ? 'gun-shell' : 'gun-mag', { volume: 0.6 });\n    if (gun.id === 'mule') for (let i = 1; i < 4; i++) g.after(i * 0.55, () => g.sfx.play('gun-shell', { volume: 0.5 }));\n    else g.after(def.reload * 0.7, () => g.sfx.play('gun-rack', { volume: 0.5 }));\n    g.events.emit('reload-start');\n  }\n  finishReload() {\n    const gun = this.gun, def = this.def;\n    if (!gun || !def.mag) return;\n    const need = def.mag - gun.mag, take = Math.min(need, gun.reserve);\n    gun.mag += take; gun.reserve -= take;\n    this.game.events.emit('reloaded');\n  }\n  aimDir(out = _f) { return this.game.player.forward(out); }\n  muzzleWorld(out = _o) { return out.copy(this.game.player.eye); }\n  shoot(ctx) {\n    const g = this.game, gun = this.gun, def = this.def;\n    if (gun.jam > 0) { g.sfx.play('gun-jam', { volume: 0.7 }); this.cool = 0.25; g.showJam(); return; }\n    if (gun.mag <= 0) {\n      g.sfx.play('gun-jam', { volume: 0.4, pitch: 4 }); this.cool = 0.25;\n      if (gun.reserve > 0) this.reloadPress(ctx);\n      return;\n    }\n    this.cool = 1 / def.rate;\n    gun.mag--;\n    this.shotsFired++;\n    // Wear and the jam roll: one per shot, seeded.\n    const wearK = TUNING.wearRate * (this.hasCleaning ? 0.6 : 1);\n    if (def.wear > 0 && !g.dev.noWear) gun.cond = clamp(gun.cond - def.wear * wearK, 0, 100);\n    let jammed = false;\n    if (this.scriptJamAt > 0) { this.scriptShots++; if (this.scriptShots >= this.scriptJamAt) { jammed = true; this.scriptJamAt = 0; this.scriptShots = 0; } }\n    else if (!g.dev.noJams && def.wear > 0 && g.rng.gun.next() < jamChance(gun.cond)) jammed = true;\n    // The shot itself.\n    const eye = g.player.eye, fwd = this.aimDir();\n    const sp = (def.spread * (this.aiming ? 0.3 : 1) * (g.player.moving ? 1.25 : 1)) * (Math.PI / 180);\n    const r = g.rng.gun;\n    if (def.projectile) {\n      const kind = def.projectile;\n      g.projectiles.spawn(kind, eye.x + fwd.x * 0.8, eye.y + fwd.y * 0.8 - 0.08, eye.z + fwd.z * 0.8, fwd.x + r.range(-sp, sp), fwd.y + r.range(-sp, sp) + (kind === 'flare' ? 0.04 : 0), fwd.z + r.range(-sp, sp), 'player');\n    } else {\n      const pellets = def.pellets ?? 1;\n      for (let i = 0; i < pellets; i++) {\n        const dx = fwd.x + r.range(-sp, sp), dy = fwd.y + r.range(-sp, sp), dz = fwd.z + r.range(-sp, sp);\n        const dmg = def.damage * TUNING.weaponDamage;\n        const hit = g.damage.bullet(eye.x, eye.y, eye.z, dx, dy, dz, def.range, dmg, 'player');\n        if (i === 0 && ++this.tracerN % 3 === 0 && hit) g.fx.tracerFromView(hit.x, hit.y, hit.z);\n      }\n    }\n    // Feedback.\n    g.vm.fire();\n    g.sfx.play(def.sound, { volume: 0.8 });\n    g.fx.muzzleFlash(def);\n    g.player.litUntil = g.time + 0.5;\n    ctx.engine.shake.add(clamp(def.kick * 6, 0.03, 0.35));\n    g.cam.kickPitch += def.kick * (this.aiming ? 0.55 : 1) * (1 + r.range(0, 0.3));\n    g.cam.kickYaw += r.range(-1, 1) * def.kick * 0.25;\n    g.rumble(0.3 + def.kick * 6, 0.06);\n    if (gun.cond < 30 && def.wear > 0) g.fx.gunSmoke();\n    g.actors.heardGunshot(eye.x, eye.z, def.hear, 'player');\n    g.events.emit('shot', gun.id);\n    g.hudTouch('ammo');\n    if (jammed) {\n      gun.jam = r.int(2, 4);\n      g.events.emit('jam');\n      g.sfx.play('gun-jam', { volume: 0.7 });\n      g.showJam();\n    }\n    if (def.wear > 0 && gun.cond <= 0) this.fallApart();\n  }\n  fallApart() {\n    const g = this.game;\n    const slot = this.current;\n    g.vm.play('FallApart');\n    g.sfx.play('gun-apart', { volume: 0.9 });\n    g.ledger.note('guns');\n    g.events.emit('gun-apart', this.slots[slot].id);\n    this.lock = 1.4;\n    g.after(1.3, () => {\n      this.slots[slot] = null;\n      if (this.current === slot) { this.current = 'melee'; g.vm.showGun('cane', true); }\n    });\n  }\n  flameStop() { if (this.flameOn) { this.flameOn = false; this.game.sfx.stopLoop('flamer'); } }\n  streamStep(ctx, dt, wants) {\n    const g = this.game, gun = this.gun, def = this.def;\n    if (!wants || gun.mag <= 0) { this.flameStop(); if (wants && gun.mag <= 0) { if (gun.reserve > 0) this.reloadPress(ctx); else if (g.tick % 40 === 0) g.sfx.play('gun-jam', { volume: 0.4 }); } return; }\n    if (!this.flameOn) { this.flameOn = true; g.sfx.play('flamer-start', { volume: 0.7 }); g.sfx.startLoop('flamer', 'flamer-loop', { volume: 0.7 }); }\n    gun.mag = Math.max(0, gun.mag - 30 * dt);\n    if (!g.dev.noWear) gun.cond = clamp(gun.cond - def.wear * 30 * dt * TUNING.wearRate * (this.hasCleaning ? 0.6 : 1), 0, 100);\n    const eye = g.player.eye, fwd = this.aimDir();\n    // Lights everything in its cone.\n    const reach = def.range;\n    this.flameT -= dt;\n    if (this.flameT <= 0) {\n      this.flameT = 0.1;\n      const t = g.rng.gun.range(0.35, 1) * reach;\n      g.fire.ignite(eye.x + fwd.x * t, eye.z + fwd.z * t, 2.5, 'player');\n      for (const s of g.actors.soldiers) {\n        if (!s.active || s.dead) continue;\n        const dx = s.x - eye.x, dz = s.z - eye.z, d = Math.hypot(dx, dz);\n        if (d < reach && (dx * fwd.x + dz * fwd.z) / (d || 1) > 0.9) { s.hurt(def.damage * TUNING.weaponDamage * 0.1, 'player', fwd, 'body', {}); if (d < reach * 0.7) s.ignite(); }\n      }\n      for (const v of g.vehicles.list) { if (v.alive && Math.hypot(v.x - eye.x, v.z - eye.z) < reach) { const dx = v.x - eye.x, dz = v.z - eye.z, d = Math.hypot(dx, dz) || 1; if ((dx * fwd.x + dz * fwd.z) / d > 0.9) v.hurt(1.2, 'fire'); } }\n      for (const ex of g.world.explosives) { if (ex.alive && Math.hypot(ex.x - eye.x, ex.z - eye.z) < reach) { const dx = ex.x - eye.x, dz = ex.z - eye.z, d = Math.hypot(dx, dz) || 1; if ((dx * fwd.x + dz * fwd.z) / d > 0.9) { ex.hp -= 4; if (ex.hp <= 0) g.damage.explode(ex, 'fire', 'player'); } } }\n      g.actors.heardGunshot(eye.x, eye.z, def.hear, 'player');\n    }\n    g.player.litUntil = g.time + 0.5;\n    g.fx.flamerStream(eye, fwd);\n    // Below 20 it can leak and light you.\n    if (gun.cond < 20 && !g.dev.noJams && g.rng.gun.chance(dt * 0.25)) { g.body.catchFire(); g.say('', 'IT LEAKS.', 1.6); }\n    if (gun.cond <= 0) { this.flameStop(); this.fallApart(); }\n    g.vm.flame = 1;\n  }\n  swing(ctx) {\n    const g = this.game, eye = g.player.eye, fwd = this.aimDir();\n    if (this.cool > 0) return;\n    this.cool = 1 / 1.6; this.lock = 0.28;\n    g.vm.showGun('cane', false);\n    g.vm.play('Swing');\n    g.sfx.play('knife-swing', { volume: 0.6 });\n    g.after(0.13, () => {\n      const hit = g.damage.bullet(eye.x, eye.y, eye.z, fwd.x, fwd.y, fwd.z, 2.2, 0, 'player', { melee: true, silent: true });\n      const ent = hit?.ent;\n      if (ent?.kind === 'soldier' && !ent.ref.dead) {\n        const s = ent.ref;\n        const behind = s.fromBehind(eye.x, eye.z);\n        s.hurt((behind ? 999 : 55) * TUNING.weaponDamage, 'player', fwd, behind ? 'stealth' : 'body', {});\n        g.sfx.play('hit-flesh', { volume: 0.8 });\n        g.events.emit('melee', s, behind);\n      } else if (ent?.kind === 'merc') { g.round?.hitMerc(ent.ref, 55 * TUNING.weaponDamage, {}, 'player'); }\n      else if (hit) g.sfx.play('hit-metal', { volume: 0.25 });\n    });\n    if (this.current !== 'melee') g.after(0.55, () => g.vm.showGun(this.gun?.id ?? 'cane', false));\n  }\n  throwing(ctx, dt) {\n    const g = this.game, a = g.actions;\n    const down = a.down('throw');\n    if (down) {\n      this.plantHold += dt;\n      if (this.plantHold > 0.7 && !this.planted && this.charges > 0 && this.placed.length < 2) {\n        this.planted = true;\n        this.plant(ctx);\n      }\n    } else if (this.plantHold > 0) {\n      const short = this.plantHold <= 0.7;\n      this.plantHold = 0; this.planted = false;\n      a.take('throw');\n      if (short && this.lock <= 0) {\n        if (this.placed.length) this.detonate(ctx);\n        else if (this.bottles > 0) this.throwBottle(ctx);\n        else if (this.charges > 0) g.notice('HOLD TO PLANT', 1.5);\n      }\n    }\n  }\n  throwBottle(ctx) {\n    const g = this.game, eye = g.player.eye, fwd = this.aimDir();\n    this.bottles--;\n    this.lock = 0.55;\n    g.vm.showProp('p-bottle'); g.vm.play('Throw');\n    g.sfx.play('whoosh', { volume: 0.4 });\n    g.after(0.28, () => g.projectiles.spawn('bottle', eye.x + fwd.x, eye.y + fwd.y, eye.z + fwd.z, fwd.x, fwd.y + 0.22, fwd.z, 'player'));\n    g.after(0.65, () => g.vm.showGun(this.gun?.id ?? 'cane', false));\n    g.events.emit('throw');\n  }\n  plant(ctx) {\n    const g = this.game, f = g.player.feet, fwd = this.aimDir();\n    this.charges--;\n    this.lock = 1.3;\n    g.vm.showProp('p-charge'); g.vm.play('Plant');\n    g.sfx.play('gun-mag', { volume: 0.5 });\n    g.player.frozen = true;\n    g.after(1.2, () => {\n      g.player.frozen = false;\n      const x = f.x + fwd.x * 0.9, z = f.z + fwd.z * 0.9, y = g.world.heightAt(x, z);\n      const obj = g.fx.chargeProp(x, y, z);\n      this.placed.push({ x, y, z, obj });\n      g.vm.showGun(this.gun?.id ?? 'cane', false);\n      g.events.emit('planted', x, z);\n    });\n  }\n  detonate(ctx) {\n    const g = this.game;\n    g.vm.showProp('p-det'); g.vm.play('Detonate');\n    g.sfx.play('gun-jam', { volume: 0.8, pitch: -6 });\n    this.lock = 0.4;\n    const list = this.placed; this.placed = [];\n    g.after(0.2, () => {\n      for (const c of list) {\n        g.fx.removeProp(c.obj);\n        g.damage.blast(c.x, c.y + 0.4, c.z, THROWN.charge.blast, THROWN.charge.damage, 'player', { fire: 6 });\n      }\n      g.events.emit('detonated', list);\n    });\n    g.after(0.6, () => g.vm.showGun(this.gun?.id ?? 'cane', false));\n  }\n  /** The technical's gun and the flatcar's: no ammunition, overheats at 6 s, cools in 4 s. */\n  mountedStep(ctx, dt) {\n    const g = this.game, a = g.actions, def = WEAPONS.mg, m = this.mounted;\n    const wants = a.down('fire');\n    if (this.overheated) { this.heat -= dt / def.cool; if (this.heat <= 0) { this.heat = 0; this.overheated = false; } }\n    else if (wants && this.cool <= 0) {\n      this.cool = 1 / def.rate;\n      this.heat += (1 / def.rate) / def.overheat;\n      if (this.heat >= 1) { this.heat = 1; this.overheated = true; g.sfx.play('gun-jam', { volume: 0.6 }); g.notice('TOO HOT', 1.2); }\n      const eye = g.player.eye, fwd = this.aimDir(), r = g.rng.gun, sp = (def.spread * Math.PI) / 180;\n      const hit = g.damage.bullet(eye.x + fwd.x * 1.4, eye.y + fwd.y * 1.4, eye.z + fwd.z * 1.4, fwd.x + r.range(-sp, sp), fwd.y + r.range(-sp, sp), fwd.z + r.range(-sp, sp), def.range, def.damage * TUNING.weaponDamage, 'player');\n      if (hit && ++this.tracerN % 3 === 0) { g.fx.tracerFromView(hit.x, hit.y, hit.z); if (g.rng.gun.chance(0.08)) g.fire.ignite(hit.x, hit.z, 1, 'player'); }\n      g.sfx.play(def.sound, { volume: 0.7 });\n      g.fx.muzzleFlash(def);\n      ctx.engine.shake.add(0.07);\n      g.cam.kickPitch += def.kick; g.cam.kickYaw += r.range(-1, 1) * def.kick * 0.4;\n      g.rumble(0.35, 0.05);\n      g.actors.heardGunshot(eye.x, eye.z, def.hear, 'player');\n      g.player.litUntil = g.time + 0.5;\n      m.turret?.();\n      g.events.emit('shot', 'mg');\n    } else if (!wants) this.heat = Math.max(0, this.heat - dt / def.cool);\n  }\n  /** What's on the HUD: the small gun icon goes white, orange, red. */\n  condColor() {\n    const c = this.gun?.cond ?? 100;\n    return c >= 60 ? 'white' : c >= 30 ? 'orange' : 'red';\n  }\n  resetLoadout() {\n    this.slots = { melee: { id: 'cane', cond: 100, mag: 0, reserve: 0, jam: 0 }, sidearm: null, main: null, special: null };\n    this.current = 'melee'; this.bottles = 0; this.charges = 0; this.placed = []; this.hasCleaning = false; this.hasBelt = false; this.mounted = null; this.heat = 0; this.reloading = 0; this.lock = 0; this.scriptJamAt = 0; this.scriptShots = 0; this.flameStop();\n  }\n  snapshot() { return { slots: JSON.parse(JSON.stringify(this.slots)), current: this.current, bottles: this.bottles, charges: this.charges, hasCleaning: this.hasCleaning, hasBelt: this.hasBelt }; }\n  restoreData(d) { this.slots = d.slots; this.current = d.current; this.bottles = d.bottles; this.charges = d.charges; this.hasCleaning = d.hasCleaning; this.hasBelt = d.hasBelt; }\n}\nEOF\ncat > src/combat/viewmodel.js <<'EOF'\n// The hands and what they hold: one model on a custom rig, parented to the camera, played with the engine's clips.\nimport { THREE, buildModel, compileClips, setLookLayer, toonMaterial, PALETTE } from '../../pixel-engine.js';\nimport { handsDef, HANDS_CLIPS, HANDS_RIG, GUN_PARTS } from '../art/viewmodels.js';\nimport { WEAPONS } from '../content/weapons.js';\nimport { clamp, lerp } from '../core/rng.js';\nconst { AnimationMixer, LoopOnce, LoopRepeat, Group, Vector3, Euler } = THREE;\nconst PROPS = ['p-syrette', 'p-pliers', 'p-bullet', 'p-knife', 'p-lighter', 'p-flame', 'p-wrench', 'p-bottle', 'p-charge', 'p-det', 'p-tablet', 'p-finish', 'p-trk', 'led-off', 'led-on', 'p-mono', 'p-pill', 'w-arm', 'w-burn', 'w-thigh'];\nconst HOLD = { rifle: 'HoldRifle', pistol: 'HoldPistol', tube: 'HoldTube', melee: 'HoldMelee', none: 'HoldNone' };\nexport class ViewModel {\n  gunId = null; holdName = 'HoldNone'; action = null; actionName = ''; kick = 0; kickRot = 0; adsT = 0; flash = 0; propsOn = new Set(); flame = 0; playCounts = {};\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const b = buildModel(handsDef);\n    this.root = b.object;\n    this.group = new Group();\n    this.group.add(this.root);\n    setLookLayer(this.group, 'actors');\n    this.root.traverse((o) => { if (o.isMesh) { o.castShadow = false; o.receiveShadow = false; o.frustumCulled = false; } });\n    ctx.scene.add(ctx.camera.camera);\n    ctx.camera.camera.add(this.group);\n    this.named = {};\n    this.root.traverse((o) => { if (o.name) this.named[o.name] = o; });\n    this.clips = {};\n    for (const c of compileClips(HANDS_CLIPS, HANDS_RIG, this.root)) this.clips[c.name] = c;\n    this.mixer = new AnimationMixer(this.root);\n    this.actions = {};\n    for (const [name, clip] of Object.entries(this.clips)) { const a = this.mixer.clipAction(clip); this.actions[name] = a; }\n    this.hold(this.holdName, 0);\n    this.hideAll();\n    // The map: DataTexture plane, drawn by world/map-texture.js, under MapJ.\n    this.mapJoint = this.named.MapJ;\n    this.named.Leg.visible = false; this.mapJoint.visible = false;\n    for (const p of PROPS) if (this.named[p]) this.named[p].visible = false;\n  }\n  attach(cam) { cam.add(this.group); }\n  hideAll() {\n    for (const id of Object.keys(GUN_PARTS)) for (const pre of ['g-', 'rust-', 'tape-', 'm-', 'b-']) { const n = this.named[`${pre}${id}`]; if (n) n.visible = false; }\n    for (const p of this.propsOn) if (this.named[p]) this.named[p].visible = false;\n    this.propsOn.clear();\n  }\n  setVisible(v) { this.group.visible = v; }\n  showGun(id, withEquip) {\n    this.hideAll();\n    this.gunId = id;\n    if (!id) { this.hold('HoldNone', 0.15); return; }\n    for (const pre of ['g-', 'm-', 'b-']) { const n = this.named[`${pre}${id}`]; if (n) n.visible = true; }\n    const def = WEAPONS[id];\n    this.hold(HOLD[def?.cls ?? 'rifle'] ?? 'HoldRifle', 0.12);\n    if (withEquip) this.play('Equip');\n    this.updateWear(true);\n  }\n  showProp(...names) {\n    this.hideAll();\n    this.gunId = null;\n    for (const p of names) { if (this.named[p]) { this.named[p].visible = true; this.propsOn.add(p); } }\n  }\n  /** Rust and tape parts follow the condition of the gun: the only condition readout that counts. */\n  updateWear(force) {\n    const id = this.gunId; if (!id) return;\n    const cond = this.game.weapons.gun?.cond ?? 100;\n    const r = this.named[`rust-${id}`], t = this.named[`tape-${id}`];\n    if (r) r.visible = cond < 60; if (t) t.visible = cond < 30;\n  }\n  hold(name, fade = 0.2) {\n    const next = this.actions[name];\n    if (!next) return;\n    if (this.holdName === name && next.isRunning()) return;\n    const prev = this.actions[this.holdName];\n    next.reset().setLoop(LoopRepeat).play();\n    if (prev && prev !== next) { if (this.action) { prev.stop(); next.setEffectiveWeight(this.action ? 0 : 1); } else prev.crossFadeTo(next, fade, false); }\n    this.holdName = name;\n  }\n  /** A one-shot over the hold. Back to the hold when it ends. */\n  play(name, { speed = 1, fade = 0.06, keep = false, onEnd } = {}) {\n    const a = this.actions[name];\n    if (!a) return 0;\n    this.playCounts[name] = (this.playCounts[name] ?? 0) + 1;\n    const cur = this.action ?? this.actions[this.holdName];\n    a.reset();\n    const loop = this.clips[name].tracks.length && /(MapHold|TrackerUp|Wrench|Open)$/.test(name);\n    a.setLoop(loop ? LoopRepeat : LoopOnce, Infinity);\n    a.clampWhenFinished = true;\n    a.timeScale = speed;\n    a.setEffectiveWeight(1);\n    a.play();\n    if (cur && cur !== a) { cur.crossFadeTo(a, fade, false); }\n    this.action = a; this.actionName = name; this.keepAction = keep; this.onEnd = onEnd ?? null;\n    return this.clips[name].duration / speed;\n  }\n  endAction(fade = 0.15) {\n    const a = this.action; if (!a) return;\n    const h = this.actions[this.holdName];\n    h.enabled = true; h.setEffectiveWeight(1); h.play();\n    a.crossFadeTo(h, fade, false);\n    this.action = null; this.actionName = ''; this.keepAction = false;\n    const f = this.onEnd; this.onEnd = null;\n    f?.();\n  }\n  fire() {\n    this.kick = 1; this.flash = 1;\n    const id = this.gunId;\n    if (id === 'mule' || id === 'empire') this.pumpAfter = 0.32;\n  }\n  update(ctx, dt, realDt) {\n    const g = this.game;\n    this.mixer.update(dt);\n    if (this.action && !this.keepAction) {\n      const a = this.action;\n      if (a.loop !== LoopRepeat && (!a.isRunning() || a.time >= this.clips[this.actionName].duration - 1e-3)) this.endAction();\n    }\n    if (this.pumpAfter > 0) { this.pumpAfter -= dt; if (this.pumpAfter <= 0 && !this.action) { this.play(this.gunId === 'empire' ? 'UnjamPistol' : 'UnjamRifle', { speed: 1.6 }); g.sfx.play('gun-rack', { volume: 0.45 }); } }\n    // Procedural over the mixer: bob, sway, kick, ADS, fever swim.\n    const p = g.player;\n    const t = g.time;\n    const a = g.weapons.aimT;\n    const bx = Math.cos(p.bob) * 0.012 * p.bobAmp * (1 - a * 0.85), by = Math.abs(Math.sin(p.bob)) * 0.014 * p.bobAmp * (1 - a * 0.85);\n    const swayX = Math.sin(t * 0.8) * 0.003, swayY = Math.sin(t * 1.3) * 0.003;\n    const md = ctx.input.mouseDelta;\n    this.lagX = lerp(this.lagX ?? 0, clamp(-md.x * 0.0004, -0.025, 0.025), 1 - Math.exp(-dt * 12));\n    this.lagY = lerp(this.lagY ?? 0, clamp(md.y * 0.0004, -0.02, 0.02), 1 - Math.exp(-dt * 12));\n    this.kick = lerp(this.kick, 0, 1 - Math.exp(-dt * 16));\n    this.flash = Math.max(0, this.flash - dt * 12);\n    const def = WEAPONS[this.gunId] ?? {};\n    const hardness = def.kick ? clamp(def.kick * 30, 0.2, 1.4) : 0;\n    // ADS: bring the weapon to centre. Rest is x 0.16, y -0.15; centre is x 0, y a little under the eye.\n    const adsX = -0.16 * a, adsY = (def.scoped ? 0.0 : 0.07) * a, adsZ = 0.12 * a;\n    const fever = g.body.swim ?? 0;\n    this.group.position.set(bx + swayX + this.lagX + adsX + Math.sin(t * 1.7) * 0.02 * fever, -by + swayY + this.lagY + adsY + Math.sin(t * 1.1) * 0.016 * fever - p.landDip * 0.6, this.kick * 0.05 * hardness + adsZ);\n    this.group.rotation.set(this.kick * 0.09 * hardness, 0, Math.sin(t * 0.9) * 0.012 * fever);\n    if (def.scoped && a > 0.6) this.root.visible = false; else this.root.visible = true;\n    this.updateWear();\n  }\n}\nEOF\ncat > src/combat/fx.js <<'EOF'\n// Feedback: impacts, tracers, flashes, marks. Pure presentation, driven by the sim's events; safe with no views.\nimport { THREE, Decals, Trail, glowMaterial, PALETTE, buildModel, setLookLayer } from '../../pixel-engine.js';\nimport { MODELS } from '../art/models.js';\nimport { clamp } from '../core/rng.js';\nconst { Vector3, Mesh, BoxGeometry, Group } = THREE;\nconst _n = new Vector3();\nexport class Fx {\n  tracers = []; markerT = 0; markerHead = false; pool = [];\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const p = ctx.particles;\n    p.register('blood', { count: [6, 12], life: [0.25, 0.6], speed: [1.5, 4], spread: 50, gravity: 12, size: [1, 1], colors: ['red', 'red', 'plum'], max: 300 });\n    p.register('dirt-hit', { count: [4, 8], life: [0.2, 0.5], speed: [1.5, 3.5], spread: 40, gravity: 10, size: [1, 1], colors: ['sand', 'orange', 'plum'], max: 200 });\n    p.register('spark', { count: [4, 8], life: [0.1, 0.3], speed: [3, 7], spread: 60, gravity: 10, size: [1, 1], colors: ['white', 'sand', 'orange'], max: 300 });\n    p.register('blast', { count: [24, 36], life: [0.4, 0.9], speed: [5, 14], spread: 180, gravity: 4, drag: 2, size: [3, 1], colors: ['white', 'sand', 'orange', 'red', 'night'], max: 300 });\n    p.register('gun-smoke', { count: [1, 2], life: [0.4, 0.8], speed: [0.3, 0.8], direction: [0, 1, 0], spread: 30, gravity: -0.4, size: [1, 2], colors: ['mist', 'slate'], max: 80 });\n    p.register('flame-jet', { count: [2, 3], life: [0.12, 0.3], speed: [10, 16], spread: 7, gravity: -2, size: [3, 1], colors: ['white', 'sand', 'orange', 'red'], max: 300 });\n    p.register('vehicle-smoke', { count: [1, 2], life: [0.8, 1.6], speed: [1, 2], direction: [0, 1, 0], spread: 16, gravity: -1, size: [2, 5], colors: ['night', 'slate', 'mist'], max: 200 });\n    p.register('vehicle-flame', { count: [1, 3], life: [0.2, 0.5], speed: [1.5, 3], direction: [0, 1, 0], spread: 20, gravity: -3, size: [2, 1], colors: ['white', 'sand', 'orange', 'red'], max: 200 });\n    p.register('dust-wind', { count: [2, 3], life: [1, 2.2], speed: [3, 7], direction: [1, 0.05, 0], spread: 10, size: [1, 2], colors: ['sand', 'orange'], radius: 22, max: 300 });\n    p.register('wrench-spark', { count: [3, 5], life: [0.1, 0.25], speed: [2, 4], spread: 70, gravity: 10, size: [1, 1], colors: ['white', 'sand'], max: 80 });\n    if (this.game.views) this.decals = new Decals(ctx.scene, { capacity: 96 });\n    this.tracerMat = glowMaterial(PALETTE.sand);\n  }\n  impact(x, y, z, normal, kind, opts = {}) {\n    const g = this.game;\n    const name = kind === 'flesh' ? 'blood' : kind === 'metal' ? 'spark' : 'dirt-hit';\n    if (!opts.silent) {\n      g.ctx.particles.burst(name, [x, y, z], { direction: [normal?.x ?? 0, normal?.y ?? 1, normal?.z ?? 0] });\n      const d = Math.hypot(x - g.camPos.x, z - g.camPos.z);\n      if (kind === 'flesh') g.sfx.at('hit-flesh', x, z, { max: 40, volume: 0.6 });\n      else if (kind === 'metal') g.sfx.at('hit-metal', x, z, { max: 50, volume: 0.6 });\n      else if (d < 30 && g.rng.fx.chance(0.2)) g.sfx.at('ricochet', x, z, { max: 40, volume: 0.45 });\n    }\n    if (kind === 'flesh') g.ctx.engine.hitstop(0.02);\n    if (kind === 'dirt' && this.decals && normal) this.decals.add('crack', { x, y, z }, normal, { size: 0.25 });\n  }\n  tracerFromView(x, y, z) {\n    const eye = this.game.player.eye;\n    this.tracer(eye.x, eye.y - 0.12, eye.z, x, y, z);\n  }\n  tracer(ax, ay, az, bx, by, bz) {\n    if (!this.game.views) return;\n    const l = Math.hypot(bx - ax, by - ay, bz - az);\n    const m = this.pool.pop() ?? new Mesh(new BoxGeometry(0.035, 0.035, 1), this.tracerMat);\n    m.scale.z = Math.min(l, 8);\n    m.position.set(ax, ay, az);\n    m.lookAt(bx, by, bz);\n    this.game.ctx.scene.add(m);\n    this.tracers.push({ m, ax, ay, az, dx: (bx - ax) / l, dy: (by - ay) / l, dz: (bz - az) / l, l, t: 0, speed: 240 });\n  }\n  hitMarker(head) { this.markerT = 0.16; this.markerHead = head; this.game.sfx.play('hit-marker', { volume: 0.3 }); this.game.rumble(0.25, 0.04); }\n  muzzleFlash(def) {\n    const g = this.game;\n    if (!g.views) return;\n    const e = g.player.eye;\n    g.ctx.lights.request({ position: [e.x, e.y, e.z], color: 0xffd090, intensity: 18, radius: 14, lifetime: 0.06, fadeIn: 0, fadeOut: 0.05 });\n    g.hud.muzzle = 0.05;\n    const m = g.vm.named?.flash;\n    if (m) m.visible = true;\n  }\n  gunSmoke() { const g = this.game, e = g.player.eye, f = g.player.forward(_n); g.ctx.particles.burst('gun-smoke', [e.x + f.x * 0.7, e.y - 0.1 + f.y * 0.7, e.z + f.z * 0.7]); }\n  flamerStream(eye, fwd) {\n    const g = this.game;\n    g.ctx.particles.burst('flame-jet', [eye.x + fwd.x * 0.9, eye.y + fwd.y * 0.9 - 0.14, eye.z + fwd.z * 0.9], { direction: [fwd.x, fwd.y + 0.02, fwd.z] });\n    if (g.views && !this.flameLight?.alive) this.flameLight = g.ctx.lights.request({ position: [eye.x, eye.y, eye.z], color: 0xff7a30, intensity: 18, radius: 22, lifetime: 0.25, flicker: 'torch' });\n    else if (this.flameLight) { this.flameLight.lifetime = 0.25; this.flameLight.position.set(eye.x + fwd.x * 4, eye.y, eye.z + fwd.z * 4); }\n  }\n  explosion(x, y, z, r) {\n    const g = this.game, ctx = g.ctx;\n    ctx.particles.burst('blast', [x, y, z], { count: Math.round(clamp(r * 6, 18, 60)) });\n    ctx.particles.burst('fire-smoke', [x, y, z], { count: Math.round(clamp(r * 3, 8, 28)) });\n    if (g.views) {\n      ctx.lights.request({ position: [x, y + 2, z], color: 0xffa040, intensity: clamp(r * 8, 20, 60), radius: r * 5, lifetime: 0.35, fadeIn: 0 });\n      ctx.engine.screen.shockwave([x, y, z], { radius: clamp(r * 0.03, 0.15, 0.5) });\n      if (!g.settings.reduceFlashes && Math.hypot(x - g.camPos.x, z - g.camPos.z) < r * 6) ctx.engine.screen.flash('white', { duration: 0.08 });\n    }\n    g.sfx.at(r > 8 ? 'explosion-big' : 'explosion', x, z, { max: r > 8 ? 500 : 300, volume: 1 });\n    g.rumble(0.8, 0.25);\n  }\n  scorch(x, y, z, r) { if (this.decals) this.decals.add('scorch', { x, y: y + 0.05, z }, { x: 0, y: 1, z: 0 }, { size: r }); }\n  chargeProp(x, y, z) {\n    const g = this.game;\n    if (!g.views) return null;\n    const m = new Mesh(new BoxGeometry(0.34, 0.14, 0.24), glowMaterial(PALETTE.plum));\n    m.position.set(x, y + 0.07, z);\n    g.ctx.scene.add(m);\n    return m;\n  }\n  removeProp(o) { if (o) this.game.ctx.scene.remove(o); }\n  update(ctx, dt) {\n    this.markerT = Math.max(0, this.markerT - dt);\n    for (let i = this.tracers.length - 1; i >= 0; i--) {\n      const t = this.tracers[i];\n      t.t += dt * t.speed;\n      if (t.t >= t.l) { ctx.scene.remove(t.m); this.pool.push(t.m); this.tracers.splice(i, 1); continue; }\n      t.m.position.set(t.ax + t.dx * t.t, t.ay + t.dy * t.t, t.az + t.dz * t.t);\n    }\n    this.decals?.update(dt);\n  }\n}\nEOF\ncat > src/body/health.js <<'EOF'\n// Your body: five segments, syrettes, four field surgeries, burning, going down, and blackwater fever on a timetable.\nimport { THREE } from '../../pixel-engine.js';\nimport { TUNING } from '../core/tuning.js';\nimport { clamp, lerp } from '../core/rng.js';\nconst SURGERIES = [\n  { clip: 'Surgery1', props: ['p-pliers', 'w-arm'], extra: 'p-bullet', sounds: [[0.8, 'pliers'], [1.6, 'grunt'], [2.1, 'pliers'], [2.7, 'grunt-big']], blood: [2.8] , line: 'PLIERS.' },\n  { clip: 'Surgery2', props: ['p-knife', 'w-thigh'], leg: true, sounds: [[1, 'knife-dig'], [1.8, 'grunt'], [2.3, 'knife-dig'], [2.9, 'grunt-big']], blood: [1.3, 2.5], line: 'THERE IS METAL IN THE THIGH.' },\n  { clip: 'Surgery3', props: [], sounds: [[2.1, 'finger-snap'], [2.2, 'grunt-big']], blood: [], line: 'THE FINGER GOES BACK.' },\n  { clip: 'Surgery4', props: ['p-lighter', 'p-flame', 'w-burn'], sounds: [[0.6, 'lighter'], [1.4, 'cauterise'], [2.1, 'grunt'], [2.8, 'grunt-big']], blood: [], line: 'SKIN IS ONLY A SUGGESTION.' },\n];\nconst FEVER_LINES = ['THE FEVER.', 'THE FEVER AGAIN.', 'THE GROUND MOVES. IT IS NOT THE GROUND.', 'THE TIMETABLE RUNS ON TIME.', 'YOU ARE LATE ALREADY.'];\nexport class Body {\n  hp = 100; syrettes = 3; maxSyrettes = 3; tablets = 0; lastHit = -99; burning = 0; burnClear = 0; heartT = 0; syretteT = 0; syretteLock = 0; surgery = null; surgeryT = 0; surgeryIndex = 0; lastDamage = 'bullet'; dead = false; swim = 0;\n  fever = 'none'; feverIn = 0; feverT = 0; feverAct = 1; feverOn = false; tabletHold = 0; clearT = 0; feverLineN = 0; heartVoice = null; colorDrain = 0; downT = 0; healHold = 0; heartbeatT = 0; burnScreen = 0; hurtFlash = 0; lastDir = 0;\n  constructor(game) { this.game = game; }\n  get segments() { return Math.ceil(this.hp / 20); }\n  moveFactor() { return this.surgery ? 0 : (this.feverOn ? 0.82 : 1); }\n  resetAll() {\n    this.hp = 100; this.syrettes = 3; this.maxSyrettes = 3; this.tablets = 0; this.burning = 0; this.surgery = null; this.dead = false; this.fever = 'none'; this.feverOn = false; this.swim = 0; this.feverIn = 0; this.feverAct = 1; this.colorDrain = 0; this.hurtFlash = 0; this.burnScreen = 0; this.lastHit = -99;\n  }\n  scheduleFever() {\n    const r = this.game.rng.fever;\n    const shrink = this.feverAct - 1;\n    this.feverIn = Math.max(1, TUNING.feverMinutes - shrink + r.range(-2, 2)) * 60;\n  }\n  hurt(amount, kind = 'bullet', from, opts) {\n    const g = this.game;\n    if (g.dev.god || this.dead || g.player.seat?.invuln) return;\n    const a = amount * TUNING.playerDamageTaken;\n    if (a <= 0) return;\n    this.hp = Math.max(0, this.hp - a);\n    this.lastHit = g.time;\n    this.lastDamage = kind;\n    this.hurtFlash = 1;\n    if (from) { const dx = from[0] - g.player.feet.x, dz = from[1] - g.player.feet.z; this.lastDir = Math.atan2(dx, dz); this.dirFlash = 1; }\n    g.sfx.play(kind === 'fire' ? 'grunt' : 'grunt', { volume: 0.5, pitch: g.rng.fx.range(-2, 2) });\n    g.ctx.engine.shake.add(clamp(a * 0.02, 0.05, 0.4));\n    g.rumble(0.5, 0.1);\n    g.hudTouch('health');\n    if (this.surgery && kind !== 'fire') this.interruptSurgery();\n    if (this.hp <= 0) this.down();\n  }\n  catchFire() {\n    if (this.game.dev.god) return;\n    if (this.burning <= 0) { this.game.sfx.play('grunt-big', { volume: 0.6 }); this.game.events.emit('player-burning'); }\n    this.burning = 1; this.burnClear = 0;\n  }\n  useSyrette() {\n    const g = this.game;\n    if (this.syrettes <= 0 || this.syretteT > 0 || this.surgery) return false;\n    this.syretteT = 0.8;\n    g.vm.showProp('p-syrette');\n    g.vm.named.Leg.visible = true;\n    g.vm.play('Syrette', { onEnd: () => { g.vm.named.Leg.visible = false; g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); } });\n    g.sfx.play('syrette', { volume: 0.7 });\n    return true;\n  }\n  startSurgery() {\n    const g = this.game;\n    if (this.surgery || this.dead) return false;\n    let which = this.surgeryIndex++ % 3;\n    if (this.lastDamage === 'fire') which = 3;\n    const s = SURGERIES[which];\n    this.surgery = s; this.surgeryT = 0; this.surgeryKind = which;\n    this.surgerySounds = [...s.sounds]; this.surgeryBlood = [...s.blood];\n    g.vm.showProp(...s.props);\n    if (s.leg) g.vm.named.Leg.visible = true;\n    const dur = g.vm.play(s.clip, { keep: true });\n    this.surgeryDur = dur;\n    g.events.emit('surgery', which);\n    g.say('', s.line, 2.2);\n    return true;\n  }\n  interruptSurgery() {\n    const g = this.game;\n    this.surgery = null;\n    g.vm.named.Leg.visible = false;\n    g.vm.endAction();\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    g.notice('INTERRUPTED', 1.2);\n  }\n  finishSurgery() {\n    const g = this.game;\n    this.surgery = null;\n    this.hp = Math.max(this.hp, 40);\n    g.vm.named.Leg.visible = false;\n    g.vm.endAction();\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    g.hudTouch('health');\n    g.events.emit('surgery-done');\n  }\n  down() {\n    const g = this.game;\n    if (this.dead) return;\n    this.interruptIfAny();\n    g.events.emit('player-down');\n    if (g.round) { g.round.localDown(); return; }\n    const buddy = g.actors.rescuer();\n    if (buddy) g.actors.startRescue(buddy);\n    else { this.dead = true; g.gameOver(); }\n  }\n  interruptIfAny() { if (this.surgery) this.interruptSurgery(); }\n  fixedUpdate(ctx, dt) {\n    const g = this.game, a = g.actions;\n    const time = g.time;\n    // Regeneration only to the top of the current segment, 5 s after damage.\n    if (time - this.lastHit > 5 && this.hp > 0 && !this.burning) {\n      const top = Math.min(100, Math.ceil(this.hp / 20) * 20);\n      if (this.hp < top) this.hp = Math.min(top, this.hp + dt * 6);\n    }\n    // Burning.\n    if (this.burning > 0) {\n      const onFuel = g.fire.state[g.fire.idOf(g.player.feet.x, g.player.feet.z)] === 1;\n      if (!onFuel) this.burnClear += dt; else this.burnClear = 0;\n      if (g.player.wading || this.burnClear >= 2) this.burning = 0;\n      else this.hurt(TUNING.fireDamage * dt, 'fire');\n      this.burnScreen = 1;\n    } else this.burnScreen = Math.max(0, this.burnScreen - dt * 2);\n    this.hurtFlash = Math.max(0, this.hurtFlash - dt * 3);\n    if (this.dirFlash > 0) this.dirFlash -= dt * 1.4;\n    // Syrette and surgery.\n    if (this.syretteT > 0) {\n      this.syretteT -= dt;\n      if (this.syretteT <= 0) { this.syrettes--; this.hp = Math.min(100, this.hp + 40); g.hudTouch('health'); g.events.emit('syrette'); }\n    }\n    if (g.canAct() && !g.mapUp) {\n      if (a.take('heal')) {\n        if (this.hp < 20) this.startSurgery();\n        else if (this.syrettes > 0 && this.hp < 100) this.useSyrette();\n        else if (this.syrettes <= 0) { g.notice('NO SYRETTES', 1.2); }\n      }\n    }\n    if (this.surgery) {\n      this.surgeryT += dt;\n      while (this.surgerySounds.length && this.surgerySounds[0][0] <= this.surgeryT) { const [, s] = this.surgerySounds.shift(); g.sfx.play(s, { volume: 0.8 }); }\n      while (this.surgeryBlood.length && this.surgeryBlood[0] <= this.surgeryT) { this.surgeryBlood.shift(); const e = g.player.eye, f = g.player.forward(); ctx.particles.burst('blood', [e.x + f.x * 0.45, e.y + f.y * 0.45 - 0.05, e.z + f.z * 0.45], { count: 18, direction: [0, 0.3, 0] }); }\n      if (this.surgery.extra && this.surgeryT > 2.8) g.vm.named[this.surgery.extra].visible = true;\n      if (this.surgeryT >= this.surgeryDur) this.finishSurgery();\n    }\n    // Heartbeat below 20.\n    const low = this.hp < 20 && this.hp > 0;\n    this.colorDrain = lerp(this.colorDrain, low ? 1 : 0, 1 - Math.exp(-dt * 3));\n    if (low) { this.heartbeatT -= dt; if (this.heartbeatT <= 0) { this.heartbeatT = 0.8; g.sfx.play('heartbeat', { volume: 0.8 }); g.rumble(0.3, 0.05); } }\n    this.feverStep(ctx, dt);\n  }\n  feverStep(ctx, dt) {\n    const g = this.game, a = g.actions;\n    if (g.round || g.dev.noFever) { if (this.feverOn) this.clearFever(); return; }\n    if (!g.story.feverRunning) return;\n    if (this.fever === 'none') {\n      if (!g.actors.scriptedFeverHold) this.feverIn -= dt;\n      if (this.feverIn <= 0) this.startFever();\n    } else if (this.fever === 'on') {\n      this.feverT += dt;\n      this.swim = lerp(this.swim, g.settings.feverReduced ? 0.4 : 1, 1 - Math.exp(-dt * 1.2));\n      this.heartbeatT -= dt;\n      if (this.heartbeatT <= 0) { this.heartbeatT = 0.9; g.sfx.play('heartbeat', { volume: 0.6 }); }\n      // Tablet: hold 1 s.\n      if (g.canAct() && a.down('tablet') && this.tablets > 0) {\n        if (this.tabletHold === 0) { g.vm.showProp('p-tablet', 'p-pill'); g.vm.play('Tablet', { onEnd: () => g.vm.showGun(g.weapons.gun?.id ?? 'cane', false) }); g.sfx.play('tablet-bottle', { volume: 0.6 }); }\n        this.tabletHold += dt;\n        if (this.tabletHold >= 1) { this.tablets--; this.tabletHold = 0; this.fever = 'clearing'; this.clearT = 5; g.events.emit('tablet'); g.sfx.play('tablet-swallow', { volume: 0.5 }); g.hudTouch('health'); }\n      } else this.tabletHold = 0;\n      const limit = this.feverLimit ?? 25;\n      if (this.feverT > limit) this.collapse();\n    } else if (this.fever === 'clearing') {\n      this.clearT -= dt;\n      this.swim = lerp(this.swim, 0, 1 - Math.exp(-dt * 1.4));\n      if (this.clearT <= 0) this.clearFever();\n    }\n    this.bodySway = this.swim;\n    const cam = g.cam;\n    if (this.swim > 0.01) {\n      const t = g.time;\n      cam.roll = Math.sin(t * 0.7) * 0.05 * this.swim;\n      cam.kickYaw += Math.sin(t * 0.9) * 0.0012 * this.swim;\n      cam.kickPitch += Math.cos(t * 1.1) * 0.0009 * this.swim;\n    } else cam.roll = 0;\n  }\n  startFever(opts = {}) {\n    const g = this.game;\n    this.fever = 'on'; this.feverOn = true; this.feverT = 0; this.tabletHold = 0;\n    this.feverLimit = opts.limit ?? 25;\n    if (!opts.silent) g.say('', FEVER_LINES[this.feverLineN++ % FEVER_LINES.length], 3);\n    g.sfx.play('fever-onset', { volume: 0.7 });\n    g.music.setMood?.('fever');\n    g.events.emit('fever-start');\n  }\n  clearFever() {\n    const g = this.game;\n    this.fever = 'none'; this.feverOn = false; this.swim = 0; g.cam.roll = 0; this.bodySway = 0;\n    this.scheduleFever();\n    g.events.emit('fever-clear');\n    g.music.setMood?.(null);\n  }\n  /** Ignored for 25 s or no tablets: you wake at the nearest safehouse or the clinic hours later, with 20% of your stones gone. */\n  collapse() {\n    const g = this.game;\n    this.fever = 'none'; this.feverOn = false; this.swim = 0; g.cam.roll = 0;\n    this.scheduleFever();\n    g.events.emit('fever-collapse');\n    g.collapseAway();\n  }\n}\nEOF\necho ok","description":"Write player, damage, projectiles, weapons, viewmodel, effects, body"}}}
