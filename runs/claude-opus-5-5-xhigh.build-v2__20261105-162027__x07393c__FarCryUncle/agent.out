post' }, { group: [{ box: [8, 0.16, 0.16], at: [4, 0, 0], c: 'bar' }, ...[1, 3, 5, 7].map((x) => ({ box: [0.9, 0.18, 0.18], at: [x, 0, 0], c: 'bar2' }))], at: [-4, 1.25, 0], pivot: true, name: 'Boom' }, { box: [1.8, 2.4, 1.8], at: [-6, 1.2, 0], c: 'hut' }] });\nexport const fuelTank = model({ id: 'fuel-tank', about: 'A big rust-streaked fuel tank on legs with a red band', tags: ['target', 'explosive'], collider: 'cyl', palette: { tank: 'mist', band: 'red', leg: 'night', rust: 'orange' },\n  parts: [{ cyl: [5.6, 4.2, 5.6], at: [0, 3.1, 0], seg: 10, c: 'tank' }, { cyl: [5.7, 0.6, 5.7], at: [0, 3.6, 0], seg: 10, c: 'band' }, { cone: [5.6, 0.8, 5.6], at: [0, 5.6, 0], seg: 10, c: 'tank' }, ...[[-2, -2], [2, -2], [-2, 2], [2, 2]].map(([x, z]) => ({ box: [0.3, 1.1, 0.3], at: [x, 0.55, z], c: 'leg' })), { box: [1, 2, 0.08], at: [1, 2.4, 2.72], c: 'rust', collide: false }] });\nexport const oilDrum = model({ id: 'oil-drum', about: 'A dented oil drum with a red band', tags: ['explosive'], collider: 'cyl', palette: { drum: 'teal', band: 'red', top: 'night' }, parts: [{ cyl: [0.66, 0.95, 0.66], at: [0, 0.48, 0], seg: 8, c: 'drum' }, { cyl: [0.68, 0.14, 0.68], at: [0, 0.52, 0], seg: 8, c: 'band' }, { cyl: [0.5, 0.02, 0.5], at: [0, 0.96, 0], seg: 8, c: 'top' }] });\nexport const silo = model({ id: 'silo', about: 'A grain silo of ribbed tin with a cone cap', tags: ['building'], collider: 'cyl', palette: { tin: 'mist', rib: 'slate', cap: 'red' }, parts: [{ cyl: [6.4, 8.4, 6.4], at: [0, 4.2, 0], seg: 10, c: 'tin' }, ...[1.6, 3.8, 6].map((y) => ({ cyl: [6.5, 0.2, 6.5], at: [0, y, 0], seg: 10, c: 'rib' })), { cone: [6.8, 2.2, 6.8], at: [0, 9.5, 0], seg: 10, c: 'cap' }] });\nexport const waterTower = model({ id: 'water-tower', about: 'A steel water tower on four legs, rust down one side', tags: ['building'], collider: 'parts', palette: { tank: 'slate', leg: 'night', rust: 'red', cap: 'mist' },\n  parts: [...[[-2.4, -2.4], [2.4, -2.4], [-2.4, 2.4], [2.4, 2.4]].map(([x, z]) => ({ box: [0.3, 9, 0.3], at: [x, 4.5, z], c: 'leg' })), { cyl: [7, 3.8, 7], at: [0, 10.8, 0], seg: 10, c: 'tank', collide: false }, { cone: [7.2, 1.2, 7.2], at: [0, 13.3, 0], seg: 10, c: 'cap', collide: false }, { box: [1.2, 3, 0.1], at: [1.4, 10.6, 3.3], c: 'rust', collide: false }, { box: [5, 0.14, 0.14], at: [0, 5, -2.4], rot: [0, 0, 30], c: 'leg', collide: false }] });\nexport const pumpHouse = model({ id: 'pump-house', about: 'The pump house on the Mercy: brick, big pipe, a wheel valve', tags: ['building', 'target'], collider: 'parts', palette: { wall: 'red', roof: 'slate', pipe: 'teal', valve: 'orange', floor: 'night' },\n  parts: [...wallsOpen(8, 3.4, 6, 'wall', 2), { box: [8.8, 0.2, 6.8], at: [0, 3.5, 0], c: 'roof' }, { cyl: [0.9, 6, 0.9], at: [-5.5, 0.8, 0], rot: [0, 0, 90], seg: 8, c: 'pipe' }, { cyl: [0.7, 2.4, 0.7], at: [1.6, 1.2, -1.4], seg: 8, c: 'pipe' }, { torus: [0.9, 0.1, 0.9], at: [1.6, 1.8, 0], rot: [90, 0, 0], c: 'valve', collide: false }, { box: [7.6, 0.04, 5.6], at: [0, 0.02, 0], c: 'floor', collide: false }] });\nexport const clinicTent = model({ id: 'clinic-tent', about: 'The Mercy Mission clinic tent, canvas ridged, green cross on the roof', tags: ['building'], collider: 'parts', palette: { canvas: 'white', frame: 'mist', cross: 'green', floor: 'sand', bed: 'slate' },\n  parts: [{ wedge: [9, 2.2, 3.6], at: [0, 2.9, -1.8], c: 'canvas', rot: [0, 0, 0], collide: false }, { wedge: [9, 2.2, 3.6], at: [0, 2.9, 1.8], rot: [0, 180, 0], c: 'canvas', collide: false }, { box: [9, 1.8, 0.1], at: [0, 0.9, -3.6], c: 'canvas' }, { box: [0.1, 1.8, 7.2], at: [-4.5, 0.9, 0], c: 'canvas' }, { box: [0.1, 1.8, 7.2], at: [4.5, 0.9, 0], c: 'canvas', collide: true }, ...[[-3, -2], [0, -2], [3, -2]].map(([x, z]) => ({ box: [1.8, 0.5, 0.8], at: [x, 0.25, z], c: 'bed', collide: false })), { box: [2.2, 0.08, 0.6], at: [0, 4.05, -0.05], c: 'cross', collide: false }, { box: [0.6, 0.08, 2.2], at: [0, 4.05, 0], c: 'cross', collide: false }, { box: [9, 0.04, 7.2], at: [0, 0.02, 0], c: 'floor', collide: false }] });\nexport const station = model({ id: 'station', about: 'The Mile Forty platform with a canopy and a painted-over name board', tags: ['building'], collider: 'parts', palette: { stone: 'mist', roof: 'red', post: 'plum', sign: 'white', paint: 'slate' },\n  parts: [{ box: [34, 1, 6], at: [0, 0.5, 0], c: 'stone' }, ...[-12, -4, 4, 12].map((x) => ({ box: [0.28, 3, 0.28], at: [x, 2.5, -1.6], c: 'post', collide: false })), { box: [28, 0.2, 4.6], at: [0, 4.05, -1.2], rot: [4, 0, 0], c: 'roof', collide: false }, { box: [4.4, 0.8, 0.12], at: [0, 3.2, -1.4], c: 'sign', collide: false }, { box: [2.4, 0.5, 0.14], at: [0.6, 3.2, -1.4], c: 'paint', collide: false }] });\nexport const signalMast = model({ id: 'signal-mast', about: 'A railway signal mast with one arm down', tags: ['rail'], collider: 'cyl', palette: { post: 'night', arm: 'red', lamp: 'sand' }, parts: [{ box: [0.24, 6, 0.24], at: [0, 3, 0], c: 'post' }, { box: [1.4, 0.24, 0.08], at: [0.6, 5.4, 0], rot: [0, 0, -30], c: 'arm' }, { box: [0.3, 0.3, 0.3], at: [0, 6.1, 0], c: 'lamp', glow: true }] });\nexport const trigPillar = model({ id: 'trig-pillar', about: 'A white stone trig pillar with a brass plate on top', tags: ['landmark'], collider: 'box', palette: { stone: 'white', cap: 'mist', brass: 'sand' }, parts: [{ cyl: [0.9, 1.5, 0.9], at: [0, 0.75, 0], top: 0.7, seg: 4, c: 'stone' }, { box: [0.72, 0.12, 0.72], at: [0, 1.56, 0], c: 'cap' }, { cyl: [0.26, 0.05, 0.26], at: [0, 1.64, 0], seg: 8, c: 'brass' }] });\nexport const trigPillarBig = model({ id: 'trig-pillar-big', about: 'The Observatory’s reference pillar', tags: ['landmark'], collider: 'box', palette: { stone: 'mist', cap: 'white', brass: 'sand' }, parts: [{ cyl: [1.4, 2.4, 1.4], at: [0, 1.2, 0], top: 0.7, seg: 4, c: 'stone' }, { box: [1.1, 0.14, 1.1], at: [0, 2.46, 0], c: 'cap' }, { cyl: [0.4, 0.05, 0.4], at: [0, 2.56, 0], seg: 8, c: 'brass' }] });\nexport const radioMast = model({ id: 'radio-mast', about: 'A lattice radio mast with