{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012SsMwjJRhUHT2gu9hvDp4W","type":"tool_result","content":"14:8. Audio: `attenuation`, `AudioManager`, `AudioSettings`, `Instrument`, `Listener`, `muffleCutoff`, `noteFrequency`, `parseSong`, `PLAYGROUND_SONG`, `PlayOptions`, `renderSound`, `SFX`, `SfxName`, \n2507:### type Instrument\n2510:type Instrument = Omit<SoundDef, 'freq' | 'freqEnd' | 'sustain' | 'delay'>\n2591:- `tracks: Record<string, Instrument>`\n### type Instrument\n\n```ts\ntype Instrument = Omit<SoundDef, 'freq' | 'freqEnd' | 'sustain' | 'delay'>\n```\n\nA track's instrument: a SoundDef without pitch or length (each note sets those).\n\n### interface Listener\n\n- `position: V3Like`\n- `right: V3Like`: The listener's right, in world space (unit): the camera's right for a third-person game.\n\n### muffleCutoff\n\n2658:### type Wave\n2659-\n2660-```ts\n2661:type Wave = 'square' | 'triangle' | 'saw' | 'sine' | 'noise'\n2662-```\n2663-\n2664-Retro sound synthesis as pure functions (no Web Audio): a sound is data (`SoundDef`)\n2665-rendered to samples once, then played as a buffer. Deterministic (seeded noise), so\n2566:### SFX\n2567-\n2568-```ts\n2569-const SFX: { jump: { wave: \"square\"; duty: number; freq: number; freqEnd: number; attack: number; sustain: number; decay: number; volume: number; }; double\n2570-```\n{\"wave\":\"triangle\",\"freq\":150,\"freqEnd\":55,\"attack\":0.002,\"decay\":0.09,\"volume\":0.55,\"layers\":[{\"wave\":\"noise\",\"freq\":1400,\"freqEnd\":500,\"attack\":0.002,\"decay\":0.07,\"volume\":0.18}]} jump doubleJump land coin step skid punch groundPound whoosh hurt fanfare","is_error":false}]},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"a91bd0d4-b93c-49d3-8a39-62dcdac09419","timestamp":"2026-11-05T23:55:20.353Z","tool_use_result":{"stdout":"14:8. Audio: `attenuation`, `AudioManager`, `AudioSettings`, `Instrument`, `Listener`, `muffleCutoff`, `noteFrequency`, `parseSong`, `PLAYGROUND_SONG`, `PlayOptions`, `renderSound`, `SFX`, `SfxName`, \n2507:### type Instrument\n2510:type Instrument = Omit<SoundDef, 'freq' | 'freqEnd' | 'sustain' | 'delay'>\n2591:- `tracks: Record<string, Instrument>`\n### type Instrument\n\n```ts\ntype Instrument = Omit<SoundDef, 'freq' | 'freqEnd' | 'sustain' | 'delay'>\n```\n\nA track's instrument: a SoundDef without pitch or length (each note sets those).\n\n### interface Listener\n\n- `position: V3Like`\n- `right: V3Like`: The listener's right, in world space (unit): the camera's right for a third-person game.\n\n### muffleCutoff\n\n2658:### type Wave\n2659-\n2660-```ts\n2661:type Wave = 'square' | 'triangle' | 'saw' | 'sine' | 'noise'\n2662-```\n2663-\n2664-Retro sound synthesis as pure functions (no Web Audio): a sound is data (`SoundDef`)\n2665-rendered to samples once, then played as a buffer. Deterministic (seeded noise), so\n2566:### SFX\n2567-\n2568-```ts\n2569-const SFX: { jump: { wave: \"square\"; duty: number; freq: number; freqEnd: number; attack: number; sustain: number; decay: number; volume: number; }; double\n2570-```\n{\"wave\":\"triangle\",\"freq\":150,\"freqEnd\":55,\"attack\":0.002,\"decay\":0.09,\"volume\":0.55,\"layers\":[{\"wave\":\"noise\",\"freq\":1400,\"freqEnd\":500,\"attack\":0.002,\"decay\":0.07,\"volume\":0.18}]} jump doubleJump land coin step skid punch groundPound whoosh hurt fanfare","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012SsMwjJRhUHT2gu9hvDp4W","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkgeV7X2pt1w4NRLkDFV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MqtYLmkNwNFiQAiwqrvi3N","name":"Bash","input":{"command":"set -e\ncat > src/audio/sfx.js <<'EOF'\n// Everything you hear is written here as SoundDef data. No audio files anywhere.\nimport { spatialize } from '../../pixel-engine.js';\nimport { clamp } from '../core/rng.js';\nconst n = (freq, decay, volume, extra = {}) => ({ wave: 'noise', freq, decay, volume, attack: 0.001, ...extra });\nconst crack = (hiss, thump, tail, vol = 0.8) => ({ wave: 'noise', freq: hiss, freqEnd: hiss * 0.4, attack: 0.001, decay: 0.05, volume: vol, layers: [{ wave: 'sine', freq: thump, freqEnd: thump * 0.4, attack: 0.001, decay: 0.12, volume: vol * 0.9 }, { wave: 'noise', freq: 2400, freqEnd: 500, attack: 0.002, decay: tail, volume: vol * 0.4, delay: 0.02 }, { wave: 'square', duty: 0.25, freq: thump * 2.1, freqEnd: thump * 0.8, decay: 0.04, volume: vol * 0.25 }] });\nconst far = (hiss, thump, tail, vol = 0.5) => ({ wave: 'noise', freq: hiss * 0.25, freqEnd: hiss * 0.12, attack: 0.004, decay: 0.08, volume: vol, layers: [{ wave: 'sine', freq: thump * 0.7, freqEnd: thump * 0.35, decay: 0.2, volume: vol }, { wave: 'noise', freq: 600, freqEnd: 180, decay: tail * 1.5, volume: vol * 0.45, delay: 0.05 }] });\nconst metal = (freq, decay, volume, extra = {}) => ({ wave: 'square', duty: 0.125, freq, freqEnd: freq * 0.9, attack: 0.001, decay, volume, layers: [{ wave: 'noise', freq: 7000, decay: decay * 0.5, volume: volume * 0.7 }, { wave: 'triangle', freq: freq * 2.76, decay: decay * 0.8, volume: volume * 0.3 }], ...extra });\nconst step = (hiss, low, vol) => ({ wave: 'noise', freq: hiss, freqEnd: hiss * 0.5, attack: 0.002, decay: 0.07, volume: vol, layers: [{ wave: 'sine', freq: low, freqEnd: low * 0.6, decay: 0.06, volume: vol * 0.8 }] });\nexport const SOUNDS = {\n  // Guns: crack, thump, tail. A distant muffled variant for when someone else is shooting.\n  'gun-tractor': crack(5200, 170, 0.2, 0.8), 'gun-tractor-far': far(5200, 170, 0.2),\n  'gun-m38': crack(4200, 210, 0.16, 0.8), 'gun-m38-far': far(4200, 210, 0.16),\n  'gun-mule': crack(3000, 110, 0.34, 1), 'gun-mule-far': far(3000, 110, 0.34),\n  'gun-empire': crack(6200, 130, 0.5, 1), 'gun-empire-far': far(6200, 130, 0.5),\n  'gun-mg': crack(4800, 140, 0.14, 0.75), 'gun-mg-far': far(4800, 140, 0.14),\n  'gun-flare': { wave: 'noise', freq: 1500, freqEnd: 400, attack: 0.002, decay: 0.08, volume: 0.6, layers: [{ wave: 'sine', freq: 300, freqEnd: 120, decay: 0.1, volume: 0.6 }, { wave: 'noise', freq: 8000, attack: 0.03, sustain: 0.1, decay: 0.3, volume: 0.15, delay: 0.05 }] },\n  'flare-hiss': { wave: 'noise', freq: 9000, freqEnd: 5000, attack: 0.02, sustain: 0.5, decay: 0.8, volume: 0.3 },\n  'gun-tube': { wave: 'noise', freq: 1300, freqEnd: 240, attack: 0.003, sustain: 0.1, decay: 0.5, volume: 0.8, layers: [{ wave: 'sine', freq: 120, freqEnd: 45, decay: 0.3, volume: 0.9 }] },\n  'flamer-start': { wave: 'noise', freq: 3000, freqEnd: 800, attack: 0.01, decay: 0.3, volume: 0.6, layers: [{ wave: 'sine', freq: 90, decay: 0.2, volume: 0.5 }] },\n  'flamer-loop': { wave: 'noise', freq: 1800, attack: 0.02, sustain: 0.9, decay: 0.02, volume: 0.55, vibrato: { depth: 3, rate: 13 }, layers: [{ wave: 'noise', freq: 500, attack: 0.02, sustain: 0.9, decay: 0.02, volume: 0.5 }, { wave: 'saw', freq: 62, attack: 0.02, sustain: 0.9, decay: 0.02, volume: 0.12 }] },\n  'gun-jam': { wave: 'square', duty: 0.125, freq: 1400, freqEnd: 900, decay: 0.03, volume: 0.45, layers: [{ wave: 'noise', freq: 6000, decay: 0.015, volume: 0.35 }] },\n  'gun-slap': { wave: 'noise', freq: 2800, freqEnd: 900, decay: 0.05, volume: 0.6, layers: [{ wave: 'sine', freq: 200, freqEnd: 90, decay: 0.05, volume: 0.45 }] },\n  'gun-rack': metal(820, 0.05, 0.42, { layers: [{ wave: 'noise', freq: 7000, decay: 0.03, volume: 0.35 }, { wave: 'square', duty: 0.125, freq: 1200, freqEnd: 700, decay: 0.05, volume: 0.32, delay: 0.09 }, { wave: 'noise', freq: 5000, decay: 0.03, volume: 0.28, delay: 0.09 }] }),\n  'gun-mag': metal(520, 0.06, 0.36, { layers: [{ wave: 'noise', freq: 3000, decay: 0.04, volume: 0.3 }, { wave: 'square', duty: 0.25, freq: 700, decay: 0.04, volume: 0.28, delay: 0.18 }] }),\n  'gun-shell': { wave: 'square', duty: 0.25, freq: 620, freqEnd: 460, decay: 0.04, volume: 0.34, layers: [{ wave: 'noise', freq: 3500, decay: 0.03, volume: 0.25 }, { wave: 'sine', freq: 180, decay: 0.05, volume: 0.25, delay: 0.05 }] },\n  'gun-cylinder': { wave: 'square', duty: 0.125, freq: 1700, decay: 0.02, volume: 0.3, layers: [0.1, 0.2, 0.3, 0.42].map((d) => ({ wave: 'square', duty: 0.125, freq: 1500, decay: 0.02, volume: 0.28, delay: d })) },\n  'gun-equip': metal(400, 0.05, 0.28), 'gun-rattle': { wave: 'noise', freq: 4000, decay: 0.02, volume: 0.22, layers: [0.04, 0.09].map((d) => ({ wave: 'square', duty: 0.125, freq: 900, decay: 0.015, volume: 0.2, delay: d })) },\n  'gun-apart': { wave: 'square', duty: 0.25, freq: 340, freqEnd: 120, decay: 0.18, volume: 0.5, layers: [{ wave: 'noise', freq: 5000, decay: 0.12, volume: 0.5 }, { wave: 'square', duty: 0.125, freq: 900, decay: 0.05, volume: 0.35, delay: 0.16 }, { wave: 'square', duty: 0.125, freq: 680, decay: 0.05, volume: 0.32, delay: 0.3 }, { wave: 'square', duty: 0.125, freq: 500, decay: 0.04, volume: 0.25, delay: 0.46 }] },\n  'bottle-smash': { wave: 'noise', freq: 9500, freqEnd: 3000, decay: 0.2, volume: 0.6, layers: [{ wave: 'square', duty: 0.125, freq: 2500, freqEnd: 1800, decay: 0.08, volume: 0.25 }, { wave: 'noise', freq: 1600, attack: 0.05, sustain: 0.1, decay: 0.5, volume: 0.42, delay: 0.05 }] },\n  explosion: { wave: 'noise', freq: 900, freqEnd: 120, attack: 0.002, sustain: 0.04, decay: 0.7, volume: 1, layers: [{ wave: 'sine', freq: 90, freqEnd: 30, attack: 0.002, sustain: 0.05, decay: 0.55, volume: 1 }, { wave: 'noise', freq: 3000, decay: 0.08, volume: 0.6 }] },\n  'explosion-big': { wave: 'noise', freq: 600, freqEnd: 70, attack: 0.002, sustain: 0.1, decay: 1.5, volume: 1, layers: [{ wave: 'sine', freq: 70, freqEnd: 22, attack: 0.002, sustain: 0.1, decay: 1.2, volume: 1 }, { wave: 'noise', freq: 2400, decay: 0.15, volume: 0.6 }] },\n  ricochet: { wave: 'sine', freq: 2100, freqEnd: 760, decay: 0.28, volume: 0.28, vibrato: { depth: 1.5, rate: 40 } },\n  'bullet-whip': { wave: 'noise', freq: 7000, freqEnd: 2200, attack: 0.03, decay: 0.08, volume: 0.42 },\n  'hit-flesh': { wave: 'noise', freq: 900, freqEnd: 240, decay: 0.07, volume: 0.6, layers: [{ wave: 'sine', freq: 130, freqEnd: 70, decay: 0.08, volume: 0.6 }] },\n  'hit-metal': { wave: 'square', duty: 0.125, freq: 2300, freqEnd: 1500, decay: 0.09, volume: 0.32, layers: [{ wave: 'noise', freq: 7000, decay: 0.04, volume: 0.4 }, { wave: 'sine', freq: 3400, decay: 0.12, volume: 0.15 }] },\n  'hit-marker': { wave: 'square', duty: 0.25, freq: 2000, decay: 0.025, volume: 0.25 },\n  'knife-swing': { wave: 'noise', freq: 4000, freqEnd: 1500, attack: 0.03, decay: 0.09, volume: 0.45 },\n  whoosh: { wave: 'noise', freq: 1600, freqEnd: 700, attack: 0.05, decay: 0.14, volume: 0.4 },\n  land: { wave: 'sine', freq: 140, freqEnd: 60, decay: 0.09, volume: 0.5, layers: [{ wave: 'noise', freq: 1400, freqEnd: 500, decay: 0.07, volume: 0.2 }] },\n  crash: { wave: 'noise', freq: 2400, freqEnd: 300, decay: 0.4, volume: 0.9, layers: [{ wave: 'square', duty: 0.25, freq: 240, freqEnd: 80, decay: 0.25, volume: 0.5 }, { wave: 'square', duty: 0.125, freq: 900, decay: 0.08, volume: 0.4, delay: 0.1 }] },\n  // Feet.\n  'step-dirt': step(1500, 95, 0.4), 'step-grass': step(3800, 80, 0.3), 'step-road': step(1100, 130, 0.42), 'step-wood': { wave: 'sine', freq: 190, freqEnd: 120, decay: 0.07, volume: 0.5, layers: [{ wave: 'noise', freq: 1000, decay: 0.03, volume: 0.25 }] }, 'step-water': { wave: 'noise', freq: 2400, freqEnd: 800, attack: 0.01, decay: 0.15, volume: 0.42, layers: [{ wave: 'sine', freq: 300, freqEnd: 180, attack: 0.01, decay: 0.08, volume: 0.25 }] },\n  // Body.\n  breath: { wave: 'noise', freq: 1700, freqEnd: 900, attack: 0.12, sustain: 0.1, decay: 0.3, volume: 0.22 },\n  heartbeat: { wave: 'sine', freq: 62, freqEnd: 44, decay: 0.11, volume: 0.9, layers: [{ wave: 'sine', freq: 56, freqEnd: 40, decay: 0.11, volume: 0.65, delay: 0.2 }] },\n  syrette: { wave: 'noise', freq: 8200, freqEnd: 5200, attack: 0.03, sustain: 0.28, decay: 0.2, volume: 0.32, layers: [{ wave: 'sine', freq: 500, freqEnd: 300, decay: 0.02, volume: 0.2 }] },\n  pliers: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 500, decay: 0.05, volume: 0.32, layers: [{ wave: 'noise', freq: 1800, decay: 0.22, volume: 0.3, delay: 0.02 }] },\n  'knife-dig': { wave: 'noise', freq: 1100, freqEnd: 600, attack: 0.02, sustain: 0.1, decay: 0.16, volume: 0.42, layers: [{ wave: 'sine', freq: 180, freqEnd: 100, decay: 0.16, volume: 0.38 }] },\n  'finger-snap': { wave: 'noise', freq: 6000, freqEnd: 1200, decay: 0.02, volume: 0.9, layers: [{ wave: 'square', duty: 0.125, freq: 1200, decay: 0.012, volume: 0.6 }] },\n  lighter: { wave: 'square', duty: 0.125, freq: 2600, decay: 0.012, volume: 0.32, layers: [{ wave: 'noise', freq: 5000, attack: 0.02, sustain: 0.5, decay: 0.2, volume: 0.12, delay: 0.05 }] },\n  cauterise: { wave: 'noise', freq: 9000, freqEnd: 6000, attack: 0.03, sustain: 0.8, decay: 0.3, volume: 0.32 },\n  'tablet-bottle': { wave: 'noise', freq: 7500, decay: 0.02, volume: 0.28, layers: [0.05, 0.11, 0.18, 0.28].map((d) => ({ wave: 'square', duty: 0.125, freq: 2500, decay: 0.012, volume: 0.22, delay: d })) },\n  'tablet-swallow': { wave: 'sine', freq: 220, freqEnd: 90, attack: 0.02, decay: 0.2, volume: 0.42 },\n  grunt: { wave: 'saw', freq: 165, freqEnd: 105, attack: 0.01, decay: 0.16, volume: 0.42, layers: [{ wave: 'sine', freq: 620, freqEnd: 480, decay: 0.12, volume: 0.15 }, { wave: 'noise', freq: 1200, decay: 0.08, volume: 0.15 }] },\n  'grunt-big': { wave: 'saw', freq: 200, freqEnd: 85, attack: 0.02, sustain: 0.05, decay: 0.32, volume: 0.5, layers: [{ wave: 'sine', freq: 760, freqEnd: 420, sustain: 0.05, decay: 0.28, volume: 0.2 }, { wave: 'noise', freq: 1500, decay: 0.2, volume: 0.2 }] },\n  'fever-onset': { wave: 'sine', freq: 300, freqEnd: 180, attack: 0.5, sustain: 0.6, decay: 1, volume: 0.25, vibrato: { depth: 1.5, rate: 3 }, layers: [{ wave: 'sine', freq: 307, freqEnd: 184, attack: 0.5, sustain: 0.6, decay: 1, volume: 0.25 }] },\n  // Loops.\n  'fire-loop': { wave: 'noise', freq: 1100, attack: 0.04, sustain: 1.1, decay: 0.04, volume: 0.6, layers: [{ wave: 'noise', freq: 420, attack: 0.04, sustain: 1.1, decay: 0.04, volume: 0.5 }, ...[0.15, 0.4, 0.62, 0.84, 1.02].map((d) => ({ wave: 'noise', freq: 6500, decay: 0.03, volume: 0.28, delay: d }))] },\n  'wind-loop': { wave: 'noise', freq: 620, freqEnd: 820, attack: 0.3, sustain: 1.6, decay: 0.3, volume: 0.32, vibrato: { depth: 2, rate: 0.7 } },\n  'insects-loop': { wave: 'sine', freq: 3600, attack: 0.01, sustain: 0.9, decay: 0.01, volume: 0.05, vibrato: { depth: 1.5, rate: 34 }, layers: [{ wave: 'sine', freq: 4300, attack: 0.1, sustain: 0.6, decay: 0.1, volume: 0.04, vibrato: { depth: 1, rate: 22 }, delay: 0.1 }] },\n  'birds-loop': { wave: 'sine', freq: 2600, freqEnd: 3200, attack: 0.01, decay: 0.08, volume: 0.1, arp: [0, 4, 7, 4], arpRate: 0.06, layers: [{ wave: 'sine', freq: 2100, freqEnd: 2400, decay: 0.1, volume: 0.09, delay: 0.9 }, { wave: 'sine', freq: 5100, decay: 0.8, attack: 0.3, volume: 0.03, vibrato: { depth: 1, rate: 40 }, delay: 0.3 }, { wave: 'sine', freq: 3000, freqEnd: 2500, decay: 0.08, volume: 0.09, arp: [0, 3, 0, 5], arpRate: 0.05, delay: 1.4 }] },\n  'rain-loop': { wave: 'noise', freq: 7000, attack: 0.1, sustain: 1.6, decay: 0.1, volume: 0.5, layers: [{ wave: 'noise', freq: 2200, attack: 0.1, sustain: 1.6, decay: 0.1, volume: 0.34 }] },\n  'engine-loop': { wave: 'saw', freq: 58, attack: 0.02, sustain: 0.8, decay: 0.02, volume: 0.42, layers: [{ wave: 'square', duty: 0.25, freq: 116, attack: 0.02, sustain: 0.8, decay: 0.02, volume: 0.14 }, { wave: 'noise', freq: 480, attack: 0.02, sustain: 0.8, decay: 0.02, volume: 0.14 }] },\n  // Trucks and rails.\n  gravel: { wave: 'noise', freq: 2100, decay: 0.1, volume: 0.28 }, brakes: { wave: 'noise', freq: 5200, freqEnd: 2800, attack: 0.03, sustain: 0.2, decay: 0.2, volume: 0.22 },\n  door: { wave: 'noise', freq: 900, freqEnd: 300, decay: 0.09, volume: 0.5, layers: [{ wave: 'square', duty: 0.25, freq: 260, freqEnd: 160, decay: 0.08, volume: 0.32 }] },\n  horn: { wave: 'square', duty: 0.5, freq: 330, attack: 0.02, sustain: 0.32, decay: 0.05, volume: 0.32, layers: [{ wave: 'square', duty: 0.5, freq: 415, attack: 0.02, sustain: 0.32, decay: 0.05, volume: 0.25 }] },\n  'starter-cough': { wave: 'noise', freq: 620, decay: 0.09, volume: 0.45, layers: [0.14, 0.3, 0.52, 0.7, 1].map((d, i) => ({ wave: 'saw', freq: 50 + i * 3, decay: 0.09, volume: 0.42, delay: d })) },\n  wrench: { wave: 'square', duty: 0.125, freq: 1100, freqEnd: 800, decay: 0.05, volume: 0.32, layers: [{ wave: 'noise', freq: 4000, decay: 0.03, volume: 0.28 }] },\n  'train-clack': { wave: 'noise', freq: 2000, decay: 0.04, volume: 0.5, layers: [{ wave: 'sine', freq: 110, decay: 0.07, volume: 0.5 }, { wave: 'noise', freq: 2000, decay: 0.04, volume: 0.4, delay: 0.14 }, { wave: 'sine', freq: 100, decay: 0.07, volume: 0.4, delay: 0.14 }] },\n  'train-whistle': { wave: 'square', duty: 0.5, freq: 523, freqEnd: 494, attack: 0.08, sustain: 0.9, decay: 0.35, volume: 0.22, layers: [{ wave: 'square', duty: 0.5, freq: 659, freqEnd: 622, attack: 0.08, sustain: 0.9, decay: 0.35, volume: 0.2 }, { wave: 'noise', freq: 6000, attack: 0.1, sustain: 0.9, decay: 0.3, volume: 0.08 }] },\n  // Hand things.\n  'map-paper': { wave: 'noise', freq: 5200, freqEnd: 2200, attack: 0.03, decay: 0.2, volume: 0.32, layers: [{ wave: 'noise', freq: 3200, decay: 0.06, volume: 0.22, delay: 0.14 }] },\n  'tracker-beep': { wave: 'square', duty: 0.5, freq: 1760, decay: 0.05, volume: 0.28 }, 'tracker-near': { wave: 'square', duty: 0.5, freq: 2640, decay: 0.05, volume: 0.32 },\n  'radio-squelch': { wave: 'noise', freq: 9000, attack: 0.002, sustain: 0.08, decay: 0.05, volume: 0.28, layers: [{ wave: 'square', duty: 0.125, freq: 1300, decay: 0.03, volume: 0.15, delay: 0.14 }] },\n  // Sky.\n  thunder: { wave: 'noise', freq: 400, freqEnd: 70, attack: 0.03, sustain: 0.25, decay: 2.3, volume: 0.9, layers: [{ wave: 'sine', freq: 56, freqEnd: 28, attack: 0.05, sustain: 0.3, decay: 1.8, volume: 0.8 }] },\n  'distant-fight': { wave: 'noise', freq: 800, freqEnd: 260, decay: 0.09, volume: 0.32, layers: [0.14, 0.26, 0.42, 0.9, 1.05, 1.18].map((d) => ({ wave: 'noise', freq: 620, freqEnd: 200, decay: 0.08, volume: 0.28, delay: d })) },\n  // UI.\n  'ui-move': { wave: 'triangle', freq: 660, decay: 0.03, volume: 0.18 }, 'ui-confirm': { wave: 'triangle', freq: 440, decay: 0.07, volume: 0.3, arp: [0, 5, 12], arpRate: 0.04 }, 'ui-back': { wave: 'triangle', freq: 440, freqEnd: 300, decay: 0.07, volume: 0.22 },\n  'ui-stone': { wave: 'triangle', freq: 880, decay: 0.15, volume: 0.28, arp: [0, 7, 12], arpRate: 0.05 },\n  'note-scratch': { wave: 'noise', freq: 6200, freqEnd: 4200, attack: 0.01, decay: 0.07, volume: 0.2, layers: [0.08, 0.17, 0.3].map((d) => ({ wave: 'noise', freq: 6000, decay: 0.04, volume: 0.16, delay: d })) },\n};\nexport class Sfx {\n  loops = new Map();\n  constructor(game) { this.game = game; }\n  build(ctx) { for (const [k, v] of Object.entries(SOUNDS)) ctx.audio.register(k, v); this.audio = ctx.audio; }\n  play(name, o) { return this.audio.play(name, o); }\n  /** A sound at a place in the world: gain and pan from where your head is. */\n  at(name, x, z, { max = 120, volume = 1, pitch, ref = 3 } = {}) {\n    const g = this.game;\n    const s = spatialize(g.listener(), [x, g.camPos.y, z], { max, ref });\n    if (s.gain <= 0.01) return false;\n    return this.audio.play(name, { volume: volume * s.gain, pan: s.pan, pitch });\n  }\n  startLoop(key, name, o) { if (!this.loops.has(key)) this.loops.set(key, this.audio.loop(name, o)); return this.loops.get(key); }\n  stopLoop(key) { const v = this.loops.get(key); if (v) { v.stop(); this.loops.delete(key); } }\n}\nEOF\ncat > src/audio/music.js <<'EOF'\n// Original songs as data: plucked pentatonic lines, thumb-piano timbres, noise hand drums, low drones. Defaults to 10% volume.\nimport { clamp } from '../core/rng.js';\nconst pluck = { wave: 'triangle', decay: 0.24, volume: 0.42 };\nconst thumb = { wave: 'sine', decay: 0.18, volume: 0.5, attack: 0.002 };\nconst drone = { wave: 'saw', attack: 0.3, decay: 0.8, volume: 0.09 };\nconst low = { wave: 'triangle', attack: 0.05, decay: 0.7, volume: 0.32 };\nconst drum = { wave: 'noise', decay: 0.06, volume: 0.24 };\nconst bass = { wave: 'saw', decay: 0.2, volume: 0.22 };\nexport const SONGS = {\n  title: { bpm: 66, tracks: { thumb, drone, low }, patterns: {\n    a: { thumb: 'A4 . . . C5 . E5 . . . D5 . C5 . . . A4 . . . G4 . . . E4 . . . . . . .', drone: 'A2 - - - - - - - - - - - - - - - E2 - - - - - - - - - - - - - - -', low: 'A2 . . . . . . . . . . . . . . . . . . . . . . . E2 . . . . . . .' },\n    b: { thumb: 'E5 . . . D5 . C5 . . . A4 . . . G4 . . . A4 . . . C5 . . . A4 . . .', drone: 'C3 - - - - - - - - - - - - - - - A2 - - - - - - - - - - - - - - -', low: 'C3 . . . . . . . . . . . . . . . A2 . . . . . . . . . . . . . . .' } }, order: ['a', 'a', 'b', 'a'] },\n  day: { bpm: 72, tracks: { pluck, drone }, patterns: {\n    a: { pluck: 'D4 . . . F4 . . . A4 . . . . . . . . . . . G4 . F4 . D4 . . . . . . .', drone: 'D2 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -' },\n    b: { pluck: '. . . . A4 . C5 . . . A4 . G4 . . . F4 . . . . . D4 . . . . . . . . .', drone: 'D2 - - - - - - - - - - - - - - - G2 - - - - - - - - - - - - - - -' },\n    c: { pluck: '. . . . . . . . . . . . . . . . D5 . . . C5 . A4 . . . . . . . . .', drone: 'D2 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -' } }, order: ['a', 'c', 'b', 'c'] },\n  night: { bpm: 50, tracks: { thumb: { ...thumb, volume: 0.25, decay: 0.5 }, drone: { ...drone, volume: 0.05 } }, patterns: {\n    a: { thumb: 'A3 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .', drone: 'A1 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -' },\n    b: { thumb: '. . . . . . . . E4 . . . . . . . . . . . . . . . D4 . . . . . . .', drone: 'A1 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -' } }, order: ['a', 'b'] },\n  stalk: { bpm: 96, tracks: { pulse: { wave: 'triangle', decay: 0.08, volume: 0.32 }, drone: { ...drone, volume: 0.1 }, drum: { ...drum, volume: 0.12 } }, patterns: {\n    a: { pulse: 'A2 . . . A2 . . . A2 . . . A2 . . . A2 . . . A2 . . . Bb2 . . . A2 . . .', drone: 'A1 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -', drum: '. . . . . . C7 . . . . . . . C7 . . . . . . . C7 . . . . . . . C7 .' } }, order: ['a'] },\n  fight: { bpm: 132, tracks: { bass, drum, hi: { wave: 'noise', decay: 0.03, volume: 0.16 }, stab: { wave: 'triangle', decay: 0.1, volume: 0.28 } }, patterns: {\n    a: { bass: 'D2 . D2 . D2 D2 . . F2 . . D2 . . C2 . D2 . D2 . D2 D2 . . A1 . . C2 . . C2 .', drum: 'C5 . . . C6 . . C5 C5 . . . C6 . C5 . C5 . . . C6 . . C5 C5 . . . C6 . C5 C6', hi: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', stab: '. . . . . . . . A4 . . . . . . . . . . . . . . . G4 . . . . . . .' },\n    b: { bass: 'A1 . A1 . A1 A1 . . C2 . . A1 . . G1 . A1 . A1 . A1 A1 . . D2 . . C2 . . A1 .', drum: 'C5 . . . C6 . . C5 C5 . . . C6 . C5 . C5 . C5 . C6 . . C5 C5 . . C5 C6 . C6 C6', hi: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', stab: '. . . . . . . . C5 . . . . . . . . . . . D5 . . . E5 . . . . . . .' } }, order: ['a', 'a', 'b', 'a'] },\n  fever: { bpm: 60, tracks: { pluck: { ...pluck, vibrato: { depth: 0.8, rate: 2.2 }, volume: 0.3, decay: 0.5 }, pluck2: { ...pluck, vibrato: { depth: 1.1, rate: 1.7 }, volume: 0.22, decay: 0.5 }, drone: { ...drone, volume: 0.12, vibrato: { depth: 0.6, rate: 0.8 } } }, patterns: {\n    a: { pluck: 'D4 . . . F4 . . . A4 . . . . . . . . . . . G4 . F4 . D4 . . . . . . .', pluck2: 'Eb4 . . . F#4 . . . Bb4 . . . . . . . . . . . Ab4 . F#4 . Eb4 . . . . . . .', drone: 'D2 - - - - - - - - - - - - - - - Eb2 - - - - - - - - - - - - - - -' } }, order: ['a'] },\n  end: { bpm: 54, loop: false, tracks: { line: { wave: 'triangle', decay: 0.5, volume: 0.42 } }, patterns: {\n    a: { line: 'A4 . . . C5 . . . E5 . . . . . . . D5 . . . C5 . . . A4 . . . . . . .' },\n    b: { line: 'G4 . . . A4 . . . C5 . . . D5 . . . E5 . . . . . . . . . . . . . . .' },\n    c: { line: 'D5 . . . C5 . . . A4 . . . G4 . . . A4 . . . . . . . . . . . . . . .' } }, order: ['a', 'b', 'a', 'c'] },\n};\nconst DWELL = 12;\nexport class Music {\n  current = null; since = -99; mood = null; pending = null;\n  constructor(game) { this.game = game; }\n  /** Pick by state with a 12 s minimum dwell. */\n  update(ctx, dt, realT) {\n    const g = this.game;\n    const want = this.mood ?? this.auto();\n    if (want === this.current) return;\n    if (this.current && realT - this.since < DWELL && want !== 'title' && want !== 'end') return;\n    this.current = want; this.since = realT;\n    ctx.audio.playMusic(SONGS[want] ?? null, want);\n  }\n  force(name, realT = -99) { this.current = name; this.since = realT; this.game.ctx.audio.playMusic(SONGS[name] ?? null, name); }\n  setMood(m) { this.mood = m; }\n  auto() {\n    const g = this.game;\n    if (g.mode === 'title' || g.mode === 'attract') return 'title';\n    if (g.endingMusic) return 'end';\n    if (g.body.feverOn) return 'fever';\n    if (g.actors.inCombat || g.fireView.nearestDist < 70) return 'fight';\n    if (g.actors.anyAlertNear) return 'stalk';\n    return g.clock.isNight() ? 'night' : 'day';\n  }\n}\nEOF\ncat > src/audio/voice.js <<'EOF'\n// Animalese gibberish: a word always sounds the same, each character has a pitch, rate and wave. Barks are spatial.\nimport { spatialize } from '../../pixel-engine.js';\nimport { hashStr, clamp } from '../core/rng.js';\nconst VOWELS = [[730, 1090], [270, 2290], [300, 870], [570, 840], [530, 1840], [640, 1190]];\nconst CONS = [[0, 0], [6000, 0.08], [3200, 0.1], [9000, 0.05]];\nexport const VOICES = {\n  bakr: { wave: 'saw', base: 118, rate: 0.112, tilt: 1 }, odile: { wave: 'saw', base: 175, rate: 0.1, tilt: 1 }, tibor: { wave: 'saw', base: 100, rate: 0.13, tilt: 1 },\n  vance: { wave: 'triangle', base: 128, rate: 0.14, tilt: 1 }, ansa: { wave: 'saw', base: 205, rate: 0.095, tilt: 1 }, harrow: { wave: 'triangle', base: 92, rate: 0.17, tilt: 0.8 },\n  ines: { wave: 'saw', base: 195, rate: 0.082, tilt: 1 }, dov: { wave: 'triangle', base: 84, rate: 0.16, tilt: 1 }, mags: { wave: 'square', base: 245, rate: 0.074, tilt: 1 },\n  pell: { wave: 'saw', base: 140, rate: 0.09, tilt: 1 }, concord: { wave: 'saw', base: 112, rate: 0.085, tilt: 1 }, harvest: { wave: 'square', base: 138, rate: 0.08, tilt: 1 }, deserter: { wave: 'saw', base: 100, rate: 0.085, tilt: 1 },\n  column: { wave: 'triangle', base: 170, rate: 0.1, tilt: 1 }, '': { wave: 'triangle', base: 110, rate: 0.1, tilt: 1 },\n};\n// Twelve syllables per voice: vowel formant pair by consonant noise.\nexport function syllable(wave, base, i) {\n  const [f1, f2] = VOWELS[i % VOWELS.length];\n  const [cf, cv] = CONS[(i >> 1) % CONS.length];\n  const layers = [{ wave: 'sine', freq: f1, decay: 0.08, volume: 0.18 }, { wave: 'sine', freq: f2, decay: 0.07, volume: 0.1 }];\n  if (cv) layers.push({ wave: 'noise', freq: cf, decay: 0.012, volume: cv });\n  return { wave, freq: base, freqEnd: base * 0.9, attack: 0.005, decay: 0.09, volume: 0.3, layers };\n}\nconst BARKS = {\n  spotted: ['THERE! IN THE GRASS!', 'CONTACT!', 'THERE HE IS.', 'ON THE ROAD! ON THE ROAD!', 'SOMEBODY SEES HIM.'],\n  suspicious: ['WHO IS THAT?', 'SOMETHING MOVED.', 'YOU HEAR THAT?'],\n  lost: ['WHERE DID HE GO?', 'I HAD HIM. I HAD HIM.', 'LOST HIM.'],\n  heard: ['THAT WAS CLOSE.', 'GUNFIRE.', 'WAKE UP. WAKE UP.'],\n  giveup: ['IT WAS NOTHING.', 'GO BACK. IT WAS A DOG.', 'NOBODY PAYS ME TO LOOK.'],\n  jammed: [\"IT'S STUCK! IT'S STUCK AGAIN!\", 'THIS RUSTED PIECE OF-', 'SAME GUN, SAME DAY.'],\n  fire: ['WHO LIT THAT?', 'THE WIND! MOVE!', 'THE FIELD IS GOING!', 'GET OFF THE GRASS!'],\n  burning: ['GET IT OFF! GET IT OFF!', 'WATER!', 'NO NO NO NO'],\n  'ally-down-near': [\"LEAVE HIM, HE'S ALREADY GONE.\", 'THAT WAS MY COUSIN.', 'MAN DOWN.', 'WE ARE NOT PAID FOR THIS.'],\n  hit: ['AH!', 'MY ARM!', 'HE GOT ME!'],\n  fighting: ['KEEP FIRING!', 'AROUND THE SIDE!', 'FLANK HIM!'],\n};\nconst BY_FACTION = { concord: { spotted: ['THERE! IN THE GRASS!', 'ENGAGE, BY THE COLONEL\\'S ORDER.'], lost: ['REPORT SAYS HE IS GONE.'], jammed: ['REQUISITION A NEW ONE, THEY SAID.'], fire: ['WHO LIT THAT?', 'THAT IS NOT IN THE ORDERS.'] }, harvest: { spotted: ['THIEF ON THE LAND!', 'THERE! FOR THE PEOPLE!'], lost: ['THE LAND HID HIM.'], jammed: ['THE PEOPLE\\'S GUN IS STUCK!'], fire: ['THE FIELD IS OURS! WHO LIT IT?', 'WHO LIT THAT?'] } };\nexport class Voice {\n  subtitleUntil = 0; nextBark = 0;\n  constructor(game) { this.game = game; this.level = 1; }\n  build(ctx) { this.audio = ctx.audio; this.defs = new Map(); }\n  def(who, i) {\n    const k = `${who}:${i}`;\n    let d = this.defs.get(k);\n    if (!d) { const v = VOICES[who] ?? VOICES['']; d = syllable(v.wave, v.base, i); this.defs.set(k, d); }\n    return d;\n  }\n  /** How long the line takes to speak. Words hash to syllables so a word always sounds the same. */\n  lineSeconds(who, text) {\n    const v = VOICES[who] ?? VOICES[''];\n    let n = 0;\n    for (const w of text.split(/\\s+/)) n += Math.max(1, (w.match(/[AEIOUY]/gi) ?? []).length) + 0.4;\n    return clamp(n * v.rate, 0.5, 8);\n  }\n  say(who, text, { gain = 1, pan = 0 } = {}) {\n    const g = this.game;\n    const level = g.settings.voices * gain;\n    if (level <= 0.001 || !g.ctx.audio) return 0;\n    const v = VOICES[who] ?? VOICES[''];\n    const words = text.split(/\\s+/).filter(Boolean);\n    let t = 0;\n    const last = /[?]\\s*$/.test(text) ? 1 : -1;\n    for (let w = 0; w < words.length; w++) {\n      const word = words[w];\n      const h = hashStr(word.toUpperCase());\n      const vowels = Math.max(1, (word.match(/[AEIOUY]/gi) ?? []).length);\n      for (let s = 0; s < vowels; s++) {\n        const idx = (h >> (s * 3)) & 15;\n        const pitchBase = ((h >> (s + 5)) % 5) - 2;\n        const intonation = w >= words.length - 2 ? last * (s + 1) * 0.8 : 0;\n        const at = t;\n        const def = this.def(who, idx % 12);\n        g.afterReal(at, () => { if (!g.ended) this.audio.play(def, { volume: level * 0.8, pitch: pitchBase + intonation, pan }); });\n        t += v.rate;\n      }\n      t += /[,;:]$/.test(word) ? v.rate * 2.2 : v.rate * 0.4;\n    }\n    return t;\n  }\n  /** A soldier's bark: gibberish plus a short subtitle, in space. */\n  bark(s, kind) {\n    const g = this.game;\n    const time = g.realT;\n    if (s.barkAt && time - s.barkAt < 3) return;\n    if (time < this.nextBark && kind !== 'burning') return;\n    const fac = BY_FACTION[s.faction]?.[kind];\n    const pool = (fac && g.rng.look.chance(0.5)) ? fac : BARKS[kind];\n    if (!pool) return;\n    const text = g.rng.look.pick(pool);\n    s.barkAt = time;\n    this.nextBark = time + 1.2;\n    const sp = spatialize(g.listener(), [s.x, g.camPos.y, s.z], { max: 70, ref: 4 });\n    if (sp.gain < 0.02) return;\n    this.say(s.faction, text, { gain: sp.gain, pan: sp.pan });\n    if (sp.gain > 0.15 && !g.subtitle.active) g.say(s.faction, text, 1.8, true);\n    g.events.emit('bark', kind, text);\n  }\n}\nEOF\ncat > src/audio/ambience.js <<'EOF'\n// The world's sound floor: wind by speed, cicadas by day, insects by night, rain when it rains, a distant war now and then.\nimport { clamp } from '../core/rng.js';\nexport class Ambience {\n  distantT = 30;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.wind = ctx.audio.loop('wind-loop', { volume: 0 });\n    this.day = ctx.audio.loop('birds-loop', { volume: 0 });\n    this.night = ctx.audio.loop('insects-loop', { volume: 0 });\n    this.rain = ctx.audio.loop('rain-loop', { volume: 0 });\n  }\n  stop() { for (const v of [this.wind, this.day, this.night, this.rain]) v?.stop(); }\n  update(ctx, dt) {\n    const g = this.game;\n    if (g.ended) return;\n    const inOut = g.mode === 'title' ? 0.35 : 1;\n    this.wind?.set({ volume: clamp(0.08 + g.wind.total * 0.06, 0, 0.6) * inOut });\n    const n = g.sky.night ?? 0;\n    this.day?.set({ volume: (1 - n) * 0.35 * inOut });\n    this.night?.set({ volume: n * 0.5 * inOut });\n    this.rain?.set({ volume: g.sky.storm ? 0.6 : 0 });\n    if (g.mode === 'campaign' || g.mode === 'round') {\n      this.distantT -= dt;\n      if (this.distantT <= 0) { this.distantT = g.rng.look.range(30, 90); g.sfx.play('distant-fight', { volume: 0.25, pan: g.rng.look.range(-0.8, 0.8) }); }\n    }\n  }\n}\nEOF\ncat > tools/checkaudio.mjs <<'EOF'\nconst { renderSound, parseSong } = await import('../pixel-engine.js');\nconst { SOUNDS } = await import('../src/audio/sfx.js');\nconst { SONGS } = await import('../src/audio/music.js');\nlet bad = 0;\nfor (const [k, v] of Object.entries(SOUNDS)) { const s = renderSound(v); let m = 0; for (const x of s) m = Math.max(m, Math.abs(x)); if (m < 0.01) { console.log('silent', k, m); bad++; } }\nfor (const [k, s] of Object.entries(SONGS)) { try { parseSong(s); } catch (e) { console.log('song', k, e.message); bad++; } }\nconsole.log(Object.keys(SOUNDS).length, 'sounds', Object.keys(SONGS).length, 'songs', bad, 'bad');\nEOF\nnode tools/checkaudio.mjs 2>&1 | tail -8 | cut -c1-300","description":"Write all sound, music and voice data; verify non-silent and parseable","timeout":60000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1206,"cache_read_input_tokens":423489,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1206},"output_tokens":20,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"de3452d5-6bfa-4f5c-a676-f00321ba46c8","timestamp":"2026-11-05T23:57:23.776Z","request_id":"req_011CgkgeUreHb3f2msDs1AUt","wire_tool_inputs":{"toolu_01MqtYLmkNwNFiQAiwqrvi3N":{"command":"set -e\ncat > src/audio/sfx.js <<'EOF'\n// Everything you hear is written here as SoundDef data. No audio files anywhere.\nimport { spatialize } from '../../pixel-engine.js';\nimport { clamp } from '../core/rng.js';\nconst n = (freq, decay, volume, extra = {}) => ({ wave: 'noise', freq, decay, volume, attack: 0.001, ...extra });\nconst crack = (hiss, thump, tail, vol = 0.8) => ({ wave: 'noise', freq: hiss, freqEnd: hiss * 0.4, attack: 0.001, decay: 0.05, volume: vol, layers: [{ wave: 'sine', freq: thump, freqEnd: thump * 0.4, attack: 0.001, decay: 0.12, volume: vol * 0.9 }, { wave: 'noise', freq: 2400, freqEnd: 500, attack: 0.002, decay: tail, volume: vol * 0.4, delay: 0.02 }, { wave: 'square', duty: 0.25, freq: thump * 2.1, freqEnd: thump * 0.8, decay: 0.04, volume: vol * 0.25 }] });\nconst far = (hiss, thump, tail, vol = 0.5) => ({ wave: 'noise', freq: hiss * 0.25, freqEnd: hiss * 0.12, attack: 0.004, decay: 0.08, volume: vol, layers: [{ wave: 'sine', freq: thump * 0.7, freqEnd: thump * 0.35, decay: 0.2, volume: vol }, { wave: 'noise', freq: 600, freqEnd: 180, decay: tail * 1.5, volume: vol * 0.45, delay: 0.05 }] });\nconst metal = (freq, decay, volume, extra = {}) => ({ wave: 'square', duty: 0.125, freq, freqEnd: freq * 0.9, attack: 0.001, decay, volume, layers: [{ wave: 'noise', freq: 7000, decay: decay * 0.5, volume: volume * 0.7 }, { wave: 'triangle', freq: freq * 2.76, decay: decay * 0.8, volume: volume * 0.3 }], ...extra });\nconst step = (hiss, low, vol) => ({ wave: 'noise', freq: hiss, freqEnd: hiss * 0.5, attack: 0.002, decay: 0.07, volume: vol, layers: [{ wave: 'sine', freq: low, freqEnd: low * 0.6, decay: 0.06, volume: vol * 0.8 }] });\nexport const SOUNDS = {\n  // Guns: crack, thump, tail. A distant muffled variant for when someone else is shooting.\n  'gun-tractor': crack(5200, 170, 0.2, 0.8), 'gun-tractor-far': far(5200, 170, 0.2),\n  'gun-m38': crack(4200, 210, 0.16, 0.8), 'gun-m38-far': far(4200, 210, 0.16),\n  'gun-mule': crack(3000, 110, 0.34, 1), 'gun-mule-far': far(3000, 110, 0.34),\n  'gun-empire': crack(6200, 130, 0.5, 1), 'gun-empire-far': far(6200, 130, 0.5),\n  'gun-mg': crack(4800, 140, 0.14, 0.75), 'gun-mg-far': far(4800, 140, 0.14),\n  'gun-flare': { wave: 'noise', freq: 1500, freqEnd: 400, attack: 0.002, decay: 0.08, volume: 0.6, layers: [{ wave: 'sine', freq: 300, freqEnd: 120, decay: 0.1, volume: 0.6 }, { wave: 'noise', freq: 8000, attack: 0.03, sustain: 0.1, decay: 0.3, volume: 0.15, delay: 0.05 }] },\n  'flare-hiss': { wave: 'noise', freq: 9000, freqEnd: 5000, attack: 0.02, sustain: 0.5, decay: 0.8, volume: 0.3 },\n  'gun-tube': { wave: 'noise', freq: 1300, freqEnd: 240, attack: 0.003, sustain: 0.1, decay: 0.5, volume: 0.8, layers: [{ wave: 'sine', freq: 120, freqEnd: 45, decay: 0.3, volume: 0.9 }] },\n  'flamer-start': { wave: 'noise', freq: 3000, freqEnd: 800, attack: 0.01, decay: 0.3, volume: 0.6, layers: [{ wave: 'sine', freq: 90, decay: 0.2, volume: 0.5 }] },\n  'flamer-loop': { wave: 'noise', freq: 1800, attack: 0.02, sustain: 0.9, decay: 0.02, volume: 0.55, vibrato: { depth: 3, rate: 13 }, layers: [{ wave: 'noise', freq: 500, attack: 0.02, sustain: 0.9, decay: 0.02, volume: 0.5 }, { wave: 'saw', freq: 62, attack: 0.02, sustain: 0.9, decay: 0.02, volume: 0.12 }] },\n  'gun-jam': { wave: 'square', duty: 0.125, freq: 1400, freqEnd: 900, decay: 0.03, volume: 0.45, layers: [{ wave: 'noise', freq: 6000, decay: 0.015, volume: 0.35 }] },\n  'gun-slap': { wave: 'noise', freq: 2800, freqEnd: 900, decay: 0.05, volume: 0.6, layers: [{ wave: 'sine', freq: 200, freqEnd: 90, decay: 0.05, volume: 0.45 }] },\n  'gun-rack': metal(820, 0.05, 0.42, { layers: [{ wave: 'noise', freq: 7000, decay: 0.03, volume: 0.35 }, { wave: 'square', duty: 0.125, freq: 1200, freqEnd: 700, decay: 0.05, volume: 0.32, delay: 0.09 }, { wave: 'noise', freq: 5000, decay: 0.03, volume: 0.28, delay: 0.09 }] }),\n  'gun-mag': metal(520, 0.06, 0.36, { layers: [{ wave: 'noise', freq: 3000, decay: 0.04, volume: 0.3 }, { wave: 'square', duty: 0.25, freq: 700, decay: 0.04, volume: 0.28, delay: 0.18 }] }),\n  'gun-shell': { wave: 'square', duty: 0.25, freq: 620, freqEnd: 460, decay: 0.04, volume: 0.34, layers: [{ wave: 'noise', freq: 3500, decay: 0.03, volume: 0.25 }, { wave: 'sine', freq: 180, decay: 0.05, volume: 0.25, delay: 0.05 }] },\n  'gun-cylinder': { wave: 'square', duty: 0.125, freq: 1700, decay: 0.02, volume: 0.3, layers: [0.1, 0.2, 0.3, 0.42].map((d) => ({ wave: 'square', duty: 0.125, freq: 1500, decay: 0.02, volume: 0.28, delay: d })) },\n  'gun-equip': metal(400, 0.05, 0.28), 'gun-rattle': { wave: 'noise', freq: 4000, decay: 0.02, volume: 0.22, layers: [0.04, 0.09].map((d) => ({ wave: 'square', duty: 0.125, freq: 900, decay: 0.015, volume: 0.2, delay: d })) },\n  'gun-apart': { wave: 'square', duty: 0.25, freq: 340, freqEnd: 120, decay: 0.18, volume: 0.5, layers: [{ wave: 'noise', freq: 5000, decay: 0.12, volume: 0.5 }, { wave: 'square', duty: 0.125, freq: 900, decay: 0.05, volume: 0.35, delay: 0.16 }, { wave: 'square', duty: 0.125, freq: 680, decay: 0.05, volume: 0.32, delay: 0.3 }, { wave: 'square', duty: 0.125, freq: 500, decay: 0.04, volume: 0.25, delay: 0.46 }] },\n  'bottle-smash': { wave: 'noise', freq: 9500, freqEnd: 3000, decay: 0.2, volume: 0.6, layers: [{ wave: 'square', duty: 0.125, freq: 2500, freqEnd: 1800, decay: 0.08, volume: 0.25 }, { wave: 'noise', freq: 1600, attack: 0.05, sustain: 0.1, decay: 0.5, volume: 0.42, delay: 0.05 }] },\n  explosion: { wave: 'noise', freq: 900, freqEnd: 120, attack: 0.002, sustain: 0.04, decay: 0.7, volume: 1, layers: [{ wave: 'sine', freq: 90, freqEnd: 30, attack: 0.002, sustain: 0.05, decay: 0.55, volume: 1 }, { wave: 'noise', freq: 3000, decay: 0.08, volume: 0.6 }] },\n  'explosion-big': { wave: 'noise', freq: 600, freqEnd: 70, attack: 0.002, sustain: 0.1, decay: 1.5, volume: 1, layers: [{ wave: 'sine', freq: 70, freqEnd: 22, attack: 0.002, sustain: 0.1, decay: 1.2, volume: 1 }, { wave: 'noise', freq: 2400, decay: 0.15, volume: 0.6 }] },\n  ricochet: { wave: 'sine', freq: 2100, freqEnd: 760, decay: 0.28, volume: 0.28, vibrato: { depth: 1.5, rate: 40 } },\n  'bullet-whip': { wave: 'noise', freq: 7000, freqEnd: 2200, attack: 0.03, decay: 0.08, volume: 0.42 },\n  'hit-flesh': { wave: 'noise', freq: 900, freqEnd: 240, decay: 0.07, volume: 0.6, layers: [{ wave: 'sine', freq: 130, freqEnd: 70, decay: 0.08, volume: 0.6 }] },\n  'hit-metal': { wave: 'square', duty: 0.125, freq: 2300, freqEnd: 1500, decay: 0.09, volume: 0.32, layers: [{ wave: 'noise', freq: 7000, decay: 0.04, volume: 0.4 }, { wave: 'sine', freq: 3400, decay: 0.12, volume: 0.15 }] },\n  'hit-marker': { wave: 'square', duty: 0.25, freq: 2000, decay: 0.025, volume: 0.25 },\n  'knife-swing': { wave: 'noise', freq: 4000, freqEnd: 1500, attack: 0.03, decay: 0.09, volume: 0.45 },\n  whoosh: { wave: 'noise', freq: 1600, freqEnd: 700, attack: 0.05, decay: 0.14, volume: 0.4 },\n  land: { wave: 'sine', freq: 140, freqEnd: 60, decay: 0.09, volume: 0.5, layers: [{ wave: 'noise', freq: 1400, freqEnd: 500, decay: 0.07, volume: 0.2 }] },\n  crash: { wave: 'noise', freq: 2400, freqEnd: 300, decay: 0.4, volume: 0.9, layers: [{ wave: 'square', duty: 0.25, freq: 240, freqEnd: 80, decay: 0.25, volume: 0.5 }, { wave: 'square', duty: 0.125, freq: 900, decay: 0.08, volume: 0.4, delay: 0.1 }] },\n  // Feet.\n  'step-dirt': step(1500, 95, 0.4), 'step-grass': step(3800, 80, 0.3), 'step-road': step(1100, 130, 0.42), 'step-wood': { wave: 'sine', freq: 190, freqEnd: 120, decay: 0.07, volume: 0.5, layers: [{ wave: 'noise', freq: 1000, decay: 0.03, volume: 0.25 }] }, 'step-water': { wave: 'noise', freq: 2400, freqEnd: 800, attack: 0.01, decay: 0.15, volume: 0.42, layers: [{ wave: 'sine', freq: 300, freqEnd: 180, attack: 0.01, decay: 0.08, volume: 0.25 }] },\n  // Body.\n  breath: { wave: 'noise', freq: 1700, freqEnd: 900, attack: 0.12, sustain: 0.1, decay: 0.3, volume: 0.22 },\n  heartbeat: { wave: 'sine', freq: 62, freqEnd: 44, decay: 0.11, volume: 0.9, layers: [{ wave: 'sine', freq: 56, freqEnd: 40, decay: 0.11, volume: 0.65, delay: 0.2 }] },\n  syrette: { wave: 'noise', freq: 8200, freqEnd: 5200, attack: 0.03, sustain: 0.28, decay: 0.2, volume: 0.32, layers: [{ wave: 'sine', freq: 500, freqEnd: 300, decay: 0.02, volume: 0.2 }] },\n  pliers: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 500, decay: 0.05, volume: 0.32, layers: [{ wave: 'noise', freq: 1800, decay: 0.22, volume: 0.3, delay: 0.02 }] },\n  'knife-dig': { wave: 'noise', freq: 1100, freqEnd: 600, attack: 0.02, sustain: 0.1, decay: 0.16, volume: 0.42, layers: [{ wave: 'sine', freq: 180, freqEnd: 100, decay: 0.16, volume: 0.38 }] },\n  'finger-snap': { wave: 'noise', freq: 6000, freqEnd: 1200, decay: 0.02, volume: 0.9, layers: [{ wave: 'square', duty: 0.125, freq: 1200, decay: 0.012, volume: 0.6 }] },\n  lighter: { wave: 'square', duty: 0.125, freq: 2600, decay: 0.012, volume: 0.32, layers: [{ wave: 'noise', freq: 5000, attack: 0.02, sustain: 0.5, decay: 0.2, volume: 0.12, delay: 0.05 }] },\n  cauterise: { wave: 'noise', freq: 9000, freqEnd: 6000, attack: 0.03, sustain: 0.8, decay: 0.3, volume: 0.32 },\n  'tablet-bottle': { wave: 'noise', freq: 7500, decay: 0.02, volume: 0.28, layers: [0.05, 0.11, 0.18, 0.28].map((d) => ({ wave: 'square', duty: 0.125, freq: 2500, decay: 0.012, volume: 0.22, delay: d })) },\n  'tablet-swallow': { wave: 'sine', freq: 220, freqEnd: 90, attack: 0.02, decay: 0.2, volume: 0.42 },\n  grunt: { wave: 'saw', freq: 165, freqEnd: 105, attack: 0.01, decay: 0.16, volume: 0.42, layers: [{ wave: 'sine', freq: 620, freqEnd: 480, decay: 0.12, volume: 0.15 }, { wave: 'noise', freq: 1200, decay: 0.08, volume: 0.15 }] },\n  'grunt-big': { wave: 'saw', freq: 200, freqEnd: 85, attack: 0.02, sustain: 0.05, decay: 0.32, volume: 0.5, layers: [{ wave: 'sine', freq: 760, freqEnd: 420, sustain: 0.05, decay: 0.28, volume: 0.2 }, { wave: 'noise', freq: 1500, decay: 0.2, volume: 0.2 }] },\n  'fever-onset': { wave: 'sine', freq: 300, freqEnd: 180, attack: 0.5, sustain: 0.6, decay: 1, volume: 0.25, vibrato: { depth: 1.5, rate: 3 }, layers: [{ wave: 'sine', freq: 307, freqEnd: 184, attack: 0.5, sustain: 0.6, decay: 1, volume: 0.25 }] },\n  // Loops.\n  'fire-loop': { wave: 'noise', freq: 1100, attack: 0.04, sustain: 1.1, decay: 0.04, volume: 0.6, layers: [{ wave: 'noise', freq: 420, attack: 0.04, sustain: 1.1, decay: 0.04, volume: 0.5 }, ...[0.15, 0.4, 0.62, 0.84, 1.02].map((d) => ({ wave: 'noise', freq: 6500, decay: 0.03, volume: 0.28, delay: d }))] },\n  'wind-loop': { wave: 'noise', freq: 620, freqEnd: 820, attack: 0.3, sustain: 1.6, decay: 0.3, volume: 0.32, vibrato: { depth: 2, rate: 0.7 } },\n  'insects-loop': { wave: 'sine', freq: 3600, attack: 0.01, sustain: 0.9, decay: 0.01, volume: 0.05, vibrato: { depth: 1.5, rate: 34 }, layers: [{ wave: 'sine', freq: 4300, attack: 0.1, sustain: 0.6, decay: 0.1, volume: 0.04, vibrato: { depth: 1, rate: 22 }, delay: 0.1 }] },\n  'birds-loop': { wave: 'sine', freq: 2600, freqEnd: 3200, attack: 0.01, decay: 0.08, volume: 0.1, arp: [0, 4, 7, 4], arpRate: 0.06, layers: [{ wave: 'sine', freq: 2100, freqEnd: 2400, decay: 0.1, volume: 0.09, delay: 0.9 }, { wave: 'sine', freq: 5100, decay: 0.8, attack: 0.3, volume: 0.03, vibrato: { depth: 1, rate: 40 }, delay: 0.3 }, { wave: 'sine', freq: 3000, freqEnd: 2500, decay: 0.08, volume: 0.09, arp: [0, 3, 0, 5], arpRate: 0.05, delay: 1.4 }] },\n  'rain-loop': { wave: 'noise', freq: 7000, attack: 0.1, sustain: 1.6, decay: 0.1, volume: 0.5, layers: [{ wave: 'noise', freq: 2200, attack: 0.1, sustain: 1.6, decay: 0.1, volume: 0.34 }] },\n  'engine-loop': { wave: 'saw', freq: 58, attack: 0.02, sustain: 0.8, decay: 0.02, volume: 0.42, layers: [{ wave: 'square', duty: 0.25, freq: 116, attack: 0.02, sustain: 0.8, decay: 0.02, volume: 0.14 }, { wave: 'noise', freq: 480, attack: 0.02, sustain: 0.8, decay: 0.02, volume: 0.14 }] },\n  // Trucks and rails.\n  gravel: { wave: 'noise', freq: 2100, decay: 0.1, volume: 0.28 }, brakes: { wave: 'noise', freq: 5200, freqEnd: 2800, attack: 0.03, sustain: 0.2, decay: 0.2, volume: 0.22 },\n  door: { wave: 'noise', freq: 900, freqEnd: 300, decay: 0.09, volume: 0.5, layers: [{ wave: 'square', duty: 0.25, freq: 260, freqEnd: 160, decay: 0.08, volume: 0.32 }] },\n  horn: { wave: 'square', duty: 0.5, freq: 330, attack: 0.02, sustain: 0.32, decay: 0.05, volume: 0.32, layers: [{ wave: 'square', duty: 0.5, freq: 415, attack: 0.02, sustain: 0.32, decay: 0.05, volume: 0.25 }] },\n  'starter-cough': { wave: 'noise', freq: 620, decay: 0.09, volume: 0.45, layers: [0.14, 0.3, 0.52, 0.7, 1].map((d, i) => ({ wave: 'saw', freq: 50 + i * 3, decay: 0.09, volume: 0.42, delay: d })) },\n  wrench: { wave: 'square', duty: 0.125, freq: 1100, freqEnd: 800, decay: 0.05, volume: 0.32, layers: [{ wave: 'noise', freq: 4000, decay: 0.03, volume: 0.28 }] },\n  'train-clack': { wave: 'noise', freq: 2000, decay: 0.04, volume: 0.5, layers: [{ wave: 'sine', freq: 110, decay: 0.07, volume: 0.5 }, { wave: 'noise', freq: 2000, decay: 0.04, volume: 0.4, delay: 0.14 }, { wave: 'sine', freq: 100, decay: 0.07, volume: 0.4, delay: 0.14 }] },\n  'train-whistle': { wave: 'square', duty: 0.5, freq: 523, freqEnd: 494, attack: 0.08, sustain: 0.9, decay: 0.35, volume: 0.22, layers: [{ wave: 'square', duty: 0.5, freq: 659, freqEnd: 622, attack: 0.08, sustain: 0.9, decay: 0.35, volume: 0.2 }, { wave: 'noise', freq: 6000, attack: 0.1, sustain: 0.9, decay: 0.3, volume: 0.08 }] },\n  // Hand things.\n  'map-paper': { wave: 'noise', freq: 5200, freqEnd: 2200, attack: 0.03, decay: 0.2, volume: 0.32, layers: [{ wave: 'noise', freq: 3200, decay: 0.06, volume: 0.22, delay: 0.14 }] },\n  'tracker-beep': { wave: 'square', duty: 0.5, freq: 1760, decay: 0.05, volume: 0.28 }, 'tracker-near': { wave: 'square', duty: 0.5, freq: 2640, decay: 0.05, volume: 0.32 },\n  'radio-squelch': { wave: 'noise', freq: 9000, attack: 0.002, sustain: 0.08, decay: 0.05, volume: 0.28, layers: [{ wave: 'square', duty: 0.125, freq: 1300, decay: 0.03, volume: 0.15, delay: 0.14 }] },\n  // Sky.\n  thunder: { wave: 'noise', freq: 400, freqEnd: 70, attack: 0.03, sustain: 0.25, decay: 2.3, volume: 0.9, layers: [{ wave: 'sine', freq: 56, freqEnd: 28, attack: 0.05, sustain: 0.3, decay: 1.8, volume: 0.8 }] },\n  'distant-fight': { wave: 'noise', freq: 800, freqEnd: 260, decay: 0.09, volume: 0.32, layers: [0.14, 0.26, 0.42, 0.9, 1.05, 1.18].map((d) => ({ wave: 'noise', freq: 620, freqEnd: 200, decay: 0.08, volume: 0.28, delay: d })) },\n  // UI.\n  'ui-move': { wave: 'triangle', freq: 660, decay: 0.03, volume: 0.18 }, 'ui-confirm': { wave: 'triangle', freq: 440, decay: 0.07, volume: 0.3, arp: [0, 5, 12], arpRate: 0.04 }, 'ui-back': { wave: 'triangle', freq: 440, freqEnd: 300, decay: 0.07, volume: 0.22 },\n  'ui-stone': { wave: 'triangle', freq: 880, decay: 0.15, volume: 0.28, arp: [0, 7, 12], arpRate: 0.05 },\n  'note-scratch': { wave: 'noise', freq: 6200, freqEnd: 4200, attack: 0.01, decay: 0.07, volume: 0.2, layers: [0.08, 0.17, 0.3].map((d) => ({ wave: 'noise', freq: 6000, decay: 0.04, volume: 0.16, delay: d })) },\n};\nexport class Sfx {\n  loops = new Map();\n  constructor(game) { this.game = game; }\n  build(ctx) { for (const [k, v] of Object.entries(SOUNDS)) ctx.audio.register(k, v); this.audio = ctx.audio; }\n  play(name, o) { return this.audio.play(name, o); }\n  /** A sound at a place in the world: gain and pan from where your head is. */\n  at(name, x, z, { max = 120, volume = 1, pitch, ref = 3 } = {}) {\n    const g = this.game;\n    const s = spatialize(g.listener(), [x, g.camPos.y, z], { max, ref });\n    if (s.gain <= 0.01) return false;\n    return this.audio.play(name, { volume: volume * s.gain, pan: s.pan, pitch });\n  }\n  startLoop(key, name, o) { if (!this.loops.has(key)) this.loops.set(key, this.audio.loop(name, o)); return this.loops.get(key); }\n  stopLoop(key) { const v = this.loops.get(key); if (v) { v.stop(); this.loops.delete(key); } }\n}\nEOF\ncat > src/audio/music.js <<'EOF'\n// Original songs as data: plucked pentatonic lines, thumb-piano timbres, noise hand drums, low drones. Defaults to 10% volume.\nimport { clamp } from '../core/rng.js';\nconst pluck = { wave: 'triangle', decay: 0.24, volume: 0.42 };\nconst thumb = { wave: 'sine', decay: 0.18, volume: 0.5, attack: 0.002 };\nconst drone = { wave: 'saw', attack: 0.3, decay: 0.8, volume: 0.09 };\nconst low = { wave: 'triangle', attack: 0.05, decay: 0.7, volume: 0.32 };\nconst drum = { wave: 'noise', decay: 0.06, volume: 0.24 };\nconst bass = { wave: 'saw', decay: 0.2, volume: 0.22 };\nexport const SONGS = {\n  title: { bpm: 66, tracks: { thumb, drone, low }, patterns: {\n    a: { thumb: 'A4 . . . C5 . E5 . . . D5 . C5 . . . A4 . . . G4 . . . E4 . . . . . . .', drone: 'A2 - - - - - - - - - - - - - - - E2 - - - - - - - - - - - - - - -', low: 'A2 . . . . . . . . . . . . . . . . . . . . . . . E2 . . . . . . .' },\n    b: { thumb: 'E5 . . . D5 . C5 . . . A4 . . . G4 . . . A4 . . . C5 . . . A4 . . .', drone: 'C3 - - - - - - - - - - - - - - - A2 - - - - - - - - - - - - - - -', low: 'C3 . . . . . . . . . . . . . . . A2 . . . . . . . . . . . . . . .' } }, order: ['a', 'a', 'b', 'a'] },\n  day: { bpm: 72, tracks: { pluck, drone }, patterns: {\n    a: { pluck: 'D4 . . . F4 . . . A4 . . . . . . . . . . . G4 . F4 . D4 . . . . . . .', drone: 'D2 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -' },\n    b: { pluck: '. . . . A4 . C5 . . . A4 . G4 . . . F4 . . . . . D4 . . . . . . . . .', drone: 'D2 - - - - - - - - - - - - - - - G2 - - - - - - - - - - - - - - -' },\n    c: { pluck: '. . . . . . . . . . . . . . . . D5 . . . C5 . A4 . . . . . . . . .', drone: 'D2 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -' } }, order: ['a', 'c', 'b', 'c'] },\n  night: { bpm: 50, tracks: { thumb: { ...thumb, volume: 0.25, decay: 0.5 }, drone: { ...drone, volume: 0.05 } }, patterns: {\n    a: { thumb: 'A3 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .', drone: 'A1 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -' },\n    b: { thumb: '. . . . . . . . E4 . . . . . . . . . . . . . . . D4 . . . . . . .', drone: 'A1 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -' } }, order: ['a', 'b'] },\n  stalk: { bpm: 96, tracks: { pulse: { wave: 'triangle', decay: 0.08, volume: 0.32 }, drone: { ...drone, volume: 0.1 }, drum: { ...drum, volume: 0.12 } }, patterns: {\n    a: { pulse: 'A2 . . . A2 . . . A2 . . . A2 . . . A2 . . . A2 . . . Bb2 . . . A2 . . .', drone: 'A1 - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -', drum: '. . . . . . C7 . . . . . . . C7 . . . . . . . C7 . . . . . . . C7 .' } }, order: ['a'] },\n  fight: { bpm: 132, tracks: { bass, drum, hi: { wave: 'noise', decay: 0.03, volume: 0.16 }, stab: { wave: 'triangle', decay: 0.1, volume: 0.28 } }, patterns: {\n    a: { bass: 'D2 . D2 . D2 D2 . . F2 . . D2 . . C2 . D2 . D2 . D2 D2 . . A1 . . C2 . . C2 .', drum: 'C5 . . . C6 . . C5 C5 . . . C6 . C5 . C5 . . . C6 . . C5 C5 . . . C6 . C5 C6', hi: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', stab: '. . . . . . . . A4 . . . . . . . . . . . . . . . G4 . . . . . . .' },\n    b: { bass: 'A1 . A1 . A1 A1 . . C2 . . A1 . . G1 . A1 . A1 . A1 A1 . . D2 . . C2 . . A1 .', drum: 'C5 . . . C6 . . C5 C5 . . . C6 . C5 . C5 . C5 . C6 . . C5 C5 . . C5 C6 . C6 C6', hi: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .', stab: '. . . . . . . . C5 . . . . . . . . . . . D5 . . . E5 . . . . . . .' } }, order: ['a', 'a', 'b', 'a'] },\n  fever: { bpm: 60, tracks: { pluck: { ...pluck, vibrato: { depth: 0.8, rate: 2.2 }, volume: 0.3, decay: 0.5 }, pluck2: { ...pluck, vibrato: { depth: 1.1, rate: 1.7 }, volume: 0.22, decay: 0.5 }, drone: { ...drone, volume: 0.12, vibrato: { depth: 0.6, rate: 0.8 } } }, patterns: {\n    a: { pluck: 'D4 . . . F4 . . . A4 . . . . . . . . . . . G4 . F4 . D4 . . . . . . .', pluck2: 'Eb4 . . . F#4 . . . Bb4 . . . . . . . . . . . Ab4 . F#4 . Eb4 . . . . . . .', drone: 'D2 - - - - - - - - - - - - - - - Eb2 - - - - - - - - - - - - - - -' } }, order: ['a'] },\n  end: { bpm: 54, loop: false, tracks: { line: { wave: 'triangle', decay: 0.5, volume: 0.42 } }, patterns: {\n    a: { line: 'A4 . . . C5 . . . E5 . . . . . . . D5 . . . C5 . . . A4 . . . . . . .' },\n    b: { line: 'G4 . . . A4 . . . C5 . . . D5 . . . E5 . . . . . . . . . . . . . . .' },\n    c: { line: 'D5 . . . C5 . . . A4 . . . G4 . . . A4 . . . . . . . . . . . . . . .' } }, order: ['a', 'b', 'a', 'c'] },\n};\nconst DWELL = 12;\nexport class Music {\n  current = null; since = -99; mood = null; pending = null;\n  constructor(game) { this.game = game; }\n  /** Pick by state with a 12 s minimum dwell. */\n  update(ctx, dt, realT) {\n    const g = this.game;\n    const want = this.mood ?? this.auto();\n    if (want === this.current) return;\n    if (this.current && realT - this.since < DWELL && want !== 'title' && want !== 'end') return;\n    this.current = want; this.since = realT;\n    ctx.audio.playMusic(SONGS[want] ?? null, want);\n  }\n  force(name, realT = -99) { this.current = name; this.since = realT; this.game.ctx.audio.playMusic(SONGS[name] ?? null, name); }\n  setMood(m) { this.mood = m; }\n  auto() {\n    const g = this.game;\n    if (g.mode === 'title' || g.mode === 'attract') return 'title';\n    if (g.endingMusic) return 'end';\n    if (g.body.feverOn) return 'fever';\n    if (g.actors.inCombat || g.fireView.nearestDist < 70) return 'fight';\n    if (g.actors.anyAlertNear) return 'stalk';\n    return g.clock.isNight() ? 'night' : 'day';\n  }\n}\nEOF\ncat > src/audio/voice.js <<'EOF'\n// Animalese gibberish: a word always sounds the same, each character has a pitch, rate and wave. Barks are spatial.\nimport { spatialize } from '../../pixel-engine.js';\nimport { hashStr, clamp } from '../core/rng.js';\nconst VOWELS = [[730, 1090], [270, 2290], [300, 870], [570, 840], [530, 1840], [640, 1190]];\nconst CONS = [[0, 0], [6000, 0.08], [3200, 0.1], [9000, 0.05]];\nexport const VOICES = {\n  bakr: { wave: 'saw', base: 118, rate: 0.112, tilt: 1 }, odile: { wave: 'saw', base: 175, rate: 0.1, tilt: 1 }, tibor: { wave: 'saw', base: 100, rate: 0.13, tilt: 1 },\n  vance: { wave: 'triangle', base: 128, rate: 0.14, tilt: 1 }, ansa: { wave: 'saw', base: 205, rate: 0.095, tilt: 1 }, harrow: { wave: 'triangle', base: 92, rate: 0.17, tilt: 0.8 },\n  ines: { wave: 'saw', base: 195, rate: 0.082, tilt: 1 }, dov: { wave: 'triangle', base: 84, rate: 0.16, tilt: 1 }, mags: { wave: 'square', base: 245, rate: 0.074, tilt: 1 },\n  pell: { wave: 'saw', base: 140, rate: 0.09, tilt: 1 }, concord: { wave: 'saw', base: 112, rate: 0.085, tilt: 1 }, harvest: { wave: 'square', base: 138, rate: 0.08, tilt: 1 }, deserter: { wave: 'saw', base: 100, rate: 0.085, tilt: 1 },\n  column: { wave: 'triangle', base: 170, rate: 0.1, tilt: 1 }, '': { wave: 'triangle', base: 110, rate: 0.1, tilt: 1 },\n};\n// Twelve syllables per voice: vowel formant pair by consonant noise.\nexport function syllable(wave, base, i) {\n  const [f1, f2] = VOWELS[i % VOWELS.length];\n  const [cf, cv] = CONS[(i >> 1) % CONS.length];\n  const layers = [{ wave: 'sine', freq: f1, decay: 0.08, volume: 0.18 }, { wave: 'sine', freq: f2, decay: 0.07, volume: 0.1 }];\n  if (cv) layers.push({ wave: 'noise', freq: cf, decay: 0.012, volume: cv });\n  return { wave, freq: base, freqEnd: base * 0.9, attack: 0.005, decay: 0.09, volume: 0.3, layers };\n}\nconst BARKS = {\n  spotted: ['THERE! IN THE GRASS!', 'CONTACT!', 'THERE HE IS.', 'ON THE ROAD! ON THE ROAD!', 'SOMEBODY SEES HIM.'],\n  suspicious: ['WHO IS THAT?', 'SOMETHING MOVED.', 'YOU HEAR THAT?'],\n  lost: ['WHERE DID HE GO?', 'I HAD HIM. I HAD HIM.', 'LOST HIM.'],\n  heard: ['THAT WAS CLOSE.', 'GUNFIRE.', 'WAKE UP. WAKE UP.'],\n  giveup: ['IT WAS NOTHING.', 'GO BACK. IT WAS A DOG.', 'NOBODY PAYS ME TO LOOK.'],\n  jammed: [\"IT'S STUCK! IT'S STUCK AGAIN!\", 'THIS RUSTED PIECE OF-', 'SAME GUN, SAME DAY.'],\n  fire: ['WHO LIT THAT?', 'THE WIND! MOVE!', 'THE FIELD IS GOING!', 'GET OFF THE GRASS!'],\n  burning: ['GET IT OFF! GET IT OFF!', 'WATER!', 'NO NO NO NO'],\n  'ally-down-near': [\"LEAVE HIM, HE'S ALREADY GONE.\", 'THAT WAS MY COUSIN.', 'MAN DOWN.', 'WE ARE NOT PAID FOR THIS.'],\n  hit: ['AH!', 'MY ARM!', 'HE GOT ME!'],\n  fighting: ['KEEP FIRING!', 'AROUND THE SIDE!', 'FLANK HIM!'],\n};\nconst BY_FACTION = { concord: { spotted: ['THERE! IN THE GRASS!', 'ENGAGE, BY THE COLONEL\\'S ORDER.'], lost: ['REPORT SAYS HE IS GONE.'], jammed: ['REQUISITION A NEW ONE, THEY SAID.'], fire: ['WHO LIT THAT?', 'THAT IS NOT IN THE ORDERS.'] }, harvest: { spotted: ['THIEF ON THE LAND!', 'THERE! FOR THE PEOPLE!'], lost: ['THE LAND HID HIM.'], jammed: ['THE PEOPLE\\'S GUN IS STUCK!'], fire: ['THE FIELD IS OURS! WHO LIT IT?', 'WHO LIT THAT?'] } };\nexport class Voice {\n  subtitleUntil = 0; nextBark = 0;\n  constructor(game) { this.game = game; this.level = 1; }\n  build(ctx) { this.audio = ctx.audio; this.defs = new Map(); }\n  def(who, i) {\n    const k = `${who}:${i}`;\n    let d = this.defs.get(k);\n    if (!d) { const v = VOICES[who] ?? VOICES['']; d = syllable(v.wave, v.base, i); this.defs.set(k, d); }\n    return d;\n  }\n  /** How long the line takes to speak. Words hash to syllables so a word always sounds the same. */\n  lineSeconds(who, text) {\n    const v = VOICES[who] ?? VOICES[''];\n    let n = 0;\n    for (const w of text.split(/\\s+/)) n += Math.max(1, (w.match(/[AEIOUY]/gi) ?? []).length) + 0.4;\n    return clamp(n * v.rate, 0.5, 8);\n  }\n  say(who, text, { gain = 1, pan = 0 } = {}) {\n    const g = this.game;\n    const level = g.settings.voices * gain;\n    if (level <= 0.001 || !g.ctx.audio) return 0;\n    const v = VOICES[who] ?? VOICES[''];\n    const words = text.split(/\\s+/).filter(Boolean);\n    let t = 0;\n    const last = /[?]\\s*$/.test(text) ? 1 : -1;\n    for (let w = 0; w < words.length; w++) {\n      const word = words[w];\n      const h = hashStr(word.toUpperCase());\n      const vowels = Math.max(1, (word.match(/[AEIOUY]/gi) ?? []).length);\n      for (let s = 0; s < vowels; s++) {\n        const idx = (h >> (s * 3)) & 15;\n        const pitchBase = ((h >> (s + 5)) % 5) - 2;\n        const intonation = w >= words.length - 2 ? last * (s + 1) * 0.8 : 0;\n        const at = t;\n        const def = this.def(who, idx % 12);\n        g.afterReal(at, () => { if (!g.ended) this.audio.play(def, { volume: level * 0.8, pitch: pitchBase + intonation, pan }); });\n        t += v.rate;\n      }\n      t += /[,;:]$/.test(word) ? v.rate * 2.2 : v.rate * 0.4;\n    }\n    return t;\n  }\n  /** A soldier's bark: gibberish plus a short subtitle, in space. */\n  bark(s, kind) {\n    const g = this.game;\n    const time = g.realT;\n    if (s.barkAt && time - s.barkAt < 3) return;\n    if (time < this.nextBark && kind !== 'burning') return;\n    const fac = BY_FACTION[s.faction]?.[kind];\n    const pool = (fac && g.rng.look.chance(0.5)) ? fac : BARKS[kind];\n    if (!pool) return;\n    const text = g.rng.look.pick(pool);\n    s.barkAt = time;\n    this.nextBark = time + 1.2;\n    const sp = spatialize(g.listener(), [s.x, g.camPos.y, s.z], { max: 70, ref: 4 });\n    if (sp.gain < 0.02) return;\n    this.say(s.faction, text, { gain: sp.gain, pan: sp.pan });\n    if (sp.gain > 0.15 && !g.subtitle.active) g.say(s.faction, text, 1.8, true);\n    g.events.emit('bark', kind, text);\n  }\n}\nEOF\ncat > src/audio/ambience.js <<'EOF'\n// The world's sound floor: wind by speed, cicadas by day, insects by night, rain when it rains, a distant war now and then.\nimport { clamp } from '../core/rng.js';\nexport class Ambience {\n  distantT = 30;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    this.wind = ctx.audio.loop('wind-loop', { volume: 0 });\n    this.day = ctx.audio.loop('birds-loop', { volume: 0 });\n    this.night = ctx.audio.loop('insects-loop', { volume: 0 });\n    this.rain = ctx.audio.loop('rain-loop', { volume: 0 });\n  }\n  stop() { for (const v of [this.wind, this.day, this.night, this.rain]) v?.stop(); }\n  update(ctx, dt) {\n    const g = this.game;\n    if (g.ended) return;\n    const inOut = g.mode === 'title' ? 0.35 : 1;\n    this.wind?.set({ volume: clamp(0.08 + g.wind.total * 0.06, 0, 0.6) * inOut });\n    const n = g.sky.night ?? 0;\n    this.day?.set({ volume: (1 - n) * 0.35 * inOut });\n    this.night?.set({ volume: n * 0.5 * inOut });\n    this.rain?.set({ volume: g.sky.storm ? 0.6 : 0 });\n    if (g.mode === 'campaign' || g.mode === 'round') {\n      this.distantT -= dt;\n      if (this.distantT <= 0) { this.distantT = g.rng.look.range(30, 90); g.sfx.play('distant-fight', { volume: 0.25, pan: g.rng.look.range(-0.8, 0.8) }); }\n    }\n  }\n}\nEOF\ncat > tools/checkaudio.mjs <<'EOF'\nconst { renderSound, parseSong } = await import('../pixel-engine.js');\nconst { SOUNDS } = await import('../src/audio/sfx.js');\nconst { SONGS } = await import('../src/audio/music.js');\nlet bad = 0;\nfor (const [k, v] of Object.entries(SOUNDS)) { const s = renderSound(v); let m = 0; for (const x of s) m = Math.max(m, Math.abs(x)); if (m < 0.01) { console.log('silent', k, m); bad++; } }\nfor (const [k, s] of Object.entries(SONGS)) { try { parseSong(s); } catch (e) { console.log('song', k, e.message); bad++; } }\nconsole.log(Object.keys(SOUNDS).length, 'sounds', Object.keys(SONGS).length, 'songs', bad, 'bad');\nEOF\nnode tools/checkaudio.mjs 2>&1 | tail -8 | cut -c1-300","description":"Write all sound, music and voice data; verify non-silent and parseable","timeout":60000}}}
