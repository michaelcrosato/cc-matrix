{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013xD8PgPawfrb7jdja5Cf4c","type":"tool_result","content":"  buildChunk(ctx, cx, cz, mx, mz) {\n    const { ground, fire, world } = this.game;\n    const mask = (x, z) => {\n      const k = ground.kindAt(x, z);\n      if (k !== K.GRASS && k !== K.CROP && k !== K.WOOD && k !== K.BANK) return false;\n      const id = fire.idOf(x, z);\n      if (id < 0 || fire.state[id] === S.BURNT || fire.state[id] === S.BURNING) return false;\n      return true;\n    };\n    const crop = ground.kindAt(mx, mz) === K.CROP;\n    const field = new GrassField({ area: [CHUNK, CHUNK], at: [mx, 40, mz], count: 7000, height: crop ? [1.0, 1.7] : [0.4, 0.95], width: crop ? 0.14 : 0.1, base: PALETTE.orange\n    field.castShadow = false; field.receiveShadow = true; field.frustumCulled = false;\n    field.sway = 0.14;\n    ctx.scene.add(field);\n    const root = field.geometry.getAttribute('aRoot');\n    // Blades indexed by fire cell so a burn is one lookup.\n    const byCell = new Map();\n    const blades = field.blades;\n    for (let i = 0; i < blades; i++) {\n      const x = root.getX(i), z = root.getY(i);\n      const id = fire.idOf(x, z);\n      if (id < 0) continue;\n      if (!byCell.has(id)) byCell.set(id, []);\n      byCell.get(id).push(i);\n    }\n    this.chunks.set(this.key(cx, cz), { field, mx, mz, byCell });\n    this.built++;\n  }\n  /** A cell went burnt or burning: zero its blades in whichever chunks hold them. */\n  burnCell(id) {\n    const x = this.game.fire.wx(id), z = this.game.fire.wz(id);\n    const seen = new Set();\n    for (const [dx, dz] of [[-FCELL / 2, -FCELL / 2], [FCELL / 2, FCELL / 2]]) {\n      const [cx, cz] = this.coords(x + dx, z + dz);\n      const k = this.key(cx, cz);\n      if (seen.has(k)) continue;\n      seen.add(k);\n      const c = this.chunks.get(k);\n      if (!c) continue;\n      const list = c.byCell.get(id);\n      if (!list) continue;\n      for (const i of list) c.field.setMatrixAt(i, ZERO);\n      c.field.instanceMatrix.needsUpdate = true;\n      c.byCell.delete(id);\n    }\n  }\n  reset(ctx) {\n    for (const c of this.chunks.values()) { if (c.field) { ctx.scene.remove(c.field); c.field.dispose(); } }\n    this.chunks.clear();\n  }\n}\n  /** State 3 stays unburnable until the next save or day-roll, then is fresh fuel at half density. */\n  dayRoll() {\n    if (!this.regrown) return;\n    for (const id of this.regrown) {\n      if (this.state[id] !== S.REGROW) continue;\n      this.state[id] = S.FRESH;\n      this.counts.burnt = Math.max(0, this.counts.burnt - 1);\n      this.halfDensity = this.halfDensity || new Set();\n      this.halfDensity.add(id);\n      this.onFresh?.(id);\n    }\n    this.regrown.length = 0;\n  }\n  extinguishAll() {\n    for (const id of this.burning) {\n      this.state[id] = S.BURNT; this.burntAt[id] = this.hours; this.burntList.push(id);\n  refreshGrass(cx, cz, r) {\n    const g = this.game, fire = g.fire, ground = this.ground;\n    ground.forRadiusCells(cx, cz, r, (i) => { if (ground.kind[i] !== K.WATER) ground.kind[i] = K.GRASS; });\n    const c0 = fire.cellOf(cx - r, cz - r), c1 = fire.cellOf(cx + r, cz + r);\n    for (let z = c0.cz; z <= c1.cz; z++) for (let x = c0.cx; x <= c1.cx; x++) {\n      const id = x + z * FN;\n      if (Math.hypot(fire.wx(id) - cx, fire.wz(id) - cz) > r || fire.state[id] === S.BURNING) continue;\n      if (fire.state[id] !== S.FRESH) { const j = fire.burntList.indexOf(id); if (j >= 0) fire.burntList.splice(j, 1); if (fire.state[id] === S.BURNT) fire.counts.burnt--\n      fire.state[id] = S.FRESH; fire.fuel[id] = F.GRASS; fire.baseFuel[id] = F.GRASS;\n      for (let dz = 0; dz < 2; dz++) for (let dx = 0; dx < 2; dx++) {\nsrc/world/fire.js:170:      this.halfDensity = this.halfDensity || new Set();\nsrc/world/fire.js:171:      this.halfDensity.add(id);\nsrc/world/fire.js:222:    const half = this.halfDensity ? [...this.halfDensity] : [];\nsrc/world/fire.js:238:    this.halfDensit