{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HwYjY8TppHXYPmbDjtaqww","type":"tool_result","content":"  // Burn panic.\n  h.ignite();\n  t.ok('catches fire', h.burning > 0);\n  const hx = h.x, hz = h.z;\n  p.step(60 * 2);\n  t.ok('runs in panic', Math.hypot(h.x - hx, h.z - hz) > 3);\n  t.ok('fire spreads where they run or they die', g.fire.counts.lit >= 0);\n  p.step(60 * 4);\n  t.ok('dies in about 5 s', h.dead);\n  t.eq('load restores stones', g.story.stones, stonesAt);\n  t.eq('load restores land', g.fire.counts.burnt, saved.fire.runs ? g.fire.counts.burnt : 0);\n  t.ok('fire out after load', g.fire.counts.burning === 0);\n  t.near('load restores hour', g.clock.hour, 5.5, 5.7);\n  // JSON-safe.\n  JSON.stringify(g.save.snapshot('x'));\n  t.ok('save is plain JSON', true);\n  // Mercy run: on time pays four tablets.\n  g.missions.done.add('m1');\n  r.handleEvent(m, ['take', 1]);\n  m.x = c2.x; m.z = c2.z; g.player.teleport(c2.x, c2.z); p.step(2); r.handleEvent(m, ['take', 1]);\n  t.eq('carrying second', m.carrying, 1);\n  p.tp(TRUCK_AT_X, TRUCK_AT_Z + 4); p.look(TRUCK_AT_X, g.player.eye.y, TRUCK_AT_Z); p.step(3);\n  t.ok('bank prompt', g.state().prompts.some((x) => /BANK/.test(x.text)));\n  p.press('use');\n  t.eq('banked', m.stones, c2.stones); t.eq('case gone', c2.state, 'banked');\n  // AI mercs earn too.\n  for (let i = 0; i < 40 && r.mercs.slice(1).every((q) => q.stones === 0); i++) p.step(300);\n  t.ok('hired guns bank stones', r.mercs.slice(1).some((q) => q.stones > 0 || q.carrying >= 0));\n  // Time-up: finish with everyone present, once.\n  const out = {}; const off = g.events.on('round-finished', (o) => { Object.assign(out, o); });\n    // The guest's position reaches the host.\n    await b.evaluate(() => { const g = window.__GAME__; g.player.teleport(120, -240); window.__PIXEL_ENGINE__.step(2); });\n    await a.waitForFunction(() => { const m = window.__GAME__.round.mercs.find((x) => x.id === 1); return m && Math.hypot(m.x - 120, m.z + 240) < 3; }\n    t.ok('guest position reaches host', true);\n    // A shared fire: the host lights, the guest's grid follows.\n24:    b.sequence('burn', b.condition('on fire?', (o) => o.burning > 0), b.action('panic', (o, dt) => o.brainBurn(dt))),\n65:    this.dead = false; this.state = 'idle'; this.suspicion = 0; this.burning = 0; this.dodgeT = 0; this.target = null; this.lastKnown = null; this.goal = null; this.pa\n117:    this.burningAtDeath = this.burning > 0;\n118:    this.burning = 0;\n138:    if (this.dead || this.burning > 0 || this.game.round?.isClient) return;\n139:    this.burning = 5; this.state = 'burn';\n137:  ignite() {\n138-    if (this.dead || this.burning > 0 || this.game.round?.isClient) return;\n139-    this.burning = 5; this.state = 'burn';\n140-    this.panicDir = this.game.rng.ai.range(0, 6.28);\n25:  counts = { burning: 0, burnt: 0, lit: 0 };\n66:    this.counts.burning = 0; this.counts.burnt = 0; this.counts.lit = 0;\n89:    this.counts.burning++; this.counts.lit++;","is_error":false}]},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"bc143458-5e53-4811-9554-fa1d0aa8c58e","timestamp":"2026-11-06T05:56:44.917Z","tool_use_result":{"stdout":"  // Burn panic.\n  h.ignite();\n  t.ok('catches fire', h.burning > 0);\n  const hx = h.x, hz = h.z;\n  p.step(60 * 2);\n  t.ok('runs in panic', Math.hypot(h.x - hx, h.z - hz) > 3);\n  t.ok('fire spreads where they run or they die', g.fire.counts.lit >= 0);\n  p.step(60 * 4);\n  t.ok('dies in about 5 s', h.dead);\n  t.eq('load restores stones', g.story.stones, stonesAt);\n  t.eq('load restores land', g.fire.counts.burnt, saved.fire.runs ? g.fire.counts.burnt : 0);\n  t.ok('fire out after load', g.fire.counts.burning === 0);\n  t.near('load restores hour', g.clock.hour, 5.5, 5.7);\n  // JSON-safe.\n  JSON.stringify(g.save.snapshot('x'));\n  t.ok('save is plain JSON', true);\n  // Mercy run: on time pays four tablets.\n  g.missions.done.add('m1');\n  r.handleEven