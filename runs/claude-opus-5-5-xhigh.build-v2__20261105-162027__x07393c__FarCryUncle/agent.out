who.faction !== this.faction) { this.target = who; this.state = 'alert'; }\n    else if (opts.seat != null && who?.x != null) this.alertTo(who.x, who.z, who);\"\"\")\nopen(p,'w').write(s)\n\np='src/main.js'; s=open(p).read()\na=\"\"\"      const e = await Engine.headless(game, {});\n      hub.ready();\n      setInterval(() => e.step(6, 1 / 60), 100);\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"      const e = await Engine.headless(game, {});\n      setInterval(() => e.step(6, 1 / 60), 100);\"\"\")\nopen(p,'w').write(s)\n\np='src/game.js'; s=open(p).read()\na=\"\"\"    // Camera and view state.\n    this.frameControls(ctx, dt, realDt);\n    this.player.update(ctx, dt);\n    if (this.hasPlayer) this.vm.update(ctx, dt, realDt);\n    this.scene.update(ctx, dt);\n    this.driving.update(ctx, dt);\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    // A copy with no player of its own runs the world and draws nothing.\n    if (!this.hasPlayer) { this.actors.update(ctx, dt); this.round?.update(ctx, dt); return; }\n    // Camera and view state.\n    this.frameControls(ctx, dt, realDt);\n    this.player.update(ctx, dt);\n    this.vm.update(ctx, dt, realDt);\n    this.scene.update(ctx, dt);\n    this.driving.update(ctx, dt);\"\"\")\nopen(p,'w').write(s)\nEOF\ntimeout 590 node tests/run.mjs --only hub 2>&1 | grep -v '^`\\|WebGPURenderer\\|^file:' | grep -v 'pixel-engine.js\\|^    at ' | cut -c1-900 | tail -14","description":"Wire client shots and guard the server copy, run hub scenarios","timeout":595000}}}
