', '.o..oxo..o.', '.ooooooooo.', '.o...x...o.', '.o..xxx..o.', '.o...x...o.', '..ooooooo..'],\n16\t};\n17\tconst COLORS = { CROSS: 'cyan', CIRCLE: 'red', SQUARE: 'orange', TRIANGLE: 'lime', A: 'lime', B: 'red', X: 'sky', Y: 'sand' };\n18\tconst SPRITES = { ...S };\n19\tconst LETTER_CAP = (o) => o; // caps are drawn by rect + text\n20\texport const CAP_WIDTH = (label) => Math.max(11, label.length * 6 + 5);\n21\t/** Draw one glyph. Returns its width in art pixels. */\n22\t/** The glyphs drawn this frame, for state() and the tests. */\n23\texport const drawnGlyphs = [];\n24\texport function drawGlyph(hud, x, y, name, { device, anchor = 'top-left' } = {}) {\n25\t  drawnGlyphs.push(name);\n26\t  const sp = SPRITES[name];\n27\t  if (sp) {\n28\t    hud.sprite(x, y, sp, { o: 'white', x: COLORS[name] ?? 'sand' }, { anchor });\n29\t    return 11;\n30\t  }\n31\t  // Shoulder buttons, Xbox face buttons and keys: a cap with a label.\n32\t  const round = name === 'A' || name === 'B' || name === 'X' || name === 'Y';\n33\t  const w = CAP_WIDTH(name);\n34\t  hud.rect(x, y, w, 11, 'ink', anchor);\n35\t  hud.rect(x, y, w, 1, 'white', anchor); hud.rect(x, y + 10, w, 1, 'white', anchor);\n36\t  hud.rect(x, y, 1, 11, 'white', anchor); hud.rect(x + w - 1, y, 1, 11, 'white', anchor);\n37\t  hud.text(x + 3, y + 2, name, { color: round ? (COLORS[name] ?? 'white') : 'white', shadow: false, anchor });\n38\t  return w;\n39\t}\n40\texport const glyphWidth = (name) => (SPRITES[name] ? 11 : CAP_WIDTH(name));\n41\texport const GLYPH_NAMES = Object.keys(SPRITES);\n42\t"}]},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"3d9dce17-be7b-4dfe-acbf-26c2194e0ddc","timestamp":"2026-11-06T04:07:28.234Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-162027__x07393c/work/FarCryUncle-FarCry2-claude-opus-5-5-xhigh-20261105-162027/src/ui/glyphs.js","content":"// Pixel-art button glyphs drawn as hud.sprite rows, about 11 x 11. Keys get a cap drawn around their letter.\nconst shape = (rows) => rows;\nconst S = {\n  CROSS: ['...ooooo...', '.oo.....oo.', '.o.x...x.o.', 'o...x.x...o', 'o....x....o', 'o...x.x...o', '.o.x...x.o.', '.oo.....oo.', '...ooooo...'],\n  CIRCLE: ['...ooooo...', '.oo.....oo.', '.o..xxx..o.', 'o..x...x..o', 'o..x...x..o', 'o..x...x..o', '.o..xxx..o.', '.oo.....oo.', '...ooooo...'],\n  SQUARE: ['...ooooo...', '.oo.....oo.', '.o.xxxxx.o.', 'o..x...x..o', 'o..x...x..o', 'o..x...x..o', '.o.xxxxx.o.', '.oo.....oo.', '...ooooo...'],\n  TRIANGLE: ['...ooooo...', '.oo.....oo.', '.o...x...o.', 'o...x.x...o', 'o..x...x..o', 'o.xxxxxxx.o', '.o.......o.', '.oo.....oo.', '...ooooo...'],\n  UP: ['....xxx....', '...xxxxx...', '...xxxxx...', 'ooo.....ooo', 'o.........o', 'o.........o', 'ooo.....ooo', '....o.o....', '....ooo....'],\n  DOWN: ['....ooo....', '....o.o....', 'ooo.....ooo', 'o.........o', 'o.........o', 'ooo.....ooo', '...xxxxx...', '...xxxxx...', '....xxx....'],\n  LEFT: ['....ooo....', '....o.o....', 'xxx.o.o.ooo', 'xxx.....o..', 'xxx.....o..', 'xxx.....o..', 'xxx.o.o.ooo', '....o.o....', '....ooo....'],\n  RIGHT: ['....ooo....', '....o.o....', 'ooo.o.o.xxx', '..o.....xxx', '..o.....xxx', '..o.....xxx', 'ooo.o.o.xxx', '....o.o....', '....ooo....'],\n  LMB: ['..ooooooo..', '.oxxxxoo.o.', '.oxxxxo..o.', '.oxxxxo..o.', '.ooooooooo.', '.o.......o.', '.o.......o.', '.o.......o.', '..ooooooo..'],\n  RMB: ['..ooooooo..', '.o.ooxxxxo.', '.o..oxxxxo.', '.o..oxxxxo.', '.ooooooooo.', '.o.......o.', '.o.......o.', '.o.......o.', '..ooooooo..'],\n  MMB: ['..ooooooo..', '.o..oxo..o.', '.o..oxo..o.', '.o..oxo..o.', '.ooooooooo.', '.o.......o.', '.o.......o.', '.o.......o.', '..ooooooo..'],\n  WHEEL: ['..ooooooo..', '.o..oxo..o.', '.o..oxo..o.', '.o..oxo..o.', '.ooooooooo.', '.o...x...o.', '.o..xxx..o.', '.o...x...o.', '..ooooooo..'],\n};\nconst COLORS = { CROSS: 'cyan', CIRCLE: 'red', SQUARE: 'orange', TRIANGLE: 'lime', A: 'lime', B: 'red', X: 'sky', Y: 'sand' };\nconst SPRITES = { ...S };\nconst LETTER_CAP = (o) => o; // caps are drawn by rect + text\nexport const CAP_WIDTH = (label) => Math.max(11, label.length * 6 + 5);\n/** Draw one glyph. Returns its width in art pixels. */\n/** The glyphs drawn this frame, for state() and the tests. */\nexport const drawnGlyphs = [];\nexport function drawGlyph(hud, x, y, name, { device, anchor = 'top-left' } = {}) {\n  drawnGlyphs.push(name);\n  const sp = SPRITES[name];\n  if (sp) {\n    hud.sprite(x, y, sp, { o: 'white', x: COLORS[name] ?? 'sand' }, { anchor });\n    return 11;\n  }\n  // Shoulder buttons, Xbox face buttons and keys: a cap with a label.\n  const round = name === 'A' || name === 'B' || name === 'X' || name === 'Y';\n  const w = CAP_WIDTH(name);\n  hud.rect(x, y, w, 11, 'ink', anchor);\n  hud.rect(x, y, w, 1, 'white', anchor); hud.rect(x, y + 10, w, 1, 'white', anchor);\n  hud.rect(x, y, 1, 11, 'white', anchor); hud.rect(x + w - 1, y, 1, 11, 'white', anchor);\n  hud.text(x + 3, y + 2, name, { color: round ? (COLORS[name] ?? 'white') : 'white', shadow: false, anchor });\n  return w;\n}\nexport const glyphWidth = (name) => (SPRITES[name] ? 11 : CAP_WIDTH(name));\nexport const GLYPH_NAMES = Object.keys(SPRITES);\n","numLines":42,"startLine":1,"totalLines":42}},"tool_result_meta":[{"id":"toolu_015HfrcAvqiEpqPns5MvvyeN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
