rt const HANDS_RIG = { joints: ['Root', 'Weapon', 'Mag', 'Bolt', 'ArmR', 'HandR', 'Off', 'ArmL', 'HandL', 'FingerL', 'MapJ', 'Leg'], root: 'Root', mirror: {}, soles: [], trace: [], limits: {}, fps: 30 };\nEOF\ncat > src/art/clips.js <<'EOF'\n// New clips on the people rig (hero joint names). Armed uppers, burning, begging, the cast's habits.\nconst R = [0, 0, 0];\nconst aimUpper = (twist = 0) => ({ Torso: [4, twist, 0], Head: [-4, -twist, 0], ArmR: [-62, 0, -6], ForearmR: [-42, 0, 0], HandR: R, ArmL: [-78, 0, 18], ForearmL: [-22, 0, 0], HandL: R });\nconst legsStand = { Pelvis: { r: R, p: [0, -0.03, 0] }, LegR: [-6, 0, 0], ShinR: [10, 0, 0], FootR: [-4, 0, 0], LegL: [-8, 0, 0], ShinL: [14, 0, 0], FootL: [-6, 0, 0] };\nconst kneel = { Pelvis: { r: [0, 0, 0], p: [0, -0.34, 0] }, LegR: [-78, 0, 0], ShinR: [120, 0, 0], FootR: [-40, 0, 0], LegL: [-20, 0, 0], ShinL: [94, 0, 0], FootL: [10, 0, 0] };\nconst seat = { Pelvis: { r: R, p: [0, -0.36, 0] }, LegR: [-86, 0, 0], ShinR: [86, 0, 0], FootR: R, LegL: [-86, 0, 0], ShinL: [86, 0, 0], FootL: R };\nexport const PEOPLE_CLIPS = [\n  { name: 'AimIdle', frames: 40, loop: true, keys: [[0, aimUpper(0)], [20, { ...aimUpper(0), Torso: [5, 2, 0] }], [40, aimUpper(0)]] },\n  { name: 'AimWalk', frames: 12, loop: true, keys: [[0, aimUpper(-4)], [6, aimUpper(4)], [12, aimUpper(-4)]] },\n  { name: 'FireRecoil', frames: 5, fast: true, keys: [[0, aimUpper(0)], [1, { Torso: [-5, 0, 0], ArmR: [-70, 0, -6], ArmL: [-84, 0, 18] }, 'out'], [5, aimUpper(0)]] },\n  { name: 'Reload', frames: 40, keys: [[0, aimUpper(0)], [8, { Torso: [12, 0, 0], ArmL: [-40, 0, 30], ForearmL: [-60, 0, 0], ArmR: [-50, 0, -6], ForearmR: [-60, 0, 0] }], [24, { ArmL: [-22, 0, 16], ForearmL: [-30, 0, 0] }], [32, { ArmL: [-60, 0, 26], ForearmL: [-50, 0, 0] }], [40, aimUpper(0)]] },\n  { name: 'ThrowBottle', frames: 20, fast: true, keys: [[0, aimUpper(0)], [6, { Torso: [-12, 20, 0], ArmR: [-170, 0, -10], ForearmR: [-50, 0, 0] }], [11, { Torso: [20, -24, 0], ArmR: [-60, 0, -