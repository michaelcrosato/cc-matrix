.Group();\n    for (const [w, h, d, c] of [[0.1, 0.03, 0.03, PALETTE.white], [0.03, 0.1, 0.03, PALETTE.sand], [0.05, 0.05, 0.14, PALETTE.orange]]) { const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), glowMaterial(c)); m.frustumCulled = false; m.castShadow = false; flash.add(m); }\n    flash.visible = false;\n    setLookLayer(flash, 'actors');\n    this.named.Weapon.add(flash);\n    this.flashObj = flash;\n    // The map: DataTexture plane, drawn by world/map-texture.js, under MapJ.\"\"\")\na=\"\"\"    this.kick = 1; this.flash = 1;\n    const id = this.gunId;\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    this.kick = 1; this.flash = 1;\n    const id = this.gunId;\n    const parts = GUN_PARTS[id];\n    if (parts?.muzzle && !WEAPONS[id]?.stream) { this.flashObj.position.set(...parts.muzzle); this.flashObj.rotation.z = this.game.rng.fx.range(0, 3); this.flashObj.visible = true; }\"\"\")\na=\"\"\"    this.flash = Math.max(0, this.flash - dt * 12);\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    this.flash = Math.max(0, this.flash - dt * 12);\n    if (this.flash <= 0.4 && this.flashObj) this.flashObj.visible = false;\"\"\")\nopen(p,'w').write(s)\n\n# ---- smoke column, dust, cook-off on catching ----\np='src/world/fireview.js'; s=open(p).read()\na=\"\"\"    // Up to 3 lights, by size.\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    // A column of smoke visible across the map for a game day: what you did at the depot.\n    const st = g.story;\n    if (st?.smokeUntil > g.clock.abs && st.smokeAt && (this.columnT = (this.columnT ?? 0) - dt) <= 0) {\n      this.columnT = 0.25;\n      const [sx, sz] = st.smokeAt;\n      ctx.particles.burst('fire-smoke', [sx, g.world.heightAt(sx, sz) + 6, sz], { count: 5, direction: [g.wind.vx * 0.1, 1, g.wind.vz * 0.1], speed: 2 });\n    }\n    // Up to 3 lights, by size.\"\"\")\nopen(p,'w').write(s)\n\np='src/world/sky.js'; s=open(p).read()\na=\"\"\"    if (this.rain && this.storm) {\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    if (this.dus