') ?? []) { const l = h.object.getObjectByName('Lamp'); if (l) l.visible = on; }\n  }\n  darkenVillage() { this.hutsLit = null; }\n  /** Without the alternate plan: a line of people walks the road to the clinic. */\n  startRefugees() {\n    const pts = [[-262, 250], [-240, 120], [-200, 30], [-100, 35], [-44, 24]];\n    this.column = { pts, s: 0, L: polyLength(pts), speed: 2.2, refugees: true, marker: { x: pts[0][0], z: pts[0][1], name: 'THE LINE' } };\n    this.game.map.markers.push(this.column.marker);\n    this.game.map.dirty = true;\n  }\"\"\")\na=\"\"\"    c.s = Math.min(c.L, c.s + c.speed * dt);\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    c.s = Math.min(c.L, c.s + c.speed * dt);\n    if (c.refugees && c.s >= c.L) { this.stopColumn(); g.map.markers = g.map.markers.filter((m) => m.name !== 'THE LINE'); g.map.dirty = true; return; }\"\"\")\na=\"\"\"      p.p.anim.set(c.speed > 0 ? 'Walk' : 'Idle');\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"      p.p.anim.set(c.speed > 0 ? (p.i % 5 === 0 ? 'CarryOver' : p.i % 7 === 3 ? 'WalkHandsTied' : 'Walk') : 'Idle');\"\"\")\nopen(p,'w').write(s)\n\np='src/art/models.js'; s=open(p).read()\na=\"\"\"{ box: [1.4, 2, 0.1], at: [0, 1, 1.3], c: 'dark', collide: false }] });\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"{ box: [1.4, 2, 0.1], at: [0, 1, 1.3], c: 'dark', collide: false }, { group: [{ box: [0.5, 0.5, 0.06], at: [0, 1.1, 1.36], c: 'lamp', glow: true }], at: [0, 0, 0], pivot: true, name: 'Lamp' }] });\"\"\")\ns=s.replace(\"palette: { wall: 'orange', thatch: 'sand', dark: 'plum' },\",\"palette: { wall: 'orange', thatch: 'sand', dark: 'plum', lamp: 'sand' },\")\n# windows glow for the fort at night handled by lights\nopen(p,'w').write(s)\n\np='src/missions/scripts.js'; s=open(p).read()\na=\"\"\"        g.actors.civilians.emptyVillage();\n        g.story.odileRefuses = true;\n        g.story.flags.wellsEmpty = true;\n        g.world.darkenVillage?.();\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"        g.actors.civilians.emptyVil