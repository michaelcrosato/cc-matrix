nfo.TECH, artDirection: info['ART DIRECTION'], animation: info.ANIMATION, audio: info.AUDIO, online: info.ONLINE, testing: info.TESTING, research: info.RESEARCH, environment: info.ENVIRONMENT, model: info.MODEL, usage: info.USAGE },\n  testingFeedback: TESTING_FEEDBACK.map(([, a]) => fill(a)),\n  engineFeedback: ENGINE_FEEDBACK.map(([, a]) => a),\n  promptFeedback: PROMPT_FEEDBACK.map(([, a]) => a),\n  aiHub: AI_HUB,\n};\nwriteFileSync(join(ROOT, '..', 'exit-interview.json'), `${JSON.stringify(out, null, 2)}\\n`);\nconsole.log(`exit-interview.json written; ${all} issues, ${critical} critical`);\nEOF\necho \"export const ISSUE_COUNTS = { all: 0, critical: 0 };\" > src/content/issue-counts.js\nnode tools/exit.mjs 2>&1 | tail -1 | cut -c1-200; python3 -c \"import json;d=json.load(open('../exit-interview.json'));print(list(d.keys()), len(d['testingFeedback']), len(d['engineFeedback']), len(d['promptFeedback']), d['aiHub']['players'])\"; timeout 300 node tests/run.mjs --only static 2>&1 | grep -v '^`\\|WebGPURenderer\\|^file:' | grep -v 'pixel-engine.js' | cut -c1-260 | tail -6","description":"Write About answers, exit interview generator, run static","timeout":320000}}}
