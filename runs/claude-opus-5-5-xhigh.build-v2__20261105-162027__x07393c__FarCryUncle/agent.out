0); } } }\nconsole.log('fails', JSON.stringify(fails).slice(0, 200)); console.log(problems.slice(0, 22).join('\\n'));\nprocess.exit(0);\nEOF\ntimeout 120 node tools/tmp-clips.mjs 2>&1 | grep -v '^`\\|WebGPURenderer\\|^file:\\|^ *\\^' | cut -c1-430 | tail -34; rm -f tools/tmp-clips.mjs","description":"Probe analyzeClip with the people rig","timeout":150000}}}
