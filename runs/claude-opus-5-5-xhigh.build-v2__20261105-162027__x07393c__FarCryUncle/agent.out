hain-link and pipe cage with a padlocked gate', tags: ['post'], collider: 'parts', palette: { bar: 'mist', dark: 'night', lock: 'sand' },\n  parts: [...[-1.6, -0.8, 0, 0.8, 1.6].flatMap((x) => [{ box: [0.08, 2.4, 0.08], at: [x, 1.2, -1.6], c: 'bar' }]), ...[-1.6, -0.8, 0, 0.8, 1.6].flatMap((z) => [{ box: [0.08, 2.4, 0.08], at: [-1.6, 1.2, z], c: 'bar' }, { box: [0.08, 2.4, 0.08], at: [1.6, 1.2, z], c: 'bar' }]), { box: [3.3, 0.1, 3.3], at: [0, 2.4, 0], c: 'dark', collide: false },\n    { group: [...[-0.8, 0, 0.8].map((x) => ({ box: [0.08, 2.4, 0.08], at: [x + 0.8, 0, 0], c: 'bar' })), { box: [1.7, 0.08, 0.08], at: [0.8, 0.8, 0], c: 'bar' }, { box: [0.16, 0.2, 0.16], at: [1.6, 0, 0], c: 'lock' }], at: [-0.8, 1.2, 1.6], pivot: true, name: 'Gate' }] });\nexport const observatoryDome = model({ id: 'observatory-dome', about: 'Harrow’s trig station: a round stone drum and a cracked dome', tags: ['building'], collider: 'parts', palette: { wall: 'mist', dome: 'white', dark: 'night', slit: 'ink' },\n  parts: [{ box: [8, 3.6, 0.3], at: [0, 1.8, -5], c: 'wall' }, { box: [0.3, 3.6, 10], at: [-4.5, 1.8, 0], c: 'wall' }, { box: [0.3, 3.6, 10], at: [4.5, 1.8, 0], c: 'wall' }, { box: [2.6, 3.6, 0.3], at: [-3.2, 1.8, 5], c: 'wall' }, { box: [2.6, 3.6, 0.3], at: [3.2, 1.8, 5], c: 'wall' }, { ball: [10, 5, 10.4], at: [0, 6.2, 0], half: true, c: 'dome', collide: false }, { box: [1.3, 3.6, 0.1], at: [0, 6.8, 4.4], rot: [-30, 0, 0], c: 'slit', collide: false }, { box: [9, 0.04, 10], at: [0, 0.02, 0], c: 'dark', collide: false }] });\nexport const fortWall = model({ id: 'fort-wall', about: 'A colonial stone wall of Fort Clement, gate in the middle', tags: ['building'], collider: 'parts', palette: { stone: 'mist', dark: 'slate', top: 'white' },\n  parts: [{ box: [32, 5, 1.2], at: [-20, 2.5, 0], c: 'stone' }, { box: [32, 5, 1.2], at: [20, 2.5, 0], c: 'stone' }, { box: [8.2, 1.8, 1.2], at: [0, 5.1, 0], c: 'stone', collide: false }, ...[-34, -26, -18, -10, 10, 18, 26, 34].map((x) => ({ box: [2.4, 0.9, 1.3], at: [x, 5.45, 0], c: 'top', collide: false })), { box: [0.3, 0.6, 0.1], at: [-4.2, 3.2, 0.62], c: 'dark', collide: false }] });\nexport const fortWallSide = model({ id: 'fort-wall-side', about: 'A plain length of the fort wall', tags: ['building'], collider: 'parts', palette: { stone: 'mist', top: 'white' }, parts: [{ box: [76, 5, 1.2], at: [0, 2.5, 0], c: 'stone' }, ...[-32, -20, -8, 8, 20, 32].map((x) => ({ box: [3, 0.9, 1.3], at: [x, 5.45, 0], c: 'top', collide: false }))] });\nexport const flagPole = model({ id: 'flag-pole', about: 'A tall white flag pole on a stone base', tags: ['landmark'], collider: 'cyl', palette: { pole: 'white', base: 'slate' }, parts: [{ box: [0.16, 9, 0.16], at: [0, 4.5, 0], c: 'pole' }, { box: [1.4, 0.5, 1.4], at: [0, 0.25, 0], c: 'base' }] });\nexport const cistern = model({ id: 'cistern', about: 'The village cistern: a squat concrete tank fed by a pipe', tags: ['building'], collider: 'cyl', palette: { wall: 'mist', pipe: 'teal', water: 'blue' }, parts: [{ cyl: [7, 2.4, 7], at: [0, 1.2, 0], seg: 10, c: 'wall' }, { cyl: [5.6, 0.06, 5.6], at: [0, 2.42, 0], seg: 10, c: 'water' }, { box: [0.4, 0.4, 4], at: [3.6, 2, 0], rot: [0, 0, 0], c: 'pipe', collide: false }] });\nexport const signBorder = model({ id: 'sign-border', about: 'A bullet-holed border sign on two posts', tags: ['landmark'], collider: 'none', palette: { post: 'plum', board: 'mist', mark: 'red' }, parts: [{ box: [0.2, 3, 0.2], at: [-1.2, 1.5, 0], c: 'post' }, { box: [0.2, 3, 0.2], at: [1.2, 1.5, 0], c: 'post' }, { box: [3.2, 1.2, 0.1], at: [0, 2.4, 0.1], c: 'board' }, { box: [2.6, 0.2, 0.04], at: [0, 2.7, 0.17], c: 'mark' }] });\nexport const tableLamp = model({ id: 'table-lamp', about: 'Harrow’s table: maps, a lamp, a chair', tags: ['scene'], collider: 'box', light: { at: [0.4, 1.1, 0], c: 'sand', intensity: 8, radius: 9, flicker: 'torch' }, palette: { wood: 'plum', paper: 'sand', lamp: 'sand', glass: 'white', ink: 'ink' },\n  parts: [{ box: [2, 0.1, 1.2], at: [0, 0.8, 0], c: 'wood' }, ...[[-0.9, -0.5], [0.9, -0.5], [-0.9, 0.5], [0.9, 0.5]].map(([x, z]) => ({ box: [0.1, 0.8, 0.1], at: [x, 0.4, z], c: 'wood', collide: false })), { box: [1.1, 0.02, 0.8], at: [-0.3, 0.86, 0], c: 'paper', collide: false }, { cyl: [0.2, 0.1, 0.2], at: [0.6, 0.9, 0], c: 'lamp', collide: false }, { cyl: [0.14, 0.24, 0.14], at: [0.6, 1.06, 0], c: 'glass', glow: true, collide: false }] });\nexport const stoneCase = model({ id: 'stone-case', about: 'A small steel case of rough stones with a broken lock', tags: ['pickup'], collider: 'none', floats: true, palette: { steel: 'mist', band: 'night', lock: 'sand' }, parts: [{ box: [0.5, 0.2, 0.34], at: [0, 0.1, 0], c: 'steel' }, { box: [0.52, 0.04, 0.36], at: [0, 0.14, 0], c: 'band' }, { box: [0.1, 0.1, 0.03], at: [0, 0.12, 0.18], c: 'lock' }, { box: [0.2, 0.04, 0.04], at: [0, 0.23, 0], c: 'band' }] });\nexport const medicineCrate = model({ id: 'medicine-crate', about: 'A white crate stencilled with a green cross', tags: ['pickup'], collider: 'none', floats: true, palette: { wood: 'white', cross: 'green', band: 'mist' }, parts: [{ box: [0.8, 0.5, 0.5], at: [0, 0.25, 0], c: 'wood' }, { box: [0.3, 0.08, 0.02], at: [0, 0.25, 0.26], c: 'cross' }, { box: [0.08, 0.3, 0.02], at: [0, 0.25, 0.26], c: 'cross' }, { box: [0.84, 0.06, 0.54], at: [0, 0.46, 0], c: 'band' }] });\nexport const bedFrame = model({ id: 'safe-bed', about: 'A rusted iron cot', tags: ['safehouse'], collider: 'none', palette: { frame: 'night', mat: 'sand', pill: 'white' }, parts: [{ box: [0.9, 0.12, 2], at: [0, 0.4, 0], c: 'mat' }, { box: [1, 0.08, 2.1], at: [0, 0.3, 0], c: 'frame' }, { box: [0.6, 0.1, 0.4], at: [0, 0.5, -0.7], c: 'pill' }, ...[[-0.45, -0.95], [0.45, -0.95], [-0.45, 0.95], [0.45, 0.95]].map(([x, z]) => ({ box: [0.07, 0.3, 0.07], at: [x, 0.15, z], c: 'frame' }))] });\nexport const locker = model({ id: 'safe-locker', about: 'A dented steel weapons locker', tags: ['safehouse'], collider: 'box', palette: { steel: 'slate', dark: 'ink', handle: 'mist' }, parts: [{ box: [1.2, 1.9, 0.5], at: [0, 0.95, 0], c: 'steel' }, { box: [0.04, 1.8, 0.02], at: [0, 0.95, 0.26], c: 'dark' }, { box: [0.06, 0.2, 0.04], at: [0.12, 1.05, 0.27], c: 'handle' }] });\nexport const nameWall = model({ id: 'name-wall', about: 'A plank for names scratched by whoever is left', tags: ['safehouse'], collider: 'none', palette: { wood: 'plum', mark: 'mist' }, parts: [{ box: [1.8, 1, 0.06], at: [0, 1.4, 0], c: 'wood' }, { box: [1.4, 0.03, 0.02], at: [0, 1.6, 0.04], c: 'mark' }, { box: [1.1, 0.03, 0.02], at: [0, 1.4, 0.04], c: 'mark' }, { box: [1.3, 0.03, 0.02], at: [0, 1.2, 0.04], c: 'mark' }] });\nexport const groundGun = model({ id: 'ground-gun', about: 'A rifle lying on the ground, muzzle in the dirt', tags: ['pickup'], collider: 'none', floats: true, palette: { wood: 'red', steel: 'ink' }, parts: [{ box: [0.06, 0.08, 0.6], at: [0, 0.05, 0], c: 'steel' }, { box: [0.08, 0.09, 0.28], at: [0, 0.05, -0.38], c: 'wood' }, { box: [0.05, 0.05, 0.28], at: [0, 0.05, 0.42], c: 'steel' }] });\nexport const ammoCrate = model({ id: 'ammo-crate', about: 'A stencilled ammo crate', tags: ['safehouse', 'pickup'], collider: 'box', palette: { wood: 'teal', band: 'night', mark: 'sand' }, parts: [{ box: [1, 0.55, 0.6], at: [0, 0.28, 0], c: 'wood' }, { box: [1.04, 0.08, 0.64], at: [0, 0.5, 0], c: 'band' }, { box: [0.4, 0.12, 0.02], at: [0, 0.28, 0.31], c: 'mark' }] });\n\n// ---- Vehicles: origin at the chassis centre, +Z forward. Bodies are open from inside so the driver sees out. ----\nconst wheelMount = (w = 1.9, l = 3.2) => [[w / 2, l / 2], [-w / 2, l / 2], [w / 2, -l / 2], [-w / 2, -l / 2]];\nexport const wheelDef = model({ id: 'wheel', about: 'A truck wheel: black tyre, pale hub', tags: ['vehicle'], floats: true, collider: 'none', palette: { tyre: 'ink', hub: 'mist' }, parts: [{ cyl: [0.84, 0.3, 0.84], rot: [0, 0, 90], at: [0, 0, 0], seg: 10, c: 'tyre' }, { cyl: [0.4, 0.32, 0.4], rot: [0, 0, 90], at: [0, 0, 0], seg: 6, c: 'hub' }] });\nconst cab = (w, y0, z0, z1, h, c = 'paint') => [\n  { box: [w, 0.1, z1 - z0 + 0.1], at: [0, y0 + h, (z0 + z1) / 2], c: 'roof' },\n  ...[[-w / 2, z0], [w / 2, z0], [-w / 2, z1], [w / 2, z1]].map(([x, z]) => ({ box: [0.08, h, 0.08], at: [x, y0 + h / 2, z], c: 'dark' })),\n  ...[-1, 1].map((s) => ({ box: [0.08, 0.5, z1 - z0], at: [s * w / 2, y0 + 0.25, (z0 + z1) / 2], c })),\n  { box: [w, 0.5, 0.1], at: [0, y0 + 0.25, z0], c },\n];\nconst pickupBody = (extra = [], bed = []) => [\n  { box: [1.8, 0.5, 4.2], at: [0, -0.1, 0], c: 'dark' },\n  { box: [1.86, 0.5, 1.4], at: [0, 0.34, 1.5], c: 'paint' }, { box: [1.7, 0.06, 1.3], at: [0, 0.62, 1.5], c: 'hood' },\n  { box: [1.4, 0.06, 0.08], at: [0, 0.4, 2.24], c: 'dark' }, { box: [0.26, 0.2, 0.06], at: [0.66, 0.3, 2.24], c: 'lamp', glow: true }, { box: [0.26, 0.2, 0.06], at: [-0.66, 0.3, 2.24], c: 'lamp', glow: true },\n  ...cab(1.84, 0.1, -0.2, 0.8, 1.14),\n  { box: [1.6, 0.4, 0.12], at: [0, 0.3, 0.74], c: 'dark' },\n  { box: [1.84, 0.46, 0.08], at: [0, 0.36, -2.1], c: 'paint' }, { box: [0.08, 0.46, 1.84], at: [-0.9, 0.36, -1.2], c: 'paint' }, { box: [0.08, 0.46, 1.84], at: [0.9, 0.36, -1.2], c: 'paint' }, { box: [1.8, 0.04, 1.9], at: [0, 0.16, -1.2], c: 'dark' },\n  ...bed, ...extra,\n];\nexport const pickup = model({ id: 'pickup', about: 'A dented pickup in faded paint', tags: ['vehicle'], floats: true, collider: 'none', palette: { paint: 'orange', hood: 'red', roof: 'sand', dark: 'ink', lamp: 'sand' }, parts: pickupBody() });\nexport const technical = model({ id: 'technical', about: 'A pickup with a mounted machine gun on a pintle', tags: ['vehicle'], floats: true, collider: 'none', palette: { paint: 'slate', hood: 'night', roof: 'mist', dark: 'ink', lamp: 'sand', gun: 'night' },\n  parts: pickupBody([], [{ box: [0.14, 1, 0.14], at: [0, 0.8, -1.2], c: 'gun' }, { group: [{ box: [0.2, 0.26, 0.9], at: [0, 0, 0.1], c: 'gun' }, { box: [0.07, 0.07, 1.1], at: [0, 0.04, 1], c: 'gun' }, { box: [0.3, 0.3, 0.3], at: [-0.22, -0.06, 0.1], c: 'dark' }], at: [0, 1.36, -1.2], pivot: true, name: 'Turret' }]) });\nconst truckBody = (bed) => [\n  { box: [2.2, 0.5, 6.2], at: [0, -0.1, 0], c: 'dark' }, { box: [2.26, 0.7, 1.3], at: [0, 0.5, 2.4], c: 'paint' }, { box: [2.1, 0.08, 1.2], at: [0, 0.88, 2.4], c: 'hood' },\n  { box: [0.3, 0.24, 0.06], at: [0.82, 0.4, 3.06], c: 'lamp', glow: true }, { box: [0.3, 0.24, 0.06], at: [-0.82, 0.4, 3.06], c: 'lamp', glow: true },\n  ...cab(2.24, 0.2, 0.4, 1.6, 1.3),\n  { box: [2, 0.5, 0.12], at: [0, 0.5, 1.6], c: 'dark' }, ...bed,\n];\nexport const truck = model({ id: 'truck', about: 'A cargo truck with slatted sides and a canvas hoop', tags: ['vehicle'], floats: true, collider: 'none', palette: { paint: 'green', hood: 'teal', roof: 'teal', dark: 'ink', lamp: 'sand', slat: 'plum', canvas: 'sand' },\n  parts: truckBody([{ box: [2.3, 0.1, 3.9], at: [0, 0.24, -1.2], c: 'slat' }, { box: [0.1, 0.9, 3.9], at: [-1.1, 0.7, -1.2], c: 'slat' }, { box: [0.1, 0.9, 3.9], at: [1.1, 0.7, -1.2], c: 'slat' }, { box: [2.3, 0.9, 0.1], at: [0, 0.7, -3.1], c: 'slat' }, { box: [2.3, 0.1, 3.9], at: [0, 2.1, -1.2], c: 'canvas' }, ...[-2.6, -1.2, 0.2].flatMap((z) => [{ box: [0.08, 1.3, 0.08], at: [1.1, 1.5, z], c: 'dark' }, { box: [0.08, 1.3, 0.08], at: [-1.1, 1.5, z], c: 'dark' }])]) });\nexport const tanker = model({ id: 'tanker', about: 'A fuel tanker with a long dented tank', tags: ['vehicle', 'explosive'], floats: true, collider: 'none', palette: { paint: 'red', hood: 'plum', roof: 'plum', dark: 'ink', lamp: 'sand', tank: 'mist', band: 'orange' },\n  parts: truckBody([{ cyl: [2, 3.9, 2], at: [0, 1.15, -1.2], rot: [90, 0, 0], seg: 8, c: 'tank' }, { cyl: [2.06, 0.3, 2.06], at: [0, 1.15, -1.2], rot: [90, 0, 0], seg: 8, c: 'band' }]) });\nexport const wreckPickup = model({ id: 'wreck-pickup', about: 'A burned-out pickup on its rims', tags: ['vehicle', 'wreck'], collider: 'box', palette: { paint: 'ink', hood: 'night', roof: 'night', dark: 'ink', lamp: 'night' }, parts: [{ group: pickupBody(), at: [0