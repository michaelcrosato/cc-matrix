[2]);\n  fore.lookAt(hand);\n  fore.scale.z = Math.hypot(_local.x - _joint[0], _local.y - _joint[1], _local.z - _joint[2]);\n  upper.lookAt(root.localToWorld(_world.set(_joint[0], _joint[1], _joint[2])));\n  upper.scale.z = Math.hypot(shoulder[0] - _joint[0], shoulder[1] - _joint[1], shoulder[2] - _joint[2]);\n}\"\"\"+s[b:]\ns=s.replace(\"import { THREE, buildModel, setLookLayer, spatialize } from '../../pixel-engine.js';\",\"import { THREE, buildModel, setLookLayer, spatialize, twoBoneIK } from '../../pixel-engine.js';\")\ns=s.replace(\"import { CABS } from '../art/viewmodels.js';\",\"import { CABS, CAB_ARM } from '../art/viewmodels.js';\")\ns=s.replace(\"this.cabArmL = part('ArmL'); this.cabArmR = part('ArmR');\",\"this.cabArmL = part('ArmL'); this.cabArmR = part('ArmR'); this.cabUpperL = part('UpperL'); this.cabUpperR = part('UpperR');\")\nx=\"      reach(cab.cabArmL, cab.cabGripL.getWorldPosition(_hand));\\n\"\nassert x in s\ns=s.replace(x,\"      reach(cab.cab.object, cab.cabUpperL, cab.cabArmL, CAB_ARM.shoulderL, CAB_ARM.poleL, cab.cabGripL.getWorldPosition(_hand));\\n\")\nx=\"      reach(cab.cabArmR, _hand);\\n\"\nassert x in s\ns=s.replace(x,\"      reach(cab.cab.object, cab.cabUpperR, cab.cabArmR, CAB_ARM.shoulderR, CAB_ARM.poleR, _hand);\\n\")\n# ---- a driver among the crew ----\nx=\"const s = g.actors.makeSoldier(ctx, { faction: v.faction, role: 'rifle', x: v.x + (i ? 2 : -2), z: v.z + 1.5, yaw: v.yaw, squad: sq });\"\nassert x in s\ns=s.replace(x,\"const s = g.actors.makeSoldier(ctx, { faction: v.faction, role: i ? 'rifle' : 'driver', x: v.x + (i ? 2 : -2), z: v.z + 1.5, yaw: v.yaw, squad: sq });\\n      if (!i) s.vehicle = v;\")\nopen('src/vehicles/driving.js','w').write(s)\n# ---- soldiers: driver stays by his truck, the shove, the limp ----\npatch('src/actors/soldier.js',[\n(\"\"\"    this.faction = faction; this.role = role;\"\"\",\"\"\"    this.vehicle = null; this.shoveT = 0;\n    this.faction = faction; this.role = role;\"\"\"),\n(\"\"\"    this.moveWanted = this.goal ? (this.role === 'mg' ? 3 : 4.6) : 0;\"\"\",\"\"\"    // The driver fights from beside his truck.\n    if (this.role === 'driver' && this.vehicle?.alive && Math.hypot(this.vehicle.x - this.x, this.vehicle.z - this.z) > 9) this.setGoal(this.vehicle.x + 2, this.vehicle.z + 2);\n    this.moveWanted = this.goal ? (this.role === 'mg' ? 3 : 4.6) : 0;\"\"\"),\n(\"\"\"    // Every other man drops to a knee when he has stopped to shoot.\"\"\",\"\"\"    // Within arm's reach he shoves you off with the rifle.\n    this.shoveT -= dt;\n    if (!g.round && tgt?.kind === 'player' && dist < 2.2 && this.sees && this.reactT <= 0 && this.shoveT <= 0) {\n      this.shoveT = 2.5; this.burstLeft = 0; this.burstPause = 0.8;\n      this.view?.anim.shot('Push');\n      g.sfx.at('grunt', this.x, this.z, { max: 30, volume: 0.8 });\n      g.body.hurt(6, 'melee', [this.x, this.z]);\n      g.ctx.engine.shake.add(0.25);\n    }\n    // Every other man drops to a knee when he has stopped to shoot.\"\"\"),\n(\"\"\"    this.view?.anim.set(this.moveWanted > 0 ? (this.id % 2 === 0 ? 'CrouchWalk' : 'Walk') : 'Idle', 'AimIdle');\"\"\",\"\"\"    const limping = this.hp < this.maxHp * 0.35;\n    this.view?.anim.set(this.moveWanted > 0 ? (limping ? 'Limp' : this.id % 2 === 0 ? 'CrouchWalk' : 'Walk') : 'Idle', 'AimIdle');\"\"\"),\n(\"\"\"      else if (this.moveWanted > 0) this.view.anim.set('Walk', 'Walk');\"\"\",\"\"\"      else if (this.moveWanted > 0) { const gait = this.hp < this.maxHp * 0.35 ? 'Limp' : 'Walk'; this.view.anim.set(gait, gait); }\"\"\"),\n])\ns=open('src/art/clips.js').read()\ns=s.replace(\"export const PEOPLE_CLIPS = [\\n\",\"\"\"// A planted, procedural gait for anyone badly hurt: short steps, a lean, the arm held in.\nconst limp = gaitClip({ ...HERO_RIG, spine: undefined }, { name: 'Limp', frames: 36, speed: 1.5, stance: 0.64, hip: -0.035, bob: 0.018, lift: 0.03, lean: 9, sway: 5, head: 6, arms: { swing: 9, elbow: 22 } });\nexport const PEOPLE_CLIPS = [\n  limp,\