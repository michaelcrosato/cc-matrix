{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkyqZxVzAfyK9u1aXmXK","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"I've finished reading everything except the engine-facts and architecture sections. Next I'll write a throwaway script to check the plan's verbatim lines, coordinates, counts and named behaviours, printing only what it can't find.\n\n","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16175,"cache_read_input_tokens":265539,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16175},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"a355622b-6731-4ae9-9806-6bb122ec8b4b","timestamp":"2026-11-06T03:41:09.812Z","request_id":"req_011CgkyqZcAeRnAhwHjdrfd1","narration_block_indexes":[0],"thinking_duration_ms":3,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkyqZxVzAfyK9u1aXmXK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013332UmzGoWSyeWgwXTiWFq","name":"Bash","input":{"command":"cat > tools/tmp-plancheck.mjs <<'EOF'\nimport { readFileSync, readdirSync } from 'node:fs';\nconst miss = (s, ...a) => console.log('MISS', s, ...a);\nconst files = readdirSync('src', { recursive: true }).map(String).filter((f) => f.endsWith('.js')).map((f) => 'src/' + f);\nconst code = Object.fromEntries(files.map((f) => [f, readFileSync(f, 'utf8')]));\nconst ALL = Object.values(code).join('\\n');\n// ---- writing: verbatim lines ----\nconst content = ['dialogue', 'notes', 'missions', 'sites', 'title'];\nconst strs = [];\nconst walk = (v) => { if (typeof v === 'string') strs.push(v); else if (Array.isArray(v)) v.forEach(walk); else if (v && typeof v === 'object') Object.values(v).forEach(walk); };\nfor (const c of content) { const m = await import(`../src/content/${c}.js`); walk(Object.values(m)); }\nconst norm = (s) => s.toUpperCase().replace(/[^A-Z0-9]/g, '');\nconst blob = norm(strs.join(' '));\nconst blobCode = norm(ALL);\nconst verbatim = [\"Forty miles of track and not one station that remembers its name.\",\"They paint the signs over. Whoever won last.\",\"You have the look of a man who read about this place. Reading is a good way to visit.\",\"Up there they will ask you which side. Say yes.\",\"Three tablets. The fourth you pay for. I do not mean in stones.\",\"I do not need you to be good. I need you to be on time.\",\"Sixty-one beds. Forty blankets. You are the math.\",\"We do not burn villages. We conclude them.\",\"The water question has been a great sorrow to this office.\",\"Your invoice will be honoured, regrettably.\",\"You said less people. Fewer. Fewer people. It will matter by the end of the month.\",\"Burn the field. A hungry man learns to read the wind.\",\"Everything on this rack has been returned at least once.\",\"It fires. If you want it to fire twice, that is a different price.\",\"I flew for both of them. Neither paid. Get in.\",\"You owe me a truck. You owe me several trucks.\",\"Two fingers I left in this country. I came back to see what they are doing.\",\"A man asked me to mine his own road, so he would know where it was safe. He was right for a week.\",\"Hold still. No, you can't feel that. No, that's normal. Hold still.\",\"Not today. Today you owe me money.\",\"Don't let it be the fire. Please. Not the fire.\",\"There! In the grass!\",\"Who lit that?\",\"It's stuck! It's stuck again!\",\"Leave him, he's already gone.\",\"A map is a promise made by someone who has already left.\",\"I drew the river where the Company wanted it. The river was slow to comply, but it came round.\",\"Both armies buy from me. The Concord pays on time. The Harvest pays in grain and tears. I have eaten better on the tears.\",\"You will have noticed that you follow roads. I drew those too.\",\"Grass is the only honest border. It goes where the wind tells it, and it keeps a record.\",\"By now you have burned what I marked. Look at it from the ridge. Tell me that is not a line.\",\"You are late. I said you would be. Sit down, it won't take long, neither of us has long.\",\"I drew the lines that started this. I would like to draw one more.\",\"You have been drawing for me. Look at it.\",\"Burned grass cannot burn twice. It is the only safe road in the country, and you built it for wages.\",\"You reached the border with a case of stones and a map nobody else will ever use. The guard asks your trade. You tell him: surveyor.\",\"They crossed at first light, walking on ash. Nobody has asked who lit it. The fever is not finished with you, and you are out of tablets. It is a good view.\",\"MIND THE FEVER. YOU ARE LATE ALREADY. E.H.\",\"YOU DIED IN THE SORREL. THE PAPERWORK WILL TAKE LONGER.\",\"The green comes back faster than the people.\",\"One contractor, paid in advance, to walk the Kettle.\",\"You have drawn well. Come and see.\",\"He says the grass won't burn twice.\"];\nlet vOk = 0;\nfor (const v of verbatim) { const n = norm(v); if (blob.includes(n) || blobCode.includes(n)) vOk++; else { const parts = v.split(/(?<=[.!?])\\s+/).map(norm).filter((p) => p.length > 6); const gone = parts.filter((p) => !blobCode.includes(p)); if (gone.length) miss('verbatim', v.slice(0, 70), '| missing part:', gone[0].slice(0, 40)); else vOk++; } }\nconsole.log('verbatim ok', vOk, 'of', verbatim.length);\nconst { LINES } = await import('../src/content/dialogue.js');\nconst lineTexts = Object.values(LINES).flat(Infinity).filter((s) => typeof s === 'string');\nconst long = lineTexts.filter((s) => s.length > 60 * 2 + 1); console.log('lines', lineTexts.length, 'over two 60-char lines:', long.length, long[0]?.slice(0, 80) ?? '');\n// ---- data: places, counts ----\nconst { SITES, POSTS, TRIGS, CASES, HALTS } = await import('../src/content/sites.js');\nconst want = { 'mile-forty': [0, 40], 'pump-shed': [-120, 150], 'ranger-post': [40, -170], 'water-tower': [470, -180], 'fort-clement': [-430, -180], 'long-field': [-260, -300], granary: [400, 280], 'east-siding': [430, -60], 'three-wells': [-260, 240], 'pump-station': [-330, 395], 'salt-pan': [200, 470], 'the-cut': [150, -300], observatory: [-130, -520], 'the-pass': [-590, -430] };\nconst keys = Object.keys(SITES);\nfor (const [k, at] of Object.entries(want)) { const key = keys.find((x) => x === k || x === k.replace('the-', '')); if (!key) { miss('site', k, 'have', keys.join(',')); continue; } const a = SITES[key].at; if (Math.hypot(a[0] - at[0], a[1] - at[1]) > 40) console.log('NOTE site moved', k, a, 'plan', at); }\nconst wp = { p1: [90, -80], p2: [-200, 30], p3: [170, 90], p4: [-320, -90], p5: [280, -210], p6: [300, 390] };\nfor (const [k, at] of Object.entries(wp)) { const a = POSTS[k]?.at; if (!a) miss('post', k); else if (Math.hypot(a[0] - at[0], a[1] - at[1]) > 30) console.log('NOTE post moved', k, a, 'plan', at); }\nconsole.log('trigs', TRIGS.length, 'cases', CASES.length, 'halts', HALTS.length, Array.isArray(HALTS) ? HALTS.map((h) => h.name ?? h.id).join('/') : '');\nconst { MISSIONS, MISSION_ORDER } = await import('../src/content/missions.js');\nconsole.log('missions', MISSION_ORDER.join(' '), '| side', Object.keys(MISSIONS).filter((k) => !MISSION_ORDER.includes(k)).join(' '));\nconst { WEAPONS } = await import('../src/content/weapons.js');\nconsole.log('weapons', Object.keys(WEAPONS).join(' '));\n// ---- named behaviours ----\nconst need = {\n  '5 reeds': /'reeds'/, '5 rock on ridge': /'rock'/, '5 thorn bush from library bush': /use: 'bush'/, '5 grass chunk 48': /48/, '5 vulture Boids': /Boids/,\n  '6 ember jump': /ws > 6/, '6 half density regrow': /half|0\\.5/, '6 vehicles lose 6 HP in fire': /\\* 6\\b|6 \\* dt|hurt\\(6/, '6 clothGrid on posts': /clothGrid/, '6 SoftMesh': /SoftMesh/, '6 sun glow': /glowMaterial/, '6 moon': /moon/i, '6 stars': /night-star|stars/, '6 Precipitation': /Precipitation/, '6 dust weather': /'dust'/, '6 lightning flash': /screen\\.flash/, '6 shockwave': /shockwave/, '6 physics.explode': /physics\\.explode/, '6 swayObject': /swayObject/, '6 WindUniforms': /WindUniforms/,\n  '7 caps lock walk': /CapsLock/, '7 aim assist': /aimAssist/, '7 tilt 1.6': /1\\.6\\)/, '7 fall damage': /fall|land/, '7 wade': /wad/i,\n  '8 hitstop': /hitstop/, '8 shake': /shake\\.add/, '8 Decals': /Decals/, '8 Trail': /Trail/, '8 impact burst': /'impact'/, '8 hit marker': /hit-marker|hitMarker/, '8 rumble': /dual-rumble/, '8 upgrade cleaning kit': /cleaning/i, '8 weed leak': /leak/i, '8 mounted MG overheat': /heat/i,\n  '9 regen to segment': /segment/i, '9 thigh jab syrette': /Syrette/, '9 no tablets stones lost': /0\\.2|20%/, '10 sniper role': /'sniper'/, '10 rocket role': /'rocket'/, '10 driver role': /'driver'/, '10 ? ! over head': /'\\?'|'!'/, '10 suspicion': /suspicion/, '10 flank': /flank/i, '10 dodge': /dodge/i, '10 flee crosswind': /crosswind|flee/i, '10 crews dismount': /dismount/i, '10 PD steering': /steer/,\n  '11 chase': /chase/, '11 wheelPose': /wheelPose/, '11 overnight repair': /overnight|repair\\(100|parked/i, '11 fixed truck coughs': /cough/, '11 M1 scripted stall': /stall/,\n  '12 Ines perk far': /rescueRange|perk|farther/i, '12 Dov free charges': /charges?.*(free|2)|freeCharges/i, '12 Mags +1 syrette': /syrette/i, '12 mags rescue 60': /\\b60\\b/, '12 wound 15%': /buddyWoundChance/, '12 floating cross': /cross/i, '12 name wall': /name-wall/, '12 gun leaning': /ground-gun/, '12 split offer': /split/i,\n  '13 upgrades': /syrette.?pouch|pouch/i, '13 ammo belt': /belt/i, '13 vehicle kit': /vehicle.?kit|hasKit/i, '13 clean empire note': /empire/, '13 ledger hectares': /0\\.0025/, '13 input.send save': /input\\.send/,\n  '14 notice board': /notice-board/, '14 not yet': /NOT YET/, '14 smoke column': /smokeColumn|column of smoke|bigSmoke|longSmoke/i, '14 Pell': /pell/, '14 Tibor stock lockers': /locker/i, '14 column on map': /column/,\n  '16 preventKeys': /preventKeys/, '16 tr analog': /tr: ?\\[|\\.tr\\b/, '16 pad disconnect pause': /gamepaddisconnect|padLost|disconnect/i, '16 hand torch': /lights\\.request/, '16 pixfont': /pixfont/, '16 reduce flashes': /reduceFlash/i, '16 fever reduced': /feverReduced|feverEffects|reduceFever/i, '16 subtitle size': /subtitleSize|subSize/i, '16 pixel size': /pixelSize|Chunky/i, '16 quality': /quality/i, '16 FOV setting': /fov/i, '16 fullscreen': /ullscreen/, '16 invert Y': /invert/i, '16 epigraphs': /EPIGRAPH/i, '16 gate text': /Controller or keyboard required/,\n  '19 awards': /Last Friend/i, '19 Paid in Full': /Paid in Full/i, '19 Arsonist': /Arsonist/i, '19 more': /answer\\('more'\\)|'more'/, '19 Options ignored with Create': /create|Create/, '19 Host on this computer': /HOST ON THIS COMPUTER/i, '19 Join': /JOIN ON THIS COMPUTER/i, '19 online line': /AI HUB/i, '19 game-link': /game-link-v1/, '19 AIHub.fail': /AIHub\\.fail|\\.fail\\(/,\n  '21 Timeline': /Timeline/, '21 Ragdoll': /Ragdoll/, '21 gaitClip': /gaitClip/, '21 SpringChain': /SpringChain/, '21 Squash': /Squash/, '21 twoBoneIK': /twoBoneIK/, '21 Push': /'Push'/, '21 Climb': /'Climb'/, '22 12s dwell': /\\b12\\b/, '22 voices 12 syllables': /syll/i, '23 withUrlOptions': /withUrlOptions/, '23 debugKeys': /debugKeys/, '20 mergeStaticMeshes': /mergeStaticMeshes/, '20 grass-flame': /grass-flame/, '20 library rust texture': /'rust'|metal-plates/,\n};\nfor (const [k, re] of Object.entries(need)) if (!re.test(ALL)) miss(k);\n// ---- key bindings ----\nconst act = readFileSync('src/core/actions.js', 'utf8');\nfor (const k of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyR', 'Space', 'KeyC', 'ShiftLeft', 'KeyF', 'Digit1', 'Digit4', 'KeyG', 'KeyQ', 'KeyM', 'Tab', 'KeyH', 'KeyT', 'KeyV', 'Escape', 'KeyJ', 'CapsLock']) if (!act.includes(k) && !ALL.includes(k)) miss('binding', k);\n// ---- packaging order ----\nconst html = readFileSync('../FarCryUncle-FarCry2-claude-opus-5-5-xhigh-20261105-162027.html', 'utf8');\nconst head = html.slice(0, html.indexOf('</head>'));\nconst order = ['<!doctype html>', '<meta charset', '<script>', 'name=\"hub:session\"', 'name=\"viewport\"', '<title>'];\nlet last = -1; for (const o of order) { const i = head.toLowerCase().indexOf(o.toLowerCase()); if (i < last || i < 0) miss('head order', o); last = i; }\nfor (const m of ['hub:session-players', 'hub:session-mode', 'hub:session-minutes', 'hub:webgpu', 'hub:session-goal', 'hub:session-howto']) if (!head.includes(m)) miss('meta', m);\nconsole.log('licence comment at the end', /<!--[\\s\\S]*(MIT|Apache)[\\s\\S]*-->\\s*$/.test(html.slice(-40000)));\nprocess.exit(0);\nEOF\ntimeout 100 node tools/tmp-plancheck.mjs 2>&1 | grep -v '^`\\|WebGPURenderer\\|^file:\\|^ *\\^' | grep -v 'pixel-engine.js:' | cut -c1-200","description":"Check verbatim lines, data, behaviours, bindings and head order","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16175,"cache_read_input_tokens":265539,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16175},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"29e45122-1e5a-4756-a656-b068c4cae28d","timestamp":"2026-11-06T03:41:50.726Z","request_id":"req_011CgkyqZcAeRnAhwHjdrfd1","wire_tool_inputs":{"toolu_013332UmzGoWSyeWgwXTiWFq":{"command":"cat > tools/tmp-plancheck.mjs <<'EOF'\nimport { readFileSync, readdirSync } from 'node:fs';\nconst miss = (s, ...a) => console.log('MISS', s, ...a);\nconst files = readdirSync('src', { recursive: true }).map(String).filter((f) => f.endsWith('.js')).map((f) => 'src/' + f);\nconst code = Object.fromEntries(files.map((f) => [f, readFileSync(f, 'utf8')]));\nconst ALL = Object.values(code).join('\\n');\n// ---- writing: verbatim lines ----\nconst content = ['dialogue', 'notes', 'missions', 'sites', 'title'];\nconst strs = [];\nconst walk = (v) => { if (typeof v === 'string') strs.push(v); else if (Array.isArray(v)) v.forEach(walk); else if (v && typeof v === 'object') Object.values(v).forEach(walk); };\nfor (const c of content) { const m = await import(`../src/content/${c}.js`); walk(Object.values(m)); }\nconst norm = (s) => s.toUpperCase().replace(/[^A-Z0-9]/g, '');\nconst blob = norm(strs.join(' '));\nconst blobCode = norm(ALL);\nconst verbatim = [\"Forty miles of track and not one station that remembers its name.\",\"They paint the signs over. Whoever won last.\",\"You have the look of a man who read about this place. Reading is a good way to visit.\",\"Up there they will ask you which side. Say yes.\",\"Three tablets. The fourth you pay for. I do not mean in stones.\",\"I do not need you to be good. I need you to be on time.\",\"Sixty-one beds. Forty blankets. You are the math.\",\"We do not burn villages. We conclude them.\",\"The water question has been a great sorrow to this office.\",\"Your invoice will be honoured, regrettably.\",\"You said less people. Fewer. Fewer people. It will matter by the end of the month.\",\"Burn the field. A hungry man learns to read the wind.\",\"Everything on this rack has been returned at least once.\",\"It fires. If you want it to fire twice, that is a different price.\",\"I flew for both of them. Neither paid. Get in.\",\"You owe me a truck. You owe me several trucks.\",\"Two fingers I left in this country. I came back to see what they are doing.\",\"A man asked me to mine his own road, so he would know where it was safe. He was right for a week.\",\"Hold still. No, you can't feel that. No, that's normal. Hold still.\",\"Not today. Today you owe me money.\",\"Don't let it be the fire. Please. Not the fire.\",\"There! In the grass!\",\"Who lit that?\",\"It's stuck! It's stuck again!\",\"Leave him, he's already gone.\",\"A map is a promise made by someone who has already left.\",\"I drew the river where the Company wanted it. The river was slow to comply, but it came round.\",\"Both armies buy from me. The Concord pays on time. The Harvest pays in grain and tears. I have eaten better on the tears.\",\"You will have noticed that you follow roads. I drew those too.\",\"Grass is the only honest border. It goes where the wind tells it, and it keeps a record.\",\"By now you have burned what I marked. Look at it from the ridge. Tell me that is not a line.\",\"You are late. I said you would be. Sit down, it won't take long, neither of us has long.\",\"I drew the lines that started this. I would like to draw one more.\",\"You have been drawing for me. Look at it.\",\"Burned grass cannot burn twice. It is the only safe road in the country, and you built it for wages.\",\"You reached the border with a case of stones and a map nobody else will ever use. The guard asks your trade. You tell him: surveyor.\",\"They crossed at first light, walking on ash. Nobody has asked who lit it. The fever is not finished with you, and you are out of tablets. It is a good view.\",\"MIND THE FEVER. YOU ARE LATE ALREADY. E.H.\",\"YOU DIED IN THE SORREL. THE PAPERWORK WILL TAKE LONGER.\",\"The green comes back faster than the people.\",\"One contractor, paid in advance, to walk the Kettle.\",\"You have drawn well. Come and see.\",\"He says the grass won't burn twice.\"];\nlet vOk = 0;\nfor (const v of verbatim) { const n = norm(v); if (blob.includes(n) || blobCode.includes(n)) vOk++; else { const parts = v.split(/(?<=[.!?])\\s+/).map(norm).filter((p) => p.length > 6); const gone = parts.filter((p) => !blobCode.includes(p)); if (gone.length) miss('verbatim', v.slice(0, 70), '| missing part:', gone[0].slice(0, 40)); else vOk++; } }\nconsole.log('verbatim ok', vOk, 'of', verbatim.length);\nconst { LINES } = await import('../src/content/dialogue.js');\nconst lineTexts = Object.values(LINES).flat(Infinity).filter((s) => typeof s === 'string');\nconst long = lineTexts.filter((s) => s.length > 60 * 2 + 1); console.log('lines', lineTexts.length, 'over two 60-char lines:', long.length, long[0]?.slice(0, 80) ?? '');\n// ---- data: places, counts ----\nconst { SITES, POSTS, TRIGS, CASES, HALTS } = await import('../src/content/sites.js');\nconst want = { 'mile-forty': [0, 40], 'pump-shed': [-120, 150], 'ranger-post': [40, -170], 'water-tower': [470, -180], 'fort-clement': [-430, -180], 'long-field': [-260, -300], granary: [400, 280], 'east-siding': [430, -60], 'three-wells': [-260, 240], 'pump-station': [-330, 395], 'salt-pan': [200, 470], 'the-cut': [150, -300], observatory: [-130, -520], 'the-pass': [-590, -430] };\nconst keys = Object.keys(SITES);\nfor (const [k, at] of Object.entries(want)) { const key = keys.find((x) => x === k || x === k.replace('the-', '')); if (!key) { miss('site', k, 'have', keys.join(',')); continue; } const a = SITES[key].at; if (Math.hypot(a[0] - at[0], a[1] - at[1]) > 40) console.log('NOTE site moved', k, a, 'plan', at); }\nconst wp = { p1: [90, -80], p2: [-200, 30], p3: [170, 90], p4: [-320, -90], p5: [280, -210], p6: [300, 390] };\nfor (const [k, at] of Object.entries(wp)) { const a = POSTS[k]?.at; if (!a) miss('post', k); else if (Math.hypot(a[0] - at[0], a[1] - at[1]) > 30) console.log('NOTE post moved', k, a, 'plan', at); }\nconsole.log('trigs', TRIGS.length, 'cases', CASES.length, 'halts', HALTS.length, Array.isArray(HALTS) ? HALTS.map((h) => h.name ?? h.id).join('/') : '');\nconst { MISSIONS, MISSION_ORDER } = await import('../src/content/missions.js');\nconsole.log('missions', MISSION_ORDER.join(' '), '| side', Object.keys(MISSIONS).filter((k) => !MISSION_ORDER.includes(k)).join(' '));\nconst { WEAPONS } = await import('../src/content/weapons.js');\nconsole.log('weapons', Object.keys(WEAPONS).join(' '));\n// ---- named behaviours ----\nconst need = {\n  '5 reeds': /'reeds'/, '5 rock on ridge': /'rock'/, '5 thorn bush from library bush': /use: 'bush'/, '5 grass chunk 48': /48/, '5 vulture Boids': /Boids/,\n  '6 ember jump': /ws > 6/, '6 half density regrow': /half|0\\.5/, '6 vehicles lose 6 HP in fire': /\\* 6\\b|6 \\* dt|hurt\\(6/, '6 clothGrid on posts': /clothGrid/, '6 SoftMesh': /SoftMesh/, '6 sun glow': /glowMaterial/, '6 moon': /moon/i, '6 stars': /night-star|stars/, '6 Precipitation': /Precipitation/, '6 dust weather': /'dust'/, '6 lightning flash': /screen\\.flash/, '6 shockwave': /shockwave/, '6 physics.explode': /physics\\.explode/, '6 swayObject': /swayObject/, '6 WindUniforms': /WindUniforms/,\n  '7 caps lock walk': /CapsLock/, '7 aim assist': /aimAssist/, '7 tilt 1.6': /1\\.6\\)/, '7 fall damage': /fall|land/, '7 wade': /wad/i,\n  '8 hitstop': /hitstop/, '8 shake': /shake\\.add/, '8 Decals': /Decals/, '8 Trail': /Trail/, '8 impact burst': /'impact'/, '8 hit marker': /hit-marker|hitMarker/, '8 rumble': /dual-rumble/, '8 upgrade cleaning kit': /cleaning/i, '8 weed leak': /leak/i, '8 mounted MG overheat': /heat/i,\n  '9 regen to segment': /segment/i, '9 thigh jab syrette': /Syrette/, '9 no tablets stones lost': /0\\.2|20%/, '10 sniper role': /'sniper'/, '10 rocket role': /'rocket'/, '10 driver role': /'driver'/, '10 ? ! over head': /'\\?'|'!'/, '10 suspicion': /suspicion/, '10 flank': /flank/i, '10 dodge': /dodge/i, '10 flee crosswind': /crosswind|flee/i, '10 crews dismount': /dismount/i, '10 PD steering': /steer/,\n  '11 chase': /chase/, '11 wheelPose': /wheelPose/, '11 overnight repair': /overnight|repair\\(100|parked/i, '11 fixed truck coughs': /cough/, '11 M1 scripted stall': /stall/,\n  '12 Ines perk far': /rescueRange|perk|farther/i, '12 Dov free charges': /charges?.*(free|2)|freeCharges/i, '12 Mags +1 syrette': /syrette/i, '12 mags rescue 60': /\\b60\\b/, '12 wound 15%': /buddyWoundChance/, '12 floating cross': /cross/i, '12 name wall': /name-wall/, '12 gun leaning': /ground-gun/, '12 split offer': /split/i,\n  '13 upgrades': /syrette.?pouch|pouch/i, '13 ammo belt': /belt/i, '13 vehicle kit': /vehicle.?kit|hasKit/i, '13 clean empire note': /empire/, '13 ledger hectares': /0\\.0025/, '13 input.send save': /input\\.send/,\n  '14 notice board': /notice-board/, '14 not yet': /NOT YET/, '14 smoke column': /smokeColumn|column of smoke|bigSmoke|longSmoke/i, '14 Pell': /pell/, '14 Tibor stock lockers': /locker/i, '14 column on map': /column/,\n  '16 preventKeys': /preventKeys/, '16 tr analog': /tr: ?\\[|\\.tr\\b/, '16 pad disconnect pause': /gamepaddisconnect|padLost|disconnect/i, '16 hand torch': /lights\\.request/, '16 pixfont': /pixfont/, '16 reduce flashes': /reduceFlash/i, '16 fever reduced': /feverReduced|feverEffects|reduceFever/i, '16 subtitle size': /subtitleSize|subSize/i, '16 pixel size': /pixelSize|Chunky/i, '16 quality': /quality/i, '16 FOV setting': /fov/i, '16 fullscreen': /ullscreen/, '16 invert Y': /invert/i, '16 epigraphs': /EPIGRAPH/i, '16 gate text': /Controller or keyboard required/,\n  '19 awards': /Last Friend/i, '19 Paid in Full': /Paid in Full/i, '19 Arsonist': /Arsonist/i, '19 more': /answer\\('more'\\)|'more'/, '19 Options ignored with Create': /create|Create/, '19 Host on this computer': /HOST ON THIS COMPUTER/i, '19 Join': /JOIN ON THIS COMPUTER/i, '19 online line': /AI HUB/i, '19 game-link': /game-link-v1/, '19 AIHub.fail': /AIHub\\.fail|\\.fail\\(/,\n  '21 Timeline': /Timeline/, '21 Ragdoll': /Ragdoll/, '21 gaitClip': /gaitClip/, '21 SpringChain': /SpringChain/, '21 Squash': /Squash/, '21 twoBoneIK': /twoBoneIK/, '21 Push': /'Push'/, '21 Climb': /'Climb'/, '22 12s dwell': /\\b12\\b/, '22 voices 12 syllables': /syll/i, '23 withUrlOptions': /withUrlOptions/, '23 debugKeys': /debugKeys/, '20 mergeStaticMeshes': /mergeStaticMeshes/, '20 grass-flame': /grass-flame/, '20 library rust texture': /'rust'|metal-plates/,\n};\nfor (const [k, re] of Object.entries(need)) if (!re.test(ALL)) miss(k);\n// ---- key bindings ----\nconst act = readFileSync('src/core/actions.js', 'utf8');\nfor (const k of ['KeyW', 'KeyA', 'KeyS', 'KeyD', 'KeyE', 'KeyR', 'Space', 'KeyC', 'ShiftLeft', 'KeyF', 'Digit1', 'Digit4', 'KeyG', 'KeyQ', 'KeyM', 'Tab', 'KeyH', 'KeyT', 'KeyV', 'Escape', 'KeyJ', 'CapsLock']) if (!act.includes(k) && !ALL.includes(k)) miss('binding', k);\n// ---- packaging order ----\nconst html = readFileSync('../FarCryUncle-FarCry2-claude-opus-5-5-xhigh-20261105-162027.html', 'utf8');\nconst head = html.slice(0, html.indexOf('</head>'));\nconst order = ['<!doctype html>', '<meta charset', '<script>', 'name=\"hub:session\"', 'name=\"viewport\"', '<title>'];\nlet last = -1; for (const o of order) { const i = head.toLowerCase().indexOf(o.toLowerCase()); if (i < last || i < 0) miss('head order', o); last = i; }\nfor (const m of ['hub:session-players', 'hub:session-mode', 'hub:session-minutes', 'hub:webgpu', 'hub:session-goal', 'hub:session-howto']) if (!head.includes(m)) miss('meta', m);\nconsole.log('licence comment at the end', /<!--[\\s\\S]*(MIT|Apache)[\\s\\S]*-->\\s*$/.test(html.slice(-40000)));\nprocess.exit(0);\nEOF\ntimeout 100 node tools/tmp-plancheck.mjs 2>&1 | grep -v '^`\\|WebGPURenderer\\|^file:\\|^ *\\^' | grep -v 'pixel-engine.js:' | cut -c1-200","description":"Check verbatim lines, data, behaviours, bindings and head order","timeout":120000}}}
