pixel-engine.js';\nimport { OWN_MODELS, MODELS } from '../src/art/models.js';\nlet bad = 0, warn = 0;\nfor (const def of OWN_MODELS) {\n  const r = checkModel(def, { catalog: MODELS });\n  if (r.problems.length) { bad++; console.log('PROBLEM', def.id, r.problems.map((p) => p.message || p).join(' | ')); }\n  if (process.argv.includes('--warn') && r.warnings.length) { warn++; console.log('warn', def.id, r.warnings.map((p) => p.message || p).join(' | ').slice(0, 300)); }\n}\nconsole.log(OWN_MODELS.length, 'models,', bad, 'with problems,', warn, 'with warnings');\nEOF\nnode tools/checkmodels.mjs 2>&1 | tail -20","description":"Write all world model definitions and check them","timeout":120000}}}
