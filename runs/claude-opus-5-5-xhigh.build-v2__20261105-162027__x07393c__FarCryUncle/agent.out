{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkeoXEGz8Dd7Ax8QyePK","type":"message","role":"assistant","content":[{"type":"text","text":"Fire head speed at 5 m/s wind is 4.3 m/s, with a slow backing front, so it falls inside the plan's 2–5 m/s. Next is the art: all the models as data (people, vehicles, buildings, nature)."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1295,"cache_read_input_tokens":222079,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1295},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"44e78f3d-0240-4251-917c-5124e4590f89","timestamp":"2026-11-05T23:32:01.353Z","request_id":"req_011CgkeoX197mVWMF6DNDUt5"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkeoXEGz8Dd7Ax8QyePK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014itrwRTVTqLPvJNX7sb56D","name":"Bash","input":{"command":"set -e\ncat > src/art/models.js <<'EOF'\n// All world models as plain data. `node check.mjs --sheets src/art/models.js` draws them. No code runs here at import but model().\nimport { model, MODEL_LIBRARY, ModelCatalog, around, rowOf, gridOf } from '../../pixel-engine.js';\n\n// ---- People, on the hero rig's joint names (PLAN section 3). Faces +Z. ----\nconst limb = (name, len, w, c, kids = [], at = [0, 0, 0]) => ({ group: [{ box: [w, len, w], at: [0, -len / 2, 0], c }, ...kids], at, pivot: true, name });\nconst foot = (name) => ({ group: [{ box: [0.12, 0.1, 0.26], at: [0, -0.05, 0.05], c: 'boot' }], at: [0, -0.22, 0], pivot: true, name });\nfunction person({ id, about, palette, head = [], torso = [], hips = [], legC = 'dark', tags = [] }) {\n  return model({\n    id, about, tags: ['actor', ...tags], floats: true, collider: 'none',\n    palette: { cloth: 'slate', dark: 'night', skin: 'plum', boot: 'ink', hat: 'navy', strap: 'white', ...palette },\n    parts: [{ group: [\n      { box: [0.34, 0.2, 0.2], at: [0, 0.06, 0], c: 'dark' },\n      ...hips,\n      { group: [\n        { box: [0.38, 0.5, 0.22], at: [0, 0.25, 0], c: 'cloth' },\n        ...torso,\n        { group: [{ box: [0.2, 0.22, 0.2], at: [0, 0.11, 0], c: 'skin' }, ...head], at: [0, 0.52, 0], pivot: true, name: 'Head' },\n        limb('ArmR', 0.25, 0.11, 'cloth', [limb('ForearmR', 0.16, 0.09, 'cloth', [limb('HandR', 0.08, 0.08, 'skin', [], [0, -0.16, 0])], [0, -0.25, 0])], [-0.25, 0.47, 0]),\n        limb('ArmL', 0.25, 0.11, 'cloth', [limb('ForearmL', 0.16, 0.09, 'cloth', [limb('HandL', 0.08, 0.08, 'skin', [], [0, -0.16, 0])], [0, -0.25, 0])], [0.25, 0.47, 0]),\n      ], at: [0, 0.04, 0], pivot: true, name: 'Torso' },\n      limb('LegR', 0.3, 0.13, legC, [limb('ShinR', 0.22, 0.11, legC, [foot('FootR')], [0, -0.3, 0])], [-0.14, 0, 0]),\n      limb('LegL', 0.3, 0.13, legC, [limb('ShinL', 0.22, 0.11, legC, [foot('FootL')], [0, -0.3, 0])], [0.14, 0, 0]),\n    ], at: [0, 0.62, 0], pivot: true, name: 'Pelvis' }],\n  });\n}\nconst STRAP = { box: [0.06, 0.56, 0.24], at: [0.1, 0.25, 0], rot: [0, 0, 28], c: 'strap' };\nconst HAT = {\n  beret: [{ box: [0.24, 0.07, 0.24], at: [0.01, 0.25, 0], rot: [0, 0, -8], c: 'hat' }],\n  cap: [{ box: [0.23, 0.08, 0.23], at: [0, 0.25, 0], c: 'hat' }, { box: [0.18, 0.03, 0.1], at: [0, 0.22, 0.14], c: 'hat' }],\n  cloth: [{ box: [0.24, 0.1, 0.24], at: [0, 0.2, 0], c: 'hat' }, { box: [0.12, 0.2, 0.05], at: [0, 0.08, -0.12], c: 'hat' }],\n  helmet: [{ ball: [0.27, 0.14, 0.27], at: [0, 0.22, 0], half: true, c: 'hat' }],\n};\nexport const soldierA = person({ id: 'soldier-a', about: 'Soldier in a beret, armband strap across the chest', tags: ['soldier'], head: HAT.beret, torso: [STRAP] });\nexport const soldierB = person({ id: 'soldier-b', about: 'Soldier in a soft cap', tags: ['soldier'], head: HAT.cap, torso: [STRAP] });\nexport const soldierC = person({ id: 'soldier-c', about: 'Soldier in a headcloth or helmet', tags: ['soldier'], head: HAT.cloth, torso: [{ box: [0.4, 0.18, 0.26], at: [0, 0.22, 0], c: 'strap' }] });\nexport const soldierD = person({ id: 'soldier-d', about: 'Soldier in a steel helmet', tags: ['soldier'], head: HAT.helmet, torso: [{ box: [0.4, 0.18, 0.26], at: [0, 0.22, 0], c: 'strap' }] });\nexport const ines = person({ id: 'ines', about: 'Ines Carvalho: flight cap, sunglasses, sand jacket', tags: ['buddy'], palette: { cloth: 'sand', dark: 'night', skin: 'orange', hat: 'plum', strap: 'ink' }, head: [...HAT.cap, { box: [0.2, 0.05, 0.03], at: [0, 0.14, 0.1], c: 'strap' }], torso: [{ box: [0.4, 0.14, 0.24], at: [0, 0.44, 0], c: 'strap' }] });\nexport const dov = person({ id: 'dov', about: 'Dov Halpern: bald, bandoliers, a bad left hand', tags: ['buddy'], palette: { cloth: 'mist', dark: 'slate', skin: 'sand', hat: 'sand', strap: 'plum' }, head: [{ box: [0.21, 0.04, 0.21], at: [0, 0.23, 0], c: 'hat' }, { box: [0.14, 0.06, 0.04], at: [0, 0.03, 0.1], c: 'strap' }], torso: [STRAP, { box: [0.06, 0.56, 0.24], at: [-0.1, 0.25, 0], rot: [0, 0, -28], c: 'strap' }] });\nexport const mags = person({ id: 'mags', about: 'Mags Oyelaran: braids, olive vest, satchel with a green cross', tags: ['buddy'], palette: { cloth: 'green', dark: 'night', skin: 'plum', hat: 'ink', strap: 'white' }, head: [{ box: [0.22, 0.08, 0.22], at: [0, 0.22, 0], c: 'hat' }, { box: [0.06, 0.24, 0.06], at: [-0.1, 0.08, -0.08], c: 'hat' }, { box: [0.06, 0.24, 0.06], at: [0.1, 0.08, -0.08], c: 'hat' }], torso: [{ box: [0.24, 0.2, 0.08], at: [0, 0.1, 0.14], c: 'strap' }, { box: [0.14, 0.05, 0.02], at: [0, 0.1, 0.19], c: 'cross' }, { box: [0.05, 0.14, 0.02], at: [0, 0.1, 0.19], c: 'cross' }] });\nmags.palette.cross = 'green';\nexport const odile = person({ id: 'odile', about: 'Sister Odile: white veil, grey habit, a cigarette', tags: ['npc'], palette: { cloth: 'mist', dark: 'slate', skin: 'sand', hat: 'white', strap: 'orange' }, head: [{ box: [0.26, 0.12, 0.26], at: [0, 0.22, -0.01], c: 'hat' }, { box: [0.26, 0.28, 0.06], at: [0, 0.08, -0.13], c: 'hat' }, { box: [0.03, 0.03, 0.09], at: [0.05, 0.05, 0.13], c: 'strap' }], hips: [{ box: [0.4, 0.42, 0.26], at: [0, -0.18, 0], c: 'cloth' }] });\nexport const tibor = person({ id: 'tibor', about: 'Tibor: heavy, leather apron, sells returned guns', tags: ['npc'], palette: { cloth: 'plum', dark: 'night', skin: 'orange', hat: 'night', strap: 'red' }, head: [{ box: [0.18, 0.05, 0.05], at: [0, 0.02, 0.1], c: 'hat' }], torso: [{ box: [0.34, 0.5, 0.05], at: [0, 0.22, 0.13], c: 'strap' }] });\nexport const vance = person({ id: 'vance', about: 'Colonel Vance: peaked cap, medals, soft-spoken', tags: ['npc'], palette: { cloth: 'slate', dark: 'night', skin: 'sand', hat: 'navy', strap: 'sand' }, head: [...HAT.cap, { box: [0.26, 0.03, 0.26], at: [0, 0.22, 0], c: 'hat' }], torso: [{ box: [0.12, 0.06, 0.02], at: [0.08, 0.38, 0.12], c: 'strap' }, { box: [0.08, 0.05, 0.02], at: [0.08, 0.3, 0.12], c: 'medal' }] });\nvance.palette.medal = 'red';\nexport const ansa = person({ id: 'ansa', about: 'Mother Ansa: headscarf, spectacles, a teacher', tags: ['npc'], palette: { cloth: 'orange', dark: 'plum', skin: 'plum', hat: 'red', strap: 'white' }, head: [{ box: [0.24, 0.12, 0.24], at: [0, 0.2, -0.01], c: 'hat' }, { box: [0.2, 0.04, 0.02], at: [0, 0.13, 0.11], c: 'strap' }], hips: [{ box: [0.38, 0.4, 0.24], at: [0, -0.18, 0], c: 'cloth' }] });\nexport const harrow = person({ id: 'harrow', about: 'Emil Harrow, the Surveyor: blanket, wide hat, dying', tags: ['npc'], palette: { cloth: 'red', dark: 'night', skin: 'sand', hat: 'plum', strap: 'mist' }, head: [{ cyl: [0.42, 0.03, 0.42], at: [0, 0.22, 0], c: 'hat', seg: 8 }, { cyl: [0.2, 0.09, 0.2], at: [0, 0.27, 0], c: 'hat', seg: 8 }], torso: [{ box: [0.46, 0.42, 0.28], at: [0, 0.3, 0], c: 'strap' }] });\nexport const bakr = person({ id: 'bakr', about: 'Old Bakr: engine driver in a greasy cap, grey beard', tags: ['npc'], palette: { cloth: 'navy', dark: 'night', skin: 'plum', hat: 'navy', strap: 'mist' }, head: [...HAT.cap, { box: [0.18, 0.1, 0.05], at: [0, 0, 0.1], c: 'strap' }] });\nexport const pell = person({ id: 'pell', about: 'Pell: a Harvest guide, thin, red headcloth', tags: ['npc'], palette: { cloth: 'sand', dark: 'plum', skin: 'red', hat: 'red', strap: 'orange' }, head: HAT.cloth });\nexport const civilian = person({ id: 'civilian', about: 'A villager in a plain long shirt', tags: ['npc'], palette: { cloth: 'sand', dark: 'red', skin: 'plum', hat: 'white', strap: 'red' }, head: [{ box: [0.22, 0.05, 0.22], at: [0, 0.24, 0], c: 'hat' }], hips: [{ box: [0.36, 0.3, 0.24], at: [0, -0.12, 0], c: 'cloth' }] });\nexport const npcRifle = model({ id: 'npc-rifle', about: 'A soldier rifle held in the hand; barrel along +Z', tags: ['weapon'], floats: true, collider: 'none', palette: { wood: 'red', steel: 'ink', mag: 'night' },\n  parts: [{ box: [0.07, 0.09, 0.42], at: [0, 0.02, 0.08], c: 'steel' }, { box: [0.04, 0.04, 0.34], at: [0, 0.04, 0.46], c: 'steel' }, { box: [0.08, 0.1, 0.24], at: [0, -0.01, -0.22], c: 'wood' }, { box: [0.06, 0.16, 0.08], at: [0, -0.1, 0.14], rot: [20, 0, 0], c: 'mag' }, { box: [0.06, 0.06, 0.18], at: [0, 0.03, 0.34], c: 'wood' }] });\nexport const gazelle = model({ id: 'gazelle', about: 'A small gazelle: pale belly, sand back, thin legs', tags: ['actor', 'fauna'], floats: true, collider: 'none', palette: { hide: 'orange', belly: 'sand', dark: 'plum' },\n  parts: [{ group: [\n    { box: [0.22, 0.26, 0.72], at: [0, 0.02, 0], c: 'hide' }, { box: [0.18, 0.08, 0.6], at: [0, -0.1, 0], c: 'belly' },\n    { group: [{ box: [0.12, 0.34, 0.12], at: [0, 0.16, 0.02], rot: [20, 0, 0], c: 'hide' }, { box: [0.12, 0.12, 0.24], at: [0, 0.36, 0.1], c: 'hide' }, { box: [0.03, 0.2, 0.03], at: [-0.04, 0.5, 0.04], rot: [-20, 0, 0], c: 'dark' }, { box: [0.03, 0.2, 0.03], at: [0.04, 0.5, 0.04], rot: [-20, 0, 0], c: 'dark' }], at: [0, 0.1, 0.32], pivot: true, name: 'Neck' },\n    ...[['LegFR', -0.08, 0.28], ['LegFL', 0.08, 0.28], ['LegBR', -0.08, -0.28], ['LegBL', 0.08, -0.28]].map(([name, x, z]) => ({ group: [{ box: [0.05, 0.44, 0.05], at: [0, -0.22, 0], c: 'dark' }], at: [x, -0.08, z], pivot: true, name })),\n  ], at: [0, 0.54, 0], pivot: true, name: 'Body' }] });\nexport const vulture = model({ id: 'vulture', about: 'A vulture seen from below: dark wings, pale ruff', tags: ['actor', 'fauna'], floats: true, collider: 'none', palette: { wing: 'ink', ruff: 'mist' },\n  parts: [{ box: [0.2, 0.14, 0.56], at: [0, 0, 0], c: 'wing' }, { box: [0.1, 0.08, 0.14], at: [0, 0.04, 0.32], c: 'ruff' },\n    { group: [{ box: [0.86, 0.04, 0.3], at: [-0.43, 0, 0], c: 'wing' }], at: [-0.1, 0, 0], pivot: true, name: 'WingR' },\n    { group: [{ box: [0.86, 0.04, 0.3], at: [0.43, 0, 0], c: 'wing' }], at: [0.1, 0, 0], pivot: true, name: 'WingL' }] });\n\n// ---- Nature ----\nconst crown = (x, y, z, w, h, d) => ({ cyl: [w, h, d], at: [x, y, z], top: 1.25, seg: 9, c: 'leaf' });\nconst acacia = (id, about, trunk, branches, crowns) => [\n  model({ id, about, tags: ['nature', 'tree'], collider: 'none', palette: { bark: 'plum', leaf: 'green', leaf2: 'teal' }, parts: [...trunk, ...branches, ...crowns] }),\n  model({ id: `${id}-burnt`, about: `${about}, burned to a black frame`, tags: ['nature', 'tree', 'burnt'], collider: 'none', palette: { bark: 'ink' }, parts: [...trunk, ...branches] }),\n];\nconst tr = (h, w = 0.34) => ({ cyl: [w, h, w], at: [0, h / 2, 0], top: 0.7, seg: 6, c: 'bark' });\nconst br = (x, y, z, rx, rz, l = 1.8) => ({ cyl: [0.14, l, 0.14], at: [x, y, z], rot: [rx, 0, rz], top: 0.6, seg: 5, c: 'bark' });\nexport const [acaciaA, acaciaABurnt] = acacia('acacia-a', 'Flat-topped acacia on a straight trunk', [tr(3.4)], [br(-0.7, 3.8, 0, 0, 40), br(0.75, 3.9, 0.2, 10, -42), br(0, 3.9, -0.7, -36, 0)], [crown(-0.5, 5, 0, 4.2, 0.55, 3.6), crown(0.9, 5.2, 0.4, 3.2, 0.5, 2.8), { ...crown(0.1, 5.5, -0.5, 2.6, 0.4, 2.6), c: 'leaf2' }]);\nexport const [acaciaB, acaciaBBurnt] = acacia('acacia-b', 'Leaning acacia with a split crown', [{ ...tr(2.8), rot: [0, 0, 7] }], [br(-1, 3.4, 0.2, 0, 52, 2.4), br(0.8, 3.4, -0.3, -20, -38, 2)], [crown(-1.8, 4.2, 0.2, 3.4, 0.5, 2.8), crown(1.4, 4.3, -0.6, 3.2, 0.5, 2.8), { ...crown(-0.1, 4.8, -0.1, 2, 0.35, 2), c: 'leaf2' }]);\nexport const [acaciaC, acaciaCBurnt] = acacia('acacia-c', 'Young thorn acacia, low and wide', [tr(1.9, 0.24)], [br(-0.4, 2.2, 0, 0, 34, 1.1), br(0.45, 2.2, 0.2, 10, -34, 1.1)], [crown(0, 2.8, 0, 3.4, 0.5, 3), { ...crown(0.3, 3.1, 0.2, 1.8, 0.3, 1.8), c: 'leaf2' }]);\nexport const bottleTree = model({ id: 'bottle-tree', about: 'A fat bottle tree with a swollen trunk and a sparse crown', tags: ['nature', 'tree'], collider: 'none', palette: { bark: 'plum', bark2: 'red', leaf: 'green' },\n  parts: [{ lathe: [[0.0, 0], [1.05, 0.1], [1.25, 1.2], [1.0, 2.8], [0.5, 4.2], [0.3, 5.0], [0, 5.1]], at: [0, 0, 0], seg: 9, c: 'bark' }, { box: [0.7, 0.8, 0.12], at: [0, 0.7, 1.15], rot: [10, 0, 0], c: 'bark2' }, br(-0.6, 5.2, 0, 0, 50, 1.3), br(0.6, 5.3, 0.2, 10, -48, 1.3), crown(-1, 5.9, 0, 2.2, 0.5, 2), crown(1, 6, 0.3, 2, 0.5, 1.8)] });\nexport const bottleTreeBurnt = model({ id: 'bottle-tree-burnt', about: 'A bottle tree burned black, still standing', tags: ['nature', 'tree', 'burnt'], collider: 'none', palette: { bark: 'ink', bark2: 'plum' },\n  parts: [{ lathe: [[0.0, 0], [1.05, 0.1], [1.25, 1.2], [1.0, 2.8], [0.5, 4.2], [0.3, 5.0], [0, 5.1]], at: [0, 0, 0], seg: 9, c: 'bark' }, { box: [0.7, 0.8, 0.12], at: [0, 0.7, 1.15], rot: [10, 0, 0], c: 'bark2' }, br(-0.6, 5.2, 0, 0, 50, 1.3), br(0.6, 5.3, 0.2, 10, -48, 1.3)] });\nexport const thornBush = model({ id: 'thorn-bush', about: 'A low grey-green thorn bush', tags: ['nature'], collider: 'none', palette: { leaf: 'teal', leaf2: 'green', bark: 'plum' }, parts: [{ ball: [1.5, 0.8, 1.3], at: [0, 0.42, 0], c: 'leaf' }, { ball: [0.8, 0.5, 0.8], at: [0.3, 0.7, 0.2], c: 'leaf2' }, { cyl: [0.14, 0.2, 0.14], at: [0, 0.1, 0], c: 'bark' }] });\nexport const termiteMound = model({ id: 'termite-mound', about: 'A red termite mound taller than a man', tags: ['nature'], collider: 'cyl', palette: { clay: 'red', clay2: 'orange' }, parts: [{ cone: [1.3, 2.3, 1.3], at: [0, 1.15, 0], seg: 7, c: 'clay' }, { cone: [0.6, 1.2, 0.6], at: [0.35, 0.6, 0.1], seg: 6, c: 'clay2' }, { cone: [0.55, 1.5, 0.55], at: [-0.3, 0.75, -0.2], seg: 6, c: 'clay2' }] });\n\n// ---- Buildings ----\nconst tin = (w, d, y, tilt = 6) => ({ box: [w, 0.1, d], at: [0, y, 0], rot: [tilt, 0, 0], c: 'tin' });\nconst wallsOpen = (w, h, d, c = 'wall', door = 1.3) => [\n  { box: [w, h, 0.2], at: [0, h / 2, -d / 2], c },\n  { box: [0.2, h, d], at: [-w / 2, h / 2, 0], c }, { box: [0.2, h, d], at: [w / 2, h / 2, 0], c },\n  { box: [(w - door) / 2, h, 0.2], at: [-(w + door) / 4, h / 2, d / 2], c }, { box: [(w - door) / 2, h, 0.2], at: [(w + door) / 4, h / 2, d / 2], c },\n  { box: [door + 0.1, h - 2.15, 0.2], at: [0, 2.15 + (h - 2.15) / 2, d / 2], c, collide: false },\n];\nexport const shack = model({ id: 'shack', about: 'A tin-roof shack of corrugated sheets, open doorway', tags: ['building'], collider: 'parts', size: [6.2, 3.4, 5.2], palette: { wall: 'slate', tin: 'red', frame: 'plum', floor: 'night' },\n  parts: [...wallsOpen(5.6, 2.5, 4.6), tin(6.1, 5.1, 2.72), { box: [5.6, 0.04, 4.6], at: [0, 0.02, 0], c: 'floor', collide: false }, { box: [0.14, 2.3, 0.26], at: [-0.72, 1.15, 2.34], c: 'frame', collide: false }, { box: [0.14, 2.3, 0.26], at: [0.72, 1.15, 2.34], c: 'frame', collide: false }] });\nexport const hut = model({ id: 'hut', about: 'A round mud hut with a thatched cone', tags: ['building'], collider: 'parts', palette: { wall: 'orange', thatch: 'sand', dark: 'plum' },\n  parts: [{ box: [1.6, 2.2, 3.4], at: [-1.6, 1.1, 0], c: 'wall' }, { box: [1.6, 2.2, 3.4], at: [1.6, 1.1, 0], c: 'wall' }, { box: [1.9, 2.2, 1.4], at: [0, 1.1, -1.6], c: 'wall' }, { cone: [6, 2.2, 6], at: [0, 3.2, 0], seg: 8, c: 'thatch', collide: false }, { box: [1.4, 2, 0.1], at: [0, 1, 1.3], c: 'dark', collide: false }] });\nexport const barracks = model({ id: 'barracks', about: 'A long concrete barracks, flat roof, open doorway', tags: ['building'], collider: 'parts', palette: { wall: 'mist', trim: 'slate', roof: 'night', floor: 'night' },\n  parts: [...wallsOpen(11, 2.9, 5.5), { box: [11.6, 0.2, 6.1], at: [0, 3, 0], c: 'roof' }, { box: [11, 0.3, 0.06], at: [0, 1.0, 2.8], c: 'trim', collide: false }, { box: [10.6, 0.04, 5.2], at: [0, 0.02, 0], c: 'floor', collide: false }, { box: [1, 0.7, 0.1], at: [-3.2, 1.7, 2.8], c: 'roof', collide: false }, { box: [1, 0.7, 0.1], at: [3.2, 1.7, 2.8], c: 'roof', collide: false }] });\nexport const bar = model({ id: 'bar', about: 'The bar at Mile Forty: an open front, a counter, a tin awning', tags: ['building'], collider: 'parts', palette: { wall: 'orange', tin: 'teal', wood: 'red', dark: 'plum', sign: 'sand' },\n  parts: [{ box: [9, 3, 0.2], at: [0, 1.5, -3], c: 'wall' }, { box: [0.2, 3, 6], at: [-4.5, 1.5, 0], c: 'wall' }, { box: [0.2, 3, 6], at: [4.5, 1.5, 0], c: 'wall' }, { box: [9.6, 0.12, 8], at: [0, 3.2, 1], rot: [6, 0, 0], c: 'tin', collide: false }, { box: [5, 1, 0.6], at: [-1, 0.5, -1], c: 'wood' }, { box: [3, 0.7, 0.1], at: [0, 3.5, 3.2], c: 'sign', collide: false }] });\nexport const office = model({ id: 'office', about: 'The colonel office: stone, shutters, a veranda', tags: ['building'], collider: 'parts', palette: { wall: 'mist', trim: 'navy', roof: 'plum', floor: 'night' },\n  parts: [...wallsOpen(9, 3.1, 6, 'wall', 1.6), { box: [10, 0.2, 7.4], at: [0, 3.25, 0.4], c: 'roof' }, { box: [0.2, 3.1, 0.2], at: [-3.8, 1.55, 3.9], c: 'trim' }, { box: [0.2, 3.1, 0.2], at: [3.8, 1.55, 3.9], c: 'trim' }, { box: [8.6, 0.04, 5.6], at: [0, 0.02, 0], c: 'floor', collide: false }] });\nexport const schoolroom = model({ id: 'schoolroom', about: 'Mother Ansa’s tin schoolroom: a blackboard and benches', tags: ['building'], collider: 'parts', palette: { wall: 'sand', tin: 'red', board: 'ink', wood: 'plum', chalk: 'white' },\n  parts: [...wallsOpen(10, 2.7, 7, 'wall', 2), tin(10.8, 7.8, 2.9), { box: [4, 1.3, 0.08], at: [0, 1.6, -3.3], c: 'board', collide: false }, { box: [2.4, 0.06, 0.02], at: [-0.3, 1.8, -3.25], c: 'chalk', collide: false }, ...[-1.4, 0.6].map((z) => ({ box: [5, 0.45, 0.4], at: [0, 0.22, z], c: 'wood', collide: false }))] });\nexport const bunker = model({ id: 'bunker', about: 'A low concrete ammo bunker with a slit', tags: ['building'], collider: 'parts', palette: { wall: 'mist', dark: 'night', roof: 'slate' },\n  parts: [{ box: [8, 2.4, 6], at: [0, 1.2, 0], c: 'wall' }, { box: [8.8, 0.4, 6.8], at: [0, 2.6, 0], c: 'roof' }, { box: [2.2, 1.9, 0.1], at: [0, 0.95, 3], c: 'dark', collide: false }, { box: [3, 0.25, 0.1], at: [-2.2, 1.9, 3], c: 'dark', collide: false }] });\nexport const watchtower = model({ id: 'watchtower', about: 'A timber watchtower with a tin roof', tags: ['building'], collider: 'parts', palette: { wood: 'plum', deck: 'red', tin: 'slate' },\n  parts: [...[[-1.2, -1.2], [1.2, -1.2], [-1.2, 1.2], [1.2, 1.2]].map(([x, z]) => ({ box: [0.24, 5.4, 0.24], at: [x, 2.7, z], c: 'wood' })), { box: [3, 0.2, 3], at: [0, 4.4, 0], c: 'deck' }, ...[[0, -1.4, 3, 0.1], [0, 1.4, 3, 0.1], [-1.4, 0, 0.1, 3], [1.4, 0, 0.1, 3]].map(([x, z, w, d]) => ({ box: [w, 0.9, d], at: [x, 4.95, z], c: 'deck', collide: false })), { box: [3.6, 0.1, 3.6], at: [0, 6.5, 0], rot: [5, 0, 0], c: 'tin', collide: false }, ...[[-1.2, -1.2], [1.2, -1.2], [-1.2, 1.2], [1.2, 1.2]].map(([x, z]) => ({ box: [0.12, 1.2, 0.12], at: [x, 5.9, z], c: 'wood', collide: false }))] });\nexport const sandbagRun = model({ id: 'sandbag-run', about: 'A run of sandbags, breast-high', tags: ['cover'], collider: 'box', palette: { bag: 'sand', bag2: 'orange', dark: 'plum' },\n  parts: [{ box: [4.2, 0.36, 0.72], at: [0, 0.18, 0], c: 'bag2' }, { box: [4, 0.36, 0.7], at: [0.1, 0.54, 0], c: 'bag' }, { box: [3.8, 0.36, 0.66], at: [-0.1, 0.9, 0], c: 'bag2' }, ...[-1.6, -0.5, 0.6, 1.7].map((x) => ({ box: [0.06, 1.08, 0.74], at: [x, 0.54, 0], c: 'dark', collide: false }))] });\nexport const boomGate = model({ id: 'boom-gate', about: 'A red and white boom gate across a road', tags: ['post'], collider: 'none', palette: { post: 'night', bar: 'white', bar2: 'red', hut: 'slate' },\n  parts: [{ box: [0.4, 1.3, 0.4], at: [-4, 0.65, 0], c: 'post' }, { group: [{ box: [8, 0.16, 0.16], at: [4, 0, 0], c: 'bar' }, ...[1, 3, 5, 7].map((x) => ({ box: [0.9, 0.18, 0.18], at: [x, 0, 0], c: 'bar2' }))], at: [-4, 1.25, 0], pivot: true, name: 'Boom' }, { box: [1.8, 2.4, 1.8], at: [-6, 1.2, 0], c: 'hut' }] });\nexport const fuelTank = model({ id: 'fuel-tank', about: 'A big rust-streaked fuel tank on legs with a red band', tags: ['target', 'explosive'], collider: 'cyl', palette: { tank: 'mist', band: 'red', leg: 'night', rust: 'orange' },\n  parts: [{ cyl: [5.6, 4.2, 5.6], at: [0, 3.1, 0], seg: 10, c: 'tank' }, { cyl: [5.7, 0.6, 5.7], at: [0, 3.6, 0], seg: 10, c: 'band' }, { cone: [5.6, 0.8, 5.6], at: [0, 5.6, 0], seg: 10, c: 'tank' }, ...[[-2, -2], [2, -2], [-2, 2], [2, 2]].map(([x, z]) => ({ box: [0.3, 1.1, 0.3], at: [x, 0.55, z], c: 'leg' })), { box: [1, 2, 0.08], at: [1, 2.4, 2.72], c: 'rust', collide: false }] });\nexport const oilDrum = model({ id: 'oil-drum', about: 'A dented oil drum with a red band', tags: ['explosive'], collider: 'cyl', palette: { drum: 'teal', band: 'red', top: 'night' }, parts: [{ cyl: [0.66, 0.95, 0.66], at: [0, 0.48, 0], seg: 8, c: 'drum' }, { cyl: [0.68, 0.14, 0.68], at: [0, 0.52, 0], seg: 8, c: 'band' }, { cyl: [0.5, 0.02, 0.5], at: [0, 0.96, 0], seg: 8, c: 'top' }] });\nexport const silo = model({ id: 'silo', about: 'A grain silo of ribbed tin with a cone cap', tags: ['building'], collider: 'cyl', palette: { tin: 'mist', rib: 'slate', cap: 'red' }, parts: [{ cyl: [6.4, 8.4, 6.4], at: [0, 4.2, 0], seg: 10, c: 'tin' }, ...[1.6, 3.8, 6].map((y) => ({ cyl: [6.5, 0.2, 6.5], at: [0, y, 0], seg: 10, c: 'rib' })), { cone: [6.8, 2.2, 6.8], at: [0, 9.5, 0], seg: 10, c: 'cap' }] });\nexport const waterTower = model({ id: 'water-tower', about: 'A steel water tower on four legs, rust down one side', tags: ['building'], collider: 'parts', palette: { tank: 'slate', leg: 'night', rust: 'red', cap: 'mist' },\n  parts: [...[[-2.4, -2.4], [2.4, -2.4], [-2.4, 2.4], [2.4, 2.4]].map(([x, z]) => ({ box: [0.3, 9, 0.3], at: [x, 4.5, z], c: 'leg' })), { cyl: [7, 3.8, 7], at: [0, 10.8, 0], seg: 10, c: 'tank', collide: false }, { cone: [7.2, 1.2, 7.2], at: [0, 13.3, 0], seg: 10, c: 'cap', collide: false }, { box: [1.2, 3, 0.1], at: [1.4, 10.6, 3.3], c: 'rust', collide: false }, { box: [5, 0.14, 0.14], at: [0, 5, -2.4], rot: [0, 0, 30], c: 'leg', collide: false }] });\nexport const pumpHouse = model({ id: 'pump-house', about: 'The pump house on the Mercy: brick, big pipe, a wheel valve', tags: ['building', 'target'], collider: 'parts', palette: { wall: 'red', roof: 'slate', pipe: 'teal', valv