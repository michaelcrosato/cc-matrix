f (this.decals) this.decals.add('scorch', { x, y: y + 0.05, z }, { x: 0, y: 1, z: 0 }, { size: r }); }\n  takeFrom(who) {\n    const g = this.g, n = g.npcs.byWho[who];\n    this.tp(n.x + 1.5, n.z + 2);\n    this.look(n.x, n.y + 1.5, n.z);\n    this.step(3);\n    this.press('use');\n    this.until(() => g.state().screen === 'choice', 6000, `offer from ${who}`);\n    this.pick('accept');\n  }\n}\n200:  fireNear() {\n201-    const g = this.game;\n202-    if (this.fixed) return false;\n203-    if (this.fireCheckT > 0) return this.fireIsNear;\n204-    this.fireCheckT = 0.5;\n205-    this.fireIsNear = false;\n618:  key('Enter'); t.eq('cash run menu', g.state().screen, 'cash');\n920:  t.ok('awards at most 3', (out.awards ?? []).length <= 3);\n2:export const NAMES = { bakr: 'OLD BAKR', odile: 'SISTER ODILE', tibor: 'TIBOR', vance: 'COL. VANCE', ansa: 'MOTHER ANSA', ines: 'INES', dov: 'DOV', mags: 'MAGS', harrow: 'HARROW', pell: 'PELL', conc\n6:export const VOICES = {\n7-  bakr: { wave: 'saw', base: 118, rate: 0.112, tilt: 1 }, odile: { wave: 'saw', base: 175, rate: 0.1, tilt: 1 }, tibor: { wave: 'saw', base: 100, rate: 0.13, tilt: 1 },\n8-  vance: { wave: 'triangle', base: 128, rate: 0.14, tilt: 1 }, ansa: { wave: 'saw', base: 205, rate: 0.095, tilt: 1 }, harrow: { wave: 'triangle', base: 92, rate: 0.17, tilt: 0.8 },\n50:  update(ctx, dt) {\n51-    const g = this.game;\n52-    if (!g.views) return;\n53-    const cam = g.camPos;\n54-    for (const h of this.herds) {\n55-      if (g.fireView.nearestDist < 90 && Math.hypot(h.hx - cam.x, h.hz - cam.z) < 200 && h.fleeT <= 0) { h.fleeT = 6; h.dir = g","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BViBGDcqjA9pFhzHfmbQ9U","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
