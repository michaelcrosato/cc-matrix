 g = this.game;\n    this.searchT -= dt;\n    if (this.lastKnown && !this.goal && !this.fixed) {\n      const d = Math.hypot(this.lastKnown.x - this.x, this.lastKnown.z - this.z);\n      if (d > 3) this.setGoal(this.lastKnown.x, this.lastKnown.z);\n      else this.lastKnown = null;\n    }\n    this.moveWanted = this.goal ? 2.6 : 0;\n    if (!this.goal) this.yaw += Math.sin(g.time * 0.6 + this.id) * dt * 1.2;\n    if (this.searchT <= 0) { this.state = 'idle'; this.suspicion = 0; this.lastKnown = null; this.goal = null; g.voice.bark(this, 'giveup'); }\n    this.view?.anim.set(this.moveWanted > 0 ? 'Walk' : 'Idle', 'AimIdle');\n    return 'running';\n  }\n  brainDuty(dt) {\n  alertTo(x, z, tgt) {\n    if (this.dead) return;\n    const was = this.state;\n    this.lastKnown = { x, z };\n    this.state = 'alert';\n    this.suspicion = 1;\n    if (tgt) this.target = tgt;\n    if (was !== 'alert') {\n      this.reactT = TUNING.enemyReaction;\n      this.game.voice.bark(this, 'spotted');\nsrc/actors/buddy.js:45:    if (this.view) { this.view.object.visible = true; this.view.anim.stop(); this.view.anim.set('Idle', 'AimIdle'); if (this.gunObj) this.gunObj.vi\nsrc/actors/buddy.js:97:    if (this.view) { this.view.anim.set('LieIdle', 'LieIdle', 0.3); }\nsrc/actors/soldier.js:77:      this.view.anim.stop();\nsrc/actors/soldier.js:115:    this.burningAtDeath = this.burning > 0;\nsrc/actors/soldier.js:118:    if (this.squad) this.squad.onDeath(this);\nsrc/actors/soldier.js:126:      this.view.anim.stop();\n      if (c.hidden || Math.hypot(c.x - f.x, c.z - f.z) > 280) continue;\n      c.step(dt);\n      if (g.tick % 20 === c.i % 20) {\n        if (g.fire.isBurning(c.x, c.z) || g.fireView.nearestDist < 30 && g.fire.isBurning(c.x + 8, c.z)) c.flee(c.x + g.rng.ai.range(-3, 3), c.z + g.rng.ai.range(-3, 3));\n      }\n      c.body?.setTranslation?.({ x: c.x, y: c.y + 0.9, z: c.z });\n    }\n  }\n  update(ctx, dt) {\n    const cam = this.game.camPos;\n    for (const c of this.list) {\n      if (!c.view || c.hidden) continue;\n      if (Math.hypot(c.x - cam.x, c.z - cam.z) > 170) { c.view.object.visible = false; continue; }\n      c.view.object.visible = true;\n      c.view.object.position.set(c.x, c.y, c.z); c.view.object.rotation.y = c.yaw;\n      c.view.anim.set(c.speed > 3 ? 'Run' : c.speed > 0 ? 'Walk' : 'Idle');\n      c.view.anim.speed(c.speed > 3 ? c.speed / 6.5 : 1);\n      c.view.anim.update(dt);\n    }\n  }\n}\n15:  kind = 'buddy'; met = false; dead = false; trust = 0; spentUntil = 0; woundedUntil = 0; active = false; hp = 200; isDown = false; downT = 0; burningDown = false; x =\n40:    this.x = x; this.z = z; this.y = g.world.heightAt(x, z); this.hp = hp; this.maxHp = hp; this.isDown = false; this.active = true; this.goal = goal; this.following =\n49:    this.active = false; this.isDown = false;\n56:    if (this.isDown || this.dead || !this.active) return;\n64:    this.isDown = true; this.downT = 40; this.burningDown = burning; this.hp = 0;\n78:    this.isDown = false; this.hp = this.maxHp * 0.5; this.trust++;\n95:    this.dead = true; this.isDown = false;\n126:    if (this.isDown) {\n127:      this.downT -= dt;\n129:      if (this.downT <= 0) { g.say('', `${this.name} HAS STOPPED ASKING.`, 3); this.killed('wound'); }\n19:  constructor(game, kind, at, yaw, palette) {\n23:    this.game = game; this.kind = kind; this.def = KINDS[kind];\n28:    game.hitMap.set(this.collider.handle, { kind: 'vehicle', ref: this });\n76:      const pal = WRECK[this.kind];\n];\nexport class Vehicles {\n  list = []; patrols = []; chase = false; steerVis = 0; engine = null; gravelV = null; repairT = 0; repairing = null; hasKit = false;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game;\n    if (g.views) {\n      this.cab = buildModel(cabHands);\n    });\n    t.eq('pad stub confirms', padRes.screen, 'main');\n    t.eq('pad device', padRes.device, 'pad');\n    await ctxP.close();\n    // A phone profile in Chromium.\n    const { de