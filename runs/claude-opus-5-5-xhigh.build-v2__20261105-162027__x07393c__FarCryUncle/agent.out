{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgm6aHc9kshUJqksCehK2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01USVMHyd7oZYRMMA6Kams37","name":"Bash","input":{"command":"set -e\npython3 - <<'EOF'\ns=open('tests/suites/static.mjs').read()\na=\"  // M3's wind is the plan's own.\\n\"\nassert a in s\ns=s.replace(a,\"\"\"  // The plan's geography, exact (section 5).\n  const { SITES: ST, POSTS: PO, TRIGS: TR, CASES: CA, HALTS: HA } = await import('../../src/content/sites.js');\n  const { RIVER, RAIL, BRIDGES, FORD } = await import('../../src/content/roads.js');\n  const planSites = { 'mile-forty': [0, 40], 'pump-shed': [-120, 150], 'ranger-post': [40, -170], 'water-tower': [470, -180], 'fort-clement': [-430, -180], 'long-field': [-260, -300], granary: [400, 280], 'east-siding': [430, -60], 'three-wells': [-260, 240], 'pump-station': [-330, 395], 'salt-pan': [200, 470], 'the-cut': [150, -300], observatory: [-130, -520], 'the-pass': [-590, -430] };\n  for (const [k, at] of Object.entries(planSites)) t.eq(`site ${k} is where the plan puts it`, JSON.stringify((ST[k] ?? ST[k.replace('the-', '')]).at), JSON.stringify(at));\n  const planPosts = { p1: [90, -80], p2: [-200, 30], p3: [170, 90], p4: [-320, -90], p5: [280, -210], p6: [300, 390] };\n  for (const [k, at] of Object.entries(planPosts)) t.eq(`post ${k} is where the plan puts it`, JSON.stringify(PO[k].at), JSON.stringify(at));\n  t.eq('the river runs the plan\\\\'s course', JSON.stringify(RIVER), JSON.stringify([[600, -640], [420, -320], [300, -120], [250, 80], [120, 230], [-60, 300], [-240, 380], [-420, 430], [-640, 470]]));\n  for (const b of [[250, 80], [120, 230]]) t.ok(`a road bridge at ${b}`, JSON.stringify(BRIDGES).includes(JSON.stringify(b).slice(1, -1)), JSON.stringify(BRIDGES));\n  t.eq('the ford is at the plan\\\\'s place', JSON.stringify(FORD.at), JSON.stringify([-60, 300]));\n  for (const q of [[-640, 110], [0, 70], [430, -60], [640, -110]]) t.ok(`the railway passes ${q}`, RAIL.main.some((m) => m[0] === q[0] && m[1] === q[1]));\n  t.eq('six trig points', TR.length, 6); t.eq('twelve stone cases', CA.length, 12); t.eq('four rail halts', Object.keys(HA).length, 4);\n  // The lines the plan says to use verbatim, split across subtitles only as it tells us to (section 15).\n  const VERBATIM = [\"Forty miles of track and not one station that remembers its name.\", \"They paint the signs over. Whoever won last.\", \"You have the look of a man who read about this place. Reading is a good way to visit.\", \"Up there they will ask you which side. Say yes.\", \"Three tablets. The fourth you pay for. I do not mean in stones.\", \"I do not need you to be good. I need you to be on time.\", \"Sixty-one beds. Forty blankets. You are the math.\", \"We do not burn villages. We conclude them.\", \"The water question has been a great sorrow to this office.\", \"Your invoice will be honoured, regrettably.\", \"You said less people. Fewer. Fewer people. It will matter by the end of the month.\", \"Burn the field. A hungry man learns to read the wind.\", \"Everything on this rack has been returned at least once.\", \"It fires. If you want it to fire twice, that is a different price.\", \"I flew for both of them. Neither paid. Get in.\", \"You owe me a truck. You owe me several trucks.\", \"Two fingers I left in this country. I came back to see what they are doing.\", \"A man asked me to mine his own road, so he would know where it was safe. He was right for a week.\", \"Hold still. No, you can't feel that. No, that's normal. Hold still.\", \"Not today. Today you owe me money.\", \"Don't let it be the fire. Please. Not the fire.\", \"There! In the grass!\", \"Who lit that?\", \"It's stuck! It's stuck again!\", \"Leave him, he's already gone.\", \"A map is a promise made by someone who has already left.\", \"I drew the river where the Company wanted it. The river was slow to comply, but it came round.\", \"Both armies buy from me. The Concord pays on time. The Harvest pays in grain and tears. I have eaten better on the tears.\", \"You will have noticed that you follow roads. I drew those too.\", \"Grass is the only honest border. It goes where the wind tells it, and it keeps a record.\", \"By now you have burned what I marked. Look at it from the ridge. Tell me that is not a line.\", \"You are late. I said you would be. Sit down, it won't take long, neither of us has long.\", \"I drew the lines that started this. I would like to draw one more.\", \"You have been drawing for me. Look at it.\", \"Burned grass cannot burn twice. It is the only safe road in the country, and you built it for wages.\", \"You reached the border with a case of stones and a map nobody else will ever use. The guard asks your trade. You tell him: surveyor.\", \"They crossed at first light, walking on ash. Nobody has asked who lit it. The fever is not finished with you, and you are out of tablets. It is a good view.\"];\n  const squeeze = (x) => x.toUpperCase().replace(/[^A-Z0-9]/g, '');\n  const said = squeeze(Object.values(LINES).flat().map((l) => l[1]).join(' ') + ' ' + MARGIN_NOTES.join(' ') + ' ' + (await readAll('src')));\n  for (const v of VERBATIM) t.ok(`verbatim: ${v.slice(0, 36)}`, said.includes(squeeze(v)));\n\"\"\"+a,1)\n# a small helper at the top of the file\na=\"export const covers = ['src', 'pixel-engine.js', 'vendor/pixel-engine.zip'];\"\nassert a in s\ns=s.replace(a,a+\"\"\"\nconst readAll = async (dir) => { const { readFileSync, readdirSync } = await import('node:fs'); const base = join(ROOT, dir); return readdirSync(base, { recursive: true }).map(String).filter((f) => f.endsWith('.js')).map((f) => readFileSync(join(base, f), 'utf8')).join('\\\\n'); };\"\"\",1)\nopen('tests/suites/static.mjs','w').write(s)\ns=open('tests/suites/systems.mjs').read()\na=\"  // Moves (section 7).\\n\"\nassert a in s\ns=s.replace(a,\"\"\"  // The land's shape and what lives on it (section 5).\n  const h = (x, z) => g.world.heightAt(x, z);\n  t.ok('the north ridge stands up', h(-130, -560) > h(0, -300) + 15, `${h(-130, -560)} ${h(0, -300)}`);\n  t.ok('the mine is a pit', h(150, -300) < h(150, -385) - 10, `${h(150, -300)} ${h(150, -385)}`);\n  t.near('the salt pan is flat at y 36', h(230, 500), 35, 37.5);\n  t.ok('the west escarpment rises', h(-620, 100) > h(-400, 100) + 10, `${h(-620, 100)} ${h(-400, 100)}`);\n  t.near('about 400 trees', g.world.trees.length, 330, 450);\n  t.eq('twelve people at Three Wells', g.actors.civilians.list.filter((c) => c.home === SITES['three-wells']).length, 12);\n\"\"\"+a,1)\nopen('tests/suites/systems.mjs','w').write(s)\nEOF\ngrep -n \"ROOT\\|^import.*join\" tests/suites/static.mjs | head -3 | cut -c1-110\ncat > tools/plan-coverage.mjs <<'EOF'\n// PLAN.md, section by section: each requirement and what proves it. A row fails if its proof is not really there:\n// a named check must exist in a suite (and tools/handin.mjs confirms the suites are green), a source pattern must match.\nimport { readFileSync, readdirSync, existsSync } from 'node:fs';\nimport { join, dirname, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nconst DEV = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nconst read = (d, ext) => readdirSync(join(DEV, d), { recursive: true }).map(String).filter((f) => f.endsWith(ext)).map((f) => readFileSync(join(DEV, d, f), 'utf8')).join('\\n');\nconst SRC = read('src', '.js'), TESTS = read('tests/suites', '.mjs');\nconst T = (s, what, name) => [s, what, 'test', name];\nconst C = (s, what, re) => [s, what, 'code', re];\nconst F = (s, what, path) => [s, what, 'file', path];\nconst NOT = (s, what, path) => [s, what, 'gone', path];\nconst P = (s, what, why) => [s, what, 'person', why];\nconst D = (s, what, why) => [s, what, 'differs', why];\nconst ROWS = [\n  T('1', 'First person on foot and at the wheel, chase camera in vehicles only', 'chase camera overrides'),\n  P('1', 'Length 45 to 75 minutes', 'the bot teleports between objectives, so real play time is not measured here'),\n  C('1', 'Civilians are not targets: they flee', /flee\\(/),\n  C('1', 'The clinic emblem is a green cross', /green cross/i),\n  C('2', 'The Sorrel, the Kettle, the Mercy, Mile Forty', /SORREL[\\s\\S]*KETTLE|KETTLE[\\s\\S]*SORREL/),\n  C('2', 'The Concord under Vance, the Harvest Front under Ansa', /VANCE[\\s\\S]*ANSA/),\n  C('2', 'Harrow the Surveyor; the contract note in his hand', /MIND THE FEVER\\. YOU ARE LATE ALREADY\\. E\\.H\\./),\n  C('2', 'Odile, Tibor, Old Bakr, Ines, Dov, Mags', /odile[\\s\\S]*tibor|tibor[\\s\\S]*odile/),\n  T('2', 'Both endings', 'both-alive-column'), T('2', 'Both endings, the other', 'one-dead-alone'),\n  C('3', 'Far plane raised for first person', /\\.far = 1000/),\n  C('3', 'The look step replaced; PC use keys free', /installLook/),\n  C('3', 'Pad buttons kept apart from keyboard codes', /PadCross/),\n  C('3', 'The pointer lock owned by the game', /wantsPointerLock/),\n  T('3', 'Pause by timeScale', 'time stopped'), T('3', 'Lost pointer lock pauses', 'losing the lock pauses'),\n  C('3', 'requestPointerLock rejection caught; re-lock on pointerup', /pointerup[\\s\\S]{0,300}catch/),\n  C('3', 'Terrain heights +40', /\\b40 \\+|\\+ 40\\b/),\n  T('3', 'Net and card independent of the render loop', 'hub ${sc}: pass'),\n  F('4', 'Kit at the dev root, engine unedited', 'check.mjs'), F('4', 'A one-page DESIGNERS.md', 'DESIGNERS.md'), F('4', 'An issues log', 'tests/ISSUES.md'),\n  NOT('4', 'Kit examples removed', 'examples'), NOT('4', 'Kit packs removed', 'packs'),\n  T('4', 'Sliders act at once: TUNING read at use', 'wear slider acts instantly'),\n  T('4', 'state() for tests; fingerprint for replays', 'replay ends in the same place'),\n  T('4', 'Simulation bubble', 'post goes live in the bubble'),\n  T('5', 'The 14 sites at the plan\\'s coordinates', 'is where the plan puts it'),\n  T('5', 'The six posts at the plan\\'s coordinates', 'post ${k} is where the plan puts it'),\n  T('5', 'A cleared post re-mans after postRemanHours', 're-manned after postRemanHours'),\n  T('5', 'The Mercy on its course, two bridges, a ford', 'the river runs the plan'), T('5', 'The railway', 'the railway passes'), T('5', 'Four rail halts', 'four rail halts'),\n  T('5', 'Ridge, escarpment, pan, pit', 'the mine is a pit'), T('5', 'About 400 trees', 'about 400 trees'),\n  T('5', 'Thorn bushes from library bush', 'thorn bushes are the library bush'), C('5', 'Rock and boulders on the ridge, reeds on the river', /scatterSet\\('rock'[\\s\\S]*reeds|reeds[\\s\\S]*scatterSet\\('rock'/),\n  C('5', 'Grass chunks 48 m, ~7000 blades, built at 170, hidden at 200, freed at 320', /CHUNK = 48[\\s\\S]*BUILD_R = 170, HIDE_R = 200, FREE_R = 320/),\n  C('5', 'Wading and vehicles only at bridges and the ford', /isFord/), C('5', 'Gazelle herds and Boids vultures', /Boids/), T('5', 'Twelve civilians at Three Wells', 'twelve people at Three Wells'),\n  T('6', 'Fire head 2 to 5 m/s at wind 5, flanks slower', 'fire head 2-5 m/s at wind 5'), T('6', 'Running escapes it', 'running escapes the head'),\n  T('6', 'Roads stop fire; embers cross in strong wind', 'embers cross a road in strong wind'), T('6', 'Burnt land cannot burn again', 'burnt cell refuses ignite'),\n  T('6', 'Grid survives a save (run-length)', 'grid survives a save'), T('6', 'Regrows after regrowHours', 'regrows after regrowHours'),\n  T('6', 'Short green new growth', 'with short new growth'), T('6', 'Then half density', 'the grass comes back thinner'), T('6', 'And it can burn again', 'and it can burn again'),\n  T('6', 'Vehicles in fire lose 6 HP/s', 'a vehicle in fire loses 6 HP/s'), C('6', 'Tanks and drums explode when their cell burns', /cookOff/),\n  C('6', 'Flame sprites, smoke columns, up to 3 lights, spatial roar', /fire-loop/), C('6', 'burnStrip for story scars', /burnStrip/),\n  C('6', 'Wind: grass, trees (WindUniforms), red cloth on every post, GPS arrow', /WindUniforms[\\s\\S]*clothGrid|clothGrid[\\s\\S]*WindUniforms/), T('6', 'Flags read the wind too', 'it streams downwind'),\n  C('6', 'The plan\\'s sky table', /#3a4a6b|0x3a4a6b/i), C('6', 'Sun, moon, stars', /moon/i), T('6', 'Storm damps fire; dust weather', 'a storm damps fire'),\n  C('6', 'The plan\\'s LOOK block', /contrast: 1\\.06, saturation: 1\\.05, warmth: 0\\.04/),\n  D('3', 'Fog: amount 0.55, near 200, far 950 as planned; top is 1, not -60', 'measured: top -60 drops contrast from 0.22 to 0.05 and nearly erases the gun. The engine documents top as a small height (top: 1.5), and the plan says the engine\\'s docs outrank it on how an API behaves'),\n  T('7', 'Walk 3.6 with Caps Lock', 'walk about 3.6'), T('7', 'Run 5.4', 'run about 5.4'), T('7', 'Sprint 7.4, 6 s of stamina, 8 s to refill', 'refills in 8 s'), T('7', 'Crouch 2', 'crouch about 2'), T('7', 'Wade 2.7, no sprint', 'no sprint in water'),\n  T('7', 'Jump about 1.3 m', 'a jump is about 1.3 m'), T('7', 'Fall damage above 6 m', 'a long fall hurts'), T('7', 'Landing dip in the view group', 'a landing dips what you hold'), T('7', 'Aim assist, pad only, settings toggle', 'over an enemy, pad look slows 35%'), C('7', 'One use prompt with hold rings', /interact/i),\n  T('8', 'The weapon table', '${id} as tabled'), T('8', 'Each gun fires', '${id} fires'), T('8', 'Jam formula', '1 in 33 at 50'), T('8', 'Reload clears a jam in presses', 'three presses clear it'), T('8', 'Soldiers\\' guns jam', 'soldier guns jam'),\n  T('8', 'Rust, tape, condition on the gun itself', 'rust at 30-59'), T('8', 'Falls apart at 0', 'falls apart clip played'), T('8', 'Condition icon white, orange, red', 'icon orange'), T('8', 'Scoped FOV', 'scoped FOV table'), T('8', 'Hit zones', 'head x2.5'),\n  T('8', 'Flamethrower, bottle, charge', 'second press detonates'), T('8', 'Mounted MG overheats and cools', 'cools in 4 s'), C('8', 'Shake, hitstop, muzzle light, tracer, Decals, rumble', /Decals[\\s\\S]*dual-rumble|dual-rumble[\\s\\S]*Decals/),\n  T('9', 'Five segments, regen to the segment', 'regen only to top of segment'), T('9', 'Syrette +40', 'syrette heals 40'), T('9', 'Four surgeries, below 20, leave you at 40', 'leaves you at 40'), T('9', 'A hit interrupts', 'a hit interrupts'), T('9', 'A burn gets the lighter', 'burn gets the lighter'), T('9', 'Burning hurts until off fuel', 'fire goes out off fuel'),\n  T('9', 'Game over text and screen', 'game over screen'), T('9', 'Fever: tablet clears over 5 s', 'clears over 5 s'), T('9', 'Ignored: 20% of stones gone, hours later', '20% of stones gone'), T('9', 'Buddy carries you and complains', 'woke somewhere safe'), T('9', 'In the last act it drops you where you stand', 'it costs you a fifth of your stones'),\n  T('10', 'Vision by stance and night', 'night x0.45'), T('10', 'Lit by muzzle flash', 'muzzle flash doubles it at night'), T('10', 'Suspicion then alert; squad shares', 'squad shares it'), T('10', 'Pass exemption', 'pass keeps its soldiers off you'), T('10', 'Firing or the inner yard ends it', 'the inner yard ends it too'), T('10', 'Burn panic, dies in about 5 s', 'dies in about 5 s'),\n  C('10', 'Roles: rifle, mg, sniper, rocket, driver', /driver: 60/), T('10', 'A driver in a dismounted crew', 'one driver in the crew'), C('10', 'Behaviour tree: panic, flee fire, dodge, combat, search, duty', /flee fire[\\s\\S]*dodge/), C('10', 'Flanking', /flank/), C('10', 'Patrols chase and dismount at 25 m', /dismount at 25 m/), T('10', 'At least 15 barks per faction', 'has 15 barks'),\n  D('10', 'HQ garrison holds fire on a visitor with no contract', 'the plan has contracts taken in person at HQ and also says everyone shoots on sight without a pass. Both cannot hold for a first visit. The other army\\'s contract still gets you shot'),\n  T('11', 'Drive to a waypoint', 'drives to a waypoint'), T('11', 'Thresholds: 10 burns, 0 stalls', 'stalled at 0, not burning'), T('11', 'Repair: hold 3 s, back to 50', 'back to 50'), T('11', 'Map up while driving', 'map up while driving'), T('11', 'Wheel and dash for each vehicle', 'four different cabs'), T('11', 'Hands on wheel and lever', 'both hands are in frame'), T('11', 'Swap to the gun', 'gun seat'), T('11', 'The train on its rail', 'train sits on its rail'), C('11', 'Parked at a safehouse: repaired overnight', /overnight|parked/i),\n  T('12', 'Rescue: dragged, up at 40, spent for a day', 'buddy spent for a day'), T('12', 'Mags at 60', 'Mags gets you up at 60'), T('12', 'Alternate plans', 'alt plan first'), T('12', 'Syrette or Finish It', 'two-button prompt'), T('12', 'A dead buddy stays dead; Ledger line', 'dead stays dead'), C('12', 'Name on the wall, gun under it', /name-wall/), C('12', 'Trust 3: they offer to split', /OFFERS TO SPLIT/), C('12', 'Perks: Ines far, Dov charges, Mags syrette', /rescueR: 900[\\s\\S]*Dov|Dov's perk/),\n  T('13', 'Tibor: guns, upgrades, unlock for good', 'unlocked for good'), T('13', 'Four upgrades', 'stock includes four upgrades'), T('13', 'Tracker beep and green', 'green within 60 m'), T('13', 'Twelve cases', 'twelve stone cases'), T('13', 'Bed, locker, crate', 'four hours and leave'), T('13', 'Rail halt: Bakr, a stone, an hour', 'Bakr on a black screen'), T('13', 'Six trigs, then a clean rifle', 'six trigs leave a clean rifle'), T('13', 'Mercy Runs and refusal', 'a free run clears the refusal, no pay'), T('13', 'Ledger: five lines', 'five ledger lines'), T('13', 'Hectares formula', 'hectares by the ledger'), T('13', 'Save: plain JSON, restores', 'save is plain JSON'),\n  T('14', 'All the step types', 'step type ${k}'), T('14', 'steal, escort, ride really work', 'an escort waits if you leave'), T('14', 'M0', 'M0 done'), T('14', 'M1: scripted jam, stall, repair', 'the 5th shot jams'), T('14', 'M2', 'Ranger Post yours'), T('14', 'M3: plan\\'s wind carries the fire', 'the wind carried fire to a tank'), T('14', 'M3 wind value', 'M3 wind is the plan'), T('14', 'M4: convoy, charges, tracker', 'tracker owned'), T('14', 'M5: both outcomes', 'Three Wells empties'), T('14', 'M5 alt', 'village stays'), T('14', 'M6: forced night, wind turns, choice', 'buddy down on fire'), T('14', 'M7: war, MG, Scar C', 'truce over'), T('14', 'M8: platform and on-rails MG', 'the column walks'), T('14', 'M8: people climb aboard', 'people climb aboard'), T('14', 'M9: scars glow, the sheet', 'scars glow on the sheet'), T('14', 'End: last grass, Ledger, credits, title', 'then the title'), T('14', 'Jump to any mission start', 'startMission jumps'), C('14', 'Notice board and Not Yet', /NOT YET/),\n  T('15', 'Every verbatim line', 'verbatim: '), T('15', 'Twelve epigraphs', 'twelve epigraphs'), T('15', '8 to 15 lines a mission', 'has its lines'), T('15', 'All text in the font', 'font covers'),\n  T('16', 'Every screen: native prompts in PlayStation, Xbox, keyboard', 'really drawn'), T('16', 'Touch gate: no buttons to prompt, only the Settings target', 'no button glyphs, since there are no buttons'), T('16', 'At most six items', 'at most 6 items'), T('16', 'Only title and pause cover the view', 'does not cover the world'), T('16', 'The HUD hides after 6 s', 'and hides 6 s later'), T('16', 'Mouse hover and click', 'real mouse hover moves focus'), T('16', 'Pad menus and sticks', 'stick moves menus'), T('16', 'Device switch and Xbox glyphs', 'Xbox glyph'), T('16', 'All pad glyphs are pixel art', 'is pixel art'), T('16', 'Held map: waypoint, closer view', 'Triangle or the wheel goes closer'), T('16', 'Tibor\\'s rack, locker, bed', 'locker swaps the main gun'), T('16', 'Lost pad pauses', 'a lost pad pauses'), T('16', 'Touch gate logic', 'touch-only: exact notice'), T('16', 'Tablet and phone profiles', '${name}: notice'), T('16', 'Analog triggers', 'analog R2 reaches gas'), C('16', 'Comfort settings', /reduceFlash[\\s\\S]*subtitle|subtitle[\\s\\S]*reduceFlash/i),\n  T('17', 'Dev Mode from pause', 'dev opens from pause'), T('17', 'Every button on every tab', 'survived every button'), T('17', 'Six rows a page', 'six rows at most'), T('17', 'All 20 sliders move and reset', '${s.key} back to default'), T('17', 'Reset one', 'reset one'), T('17', 'World playing or frozen', 'dev can leave the world playing'),\n  T('18', 'Attract at frame 601, not before', 'attract at frame 601'), T('18', 'Every beat, looping', 'every beat ran'), T('18', 'Any input exits', 'a key exits'), T('18', 'Saves untouched', 'saves untouched'), T('18', 'Behind the touch gate', 'attract runs behind the gate'), C('18', 'DEMO tag', /'DEMO'/),\n  T('19', 'Four hub scenarios', 'hub ${sc}: completes'), T('19', 'Served page is the game', 'served page is the game'), T('19', 'Cash Run rules', 'hired guns bank stones'), T('19', 'Down, revive, bleed out', '+1 revive'), T('19', 'Standings, stats, awards', 'awards at most 3'), T('19', 'Two windows: shared fire, case, standings', 'same standings'), T('19', 'Options ignored while Create held', 'Options ignored while Create held'), C('19', 'Awards named', /Last Friend[\\s\\S]*Paid in Full[\\s\\S]*Arsonist/i), C('19', 'Solo, host, join', /HOST ON THIS COMPUTER[\\s\\S]*JOIN ON THIS COMPUTER/i),\n  T('20', 'Every model passes the engine', 'model ${d.id}'), T('20', 'Fort walls: library stone-wall and battlement', 'a wall muffles what is behind it'), C('20', 'Fort uses the library pieces', /use: 'stone-wall'[\\s\\S]*use: 'battlement'/), T('20', 'Sheets checked', 'check.mjs --sheets'), C('20', 'grass-flame texture', /grass-flame/),\n  T('21', 'My clips valid and off the floor', 'stays out of the floor'), T('21', 'Stock clips resolve', 'stock clip ${n}'), C('21', 'gaitClip', /gaitClip\\(/), C('21', 'twoBoneIK', /twoBoneIK\\(/), C('21', 'SpringChain', /new SpringChain/), C('21', 'Squash', /new Squash/), T('21', 'Push and Limp', 'within reach he shoves'), T('21', 'Holster', 'slinging plays the holster clip'), C('21', 'Timeline for scenes', /Timeline/),\n  T('22', 'Music 10% and reset to 10%', 'reset returns music to 10%'), T('22', 'Real sound at the speakers', 'real sound reaches the speakers'), T('22', 'Muffled behind walls', 'a wall muffles what is behind it'), C('22', 'Every required sound', /brakes[\\s\\S]*train-whistle|train-whistle[\\s\\S]*brakes/), C('22', 'Seven songs', /stalk/), C('22', 'Voices per character', /syllable/),\n  T('23', 'One file from file://', 'nothing but the file itself is loaded'), C('23', 'Review flags kept', /withUrlOptions/), C('23', 'debugKeys off', /debugKeys: false/),\n  F('24', 'One command', 'tests/run.mjs'), T('24', 'Replay', 'replay ends in the same place'), T('24', 'Soak with views', 'soak ${seed} left no errors'), T('24', 'Engine tools', 'check.mjs --headless'), T('24', 'WebKit iPhone', 'WebKit iPhone: nothing uncaught'),\n  C('26', 'Nothing cut: fauna, link, card, chase, dust, Mercy Runs, M4, M5, M8', /game-link-v1[\\s\\S]*Boids|Boids[\\s\\S]*game-link-v1/),\n  P('sound', 'How it sounds', 'measured by signal level; nobody can listen here'), P('feel', 'How it feels, and its balance', 'no person has played it; rendering here is about 1 frame a second'), P('devices', 'A real pad, phone, iPhone and TV', 'stand-ins only, as TASK.md line 50 allows'),\n];\nlet bad = 0;\nconst present = { person: 0, differs: 0 };\nfor (const [s, what, kind, proof] of ROWS) {\n  let ok = true, note = '';\n  if (kind === 'test') { ok = TESTS.includes(proof); note = `test: ${proof}`; }\n  else if (kind === 'code') { ok = proof.test(SRC); note = 'source'; }\n  else if (kind === 'file') { ok = existsSync(join(DEV, proof)); note = proof; }\n  else if (kind === 'gone') { ok = !existsSync(join(DEV, proof)); note = `${proof} removed`; }\n  else { present[kind]++; note = proof; }\n  if (!ok) bad++;\n  const mark = !ok ? 'MISS' : kind === 'person' ? 'HUMAN' : kind === 'differs' ? 'DIFF' : 'ok';\n  console.log(`${mark.padEnd(5)} §${s.padEnd(3)} ${what}${kind === 'person' || kind === 'differs' || !ok ? `  [${note}]` : ''}`);\n}\nconsole.log(`${ROWS.length} requirements: ${ROWS.length - bad - present.person - present.differs} proven, ${present.differs} differ with a reason, ${present.person} need a person, ${bad} missing`);\nprocess.exit(bad ? 1 : 0);\nEOF\nnode tools/plan-coverage.mjs 2>&1 | grep -E \"^MISS|requirements:\" | cut -c1-170","description":"Add geography and verbatim tests; write plan coverage tool","timeout":60000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4438,"cache_read_input_tokens":551369,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4438},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"12cbded0-135b-4726-b3a9-3c26f35bf572","timestamp":"2026-11-06T05:10:38.396Z","request_id":"req_011Cgm6aHJYEzs7ctrRsNPNk","wire_tool_inputs":{"toolu_01USVMHyd7oZYRMMA6Kams37":{"command":"set -e\npython3 - <<'EOF'\ns=open('tests/suites/static.mjs').read()\na=\"  // M3's wind is the plan's own.\\n\"\nassert a in s\ns=s.replace(a,\"\"\"  // The plan's geography, exact (section 5).\n  const { SITES: ST, POSTS: PO, TRIGS: TR, CASES: CA, HALTS: HA } = await import('../../src/content/sites.js');\n  const { RIVER, RAIL, BRIDGES, FORD } = await import('../../src/content/roads.js');\n  const planSites = { 'mile-forty': [0, 40], 'pump-shed': [-120, 150], 'ranger-post': [40, -170], 'water-tower': [470, -180], 'fort-clement': [-430, -180], 'long-field': [-260, -300], granary: [400, 280], 'east-siding': [430, -60], 'three-wells': [-260, 240], 'pump-station': [-330, 395], 'salt-pan': [200, 470], 'the-cut': [150, -300], observatory: [-130, -520], 'the-pass': [-590, -430] };\n  for (const [k, at] of Object.entries(planSites)) t.eq(`site ${k} is where the plan puts it`, JSON.stringify((ST[k] ?? ST[k.replace('the-', '')]).at), JSON.stringify(at));\n  const planPosts = { p1: [90, -80], p2: [-200, 30], p3: [170, 90], p4: [-320, -90], p5: [280, -210], p6: [300, 390] };\n  for (const [k, at] of Object.entries(planPosts)) t.eq(`post ${k} is where the plan puts it`, JSON.stringify(PO[k].at), JSON.stringify(at));\n  t.eq('the river runs the plan\\\\'s course', JSON.stringify(RIVER), JSON.stringify([[600, -640], [420, -320], [300, -120], [250, 80], [120, 230], [-60, 300], [-240, 380], [-420, 430], [-640, 470]]));\n  for (const b of [[250, 80], [120, 230]]) t.ok(`a road bridge at ${b}`, JSON.stringify(BRIDGES).includes(JSON.stringify(b).slice(1, -1)), JSON.stringify(BRIDGES));\n  t.eq('the ford is at the plan\\\\'s place', JSON.stringify(FORD.at), JSON.stringify([-60, 300]));\n  for (const q of [[-640, 110], [0, 70], [430, -60], [640, -110]]) t.ok(`the railway passes ${q}`, RAIL.main.some((m) => m[0] === q[0] && m[1] === q[1]));\n  t.eq('six trig points', TR.length, 6); t.eq('twelve stone cases', CA.length, 12); t.eq('four rail halts', Object.keys(HA).length, 4);\n  // The lines the plan says to use verbatim, split across subtitles only as it tells us to (section 15).\n  const VERBATIM = [\"Forty miles of track and not one station that remembers its name.\", \"They paint the signs over. Whoever won last.\", \"You have the look of a man who read about this place. Reading is a good way to visit.\", \"Up there they will ask you which side. Say yes.\", \"Three tablets. The fourth you pay for. I do not mean in stones.\", \"I do not need you to be good. I need you to be on time.\", \"Sixty-one beds. Forty blankets. You are the math.\", \"We do not burn villages. We conclude them.\", \"The water question has been a great sorrow to this office.\", \"Your invoice will be honoured, regrettably.\", \"You said less people. Fewer. Fewer people. It will matter by the end of the month.\", \"Burn the field. A hungry man learns to read the wind.\", \"Everything on this rack has been returned at least once.\", \"It fires. If you want it to fire twice, that is a different price.\", \"I flew for both of them. Neither paid. Get in.\", \"You owe me a truck. You owe me several trucks.\", \"Two fingers I left in this country. I came back to see what they are doing.\", \"A man asked me to mine his own road, so he would know where it was safe. He was right for a week.\", \"Hold still. No, you can't feel that. No, that's normal. Hold still.\", \"Not today. Today you owe me money.\", \"Don't let it be the fire. Please. Not the fire.\", \"There! In the grass!\", \"Who lit that?\", \"It's stuck! It's stuck again!\", \"Leave him, he's already gone.\", \"A map is a promise made by someone who has already left.\", \"I drew the river where the Company wanted it. The river was slow to comply, but it came round.\", \"Both armies buy from me. The Concord pays on time. The Harvest pays in grain and tears. I have eaten better on the tears.\", \"You will have noticed that you follow roads. I drew those too.\", \"Grass is the only honest border. It goes where the wind tells it, and it keeps a record.\", \"By now you have burned what I marked. Look at it from the ridge. Tell me that is not a line.\", \"You are late. I said you would be. Sit down, it won't take long, neither of us has long.\", \"I drew the lines that started this. I would like to draw one more.\", \"You have been drawing for me. Look at it.\", \"Burned grass cannot burn twice. It is the only safe road in the country, and you built it for wages.\", \"You reached the border with a case of stones and a map nobody else will ever use. The guard asks your trade. You tell him: surveyor.\", \"They crossed at first light, walking on ash. Nobody has asked who lit it. The fever is not finished with you, and you are out of tablets. It is a good view.\"];\n  const squeeze = (x) => x.toUpperCase().replace(/[^A-Z0-9]/g, '');\n  const said = squeeze(Object.values(LINES).flat().map((l) => l[1]).join(' ') + ' ' + MARGIN_NOTES.join(' ') + ' ' + (await readAll('src')));\n  for (const v of VERBATIM) t.ok(`verbatim: ${v.slice(0, 36)}`, said.includes(squeeze(v)));\n\"\"\"+a,1)\n# a small helper at the top of the file\na=\"export const covers = ['src', 'pixel-engine.js', 'vendor/pixel-engine.zip'];\"\nassert a in s\ns=s.replace(a,a+\"\"\"\nconst readAll = async (dir) => { const { readFileSync, readdirSync } = await import('node:fs'); const base = join(ROOT, dir); return readdirSync(base, { recursive: true }).map(String).filter((f) => f.endsWith('.js')).map((f) => readFileSync(join(base, f), 'utf8')).join('\\\\n'); };\"\"\",1)\nopen('tests/suites/static.mjs','w').write(s)\ns=open('tests/suites/systems.mjs').read()\na=\"  // Moves (section 7).\\n\"\nassert a in s\ns=s.replace(a,\"\"\"  // The land's shape and what lives on it (section 5).\n  const h = (x, z) => g.world.heightAt(x, z);\n  t.ok('the north ridge stands up', h(-130, -560) > h(0, -300) + 15, `${h(-130, -560)} ${h(0, -300)}`);\n  t.ok('the mine is a pit', h(150, -300) < h(150, -385) - 10, `${h(150, -300)} ${h(150, -385)}`);\n  t.near('the salt pan is flat at y 36', h(230, 500), 35, 37.5);\n  t.ok('the west escarpment rises', h(-620, 100) > h(-400, 100) + 10, `${h(-620, 100)} ${h(-400, 100)}`);\n  t.near('about 400 trees', g.world.trees.length, 330, 450);\n  t.eq('twelve people at Three Wells', g.actors.civilians.list.filter((c) => c.home === SITES['three-wells']).length, 12);\n\"\"\"+a,1)\nopen('tests/suites/systems.mjs','w').write(s)\nEOF\ngrep -n \"ROOT\\|^import.*join\" tests/suites/static.mjs | head -3 | cut -c1-110\ncat > tools/plan-coverage.mjs <<'EOF'\n// PLAN.md, section by section: each requirement and what proves it. A row fails if its proof is not really there:\n// a named check must exist in a suite (and tools/handin.mjs confirms the suites are green), a source pattern must match.\nimport { readFileSync, readdirSync, existsSync } from 'node:fs';\nimport { join, dirname, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nconst DEV = resolve(dirname(fileURLToPath(import.meta.url)), '..');\nconst read = (d, ext) => readdirSync(join(DEV, d), { recursive: true }).map(String).filter((f) => f.endsWith(ext)).map((f) => readFileSync(join(DEV, d, f), 'utf8')).join('\\n');\nconst SRC = read('src', '.js'), TESTS = read('tests/suites', '.mjs');\nconst T = (s, what, name) => [s, what, 'test', name];\nconst C = (s, what, re) => [s, what, 'code', re];\nconst F = (s, what, path) => [s, what, 'file', path];\nconst NOT = (s, what, path) => [s, what, 'gone', path];\nconst P = (s, what, why) => [s, what, 'person', why];\nconst D = (s, what, why) => [s, what, 'differs', why];\nconst ROWS = [\n  T('1', 'First person on foot and at the wheel, chase camera in vehicles only', 'chase camera overrides'),\n  P('1', 'Length 45 to 75 minutes', 'the bot teleports between objectives, so real play time is not measured here'),\n  C('1', 'Civilians are not targets: they flee', /flee\\(/),\n  C('1', 'The clinic emblem is a green cross', /green cross/i),\n  C('2', 'The Sorrel, the Kettle, the Mercy, Mile Forty', /SORREL[\\s\\S]*KETTLE|KETTLE[\\s\\S]*SORREL/),\n  C('2', 'The Concord under Vance, the Harvest Front under Ansa', /VANCE[\\s\\S]*ANSA/),\n  C('2', 'Harrow the Surveyor; the contract note in his hand', /MIND THE FEVER\\. YOU ARE LATE ALREADY\\. E\\.H\\./),\n  C('2', 'Odile, Tibor, Old Bakr, Ines, Dov, Mags', /odile[\\s\\S]*tibor|tibor[\\s\\S]*odile/),\n  T('2', 'Both endings', 'both-alive-column'), T('2', 'Both endings, the other', 'one-dead-alone'),\n  C('3', 'Far plane raised for first person', /\\.far = 1000/),\n  C('3', 'The look step replaced; PC use keys free', /installLook/),\n  C('3', 'Pad buttons kept apart from keyboard codes', /PadCross/),\n  C('3', 'The pointer lock owned by the game', /wantsPointerLock/),\n  T('3', 'Pause by timeScale', 'time stopped'), T('3', 'Lost pointer lock pauses', 'losing the lock pauses'),\n  C('3', 'requestPointerLock rejection caught; re-lock on pointerup', /pointerup[\\s\\S]{0,300}catch/),\n  C('3', 'Terrain heights +40', /\\b40 \\+|\\+ 40\\b/),\n  T('3', 'Net and card independent of the render loop', 'hub ${sc}: pass'),\n  F('4', 'Kit at the dev root, engine unedited', 'check.mjs'), F('4', 'A one-page DESIGNERS.md', 'DESIGNERS.md'), F('4', 'An issues log', 'tests/ISSUES.md'),\n  NOT('4', 'Kit examples removed', 'examples'), NOT('4', 'Kit packs removed', 'packs'),\n  T('4', 'Sliders act at once: TUNING read at use', 'wear slider acts instantly'),\n  T('4', 'state() for tests; fingerprint for replays', 'replay ends in the same place'),\n  T('4', 'Simulation bubble', 'post goes live in the bubble'),\n  T('5', 'The 14 sites at the plan\\'s coordinates', 'is where the plan puts it'),\n  T('5', 'The six posts at the plan\\'s coordinates', 'post ${k} is where the plan puts it'),\n  T('5', 'A cleared post re-mans after postRemanHours', 're-manned after postRemanHours'),\n  T('5', 'The Mercy on its course, two bridges, a ford', 'the river runs the plan'), T('5', 'The railway', 'the railway passes'), T('5', 'Four rail halts', 'four rail halts'),\n  T('5', 'Ridge, escarpment, pan, pit', 'the mine is a pit'), T('5', 'About 400 trees', 'about 400 trees'),\n  T('5', 'Thorn bushes from library bush', 'thorn bushes are the library bush'), C('5', 'Rock and boulders on the ridge, reeds on the river', /scatterSet\\('rock'[\\s\\S]*reeds|reeds[\\s\\S]*scatterSet\\('rock'/),\n  C('5', 'Grass chunks 48 m, ~7000 blades, built at 170, hidden at 200, freed at 320', /CHUNK = 48[\\s\\S]*BUILD_R = 170, HIDE_R = 200, FREE_R = 320/),\n  C('5', 'Wading and vehicles only at bridges and the ford', /isFord/), C('5', 'Gazelle herds and Boids vultures', /Boids/), T('5', 'Twelve civilians at Three Wells', 'twelve people at Three Wells'),\n  T('6', 'Fire head 2 to 5 m/s at wind 5, flanks slower', 'fire head 2-5 m/s at wind 5'), T('6', 'Running escapes it', 'running escapes the head'),\n  T('6', 'Roads stop fire; embers cross in strong wind', 'embers cross a road in strong wind'), T('6', 'Burnt land cannot burn again', 'burnt cell refuses ignite'),\n  T('6', 'Grid survives a save (run-length)', 'grid survives a save'), T('6', 'Regrows after regrowHours', 'regrows after regrowHours'),\n  T('6', 'Short green new growth', 'with short new growth'), T('6', 'Then half density', 'the grass comes back thinner'), T('6', 'And it can burn again', 'and it can burn again'),\n  T('6', 'Vehicles in fire lose 6 HP/s', 'a vehicle in fire loses 6 HP/s'), C('6', 'Tanks and drums explode when their cell burns', /cookOff/),\n  C('6', 'Flame sprites, smoke columns, up to 3 lights, spatial roar', /fire-loop/), C('6', 'burnStrip for story scars', /burnStrip/),\n  C('6', 'Wind: grass, trees (WindUniforms), red cloth on every post, GPS arrow', /WindUniforms[\\s\\S]*clothGrid|clothGrid[\\s\\S]*WindUniforms/), T('6', 'Flags read the wind too', 'it streams downwind'),\n  C('6', 'The plan\\'s sky table', /#3a4a6b|0x3a4a6b/i), C('6', 'Sun, moon, stars', /moon/i), T('6', 'Storm damps fire; dust weather', 'a storm damps fire'),\n  C('6', 'The plan\\'s LOOK block', /contrast: 1\\.06, saturation: 1\\.05, warmth: 0\\.04/),\n  D('3', 'Fog: amount 0.55, near 200, far 950 as planned; top is 1, not -60', 'measured: top -60 drops contrast from 0.22 to 0.05 and nearly erases the gun. The engine documents top as a small height (top: 1.5), and the plan says the engine\\'s docs outrank it on how an API behaves'),\n  T('7', 'Walk 3.6 with Caps Lock', 'walk about 3.6'), T('7', 'Run 5.4', 'run about 5.4'), T('7', 'Sprint 7.4, 6 s of stamina, 8 s to refill', 'refills in 8 s'), T('7', 'Crouch 2', 'crouch about 2'), T('7', 'Wade 2.7, no sprint', 'no sprint in water'),\n  T('7', 'Jump about 1.3 m', 'a jump is about 1.3 m'), T('7', 'Fall damage above 6 m', 'a long fall hurts'), T('7', 'Landing dip in the view group', 'a landing dips what you hold'), T('7', 'Aim assist, pad only, settings toggle', 'over an enemy, pad look slows 35%'), C('7', 'One use prompt with hold rings', /interact/i),\n  T('8', 'The weapon table', '${id} as tabled'), T('8', 'Each gun fires', '${id} fires'), T('8', 'Jam formula', '1 in 33 at 50'), T('8', 'Reload clears a jam in pre