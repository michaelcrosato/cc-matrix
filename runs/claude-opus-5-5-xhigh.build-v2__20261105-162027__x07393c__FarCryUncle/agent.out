for a,b in [\n(\"  for (let page = 0; page < 3; page++) {\\n    g.dev.balancePage = page;\",\"  for (let page = 0; page < Math.ceil(SLIDERS.length / 4); page++) {\\n    g.dev.balancePage = page;\"),\n(\"  top.tab = 5; g.dev.balancePage = 0; p.step(1);\\n  const jr =\",\"  top.tab = 5; g.dev.balancePage = Math.floor(SLIDERS.findIndex((x) => x.key === 'jamRate') / 4); p.step(1);\\n  const jr =\"),\n(\"    for (let tab = 0; tab < 7; tab++) { m.top.tab = tab; e.step(2); check(kind, `dev tab ${tab}`, { items: false }); }\",\"    for (let tab = 0; tab < 7; tab++) { m.top.tab = tab; e.step(2); check(kind, `dev tab ${tab}`); }\"),\n(\"    const ids = m.itemsOf(m.top).map((it, i) => it.id ?? i);\\n\",\"    const ids = g.dev.allItems(tab).map((it, i) => it.id ?? i);\\n\"),\n(\"      const it = m.itemsOf(m.top).find((x, i) => (x.id ?? i) === id);\\n\",\"      const it = g.dev.allItems(tab).find((x, i) => (x.id ?? i) === id);\\n\"),\n(\"  t.ok('pressed dev buttons', pressed > 30, String(pressed));\\n\",\"\"\"  t.ok('pressed dev buttons', pressed > 30, String(pressed));\n  // Every page of every tab keeps to six rows, and between them the pages show everything.\n  for (let tab = 0; tab < 7; tab++) {\n    openDev(tab);\n    const seen = new Set(), total = g.dev.allItems(tab).filter((x) => x.id !== 'more' && x.id !== 'resetAll').length;\n    for (let guard = 0; guard < 12; guard++) {\n      const page = m.itemsOf(m.top);\n      t.ok(`dev tab ${tab} page ${guard}: six rows at most`, page.length <= 6, String(page.length));\n      for (const x of page) if (x.id !== 'more' && x.id !== 'resetAll') seen.add(x.label);\n      const more = page.find((x) => x.id === 'more');\n      if (!more) break;\n      more.onSelect(); e.step(1);\n      if (/\\\\(1\\\\//.test(m.itemsOf(m.top).find((x) => x.id === 'more')?.label ?? '')) break;\n    }\n    if (tab !== 5) t.eq(`dev tab ${tab}: the pages show everything`, seen.size, total);\n  }\n  t.eq('the balance pages show every slider', SLIDERS.length,