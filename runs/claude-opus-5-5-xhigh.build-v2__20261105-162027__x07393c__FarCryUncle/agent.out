ITES[o.safehouse].at[0] + b[0] + 1.5, SITES[o.safehouse].at[1] + b[1] + 1.5]; }\"\"\")\nopen(p,'w').write(s)\n\np='src/actors/player.js'; s=open(p).read()\na=\"\"\"    else this.stamina = Math.min(6, this.stamina + dt * (6 / 8));\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    else {\n      if (this.stamina <= 0 && !this.winded) { this.winded = true; g.sfx.play('breath', { volume: 0.7 }); g.after(0.9, () => g.sfx.play('breath', { volume: 0.5 })); }\n      this.stamina = Math.min(6, this.stamina + dt * (6 / 8));\n      if (this.stamina > 2) this.winded = false;\n    }\"\"\")\nopen(p,'w').write(s)\n\np='src/vehicles/driving.js'; s=open(p).read()\na=\"\"\"    if (Math.abs(v.car.speed) > 3 && g.ground.kindAt(v.x, v.z) !== 1) { /* gravel plays by the engine note */ }\n    if (a.take('jump')) { /* handbrake is held, not pressed */ }\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    // The road talks back: gravel off the road, brakes when you stand on them.\n    const sp = Math.abs(v.car.speed);\n    if (sp > 5 && (this.gravelT = (this.gravelT ?? 0) - dt) <= 0) { this.gravelT = 0.35 - Math.min(0.2, sp * 0.008); if (g.ground.kindAt(v.x, v.z) !== 1) g.sfx.play('gravel', { volume: Math.min(0.6, sp * 0.03), pitch: g.rng.fx.range(-2, 2) }); }\n    if (sp > 6 && (input.handbrake || a.analog('brake') > 0.5)) { if (!this.braking) { this.braking = true; g.sfx.play('brakes', { volume: 0.6 }); } } else this.braking = false;\n    a.take('jump');\"\"\")\n# visible drivers on AI cars\na=\"\"\"        if (d < 380 && d > 90 && !g.story.noPatrols) { p.v = this.spawn(p.def.kind, p.x, p.z, p.dir > 0 ? at[2] : at[2] + Math.PI, p.def.palette); p.v.patrol = p; p.v.driver = 'ai'; p.v.faction = p.def.faction; p.v.crew = 2; }\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"        if (d < 380 && d > 90 && !g.story.noPatrols) { p.v = this.spawn(p.def.kind, p.x, p.z, p.dir > 0 ? at[2] : at[2] + Math.PI, p.def.palette); p.v.patrol = p; p.v.driver = 'ai'; p.v.faction = p.def.faction; p.v.crew = 2; this.seatDriver(p.v); }\"\"\")\na=\"\"\"  stopPatrols() {\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"  /** Somebody is at the wheel of every truck on the road. */\n  seatDriver(v) {\n    const g = this.game;\n    if (!g.views || !v.object || v.driverView) return;\n    const pal = v.faction === 'harvest' ? { cloth: 'sand', dark: 'red', hat: 'red', strap: 'orange', skin: 'plum' } : { cloth: 'slate', dark: 'night', hat: 'navy', strap: 'white', skin: 'sand' };\n    const d = makePerson('soldier-b', pal);\n    d.anim.set('DriveSit');\n    d.object.position.set(v.def.seat[0], v.def.seat[1] - 1.55, v.def.seat[2]);\n    v.object.add(d.object);\n    v.driverView = d;\n  }\n  stopPatrols() {\"\"\")\ns=s.replace(\"import { pointAlong, polyLength } from '../world/ground.js';\\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\\nconst { Vector3, Quaternion, Group } = THREE;\\nconst _v = new Vector3(), _q = new Quaternion();\",\"import { pointAlong, polyLength } from '../world/ground.js';\\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\\nimport { makePerson } from '../actors/rig.js';\\nconst { Vector3, Quaternion, Group } = THREE;\\nconst _v = new Vector3(), _q = new Quaternion();\")\na=\"\"\"    for (const v of this.list) v.update(ctx, dt);\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    for (const v of this.list) { v.update(ctx, dt); if (v.driverView) { if (v.driver !== 'ai' || !v.alive) { v.driverView.object.visible = false; } else v.driverView.anim.update(dt); } }\"\"\")\nopen(p,'w').write(s)\n\np='src/missions/scripts.js'; s=open(p).read()\ns=s.replace(\"v.patrol = { pts, L, s: off, dir: 1, loop: !useBridge };\\n        v.convoy = true;\",\"v.patrol = { pts, L, s: off, dir: 1, loop: !useBridge };\\n        v.convoy = true;\\n        g.vehicles.seatDriver(v);\")\nopen(p,'w').write(s)\n\n# settings: at most six items a screen\np='src/ui/shell.js'; s=open(p).read()\na=\"\"\"        { id: 'reset', label: 'RESET TO DEFAULTS', small: true, onSelect: () => this.resetSettings() },\n      ],\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"      ],\"\"\")\na=\"\"\"        { id: 'fov', label: 'FIELD OF VIEW', slider: S('fov', 50, 90, 1, (v) => String(Math.round(v))) },\n        { id: 'reset', label: 'RESET TO DEFAULTS', onSelect: () => this.resetSettings() },\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"        { id: 'fov', label: 'FIELD OF VIEW', slider: S('fov', 50, 90, 1, (v) => String(Math.round(v))) },\"\"\")\na=\"\"\"        { id: 'music', label: 'MUSIC', slider: S('music', 0, 1, 0.05, pct) }, { id: 'sfx', label: 'EFFECTS', slider: S('sfx', 0, 1, 0.05, pct) }, { id: 'voices', label: 'VOICES', slider: S('voices', 0, 1, 0.05, pct) },\n        { id: 'reset', label: 'RESET TO DEFAULTS', onSelect: () => this.resetSettings() },\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"        { id: 'music', label: 'MUSIC', slider: S('music', 0, 1, 0.05, pct) }, { id: 'sfx', label: 'EFFECTS', slider: S('sfx', 0, 1, 0.05, pct) }, { id: 'voices', label: 'VOICES', slider: S('voices', 0, 1, 0.05, pct) },\"\"\")\ns=s.replace(\"{ id: 'sensPad', label: 'LOOK, PAD', slider: S('sensPad', 0.25, 3, 0.05, (v) => v.toFixed(2)), small: true }, { id: 'sensMouse', label: 'LOOK, MOUSE', slider: S('sensMouse', 0.25, 3, 0.05, (v) => v.toFixed(2)), small: true },\",\"{ id: 'sensPad', label: 'LOOK, PAD', slider: S('sensPad', 0.25, 3, 0.05, (v) => v.toFixed(2)) }, { id: 'sensMouse', label: 'LOOK, MOUSE', slider: S('sensMouse', 0.25, 3, 0.05, (v) => v.toFixed(2)) },\")\ns=s.replace(\"{ id: 'invertY', label: 'INVERT Y', choices: onOff('invertY'), small: true }, { id: 'aimAssist', label: 'AIM ASSIST', choices: onOff('aimAssist'), small: true }, { id: 'rumble', label: 'RUMBLE', choices: onOff('rumble'), small: true },\",\"{ id: 'invertY', label: 'INVERT Y', choices: onOff('invertY') }, { id: 'aimAssist', label: 'AIM ASSIST', choices: onOff('aimAssist') }, { id: 'rumble', label: 'RUMBLE', choices: onOff('rumble') },\")\ns=s.replace(\"format: (v) => (v === 'ps' ? 'PLAYSTATION' : 'XBOX') }, small: true },\",\"format: (v) => (v === 'ps' ? 'PLAYSTATION' : 'XBOX') } },\")\nopen(p,'w').write(s)\nEOF\necho \"- [C] Squads made by scripts survived a new game and hunted the player at the Cut on day one.\" >> tests/ISSUES.md\necho \"- Patrols never started in the campaign; roads were empty.\" >> tests/ISSUES.md\ntimeout 590 node tests/run.mjs --only playthrough 2>&1 | grep -v '^`\\|WebGPURenderer\\|^file:' | grep -v 'pixel-engine.js:' | cut -c1-400 | grep -v '^    at' | tail -10","description":"Apply the feature pass and rerun the playthrough","timeout":595000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":603,"cache_read_input_tokens":825042,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":603},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"caa9dfb7-933f-47d9-a647-bf216ca89676","timestamp":"2026-11-06T01:23:25.485Z","request_id":"req_011CgkoAJ9F67AWGUbV1yemf","wire_tool_inputs":{"toolu_01MSCw5GSpC6AbZ8NR9T2TQf":{"command":"set -e\npython3 - <<'PY'\np='/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-162027__x07393c/work/PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [ ] 7 Shell: written, needs systems tests (menus by pad/kbd/mouse, attract, touch gate)\\n- [ ] 8 Multiplayer: net/round.js + session.js written; hub suite needs re-run with the real game; link suite to write\",\"- [x] 7 Shell done, systems suite covers it\\n- [x] 8 Multiplayer done: hub + link suites pass\")\ns=s.replace(\"- Remaining test suites to write: static, systems, replay, browser, link. tools/ holds throwaway helpers (delete at ship).\\n\",\"- All 7 suites exist and pass (static fails only on blank About answers until they are written at the end). tools/ holds throwaway helpers (delete at ship; keep tools/build.mjs).\\n- tools/shots.mjs names: title main day rust town map nightfire truckmap cab rack talk surgery surgery2 fight dev pause ledger ending harrow fort mine river rescue\\n- Feature pass in progress (plan gaps: smoke column, dust, dodge, muzzle flash, hut lights, refugee line, drivers, surrender/throw clips, patrol start, guarded cases, temp squads on reset).\\n\")\nopen(p,'w').write(s)\nPY\npython3 - <<'EOF'\n# ---- actors: temp squads, guarded cases, towers, surrender, throw, reload, dodge, sit ----\np='src/actors/actors.js'; s=open(p).read()\na=\"\"\"    for (const [key, p] of Object.entries(POSTS)) this.addSquadDef(key, { faction: p.faction, n: p.n, at: p.at, post: p, yaw: p.yaw });\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    for (const [key, p] of Object.entries(POSTS)) this.addSquadDef(key, { faction: p.faction, n: p.n, at: p.at, post: p, yaw: p.yaw });\n    // Guarded cases: three men and a shed, for one case's worth of trouble.\n    for (const c of CASES) if (c.hint === 'guarded shed') this.addSquadDef(`case-${c.id}`, { faction: c.at[0] < 0 ? 'concord' : 'harvest', n: 3, at: c.at, noReman: true });\n    for (const sq of this.squads.values()) sq.permanent = true;\"\"\")\ns=s.replace(\"import { SITES, POSTS } from '../content/sites.js';\",\"import { SITES, POSTS, CASES } from '../content/sites.js';\")\na=\"\"\"    for (const sq of this.squads.values()) { sq.members = []; sq.alive = sq.def.n; sq.clearedAt = null; sq.live = false; sq.angry = false; sq.disabled = false; sq.forceLive = false; }\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    for (const [k, sq] of this.squads) { if (!sq.permanent) { this.squads.delete(k); continue; } sq.members = []; sq.alive = sq.def.n; sq.clearedAt = null; sq.live = false; sq.angry = false; sq.disabled = false; sq.forceLive = false; }\"\"\")\ns=s.replace(\"\"\"const BUBBLE = 260, BUBBLE_OUT = 300;\"\"\",\"\"\"const BUBBLE = 260, BUBBLE_OUT = 300;\nconst MILE_FORTY = SITES['mile-forty'].at;\"\"\")\na=\"\"\"    return this.buddies.find((b) => b.met && !b.dead && g.clock.abs >= b.spentUntil && g.clock.abs >= b.woundedUntil) ?? null;\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    // They come from the bar. Ines drives further than anyone else will.\n    const f = g.player.feet, d = Math.hypot(f.x - MILE_FORTY[0], f.z - MILE_FORTY[1]);\n    return this.buddies.find((b) => b.met && !b.dead && g.clock.abs >= b.spentUntil && g.clock.abs >= b.woundedUntil && (b.active || d <= b.def.rescueR)) ?? null;\"\"\")\nopen(p,'w').write(s)\n\np='src/actors/buddy.js'; s=open(p).read()\ns=s.replace(\"perk: 'range', voice: 'ines', rescueR: 500 }\",\"perk: 'range', voice: 'ines', rescueR: 900 }\")\ns=s.replace(\"perk: 'charges', voice: 'dov', rescueR: 300 }\",\"perk: 'charges', voice: 'dov', rescueR: 420 }\")\ns=s.replace(\"perk: 'medic', voice: 'mags', rescueR: 300 }\",\"perk: 'medic', voice: 'mags', rescueR: 420 }\")\nopen(p,'w').write(s)\n\np='src/actors/soldier.js'; s=open(p).read()\na=\"\"\"    b.sequence('dodge', b.condition('grenade?', (o) => o.dodgeT > 0), b.action('dodge', (o, dt) => o.brainDodge(dt))),\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    b.sequence('dodge', b.condition('grenade?', (o) => o.dodgeT > 0), b.action('dodge', (o, dt) => o.brainDodge(dt))),\n    b.sequence('surrender', b.condition('hands up?', (o) => o.surrenderT > 0), b.action('wait', (o, dt) => o.brainSurrender(dt))),\"\"\")\n# surrender trigger and reload in hurt\na=\"\"\"    this.view?.anim.shot('HitReact', 1.2);\n    g.voice.bark(this, 'hit');\n    if (this.state !== 'alert') this.state = 'alert';\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    this.view?.anim.shot('HitReact', 1.2);\n    g.voice.bark(this, 'hit');\n    if (this.state !== 'alert') this.state = 'alert';\n    // The last man, nearly gone, sometimes tries it. He gets to keep trying for a few seconds.\n    if (!g.round && this.squad && this.squad.alive === 1 && this.hp < this.maxHp * 0.35 && !this.triedSurrender && g.rng.ai.chance(0.4)) { this.triedSurrender = true; this.surrenderT = 7; this.burstLeft = 0; this.view?.anim.set('Surrender', 'Surrender', 0.15); g.events.emit('surrender', this); g.say(this.faction, 'ENOUGH! ENOUGH, I AM ONLY PAID BY THE MONTH!', 2.5); g.voice.say(this.faction, 'ENOUGH I AM ONLY PAID BY THE MONTH', { gain: 0.8 }); }\"\"\")\na=\"\"\"  brainDodge(dt) {\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"  brainSurrender(dt) {\n    this.surrenderT -= dt; this.goal = null; this.moveWanted = 0;\n    if (this.view) this.view.anim.set('Surrender', 'Surrender');\n    return 'running';\n  }\n  brainDodge(dt) {\"\"\")\n# soldier bottle throw + reload pauses in combat\na=\"\"\"        if (this.role === 'rocket' && g.rng.ai.chance(0.5)) { this.fireRocket(); this.burstLeft = 0; this.burstPause = 6; }\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"        if (this.role === 'rocket' && g.rng.ai.chance(0.5)) { this.fireRocket(); this.burstLeft = 0; this.burstPause = 6; }\n        else if (this.faction === 'harvest' && dist < 24 && dist > 7 && g.rng.ai.chance(0.1)) { this.throwBottle(lk); this.burstLeft = 0; this.burstPause = 3; }\n        else if (g.rng.ai.chance(0.14)) { this.view?.anim.shot('Reload'); this.burstLeft = 0; this.burstPause = 1.5; g.sfx.at('gun-mag', this.x, this.z, { max: 30, volume: 0.6 }); }\"\"\")\na=\"\"\"  fireRocket() {\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"  /** The Harvest throw bottles: everyone can start a fire. */\n  throwBottle(lk) {\n    const g = this.game, ox = this.x, oy = this.y + 1.6, oz = this.z;\n    const dx = lk.x - ox, dz = lk.z - oz, d = Math.hypot(dx, dz) || 1;\n    this.view?.anim.shot('ThrowBottle');\n    g.after(0.3, () => { if (!this.dead) g.projectiles.spawn('bottle', ox + (dx / d), oy, oz + (dz / d), dx / d, 0.32, dz / d, this, { speed: Math.min(20, 8 + d * 0.55) }); });\n    g.events.emit('soldier-throw', this);\n  }\n  fireRocket() {\"\"\")\n# sit by day\na=\"\"\"      else this.yawGoal = g.rng.ai.range(-3.14, 3.14);\n    }\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"      else { this.yawGoal = g.rng.ai.range(-3.14, 3.14); this.sitting = !this.fixed && this.duty === 'guard' && g.rng.ai.chance(0.2); if (this.sitting) this.dutyT = g.rng.ai.range(12, 26); }\n    }\"\"\")\na=\"\"\"      if (this.sleeping) this.view.anim.set('Sleep', 'Sleep');\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"      if (this.sleeping) this.view.anim.set('Sleep', 'Sleep');\n      else if (this.sitting && !this.goal) this.view.anim.set('Sit', 'Sit');\"\"\")\ns=s.replace(\"this.fireCool = 0; this.jamT = 0; this.dutyT = g.rng.ai.range(0, 3); this.sleeping = false; this.reactT = 0;\",\"this.fireCool = 0; this.jamT = 0; this.dutyT = g.rng.ai.range(0, 3); this.sleeping = false; this.sitting = false; this.reactT = 0; this.surrenderT = 0; this.triedSurrender = false; this.fireCheckT = 0; this.cachedTarget = null; this.targetInfo = null;\")\n# towers\nopen(p,'w').write(s)\n\np='src/content/sites.js'; s=open(p).read()\ns=s.replace(\"squad: { faction: 'concord', n: 12 },\\n    npcs: [{ who: 'vance'\",\"squad: { faction: 'concord', n: 12, tower: [34, 34] },\\n    npcs: [{ who: 'vance'\")\ns=s.replace(\"squad: { faction: 'harvest', n: 12 },\\n    npcs: [{ who: 'ansa'\",\"squad: { faction: 'harvest', n: 12, tower: [40, -30] },\\n    npcs: [{ who: 'ansa'\")\ns=s.replace(\"squad: { faction: 'harvest', n: 8 },\\n    tanks:\",\"squad: { faction: 'harvest', n: 8, tower: [30, 16] },\\n    tanks:\")\ns=s.replace(\"['oil-drum', -3, -9, 0], ['radio-mast', -22, -2, 0]]\",\"['oil-drum', -3, -9, 0], ['radio-mast', -22, -2, 0], ['campfire', -18, 2, 0]]\")\ns=s.replace(\"sb(18, -14, 45), ['oil-drum', -6, 2, 0], ['crate', 4, 2, 0]]\",\"sb(18, -14, 45), ['oil-drum', -6, 2, 0], ['crate', 4, 2, 0], ['campfire', 8, 8, 0]]\")\nopen(p,'w').write(s)\n\n# ---- projectiles make soldiers dodge ----\np='src/combat/projectiles.js'; s=open(p).read()\na=\"\"\"      p.x += dx; p.y += dy; p.z += dz;\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"      p.x += dx; p.y += dy; p.z += dz;\n      if ((p.kind === 'rocket' || p.kind === 'bottle') && p.who === 'player' && g.tick % 6 === 0) {\n        for (const so of g.actors.soldiers) {\n          if (!so.active || so.dead || so.dodgeT > 0) continue;\n          if (Math.hypot(so.x - p.x, so.z - p.z) < 9) { so.dodgeT = 1; so.dodgeDir = Math.atan2(so.x - p.x, so.z - p.z) + (so.id % 2 ? 0.8 : -0.8); g.voice.bark(so, 'fire'); }\n        }\n      }\"\"\")\nopen(p,'w').write(s)\n\n# ---- vm muzzle flash ----\np='src/combat/viewmodel.js'; s=open(p).read()\ns=s.replace(\"import { THREE, buildModel, compileClips, setLookLayer, toonMaterial, PALETTE } from '../../pixel-engine.js';\",\"import { THREE, buildModel, compileClips, setLookLayer, toonMaterial, glowMaterial, PALETTE } from '../../pixel-engine.js';\")\na=\"\"\"    // The map: DataTexture plane, drawn by world/map-texture.js, under MapJ.\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    // Muzzle flash: a hot little star at the end of whatever is in your hand.\n    const flash = new THREE.Group();\n    for (const [w, h, d, c] of [[0.1, 0.03, 0.03, PALETTE.white], [0.03, 0.1, 0.03, PALETTE.sand], [0.05, 0.05, 0.14, PALETTE.orange]]) { const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), glowMaterial(c)); m.frustumCulled = false; m.castShadow = false; flash.add(m); }\n    flash.visible = false;\n    setLookLayer(flash, 'actors');\n    this.named.Weapon.add(flash);\n    this.flashObj = flash;\n    // The map: DataTexture plane, drawn by world/map-texture.js, under MapJ.\"\"\")\na=\"\"\"    this.kick = 1; this.flash = 1;\n    const id = this.gunId;\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    this.kick = 1; this.flash = 1;\n    const id = this.gunId;\n    const parts = GUN_PARTS[id];\n    if (parts?.muzzle && !WEAPONS[id]?.stream) { this.flashObj.position.set(...parts.muzzle); this.flashObj.rotation.z = this.game.rng.fx.range(0, 3); this.flashObj.visible = true; }\"\"\")\na=\"\"\"    this.flash = Math.max(0, this.flash - dt * 12);\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    this.flash = Math.max(0, this.flash - dt * 12);\n    if (this.flash <= 0.4 && this.flashObj) this.flashObj.visible = false;\"\"\")\nopen(p,'w').write(s)\n\n# ---- smoke column, dust, cook-off on catching ----\np='src/world/fireview.js'; s=open(p).read()\na=\"\"\"    // Up to 3 lights, by size.\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    // A column of smoke visible across the map for a game day: what you did at the depot.\n    const st = g.story;\n    if (st?.smokeUntil > g.clock.abs && st.smokeAt && (this.columnT = (this.columnT ?? 0) - dt) <= 0) {\n      this.columnT = 0.25;\n      const [sx, sz] = st.smokeAt;\n      ctx.particles.burst('fire-smoke', [sx, g.world.heightAt(sx, sz) + 6, sz], { count: 5, direction: [g.wind.vx * 0.1, 1, g.wind.vz * 0.1], speed: 2 });\n    }\n    // Up to 3 lights, by size.\"\"\")\nopen(p,'w').write(s)\n\np='src/world/sky.js'; s=open(p).read()\na=\"\"\"    if (this.rain && this.storm) {\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    if (this.dust && (this.dustT = (this.dustT ?? 0) - dt) <= 0) {\n      this.dustT = 0.06;\n      const w = this.game.wind;\n      ctx.particles.burst('dust-wind', [camPos.x - w.x * 18, camPos.y, camPos.z - w.z * 18], { direction: [w.x, 0.04, w.z], speed: 1.6 });\n    }\n    if (this.rain && this.storm) {\"\"\")\nopen(p,'w').write(s)\n\np='src/world/world.js'; s=open(p).read()\na=\"\"\"    fire.onIgnite = (id, src) => { g.grass.burnCell(id); g.fireView.onIgnite(id); this.scorchTreesIn(id); g.events.emit('fire-lit', id, src); };\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    fire.onIgnite = (id, src) => { g.grass.burnCell(id); g.fireView.onIgnite(id); this.scorchTreesIn(id); this.cookOff(id); g.events.emit('fire-lit', id, src); };\"\"\")\na=\"\"\"    fire.onBurnt = (id) => { this.paintFireCell(id, 'burnt'); g.grass.burnCell(id); this.burnTreesIn(id); g.fireView.onDone(id); this.cookOff(id); };\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    fire.onBurnt = (