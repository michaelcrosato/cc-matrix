int[0], shoulder[1] - _joint[1], shoulder[2] - _joint[2]);\n}\"\"\"+s[b:]\ns=s.replace(\"import { THREE, buildModel, setLookLayer, spatialize } from '../../pixel-engine.js';\",\"import { THREE, buildModel, setLookLayer, spatialize, twoBoneIK } from '../../pixel-engine.js';\")\ns=s.replace(\"import { CABS } from '../art/viewmodels.js';\",\"import { CABS, CAB_ARM } from '../art/viewmodels.js';\")\ns=s.replace(\"this.cabArmL = part('ArmL'); this.cabArmR = part('ArmR');\",\"this.cabArmL = part('ArmL'); this.cabArmR = part('ArmR'); this.cabUpperL = part('UpperL'); this.cabUpperR = part('UpperR');\")\nx=\"      reach(cab.cabArmL, cab.cabGripL.getWorldPosition(_hand));\\n\"\nassert x in s\ns=s.replace(x,\"      reach(cab.cab.object, cab.cabUpperL, cab.cabArmL, CAB_ARM.shoulderL, CAB_ARM.poleL, cab.cabGripL.getWorldPosition(_hand));\\n\")\nx=\"      reach(cab.cabArmR, _hand);\\n\"\nassert x in s\ns=s.replace(x,\"      reach(cab.cab.object, cab.cabUpperR, cab.cabArmR, CAB_ARM.shoulderR, CAB_ARM.poleR, _hand);\\n\")\n# ---- a driver among the crew ----\nx=\"const s = g.actors.makeSoldier(ctx, { faction: v.faction, role: 'rifle', x: v.x + (i ? 2 : -2), z: v.z + 1.5, yaw: v.yaw, squad: sq });\"\nassert x in s\ns=s.replace(x,\"const s = g.actors.makeSoldier(ctx, { faction: v.faction, role: i ? 'rifle' : 'driver', x: v.x + (i ? 2 : -2), z: v.z + 1.5, yaw: v.yaw, squad: sq });\\n      if (!i) s.vehicle = v;\")\nopen('src/vehicles/driving.js','w').write(s)\n# ---- soldiers: driver stays by his truck, the shove, the limp ----\npatch('src/actors/soldier.js',[\n(\"\"\"    this.faction = faction; this.role = role;\"\"\",\"\"\"    this.vehicle = null; this.shoveT = 0;\n    this.faction = faction; this.role = role;\"\"\"),\n(\"\"\"    this.moveWanted = this.goal ? (this.role === 'mg' ? 3 : 4.6) : 0;\"\"\",\"\"\"    // The driver fights from beside his truck.\n    if (this.role === 'driver' && this.vehicle?.alive && Math.hypot(this.vehicle.x - this.x, this.vehicle.z - this.z) > 9) this.setGoal(this.vehicle.x + 2, this.vehicle.z + 2);\n    this.moveWanted = this.goal ? (this.role === 'mg' ? 3 : 4.6) : 0;\"\"\"),\n(\"\"\"    // Every other man drops to a knee when he has stopped to shoot.\"\"\",\"\"\"    // Within arm's reach he shoves you off with the rifle.\n    this.shoveT -= dt;\n    if (!g.round && tgt?.kind === 'player' && dist < 2.2 && this.sees && this.reactT <= 0 && this.shoveT <= 0) {\n      this.shoveT = 2.5; this.burstLeft = 0; this.burstPause = 0.8;\n      this.view?.anim.shot('Push');\n      g.sfx.at('grunt', this.x, this.z, { max: 30, volume: 0.8 });\n      g.body.hurt(6, 'melee', [this.x, this.z]);\n      g.ctx.engine.shake.add(0.25);\n    }\n    // Every other man drops to a knee when he has stopped to shoot.\"\"\"),\n(\"\"\"    this.view?.anim.set(this.moveWanted > 0 ? (this.id % 2 === 0 ? 'CrouchWalk' : 'Walk') : 'Idle', 'AimIdle');\"\"\",\"\"\"    const limping = this.hp < this.maxHp * 0.35;\n    this.view?.anim.set(this.moveWanted > 0 ? (limping ? 'Limp' : this.id % 2 === 0 ? 'CrouchWalk' : 'Walk') : 'Idle', 'AimIdle');\"\"\"),\n(\"\"\"      else if (this.moveWanted > 0) this.view.anim.set('Walk', 'Walk');\"\"\",\"\"\"      else if (this.moveWanted > 0) { const gait = this.hp < this.maxHp * 0.35 ? 'Limp' : 'Walk'; this.view.anim.set(gait, gait); }\"\"\"),\n])\ns=open('src/art/clips.js').read()\ns=s.replace(\"export const PEOPLE_CLIPS = [\\n\",\"\"\"// A planted, procedural gait for anyone badly hurt: short steps, a lean, the arm held in.\nconst limp = gaitClip({ ...HERO_RIG, spine: undefined }, { name: 'Limp', frames: 36, speed: 1.5, stance: 0.64, hip: -0.035, bob: 0.018, lift: 0.03, lean: 9, sway: 5, head: 6, arms: { swing: 9, elbow: 22 } });\nexport const PEOPLE_CLIPS = [\n  limp,\n\"\"\",1)\ns=s.replace(\"const R = [0, 0, 0];\",\"import { gaitClip, HERO_RIG } from '../../pixel-engine.js';\\nconst R = [0, 0, 0];\",1)\nopen('src/art/clips.js','w').write(s)\n# ---- the landing dip, on a spring, in the view group ----\npatch('src/actors/player.js',[\n(\"\"\"if (drop > 1.2) { this.landDip = clamp(drop * 0.05, 0.03, 0.2); g.sfx.play('land', { volume: 0.5 }); }\"\"\",\"\"\"if (drop > 1.2) { this.landSpring.kick(-clamp(drop * 0.35, 0.4, 2.4)); g.sfx.play('land', { volume: 0.5 }); }\"\"\"),\n(\"\"\"    this.landDip = lerp(this.landDip, 0, 1 - Math.exp(-dt * 8));\n    this.eye.set(feet.x, feet.y + this.eyeH - this.landDip - (this.wading ? 0.3 : 0), feet.z);\"\"\",\"\"\"    // The landing dips what you hold, not your head.\n    this.landSpring.update(dt);\n    this.landDip = -this.landSpring.value;\n    this.eye.set(feet.x, feet.y + this.eyeH - (this.wading ? 0.3 : 0), feet.z);\"\"\"),\n(\"\"\"landDip = 0;\"\"\",\"\"\"landDip = 0; landSpring = Object.assign(new Squash(), { stiffness: 90, damping: 12 });\"\"\"),\n])\npatch('src/combat/viewmodel.js',[(\"\"\"    this.group.rotation.set(this.kick * 0.09 * hardness, 0, Math.sin(t * 0.9) * 0.012 * fever);\"\"\",\"\"\"    this.group.position.y -= g.player.landDip;\n    this.group.rotation.set(this.kick * 0.09 * hardness, 0, Math.sin(t * 0.9) * 0.012 * fever);\"\"\")])\n# ---- flags that read the wind; people boarding; rocks on the ridge ----\ns=open('src/world/world.js').read()\nfor a,b in [\n(\"\"\"      e.id = id; e.site = site;\n\"\"\",\"\"\"      e.id = id; e.site = site;\n      if (id === 'flag-pole' && this.game.views) this.addFlag(ctx, e, site);\n\"\"\"),\n(\"\"\"  mergeOrAdd(list) {\"\"\",\"\"\"  /** A flag on a spring chain: it hangs in still air and streams downwind, so a pole reads the wind from far off. */\n  addFlag(ctx, e, site) {\n    const chain = new SpringChain({ segments: 6, length: 0.36, stiffness: 8, keep: 0.9, gravity: 6 });\n    const root = [e.x, e.y + 8.7, e.z], box = new THREE.BoxGeometry(1, 0.8, 0.04);\n    const mat = toonMaterial(site.faction === 'harvest' ? PALETTE.red : PALETTE.white);\n    const meshes = [];\n    for (let i = 0; i < 6; i++) { const m = new Mesh(box, mat); m.castShadow = false; ctx.scene.add(m); meshes.push(m); }\n    chain.reset(root, [[1, 0, 0], [0, 1, 0], [0, 0, 1]]);\n    this.flags.push({ chain, root, meshes, x: e.x, z: e.z });\n  }\n  mergeOrAdd(list) {\"\"\"),\n(\"\"\"colliderTrees = []; cloths = [];\"\"\",\"\"\"colliderTrees = []; cloths = []; flags = [];\"\"\"),\n(\"\"\"    this.flushPaint(dt);\n  }\n  /** Story dressing. */\"\"\",\"\"\"    for (const f of this.flags) {\n      if (Math.hypot(f.x - g.camPos.x, f.z - g.camPos.z) > 260) continue;\n      const fw = [-g.wind.x, 0, -g.wind.z];      // the chain rests along -forward, so forward points upwind\n      f.chain.o.stiffness = 2 + g.wind.speed * 2;\n      f.chain.update(Math.min(dt, 1 / 30), f.root, [[fw[2], 0, -fw[0]], [0, 1, 0], fw]);\n      f.meshes.forEach((m, i) => {\n        const a = f.chain.points[i], b = f.chain.points[i + 1];\n        _flagDir.set(b[0] - a[0], b[1] - a[1], b[2] - a[2]);\n        const l = _flagDir.length() || 1;\n        m.position.set((a[0] + b[0]) / 2, (a[1] + b[1]) / 2 - 0.4, (a[2] + b[2]) / 2);\n        m.quaternion.setFromUnitVectors(_flagX, _flagDir.multiplyScalar(1 / l));\n        m.scale.x = l + 0.02;\n      });\n    }\n    if (this.crowd) for (const c of this.crowd) if (c.climbing > 0 && (c.climbing -= dt) <= 0) { c.boarded = true; c.p.object.visible = false; }\n    this.flushPaint(dt);\n  }\n  /** Story dressing. */\"\"\"),\n(\"\"\"  setCrowdAtPlatform(on) {\"\"\",\"\"\"  /** M8: as the platform clock runs, people climb aboard and are gone. */\n  boardCrowd(done) {\n    for (const c of this.crowdPool()) if (!c.boarded && !c.climbing && done >= (c.i + 1) / 17) { c.climbing = 1.6; c.p.object.rotation.y = 0; c.p.anim.once('Climb'); }\n  }\n  setCrowdAtPlatform(on) {\"\"\"),\n(\"\"\"      c.p.object.visible = on;\n      if (on) {\"\"\",\"\"\"      c.p.object.visible = on;\n      if (on) {\n        c.climbing = 0; c.boarded = false;\"\"\"),\n(\"\"\"const scatterSet = (id, cap, count, want, solid, palette) => {\n      const set = new InstanceSet(ctx.scene, id, cap, { palette });\"\"\",\"\"\"const scatterSet = (id, cap, count, want, solid, palette, params) => {\n      const set = new InstanceSet(ctx.scene, id, cap, { palette, params });\"\"\"),\n(\"\"\"    this.dead = scatterSet('dead-tree', 40, 34, (k) => k === K.GRASS || k === K.SALT, 0.2);\"\"\",\"\"\"    this.dead = scatterSet('dead-tree', 40, 34, (k) => k === K.GRASS || k === K.SALT, 0.2);\n    this.rocks = scatterSet('rock', 170, 150, (k, x, z) => k === K.ROCK || (Math.hypot(x + 130, z + 520) < 240 && k !== K.WATER && k !== K.ROAD && k !== K.TRACK), 0, undefined, { size: 0.9 });\"\"\"),\n]:\n    if a not in s: print('MISSING world',a[:80]); continue\n    s=s.replace(a,b,1)\ns=s.replace(\"NavGrid, Rng, clothGrid,\",\"NavGrid, Rng, SpringChain, clothGrid,\",1)\nif '_flagDir' in s and 'const _flagDir' not in s:\n    i=s.index(\"const DYNAMIC = new Set(\")\n    s=s[:i]+\"const _flagDir = new THREE.Vector3(), _flagX = new THREE.Vector3(1, 0, 0);\\n\"+s[i:]\nopen('src/world/world.js','w').write(s)\npatch('src/missions/scripts.js',[\n(\"\"\"      g.world.setCrowdAtPlatform(true);\n      g.shelling =\"\"\",\"\"\"      g.world.setCrowdAtPlatform(true);\n      g.train.place(g.train.sAt(s.at[0], s.at[1] + 30));\n      g.shelling =\"\"\"),\n(\"\"\"        if (nearby || g.player.seat) g.holdT -= 1 / 60;\"\"\",\"\"\"        if (nearby || g.player.seat) g.holdT -= 1 / 60;\n        if (g.holdT < 120) g.world.boardCrowd(1 - g.holdT / 120);\"\"\"),\n])\n# ---- thorn bushes are the library's, recoloured ----\npatch('src/art/models.js',[(\"\"\"parts: [{ ball: [1.5, 0.8, 1.3], at: [0, 0.42, 0], c: 'leaf' }, { ball: [0.8, 0.5, 0.8], at: [0.3, 0.7, 0.2], c: 'leaf2' }, { cyl: [0.14, 0.2, 0.14], at: [0, 0.1, 0], c: 'bark' }] });\"\"\",\"\"\"parts: [{ use: 'bush', params: { w: 1.6 } }, { cyl: [0.14, 0.2, 0.14], at: [0, 0.1, 0], c: 'bark' }] });\"\"\")])\npatch('src/content/sites.js',[\n(\"\"\", ['rock', 52, 30, 0], ['bush', -48, -22, 0]] },\"\"\",\"\"\"] },\"\"\"),\n])\ns=open('src/content/sites.js').read()\n