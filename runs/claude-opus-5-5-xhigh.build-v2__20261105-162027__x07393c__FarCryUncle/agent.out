ws the field of view and the art width. */\n  fit() {\n    const g = this.game, cam = g.ctx.camera.camera, hud = g.ctx.hud;\n    const artW = hud.width || 480;\n    const visibleW = 0.5 / (MW / artW);\n    const dist = visibleW / (2 * Math.tan((cam.fov * Math.PI) / 360) * (artW / (hud.height || 270)));\n    this.plane.position.z = 0.42 - dist;\n  }\n  raise(on) {\n    const g = this.game;\n    if (on === this.up) return;\n    this.up = on;\n    if (on) this.fit();\"\"\")\nopen(p,'w').write(s)\np='src/ui/hud.js'; s=open(p).read()\na=\"\"\"    if (g.hasPlayer && !g.scene.active) {\n      if (show) { this.vitals(h); this.ammo(h); }\n      this.reticle(h, ctx);\n    }\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    if (g.hasPlayer && !g.scene.active && g.mode !== 'title' && g.mode !== 'lobby' && g.mode !== 'campaign-loading') {\n      if (show) { this.vitals(h); this.ammo(h); }\n      this.reticle(h, ctx);\n    }\"\"\")\nopen(p,'w').write(s)\np='src/world/world.js'; s=open(p).read()\ns=s.replace(\"case K.DIRT: return h > 0.72 ? P.plum : P.red;\",\"case K.DIRT: return h > 0.93 ? P.plum : (h > 0.55 ? P.orange : P.red);\")\ns=s.replace(\"case K.ROAD: return h > 0.84 ? P.plum : P.red;\",\"case K.ROAD: return h > 0.92 ? P.plum : P.red;\")\nopen(p,'w').write(s)\np='src/game.js'; s=open(p).read()\na=\"\"\"    const a = this.titleT * 0.03;\n    const y = this.world.heightAt(s.at[0] + 130, s.at[1] + 90) + 14;\n    this.cam.override = { position: [s.at[0] + Math.cos(a) * 170, y + Math.sin(a * 2) * 3, s.at[1] + Math.sin(a) * 120 + 40], target: [s.at[0], y - 6, s.at[1]] };\"\"\"\nassert a in s\ns=s.replace(a,\"\"\"    // A slow fixed camera over the burning grass.\n    const a = 0.65 + Math.sin(this.titleT * 0.04) * 0.2;\n    const px = s.at[0] - 40 + Math.cos(a) * 118, pz = s.at[1] + Math.sin(a) * 118;\n    const y = this.world.heightAt(px, pz) + 3.2;\n    this.cam.override = { position: [px, y, pz], target: [s.at[0] - 62, y + 1.2, s.at[1]] };\"\"\")\na=\"\"\"    this.titleIgnite(s)