{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkfKkVbBWLaESVu5X3Me","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SYqiMfznnABDmJhecYntt6","name":"Bash","input":{"command":"set -e\ncat > src/world/world.js <<'EOF'\n// The Kettle on screen: terrain mesh and its paint, water, rails, bridges, sites, scatter, the nav grid.\nimport { THREE, Terrain, WaterSurface, WAVES_CALM, buildModel, addModelColliders, mergeStaticMeshes, setLookLayer, PALETTE, NavGrid, Rng, clothGrid, SoftMesh, toonMaterial, swayObject, WindUniforms } from '../../pixel-engine.js';\nimport { MODELS } from '../art/models.js';\nimport { Ground, K, CELLS, CELL, HALF, polyLength, pointAlong, distToPolyline } from './ground.js';\nimport { F, FN, FCELL, S } from './fire.js';\nimport { InstanceSet } from './instances.js';\nimport { ROADS, RAIL, RIVER, RIVER_Y, BRIDGES, RAIL_BRIDGE, STRIPS } from '../content/roads.js';\nimport { SITES, POSTS, TRIGS, CASES, HALTS } from '../content/sites.js';\nimport { hash2, clamp, smooth } from '../core/rng.js';\nconst { Color, Vector3, Mesh, Group, Object3D } = THREE;\n\nconst col = (hex) => { const c = new Color(hex); return [c.r, c.g, c.b]; };\nconst P = Object.fromEntries(Object.entries(PALETTE).map(([k, v]) => [k, col(v)]));\nconst DYNAMIC = new Set(['boom-gate', 'post-cage', 'fuel-tank', 'oil-drum', 'table-lamp']);\nconst BURNS = new Set(['shack', 'hut', 'market-stall', 'clinic-tent', 'bar', 'schoolroom']);\nexport const EXPLOSIVE = { 'oil-drum': { radius: 4, damage: 90, hp: 30, fire: 5 }, 'fuel-tank': { radius: 13, damage: 300, hp: 80, fire: 14 } };\n\nexport class World {\n  explosives = []; trees = []; dirtyCols = new Set(); uploadT = 0; placed = []; byTag = new Map(); colliderTrees = []; cloths = [];\n  constructor(game) { this.game = game; this.ground = game.ground; }\n  heightAt(x, z) { return this.land.heightAt(x, z); }\n  build(ctx) {\n    const { scene, physics } = ctx, g = this.game, ground = this.ground;\n    this.land = new Terrain({ size: [1280, 1280], cells: [CELLS, CELLS] });\n    const N = CELLS + 1;\n    this.land.generate((x, z) => ground.h[Math.round((x + HALF) / CELL) + Math.round((z + HALF) / CELL) * N]);\n    this.land.attach(physics);\n    this.land.mesh.receiveShadow = true;\n    scene.add(this.land.mesh);\n    this.colors = this.land.mesh.geometry.getAttribute('color');\n    this.baseColors = new Float32Array(CELLS * CELLS * 3);\n    this.paintBase();\n    this.buildWater(ctx);\n    this.buildRails(ctx);\n    this.buildBridges(ctx);\n    this.buildSites(ctx);\n    this.scatter(ctx);\n    this.buildNav();\n    // Paint fire events.\n    const { fire } = g;\n    fire.onBurnt = (id) => { this.paintFireCell(id, 'burnt'); g.grass.burnCell(id); this.burnTreesIn(id); g.fireView.onDone(id); this.cookOff(id); };\n    fire.onIgnite = (id, src) => { g.grass.burnCell(id); g.fireView.onIgnite(id); this.scorchTreesIn(id); g.events.emit('fire-lit', id, src); };\n    fire.onRegrow = (id) => { this.paintFireCell(id, 'green'); };\n    fire.onFresh = (id) => { this.paintFireCell(id, 'base'); this.unburnTreesIn(id); };\n  }\n  // ---- paint ----\n  baseColorOf(ix, iz) {\n    const k = this.ground.kind[ix + iz * CELLS], x = ix * CELL - HALF, z = iz * CELL - HALF;\n    const h = hash2(ix, iz);\n    const patch = this.ground.noise.n2(x * 0.018, z * 0.018);\n    switch (k) {\n      case K.GRASS: return patch + h * 0.5 > 0.42 ? P.orange : (h > 0.82 ? P.red : P.sand);\n      case K.CROP: return h > 0.5 ? P.sand : P.orange;\n      case K.WOOD: return h > 0.62 ? P.green : (patch > 0 ? P.teal : P.orange);\n      case K.BANK: return h > 0.35 ? P.green : P.teal;\n      case K.ROAD: return h > 0.84 ? P.plum : P.red;\n      case K.TRACK: return h > 0.5 ? P.red : P.plum;\n      case K.RAIL: return h > 0.5 ? P.slate : P.night;\n      case K.DIRT: return h > 0.72 ? P.plum : P.red;\n      case K.WATER: return P.navy;\n      case K.ROCK: return h > 0.8 ? P.slate : P.plum;\n      case K.SALT: return h > 0.22 ? P.white : P.mist;\n      case K.MINE: return h > 0.6 ? P.slate : (h > 0.25 ? P.plum : P.night);\n      default: return P.sand;\n    }\n  }\n  setCell(ix, iz, c) {\n    const base = 6 * (ix + iz * CELLS), a = this.colors;\n    for (let k = 0; k < 6; k++) a.setXYZ(base + k, c[0], c[1], c[2]);\n  }\n  paintBase() {\n    const a = this.baseColors;\n    for (let iz = 0; iz < CELLS; iz++) for (let ix = 0; ix < CELLS; ix++) {\n      const c = this.baseColorOf(ix, iz);\n      a.set(c, (ix + iz * CELLS) * 3);\n      this.setCell(ix, iz, c);\n    }\n    this.colors.clearUpdateRanges?.();\n    this.colors.needsUpdate = true;\n  }\n  paintFireCell(id, mode) {\n    const cx = id % FN, cz = (id / FN) | 0;\n    for (let dz = 0; dz < 2; dz++) for (let dx = 0; dx < 2; dx++) {\n      const ix = cx * 2 + dx, iz = cz * 2 + dz;\n      if (ix >= CELLS || iz >= CELLS) continue;\n      const h = hash2(ix + 3, iz + 11);\n      let c;\n      if (mode === 'burnt') c = h > 0.7 ? P.slate : (h > 0.3 ? P.night : P.ink);\n      else if (mode === 'green') c = h > 0.55 ? P.green : P.lime;\n      else { const i = (ix + iz * CELLS) * 3; c = [this.baseColors[i], this.baseColors[i + 1], this.baseColors[i + 2]]; }\n      this.setCell(ix, iz, c);\n      this.dirtyRow(ix, iz);\n    }\n  }\n  dirtyRow(ix, iz) { this.dirtyCols.add(ix + iz * CELLS); }\n  flushPaint(dt) {\n    this.uploadT -= dt;\n    if (!this.dirtyCols.size || this.uploadT > 0) return;\n    this.uploadT = 0.25;\n    const a = this.colors;\n    a.clearUpdateRanges?.();\n    if (this.dirtyCols.size > 2000) { a.needsUpdate = true; this.dirtyCols.clear(); return; }\n    for (const c of this.dirtyCols) a.addUpdateRange(c * 18, 18);\n    a.needsUpdate = true;\n    this.dirtyCols.clear();\n  }\n  // ---- static placement ----\n  place(id, x, z, turnDeg = 0, { y, palette, seed, params, list, collide = true, scale } = {}) {\n    const ctx = this.game.ctx;\n    const yy = y ?? this.heightAt(x, z);\n    const build = buildModel(id, { catalog: MODELS, palette, seed, params });\n    const yaw = (turnDeg * Math.PI) / 180;\n    build.object.position.set(x, yy, z);\n    build.object.rotation.y = yaw;\n    if (scale) build.object.scale.setScalar(scale);\n    build.object.updateMatrixWorld(true);\n    build.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });\n    let colliders = [];\n    if (collide) colliders = addModelColliders(ctx.physics, build, [x, yy, z], yaw);\n    (list ?? this.placed).push(build.object);\n    return { build, object: build.object, x, y: yy, z, yaw, colliders };\n  }\n  addDynamic(ctx, entry) { ctx.scene.add(entry.object); return entry; }\n  placeSiteProps(ctx, site, statics) {\n    for (const [id, dx, dz, turn, opts] of site.props) {\n      const x = site.at[0] + dx, z = site.at[1] + dz;\n      const dyn = DYNAMIC.has(id);\n      const e = this.place(id, x, z, turn, { ...opts, list: dyn ? [] : statics });\n      if (dyn) this.addDynamic(ctx, e);\n      if (EXPLOSIVE[id]) this.addExplosive(id, e);\n      if (BURNS.has(id)) this.game.fire.setFuel(x, z, F.BUILDING);\n      e.id = id; e.site = site;\n      if (!this.byTag.has(id)) this.byTag.set(id, []);\n      this.byTag.get(id).push(e);\n      this.footprints.push(e);\n      if (id === 'table-lamp' && e.build.light) { /* lit when Harrow sits there */ e.lamp = e.build.light; }\n    }\n  }\n  addExplosive(id, e, tag) {\n    const def = EXPLOSIVE[id];\n    const ex = { id, tag, x: e.x, y: e.y, z: e.z, object: e.object, colliders: e.colliders, hp: def.hp, def, alive: true, entry: e };\n    this.explosives.push(ex);\n    for (const c of e.colliders) this.game.hitMap.set(c.handle, { kind: 'explosive', ref: ex });\n    return ex;\n  }\n  buildSites(ctx) {\n    this.footprints = [];\n    for (const [key, site] of Object.entries(SITES)) {\n      site.key = key;\n      const statics = [];\n      this.placeSiteProps(ctx, site, statics);\n      if (site.tanks) for (const [dx, dz] of site.tanks) {\n        const e = this.place('fuel-tank', site.at[0] + dx, site.at[1] + dz, 0, { list: [] });\n        this.addDynamic(ctx, e); this.addExplosive('fuel-tank', e, 'fuel-tank');\n      }\n      if (site.safe) {\n        const s = site.safe;\n        const put = (id, [dx, dz], t = 0) => { const e = this.place(id, site.at[0] + dx, site.at[1] + dz, t, { list: statics }); return e; };\n        put('safe-bed', s.bed, 90); put('safe-locker', s.locker, 0); put('ammo-crate', s.crate, 20); put('name-wall', s.wall, 0);\n      }\n      if (statics.length) ctx.scene.add(...this.mergeOrAdd(statics));\n    }\n    const postStatics = [];\n    this.postParts = {};\n    for (const [key, p] of Object.entries(POSTS)) {\n      const yawDeg = (p.yaw * 180) / Math.PI;\n      const fx = Math.sin(p.yaw), fz = Math.cos(p.yaw), rx = fz, rz = -fx;\n      const local = (a, b) => [p.at[0] + rx * a + fx * b, p.at[1] + rz * a + fz * b];\n      const [gx, gz] = local(0, 0);\n      const gate = this.place('boom-gate', gx, gz, yawDeg + 90, { list: [] }); this.addDynamic(ctx, gate);\n      this.postParts[key] = gate;\n      for (const [a, b, t] of [[-7, 6, 90], [7, 6, 90], [-7, -6, 90], [7, -6, 90]]) { const [x, z] = local(a, b); this.place('sandbag-run', x, z, yawDeg + t, { list: postStatics }); }\n      const [dx, dz] = local(5.5, 0); const drum = this.place('oil-drum', dx, dz, 0, { list: [] }); this.addDynamic(ctx, drum); this.addExplosive('oil-drum', drum);\n      const [cx, cz] = local(-9.5, 2); this.place('crate', cx, cz, 18, { list: postStatics });\n      const [mx, mz] = local(9, -2); this.addPostCloth(ctx, mx, mz);\n      this.place('signpost', mx + rx * 2, mz + rz * 2, yawDeg, { list: postStatics });\n    }\n    ctx.scene.add(...this.mergeOrAdd(postStatics));\n    // Trig pillars, rail halts, cases' props.\n    const misc = [];\n    this.trigEntries = {};\n    for (const t of TRIGS) this.trigEntries[t.id] = this.place('trig-pillar', t.at[0], t.at[1], 0, { list: misc });\n    for (const h of Object.values(HALTS)) { this.place('signal-mast', h.at[0] + 5, h.at[1] - 6, 0, { list: misc }); this.place('stool', h.at[0] - 3, h.at[1] - 5, 0, { list: misc, collide: false }); }\n    for (const c of CASES) {\n      const yaw = hash2(c.at[0], c.at[1]) * 360;\n      const off = c.prop === 'shack' ? 0 : 2.2;\n      this.place(c.prop, c.at[0] + off, c.at[1] + off * 0.6, yaw, { list: misc });\n      this.footprints.push({ build: { colliders: [] }, x: c.at[0], z: c.at[1] });\n      if (c.prop === 'shack') this.game.fire.setFuel(c.at[0], c.at[1], F.BUILDING);\n    }\n    this.place('handcar', -300 + 8, 100 - 4, 80, { list: misc });\n    ctx.scene.add(...this.mergeOrAdd(misc));\n    // Cloth on the Mile Forty mast too: you read the wind everywhere you stop.\n    this.addPostCloth(ctx, 22, 24);\n  }\n  addPostCloth(ctx, x, z) {\n    const y = this.heightAt(x, z);\n    const pole = new Mesh(new THREE.BoxGeometry(0.14, 3.4, 0.14), toonMaterial(PALETTE.night));\n    pole.position.set(x, y + 1.7, z); pole.castShadow = true;\n    ctx.scene.add(pole);\n    if (!this.game.views) return;\n    const cloth = clothGrid({ width: 1.4, height: 0.45, cols: 6, rows: 3, origin: [x, y + 3.3, z], pin: 'left' });\n    cloth.drag = 1.4; cloth.gust = 0.3;\n    const mesh = new SoftMesh(cloth, toonMaterial(PALETTE.red), { doubleSided: true });\n    mesh.castShadow = false;\n    ctx.scene.add(mesh);\n    this.cloths.push({ cloth, mesh, x, z });\n  }\n  mergeOrAdd(list) { for (const o of list) o.updateMatrixWorld(true); return mergeStaticMeshes(list); }\n  // ---- water, rails, bridges ----\n  buildWater(ctx) {\n    this.waters = [];\n    if (!this.game.views) return;\n    for (let i = 0; i + 1 < RIVER.length; i++) {\n      const [ax, az] = RIVER[i], [bx, bz] = RIVER[i + 1];\n      const len = Math.hypot(bx - ax, bz - az);\n      const w = new WaterSurface({ size: [15.5, len + 8], at: [0, 0, 0], segments: [4, Math.ceil(len / 8)], waves: WAVES_CALM, deep: PALETTE.navy, shallow: PALETTE.teal, foam: PALETTE.mist, opacity: 1 });\n      w.position.set((ax + bx) / 2, RIVER_Y, (az + bz) / 2);\n      w.rotation.y = Math.atan2(bx - ax, bz - az);\n      w.castShadow = false;\n      ctx.scene.add(w);\n      this.waters.push(w);\n    }\n  }\n  buildRails(ctx) {\n    const pieces = [];\n    for (const pts of Object.values(RAIL)) {\n      const L = polyLength(pts), n = Math.floor(L / 6), p = [0, 0, 0];\n      for (let i = 0; i <= n; i++) {\n        pointAlong(pts, i * 6 + 3, p);\n        const nearDeck = Math.hypot(p[0] - RAIL_BRIDGE.at[0], p[1] - RAIL_BRIDGE.at[1]) < 18;\n        pieces.push({ x: p[0], z: p[1], yaw: p[2], y: nearDeck ? RIVER_Y + 2 : this.heightAt(p[0], p[1]) });\n      }\n    }\n    const set = new InstanceSet(ctx.scene, 'rail-piece', pieces.length, { castShadow: false });\n    for (const q of pieces) set.add(q.x, q.y + 0.02, q.z, q.yaw);\n    this.railSet = set;\n  }\n  buildBridges(ctx) {\n    const statics = [];\n    const addDeck = (x, z, yaw, w, scaleX) => {\n      const y = RIVER_Y + 2;\n      const build = buildModel('bridge-deck', { catalog: MODELS });\n      build.object.position.set(x, y, z); build.object.rotation.y = yaw;\n      if (scaleX) build.object.scale.x = scaleX;\n      build.object.updateMatrixWorld(true);\n      build.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });\n      statics.push(build.object);\n      ctx.physics.addStaticBox({ position: [x, y - 0.2, z], halfExtents: [w / 2, 0.2, 15], rotationY: yaw });\n    };\n    const roadYaw = (b) => {\n      const pts = ROADS[b.road].pts;\n      let best = 0, bd = 1e9;\n      for (let i = 0; i + 1 < pts.length; i++) {\n        const mx = (pts[i][0] + pts[i + 1][0]) / 2, mz = (pts[i][1] + pts[i + 1][1]) / 2;\n        const d = Math.min(Math.hypot(pts[i][0] - b.at[0], pts[i][1] - b.at[1]), Math.hypot(pts[i + 1][0] - b.at[0], pts[i + 1][1] - b.at[1]));\n        if (d < bd) { bd = d; best = Math.atan2(pts[i + 1][0] - pts[i][0], pts[i + 1][1] - pts[i][1]); }\n      }\n      return best;\n    };\n    this.bridges = {};\n    for (const b of BRIDGES) { const yaw = roadYaw(b); addDeck(b.at[0], b.at[1], yaw, 8); this.bridges[b.id] = { x: b.at[0], z: b.at[1], yaw }; }\n    addDeck(RAIL_BRIDGE.at[0], RAIL_BRIDGE.at[1], Math.atan2(160, -55), 4, 0.5);\n    ctx.scene.add(...this.mergeOrAdd(statics));\n  }\n  // ---- plants and rocks ----\n  scatter(ctx) {\n    const r = new Rng(424242), g = this.game, ground = this.ground, { fire, wind } = g;\n    const sets = {\n      'acacia-a': { live: new InstanceSet(ctx.scene, 'acacia-a', 200), burnt: new InstanceSet(ctx.scene, 'acacia-a-burnt', 200) },\n      'acacia-b': { live: new InstanceSet(ctx.scene, 'acacia-b', 150), burnt: new InstanceSet(ctx.scene, 'acacia-b-burnt', 150) },\n      'acacia-c': { live: new InstanceSet(ctx.scene, 'acacia-c', 150), burnt: new InstanceSet(ctx.scene, 'acacia-c-burnt', 150) },\n      'bottle-tree': { live: new InstanceSet(ctx.scene, 'bottle-tree', 50), burnt: new InstanceSet(ctx.scene, 'bottle-tree-burnt', 50) },\n    };\n    this.treeSets = sets;\n    const sites = [...Object.values(SITES).filter((s) => s.r > 0).map((s) => ({ x: s.at[0], z: s.at[1], r: s.r })), ...Object.values(POSTS).map((p) => ({ x: p.at[0], z: p.at[1], r: 18 })), { x: 150, z: -300, r: 95 }, ...TRIGS.map((t) => ({ x: t.at[0], z: t.at[1], r: 5 })), ...CASES.map((c) => ({ x: c.at[0], z: c.at[1], r: 6 }))];\n    const clearOf = (x, z, pad = 0) => {\n      for (const s of sites) if (Math.hypot(x - s.x, z - s.z) < s.r + pad) return false;\n      return true;\n    };\n    const isOpen = (k) => k === K.GRASS || k === K.WOOD || k === K.BANK;\n    let placedTrees = 0, tries = 0;\n    this.treeByCell = new Map();\n    while (placedTrees < 430 && tries < 12000) {\n      tries++;\n      const x = r.range(-630, 630), z = r.range(-630, 630);\n      const k = ground.kindAt(x, z);\n      if (!isOpen(k) || !clearOf(x, z)) continue;\n      const woods = k === K.WOOD;\n      if (!woods && !r.chance(0.28)) continue;\n      const kind = r.chance(0.08) ? 'bottle-tree' : r.pick(['acacia-a', 'acacia-b', 'acacia-c']);\n      const set = sets[kind];\n      if (set.live.count >= set.live.capacity) continue;\n      const y = this.heightAt(x, z), yaw = r.range(0, Math.PI * 2), scale = r.range(0.85, 1.35);\n      const i = set.live.add(x, y, z, yaw, scale);\n      set.burnt.count = Math.max(set.burnt.count, i + 1);\n      const rad = kind === 'bottle-tree' ? 1 : 0.24;\n      const collider = ctx.physics.addStaticCylinder([x, y + 1.6, z], 1.6, rad);\n      const tree = { kind, i, x, y, z, yaw, scale, burnt: false };\n      this.trees.push(tree);\n      fire.setFuel(x, z, F.TREE);\n      const id = fire.idOf(x, z);\n      if (!this.treeByCell.has(id)) this.treeByCell.set(id, []);\n      this.treeByCell.get(id).push(tree);\n      this.game.treeColliders.push({ x, z, r: rad, collider });\n      placedTrees++;\n    }\n    // Bushes, mounds, boulders, dead trees, reeds. Static sets; mounds and boulders are solid.\n    const scatterSet = (id, cap, count, want, solid, palette) => {\n      const set = new InstanceSet(ctx.scene, id, cap, { palette });\n      let n = 0, t = 0;\n      while (n < count && t < count * 30) {\n        t++;\n        const x = r.range(-630, 630), z = r.range(-630, 630);\n        const k = ground.kindAt(x, z);\n        if (!want(k, x, z) || !clearOf(x, z)) continue;\n        const y = this.heightAt(x, z);\n        set.add(x, y, z, r.range(0, 6.28), r.range(0.8, 1.4));\n        if (solid) ctx.physics.addStaticCylinder([x, y + 0.8, z], 0.8, solid);\n        n++;\n      }\n      return set;\n    };\n    this.bushes = scatterSet('thorn-bush', 500, 460, (k) => isOpen(k), 0);\n    this.mounds = scatterSet('termite-mound', 70, 60, (k) => k === K.GRASS || k === K.WOOD, 0.6);\n    this.boulders = scatterSet('boulders', 150, 120, (k, x, z) => k === K.ROCK || (Math.hypot(x + 130, z + 520) < 240 && k !== K.WATER && k !== K.ROAD && k !== K.TRACK), 0.7);\n    this.dead = scatterSet('dead-tree', 40, 34, (k) => k === K.GRASS || k === K.SALT, 0.2);\n    const reeds = new InstanceSet(ctx.scene, 'reeds', 300, { castShadow: false });\n    for (let n = 0, t = 0; n < 280 && t < 4000; t++) {\n      const i = r.int(0, RIVER.length - 2), f = r.next(), [ax, az] = RIVER[i], [bx, bz] = RIVER[i + 1];\n      const side = r.chance(0.5) ? 1 : -1, nx = -(bz - az), nz = bx - ax, l = Math.hypot(nx, nz) || 1;\n      const off = r.range(6.5, 10) * side;\n      const x = ax + (bx - ax) * f + (nx / l) * off, z = az + (bz - az) * f + (nz / l) * off;\n      if (Math.abs(x) > 630 || Math.abs(z) > 630) continue;\n      reeds.add(x, this.heightAt(x, z), z, r.range(0, 6.28), r.range(0.9, 1.5)); n++;\n    }\n    // Tree sway: wind reads in the crowns.\n    if (g.views) {\n      this.windU = new WindUniforms();\n      for (const set of Object.values(sets)) for (const m of set.live.meshes) { swayObject(m, this.windU, { height: 5.5, base: 1.6, amount: 0.05 }); }\n    }\n  }\n  burnTreesIn(id) {\n    const list = this.treeByCell.get(id);\n    if (!list) return;\n    for (const t of list) this.setTreeBurnt(t, true);\n  }\n  scorchTreesIn() { /* flames show first; the swap comes when the cell is done */ }\n  unburnTreesIn(id) {\n    const list = this.treeByCell.get(id);\n    if (!list) return;\n    for (const t of list) this.setTreeBurnt(t, false);\n  }\n  setTreeBurnt(t, on) {\n    if (t.burnt === on) return;\n    t.burnt = on;\n    const set = this.treeSets[t.kind];\n    if (on) { set.live.hide(t.i); set.burnt.set(t.i, t.x, t.y, t.z, t.yaw, t.scale); }\n    else { set.burnt.hide(t.i); set.live.set(t.i, t.x, t.y, t.z, t.yaw, t.scale); }\n  }\n  cookOff(id) {\n    // Tanks and drums whose cell caught are handled by the actors' damage pass (combat/damage.js), which also throws the blast.\n    const g = this.game;\n    for (const ex of this.explosives) {\n      if (!ex.alive) continue;\n      if (g.fire.idOf(ex.x, ex.z) === id) g.damage.explode(ex, 'fire');\n    }\n  }\n  // ---- nav ----\n  buildNav() {\n    const nav = new NavGrid(640, 640, { cell: 2, origin: [-640, 0, -640] });\n    const ground = this.ground;\n    for (let r = 0; r < 640; r++) for (let c = 0; c < 640; c++) {\n      const x = nav.centerX(c), z = nav.centerZ(r);\n      const k = ground.kindAt(x, z);\n      let open = k !== K.WATER || ground.isFord(x, z);\n      if (open) {\n        const a = ground.sampleH(x - 1, z), b = ground.sampleH(x + 1, z), d = ground.sampleH(x, z - 1), e = ground.sampleH(x, z + 1);\n        if (Math.hypot(a - b, d - e) / 2 > 1.05) open = false;\n      }\n      if (!open) nav.setOpen(c, r, false);\n    }\n    for (const b of Object.values(this.bridges)) {\n      for (let s = -15; s <= 15; s += 1) for (let w = -3; w <= 3; w += 1) {\n        const x = b.x + Math.sin(b.yaw) * s + Math.cos(b.yaw) * w, z = b.z + Math.cos(b.yaw) * s - Math.sin(b.yaw) * w;\n        nav.setOpen(nav.col(x), nav.row(z), true);\n      }\n    }\n    // Close the cells under solid parts of buildings (doorways keep their gaps) and tree trunks.\n    for (const e of this.footprints) {\n      for (const c of e.build.colliders ?? []) {\n        const he = c.halfExtents ?? c.half ?? null;\n        const at = c.at ?? c.position ?? null;\n        if (!he || !at) continue;\n        const cy = Math.cos(e.yaw ?? 0), sy = Math.sin(e.yaw ?? 0);\n        const wx = e.x + at[0] * cy + at[2] * sy, wz = e.z - at[0] * sy + at[2] * cy;\n        const rx = Math.abs(he[0] * cy) + Math.abs(he[2] * sy), rz = Math.abs(he[0] * sy) + Math.abs(he[2] * cy);\n        for (let xx = wx - rx; xx <= wx + rx; xx += 1) for (let zz = wz - rz; zz <= wz + rz; zz += 1) nav.setOpen(nav.col(xx), nav.row(zz), false);\n      }\n    }\n    for (const t of this.game.treeColliders) nav.setOpen(nav.col(t.x), nav.row(t.z), false);\n    this.nav = nav;\n  }\n  // ---- per-frame ----\n  update(ctx, dt, time) {\n    const g = this.game;\n    for (const w of this.waters) w.update(time);\n    if (this.windU) this.windU.update(time, [g.wind.vx * 0.3, g.wind.vz * 0.3]);\n    for (const c of this.cloths) {\n      if (Math.hypot(c.x - g.camPos.x, c.z - g.camPos.z) > 160) continue;\n      c.cloth.wind[0] = g.wind.vx * 1.6; c.cloth.wind[2] = g.wind.vz * 1.6;\n      c.cloth.step(Math.min(dt, 1 / 30));\n      c.mesh.sync();\n    }\n    this.flushPaint(dt);\n  }\n  /** Back to the map as drawn: no fire, no scars, tanks whole. */\n  reset(ctx) {\n    const g = this.game;\n    g.fire.reset();\n    g.fireView.reset();\n    g.grass.reset(ctx);\n    g.fire.regrown = []; g.fire.halfDensity = new Set();\n    for (const t of this.trees) this.setTreeBurnt(t, false);\n    this.colors.clearUpdateRanges?.();\n    const b = this.baseColors, a = this.colors;\n    for (let iz = 0; iz < CELLS; iz++) for (let ix = 0; ix < CELLS; ix++) {\n      const i = (ix + iz * CELLS) * 3;\n      this.setCell(ix, iz, [b[i], b[i + 1], b[i + 2]]);\n    }\n    this.dirtyCols.clear();\n    a.needsUpdate = true;\n    for (const ex of this.explosives) g.damage?.restore(ex);\n  }\n}\nEOF\ncat > src/core/actions.js <<'EOF'\n// Actions, not keys. All gameplay asks for an action; pad and keyboard/mouse codes live here, and so do glyph names.\nexport const ACT = {\n  fire: { pad: ['PadR2'], kbm: ['MouseLeft'], glyph: { ps: 'R2', xb: 'RT', kbm: 'LMB' } },\n  aim: { pad: ['PadL2'], kbm: ['MouseRight'], glyph: { ps: 'L2', xb: 'LT', kbm: 'RMB' } },\n  use: { pad: ['PadSquare'], kbm: ['KeyE'], glyph: { ps: 'SQUARE', xb: 'X', kbm: 'E' } },\n  reload: { pad: ['PadSquare'], kbm: ['KeyR'], glyph: { ps: 'SQUARE', xb: 'X', kbm: 'R' } },\n  jump: { pad: ['PadCross'], kbm: ['Space'], glyph: { ps: 'CROSS', xb: 'A', kbm: 'SPACE' } },\n  crouch: { pad: ['PadCircle'], kbm: ['KeyC'], glyph: { ps: 'CIRCLE', xb: 'B', kbm: 'C' } },\n  sprint: { pad: ['PadL3'], kbm: ['ShiftLeft'], glyph: { ps: 'L3', xb: 'LS', kbm: 'SHIFT' } },\n  melee: { pad: ['PadR3'], kbm: ['KeyF'], glyph: { ps: 'R3', xb: 'RS', kbm: 'F' } },\n  next: { pad: ['PadTriangle'], kbm: [], glyph: { ps: 'TRIANGLE', xb: 'Y', kbm: 'WHEEL' } },\n  throw: { pad: ['PadR1'], kbm: ['KeyG'], glyph: { ps: 'R1', xb: 'RB', kbm: 'G' } },\n  heal: { pad: ['PadL1'], kbm: ['KeyQ'], glyph: { ps: 'L1', xb: 'LB', kbm: 'Q' } },\n  map: { pad: ['PadUp'], kbm: ['KeyM', 'Tab'], glyph: { ps: 'UP', xb: 'UP', kbm: 'M' } },\n  tablet: { pad: ['PadDown'], kbm: ['KeyH'], glyph: { ps: 'DOWN', xb: 'DOWN', kbm: 'H' } },\n  tracker: { pad: ['PadLeft'], kbm: ['KeyT'], glyph: { ps: 'LEFT', xb: 'LEFT', kbm: 'T' } },\n  mono: { pad: ['PadRight'], kbm: ['KeyV'], glyph: { ps: 'RIGHT', xb: 'RIGHT', kbm: 'V' } },\n  pause: { pad: ['PadOptions'], kbm: ['Escape'], glyph: { ps: 'OPTIONS', xb: 'MENU', kbm: 'ESC' } },\n  ledger: { pad: ['PadCreate'], kbm: ['KeyJ'], glyph: { ps: 'CREATE', xb: 'VIEW', kbm: 'J' } },\n  // Driving.\n  gas: { pad: ['PadR2'], kbm: ['KeyW'], glyph: { ps: 'R2', xb: 'RT', kbm: 'W' } },\n  brake: { pad: ['PadL2'], kbm: ['KeyS'], glyph: { ps: 'L2', xb: 'LT', kbm: 'S' } },\n  handbrake: { pad: ['PadCross'], kbm: ['Space'], glyph: { ps: 'CROSS', xb: 'A', kbm: 'SPACE' } },\n  exit: { pad: ['PadSquare'], kbm: ['KeyE'], glyph: { ps: 'SQUARE', xb: 'X', kbm: 'E' } },\n  swap: { pad: ['PadTriangle'], kbm: ['KeyF'], glyph: { ps: 'TRIANGLE', xb: 'Y', kbm: 'F' } },\n  chase: { pad: ['PadR3'], kbm: ['KeyC'], glyph: { ps: 'R3', xb: 'RS', kbm: 'C' } },\n  // A second face of the use button, for two-button prompts (Syrette or Finish It).\n  alt: { pad: ['PadTriangle'], kbm: ['KeyF'], glyph: { ps: 'TRIANGLE', xb: 'Y', kbm: 'F' } },\n  // Menus.\n  menuUp: { pad: ['PadUp'], kbm: ['ArrowUp', 'KeyW'], glyph: { ps: 'UP', xb: 'UP', kbm: 'UP' } },\n  menuDown: { pad: ['PadDown'], kbm: ['ArrowDown', 'KeyS'], glyph: { ps: 'DOWN', xb: 'DOWN', kbm: 'DOWN' } },\n  menuLeft: { pad: ['PadLeft'], kbm: ['ArrowLeft', 'KeyA'], glyph: { ps: 'LEFT', xb: 'LEFT', kbm: 'LEFT' } },\n  menuRight: { pad: ['PadRight'], kbm: ['ArrowRight', 'KeyD'], glyph: { ps: 'RIGHT', xb: 'RIGHT', kbm: 'RIGHT' } },\n  confirm: { pad: ['PadCross'], kbm: ['Enter', 'Space'], glyph: { ps: 'CROSS', xb: 'A', kbm: 'ENTER' } },\n  back: { pad: ['PadCircle'], kbm: ['Escape'], glyph: { ps: 'CIRCLE', xb: 'B', kbm: 'ESC' } },\n  tabLeft: { pad: ['PadL1'], kbm: ['KeyQ'], glyph: { ps: 'L1', xb: 'LB', kbm: 'Q' } },\n  tabRight: { pad: ['PadR1'], kbm: ['KeyE'], glyph: { ps: 'R1', xb: 'RB', kbm: 'E' } },\n  resetOne: { pad: ['PadSquare'], kbm: ['KeyR'], glyph: { ps: 'SQUARE', xb: 'X', kbm: 'R' } },\n  skip: { pad: ['PadCross'], kbm: ['Enter'], glyph: { ps: 'CROSS', xb: 'A', kbm: 'ENTER' } },\n};\nconst PAD_MAP = { 0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle', 4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2', 8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3', 12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight' };\nconst ALL = {};\nfor (const [k, v] of Object.entries(ACT)) ALL[k] = [...v.pad, ...v.kbm];\nexport const PREVENT = ['Tab', 'Space', 'Escape', 'KeyM'];\n\nexport class Actions {\n  device = 'kbm'; triggers = [0, 0]; rs = 0; bot = null; lastPtr = [0, 0];\n  constructor(input) { this.input = input; input.gamepadButtons = { ...PAD_MAP }; for (const k of PREVENT) input.preventKeys.add(k); }\n  codes(name) { return ALL[name]; }\n  down(name) { if (this.bot?.held.has(name)) return true; return this.bot?.only ? false : this.input.anyDown(ALL[name]); }\n  /** Once per press, in fixedUpdate. */\n  take(name) {\n    if (this.bot?.queue.has(name)) { this.bot.queue.delete(name); return true; }\n    return this.bot?.only ? false : this.input.consumeAny(ALL[name]);\n  }\n  /** Once per press, in update (menus). */\n  tapped(name) {\n    if (this.bot?.taps.has(name)) { this.bot.taps.delete(name); return true; }\n    if (this.bot?.only) return false;\n    const codes = ALL[name];\n    for (let i = 0; i < codes.length; i++) if (this.input.wasPressed(codes[i])) return true;\n    return false;\n  }\n  axis() {\n    if (this.bot) { if (this.bot.only || this.bot.move.x || this.bot.move.y) return this.bot.move; }\n    return this.input.moveAxis();\n  }\n  /** Throttle and brake 0..1 from analog triggers when a pad is used, else the keys. */\n  analog(name) {\n    if (this.bot && this.bot.analog[name] != null) return this.bot.analog[name];\n    if (name === 'gas') { if (this.input.anyDown(ACT.gas.kbm)) return 1; return Math.max(this.triggers[1], this.input.isDown('PadR2') ? 1 : 0); }\n    if (name === 'brake') { if (this.input.anyDown(ACT.brake.kbm)) return 1; return Math.max(this.triggers[0], this.input.isDown('PadL2') ? 1 : 0); }\n    return 0;\n  }\n  glyph(name, xbox) { const g = ACT[name].glyph; return this.device === 'pad' ? (xbox ? g.xb : g.ps) : g.kbm; }\n  /** Per frame: who touched what last. */\n  track(usePad) {\n    const input = this.input;\n    let padActive = false;\n    const nav = typeof navigator !== 'undefined' ? navigator : null;\n    const pads = nav?.getGamepads ? nav.getGamepads() : null;\n    let l2 = 0, r2 = 0, rs = 0;\n    if (pads) for (const p of pads) {\n      if (!p || !p.connected) continue;\n      const a = p.axes || [];\n      if (Math.hypot(a[0] || 0, a[1] || 0) > 0.35 || Math.hypot(a[2] || 0, a[3] || 0) > 0.35) padActive = true;\n      rs = Math.max(rs, Math.hypot(a[2] || 0, a[3] || 0));\n      l2 = Math.max(l2, p.buttons?.[6]?.value || 0); r2 = Math.max(r2, p.buttons?.[7]?.value || 0);\n    }\n    if (l2 !== this.triggers[0] || r2 !== this.triggers[1] || rs !== this.rs) { input.send({ tr: [l2, r2], rs }); }\n    for (const cmd of input.commands) if (cmd && cmd.tr) { this.triggers = cmd.tr; this.rs = cmd.rs ?? 0; }\n    let keyHit = false;\n    const st = input.state();\n    const held = st.held ?? st.keys ?? [];\n    const queued = st.queued ?? st.presses ?? [];\n    const look = (code) => { if (String(code).startsWith('Pad')) padActive = true; else keyHit = true; };\n    if (Array.isArray(held)) for (const c of held) look(typeof c === 'string' ? c : c.code ?? c[0]);\n    if (Array.isArray(queued)) for (const c of queued) look(typeof c === 'string' ? c : c.code ?? c[0]);\n    const pt = input.pointer;\n    const moved = pt.x !== this.lastPtr[0] || pt.y !== this.lastPtr[1];\n    this.lastPtr[0] = pt.x; this.lastPtr[1] = pt.y;\n    const deltaMoved = (input.mouseDelta.x !== 0 || input.mouseDelta.y !== 0) && rs < 0.15;\n    if (padActive) this.device = 'pad';\n    else if (keyHit || moved || deltaMoved || input.wheel !== 0) this.device = 'kbm';\n    return padActive || keyHit || moved || deltaMoved || input.wheel !== 0;\n  }\n}\nexport class Bot {\n  held = new Set(); queue = new Set(); taps = new Set(); move = { x: 0, y: 0 }; analog = {}; only = true;\n  press(name) { this.queue.add(name); this.taps.add(name); }\n  hold(name, on = true) { if (on) this.held.add(name); else this.held.delete(name); }\n  clear() { this.held.clear(); this.queue.clear(); this.taps.clear(); this.move = { x: 0, y: 0 }; this.analog = {}; }\n}\nEOF\nn=$(grep -n \"^### interface InputState\" API.md | cut -d: -f1); sed -n \"$n,$((n+10))p\" API.md | cut -c1-240\nnode --input-type=module -e \"\nimport { buildModel } from './pixel-engine.js';\nimport { MODELS } from './src/art/models.js';\nconst b=buildModel('shack',{catalog:MODELS}); console.log(JSON.stringify(b.colliders.slice(0,2)), b.object.children.length, b.object.children.map(c=>c.type+':'+c.name).join(','));\nconst a=buildModel('soldier-a',{catalog:MODELS}); console.log(a.object.children.map(c=>c.type+':'+c.name).join(','));\nconst a2=buildModel('soldier-a',{catalog:MODELS}); console.log('fresh object', a.object!==a2.object);\n\" 2>&1 | cut -c1-500","description":"Write world, actions, and check input state and collider shapes","timeout":60000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2673,"cache_read_input_tokens":281156,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2673},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"fbf52194-86c3-47e4-9924-c9c33de56396","timestamp":"2026-11-05T23:40:21.080Z","request_id":"req_011CgkfKkFCjbLs6zD3Eh6N4","wire_tool_inputs":{"toolu_01SYqiMfznnABDmJhecYntt6":{"command":"set -e\ncat > src/world/world.js <<'EOF'\n// The Kettle on screen: terrain mesh and its paint, water, rails, bridges, sites, scatter, the nav grid.\nimport { THREE, Terrain, WaterSurface, WAVES_CALM, buildModel, addModelColliders, mergeStaticMeshes, setLookLayer, PALETTE, NavGrid, Rng, clothGrid, SoftMesh, toonMaterial, swayObject, WindUniforms } from '../../pixel-engine.js';\nimport { MODELS } from '../art/models.js';\nimport { Ground, K, CELLS, CELL, HALF, polyLength, pointAlong, distToPolyline } from './ground.js';\nimport { F, FN, FCELL, S } from './fire.js';\nimport { InstanceSet } from './instances.js';\nimport { ROADS, RAIL, RIVER, RIVER_Y, BRIDGES, RAIL_BRIDGE, STRIPS } from '../content/roads.js';\nimport { SITES, POSTS, TRIGS, CASES, HALTS } from '../content/sites.js';\nimport { hash2, clamp, smooth } from '../core/rng.js';\nconst { Color, Vector3, Mesh, Group, Object3D } = THREE;\n\nconst col = (hex) => { const c = new Color(hex); return [c.r, c.g, c.b]; };\nconst P = Object.fromEntries(Object.entries(PALETTE).map(([k, v]) => [k, col(v)]));\nconst DYNAMIC = new Set(['boom-gate', 'post-cage', 'fuel-tank', 'oil-drum', 'table-lamp']);\nconst BURNS = new Set(['shack', 'hut', 'market-stall', 'clinic-tent', 'bar', 'schoolroom']);\nexport const EXPLOSIVE = { 'oil-drum': { radius: 4, damage: 90, hp: 30, fire: 5 }, 'fuel-tank': { radius: 13, damage: 300, hp: 80, fire: 14 } };\n\nexport class World {\n  explosives = []; trees = []; dirtyCols = new Set(); uploadT = 0; placed = []; byTag = new Map(); colliderTrees = []; cloths = [];\n  constructor(game) { this.game = game; this.ground = game.ground; }\n  heightAt(x, z) { return this.land.heightAt(x, z); }\n  build(ctx) {\n    const { scene, physics } = ctx, g = this.game, ground = this.ground;\n    this.land = new Terrain({ size: [1280, 1280], cells: [CELLS, CELLS] });\n    const N = CELLS + 1;\n    this.land.generate((x, z) => ground.h[Math.round((x + HALF) / CELL) + Math.round((z + HALF) / CELL) * N]);\n    this.land.attach(physics);\n    this.land.mesh.receiveShadow = true;\n    scene.add(this.land.mesh);\n    this.colors = this.land.mesh.geometry.getAttribute('color');\n    this.baseColors = new Float32Array(CELLS * CELLS * 3);\n    this.paintBase();\n    this.buildWater(ctx);\n    this.buildRails(ctx);\n    this.buildBridges(ctx);\n    this.buildSites(ctx);\n    this.scatter(ctx);\n    this.buildNav();\n    // Paint fire events.\n    const { fire } = g;\n    fire.onBurnt = (id) => { this.paintFireCell(id, 'burnt'); g.grass.burnCell(id); this.burnTreesIn(id); g.fireView.onDone(id); this.cookOff(id); };\n    fire.onIgnite = (id, src) => { g.grass.burnCell(id); g.fireView.onIgnite(id); this.scorchTreesIn(id); g.events.emit('fire-lit', id, src); };\n    fire.onRegrow = (id) => { this.paintFireCell(id, 'green'); };\n    fire.onFresh = (id) => { this.paintFireCell(id, 'base'); this.unburnTreesIn(id); };\n  }\n  // ---- paint ----\n  baseColorOf(ix, iz) {\n    const k = this.ground.kind[ix + iz * CELLS], x = ix * CELL - HALF, z = iz * CELL - HALF;\n    const h = hash2(ix, iz);\n    const patch = this.ground.noise.n2(x * 0.018, z * 0.018);\n    switch (k) {\n      case K.GRASS: return patch + h * 0.5 > 0.42 ? P.orange : (h > 0.82 ? P.red : P.sand);\n      case K.CROP: return h > 0.5 ? P.sand : P.orange;\n      case K.WOOD: return h > 0.62 ? P.green : (patch > 0 ? P.teal : P.orange);\n      case K.BANK: return h > 0.35 ? P.green : P.teal;\n      case K.ROAD: return h > 0.84 ? P.plum : P.red;\n      case K.TRACK: return h > 0.5 ? P.red : P.plum;\n      case K.RAIL: return h > 0.5 ? P.slate : P.night;\n      case K.DIRT: return h > 0.72 ? P.plum : P.red;\n      case K.WATER: return P.navy;\n      case K.ROCK: return h > 0.8 ? P.slate : P.plum;\n      case K.SALT: return h > 0.22 ? P.white : P.mist;\n      case K.MINE: return h > 0.6 ? P.slate : (h > 0.25 ? P.plum : P.night);\n      default: return P.sand;\n    }\n  }\n  setCell(ix, iz, c) {\n    const base = 6 * (ix + iz * CELLS), a = this.colors;\n    for (let k = 0; k < 6; k++) a.setXYZ(base + k, c[0], c[1], c[2]);\n  }\n  paintBase() {\n    const a = this.baseColors;\n    for (let iz = 0; iz < CELLS; iz++) for (let ix = 0; ix < CELLS; ix++) {\n      const c = this.baseColorOf(ix, iz);\n      a.set(c, (ix + iz * CELLS) * 3);\n      this.setCell(ix, iz, c);\n    }\n    this.colors.clearUpdateRanges?.();\n    this.colors.needsUpdate = true;\n  }\n  paintFireCell(id, mode) {\n    const cx = id % FN, cz = (id / FN) | 0;\n    for (let dz = 0; dz < 2; dz++) for (let dx = 0; dx < 2; dx++) {\n      const ix = cx * 2 + dx, iz = cz * 2 + dz;\n      if (ix >= CELLS || iz >= CELLS) continue;\n      const h = hash2(ix + 3, iz + 11);\n      let c;\n      if (mode === 'burnt') c = h > 0.7 ? P.slate : (h > 0.3 ? P.night : P.ink);\n      else if (mode === 'green') c = h > 0.55 ? P.green : P.lime;\n      else { const i = (ix + iz * CELLS) * 3; c = [this.baseColors[i], this.baseColors[i + 1], this.baseColors[i + 2]]; }\n      this.setCell(ix, iz, c);\n      this.dirtyRow(ix, iz);\n    }\n  }\n  dirtyRow(ix, iz) { this.dirtyCols.add(ix + iz * CELLS); }\n  flushPaint(dt) {\n    this.uploadT -= dt;\n    if (!this.dirtyCols.size || this.uploadT > 0) return;\n    this.uploadT = 0.25;\n    const a = this.colors;\n    a.clearUpdateRanges?.();\n    if (this.dirtyCols.size > 2000) { a.needsUpdate = true; this.dirtyCols.clear(); return; }\n    for (const c of this.dirtyCols) a.addUpdateRange(c * 18, 18);\n    a.needsUpdate = true;\n    this.dirtyCols.clear();\n  }\n  // ---- static placement ----\n  place(id, x, z, turnDeg = 0, { y, palette, seed, params, list, collide = true, scale } = {}) {\n    const ctx = this.game.ctx;\n    const yy = y ?? this.heightAt(x, z);\n    const build = buildModel(id, { catalog: MODELS, palette, seed, params });\n    const yaw = (turnDeg * Math.PI) / 180;\n    build.object.position.set(x, yy, z);\n    build.object.rotation.y = yaw;\n    if (scale) build.object.scale.setScalar(scale);\n    build.object.updateMatrixWorld(true);\n    build.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });\n    let colliders = [];\n    if (collide) colliders = addModelColliders(ctx.physics, build, [x, yy, z], yaw);\n    (list ?? this.placed).push(build.object);\n    return { build, object: build.object, x, y: yy, z, yaw, colliders };\n  }\n  addDynamic(ctx, entry) { ctx.scene.add(entry.object); return entry; }\n  placeSiteProps(ctx, site, statics) {\n    for (const [id, dx, dz, turn, opts] of site.props) {\n      const x = site.at[0] + dx, z = site.at[1] + dz;\n      const dyn = DYNAMIC.has(id);\n      const e = this.place(id, x, z, turn, { ...opts, list: dyn ? [] : statics });\n      if (dyn) this.addDynamic(ctx, e);\n      if (EXPLOSIVE[id]) this.addExplosive(id, e);\n      if (BURNS.has(id)) this.game.fire.setFuel(x, z, F.BUILDING);\n      e.id = id; e.site = site;\n      if (!this.byTag.has(id)) this.byTag.set(id, []);\n      this.byTag.get(id).push(e);\n      this.footprints.push(e);\n      if (id === 'table-lamp' && e.build.light) { /* lit when Harrow sits there */ e.lamp = e.build.light; }\n    }\n  }\n  addExplosive(id, e, tag) {\n    const def = EXPLOSIVE[id];\n    const ex = { id, tag, x: e.x, y: e.y, z: e.z, object: e.object, colliders: e.colliders, hp: def.hp, def, alive: true, entry: e };\n    this.explosives.push(ex);\n    for (const c of e.colliders) this.game.hitMap.set(c.handle, { kind: 'explosive', ref: ex });\n    return ex;\n  }\n  buildSites(ctx) {\n    this.footprints = [];\n    for (const [key, site] of Object.entries(SITES)) {\n      site.key = key;\n      const statics = [];\n      this.placeSiteProps(ctx, site, statics);\n      if (site.tanks) for (const [dx, dz] of site.tanks) {\n        const e = this.place('fuel-tank', site.at[0] + dx, site.at[1] + dz, 0, { list: [] });\n        this.addDynamic(ctx, e); this.addExplosive('fuel-tank', e, 'fuel-tank');\n      }\n      if (site.safe) {\n        const s = site.safe;\n        const put = (id, [dx, dz], t = 0) => { const e = this.place(id, site.at[0] + dx, site.at[1] + dz, t, { list: statics }); return e; };\n        put('safe-bed', s.bed, 90); put('safe-locker', s.locker, 0); put('ammo-crate', s.crate, 20); put('name-wall', s.wall, 0);\n      }\n      if (statics.length) ctx.scene.add(...this.mergeOrAdd(statics));\n    }\n    const postStatics = [];\n    this.postParts = {};\n    for (const [key, p] of Object.entries(POSTS)) {\n      const yawDeg = (p.yaw * 180) / Math.PI;\n      const fx = Math.sin(p.yaw), fz = Math.cos(p.yaw), rx = fz, rz = -fx;\n      const local = (a, b) => [p.at[0] + rx * a + fx * b, p.at[1] + rz * a + fz * b];\n      const [gx, gz] = local(0, 0);\n      const gate = this.place('boom-gate', gx, gz, yawDeg + 90, { list: [] }); this.addDynamic(ctx, gate);\n      this.postParts[key] = gate;\n      for (const [a, b, t] of [[-7, 6, 90], [7, 6, 90], [-7, -6, 90], [7, -6, 90]]) { const [x, z] = local(a, b); this.place('sandbag-run', x, z, yawDeg + t, { list: postStatics }); }\n      const [dx, dz] = local(5.5, 0); const drum = this.place('oil-drum', dx, dz, 0, { list: [] }); this.addDynamic(ctx, drum); this.addExplosive('oil-drum', drum);\n      const [cx, cz] = local(-9.5, 2); this.place('crate', cx, cz, 18, { list: postStatics });\n      const [mx, mz] = local(9, -2); this.addPostCloth(ctx, mx, mz);\n      this.place('signpost', mx + rx * 2, mz + rz * 2, yawDeg, { list: postStatics });\n    }\n    ctx.scene.add(...this.mergeOrAdd(postStatics));\n    // Trig pillars, rail halts, cases' props.\n    const misc = [];\n    this.trigEntries = {};\n    for (const t of TRIGS) this.trigEntries[t.id] = this.place('trig-pillar', t.at[0], t.at[1], 0, { list: misc });\n    for (const h of Object.values(HALTS)) { this.place('signal-mast', h.at[0] + 5, h.at[1] - 6, 0, { list: misc }); this.place('stool', h.at[0] - 3, h.at[1] - 5, 0, { list: misc, collide: false }); }\n    for (const c of CASES) {\n      const yaw = hash2(c.at[0], c.at[1]) * 360;\n      const off = c.prop === 'shack' ? 0 : 2.2;\n      this.place(c.prop, c.at[0] + off, c.at[1] + off * 0.6, yaw, { list: misc });\n      this.footprints.push({ build: { colliders: [] }, x: c.at[0], z: c.at[1] });\n      if (c.prop === 'shack') this.game.fire.setFuel(c.at[0], c.at[1], F.BUILDING);\n    }\n    this.place('handcar', -300 + 8, 100 - 4, 80, { list: misc });\n    ctx.scene.add(...this.mergeOrAdd(misc));\n    // Cloth on the Mile Forty mast too: you read the wind everywhere you stop.\n    this.addPostCloth(ctx, 22, 24);\n  }\n  addPostCloth(ctx, x, z) {\n    const y = this.heightAt(x, z);\n    const pole = new Mesh(new THREE.BoxGeometry(0.14, 3.4, 0.14), toonMaterial(PALETTE.night));\n    pole.position.set(x, y + 1.7, z); pole.castShadow = true;\n    ctx.scene.add(pole);\n    if (!this.game.views) return;\n    const cloth = clothGrid({ width: 1.4, height: 0.45, cols: 6, rows: 3, origin: [x, y + 3.3, z], pin: 'left' });\n    cloth.drag = 1.4; cloth.gust = 0.3;\n    const mesh = new SoftMesh(cloth, toonMaterial(PALETTE.red), { doubleSided: true });\n    mesh.castShadow = false;\n    ctx.scene.add(mesh);\n    this.cloths.push({ cloth, mesh, x, z });\n  }\n  mergeOrAdd(list) { for (const o of list) o.updateMatrixWorld(true); return mergeStaticMeshes(list); }\n  // ---- water, rails, bridges ----\n  buildWater(ctx) {\n    this.waters = [];\n    if (!this.game.views) return;\n    for (let i = 0; i + 1 < RIVER.length; i++) {\n      const [ax, az] = RIVER[i], [bx, bz] = RIVER[i + 1];\n      const len = Math.hypot(bx - ax, bz - az);\n      const w = new WaterSurface({ size: [15.5, len + 8], at: [0, 0, 0], segments: [4, Math.ceil(len / 8)], waves: WAVES_CALM, deep: PALETTE.navy, shallow: PALETTE.teal, foam: PALETTE.mist, opacity: 1 });\n      w.position.set((ax + bx) / 2, RIVER_Y, (az + bz) / 2);\n      w.rotation.y = Math.atan2(bx - ax, bz - az);\n      w.castShadow = false;\n      ctx.scene.add(w);\n      this.waters.push(w);\n    }\n  }\n  buildRails(ctx) {\n    const pieces = [];\n    for (const pts of Object.values(RAIL)) {\n      const L = polyLength(pts), n = Math.floor(L / 6), p = [0, 0, 0];\n      for (let i = 0; i <= n; i++) {\n        pointAlong(pts, i * 6 + 3, p);\n        const nearDeck = Math.hypot(p[0] - RAIL_BRIDGE.at[0], p[1] - RAIL_BRIDGE.at[1]) < 18;\n        pieces.push({ x: p[0], z: p[1], yaw: p[2], y: nearDeck ? RIVER_Y + 2 : this.heightAt(p[0], p[1]) });\n      }\n    }\n    const set = new InstanceSet(ctx.scene, 'rail-piece', pieces.length, { castShadow: false });\n    for (const q of pieces) set.add(q.x, q.y + 0.02, q.z, q.yaw);\n    this.railSet = set;\n  }\n  buildBridges(ctx) {\n    const statics = [];\n    const addDeck = (x, z, yaw, w, scaleX) => {\n      const y = RIVER_Y + 2;\n      const build = buildModel('bridge-deck', { catalog: MODELS });\n      build.object.position.set(x, y, z); build.object.rotation.y = yaw;\n      if (scaleX) build.object.scale.x = scaleX;\n      build.object.updateMatrixWorld(true);\n      build.object.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });\n      statics.push(build.object);\n      ctx.physics.addStaticBox({ position: [x, y - 0.2, z], halfExtents: [w / 2, 0.2, 15], rotationY: yaw });\n    };\n    const roadYaw = (b) => {\n      const pts = ROADS[b.road].pts;\n      let best = 0, bd = 1e9;\n      for (let i = 0; i + 1 < pts.length; i++) {\n        const mx = (pts[i][0] + pts[i + 1][0]) / 2, mz = (pts[i][1] + pts[i + 1][1]) / 2;\n        const d = Math.min(Math.hypot(pts[i][0] - b.at[0], pts[i][1] - b.at[1]), Math.hypot(pts[i + 1][0] - b.at[0], pts[i + 1][1] - b.at[1]));\n        if (d < bd) { bd = d; best = Math.atan2(pts[i + 1][0] - pts[i][0], pts[i + 1][1] - pts[i][1]); }\n      }\n      return best;\n    };\n    this.bridges = {};\n    for (const b of BRIDGES) { const yaw = roadYaw(b); addDeck(b.at[0], b.at[1], yaw, 8); this.bridges[b.id] = { x: b.at[0], z: b.at[1], yaw }; }\n    addDeck(RAIL_BRIDGE.at[0], RAIL_BRIDGE.at[1], Math.atan2(160, -55), 4, 0.5);\n    ctx.scene.add(...this.mergeOrAdd(statics));\n  }\n  // ---- plants and rocks ----\n  scatter(ctx) {\n    const r = new Rng(424242), g = this.game, ground = this.ground, { fire, wind } = g;\n    const sets = {\n      'acacia-a': { live: new InstanceSet(ctx.scene, 'acacia-a', 200), burnt: new InstanceSet(ctx.scene, 'acacia-a-burnt', 200) },\n      'acacia-b': { live: new InstanceSet(ctx.scene, 'acacia-b', 150), burnt: new InstanceSet(ctx.scene, 'acacia-b-burnt', 150) },\n      'acacia-c': { live: new InstanceSet(ctx.scene, 'acacia-c', 150), burnt: new InstanceSet(ctx.scene, 'acacia-c-burnt', 150) },\n      'bottle-tree': { live: new InstanceSet(ctx.scene, 'bottle-tree', 50), burnt: new InstanceSet(ctx.scene, 'bottle-tree-burnt', 50) },\n    };\n    this.treeSets = sets;\n    const sites = [...Object.values(SITES).filter((s) => s.r > 0).map((s) => ({ x: s.at[0], z: s.at[1], r: s.r })), ...Object.values(POSTS).map((p) => ({ x: p.at[0], z: p.at[1], r: 18 })), { x: 150, z: -300, r: 95 }, ...TRIGS.map((t) => ({ x: t.at[0], z: t.at[1], r: 5 })), ...CASES.map((c) => ({ x: c.at[0], z: c.at[1], r: 6 }))];\n    const clearOf = (x, z, pad = 0) => {\n      for (const s of sites) if (Math.hypot(x - s.x, z - s.z) < s.r + pad) return false;\n      return true;\n    };\n    const isOpen = (k) => k === K.GRASS || k === K.WOOD || k === K.BANK;\n    let placedTrees = 0, tries = 0;\n    this.treeByCell = new Map();\n    while (placedTrees < 430 && tries < 12000) {\n      tries++;\n      const x = r.range(-630, 630), z = r.range(-630, 630);\n      const k = ground.kindAt(x, z);\n      if (!isOpen(k) || !clearOf(x, z)) continue;\n      const woods = k === K.WOOD;\n      if (!woods && !r.chance(0.28)) continue;\n      const kind = r.chance(0.08) ? 'bottle-tree' : r.pick(['acacia-a', 'acacia-b', 'acacia-c']);\n      const set = sets[kind];\n      if (set.live.count >= set.live.capacity) continue;\n      const y = this.heightAt(x, z), yaw = r.range(0, Math.PI * 2), scale = r.range(0.85, 1.35);\n      const i = set.live.add(x, y, z, yaw, scale);\n      set.burnt.count = Math.max(set.burnt.count, i + 1);\n      const rad = kind === 'bottle-tree' ? 1 : 0.24;\n      const collider = ctx.physics.addStaticCylinder([x, y + 1.6, z], 1.6, rad);\n      const tree = { kind, i, x, y, z, yaw, scale, burnt: false };\n      this.trees.push(tree);\n      fire.setFuel(x, z, F.TREE);\n      const id = fire.idOf(x, z);\n      if (!this.treeByCell.has(id)) this.treeByCell.set(id, []);\n      this.treeByCell.get(id).push(tree);\n      this.game.treeColliders.push({ x, z, r: rad, collider });\n      placedTrees++;\n    }\n    // Bushes, mounds, boulders, dead trees, reeds. Static sets; mounds and boulders are solid.\n    const scatterSet = (id, cap, count, want, solid, palette) => {\n      const set = new InstanceSet(ctx.scene, id, cap, { palette });\n      let n = 0, t = 0;\n      while (n < count && t < count * 30) {\n        t++;\n        const x = r.range(-630, 630), z = r.range(-630, 630);\n        const k = ground.kindAt(x, z);\n        if (!want(k, x, z) || !clearOf(x, z)) continue;\n        const y = this.heightAt(x, z);\n        set.add(x, y, z, r.range(0, 6.28), r.range(0.8, 1.4));\n        if (solid) ctx.physics.addStaticCylinder([x, y + 0.8, z], 0.8, solid);\n        n++;\n      }\n      return set;\n    };\n    this.bushes = scatterSet('thorn-bush', 500, 460, (k) => isOpen(k), 0);\n    this.mounds = scatterSet('termite-mound', 70, 60, (k) => k === K.GRASS || k === K.WOOD, 0.6);\n    this.boulders = scatterSet('boulders', 150, 120, (k, x, z) => k === K.ROCK || (Math.hypot(x + 130, z + 520) < 240 && k !== K.WATER && k !== K.ROAD && k !== K.TRACK), 0.7);\n    this.dead = scatterSet('dead-tree', 40, 34, (k) => k === K.GRASS || k === K.SALT, 0.2);\n    const reeds = new InstanceSet(ctx.scene, 'reeds', 300, { castShadow: false });\n    for (let n = 0, t = 0; n < 280 && t < 4000; t++) {\n      const i = r.int(0, RIVER.length - 2), f = r.next(), [ax, az] = RIVER[i], [bx, bz] = RIVER[i + 1];\n      const side = r.chance(0.5) ? 1 : -1, nx = -(bz - az), nz = bx - ax, l = Math.hypot(nx, nz) || 1;\n      const off = r.range(6.5, 10) * side;\n      const x = ax + (bx - ax) * f + (nx / l) * off, z = az + (bz - az) * f + (nz / l) * off;\n      if (Math.abs(x) > 630 || Math.abs(z) > 630) continue;\n      reeds.add(x, this.heightAt(x, z), z, r.range(0, 6.28), r.range(0.9, 1.5)); n++;\n    }\n    // Tree sway: wind reads in the crowns.\n    if (g.views) {\n      this.windU = new WindUniforms();\n      for (const set of Object.values(sets)) for (const m of set.live.meshes) { swayObject(m, this.windU, { height: 5.5, base: 1.6, amount: 0.05 }); }\n    }\n  }\n  burnTreesIn(id) {\n    const list = this.treeByCell.get(id);\n    if (!list) return;\n    for (const t of list) this.setTreeBurnt(t, true);\n  }\n  scorchTreesIn() { /* flames show first; the swap comes when the cell is done */ }\n  unburnTreesIn(id) {\n    const list = this.treeByCell.get(id);\n    if (!list) return;\n    for (const t of list) this.setTreeBurnt(t, false);\n  }\n  setTreeBurnt(t, on) {\n    if (t.burnt === on) return;\n    t.burnt = on;\n    const set = this.treeSets[t.kind];\n    if (on) { set.live.hide(t.i); set.burnt.set(t.i, t.x, t.y, t.z, t.yaw, t.scale); }\n    else { set.burnt.hide(t.i); set.live.set(t.i, t.x, t.y, t.z, t.yaw, t.scale); }\n  }\n  cookOff(id) {\n    // Tanks and drums whose cell caught are handled by the actors' damage pass (combat/damage.js), which also throws the blast.\n    const g = this.game;\n    for (const ex of this.explosives) {\n      if (!ex.alive) continue;\n      if (g.fire.idOf(ex.x, ex.z) === id) g.damage.explode(ex, 'fire');\n    }\n  }\n  // ---- nav ----\n  buildNav() {\n    const nav = new NavGrid(640, 640, { cell: 2, origin: [-640, 0, -640] });\n    const ground = this.ground;\n    for (let r = 0; r < 640; r++) for (let c = 0; c < 640; c++) {\n      const x = nav.centerX(c), z = nav.centerZ(r);\n      const k = ground.kindAt(x, z);\n      let open = k !== K.WATER || ground.isFord(x, z);\n      if (open) {\n        const a = ground.sampleH(x - 1, z), b = ground.sampleH(x + 1, z), d = ground.sampleH(x, z - 1), e = ground.sampleH(x, z + 1);\n        if (Math.hypot(a - b, d - e) / 2 > 1.05) open = false;\n      }\n      if (!open) nav.setOpen(c, r, false);\n    }\n    for (const b of Object.values(this.bridges)) {\n      for (let s = -15; s <= 15; s += 1) for (let w = -3; w <= 3; w += 1) {\n        const x = b.x + Math.sin(b.yaw) * s + Math.cos(b.yaw) * w, z = b.z + Math.cos(b.yaw) * s - Math.sin(b.yaw) * w;\n        nav.setOpen(nav.col(x), nav.row(z), true);\n      }\n    }\n    // Close the cells under solid parts of buildings (doorways keep their gaps) and tree trunks.\n    for (const e of this.footprints) {\n      for (const c of e.build.colliders ?? []) {\n        const he = c.halfExtents ?? c.half ?? null;\n        const at = c.at ?? c.position ?? null;\n        if (!he || !at) continue;\n        const cy = Math.cos(e.yaw ?? 0), sy = Math.sin(e.yaw ?? 0);\n        const wx = e.x + at[0] * cy + at[2] * sy, wz = e.z - at[0] * sy + at[2] * cy;\n        const rx = Math.abs(he[0] * cy) + Math.abs(he[2] * sy), rz = Math.abs(he[0] * sy) + Math.abs(he[2] * cy);\n        for (let xx = wx - rx; xx <= wx + rx; xx += 1) for (let zz = wz - rz; zz <= wz + rz; zz += 1) nav.setOpen(nav.col(xx), nav.row(zz), false);\n      }\n    }\n    for (const t of this.game.treeColliders) nav.setOpen(nav.col(t.x), nav.row(t.z), false);\n    this.nav = nav;\n  }\n  // ---- per-frame ----\n  update(ctx, dt, time) {\n    const g = this.game;\n    for (const w of this.waters) w.update(time);\n    if (this.windU) this.windU.update(time, [g.wind.vx * 0.3, g.wind.vz * 0.3]);\n    for (const c of this.cloths) {\n      if (Math.hypot(c.x - g.camPos.x, c.z - g.camPos.z) > 160) continue;\n      c.cloth.wind[0] = g.wind.vx * 1.6; c.cloth.wind[2] = g.wind.vz * 1.6;\n      c.cloth.step(Math.min(dt, 1 / 30));\n      c.mesh.sync();\n    }\n    this.flushPaint(dt);\n  }\n  /** Back to the map as drawn: no fire, no scars, tanks whole. */\n  reset(ctx) {\n    const g = this.game;\n    g.fire.reset();\n    g.fireView.reset();\n    g.grass.reset(ctx);\n    g.fire.regrown = []; g.fire.halfDensity = new Set();\n    for (const t of this.trees) this.setTreeBurnt(t, false);\n    this.colors.clearUpdateRanges?.();\n    const b = this.baseColors, a = this.colors;\n    for (let iz = 0; iz < CELLS; iz++) for (let ix = 0; ix < CELLS; ix++) {\n      const i = (ix + iz * CELLS) * 3;\n      this.setCell(ix, iz, [b[i], b[i + 1], b[i + 2]]);\n    }\n    this.dirtyCols.clear();\n    a.needsUpdate = true;\n    for (const ex of this.explosives) g.damage?.restore(ex);\n  }\n}\nEOF\ncat > src/core/actions.js <<'EOF'\n// Actions, not keys. All gameplay asks for an action; pad and keyboard/mouse codes live here, and so do glyph names.\nexport const ACT = {\n  fire: { pad: ['PadR2'], kbm: ['MouseLeft'], glyph: { ps: 'R2', xb: 'RT', kbm: 'LMB' } },\n  aim: { pad: ['PadL2'], kbm: ['MouseRight'], glyph: { ps: 'L2', xb: 'LT', kbm: 'RMB' } },\n  use: { pad: ['PadSquare'], kbm: ['KeyE'], glyph: { ps: 'SQUARE', xb: 'X', kbm: 'E' } },\n  reload: { pad: ['PadSquare'], kbm: ['KeyR'], glyph: { ps: 'SQUARE', xb: 'X', kbm: 'R' } },\n  jump: { pad: ['PadCross'], kbm: ['Space'], glyph: { ps: 'CROSS', xb: 'A', kbm: 'SPACE' } },\n  crouch: { pad: ['PadCircle'], kbm: ['KeyC'], glyph: { ps: 'CIRCLE', xb: 'B', kbm: 'C' } },\n  sprint: { pad: ['PadL3'], kbm: ['ShiftLeft'], glyph: { ps: 'L3', xb: 'LS', kbm: 'SHIFT' } },\n  melee: { pad: ['PadR3'], kbm: ['KeyF'], glyph: { ps: 'R3', xb: 'RS', kbm: 'F' } },\n  next: { pad: ['PadTriangle'], kbm: [], glyph: { ps: 'TRIANGLE', xb: 'Y', kbm: 'WHEEL' } },\n  throw: { pad: ['PadR1'], kbm: ['KeyG'], glyph: { ps: 'R1', xb: 'RB', kbm: 'G' } },\n  heal: { pad: ['PadL1'], kbm: ['KeyQ'], glyph: { ps: 'L1', xb: 'LB', kbm: 'Q' } },\n  map: { pad: ['PadUp'], kbm: ['KeyM', 'Tab'], glyph: { ps: 'UP', xb: 'UP', kbm: 'M' } },\n  tablet: { pad: ['PadDown'], kbm: ['KeyH'], glyph: { ps: 'DOWN', xb: 'DOWN', kbm: 'H' } },\n  tracker: { pad: ['PadLeft'], kbm: ['KeyT'], glyph: { ps: 'LEFT', xb: 'LEFT', kbm: 'T' } },\n  mono: { pad: ['PadRight'], kbm: ['KeyV'], glyph: { ps: 'RIGHT', xb: 'RIGHT', kbm: 'V' } },\n  pause: { pad: ['PadOptions'], kbm: ['Escape'], glyph: { ps: 'OPTIONS', xb: 'MENU', kbm: 'ESC' } },\n  ledger: { pad: ['PadCreate'], kbm: ['KeyJ'], glyph: { ps: 'CREATE', xb: 'VIEW', kbm: 'J' } },\n  // Driving.\n  gas: { pad: ['PadR2'], kbm: ['KeyW'], glyph: { ps: 'R2', xb: 'RT', kbm: 'W' } },\n  brake: { pad: ['PadL2'], kbm: ['KeyS'], glyph: { ps: 'L2', xb: 'LT', kbm: 'S' } },\n  handbrake: { pad: ['PadCross'], kbm: ['Space'], glyph: { ps: 'CROSS', xb: 'A', kbm: 'SPACE' } },\n  exit: { pad: ['PadSquare'], kbm: ['KeyE'], glyph: { ps: 'SQUARE', xb: 'X', kbm: 'E' } },\n  swap: { pad: ['PadTriangle'], kbm: ['KeyF'], glyph: { ps: 'TRIANGLE', xb: 'Y', kbm: 'F' } },\n  chase: { pad: ['PadR3'], kbm: ['KeyC'], glyph: { ps: 'R3', xb: 'RS', kbm: 'C' } },\n  // A second face of the use button, for two-button prompts (Syrette or Finish It).\n  alt: { pad: ['PadTriangle'], kbm: ['KeyF'], glyph: { ps: 'TRIANGLE', xb: 'Y', kbm: 'F' } },\n  // Menus.\n  menuUp: { pad: ['PadUp'], kbm: ['ArrowUp', 'KeyW'], glyph: { ps: 'UP', xb: 'UP', kbm: 'UP' } },\n  menuDown: { pad: ['PadDown'], kbm: ['ArrowDown', 'KeyS'], glyph: { ps: 'DOWN', xb: 'DOWN', kbm: 'DOWN' } },\n  menuLeft: { pad: ['PadLeft'], kbm: ['ArrowLeft', 'KeyA'], glyph: { ps: 'LEFT', xb: 'LEFT', kbm: 'LEFT' } },\n  menuRight: { pad: ['PadRight'], kbm: ['ArrowRight', 'KeyD'], glyph: { ps: 'RIGHT', xb: 'RIGHT', kbm: 'RIGHT' } },\n  confirm: { pad: ['PadCross'], kbm: ['Enter', 'Space'], glyph: { ps: 'CROSS', xb: 'A', kbm: 'ENTER' } },\n  back: { pad: ['PadCircle'], kbm: ['Escape'], glyph: { ps: 'CIRCLE', xb: 'B', kbm: 'ESC' } },\n  tabLeft: { pad: ['PadL1'], kbm: ['KeyQ'], glyph: { ps: 'L1', xb: 'LB', kbm: 'Q' } },\n  tabRight: { pad: ['PadR1'], kbm: ['KeyE'], glyph: { ps: 'R1', xb: 'RB', kbm: 'E' } },\n  resetOne: { pad: ['PadSquare'], kbm: ['KeyR'], glyph: { ps: 'SQUARE', xb: 'X', kbm: 'R' } },\n  skip: { pad: ['PadCross'], kbm: ['Enter'], glyph: { ps: 'CROSS', xb: 'A', kbm: 'ENTER' } },\n};\nconst PAD_MAP = { 0: 'PadCross', 1: 'PadCircle', 2: 'PadSquare', 3: 'PadTriangle', 4: 'PadL1', 5: 'PadR1', 6: 'PadL2', 7: 'PadR2', 8: 'PadCreate', 9: 'PadOptions', 10: 'PadL3', 11: 'PadR3', 12: 'PadUp', 13: 'PadDown', 14: 'PadLeft', 15: 'PadRight' };\nconst ALL = {};\nfor (const [k, v] of Object.entries(ACT)) ALL[k] = [...v.pad, ...v.kbm];\nexport const PREVENT = ['Tab', 'Space', 'Escape', 'KeyM'];\n\nexport class Actions {\n  device = 'kbm'; triggers = [0, 0]; rs = 0; bot = null; lastPtr = [0, 0];\n  constructor(input) { this.input = input; input.gamepadButtons = { ...PAD_MAP }; for (const k of PREVENT) input.preventKeys.add(k); }\n  codes(name) { return ALL[name]; }\n  down(name) { if (this.bot?.held.has(name)) return true; return this.bot?.only ? false : this.input.anyDown(ALL[name]); }\n  /** Once per press, in fixedUpdate. */\n  take(name) {\n    if (this.bot?.queue.has(name)) { this.bot.queue.delete(name); return true; }\n    return this.bot?.only ? false : this.input.consumeAny(ALL[name]);\n  }\n  /** Once per press, in update (menus). */\n  tapped(name) {\n    if (this.bot?.taps.has(name)) { this.bot.taps.delete(name); return true; }\n    if (this.bot?.only) return false;\n    const codes = ALL[name];\n    for (let i = 0; i < codes.length; i++) if (this.input.wasPressed(codes[i])) return true;\n    return false;\n  }\n  axis() {\n    if (this.bot) { if (this.bot.only || this.bot.move.x || this.bot.move.y) return this.bot.move; }\n    return this.input.moveAxis();\n  }\n  /** Throttle and brake 0..1 from analog triggers when a pad is used, else the keys. */\n  analog(name) {\n    if (this.bot && this.bot.analog[name] != null) return this.bot.analog[name];\n    if (name === 'gas') { if (this.input.anyDown(ACT.gas.kbm)) return 1; return Math.max(this.triggers[1], this.input.isDown('PadR2') ? 1 : 0); }\n    if (name === 'brake') { if (this.input.anyDown(ACT.brake.kbm)) return 1; return Math.max(this.triggers[0], this.input.isDown('PadL2') ? 1 : 0); }\n    return 0;\n  }\n  glyph(name, xbox) { const g = ACT[name].glyph; return this.device === 'pad' ? (xbox ? g.xb : g.ps) : g.kbm; }\n  /** Per frame: who touched what last. */\n  track(usePad) {\n    const input = this.input;\n    let padActive = false;\n    const nav = typeof navigator !== 'undefined' ? navigator : null;\n    const pads = nav?.getGamepads ? nav.getGamepads() : null;\n    let l2 = 0, r2 = 0, rs = 0;\n    if (pads) for (const p of pads) {\n      if (!p || !p.connected) continue;\n      const a = p.axes || [];\n      if (Math.hypot(a[0] || 0, a[1] || 0) > 0.35 || Math.hypot(a[2] || 0, a[3] || 0) > 0.35) padActive = true;\n      rs = Math.max(rs, Math.hypot(a[2] || 0, a[3] || 0));\n      l2 = Math.max(l2, p.buttons?.[6]?.value || 0); r2 = Math.max(r2, p.buttons?.[7]?.value || 0);\n    }\n    if (l2 !== this.triggers[0] || r2 !== this.triggers[1] || rs !== this.rs) { input.send({ tr: [l2, r2], rs }); }\n    for (const cmd of input.commands) if (cmd && cmd.tr) { this.triggers = cmd.tr; this.rs = cmd.rs ?? 0; }\n    let keyHit = false;\n    const st = input.state();\n    const held = st.held ?? st.keys ?? [];\n    const queued = st.queued ?? st.presses ?? [];\n    const look = (code) => { if (String(code).startsWith('Pad')) padActive = true; else keyHit = true; };\n    if (Array.isArray(held)) for (const c of held) look(typeof c === 'string' ? c : c.code ?? c[0]);\n    if (Array.isArray(queued)) for (const c of queued) look(typeof c === 'string' ? c : c.code ?? c[0]);\n    const pt = input.pointer;\n    const moved = pt.x !== this.lastPtr[0] || pt.y !== this.lastPtr[1];\n    this.lastPtr[0] = pt.x; this.lastPtr[1] = pt.y;\n    const deltaMoved = (input.mouseDelta.x !== 0 || input.mouseDelta.y !== 0) && rs < 0.15;\n    if (padActive) this.device = 'pad';\n    else if (keyHit || moved || deltaMoved || input.wheel !== 0) this.device = 'kbm';\n    return padActive || keyHit || moved || deltaMoved || input.wheel !== 0;\n  }\n}\nexport class Bot {\n  held = new Set(); queue = new Set(); taps = new Set(); move = { x: 0, y: 0 }; analog = {}; only = true;\n  press(name) { this.queue.add(name); this.taps.add(name); }\n  hold(name, on = true) { if (on) this.held.add(name); else this.held.delete(name); }\n  clear() { this.held.clear(); this.queue.clear(); this.taps.clear(); this.move = { x: 0, y: 0 }; this.analog = {}; }\n}\nEOF\nn=$(grep -n \"^### interface InputState\" API.md | cut -d: -f1); sed -n \"$n,$((n+10))p\" API.md | cut -c1-240\nnode --input-type=module -e \"\nimport { buildModel } from './pixel-engine.js';\nimport { MODELS } from './src/art/models.js';\nconst b=buildModel('shack',{catalog:MODELS}); console.log(JSON.stringify(b.colliders.slice(0,2)), b.object.children.length, b.object.children.map(c=>c.type+':'+c.name).join(','));\nconst a=buildModel('soldier-a',{catalog:MODELS}); console.log(a.object.children.map(c=>c.type+':'+c.name).join(','));\nconst a2=buildModel('soldier-a',{catalog:MODELS}); console.log('fresh object', a.object!==a2.object);\n\" 2>&1 | cut -c1-500","description":"Write world, actions, and check input state and collider shapes","timeout":60000}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SYqiMfznnABDmJhecYntt6","type":"tool_result","content":"### interface InputState\n\nWhat input a later frame still reads, as data (`engine.snapshot()`): keys held, presses not yet used and how old they are, the pointer.\n\n- `readonly held: readonly string[]`\n- `readonly queued: readonly (readonly [string, number])[]`: Queued presses: [key, seconds of game time since it was pressed].\n- `readonly pointer: readonly [number, number, number, number]`\n- `readonly gamepad: boolean`\n- `readonly outbox: readonly unknown[]`: Data sent (`send`) and not yet delivered: the next frame that runs delivers it.\n\n### MOUSE_BUTTONS\n[{\"kind\":\"box\",\"center\":[0,1.25,-2.3],\"half\":[2.8,1.25,0.10000000000000009]},{\"kind\":\"box\",\"center\":[-2.8,1.25,0],\"half\":[0.10000000000000009,1.25,2.3]}] 4 Mesh:shack:wall,Mesh:shack:tin,Mesh:shack:floor,Mesh:shack:frame\nGroup:Pelvis\nfresh object true","is_error":false}]},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"54f40723-d2a5-4185-a07c-8080d9d16781","timestamp":"2026-11-05T23:40:21.225Z","tool_use_result":{"stdout":"### interface InputState\n\nWhat input a later frame still reads, as data (`engine.snapshot()`): keys held, presses not yet used and how old they are, the pointer.\n\n- `readonly held: readonly string[]`\n- `readonly queued: readonly (readonly [string, number])[]`: Queued presses: [key, seconds of game time since it was pressed].\n- `readonly pointer: readonly [number, number, number, number]`\n- `readonly gamepad: boolean`\n- `readonly outbox: readonly unknown[]`: Data sent (`send`) and not yet delivered: the next frame that runs delivers it.\n\n### MOUSE_BUTTONS\n[{\"kind\":\"box\",\"center\":[0,1.25,-2.3],\"half\":[2.8,1.25,0.10000000000000009]},{\"kind\":\"box\",\"center\":[-2.8,1.25,0],\"half\":[0.10000000000000009,1.25,2.3]}] 4 Mesh:shack:wall,Mesh:shack:tin,Mesh:shack:floor,Mesh:shack:frame\nGroup:Pelvis\nfresh object true","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SYqiMfznnABDmJhecYntt6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
