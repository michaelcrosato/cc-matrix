 [-50, 0, -6], ForearmR: [-40, 0, 0], ArmL: [-50, 0, 6], ForearmL: [-40, 0, 0] }], [40, { ...seat, ArmR: [-50, 0, -6], ForearmR: [-40, 0, 0], ArmL: [-50, 0, 6], ForearmL: [-40, 0, 0] }]] },\n  { name: 'UnjamSwear', frames: 36, keys: [[0, aimUpper(0)], [6, { Torso: [10, 14, 4], ArmL: [-60, 0, -10], ForearmL: [-80, 0, 0], ArmR: [-60, 0, -6], ForearmR: [-50, 0, 0], Head: [18, 0, 0] }], [12, { ArmL: [-40, 0, -24], ForearmL: [-90, 0, 0] }], [20, { ArmL: [-60, 0, -10], ForearmL: [-70, 0, 0], Head: [10, 12, 0] }], [28, { ArmL: [-40, 0, -24], ForearmL: [-90, 0, 0], Head: [10, -12, 0] }], [36, aimUpper(0)]] },\n  { name: 'WalkHandsTied', frames: 18, loop: true, keys: [[0, { Pelvis: { r: [3, 0, 0], p: [0, -0.02, 0] }, Torso: [10, 0, 0], Head: [12, 0, 0], ArmR: [18, 0, 12], ForearmR: [-40, 0, 20], ArmL: [18, 0, -12], ForearmL: [-40, 0, -20], LegR: [-22, 0, 0], ShinR: [12, 0, 0], LegL: [14, 0, 0], ShinL: [22, 0, 0] }], [9, { Pelvis: { r: [3, 0, 0], p: [0, -0.04, 0] }, Torso: [10, 0, 0], Head: [12, 0, 0], ArmR: [18, 0, 12], ForearmR: [-40, 0, 20], ArmL: [18, 0, -12], ForearmL: [-40, 0, -20], LegR: [14, 0, 0], ShinR: [22, 0, 0], LegL: [-22, 0, 0], ShinL: [12, 0, 0] }], [18, { Pelvis: { r: [3, 0, 0], p: [0, -0.02, 0] }, Torso: [10, 0, 0], Head: [12, 0, 0], ArmR: [18, 0, 12], ForearmR: [-40, 0, 20], ArmL: [18, 0, -12], ForearmL: [-40, 0, -20], LegR: [-22, 0, 0], ShinR: [12, 0, 0], LegL: [14, 0, 0], ShinL: [22, 0, 0] }]] },\n  { name: 'Shrug', frames: 40, loop: true, keys: [[0, { ...legsStand, ArmR: [-10, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-10, 0, 10], ForearmL: [-30, 0, 0], Head: R }], [14, { ...legsStand, Torso: [0, 6, 0], ArmR: [-20, 0, -26], ForearmR: [-90, 0, 0], ArmL: [-20, 0, 26], ForearmL: [-90, 0, 0], Head: [0, 0, 10] }], [26, { ...legsStand, ArmR: [-20, 0, -26], ForearmR: [-90, 0, 0], ArmL: [-20, 0, 26], ForearmL: [-90, 0, 0], Head: [0, 0, 10] }], [40, { ...legsStand, ArmR: [-10, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-10, 0, 10], ForearmL: [-30, 0, 0], Head: R }]] },\n  { name: 'SmokeIdle', frames: 120, loop: true, keys: [[0, { ...legsStand, ArmL: [-6, 0, 6], ForearmL: [-70, 0, 0], ArmR: [-4, 0, -4], ForearmR: [-12, 0, 0] }], [40, { ...legsStand, ArmL: [-6, 0, 6], ForearmL: [-70, 0, 0], ArmR: [-52, 0, -24], ForearmR: [-118, 0, 0], Head: [-6, 0, 0] }], [70, { ...legsStand, ArmL: [-6, 0, 6], ForearmL: [-70, 0, 0], ArmR: [-52, 0, -24], ForearmR: [-118, 0, 0], Head: [-14, 0, 0] }], [120, { ...legsStand, ArmL: [-6, 0, 6], ForearmL: [-70, 0, 0], ArmR: [-4, 0, -4], ForearmR: [-12, 0, 0] }]] },\n  { name: 'CleanRifleIdle', frames: 60, loop: true, keys: [[0, { ...seat, Torso: [16, 0, 0], Head: [18, 0, 0], ArmR: [-44, 0, -4], ForearmR: [-60, 0, 0], ArmL: [-44, 0, 4], ForearmL: [-54, 0, 0] }], [30, { ...seat, Torso: [18, 0, 0], Head: [20, 0, 0], ArmR: [-54, 0, -4], ForearmR: [-40, 0, 0], ArmL: [-44, 0, 4], ForearmL: [-54, 0, 0] }], [60, { ...seat, Torso: [16, 0, 0], Head: [18, 0, 0], ArmR: [-44, 0, -4], ForearmR: [-60, 0, 0], ArmL: [-44, 0, 4], ForearmL: [-54, 0, 0] }]] },\n  { name: 'WriteAtDesk', frames: 80, loop: true, keys: [[0, { ...seat, Torso: [22, 0, 0], Head: [20, 0, 0], ArmR: [-44, 0, 0], ForearmR: [-50, 0, 0], ArmL: [-40, 0, 6], ForearmL: [-60, 0, 0] }], [20, { ...seat, Torso: [22, 0, 0], Head: [20, 4, 0], ArmR: [-50, 8, 0], ForearmR: [-46, 0, 0], ArmL: [-40, 0, 6], ForearmL: [-60, 0, 0] }], [40, { ...seat, Torso: [22, 0, 0], Head: [20, -4, 0], ArmR: [-44, -8, 0], ForearmR: [-54, 0, 0], ArmL: [-40, 0, 6], ForearmL: [-60, 0, 0] }], [80, { ...seat, Torso: [22, 0, 0], Head: [20, 0, 0], ArmR: [-44, 0, 0], ForearmR: [-50, 0, 0], ArmL: [-40, 0, 6], ForearmL: [-60, 0, 0] }]] },\n  { name: 'TeachPoint', frames: 60, loop: true, keys: [[0, { ...legsStand, Torso: [0, -10, 0], ArmR: [-110, 0, -16], ForearmR: [-14, 0, 0], ArmL: [-6, 0, 6], ForearmL: [-40, 0, 0] }], [30, { ...legsStand, Torso: [4, -6, 0], Head: [8, 0, 0], ArmR: [-100, 0, -16], ForearmR: [-30, 0, 0], ArmL: [-6, 0, 6], ForearmL: [-40, 0, 0] }], [60, { ...legsStand, Torso: [0, -10, 0], ArmR: [-110, 0, -16], ForearmR: [-14, 0, 0], ArmL: [-6, 0, 6], ForearmL: [-40, 0, 0] }]] },\n];\nconst GAZ_JOINTS = { joints: ['Body', 'Neck', 'LegFR', 'LegFL', 'LegBR', 'LegBL'], root: 'Body', mirror: {}, soles: [], trace: [], limits: {}, fps: 30 };\nexport const FAUNA_RIG = GAZ_JOINTS;\nexport const FAUNA_CLIPS = [\n  { name: 'GazRun', frames: 12, loop: true, fast: true, keys: [[0, { Body: { r: [6, 0, 0], p: [0, 0.03, 0] }, LegFR: [-40, 0, 0], LegFL: [-30, 0, 0], LegBR: [40, 0, 0], LegBL: [30, 0, 0], Neck: [10, 0, 0] }], [6, { Body: { r: [-6, 0, 0], p: [0, 0.1, 0] }, LegFR: [40, 0, 0], LegFL: [30, 0, 0], LegBR: [-40, 0, 0], LegBL: [-30, 0, 0], Neck: [-6, 0, 0] }], [12, { Body: { r: [6, 0, 0], p: [0, 0.03, 0] }, LegFR: [-40, 0, 0], LegFL: [-30, 0, 0], LegBR: [40, 0, 0], LegBL: [30, 0, 0], Neck: [10, 0, 0] }]] },\n  { name: 'GazGraze', frames: 90, loop: true, keys: [[0, { Body: { r: R, p: R }, Neck: [-74, 0, 0], LegFR: R, LegFL: R, LegBR: R, LegBL: R }], [50, { Neck: [-80, 0, 0] }], [70, { Neck: [-20, 0, 0] }], [90, { Body: { r: R, p: R }, Neck: [-74, 0, 0], LegFR: R, LegFL: R, LegBR: R, LegBL: R }]] },\n];\nEOF\ncat > tools/checkvm.mjs <<'EOF'\ntry {\n  const { checkModel, compileClips, buildModel, HERO_CLIPS, HERO_RIG, validateClip, THREE } = await import('../pixel-engine.js');\n  const { handsDef, HANDS_CLIPS, HANDS_RIG, cabHands, rackDefs } = await import('../src/art/viewmodels.js');\n  const { MODELS } = await import('../src/art/models.js');\n  const { PEOPLE_CLIPS, FAUNA_CLIPS, FAUNA_RIG } = await import('../src/art/clips.js');\n  for (const def of [handsDef, cabHands, ...Object.values(rackDefs)]) { const r = checkModel(def); if (r.problems.length) console.log('PROBLEM', def.id, r.problems.map((p) => p.message || p).join(' | ').slice(0, 500)); }\n  const b = buildModel(handsDef);\n  const clips = compileClips(HANDS_CLIPS, HANDS_RIG, b.object);\n  console.log('hands clips', clips.length, clips.slice(0, 3).map((c) => c.name + ':' + c.duration.toFixed(2)).join(' '));\n  const s = buildModel('soldier-a', { catalog: MODELS });\n  let t = Date.now();\n  const rig = { ...HERO_RIG, spine: undefined };\n  const pc = compileClips([...HERO_CLIPS, ...PEOPLE_CLIPS], rig, s.object);\n  console.log('people clips', pc.length, Date.now() - t, 'ms');\n  for (const c of PEOPLE_CLIPS) { try { const v = validateClip?.(c, rig); if (v && v.length) console.log('clip', c.name, JSON.stringify(v).slice(0, 200)); } catch (e) { console.log('v err', c.name, e.message); } }\n  const gz = buildModel('gazelle', { catalog: MODELS }); const fc = compileClips(FAUNA_CLIPS, FAUNA_RIG, gz.object); console.log('fauna', fc.length);\n  console.log(b.report ?? '');\n} catch (e) { console.log('ERR', String(e.message).slice(0, 800), String(e.stack).split('\\n').slice(1, 4).map((s) => s.slice(0, 200)).join('\\n')); }\nEOF\nnode tools/checkvm.mjs 2>&1 | cut -c1-600 | tail -20; grep -n \"^### validateClip\\|^### analyzeClip\" -A6 API.md | cut -c1-200 | head -14","description":"Write weapons data, viewmodels, people and hand clips; validate them","timeout":90000}}}
