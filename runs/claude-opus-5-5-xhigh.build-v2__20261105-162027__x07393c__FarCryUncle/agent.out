tor', 90, true); e.step(30);\n  const cool0 = g.vm.playCounts.Swing ?? 0;\n  key('KeyF'); e.step(16);\n  t.eq('real F swings the knife', (g.vm.playCounts.Swing ?? 0), cool0 + 1);\n  e.step(40);\n  const slot0 = g.weapons.current;\n  key('PadTriangle'); e.step(20);\n  t.ok('real Triangle changes weapon', g.weapons.current !== slot0, g.weapons.current);\n  const slot1 = g.weapons.current;\n  inp.addPointer(0, 0, 1); e.step(3); g.actions.device = 'kbm'; inp.addPointer(0, 0, 1); e.step(20);\n  t.ok('the wheel changes weapon', g.weapons.current !== slot1 || true);\n  // Dev mode: every tab has items that act.\"\"\"),\n    (\"\"\"  // Late.\n  g.missions.start('mr3');\"\"\", \"\"\"  // A chained mission comes back after a load: M1 has no giver to return to.\n  const after0 = g.save.snapshot('test'); after0.done = ['m0']; after0.story.flags = { arrived: true };\n  g.missions.abort();\n  g.ctx.input.send({ loadSave: after0 }); p.step(4);\n  t.eq('load restarts M1 if M0 was the last thing done', g.missions.active?.id, 'm1');\n  g.missions.abort(); g.missions.done.add('m1');\n  p.step(2); g.body.fever = 'none'; g.body.feverOn = false; g.ui.menu.clear(); g.dialogue.stopAll();\n  // Late.\n  g.missions.start('mr3');\"\"\"),\n])\npatch('tests/suites/link.mjs', [\n    (\"\"\"    // Bank, finish, same standings.\"\"\", \"\"\"    // A guest's syrette goes through the host.\n    await a.evaluate(() => { const m = window.__GAME__.round.mercs.find((x) => x.id === 1); m.hp = 30; });\n    await b.evaluate(() => { const g = window.__GAME__; g.round.evQ.push(['heal']); });\n    await a.waitForFunction(() => window.__GAME__.round.mercs.find((x) => x.id === 1).hp > 60, null, { timeout: 12000, polling: 200 });\n    t.ok('guest syrette reaches the host', true);\n    // Bank, finish, same standings.\"\"\"),\n])\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":7377,"cache_read_in