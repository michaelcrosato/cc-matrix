{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgkhX5aau1QjHryCF95cg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KaSbp5Jk3DhLa72T2gboUg","name":"Bash","input":{"command":"set -e\npython3 - <<'EOF'\np='src/content/sites.js'; s=open(p).read()\ns=s.replace(\"['table-lamp', 0, 2, 0],\",\"['table-lamp', 0, 1.2, 0], ['stool', 0, -0.1, 0],\")\ns=s.replace(\"npcs: [{ who: 'harrow', dx: 0, dz: 0, yaw: 180 }],\",\"npcs: [{ who: 'harrow', dx: 0, dz: 0, yaw: 0 }],\")\nopen(p,'w').write(s)\nEOF\ncat > src/core/save.js <<'EOF'\n// Single slot, versioned JSON. Written on sleep and on mission complete; read through input.send so replays stay exact.\nimport { storyToJson, storyFromJson } from '../missions/story.js';\nconst KEY = 'far-cry-uncle.save.v1';\nexport const SETTINGS_KEY = 'far-cry-uncle.settings.v1';\nconst store = () => { try { return typeof localStorage !== 'undefined' ? localStorage : null; } catch { return null; } };\nexport class Save {\n  disabled = false; lastWritten = null; pendingLoad = null;\n  constructor(game) { this.game = game; }\n  exists() { const s = store(); try { return !!(s && s.getItem(KEY)); } catch { return false; } }\n  read() { const s = store(); try { const raw = s?.getItem(KEY); return raw ? JSON.parse(raw) : null; } catch { return null; } }\n  snapshot(reason) {\n    const g = this.game;\n    return {\n      version: 1, reason, story: storyToJson(g.story), weapons: g.weapons.snapshot(),\n      body: { hp: Math.max(40, Math.round(g.body.hp)), syrettes: g.body.syrettes, maxSyrettes: g.body.maxSyrettes, tablets: g.body.tablets, feverIn: g.body.feverIn, feverAct: g.body.feverAct },\n      pos: g.lastSafe ?? [g.player.feet.x, g.player.feet.z], yaw: g.player.yaw, hour: g.clock.hour, abs: g.clock.abs, day: g.clock.day,\n      fire: g.fire.encode(), done: [...g.missions.done], ledger: g.ledger.toJson(),\n      buddies: g.actors.buddies.map((b) => ({ id: b.id, met: b.met, dead: b.dead, trust: b.trust, spentUntil: b.spentUntil, woundedUntil: b.woundedUntil })),\n      squads: [...g.actors.squads.entries()].filter(([k, s]) => POST_LIKE(k)).map(([k, s]) => [k, s.alive, s.clearedAt]),\n      seen: [...g.map.seen], notes: g.map.notes, wind: [g.wind.dir, g.wind.speed], hasKit: g.vehicles.hasKit,\n    };\n  }\n  write(reason = 'manual') {\n    const g = this.game;\n    if (this.disabled || g.round) return false;\n    const data = this.snapshot(reason);\n    this.lastWritten = data;\n    const s = store();\n    try { s?.setItem(KEY, JSON.stringify(data)); } catch { return false; }\n    return true;\n  }\n  /** A round trip through the input so a replay reproduces it. */\n  requestLoad() {\n    const data = this.read() ?? this.lastWritten;\n    if (!data) return false;\n    this.game.ctx.input.send({ loadSave: data });\n    return true;\n  }\n  apply(data) {\n    const g = this.game;\n    g.resetCampaign();\n    g.story = storyFromJson(data.story);\n    g.weapons.restoreData(data.weapons);\n    Object.assign(g.body, data.body);\n    g.clock.hour = data.hour; g.clock.abs = data.abs; g.clock.day = data.day;\n    g.fire.hours = data.abs;\n    g.missions.done = new Set(data.done);\n    g.ledger.fromJson(data.ledger);\n    for (const b of data.buddies) Object.assign(g.actors.buddy(b.id), b);\n    for (const [k, alive, clearedAt] of data.squads ?? []) { const s = g.actors.squads.get(k); if (s) { s.alive = alive; s.clearedAt = clearedAt; } }\n    g.map.seen = new Set(data.seen); g.map.notes = data.notes;\n    g.wind.dir = data.wind[0]; g.wind.speed = data.wind[1];\n    g.vehicles.hasKit = data.hasKit;\n    // The land remembers: repaint scars.\n    g.fire.decode(data.fire);\n    for (let id = 0; id < 65536; id++) {\n      const st = g.fire.state[id];\n      if (st === 2) { g.world.paintFireCell(id, 'burnt'); g.world.burnTreesIn(id); for (const ex of g.world.explosives) if (ex.alive && g.fire.idOf(ex.x, ex.z) === id) { ex.alive = false; ex.object.visible = false; for (const c of ex.colliders) c.setEnabled?.(false); } }\n      else if (st === 3) g.world.paintFireCell(id, 'green');\n    }\n    g.lastSafe = data.pos;\n    g.player.teleport(data.pos[0], data.pos[1]);\n    g.player.setYaw(data.yaw, 0);\n    g.sky.apply(g.ctx, g.clock.hour);\n    g.applyStoryToWorld();\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    g.events.emit('loaded');\n  }\n  clear() { const s = store(); try { s?.removeItem(KEY); } catch { /* storage may be blocked */ } }\n}\nconst POST_LIKE = () => true;\nexport const DEFAULT_SETTINGS = { music: 0.1, sfx: 1, voices: 1, sensPad: 1, sensMouse: 1, invertY: false, aimAssist: true, rumble: true, glyphs: 'ps', pixelSize: 'fine', quality: 'auto', fov: 62, subtitleSize: 1, reduceFlashes: false, feverReduced: false };\nexport function loadSettings() {\n  const s = store();\n  try { const raw = s?.getItem(SETTINGS_KEY); return { ...DEFAULT_SETTINGS, ...(raw ? JSON.parse(raw) : {}) }; } catch { return { ...DEFAULT_SETTINGS }; }\n}\nexport function storeSettings(v) { const s = store(); try { s?.setItem(SETTINGS_KEY, JSON.stringify(v)); } catch { /* storage may be blocked */ } }\nEOF\ncat > src/world/places.js <<'EOF'\n// Everything you can walk up to: givers, the notice board, safehouses, trig points, stone cases, rail halts.\nimport { THREE, buildModel, setLookLayer } from '../../pixel-engine.js';\nimport { MODELS } from '../art/models.js';\nimport { SITES, TRIGS, CASES, HALTS } from '../content/sites.js';\nimport { MARGIN_NOTES, ALL_TRIGS_NOTE } from '../content/notes.js';\nimport { GIVER_LINES } from '../content/missions.js';\nimport { LINES } from '../content/dialogue.js';\nimport { MISSIONS } from '../content/missions.js';\nconst NEAR = 60;\nexport class Places {\n  caseObjs = {}; storyCases = {}; trackerBeepT = 0; trackerOn = false;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game, I = g.interact;\n    // Givers and talkers.\n    const talkers = ['odile', 'tibor', 'bakr', 'vance', 'ansa', 'ines', 'dov', 'mags'];\n    for (const who of talkers) {\n      const n = g.npcs.byWho[who];\n      if (!n) continue;\n      I.add({ npc: n, liveAt: () => [n.x, n.y + 1.5, n.z], x: n.x, y: n.y, z: n.z, r: 3.2, wide: true, when: () => n.active && !g.missions.active && !g.dialogue.active, verb: () => this.talkVerb(who), onUse: () => this.talk(who, n) });\n    }\n    // The notice board.\n    const m40 = SITES['mile-forty'];\n    I.add({ x: m40.at[0], y: g.world.heightAt(m40.at[0], m40.at[1] + 18) + 1.5, z: m40.at[1] + 18, r: 3, wide: true, verb: () => 'READ THE NOTICE BOARD', when: () => !g.dialogue.active, onUse: () => g.ui.openBoard() });\n    // Tibor's rack.\n    const tib = g.npcs.byWho.tibor;\n    I.add({ x: tib.x + 2.2, y: tib.y + 1.2, z: tib.z + 2, r: 3.2, wide: true, when: () => g.story.truce, verb: () => \"LOOK AT TIBOR'S RACK\", onUse: () => g.ui.openRack() });\n    // Safehouses.\n    for (const [key, site] of Object.entries(SITES)) {\n      if (!site.safe) continue;\n      const open = () => this.safeOpen(key);\n      const f = (d) => [site.at[0] + d[0], site.at[1] + d[1]];\n      const y = (x, z) => g.world.heightAt(x, z);\n      const b = f(site.safe.bed), l = f(site.safe.locker), c = f(site.safe.crate), w = f(site.safe.wall);\n      I.add({ x: b[0], y: y(b[0], b[1]) + 0.7, z: b[1], r: 2.8, wide: true, when: open, verb: () => 'SLEEP', onUse: () => g.ui.openBed(key) });\n      I.add({ x: l[0], y: y(l[0], l[1]) + 1, z: l[1], r: 2.6, wide: true, when: open, verb: () => 'OPEN THE LOCKER', onUse: () => g.ui.openLocker() });\n      I.add({ x: c[0], y: y(c[0], c[1]) + 0.6, z: c[1], r: 2.6, wide: true, when: open, verb: () => 'TAKE AMMO AND SYRETTES', onUse: () => this.resupply() });\n      I.add({ x: w[0], y: y(w[0], w[1]) + 1.4, z: w[1], r: 2.8, wide: true, when: open, verb: () => 'READ THE WALL', onUse: () => g.ui.openWall() });\n      // Harrow's note waits at every safehouse once all four jobs are done.\n      I.add({ x: b[0], y: y(b[0], b[1]) + 1.2, z: b[1] + 0.8, r: 3.2, wide: true, when: () => open() && this.noteReady(), verb: () => 'READ THE NOTE ON THE COT', onUse: () => this.readNote() });\n    }\n    // Trig points.\n    for (const t of TRIGS) {\n      I.add({ id: t.id, x: t.at[0], y: g.world.heightAt(t.at[0], t.at[1]) + 1.2, z: t.at[1], r: 3, wide: true, when: () => !g.story.trigsDone.has(t.id), verb: () => 'TAKE A BEARING', onUse: () => this.trig(t) });\n    }\n    // Stone cases.\n    for (const c of CASES) {\n      const x = c.at[0], z = c.at[1], yy = g.world.heightAt(x, z);\n      const built = buildModel('stone-case', { catalog: MODELS });\n      built.object.position.set(x, yy + 0.02, z);\n      setLookLayer(built.object, 'actors');\n      ctx.scene.add(built.object);\n      this.caseObjs[c.id] = built.object;\n      I.add({ id: c.id, caseId: c.id, x, y: yy + 0.3, z, r: 2.4, wide: true, when: () => !g.story.casesDone.has(c.id), verb: () => 'TAKE THE CASE', onUse: () => this.takeCase(c) });\n    }\n    // Rail halts.\n    for (const [key, h] of Object.entries(HALTS)) {\n      const x = h.at[0] - 3, z = h.at[1] - 5;\n      I.add({ x, y: g.world.heightAt(x, z) + 1, z, r: 4, wide: true, verb: () => 'RAIL HALT', when: () => !g.missions.active && g.story.flags.arrived, onUse: () => g.ui.openHalts(key) });\n    }\n  }\n  safeOpen(key) {\n    const g = this.game, s = SITES[key];\n    if (!g.story.safehouses.has(key)) return false;\n    return true;\n  }\n  /** Clear the guards first where there are any. */\n  tick() {\n    const g = this.game;\n    const wt = g.actors.squads.get('water-tower');\n    if (wt && wt.alive === 0 && !g.story.safehouses.has('water-tower')) { g.story.safehouses.add('water-tower'); g.map.see('water-tower'); g.notice('THE WATER TOWER IS EMPTY NOW. THERE IS A COT.', 4); }\n    for (const [k, h] of Object.entries(HALTS)) if (!g.story.halts.has(k) && Math.hypot(g.player.feet.x - h.at[0], g.player.feet.z - h.at[1]) < 22 && !g.player.seat) { g.story.halts.add(k); }\n    for (const [k, s] of Object.entries(SITES)) if (!g.map.seen.has(k) && Math.hypot(g.player.feet.x - s.at[0], g.player.feet.z - s.at[1]) < Math.max(70, s.r + 30)) g.map.see(k);\n    for (const t of TRIGS) if (!g.map.seen.has(t.id) && Math.hypot(g.player.feet.x - t.at[0], g.player.feet.z - t.at[1]) < 80) g.map.see(t.id);\n    // Close by, an unfound case shows where it is.\n  }\n  talkVerb(who) {\n    const g = this.game;\n    const offers = g.missions.available(who);\n    if (who === 'odile' && !g.missions.active) {\n      if (offers.length) return 'TAKE A CRATE FROM ODILE';\n    }\n    if (offers.length) return `TALK TO ${who.toUpperCase()}`;\n    return `TALK TO ${who.toUpperCase()}`;\n  }\n  talk(who, n) {\n    const g = this.game;\n    const offers = g.missions.available(who).filter((m) => !m.side);\n    const sides = g.missions.available(who).filter((m) => m.side);\n    if (offers.length) { g.missions.offer(offers[0], n); return; }\n    if (sides.length) { g.missions.offer(sides[0], n); return; }\n    const key = GIVER_LINES[who];\n    const line = key && g.dialogue.pick(key);\n    if (line) { g.faceNpc(n); g.dialogue.play([[who, line]], { onEnd: () => g.faceNpc(null) }); }\n  }\n  noteReady() {\n    const g = this.game;\n    return g.missions.canStart(MISSIONS.m7) || (g.missions.done.has('m8') && g.missions.canStart(MISSIONS.m9));\n  }\n  readNote() {\n    const g = this.game;\n    const m = g.missions.canStart(MISSIONS.m7) ? MISSIONS.m7 : MISSIONS.m9;\n    g.sfx.play('map-paper');\n    if (m.id === 'm7') g.dialogue.play('m7.note', { onEnd: () => g.missions.offer(m, null) });\n    else g.dialogue.play([['harrow', 'COME UP. BRING THE MAP. IT IS RAINING, SO NOTHING WILL HAPPEN.']], { onEnd: () => g.missions.offer(m, null) });\n  }\n  resupply() {\n    const g = this.game, w = g.weapons;\n    for (const s of ['sidearm', 'main', 'special']) { const gun = w.slots[s]; if (gun) { const def = WEAPONSDEF[gun.id]; gun.reserve = Math.round((def.reserve ?? 0) * (w.hasBelt ? 1.5 : 1)); gun.mag = def.mag ?? gun.mag; } }\n    g.body.syrettes = g.body.maxSyrettes;\n    w.bottles = Math.max(w.bottles, g.story.unlocked.has('molotov') ? 3 : 0);\n    g.sfx.play('gun-mag');\n    g.notice('AMMUNITION. SYRETTES. COUNT THEM IF YOU LIKE.', 2.5);\n    g.events.emit('resupply');\n  }\n  trig(t) {\n    const g = this.game;\n    g.story.trigsDone.add(t.id);\n    const n = g.story.trigsDone.size;\n    g.map.addNote(MARGIN_NOTES[n - 1]);\n    g.sfx.play('note-scratch', { volume: 0.7 });\n    g.say('harrow', MARGIN_NOTES[n - 1], Math.max(4, MARGIN_NOTES[n - 1].length / 15));\n    g.events.emit('trig', t.id, n);\n    if (n === 6) {\n      g.story.unlocked.add('empire');\n      g.map.addNote(ALL_TRIGS_NOTE);\n      g.after(5, () => g.say('harrow', ALL_TRIGS_NOTE, 6));\n    }\n  }\n  takeCase(c) {\n    const g = this.game;\n    g.story.casesDone.add(c.id);\n    if (this.caseObjs[c.id]) this.caseObjs[c.id].visible = false;\n    g.missions.pay(c.stones);\n    g.notice(`${c.stones} STONES`, 2.5);\n    g.sfx.play('ui-stone');\n    g.events.emit('case', c.id, c.stones);\n    g.hudTouch('stones');\n  }\n  spawnStoryCase(id, x, z, stones) {\n    const g = this.game, ctx = g.ctx, y = g.world.heightAt(x, z);\n    const built = buildModel('stone-case', { catalog: MODELS });\n    built.object.position.set(x, y + 0.02, z);\n    setLookLayer(built.object, 'actors');\n    ctx.scene.add(built.object);\n    const entry = { x, z, id, object: built.object };\n    entry.usable = g.interact.add({ tag: 'mission', id, x, y: y + 0.3, z, r: 2.6, wide: true, verb: () => 'TAKE THE CASE', onUse: () => {\n      ctx.scene.remove(built.object);\n      g.interact.remove(entry.usable);\n      delete this.storyCases[id];\n      if (stones) { g.missions.pay(stones); g.notice(`${stones} STONES`, 2.5); g.sfx.play('ui-stone'); }\n      g.events.emit('collected', id);\n    } });\n    this.storyCases[id] = entry;\n    return entry;\n  }\n  /** Nearest unfound case, for the tracker. */\n  nearestCase() {\n    const g = this.game, f = g.player.feet;\n    let best = Infinity, at = null;\n    for (const c of CASES) { if (g.story.casesDone.has(c.id)) continue; const d = Math.hypot(c.at[0] - f.x, c.at[1] - f.z); if (d < best) { best = d; at = c.at; } }\n    for (const e of Object.values(this.storyCases)) { const d = Math.hypot(e.x - f.x, e.z - f.z); if (d < best) { best = d; at = [e.x, e.z]; } }\n    return { d: best, at };\n  }\n  /** Raised in the left hand: an LED and a beep that speeds up and turns green within 60 m. */\n  stepTracker(dt) {\n    const g = this.game;\n    if (!this.trackerOn) return;\n    const { d } = this.nearestCase();\n    const near = d < 60;\n    const interval = near ? Math.max(0.1, (d / 60) * 0.7) : 1.4;\n    this.trackerBeepT -= dt;\n    if (this.trackerBeepT <= 0) {\n      this.trackerBeepT = interval;\n      g.sfx.play(near ? 'tracker-near' : 'tracker-beep', { volume: 0.5 });\n      g.vm.named['led-on'].visible = near;\n      g.vm.named['led-off'].visible = !near;\n      g.trackerBeeps = (g.trackerBeeps ?? 0) + 1;\n    }\n    this.lastInterval = interval;\n    this.nearLit = near;\n  }\n  setTracker(on) {\n    const g = this.game;\n    if (on === this.trackerOn) return;\n    this.trackerOn = on;\n    if (on) {\n      if (!g.player.seat) { g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); g.vm.named['p-trk'].visible = true; g.vm.propsOn.add('p-trk'); g.vm.named['led-off'].visible = true; g.vm.propsOn.add('led-off'); g.vm.propsOn.add('led-on'); g.vm.play('TrackerUp', { keep: true }); }\n      g.sfx.play('tracker-beep', { volume: 0.4 });\n      g.events.emit('tracker-up');\n    } else {\n      if (!g.player.seat) { g.vm.endAction(); g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); }\n    }\n  }\n  resetAll() {\n    for (const c of Object.values(this.caseObjs)) c.visible = true;\n    for (const e of Object.values(this.storyCases)) { this.game.ctx.scene.remove(e.object); this.game.interact.remove(e.usable); }\n    this.storyCases = {};\n    this.trackerOn = false;\n  }\n  applySaved() { for (const id of this.game.story.casesDone) if (this.caseObjs[id]) this.caseObjs[id].visible = false; }\n}\nimport { WEAPONS as WEAPONSDEF } from '../content/weapons.js';\nEOF\ncat > src/missions/scene.js <<'EOF'\n// Scenes: holding the camera on someone, the fall and the wake, the rescue, Harrow's table, the ending.\nimport { THREE, Timeline, toonMaterial, setLookLayer, PALETTE } from '../../pixel-engine.js';\nimport { SITES } from '../content/sites.js';\nimport { LINES } from '../content/dialogue.js';\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\nconst { Mesh, PlaneGeometry } = THREE;\nexport class SceneDirector {\n  active = false; locksMove = false; face = null; timeline = null; bars = 0; custom = null;\n  constructor(game) { this.game = game; }\n  /** The camera holds on the speaker; the world goes on. */\n  faceAt(target) { this.face = target; this.locksMove = !!target; }\n  update(ctx, dt) {\n    const g = this.game, rig = ctx.camera;\n    if (this.face && !this.custom) {\n      const eye = g.player.eye;\n      const [x, y, z] = typeof this.face === 'function' ? this.face() : this.face;\n      const dx = x - eye.x, dy = y - eye.y, dz = z - eye.z;\n      const wantYaw = Math.atan2(-dx, -dz), wantPitch = Math.atan2(dy, Math.hypot(dx, dz));\n      const k = 1 - Math.exp(-dt * 5);\n      rig.yaw += wrapAngle(wantYaw - rig.yaw) * k;\n      rig.pitch += (wantPitch - rig.pitch) * k;\n    }\n    if (this.custom) {\n      this.custom.t += dt;\n      const done = this.custom.step(this.custom.t, dt);\n      if (done) { const f = this.custom.onEnd; this.custom = null; this.active = false; this.locksMove = false; g.cam.override = null; f?.(); }\n    }\n    this.bars = lerp(this.bars, this.active ? 1 : 0, 1 - Math.exp(-dt * 6));\n  }\n  /** Frame-driven scene with its own camera: step(t, dt) returns true when finished. */\n  play(step, onEnd) {\n    this.custom = { t: 0, step, onEnd };\n    this.active = true; this.locksMove = true;\n  }\n  stop() { this.custom = null; this.active = false; this.locksMove = false; this.face = null; this.game.cam.override = null; }\n  /** Dragged backward in first person: low camera, sky, their boots, their gunfire, while they swear at you. */\n  playRescue(buddy, done) {\n    const g = this.game, ctx = g.ctx;\n    const f = g.player.feet.clone();\n    const yaw = g.player.yaw;\n    const bx = -Math.sin(yaw), bz = -Math.cos(yaw);\n    if (g.player.seat) g.driving.eject();\n    g.map.raise(false);\n    g.vm.setVisible(false);\n    g.events.emit('rescue-start', buddy);\n    const wasActive = buddy.active;\n    const hp = wasActive ? buddy.hp : 200;\n    if (!wasActive) buddy.spawn(ctx, f.x + bx * 1.6, f.z + bz * 1.6, { hp, following: false });\n    buddy.fireProof = true;\n    buddy.goal = null;\n    const line = g.dialogue.pick(`${buddy.id}.rescue`) ?? 'GET UP.';\n    g.say(buddy.id, line, 3.4); g.voice.say(buddy.id, line);\n    g.sky?.fog && (ctx.engine.shake.add(0.3));\n    const dragDist = 7;\n    const dur = 4.4;\n    const r = g.rng.fx;\n    let shotT = 0.4;\n    g.body.hp = 1;\n    this.play((t, dt) => {\n      const k = clamp(t / dur, 0, 1);\n      const px = f.x + bx * dragDist * k, pz = f.z + bz * dragDist * k;\n      const y = g.world.heightAt(px, pz) + 0.32 + Math.sin(t * 7) * 0.04;\n      // You look back along the way you came, tilted to the sky; they walk backward above you.\n      if (buddy.view) {\n        const ax = px + bx * 1.1, az = pz + bz * 1.1, ay = g.world.heightAt(ax, az);\n        buddy.cc.teleport([ax, ay + 0.1, az]);\n        buddy.x = ax; buddy.z = az; buddy.y = ay;\n        buddy.yaw = Math.atan2(bx, bz) + Math.PI;\n        buddy.view.anim.set('DragBackward', 'DragBackward', 0.1);\n        buddy.moveWanted = 0;\n        buddy.scripted = true;\n      }\n      g.cam.override = { position: [px, y, pz], target: [px + bx * 1.6 + Math.sin(t * 3) * 0.1, y + 1.1, pz + bz * 1.6] };\n      shotT -= dt;\n      if (shotT <= 0) {\n        shotT = r.range(0.3, 0.9);\n        g.sfx.play('gun-tractor', { volume: 0.5 });\n        const e = g.player.eye;\n        g.fx.tracer(px + bx * 1, y + 1.1, pz + bz * 1, px - bx * 30 + r.range(-8, 8), y + r.range(0, 4), pz - bz * 30 + r.range(-8, 8));\n      }\n      return t >= dur;\n    }, () => {\n      const nx = f.x + bx * dragDist, nz = f.z + bz * dragDist;\n      g.player.teleport(nx, nz);\n      g.player.setYaw(yaw + Math.PI, 0);\n      g.vm.setVisible(true);\n      buddy.scripted = false; buddy.fireProof = false;\n      if (!wasActive) { g.after(6, () => { if (buddy.active && !buddy.isDown && !g.missions.altBuddyNow) buddy.despawn(); }); }\n      done();\n    });\n  }\n}\nexport class Ending {\n  sceneStep = 0; finished = false;\n  constructor(game) { this.game = game; }\n  /** Sit at the table: Harrow, the lamp, your contract map. */\n  harrowScene(n) {\n    const g = this.game, site = SITES.observatory, ctx = g.ctx;\n    const [sx, sz] = site.at;\n    const lamp = (g.world.byTag.get('table-lamp') ?? [])[0];\n    if (lamp?.build.light && !this.lampLight) this.lampLight = ctx.lights.request({ position: [sx + 0.6, g.world.heightAt(sx, sz) + 1.2, sz + 1.2], color: 0xffd9a0, intensity: 12, radius: 12, flicker: 'torch', name: 'harrow lamp' });\n    if (n) n.play('WriteAtDesk');\n    g.vm.setVisible(false);\n    this.sceneStep = 0;\n    const y = g.world.heightAt(sx, sz);\n    const eye = [sx, y + 1.25, sz + 3.3];\n    this.tableY = y + 0.87;\n    this.shot = { from: eye, at: [sx, y + 1.2, sz], t: 0 };\n    g.player.frozen = true;\n    this.laid = false;\n    g.scene.play((t) => {\n      if (t > 1) this.sceneStep = 1;\n      const c = this.shot;\n      const k = this.laid ? clamp((t - this.laidAt) / 2.5, 0, 1) : 0;\n      const pos = [lerp(c.from[0], sx, k), lerp(c.from[1], y + 2.1, k), lerp(c.from[2], sz + 1.6, k)];\n      const tgt = [lerp(c.at[0], sx - 0.05, k), lerp(c.at[1], this.tableY, k), lerp(c.at[2], sz + 1.22, k)];\n      g.cam.override = { position: pos, target: tgt };\n      this.t = t;\n      return this.endScene;\n    }, () => {\n      g.player.frozen = false;\n      g.vm.setVisible(true);\n      if (this.lampLight) { this.lampLight.release(); this.lampLight = null; }\n      if (this.tableMap) { ctx.scene.remove(this.tableMap); this.tableMap = null; }\n      g.map.glowScar = false;\n      g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    });\n  }\n  layMap() {\n    const g = this.game, ctx = g.ctx, site = SITES.observatory;\n    g.map.glowScar = true;\n    g.map.redraw();\n    const m = new Mesh(new PlaneGeometry(1.1, 0.825), g.map.mat);\n    m.rotation.x = -Math.PI / 2;\n    m.position.set(site.at[0] - 0.05, this.tableY + 0.015, site.at[1] + 1.22);\n    setLookLayer(m, 'actors');\n    ctx.scene.add(m);\n    this.tableMap = m;\n    this.laid = true; this.laidAt = this.t ?? 0;\n    g.sfx.play('map-paper');\n    g.events.emit('scars-glow');\n  }\n  shootHarrow() {\n    const g = this.game, n = g.npcs.byWho.harrow;\n    g.sfx.play('gun-m38');\n    g.ctx.engine.shake.add(0.3);\n    g.rumble(0.8, 0.2);\n    if (n?.view) n.view.anim.set('Death');\n    g.story.flags.harrowDead = true;\n    g.ctx.particles.burst('blood', n ? n.head() : [0, 0, 0], { count: 18 });\n  }\n  endHarrowScene() { this.endScene = true; }\n  finish(sheet) {\n    const g = this.game;\n    if (this.finished) return;\n    this.finished = true;\n    g.story.ending = sheet;\n    g.story.flags.finished = true;\n    g.missions.done.add('end');\n    g.events.emit('ending', sheet);\n    g.endingMusic = true;\n    g.music.force('end', g.realT);\n    g.ui.openEnding(sheet);\n    g.save.write('ending');\n  }\n}\nEOF\necho ok","description":"Write saves, places, scene director and ending"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":35185,"cache_read_input_tokens":476434,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":35185},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"71ec49de-27ff-45fb-a784-9f3cf302f915","uuid":"484a2e2d-0a93-4c50-ac60-61b4b7581c98","timestamp":"2026-11-06T00:08:37.255Z","request_id":"req_011CgkhX59nxAnDicbaWRXTE","wire_tool_inputs":{"toolu_01KaSbp5Jk3DhLa72T2gboUg":{"command":"set -e\npython3 - <<'EOF'\np='src/content/sites.js'; s=open(p).read()\ns=s.replace(\"['table-lamp', 0, 2, 0],\",\"['table-lamp', 0, 1.2, 0], ['stool', 0, -0.1, 0],\")\ns=s.replace(\"npcs: [{ who: 'harrow', dx: 0, dz: 0, yaw: 180 }],\",\"npcs: [{ who: 'harrow', dx: 0, dz: 0, yaw: 0 }],\")\nopen(p,'w').write(s)\nEOF\ncat > src/core/save.js <<'EOF'\n// Single slot, versioned JSON. Written on sleep and on mission complete; read through input.send so replays stay exact.\nimport { storyToJson, storyFromJson } from '../missions/story.js';\nconst KEY = 'far-cry-uncle.save.v1';\nexport const SETTINGS_KEY = 'far-cry-uncle.settings.v1';\nconst store = () => { try { return typeof localStorage !== 'undefined' ? localStorage : null; } catch { return null; } };\nexport class Save {\n  disabled = false; lastWritten = null; pendingLoad = null;\n  constructor(game) { this.game = game; }\n  exists() { const s = store(); try { return !!(s && s.getItem(KEY)); } catch { return false; } }\n  read() { const s = store(); try { const raw = s?.getItem(KEY); return raw ? JSON.parse(raw) : null; } catch { return null; } }\n  snapshot(reason) {\n    const g = this.game;\n    return {\n      version: 1, reason, story: storyToJson(g.story), weapons: g.weapons.snapshot(),\n      body: { hp: Math.max(40, Math.round(g.body.hp)), syrettes: g.body.syrettes, maxSyrettes: g.body.maxSyrettes, tablets: g.body.tablets, feverIn: g.body.feverIn, feverAct: g.body.feverAct },\n      pos: g.lastSafe ?? [g.player.feet.x, g.player.feet.z], yaw: g.player.yaw, hour: g.clock.hour, abs: g.clock.abs, day: g.clock.day,\n      fire: g.fire.encode(), done: [...g.missions.done], ledger: g.ledger.toJson(),\n      buddies: g.actors.buddies.map((b) => ({ id: b.id, met: b.met, dead: b.dead, trust: b.trust, spentUntil: b.spentUntil, woundedUntil: b.woundedUntil })),\n      squads: [...g.actors.squads.entries()].filter(([k, s]) => POST_LIKE(k)).map(([k, s]) => [k, s.alive, s.clearedAt]),\n      seen: [...g.map.seen], notes: g.map.notes, wind: [g.wind.dir, g.wind.speed], hasKit: g.vehicles.hasKit,\n    };\n  }\n  write(reason = 'manual') {\n    const g = this.game;\n    if (this.disabled || g.round) return false;\n    const data = this.snapshot(reason);\n    this.lastWritten = data;\n    const s = store();\n    try { s?.setItem(KEY, JSON.stringify(data)); } catch { return false; }\n    return true;\n  }\n  /** A round trip through the input so a replay reproduces it. */\n  requestLoad() {\n    const data = this.read() ?? this.lastWritten;\n    if (!data) return false;\n    this.game.ctx.input.send({ loadSave: data });\n    return true;\n  }\n  apply(data) {\n    const g = this.game;\n    g.resetCampaign();\n    g.story = storyFromJson(data.story);\n    g.weapons.restoreData(data.weapons);\n    Object.assign(g.body, data.body);\n    g.clock.hour = data.hour; g.clock.abs = data.abs; g.clock.day = data.day;\n    g.fire.hours = data.abs;\n    g.missions.done = new Set(data.done);\n    g.ledger.fromJson(data.ledger);\n    for (const b of data.buddies) Object.assign(g.actors.buddy(b.id), b);\n    for (const [k, alive, clearedAt] of data.squads ?? []) { const s = g.actors.squads.get(k); if (s) { s.alive = alive; s.clearedAt = clearedAt; } }\n    g.map.seen = new Set(data.seen); g.map.notes = data.notes;\n    g.wind.dir = data.wind[0]; g.wind.speed = data.wind[1];\n    g.vehicles.hasKit = data.hasKit;\n    // The land remembers: repaint scars.\n    g.fire.decode(data.fire);\n    for (let id = 0; id < 65536; id++) {\n      const st = g.fire.state[id];\n      if (st === 2) { g.world.paintFireCell(id, 'burnt'); g.world.burnTreesIn(id); for (const ex of g.world.explosives) if (ex.alive && g.fire.idOf(ex.x, ex.z) === id) { ex.alive = false; ex.object.visible = false; for (const c of ex.colliders) c.setEnabled?.(false); } }\n      else if (st === 3) g.world.paintFireCell(id, 'green');\n    }\n    g.lastSafe = data.pos;\n    g.player.teleport(data.pos[0], data.pos[1]);\n    g.player.setYaw(data.yaw, 0);\n    g.sky.apply(g.ctx, g.clock.hour);\n    g.applyStoryToWorld();\n    g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    g.events.emit('loaded');\n  }\n  clear() { const s = store(); try { s?.removeItem(KEY); } catch { /* storage may be blocked */ } }\n}\nconst POST_LIKE = () => true;\nexport const DEFAULT_SETTINGS = { music: 0.1, sfx: 1, voices: 1, sensPad: 1, sensMouse: 1, invertY: false, aimAssist: true, rumble: true, glyphs: 'ps', pixelSize: 'fine', quality: 'auto', fov: 62, subtitleSize: 1, reduceFlashes: false, feverReduced: false };\nexport function loadSettings() {\n  const s = store();\n  try { const raw = s?.getItem(SETTINGS_KEY); return { ...DEFAULT_SETTINGS, ...(raw ? JSON.parse(raw) : {}) }; } catch { return { ...DEFAULT_SETTINGS }; }\n}\nexport function storeSettings(v) { const s = store(); try { s?.setItem(SETTINGS_KEY, JSON.stringify(v)); } catch { /* storage may be blocked */ } }\nEOF\ncat > src/world/places.js <<'EOF'\n// Everything you can walk up to: givers, the notice board, safehouses, trig points, stone cases, rail halts.\nimport { THREE, buildModel, setLookLayer } from '../../pixel-engine.js';\nimport { MODELS } from '../art/models.js';\nimport { SITES, TRIGS, CASES, HALTS } from '../content/sites.js';\nimport { MARGIN_NOTES, ALL_TRIGS_NOTE } from '../content/notes.js';\nimport { GIVER_LINES } from '../content/missions.js';\nimport { LINES } from '../content/dialogue.js';\nimport { MISSIONS } from '../content/missions.js';\nconst NEAR = 60;\nexport class Places {\n  caseObjs = {}; storyCases = {}; trackerBeepT = 0; trackerOn = false;\n  constructor(game) { this.game = game; }\n  build(ctx) {\n    const g = this.game, I = g.interact;\n    // Givers and talkers.\n    const talkers = ['odile', 'tibor', 'bakr', 'vance', 'ansa', 'ines', 'dov', 'mags'];\n    for (const who of talkers) {\n      const n = g.npcs.byWho[who];\n      if (!n) continue;\n      I.add({ npc: n, liveAt: () => [n.x, n.y + 1.5, n.z], x: n.x, y: n.y, z: n.z, r: 3.2, wide: true, when: () => n.active && !g.missions.active && !g.dialogue.active, verb: () => this.talkVerb(who), onUse: () => this.talk(who, n) });\n    }\n    // The notice board.\n    const m40 = SITES['mile-forty'];\n    I.add({ x: m40.at[0], y: g.world.heightAt(m40.at[0], m40.at[1] + 18) + 1.5, z: m40.at[1] + 18, r: 3, wide: true, verb: () => 'READ THE NOTICE BOARD', when: () => !g.dialogue.active, onUse: () => g.ui.openBoard() });\n    // Tibor's rack.\n    const tib = g.npcs.byWho.tibor;\n    I.add({ x: tib.x + 2.2, y: tib.y + 1.2, z: tib.z + 2, r: 3.2, wide: true, when: () => g.story.truce, verb: () => \"LOOK AT TIBOR'S RACK\", onUse: () => g.ui.openRack() });\n    // Safehouses.\n    for (const [key, site] of Object.entries(SITES)) {\n      if (!site.safe) continue;\n      const open = () => this.safeOpen(key);\n      const f = (d) => [site.at[0] + d[0], site.at[1] + d[1]];\n      const y = (x, z) => g.world.heightAt(x, z);\n      const b = f(site.safe.bed), l = f(site.safe.locker), c = f(site.safe.crate), w = f(site.safe.wall);\n      I.add({ x: b[0], y: y(b[0], b[1]) + 0.7, z: b[1], r: 2.8, wide: true, when: open, verb: () => 'SLEEP', onUse: () => g.ui.openBed(key) });\n      I.add({ x: l[0], y: y(l[0], l[1]) + 1, z: l[1], r: 2.6, wide: true, when: open, verb: () => 'OPEN THE LOCKER', onUse: () => g.ui.openLocker() });\n      I.add({ x: c[0], y: y(c[0], c[1]) + 0.6, z: c[1], r: 2.6, wide: true, when: open, verb: () => 'TAKE AMMO AND SYRETTES', onUse: () => this.resupply() });\n      I.add({ x: w[0], y: y(w[0], w[1]) + 1.4, z: w[1], r: 2.8, wide: true, when: open, verb: () => 'READ THE WALL', onUse: () => g.ui.openWall() });\n      // Harrow's note waits at every safehouse once all four jobs are done.\n      I.add({ x: b[0], y: y(b[0], b[1]) + 1.2, z: b[1] + 0.8, r: 3.2, wide: true, when: () => open() && this.noteReady(), verb: () => 'READ THE NOTE ON THE COT', onUse: () => this.readNote() });\n    }\n    // Trig points.\n    for (const t of TRIGS) {\n      I.add({ id: t.id, x: t.at[0], y: g.world.heightAt(t.at[0], t.at[1]) + 1.2, z: t.at[1], r: 3, wide: true, when: () => !g.story.trigsDone.has(t.id), verb: () => 'TAKE A BEARING', onUse: () => this.trig(t) });\n    }\n    // Stone cases.\n    for (const c of CASES) {\n      const x = c.at[0], z = c.at[1], yy = g.world.heightAt(x, z);\n      const built = buildModel('stone-case', { catalog: MODELS });\n      built.object.position.set(x, yy + 0.02, z);\n      setLookLayer(built.object, 'actors');\n      ctx.scene.add(built.object);\n      this.caseObjs[c.id] = built.object;\n      I.add({ id: c.id, caseId: c.id, x, y: yy + 0.3, z, r: 2.4, wide: true, when: () => !g.story.casesDone.has(c.id), verb: () => 'TAKE THE CASE', onUse: () => this.takeCase(c) });\n    }\n    // Rail halts.\n    for (const [key, h] of Object.entries(HALTS)) {\n      const x = h.at[0] - 3, z = h.at[1] - 5;\n      I.add({ x, y: g.world.heightAt(x, z) + 1, z, r: 4, wide: true, verb: () => 'RAIL HALT', when: () => !g.missions.active && g.story.flags.arrived, onUse: () => g.ui.openHalts(key) });\n    }\n  }\n  safeOpen(key) {\n    const g = this.game, s = SITES[key];\n    if (!g.story.safehouses.has(key)) return false;\n    return true;\n  }\n  /** Clear the guards first where there are any. */\n  tick() {\n    const g = this.game;\n    const wt = g.actors.squads.get('water-tower');\n    if (wt && wt.alive === 0 && !g.story.safehouses.has('water-tower')) { g.story.safehouses.add('water-tower'); g.map.see('water-tower'); g.notice('THE WATER TOWER IS EMPTY NOW. THERE IS A COT.', 4); }\n    for (const [k, h] of Object.entries(HALTS)) if (!g.story.halts.has(k) && Math.hypot(g.player.feet.x - h.at[0], g.player.feet.z - h.at[1]) < 22 && !g.player.seat) { g.story.halts.add(k); }\n    for (const [k, s] of Object.entries(SITES)) if (!g.map.seen.has(k) && Math.hypot(g.player.feet.x - s.at[0], g.player.feet.z - s.at[1]) < Math.max(70, s.r + 30)) g.map.see(k);\n    for (const t of TRIGS) if (!g.map.seen.has(t.id) && Math.hypot(g.player.feet.x - t.at[0], g.player.feet.z - t.at[1]) < 80) g.map.see(t.id);\n    // Close by, an unfound case shows where it is.\n  }\n  talkVerb(who) {\n    const g = this.game;\n    const offers = g.missions.available(who);\n    if (who === 'odile' && !g.missions.active) {\n      if (offers.length) return 'TAKE A CRATE FROM ODILE';\n    }\n    if (offers.length) return `TALK TO ${who.toUpperCase()}`;\n    return `TALK TO ${who.toUpperCase()}`;\n  }\n  talk(who, n) {\n    const g = this.game;\n    const offers = g.missions.available(who).filter((m) => !m.side);\n    const sides = g.missions.available(who).filter((m) => m.side);\n    if (offers.length) { g.missions.offer(offers[0], n); return; }\n    if (sides.length) { g.missions.offer(sides[0], n); return; }\n    const key = GIVER_LINES[who];\n    const line = key && g.dialogue.pick(key);\n    if (line) { g.faceNpc(n); g.dialogue.play([[who, line]], { onEnd: () => g.faceNpc(null) }); }\n  }\n  noteReady() {\n    const g = this.game;\n    return g.missions.canStart(MISSIONS.m7) || (g.missions.done.has('m8') && g.missions.canStart(MISSIONS.m9));\n  }\n  readNote() {\n    const g = this.game;\n    const m = g.missions.canStart(MISSIONS.m7) ? MISSIONS.m7 : MISSIONS.m9;\n    g.sfx.play('map-paper');\n    if (m.id === 'm7') g.dialogue.play('m7.note', { onEnd: () => g.missions.offer(m, null) });\n    else g.dialogue.play([['harrow', 'COME UP. BRING THE MAP. IT IS RAINING, SO NOTHING WILL HAPPEN.']], { onEnd: () => g.missions.offer(m, null) });\n  }\n  resupply() {\n    const g = this.game, w = g.weapons;\n    for (const s of ['sidearm', 'main', 'special']) { const gun = w.slots[s]; if (gun) { const def = WEAPONSDEF[gun.id]; gun.reserve = Math.round((def.reserve ?? 0) * (w.hasBelt ? 1.5 : 1)); gun.mag = def.mag ?? gun.mag; } }\n    g.body.syrettes = g.body.maxSyrettes;\n    w.bottles = Math.max(w.bottles, g.story.unlocked.has('molotov') ? 3 : 0);\n    g.sfx.play('gun-mag');\n    g.notice('AMMUNITION. SYRETTES. COUNT THEM IF YOU LIKE.', 2.5);\n    g.events.emit('resupply');\n  }\n  trig(t) {\n    const g = this.game;\n    g.story.trigsDone.add(t.id);\n    const n = g.story.trigsDone.size;\n    g.map.addNote(MARGIN_NOTES[n - 1]);\n    g.sfx.play('note-scratch', { volume: 0.7 });\n    g.say('harrow', MARGIN_NOTES[n - 1], Math.max(4, MARGIN_NOTES[n - 1].length / 15));\n    g.events.emit('trig', t.id, n);\n    if (n === 6) {\n      g.story.unlocked.add('empire');\n      g.map.addNote(ALL_TRIGS_NOTE);\n      g.after(5, () => g.say('harrow', ALL_TRIGS_NOTE, 6));\n    }\n  }\n  takeCase(c) {\n    const g = this.game;\n    g.story.casesDone.add(c.id);\n    if (this.caseObjs[c.id]) this.caseObjs[c.id].visible = false;\n    g.missions.pay(c.stones);\n    g.notice(`${c.stones} STONES`, 2.5);\n    g.sfx.play('ui-stone');\n    g.events.emit('case', c.id, c.stones);\n    g.hudTouch('stones');\n  }\n  spawnStoryCase(id, x, z, stones) {\n    const g = this.game, ctx = g.ctx, y = g.world.heightAt(x, z);\n    const built = buildModel('stone-case', { catalog: MODELS });\n    built.object.position.set(x, y + 0.02, z);\n    setLookLayer(built.object, 'actors');\n    ctx.scene.add(built.object);\n    const entry = { x, z, id, object: built.object };\n    entry.usable = g.interact.add({ tag: 'mission', id, x, y: y + 0.3, z, r: 2.6, wide: true, verb: () => 'TAKE THE CASE', onUse: () => {\n      ctx.scene.remove(built.object);\n      g.interact.remove(entry.usable);\n      delete this.storyCases[id];\n      if (stones) { g.missions.pay(stones); g.notice(`${stones} STONES`, 2.5); g.sfx.play('ui-stone'); }\n      g.events.emit('collected', id);\n    } });\n    this.storyCases[id] = entry;\n    return entry;\n  }\n  /** Nearest unfound case, for the tracker. */\n  nearestCase() {\n    const g = this.game, f = g.player.feet;\n    let best = Infinity, at = null;\n    for (const c of CASES) { if (g.story.casesDone.has(c.id)) continue; const d = Math.hypot(c.at[0] - f.x, c.at[1] - f.z); if (d < best) { best = d; at = c.at; } }\n    for (const e of Object.values(this.storyCases)) { const d = Math.hypot(e.x - f.x, e.z - f.z); if (d < best) { best = d; at = [e.x, e.z]; } }\n    return { d: best, at };\n  }\n  /** Raised in the left hand: an LED and a beep that speeds up and turns green within 60 m. */\n  stepTracker(dt) {\n    const g = this.game;\n    if (!this.trackerOn) return;\n    const { d } = this.nearestCase();\n    const near = d < 60;\n    const interval = near ? Math.max(0.1, (d / 60) * 0.7) : 1.4;\n    this.trackerBeepT -= dt;\n    if (this.trackerBeepT <= 0) {\n      this.trackerBeepT = interval;\n      g.sfx.play(near ? 'tracker-near' : 'tracker-beep', { volume: 0.5 });\n      g.vm.named['led-on'].visible = near;\n      g.vm.named['led-off'].visible = !near;\n      g.trackerBeeps = (g.trackerBeeps ?? 0) + 1;\n    }\n    this.lastInterval = interval;\n    this.nearLit = near;\n  }\n  setTracker(on) {\n    const g = this.game;\n    if (on === this.trackerOn) return;\n    this.trackerOn = on;\n    if (on) {\n      if (!g.player.seat) { g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); g.vm.named['p-trk'].visible = true; g.vm.propsOn.add('p-trk'); g.vm.named['led-off'].visible = true; g.vm.propsOn.add('led-off'); g.vm.propsOn.add('led-on'); g.vm.play('TrackerUp', { keep: true }); }\n      g.sfx.play('tracker-beep', { volume: 0.4 });\n      g.events.emit('tracker-up');\n    } else {\n      if (!g.player.seat) { g.vm.endAction(); g.vm.showGun(g.weapons.gun?.id ?? 'cane', false); }\n    }\n  }\n  resetAll() {\n    for (const c of Object.values(this.caseObjs)) c.visible = true;\n    for (const e of Object.values(this.storyCases)) { this.game.ctx.scene.remove(e.object); this.game.interact.remove(e.usable); }\n    this.storyCases = {};\n    this.trackerOn = false;\n  }\n  applySaved() { for (const id of this.game.story.casesDone) if (this.caseObjs[id]) this.caseObjs[id].visible = false; }\n}\nimport { WEAPONS as WEAPONSDEF } from '../content/weapons.js';\nEOF\ncat > src/missions/scene.js <<'EOF'\n// Scenes: holding the camera on someone, the fall and the wake, the rescue, Harrow's table, the ending.\nimport { THREE, Timeline, toonMaterial, setLookLayer, PALETTE } from '../../pixel-engine.js';\nimport { SITES } from '../content/sites.js';\nimport { LINES } from '../content/dialogue.js';\nimport { clamp, lerp, wrapAngle } from '../core/rng.js';\nconst { Mesh, PlaneGeometry } = THREE;\nexport class SceneDirector {\n  active = false; locksMove = false; face = null; timeline = null; bars = 0; custom = null;\n  constructor(game) { this.game = game; }\n  /** The camera holds on the speaker; the world goes on. */\n  faceAt(target) { this.face = target; this.locksMove = !!target; }\n  update(ctx, dt) {\n    const g = this.game, rig = ctx.camera;\n    if (this.face && !this.custom) {\n      const eye = g.player.eye;\n      const [x, y, z] = typeof this.face === 'function' ? this.face() : this.face;\n      const dx = x - eye.x, dy = y - eye.y, dz = z - eye.z;\n      const wantYaw = Math.atan2(-dx, -dz), wantPitch = Math.atan2(dy, Math.hypot(dx, dz));\n      const k = 1 - Math.exp(-dt * 5);\n      rig.yaw += wrapAngle(wantYaw - rig.yaw) * k;\n      rig.pitch += (wantPitch - rig.pitch) * k;\n    }\n    if (this.custom) {\n      this.custom.t += dt;\n      const done = this.custom.step(this.custom.t, dt);\n      if (done) { const f = this.custom.onEnd; this.custom = null; this.active = false; this.locksMove = false; g.cam.override = null; f?.(); }\n    }\n    this.bars = lerp(this.bars, this.active ? 1 : 0, 1 - Math.exp(-dt * 6));\n  }\n  /** Frame-driven scene with its own camera: step(t, dt) returns true when finished. */\n  play(step, onEnd) {\n    this.custom = { t: 0, step, onEnd };\n    this.active = true; this.locksMove = true;\n  }\n  stop() { this.custom = null; this.active = false; this.locksMove = false; this.face = null; this.game.cam.override = null; }\n  /** Dragged backward in first person: low camera, sky, their boots, their gunfire, while they swear at you. */\n  playRescue(buddy, done) {\n    const g = this.game, ctx = g.ctx;\n    const f = g.player.feet.clone();\n    const yaw = g.player.yaw;\n    const bx = -Math.sin(yaw), bz = -Math.cos(yaw);\n    if (g.player.seat) g.driving.eject();\n    g.map.raise(false);\n    g.vm.setVisible(false);\n    g.events.emit('rescue-start', buddy);\n    const wasActive = buddy.active;\n    const hp = wasActive ? buddy.hp : 200;\n    if (!wasActive) buddy.spawn(ctx, f.x + bx * 1.6, f.z + bz * 1.6, { hp, following: false });\n    buddy.fireProof = true;\n    buddy.goal = null;\n    const line = g.dialogue.pick(`${buddy.id}.rescue`) ?? 'GET UP.';\n    g.say(buddy.id, line, 3.4); g.voice.say(buddy.id, line);\n    g.sky?.fog && (ctx.engine.shake.add(0.3));\n    const dragDist = 7;\n    const dur = 4.4;\n    const r = g.rng.fx;\n    let shotT = 0.4;\n    g.body.hp = 1;\n    this.play((t, dt) => {\n      const k = clamp(t / dur, 0, 1);\n      const px = f.x + bx * dragDist * k, pz = f.z + bz * dragDist * k;\n      const y = g.world.heightAt(px, pz) + 0.32 + Math.sin(t * 7) * 0.04;\n      // You look back along the way you came, tilted to the sky; they walk backward above you.\n      if (buddy.view) {\n        const ax = px + bx * 1.1, az = pz + bz * 1.1, ay = g.world.heightAt(ax, az);\n        buddy.cc.teleport([ax, ay + 0.1, az]);\n        buddy.x = ax; buddy.z = az; buddy.y = ay;\n        buddy.yaw = Math.atan2(bx, bz) + Math.PI;\n        buddy.view.anim.set('DragBackward', 'DragBackward', 0.1);\n        buddy.moveWanted = 0;\n        buddy.scripted = true;\n      }\n      g.cam.override = { position: [px, y, pz], target: [px + bx * 1.6 + Math.sin(t * 3) * 0.1, y + 1.1, pz + bz * 1.6] };\n      shotT -= dt;\n      if (shotT <= 0) {\n        shotT = r.range(0.3, 0.9);\n        g.sfx.play('gun-tractor', { volume: 0.5 });\n        const e = g.player.eye;\n        g.fx.tracer(px + bx * 1, y + 1.1, pz + bz * 1, px - bx * 30 + r.range(-8, 8), y + r.range(0, 4), pz - bz * 30 + r.range(-8, 8));\n      }\n      return t >= dur;\n    }, () => {\n      const nx = f.x + bx * dragDist, nz = f.z + bz * dragDist;\n      g.player.teleport(nx, nz);\n      g.player.setYaw(yaw + Math.PI, 0);\n      g.vm.setVisible(true);\n      buddy.scripted = false; buddy.fireProof = false;\n      if (!wasActive) { g.after(6, () => { if (buddy.active && !buddy.isDown && !g.missions.altBuddyNow) buddy.despawn(); }); }\n      done();\n    });\n  }\n}\nexport class Ending {\n  sceneStep = 0; finished = false;\n  constructor(game) { this.game = game; }\n  /** Sit at the table: Harrow, the lamp, your contract map. */\n  harrowScene(n) {\n    const g = this.game, site = SITES.observatory, ctx = g.ctx;\n    const [sx, sz] = site.at;\n    const lamp = (g.world.byTag.get('table-lamp') ?? [])[0];\n    if (lamp?.build.light && !this.lampLight) this.lampLight = ctx.lights.request({ position: [sx + 0.6, g.world.heightAt(sx, sz) + 1.2, sz + 1.2], color: 0xffd9a0, intensity: 12, radius: 12, flicker: 'torch', name: 'harrow lamp' });\n    if (n) n.play('WriteAtDesk');\n    g.vm.setVisible(false);\n    this.sceneStep = 0;\n    const y = g.world.heightAt(sx, sz);\n    const eye = [sx, y + 1.25, sz + 3.3];\n    this.tableY = y + 0.87;\n    this.shot = { from: eye, at: [sx, y + 1.2, sz], t: 0 };\n    g.player.frozen = true;\n    this.laid = false;\n    g.scene.play((t) => {\n      if (t > 1) this.sceneStep = 1;\n      const c = this.shot;\n      const k = this.laid ? clamp((t - this.laidAt) / 2.5, 0, 1) : 0;\n      const pos = [lerp(c.from[0], sx, k), lerp(c.from[1], y + 2.1, k), lerp(c.from[2], sz + 1.6, k)];\n      const tgt = [lerp(c.at[0], sx - 0.05, k), lerp(c.at[1], this.tableY, k), lerp(c.at[2], sz + 1.22, k)];\n      g.cam.override = { position: pos, target: tgt };\n      this.t = t;\n      return this.endScene;\n    }, () => {\n      g.player.frozen = false;\n      g.vm.setVisible(true);\n      if (this.lampLight) { this.lampLight.release(); this.lampLight = null; }\n      if (this.tableMap) { ctx.scene.remove(this.tableMap); this.tableMap = null; }\n      g.map.glowScar = false;\n      g.vm.showGun(g.weapons.gun?.id ?? 'cane', false);\n    });\n  }\n  layMap() {\n    const g = this.game, ctx = g.ctx, site = SITES.observatory;\n    g.map.glowScar = true;\n    g.map.redraw();\n    const m = new Mesh(new PlaneGeometry(1.1, 0.825), g.map.mat);\n    m.rotation.x = -Math.PI / 2;\n    m.position.set(site.at[0] - 0.05, this.tableY + 0.015, site.at[1] + 1.22);\n    setLookLayer(m, 'actors');\n    ctx.scene.add(m);\n    this.tableMap = m;\n    this.laid = true; this.laidAt = this.t ?? 0;\n    g.sfx.play('map-paper');\n    g.events.emit('scars-glow');\n  }\n  shootHarrow() {\n    const g = this.game, n = g.npcs.byWho.harrow;\n    g.sfx.play('gun-m38');\n    g.ctx.engine.shake.add(0.3);\n    g.rumble(0.8, 0.2);\n    if (n?.view) n.view.anim.set('Death');\n    g.story.flags.harrowDead = true;\n    g.ctx.particles.burst('blood', n ? n.head() : [0, 0, 0], { count: 18 });\n  }\n  endHarrowScene() { this.endScene = true; }\n  finish(sheet) {\n    const g = this.game;\n    if (this.finished) return;\n    this.finished = true;\n    g.story.ending = sheet;\n    g.story.flags.finished = true;\n    g.missions.done.add('end');\n    g.events.emit('ending', sheet);\n    g.endingMusic = true;\n    g.music.force('end', g.realT);\n    g.ui.openEnding(sheet);\n    g.save.write('ending');\n  }\n}\nEOF\necho ok","description":"Write saves, places, scene director and ending"}}}
