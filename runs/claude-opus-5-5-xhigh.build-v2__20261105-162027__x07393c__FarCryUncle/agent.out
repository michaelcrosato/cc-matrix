: [-80, 0, -10], ForearmR: [-80, 0, 0], ArmL: [-30, 0, 10], LegR: [-30, 0, 0], ShinR: [30, 0, 0], LegL: [20, 0, 0], ShinL: [30, 0, 0] }]] },\n  { name: 'DriveSit', frames: 40, loop: true, keys: [[0, { ...seat, ArmR: [-50, 0, -6], ForearmR: [-40, 0, 0], ArmL: [-50, 0, 6], ForearmL: [-40, 0, 0] }], [40, { ...seat, ArmR: [-50, 0, -6], ForearmR: [-40, 0, 0], ArmL: [-50, 0, 6], ForearmL: [-40, 0, 0] }]] },\n  { name: 'UnjamSwear', frames: 36, keys: [[0, aimUpper(0)], [6, { Torso: [10, 14, 4], ArmL: [-60, 0, -10], ForearmL: [-80, 0, 0], ArmR: [-60, 0, -6], ForearmR: [-50, 0, 0], Head: [18, 0, 0] }], [12, { ArmL: [-40, 0, -24], ForearmL: [-90, 0, 0] }], [20, { ArmL: [-60, 0, -10], ForearmL: [-70, 0, 0], Head: [10, 12, 0] }], [28, { ArmL: [-40, 0, -24], ForearmL: [-90, 0, 0], Head: [10, -12, 0] }], [36, aimUpper(0)]] },\n  { name: 'WalkHandsTied', frames: 18, loop: true, keys: [[0, { Pelvis: { r: [3, 0, 0], p: [0, -0.02, 0] }, Torso: [10, 0, 0], Head: [12, 0, 0], ArmR: [18, 0, 12], ForearmR: [-40, 0, 20], ArmL: [18, 0, -12], ForearmL: [-40, 0, -20], LegR: [-22, 0, 0], ShinR: [12, 0, 0], LegL: [14, 0, 0], ShinL: [22, 0, 0] }], [9, { Pelvis: { r: [3, 0, 0], p: [0, -0.04, 0] }, Torso: [10, 0, 0], Head: [12, 0, 0], ArmR: [18, 0, 12], ForearmR: [-40, 0, 20], ArmL: [18, 0, -12], ForearmL: [-40, 0, -20], LegR: [14, 0, 0], ShinR: [22, 0, 0], LegL: [-22, 0, 0], ShinL: [12, 0, 0] }], [18, { Pelvis: { r: [3, 0, 0], p: [0, -0.02, 0] }, Torso: [10, 0, 0], Head: [12, 0, 0], ArmR: [18, 0, 12], ForearmR: [-40, 0, 20], ArmL: [18, 0, -12], ForearmL: [-40, 0, -20], LegR: [-22, 0, 0], ShinR: [12, 0, 0], LegL: [14, 0, 0], ShinL: [22, 0, 0] }]] },\n  { name: 'Shrug', frames: 40, loop: true, keys: [[0, { ...legsStand, ArmR: [-10, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-10, 0, 10], ForearmL: [-30, 0, 0], Head: R }], [14, { ...legsStand, Torso: [0, 6, 0], ArmR: [-20, 0, -26], ForearmR: [-90, 0, 0], ArmL: [-20, 0, 26], ForearmL: [-90, 0, 0], Head: [0, 0, 10] }], [26, { ...legsStand, ArmR: [-20, 0, -26], ForearmR: [-90, 0, 0], ArmL: [-20, 0, 26], ForearmL: [-90, 0, 0], Head: [0, 0, 10] }], [40, { ...legsStand, ArmR: [-10, 0, -10], ForearmR: [-30, 0, 0], ArmL: [-10, 0, 10], ForearmL: [-30, 0, 0], Head: R }]] },\n  { name: 'SmokeIdle', frames: 120, loop: true, keys: [[0, { ...legsStand, ArmL: [-6, 0, 6], ForearmL: [-70, 0, 0], ArmR: [-4, 0, -4], ForearmR: [-12, 0, 0] }], [40, { ...legsStand, ArmL: [-6, 0, 6], ForearmL: [-70, 0, 0], ArmR: [-52, 0, -24], ForearmR: [-118, 0, 0], Head: [-6, 0, 0] }], [70, { ...legsStand, ArmL: [-6, 0, 6], ForearmL: [-70, 0, 0], ArmR: [-52, 0, -24], ForearmR: [-118, 0, 0], Head: [-14, 0, 0] }], [120, { ...legsStand, ArmL: [-6, 0, 6], ForearmL: [-70, 0, 0], ArmR: [-4, 0, -4], ForearmR: [-12, 0, 0] }]] },\n  { name: 'CleanRifleIdle', frames: 60, loop: true, keys: [[0, { ...seat, Torso: [16, 0, 0], Head: [18, 0, 0], ArmR: [-44, 0, -4], ForearmR: [-60, 0, 0], ArmL: [-44, 0, 4], ForearmL: [-54, 0, 0] }], [30, { ...seat, Torso: [18, 0, 0], Head: [20, 0, 0], ArmR: [-54, 0, -4], ForearmR: [-40, 0, 0], ArmL: [-44, 0, 4], ForearmL: [-54, 0, 0] }], [60, { ...seat, Torso: [16, 0, 0], Head: [18, 0, 0], ArmR: [-44, 0, -4], ForearmR: [-60, 0, 0], ArmL: [-44, 0, 4], ForearmL: [-54, 0, 0] }]] },\n  { name: 'WriteAtDesk', frames: 80, loop: true, keys: [[0, { ...seat, Torso: [22, 0, 0], Head: [20, 0, 0], ArmR: [-44, 0, 0], ForearmR: [-50, 0, 0], ArmL: [-40, 0, 6], ForearmL: [-60, 0, 0] }], [20, { ...seat, Torso: [22, 0, 0], Head: [20, 4, 0], ArmR: [-50, 8, 0], ForearmR: [-46, 0, 0], ArmL: [-40, 0, 6], ForearmL: [-60, 0, 0] }], [40, { ...seat, Torso: [22, 0, 0], Head: [20, -4, 0], ArmR: [-44, -8, 0], ForearmR: [-54, 0, 0], ArmL: [-40, 0, 6], ForearmL: [-60, 0, 0] }], [80, { ...seat, Torso: [22, 0, 0], Head: [20, 0, 0], ArmR: [-44, 0, 0], ForearmR: [-50, 0, 0], ArmL: [-40, 0, 6], ForearmL: [-60, 0, 0] }]] },\n  { name: 'TeachPoint', frames: 60, loop: true, keys: [[0, { ...legsStand, Torso: [0, -10, 0], ArmR: [-110, 0, -16], ForearmR: [-14, 0, 0], ArmL: [-