path)\\n    const mo = M.mascot;\\n    mo.kx = mo.kx || 0; mo.kz = mo.kz || 0; mo.kx *= Math.exp(-dt * 2.5); mo.kz *= Math.exp(-dt * 2.5); mo.ox = clamp((mo.ox || 0) + mo.kx * dt, -70, 70); mo.oy = clamp((mo.oy || 0) + mo.kz * dt, -50, 50);\\n    if (M.phase === 'play') { const tp = M.playT || 0; mo.bx = CX + 150 * Math.sin(tp * .7); mo.by = CY + 70 * Math.sin(tp * 1.4); }\\n    mo.x = (mo.bx ?? CX) + (mo.ox || 0); mo.y = (mo.by ?? CY) + (mo.oy || 0);\"),\n(\"      if (d < 14 && M.mascot.down <= 0) { const dx = (sk.x - M.mascot.x) / (d || 1), dy = (sk.y - M.mascot.y) / (d || 1); sk.x = M.mascot.x + dx * 14; sk.y = M.mascot.y + dy * 14; }\",\n \"      if (d < 14 && M.mascot.down <= 0) { const dx = (sk.x - M.mascot.x) / (d || 1), dy = (sk.y - M.mascot.y) / (d || 1); sk.x = M.mascot.x + dx * 14; sk.y = M.mascot.y + dy * 14; M.mascot.kx = (M.mascot.kx || 0) + dx * sk.vx * .5; M.mascot.kz = (M.mascot.kz || 0) + dy * sk.vy * .5; }\"),\n])\nprint('ok')\nEOF\ngrep -n \"M.mascot.x = \\|M.mascot = \" src/*.js | cut -c1-160","description":"Add one-timers, deke beats, mascot mass and Gilded banner"}}}
