 before = T.skateMax;\\ntuneSet('skateMax', before + 10);\\ncheck('a slider moves a value', T.skateMax === before + 10);\\ntuneReset('skateMax');\\ncheck('reset puts the default back', T.skateMax === TUNE_DEFAULTS.skateMax);\"),\n]\nfor old,new in pairs:\n    assert s.count(old)==1,(s.count(old),old[:60]); s=s.replace(old,new)\n# extra: glass, fights, the shootout, records\nextra = \"\"\"\n// 8b. the glass, the fight, the shootout and the records, each called directly\nG.go('match', { cfg: { teams: [0, 1], arena: 0, humans: 0, seed: 21, mode: 'exhibition' } }, { fade: 0 }); step(2);\nconst gcx = [7, 8].find(cx => M().map.cell(cx, 22) === 2);\nsim.breakGlass(gcx, 22, 0);\ncheck('a hit breaks the glass: the cell opens', M().map.cell(gcx, 22) === 0);\nconst fa = M().skaters[0], fb = M().skaters[3];\nfa.x = 400; fa.y = 400; fb.x = 410; fb.y = 400; sim.fightStart(fa, fb);\ncheck('the gloves drop: a fight starts', M().phase === 'fight' && !!M().fight);\nstep(120 * 4);\ncheck('the fight ends, one of them to the sin bin', M().phase !== 'fight' && M().skaters.some(s => s.state === 'bin'));\nG.go('match', { cfg: { teams: [0, 1], arena: 0, humans: 0, seed: 22, mode: 'exhibition' } }, { fade: 0 }); step(2);\nM().score = [2, 2]; M().ot = true; M().clock = 0.01; step(3);\ncheck('a tie in overtime goes to a shootout with a winner', M().soWinner === 0 || M().soWinner === 1);\nconst rBefore = rec().games;\nG.go('match', { cfg: { teams: [0, 1], arena: 0, humans: 0, seed: 23, mode: 'exhibition' } }, { fade: 0 }); step(2);\nM().phase = 'over'; M().over = true; M().timer = 0; M().score = [1, 0]; finishMatch();\ncheck('a finished match goes on the records', rec().games === rBefore + 1);\n\"\"\"\ns=s.replace(\"// 9. the scenes all open\", extra+\"\\n// 9. the scenes all open\")\nopen(p,'w').write(s); print('ok')\nEOF\ncd /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261104-055947__x9a2bbb/work/IceHoc-Kaboom-IceHockey-claude-haiku-5-5-medium-20261104-055947 && node tools/