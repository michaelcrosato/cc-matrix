ed; touch-action: none }</style>\n</head>\n<body>\n<canvas id=\"screen\"></canvas>\n<script>\n${engine}\n</script>\n<script>\n${game}\n</script>\n</body>\n</html>\n`;\nwriteFileSync(OUT, html);\nconsole.log(`built ${OUT} (${(html.length / 1024).toFixed(0)} KB; ${files.length} source files: ${files.join(', ')})`);\nEOF\nnode tools/build.mjs 2>&1 | tail -3","description":"Fix closing brace, patch def copy, and create the build script"}}}
