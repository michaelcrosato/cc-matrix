ath.hypot(q.x - sk.x, q.y - sk.y))[0]; if (it && Math.hypot(it.x - sk.x, it.y - sk.y) < 120) { tx = it.x; ty = it.y; } }   // (item greed: a skater not in the play goes for a power-up)\")\n# the play's items and the period's intermission (the Flood Wagon)\nrep1(\"  contacts(dt);\\n\",\"  contacts(dt);\\n  itemsStep(dt);\\n\")\nrep1(\"      if (M.period < T.periods) { M.period++; M.clock = T.periodLen; M.phase = 'stop'; M.timer = 2.2; M.stopTo = [CX, CY]; fx('horn'); say(pick(TEXT.period, 0)); return; }\",\n     \"      if (M.period < T.periods) { M.period++; M.clock = T.periodLen; fx('horn'); say(pick(TEXT.period, 0)); M.phase = 'intermission'; M.floodWanted = M.cfg.mode !== 'session' && M.cfg.mode !== 'attract' && M.cfg.flood !== false && M.humans.length > 0; M.stopTo = [CX, CY]; return; }\")\nopen('src/04-match.js','w').write(s); print('ok')\nEOF","description":"Hook items, hazards and intermission into the match"}}}
