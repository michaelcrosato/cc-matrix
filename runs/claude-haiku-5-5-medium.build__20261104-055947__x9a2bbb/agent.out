const k of ['attack', 'dash', 'skill', 'jump']) delete KEYS[k];\n\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'threequarter', input: KEYS, bg: '#07060d', id: 'ice-hoc-kaboom',\n  menu: { items: [['Objectives & Info', () => game.go('about', { from: 'match' })], ['Dev Mode', () => game.go('dev', { from: game.sceneName })]],\n    settings: [{ key: 'glyphs', label: 'Button symbols', options: ['PlayStation', 'Xbox'], value: 'PlayStation' }],\n    controls: { pass: 'Pass / Switch', shoot: 'Shoot / Check', deke: 'Deke / Poke', lob: 'Saucer / Gloves', turbo: 'Turbo', chirp: 'Chirp', switch: 'Switch player', kaboom: 'KABOOM', camera: 'Camera' },\n    quit: 'title' }, autoPause: !HUB });\nconst A = game.audio, P = game.particles, scenes = {};\nconst store = { get: (k, d) => E.store.get('ice:' + k, d), set: (k, v) => E.store.set('ice:' + k, v) };\n// a prompt in the player's own controls, drawn for the device used last (keyboard keys, mouse buttons, pad symbols)\nconst prompt = (a, word) => game.input.label(a) + ' ' + word;\nconst DEV_OK = () => game.input.lastDevice !== 'touch';\nconst mmss = s => Math.floor(Math.max(0, s) / 60) + ':' + String(Math.floor(Math.max(0, s) % 60)).padStart(2, '0');\n// the seeded random for the simulation: one stream per match (a seed given by the story, the exhibition's own seed)\nlet simRng = E.rng(1);\nconst srand = () => simRng();\n// the coming and going of the sim's own named values, for the Dev panel and the tests\nconst sel = (arr, v) => arr[Math.max(0, Math.min(arr.length - 1, v))];\n/* @@SRC@@ */\n})();\n","structuredPatch":[{"oldStart":28,"oldLines":7,"newStart":28,"newLines":4,"lines":[" // the seeded random for the simulation: one stream per match (a seed given by the story, the exhibition's own seed)"," let simRng = E.rng(1);"," const srand = () => simRng();","-// the coming and going of the sim's own named values, for the Dev panel and the tests","-const sel = (arr, v) => arr[Math.max(0, Math.min(arr.length - 1, v))];","-/* @@SRC@@ */","-})();","+const pick = (arr, v) => arr[Math.max(0, Math.min(arr.length - 1, v))];"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01YKrqVW41K4fA6MAfRxy7qC","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
