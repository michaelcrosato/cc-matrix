mGain); tg.state = 'stagger';\")\nrep(\"        M.boom[att.t] = Math.min(100, M.boom[att.t] + 18 * T.boomGain); fx('hit',\",\"        addGrudge(tg, att, 35); M.boom[att.t] = Math.min(100, M.boom[att.t] + 18 * T.boomGain); fx('hit',\")\n# 4. KABOOM: automatic at 100, a fixed time, the other side's goal ends it\ni=s.index(\"function activateKaboom(t) {\"); j=s.index(\"\\n\", i)\ns=s[:i]+\"function activateKaboom(t) { if (M.boom[t] < 100 || M.kab[t] > 0) return; M.boom[t] = 0; M.kab[t] = T.kaboomTime; M.banner = 'KA-BOOM!'; M.bannerT = 2.5; say(pick(TEXT.kaboom, 0)); fx('horn'); game.shake(5); if (game.flash) game.flash('#ff8a3a', .25, .6); }\"+s[j:]\nrep(\"  for (let t = 0; t < 2; t++) if (M.kab[t] > 0) { M.kab[t] = Math.max(0, M.kab[t] - dt); if (M.kab[t] === 0) say('KABOOM IS OVER. THE ICE IS QUIET AGAIN.'); }\\n  for (let t = 0; t < 2; t++) if (M.boom[t] >= 100 && M.kab[t] === 0 && M.teams[t] && M.phase === 'play' && !M.humans.some(h => h.sk.t === t) && srand() < .02) activateKaboom(t);\\n\",\n\"  for (let t = 0; t < 2; t++) if (M.kab[t] > 0) { M.kab[t] = Math.max(0, M.kab[t] - dt); if (M.kab[t] === 0) say('KABOOM IS OVER. THE ICE IS QUIET AGAIN.'); }\\n  for (let t = 0; t < 2; t++) if (M.boom[t] >= 100) activateKaboom(t);\\n\")\nrep(\"  M.boom[s] = Math.min(100, M.boom[s] + 12 * T.boomGain);\",\"  M.boom[s] = Math.min(100, M.boom[s] + 20 * T.boomGain); M.kab[1 - s] = 0;   // (a goal ends the other side's KABOOM)\\n  if (kab) fx('horn');\")\nrep(\"  M.shots[s]++; gl.stats.against++;\\n\",\"  M.shots[s]++; gl.stats.against++;\\n\") if False else None\nrep(\"    gl.stats.saves++; M.saves[k]++; M.shots[s]++; gl.stats.against++;\",\"    gl.stats.saves++; M.saves[k]++; M.shots[s]++; gl.stats.against++; M.boom[k] = Math.min(100, M.boom[k] + 5 * T.boomGain); M.boom[s] = Math.min(100, M.boom[s] + 4 * T.boomGain);\")\nrep(\"  M.shots[s]++; gl.stats.against++;\\n  const scorer\",\"  M.shots[s]++; gl.stats.against++; M.boom[s] = Math.min(100, M.boom[s] + 4 * T.boomGain);\\n  const scorer\")\nrep(\"  M.boom[by] = Math.min(100, M.boom[by] + 10 * T.boomGain);\",\"  M.boom[by] = Math.min(100, M.boom[by] + 15 * T.boomGain);\")\nrep(\"          if (pk.pass && pk.pass.from && pk.pass.from.t === sk.t && pk.pass.from !== sk) { sk.stats.passes++;\",\"          if (pk.pass && pk.pass.from && pk.pass.from.t === sk.t && pk.pass.from !== sk) { M.boom[sk.t] = Math.min(100, M.boom[sk.t] + 2 * T.boomGain); sk.stats.passes++;\")\nrep(\"      if (id === 2 && spd > T.glassBreak * 1.4 && pk.z < GLASS_H)\",\"      if (id === 2 && (spd > T.glassBreak * 1.4 || (pk.shot && pk.shot.kab)) && pk.z < GLASS_H)\")\nrep(\"      if (pk.shot && pk.shot.by !== sk.t) { M.blocks = (M.blocks || 0) + 1; fx('block'); }\",\n\"      if (pk.shot && pk.shot.by !== sk.t) { M.blocks = (M.blocks || 0) + 1; fx('block'); if (pk.shot.kab && live(sk)) { sk.state = 'down'; sk.st = 1.2; sk.vx = sk.vy = 0; fx('hit', sk.x, sk.y); } }\")\nrep(\"  else g.react = T.goalieReact;\",\"  else g.react = T.goalieReact;\") if False else None\nrep(\"  if (toGoal && pk.shot) g.react = Math.max(0, g.react - dt); else g.react = T.goalieReact;\",\n    \"  if (toGoal && pk.shot) g.react = Math.max(0, g.react - dt); else g.react = T.goalieReact - (M.kab[g.t] > 0 ? .03 : 0);\")\nrep(\"  if (c.shootHeld && sk.cool <= 0) sk.charge = Math.min(1, sk.charge + dt / T.chargeTime);\",\n    \"  if (c.shootHeld && sk.cool <= 0) sk.charge = Math.min(1, sk.charge + (M.kab[sk.t] > 0 ? 2 : 1) * dt / T.chargeTime);\")\nrep(\"  const t = sk.t, gx = attackGoal(t), g = M.goalies[1 - t], slap = charge > .55, kab = M.kab[t] > 0;\",\n    \"  const t = sk.t, gx = attackGoal(t), g = M.goalies[1 - t], slap = charge > .55, kab = M.kab[t] > 0, kabShot = kab && charge >= .95;\")\nrep(\"  ty += (srand() - .5) * 2 * (1 - .4 * charge) * 5 * T.shotErr * (1.3 - .1 * M.teams[t].def.rate.sht);\",\n    \"  if (!kabShot) ty += (srand() - .5) * 2 * (1 - .4 * charge) * 5 * T.shotErr * (1.3 - .1 * M.teams[t].def.rate.sht);\")\nrep(\"  const sht =