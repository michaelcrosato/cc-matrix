if (M.organ) { M.boom[s] = Math.min(100, M.boom[s] + 30 * T.boomGain); say('DORIS PLAYS THE ORGAN! THE ARENA ROARS!'); }\n  if (M.arena.id === 'yard') { M.slips = M.slips || []; M.slips.push({ x: 320 + srand() * 400, y: 320 + srand() * 160, r: 10 }); say('THE FANS THREW AN OCTOPUS ON THE ICE!'); }\n  if (scorer && scorer.stats.g === 3) { hatTrick(scorer); }\n  if (srand() < .25) throwItem();\"\"\"),\n# goalie's brick pads\n(\"  const w = 6 + 2 * size, slap\",\"  const w = (6 + 2 * size) * (M.pads && M.pads[k] > 0 ? 1.35 : 1), slap\"),\n# the puck off a snowbank bounces less\n(\"      if (vn < 0) { pk.vx -= (1 + T.puckBounce) * vn * hit.nx; pk.vy -= (1 + T.puckBounce) * vn * hit.ny; }\",\n \"      const rb = M.arena.id === 'pond' ? .3 : T.puckBounce;   // (the pond's snowbanks give little)\\n      if (vn < 0) { pk.vx -= (1 + rb) * vn * hit.nx; pk.vy -= (1 + rb) * vn * hit.ny; }\"),\n# lumber: the next three shots fly at 30% more speed, with no error\n(\"  const sht = M.teams[t].def.rate.sht, sp = kabShot ? 760 : (T.shotSpeed + T.slapGain * charge) * (.85 + .05 * sht);\",\n \"  const sht = M.teams[t].def.rate.sht, lum = sk.lumber > 0, sp = kabShot ? 760 : (T.shotSpeed + T.slapGain * charge) * (.85 + .05 * sht) * (lum ? 1.3 : 1);\\n  if (lum) sk.lumber--;\"),\n(\"  if (!kabShot) ty += (srand() - .5)\",\"  if (!kabShot && !lum) ty += (srand() - .5)\"),\n# the CPU's power: poutine\n(\"  const power = (sp * .6 + 25)\",\"  const power = (sp * .6 + 25)\"),\n])\ns=open('src/04-match.js').read()\nimport re\n# the check's power and the big hit: poutine, tape, snowbanks, thin ice\ndef rep1(o,n):\n    global s\n    c=s.count(o); assert c==1,(c,o[:80]); s=s.replace(o,n)\nrep1(\"(tb ? 1.2 : 1) * (kab ? 2 : 1);\",\"(tb ? 1.2 : 1) * (kab ? 2 : 1) * (att.poutine > 0 ? 1.6 : 1);\")\nrep1(\"      else if (power < T.bigHit) { M.boom[att.t]\",\"      else if (power < T.bigHit || tg.poutine > 0) { M.boom[att.t]\")\nrep1(\"        tg.state = 'down'; tg.st = 1.2; tg.vx = (tg.x - att.x) / (d