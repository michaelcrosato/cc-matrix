essed(act)) { if (h.sk === f.a) f.pa = FIGHT_KEYS[act]; else f.pb = FIGHT_KEYS[act]; }\n    }\n    f.rt -= dt; f.t -= dt; f.a.st = f.t; f.b.st = f.t;\n    if (f.rt <= 0) fightRound();\n    if (M.fight && f.t <= 0) fightEnd();\n    for (const sk of M.skaters) if (sk !== f.a && sk !== f.b && M.fight) skaterStep(sk, dt);\n    for (const g of M.goalies) goalieStep(g, dt);\n    return;\n  }\n'''\ns=s.replace(old_branch,new_branch)\nopen('src/04-match.js','w').write(s)\nedit('src/05-look.js', [(\n\"    E.font.text(g, f.a.name + ' ' + Math.round(f.pa) + '  -  ' + Math.round(f.pb) + ' ' + f.b.name, W / 2, 62, '#f0ecdc', { align: 'center', font: 'tiny', outline: '#000' });\\n    E.font.text(g, prompt('pass', 'JAB') + '  ' + prompt('shoot', 'HAYMAKER'), W / 2, 72, '#ffe7a8', { align: 'center', font: 'tiny', outline: '#000' });\",\n\"    E.font.text(g, f.a.name + ' ' + f.wa + '  -  ' + f.wb + ' ' + f.b.name + '   ROUND ' + Math.min(3, f.round), W / 2, 62, '#f0ecdc', { align: 'center', font: 'tiny', outline: '#000' });\\n    E.font.text(g, prompt('pass', 'JAB') + '  ' + prompt('shoot', 'HAYMAKER') + '  ' + prompt('deke', 'DUCK') + '  ' + prompt('lob', 'YANK') + '  ' + (f.rt > 0 ? mmss(f.rt).slice(-1) : ''), W / 2, 72, '#ffe7a8', { align: 'center', font: 'tiny', outline: '#000' });\\n    if (f.last) E.font.text(g, f.last.toUpperCase(), W / 2, 82, '#c8d0e8', { align: 'center', font: 'tiny', outline: '#000' });\")])\nedit('src/08-net.js', [\n(\"fi: M.fight ? [sk.indexOf(M.fight.a), sk.indexOf(M.fight.b), Math.round(M.fight.pa), Math.round(M.fight.pb), +M.fight.t.toFixed(1)] : null,\",\n \"fi: M.fight ? [sk.indexOf(M.fight.a), sk.indexOf(M.fight.b), M.fight.wa, M.fight.wb, M.fight.round, +M.fight.rt.toFixed(2), M.fight.last || ''] : null,\"),\n(\"  M.fight = m.fi ? { a: M.skaters[m.fi[0]], b: M.skaters[m.fi[1]], pa: m.fi[2], pb: m.fi[3], t: m.fi[4] } : null;\",\n \"  M.fight = m.fi ? { a: M.skaters[m.fi[0]], b: M.skaters[m.fi[1]], wa: m.fi[2], wb: m.fi[3], round: m.fi[4], rt: m.fi[