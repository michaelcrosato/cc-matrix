< .5 && !tg.tape) loosen(tg, att); fx('thump'); }\")\n# the skater's step: the effects' clocks, the early states, the sauce's infinite turbo, the cocoa's speed\nrep1(\"  sk.cool = Math.max(0, sk.cool - dt); sk.deke = Math.max(0, sk.deke - dt); sk.turbo = Math.max(0, sk.turbo - dt);\",\n     \"  sk.cool = Math.max(0, sk.cool - dt); sk.deke = Math.max(0, sk.deke - dt); sk.turbo = Math.max(0, sk.turbo - dt); effectsStep(sk, dt);\")\nrep1(\"  if (sk.state === 'down' || sk.state === 'stagger' || sk.state === 'celebrate' || sk.state === 'fight' || sk.state === 'bin') {\",\n     \"  if (sk.state === 'down' || sk.state === 'stagger' || sk.state === 'celebrate' || sk.state === 'fight' || sk.state === 'bin' || sk.state === 'slip' || sk.state === 'buried' || sk.state === 'frozen') {\")\nrep1(\"  const kabT = M.kab[sk.t] > 0, turboOn\",\"  const kabT = M.kab[sk.t] > 0 || sk.sauce > 0, turboOn\")\nrep1(\"(turboOn ? T.turboMul : 1) *\\n\",\"(turboOn ? T.turboMul : 1) * (sk.cocoa > 0 ? 1.2 : 1) *\\n\")\n# the CPU goes for an item when it is not part of the play\nrep1(\"  else [tx, ty] = spotFor(sk);\",\"  else [tx, ty] = spotFor(sk);\\n  if (sk !== chaser && !pk.owner && M.items) { const it = M.items.filter(i => i.landed && !i.taken).sort((p, q) => Math.hypot(p.x - sk.x, p.y - sk.y) - Math.hypot(q.x - sk.x, q.y - sk.y))[0]; if (it && Math.hypot(it.x - sk.x, it.y - sk.y) < 120) { tx = it.x; ty = it.y; } }   // (item greed: a skater not in the play goes for a power-up)\")\n# the play's items and the period's intermission (the Flood Wagon)\nrep1(\"  contacts(dt);\\n\",\"  contacts(dt);\\n  itemsStep(dt);\\n\")\nrep1(\"      if (M.period < T.periods) { M.period++; M.clock = T.periodLen; M.phase = 'stop'; M.timer = 2.2; M.stopTo = [CX, CY]; fx('horn'); say(pick(TEXT.period, 0)); return; }\",\n     \"      if (M.period < T.periods) { M.period++; M.clock = T.periodLen; fx('horn'); say(pick(TEXT.period, 0)); M.phase = 'intermission'; M.floodWanted = M.cfg.mode !== 'session' && M.cfg.mode 