{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RTZciuTtPQuLtADEAp8Wnu","type":"tool_result","content":"labs/playground/scenes/site.ts\nlabs/box/menu.ts\n\nengine/sim/siteApi.ts:48:export { scatterTerrain } from '../world/terrain';\nengine/world/terrain.ts:18: * metres over the origin up (0: none), the high one. `scatterTerrain` places trees and rocks by hashes of the cells\nengine/world/terrain.ts:110:/** A place `scatterTerrain` picks: on the ground, a turn about +Y (rad) and a size factor. */\nengine/world/terrain.ts:117:/** How `scatterTerrain` places (see its comment). */\nengine/world/terrain.ts:296:export function scatterTerrain(terrain: Terrain, rule: ScatterRule): TerrainPlace[] {\nlabs/playground/scenes/site.ts:33:import { addDoor, addInteraction, addLauncher, addLevelDoors, addLevelWindows, addMelee, addSiteBodies, addSiteLadders, addSwitch, addWeapons, addZipline, DAWN, defineScene, defineSettings, DUSK, lightsAtDusk, litAt, physicsOf, scatterTerrain, setDaytime, siteFloorBelow, siteSolidAt, spawnProp, switchGroup, terrainHeight, toWorld, type World } from '../../../engine/sim-api'; // prettier-ignore\nlabs/playground/scenes/site.ts:140:    for (const { position: [x, y, z], yaw } of scatterTerrain(SITE.terrain!, { density, salt })) if (onHill({ x, z })) spawnProp(w, { prop, at: [x, y, z], yaw }); // prettier-ignore\n---\nlabs/box/main.ts:3: * a scene added there opens at `?scene=<name>` with no change here, and the box's levels, then starts the engine\n---\n/**\n * @file Rides in a running scene (PLAN.md WP 13.7, docs/PLAYGROUND.md §2.3): ziplines, ladders and launchers as\n * entities, each holding its spec (engine/world/traverse.ts) in the component `zipline`, `ladder` or `launcher`, so the\n * sim hashes, captures and restores them. `addZipline(w, spec)` places a zipline and the fixed poles under its\n * anchors (each down to its foot, the spec's `feet`), `addLadder` and `addLauncher` the others (a solid launcher's\n * box from the ground up), `addLevelLadders(w, level)` the ladders a level's ladder glyphs stand, and\n * `addSiteLadders(w, site)` each structure's, at its place and quarter turn (WP 13.15). `ridesOf(w)`\n * gives the shooter model and the launchers what the world holds (engine/physics/movement/ride.ts's `Rides`), which\n * engine/sim/actors.ts hands every character's tick; the stage draws the components (engine/gfx/stageRides.ts).\n *\n * The components declare no `x` and `z`, so the stage never draws them as stand-ins.\n *\n * Invariants: rides are data in components, never references; `ridesOf` reads the world as it is, in id order, so the\n * same world gives the same rides; a zipline's poles are fixed bodies of the group `world`, `ZIPLINE_POLE` thick.\n *\n * @example\n * import { defineScene } from './scene';\n * defineScene('rides:yard', {\n *   physics: true,\n *   setup(w) {\n *     addZipline(w, { from: [0, 8, 0], to: [0, 2, 40] }); // a pole under each anchor\n *     addLauncher(w, { at: [4, 0, 4], velocity: [0, 12, 0] }); // a jump pad: up 3.8 m under Apex's gravity\n *   },\n * });\n * @see engine/sim/rides.test.ts\n */\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { Schema } from '../core/schema';\nimport { physicsOf } from '../physics/binding';\nimport type { Rides } from '../physics/movement/ride';\n---\nengine/gfx/geometry/builtins.ts:37:/** The kit's entries by id, as `defineGeometry` specs. */\nengine/gfx/geometry/geometry.test.ts:12:import { buildGeometry, defineGeometry, getGeometry, type GeometryEntry } from './geometry';\nengine/gfx/geometry/geometry.test.ts:48:    defineGeometry(\nengine/gfx/geometry/geometry.test.ts:63:      defineGeometry(\nengine/gfx/geometry/geometry.ts:4: * parameters as schema fields, each with a default, and a vertex budget: `defineGeometry('geometry:crate', {\nengine/gfx/geometry/geometry.ts:63:/** What `defineGeometry` takes: the entry's fields (`params` and `budget` have defau