{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LS7PFxRHwtoWKDY5MP1R1D","type":"tool_result","content":"/**\n * @file The neighbours (docs/PLAYGROUND.md §7.4; PLAN.md WP 13.21): four people about the block, each on a route of\n * stops kept on a schedule (`NEIGHBOURS`: the north sidewalk end to end, the porch and the front path, the garden\n * bench and the backyard, the bus stop's bench and the south sidewalk; engine/world/aiRoutes.ts `followRoute`),\n * strolling between them over the site's navigation round its props (a flow field a stop: ways.ts beside it). Each\n * knows the player by WP 10.4's awareness (`sense`: in sight within `NEIGHBOUR.sight` m, nothing\n * of the world between their eyes; a shot or a kick it hears) and reacts:\n * - it looks at him (its head along `intents.look`) while he is within `NEIGHBOUR.look` m and in sight, and for a\n *   moment at a noise it heard;\n * - it steps aside, to its right, when he stands in its way (`stepAside`);\n * - it flinches when he shoves into it (he comes within `NEIGHBOUR.shove` m, moving at it);\n * - it startles at a shot or a kick it hears (a flinch away from it, and a look);\n * - a hard blow (a kick or the uppercut, `PARTNER_BLOWS`) hands it off to its ragdoll (WP 10.2), and it gets up the\n *   way it lies; a punch or a shot flinches it. Its hit points come back at every blow (health.ts beside it).\n * Each reaction emits `neighbour` `{ id, what }` (`look`, `aside`, `shoved`, `startle`, `flinch`, `fall`), as do its\n * sitting down and rising (`sit`, `rise`: `action:sit`, a seat behind it, on the benches' stops). Each is\n * drawn as `body:neighbour<k>` (labs/playground/bodies/neighbours.ts: the player's slots varied by a seed of its own,\n * which the page registers); the sim names it by id only. `standNeighbours(w)` stands them and adds the systems\n * `ragdolls` and `neighbours` (phase `ai`, after the step's blows and shots: engine/sim/melee.ts, weapons.ts).\n *\n * Invariants: everything a neighbour is lives in its components (`neighbour`, `route`, `awareness`, `health`);\n * neighbours step in id order; no random stream.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts and the playground's own files.\n *\n * @example\n * // in the site's setup, after the player: standNeighbours(w);\n * NEIGHBOURS.map((n) => n.name); // ['walker', 'porch', 'gardener', 'commuter']\n * @see labs/playground/cast/neighbours.test.ts\n */\nimport { actOn, addRagdolls, AWARENESS_FIELDS, createCharacter, defineAction, defineComponent, followRoute, handOff, physicsOf, reactTo, ROUTE_FIELDS, sense, spawnActor, stepAside, Vector3, type Awareness, type Health, type MeleeState, type Noise, type RagdollState, type RouteState, type RouteStop, type WeaponsState, type World } from '../../../engine/sim-api'; // prettier-ignore\nimport { CAST_HP, castHealth } from './health';\nimport { PARTNER_BLOWS } from './partners';\nimport { wayTo } from './ways';\n\n/** A neighbour: its name, its body's index (`body:neighbour<k>`) and its route. */\nexport interface Neighbour {\n  readonly name: string;\n  readonly body: number;\n  readonly stops: readonly RouteStop[];\n}\n\n/** The north sidewalk's and the south's walking line (m, south), and their floor (m up). */\nconst [NORTH, SOUTH, KERB] = [84.75, 93.75, 0.15];\n\n/** The neighbours and their rounds (see the file comment): stops in world metres, stays in seconds. */\nexport const NEIGHBOURS: readonly Neighbour[] = [\n  {\n    name: 'walker',\n    body: 0,\n    stops: [\n      { at: [46.25, KERB, NORTH], stay: 3 },\n      { at: [90.25, KERB, NORTH], stay: 3 },\n    ],\n  },\n  { name: 'porch', body: 1, stops: [{ at: [52.25, 0, 61.75], stay: 12, facing: 0 }, { at: [52.25, KERB, 83.75], stay: 4 }] }, // prettier-ignore\n  { name: 'gardener', body: 2, stops: [{ at: [56.5, 0, 41], stay: 14, doing: 'sit', facing: 0 }, { at: [61.75, 0, 49.25], stay: 4 }] }, // prettier-ignore\n  { name: 'commuter', body: 3, stops: [{ at: [82.25, KERB, 93.75], stay: 16, doing: 'sit', facing: Math.PI }, { at: [94.25, KERB, SOUTH], stay: 3 }] }, // prettier-ignore\n];\n\n....\n/**\n * @file The playground's attract mode (docs/PLAYGROUND.md §9.2, PLAN.md WP 13.26): the tour (labs/playground/tour.ts,\n * tests/replays/playground-tour.replay.json) playing in the page as `?replay=playground-tour` plays it, in real time\n * from step 0, the view stepping through the five cameras every `ATTRACT.cycle` seconds (blended, as T does) and\n * switching the look every second step, a banner (`[data-ui=attract]`) saying any key plays. A key, a click or a pad\n * button, or the tour's end, gives the page back: the playground again, on its start menu.\n *\n * The view setting `playground.attract`: `on` is the tour's page itself (`attractPage()` writes its address); `auto`\n * (the default) opens it after `ATTRACT.idle` seconds on the start menu with nothing pressed, unless automation\n * drives the browser (labs/playground/ui/frontEnd.ts); `off` never. The start menu's \"Watch the tour\" opens it too.\n *\n * Invariants: presentation only: the replay plays the run, and the cameras and looks are view state, so the tour's\n * goldens hold under every view the cycle shows (tests/e2e/playground-tour.spec.ts).\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's own files.\n *\n * @example\n * attractPage('/labs/playground/'); // '/labs/playground/?replay=playground-tour&playground.attract=on&playground.title=off'\n * ATTRACT.cycle; // 8: seconds a view shows\n * @see tests/e2e/playground-tour.spec.ts\n */\nimport type { Engine } from '../../../engine';\nimport { defineSettings } from '../../../engine/sim-api';\nimport { cameraMode, nextCamera, nextLook } from '../views';\n\n/** The attract mode's numbers: seconds on an idle start menu before it starts, and seconds a view shows. */\nexport const ATTRACT = Object.freeze({ idle: 60, cycle: 8 });\n\n/** The tour's replay, as the page offers it (`?replay=<name>`). */\nexport const TOUR_REPLAY = 'playground-tour';\n\n/** The attract mode's view setting (see the file comment). */\nexport const ATTRACT_SETTINGS = defineSettings({\n  'playground.attract': {\n    type: 'string',\n    enum: ['auto', 'on', 'off'],\n    default: 'auto',\n    view: true,\n    when: 'scene',\n    description:\n      \"The playground's attract mode, the tour playing with the view cycling (labs/playground/ui/attract.ts): 'on' is the tour's page itself, 'auto' opens it after a minute on the start menu with nothing pressed unless automation drives the browser, 'off' never.\",\n  },\n});\n\n/** The tour's page at `path` (the playground's): its replay, the attract mode on, no start menu over it. */\nexport function attractPage(path: string): string {\n  return `${path}?${new URLSearchParams({ replay: TOUR_REPLAY, 'playground.attract': 'on', 'playground.title': 'off' })}`; // prettier-ignore\n}\n\n/** The attract mode on a page (see the file comment). */\n....\n/**\n * @file The playground's front end (docs/PLAYGROUND.md §8.3, PLAN.md WP 13.25; reworked at the owner's call of\n * 2026-11-03, \"a UI that looks decent\"): its screens over the game, each in a frame (labs/playground/ui/frame.ts) worn\n * by the theme (theme.ts), the engine's menus (engine/ui/menu.ts) and the playground's panels on a stack (closing one\n * shows the one under it again):\n * - the start menu (`title`: Play, Go to, Settings, Controls, Photo mode, Watch the tour, Owner checks, Tools), shown\n *   under the splash screen (splash.ts) as the page opens while `playground.title` says so (`auto`: unless a replay\n *   plays or automation drives the browser; `on`, `off`); Escape plays; left idle `ATTRACT.idle` seconds, it opens\n *   the attract mode (attract.ts) while `playground.attract` is `auto` and no automation drives the browser;\n * - pause (`pause`: Resume, Answer this check under way, Go to, Settings, Controls, Photo mode, This area's card on\n *   the block (`showCard`: I's, for a pad), Owner checks, Tools, Restart, Main menu), opened by the system layer's\n *   `pause` (Escape, the pad's Start) or the pointer lock let go while the map wants it (the first Escape frees it);\n * - Go to (`spawns`: the block's areas and the house's rooms, spawns.ts; M opens it in play), settings (`settings`,\n *   settings.ts), the controls sheet (`help`, help.ts; H in play), photo mode (`photo`, photo.ts), the owner's checks\n *   (`checks` on the list, `check` on the one under way: checkPanel.ts, answers to `checkStore`, Go there opening\n *   checks.ts `checkUrl`, from playground.html saying what to run for another page: `checkAway`), and Tools (`tools`,\n *   tools.ts). Each item says what it does under the menu as the cursor rests on it (frame.ts `ABOUT`), but in a\n *   window 460 px tall or less.\n * While one is open the run is paused (`__engine.pause()`) and the front end is modal (`modal()`, which the page gives\n * `createEngine`), so no key it reads reaches the run; the last closing resumes it. Escape (`uiCancel`) goes back one\n * (on the start menu it plays); the footers name the device's keys (frame.ts), and a pad works the panels (walk.ts).\n *\n * Picks that change play are the run's recorded operations, so a replay of the run holds them: a Go to place is the\n * block's dev action `place` (`actions.run`) on a scene of the block, else the block's page opened with the pick\n * (links.ts `goToLink`, run as its first operation: `spawnOnOpen`); Restart starts the scene again on its seed\n * (`seed`); the movement profile is the sim setting `playground.movement`, set, then the scene started again; the time\n * of day and the day's length (`playground.hour`, `playground.day`) are set and, on the block, put on its clock at once\n * by its dev action `daytime` (settings.ts `clockAfter`). The camera mode, the view settings and the audio levels\n * change the view alone; the store keeps them (prefs.ts).\n * `state()` (`__playgroundUi.state()` in the page) names the open screens for the tests; `__playgroundUi.checks()`\n * lists the owner's checks with their answers, and `__playgroundUi.answers()` gives them as the text to paste.\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's own files.\n *\n * @example\n * // labs/playground/main.ts, once the engine is up:\n * // const ui = createFrontEnd({ engine, canvas, store, prefs, audio: sound.audio, scene: () => last?.scene ?? null, … });\n * // ui.open('title'); // and each drawn frame: ui.frame(dt)\n * @see tests/e2e/playground-ui.spec.ts\n */\nimport { createMenu, type CameraInput, type Engine, type EngineFrame, type Menu, type MenuItem, type Store } from '../../../engine'; // prettier-ignore\nimport { defineSettings } from '../../../engine/sim-api';\nimport { cameraMode, PLAYGROUND_CAMERAS } from '../views';\nimport { ATTRACT, attractPage } from './attract';\nimport { createChecksPanel } from './checkPanel';\nimport { answered, answersText, checkAway, checkUrl, OWNER_CHECKS, readAnswers, saveAnswer, type OwnerCheck } from './checks'; // prettier-ignore\nimport { createPhoto, type PhotoCamera } from './photo';\nimport { PREF_BUSES, PREF_SETTINGS, savePrefs, type Prefs } from './prefs';\nimport { clockAfter, createSettings, type RowSchema, type SettingRow } from './settings';\nimport { createTune, type LookNow } from './tune';\n....\n/**\n * @file The playground's controls (docs/PLAYGROUND.md §3.3, PLAN.md WP 13.3, WP 13.9): an action map per camera mode,\n * Apex Legends' default bindings where the browser allows them. W A S D or the arrows move, Space jumps, Left Shift\n * sprints (a press keeps the sprint while the player moves on; the setting `input.sprint` makes it hold only), Left Alt\n * walks (ours: Apex walks only aiming down sights), C crouches (held; `input.crouch` toggles it), not Apex's Left\n * Ctrl, since Ctrl with W closes the browser's tab and no page can stop it; E uses (a door, a switch, a chair to carry\n * and throw, a zipline, a ladder), V strikes (Apex's melee, WP 13.19: a punch with a lunge, the door kick at a door),\n * the left and right buttons fire and raise the sights, 1 and 2 draw the pistol and the rifle, R reloads and 3\n * holsters (WP 13.20); T switches the camera mode, X swaps the shooter's shoulder, and in isometric Q and E turn the\n * view, so there G uses. A pad's left stick moves, its right stick looks, A jumps, B crouches, X uses and held\n * reloads, Y swaps the weapons and held holsters (Apex's, on held bindings: engine/input/codes.ts `holdCode`), a\n * click of the left stick sprints and of the right one kicks, the triggers fire and aim, View switches the camera,\n * the d-pad's left swaps the shoulder and its right turns isometric.\n *\n * Each mode's map (`PLAYGROUND_MAPS`, picked by the camera in use: `playgroundMap(code)`): first person and the shooter\n * send the view (`look`, so the sprint keeps within 45° of it) and aim with the screen's centre, the mouse looking\n * under pointer lock; the platformer moves relative to the camera, the mouse turning it, and faces its move;\n * isometric and top-down move relative to the screen and aim with the free pointer onto the player's floor (the right\n * stick on a pad). The camera keys are view actions (`view`): rebound like the others, never in the intents, and the\n * page hears them (`onView`, labs/playground/main.ts). The page keeps P, F, M, H and I for itself (`reserved`).\n *\n * Invariants: data only; the buttons the intents carry are the actions the shooter model reads (`jump`, `sprint`,\n * `walk`, `crouch`, `interact`, engine/sim/actors.ts; `melee`, the strike, engine/sim/melee.ts), and the firearms'\n * (`fire`, `aim`, which raises the sights and the camera's zoom, `reload`, `holster`, `weapon1`, `weapon2` and\n * `swap`, engine/sim/weapons.ts).\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's files.\n *\n * @example\n * import { getActionMap } from '../../engine';\n * playgroundMap('cam=iso,90,1'); // 'actionMap:playground-isometric'\n * getActionMap(PLAYGROUND_MAPS.isometric).actions.interact; // ['KeyG', 'PadWest']: Q and E turn the view there\n * @see labs/playground/controls.test.ts\n */\nimport { defineActionMap, type ActionMapSpec } from '../../engine';\nimport { FEEL_KEY } from './feel';\nimport { CARD_KEY, GOTO_KEY, HELP_KEY } from './ui/help';\nimport { cameraMode, LOOK_KEY } from './views';\n\n/** The action maps, by camera mode (labs/playground/views.ts `PLAYGROUND_CAMERAS`' names). */\nexport const PLAYGROUND_MAPS = {\n  shooter: 'actionMap:playground-shooter',\n  first: 'actionMap:playground-first',\n  platformer: 'actionMap:playground-platformer',\n  isometric: 'actionMap:playground-isometric',\n  'top-down': 'actionMap:playground-top-down',\n} as const;\n\n/** The actions the player answers, with what each does, in the settings' order (ui/settings.ts; the controls sheet groups its own, ui/help.ts); the rest are bound for later WPs. */\nexport const PLAYGROUND_ACTIONS: Readonly<Record<string, string>> = {\n  jump: 'Jump',\n  sprint: 'Sprint: hold, or press once to keep it',\n  walk: 'Walk',\n  crouch: 'Crouch: hold',\n  interact: 'Use: a door, a switch, a chair to carry and throw, a zipline, a ladder',\n  melee: 'Strike: a punch with a lunge, a kick in the air, an uppercut from a slide; a door takes a kick, then breaks',\n  fire: 'Fire (draws the weapon if holstered)',\n  aim: 'Aim down sights',\n  reload: 'Reload',\n  weapon1: 'Draw the pistol',","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"ba2710d8-c925-4879-9329-6184a7a71c38","timestamp":"2026-11-05T04:25:37.619Z","tool_use_result":{"stdout":"/**\n * @file The neighbours (docs/PLAYGROUND.md §7.4; PLAN.md WP 13.21): four people about the block, each on a route of\n * stops kept on a schedule (`NEIGHBOURS`: the north sidewalk end to end, the porch and the front path, the garden\n * bench and the backyard, the bus stop's bench and the south sidewalk; engine/world/aiRoutes.ts `followRoute`),\n * strolling between them over the site's navigation round its props (a flow field a stop: ways.ts beside it). Each\n * knows the player by WP 10.4's awareness (`sense`: in sight within `NEIGHBOUR.sight` m, nothing\n * of the world between their eyes; a shot or a kick it hears) and reacts:\n * - it looks at him (its head along `intents.look`) while he is within `NEIGHBOUR.look` m and in sight, and for a\n *   moment at a noise it heard;\n * - it steps aside, to its right, when he stands in its way (`stepAside`);\n * - it flinches when he shoves into it (he comes within `NEIGHBOUR.shove` m, moving at it);\n * - it startles at a shot or a kick it hears (a flinch away from it, and a look);\n * - a hard blow (a kick or the uppercut, `PARTNER_BLOWS`) hands it off to its ragdoll (WP 10.2), and it gets up the\n *   way it lies; a punch or a shot flinches it. Its hit points come back at every blow (health.ts beside it).\n * Each reaction emits `neighbour` `{ id, what }` (`look`, `aside`, `shoved`, `startle`, `flinch`, `fall`), as do its\n * sitting down and rising (`sit`, `rise`: `action:sit`, a seat behind it, on the benches' stops). Each is\n * drawn as `body:neighbour<k>` (labs/playground/bodies/neighbours.ts: the player's slots varied by a seed of its own,\n * which the page registers); the sim names it by id only. `standNeighbours(w)` stands them and adds the systems\n * `ragdolls` and `neighbours` (phase `ai`, after the step's blows and shots: engine/sim/melee.ts, weapons.ts).\n *\n * Invariants: everything a neighbour is lives in its components (`neighbour`, `route`, `awareness`, `health`);\n * neighbours step in id order; no random stream.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts and the playground's own files.\n *\n * @example\n * // in the site's setup, after the player: standNeighbours(w);\n * NEIGHBOURS.map((n) => n.name); // ['walker', 'porch', 'gardener', 'commuter']\n * @see labs/playground/cast/neighbours.test.ts\n */\nimport { actOn, addRagdolls, AWARENESS_FIELDS, createCharacter, defineAction, defineComponent, followRoute, handOff, physicsOf, reactTo, ROUTE_FIELDS, sense, spawnActor, stepAside, Vector3, type Awareness, type Health, type MeleeState, type Noise, type RagdollState, type RouteState, type RouteStop, type WeaponsState, type World } from '../../../engine/sim-api'; // prettier-ignore\nimport { CAST_HP, castHealth } from './health';\nimport { PARTNER_BLOWS } from './partners';\nimport { wayTo } from './ways';\n\n/** A neighbour: its name, its body's index (`body:neighbour<k>`) and its route. */\nexport interface Neighbour {\n  readonly name: string;\n  readonly body: number;\n  readonly stops: readonly RouteStop[];\n}\n\n/** The north sidewalk's and the south's walking line (m, south), and their floor (m up). */\nconst [NORTH, SOUTH, KERB] = [84.75, 93.75, 0.15];\n\n/** The neighbours and their rounds (see the file comment): stops in world metres, stays in seconds. */\nexport const NEIGHBOURS: readonly Neighbour[] = [\n  {\n    name: 'walker',\n    body: 0,\n    stops: [\n      { at: [46.25, KERB, NORTH], stay: 3 },\n      { at: [90.25, KERB, NORTH], stay: 3 },\n    ],\n  },\n  { name: 'porch', body: 1, stops: [{ at: [52.25, 0, 61.75], stay: 12, facing: 0 }, { at: [52.25, KERB, 83.75], stay: 4 }] }, // prettier-ignore\n  { name: 'gardener', body: 2, stops: [{ at: [56.5, 0, 41], stay: 14, doing: 'sit', facing: 0 }, { at: [61.75, 0, 49.25], stay: 4 }] }, // prettier-ignore\n  { name: 'commuter', body: 3, stops: [{ at: [82.25, KERB, 93.75], stay: 16, doing: 'sit', facing: Math.PI }, { at: [94.25, KERB, SOUTH], stay: 3 }] }, // prettier-ignore\n];\n\n....\n/**\n * @file The playground's attract mode (docs/PLAYGROUND.md §9.2, PLAN.md WP 13.26): the tour (labs/playground/tour.ts,\n * tests/replays/playground-tour.replay.json) playing in the page as `?replay=playground-tour` plays it, in real time\n * from step 0, the view stepping through the five cameras every `ATTRACT.cycle` seconds (blended, as T does) and\n * switching the look every second step, a banner (`[data-ui=attract]`) saying any key plays. A key, a click or a pad\n * button, or the tour's end, gives the page back: the playground again, on its start menu.\n *\n * The view setting `playground.attract`: `on` is the tour's page itself (`attractPage()` writes its address); `auto`\n * (the default) opens it after `ATTRACT.idle` seconds on the start menu with nothing pressed, unless automation\n * drives the browser (labs/playground/ui/frontEnd.ts); `off` never. The start menu's \"Watch the tour\" opens it too.\n *\n * Invariants: presentation only: the replay plays the run, and the cameras and looks are view state, so the tour's\n * goldens hold under every view the cycle shows (tests/e2e/playground-tour.spec.ts).\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's own files.\n *\n * @example\n * attractPage('/labs/playground/'); // '/labs/playground/?replay=playground-tour&playground.attract=on&playground.title=off'\n * ATTRACT.cycle; // 8: seconds a view shows\n * @see tests/e2e/playground-tour.spec.ts\n */\nimport type { Engine } from '../../../engine';\nimport { defineSettings } from '../../../engine/sim-api';\nimport { cameraMode, nextCamera, nextLook } from '../views';\n\n/** The attract mode's numbers: seconds on an idle start menu before it starts, and seconds a view shows. */\nexport const ATTRACT = Object.freeze({ idle: 60, cycle: 8 });\n\n/** The tour's replay, as the page offers it (`?replay=<name>`). */\nexport const TOUR_REPLAY = 'playground-tour';\n\n/** The attract mode's view setting (see the file comment). */\nexport const ATTRACT_SETTINGS = defineSettings({\n  'playground.attract': {\n    type: 'string',\n    enum: ['auto', 'on', 'off'],\n    default: 'auto',\n    view: true,\n    when: 'scene',\n    description:\n      \"The playground's attract mode, the tour playing with the view cycling (labs/playground/ui/attract.ts): 'on' is the tour's page itself, 'auto' opens it after a minute on the start menu with nothing pressed unless automation drives the browser, 'off' never.\",\n  },\n});\n\n/** The tour's page at `path` (the playground's): its replay, the attract mode on, no start menu over it. */\nexport function attractPage(path: string): string {\n  return `${path}?${new URLSearchParams({ replay: TOUR_REPLAY, 'playground.attract': 'on', 'playground.title': 'off' })}`; // prettier-ignore\n}\n\n/** The attract mode on a page (see the file comment). */\n....\n/**\n * @file The playground's front end (docs/PLAYGROUND.md §8.3, PLAN.md WP 13.25; reworked at the owner's call of\n * 2026-11-03, \"a UI that looks decent\"): its screens over the game, each in a frame (labs/playground/ui/frame.ts) worn\n * by the theme (theme.ts), the engine's menus (engine/ui/menu.ts) and the playground's panels on a stack (closing one\n * shows the one under it again):\n * - the start menu (`title`: Play, Go to, Settings, Controls, Photo mode, Watch the tour, Owner checks, Tools), shown\n *   under the splash screen (splash.ts) as the page opens while `playground.title` says so (`auto`: unless a replay\n *   plays or automation drives the browser; `on`, `off`); Escape plays; left idle `ATTRACT.idle` seconds, it opens\n *   the attract mode (attract.ts) while `playground.attract` is `auto` and no automation drives the browser;\n * - pause (`pause`: Resume, Answer this check under way, Go to, Settings, Controls, Photo mode, This area's card on\n *   the block (`showCard`: I's, for a pad), Owner checks, Tools, Restart, Main menu), opened by the system layer's\n *   `pause` (Escape, the pad's Start) or the pointer lock let go while the map wants it (the first Escape frees it);\n * - Go to (`spawns`: the block's areas and the house's rooms, spawns.ts; M opens it in play), settings (`settings`,\n *   settings.ts), the controls sheet (`help`, help.ts; H in play), photo mode (`photo`, photo.ts), the owner's checks\n *   (`checks` on the list, `check` on the one under way: checkPanel.ts, answers to `checkStore`, Go there opening\n *   checks.ts `checkUrl`, from playground.html saying what to run for another page: `checkAway`), and Tools (`tools`,\n *   tools.ts). Each item says what it does under the menu as the cursor rests on it (frame.ts `ABOUT`), but in a\n *   window 460 px tall or less.\n * While one is open the run is paused (`__engine.pause()`) and the front end is modal (`modal()`, which the page gives\n * `createEngine`), so no key it reads reaches the run; the last closing resumes it. Escape (`uiCancel`) goes back one\n * (on the start menu it plays); the footers name the device's keys (frame.ts), and a pad works the panels (walk.ts).\n *\n * Picks that change play are the run's recorded operations, so a replay of the run holds them: a Go to place is the\n * block's dev action `place` (`actions.run`) on a scene of the block, else the block's page opened with the pick\n * (links.ts `goToLink`, run as its first operation: `spawnOnOpen`); Restart starts the scene again on its seed\n * (`seed`); the movement profile is the sim setting `playground.movement`, set, then the scene started again; the time\n * of day and the day's length (`playground.hour`, `playground.day`) are set and, on the block, put on its clock at once\n * by its dev action `daytime` (settings.ts `clockAfter`). The camera mode, the view settings and the audio levels\n * change the view alone; the store keeps them (prefs.ts).\n * `state()` (`__playgroundUi.state()` in the page) names the open screens for the tests; `__playgroundUi.checks()`\n * lists the owner's checks with their answers, and `__playgroundUi.answers()` gives them as the text to paste.\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's own files.\n *\n * @example\n * // labs/playground/main.ts, once the engine is up:\n * // const ui = createFrontEnd({ engine, canvas, store, prefs, audio: sound.audio, scene: () => last?.scene ?? null, … });\n * // ui.open('title'); // and each drawn frame: ui.frame(dt)\n * @see tests/e2e/playground-ui.spec.ts\n */\nimport { createMenu, type CameraInput, type Engine, type EngineFrame, type Menu, type MenuItem, type Store } from '../../../engine'; // prettier-ignore\nimport { defineSettings } from '../../../engine/sim-api';\nimport { cameraMode, PLAYGROUND_CAMERAS } from '../views';\nimport { ATTRACT, attractPage } from './attract';\nimport { createChecksPanel } from './checkPanel';\nimport { answered, answersText, checkAway, checkUrl, OWNER_CHECKS, readAnswers, saveAnswer, type OwnerCheck } from './checks'; // prettier-ignore\nimport { createPhoto, type PhotoCamera } from './photo';\nimport { PREF_BUSES, PREF_SETTINGS, savePrefs, type Prefs } from './prefs';\nimport { clockAfter, createSettings, type RowSchema, type SettingRow } from './settings';\nimport { createTune, type LookNow } from './tune';\n....\n/**\n * @file The playground's controls (docs/PLAYGROUND.md §3.3, PLAN.md WP 13.3, WP 13.9): an action map per camera mode,\n * Apex Legends' default bindings where the browser allows them. W A S D or the arrows move, Space jumps, Left Shift\n * sprints (a press keeps the sprint while the player moves on; the setting `input.sprint` makes it hold only), Left Alt\n * walks (ours: Apex walks only aiming down sights), C crouches (held; `input.crouch` toggles it), not Apex's Left\n * Ctrl, since Ctrl with W closes the browser's tab and no page can stop it; E uses (a door, a switch, a chair to carry\n * and throw, a zipline, a ladder), V strikes (Apex's melee, WP 13.19: a punch with a lunge, the door kick at a door),\n * the left and right buttons fire and raise the sights, 1 and 2 draw the pistol and the rifle, R reloads and 3\n * holsters (WP 13.20); T switches the camera mode, X swaps the shooter's shoulder, and in isometric Q and E turn the\n * view, so there G uses. A pad's left stick moves, its right stick looks, A jumps, B crouches, X uses and held\n * reloads, Y swaps the weapons and held holsters (Apex's, on held bindings: engine/input/codes.ts `holdCode`), a\n * click of the left stick sprints and of the right one kicks, the triggers fire and aim, View switches the camera,\n * the d-pad's left swaps the shoulder and its right turns isometric.\n *\n * Each mode's map (`PLAYGROUND_MAPS`, picked by the camera in use: `playgroundMap(code)`): first person and the shooter\n * send the view (`look`, so the sprint keeps within 45° of it) and aim with the screen's centre, the mouse looking\n * under pointer lock; the platformer moves relative to the camera, the mouse turning it, and faces its move;\n * isometric and top-down move relative to the screen and aim with the free pointer onto the player's floor (the right\n * stick on a pad). The camera keys are view actions (`view`): rebound like the others, never in the intents, and the\n * page hears them (`onView`, labs/playground/main.ts). The page keeps P, F, M, H and I for itself (`reserved`).\n *\n * Invariants: data only; the buttons the intents carry are the actions the shooter model reads (`jump`, `sprint`,\n * `walk`, `crouch`, `interact`, engine/sim/actors.ts; `melee`, the strike, engine/sim/melee.ts), and the firearms'\n * (`fire`, `aim`, which raises the sights and the camera's zoom, `reload`, `holster`, `weapon1`, `weapon2` and\n * `swap`, engine/sim/weapons.ts).\n *\n * Game code, a page's: it imports only the engine's public API (engine/index.ts) and the playground's files.\n *\n * @example\n * import { getActionMap } from '../../engine';\n * playgroundMap('cam=iso,90,1'); // 'actionMap:playground-isometric'\n * getActionMap(PLAYGROUND_MAPS.isometric).actions.interact; // ['KeyG', 'PadWest']: Q and E turn the view there\n * @see labs/playground/controls.test.ts\n */\nimport { defineActionMap, type ActionMapSpec } from '../../engine';\nimport { FEEL_KEY } from './feel';\nimport { CARD_KEY, GOTO_KEY, HELP_KEY } from './ui/help';\nimport { cameraMode, LOOK_KEY } from './views';\n\n/** The action maps, by camera mode (labs/playground/views.ts `PLAYGROUND_CAMERAS`' names). */\nexport const PLAYGROUND_MAPS = {\n  shooter: 'actionMap:playground-shooter',\n  first: 'actionMap:playground-first',\n  platformer: 'actionMap:playground-platformer',\n  isometric: 'actionMap:playground-isometric',\n  'top-down': 'actionMap:playground-top-down',\n} as const;\n\n/** The actions the player answers, with what each does, in the settings' order (ui/settings.ts; the controls sheet groups its own, ui/help.ts); the rest are bound for later WPs. */\nexport const PLAYGROUND_ACTIONS: Readonly<Record<string, string>> = {\n  jump: 'Jump',\n  sprint: 'Sprint: hold, or press once to keep it',\n  walk: 'Walk',\n  crouch: 'Crouch: hold',\n  interact: 'Use: a door, a switch, a chair to carry and throw, a zipline, a ladder',\n  melee: 'Strike: a punch with a lunge, a kick in the air, an uppercut from a slide; a door takes a kick, then breaks',\n  fire: 'Fire (draws the weapon if holstered)',\n  aim: 'Aim down sights',\n  reload: 'Reload',\n  weapon1: 'Draw the pistol',","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LS7PFxRHwtoWKDY5MP1R1D","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
