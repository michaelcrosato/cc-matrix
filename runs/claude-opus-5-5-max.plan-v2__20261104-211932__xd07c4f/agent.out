{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VB5ciDTtC88fG2wBby6VtS","type":"tool_result","content":"114: * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n249:    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n416:      check('game named', false, 'pass ?game=<path> of a page on this site');\nwrote probe-out/h/net.html 6726009\n74:  'gfx.warmUp': {\n75-    type: 'string',\n76-    enum: ['all', 'asked'],\n77-    default: 'all',\n78-    view: true,\n79-    description:\n80-      \"What a page's warm-ups compile: all (both cameras, the plain frame and the style set's own style, so no later switch warms up) or asked (only the cameras, the frame and the styles the page has drawn: a first frame of another warms\n81-  },\n82-} as const satisfies Record<string, Field>;\n83-defineSettings(WARMUP_SETTINGS);\n84-\n--\n86:export const warmsAsked = (settings: { get(path: string): unknown }): boolean => settings.get('gfx.warmUp') === 'asked';\n87-\n38:  quality: {\n/**\n * @file Quality tiers, the defaults for phones (PLAN.md WP 3.12, ADR-0021: built, not tested): the view setting\n * `quality` (`auto`, `low`, `medium` or `high`) and what each tier turns off. `auto` is `medium` on touch screens and\n * `high` elsewhere; the app gives the touch mode (engine/input/devices/touch.ts) and applies the budget.\n *\n * - `high`: everything; on a touch screen, at most 2 device pixels per CSS pixel.\n * - `medium`: at most 1 megapixel, one shadow caster, GI and god rays off.\n * - `low`: at most 0.5 megapixel, no shadow casters, and bloom and halos off as well.\n *\n * engine/gfx/resolution.ts applies the pixel caps (`resolution.cap(budget)`), engine/gfx/shadows.ts the shadow\n * casters, the post chain the bloom (engine/gfx/post/chain.ts), and its shading the GI, the god rays (the air's light\n * shafts) and the halos (engine/gfx/post/shading.ts, WP 11.5).\n *\n * Invariants: a view setting, so `capture()`, the hash and sim-side code never see it; on the desktop `auto` is\n * `high`, which caps nothing, so a desktop draws as it did before this module. No `@example` runs here: it would be a\n * touch test, which the owner ruled out (ADR-0021).\n *\n * Carried from `shardfall:crates/pav_app/src/quality.rs:29-115` (`resolve`, `trim`, the scaler's caps; its dynamic\n * scale is left for a measured need).\n *\n * @example\n * // qualityBudget('auto', true); // { tier: 'medium', maxPixels: 1e6, shadowCasters: 1, gi: false, … }\n */\nimport type { Field } from '../core/schema';\nimport { defineSettings } from '../core/settings';\n\n/** The `quality` setting's values. */\nexport const QUALITY_SETTING_VALUES = ['auto', 'low', 'medium', 'high'] as const;\n\n/** The `quality` setting: a tier, or `auto`. */","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"a3758061-6c16-48e2-83e0-13870599a2b5","timestamp":"2026-11-05T04:50:15.260Z","tool_use_result":{"stdout":"114: * Only a page of this site is loaded: ?game= comes from the address bar, and a javascript: or another site's\n249:    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n416:      check('game named', false, 'pass ?game=<path> of a page on this site');\nwrote probe-out/h/net.html 6726009\n74:  'gfx.warmUp': {\n75-    type: 'string',\n76-    enum: ['all', 'asked'],\n77-    default: 'all',\n78-    view: true,\n79-    description:\n80-      \"What a page's warm-ups compile: all (both cameras, the plain frame and the style set's own style, so no later switch warms up) or asked (only the cameras, the frame and the styles the page has drawn: a first frame of another warms\n81-  },\n82-} as const satisfies Record<string, Field>;\n83-defineSettings(WARMUP_SETTINGS);\n84-\n--\n86:export const warmsAsked = (settings: { get(path: string): unknown }): boolean => settings.get('gfx.warmUp') === 'asked';\n87-\n38:  quality: {\n/**\n * @file Quality tiers, the defaults for phones (PLAN.md WP 3.12, ADR-0021: built, not tested): the view setting\n * `quality` (`auto`, `low`, `medium` or `high`) and what each tier turns off. `auto` is `medium` on touch screens and\n * `high` elsewhere; the app gives the touch mode (engine/input/devices/touch.ts) and applies the budget.\n *\n * - `high`: everything; on a touch screen, at most 2 device pixels per CSS pixel.\n * - `medium`: at most 1 megapixel, one shadow caster, GI and god rays off.\n * - `low`: at most 0.5 megapixel, no shadow casters, and bloom and halos off as well.\n *\n * engine/gfx/resolution.ts applies the pixel caps (`resolution.cap(budget)`), engine/gfx/shadows.ts the shadow\n * casters, the post chain the bloom (engine/gfx/post/chain.ts), and its shading the GI, the god rays (the air's light\n * shafts) and the halos (engine/gfx/post/shading.ts, WP 11.5).\n *\n * Invariants: a view setting, so `capture()`, the hash and sim-side code never see it; on the desktop `auto` is\n * `high`, which caps nothing, so a desktop draws as it did before this module. No `@example` runs here: it would be a\n * touch test, which the owner ruled out (ADR-0021).\n *\n * Carried from `shardfall:crates/pav_app/src/quality.rs:29-115` (`resolve`, `trim`, the scaler's caps; its dynamic\n * scale is left for a measured need).\n *\n * @example\n * // qualityBudget('auto', true); // { tier: 'medium', maxPixels: 1e6, shadowCasters: 1, gi: false, … }\n */\nimport type { Field } from '../core/schema';\nimport { defineSettings } from '../core/settings';\n\n/** The `quality` setting's values. */\nexport const QUALITY_SETTING_VALUES = ['auto', 'low', 'medium', 'high'] as const;\n\n/** The `quality` setting: a tier, or `auto`. */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VB5ciDTtC88fG2wBby6VtS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
