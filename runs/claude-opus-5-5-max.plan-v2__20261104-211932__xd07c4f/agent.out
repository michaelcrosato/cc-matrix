ult>;\n}\n\n/** `host` as the app made it. */\nconst app = (host: InspectorHost) => host as AppHost;\n\n/** The host's view; throws `APP_NO_VIEW` naming `member` when it has none. */\nfunction viewOf(host: InspectorHost, member: string): RunView {\n  const { view } = app(host);\n  if (!view) throw codeError('APP_NO_VIEW', { member });\n  return view;\n}\n\ndefineMember('ready', {\n  help: 'Whether the engine is up: a page once its first frame is drawn, headless at once; false after a startup error.',\n  value: true,\n  impl: (h) => app(h).ready,\n});\n\n24:import { defineMember, type InspectorHost } from '../dev/members';\n55:defineMember('ready', {\n61:defineMember('render', {\n64:  args: { n: { type: 'integer', default: 1, minimum: 1, maximum: 600, description: 'How many frames.' } },\n68:defineMember('shot', {\n71:  args: {\n82:defineMember('camera.get', {\n87:defineMember('camera.set', {\n89:  args: {\n96:defineMember('camera.advance', {\n98:  args: { n: { type: 'integer', default: 60, minimum: 1, maximum: 600, description: 'How many frames.' } },\n102:defineMember('scene.dump', {\n104:  args: {\n115:defineMember('fx.stats', {\n120:defineMember('replay', {\n122:  args: {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Ktmvjku7WRwGVFPqsq8C7q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
