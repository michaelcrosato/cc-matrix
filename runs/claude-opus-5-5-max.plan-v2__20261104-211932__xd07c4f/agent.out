{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3qdSMJo4bKcw4vPqLwBHq","type":"tool_result","content":"/**\n * @file The playground's player (docs/PLAYGROUND.md §3, PLAN.md WP 13.1–13.3): the character the keys move, the body\n * it is drawn as, and `spawnPlayer`, which stands it in a scene. It moves as in Apex Legends, on the profile\n * `movement:apex` (engine/physics/movement/profiles.ts): a medium legend's hull (1.83 m tall, 0.41 m in radius), its\n * steps, slopes, gravity and jump, and the shooter model at Apex's numbers (docs/PLAYGROUND.md §3.2). It starts\n * empty-handed, so holstered: every gait 1.15 times faster than with a weapon out. A scene may give it weapons to\n * carry (`weapons`, WP 13.20: the site's the pistol and the rifle, labs/playground/weapons/guns.ts), holstered until\n * drawn. It is drawn as `body:player` (labs/playground/bodies/player.ts, which the page registers) on `build:adult`,\n * 1.80 m standing. The setting `playground.movement` (the settings screen's movement profile, WP 13.25) moves it as the\n * Stress Box hero instead (`movement:platformer`, its feel exactly, untuned); it is read when the scene starts.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter().characterGravity; // 19.05: m/s², Apex's 750 units/s²\n * playerCharacter().movement?.gaits.sprint; // 6.604: m/s with a weapon out, 260 units/s\n * playerCharacter({ speed: 5 }).movement?.gaits.run; // 5\n * @see labs/playground/scenes/gym.test.ts\n */\nimport {\n  createCharacter,\n  defineSettings,\n  getMovement,\n  spawnActor,\n  weaponsFor,\n  type Character,\n  type World,\n} from '../../../engine/sim-api';\n\n/** The profiles the player may move by: Apex's, the default, and the Stress Box hero's. */\nexport const PLAYER_MOVEMENTS = ['movement:apex', 'movement:platformer'] as const;\n\n/** The player's setting (see the file comment). */\nexport const PLAYER_SETTINGS = defineSettings({\n  'playground.movement': {\n    type: 'string',\n    enum: [...PLAYER_MOVEMENTS],\n    default: 'movement:apex',\n    when: 'scene',\n    description:\n      \"The profile the playground's player moves by (labs/playground/cast/player.ts): Apex Legends' movement as tuned, or the Stress Box hero's platformer feel (engine/physics/movement/profiles.ts); read when the scene starts.\",\n  },\n});\n\n/** The profile the player moves by. */\nconst APEX = getMovement('movement:apex');\n\n/** Apex's gravity (m/s²): 750 units/s², an inch a unit (docs/PLAYGROUND.md §3.2). */\nexport const APEX_GRAVITY = APEX.character.characterGravity as number;\n\n/** Apex's jump (m): 56 units. */\nexport const APEX_JUMP = Math.pow(APEX.character.jumpSpeed as number, 2) / (2 * APEX_GRAVITY);\n\n/** Apex's run with a weapon out (m/s): 173.5 units/s; holstered, the player runs 1.15 times as fast. */\nexport const APEX_RUN = APEX.model!.gaits.run;\n\n/** How the player is drawn: `body:player` on the adult build, empty-handed. */\nexport const PLAYER_LOOK = Object.freeze({ body: 'body:player', build: 'build:adult', weapon: 'none' });\n\n/** What a scene may tune: the run with a weapon out (m/s) and the jump's height (m); and the profile, Apex's by default. */\nexport interface PlayerTuning {\n  readonly speed?: number;\n  readonly jump?: number;\n  readonly movement?: (typeof PLAYER_MOVEMENTS)[number];\n}\n\n/**\n * The player's character: `movement:apex`, its run and its jump's height (a take-off of √(2 g h)) as tuned; on\n * another profile, that profile's own character, the tuning unused.\n */\nexport function playerCharacter(tuning: PlayerTuning = {}): Character {\n  if (tuning.movement && tuning.movement !== 'movement:apex') return createCharacter({ movement: tuning.movement });\n  const run = tuning.speed ?? APEX_RUN;\n  const jump = tuning.jump ?? APEX_JUMP;\n  return createCharacter({\n    movement: 'movement:apex',\n    speed: run,\n    jumpSpeed: Math.sqrt(2 * APEX_GRAVITY * jump),\n    model: { gaits: { run } },\n  });\n}\n\n/**\n * Stands the player in `w` (a scene with physics) at `at`, facing `yaw`: an actor the step's intents move, carrying\n * `weapons` (ids, in slot order; none by default), holstered.\n */\nexport function spawnPlayer<C extends object>(\n  w: World<C>,\n  at: readonly [number, number, number],\n  yaw = 0,\n  weapon1: 'Draw the pistol',\n  weapon2: 'Draw the rifle',\n  swap: 'Swap weapons',\n  holster: 'Holster, or draw again',\n};\n\n/** The keys the page keeps for itself: the look (P), the feel panel (F), Go to (M), the controls sheet (H) and the area's card (I). */ // prettier-ignore\nconst PAGE_KEYS = [LOOK_KEY, FEEL_KEY, GOTO_KEY, HELP_KEY, CARD_KEY];\n\n/** Every mode's bindings (see the file comment). */\nconst ACTIONS: Readonly<Record<string, readonly string[]>> = {\n  forward: ['KeyW', 'ArrowUp', 'PadLeftStickUp'],\n  back: ['KeyS', 'ArrowDown', 'PadLeftStickDown'],\n  left: ['KeyA', 'ArrowLeft', 'PadLeftStickLeft'],\n  right: ['KeyD', 'ArrowRight', 'PadLeftStickRight'],\n  jump: ['Space', 'PadSouth'],\n  sprint: ['ShiftLeft', 'PadLeftStick'],\n  walk: ['AltLeft'],\n  crouch: ['KeyC', 'PadEast'],\n  interact: ['KeyE', 'PadWest'],\n  melee: ['KeyV', 'PadRightStick'],\n  fire: ['MouseLeft', 'PadRightTrigger'],\n  aim: ['MouseRight', 'PadLeftTrigger'],\n  reload: ['KeyR', 'Hold:PadWest'],\n  weapon1: ['Digit1'],\n  weapon2: ['Digit2'],\n  swap: ['PadNorth'],\n  holster: ['Digit3', 'Hold:PadNorth'],\n  camera: ['KeyT', 'PadSelect'],\n};\n\n/** Each mode's map, written once here and registered below. */\nconst SPECS: Readonly<Record<keyof typeof PLAYGROUND_MAPS, ActionMapSpec>> = {\n  shooter: {\n    description: 'The playground’s shooter camera: the view sent, aimed at the screen’s centre, X swaps the shoulder.',\n    actions: { ...ACTIONS, shoulder: ['KeyX', 'PadLeft'] },\n    view: ['camera', 'shoulder'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  first: {\n    description: 'The playground’s first person: the view sent, aimed at the screen’s centre.',\n    actions: ACTIONS,\n    view: ['camera'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  platformer: {\n    description: 'The playground’s platformer camera: moving relative to it, the mouse turning it, facing the move.',\n    actions: ACTIONS,\n    view: ['camera'],\n    lock: true,\n  },\n  isometric: {\n    description: 'The playground’s isometric view: aimed with the pointer, Q and E turning the view, so G uses.',\n    actions: { ...ACTIONS, interact: ['KeyG', 'PadWest'], turnLeft: ['KeyQ'], turnRight: ['KeyE', 'PadRight'] },\n    view: ['camera', 'turnLeft', 'turnRight'],\n    aimWith: 'pointer',\n  },\n  'top-down': {\n    description: 'The playground’s top-down view: aimed with the pointer.',\n    actions: ACTIONS,\n    view: ['camera'],\n    aimWith: 'pointer',\n  },\n};\n\nfor (const [mode, spec] of Object.entries(SPECS)) {\n  defineActionMap(PLAYGROUND_MAPS[mode as keyof typeof PLAYGROUND_MAPS], { ...spec, reserved: PAGE_KEYS });\n}\n\n/** The action map for the camera `code` (`cam3=first,…`): its mode's, the shooter's for a camera no mode opens. */\nexport function playgroundMap(code: string): string {\n  const mode = cameraMode(code)?.name as keyof typeof PLAYGROUND_MAPS | undefined;\n  return PLAYGROUND_MAPS[mode ?? 'shooter'];\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"625fe5d1-754f-48ec-834c-c9ed467c1ecb","timestamp":"2026-11-05T04:36:27.414Z","tool_use_result":{"stdout":"/**\n * @file The playground's player (docs/PLAYGROUND.md §3, PLAN.md WP 13.1–13.3): the character the keys move, the body\n * it is drawn as, and `spawnPlayer`, which stands it in a scene. It moves as in Apex Legends, on the profile\n * `movement:apex` (engine/physics/movement/profiles.ts): a medium legend's hull (1.83 m tall, 0.41 m in radius), its\n * steps, slopes, gravity and jump, and the shooter model at Apex's numbers (docs/PLAYGROUND.md §3.2). It starts\n * empty-handed, so holstered: every gait 1.15 times faster than with a weapon out. A scene may give it weapons to\n * carry (`weapons`, WP 13.20: the site's the pistol and the rifle, labs/playground/weapons/guns.ts), holstered until\n * drawn. It is drawn as `body:player` (labs/playground/bodies/player.ts, which the page registers) on `build:adult`,\n * 1.80 m standing. The setting `playground.movement` (the settings screen's movement profile, WP 13.25) moves it as the\n * Stress Box hero instead (`movement:platformer`, its feel exactly, untuned); it is read when the scene starts.\n *\n * Game code, sim-side: it imports only engine/sim-api.ts.\n *\n * @example\n * playerCharacter().characterGravity; // 19.05: m/s², Apex's 750 units/s²\n * playerCharacter().movement?.gaits.sprint; // 6.604: m/s with a weapon out, 260 units/s\n * playerCharacter({ speed: 5 }).movement?.gaits.run; // 5\n * @see labs/playground/scenes/gym.test.ts\n */\nimport {\n  createCharacter,\n  defineSettings,\n  getMovement,\n  spawnActor,\n  weaponsFor,\n  type Character,\n  type World,\n} from '../../../engine/sim-api';\n\n/** The profiles the player may move by: Apex's, the default, and the Stress Box hero's. */\nexport const PLAYER_MOVEMENTS = ['movement:apex', 'movement:platformer'] as const;\n\n/** The player's setting (see the file comment). */\nexport const PLAYER_SETTINGS = defineSettings({\n  'playground.movement': {\n    type: 'string',\n    enum: [...PLAYER_MOVEMENTS],\n    default: 'movement:apex',\n    when: 'scene',\n    description:\n      \"The profile the playground's player moves by (labs/playground/cast/player.ts): Apex Legends' movement as tuned, or the Stress Box hero's platformer feel (engine/physics/movement/profiles.ts); read when the scene starts.\",\n  },\n});\n\n/** The profile the player moves by. */\nconst APEX = getMovement('movement:apex');\n\n/** Apex's gravity (m/s²): 750 units/s², an inch a unit (docs/PLAYGROUND.md §3.2). */\nexport const APEX_GRAVITY = APEX.character.characterGravity as number;\n\n/** Apex's jump (m): 56 units. */\nexport const APEX_JUMP = Math.pow(APEX.character.jumpSpeed as number, 2) / (2 * APEX_GRAVITY);\n\n/** Apex's run with a weapon out (m/s): 173.5 units/s; holstered, the player runs 1.15 times as fast. */\nexport const APEX_RUN = APEX.model!.gaits.run;\n\n/** How the player is drawn: `body:player` on the adult build, empty-handed. */\nexport const PLAYER_LOOK = Object.freeze({ body: 'body:player', build: 'build:adult', weapon: 'none' });\n\n/** What a scene may tune: the run with a weapon out (m/s) and the jump's height (m); and the profile, Apex's by default. */\nexport interface PlayerTuning {\n  readonly speed?: number;\n  readonly jump?: number;\n  readonly movement?: (typeof PLAYER_MOVEMENTS)[number];\n}\n\n/**\n * The player's character: `movement:apex`, its run and its jump's height (a take-off of √(2 g h)) as tuned; on\n * another profile, that profile's own character, the tuning unused.\n */\nexport function playerCharacter(tuning: PlayerTuning = {}): Character {\n  if (tuning.movement && tuning.movement !== 'movement:apex') return createCharacter({ movement: tuning.movement });\n  const run = tuning.speed ?? APEX_RUN;\n  const jump = tuning.jump ?? APEX_JUMP;\n  return createCharacter({\n    movement: 'movement:apex',\n    speed: run,\n    jumpSpeed: Math.sqrt(2 * APEX_GRAVITY * jump),\n    model: { gaits: { run } },\n  });\n}\n\n/**\n * Stands the player in `w` (a scene with physics) at `at`, facing `yaw`: an actor the step's intents move, carrying\n * `weapons` (ids, in slot order; none by default), holstered.\n */\nexport function spawnPlayer<C extends object>(\n  w: World<C>,\n  at: readonly [number, number, number],\n  yaw = 0,\n  weapon1: 'Draw the pistol',\n  weapon2: 'Draw the rifle',\n  swap: 'Swap weapons',\n  holster: 'Holster, or draw again',\n};\n\n/** The keys the page keeps for itself: the look (P), the feel panel (F), Go to (M), the controls sheet (H) and the area's card (I). */ // prettier-ignore\nconst PAGE_KEYS = [LOOK_KEY, FEEL_KEY, GOTO_KEY, HELP_KEY, CARD_KEY];\n\n/** Every mode's bindings (see the file comment). */\nconst ACTIONS: Readonly<Record<string, readonly string[]>> = {\n  forward: ['KeyW', 'ArrowUp', 'PadLeftStickUp'],\n  back: ['KeyS', 'ArrowDown', 'PadLeftStickDown'],\n  left: ['KeyA', 'ArrowLeft', 'PadLeftStickLeft'],\n  right: ['KeyD', 'ArrowRight', 'PadLeftStickRight'],\n  jump: ['Space', 'PadSouth'],\n  sprint: ['ShiftLeft', 'PadLeftStick'],\n  walk: ['AltLeft'],\n  crouch: ['KeyC', 'PadEast'],\n  interact: ['KeyE', 'PadWest'],\n  melee: ['KeyV', 'PadRightStick'],\n  fire: ['MouseLeft', 'PadRightTrigger'],\n  aim: ['MouseRight', 'PadLeftTrigger'],\n  reload: ['KeyR', 'Hold:PadWest'],\n  weapon1: ['Digit1'],\n  weapon2: ['Digit2'],\n  swap: ['PadNorth'],\n  holster: ['Digit3', 'Hold:PadNorth'],\n  camera: ['KeyT', 'PadSelect'],\n};\n\n/** Each mode's map, written once here and registered below. */\nconst SPECS: Readonly<Record<keyof typeof PLAYGROUND_MAPS, ActionMapSpec>> = {\n  shooter: {\n    description: 'The playground’s shooter camera: the view sent, aimed at the screen’s centre, X swaps the shoulder.',\n    actions: { ...ACTIONS, shoulder: ['KeyX', 'PadLeft'] },\n    view: ['camera', 'shoulder'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  first: {\n    description: 'The playground’s first person: the view sent, aimed at the screen’s centre.',\n    actions: ACTIONS,\n    view: ['camera'],\n    look: true,\n    aimWith: 'centre',\n    lock: true,\n  },\n  platformer: {\n    description: 'The playground’s platformer camera: moving relative to it, the mouse turning it, facing the move.',\n    actions: ACTIONS,\n    view: ['camera'],\n    lock: true,\n  },\n  isometric: {\n    description: 'The playground’s isometric view: aimed with the pointer, Q and E turning the view, so G uses.',\n    actions: { ...ACTIONS, interact: ['KeyG', 'PadWest'], turnLeft: ['KeyQ'], turnRight: ['KeyE', 'PadRight'] },\n    view: ['camera', 'turnLeft', 'turnRight'],\n    aimWith: 'pointer',\n  },\n  'top-down': {\n    description: 'The playground’s top-down view: aimed with the pointer.',\n    actions: ACTIONS,\n    view: ['camera'],\n    aimWith: 'pointer',\n  },\n};\n\nfor (const [mode, spec] of Object.entries(SPECS)) {\n  defineActionMap(PLAYGROUND_MAPS[mode as keyof typeof PLAYGROUND_MAPS], { ...spec, reserved: PAGE_KEYS });\n}\n\n/** The action map for the camera `code` (`cam3=first,…`): its mode's, the shooter's for a camera no mode opens. */\nexport function playgroundMap(code: string): string {\n  const mode = cameraMode(code)?.name as keyof typeof PLAYGROUND_MAPS | undefined;\n  return PLAYGROUND_MAPS[mode ?? 'shooter'];\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01K3qdSMJo4bKcw4vPqLwBHq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
