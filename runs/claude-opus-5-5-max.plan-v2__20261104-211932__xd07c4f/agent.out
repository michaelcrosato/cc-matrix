export interface PlayOptions {\nengine/audio/runtime/sound.ts-42-  /** Gain, 0 to 4; 1 by default. */\nengine/audio/runtime/sound.ts-43-  vol?: number;\nengine/audio/runtime/sound.ts-44-  /** Playback rate (pitch and speed together), 0.1 to 10; 1 by default. */\nengine/audio/runtime/sound.ts-45-  pitch?: number;\nengine/audio/runtime/sound.ts-46-  /** The variant; in turn by default. */\nengine/audio/runtime/sound.ts-47-  variant?: number;\nengine/audio/runtime/sound.ts-48-  /** The bus; the entry's by default. */\nengine/audio/runtime/sound.ts-49-  bus?: AudioBus;\nengine/audio/runtime/sound.ts-50-  /** Where it sounds, world space, m: placed and occluded; unplaced (in the head) by default. */\nengine/audio/runtime/sound.ts-51-  position?: Vec3;\nengine/audio/runtime/sound.ts-52-  /** The context time it starts at; now by default. */\nengine/audio/runtime/sound.ts-53-  when?: number;\nengine/audio/runtime/sound.ts-54-  /** Loops until stopped (ambience). */\nengine/audio/runtime/sound.ts-55-  loop?: boolean;\nengine/audio/runtime/sound.ts-56-  /** Ducks the music and ambience while it plays. */\nengine/audio/runtime/sound.ts-57-  duck?: boolean;\nengine/audio/runtime/sound.ts-58-}\nengine/audio/runtime/sound.ts-59-\nengine/audio/runtime/sound.ts-60-/** A sound playing. */\nengine/audio/runtime/sound.ts-61-export interface Sound {\nengine/audio/runtime/sound.ts-62-  readonly id: string;\nengine/audio/runtime/sound.ts-63-  readonly bus: AudioBus;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01G5aXombYuVQJx4mTXEQspz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
