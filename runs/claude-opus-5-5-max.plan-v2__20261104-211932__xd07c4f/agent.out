${(t3 - t2).toFixed(0)} ms, actors ${(t4 - t3).toFixed(0)} ms`);\n  },\n  step(w: World) {\n    for (const e of w.query('actor') as never as { actor: { intents: object } }[]) e.actor.intents = { move: [1, 0] };\n  },\n});\n\nit('costs', { timeout: 300000 }, () => {\n  const t0 = performance.now();\n  const terrain = getTerrain('terrain:probe');\n  console.log(`terrain made ${(performance.now() - t0).toFixed(0)} ms, ${terrain.cols}x${terrain.rows}, bounds y ${terrain.bounds.min[1].toFixed(1)}..${terrain.bounds.max[1].toFixed(1)}`);\n  const t1 = performance.now();\n  const grid = terrainNavGrid(terrain, { maxClimb: 1 } as never);\n  console.log(`nav grid ${(performance.now() - t1).toFixed(0)} ms`);\n  const t2 = performance.now();\n  const flow = new FlowField(grid as never, [700, 700] as never);\n  console.log(`flow field ${(performance.now() - t2).toFixed(0)} ms`, typeof flow);\n  const t3 = performance.now();\n  const engine = createHeadless({ scene: scene.id, seed: 1 });\n  console.log(`start ${(performance.now() - t3).toFixed(0)} ms, entities ${engine.entities().length}`);\n  const t4 = performance.now();\n  engine.step(600);\n  console.log(`600 steps: ${((performance.now() - t4) / 600).toFixed(3)} ms/step`);\n  const t5 = performance.now();\n  const h = engine.hash();\n  console.log(`hash ${(performance.now() - t5).toFixed(0)} ms: ${h}`);\n  const t6 = performance.now();\n  const c = engine.capture();\n  console.log(`capture ${(performance.now() - t6).toFixed(0)} ms, size ${JSON.stringify(c).length}`);\n  const a = (engine.entities().find((e: never) => (e as { actor?: unknown }).actor) as { id: number });\n  console.log(JSON.stringify(engine.get(a.id)).slice(0, 300));\n});\nEOF\n(time npx vitest run labs/game/probe/scale.test.ts --reporter=basic 2>&1 | grep -v \"^$\" | tail -30)","description":"Run a scale probe with a 1.5 km terrain, scenery and actors","timeout":400000}},"wire_ingest_context":{"toolu_01HcEM7wAvBVdNfk7bgWSCpN":{"cwd":"/home/micha/dev/cc-matrix