for (const e of w.query('jeep') as never as { jeep: { body: number; throttle: number; steer: number; compress: number[] } }[]) {\n    const { jeep } = e;\n    const s = physics.readBody(jeep.body);\n    const up = rot(s.rotation, [0, 1, 0]); const fw = rot(s.rotation, [0, 0, 1]); const rt = rot(s.rotation, [1, 0, 0]);\n    const v = [s.velocity.x, s.velocity.y, s.velocity.z]; const av = [s.angularVelocity.x, s.angularVelocity.y, s.angularVelocity.z];\n    WHEELS.forEach((local, i) => {\n      const o = rot(s.rotation, local); const p = [s.position.x + o[0], s.position.y + o[1], s.position.z + o[2]];\n      const hit = physics.raycast(p, [-up[0], -up[1], -up[2]], { maxDistance: REST, groups: ['world', 'prop'], exclude: jeep.body } as never);\n      if (!hit) { jeep.compress[i] = 0; return; }\n      const dist = hit.distance ?? Math.hypot(hit.point.x - p[0], hit.point.y - p[1], hit.point.z - p[2]);\n      const c = 1 - dist / REST; jeep.compress[i] = c;\n      const pv = [v[0] + av[1] * o[2] - av[2] * o[1], v[1] + av[2] * o[0] - av[0] * o[2], v[2] + av[0] * o[1] - av[1] * o[0]];\n      const along = pv[0] * up[0] + pv[1] * up[1] + pv[2] * up[2];\n      const force = Math.max(0, K * c * REST - C * along);\n      const dt = w.dt;\n      const steerable = i < 2 ? jeep.steer * 0.5 : 0;\n      const cs = Math.cos(steerable); const sn = Math.sin(steerable);\n      const wf = [fw[0] * cs + rt[0] * sn, fw[1] * cs + rt[1] * sn, fw[2] * cs + rt[2] * sn];\n      const wr = [rt[0] * cs - fw[0] * sn, rt[1] * cs - fw[1] * sn, rt[2] * cs - fw[2] * sn];\n      const side = pv[0] * wr[0] + pv[1] * wr[1] + pv[2] * wr[2];\n      const lat = -side * (MASS_HINT / 4) * GRIP / 0.35; // N, bounded by friction below\n      const maxGrip = force * 1.1;\n      const drive = jeep.throttle * ENGINE / 4;\n      const fl = Math.max(-maxGrip, Math.min(maxGrip, lat)); const fd = Math.max(-maxGrip, Math.min(maxGrip, drive));\n      physics.applyImpulse(jeep.body, [(up[0] * force + wr[0] * fl + wf[0] * fd) * dt, (up[1] * force + wr[1] * fl + wf[1] * fd) * dt, (up[2] * force + wr[2] * fl + wf[2] * fd) * dt], p);\n    });\n  }\n}\nfunction seat(w: World) {\n  for (const e of w.query('jeep') as never as { jeep: { body: number; driver: number } }[]) {\n    if (e.jeep.driver < 0) continue;\n    const s = physicsOf(w).readBody(e.jeep.body);\n    const o = rot(s.rotation, [-0.4, 0.2, 0.2]);\n    placeActor(w, e.jeep.driver, [s.position.x + o[0], s.position.y + o[1] - 0.5, s.position.z + o[2]]);\n  }\n}\nconst scene = defineScene('game:jeep', {\n  description: 'x', physics: true,\n  setup(w: World) {\n    const t = getTerrain('terrain:jeep');\n    addTerrainBody(physicsOf(w), t);\n    const [x, z] = [512, 512];\n    const body = physicsOf(w).addBody({ type: 'dynamic', position: [x, terrainHeight(t, x, z)! + 1.2, z], group: 'flyer', colliders: [{ shape: { type: 'box', size: [1.8, 1.0, 3.9] }, density: 220, friction: 0.4 }], linearDamping: 0.02, angularDamping: 0.6, canSleep: false } as never);\n    const me = spawnActor(w, { at: [x + 5, terrainHeight(t, x + 5, z)! + 0.05, z], character: createCharacter({ movement: 'movement:apex' }), player: true, anim: { build: 'build:adult' } } as never);\n    const mass = physicsOf(w).readBody(body) as never as { mass: number };\n    console.log('mass', mass.mass);\n    w.spawn({ jeep: { body, driver: me, compress: [0, 0, 0, 0] } } as never);\n    w.systems.add('game.jeep', stepJeep, { phase: 'ai' });\n    w.systems.add('game.seat', seat, { phase: 'rules' });\n  },\n  step(w: World) {\n    for (const e of w.query('jeep') as never as { jeep: { throttle: number; steer: number } }[]) {\n      const t = w.tick;\n      e.jeep.throttle = t < 900 ? 1 : t < 1000 ? -1 : 0.6;\n      e.jeep.steer = t > 1200 ? Math.sin(t / 120) * 0.8 : 0;\n    }\n  },\n});\nit('drives', { timeout: 120000 }, async () => {\n  const e = await createHeadless({ scene: scene.id, seed: 1 });\n  const t0 = performance.now();\n  const rows: string[] = [];\n  let maxY = -1e9; let minUp = 1;\n  for (let i = 0; i < 40; i++) {\n    e.step(60);\n    const jeep = (e.entities('jeep')[0] as never as { id: number }).id;\n    const j = (e.get(jeep) as never as { jeep: { body: number; compress: number[] } }).jeep;\n    const a = e.entities('actor')[0] as never as { id: number };\n    const actor = (e.get(a.id) as never as { actor: { x: number; y: number; z: number } }).actor;\n    const st = (e as never as { physics?: unknown }).physics;\n    void st;\n    rows.push(`${(i + 1)}s actor ${actor.x.toFixed(1)},${actor.y.toFixed(2)},${actor.z.toFixed(1)} comp ${j.compress.map((c) => c.toFixed(2)).join(',')}`);\n    maxY = Math.max(maxY, actor.y); minUp = Math.min(minUp, 1);\n  }\n  console.log(rows.filter((_, i) => i % 3 === 0).join('\\n'));\n  console.log(`${((performance.now() - t0) / 2400).toFixed(3)} ms/step`);\n  const h1 = e.hash();\n  const e2 = await createHeadless({ scene: scene.id, seed: 1 });\n  e2.step(2400);\n  expect(e2.hash()).toBe(h1);\n  console.log('same hash', h1);\n});\nEOF\nnpx vitest run labs/game/probe/jeep.test.ts --reporter=dot 2>&1 | grep -v \"^$\" | cut -c1-220 | tail -34","description":"Test-drive a raycast jeep with a seated driver in a headless test","timeout":200000}},"wire_ingest_context":{"toolu_01QTf4bhkQ6naZRjEhEsQQjQ":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work/.research/wk"}}}
