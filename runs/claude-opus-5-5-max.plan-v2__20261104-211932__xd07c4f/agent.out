     files: AGENT_READABLE,\n      plugins: { jsdoc, 'hard-cap': families.family('hard-cap', 'max-lines') },\n      rules: {\n        'jsdoc/require-file-overview': 'error',\n        'max-lines': ['warn', { max: 400 }],\n        'hard-cap/max-lines': ['error', { max: 600 }],\n      },\n    },\n    {\n      name: 'no enums (erasableSyntaxOnly)',\n      files: ['**/*.ts'],\n      rules: {\n        'no-restricted-syntax': [\n          'error',\n          {\n            selector: 'TSEnumDeclaration',\n            message: 'no enums (erasableSyntaxOnly): use an `as const` object and a union of its values (ADR-0003)',\n          },\n        ],\n      },\n    },\n    ...families.layerBlocks(),\n    ...families.publicApiBlocks(switches.publicApi),\n    ...families.simSideBlocks(),\n    ...families.bannedBlocks(),\n    ...families.askTheEntryBlocks(switches.askTheEntry),\n  ];\n}\n\nexport default configure();\n....\n18: * // import { createEngine, defineScene } from '../../engine';\n100:// The engine in a page (WP 2.7): createEngine reads the routes, starts the scene with its view, publishes\n203:// light, fog) that a sky puts on a scene.\n331:// The feel kit (WP 13.4): courses, scripted runs of a scene and the numbers measured on them (`node x feel`); the\n....\n/**\n * @file The view's inspector members (PLAN.md §8.3, WP 2.7): `ready`, `render`, `shot`, `camera.get`, `camera.set`,\n * `camera.advance`, `scene.dump`, `fx.stats` (WP 11.3) and `replay`, registered from here as entries of the registry\n * kind `inspectorMember` (engine/dev/members.ts), so `window.__engine` in a page and `createHeadless` in Node list the\n * same members. Headless, `render` and `shot` throw `DEV_NO_RENDERER` (they need a GPU); `camera`, `scene.dump` and\n * `fx.stats` need the scene's view (`createHeadless({ view: true })`, else `APP_NO_VIEW`); `ready` and `replay` work\n * everywhere.\n *\n * The members work on an `AppHost`: the inspector's host plus the view, the ready flag and the drawing\