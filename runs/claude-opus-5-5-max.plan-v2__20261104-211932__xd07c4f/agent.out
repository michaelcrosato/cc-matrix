e.now() - t2).toFixed(0), 'ms', Object.keys(nav).join(','));\n    for (let k = 0; k < 24; k++) {\n      spawnActor(w, { at: [600 + k * 3, 40, 700], character: createCharacter({ movement: 'movement:apex' }), player: false, anim: { build: 'build:adult' } } as never);\n    }\n  },\n  step(w: World) { for (const e of w.query('actor') as never as { actor: { intents: object } }[]) e.actor.intents = { move: [0, 1] }; },\n} as never);\nit('costs', { timeout: 300000 }, async () => {\n  const t = performance.now();\n  const e = await createHeadless({ scene: scene.id, seed: 1 });\n  console.log('start', (performance.now() - t).toFixed(0), 'ms');\n  const a = performance.now();\n  e.step(300);\n  console.log(((performance.now() - a) / 300).toFixed(3), 'ms/step');\n  const h = performance.now(); e.hash(); console.log('hash', (performance.now() - h).toFixed(0), 'ms');\n});\nEOF\nnpx vitest run labs/game/probe/site.test.ts --reporter=dot 2>&1 | grep -E \"site |start|ms/step|hash|Error|FAIL|error\" | cut -c1-300; rm -rf labs/game/probe; sed -n 1,60p ../my-3dge/labs/playground/furnish.ts | cut -c1-160 | head -30; sed -n 1,40p ../my-3dge/labs/playground/bodies/player.ts | cut -c1-170 | head -45","description":"Measure site costs with a valid hut level","timeout":300000}},"wire_ingest_context":{"toolu_01VKwz3qtNFMzNaScDrHqH66":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work/.research/wk"}}}
