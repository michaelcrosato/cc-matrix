{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015GLYW1o7QXA3pUuRTQpbsX","type":"tool_result","content":"113:export interface BodySpec {\n114-  /** `'dynamic'` (the default), `'fixed'` or `'kinematic'` (moved by the velocity code gives it). */\n115-  type?: BodyType;\n116-  position?: Vec3Like;\n117-  rotation?: QuatLike;\n118-  /** Linear velocity (m/s). */\n119-  velocity?: Vec3Like;\n120-  /** Angular velocity (rad/s). */\n121-  angularVelocity?: Vec3Like;\n122-  /** Its colliders, at least one for a body that should touch anything. */\n123-  colliders?: readonly ColliderSpec[];\n124-  /** Its colliders' group: `prop` for a dynamic body, `world` for the others, by default. */\n125-  group?: GroupName;\n126-  linearDamping?: number;\n127-  angularDamping?: number;\n128-  /** Continuous collision detection, for fast small bodies. */\n129-  ccd?: boolean;\n130-  /** Whether it may fall asleep when it rests (true). */\n131-  canSleep?: boolean;\n132-  /** How much of the world's gravity it feels (1). */\n133-  gravityScale?: number;\n134-  /** Solver passes beyond the pinned ones for its island (0): a ragdoll's joints hold better (engine/physics/ragdoll.ts). */\n135-  solverIterations?: number;\n136-}\n137-\n138-/** A body's state, copied: changing it changes nothing. */\n139-export interface BodyState {\n140-  id: number;\n141-  type: BodyType;\n142-  position: Vector3;\n143-  rotation: Quaternion;\n144-  velocity: Vector3;\n145-  angularVelocity: Vector3;\n146-  sleeping: boolean;\n147-  /** kg. */\n152:export interface BodyChange {\n153-  position?: Vec3Like;\n154-  rotation?: QuatLike;\n155-  velocity?: Vec3Like;\n156-  angularVelocity?: Vec3Like;\n157-}\n158-\n159-/** What `step` reads from the sim: the step length and the settings (`physics.gravity`). */\n160-export interface PhysicsStepper {\n161-  readonly dt: number;\n162-  readonly settings: { get(path: string): unknown };\n163-}\n164-\n165-/** A physics world: bodies, stepping, queries, and the sim's physics hook (`state`, `capture`, `restore`). */\n166-export interface Physics {\n167-  /** Bodies in the world. */\n168-  readonly count: number;\n94:export interface ColliderSpec {\n95-  /** A query shape, or a convex hull of points, a heightfield or a triangle mesh (bodies only: heightfield.ts, trimesh.ts). */\n96-  shape: Shape | HullShape | HeightfieldShape | TrimeshShape;\n97-  /** Where it sits on the body (the body's origin by default). */\n98-  position?: Vec3Like;\n99-  rotation?: QuatLike;\n100-  /** kg/m³ (1,000). */\n101-  density?: number;\n102-  /** Coulomb friction (0.5). */\n103-  friction?: number;\n104-  /** Bounciness, 0 to 1 (0). */\n105-  restitution?: number;\n106-  /** Its collision group (the body's by default). */\n107-  group?: GroupName;\n108-  /** A sensor detects overlaps and blocks nothing. */\n109-  sensor?: boolean;\n110-}\n111-\n112-/** A body as `addBody` takes it. */\n113-export interface BodySpec {\n114-  /** `'dynamic'` (the default), `'fixed'` or `'kinematic'` (moved by the velocity code gives it). */\n115-  type?: BodyType;\n116-  position?: Vec3Like;\nengine/physics/queries.ts:60:export type Shape =\nengine/physics/queries.ts-61-  | { readonly type: 'box'; readonly size: Vec3Like }\nengine/physics/queries.ts-62-  | { readonly type: 'ball'; readonly radius: number }\nengine/physics/queries.ts-63-  | { readonly type: 'capsule'; readonly radius: number; readonly height: number }\nengine/physics/queries.ts-64-  | { readonly type: 'cylinder'; readonly radius: number; readonly height: number };\nengine/physics/queries.ts-65-\nengine/physics/queries.ts-66-/** A convex hull, for bodies only: the smallest convex solid holding `points` (m, in the body's frame), at least 4 not all in one plane. */\nengine/physics/queries.ts-67-export interface HullShape {\nengine/physics/queries.ts-68-  readonly type: 'hull';\nengine/physics/queries.ts-69-  readonly points: readonly Vec3Like[];\nengine/physics/queries.ts-70-}\nengine/physics/queries.ts-71-\nengine/physics/queries.ts-72-/** What every query takes: the groups it hits, and a body it skips. */\nengine/physics/queries.ts-73-export interface QueryOptions {\nengine/physics/queries.ts-74-  /** The collision groups it hits (all of them by default). */\n11: * Bodies are plain data in, ids out: `addBody({ type, position, rotation, velocity, angularVelocity, colliders, group,\n16: * their group from the body (`prop` for dynamic bodies, `world` otherwise) unless they name one\n106:  /** Its collision group (the body's by default). */\n107:  group?: GroupName;\n124:  /** Its colliders' group: `prop` for a dynamic body, `world` for the others, by default. */\n125:  group?: GroupName;\n256:function colliderDesc(spec: ColliderSpec, group: GroupName, where: string): RAPIER.ColliderDesc {\n266:    .setCollisionGroups(groupBits(spec.group ?? group))\n301:      const group = spec.group ?? (type === 'dynamic' ? 'prop' : 'world');\n302:      groupBits(group); // an unknown group throws before anything is added\n305:      const descs = colliders.map((collider, i) => colliderDesc(collider, group, `addBody({ colliders[${i}] })`));\nexport function spawnActor<C extends object>(world: World<C>, spec: ActorSpec): number {\n  const w = world as unknown as World;\n  const physics = physicsOf(w);\n  const body = addCharacter(physics, spec.character, spec.at);\n  const { x, y, z } = feetOf(physics, body, spec.character);\n  const state = { ...createCharacterState(), yaw: spec.yaw ?? 0 };\n  if (!w.systems.has('actors')) {\n    w.systems.add('actors', moveActors, { phase: 'anim' });\n    w.systems.add('actors.readback', readActors, { phase: 'readback' });\n  }\n  const actor = { body, player: spec.player ?? true, character: spec.character, x, y, z, ...state };\n  const motion = spec.character.movement ? { motion: { ...createMotionState(), holstered: spec.holstered ?? true } } : {}; // prettier-ignore\n  if (!spec.anim) return w.spawn({ ...spec.components, ...motion, actor });\n  if (!w.systems.has('actors.anim')) {\n    w.systems.add('actors.anim', stepAnimators, { phase: 'anim' });\n    w.systems.add('actors.pose', poseAnimators, { phase: 'readback' });\n  }\n  const { build = 'build:chibi', weapon = 'none', preciseHits = false } = spec.anim;\n  const animator = { build: typeof build === 'string' ? build : build.id, weapon, preciseHits };\n  const puppet = spec.body !== undefined ? { body: spec.body } : undefined;\n  const clips = spec.clips && (clipsFor(w, spec.clips, animator.build) as unknown as Record<string, unknown>);\n  return w.spawn({ ...spec.components, ...motion, actor, animator, puppet, clips });\n}\n\n/**\n * Puts actor `id` at `at`, its feet on the ground below (just above, outside the skin, as a spawn stands it), facing\n * `yaw` (its own when absent), at rest: no velocity, no jump, dash or landing pending, standing (its hull too); on the\n * shooter model its motion state starts again, holstered as it was, or ducked with `crouch`, its hull crouched from its\n * next step on and kept so until it has headroom, for a place no standing hull fits (a crawlspace). A place where the\n * level (the queries' as of the last step, one-way platforms aside) stands over its feet lower than its hull's top, up\n * its axis, throws `SIM_BAD_ARGUMENT` before it moves anything: the body would sink through the floor. For a scene's dev actions: a feel\n * course places its player where it measures (engine/dev/feel/course.ts).\n */","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"a3ff1688-0809-4476-9738-895b453269f2","timestamp":"2026-11-05T05:07:32.630Z","tool_use_result":{"stdout":"113:export interface BodySpec {\n114-  /** `'dynamic'` (the default), `'fixed'` or `'kinematic'` (moved by the velocity code gives it). */\n115-  type?: BodyType;\n116-  position?: Vec3Like;\n117-  rotation?: QuatLike;\n118-  /** Linear velocity (m/s). */\n119-  velocity?: Vec3Like;\n120-  