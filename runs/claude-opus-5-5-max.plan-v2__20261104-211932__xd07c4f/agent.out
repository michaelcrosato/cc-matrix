{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FTGZ7e4vPGvxgYuuw76ZJn","type":"tool_result","content":"/**\n * @file Firearms in a scene (PLAN.md WP 13.20; docs/PLAYGROUND.md §7.2): a player carries weapons (the kind `weapon`,\n * engine/world/weapons.ts) in the component `weapons` (`weaponsFor(slots)`, given at spawn: engine/sim/actors.ts's\n * `components`), and the system `weapons` (phase `intents`, after the uses and melee; `addWeapons(w)`, once) plays\n * them, players in id order:\n * - **Drawing and holstering**: `weapon1` and `weapon2` draw a slot, `swap` the other, `holster` puts the weapon away\n *   and draws it again, and the trigger draws one holstered; each takes the weapon's `draw` seconds. Holstered, he\n *   runs on the movement model's holstered speeds (Apex's ×1.15: `motion.holstered`), and his body carries a gun or\n *   nothing (the animator's `weapon`). A melee swing holds the trigger until the hands are back (`MELEE.back`).\n * - **Aiming down the sights** (`aim` held, a weapon out, on foot or in the air): the sights come up over `sights`\n *   seconds (`weapons.aim`), the cone narrowing toward `spread.ads`, and he walks (engine/sim/actorInput.ts).\n * - **Firing** (`fire`: pressed, or held for an automatic one) at the weapon's rate, a round a shot, the magazine's\n *   last bringing the reload on; an empty one clicks (`dry`) and reloads. A shot is hitscan (the physics world's\n *   raycast, `range` long, his own body aside): from his eye toward the step's `aim` when it has a `look` (first\n *   person and the shooter: the crosshair's point), else along the look; without a look, level from his chest toward\n *   the aim (isometric's and top-down's pointer) or where he faces; turned in the aim's own frame (so a cone stays\n *   round at any pitch) by the burst's kick so far and a spread (`spreadOf`) drawn from his stream `weapon`. What it\n *   meets takes it: a person `damage` (engine/sim/damage.ts), a\n *   prop a strike (interact.ts `strikeEntity`, `shot`: a thing a point, a door broken, a pane a point, a dynamic prop\n *   knocked). `shots` and `hits` (a thing standing, a person alive) keep the range's count.\n * - **Reloading** (`reload`, the magazine not full; or at its last round): `reload.tactical` seconds, `reload.empty`\n *   from empty, no shot meanwhile; drawing another or holstering cancels it.\n * - **The kick**: each shot adds its recoil step (`recoilStep`) to `weapons.kick`, degrees up and right, so a burst\n *   climbs; `settle` seconds after the last shot the burst ends and the kick falls away (`recover`, a time constant).\n *   The view tilts the camera by it as it is, so the picture's centre is where the next shot goes.\n *\n * Events: `gunshot` `{ id, weapon, from, to, normal, body, target, hit }` (a miss: `normal` null, `body` and `target`\n * −1, `to` the shot's end), `draw`, `holster`, `reload` and `dry` `{ id, weapon }`.\n *\n * Invariants: everything is in the component (times are the sim's, `w.time`); the spread draws only from\n * `w.rng.entity(id, 'weapon')`; a weapon is asked of its entry. Problems raise `CORE_BAD_SPEC`.\n *\n * @example\n * // defineWeapon('weapon:pistol', { rate: 6, damage: 18, magazine: 12 });\n * // spawnActor(w, { at, character, components: { weapons: weaponsFor(['weapon:pistol']) } }); addWeapons(w);\n * // session.step({ b: ['weapon1'] }); … session.step({ look: [0, 0], b: ['fire'] }); // a `gunshot` event\n * @see engine/sim/weapons.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { codeError } from '../core/log';\nimport { defineSchema } from '../core/schema';\nimport { held, pressed, type Intents } from '../input/intents';\nimport { physicsOf } from '../physics/binding';\nimport type { GroupName } from '../physics/groups';\nimport { getWeapon, recoilStep, spreadOf, type WeaponKind } from '../world/weapons';\nimport type { ActorComponents } from './actors';\nimport { damage, type Health } from './damage';\nimport { EYE, strikeEntity } from './interact';\nimport { MELEE, type MeleeState } from './melee';\nimport { entityOfBody } from './props';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\nconst DEG = Math.PI / 180;\n\n/** The component `weapons`' fields (see the file comment). */\nexport const WEAPONS_FIELDS = defineSchema({\n  slots: { type: 'array', items: { type: 'string' }, default: [], description: 'The weapons carried, by id, in slot order.' }, // prettier-ignore\n  slot: { type: 'integer', default: -1, minimum: -1, description: 'The slot out (−1: holstered).' },\n  last: { type: 'integer', default: 0, minimum: 0, description: 'The slot drawn last: what `holster` draws again.' },\n  mags: { type: 'array', items: { type: 'number' }, default: [], description: 'Rounds in each slot’s magazine.' },\n  ready: { type: 'number', default: 0, unit: 's', description: 'When the weapon out is ready to fire: its draw done (a swing holds the trigger apart: MELEE.back).' }, // prettier-ignore\n  next: { type: 'number', default: 0, unit: 's', description: 'When its rate lets it fire again.' },\n  reload: { type: 'number', default: -1, unit: 's', description: 'When the reload under way ends (−1: none).' },\n  burst: { type: 'integer', default: 0, minimum: 0, description: 'Shots in the burst under way.' },\n  kick: { type: 'array', items: { type: 'number' }, default: [0, 0], unit: 'deg', description: 'The burst’s kick so far, [up, right].' }, // prettier-ignore\n  shot: { type: 'number', default: -1, unit: 's', description: 'When it last fired (−1: never).' },\n  shots: { type: 'integer', default: 0, minimum: 0, description: 'Shots fired, all told.' },\n  hits: { type: 'integer', default: 0, minimum: 0, description: 'Shots that struck a target: a thing standing, a person alive.' }, // prettier-ignore\n  aim: { type: 'number', default: 0, minimum: 0, maximum: 1, description: 'How far the sights are up, 0 to 1.' },\n});\n\n/** A player's weapons (`WEAPONS_FIELDS` says what each field means). */\nexport interface WeaponsState {\n  slots: string[];\n  slot: number;\n  last: number;\n  mags: number[];\n  ready: number;\n  next: number;\n  reload: number;\n  burst: number;\n  kick: [number, number];\n  shot: number;\n  shots: number;\n  hits: number;\n  aim: number;\n}\n\ndefineComponent('weapons', { description: 'The weapons a player carries and how they stand (WP 13.20).', fields: WEAPONS_FIELDS }); // prettier-ignore\n\n/** A player's weapons component carrying `slots` (weapon ids), each magazine full, holstered unless `drawn`. */\nexport function weaponsFor(slots: readonly string[], drawn = -1): WeaponsState {\n  if (!slots.length || drawn < -1 || drawn >= slots.length) throw codeError('CORE_BAD_SPEC', { where: 'weaponsFor(slots, drawn)', problems: `${JSON.stringify(slots)}, ${drawn}: give a weapon or more and a slot of them (−1: holstered)` }); // prettier-ignore\n  const mags = slots.map((id) => getWeapon(id).magazine);\n  return { slots: [...slots], slot: drawn, last: Math.max(0, drawn), mags, ready: 0, next: 0, reload: -1, burst: 0, kick: [0, 0], shot: -1, shots: 0, hits: 0, aim: 0 }; // prettier-ignore\n}\n\n/** Adds the system `weapons` to `w` (once): see the file comment. */\nexport function addWeapons<C extends object, E extends EventMap>(world: World<C, E>): void {\n  const w = world as unknown as World;\n  if (!w.systems.has('weapons')) w.systems.add('weapons', stepWeapons, { phase: 'intents' });\n}\n\n/** A player as this module reads him. */\ntype Player = ActorComponents & {\n  id: number;\n  weapons: WeaponsState;\n  melee?: MeleeState;\n  motion?: { mode?: string; stance?: string; holstered?: boolean };\n  animator?: { weapon: string };\n};\n\n/** The groups a shot meets: the level, props, people and crowds. */\nconst SHOT_GROUPS: readonly GroupName[] = ['world', 'prop', 'actor', 'crowd', 'flyer'];\n/**\n * How high a shot leaves the chest without a look (m over the feet; crouched): isometric's, top-down's, the\n * platformer's. The view meets the pointer's ray at this height (engine/app/view.ts), so the pointer over a body aims\n * at it.\n */\nexport const CHEST = { stand: 1.3, crouch: 0.75 } as const;\n/** The moves he may fire in: on foot and in the air (his hands are on a ledge, a wall, a rung or the cable otherwise). */\nconst FIRING = new Set(['ground', 'air']);\n\n/** Draws slot `slot` (see the file comment). */\nfunction draw(w: World, e: Player, slot: number): void {\n  const W = e.weapons;\n  const kind = getWeapon(W.slots[slot]);\n  [W.slot, W.last, W.ready, W.reload, W.burst, W.kick] = [slot, slot, w.time + kind.draw, -1, 0, [0, 0]];\n  w.emit('draw', { id: e.id, weapon: kind.id });\n}\n\n/** Puts the weapon out away (see the file comment). */\nfunction holster(w: World, e: Player): void {\n  const W = e.weapons;\n  const kind = getWeapon(W.slots[W.slot]);\n  [W.slot, W.ready, W.reload, W.burst, W.kick, W.aim] = [-1, w.time + kind.draw, -1, 0, [0, 0], 0];\n  w.emit('holster', { id: e.id, weapon: kind.id });\n}\n\n/** Where a shot of `e` leaves and the way it goes before its kick and spread (see the file comment). */\nfunction aimOf(e: Player, intents: Intents): { from: [number, number, number]; yaw: number; pitch: number } {\n  const { x, y, z, yaw } = e.actor;\n  const crouched = e.motion?.stance === 'crouch';\n  const [ax, ay, az] = intents.aim ?? [];\n  if (intents.look) {\n    const from: [number, number, number] = [x, y + (crouched ? EYE.crouch : EYE.stand), z];\n    const [dx, dy, dz] = ax === undefined ? [0, 0, 0] : [ax - from[0], ay! - from[1], az! - from[2]];\n    const flat = Math.hypot(dx, dz);\n    if (Math.hypot(flat, dy) > 0.5) return { from, yaw: Math.atan2(dx, dz), pitch: Math.atan2(dy, flat) };\n    return { from, yaw: intents.look[0], pitch: intents.look[1] };\n  }\n  const from: [number, number, number] = [x, y + (crouched ? CHEST.crouch : CHEST.stand), z];\n  const toward = ax !== undefined && Math.hypot(ax - x, az! - z) > 0.05;\n  return { from, yaw: toward ? Math.atan2(ax - x, az! - z) : yaw, pitch: 0 };\n}\n\n/**\n * The way `up` rad above and `right` rad to the right of the aim (`yaw`, `pitch`) goes, turned in the aim's own frame\n * (its forward, his right, and the up across them), so a cone of offsets stays round at any pitch.\n */\nfunction turned(yaw: number, pitch: number, up: number, right: number): [number, number, number] {\n  const [sy, cy, sp, cp] = [Math.sin(yaw), Math.cos(yaw), Math.sin(pitch), Math.cos(pitch)];\n  const [f, r, u] = [[sy * cp, sp, cy * cp], [-cy, 0, sy], [-sy * sp, cp, -cy * sp]]; // prettier-ignore\n  const t = Math.hypot(up, right);\n  const [c, k] = t < 1e-12 ? [1, 0] : [Math.cos(t), Math.sin(t) / t];\n  return [0, 1, 2].map((i) => f[i] * c + (u[i] * up + r[i] * right) * k) as [number, number, number];\n}\n\n/** Fires one shot of `kind` from `e` (see the file comment). */\nfunction shoot(w: World, e: Player, kind: WeaponKind, intents: Intents): void {\n  const W = e.weapons;\n  const { from, yaw, pitch } = aimOf(e, intents);\n  const spread = spreadOf(kind, W.aim, Math.hypot(e.actor.vx, e.actor.vz) > 0.5);\n  const rng = w.rng.entity(e.id, 'weapon');\n  const [turn, out] = [rng.next() * 2 * Math.PI, spread * Math.sqrt(rng.next())];\n  const dir = turned(yaw, pitch, (W.kick[0] + out * Math.sin(turn)) * DEG, (W.kick[1] + out * Math.cos(turn)) * DEG);\n  const step = recoilStep(kind, W.burst);\n  [W.kick, W.burst, W.shot, W.shots] = [[W.kick[0] + step[0], W.kick[1] + step[1]], W.burst + 1, w.time, W.shots + 1];\n  W.mags[W.slot] -= 1;\n  const hit = physicsOf(w).raycast(from, dir, { maxDistance: kind.range, groups: SHOT_GROUPS, exclude: e.actor.body });\n  const to: [number, number, number] = hit ? [hit.point.x, hit.point.y, hit.point.z] : [from[0] + dir[0] * kind.range, from[1] + dir[1] * kind.range, from[2] + dir[2] * kind.range]; // prettier-ignore\n  const target = hit ? entityOfBody(w, hit.body) : -1;\n  const struck = target >= 0 ? (w.get(target) as unknown as { thing?: { state: string }; health?: Health; sceneProp?: object }) : undefined; // prettier-ignore\n  const counted = !!struck && (struck.thing?.state === 'up' || (!!struck.health && struck.health.hp > 0));\n  if (struck?.sceneProp) strikeEntity(w, target, from, true, 'shot');\n  else if (struck?.health) damage(w, { id: target, health: struck.health }, { amount: kind.damage, from, direction: dir, at: to, source: e.id }); // prettier-ignore\n  if (counted) W.hits += 1;\n  const normal = hit ? [hit.normal.x, hit.normal.y, hit.normal.z] : null;\n  w.emit('gunshot', { id: e.id, weapon: kind.id, from, to, normal, body: hit?.body ?? -1, target, hit: counted });\n}\n\n/** Begins a reload of the weapon out (see the file comment). */\nfunction reload(w: World, e: Player, kind: WeaponKind): void {\n  const W = e.weapons;\n  W.reload = w.time + (W.mags[W.slot] > 0 ? kind.reload.tactical : kind.reload.empty);\n  w.emit('reload', { id: e.id, weapon: kind.id });\n}\n\n/** One step of `e`'s weapons (see the file comment). */\nfunction stepOne(w: World, e: Player, intents: Intents): void {\n  const W = e.weapons;\n  const other = W.slot >= 0 ? (W.slot + 1) % W.slots.length : W.last;\n  const want = pressed(intents, 'weapon1') ? 0 : pressed(intents, 'weapon2') ? 1 : pressed(intents, 'swap') ? other : -1; // prettier-ignore\n  if (want >= 0 && want < W.slots.length && want !== W.slot) draw(w, e, want);\n  else if (pressed(intents, 'holster')) {\n    if (W.slot >= 0) holster(w, e);\n    else draw(w, e, W.last);\n  } else if (W.slot < 0 && pressed(intents, 'fire')) draw(w, e, W.last);\n  if (W.slot < 0) return;\n  const kind = getWeapon(W.slots[W.slot]);\n  if (W.reload >= 0 && w.time >= W.reload - 1e-9) [W.mags[W.slot], W.reload] = [kind.magazine, -1];\n  const up = held(intents, 'aim') && FIRING.has(e.motion?.mode ?? 'ground');\n  W.aim = Math.max(0, Math.min(1, W.aim + (up ? 1 : -1) * (kind.sights > 0 ? w.dt / kind.sights : 1)));\n  if (W.shot >= 0 && w.time - W.shot > kind.settle + 1e-9) {\n    const fall = kind.recover > 0 ? Math.exp(-w.dt / kind.recover) : 0; // the burst over: its kick falls away\n    const kick: [number, number] = [W.kick[0] * fall, W.kick[1] * fall];\n    [W.burst, W.kick] = [0, Math.hypot(kick[0], kick[1]) < 1e-4 ? [0, 0] : kick];\n  }\n  if (pressed(intents, 'reload') && W.reload < 0 && W.mags[W.slot] < kind.magazine) reload(w, e, kind);\n  const trigger = kind.auto ? held(intents, 'fire') : pressed(intents, 'fire');\n  if (!trigger || W.reload >= 0 || w.time < W.ready - 1e-9 || !FIRING.has(e.motion?.mode ?? 'ground')) return;\n  if (e.melee && (e.melee.move !== '' || (e.melee.began >= 0 && (w.tick - e.melee.began) * w.dt < MELEE.back - 1e-9))) return; // prettier-ignore\n  if (W.mags[W.slot] <= 0) {\n    if (pressed(intents, 'fire')) w.emit('dry', { id: e.id, weapon: kind.id });\n    return reload(w, e, kind);\n  }\n  if (w.time < W.next - 1e-9) return;\n  W.next = (kind.auto && w.time - W.next < w.dt ? W.next : w.time) + 1 / kind.rate; // a held trigger keeps the rate\n  shoot(w, e, kind, intents);\n  if (W.mags[W.slot] === 0) reload(w, e, kind); // the last round brings the reload on\n}\n\n/** The system `weapons`: each player's weapons, in id order (see the file comment). */\nfunction stepWeapons(w: World, intents: Intents): void {\n  for (const e of w.query('actor', 'weapons') as unknown as Player[]) {\n    if (!e.actor.player) continue;\n    stepOne(w, e, intents);\n    if (e.motion) e.motion.holstered = e.weapons.slot < 0;\n    if (e.animator) e.animator.weapon = e.weapons.slot >= 0 ? 'gun' : 'none';\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"79e58adb-2ce5-4f9b-b78c-64a69cfd6c85","timestamp":"2026-11-05T04:24:46.979Z","tool_use_result":{"stdout":"/**\n * @file Firearms in a scene (PLAN.md WP 13.20; docs/PLAYGROUND.md §7.2): a player carries weapons (the kind `weapon`,\n * engine/world/weapons.ts) in the component `weapons` (`weaponsFor(slots)`, given at spawn: engine/sim/actors.ts's\n * `components`), and the system `weapons` (phase `intents`, after the uses and melee; `addWeapons(w)`, once) plays\n * them, players in id order:\n * - **Drawing and holstering**: `weapon1` and `weapon2` draw a slot, `swap` the other, `holster` puts the weapon away\n *   and draws it again, and the trigger draws one holstered; each takes the weapon's `draw` seconds. Holstered, he\n *   runs on the movement model's holstered speeds (Apex's ×1.15: `motion.holstered`), and his body carries a gun or\n *   nothing (the animator's `weapon`). A melee swing holds the trigger until the hands are back (`MELEE.back`).\n * - **Aiming down the sights** (`aim` held, a weapon out, on foot or in the air): the sights come up over `sights`\n *   seconds (`weapons.aim`), the cone narrowing toward `spread.ads`, and he walks (engine/sim/actorInput.ts).\n * - **Firing** (`fire`: pressed, or held for an automatic one) at the weapon's rate, a round a shot, the magazine's\n *   last bringing the reload on; an empty one clicks (`dry`) and reloads. A shot is hitscan (the physics world's\n *   raycast, `range` long, his own body aside): from his eye toward the step's `aim` when it has a `look` (first\n *   person and the shooter: the crosshair's point), else along the look; without a look, level from his chest toward\n *   the aim (isometric's and top-down's pointer) or where he faces; turned in the aim's own frame (so a cone stays\n *   round at any pitch) by the burst's kick so far and a spread (`spreadOf`) drawn from his stream `weapon`. What it\n *   meets takes it: a person `damage` (engine/sim/damage.ts), a\n *   prop a strike (interact.ts `strikeEntity`, `shot`: a thing a point, a door broken, a pane a point, a dynamic prop\n *   knocked). `shots` and `hits` (a thing standing, a person alive) keep the range's count.\n * - **Reloading** (`reload`, the magazine not full; or at its last round): `reload.tactical` seconds, `reload.empty`\n *   from empty, no shot meanwhile; drawing another or holstering cancels it.\n * - **The kick**: each shot adds its recoil step (`recoilStep`) to `weapons.kick`, degrees up and right, so a burst\n *   climbs; `settle` seconds after the last shot the burst ends and the kick falls away (`recover`, a time constant).\n *   The view tilts the camera by it as it is, so the picture's centre is where the next shot goes.\n *\n * Events: `gunshot` `{ id, weapon, from, to, normal, body, target, hit }` (a miss: `normal` null, `body` and `target`\n * −1, `to` the shot's end), `draw`, `holster`, `reload` and `dry` `{ id, weapon }`.\n *\n * Invariants: everything is in the component (times are the sim's, `w.time`); the spread draws only from\n * `w.rng.entity(id, 'weapon')`; a weapon is asked of its entry. Problems raise `CORE_BAD_SPEC`.\n *\n * @example\n * // defineWeapon('weapon:pistol', { rate: 6, damage: 18, magazine: 12 });\n * // spawnActor(w, { at, character, components: { weapons: weaponsFor(['weapon:pistol']) } }); addWeapons(w);\n * // session.step({ b: ['weapon1'] }); … session.step({ look: [0, 0], b: ['fire'] }); // a `gunshot` event\n * @see engine/sim/weapons.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { codeError } from '../core/log';\nimport { defineSchema } from '../core/schema';\nimport { held, pressed, type Intents } from '../input/intents';\nimport { physicsOf } from '../physics/binding';\nimport type { GroupName } from '../physics/groups';\nimport { getWeapon, recoilStep, spreadOf, type WeaponKind } from '../world/weapons';\nimport type { ActorComponents } from './actors';\nimport { damage, type Health } from './damage';\nimport { EYE, strikeEntity } from './interact';\nimport { MELEE, type MeleeState } from './melee';\nimport { entityOfBody } from './props';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\nconst DEG = Math.PI / 180;\n\n/** The component `weapons`' fields (see the file comment). */\nexport const WEAPONS_FIELDS = defineSchema({\n  slots: { type: 'array', items: { type: 'string' }, default: [], description: 'The weapons carried, by id, in slot order.' }, // prettier-ignore\n  slot: { type: 'integer', default: -1, minimum: -1, description: 'The slot out (−1: holstered).' },\n  last: { type: 'integer', default: 0, minimum: 0, description: 'The slot drawn last: what `holster` draws again.' },\n  mags: { type: 'array', items: { type: 'number' }, default: [], description: 'Rounds in each slot’s magazine.' },\n  ready: { type: 'number', default: 0, unit: 's', description: 'When the weapon out is ready to fire: its draw done (a swing holds the trigger apart: MELEE.back).' }, // prettier-ignore\n  next: { type: 'number', default: 0, unit: 's', description: 'When its rate lets it fire again.' },\n  reload: { type: 'number', default: -1, unit: 's', description: 'When the reload under way ends (−1: none).' },\n  burst: { type: 'integer', default: 0, minimum: 0, description: 'Shots in the burst under way.' },\n  kick: { type: 'array', items: { type: 'number' }, default: [0, 0], unit: 'deg', description: 'The burst’s kick so far, [up, right].' }, // prettier-ignore\n  shot: { type: 'number', default: -1, unit: 's', description: 'When it last fired (−1: never).' },\n  shots: { type: 'integer', default: 0, minimum: 0, description: 'Shots fired, all told.' },\n  hits: { type: 'integer', default: 0, minimum: 0, description: 'Shots that struck a target: a thing standing, a person alive.' }, // prettier-ignore\n  aim: { type: 'number', default: 0, minimum: 0, maximum: 1, description: 'How far the sights are up, 0 to 1.' },\n});\n\n/** A player's weapons (`WEAPONS_FIELDS` says what each field means). */\nexport interface WeaponsState {\n  slots: string[];\n  slot: number;\n  last: number;\n  mags: number[];\n  ready: number;\n  next: number;\n  reload: number;\n  burst: number;\n  kick: [number, number];\n  shot: number;\n  shots: number;\n  hits: number;\n  aim: number;\n}\n\ndefineComponent('weapons', { description: 'The weapons a player carries and how they stand (WP 13.20).', fields: WEAPONS_FIELDS }); // prettier-ignore\n\n/** A player's weapons component carrying `slots` (weapon ids), each magazine full, holstered unless `drawn`. */\nexport function weaponsFor(slots: readonly string[], drawn = -1): WeaponsState {\n  if (!slots.length || drawn < -1 || drawn >= slots.length) throw codeError('CORE_BAD_SPEC', { where: 'weaponsFor(slots, drawn)', problems: `${JSON.stringify(slots)}, ${drawn}: give a weapon or more and a slot of them (−1: holstered)` }); // prettier-ignore\n  const mags = slots.map((id) => getWeapon(id).magazine);\n  return { slots: [...slots], slot: drawn, last: Math.max(0, drawn), mags, ready: 0, next: 0, reload: -1, burst: 0, kick: [0, 0], shot: -1, shots: 0, hits: 0, aim: 0 }; // prettier-ignore\n}\n\n/** Adds the system `weapons` to `w` (once): see the file comment. */\nexport function addWeapons<C extends object, E extends EventMap>(world: World<C, E>): void {\n  const w = world as unknown as World;\n  if (!w.systems.has('weapons')) w.systems.add('weapons', stepWeapons, { phase: 'intents' });\n}\n\n/** A player as this module reads him. */\ntype Player = ActorComponents & {\n  id: number;\n  weapons: WeaponsState;\n  melee?: MeleeState;\n  motion?: { mode?: string; stance?: string; holstered?: boolean };\n  animator?: { weapon: string };\n};\n\n/** The groups a shot meets: the level, props, people and crowds. */\nconst SHOT_GROUPS: readonly GroupName[] = ['world', 'prop', 'actor', 'crowd', 'flyer'];\n/**\n * How high a shot leaves the chest without a look (m over the feet; crouched): isometric's, top-down's, the\n * platformer's. The view meets the pointer's ray at this height (engine/app/view.ts), so the pointer over a body aims\n * at it.\n */\nexport const CHEST = { stand: 1.3, crouch: 0.75 } as const;\n/** The moves he may fire in: on foot and in the air (his hands are on a ledge, a wall, a rung or the cable otherwise). */\nconst FIRING = new Set(['ground', 'air']);\n\n/** Draws slot `slot` (see the file comment). */\nfunction draw(w: World, e: Player, slot: number): void {\n  const W = e.weapons;\n  const kind = getWeapon(W.slots[slot]);\n  [W.slot, W.last, W.ready, W.reload, W.burst, W.kick] = [slot, slot, w.time + kind.draw, -1, 0, [0, 0]];\n  w.emit('draw', { id: e.id, weapon: kind.id });\n}\n\n/** Puts the weapon out away (see the file comment). */\nfunction holster(w: World, e: Player): void {\n  const W = e.weapons;\n  const kind = getWeapon(W.slots[W.slot]);\n  [W.slot, W.ready, W.reload, W.burst, W.kick, W.aim] = [-1, w.time + kind.draw, -1, 0, [0, 0], 0];\n  w.emit('holster', { id: e.id, weapon: kind.id });\n}\n\n/** Where a shot of `e` leaves and the way it goes before its kick and spread (see the file comment). */\nfunction aimOf(e: Player, intents: Intents): { from: [number, number, number]; yaw: number; pitch: number } {\n  const { x, y, z, yaw } = e.actor;\n  const crouched = e.motion?.stance === 'crouch';\n  const [ax, ay, az] = intents.aim ?? [];\n  if (intents.look) {\n    const from: [number, number, number] = [x, y + (crouched ? EYE.crouch : EYE.stand), z];\n    const [dx, dy, dz] = ax === undefined ? [0, 0, 0] : [ax - from[0], ay! - from[1], az! - from[2]];\n    const flat = Math.hypot(dx, dz);\n    if (Math.hypot(flat, dy) > 0.5) return { from, yaw: Math.atan2(dx, dz), pitch: Math.atan2(dy, flat) };\n    return { from, yaw: intents.look[0], pitch: intents.look[1] };\n  }\n  const from: [number, number, number] = [x, y + (crouched ? CHEST.crouch : CHEST.stand), z];\n  const toward = ax !== undefined && Math.hypot(ax - x, az! - z) > 0.05;\n  return { from, yaw: toward ? Math.atan2(ax - x, az! - z) : yaw, pitch: 0 };\n}\n\n/**\n * The way `up` rad above and `right` rad to the right of the aim (`yaw`, `pitch`) goes, turned in the aim's own frame\n * (its forward, his right, and the up across them), so a cone of offsets stays round at any pitch.\n */\nfunction turned(yaw: number, pitch: number, up: number, right: number): [number, number, number] {\n  const [sy, cy, sp, cp] = [Math.sin(yaw), Math.cos(yaw), Math.sin(pitch), Math.cos(pitch)];\n  const [f, r, u] = [[sy * cp, sp, cy * cp], [-cy, 0, sy], [-sy * sp, cp, -cy * sp]]; // prettier-ignore\n  const t = Math.hypot(up, right);\n  const [c, k] = t < 1e-12 ? [1, 0] : [Math.cos(t), Math.sin(t) / t];\n  return [0, 1, 2].map((i) => f[i] * c + (u[i] * up + r[i] * right) * k) as [number, number, number];\n}\n\n/** Fires one shot of `kind` from `e` (see the file comment). */\nfunction shoot(w: World, e: Player, kind: WeaponKind, intents: Intents): void {\n  const W = e.weapons;\n  const { from, yaw, pitch } = aimOf(e, intents);\n  const spread = spreadOf(kind, W.aim, Math.hypot(e.actor.vx, e.actor.vz) > 0.5);\n  const rng = w.rng.entity(e.id, 'weapon');\n  const [turn, out] = [rng.next() * 2 * Math.PI, spread * Math.sqrt(rng.next())];\n  const dir = turned(yaw, pitch, (W.kick[0] + out * Math.sin(turn)) * DEG, (W.kick[1] + out * Math.cos(turn)) * DEG);\n  const step = recoilStep(kind, W.burst);\n  [W.kick, W.burst, W.shot, W.shots] = [[W.kick[0] + step[0], W.kick[1] + step[1]], W.burst + 1, w.time, W.shots + 1];\n  W.mags[W.slot] -= 1;\n  const hit = physicsOf(w).raycast(from, dir, { maxDistance: kind.range, groups: SHOT_GROUPS, exclude: e.actor.body });\n  const to: [number, number, number] = hit ? [hit.point.x, hit.point.y, hit.point.z] : [from[0] + dir[0] * kind.range, from[1] + dir[1] * kind.range, from[2] + dir[2] * kind.range]; // prettier-ignore\n  const target = hit ? entityOfBody(w, hit.body) : -1;\n  const struck = target >= 0 ? (w.get(target) as unknown as { thing?: { state: string }; health?: Health; sceneProp?: object }) : undefined; // prettier-ignore\n  const counted = !!struck && (struck.thing?.state === 'up' || (!!struck.health && struck.health.hp > 0));\n  if (struck?.sceneProp) strikeEntity(w, target, from, true, 'shot');\n  else if (struck?.health) damage(w, { id: target, health: struck.health }, { amount: kind.damage, from, direction: dir, at: to, source: e.id }); // prettier-ignore\n  if (counted) W.hits += 1;\n  const normal = hit ? [hit.normal.x, hit.normal.y, hit.normal.z] : null;\n  w.emit('gunshot', { id: e.id, weapon: kind.id, from, to, normal, body: hit?.body ?? -1, target, hit: counted });\n}\n\n/** Begins a reload of the weapon out (see the file comment). */\nfunction reload(w: World, e: Player, kind: WeaponKind): void {\n  const W = e.weapons;\n  W.reload = w.time + (W.mags[W.slot] > 0 ? kind.reload.tactical : kind.reload.empty);\n  w.emit('reload', { id: e.id, weapon: kind.id });\n}\n\n/** One step of `e`'s weapons (see the file comment). */\nfunction stepOne(w: World, e: Player, intents: Intents): void {\n  const W = e.weapons;\n  const other = W.slot >= 0 ? (W.slot + 1) % W.slots.length : W.last;\n  const want = pressed(intents, 'weapon1') ? 0 : pressed(intents, 'weapon2') ? 1 : pressed(intents, 'swap') ? other : -1; // prettier-ignore\n  if (want >= 0 && want < W.slots.length && want !== W.slot) draw(w, e, want);\n  else if (pressed(intents, 'holster')) {\n    if (W.slot >= 0) holster(w, e);\n    else draw(w, e, W.last);\n  } else if (W.slot < 0 && pressed(intents, 'fire')) draw(w, e, W.last);\n  if (W.slot < 0) return;\n  const kind = getWeapon(W.slots[W.slot]);\n  if (W.reload >= 0 && w.time >= W.reload - 1e-9) [W.mags[W.slot], W.reload] = [kind.magazine, -1];\n  const up = held(intents, 'aim') && FIRING.has(e.motion?.mode ?? 'ground');\n  W.aim = Math.max(0, Math.min(1, W.aim + (up ? 1 : -1) * (kind.sights > 0 ? w.dt / kind.sights : 1)));\n  if (W.shot >= 0 && w.time - W.shot > kind.settle + 1e-9) {\n    const fall = kind.recover > 0 ? Math.exp(-w.dt / kind.recover) : 0; // the burst over: its kick falls away\n    const kick: [number, number] = [W.kick[0] * fall, W.kick[1] * fall];\n    [W.burst, W.kick] = [0, Math.hypot(kick[0], kick[1]) < 1e-4 ? [0, 0] : kick];\n  }\n  if (pressed(intents, 'reload') && W.reload < 0 && W.mags[W.slot] < kind.magazine) reload(w, e, kind);\n  const trigger = kind.auto ? held(intents, 'fire') : pressed(intents, 'fire');\n  if (!trigger || W.reload >= 0 || w.time < W.ready - 1e-9 || !FIRING.has(e.motion?.mode ?? 'ground')) return;\n  if (e.melee && (e.melee.move !== '' || (e.melee.began >= 0 && (w.tick - e.melee.began) * w.dt < MELEE.back - 1e-9))) return; // prettier-ignore\n  if (W.mags[W.slot] <= 0) {\n    if (pressed(intents, 'fire')) w.emit('dry', { id: e.id, weapon: kind.id });\n    return reload(w, e, kind);\n  }\n  if (w.time < W.next - 1e-9) return;\n  W.next = (kind.auto && w.time - W.next < w.dt ? W.next : w.time) + 1 / kind.rate; // a held trigger keeps the rate\n  shoot(w, e, kind, intents);\n  if (W.mags[W.slot] === 0) reload(w, e, kind); // the last round brings the reload on\n}\n\n/** The system `weapons`: each player's weapons, in id order (see the file comment). */\nfunction stepWeapons(w: World, intents: Intents): void {\n  for (const e of w.query('actor', 'weapons') as unknown as Player[]) {\n    if (!e.actor.player) continue;\n    stepOne(w, e, intents);\n    if (e.motion) e.motion.holstered = e.weapons.slot < 0;\n    if (e.animator) e.animator.weapon = e.weapons.slot >= 0 ? 'gun' : 'none';\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FTGZ7e4vPGvxgYuuw76ZJn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9Nox2Y6ZPatCmSqHrs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Tywrc8mMizFA39ThQNjoMd","name":"Bash","input":{"command":"sed -n 1,88p engine/world/weapons.ts; echo ------; cat engine/sim/actorInput.ts | sed -n 1,80p","description":"Read the weapon kind's fields and how actors read intents"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15308,"cache_read_input_tokens":156680,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15308},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"b54dbab3-b3a8-46d7-8cab-afd9a4d55594","timestamp":"2026-11-05T04:24:49.362Z","request_id":"req_011Cgj9NodvsGXkiTPGcE5KN","wire_tool_inputs":{"toolu_01Tywrc8mMizFA39ThQNjoMd":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work/.research/my-3dge && sed -n 1,88p engine/world/weapons.ts; echo ------; cat engine/sim/actorInput.ts | sed -n 1,80p","description":"Read the weapon kind's fields and how actors read intents"}},"wire_ingest_context":{"toolu_01Tywrc8mMizFA39ThQNjoMd":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work/.research/my-3dge"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tywrc8mMizFA39ThQNjoMd","type":"tool_result","content":"/**\n * @file Weapons as data (PLAN.md WP 13.20; docs/PLAYGROUND.md §7.2; doctrine: Common ground): the registry kind\n * `weapon`, a firearm's numbers in plain terms (`defineWeapon(id, spec)`): how fast it fires (`rate`) and whether it\n * fires on while the trigger is held (`auto`), the damage a shot takes from a person and how far it reaches, the cone\n * its shots stray in (`spread`: from the hip, more on the move, little down the sights), its recoil (`recoil`: a\n * kick a shot, [up, right] degrees, the burst's aim climbing by their sum, the last repeating; `settle` seconds after\n * the last shot the burst ends and its kick falls away, `recover` its time constant), its magazine and its two\n * reloads (a tactical one, and one from empty), its sights' lens\n * (`zoom`, at Apex's 70° field) and how fast they come up, how long it takes to draw and put away, where its shots\n * leave it (`muzzle`, in its frame), the prop it is drawn as (`prop`: its parts in its frame, +Z along the barrel\n * from the grip, +Y up, so `node x gallery prop` shows it) and the sound of its shot (`sound`, an `sfx` entry a game's\n * sound map plays for its `gunshot`, WP 13.22). engine/sim/weapons.ts fires them, engine/gfx/weapons.ts draws them,\n * and `recoilStep` and `spreadOf` are the numbers both read.\n *\n * Invariants: data and pure functions only; angles in degrees as the fields say, seconds and metres. Problems raise\n * `CORE_BAD_SPEC`; a missing id gets `weapon:gun` after a warning.\n *\n * Carried as a concept from Apex Legends' weapons (a fire rate, a hip and a sights cone, a recoil pattern, a\n * magazine and two reloads, the sights' zoom, holstering's speed).\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * const pistol = defineWeapon('weapon:pistol', { rate: 6, damage: 18, magazine: 12, recoil: [[1.5, 0.1]] }, createRegistry());\n * recoilStep(pistol, 4); // [1.5, 0.1]: the fifth shot's kick, the last step repeating\n * spreadOf(pistol, 1, false); // 0.15: down the sights, still\n * @see engine/world/weapons.test.ts\n */\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { defineSchema } from '../core/schema';\n\n/** A number field of a weapon (see `WEAPON_FIELDS`). */\nconst num = (value: number, minimum: number, unit: string, description: string) => ({ type: 'number', default: value, minimum, unit, description }) as const; // prettier-ignore\n\n/** A `weapon` kind's fields (see the file comment). */\nexport const WEAPON_FIELDS = defineSchema({\n  rate: num(5, 0.1, 'shots/s', 'How fast it fires.'),\n  auto: { type: 'boolean', default: false, description: 'Whether it fires on while the trigger is held.' },\n  damage: num(20, 0, 'hp', 'Hit points a shot takes from a person.'),\n  range: num(100, 1, 'm', 'How far its shots reach.'),\n  spread: { type: 'object', description: 'The cone its shots stray in, half-angles (deg).', default: { hip: 2, move: 1.5, ads: 0.15 }, properties: { hip: num(2, 0, 'deg', 'From the hip.'), move: num(1.5, 0, 'deg', 'Added on the move.'), ads: num(0.15, 0, 'deg', 'Down the sights.') } }, // prettier-ignore\n  recoil: { type: 'array', items: { type: 'array', items: { type: 'number' } }, default: [[0.5, 0]], unit: 'deg', description: \"Each shot's kick in a burst, [up, right]; the last repeats.\" }, // prettier-ignore\n  settle: num(0.3, 0, 's', 'How long after its last shot a burst ends and its kick begins to fall away.'),\n  recover: num(0.15, 0, 's', 'The time constant its kick falls away in once its burst ends (0: at once).'),\n  magazine: { type: 'integer', default: 12, minimum: 1, description: 'Rounds a magazine holds.' },\n  reload: { type: 'object', description: 'How long a reload takes (s).', default: { tactical: 1.25, empty: 1.5 }, properties: { tactical: num(1.25, 0, 's', 'With rounds left.'), empty: num(1.5, 0, 's', 'From empty.') } }, // prettier-ignore\n  zoom: num(60, 1, 'deg', \"The sights' lens at a 70° field of view (Apex's): how far aiming down them zooms.\"),\n  sights: num(0.2, 0, 's', 'How long the sights take to come up.'),\n  draw: num(0.3, 0, 's', 'How long it takes to draw, and to put away.'),\n  muzzle: { type: 'array', items: { type: 'number' }, default: [0, 0.06, 0.3], unit: 'm', description: 'Where shots leave it, in its frame: +Z along the barrel from the grip, +Y up.' }, // prettier-ignore\n  prop: { type: 'string', default: '', description: 'The prop it is drawn as, in its frame (\"\": none).' },\n  sound: { type: 'string', default: 'sfx:pistolShot', description: 'The sound of its shot, an sfx entry (the sim never plays it).' }, // prettier-ignore\n});\n\n/** A `weapon` entry (see the file comment). */\nexport type WeaponKind = Omit<Entry<typeof WEAPON_FIELDS>, 'recoil' | 'muzzle'> & {\n  readonly recoil: readonly (readonly [number, number])[];\n  readonly muzzle: readonly [number, number, number];\n};\n\n/** What `defineWeapon` takes: any of the kind's fields (`spread` and `reload` field by field), the rest at their defaults. */ // prettier-ignore\nexport type WeaponSpec = Partial<Omit<WeaponKind, 'id' | 'kind' | 'spread' | 'reload'>> & {\n  spread?: Partial<WeaponKind['spread']>;\n  reload?: Partial<WeaponKind['reload']>;\n};\n\n/** The problems of a weapon beyond its fields: a recoil of [up, right] pairs, a muzzle of three numbers. */\nfunction weaponProblems(kind: WeaponKind): string[] {\n  const problems: string[] = [];\n  if (!kind.recoil.length || !kind.recoil.every((k) => k.length === 2 && k.every(Number.isFinite))) problems.push(`recoil ${JSON.stringify(kind.recoil)} is not a list of [up, right] degrees`); // prettier-ignore\n  if (kind.muzzle.length !== 3 || !kind.muzzle.every(Number.isFinite)) problems.push(`muzzle ${JSON.stringify(kind.muzzle)} is not [x, y, z] in metres`); // prettier-ignore\n  return problems;\n}\n\n/** Declares the kind `weapon` on `registry`, with its default `weapon:gun`, unless it has it. */\nexport function weaponKind(registry: Registry): void {\n  if (registry.kinds().includes('weapon')) return;\n  registry.defineKind('weapon', {\n    description: 'Firearms: fire rate, damage, range, spread, recoil, magazine, reloads, sights, draw time, muzzle and look.', // prettier-ignore\n    fields: WEAPON_FIELDS,\n    fallback: 'weapon:gun',\n    defineWith: \"defineWeapon('<id>', { rate: 6, damage: 18, magazine: 12 })\",\n    check: (entry) => weaponProblems(entry as unknown as WeaponKind),\n  });\n  registry.def('weapon', 'weapon:gun', {});\n}\nweaponKind(sharedRegistry);\n\n/** Defines a weapon on `registry` (the shared one by default) and returns it. Throws `CORE_BAD_SPEC` naming each problem. */ // prettier-ignore\n------\n/**\n * @file What an actor reads of a step's intents (PLAN.md WP 3.2, WP 13.3, WP 13.9; split from engine/sim/actors.ts at\n * its cap, WP 13.16): `intentsOf(actor, intents)` is the step's intents for a player, else its AI's (`actor.intents`,\n * its presses from the edges of the buttons it held, `actor.held`); `motionInput(actor, wants, controls)` is what an\n * actor on a movement model (engine/physics/movement/) takes of them: the sprint, walk and crouch buttons as a player's\n * controls (`input.sprint`, `input.crouch`) say, the use press (unless a use took it, `used`: engine/sim/interact.ts),\n * the view, the keys' frame and what it faces (the aim's point, else the view), whether a melee swings (no mantle\n * then: engine/sim/melee.ts) and whether he aims down a weapon's sights (a walk then: engine/sim/weapons.ts).\n *\n * Invariants: pure but for an AI actor's own button edges, which `intentsOf` keeps in its component.\n *\n * @example\n * // const wants = intentsOf(actor, intents); // a player's: the step's own\n * // const input = motionInput(actor, wants, { holdSprint: false, toggleCrouch: false });\n * @see engine/sim/actors.test.ts\n */\nimport { held, normalizeIntents, pressed, type Intents } from '../input/intents';\nimport type { CharacterInput } from '../physics/character';\nimport type { ActorComponent } from './actors';\n\n/** The intents an actor acts on this step: the step's for a player, else its AI's (with presses from `b`'s edges). */\nexport function intentsOf(actor: ActorComponent, intents: Intents): Intents {\n  if (actor.player) return intents;\n  const own = normalizeIntents(actor.intents, normalizeIntents({ b: actor.held }));\n  const { p: _pressed, ...rest } = actor.intents;\n  [actor.held, actor.intents] = [[...(own.b ?? [])], rest];\n  return own;\n}\n\n/** A player's controls (the settings `input.sprint` and `input.crouch`): a held sprint, a toggled crouch. */\nexport interface Controls {\n  readonly holdSprint: boolean;\n  readonly toggleCrouch: boolean;\n}\n\n/**\n * The shooter model's input from `wants`: the sprint, walk and crouch buttons, the view, the keys' frame and what it\n * faces; `used`, a use took the step's press (no ride); `swinging`, a melee swings (no mantle: engine/sim/melee.ts);\n * `aiming`, he aims down a weapon's sights, so walks (Apex walks only then: engine/sim/weapons.ts).\n */\nexport function motionInput(\n  actor: ActorComponent,\n  wants: Intents,\n  controls: Controls,\n  used = false,\n  swinging = false,\n  aiming = false,\n): CharacterInput {\n  const [aimX, , aimZ] = wants.aim ?? [];\n  const aimed = aimX !== undefined && Math.hypot(aimX - actor.x, aimZ! - actor.z) > 0.05;\n  const face = aimed ? Math.atan2(aimX - actor.x, aimZ! - actor.z) : wants.look?.[0];\n  const frame = wants.cam ?? wants.look?.[0];\n  const toggle = actor.player && controls.toggleCrouch;\n  return {\n    sprint: held(wants, 'sprint'),\n    sprintPressed: pressed(wants, 'sprint'),\n    ...(actor.player && controls.holdSprint ? { sprintHold: true } : {}),\n    walk: held(wants, 'walk') || aiming,\n    crouch: !toggle && held(wants, 'crouch'),\n    crouchToggle: pressed(wants, 'crouchToggle') || (toggle && pressed(wants, 'crouch')),\n    usePressed: pressed(wants, 'interact') && !used, // a use took the press (engine/sim/interact.ts): no ride\n    ...(wants.look ? { view: wants.look[0], pitch: wants.look[1] } : {}),\n    ...(frame !== undefined ? { frame } : {}),\n    ...(face !== undefined ? { face } : {}),\n    ...(swinging ? { swinging } : {}),\n  };\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"3584077d-ff66-4d53-b122-95450c96eee2","timestamp":"2026-11-05T04:24:49.377Z","tool_use_result":{"stdout":"/**\n * @file Weapons as data (PLAN.md WP 13.20; docs/PLAYGROUND.md §7.2; doctrine: Common ground): the registry kind\n * `weapon`, a firearm's numbers in plain terms (`defineWeapon(id, spec)`): how fast it fires (`rate`) and whether it\n * fires on while the trigger is held (`auto`), the damage a shot takes from a person and how far it reaches, the cone\n * its shots stray in (`spread`: from the hip, more on the move, little down the sights), its recoil (`recoil`: a\n * kick a shot, [up, right] degrees, the burst's aim climbing by their sum, the last repeating; `settle` seconds after\n * the last shot the burst ends and its kick falls away, `recover` its time constant), its magazine and its two\n * reloads (a tactical one, and one from empty), its sights' lens\n * (`zoom`, at Apex's 70° field) and how fast they come up, how long it takes to draw and put away, where its shots\n * leave it (`muzzle`, in its frame), the prop it is drawn as (`prop`: its parts in its frame, +Z along the barrel\n * from the grip, +Y up, so `node x gallery prop` shows it) and the sound of its shot (`sound`, an `sfx` entry a game's\n * sound map plays for its `gunshot`, WP 13.22). engine/sim/weapons.ts fires them, engine/gfx/weapons.ts draws them,\n * and `recoilStep` and `spreadOf` are the numbers both read.\n *\n * Invariants: data and pure functions only; angles in degrees as the fields say, seconds and metres. Problems raise\n * `CORE_BAD_SPEC`; a missing id gets `weapon:gun` after a warning.\n *\n * Carried as a concept from Apex Legends' weapons (a fire rate, a hip and a sights cone, a recoil pattern, a\n * magazine and two reloads, the sights' zoom, holstering's speed).\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * const pistol = defineWeapon('weapon:pistol', { rate: 6, damage: 18, magazine: 12, recoil: [[1.5, 0.1]] }, createRegistry());\n * recoilStep(pistol, 4); // [1.5, 0.1]: the fifth shot's kick, the last step repeating\n * spreadOf(pistol, 1, false); // 0.15: down the sights, still\n * @see engine/world/weapons.test.ts\n */\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport { defineSchema } from '../core/schema';\n\n/** A number field of a weapon (see `WEAPON_FIELDS`). */\nconst num = (value: number, minimum: number, unit: string, description: string) => ({ type: 'number', default: value, minimum, unit, description }) as const; // prettier-ignore\n\n/** A `weapon` kind's fields (see the file comment). */\nexport const WEAPON_FIELDS = defineSchema({\n  rate: num(5, 0.1, 'shots/s', 'How fast it fires.'),\n  auto: { type: 'boolean', default: false, description: 'Whether it fires on while the trigger is held.' },\n  damage: num(20, 0, 'hp', 'Hit points a shot takes from a person.'),\n  range: num(100, 1, 'm', 'How far its shots reach.'),\n  spread: { type: 'object', description: 'The cone its shots stray in, half-angles (deg).', default: { hip: 2, move: 1.5, ads: 0.15 }, properties: { hip: num(2, 0, 'deg', 'From the hip.'), move: num(1.5, 0, 'deg', 'Added on the move.'), ads: num(0.15, 0, 'deg', 'Down the sights.') } }, // prettier-ignore\n  recoil: { type: 'array', items: { type: 'array', items: { type: 'number' } }, default: [[0.5, 0]], unit: 'deg', description: \"Each shot's kick in a burst, [up, right]; the last repeats.\" }, // prettier-ignore\n  settle: num(0.3, 0, 's', 'How long after its last shot a burst ends and its kick begins to fall away.'),\n  recover: num(0.15, 0, 's', 'The time constant its kick falls away in once its burst ends (0: at once).'),\n  magazine: { type: 'integer', default: 12, minimum: 1, description: 'Rounds a magazine holds.' },\n  reload: { type: 'object', description: 'How long a reload takes (s).', default: { tactical: 1.25, empty: 1.5 }, properties: { tactical: num(1.25, 0, 's', 'With rounds left.'), empty: num(1.5, 0, 's', 'From empty.') } }, // prettier-ignore\n  zoom: num(60, 1, 'deg', \"The sights' lens at a 70° field of view (Apex's): how far aiming down them zooms.\"),\n  sights: num(0.2, 0, 's', 'How long the sights take to come up.'),\n  draw: num(0.3, 0, 's', 'How long it takes to draw, and to put away.'),\n  muzzle: { type: 'array', items: { type: 'number' }, default: [0, 0.06, 0.3], unit: 'm', description: 'Where shots leave it, in its frame: +Z along the barrel from the grip, +Y up.' }, // prettier-ignore\n  prop: { type: 'string', default: '', description: 'The prop it is drawn as, in its frame (\"\": none).' },\n  sound: { type: 'string', default: 'sfx:pistolShot', description: 'The sound of its shot, an sfx entry (the sim never plays it).' }, // prettier-ignore\n});\n\n/** A `weapon` entry (see the file comment). */\nexport type WeaponKind = Omit<Entry<typeof WEAPON_FIELDS>, 'recoil' | 'muzzle'> & {\n  readonly recoil: readonly (readonly [number, number])[];\n  readonly muzzle: readonly [number, number, number];\n};\n\n/** What `defineWeapon` takes: any of the kind's fields (`spread` and `reload` field by field), the rest at their defaults. */ // prettier-ignore\nexport type WeaponSpec = Partial<Omit<WeaponKind, 'id' | 'kind' | 'spread' | 'reload'>> & {\n  spread?: Partial<WeaponKind['spread']>;\n  reload?: Partial<WeaponKind['reload']>;\n};\n\n/** The problems of a weapon beyond its fields: a recoil of [up, right] pairs, a muzzle of three numbers. */\nfunction weaponProblems(kind: WeaponKind): string[] {\n  const problems: string[] = [];\n  if (!kind.recoil.length || !kind.recoil.every((k) => k.length === 2 && k.every(Number.isFinite))) problems.push(`recoil ${JSON.stringify(kind.recoil)} is not a list of [up, right] degrees`); // prettier-ignore\n  if (kind.muzzle.length !== 3 || !kind.muzzle.every(Number.isFinite)) problems.push(`muzzle ${JSON.stringify(kind.muzzle)} is not [x, y, z] in metres`); // prettier-ignore\n  return problems;\n}\n\n/** Declares the kind `weapon` on `registry`, with its default `weapon:gun`, unless it has it. */\nexport function weaponKind(registry: Registry): void {\n  if (registry.kinds().includes('weapon')) return;\n  registry.defineKind('weapon', {\n    description: 'Firearms: fire rate, damage, range, spread, recoil, magazine, reloads, sights, draw time, muzzle and look.', // prettier-ignore\n    fields: WEAPON_FIELDS,\n    fallback: 'weapon:gun',\n    defineWith: \"defineWeapon('<id>', { rate: 6, damage: 18, magazine: 12 })\",\n    check: (entry) => weaponProblems(entry as unknown as WeaponKind),\n  });\n  registry.def('weapon', 'weapon:gun', {});\n}\nweaponKind(sharedRegistry);\n\n/** Defines a weapon on `registry` (the shared one by default) and returns it. Throws `CORE_BAD_SPEC` naming each problem. */ // prettier-ignore\n------\n/**\n * @file What an actor reads of a step's intents (PLAN.md WP 3.2, WP 13.3, WP 13.9; split from engine/sim/actors.ts at\n * its cap, WP 13.16): `intentsOf(actor, intents)` is the step's intents for a player, else its AI's (`actor.intents`,\n * its presses from the edges of the buttons it held, `actor.held`); `motionInput(actor, wants, controls)` is what an\n * actor on a movement model (engine/physics/movement/) takes of them: the sprint, walk and crouch buttons as a player's\n * controls (`input.sprint`, `input.crouch`) say, the use press (unless a use took it, `used`: engine/sim/interact.ts),\n * the view, the keys' frame and what it faces (the aim's point, else the view), whether a melee swings (no mantle\n * then: engine/sim/melee.ts) and whether he aims down a weapon's sights (a walk then: engine/sim/weapons.ts).\n *\n * Invariants: pure but for an AI actor's own button edges, which `intentsOf` keeps in its component.\n *\n * @example\n * // const wants = intentsOf(actor, intents); // a player's: the step's own\n * // const input = motionInput(actor, wants, { holdSprint: false, toggleCrouch: false });\n * @see engine/sim/actors.test.ts\n */\nimport { held, normalizeIntents, pressed, type Intents } from '../input/intents';\nimport type { CharacterInput } from '../physics/character';\nimport type { ActorComponent } from './actors';\n\n/** The intents an actor acts on this step: the step's for a player, else its AI's (with presses from `b`'s edges). */\nexport function intentsOf(actor: ActorComponent, intents: Intents): Intents {\n  if (actor.player) return intents;\n  const own = normalizeIntents(actor.intents, normalizeIntents({ b: actor.held }));\n  const { p: _pressed, ...rest } = actor.intents;\n  [actor.held, actor.intents] = [[...(own.b ?? [])], rest];\n  return own;\n}\n\n/** A player's controls (the settings `input.sprint` and `input.crouch`): a held sprint, a toggled crouch. */\nexport interface Controls {\n  readonly holdSprint: boolean;\n  readonly toggleCrouch: boolean;\n}\n\n/**\n * The shooter model's input from `wants`: the sprint, walk and crouch buttons, the view, the keys' frame and what it\n * faces; `used`, a use took the step's press (no ride); `swinging`, a melee swings (no mantle: engine/sim/melee.ts);\n * `aiming`, he aims down a weapon's sights, so walks (Apex walks only then: engine/sim/weapons.ts).\n */\nexport function motionInput(\n  actor: ActorComponent,\n  wants: Intents,\n  controls: Controls,\n  used = false,\n  swinging = false,\n  aiming = false,\n): CharacterInput {\n  const [aimX, , aimZ] = wants.aim ?? [];\n  const aimed = aimX !== undefined && Math.hypot(aimX - actor.x, aimZ! - actor.z) > 0.05;\n  const face = aimed ? Math.atan2(aimX - actor.x, aimZ! - actor.z) : wants.look?.[0];\n  const frame = wants.cam ?? wants.look?.[0];\n  const toggle = actor.player && controls.toggleCrouch;\n  return {\n    sprint: held(wants, 'sprint'),\n    sprintPressed: pressed(wants, 'sprint'),\n    ...(actor.player && controls.holdSprint ? { sprintHold: true } : {}),\n    walk: held(wants, 'walk') || aiming,\n    crouch: !toggle && held(wants, 'crouch'),\n    crouchToggle: pressed(wants, 'crouchToggle') || (toggle && pressed(wants, 'crouch')),\n    usePressed: pressed(wants, 'interact') && !used, // a use took the press (engine/sim/interact.ts): no ride\n    ...(wants.look ? { view: wants.look[0], pitch: wants.look[1] } : {}),\n    ...(frame !== undefined ? { frame } : {}),\n    ...(face !== undefined ? { face } : {}),\n    ...(swinging ? { swinging } : {}),\n  };\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Tywrc8mMizFA39ThQNjoMd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
