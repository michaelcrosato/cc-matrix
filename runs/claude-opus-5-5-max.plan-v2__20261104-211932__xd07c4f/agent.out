   for u in re.split(r'(?<=[.?!])\\s+(?=[A-Z\"\\[(])',l):\n        if len(toks(u))>=2: units.append((n,u.strip()))\nscores=[]\nfor n,u in units:\n    s,i=best(u); pn,pc=chunks[i]; scores.append(s)\n    print(f'T{n:<3} {s:.2f} {u[:66]:<66} => P{pn:<4} {pc[:92]}')\nprint('---'); print(len(units),'TASK.md sentences; closest-passage score: median %.2f, under 0.25: %d'%(sorted(scores)[len(scores)//2],sum(1 for s in scores if s<0.25)))\nEOF\npython3 -I .research/retrieve.py 2>&1 | cut -c1-185","description":"Auto-retrieve the closest plan passage for every TASK.md sentence","timeout":120000}},"wire_ingest_context":{"toolu_01FJwA5qXz1woL7drVwEfvBA":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work"}}}
