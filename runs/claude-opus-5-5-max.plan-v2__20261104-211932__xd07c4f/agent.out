{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015vrKYZkreXhkW2KyYhJP9x","type":"tool_result","content":"/**\n * @file Props in a running scene (PLAN.md WP 4.6 core proposal, ADR-0008 amendment 5; WP 4.5's props as data):\n * `spawnProp(w, placement)` stands a prop (engine/world/props: its id, its base and its turn about +Y) in a scene: its\n * body in the scene's physics world (`propBody`: none for a prop without one, such as the brazier's fire) and an\n * entity with the component `sceneProp` (the prop's id, its body and its pose: its centre and its turn), so the sim\n * hashes, captures and restores it and the view draws it as the prop (engine/gfx/stageProps.ts, through the instanced\n * prop meshes). The system `props.readback` (phase `readback`, after the physics step) copies each body's pose into\n * its component, as `actors.readback` does an actor's feet.\n *\n * Its `options` (WP 13.16, `SpawnPropOptions`): its body's type, its light (the component `propLight`, which the view\n * reads) and components from the start; a prop with `health` holds its hit points (`propHealth`), and nothing else\n * gains a component, so earlier hashes hold. `propOfBody(w, body)` is the body-to-entity lookup uses and hits read.\n *\n * `hitProp(w, id, from, knock?)` hits a prop from `from` (a swing, a blast): it calls the prop's `hit` hook with the\n * means to knock it, engine/physics/bodies.ts's `knock` on its body with the caller's strength (`speed`, `up`,\n * `spin`) under the hook's own; the default hook knocks a dynamic prop away and leaves the others. Shared code calls\n * the hook and never compares ids. `removeProp(w, id)` removes the entity and its body.\n *\n * The component's name is `sceneProp`, as names are global and fixtures/scenes/physics-props declares its own `prop`.\n * Its `x` and `z` are metres, so the stage places it, and draws it as its prop instead of a stand-in.\n *\n * Invariants: everything a prop is in the sim is its component and its body; the readback writes only what the body\n * holds (its centre and turn), so a prop's component equals its body's pose after every step; the system is added\n * once per world, on the first spawn of a prop with a body. Ids are asked of the entries, never compared.\n *\n * @example\n * import { defineScene } from './scene';\n * import { physicsOf } from '../physics/binding';\n * import { addLevelBodies } from './levelBodies';\n * defineScene('yard', {\n *   physics: true,\n *   setup(w) {\n *     // addLevelBodies(physicsOf(w), level); for (const placement of levelProps(level)) spawnProp(w, placement);\n *     spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: 0.4 });\n *   },\n * });\n * // after a step: w.get(id).sceneProp is { prop: 'prop:crate', body, x: 2, y: 0.375, z: 3, q: [0, 0.198…, 0, 0.980…] }\n * // hitProp(w, id, [1, 0, 3], { spin: w.rng('knock').range(-0.5, 0.5) }); // knocked east\n * @see engine/sim/props.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { knock } from '../physics/bodies';\nimport { physicsOf } from '../physics/binding';\nimport { propBody, propPose, type PropPlacement } from '../world/props/place';\nimport { getProp, type PropKnock } from '../world/props/prop';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The component `sceneProp`'s fields. */\nexport const SCENE_PROP_FIELDS = {\n  prop: { type: 'string', default: 'prop:crate', description: 'The prop it is, by id (engine/world/props).' },\n  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\n  x: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, east: its body’s origin.' },\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, up.' },\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, south.' },\n  q: {\n    type: 'array',\n    items: { type: 'number' },\n    default: [0, 0, 0, 1],\n    description: 'Its turn, a unit quaternion [x, y, z, w].',\n  },\n} as const;\n\n/** The component `sceneProp`: a prop standing in a scene. */\nexport interface ScenePropComponent {\n  prop: string;\n  body: number;\n  x: number;\n  y: number;\n  z: number;\n  q: [number, number, number, number];\n}\n\n...\n52:export const SCENE_PROP_FIELDS = {\n53-  prop: { type: 'string', default: 'prop:crate', description: 'The prop it is, by id (engine/world/props).' },\n54-  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\n55-  x: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, east: its body’s origin.' },\n56-  y: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, up.' },\n57-  z: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, south.' },\n58-  q: {\n59-    type: 'array',\n60-    items: { type: 'number' },\n61-    default: [0, 0, 0, 1],\n62-    description: 'Its turn, a unit quaternion [x, y, z, w].',\n63-  },\n64-} as const;\n65-\n66-/** The component `sceneProp`: a prop standing in a scene. */\n67-export interface ScenePropComponent {\n68-  prop: string;\n69-  body: number;\n70-  x: number;\n71-  y: number;\n72-  z: number;\n73-  q: [number, number, number, number];\n74-}\n--\n113:  defineComponent('sceneProp', { description, fields: SCENE_PROP_FIELDS }, registry);\n114-  const hp = { type: 'number', default: 0, minimum: 0, description: 'Hit points left; at 0 it breaks.' } as const;\n115-  defineComponent('propHealth', { description: \"A breakable prop's hit points (WP 13.16).\", fields: { hp } }, registry);\n116-  const fields = {\n117-    on: { type: 'boolean', default: true, description: 'Whether it is on: its lit parts and its light.' },\n118-    group: { type: 'string', default: '', description: \"Its light group ('room:kitchen').\" },\n119-  } as const;\n120-  defineComponent('propLight', { description: \"A switchable prop's state (WP 13.16).\", fields }, registry);\n121-}\n122-definePropKinds();\n123-\n124-/** Throws `SIM_BAD_ARGUMENT` for `id` when it is no prop. */\n125-function propOf(w: World, id: number, where: string): ScenePropComponent {\n126-  const data = (w.get(id) as Partial<ScenePropComponents> | undefined)?.sceneProp;\n127-  if (!data) throw codeError('SIM_BAD_ARGUMENT', { where, value: String(id), expected: 'a prop’s id (spawnProp)' });\n128-  return data;\n129-}\n130-\n131-/** The system `props.readback`: every prop with a body takes its body's pose, in id order. */\n132-function readProps(w: World): void {\n133-  const physics = physicsOf(w);\n134-  for (const { sceneProp } of w.query('sceneProp') as unknown as ScenePropComponents[]) {\n135-    if (sceneProp.body < 0) continue;\n\n/**\n * @file The prop registry (PLAN.md WP 4.5, §6.6): the registry kind `prop`, one entry per kind of thing that stands\n * in a level, as data: the meshes it is drawn with (geometry and material by id, §6.1: `world` names them, `gfx`\n * builds them, engine/gfx/props.ts), its body (a shape and a material for the physics world), an optional light\n * spot, where a level places it, and its interaction hooks. The engine's props are the crate, the barrel, the\n * brazier's fire and the pillar (engine/world/props/catalog.ts), the library's sconce, banner, chest, door, table,\n * bench, statue, lantern and chair (library.ts, WP 10.3, the chair WP 13.16's) and the house's fittings, the pane,\n * the switch, the lamp and the garage door (fittings.ts, WP 13.16); a game adds its own with `defineProp`\n * (`x new prop`). WP 13.16's fields: a `kinematic` body the sim drives, `health` and what breaking leaves (`breaks`),\n * a `prompt` for its own `use`, and parts `lit` only while the prop is on; a hook's touch also names the world, the\n * entity and its user.\n *\n * A prop's frame: its base, where it stands, is the origin, +Y up, and its parts stand on it as the geometry kit's\n * shapes stand on the ground. Its body's shape stands on the base too, so the body's origin, the prop's centre, is\n * `propCentre(prop)` above it: what a body's pose (`readBody`) and `propPose` give, and what the meshes are drawn\n * at. A part with `flame.tongues` above 0 is drawn as that many flame tongues dancing round its origin (its geometry\n * a cone one metre high, stretched each frame), the 2D hall's flames. The hooks: `hit` (a swing, a blast) knocks a\n * dynamic prop away and leaves the others; `use` does nothing; shared code calls them and never compares ids.\n *\n * Carried: the idea of my-3d2dge's 2D prop catalog (`src/starter/*`, `src/emberdeep/51-themes.js`): kinds of props\n * as data with their light metadata (a colour, a reach and a flicker beside the drawing).\n *\n * Invariants: an entry is plain data plus its two hooks, every field filled with its default; a part's name is\n * unique in its prop; colours are hex; vectors have three numbers; a body's shape has a size above 0; spawn names\n * and light tags are words. Geometry and material ids are gfx's to resolve (a missing one draws its kind's fallback,\n * and `node x qa geo tex --only prop:` reports it). Problems raise `CORE_BAD_SPEC` naming each; a missing id gets\n * `prop:crate` after a warning (`CORE_UNKNOWN_ID`).\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const reg = createRegistry();\n * defineProp('prop:stool', { parts: [{ geometry: 'geometry:frustum', params: { radiusBottom: 0.2, radiusTop: 0.2, height: 0.45 }, material: 'material:planks' }], body: { type: 'dynamic', shape: 'cylinder', radius: 0.2, height: 0.45 } }, reg);\n * propCentre(getProp('prop:stool', reg)); // 0.225: half its height\n * getProp('prop:crate', reg).body.type; // 'dynamic': the engine's props come with the kind\n * @see engine/world/props/prop.test.ts\n */\nimport { galleryField } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport type { EntryOf, Schema } from '../../core/schema';\nimport type { Point3 } from '../level/types';\nimport { BUILT_IN_PROPS } from './catalog';\nimport { FITTING_PROPS } from './fittings';\nimport { LIBRARY_PROPS } from './library';\n\n/** A vector field in metres (or `unit`), three numbers. */\nconst vec3 = (value: readonly number[], description: string, unit = 'm') =>\n  ({ type: 'array', items: { type: 'number' }, default: value, unit, description }) as const;\n\n/** A length in metres, at least 0. */\nconst metres = (value: number, description: string) =>\n  ({ type: 'number', default: value, minimum: 0, unit: 'm', description }) as const;\n\n/** The object of `properties`' defaults: a nested field's default, so a spec leaving it out gets every key. */\nconst defaultsOf = (properties: Schema): Record<string, unknown> =>\n  Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\n\n/** The fields of a part's flame. */\nconst FLAME_FIELDS = {\n  tongues: { type: 'integer', default: 0, minimum: 0, maximum: 8, description: 'How many tongues; 0: still.' },\n  ring: metres(0.1, 'How far from its origin the tongues stand.'),","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"b5d60803-e89a-451e-8c85-5d361a957662","timestamp":"2026-11-05T04:25:31.088Z","tool_use_result":{"stdout":"/**\n * @file Props in a running scene (PLAN.md WP 4.6 core proposal, ADR-0008 amendment 5; WP 4.5's props as data):\n * `spawnProp(w, placement)` stands a prop (engine/world/props: its id, its base and its turn about +Y) in a scene: its\n * body in the scene's physics world (`propBody`: none for a prop without one, such as the brazier's fire) and an\n * entity with the component `sceneProp` (the prop's id, its body and its pose: its centre and its turn), so the sim\n * hashes, captures and restores it and the view draws it as the prop (engine/gfx/stageProps.ts, through the instanced\n * prop meshes). The system `props.readback` (phase `readback`, after the physics step) copies each body's pose into\n * its component, as `actors.readback` does an actor's feet.\n *\n * Its `options` (WP 13.16, `SpawnPropOptions`): its body's type, its light (the component `propLight`, which the view\n * reads) and components from the start; a prop with `health` holds its hit points (`propHealth`), and nothing else\n * gains a component, so earlier hashes hold. `propOfBody(w, body)` is the body-to-entity lookup uses and hits read.\n *\n * `hitProp(w, id, from, knock?)` hits a prop from `from` (a swing, a blast): it calls the prop's `hit` hook with the\n * means to knock it, engine/physics/bodies.ts's `knock` on its body with the caller's strength (`speed`, `up`,\n * `spin`) under the hook's own; the default hook knocks a dynamic prop away and leaves the others. Shared code calls\n * the hook and never compares ids. `removeProp(w, id)` removes the entity and its body.\n *\n * The component's name is `sceneProp`, as names are global and fixtures/scenes/physics-props declares its own `prop`.\n * Its `x` and `z` are metres, so the stage places it, and draws it as its prop instead of a stand-in.\n *\n * Invariants: everything a prop is in the sim is its component and its body; the readback writes only what the body\n * holds (its centre and turn), so a prop's component equals its body's pose after every step; the system is added\n * once per world, on the first spawn of a prop with a body. Ids are asked of the entries, never compared.\n *\n * @example\n * import { defineScene } from './scene';\n * import { physicsOf } from '../physics/binding';\n * import { addLevelBodies } from './levelBodies';\n * defineScene('yard', {\n *   physics: true,\n *   setup(w) {\n *     // addLevelBodies(physicsOf(w), level); for (const placement of levelProps(level)) spawnProp(w, placement);\n *     spawnProp(w, { prop: 'prop:crate', at: [2, 0, 3], yaw: 0.4 });\n *   },\n * });\n * // after a step: w.get(id).sceneProp is { prop: 'prop:crate', body, x: 2, y: 0.375, z: 3, q: [0, 0.198…, 0, 0.980…] }\n * // hitProp(w, id, [1, 0, 3], { spin: w.rng('knock').range(-0.5, 0.5) }); // knocked east\n * @see engine/sim/props.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { knock } from '../physics/bodies';\nimport { physicsOf } from '../physics/binding';\nimport { propBody, propPose, type PropPlacement } from '../world/props/place';\nimport { getProp, type PropKnock } from '../world/props/prop';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The component `sceneProp`'s fields. */\nexport const SCENE_PROP_FIELDS = {\n  prop: { type: 'string', default: 'prop:crate', description: 'The prop it is, by id (engine/world/props).' },\n  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\n  x: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, east: its body’s origin.' },\n  y: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, up.' },\n  z: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, south.' },\n  q: {\n    type: 'array',\n    items: { type: 'number' },\n    default: [0, 0, 0, 1],\n    description: 'Its turn, a unit quaternion [x, y, z, w].',\n  },\n} as const;\n\n/** The component `sceneProp`: a prop standing in a scene. */\nexport interface ScenePropComponent {\n  prop: string;\n  body: number;\n  x: number;\n  y: number;\n  z: number;\n  q: [number, number, number, number];\n}\n\n...\n52:export const SCENE_PROP_FIELDS = {\n53-  prop: { type: 'string', default: 'prop:crate', description: 'The prop it is, by id (engine/world/props).' },\n54-  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\n55-  x: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, east: its body’s origin.' },\n56-  y: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, up.' },\n57-  z: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, south.' },\n58-  q: {\n59-    type: 'array',\n60-    items: { type: 'number' },\n61-    default: [0, 0, 0, 1],\n62-    description: 'Its turn, a unit quaternion [x, y, z, w].',\n63-  },\n64-} as const;\n65-\n66-/** The component `sceneProp`: a prop standing in a scene. */\n67-export interface ScenePropComponent {\n68-  prop: string;\n69-  body: number;\n70-  x: number;\n71-  y: number;\n72-  z: number;\n73-  q: [number, number, number, number];\n74-}\n--\n113:  defineComponent('sceneProp', { description, fields: SCENE_PROP_FIELDS }, registry);\n114-  const hp = { type: 'number', default: 0, minimum: 0, description: 'Hit points left; at 0 it breaks.' } as const;\n115-  defineComponent('propHealth', { description: \"A breakable prop's hit points (WP 13.16).\", fields: { hp } }, registry);\n116-  const fields = {\n117-    on: { type: 'boolean', default: true, description: 'Whether it is on: its lit parts and its light.' },\n118-    group: { type: 'string', default: '', description: \"Its light group ('room:kitchen').\" },\n119-  } as const;\n120-  defineComponent('propLight', { description: \"A switchable prop's state (WP 13.16).\", fields }, registry);\n121-}\n122-definePropKinds();\n123-\n124-/** Throws `SIM_BAD_ARGUMENT` for `id` when it is no prop. */\n125-function propOf(w: World, id: number, where: string): ScenePropComponent {\n126-  const data = (w.get(id) as Partial<ScenePropComponents> | undefined)?.sceneProp;\n127-  if (!data) throw codeError('SIM_BAD_ARGUMENT', { where, value: String(id), expected: 'a prop’s id (spawnProp)' });\n128-  return data;\n129-}\n130-\n131-/** The system `props.readback`: every prop with a body takes its body's pose, in id order. */\n132-function readProps(w: World): void {\n133-  const physics = physicsOf(w);\n134-  for (const { sceneProp } of w.query('sceneProp') as unknown as ScenePropComponents[]) {\n135-    if (sceneProp.body < 0) continue;\n\n/**\n * @file The prop registry (PLAN.md WP 4.5, §6.6): the registry kind `prop`, one entry per kind of thing that stands\n * in a level, as data: the meshes it is drawn with (geometry and material by id, §6.1: `world` names them, `gfx`\n * builds them, engine/gfx/props.ts), its body (a shape and a material for the physics world), an optional light\n * spot, where a level places it, and its interaction hooks. The engine's props are the crate, the barrel, the\n * brazier's fire and the pillar (engine/world/props/catalog.ts), the library's sconce, banner, chest, door, table,\n * bench, statue, lantern and chair (library.ts, WP 10.3, the chair WP 13.16's) and the house's fittings, the pane,\n * the switch, the lamp and the garage door (fittings.ts, WP 13.16); a game adds its own with `defineProp`\n * (`x new prop`). WP 13.16's fields: a `kinematic` body the sim drives, `health` and what breaking leaves (`breaks`),\n * a `prompt` for its own `use`, and parts `lit` only while the prop is on; a hook's touch also names the world, the\n * entity and its user.\n *\n * A prop's frame: its base, where it stands, is the origin, +Y up, and its parts stand on it as the geometry kit's\n * shapes stand on the ground. Its body's shape stands on the base too, so the body's origin, the prop's centre, is\n * `propCentre(prop)` above it: what a body's pose (`readBody`) and `propPose` give, and what the meshes are drawn\n * at. A part with `flame.tongues` above 0 is drawn as that many flame tongues dancing round its origin (its geometry\n * a cone one metre high, stretched each frame), the 2D hall's flames. The hooks: `hit` (a swing, a blast) knocks a\n * dynamic prop away and leaves the others; `use` does nothing; shared code calls them and never compares ids.\n *\n * Carried: the idea of my-3d2dge's 2D prop catalog (`src/starter/*`, `src/emberdeep/51-themes.js`): kinds of props\n * as data with their light metadata (a colour, a reach and a flicker beside the drawing).\n *\n * Invariants: an entry is plain data plus its two hooks, every field filled with its default; a part's name is\n * unique in its prop; colours are hex; vectors have three numbers; a body's shape has a size above 0; spawn names\n * and light tags are words. Geometry and material ids are gfx's to resolve (a missing one draws its kind's fallback,\n * and `node x qa geo tex --only prop:` reports it). Problems raise `CORE_BAD_SPEC` naming each; a missing id gets\n * `prop:crate` after a warning (`CORE_UNKNOWN_ID`).\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const reg = createRegistry();\n * defineProp('prop:stool', { parts: [{ geometry: 'geometry:frustum', params: { radiusBottom: 0.2, radiusTop: 0.2, height: 0.45 }, material: 'material:planks' }], body: { type: 'dynamic', shape: 'cylinder', radius: 0.2, height: 0.45 } }, reg);\n * propCentre(getProp('prop:stool', reg)); // 0.225: half its height\n * getProp('prop:crate', reg).body.type; // 'dynamic': the engine's props come with the kind\n * @see engine/world/props/prop.test.ts\n */\nimport { galleryField } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport type { EntryOf, Schema } from '../../core/schema';\nimport type { Point3 } from '../level/types';\nimport { BUILT_IN_PROPS } from './catalog';\nimport { FITTING_PROPS } from './fittings';\nimport { LIBRARY_PROPS } from './library';\n\n/** A vector field in metres (or `unit`), three numbers. */\nconst vec3 = (value: readonly number[], description: string, unit = 'm') =>\n  ({ type: 'array', items: { type: 'number' }, default: value, unit, description }) as const;\n\n/** A length in metres, at least 0. */\nconst metres = (value: number, description: string) =>\n  ({ type: 'number', default: value, minimum: 0, unit: 'm', description }) as const;\n\n/** The object of `properties`' defaults: a nested field's default, so a spec leaving it out gets every key. */\nconst defaultsOf = (properties: Schema): Record<string, unknown> =>\n  Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\n\n/** The fields of a part's flame. */\nconst FLAME_FIELDS = {\n  tongues: { type: 'integer', default: 0, minimum: 0, maximum: 8, description: 'How many tongues; 0: still.' },\n  ring: metres(0.1, 'How far from its origin the tongues stand.'),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015vrKYZkreXhkW2KyYhJP9x","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
