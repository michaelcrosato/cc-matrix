ill read, so turning it on again plays only what comes next).\n23- *\n24- * Carried from `my-3d2dge:src/stress-world/35-effects.js:81-131` (`drawEffects`: telegraphs, trails, bolts with the\n25- * first four lit, particles) and `my-3d2dge:engine/my-3d2dge.js:1569-1580` (`hitFx`), with shardfall's event bursts\n26- * and object lights (`shardfall:crates/pav_view/src/fx.rs:264-276, 290-480`).\n27- *\n28- * Invariants: presentation only: it reads what it is given and writes only its own objects; equal calls, streams and\n--\n70:export const FX_BUDGET = { particles: 4096, glows: 1024, decals: 1024, ribbons: 32, boltLights: 4 } as const;\n71-\n72-/** How a bolt looks: the Stress test's hero bolt by default. */\n73-export const BOLT = { color: '#ffb347', core: '#fff3c4', halo: 0.3125, radius: 0.125, light: 10, reach: 2.5 } as const;\n74-\n75-/** What `createEffects` takes. */\n76-export interface EffectsOptions {\n77-  /** The visual streams: the sim world's (`(...keys) => w.fxRng(...keys)`); seed 1's by default. */\n78-  fxRng?: (...keys: readonly (string | number)[]) => Rng;\n79-  /** The registry of the emitters and telegraphs; the shared one by default. */\n80-  registry?: Registry;\n81-}\n82-\n--\n136:  /** This frame's lights: running emitters' (flickering, pulsing) and the first `FX_BUDGET.boltLights` bolts'. */\n137-  lights(): FxLight[];\nengine/gfx/enhanced:\naa.test.ts\naa.ts\nair.test.ts\nair.ts\nao.test.ts\nao.ts\ncrowdNodes.ts\ncrowdRegions.ts\ncrowds.test.ts\ncrowds.ts\ncsm.test.ts\ncsm.ts\ngi.test.ts\ngi.ts\nlighting.test.ts\nlighting.ts\nparticles.test.ts\nparticles.ts\nssr.test.ts\nssr.ts\ntiming.test.ts\ntiming.ts\n\nengine/gfx/fx:\ndecals.test.ts\ndecals.ts\neffects.test.ts\neffects.ts\nemitters.test.ts\nemitters.ts\nparticles.test.ts\nparticles.ts\npayload.ts\npresets.ts\nribbons.test.ts\nribbons.ts\nrings.ts\nshake.test.ts\nshake.ts\nsprites.test.ts\nsprites.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01P1Su2XXrtY4CQMRGEp7ETu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
