{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VEuU1wT2Zfp5z5jr1neb3a","type":"tool_result","content":"/** How its code is written: what a bad one is told. */\nconst FORM = 'cam3={{name}},<distance>,<height> (m), the distance over 0';\n\n/** Its code's numbers: metres east of the player, and up. */\ninterface Spec {\n  readonly distance: number;\n  readonly height: number;\n}\n\n/** Its state: its numbers, and the point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n    fov: FOV,\n    distance: Math.hypot(state.distance, rise),\n  });\n}\n\n/** The camera `cam3={{name}}`, standing `spec`'s metres from the player (see the file comment). */\nexport function {{name}}Camera(spec: Spec = DEFAULTS) {\n  return followCamera('{{name}}', { ...spec, at: null } as State, {\n    step,\n    pose,\n    spec: ({ distance, height }) => ({ distance, height }),\n    code: ({ distance, height }) => `cam3={{name}},${distance},${height}`,\n    describe: ({ distance, height }) => `{{name}}: ${distance} m east of the player, ${height} m up`,\n  });\n}\n\ndefineCamera('{{name}}', {\n  description: \"A side-scroller's dolly: east of the player, looking west, following him with a lag (replace).\",\n  create(code) {\n    const [distance = DEFAULTS.distance, height = DEFAULTS.height] = code.split(',').slice(1).map(Number);\n    if (!(distance > 0) || !Number.isFinite(height)) throw new Error(`${code} is no {{name}} camera: write ${FORM}`);\n    return {{name}}Camera({ distance, height });\n  },\n});\n/**\n * @file Actions on actors (PLAN.md WP 13.11; engine/anim/actions.ts, WP 8.7): the component `actions` holds an animated\n * actor's `Actions` as the plain data `Actions.save()` writes (`ACTIONS_FIELDS`), so the sim hashes, captures and\n * restores what plays and where. `actOn(w, id, act)` runs `act` on actor `id`'s actions (the component added at rest\n * the first time a call changes them): `actOn(w, id, (a) => a.play('roll'))`, `a.next()` for a beat held\n * `until: 'next'`, `a.finish()`, `a.cancel('walk')`; the call's own events (the beat it begins, its first marks, an\n * `end`) go out as `action` from the call, at once between steps and at the step's end inside one. An action's clip\n * beats play on the actor's clip layer (the component `clips`, engine/sim/actorClips.ts), saved back with it; an actor\n * without one cannot play them (`SIM_ACTION_NO_CLIPS`).\n *\n * The system `actors.anim` (engine/sim/actors.ts) steps an actor's actions before its animator, in id order\n * (`stepActorActions`): what the beat tells the body (its states, a move, a motion) is laid over the animator's input,\n * and each event goes out as `action` `{ id, type, phase, late }`: a beat's name as it begins, its own events (`grab`,\n * `pull`, `top`…), and `end`. The view poses the effectors, the flip and the squash on the actor's puppet from the same\n * data (engine/gfx/puppets/actors.ts).\n *\n * Invariants: everything an actor's actions are is the component (the `Actions` here are made afresh for every call\n * and every step, so nothing, not a call's events, outlives one), so a capture restores them exactly wherever it is\n * taken; an actor at rest, its channels eased back, steps for nothing; a call that changes nothing adds nothing.\n *\n * @example\n * import { createCharacter } from '../physics/character';\n * import { spawnActor } from './actors';\n * // in a scene with a physics world, the actions loaded (loadActions):\n * // const id = spawnActor(w, { at: [0, 0, 0], character: createCharacter(), anim: { build: 'build:adult' } });\n * // actOn(w, id, (a) => a.play('roll'));\n * // w.step(); w.get(id).actions.playing; // 'action:roll'\n * @see engine/sim/actorActions.test.ts\n */\nimport { Actions, type ActionsState } from '../anim/actions';\nimport { ACTION } from '../anim/actions-data';\nimport type { AnimatorInput } from '../anim/states';\nimport type { EventMap } from '../core/events';\nimport { codeError, defineCodes } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { defineSchema } from '../core/schema';\nimport { clipLayerOf } from './actorClips';\nimport type { ActorComponents } from './actors';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The codes this module raises. */\nexport const ACTOR_ACTION_CODES = defineCodes('sim', {\n  SIM_ACTION_NO_CLIPS: {\n    template: 'actor {id} cannot play action {action}: it plays clips ({clips}) and the actor has no clip layer',\n    fix: 'give the actor clips first, with the sets those clips come from: addClips(w, id, { sets }) (engine/sim/actorClips.ts)',\n    doc: 'Raised by `actOn` (engine/sim/actorActions.ts) when an action with a `clip` beat is played on an actor without the component `clips`: the beat would play nothing.',\n  },\n});\n\n65:export interface CameraInput {\n66-  /** Look this frame `[right, up]`, rad: turn the view right and tilt it up (a captured mouse × its sensitivity). */\n67-  readonly look?: readonly [number, number];\n68-  /** Turn rates `[right, up]`, −1 to 1 (arrow keys, a right stick), times the camera's turn speed. */\n69-  readonly turn?: readonly [number, number];\n70-  /** Move axes `[right, forward, up]`, −1 to 1 (WASD, then E or Space up and Q down): fly cameras. */\n71-  readonly move?: readonly [number, number, number];\n72-  /** Move at the fast speed (Shift). */\n73-  readonly fast?: boolean;\n74-  /** Zoom steps, + in (wheel notches, + and −): views step their zoom, orbits come closer, fly and fixed narrow. */\n75-  readonly zoom?: number;\n76-  /** 45° turns of a classic view, + raising its azimuth (the prototype's `]` key). */\n77-  readonly turnSteps?: number;\n78-  /** The zoom steps a classic view's `zoom` moves through (engine/gfx/cameras/presets.ts's when absent). */\n79-  readonly zooms?: readonly number[];\n80-  /** The point views and orbits follow (the hero's feet, or a point just ahead of his aim), m. */\n81-  readonly follow?: Vec3;\n82-}\n83-\n84-/** A camera: its state, stepped once per rendered frame, and its pose. Made by the factories, or `createCamera`. */\n85-export interface Camera {\n86-  readonly type: CameraType;\n87-  /** Steps the camera by one rendered frame (`dt` real seconds) and returns its new pose. */\n88-  update(input?: CameraInput, dt?: number): CameraPose;\n89-  /** The pose after the last update. */\n90-  pose(): CameraPose;\n91-  /** The heading, rad: what `intents.fromCamera` and the intents' `cam` take (engine/input/intents.ts). */\n92-  yaw(): number;\n93-  /** The camera as a code's data (engine/gfx/cameras/codes.ts). */\n94-  spec(): CameraSpec;\n95-  /** The camera as a code: `cam=…` or `cam3=…`. */","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"11ed6d50-27bf-4176-ad97-43899ada3828","timestamp":"2026-11-05T04:44:38.980Z","tool_use_result":{"stdout":"/** How its code is written: what a bad one is told. */\nconst FORM = 'cam3={{name}},<distance>,<height> (m), the distance over 0';\n\n/** Its code's numbers: metres east of the player, and up. */\ninterface Spec {\n  readonly distance: number;\n  readonly height: number;\n}\n\n/** Its state: its numbers, and the point it follows, eased (null until a frame gives one). */\ninterface State extends Spec {\n  readonly at: readonly [number, number, number] | null;\n}\n\n/** The followed point eased toward the player's feet over `dt` real seconds; the whole way on the first frame. */\nfunction step(state: State, input: CameraInput, dt: number): State {\n  const to = input.follow;\n  if (!to) return state;\n  const from = state.at ?? to;\n  const k = 1 - Math.exp(-dt / LAG);\n  return { ...state, at: [0, 1, 2].map((i) => from[i] + (to[i] - from[i]) * k) as [number, number, number] };\n}\n\n/** East of the followed point and up, looking west and down at the point `AIM` over it. */\nfunction pose(state: State): CameraPose {\n  const [x, y, z] = state.at ?? [0, 0, 0];\n  const rise = state.height - AIM;\n  return makePose({\n    position: [x + state.distance, y + state.height, z],\n    yaw: -Math.PI / 2, // west: forward is (sin yaw, ·, cos yaw)\n    pitch: -Math.atan2(rise, state.distance),\n    fov: FOV,\n    distance: Math.hypot(state.distance, rise),\n  });\n}\n\n/** The camera `cam3={{name}}`, standing `spec`'s metres from the player (see the file comment). */\nexport function {{name}}Camera(spec: Spec = DEFAULTS) {\n  return followCamera('{{name}}', { ...spec, at: null } as State, {\n    step,\n    pose,\n    spec: ({ distance, height }) => ({ distance, height }),\n    code: ({ distance, height }) => `cam3={{name}},${distance},${height}`,\n    describe: ({ distance, height }) => `{{name}}: ${distance} m east of the player, ${height} m up`,\n  });\n}\n\ndefineCamera('{{name}}', {\n  description: \"A side-scroller's dolly: east of the player, looking west, following him with a lag (replace).\",\n  create(code) {\n    const [distance = DEFAULTS.distance, height = DEFAULTS.height] = code.split(',').slice(1).map(Number);\n    if (!(distance > 0) || !Number.isFinite(height)) throw new Error(`${code} is no {{name}} camera: write ${FORM}`);\n    return {{name}}Camera({ distance, height });\n  },\n});\n/**\n * @file Actions on actors (PLAN.md WP 13.11; engine/anim/actions.ts, WP 8.7): the component `actions` holds an animated\n * actor's `Actions` as the plain data `Actions.save()` writes (`ACTIONS_FIELDS`), so the sim hashes, captures and\n * restores what plays and where. `actOn(w, id, act)` runs `act` on actor `id`'s actions (the component added at rest\n * the first time a call changes them): `actOn(w, id, (a) => a.play('roll'))`, `a.next()` for a beat held\n * `until: 'next'`, `a.finish()`, `a.cancel('walk')`; the call's own events (the beat it begins, its first marks, an\n * `end`) go out as `action` from the call, at once between steps and at the step's end inside one. An action's clip\n * beats play on the actor's clip layer (the component `clips`, engine/sim/actorClips.ts), saved back with it; an actor\n * without one cannot play them (`SIM_ACTION_NO_CLIPS`).\n *\n * The system `actors.anim` (engine/sim/actors.ts) steps an actor's actions before its animator, in id order\n * (`stepActorActions`): what the beat tells the body (its states, a move, a motion) is laid over the animator's input,\n * and each event goes out as `action` `{ id, type, phase, late }`: a beat's name as it begins, its own events (`grab`,\n * `pull`, `top`…), and `end`. The view poses the effectors, the flip and the squash on the actor's puppet from the same\n * data (engine/gfx/puppets/actors.ts).\n *\n * Invariants: everything an actor's actions are is the component (the `Actions` here are made afresh for every call\n * and every step, so nothing, not a call's events, outlives one), so a capture restores them exactly wherever it is\n * taken; an actor at rest, its channels eased back, steps for nothing; a call that changes nothing adds nothing.\n *\n * @example\n * import { createCharacter } from '../physics/character';\n * import { spawnActor } from './actors';\n * // in a scene with a physics world, the actions loaded (loadActions):\n * // const id = spawnActor(w, { at: [0, 0, 0], character: createCharacter(), anim: { build: 'build:adult' } });\n * // actOn(w, id, (a) => a.play('roll'));\n * // w.step(); w.get(id).actions.playing; // 'action:roll'\n * @see engine/sim/actorActions.test.ts\n */\nimport { Actions, type ActionsState } from '../anim/actions';\nimport { ACTION } from '../anim/actions-data';\nimport type { AnimatorInput } from '../anim/states';\nimport type { EventMap } from '../core/events';\nimport { codeError, defineCodes } from '../core/log';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport { defineSchema } from '../core/schema';\nimport { clipLayerOf } from './actorClips';\nimport type { ActorComponents } from './actors';\nimport { defineComponent } from './state';\nimport type { World } from './world';\n\n/** The codes this module raises. */\nexport const ACTOR_ACTION_CODES = defineCodes('sim', {\n  SIM_ACTION_NO_CLIPS: {\n    template: 'actor {id} cannot play action {action}: it plays clips ({clips}) and the actor has no clip layer',\n    fix: 'give the actor clips first, with the sets those clips come from: addClips(w, id, { sets }) (engine/sim/actorClips.ts)',\n    doc: 'Raised by `actOn` (engine/sim/actorActions.ts) when an action with a `clip` beat is played on an actor without the component `clips`: the beat would play nothing.',\n  },\n});\n\n65:export interface CameraInput {\n66-  /** Look this frame `[right, up]`, rad: turn the view right and tilt it up (a captured mouse × its sensitivity). */\n67-  readonly look?: readonly [number, number];\n68-  /** Turn rates `[right, up]`, −1 to 1 (arrow keys, a right stick), times the camera's turn speed. */\n69-  readonly turn?: readonly [number, number];\n70-  /** Move axes `[right, forward, up]`, −1 to 1 (WASD, then E or Space up and Q down): fly cameras. */\n71-  readonly move?: readonly [number, number, number];\n72-  /** Move at the fast speed (Shift). */\n73-  readonly fast?: boolean;\n74-  /** Zoom steps, + in (wheel notches, + and −): views step their zoom, orbits come closer, fly and fixed narrow. */\n75-  readonly zoom?: number;\n76-  /** 45° turns of a classic view, + raising its azimuth (the prototype's `]` key). */\n77-  readonly turnSteps?: number;\n78-  /** The zoom steps a classic view's `zoom` moves through (engine/gfx/cameras/presets.ts's when absent). */\n79-  readonly zooms?: readonly number[];\n80-  /** The point views and orbits follow (the hero's feet, or a point just ahead of his aim), m. */\n81-  readonly follow?: Vec3;\n82-}\n83-\n84-/** A camera: its state, stepped once per rendered frame, and its pose. Made by the factories, or `createCamera`. */\n85-export interface Camera {\n86-  readonly type: CameraType;\n87-  /** Steps the camera by one rendered frame (`dt` real seconds) and returns its new pose. */\n88-  update(input?: CameraInput, dt?: number): CameraPose;\n89-  /** The pose after the last update. */\n90-  pose(): CameraPose;\n91-  /** The heading, rad: what `intents.fromCamera` and the intents' `cam` take (engine/input/intents.ts). */\n92-  yaw(): number;\n93-  /** The camera as a code's data (engine/gfx/cameras/codes.ts). */\n94-  spec(): CameraSpec;\n95-  /** The camera as a code: `cam=…` or `cam3=…`. */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VEuU1wT2Zfp5z5jr1neb3a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
