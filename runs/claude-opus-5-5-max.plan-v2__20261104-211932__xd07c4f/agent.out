 fix: 'the console names the cause; reload the page to start again, or read __engine.state() to see where the run stands',\n  },\n  APP_NO_REPLAY: {\n    template: 'the page has no replay {name}',\n    fix: 'use one of: {names}',\n  },\n  APP_NO_FRAME: {\n    template: 'no frame was drawn in {tries} tries: the warm-up never finished',\n    fix: 'read __engine.errors for GFX_WARMUP_FAILED; node x shot <page> reports it headless',\n  },\n});\n\nexport type { EngineFrame, FrameWorld } from './drawing';\n\n/** How a page starts the engine. */\nexport interface EngineOptions {\n  /** The canvas it draws into; the page sizes it with CSS. */\n  canvas: HTMLCanvasElement;\n  /** The page's scenes, by id (registered with defineScene); `?scene` picks one, the first by default. */\n  scenes: readonly string[];\n  /**\n   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n   * entry's `materials`); registered unless already.\n   */\n  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\n  replays?: Readonly<Record<string, () => Promise<string>>>;\n  /** The query to read (`location.search`). */\n  search?: string;\n  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\n  hash?: string;\n  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n  registry?: Registry;\n  /** Where errors and advice go (the shared log). */\n  log?: Log;\n  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\n  touchLayout?: string;\n  /**\n   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\n   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\n   */\n  actionMap?: string | ((camera: string) => string);\n  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\n  onView?: (action: string) => void;\n  /** Opens the page's menu, called after the touch menu button has paused the game. */\n  onMenu?: () => void;\n  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\n  onFrame?: (frame: EngineFrame) => void;\n  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\n  store?: Store;\n  /** True while the page's front end holds the devices (a menu, a photo mode): no intent reaches the run. */\n  modal?: () => boolean;\n  /** Camera input laid over the devices' each drawn frame, field by field (a photo mode's fly keys and drag look). */\n  cameraInput?: () => CameraInput | undefined;\n}\n\n/** A started engine. */\nexport interface Engine {\n  /** The inspector, also `window.__engine`; null when the scene could not start. */\n  readonly inspector: Inspector | null;\n  /** True once the first frame is drawn; never after a startup error. */\n  readonly ready: boolean;\n  /** What the query asked for; null when it could not be read. */\n  readonly routes: Routes | null;\n  /** The game's HTML/CSS overlay over the canvas (engine/ui/overlay.ts); null until the renderer started. */\n  readonly ui: Overlay | null;\n  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\n  readonly input: Input | null;\n  /** Stops the frame loop. */\n  stop(): void;\n}\n\n/** What `?replay=<name>` asked for: the replay, ready to play, or why there is none (raised once the page is up). */\ninterface Asked {\n  playback?: Playback;\n  error?: unknown;\n}\n\n/** Reads the replay `name` of `replays` before the run starts, so its scene can start (see the file comment). */\nasync function readReplay(name: string, replays: EngineOptions['replays']): Promise<Asked> {\n  const load = replays?.[name];\n  if (!load) {\n    const names = Object.keys(replays ?? {}).sort();\n    return { error: codeError('APP_NO_REPLAY', { name, names: names.join(', ') || 'none' }) };\n  }\n  try {\n    return { playback: createPlayback(JSON.parse(await load())) };\n  } catch (error) {\n    return { error };\n  }\n}\n\n/** A store that reads and writes whichever run's settings are current, for the renderer made once. */\nfunction currentSettings(run: () => AppRun): Settings {\n  return new Proxy({} as Settings, {\n    get(_, key: keyof Settings) {\n      const store = run().session.settings;\n      const value = store[key];\n      return typeof value === 'function' ? (value as (...args: unknown[]) => unknown).bind(store) : value;\n    },\n  });\n}\n\n/**\n * The log record for a thrown value: its own code and values when it is a coded error (a `GfxError` carries only its\n * message, so the values are read back from it through the code's template), else `code` with the message.\n */\nexport function recordOf(error: unknown, code: string): [string, CodeValues] {\n  const coded = error as { code?: unknown; values?: CodeValues; message?: unknown };\n  const message = String(coded?.message ?? error);\n  const info = typeof coded?.code === 'string' ? codeInfo(coded.code) : undefined;\n  if (!info) return [code, { message }];\n  if (coded.values) return [info.code, coded.values];\n  const names: string[] = [];\n  const pattern = info.template\n    .split(/\\{(\\w+)\\}/)\n    .map((part, i) => (i % 2 ? (names.push(part), '(.*)') : part.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')))\n    .join('');\n  const found = new RegExp(`^${pattern}$`, 's').exec(message);\n  return [info.code, Object.fromEntries(names.map((name, i) => [name, found?.[i + 1] ?? '?']))];\n}\n\n/** Starts the engine in a page (see the file comment); resolves once it is up or has failed. */\nexport async function createEngine(options: EngineOptions): Promise<Engine> {\n  const log = options.log ?? sharedLog;\n  const registry = options.registry ?? sharedRegistry;\n  const overlay = createOverlay(document);\n  overlay.status('Loading…');\n  let routes: Routes | null = null;\n  let loop: Loop | null = null;\n  const parts: PageParts = { run: null, gfx: null, post: null, look: null, input: null, layer: null, ui: null, numbers: null, governor: createGovernor({ log, memory: governorMemory(options.store, () => routes?.scene) }), cameraInput: options.cameraInput, ready: false }; // prettier-ignore\n  const fail = (error: unknown, code = 'APP_START'): ErrorRecord => {\n    const record = log.error(...recordOf(error, code), error);\n    overlay.error(record);\n    return record;\n  };\n  const signals = {\n    get ready() {\n      return false;\n    },\n    get errors() {\n      return log.errors.map((record) => ({ ...record }));\n    },\n    info: () => ({ page: location.pathname, headless: true }),\n  };\n  Object.assign(window, { __engine: signals });\n  const engine: Engine = {\n    get inspector() {\n      return parts.run?.inspector ?? null;\n    },\n    get ready() {\n      return parts.ready;\n    },\n    get routes() {\n      return routes;\n    },\n    get ui() {\n      return parts.ui;\n    },\n    get input() {\n      return parts.input;\n    },\n    stop: () => loop?.stop(),\n  };\n\n  let layout: TouchLayout | null = null;\n  let playback: Playback | null = null;\n  const viewNow = () => parts.run!.view!;\n  const settingsNow = currentSettings(() => parts.run!);\n  const chrome = createChrome(document);\n  let gallery: GalleryDriver | null = null; // a gallery deep link's, fitting its camera and bursting its emitter\n  const onFrame = (shown: EngineFrame) => {\n    gallery?.frame(shown.dt);\n    options.onFrame?.(shown);\n  };\n  const { drawing, frame, settle, warmCameras } = createPageDrawing(parts, { chrome, settings: settingsNow, onFrame }); // prettier-ignore\n  let warming: Promise<void> | null = null;\n  let asked: Asked | null = null;\n  let materials: ReturnType<typeof createMaterialLibrary> | null = null;\n\n  try {\n    definePostSettings(registry);\n    for (const [id, level] of Object.entries(options.levels ?? {})) {\n      if (!registry.has('level', id)) defineLevel(id, level, registry);\n    }\n    const search = options.search ?? location.search;\n    routes = parseRoutes(search, { scenes: options.scenes, registry, hash: options.hash ?? location.hash, log });\n    if (routes.replay !== undefined) {\n      asked = await readReplay(routes.replay, options.replays);\n      const scene = asked.playback?.replay.scene;\n      if (scene && !new URLSearchParams(search).has('scene') && options.scenes.includes(scene)) {\n        routes = { ...routes, scene };\n      }\n    }\n    if (options.touchLayout !== undefined) layout = getTouchLayout(options.touchLayout, registry);\n    materials = createMaterialLibrary({ registry });\n    const { scene, seed, settings, cam } = routes;\n    parts.run = createAppHost({ scene, seed, settings, cam, registry, log, drawing, materials });\n    if (routes.gallery) gallery = createGalleryDriver(routes.gallery, () => parts.run!, registry);\n  } catch (error) {\n    fail(error);\n    return engine;\n  }\n  const started = parts.run;\n  Object.assign(window, { __engine: started.inspector });\n  const onTap = (name: string) => {\n    if (name === 'game') chrome.closeTopPanel();\n    if (name !== 'menu') return;\n    started.clock.pause();\n    options.onMenu?.();","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VuyyWheKDeEZRpMjBvAPBt","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9PdLq11FpaPz9PZ6uP","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SsyYdHFTn38nmDpawZqRB2","name":"Bash","input":{"command":"sed -n 1,70p engine/gfx/weapons.ts; echo ...; grep -n \"hands\\|first\" engine/gfx/weapons.ts | head -30; echo ---; ls engine/gfx | head -80; echo; grep -rn \"hidden but\\|handsOnly\\|hideBody\\|bodyHidden\\|hands\" engine/gfx/stage*.ts engine/app/view*.ts | head -20","description":"Read how the engine draws weapons and first-person hands"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12696,"cache_read_input_tokens":171988,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12696},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"75e8245d-a3dc-4ade-b481-4ab3479dfba4","timestamp":"2026-11-05T04:25:03.865Z","request_id":"req_011Cgj9Pd3UKZaX2gkYnnTRw","wire_tool_inputs":{"toolu_01SsyYdHFTn38nmDpawZqRB2":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work/.research/my-3dge && sed -n 1,70p engine/gfx/weapons.ts; echo ...; grep -n \"hands\\|first\" engine/gfx/weapons.ts | head -30; echo ---; ls engine/gfx | head -80; echo; grep -rn \"hidden but\\|handsOnly\\|hideBody\\|bodyHidden\\|hands\" engine/gfx/stage*.ts engine/app/view*.ts | head -20","description":"Read how the engine draws weapons and first-person hands"}},"wire_ingest_context":{"toolu_01SsyYdHFTn38nmDpawZqRB2":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work/.research/my-3dge"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SsyYdHFTn38nmDpawZqRB2","type":"tool_result","content":"/**\n * @file Firearms drawn (PLAN.md WP 13.20; docs/PLAYGROUND.md §7.2, §4): what the view shows of the weapons the sim\n * fires (engine/sim/weapons.ts; the kind `weapon`, engine/world/weapons.ts), presentation only.\n * - **The gun in the hand.** `weaponOut(entity)` is the weapon an actor's component `weapons` has out (null:\n *   holstered, or none), and `gunPose(skeleton, world, barrel)` where its prop stands: at the right hand's grip (the\n *   socket `weaponR`), its +Z along the hold's barrel (engine/anim/traversal/hold.ts `HoldPlant.barrel`), its +Y as\n *   near up as that leaves. The stage draws it as its prop (engine/gfx/stageProps.ts `carry`), first person as a mesh\n *   of its own at the arms' grip, by their lens (engine/gfx/viewmodel/body.ts): `gunGeometry`, its prop's parts as one\n *   geometry coloured by their tints, which the arms' vertex-coloured material draws; `muzzlePoint` is where its shots\n *   leave.\n * - **Shots** (`createWeaponFx`): `feed(trace, muzzleOf)` plays each `gunshot` event of the world's trace once: a\n *   tracer from the muzzle (`muzzleOf(id)`, the carried gun's, else `TRACER.ahead` along the shot from where it left)\n *   to where it ended, for `TRACER.life`; a flash of sparks at the muzzle, and where it struck a star and sparks off\n *   the surface (the effects' `emitter:impact` and `emitter:sparks`) and a hole facing its normal (`HOLES`), the latest\n *   `HOLES.capacity` kept. `frame(dt)` moves the tracers on; `register(warmup)` makes both batches' pipelines before\n *   the first frame.\n *\n * Invariants: presentation only: it reads the trace and the posed bodies and writes nothing back; each event plays\n * once, by its number, as the effects' own `feed` reads the trace; its batches exist from the start and never grow.\n *\n * Carried from the hit effects of `my-3d2dge:engine/my-3d2dge.js:1569-1580` (`hitFx`: a star and sparks where a blow\n * lands), with Apex Legends' tracers and bullet holes.\n *\n * @example\n * import { Vector3 } from 'three/webgpu';\n * import { Animator } from '../anim/character';\n * // const shots = createWeaponFx({ effects: stage.fx.effects }); stage.scene.add(shots.root);\n * // shots.feed(world.events.trace(), (id) => stage.actors.muzzle(id)); shots.frame(dt); // each drawn frame\n * const { skeleton, world } = new Animator({ build: 'build:adult', clock: 1 }).update({ position: new Vector3() }).body;\n * gunPose(skeleton, world, new Vector3(0, 0, 1)).position; // the right hand's grip, the barrel along +Z\n * @see engine/gfx/weapons.test.ts\n */\nimport {\n  BoxGeometry,\n  BufferAttribute,\n  CustomBlending,\n  Matrix4,\n  MeshBasicNodeMaterial,\n  OneFactor,\n  OneMinusSrcAlphaFactor,\n  PlaneGeometry,\n  Quaternion,\n  Vector3,\n  type BufferGeometry,\n  type Group,\n} from 'three/webgpu';\nimport { socketPosition, type WorldPose } from '../anim/fk';\nimport type { Skeleton } from '../anim/skeleton';\nimport { toLinear } from '../core/color';\nimport { registry as sharedRegistry, type Registry } from '../core/registry';\nimport type { EntityData } from '../sim/state';\nimport { getProp } from '../world/props/prop';\nimport { getWeapon, type WeaponKind } from '../world/weapons';\nimport type { Effects } from './fx/effects';\nimport { mergeGeometries } from './geometry/groups';\nimport { createInstancedBatch, type InstancedBatch } from './instancing';\nimport { getMaterial } from './materials/material';\nimport { buildPropPart, partMatrix } from './props';\nimport type { Warmup } from './warmup';\n\n/** A tracer's look: its life (s), width (m), colour, and how far ahead of where a shot left it starts without a gun. */\nexport const TRACER = Object.freeze({ life: 0.05, width: 0.012, color: '#ffd27a', ahead: 0.8, capacity: 32 });\n/** A bullet hole: its size (m), colour and how far off its surface (m); the latest `capacity` stay. */\nexport const HOLES = Object.freeze({ size: 0.05, color: '#14110f', lift: 0.004, capacity: 64 });\n\n/** A gun in a hand as the view draws it: its weapon, and where its grip stands and its turn (world). */\nexport interface HeldGun {\n  readonly kind: WeaponKind;\n  readonly position: Vector3;\n  readonly rotation: Quaternion;\n...\n7: *   near up as that leaves. The stage draws it as its prop (engine/gfx/stageProps.ts `carry`), first person as a mesh\n16: *   the first frame.\n117: * vertex coloured by its part's tint over its material's colour (linear): what first person draws in the arms'\n---\natmosphere.test.ts\natmosphere.ts\nbackdrop.ts\ncameras\ncaps.test.ts\ncaps.ts\ncutaway.test.ts\ncutaway.ts\ndaylight.test.ts\ndaylight.ts\nenhanced\nfeatures.test.ts\nfeatures.ts\nfx\ngeometry\nidmarks.ts\nidpass.test.ts\nidpass.ts\ninstanceSync.ts\ninstancing.test.ts\ninstancing.ts\nlevel\nlights.test.ts\nlights.ts\nlookMetrics.test.ts\nlookMetrics.ts\nmaterials\npipelines.test.ts\npipelines.ts\npost\npropLooks.ts\nprops.test.ts\nprops.ts\npuppets\nquality.ts\nrenderer.test.ts\nrenderer.ts\nresolution.test.ts\nresolution.ts\nsceneDump.test.ts\nsceneDump.ts\nshadows.test.ts\nshadows.ts\nshot.test.ts\nshot.ts\nsky.test.ts\nsky.ts\nskyKind.ts\nstage.test.ts\nstage.ts\nstageCrowd.test.ts\nstageCrowd.ts\nstageFx.test.ts\nstageFx.ts\nstageGround.ts\nstageProps.test.ts\nstageProps.ts\nstageRides.test.ts\nstageRides.ts\nstageShells.test.ts\nstageShells.ts\nstageSite.test.ts\nstageSite.ts\nstageSky.test.ts\nstageSky.ts\nstandIns.ts\nstoreyCut.test.ts\nstoreyCut.ts\nterrain.test.ts\nterrain.ts\nterrainSplat.ts\ntextures\nthumbnail.test.ts\nthumbnail.ts\nviewmodel\nwarmup.test.ts\nwarmup.ts\nweapons.test.ts\nweapons.ts\n\nengine/gfx/stage.ts:16: * each frame by the view), and the guns in the actors' hands as props (WP 13.20). Stand-ins: any other entity is drawn\nengine/gfx/stage.ts:129:   * The effects: bolts, telegraphs, trails and the events' bursts (engine/gfx/stageFx.ts); the view hands it frames.\nengine/gfx/stageShells.ts:9: * A look asks for them (`shells: { width, color }`, engine/gfx/post/looks.ts), which the page's look hands over each\nengine/app/view.ts:324:      // flying bolt changes hands at once between the effects and its stand-in, and no frame draws it by neither.\nengine/gfx/stageFx.ts:5: * (engine/gfx/stage.ts) makes one (`stage.fx`), under its scene; the run's view (engine/app/view.ts) hands it each\nengine/gfx/stageFx.ts:26: * hands in that frame, stepped or not (a paused page, a hit-stop, a shot).\nengine/gfx/stageFx.ts:122:   * frame hands it to the post chain, which draws it and warms it up.\nengine/gfx/stageProps.ts:14: * adds the guns in the actors' hands (engine/gfx/puppets/actors.ts `carried`, WP 13.20) to the draws after it, each as\nengine/app/view.test.ts:12: * cameras follow him, the chase camera stays inside the room, first person hides his body but the hands, and the\nengine/app/view.test.ts:195:  it('hands a flying bolt over in the first frame after the effects are switched, with no step between', async () => {\nengine/gfx/stageProps.test.ts:130:    expect(SCENE_PROP_FIELDS.x.unit).toBe('m'); // so the view hands props to the stage\nengine/gfx/stageSite.ts:19: * `follow` hands it (the stage's rides) stand in the world, so they fade once, in the world's frame.","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"4cc500a6-2807-44de-ba70-523f469329da","timestamp":"2026-11-05T04:25:03.891Z","tool_use_result":{"stdout":"/**\n * @file Firearms drawn (PLAN.md WP 13.20; docs/PLAYGROUND.md §7.2, §4): what the view shows of the weapons the sim\n * fires (engine/sim/weapons.ts; the kind `weapon`, engine/world/weapons.ts), presentation only.\n * - **The gun in the hand.** `weaponOut(entity)` is the weapon an actor's component `weapons` has out (null:\n *   holstered, or none), and `gunPose(skeleton, world, barrel)` where its prop stands: at the right h