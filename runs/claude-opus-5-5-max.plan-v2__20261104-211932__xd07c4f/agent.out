{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018GdE2mHhWVyenzknfaqtoS","type":"tool_result","content":"/**\n * @file The page's drawing (PLAN.md §6.4, §6.7, WP 2.7): what engine/app/engine.ts `createEngine` draws with once its\n * renderer is up. `createPageDrawing(parts, options)` gives the page's frame (`frame`: touch mode and the quality\n * tier's pixel caps, the resolution, the view at the clock's alpha drawn through the post chain in the page's look,\n * the camera shake, the damage numbers, the overlay, then the page's own `onFrame`), `settle` (a frame drawn and done\n * on the GPU, warming up again until one is), `warmCameras` (each camera warmed up through the chain under the shader\n * key now: both of the view's, so switching projection later builds nothing, or, with `gfx.warmUp: asked`, those\n * drawn so far, a camera's first frame or shot waiting for its own warm-up) and the rendering members' `Drawing`\n * (engine/app/headless.ts): `render(n)` draws frames now, `shot` shoots the view (engine/gfx/shot.ts), `draw` draws a\n * frame after each step of a replay (the CPU-only contract's proof, §6.7: `x replay --browser page`), and `counts`\n * reads the renderer's. A warm-up's report names its camera, so a running one counts for the camera it compiled.\n *\n * Invariants: rendering never writes the sim (doctrine: WebGPU only): the view reads the run, and `setView` changes\n * view settings, which never reach the hash. A replay drawn a frame a step waits for the GPU's queue every\n * `DRAWING.drain` frames, so it never runs far ahead; `settle` gives up after `DRAWING.tries` frames with\n * `APP_NO_FRAME`. `parts` is read at each call, so what the engine starts later (the renderer, the chain, the look,\n * the input) is drawn with as soon as it is there. Split from engine.ts to keep each under 400 lines (ADR-0014\n * amendment 16).\n *\n * @example\n * // engine/app/engine.ts\n * // const parts: PageParts = { run: null, gfx: null, post: null, look: null, input: null, layer: null, ui: null, numbers: null, governor: null, ready: false };\n * // const { drawing, frame, settle, warmCameras } = createPageDrawing(parts, { chrome, settings, onFrame });\n * @see tests/e2e/box.spec.ts\n */\nimport { codeError } from '../core/log';\nimport type { Settings, SettingValue } from '../core/settings';\nimport { qualityBudget, type QualitySetting } from '../gfx/quality';\nimport { keepWidth } from '../gfx/resolution';\nimport type { Post } from '../gfx/post/chain';\nimport type { FrameReport, FrameView, Gfx } from '../gfx/renderer';\nimport { shot, shotForJson } from '../gfx/shot';\nimport { warmsAsked } from '../gfx/warmup';\nimport type { Input } from '../input/input';\nimport type { Chrome } from '../ui/chrome';\nimport type { Overlay } from '../ui/overlay';\nimport type { TouchLayer } from '../ui/touch';\nimport { queryViewOf } from '../sim/queryView';\nimport type { CameraInput, CameraPose } from '../gfx/cameras/pose';\nimport type { QueryView } from '../sim/queryView';\nimport type { Scene } from '../sim/scene';\nimport type { World, WorldEvents } from '../sim/world';\nimport type { DamageNumbers } from './damageNumbers';\nimport type { AppRun, Drawing } from './headless';\nimport type { PageLook } from './look';\nimport { HEADLESS_ASPECT } from './view';\nimport type { Governor } from '../dev/governor';\n\n/** GPU frames drawn while a replay plays before the queue is drained (`drain`); frames tried before a warm-up counts as stuck (`tries`). */\nexport const DRAWING = { drain: 10, tries: 10 } as const;\n\n/**\n * The cameras a warm-up compiles for (`gfx.warmUp`, engine/gfx/warmup.ts): every one of the view's in `all`, else\n * those the page has drawn with (`drawn`), in the view's order.\n */\nexport function warmedCameras<C>(cameras: readonly C[], drawn: ReadonlySet<C>, asked: boolean): readonly C[] {\n  return asked ? cameras.filter((camera) => drawn.has(camera)) : cameras;\n}\n\n/** What the page has started so far, read at each call: each part is null until the engine starts it. */\nexport interface PageParts {\n  run: AppRun | null;\n  gfx: Gfx | null;\n  post: Post | null;\n  look: PageLook | null;\n  input: Input | null;\n  layer: TouchLayer | null;\n  ui: Overlay | null;\n  numbers: DamageNumbers | null;\n  /** The performance governor (engine/dev/governor.ts): `auto`'s tier as the frame rate asks. */\n  governor: Governor | null;\n  /** The page's own camera input, laid over the devices' each drawn frame (`EngineOptions.cameraInput`). */\n  cameraInput?: () => CameraInput | undefined;\n  /** Whether the first frame is drawn. */\n  ready: boolean;\n}\n\n/** The read side of the run's world a page gets each frame: its step, rate, entities and the trace of its events. */\nexport type FrameWorld = Pick<World, 'tick' | 'hz' | 'get' | 'query'> & { readonly events: Pick<WorldEvents, 'trace'> };\n\n/**\n * What `onFrame` gets once per drawn frame: the run to read, never to change (presentation only: nothing reaches the\n * hash), the camera the frame was drawn from, and the emitters to run.\n */\nexport interface EngineFrame {\n  /** The run's world: the same object until the run starts again (a new seed, a replay), so a reader compares it. */\n  readonly world: FrameWorld;\n  /** The running scene: its id, its level and whether it has physics. */\n  readonly scene: Scene;\n  /** The camera's pose this frame: where a listener goes. */\n  readonly camera: CameraPose;\n  /** The sim's physics queries, read-only, in a physics scene; null without physics. */\n  readonly queries: QueryView | null;\n  /** Real seconds since the last frame. */\n  readonly dt: number;\n  /** The value setting `key` has now, view settings among them (`x set`, `__engine.set`, the URL). */\n  setting(key: string): unknown;\n  /**\n   * Runs emitter `id` at its rate times `scale` (1) at `at` (m) for the next frame, `key` naming it so its fractions\n   * and light carry over: rain over the player, a fire in a hearth (engine/gfx/fx/effects.ts `emit`). An emitter that\n   * says `gpu` has its particles on the GPU's ring where `feature:gpuParticles` is on (WP 11.3). Presentation only.\n   */\n  emit(id: string, at: readonly [number, number, number], key: string, scale?: number): void;\n}\n\n/** What `createPageDrawing` draws with besides the parts. */\nexport interface PageDrawingOptions {\n  /** The page's chrome: its touch class and top panel. */\n  chrome: Chrome;\n  /** The current run's settings (`quality`). */\n  settings: Settings;\n  /** The page's own presentation, after each drawn frame. */\n  onFrame?: (frame: EngineFrame) => void;\n}\n\n/** The page's drawing (see the file comment). */\nexport interface PageDrawing {\n  /** The rendering members' drawing. */\n  readonly drawing: Drawing;\n  /** Draws the view at `alpha`, `dt` real seconds after the last frame. */\n  frame(alpha: number, dt: number): FrameReport;\n  /** Draws until a frame is drawn and done on the GPU; throws `APP_NO_FRAME` after `DRAWING.tries`. */\n  settle(alpha: number, dt: number): Promise<FrameReport>;\n  /** Warms up through each camera `warmedCameras` names that is not warm under the shader key now. */\n  warmCameras(): Promise<void>;\n}\n\n/** The page's drawing over `parts` (see the file comment). */\nexport function createPageDrawing(parts: PageParts, options: PageDrawingOptions): PageDrawing {\n  const { chrome, settings } = options;\n  let draws = 0;\n  const viewNow = () => parts.run!.view!;\n  const aspect = () => {\n    const css = parts.gfx?.resolution.current?.css;\n    return css && css.width > 0 && css.height > 0 ? css.width / css.height : HEADLESS_ASPECT;\n  };\n  /** Touch mode this frame: the page's class and layer, and the quality tier's pixel caps. */\n  const touchFrame = () => {\n    const touch = parts.input?.touch;\n    const on = touch?.active ?? false;\n....\n85:export interface EngineFrame {\n86-  /** The run's world: the same object until the run starts again (a new seed, a replay), so a reader compares it. */\n87-  readonly world: FrameWorld;\n88-  /** The running scene: its id, its level and whether it has physics. */\n89-  readonly scene: Scene;\n90-  /** The camera's pose this frame: where a listener goes. */\n91-  readonly camera: CameraPose;\n92-  /** The sim's physics queries, read-only, in a physics scene; null without physics. */\n93-  readonly queries: QueryView | null;\n94-  /** Real seconds since the last frame. */\n\nbody.ts\nlens.ts\nmaterial.ts\nrig.ts\n/**\n * @file First person's player (PLAN.md WP 13.12, docs/PLAYGROUND.md §4): the body and the arms a first-person camera\n * sees. `createViewmodel(puppet, { materials, look })` takes the player's puppet (engine/gfx/puppets/draw.ts) and adds\n * the arms: a mesh of the same compiled body's arm and right-leg pieces alone (`armsBody`), a child of the body's mesh,\n * casting no shadow, posed on the CPU each frame from the arms rig (engine/gfx/viewmodel/rig.ts), each vertex by the\n * one bone it rides as the puppet's rigid skinning would, since r182 skins a mesh after its position node and the\n * arms' lens must see them posed (engine/gfx/viewmodel/material.ts). The body's mesh carries the `viewmodel` attribute\n * and wears its materials' body copies, the arms their arms copies; each wraps what the style set gives it later\n * (`userData.restyle`, engine/gfx/materials/styles.ts). `update(frame, animated)` each drawn frame:\n * - first person (a `ViewmodelFrame`): the body's vertices fold (1), all of them or, with `fullBody`, those of the\n *   parts it hides (engine/gfx/cameras/first.ts `firstBodyCull`), so the camera sees none of it while its shadow stays\n *   whole; the rig poses the arms against the camera from the body's animator and its traversal plant (`armsInputOf`),\n *   the arms draw the parts it shows (the others folded to a point), and the look takes the frame's lens;\n * - otherwise (null): the body drawn as it is (0), the arms hidden.\n * It returns the joints the body hid and the ones the arms show. A gun the body holds (`animated.gun`, its weapon out,\n * WP 13.20) shows in the arms' right hand: a mesh per weapon with a prop (engine/gfx/weapons.ts `gunGeometry`), in the\n * arms' material, made for each weapon defined when the viewmodel is (so the warm-up builds them) and for one defined\n * later the first time the body holds it, at the rig's grip, its barrel the body's turned from the body's look onto the\n * camera's, kicked back and up a little at each shot (`GUN_KICK`, the player's `shots`); `muzzle` is where its lens\n * draws the muzzle, which the shots' tracers leave from.\n *\n * Invariants: presentation only; the body's attribute changes only when what it hides does (an upload, never a\n * pipeline); the arms exist from the start, so the warm-up builds their pipeline (the actors register them), and a\n * puppet keeps its viewmodel as a spare, the arms named and tagged as the body is; `dispose` frees the arms' geometry\n * (the body is its owner's).\n *\n * @example\n * import { MeshLambertMaterial } from 'three/webgpu';\n * import '../puppets/bodies/humanoid';\n * import { compileBody } from '../puppets/compile';\n * import { createPuppet } from '../puppets/draw';\n * import { createViewmodelLook } from './material';\n * const materials = { get: () => new MeshLambertMaterial({ vertexColors: true }) };\n * const puppet = createPuppet(compileBody('body:humanoid', 'build:adult'), { materials });\n * const viewmodel = createViewmodel(puppet, { materials, look: createViewmodelLook() });\n * viewmodel.arms.parent === puppet.mesh; // true: the arms ride the body's mesh, hidden until first person\n * viewmodel.update(null, null).hidden; // []: not first person, the body whole\n * @see engine/gfx/viewmodel/body.test.ts\n */\nimport { BufferAttribute, Mesh, Quaternion, Vector3, type Material } from 'three/webgpu';","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"cc9c9b49-2052-49d8-a762-96fd7e1073a0","timestamp":"2026-11-05T04:25:21.527Z","tool_use_result":{"stdout":"/**\n * @file The page's drawing (PLAN.md §6.4, §6.7, WP 2.7): what engine/app/engine.ts `createEngine` draws with once its\n * renderer is up. `createPageDrawing(parts, options)` gives the page's frame (`frame`: touch mode and the quality\n * tier's pixel caps, the resolution, the view at the clock's alpha drawn through the post chain in the page's look,\n * the camera shake, the damage numbers, the overlay, then the page's own `onFrame`), `settle` (a frame drawn and done\n * on the GPU, warming up again until one is), `warmCameras` (each camera warmed up through the chain under the shader\n * key now: both of the view's, so switching projection later builds nothing, or, with `gfx.warmUp: asked`, those\n * drawn so far, a camera's first frame or shot waiting for its own warm-up) and the rendering members' `Drawing`\n * (engine/app/headless.ts): `render(n)` draws frames now, `shot` shoots the view (engine/gfx/shot.ts), `draw` draws a\n * frame after each step of a replay (the CPU-only contract's proof, §6.7: `x replay --browser page`), and `counts`\n * reads the renderer's. A warm-up's report names its camera, so a running one counts for the camera it compiled.\n *\n * Invariants: rendering never writes the sim (doctrine: WebGPU only): the view reads the run, and `setView` changes\n * view settings, which never reach the hash. A replay drawn a frame a step waits for the GPU's queue every\n * `DRAWING.drain` frames, so it never runs far ahead; `settle` gives up after `DRAWING.tries` frames with\n * `APP_NO_FRAME`. `parts` is read at each call, so what the engine starts later (the renderer, the chain, the look,\n * the input) is drawn with as soon as it is there. Split from engine.ts to keep each under 400 lines (ADR-0014\n * amendment 16).\n *\n * @example\n * // engine/app/engine.ts\n * // const parts: PageParts = { run: null