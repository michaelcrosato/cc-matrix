{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0177FSedQX53BrmmBufjJvwD","type":"tool_result","content":"/**\n * @file The menu (PLAN.md §6.7, WP 10.6, I-50): a list with a cursor, for title screens, pause menus, settings and\n * shops, as HTML/CSS over the overlay. `createMenu(parent, items, { input, sound, title, place, onPick, onCancel,\n * onMove, send })` makes it open; `update(dt)` each frame reads the page's input and returns true when it picked or\n * cancelled.\n *\n * `uiUp` and `uiDown` (keys, the pad's D-pad and left stick; held, they repeat: engine/ui/widgets.ts `createRepeat`)\n * move the cursor over the items, round the ends, past disabled ones; `uiAccept` picks the item under it, `uiCancel`\n * calls `onCancel` when there is one; a pointer moving over an item moves the cursor there (a menu opening under a still\n * pointer, or rows shifting under it, moves none), a click picks it. A gamepad drives the menu with its buttons, and any\n * other panel through the pad's cursor (`createPadCursor`).\n *\n * Picks that change play: the system layer never enters the intents (engine/input/actionMaps.ts), so a menu never\n * reaches the sim itself. An item with an `id` is handed to `send(id)` when picked, which the page turns into input\n * the session records (a dev action, `__engine.actions.run`, or a custom intent for the next step), so the replay\n * holds the pick; `onPick` hears every pick, for what only the page changes (a look, a panel).\n *\n * Elements: `[data-ui=menu]` (`data-id`, `data-value` the cursor's index; `data-place`), its `[data-ui=menu-title]`,\n * and a `[data-ui=item]` per item (`data-id` its id or index, `data-value` `selected`, `disabled` or empty). Cues: `move`,\n * `pick`, `cancel`. Invariants: presentation only; `active: false` reads no input; the cursor never rests on a disabled\n * item while another is enabled. Carried from `my-3d2dge:engine/my-3d2dge.js:4288-4330` (`Menu`: items, disabled ones\n * skipped, onPick, onCancel, onMove) and shardfall's rule that menu actions reach the game as input (§5.8).\n *\n * @example\n * // browser: the menu needs a page\n * // const pause = createMenu(ui.root, ['Resume', { label: 'Restart', id: 'restart' }], {\n * //   input, title: 'Paused', onCancel: () => pause.remove(), send: (id) => engine.actions.run(id) });\n * // pause.update(dt); // each frame\n * @see engine/ui/menu.test.ts\n * @see tests/e2e/ui.spec.ts\n */\nimport { codeError, defineCodes } from '../core/log';\nimport { createRepeat, setText, uiElement, widgetStyle, type UiInput, type UiSound } from './widgets';\n\n/** The codes this module raises, with their fixes. */\nexport const MENU_CODES = defineCodes('ui', {\n  UI_BAD_MENU: {\n    template: 'menu: {problem}',\n    fix: \"give items as strings or { label, id?, disabled? }, and update(dt) the frame's seconds, 0 or more\",\n    doc: 'Raised by the menu (engine/ui/menu.ts) for an item that is neither a string nor `{ label, id?, disabled? }`, or a frame time that is not a number of seconds from 0.',\n  },\n});\n6: * mapping by position (`PadSouth` is index 0: A on Xbox, Cross on PlayStation), and each stick has four direction codes\n28: * deviceOf('PadSouth'); // 'gamepad'\n31: * codeLabel('PadSouth', { pad: padStyle('DualSense Wireless Controller (STANDARD GAMEPAD Vendor: 054c)') }); // 'Cross'\n33: * codeLabel(holdCode('PadWest')); // 'Hold X': Apex's reload on a pad\n59:  'PadSouth',\n60:  'PadEast',\n61:  'PadWest',\n62:  'PadNorth',\n67:  'PadSelect',\n68:  'PadStart',\n103:/** The prefix of a held binding: `Hold:PadWest` is X kept down `HOLD_TIME` (see the file comment). */\n109:/** The held binding of `code`: `holdCode('PadWest')` is `Hold:PadWest`. */\n114:/** The code a held binding waits on (`Hold:PadWest` → `PadWest`), or null for any other code. */\nengine/input/codes.ts:189:export function codeLabel(code: string, options: LabelOptions = {}): string {\nengine/input/codes.ts-190-  const base = heldBase(code);\nengine/input/codes.ts-191-  if (base !== null) return `Hold ${codeLabel(base, options)}`;\nengine/input/codes.ts-192-  const button = PAD_BUTTONS.indexOf(code as (typeof PAD_BUTTONS)[number]);\nengine/input/codes.ts-193-  if (button >= 0) return PAD_LABELS[options.pad ?? 'xbox'][button];\nengine/input/codes.ts-194-  const stick = /^Pad(Left|Right)Stick(Up|Down|Left|Right)$/.exec(code);\nengine/input/codes.ts-195-  if (stick) return `${stick[1][0]} Stick ${stick[2]}`;\nengine/input/codes.ts-196-  const typed = options.layout?.get(code);\nengine/input/codes.ts-197-  if (typed && typed.trim()) return typed.length === 1 ? typed.toUpperCase() : typed;\nengine/input/codes.ts-198-  return NAMED[code] ?? code.replace(/^(Key|Digit|Arrow)/, '').replace(/^Numpad/, 'Num ');\nengine/input/codes.ts-199-}\nengine/input/codes.ts-200-\nengine/input/codes.ts-201-/** The page's keyboard layout (`navigator.keyboard.getLayoutMap()`, Chromium), or undefined where it is missing. */\nengine/input/codes.ts-202-export async function readKeyboardLayout(): Promise<ReadonlyMap<string, string> | undefined> {\nengine/input/codes.ts-203-  const keyboard = (globalThis.navigator as { keyboard?: { getLayoutMap?(): Promise<Map<string, string>> } })?.keyboard;\nengine/input/codes.ts-204-  try {\nengine/input/codes.ts-205-    return await keyboard?.getLayoutMap?.();\nengine/input/codes.ts-206-  } catch {\nengine/input/codes.ts-207-    return undefined; // a page in a frame may not read it: names from the code\nengine/input/codes.ts-208-  }\nengine/input/codes.ts-209-}\n/**\n * @file Sites (PLAN.md WP 13.15; docs/PLAYGROUND.md §6.3): a scene's levels standing on its terrain. `defineSite(id, {\n * terrain, structures })` registers one (the registry kind `site`) and `getSite(id)` makes it (`makeSite`): each\n * structure a level placed with its map's north-west corner at `at` (its storey on 0 standing at `at`'s height) and\n * turned `turn` quarter turns about +Y (counter-clockwise from above: east to north). The terrain is flattened round\n * each footprint to that height (`flatten` metres of margin), and cut where a structure has a floor of its own on or\n * under it (the floored tiles of its ground floor and of a storey below it, a basement; a one-storey level's whole map)\n * and the rectangles it names in `cuts` (window wells), so the cutaway can show what is below, nobody walks on ground\n * over a basement, and no ground shows through a floor at its height (WP 13.18). A cell is cut when such floors cover it\n * whole, so stand a structure's floors on whole cells of the terrain: the cut is exact there.\n *\n * Queries over all of it, in world metres (engine/world/siteQueries.ts): the highest surface under a point, its tag,\n * the structure, storey and room a point is in, whether a point is in a solid, and a clear sight line. `toLocal` and\n * `toWorld` carry points between a structure's frame and the world exactly (a quarter turn swaps and negates, so no\n * trigonometry), and `quarterTurn` is the rotation bodies and meshes take.\n *\n * Invariants: pure: equal specs give equal sites in Node and Chromium; a structure keeps its level's own data, in its\n * own frame; the terrain's cut is a flag per cell (`cut`), 1 where nothing of the terrain stands.\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * import { defineLevel } from './level/level';\n * const reg = createRegistry();\n * defineLevel('level:hut', { text: '#####\\n#...#\\n#####\\n', file: 'hut.txt' }, reg);\n * defineSite('site:yard', { structures: [{ level: 'level:hut', at: [10, 0, 4], turn: 1 }] }, reg);\n * const [hut] = getSite('site:yard', reg).structures;\n * [hut.footprint, toWorld(hut, 1, 0), toLocal(hut, 10, 3)]; // [[10, -1, 13, 4], [10, 3], [1, 0]]: turned, east is north\n * @see engine/world/site.test.ts\n */\nimport { codeError } from '../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../core/registry';\nimport type { Sch