get; document?: InputOptions['document'] & { body?: EventTarget } };\n154-  const win = options.window ?? scope.window;\n155-  const doc = options.document ?? scope.document;\n156-  const element = options.element ?? scope.document?.body;\n157-  const nav = (globalThis as { navigator?: { getGamepads?(): readonly unknown[] } }).navigator;\n158-  const source = options.gamepads ?? (() => (nav?.getGamepads?.() ?? []) as ReturnType<GamepadSource>);\n159-  const down = new Set<string>();\n160-  const taps = new Set<string>();\n161-  const values = new Map<string, number>();\n162-  let last: DeviceKind = 'keyboard';\n163-  let heldNow = new Set<string>();\n164-  let pressedNow = new Set<string>();\n165-  let strengths = new Map<string, number>();\n166-  let listening: { family: 'keyboard' | 'gamepad'; resolve: (code: string | null) => void } | null = null;\n167-  let table = { of: bindings, version: -1, codes: new Map<string, readonly string[]>(), bound: new Set<string>(), holds: new Set<string>() }; // prettier-ignore\n168-\n169-  const codesOf = (action: string): readonly string[] => {\n170-    if (table.of !== bindings || table.version !== bindings.version) {\n171-      const codes = new Map<string, readonly string[]>();\n172-      for (const [name, own] of Object.entries(SYSTEM_ACTIONS)) codes.set(name, [...own, touchCode(name)]);\n173-      for (const name of bindings.actions()) codes.set(name, [...bindings.codes(name), touchCode(name)]);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_016f7V5qdMPjZehDvwWdNbch","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9T1jJt9ahFpYSrnugV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LCTDz1dPsbdkCpLg7USPGx","name":"Bash","input":{"command":"sed -n 1,60p engine/sim/session.ts; grep -n \"help\\b\\|members\\|step:\" engine/dev/inspector.ts | head -40; sed -n 1,70p engine/dev/inspector.ts","description":"Read the sim session and the inspector members"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14451,"cache_read_input_tokens":203188,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14451},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"f6ab2c95-2157-49eb-82bb-ed9616b9908b","timestamp":"2026-11-05T04:26:50.407Z","request_id":"req_011Cgj9T1VS6X52AncUx8Si1","wire_tool_inputs":{"toolu_01LCTDz1dPsbdkCpLg7USPGx":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work/.research/my-3dge && sed -n 1,60p engine/sim/session.ts; grep -n \"help\\b\\|members\\|step:\" engine/dev/inspector.ts | head -40; sed -n 1,70p engine/dev/inspector.ts","description":"Read the sim session and the inspector members"}},"wire_ingest_context":{"toolu_01LCTDz1dPsbdkCpLg7USPGx":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211932__xd07c4f/work/.research/my-3dge"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LCTDz1dPsbdkCpLg7USPGx","type":"tool_result","content":"/**\n * @file Sessions (PLAN.md §8.4, WP 1.5; doctrines: Reproducible, Agent-operable): `createSession(scene, options)`\n * starts a scene (engine/sim/scene.ts `startScene`) that records its inputs from step 0, the recorder of PLAN.md §8.4.\n * The kernel fixture, the box's scenes and `createHeadless` (WP 1.6) all record through it; engine/sim/replay.ts plays\n * what it records.\n *\n * A session logs, each at the step it happens (merged in play order: set, then dev, then intents), what its intents\n * change (a step the world does not count logs nothing), every non-view setting change (through `set` or its own store,\n * `session.settings`), and its dev actions (`act`: the scene's own, else the engine's, engine/sim/devActions.ts; all or\n * nothing: one that throws is rolled back; an unknown one is `SIM_NO_ACTION`). `record()` returns the replay from step\n * 0; change-points no step has followed yet wait for it.\n * Step, capture and restore through the session, never the world (`SIM_OFF_RECORD`): `session.restore` takes the\n * recording back to the capture's step with the sim, so `record()` replays the run as it stands; it refuses a capture\n * it did not take (`SIM_FOREIGN_CAPTURE`) or one changed since (`SIM_EDITED_CAPTURE`). `Session` says the rest.\n *\n * Invariants: the recording is plain data, from step 0, and replays to the same hashes (engine/sim/replay.ts); view\n * settings are never recorded. Split from scene.ts to keep each under 400 lines (ADR-0014 amendment 16).\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * import { defineScene } from './scene';\n * const reg = createRegistry();\n * defineScene('demo', { description: 'Spawns one.', setup: (w) => w.spawn() }, reg);\n * const live = createSession('demo', { registry: reg });\n * live.step({ move: [0, 1] });\n * live.step({ move: [0, 1], b: ['jump'] });\n * live.record().inputs; // [[0, { move: [0, 1] }], [1, { b: ['jump'] }]]\n * @see engine/sim/scene.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { deserialize, hashValue, serialize, type Canonical } from '../core/hash';\nimport { codeError, defineCodes, didYouMean } from '../core/log';\nimport { registry as sharedRegistry, sameValue } from '../core/registry';\nimport { show } from '../core/schema';\nimport type { SettingChange, SettingValue } from '../core/settings';\nimport { diffIntents, INTENT_KEYS, NO_INTENTS, normalizeIntents, type Intents } from '../input/intents';\nimport type { WorldCapture } from './capture';\nimport type { InputChange, InputEntry, Replay } from './replay';\nimport { changesSim, devArgs, findDevAction, listDevActions } from './devActions';\nimport { checkSeed, startScene, type SceneOptions, type SceneRun } from './scene';\nimport type { AnyComponents } from './state';\n\n/** The codes this module raises, with their fixes. */\nexport const SESSION_CODES = defineCodes('sim', {\n  SIM_NO_ACTION: {\n    template: 'the scene {scene} has no dev action {name} ({suggestion})',\n    fix: \"add it to the scene, defineScene('{scene}', { actions: { {name}(w, args) { … } } }), or to the engine's, defineDevAction('{name}', { help, run }) (engine/sim/devActions.ts); or call one there is\",\n  },\n  SIM_OFF_RECORD: {\n    template: 'the world took {count} steps outside its session, so the recording misses their intents',\n    fix: 'step a recorded scene through session.step(intents), never world.step(); capture and restore it through session.capture() and session.restore(capture), never the world',\n  },\n  SIM_FOREIGN_CAPTURE: {\n    template: 'restore() was given a capture the session of {scene} did not take',\n    fix: \"restore what this session's capture() (__engine.capture()) returned, the object itself: the session knows where its recording stood then; the world's own captures, another session's and copies have no place in it, so reach other state by starting the scene again (__engine.seed(n)) or playing a replay\",\n  },\n  SIM_EDITED_CAPTURE: {\n    template: 'the capture the session of {scene} took at step {step} was changed since (it hashes {now}, not {then})',\n    fix: 'restore it unchanged, then make the change through the session so record() replays it: session.set(path, value) (__engine.set) for a setting, a dev action (session.act(name, args)) for components',\n  },\n4: * registry kind `inspectorMember` (engine/dev/members.ts). Later WPs add members from their own files; this module\n11: * `DEV_NO_RENDERER` on a host without one, as `createHeadless` is. The core members map onto the kernel: `describe`\n17: * starts the scene again. Every member that changes the sim goes through the session (engine/dev/members.ts).\n19: * Invariants: the object holds its members and nothing else, so `help()` lists exactly what it has (`x docs --check`\n21: * missing, extra or renamed. Members are read from `host.members` when the inspector is made: register before.\n26: * import { defineMember, type InspectorHost } from './members';\n27: * const members = createRegistry();\n29: * defineMember('ping', { help: 'Answers pong.', args: { times }, impl: (_h, n: number) => 'pong'.repeat(n) }, members);\n30: * const engine = createInspector({ members } as unknown as InspectorHost);\n49:} from './members';\n59:    fix: 'call it as {signature}; __engine.help({name}) lists its arguments',\n86:/** The inspector, `window.__engine` in a page and what `createHeadless` returns: `help()` lists every member. */\n103:  help(member?: string): string;\n106:  /** The members later WPs register (`input`, `stats`, `scene.dump`…). */\n137:/** Assembles `__engine` on `host` from the members registered on `host.members` (see the file comment). */\n139:  memberKind(host.members);\n141:  for (const member of host.members.list('inspectorMember') as Member[]) {\n172:/** The core members' table, one spec per member the `Inspector` interface names: tsc refuses one missing or extra. */\n175:/** The core members (PLAN.md §8.3, WP 1.6), registered on the shared registry when this module loads. */\n178:    help: \"The engine's identity and health (version, runtime, adapter, features, downgrades, deps) and the run: scene, seed, tick, hz.\",\n194:    help: 'Pauses sim time (the time.paused setting); step(n) still runs single steps.',\n197:  resume: { help: 'Resumes sim time.', impl: (h) => h.clock.resume() },\n198:  step: {\n199:    help: 'Runs n sim steps through the clock, recorded in the session (without intents, what the virtual device holds: input.hold, input.axis…); returns the tick after them.',\n214:    help: 'Sets sim seconds per real second (the time.scale setting) when k is given; returns it.',\n222:    help: \"Starts the scene again with seed n (keeping the settings changed since it started) when n is given; returns the run's seed.\",\n232:    help: 'The sim as plain data, what the hash covers, with the entities the query matches.',\n240:  hash: { help: 'The state digest: 16 hex digits.', impl: (h) => h.session.world.hash() },\n242:    help: 'Per-part and per-entity digests, to find where two runs part.',\n246:    help: 'The live entities the query matches, in id order: each id and the components it holds.',\n255:    help: 'One live entity as plain data, components included; null when it does not live.',\n263:    help: 'Sets a setting, validated against its schema (text is typed as x set types it); returns the change.',\n277:  capture: { help: 'The whole sim, copied, to restore later in this run.', impl: (h) => h.session.capture() },\n279:    help: 'Puts back a capture this run took, unchanged, with the recording as it stood then: the next steps continue exactly like the run it came from, and record() replays them.',\n284:    help: 'The registries, as x describe lists them: every kind, one kind with its fields and ids, or one entry.',\n294:  help: {\n295:    help: 'Every member, one line each; with a name, that member and its arguments.',\n297:    impl: (h, member: string | undefined) => helpText(h.members, member),\n300:    help: 'The structured error records, latest last.',\n305:    help: 'The advice records (warn-once, each with its code), latest last.',\n/**\n * @file The inspector (PLAN.md §8.3, WP 1.6; doctrines: Agent-operable, Verifiable): `window.__engine` in a page and\n * the object `createHeadless` returns in Node are one API, which `createInspector` assembles from the entries of the\n * registry kind `inspectorMember` (engine/dev/members.ts). Later WPs add members from their own files; this module\n * registers the core ones and never names another.\n *\n * A member is a call (`step(n, intents)`) or, with `value: true`, a property read without one (`errors`); a dotted\n * name (`scene.dump`) is a call on a namespace object. A call checks its arguments against the member's schema\n * (`DEV_BAD_ARGS` naming each problem and the signature, before anything happens), then runs `impl(host, ...args)`\n * with the arguments as given (absent ones as their default). A member that `needs: 'renderer'` throws\n * `DEV_NO_RENDERER` on a host without one, as `createHeadless` is. The core members map onto the kernel: `describe`\n * → the registry; `set` → the settings store through the session (text typed as `x set` types it, non-view changes\n * recorded); `errors` and `advice` → the log; `pause`, `resume`, `step` and `timeScale` → the clock (steps recorded\n * in the session); `capture` and `restore` → the session (a restore takes the recording back with the sim, and\n * refuses a capture this run did not take or one changed since: engine/sim/scene.ts); `state`, `hash`, `trace`,\n * `entities` and `get` → the world, read-only (a query names an undeclared component with the closest); `seed(n)`\n * starts the scene again. Every member that changes the sim goes through the session (engine/dev/members.ts).\n *\n * Invariants: the object holds its members and nothing else, so `help()` lists exactly what it has (`x docs --check`\n * compares them, tools/lib/docsHelp.ts), and the core table is typed against `Inspector`, so tsc refuses a core member\n * missing, extra or renamed. Members are read from `host.members` when the inspector is made: register before.\n * Results are plain data, copied (a capture is the session's own object, so it restores in place).\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * import { defineMember, type InspectorHost } from './members';\n * const members = createRegistry();\n * const times = { type: 'integer', default: 1, minimum: 1, description: 'How often.' } as const;\n * defineMember('ping', { help: 'Answers pong.', args: { times }, impl: (_h, n: number) => 'pong'.repeat(n) }, members);\n * const engine = createInspector({ members } as unknown as InspectorHost);\n * (engine.ping as (n?: number) => string)(2); // 'pongpong'; ping(0) throws DEV_BAD_ARGS\n * @see engine/dev/inspector.test.ts\n */\nimport pkg from '../../package.json' with { type: 'json' };\nimport { codeError, defineCodes, type AdviceRecord, type ErrorRecord } from '../core/log';\nimport { checkValue, copyValue, listProblems, show, type Problem } from '../core/schema';\nimport { createSettings, type SettingChange } from '../core/settings';\nimport type { Intents } from '../input/intents';\nimport type { WorldCapture } from '../sim/capture';\nimport type { EntityData, WorldState, WorldTrace } from '../sim/state';\nimport {\n  defineMember,\n  helpText,\n  memberKind,\n  signatureOf,\n  type InspectorHost,\n  type Member,\n  type MemberSpec,\n} from './members';\n\n/** The codes this module raises, with their fixes. */\nexport const INSPECTOR_CODES = defineCodes('dev', {\n  DEV_NO_RENDERER: {\n    template: '__engine.{member} needs a renderer, and this engine has none ({runtime}, headless)',\n    fix: 'call it in a page started with createEngine (WP 2.7); headless, read state(), entities(), get(id) and hash() instead',\n  },\n  DEV_BAD_ARGS: {\n    template: '__engine.{member}: {problems}',\n    fix: 'call it as {signature}; __engine.help({name}) lists its arguments',\n    doc: 'Raised by every `__engine` member (engine/dev/inspector.ts) before it runs, when an argument does not match the schema its member declares: a wrong type, a value out of range, a missing required argument or one too many. Nothing has happened yet.',\n  },\n});\n\n/** What `info()` reports: the engine's identity and health, and the run. */\nexport interface EngineInfo {\n  version: string;\n  runtime: string;\n  headless: boolean;\n  adapter: Readonly<Record<string, unknown>> | null;\n  features: string[];","is_error":false}]},"parent_tool_use_id":null,"session_id":"5c3db9ff-22de-4370-a6c8-816de35b9215","uuid":"16a03c93-dd63-46aa-b54d-4f42be36085a","timestamp":"2026-11-05T04:26:50.536Z","tool_use_result":{"stdout":"/**\n * @file Sessions (PLAN.md §8.4, WP 1.5; doctrines: Reproducible, Agent-operable): `createSession(scene, options)`\n * starts a scene (engine/sim/scene.ts `startScene`) that records its inputs from step 0, the recorder of PLAN.md §8.4.\n * The kernel fixture, the box's scenes and `createHeadless` (WP 1.6) all record through it; engine/sim/replay.ts plays\n * what it records.\n *\n * A session logs, each at the step it happens (merged in play order: set, then dev, then intents), what its intents\n * change (a step the world does not count logs nothing), every non-view setting change (through `set` or its own store,\n * `session.settings`), and its dev actions (`act`: the scene's own, else the engine's, engine/sim/devActions.ts; all or\n * nothing: one that throws is rolled back; an unknown one is `SIM_NO_ACTION`). `record()` returns the replay from step\n * 0; change-points no step has followed yet wait for it.\n * Step, capture and restore through the session, never the world (`SIM_OFF_RECORD`): `session.restore` takes the\n * recording back to the capture's step with the sim, so `record()` replays the run as it stands; it refuses a capture\n * it did not take (`SIM_FOREIGN_CAPTURE`) or one changed since (`SIM_EDITED_CAPTURE`). `Session` says the rest.\n *\n * Invariants: the recording is plain data, from step 0, and replays to the same hashes (engine/sim/replay.ts); view\n * settings are never recorded. Split from scene.ts to keep each under 400 lines (ADR-0014 amendment 16).\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * import { defineScene } from './scene';\n * const reg = createRegistry();\n * defineScene('demo', { description: 'Spawns one.', setup: (w) => w.spawn() }, reg);\n * const live = createSession('demo', { registry: reg });\n * live.step({ move: [0, 1] });\n * live.step({ move: [0, 1], b: ['jump'] });\n * live.record().inputs; // [[0, { move: [0, 1] }], [1, { b: ['jump'] }]]\n * @see engine/sim/scene.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { deserialize, hashValue, serialize, type Canonical } from '../core/hash';\nimport { codeError, defineCodes, didYouMean } from '../core/log';\nimport { registry as sharedRegistry, sameValue } from '../core/registry';\nimport { show } from '../core/schema';\nimport type { SettingChange, SettingValue } from '../core/settings';\nimport { diffIntents, INTENT_KEYS, NO_INTENTS, normalizeIntents, type Intents } from '../input/intents';\nimport type { WorldCapture } from './capture';\nimport type { InputChange, InputEntry, Replay } from './replay';\nimport { changesSim, devArgs, findDevAction, listDevActions } from './devActions';\nimport { checkSeed, startScene, type SceneOptions, type SceneRun } from './scene';\nimport type { AnyComponents } from './state';\n\n/** The codes this module raises, with their fixes. */\nexport const SESSION_CODES = defineCodes('sim', {\n  SIM_NO_ACTION: {\n    template: 'the scene {scene} has no dev action {name} ({suggestion})',\n    fix: \"add it to the scene, defineScene('{scene}', { actions: { {name}(w, args) { … } } }), or to the engine's, defineDevAction('{name}', { help, run }) (engine/sim/devActions.ts); or call one there is\",\n  },\n  SIM_OFF_RECORD: {\n    template: 'the world took {count} steps outside its session, so the recording misses their intents',\n    fix: 'step a recorded scene through session.step(intents), never world.step(); capture and restore it through session.capture() and session.restore(capture), never the world',\n  },\n  SIM_FOREIGN_CAPTURE: {\n    template: 'restore() was given a capture the session of {scene} did not take',\n    fix: \"restore what this session's capture() (__engine.capture()) returned, the object itself: the session knows where its recording stood then; the world's own captures, another session's and copies have no place in it, so reach other state by starting the scene again (__engine.seed(n)) or playing a replay\",\n  },\n  SIM_EDITED_CAPTURE: {\n    template: 'the capture the session of {scene} took at step {step} was changed since (it hashes {now}, not {then})',\n    fix: 'restore it unchanged, then make the change through the session so record() replays it: session.set(path, value) (__engine.set) for a setting, a dev action (session.act(name, args)) for components',\n  },\n4: * registry kind `inspectorMember` (engine/dev/members.ts). Later WPs add members from their own files; this module\n11: * `DEV_NO_RENDERER` on a host without one, as `createHeadless` is. The core members map onto the kernel: `describe`\n17: * starts the scene again. Every member that changes the sim goes through the session (engine/dev/members.ts).\n19: * Invariants: the object holds its members and nothing else, so `help()` lists exactly what it has (`x docs --check`\n21: * missing, extra or renamed. Members are read from `host.members` when the inspector is made: register before.\n26: * import { defineMember, type InspectorHost } from './members';\n27: * const members = createRegistry();\n29: * defineMember('ping', { help: 'Answers pong.', args: { times }, impl: (_h, n: number) => 'pong'.repeat(n) }, members);\n30: * const engine = createInspector({ members } as unknown as InspectorHost);\n49:} from './members';\n59:    fix: 'call it as {signature}; __engine.help({name}) lists its arguments',\n86:/** The inspector, `window.__engine` in a page and what `createHeadless` returns: `help()` lists every member. */\n103:  help(member?: string): string;\n106:  /** The members later WPs register (`input`, `stats`, `scene.dump`…). */\n137:/** Assembles `__engine` on `host` from the members registered on `host.members` (see the file comment). */\n139:  memberKind(host.members);\n141:  for (const member of host.members.list('inspectorMember') as Member[]) {\n172:/** The core members' table, one spec per member the `Inspector` interface names: tsc refuses one missing or extra. */\n175:/** The core members (PLAN.md §8.3, WP 1.6), registered on the shared registry when this module loads. */\n178:    help: \"The engine's identity and health (version, runtime, adapter, features, downgrades, deps) and the run: scene, seed, tick, hz.\",\n194:    help: 'Pauses sim time (the time.paused setting); step(n) still runs single steps.',\n197:  resume: { help: 'Resumes sim time.', impl: (h) => h.clock.resume() },\n198:  step: {\n199:    help: 'Runs n sim steps through the clock, recorded in the session (without intents, what the virtual device holds: input.hold, input.axis…); returns the tick after them.',\n214:    help: 'Sets sim seconds per real second (the time.scale setting) when k is given; returns it.',\n222:    help: \"Starts the scene again with seed n (keeping the settings changed since it started) when n is given; returns the run's seed.\",\n232:    help: 'The sim as plain data, what the hash covers, with the entities the query matches.',\n240:  hash: { help: 'The state digest: 16 hex digits.', impl: (h) => h.session.world.hash() },\n242:    help: 'Per-part and per-entity digests, to find where two runs part.',\n246:    help: 'The live entities the query matches, in id order: each id and the components it holds.',\n255:    help: 'One live entity as plain data, components included; null when it does not live.',\n263:    help: 'Sets a setting, validated against its schema (text is typed as x set types it); returns the change.',\n277:  capture: { help: 'The whole sim, copied, to restore later in this run.', impl: (h) => h.session.capture() },\n279:    help: 'Puts back a capture this run took, unchanged, with the recording as it stood then: the next steps continue exactly like the run it came from, and record() replays them.',\n284:    help: 'The registries, as x describe lists them: every kind, one kind with its fields and ids, or one entry.',\n294:  help: {\n295:    help: 'Every member, one line each; with a name, that member and its arguments.',\n297:    impl: (h, member: string | undefined) => helpText(h.members, member),\n300:    help: 'The structured error records, latest last.',\n305:    help: 'The advice records (warn-once, each with its code), latest last.',\n/**\n * @file The inspector (PLAN.md §8.3, WP 1.6; doctrines: Agent-operable, Verifiable): `window.__engine` in a page and\n * the object `createHeadless` returns in Node are one API, which `createInspector` assembles from the entries of the\n * registry kind `inspectorMember` (engine/dev/members.ts). Later WPs add members from their own files; this module\n * registers the core ones and never names another.\n *\n * A member is a call (`step(n, intents)`) or, with `value: true`, a property read without one (`errors`); a dotted\n * name (`scene.dump`) is a call on a namespace object. A call checks its arguments against the member's schema\n * (`DEV_BAD_ARGS` naming each problem and the signature, before anything happens), then runs `impl(host, ...args)`\n * with the arguments as given (absent ones as their default). A member that `needs: 'renderer'` throws\n * `DEV_NO_RENDERER` on a host without one, as `createHeadless` is. The core members map onto the kernel: `describe`\n * → the registry; `set` → the settings store through the session (text typed as `x set` types it, non-view changes\n * recorded); `errors` and `advice` → the log; `pause`, `resume`, `step` and `timeScale` → the clock (steps recorded\n * in the session); `capture` and `restore` → the session (a restore takes the recording back with the sim, and\n * refuses a capture this run did not take or one changed since: engine/sim/scene.ts); `state`, `hash`, `trace`,\n * `entities` and `get` → the world, read-only (a query names an undeclared component with the closest); `seed(n)`\n * starts the scene again. Every member that changes the sim goes through the session (engine/dev/members.ts).\n *\n * Invariants: the object holds its members and nothing else, so `help()` lists exactly what it has (`x docs --check`\n * compares them, tools/lib/docsHelp.ts), and the core table is typed against `Inspector`, so tsc refuses a core member\n * missing, extra or renamed. Members are read from `host.members` when the inspector is made: register before.\n * Results are plain data, copied (a capture is the session's own object, so it restores in place).\n *\n * @example\n * import { createRegistry } from '../core/registry';\n * import { defineMember, type InspectorHost } from './members';\n * const members = createRegistry();\n * const times = { type: 'integer', default: 1, minimum: 1, description: 'How often.' } as const;\n * defineMember('ping', { help: 'Answers pong.', args: { times }, impl: (_h, n: number) => 'pong'.repeat(n) }, members);\n * const engine = createInspector({ members } as unknown as InspectorHost);\n * (engine.ping as (n?: number) => string)(2); // 'pongpong'; ping(0) throws DEV_BAD_ARGS\n * @see engine/dev/inspector.test.ts\n */\nimport pkg from '../../package.json' with { type: 'json' };\nimport { codeError, defineCodes, type AdviceRecord, type ErrorRecord } from '../core/log';\nimport { checkValue, copyValue, listProblems, show, type Problem } from '../core/schema';\nimport { createSettings, type SettingChange } from '../core/settings';\nimport type { Intents } from '../input/intents';\nimport type { WorldCapture } from '../sim/capture';\nimport type { EntityData, WorldState, WorldTrace } from '../sim/state';\nimport {\n  defineMember,\n  helpText,\n  memberKind,\n  signatureOf,\n  type InspectorHost,\n  type Member,\n  type MemberSpec,\n} from './members';\n\n/** The codes this module raises, with their fixes. */\nexport const INSPECTOR_CODES = defineCodes('dev', {\n  DEV_NO_RENDERER: {\n    template: '__engine.{member} needs a renderer, and this engine has none ({runtime}, headless)',\n    fix: 'call it in a page started with createEngine (WP 2.7); headless, read state(), entities(), get(id) and hash() instead',\n  },\n  DEV_BAD_ARGS: {\n    template: '__engine.{member}: {problems}',\n    fix: 'call it as {signature}; __engine.help({name}) lists its arguments',\n    doc: 'Raised by every `__engine` member (engine/dev/inspector.ts) before it runs, when an argument does not match the schema its member declares: a wrong type, a value out of range, a missing required argument or one too many. Nothing has happened yet.',\n  },\n});\n\n/** What `info()` reports: the engine's identity and health, and the run. */\nexport interface EngineInfo {\n  version: string;\n  runtime: string;\n  headless: boolean;\n  adapter: Readonly<Record<string, unknown>> | null;\n  features: string[];","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01LCTDz1dPsbdkCpLg7USPGx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
