ype === 'trophy') {\\n    const tr = LIVE.find(a => a.trophy && !a.dead && !a.gone);\\n    if (HUNT_RUN.clock > 4 && !tr) HUNT_RUN.trophyDone = true;\\n  }\"),\n(\"  return { ok: true, hit: false, x: ax, y: ay };\", \"  return { ok: true, hit: false, x: ax, y: ay };\"),\n(\"const I_label_cache = null;\", \"\"),\n(\"let I_label_cache = null;\\nfunction I_label(a) { return E.__game ? E.__game.input.label(a) : a; }\",\n \"function I_label(a) { return GAME ? GAME.input.label(a) : a; }\"),\n(\"    const sp = HUNT_RUN.hunt.trophy === 'buck' ? 'buck' : HUNT_RUN.hunt.trophy === 'elk' ? 'elk' : 'moose';\",\n \"    const sp = HUNT_RUN.hunt.trophy;\"),\n(\"  E.px.blend(g, .85, 'add', () => paintAnimal(g, W, H, { ...ghost, x: (sx) / W, fy: sy / H, hn: h / H, dir: 1 }, t));\",\n \"  paintAnimal(g, W, H, { ...ghost, x: sx / W, fy: sy / H, hn: h / H, dir: 1 }, t);\"),\n(\"function huntCard(seg) {\", \"function huntCard(seg) {\"),\n])\nedit('60-audio.js', [\n(\"    setTimeout_ = null;\\n    GAME.audio.sfx({ wave: v.wave, freq: f, to: f * (RNG.fx() < .5 ? 1.3 : .75), dur: .07 + RNG.fx() * .03, vol: .09, step: 0 });\",\n \"    GAME.audio.sfx({ wave: v.wave, freq: f, to: f * (RNG.fx() < .5 ? 1.3 : .75), dur: .07 + RNG.fx() * .03, vol: .09 });\"),\n(\"const SONG_OF = { title: SONGS.title, hunt: SONGS.hunt, bonus: SONGS.bonus, results: SONGS.results };\\n\", \"\"),\n])\nedit('50-ui.js', [\n(\"  enter() { GAME.input.touchEnabled = !TOUCH_ONLY; IDLE.t = 0; GAME.audio.music(SONGS.title); },\",\n \"  enter() { GAME.input.touchEnabled = !TOUCH_ONLY; IDLE.t = 0; HUNT_RUN.active = false; HUNT_RUN.bot = false; GAME.audio.music(SONGS.title); },\"),\n])\nedit('99-start.js', [\n(\"    quit: AIHub.active ? false : 'title',\", \"    quit: HUB_ACTIVE ? false : 'title',\"),\n(\"    this.pausable = !(HUNT_RUN.bot || (typeof AIHub !== 'undefined' && AIHub.active));\", \"    this.pausable = !(HUNT_RUN.bot || HUB_ACTIVE);\"),\n(\"    if (HUB.info && HUNT_RUN.mode === 'hub' && HUNT_RUN.hubOver) return;\\n\