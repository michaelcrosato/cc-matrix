    else if (this.staminaMax && this.onGround) { this.stamina = Math.min(this.staminaMax, this.stamina + this.staminaRegen * dt); if (this.stamina >= this.staminaMax / 3) this.exhausted = false; }\n    // coyote time and a buffered jump: parkour first (a ledge, a wall to vault, a gap), else an ordinary jump\n    this._coy = this.onGround ? this.coyote : Math.max(0, this._coy - dt);\n    if (this._jb > 0 && (this.onGround || this._coy > 0) && map) {\n      this._jb = 0; this._coy = 0;   // (one jump a press: a leap or a climb ends coyote time too)","stderr":"\nShell cwd was reset to /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181307__x22cc1b/work","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01GX8dmTA683yN5tCsatq1MM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
