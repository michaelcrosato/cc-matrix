 04-office.js ----"," // ============================================================================================================","-// REWIRED · 04 inside: the detail's office and its case board (TAPE TWO), the wire room's calls and pages","+// REWIRED • 04 inside: the detail's office and its case board (TAPE TWO), the wire room's calls and pages"," // (TAPE THREE), the stash house search (end of TAPE FOUR). Interiors are small TileMaps; the boards are canvas UI"," // sized for a TV: big cards, one focus, d-pad / stick / mouse hover / click all move it."," // ============================================================================================================"]},{"oldStart":1576,"oldLines":7,"newStart":1581,"newLines":7,"lines":["     px.rect(g, 0, 0, r.W, r.H, '#5a3a22');","     for (let y = 0; y < r.H; y += 2) for (let x = (y / 2) % 2; x < r.W; x += 3) if (E.hash2(x, y) > .7) px.dot(g, x, y, E.hash2(y, x) > .5 ? '#7a5232' : '#4a2e1a');","     px.rect(g, 0, 0, r.W, 4, '#2a1a10'); px.rect(g, 0, r.H - 4, r.W, 4, '#2a1a10');","-    E.font.text(g, 'THE BOARD  ·  PROBABLE CAUSE', 10, 8, '#f0e0c0', { shadow: '#000', outline: false });","+    E.font.text(g, 'THE BOARD  •  PROBABLE CAUSE', 10, 8, '#f0e0c0', { shadow: '#000', outline: false });","     E.ui.bar(g, 10, 19, 140, 6, Math.min(1, CASE.pc / 100), CASE.pc >= PC_NEED ? '#60d070' : '#e0a040');","     px.rect(g, 10 + Math.round(140 * PC_NEED / 100), 17, 1, 10, '#f0f0f0');","     E.font.text(g, Math.round(CASE.pc) + ' / ' + PC_NEED + ' to see a judge', 156, 19, '#f0e0c0', { font: 'tiny', outline: false });"]},{"oldStart":1645,"oldLines":7,"newStart":1650,"newLines":7,"lines":["     toastTick(dt);","     if (OF.demo) { if (demoInputBreak()) return; boardDemoTick(dt); return; }","     if (notesTick()) return;","-    if (BOARD.open) { boardTick(dt, game.r || { W: game.W, H: game.H }); return; }","+    if (BOARD.open) { boardTick(dt, RW()); return; }","     if (talkTick(dt)) { OF.rig.update(dt, OF.me.rigState({