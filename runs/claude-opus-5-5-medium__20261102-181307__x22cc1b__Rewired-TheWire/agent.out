= D.P1(); D.teleport(BS.x, BS.y + 10);\nfor (let i = 0; i < 400; i++) {\n  if (ST.sale && ST.sale.phase === 'pay' && !ST.sale.shot.pay) { const J = ST.npcs.junebug, F = ST.sale.fiend; I.hold('aim'); game.advance(.05); p.rx = (J.x + F.x) / 2; p.ry = (J.y + F.y) / 2; game.advance(.05); p.rx = (J.x + F.x) / 2; p.ry = (J.y + F.y) / 2; console.log('shoot', p.aim, D.inFrame(p, J), D.inFrame(p, F), p.film, Math.round(p.mover.x), Math.round(p.mover.y)); I.tap('shoot'); game.advance(.05); I.hold('aim', false); console.log('score', ST.score, ST.sale.shot.pay); }\n  game.advance(.1); }\n}\nEOF\nnode /tmp/x22cc1b-dbg3.mjs 2>&1 | sed -n '/with photos/,$p' | head","description":"Trace shift photo attempts"}}}
