 / p.mover.staminaMax, p.mover.exhausted ? '#ff6040' : '#7ad06a');","     if (ST.banner) { const b = ST.banner; E.font.title(g, b.text, r.W / 2, r.H / 2 - 30, { scale: 2, align: 'center', colors: b.colors || ['#ffffff', '#d8b860'] }); if (b.sub) E.font.text(g, b.sub, r.W / 2, r.H / 2 - 4, '#e8e4dc', { align: 'center', shadow: '#000', outline: false }); }","-    if (ST.players.length < 2 && ['shift', 'corner', 'reup'].includes(ST.mode) && !IN_HUB && ST.t < 12) E.font.text(g, 'Player 2: press Start on a second pad, or 2 on the keyboard', r.W - 8, r.H - 8, '#6a6a7a', { align: 'right', font: 'tiny', outline: false });","+    if (ST.players.length < 2 && ['shift', 'corner', 'reup'].includes(ST.mode) && !IN_HUB && ST.t < 12) E.font.text(g, 'PLAYER 2: START ON A SECOND PAD, OR 2 ON THE KEYBOARD', r.W - 8, (game.cornerArea && game.cornerArea() ? game.cornerArea().y1 + 4 : 8), '#8a8a9a', { align: 'right', font: 'tiny', outline: false, shadow: '#000' });","   });","   talk.draw(r);","   drawNotes(r);"]},{"oldStart":16596,"oldLines":7,"newStart":16601,"newLines":7,"lines":["   for (let i = 0; i < 2; i++) { const c = new Car(S.P(i ? 62 : 56, 33).x, S.P(56, 33).y, Math.PI, { shape: 'cruiser', lights: true, speed: 130 }); c.drive([{ x: S.houseDoor.x + (i ? 50 : 10), y: 33 * T }]); ST.cars.push(c); }","   A.sfx('siren');","   ST.squad = [];","-  for (let i = 0; i < 3; i++) { const a = new Actor('cop' + i, S.P(44, 35).x + i * 8, S.P(44, 35).y, { look: { build: 'heroic', weapon: 'gun', outfit: 'coat', hat: 'helmet', colors: { coat: '#1a2448', pants: '#1a1a2a', skin: ['#c89070', '#6a4430', '#e0b090'][i] } }, speed: 70 }); a.point = true; a.goTo(S.houseDoor.x - 10 + i * 10, S.houseDoor.y + 6); N['cop' + i] = a; }","+  for (let i = 0; i < 3; i++) { const a = new Actor('cop' + i, S.P(44, 35).x + i * 8, S.P(44, 35).y, { look: { build: 'heroic', weapon: 'gun', outfit: 'coat', hat: { style: 'helmet', color: '#1a1a22' }, colors: { coat: '#1a2448', cloth: '#2a2a34', pants: '#1a1a2a', metal: 