nshot(path=f'{OUT}/{n}.png'); print(n, snap())\",\"+        def keys(seq):\",\"+            for k, ms in seq:\",\"+                if k.startswith('hold:'): pg.keyboard.down(k[5:])\",\"+                elif k.startswith('up:'): pg.keyboard.up(k[3:])\",\"+                elif k == 'wait': pass\",\"+                else: pg.keyboard.press(k)\",\"+                pg.wait_for_timeout(ms)\",\"+        for step in plan:\",\"+            if step == 'title':\",\"+                pg.mouse.move(600, 400); pg.wait_for_timeout(500); shot('title')\",\"+            elif step.startswith('ch'):\",\"+                i = int(step[2:3]); beat = int(step[4:]) if len(step) > 4 else 0\",\"+                pg.evaluate(f'window.__bb.go(\\\"play\\\", {{ ch: {i}, beat: {beat} }})'); pg.wait_for_timeout(1500)\",\"+                shot(f'{step}-a')\",\"+                keys([('Enter', 400), ('Enter', 400), ('Enter', 400), ('hold:KeyD', 900), ('up:KeyD', 100), ('hold:KeyS', 700), ('up:KeyS', 300)])\",\"+                shot(f'{step}-b')\",\"+            elif step == 'attract':\",\"+                pg.evaluate('window.__bb.go(\\\"title\\\")'); pg.wait_for_timeout(11500); shot('attract-a'); pg.wait_for_timeout(6000); shot('attract-b')\",\"+                pg.keyboard.press('KeyX'); pg.wait_for_timeout(800); shot('attract-exit')\",\"+            elif step == 'cookoff':\",\"+                pg.evaluate('window.__bb.go(\\\"cookoff\\\", {})'); pg.wait_for_timeout(4500); shot('cookoff-a')\",\"+                keys([('hold:KeyA', 1200), ('up:KeyA', 100)]); shot('cookoff-b')\",\"+            elif step == 'lab': pg.evaluate('window.__bb.go(\\\"lab\\\", { next: 2 })'); pg.wait_for_timeout(800); shot('lab')\",\"+            elif step == 'over': pg.evaluate('window.__bb.go(\\\"over\\\", { reason: \\\"busted\\\", ch: 4, beat: 1 })'); pg.wait_for_timeout(800); shot('over')\",\"+            elif step == 'results': pg.evaluate('window.__bb.go(\\\"results\\\", { ch: 2, stats: { time: 312, kills: 0 } })'); pg.wai