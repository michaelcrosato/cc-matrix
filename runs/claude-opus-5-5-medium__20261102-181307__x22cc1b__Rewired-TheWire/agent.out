 { fade: 0 }); game.advance(3);\n  check('runs ' + scene + ' ' + JSON.stringify(data), !game.errors.length, errs());\n  game.errors.length = 0;\n}\ndone();\nEOF\nnode test/smoke.mjs 2>&1 | tail -30","description":"Run headless smoke test"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":449,"cache_read_input_tokens":265710,"cache_creation":{"ephemeral_5m_input_tokens":449,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"df8c1585-be07-48c4-a448-ca4232e59bdf","uuid":"a6cd697f-c77b-4f0a-b3ac-66aa7178f1ef","timestamp":"2026-11-03T01:38:45.424Z","request_id":"req_011Cgf96LekQHaksKhVR5Kr4","wire_tool_inputs":{"toolu_01VGzJGtwtAMaxXnxsGgrB8q":{"command":"cat > test/harness.mjs <<'EOF'\n// Loads the engine and the built game in a Node VM, headless (no DOM): the engine's fixed-step clock drives it.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\nexport function load() {\n  const ctx = { console, setTimeout, clearTimeout };\n  vm.createContext(ctx);\n  for (const f of ['../vendor/my-3d2dge.js', '../build/game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\n  const E = ctx.My3D2dge, game = E.current;\n  return { E, game, I: game.input, D: game.debug, snap: () => game.debug.snapshot() };\n}\nexport function checker() {\n  let failed = 0, passed = 0;\n  const check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; else passed++; };\n  return { check, done: () => { console.log(`${passed} passed, ${failed} failed`); process.exit(failed ? 1 : 0); } };\n}\nEOF\ncat > test/smoke.mjs <<'EOF'\nimport { load, checker } from './harness.mjs';\nconst { game, I, snap } = load(); const { check, done } = checker();\nconst errs = () => game.errors.map(e => (e.message || e) + '').join(' | ');\ngame.advance(1);\ncheck('boots to the title', snap().scene === 'title', JSON.stringify(snap()) + errs());\nfor (const [scene, data] of [['street', { mode: 'coldopen' }], ['street', { mode: 'corner' }], ['street', { mode: 'shift', seconds: 30 }], ['street', { mode: 'reup' }], ['office', {}], ['wire', {}], ['stash', {}], ['office', { mode: 'ending' }], ['montage', {}], ['about', {}], ['results', { chapter: 1 }], ['gameover', { why: 'blown' }], ['card', { chapter: 2 }], ['street', { mode: 'demo', demo: true }], ['street', { mode: 'chasedemo', demo: true }]]) {\n  game.go(scene, data, { fade: 0 }); game.advance(3);\n  check('runs ' + scene + ' ' + JSON.stringify(data), !game.errors.length, errs());\n  game.errors.length = 0;\n}\ndone();\nEOF\nnode test/smoke.mjs 2>&1 | tail -30","description":"Run headless smoke test"}}}
