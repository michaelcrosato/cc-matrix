nic,en:SD.W.enemies.filter(e=>!e.dead).length,menace:SD.S.menace,zoom:SD.game.zoom})\\\"))\\n    # settings inversion\\n    pg.evaluate(\\\"SD.game.settings.set('invX', true); SD.game.settings.set('invY', true)\\\"); pg.wait_for_timeout(300)\\n    print('INV', pg.evaluate(\\\"JSON.stringify(SD.INV)\\\"))\\nsession(s)\\n\\ndef s2(pg):\\n    pg.evaluate(\\\"window.__pad.buttons[0].pressed=true\\\"); pg.wait_for_timeout(200); pg.evaluate(\\\"window.__pad.buttons[0].pressed=false\\\"); pg.wait_for_timeout(200)\\n    pg.evaluate(\\\"window.__pad.axes[0]=0.9\\\"); pg.wait_for_timeout(300)\\n    print('dev', pg.evaluate(\\\"SD.game.input.lastDevice\\\"), pg.evaluate(\\\"SD.game.input.padStyle()\\\"))\\n    pg.evaluate(\\\"window.__pad.axes[0]=0\\\"); \\n    pg.evaluate(\\\"SD.game.settings.set('invX', true)\\\"); pg.evaluate(\\\"window.__pad.axes[0]=0.9\\\"); pg.wait_for_timeout(300)\\n    print('move with invX', pg.evaluate(\\\"JSON.stringify(SD.game.input.move())\\\"))\\n    pg.evaluate(\\\"SD.game.settings.set('xbox', true)\\\"); pg.wait_for_timeout(300)\\n    print('style', pg.evaluate(\\\"SD.game.input.padStyle()\\\"))\\n    pg.evaluate(\\\"window.__pad.axes[0]=0\\\")\\n    pg.screenshot(path='/tmp/sdtest/pad_title.png')\\n    pg.evaluate(\\\"SD.game.settings.set('xbox', false)\\\"); pg.keyboard.press('Enter') if False else None\\n    pg.evaluate(\\\"window.__pad.buttons[0].pressed=true\\\"); pg.wait_for_timeout(200); pg.evaluate(\\\"window.__pad.buttons[0].pressed=false\\\"); pg.wait_for_timeout(2500)\\n    pg.screenshot(path='/tmp/sdtest/pad_play.png')\\nwith sync_playwright() as p:\\n    b = p.chromium.launch(args=['--use-gl=swiftshader','--enable-unsafe-swiftshader'])\\n    pg = b.new_page(viewport={'width':1280,'height':720}); errs=[]\\n    pg.on('pageerror', lambda e: errs.append(str(e)))\\n    pg.add_init_script(PAD); pg.goto(URL); pg.wait_for_timeout(1500)\\n    s2(pg); print(errs); b.close()\\nEOF\\ncd /tmp/sdtest && python3 t7.py 2>&1 | tail -12\"},\"caller\