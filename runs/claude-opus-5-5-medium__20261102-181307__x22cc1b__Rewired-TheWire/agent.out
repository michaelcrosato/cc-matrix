        snap = lambda: pg.evaluate('JSON.stringify(window.__bb.snapshot())')\",\"+        def shot(n): pg.screenshot(path=f'{OUT}/{n}.png'); print(n, snap())\",\"+        def keys(seq):\",\"+            for k, ms in seq:\",\"+                if k.startswith('hold:'): pg.keyboard.down(k[5:])\",\"+                elif k.startswith('up:'): pg.keyboard.up(k[3:])\",\"+                elif k == 'wait': pass\",\"+                else: pg.keyboard.press(k)\",\"+                pg.wait_for_timeout(ms)\",\"+        for step in plan:\",\"+            if step == 'title':\",\"+                pg.mouse.move(600, 400); pg.wait_for_timeout(500); shot('title')\",\"+            elif step.startswith('ch'):\",\"+                i = int(step[2:3]); beat = int(step[4:]) if len(step) > 4 else 0\",\"+                pg.evaluate(f'window.__bb.go(\\\"play\\\", {{ ch: {i}, beat: {beat} }})'); pg.wait_for_timeout(1500)\",\"+                shot(f'{step}-a')\",\"+                keys([('Enter', 400), ('Enter', 400), ('Enter', 400), ('hold:KeyD', 900), ('up:KeyD', 100), ('hold:KeyS', 700), ('up:KeyS', 300)])\",\"+                shot(f'{step}-b')\",\"+            elif step == 'attract':\",\"+                pg.evaluate('window.__bb.go(\\\"title\\\")'); pg.wait_for_timeout(11500); shot('attract-a'); pg.wait_for_timeout(6000); shot('attract-b')\",\"+                pg.keyboard.press('KeyX'); pg.wait_for_timeout(800); shot('attract-exit')\",\"+            elif step == 'cookoff':\",\"+                pg.evaluate('window.__bb.go(\\\"cookoff\\\", {})'); pg.wait_for_timeout(4500); shot('cookoff-a')\",\"+                keys([('hold:KeyA', 1200), ('up:KeyA', 100)]); shot('cookoff-b')\",\"+            elif step == 'lab': pg.evaluate('window.__bb.go(\\\"lab\\\", { next: 2 })'); pg.wait_for_timeout(800); shot('lab')\",\"+            elif step == 'over': pg.evaluate('window.__bb.go(\\\"over\\\", { reason: \\\"busted\\\", ch: 4, beat: 1 })'); pg.wait_for_timeout(800); shot('over')\",\"+            elif step == 'results': pg.evaluate('window.__bb.go(\\\"results\\\", { ch: 2, stats: { time: 312, kills: 0 } })'); pg.wait_for_timeout(800); shot('results')\",\"+            elif step == 'ending': pg.evaluate('window.__bb.go(\\\"ending\\\")'); pg.wait_for_timeout(800); shot('ending')\",\"+            elif step == 'about': pg.evaluate('window.__bb.go(\\\"about\\\")'); pg.wait_for_timeout(2500); shot('about')\",\"+            elif step == 'card': pg.evaluate('window.__bb.go(\\\"card\\\", { ch: 0 })'); pg.wait_for_timeout(5000); shot('card')\",\"+            elif step.startswith('eval:'): print(pg.evaluate(step[5:]))\",\"+        ge = pg.evaluate('JSON.stringify((window.__bb && My3D2dge && window.__game_errors) || null)')\",\"+        b.close()\",\"+finally:\",\"+    srv.terminate()\",\"+print('--- errors (%d) ---' % len(errs))\",\"+seen = set()\",\"+for e in errs:\",\"+    if e in seen: continue\",\"+    seen.add(e); print(e[:400])\"]}],\"created\":true},{\"filePath\":\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181328__x694301/agent.out\",\"hunks\":[{\"oldStart\":858,\"oldLines\":3,\"newStart\":858,\"newLines\":4,\"lines\":[\" {\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-opus-5-5\\\",\\\"id\\\":\\\"msg_011Cgf9id6iTScW6CG4FeTQw\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"thinking\\\",\\\"thinking\\\":\\\"\\\",\\\"signature\\\":\\\"\\\"}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":2,\\\"cache_creation_input_tokens\\\":2587,\\\"cache_read_input_tokens\\\":304561,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":2587,\\\"ephemeral_1h_input_tokens\\\":0},\\\"output_tokens\\\":8,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\",\\\"speed\\\":\\\"standard\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"pa