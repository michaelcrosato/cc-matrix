]},{"oldStart":17193,"oldLines":7,"newStart":17195,"newLines":7,"lines":[" const SH = { me: null, holdT: 0, target: null, searched: [], squad: [] };"," const stash = {","   pausable: true, view: 'threequarter', views: ['threequarter', 'iso', 'topdown'], camera: { zoom: [.8, 2], start: 1.3 },","-  enter() {","+  enter() { sceneReset();","     SH.me = makeWalker(STASH.entry.x, STASH.entry.y - 8); SH.searched = []; SH.holdT = 0;","     SH.squad = STASH.squad.map((p, i) => { const a = new Actor('raid' + i, p.x, p.y, { look: { build: 'heroic', outfit: 'coat', hat: { style: 'helmet', color: '#1a1a22' }, weapon: 'gun', colors: { coat: '#1a2448', cloth: '#2a2a34', pants: '#1a1a2a', metal: '#2a2a2a' } } }); a.point = true; a.facing = -Math.PI / 2 + i; return a; });","     game.cam.bounds = v => STASH.map.bounds(v);"]},{"oldStart":17308,"oldLines":7,"newStart":17310,"newLines":7,"lines":["   else if (c.scene === 'ending') game.go('office', { mode: 'ending' });"," }"," const title = {","-  enter() {","+  enter() { sceneReset();","     titleMenu(); TI.idle = 0; TI.t = 0; TI.lastPtr = null; game.lights.enabled = false;","     music('title'); game.weather = null; NOTES.open = false; OBJECTIVE = { title: '', text: '' };","     try { I.touchButtons([]); } catch (e) {}"]},{"oldStart":17447,"oldLines":7,"newStart":17449,"newLines":7,"lines":[" // ---- the chapter card: tape number, title, an epigraph ------------------------------------------------------------------"," const CD = { n: 1, t: 0 };"," const card = {","-  enter(data = {}) { CD.n = data.chapter || 1; CD.t = 0; CASE.chapter = CD.n; CASE.stage = 0; unlock(CD.n); music(null); game.lights.enabled = false; autosave(); A.sfx('tape'); },","+  enter(data = { sceneReset();}) { CD.n = data.chapter || 1; CD.t = 0; CASE.chapter = CD.n; CASE.stage = 0; unlock(CD.n); music(null); game.lights.enabled = false; autosave(); A.sfx('tape'); },","   update(dt) {","     CD.t += dt;","     if ((CD.t > 1.2 && (I.pressed('confirm') || I.pressed('