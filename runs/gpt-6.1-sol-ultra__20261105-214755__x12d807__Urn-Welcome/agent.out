{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > visuals.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport {color,normalWorld,vec3,float,uniform,positionWorld} from 'three/tsl';\nexport {THREE};\nexport class Visuals {\n constructor(){\n this.scene=new THREE.Scene(); this.scene.background=new THREE.Color('#101c25');this.scene.fog=new THREE.FogExp2('#101c25',.012);\n this.camera=new THREE.OrthographicCamera(-21,21,14,-14,.1,180);this.camera.position.set(24,34,30);this.camera.lookAt(0,0,0);\n this.lamp=uniform(new THREE.Vector3());this.power=uniform(1);this.ambient=uniform(.72);this.brightness=uniform(1);this.cache=new Map();this.mixers=[];this.sparks=[];\n this.floorGroup=new THREE.Group();this.titleGroup=new THREE.Group();this.scene.add(this.floorGroup,this.titleGroup);this.floorGroup.visible=false;\n this.actors=new THREE.Group();this.scene.add(this.actors);this.actors.visible=false;this.playerModels=[];this.enemyModels=[];this.itemModels=new Map();this.doorModels=[];\n this.makeTitle();this.dust();\n }\n mat(hex,glow=false){let key=hex+glow;if(this.cache.has(key))return this.cache.get(key);let m=new THREE.MeshBasicNodeMaterial({color:hex});if(\"'!glow){const cel=normalWorld.dot(vec3(.35,.85,.4)).max(0).mul(3).floor().div(3).mul(.42).add(.58);const light=positionWorld.distance(this.lamp).smoothstep(2,13).oneMinus().mul(this.power).add(this.ambient).clamp(.25,1.15);m.colorNode=color(hex).mul(cel).mul(light).mul(this.brightness);}this.cache.set(key,m);return m;}\n mesh(g,geo,col,x=0,y=0,z=0,ink=true){const m=new THREE.Mesh(geo,this.mat(col));m.position.set(x,y,z);g.add(m);if(ink){const edge=new THREE.LineSegments(new THREE.EdgesGeometry(geo,25),new THREE.LineBasicMaterial({color:'\"'#10171e',transparent:true,opacity:.8}));m.add(edge);}return m;}\n box(g,w,h,d,c,x=0,y=0,z=0,ink=true){return this.mesh(g,new THREE.BoxGeometry(w,h,d),c,x,y,z,ink);}\n ball(g,r,c,x=0,y=0,z=0){return this.mesh(g,new THREE.IcosahedronGeometry(r,1),c,x,y,z,false);}\n cylinder(g,r1,r2,h,c,x=0,y=0,z=0,n=10){return this.mesh(g,new THREE.CylinderGeometry(r1,r2,h,n),c,x,y,z);}\n ring(g,r,c,x,y,z){let m=new THREE.Mesh(new THREE.RingGeometry(r*.72,r,40),this.mat(c,true));m.rotation.x=-Math.PI/2;m.position.set(x,y,z);g.add(m);return m;}\n shadow(g,x,z,r=1){let m=new THREE.Mesh(new THREE.CircleGeometry(r,24),new THREE.MeshBasicMaterial({color:'#0a141d',transparent:true,opacity:.34,depthWrite:false}));m.rotation.x=-Math.PI/2;m.scale.y=.6;m.position.set(x,.04,z);g.add(m);return m;}\n label(g,text,x,y,z,size=1.2,col='#eddfb6'){let c=document.createElement('canvas');c.width=512;c.height=128;let ctx=c.getContext('2d');ctx.font='bold 44px Georgia';ctx.fillStyle=col;ctx.textAlign='center';ctx.fillText(text,256,79);let s=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),depthTest:false,transparent:true,opacity:.85}));s.scale.set(size*4,size,1);s.position.set(x,y,z);g.add(s);return s;}\n actor(kind='player',index=0){let root=new THREE.Group(),body=new THREE.Group();root.add(body);const c=kind==='player'?(index?'#a0c9be':'#eac474'):(kind==='ghost'?'#8dbfc0':kind==='bat'?'#bc7d95':'#bd7764');\n if(kind==='player'){this.cylinder(body,.4,.62,1.0,index?'#4b8788':'#b4704f',0,.7,0);this.ball(body,.42,'#1c2632',0,1.23,0);this.cylinder(body,.41,.43,.2,c,0,1.52,0);let hat=this.mesh(body,new THREE.ConeGeometry(.4,.67,5),c,0,1.9,0);hat.rotation.z=-.2;this.box(body,.14,.18,.12,'#fff6cf',-.18,1.27,.34,false);this.box(body,.14,.18,.12,'#fff6cf',.18,1.27,.34,false);this.box(body,.16,.14,.55,c,.5,.75,.26);this.ball(body,.13,'#ffe1a0',.5,.77,.6);}\n if(kind==='ghost'){this.ball(body,.66,c,0,1,0);this.cylinder(body,.59,.83,.78,c,0,.6,0);for(let k=-1;k<=1;k++)this.mesh(body,new THREE.ConeGeometry(.25,.5,4),c,k*.46,.1,0);this.box(body,.14,.25,.13,'#142c39',-.2,1.14,.57,false);this.box(body,.14,.25,.13,'#142c39',.2,1.14,.57,false);this.ball(body,.13,'#142c39',0,.78,.59);}\n if(kind==='bat'){this.ball(body,.3,c,0,1.4,0);for(let s of [-1,1]){let w=this.mesh(body,new THREE.ConeGeometry(.65,.9,3),c,s*.54,1.35,0);w.rotation.z=s*1.2;w.scale.z=.12;}for(let s of [-1,1])this.mesh(body,new THREE.ConeGeometry(.11,.3,3),c,s*.18,1.72,0);}\n if(kind==='spider'){this.ball(body,.42,c,0,.35,0);for(let k=0;k<4;k++)for(let s of [-1,1]){let leg=this.box(body,.75,.075,.075,'#856382',s*.45,.23,(k-1.5)*.22);leg.rotation.y=s*(k-1.5)*.35;} }\n if(kind\"'!=='\"'player'){this.ball(body,.065,'#fff3ae',-.12,kind==='spider'?.48:1.45,.3);this.ball(body,.065,'#fff3ae',.12,kind==='spider'?.48:1.45,.3);}\n this.shadow(root,0,0,kind==='player'?.7:.9);let mixer=new THREE.AnimationMixer(body),track=new THREE.NumberKeyframeTrack('.position[y]',[0,.6,1.2],[0,kind==='player'?.1:.25,0]),rock=new THREE.NumberKeyframeTrack('.rotation[z]',[0,.3,.6,.9,1.2],[0,.06,0,-.06,0]);mixer.clipAction(new THREE.AnimationClip('living-ink',1.2,[track,rock])).play();this.mixers.push(mixer);root.userData={body,mixer,kind};return root;\n }\n candle(g,x,z,large=false){let q=new THREE.Group();q.position.set(x,0,z);g.add(q);this.cylinder(q,.3,.4,.16,'#b88e5e',0,.12,0);this.cylinder(q,.07,.12,large?1:.4,'#af8c66',0,large?.6:.32,0);const yy=large?1.2:.6;for(let a of large?[-.35,0,.35]:[0]){if(a)this.box(q,.7,.08,.08,'#b88e5e',0,.9,0);this.cylinder(q,.095,.1,.35,'#e4d6a1',a,yy,0);let f=this.ball(q,.12,'#ffe2a0',a,yy+.27,0);f.scale.set(.75,1.6,.75);this.sparks.push(f);}return q;}\n furniture(g,type,x,z,colorAlt='#785b61'){\n let q=new THREE.Group();q.position.set(x,0,z);g.add(q);this.shadow(q,0,0,1.3);\n if(type==='shelf'){this.box(q,2,2.3,.5,'#574e5c',0,1.2,0);for(let y of [.45,1.1,1.75]){this.box(q,1.8,.08,.6,'#ad8668',0,y,0);for(let k=0;k<6;k++){let b=this.box(q,.16,.45+((k*7)%3)*.08,.32,['#8f626a','#81958b','#c9aa78'][k%3],-.73+k*.28,y+.28,.13);b.rotation.z=(k%3-1)*.09;}}}\n if(type==='table'||type==='dining'){this.box(q,type==='dining'?2.7:1.5,.15,1.35,colorAlt,0,.9,0);for(let a of [-.55,.55])for(let b of [-.45,.45])this.box(q,.13,.85,.13,'#61505a',a,.43,b);this.candle(q,0,0);if(type==='dining')for(let a of [-.9,.9]){this.cylinder(q,.25,.25,.03,'#c8c5ab',a,1,0);for(let b of [-1,1]){this.box(q,.65,.12,.65,'#8b655e',a,.6,b);this.box(q,.65,.8,.1,'#8b655e',a,1,b+b*.25);}}}\n if(type==='sofa'){this.box(q,2.1,.7,1,'#98716f',0,.55,0);this.box(q,2.1,.8,.2,'#98716f',0,.95,-.5);for(let a of [-1,1])this.box(q,.25,.75,1.1,'#98716f',a,.78,0);for(let a of [-.52,.52])this.box(q,.9,.15,.75,'#b78b81',a,.95,0);}\n if(type==='grave'){this.box(q,.85,1.2,.22,'#819693',0,.65,0);this.ball(q,.43,'#819693',0,1.26,0).scale.z=.3;this.box(q,.08,.45,.08,'#344c56',0,.9,.13);this.box(q,.4,.08,.08,'#344c56',0,1,.13);}\n if(type==='piano'){this.box(q,2,1.6,.65,'#3b424b',0,.8,0);this.box(q,1.8,.1,.65,'#d6caad',0,1,.5);for(let i=0;i<12;i++)this.box(q,.06,.06,.4,'#282f3d',-.8+i*.14,1.08,.45,false);this.candle(q,-.65,0);}\n if(type==='bed'){this.box(q,1.7,.55,2.5,'#6e535e',0,.35,0);this.box(q,1.55,.18,2.25,'#c9b79b',0,.75,0);this.box(q,1.6,.2,1.55,colorAlt,0,.89,.35);this.box(q,1.7,1.4,.12,'#705768',0,.8,-1.3);this.box(q,1.2,.18,.5,'#e2d6b6',0,.93,-.8);}\n if(type==='crate'){this.box(q,1,.85,1,'#a78669',0,.45,0);for(let a of [-.35,.35])this.box(q,.1,.9,1.04,'#554d56',a,.45,0);}\n return q;\n }\n makeTitle(){let g=this.titleGroup;\n this.cylinder(g,15,16,.65,'#223d42',0,-.7,0,12);for(let j=0;j<17;j++){let t=j/16;let p=this.box(g,1.5,.12,1,'#a8997b',Math.sin(t*5)*1.7,.01,3+t*10);p.rotation.y=Math.sin(t*4)*.5;}\n this.box(g,12,8,6,'#53676a',0,4,0);this.box(g,5,10,6.5,'#6a7672',0,5,0);this.box(g,12.5,.45,6.5,'#253c48',0,7.9,0);this.box(g,12.5,.45,6.5,'#253c48',0,4.5,0);this.mesh(g,new THREE.ConeGeometry(9.2,4,4),'#344c59',0,10,0).rotation.y=Math.PI/4;\n for(let side of [-1,1]){this.box(g,2.7,11,3,'#6b7775',side*5,5.5,-.1);this.mesh(g,new THREE.ConeGeometry(2.4,4,4),'#2b424f',side*5,13,-.1).rotation.y=Math.PI/4;this.cylinder(g,.06,.06,2,'#d6b77d',side*5,16,0);this.ball(g,.2,'#eac877',side*5,17,0);}\n for(let y of [2.1,5.8,8.6])for(let x of [-4.7,-2.5,0,2.5,4.7]){if(y===8.6&&Math.abs(x)>1)continue;this.box(g,1,1.8,.16,'#152d38',x,y,3.1);this.box(g,.67,1.42,.18,'#e7bd77',x,y,3.22);this.box(g,.06,1.5,.2,'#2e444d',x,y,3.34);this.box(g,.8,.07,.2,'#2e444d',x,y,3.34);this.box(g,1.2,.1,.4,'#9ca092',x,y-.95,3.24);}\n this.box(g,1.7,2.8,.28,'#202d39',0,1.4,3.3);this.mesh(g,new THREE.ConeGeometry(2.2,1.4,4),'#b17c61',0,3.6,4.0).rotation.y=Math.PI/4;for(let s of [-1,1])this.cylinder(g,.1,.1,2.8,'#baaa8a',s*1.3,1.4,4.7);for(let j=0;j<4;j++)this.box(g,3.4,.2,1.7-j*.15,'#96a096',0,j*.18,4.2-j*.1);\n this.ball(g,3.3,'#f4dfad',-8,13,-9);for(let a of [-1,1])for(let k=0;k<3;k++){let x=a*(9+k*1.5),z=-2+k*4;let t=this.cylinder(g,.22,.6,6,'#293f49',x,2.5,z,6);t.rotation.z=a*.13;for(let r=0;r<3;r++){let b=this.cylinder(g,.04,.18,2.8,'#293f49',x+(r-1)*.65,4.8+r*.2,z,5);b.rotation.z=(r-1)*.7;}}\n for(let k=0;k<12;k++){let a=k*2.4;this.furniture(g,'grave',Math.cos(a)*11,Math.sin(a)*8-2);}\n for(let k=0;k<4;k++){let p=this.actor('ghost');p.position.set(-8+k*5,1.5+(k%2)*2,6+k%2);p.scale.setScalar(.75);g.add(p);}\n for(let k=0;k<16;k++){let b=this.actor('bat');b.position.set(Math.sin(k*4)*12,10+Math.cos(k*3)*3,-6+Math.sin(k)*5);b.scale.setScalar(.35);g.add(b);}\n }\n dust(){let geo=new THREE.BufferGeometry(),a=[];for(let i=0;i<220;i++)a.push((Math.random()-.5)*50,Math.random()*12,(Math.random()-.5)*40);geo.setAttribute('position',new THREE.Float32BufferAttribute(a,3));this.dustMesh=new THREE.Points(geo,new THREE.PointsMaterial({color:'#d9c59d',size:.055,transparent:true,opacity:.45}));this.scene.add(this.dustMesh);}\n buildFloor(f,rooms,doors,items,candles){this.floorGroup.clear();this.itemModels.clear();this.doorModels=[];let g=this.floorGroup;const palettes=[['#677574','#786c71','#74766a','#696974','#4e7074','#7b6f65'],['#69637b','#59787a','#7c6b74','#647873','#75666c','#817b69'],['#596b79','#7a716f','#56767a','#6d6476','#727d78','#8c7864']];\n this.box(g,25,.65,17,'#253b47',0,-.48,0);this.box(g,25.25,.15,17.25,'#b0916a',0,-.15,0);\n for(let i=0;i<6;i++){let x=(i%3-1)*8,z=(Math.floor(i/3)-.5)*8,col=palettes[f][i];this.box(g,7.9,.12,7.9,col,x,-.03,z);for(let t=0;t<8;t++){this.box(g,.025,.015,7.8,'#4b535e',x-3.5+t,.045,z,false);for(let j=0;j<3;j++)this.box(g,.9,.012,.022,'#4b535e',x-3.5+t,.055,z-3+j*3+(t%2),false);}\n this.box(g,3.8,.025,3.5,['#81616b','#6c596c','#89705d'][f],x,.06,z);for(let a of [-1,1]){this.box(g,3.5,.015,.06,'#bd9e7c',x,.085,z+a*1.5,false);this.box(g,.06,.015,3.05,'#bd9e7c',x+a*1.65,.085,z,false);}this.label(g,rooms[i],x,.2,z-2.8,.56);\n if(i===0){this.furniture(g,f===2?'grave':'shelf',x-2,z-2);this.furniture(g,f===2?'grave':'table',x+2,z+2);}\n if(i===1){this.furniture(g,f===1?'piano':'shelf',x-1.8,z-2.6);this.furniture(g,'table',x+2.3,z+1.8);}\n if(i===2){this.furniture(g,f===2?'grave':'bed',x+2,z-1);this.furniture(g,'shelf',x-2,z-2.7);}\n if(i===3){this.furniture(g,f===1?'crate':'sofa',x-1,z+1.8);this.furniture(g,'table',x+2,z-1);}\n if(i===4){this.furniture(g,'table',x-2.3,z-1.6);this.furniture(g,'sofa',x+1.4,z-2.5);}\n if(i===5){this.furniture(g,'dining',x+1.2,z-1.5);this.furniture(g,'crate',x+2.6,z+2.6);}\n // Portraits, wainscot and ink scratches along the rear walls.\n this.box(g,7.8,.5,.13,'#495260',x,.3,z-3.85);this.box(g,7.8,.08,.17,'#baa07c',x,.59,z-3.85);for(let k=0;k<2;k++){this.box(g,.9,1.05,.1,'#be9a6b',x-2+k*4,1.6,z-3.83);this.box(g,.69,.81,.12,'#343c50',x-2+k*4,1.6,z-3.75);this.ball(g,.2,k?'#c4aa83':'#809f9c',x-2+k*4,1.7,z-3.64);}\n }\n // Cutaway walls keep every doorway and room readable.\n for(let x of [-12,12])this.box(g,.2,1.1,16,'#465765',x,.55,0);for(let z of [-8,8])this.box(g,24, z<0?2.3:.5,.2,'#4e6068',0,z<0?1.15:.25,z);\n for(let x of [-4,4])for(let z of [-4,4])for(let d of [-1,1]){this.box(g,.18,.85,2.8,'#495563',x,.425,z+d*2.55);this.box(g,.23,.1,2.8,'#b79d78',x,.89,z+d*2.55);}\n for(let x of [-8,0,8])for(let d of [-1,1]){this.box(g,2.8,.85,.18,'#495563',x+d*2.55,.425,0);this.box(g,2.8,.1,.23,'#b79d78',x+d*2.55,.89,0);}\n for(let d of doors){let q=new THREE.Group();q.position.set(d.x,0,d.z);if(d.axis==='x')q.rotation.y=Math.PI/2;g.add(q);this.box(q,.13,2.2,.22,'#c0a278',-1.05,1.1,0);this.box(q,.13,2.2,.22,'#c0a278',1.05,1.1,0);this.box(q,2.2,.16,.25,'#c0a278',0,2.2,0);if(d.locked){this.box(q,1.95,1.8,.14,'#7f625e',0,.95,0);this.box(q,.4,.45,.19,'#d7b66d',0,1.1,.14);this.label(q,'◇',0,1.5,.3,.5);}this.doorModels.push(q);}\n for(let it of items)this.addItem(it);\n for(let c of candles){let q=this.candle(g,c.x,c.z,true);this.ring(q,1.9,c.lit?'#d0a96b':'#626b6e',0,.09,0);c.visual=q;}\n // Stairs are strongly framed in gold and striped risers.\n const stair=(x,z,up)=>{let q=new THREE.Group();q.position.set(x,0,z);g.add(q);this.ring(q,1.1,'#d9bd7f',0,.1,0);for(let i=0;i<5;i++)this.box(q,1.3,.16+i*.12,.27,'#a29c85',0,(.16+i*.12)/2,-.5+i*.26);this.label(q,up?'↑ UP':'↓ DOWN',0,1.8,0,.6);};\n if(f<2)stair(f===0?9:-9,5,true);if(f>0)stair(f===1?9:-9,5,false);\n if(f===0){this.box(g,2.1,.16,.8,'#c4976b',0,.1,7.5);this.label(g,'THE WAY OUT',0,1.1,7.7,.65);}\n }\n addItem(it){let q=new THREE.Group();q.position.set(it.x,.25,it.z);this.floorGroup.add(q);this.ring(q,.65,it.type==='shard'?'#f2d591':it.type==='key'?'#c4a96f':'#9cd2c1',0,-.1,0);if(it.type==='key'){let tor=new THREE.Mesh(new THREE.TorusGeometry(.22,.075,6,16),this.mat('#edcc81'));tor.position.set(-.18,.65,0);q.add(tor);this.box(q,.5,.1,.1,'#edcc81',.18,.65,0);this.box(q,.1,.2,.1,'#edcc81',.38,.57,0);}else if(it.type==='ward'){this.cylinder(q,.05,.05,.9,'#b5d5bb',0,.6,0);this.box(q,.6,.1,.1,'#dbe1b2',0,.7,0);this.ball(q,.16,'#9fcbc1',0,1.1,0);}else{this.cylinder(q,.21,.33,.5,'#e0b570',0,.65,0,6);this.ball(q,.17,'#f3d59b',0,1.05,0);this.ring(q,.8,'#a58563',0,-.08,0);}this.itemModels.set(it.id,q);return q;}\n sync(state){for(let i=0;i<state.players.length;i++){let p=state.players[i];if(\"'!this.playerModels[i]){this.playerModels[i]=this.actor('\"'player',i);this.actors.add(this.playerModels[i]);}let m=this.playerModels[i];m.position.set(p.x,0,p.z);m.rotation.y=p.angle||0;m.visible=i<state.playerCount;m.userData.body.visible=true; m.userData.mixer.timeScale=p.moving?2:0.45;}\n for(let i=0;i<state.enemies.length;i++){let e=state.enemies[i];if(\"'!this.enemyModels[i]||this.enemyModels[i].userData.kind!==e.type){if(this.enemyModels[i])this.actors.remove(this.enemyModels[i]);this.enemyModels[i]=this.actor(e.type);this.actors.add(this.enemyModels[i]);}let m=this.enemyModels[i];m.position.set(e.x,Math.sin(state.time*2+i)*.1,e.z);m.rotation.y=e.angle||0;m.visible=true;m.userData.body.scale.setScalar(e.stun>0?.65:1);}\n for(let i=state.enemies.length;i<this.enemyModels.length;i++)this.enemyModels[i].visible=false;\n const active=new Set(state.items.filter(i=>!i.taken).map(i=>i.id));for(let [id,m]of this.itemModels)m.visible=active.has(id);\n let p=state.players[0];this.lamp.value.set(p.x,1,p.z);this.power.value=p.light>0?.55:0;this.ambient.value=p.light>0?.59:.36;\n }\n resize(w,h,mode){let a=w/h;let half=mode==='\"'title'?(a<1?20:15):(a<1?24:15.5);this.camera.left=-half*a;this.camera.right=half*a;this.camera.top=half;this.camera.bottom=-half;this.camera.updateProjectionMatrix();}\n mode(title){this.titleGroup.visible=title;this.floorGroup.visible=\"'!title;this.actors.visible=!title;if(title){this.camera.position.set(25,23,34);this.camera.lookAt(-6,5,0);this.power.value=0;this.ambient.value=.99;}else{this.camera.position.set(23,34,30);this.camera.lookAt(0,0,0);}}\n update(dt,t){for(let m of this.mixers)m.update(dt);for(let [id,m]of this.itemModels){m.rotation.y=t*.7;m.position.y=.15+Math.sin(t*2+id.length)*.12;}for(let s of this.sparks)s.scale.y=1.4+Math.sin(t*9+s.id)*.3;this.dustMesh.rotation.y=t*.007;}\n}\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > visuals.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport {color,normalWorld,vec3,float,uniform,positionWorld} from 'three/tsl';\nexport {THREE};\nexport class Visuals {\n constructor(){\n this.scene=new THREE.Scene(); this.scene.background=new THREE.Color('#101c25');this.scene.fog=new THREE.FogExp2('#101c25',.012);\n this.camera=new THREE.OrthographicCamera(-21,21,14,-14,.1,180);this.camera.position.set(24,34,30);this.camera.lookAt(0,0,0);\n this.lamp=uniform(new THREE.Vector3());this.power=uniform(1);this.ambient=uniform(.72);this.brightness=uniform(1);this.cache=new Map();this.mixers=[];this.sparks=[];\n this.floorGroup=new THREE.Group();this.titleGroup=new THREE.Group();this.scene.add(this.floorGroup,this.titleGroup);this.floorGroup.visible=false;\n this.actors=new THREE.Group();this.scene.add(this.actors);this.actors.visible=false;this.playerModels=[];this.enemyModels=[];this.itemModels=new Map();this.doorModels=[];\n this.makeTitle();this.dust();\n }\n mat(hex,glow=false){let key=hex+glow;if(this.cache.has(key))return this.cache.get(key);let m=new THREE.MeshBasicNodeMaterial({color:hex});if(\"'!glow){const cel=normalWorld.dot(vec3(.35,.85,.4)).max(0).mul(3).floor().div(3).mul(.42).add(.58);const light=positionWorld.distance(this.lamp).smoothstep(2,13).oneMinus().mul(this.power).add(this.ambient).clamp(.25,1.15);m.colorNode=color(hex).mul(cel).mul(light).mul(this.brightness);}this.cache.set(key,m);return m;}\n mesh(g,geo,col,x=0,y=0,z=0,ink=true){const m=new THREE.Mesh(geo,this.mat(col));m.position.set(x,y,z);g.add(m);if(ink){const edge=new THREE.LineSegments(new THREE.EdgesGeometry(geo,25),new THREE.LineBasicMaterial({color:'\"'#10171e',transparent:true,opacity:.8}));m.add(edge);}return m;}\n box(g,w,h,d,c,x=0,y=0,z=0,ink=true){return this.mesh(g,new THREE.BoxGeometry(w,h,d),c,x,y,z,ink);}\n ball(g,r,c,x=0,y=0,z=0){return this.mesh(g,new THREE.IcosahedronGeometry(r,1),c,x,y,z,false);}\n cylinder(g,r1,r2,h,c,x=0,y=0,z=0,n=10){return this.mesh(g,new THREE.CylinderGeometry(r1,r2,h,n),c,x,y,z);}\n ring(g,r,c,x,y,z){let m=new THREE.Mesh(new THREE.RingGeometry(r*.72,r,40),this.mat(c,true));m.rotation.x=-Math.PI/2;m.position.set(x,y,z);g.add(m);return m;}\n shadow(g,x,z,r=1){let m=new THREE.Mesh(new THREE.CircleGeometry(r,24),new THREE.MeshBasicMaterial({color:'#0a141d',transparent:true,opacity:.34,depthWrite:false}));m.rotation.x=-Math.PI/2;m.scale.y=.6;m.position.set(x,.04,z);g.add(m);return m;}\n label(g,text,x,y,z,size=1.2,col='#eddfb6'){let c=document.createElement('canvas');c.width=512;c.height=128;let ctx=c.getContext('2d');ctx.font='bold 44px Georgia';ctx.fillStyle=col;ctx.textAlign='center';ctx.fillText(text,256,79);let s=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),depthTest:false,transparent:true,opacity:.85}));s.scale.set(size*4,size,1);s.position.set(x,y,z);g.add(s);return s;}\n actor(kind='player',index=0){let root=new THREE.Group(),body=new THREE.Group();root.add(body);const c=kind==='player'?(index?'#a0c9be':'#eac474'):(kind==='ghost'?'#8dbfc0':kind==='bat'?'#bc7d95':'#bd7764');\n if(kind==='player'){this.cylinder(body,.4,.62,1.0,index?'#4b8788':'#b4704f',0,.7,0);this.ball(body,.42,'#1c2632',0,1.23,0);this.cylinder(body,.41,.43,.2,c,0,1.52,0);let hat=this.mesh(body,new THREE.ConeGeometry(.4,.67,5),c,0,1.9,0);hat.rotation.z=-.2;this.box(body,.14,.18,.12,'#fff6cf',-.18,1.27,.34,false);this.box(body,.14,.18,.12,'#fff6cf',.18,1.27,.34,false);this.box(body,.16,.14,.55,c,.5,.75,.26);this.ball(body,.13,'#ffe1a0',.5,.77,.6);}\n if(kind==='ghost'){this.ball(body,.66,c,0,1,0);this.cylinder(body,.59,.83,.78,c,0,.6,0);for(let k=-1;k<=1;k++)this.mesh(body,new THREE.ConeGeometry(.25,.5,4),c,k*.46,.1,0);this.box(body,.14,.25,.13,'#142c39',-.2,1.14,.57,false);this.box(body,.14,.25,.13,'#142c39',.2,1.14,.57,false);this.ball(body,.13,'#142c39',0,.78,.59);}\n if(kind==='bat'){this.ball(body,.3,c,0,1.4,0);for(let s of [-1,1]){let w=this.mesh(body,new THREE.ConeGeometry(.65,.9,3),c,s*.54,1.35,0);w.rotation.z=s*1.2;w.scale.z=.12;}for(let s of [-1,1])this.mesh(body,new THREE.ConeGeometry(.11,.3,3),c,s*.18,1.72,0);}\n if(kind==='spider'){this.ball(body,.42,c,0,.35,0);for(let k=0;k<4;k++)for(let s of [-1,1]){let leg=this.box(body,.75,.075,.075,'#856382',s*.45,.23,(k-1.5)*.22);leg.rotation.y=s*(k-1.5)*.35;} }\n if(kind\"'!=='\"'player'){this.ball(body,.065,'#fff3ae',-.12,kind==='spider'?.48:1.45,.3);this.ball(body,.065,'#fff3ae',.12,kind==='spider'?.48:1.45,.3);}\n this.shadow(root,0,0,kind==='player'?.7:.9);let mixer=new THREE.AnimationMixer(body),track=new THREE.NumberKeyframeTrack('.position[y]',[0,.6,1.2],[0,kind==='player'?.1:.25,0]),rock=new THREE.NumberKeyframeTrack('.rotation[z]',[0,.3,.6,.9,1.2],[0,.06,0,-.06,0]);mixer.clipAction(new THREE.AnimationClip('living-ink',1.2,[track,rock])).play();this.mixers.push(mixer);root.userData={body,mixer,kind};return root;\n }\n candle(g,x,z,large=false){let q=new THREE.Group();q.position.set(x,0,z);g.add(q);this.cylinder(q,.3,.4,.16,'#b88e5e',0,.12,0);this.cylinder(q,.07,.12,large?1:.4,'#af8c66',0,large?.6:.32,0);const yy=large?1.2:.6;for(let a of large?[-.35,0,.35]:[0]){if(a)this.box(q,.7,.08,.08,'#b88e5e',0,.9,0);this.cylinder(q,.095,.1,.35,'#e4d6a1',a,yy,0);let f=this.ball(q,.12,'#ffe2a0',a,yy+.27,0);f.scale.set(.75,1.6,.75);this.sparks.push(f);}return q;}\n furniture(g,type,x,z,colorAlt='#785b61'){\n let q=new THREE.Group();q.position.set(x,0,z);g.add(q);this.shadow(q,0,0,1.3);\n if(type==='shelf'){this.box(q,2,2.3,.5,'#574e5c',0,1.2,0);for(let y of [.45,1.1,1.75]){this.box(q,1.8,.08,.6,'#ad8668',0,y,0);for(let k=0;k<6;k++){let b=this.box(q,.16,.45+((k*7)%3)*.08,.32,['#8f626a','#81958b','#c9aa78'][k%3],-.73+k*.28,y+.28,.13);b.rotation.z=(k%3-1)*.09;}}}\n if(type==='table'||type==='dining'){this.box(q,type==='dining'?2.7:1.5,.15,1.35,colorAlt,0,.9,0);for(let a of [-.55,.55])for(let b of [-.45,.45])this.box(q,.13,.85,.13,'#61505a',a,.43,b);this.candle(q,0,0);if(type==='dining')for(let a of [-.9,.9]){this.cylinder(q,.25,.25,.03,'#c8c5ab',a,1,0);for(let b of [-1,1]){this.box(q,.65,.12,.65,'#8b655e',a,.6,b);this.box(q,.65,.8,.1,'#8b655e',a,1,b+b*.25);}}}\n if(type==='sofa'){this.box(q,2.1,.7,1,'#98716f',0,.55,0);this.box(q,2.1,.8,.2,'#98716f',0,.95,-.5);for(let a of [-1,1])this.box(q,.25,.75,1.1,'#98716f',a,.78,0);for(let a of [-.52,.52])this.box(q,.9,.15,.75,'#b78b81',a,.95,0);}\n if(type==='grave'){this.box(q,.85,1.2,.22,'#819693',0,.65,0);this.ball(q,.43,'#819693',0,1.26,0).scale.z=.3;this.box(q,.08,.45,.08,'#344c56',0,.9,.13);this.box(q,.4,.08,.08,'#344c56',0,1,.13);}\n if(type==='piano'){this.box(q,2,1.6,.65,'#3b424b',0,.8,0);this.box(q,1.8,.1,.65,'#d6caad',0,1,.5);for(let i=0;i<12;i++)this.box(q,.06,.06,.4,'#282f3d',-.8+i*.14,1.08,.45,false);this.candle(q,-.65,0);}\n if(type==='bed'){this.box(q,1.7,.55,2.5,'#6e535e',0,.35,0);this.box(q,1.55,.18,2.25,'#c9b79b',0,.75,0);this.box(q,1.6,.2,1.55,colorAlt,0,.89,.35);this.box(q,1.7,1.4,.12,'#705768',0,.8,-1.3);this.box(q,1.2,.18,.5,'#e2d6b6',0,.93,-.8);}\n if(type==='crate'){this.box(q,1,.85,1,'#a78669',0,.45,0);for(let a of [-.35,.35])this.box(q,.1,.9,1.04,'#554d56',a,.45,0);}\n return q;\n }\n makeTitle(){let g=this.titleGroup;\n this.cylinder(g,15,16,.65,'#223d42',0,-.7,0,12);for(let j=0;j<17;j++){let t=j/16;let p=this.box(g,1.5,.12,1,'#a8997b',Math.sin(t*5)*1.7,.01,3+t*10);p.rotation.y=Math.sin(t*4)*.5;}\n this.box(g,12,8,6,'#53676a',0,4,0);this.box(g,5,10,6.5,'#6a7672',0,5,0);this.box(g,12.5,.45,6.5,'#253c48',0,7.9,0);this.box(g,12.5,.45,6.5,'#253c48',0,4.5,0);this.mesh(g,new THREE.ConeGeometry(9.2,4,4),'#344c59',0,10,0).rotation.y=Math.PI/4;\n for(let side of [-1,1]){this.box(g,2.7,11,3,'#6b7775',side*5,5.5,-.1);this.mesh(g,new THREE.ConeGeometry(2.4,4,4),'#2b424f',side*5,13,-.1).rotation.y=Math.PI/4;this.cylinder(g,.06,.06,2,'#d6b77d',side*5,16,0);this.ball(g,.2,'#eac877',side*5,17,0);}\n for(let y of [2.1,5.8,8.6])for(let x of [-4.7,-2.5,0,2.5,4.7]){if(y===8.6&&Math.abs(x)>1)continue;this.box(g,1,1.8,.16,'#152d38',x,y,3.1);this.box(g,.67,1.42,.18,'#e7bd77',x,y,3.22);this.box(g,.06,1.5,.2,'#2e444d',x,y,3.34);this.box(g,.8,.07,.2,'#2e444d',x,y,3.34);this.box(g,1.2,.1,.4,'#9ca092',x,y-.95,3.24);}\n this.box(g,1.7,2.8,.28,'#202d39',0,1.4,3.3);this.mesh(g,new THREE.ConeGeometry(2.2,1.4,4),'#b17c61',0,3.6,4.0).rotation.y=Math.PI/4;for(let s of [-1,1])this.cylinder(g,.1,.1,2.8,'#baaa8a',s*1.3,1.4,4.7);for(let j=0;j<4;j++)this.box(g,3.4,.2,1.7-j*.15,'#96a096',0,j*.18,4.2-j*.1);\n this.ball(g,3.3,'#f4dfad',-8,13,-9);for(let a of [-1,1])for(let k=0;k<3;k++){let x=a*(9+k*1.5),z=-2+k*4;let t=this.cylinder(g,.22,.6,6,'#293f49',x,2.5,z,6);t.rotation.z=a*.13;for(let r=0;r<3;r++){let b=this.cylinder(g,.04,.18,2.8,'#293f49',x+(r-1)*.65,4.8+r*.2,z,5);b.rotation.z=(r-1)*.7;}}\n for(let k=0;k<12;k++){let a=k*2.4;this.furniture(g,'grave',Math.cos(a)*11,Math.sin(a)*8-2);}\n for(let k=0;k<4;k++){let p=this.actor('ghost');p.position.set(-8+k*5,1.5+(k%2)*2,6+k%2);p.scale.setScalar(.75);g.add(p);}\n for(let k=0;k<16;k++){let b=this.actor('bat');b.position.set(Math.sin(k*4)*12,10+Math.cos(k*3)*3,-6+Math.sin(k)*5);b.scale.setScalar(.35);g.add(b);}\n }\n dust(){let geo=new THREE.BufferGeometry(),a=[];for(let i=0;i<220;i++)a.push((Math.random()-.5)*50,Math.random()*12,(Math.random()-.5)*40);geo.setAttribute('position',new THREE.Float32BufferAttribute(a,3));this.dustMesh=new THREE.Points(geo,new THREE.PointsMaterial({color:'#d9c59d',size:.055,transparent:true,opacity:.45}));this.scene.add(this.dustMesh);}\n buildFloor(f,rooms,doors,items,candles){this.floorGroup.clear();this.itemModels.clear();this.doorModels=[];let g=this.floorGroup;const palettes=[['#677574','#786c71','#74766a','#696974','#4e7074','#7b6f65'],['#69637b','#59787a','#7c6b74','#647873','#75666c','#817b69'],['#596b79','#7a716f','#56767a','#6d6476','#727d78','#8c7864']];\n this.box(g,25,.65,17,'#253b47',0,-.48,0);this.box(g,25.25,.15,17.25,'#b0916a',0,-.15,0);\n for(let i=0;i<6;i++){let x=(i%3-1)*8,z=(Math.floor(i/3)-.5)*8,col=palettes[f][i];this.box(g,7.9,.12,7.9,col,x,-.03,z);for(let t=0;t<8;t++){this.box(g,.025,.015,7.8,'#4b535e',x-3.5+t,.045,z,false);for(let j=0;j<3;j++)this.box(g,.9,.012,.022,'#4b535e',x-3.5+t,.055,z-3+j*3+(t%2),false);}\n this.box(g,3.8,.025,3.5,['#81616b','#6c596c','#89705d'][f],x,.06,z);for(let a of [-1,1]){this.box(g,3.5,.015,.06,'#bd9e7c',x,.085,z+a*1.5,false);this.box(g,.06,.015,3.05,'#bd9e7c',x+a*1.65,.085,z,false);}this.label(g,rooms[i],x,.2,z-2.8,.56);\n if(i===0){this.furniture(g,f===2?'grave':'shelf',x-2,z-2);this.furniture(g,f===2?'grave':'table',x+2,z+2);}\n if(i===1){this.furniture(g,f===1?'piano':'shelf',x-1.8,z-2.6);this.furniture(g,'table',x+2.3,z+1.8);}\n if(i===2){this.furniture(g,f===2?'grave':'bed',x+2,z-1);this.furniture(g,'shelf',x-2,z-2.7);}\n if(i===3){this.furniture(g,f===1?'crate':'sofa',x-1,z+1.8);this.furniture(g,'table',x+2,z-1);}\n if(i===4){this.furniture(g,'table',x-2.3,z-1.6);this.furniture(g,'sofa',x+1.4,z-2.5);}\n if(i===5){this.furniture(g,'dining',x+1.2,z-1.5);this.furniture(g,'crate',x+2.6,z+2.6);}\n // Portraits, wainscot and ink scratches along the rear walls.\n this.box(g,7.8,.5,.13,'#495260',x,.3,z-3.85);this.box(g,7.8,.08,.17,'#baa07c',x,.59,z-3.85);for(let k=0;k<2;k++){this.box(g,.9,1.05,.1,'#be9a6b',x-2+k*4,1.6,z-3.83);this.box(g,.69,.81,.12,'#343c50',x-2+k*4,1.6,z-3.75);this.ball(g,.2,k?'#c4aa83':'#809f9c',x-2+k*4,1.7,z-3.64);}\n }\n // Cutaway walls keep every doorway and room readable.\n for(let x of [-12,12])this.box(g,.2,1.1,16,'#465765',x,.55,0);for(let z of [-8,8])this.box(g,24, z<0?2.3:.5,.2,'#4e6068',0,z<0?1.15:.25,z);\n for(let x of [-4,4])for(let z of [-4,4])for(let d of [-1,1]){this.box(g,.18,.85,2.8,'#495563',x,.425,z+d*2.55);this.box(g,.23,.1,2.8,'#b79d78',x,.89,z+d*2.55);}\n for(let x of [-8,0,8])for(let d of [-1,1]){this.box(g,2.8,.85,.18,'#495563',x+d*2.55,.425,0);this.box(g,2.8,.1,.23,'#b79d78',x+d*2.55,.89,0);}\n for(let d of doors){let q=new THREE.Group();q.position.set(d.x,0,d.z);if(d.axis==='x')q.rotation.y=Math.PI/2;g.add(q);this.box(q,.13,2.2,.22,'#c0a278',-1.05,1.1,0);this.box(q,.13,2.2,.22,'#c0a278',1.05,1.1,0);this.box(q,2.2,.16,.25,'#c0a278',0,2.2,0);if(d.locked){this.box(q,1.95,1.8,.14,'#7f625e',0,.95,0);this.box(q,.4,.45,.19,'#d7b66d',0,1.1,.14);this.label(q,'◇',0,1.5,.3,.5);}this.doorModels.push(q);}\n for(let it of items)this.addItem(it);\n for(let c of candles){let q=this.candle(g,c.x,c.z,true);this.ring(q,1.9,c.lit?'#d0a96b':'#626b6e',0,.09,0);c.visual=q;}\n // Stairs are strongly framed in gold and striped risers.\n const stair=(x,z,up)=>{let q=new THREE.Group();q.position.set(x,0,z);g.add(q);this.ring(q,1.1,'#d9bd7f',0,.1,0);for(let i=0;i<5;i++)this.box(q,1.3,.16+i*.12,.27,'#a29c85',0,(.16+i*.12)/2,-.5+i*.26);this.label(q,up?'↑ UP':'↓ DOWN',0,1.8,0,.6);};\n if(f<2)stair(f===0?9:-9,5,true);if(f>0)stair(f===1?9:-9,5,false);\n if(f===0){this.box(g,2.1,.16,.8,'#c4976b',0,.1,7.5);this.label(g,'THE WAY OUT',0,1.1,7.7,.65);}\n }\n addItem(it){let q=new THREE.Group();q.position.set(it.x,.25,it.z);this.floorGroup.add(q);this.ring(q,.65,it.type==='shard'?'#f2d591':it.type==='key'?'#c4a96f':'#9cd2c1',0,-.1,0);if(it.type==='key'){let tor=new THREE.Mesh(new THREE.TorusGeometry(.22,.075,6,16),this.mat('#edcc81'));tor.position.set(-.18,.65,0);q.add(tor);this.box(q,.5,.1,.1,'#edcc81',.18,.65,0);this.box(q,.1,.2,.1,'#edcc81',.38,.57,0);}else if(it.type==='ward'){this.cylinder(q,.05,.05,.9,'#b5d5bb',0,.6,0);this.box(q,.6,.1,.1,'#dbe1b2',0,.7,0);this.ball(q,.16,'#9fcbc1',0,1.1,0);}else{this.cylinder(q,.21,.33,.5,'#e0b570',0,.65,0,6);this.ball(q,.17,'#f3d59b',0,1.05,0);this.ring(q,.8,'#a58563',0,-.08,0);}this.itemModels.set(it.id,q);return q;}\n sync(state){for(let i=0;i<state.players.length;i++){let p=state.players[i];if(\"'!this.playerModels[i]){this.playerModels[i]=this.actor('\"'player',i);this.actors.add(this.playerModels[i]);}let m=this.playerModels[i];m.position.set(p.x,0,p.z);m.rotation.y=p.angle||0;m.visible=i<state.playerCount;m.userData.body.visible=true; m.userData.mixer.timeScale=p.moving?2:0.45;}\n for(let i=0;i<state.enemies.length;i++){let e=state.enemies[i];if(\"'!this.enemyModels[i]||this.enemyModels[i].userData.kind!==e.type){if(this.enemyModels[i])this.actors.remove(this.enemyModels[i]);this.enemyModels[i]=this.actor(e.type);this.actors.add(this.enemyModels[i]);}let m=this.enemyModels[i];m.position.set(e.x,Math.sin(state.time*2+i)*.1,e.z);m.rotation.y=e.angle||0;m.visible=true;m.userData.body.scale.setScalar(e.stun>0?.65:1);}\n for(let i=state.enemies.length;i<this.enemyModels.length;i++)this.enemyModels[i].visible=false;\n const active=new Set(state.items.filter(i=>!i.taken).map(i=>i.id));for(let [id,m]of this.itemModels)m.visible=active.has(id);\n let p=state.players[0];this.lamp.value.set(p.x,1,p.z);this.power.value=p.light>0?.55:0;this.ambient.value=p.light>0?.59:.36;\n }\n resize(w,h,mode){let a=w/h;let half=mode==='\"'title'?(a<1?20:15):(a<1?24:15.5);this.camera.left=-half*a;this.camera.right=half*a;this.camera.top=half;this.camera.bottom=-half;this.camera.updateProjectionMatrix();}\n mode(title){this.titleGroup.visible=title;this.floorGroup.visible=\"'!title;this.actors.visible=!title;if(title){this.camera.position.set(25,23,34);this.camera.lookAt(-6,5,0);this.power.value=0;this.ambient.value=.99;}else{this.camera.position.set(23,34,30);this.camera.lookAt(0,0,0);}}\n update(dt,t){for(let m of this.mixers)m.update(dt);for(let [id,m]of this.itemModels){m.rotation.y=t*.7;m.position.y=.15+Math.sin(t*2+id.length)*.12;}for(let s of this.sparks)s.scale.y=1.4+Math.sin(t*9+s.id)*.3;this.dustMesh.rotation.y=t*.007;}\n}\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"The random title pick is **Urn Welcome**. The house now has a hand-built cel-shaded look, and the code-generated music, effects, and gibberish voices pass audio checks. Co-op is also working between browser tabs and through a direct WebRTC connection; I’m now connecting it to the exploration, tools, ghosts, and escape sequence.\n"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'EOF'\nimport * as RAPIER from '@dimforge/rapier3d-compat';\nimport {Visuals,THREE} from './visuals.js';\nimport {UI} from './ui.js';\nimport {AudioEngine} from './audio.js';\nimport {Network} from './network.js';\nconst \"'$=s=>document.querySelector(s),clamp=(x,a,b)=>Math.max(a,Math.min(b,x)),dist=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z);\nconst defaults={speed:4,enemy:1,lantern:35,lives:3};let tuning={...defaults};let settings={music:.1,sfx:.55,brightness:1,glyph:'\"'ps',reducedMotion:false};try{Object.assign(settings,JSON.parse(localStorage.getItem('urn-settings')||'{}'));}catch{}\nconst rooms=[['The Locked Study','Portrait Gallery','Dusty Nursery','Faded Parlor','Entrance Hall','Dining Room'],['Cold Conservatory','Music Room','The Sealed Library','Servants’ Landing','Clock Gallery','East Landing'],['Urn Chamber','The Widow’s Walk','Moonlit Attic','West Landing','Cobweb Hall','Forgotten Observatory']];\nlet scene,renderer,physics,controller,body,colliders=[],last=performance.now(),state,mode='title',attract=false,idle=performance.now(),titlePhase=0,buildFloorIndex=-1,steps=0,shake=0,device='keyboard',padPrevious=[],menuRepeat=0,accum=0,mapVisible=false,debugReveal=false,loading=true,lastHud=0,remoteInput={x:0,z:0};const keys=new Set();let touch={active:false,id:null,x:0,z:0,ox:0,oy:0};let mouseTarget=null;const audio=new AudioEngine();let ui;let about={};\nconst net=new Network({onStatus:status=>{ui?.updateOnline?.({status,roomCode:net.roomCode||net.code||''});},onInput:(input,index)=>{remoteInput=input;},onSnapshot:s=>{if(net.role==='guest'){if(\"'!state||state.floor!==s.floor||buildFloorIndex!==s.floor){state=s;buildFloor();}else state=s;if(mode!=='\"'play'){mode='play';scene.mode(false);resize();ui.setScreen('none');}scene.sync(state);if(s.result&&\"'!state.resultShown)showResult(s.result==='\"'win',false);}},onStart:info=>{if(net.role\"'!=='\"'guest')start(false,info.playerCount||2);else{mode='play';ui.setScreen('none');}},onEnd:info=>{if(info.won\"'!==undefined)showResult(info.won,false);else{mode='\"'pause';ui.setScreen('pause');}},onTimeUp:()=>showResult(state?.fragments>=3)});\nfunction inputActivity(dev=device){idle=performance.now();if(loading)return;if(attract){attract=false;goTitle();return;}if(dev\"'!==device){device=dev;ui.setDevice(device,settings.glyph);}audio.init().catch(()=>{});}\nfunction player(x=0,z=5,index=0){return {x,z,angle:0,light:tuning.lantern,tool:null,moving:false,cooldown:0,invincible:0,index};}\nfunction floorItems(f){let a=[{id:`shard${f}`,type:'\"'shard',x:f===1?8:-8,z:-4,taken:false}];if(f===0)a.push({id:'key',type:'key',x:-8,z:4,taken:false},{id:'ward',type:'ward',x:0,z:-4,taken:false});return a;}\nfunction floorDoors(f){let a=[];for(let x of [-4,4])for(let z of [-4,4])a.push({x,z,axis:'x',locked:false});for(let x of [-8,0,8])a.push({x,z:0,axis:'z',locked:(f===1?x===8:x===-8)});return a;}\nfunction newState(count=1){return {floor:0,time:0,elapsed:0,fragments:0,fragmentFloors:[],lives:tuning.lives,playerCount:count,players:[player(),player(1,5,1)],items:floorItems(0),doors:floorDoors(0),candles:[{x:1.4,z:4,lit:true},{x:-1,z:-4,lit:false}],floors:{},enemies:[],visited:Array(6).fill(false),matches:0,hits:0,result:null,windIn:21};}\nfunction enemies(f){return [{type:'ghost',x:-8,z:-4,angle:0,stun:0,phase:0},{type:'bat',x:8,z:-4,angle:0,stun:0,phase:2},{type:f===2?'ghost':'spider',x:0,z:-4,angle:0,stun:0,phase:4},...(f>0?[{type:'ghost',x:8,z:4,angle:0,stun:0,phase:6}]:[])];}\nfunction saveFloor(){state.floors[state.floor]={items:state.items,doors:state.doors,candles:state.candles.map(({x,z,lit})=>({x,z,lit})),visited:state.visited};}\nfunction loadFloor(f,entry){saveFloor();state.floor=f;let stored=state.floors[f];state.items=stored?.items||floorItems(f);state.doors=stored?.doors||floorDoors(f);state.candles=stored?.candles||[{x:1.4,z:4,lit:true},{x:-1,z:-4,lit:false}];state.visited=stored?.visited||Array(6).fill(false);state.enemies=enemies(f);state.players.forEach((p,i)=>{p.x=entry.x+i*.9;p.z=entry.z;p.invincible=2;});buildFloor();audio.play('stairs');ui.toast(['Ground floor','First floor','The attic'][f],rooms[f][roomIndex(state.players[0])]);}\nfunction start(demo=false,count=net.connected?2:1){attract=demo;state=newState(count);state.enemies=enemies(0);mode='play';net.beginRound?.();debugReveal=false;scene.mode(false);buildFloor();ui.setScreen('none');resize();if(\"'!demo){audio.play('\"'door');ui.toast('The urn is in three pieces.','Find the brass key in the parlor.');}last=performance.now();}\nfunction goTitle(){mode='title';attract=false;scene.mode(true);ui.setScreen('title');mapVisible=false;\"'$('\"'#map')?.remove();idle=performance.now();resize();}\nfunction roomIndex(p){return clamp(Math.floor((p.x+12)/8),0,2)+clamp(Math.floor((p.z+8)/8),0,1)*3;}\nfunction buildFloor(){buildFloorIndex=state.floor;scene.buildFloor(state.floor,rooms[state.floor],state.doors,state.items,state.candles);rebuildPhysics();scene.sync(state);}\nfunction rebuildPhysics(){for(let c of colliders)physics.removeCollider(c,true);colliders=[];const wall=(x,z,hx,hz)=>{colliders.push(physics.createCollider(RAPIER.ColliderDesc.cuboid(hx,2,hz).setTranslation(x,1,z)));};wall(-12,0,.15,8);wall(12,0,.15,8);wall(0,-8,12,.15);wall(0,8,12,.15);for(let x of [-4,4])for(let z of [-4,4])for(let d of [-1,1])wall(x,z+d*2.55,.12,1.43);for(let x of [-8,0,8])for(let d of [-1,1])wall(x+d*2.55,0,1.43,.12);for(let d of state.doors)if(d.locked)wall(d.x,d.z,d.axis==='x'?.15:.95,d.axis==='x'?.95:.15);}\nfunction nearestInteraction(p){let options=[];for(let i of state.items)if(\"'!i.taken&&dist(p,i)<1.65)options.push({kind:'\"'item',data:i,d:dist(p,i),label:i.type==='key'?'Take brass key':i.type==='ward'?'Take spirit ward':'Recover urn fragment'});for(let d of state.doors)if(d.locked&&dist(p,d)<1.9)options.push({kind:'door',data:d,d:dist(p,d),label:p.tool==='key'?'Unlock door':'Locked · find the brass key'});for(let c of state.candles)if(\"'!c.lit&&dist(p,c)<1.8)options.push({kind:'\"'candle',data:c,d:dist(p,c),label:'Light sanctuary candle'});let f=state.floor;const up={x:f===0?9:-9,z:5},down={x:f===1?9:-9,z:5};if(f<2&&dist(p,up)<1.65)options.push({kind:'up',data:up,d:dist(p,up),label:'Climb to '+(f===0?'first floor':'the attic')});if(f>0&&dist(p,down)<1.65)options.push({kind:'down',data:down,d:dist(p,down),label:'Go downstairs'});if(f===0&&dist(p,{x:0,z:7.3})<1.8)options.push({kind:'exit',d:0,label:state.fragments===3?'Escape with the urn':'The exit · '+state.fragments+'/3 fragments'});return options.sort((a,b)=>a.d-b.d)[0];}\nfunction drop(p){if(\"'!p.tool)return;let old=p.tool;state.items.push({id:old+'\"'-'+state.time,type:old,x:p.x,z:p.z,taken:false});scene.addItem(state.items.at(-1));p.tool=null;audio.play('pickup');}\nfunction interact(index=0){if(mode\"'!=='\"'play'||net.role==='guest')return;let p=state.players[index],o=nearestInteraction(p);if(\"'!o)return;let i=o.data;switch(o.kind){case'\"'item':if(i.type==='shard'){i.taken=true;state.fragments++;state.fragmentFloors.push(state.floor);audio.play('pickup');audio.gibberish('happy');ui.toast(state.fragments===3?'The urn is whole.':'A piece of the past.','URN FRAGMENTS  '+state.fragments+' / 3'+(state.fragments===3?' · Return to the entrance.':''));}else{drop(p);p.tool=i.type;i.taken=true;audio.play('pickup');ui.toast(i.type==='key'?'Brass key acquired.':'Spirit ward acquired.',i.type==='key'?'Opens the house’s three locked doors.':'Your flash now drives spirits farther away.');}break;case'door':if(p.tool==='key'){i.locked=false;buildFloor();audio.play('door');ui.toast('A reluctant click.','The way is open.');}else{audio.gibberish('curious');ui.toast('It refuses to budge.','The brass key is in the ground-floor parlor.');}break;case'candle':i.lit=true;p.light=tuning.lantern;state.lives=Math.min(tuning.lives,state.lives+1);buildFloor();audio.play('match');ui.toast('A little sanctuary.','Courage restored. Spirits keep their distance.');break;case'up':loadFloor(state.floor+1,{x:state.floor===0?9:-9,z:5});break;case'down':loadFloor(state.floor-1,{x:state.floor===1?9:-9,z:5});break;case'exit':if(state.fragments===3)showResult(true);else ui.toast('You cannot leave it behind.','Find all three urn fragments, one on each floor.');}}\nfunction pulse(index=0){if(mode\"'!=='\"'play'||net.role==='guest')return;let p=state.players[index];if(p.light<=0){p.light=tuning.lantern;state.matches++;audio.play('match');ui.toast('A match against the dark.','Keep moving.');return;}if(p.cooldown>0)return;p.cooldown=p.tool==='ward'?3:4;p.light=Math.max(0,p.light-3);let range=p.tool==='ward'?5:2.6;for(let e of state.enemies)if(dist(p,e)<range){e.stun=p.tool==='ward'?5:2.4;let dd=dist(p,e)||1;e.x=clamp(e.x+(e.x-p.x)/dd*1.5,-11,11);e.z=clamp(e.z+(e.z-p.z)/dd*1.5,-7,7);}audio.play('pulse');const ring=scene.ring(scene.actors,range,'#f0d69a',p.x,.15,p.z);ring.material=ring.material.clone();ring.material.transparent=true;ring.userData.life=.5;p.pulse=.5;effects.push(ring);}\nlet effects=[];\nfunction hurt(p){if(p.invincible>0||attract)return;state.lives--;state.hits++;p.invincible=4;p.light=0;shake=.5;audio.play('hurt');audio.gibberish('scared');ui.toast('Something brushed past you.','Relight your match. Stay near sanctuary candles.');if(state.lives<=0)showResult(false);}\nfunction showResult(won,send=true){if(\"'!state||state.resultShown)return;state.result=won?'\"'win':'lose';state.resultShown=true;mode=won?'win':'lose';attract=false;let score=state.fragments*1000+Math.max(0,Math.round(600-state.elapsed))*2+state.lives*100;ui.setScreen(mode,{time:Math.floor(state.elapsed),score,fragments:state.fragments,matches:state.matches,hits:state.hits});audio.play(mode);if(send)net.finish(won,score,{fragments:state.fragments,time:state.elapsed});}\nfunction move(p,x,z,dt){const len=Math.hypot(x,z);p.moving=len>.08;if(len>1){x/=len;z/=len;}if(len>.08){p.angle=Math.atan2(x,z);body.setTranslation({x:p.x,y:.55,z:p.z},true);controller.computeColliderMovement(body.collider(0),{x:x*tuning.speed*dt,y:0,z:z*tuning.speed*dt});const m=controller.computedMovement();p.x+=m.x;p.z+=m.z;}p.cooldown=Math.max(0,p.cooldown-dt);p.invincible=Math.max(0,p.invincible-dt);}\nfunction update(dt){state.time+=dt;state.elapsed+=dt;state.windIn-=dt;const input=getMove();if(net.role==='guest'){net.sendInput({...input,interact:guestActions.interact,pulse:guestActions.pulse,drop:guestActions.drop});guestActions={};return;}\n if(net.connected||net.active)state.playerCount=net.playerCount>=2?2:state.playerCount;\n if(attract){demoUpdate(dt);}else{move(state.players[0],input.x,input.z,dt);if(state.playerCount>1){move(state.players[1],remoteInput.x||0,remoteInput.z||0,dt);if(remoteInput.interact){interact(1);remoteInput.interact=false;}if(remoteInput.pulse){pulse(1);remoteInput.pulse=false;}if(remoteInput.drop){drop(state.players[1]);remoteInput.drop=false;}}}\n for(let p of state.players.slice(0,state.playerCount)){state.visited[roomIndex(p)]=true;let safe=state.candles.some(c=>c.lit&&dist(c,p)<2.1);if(safe)p.light=Math.min(tuning.lantern,p.light+dt*8);else p.light=Math.max(0,p.light-dt);if(device==='touch'&&\"'!attract){if(p.light<=0)pulse(p.index);let o=nearestInteraction(p);if(o&&o.kind==='\"'item')interact(p.index);if(p.tool==='ward'&&state.enemies.some(e=>dist(e,p)<3&&e.stun<=0))pulse(p.index);}}\n if(state.windIn<=0){state.windIn=20+state.floor*2;for(let p of state.players.slice(0,state.playerCount))if(\"'!state.candles.some(c=>c.lit&&dist(c,p)<2.1))p.light=0;audio.play('\"'extinguish');if(\"'!attract)ui.toast('\"'A cold breath through the halls.','Relight your match.');}\n for(let e of state.enemies){e.stun=Math.max(0,e.stun-dt);if(e.stun>0)continue;let p=state.players.slice(0,state.playerCount).reduce((a,b)=>dist(a,e)<dist(b,e)?a:b);let target={x:Math.sin(state.time*.25+e.phase)*9,z:Math.cos(state.time*.3+e.phase)*5};let nearby=dist(e,p)<(p.tool==='key'?9:6);if(nearby&&p.light>0)target=p;let speed=(e.type==='bat'?2:e.type==='spider'?1.1:1.45)*tuning.enemy;let dd=dist(e,target);if(dd>.1){let dx=(target.x-e.x)/dd,dz=(target.z-e.z)/dd;let safe=state.candles.find(c=>c.lit&&dist(c,e)<2.5);if(safe){dx=(e.x-safe.x)/(dist(e,safe)||1);dz=(e.z-safe.z)/(dist(e,safe)||1);}e.x=clamp(e.x+dx*speed*dt,-11.5,11.5);e.z=clamp(e.z+dz*speed*dt,-7.5,7.5);e.angle=Math.atan2(dx,dz);}if(dist(e,p)<.7)hurt(p);}\n steps+=dt;if(state.players[0].moving&&steps>.32){audio.play('step');steps=0;}physics.step();net.broadcast(state);\n}\nlet demoStage=0,demoClock=0;const demoRoute=[{floor:0,x:-8,z:4,action:'key'},{floor:0,x:-8,z:1.2,action:'door'},{floor:0,x:-8,z:-4,action:'shard'},{floor:0,x:0,z:-4,action:'ward'},{floor:0,x:9,z:5,action:'up'},{floor:1,x:8,z:1.2,action:'door'},{floor:1,x:8,z:-4,action:'shard'},{floor:1,x:-9,z:5,action:'up'},{floor:2,x:-8,z:1.2,action:'door'},{floor:2,x:-8,z:-4,action:'shard'},{floor:2,x:-9,z:5,action:'down'},{floor:1,x:9,z:5,action:'down'},{floor:0,x:0,z:7,action:'exit'}];\nfunction demoUpdate(dt){demoClock+=dt;if(demoClock>65){demoClock=0;demoStage=0;start(true);return;}let t=demoRoute[demoStage];if(\"'!t){demoStage=0;demoClock=0;start(true);return;}let p=state.players[0];p.invincible=99;p.light=tuning.lantern;let d=dist(p,t);p.moving=true;p.angle=Math.atan2(t.x-p.x,t.z-p.z);if(d>.5){p.x+=(t.x-p.x)/d*5*dt;p.z+=(t.z-p.z)/d*5*dt;}else{if(t.action==='\"'door'){p.tool='key';let door=state.doors.find(q=>q.locked);if(door){door.locked=false;buildFloor();}}else if(t.action==='exit'){demoStage=0;demoClock=0;start(true);return;}else interact();demoStage++;}if(Math.floor(state.time*2)%9===0)pulse();}\nlet guestActions={};function act(name){if(net.role==='guest'){guestActions[name]=true;return;}if(name==='interact')interact();if(name==='pulse')pulse();if(name==='drop')drop(state.players[0]);}\nfunction pause(){if(mode==='play'&&\"'!attract){mode='\"'pause';ui.setScreen('pause');}else if(mode==='pause'){mode='play';ui.setScreen('none');}}\nfunction action(name,value){inputActivity();audio.play('menu');switch(name){case'start':case'restart':start();break;case'title':net.disconnect();goTitle();break;case'resume':mode='play';ui.setScreen('none');break;case'help':case'settings':case'about':case'dev':case'online':ui.setScreen(name,name==='about'?about:name==='settings'?settings:name==='dev'?tuning:{});break;case'back':if(state&&mode\"'!=='\"'title'){mode='pause';ui.setScreen('pause');}else goTitle();break;case'setting':settings[value.key]=value.value;audio.setMusic(settings.music);audio.setSfx(settings.sfx);scene.brightness.value=settings.brightness;ui.setDevice(device,settings.glyph);try{localStorage.setItem('urn-settings',JSON.stringify(settings));}catch{}break;case'tune':tuning[value.key]=Number(value.value);if(value.key==='lives'&&state)state.lives=Math.min(state.lives,tuning.lives);break;case'refill':state.lives=tuning.lives;state.players.forEach(p=>{p.light=tuning.lantern;p.invincible=10;});ui.toast('Courage and light restored.');break;case'reveal':debugReveal=\"'!debugReveal;toggleMap(true);break;case'\"'grant-fragments':state.fragments=3;state.fragmentFloors=[0,1,2];state.items.filter(i=>i.type==='shard').forEach(i=>i.taken=true);ui.toast('The urn is whole.');break;case'teleport-exit':loadFloor(0,{x:0,z:6.5});ui.toast('Returned to the entrance.');break;case'reset-defaults':tuning={...defaults};ui.setScreen('dev',tuning);break;case'host':net.host().then?.(code=>ui.updateOnline?.({roomCode:code,status:'Room ready. Open this game in another tab and enter the code.'}));break;case'join':net.join(value);break;case'create-offer':ui.updateOnline?.({status:'Creating a direct invitation…'});net.createOffer().then(code=>ui.updateOnline?.({signalCode:code,signalLabel:'Send this invitation to your friend.',status:'Waiting for your friend’s answer.'})).catch(e=>ui.updateOnline?.({status:e.message}));break;case'accept-offer':net.acceptOffer(value).then(code=>ui.updateOnline?.({signalCode:code,signalLabel:'Send this answer back to the host.',status:'Answer ready. Waiting for connection.'})).catch(e=>ui.updateOnline?.({status:e.message}));break;case'accept-answer':net.acceptAnswer(value).catch(e=>ui.updateOnline?.({status:e.message}));break;case'interact':act('interact');break;case'pause':pause();break;}}\nfunction getMove(){let x=(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0),z=(keys.has('KeyS')||keys.has('ArrowDown')?1:0)-(keys.has('KeyW')||keys.has('ArrowUp')?1:0);let pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(pad){x+=Math.abs(pad.axes[0])>.18?pad.axes[0]:0;z+=Math.abs(pad.axes[1])>.18?pad.axes[1]:0;}if(touch.active){x+=touch.x;z+=touch.z;} // Screen-oriented motion for the oblique camera.\n let wx=x*.793+z*.61,wz=z*.793-x*.61;if(mouseTarget&&Math.hypot(x,z)<.05&&state){let p=state.players[net.role==='guest'?1:0],d=dist(p,mouseTarget);if(d>.25){wx=(mouseTarget.x-p.x)/d;wz=(mouseTarget.z-p.z)/d;}else mouseTarget=null;}\n return {x:wx,z:wz};}\nfunction gamepad(dt){let pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(\"'!pad){padPrevious=[];return;}const down=i=>!!pad.buttons[i]?.pressed,pressed=i=>down(i)&&!padPrevious[i];let any=pad.buttons.some(b=>b.pressed)||pad.axes.some(a=>Math.abs(a)>.2);if(any)inputActivity('\"'gamepad');if(attract&&any)return;let menu=ui.screen\"'!=='\"'none';if(menu){menuRepeat-=dt;let dx=(down(15)?1:0)-(down(14)?1:0)+(Math.abs(pad.axes[0])>.55?Math.sign(pad.axes[0]):0),dy=(down(13)?1:0)-(down(12)?1:0)+(Math.abs(pad.axes[1])>.55?Math.sign(pad.axes[1]):0);if((dx||dy)&&menuRepeat<=0){ui.navigate(dx,dy);menuRepeat=.2;}if(pressed(0))ui.confirm();if(pressed(1))ui.back();}else{if(pressed(0))act('interact');if(pressed(2))act('pulse');if(pressed(3))act('drop');if(pressed(17)||pressed(8))toggleMap();}if(pressed(9))pause();padPrevious=pad.buttons.map(b=>b.pressed);}\nfunction toggleMap(force){if(\"'!state)return;mapVisible=force===undefined?!mapVisible:force;$('\"'#map')?.remove();if(\"'!mapVisible)return;let el=document.createElement('\"'div');el.id='map';el.innerHTML='<div class=\\\"map-heading\\\">HOUSE NOTES <span>'+['GROUND FLOOR','FIRST FLOOR','ATTIC'][state.floor]+'</span></div><div class=\\\"map-grid\\\">'+rooms[state.floor].map((r,i)=>{let seen=state.visited[i]||debugReveal,active=roomIndex(state.players[net.role==='guest'?1:0])===i;return '<div class=\\\"map-room '+(active?'current':'')+'\\\">'+(seen?r:'Unexplored')+'<small>'+(active?'YOU ARE HERE':seen&&state.items.some(it=>it.type==='shard'&&\"'!it.taken&&roomIndex(it)===i)?'\"'URN FRAGMENT':seen&&state.items.some(it=>it.type==='key'&&\"'!it.taken&&roomIndex(it)===i)?'\"'BRASS KEY':'')+'</small></div>';}).join('')+'</div><p>One urn fragment on each floor. Stairs connect the landings.</p>';el.onclick=()=>toggleMap();document.body.append(el);}\nfunction resize(){if(\"'!renderer)return;renderer.setSize(innerWidth,innerHeight);scene.resize(innerWidth,innerHeight,mode==='\"'title'?'title':'play');}\nfunction controls(){window.addEventListener('resize',resize);window.addEventListener('keydown',e=>{if(['INPUT','TEXTAREA'].includes(e.target.tagName))return;let wasAttract=attract;inputActivity('keyboard');if(wasAttract){e.preventDefault();return;}keys.add(e.code);if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code))e.preventDefault();if(e.repeat)return;if(ui.screen\"'!=='\"'none'){if(e.code==='ArrowDown'||e.code==='KeyS')ui.navigate(0,1);if(e.code==='ArrowUp'||e.code==='KeyW')ui.navigate(0,-1);if(e.code==='ArrowLeft'||e.code==='KeyA')ui.navigate(-1,0);if(e.code==='ArrowRight'||e.code==='KeyD')ui.navigate(1,0);if(e.code==='Enter'||e.code==='Space')ui.confirm();if(e.code==='Escape')ui.back();}else{if(e.code==='KeyE'||e.code==='Enter')act('interact');if(e.code==='Space')act('pulse');if(e.code==='KeyQ')act('drop');if(e.code==='KeyM'||e.code==='Tab')toggleMap();if(e.code==='Escape')pause();}});window.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();touch.active=false;if(mode==='play'&&\"'!attract&&net.role==='\"'solo')pause();});\n renderer.domElement.addEventListener('pointerdown',e=>{if(e.pointerType==='touch')return;let wasAttract=attract;inputActivity('keyboard');if(wasAttract||mode\"'!=='\"'play')return;const ray=new THREE.Raycaster();ray.setFromCamera(new THREE.Vector2(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1),scene.camera);let p=new THREE.Vector3();ray.ray.intersectPlane(new THREE.Plane(new THREE.Vector3(0,1,0),0),p);mouseTarget={x:clamp(p.x,-11.5,11.5),z:clamp(p.z,-7.5,7.5)};let own=state.players[net.role==='guest'?1:0],o=nearestInteraction(own);if(o&&dist(mouseTarget,o.data||{x:0,z:7.3})<2){act('interact');mouseTarget=null;}});\n window.addEventListener('touchstart',e=>{let wasAttract=attract;inputActivity('touch');if(wasAttract||mode\"'!=='\"'play'||e.target.closest('button,input,textarea'))return;e.preventDefault();for(let t of e.changedTouches)if(\"'!touch.active){touch={active:true,id:t.identifier,ox:t.clientX,oy:t.clientY,x:0,z:0};let mark=$('\"'#touch-marker');mark.style.left=t.clientX+'px';mark.style.top=t.clientY+'px';mark.hidden=false;}},{passive:false});window.addEventListener('touchmove',e=>{if(\"'!touch.active)return;e.preventDefault();for(let t of e.changedTouches)if(t.identifier===touch.id){touch.x=clamp((t.clientX-touch.ox)/65,-1,1);touch.z=clamp((t.clientY-touch.oy)/65,-1,1);}},{passive:false});window.addEventListener('\"'touchend',e=>{for(let t of e.changedTouches)if(t.identifier===touch.id){touch.active=false;touch.x=touch.z=0;\"'$('\"'#touch-marker').hidden=true;}});}\nfunction frame(now){let dt=Math.min((now-last)/1000,.05);last=now;gamepad(dt);if(mode==='title'&&now-idle>10000&&\"'!loading){demoStage=0;demoClock=0;start(true);}if(mode==='\"'play'&&state){update(dt);scene.sync(state);if(now-lastHud>100){lastHud=now;let p=state.players[net.role==='guest'?1:0],o=nearestInteraction(p);ui.updateHUD({floorName:['GROUND FLOOR','FIRST FLOOR','THE ATTIC'][state.floor],roomName:rooms[state.floor][roomIndex(p)],fragments:state.fragments,lives:state.lives,maxLives:tuning.lives,tool:p.tool==='key'?'Brass key':p.tool==='ward'?'Spirit ward':'Empty hands',lantern:p.light/tuning.lantern,context:o?.label||'',objective:state.fragments===3?'Return to the entrance.':'Recover the urn · '+state.fragments+'/3 fragments',cooldown:p.cooldown,attract});\"'$('\"'#attract')?.remove();if(attract){let a=document.createElement('div');a.id='attract';a.textContent='A MIDNIGHT PREVIEW  ·  ANY INPUT TO RETURN';document.body.append(a);}if(mapVisible)toggleMap(true);}audio.update(dt,{playing:\"'!attract,danger:state.enemies.some(e=>dist(e,p)<4)?1:0});}else audio.update(dt,{playing:false,danger:0});scene.update(dt,now/1000);for(let e of effects){e.userData.life-=dt;e.scale.setScalar(1+(0.5-e.userData.life)*2);e.material.opacity=Math.max(0,e.userData.life*1.5);if(e.userData.life<=0){scene.actors.remove(e);effects=effects.filter(x=>x!==e);}}if(!attract)$('\"'#attract')?.remove();renderer.render(scene.scene,scene.camera);requestAnimationFrame(frame);}\nasync function init(){try{await RAPIER.init();physics=new RAPIER.World({x:0,y:0,z:0});body=physics.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0,.55,5));physics.createCollider(RAPIER.ColliderDesc.ball(.32),body);controller=physics.createCharacterController(.02);controller.setSlideEnabled(true);scene=new Visuals();renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;document.body.prepend(renderer.domElement);await renderer.init();ui=new UI({onAction:action,onInput:()=>inputActivity()});ui.mount();ui.setDevice(device,settings.glyph);audio.setMusic(settings.music);audio.setSfx(settings.sfx);scene.brightness.value=settings.brightness;document.body.insertAdjacentHTML('beforeend','<div id=\\\"touch-marker\\\" hidden></div>');controls();goTitle();loading=false;\"'$('\"'#loading')?.remove();net.init();window.__URN={get state(){return state},get mode(){return mode},get attract(){return attract},get ui(){return ui},get network(){return net},get audio(){return audio},get renderer(){return renderer},get settings(){return settings},get tuning(){return tuning},start,interact,pulse,loadFloor,action,move,nearestInteraction,toggleMap,get debug(){return debugReveal},teleport(x,z){state.players[0].x=x;state.players[0].z=z;},advance(dt){update(dt);},setAbout(data){about=data;},get physics(){return physics},get backend(){return renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2 fallback'}};requestAnimationFrame(frame);}catch(e){console.error(e);\"'$('\"'#loading').innerHTML='<h1>The house won’t open.</h1><p>'+e.message+'</p><p>Connect to the internet for the engine dependencies, then reload in a current browser.</p>';}}\ninit();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > game.js <<'EOF'\nimport * as RAPIER from '@dimforge/rapier3d-compat';\nimport {Visuals,THREE} from './visuals.js';\nimport {UI} from './ui.js';\nimport {AudioEngine} from './audio.js';\nimport {Network} from './network.js';\nconst \"'$=s=>document.querySelector(s),clamp=(x,a,b)=>Math.max(a,Math.min(b,x)),dist=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z);\nconst defaults={speed:4,enemy:1,lantern:35,lives:3};let tuning={...defaults};let settings={music:.1,sfx:.55,brightness:1,glyph:'\"'ps',reducedMotion:false};try{Object.assign(settings,JSON.parse(localStorage.getItem('urn-settings')||'{}'));}catch{}\nconst rooms=[['The Locked Study','Portrait Gallery','Dusty Nursery','Faded Parlor','Entrance Hall','Dining Room'],['Cold Conservatory','Music Room','The Sealed Library','Servants’ Landing','Clock Gallery','East Landing'],['Urn Chamber','The Widow’s Walk','Moonlit Attic','West Landing','Cobweb Hall','Forgotten Observatory']];\nlet scene,renderer,physics,controller,body,colliders=[],last=performance.now(),state,mode='title',attract=false,idle=performance.now(),titlePhase=0,buildFloorIndex=-1,steps=0,shake=0,device='keyboard',padPrevious=[],menuRepeat=0,accum=0,mapVisible=false,debugReveal=false,loading=true,lastHud=0,remoteInput={x:0,z:0};const keys=new Set();let touch={active:false,id:null,x:0,z:0,ox:0,oy:0};let mouseTarget=null;const audio=new AudioEngine();let ui;let about={};\nconst net=new Network({onStatus:status=>{ui?.updateOnline?.({status,roomCode:net.roomCode||net.code||''});},onInput:(input,index)=>{remoteInput=input;},onSnapshot:s=>{if(net.role==='guest'){if(\"'!state||state.floor!==s.floor||buildFloorIndex!==s.floor){state=s;buildFloor();}else state=s;if(mode!=='\"'play'){mode='play';scene.mode(false);resize();ui.setScreen('none');}scene.sync(state);if(s.result&&\"'!state.resultShown)showResult(s.result==='\"'win',false);}},onStart:info=>{if(net.role\"'!=='\"'guest')start(false,info.playerCount||2);else{mode='play';ui.setScreen('none');}},onEnd:info=>{if(info.won\"'!==undefined)showResult(info.won,false);else{mode='\"'pause';ui.setScreen('pause');}},onTimeUp:()=>showResult(state?.fragments>=3)});\nfunction inputActivity(dev=device){idle=performance.now();if(loading)return;if(attract){attract=false;goTitle();return;}if(dev\"'!==device){device=dev;ui.setDevice(device,settings.glyph);}audio.init().catch(()=>{});}\nfunction player(x=0,z=5,index=0){return {x,z,angle:0,light:tuning.lantern,tool:null,moving:false,cooldown:0,invincible:0,index};}\nfunction floorItems(f){let a=[{id:`shard${f}`,type:'\"'shard',x:f===1?8:-8,z:-4,taken:false}];if(f===0)a.push({id:'key',type:'key',x:-8,z:4,taken:false},{id:'ward',type:'ward',x:0,z:-4,taken:false});return a;}\nfunction floorDoors(f){let a=[];for(let x of [-4,4])for(let z of [-4,4])a.push({x,z,axis:'x',locked:false});for(let x of [-8,0,8])a.push({x,z:0,axis:'z',locked:(f===1?x===8:x===-8)});return a;}\nfunction newState(count=1){return {floor:0,time:0,elapsed:0,fragments:0,fragmentFloors:[],lives:tuning.lives,playerCount:count,players:[player(),player(1,5,1)],items:floorItems(0),doors:floorDoors(0),candles:[{x:1.4,z:4,lit:true},{x:-1,z:-4,lit:false}],floors:{},enemies:[],visited:Array(6).fill(false),matches:0,hits:0,result:null,windIn:21};}\nfunction enemies(f){return [{type:'ghost',x:-8,z:-4,angle:0,stun:0,phase:0},{type:'bat',x:8,z:-4,angle:0,stun:0,phase:2},{type:f===2?'ghost':'spider',x:0,z:-4,angle:0,stun:0,phase:4},...(f>0?[{type:'ghost',x:8,z:4,angle:0,stun:0,phase:6}]:[])];}\nfunction saveFloor(){state.floors[state.floor]={items:state.items,doors:state.doors,candles:state.candles.map(({x,z,lit})=>({x,z,lit})),visited:state.visited};}\nfunction loadFloor(f,entry){saveFloor();state.floor=f;let stored=state.floors[f];state.items=stored?.items||floorItems(f);state.doors=stored?.doors||floorDoors(f);state.candles=stored?.candles||[{x:1.4,z:4,lit:true},{x:-1,z:-4,lit:false}];state.visited=stored?.visited||Array(6).fill(false);state.enemies=enemies(f);state.players.forEach((p,i)=>{p.x=entry.x+i*.9;p.z=entry.z;p.invincible=2;});buildFloor();audio.play('stairs');ui.toast(['Ground floor','First floor','The attic'][f],rooms[f][roomIndex(state.players[0])]);}\nfunction start(demo=false,count=net.connected?2:1){attract=demo;state=newState(count);state.enemies=enemies(0);mode='play';net.beginRound?.();debugReveal=false;scene.mode(false);buildFloor();ui.setScreen('none');resize();if(\"'!demo){audio.play('\"'door');ui.toast('The urn is in three pieces.','Find the brass key in the parlor.');}last=performance.now();}\nfunction goTitle(){mode='title';attract=false;scene.mode(true);ui.setScreen('title');mapVisible=false;\"'$('\"'#map')?.remove();idle=performance.now();resize();}\nfunction roomIndex(p){return clamp(Math.floor((p.x+12)/8),0,2)+clamp(Math.floor((p.z+8)/8),0,1)*3;}\nfunction buildFloor(){buildFloorIndex=state.floor;scene.buildFloor(state.floor,rooms[state.floor],state.doors,state.items,state.candles);rebuildPhysics();scene.sync(state);}\nfunction rebuildPhysics(){for(let c of colliders)physics.removeCollider(c,true);colliders=[];const wall=(x,z,hx,hz)=>{colliders.push(physics.createCollider(RAPIER.ColliderDesc.cuboid(hx,2,hz).setTranslation(x,1,z)));};wall(-12,0,.15,8);wall(12,0,.15,8);wall(0,-8,12,.15);wall(0,8,12,.15);for(let x of [-4,4])for(let z of [-4,4])for(let d of [-1,1])wall(x,z+d*2.55,.12,1.43);for(let x of [-8,0,8])for(let d of [-1,1])wall(x+d*2.55,0,1.43,.12);for(let d of state.doors)if(d.locked)wall(d.x,d.z,d.axis==='x'?.15:.95,d.axis==='x'?.95:.15);}\nfunction nearestInteraction(p){let options=[];for(let i of state.items)if(\"'!i.taken&&dist(p,i)<1.65)options.push({kind:'\"'item',data:i,d:dist(p,i),label:i.type==='key'?'Take brass key':i.type==='ward'?'Take spirit ward':'Recover urn fragment'});for(let d of state.doors)if(d.locked&&dist(p,d)<1.9)options.push({kind:'door',data:d,d:dist(p,d),label:p.tool==='key'?'Unlock door':'Locked · find the brass key'});for(let c of state.candles)if(\"'!c.lit&&dist(p,c)<1.8)options.push({kind:'\"'candle',data:c,d:dist(p,c),label:'Light sanctuary candle'});let f=state.floor;const up={x:f===0?9:-9,z:5},down={x:f===1?9:-9,z:5};if(f<2&&dist(p,up)<1.65)options.push({kind:'up',data:up,d:dist(p,up),label:'Climb to '+(f===0?'first floor':'the attic')});if(f>0&&dist(p,down)<1.65)options.push({kind:'down',data:down,d:dist(p,down),label:'Go downstairs'});if(f===0&&dist(p,{x:0,z:7.3})<1.8)options.push({kind:'exit',d:0,label:state.fragments===3?'Escape with the urn':'The exit · '+state.fragments+'/3 fragments'});return options.sort((a,b)=>a.d-b.d)[0];}\nfunction drop(p){if(\"'!p.tool)return;let old=p.tool;state.items.push({id:old+'\"'-'+state.time,type:old,x:p.x,z:p.z,taken:false});scene.addItem(state.items.at(-1));p.tool=null;audio.play('pickup');}\nfunction interact(index=0){if(mode\"'!=='\"'play'||net.role==='guest')return;let p=state.players[index],o=nearestInteraction(p);if(\"'!o)return;let i=o.data;switch(o.kind){case'\"'item':if(i.type==='shard'){i.taken=true;state.fragments++;state.fragmentFloors.push(state.floor);audio.play('pickup');audio.gibberish('happy');ui.toast(state.fragments===3?'The urn is whole.':'A piece of the past.','URN FRAGMENTS  '+state.fragments+' / 3'+(state.fragments===3?' · Return to the entrance.':''));}else{drop(p);p.tool=i.type;i.taken=true;audio.play('pickup');ui.toast(i.type==='key'?'Brass key acquired.':'Spirit ward acquired.',i.type==='key'?'Opens the house’s three locked doors.':'Your flash now drives spirits farther away.');}break;case'door':if(p.tool==='key'){i.locked=false;buildFloor();audio.play('door');ui.toast('A reluctant click.','The way is open.');}else{audio.gibberish('curious');ui.toast('It refuses to budge.','The brass key is in the ground-floor parlor.');}break;case'candle':i.lit=true;p.light=tuning.lantern;state.lives=Math.min(tuning.lives,state.lives+1);buildFloor();audio.play('match');ui.toast('A little sanctuary.','Courage restored. Spirits keep their distance.');break;case'up':loadFloor(state.floor+1,{x:state.floor===0?9:-9,z:5});break;case'down':loadFloor(state.floor-1,{x:state.floor===1?9:-9,z:5});break;case'exit':if(state.fragments===3)showResult(true);else ui.toast('You cannot leave it behind.','Find all three urn fragments, one on each floor.');}}\nfunction pulse(index=0){if(mode\"'!=='\"'play'||net.role==='guest')return;let p=state.players[index];if(p.light<=0){p.light=tuning.lantern;state.matches++;audio.play('match');ui.toast('A match against the dark.','Keep moving.');return;}if(p.cooldown>0)return;p.cooldown=p.tool==='ward'?3:4;p.light=Math.max(0,p.light-3);let range=p.tool==='ward'?5:2.6;for(let e of state.enemies)if(dist(p,e)<range){e.stun=p.tool==='ward'?5:2.4;let dd=dist(p,e)||1;e.x=clamp(e.x+(e.x-p.x)/dd*1.5,-11,11);e.z=clamp(e.z+(e.z-p.z)/dd*1.5,-7,7);}audio.play('pulse');const ring=scene.ring(scene.actors,range,'#f0d69a',p.x,.15,p.z);ring.material=ring.material.clone();ring.material.transparent=true;ring.userData.life=.5;p.pulse=.5;effects.push(ring);}\nlet effects=[];\nfunction hurt(p){if(p.invincible>0||attract)return;state.lives--;state.hits++;p.invincible=4;p.light=0;shake=.5;audio.play('hurt');audio.gibberish('scared');ui.toast('Something brushed past you.','Relight your match. Stay near sanctuary candles.');if(state.lives<=0)showResult(false);}\nfunction showResult(won,send=true){if(\"'!state||state.resultShown)return;state.result=won?'\"'win':'lose';state.resultShown=true;mode=won?'win':'lose';attract=false;let score=state.fragments*1000+Math.max(0,Math.round(600-state.elapsed))*2+state.lives*100;ui.setScreen(mode,{time:Math.floor(state.elapsed),score,fragments:state.fragments,matches:state.matches,hits:state.hits});audio.play(mode);if(send)net.finish(won,score,{fragments:state.fragments,time:state.elapsed});}\nfunction move(p,x,z,dt){const len=Math.hypot(x,z);p.moving=len>.08;if(len>1){x/=len;z/=len;}if(len>.08){p.angle=Math.atan2(x,z);body.setTranslation({x:p.x,y:.55,z:p.z},true);controller.computeColliderMovement(body.collider(0),{x:x*tuning.speed*dt,y:0,z:z*tuning.speed*dt});const m=controller.computedMovement();p.x+=m.x;p.z+=m.z;}p.cooldown=Math.max(0,p.cooldown-dt);p.invincible=Math.max(0,p.invincible-dt);}\nfunction update(dt){state.time+=dt;state.elapsed+=dt;state.windIn-=dt;const input=getMove();if(net.role==='guest'){net.sendInput({...input,interact:guestActions.interact,pulse:guestActions.pulse,drop:guestActions.drop});guestActions={};return;}\n if(net.connected||net.active)state.playerCount=net.playerCount>=2?2:state.playerCount;\n if(attract){demoUpdate(dt);}else{move(state.players[0],input.x,input.z,dt);if(state.playerCount>1){move(state.players[1],remoteInput.x||0,remoteInput.z||0,dt);if(remoteInput.interact){interact(1);remoteInput.interact=false;}if(remoteInput.pulse){pulse(1);remoteInput.pulse=false;}if(remoteInput.drop){drop(state.players[1]);remoteInput.drop=false;}}}\n for(let p of state.players.slice(0,state.playerCount)){state.visited[roomIndex(p)]=true;let safe=state.candles.some(c=>c.lit&&dist(c,p)<2.1);if(safe)p.light=Math.min(tuning.lantern,p.light+dt*8);else p.light=Math.max(0,p.light-dt);if(device==='touch'&&\"'!attract){if(p.light<=0)pulse(p.index);let o=nearestInteraction(p);if(o&&o.kind==='\"'item')interact(p.index);if(p.tool==='ward'&&state.enemies.some(e=>dist(e,p)<3&&e.stun<=0))pulse(p.index);}}\n if(state.windIn<=0){state.windIn=20+state.floor*2;for(let p of state.players.slice(0,state.playerCount))if(\"'!state.candles.some(c=>c.lit&&dist(c,p)<2.1))p.light=0;audio.play('\"'extinguish');if(\"'!attract)ui.toast('\"'A cold breath through the halls.','Relight your match.');}\n for(let e of state.enemies){e.stun=Math.max(0,e.stun-dt);if(e.stun>0)continue;let p=state.players.slice(0,state.playerCount).reduce((a,b)=>dist(a,e)<dist(b,e)?a:b);let target={x:Math.sin(state.time*.25+e.phase)*9,z:Math.cos(state.time*.3+e.phase)*5};let nearby=dist(e,p)<(p.tool==='key'?9:6);if(nearby&&p.light>0)target=p;let speed=(e.type==='bat'?2:e.type==='spider'?1.1:1.45)*tuning.enemy;let dd=dist(e,target);if(dd>.1){let dx=(target.x-e.x)/dd,dz=(target.z-e.z)/dd;let safe=state.candles.find(c=>c.lit&&dist(c,e)<2.5);if(safe){dx=(e.x-safe.x)/(dist(e,safe)||1);dz=(e.z-safe.z)/(dist(e,safe)||1);}e.x=clamp(e.x+dx*speed*dt,-11.5,11.5);e.z=clamp(e.z+dz*speed*dt,-7.5,7.5);e.angle=Math.atan2(dx,dz);}if(dist(e,p)<.7)hurt(p);}\n steps+=dt;if(state.players[0].moving&&steps>.32){audio.play('step');steps=0;}physics.step();net.broadcast(state);\n}\nlet demoStage=0,demoClock=0;const demoRoute=[{floor:0,x:-8,z:4,action:'key'},{floor:0,x:-8,z:1.2,action:'door'},{floor:0,x:-8,z:-4,action:'shard'},{floor:0,x:0,z:-4,action:'ward'},{floor:0,x:9,z:5,action:'up'},{floor:1,x:8,z:1.2,action:'door'},{floor:1,x:8,z:-4,action:'shard'},{floor:1,x:-9,z:5,action:'up'},{floor:2,x:-8,z:1.2,action:'door'},{floor:2,x:-8,z:-4,action:'shard'},{floor:2,x:-9,z:5,action:'down'},{floor:1,x:9,z:5,action:'down'},{floor:0,x:0,z:7,action:'exit'}];\nfunction demoUpdate(dt){demoClock+=dt;if(demoClock>65){demoClock=0;demoStage=0;start(true);return;}let t=demoRoute[demoStage];if(\"'!t){demoStage=0;demoClock=0;start(true);return;}let p=state.players[0];p.invincible=99;p.light=tuning.lantern;let d=dist(p,t);p.moving=true;p.angle=Math.atan2(t.x-p.x,t.z-p.z);if(d>.5){p.x+=(t.x-p.x)/d*5*dt;p.z+=(t.z-p.z)/d*5*dt;}else{if(t.action==='\"'door'){p.tool='key';let door=state.doors.find(q=>q.locked);if(door){door.locked=false;buildFloor();}}else if(t.action==='exit'){demoStage=0;demoClock=0;start(true);return;}else interact();demoStage++;}if(Math.floor(state.time*2)%9===0)pulse();}\nlet guestActions={};function act(name){if(net.role==='guest'){guestActions[name]=true;return;}if(name==='interact')interact();if(name==='pulse')pulse();if(name==='drop')drop(state.players[0]);}\nfunction pause(){if(mode==='play'&&\"'!attract){mode='\"'pause';ui.setScreen('pause');}else if(mode==='pause'){mode='play';ui.setScreen('none');}}\nfunction action(name,value){inputActivity();audio.play('menu');switch(name){case'start':case'restart':start();break;case'title':net.disconnect();goTitle();break;case'resume':mode='play';ui.setScreen('none');break;case'help':case'settings':case'about':case'dev':case'online':ui.setScreen(name,name==='about'?about:name==='settings'?settings:name==='dev'?tuning:{});break;case'back':if(state&&mode\"'!=='\"'title'){mode='pause';ui.setScreen('pause');}else goTitle();break;case'setting':settings[value.key]=value.value;audio.setMusic(settings.music);audio.setSfx(settings.sfx);scene.brightness.value=settings.brightness;ui.setDevice(device,settings.glyph);try{localStorage.setItem('urn-settings',JSON.stringify(settings));}catch{}break;case'tune':tuning[value.key]=Number(value.value);if(value.key==='lives'&&state)state.lives=Math.min(state.lives,tuning.lives);break;case'refill':state.lives=tuning.lives;state.players.forEach(p=>{p.light=tuning.lantern;p.invincible=10;});ui.toast('Courage and light restored.');break;case'reveal':debugReveal=\"'!debugReveal;toggleMap(true);break;case'\"'grant-fragments':state.fragments=3;state.fragmentFloors=[0,1,2];state.items.filter(i=>i.type==='shard').forEach(i=>i.taken=true);ui.toast('The urn is whole.');break;case'teleport-exit':loadFloor(0,{x:0,z:6.5});ui.toast('Returned to the entrance.');break;case'reset-defaults':tuning={...defaults};ui.setScreen('dev',tuning);break;case'host':net.host().then?.(code=>ui.updateOnline?.({roomCode:code,status:'Room ready. Open this game in another tab and enter the code.'}));break;case'join':net.join(value);break;case'create-offer':ui.updateOnline?.({status:'Creating a direct invitation…'});net.createOffer().then(code=>ui.updateOnline?.({signalCode:code,signalLabel:'Send this invitation to your friend.',status:'Waiting for your friend’s answer.'})).catch(e=>ui.updateOnline?.({status:e.message}));break;case'accept-offer':net.acceptOffer(value).then(code=>ui.updateOnline?.({signalCode:code,signalLabel:'Send this answer back to the host.',status:'Answer ready. Waiting for connection.'})).catch(e=>ui.updateOnline?.({status:e.message}));break;case'accept-answer':net.acceptAnswer(value).catch(e=>ui.updateOnline?.({status:e.message}));break;case'interact':act('interact');break;case'pause':pause();break;}}\nfunction getMove(){let x=(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0),z=(keys.has('KeyS')||keys.has('ArrowDown')?1:0)-(keys.has('KeyW')||keys.has('ArrowUp')?1:0);let pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(pad){x+=Math.abs(pad.axes[0])>.18?pad.axes[0]:0;z+=Math.abs(pad.axes[1])>.18?pad.axes[1]:0;}if(touch.active){x+=touch.x;z+=touch.z;} // Screen-oriented motion for the oblique camera.\n let wx=x*.793+z*.61,wz=z*.793-x*.61;if(mouseTarget&&Math.hypot(x,z)<.05&&state){let p=state.players[net.role==='guest'?1:0],d=dist(p,mouseTarget);if(d>.25){wx=(mouseTarget.x-p.x)/d;wz=(mouseTarget.z-p.z)/d;}else mouseTarget=null;}\n return {x:wx,z:wz};}\nfunction gamepad(dt){let pad=Array.from(navigator.getGamepads?.()||[]).find(Boolean);if(\"'!pad){padPrevious=[];return;}const down=i=>!!pad.buttons[i]?.pressed,pressed=i=>down(i)&&!padPrevious[i];let any=pad.buttons.some(b=>b.pressed)||pad.axes.some(a=>Math.abs(a)>.2);if(any)inputActivity('\"'gamepad');if(attract&&any)return;let menu=ui.screen\"'!=='\"'none';if(menu){menuRepeat-=dt;let dx=(down(15)?1:0)-(down(14)?1:0)+(Math.abs(pad.axes[0])>.55?Math.sign(pad.axes[0]):0),dy=(down(13)?1:0)-(down(12)?1:0)+(Math.abs(pad.axes[1])>.55?Math.sign(pad.axes[1]):0);if((dx||dy)&&menuRepeat<=0){ui.navigate(dx,dy);menuRepeat=.2;}if(pressed(0))ui.confirm();if(pressed(1))ui.back();}else{if(pressed(0))act('interact');if(pressed(2))act('pulse');if(pressed(3))act('drop');if(pressed(17)||pressed(8))toggleMap();}if(pressed(9))pause();padPrevious=pad.buttons.map(b=>b.pressed);}\nfunction toggleMap(force){if(\"'!state)return;mapVisible=force===undefined?!mapVisible:force;$('\"'#map')?.remove();if(\"'!mapVisible)return;let el=document.createElement('\"'div');el.id='map';el.innerHTML='<div class=\\\"map-heading\\\">HOUSE NOTES <span>'+['GROUND FLOOR','FIRST FLOOR','ATTIC'][state.floor]+'</span></div><div class=\\\"map-grid\\\">'+rooms[state.floor].map((r,i)=>{let seen=state.visited[i]||debugReveal,active=roomIndex(state.players[net.role==='guest'?1:0])===i;return '<div class=\\\"map-room '+(active?'current':'')+'\\\">'+(seen?r:'Unexplored')+'<small>'+(active?'YOU ARE HERE':seen&&state.items.some(it=>it.type==='shard'&&\"'!it.taken&&roomIndex(it)===i)?'\"'URN FRAGMENT':seen&&state.items.some(it=>it.type==='key'&&\"'!it.taken&&roomIndex(it)===i)?'\"'BRASS KEY':'')+'</small></div>';}).join('')+'</div><p>One urn fragment on each floor. Stairs connect the landings.</p>';el.onclick=()=>toggleMap();document.body.append(el);}\nfunction resize(){if(\"'!renderer)return;renderer.setSize(innerWidth,innerHeight);scene.resize(innerWidth,innerHeight,mode==='\"'title'?'title':'play');}\nfunction controls(){window.addEventListener('resize',resize);window.addEventListener('keydown',e=>{if(['INPUT','TEXTAREA'].includes(e.target.tagName))return;let wasAttract=attract;inputActivity('keyboard');if(wasAttract){e.preventDefault();return;}keys.add(e.code);if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code))e.preventDefault();if(e.repeat)return;if(ui.screen\"'!=='\"'none'){if(e.code==='ArrowDown'||e.code==='KeyS')ui.navigate(0,1);if(e.code==='ArrowUp'||e.code==='KeyW')ui.navigate(0,-1);if(e.code==='ArrowLeft'||e.code==='KeyA')ui.navigate(-1,0);if(e.code==='ArrowRight'||e.code==='KeyD')ui.navigate(1,0);if(e.code==='Enter'||e.code==='Space')ui.confirm();if(e.code==='Escape')ui.back();}else{if(e.code==='KeyE'||e.code==='Enter')act('interact');if(e.code==='Space')act('pulse');if(e.code==='KeyQ')act('drop');if(e.code==='KeyM'||e.code==='Tab')toggleMap();if(e.code==='Escape')pause();}});window.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();touch.active=false;if(mode==='play'&&\"'!attract&&net.role==='\"'solo')pause();});\n renderer.domElement.addEventListener('pointerdown',e=>{if(e.pointerType==='touch')return;let wasAttract=attract;inputActivity('keyboard');if(wasAttract||mode\"'!=='\"'play')return;const ray=new THREE.Raycaster();ray.setFromCamera(new THREE.Vector2(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1),scene.camera);let p=new THREE.Vector3();ray.ray.intersectPlane(new THREE.Plane(new THREE.Vector3(0,1,0),0),p);mouseTarget={x:clamp(p.x,-11.5,11.5),z:clamp(p.z,-7.5,7.5)};let own=state.players[net.role==='guest'?1:0],o=nearestInteraction(own);if(o&&dist(mouseTarget,o.data||{x:0,z:7.3})<2){act('interact');mouseTarget=null;}});\n window.addEventListener('touchstart',e=>{let wasAttract=attract;inputActivity('touch');if(wasAttract||mode\"'!=='\"'play'||e.target.closest('button,input,textarea'))return;e.preventDefault();for(let t of e.changedTouches)if(\"'!touch.active){touch={active:true,id:t.identifier,ox:t.clientX,oy:t.clientY,x:0,z:0};let mark=$('\"'#touch-marker');mark.style.left=t.clientX+'px';mark.style.top=t.clientY+'px';mark.hidden=false;}},{passive:false});window.addEventListener('touchmove',e=>{if(\"'!touch.active)return;e.preventDefault();for(let t of e.changedTouches)if(t.identifier===touch.id){touch.x=clamp((t.clientX-touch.ox)/65,-1,1);touch.z=clamp((t.clientY-touch.oy)/65,-1,1);}},{passive:false});window.addEventListener('\"'touchend',e=>{for(let t of e.changedTouches)if(t.identifier===touch.id){touch.active=false;touch.x=touch.z=0;\"'$('\"'#touch-marker').hidden=true;}});}\nfunction frame(now){let dt=Math.min((now-last)/1000,.05);last=now;gamepad(dt);if(mode==='title'&&now-idle>10000&&\"'!loading){demoStage=0;demoClock=0;start(true);}if(mode==='\"'play'&&state){update(dt);scene.sync(state);if(now-lastHud>100){lastHud=now;let p=state.players[net.role==='guest'?1:0],o=nearestInteraction(p);ui.updateHUD({floorName:['GROUND FLOOR','FIRST FLOOR','THE ATTIC'][state.floor],roomName:rooms[state.floor][roomIndex(p)],fragments:state.fragments,lives:state.lives,maxLives:tuning.lives,tool:p.tool==='key'?'Brass key':p.tool==='ward'?'Spirit ward':'Empty hands',lantern:p.light/tuning.lantern,context:o?.label||'',objective:state.fragments===3?'Return to the entrance.':'Recover the urn · '+state.fragments+'/3 fragments',cooldown:p.cooldown,attract});\"'$('\"'#attract')?.remove();if(attract){let a=document.createElement('div');a.id='attract';a.textContent='A MIDNIGHT PREVIEW  ·  ANY INPUT TO RETURN';document.body.append(a);}if(mapVisible)toggleMap(true);}audio.update(dt,{playing:\"'!attract,danger:state.enemies.some(e=>dist(e,p)<4)?1:0});}else audio.update(dt,{playing:false,danger:0});scene.update(dt,now/1000);for(let e of effects){e.userData.life-=dt;e.scale.setScalar(1+(0.5-e.userData.life)*2);e.material.opacity=Math.max(0,e.userData.life*1.5);if(e.userData.life<=0){scene.actors.remove(e);effects=effects.filter(x=>x!==e);}}if(!attract)$('\"'#attract')?.remove();renderer.render(scene.scene,scene.camera);requestAnimationFrame(frame);}\nasync function init(){try{await RAPIER.init();physics=new RAPIER.World({x:0,y:0,z:0});body=physics.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(0,.55,5));physics.createCollider(RAPIER.ColliderDesc.ball(.32),body);controller=physics.createCharacterController(.02);controller.setSlideEnabled(true);scene=new Visuals();renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;document.body.prepend(renderer.domElement);await renderer.init();ui=new UI({onAction:action,onInput:()=>inputActivity()});ui.mount();ui.setDevice(device,settings.glyph);audio.setMusic(settings.music);audio.setSfx(settings.sfx);scene.brightness.value=settings.brightness;document.body.insertAdjacentHTML('beforeend','<div id=\\\"touch-marker\\\" hidden></div>');controls();goTitle();loading=false;\"'$('\"'#loading')?.remove();net.init();window.__URN={get state(){return state},get mode(){return mode},get attract(){return attract},get ui(){return ui},get network(){return net},get audio(){return audio},get renderer(){return renderer},get settings(){return settings},get tuning(){return tuning},start,interact,pulse,loadFloor,action,move,nearestInteraction,toggleMap,get debug(){return debugReveal},teleport(x,z){state.players[0].x=x;state.players[0].z=z;},advance(dt){update(dt);},setAbout(data){about=data;},get physics(){return physics},get backend(){return renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2 fallback'}};requestAnimationFrame(frame);}catch(e){console.error(e);\"'$('\"'#loading').innerHTML='<h1>The house won’t open.</h1><p>'+e.message+'</p><p>Connect to the internet for the engine dependencies, then reload in a current browser.</p>';}}\ninit();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat network-integration.md && rg -n 'host\\\\(|roomCode|playerCount|connected|role =' network.js && rg -n 'mount\\\\(|setLoading|setScreen\\\\(|setDevice|onAction|setAttract|updateHUD|sfx|about' ui.js | head -100 && cat hub/README.md | head -100\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat network-integration.md && rg -n 'host\\\\(|roomCode|playerCount|connected|role =' network.js && rg -n 'mount\\\\(|setLoading|setScreen\\\\(|setDevice|onAction|setAttract|updateHUD|sfx|about' ui.js | head -100 && cat hub/README.md | head -100\"","aggregated_output":"# Urn Welcome networking\n\n`network.js` exports `Network`. It has no module dependencies. Paste `hub/session.js` unchanged as the first script immediately after `<meta charset>` in the final HTML, as required by AI Hub Protocol v1 (client 1.4.0).\n\nRequired head metadata:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-2\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Recover the three urn fragments and escape together.\">\n<meta name=\"hub:session-howto\" content=\"Move: left stick / WASD. Interact: Cross / E. Light: Square / Space. Map: Triangle / M. Pause: Options / Esc.\">\n<meta name=\"hub:session-minutes\" content=\"8\">\n```\n\nConstruct with callbacks `onStatus(text)`, `onSnapshot(state)`, `onInput(input, playerIndex)`, `onStart(startInfo)`, `onEnd(result)`, optional `onTimeUp()`. After the renderer, physics and game state have loaded, call `await net.init()`. It connects and calls ready automatically in a hub session. No title menu or prompt is allowed in that session. `onStart` fires when the hub's three-second countdown expires.\n\n`startInfo` includes `{ hub, info, localIndex, playerCount, server, role }`. In dedicated-server sessions, the authoritative copy has `server=true`, `localIndex=-1`: simulate all explorers but apply no local input. Other copies are guests, including player index zero. Normal hosted sessions have host player index zero and guest index one. `net.active` means AI Hub owns lifecycle and networking.\n\nDuring play, the authoritative world calls `net.broadcast(serializableState)` every frame; it is throttled to 12 Hz. Guest copies call `net.sendInput(input)` every frame, throttled to 15 Hz. Each guest receives snapshots through `onSnapshot` and never simulates gameplay authority. Host receives each guest's controls through `onInput(input,index)`.\n\nCall `net.finish(won, score, stats)` from the host on victory/defeat. Hub players tie as a co-op team. `onTimeUp` can call `finish` with the final score; otherwise the wrapper reports defeat automatically. `onEnd` must stop gameplay/input/audio. Ignore Options when Create is held in a hub session. A departed player generates neutral controls with `disconnected:true`.\n\nOutside AI Hub, `net.host()` returns a four-letter local tab code. `net.join(code)` connects another tab on the same browser origin. These are local tabs only. For remote co-op, the host calls `await net.createOffer()`, sends that invitation string to the guest; guest calls `await net.acceptOffer(invitation)` and sends the returned answer string; host calls `await net.acceptAnswer(answer)`. A real reliable WebRTC data channel carries the same gameplay messages. Public STUN assists connectivity. There is no hosted game or signalling server and no TURN relay, so some restrictive NATs may prevent remote connections. The UI should explain this honestly.\n\n`onStart` fires on both copies once a standalone peer joins. `beginRound()` clears standalone result guards for a rematch. `disconnect()` closes only this game's channels. Hub disconnects are governed by the hub, so it does nothing when active.\n\nRun the real browser transport checks with:\n\n```sh\n/home/micha/.local/share/pipx/venvs/playwright/bin/python test-network.py\n```\n\nIt owns its ephemeral 127.0.0.1 HTTP server and Chromium browser, and closes both. It checks BroadcastChannel and actual WebRTC data-channel pairing, controls, snapshots, result reporting, disconnects and rematch reset.\n\nFor hub conformance, serve the final game and `hub/harness.html` under the same server root. Open `hub/harness.html?game=../GAME.html&players=2&auto=1`. Run again with `scenario=server`, `scenario=host-leave`, and simulated `latency=150&jitter=50&loss=5`. The supported seat range is 1–2, so use two players. The completed result is `window.__hubCheck`.\n5:    this.role='solo'; this.connected=false; this.active=false; this.ended=false;\n6:    this.room=''; this.localIndex=0; this.playerCount=1; this.server=false;\n21:        this.connected=true;\n23:        this.onStatus(this.server?'AI Hub · world server':`AI Hub · ${this.playerCount} explorers`);\n28:      if(index>=0&&this.role==='host')this.onInput({x:0,y:0,action:false,light:false,disconnected:true},index);\n37:      this.ended=true;this.connected=false;clearTimeout(this.startTimer);\n45:      this.playerCount=info.players.length;\n54:  startInfo(){return {hub:this.active,info:this.info,localIndex:this.localIndex,playerCount:this.playerCount,server:this.server,role:this.role};}\n55:  host() {\n60:    this.role='host';this.localIndex=0;this.playerCount=1;this.ended=false;\n70:    this.room=code;this.role='guest';this.localIndex=1;this.playerCount=2;this.ended=false;\n74:      if(this.connected)return;\n91:            this.peer='';this.connected=false;this.playerCount=1;\n92:            this.onInput({x:0,y:0,action:false,light:false,disconnected:true},1);\n93:            this.onStatus(`Room ${this.room} · explorer disconnected`);\n95:            this.onStatus('The host disconnected');this.onEnd({reason:'host-left'});this.disconnect(false);\n100:        if(this.role==='guest'&&!this.connected)this.channel.postMessage({t:'hello',sender:this.token});\n112:        this.connected=true;this.onSnapshot(data.state);\n119:      const wasConnected=this.connected;\n120:      this.peer=from;this.connected=true;this.playerCount=2;this.lastSeen=performance.now();\n125:    if(data.t==='full'&&this.role==='guest'&&!this.connected){\n129:      const wasConnected=this.connected;this.peer=from;this.connected=true;clearTimeout(this.joinTimer);this.lastSeen=performance.now();\n130:      this.onStatus(`Room ${this.room} · connected`);if(!wasConnected)this.onStart(this.startInfo());return;\n135:      this.connected=false;this.peer='';\n137:        this.playerCount=1;this.onInput({x:0,y:0,action:false,light:false,disconnected:true},1);\n145:    if(this.role!=='guest'||!this.connected||this.ended)return false;\n157:    if(this.connected)this.sendData({t:'snapshot',state,sender:this.token,to:this.peer});\n158:    return this.connected;\n191:    this.playerCount=2;this.ended=false;this.transport='rtc';this.peer='rtc-peer';\n203:      this.connected=true;this.peer='rtc-peer';this.playerCount=2;\n211:      this.connected=false;\n213:        this.playerCount=1;this.onInput({x:0,y:0,action:false,light:false,disconnected:true},1);\n215:      this.onStatus('Remote explorer disconnected');\n281:    this.peer='';this.connected=false;this.role='solo';this.localIndex=0;this.playerCount=1;this.room='';this.reported=false;\n11:\tsfx: 0.55,\n19:\tconstructor({ onAction = () => {}, onInput = () => {} } = {}) {\n20:\t\tthis.onAction = onAction;\n30:\t\tthis.aboutData = null;\n31:\t\tthis.aboutTab = \"sourceInformation\";\n34:\tmount() {\n53:\t\t\t\tif (action === \"about-tab\") {\n54:\t\t\t\t\tthis.aboutTab = b.dataset.value;\n75:\t\t\t\t\tthis.onAction(\"join\", code);\n91:\t\t\t\t\tthis.onAction(action, code);\n106:\t\t\t\tthis.onAction(action, b.dataset.value);\n116:\t\t\t\tthis.onAction(\"setting\", { key, value });\n123:\t\t\t\tthis.onAction(\"tune\", { key, value });\n127:\t\t\tthis.onAction(\"pause\");\n129:\t\t\tthis.onAction(\"interact\");\n130:\t\tthis.setScreen(\"title\");\n133:\tsetLoading(value, text) {\n148:\t\treturn [\"music\", \"sfx\", \"brightness\"].includes(key)\n164:\tsetScreen(name, data = {}) {\n188:\t\t\tthis.menu.innerHTML = `<div class=\"title-content\"><div class=\"title-kicker\"><span class=\"ink-star\">✦</span> A MIDNIGHT MISADVENTURE</div><h1>URN<span>WELCOME<span class=\"title-period\">.</span></spa [... omitted end of long line]\n200:\t\t\t\t`<div class=\"settings-list\">${this.slider(\"Music\", \"music\", 0, 1, 0.01, this.settings.music)}${this.slider(\"Sound & voices\", \"sfx\", 0, 1, 0.01, this.settings.sfx)}${this.slider(\"Brightness\", \"brig [... omitted end of long line]\n204:\t\telse if (name === \"about\") {\n205:\t\t\tif (Object.keys(data).length) this.aboutData = data;\n280:\t\tconst d = this.aboutData || {},\n289:\t\tif (this.aboutTab === \"sourceInformation\") {\n336:\t\t\tbody = `<div class=\"feedback-list\">${(questions[this.aboutTab] || []).map((q, i) => `<div><span class=\"eyebrow\">${q}</span><p>${esc(d[this.aboutTab]?.[i] || \"unknown\")}</p></div>`).join(\"\")}</div>` [... omitted end of long line]\n341:\t\t\t`<div class=\"about-tabs\">${tabs.map(([key, label]) => `<button data-action=\"about-tab\" data-value=\"${key}\" class=\"${this.aboutTab === key ? \"selected\" : \"\"}\">${label}</button>`).join(\"\")}</div><div [... omitted end of long line]\n351:\t\tthis.onAction(\"setting\", { key, value: this.settings[key] });\n353:\t\tthis.setScreen(\"settings\");\n356:\tsetDevice(device, glyph = this.settings.glyph) {\n372:\t\tif (this.hudState) this.updateHUD(this.hudState);\n374:\tupdateHUD(state) {\n436:\tsetAttract(value) {\n495:\t\tthis.onAction(\"back\");\n# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card, longer if one asks for more time: what\n   the game is, how to win, the controls. The card is the hub's, from the\n   game's tags, or the game's own (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '34,150p' ui.js && sed -n '374,444p' ui.js && sed -n '1,64p' network.js && sed -n '145,178p' network.js && cat package.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '34,150p' ui.js && sed -n '374,444p' ui.js && sed -n '1,64p' network.js && sed -n '145,178p' network.js && cat package.json\"","aggregated_output":"\tmount() {\n\t\tthis.root = document.createElement(\"div\");\n\t\tthis.root.id = \"game-ui\";\n\t\tthis.root.innerHTML = `<div id=\"vignette\"></div><section id=\"hud\" aria-label=\"Game status\"><div class=\"location\"><span id=\"floor-label\" class=\"eyebrow\">GROUND FLOOR</span><strong id=\"room-label\">The foyer</strong></div><div class=\"relics\" aria-label=\"Urn fragments\"><span id=\"fragment-count\" class=\"eyebrow\">THE FAMILY URN</span><div id=\"fragment-icons\">${[0, 1, 2].map((i) => `<span class=\"fragment\" data-fragment=\"${i}\">${URN}</span>`).join(\"\")}</div></div><div class=\"courage\"><span class=\"eyebrow\">KEEP YOUR NERVE</span><div id=\"courage-icons\"></div></div><div class=\"equipment\"><span id=\"tool-icon\">✧</span><div><span class=\"eyebrow\">IN YOUR HAND</span><strong id=\"tool-label\">Empty handed</strong><span id=\"light-label\">MATCHLIGHT</span><span class=\"light-track\"><i id=\"light-meter\"></i></span></div></div><div class=\"objective\"><span class=\"eyebrow\">A MOST UNSETTLING ERRAND</span><span id=\"objective-label\">Find the three pieces. Get out.</span></div><button id=\"pause-touch\" class=\"touch-menu\" aria-label=\"Pause\">Ⅱ</button><button id=\"context-touch\" class=\"touch-context\">Interact</button><div id=\"context-prompt\"></div><div id=\"control-strip\"></div></section><main id=\"menu-screen\"></main><div id=\"toast\" role=\"status\" aria-live=\"polite\"><span class=\"toast-mark\">✦</span><div><strong></strong><p></p></div></div><div id=\"attract-banner\"><span class=\"attract-dot\"></span> THE HOUSE IS SHOWING OFF <small>Any button to return</small></div><div id=\"loading-card\"><span class=\"eyebrow\">JUST ONE MOMENT</span><strong>Waking the house…</strong><p>Fetching the engine & lighting the candles.</p></div>`;\n\t\tdocument.body.append(this.root);\n\t\tthis.menu = this.root.querySelector(\"#menu-screen\");\n\t\tthis.hud = this.root.querySelector(\"#hud\");\n\t\tthis.root.addEventListener(\"pointerover\", (e) => {\n\t\t\tconst el = e.target.closest(\"button,input,textarea,summary\");\n\t\t\tif (el && this.menu.contains(el)) {\n\t\t\t\tconst n = this.focusables().indexOf(el);\n\t\t\t\tif (n >= 0) this.setFocus(n, false);\n\t\t\t}\n\t\t});\n\t\tthis.root.addEventListener(\"click\", (e) => {\n\t\t\tconst b = e.target.closest(\"[data-action]\");\n\t\t\tif (b) {\n\t\t\t\tthis.onInput();\n\t\t\t\tconst action = b.dataset.action;\n\t\t\t\tif (action === \"about-tab\") {\n\t\t\t\t\tthis.aboutTab = b.dataset.value;\n\t\t\t\t\tthis.renderAbout();\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tif (action === \"cycle\") {\n\t\t\t\t\tthis.cycle(b.dataset.key);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tif (action === \"join\") {\n\t\t\t\t\tconst code = this.root\n\t\t\t\t\t\t.querySelector(\"#room-code\")\n\t\t\t\t\t\t?.value.trim()\n\t\t\t\t\t\t.toUpperCase();\n\t\t\t\t\tif (!code) {\n\t\t\t\t\t\tthis.toast(\n\t\t\t\t\t\t\t\"A room needs a name.\",\n\t\t\t\t\t\t\t\"Ask your friend for their room code.\",\n\t\t\t\t\t\t);\n\t\t\t\t\t\tthis.root.querySelector(\"#room-code\")?.focus();\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t\tthis.onAction(\"join\", code);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tif (action === \"accept-offer\" || action === \"accept-answer\") {\n\t\t\t\t\tconst code = this.root\n\t\t\t\t\t\t.querySelector(\n\t\t\t\t\t\t\taction === \"accept-offer\" ? \"#remote-offer\" : \"#remote-answer\",\n\t\t\t\t\t\t)\n\t\t\t\t\t\t?.value.trim();\n\t\t\t\t\tif (!code) {\n\t\t\t\t\t\tthis.toast(\n\t\t\t\t\t\t\t\"There’s no invitation here yet.\",\n\t\t\t\t\t\t\t\"Paste the code your friend sent you.\",\n\t\t\t\t\t\t);\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t\tthis.onAction(action, code);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tif (action === \"copy-signal\") {\n\t\t\t\t\tconst code = this.data?.signalCode || \"\";\n\t\t\t\t\tif (code && navigator.clipboard) {\n\t\t\t\t\t\tnavigator.clipboard\n\t\t\t\t\t\t\t.writeText(code)\n\t\t\t\t\t\t\t.then(() =>\n\t\t\t\t\t\t\t\tthis.toast(\"Copied.\", \"Send this code to your friend.\"),\n\t\t\t\t\t\t\t)\n\t\t\t\t\t\t\t.catch(() => this.toast(\"Select the code to copy it.\"));\n\t\t\t\t\t} else this.root.querySelector(\"#signal-output\")?.select();\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\tthis.onAction(action, b.dataset.value);\n\t\t\t}\n\t\t});\n\t\tthis.root.addEventListener(\"input\", (e) => {\n\t\t\tthis.onInput();\n\t\t\tif (e.target.matches(\"[data-setting]\")) {\n\t\t\t\tconst key = e.target.dataset.setting,\n\t\t\t\t\tvalue = Number(e.target.value);\n\t\t\t\tthis.settings[key] = value;\n\t\t\t\tthis.refreshValue(e.target);\n\t\t\t\tthis.onAction(\"setting\", { key, value });\n\t\t\t}\n\t\t\tif (e.target.matches(\"[data-tune]\")) {\n\t\t\t\tconst key = e.target.dataset.tune,\n\t\t\t\t\tvalue = Number(e.target.value);\n\t\t\t\tthis.tuning[key] = value;\n\t\t\t\tthis.refreshValue(e.target);\n\t\t\t\tthis.onAction(\"tune\", { key, value });\n\t\t\t}\n\t\t});\n\t\tthis.root.querySelector(\"#pause-touch\").onclick = () =>\n\t\t\tthis.onAction(\"pause\");\n\t\tthis.root.querySelector(\"#context-touch\").onclick = () =>\n\t\t\tthis.onAction(\"interact\");\n\t\tthis.setScreen(\"title\");\n\t\treturn this;\n\t}\n\tsetLoading(value, text) {\n\t\tconst c = this.root.querySelector(\"#loading-card\");\n\t\tc.hidden = !value;\n\t\tif (text) c.querySelector(\"p\").textContent = text;\n\t}\n\tbutton(label, action, sub = \"\", extra = \"\") {\n\t\treturn `<button class=\"menu-button\" data-action=\"${action}\" ${extra}><span>${label}</span>${sub ? `<small>${sub}</small>` : \"\"}<i>↗</i></button>`;\n\t}\n\tshell(kicker, title, body, foot = \"\") {\n\t\treturn `<section class=\"panel\"><div class=\"panel-top\"><span class=\"eyebrow\">${kicker}</span><button class=\"back-button\" data-action=\"back\" aria-label=\"Back\">← <span>Back</span></button></div><h2>${title}</h2>${body}${foot ? `<p class=\"panel-foot\">${foot}</p>` : \"\"}</section>`;\n\t}\n\tslider(label, key, min, max, step, value, dev = false, description = \"\") {\n\t\treturn `<label class=\"slider-row\"><span><strong>${label}</strong>${description ? `<small>${description}</small>` : \"\"}</span><div><input aria-label=\"${label}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\" ${dev ? \"data-tune\" : \"data-setting\"}=\"${key}\"><output>${this.formatValue(key, value)}</output></div></label>`;\n\t}\n\tformatValue(key, value) {\n\t\treturn [\"music\", \"sfx\", \"brightness\"].includes(key)\n\t\t\t? `${Math.round(value * 100)}%`\n\t\t\t: key === \"lantern\"\n\tupdateHUD(state) {\n\t\tif (!this.root) return;\n\t\tthis.hudState = state;\n\t\tconst get = (id) => this.root.querySelector(\"#\" + id);\n\t\tget(\"floor-label\").textContent =\n\t\t\tstate.floorName ||\n\t\t\tstate.floorLabel ||\n\t\t\t`FLOOR ${Number(state.floor ?? 0) + 1}`;\n\t\tget(\"room-label\").textContent = state.roomName || state.room || \"The foyer\";\n\t\tlet count = Array.isArray(state.fragments)\n\t\t\t? state.fragments.filter(Boolean).length\n\t\t\t: Number(state.fragments ?? 0);\n\t\tget(\"fragment-count\").textContent = `THE FAMILY URN · ${count}/3`;\n\t\tthis.root\n\t\t\t.querySelectorAll(\".fragment\")\n\t\t\t.forEach((el, i) => el.classList.toggle(\"found\", i < count));\n\t\tconst lives = state.lives ?? state.health ?? 3,\n\t\t\tmax = state.maxLives ?? 3;\n\t\tget(\"courage-icons\").innerHTML = Array.from(\n\t\t\t{ length: Math.max(lives, max) },\n\t\t\t(_, i) =>\n\t\t\t\t`<span class=\"courage-heart ${i < lives ? \"full\" : \"\"}\">♥</span>`,\n\t\t).join(\"\");\n\t\tconst tool =\n\t\t\ttypeof state.tool === \"object\"\n\t\t\t\t? state.tool?.name || \"Empty handed\"\n\t\t\t\t: state.tool || \"Empty handed\";\n\t\tget(\"tool-label\").textContent =\n\t\t\ttool === \"key\" ? \"Brass key\" : tool === \"ward\" ? \"Spirit ward\" : tool;\n\t\tget(\"tool-icon\").textContent = tool.toLowerCase().includes(\"key\")\n\t\t\t? \"⚿\"\n\t\t\t: tool.toLowerCase().includes(\"ward\")\n\t\t\t\t? \"✥\"\n\t\t\t\t: \"✧\";\n\t\tlet light = Number(state.lantern ?? state.light ?? 1);\n\t\tif (light > 1) light /= state.lanternMax || 35;\n\t\tget(\"light-meter\").style.width =\n\t\t\t`${Math.max(0, Math.min(1, light)) * 100}%`;\n\t\tget(\"light-label\").textContent =\n\t\t\tlight <= 0.01 ? \"LIGHT EXTINGUISHED\" : \"MATCHLIGHT\";\n\t\tget(\"objective-label\").textContent =\n\t\t\tstate.objective ||\n\t\t\t(count >= 3\n\t\t\t\t? \"The urn is whole. Find the front door.\"\n\t\t\t\t: \"Find the three pieces. Get out.\");\n\t\tconst context = state.context || state.prompt || \"\";\n\t\tget(\"context-prompt\").innerHTML = context\n\t\t\t? `<kbd>${this.device === \"gamepad\" ? (this.glyph === \"xbox\" ? \"A\" : \"×\") : \"E\"}</kbd><span>${esc(context)}</span>`\n\t\t\t: \"\";\n\t\tget(\"context-touch\").hidden = !context;\n\t\tget(\"context-touch\").textContent = context || \"Interact\";\n\t\tthis.root.classList.toggle(\"low-light\", light < 0.12);\n\t}\n\ttoast(text, sub = \"\") {\n\t\tif (!this.root) return;\n\t\tconst el = this.root.querySelector(\"#toast\");\n\t\tel.querySelector(\"strong\").textContent = text;\n\t\tel.querySelector(\"p\").textContent = sub;\n\t\tel.classList.add(\"visible\");\n\t\tclearTimeout(this.toastTimer);\n\t\tthis.toastTimer = setTimeout(() => el.classList.remove(\"visible\"), 4000);\n\t}\n\tsetAttract(value) {\n\t\tthis.root\n\t\t\t.querySelector(\"#attract-banner\")\n\t\t\t.classList.toggle(\"visible\", value);\n\t}\n\tfocusables() {\n\t\treturn [\n\t\t\t...this.menu.querySelectorAll(\n\t\t\t\t'button:not([disabled]),input:not([disabled]),textarea:not([disabled]),[tabindex=\"0\"]',\n/* Urn Welcome — shared-world co-op transport. AI Hub sessions own their lifecycle. */\nexport class Network {\n  constructor({onStatus=()=>{},onSnapshot=()=>{},onInput=()=>{},onStart=()=>{},onEnd=()=>{},onTimeUp=null}={}) {\n    Object.assign(this,{onStatus,onSnapshot,onInput,onStart,onEnd,onTimeUp});\n    this.role='solo'; this.connected=false; this.active=false; this.ended=false;\n    this.room=''; this.localIndex=0; this.playerCount=1; this.server=false;\n    this.peer=''; this.info=null; this.channel=null; this.rtc=null; this.dataChannel=null; this.transport='local'; this.lastBroadcast=-Infinity;\n    this.lastInput=-Infinity; this.latestInput={}; this.lastSeen=0; this.lastPing=0;\n    this.joinTimer=null; this.startTimer=null; this.tickTimer=null; this.unsub=[];\n    this.token=globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random()}`;\n  }\n  async init() {\n    if(!globalThis.AIHub?.active) return null;\n    this.active=true; this.onStatus('Connecting to AI Hub…');\n    const h=globalThis.AIHub;\n    this.unsub.push(h.on('message',(data,from)=>this.receive(data,from)));\n    this.unsub.push(h.on('start',event=>{\n      clearTimeout(this.startTimer);\n      this.startTimer=setTimeout(()=>{\n        if(this.ended)return;\n        this.connected=true;\n        this.onStart(this.startInfo());\n        this.onStatus(this.server?'AI Hub · world server':`AI Hub · ${this.playerCount} explorers`);\n      }, Math.max(0,Number(event.in)||0));\n    }));\n    this.unsub.push(h.on('leave',({id})=>{\n      const index=this.info?.players.findIndex(p=>p.id===id)??-1;\n      if(index>=0&&this.role==='host')this.onInput({x:0,y:0,action:false,light:false,disconnected:true},index);\n      this.onStatus('An explorer left the house');\n    }));\n    this.unsub.push(h.on('time-up',()=>{\n      if(this.role!=='host'||this.ended)return;\n      if(this.onTimeUp)this.onTimeUp();\n      if(!this.reported)this.finish(false,0);\n    }));\n    this.unsub.push(h.on('end',event=>{\n      this.ended=true;this.connected=false;clearTimeout(this.startTimer);\n      this.onEnd(event);this.onStatus('AI Hub round ended');\n    }));\n    try {\n      const info=await h.connect({mode:'shared-world',seats:[1,2]});\n      if(!info){this.active=false;return null;}\n      this.info=info;this.server=!!info.server;\n      this.localIndex=info.players.findIndex(p=>p.id===info.me);\n      this.playerCount=info.players.length;\n      this.role=info.isHost?'host':'guest';this.peer=info.host;\n      h.ready(); this.onStatus('AI Hub · ready for the round');\n      return info;\n    } catch(error) {\n      h.fail(`Urn Welcome could not join: ${error.message}`);\n      this.onStatus('AI Hub connection failed'); throw error;\n    }\n  }\n  startInfo(){return {hub:this.active,info:this.info,localIndex:this.localIndex,playerCount:this.playerCount,server:this.server,role:this.role};}\n  host() {\n    if(this.active)return '';\n    this.disconnect();\n    const bytes=new Uint8Array(4);globalThis.crypto.getRandomValues(bytes);\n    this.room=Array.from(bytes,b=>'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[b%32]).join('');\n    this.role='host';this.localIndex=0;this.playerCount=1;this.ended=false;\n    if(!this.openChannel(this.room)){this.role='solo';return '';}\n    this.onStatus(`Room ${this.room} · waiting for an explorer`);\n    return this.room;\n  }\n    if(this.role!=='guest'||!this.connected||this.ended)return false;\n    const now=performance.now();\n    if(now-this.lastInput<1000/15)return false;\n    this.lastInput=now;\n    if(this.active)return AIHub.send({t:'input',input},{to:this.info.host,reliable:true});\n    this.sendData({t:'input',input,sender:this.token,to:this.peer});return true;\n  }\n  broadcast(state) {\n    if(this.role!=='host'||this.ended)return false;\n    const now=performance.now();if(now-this.lastBroadcast<1000/12)return false;\n    this.lastBroadcast=now;\n    if(this.active)return AIHub.send({t:'snapshot',state},{reliable:true});\n    if(this.connected)this.sendData({t:'snapshot',state,sender:this.token,to:this.peer});\n    return this.connected;\n  }\n  beginRound() {\n    if(this.active&&this.reported)return false;\n    this.reported=false;this.ended=false;\n    this.lastInput=-Infinity;this.lastBroadcast=-Infinity;\n    return true;\n  }\n  finish(won,score=0,stats={}) {\n    if(this.role!=='host'||this.reported||this.ended)return;\n    this.reported=true;\n    const result={reason:'finished',won:!!won,score};\n    if(this.active){\n      const ids=this.info.players.map(p=>p.id);\n      const scores=Object.fromEntries(ids.map(id=>[id,score]));\n      const perPlayer=Object.fromEntries(ids.map(id=>[id,stats]));\n      AIHub.finish({standings:[ids],scores,won:!!won,stats:perPlayer});\n    }else this.sendData({t:'finish',result,sender:this.token,to:this.peer});\n  }\n  sendData(data) {\n    if(this.transport==='rtc'){\n{\n  \"name\": \"urn-welcome-haunted-house-1982-gpt-6.1-sol-ultra-20261105-214755\",\n  \"version\": \"1.0.0\",\n  \"description\": \"\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"keywords\": [],\n  \"type\": \"commonjs\",\n  \"dependencies\": {\n    \"@dimforge/rapier3d-compat\": \"^0.19.3\",\n    \"esbuild\": \"^0.28.2\",\n    \"three\": \"^0.180.0\"\n  }\n}\n","exit_code":0,"status":"completed"}}
