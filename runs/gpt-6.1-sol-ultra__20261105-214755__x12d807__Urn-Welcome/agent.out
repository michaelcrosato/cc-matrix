{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' test-coop.py && sed -n '1100,1130p' game.js && cat test-progress.json\"","aggregated_output":"\"\"\"Real final-game co-op integration, two tabs, one browser.\"\"\"\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler\nfrom functools import partial\nimport threading\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parent.parent\nfolder=Path(__file__).resolve().parent.name\nfailures=[];checks=0\nclass Quiet(SimpleHTTPRequestHandler):\n    def log_message(self,*args):pass\ndef check(ok,label):\n    global checks\n    checks+=1\n    if not ok:failures.append(label)\nserver=ThreadingHTTPServer(('127.0.0.1',0),partial(Quiet,directory=str(root)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nurl=f'http://127.0.0.1:{server.server_port}/{folder}.html'\ntry:\n    with sync_playwright() as p:\n        browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--use-angle=swiftshader','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n        context=browser.new_context(viewport={'width':1280,'height':720})\n        host=context.new_page();guest=context.new_page()\n        guest.add_init_script('window.__testPad=null; Object.defineProperty(navigator,\"getGamepads\",{value:()=>window.__testPad?[window.__testPad]:[],configurable:true});')\n        errors=[]\n        host.on('pageerror',lambda error:errors.append('host: '+str(error)))\n        guest.on('pageerror',lambda error:errors.append('guest: '+str(error)))\n        host.goto(url,wait_until='domcontentloaded');guest.goto(url,wait_until='domcontentloaded')\n        host.wait_for_function('window.__URN',timeout=60000);guest.wait_for_function('window.__URN',timeout=60000)\n        host.evaluate('__URN.action(\"host\")')\n        code=host.evaluate('__URN.network.room')\n        guest.evaluate('(code)=>__URN.action(\"join\",code)',code)\n        host.wait_for_function('__URN.network.connected && __URN.state?.playerCount===2')\n        guest.wait_for_function('__URN.network.connected && __URN.state?.playerCount===2')\n        check(host.evaluate('__URN.network.role===\"host\" && __URN.mode===\"play\"'),'final game host paired')\n        check(guest.evaluate('__URN.network.localIndex===1 && __URN.mode===\"play\"'),'final game guest paired')\n        host.evaluate('__URN.tuning.enemy=0; __URN.state.players.forEach(p=>p.invincible=99)')\n        def position_guest(x,z):\n            host.evaluate('([x,z])=>{__URN.state.players[1].x=x;__URN.state.players[1].z=z;}',[x,z])\n            guest.wait_for_function('([x,z])=>Math.hypot(__URN.state.players[1].x-x,__URN.state.players[1].z-z)<.05',arg=[x,z])\n        position_guest(-8,4)\n        guest.keyboard.press('e')\n        host.wait_for_function('__URN.state.players[1].tool===\"key\"')\n        guest.wait_for_function('__URN.state.players[1].tool===\"key\"')\n        check(host.evaluate('__URN.state.players[0].tool===null'),'guest pickup uses guest inventory')\n        position_guest(-8,1.2)\n        guest.keyboard.press('e')\n        host.wait_for_function('__URN.state.doors.some(d=>d.x===-8 && !d.locked)')\n        guest.wait_for_function('__URN.state.doors.some(d=>d.x===-8 && !d.locked)')\n        check(True,'guest unlock shared door')\n        position_guest(-8,-4)\n        guest.keyboard.press('e')\n        host.wait_for_function('__URN.state.fragments===1');guest.wait_for_function('__URN.state.fragments===1')\n        check(True,'guest recovers shared fragment')\n        guest.keyboard.press('q')\n        host.wait_for_function('__URN.state.players[1].tool===null && __URN.state.items.some(i=>i.type===\"key\" && !i.taken)')\n        guest.wait_for_function('__URN.state.players[1].tool===null && __URN.state.items.some(i=>i.type===\"key\" && !i.taken)')\n        check(True,'guest drops shared tool')\n        position_guest(9,5)\n        guest.keyboard.press('e')\n        host.wait_for_function('__URN.state.floor===1');guest.wait_for_function('__URN.state.floor===1')\n        check(host.evaluate('__URN.state.players[0].x===9'),'guest stairs move whole party')\n        start=guest.evaluate('({x:__URN.state.players[1].x,z:__URN.state.players[1].z})')\n        guest.keyboard.down('a');guest.wait_for_timeout(250);guest.keyboard.up('a')\n        host.wait_for_function('(p)=>Math.hypot(__URN.state.players[1].x-p.x,__URN.state.players[1].z-p.z)>.15',arg=start)\n        check(True,'guest continuous movement reaches host')\n        guest.wait_for_timeout(200)\n        p2=host.evaluate('({x:__URN.state.players[1].x,z:__URN.state.players[1].z})')\n        start=host.evaluate('({x:__URN.state.players[0].x,z:__URN.state.players[0].z})')\n        host.keyboard.down('d');host.wait_for_timeout(250);host.keyboard.up('d')\n        check(host.evaluate('(p)=>Math.hypot(__URN.state.players[0].x-p.x,__URN.state.players[0].z-p.z)>.15',arg=start),'host movement uses host seat')\n        check(host.evaluate('(p)=>Math.hypot(__URN.state.players[1].x-p.x,__URN.state.players[1].z-p.z)<.15',p2),'host movement preserves guest seat')\n        # Escape and standard-mapping Options each pause only this guest's controls.\n        def pad_options():\n            guest.evaluate('''()=>{if(!window.__testPad)window.__testPad={id:'Standard test pad',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:18},()=>({pressed:false,touched:false,value:0}))};window.__testPad.buttons[9]={pressed:true,touched:true,value:1};}''')\n            guest.wait_for_timeout(120)\n            guest.evaluate('window.__testPad.buttons[9]={pressed:false,touched:false,value:0}')\n        for pause_method in ['Escape','Options']:\n            position_guest(0,5)\n            guest.keyboard.down('d');guest.wait_for_timeout(150)\n            if pause_method=='Escape':guest.keyboard.press('Escape')\n            else:pad_options()\n            guest.wait_for_function('__URN.mode===\"pause\" && __URN.ui.screen===\"pause\"')\n            check(True,pause_method+' opens guest pause menu')\n            guest.keyboard.up('d');guest.wait_for_timeout(250)\n            stopped=host.evaluate('({x:__URN.state.players[1].x,z:__URN.state.players[1].z})')\n            elapsed=guest.evaluate('__URN.state.elapsed')\n            host_before=host.evaluate('({x:__URN.state.players[0].x,z:__URN.state.players[0].z,time:__URN.state.elapsed})')\n            host.keyboard.down('a');host.wait_for_timeout(300);host.keyboard.up('a')\n            check(guest.evaluate('__URN.mode===\"pause\" && __URN.ui.screen===\"pause\"'),'guest '+pause_method+' pause survives snapshots')\n            check(host.evaluate('(p)=>Math.hypot(__URN.state.players[1].x-p.x,__URN.state.players[1].z-p.z)<.04',stopped),'guest '+pause_method+' pause sends neutral controls')\n            check(host.evaluate('(p)=>__URN.state.elapsed-p.time>.15 && Math.hypot(__URN.state.players[0].x-p.x,__URN.state.players[0].z-p.z)>.1',host_before),'host continues while guest '+pause_method+' menu is open')\n            check(guest.evaluate('(t)=>__URN.state.elapsed-t>.1',elapsed),'guest '+pause_method+' pause receives live host snapshots')\n            if pause_method=='Escape':guest.locator('[data-action=resume]').click()\n            else:pad_options()\n            guest.wait_for_function('__URN.mode===\"play\" && __URN.ui.screen===\"none\"')\n            check(True,'guest '+pause_method+' pause resumes')\n        guest.evaluate('window.__testPad=null')\n        host.evaluate('__URN.state.fragments=3;__URN.loadFloor(0,{x:0,z:6.5});__URN.interact()')\n        host.wait_for_function('__URN.mode===\"win\"');guest.wait_for_function('__URN.mode===\"win\"')\n        check(True,'co-op victory appears on both copies')\n        host.evaluate('__URN.start()')\n        guest.wait_for_function('__URN.mode===\"play\" && __URN.state.fragments===0')\n        check(host.evaluate('__URN.state.playerCount===2'),'co-op rematch retains both seats')\n        check(not errors,'no game errors: '+'; '.join(errors))\n        guest.evaluate('__URN.network.disconnect()')\n        host.wait_for_function('__URN.state.playerCount===1',timeout=3000)\n        check(True,'guest departure removes inactive player')\n        browser.close()\nexcept Exception as error:failures.append(str(error).split('\\n')[0])\nfinally:server.shutdown();server.server_close()\nfor failure in failures:print('FAIL '+failure)\nprint(f'{checks} co-op checks, {len(failures)} failures')\nraise SystemExit(bool(failures))\n\t\t\t\t\"ArrowRight\",\n\t\t\t\t\"Tab\",\n\t\t\t].includes(e.code)\n\t\t)\n\t\t\te.preventDefault();\n\t\tif (e.repeat) return;\n\t\tif (ui.screen !== \"none\") {\n\t\t\tif (e.code === \"ArrowDown\" || e.code === \"KeyS\") ui.navigate(0, 1);\n\t\t\tif (e.code === \"ArrowUp\" || e.code === \"KeyW\") ui.navigate(0, -1);\n\t\t\tif (e.code === \"ArrowLeft\" || e.code === \"KeyA\") ui.navigate(-1, 0);\n\t\t\tif (e.code === \"ArrowRight\" || e.code === \"KeyD\") ui.navigate(1, 0);\n\t\t\tif (e.code === \"Enter\" || e.code === \"Space\") ui.confirm();\n\t\t\tif (e.code === \"Escape\") ui.back();\n\t\t} else {\n\t\t\tif (e.code === \"KeyE\" || e.code === \"Enter\") act(\"interact\");\n\t\t\tif (e.code === \"Space\") act(\"pulse\");\n\t\t\tif (e.code === \"KeyQ\") act(\"drop\");\n\t\t\tif (e.code === \"KeyM\" || e.code === \"Tab\") toggleMap();\n\t\t\tif (e.code === \"Escape\") pause();\n\t\t}\n\t});\n\twindow.addEventListener(\"keyup\", (e) => keys.delete(e.code));\n\twindow.addEventListener(\"blur\", () => {\n\t\tif (net.role === \"guest\") {\n\t\t\tnet.lastInput = -Infinity;\n\t\t\tnet.sendInput({ x: 0, z: 0 });\n\t\t}\n\t\tkeys.clear();\n\t\ttouch.active = false;\n\t\tif (mode === \"play\" && !attract && net.role === \"solo\") pause();\n\t});\n{\"running\": \"test-hub.py\", \"completed\": {\"test-game.py\": {\"returncode\": 0, \"output\": \"5