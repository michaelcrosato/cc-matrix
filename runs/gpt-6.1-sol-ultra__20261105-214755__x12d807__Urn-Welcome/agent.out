\"\"async()=>{const out=[];for(const name of ['step','pickup','match','extinguish','ghost','hurt','door','stairs','win','lose','menu','pulse','voice','music']){const c=new OfflineAudioContext(1,88200,44100),a=new __URN.audio.constructor({context:c});await a.init();if(name==='voice')a.gibberish();else if(name==='music')a.update(.016,{playing:true,danger:.5});else a.play(name);const d=(await c.startRendering()).getChannelData(0);let sum=0,peak=0;for(const n of d){sum+=n*n;peak=Math.max(peak,Math.abs(n));}out.push({name,rms:Math.sqrt(sum/d.length),peak,finite:d.every(Number.isFinite)});}return out;}\"\"\")\n                bad=[r for r in report if not r['finite'] or r['rms']<.00001 or r['peak']>1]\n                ensure(not bad,str(bad))\n            test(\"all 14 synthesized sounds render audibly without clipping\",rendered_audio)\n            test(\"no uncaught browser errors\",lambda:ensure(not errors,\" | \".join(errors)))\n            context.close()\n            touch_context=browser.new_context(viewport={\"width\":844,\"height\":390},is_mobile=True,has_touch=True,device_scale_factor=1)\n            touch_page=touch_context.new_page()\n            touch_page.goto(url,wait_until=\"domcontentloaded\")\n            test(\"touch viewport boot\",lambda:touch_page.wait_for_function(\"window.__URN\",timeout=120000))\n            if touch_page.evaluate(\"!!window.__URN\"):\n                touch_page.locator('[data-action=\"start\"]').tap()\n                touch_page.evaluate(\"__URN.state.enemies=[];__URN.teleport(0,4)\")\n                def touch_move():\n                    touch_page.evaluate(\"\"\"()=>{const target=document.querySelector('canvas');window.__T=(x,y)=>new Touch({identifier:1,target,clientX:x,clientY:y});target.dispatchEvent(new TouchEvent('touchstart',{bubbles:true,cancelable:true,touches:[__T(170,260)],changedTouches:[__T(170,260)]}));target.dispatchEvent(new TouchEvent('touchmove',{bubbles:true,cancelable:true,touches:[__T(235,260)],changedTouche