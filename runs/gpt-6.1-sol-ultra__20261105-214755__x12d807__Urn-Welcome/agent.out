audio.musicVolume===.22;g.action('setting',{key:'music',value:.1});return ok;}\"\"\")\n            page.evaluate(\"__URN.action('title');__URN.ui.setFocus(0);window.__PAD={id:'Test standard pad',mapping:'standard',connected:true,index:0,axes:[0,0,0,0],buttons:Array.from({length:18},()=>({pressed:false,touched:false,value:0}))}\")\n            def pad_start():\n                page.evaluate(\"__PAD.buttons[0]={pressed:true,touched:true,value:1}\")\n                try: page.wait_for_function(\"__URN.mode==='play'&&__URN.ui.device==='gamepad'\",timeout=10000)\n                finally: page.evaluate(\"__PAD.buttons[0]={pressed:false,touched:false,value:0}\")\n            test(\"standard gamepad title confirmation\",pad_start)\n            page.evaluate(\"__URN.state.enemies=[];__URN.teleport(0,4);__PAD.axes[0]=.9\")\n            test(\"gamepad analog walking\", lambda: page.wait_for_function(\"__URN.state.players[0].x>.1\",timeout=10000))\n            page.evaluate(\"__PAD.axes[0]=0;__PAD.buttons[9]={pressed:true,touched:true,value:1}\")\n            test(\"gamepad options pauses\",lambda:page.wait_for_function(\"__URN.mode==='pause'\",timeout=10000))\n            page.evaluate(\"__PAD=null;__URN.action('title')\")\n            test(\"idle title enters attract mode\",lambda:page.wait_for_function(\"__URN.attract===true\",timeout=22000))\n            test(\"input exits attract mode\",lambda:(page.keyboard.press(\"Space\"),page.wait_for_function(\"!__URN.attract&&__URN.mode==='title'\",timeout=5000)))\n            test(\"no uncaught browser errors\",lambda:ensure(not errors,\" | \".join(errors)))\n            context.close()\n     * Update colliders positions after rigid-bodies moved.\n     *\n     * When a rigid-body moves, the positions of the colliders attached to it need to be updated. This update is\n     * generally automatically done at the beginning and the end of each simulation step with World.step.\n     * If the positions need to be updated without running a simulation step this method can be called manually.\n     */\n    propagateModifiedBodyPositionsToColliders(): void;\n    /**\n     * The current simulation timestep.\n     */\n    get timestep(): number;\n    /**\n     * Sets the new simulation timestep.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='game.js';s=open(p).read();s=s.replace(\\\"if(mode\"'!=='\"'play'){mode='play';scene.mode(false)\\\", \\\"if(mode\"'!=='\"'play'&&mode\"'!=='\"'pause'){mode='play';scene.mode(false)\\\")\ns=s.replace(\\\"body.setTranslation({x:p.x,y:.55,z:p.z},true);controller\\\", \\\"body.setTranslation({x:p.x,y:.55,z:p.z},true);physics.propagateModifiedBodyPositionsToColliders();controller\\\")\ns=s.replace(\\\"p.x+=m.x;p.z+=m.z;\\\", \\\"p.x=clamp(p.x+m.x,-11.5,11.5);p.z=clamp(p.z+m.z,-7.5,7.5);\\\")\ns=s.replace(\\\"function pause(){if(mapVisible)\\\", \\\"function pause(){if(net.role==='guest'){net.lastInput=-Infinity;net.sendInput({x:0,z:0});}if(mapVisible)\\\")\ns=s.replace(\\\"let any=pad.buttons.some\\\", \\\"let wasAttract=attract;let any=pad.buttons.some\\\")\ns=s.replace(\\\"if(attract&&any)return;\\\", \\\"if(wasAttract&&any){padPrevious=pad.buttons.map(b=>b.pressed);return;}\\\")\ns=s.replace(\\\"window.addEventListener('blur',()=>{keys.clear();\\\", \\\"window.addEventListener('blur',()=>{if(net.role==='guest'){net.lastInput=-Infinity;net.sendInput({x:0,z:0});}keys.clear();\\\")\ns=s.replace(\\\"renderer.domElement.addEventListener('pointerdown'\\\", \\\"window.addEventListener('pointermove',e=>{if(e.pointerType\"'!=='\"'touch'){idle=performance.now();if(attract){inputActivity('keyboard');}else if(device\"'!=='\"'keyboard'&&(Math.abs(e.movementX)+Math.abs(e.movementY)>2)){device='keyboard';ui.setDevice(device,settings.glyph);}}});\\\\n renderer.domElement.addEventListener('pointerdown'\\\")\n# Better ending time formatting; no dangling unimplemented motion setting.\ns=s.replace(\\\"{time:Math.floor(state.elapsed),score\\\", \\\"{time:Math.floor(state.elapsed/60)+':'+String(Math.floor(state.elapsed%60)).padStart(2,'0'),score\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='game.js';s=open(p).read();s=s.replace(\\\"if(mode\"'!=='\"'play'){mode='play';scene.mode(false)\\\", \\\"if(mode\"'!=='\"'play'&&mode\"'!=='\"'pause'){mode='play';scene.mode(false)\\\")\ns=s.replace(\\\"body.setTranslation({x:p.x,y:.55,z:p.z},true);controller\\\", \\\"body.setTranslation({x:p.x,y:.55,z:p.z},true);physics.propagateModifiedBodyPositionsToColliders();controller\\\")\ns=s.replace(\\\"p.x+=m.x;p.z+=m.z;\\\", \\\"p.x=clamp(p.x+m.x,-11.5,11.5);p.z=clamp(p.z+m.z,-7.5,7.5);\\\")\ns=s.replace(\\\"function pause(){if(mapVisible)\\\", \\\"function pause(){if(net.role==='guest'){net.lastInput=-Infinity;net.sendInput({x:0,z:0});}if(mapVisible)\\\")\ns=s.replace(\\\"let any=pad.buttons.some\\\", \\\"let wasAttract=attract;let any=pad.buttons.some\\\")\ns=s.replace(\\\"if(attract&&any)return;\\\", \\\"if(wasAttract&&any){padPrevious=pad.buttons.map(b=>b.pressed);return;}\\\")\ns=s.replace(\\\"window.addEventListener('blur',()=>{keys.clear();\\\", \\\"window.addEventListener('blur',()=>{if(net.role==='guest'){net.lastInput=-Infinity;net.sendInput({x:0,z:0});}keys.clear();\\\")\ns=s.replace(\\\"renderer.domElement.addEventListener('pointerdown'\\\", \\\"window.addEventListener('pointermove',e=>{if(e.pointerType\"'!=='\"'touch'){idle=performance.now();if(attract){inputActivity('keyboard');}else if(device\"'!=='\"'keyboard'&&(Math.abs(e.movementX)+Math.abs(e.movementY)>2)){device='keyboard';ui.setDevice(device,settings.glyph);}}});\\\\n renderer.domElement.addEventListener('pointerdown'\\\")\n# Better ending time formatting; no dangling unimplemented motion setting.\ns=s.replace(\\\"{time:Math.floor(state.elapsed),score\\\", \\\"{time:Math.floor(state.elapsed/60)+':'+String(Math.floor(state.elapsed%60)).padStart(2,'0'),score\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\"","aggregated_output":"Built Urn-Welcome-Haunted-House-1982-gpt-6.1-sol-ultra-20261105-214755.html (3.17 MB)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"rg --files -g '\"'!node_modules/**'\"' -g '\"'!bundle.js'\"' -g '\"'!index.html'\"' . && sed -n '1,85p' test-game.py && head -70 test-hub.py && head -60 test-network.py && tail -25 test-coop.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"rg --files -g '\"'!node_modules/**'\"' -g '\"'!bundle.js'\"' -g '\"'!index.html'\"' . && sed -n '1,85p' test-game.py && head -70 test-hub.py && head -60 test-network.py && tail -25 test-coop.py\"","aggregated_output":"./package-lock.json\n./project.json\n./style.css\n./network.js\n./audio.js\n./test-coop.py\n./visuals.js\n./build.mjs\n./capture-game.py\n./title.png\n./test-hub.py\n./network-test.html\n./test-network.py\n./test-game.py\n./play.png\n./network-integration.md\n./hub/round.js\n./ui.js\n./game.js\n./package.json\n./hub/session.js\n./hub/bridge.js\n./hub/harness.html\n./hub/README.md\n\"\"\"Run with /home/micha/.local/share/pipx/venvs/playwright/bin/python test-game.py.\nA single sequential Chromium verifies the built single-file game. Output is failures + count.\n\"\"\"\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom threading import Thread\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent\nchecks = 0\nfailures = []\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, *_args):\n        pass\n\n\ndef test(name, callback):\n    global checks\n    checks += 1\n    try:\n        result = callback()\n        if result is False:\n            raise AssertionError(\"returned false\")\n    except Exception as exc:\n        failures.append(name)\n        print(f\"FAIL {name}: {str(exc).splitlines()[0]}\")\n\n\ndef ensure(condition, message=\"condition failed\"):\n    if not condition:\n        raise AssertionError(message)\n\n\ndef js_test(page, name, script):\n    test(name, lambda: ensure(page.evaluate(script)))\n\n\ndef main():\n    server = ThreadingHTTPServer((\"127.0.0.1\", 0), partial(QuietHandler, directory=str(ROOT)))\n    Thread(target=server.serve_forever, daemon=True).start()\n    url = f\"http://127.0.0.1:{server.server_address[1]}/index.html\"\n    try:\n        with sync_playwright() as p:\n            browser = p.chromium.launch(headless=True, args=[\"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\", \"--use-webgpu-adapter=swiftshader\", \"--no-sandbox\"])\n            context = browser.new_context(viewport={\"width\": 1280, \"height\": 800})\n            context.add_init_script(\"\"\"window.__PAD=null;Object.defineProperty(navigator,'getGamepads',{value:()=>[window.__PAD]});\"\"\")\n            page = context.new_page()\n            errors = []\n            page.on(\"pageerror\", lambda e: errors.append(str(e)))\n            page.goto(url, wait_until=\"domcontentloaded\")\n            test(\"single-file boot\", lambda: page.wait_for_function(\"window.__URN && document.title.toLowerCase().includes('urn')\", timeout=120000))\n            if not page.evaluate(\"!!window.__URN\"):\n                raise RuntimeError(\"game failed to initialize\")\n            js_test(page, \"WebGPU backend\", \"__URN.backend==='WebGPU'\")\n            js_test(page, \"music defaults to ten percent\", \"__URN.settings.music===.1 && __URN.audio.musicVolume===.1\")\n            test(\"keyboard title starts game\", lambda: (page.keyboard.press(\"Enter\"), page.wait_for_function(\"__URN.mode==='play'\", timeout=5000)))\n            js_test(page, \"campaign key pickup\", \"\"\"()=>{const g=__URN;g.state.enemies=[];g.teleport(-8,4);g.interact();return g.state.players[0].tool==='key';}\"\"\")\n            js_test(page, \"ground locked door unlock\", \"\"\"()=>{const g=__URN;g.teleport(-8,1.2);g.interact();return !g.state.doors.find(d=>d.x===-8&&d.axis==='z').locked;}\"\"\")\n            js_test(page, \"ground urn fragment\", \"\"\"()=>{const g=__URN;g.teleport(-8,-4);g.interact();return g.state.fragments===1;}\"\"\")\n            js_test(page, \"first-floor stairs\", \"\"\"()=>{const g=__URN;g.teleport(9,5);g.interact();g.state.enemies=[];return g.state.floor===1&&g.state.players[0].tool==='key';}\"\"\")\n            js_test(page, \"first-floor lock and fragment\", \"\"\"()=>{const g=__URN;g.teleport(8,1.2);g.interact();g.teleport(8,-4);g.interact();return g.state.fragments===2&&!g.state.doors.find(d=>d.x===8&&d.axis==='z').locked;}\"\"\")\n            js_test(page, \"attic stairs lock and fragment\", \"\"\"()=>{const g=__URN;g.teleport(-9,5);g.interact();g.state.enemies=[];g.teleport(-8,1.2);g.interact();g.teleport(-8,-4);g.interact();return g.state.floor===2&&g.state.fragments===3&&!g.state.doors.find(d=>d.x===-8&&d.axis==='z').locked;}\"\"\")\n            js_test(page, \"floor persistence and return stairs\", \"\"\"()=>{const g=__URN;g.teleport(-9,5);g.interact();g.state.enemies=[];if(g.state.floor!==1||!g.state.items.find(i=>i.type==='shard').taken)return false;g.teleport(9,5);g.interact();g.state.enemies=[];return g.state.floor===0&&g.state.items.find(i=>i.type==='shard').taken&&!g.state.doors.find(d=>d.x===-8&&d.axis==='z').locked;}\"\"\")\n            js_test(page, \"full campaign escape victory\", \"\"\"()=>{const g=__URN;g.teleport(0,7);g.interact();return g.mode==='win'&&g.state.result==='win'&&g.ui.screen==='win';}\"\"\")\n            js_test(page, \"restart resets campaign\", \"\"\"()=>{const g=__URN;g.start();g.state.enemies=[];return g.mode==='play'&&g.state.fragments===0&&g.state.lives===3&&g.state.floor===0&&g.state.players[0].tool===null;}\"\"\")\n            js_test(page, \"exit refuses incomplete urn\", \"\"\"()=>{const g=__URN;g.teleport(0,7);g.interact();return g.mode==='play'&&g.state.result===null;}\"\"\")\n            js_test(page, \"one carried tool drops previous tool\", \"\"\"()=>{const g=__URN;g.teleport(-8,4);g.interact();g.teleport(0,-4);g.interact();return g.state.players[0].tool==='ward'&&g.state.items.some(i=>i.type==='key'&&!i.taken&&i.x===0&&i.z===-4);}\"\"\")\n            js_test(page, \"ward flash stuns at extended range\", \"\"\"()=>{const g=__URN,p=g.state.players[0];p.cooldown=0;p.light=35;g.state.enemies=[{type:'ghost',x:4,z:-4,stun:0,angle:0,phase:0}];g.pulse();return g.state.enemies[0].stun===5&&p.cooldown===3&&p.light===32;}\"\"\")\n            js_test(page, \"flash cooldown prevents repeat use\", \"\"\"()=>{const g=__URN,p=g.state.players[0],v=p.light;g.pulse();return p.light===v;}\"\"\")\n            js_test(page, \"wind extinguishes unprotected light\", \"\"\"()=>{const g=__URN;g.state.enemies=[];g.teleport(0,1);g.state.windIn=0;g.advance(.01);return g.state.players[0].light===0;}\"\"\")\n            js_test(page, \"match relights extinguished lantern\", \"\"\"()=>{const g=__URN,m=g.state.matches;g.pulse();return g.state.players[0].light===g.tuning.lantern&&g.state.matches===m+1;}\"\"\")\n            js_test(page, \"unlit sanctuary heals courage\", \"\"\"()=>{const g=__URN;g.state.lives=2;g.teleport(-1,-4);g.interact();return g.state.candles.find(c=>c.x===-1).lit&&g.state.lives===3&&g.state.players[0].light===g.tuning.lantern;}\"\"\")\n            js_test(page, \"sanctuary replenishes light\", \"\"\"()=>{const g=__URN;g.teleport(-1,-4);g.state.players[0].light=2;g.advance(.5);return g.state.players[0].light>2;}\"\"\")\n            js_test(page, \"three hits trigger defeat\", \"\"\"()=>{const g=__URN;g.start();g.teleport(0,1);g.state.enemies=[{type:'ghost',x:0,z:1,stun:0,angle:0,phase:0}];for(let i=0;i<3;i++){const p=g.state.players[0];p.invincible=0;g.state.enemies[0].x=p.x;g.state.enemies[0].z=p.z;g.advance(.01);}return g.state.lives===0&&g.state.hits===3&&g.mode==='lose'&&g.ui.screen==='lose';}\"\"\")\n            page.evaluate(\"__URN.start();__URN.state.enemies=[];__URN.teleport(11,5)\")\n            def wall_check():\n                page.keyboard.down(\"KeyD\");page.keyboard.down(\"KeyS\")\n                try:\n                    page.wait_for_function(\"__URN.state.players[0].x>11.15\", timeout=10000)\n                    page.wait_for_timeout(1200)\n                finally:\n                    page.keyboard.up(\"KeyD\");page.keyboard.up(\"KeyS\")\n\"\"\"AI Hub conformance. Owns its HTTP server/browser; reports failures and one count.\"\"\"\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler\nfrom functools import partial\nfrom urllib.parse import urlencode\nimport argparse\nimport threading\nfrom playwright.sync_api import sync_playwright\n\nparser=argparse.ArgumentParser()\nparser.add_argument('--scenario',choices=['default','server','host-leave','impaired','all'],default='all')\nargs=parser.parse_args()\nroot=Path(__file__).resolve().parent.parent\nfolder=Path(__file__).resolve().parent.name\nfilename=folder+'.html'\nfailures=[]\nchecks=0\nclass Quiet(SimpleHTTPRequestHandler):\n    def log_message(self,*args):pass\nserver=ThreadingHTTPServer(('127.0.0.1',0),partial(Quiet,directory=str(root)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nscenarios=['default','server','host-leave','impaired'] if args.scenario=='all' else [args.scenario]\ntry:\n    if not (root/filename).is_file():raise RuntimeError('Final game HTML has not been built')\n    with sync_playwright() as p:\n        browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n        for scenario in scenarios:\n            context=browser.new_context(viewport={'width':1440,'height':900})\n            page=context.new_page()\n            params={'game':'/'+filename,'players':2,'auto':1,'play':2000,'limit':30}\n            if scenario in ['server','host-leave']:params['scenario']=scenario\n            if scenario=='impaired':params.update(latency=150,jitter=50,loss=5)\n            url=f'http://127.0.0.1:{server.server_port}/{folder}/hub/harness.html?{urlencode(params)}'\n            try:\n                page.goto(url,wait_until='domcontentloaded',timeout=30000)\n                page.wait_for_function('window.__hubCheck?.done===true',timeout=90000)\n                report=page.evaluate('window.__hubCheck')\n                for check in report.get('checks',[]):\n                    checks+=1\n                    if not check.get('pass'):failures.append(f'{scenario}: {check.get(\"name\")}: {check.get(\"detail\")}')\n                if not report.get('pass') and not any(not c.get('pass') for c in report.get('checks',[])):\n                    failures.append(scenario+': harness did not pass')\n                if report.get('pass'):\n                    copies=[f for f in page.frames if f!=page.main_frame]\n                    for frame in copies:\n                        if frame.is_detached():continue\n                        ended=frame.evaluate('!!window.AIHub?.active && window.__URN?.network?.ended===true')\n                        checks+=1\n                        if not ended:failures.append(scenario+': game failed to record hub end')\n            except Exception as error:\n                failures.append(scenario+': '+str(error).split('\\n')[0])\n            finally:context.close()\n        browser.close()\nexcept Exception as error:\n    failures.append(str(error).split('\\n')[0])\nfinally:\n    server.shutdown();server.server_close()\nfor failure in failures:print('FAIL '+failure)\nprint(f'{checks} hub checks, {len(failures)} failures')\nraise SystemExit(bool(failures))\nfrom pathlib import Path\nfrom http.server import ThreadingHTTPServer,SimpleHTTPRequestHandler\nfrom functools import partial\nimport threading\nfrom playwright.sync_api import sync_playwright\n\nfailures=[]\nchecks=0\ndef check(ok,label):\n    global checks\n    checks+=1\n    if not ok: failures.append(label)\nclass Quiet(SimpleHTTPRequestHandler):\n    def log_message(self,*args): pass\nroot=Path(__file__).resolve().parent\nserver=ThreadingHTTPServer(('127.0.0.1',0),partial(Quiet,directory=str(root)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nurl=f'http://127.0.0.1:{server.server_port}/network-test.html'\ntry:\n    with sync_playwright() as p:\n        browser=p.chromium.launch(headless=True)\n        context=browser.new_context()\n        a=context.new_page();b=context.new_page()\n        a.goto(url);b.goto(url)\n        a.wait_for_function('window.loaded');b.wait_for_function('window.loaded')\n        code=a.evaluate('net.host()')\n        check(len(code)==4,'host room code')\n        b.evaluate('(code)=>net.join(code)',code)\n        a.wait_for_function('net.connected');b.wait_for_function('net.connected')\n        check(a.evaluate('net.playerCount===2 && net.role===\"host\"'),'BroadcastChannel host connected')\n        check(b.evaluate('net.localIndex===1 && net.role===\"guest\"'),'BroadcastChannel guest seat')\n        a.evaluate('net.broadcast({players:[{x:1},{x:2}],fragments:2})')\n        b.wait_for_function('events.some(e=>e[0]===\"snapshot\")')\n        check(b.evaluate('events.find(e=>e[0]===\"snapshot\")[1].fragments===2'),'BroadcastChannel state transport')\n        b.evaluate('net.sendInput({x:.4,y:-.8,action:true})')\n        a.wait_for_function('events.some(e=>e[0]===\"input\")')\n        check(a.evaluate('events.find(e=>e[0]===\"input\")[2]===1'),'BroadcastChannel guest input seat')\n        a.evaluate('net.finish(true,123)')\n        b.wait_for_function('events.some(e=>e[0]===\"end\")')\n        check(b.evaluate('events.find(e=>e[0]===\"end\")[1].won'),'BroadcastChannel result transport')\n        b.evaluate('net.disconnect()')\n        a.wait_for_function('!net.connected')\n        check(a.evaluate('net.playerCount===1'),'BroadcastChannel guest departure')\n        check(a.evaluate('net.beginRound() && !net.reported'),'standalone round reset')\n        a.evaluate('net.disconnect(); events=[]');b.evaluate('events=[]')\n        offer=a.evaluate('net.createOffer()')\n        check(offer.startswith('URNZ.') or offer.startswith('URN1.'),'WebRTC invitation encoding')\n        answer=b.evaluate('(x)=>net.acceptOffer(x)',offer)\n        a.evaluate('(x)=>net.acceptAnswer(x)',answer)\n        a.wait_for_function('net.connected',timeout=20000);b.wait_for_function('net.connected',timeout=20000)\n        check(a.evaluate('net.dataChannel.readyState===\"open\"'),'WebRTC host data channel')\n        check(b.evaluate('net.dataChannel.readyState===\"open\"'),'WebRTC guest data channel')\n        a.evaluate('net.broadcast({players:[{x:7},{x:9}],fragments:3})')\n        b.wait_for_function('events.some(e=>e[0]===\"snapshot\")')\n        check(b.evaluate('events.find(e=>e[0]===\"snapshot\")[1].fragments===3'),'WebRTC state transport')\n        b.evaluate('net.sendInput({x:1,y:0,action:true})')\n        a.wait_for_function('events.some(e=>e[0]===\"input\")')\n        check(a.evaluate('events.find(e=>e[0]===\"input\")[1].action && events.find(e=>e[0]===\"input\")[2]===1'),'WebRTC input transport')\n        a.evaluate('net.finish(true,456)')\n        b.wait_for_function('events.some(e=>e[0]===\"end\")')\n        guest.keyboard.down('a');guest.wait_for_timeout(250);guest.keyboard.up('a')\n        host.wait_for_function('(p)=>Math.hypot(__URN.state.players[1].x-p.x,__URN.state.players[1].z-p.z)>.15',arg=start)\n        check(True,'guest continuous movement reaches host')\n        guest.wait_for_timeout(200)\n        p2=host.evaluate('({x:__URN.state.players[1].x,z:__URN.state.players[1].z})')\n        start=host.evaluate('({x:__URN.state.players[0].x,z:__URN.state.players[0].z})')\n        host.keyboard.down('d');host.wait_for_timeout(250);host.keyboard.up('d')\n        check(host.evaluate('(p)=>Math.hypot(__URN.state.players[0].x-p.x,__URN.state.players[0].z-p.z)>.15',arg=start),'host movement uses host seat')\n        check(host.evaluate('(p)=>Math.hypot(__URN.state.players[1].x-p.x,__URN.state.players[1].z-p.z)<.15',p2),'host movement preserves guest seat')\n        host.evaluate('__URN.state.fragments=3;__URN.loadFloor(0,{x:0,z:6.5});__URN.interact()')\n        host.wait_for_function('__URN.mode===\"win\"');guest.wait_for_function('__URN.mode===\"win\"')\n        check(True,'co-op victory appears on both copies')\n        host.evaluate('__URN.start()')\n        guest.wait_for_function('__URN.mode===\"play\" && __URN.state.fragments===0')\n        check(host.evaluate('__URN.state.playerCount===2'),'co-op rematch retains both seats')\n        check(not errors,'no game errors: '+'; '.join(errors))\n        guest.evaluate('__URN.network.disconnect()')\n        host.wait_for_function('__URN.state.playerCount===1',timeout=3000)\n        check(True,'guest departure removes inactive player')\n        browser.close()\nexcept Exception as error:failures.append(str(error).split('\\n')[0])\nfinally:server.shutdown();server.server_close()\nfor failure in failures:print('FAIL '+failure)\nprint(f'{checks} co-op checks, {len(failures)} failures')\nraise SystemExit(bool(failures))\n","exit_code":0,"status":"completed"}}
