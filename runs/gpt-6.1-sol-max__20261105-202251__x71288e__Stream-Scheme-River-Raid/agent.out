seRound(state);\n377: * ?auto=1 — the conformance run. It presses keys inside each frame with\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n383:const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n400:  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n412:  window.__hubCheck = report;\n544:if (auto) conformance();\n","exit_code":0,"status":"completed"}}
