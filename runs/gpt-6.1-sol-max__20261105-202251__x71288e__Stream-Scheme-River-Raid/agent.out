"detail\": \"[]\"\n  },\n  {\n    \"name\": \"AI Hub host-leave conformance\",\n    \"pass\": true,\n    \"detail\": \"[]\"\n  },\n  {\n    \"name\": \"AI Hub server without a player conformance\",\n    \"pass\": true,\n    \"detail\": \"[]\"\n  },\n  {\n    \"name\": \"no uncaught browser errors\",\n    \"pass\": true,\n    \"detail\": \"[]\"\n  },\n  {\n    \"name\": \"exit interview parses with required fields\",\n    \"pass\": true,\n    \"detail\": \"\"\n  }\n]\n\t\t\t\t\t\trange(\n\t\t\t\t\t\t\t\"enemyFire\",\n\t\t\t\t\t\t\t\"Enemy fire rate\",\n\t\t\t\t\t\t\tthis.game.params.enemyFire,\n\t\t\t\t\t\t\t0,\n\t\t\t\t\t\t\t3,\n\t\t\t\t\t\t\t0.1,\n\t\t\t\t\t\t\t\"×\",\n\t\t\t\t\t\t\ttrue,\n\t\t\t\t\t\t) +\n\t\t\t\t\t\trange(\n\t\t\t\t\t\t\t\"bulletDamage\",\n\t\t\t\t\t\t\t\"Shot damage\",\n\t\t\t\t\t\t\tthis.game.params.bulletDamage,\n\t\t\t\t\t\t\t1,\n\t\t\t\t\t\t\t8,\n\t\t\t\t\t\t\t1,\n\t\t\t\t\t\t\t\"\",\n\t\t\t\t\t\t\ttrue,\n\t\t\t\t\t\t) +\n\t\t\t\t\t\t`</div><div class=\"inline-buttons toggle-row\">${button(\"god\", `INVINCIBLE: ${this.game.god ? \"ON\" : \"OFF\"}`, true)}${button(\"autopilot\", `AI PILOT: ${this.game.autopilot ? \"ON\" : \"OFF\"}`, true)}</div><div class=\"sector-buttons\">${[...SECTORS, \"Flagship\"].map((s, i) => button(\"jump\", `${String(i + 1).padStart(2, \"0\")} / ${s.toUpperCase()}`, true, `data-value=\"${i}\"`)).join(\"\")}</div><div class=\"inline-buttons\" style=\"margin-top:.6em\">${button(\"refill\", \"REFILL SUPPLIES\", true)}${button(\"defaults\", \"RESET DEFAULTS\", true)}${button(\"resume\", \"RESUME FLIGHT\")}</div>`\n\t\t\t\t\t: \"<p>The flight leader owns the simulation. Live sliders are available on their pause menu.</p>\";\n\t\t\t}\n\t\t\tif (screen === \"debrief\") {\n\t\t\t\tconst won = this.game.phase === \"won\";\n\t\t\t\ttitle = won ? \"That went swimmingly.\" : \"A slight course correction.\";\n\t\t\t\tkicker = won\n\t\t\t\t\t? \"SORTIE COMPLETE / RIVER CLEAR\"\n\t\t\t\t\t: this.endReason || \"SORTIE LOST\";\n\t\t\t\tconst stats = this.game.stats,\n\t\t\t\t\taccuracy = Math.round((stats.hits / Math.max(1, stats.shots)) * 100);\n\t\t\t\tbody = `<div class=\"debrief-score\">${String(this.game.score).padStart(6, \"0\")}</div><div class=\"eyebrow\">${this.game.god || this.game.autopilot ? \"FLIGHT TEST / UNRANKED\" : \"FINAL PATROL SCORE\"}</div><div class=\"debrief-stats\"><div><b>${stats.kills}</b><span>Targets cleared</span></div><div><b>${stats.bridges} / 2</b><span>Bridges breached</span></div><div><b>${stats.fuelStops}</b><span>Fuel stops</span></div><div><b>${Math.floor(this.game.elapsed / 60)}:${String(Math.floor(this.game.elapsed % 60)).padStart(2, \"0\")}</b><span>Flight time</span></div><div><b>${Math.min(100, accuracy)}%</b><span>Accuracy</span></div><div><b>${stats.rolls}</b><span>Barrel rolls</span></div></div>${!this.net.hub && this.net.authority ? `<div class=\"button-list\">${!won ? button(\"retry\", \"RETRY CHECKPOINT\") : \"\"}${button(\"again\", \"FLY AGAIN\", !won)}${button(\"abort\", \"RETURN TO HANGAR\", true)}</div>` : `<p class=\"muted\">Waiting for the flight leader.</p>${!this.net.hub ? button(\"abort\", \"RETURN TO HANGAR\", true) : \"\"}`}`;\n\t\t\t}\n\t\t\tif (screen === \"about\") {\n\t\t\t\ttitle = \"The flight record\";\n\t\t\t\tkicker = \"ABOUT / CREDITS\";\n\t\t\t\tlarge = true;\n\t\t\t\tconst tabs = [\n\t\t\t\t\t[\"sourceInformation\", \"Source Information\"],\n\t\t\t\t\t[\"testingFeedback\", \"Testing Feedback\"],\n\t\t\t\tif (!this.seats.some((p) => p.id === id))\n\t\t\t\t\tthis.seats.push({ id, name: `PILOT 0${id + 1}` });\n\t\t\t\tif (this.started) this.onRoster?.(this.seats);\n\t\t\t\tthis.send(\n\t\t\t\t\t{ kind: \"welcome\", seats: this.seats, playing: this.started },\n\t\t\t\t\tid,\n\t\t\t\t);\n\t\t\t\tthis.send({ kind: \"roster\", seats: this.seats });\n\t\t\t}\n\t\t\tthis.onStatus?.(`RADIO LINK LIVE · ${this.seats.length} PILOTS`);\n\t\t};\n\t\tchannel.onclose = () => {\n\t\t\tpc.close();\n\t\t\tthis.remoteInputs.delete(id);\n\t\t\tthis.peers.delete(id);\n\t\t\tthis.onLeave?.(id);\n\t\t\tthis.onStatus?.(\"Radio link closed.\");\n\t\t};\n\t\tpc.onconnectionstatechange = () => {\n\t\t\tif (pc.connectionState === \"failed\")\n\t\t\t\tthis.onStatus?.(\n\t\t\t\t\t\"Connection failed. Create a fresh invitation; a restrictive network may need a different connection.\",\n\t\t\t\t);\n\t\t};\n\t}\n\tasync offer() {\n\t\tif (this.hub) throw new Error(\"AI Hub manages the radio.\");\n\t\tif (!this.authority)\n\t\t\tthrow new Error(\"The flight leader creates invitations.\");\n\t\tconst id = [1, 2, 3].find((v) => !this.peers.has(v));\n\t\tif (!id) throw new Error(\"This wing already has four pilots.\");\n\t\tconst pc = new RTCPeerConnection({\n\t\t\ticeServers: [{ urls: \"stun:stun.l.google.com:19302\" }],\n\t\t\t\tnet.started = false;\n\t\t\t\tgame.phase = \"lost\";\n\t\t\t\tui.endReason = \"RADIO LINK LOST\";\n\t\t\t\tui.open(\"debrief\");\n\t\t\t}\n\t\t},\n\t\tonRoster: (seats) => {\n\t\t\tif (!net.authority || !net.started) return;\n\t\t\tfor (const seat of seats)\n\t\t\t\tif (!game.players.some((p) => p.id === seat.id && !p.left)) {\n\t\t\t\t\tgame.players = game.players.filter((p) => p.id !== seat.id);\n\t\t\t\t\tgame.addPlayer(seat);\n\t\t\t\t}\n\t\t},\n\t\tonEnd: (reason) => {\n\t\t\taudio.silence(true);\n\t\t\tcontrols.enabled = false;\n\t\t\t$(\"hub-wait\").classList.remove(\"hidden\");\n\t\t\t$(\"wait-heading\").textContent =\n\t\t\t\treason === \"finished\" ? \"SORTIE RECORDED\" : \"RADIO CLOSED\";\n\t\t\t$(\"wait-detail\").textContent = \"AI Hub will take it from here.\";\n\t\t},\n\t\tonPause: (value) => {\n\t\t\tremotePaused = value;\n\t\t\t$(\"hub-wait\").classList.toggle(\"hidden\", !value);\n\t\t\t$(\"wait-heading\").textContent = \"HOLDING PATTERN\";\n\t\t\t$(\"wait-detail\").textContent = \"The flight leader has the map out.\";\n\t\t},\n\t});\n\tui = new Interface({ action, settings, game, audio, net });\n\tcontrols = new Controls({\n\t\taudio,\n\t\tview,\n\t\tonType: (type) => ui.type(type),\n\t\tgetMenu: () => !!ui.screen,\n\t\tonMenu: (direction) => ui.navigate(direction),\n\t\tonPause: togglePause,\n","exit_code":0,"status":"completed"}}
