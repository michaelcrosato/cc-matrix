r only: worlds, bodies, steps, free', () => { const T = window.__TEST__, R = T.RAPIER; for (let i = 0; i < 20; i++) { const w = new R.World({ x: 0, y: -9.8, z: 0 }); for (let j = 0; j < 50; j++) { const b = w.createRigidBody(R.RigidBodyDesc.dynamic().setTranslation(j, 5, 0)); w.createCollider(R.ColliderDesc.ball(0.2), b); } for (let k = 0; k < 200; k++) w.step(); w.free(); } });\nawait report('D Doll only: build 200 dolls', () => { const T = window.__TEST__, g = T.game; for (let i = 0; i < 40; i++) { T.startEvent('stepClass', 0, {}); T.goto('menu'); } g.errors.length = 0; });\nawait report('E fruitHat 60 s with the bot, 3 times', () => { const T = window.__TEST__; for (let i = 0; i < 3; i++) { T.startEvent('fruitHat', 0, {}); T.bot('sharp'); T.advance(60); T.bot(null); T.goto('menu'); } });\nawait report('F raft, 40 builds', () => { const T = window.__TEST__; for (let i = 0; i < 40; i++) { T.startEvent('raft', 0, {}); T.goto('menu'); } });\nawait report('G menu only: 60 s of frames', () => { const T = window.__TEST__; T.goto('menu'); T.advance(60); });\nawait browser.close();\nEOF\nfor i in $(seq 1 40); do a=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo); [ \"$a\" -ge 4 ] && break; sleep 10; done; timeout 500 node notes/scratch/iso.mjs 2>&1 | cut -c1-150 | tail -9","description":"Isolate which part of the game grows browser memory","timeout":590000}}}
