{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmemRd9rmbbfnkZHaa7","type":"message","role":"assistant","content":[{"type":"text","text":"Fruit Hat's core now behaves as the plan predicts: never banking falls, banking at 7 doesn't. Now the shell: title, menus, Who's Here, the island hub, pause and settings."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2102,"cache_read_input_tokens":348751,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2102},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"adc8f94f-c21e-4c8d-9aef-c65910efd5ef","timestamp":"2026-11-05T12:20:30.266Z","request_id":"req_011Cgjmem9zK3QiBMGpd39Kf"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmemRd9rmbbfnkZHaa7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Gf1AApZfBw4Xxh5jstLgRL","name":"Bash","input":{"command":"sed -i \"s/mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 52 }/mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 42 }/; s/sessionConfig: { time: 50, radius: 0.45, every: 1.6, mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 44 }/sessionConfig: { time: 50, radius: 0.45, every: 1.6, mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 35 }/\" src/data/events.js\ncat > src/game/flow.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { TITLE, TAGLINE, RESORT, SEAT_COLOURS } from '../data/config.js';\nimport { FIRST, LAST } from '../data/names.js';\nimport { PAINTS, paintColour, Doll } from '../art/doll.js';\nimport { EVENTS, TIER_NAMES, DISCIPLINE_ORDER } from '../data/events.js';\nimport { hasEvent } from '../events/index.js';\nimport { EventRun } from './eventRun.js';\nimport { Hub } from './hub.js';\nimport { Attract } from './attract.js';\nimport { openSettings } from '../ui/screens/settings.js';\nimport { openAbout } from '../ui/screens/about.js';\nimport { openJournal } from '../ui/screens/journal.js';\nimport { openPause, installPause } from '../ui/screens/pause.js';\nimport { openDev } from './devmode.js';\nimport { GroupClass } from './groupclass.js';\nimport { CheckInMode } from './checkin.js';\nimport { JarMode } from './jar.js';\nimport { EndingMode } from './ending.js';\nimport { showResults } from './results.js';\nimport { cos, cosPick } from '../core/rng.js';\nimport { STARTER_PAINTS } from '../data/unlocks.js';\n\n/** The island sits in the frame, doing nothing in particular. */\nclass IslandBackdrop {\n  constructor(game, name) { this.game = game; this.name = name; this.t = 0; }\n  enter() {\n    const g = this.game;\n    g.setIsland('home');\n    g.palette.set('dawn', 0.5);\n    g.programme.syncIsland();\n    this.shot(true);\n    g.audio.music('levelBest');\n  }\n  shot(snap) { this.game.rig.shot(9, 9, 52, 0, 0.5, -2, { fov: 38, snap, rate: 1 }); }\n  fixed(dt) {\n    const g = this.game;\n    this.t += dt;\n    g.stepIsland(dt, 0);\n    if (g.input.idle >= 10 && !g.wiping && !g.ui.has('settings') && !g.ui.has('about') && !g.ui.has('journal')) {\n      g.attractStart();\n    }\n    this.checkTouchState();\n  }\n  checkTouchState() {\n    const g = this.game;\n    if (g.touchOnly && (g.input.anyPadSeen || g.input.pressed.size > 0)) {\n      g.touchOnly = false;\n      if (this.onTouchCleared) this.onTouchCleared();\n    }\n  }\n  frame(dt) {\n    const g = this.game;\n    g.syncIsland(dt);\n    const a = this.t * 0.03;\n    g.rig.shot(9 + Math.sin(a) * 6, 9 + Math.sin(a * 0.7) * 1.2, 52, 0, 0.5, -2, { fov: 38, rate: 1 });\n    if (this.update) this.update(dt);\n  }\n}\n\nexport function isTouchOnly() {\n  try { return matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; } catch (e) { return false; }\n}\n\nexport function runStandalone(game) {\n  installFlow(game);\n  game.touchOnly = isTouchOnly();\n  toTitle(game);\n}\n\nfunction installFlow(game) {\n  installPause(game);\n  game.flow = {\n    toTitle: () => toTitle(game), toMenu: () => toMenu(game), startProgramme: () => startProgramme(game), toFreePlay: () => toFreePlay(game),\n    toIsland: (o) => toIsland(game, o), runClass: (id, tier, o) => runClass(game, id, tier, o), toJar: (o) => toJar(game, o), toCheckIn: () => toCheckIn(game), toEnding: () => toEnding(game), toGroup: () => toGroup(game),\n    leaveClass: () => leaveClass(game),\n  };\n  game.attractStart = () => {\n    if (game.attract || game.inSession) return;\n    game.ui.clear();\n    game.setMode(new Attract(game), 'attract');\n  };\n}\n\nfunction toTitle(game) {\n  game.attract = false;\n  game.paused = false;\n  const b = new IslandBackdrop(game, 'title');\n  game.setMode(b, 'title');\n  game.ui.only({\n    name: 'title',\n    build(s) {\n      const beam = h('div.title-beam');\n      TITLE.split('').forEach((c) => { const sp = h('span', c === ' ' ? ' ' : c); beam.append(sp); });\n      s.el.append(beam);\n      s.el.append(h('div.title-sub', `${RESORT} · ${TAGLINE}`));\n      const press = h('div.press.tag');\n      const note = h('div.touch-note.tag', 'Controller or keyboard required');\n      let settingsBtn = null;\n      const renderPress = () => {\n        const g = promptHTML('use', '', game.input.lastDevice, game.save.settings.glyphs);\n        press.innerHTML = `Press ${g}`;\n      };\n      const build = () => {\n        press.remove(); note.remove();\n        s.clearItems();\n        if (settingsBtn) { settingsBtn.remove(); settingsBtn = null; }\n        if (game.touchOnly) {\n          s.el.append(note);\n          settingsBtn = s.item(h('div', { style: 'position:absolute;bottom:10rem;left:50%;margin-left:-15rem;width:30rem' }, 'Settings'), { use: () => openSettings(game) });\n          s.el.append(settingsBtn);\n          s.setFocus(0, true);\n        } else {\n          s.el.append(press);\n          renderPress();\n        }\n      };\n      build();\n      b.onTouchCleared = build;\n      s.onDevice = () => { if (!game.touchOnly) renderPress(); };\n      game.ui.deviceListeners.add(s.onDevice);\n      s.def.onClose = () => game.ui.deviceListeners.delete(s.onDevice);\n      const letters = [...beam.children];\n      let last = 0;\n      b.update = () => {\n        last += 1 / 60;\n        const tilt = game.phys.tx * 57.3;\n        beam.style.transform = `translateX(-50%) rotate(${tilt.toFixed(2)}deg)`;\n        letters.forEach((l, i) => { const off = (tilt * 0.8 + Math.sin(last * 0.7 + i * 0.5)) * 0.4; l.style.transform = `translateX(${off.toFixed(2)}rem) rotate(${(tilt * 0.3 + Math.sin(last + i)).toFixed(2)}deg)`; });\n      };\n      press.addEventListener('click', () => { if (!game.touchOnly) game.input.clickQueue.push(() => { game.audio.sfx('uiConfirm'); game.go(() => toMenu(game)); }); });\n      press.style.pointerEvents = 'auto';\n      s.def.onConfirmAny = true;\n    },\n  });\n  game.titleWait = game.scripts.run((function* wait() {\n    yield () => game.modeName !== 'title' || (!game.touchOnly && game.input.verb('confirm') && game.ui.top && game.ui.top.name === 'title');\n    if (game.modeName === 'title') { game.audio.sfx('uiConfirm'); game.go(() => toMenu(game)); }\n  })());\n}\n\nfunction toMenu(game) {\n  game.attract = false;\n  if (game.modeName !== 'menu') {\n    const b = new IslandBackdrop(game, 'menu');\n    game.setMode(b, 'menu');\n  }\n  const p = game.save.profile;\n  const label = p && (p.tutorialDone || p.stepsDone) ? 'Continue' : 'Programme';\n  game.ui.only({\n    name: 'menu',\n    prompts: [['use', 'Choose'], ['back', 'Title']],\n    back: () => game.go(() => toTitle(game)),\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:5rem' }, TITLE));\n      const col = h('div.col', { style: 'margin-top:2rem' });\n      s.el.append(col);\n      const add = (text, use) => col.append(s.item(h('div', text), { use }));\n      add(label, () => openWho(game));\n      add('Group Class', () => game.go(() => toGroup(game)));\n      add('Free Play', () => openFreePlay(game));\n      add('Journal', () => openJournal(game));\n      add('Settings', () => openSettings(game));\n      add('About / Credits', () => openAbout(game));\n    },\n  });\n}\n\n// ---- Who's here? ----\nfunction openWho(game) {\n  const d = game.save.data;\n  game.ui.only({\n    name: 'who',\n    prompts: [['use', 'Choose'], ['back', 'Back']],\n    back: () => toMenu(game),\n    build(s) {\n      s.el.append(h('div.h1', { style: 'margin-top:4rem' }, \"Who's here today?\"));\n      const row = h('div.mats', { style: 'margin-top:6rem' });\n      s.el.append(row);\n      d.profiles.forEach((p, i) => {\n        const el = h('div.mat', { style: `background:${p ? paintColour(p.paint) + '33' : '#FFF4DC'}` });\n        el.append(h('div', { style: 'font-size:4rem;font-weight:600' }, p ? p.name : 'Empty mat'));\n        if (p) el.append(h('div', p.levelled ? 'Level' : `Day ${p.today.day}`));\n        else el.append(h('div', 'A new guest'));\n        row.append(s.item(el, { use: () => (p ? pickProfile(game, i) : openNewProfile(game, i)) }));\n      });\n    },\n  });\n}\nfunction pickProfile(game, i) {\n  game.programme.selectProfile(i);\n  game.go(() => startProgramme(game));\n}\nfunction genName(r = cos) {\n  const a = FIRST[Math.floor(r(0, FIRST.length)) % FIRST.length], b = LAST[Math.floor(r(0, LAST.length)) % LAST.length];\n  return `${a} ${b}`;\n}\nfunction openNewProfile(game, slot) {\n  let name = genName(), paintI = Math.floor(cos(0, 4));\n  const paints = PAINTS.filter((x) => STARTER_PAINTS.includes(x.id));\n  game.ui.only({\n    name: 'newProfile',\n    prompts: [['use', 'Choose'], ['back', 'Back']],\n    back: () => openWho(game),\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:4rem' }, 'A new guest'));\n      const nameEl = h('div', { style: 'font-size:6rem;font-weight:700' }, name);\n      const col = h('div.col', { style: 'margin-top:3rem' });\n      s.el.append(col);\n      col.append(h('div.tag', { style: 'transform:rotate(-1deg)' }, nameEl));\n      col.append(s.item(h('div', 'Spin the name'), { use: () => { name = genName(); nameEl.textContent = name; }, silent: true }));\n      const swatch = h('span', { style: 'display:inline-block;width:6rem;height:4rem;border:.4rem solid #1A1420;border-radius:1rem;vertical-align:middle;margin-left:1.2rem' });\n      const paintLabel = h('span');\n      const set = () => { paintLabel.textContent = paints[paintI].name; swatch.style.background = paints[paintI].shirt; };\n      const shift = (d) => { paintI = (paintI + d + paints.length) % paints.length; set(); game.audio.sfx('uiMove'); };\n      col.append(s.item(h('div', 'Paint: ', paintLabel, swatch), { left: () => shift(-1), right: () => shift(1), use: () => shift(1), silent: true }));\n      set();\n      col.append(s.item(h('div', { style: 'margin-top:1.5rem' }, 'That is me'), { use: () => {\n        game.programme.createProfile(slot, name, paints[paintI].id);\n        game.go(() => startProgramme(game));\n      } }));\n    },\n  });\n}\n\n// ---- Programme ----\nfunction startProgramme(game) {\n  const p = game.save.profile;\n  if (!p) { openWho(game); return; }\n  game.ui.clear();\n  game.programme.syncIsland();\n  if (!p.tutorialDone) { toIsland(game, { arrival: true }); return; }\n  if (!p.today.checkin) { toIsland(game, { morning: true }); return; }\n  toIsland(game, {});\n}\nfunction toIsland(game, opts = {}) {\n  game.setMode(new Hub(game, opts), 'island');\n}\nfunction toCheckIn(game, after) {\n  game.setMode(new CheckInMode(game, after), 'checkin');\n}\nfunction toJar(game, opts) {\n  game.setMode(new JarMode(game, opts), 'jar');\n}\nfunction toEnding(game) {\n  game.setMode(new EndingMode(game), 'ending');\n}\nfunction toGroup(game) {\n  game.setMode(new GroupClass(game), 'group');\n}\nfunction leaveClass(game) {\n  const p = game.save.profile;\n  game.paused = false;\n  game.ui.clear();\n  if (game.mode && game.mode.opts && game.mode.opts.onLeave) { game.mode.opts.onLeave(); return; }\n  if (p && p.tutorialDone) game.go(() => toIsland(game, {})); else game.go(() => toTitle(game));\n}\n/** Lanes for one local player. */\nexport function soloLanes(game, extra = {}) {\n  const p = game.save.profile;\n  return [{ kind: 'local', name: p ? p.name : 'You', colour: p ? paintColour(p.paint) : '#2CB5A0', hat: p ? p.hat : 'none', source: 'any', ...extra }];\n}\n/** A class in the programme or Free Play: results, then marbles, then back to the island. */\nfunction runClass(game, id, tier = 0, { programme = true, back = null } = {}) {\n  const run = () => {\n    game.setMode(new EventRun(game, {\n      id, tier, lanes: soloLanes(game), mode: 'solo',\n      onLeave: () => game.go(() => (back ? back() : toIsland(game, {}))),\n      onResult: function* onResult(ev, results, er) {\n        const r = results[0];\n        const rec = game.save.profile ? game.programme.record(id, tier, r.form, Math.max(30, ev.t), programme) : null;\n        if (id === 'grandHold' && programme) { game.go(() => toEnding(game)); return; }\n        let done = false;\n        const cont = () => { done = true; };\n        showResults(game, {\n          ev, result: r, title: ev.data.title, tierName: TIER_NAMES[tier],\n          onContinue: cont, onRetry: () => { done = 'retry'; },\n          extra: rec ? h('div.tag', { style: 'font-size:3.4rem' }, `+${rec.marbles} marbles${rec.tierOpened ? ` · ${TIER_NAMES[rec.tierOpened]} is open` : ''}`) : null,\n        });\n        yield () => done;\n        game.ui.clear();\n        if (done === 'retry') { game.go(run); return; }\n        game.go(() => {\n          if (!game.save.profile) { (back || (() => toMenu(game)))(); return; }\n          toJar(game, { marbles: rec.marbles, medal: rec.medal.id, notch: rec.notch, unlocks: rec.unlocks, then: back });\n        });\n      },\n    }), 'event');\n  };\n  run();\n}\n\n// ---- Free Play ----\nfunction openFreePlay(game) {\n  if (!game.save.profile) {\n    const list = game.save.data.profiles.findIndex((x) => x);\n    if (list >= 0) game.programme.selectProfile(list);\n  }\n  const ids = game.save.profile ? game.programme.freePlayList() : [];\n  const pages = [];\n  for (let i = 0; i < ids.length; i += 6) pages.push(ids.slice(i, i + 6));\n  if (!pages.length) pages.push([]);\n  game.ui.only({\n    name: 'freeplay', prompts: [['use', 'Choose'], ['page', 'Pages'], ['back', 'Back']], back: () => toMenu(game),\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:4rem' }, 'Free Play'));\n      const box = h('div.dev-grid', { style: 'margin-top:3rem' });\n      s.el.append(box);\n      const render = (pg) => {\n        box.innerHTML = '';\n        s.clearItems();\n        for (const id of pages[pg]) {\n          box.append(s.item(h('div', EVENTS[id].title), { use: () => openTierPick(game, id) }));\n        }\n        if (!pages[pg].length) box.append(h('div.tag', { style: 'grid-column: span 2' }, 'Meet a class in the Programme first. Trudy insists.'));\n        if (s.items.length) s.setFocus(0, true);\n      };\n      if (pages.length > 1) s.pager(pages.length, render);\n      render(0);\n    },\n  });\n}\nfunction openTierPick(game, id, back = () => openFreePlay(game)) {\n  const d = EVENTS[id];\n  game.ui.only({\n    name: 'tier', prompts: [['use', 'Begin'], ['back', 'Back']], back,\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:4rem' }, d.title));\n      const col = h('div.col', { style: 'margin-top:3rem' });\n      s.el.append(col);\n      d.tiers.forEach((_, t) => {\n        const open = game.programme.tierOpen(id, t);\n        const m = game.programme.medalOf(id, t);\n        const el = h(`div${open ? '' : '.locked'}`, `${TIER_NAMES[t]}${m ? ` · ${m.medal}` : ''}${open ? '' : t === 1 ? ' · needs Pleasant' : ' · needs Exemplary'}`);\n        col.append(s.item(el, { use: () => { if (open) game.go(() => runClass(game, id, t, { programme: false, back: () => { toMenuAfterFree(game); } })); else game.ui.toast('Not yet. Trudy has it written down.'); } }));\n      });\n    },\n  });\n}\nfunction toMenuAfterFree(game) { toMenu(game); openFreePlay(game); }\n\n/** Jump anywhere: Dev Mode and tests. */\nexport function flowGoto(game, screen, args = {}) {\n  if (!game.flow) installFlow(game);\n  game.paused = false;\n  game.ui.clear();\n  switch (screen) {\n    case 'title': toTitle(game); break;\n    case 'menu': toMenu(game); break;\n    case 'who': openWho(game); break;\n    case 'island': toIsland(game, args); break;\n    case 'jar': toJar(game, { marbles: args.marbles ?? 10, medal: args.medal || 'pleasant', notch: !!args.notch, unlocks: [] }); break;\n    case 'checkin': toCheckIn(game); break;\n    case 'ending': toEnding(game); break;\n    case 'group': toGroup(game); break;\n    case 'freeplay': openFreePlay(game); break;\n    case 'journal': toMenu(game); openJournal(game); break;\n    case 'about': toMenu(game); openAbout(game); break;\n    case 'settings': toMenu(game); openSettings(game); break;\n    case 'pause': openPause(game); break;\n    case 'dev': openDev(game); break;\n    case 'attract': game.attractStart(); break;\n    case 'event': {\n      const lanes = args.lanes || soloLanes(game);\n      game.setMode(new EventRun(game, { id: args.id, tier: args.tier || 0, lanes, mode: args.mode || 'solo', skipIntro: args.skipIntro !== false, skipCountdown: args.skipCountdown !== false, config: args.config, god: args.god, onResult: args.onResult || null, onLeave: args.onLeave }), 'event');\n      break;\n    }\n    default: break;\n  }\n}\nexport { toMenu, toIsland, toTitle, openFreePlay, openTierPick, DISCIPLINE_ORDER, hasEvent, SEAT_COLOURS, Doll, cosPick };\nEOF\nmkdir -p src/ui/screens && cat > src/ui/screens/settings.js <<'EOF'\nimport { h } from '../dom.js';\nimport { confirmDialog } from './confirm.js';\n\n/** Four pages. Sliders move with left and right, drag with mouse. */\nexport function openSettings(game, onClose = null) {\n  const set = game.save.settings;\n  const save = () => { game.save.write(); game.applySettings(); };\n  let scr = null;\n  const close = () => { game.ui.close(scr); save(); if (onClose) onClose(); };\n  scr = game.ui.open({\n    name: 'settings', className: 'dim',\n    prompts: [['use', 'Choose'], ['page', 'Pages'], ['back', 'Back']],\n    back: close,\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:3rem' }, 'Settings'));\n      const title = h('div.sign', { style: 'margin-bottom:2rem' });\n      const col = h('div.col');\n      s.el.append(title, col);\n      const P = [\n        ['Sound', () => {\n          col.append(game.ui.slider(s, 'Music', () => set.music, (v) => { set.music = v; save(); }));\n          col.append(game.ui.slider(s, 'Sound', () => set.sound, (v) => { set.sound = v; save(); }));\n          col.append(game.ui.slider(s, 'Voice', () => set.voice, (v) => { set.voice = v; save(); }));\n        }],\n        ['Controls', () => {\n          col.append(game.ui.choice(s, 'Button glyphs', [['ps', 'PlayStation'], ['xbox', 'Xbox']], () => set.glyphs, (v) => { set.glyphs = v; save(); }));\n          col.append(game.ui.choice(s, 'Rumble', [[true, 'On'], [false, 'Off']], () => set.rumble, (v) => { set.rumble = v; save(); }));\n          col.append(game.ui.choice(s, 'Auto-breathe', [[false, 'Off'], [true, 'On']], () => set.autoBreathe, (v) => { set.autoBreathe = v; save(); }));\n          col.append(game.ui.slider(s, 'Rhythm offset', () => set.rhythmOffset, (v) => { set.rhythmOffset = v; save(); }, { min: -200, max: 200, step: 10, format: (v) => `${v} ms` }));\n        }],\n        ['Display', () => {\n          col.append(game.ui.slider(s, 'UI scale', () => set.uiScale, (v) => { set.uiScale = v; save(); }, { min: 100, max: 130, step: 5, format: (v) => `${v}%` }));\n          col.append(game.ui.slider(s, 'Ink strength', () => set.ink, (v) => { set.ink = v; save(); }, { min: 0, max: 150, step: 10, format: (v) => `${v}%` }));\n          col.append(game.ui.choice(s, 'Reduce shake', [[false, 'Off'], [true, 'On']], () => set.reduceShake, (v) => { set.reduceShake = v; save(); }));\n          col.append(s.item(h('div', 'Fullscreen'), { use: () => {\n            const de = document.documentElement;\n            if (document.fullscreenElement) { if (document.exitFullscreen) document.exitFullscreen(); } else if (de.requestFullscreen) { const p = de.requestFullscreen(); if (p && p.catch) p.catch(() => {}); }\n          } }));\n        }],\n        ['Game', () => {\n          col.append(game.ui.choice(s, 'Difficulty', [['gentle', 'Gentle'], ['standard', 'Standard'], ['honest', 'Honest']], () => set.difficulty, (v) => { set.difficulty = v; save(); }));\n          col.append(s.item(h('div', 'Reset save'), { use: () => confirmDialog(game, 'Forget everything? Trudy will pretend she never met you.', 'Forget it all', () => { game.save.reset(); game.programme.syncIsland(); game.applySettings(); game.ui.toast('Done. Who are you, again?'); if (game.flow && game.modeName !== 'title' && game.modeName !== 'menu') { game.paused = false; game.flow.toTitle(); } else if (game.modeName === 'menu') game.flow.toMenu(); }) }));\n        }],\n      ];\n      const render = (pg) => {\n        col.innerHTML = '';\n        s.clearItems();\n        title.textContent = P[pg][0];\n        P[pg][1]();\n        s.setFocus(0, true);\n      };\n      s.pager(P.length, render);\n      render(0);\n    },\n  });\n  return scr;\n}\nEOF\ncat > src/ui/screens/confirm.js <<'EOF'\nimport { h } from '../dom.js';\n\n/** In-game confirm: the page never uses a dialog. */\nexport function confirmDialog(game, text, yes, fn) {\n  let scr = null;\n  const close = () => game.ui.close(scr);\n  scr = game.ui.open({\n    name: 'confirm', className: 'dim', prompts: [['use', 'Choose'], ['back', 'Back']], back: close, focus: 1,\n    build(s) {\n      s.el.append(h('div.tag', { style: 'margin-top:26rem;font-size:4.4rem;max-width:120rem;text-align:center' }, text));\n      const row = h('div.row', { style: 'margin-top:3rem' });\n      s.el.append(row);\n      row.append(s.item(h('div', yes), { use: () => { close(); fn(); } }));\n      row.append(s.item(h('div', 'Never mind'), { use: close }));\n    },\n  });\n}\nEOF\ncat > src/ui/screens/pause.js <<'EOF'\nimport { h } from '../dom.js';\nimport { setPauseOpener } from '../../game/director.js';\nimport { openSettings } from './settings.js';\nimport { promptHTML } from '../../input/glyphs.js';\nimport { EVENTS } from '../../data/events.js';\nimport { openDev } from '../../game/devmode.js';\n\nexport function installPause(game) { setPauseOpener((g, note) => openPause(g, note)); }\n\nexport function resume(game) {\n  const p = game.ui.top;\n  while (game.ui.top && game.ui.top.pauseLayer) game.ui.close(game.ui.top);\n  game.paused = false;\n  if (game.audio.seq) game.audio.seq.resume();\n  if (game.mode && game.mode.onResume) game.mode.onResume();\n  return p;\n}\n\n/** Stops the sim. Resume, Restart, How to Play, Settings, Dev Mode, Leave Class. */\nexport function openPause(game, note) {\n  if (game.paused) return;\n  game.paused = true;\n  if (game.audio.seq) game.audio.seq.pause();\n  game.speech.clear();\n  const m = game.mode;\n  const canRestart = !!(m && m.restart);\n  const scr = game.ui.open({\n    name: 'pause', className: 'dim',\n    prompts: [['use', 'Choose'], ['back', 'Resume']],\n    back: () => resume(game),\n    build(s) {\n      s.pauseLayer = true;\n      s.el.append(h('div.h1', { style: 'margin-top:3rem' }, 'Paused'));\n      if (note) s.el.append(h('div.tag', { style: 'margin-bottom:1.6rem;font-size:3.4rem' }, note));\n      const col = h('div.col');\n      s.el.append(col);\n      const add = (t, use) => col.append(s.item(h('div', t), { use }));\n      add('Resume', () => resume(game));\n      if (canRestart) add('Restart', () => { resume(game); game.go(() => m.restart()); });\n      add('How to Play', () => openHowTo(game));\n      add('Settings', () => { const st = openSettings(game); st.pauseLayer = true; });\n      add('Dev Mode', () => openDev(game));\n      add(m && m.ev ? 'Leave Class' : 'Leave', () => { game.paused = false; while (game.ui.top && game.ui.top.pauseLayer) game.ui.close(game.ui.top); if (game.audio.seq) game.audio.seq.resume(); game.flow.leaveClass(); });\n    },\n  });\n  return scr;\n}\n\nfunction openHowTo(game) {\n  const m = game.mode;\n  const d = m && m.ev ? m.ev.data : null;\n  const verbs = d ? d.verbs : [['move', 'Walk'], ['interact', 'Use'], ['ask', 'Ask Trudy'], ['look', 'Look'], ['hop', 'Hop']];\n  let scr = null;\n  const close = () => game.ui.close(scr);\n  scr = game.ui.open({\n    name: 'howto', className: 'dim', back: close, prompts: [['back', 'Back']],\n    build(s) {\n      s.pauseLayer = true;\n      s.el.append(h('div.h2', { style: 'margin-top:3rem' }, d ? d.title : 'The Island'));\n      const box = h('div.tag', { style: 'max-width:150rem;font-size:3.8rem;margin-top:1rem' });\n      if (d) { box.append(h('p', d.line), h('p', d.can), h('p', { style: 'color:#A0362E' }, d.cant)); }\n      else { box.append(h('p', 'Walk to a class, or pick one from Today\\'s Plan. Everything leans when you lean. Everything rolls when it leans.'), h('p', 'You can talk to anyone. They will say something.'), h('p', { style: 'color:#A0362E' }, \"You can't fall off. There is a fence. It is a low fence.\")); }\n      s.el.append(box);\n      const row = h('div.row', { style: 'margin-top:2rem' });\n      s.el.append(row);\n      const render = () => { row.innerHTML = verbs.map(([v, t]) => promptHTML(v, t, game.input.lastDevice, game.save.settings.glyphs)).join(''); };\n      render();\n      s.updateFn = () => { if (s.dev !== game.input.lastDevice) { s.dev = game.input.lastDevice; render(); } };\n      s.el.append(s.item(h('div', { style: 'margin-top:2rem' }, 'Back'), { use: close }));\n    },\n  });\n  return { EVENTS };\n}\nEOF\ncat > src/ui/screens/about.js <<'EOF'\nimport { h } from '../dom.js';\nimport { ABOUT, SOURCE_LABELS } from '../../data/about.js';\nimport { TITLE, RESORT } from '../../data/config.js';\nimport { TESTING_Q, ENGINE_Q, PROMPT_Q, ABOUT_PAGES, splitPages } from '../../data/aboutPages.js';\n\n/** Large type, one page at a time, moved with left and right or clicks. Long answers take more pages. */\nexport function openAbout(game) {\n  const pages = buildPages();\n  let scr = null;\n  const close = () => { game.ui.close(scr); };\n  scr = game.ui.open({\n    name: 'about', className: 'dim',\n    prompts: [['page', 'Pages'], ['back', 'Back']],\n    back: close,\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:1rem;font-size:4.6rem' }, 'About / Credits'));\n      const box = h('div.about.tag');\n      s.el.append(box);\n      const render = (pg) => {\n        box.innerHTML = '';\n        const p = pages[pg];\n        box.append(h('h3', p.title));\n        for (const [k, v] of p.rows) { const para = h('p'); if (k) para.append(h('b', `${k}: `)); para.append(document.createTextNode(v)); box.append(para); }\n      };\n      s.pager(pages.length, render);\n      render(0);\n    },\n  });\n  return scr;\n}\n\nfunction buildPages() {\n  const si = ABOUT.sourceInformation || {};\n  const out = [];\n  for (const def of ABOUT_PAGES) {\n    const rows = def.keys.map((k) => [SOURCE_LABELS[k], si[k] ?? 'unknown']);\n    splitPages(rows).forEach((r, i, all) => out.push({ title: `${def.title}${all.length > 1 ? ` (${i + 1})` : ''}`, rows: r }));\n  }\n  const fb = (title, qs, answers) => {\n    const rows = qs.map((q, i) => [q, (answers && answers[i]) ?? 'unknown']);\n    splitPages(rows).forEach((r, i, all) => out.push({ title: `${title}${all.length > 1 ? ` (${i + 1})` : ''}`, rows: r }));\n  };\n  fb('Testing Feedback', TESTING_Q, ABOUT.testingFeedback);\n  fb('Engine Feedback', ENGINE_Q, ABOUT.engineFeedback);\n  fb('Prompt Feedback', PROMPT_Q, ABOUT.promptFeedback);\n  out.push({ title: 'Credits', rows: [\n    ['', `${TITLE} · ${RESORT}`],\n    ['Font', 'Fredoka, by Milena Brandao and Hafontia, SIL Open Font License 1.1'],\n    ['Engine', 'Three.js (MIT), the three.js authors'],\n    ['Physics', 'Rapier (Apache 2.0), Dimforge'],\n    ['Everything else', 'All art, music, sound and voices were made in code for this game.'],\n  ] });\n  return out;\n}\nEOF\ncat > src/data/aboutPages.js <<'EOF'\n// Questions and page layout for the About screen. The answers come from the exit interview.\nexport const TESTING_Q = ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'];\nexport const ENGINE_Q = ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why? (none if nothing)', 'If you could change one thing about the engine, what would it be?'];\nexport const PROMPT_Q = ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'];\nexport const ABOUT_PAGES = [\n  { title: 'Source Information', keys: ['date', 'source', 'plan', 'genre', 'perspective'] },\n  { title: 'Source Information', keys: ['tech', 'artDirection', 'animation'] },\n  { title: 'Source Information', keys: ['audio', 'online', 'testing'] },\n  { title: 'Source Information', keys: ['research', 'environment', 'model', 'usage'] },\n];\nconst MAX_CHARS = 880;\n/** Split rows so no page needs small print or a scroll. */\nexport function splitPages(rows) {\n  const pages = [[]];\n  let n = 0;\n  for (const row of rows) {\n    const len = (row[0] || '').length + String(row[1]).length;\n    if (n + len > MAX_CHARS && pages[pages.length - 1].length) { pages.push([]); n = 0; }\n    if (len > MAX_CHARS) {\n      // A single very long answer: cut at a sentence.\n      let text = String(row[1]);\n      let first = true;\n      while (text.length) {\n        let cut = text.length;\n        if (cut > MAX_CHARS - (first ? (row[0] || '').length : 0)) {\n          const lim = MAX_CHARS - (first ? (row[0] || '').length : 0);\n          cut = text.lastIndexOf('. ', lim);\n          if (cut < lim * 0.4) cut = text.lastIndexOf(' ', lim);\n          cut += 1;\n        }\n        pages[pages.length - 1].push([first ? row[0] : '', text.slice(0, cut).trim()]);\n        text = text.slice(cut).trim();\n        first = false;\n        n = 0;\n        if (text.length) pages.push([]);\n      }\n      n = MAX_CHARS;\n    } else {\n      pages[pages.length - 1].push(row);\n      n += len;\n    }\n  }\n  return pages;\n}\nEOF\ncat > src/ui/screens/journal.js <<'EOF'\nimport { h } from '../dom.js';\nimport { medalSVG } from '../../game/results.js';\nimport { MEDALS } from '../../data/config.js';\nimport { EVENTS, TIER_NAMES } from '../../data/events.js';\n\n/** Calendar, the Wobble Age graph, the medals shelf, silly totals. */\nexport function openJournal(game, onClose = null) {\n  if (!game.save.profile) { const i = game.save.data.profiles.findIndex((x) => x); if (i >= 0) game.programme.selectProfile(i); }\n  const p = game.save.profile;\n  let scr = null;\n  const close = () => { game.ui.close(scr); if (onClose) onClose(); };\n  const medalKeys = p ? Object.keys(p.medals) : [];\n  const medalPages = [];\n  for (let i = 0; i < medalKeys.length; i += 8) medalPages.push(medalKeys.slice(i, i + 8));\n  if (!medalPages.length) medalPages.push([]);\n  const total = 2 + medalPages.length + 1;\n  scr = game.ui.open({\n    name: 'journal', className: 'dim',\n    prompts: [['page', 'Pages'], ['back', 'Back']],\n    back: close,\n    build(s) {\n      const title = h('div.h2', { style: 'margin-top:2rem' }, 'Journal');\n      const box = h('div', { style: 'margin-top:1rem' });\n      s.el.append(title, box);\n      const page = (pg) => {\n        box.innerHTML = '';\n        if (!p) { box.append(h('div.tag', 'Nobody has checked in yet. Trudy has left the page open.')); return; }\n        if (pg === 0) {\n          title.textContent = 'Your Days';\n          const cal = h('div.calendar');\n          const n = Math.max(14, p.stamps.length + 1);\n          for (let i = 1; i <= Math.min(21, n); i++) {\n            const stamp = p.stamps.find((x) => x.day === i);\n            cal.append(h('div.day', String(i), stamp ? h('b', 'DONE') : null));\n          }\n          box.append(cal);\n        } else if (pg === 1) {\n          title.textContent = 'Wobble Age';\n          box.append(graph(p));\n        } else if (pg < total - 1) {\n          title.textContent = 'The Medal Shelf';\n          const sh = h('div.shelf');\n          for (const k of medalPages[pg - 2]) {\n            const [id, tier] = k.split(':');\n            const rec = p.medals[k];\n            const m = MEDALS.find((x) => x.id === rec.medal) || MEDALS[0];\n            sh.append(h('div.m.tag', h('span', { html: medalSVG(m) , style: 'width:9rem;height:9rem;display:block' }), `${EVENTS[id].title}`, h('span', TIER_NAMES[tier])));\n          }\n          if (!medalPages[pg - 2].length) sh.append(h('div.tag', { style: 'grid-column:span 4' }, 'No medals yet. The shelf is very level.'));\n          box.append(sh);\n        } else {\n          title.textContent = 'Silly Totals';\n          box.append(h('div.totals.tag',\n            h('div', `Floor Exercises: ${p.floorExercises}`),\n            h('div', `Minutes: ${Math.round(p.minutes)}`),\n            h('div', `Marbles: ${p.marbles}`),\n            h('div', `Classes: ${p.classes}`)));\n        }\n      };\n      s.pager(total, page);\n      page(0);\n    },\n  });\n  return scr;\n}\n\nfunction graph(p) {\n  const ages = p.ages.slice(-12);\n  const w = 1200, ht = 460;\n  const xOf = (i) => 80 + (i * (w - 160)) / Math.max(1, ages.length - 1);\n  const yOf = (a) => 40 + ((99 - a) / 81) * (ht - 90);\n  let path = '';\n  ages.forEach((a, i) => { path += `${i ? 'L' : 'M'}${xOf(i).toFixed(0)} ${yOf(a.age).toFixed(0)} `; });\n  const dots = ages.map((a, i) => `<circle cx=\"${xOf(i)}\" cy=\"${yOf(a.age)}\" r=\"13\" fill=\"#F5B700\" stroke=\"#1A1420\" stroke-width=\"5\"/>`).join('');\n  const first = ages[0] ? ages[0].age : '-', last = ages.length ? ages[ages.length - 1].age : '-';\n  const best = ages.length ? Math.min(...ages.map((a) => a.age)) : '-';\n  const svg = `<svg viewBox=\"0 0 ${w} ${ht}\"><rect x=\"2\" y=\"2\" width=\"${w - 4}\" height=\"${ht - 4}\" rx=\"24\" fill=\"#FFF4DC\" stroke=\"#1A1420\" stroke-width=\"7\"/><path d=\"${path}\" fill=\"none\" stroke=\"#1A1420\" stroke-width=\"11\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>${dots}</svg>`;\n  return h('div.col', h('div.graph', { html: svg }), h('div.row',\n    h('div.tag', { style: 'font-size:4.4rem' }, `First: ${first}`), h('div.tag', { style: 'font-size:4.4rem' }, `Latest: ${last}`), h('div.tag', { style: 'font-size:4.4rem' }, `Best: ${best}`)));\n}\nEOF\n","description":"Write flow, title, menu, profile, settings, pause, about and journal"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2102,"cache_read_input_tokens":348751,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2102},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"fa8a8e6a-f171-4bf7-b7ca-f6984f55b578","timestamp":"2026-11-05T12:22:18.022Z","request_id":"req_011Cgjmem9zK3QiBMGpd39Kf","wire_tool_inputs":{"toolu_01Gf1AApZfBw4Xxh5jstLgRL":{"command":"sed -i \"s/mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 52 }/mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 42 }/; s/sessionConfig: { time: 50, radius: 0.45, every: 1.6, mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 44 }/sessionConfig: { time: 50, radius: 0.45, every: 1.6, mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 35 }/\" src/data/events.js\ncat > src/game/flow.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { TITLE, TAGLINE, RESORT, SEAT_COLOURS } from '../data/config.js';\nimport { FIRST, LAST } from '../data/names.js';\nimport { PAINTS, paintColour, Doll } from '../art/doll.js';\nimport { EVENTS, TIER_NAMES, DISCIPLINE_ORDER } from '../data/events.js';\nimport { hasEvent } from '../events/index.js';\nimport { EventRun } from './eventRun.js';\nimport { Hub } from './hub.js';\nimport { Attract } from './attract.js';\nimport { openSettings } from '../ui/screens/settings.js';\nimport { openAbout } from '../ui/screens/about.js';\nimport { openJournal } from '../ui/screens/journal.js';\nimport { openPause, installPause } from '../ui/screens/pause.js';\nimport { openDev } from './devmode.js';\nimport { GroupClass } from './groupclass.js';\nimport { CheckInMode } from './checkin.js';\nimport { JarMode } from './jar.js';\nimport { EndingMode } from './ending.js';\nimport { showResults } from './results.js';\nimport { cos, cosPick } from '../core/rng.js';\nimport { STARTER_PAINTS } from '../data/unlocks.js';\n\n/** The island sits in the frame, doing nothing in particular. */\nclass IslandBackdrop {\n  constructor(game, name) { this.game = game; this.name = name; this.t = 0; }\n  enter() {\n    const g = this.game;\n    g.setIsland('home');\n    g.palette.set('dawn', 0.5);\n    g.programme.syncIsland();\n    this.shot(true);\n    g.audio.music('levelBest');\n  }\n  shot(snap) { this.game.rig.shot(9, 9, 52, 0, 0.5, -2, { fov: 38, snap, rate: 1 }); }\n  fixed(dt) {\n    const g = this.game;\n    this.t += dt;\n    g.stepIsland(dt, 0);\n    if (g.input.idle >= 10 && !g.wiping && !g.ui.has('settings') && !g.ui.has('about') && !g.ui.has('journal')) {\n      g.attractStart();\n    }\n    this.checkTouchState();\n  }\n  checkTouchState() {\n    const g = this.game;\n    if (g.touchOnly && (g.input.anyPadSeen || g.input.pressed.size > 0)) {\n      g.touchOnly = false;\n      if (this.onTouchCleared) this.onTouchCleared();\n    }\n  }\n  frame(dt) {\n    const g = this.game;\n    g.syncIsland(dt);\n    const a = this.t * 0.03;\n    g.rig.shot(9 + Math.sin(a) * 6, 9 + Math.sin(a * 0.7) * 1.2, 52, 0, 0.5, -2, { fov: 38, rate: 1 });\n    if (this.update) this.update(dt);\n  }\n}\n\nexport function isTouchOnly() {\n  try { return matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches; } catch (e) { return false; }\n}\n\nexport function runStandalone(game) {\n  installFlow(game);\n  game.touchOnly = isTouchOnly();\n  toTitle(game);\n}\n\nfunction installFlow(game) {\n  installPause(game);\n  game.flow = {\n    toTitle: () => toTitle(game), toMenu: () => toMenu(game), startProgramme: () => startProgramme(game), toFreePlay: () => toFreePlay(game),\n    toIsland: (o) => toIsland(game, o), runClass: (id, tier, o) => runClass(game, id, tier, o), toJar: (o) => toJar(game, o), toCheckIn: () => toCheckIn(game), toEnding: () => toEnding(game), toGroup: () => toGroup(game),\n    leaveClass: () => leaveClass(game),\n  };\n  game.attractStart = () => {\n    if (game.attract || game.inSession) return;\n    game.ui.clear();\n    game.setMode(new Attract(game), 'attract');\n  };\n}\n\nfunction toTitle(game) {\n  game.attract = false;\n  game.paused = false;\n  const b = new IslandBackdrop(game, 'title');\n  game.setMode(b, 'title');\n  game.ui.only({\n    name: 'title',\n    build(s) {\n      const beam = h('div.title-beam');\n      TITLE.split('').forEach((c) => { const sp = h('span', c === ' ' ? '\\u00a0' : c); beam.append(sp); });\n      s.el.append(beam);\n      s.el.append(h('div.title-sub', `${RESORT} · ${TAGLINE}`));\n      const press = h('div.press.tag');\n      const note = h('div.touch-note.tag', 'Controller or keyboard required');\n      let settingsBtn = null;\n      const renderPress = () => {\n        const g = promptHTML('use', '', game.input.lastDevice, game.save.settings.glyphs);\n        press.innerHTML = `Press ${g}`;\n      };\n      const build = () => {\n        press.remove(); note.remove();\n        s.clearItems();\n        if (settingsBtn) { settingsBtn.remove(); settingsBtn = null; }\n        if (game.touchOnly) {\n          s.el.append(note);\n          settingsBtn = s.item(h('div', { style: 'position:absolute;bottom:10rem;left:50%;margin-left:-15rem;width:30rem' }, 'Settings'), { use: () => openSettings(game) });\n          s.el.append(settingsBtn);\n          s.setFocus(0, true);\n        } else {\n          s.el.append(press);\n          renderPress();\n        }\n      };\n      build();\n      b.onTouchCleared = build;\n      s.onDevice = () => { if (!game.touchOnly) renderPress(); };\n      game.ui.deviceListeners.add(s.onDevice);\n      s.def.onClose = () => game.ui.deviceListeners.delete(s.onDevice);\n      const letters = [...beam.children];\n      let last = 0;\n      b.update = () => {\n        last += 1 / 60;\n        const tilt = game.phys.tx * 57.3;\n        beam.style.transform = `translateX(-50%) rotate(${tilt.toFixed(2)}deg)`;\n        letters.forEach((l, i) => { const off = (tilt * 0.8 + Math.sin(last * 0.7 + i * 0.5)) * 0.4; l.style.transform = `translateX(${off.toFixed(2)}rem) rotate(${(tilt * 0.3 + Math.sin(last + i)).toFixed(2)}deg)`; });\n      };\n      press.addEventListener('click', () => { if (!game.touchOnly) game.input.clickQueue.push(() => { game.audio.sfx('uiConfirm'); game.go(() => toMenu(game)); }); });\n      press.style.pointerEvents = 'auto';\n      s.def.onConfirmAny = true;\n    },\n  });\n  game.titleWait = game.scripts.run((function* wait() {\n    yield () => game.modeName !== 'title' || (!game.touchOnly && game.input.verb('confirm') && game.ui.top && game.ui.top.name === 'title');\n    if (game.modeName === 'title') { game.audio.sfx('uiConfirm'); game.go(() => toMenu(game)); }\n  })());\n}\n\nfunction toMenu(game) {\n  game.attract = false;\n  if (game.modeName !== 'menu') {\n    const b = new IslandBackdrop(game, 'menu');\n    game.setMode(b, 'menu');\n  }\n  const p = game.save.profile;\n  const label = p && (p.tutorialDone || p.stepsDone) ? 'Continue' : 'Programme';\n  game.ui.only({\n    name: 'menu',\n    prompts: [['use', 'Choose'], ['back', 'Title']],\n    back: () => game.go(() => toTitle(game)),\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:5rem' }, TITLE));\n      const col = h('div.col', { style: 'margin-top:2rem' });\n      s.el.append(col);\n      const add = (text, use) => col.append(s.item(h('div', text), { use }));\n      add(label, () => openWho(game));\n      add('Group Class', () => game.go(() => toGroup(game)));\n      add('Free Play', () => openFreePlay(game));\n      add('Journal', () => openJournal(game));\n      add('Settings', () => openSettings(game));\n      add('About / Credits', () => openAbout(game));\n    },\n  });\n}\n\n// ---- Who's here? ----\nfunction openWho(game) {\n  const d = game.save.data;\n  game.ui.only({\n    name: 'who',\n    prompts: [['use', 'Choose'], ['back', 'Back']],\n    back: () => toMenu(game),\n    build(s) {\n      s.el.append(h('div.h1', { style: 'margin-top:4rem' }, \"Who's here today?\"));\n      const row = h('div.mats', { style: 'margin-top:6rem' });\n      s.el.append(row);\n      d.profiles.forEach((p, i) => {\n        const el = h('div.mat', { style: `background:${p ? paintColour(p.paint) + '33' : '#FFF4DC'}` });\n        el.append(h('div', { style: 'font-size:4rem;font-weight:600' }, p ? p.name : 'Empty mat'));\n        if (p) el.append(h('div', p.levelled ? 'Level' : `Day ${p.today.day}`));\n        else el.append(h('div', 'A new guest'));\n        row.append(s.item(el, { use: () => (p ? pickProfile(game, i) : openNewProfile(game, i)) }));\n      });\n    },\n  });\n}\nfunction pickProfile(game, i) {\n  game.programme.selectProfile(i);\n  game.go(() => startProgramme(game));\n}\nfunction genName(r = cos) {\n  const a = FIRST[Math.floor(r(0, FIRST.length)) % FIRST.length], b = LAST[Math.floor(r(0, LAST.length)) % LAST.length];\n  return `${a} ${b}`;\n}\nfunction openNewProfile(game, slot) {\n  let name = genName(), paintI = Math.floor(cos(0, 4));\n  const paints = PAINTS.filter((x) => STARTER_PAINTS.includes(x.id));\n  game.ui.only({\n    name: 'newProfile',\n    prompts: [['use', 'Choose'], ['back', 'Back']],\n    back: () => openWho(game),\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:4rem' }, 'A new guest'));\n      const nameEl = h('div', { style: 'font-size:6rem;font-weight:700' }, name);\n      const col = h('div.col', { style: 'margin-top:3rem' });\n      s.el.append(col);\n      col.append(h('div.tag', { style: 'transform:rotate(-1deg)' }, nameEl));\n      col.append(s.item(h('div', 'Spin the name'), { use: () => { name = genName(); nameEl.textContent = name; }, silent: true }));\n      const swatch = h('span', { style: 'display:inline-block;width:6rem;height:4rem;border:.4rem solid #1A1420;border-radius:1rem;vertical-align:middle;margin-left:1.2rem' });\n      const paintLabel = h('span');\n      const set = () => { paintLabel.textContent = paints[paintI].name; swatch.style.background = paints[paintI].shirt; };\n      const shift = (d) => { paintI = (paintI + d + paints.length) % paints.length; set(); game.audio.sfx('uiMove'); };\n      col.append(s.item(h('div', 'Paint: ', paintLabel, swatch), { left: () => shift(-1), right: () => shift(1), use: () => shift(1), silent: true }));\n      set();\n      col.append(s.item(h('div', { style: 'margin-top:1.5rem' }, 'That is me'), { use: () => {\n        game.programme.createProfile(slot, name, paints[paintI].id);\n        game.go(() => startProgramme(game));\n      } }));\n    },\n  });\n}\n\n// ---- Programme ----\nfunction startProgramme(game) {\n  const p = game.save.profile;\n  if (!p) { openWho(game); return; }\n  game.ui.clear();\n  game.programme.syncIsland();\n  if (!p.tutorialDone) { toIsland(game, { arrival: true }); return; }\n  if (!p.today.checkin) { toIsland(game, { morning: true }); return; }\n  toIsland(game, {});\n}\nfunction toIsland(game, opts = {}) {\n  game.setMode(new Hub(game, opts), 'island');\n}\nfunction toCheckIn(game, after) {\n  game.setMode(new CheckInMode(game, after), 'checkin');\n}\nfunction toJar(game, opts) {\n  game.setMode(new JarMode(game, opts), 'jar');\n}\nfunction toEnding(game) {\n  game.setMode(new EndingMode(game), 'ending');\n}\nfunction toGroup(game) {\n  game.setMode(new GroupClass(game), 'group');\n}\nfunction leaveClass(game) {\n  const p = game.save.profile;\n  game.paused = false;\n  game.ui.clear();\n  if (game.mode && game.mode.opts && game.mode.opts.onLeave) { game.mode.opts.onLeave(); return; }\n  if (p && p.tutorialDone) game.go(() => toIsland(game, {})); else game.go(() => toTitle(game));\n}\n/** Lanes for one local player. */\nexport function soloLanes(game, extra = {}) {\n  const p = game.save.profile;\n  return [{ kind: 'local', name: p ? p.name : 'You', colour: p ? paintColour(p.paint) : '#2CB5A0', hat: p ? p.hat : 'none', source: 'any', ...extra }];\n}\n/** A class in the programme or Free Play: results, then marbles, then back to the island. */\nfunction runClass(game, id, tier = 0, { programme = true, back = null } = {}) {\n  const run = () => {\n    game.setMode(new EventRun(game, {\n      id, tier, lanes: soloLanes(game), mode: 'solo',\n      onLeave: () => game.go(() => (back ? back() : toIsland(game, {}))),\n      onResult: function* onResult(ev, results, er) {\n        const r = results[0];\n        const rec = game.save.profile ? game.programme.record(id, tier, r.form, Math.max(30, ev.t), programme) : null;\n        if (id === 'grandHold' && programme) { game.go(() => toEnding(game)); return; }\n        let done = false;\n        const cont = () => { done = true; };\n        showResults(game, {\n          ev, result: r, title: ev.data.title, tierName: TIER_NAMES[tier],\n          onContinue: cont, onRetry: () => { done = 'retry'; },\n          extra: rec ? h('div.tag', { style: 'font-size:3.4rem' }, `+${rec.marbles} marbles${rec.tierOpened ? ` · ${TIER_NAMES[rec.tierOpened]} is open` : ''}`) : null,\n        });\n        yield () => done;\n        game.ui.clear();\n        if (done === 'retry') { game.go(run); return; }\n        game.go(() => {\n          if (!game.save.profile) { (back || (() => toMenu(game)))(); return; }\n          toJar(game, { marbles: rec.marbles, medal: rec.medal.id, notch: rec.notch, unlocks: rec.unlocks, then: back });\n        });\n      },\n    }), 'event');\n  };\n  run();\n}\n\n// ---- Free Play ----\nfunction openFreePlay(game) {\n  if (!game.save.profile) {\n    const list = game.save.data.profiles.findIndex((x) => x);\n    if (list >= 0) game.programme.selectProfile(list);\n  }\n  const ids = game.save.profile ? game.programme.freePlayList() : [];\n  const pages = [];\n  for (let i = 0; i < ids.length; i += 6) pages.push(ids.slice(i, i + 6));\n  if (!pages.length) pages.push([]);\n  game.ui.only({\n    name: 'freeplay', prompts: [['use', 'Choose'], ['page', 'Pages'], ['back', 'Back']], back: () => toMenu(game),\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:4rem' }, 'Free Play'));\n      const box = h('div.dev-grid', { style: 'margin-top:3rem' });\n      s.el.append(box);\n      const render = (pg) => {\n        box.innerHTML = '';\n        s.clearItems();\n        for (const id of pages[pg]) {\n          box.append(s.item(h('div', EVENTS[id].title), { use: () => openTierPick(game, id) }));\n        }\n        if (!pages[pg].length) box.append(h('div.tag', { style: 'grid-column: span 2' }, 'Meet a class in the Programme first. Trudy insists.'));\n        if (s.items.length) s.setFocus(0, true);\n      };\n      if (pages.length > 1) s.pager(pages.length, render);\n      render(0);\n    },\n  });\n}\nfunction openTierPick(game, id, back = () => openFreePlay(game)) {\n  const d = EVENTS[id];\n  game.ui.only({\n    name: 'tier', prompts: [['use', 'Begin'], ['back', 'Back']], back,\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:4rem' }, d.title));\n      const col = h('div.col', { style: 'margin-top:3rem' });\n      s.el.append(col);\n      d.tiers.forEach((_, t) => {\n        const open = game.programme.tierOpen(id, t);\n        const m = game.programme.medalOf(id, t);\n        const el = h(`div${open ? '' : '.locked'}`, `${TIER_NAMES[t]}${m ? ` · ${m.medal}` : ''}${open ? '' : t === 1 ? ' · needs Pleasant' : ' · needs Exemplary'}`);\n        col.append(s.item(el, { use: () => { if (open) game.go(() => runClass(game, id, t, { programme: false, back: () => { toMenuAfterFree(game); } })); else game.ui.toast('Not yet. Trudy has it written down.'); } }));\n      });\n    },\n  });\n}\nfunction toMenuAfterFree(game) { toMenu(game); openFreePlay(game); }\n\n/** Jump anywhere: Dev Mode and tests. */\nexport function flowGoto(game, screen, args = {}) {\n  if (!game.flow) installFlow(game);\n  game.paused = false;\n  game.ui.clear();\n  switch (screen) {\n    case 'title': toTitle(game); break;\n    case 'menu': toMenu(game); break;\n    case 'who': openWho(game); break;\n    case 'island': toIsland(game, args); break;\n    case 'jar': toJar(game, { marbles: args.marbles ?? 10, medal: args.medal || 'pleasant', notch: !!args.notch, unlocks: [] }); break;\n    case 'checkin': toCheckIn(game); break;\n    case 'ending': toEnding(game); break;\n    case 'group': toGroup(game); break;\n    case 'freeplay': openFreePlay(game); break;\n    case 'journal': toMenu(game); openJournal(game); break;\n    case 'about': toMenu(game); openAbout(game); break;\n    case 'settings': toMenu(game); openSettings(game); break;\n    case 'pause': openPause(game); break;\n    case 'dev': openDev(game); break;\n    case 'attract': game.attractStart(); break;\n    case 'event': {\n      const lanes = args.lanes || soloLanes(game);\n      game.setMode(new EventRun(game, { id: args.id, tier: args.tier || 0, lanes, mode: args.mode || 'solo', skipIntro: args.skipIntro !== false, skipCountdown: args.skipCountdown !== false, config: args.config, god: args.god, onResult: args.onResult || null, onLeave: args.onLeave }), 'event');\n      break;\n    }\n    default: break;\n  }\n}\nexport { toMenu, toIsland, toTitle, openFreePlay, openTierPick, DISCIPLINE_ORDER, hasEvent, SEAT_COLOURS, Doll, cosPick };\nEOF\nmkdir -p src/ui/screens && cat > src/ui/screens/settings.js <<'EOF'\nimport { h } from '../dom.js';\nimport { confirmDialog } from './confirm.js';\n\n/** Four pages. Sliders move with left and right, drag with mouse. */\nexport function openSettings(game, onClose = null) {\n  const set = game.save.settings;\n  const save = () => { game.save.write(); game.applySettings(); };\n  let scr = null;\n  const close = () => { game.ui.close(scr); save(); if (onClose) onClose(); };\n  scr = game.ui.open({\n    name: 'settings', className: 'dim',\n    prompts: [['use', 'Choose'], ['page', 'Pages'], ['back', 'Back']],\n    back: close,\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:3rem' }, 'Settings'));\n      const title = h('div.sign', { style: 'margin-bottom:2rem' });\n      const col = h('div.col');\n      s.el.append(title, col);\n      const P = [\n        ['Sound', () => {\n          col.append(game.ui.slider(s, 'Music', () => set.music, (v) => { set.music = v; save(); }));\n          col.append(game.ui.slider(s, 'Sound', () => set.sound, (v) => { set.sound = v; save(); }));\n          col.append(game.ui.slider(s, 'Voice', () => set.voice, (v) => { set.voice = v; save(); }));\n        }],\n        ['Controls', () => {\n          col.append(game.ui.choice(s, 'Button glyphs', [['ps', 'PlayStation'], ['xbox', 'Xbox']], () => set.glyphs, (v) => { set.glyphs = v; save(); }));\n          col.append(game.ui.choice(s, 'Rumble', [[true, 'On'], [false, 'Off']], () => set.rumble, (v) => { set.rumble = v; save(); }));\n          col.append(game.ui.choice(s, 'Auto-breathe', [[false, 'Off'], [true, 'On']], () => set.autoBreathe, (v) => { set.autoBreathe = v; save(); }));\n          col.append(game.ui.slider(s, 'Rhythm offset', () => set.rhythmOffset, (v) => { set.rhythmOffset = v; save(); }, { min: -200, max: 200, step: 10, format: (v) => `${v} ms` }));\n        }],\n        ['Display', () => {\n          col.append(game.ui.slider(s, 'UI scale', () => set.uiScale, (v) => { set.uiScale = v; save(); }, { min: 100, max: 130, step: 5, format: (v) => `${v}%` }));\n          col.append(game.ui.slider(s, 'Ink strength', () => set.ink, (v) => { set.ink = v; save(); }, { min: 0, max: 150, step: 10, format: (v) => `${v}%` }));\n          col.append(game.ui.choice(s, 'Reduce shake', [[false, 'Off'], [true, 'On']], () => set.reduceShake, (v) => { set.reduceShake = v; save(); }));\n          col.append(s.item(h('div', 'Fullscreen'), { use: () => {\n            const de = document.documentElement;\n            if (document.fullscreenElement) { if (document.exitFullscreen) document.exitFullscreen(); } else if (de.requestFullscreen) { const p = de.requestFullscreen(); if (p && p.catch) p.catch(() => {}); }\n          } }));\n        }],\n        ['Game', () => {\n          col.append(game.ui.choice(s, 'Difficulty', [['gentle', 'Gentle'], ['standard', 'Standard'], ['honest', 'Honest']], () => set.difficulty, (v) => { set.difficulty = v; save(); }));\n          col.append(s.item(h('div', 'Reset save'), { use: () => confirmDialog(game, 'Forget everything? Trudy will pretend she never met you.', 'Forget it all', () => { game.save.reset(); game.programme.syncIsland(); game.applySettings(); game.ui.toast('Done. Who are you, again?'); if (game.flow && game.modeName !== 'title' && game.modeName !== 'menu') { game.paused = false; game.flow.toTitle(); } else if (game.modeName === 'menu') game.flow.toMenu(); }) }));\n        }],\n      ];\n      const render = (pg) => {\n        col.innerHTML = '';\n        s.clearItems();\n        title.textContent = P[pg][0];\n        P[pg][1]();\n        s.setFocus(0, true);\n      };\n      s.pager(P.length, render);\n      render(0);\n    },\n  });\n  return scr;\n}\nEOF\ncat > src/ui/screens/confirm.js <<'EOF'\nimport { h } from '../dom.js';\n\n/** In-game confirm: the page never uses a dialog. */\nexport function confirmDialog(game, text, yes, fn) {\n  let scr = null;\n  const close = () => game.ui.close(scr);\n  scr = game.ui.open({\n    name: 'confirm', className: 'dim', prompts: [['use', 'Choose'], ['back', 'Back']], back: close, focus: 1,\n    build(s) {\n      s.el.append(h('div.tag', { style: 'margin-top:26rem;font-size:4.4rem;max-width:120rem;text-align:center' }, text));\n      const row = h('div.row', { style: 'margin-top:3rem' });\n      s.el.append(row);\n      row.append(s.item(h('div', yes), { use: () => { close(); fn(); } }));\n      row.append(s.item(h('div', 'Never mind'), { use: close }));\n    },\n  });\n}\nEOF\ncat > src/ui/screens/pause.js <<'EOF'\nimport { h } from '../dom.js';\nimport { setPauseOpener } from '../../game/director.js';\nimport { openSettings } from './settings.js';\nimport { promptHTML } from '../../input/glyphs.js';\nimport { EVENTS } from '../../data/events.js';\nimport { openDev } from '../../game/devmode.js';\n\nexport function installPause(game) { setPauseOpener((g, note) => openPause(g, note)); }\n\nexport function resume(game) {\n  const p = game.ui.top;\n  while (game.ui.top && game.ui.top.pauseLayer) game.ui.close(game.ui.top);\n  game.paused = false;\n  if (game.audio.seq) game.audio.seq.resume();\n  if (game.mode && game.mode.onResume) game.mode.onResume();\n  return p;\n}\n\n/** Stops the sim. Resume, Restart, How to Play, Settings, Dev Mode, Leave Class. */\nexport function openPause(game, note) {\n  if (game.paused) return;\n  game.paused = true;\n  if (game.audio.seq) game.audio.seq.pause();\n  game.speech.clear();\n  const m = game.mode;\n  const canRestart = !!(m && m.restart);\n  const scr = game.ui.open({\n    name: 'pause', className: 'dim',\n    prompts: [['use', 'Choose'], ['back', 'Resume']],\n    back: () => resume(game),\n    build(s) {\n      s.pauseLayer = true;\n      s.el.append(h('div.h1', { style: 'margin-top:3rem' }, 'Paused'));\n      if (note) s.el.append(h('div.tag', { style: 'margin-bottom:1.6rem;font-size:3.4rem' }, note));\n      const col = h('div.col');\n      s.el.append(col);\n      const add = (t, use) => col.append(s.item(h('div', t), { use }));\n      add('Resume', () => resume(game));\n      if (canRestart) add('Restart', () => { resume(game); game.go(() => m.restart()); });\n      add('How to Play', () => openHowTo(game));\n      add('Settings', () => { const st = openSettings(game); st.pauseLayer = true; });\n      add('Dev Mode', () => openDev(game));\n      add(m && m.ev ? 'Leave Class' : 'Leave', () => { game.paused = false; while (game.ui.top && game.ui.top.pauseLayer) game.ui.close(game.ui.top); if (game.audio.seq) game.audio.seq.resume(); game.flow.leaveClass(); });\n    },\n  });\n  return scr;\n}\n\nfunction openHowTo(game) {\n  const m = game.mode;\n  const d = m && m.ev ? m.ev.data : null;\n  const verbs = d ? d.verbs : [['move', 'Walk'], ['interact', 'Use'], ['ask', 'Ask Trudy'], ['look', 'Look'], ['hop', 'Hop']];\n  let scr = null;\n  const close = () => game.ui.close(scr);\n  scr = game.ui.open({\n    name: 'howto', className: 'dim', back: close, prompts: [['back', 'Back']],\n    build(s) {\n      s.pauseLayer = true;\n      s.el.append(h('div.h2', { style: 'margin-top:3rem' }, d ? d.title : 'The Island'));\n      const box = h('div.tag', { style: 'max-width:150rem;font-size:3.8rem;margin-top:1rem' });\n      if (d) { box.append(h('p', d.line), h('p', d.can), h('p', { style: 'color:#A0362E' }, d.cant)); }\n      else { box.append(h('p', 'Walk to a class, or pick one from Today\\'s Plan. Everything leans when you lean. Everything rolls when it leans.'), h('p', 'You can talk to anyone. They will say something.'), h('p', { style: 'color:#A0362E' }, \"You can't fall off. There is a fence. It is a low fence.\")); }\n      s.el.append(box);\n      const row = h('div.row', { style: 'margin-top:2rem' });\n      s.el.append(row);\n      const render = () => { row.innerHTML = verbs.map(([v, t]) => promptHTML(v, t, game.input.lastDevice, game.save.settings.glyphs)).join(''); };\n      render();\n      s.updateFn = () => { if (s.dev !== game.input.lastDevice) { s.dev = game.input.lastDevice; render(); } };\n      s.el.append(s.item(h('div', { style: 'margin-top:2rem' }, 'Back'), { use: close }));\n    },\n  });\n  return { EVENTS };\n}\nEOF\ncat > src/ui/screens/about.js <<'EOF'\nimport { h } from '../dom.js';\nimport { ABOUT, SOURCE_LABELS } from '../../data/about.js';\nimport { TITLE, RESORT } from '../../data/config.js';\nimport { TESTING_Q, ENGINE_Q, PROMPT_Q, ABOUT_PAGES, splitPages } from '../../data/aboutPages.js';\n\n/** Large type, one page at a time, moved with left and right or clicks. Long answers take more pages. */\nexport function openAbout(game) {\n  const pages = buildPages();\n  let scr = null;\n  const close = () => { game.ui.close(scr); };\n  scr = game.ui.open({\n    name: 'about', className: 'dim',\n    prompts: [['page', 'Pages'], ['back', 'Back']],\n    back: close,\n    build(s) {\n      s.el.append(h('div.h2', { style: 'margin-top:1rem;font-size:4.6rem' }, 'About / Credits'));\n      const box = h('div.about.tag');\n      s.el.append(box);\n      const render = (pg) => {\n        box.innerHTML = '';\n        const p = pages[pg];\n        box.append(h('h3', p.title));\n        for (const [k, v] of p.rows) { const para = h('p'); if (k) para.append(h('b', `${k}: `)); para.append(document.createTextNode(v)); box.append(para); }\n      };\n      s.pager(pages.length, render);\n      render(0);\n    },\n  });\n  return scr;\n}\n\nfunction buildPages() {\n  const si = ABOUT.sourceInformation || {};\n  const out = [];\n  for (const def of ABOUT_PAGES) {\n    const rows = def.keys.map((k) => [SOURCE_LABELS[k], si[k] ?? 'unknown']);\n    splitPages(rows).forEach((r, i, all) => out.push({ title: `${def.title}${all.length > 1 ? ` (${i + 1})` : ''}`, rows: r }));\n  }\n  const fb = (title, qs, answers) => {\n    const rows = qs.map((q, i) => [q, (answers && answers[i]) ?? 'unknown']);\n    splitPages(rows).forEach((r, i, all) => out.push({ title: `${title}${all.length > 1 ? ` (${i + 1})` : ''}`, rows: r }));\n  };\n  fb('Testing Feedback', TESTING_Q, ABOUT.testingFeedback);\n  fb('Engine Feedback', ENGINE_Q, ABOUT.engineFeedback);\n  fb('Prompt Feedback', PROMPT_Q, ABOUT.promptFeedback);\n  out.push({ title: 'Credits', rows: [\n    ['', `${TITLE} · ${RESORT}`],\n    ['Font', 'Fredoka, by Milena Brandao and Hafontia, SIL Open Font License 1.1'],\n    ['Engine', 'Three.js (MIT), the three.js authors'],\n    ['Physics', 'Rapier (Apache 2.0), Dimforge'],\n    ['Everything else', 'All art, music, sound and voices were made in code for this game.'],\n  ] });\n  return out;\n}\nEOF\ncat > src/data/aboutPages.js <<'EOF'\n// Questions and page layout for the About screen. The answers come from the exit interview.\nexport const TESTING_Q = ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'];\nexport const ENGINE_Q = ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why? (none if nothing)', 'If you could change one thing about the engine, what would it be?'];\nexport const PROMPT_Q = ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'];\nexport const ABOUT_PAGES = [\n  { title: 'Source Information', keys: ['date', 'source', 'plan', 'genre', 'perspective'] },\n  { title: 'Source Information', keys: ['tech', 'artDirection', 'animation'] },\n  { title: 'Source Information', keys: ['audio', 'online', 'testing'] },\n  { title: 'Source Information', keys: ['research', 'environment', 'model', 'usage'] },\n];\nconst MAX_CHARS = 880;\n/** Split rows so no page needs small print or a scroll. */\nexport function splitPages(rows) {\n  const pages = [[]];\n  let n = 0;\n  for (const row of rows) {\n    const len = (row[0] || '').length + String(row[1]).length;\n    if (n + len > MAX_CHARS && pages[pages.length - 1].length) { pages.push([]); n = 0; }\n    if (len > MAX_CHARS) {\n      // A single very long answer: cut at a sentence.\n      let text = String(row[1]);\n      let first = true;\n      while (text.length) {\n        let cut = text.length;\n        if (cut > MAX_CHARS - (first ? (row[0] || '').length : 0)) {\n          const lim = MAX_CHARS - (first ? (row[0] || '').length : 0);\n          cut = text.lastIndexOf('. ', lim);\n          if (cut < lim * 0.4) cut = text.lastIndexOf(' ', lim);\n          cut += 1;\n        }\n        pages[pages.length - 1].push([first ? row[0] : '', text.slice(0, cut).trim()]);\n        text = text.slice(cut).trim();\n        first = false;\n        n = 0;\n        if (text.length) pages.push([]);\n      }\n      n = MAX_CHARS;\n    } else {\n      pages[pages.length - 1].push(row);\n      n += len;\n    }\n  }\n  return pages;\n}\nEOF\ncat > src/ui/screens/journal.js <<'EOF'\nimport { h } from '../dom.js';\nimport { medalSVG } from '../../game/results.js';\nimport { MEDALS } from '../../data/config.js';\nimport { EVENTS, TIER_NAMES } from '../../data/events.js';\n\n/** Calendar, the Wobble Age graph, the medals shelf, silly totals. */\nexport function openJournal(game, onClose = null) {\n  if (!game.save.profile) { const i = game.save.data.profiles.findIndex((x) => x); if (i >= 0) game.programme.selectProfile(i); }\n  const p = game.save.profile;\n  let scr = null;\n  const close = () => { game.ui.close(scr); if (onClose) onClose(); };\n  const medalKeys = p ? Object.keys(p.medals) : [];\n  const medalPages = [];\n  for (let i = 0; i < medalKeys.length; i += 8) medalPages.push(medalKeys.slice(i, i + 8));\n  if (!medalPages.length) medalPages.push([]);\n  const total = 2 + medalPages.length + 1;\n  scr = game.ui.open({\n    name: 'journal', className: 'dim',\n    prompts: [['page', 'Pages'], ['back', 'Back']],\n    back: close,\n    build(s) {\n      const title = h('div.h2', { style: 'margin-top:2rem' }, 'Journal');\n      const box = h('div', { style: 'margin-top:1rem' });\n      s.el.append(title, box);\n      const page = (pg) => {\n        box.innerHTML = '';\n        if (!p) { box.append(h('div.tag', 'Nobody has checked in yet. Trudy has left the page open.')); return; }\n        if (pg === 0) {\n          title.textContent = 'Your Days';\n          const cal = h('div.calendar');\n          const n = Math.max(14, p.stamps.length + 1);\n          for (let i = 1; i <= Math.min(21, n); i++) {\n            const stamp = p.stamps.find((x) => x.day === i);\n            cal.append(h('div.day', String(i), stamp ? h('b', 'DONE') : null));\n          }\n          box.append(cal);\n        } else if (pg === 1) {\n          title.textContent = 'Wobble Age';\n          box.append(graph(p));\n        } else if (pg < total - 1) {\n          title.textContent = 'The Medal Shelf';\n          const sh = h('div.shelf');\n          for (const k of medalPages[pg - 2]) {\n            const [id, tier] = k.split(':');\n            const rec = p.medals[k];\n            const m = MEDALS.find((x) => x.id === rec.medal) || MEDALS[0];\n            sh.append(h('div.m.tag', h('span', { html: medalSVG(m) , style: 'width:9rem;height:9rem;display:block' }), `${EVENTS[id].title}`, h('span', TIER_NAMES[tier])));\n          }\n          if (!medalPages[pg - 2].length) sh.append(h('div.tag', { style: 'grid-column:span 4' }, 'No medals yet. The shelf is very level.'));\n          box.append(sh);\n        } else {\n          title.textContent = 'Silly Totals';\n          box.append(h('div.totals.tag',\n            h('div', `Floor Exercises: ${p.floorExercises}`),\n            h('div', `Minutes: ${Math.round(p.minutes)}`),\n            h('div', `Marbles: ${p.marbles}`),\n            h('div', `Classes: ${p.classes}`)));\n        }\n      };\n      s.pager(total, page);\n      page(0);\n    },\n  });\n  return scr;\n}\n\nfunction graph(p) {\n  const ages = p.ages.slice(-12);\n  const w = 1200, ht = 460;\n  const xOf = (i) => 80 + (i * (w - 160)) / Math.max(1, ages.length - 1);\n  const yOf = (a) => 40 + ((99 - a) / 81) * (ht - 90);\n  let path = '';\n  ages.forEach((a, i) => { path += `${i ? 'L' : 'M'}${xOf(i).toFixed(0)} ${yOf(a.age).toFixed(0)} `; });\n  const dots = ages.map((a, i) => `<circle cx=\"${xOf(i)}\" cy=\"${yOf(a.age)}\" r=\"13\" fill=\"#F5B700\" stroke=\"#1A1420\" stroke-width=\"5\"/>`).join('');\n  const first = ages[0] ? ages[0].age : '-', last = ages.length ? ages[ages.length - 1].age : '-';\n  const best = ages.length ? Math.min(...ages.map((a) => a.age)) : '-';\n  const svg = `<svg viewBox=\"0 0 ${w} ${ht}\"><rect x=\"2\" y=\"2\" width=\"${w - 4}\" height=\"${ht - 4}\" rx=\"24\" fill=\"#FFF4DC\" stroke=\"#1A1420\" stroke-width=\"7\"/><path d=\"${path}\" fill=\"none\" stroke=\"#1A1420\" stroke-width=\"11\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>${dots}</svg>`;\n  return h('div.col', h('div.graph', { html: svg }), h('div.row',\n    h('div.tag', { style: 'font-size:4.4rem' }, `First: ${first}`), h('div.tag', { style: 'font-size:4.4rem' }, `Latest: ${last}`), h('div.tag', { style: 'font-size:4.4rem' }, `Best: ${best}`)));\n}\nEOF\n","description":"Write flow, title, menu, profile, settings, pause, about and journal"}}}
