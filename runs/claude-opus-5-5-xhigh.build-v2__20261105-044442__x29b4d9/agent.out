Enter');\n  const ae = await page.evaluate\"\"\")\nsub('tools/test-flow.mjs',\"\"\"  ok(me === false, 'mouse movement exits attract');\"\"\",\"\"\"  ok(me === false, 'mouse movement exits attract');\n  await page.evaluate(() => { const T = window.__TEST__; T.goto('attract'); T.advance(0.5); });\n  await page.mouse.down({ button: 'left' }); await page.mouse.up({ button: 'left' });\n  const mc = await page.evaluate(() => { const T = window.__TEST__; T.advance(0.2); const s = T.state(); T.advance(0.3); return { attract: s.attract, screen: T.state().screen }; });\n  ok(mc.attract === false && mc.screen === 'title', 'a click exits attract and is swallowed', JSON.stringify(mc));\"\"\")\nsub('tools/test.mjs',\"\"\"  // Soak the removal paths with the doll swaying\"\"\",\"\"\"  // The engine's animation system: the mixer's time advances and clips change.\n  const clips = await page.evaluate(() => {\n    const T = window.__TEST__, g = T.game;\n    const seen = {};\n    for (const id of ['poses', 'logReps', 'roomService', 'springboard']) {\n      T.startEvent(id, 0, {});\n      const ev = g.currentEvent, rig = ev.lanes[0].doll.rig;\n      T.bot('sharp');\n      const names = new Set(), t0 = rig.time;\n      for (let i = 0; i < 40 && !ev.isDone(); i++) { T.advance(0.5); names.add(rig.currentName); }\n      seen[id] = { names: [...names], advanced: rig.time - t0 };\n      T.bot(null);\n    }\n    T.goto('menu');\n    return seen;\n  });\n  for (const id of Object.keys(clips)) {\n    ok(clips[id].advanced > 1, `${id}: the mixer's time advances`, String(clips[id].advanced));\n    ok(clips[id].names.length >= 2, `${id}: clips change`, clips[id].names.join(','));\n  }\n  // Soak the removal paths with the doll swaying\"\"\")\nEOF\nfor i in $(seq 1 40); do a=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo); [ \"$a\" -ge 3 ] && break; sleep 10; done; H=../WeFib-WiiFit-claude-opus-5-5-xhigh-20261105-044442.html; echo \"checksum $(sha256sum $H | cut -c1-16)\"; printf \"flow