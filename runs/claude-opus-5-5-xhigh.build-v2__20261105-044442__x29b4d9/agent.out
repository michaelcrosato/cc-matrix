{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmARQZxpi88CdMP5Pfb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SHED4AYyU8jY6gFqabxQBr","name":"Bash","input":{"command":"cat > src/game/director.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { Scripts, Handle } from '../core/script.js';\nimport { Loop } from '../core/loop.js';\nimport { Save } from '../core/save.js';\nimport { tun } from '../core/tuning.js';\nimport { TUNING } from '../data/tuning.js';\nimport { initPhysics, RAPIER } from '../physics/world.js';\nimport { IslandPhysics } from '../physics/island.js';\nimport { IslandArt } from '../art/island.js';\nimport { Input } from '../input/input.js';\nimport { AudioEngine } from '../audio/engine.js';\nimport { UI } from '../ui/ui.js';\nimport { Speech } from '../ui/speech.js';\nimport { HUD } from '../ui/hud.js';\nimport { h } from '../ui/dom.js';\nimport { makeInk } from '../render/ink.js';\nimport { Palette } from '../render/palette.js';\nimport { makeSky } from '../render/sky.js';\nimport { makeSea } from '../render/sea.js';\nimport { CameraRig } from '../render/cameraRig.js';\nimport { Particles } from '../render/particles.js';\nimport { ComicText } from '../render/comicText.js';\nimport { geo, toon } from '../art/materials.js';\nimport { line } from '../data/dialogue.js';\nimport { Programme } from './programme.js';\nimport { RESORT } from '../data/config.js';\nimport { fruitColours } from '../art/palettes.js';\n\nconst _m = new THREE.Matrix4(), _p = new THREE.Vector3(), _q = new THREE.Quaternion(), _s = new THREE.Vector3(1, 1, 1), _iq = new THREE.Quaternion();\n\n/** The whole game: engine parts, one current mode, and the sim-time scripts that drive the flow. */\nexport class Game {\n  constructor(params) {\n    this.params = params;\n    this.loop = new Loop(this);\n    this.scripts = new Scripts();\n    let storage = null;\n    try { storage = window.localStorage; } catch (e) { storage = null; }\n    this.save = new Save(storage);\n    this.errors = []; this.paused = false; this.mode = null; this.modeName = 'boot';\n    this.stopT = 0; this.wiping = false; this.simTime = 0; this.islandOn = true; this.renderLost = null;\n    this.devStep = 0; this.god = false; this.attract = false;\n    this.backend = 'none'; this.frames = 0;\n    this.touchOnly = false;\n    this.inSession = false;\n    this.programme = new Programme(this);\n  }\n  noteError(e) {\n    const msg = (e && e.message) || String(e);\n    if (this.errors.length < 30) this.errors.push(msg);\n  }\n  async bootEngine() {\n    await initPhysics();\n    this.scene = new THREE.Scene();\n    this.camera = new THREE.PerspectiveCamera(38, innerWidth / Math.max(1, innerHeight), 0.1, 1400);\n    this.rig = new CameraRig(this.camera);\n    this.rig.reduce = this.save.settings.reduceShake;\n    this.sun = new THREE.DirectionalLight(0xffffff, 3);\n    this.sun.castShadow = true;\n    this.sun.shadow.mapSize.set(2048, 2048);\n    this.sun.shadow.bias = -0.0006; this.sun.shadow.normalBias = 0.035;\n    const sc = this.sun.shadow.camera; sc.left = -34; sc.right = 34; sc.top = 34; sc.bottom = -34; sc.near = 1; sc.far = 220;\n    this.sun.position.set(38, 70, 42);\n    this.sunDir = new THREE.Vector3(38, 70, 42).normalize();\n    this.hemi = new THREE.HemisphereLight(0xffffff, 0x888888, 1.35);\n    this.scene.add(this.sun, this.sun.target, this.hemi);\n    this.palette = new Palette(this.sun, this.hemi);\n    this.sky = makeSky(this.palette);\n    this.sea = makeSea(this.palette);\n    this.scene.add(this.sky.group, this.sea.mesh);\n    this.fx = new Particles();\n    this.fx.addTo(this.scene);\n    this.comic = new ComicText(this.scene);\n    // Renderer\n    if (this.params.render) await this.startRenderer();\n    // Island\n    this.art = new IslandArt();\n    this.scene.add(this.art.holder);\n    this.phys = new IslandPhysics();\n    this.buildIslandProps();\n    this.art.buildMarbles();\n    // Input, audio, UI\n    this.input = new Input();\n    this.input.attach(window);\n    this.input.rumbleOn = this.save.settings.rumble;\n    this.audio = new AudioEngine(() => this.save.settings);\n    this.input.onGesture = () => this.audio.gesture();\n    const root = document.getElementById('ui');\n    this.hud = new HUD(this, root);\n    this.ui = new UI(this, root);\n    this.speech = new Speech(this, root);\n    this.audioTag = h('div.audio-tag.tag', 'Press a key or click for sound');\n    this.audioTag.style.display = 'none';\n    root.append(this.audioTag);\n    this.programme.syncIsland();\n    this.phys.snapTilt();\n    this.applySettings();\n    window.addEventListener('resize', () => this.resize());\n    this.resize();\n  }\n  async startRenderer() {\n    const canvasParent = document.body;\n    const renderer = new THREE.WebGPURenderer({ antialias: true });\n    this.renderer = renderer;\n    await renderer.init();\n    this.backend = renderer.backend && renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\n    const dev = renderer.backend && renderer.backend.device;\n    if (dev && dev.lost) dev.lost.then((info) => { this.renderLost = info.message || 'lost'; });\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n    renderer.setSize(innerWidth, innerHeight);\n    renderer.toneMapping = THREE.NoToneMapping;\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFShadowMap;\n    canvasParent.prepend(renderer.domElement);\n    const ink = makeInk(renderer, this.scene, this.camera);\n    this.post = ink.post; this.inkU = ink.u;\n  }\n  resize() {\n    this.camera.aspect = innerWidth / Math.max(1, innerHeight);\n    this.camera.updateProjectionMatrix();\n    if (this.renderer) this.renderer.setSize(innerWidth, innerHeight);\n  }\n  applySettings() {\n    const s = this.save.settings;\n    this.audio.applyLevels();\n    document.documentElement.style.setProperty('--s', String(s.uiScale / 100));\n    this.input.rumbleOn = s.rumble;\n    this.rig.reduce = s.reduceShake;\n    this.inkStrength = s.ink / 100;\n    this.applyInk();\n  }\n  applyInk() {\n    if (!this.inkU) return;\n    const k = this.inkOff ? 0 : this.inkStrength;\n    this.inkU.hull.value = tun.hull * k; this.inkU.width.value = tun.lineWidth; this.inkU.boil.value = tun.boil; this.inkU.grain.value = tun.grain;\n    this.inkU.strength.value = k;\n  }\n  buildIslandProps() {\n    const oranges = this.phys.props.filter((p) => p.kind === 'orange');\n    const m = this.orangeMesh = new THREE.InstancedMesh(geo.sphere(0.14, 12, 10), toon(0xF08A3C), oranges.length);\n    m.castShadow = true; m.frustumCulled = false;\n    this.art.group.add(m);\n    this.propMeshes = [];\n    for (const p of this.phys.props) {\n      if (p.kind === 'orange') continue;\n      let mesh;\n      if (p.kind === 'ball') {\n        mesh = new THREE.Group();\n        const colours = [0xE8443A, 0xFFF3DC, 0x3B82F6];\n        for (let i = 0; i < 3; i++) { const s = new THREE.Mesh(geo.sphere(0.32, 14, 10), toon(colours[i])); s.scale.set(1 - i * 0.02, 1 - i * 0.02, i === 0 ? 1 : i === 1 ? 0.62 : 0.28); s.castShadow = i === 0; mesh.add(s); }\n      } else {\n        mesh = new THREE.Mesh(geo.box(0.6, 0.5, 0.6), toon(0xC99A62)); mesh.castShadow = true;\n      }\n      this.art.group.add(mesh);\n      this.propMeshes.push({ p, mesh });\n    }\n    this.oranges = oranges;\n  }\n  /** Step the island's physics. weight 0 when nobody stands on it. */\n  stepIsland(dt, weight = 1) { this.phys.step(dt, { weight }); }\n  /** Copy island physics to its art. */\n  syncIsland(dt) {\n    const ph = this.phys, art = this.art;\n    art.group.quaternion.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w);\n    _iq.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w).invert();\n    for (let i = 0; i < this.oranges.length; i++) {\n      const t = this.oranges[i].body.translation();\n      _p.set(t.x, t.y, t.z); _q.set(0, 0, 0, 1);\n      _m.compose(_p, _q, _s);\n      this.orangeMesh.setMatrixAt(i, _m);\n    }\n    this.orangeMesh.instanceMatrix.needsUpdate = true;\n    for (const { p, mesh } of this.propMeshes) {\n      const t = p.body.translation(), r = p.body.rotation();\n      mesh.position.set(t.x, t.y, t.z); mesh.quaternion.set(r.x, r.y, r.z, r.w);\n    }\n    art.updateCast(dt, _iq);\n    art.heron.root.quaternion.copy(_iq);\n    art.walrus.root.quaternion.copy(_iq).multiply(_q.setFromAxisAngle(_p.set(0, 1, 0), 0.5));\n    art.gary.root.quaternion.copy(_iq);\n    this.audio.setTilt(ph.restNow);\n    this.sea.setTilt(ph.tx, ph.tz);\n  }\n  /** Island in the foreground (hub), far away (scenery), or hidden. */\n  setIsland(mode, x = 0, z = 0) {\n    const h2 = this.art.holder;\n    this.islandMode = mode;\n    if (mode === 'home') {\n      h2.visible = true; h2.position.set(0, 0, 0); h2.scale.setScalar(1);\n      this.sea.setLevel(-6.4); this.sea.setFoam(0, 0, 26);\n      this.focus(0, 0, 0, 40);\n    } else if (mode === 'far') {\n      h2.visible = true; h2.position.set(x, 3, z);\n      this.sea.setFoam(x, z, 26);\n    } else h2.visible = false;\n  }\n  setBackdrop(x, z) { this.setIsland('far', x, z); }\n  /** Point the sun's shadow frustum at what matters. */\n  focus(x, y, z, size = 26) {\n    const c = this.sun.shadow.camera;\n    if (c.right !== size) { c.left = -size; c.right = size; c.top = size; c.bottom = -size; c.updateProjectionMatrix(); }\n    this.sun.target.position.set(x, y, z);\n    this.sun.position.set(x, y, z).addScaledVector(this.sunDir, 90);\n  }\n  line(who, sit, vars) { return line(who, sit, vars); }\n  /** Say a line and wait for Use. yield* game.say('trudy', 'morning'). */\n  *say(who, situation, vars) { yield* this.sayText(who, line(who, situation, vars)); }\n  *sayText(who, text) {\n    if (!text) return;\n    const l = this.speech.say(who, text);\n    yield () => l.done || this.speech.line !== l;\n  }\n  bark(who, situation, vars, auto = 3) { const t = line(who, situation, vars); if (t) this.speech.say(who, t, { auto }); }\n  hitStop(sec) { this.stopT = Math.max(this.stopT, sec); }\n  onFloorExercise() { const p = this.save.profile; if (p && !this.attract) { p.floorExercises++; } }\n  setMode(mode, name) {\n    if (this.mode && this.mode.exit) this.mode.exit();\n    this.mode = mode; this.modeName = name || (mode && mode.name) || 'none';\n    if (mode && mode.enter) mode.enter();\n  }\n  /** The ink-blot wipe, then fn, then the wipe back. */\n  *wipe(fn, dur = 0.32) {\n    if (this.inkU) this.inkU.wipe.value = 0;\n    this.wiping = true; this.ui.inert = true;\n    let t = 0;\n    while (t < dur) { t += 1 / 120; if (this.inkU) this.inkU.wipe.value = Math.min(1, t / dur); yield null; }\n    if (this.inkU) this.inkU.wipe.value = 1;\n    fn();\n    yield 0.04;\n    this.ui.inert = false;\n    t = 0;\n    while (t < dur) { t += 1 / 120; if (this.inkU) this.inkU.wipe.value = Math.max(0, 1 - t / dur); yield null; }\n    if (this.inkU) this.inkU.wipe.value = 0;\n    this.wiping = false;\n  }\n  go(fn) { return this.scripts.run(this.wipe(fn)); }\n  fixed(dt) {\n    try { this._fixed(dt); } catch (e) { this.fatal(e); }\n    this.input.endTick();\n  }\n  _fixed(dt) {\n    const input = this.input;\n    if (this.beforePoll) this.beforePoll(dt);\n    input.poll(dt);\n    this.speechInput();\n    this.ui.fixed(dt);\n    if (this.inSession === false && this.mode && this.mode.canPause && !this.paused && !this.wiping && input.verb('pause') && !this.speech.active) {\n      this.openPause();\n      return;\n    }\n    if (input.lostPads.length && this.mode && this.mode.canPause && !this.paused && this.modeUsesPad(input.lostPads)) {\n      this.openPause(`Controller ${input.lostPads[0] + 1} disconnected. Reconnect it, or carry on with another.`);\n      return;\n    }\n    if (this.paused && !this.devStep) { if (this.mode && this.mode.pausedFixed) this.mode.pausedFixed(dt); return; }\n    if (this.devStep) this.devStep--;\n    if (this.stopT > 0) { this.stopT -= dt; return; }\n    this.simTime += dt;\n    this.speech.fixed(dt);\n    this.scripts.tick(dt);\n    if (this.mode && this.mode.fixed) this.mode.fixed(dt);\n    if (this.afterFixed) this.afterFixed(dt);\n  }\n  modeUsesPad(list) {\n    const m = this.mode;\n    if (!m || !m.ev) return list.includes(this.input.activePad) && this.input.lastDevice === 'pad';\n    return m.ev.lanes.some((l) => l.kind === 'local' && (l.source === `pad:${list[0]}` || (l.source === 'any' && this.input.lastDevice === 'pad' && list.includes(this.input.activePad))));\n  }\n  speechInput() {\n    const l = this.speech.line;\n    if (!l || l.auto || this.paused) return;\n    const input = this.input;\n    const used = input.verb('confirm') || (input.btnEdge & 1);\n    if (used && !(this.ui.top && !this.ui.top.passive)) {\n      input.verbs.delete('confirm');\n      input.pressedUse = true;\n      this.speech.advance();\n    }\n  }\n  frame(dt) {\n    try { this._frame(dt); } catch (e) { this.fatal(e); }\n  }\n  _frame(dt) {\n    this.ui.frame(dt);\n    this.hud.frame(dt);\n    const sim = this.paused ? 0 : dt;\n    if (!this.paused) {\n      if (this.mode && this.mode.frame) this.mode.frame(sim);\n      this.fx.frame(sim);\n      this.comic.frame(sim);\n      this.sky.frame(sim);\n    }\n    this.palette.frame(dt);\n    this.rig.frame(sim || 0.0001);\n    if (this.devFrame) this.devFrame(dt);\n    const stuck = this.audio.stuck();\n    if (this.audioTag.dataset.on !== String(stuck)) { this.audioTag.dataset.on = String(stuck); this.audioTag.style.display = stuck ? '' : 'none'; }\n  }\n  async render() {\n    if (!this.renderer || !this.post || this.paused2) return;\n    await this.post.renderAsync();\n    this.frames++;\n  }\n  /** Rapier's panic kills physics for the page. Save and reload; in a session, tell the hub. */\n  fatal(e) {\n    this.noteError(e);\n    const msg = (e && e.message) || String(e);\n    if (this._fatal) return;\n    if (/unreachable|recursive|memory access/i.test(msg)) {\n      this._fatal = true;\n      if (window.AIHub && window.AIHub.active) { window.AIHub.fail(`Physics stopped: ${msg}`); return; }\n      this.save.write();\n      if (!this.params.test) location.reload();\n    }\n  }\n  openPause(note) { import_pause(this, note); }\n}\nlet import_pause = () => {};\nexport function setPauseOpener(f) { import_pause = f; }\nexport { Handle, RAPIER, RESORT, TUNING, fruitColours };\nEOF\ncat > src/art/palettes.js <<'EOF'\nexport const fruitColours = [0xF08A3C, 0xD9483B, 0xF5D547, 0x86C24A];\nEOF\ncat > src/game/programme.js <<'EOF'\nimport { DAYS, MAINTENANCE, HANDICAP, wobbleAge, restTilt, marblesFor, CHECKIN_MARBLES } from '../data/programme.js';\nimport { hasEvent } from '../events/index.js';\nimport { EVENTS, TIER_NAMES } from '../data/events.js';\nimport { medalFor } from '../data/config.js';\nimport { UNLOCKS, HATS, STARTER_PAINTS, LATE_PAINTS } from '../data/unlocks.js';\nimport { rng } from '../core/rng.js';\nimport { tun } from '../core/tuning.js';\nimport { newProfile } from '../core/save.js';\n\n/** Days, classes, medals, marbles and how crooked the island is. Plain rules, no scenes. */\nexport class Programme {\n  constructor(game) { this.game = game; }\n  get profile() { return this.game.save.profile; }\n  dayDef(day) {\n    if (day <= DAYS.length) {\n      const d = DAYS[day - 1];\n      return { ...d, classes: d.classes.filter(hasEvent) };\n    }\n    return { day, name: MAINTENANCE.name, tests: 'random', classes: null, maintenance: true };\n  }\n  get totalSteps() {\n    let n = 0;\n    for (const d of DAYS) n += d.classes.filter(hasEvent).length;\n    return Math.max(1, n);\n  }\n  /** Today's classes. Maintenance days get three random ones from Trudy, fixed once dealt. */\n  classesToday() {\n    const p = this.profile;\n    if (!p) return [];\n    const def = this.dayDef(p.today.day);\n    if (def.classes) return def.classes;\n    if (!p.today.plan) {\n      const r = rng(`maintenance-${p.today.day}`);\n      const pool = Object.keys(EVENTS).filter((id) => hasEvent(id) && id !== 'grandHold');\n      const out = [];\n      while (out.length < MAINTENANCE.classes && pool.length) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n      p.today.plan = out;\n    }\n    return p.today.plan;\n  }\n  /** Tests today: fixed list, your three best, or a random three. */\n  testsToday() {\n    const p = this.profile;\n    const def = this.dayDef(p.today.day);\n    if (Array.isArray(def.tests)) return def.tests;\n    const all = ['standStill', 'leanMatch', 'stepTime', 'quickLean', 'oneFoot'];\n    if (def.tests === 'best') {\n      const best = p.testBest || {};\n      return all.slice().sort((a, b) => (best[b] ?? 0) - (best[a] ?? 0)).slice(0, 3);\n    }\n    const r = rng(`tests-${p.today.day}`);\n    const pool = all.slice(), out = [];\n    while (out.length < 3) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n    return out;\n  }\n  handicap(day) { return day <= HANDICAP.length ? HANDICAP[day - 1] : 0; }\n  ageFor(mean, day) { return wobbleAge(mean, this.handicap(day)); }\n  stepsDone() { const p = this.profile; return p ? Math.min(p.stepsDone, this.totalSteps) : 0; }\n  restDeg() {\n    const p = this.profile;\n    if (!p) return tun.islandRest;\n    return p.levelled ? 0 : restTilt(p.stepsDone, this.totalSteps, tun.islandRest);\n  }\n  syncIsland() { if (this.game.phys) this.game.phys.setRest(this.restDeg()); }\n  /** Tier used in the programme: Tier 1 for Days 1-5, the highest open on Maintenance days. */\n  programmeTier(id) {\n    const p = this.profile;\n    if (p.today.day <= DAYS.length) return 0;\n    return this.highestTier(id);\n  }\n  highestTier(id) { const p = this.profile; return p ? Math.max(0, Math.min(EVENTS[id].tiers.length - 1, p.tiers[id] ?? 0)) : 0; }\n  tierOpen(id, t) { return t <= this.highestTier(id); }\n  seen(id) { const p = this.profile; return !!(p && (p.seen[id] || p.levelled)); }\n  freePlayList() { return Object.keys(EVENTS).filter((id) => hasEvent(id) && this.seen(id)); }\n  medalOf(id, tier) { const p = this.profile; return p && p.medals[`${id}:${tier}`]; }\n  planLeft() {\n    const p = this.profile;\n    return this.classesToday().filter((id) => !p.today.done.includes(id));\n  }\n  nextClass() { return this.planLeft()[0] || null; }\n  /**\n   * Record a finished class. Returns what changed: marbles, medal, first clear, unlocks, notch.\n   * programme: this class counted toward today's plan.\n   */\n  record(id, tier, form, activeSec, programme) {\n    const p = this.profile;\n    const scaled = form / tun.medalScale;\n    const m = medalFor(scaled);\n    const key = `${id}:${tier}`;\n    const prev = p.medals[key];\n    const firstClear = !prev;\n    if (!prev || prev.form < scaled) p.medals[key] = { form: Math.round(scaled), medal: m.id };\n    const out = { medal: m, firstClear, marbles: 0, notch: false, tierOpened: null, unlocks: [] };\n    p.seen[id] = true;\n    p.classes++;\n    p.minutes += activeSec / 60;\n    if (tier === 0 && scaled >= 65 && (p.tiers[id] ?? 0) < 1 && EVENTS[id].tiers.length > 1) { p.tiers[id] = 1; out.tierOpened = 1; }\n    if (tier === 1 && scaled >= 85 && (p.tiers[id] ?? 0) < 2 && EVENTS[id].tiers.length > 2) { p.tiers[id] = 2; out.tierOpened = 2; }\n    if (programme && !p.today.done.includes(id) && this.classesToday().includes(id)) {\n      p.today.done.push(id);\n      if (p.today.day <= DAYS.length) { p.stepsDone++; out.notch = true; }\n    }\n    out.marbles = marblesFor(activeSec / 60, m.bonus, firstClear, tun.marblesPerMinute);\n    this.addMarbles(out.marbles, m.id, out);\n    this.syncIsland();\n    this.game.save.write();\n    return out;\n  }\n  addMarbles(n, medalId, out = {}) {\n    const p = this.profile;\n    const before = p.marbles;\n    p.marbles += n;\n    p.marbleLog = p.marbleLog || [];\n    for (let i = 0; i < n; i++) p.marbleLog.push(medalId);\n    if (p.marbleLog.length > 320) p.marbleLog.splice(0, p.marbleLog.length - 320);\n    out.unlocks = out.unlocks || [];\n    for (const u of UNLOCKS) if (before < u.at && p.marbles >= u.at) out.unlocks.push(u);\n    return out;\n  }\n  hatsOpen() { const p = this.profile; return HATS.filter((x) => (p ? p.marbles >= x.at : x.at === 0) || (p && p.allUnlocked)); }\n  paintsOpen() {\n    const p = this.profile;\n    const open = STARTER_PAINTS.slice();\n    for (const l of LATE_PAINTS) if (p && (p.marbles >= l.at || p.allUnlocked)) open.push(l.id);\n    return open;\n  }\n  checkinDone(age, scores) {\n    const p = this.profile;\n    p.today.checkin = true; p.today.age = age;\n    p.ages.push({ day: p.today.day, age });\n    p.testBest = p.testBest || {};\n    for (const k of Object.keys(scores)) p.testBest[k] = Math.max(p.testBest[k] ?? 0, scores[k]);\n    const out = this.addMarbles(CHECKIN_MARBLES, 'attended');\n    this.game.save.write();\n    return out;\n  }\n  /** Bed: stamp the day and turn to the next. */\n  nextDay() {\n    const p = this.profile;\n    p.stamps.push({ day: p.today.day, at: Date.now() });\n    p.day = p.today.day + 1;\n    p.today = { day: p.day, checkin: false, age: null, done: [], question: false };\n    p.lastSeen = Date.now();\n    this.game.save.write();\n  }\n  createProfile(slot, name, paint) {\n    const d = this.game.save.data;\n    d.profiles[slot] = newProfile(name, paint);\n    d.activeProfile = slot;\n    this.game.save.write();\n    this.syncIsland();\n  }\n  selectProfile(slot) { this.game.save.data.activeProfile = slot; this.game.save.write(); this.syncIsland(); }\n  tierName(t) { return TIER_NAMES[t] || ''; }\n}\nEOF\ncat > src/ui/diagrams.js <<'EOF'\n// One small diagram per event, drawn in code. Ink on paper, like a wall chart.\nconst I = '#1A1420';\nconst svg = (inner) => `<svg viewBox=\"0 0 320 200\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"${I}\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${inner}</svg>`;\nconst peg = (x, y, r = 0, c = '#2CB5A0') => `<g transform=\"translate(${x},${y}) rotate(${r})\"><circle cx=\"0\" cy=\"-64\" r=\"17\" fill=\"#F2D3A8\"/><rect x=\"-16\" y=\"-48\" width=\"32\" height=\"42\" rx=\"13\" fill=\"${c}\"/><path d=\"M-7 -6V18M7 -6V18\"/></g>`;\nconst dialog = (cx, cy, r, dx, dy) => `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"#FFF4DC\"/><circle cx=\"${cx + dx}\" cy=\"${cy + dy}\" r=\"${r * 0.3}\" fill=\"#9BE08F\" stroke=\"#2F8F46\"/><circle cx=\"${cx + dx}\" cy=\"${cy + dy}\" r=\"${r * 0.12}\" fill=\"${I}\"/>`;\nexport const DIAGRAMS = {\n  ring: svg(`${peg(90, 150, 10)}${dialog(220, 95, 66, -18, 8)}<path d=\"M120 80l40 8\" stroke-dasharray=\"7 9\"/>`),\n  stack: svg(`${peg(160, 180)}<rect x=\"110\" y=\"94\" width=\"100\" height=\"10\" rx=\"4\" fill=\"#D8D3C4\"/><rect x=\"128\" y=\"74\" width=\"64\" height=\"20\" rx=\"7\" fill=\"#D8D3C4\"/><rect x=\"134\" y=\"56\" width=\"52\" height=\"18\" rx=\"7\" fill=\"#D8D3C4\"/><rect x=\"141\" y=\"40\" width=\"38\" height=\"16\" rx=\"7\" fill=\"#D8D3C4\"/><path d=\"M160 6v22M152 20l8 8 8-8\"/>`),\n  calm: svg(`<ellipse cx=\"160\" cy=\"165\" rx=\"130\" ry=\"26\" fill=\"#5AC0C4\"/><ellipse cx=\"160\" cy=\"150\" rx=\"58\" ry=\"13\" fill=\"#79C26A\"/>${peg(160, 130, 0)}<ellipse cx=\"160\" cy=\"165\" rx=\"86\" ry=\"17\" stroke-dasharray=\"6 9\"/><path d=\"M238 56c8-8 18-8 26 0M222 80c8-8 18-8 26 0\"/>`),\n  squat: svg(`<g transform=\"translate(160,170)\"><rect x=\"-120\" y=\"-96\" width=\"240\" height=\"18\" rx=\"9\" fill=\"#9A6E3E\"/><circle cx=\"0\" cy=\"-116\" r=\"17\" fill=\"#F2D3A8\"/><rect x=\"-18\" y=\"-90\" width=\"36\" height=\"42\" rx=\"13\" fill=\"#2CB5A0\"/><path d=\"M-12 -46l-22 26 14 22M12 -46l22 26-14 22\"/></g><path d=\"M288 44v96M278 128l10 12 10-12M278 56l10-12 10 12\"/>`),\n  plank: svg(`<rect x=\"44\" y=\"140\" width=\"232\" height=\"14\" rx=\"6\" fill=\"#C99A62\"/><rect x=\"66\" y=\"108\" width=\"150\" height=\"28\" rx=\"13\" fill=\"#2CB5A0\"/><circle cx=\"238\" cy=\"112\" r=\"17\" fill=\"#F2D3A8\"/><path d=\"M120 66c10-12 26-12 36 0M170 44c10-12 26-12 36 0\"/><path d=\"M138 66v28M188 44v50\" stroke-dasharray=\"6 8\"/>`),\n  tug: svg(`${peg(60, 170, -16)}${peg(260, 170, 16, '#E8644A')}<path d=\"M80 110Q160 122 240 110\" stroke-width=\"7\" stroke=\"#9A6E3E\"/><path d=\"M160 96v42\"/><path d=\"M26 40l-16 12 16 12M10 52h38\"/>`),\n  steps: svg(`<path d=\"M50 190L130 40M270 190L190 40\" stroke-dasharray=\"6 9\"/><ellipse cx=\"108\" cy=\"150\" rx=\"22\" ry=\"12\" fill=\"#7FB4E8\"/><ellipse cx=\"212\" cy=\"150\" rx=\"22\" ry=\"12\" fill=\"#E8707A\"/><ellipse cx=\"128\" cy=\"84\" rx=\"14\" ry=\"8\" fill=\"#7FB4E8\"/><ellipse cx=\"192\" cy=\"60\" rx=\"11\" ry=\"6\" fill=\"#E8707A\"/>`),\n  plates: svg(`${peg(160, 170)}<ellipse cx=\"160\" cy=\"130\" rx=\"60\" ry=\"16\" stroke=\"#D9483B\"/><path d=\"M60 170V70M260 170V70\"/><ellipse cx=\"60\" cy=\"66\" rx=\"34\" ry=\"9\" fill=\"#2CB5A0\"/><ellipse cx=\"260\" cy=\"66\" rx=\"24\" ry=\"7\" fill=\"#F08A3C\"/><path d=\"M122 54c24-20 52-20 76 0M198 54l-2-14M198 54l-14 2\"/>`),\n  loop: svg(`<ellipse cx=\"160\" cy=\"105\" rx=\"130\" ry=\"72\" fill=\"#F6E2B3\"/><ellipse cx=\"160\" cy=\"105\" rx=\"90\" ry=\"44\" fill=\"#8CCB6A\"/><path d=\"M34 105c8-30 38-48 64-58M98 47l-16 0M98 47l-10 14\"/>${peg(40, 130)}<circle cx=\"110\" cy=\"44\" r=\"8\" fill=\"#FFF4DC\"/>`),\n  hat: svg(`${peg(150, 186)}<ellipse cx=\"150\" cy=\"94\" rx=\"58\" ry=\"12\" fill=\"#C99A62\"/><path d=\"M92 94l10 22h96l10-22\"/><circle cx=\"130\" cy=\"84\" r=\"12\" fill=\"#F08A3C\"/><circle cx=\"160\" cy=\"80\" r=\"12\" fill=\"#D9483B\"/><path d=\"M270 30Q230 20 190 50\" stroke-dasharray=\"6 9\"/><circle cx=\"182\" cy=\"56\" r=\"11\" fill=\"#F5D547\"/><rect x=\"232\" y=\"150\" width=\"56\" height=\"40\" fill=\"#C99A62\"/>`),\n  tray: svg(`${peg(100, 180)}<rect x=\"124\" y=\"82\" width=\"110\" height=\"9\" rx=\"4\" fill=\"#C99A62\"/><path d=\"M140 82V58h14v24M172 82V58h14v24M204 82V58h14v24\"/><path d=\"M26 40h60M16 62h44M34 84h34\"/><path d=\"M256 180h50\" stroke-dasharray=\"6 8\"/>`),\n  dive: svg(`<rect x=\"34\" y=\"96\" width=\"60\" height=\"96\" fill=\"#D9483B\"/><path d=\"M94 96h78\"/><path d=\"M186 92c30-40 66-14 80 36\" stroke-dasharray=\"6 9\"/><circle cx=\"218\" cy=\"60\" r=\"15\" fill=\"#F2D3A8\"/><rect x=\"222\" y=\"74\" width=\"20\" height=\"40\" rx=\"10\" fill=\"#2CB5A0\" transform=\"rotate(-30 232 94)\"/><path d=\"M0 176c50 0 90 4 320 0\" stroke=\"#3B82F6\" stroke-width=\"7\"/>`),\n  raft: svg(`<ellipse cx=\"160\" cy=\"156\" rx=\"132\" ry=\"26\" fill=\"#C99A62\"/>${peg(102, 150, 8)}${peg(160, 140, -6, '#E8644A')}${peg(222, 152, 10, '#F5B700')}<path d=\"M6 186c26-10 52-10 78 0s52 10 78 0 52-10 78 0 52 10 74 0\" stroke=\"#3B82F6\"/>`),\n  hold: svg(`<path d=\"M138 186l10-120h24l10 120z\" fill=\"#FFF3DC\"/><path d=\"M142 150h36M146 110h28\" stroke=\"#D9483B\" stroke-width=\"9\"/><rect x=\"132\" y=\"58\" width=\"56\" height=\"9\" fill=\"#FFF3DC\"/>${peg(160, 56, 6)}<path d=\"M20 186h280\"/>`),\n  test: svg(`${peg(100, 170)}${dialog(226, 100, 62, 0, 0)}`),\n};\nexport const diagram = (name) => DIAGRAMS[name] || DIAGRAMS.test;\nEOF\ncat > src/game/eventRun.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { EVENT_CLASSES } from '../events/index.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { diagram } from '../ui/diagrams.js';\nimport { TIER_NAMES } from '../data/events.js';\nimport { line } from '../data/dialogue.js';\nimport { showResults } from './results.js';\nimport { SPEAKERS } from '../ui/speech.js';\n\n/**\n * Runs one event: Intro Card → instructor counts 3-2-1 → play → whistle → results.\n * opts: { id, tier, lanes, mode, config, onResult(ev, results) -> handled, onLeave, skipIntro, god, retry, seed }\n */\nexport class EventRun {\n  constructor(game, opts) {\n    this.game = game; this.opts = opts; this.name = 'event'; this.canPause = opts.mode !== 'attract' && opts.mode !== 'session';\n    this.ev = null; this.handle = null; this.stage = 'intro';\n  }\n  enter() {\n    const { game, opts } = this;\n    const Cls = EVENT_CLASSES[opts.id];\n    game.setIsland('hidden');\n    game.fx.clear(); game.comic.clear(); game.speech.clear();\n    this.ev = new Cls({ game, tier: opts.tier || 0, lanes: opts.lanes, mode: opts.mode || 'solo', config: opts.config, god: opts.god || game.god });\n    game.currentEvent = this.ev;\n    this.ev.build();\n    game.sea.setLevel(this.ev.seaLevel);\n    game.palette.set(this.ev.data.palette || opts.palette || game.programmePalette(), 1.5);\n    game.focus(0, 0, 0, Math.max(14, 8 + this.ev.lanes.length * 3));\n    this.ev.cameraShot(true);\n    game.ui.clear();\n    const hud = game.hud;\n    hud.reset();\n    if (this.ev.discs) hud.setDiscs(this.ev.lanes.filter((l) => l.kind !== 'bot' || opts.mode === 'attract').filter((l) => l.kind !== 'ghost'), this.ev.lanes.length > 1 && opts.mode !== 'session');\n    hud.setPrompts(this.ev.data.verbs);\n    this.ev.hudSetup(hud);\n    if (opts.afterBuild) opts.afterBuild(this.ev);\n    this.handle = game.scripts.run(this.flow());\n  }\n  *flow() {\n    const { game, ev, opts } = this;\n    if (!opts.skipIntro) {\n      game.hud.show(false);\n      this.stage = 'intro';\n      let go = false;\n      game.audio.music(ev.data.music, this.musicOpts());\n      game.ui.only({\n        name: 'intro',\n        back: opts.onLeave ? () => this.leave() : null,\n        build: (s) => {\n          const d = ev.data;\n          const tierName = TIER_NAMES[ev.tier];\n          const card = h('div.intro.tag',\n            h('div.diagram', { html: diagram(d.diagram) }),\n            h('div',\n              h('div.who', `${d.discipline} · ${SPEAKERS[d.instructor].name} · ${d.place}`),\n              h('h2', d.title),\n              h('p', d.line),\n              h('p', d.can),\n              h('p.cant', d.cant),\n              h('p.who', { 'data-tier': '1' }, `${tierName} · Marbles if you finish`)));\n          s.el.append(card);\n          const row = h('div.row', { style: 'margin-top:1.6rem' });\n          s.el.append(row);\n          const verbEl = h('div.row', { style: 'gap:1.6rem' });\n          row.append(verbEl);\n          const render = () => { verbEl.innerHTML = d.verbs.map(([v, t]) => promptHTML(v, t, game.input.lastDevice, game.save.settings.glyphs)).join(''); };\n          render();\n          s.def.update = null;\n          s.updateFn = () => { if (s.lastDev !== game.input.lastDevice) { s.lastDev = game.input.lastDevice; render(); } };\n          s.el.append(s.item(h('div', { style: 'margin-top:1.6rem' }, 'Begin'), { use: () => { go = true; } }));\n        },\n      });\n      yield () => go;\n      game.ui.clear();\n    }\n    this.stage = 'countdown';\n    game.hud.show(true);\n    ev.cameraShot(false);\n    if (ev.intro3d) yield* ev.intro3d();\n    if (!opts.skipCountdown) {\n      for (const n of ['3', '2', '1']) {\n        game.hud.flash(n, 0.7);\n        game.audio.sfx('metronome', { vel: 1 });\n        yield 0.7;\n      }\n      game.hud.flash('Begin', 0.6);\n      game.audio.sfx('bell');\n    }\n    this.stage = 'play';\n    ev.begin();\n    if (!ev.ownsMusic) game.audio.music(ev.data.music, this.musicOpts());\n    yield () => this.forceEnd || ev.isDone();\n    this.stage = 'whistle';\n    ev.phase = 'done';\n    game.audio.sfx('whistle');\n    game.hud.flash(ev.endWord || 'Time!', 1.2);\n    if (ev.outro3d) yield* ev.outro3d();\n    yield 1.2;\n    const results = ev.lanes.filter((l) => l.kind !== 'ghost').map((l) => ({ lane: l, ...ev.laneResult(l) }));\n    this.results = results;\n    this.stage = 'results';\n    game.hud.show(false);\n    if (opts.onResult) yield* opts.onResult(ev, results, this);\n  }\n  musicOpts() { return this.ev.musicOpts ? this.ev.musicOpts() : {}; }\n  /** Dev Mode: jump to Results. */\n  skip() { this.forceEnd = true; if (this.ev.phase !== 'play') this.ev.phase = 'play'; }\n  restart() {\n    const { game, opts } = this;\n    game.setMode(new EventRun(game, { ...opts }), 'event');\n  }\n  leave() {\n    const { opts } = this;\n    if (opts.onLeave) opts.onLeave();\n  }\n  exit() {\n    const { game, ev } = this;\n    if (this.handle) this.handle.cancel();\n    game.hud.show(false);\n    game.hud.reset();\n    game.speech.clear();\n    if (ev) { ev.dispose(); }\n    game.currentEvent = null;\n    game.ui.clear();\n  }\n  fixed(dt) { this.ev.fixed(dt); }\n  frame(dt) { this.ev.frame(dt); }\n}\nEOF\n","description":"Write director, programme rules, diagrams and event runner"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9233,"cache_read_input_tokens":292194,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9233},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"b863ace8-fefb-4d0c-8aaf-1b2870097db4","timestamp":"2026-11-05T12:16:40.261Z","request_id":"req_011CgjmAQz2S1DMzsJEgaa6E","wire_tool_inputs":{"toolu_01SHED4AYyU8jY6gFqabxQBr":{"command":"cat > src/game/director.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { Scripts, Handle } from '../core/script.js';\nimport { Loop } from '../core/loop.js';\nimport { Save } from '../core/save.js';\nimport { tun } from '../core/tuning.js';\nimport { TUNING } from '../data/tuning.js';\nimport { initPhysics, RAPIER } from '../physics/world.js';\nimport { IslandPhysics } from '../physics/island.js';\nimport { IslandArt } from '../art/island.js';\nimport { Input } from '../input/input.js';\nimport { AudioEngine } from '../audio/engine.js';\nimport { UI } from '../ui/ui.js';\nimport { Speech } from '../ui/speech.js';\nimport { HUD } from '../ui/hud.js';\nimport { h } from '../ui/dom.js';\nimport { makeInk } from '../render/ink.js';\nimport { Palette } from '../render/palette.js';\nimport { makeSky } from '../render/sky.js';\nimport { makeSea } from '../render/sea.js';\nimport { CameraRig } from '../render/cameraRig.js';\nimport { Particles } from '../render/particles.js';\nimport { ComicText } from '../render/comicText.js';\nimport { geo, toon } from '../art/materials.js';\nimport { line } from '../data/dialogue.js';\nimport { Programme } from './programme.js';\nimport { RESORT } from '../data/config.js';\nimport { fruitColours } from '../art/palettes.js';\n\nconst _m = new THREE.Matrix4(), _p = new THREE.Vector3(), _q = new THREE.Quaternion(), _s = new THREE.Vector3(1, 1, 1), _iq = new THREE.Quaternion();\n\n/** The whole game: engine parts, one current mode, and the sim-time scripts that drive the flow. */\nexport class Game {\n  constructor(params) {\n    this.params = params;\n    this.loop = new Loop(this);\n    this.scripts = new Scripts();\n    let storage = null;\n    try { storage = window.localStorage; } catch (e) { storage = null; }\n    this.save = new Save(storage);\n    this.errors = []; this.paused = false; this.mode = null; this.modeName = 'boot';\n    this.stopT = 0; this.wiping = false; this.simTime = 0; this.islandOn = true; this.renderLost = null;\n    this.devStep = 0; this.god = false; this.attract = false;\n    this.backend = 'none'; this.frames = 0;\n    this.touchOnly = false;\n    this.inSession = false;\n    this.programme = new Programme(this);\n  }\n  noteError(e) {\n    const msg = (e && e.message) || String(e);\n    if (this.errors.length < 30) this.errors.push(msg);\n  }\n  async bootEngine() {\n    await initPhysics();\n    this.scene = new THREE.Scene();\n    this.camera = new THREE.PerspectiveCamera(38, innerWidth / Math.max(1, innerHeight), 0.1, 1400);\n    this.rig = new CameraRig(this.camera);\n    this.rig.reduce = this.save.settings.reduceShake;\n    this.sun = new THREE.DirectionalLight(0xffffff, 3);\n    this.sun.castShadow = true;\n    this.sun.shadow.mapSize.set(2048, 2048);\n    this.sun.shadow.bias = -0.0006; this.sun.shadow.normalBias = 0.035;\n    const sc = this.sun.shadow.camera; sc.left = -34; sc.right = 34; sc.top = 34; sc.bottom = -34; sc.near = 1; sc.far = 220;\n    this.sun.position.set(38, 70, 42);\n    this.sunDir = new THREE.Vector3(38, 70, 42).normalize();\n    this.hemi = new THREE.HemisphereLight(0xffffff, 0x888888, 1.35);\n    this.scene.add(this.sun, this.sun.target, this.hemi);\n    this.palette = new Palette(this.sun, this.hemi);\n    this.sky = makeSky(this.palette);\n    this.sea = makeSea(this.palette);\n    this.scene.add(this.sky.group, this.sea.mesh);\n    this.fx = new Particles();\n    this.fx.addTo(this.scene);\n    this.comic = new ComicText(this.scene);\n    // Renderer\n    if (this.params.render) await this.startRenderer();\n    // Island\n    this.art = new IslandArt();\n    this.scene.add(this.art.holder);\n    this.phys = new IslandPhysics();\n    this.buildIslandProps();\n    this.art.buildMarbles();\n    // Input, audio, UI\n    this.input = new Input();\n    this.input.attach(window);\n    this.input.rumbleOn = this.save.settings.rumble;\n    this.audio = new AudioEngine(() => this.save.settings);\n    this.input.onGesture = () => this.audio.gesture();\n    const root = document.getElementById('ui');\n    this.hud = new HUD(this, root);\n    this.ui = new UI(this, root);\n    this.speech = new Speech(this, root);\n    this.audioTag = h('div.audio-tag.tag', 'Press a key or click for sound');\n    this.audioTag.style.display = 'none';\n    root.append(this.audioTag);\n    this.programme.syncIsland();\n    this.phys.snapTilt();\n    this.applySettings();\n    window.addEventListener('resize', () => this.resize());\n    this.resize();\n  }\n  async startRenderer() {\n    const canvasParent = document.body;\n    const renderer = new THREE.WebGPURenderer({ antialias: true });\n    this.renderer = renderer;\n    await renderer.init();\n    this.backend = renderer.backend && renderer.backend.isWebGPUBackend ? 'webgpu' : 'webgl2';\n    const dev = renderer.backend && renderer.backend.device;\n    if (dev && dev.lost) dev.lost.then((info) => { this.renderLost = info.message || 'lost'; });\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n    renderer.setSize(innerWidth, innerHeight);\n    renderer.toneMapping = THREE.NoToneMapping;\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFShadowMap;\n    canvasParent.prepend(renderer.domElement);\n    const ink = makeInk(renderer, this.scene, this.camera);\n    this.post = ink.post; this.inkU = ink.u;\n  }\n  resize() {\n    this.camera.aspect = innerWidth / Math.max(1, innerHeight);\n    this.camera.updateProjectionMatrix();\n    if (this.renderer) this.renderer.setSize(innerWidth, innerHeight);\n  }\n  applySettings() {\n    const s = this.save.settings;\n    this.audio.applyLevels();\n    document.documentElement.style.setProperty('--s', String(s.uiScale / 100));\n    this.input.rumbleOn = s.rumble;\n    this.rig.reduce = s.reduceShake;\n    this.inkStrength = s.ink / 100;\n    this.applyInk();\n  }\n  applyInk() {\n    if (!this.inkU) return;\n    const k = this.inkOff ? 0 : this.inkStrength;\n    this.inkU.hull.value = tun.hull * k; this.inkU.width.value = tun.lineWidth; this.inkU.boil.value = tun.boil; this.inkU.grain.value = tun.grain;\n    this.inkU.strength.value = k;\n  }\n  buildIslandProps() {\n    const oranges = this.phys.props.filter((p) => p.kind === 'orange');\n    const m = this.orangeMesh = new THREE.InstancedMesh(geo.sphere(0.14, 12, 10), toon(0xF08A3C), oranges.length);\n    m.castShadow = true; m.frustumCulled = false;\n    this.art.group.add(m);\n    this.propMeshes = [];\n    for (const p of this.phys.props) {\n      if (p.kind === 'orange') continue;\n      let mesh;\n      if (p.kind === 'ball') {\n        mesh = new THREE.Group();\n        const colours = [0xE8443A, 0xFFF3DC, 0x3B82F6];\n        for (let i = 0; i < 3; i++) { const s = new THREE.Mesh(geo.sphere(0.32, 14, 10), toon(colours[i])); s.scale.set(1 - i * 0.02, 1 - i * 0.02, i === 0 ? 1 : i === 1 ? 0.62 : 0.28); s.castShadow = i === 0; mesh.add(s); }\n      } else {\n        mesh = new THREE.Mesh(geo.box(0.6, 0.5, 0.6), toon(0xC99A62)); mesh.castShadow = true;\n      }\n      this.art.group.add(mesh);\n      this.propMeshes.push({ p, mesh });\n    }\n    this.oranges = oranges;\n  }\n  /** Step the island's physics. weight 0 when nobody stands on it. */\n  stepIsland(dt, weight = 1) { this.phys.step(dt, { weight }); }\n  /** Copy island physics to its art. */\n  syncIsland(dt) {\n    const ph = this.phys, art = this.art;\n    art.group.quaternion.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w);\n    _iq.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w).invert();\n    for (let i = 0; i < this.oranges.length; i++) {\n      const t = this.oranges[i].body.translation();\n      _p.set(t.x, t.y, t.z); _q.set(0, 0, 0, 1);\n      _m.compose(_p, _q, _s);\n      this.orangeMesh.setMatrixAt(i, _m);\n    }\n    this.orangeMesh.instanceMatrix.needsUpdate = true;\n    for (const { p, mesh } of this.propMeshes) {\n      const t = p.body.translation(), r = p.body.rotation();\n      mesh.position.set(t.x, t.y, t.z); mesh.quaternion.set(r.x, r.y, r.z, r.w);\n    }\n    art.updateCast(dt, _iq);\n    art.heron.root.quaternion.copy(_iq);\n    art.walrus.root.quaternion.copy(_iq).multiply(_q.setFromAxisAngle(_p.set(0, 1, 0), 0.5));\n    art.gary.root.quaternion.copy(_iq);\n    this.audio.setTilt(ph.restNow);\n    this.sea.setTilt(ph.tx, ph.tz);\n  }\n  /** Island in the foreground (hub), far away (scenery), or hidden. */\n  setIsland(mode, x = 0, z = 0) {\n    const h2 = this.art.holder;\n    this.islandMode = mode;\n    if (mode === 'home') {\n      h2.visible = true; h2.position.set(0, 0, 0); h2.scale.setScalar(1);\n      this.sea.setLevel(-6.4); this.sea.setFoam(0, 0, 26);\n      this.focus(0, 0, 0, 40);\n    } else if (mode === 'far') {\n      h2.visible = true; h2.position.set(x, 3, z);\n      this.sea.setFoam(x, z, 26);\n    } else h2.visible = false;\n  }\n  setBackdrop(x, z) { this.setIsland('far', x, z); }\n  /** Point the sun's shadow frustum at what matters. */\n  focus(x, y, z, size = 26) {\n    const c = this.sun.shadow.camera;\n    if (c.right !== size) { c.left = -size; c.right = size; c.top = size; c.bottom = -size; c.updateProjectionMatrix(); }\n    this.sun.target.position.set(x, y, z);\n    this.sun.position.set(x, y, z).addScaledVector(this.sunDir, 90);\n  }\n  line(who, sit, vars) { return line(who, sit, vars); }\n  /** Say a line and wait for Use. yield* game.say('trudy', 'morning'). */\n  *say(who, situation, vars) { yield* this.sayText(who, line(who, situation, vars)); }\n  *sayText(who, text) {\n    if (!text) return;\n    const l = this.speech.say(who, text);\n    yield () => l.done || this.speech.line !== l;\n  }\n  bark(who, situation, vars, auto = 3) { const t = line(who, situation, vars); if (t) this.speech.say(who, t, { auto }); }\n  hitStop(sec) { this.stopT = Math.max(this.stopT, sec); }\n  onFloorExercise() { const p = this.save.profile; if (p && !this.attract) { p.floorExercises++; } }\n  setMode(mode, name) {\n    if (this.mode && this.mode.exit) this.mode.exit();\n    this.mode = mode; this.modeName = name || (mode && mode.name) || 'none';\n    if (mode && mode.enter) mode.enter();\n  }\n  /** The ink-blot wipe, then fn, then the wipe back. */\n  *wipe(fn, dur = 0.32) {\n    if (this.inkU) this.inkU.wipe.value = 0;\n    this.wiping = true; this.ui.inert = true;\n    let t = 0;\n    while (t < dur) { t += 1 / 120; if (this.inkU) this.inkU.wipe.value = Math.min(1, t / dur); yield null; }\n    if (this.inkU) this.inkU.wipe.value = 1;\n    fn();\n    yield 0.04;\n    this.ui.inert = false;\n    t = 0;\n    while (t < dur) { t += 1 / 120; if (this.inkU) this.inkU.wipe.value = Math.max(0, 1 - t / dur); yield null; }\n    if (this.inkU) this.inkU.wipe.value = 0;\n    this.wiping = false;\n  }\n  go(fn) { return this.scripts.run(this.wipe(fn)); }\n  fixed(dt) {\n    try { this._fixed(dt); } catch (e) { this.fatal(e); }\n    this.input.endTick();\n  }\n  _fixed(dt) {\n    const input = this.input;\n    if (this.beforePoll) this.beforePoll(dt);\n    input.poll(dt);\n    this.speechInput();\n    this.ui.fixed(dt);\n    if (this.inSession === false && this.mode && this.mode.canPause && !this.paused && !this.wiping && input.verb('pause') && !this.speech.active) {\n      this.openPause();\n      return;\n    }\n    if (input.lostPads.length && this.mode && this.mode.canPause && !this.paused && this.modeUsesPad(input.lostPads)) {\n      this.openPause(`Controller ${input.lostPads[0] + 1} disconnected. Reconnect it, or carry on with another.`);\n      return;\n    }\n    if (this.paused && !this.devStep) { if (this.mode && this.mode.pausedFixed) this.mode.pausedFixed(dt); return; }\n    if (this.devStep) this.devStep--;\n    if (this.stopT > 0) { this.stopT -= dt; return; }\n    this.simTime += dt;\n    this.speech.fixed(dt);\n    this.scripts.tick(dt);\n    if (this.mode && this.mode.fixed) this.mode.fixed(dt);\n    if (this.afterFixed) this.afterFixed(dt);\n  }\n  modeUsesPad(list) {\n    const m = this.mode;\n    if (!m || !m.ev) return list.includes(this.input.activePad) && this.input.lastDevice === 'pad';\n    return m.ev.lanes.some((l) => l.kind === 'local' && (l.source === `pad:${list[0]}` || (l.source === 'any' && this.input.lastDevice === 'pad' && list.includes(this.input.activePad))));\n  }\n  speechInput() {\n    const l = this.speech.line;\n    if (!l || l.auto || this.paused) return;\n    const input = this.input;\n    const used = input.verb('confirm') || (input.btnEdge & 1);\n    if (used && !(this.ui.top && !this.ui.top.passive)) {\n      input.verbs.delete('confirm');\n      input.pressedUse = true;\n      this.speech.advance();\n    }\n  }\n  frame(dt) {\n    try { this._frame(dt); } catch (e) { this.fatal(e); }\n  }\n  _frame(dt) {\n    this.ui.frame(dt);\n    this.hud.frame(dt);\n    const sim = this.paused ? 0 : dt;\n    if (!this.paused) {\n      if (this.mode && this.mode.frame) this.mode.frame(sim);\n      this.fx.frame(sim);\n      this.comic.frame(sim);\n      this.sky.frame(sim);\n    }\n    this.palette.frame(dt);\n    this.rig.frame(sim || 0.0001);\n    if (this.devFrame) this.devFrame(dt);\n    const stuck = this.audio.stuck();\n    if (this.audioTag.dataset.on !== String(stuck)) { this.audioTag.dataset.on = String(stuck); this.audioTag.style.display = stuck ? '' : 'none'; }\n  }\n  async render() {\n    if (!this.renderer || !this.post || this.paused2) return;\n    await this.post.renderAsync();\n    this.frames++;\n  }\n  /** Rapier's panic kills physics for the page. Save and reload; in a session, tell the hub. */\n  fatal(e) {\n    this.noteError(e);\n    const msg = (e && e.message) || String(e);\n    if (this._fatal) return;\n    if (/unreachable|recursive|memory access/i.test(msg)) {\n      this._fatal = true;\n      if (window.AIHub && window.AIHub.active) { window.AIHub.fail(`Physics stopped: ${msg}`); return; }\n      this.save.write();\n      if (!this.params.test) location.reload();\n    }\n  }\n  openPause(note) { import_pause(this, note); }\n}\nlet import_pause = () => {};\nexport function setPauseOpener(f) { import_pause = f; }\nexport { Handle, RAPIER, RESORT, TUNING, fruitColours };\nEOF\ncat > src/art/palettes.js <<'EOF'\nexport const fruitColours = [0xF08A3C, 0xD9483B, 0xF5D547, 0x86C24A];\nEOF\ncat > src/game/programme.js <<'EOF'\nimport { DAYS, MAINTENANCE, HANDICAP, wobbleAge, restTilt, marblesFor, CHECKIN_MARBLES } from '../data/programme.js';\nimport { hasEvent } from '../events/index.js';\nimport { EVENTS, TIER_NAMES } from '../data/events.js';\nimport { medalFor } from '../data/config.js';\nimport { UNLOCKS, HATS, STARTER_PAINTS, LATE_PAINTS } from '../data/unlocks.js';\nimport { rng } from '../core/rng.js';\nimport { tun } from '../core/tuning.js';\nimport { newProfile } from '../core/save.js';\n\n/** Days, classes, medals, marbles and how crooked the island is. Plain rules, no scenes. */\nexport class Programme {\n  constructor(game) { this.game = game; }\n  get profile() { return this.game.save.profile; }\n  dayDef(day) {\n    if (day <= DAYS.length) {\n      const d = DAYS[day - 1];\n      return { ...d, classes: d.classes.filter(hasEvent) };\n    }\n    return { day, name: MAINTENANCE.name, tests: 'random', classes: null, maintenance: true };\n  }\n  get totalSteps() {\n    let n = 0;\n    for (const d of DAYS) n += d.classes.filter(hasEvent).length;\n    return Math.max(1, n);\n  }\n  /** Today's classes. Maintenance days get three random ones from Trudy, fixed once dealt. */\n  classesToday() {\n    const p = this.profile;\n    if (!p) return [];\n    const def = this.dayDef(p.today.day);\n    if (def.classes) return def.classes;\n    if (!p.today.plan) {\n      const r = rng(`maintenance-${p.today.day}`);\n      const pool = Object.keys(EVENTS).filter((id) => hasEvent(id) && id !== 'grandHold');\n      const out = [];\n      while (out.length < MAINTENANCE.classes && pool.length) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n      p.today.plan = out;\n    }\n    return p.today.plan;\n  }\n  /** Tests today: fixed list, your three best, or a random three. */\n  testsToday() {\n    const p = this.profile;\n    const def = this.dayDef(p.today.day);\n    if (Array.isArray(def.tests)) return def.tests;\n    const all = ['standStill', 'leanMatch', 'stepTime', 'quickLean', 'oneFoot'];\n    if (def.tests === 'best') {\n      const best = p.testBest || {};\n      return all.slice().sort((a, b) => (best[b] ?? 0) - (best[a] ?? 0)).slice(0, 3);\n    }\n    const r = rng(`tests-${p.today.day}`);\n    const pool = all.slice(), out = [];\n    while (out.length < 3) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n    return out;\n  }\n  handicap(day) { return day <= HANDICAP.length ? HANDICAP[day - 1] : 0; }\n  ageFor(mean, day) { return wobbleAge(mean, this.handicap(day)); }\n  stepsDone() { const p = this.profile; return p ? Math.min(p.stepsDone, this.totalSteps) : 0; }\n  restDeg() {\n    const p = this.profile;\n    if (!p) return tun.islandRest;\n    return p.levelled ? 0 : restTilt(p.stepsDone, this.totalSteps, tun.islandRest);\n  }\n  syncIsland() { if (this.game.phys) this.game.phys.setRest(this.restDeg()); }\n  /** Tier used in the programme: Tier 1 for Days 1-5, the highest open on Maintenance days. */\n  programmeTier(id) {\n    const p = this.profile;\n    if (p.today.day <= DAYS.length) return 0;\n    return this.highestTier(id);\n  }\n  highestTier(id) { const p = this.profile; return p ? Math.max(0, Math.min(EVENTS[id].tiers.length - 1, p.tiers[id] ?? 0)) : 0; }\n  tierOpen(id, t) { return t <= this.highestTier(id); }\n  seen(id) { const p = this.profile; return !!(p && (p.seen[id] || p.levelled)); }\n  freePlayList() { return Object.keys(EVENTS).filter((id) => hasEvent(id) && this.seen(id)); }\n  medalOf(id, tier) { const p = this.profile; return p && p.medals[`${id}:${tier}`]; }\n  planLeft() {\n    const p = this.profile;\n    return this.classesToday().filter((id) => !p.today.done.includes(id));\n  }\n  nextClass() { return this.planLeft()[0] || null; }\n  /**\n   * Record a finished class. Returns what changed: marbles, medal, first clear, unlocks, notch.\n   * programme: this class counted toward today's plan.\n   */\n  record(id, tier, form, activeSec, programme) {\n    const p = this.profile;\n    const scaled = form / tun.medalScale;\n    const m = medalFor(scaled);\n    const key = `${id}:${tier}`;\n    const prev = p.medals[key];\n    const firstClear = !prev;\n    if (!prev || prev.form < scaled) p.medals[key] = { form: Math.round(scaled), medal: m.id };\n    const out = { medal: m, firstClear, marbles: 0, notch: false, tierOpened: null, unlocks: [] };\n    p.seen[id] = true;\n    p.classes++;\n    p.minutes += activeSec / 60;\n    if (tier === 0 && scaled >= 65 && (p.tiers[id] ?? 0) < 1 && EVENTS[id].tiers.length > 1) { p.tiers[id] = 1; out.tierOpened = 1; }\n    if (tier === 1 && scaled >= 85 && (p.tiers[id] ?? 0) < 2 && EVENTS[id].tiers.length > 2) { p.tiers[id] = 2; out.tierOpened = 2; }\n    if (programme && !p.today.done.includes(id) && this.classesToday().includes(id)) {\n      p.today.done.push(id);\n      if (p.today.day <= DAYS.length) { p.stepsDone++; out.notch = true; }\n    }\n    out.marbles = marblesFor(activeSec / 60, m.bonus, firstClear, tun.marblesPerMinute);\n    this.addMarbles(out.marbles, m.id, out);\n    this.syncIsland();\n    this.game.save.write();\n    return out;\n  }\n  addMarbles(n, medalId, out = {}) {\n    const p = this.profile;\n    const before = p.marbles;\n    p.marbles += n;\n    p.marbleLog = p.marbleLog || [];\n    for (let i = 0; i < n; i++) p.marbleLog.push(medalId);\n    if (p.marbleLog.length > 320) p.marbleLog.splice(0, p.marbleLog.length - 320);\n    out.unlocks = out.unlocks || [];\n    for (const u of UNLOCKS) if (before < u.at && p.marbles >= u.at) out.unlocks.push(u);\n    return out;\n  }\n  hatsOpen() { const p = this.profile; return HATS.filter((x) => (p ? p.marbles >= x.at : x.at === 0) || (p && p.allUnlocked)); }\n  paintsOpen() {\n    const p = this.profile;\n    const open = STARTER_PAINTS.slice();\n    for (const l of LATE_PAINTS) if (p && (p.marbles >= l.at || p.allUnlocked)) open.push(l.id);\n    return open;\n  }\n  checkinDone(age, scores) {\n    const p = this.profile;\n    p.today.checkin = true; p.today.age = age;\n    p.ages.push({ day: p.today.day, age });\n    p.testBest = p.testBest || {};\n    for (const k of Object.keys(scores)) p.testBest[k] = Math.max(p.testBest[k] ?? 0, scores[k]);\n    const out = this.addMarbles(CHECKIN_MARBLES, 'attended');\n    this.game.save.write();\n    return out;\n  }\n  /** Bed: stamp the day and turn to the next. */\n  nextDay() {\n    const p = this.profile;\n    p.stamps.push({ day: p.today.day, at: Date.now() });\n    p.day = p.today.day + 1;\n    p.today = { day: p.day, checkin: false, age: null, done: [], question: false };\n    p.lastSeen = Date.now();\n    this.game.save.write();\n  }\n  createProfile(slot, name, paint) {\n    const d = this.game.save.data;\n    d.profiles[slot] = newProfile(name, paint);\n    d.activeProfile = slot;\n    this.game.save.write();\n    this.syncIsland();\n  }\n  selectProfile(slot) { this.game.save.data.activeProfile = slot; this.game.save.write(); this.syncIsland(); }\n  tierName(t) { return TIER_NAMES[t] || ''; }\n}\nEOF\ncat > src/ui/diagrams.js <<'EOF'\n// One small diagram per event, drawn in code. Ink on paper, like a wall chart.\nconst I = '#1A1420';\nconst svg = (inner) => `<svg viewBox=\"0 0 320 200\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"${I}\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${inner}</svg>`;\nconst peg = (x, y, r = 0, c = '#2CB5A0') => `<g transform=\"translate(${x},${y}) rotate(${r})\"><circle cx=\"0\" cy=\"-64\" r=\"17\" fill=\"#F2D3A8\"/><rect x=\"-16\" y=\"-48\" width=\"32\" height=\"42\" rx=\"13\" fill=\"${c}\"/><path d=\"M-7 -6V18M7 -6V18\"/></g>`;\nconst dialog = (cx, cy, r, dx, dy) => `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"#FFF4DC\"/><circle cx=\"${cx + dx}\" cy=\"${cy + dy}\" r=\"${r * 0.3}\" fill=\"#9BE08F\" stroke=\"#2F8F46\"/><circle cx=\"${cx + dx}\" cy=\"${cy + dy}\" r=\"${r * 0.12}\" fill=\"${I}\"/>`;\nexport const DIAGRAMS = {\n  ring: svg(`${peg(90, 150, 10)}${dialog(220, 95, 66, -18, 8)}<path d=\"M120 80l40 8\" stroke-dasharray=\"7 9\"/>`),\n  stack: svg(`${peg(160, 180)}<rect x=\"110\" y=\"94\" width=\"100\" height=\"10\" rx=\"4\" fill=\"#D8D3C4\"/><rect x=\"128\" y=\"74\" width=\"64\" height=\"20\" rx=\"7\" fill=\"#D8D3C4\"/><rect x=\"134\" y=\"56\" width=\"52\" height=\"18\" rx=\"7\" fill=\"#D8D3C4\"/><rect x=\"141\" y=\"40\" width=\"38\" height=\"16\" rx=\"7\" fill=\"#D8D3C4\"/><path d=\"M160 6v22M152 20l8 8 8-8\"/>`),\n  calm: svg(`<ellipse cx=\"160\" cy=\"165\" rx=\"130\" ry=\"26\" fill=\"#5AC0C4\"/><ellipse cx=\"160\" cy=\"150\" rx=\"58\" ry=\"13\" fill=\"#79C26A\"/>${peg(160, 130, 0)}<ellipse cx=\"160\" cy=\"165\" rx=\"86\" ry=\"17\" stroke-dasharray=\"6 9\"/><path d=\"M238 56c8-8 18-8 26 0M222 80c8-8 18-8 26 0\"/>`),\n  squat: svg(`<g transform=\"translate(160,170)\"><rect x=\"-120\" y=\"-96\" width=\"240\" height=\"18\" rx=\"9\" fill=\"#9A6E3E\"/><circle cx=\"0\" cy=\"-116\" r=\"17\" fill=\"#F2D3A8\"/><rect x=\"-18\" y=\"-90\" width=\"36\" height=\"42\" rx=\"13\" fill=\"#2CB5A0\"/><path d=\"M-12 -46l-22 26 14 22M12 -46l22 26-14 22\"/></g><path d=\"M288 44v96M278 128l10 12 10-12M278 56l10-12 10 12\"/>`),\n  plank: svg(`<rect x=\"44\" y=\"140\" width=\"232\" height=\"14\" rx=\"6\" fill=\"#C99A62\"/><rect x=\"66\" y=\"108\" width=\"150\" height=\"28\" rx=\"13\" fill=\"#2CB5A0\"/><circle cx=\"238\" cy=\"112\" r=\"17\" fill=\"#F2D3A8\"/><path d=\"M120 66c10-12 26-12 36 0M170 44c10-12 26-12 36 0\"/><path d=\"M138 66v28M188 44v50\" stroke-dasharray=\"6 8\"/>`),\n  tug: svg(`${peg(60, 170, -16)}${peg(260, 170, 16, '#E8644A')}<path d=\"M80 110Q160 122 240 110\" stroke-width=\"7\" stroke=\"#9A6E3E\"/><path d=\"M160 96v42\"/><path d=\"M26 40l-16 12 16 12M10 52h38\"/>`),\n  steps: svg(`<path d=\"M50 190L130 40M270 190L190 40\" stroke-dasharray=\"6 9\"/><ellipse cx=\"108\" cy=\"150\" rx=\"22\" ry=\"12\" fill=\"#7FB4E8\"/><ellipse cx=\"212\" cy=\"150\" rx=\"22\" ry=\"12\" fill=\"#E8707A\"/><ellipse cx=\"128\" cy=\"84\" rx=\"14\" ry=\"8\" fill=\"#7FB4E8\"/><ellipse cx=\"192\" cy=\"60\" rx=\"11\" ry=\"6\" fill=\"#E8707A\"/>`),\n  plates: svg(`${peg(160, 170)}<ellipse cx=\"160\" cy=\"130\" rx=\"60\" ry=\"16\" stroke=\"#D9483B\"/><path d=\"M60 170V70M260 170V70\"/><ellipse cx=\"60\" cy=\"66\" rx=\"34\" ry=\"9\" fill=\"#2CB5A0\"/><ellipse cx=\"260\" cy=\"66\" rx=\"24\" ry=\"7\" fill=\"#F08A3C\"/><path d=\"M122 54c24-20 52-20 76 0M198 54l-2-14M198 54l-14 2\"/>`),\n  loop: svg(`<ellipse cx=\"160\" cy=\"105\" rx=\"130\" ry=\"72\" fill=\"#F6E2B3\"/><ellipse cx=\"160\" cy=\"105\" rx=\"90\" ry=\"44\" fill=\"#8CCB6A\"/><path d=\"M34 105c8-30 38-48 64-58M98 47l-16 0M98 47l-10 14\"/>${peg(40, 130)}<circle cx=\"110\" cy=\"44\" r=\"8\" fill=\"#FFF4DC\"/>`),\n  hat: svg(`${peg(150, 186)}<ellipse cx=\"150\" cy=\"94\" rx=\"58\" ry=\"12\" fill=\"#C99A62\"/><path d=\"M92 94l10 22h96l10-22\"/><circle cx=\"130\" cy=\"84\" r=\"12\" fill=\"#F08A3C\"/><circle cx=\"160\" cy=\"80\" r=\"12\" fill=\"#D9483B\"/><path d=\"M270 30Q230 20 190 50\" stroke-dasharray=\"6 9\"/><circle cx=\"182\" cy=\"56\" r=\"11\" fill=\"#F5D547\"/><rect x=\"232\" y=\"150\" width=\"56\" height=\"40\" fill=\"#C99A62\"/>`),\n  tray: svg(`${peg(100, 180)}<rect x=\"124\" y=\"82\" width=\"110\" height=\"9\" rx=\"4\" fill=\"#C99A62\"/><path d=\"M140 82V58h14v24M172 82V58h14v24M204 82V58h14v24\"/><path d=\"M26 40h60M16 62h44M34 84h34\"/><path d=\"M256 180h50\" stroke-dasharray=\"6 8\"/>`),\n  dive: svg(`<rect x=\"34\" y=\"96\" width=\"60\" height=\"96\" fill=\"#D9483B\"/><path d=\"M94 96h78\"/><path d=\"M186 92c30-40 66-14 80 36\" stroke-dasharray=\"6 9\"/><circle cx=\"218\" cy=\"60\" r=\"15\" fill=\"#F2D3A8\"/><rect x=\"222\" y=\"74\" width=\"20\" height=\"40\" rx=\"10\" fill=\"#2CB5A0\" transform=\"rotate(-30 232 94)\"/><path d=\"M0 176c50 0 90 4 320 0\" stroke=\"#3B82F6\" stroke-width=\"7\"/>`),\n  raft: svg(`<ellipse cx=\"160\" cy=\"156\" rx=\"132\" ry=\"26\" fill=\"#C99A62\"/>${peg(102, 150, 8)}${peg(160, 140, -6, '#E8644A')}${peg(222, 152, 10, '#F5B700')}<path d=\"M6 186c26-10 52-10 78 0s52 10 78 0 52-10 78 0 52 10 74 0\" stroke=\"#3B82F6\"/>`),\n  hold: svg(`<path d=\"M138 186l10-120h24l10 120z\" fill=\"#FFF3DC\"/><path d=\"M142 150h36M146 110h28\" stroke=\"#D9483B\" stroke-width=\"9\"/><rect x=\"132\" y=\"58\" width=\"56\" height=\"9\" fill=\"#FFF3DC\"/>${peg(160, 56, 6)}<path d=\"M20 186h280\"/>`),\n  test: svg(`${peg(100, 170)}${dialog(226, 100, 62, 0, 0)}`),\n};\nexport const diagram = (name) => DIAGRAMS[name] || DIAGRAMS.test;\nEOF\ncat > src/game/eventRun.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { EVENT_CLASSES } from '../events/index.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { diagram } from '../ui/diagrams.js';\nimport { TIER_NAMES } from '../data/events.js';\nimport { line } from '../data/dialogue.js';\nimport { showResults } from './results.js';\nimport { SPEAKERS } from '../ui/speech.js';\n\n/**\n * Runs one event: Intro Card → instructor counts 3-2-1 → play → whistle → results.\n * opts: { id, tier, lanes, mode, config, onResult(ev, results) -> handled, onLeave, skipIntro, god, retry, seed }\n */\nexport class EventRun {\n  constructor(game, opts) {\n    this.game = game; this.opts = opts; this.name = 'event'; this.canPause = opts.mode !== 'attract' && opts.mode !== 'session';\n    this.ev = null; this.handle = null; this.stage = 'intro';\n  }\n  enter() {\n    const { game, opts } = this;\n    const Cls = EVENT_CLASSES[opts.id];\n    game.setIsland('hidden');\n    game.fx.clear(); game.comic.clear(); game.speech.clear();\n    this.ev = new Cls({ game, tier: opts.tier || 0, lanes: opts.lanes, mode: opts.mode || 'solo', config: opts.config, god: opts.god || game.god });\n    game.currentEvent = this.ev;\n    this.ev.build();\n    game.sea.setLevel(this.ev.seaLevel);\n    game.palette.set(this.ev.data.palette || opts.palette || game.programmePalette(), 1.5);\n    game.focus(0, 0, 0, Math.max(14, 8 + this.ev.lanes.length * 3));\n    this.ev.cameraShot(true);\n    game.ui.clear();\n    const hud = game.hud;\n    hud.reset();\n    if (this.ev.discs) hud.setDiscs(this.ev.lanes.filter((l) => l.kind !== 'bot' || opts.mode === 'attract').filter((l) => l.kind !== 'ghost'), this.ev.lanes.length > 1 && opts.mode !== 'session');\n    hud.setPrompts(this.ev.data.verbs);\n    this.ev.hudSetup(hud);\n    if (opts.afterBuild) opts.afterBuild(this.ev);\n    this.handle = game.scripts.run(this.flow());\n  }\n  *flow() {\n    const { game, ev, opts } = this;\n    if (!opts.skipIntro) {\n      game.hud.show(false);\n      this.stage = 'intro';\n      let go = false;\n      game.audio.music(ev.data.music, this.musicOpts());\n      game.ui.only({\n        name: 'intro',\n        back: opts.onLeave ? () => this.leave() : null,\n        build: (s) => {\n          const d = ev.data;\n          const tierName = TIER_NAMES[ev.tier];\n          const card = h('div.intro.tag',\n            h('div.diagram', { html: diagram(d.diagram) }),\n            h('div',\n              h('div.who', `${d.discipline} · ${SPEAKERS[d.instructor].name} · ${d.place}`),\n              h('h2', d.title),\n              h('p', d.line),\n              h('p', d.can),\n              h('p.cant', d.cant),\n              h('p.who', { 'data-tier': '1' }, `${tierName} · Marbles if you finish`)));\n          s.el.append(card);\n          const row = h('div.row', { style: 'margin-top:1.6rem' });\n          s.el.append(row);\n          const verbEl = h('div.row', { style: 'gap:1.6rem' });\n          row.append(verbEl);\n          const render = () => { verbEl.innerHTML = d.verbs.map(([v, t]) => promptHTML(v, t, game.input.lastDevice, game.save.settings.glyphs)).join(''); };\n          render();\n          s.def.update = null;\n          s.updateFn = () => { if (s.lastDev !== game.input.lastDevice) { s.lastDev = game.input.lastDevice; render(); } };\n          s.el.append(s.item(h('div', { style: 'margin-top:1.6rem' }, 'Begin'), { use: () => { go = true; } }));\n        },\n      });\n      yield () => go;\n      game.ui.clear();\n    }\n    this.stage = 'countdown';\n    game.hud.show(true);\n    ev.cameraShot(false);\n    if (ev.intro3d) yield* ev.intro3d();\n    if (!opts.skipCountdown) {\n      for (const n of ['3', '2', '1']) {\n        game.hud.flash(n, 0.7);\n        game.audio.sfx('metronome', { vel: 1 });\n        yield 0.7;\n      }\n      game.hud.flash('Begin', 0.6);\n      game.audio.sfx('bell');\n    }\n    this.stage = 'play';\n    ev.begin();\n    if (!ev.ownsMusic) game.audio.music(ev.data.music, this.musicOpts());\n    yield () => this.forceEnd || ev.isDone();\n    this.stage = 'whistle';\n    ev.phase = 'done';\n    game.audio.sfx('whistle');\n    game.hud.flash(ev.endWord || 'Time!', 1.2);\n    if (ev.outro3d) yield* ev.outro3d();\n    yield 1.2;\n    const results = ev.lanes.filter((l) => l.kind !== 'ghost').map((l) => ({ lane: l, ...ev.laneResult(l) }));\n    this.results = results;\n    this.stage = 'results';\n    game.hud.show(false);\n    if (opts.onResult) yield* opts.onResult(ev, results, this);\n  }\n  musicOpts() { return this.ev.musicOpts ? this.ev.musicOpts() : {}; }\n  /** Dev Mode: jump to Results. */\n  skip() { this.forceEnd = true; if (this.ev.phase !== 'play') this.ev.phase = 'play'; }\n  restart() {\n    const { game, opts } = this;\n    game.setMode(new EventRun(game, { ...opts }), 'event');\n  }\n  leave() {\n    const { opts } = this;\n    if (opts.onLeave) opts.onLeave();\n  }\n  exit() {\n    const { game, ev } = this;\n    if (this.handle) this.handle.cancel();\n    game.hud.show(false);\n    game.hud.reset();\n    game.speech.clear();\n    if (ev) { ev.dispose(); }\n    game.currentEvent = null;\n    game.ui.clear();\n  }\n  fixed(dt) { this.ev.fixed(dt); }\n  frame(dt) { this.ev.frame(dt); }\n}\nEOF\n","description":"Write director, programme rules, diagrams and event runner"}}}
