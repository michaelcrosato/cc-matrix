{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjkpfUbAfRbZamDncFYt","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15567,"cache_read_input_tokens":253852,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15567},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"3b1a76cb-9e84-4d2f-96d3-cc45388b33d8","timestamp":"2026-11-05T12:10:37.551Z","request_id":"req_011CgjkpfAjeZ9TAv1Pssv4E","thinking_duration_ms":66507,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjkpfUbAfRbZamDncFYt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B8uwhysTWp8UvUXb3CUXsA","name":"Bash","input":{"command":"cat > src/art/props.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { M, G, geo, toon, add, basic, glass } from './materials.js';\nimport { cos } from '../core/rng.js';\n\nexport const WOOD = 0xC99A62, WOOD_D = 0x9A6E3E, TEAK = 0xB5763C, TEAL = 0x2CB5A0, ORANGE = 0xF08A3C, CREAM = 0xFFF3DC, RED = 0xD9483B, BLUE = 0x3B6FB6, STONE = 0xD8D3C4, STONE_D = 0xB7B1A0, GRASS = 0x8CCB6A, SAND = 0xF6E2B3, ROCK = 0x8A7B6C, LEAF = 0x5FAE5A, LEAF2 = 0x79C26A;\n\n/** A plank deck: rows of slightly different boards. Top surface at y = 0 (plus top). */\nexport function planks(w, d, { thick = 0.14, colour = WOOD, along = 'x', top = 0, board = 0.5 } = {}) {\n  const g = G();\n  const n = Math.max(1, Math.round((along === 'x' ? d : w) / board));\n  const size = (along === 'x' ? d : w) / n;\n  const shades = [colour, new THREE.Color(colour).multiplyScalar(0.94).getHex(), new THREE.Color(colour).multiplyScalar(1.05).getHex()];\n  for (let i = 0; i < n; i++) {\n    const off = (i + 0.5) * size - (along === 'x' ? d : w) / 2;\n    const col = shades[i % 3];\n    const m = along === 'x'\n      ? M(geo.box(w, thick, size - 0.02), col, 0, top - thick / 2, off)\n      : M(geo.box(size - 0.02, thick, d), col, off, top - thick / 2, 0);\n    g.add(m);\n  }\n  return g;\n}\nexport const post = (h, r = 0.1, colour = WOOD_D, x = 0, y = 0, z = 0) => M(geo.cyl(r, r, h, 12), colour, x, y + h / 2, z);\nexport function crate(s = 0.8, colour = WOOD) {\n  const g = G();\n  add(g, M(geo.box(s, s * 0.7, s), colour, 0, s * 0.35, 0));\n  for (const y of [0.03, 0.67]) add(g, M(geo.box(s * 1.04, s * 0.06, s * 1.04), WOOD_D, 0, s * y, 0));\n  return g;\n}\nexport function tree(h = 2.4, r = 1, leaf = LEAF) {\n  const g = G();\n  add(g, M(geo.cyl(0.13, 0.18, h, 12), WOOD_D, 0, h / 2, 0), M(geo.sphere(r, 18, 14), leaf, 0, h + r * 0.55, 0));\n  return g;\n}\nexport function palm(h = 3.2) {\n  const g = G();\n  let y = 0, x = 0;\n  for (let i = 0; i < 6; i++) { const r = 0.14 - i * 0.012; g.add(M(geo.cyl(r, r + 0.012, h / 6 + 0.03, 10), i % 2 ? WOOD : WOOD_D, x, y + h / 12, 0, { rot: [0, 0, -0.06 * i] })); y += h / 6; x += 0.06 * i; }\n  for (let i = 0; i < 6; i++) {\n    const a = (i / 6) * Math.PI * 2;\n    g.add(M(geo.sphere(0.7, 10, 8), LEAF, x + Math.cos(a) * 0.62, y - 0.08, Math.sin(a) * 0.62, { scale: [1, 0.09, 0.35], rot: [0, -a, Math.cos(a) * -0.3] }));\n  }\n  return g;\n}\nexport function buoy(colour = RED) {\n  const g = G();\n  add(g, M(geo.sphere(0.3, 14, 10), colour, 0, 0, 0, { scale: [1, 0.8, 1] }), M(geo.cyl(0.05, 0.05, 0.5, 8), CREAM, 0, 0.4, 0), M(geo.sphere(0.09, 10, 8), colour, 0, 0.68, 0));\n  return g;\n}\nexport function barge() {\n  const g = G();\n  add(g,\n    M(geo.rbox(7, 1.3, 3, 0.25), 0x6B4A2E, 0, 0.3, 0), M(geo.box(6.4, 0.12, 2.5), WOOD, 0, 1, 0),\n    M(geo.box(1.8, 1.2, 1.6), CREAM, -2, 1.6, 0), M(geo.box(2.1, 0.14, 1.9), ORANGE, -2, 2.26, 0),\n    M(geo.cyl(0.3, 0.42, 1.8, 14), RED, 1.5, 1.9, 0, { rot: [0.5, 0, -0.45] }), M(geo.tor(0.31, 0.06), CREAM, 1.92, 2.7, 0.42, { rot: [1.05, 0.45, 0] }),\n    M(geo.cyl(0.14, 0.14, 1.4, 10), 0x333344, -2.5, 3, 0));\n  return g;\n}\nexport const rope = (ax, ay, az, bx, by, bz, sag = 0.4, r = 0.03, colour = 0xE9D7A8) => {\n  const a = new THREE.Vector3(ax, ay, az), b = new THREE.Vector3(bx, by, bz);\n  const mid = a.clone().lerp(b, 0.5); mid.y -= sag;\n  const curve = new THREE.QuadraticBezierCurve3(a, mid, b);\n  const m = new THREE.Mesh(new THREE.TubeGeometry(curve, 12, r, 6, false), toon(colour));\n  m.castShadow = false;\n  return m;\n};\n/** A line of little flags between two points. */\nexport function bunting(ax, ay, az, bx, by, bz, n = 10, colours = [RED, 0xF5B700, TEAL, CREAM]) {\n  const g = G();\n  g.add(rope(ax, ay, az, bx, by, bz, 0.5, 0.018, CREAM));\n  const a = new THREE.Vector3(ax, ay, az), b = new THREE.Vector3(bx, by, bz);\n  const yaw = Math.atan2(b.x - a.x, b.z - a.z) + Math.PI / 2;\n  for (let i = 1; i < n; i++) {\n    const k = i / n;\n    const p = a.clone().lerp(b, k); p.y -= 0.5 * 4 * k * (1 - k) * 0.5 * 2 / 2 + 0.11;\n    const flag = M(geo.cone(0.11, 0.24, 3), colours[i % colours.length], p.x, p.y, p.z, { rot: [Math.PI, yaw, 0], scale: [1, 1, 0.25], shadow: false });\n    g.add(flag);\n  }\n  return g;\n}\nexport function pavilionRoof(r, colour = TEAL, trim = ORANGE) {\n  const g = G();\n  add(g, M(geo.cone(r, r * 0.55, 8), colour, 0, r * 0.275, 0), M(geo.cyl(r * 1.02, r * 1.02, 0.14, 8), trim, 0, 0, 0), M(geo.sphere(0.14, 10, 8), trim, 0, r * 0.58, 0));\n  return g;\n}\nexport function bigRock(s = 1, colour = STONE) { return M(geo.sphere(s, 8, 6), colour, 0, 0, 0, { scale: [1, 0.7, 0.9] }); }\nexport function umbrella(colour = RED) {\n  const g = G();\n  add(g, M(geo.cyl(0.04, 0.04, 2.3, 8), CREAM, 0, 1.15, 0), M(geo.cone(1.2, 0.5, 8), colour, 0, 2.4, 0));\n  return g;\n}\nexport function jarMesh() {\n  const g = G();\n  const pts = [[0.01, 0], [1, 0.02], [1.08, 0.12], [1.08, 1.9], [0.86, 2.2], [0.86, 2.45], [0.95, 2.5]].map(([x, y]) => new THREE.Vector2(x, y));\n  const lathe = new THREE.LatheGeometry(pts, 48);\n  const glassMesh = new THREE.Mesh(lathe, glass(0.16));\n  glassMesh.renderOrder = 8;\n  g.add(glassMesh);\n  for (const [r, y] of [[1.08, 0.12], [1.08, 1.9], [0.86, 2.2], [0.95, 2.5]]) g.add(M(geo.tor(r, 0.018, Math.PI * 2, 56), 0x7FB9C4, 0, y, 0, { rot: [Math.PI / 2, 0, 0], shadow: false }));\n  const strip = basic(0xffffff, { transparent: true, opacity: 0.7 });\n  const s1 = new THREE.Mesh(geo.box(0.05, 1.3, 0.01), strip); s1.position.set(0.72, 1.05, 0.78); s1.rotation.y = 0.75;\n  const s2 = new THREE.Mesh(geo.box(0.03, 0.8, 0.01), strip); s2.position.set(0.86, 1.2, 0.62); s2.rotation.y = 0.95;\n  add(g, s1, s2);\n  return g;\n}\n/** Sign with painted text. */\nexport function signBoard(text, w = 2.4, h = 0.9, bg = '#C78B4A', fg = '#FFF4DC') {\n  const c = document.createElement('canvas');\n  c.width = 512; c.height = Math.round((512 * h) / w);\n  const g = c.getContext('2d');\n  if (g) {\n    g.fillStyle = bg; g.fillRect(0, 0, c.width, c.height);\n    g.strokeStyle = '#1A1420'; g.lineWidth = 14; g.strokeRect(0, 0, c.width, c.height);\n    g.fillStyle = fg; g.textAlign = 'center'; g.textBaseline = 'middle';\n    let size = 96;\n    do { g.font = `700 ${size}px Fredoka, sans-serif`; size -= 4; } while (g.measureText(text).width > c.width - 40 && size > 20);\n    g.fillText(text, c.width / 2, c.height / 2 + 4);\n  }\n  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace;\n  const mat = new THREE.MeshBasicNodeMaterial({ map: t });\n  const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), mat);\n  return m;\n}\nEOF\ncat > src/art/island.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { M, G, geo, toon, add, basic, makeOutline } from './materials.js';\nimport { Doll, PAINTS } from './doll.js';\nimport { Trudy, Heron, Walrus, Gull } from './cast.js';\nimport { cos, cosPick } from '../core/rng.js';\nimport {\n  planks, post, crate, tree, palm, buoy, bunting, pavilionRoof, bigRock, umbrella, jarMesh, signBoard, rope,\n  WOOD, WOOD_D, TEAK, TEAL, ORANGE, CREAM, RED, BLUE, STONE, STONE_D, GRASS, SAND, ROCK, LEAF, LEAF2,\n} from './props.js';\n\n// Fixed spots on the island, in island-local x, z.\nexport const MAP = {\n  lighthouse: { x: 2, z: -9, label: 'The Lighthouse', y: 11 },\n  jar: { x: -3, z: -4, label: 'The Jar', y: 3.4 },\n  green: { x: 0, z: 2, label: 'The Circus Green', y: 2.6 },\n  sunDeck: { x: -16, z: -3, label: 'The Sun Deck', y: 4 },\n  pond: { x: -13, z: 7, label: 'The Lily Pond', y: 2 },\n  quarry: { x: -9, z: -13, label: 'The Quarry Terrace', y: 3 },\n  yard: { x: -7, z: 14, label: 'The Yard', y: 3.2 },\n  bandstand: { x: 15, z: -3, label: 'The Bandstand', y: 5 },\n  boardwalk: { x: 19, z: 3, label: 'The Boardwalk Gate', y: 3.6 },\n  pier: { x: 15, z: 12, label: 'The Pier', y: 3 },\n  beach: { x: 5, z: 17, label: 'The Beach', y: 2.6 },\n  board: { x: 1, z: 9, label: 'The Notice Board', y: 3 },\n  bedHut: { x: 8, z: 8, label: 'The Bed Hut', y: 3.6 },\n  mirror: { x: 9, z: -14, label: 'The Mirror', y: 4 },\n  gazebo: { x: 14, z: -11, label: 'The Gazebo', y: 4 },\n};\n\nexport class IslandArt {\n  constructor() {\n    this.holder = G('islandHolder');\n    this.group = G('island');\n    this.holder.add(this.group);\n    this.spots = {};\n    this.buildBase();\n    this.buildLandmarks();\n    this.buildDressing();\n    this.buildCast();\n  }\n  buildBase() {\n    const g = this.group;\n    add(g, M(geo.cyl(22, 21.4, 1.2, 72), SAND, 0, -0.6, 0));\n    const grass = M(geo.disc(15, 56), GRASS, 0, 0.012, 0, { shadow: false });\n    g.add(grass);\n    const ringRoad = M(geo.ring(18.1, 19.9, 72), 0xE8D3A0, 0, 0.018, 0, { shadow: false });\n    g.add(ringRoad);\n    const profile = [[21.4, -1.2], [18.5, -2.3], [12, -3.4], [5.5, -4.5], [1.2, -5.7], [0.5, -6]].map(([x, y]) => new THREE.Vector2(x, y));\n    const under = new THREE.Mesh(new THREE.LatheGeometry(profile, 56), toon(ROCK));\n    under.castShadow = true; under.receiveShadow = true;\n    g.add(under);\n    // Toy fence: posts and rails.\n    const n = 40;\n    const postMesh = new THREE.InstancedMesh(geo.cyl(0.07, 0.09, 0.8, 8), toon(CREAM), n);\n    const railMesh = new THREE.InstancedMesh(geo.box(0.06, 0.08, 3.5), toon(TEAL), n);\n    const m = new THREE.Matrix4(), q = new THREE.Quaternion(), yAxis = new THREE.Vector3(0, 1, 0), p = new THREE.Vector3(), s = new THREE.Vector3(1, 1, 1);\n    for (let i = 0; i < n; i++) {\n      const a = (i / n) * Math.PI * 2;\n      const skip = i === 3 || i === 2 || i === 5 ? 0 : 1;\n      p.set(Math.cos(a) * 21.7, 0.4, Math.sin(a) * 21.7); q.identity(); s.setScalar(1);\n      m.compose(p, q, s); postMesh.setMatrixAt(i, m);\n      const a2 = a + Math.PI / n;\n      p.set(Math.cos(a2) * 21.7, 0.6, Math.sin(a2) * 21.7); q.setFromAxisAngle(yAxis, -a2); s.set(skip, 1, 1);\n      m.compose(p, q, s); railMesh.setMatrixAt(i, m);\n    }\n    postMesh.castShadow = true; railMesh.castShadow = true;\n    add(g, postMesh, railMesh);\n    // The one pivot rock stands in the sea and never moves.\n    this.pivot = G('pivot', 0, -8.2, 0);\n    add(this.pivot, M(geo.sphere(3.4, 16, 12), ROCK, 0, 0, 0, { scale: [1.3, 0.9, 1.3] }), M(geo.sphere(1.6, 10, 8), 0x7A6C5E, 2.9, -1, 1.4));\n    this.holder.add(this.pivot);\n  }\n  spot(id, group) {\n    const s = MAP[id];\n    group.position.set(s.x, 0, s.z);\n    this.group.add(group);\n    s.group = group;\n    this.spots[id] = group;\n    return group;\n  }\n  buildLandmarks() {\n    this.lighthouse();\n    this.jar();\n    this.green();\n    this.sunDeck();\n    this.pond();\n    this.quarry();\n    this.yard();\n    this.bandstand();\n    this.boardwalk();\n    this.pier();\n    this.beach();\n    this.board();\n    this.bedHut();\n    this.mirror();\n    this.gazebo();\n  }\n  lighthouse() {\n    const g = G();\n    add(g, M(geo.cyl(2.2, 2.4, 0.5, 24), STONE, 0, 0.25, 0));\n    let y = 0.5;\n    const tiers = 6;\n    for (let i = 0; i < tiers; i++) {\n      const r0 = 1.5 - (i * 0.55) / tiers, r1 = r0 - 0.55 / tiers, h = 1.25;\n      add(g, M(geo.cyl(r1, r0, h, 24), i % 2 ? CREAM : RED, 0, y + h / 2, 0));\n      y += h;\n    }\n    add(g, M(geo.cyl(1.35, 1.2, 0.2, 24), CREAM, 0, y + 0.1, 0));\n    y += 0.2;\n    for (let i = 0; i < 12; i++) { const a = (i / 12) * Math.PI * 2; add(g, M(geo.cyl(0.03, 0.03, 0.5, 6), CREAM, Math.cos(a) * 1.3, y + 0.25, Math.sin(a) * 1.3)); }\n    add(g, M(geo.tor(1.3, 0.035, Math.PI * 2, 32), CREAM, 0, y + 0.5, 0, { rot: [Math.PI / 2, 0, 0] }));\n    this.lampMat = new THREE.MeshBasicNodeMaterial({ color: 0xFFE9A8 });\n    this.lamp = new THREE.Mesh(geo.cyl(0.55, 0.55, 0.9, 16), this.lampMat);\n    this.lamp.position.y = y + 0.45;\n    g.add(this.lamp);\n    add(g, M(geo.cone(0.85, 0.75, 16), BLUE, 0, y + 1.3, 0), M(geo.sphere(0.12, 10, 8), RED, 0, y + 1.75, 0));\n    add(g, M(geo.box(0.7, 1.2, 0.1), TEAL, 0, 1.1, 1.42), M(geo.sphere(0.32, 12, 8), CREAM, 0, 4.2, 1.2, { scale: [1, 1, 0.3] }));\n    this.lighthouseTop = y;\n    this.spot('lighthouse', g);\n    this.lightGlow = new THREE.PointLight(0xFFE9A8, 0, 30);\n    this.lightGlow.position.y = y + 0.4;\n    g.add(this.lightGlow);\n  }\n  jar() {\n    const g = G();\n    add(g, M(geo.cyl(1.5, 1.7, 0.36, 28), WOOD, 0, 0.18, 0), M(geo.cyl(1.3, 1.3, 0.1, 28), TEAK, 0, 0.41, 0));\n    const jg = jarMesh();\n    jg.position.y = 0.46;\n    g.add(jg);\n    this.jarGroup = jg;\n    this.spot('jar', g);\n  }\n  green() {\n    const g = G();\n    add(g, M(geo.disc(4.6, 40), 0xF2E3B5, 0, 0.02, 0, { shadow: false }), M(geo.ring(4.2, 4.6, 40), RED, 0, 0.026, 0, { shadow: false }));\n    for (let i = 0; i < 6; i++) {\n      const a = (i / 6) * Math.PI * 2;\n      add(g, post(1.9, 0.05, CREAM, Math.cos(a) * 3.2, 0, Math.sin(a) * 3.2), M(geo.cyl(0.42, 0.34, 0.05, 20), i % 2 ? TEAL : ORANGE, Math.cos(a) * 3.2, 1.96, Math.sin(a) * 3.2));\n    }\n    add(g, M(geo.tor(0.6, 0.05), RED, 0, 0.7, 0, { rot: [Math.PI / 2, 0, 0] }));\n    this.spot('green', g);\n  }\n  sunDeck() {\n    const g = G();\n    add(g, M(geo.cyl(4.2, 4.2, 0.2, 32), TEAK, 0, 0.3, 0));\n    for (let i = 0; i < 8; i++) { const a = (i / 8) * Math.PI * 2; add(g, post(0.26, 0.14, WOOD_D, Math.cos(a) * 3.6, 0, Math.sin(a) * 3.6)); }\n    for (let i = 0; i < 4; i++) add(g, M(geo.box(8, 0.012, 0.03), WOOD_D, 0, 0.407, -1.8 + i * 1.2));\n    add(g, M(geo.cyl(1.2, 1.2, 0.03, 28), 0xC24D6A, 0, 0.42, 0));\n    this.spot('sunDeck', g);\n  }\n  pond() {\n    const g = G();\n    const water = M(geo.disc(3.6, 40), 0x5AC0C4, 0, 0.022, 0, { shadow: false });\n    add(g, water, M(geo.ring(3.5, 4, 40), STONE, 0, 0.03, 0, { shadow: false }));\n    for (let i = 0; i < 6; i++) {\n      const a = i * 1.9, r = 1 + (i % 3) * 0.8;\n      add(g, M(geo.cyl(0.5, 0.5, 0.03, 16), LEAF2, Math.cos(a) * r, 0.05, Math.sin(a) * r));\n    }\n    for (let i = 0; i < 10; i++) {\n      const a = (i / 10) * Math.PI * 2 + 0.3;\n      add(g, M(geo.cyl(0.02, 0.02, 1, 6), LEAF, Math.cos(a) * 3.8, 0.5, Math.sin(a) * 3.8), M(geo.cap(0.05, 0.16, 6), WOOD_D, Math.cos(a) * 3.8, 1.04, Math.sin(a) * 3.8));\n    }\n    this.spot('pond', g);\n  }\n  quarry() {\n    const g = G();\n    add(g, M(geo.cyl(4.2, 4.6, 0.3, 8), STONE, 0, 0.15, 0));\n    for (const [x, z, s] of [[-2.2, -1.6, 1.1], [1.9, -2, 0.9], [2.5, 1, 0.7], [-2.6, 1.3, 0.6]]) { const r = bigRock(s, STONE_D); r.position.set(x, 0.3 + s * 0.45, z); g.add(r); }\n    const stack = G('', 0, 0.3, 0);\n    let y = 0;\n    for (const [r, hh] of [[0.5, 0.17], [0.42, 0.15], [0.34, 0.13], [0.26, 0.11], [0.18, 0.09]]) { stack.add(M(geo.sphere(r, 12, 8), STONE_D, 0, y + hh, 0, { scale: [1, hh / r, 1] })); y += hh * 2; }\n    g.add(stack);\n    this.spot('quarry', g);\n  }\n  yard() {\n    const g = G();\n    add(g, M(geo.disc(4.4, 36), 0xE6CDA0, 0, 0.022, 0, { shadow: false }));\n    for (const [x, z, r] of [[-2.2, 1.6, 0.2], [-2.2, 2.1, 0.2], [-2.2, 1.85, 0.19], [2.4, 2, 0.22]]) add(g, M(geo.cyl(r, r, 2.8, 12), WOOD_D, x, r + (z === 1.85 ? 0.32 : 0.02), z, { rot: [0, 0, Math.PI / 2] }));\n    add(g, post(2.4, 0.12, WOOD_D, -3.2, 0, -1.2), post(2.4, 0.12, WOOD_D, 3.2, 0, -1.2), M(geo.cyl(0.1, 0.1, 6.6, 10), WOOD, 0, 2.3, -1.2, { rot: [0, 0, Math.PI / 2] }));\n    this.spot('yard', g);\n  }\n  bandstand() {\n    const g = G();\n    add(g, M(geo.cyl(4.2, 4.5, 0.5, 8), CREAM, 0, 0.25, 0), M(geo.cyl(4.05, 4.05, 0.05, 8), TEAK, 0, 0.52, 0));\n    for (let i = 0; i < 8; i++) { const a = (i / 8) * Math.PI * 2 + Math.PI / 8; add(g, post(3.1, 0.09, CREAM, Math.cos(a) * 3.8, 0.5, Math.sin(a) * 3.8)); }\n    const roof = pavilionRoof(4.6, TEAL, ORANGE);\n    roof.position.y = 3.6;\n    g.add(roof);\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * Math.PI * 2 + Math.PI / 8, b = ((i + 1) / 8) * Math.PI * 2 + Math.PI / 8;\n      g.add(bunting(Math.cos(a) * 3.8, 3.4, Math.sin(a) * 3.8, Math.cos(b) * 3.8, 3.4, Math.sin(b) * 3.8, 5));\n    }\n    this.spot('bandstand', g);\n  }\n  boardwalk() {\n    const g = G();\n    add(g, post(3, 0.12, TEAL, -1.1, 0, 0), post(3, 0.12, TEAL, 1.1, 0, 0), M(geo.box(2.8, 0.3, 0.3), ORANGE, 0, 3.05, 0));\n    const sign = signBoard('ROOM SERVICE', 2.2, 0.5); sign.position.set(0, 2.55, 0.17); g.add(sign);\n    g.rotation.y = -Math.PI / 2 - 0.15;\n    this.spot('boardwalk', g);\n    const walk = G('', 24, 0, 3.8);\n    const deck = planks(9, 1.7, { along: 'z', top: -0.02 });\n    walk.add(deck);\n    for (let i = 0; i < 5; i++) add(walk, post(2.6, 0.08, WOOD_D, -4 + i * 2, -2.7, 0.9), post(2.6, 0.08, WOOD_D, -4 + i * 2, -2.7, -0.9));\n    walk.rotation.y = -0.15;\n    this.group.add(walk);\n  }\n  pier() {\n    const g = G();\n    const dir = Math.atan2(12, 15);\n    const pier = G();\n    pier.rotation.y = -dir;\n    pier.position.set(0, 0, 0);\n    const deck = planks(19, 3.2, { along: 'z', top: -0.02 });\n    deck.position.x = 9.5;\n    pier.add(deck);\n    for (let i = 0; i < 6; i++) add(pier, post(5, 0.11, WOOD_D, 4 + i * 3, -5, 1.45), post(5, 0.11, WOOD_D, 4 + i * 3, -5, -1.45));\n    // The toy-block dive tower at its end.\n    const tower = G('', 17, 0, 0);\n    let y = 0;\n    for (let i = 0; i < 5; i++) { add(tower, M(geo.box(2, 1, 2), [RED, 0xF5B700, TEAL, CREAM, BLUE][i], 0, y + 0.5, 0)); y += 1; }\n    add(tower, M(geo.box(2.8, 0.08, 0.5), CREAM, 1.8, y + 0.04, 0));\n    pier.add(tower);\n    add(pier, M(geo.box(0.9, 0.5, 0.9), WOOD, 9, 0.25, 0.8), buoyOn(13, 0.5, 2.4));\n    g.add(pier);\n    this.spot('pier', g);\n  }\n  beach() {\n    const g = G();\n    for (const [x, z, c] of [[-3, 1.4, RED], [3.2, 0.8, TEAL], [0.2, 2.6, 0xF5B700]]) { const u = umbrella(c); u.position.set(x, 0, z); g.add(u); }\n    g.add(rope(-3.4, 0.5, -1, 3.4, 0.5, -1, 0.2, 0.05));\n    for (let i = -3; i <= 3; i++) add(g, M(geo.box(0.06, 0.012, 0.8), CREAM, i, 0.022, -1, { shadow: false }));\n    this.spot('beach', g);\n  }\n  board() {\n    const g = G();\n    add(g, post(2.6, 0.08, WOOD_D, -1, 0, 0), post(2.6, 0.08, WOOD_D, 1, 0, 0), M(geo.box(2.4, 1.5, 0.1), WOOD, 0, 1.8, 0), M(geo.box(2.7, 0.14, 0.3), ORANGE, 0, 2.62, 0));\n    const pins = [[-0.7, 2, 0xFFF4DC], [0.1, 1.95, 0xFBE7BF], [0.75, 2.05, 0xFFF4DC], [-0.4, 1.5, 0xFBE7BF], [0.5, 1.48, 0xFFF4DC]];\n    for (const [x, y, c] of pins) add(g, M(geo.box(0.55, 0.5, 0.02), c, x, y, 0.06, { rot: [0, 0, cos(-0.08, 0.08)], shadow: false }));\n    this.spot('board', g);\n  }\n  bedHut() {\n    const g = G();\n    add(g, M(geo.box(3.2, 2.1, 2.6), CREAM, 0, 1.05, 0), M(geo.box(0.8, 1.5, 0.08), TEAL, 0, 0.75, 1.31), M(geo.sphere(0.05, 8, 6), 0xF5B700, 0.26, 0.8, 1.37), M(geo.box(0.7, 0.6, 0.08), 0x8FC7E8, 1.1, 1.3, 1.31));\n    const roof = M(geo.cone(2.7, 1.3, 4), ORANGE, 0, 2.75, 0, { rot: [0, Math.PI / 4, 0] });\n    g.add(roof);\n    const moon = M(geo.tor(0.14, 0.05, Math.PI * 1.3), 0xF5B700, -1, 1.4, 1.33, { shadow: false }); g.add(moon);\n    this.spot('bedHut', g);\n  }\n  mirror() {\n    const g = G();\n    for (let i = 0; i < 4; i++) { const a = (i / 4) * Math.PI * 2 + Math.PI / 4; add(g, post(2.9, 0.09, TEAL, Math.cos(a) * 1.9, 0, Math.sin(a) * 1.9)); }\n    const roof = pavilionRoof(2.8, ORANGE, TEAL); roof.position.y = 3; roof.rotation.y = Math.PI / 8; g.add(roof);\n    const mirror = G('', 0, 1.35, 0);\n    add(mirror, M(geo.tor(0.72, 0.07, Math.PI * 2, 40), 0xF5B700, 0, 0, 0, { scale: [1, 1.5, 1] }), new THREE.Mesh(geo.cyl(0.7, 0.7, 0.02, 32), basic(0xBFE9F0)));\n    mirror.children[1].rotation.x = Math.PI / 2; mirror.children[1].scale.z = 1.5;\n    g.add(mirror);\n    this.spot('mirror', g);\n  }\n  gazebo() {\n    const g = G();\n    add(g, M(geo.cyl(3.1, 3.3, 0.3, 6), CREAM, 0, 0.15, 0));\n    for (let i = 0; i < 6; i++) { const a = (i / 6) * Math.PI * 2; add(g, post(2.7, 0.08, CREAM, Math.cos(a) * 2.8, 0.3, Math.sin(a) * 2.8)); }\n    const roof = pavilionRoof(3.5, RED, CREAM); roof.position.y = 3; g.add(roof);\n    add(g, M(geo.cyl(0.9, 0.9, 0.08, 16), TEAK, 0, 0.34, 0));\n    this.spot('gazebo', g);\n  }\n  buildDressing() {\n    const g = this.group;\n    const treeSpots = [[-7, 0], [-5, 7], [-11, -6], [6, -5], [7, 2], [11, 3], [11, -8], [-3, 12], [4, 12], [-2, -12], [5, -11], [-10, 12], [12, 8], [-4, 4], [-13, -9]];\n    for (const [x, z] of treeSpots) {\n      const t = tree(cos(1.6, 2.8), cos(0.9, 1.4), cosPick([LEAF, LEAF2, 0x4F9F5A]));\n      t.position.set(x, 0, z);\n      g.add(t);\n    }\n    for (const [x, z] of [[-19.5, 8], [10, 19], [-18, -11], [-14, 15], [0, -20], [20, -8]]) { const p = palm(cos(2.8, 3.8)); p.position.set(x, 0, z); p.rotation.y = cos(0, 6); g.add(p); }\n    for (let i = 0; i < 18; i++) {\n      const a = cos(0, 6.28), r = cos(16, 21);\n      g.add(M(geo.sphere(cos(0.2, 0.5), 8, 6), STONE_D, Math.cos(a) * r, 0.06, Math.sin(a) * r, { scale: [1, 0.5, 0.8] }));\n    }\n    g.add(bunting(-1, 4, 7, 7, 3.2, 7.6, 12));\n    g.add(bunting(1, 2.6, 9, -7, 2.4, 11, 12));\n    for (let i = 0; i < 18; i++) {\n      const a = (i / 18) * Math.PI * 2 + 0.1;\n      add(g, M(geo.cone(0.1, 0.5, 6), LEAF, Math.cos(a) * 15.3, 0.25, Math.sin(a) * 15.3));\n    }\n  }\n  buildCast() {\n    this.trudy = new Trudy();\n    this.group.add(this.trudy.root);\n    this.heron = new Heron();\n    this.heron.root.position.set(-16, 0.43, -5);\n    this.group.add(this.heron.root);\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(-5, 0, 11);\n    this.walrus.root.rotation.y = 0.5;\n    this.group.add(this.walrus.root);\n    this.gary = new Gull();\n    this.gary.root.position.set(1, 2.72, 9);\n    this.group.add(this.gary.root);\n    const G2 = [\n      { id: 'margaret', shirt: '#C9A0DC', hat: 'perm', height: 0.92, width: 1.02, shorts: 0x6B6B8F, home: [-2, 6] },\n      { id: 'kevin', shirt: '#6FB7D6', hat: 'visor', height: 1, width: 1, shorts: 0x38503A, home: [12, 15] },\n      { id: 'sandras', shirt: '#E78FB3', hat: 'bucket', height: 0.96, width: 1, shorts: 0x7A3F5A, home: [6, 4] },\n      { id: 'sandras', shirt: '#E78FB3', hat: 'bucket', height: 0.96, width: 1, shorts: 0x7A3F5A, home: [7, 5] },\n      { id: 'paul', shirt: '#F5C84A', hat: 'beret', height: 1.06, width: 0.94, shorts: 0x444455, home: [-8, -5] },\n      { id: 'gerald', shirt: '#7FA650', hat: 'none', height: 0.88, width: 0.96, shorts: 0x5A4A3A, home: [-10, 3] },\n    ];\n    this.guests = G2.map((d, i) => {\n      const doll = new Doll({ shirt: d.shirt, hat: d.hat, height: d.height, width: d.width, shorts: d.shorts });\n      doll.flatFeet = false;\n      doll.root.position.set(d.home[0], 0, d.home[1]);\n      this.group.add(doll.root);\n      return { doll, id: d.id, home: d.home, x: d.home[0], z: d.home[1], tx: d.home[0], tz: d.home[1], wait: cos(0, 5), follow: i === 3 ? 2 : -1 };\n    });\n    this.lastGuestT = 0;\n  }\n  /** Guests wander between spots, and need no physics. */\n  updateCast(dt, tiltQuatInverse) {\n    this.trudy.update(dt);\n    this.heron.update(dt);\n    this.walrus.update(dt);\n    this.gary.update(dt);\n    for (const g of this.guests) {\n      if (g.follow >= 0) {\n        const f = this.guests[g.follow];\n        g.tx = f.x + 1.1; g.tz = f.z + 0.5;\n      } else if (g.wait > 0) g.wait -= dt;\n      const dx = g.tx - g.x, dz = g.tz - g.z, d = Math.hypot(dx, dz);\n      if (d > 0.3 && g.wait <= 0) {\n        const sp = 1.2 * Math.min(1, d);\n        g.x += (dx / d) * sp * dt; g.z += (dz / d) * sp * dt;\n        g.doll.face(Math.atan2(dx, dz));\n        g.doll.rig.loop('walk');\n      } else {\n        g.doll.rig.loop('idle');\n        if (g.follow < 0 && g.wait <= 0) {\n          g.wait = cos(3, 9);\n          const a = cos(0, 6.28), r = cos(1, 5);\n          g.tx = Math.max(-14, Math.min(14, g.home[0] + Math.cos(a) * r)); g.tz = Math.max(-14, Math.min(14, g.home[1] + Math.sin(a) * r));\n        }\n      }\n      g.doll.root.position.set(g.x, 0, g.z);\n      if (tiltQuatInverse) g.doll.root.quaternion.copy(tiltQuatInverse);\n      g.doll.update(dt);\n    }\n  }\n  /** Marble display on the island: settled positions from the last pour. */\n  buildMarbles(n = 320) {\n    const mesh = new THREE.InstancedMesh(geo.sphere(0.14, 12, 10), toon(0xffffff), n);\n    mesh.count = 0; mesh.castShadow = true; mesh.frustumCulled = false;\n    this.jarGroup.add(mesh);\n    this.marbleMesh = mesh;\n    return mesh;\n  }\n  /** On hover: a thick outline around a landmark. Built on first use. */\n  outline(id, on) {\n    const s = MAP[id];\n    if (!s || !s.group) return;\n    if (on && !s.outline) s.outline = makeOutline(s.group, 0.07);\n    if (s.outline) s.outline.visible = on;\n  }\n}\nfunction buoyOn(x, y, z) { const b = buoy(); b.position.set(x, y, z); return b; }\nEOF\ncat > src/physics/island.js <<'EOF'\nimport { RAPIER, groups, createWorld } from './world.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\n\nconst RAD = Math.PI / 180;\n/** Do not move the island. Tilt gravity. Rapier sees a fixed flat disc. */\nexport class IslandPhysics {\n  constructor() {\n    this.world = createWorld({ iterations: 6 });\n    this.tx = 0; this.tz = 0; this.vx = 0; this.vz = 0; this.rest = 9; this.restNow = 9; this.restAngle = 0.4;\n    this.leanExtraX = 0; this.leanExtraZ = 0;\n    this.walkerEnabled = false;\n    const disc = RAPIER.ColliderDesc.cylinder(0.5, 22).setTranslation(0, -0.5, 0).setFriction(0.9).setCollisionGroups(groups.ground());\n    this.world.createCollider(disc);\n    const n = 40;\n    for (let i = 0; i < n; i++) {\n      const a = (i / n) * Math.PI * 2;\n      const q = yawQ(-a);\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.15, 1, 1.9).setTranslation(Math.cos(a) * 21.9, 1, Math.sin(a) * 21.9).setRotation(q).setFriction(0.5).setCollisionGroups(groups.ground()));\n    }\n    // Walker\n    const b = this.walker = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, 0.9, 10).lockRotations().setCanSleep(false));\n    this.walkerCol = this.world.createCollider(RAPIER.ColliderDesc.capsule(0.5, 0.3).setMass(1).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setCollisionGroups(((0x0100 << 16) | 0x0011) >>> 0), b);\n    this.wantX = 0; this.wantZ = 0;\n    this.props = [];\n    this.addProps();\n    this.q = { x: 0, y: 0, z: 0, w: 1 };\n  }\n  addProps() {\n    for (let i = 0; i < 44; i++) {\n      const a = cos(0, 6.28), r = cos(2, 19);\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(Math.cos(a) * r, 0.4, Math.sin(a) * r).setCanSleep(false).setAngularDamping(0.4).setLinearDamping(0.08));\n      this.world.createCollider(RAPIER.ColliderDesc.ball(0.14).setMass(0.05).setFriction(0.8).setRestitution(0.3).setCollisionGroups(((0x0010 << 16) | 0x0111) >>> 0), body);\n      this.props.push({ body, kind: 'orange', r: 0.14 });\n    }\n    for (let i = 0; i < 6; i++) {\n      const a = cos(0, 6.28), r = cos(5, 18);\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(Math.cos(a) * r, 0.6, Math.sin(a) * r).setCanSleep(false).setAngularDamping(0.3).setLinearDamping(0.05));\n      this.world.createCollider(RAPIER.ColliderDesc.ball(0.32).setMass(0.08).setFriction(0.6).setRestitution(0.6).setCollisionGroups(((0x0010 << 16) | 0x0111) >>> 0), body);\n      this.props.push({ body, kind: 'ball', r: 0.32 });\n    }\n    for (let i = 0; i < 8; i++) {\n      const a = cos(0, 6.28), r = cos(4, 18);\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(Math.cos(a) * r, 0.4, Math.sin(a) * r).setCanSleep(false));\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.3, 0.25, 0.3).setMass(0.5).setFriction(0.32).setCollisionGroups(((0x0010 << 16) | 0x0111) >>> 0), body);\n      this.props.push({ body, kind: 'crate', r: 0.3 });\n    }\n  }\n  /** Rest tilt in degrees, in a fixed direction. Eases on its own. */\n  setRest(deg) { this.rest = deg; }\n  get restTiltDeg() { return this.restNow; }\n  get tiltDeg() { return Math.hypot(this.tx, this.tz) / RAD; }\n  setPosition(x, z) { this.walker.setTranslation({ x, y: 0.9, z }, true); this.walker.setLinvel({ x: 0, y: 0, z: 0 }, true); }\n  get pos() { return this.walker.translation(); }\n  snapTilt() {\n    this.restNow = this.rest;\n    this.tx = this.restNow * RAD * Math.cos(this.restAngle); this.tz = this.restNow * RAD * Math.sin(this.restAngle); this.vx = 0; this.vz = 0;\n  }\n  /** One step. wantX, wantZ: walker speed. weight 0 means nobody is on the island. */\n  step(dt, { weight = 1 } = {}) {\n    this.restNow += Math.sign(this.rest - this.restNow) * Math.min(Math.abs(this.rest - this.restNow), dt * 0.9);\n    const restRad = this.restNow * RAD, K = tun.islandSpring, C = 1.8 * Math.sqrt(K / 2.2);\n    const restX = restRad * Math.cos(this.restAngle), restZ = restRad * Math.sin(this.restAngle);\n    const W = (K * tun.islandWeight * RAD) / 22 * weight;\n    const p = this.walker.translation();\n    this.vx += (K * restX + W * p.x + this.leanExtraX * K - K * this.tx - C * this.vx) * dt; this.tx += this.vx * dt;\n    this.vz += (K * restZ + W * p.z + this.leanExtraZ * K - K * this.tz - C * this.vz) * dt; this.tz += this.vz * dt;\n    const g = tun.gravity;\n    this.world.gravity = { x: g * Math.sin(this.tx), y: -g * Math.cos(Math.hypot(this.tx, this.tz)), z: g * Math.sin(this.tz) };\n    const v = this.walker.linvel();\n    this.walker.setLinvel({ x: this.wantX + this.tx * 3, y: v.y, z: this.wantZ + this.tz * 3 }, true);\n    this.world.step();\n    const a = Math.hypot(this.tx, this.tz) || 1e-9, s = Math.sin(a / 2);\n    this.q.x = (this.tz / a) * s; this.q.y = 0; this.q.z = (-this.tx / a) * s; this.q.w = Math.cos(a / 2);\n  }\n}\nfunction yawQ(a) { return { x: 0, y: Math.sin(a / 2), z: 0, w: Math.cos(a / 2) }; }\nEOF\n","description":"Write set props, island art and island physics"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15567,"cache_read_input_tokens":253852,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15567},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"85a0cd30-4656-4787-a361-87ed3e3ca457","timestamp":"2026-11-05T12:12:48.104Z","request_id":"req_011CgjkpfAjeZ9TAv1Pssv4E","wire_tool_inputs":{"toolu_01B8uwhysTWp8UvUXb3CUXsA":{"command":"cat > src/art/props.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { M, G, geo, toon, add, basic, glass } from './materials.js';\nimport { cos } from '../core/rng.js';\n\nexport const WOOD = 0xC99A62, WOOD_D = 0x9A6E3E, TEAK = 0xB5763C, TEAL = 0x2CB5A0, ORANGE = 0xF08A3C, CREAM = 0xFFF3DC, RED = 0xD9483B, BLUE = 0x3B6FB6, STONE = 0xD8D3C4, STONE_D = 0xB7B1A0, GRASS = 0x8CCB6A, SAND = 0xF6E2B3, ROCK = 0x8A7B6C, LEAF = 0x5FAE5A, LEAF2 = 0x79C26A;\n\n/** A plank deck: rows of slightly different boards. Top surface at y = 0 (plus top). */\nexport function planks(w, d, { thick = 0.14, colour = WOOD, along = 'x', top = 0, board = 0.5 } = {}) {\n  const g = G();\n  const n = Math.max(1, Math.round((along === 'x' ? d : w) / board));\n  const size = (along === 'x' ? d : w) / n;\n  const shades = [colour, new THREE.Color(colour).multiplyScalar(0.94).getHex(), new THREE.Color(colour).multiplyScalar(1.05).getHex()];\n  for (let i = 0; i < n; i++) {\n    const off = (i + 0.5) * size - (along === 'x' ? d : w) / 2;\n    const col = shades[i % 3];\n    const m = along === 'x'\n      ? M(geo.box(w, thick, size - 0.02), col, 0, top - thick / 2, off)\n      : M(geo.box(size - 0.02, thick, d), col, off, top - thick / 2, 0);\n    g.add(m);\n  }\n  return g;\n}\nexport const post = (h, r = 0.1, colour = WOOD_D, x = 0, y = 0, z = 0) => M(geo.cyl(r, r, h, 12), colour, x, y + h / 2, z);\nexport function crate(s = 0.8, colour = WOOD) {\n  const g = G();\n  add(g, M(geo.box(s, s * 0.7, s), colour, 0, s * 0.35, 0));\n  for (const y of [0.03, 0.67]) add(g, M(geo.box(s * 1.04, s * 0.06, s * 1.04), WOOD_D, 0, s * y, 0));\n  return g;\n}\nexport function tree(h = 2.4, r = 1, leaf = LEAF) {\n  const g = G();\n  add(g, M(geo.cyl(0.13, 0.18, h, 12), WOOD_D, 0, h / 2, 0), M(geo.sphere(r, 18, 14), leaf, 0, h + r * 0.55, 0));\n  return g;\n}\nexport function palm(h = 3.2) {\n  const g = G();\n  let y = 0, x = 0;\n  for (let i = 0; i < 6; i++) { const r = 0.14 - i * 0.012; g.add(M(geo.cyl(r, r + 0.012, h / 6 + 0.03, 10), i % 2 ? WOOD : WOOD_D, x, y + h / 12, 0, { rot: [0, 0, -0.06 * i] })); y += h / 6; x += 0.06 * i; }\n  for (let i = 0; i < 6; i++) {\n    const a = (i / 6) * Math.PI * 2;\n    g.add(M(geo.sphere(0.7, 10, 8), LEAF, x + Math.cos(a) * 0.62, y - 0.08, Math.sin(a) * 0.62, { scale: [1, 0.09, 0.35], rot: [0, -a, Math.cos(a) * -0.3] }));\n  }\n  return g;\n}\nexport function buoy(colour = RED) {\n  const g = G();\n  add(g, M(geo.sphere(0.3, 14, 10), colour, 0, 0, 0, { scale: [1, 0.8, 1] }), M(geo.cyl(0.05, 0.05, 0.5, 8), CREAM, 0, 0.4, 0), M(geo.sphere(0.09, 10, 8), colour, 0, 0.68, 0));\n  return g;\n}\nexport function barge() {\n  const g = G();\n  add(g,\n    M(geo.rbox(7, 1.3, 3, 0.25), 0x6B4A2E, 0, 0.3, 0), M(geo.box(6.4, 0.12, 2.5), WOOD, 0, 1, 0),\n    M(geo.box(1.8, 1.2, 1.6), CREAM, -2, 1.6, 0), M(geo.box(2.1, 0.14, 1.9), ORANGE, -2, 2.26, 0),\n    M(geo.cyl(0.3, 0.42, 1.8, 14), RED, 1.5, 1.9, 0, { rot: [0.5, 0, -0.45] }), M(geo.tor(0.31, 0.06), CREAM, 1.92, 2.7, 0.42, { rot: [1.05, 0.45, 0] }),\n    M(geo.cyl(0.14, 0.14, 1.4, 10), 0x333344, -2.5, 3, 0));\n  return g;\n}\nexport const rope = (ax, ay, az, bx, by, bz, sag = 0.4, r = 0.03, colour = 0xE9D7A8) => {\n  const a = new THREE.Vector3(ax, ay, az), b = new THREE.Vector3(bx, by, bz);\n  const mid = a.clone().lerp(b, 0.5); mid.y -= sag;\n  const curve = new THREE.QuadraticBezierCurve3(a, mid, b);\n  const m = new THREE.Mesh(new THREE.TubeGeometry(curve, 12, r, 6, false), toon(colour));\n  m.castShadow = false;\n  return m;\n};\n/** A line of little flags between two points. */\nexport function bunting(ax, ay, az, bx, by, bz, n = 10, colours = [RED, 0xF5B700, TEAL, CREAM]) {\n  const g = G();\n  g.add(rope(ax, ay, az, bx, by, bz, 0.5, 0.018, CREAM));\n  const a = new THREE.Vector3(ax, ay, az), b = new THREE.Vector3(bx, by, bz);\n  const yaw = Math.atan2(b.x - a.x, b.z - a.z) + Math.PI / 2;\n  for (let i = 1; i < n; i++) {\n    const k = i / n;\n    const p = a.clone().lerp(b, k); p.y -= 0.5 * 4 * k * (1 - k) * 0.5 * 2 / 2 + 0.11;\n    const flag = M(geo.cone(0.11, 0.24, 3), colours[i % colours.length], p.x, p.y, p.z, { rot: [Math.PI, yaw, 0], scale: [1, 1, 0.25], shadow: false });\n    g.add(flag);\n  }\n  return g;\n}\nexport function pavilionRoof(r, colour = TEAL, trim = ORANGE) {\n  const g = G();\n  add(g, M(geo.cone(r, r * 0.55, 8), colour, 0, r * 0.275, 0), M(geo.cyl(r * 1.02, r * 1.02, 0.14, 8), trim, 0, 0, 0), M(geo.sphere(0.14, 10, 8), trim, 0, r * 0.58, 0));\n  return g;\n}\nexport function bigRock(s = 1, colour = STONE) { return M(geo.sphere(s, 8, 6), colour, 0, 0, 0, { scale: [1, 0.7, 0.9] }); }\nexport function umbrella(colour = RED) {\n  const g = G();\n  add(g, M(geo.cyl(0.04, 0.04, 2.3, 8), CREAM, 0, 1.15, 0), M(geo.cone(1.2, 0.5, 8), colour, 0, 2.4, 0));\n  return g;\n}\nexport function jarMesh() {\n  const g = G();\n  const pts = [[0.01, 0], [1, 0.02], [1.08, 0.12], [1.08, 1.9], [0.86, 2.2], [0.86, 2.45], [0.95, 2.5]].map(([x, y]) => new THREE.Vector2(x, y));\n  const lathe = new THREE.LatheGeometry(pts, 48);\n  const glassMesh = new THREE.Mesh(lathe, glass(0.16));\n  glassMesh.renderOrder = 8;\n  g.add(glassMesh);\n  for (const [r, y] of [[1.08, 0.12], [1.08, 1.9], [0.86, 2.2], [0.95, 2.5]]) g.add(M(geo.tor(r, 0.018, Math.PI * 2, 56), 0x7FB9C4, 0, y, 0, { rot: [Math.PI / 2, 0, 0], shadow: false }));\n  const strip = basic(0xffffff, { transparent: true, opacity: 0.7 });\n  const s1 = new THREE.Mesh(geo.box(0.05, 1.3, 0.01), strip); s1.position.set(0.72, 1.05, 0.78); s1.rotation.y = 0.75;\n  const s2 = new THREE.Mesh(geo.box(0.03, 0.8, 0.01), strip); s2.position.set(0.86, 1.2, 0.62); s2.rotation.y = 0.95;\n  add(g, s1, s2);\n  return g;\n}\n/** Sign with painted text. */\nexport function signBoard(text, w = 2.4, h = 0.9, bg = '#C78B4A', fg = '#FFF4DC') {\n  const c = document.createElement('canvas');\n  c.width = 512; c.height = Math.round((512 * h) / w);\n  const g = c.getContext('2d');\n  if (g) {\n    g.fillStyle = bg; g.fillRect(0, 0, c.width, c.height);\n    g.strokeStyle = '#1A1420'; g.lineWidth = 14; g.strokeRect(0, 0, c.width, c.height);\n    g.fillStyle = fg; g.textAlign = 'center'; g.textBaseline = 'middle';\n    let size = 96;\n    do { g.font = `700 ${size}px Fredoka, sans-serif`; size -= 4; } while (g.measureText(text).width > c.width - 40 && size > 20);\n    g.fillText(text, c.width / 2, c.height / 2 + 4);\n  }\n  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace;\n  const mat = new THREE.MeshBasicNodeMaterial({ map: t });\n  const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), mat);\n  return m;\n}\nEOF\ncat > src/art/island.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { M, G, geo, toon, add, basic, makeOutline } from './materials.js';\nimport { Doll, PAINTS } from './doll.js';\nimport { Trudy, Heron, Walrus, Gull } from './cast.js';\nimport { cos, cosPick } from '../core/rng.js';\nimport {\n  planks, post, crate, tree, palm, buoy, bunting, pavilionRoof, bigRock, umbrella, jarMesh, signBoard, rope,\n  WOOD, WOOD_D, TEAK, TEAL, ORANGE, CREAM, RED, BLUE, STONE, STONE_D, GRASS, SAND, ROCK, LEAF, LEAF2,\n} from './props.js';\n\n// Fixed spots on the island, in island-local x, z.\nexport const MAP = {\n  lighthouse: { x: 2, z: -9, label: 'The Lighthouse', y: 11 },\n  jar: { x: -3, z: -4, label: 'The Jar', y: 3.4 },\n  green: { x: 0, z: 2, label: 'The Circus Green', y: 2.6 },\n  sunDeck: { x: -16, z: -3, label: 'The Sun Deck', y: 4 },\n  pond: { x: -13, z: 7, label: 'The Lily Pond', y: 2 },\n  quarry: { x: -9, z: -13, label: 'The Quarry Terrace', y: 3 },\n  yard: { x: -7, z: 14, label: 'The Yard', y: 3.2 },\n  bandstand: { x: 15, z: -3, label: 'The Bandstand', y: 5 },\n  boardwalk: { x: 19, z: 3, label: 'The Boardwalk Gate', y: 3.6 },\n  pier: { x: 15, z: 12, label: 'The Pier', y: 3 },\n  beach: { x: 5, z: 17, label: 'The Beach', y: 2.6 },\n  board: { x: 1, z: 9, label: 'The Notice Board', y: 3 },\n  bedHut: { x: 8, z: 8, label: 'The Bed Hut', y: 3.6 },\n  mirror: { x: 9, z: -14, label: 'The Mirror', y: 4 },\n  gazebo: { x: 14, z: -11, label: 'The Gazebo', y: 4 },\n};\n\nexport class IslandArt {\n  constructor() {\n    this.holder = G('islandHolder');\n    this.group = G('island');\n    this.holder.add(this.group);\n    this.spots = {};\n    this.buildBase();\n    this.buildLandmarks();\n    this.buildDressing();\n    this.buildCast();\n  }\n  buildBase() {\n    const g = this.group;\n    add(g, M(geo.cyl(22, 21.4, 1.2, 72), SAND, 0, -0.6, 0));\n    const grass = M(geo.disc(15, 56), GRASS, 0, 0.012, 0, { shadow: false });\n    g.add(grass);\n    const ringRoad = M(geo.ring(18.1, 19.9, 72), 0xE8D3A0, 0, 0.018, 0, { shadow: false });\n    g.add(ringRoad);\n    const profile = [[21.4, -1.2], [18.5, -2.3], [12, -3.4], [5.5, -4.5], [1.2, -5.7], [0.5, -6]].map(([x, y]) => new THREE.Vector2(x, y));\n    const under = new THREE.Mesh(new THREE.LatheGeometry(profile, 56), toon(ROCK));\n    under.castShadow = true; under.receiveShadow = true;\n    g.add(under);\n    // Toy fence: posts and rails.\n    const n = 40;\n    const postMesh = new THREE.InstancedMesh(geo.cyl(0.07, 0.09, 0.8, 8), toon(CREAM), n);\n    const railMesh = new THREE.InstancedMesh(geo.box(0.06, 0.08, 3.5), toon(TEAL), n);\n    const m = new THREE.Matrix4(), q = new THREE.Quaternion(), yAxis = new THREE.Vector3(0, 1, 0), p = new THREE.Vector3(), s = new THREE.Vector3(1, 1, 1);\n    for (let i = 0; i < n; i++) {\n      const a = (i / n) * Math.PI * 2;\n      const skip = i === 3 || i === 2 || i === 5 ? 0 : 1;\n      p.set(Math.cos(a) * 21.7, 0.4, Math.sin(a) * 21.7); q.identity(); s.setScalar(1);\n      m.compose(p, q, s); postMesh.setMatrixAt(i, m);\n      const a2 = a + Math.PI / n;\n      p.set(Math.cos(a2) * 21.7, 0.6, Math.sin(a2) * 21.7); q.setFromAxisAngle(yAxis, -a2); s.set(skip, 1, 1);\n      m.compose(p, q, s); railMesh.setMatrixAt(i, m);\n    }\n    postMesh.castShadow = true; railMesh.castShadow = true;\n    add(g, postMesh, railMesh);\n    // The one pivot rock stands in the sea and never moves.\n    this.pivot = G('pivot', 0, -8.2, 0);\n    add(this.pivot, M(geo.sphere(3.4, 16, 12), ROCK, 0, 0, 0, { scale: [1.3, 0.9, 1.3] }), M(geo.sphere(1.6, 10, 8), 0x7A6C5E, 2.9, -1, 1.4));\n    this.holder.add(this.pivot);\n  }\n  spot(id, group) {\n    const s = MAP[id];\n    group.position.set(s.x, 0, s.z);\n    this.group.add(group);\n    s.group = group;\n    this.spots[id] = group;\n    return group;\n  }\n  buildLandmarks() {\n    this.lighthouse();\n    this.jar();\n    this.green();\n    this.sunDeck();\n    this.pond();\n    this.quarry();\n    this.yard();\n    this.bandstand();\n    this.boardwalk();\n    this.pier();\n    this.beach();\n    this.board();\n    this.bedHut();\n    this.mirror();\n    this.gazebo();\n  }\n  lighthouse() {\n    const g = G();\n    add(g, M(geo.cyl(2.2, 2.4, 0.5, 24), STONE, 0, 0.25, 0));\n    let y = 0.5;\n    const tiers = 6;\n    for (let i = 0; i < tiers; i++) {\n      const r0 = 1.5 - (i * 0.55) / tiers, r1 = r0 - 0.55 / tiers, h = 1.25;\n      add(g, M(geo.cyl(r1, r0, h, 24), i % 2 ? CREAM : RED, 0, y + h / 2, 0));\n      y += h;\n    }\n    add(g, M(geo.cyl(1.35, 1.2, 0.2, 24), CREAM, 0, y + 0.1, 0));\n    y += 0.2;\n    for (let i = 0; i < 12; i++) { const a = (i / 12) * Math.PI * 2; add(g, M(geo.cyl(0.03, 0.03, 0.5, 6), CREAM, Math.cos(a) * 1.3, y + 0.25, Math.sin(a) * 1.3)); }\n    add(g, M(geo.tor(1.3, 0.035, Math.PI * 2, 32), CREAM, 0, y + 0.5, 0, { rot: [Math.PI / 2, 0, 0] }));\n    this.lampMat = new THREE.MeshBasicNodeMaterial({ color: 0xFFE9A8 });\n    this.lamp = new THREE.Mesh(geo.cyl(0.55, 0.55, 0.9, 16), this.lampMat);\n    this.lamp.position.y = y + 0.45;\n    g.add(this.lamp);\n    add(g, M(geo.cone(0.85, 0.75, 16), BLUE, 0, y + 1.3, 0), M(geo.sphere(0.12, 10, 8), RED, 0, y + 1.75, 0));\n    add(g, M(geo.box(0.7, 1.2, 0.1), TEAL, 0, 1.1, 1.42), M(geo.sphere(0.32, 12, 8), CREAM, 0, 4.2, 1.2, { scale: [1, 1, 0.3] }));\n    this.lighthouseTop = y;\n    this.spot('lighthouse', g);\n    this.lightGlow = new THREE.PointLight(0xFFE9A8, 0, 30);\n    this.lightGlow.position.y = y + 0.4;\n    g.add(this.lightGlow);\n  }\n  jar() {\n    const g = G();\n    add(g, M(geo.cyl(1.5, 1.7, 0.36, 28), WOOD, 0, 0.18, 0), M(geo.cyl(1.3, 1.3, 0.1, 28), TEAK, 0, 0.41, 0));\n    const jg = jarMesh();\n    jg.position.y = 0.46;\n    g.add(jg);\n    this.jarGroup = jg;\n    this.spot('jar', g);\n  }\n  green() {\n    const g = G();\n    add(g, M(geo.disc(4.6, 40), 0xF2E3B5, 0, 0.02, 0, { shadow: false }), M(geo.ring(4.2, 4.6, 40), RED, 0, 0.026, 0, { shadow: false }));\n    for (let i = 0; i < 6; i++) {\n      const a = (i / 6) * Math.PI * 2;\n      add(g, post(1.9, 0.05, CREAM, Math.cos(a) * 3.2, 0, Math.sin(a) * 3.2), M(geo.cyl(0.42, 0.34, 0.05, 20), i % 2 ? TEAL : ORANGE, Math.cos(a) * 3.2, 1.96, Math.sin(a) * 3.2));\n    }\n    add(g, M(geo.tor(0.6, 0.05), RED, 0, 0.7, 0, { rot: [Math.PI / 2, 0, 0] }));\n    this.spot('green', g);\n  }\n  sunDeck() {\n    const g = G();\n    add(g, M(geo.cyl(4.2, 4.2, 0.2, 32), TEAK, 0, 0.3, 0));\n    for (let i = 0; i < 8; i++) { const a = (i / 8) * Math.PI * 2; add(g, post(0.26, 0.14, WOOD_D, Math.cos(a) * 3.6, 0, Math.sin(a) * 3.6)); }\n    for (let i = 0; i < 4; i++) add(g, M(geo.box(8, 0.012, 0.03), WOOD_D, 0, 0.407, -1.8 + i * 1.2));\n    add(g, M(geo.cyl(1.2, 1.2, 0.03, 28), 0xC24D6A, 0, 0.42, 0));\n    this.spot('sunDeck', g);\n  }\n  pond() {\n    const g = G();\n    const water = M(geo.disc(3.6, 40), 0x5AC0C4, 0, 0.022, 0, { shadow: false });\n    add(g, water, M(geo.ring(3.5, 4, 40), STONE, 0, 0.03, 0, { shadow: false }));\n    for (let i = 0; i < 6; i++) {\n      const a = i * 1.9, r = 1 + (i % 3) * 0.8;\n      add(g, M(geo.cyl(0.5, 0.5, 0.03, 16), LEAF2, Math.cos(a) * r, 0.05, Math.sin(a) * r));\n    }\n    for (let i = 0; i < 10; i++) {\n      const a = (i / 10) * Math.PI * 2 + 0.3;\n      add(g, M(geo.cyl(0.02, 0.02, 1, 6), LEAF, Math.cos(a) * 3.8, 0.5, Math.sin(a) * 3.8), M(geo.cap(0.05, 0.16, 6), WOOD_D, Math.cos(a) * 3.8, 1.04, Math.sin(a) * 3.8));\n    }\n    this.spot('pond', g);\n  }\n  quarry() {\n    const g = G();\n    add(g, M(geo.cyl(4.2, 4.6, 0.3, 8), STONE, 0, 0.15, 0));\n    for (const [x, z, s] of [[-2.2, -1.6, 1.1], [1.9, -2, 0.9], [2.5, 1, 0.7], [-2.6, 1.3, 0.6]]) { const r = bigRock(s, STONE_D); r.position.set(x, 0.3 + s * 0.45, z); g.add(r); }\n    const stack = G('', 0, 0.3, 0);\n    let y = 0;\n    for (const [r, hh] of [[0.5, 0.17], [0.42, 0.15], [0.34, 0.13], [0.26, 0.11], [0.18, 0.09]]) { stack.add(M(geo.sphere(r, 12, 8), STONE_D, 0, y + hh, 0, { scale: [1, hh / r, 1] })); y += hh * 2; }\n    g.add(stack);\n    this.spot('quarry', g);\n  }\n  yard() {\n    const g = G();\n    add(g, M(geo.disc(4.4, 36), 0xE6CDA0, 0, 0.022, 0, { shadow: false }));\n    for (const [x, z, r] of [[-2.2, 1.6, 0.2], [-2.2, 2.1, 0.2], [-2.2, 1.85, 0.19], [2.4, 2, 0.22]]) add(g, M(geo.cyl(r, r, 2.8, 12), WOOD_D, x, r + (z === 1.85 ? 0.32 : 0.02), z, { rot: [0, 0, Math.PI / 2] }));\n    add(g, post(2.4, 0.12, WOOD_D, -3.2, 0, -1.2), post(2.4, 0.12, WOOD_D, 3.2, 0, -1.2), M(geo.cyl(0.1, 0.1, 6.6, 10), WOOD, 0, 2.3, -1.2, { rot: [0, 0, Math.PI / 2] }));\n    this.spot('yard', g);\n  }\n  bandstand() {\n    const g = G();\n    add(g, M(geo.cyl(4.2, 4.5, 0.5, 8), CREAM, 0, 0.25, 0), M(geo.cyl(4.05, 4.05, 0.05, 8), TEAK, 0, 0.52, 0));\n    for (let i = 0; i < 8; i++) { const a = (i / 8) * Math.PI * 2 + Math.PI / 8; add(g, post(3.1, 0.09, CREAM, Math.cos(a) * 3.8, 0.5, Math.sin(a) * 3.8)); }\n    const roof = pavilionRoof(4.6, TEAL, ORANGE);\n    roof.position.y = 3.6;\n    g.add(roof);\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * Math.PI * 2 + Math.PI / 8, b = ((i + 1) / 8) * Math.PI * 2 + Math.PI / 8;\n      g.add(bunting(Math.cos(a) * 3.8, 3.4, Math.sin(a) * 3.8, Math.cos(b) * 3.8, 3.4, Math.sin(b) * 3.8, 5));\n    }\n    this.spot('bandstand', g);\n  }\n  boardwalk() {\n    const g = G();\n    add(g, post(3, 0.12, TEAL, -1.1, 0, 0), post(3, 0.12, TEAL, 1.1, 0, 0), M(geo.box(2.8, 0.3, 0.3), ORANGE, 0, 3.05, 0));\n    const sign = signBoard('ROOM SERVICE', 2.2, 0.5); sign.position.set(0, 2.55, 0.17); g.add(sign);\n    g.rotation.y = -Math.PI / 2 - 0.15;\n    this.spot('boardwalk', g);\n    const walk = G('', 24, 0, 3.8);\n    const deck = planks(9, 1.7, { along: 'z', top: -0.02 });\n    walk.add(deck);\n    for (let i = 0; i < 5; i++) add(walk, post(2.6, 0.08, WOOD_D, -4 + i * 2, -2.7, 0.9), post(2.6, 0.08, WOOD_D, -4 + i * 2, -2.7, -0.9));\n    walk.rotation.y = -0.15;\n    this.group.add(walk);\n  }\n  pier() {\n    const g = G();\n    const dir = Math.atan2(12, 15);\n    const pier = G();\n    pier.rotation.y = -dir;\n    pier.position.set(0, 0, 0);\n    const deck = planks(19, 3.2, { along: 'z', top: -0.02 });\n    deck.position.x = 9.5;\n    pier.add(deck);\n    for (let i = 0; i < 6; i++) add(pier, post(5, 0.11, WOOD_D, 4 + i * 3, -5, 1.45), post(5, 0.11, WOOD_D, 4 + i * 3, -5, -1.45));\n    // The toy-block dive tower at its end.\n    const tower = G('', 17, 0, 0);\n    let y = 0;\n    for (let i = 0; i < 5; i++) { add(tower, M(geo.box(2, 1, 2), [RED, 0xF5B700, TEAL, CREAM, BLUE][i], 0, y + 0.5, 0)); y += 1; }\n    add(tower, M(geo.box(2.8, 0.08, 0.5), CREAM, 1.8, y + 0.04, 0));\n    pier.add(tower);\n    add(pier, M(geo