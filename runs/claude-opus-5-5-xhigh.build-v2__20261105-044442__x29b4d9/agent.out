-3\npython3 - <<'EOF'\np='src/data/dialogue.js'\ns=open(p).read()\ns=s.replace(\"watch: ['Oh, well done, dear.', 'I saw that. Lovely.', 'Careful, dear. I say that to everyone.'] },\",\"watch: ['Oh, well done, dear.', 'I saw that. Lovely.', 'Careful, dear. I say that to everyone.', 'My late husband leaned like that. He is not late, he is just slow.'] },\")\ns=s.replace(\"watch: ['Good stride.', 'Not bad. For someone who is not retired.', 'Hm.'] },\",\"watch: ['Good stride.', 'Not bad. For someone who is not retired.', 'Hm.', 'I saw your form. Keep it. I retired mine.'] },\")\ns=s.replace(\"watch: ['Oh! Yes!', 'We saw that.', 'We both saw that.'] },\",\"watch: ['Oh! Yes!', 'We saw that.', 'We both saw that.', 'We would have done it the same way. Both of us.'] },\")\ns=s.replace(\"watch: ['Woah. Me too.', 'I felt that from here.', 'Oh, I know that one.'] },\",\"watch: ['Woah. Me too.', 'I felt that from here.', 'Oh, I know that one.', 'You make it look easy. It is not. I checked.'] },\")\ns=s.replace(\"'Very good, young man. Or lady. I cannot see that far.'] },\",\"'Very good. Whoever you are. I cannot see that far.', 'I used to do that. Then I stopped. Then I forgot which.'] },\")\nopen(p,'w').write(s)\nEOF\nsed -i \"s/await shot('jar', \\`(() => { const T = window.__TEST__; T.goto('jar', { marbles: 8, notch: true }); })()\\`, 2.4);/await shot('jar', \\`(() => { const T = window.__TEST__; T.goto('jar', { marbles: 8, notch: true }); })()\\`, 2.4);/\" tools/shots.mjs\nnode tools/build.mjs && timeout 590 node tools/shots.mjs title stepClass plates raft grandHold jar stillWater fallen 2>&1 | cut -c1-160 | tail -10; cd notes/shots && uv run --quiet --with pillow python - <<'EOF'\nfrom PIL import Image\nnames=['title','stepClass','plates','raft','grandHold','jar','stillWater','fallen']\nW,H=960,540\nim=Image.new('RGB',(W*2,H*4),'white')\nfor i,n in enumerate(names):\n    a=Image.open(f'{n}.png').convert('RGB').resize((W,H))\n    im.paste(a,((i%2)*W,(i//2)*H))\nim.save('../m4.png')\nEOF","description":"Apply the art pass fixes and re-render the affected scenes","timeout":600000}}}
