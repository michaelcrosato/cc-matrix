 = { ...s.b.params, I: s.b.body.mass && s.b.body.mass(), com: s.b.body.localCom && s.b.body.localCom() };\n  // Brace at 3.5 and 3: stick, lead time, and which way.\n  o.brace = {};\n  for (const n of [3, 3.5]) for (const lead of [0.5, 0.6, 0.75, 1]) for (const st of [0.6, 0.7]) {\n    const q = into(); T.stick(-(0.08 + st * 0.92), 0); T.advance(lead);\n    const lean0 = q.b.leanX * 57.3; let top = 0, fell = false, left = 0.5;\n    for (let t = 0; t < 3; t += STEP) { if (left > 0) { q.b.extX += n; left -= STEP; } T.advance(STEP); if (q.l.fallen) fell = true; else top = Math.max(top, q.b.leanX); }\n    T.stick(0, 0); o.brace[`${n} lead ${lead} stick ${st}`] = `from ${lean0.toFixed(0)} peak ${(top * 57.3).toFixed(1)}${fell ? ' FELL' : ''}`;\n  }\n  T.resetTuning(); T.goto('menu'); return o;\n});\nconsole.log(JSON.stringify(out.slam)); console.log(JSON.stringify(out.params)); for (const k of Object.keys(out.brace)) console.log(k.padEnd(28), out.brace[k]);\nconst tray = (o) => p.evaluate((o) => {\n  const T = window.__TEST__, g = T.game; g.save.settings.autoBreathe = false; T.setSeed(o.seed);\n  const real = T.EVENT_CLASSES.roomService.prototype.addTumblers;\n  T.EVENT_CLASSES.roomService.prototype.addTumblers = function (lane) { this.spread = o.spread; this.sideRate = o.rate; return real.call(this, lane); };\n  T.startEvent('roomService', o.tier, {});\n  T.EVENT_CLASSES.roomService.prototype.addTumblers = real;\n  const ev = g.currentEvent, l = ev.lanes[0]; ev.cfg = { ...ev.cfg, gary: false }; l.braceK = o.brace; T.bot(o.skill);\n  let t = 0; while (t < 90 && !ev.isDone()) { T.advance(0.25); t += 0.25; }\n  T.bot(null); const r = l.tumblers.filter((x) => x.on).length; T.goto('menu'); return r;\n}, o);\nawait p.context().close(); p = await logicPage(b);\nfor (const [rate, spread] of [[70, 1], [70, 1.2], [70, 1.4], [70, 1.6], [50, 1.4], [50, 1.6], [90, 1.2], [90, 1.4]]) {\n  const line = [];\n  for (const [tier, brace, plan] of [[0, 0.2, '5/5/5'], [0, 0, '3.5/2.5/4'], [1, 0.2, '3.8/4/4.5'], [1, 0, '0'], [2, 0.2, '2/4/3.5'], [2, 0, '0']]) {\n    const c = []; for (const skill of SK) { let s = 0; for (const seed of [1, 2, 3, 4]) s += await tray({ tier, brace, rate, spread, skill, seed }); c.push((s / 4).toFixed(1)); }\n    line.push(`T${tier + 1}b${brace} ${c.join('/')} [${plan}]`);\n  }\n  console.log(`rate ${rate} spread ${spread} | ${line.join(' | ')}`);\n}\nawait b.close();\nEOF\nfor i in $(seq 1 60); do a=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo); [ \"$a\" -ge 3 ] && break; sleep 10; done; timeout 480 node notes/scratch/core.mjs 2>&1 | cut -c1-260","description":"Apply bot latency, sweep core edge cases and tray layout","timeout":595000}},"wire_ingest_context":{"toolu_01L9JYzsg4JZTxia49AqHN3X":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-044442__x29b4d9/work/WeFib-WiiFit-claude-opus-5-5-xhigh-20261105-044442"}}}
