{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjkGwStF7DQyoBx2k1dv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ji7qrpbxnmzCzQSt4A9w5g","name":"Bash","input":{"command":"cat > src/ui/ui.css <<'EOF'\n:root { --ink: #1A1420; --paper: #FFF4DC; --paper2: #FBE7BF; --wood: #C78B4A; --wood2: #A86F36; --teal: #2CB5A0; --coral: #E8644A; --gold: #F5B700; --s: 1; }\nhtml { font-size: calc(100vh / 108 * var(--s)); }\nhtml, body { margin: 0; height: 100%; background: #111; overflow: hidden; font-family: Fredoka, 'Arial Rounded MT Bold', system-ui, sans-serif; font-weight: 500; color: var(--ink); -webkit-font-smoothing: antialiased; user-select: none; -webkit-user-select: none; touch-action: manipulation; }\nbody.hide-cursor, body.hide-cursor * { cursor: none !important; }\ncanvas { position: fixed; inset: 0; width: 100% !important; height: 100% !important; display: block; }\n#ui { position: fixed; inset: 0; pointer-events: none; font-size: 3.6rem; line-height: 1.15; }\n#ui * { box-sizing: border-box; }\n.layer { position: absolute; inset: 0; }\n.screen { position: absolute; inset: 0; padding: 5.4rem 9.6rem; display: flex; flex-direction: column; align-items: center; pointer-events: none; }\n.screen.dim { background: rgba(26, 20, 32, 0.55); }\n.screen.left { align-items: flex-start; }\n.h1 { font-size: 8.4rem; font-weight: 700; color: var(--paper); text-shadow: 0.3rem 0.4rem 0 var(--ink), -0.2rem -0.2rem 0 var(--ink), 0.2rem -0.2rem 0 var(--ink), -0.2rem 0.3rem 0 var(--ink); text-align: center; margin: 0 0 2rem; }\n.h2 { font-size: 5.6rem; font-weight: 600; margin: 0 0 1.6rem; color: var(--paper); text-shadow: 0.25rem 0.3rem 0 var(--ink), -0.15rem -0.15rem 0 var(--ink), 0.15rem -0.15rem 0 var(--ink), -0.15rem 0.2rem 0 var(--ink); text-align: center; }\n.tag { background: var(--paper); border: 0.5rem solid var(--ink); border-radius: 1.6rem; padding: 1.2rem 2.4rem; box-shadow: 0.5rem 0.6rem 0 var(--ink); }\n.sign { background: linear-gradient(180deg, var(--wood) 0%, var(--wood2) 100%); color: var(--paper); border: 0.5rem solid var(--ink); border-radius: 1.2rem; padding: 1.2rem 3rem; box-shadow: 0.5rem 0.6rem 0 var(--ink); text-shadow: 0.2rem 0.2rem 0 var(--ink); }\n.item { pointer-events: auto; cursor: pointer; background: var(--paper); border: 0.5rem solid var(--ink); border-radius: 1.6rem; padding: 1.1rem 3rem; box-shadow: 0.5rem 0.6rem 0 var(--ink); transition: background 0.08s; font-size: 4rem; text-align: center; min-width: 30rem; position: relative; }\n.item.focus { background: var(--gold); border-width: 0.8rem; box-shadow: 0.7rem 0.8rem 0 var(--ink); animation: bounce 0.7s ease-in-out infinite; z-index: 2; }\n.item.locked { background: #CFC6B4; color: #5A5166; }\n@keyframes bounce { 0%, 100% { transform: translateY(0) rotate(var(--r, 0deg)) scale(1.05); } 50% { transform: translateY(-0.7rem) rotate(var(--r, 0deg)) scale(1.07); } }\n.item:not(.focus) { transform: rotate(var(--r, 0deg)); }\n.col { display: flex; flex-direction: column; gap: 1.8rem; align-items: center; }\n.row { display: flex; flex-direction: row; gap: 2.4rem; align-items: center; justify-content: center; flex-wrap: wrap; }\n.grow { flex: 1; }\n.big { font-size: 5rem; }\n.small { font-size: 3rem; }\n.muted { opacity: 0.8; }\n.prompts { position: absolute; left: 5.4rem; right: 5.4rem; bottom: 4.2rem; display: flex; gap: 3.2rem; justify-content: center; align-items: center; flex-wrap: wrap; pointer-events: none; }\n.prompt { display: inline-flex; align-items: center; gap: 0.8rem; background: rgba(255, 244, 220, 0.94); border: 0.4rem solid var(--ink); border-radius: 1.4rem; padding: 0.3rem 1.4rem 0.3rem 0.6rem; font-size: 3rem; }\n.glyph { height: 4.2rem; width: auto; vertical-align: middle; flex: none; }\n.pager { position: absolute; top: 4.2rem; right: 5.4rem; display: flex; align-items: center; gap: 1.2rem; pointer-events: auto; }\n.pager button { pointer-events: auto; cursor: pointer; font: inherit; font-size: 3.6rem; width: 7rem; height: 6.4rem; background: var(--paper); border: 0.4rem solid var(--ink); border-radius: 1.2rem; box-shadow: 0.3rem 0.4rem 0 var(--ink); color: var(--ink); }\n.pager span { background: var(--paper); border: 0.4rem solid var(--ink); border-radius: 1.2rem; padding: 0.5rem 1.6rem; font-size: 3rem; }\n.slider { display: flex; align-items: center; gap: 2rem; min-width: 80rem; justify-content: space-between; padding: 0.9rem 2.4rem; font-size: 3.4rem; text-align: left; }\n.slider .track { position: relative; width: 36rem; height: 2.6rem; background: #fff; border: 0.4rem solid var(--ink); border-radius: 2rem; flex: none; }\n.slider .fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--teal); border-radius: 1.4rem; }\n.slider .val { min-width: 11rem; text-align: right; font-weight: 600; }\n.toggle { display: flex; align-items: center; gap: 2rem; min-width: 80rem; justify-content: space-between; padding: 0.9rem 2.4rem; font-size: 3.4rem; text-align: left; }\n.toggle .val { font-weight: 600; background: var(--paper2); border: 0.3rem solid var(--ink); border-radius: 1rem; padding: 0.1rem 1.4rem; }\n/* Title */\n.title-beam { position: absolute; top: 8rem; left: 50%; transform-origin: 50% 100%; display: flex; align-items: flex-end; justify-content: center; gap: 0.2rem; padding: 0 3rem 1.2rem; border-bottom: 2.2rem solid var(--wood); box-shadow: 0 0.5rem 0 var(--ink); border-radius: 0 0 1rem 1rem; }\n.title-beam span { display: inline-block; font-size: 15rem; font-weight: 700; color: var(--paper); text-shadow: 0.5rem 0.6rem 0 var(--ink), -0.3rem -0.3rem 0 var(--ink), 0.3rem -0.3rem 0 var(--ink), -0.3rem 0.4rem 0 var(--ink); line-height: 1; }\n.title-sub { position: absolute; top: 31rem; width: 100%; text-align: center; font-size: 4rem; color: var(--paper); text-shadow: 0.2rem 0.25rem 0 var(--ink), -0.1rem -0.1rem 0 var(--ink); }\n.press { position: absolute; bottom: 14rem; left: 50%; transform: translateX(-50%); display: inline-flex; gap: 1.6rem; align-items: center; font-size: 4.6rem; animation: breathe 2s ease-in-out infinite; pointer-events: auto; cursor: pointer; white-space: nowrap; }\n.press .glyph { height: 6rem; }\n@keyframes breathe { 0%, 100% { opacity: 1; } 50% { opacity: 0.72; } }\n.touch-note { position: absolute; bottom: 21rem; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 4.2rem; }\n.demo { position: absolute; top: 4.2rem; left: 50%; transform: translateX(-50%); display: inline-flex; gap: 1.4rem; align-items: center; font-size: 3.4rem; white-space: nowrap; }\n.demo-title { position: absolute; top: 4.2rem; left: 5.4rem; font-size: 5rem; font-weight: 700; color: var(--paper); text-shadow: 0.3rem 0.3rem 0 var(--ink), -0.2rem -0.2rem 0 var(--ink); transform: rotate(-3deg); }\n/* Speech */\n.speech { position: absolute; left: 50%; bottom: 15rem; transform: translateX(-50%) rotate(-0.6deg); width: 134rem; max-width: 80%; min-height: 15rem; background: var(--paper); border: 0.6rem solid var(--ink); border-radius: 2rem; padding: 1.8rem 3rem 1.6rem; box-shadow: 0.6rem 0.8rem 0 var(--ink); font-size: 3.8rem; pointer-events: none; }\n.speech.top { bottom: auto; top: 13rem; }\n.speech .who { position: absolute; top: -3rem; left: 3rem; background: var(--gold); border: 0.45rem solid var(--ink); border-radius: 1rem; padding: 0 1.6rem; font-size: 3.2rem; font-weight: 600; transform: rotate(-2deg); }\n.speech .next { position: absolute; right: 1.6rem; bottom: -2.8rem; }\n.speech .next .prompt { font-size: 3rem; }\n.choices { position: absolute; left: 0; right: 0; bottom: 34rem; display: flex; justify-content: center; gap: 3rem; }\n/* HUD */\n.hud { position: absolute; inset: 0; pointer-events: none; }\n.hud-score { position: absolute; top: 4.2rem; right: 5.4rem; font-size: 7.6rem; font-weight: 700; padding: 0.2rem 2.4rem; min-width: 18rem; text-align: center; transform: rotate(1.2deg); }\n.hud-score small { display: block; font-size: 3rem; font-weight: 500; }\n.hud-time { position: absolute; top: 4.2rem; left: 50%; transform: translateX(-50%) rotate(-0.6deg); font-size: 5.4rem; font-weight: 600; padding: 0 2.4rem; min-width: 14rem; text-align: center; }\n.hud-big { position: absolute; top: 34%; left: 0; right: 0; text-align: center; font-size: 13rem; font-weight: 700; color: var(--paper); text-shadow: 0.6rem 0.7rem 0 var(--ink), -0.3rem -0.3rem 0 var(--ink), 0.3rem -0.3rem 0 var(--ink); }\n.hud-widgets { position: absolute; top: 15rem; left: 5.4rem; display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-start; }\n.hud-widgetsR { position: absolute; top: 19rem; right: 5.4rem; display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-end; }\n.hud-note { position: absolute; top: 12rem; left: 50%; transform: translateX(-50%); font-size: 4rem; white-space: nowrap; }\n.hud-prompts { position: absolute; left: 30rem; right: 5.4rem; bottom: 4.2rem; display: flex; gap: 1.6rem; justify-content: flex-end; flex-wrap: wrap; }\n.discs { position: absolute; left: 5.4rem; bottom: 4.2rem; display: flex; gap: 2rem; align-items: flex-end; }\n.discs.group { left: 0; right: 0; justify-content: center; gap: 5rem; bottom: 1.8rem; }\n.disc { position: relative; width: 23.8rem; height: 23.8rem; }\n.disc.small { width: 15.1rem; height: 15.1rem; }\n.disc svg { width: 100%; height: 100%; overflow: visible; display: block; }\n.disc .breath-word { position: absolute; left: 100%; bottom: 0.6rem; margin-left: 1.4rem; white-space: nowrap; font-size: 3.2rem; padding: 0 1.4rem; }\n.disc .who { position: absolute; top: -3.6rem; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 3rem; font-weight: 600; color: var(--paper); text-shadow: 0.2rem 0.2rem 0 var(--ink), -0.1rem -0.1rem 0 var(--ink); }\n.meter { position: relative; width: 44rem; height: 3.4rem; background: #fff; border: 0.45rem solid var(--ink); border-radius: 2rem; overflow: hidden; }\n.meter .fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--teal); }\n.meter-wrap { display: flex; align-items: center; gap: 1.2rem; font-size: 3.2rem; }\n/* Cards */\n.cards { display: flex; gap: 3rem; justify-content: center; flex-wrap: wrap; }\n.card { width: 40rem; min-height: 40rem; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 1.8rem 1.6rem; font-size: 3.2rem; gap: 1rem; }\n.card .name { font-size: 4.4rem; font-weight: 600; line-height: 1.05; }\n.card .art { width: 100%; height: 15rem; display: flex; align-items: center; justify-content: center; }\n.card .art svg { height: 100%; width: auto; }\n.card.done { background: #E4DCC8; }\n.card.done.focus { background: var(--gold); }\n.stamp { position: absolute; top: 45%; left: 50%; font-size: 5rem; font-weight: 700; color: #C24D6A; border: 0.7rem solid #C24D6A; border-radius: 1.2rem; padding: 0.2rem 1.6rem; transform: translate(-50%, -50%) rotate(-14deg); background: rgba(255, 244, 220, 0.8); white-space: nowrap; }\n/* Intro card */\n.intro { margin-top: 3rem; width: 150rem; max-width: 92%; display: grid; grid-template-columns: 54rem 1fr; gap: 3rem; align-items: center; padding: 2.8rem 3.6rem; transform: rotate(-0.5deg); }\n.intro .diagram svg { width: 100%; height: auto; }\n.intro h2 { margin: 0 0 1rem; font-size: 6.4rem; font-weight: 700; line-height: 1; }\n.intro p { margin: 0 0 1.2rem; font-size: 3.6rem; }\n.intro .cant { color: #A0362E; }\n.intro .who { font-size: 3rem; font-weight: 600; color: #6B5F75; }\n/* Results */\n.medal { width: 40rem; height: 40rem; }\n.results { display: flex; flex-direction: column; align-items: center; gap: 1.4rem; margin-top: 2rem; }\n.bignum { font-size: 15rem; font-weight: 700; color: var(--paper); line-height: 1; text-shadow: 0.7rem 0.8rem 0 var(--ink), -0.3rem -0.3rem 0 var(--ink), 0.3rem -0.3rem 0 var(--ink), -0.3rem 0.4rem 0 var(--ink); }\n.toast { position: absolute; top: 5rem; left: 50%; transform: translateX(-50%) rotate(-1deg); font-size: 3.8rem; white-space: nowrap; animation: pop 0.25s ease-out; }\n@keyframes pop { 0% { transform: translateX(-50%) scale(0.5); } 80% { transform: translateX(-50%) scale(1.08); } 100% { transform: translateX(-50%) scale(1); } }\n.hotlabel { position: absolute; transform: translate(-50%, -130%) rotate(-1deg); font-size: 3.4rem; white-space: nowrap; font-weight: 600; pointer-events: none; }\n.hotlabel .prompt { margin-left: 1rem; border: none; background: none; padding: 0; }\n.audio-tag { position: absolute; top: 4.2rem; left: 5.4rem; font-size: 3rem; }\n/* Reveal */\n.counter { display: flex; gap: 1.2rem; }\n.counter .digit { width: 15rem; height: 22rem; background: linear-gradient(180deg, #D39A5A, #A86F36 50%, #D39A5A); border: 0.7rem solid var(--ink); border-radius: 1.6rem; display: flex; align-items: center; justify-content: center; font-size: 15rem; font-weight: 700; color: var(--paper); text-shadow: 0.4rem 0.5rem 0 var(--ink); box-shadow: 0.6rem 0.8rem 0 var(--ink); }\n/* Journal */\n.calendar { display: grid; grid-template-columns: repeat(7, 15rem); gap: 1.4rem; }\n.calendar .day { height: 12rem; background: var(--paper); border: 0.4rem solid var(--ink); border-radius: 1rem; position: relative; font-size: 3rem; padding: 0.4rem 1rem; }\n.calendar .day b { position: absolute; left: 50%; top: 55%; transform: translate(-50%, -50%) rotate(-12deg); color: #C24D6A; border: 0.4rem solid #C24D6A; border-radius: 0.8rem; padding: 0 0.6rem; font-size: 3rem; }\n.shelf { display: grid; grid-template-columns: repeat(4, 34rem); gap: 1.6rem; }\n.shelf .m { display: flex; flex-direction: column; align-items: center; font-size: 3rem; text-align: center; padding: 0.8rem 0.4rem; }\n.shelf .m svg { width: 8rem; height: 8rem; }\n.totals { display: flex; flex-direction: column; gap: 1.6rem; font-size: 4.8rem; }\n.graph svg { width: 120rem; height: 46rem; }\n/* About */\n.about { width: 160rem; max-width: 100%; padding: 2rem 3.4rem; font-size: 3rem; line-height: 1.16; max-height: 76rem; overflow: hidden; }\n.about h3 { font-size: 3.6rem; margin: 0.4rem 0 1rem; }\n.about p { margin: 0 0 0.8rem; font-size: 3rem; }\n.about b { font-weight: 600; }\n/* Group */\n.mats { display: flex; gap: 2.6rem; justify-content: center; }\n.mat { width: 36rem; height: 32rem; border: 0.6rem solid var(--ink); border-radius: 2rem; background: var(--paper); display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 3.2rem; gap: 1rem; box-shadow: 0.5rem 0.6rem 0 var(--ink); text-align: center; padding: 1rem; }\n.podium-line { font-size: 4.4rem; }\n/* Dev */\n.dev-panel { width: 160rem; display: flex; flex-direction: column; align-items: center; gap: 1.4rem; }\n.dev-panel .item { min-width: 90rem; font-size: 3.4rem; padding: 0.6rem 2rem; }\n.dev-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem 2.4rem; }\n.dev-grid .item { min-width: 62rem; }\n.stats { position: absolute; left: 5.4rem; top: 4.2rem; font-size: 3rem; background: rgba(255,244,220,.92); border: 0.4rem solid var(--ink); border-radius: 1rem; padding: 0.4rem 1.2rem; white-space: pre; line-height: 1.12; z-index: 5; }\n.bigtext { white-space: pre-wrap; font-size: 3rem; width: 150rem; height: 66rem; overflow: hidden; }\n.boot { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--ink); color: var(--paper); font-size: 5rem; gap: 2rem; }\n.card-session { position: absolute; left: 5.4rem; right: 5.4rem; top: 4.2rem; display: flex; flex-direction: column; align-items: center; gap: 1.4rem; }\n.seat { display: inline-flex; align-items: center; gap: 1rem; font-size: 3.6rem; font-weight: 600; color: var(--ink); background: var(--paper); border: 0.4rem solid var(--ink); border-radius: 1.2rem; padding: 0.3rem 1.6rem; }\n.seat i { display: inline-block; width: 3rem; height: 3rem; border-radius: 50%; border: 0.35rem solid var(--ink); }\nEOF\ncat > src/ui/ui.js <<'EOF'\nimport { h, rotJitter } from './dom.js';\nimport { promptHTML } from '../input/glyphs.js';\n\n/** A screen: a DOM layer with focusable items. Hover moves focus; pad, keys and mouse all work. */\nexport class Screen {\n  constructor(ui, def) {\n    this.ui = ui; this.def = def; this.name = def.name;\n    this.el = h(`div.screen${def.className ? `.${def.className}` : ''}`);\n    this.el.dataset.screen = def.name;\n    this.items = []; this.focus = -1; this.promptList = def.prompts || null;\n    this.page = 0; this.pages = 0; this.onPage = null;\n    this.onBack = def.back || null; this.onAlt = def.alt || null;\n    this.promptEl = null; this.updateFn = def.update || null;\n    this.passive = !!def.passive;\n  }\n  /** Register a focusable. handlers: use, left, right, focus. */\n  item(el, handlers = {}) {\n    const it = { el, ...handlers, index: this.items.length };\n    el.classList.add('item');\n    el.style.setProperty('--r', `${rotJitter(this.items.length)}deg`);\n    el.addEventListener('pointermove', (e) => {\n      if (e.pointerType === 'touch') return;\n      const inp = this.ui.game.input;\n      if (e.clientX === inp.lastHoverX && e.clientY === inp.lastHoverY) return;\n      inp.lastHoverX = e.clientX; inp.lastHoverY = e.clientY;\n      const i = this.items.indexOf(it);\n      if (i >= 0 && i !== this.focus && !this.ui.inert) this.setFocus(i);\n    });\n    el.addEventListener('click', (e) => {\n      if (this.ui.top !== this) return;\n      e.stopPropagation();\n      this.ui.game.input.clickQueue.push(() => { const i = this.items.indexOf(it); if (i >= 0) { this.setFocus(i, true); this.use(i); } });\n    });\n    this.items.push(it);\n    return el;\n  }\n  clearItems() { this.items = []; this.focus = -1; }\n  setFocus(i, silent) {\n    if (this.items[this.focus]) this.items[this.focus].el.classList.remove('focus');\n    this.focus = i;\n    const it = this.items[i];\n    if (it) { it.el.classList.add('focus'); if (it.focusFn) it.focusFn(); }\n    if (!silent) this.ui.game.audio.sfx('uiMove');\n  }\n  use(i = this.focus) {\n    const it = this.items[i];\n    if (it && it.use) { this.ui.game.audio.sfx(it.silent ? 'uiMove' : 'uiConfirm'); it.use(); }\n  }\n  move(dir) {\n    if (!this.items.length) return false;\n    if (this.focus < 0) { this.setFocus(0); return true; }\n    const cur = this.items[this.focus].el.getBoundingClientRect();\n    const cx = cur.left + cur.width / 2, cy = cur.top + cur.height / 2;\n    let best = -1, score = 1e9;\n    this.items.forEach((it, i) => {\n      if (i === this.focus) return;\n      const r = it.el.getBoundingClientRect();\n      const x = r.left + r.width / 2 - cx, y = r.top + r.height / 2 - cy;\n      let along, off;\n      if (dir === 'up') { along = -y; off = Math.abs(x); } else if (dir === 'down') { along = y; off = Math.abs(x); } else if (dir === 'left') { along = -x; off = Math.abs(y); } else { along = x; off = Math.abs(y); }\n      if (along <= 1) return;\n      const s = along + off * 2.2;\n      if (s < score) { score = s; best = i; }\n    });\n    if (best >= 0) { this.setFocus(best); return true; }\n    return false;\n  }\n  /** A page switcher: not counted among a screen's choices. */\n  pager(n, onPage, start = 0) {\n    this.pages = n; this.page = start; this.onPage = onPage;\n    const label = h('span');\n    const prev = h('button', { 'data-pager': '1', onclick: (e) => { e.stopPropagation(); this.ui.game.input.clickQueue.push(() => this.turn(-1)); } }, '◄');\n    const next = h('button', { 'data-pager': '1', onclick: (e) => { e.stopPropagation(); this.ui.game.input.clickQueue.push(() => this.turn(1)); } }, '►');\n    const el = h('div.pager', prev, label, next);\n    this.pagerLabel = label;\n    this.el.append(el);\n    this._label();\n    return el;\n  }\n  _label() { if (this.pagerLabel) this.pagerLabel.textContent = `${this.page + 1} / ${this.pages}`; }\n  turn(d) {\n    if (this.pages < 2) return false;\n    this.page = (this.page + d + this.pages) % this.pages;\n    this._label();\n    if (this.onPage) this.onPage(this.page);\n    this.ui.game.audio.sfx('uiMove');\n    return true;\n  }\n  setPrompts(list) { this.promptList = list; this._renderPrompts(); }\n  _renderPrompts() {\n    if (!this.promptList) { if (this.promptEl) this.promptEl.innerHTML = ''; return; }\n    if (!this.promptEl) { this.promptEl = h('div.prompts'); this.el.append(this.promptEl); }\n    const { input, save } = this.ui.game;\n    this.promptEl.innerHTML = this.promptList.map(([v, t]) => promptHTML(v, t, input.lastDevice, save.settings.glyphs)).join('');\n  }\n}\n\nexport class UI {\n  constructor(game, root) {\n    this.game = game; this.root = root;\n    this.stack = []; this.inert = false;\n    this.layer = h('div.layer'); root.append(this.layer);\n    this.lastDevice = null; this.lastGlyphs = null;\n    this.toastEl = null; this.toastT = 0;\n    this.deviceListeners = new Set();\n  }\n  get top() { return this.stack[this.stack.length - 1] || null; }\n  /** Open a screen on top. def: { name, className, build(screen), back, alt, prompts, update, passive }. */\n  open(def) {\n    const s = new Screen(this, def);\n    this.stack.push(s);\n    this.layer.append(s.el);\n    if (def.build) def.build(s);\n    s._renderPrompts();\n    if (s.items.length && s.focus < 0) s.setFocus(def.focus ?? 0, true);\n    return s;\n  }\n  /** Replace everything with one screen. */\n  only(def) { this.clear(); return this.open(def); }\n  close(s = this.top) {\n    if (!s) return;\n    const i = this.stack.indexOf(s);\n    if (i >= 0) this.stack.splice(i, 1);\n    s.el.remove();\n    if (s.def.onClose) s.def.onClose();\n  }\n  clear() { while (this.stack.length) this.close(this.stack[this.stack.length - 1]); }\n  has(name) { return this.stack.some((s) => s.name === name); }\n  toast(text, sec = 2.6) {\n    if (this.toastEl) this.toastEl.remove();\n    this.toastEl = h('div.toast.tag', text);\n    this.root.append(this.toastEl);\n    this.toastT = sec;\n  }\n  fixed(dt) {\n    const input = this.game.input;\n    const queue = input.clickQueue;\n    if (queue.length) { input.clickQueue = []; if (!this.inert) for (const f of queue) f(); }\n    const s = this.top;\n    if (!s || s.passive || this.inert) return;\n    if (input.verb('up')) this._dir(s, 'up');\n    if (input.verb('down')) this._dir(s, 'down');\n    if (input.verb('left')) this._dir(s, 'left');\n    if (input.verb('right')) this._dir(s, 'right');\n    if (input.verb('pageL')) s.turn(-1);\n    if (input.verb('pageR')) s.turn(1);\n    if (input.verb('confirm')) s.use();\n    if (input.verb('back') || input.verb('rightclick')) {\n      if (s.onBack) { this.game.audio.sfx('uiBack'); s.onBack(); }\n    }\n    if (input.verb('alt') && s.onAlt) s.onAlt();\n  }\n  _dir(s, dir) {\n    const it = s.items[s.focus];\n    if (it) {\n      if (dir === 'left' && it.left) { it.left(); return; }\n      if (dir === 'right' && it.right) { it.right(); return; }\n    }\n    const moved = s.move(dir);\n    if (!moved && (dir === 'left' || dir === 'right')) s.turn(dir === 'left' ? -1 : 1);\n    if (s.def.onDir) s.def.onDir(dir, moved);\n  }\n  frame(dt) {\n    const { input, save } = this.game;\n    if (input.lastDevice !== this.lastDevice || save.settings.glyphs !== this.lastGlyphs) {\n      this.lastDevice = input.lastDevice; this.lastGlyphs = save.settings.glyphs;\n      for (const s of this.stack) s._renderPrompts();\n      for (const f of this.deviceListeners) f();\n    }\n    for (const s of this.stack) if (s.updateFn) s.updateFn(dt, s);\n    if (this.toastEl) { this.toastT -= dt; if (this.toastT <= 0) { this.toastEl.remove(); this.toastEl = null; } }\n  }\n  /** A left/right value control, dragged with the mouse. */\n  slider(s, label, get, set, { min = 0, max = 100, step = 5, format = (v) => String(Math.round(v)), onChange = null } = {}) {\n    const fill = h('div.fill'), track = h('div.track', fill), val = h('div.val');\n    const el = h('div.slider', h('span', label), track, val);\n    const render = () => {\n      const v = get();\n      fill.style.width = `${(100 * (v - min)) / (max - min)}%`;\n      val.textContent = format(v);\n    };\n    const put = (v) => {\n      const q = Math.round((Math.max(min, Math.min(max, v)) - min) / step) * step + min;\n      set(+q.toFixed(5));\n      render();\n      if (onChange) onChange();\n    };\n    let dragging = false;\n    const dragTo = (e) => { const r = track.getBoundingClientRect(); put(min + ((e.clientX - r.left) / r.width) * (max - min)); };\n    track.style.pointerEvents = 'auto';\n    track.addEventListener('pointerdown', (e) => { dragging = true; dragTo(e); e.stopPropagation(); if (track.setPointerCapture) { try { track.setPointerCapture(e.pointerId); } catch (x) { /* synthetic pointers have no capture */ } } });\n    track.addEventListener('pointermove', (e) => { if (dragging) dragTo(e); });\n    track.addEventListener('pointerup', () => { dragging = false; });\n    render();\n    s.item(el, { left: () => { put(get() - step); this.game.audio.sfx('uiMove'); }, right: () => { put(get() + step); this.game.audio.sfx('uiMove'); }, render, silent: true });\n    return el;\n  }\n  /** Cycle through named options with left, right or use. */\n  choice(s, label, options, get, set) {\n    const val = h('span.val');\n    const el = h('div.toggle', h('span', label), val);\n    const idx = () => Math.max(0, options.findIndex((o) => o[0] === get()));\n    const render = () => { val.textContent = options[idx()][1]; };\n    const shift = (d) => { set(options[(idx() + d + options.length) % options.length][0]); render(); this.game.audio.sfx('uiMove'); };\n    render();\n    s.item(el, { left: () => shift(-1), right: () => shift(1), use: () => shift(1), silent: true });\n    return el;\n  }\n}\nEOF\ncat > src/ui/speech.js <<'EOF'\nimport { h } from './dom.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { VOICES } from '../audio/voice.js';\n\nexport const SPEAKERS = {\n  trudy: { name: 'Trudy', voice: 'trudy' }, stillwater: { name: 'Ms. Stillwater', voice: 'stillwater' },\n  bolster: { name: 'Coach Bolster', voice: 'bolster' }, margaret: { name: 'Gentle Margaret', voice: 'margaret' },\n  kevin: { name: 'Retired Kevin', voice: 'kevin' }, sandras: { name: 'Both Sandras', voice: 'sandras' },\n  paul: { name: 'Unsteady Paul', voice: 'paul' }, gerald: { name: 'Young Gerald', voice: 'gerald' },\n  gary: { name: 'Gary', voice: null },\n};\n\n/** A paper speech tag in the lower third. Text types out in time with the voice. Every word is on screen. */\nexport class Speech {\n  constructor(game, root) {\n    this.game = game;\n    this.el = h('div.speech'); this.el.style.display = 'none';\n    this.who = h('div.who'); this.text = h('div.text'); this.next = h('div.next');\n    this.el.append(this.who, this.text, this.next);\n    root.append(this.el);\n    this.line = null; this.t = 0; this.left = 0; this.shown = 0; this.history = [];\n  }\n  /** blocking: Use advances. auto: seconds until it clears by itself. */\n  say(who, text, { auto = 0, top = false } = {}) {\n    const sp = SPEAKERS[who] || { name: who, voice: null };\n    this.line = { who, text, auto, cps: this._cps(sp), done: false, finished: false };\n    this.who.textContent = sp.name;\n    this.text.textContent = '';\n    this.shown = 0; this.t = 0;\n    this.el.style.display = '';\n    this.el.classList.toggle('top', !!top);\n    this.next.innerHTML = '';\n    this.history.push({ who, text });\n    if (this.history.length > 40) this.history.shift();\n    if (sp.voice) this.game.audio.say(sp.voice, text);\n    else if (who === 'gary') this.game.audio.sfx('squawk');\n    return this.line;\n  }\n  _cps(sp) {\n    const v = VOICES[sp.voice];\n    if (!v) return 30;\n    return Math.min(46, v.rate * 2.7);\n  }\n  get active() { return !!this.line; }\n  clear() {\n    this.line = null;\n    this.el.style.display = 'none';\n    this.game.audio.stopVoice();\n  }\n  /** Use: finish typing, or move on. */\n  advance() {\n    const l = this.line;\n    if (!l) return true;\n    if (!l.finished) { this.t = 1e9; this._type(); return false; }\n    l.done = true;\n    this.clear();\n    return true;\n  }\n  _type() {\n    const l = this.line;\n    const n = Math.min(l.text.length, Math.floor(this.t * l.cps));\n    if (n !== this.shown) { this.shown = n; this.text.textContent = l.text.slice(0, n); }\n    if (n >= l.text.length && !l.finished) {\n      l.finished = true;\n      if (!l.auto) this.next.innerHTML = promptHTML('use', 'Next', this.game.input.lastDevice, this.game.save.settings.glyphs);\n    }\n  }\n  fixed(dt) {\n    const l = this.line;\n    if (!l) return;\n    this.t += dt;\n    this._type();\n    if (l.auto && l.finished) {\n      l.auto -= dt;\n      if (l.auto <= 0) { l.done = true; this.clear(); }\n    }\n  }\n}\nEOF\ncat > src/ui/disc.js <<'EOF'\nimport { h } from './dom.js';\n\nconst NS = 'http://www.w3.org/2000/svg';\nconst el = (name, attrs, parent) => {\n  const e = document.createElementNS(NS, name);\n  for (const k of Object.keys(attrs)) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n};\n\n/** The game's signature HUD: a dial with rings, a target zone, the dot, the asking ring and an inked trail. */\nexport class BalanceDisc {\n  constructor(parent, { small = false, colour = '#1A1420', name = null } = {}) {\n    this.root = h(`div.disc${small ? '.small' : ''}`);\n    parent.append(this.root);\n    const svg = this.svg = document.createElementNS(NS, 'svg');\n    svg.setAttribute('viewBox', '-120 -130 240 250');\n    this.root.append(svg);\n    this.breathRing = el('circle', { r: 112, fill: 'none', stroke: '#6FD6B8', 'stroke-width': 7, opacity: 0 }, svg);\n    el('circle', { r: 100, fill: '#FFF4DC', stroke: '#1A1420', 'stroke-width': 7 }, svg);\n    el('circle', { r: 66, fill: '#F8E4BA', stroke: '#C9B48A', 'stroke-width': 2.5 }, svg);\n    el('circle', { r: 33, fill: '#FFF4DC', stroke: '#C9B48A', 'stroke-width': 2.5 }, svg);\n    el('path', { d: 'M-100 0H100M0 -100V100', stroke: '#C9B48A', 'stroke-width': 2.5 }, svg);\n    this.brace = el('path', { d: '', fill: '#61C964', opacity: 0, stroke: '#1A1420', 'stroke-width': 3 }, svg);\n    this.zone = el('circle', { r: 30, fill: '#9BE08F', 'fill-opacity': 0.55, stroke: '#2F8F46', 'stroke-width': 5, opacity: 0 }, svg);\n    this.trail = el('polyline', { fill: 'none', stroke: '#1A1420', 'stroke-width': 3.5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', points: '', opacity: 0.55 }, svg);\n    this.ask = el('circle', { r: 12, fill: 'none', stroke: '#1A1420', 'stroke-width': 3.5, 'stroke-dasharray': '6 4', opacity: 0.8 }, svg);\n    this.dot = el('circle', { r: 11, fill: colour, stroke: '#1A1420', 'stroke-width': 4 }, svg);\n    // Trudy peeks over the rim.\n    this.peek = el('g', { transform: 'translate(0,-104)' }, svg);\n    el('rect', { x: -32, y: -17, width: 64, height: 26, rx: 8, fill: '#F5B700', stroke: '#1A1420', 'stroke-width': 4 }, this.peek);\n    el('rect', { x: -18, y: -12, width: 36, height: 13, rx: 6.5, fill: '#B9F26B', stroke: '#1A1420', 'stroke-width': 2.5 }, this.peek);\n    this.peekBubble = el('circle', { r: 5.5, cy: -5.5, fill: '#fff', stroke: '#1A1420', 'stroke-width': 2 }, this.peek);\n    this.peekPupil = el('circle', { r: 2.2, cy: -5.5, fill: '#1A1420' }, this.peek);\n    this.word = null;\n    if (name) this.root.append(h('div.who', name));\n    this.hist = [];\n    this.small = small;\n  }\n  addBreathWord() { this.word = h('div.breath-word.tag', 'Breathe'); this.word.style.display = 'none'; this.root.append(this.word); return this.word; }\n  /** dx, dz: the dot. ax, az: where the input asks. zone: {x, z, r, on} or null. */\n  update(d) {\n    const x = d.dx * 100, y = d.dz * 100;\n    this.dot.setAttribute('cx', x.toFixed(1)); this.dot.setAttribute('cy', y.toFixed(1));\n    this.ask.setAttribute('cx', (d.ax * 100).toFixed(1)); this.ask.setAttribute('cy', (d.az * 100).toFixed(1));\n    this.ask.setAttribute('opacity', d.showAsk === false ? 0 : 0.85);\n    const h2 = this.hist;\n    h2.push(x.toFixed(1), y.toFixed(1));\n    if (h2.length > 60) h2.splice(0, 2);\n    if (d.frame % 2 === 0) {\n      let s = '';\n      for (let i = 0; i < h2.length; i += 2) s += `${h2[i]},${h2[i + 1]} `;\n      this.trail.setAttribute('points', s);\n    }\n    if (d.zone) {\n      this.zone.setAttribute('opacity', 1);\n      this.zone.setAttribute('cx', (d.zone.x * 100).toFixed(1)); this.zone.setAttribute('cy', (d.zone.z * 100).toFixed(1));\n      this.zone.setAttribute('r', (d.zone.r * 100).toFixed(1));\n      this.zone.setAttribute('fill', d.zone.on ? '#61C964' : '#FFD27A');\n      this.zone.setAttribute('stroke', d.zone.on ? '#2F8F46' : '#B5762C');\n    } else this.zone.setAttribute('opacity', 0);\n    if (d.brace) {\n      // A green wedge shows where to lean before a gust lands.\n      const a = Math.atan2(d.brace.z, d.brace.x), w = 0.55, r = 96, r0 = 30;\n      const p = (ang, rr) => `${(Math.cos(ang) * rr).toFixed(1)} ${(Math.sin(ang) * rr).toFixed(1)}`;\n      this.brace.setAttribute('d', `M${p(a - w, r0)}L${p(a - w, r)}A${r} ${r} 0 0 1 ${p(a + w, r)}L${p(a + w, r0)}A${r0} ${r0} 0 0 0 ${p(a - w, r0)}Z`);\n      this.brace.setAttribute('opacity', 0.75);\n    } else this.brace.setAttribute('opacity', 0);\n    if (d.breath) {\n      const rr = 104 + d.breath.size * 14;\n      this.breathRing.setAttribute('r', rr.toFixed(1));\n      this.breathRing.setAttribute('opacity', 0.95);\n      this.breathRing.setAttribute('stroke', d.breath.inSync ? '#37B24D' : '#7FB4E8');\n      if (this.word) {\n        this.word.style.display = '';\n        const w = d.breath.growing ? 'Breathe in' : 'Breathe out';\n        if (this.word.textContent !== w) this.word.textContent = w;\n      }\n    } else {\n      this.breathRing.setAttribute('opacity', 0);\n      if (this.word) this.word.style.display = 'none';\n    }\n    const bx = Math.max(-12, Math.min(12, (d.dx * 16))).toFixed(1);\n    this.peekBubble.setAttribute('cx', bx); this.peekPupil.setAttribute('cx', bx);\n    this.peek.setAttribute('transform', `translate(0,${d.alarm ? -112 : -104}) rotate(${(d.dx * 8).toFixed(1)})`);\n  }\n  remove() { this.root.remove(); }\n}\nEOF\ncat > src/ui/hud.js <<'EOF'\nimport { h } from './dom.js';\nimport { BalanceDisc } from './disc.js';\nimport { promptHTML } from '../input/glyphs.js';\n\n/** Disc bottom left, one big score top right, time top centre, event widgets, this event's verbs. */\nexport class HUD {\n  constructor(game, root) {\n    this.game = game;\n    this.el = h('div.hud'); this.el.style.display = 'none'; root.append(this.el);\n    this.score = h('div.hud-score.tag'); this.time = h('div.hud-time.tag'); this.big = h('div.hud-big');\n    this.widgets = h('div.hud-widgets'); this.widgetsR = h('div.hud-widgetsR'); this.note = h('div.hud-note.tag'); this.promptEl = h('div.hud-prompts');\n    this.discsEl = h('div.discs');\n    this.el.append(this.score, this.time, this.big, this.widgets, this.widgetsR, this.note, this.promptEl, this.discsEl);\n    this.discs = []; this.promptList = []; this.frameN = 0; this.lastDevice = null; this.bigT = 0; this.noteT = 0;\n    this.scoreText = null; this.timeText = null; this.promptDevice = null; this.promptGlyphs = null;\n    this.note.style.display = 'none';\n    this.discsVisible = true;\n  }\n  show(on = true) { this.el.style.display = on ? '' : 'none'; }\n  reset() {\n    for (const d of this.discs) d.disc.remove();\n    this.discs = [];\n    this.widgets.innerHTML = ''; this.widgetsR.innerHTML = '';\n    this.big.textContent = ''; this.note.style.display = 'none';\n    this.setScore('', ''); this.setTime(null); this.setPrompts([]);\n    this.discsEl.classList.remove('group');\n  }\n  /** One disc per lane to show. group: small discs along the bottom edge. */\n  setDiscs(lanes, group = false) {\n    for (const d of this.discs) d.disc.remove();\n    this.discs = [];\n    this.discsEl.classList.toggle('group', group);\n    for (const lane of lanes) {\n      const disc = new BalanceDisc(this.discsEl, { small: group, colour: lane.colour || '#1A1420', name: group ? lane.name : null });\n      disc.addBreathWord();\n      this.discs.push({ lane, disc });\n    }\n  }\n  setScore(v, label = '') {\n    const t = `${v}|${label}`;\n    if (t === this.scoreText) return;\n    this.scoreText = t;\n    this.score.style.display = v === '' ? 'none' : '';\n    this.score.innerHTML = '';\n    this.score.append(document.createTextNode(String(v)));\n    if (label) this.score.append(h('small', label));\n  }\n  setTime(sec) {\n    const t = sec === null ? '' : String(Math.ceil(Math.max(0, sec)));\n    if (t === this.timeText) return;\n    this.timeText = t;\n    this.time.style.display = sec === null ? 'none' : '';\n    this.time.textContent = t;\n  }\n  setPrompts(list) { this.promptList = list; this.promptDevice = null; }\n  flash(text, sec = 0.9) { this.big.textContent = text; this.bigT = sec; }\n  setNote(text, sec = 2) { this.note.textContent = text; this.note.style.display = text ? '' : 'none'; this.noteT = sec; }\n  addWidget(el, right = false) { (right ? this.widgetsR : this.widgets).append(el); return el; }\n  meter(label, colour) {\n    const fill = h('div.fill'); if (colour) fill.style.background = colour;\n    const m = h('div.meter', fill);\n    const el = h('div.meter-wrap', h('span.tag', { style: 'padding:0 1.2rem;font-size:3rem;border-width:.4rem;box-shadow:none' }, label), m);\n    el.set = (v) => { fill.style.width = `${Math.max(0, Math.min(1, v)) * 100}%`; };\n    return el;\n  }\n  frame(dt) {\n    const { input, save } = this.game;\n    if (input.lastDevice !== this.promptDevice || save.settings.glyphs !== this.promptGlyphs) {\n      this.promptDevice = input.lastDevice; this.promptGlyphs = save.settings.glyphs;\n      this.promptEl.innerHTML = this.promptList.map(([v, t]) => promptHTML(v, t, input.lastDevice, save.settings.glyphs)).join('');\n    }\n    if (this.bigT > 0) { this.bigT -= dt; if (this.bigT <= 0) this.big.textContent = ''; }\n    if (this.noteT > 0) { this.noteT -= dt; if (this.noteT <= 0) this.note.style.display = 'none'; }\n    this.frameN++;\n    for (const { lane, disc } of this.discs) {\n      const v = lane.discView;\n      if (v) { v.frame = this.frameN; disc.update(v); }\n    }\n  }\n}\nEOF\n","description":"Write UI framework, CSS, speech, Balance Disc and HUD"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26140,"cache_read_input_tokens":194781,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26140},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"b3cbb806-46e7-4b3b-b7b4-797b32c971c9","timestamp":"2026-11-05T12:04:35.891Z","request_id":"req_011CgjkGvycDMFKWnBcmSA7n","wire_tool_inputs":{"toolu_01Ji7qrpbxnmzCzQSt4A9w5g":{"command":"cat > src/ui/ui.css <<'EOF'\n:root { --ink: #1A1420; --paper: #FFF4DC; --paper2: #FBE7BF; --wood: #C78B4A; --wood2: #A86F36; --teal: #2CB5A0; --coral: #E8644A; --gold: #F5B700; --s: 1; }\nhtml { font-size: calc(100vh / 108 * var(--s)); }\nhtml, body { margin: 0; height: 100%; background: #111; overflow: hidden; font-family: Fredoka, 'Arial Rounded MT Bold', system-ui, sans-serif; font-weight: 500; color: var(--ink); -webkit-font-smoothing: antialiased; user-select: none; -webkit-user-select: none; touch-action: manipulation; }\nbody.hide-cursor, body.hide-cursor * { cursor: none !important; }\ncanvas { position: fixed; inset: 0; width: 100% !important; height: 100% !important; display: block; }\n#ui { position: fixed; inset: 0; pointer-events: none; font-size: 3.6rem; line-height: 1.15; }\n#ui * { box-sizing: border-box; }\n.layer { position: absolute; inset: 0; }\n.screen { position: absolute; inset: 0; padding: 5.4rem 9.6rem; display: flex; flex-direction: column; align-items: center; pointer-events: none; }\n.screen.dim { background: rgba(26, 20, 32, 0.55); }\n.screen.left { align-items: flex-start; }\n.h1 { font-size: 8.4rem; font-weight: 700; color: var(--paper); text-shadow: 0.3rem 0.4rem 0 var(--ink), -0.2rem -0.2rem 0 var(--ink), 0.2rem -0.2rem 0 var(--ink), -0.2rem 0.3rem 0 var(--ink); text-align: center; margin: 0 0 2rem; }\n.h2 { font-size: 5.6rem; font-weight: 600; margin: 0 0 1.6rem; color: var(--paper); text-shadow: 0.25rem 0.3rem 0 var(--ink), -0.15rem -0.15rem 0 var(--ink), 0.15rem -0.15rem 0 var(--ink), -0.15rem 0.2rem 0 var(--ink); text-align: center; }\n.tag { background: var(--paper); border: 0.5rem solid var(--ink); border-radius: 1.6rem; padding: 1.2rem 2.4rem; box-shadow: 0.5rem 0.6rem 0 var(--ink); }\n.sign { background: linear-gradient(180deg, var(--wood) 0%, var(--wood2) 100%); color: var(--paper); border: 0.5rem solid var(--ink); border-radius: 1.2rem; padding: 1.2rem 3rem; box-shadow: 0.5rem 0.6rem 0 var(--ink); text-shadow: 0.2rem 0.2rem 0 var(--ink); }\n.item { pointer-events: auto; cursor: pointer; background: var(--paper); border: 0.5rem solid var(--ink); border-radius: 1.6rem; padding: 1.1rem 3rem; box-shadow: 0.5rem 0.6rem 0 var(--ink); transition: background 0.08s; font-size: 4rem; text-align: center; min-width: 30rem; position: relative; }\n.item.focus { background: var(--gold); border-width: 0.8rem; box-shadow: 0.7rem 0.8rem 0 var(--ink); animation: bounce 0.7s ease-in-out infinite; z-index: 2; }\n.item.locked { background: #CFC6B4; color: #5A5166; }\n@keyframes bounce { 0%, 100% { transform: translateY(0) rotate(var(--r, 0deg)) scale(1.05); } 50% { transform: translateY(-0.7rem) rotate(var(--r, 0deg)) scale(1.07); } }\n.item:not(.focus) { transform: rotate(var(--r, 0deg)); }\n.col { display: flex; flex-direction: column; gap: 1.8rem; align-items: center; }\n.row { display: flex; flex-direction: row; gap: 2.4rem; align-items: center; justify-content: center; flex-wrap: wrap; }\n.grow { flex: 1; }\n.big { font-size: 5rem; }\n.small { font-size: 3rem; }\n.muted { opacity: 0.8; }\n.prompts { position: absolute; left: 5.4rem; right: 5.4rem; bottom: 4.2rem; display: flex; gap: 3.2rem; justify-content: center; align-items: center; flex-wrap: wrap; pointer-events: none; }\n.prompt { display: inline-flex; align-items: center; gap: 0.8rem; background: rgba(255, 244, 220, 0.94); border: 0.4rem solid var(--ink); border-radius: 1.4rem; padding: 0.3rem 1.4rem 0.3rem 0.6rem; font-size: 3rem; }\n.glyph { height: 4.2rem; width: auto; vertical-align: middle; flex: none; }\n.pager { position: absolute; top: 4.2rem; right: 5.4rem; display: flex; align-items: center; gap: 1.2rem; pointer-events: auto; }\n.pager button { pointer-events: auto; cursor: pointer; font: inherit; font-size: 3.6rem; width: 7rem; height: 6.4rem; background: var(--paper); border: 0.4rem solid var(--ink); border-radius: 1.2rem; box-shadow: 0.3rem 0.4rem 0 var(--ink); color: var(--ink); }\n.pager span { background: var(--paper); border: 0.4rem solid var(--ink); border-radius: 1.2rem; padding: 0.5rem 1.6rem; font-size: 3rem; }\n.slider { display: flex; align-items: center; gap: 2rem; min-width: 80rem; justify-content: space-between; padding: 0.9rem 2.4rem; font-size: 3.4rem; text-align: left; }\n.slider .track { position: relative; width: 36rem; height: 2.6rem; background: #fff; border: 0.4rem solid var(--ink); border-radius: 2rem; flex: none; }\n.slider .fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--teal); border-radius: 1.4rem; }\n.slider .val { min-width: 11rem; text-align: right; font-weight: 600; }\n.toggle { display: flex; align-items: center; gap: 2rem; min-width: 80rem; justify-content: space-between; padding: 0.9rem 2.4rem; font-size: 3.4rem; text-align: left; }\n.toggle .val { font-weight: 600; background: var(--paper2); border: 0.3rem solid var(--ink); border-radius: 1rem; padding: 0.1rem 1.4rem; }\n/* Title */\n.title-beam { position: absolute; top: 8rem; left: 50%; transform-origin: 50% 100%; display: flex; align-items: flex-end; justify-content: center; gap: 0.2rem; padding: 0 3rem 1.2rem; border-bottom: 2.2rem solid var(--wood); box-shadow: 0 0.5rem 0 var(--ink); border-radius: 0 0 1rem 1rem; }\n.title-beam span { display: inline-block; font-size: 15rem; font-weight: 700; color: var(--paper); text-shadow: 0.5rem 0.6rem 0 var(--ink), -0.3rem -0.3rem 0 var(--ink), 0.3rem -0.3rem 0 var(--ink), -0.3rem 0.4rem 0 var(--ink); line-height: 1; }\n.title-sub { position: absolute; top: 31rem; width: 100%; text-align: center; font-size: 4rem; color: var(--paper); text-shadow: 0.2rem 0.25rem 0 var(--ink), -0.1rem -0.1rem 0 var(--ink); }\n.press { position: absolute; bottom: 14rem; left: 50%; transform: translateX(-50%); display: inline-flex; gap: 1.6rem; align-items: center; font-size: 4.6rem; animation: breathe 2s ease-in-out infinite; pointer-events: auto; cursor: pointer; white-space: nowrap; }\n.press .glyph { height: 6rem; }\n@keyframes breathe { 0%, 100% { opacity: 1; } 50% { opacity: 0.72; } }\n.touch-note { position: absolute; bottom: 21rem; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 4.2rem; }\n.demo { position: absolute; top: 4.2rem; left: 50%; transform: translateX(-50%); display: inline-flex; gap: 1.4rem; align-items: center; font-size: 3.4rem; white-space: nowrap; }\n.demo-title { position: absolute; top: 4.2rem; left: 5.4rem; font-size: 5rem; font-weight: 700; color: var(--paper); text-shadow: 0.3rem 0.3rem 0 var(--ink), -0.2rem -0.2rem 0 var(--ink); transform: rotate(-3deg); }\n/* Speech */\n.speech { position: absolute; left: 50%; bottom: 15rem; transform: translateX(-50%) rotate(-0.6deg); width: 134rem; max-width: 80%; min-height: 15rem; background: var(--paper); border: 0.6rem solid var(--ink); border-radius: 2rem; padding: 1.8rem 3rem 1.6rem; box-shadow: 0.6rem 0.8rem 0 var(--ink); font-size: 3.8rem; pointer-events: none; }\n.speech.top { bottom: auto; top: 13rem; }\n.speech .who { position: absolute; top: -3rem; left: 3rem; background: var(--gold); border: 0.45rem solid var(--ink); border-radius: 1rem; padding: 0 1.6rem; font-size: 3.2rem; font-weight: 600; transform: rotate(-2deg); }\n.speech .next { position: absolute; right: 1.6rem; bottom: -2.8rem; }\n.speech .next .prompt { font-size: 3rem; }\n.choices { position: absolute; left: 0; right: 0; bottom: 34rem; display: flex; justify-content: center; gap: 3rem; }\n/* HUD */\n.hud { position: absolute; inset: 0; pointer-events: none; }\n.hud-score { position: absolute; top: 4.2rem; right: 5.4rem; font-size: 7.6rem; font-weight: 700; padding: 0.2rem 2.4rem; min-width: 18rem; text-align: center; transform: rotate(1.2deg); }\n.hud-score small { display: block; font-size: 3rem; font-weight: 500; }\n.hud-time { position: absolute; top: 4.2rem; left: 50%; transform: translateX(-50%) rotate(-0.6deg); font-size: 5.4rem; font-weight: 600; padding: 0 2.4rem; min-width: 14rem; text-align: center; }\n.hud-big { position: absolute; top: 34%; left: 0; right: 0; text-align: center; font-size: 13rem; font-weight: 700; color: var(--paper); text-shadow: 0.6rem 0.7rem 0 var(--ink), -0.3rem -0.3rem 0 var(--ink), 0.3rem -0.3rem 0 var(--ink); }\n.hud-widgets { position: absolute; top: 15rem; left: 5.4rem; display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-start; }\n.hud-widgetsR { position: absolute; top: 19rem; right: 5.4rem; display: flex; flex-direction: column; gap: 1.2rem; align-items: flex-end; }\n.hud-note { position: absolute; top: 12rem; left: 50%; transform: translateX(-50%); font-size: 4rem; white-space: nowrap; }\n.hud-prompts { position: absolute; left: 30rem; right: 5.4rem; bottom: 4.2rem; display: flex; gap: 1.6rem; justify-content: flex-end; flex-wrap: wrap; }\n.discs { position: absolute; left: 5.4rem; bottom: 4.2rem; display: flex; gap: 2rem; align-items: flex-end; }\n.discs.group { left: 0; right: 0; justify-content: center; gap: 5rem; bottom: 1.8rem; }\n.disc { position: relative; width: 23.8rem; height: 23.8rem; }\n.disc.small { width: 15.1rem; height: 15.1rem; }\n.disc svg { width: 100%; height: 100%; overflow: visible; display: block; }\n.disc .breath-word { position: absolute; left: 100%; bottom: 0.6rem; margin-left: 1.4rem; white-space: nowrap; font-size: 3.2rem; padding: 0 1.4rem; }\n.disc .who { position: absolute; top: -3.6rem; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 3rem; font-weight: 600; color: var(--paper); text-shadow: 0.2rem 0.2rem 0 var(--ink), -0.1rem -0.1rem 0 var(--ink); }\n.meter { position: relative; width: 44rem; height: 3.4rem; background: #fff; border: 0.45rem solid var(--ink); border-radius: 2rem; overflow: hidden; }\n.meter .fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--teal); }\n.meter-wrap { display: flex; align-items: center; gap: 1.2rem; font-size: 3.2rem; }\n/* Cards */\n.cards { display: flex; gap: 3rem; justify-content: center; flex-wrap: wrap; }\n.card { width: 40rem; min-height: 40rem; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding: 1.8rem 1.6rem; font-size: 3.2rem; gap: 1rem; }\n.card .name { font-size: 4.4rem; font-weight: 600; line-height: 1.05; }\n.card .art { width: 100%; height: 15rem; display: flex; align-items: center; justify-content: center; }\n.card .art svg { height: 100%; width: auto; }\n.card.done { background: #E4DCC8; }\n.card.done.focus { background: var(--gold); }\n.stamp { position: absolute; top: 45%; left: 50%; font-size: 5rem; font-weight: 700; color: #C24D6A; border: 0.7rem solid #C24D6A; border-radius: 1.2rem; padding: 0.2rem 1.6rem; transform: translate(-50%, -50%) rotate(-14deg); background: rgba(255, 244, 220, 0.8); white-space: nowrap; }\n/* Intro card */\n.intro { margin-top: 3rem; width: 150rem; max-width: 92%; display: grid; grid-template-columns: 54rem 1fr; gap: 3rem; align-items: center; padding: 2.8rem 3.6rem; transform: rotate(-0.5deg); }\n.intro .diagram svg { width: 100%; height: auto; }\n.intro h2 { margin: 0 0 1rem; font-size: 6.4rem; font-weight: 700; line-height: 1; }\n.intro p { margin: 0 0 1.2rem; font-size: 3.6rem; }\n.intro .cant { color: #A0362E; }\n.intro .who { font-size: 3rem; font-weight: 600; color: #6B5F75; }\n/* Results */\n.medal { width: 40rem; height: 40rem; }\n.results { display: flex; flex-direction: column; align-items: center; gap: 1.4rem; margin-top: 2rem; }\n.bignum { font-size: 15rem; font-weight: 700; color: var(--paper); line-height: 1; text-shadow: 0.7rem 0.8rem 0 var(--ink), -0.3rem -0.3rem 0 var(--ink), 0.3rem -0.3rem 0 var(--ink), -0.3rem 0.4rem 0 var(--ink); }\n.toast { position: absolute; top: 5rem; left: 50%; transform: translateX(-50%) rotate(-1deg); font-size: 3.8rem; white-space: nowrap; animation: pop 0.25s ease-out; }\n@keyframes pop { 0% { transform: translateX(-50%) scale(0.5); } 80% { transform: translateX(-50%) scale(1.08); } 100% { transform: translateX(-50%) scale(1); } }\n.hotlabel { position: absolute; transform: translate(-50%, -130%) rotate(-1deg); font-size: 3.4rem; white-space: nowrap; font-weight: 600; pointer-events: none; }\n.hotlabel .prompt { margin-left: 1rem; border: none; background: none; padding: 0; }\n.audio-tag { position: absolute; top: 4.2rem; left: 5.4rem; font-size: 3rem; }\n/* Reveal */\n.counter { display: flex; gap: 1.2rem; }\n.counter .digit { width: 15rem; height: 22rem; background: linear-gradient(180deg, #D39A5A, #A86F36 50%, #D39A5A); border: 0.7rem solid var(--ink); border-radius: 1.6rem; display: flex; align-items: center; justify-content: center; font-size: 15rem; font-weight: 700; color: var(--paper); text-shadow: 0.4rem 0.5rem 0 var(--ink); box-shadow: 0.6rem 0.8rem 0 var(--ink); }\n/* Journal */\n.calendar { display: grid; grid-template-columns: repeat(7, 15rem); gap: 1.4rem; }\n.calendar .day { height: 12rem; background: var(--paper); border: 0.4rem solid var(--ink); border-radius: 1rem; position: relative; font-size: 3rem; padding: 0.4rem 1rem; }\n.calendar .day b { position: absolute; left: 50%; top: 55%; transform: translate(-50%, -50%) rotate(-12deg); color: #C24D6A; border: 0.4rem solid #C24D6A; border-radius: 0.8rem; padding: 0 0.6rem; font-size: 3rem; }\n.shelf { display: grid; grid-template-columns: repeat(4, 34rem); gap: 1.6rem; }\n.shelf .m { display: flex; flex-direction: column; align-items: center; font-size: 3rem; text-align: center; padding: 0.8rem 0.4rem; }\n.shelf .m svg { width: 8rem; height: 8rem; }\n.totals { display: flex; flex-direction: column; gap: 1.6rem; font-size: 4.8rem; }\n.graph svg { width: 120rem; height: 46rem; }\n/* About */\n.about { width: 160rem; max-width: 100%; padding: 2rem 3.4rem; font-size: 3rem; line-height: 1.16; max-height: 76rem; overflow: hidden; }\n.about h3 { font-size: 3.6rem; margin: 0.4rem 0 1rem; }\n.about p { margin: 0 0 0.8rem; font-size: 3rem; }\n.about b { font-weight: 600; }\n/* Group */\n.mats { display: flex; gap: 2.6rem; justify-content: center; }\n.mat { width: 36rem; height: 32rem; border: 0.6rem solid var(--ink); border-radius: 2rem; background: var(--paper); display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 3.2rem; gap: 1rem; box-shadow: 0.5rem 0.6rem 0 var(--ink); text-align: center; padding: 1rem; }\n.podium-line { font-size: 4.4rem; }\n/* Dev */\n.dev-panel { width: 160rem; display: flex; flex-direction: column; align-items: center; gap: 1.4rem; }\n.dev-panel .item { min-width: 90rem; font-size: 3.4rem; padding: 0.6rem 2rem; }\n.dev-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem 2.4rem; }\n.dev-grid .item { min-width: 62rem; }\n.stats { position: absolute; left: 5.4rem; top: 4.2rem; font-size: 3rem; background: rgba(255,244,220,.92); border: 0.4rem solid var(--ink); border-radius: 1rem; padding: 0.4rem 1.2rem; white-space: pre; line-height: 1.12; z-index: 5; }\n.bigtext { white-space: pre-wrap; font-size: 3rem; width: 150rem; height: 66rem; overflow: hidden; }\n.boot { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--ink); color: var(--paper); font-size: 5rem; gap: 2rem; }\n.card-session { position: absolute; left: 5.4rem; right: 5.4rem; top: 4.2rem; display: flex; flex-direction: column; align-items: center; gap: 1.4rem; }\n.seat { display: inline-flex; align-items: center; gap: 1rem; font-size: 3.6rem; font-weight: 600; color: var(--ink); background: var(--paper); border: 0.4rem solid var(--ink); border-radius: 1.2rem; padding: 0.3rem 1.6rem; }\n.seat i { display: inline-block; width: 3rem; height: 3rem; border-radius: 50%; border: 0.35rem solid var(--ink); }\nEOF\ncat > src/ui/ui.js <<'EOF'\nimport { h, rotJitter } from './dom.js';\nimport { promptHTML } from '../input/glyphs.js';\n\n/** A screen: a DOM layer with focusable items. Hover moves focus; pad, keys and mouse all work. */\nexport class Screen {\n  constructor(ui, def) {\n    this.ui = ui; this.def = def; this.name = def.name;\n    this.el = h(`div.screen${def.className ? `.${def.className}` : ''}`);\n    this.el.dataset.screen = def.name;\n    this.items = []; this.focus = -1; this.promptList = def.prompts || null;\n    this.page = 0; this.pages = 0; this.onPage = null;\n    this.onBack = def.back || null; this.onAlt = def.alt || null;\n    this.promptEl = null; this.updateFn = def.update || null;\n    this.passive = !!def.passive;\n  }\n  /** Register a focusable. handlers: use, left, right, focus. */\n  item(el, handlers = {}) {\n    const it = { el, ...handlers, index: this.items.length };\n    el.classList.add('item');\n    el.style.setProperty('--r', `${rotJitter(this.items.length)}deg`);\n    el.addEventListener('pointermove', (e) => {\n      if (e.pointerType === 'touch') return;\n      const inp = this.ui.game.input;\n      if (e.clientX === inp.lastHoverX && e.clientY === inp.lastHoverY) return;\n      inp.lastHoverX = e.clientX; inp.lastHoverY = e.clientY;\n      const i = this.items.indexOf(it);\n      if (i >= 0 && i !== this.focus && !this.ui.inert) this.setFocus(i);\n    });\n    el.addEventListener('click', (e) => {\n      if (this.ui.top !== this) return;\n      e.stopPropagation();\n      this.ui.game.input.clickQueue.push(() => { const i = this.items.indexOf(it); if (i >= 0) { this.setFocus(i, true); this.use(i); } });\n    });\n    this.items.push(it);\n    return el;\n  }\n  clearItems() { this.items = []; this.focus = -1; }\n  setFocus(i, silent) {\n    if (this.items[this.focus]) this.items[this.focus].el.classList.remove('focus');\n    this.focus = i;\n    const it = this.items[i];\n    if (it) { it.el.classList.add('focus'); if (it.focusFn) it.focusFn(); }\n    if (!silent) this.ui.game.audio.sfx('uiMove');\n  }\n  use(i = this.focus) {\n    const it = this.items[i];\n    if (it && it.use) { this.ui.game.audio.sfx(it.silent ? 'uiMove' : 'uiConfirm'); it.use(); }\n  }\n  move(dir) {\n    if (!this.items.length) return false;\n    if (this.focus < 0) { this.setFocus(0); return true; }\n    const cur = this.items[this.focus].el.getBoundingClientRect();\n    const cx = cur.left + cur.width / 2, cy = cur.top + cur.height / 2;\n    let best = -1, score = 1e9;\n    this.items.forEach((it, i) => {\n      if (i === this.focus) return;\n      const r = it.el.getBoundingClientRect();\n      const x = r.left + r.width / 2 - cx, y = r.top + r.height / 2 - cy;\n      let along, off;\n      if (dir === 'up') { along = -y; off = Math.abs(x); } else if (dir === 'down') { along = y; off = Math.abs(x); } else if (dir === 'left') { along = -x; off = Math.abs(y); } else { along = x; off = Math.abs(y); }\n      if (along <= 1) return;\n      const s = along + off * 2.2;\n      if (s < score) { score = s; best = i; }\n    });\n    if (best >= 0) { this.setFocus(best); return true; }\n    return false;\n  }\n  /** A page switcher: not counted among a screen's choices. */\n  pager(n, onPage, start = 0) {\n    this.pages = n; this.page = start; this.onPage = onPage;\n    const label = h('span');\n    const prev = h('button', { 'data-pager': '1', onclick: (e) => { e.stopPropagation(); this.ui.game.input.clickQueue.push(() => this.turn(-1)); } }, '◄');\n    const next = h('button', { 'data-pager': '1', onclick: (e) => { e.stopPropagation(); this.ui.game.input.clickQueue.push(() => this.turn(1)); } }, '►');\n    const el = h('div.pager', prev, label, next);\n    this.pagerLabel = label;\n    this.el.append(el);\n    this._label();\n    return el;\n  }\n  _label() { if (this.pagerLabel) this.pagerLabel.textContent = `${this.page + 1} / ${this.pages}`; }\n  turn(d) {\n    if (this.pages < 2) return false;\n    this.page = (this.page + d + this.pages) % this.pages;\n    this._label();\n    if (this.onPage) this.onPage(this.page);\n    this.ui.game.audio.sfx('uiMove');\n    return true;\n  }\n  setPrompts(list) { this.promptList = list; this._renderPrompts(); }\n  _renderPrompts() {\n    if (!this.promptList) { if (this.promptEl) this.promptEl.innerHTML = ''; return; }\n    if (!this.promptEl) { this.promptEl = h('div.prompts'); this.el.append(this.promptEl); }\n    const { input, save } = this.ui.game;\n    this.promptEl.innerHTML = this.promptList.map(([v, t]) => promptHTML(v, t, input.lastDevice, save.settings.glyphs)).join('');\n  }\n}\n\nexport class UI {\n  constructor(game, root) {\n    this.game = game; this.root = root;\n    this.stack = []; this.inert = false;\n    this.layer = h('div.layer'); root.append(this.layer);\n    this.lastDevice = null; this.lastGlyphs = null;\n    this.toastEl = null; this.toastT = 0;\n    this.deviceListeners = new Set();\n  }\n  get top() { return this.stack[this.stack.length - 1] || null; }\n  /** Open a screen on top. def: { name, className, build(screen), back, alt, prompts, update, passive }. */\n  open(def) {\n    const s = new Screen(this, def);\n    this.stack.push(s);\n    this.layer.append(s.el);\n    if (def.build) def.build(s);\n    s._renderPrompts();\n    if (s.items.length && s.focus < 0) s.setFocus(def.focus ?? 0, true);\n    return s;\n  }\n  /** Replace everything with one screen. */\n  only(def) { this.clear(); return this.open(def); }\n  close(s = this.top) {\n    if (!s) return;\n    const i = this.stack.indexOf(s);\n    if (i >= 0) this.stack.splice(i, 1);\n    s.el.remove();\n    if (s.def.onClose) s.def.onClose();\n  }\n  clear() { while (this.stack.length) this.close(this.stack[this.stack.length - 1]); }\n  has(name) { return this.stack.some((s) => s.name === name); }\n  toast(text, sec = 2.6) {\n    if (this.toastEl) this.toastEl.remove();\n    this.toastEl = h('div.toast.tag', text);\n    this.root.append(this.toastEl);\n    this.toastT = sec;\n  }\n  fixed(dt) {\n    const input = this.game.input;\n    const queue = input.clickQueue;\n    if (queue.length) { input.clickQueue = []; if (!this.inert) for (const f of queue) f(); }\n    const s = this.top;\n    if (!s || s.passive || this.inert) return;\n    if (input.verb('up')) this._dir(s, 'up');\n    if (input.verb('down')) this._dir(s, 'down');\n    if (input.verb('left')) this._dir(s, 'left');\n    if (input.verb('right')) this._dir(s, 'right');\n    if (input.verb('pageL')) s.turn(-1);\n    if (input.verb('pageR')) s.turn(1);\n    if (input.verb('confirm')) s.use();\n    if (input.verb('back') || input.verb('rightclick')) {\n      if (s.onBack) { this.game.audio.sfx('uiBack'); s.onBack(); }\n    }\n    if (input.verb('alt') && s.onAlt) s.onAlt();\n  }\n  _dir(s, dir) {\n    const it = s.items[s.focus];\n    if (it) {\n      if (dir === 'left' && it.left) { it.left(); return; }\n      if (dir === 'right' && it.right) { it.right(); return; }\n    }\n    const moved = s.move(dir);\n    if (!moved && (dir === 'left' || dir === 'right')) s.turn(dir === 'left' ? -1 : 1);\n    if (s.def.onDir) s.def.onDir(dir, moved);\n  }\n  frame(dt) {\n    const { input, save } = this.game;\n    if (input.lastDevice !== this.lastDevice || save.settings.glyphs !== this.lastGlyphs) {\n      this.lastDevice = input.lastDevice; this.lastGlyphs = save.settings.glyphs;\n      for (const s of this.stack) s._renderPrompts();\n      for (const f of this.deviceListeners) f();\n    }\n    for (const s of this.stack) if (s.updateFn) s.updateFn(dt, s);\n    if (this.toastEl) { this.toastT -= dt; if (this.toastT <= 0) { this.toastEl.remove(); this.toastEl = null; } }\n  }\n  /** A left/right value control, dragged with the mouse. */\n  slider(s, label, get, set, { min = 0, max = 100, step = 5, format = (v) => String(Math.round(v)), onChange = null } = {}) {\n    const fill = h('div.fill'), track = h('div.track', fill), val = h('div.val');\n    const el = h('div.slider', h('span', label), track, val);\n    const render = () => {\n      const v = get();\n      fill.style.width = `${(100 * (v - min)) / (max - min)}%`;\n      val.textContent = format(v);\n    };\n    const put = (v) => {\n      const q = Math.round((Math.max(min, Math.min(max, v)) - min) / step) * step + min;\n      set(+q.toFixed(5));\n      render();\n      if (onChange) onChange();\n    };\n    let dragging = false;\n    const dragTo = (e) => { const r = track.getBoundingClientRect(); put(min + ((e.clientX - r.left) / r.width) * (max - min)); };\n    track.style.pointerEvents = 'auto';\n    track.addEventListener('pointerdown', (e) => { dragging = true; dragTo(e); e.stopPropagation(); if (track.setPointerCapture) { try { track.setPointerCapture(e.pointerId); } catch (x) { /* synthetic pointers have no capture */ } } });\n    track.addEventListener('pointermove', (e) => { if (dragging) dragTo(e); });\n    track.addEventListener('pointerup', () => { dragging = false; });\n    render();\n    s.item(el, { left: () => { put(get() - step); this.game.audio.sfx('uiMove'); }, right: () => { put(get() + step); this.game.audio.sfx('uiMove'); }, render, silent: true });\n    return el;\n  }\n  /** Cycle through named options with left, right or use. */\n  choice(s, label, options, get, set) {\n    const val = h('span.val');\n    const el = h('div.toggle', h('span', label), val);\n    const idx = () => Math.max(0, options.findIndex((o) => o[0] === get()));\n    const render = () => { val.textContent = options[idx()][1]; };\n    const shift = (d) => { set(options[(idx() + d + options.length) % options.length][0]); render(); this.game.audio.sfx('uiMove'); };\n    render();\n    s.item(el, { left: () => shift(-1), right: () => shift(1), use: () => shift(1), silent: true });\n    return el;\n  }\n}\nEOF\ncat > src/ui/speech.js <<'EOF'\nimport { h } from './dom.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { VOICES } from '../audio/voice.js';\n\nexport const SPEAKERS = {\n  trudy: { name: 'Trudy', voice: 'trudy' }, stillwater: { name: 'Ms. Stillwater', voice: 'stillwater' },\n  bolster: { name: 'Coach Bolster', voice: 'bolster' }, margaret: { name: 'Gentle Margaret', voice: 'margaret' },\n  kevin: { name: 'Retired Kevin', voice: 'kevin' }, sandras: { name: 'Both Sandras', voice: 'sandras' },\n  paul: { name: 'Unsteady Paul', voice: 'paul' }, gerald: { name: 'Young Gerald', voice: 'gerald' },\n  gary: { name: 'Gary', voice: null },\n};\n\n/** A paper speech tag in the lower third. Text types out in time with the voice. Every word is on screen. */\nexport class Speech {\n  constructor(game, root) {\n    this.game = game;\n    this.el = h('div.speech'); this.el.style.display = 'none';\n    this.who = h('div.who'); this.text = h('div.text'); this.next = h('div.next');\n    this.el.append(this.who, this.text, this.next);\n    root.append(this.el);\n    this.line = null; this.t = 0; this.left = 0; this.shown = 0; this.history = [];\n  }\n  /** blocking: Use advances. auto: seconds until it clears by itself. */\n  say(who, text, { auto = 0, top = false } = {}) {\n    const sp = SPEAKERS[who] || { name: who, voice: null };\n    this.line = { who, text, auto, cps: this._cps(sp), done: false, finished: false };\n    this.who.textContent = sp.name;\n    this.text.textContent = '';\n    this.shown = 0; this.t = 0;\n    this.el.style.display = '';\n    this.el.classList.toggle('top', !!top);\n    this.next.innerHTML = '';\n    this.history.push({ who, text });\n    if (this.history.length > 40) this.history.shift();\n    if (sp.voice) this.game.audio.say(sp.voice, text);\n    else if (who === 'gary') this.game.audio.sfx('squawk');\n    return this.line;\n  }\n  _cps(sp) {\n    const v = VOICES[sp.voice];\n    if (!v) return 30;\n    return Math.min(46, v.rate * 2.7);\n  }\n  get active() { return !!this.line; }\n  clear() {\n    this.line = null;\n    this.el.style.display = 'none';\n    this.game.audio.stopVoice();\n  }\n  /** Use: finish typing, or move on. */\n  advance() {\n    const l = this.line;\n    if (!l) return true;\n    if (!l.finished) { this.t = 1e9; this._type(); return false; }\n    l.done = true;\n    this.clear();\n    return true;\n  }\n  _type() {\n    const l = this.line;\n    const n = Math.min(l.text.length, Math.floor(this.t * l.cps));\n    if (n !== this.shown) { this.shown = n; this.text.textContent = l.text.slice(0, n); }\n    if (n >= l.text.length && !l.finished) {\n      l.finished = true;\n      if (!l.auto) this.next.innerHTML = promptHTML('use', 'Next', this.game.input.lastDevice, this.game.save.settings.glyphs);\n    }\n  }\n  fixed(dt) {\n    const l = this.line;\n    if (!l) return;\n    this.t += dt;\n    this._type();\n    if (l.auto && l.finished) {\n      l.auto -= dt;\n      if (l.auto <= 0) { l.done = true; this.clear(); }\n    }\n  }\n}\nEOF\ncat > src/ui/disc.js <<'EOF'\nimport { h } from './dom.js';\n\nconst NS = 'http://www.w3.org/2000/svg';\nconst el = (name, attrs, parent) => {\n  const e = document.createElementNS(NS, name);\n  for (const k of Object.keys(attrs)) e.setAttribute(k, attrs[k]);\n  if (parent) parent.appendChild(e);\n  return e;\n};\n\n/** The game's signature HUD: a dial with rings, a target zone, the dot, the asking ring and an inked trail. */\nexport class BalanceDisc {\n  constructor(parent, { small = false, colour = '#1A1420', name = null } = {}) {\n    this.root = h(`div.disc${small ? '.small' : ''}`);\n    parent.append(this.root);\n    const svg = this.svg = document.createElementNS(NS, 'svg');\n    svg.setAttribute('viewBox', '-120 -130 240 250');\n    this.root.append(svg);\n    this.breathRing = el('circle', { r: 112, fill: 'none', stroke: '#6FD6B8', 'stroke-width': 7, opacity: 0 }, svg);\n    el('circle', { r: 100, fill: '#FFF4DC', stroke: '#1A1420', 'stroke-width': 7 }, svg);\n    el('circle', { r: 66, fill: '#F8E4BA', stroke: '#C9B48A', 'stroke-width': 2.5 }, svg);\n    el('circle', { r: 33, fill: '#FFF4DC', stroke: '#C9B48A', 'stroke-width': 2.5 }, svg);\n    el('path', { d: 'M-100 0H100M0 -100V100', stroke: '#C9B48A', 'stroke-width': 2.5 }, svg);\n    this.brace = el('path', { d: '', fill: '#61C964', opacity: 0, stroke: '#1A1420', 'stroke-width': 3 }, svg);\n    this.zone = el('circle', { r: 30, fill: '#9BE08F', 'fill-opacity': 0.55, stroke: '#2F8F46', 'stroke-width': 5, opacity: 0 }, svg);\n    this.trail = el('polyline', { fill: 'none', stroke: '#1A1420', 'stroke-width': 3.5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', points: '', opacity: 0.55 }, svg);\n    this.ask = el('circle', { r: 12, fill: 'none', stroke: '#1A1420', 'stroke-width': 3.5, 'stroke-dasharray': '6 4', opacity: 0.8 }, svg);\n    this.dot = el('circle', { r: 11, fill: colour, stroke: '#1A1420', 'stroke-width': 4 }, svg);\n    // Trudy peeks over the rim.\n    this.peek = el('g', { transform: 'translate(0,-104)' }, svg);\n    el('rect', { x: -32, y: -17, width: 64, height: 26, rx: 8, fill: '#F5B700', stroke: '#1A1420', 'stroke-width': 4 }, this.peek);\n    el('rect', { x: -18, y: -12, width: 36, height: 13, rx: 6.5, fill: '#B9F26B', stroke: '#1A1420', 'stroke-width': 2.5 }, this.peek);\n    this.peekBubble = el('circle', { r: 5.5, cy: -5.5, fill: '#fff', stroke: '#1A1420', 'stroke-width': 2 }, this.peek);\n    this.peekPupil = el('circle', { r: 2.2, cy: -5.5, fill: '#1A1420' }, this.peek);\n    this.word = null;\n    if (name) this.root.append(h('div.who', name));\n    this.hist = [];\n    this.small = small;\n  }\n  addBreathWord() { this.word = h('div.breath-word.tag', 'Breathe'); this.word.style.display = 'none'; this.root.append(this.word); return this.word; }\n  /** dx, dz: the dot. ax, az: where the input asks. zone: {x, z, r, on} or null. */\n  update(d) {\n    const x = d.dx * 100, y = d.dz * 100;\n    this.dot.setAttribute('cx', x.toFixed(1)); this.dot.setAttribute('cy', y.toFixed(1));\n    this.ask.setAttribute('cx', (d.ax * 100).toFixed(1)); this.ask.setAttribute('cy', (d.az * 100).toFixed(1));\n    this.ask.setAttribute('opacity', d.showAsk === false ? 0 : 0.85);\n    const h2 = this.hist;\n    h2.push(x.toFixed(1), y.toFixed(1));\n    if (h2.length > 60) h2.splice(0, 2);\n    if (d.frame % 2 === 0) {\n      let s = '';\n      for (let i = 0; i < h2.length; i += 2) s += `${h2[i]},${h2[i + 1]} `;\n      this.trail.setAttribute('points', s);\n    }\n    if (d.zone) {\n      this.zone.setAttribute('opacity', 1);\n      this.zone.setAttribute('cx', (d.zone.x * 100).toFixed(1)); this.zone.setAttribute('cy', (d.zone.z * 100).toFixed(1));\n      this.zone.setAttribute('r', (d.zone.r * 100).toFixed(1));\n      this.zone.setAttribute('fill', d.zone.on ? '#61C964' : '#FFD27A');\n      this.zone.setAttribute('stroke', d.zone.on ? '#2F8F46' : '#B5762C');\n    } else this.zone.setAttribute('opacity', 0);\n    if (d.brace) {\n      // A green wedge shows where to lean before a gust lands.\n      const a = Math.atan2(d.brace.z, d.brace.x), w = 0.55, r = 96, r0 = 30;\n      const p = (ang, rr) => `${(Math.cos(ang) * rr).toFixed(1)} ${(Math.sin(ang) * rr).toFixed(1)}`;\n      this.brace.setAttribute('d', `M${p(a - w, r0)}L${p(a - w, r)}A${r} ${r} 0 0 1 ${p(a + w, r)}L${p(a + w, r0)}A${r0} ${r0} 0 0 0 ${p(a - w, r0)}Z`);\n      this.brace.setAttribute('opacity', 0.75);\n    } else this.brace.setAttribute('opacity', 0);\n    if (d.breath) {\n      const rr = 104 + d.breath.size * 14;\n      this.breathRing.setAttribute('r', rr.toFixed(1));\n      this.breathRing.setAttribute('opacity', 0.95);\n      this.breathRing.setAttribute('stroke', d.breath.inSync ? '#37B24D' : '#7FB4E8');\n      if (this.word) {\n        this.word.style.display = '';\n        const w = d.breath.growing ? 'Breathe in' : 'Breathe out';\n        if (this.word.textContent !== w) this.word.textContent = w;\n      }\n    } else {\n      this.breathRing.setAttribute('opacity', 0);\n      if (this.word) this.word.style.display = 'none';\n    }\n    const bx = Math.max(-12, Math.min(12, (d.dx * 16))).toFixed(1);\n    this.peekBubble.setAttribute('cx', bx); this.peekPupil.setAttribute('cx', bx);\n    this.peek.setAttribute('transform', `translate(0,${d.alarm ? -112 : -104}) rotate(${(d.dx * 8).toFixed(1)})`);\n  }\n  remove() { this.root.remove(); }\n}\nEOF\ncat > src/ui/hud.js <<'EOF'\nimport { h } from './dom.js';\nimport { BalanceDisc } from './disc.js';\nimport { promptHTML } from '../input/glyphs.js';\n\n/** Disc bottom left, one big score top right, time top centre, event widgets, this event's verbs. */\nexport class HUD {\n  constructor(game, root) {\n    this.game = game;\n    this.el = h('div.hud'); this.el.style.display = 'none'; root.append(this.el);\n    this.score = h('div.hud-score.tag'); this.time = h('div.hud-time.tag'); this.big = h('div.hud-big');\n    this.widgets = h('div.hud-widgets'); this.widgetsR = h('div.hud-widgetsR'); this.note = h('div.hud-note.tag'); this.promptEl = h('div.hud-prompts');\n    this.discsEl = h('div.discs');\n    this.el.append(this.score, this.time, this.big, this.widgets, this.widgetsR, this.note, this.promptEl, this.discsEl);\n    this.discs = []; this.promptList = []; this.frameN = 0; this.lastDevice = null; this.bigT = 0; this.noteT = 0;\n    this.scoreText = null; this.timeText = null; this.promptDevice = null; this.promptGlyphs = null;\n    this.note.style.display = 'none';\n    this.discsVisible = true;\n  }\n  show(on = true) { this.el.style.display = on ? '' : 'none'; }\n  reset() {\n    for (const d of this.discs) d.disc.remove();\n    this.discs = [];\n    this.widgets.innerHTML = ''; this.widgetsR.innerHTML = '';\n    this.big.textContent = ''; this.note.style.display = 'none';\n    this.setScore('', ''); this.setTime(null); this.setPrompts([]);\n    this.discsEl.classList.remove('group');\n  }\n  /** One disc per lane to show. group: small discs along the bottom edge. */\n  setDiscs(lanes, group = false) {\n    for (const d of this.discs) d.disc.remove();\n    this.discs = [];\n    this.discsEl.classList.toggle('group', group);\n    for (const lane of lanes) {\n      const disc = new BalanceDisc(this.discsEl, { small: group, colour: lane.colour || '#1A1420', name: group ? lane.name : null });\n      disc.addBreathWord();\n      this.discs.push({ lane, disc });\n    }\n  }\n  setScore(v, label = '') {\n    const t = `${v}|${label}`;\n    if (t === this.scoreText) return;\n    this.scoreText = t;\n    this.score.style.display = v === '' ? 'none' : '';\n    this.score.innerHTML = '';\n    this.score.append(document.createTextNode(String(v)));\n    if (label) this.score.append(h('small', label));\n  }\n  setTime(sec) {\n    const t = sec === null ? '' : String(Math.ceil(Math.max(0, sec)));\n    if (t === this.timeText) return;\n    this.timeText = t;\n    this.time.style.display = sec === null ? 'none' : '';\n    this.time.textContent = t;\n  }\n  setPrompts(list) { this.promptList = list; this.promptDevice = null; }\n  flash(text, sec = 0.9) { this.big.textContent = text; this.bigT = sec; }\n  setNote(text, sec = 2) { this.note.textContent = text; this.note.style.display = text ? '' : 'none'; this.noteT = sec; }\n  addWidget(el, right = false) { (right ? this.widgetsR : this.widgets).append(el); return el; }\n  meter(label, colour) {\n    const fill = h('div.fill'); if (colour) fill.style.background = colour;\n    const m = h('div.meter', fill);\n    const el = h('div.meter-wrap', h('span.tag', { style: 'padding:0 1.2rem;font-size:3rem;border-width:.4rem;box-shadow:none' }, label), m);\n    el.set = (v) => { fill.style.width = `${Math.max(0, Math.min(1, v)) * 100}%`; };\n    return el;\n  }\n  frame(dt) {\n    const { input, save } = this.game;\n    if (input.lastDevice !== this.promptDevice || save.settings.glyphs !== this.promptGlyphs) {\n      this.promptDevice = input.lastDevice; this.promptGlyphs = save.settings.glyphs;\n      this.promptEl.innerHTML = this.promptList.map(([v, t]) => promptHTML(v, t, input.lastDevice, save.settings.glyphs)).join('');\n    }\n    if (this.bigT > 0) { this.bigT -= dt; if (this.bigT <= 0) this.big.textContent = ''; }\n    if (this.noteT > 0) { this.noteT -= dt; if (this.noteT <= 0) this.note.style.display = 'none'; }\n    this.frameN++;\n    for (const { lane, disc } of this.discs) {\n      const v = lane.discView;\n      if (v) { v.frame = this.frameN; disc.update(v); }\n    }\n  }\n}\nEOF\n","description":"Write UI framework, CSS, speech, Balance Disc and HUD"}}}
