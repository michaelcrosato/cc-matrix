on'|'attract', config, god } */\nsrc/events/base.js:78:    this.game = spec.game; this.tier = spec.tier || 0; this.mode = spec.mode || 'solo'; this.god = !!spec.god;\nsrc/events/base.js:246:      if (this.god) {\nsrc/events/base.js:293:  forceFall(i = 0) { const l = this.lanes[i]; if (l && l.bal && !l.fallen) { const g = this.god; this.god = false; th\n--- wantDive\nsrc/events/springboard.js:278:      const goal = (d.goal ?? (d.goal = bot.r() < (lane.wantDive ? 1 : 0.15) ? Math.PI : Math.PI / 2","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HukTJQ6fTH6MbBSg8ZxNu7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
