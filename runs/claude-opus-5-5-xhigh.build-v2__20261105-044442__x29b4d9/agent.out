{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjk2B8FDs2bZwHGQvpHW","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28652,"cache_read_input_tokens":166129,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28652},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"71ab44b5-a7cb-4ac0-af80-bfd8df8bc9b0","timestamp":"2026-11-05T11:59:34.265Z","request_id":"req_011Cgjk2AjvwhUh9hDsJHBJn","thinking_duration_ms":33895,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjk2B8FDs2bZwHGQvpHW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WFdEVmLsunqL2yN4mk2kYF","name":"Bash","input":{"command":"cat > src/audio/instruments.js <<'EOF'\n// Every instrument takes (ctx, out, t, midi, dur, vel, det): same code live and offline.\nexport const mtof = (m) => 440 * 2 ** ((m - 69) / 12);\n\nfunction env(ctx, out, t, a, peak, d, sus, r, dur) {\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(0.0001, t);\n  g.gain.linearRampToValueAtTime(peak, t + a);\n  g.gain.exponentialRampToValueAtTime(Math.max(0.0001, sus * peak), t + a + d);\n  const end = Math.max(t + a + d, t + dur);\n  g.gain.setValueAtTime(Math.max(0.0001, sus * peak), end);\n  g.gain.exponentialRampToValueAtTime(0.0001, end + r);\n  g.connect(out);\n  return { g, end: end + r + 0.02 };\n}\nfunction osc(ctx, type, f, det, t, end, dest) {\n  const o = ctx.createOscillator();\n  o.type = type; o.frequency.value = f; o.detune.value = det || 0;\n  if (dest) o.connect(dest);\n  o.start(t); o.stop(end);\n  return o;\n}\nlet noiseBuf = new WeakMap();\nexport function noise(ctx) {\n  let b = noiseBuf.get(ctx);\n  if (!b) {\n    b = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);\n    const d = b.getChannelData(0);\n    let x = 12345;\n    for (let i = 0; i < d.length; i++) { x = (Math.imul(x, 1103515245) + 12345) & 0x7fffffff; d[i] = x / 0x3fffffff - 1; }\n    noiseBuf.set(ctx, b);\n  }\n  return b;\n}\nexport function noiseSrc(ctx, t, dur, dest, rate = 1) {\n  const s = ctx.createBufferSource();\n  s.buffer = noise(ctx); s.loop = true; s.playbackRate.value = rate;\n  s.connect(dest);\n  s.start(t, (t * 7.13) % 1.5); s.stop(t + dur);\n  return s;\n}\n\nexport function epiano(ctx, out, t, midi, dur, vel = 0.5, det = 0, clav = false) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.004, vel * 0.5, clav ? 0.16 : 0.9, clav ? 0.12 : 0.25, clav ? 0.05 : 0.3, dur);\n  const car = osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const tine = osc(ctx, 'sine', f * 14, det, t, t + 0.22);\n  const ti = ctx.createGain();\n  ti.gain.setValueAtTime(f * (clav ? 3.4 : 2.1) * vel, t); ti.gain.exponentialRampToValueAtTime(1, t + (clav ? 0.1 : 0.2));\n  tine.connect(ti); ti.connect(car.frequency);\n  const body = osc(ctx, 'sine', f, det, t, e.end);\n  const bi = ctx.createGain();\n  bi.gain.setValueAtTime(f * 0.9 * vel, t); bi.gain.exponentialRampToValueAtTime(f * 0.1, t + 0.5);\n  body.connect(bi); bi.connect(car.frequency);\n}\nexport function clav(ctx, out, t, midi, dur, vel, det) { epiano(ctx, out, t, midi, Math.min(dur, 0.14), vel, det, true); }\n\nexport function bass(ctx, out, t, midi, dur, vel = 0.6, det = 0) {\n  const f = mtof(midi);\n  const lp = ctx.createBiquadFilter();\n  lp.type = 'lowpass'; lp.Q.value = 7;\n  lp.frequency.setValueAtTime(f * 9, t); lp.frequency.exponentialRampToValueAtTime(f * 1.8, t + 0.16);\n  const e = env(ctx, lp, t, 0.003, vel * 0.7, 0.12, 0.55, 0.05, dur);\n  lp.connect(out);\n  osc(ctx, 'sawtooth', f, det, t, e.end, e.g);\n  osc(ctx, 'sine', f, det, t, e.end, e.g);\n  // Slap click.\n  const c = ctx.createGain();\n  c.gain.setValueAtTime(vel * 0.25, t); c.gain.exponentialRampToValueAtTime(0.0001, t + 0.018);\n  const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 1400;\n  noiseSrc(ctx, t, 0.03, hp); hp.connect(c); c.connect(out);\n}\nexport function softBass(ctx, out, t, midi, dur, vel = 0.6, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.012, vel * 0.8, 0.25, 0.6, 0.08, dur);\n  osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const h = ctx.createGain(); h.gain.value = 0.22; h.connect(e.g);\n  osc(ctx, 'triangle', f * 2, det, t, e.end, h);\n}\nexport function tuba(ctx, out, t, midi, dur, vel = 0.6, det = 0) {\n  const f = mtof(midi);\n  const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.Q.value = 2;\n  lp.frequency.setValueAtTime(f * 2, t); lp.frequency.linearRampToValueAtTime(f * 5, t + 0.05); lp.frequency.linearRampToValueAtTime(f * 3, t + 0.2);\n  const e = env(ctx, lp, t, 0.02, vel * 0.8, 0.1, 0.7, 0.05, dur);\n  lp.connect(out);\n  osc(ctx, 'sawtooth', f, det, t, e.end, e.g);\n}\nexport function marimba(ctx, out, t, midi, dur, vel = 0.5, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.002, vel * 0.6, 0.32, 0.001, 0.03, 0.01);\n  osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const h = ctx.createGain();\n  h.gain.setValueAtTime(0.5, t); h.gain.exponentialRampToValueAtTime(0.001, t + 0.07);\n  h.connect(e.g);\n  osc(ctx, 'sine', f * 4, det, t, t + 0.1, h);\n}\nexport function vibes(ctx, out, t, midi, dur, vel = 0.5, det = 0) {\n  const f = mtof(midi);\n  const trem = ctx.createGain(); trem.gain.value = 1; trem.connect(out);\n  const lfo = osc(ctx, 'sine', 5.2, 0, t, t + dur + 1.5);\n  const d = ctx.createGain(); d.gain.value = 0.28; lfo.connect(d); d.connect(trem.gain);\n  const e = env(ctx, trem, t, 0.003, vel * 0.42, 1.1, 0.12, 0.3, dur);\n  osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const h = ctx.createGain(); h.gain.setValueAtTime(0.32, t); h.gain.exponentialRampToValueAtTime(0.001, t + 0.3); h.connect(e.g);\n  osc(ctx, 'sine', f * 4, det, t, t + 0.4, h);\n}\nexport function bell(ctx, out, t, midi, dur, vel = 0.4, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.002, vel * 0.35, 1.8, 0.001, 0.1, 0.01);\n  const c = osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const m = osc(ctx, 'sine', f * 3.51, det, t, t + 1.2);\n  const i = ctx.createGain(); i.gain.setValueAtTime(f * 1.2, t); i.gain.exponentialRampToValueAtTime(1, t + 1.2);\n  m.connect(i); i.connect(c.frequency);\n}\nexport function pad(ctx, out, t, midi, dur, vel = 0.3, det = 0) {\n  const f = mtof(midi);\n  const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.Q.value = 0.8;\n  lp.frequency.setValueAtTime(f * 1.5, t); lp.frequency.linearRampToValueAtTime(f * 3.4, t + dur * 0.5); lp.frequency.linearRampToValueAtTime(f * 2, t + dur);\n  lp.connect(out);\n  const e = env(ctx, lp, t, Math.min(dur * 0.35, 1.2), vel * 0.26, 0.3, 0.85, Math.min(1.2, dur * 0.3), dur);\n  for (const d of [-7, 0, 7]) osc(ctx, 'sawtooth', f, det + d, t, e.end, e.g);\n}\nexport function brass(ctx, out, t, midi, dur, vel = 0.5, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.02, vel * 0.42, 0.1, 0.55, 0.06, dur);\n  const c = osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const m = osc(ctx, 'sine', f, det, t, e.end);\n  const i = ctx.createGain();\n  i.gain.setValueAtTime(f * 0.5, t); i.gain.linearRampToValueAtTime(f * 2.4, t + 0.04); i.gain.exponentialRampToValueAtTime(f * 1.1, t + 0.18);\n  m.connect(i); i.connect(c.frequency);\n}\nexport function flute(ctx, out, t, midi, dur, vel = 0.4, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.06, vel * 0.42, 0.15, 0.8, 0.12, dur);\n  const c = osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const lfo = osc(ctx, 'sine', 4.6, 0, t + 0.15, e.end);\n  const d = ctx.createGain(); d.gain.value = f * 0.006; lfo.connect(d); d.connect(c.frequency);\n  const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f * 2; bp.Q.value = 6;\n  const n = ctx.createGain(); n.gain.value = 0.3; bp.connect(n); n.connect(e.g);\n  noiseSrc(ctx, t, e.end - t, bp);\n}\nexport function pizz(ctx, out, t, midi, dur, vel = 0.5, det = 0) {\n  const f = mtof(midi);\n  const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.Q.value = 3;\n  lp.frequency.setValueAtTime(f * 7, t); lp.frequency.exponentialRampToValueAtTime(f * 1.5, t + 0.18); lp.connect(out);\n  const e = env(ctx, lp, t, 0.002, vel * 0.55, 0.24, 0.001, 0.02, 0.01);\n  osc(ctx, 'sawtooth', f, det, t, e.end, e.g);\n}\nexport function kick(ctx, out, t, _m, _d, vel = 0.9) {\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(vel, t); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.28); g.connect(out);\n  const o = ctx.createOscillator(); o.type = 'sine';\n  o.frequency.setValueAtTime(120, t); o.frequency.exponentialRampToValueAtTime(45, t + 0.12);\n  o.connect(g); o.start(t); o.stop(t + 0.3);\n}\nexport function snare(ctx, out, t, _m, _d, vel = 0.6) {\n  const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 2100; bp.Q.value = 0.7;\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(vel * 0.75, t); g.gain.setValueAtTime(vel * 0.6, t + 0.09); g.gain.linearRampToValueAtTime(0.0001, t + 0.13);\n  bp.connect(g); g.connect(out);\n  noiseSrc(ctx, t, 0.14, bp);\n  const b = ctx.createGain(); b.gain.setValueAtTime(vel * 0.4, t); b.gain.exponentialRampToValueAtTime(0.0001, t + 0.08); b.connect(out);\n  osc(ctx, 'triangle', 190, 0, t, t + 0.09, b);\n}\nfunction tick(ctx, out, t, freq, q, dur, vel) {\n  const f = ctx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = q;\n  const g = ctx.createGain(); g.gain.setValueAtTime(vel, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  f.connect(g); g.connect(out);\n  noiseSrc(ctx, t, dur + 0.01, f);\n}\nexport const brush = (ctx, out, t, _m, _d, vel = 0.3) => tick(ctx, out, t, 5200, 0.6, 0.09, vel * 0.5);\nexport const shaker = (ctx, out, t, _m, _d, vel = 0.3) => tick(ctx, out, t, 8200, 1.2, 0.045, vel * 0.42);\nexport const hat = (ctx, out, t, _m, _d, vel = 0.3) => tick(ctx, out, t, 9800, 2, 0.03, vel * 0.5);\nexport function woodblock(ctx, out, t, midi, _d, vel = 0.5) {\n  const f = mtof(midi || 84);\n  const g = ctx.createGain(); g.gain.setValueAtTime(vel * 0.5, t); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.06); g.connect(out);\n  osc(ctx, 'sine', f, 0, t, t + 0.07, g);\n  osc(ctx, 'triangle', f * 1.5, 0, t, t + 0.04, g);\n}\nexport function rim(ctx, out, t, _m, _d, vel = 0.4) {\n  const g = ctx.createGain(); g.gain.setValueAtTime(vel * 0.5, t); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.03); g.connect(out);\n  osc(ctx, 'square', 1700, 0, t, t + 0.035, g);\n  tick(ctx, out, t, 3300, 2, 0.02, vel * 0.3);\n}\nexport const INSTRUMENTS = { epiano, clav, bass, softBass, tuba, marimba, vibes, bell, pad, brass, flute, pizz, kick, snare, brush, shaker, hat, woodblock, rim };\nEOF\ncat > src/audio/tracks.js <<'EOF'\n// The score is data. chords: one per bar, 'Root:quality'. parts:\n//  comp: [[step, lenSteps]...] plays the chord; line: [[step, 'r|3|5|7|9|o', lenSteps]...] walks the bass;\n//  hits: 16-char grid; melody: bars of [step, midi, lenSteps]; every: bars a part spans.\nexport const TRACKS = {\n  levelBest: {\n    bpm: 92, swing: 0.14,\n    chords: ['Db:maj9', 'Bb:m9', 'Eb:m9', 'Ab:13', 'Db:maj9', 'Bb:m9', 'Eb:m9', 'Ab:13', 'Gb:maj9', 'F:m7', 'Eb:m9', 'Ab:13sus'],\n    parts: [\n      { inst: 'epiano', comp: [[0, 3], [6, 2], [10, 4]], vel: 0.42 },\n      { inst: 'softBass', line: [[0, 'r', 5], [6, '5', 2], [10, 'r', 2], [14, 'o', 2]], vel: 0.7 },\n      { inst: 'brush', hits: 'x..xx.x.x..xx.x.', vel: 0.32 },\n      { inst: 'rim', hits: '....x.......x...', vel: 0.3 },\n      { inst: 'vibes', vel: 0.75, melody: [\n        [[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]],\n        [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]],\n        [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]],\n        [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]],\n        [[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]],\n        [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]],\n        [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]],\n        [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]],\n        [[0, 77, 3], [3, 78, 1], [4, 80, 2], [6, 73, 4], [12, 75, 2], [14, 77, 2]],\n        [[0, 80, 3], [3, 77, 1], [4, 75, 2], [6, 72, 6], [14, 73, 2]],\n        [[0, 75, 3], [3, 73, 1], [4, 70, 2], [6, 66, 4], [12, 68, 2], [14, 70, 2]],\n        [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 68, 8]],\n      ] },\n    ],\n  },\n  island: {\n    bpm: 84, swing: 0,\n    chords: ['F:maj7', 'A:m7', 'Bb:maj7', 'C:9', 'F:maj7', 'D:m9', 'G:m9', 'C:13'],\n    parts: [\n      { inst: 'marimba', comp: [[0, 2], [3, 1], [6, 2], [10, 2], [13, 2]], vel: 0.45 },\n      { inst: 'softBass', line: [[0, 'r', 3], [3, '5', 1], [6, '5', 2], [8, 'r', 3], [11, '5', 1], [14, 'r', 2]], vel: 0.75 },\n      { inst: 'shaker', hits: 'x.xxx.xxx.xxx.xx', vel: 0.34 },\n      { inst: 'rim', hits: 'x..x..x...x..x..', vel: 0.34 },\n      { inst: 'flute', vel: 0.6, melody: [\n        [[0, 72, 6], [8, 69, 3], [12, 67, 3]],\n        [[0, 69, 8], [10, 67, 2], [12, 64, 4]],\n        [[0, 65, 6], [8, 69, 4], [12, 74, 4]],\n        [[0, 72, 12]],\n        [[0, 76, 4], [4, 77, 2], [6, 76, 2], [8, 72, 6]],\n        [[0, 74, 4], [4, 72, 2], [6, 69, 6], [14, 72, 2]],\n        [[0, 74, 3], [3, 70, 3], [6, 69, 2], [8, 67, 6]],\n        [[0, 65, 4], [4, 67, 4], [8, 70, 2], [10, 69, 6]],\n      ] },\n    ],\n  },\n  stillness: {\n    bpm: 60, swing: 0, free: true,\n    chords: ['D:maj9', 'D:maj9', 'E:maj9', 'E:maj9'],\n    parts: [\n      { inst: 'pad', comp: [[0, 32]], every: 2, vel: 0.6, spread: 1 },\n      { inst: 'softBass', line: [[0, 'r', 14]], every: 2, vel: 0.35 },\n      { inst: 'bell', melody: [[[0, 81, 8], [8, 85, 8]], [[0, 78, 8], [8, 76, 8]], [[0, 83, 8], [8, 80, 8]], [[0, 85, 8], [8, 76, 8]]], vel: 0.5 },\n      { inst: 'flute', vel: 0.42, melody: [\n        [[4, 74, 10]], [[0, 73, 6], [8, 69, 8]], [[4, 76, 10]], [[0, 75, 6], [8, 71, 8]],\n      ] },\n    ],\n  },\n  strength: {\n    bpm: 100, swing: 0.08,\n    chords: ['E:m9', 'A:13'],\n    parts: [\n      { inst: 'bass', line: [[0, 'r', 2], [3, 'r', 1], [4, 'o', 1], [6, '7', 1], [8, 'r', 2], [10, '5', 1], [12, 'o', 1], [14, 'r', 1], [15, '7', 1]], vel: 0.85, oct: 12 },\n      { inst: 'clav', comp: [[2, 1], [4, 1], [7, 1], [10, 1], [12, 1], [15, 1]], vel: 0.6 },\n      { inst: 'brass', comp: [[6, 2], [14, 2]], everyBar: 2, vel: 0.5 },\n      { inst: 'kick', hits: 'x.....x.x.......', vel: 0.85 },\n      { inst: 'snare', hits: '....x.......x...', vel: 0.55 },\n      { inst: 'hat', hits: 'x.x.x.x.x.x.x.x.', vel: 0.3 },\n    ],\n  },\n  cardio: {\n    bpm: 116, swing: 0,\n    chords: ['Db:maj7', 'C:m7', 'Bb:m7', 'Eb:sus'],\n    parts: [\n      { inst: 'kick', hits: 'x...x...x...x...', vel: 0.9 },\n      { inst: 'snare', hits: '....x.......x...', vel: 0.5 },\n      { inst: 'hat', hits: '..x...x...x...x.', vel: 0.4 },\n      { inst: 'bass', line: [[0, 'r', 2], [2, 'o', 2], [4, 'r', 2], [6, 'o', 2], [8, 'r', 2], [10, 'o', 2], [12, 'r', 2], [14, 'o', 2]], vel: 0.8, oct: 12 },\n      { inst: 'epiano', comp: [[0, 2], [3, 2], [6, 2], [11, 3]], vel: 0.5 },\n      { inst: 'brass', comp: [[14, 2]], vel: 0.5 },\n      { inst: 'vibes', vel: 0.5, melody: [\n        [[0, 77, 2], [3, 80, 2], [6, 84, 4], [12, 82, 2], [14, 80, 2]],\n        [[0, 79, 2], [3, 75, 2], [6, 79, 4], [12, 77, 4]],\n        [[0, 77, 2], [3, 73, 2], [6, 77, 4], [12, 80, 2], [14, 77, 2]],\n        [[0, 75, 6], [8, 70, 2], [10, 72, 2], [12, 75, 4]],\n      ] },\n    ],\n  },\n  balance: {\n    bpm: 118, swing: 0.1,\n    chords: ['C:6', 'A:m7', 'D:m7', 'G:7'],\n    parts: [\n      { inst: 'tuba', line: [[0, 'r', 3], [8, '5', 3]], vel: 0.8 },\n      { inst: 'marimba', comp: [[4, 1], [6, 1], [12, 1], [14, 1]], vel: 0.5 },\n      { inst: 'pizz', vel: 0.55, melody: [\n        [[0, 76, 2], [2, 79, 2], [4, 84, 2], [6, 81, 2], [8, 79, 2], [12, 76, 2]],\n        [[0, 72, 2], [2, 76, 2], [4, 81, 2], [6, 79, 2], [8, 76, 4], [14, 74, 2]],\n        [[0, 77, 2], [2, 81, 2], [4, 86, 2], [6, 84, 2], [8, 81, 2], [12, 77, 2]],\n        [[0, 79, 2], [2, 83, 2], [4, 86, 2], [6, 83, 2], [8, 79, 2], [10, 77, 2], [12, 74, 2], [14, 71, 2]],\n      ] },\n      { inst: 'woodblock', hits: '..x...x...x..xx.', vel: 0.34, note: 84 },\n      { inst: 'shaker', hits: 'x.x.x.x.x.x.x.x.', vel: 0.24 },\n    ],\n  },\n  level: {\n    // Starts as bare e-piano of the title theme, then every instrument, slower, in tune.\n    bpm: 76, swing: 0.1, sections: true,\n    chords: ['Db:maj9', 'Bb:m9', 'Eb:m9', 'Ab:13', 'Db:maj9', 'Bb:m9', 'Eb:m9', 'Ab:13', 'Gb:maj9', 'F:m7', 'Eb:m9', 'Ab:13sus'],\n    parts: [\n      { inst: 'epiano', comp: [[0, 8], [8, 6]], vel: 0.4 },\n      { inst: 'epiano', vel: 0.7, melody: [\n        [[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]],\n        [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]],\n        [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]],\n        [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]],\n      ] },\n      { inst: 'pad', comp: [[0, 16]], from: 4, vel: 0.5 },\n      { inst: 'softBass', line: [[0, 'r', 6], [8, '5', 4], [14, 'o', 2]], from: 4, vel: 0.7 },\n      { inst: 'brush', hits: 'x..xx.x.x..xx.x.', from: 8, vel: 0.32 },\n      { inst: 'vibes', from: 8, vel: 0.5, melody: [\n        [[0, 89, 3], [3, 87, 1], [4, 85, 2], [6, 80, 4]], [[0, 85, 3], [4, 82, 2], [6, 77, 6]], [[0, 82, 3], [4, 78, 2], [6, 75, 4]], [[0, 80, 3], [4, 84, 2], [6, 87, 6]],\n      ] },\n      { inst: 'flute', from: 12, vel: 0.5, melody: [\n        [[0, 77, 6], [8, 80, 6]], [[0, 77, 12]], [[0, 78, 6], [8, 75, 6]], [[0, 80, 14]],\n      ] },\n      { inst: 'brass', comp: [[0, 3], [10, 3]], from: 16, vel: 0.35 },\n    ],\n  },\n};\n// Short pieces: [time in beats, instrument, midi, beats, velocity]. Three seconds or less.\nexport const STINGS = {\n  attended: { bpm: 110, notes: [[0, 'marimba', 67, 1, 0.8], [0.5, 'marimba', 64, 1, 0.8], [1, 'marimba', 60, 2, 0.9]] },\n  adequate: { bpm: 120, notes: [[0, 'marimba', 60, 1, 0.8], [0.5, 'marimba', 64, 1, 0.8], [1, 'marimba', 67, 2, 0.9]] },\n  pleasant: { bpm: 120, notes: [[0, 'vibes', 72, 1, 0.8], [0.5, 'vibes', 76, 1, 0.8], [1, 'vibes', 79, 1, 0.8], [1.5, 'vibes', 84, 2, 0.9]] },\n  exemplary: { bpm: 130, notes: [[0, 'brass', 67, 0.5, 0.8], [0.5, 'brass', 72, 0.5, 0.8], [1, 'brass', 76, 0.5, 0.8], [1.5, 'brass', 79, 2, 1], [1.5, 'brass', 84, 2, 0.8], [1.5, 'kick', 36, 1, 0.8]] },\n  suspicious: { bpm: 110, notes: [[0, 'vibes', 76, 1, 0.9], [0.5, 'vibes', 75, 1, 0.9], [1, 'vibes', 76, 1, 0.9], [1.5, 'vibes', 75, 1, 0.9], [2, 'brass', 72, 2, 0.8], [2, 'brass', 78, 2, 0.7]] },\n  reveal: { bpm: 100, notes: [[0, 'brass', 60, 0.5, 1], [0, 'brass', 66, 0.5, 0.8], [0.5, 'kick', 36, 1, 1], [0.5, 'bell', 84, 3, 0.9]] },\n  unlock: { bpm: 150, notes: [[0, 'marimba', 72, 1, 0.9], [0.5, 'marimba', 76, 1, 0.9], [1, 'marimba', 79, 1, 0.9], [1.5, 'marimba', 84, 1, 0.9], [2, 'bell', 88, 3, 0.8]] },\n  ending: { bpm: 70, notes: [[0, 'bell', 73, 3, 0.8], [0.5, 'bell', 77, 3, 0.8], [1, 'bell', 80, 3, 0.8], [1.5, 'bell', 85, 3, 0.9]] },\n};\nexport const ROOTS = { C: 36, Db: 37, D: 38, Eb: 39, E: 40, F: 41, Gb: 42, G: 43, Ab: 44, A: 45, Bb: 46, B: 47 };\nexport const QUALITY = {\n  maj7: [0, 4, 7, 11], maj9: [4, 7, 11, 14], m7: [0, 3, 7, 10], m9: [3, 7, 10, 14], 9: [4, 7, 10, 14], 13: [4, 10, 14, 21],\n  '13sus': [5, 10, 14, 21], sus: [5, 7, 10, 14], 6: [0, 4, 7, 9], 7: [0, 4, 7, 10],\n};\nEOF\ncat > src/audio/sequencer.js <<'EOF'\nimport { INSTRUMENTS } from './instruments.js';\nimport { TRACKS, ROOTS, QUALITY } from './tracks.js';\n\nexport function parseChord(name) {\n  const [root, q] = name.split(':');\n  const r = ROOTS[root], iv = QUALITY[q];\n  const notes = iv.map((i) => {\n    let n = r + 24 + i;\n    while (n < 56) n += 12;\n    while (n > 76) n -= 12;\n    return n;\n  });\n  return { root: r, notes, iv };\n}\nconst DEG = { r: 0, 3: 1, 5: 2, 7: 3, 9: 3 };\nfunction bassNote(ch, sym) {\n  if (sym === 'r') return ch.root;\n  if (sym === 'o') return ch.root + 12;\n  const third = ch.iv.find((i) => i === 3 || i === 4 || i === 5) ?? 4;\n  if (sym === '3') return ch.root + third;\n  if (sym === '5') return ch.root + 7;\n  if (sym === '7') return ch.root + (ch.iv.includes(11) ? 11 : 10);\n  return ch.root + (DEG[sym] || 0);\n}\n/** Emit every note of bar b: fn(time, inst, midi, lenSec, vel). */\nexport function emitBar(track, b, t0, stepDur, fn) {\n  const chords = track.chords;\n  const chord = parseChord(chords[b % chords.length]);\n  const sw = (step) => (step % 2 === 1 ? (track.swing || 0) * stepDur : 0);\n  for (const p of track.parts) {\n    if (p.from !== undefined && b < p.from) continue;\n    if (p.every && b % p.every !== 0) continue;\n    if (p.everyBar && b % p.everyBar !== p.everyBar - 1) continue;\n    const vel = p.vel ?? 0.5;\n    if (p.comp) {\n      for (const [s, len] of p.comp) for (const n of chord.notes) fn(t0 + s * stepDur + sw(s), p.inst, n, len * stepDur, vel);\n    } else if (p.line) {\n      for (const [s, sym, len] of p.line) fn(t0 + s * stepDur + sw(s), p.inst, bassNote(chord, sym) + (p.oct || 0), len * stepDur, vel);\n    } else if (p.hits) {\n      for (let s = 0; s < 16; s++) if (p.hits[s] === 'x') fn(t0 + s * stepDur + sw(s), p.inst, p.note || 60, stepDur, vel);\n    } else if (p.melody) {\n      const bar = p.melody[b % p.melody.length];\n      for (const [s, n, len] of bar) fn(t0 + s * stepDur + sw(s), p.inst, n, len * stepDur, vel);\n    }\n  }\n}\n\n/** Look-ahead scheduler on currentTime. One track at a time, with a fade on change. */\nexport class Sequencer {\n  constructor(mix) {\n    this.mix = mix; this.track = null; this.id = null; this.gain = null;\n    this.bar = 0; this.barTime = 0; this.startTime = 0; this.paused = false; this.pausedPos = 0;\n    this.tiltDeg = 0; this.ahead = 0.15; this.lastTick = 0; this.bpm = 0;\n  }\n  play(id, { bpm = null, at = null, fade = 0.5, sectionOffset = 0 } = {}) {\n    const track = TRACKS[id];\n    if (!track) return;\n    if (this.id === id && !bpm && !at) return;\n    this.stop(fade);\n    const ctx = this.mix.ctx;\n    this.gain = ctx.createGain();\n    const t = at ?? ctx.currentTime + 0.05;\n    this.gain.gain.setValueAtTime(0.0001, ctx.currentTime);\n    this.gain.gain.linearRampToValueAtTime(1, Math.max(t, ctx.currentTime + 0.02));\n    this.gain.connect(this.mix.music);\n    const send = ctx.createGain(); send.gain.value = 0.2; this.gain.connect(send); send.connect(this.mix.reverb);\n    this.track = track; this.id = id; this.bpm = bpm || track.bpm;\n    this.bar = sectionOffset; this.startTime = t; this.barTime = t; this.paused = false;\n  }\n  stop(fade = 0.5) {\n    if (!this.gain) { this.track = null; this.id = null; return; }\n    const ctx = this.mix.ctx, g = this.gain;\n    g.gain.cancelScheduledValues(ctx.currentTime);\n    g.gain.setValueAtTime(g.gain.value, ctx.currentTime);\n    g.gain.linearRampToValueAtTime(0.0001, ctx.currentTime + Math.max(0.02, fade));\n    this.gain = null; this.track = null; this.id = null;\n  }\n  get stepDur() { return 60 / this.bpm / 4; }\n  /** Seconds since this track started. */\n  position() { return this.track ? (this.paused ? this.pausedPos : this.mix.ctx.currentTime - this.startTime) : 0; }\n  pause() { if (this.track && !this.paused) { this.pausedPos = this.position(); this.paused = true; } }\n  resume() {\n    if (!this.paused) return;\n    this.paused = false;\n    if (!this.track) return;\n    const ctx = this.mix.ctx, dt = ctx.currentTime + 0.05 - (this.startTime + this.pausedPos);\n    this.startTime += dt; this.barTime += dt;\n  }\n  /** Detune while the island is crooked: tilt° × 1.6 × sin(t × 0.7) cents. Zero when level. */\n  detuneAt(t) { return this.tiltDeg * 1.6 * Math.sin(t * 0.7); }\n  tick() {\n    if (!this.track || this.paused) return;\n    const ctx = this.mix.ctx;\n    const now = ctx.currentTime;\n    if (now < this.lastTick) this.lastTick = now;\n    const ahead = this.ahead;\n    let guard = 0;\n    if (this.barTime < now - 2) {\n      const barDur = this.stepDur * 16;\n      const skip = Math.floor((now - this.barTime) / barDur);\n      this.barTime += skip * barDur; this.bar += skip;\n    }\n    while (this.barTime < now + ahead && guard++ < 8) {\n      this._emit(this.bar, this.barTime);\n      this.barTime += this.stepDur * 16; this.bar++;\n    }\n  }\n  _emit(bar, t0) {\n    const ctx = this.mix.ctx, gain = this.gain;\n    emitBar(this.track, bar, t0, this.stepDur, (t, inst, midi, len, vel) => {\n      const f = INSTRUMENTS[inst];\n      if (f) f(ctx, gain, t, midi, len, vel, this.detuneAt(t));\n    });\n  }\n}\nEOF\ncat > src/audio/sfx.js <<'EOF'\nimport { noiseSrc, mtof, INSTRUMENTS } from './instruments.js';\n\nconst rnd = (m, a, b) => a + (b - a) * m.r();\n\nfunction burst(m, t, out, freq, q, dur, vel, type = 'bandpass', rate = 1) {\n  const ctx = m.ctx;\n  const f = ctx.createBiquadFilter(); f.type = type; f.frequency.value = freq; f.Q.value = q;\n  const g = ctx.createGain(); g.gain.setValueAtTime(vel, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  f.connect(g); g.connect(out);\n  noiseSrc(ctx, t, dur + 0.02, f, rate);\n  return f;\n}\nfunction tone(m, t, out, type, f0, f1, dur, vel, a = 0.003) {\n  const ctx = m.ctx;\n  const o = ctx.createOscillator(); o.type = type;\n  o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), t + dur);\n  const g = ctx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(vel, t + a); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  o.connect(g); g.connect(out); o.start(t); o.stop(t + dur + 0.02);\n  return o;\n}\n\nexport const SFX = {\n  clack(m, t, o = {}) { // wood clack: three resonant noise bursts, tuned per limb\n    const base = o.pitch || rnd(m, 700, 1200);\n    burst(m, t, m.sfx, base, 11, 0.05, 0.75);\n    burst(m, t + rnd(m, 0.02, 0.05), m.sfx, base * 1.34, 12, 0.04, 0.5);\n    burst(m, t + rnd(m, 0.06, 0.11), m.sfx, base * 0.72, 10, 0.05, 0.45);\n  },\n  fall(m, t) { for (let i = 0; i < 6; i++) SFX.clack(m, t + i * 0.07 + rnd(m, 0, 0.03), { pitch: rnd(m, 500, 1300) }); },\n  spring(m, t) { // toy spring: rising sine with vibrato\n    const o = tone(m, t, m.sfx, 'sine', 180, 900, 0.34, 0.5);\n    const l = m.ctx.createOscillator(); l.frequency.value = 26;\n    const g = m.ctx.createGain(); g.gain.value = 60; l.connect(g); g.connect(o.frequency); l.start(t); l.stop(t + 0.36);\n  },\n  splash(m, t, o = {}) {\n    const big = o.big ?? 1;\n    const f = burst(m, t, m.sfx, 3200, 0.5, 0.7 * big + 0.2, 0.7, 'lowpass');\n    f.frequency.setValueAtTime(5200, t); f.frequency.exponentialRampToValueAtTime(420, t + 0.6 * big + 0.2);\n    for (let i = 0; i < 4; i++) tone(m, t + 0.05 + i * 0.06, m.sfx, 'sine', rnd(m, 500, 1100), rnd(m, 200, 500), 0.08, 0.1);\n    if (big > 1) tone(m, t, m.sfx, 'sine', 110, 44, 0.35, 0.5);\n  },\n  marble(m, t, o = {}) { tone(m, t, m.sfx, 'sine', o.pitch || rnd(m, 1800, 3900), rnd(m, 1500, 3000), 0.05, 0.22); },\n  marbleRoll(m, t) { for (let i = 0; i < 5; i++) tone(m, t + i * 0.035, m.sfx, 'sine', rnd(m, 1600, 3600), rnd(m, 1400, 3000), 0.03, 0.1); },\n  plateHum(m, t, o = {}) { tone(m, t, m.sfx, 'sine', o.pitch || 320, (o.pitch || 320) * 1.02, 0.12, 0.08, 0.03); },\n  plateCrash(m, t) {\n    burst(m, t, m.sfx, 4200, 3, 0.26, 0.6);\n    for (let i = 0; i < 6; i++) tone(m, t + i * 0.03, m.sfx, 'triangle', rnd(m, 1800, 4800), rnd(m, 1400, 3200), 0.1, 0.18);\n  },\n  thud(m, t, o = {}) { tone(m, t, m.sfx, 'sine', o.pitch || 190, 70, 0.11, 0.6); burst(m, t, m.sfx, 900, 1, 0.04, 0.2); },\n  spike(m, t) { tone(m, t, m.sfx, 'sawtooth', 1500, 240, 0.14, 0.35); burst(m, t, m.sfx, 5000, 2, 0.06, 0.3); },\n  whistle(m, t) {\n    const o = tone(m, t, m.sfx, 'square', 2300, 2500, 0.5, 0.2, 0.02);\n    const l = m.ctx.createOscillator(); l.frequency.value = 38;\n    const g = m.ctx.createGain(); g.gain.value = 130; l.connect(g); g.connect(o.frequency); l.start(t); l.stop(t + 0.52);\n  },\n  bell(m, t) { INSTRUMENTS.bell(m.ctx, m.sfx, t, 84, 1, 1.1); INSTRUMENTS.bell(m.ctx, m.sfx, t + 0.02, 91, 1, 0.5); },\n  breathIn(m, t, o = {}) { const f = burst(m, t, m.sfx, 900, 1, o.dur || 2, 0.05); f.frequency.setValueAtTime(600, t); f.frequency.linearRampToValueAtTime(2200, t + (o.dur || 2)); },\n  breathOut(m, t, o = {}) { const f = burst(m, t, m.sfx, 900, 1, o.dur || 2, 0.05); f.frequency.setValueAtTime(1800, t); f.frequency.linearRampToValueAtTime(500, t + (o.dur || 2)); },\n  gust(m, t, o = {}) { // rising band-passed noise\n    const d = o.dur || 1.1;\n    const f = m.ctx.createBiquadFilter(); f.type = 'bandpass'; f.Q.value = 2.2;\n    f.frequency.setValueAtTime(320, t); f.frequency.exponentialRampToValueAtTime(1900, t + d * 0.8);\n    const g = m.ctx.createGain(); g.gain.setValueAtTime(0.001, t); g.gain.linearRampToValueAtTime(0.5, t + d * 0.8); g.gain.exponentialRampToValueAtTime(0.001, t + d + 0.4);\n    f.connect(g); g.connect(m.sfx);\n    noiseSrc(m.ctx, t, d + 0.45, f);\n  },\n  creak(m, t, o = {}) { // slow saw through a resonant filter\n    const d = o.dur || 1.8;\n    const os = m.ctx.createOscillator(); os.type = 'sawtooth';\n    os.frequency.setValueAtTime(42, t); os.frequency.linearRampToValueAtTime(58, t + d * 0.4); os.frequency.linearRampToValueAtTime(36, t + d);\n    const f = m.ctx.createBiquadFilter(); f.type = 'bandpass'; f.Q.value = 16;\n    f.frequency.setValueAtTime(420, t); f.frequency.linearRampToValueAtTime(820, t + d * 0.55); f.frequency.linearRampToValueAtTime(330, t + d);\n    const g = m.ctx.createGain(); g.gain.setValueAtTime(0.001, t); g.gain.linearRampToValueAtTime(0.7, t + 0.15); g.gain.setValueAtTime(0.7, t + d * 0.7); g.gain.exponentialRampToValueAtTime(0.001, t + d);\n    os.connect(f); f.connect(g); g.connect(m.sfx); os.start(t); os.stop(t + d + 0.02);\n  },\n  uiMove(m, t) { INSTRUMENTS.woodblock(m.ctx, m.sfx, t, 79, 0, 0.5); },\n  uiConfirm(m, t) { INSTRUMENTS.woodblock(m.ctx, m.sfx, t, 84, 0, 0.7); INSTRUMENTS.woodblock(m.ctx, m.sfx, t + 0.07, 91, 0, 0.7); },\n  uiBack(m, t) { INSTRUMENTS.woodblock(m.ctx, m.sfx, t, 76, 0, 0.6); INSTRUMENTS.woodblock(m.ctx, m.sfx, t + 0.07, 69, 0, 0.6); },\n  stamp(m, t) { tone(m, t, m.sfx, 'sine', 150, 50, 0.16, 0.9); burst(m, t, m.sfx, 1400, 1, 0.05, 0.4); },\n  drumRoll(m, t, o = {}) {\n    const d = o.dur || 2;\n    let at = t, i = 0;\n    while (at < t + d) { burst(m, at, m.sfx, 2400, 0.8, 0.05, 0.18 + (0.4 * (at - t)) / d); at += 0.045; i++; }\n    return i;\n  },\n  foot(m, t, o = {}) { // Step Class's click: music is only 10%, so the beat must read without it\n    INSTRUMENTS.woodblock(m.ctx, m.sfx, t, o.note || 88, 0, o.vel || 0.9);\n  },\n  metronome(m, t, o = {}) { INSTRUMENTS.rim(m.ctx, m.sfx, t, 0, 0, o.vel || 0.8); },\n  squawk(m, t) { // Gary: FM squawk\n    const c = tone(m, t, m.sfx, 'sawtooth', 780, 520, 0.28, 0.32, 0.01);\n    const mod = m.ctx.createOscillator(); mod.frequency.value = 62;\n    const g = m.ctx.createGain(); g.gain.value = 460; mod.connect(g); g.connect(c.frequency); mod.start(t); mod.stop(t + 0.3);\n  },\n  boing(m, t) { tone(m, t, m.sfx, 'triangle', 120, 480, 0.25, 0.5); },\n  sneeze(m, t) { burst(m, t, m.sfx, 2600, 0.8, 0.22, 0.7); tone(m, t, m.sfx, 'sawtooth', 420, 170, 0.18, 0.3); },\n  catch(m, t) { tone(m, t, m.sfx, 'sine', mtof(72 + Math.floor(rnd(m, 0, 8))), 300, 0.1, 0.4); burst(m, t, m.sfx, 700, 1.2, 0.05, 0.3); },\n  gullLand(m, t) { burst(m, t, m.sfx, 1800, 1, 0.1, 0.2); tone(m, t, m.sfx, 'sine', 300, 160, 0.08, 0.2); },\n  whoosh(m, t) { const f = burst(m, t, m.sfx, 800, 1.1, 0.4, 0.3); f.frequency.setValueAtTime(400, t); f.frequency.exponentialRampToValueAtTime(2800, t + 0.34); },\n};\nEOF\ncat > src/audio/voice.js <<'EOF'\nimport { noiseSrc } from './instruments.js';\n\n// Animalese-style gibberish, spoken from each line's own text.\nexport const VOICES = {\n  trudy: { name: 'Trudy', pitch: 420, rate: 16, type: 'square', drift: 22, formant: 1.25, gain: 0.3, q: 7, breath: 0 },\n  stillwater: { name: 'Ms. Stillwater', pitch: 170, rate: 7, type: 'sawtooth', drift: 5, formant: 0.8, gain: 1.05, q: 5, breath: 0.45, gap: 1.5 },\n  bolster: { name: 'Coach Bolster', pitch: 95, rate: 11, type: 'sawtooth', drift: 12, formant: 0.72, gain: 1.15, q: 4, breath: 0 },\n  guest: { name: 'Guest', pitch: 260, rate: 12, type: 'square', drift: 18, formant: 1, gain: 0.55, q: 6, breath: 0 },\n  margaret: { name: 'Gentle Margaret', pitch: 300, rate: 11, type: 'square', drift: 12, formant: 1.1, gain: 0.55, q: 6, breath: 0.1 },\n  kevin: { name: 'Retired Kevin', pitch: 205, rate: 10, type: 'sawtooth', drift: 8, formant: 0.9, gain: 0.7, q: 5, breath: 0 },\n  sandras: { name: 'Both Sandras', pitch: 320, rate: 13, type: 'square', drift: 16, formant: 1.15, gain: 0.55, q: 6, breath: 0, double: 1.26 },\n  paul: { name: 'Unsteady Paul', pitch: 235, rate: 12, type: 'square', drift: 38, formant: 0.95, gain: 0.6, q: 6, breath: 0 },\n  gerald: { name: 'Young Gerald', pitch: 200, rate: 9, type: 'sawtooth', drift: 30, formant: 0.85, gain: 0.7, q: 5, breath: 0.2 },\n};\nconst FORMANTS = { a: [730, 1090], e: [530, 1840], i: [300, 2300], o: [570, 840], u: [340, 870] };\nconst EXCLAIM = ['Wobba-la!', 'Oof-ah.', 'Nee nee!', 'Sul-sul-oh?', 'Hoppa!', 'Mm-bah.'];\nexport const nonsense = (i) => EXCLAIM[i % EXCLAIM.length];\n\nfunction blip(m, out, t, f, vowel, v, dur, r) {\n  const ctx = m.ctx;\n  const [f1, f2] = FORMANTS[vowel] || FORMANTS.a;\n  const o = ctx.createOscillator(); o.type = v.type; o.frequency.setValueAtTime(f, t);\n  const b1 = ctx.createBiquadFilter(); b1.type = 'bandpass'; b1.frequency.value = f1 * v.formant; b1.Q.value = v.q;\n  const b2 = ctx.createBiquadFilter(); b2.type = 'bandpass'; b2.frequency.value = f2 * v.formant; b2.Q.value = v.q;\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(v.gain, t + 0.008); g.gain.exponentialRampToValueAtTime(0.001, t + dur);\n  o.connect(b1); o.connect(b2); b1.connect(g); b2.connect(g); g.connect(out);\n  o.start(t); o.stop(t + dur + 0.01);\n  if (v.breath) {\n    const n = ctx.createBiquadFilter(); n.type = 'bandpass'; n.frequency.value = f2 * v.formant; n.Q.value = 1.2;\n    const ng = ctx.createGain(); ng.gain.setValueAtTime(v.gain * v.breath * 0.5, t); ng.gain.exponentialRampToValueAtTime(0.001, t + dur);\n    n.connect(ng); ng.connect(out);\n    noiseSrc(ctx, t, dur + 0.01, n);\n  }\n  if (r() < 0.35) {\n    const c = ctx.createBiquadFilter(); c.type = 'highpass'; c.frequency.value = 3200;\n    const cg = ctx.createGain(); cg.gain.setValueAtTime(v.gain * 0.3, t); cg.gain.exponentialRampToValueAtTime(0.001, t + 0.012);\n    c.connect(cg); cg.connect(out);\n    noiseSrc(ctx, t, 0.016, c);\n  }\n}\n\n/**\n * Schedule a line of gibberish. Returns its length in seconds and how many blips it fired.\n * Pitch rises on ?, jumps on !, falls at the end of a sentence.\n */\nexport function speak(m, out, voiceId, text, t0, r) {\n  const v = VOICES[voiceId] || VOICES.guest;\n  const step = 1 / v.rate;\n  let t = t0, blips = 0;\n  const s = String(text).toLowerCase();\n  // Walk the letters; each syllable-group (a vowel run) fires one blip.\n  let i = 0;\n  const n = s.length;\n  while (i < n) {\n    const c = s[i];\n    if (c === ' ') { t += step * 0.9; i++; continue; }\n    if (c === ',' || c === ';' || c === ':') { t += step * 3 * (v.gap || 1); i++; continue; }\n    if (c === '.' || c === '!' || c === '?') { t += step * 5 * (v.gap || 1); i++; continue; }\n    if (!/[a-z]/.test(c)) { i++; continue; }\n    let j = i;\n    let vowel = 'a';\n    let found = false;\n    while (j < n && /[a-z]/.test(s[j])) {\n      if ('aeiou'.includes(s[j]) && !found) { vowel = s[j]; found = true; }\n      j++;\n      if (found && !'aeiou'.includes(s[j] || ' ')) break;\n    }\n    const rest = s.slice(j);\n    const m2 = rest.match(/[.!?]/);\n    const end = m2 ? m2[0] : '';\n    const toEnd = m2 ? m2.index : 99;\n    let p = v.pitch * (1 + ((r() - 0.5) * v.drift) / 100);\n    if (end === '?' && toEnd < 7) p *= 1 + (7 - toEnd) * 0.035;\n    if (end === '!') p *= 1.12;\n    if (end === '.' && toEnd < 7) p *= 1 - (7 - toEnd) * 0.018;\n    blip(m, out, t, p, vowel, v, 0.06 + (v.breath ? 0.03 : 0), r);\n    if (v.double) blip(m, out, t + 0.012, p * v.double, vowel, v, 0.06, r);\n    blips++;\n    t += step * Math.max(1, Math.min(3, j - i));\n    i = j;\n  }\n  return { duration: Math.max(0.2, t - t0), blips };\n}\nEOF\ncat > src/audio/engine.js <<'EOF'\nimport { Sequencer } from './sequencer.js';\nimport { SFX } from './sfx.js';\nimport { speak } from './voice.js';\nimport { STINGS } from './tracks.js';\nimport { INSTRUMENTS } from './instruments.js';\nimport { mulberry32 } from '../core/rng.js';\n\n/** buses (music, sfx, voice) → master compressor → destination. Works on any context. */\nexport class Mix {\n  constructor(ctx) {\n    this.ctx = ctx;\n    this.r = mulberry32(4242);\n    this.master = ctx.createDynamicsCompressor();\n    this.master.threshold.value = -10; this.master.ratio.value = 5; this.master.attack.value = 0.004; this.master.release.value = 0.2;\n    this.master.connect(ctx.destination);\n    this.music = ctx.createGain(); this.sfx = ctx.createGain(); this.voice = ctx.createGain();\n    this.music.connect(this.master); this.sfx.connect(this.master); this.voice.connect(this.master);\n    this.reverb = ctx.createConvolver();\n    this.reverb.buffer = this._impulse(1.9);\n    const wet = ctx.createGain(); wet.gain.value = 0.5;\n    this.reverb.connect(wet); wet.connect(this.music);\n    this.setLevels(10, 80, 80);\n    this.seq = new Sequencer(this);\n  }\n  _impulse(sec) {\n    const ctx = this.ctx, len = Math.floor(ctx.sampleRate * sec);\n    const b = ctx.createBuffer(2, len, ctx.sampleRate);\n    const r = mulberry32(777);\n    for (let ch = 0; ch < 2; ch++) {\n      const d = b.getChannelData(ch);\n      for (let i = 0; i < len; i++) d[i] = (r() * 2 - 1) * (1 - i / len) ** 3.2;\n    }\n    return b;\n  }\n  setLevels(music, sfx, voice) {\n    const t = this.ctx.currentTime;\n    this.music.gain.setValueAtTime(music / 100, t); this.sfx.gain.setValueAtTime(sfx / 100, t); this.voice.gain.setValueAtTime(voice / 100, t);\n    this.levels = { music: music / 100, sfx: sfx / 100, voice: voice / 100 };\n  }\n  sting(name, at) {\n    const s = STINGS[name];\n    if (!s) return;\n    const beat = 60 / s.bpm, t0 = at ?? this.ctx.currentTime + 0.01;\n    for (const [b, inst, midi, dur, vel] of s.notes) INSTRUMENTS[inst](this.ctx, this.sfx, t0 + b * beat, midi, dur * beat, vel * 0.8, 0);\n  }\n  playSfx(name, at, o) {\n    const f = SFX[name];\n    if (f) f(this, at ?? this.ctx.currentTime + 0.005, o);\n  }\n}\n\n/** The live mix. It starts on the first gesture, pad input included. Until then all of this is silent and harmless. */\nexport class AudioEngine {\n  constructor(settings) {\n    this.settings = settings;\n    this.ctx = null; this.mix = null; this.gestured = false; this.gestureT = 0;\n    this.analysers = {};\n    this.disabled = false; this.lineGain = null;\n    try {\n      const AC = window.AudioContext || window.webkitAudioContext;\n      if (AC) { this.ctx = new AC({ latencyHint: 'interactive' }); this.mix = new Mix(this.ctx); this._analyse(); }\n    } catch (e) { this.disabled = true; }\n    this.applyLevels();\n    this._timer = null;\n    if (this.ctx) this._timer = setInterval(() => this.tick(), 25);\n  }\n  _analyse() {\n    for (const k of ['music', 'sfx', 'voice']) {\n      const a = this.ctx.createAnalyser(); a.fftSize = 1024;\n      this.mix[k].connect(a);\n      this.analysers[k] = a;\n    }\n  }\n  /** Peak level on a bus right now, 0 to 1. */\n  level(bus) {\n    const a = this.analysers[bus];\n    if (!a) return 0;\n    const b = new Float32Array(a.fftSize); a.getFloatTimeDomainData(b);\n    let p = 0;\n    for (let i = 0; i < b.length; i++) p = Math.max(p, Math.abs(b[i]));\n    return p;\n  }\n  get state() { return this.ctx ? this.ctx.state : 'none'; }\n  get seq() { return this.mix ? this.mix.seq : null; }\n  gesture() {\n    this.gestured = true;\n    if (this.ctx && this.ctx.state === 'suspended') { const p = this.ctx.resume(); if (p && p.catch) p.catch(() => {}); }\n  }\n  applyLevels() {\n    if (!this.mix) return;\n    const s = this.settings();\n    this.mix.setLevels(s.music, s.sound, s.voice);\n  }\n  /** A pad-only player whose browser wouldn't unlock audio gets a small tag asking for a key. */\n  stuck() { return !!(this.ctx && this.gestured && this.ctx.state === 'suspended'); }\n  tick() {\n    if (!this.mix) return;\n    if (this.ctx.state !== 'running') return;\n    this.mix.seq.tick();\n  }\n  music(id, o) { if (this.mix) this.mix.seq.play(id, o); }\n  stopMusic(fade) { if (this.mix) this.mix.seq.stop(fade); }\n  get musicId() { return this.mix ? this.mix.seq.id : null; }\n  setTilt(deg) { if (this.mix) this.mix.seq.tiltDeg = deg; this.tiltDeg = deg; }\n  detuneNow() { return this.mix ? this.mix.seq.detuneAt(this.ctx.currentTime) : 0; }\n  sfx(name, o) { if (this.mix && this.ctx.state === 'running') this.mix.playSfx(name, undefined, o); }\n  sting(name) { if (this.mix && this.ctx.state === 'running') this.mix.sting(name); }\n  /** Speak a line. Stopping a line silences what remains of it. */\n  say(voiceId, text) {\n    if (!this.mix || this.ctx.state !== 'running') return { duration: 0 };\n    this.stopVoice();\n    const g = this.ctx.createGain(); g.connect(this.mix.voice);\n    this.lineGain = g;\n    return speak(this.mix, g, voiceId, text, this.ctx.currentTime + 0.01, this.mix.r);\n  }\n  stopVoice() {\n    if (this.lineGain) {\n      const g = this.lineGain; this.lineGain = null;\n      g.gain.setValueAtTime(g.gain.value, this.ctx.currentTime); g.gain.linearRampToValueAtTime(0, this.ctx.currentTime + 0.03);\n    }\n  }\n  /** Session end: everything stops. */\n  silence() {\n    if (this._timer) clearInterval(this._timer);\n    this._timer = null;\n    if (this.ctx) { const p = this.ctx.suspend(); if (p && p.catch) p.catch(() => {}); }\n  }\n}\nEOF\n","description":"Write the audio engine, instruments, tracks, SFX and voices"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":28652,"cache_read_input_tokens":166129,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":28652},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"b928591b-f288-4949-926d-f532c91e2379","timestamp":"2026-11-05T12:02:19.511Z","request_id":"req_011Cgjk2AjvwhUh9hDsJHBJn","wire_tool_inputs":{"toolu_01WFdEVmLsunqL2yN4mk2kYF":{"command":"cat > src/audio/instruments.js <<'EOF'\n// Every instrument takes (ctx, out, t, midi, dur, vel, det): same code live and offline.\nexport const mtof = (m) => 440 * 2 ** ((m - 69) / 12);\n\nfunction env(ctx, out, t, a, peak, d, sus, r, dur) {\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(0.0001, t);\n  g.gain.linearRampToValueAtTime(peak, t + a);\n  g.gain.exponentialRampToValueAtTime(Math.max(0.0001, sus * peak), t + a + d);\n  const end = Math.max(t + a + d, t + dur);\n  g.gain.setValueAtTime(Math.max(0.0001, sus * peak), end);\n  g.gain.exponentialRampToValueAtTime(0.0001, end + r);\n  g.connect(out);\n  return { g, end: end + r + 0.02 };\n}\nfunction osc(ctx, type, f, det, t, end, dest) {\n  const o = ctx.createOscillator();\n  o.type = type; o.frequency.value = f; o.detune.value = det || 0;\n  if (dest) o.connect(dest);\n  o.start(t); o.stop(end);\n  return o;\n}\nlet noiseBuf = new WeakMap();\nexport function noise(ctx) {\n  let b = noiseBuf.get(ctx);\n  if (!b) {\n    b = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);\n    const d = b.getChannelData(0);\n    let x = 12345;\n    for (let i = 0; i < d.length; i++) { x = (Math.imul(x, 1103515245) + 12345) & 0x7fffffff; d[i] = x / 0x3fffffff - 1; }\n    noiseBuf.set(ctx, b);\n  }\n  return b;\n}\nexport function noiseSrc(ctx, t, dur, dest, rate = 1) {\n  const s = ctx.createBufferSource();\n  s.buffer = noise(ctx); s.loop = true; s.playbackRate.value = rate;\n  s.connect(dest);\n  s.start(t, (t * 7.13) % 1.5); s.stop(t + dur);\n  return s;\n}\n\nexport function epiano(ctx, out, t, midi, dur, vel = 0.5, det = 0, clav = false) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.004, vel * 0.5, clav ? 0.16 : 0.9, clav ? 0.12 : 0.25, clav ? 0.05 : 0.3, dur);\n  const car = osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const tine = osc(ctx, 'sine', f * 14, det, t, t + 0.22);\n  const ti = ctx.createGain();\n  ti.gain.setValueAtTime(f * (clav ? 3.4 : 2.1) * vel, t); ti.gain.exponentialRampToValueAtTime(1, t + (clav ? 0.1 : 0.2));\n  tine.connect(ti); ti.connect(car.frequency);\n  const body = osc(ctx, 'sine', f, det, t, e.end);\n  const bi = ctx.createGain();\n  bi.gain.setValueAtTime(f * 0.9 * vel, t); bi.gain.exponentialRampToValueAtTime(f * 0.1, t + 0.5);\n  body.connect(bi); bi.connect(car.frequency);\n}\nexport function clav(ctx, out, t, midi, dur, vel, det) { epiano(ctx, out, t, midi, Math.min(dur, 0.14), vel, det, true); }\n\nexport function bass(ctx, out, t, midi, dur, vel = 0.6, det = 0) {\n  const f = mtof(midi);\n  const lp = ctx.createBiquadFilter();\n  lp.type = 'lowpass'; lp.Q.value = 7;\n  lp.frequency.setValueAtTime(f * 9, t); lp.frequency.exponentialRampToValueAtTime(f * 1.8, t + 0.16);\n  const e = env(ctx, lp, t, 0.003, vel * 0.7, 0.12, 0.55, 0.05, dur);\n  lp.connect(out);\n  osc(ctx, 'sawtooth', f, det, t, e.end, e.g);\n  osc(ctx, 'sine', f, det, t, e.end, e.g);\n  // Slap click.\n  const c = ctx.createGain();\n  c.gain.setValueAtTime(vel * 0.25, t); c.gain.exponentialRampToValueAtTime(0.0001, t + 0.018);\n  const hp = ctx.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 1400;\n  noiseSrc(ctx, t, 0.03, hp); hp.connect(c); c.connect(out);\n}\nexport function softBass(ctx, out, t, midi, dur, vel = 0.6, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.012, vel * 0.8, 0.25, 0.6, 0.08, dur);\n  osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const h = ctx.createGain(); h.gain.value = 0.22; h.connect(e.g);\n  osc(ctx, 'triangle', f * 2, det, t, e.end, h);\n}\nexport function tuba(ctx, out, t, midi, dur, vel = 0.6, det = 0) {\n  const f = mtof(midi);\n  const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.Q.value = 2;\n  lp.frequency.setValueAtTime(f * 2, t); lp.frequency.linearRampToValueAtTime(f * 5, t + 0.05); lp.frequency.linearRampToValueAtTime(f * 3, t + 0.2);\n  const e = env(ctx, lp, t, 0.02, vel * 0.8, 0.1, 0.7, 0.05, dur);\n  lp.connect(out);\n  osc(ctx, 'sawtooth', f, det, t, e.end, e.g);\n}\nexport function marimba(ctx, out, t, midi, dur, vel = 0.5, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.002, vel * 0.6, 0.32, 0.001, 0.03, 0.01);\n  osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const h = ctx.createGain();\n  h.gain.setValueAtTime(0.5, t); h.gain.exponentialRampToValueAtTime(0.001, t + 0.07);\n  h.connect(e.g);\n  osc(ctx, 'sine', f * 4, det, t, t + 0.1, h);\n}\nexport function vibes(ctx, out, t, midi, dur, vel = 0.5, det = 0) {\n  const f = mtof(midi);\n  const trem = ctx.createGain(); trem.gain.value = 1; trem.connect(out);\n  const lfo = osc(ctx, 'sine', 5.2, 0, t, t + dur + 1.5);\n  const d = ctx.createGain(); d.gain.value = 0.28; lfo.connect(d); d.connect(trem.gain);\n  const e = env(ctx, trem, t, 0.003, vel * 0.42, 1.1, 0.12, 0.3, dur);\n  osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const h = ctx.createGain(); h.gain.setValueAtTime(0.32, t); h.gain.exponentialRampToValueAtTime(0.001, t + 0.3); h.connect(e.g);\n  osc(ctx, 'sine', f * 4, det, t, t + 0.4, h);\n}\nexport function bell(ctx, out, t, midi, dur, vel = 0.4, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.002, vel * 0.35, 1.8, 0.001, 0.1, 0.01);\n  const c = osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const m = osc(ctx, 'sine', f * 3.51, det, t, t + 1.2);\n  const i = ctx.createGain(); i.gain.setValueAtTime(f * 1.2, t); i.gain.exponentialRampToValueAtTime(1, t + 1.2);\n  m.connect(i); i.connect(c.frequency);\n}\nexport function pad(ctx, out, t, midi, dur, vel = 0.3, det = 0) {\n  const f = mtof(midi);\n  const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.Q.value = 0.8;\n  lp.frequency.setValueAtTime(f * 1.5, t); lp.frequency.linearRampToValueAtTime(f * 3.4, t + dur * 0.5); lp.frequency.linearRampToValueAtTime(f * 2, t + dur);\n  lp.connect(out);\n  const e = env(ctx, lp, t, Math.min(dur * 0.35, 1.2), vel * 0.26, 0.3, 0.85, Math.min(1.2, dur * 0.3), dur);\n  for (const d of [-7, 0, 7]) osc(ctx, 'sawtooth', f, det + d, t, e.end, e.g);\n}\nexport function brass(ctx, out, t, midi, dur, vel = 0.5, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.02, vel * 0.42, 0.1, 0.55, 0.06, dur);\n  const c = osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const m = osc(ctx, 'sine', f, det, t, e.end);\n  const i = ctx.createGain();\n  i.gain.setValueAtTime(f * 0.5, t); i.gain.linearRampToValueAtTime(f * 2.4, t + 0.04); i.gain.exponentialRampToValueAtTime(f * 1.1, t + 0.18);\n  m.connect(i); i.connect(c.frequency);\n}\nexport function flute(ctx, out, t, midi, dur, vel = 0.4, det = 0) {\n  const f = mtof(midi);\n  const e = env(ctx, out, t, 0.06, vel * 0.42, 0.15, 0.8, 0.12, dur);\n  const c = osc(ctx, 'sine', f, det, t, e.end, e.g);\n  const lfo = osc(ctx, 'sine', 4.6, 0, t + 0.15, e.end);\n  const d = ctx.createGain(); d.gain.value = f * 0.006; lfo.connect(d); d.connect(c.frequency);\n  const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f * 2; bp.Q.value = 6;\n  const n = ctx.createGain(); n.gain.value = 0.3; bp.connect(n); n.connect(e.g);\n  noiseSrc(ctx, t, e.end - t, bp);\n}\nexport function pizz(ctx, out, t, midi, dur, vel = 0.5, det = 0) {\n  const f = mtof(midi);\n  const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.Q.value = 3;\n  lp.frequency.setValueAtTime(f * 7, t); lp.frequency.exponentialRampToValueAtTime(f * 1.5, t + 0.18); lp.connect(out);\n  const e = env(ctx, lp, t, 0.002, vel * 0.55, 0.24, 0.001, 0.02, 0.01);\n  osc(ctx, 'sawtooth', f, det, t, e.end, e.g);\n}\nexport function kick(ctx, out, t, _m, _d, vel = 0.9) {\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(vel, t); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.28); g.connect(out);\n  const o = ctx.createOscillator(); o.type = 'sine';\n  o.frequency.setValueAtTime(120, t); o.frequency.exponentialRampToValueAtTime(45, t + 0.12);\n  o.connect(g); o.start(t); o.stop(t + 0.3);\n}\nexport function snare(ctx, out, t, _m, _d, vel = 0.6) {\n  const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 2100; bp.Q.value = 0.7;\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(vel * 0.75, t); g.gain.setValueAtTime(vel * 0.6, t + 0.09); g.gain.linearRampToValueAtTime(0.0001, t + 0.13);\n  bp.connect(g); g.connect(out);\n  noiseSrc(ctx, t, 0.14, bp);\n  const b = ctx.createGain(); b.gain.setValueAtTime(vel * 0.4, t); b.gain.exponentialRampToValueAtTime(0.0001, t + 0.08); b.connect(out);\n  osc(ctx, 'triangle', 190, 0, t, t + 0.09, b);\n}\nfunction tick(ctx, out, t, freq, q, dur, vel) {\n  const f = ctx.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = q;\n  const g = ctx.createGain(); g.gain.setValueAtTime(vel, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  f.connect(g); g.connect(out);\n  noiseSrc(ctx, t, dur + 0.01, f);\n}\nexport const brush = (ctx, out, t, _m, _d, vel = 0.3) => tick(ctx, out, t, 5200, 0.6, 0.09, vel * 0.5);\nexport const shaker = (ctx, out, t, _m, _d, vel = 0.3) => tick(ctx, out, t, 8200, 1.2, 0.045, vel * 0.42);\nexport const hat = (ctx, out, t, _m, _d, vel = 0.3) => tick(ctx, out, t, 9800, 2, 0.03, vel * 0.5);\nexport function woodblock(ctx, out, t, midi, _d, vel = 0.5) {\n  const f = mtof(midi || 84);\n  const g = ctx.createGain(); g.gain.setValueAtTime(vel * 0.5, t); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.06); g.connect(out);\n  osc(ctx, 'sine', f, 0, t, t + 0.07, g);\n  osc(ctx, 'triangle', f * 1.5, 0, t, t + 0.04, g);\n}\nexport function rim(ctx, out, t, _m, _d, vel = 0.4) {\n  const g = ctx.createGain(); g.gain.setValueAtTime(vel * 0.5, t); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.03); g.connect(out);\n  osc(ctx, 'square', 1700, 0, t, t + 0.035, g);\n  tick(ctx, out, t, 3300, 2, 0.02, vel * 0.3);\n}\nexport const INSTRUMENTS = { epiano, clav, bass, softBass, tuba, marimba, vibes, bell, pad, brass, flute, pizz, kick, snare, brush, shaker, hat, woodblock, rim };\nEOF\ncat > src/audio/tracks.js <<'EOF'\n// The score is data. chords: one per bar, 'Root:quality'. parts:\n//  comp: [[step, lenSteps]...] plays the chord; line: [[step, 'r|3|5|7|9|o', lenSteps]...] walks the bass;\n//  hits: 16-char grid; melody: bars of [step, midi, lenSteps]; every: bars a part spans.\nexport const TRACKS = {\n  levelBest: {\n    bpm: 92, swing: 0.14,\n    chords: ['Db:maj9', 'Bb:m9', 'Eb:m9', 'Ab:13', 'Db:maj9', 'Bb:m9', 'Eb:m9', 'Ab:13', 'Gb:maj9', 'F:m7', 'Eb:m9', 'Ab:13sus'],\n    parts: [\n      { inst: 'epiano', comp: [[0, 3], [6, 2], [10, 4]], vel: 0.42 },\n      { inst: 'softBass', line: [[0, 'r', 5], [6, '5', 2], [10, 'r', 2], [14, 'o', 2]], vel: 0.7 },\n      { inst: 'brush', hits: 'x..xx.x.x..xx.x.', vel: 0.32 },\n      { inst: 'rim', hits: '....x.......x...', vel: 0.3 },\n      { inst: 'vibes', vel: 0.75, melody: [\n        [[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]],\n        [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]],\n        [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]],\n        [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]],\n        [[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]],\n        [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]],\n        [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]],\n        [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]],\n        [[0, 77, 3], [3, 78, 1], [4, 80, 2], [6, 73, 4], [12, 75, 2], [14, 77, 2]],\n        [[0, 80, 3], [3, 77, 1], [4, 75, 2], [6, 72, 6], [14, 73, 2]],\n        [[0, 75, 3], [3, 73, 1], [4, 70, 2], [6, 66, 4], [12, 68, 2], [14, 70, 2]],\n        [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 68, 8]],\n      ] },\n    ],\n  },\n  island: {\n    bpm: 84, swing: 0,\n    chords: ['F:maj7', 'A:m7', 'Bb:maj7', 'C:9', 'F:maj7', 'D:m9', 'G:m9', 'C:13'],\n    parts: [\n      { inst: 'marimba', comp: [[0, 2], [3, 1], [6, 2], [10, 2], [13, 2]], vel: 0.45 },\n      { inst: 'softBass', line: [[0, 'r', 3], [3, '5', 1], [6, '5', 2], [8, 'r', 3], [11, '5', 1], [14, 'r', 2]], vel: 0.75 },\n      { inst: 'shaker', hits: 'x.xxx.xxx.xxx.xx', vel: 0.34 },\n      { inst: 'rim', hits: 'x..x..x...x..x..', vel: 0.34 },\n      { inst: 'flute', vel: 0.6, melody: [\n        [[0, 72, 6], [8, 69, 3], [12, 67, 3]],\n        [[0, 69, 8], [10, 67, 2], [12, 64, 4]],\n        [[0, 65, 6], [8, 69, 4], [12, 74, 4]],\n        [[0, 72, 12]],\n        [[0, 76, 4], [4, 77, 2], [6, 76, 2], [8, 72, 6]],\n        [[0, 74, 4], [4, 72, 2], [6, 69, 6], [14, 72, 2]],\n        [[0, 74, 3], [3, 70, 3], [6, 69, 2], [8, 67, 6]],\n        [[0, 65, 4], [4, 67, 4], [8, 70, 2], [10, 69, 6]],\n      ] },\n    ],\n  },\n  stillness: {\n    bpm: 60, swing: 0, free: true,\n    chords: ['D:maj9', 'D:maj9', 'E:maj9', 'E:maj9'],\n    parts: [\n      { inst: 'pad', comp: [[0, 32]], every: 2, vel: 0.6, spread: 1 },\n      { inst: 'softBass', line: [[0, 'r', 14]], every: 2, vel: 0.35 },\n      { inst: 'bell', melody: [[[0, 81, 8], [8, 85, 8]], [[0, 78, 8], [8, 76, 8]], [[0, 83, 8], [8, 80, 8]], [[0, 85, 8], [8, 76, 8]]], vel: 0.5 },\n      { inst: 'flute', vel: 0.42, melody: [\n        [[4, 74, 10]], [[0, 73, 6], [8, 69, 8]], [[4, 76, 10]], [[0, 75, 6], [8, 71, 8]],\n      ] },\n    ],\n  },\n  strength: {\n    bpm: 100, swing: 0.08,\n    chords: ['E:m9', 'A:13'],\n    parts: [\n      { inst: 'bass', line: [[0, 'r', 2], [3, 'r', 1], [4, 'o', 1], [6, '7', 1], [8, 'r', 2], [10, '5', 1], [12, 'o', 1], [14, 'r', 1], [15, '7', 1]], vel: 0.85, oct: 12 },\n      { inst: 'clav', comp: [[2, 1], [4, 1], [7, 1], [10, 1], [12, 1], [15, 1]], vel: 0.6 },\n      { inst: 'brass', comp: [[6, 2], [14, 2]], everyBar: 2, vel: 0.5 },\n      { inst: 'kick', hits: 'x.....x.x.......', vel: 0.85 },\n      { inst: 'snare', hits: '....x.......x...', vel: 0.55 },\n      { inst: 'hat', hits: 'x.x.x.x.x.x.x.x.', vel: 0.3 },\n    ],\n  },\n  cardio: {\n    bpm: 116, swing: 0,\n    chords: ['Db:maj7', 'C:m7', 'Bb:m7', 'Eb:sus'],\n    parts: [\n      { inst: 'kick', hits: 'x...x...x...x...', vel: 0.9 },\n      { inst: 'snare', hits: '....x.......x...', vel: 0.5 },\n      { inst: 'hat', hits: '..x...x...x...x.', vel: 0.4 },\n      { inst: 'bass', line: [[0, 'r', 2], [2, 'o', 2], [4, 'r', 2], [6, 'o', 2], [8, 'r', 2], [10, 'o', 2], [12, 'r', 2], [14, 'o', 2]], vel: 0.8, oct: 12 },\n      { inst: 'epiano', comp: [[0, 2], [3, 2], [6, 2], [11, 3]], vel: 0.5 },\n      { inst: 'brass', comp: [[14, 2]], vel: 0.5 },\n      { inst: 'vibes', vel: 0.5, melody: [\n        [[0, 77, 2], [3, 80, 2], [6, 84, 4], [12, 82, 2], [14, 80, 2]],\n        [[0, 79, 2], [3, 75, 2], [6, 79, 4], [12, 77, 4]],\n        [[0, 77, 2], [3, 73, 2], [6, 77, 4], [12, 80, 2], [14, 77, 2]],\n        [[0, 75, 6], [8, 70, 2], [10, 72, 2], [12, 75, 4]],\n      ] },\n    ],\n  },\n  balance: {\n    bpm: 118, swing: 0.1,\n    chords: ['C:6', 'A:m7', 'D:m7', 'G:7'],\n    parts: [\n      { inst: 'tuba', line: [[0, 'r', 3], [8, '5', 3]], vel: 0.8 },\n      { inst: 'marimba', comp: [[4, 1], [6, 1], [12, 1], [14, 1]], vel: 0.5 },\n      { inst: 'pizz', vel: 0.55, melody: [\n        [[0, 76, 2], [2, 79, 2], [4, 84, 2], [6, 81, 2], [8, 79, 2], [12, 76, 2]],\n        [[0, 72, 2], [2, 76, 2], [4, 81, 2], [6, 79, 2], [8, 76, 4], [14, 74, 2]],\n        [[0, 77, 2], [2, 81, 2], [4, 86, 2], [6, 84, 2], [8, 81, 2], [12, 77, 2]],\n        [[0, 79, 2], [2, 83, 2], [4, 86, 2], [6, 83, 2], [8, 79, 2], [10, 77, 2], [12, 74, 2], [14, 71, 2]],\n      ] },\n      { inst: 'woodblock', hits: '..x...x...x..xx.', vel: 0.34, note: 84 },\n      { inst: 'shaker', hits: 'x.x.x.x.x.x.x.x.', vel: 0.24 },\n    ],\n  },\n  level: {\n    // Starts as bare e-piano of the title theme, then every instrument, slower, in tune.\n    bpm: 76, swing: 0.1, sections: true,\n    chords: ['Db:maj9', 'Bb:m9', 'Eb:m9', 'Ab:13', 'Db:maj9', 'Bb:m9', 'Eb:m9', 'Ab:13', 'Gb:maj9', 'F:m7', 'Eb:m9', 'Ab:13sus'],\n    parts: [\n      { inst: 'epiano', comp: [[0, 8], [8, 6]], vel: 0.4 },\n      { inst: 'epiano', vel: 0.7, melody: [\n        [[0, 77, 3], [3, 75, 1], [4, 73, 2], [6, 68, 4], [12, 70, 2], [14, 72, 2]],\n        [[0, 73, 3], [3, 72, 1], [4, 70, 2], [6, 65, 6], [14, 68, 2]],\n        [[0, 70, 3], [3, 68, 1], [4, 66, 2], [6, 63, 4], [12, 65, 2], [14, 66, 2]],\n        [[0, 68, 3], [3, 70, 1], [4, 72, 2], [6, 75, 6]],\n      ] },\n      { inst: 'pad', comp: [[0, 16]], from: 4, vel: 0.5 },\n      { inst: 'softBass', line: [[0, 'r', 6], [8, '5', 4], [14, 'o', 2]], from: 4, vel: 0.7 },\n      { inst: 'brush', hits: 'x..xx.x.x..xx.x.', from: 8, vel: 0.32 },\n      { inst: 'vibes', from: 8, vel: 0.5, melody: [\n        [[0, 89, 3], [3, 87, 1], [4, 85, 2], [6, 80, 4]], [[0, 85, 3], [4, 82, 2], [6, 77, 6]], [[0, 82, 3], [4, 78, 2], [6, 75, 4]], [[0, 80, 3], [4, 84, 2], [6, 87, 6]],\n      ] },\n      { inst: 'flute', from: 12, vel: 0.5, melody: [\n        [[0, 77, 6], [8, 80, 6]], [[0, 77, 12]], [[0, 78, 6], [8, 75, 6]], [[0, 80, 14]],\n      ] },\n      { inst: 'brass', comp: [[0, 3], [10, 3]], from: 16, vel: 0.35 },\n    ],\n  },\n};\n// Short pieces: [time in beats, instrument, midi, beats, velocity]. Three seconds or less.\nexport const STINGS = {\n  attended: { bpm: 110, notes: [[0, 'marimba', 67, 1, 0.8], [0.5, 'marimba', 64, 1, 0.8], [1, 'marimba', 60, 2, 0.9]] },\n  adequate: { bpm: 120, notes: [[0, 'marimba', 60, 1, 0.8], [0.5, 'marimba', 64, 1, 0.8], [1, 'marimba', 67, 2, 0.9]] },\n  pleasant: { bpm: 120, notes: [[0, 'vibes', 72, 1, 0.8], [0.5, 'vibes', 76, 1, 0.8], [1, 'vibes', 79, 1, 0.8], [1.5, 'vibes', 84, 2, 0.9]] },\n  exemplary: { bpm: 130, notes: [[0, 'brass', 67, 0.5, 0.8], [0.5, 'brass', 72, 0.5, 0.8], [1, 'brass', 76, 0.5, 0.8], [1.5, 'brass', 79, 2, 1], [1.5, 'brass', 84, 2, 0.8], [1.5, 'kick', 36, 1, 0.8]] },\n  suspicious: { bpm: 110, notes: [[0, 'vibes', 76, 1, 0.9], [0.5, 'vibes', 75, 1, 0.9], [1, 'vibes', 76, 1, 0.9], [1.5, 'vibes', 75, 1, 0.9], [2, 'brass', 72, 2, 0.8], [2, 'brass', 78, 2, 0.7]] },\n  reveal: { bpm: 100, notes: [[0, 'brass', 60, 0.5, 1], [0, 'brass', 66, 0.5, 0.8], [0.5, 'kick', 36, 1, 1], [0.5, 'bell', 84, 3, 0.9]] },\n  unlock: { bpm: 150, notes: [[0, 'marimba', 72, 1, 0.9], [0.5, 'marimba', 76, 1, 0.9], [1, 'marimba', 79, 1, 0.9], [1.5, 'marimba', 84, 1, 0.9], [2, 'bell', 88, 3, 0.8]] },\n  ending: { bpm: 70, notes: [[0, 'bell', 73, 3, 0.8], [0.5, 'bell', 77, 3, 0.8], [1, 'bell', 80, 3, 0.8], [1.5, 'bell', 85, 3, 0.9]] },\n};\nexport const ROOTS = { C: 36, Db: 37, D: 38, Eb: 39, E: 40, F: 41, Gb: 42, G: 43, Ab: 44, A: 45, Bb: 46, B: 47 };\nexport const QUALITY = {\n  maj7: [0, 4, 7, 11], maj9: [4, 7, 11, 14], m7: [0, 3, 7, 10], m9: [3, 7, 10, 14], 9: [4, 7, 10, 14], 13: [4, 10, 14, 21],\n  '13sus': [5, 10, 14, 21], sus: [5, 7, 10, 14], 6: [0, 4, 7, 9], 7: [0, 4, 7, 10],\n};\nEOF\ncat > src/audio/sequencer.js <<'EOF'\nimport { INSTRUMENTS } from './instruments.js';\nimport { TRACKS, ROOTS, QUALITY } from './tracks.js';\n\nexport function parseChord(name) {\n  const [root, q] = name.split(':');\n  const r = ROOTS[root], iv = QUALITY[q];\n  const notes = iv.map((i) => {\n    let n = r + 24 + i;\n    while (n < 56) n += 12;\n    while (n > 76) n -= 12;\n    return n;\n  });\n  return { root: r, notes, iv };\n}\nconst DEG = { r: 0, 3: 1, 5: 2, 7: 3, 9: 3 };\nfunction bassNote(ch, sym) {\n  if (sym === 'r') return ch.root;\n  if (sym === 'o') return ch.root + 12;\n  const third = ch.iv.find((i) => i === 3 || i === 4 || i === 5) ?? 4;\n  if (sym === '3') return ch.root + third;\n  if (sym === '5') return ch.root + 7;\n  if (sym === '7') return ch.root + (ch.iv.includes(11) ? 11 : 10);\n  return ch.root + (DEG[sym] || 0);\n}\n/** Emit every note of bar b: fn(time, inst, midi, lenSec, vel). */\nexport function emitBar(track, b, t0, stepDur, fn) {\n  const chords = track.chords;\n  const chord = parseChord(chords[b % chords.length]);\n  const sw = (step) => (step % 2 === 1 ? (track.swing || 0) * stepDur : 0);\n  for (const p of track.parts) {\n    if (p.from !== undefined && b < p.from) continue;\n    if (p.every && b % p.every !== 0) continue;\n    if (p.everyBar && b % p.everyBar !== p.everyBar - 1) continue;\n    const vel = p.vel ?? 0.5;\n    if (p.comp) {\n      for (const [s, len] of p.comp) for (const n of chord.notes) fn(t0 + s * stepDur + sw(s), p.inst, n, len * stepDur, vel);\n    } else if (p.line) {\n      for (const [s, sym, len] of p.line) fn(t0 + s * stepDur + sw(s), p.inst, bassNote(chord, sym) + (p.oct || 0), len * stepDur, vel);\n    } else if (p.hits) {\n      for (let s = 0; s < 16; s++) if (p.hits[s] === 'x') fn(t0 + s * stepDur + sw(s), p.inst, p.note || 60, stepDur, vel);\n    } else if (p.melody) {\n      const bar = p.melody[b % p.melody.length];\n      for (const [s, n, len] of bar) fn(t0 + s * stepDur + sw(s), p.inst, n, len * stepDur, vel);\n    }\n  }\n}\n\n/** Look-ahead scheduler on currentTime. One track at a time, with a fade on change. */\nexport class Sequencer {\n  constructor(mix) {\n    this.mix = mix; this.track = null; this.id = null; this.gain = null;\n    this.bar = 0; this.barTime = 0; this.startTime = 0; this.paused = false; this.pausedPos = 0;\n    this.tiltDeg = 0; this.ahead = 0.15; this.lastTick = 0; this.bpm = 0;\n  }\n  play(id, { bpm = null, at = null, fade = 0.5, sectionOffset = 0 } = {}) {\n    const track = TRACKS[id];\n    if (!track) return;\n    if (this.id === id && !bpm && !at) return;\n    this.stop(fade);\n    const ctx = this.mix.ctx;\n    this.gain = ctx.createGain();\n    const t = at ?? ctx.currentTime + 0.05;\n    this.gain.gain.setValueAtTime(0.0001, ctx.currentTime);\n    this.gain.gain.linearRampToValueAtTime(1, Math.max(t, ctx.currentTime + 0.02));\n    this.gain.connect(this.mix.music);\n    const send = ctx.createGain(); send.gain.value = 0.2; this.gain.connect(send); send.connect(this.mix.reverb);\n    this.track = track; this.id = id; this.bpm = bpm || track.bpm;\n    this.bar = sectionOffset; this.startTime = t; this.barTime = t; this.paused = false;\n  }\n  stop(fade = 0.5) {\n    if (!this.gain) { this.track = null; this.id = null; return; }\n    const ctx = this.mix.ctx, g = this.gain;\n    g.gain.cancelScheduledValues(ctx.currentTime);\n    g.gain.setValueAtTime(g.gain.value, ctx.currentTime);\n    g.gain.linearRampToValueAtTime(0.0001, ctx.currentTime + Math.max(0.02, fade));\n    this.gain = null; this.track = null; this.id = null;\n  }\n  get stepDur() { return 60 / this.bpm / 4; }\n  /** Seconds since this track started. */\n  position() { return this.track ? (this.paused ? this.pausedPos : this.mix.ctx.currentTime - this.startTime) : 0; }\n  pause() { if (this.track && !this.paused) { this.pausedPos = this.position(); this.paused = true; } }\n  resume() {\n    if (!this.paused) return;\n    this.paused = false;\n    if (!this.track) return;\n    const ctx = this.mix.ctx, dt = ctx.currentTime + 0.05 - (this.startTime + this.pausedPos);\n    this.startTime += dt; this.barTime += dt;\n  }\n  /** Detune while the island is crooked: tilt° × 1.6 × sin(t × 0.7) cents. Zero when level. */\n  detuneAt(t) { return this.tiltDeg * 1.6 * Math.sin(t * 0.7); }\n  tick() {\n    if (!this.track || this.paused) return;\n    const ctx = this.mix.ctx;\n    const now = ctx.currentTime;\n    if (now < this.lastTick) this.lastTick = now;\n    const ahead = this.ahead;\n    let guard = 0;\n    if (this.barTime < now - 2) {\n      const barDur = this.stepDur * 16;\n      const skip = Math.floor((now - this.barTime) / barDur);\n      this.barTime += skip * barDur; this.bar += skip;\n    }\n    while (this.barTime < now + ahead && guard++ < 8) {\n      this._emit(this.bar, this.barTime);\n      this.barTime += this.stepDur * 16; this.bar++;\n    }\n  }\n  _emit(bar, t0) {\n    const ctx = this.mix.ctx, gain = this.gain;\n    emitBar(this.track, bar, t0, this.stepDur, (t, inst, midi, len, vel) => {\n      const f = INSTRUMENTS[inst];\n      if (f) f(ctx, gain, t, midi, len, vel, this.detuneAt(t));\n    });\n  }\n}\nEOF\ncat > src/audio/sfx.js <<'EOF'\nimport { noiseSrc, mtof, INSTRUMENTS } from './instruments.js';\n\nconst rnd = (m, a, b) => a + (b - a) * m.r();\n\nfunction burst(m, t, out, freq, q, dur, vel, type = 'bandpass', rate = 1) {\n  const ctx = m.ctx;\n  const f = ctx.createBiquadFilter(); f.type = type; f.frequency.value = freq; f.Q.value = q;\n  const g = ctx.createGain(); g.gain.setValueAtTime(vel, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  f.connect(g); g.connect(out);\n  noiseSrc(ctx, t, dur + 0.02, f, rate);\n  return f;\n}\nfunction tone(m, t, out, type, f0, f1, dur, vel, a = 0.003) {\n  const ctx = m.ctx;\n  const o = ctx.createOscillator(); o.type = type;\n  o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(Math.max(1, f1), t + dur);\n  const g = ctx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(vel, t + a); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  o.connect(g); g.connect(out); o.start(t); o.stop(t + dur + 0.02);\n  return o;\n}\n\nexport const SFX = {\n  clack(m, t, o = {}) { // wood clack: three resonant noise bursts, tuned per limb\n    const base = o.pitch || rnd(m, 700, 1200);\n    burst(m, t, m.sfx, base, 11, 0.05, 0.75);\n    burst(m, t + rnd(m, 0.02, 0.05), m.sfx, base * 1.34, 12, 0.04, 0.5);\n    burst(m, t + rnd(m, 0.06, 0.11), m.sfx, base * 0.72, 10, 0.05, 0.45);\n  },\n  fall(m, t) { for (let i = 0; i < 6; i++) SFX.clack(m, t + i * 0.07 + rnd(m, 0, 0.03), { pitch: rnd(m, 500, 1300) }); },\n  spring(m, t) { // toy spring: rising sine with vibrato\n    const o = tone(m, t, m.sfx, 'sine', 180, 900, 0.34, 0.5);\n    const l = m.ctx.createOscillator(); l.frequency.value = 26;\n    const g = m.ctx.createGain(); g.gain.value = 60; l.connect(g); g.connect(o.frequency); l.start(t); l.stop(t + 0.36);\n  },\n  splash(m, t, o = {}) {\n    const big = o.big ?? 1;\n    const f = burst(m, t, m.sfx, 3200, 0.5, 0.7 * big + 0.2, 0.7, 'lowpass');\n    f.frequency.setValueAtTime(5200, t); f.frequency.exponentialRampToValueAtTime(420, t + 0.6 * big + 0.2);\n    for (let i = 0; i < 4; i++) tone(m, t + 0.05 + i * 0.06, m.sfx, 'sine', rnd(m, 500, 1100), rnd(m, 200, 500), 0.08, 0.1);\n    if (big > 1) tone(m, t, m.sfx, 'sine', 110, 44, 0.35, 0.5);\n  },\n  marble(m, t, o = {}) { tone(m, t, m.sfx, 'sine', o.pitch || rnd(m, 1800, 3900), rnd(m, 1500, 3000), 0.05, 0.22); },\n  marbleRoll(m, t) { for (let i = 0; i < 5; i++) tone(m, t + i * 0.035, m.sfx, 'sine', rnd(m, 1600, 3600), rnd(m, 1400, 3000), 0.03, 0.1); },\n  plateHum(m, t, o = {}) { tone(m, t, m.sfx, 'sine', o.pitch || 320, (o.pitch || 320) * 1.02, 0.12, 0.08, 0.03); },\n  plateCrash(m, t) {\n    burst(m, t, m.sfx, 4200, 3, 0.26, 0.6);\n    for (let i = 0; i < 6; i++) tone(m, t + i * 0.03, m.sfx, 'triangle', rnd(m, 1800, 4800), rnd(m, 1400, 3200), 0.1, 0.18);\n  },\n  thud(m, t, o = {}) { tone(m, t, m.sfx, 'sine', o.pitch || 190, 70, 0.11, 0.6); burst(m, t, m.sfx, 900, 1, 0.04, 0.2); },\n  spike(m, t) { tone(m, t, m.sfx, 'sawtooth', 1500, 240, 0.14, 0.35); burst(m, t, m.sfx, 5000, 2, 0.06, 0.3); },\n  whistle(m, t) {\n    const o = tone(m, t, m.sfx, 'square', 2300, 2500, 0.5, 0.2, 0.02);\n    const l = m.ctx.createOscillator(); l.frequency.value = 38;\n    const g = m.ctx.createGain(); g.gain.value = 130; l.connect(g); g.connect(o.frequency); l.start(t); l.stop(t + 0.52);\n  },\n  bell(m, t) { INSTRUMENTS.bell(m.ctx, m.sfx, t, 84, 1, 1.1); INSTRUMENTS.bell(m.ctx, m.sfx, t + 0.02, 91, 1, 0.5); },\n  breathIn(m, t, o = {}) { const f = burst(m, t, m.sfx, 900, 1, o.dur || 2, 0.05); f.frequency.setValueAtTime(600, t); f.frequency.linearRampToValueAtTime(2200, t + (o.dur || 2)); },\n  breathOut(m, t, o = {}) { const f = burst(m, t, m.sfx, 900, 1, o.dur || 2, 0.05); f.frequency.setValueAtTime(1800, t); f.frequency.linearRampToValueAtTime(500, t + (o.dur || 2)); },\n  gust(m, t, o = {}) { // rising band-passed noise\n    const d = o.dur || 1.1;\n    const f = m.ctx.createBiquadFilter(); f.type = 'bandpass'; f.Q.value = 2.2;\n    f.frequency.setValueAtTime(320, t); f.frequency.exponentialRampToValueAtTime(1900, t + d * 0.8);\n    const g = m.ctx.createGain(); g.gain.setValueAtTime(0.001, t); g.gain.linearRampToValueAtTime(0.5, t + d * 0.8); g.gain.exponentialRampToValueAtTime(0.001, t + d + 0.4);\n    f.connect(g); g.connect(m.sfx);\n    noiseSrc(m.ctx, t, d + 0.45, f);\n  },\n  creak(m, t, o = {}) { // slow saw through a resonant filter\n    const d = o.dur || 1.8;\n    const os = m.ctx.createOscillator(); os.type = 'sawtooth';\n    os.frequency.setValueAtTime(42, t); os.frequency.linearRampToValueAtTime(58, t + d * 0.4); os.frequency.linearRampToValueAtTime(36, t + d);\n    const f = m.ctx.createBiquadFilter(); f.type = 'bandpass'; f.Q.value = 16;\n    f.frequency.setValueAtTime(420, t); f.frequency.linearRampToValueAtTime(820, t + d * 0.55); f.frequency.linearRampToValueAtTime(330, t + d);\n    const g = m.ctx.createGain(); g.gain.setValueAtTime(0.001, t); g.gain.linearRampToValueAtTime(0.7, t + 0.15); g.gain.setValueAtTime(0.7, t + d * 0.7); g.gain.exponentialRampToValueAtTime(0.001, t + d);\n    os.connect(f); f.connect(g); g.connect(m.sfx); os.start(t); os.stop(t + d + 0.02);\n  },\n  uiMove(m, t) { INSTRUMENTS.woodblock(m.ctx, m.sfx, t, 79, 0, 0.5); },\n  uiConfirm(m, t) { INSTRUMENTS.woodblock(m.ctx, m.sfx, t, 84, 0, 0.7); INSTRUMENTS.woodblock(m.ctx, m.sfx, t + 0.07, 91, 0, 0.7); },\n  uiBack(m, t) { INSTRUMENTS.woodblock(m.ctx, m.sfx, t, 76, 0, 0.6); INSTRUMENTS.woodblock(m.ctx, m.sfx, t + 0.07, 69, 0, 0.6); },\n  stamp(m, t) { tone(m, t, m.sfx, 'sine', 150, 50, 0.16, 0.9); burst(m, t, m.sfx, 1400, 1, 0.05, 0.4); },\n  drumRoll(m, t, o = {}) {\n    const d = o.dur || 2;\n    let at = t, i = 0;\n    while (at < t + d) { burst(m, at, m.sfx, 2400, 0.8, 0.05, 0.18 + (0.4 * (at - t)) / d); at += 0.045; i++; }\n    return i;\n  },\n  foot(m, t, o = {}) { // Step Class's click: music is only 10%, so the beat must read without it\n    INSTRUMENTS.woodblock(m.ctx, m.sfx, t, o.note || 88, 0, o.vel || 0.9);\n  },\n  metronome(m, t, o = {}) { INSTRUMENTS.rim(m.ctx, m.sfx, t, 0, 0, o.vel || 0.8); },\n  squawk(m, t) { // Gary: FM squawk\n    const c = tone(m, t, m.sfx, 'sawtooth', 780, 520, 0.28, 0.32, 0.01);\n    const mod = m.ctx.createOscillator(); mod.frequency.value = 62;\n    const g = m.ctx.createGain(); g.gain.value = 460; mod.connect(g); g.connect(c.frequency); mod.start(t); mod.stop(t + 0.3);\n  },\n  boing(m, t) { tone(m, t, m.sfx, 'triangle', 120, 480, 0.25, 0.5); },\n  sneeze(m, t) { burst(m, t, m.sfx, 2600, 0.8, 0.22, 0.7); tone(m, t, m.sfx, 'sawtooth', 420, 170, 0.18, 0.3); },\n  catch(m, t) { tone(m, t, m.sfx, 'sine', mtof(72 + Math.floor(rnd(m, 0, 8))), 300, 0.1, 0.4); burst(m, t, m.sfx, 700, 1.2, 0.05, 0.3); },\n  gullLand(m, t) { burst(m, t, m.sfx, 1800, 1, 0.1, 0.2); tone(m, t, m.sfx, 'sine', 300, 160, 0.08, 0.2); },\n  whoosh(m, t) { const f = burst(m, t, m.sfx, 800, 1.1, 0.4, 0.3); f.frequency.setValueAtTime(400, t); f.frequency.exponentialRampToValueAtTime(2800, t + 0.34); },\n};\nEOF\ncat > src/audio/voice.js <<'EOF'\nimport { noiseSrc } from './instruments.js';\n\n// Animalese-style gibberish, spoken from each line's own text.\nexport const VOICES = {\n  trudy: { name: 'Trudy', pitch: 420, rate: 16, type: 'square', drift: 22, formant: 1.25, gain: 0.3, q: 7, breath: 0 },\n  stillwater: { name: 'Ms. Stillwater', pitch: 170, rate: 7, type: 'sawtooth', drift: 5, formant: 0.8, gain: 1.05, q: 5, breath: 0.45, gap: 1.5 },\n  bolster: { name: 'Coach Bolster', pitch: 95, rate: 11, type: 'sawtooth', drift: 12, formant: 0.72, gain: 1.15, q: 4, breath: 0 },\n  guest: { name: 'Guest', pitch: 260, rate: 12, type: 'square', drift: 18, formant: 1, gain: 0.55, q: 6, breath: 0 },\n  margaret: { name: 'Gentle Margaret', pitch: 300, rate: 11, type: 'square', drift: 12, formant: 1.1, gain: 0.55, q: 6, breath: 0.1 },\n  kevin: { name: 'Retired Kevin', pitch: 205, rate: 10, type: 'sawtooth', drift: 8, formant: 0.9, gain: 0.7, q: 5, breath: 0 },\n  sandras: { name: 'Both Sandras', pitch: 320, rate: 13, type: 'square', drift: 16, formant: 1.15, gain: 0.55, q: 6, breath: 0, double: 1.26 },\n  paul: { name: 'Unsteady Paul', pitch: 235, rate: 12, type: 'square', drift: 38, formant: 0.95, gain: 0.6, q: 6, breath: 0 },\n  gerald: { name: 'Young Gerald', pitch: 200, rate: 9, type: 'sawtooth', drift: 30, formant: 0.85, gain: 0.7, q: 5, breath: 0.2 },\n};\nconst FORMANTS = { a: [730, 1090], e: [530, 1840], i: [300, 2300], o: [570, 840], u: [340, 870] };\nconst EXCLAIM = ['Wobba-la!', 'Oof-ah.', 'Nee nee!', 'Sul-sul-oh?', 'Hoppa!', 'Mm-bah.'];\nexport const nonsense = (i) => EXCLAIM[i % EXCLAIM.length];\n\nfunction blip(m, out, t, f, vowel, v, dur, r) {\n  const ctx = m.ctx;\n  const [f1, f2] = FORMANTS[vowel] || FORMANTS.a;\n  const o = ctx.createOscillator(); o.type = v.type; o.frequency.setValueAtTime(f, t);\n  const b1 = ctx.createBiquadFilter(); b1.type = 'bandpass'; b1.frequency.value = f1 * v.formant; b1.Q.value = v.q;\n  const b2 = ctx.createBiquadFilter(); b2.type = 'bandpass'; b2.frequency.value = f2 * v.formant; b2.Q.value = v.q;\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(v.gain, t + 0.008); g.gain.exponentialRampToValueAtTime(0.001, t + dur);\n  o.connect(b1); o.connect(b2); b1.connect(g); b2.connect(g); g.connect(out);\n  o.start(t); o.stop(t + dur + 0.01);\n  if (v.breath) {\n    const n = ctx.createBiquadFilter(); n.type = 'bandpass'; n.frequency.value = f2 * v.formant; n.Q.value = 1.2;\n    const ng = ctx.createGain(); ng.gain.setValueAtTime(v.gain * v.breath * 0.5, t); ng.gain.exponentialRampToValueAtTime(0.001, t + dur);\n    n.connect(ng); ng.connect(out);\n    noiseSrc(ctx, t, dur + 0.01, n);\n  }\n  if (r() < 0.35) {\n    const c = ctx.createBiquadFilter(); c.type = 'highpass'; c.frequency.value = 3200;\n    const cg = ctx.createGain(); cg.gain.setValueAtTime(v.gain * 0.3, t); cg.gain.exponentialRampToValueAtTime(0.001, t + 0.012);\n    c.connect(cg); cg.connect(out);\n    noiseSrc(ctx, t, 0.016, c);\n  }\n}\n\n/**\n * Schedule a line of gibberish. Returns its length in seconds and how many blips it fired.\n * Pitch rises on ?, jumps on !, falls at the end of a sentence.\n */\nexport function speak(m, out, voiceId, text, t0, r) {\n  const v = VOICES[voiceId] || VOICES.guest;\n  const step = 1 / v.rate;\n  let t = t0, blips = 0;\n  const s = String(text).toLowerCase();\n  // Walk the letters; each syllable-group (a vowel run) fires one blip.\n  let i = 0;\n  const n = s.length;\n  while (i < n) {\n    const c = s[i];\n    if (c === ' ') { t += step * 0.9; i++; continue; }\n    if (c === ',' || c === ';' || c === ':') { t += step * 3 * (v.gap || 1); i++; continue; }\n    if (c === '.' || c === '!' || c === '?') { t += step * 5 * (v.gap || 1); i++; continue; }\n    if (!/[a-z]/.test(c)) { i++; continue; }\n    let j = i;\n    let vowel = 'a';\n    let found = false;\n    while (j < n && /[a-z]/.test(s[j])) {\n      if ('aeiou'.includes(s[j]) && !found) { vowel = s[j]; found = true; }\n      j++;\n      if (found && !'aeiou'.includes(s[j] || ' ')) break;\n    }\n    const rest = s.slice(j);\n    const m2 = rest.match(/[.!?]/);\n    const end = m2 ? m2[0] : '';\n    const toEnd = m2 ? m2.index : 99;\n    let p = v.pitch * (1 + ((r() - 0.5) * v.drift) / 100);\n    if (end === '?' && toEnd < 7) p *= 1 + (7 - toEnd) * 0.035;\n    if (end === '!') p *= 1.12;\n    if (end === '.' && toEnd < 7) p *= 1 - (7 - toEnd) * 0.018;\n    blip(m, out, t, p, vowel, v, 0.06 + (v.breath ? 0.03 : 0), r);\n    if (v.double) blip(m, out, t + 0.012, p * v.double, vowel, v, 0.06, r);\n    blips++;\n    t += step * Math.max(1, Math.min(3, j - i));\n    i = j;\n  }\n  return { duration: Math.max(0.2, t - t0), blips };\n}\nEOF\ncat > src/audio/engine.js <<'EOF'\nimport { Sequencer } from './sequencer.js';\nimport { SFX } from './sfx.js';\nimport { speak } from './voice.js';\nimport { STINGS } from './tracks.js';\nimport { INSTRUMENTS } from './instruments.js';\nimport { mulberry32 } from '../core/rng.js';\n\n/** buses (music, sfx, voice) → master compressor → destination. Works on any context. */\nexport class Mix {\n  constructor(ctx) {\n    this.ctx = ctx;\n    this.r = mulberry32(4242);\n    this.master = ctx.createDynamicsCompressor();\n    this.master.threshold.value = -10; this.master.ratio.value = 5; this.master.attack.value = 0.004; this.master.release.value = 0.2;\n    this.master.connect(ctx.destination);\n    this.music = ctx.createGain(); this.sfx = ctx.createGain(); this.voice = ctx.createGain();\n    this.music.connect(this.master); this.sfx.connect(this.master); this.voice.connect(this.master);\n    this.reverb = ctx.createConvolver();\n    this.reverb.buffer = this._impulse(1.9);\n    const wet = ctx.createGain(); wet.gain.value = 0.5;\n    this.reverb.connect(wet); wet.connect(this.music);\n    this.setLevels(10, 80, 80);\n    this.seq = new Sequencer(this);\n  }\n  _impulse(sec) {\n    const ctx = this.ctx, len = Math.floor(ctx.sampleRate * sec);\n    const b = ctx.createBuffer(2, len, ctx.sampleRate);\n    const r = mulberry32(777);\n    for (let ch = 0; ch < 2; ch++) {\n      const d = b.getChannelData(ch);\n      for (let i = 0; i < len; i++) d[i] = (r() * 2 - 1) * (1 - i / len) ** 3.2;\n    }\n    return b;\n  }\n  setLevels(music, sfx, voice) {\n    const t = this.ctx.currentTime;\n    this.music.gain.setValueAtTime(music / 100, t); this.sfx.gain.setValueAtTime(sfx / 100, t); this.voice.gain.setValueAtTime(voice / 100, t);\n    this.levels = { music: music / 100, sfx: sfx / 100, voice: voice / 100 };\n  }\n  sting(name, at) {\n    const s = STINGS[name];\n    if (!s) return;\n    const beat = 60 / s.bpm, t0 = at ?? this.ctx.currentTime + 0.01;\n    for (const [b, inst, midi, dur, vel] of s.notes) INSTRUMENTS[inst](this.ctx, this.sfx, t0 + b * beat, midi, dur * beat, vel * 0.8, 0);\n  }\n  playSfx(name, at, o) {\n    const f = SFX[name];\n    if (f) f(this, at ?? this.ctx.currentTime + 0.005, o);\n  }\n}\n\n/** The live mix. It starts on the first gesture, pad input included. Until then all of this is silent and harmless. */\nexport class AudioEngine {\n  constructor(settings) {\n    this.settings = settings;\n    this.ctx = null; this.mix = null; this.gestured = false; this.gestureT = 0;\n    this.analysers = {};\n    this.disabled = false; this.lineGain = null;\n    try {\n      const AC = window.AudioContext || window.webkitAudioContext;\n      if (AC) { this.ctx = new AC({ latencyHint: 'interactive' }); this.mix = new Mix(this.ctx); this._analyse(); }\n    } catch (e) { this.disabled = true; }\n    this.applyLevels();\n    this._timer = null;\n    if (this.ctx) this._timer = setInterval(() => this.tick(), 25);\n  }\n  _analyse() {\n    for (const k of ['music', 'sfx', 'voice']) {\n      const a = this.ctx.createAnalyser(); a.fftSize = 1024;\n      this.mix[k].connect(a);\n      this.analysers[k] = a;\n    }\n  }\n  /** Peak level on a bus right now, 0 to 1. */\n  level(bus) {\n    const a = this.analysers[bus];\n    if (!a) return 0;\n    const b = new Float32Array(a.fftSize); a.getFloatTimeDomainData(b);\n    let p = 0;\n    for (let i = 0; i < b.length; i++) p = Math.max(p, Math.abs(b[i]));\n    return p;\n  }\n  get state() { return this.ctx ? this.ctx.state : 'none'; }\n  get seq() { return this.mix ? this.mix.seq : null; }\n  gesture() {\n    this.gestured = true;\n    if (this.ctx && this.ctx.state === 'suspended') { const p = this.ctx.resume(); if (p && p.catch) p.catch(() => {}); }\n  }\n  applyLevels() {\n    if (!this.mix) return;\n    const s = this.settings();\n    this.mix.setLevels(s.music, s.sound, s.voice);\n  }\n  /** A pad-only player whose browser wouldn't unlock audio gets a small tag asking for a key. */\n  stuck() { return !!(this.ctx && this.gestured && this.ctx.state === 'suspended'); }\n  tick() {\n    if (!this.mix) return;\n    if (this.ctx.state !== 'running') return;\n    this.mix.seq.tick();\n  }\n  music(id, o) { if (this.mix) this.mix.seq.play(id, o); }\n  stopMusic(fade) { if (this.mix) this.mix.seq.stop(fade); }\n  get musicId() { return this.mix ? this.mix.seq.id : null; }\n  setTilt(deg) { if (this.mix) this.mix.seq.tiltDeg = deg; this.tiltDeg = deg; }\n  detuneNow() { return this.mix ? this.mix.seq.detuneAt(this.ctx.currentTime) : 0; }\n  sfx(name, o) { if (this.mix && this.ctx.state === 'running') this.mix.playSfx(name, undefined, o); }\n  sting(name) { if (this.mix && this.ctx.state === 'running') this.mix.sting(name); }\n  /** Speak a line. Stopping a line silences what remains of it. */\n  say(voiceId, text) {\n    if (!this.mix || this.ctx.state !== 'running') return { duration: 0 };\n    this.stopVoice();\n    const g = this.ctx.createGain(); g.connect(this.mix.voice);\n    this.lineGain = g;\n    return speak(this.mix, g, voiceId, text, this.ctx.currentTime + 0.01, this.mix.r);\n  }\n  stopVoice() {\n    if (this.lineGain) {\n      const g = this.lineGain; this.lineGain = null;\n      g.gain.setValueAtTime(g.gain.value, this.ctx.currentTime); g.gain.linearRampToValueAtTime(0, this.ctx.currentTime + 0.03);\n    }\n  }\n  /** Session end: everything stops. */\n  silence() {\n    if (this._timer) clearInterval(this._timer);\n    this._timer = null;\n    if (this.ctx) { const p = this.ctx.suspend(); if (p && p.catch) p.catch(() => {}); }\n  }\n}\nEOF\n","description":"Write the audio engine, instruments, tracks, SFX and voices"}}}
