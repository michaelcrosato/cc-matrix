ar beside you, in the next one.\n      lane.doll.root.position.set(lane.x, py, pz);\"\"\")\n# ---- Hide cursor while the mouse is playing; per-disc device glyphs in Group Class\nsub('src/game/director.js',\"\"\"    this.palette.frame(dt);\"\"\",\"\"\"    const hideCursor = !!(this.mode && this.mode.ev && this.mode.stage === 'play' && !this.paused && this.input.lastDevice === 'kbm');\n    if (hideCursor !== this.cursorHidden) { this.cursorHidden = hideCursor; document.body.classList.toggle('hide-cursor', hideCursor); }\n    this.palette.frame(dt);\"\"\")\nsub('src/ui/hud.js',\"\"\"      disc.addBreathWord();\n      this.discs.push({ lane, disc });\"\"\",\"\"\"      if (!group) disc.addBreathWord();\n      else {\n        // Each player's disc shows that player's own device.\n        const dev = lane.source === 'kbm' || lane.source === 'any' ? 'kbm' : 'pad';\n        disc.root.append(h('div.disc-dev', { html: glyphHTML('lean', dev, this.game.save.settings.glyphs) }));\n      }\n      this.discs.push({ lane, disc });\"\"\")\nsub('src/ui/hud.js',\"import { promptHTML } from '../input/glyphs.js';\",\"import { promptHTML, glyphHTML } from '../input/glyphs.js';\")\nsub('src/ui/ui.css',\".meter { position: relative;\",\".disc-dev { position: absolute; right: -2.6rem; bottom: -0.6rem; display: flex; gap: 0.2rem; }\\n.disc-dev .glyph { height: 3.6rem; }\\n.meter { position: relative;\")\n# ---- Breath sounds, near-tip word, squash\nsub('src/events/base.js',\"\"\"      lane.breath.step(dt, !!i.breathe, this.game.save.settings.autoBreathe || lane.breathAuto);\"\"\",\"\"\"      const wasGrowing = lane.breath.growing;\n      lane.breath.step(dt, !!i.breathe, this.game.save.settings.autoBreathe || lane.breathAuto);\n      if (lane.kind === 'local' && wasGrowing !== lane.breath.growing) this.game.audio.sfx(lane.breath.growing ? 'breathIn' : 'breathOut', { dur: 3.6 });\"\"\")\nsub('src/events/base.js',\"\"\"      if (!lane.nearing) { lane.nearing = true; lane.flailedNear = false; if (lane.kind === 'local') this.game.input.rumble(0.3, 0.5, 160, lane.input.padIndex >= 0 ? lane.input.padIndex : undefined); }\"\"\",\"\"\"      if (!lane.nearing) {\n        lane.nearing = true; lane.flailedNear = false;\n        if (lane.kind === 'local') {\n          this.game.input.rumble(0.3, 0.5, 160, lane.input.padIndex >= 0 ? lane.input.padIndex : undefined);\n          this.game.comic.pop('WOBBLE', b.fx, b.fy + 2.2, b.fz, { size: 1.7, life: 0.8 });\n        }\n        if (this.trudyArt) this.trudyArt.rig.once('gasp');\n      }\"\"\")\nsub('src/events/base.js',\"\"\"    lane.doll.rig.once('land');\n    this.game.audio.sfx('spring');\n    this.onRecover(lane);\"\"\",\"\"\"    lane.doll.rig.once('land');\n    lane.doll.squash = 1;\n    this.game.audio.sfx('spring');\n    if (this.trudyArt) this.trudyArt.rig.once('sulk');\n    this.onRecover(lane);\"\"\")\nsub('src/art/doll.js',\"\"\"  update(dt) {\n    if (this.ragdolled) return;\n    this.rig.update(dt);\"\"\",\"\"\"  update(dt) {\n    if (this.ragdolled) return;\n    this.rig.update(dt);\n    if (this.squash > 0) {\n      // Everyone squashes on landing.\n      this.squash = Math.max(0, this.squash - dt * 5);\n      const s = this.squash * this.squash;\n      this.facing.scale.set(1 + s * 0.16, 1 - s * 0.22, 1 + s * 0.16);\n    }\"\"\")\nsub('src/art/doll.js',\"    this.leanBend = 0;\\n\",\"    this.leanBend = 0;\\n    this.squash = 0;\\n\")\n# ---- Reactions\nsub('src/events/poses.js',\"if (this.outT > 2.2) { this.bark('stillwater', 'leave', 2.6, 8); this.outT = 0; }\",\"if (this.outT > 2.2) { this.bark('stillwater', 'leave', 2.6, 8); this.outT = 0; this.heron.rig.once('turn'); }\")\nsub('src/events/poses.js',\"\"\"  start() {\n    this.stage = 'wait'; this.stageT = 0;\"\"\",\"\"\"  start() {\n    this.heron.rig.once('bow');\n    this.stage = 'wait'; this.stageT = 0;\"\"\")\nsub('src/events/logReps.js',\"this.game.hud.setNote('Two bonus reps. Worth double.', 2.6); this.walrus.rig.once('salute'); }\",\"this.game.hud.setNote('Two bonus reps. Worth double.', 2.6); this.walrus.rig.once('inhale'); }\")\nsub('src/events/fruitHat.js',\"\"\"    if (lane.hat.length >= 3 && lane.kind === 'local') this.game.speech.say('trudy', this.lineSpill(), { auto: 2.6, top: true });\"\"\",\"\"\"    if (lane.hat.length >= 3 && lane.kind === 'local') { this.game.speech.say('trudy', this.lineSpill(), { auto: 2.6, top: true }); if (this.trudyArt) this.trudyArt.rig.once('faint', { hold: 0.6 }); }\"\"\")\nsub('src/game/checkin.js',\"\"\"    this.trudy.root.scale.setScalar(1.25);\"\"\",\"\"\"    this.trudy.root.scale.setScalar(1.25);\n    this.trudy.rig.loop('clipboard');\"\"\")\n# ---- Plate hum follows the hoop\nsub('src/events/plates.js',\"\"\"      this.drive(lane, dt);\n      const w = lane.hoop;\"\"\",\"\"\"      this.drive(lane, dt);\n      const w = lane.hoop;\n      if (lane.kind === 'local' && w > 1) {\n        lane.humT = (lane.humT || 0) - dt;\n        if (lane.humT <= 0) { lane.humT = 0.11; this.game.audio.sfx('plateHum', { pitch: 150 + w * 34 }); }\n      }\"\"\")\n# Test hook additions\nsub('src/core/testHooks.js',\"    EVENTS,\\n  };\",\"    EVENTS, EVENT_CLASSES,\\n  };\")\nsub('src/core/testHooks.js',\"import { EVENTS } from '../data/events.js';\",\"import { EVENTS } from '../data/events.js';\\nimport { EVENT_CLASSES } from '../events/index.js';\")\n# ---- Tests: rendered run for each event, WebKit boot, removed event, plates by keys\nsub('tools/test.mjs',\"\"\"  await page.context().close();\n  await browser.close();\n};\n\nmods.balance\"\"\",\"\"\"  await page.context().close();\n  await browser.close();\n  // One run with real rendering per event: WebGPU, device alive, frames rising, ink on screen.\n  const rb = await chromium.launch({ args: ['--no-sandbox', ...RENDER] });\n  const rp = await rb.newPage({ viewport: { width: 1280, height: 720 } });\n  const rerr = [];\n  rp.on('pageerror', (e) => rerr.push(String(e)));\n  rp.on('console', (m) => { if (/device lost/i.test(m.text())) rerr.push(m.text()); });\n  await rp.addInitScript(PAD_STUB);\n  await rp.goto(`${FILE_URL}?test=1&manual=1`);\n  await rp.waitForFunction(() => window.__TEST__ && !document.getElementById('boot'), null, { timeout: 180000 });\n  for (const id of EVENT_IDS) {\n    const s = await rp.evaluate(async (id) => {\n      const T = window.__TEST__, g = T.game;\n      T.startEvent(id, 0, {});\n      T.bot('sharp');\n      const f0 = g.frames, m0 = g.currentEvent.lanes[0].doll.rig.time;\n      for (let i = 0; i < 3; i++) { T.advance(0.7); await g.render(); }\n      const st = T.state();\n      return { frames: g.frames - f0, backend: st.render.backend, lost: st.render.lost, errs: st.errors.slice(0, 2), mixer: g.currentEvent.lanes[0].doll.rig.time - m0 };\n    }, id);\n    ok(s.backend === 'webgpu', `${id} renders on WebGPU`, s.backend);\n    ok(s.lost === null, `${id} device alive`, String(s.lost));\n    ok(s.frames >= 3, `${id} frames rising`, String(s.frames));\n    ok(s.mixer > 0.1, `${id} mixer time advances`, String(s.mixer));\n    ok(s.errs.length === 0, `${id} renders clean`, s.errs.join('|').slice(0, 200));\n  }\n  const png = await rp.screenshot();\n  ok(png.length > 40000, 'a rendered frame has real content', String(png.length));\n  await rp.evaluate(() => { const T = window.__TEST__; T.bot(null); T.goto('title'); });\n  ok(rerr.length === 0, 'no device lost or page errors while rendering', rerr.slice(0, 3).join('|').slice(0, 300));\n  await rb.close();\n  // WebKit: the WebGL2 fallback, through a few events.\n  const wb = await webkit.launch();\n  const wp = await wb.newPage({ viewport: { width: 960, height: 540 } });\n  const werr = [];\n  wp.on('pageerror', (e) => werr.push(String(e)));\n  await wp.addInitScript(PAD_STUB);\n  await wp.goto(`${FILE_URL}?test=1&manual=1`);\n  await wp.waitForFunction(() => window.__TEST__ && !document.getElementById('boot'), null, { timeout: 180000 });\n  for (const id of ['fruitHat', 'poses', 'stillWater']) {\n    const s = await wp.evaluate(async (id) => {\n      const T = window.__TEST__, g = T.game;\n      T.startEvent(id, 0, {});\n      T.advance(0.5); await g.render(); T.advance(0.5); await g.render();\n      const st = T.state();\n      return { backend: st.render.backend, frames: st.render.frames, errs: st.errors.slice(0, 2) };\n    }, id);\n    ok(s.backend === 'webgl2', `WebKit ${id} falls back to WebGL2`, s.backend);\n    ok(s.frames > 0 && s.errs.length === 0, `WebKit ${id} draws clean`, s.errs.join('|').slice(0, 300));\n  }\n  ok(werr.length === 0, 'WebKit no page errors', werr.slice(0, 2).join('|').slice(0, 300));\n  await wb.close();\n};\n\nmods.balance\"\"\")\nsub('tools/test.mjs',\"\"\"  const tug = await play('tug', 'sharp', 1);\"\"\",\"\"\"  // Plate Spinners on keys: alternate A and D at the band's tapping speed.\n  const keys = (jitter, slips) => page.evaluate(({ jitter, slips }) => {\n    const T = window.__TEST__; T.setSeed(4);\n    T.startEvent('plates', 0, {});\n    const ev = T.game.currentEvent, l = ev.lanes[0];\n    const tap = (k) => { window.dispatchEvent(new KeyboardEvent('keydown', { code: k, key: k })); window.dispatchEvent(new KeyboardEvent('keyup', { code: k, key: k })); };\n    const R = { L: 1.35, M: 2.3, S: 3.2 };\n    let next = 0.1, side = 'KeyA', t = 0, n = 0, target = null, react = 0;\n    let x = 12345;\n    const rnd = () => { x = (Math.imul(x, 1103515245) + 12345) & 0x7fffffff; return x / 0x7fffffff; };\n    while (!ev.isDone() && t < 70) {\n      react -= 1 / 120;\n      if (react <= 0) {\n        react = 0.5;\n        const low = l.plates.filter((p) => p.state === 'on').sort((a, b) => a.energy - b.energy)[0];\n        if (!target || target.state !== 'on' || target.energy > 0.92 || (low && low.energy < 0.22)) target = low;\n      }\n      next -= 1 / 120;\n      if (next <= 0) {\n        tap(side); side = side === 'KeyA' ? 'KeyD' : 'KeyA'; n++;\n        const rate = R[target ? target.size : 'M'];\n        next = (1 / rate) * (1 + (rnd() - 0.5) * jitter) + (rnd() < slips ? 0.5 : 0);\n      }\n      T.advance(1 / 120); t += 1 / 120;\n    }\n    const r = ev.laneResult(l);\n    T.goto('menu');\n    return { share: r.raw, n };\n  }, { jitter, slips });\n  const ks = await keys(0.06, 0.005), kc = await keys(0.4, 0.05);\n  ok(ks.share - kc.share >= 0.15, 'Plate Spinners separates on keys too', `${ks.share.toFixed(2)} vs ${kc.share.toFixed(2)}`);\n  const tug = await play('tug', 'sharp', 1);\"\"\")\nsub('tools/test.mjs',\"\"\"  const pl = await Promise.all([1, 2, 3].map((s) => play('plates', 'sharp', s)));\n  const ps = await Promise.all([1, 2, 3].map((s) => play('plates', 'clumsy', s)));\n  ok(mean(pl.map((r) => r.share)) - mean(ps.map((r) => r.share)) >= 0.1,\"\"\",\"\"\"  const pl = [await play('plates', 'sharp', 1), await play('plates', 'sharp', 2)];\n  const ps = [await play('plates', 'clumsy', 1), await play('plates', 'clumsy', 2)];\n  ok(mean(pl.map((r) => r.share)) - mean(ps.map((r) => r.share)) >= 0.15,\"\"\")\nsub('tools/test.mjs',\"import { launch, logicPage, FILE_URL, RENDER, PAD_STUB, OUT, root, dev } from './lib.mjs';\",\"import { launch, logicPage, FILE_URL, RENDER, PAD_STUB, OUT, root, dev } from './lib.mjs';\")\nsub('tools/test-flow.mjs',\"\"\"  // Every Dev page opens, and every button does something without throwing.\"\"\",\"\"\"  // A designer can cut an event: the programme just skips it.\n  const cut = await page.evaluate(() => {\n    const T = window.__TEST__, g = T.game;\n    const keep = T.EVENT_CLASSES.islandLoop;\n    const before = g.programme.totalSteps;\n    delete T.EVENT_CLASSES.islandLoop;\n    const after = g.programme.totalSteps;\n    const p = g.save.profile; const was = p.today.day; p.today.day = 4;\n    const classes = g.programme.classesToday();\n    p.today.day = was;\n    T.EVENT_CLASSES.islandLoop = keep;\n    return { before, after, classes };\n  });\n  ok(cut.after === cut.before - 1 && !cut.classes.includes('islandLoop'), 'a removed event leaves a working programme', JSON.stringify(cut));\n  // Every Dev page opens, and every button does something without throwing.\"\"\")\nEOF\npython3 - <<'EOF'\np='tools/test-flow.mjs'\ns=open(p).read()\na=\"\"\"  const dev = await page.evaluate(() => {\n    const T = window.__TEST__, g = T.game;\n    T.startEvent('fruitHat', 0, {});\n    T.advance(0.3);\n    T.goto('pause');\n    T.goto('dev');\n    return { top: T.state().screen };\n  });\n  ok(dev.top === 'dev', 'Dev opens by goto');\n\"\"\"\nb=\"\"\"  const dev = await page.evaluate(() => {\n    const T = window.__TEST__, g = T.game;\n    T.game.flow.runClass('fruitHat', 0, { programme: false });\n    T.advance(0.2); T.tap(0); T.advance(3);\n    const res = { used: 0, pages: 0, errs: [], skip: [] };\n    T.tap(9);\n    const open = () => { const items = [...document.querySelectorAll('[data-screen=\"pause\"] .item')].map((e) => e.textContent.trim()); const i = items.indexOf('Dev Mode'); const top = g.ui.top; top.setFocus(i, true); T.tap(0); };\n    open();\n    const dev0 = g.ui.top;\n    res.top = dev0.name;\n    const risky = /Reset save|Skip to|Go to that class|Jump to that day|Free camera|Set Wobble/;\n    for (let pg = 0; pg < dev0.pages; pg++) {\n      res.pages++;\n      for (let i = 0; i < dev0.items.length; i++) {\n        const it = dev0.items[i];\n        const text = it.el.textContent;\n        if (risky.test(text)) { res.skip.push(text); continue; }\n        try {\n          dev0.setFocus(i, true);\n          if (it.right) it.right();\n          if (it.left) it.left();\n          if (it.use) { it.use(); T.advance(0.02); }\n          while (g.ui.top !== dev0) g.ui.close(g.ui.top);\n          res.used++;\n        } catch (e) { res.errs.push(`${text}: ${e.message}`); }\n      }\n      dev0.turn(1);\n      T.advance(0.01);\n    }\n    T.resetTuning();\n    g.applyInk();\n    res.gameErrs = g.errors.slice();\n    return res;\n  });\n  ok(dev.top === 'dev', 'Dev opens from Pause', dev.top);\n  ok(dev.pages >= 8 && dev.used > 30, 'every Dev page and button works', JSON.stringify({ p: dev.pages, u: dev.used }));\n  ok(dev.errs.length === 0 && dev.gameErrs.length === 0, 'Dev controls run clean', [...dev.errs, ...dev.gameErrs].join(' | ').slice(0, 400));\n  // The jumps themselves.\n  const jumps = await page.evaluate(() => {\n    const T = window.__TEST__, g = T.game;\n    const res = {};\n    const devItem = (label) => { const top = g.ui.top; for (let pg = 0; pg < top.pages; pg++) { const i = top.items.findIndex((x) => x.el.textContent.includes(label)); if (i >= 0) return top.items[i]; top.turn(1); T.advance(0.01); } return null; };\n    devItem('Skip to Results').use();\n    T.advance(3);\n    res.afterSkip = T.state().screen;\n    T.goto('menu');\n    return res;\n  });\n  ok(jumps.afterSkip === 'results', 'Skip to Results lands on Results', jumps.afterSkip);\n\"\"\"\nassert a in s\ns=s.replace(a,b)\nopen(p,'w').write(s)\nEOF\nsed -i \"s/^import { launch, logicPage, FILE_URL, RENDER, PAD_STUB, OUT, root, dev } from '.\\/lib.mjs';/import { launch, logicPage, FILE_URL, RENDER, PAD_STUB, OUT, root, dev } from '.\\/lib.mjs';/\" tools/test.mjs\nnode tools/build.mjs && timeout 590 node tools/test.mjs unit flow 2>&1 | cut -c1-500 | tail -24","description":"Apply polish and fixes, extend tests, run unit and flow","timeout":600000}}}
