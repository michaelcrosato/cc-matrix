d((p) => p.id === id) || PAINTS[0]).shirt;\n\nconst _q = new THREE.Quaternion(), _q2 = new THREE.Quaternion();\n\n/** The jointed wooden peg doll: named joints, rigid parts, one AnimationMixer. */\nexport class Doll {\n  constructor({ shirt = '#2CB5A0', hat = 'none', height = 1, width = 1, shorts = SHORTS, face = true } = {}) {\n    this.root = G('root');\n    this.facing = G('facing');\n    this.root.add(this.facing);\n    const J = this.joints = {};\n    const hips = J.hips = G('hips', 0, 0.46, 0);\n    this.facing.add(hips);\n    hips.scale.set(width, height, width);\n    add(hips, M(geo.cap(0.2, 0.08), shorts, 0, 0.02, 0, { scale: [1.05, 1, 0.85] }));\n    const spine = J.spine = G('spine', 0, 0.12, 0);\n    hips.add(spine);\n    this.shirtMat = toon(shirt);\n    this.shirtMesh = M(geo.cap(0.21, 0.24), this.shirtMat, 0, 0.17, 0, { scale: [1, 1, 0.82] });\n    spine.add(this.shirtMesh);\n    const head = J.head = G('head', 0, 0.7, 0);\n    spine.add(head);\n    add(head,\n      M(geo.sphere(0.23, 24, 18), SKIN),\n      M(geo.sphere(0.024, 10, 8), INK, 0.08, 0.03, 0.205, { shadow: false }),\n      M(geo.sphere(0.024, 10, 8), INK, -0.08, 0.03, 0.205, { shadow: false }),\n      M(geo.sphere(0.04, 10, 8), CHEEK, 0.13, -0.035, 0.175, { scale: [1, 0.6, 0.4], shadow: false }),\n      M(geo.sphere(0.04, 10, 8), CHEEK, -0.13, -0.035, 0.175, { scale: [1, 0.6, 0.4], shadow: false }),\n      M(geo.tor(0.05, 0.009, Math.PI), INK, 0, -0.04, 0.215, { rot: [0, 0, Math.PI], shadow: false }));\n    this.headband = M(geo.tor(0.228, 0.02), this.shirtMat, 0, 0.09, 0, { rot: [Math.PI / 2, 0, 0] });\n    head.add(this.headband);\n    for (const [s, side] of [[1, 'L'], [-1, 'R']]) {\n      const sh = J[`shoulder${side}`] = G(`shoulder${side}`, s * 0.26, 0.38, 0);\n      spine.add(sh);\n      add(sh, M(geo.sphere(0.075, 12, 10), JOINT), M(geo.cap(0.055, 0.12), SKIN, 0, -0.11, 0));\n      const el = J[`elbow${side}`] = G(`elbow${side}`, 0, -0.22, 0);\n      sh.add(el);\n      add(el, M(geo.sphere(0.06, 12, 10), JOINT), M(geo.cap(0.05, 0.1), SKIN, 0, -0.1, 0), M(geo.sphere(0.07, 12, 10), WHITE, 0, -0.2, 0));\n      const hp = J[`hip${side}`] = G(`hip${side}`, s * 0.13, -0.02, 0);\n      hips.add(hp);\n      add(hp, M(geo.cap(0.08, 0.08), SKIN, 0, -0.1, 0));\n      const kn = J[`knee${side}`] = G(`knee${side}`, 0, -0.2, 0);\n      hp.add(kn);\n      add(kn, M(geo.cap(0.072, 0.08), SKIN, 0, -0.09, 0));\n      const an = J[`ankle${side}`] = G(`ankle${side}`, 0, -0.185, 0);\n      kn.add(an);\n      add(an, M(geo.sphere(0.1, 12, 10), WHITE, 0, -0.005, 0.045, { scale: [1, 0.55, 1.5] }));\n    }\n    this.hatGroup = G('hatHolder', 0, 0, 0);\n    head.add(this.hatGroup);\n    this.setHat(hat);\n    this.rest = {};\n    for (const k of Object.keys(J)) this.rest[k] = { p: J[k].position.clone(), q: J[k].quaternion.clone() };\n    this.rig = new Rig(this.root, DOLL_CLIPS);\n    this.rig.loop('idle', { fade: 0 });\n    this.flatFeet = true;\n    this.ragdolled = false;\n    this.leanBend = 0;\n  }\n  setShirt(colour) {\n    this.shirtMat = toon(colour);\n    this.shirtMesh.material = this.shirtMat;\n    this.headband.material = this.shirtMat;\n  }\n  setHat(hat) {\n    this.hat = hat;\n    this.hatGroup.clear();\n    const g = this.hatGroup;\n    switch (hat) {\n      case 'visor':\n        add(g, M(geo.tor(0.228, 0.03), 0xFFF8EA, 0, 0.12, 0, { rot: [Math.PI / 2, 0, 0] }), M(geo.sphere(0.2, 16, 8), 0x2CB5A0, 0, 0.1, 0.2, { scale: [0.9, 0.08, 0.7] }));\n        break;\n      case 'beret':\n        add(g, M(geo.sphere(0.26, 16, 10), 0xC24D6A, 0.04, 0.18, 0, { scale: [1.05, 0.34, 1.05], rot: [0, 0, -0.2] }), M(geo.cyl(0.015, 0.015, 0.06, 8), 0xC24D6A, 0.05, 0.28, 0));\n        break;\n      case 'bucket':\n        add(g, M(geo.cyl(0.19, 0.24, 0.16), 0xE9D7A8, 0, 0.21, 0), M(geo.cyl(0.33, 0.33, 0.016, 28), 0xE9D7A8, 0, 0.13, 0));\n        break;\n      case 'perm':\n        for (let i = 0; i < 16; i++) {\n          const a = i * 2.4, r = 0.17 + (i % 3) * 0.03, y = 0.09 + (i % 4) * 0.045;\n          g.add(M(geo.sphere(0.078, 10, 8), 0xB9B4C4, Math.cos(a) * r, y, Math.sin(a) * r - 0.02));\n        }\n        g.add(M(geo.sphere(0.13, 12, 8), 0xB9B4C4, 0, 0.24, -0.01));\n        break;\n      case 'wizard':\n        add(g, M(geo.cone(0.22, 0.5, 20), 0x4B3D8F, 0, 0.4, 0), M(geo.cyl(0.32, 0.32, 0.016, 28), 0x4B3D8F, 0, 0.15, 0), M(geo.sphere(0.03, 8, 6), 0xF5B700, 0.1, 0.32, 0.14), M(geo.sphere(0.022, 8, 6), 0xF5B700, -0.05, 0.47, 0.09));\n        break;\n      case 'crown':\n        add(g, M(geo.cyl(0.12, 0.1, 0.07, 12), 0xF5B700, 0, 0.26, 0));\n        for (let i = 0; i < 6; i++) { const a = (i / 6) * Math.PI * 2; g.add(M(geo.cone(0.025, 0.055, 6), 0xF5B700, Math.cos(a) * 0.11, 0.32, Math.sin(a) * 0.11)); }\n        break;\n      default: break;\n    }\n  }\n  /** Set lean from the balance core: root takes it, spine exaggerates, head counters, feet stay flat. */\n  setLean(qx, qy, qz, qw) { this.root.quaternion.set(qx, qy, qz, qw); }\n  place(x, y, z) { this.root.position.set(x, y, z); }\n  face(yaw) { this.facing.rotation.y = yaw; }\n  update(dt) {\n    if (this.ragdolled) return;\n    this.rig.update(dt);\n    if (this.flatFeet) {\n      for (const side of ['L', 'R']) {\n        const an = this.joints[`ankle${side}`];\n        an.parent.getWorldQuaternion(_q);\n        this.root.parent && this.root.parent.getWorldQuaternion(_q2);\n        if (this.root.parent) _q2.multiply(this.facing.quaternion); else _q2.copy(this.facing.quaternion);\n        an.quaternion.copy(_q.invert()).multiply(_q2);\n      }\n    }\n  }\n}\nEOF\ncat > src/art/cast.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { M, G, geo, toon, add } from './materials.js';\nimport { Rig } from '../anim/rig.js';\nimport { TRUDY_CLIPS, HERON_CLIPS, WALRUS_CLIPS, GULL_CLIPS } from '../anim/clips.js';\n\nconst INK = 0x1A1420;\n\n/** Trudy, Head of Alignment: a chunky spirit level whose bubble is her eye. */\nexport class Trudy {\n  constructor() {\n    this.root = G('trudyRoot');\n    const body = this.body = G('body', 0, 0.34, 0);\n    this.root.add(body);\n    add(body, M(geo.rbox(1.1, 0.42, 0.26, 0.1), 0xF5B700), M(geo.box(0.56, 0.2, 0.05), 0x2A2A3C, 0, 0.02, 0.12, { shadow: false }));\n    add(body, M(geo.cap(0.075, 0.36), 0xB9F26B, 0, 0.02, 0.15, { rot: [0, 0, Math.PI / 2], shadow: false }));\n    this.bubble = M(geo.sphere(0.06, 14, 10), 0xFFFFFF, 0, 0.02, 0.215, { scale: [1.2, 1, 0.6], shadow: false });\n    this.pupil = M(geo.sphere(0.024, 10, 8), INK, 0, 0, 0.05, { shadow: false });\n    this.bubble.add(this.pupil);\n    body.add(this.bubble);\n    add(body,\n      M(geo.box(0.012, 0.15, 0.02), INK, 0.08, 0.02, 0.232, { shadow: false }),\n      M(geo.box(0.012, 0.15, 0.02), INK, -0.08, 0.02, 0.232, { shadow: false }),\n      M(geo.sphere(0.075, 12, 10), 0xB9F26B, 0.42, 0.02, 0.1, { scale: [1, 1, 0.6], shadow: false }),\n      M(geo.sphere(0.075, 12, 10), 0xB9F26B, -0.42, 0.02, 0.1, { scale: [1, 1, 0.6], shadow: false }));\n    this.mouth = M(geo.tor(0.06, 0.012, Math.PI), INK, 0, -0.12, 0.135, { rot: [0, 0, Math.PI], shadow: false });\n    body.add(this.mouth);\n    const pegL = G('pegL', 0.28, -0.2, 0), pegR = G('pegR', -0.28, -0.2, 0);\n    add(pegL, M(geo.cyl(0.05, 0.06, 0.14), 0x8A5A32, 0, -0.07, 0));\n    add(pegR, M(geo.cyl(0.05, 0.06, 0.14), 0x8A5A32, 0, -0.07, 0));\n    add(body, pegL, pegR);\n    this.rig = new Rig(this.root, TRUDY_CLIPS);\n    this.rig.loop('idle', { fade: 0 });\n    this.bubbleX = 0; this.bubbleTarget = 0; this.bubbleV = 0;\n    this.squash = 0;\n    this.hopT = 0; this.tx = 0; this.tz = 0; this.moving = false; this.yaw = 0;\n  }\n  /** The bubble slides to the high side of the world and to wherever she is feeling. */\n  feel(x) { this.bubbleTarget = Math.max(-1, Math.min(1, x)); }\n  update(dt) {\n    this.rig.update(dt);\n    const f = (this.bubbleTarget - this.bubbleX) * 26 - this.bubbleV * 5;\n    this.bubbleV += f * dt; this.bubbleX += this.bubbleV * dt;\n    this.bubble.position.x = Math.max(-0.15, Math.min(0.15, this.bubbleX * 0.15));\n    if (this.squash > 0) this.squash = Math.max(0, this.squash - dt * 5);\n    const s = this.squash;\n    this.body.scale.set(1 + s * 0.2, 1 - s * 0.25, 1 + s * 0.1);\n  }\n}\n\n/** Ms. Stillwater: a tall heron on one leg. A voice like a slow door. */\nexport class Heron {\n  constructor() {\n    this.root = G('heronRoot');\n    const leg = M(geo.cyl(0.025, 0.025, 1.05, 10), 0xF08A3C, 0, 0.525, 0);\n    const foot = M(geo.sphere(0.12, 10, 8), 0xF08A3C, 0, 0.012, 0.05, { scale: [1, 0.12, 1.3] });\n    add(this.root, leg, foot);\n    const body = G('body', 0, 1.08, 0);\n    this.root.add(body);\n    body.add(M(geo.sphere(0.34, 22, 16), 0xA9C2D4, 0, 0.05, -0.02, { scale: [0.8, 0.92, 1.35] }));\n    const wL = G('wingL', 0.25, 0.1, 0), wR = G('wingR', -0.25, 0.1, 0);\n    wL.add(M(geo.sphere(0.3, 14, 10), 0x7E9CB4, 0.03, -0.06, -0.08, { scale: [0.22, 0.75, 1.25] }));\n    wR.add(M(geo.sphere(0.3, 14, 10), 0x7E9CB4, -0.03, -0.06, -0.08, { scale: [0.22, 0.75, 1.25] }));\n    add(body, wL, wR);\n    const tuck = G('legTuck', 0.08, -0.2, -0.05);\n    add(tuck, M(geo.cyl(0.025, 0.025, 0.28, 8), 0xF08A3C, 0, -0.14, 0));\n    const shin = G('shin', 0, -0.28, 0);\n    add(shin, M(geo.cyl(0.022, 0.022, 0.28, 8), 0xF08A3C, 0, -0.14, 0), M(geo.sphere(0.07, 8, 6), 0xF08A3C, 0, -0.28, 0.03, { scale: [1, 0.2, 1.4] }));\n    tuck.add(shin);\n    body.add(tuck);\n    body.add(M(geo.sphere(0.09, 10, 8), 0xC24D6A, 0, 0.3, 0.22, { scale: [1.5, 0.6, 1.1] }));\n    // S-curve neck from five joints.\n    let parent = body;\n    const lens = [0.2, 0.2, 0.2, 0.2, 0.18];\n    const offs = [[0, 0.32, 0.24], [0, 0.2, 0.05], [0, 0.2, -0.05], [0, 0.2, -0.04], [0, 0.2, 0.05]];\n    this.neck = [];\n    for (let i = 0; i < 5; i++) {\n      const n = G(`n${i + 1}`, ...offs[i]);\n      n.add(M(geo.cap(0.062 - i * 0.003, lens[i] * 0.8), 0xD6E3EC, 0, lens[i] / 2, 0));\n      parent.add(n); parent = n; this.neck.push(n);\n    }\n    const head = this.head = G('hhead', 0, 0.2, 0.02);\n    parent.add(head);\n    add(head,\n      M(geo.sphere(0.115, 16, 12), 0xE6EEF3),\n      M(geo.cone(0.045, 0.3, 10), 0xF2C14E, 0, -0.02, 0.2, { rot: [Math.PI / 2, 0, 0] }),\n      M(geo.cone(0.03, 0.22, 8), INK, 0, 0.1, -0.12, { rot: [-2.2, 0, 0] }),\n      M(geo.tor(0.03, 0.007, Math.PI), INK, 0.065, 0.02, 0.09, { rot: [0, 0.6, 0], shadow: false }),\n      M(geo.tor(0.03, 0.007, Math.PI), INK, -0.065, 0.02, 0.09, { rot: [0, -0.6, 0], shadow: false }),\n      M(geo.sphere(0.012, 8, 6), INK, 0.07, 0.012, 0.092, { shadow: false }),\n      M(geo.sphere(0.012, 8, 6), INK, -0.07, 0.012, 0.092, { shadow: false }));\n    this.rig = new Rig(this.root, HERON_CLIPS);\n    this.rig.loop('stand', { fade: 0 });\n  }\n  update(dt) { this.rig.update(dt); }\n}\n\n/** Coach Bolster: a vast walrus in a sweatband, with a whistle he always forgets to blow. */\nexport class Walrus {\n  constructor() {\n    this.root = G('walrusRoot');\n    const body = G('wbody', 0, 1.1, 0);\n    this.root.add(body);\n    body.add(M(geo.cap(0.72, 0.5, 20), 0xB9806A, 0, 0, 0, { scale: [1.06, 1, 0.9] }));\n    body.add(M(geo.sphere(0.5, 16, 12), 0xD3A08A, 0, -0.3, 0.42, { scale: [1, 0.9, 0.5] }));\n    add(this.root, M(geo.sphere(0.34, 12, 10), 0x8D5F4F, 0.46, 0.1, 0.1, { scale: [1, 0.3, 1.3] }), M(geo.sphere(0.34, 12, 10), 0x8D5F4F, -0.46, 0.1, 0.1, { scale: [1, 0.3, 1.3] }));\n    const head = G('whead', 0, 0.62, 0.08);\n    body.add(head);\n    add(head,\n      M(geo.tor(0.56, 0.08, Math.PI * 2, 40), 0xD43F3A, 0, 0.32, -0.02, { rot: [Math.PI / 2, 0, 0], scale: [1, 0.92, 1] }),\n      M(geo.sphere(0.2, 14, 10), 0xEBD6C2, 0.16, -0.08, 0.62),\n      M(geo.sphere(0.2, 14, 10), 0xEBD6C2, -0.16, -0.08, 0.62),\n      M(geo.cone(0.06, 0.42, 10), 0xFFF3DC, 0.16, -0.38, 0.66, { rot: [Math.PI, 0, 0] }),\n      M(geo.cone(0.06, 0.42, 10), 0xFFF3DC, -0.16, -0.38, 0.66, { rot: [Math.PI, 0, 0] }),\n      M(geo.sphere(0.05, 10, 8), INK, 0, 0.03, 0.72, { scale: [1.3, 0.8, 0.7], shadow: false }),\n      M(geo.sphere(0.04, 10, 8), INK, 0.22, 0.2, 0.56, { shadow: false }),\n      M(geo.sphere(0.04, 10, 8), INK, -0.22, 0.2, 0.56, { shadow: false }));\n    add(body, M(geo.tor(0.42, 0.018, Math.PI * 2, 40), 0xFFFFFF, 0, 0.26, 0.2, { rot: [1.15, 0, 0] }), M(geo.cap(0.05, 0.1), 0xF5C518, 0, -0.1, 0.64, { rot: [0, 0, Math.PI / 2] }));\n    const fL = G('flipL', 0.72, 0.1, 0.05), fR = G('flipR', -0.72, 0.1, 0.05);\n    fL.add(M(geo.sphere(0.34, 12, 10), 0x8D5F4F, 0.04, -0.3, 0, { scale: [0.42, 1.25, 0.8] }));\n    fR.add(M(geo.sphere(0.34, 12, 10), 0x8D5F4F, -0.04, -0.3, 0, { scale: [0.42, 1.25, 0.8] }));\n    add(body, fL, fR);\n    this.rig = new Rig(this.root, WALRUS_CLIPS);\n    this.rig.loop('stand', { fade: 0 });\n  }\n  update(dt) { this.rig.update(dt); }\n}\n\n/** Gary. He steals things and lands on you. */\nexport class Gull {\n  constructor() {\n    this.root = G('gullRoot');\n    const body = G('gbody', 0, 0.28, 0);\n    this.root.add(body);\n    body.add(M(geo.sphere(0.2, 16, 12), 0xFFFDF7, 0, 0, 0, { scale: [0.82, 0.8, 1.35] }));\n    const wL = G('gwingL', 0.14, 0.05, -0.02), wR = G('gwingR', -0.14, 0.05, -0.02);\n    wL.add(M(geo.sphere(0.2, 10, 8), 0xAEB6BE, 0.17, 0, -0.03, { scale: [1, 0.14, 0.72] }));\n    wR.add(M(geo.sphere(0.2, 10, 8), 0xAEB6BE, -0.17, 0, -0.03, { scale: [1, 0.14, 0.72] }));\n    add(body, wL, wR);\n    const head = G('ghead', 0, 0.12, 0.2);\n    body.add(head);\n    add(head,\n      M(geo.sphere(0.115, 14, 10), 0xFFFDF7),\n      M(geo.cone(0.045, 0.17, 10), 0xF5B700, 0, -0.015, 0.16, { rot: [Math.PI / 2, 0, 0] }),\n      M(geo.sphere(0.017, 8, 6), INK, 0.058, 0.03, 0.09, { shadow: false }),\n      M(geo.sphere(0.017, 8, 6), INK, -0.058, 0.03, 0.09, { shadow: false }),\n      M(geo.box(0.1, 0.018, 0.02), INK, 0.052, 0.06, 0.09, { rot: [0, 0, -0.5], shadow: false }));\n    add(this.root, M(geo.cyl(0.012, 0.012, 0.16, 6), 0xF08A3C, 0.05, 0.08, 0), M(geo.cyl(0.012, 0.012, 0.16, 6), 0xF08A3C, -0.05, 0.08, 0));\n    this.rig = new Rig(this.root, GULL_CLIPS);\n    this.rig.loop('stand', { fade: 0 });\n  }\n  update(dt) { this.rig.update(dt); }\n}\nEOF\nsed -i \"/^import { positionLocal, normalLocal, float } from 'three\\/tsl';$/d\" src/art/materials.js && sed -i \"s#^import { INK } from '../data/config.js';#import { positionLocal, normalLocal, float } from 'three/tsl';\\nimport { INK } from '../data/config.js';#\" src/art/materials.js && head -6 src/art/materials.js","description":"Write rig, clips, doll and cast art modules"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15967,"cache_read_input_tokens":150162,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15967},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"738a1b00-f553-4780-ad42-f21e2cff3de3","timestamp":"2026-11-05T11:58:59.202Z","request_id":"req_011CgjjkZKXocF1vzyxCxUKN","wire_tool_inputs":{"toolu_01JKuHMcUejcJUfpTv9gt1hW":{"command":"cat > src/anim/rig.js <<'EOF'\nimport * as THREE from 'three/webgpu';\n\n/** AnimationMixer wrapper: a base clip, one-shots that return to it, and scrubbed clips. */\nexport class Rig {\n  constructor(root, clips) {\n    this.root = root; this.clips = clips;\n    this.mixer = new THREE.AnimationMixer(root);\n    this.actions = new Map();\n    this.current = null; this.currentName = null; this.base = null;\n    this.onceLeft = 0; this.time = 0;\n  }\n  action(name) {\n    let a = this.actions.get(name);\n    if (!a) {\n      const clip = this.clips[name];\n      if (!clip) return null;\n      a = this.mixer.clipAction(clip);\n      this.actions.set(name, a);\n    }\n    return a;\n  }\n  /** Change the looping clip. */\n  loop(name, { fade = 0.25, speed = 1 } = {}) {\n    this.base = name;\n    this.baseSpeed = speed;\n    if (this.onceLeft > 0) return;\n    this._to(name, fade, speed, false);\n  }\n  /** Play once, then fall back to the looping clip. */\n  once(name, { fade = 0.1, speed = 1, hold = 0 } = {}) {\n    const clip = this.clips[name];\n    if (!clip) return;\n    this._to(name, fade, speed, true);\n    this.onceLeft = clip.duration / speed + hold;\n  }\n  /** Pause a clip at a share of its length: squats, hoops, anything driven by a number. */\n  scrub(name, phase, { fade = 0.2 } = {}) {\n    const a = this.action(name);\n    if (!a) return;\n    if (this.onceLeft > 0) { this.base = name; a.time = 0; return; }\n    if (this.currentName !== name) { this._to(name, fade, 1, false); this.base = name; }\n    a.paused = true;\n    a.time = Math.max(0, Math.min(1, phase)) * a.getClip().duration * 0.9999;\n  }\n  _to(name, fade, speed, once) {\n    const a = this.action(name);\n    if (!a) return;\n    if (this.currentName === name && !once) { a.setEffectiveTimeScale(speed); a.paused = false; return; }\n    a.reset();\n    a.setLoop(once ? THREE.LoopOnce : THREE.LoopRepeat, once ? 1 : Infinity);\n    a.clampWhenFinished = once;\n    a.setEffectiveTimeScale(speed);\n    a.setEffectiveWeight(1);\n    a.play();\n    if (this.current && this.current !== a) this.current.crossFadeTo(a, fade, false);\n    this.current = a; this.currentName = name;\n  }\n  update(dt) {\n    if (this.onceLeft > 0) {\n      this.onceLeft -= dt;\n      if (this.onceLeft <= 0) { this.onceLeft = 0; if (this.base) this._to(this.base, 0.2, this.baseSpeed || 1, false); }\n    }\n    this.mixer.update(dt);\n    this.time += dt;\n  }\n}\nEOF\ncat > src/anim/clips.js <<'EOF'\nimport * as THREE from 'three/webgpu';\n\nconst D = Math.PI / 180;\nconst _e = new THREE.Euler(), _q = new THREE.Quaternion();\n\n/**\n * Compile { t, pose: { joint: [x, y, z in degrees], ... }, pos: { joint: [x, y, z] } } keys into a clip.\n * A joint missing from a key holds its last value.\n */\nexport function poseClip(name, duration, keys, restPos = {}) {\n  const joints = new Set(), movers = new Set();\n  for (const k of keys) {\n    for (const j of Object.keys(k.pose || {})) joints.add(j);\n    for (const j of Object.keys(k.pos || {})) movers.add(j);\n  }\n  const tracks = [];\n  for (const j of joints) {\n    const times = [], vals = [];\n    let last = [0, 0, 0];\n    for (const k of keys) {\n      const v = (k.pose && k.pose[j]) || last;\n      last = v;\n      times.push(k.t);\n      _e.set(v[0] * D, v[1] * D, v[2] * D);\n      _q.setFromEuler(_e);\n      vals.push(_q.x, _q.y, _q.z, _q.w);\n    }\n    tracks.push(new THREE.QuaternionKeyframeTrack(`${j}.quaternion`, times, vals));\n  }\n  for (const j of movers) {\n    const times = [], vals = [];\n    const base = restPos[j] || [0, 0, 0];\n    let last = [0, 0, 0];\n    for (const k of keys) {\n      const v = (k.pos && k.pos[j]) || last;\n      last = v;\n      times.push(k.t);\n      vals.push(base[0] + v[0], base[1] + v[1], base[2] + v[2]);\n    }\n    tracks.push(new THREE.VectorKeyframeTrack(`${j}.position`, times, vals));\n  }\n  return new THREE.AnimationClip(name, duration, tracks);\n}\n\n// ---- Peg doll ---- (faces +z; L is +x. Shoulder z out, x negative forward. Knee x positive bends back.)\nconst HIPS = { hips: [0, 0.46, 0] };\nconst c = (name, dur, keys) => poseClip(name, dur, keys, HIPS);\nconst ARMS_REST = { shoulderL: [0, 0, 7], shoulderR: [0, 0, -7], elbowL: [-10, 0, 0], elbowR: [-10, 0, 0] };\nconst LEGS_REST = { hipL: [0, 0, 0], hipR: [0, 0, 0], kneeL: [0, 0, 0], kneeR: [0, 0, 0] };\nconst REST = { ...ARMS_REST, ...LEGS_REST, spine: [0, 0, 0], head: [0, 0, 0] };\n\nfunction pose(name, arms, extra = {}) {\n  return c(name, 2.4, [\n    { t: 0, pose: { ...REST, ...arms, ...extra } },\n    { t: 1.2, pose: { ...REST, ...arms, ...extra, spine: [(extra.spine?.[0] ?? 0) + 2, extra.spine?.[1] ?? 0, extra.spine?.[2] ?? 0] } },\n    { t: 2.4, pose: { ...REST, ...arms