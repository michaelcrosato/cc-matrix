{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjkb5zqMB2NeVPNqwAVd","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14842,"cache_read_input_tokens":239010,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14842},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"54aaecd5-22d1-4ac0-8952-b92048c29836","timestamp":"2026-11-05T12:06:34.066Z","request_id":"req_011Cgjkb5iDx3hAhrN1NE42g","thinking_duration_ms":7195,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjkb5zqMB2NeVPNqwAVd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KSkeqBAZaG7sxdJnVfS5P9","name":"Bash","input":{"command":"cat > src/data/dialogue.js <<'EOF'\nimport { cos } from '../core/rng.js';\n\n// Every line in the game, by speaker and situation. Add a line here and it exists.\n// Rules: short, polite, second person, a straight face, and nothing about bodies or food habits.\nexport const LINES = {\n  trudy: {\n    drop_in: ['Oh! A person. Please step on. Not on me. On the island.', \"Please step on. Not on me. On the island. I'm a level, not a bath mat.\"],\n    lean_left: ['Lean left, please. As far as is polite.', 'Lean left. Your other left. No, that was correct. I was testing you.'],\n    lean_right: ['Now lean right. I can feel that, by the way.', 'And right. Everything on this island is listening to your hips.'],\n    lean_forward: ['Now forward. Toward the sea, or me, or your future.', 'Forward now. Go on. The oranges have already started without you.'],\n    lean_done: ['Good. You have moved an entire island. Most guests take a week to feel guilty about that.', 'There. That is what we do here. We lean, and things roll.'],\n    first_checkin: ['Now for your Check-In. It is three short tests. It is not a judgement. It is a number.', 'Please stand on the mat. I would like to ask your knees a few questions.'],\n    morning: [\n      'Good morning. The island is still crooked. I checked twice.', 'Good morning. You look upright. I will confirm that shortly.', 'You came back. I was not counting. I am never counting.',\n      'Good morning. I have your file. It is one page. I have read it eleven times.', 'Oh, good. You. I had a feeling about today. It was about four degrees.',\n      'Good morning. The gulls have asked me to tell you nothing. So I will tell you nothing.', \"Rise and level. I made that up. I'm very proud of it.\",\n      'Welcome back. I kept your spot on the mat warm. I stood on it. For hours.', 'Another morning. I have been up since the first one.',\n      'Good morning. Today is a day. I have it written down.', 'Good morning. Your knees called ahead. They sounded nervous.',\n      'It is morning again. I find that very reliable of it.', 'There you are. Everyone else has been pretending not to wait.',\n      'Hello. Please stand where I can see you. Thank you. I can see you.', 'Good morning. Let us find out what kind of person you are today. Approximately.',\n    ],\n    returned: [\n      \"Oh! You came back. I wasn't counting. It has been a while. Some hours. Some minutes.\", \"You're here. I didn't notice you were gone. I noticed very slightly.\",\n      \"It's been some time. The island tilted a bit. I'm not saying those things are connected. They are connected.\", 'You were away. I kept your marbles dusted. One at a time.',\n      'Welcome back. Nobody sat on your mat. I would have seen. I was looking.', 'You have returned. I have prepared a small speech, but I will not be giving it.',\n    ],\n    question_intro: ['Before we begin, one small question. There is no wrong answer. I will still write it down.', 'One question first. I ask every guest. I ask some of them twice.'],\n    checkin_start: ['Stand on the mat, please. Stay as you are, and I will look at you in a professional way.', 'This is the Check-In. Three small tests. Try to enjoy being measured.'],\n    checkin_good: ['Oh, that was tidy.', 'Very nice. I felt that in my vial.', 'I will be telling the others about that. Quietly.', 'That was nearly level. I got a little emotional.'],\n    checkin_bad: [\"That's fine. That is a number too.\", 'Noted. In pencil. For now.', 'We will call that a warm-up. We will call everything a warm-up.', 'It was a test of honesty, and you passed.'],\n    reveal_lead: ['Your Wobble Age is...', \"I've done the sums. I did them twice. Your Wobble Age is...\"],\n    age_old: ['Some of my favourite people are {age}. Mostly the ones sitting down.', \"{age}. I didn't ask how old you are. I asked your knees.\", \"{age}! Your knees have seen things. They wouldn't tell me what.\", 'That is {age}. A very stable number, as numbers go. Unlike you.'],\n    age_mid: ['{age}. A good age. You could still surprise someone.', \"{age}. That is a respectable wobble. I've seen hat stands do worse.\", 'That is {age}. Nobody has complained. Nobody has been asked.', '{age}. Very middle. I like the middle. I have heard good things about it.'],\n    age_low: ['{age}! You may keep your own stairs.', '{age}. I wrote it down twice because I enjoyed it.', 'That is {age}. Keep this up and I will have to find something else to worry about.', '{age}. Look at you, being a person who stands.'],\n    age_young: ['{age}. I am suspicious, but in a warm way.', '{age}! If this continues, you will eventually be born.', 'That is {age}. Do your knees know? Do not tell them.', '{age}. I got a little emotional. My bubble went sideways.'],\n    age_down: [\"That's down from {prev}! If this continues, you will eventually be born.\", 'That is down from {prev}. I am not crying. I am a level.', 'Yesterday you were {prev}. Time is going the right way for once.'],\n    age_same: ['The same as before. Consistency is important.', 'Exactly the same. You are nothing if not repeatable.'],\n    plan: [\"Here is today's plan. You may do them in any order. I will have opinions either way.\", 'Your classes are on the board. Do try to go to them. They can tell.', 'Today has been arranged. Please walk to your classes or pick one from the list. I would walk.'],\n    fall: [\n      \"Let's call that a floor exercise.\", 'You fell very consistently. Consistency is important.', 'That was a good fall. It had a beginning, a middle and a floor.', 'I have recorded that as a deliberate choice.',\n      'The floor was pleased to see you.', 'That counts. Everything counts. I keep count.', 'Very thorough. You checked the whole floor.', 'Gravity is a shared resource, and you used your share.',\n      'I saw that. Nobody else did. Several people saw that.', \"Don't worry. The ground has been there for a long time. It's used to it.\", 'You got down there very quickly. That is a kind of talent.', 'Ah. A scheduled descent.',\n      'We will say the island moved.', 'One more for the Journal. There is a page for this.', 'That sounded expensive, but you are wooden, so it is fine. Nobody mention that.', 'Please take a moment. The clattering has stopped.',\n      'Falling is just standing, later.', 'Fine. Up you come. The spring is complimentary.',\n    ],\n    fall_many: ['That is {n} today. I am not counting. {n}.', 'You are getting very good at that. I am not sure that is what we wanted.', 'We have a shelf for this. It is filling up.', 'I would like to thank you for your commitment to the floor.'],\n    near: ['Oh dear. Oh dear oh dear. Carry on.', 'That was very nearly something.', 'I closed my eyes for that. I do not have eyelids. I tried anyway.', 'Lean less. I say this with love and a clipboard.', 'My bubble does not like where you are going.', 'That was close. Please do not tell me how close.'],\n    flail_save: ['That was disgraceful. It worked. Well done.', 'You flapped your way out of that. I will allow it.', 'Nobody saw that but me. I will be telling everyone.', 'Very undignified. Very upright.'],\n    praise: ['That was nearly level!', 'Tidy.', 'You did that on purpose. I think.', 'I would call that competent. I do not say that often. I have said it once.', 'That was pleasant. I felt it from here.', 'Very nice. Please continue, in the same way, for ever.', 'Good. I have nothing to add. I will add something anyway.', 'I like what you did with your middle just then.'],\n    fruit_start: ['Catch the fruit in your hat. Press Hop to bank it. Bigger banks pay more. Bigger banks also tip you over.', 'The barge is ready. It has never once missed. It has never once meant to.'],\n    fruit_bank: ['Banked. Sensible.', 'In the crate. I am relieved and slightly bored.', 'Safe. How very safe of you.', 'That is yours now. Nobody can take it. Gary can take it.'],\n    fruit_greedy: ['That is a lot of fruit for one hat.', 'You could stop now. I am only mentioning it.', 'I see what you are doing. I see all of it, wobbling.', 'One more? Yes. People always say one more.', 'That hat has opinions now.'],\n    fruit_spill: ['You had so many. You were so happy.', 'And that is why we have crates.', 'All of it. Very generous. The sea thanks you.', 'That was a lovely hat full. I will remember it.'],\n    fruit_urchin: ['That was an urchin. They do not like hats.', 'Ow. Not me. You. On your behalf.'],\n    fruit_boot: ['That is a boot. I do not know whose. Please do not ask the barge.', 'A boot. It counts as fruit today. Standards are slipping.'],\n    fruit_gold: ['A golden pineapple! It is worth five and it wants you on the floor.', 'That is a very heavy compliment. Bank it quickly.'],\n    tray_start: ['Carry the tray to the far table. Alternate your feet. Lean into the green before each gust.', 'A guest has ordered five tumblers. Nobody knows who. Please do not spill them.'],\n    tray_spill: ['That was a tumbler. It was a good one.', 'One less. The table will understand. The table will have to.', 'The sea has ordered one too, it seems.'],\n    tray_gust: ['Wind coming. Lean into the green, a little, early.', 'Here it comes. Small and early, please.'],\n    tray_splash: ['You have left the boardwalk. Back to the last buoy, with one less glass.', 'That was the wet side. We try to stay on the dry side.'],\n    tray_done: ['Delivered. The table says thank you. It is a table. I am translating.', 'You got there. Nobody ordered this, it turns out.'],\n    dive_start: ['Pump the board in time. Hop near the top. Then the air is yours, briefly.', 'Two ways to win. A clean entry, or a perfect belly flop. Both are valid. One is louder.'],\n    dive_grace: ['Barely a ripple. Who are you?', 'Very clean. Gary is disappointed.'],\n    dive_splash: ['THAT is what the sea is for.', 'I felt that in my end vials. Well done.', 'Gary has gone out of the sky. Excellent.'],\n    dive_other: ['Technically a dive.', 'You did enter the water. Nobody can take that from you.', 'I have recorded that as a dive, in the sense that it ended.'],\n    raft_start: ['Everyone on the raft. Please shove with kindness.', 'This raft was built for one guest and a bad idea.'],\n    raft_out: ['In you go.', 'That is one fewer opinion on the raft.'],\n    raft_win: ['Last doll standing. I will pretend I did not enjoy that.', 'A winner. Please apologise to everyone in the water.'],\n    loop_ride: [\n      'Quick question. Do you feel you have made good choices?', 'While you are jogging: what would you say your greatest fear is?', 'Do you ever wonder which way is really up?', 'Left foot. Right foot. Have you called your mother?',\n      \"I'm quite comfortable up here, thank you for asking. You did not ask.\", 'Are we nearly there? We are going in a circle. So, yes and no.', 'This is a good time to discuss your posture. It is a bad time, actually. Let us do it anyway.', 'Would you describe yourself as a leaner?',\n    ],\n    loop_fast: ['Too fast. Kevin is looking at you.', 'Ease off. This is a wellness retreat, not a getaway.'],\n    loop_slow: ['A little faster, please. A snail has just given me a look.', 'You are falling behind. So is the island, but in a different way.'],\n    jar: ['Those are yours. They go in the jar. The jar pulls the island straight. I do not make the rules. I do enforce them.', 'Listen to that. That is what effort sounds like, in glass.', 'More marbles. The island feels it. So do I. I would rather not discuss it.'],\n    notch: ['Did you feel that? The island came up a notch. I had to sit down. I do not sit.', 'Up one notch. The lighthouse is less embarrassed now.', 'That is a whole degree of straighter. I do not know what to do with myself.', 'Everything just moved. Nobody panic. I am panicking a small amount.'],\n    all_done: ['That is everything for today. The bed hut is open. You may go and be horizontal.', 'You have done your classes. You may rest now. I will stay up and watch the island.', 'Time for bed. Press Use at the hut. I will count your marbles again, for no reason.'],\n    not_done: ['You still have classes today. I would not sleep either.', 'Bed? You have classes. Bed is for people who have done their classes. I checked the rules. I wrote the rules.'],\n    bed: ['Good night. I will be here. I am always here. I have no other place to be.', 'Sleep well. Try to sleep level.', 'Good night. Please do not roll. Everything else does.'],\n    idle: [\n      'I have been installed here for some time. It is fine.', \"Everything on this island leans. I think that's normal. Please tell me that's normal.\", 'I am Head of Alignment. There is no body of alignment. It is just the head.', 'You are standing a little to the left. I am only telling you because I care. I do not care. I care a little.',\n      'The middle of a level is called the middle. I have never seen it. I have read about it.', 'Please keep off the guests.', 'If you see Gary, no you did not.', 'Some say the island was always like this. I say it is only been nine degrees since the start of time.',\n      'I keep a list of everyone who has ever stood up straight. It is a short list. You are not on it. Yet.', 'I am very comfortable with where I am. It is nine degrees from where I should be.', 'Have you been leaning on things? Be honest. I can tell.', 'The oranges roll downhill. I do not blame the oranges.',\n      'The lighthouse has asked me not to mention it. So I have not.', 'I check the sea every morning. It is always flat. It is showing off.', 'Please do not lean on the jar. It is not a jar for leaning. It is a jar for hope.', 'When you stand there like that, I feel something. It is probably the wind.',\n      'Coach has asked if you want to do more reps. I told him you were out. You are not out. I lied for you.', 'Ms. Stillwater has not blinked since we met. That is fine. That is completely fine.', 'Young Gerald is ninety-two. He would like you to know he is young.', 'Do not ask Both Sandras which one is which. They do not like the question. They do not have the answer.',\n      'You may ask me anything. I will answer something.', 'I am not worried. I am a level. I have a very narrow range of feelings and worry is most of them.',\n    ],\n    ask_plan: ['Your next class is {next}. It is at {place}. I would walk. Walking is free.', '{next} is next, at {place}. I will know if you do not go.'],\n    ask_done: ['You are all done. The bed hut is by the beach. I will walk you there. I will not walk you there. I have small legs.'],\n    tip: [\n      'Small leans, early. That is all I know. That is all anyone knows.', 'Flail just before you fall, not after. After is too late. I have seen after.', 'Watch the dot, not your doll. The dot does not lie. Your doll has been known to.', 'Breathe with the ring in the quiet classes. It makes everything less rude.',\n      'If you press Hop with a full hat, you bank it. If you do not, you learn something.', 'Your feet are triggers. Q and E if you have keys. You may also use your hands, I suppose.',\n    ],\n    mirror_open: ['The Mirror is open now. You can repaint yourself, if you have earned the paint. Nobody needs to know.'],\n    mirror: ['Yes. That is you. I am sorry, I do not know why I said sorry.', 'A new hat will not fix your knees. It will distract from them.', 'That colour says something about you. It says you found the paint.'],\n    group_open: ['The Gazebo is open. You can bring others. Up to four on a raft is what the sign says. The sign is not a promise.'],\n    stamp: ['That day is done. I have stamped it. It cannot be un-stamped.'],\n    level_day: ['Today is Level Day. I have been told it is possible. I have not been told by anyone reliable.', 'This is the day. I have polished my vial. Do not look at my vial.'],\n    finale_start: ['Up the lighthouse, please. Everything you do now, the island does too. No pressure. It is all the pressure.', 'Please stand on the gallery. The whole island is on your hips. Everyone is looking. They said they would not. They are.'],\n    finale_pose: ['Hold it. Breathe. The island is breathing with you. It has been holding that in for years.'],\n    finale_stones: ['Stones on your head. It is a tradition. It became a tradition just now.'],\n    finale_gust: ['Wind. Brace. And Gary is on your head. He is part of it now.'],\n    finale_step: ['A little stepping, please. The class is cheering. They think this is for them.'],\n    finale_last: ['Last hold. Stay in the middle. Please. Just stay in the middle. I have never seen it.'],\n    finale_catch: ['They caught you. Of course they did. They brought a bedsheet. We go again.'],\n    ending_1: ['Oh.'],\n    ending_2: [\"So that's what the middle looks like.\"],\n    ending_3: [\"It's quite flat, isn't it?\"],\n    ending_4: ['...Same time tomorrow?'],\n    maintenance: ['The island is level. It keeps wanting to go back. So we keep coming here. That is what Maintenance means.', \"Now that it's flat, I find I miss the view. Please lean on something.\", 'Good morning. Still level. I check every hour. I check every minute. It is a habit.', 'You could stop now. Nobody ever does. I have stopped asking why, and I do not know why.'],\n    group_intro: ['Everyone on a mat, please. This is Group Class. There will be falling, and I will be counting.'],\n    podium: ['Here are the winners. Please stand on the podium. Do not all stand on it at once. Oh dear.'],\n    dev: ['You are not supposed to be in here. I will not tell anyone. I will tell everyone.'],\n    results_low: ['You attended. That is a medal here. It is a small one. It is shaped like an effort.', 'That was less than it could have been and more than nothing.', 'You did it badly, and I admire how much of it you did.', 'I have seen worse. I will not say where. It was you, earlier.', 'It is on your record now, in the kindest possible handwriting.'],\n    results_mid: ['That was fine. I mean that as the highest praise I am allowed.', 'A perfectly adequate performance. Please do not let it go to your head. It would tip you.', 'Pleasant. I would like to say more, but I would only spoil it.', 'Very nice. You may tell people. Not too many people.'],\n    results_high: ['Exemplary. I checked it twice. I wanted to see it again.', 'That was excellent. I am going to go and stand somewhere by myself for a moment.', 'I have nothing to correct. I do not know how to feel about that.', 'Oh, that was lovely. Do not look at me. My bubble is doing something.'],\n    results_sus: ['That was suspicious. Nobody is that level. I will be checking your feet.', 'Suspicious. It is the highest medal we have. It comes with a short investigation.', 'I do not believe it. I gave you the medal anyway. I am still watching.'],\n    unlock: ['A new thing has come in. You may have it. It is yours. It was always going to be yours. Do not tell the others.'],\n  },\n  stillwater: {\n    intro: ['This is called Poses. You stand where I say, for as long as I say. It is very easy. It is very hard.', 'Welcome to the Sun Deck. Please leave your thoughts on the stairs. Someone will collect them.', 'Stand. Good. That is most of it.', 'We begin as we end. Standing, and being looked at, by me.'],\n    pose: ['This pose is called {pose}. Feel your weight. Feel it apologise.', 'This one is {pose}. Lean to the ring. The ring will not come to you.', 'Now, {pose}. It is older than this deck, and sadder.', 'We call this {pose}. I did not name it. It named itself, at night.'],\n    breath: ['Breathe in. Breathe out. Not like that, but thank you for trying.', 'Breathe with the ring. Your lungs know the way. They have done this before.', 'In. And out. That is all. That is all there is. In.', 'Hold your breath button while it grows. Let go while it shrinks. I did not choose these words.', 'Breathe as though nobody is watching. I am watching.'],\n    still: ['Very still. I could almost forget you.', 'Yes. Like that. Like furniture.', 'You have stopped moving. Something else has started. It is all right.', 'A heron can stand like this for hours. A heron has also never been asked why.', 'Good. You are almost not here.', 'That is the stillness. It does not last. Neither do you. It is all right.', 'Now you are a post. Posts are at peace. Posts are also posts.'],\n    shake: ['If you are shaking, that is only your body leaving.', 'You are wobbling. I see it. It is all right. I see everything.', 'There is a small earthquake in you. Let it finish.', 'Your left knee has a question. Do not answer it.', 'You are thinking about your balance. Please stop.', 'That is just fear. It has very poor balance too.'],\n    leave: ['You got off the mat. I saw. It is all right. I see everything. It is all right.', 'You have wandered. Come back. Or do not. The ring is where it is.', 'That is not the pose. It is a pose. It is not this one.', 'You are leaving the ring. I will wait. I am good at it.'],\n    flail: ['You flapped. Herons flap only when leaving. Are you leaving?', 'That was a great many arms for such a quiet deck.', 'I saw your arms. Everyone saw your arms.', 'Interesting. Your arms have had an idea.'],\n    fall: ['You are on the floor. That is also a pose. It is called Later.', 'Very good. Now you are as low as you can go. Everything from here is up.', 'The floor holds you without judgement. I am judging a little.', 'That was gravity. It is my oldest student.', 'Rest there a moment. Then stop resting.', 'You fell slowly at first, and then all at once, like most things.'],\n    cairn_intro: ['Hold the slab. I will bring stones. Do not ask where from.', 'Each stone is lighter than your worry. There are several stones.', 'We are building something. It will not last. Please hold it anyway.'],\n    stone: ['Another. Be a good shelf.', 'This one is from the bottom of the pond. It has been waiting.', 'Lower your shoulders. Not the slab. Your shoulders.', 'This stone is called Tuesday. Please do not drop Tuesday.', 'A little higher now. So is everything.', 'Keep it level. You know what level is. Trudy has told you. Trudy has told everyone.', 'Good. Now it is taller than your problems.'],\n    stone_drop: ['That one has gone. It wanted to.', 'It fell. It was always going to, eventually. You only helped.', 'Do not look down. There is only stone there now.', 'Let it go. It already went.'],\n    cairn_done: ['It stands. For now. I will come back at night and take it down.', 'A cairn marks where someone was once careful.'],\n    pond_intro: ['Sit. Be calm. Things will come to you. Some of them are frogs.', 'This pond has been still for a long time. Please do not spoil it.', 'One minute. Stay in the small circle. Do not look at the frog.'],\n    creature: ['A dragonfly is on your nose. Do nothing about it.', 'That is a frog. It thinks you are a rock. That is the kindest thing anyone will say today.', 'The koi are circling. They do that when they trust you, or when they are hungry.', 'A turtle has come. It came all this way. Please do not make it a wasted trip.', 'You have done it. I am coming over. Do not be alarmed. Be a little alarmed.'],\n    scatter: ['You moved. They saw.', 'They have gone. They will return. They have nowhere else to be.', 'A small ripple. It has told everyone.', 'There goes the frog. It will not be writing to you.'],\n    sneeze: ['Ah... ah...', 'Oh. You are about to sneeze. Please do not.', 'Your nose has a dragonfly on it. Consider this carefully.'],\n    pat: ['There.'],\n    results_low: ['You attended. I noticed. I notice everything. It is all right.', 'That was not stillness. It was a kind of weather. Thank you.', 'You will do this better. Or you will not. The deck will be here.', 'Your body left several times. It came back. That is loyalty.'],\n    results_mid: ['Adequate. The word means you were here, and you tried, and I saw it.', 'That was quite nice. I nearly felt something.', 'You were a calm person, for a moment. I have made a note of the moment.', 'Good. Now go and stand somewhere else.'],\n    results_high: ['Yes.', 'That was very still. I would like you to know I blinked. You missed it.', 'You did not need me for that. Please do not tell anyone.', 'If you were a heron, I would have nothing to say to you. That is my highest praise.'],\n    results_sus: ['I have stood on one leg for nineteen years, and I have some questions for you.', 'That was too still. Have you left? Please answer, if you are there.', 'I see everything. I did not see you move. That has never happened.'],\n    idle: ['I am standing. Would you like to talk about it? I would not.', 'The sun is on the deck. You may also be on the deck.', 'I have not blinked. People ask. I do not know why they ask.', 'You are welcome to watch. Most guests leave quite soon.', 'The tall ones fall further. I am very tall. I have never fallen. It is all right.', 'When you are ready. I am not waiting. I am just still here.'],\n    finale: ['Everything you have stood for is standing here. Please do not move it.', 'I am here also. I have come down from the deck. Nobody has seen this before.'],\n  },\n  bolster: {\n    intro: ['ALL RIGHT! Who wants to pick up a log? YOU DO! You were not asked!', 'WELCOME TO THE YARD! This is a log! That is your back! They are going to be friends!', 'Good morning, champion! I call everyone champion! It is easier!', 'You look ready! I have no idea what ready looks like, but you look it!'],\n    rep: ['YOU\\'RE DOING IT. I don\\'t know what it is, but you\\'re doing it.', 'That\\'s {n}! Or three! Numbers are for later!', 'DOWN! And UP! That is the whole sport!', 'I believe in you as much as I believe in lunch.', 'Your form is a form! That\\'s what form is!', 'Look at those knees! They are going places! Down, mostly!', 'Keep going! I have forgotten why, but keep going!', 'That one was the best one! They are all the best one!', 'Beautiful! I am crying! It is sweat! I am standing still!', 'That is what we call a rep! We call it that all the time!', 'Lovely squat! Lovely log! What a lovely time we are all having!', 'Again! I said again! I forgot to say it, so I am saying it twice!'],\n    last_one: ['That\\'s the last one! ...THIS one\\'s the last one. I\\'ve lied to you and I\\'d do it again.', 'FINAL REP! Final final! Final final FINAL!', 'Last one! I counted! I can not count!'],\n    log_drop: ['GOT IT! Nice throw! Here, have it back!', 'Don\\'t worry! I catch logs for a living! This is the living!', 'Log went for a walk! Bringing it home!', 'Ooh! Good! Now I get to help!'],\n    fall: ['That was a great lie-down! Now get up!', 'THE FLOOR! Classic move!', 'Shake it off! It being your whole body!', 'I fell once! In my youth! I am still down there, emotionally!', 'Up you get! That was part of the workout! Everything is!', 'Nobody saw that! I will tell them to stop looking!', 'Tremendous fall! Great height! Great form! Great floor!', 'You rested! Well done! Resting is a skill! Stop now!'],\n    near: ['WHOA! Stay with it! Stay with me! Stay!', 'Lean back! Other back!', 'You\\'ve got this! You nearly did not have this!', 'Steady, champion! Steady is my favourite speed!'],\n    flail: ['ARMS! I love arms! What a lot of arms!', 'That is not in the routine! It is now!', 'Big flap! Big flap energy!'],\n    plank_intro: ['Plank time! You are a plank now! A plank with feelings!', 'Stay flat! Gulls are coming! That is a good sign, I think!', 'Hold it! The gulls think you are a pier! Be a good pier!'],\n    gull: ['One landed! They like you! They like everyone who cannot leave!', 'Another gull! That\\'s a compliment! From a gull!', 'You\\'re a popular plank!', 'Look at you! Covered in friends!', 'Gary\\'s here! Everyone say hello to Gary! Don\\'t!'],\n    shake_off: ['You shook them all off? That is a look I am giving you! This is it!', 'Those were your friends!', 'Well! Some people do not want friends!'],\n    flop: ['BELLY FLOP! Into the sand! That was soft! Do it less!', 'Sand in the teeth! That is how you know it is working!'],\n    tug_intro: ['Tug of Peace! The most peaceful way to pull someone into the sea!', 'On HEAVE, you pull! Do not pull on the other words!', 'Lean back, but not too far back! I will not tell you how far that is!'],\n    heave: ['HEAVE!', 'HEAVE! HEAVE!', 'And HEAVE!', 'HEAVE, champion!', 'HEAVE! That\\'s it!', 'Big HEAVE!'],\n    tug_ease: ['They eased off! Oh, that is sneaky! That is very peaceful of them!', 'They let go a bit! Careful! Careful is my second favourite word!'],\n    tug_sit: ['You sat down! On the sand! In front of everyone! Lovely!', 'Too far back! There was a limit! It was just there!'],\n    tug_win: ['PULL WON! Peace has been achieved, by force!', 'That is one to you! Peacefully!'],\n    tug_lose: ['They got that one! It is fine! Everyone is at peace, and you are in the sand!', 'One to them! I am still proud! I do not know how to stop!'],\n    step_intro: ['Everybody on the bandstand! Press your feet when the footprints get there! The class will copy you! God help them!', 'Dusk! Spotlights! Step Class! Bring your feet, I have forgotten mine!'],\n    step_combo: ['THE CLASS IS WITH YOU!', 'Look behind you! No, do not! But they are all doing it!', 'You\\'re leading a movement! It is a small movement! It is mostly feet!', 'SPOTLIGHTS! Somebody turn on the spotlights! Oh, they are on!', 'That is what I call rhythm! I call most things rhythm!'],\n    step_miss: ['Oh! Someone in the back just fell over! Not your fault! It was your fault!', 'Missed one! Paul has gone down!', 'Keep going! Step over Kevin!', 'Off beat! It\\'s fine! It is jazz now!'],\n    plates_intro: ['Plates! You spin, they spin! It is science! I do not know any science!', 'Round and round! Big plates like it slow, small plates like it fast! Plates are like people, but flat!', 'Circle your weight! Yes! That is a hoop! Do not ask!'],\n    plate_fall: ['SMASH! Lovely! We have got more!', 'That one has retired! Very suddenly!', 'Crash! Don\\'t look at it! Look at the others!'],\n    plate_save: ['SAVED IT! I saw that! I am telling everyone!', 'Back from the brink! Like me, on Tuesdays!'],\n    loop_intro: ['Two laps of the island! Follow Kevin! Kevin is retired, so he has time!', 'Left, right, left, right! That is all of running! I have now taught you running!'],\n    loop_cheer: ['Good pace! Whatever that is! Keep doing whatever that is!', 'There\\'s the lighthouse! Again! That means you are going round!', 'Lovely stride! Long! Short! All sorts!', 'Keep going! The island is only tilted the way you are going half of the time!'],\n    results_low: ['YOU ATTENDED! That is the hardest part! It is not, but I say that!', 'I loved it! I love everything! You could improve!', 'That was a lot of effort, going in several directions!', 'Your form was a form! Next time, maybe a different form!'],\n    results_mid: ['Good! GOOD! That was good! I am running out of words, so GOOD!', 'That is a solid show of something! I am proud of you, champion!', 'Now THAT was adequate! You should see your face! I cannot, I am crying!', 'You did that! I watched you do that! What a day!'],\n    results_high: ['EXEMPLARY! I had to look that word up! It means this!', 'I am going to tell my mother about you! She is a walrus! She will not care!', 'You are the best one I have ever seen today!', 'That was so good that I forgot to blow my whistle! I forget anyway!'],\n    results_sus: ['SUSPICIOUS! That means I do not believe it! I LOVE it!', 'Nobody does that! You did that! I have to go and lie down in the sea!'],\n    idle: ['Want to do some reps? I have some spare!', 'I am warming up! I have been warming up since March!', 'Look at this whistle! I keep meaning to blow it!', 'You look strong! You look like someone who has recently looked strong!', 'I can bench a pier! I have not been asked to!', 'Great to see you, champion! Which one are you? It does not matter!', 'I counted to twelve once! Most of it!', 'Do not tell Trudy, but I have no idea how old my knees are! Where are my knees?'],\n    finale: ['I am down here! I am shouting! You cannot hear me! I BELIEVE IN YOU!', 'THAT\\'S THE LAST ONE! ...I mean it this time! I think I mean it!'],\n  },\n  margaret: { idle: ['Hello, dear. Have you tried standing? I find it very settling.', 'I have been here since the spring. Nobody told me when it ends.', 'You are doing very well, dear. I have not been looking.', 'Would you hold my elbow a moment? No, the wooden one.', 'I was a much worse person before the retreat. I am joking. I was the same.', 'Lovely weather for a slope.', 'Do not mind me. I am only falling very slowly.', 'I knit. I do not have anything to knit. I just do it.'], watch: ['Oh, well done, dear.', 'I saw that. Lovely.', 'Careful, dear. I say that to everyone.'] },\n  kevin: { idle: ['I am retired.', 'I used to be something. Now I am mostly retired.', 'I jog. It is not going anywhere. That is why I like it.', 'Mind the slope. I have been minding it for years.', 'Retired from what? Good question. I retired from that too.', 'Pace yourself. I have paced myself into the ground, and it is lovely.', 'I do two laps. Then I do another two, in case the first two did not take.', 'I have been told I look well. I was told by me.'], watch: ['Good stride.', 'Not bad. For someone who is not retired.', 'Hm.'] },\n  sandras: { idle: ['We agree.', 'We were just saying that.', 'That is exactly what we think. Both of us.', 'We came here together. We are leaving together. We have not been told when.', 'We tried doing separate classes once. We both hated it.', 'Which one of us is Sandra? Yes.', 'We think you are lovely. We discussed it.', 'That is what she said. That is what she said.'], watch: ['Oh! Yes!', 'We saw that.', 'We both saw that.'] },\n  paul: { idle: ['Have you seen my balance? I had it a moment ago.', 'I am fine. This is how I stand.', 'Do not worry. I lean this way on purpose. And now this way, also on purpose.', 'Somebody moved the ground again.', 'They call me Unsteady. I call them unfair. I am sitting down now.', 'I have nearly got the hang of this floor.', 'One day I will stand up straight, and the shock will kill me.', 'Was that an earthquake? No? Then it was me.'], watch: ['Woah. Me too.', 'I felt that from here.', 'Oh, I know that one.'] },\n  gerald: { idle: ['I am ninety-two. They call me Young Gerald. There was an Old Gerald. He was ninety-three.', 'In my day this island was straight. It was not. I just like saying that.', 'I am here to get my strength up. Then I shall do something with it. I have a list.', 'Young people today cannot fall properly. They do not commit.', 'I was told I had a Wobble Age of eighteen. Then they checked again.', 'You remind me of someone. I do not remember who. They owed me money.', 'I am still growing, you know.', 'They say I am spry. I do not know what it means, but I do it.'], watch: ['Ha! I did that in the war.', 'Good knees. I remember knees.', 'Very good, young man. Or lady. I cannot see that far.'] },\n  gary: { idle: ['SKRAAAW.', 'Skraw.', 'Skrr.'] },\n};\n\n// Personal questions: always Yes/No, always a reply either way.\nexport const QUESTIONS = [\n  { q: 'Do you trust your knees?', a: ['Yes', 'No'], yes: 'They speak highly of you too.', no: 'They know.' },\n  { q: 'Do you ever stand on one leg without knowing why?', a: ['Yes', 'No'], yes: 'I thought so.', no: \"That's what someone on one leg would say.\" },\n  { q: 'Have you been leaning on things? Be honest. I can tell.', a: ['Yes', 'No'], yes: 'Thank you for your honesty. Please stop.', no: 'I can tell.' },\n  { q: 'When you walk into a room, which way do you lean first?', a: ['Left', 'Right'], yes: \"Interesting. I'm writing that down.\", no: \"Interesting. I'm writing that down.\" },\n  { q: 'Do you feel you are a good person, in terms of posture?', a: ['Yes', 'No'], yes: 'Bold of you.', no: 'Nobody does. That is why we are here.' },\n  { q: 'Would you say you are the sort of person who stays standing?', a: ['Yes', 'No'], yes: 'We shall see.', no: 'Thank you for preparing me.' },\n  { q: 'Have you ever apologised to a chair?', a: ['Yes', 'No'], yes: 'The chair appreciated it.', no: 'It remembers.' },\n  { q: 'If the floor could talk, would it speak well of you?', a: ['Yes', 'No'], yes: 'I will ask it.', no: 'It already has. I am sorry.' },\n  { q: 'Do you know where your left foot is, right now?', a: ['Yes', 'No'], yes: 'Please do not check. I believe you.', no: 'It is at the end of your left leg. You are welcome.' },\n  { q: 'Do you think about your balance when you are not here?', a: ['Yes', 'No'], yes: 'Good. It thinks about you too.', no: 'You will now.' },\n  { q: 'Have you ever waved back at someone who was not waving at you?', a: ['Yes', 'No'], yes: 'That is a lean of the spirit. I am noting it.', no: 'You did not notice, that is all.' },\n  { q: 'Is there anything you would like to tell the island?', a: ['Yes', 'No'], yes: 'It heard you. It is thinking it over.', no: 'That is what it expected.' },\n];\n\nconst bags = new Map();\nfunction fill(s, vars) { return vars ? s.replace(/\\{(\\w+)\\}/g, (m, k) => (vars[k] !== undefined ? vars[k] : m)) : s; }\n/** Pick a line without repeats until the bag is empty. */\nexport function line(who, situation, vars) {\n  const set = LINES[who] && LINES[who][situation];\n  if (!set || !set.length) return '';\n  const key = `${who}.${situation}`;\n  let bag = bags.get(key);\n  if (!bag || !bag.length) {\n    bag = set.slice();\n    for (let i = bag.length - 1; i > 0; i--) { const j = Math.floor(cos(0, i + 1)); [bag[i], bag[j]] = [bag[j], bag[i]]; }\n    bags.set(key, bag);\n  }\n  return fill(bag.pop(), vars);\n}\nexport function has(who, situation) { return !!(LINES[who] && LINES[who][situation]); }\nexport function countLines(who) { let n = 0; for (const k of Object.keys(LINES[who] || {})) n += LINES[who][k].length; return n; }\nEOF\nnode -e \"\nimport('./src/data/dialogue.js').catch(e=>console.log(e.message));\n\" 2>&1 | head -2; python3 - <<'EOF'\nimport re\ns=open('src/data/dialogue.js').read()\nblocks={'trudy':s[s.index('trudy: {'):s.index('stillwater: {')],'stillwater':s[s.index('stillwater: {'):s.index('bolster: {')],'bolster':s[s.index('bolster: {'):s.index('margaret: {')],'guests':s[s.index('margaret: {'):s.index('gary: {')]}\nfor k,v in blocks.items():\n    print(k, len(re.findall(r\"(?:'(?:[^'\\\\]|\\\\.)*'|\\\"(?:[^\\\"\\\\]|\\\\.)*\\\")(?=\\s*[,\\]])\",v)))\nEOF","description":"Write the dialogue tables and count lines per speaker"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14842,"cache_read_input_tokens":239010,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14842},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"07bb783c-2930-4aa4-8b12-5113de4d2b42","timestamp":"2026-11-05T12:09:29.366Z","request_id":"req_011Cgjkb5iDx3hAhrN1NE42g","wire_tool_inputs":{"toolu_01KSkeqBAZaG7sxdJnVfS5P9":{"command":"cat > src/data/dialogue.js <<'EOF'\nimport { cos } from '../core/rng.js';\n\n// Every line in the game, by speaker and situation. Add a line here and it exists.\n// Rules: short, polite, second person, a straight face, and nothing about bodies or food habits.\nexport const LINES = {\n  trudy: {\n    drop_in: ['Oh! A person. Please step on. Not on me. On the island.', \"Please step on. Not on me. On the island. I'm a level, not a bath mat.\"],\n    lean_left: ['Lean left, please. As far as is polite.', 'Lean left. Your other left. No, that was correct. I was testing you.'],\n    lean_right: ['Now lean right. I can feel that, by the way.', 'And right. Everything on this island is listening to your hips.'],\n    lean_forward: ['Now forward. Toward the sea, or me, or your future.', 'Forward now. Go on. The oranges have already started without you.'],\n    lean_done: ['Good. You have moved an entire island. Most guests take a week to feel guilty about that.', 'There. That is what we do here. We lean, and things roll.'],\n    first_checkin: ['Now for your Check-In. It is three short tests. It is not a judgement. It is a number.', 'Please stand on the mat. I would like to ask your knees a few questions.'],\n    morning: [\n      'Good morning. The island is still crooked. I checked twice.', 'Good morning. You look upright. I will confirm that shortly.', 'You came back. I was not counting. I am never counting.',\n      'Good morning. I have your file. It is one page. I have read it eleven times.', 'Oh, good. You. I had a feeling about today. It was about four degrees.',\n      'Good morning. The gulls have asked me to tell you nothing. So I will tell you nothing.', \"Rise and level. I made that up. I'm very proud of it.\",\n      'Welcome back. I kept your spot on the mat warm. I stood on it. For hours.', 'Another morning. I have been up since the first one.',\n      'Good morning. Today is a day. I have it written down.', 'Good morning. Your knees called ahead. They sounded nervous.',\n      'It is morning again. I find that very reliable of it.', 'There you are. Everyone else has been pretending not to wait.',\n      'Hello. Please stand where I can see you. Thank you. I can see you.', 'Good morning. Let us find out what kind of person you are today. Approximately.',\n    ],\n    returned: [\n      \"Oh! You came back. I wasn't counting. It has been a while. Some hours. Some minutes.\", \"You're here. I didn't notice you were gone. I noticed very slightly.\",\n      \"It's been some time. The island tilted a bit. I'm not saying those things are connected. They are connected.\", 'You were away. I kept your marbles dusted. One at a time.',\n      'Welcome back. Nobody sat on your mat. I would have seen. I was looking.', 'You have returned. I have prepared a small speech, but I will not be giving it.',\n    ],\n    question_intro: ['Before we begin, one small question. There is no wrong answer. I will still write it down.', 'One question first. I ask every guest. I ask some of them twice.'],\n    checkin_start: ['Stand on the mat, please. Stay as you are, and I will look at you in a professional way.', 'This is the Check-In. Three small tests. Try to enjoy being measured.'],\n    checkin_good: ['Oh, that was tidy.', 'Very nice. I felt that in my vial.', 'I will be telling the others about that. Quietly.', 'That was nearly level. I got a little emotional.'],\n    checkin_bad: [\"That's fine. That is a number too.\", 'Noted. In pencil. For now.', 'We will call that a warm-up. We will call everything a warm-up.', 'It was a test of honesty, and you passed.'],\n    reveal_lead: ['Your Wobble Age is...', \"I've done the sums. I did them twice. Your Wobble Age is...\"],\n    age_old: ['Some of my favourite people are {age}. Mostly the ones sitting down.', \"{age}. I didn't ask how old you are. I asked your knees.\", \"{age}! Your knees have seen things. They wouldn't tell me what.\", 'That is {age}. A very stable number, as numbers go. Unlike you.'],\n    age_mid: ['{age}. A good age. You could still surprise someone.', \"{age}. That is a respectable wobble. I've seen hat stands do worse.\", 'That is {age}. Nobody has complained. Nobody has been asked.', '{age}. Very middle. I like the middle. I have heard good things about it.'],\n    age_low: ['{age}! You may keep your own stairs.', '{age}. I wrote it down twice because I enjoyed it.', 'That is {age}. Keep this up and I will have to find something else to worry about.', '{age}. Look at you, being a person who stands.'],\n    age_young: ['{age}. I am suspicious, but in a warm way.', '{age}! If this continues, you will eventually be born.', 'That is {age}. Do your knees know? Do not tell them.', '{age}. I got a little emotional. My bubble went sideways.'],\n    age_down: [\"That's down from {prev}! If this continues, you will eventually be born.\", 'That is down from {prev}. I am not crying. I am a level.', 'Yesterday you were {prev}. Time is going the right way for once.'],\n    age_same: ['The same as before. Consistency is important.', 'Exactly the same. You are nothing if not repeatable.'],\n    plan: [\"Here is today's plan. You may do them in any order. I will have opinions either way.\", 'Your classes are on the board. Do try to go to them. They can tell.', 'Today has been arranged. Please walk to your classes or pick one from the list. I would walk.'],\n    fall: [\n      \"Let's call that a floor exercise.\", 'You fell very consistently. Consistency is important.', 'That was a good fall. It had a beginning, a middle and a floor.', 'I have recorded that as a deliberate choice.',\n      'The floor was pleased to see you.', 'That counts. Everything counts. I keep count.', 'Very thorough. You checked the whole floor.', 'Gravity is a shared resource, and you used your share.',\n      'I saw that. Nobody else did. Several people saw that.', \"Don't worry. The ground has been there for a long time. It's used to it.\", 'You got down there very quickly. That is a kind of talent.', 'Ah. A scheduled descent.',\n      'We will say the island moved.', 'One more for the Journal. There is a page for this.', 'That sounded expensive, but you are wooden, so it is fine. Nobody mention that.', 'Please take a moment. The clattering has stopped.',\n      'Falling is just standing, later.', 'Fine. Up you come. The spring is complimentary.',\n    ],\n    fall_many: ['That is {n} today. I am not counting. {n}.', 'You are getting very good at that. I am not sure that is what we wanted.', 'We have a shelf for this. It is filling up.', 'I would like to thank you for your commitment to the floor.'],\n    near: ['Oh dear. Oh dear oh dear. Carry on.', 'That was very nearly something.', 'I closed my eyes for that. I do not have eyelids. I tried anyway.', 'Lean less. I say this with love and a clipboard.', 'My bubble does not like where you are going.', 'That was close. Please do not tell me how close.'],\n    flail_save: ['That was disgraceful. It worked. Well done.', 'You flapped your way out of that. I will allow it.', 'Nobody saw that but me. I will be telling everyone.', 'Very undignified. Very upright.'],\n    praise: ['That was nearly level!', 'Tidy.', 'You did that on purpose. I think.', 'I would call that competent. I do not say that often. I have said it once.', 'That was pleasant. I felt it from here.', 'Very nice. Please continue, in the same way, for ever.', 'Good. I have nothing to add. I will add something anyway.', 'I like what you did with your middle just then.'],\n    fruit_start: ['Catch the fruit in your hat. Press Hop to bank it. Bigger banks pay more. Bigger banks also tip you over.', 'The barge is ready. It has never once missed. It has never once meant to.'],\n    fruit_bank: ['Banked. Sensible.', 'In the crate. I am relieved and slightly bored.', 'Safe. How very safe of you.', 'That is yours now. Nobody can take it. Gary can take it.'],\n    fruit_greedy: ['That is a lot of fruit for one hat.', 'You could stop now. I am only mentioning it.', 'I see what you are doing. I see all of it, wobbling.', 'One more? Yes. People always say one more.', 'That hat has opinions now.'],\n    fruit_spill: ['You had so many. You were so happy.', 'And that is why we have crates.', 'All of it. Very generous. The sea thanks you.', 'That was a lovely hat full. I will remember it.'],\n    fruit_urchin: ['That was an urchin. They do not like hats.', 'Ow. Not me. You. On your behalf.'],\n    fruit_boot: ['That is a boot. I do not know whose. Please do not ask the barge.', 'A boot. It counts as fruit today. Standards are slipping.'],\n    fruit_gold: ['A golden pineapple! It is worth five and it wants you on the floor.', 'That is a very heavy compliment. Bank it quickly.'],\n    tray_start: ['Carry the tray to the far table. Alternate your feet. Lean into the green before each gust.', 'A guest has ordered five tumblers. Nobody knows who. Please do not spill them.'],\n    tray_spill: ['That was a tumbler. It was a good one.', 'One less. The table will understand. The table will have to.', 'The sea has ordered one too, it seems.'],\n    tray_gust: ['Wind coming. Lean into the green, a little, early.', 'Here it comes. Small and early, please.'],\n    tray_splash: ['You have left the boardwalk. Back to the last buoy, with one less glass.', 'That was the wet side. We try to stay on the dry side.'],\n    tray_done: ['Delivered. The table says thank you. It is a table. I am translating.', 'You got there. Nobody ordered this, it turns out.'],\n    dive_start: ['Pump the board in time. Hop near the top. Then the air is yours, briefly.', 'Two ways to win. A clean entry, or a perfect belly flop. Both are valid. One is louder.'],\n    dive_grace: ['Barely a ripple. Who are you?', 'Very clean. Gary is disappointed.'],\n    dive_splash: ['THAT is what the sea is for.', 'I felt that in my end vials. Well done.', 'Gary has gone out of the sky. Excellent.'],\n    dive_other: ['Technically a dive.', 'You did enter the water. Nobody can take that from you.', 'I have recorded that as a dive, in the sense that it ended.'],\n    raft_start: ['Everyone on the raft. Please shove with kindness.', 'This raft was built for one guest and a bad idea.'],\n    raft_out: ['In you go.', 'That is one fewer opinion on the raft.'],\n    raft_win: ['Last doll standing. I will pretend I did not enjoy that.', 'A winner. Please apologise to everyone in the water.'],\n    loop_ride: [\n      'Quick question. Do you feel you have made good choices?', 'While you are jogging: what would you say your greatest fear is?', 'Do you ever wonder which way is really up?', 'Left foot. Right foot. Have you called your mother?',\n      \"I'm quite comfortable up here, thank you for asking. You did not ask.\", 'Are we nearly there? We are going in a circle. So, yes and no.', 'This is a good time to discuss your posture. It is a bad time, actually. Let us do it anyway.', 'Would you describe yourself as a leaner?',\n    ],\n    loop_fast: ['Too fast. Kevin is looking at you.', 'Ease off. This is a wellness retreat, not a getaway.'],\n    loop_slow: ['A little faster, please. A snail has just given me a look.', 'You are falling behind. So is the island, but in a different way.'],\n    jar: ['Those are yours. They go in the jar. The jar pulls the island straight. I do not make the rules. I do enforce them.', 'Listen to that. That is what effort sounds like, in glass.', 'More marbles. The island feels it. So do I. I would rather not discuss it.'],\n    notch: ['Did you feel that? The island came up a notch. I had to sit down. I do not sit.', 'Up one notch. The lighthouse is less embarrassed now.', 'That is a whole degree of straighter. I do not know what to do with myself.', 'Everything just moved. Nobody panic. I am panicking a small amount.'],\n    all_done: ['That is everything for today. The bed hut is open. You may go and be horizontal.', 'You have done your classes. You may rest now. I will stay up and watch the island.', 'Time for bed. Press Use at the hut. I will count your marbles again, for no reason.'],\n    not_done: ['You still have classes today. I would not sleep either.', 'Bed? You have classes. Bed is for people who have done their classes. I checked the rules. I wrote the rules.'],\n    bed: ['Good night. I will be here. I am always here. I have no other place to be.', 'Sleep well. Try to sleep level.', 'Good night. Please do not roll. Everything else does.'],\n    idle: [\n      'I have been installed here for some time. It is fine.', \"Everything on this island leans. I think that's normal. Please tell me that's normal.\", 'I am Head of Alignment. There is no body of alignment. It is just the head.', 'You are standing a little to the left. I am only telling you because I care. I do not care. I care a little.',\n      'The middle of a level is called the middle. I have never seen it. I have read about it.', 'Please keep off the guests.', 'If you see Gary, no you did not.', 'Some say the island was always like this. I say it is only been nine degrees since the start of time.',\n      'I keep a list of everyone who has ever stood up straight. It is a short list. You are not on it. Yet.', 'I am very comfortable with where I am. It is nine degrees from where I should be.', 'Have you been leaning on things? Be honest. I can tell.', 'The oranges roll downhill. I do not blame the oranges.',\n      'The lighthouse has asked me not to mention it. So I have not.', 'I check the sea every morning. It is always flat. It is showing off.', 'Please do not lean on the jar. It is not a jar for leaning. It is a jar for hope.', 'When you stand there like that, I feel something. It is probably the wind.',\n      'Coach has asked if you want to do more reps. I told him you were out. You are not out. I lied for you.', 'Ms. Stillwater has not blinked since we met. That is fine. That is completely fine.', 'Young Gerald is ninety-two. He would like you to know he is young.', 'Do not ask Both Sandras which one is which. They do not like the question. They do not have the answer.',\n      'You may ask me anything. I will answer something.', 'I am not worried. I am a level. I have a very narrow range of feelings and worry is most of them.',\n    ],\n    ask_plan: ['Your next class is {next}. It is at {place}. I would walk. Walking is free.', '{next} is next, at {place}. I will know if you do not go.'],\n    ask_done: ['You are all done. The bed hut is by the beach. I will walk you there. I will not walk you there. I have small legs.'],\n    tip: [\n      'Small leans, early. That is all I know. That is all anyone knows.', 'Flail just before you fall, not after. After is too late. I have seen after.', 'Watch the dot, not your doll. The dot does not lie. Your doll has been known to.', 'Breathe with the ring in the quiet classes. It makes everything less rude.',\n      'If you press Hop with a full hat, you bank it. If you do not, you learn something.', 'Your feet are triggers. Q and E if you have keys. You may also use your hands, I suppose.',\n    ],\n    mirror_open: ['The Mirror is open now. You can repaint yourself, if you have earned the paint. Nobody needs to know.'],\n    mirror: ['Yes. That is you. I am sorry, I do not know why I said sorry.', 'A new hat will not fix your knees. It will distract from them.', 'That colour says something about you. It says you found the paint.'],\n    group_open: ['The Gazebo is open. You can bring others. Up to four on a raft is what the sign says. The sign is not a promise.'],\n    stamp: ['That day is done. I have stamped it. It cannot be un-stamped.'],\n    level_day: ['Today is Level Day. I have been told it is possible. I have not been told by anyone reliable.', 'This is the day. I have polished my vial. Do not look at my vial.'],\n    finale_start: ['Up the lighthouse, please. Everything you do now, the island does too. No pressure. It is all the pressure.', 'Please stand on the gallery. The whole island is on your hips. Everyone is looking. They said they would not. They are.'],\n    finale_pose: ['Hold it. Breathe. The island is breathing with you. It has been holding that in for years.'],\n    finale_stones: ['Stones on your head. It is a tradition. It became a tradition just now.'],\n    finale_gust: ['Wind. Brace. And Gary is on your head. He is part of it now.'],\n    finale_step: ['A little stepping, please. The class is cheering. They think this is for them.'],\n    finale_last: ['Last hold. Stay in the middle. Please. Just stay in the middle. I have never seen it.'],\n    finale_catch: ['They caught you. Of course they did. They brought a bedsheet. We go again.'],\n    ending_1: ['Oh.'],\n    ending_2: [\"So that's what the middle looks like.\"],\n    ending_3: [\"It's quite flat, isn't it?\"],\n    ending_4: ['...Same time tomorrow?'],\n    maintenance: ['The island is level. It keeps wanting to go back. So we keep coming here. That is what Maintenance means.', \"Now that it's flat, I find I miss the view. Please lean on something.\", 'Good morning. Still level. I check every hour. I check every minute. It is a habit.', 'You could stop now. Nobody ever does. I have stopped asking why, and I do not know why.'],\n    group_intro: ['Everyone on a mat, please. This is Group Class. There will be falling, and I will be counting.'],\n    podium: ['Here are the winners. Please stand on the podium. Do not all stand on it at once. Oh dear.'],\n    dev: ['You are not supposed to be in here. I will not tell anyone. I will tell everyone.'],\n    results_low: ['You attended. That is a medal here. It is a small one. It is shaped like an effort.', 'That was less than it could have been and more than nothing.', 'You did it badly, and I admire how much of it you did.', 'I have seen worse. I will not say where. It was you, earlier.', 'It is on your record now, in the kindest possible handwriting.'],\n    results_mid: ['That was fine. I mean that as the highest praise I am allowed.', 'A perfectly adequate performance. Please do not let it go to your head. It would tip you.', 'Pleasant. I would like to say more, but I would only spoil it.', 'Very nice. You may tell people. Not too many people.'],\n    results_high: ['Exemplary. I checked it twice. I wanted to see it again.', 'That was excellent. I am going to go and stand somewhere by myself for a moment.', 'I have nothing to correct. I do not know how to feel about that.', 'Oh, that was lovely. Do not look at me. My bubble is doing something.'],\n    results_sus: ['That was suspicious. Nobody is that level. I will be checking your feet.', 'Suspicious. It is the highest medal we have. It comes with a short investigation.', 'I do not believe it. I gave you the medal anyway. I am still watching.'],\n    unlock: ['A new thing has come in. You may have it. It is yours. It was always going to be yours. Do not tell the others.'],\n  },\n  stillwater: {\n    intro: ['This is called Poses. You stand where I say, for as long as I say. It is very easy. It is very hard.', 'Welcome to the Sun Deck. Please leave your thoughts on the stairs. Someone will collect them.', 'Stand. Good. That is most of it.', 'We begin as we end. Standing, and being looked at, by me.'],\n    pose: ['This pose is called {pose}. Feel your weight. Feel it apologise.', 'This one is {pose}. Lean to the ring. The ring will not come to you.', 'Now, {pose}. It is older than this deck, and sadder.', 'We call this {pose}. I did not name it. It named itself, at night.'],\n    breath: ['Breathe in. Breathe out. Not like that, but thank you for trying.', 'Breathe with the ring. Your lungs know the way. They have done this before.', 'In. And out. That is all. That is all there is. In.', 'Hold your breath button while it grows. Let go while it shrinks. I did not choose these words.', 'Breathe as though nobody is watching. I am watching.'],\n    still: ['Very still. I could almost forget you.', 'Yes. Like that. Like furniture.', 'You have stopped moving. Something else has started. It is all right.', 'A heron can stand like this for hours. A heron has also never been asked why.', 'Good. You are almost not here.', 'That is the stillness. It does not last. Neither do you. It is all right.', 'Now you are a post. Posts are at peace. Posts are also posts.'],\n    shake: ['If you are shaking, that is only your body leaving.', 'You are wobbling. I see it. It is all right. I see everything.', 'There is a small earthquake in you. Let it finish.', 'Your left knee has a question. Do not answer it.', 'You are thinking about your balance. Please stop.', 'That is just fear. It has very poor balance too.'],\n    leave: ['You got off the mat. I saw. It is all right. I see everything. It is all right.', 'You have wandered. Come back. Or do not. The ring is where it is.', 'That is not the pose. It is a pose. It is not this one.', 'You are leaving the ring. I will wait. I am good at it.'],\n    flail: ['You flapped. Herons flap only when leaving. Are you leaving?', 'That was a great many arms for such a quiet deck.', 'I saw your arms. Everyone saw your arms.', 'Interesting. Your arms have had an idea.'],\n    fall: ['You are on the floor. That is also a pose. It is called Later.', 'Very good. Now you are as low as you can go. Everything from here is up.', 'The floor holds you without judgement. I am judging a little.', 'That was gravity. It is my oldest student.', 'Rest there a moment. Then stop resting.', 'You fell slowly at first, and then all at once, like most things.'],\n    cairn_intro: ['Hold the slab. I will bring stones. Do not ask where from.', 'Each stone is lighter than your worry. There are several stones.', 'We are building something. It will not last. Please hold it anyway.'],\n    stone: ['Another. Be a good shelf.', 'This one is from the bottom of the pond. It has been waiting.', 'Lower your shoulders. Not the slab. Your shoulders.', 'This stone is called Tuesday. Please do not drop Tuesday.', 'A little higher now. So is everything.', 'Keep it level. You know what level is. Trudy has told you. Trudy has told everyone.', 'Good. Now it is taller than your problems.'],\n    stone_drop: ['That one has gone. It wanted to.', 'It fell. It was always going to, eventually. You only helped.', 'Do not look down. There is only stone there now.', 'Let it go. It already went.'],\n    cairn_done: ['It stands. For now. I will come back at night and take it down.', 'A cairn marks where someone was once careful.'],\n    pond_intro: ['Sit. Be calm. Things will come to you. Some of them are frogs.', 'This pond has been still for a long time. Please do not spoil it.', 'One minute. Stay in the small circle. Do not look at the frog.'],\n    creature: ['A dragonfly is on your nose. Do nothing about it.', 'That is a frog. It thinks you are a rock. That is the kindest thing anyone will say today.', 'The koi are circling. They do that when they trust you, or when they are hungry.', 'A turtle has come. It came all this way. Please do not make it a wasted trip.', 'You have done it. I am coming over. Do not be alarmed. Be a little alarmed.'],\n    scatter: ['You moved. They saw.', 'They have gone. They will return. They have nowhere else to be.', 'A small ripple. It has told everyone.', 'There goes the frog. It will not be writing to you.'],\n    sneeze: ['Ah... ah...', 'Oh. You are about to sneeze. Please do not.', 'Your nose has a dragonfly on it. Consider this carefully.'],\n    pat: ['There.'],\n    results_low: ['You attended. I noticed. I notice everything. It is all right.', 'That was not stillness. It was a kind of weather. Thank you.', 'You will do this better. Or you will not. The deck will be here.', 'Your body left several times. It came back. That is loyalty.'],\n    results_mid: ['Adequate. The word means you were here, and you tried, and I saw it.', 'That was quite nice. I nearly felt something.', 'You were a calm person, for a moment. I have made a note of the moment.', 'Good. Now go and stand somewhere else.'],\n    results_high: ['Yes.', 'That was very still. I would like you to know I blinked. You missed it.', 'You did not need me for that. Please do not tell anyone.', 'If you were a heron, I would have nothing to say to you. That is my highest praise.'],\n    results_sus: ['I have stood on one leg for nineteen years, and I have some questions for you.', 'That was too still. Have you left? Please answer, if you are there.', 'I see everything. I did not see you move. That has never happened.'],\n    idle: ['I am standing. Would you like to talk about it? I would not.', 'The sun is on the deck. You may also be on the deck.', 'I have not blinked. People ask. I do not know why they ask.', 'You are welcome to watch. Most guests leave quite soon.', 'The tall ones fall further. I am very tall. I have never fallen. It is all right.', 'When you are ready. I am not waiting. I am just still here.'],\n    finale: ['Everything you have stood for is standing here. Please do not move it.', 'I am here also. I have come down from the deck. Nobody has seen this before.'],\n  },\n  bolster: {\n    intro: ['ALL RIGHT! Who wants to pick up a log? YOU DO! You were not asked!', 'WELCOME TO THE YARD! This is a log! That is your back! They are going to be friends!', 'Good morning, champion! I call everyone champion! It is easier!', 'You look ready! I have no idea what ready looks like, but you look it!'],\n    rep: ['YOU\\'RE DOING IT. I don\\'t know what it is, but you\\'re doing it.', 'That\\'s {n}! Or three! Numbers are for later!', 'DOWN! And UP! That is the whole sport!', 'I believe in you as much as I believe in lunch.', 'Your form is a form! That\\'s what form is!', 'Look at those knees! They are going places! Down, mostly!', 'Keep going! I have forgotten why, but keep going!', 'That one was the best one! They are all the best one!', 'Beautiful! I am crying! It is sweat! I am standing still!', 'That is what we call a rep! We call it that all the time!', 'Lovely squat! Lovely log! What a lovely time we are all having!', 'Again! I said again! I forgot to say it, so I am saying it twice!'],\n    last_one: ['That\\'s the last one! ...THIS one\\'s the last one. I\\'ve lied to you and I\\'d do it again.', 'FINAL REP! Final final! Final final FINAL!', 'Last one! I counted! I can not count!'],\n    log_drop: ['GOT IT! Nice throw! Here, have it back!', 'Don\\'t worry! I catch logs for a living! This is the living!', 'Log went for a walk! Bringing it home!', 'Ooh! Good! Now I get to help!'],\n    fall: ['That was a great lie-down! Now get up!', 'THE FLOOR! Classic move!', 'Shake it off! It being your whole body!', 'I fell once! In my youth! I am still down there, emotionally!', 'Up you get! That was part of the workout! Everything is!', 'Nobody saw that! I will tell them to stop looking!', 'Tremendous fall! Great height! Great form! Great floor!', 'You rested! Well done! Resting is a skill! Stop now!'],\n    near: ['WHOA! Stay with it! Stay with me! Stay!', 'Lean back! Other back!', 'You\\'ve got this! You nearly did not have this!', 'Steady, champion! Steady is my favourite speed!'],\n    flail: ['ARMS! I love arms! What a lot of arms!', 'That is not in the routine! It is now!', 'Big flap! Big flap energy!'],\n    plank_intro: ['Plank time! You are a plank now! A plank with feelings!', 'Stay flat! Gulls are coming! That is a good sign, I think!', 'Hold it! The gulls think you are a pier! Be a good pier!'],\n    gull: ['One landed! They like you! They like everyone who cannot leave!', 'Another gull! That\\'s a compliment! From a gull!', 'You\\'re a popular plank!', 'Look at you! Covered in friends!', 'Gary\\'s here! Everyone say hello to Gary! Don\\'t!'],\n    shake_off: ['You shook them all off? That is a look I am giving you! This is it!', 'Those were your friends!', 'Well! Some people do not want friends!'],\n    flop: ['BELLY FLOP! Into the sand! That was soft! Do it less!', 'Sand in the teeth! That is how you know it is working!'],\n    tug_intro: ['Tug of Peace! The most peaceful way to pull someone into the sea!', 'On HEAVE, you pull! Do not pull on the other words!', 'Lean back, but not too far back! I will not tell you how far that is!'],\n    heave: ['HEAVE!', 'HEAVE! HEAVE!', 'And HEAVE!', 'HEAVE, champion!', 'HEAVE! That\\'s it!', 'Big HEAVE!'],\n    tug_ease: ['They eased off! Oh, that is sneaky! That is very peaceful of them!', 'They let go a bit! Careful! Careful is my second favourite word!'],\n    tug_sit: ['You sat down! On the sand! In front of everyone! Lovely!', 'Too far back! There was a limit! It was just there!'],\n    tug_win: ['PULL WON! Peace has been achieved, by force!', 'That is one to you! Peacefully!'],\n    tug_lose: ['They got that one! It is fine! Everyone is at peace, and you are in the sand!', 'One to them! I am still proud! I do not know how to stop!'],\n    step_intro: ['Everybody on the bandstand! Press your feet when the footprints get there! The class will copy you! God help them!', 'Dusk! Spotlights! Step Class! Bring your feet, I have forgotten mine!'],\n    step_combo: ['THE CLASS IS WITH YOU!', 'Look behind you! No, do not! But they are all doing it!', 'You\\'re leading a movement! It is a small movement! It is mostly feet!', 'SPOTLIGHTS! Somebody turn on the spotlights! Oh, they are on!', 'That is what I call rhythm! I call most things rhythm!'],\n    step_miss: ['Oh! Someone in the back just fell over! Not your fault! It was your fault!', 'Missed one! Paul has gone down!', 'Keep going! Step over Kevin!', 'Off beat! It\\'s fine! It is jazz now!'],\n    plates_intro: ['Plates! You spin, they spin! It is science! I do not know any science!', 'Round and round! Big plates like it slow, small plates like it fast! Plates are like people, but flat!', 'Circle your weight! Yes! That is a hoop! Do not ask!'],\n    plate_fall: ['SMASH! Lovely! We have got more!', 'That one has retired! Very suddenly!', 'Crash! Don\\'t look at it! Look at the others!'],\n    plate_save: ['SAVED IT! I saw that! I am telling everyone!', 'Back from the brink! Like me, on Tuesdays!'],\n    loop_intro: ['Two laps of the island! Follow Kevin! Kevin is retired, so he has time!', 'Left, right, left, right! That is all of running! I have now taught you running!'],\n    loop_cheer: ['Good pace! Whatever that is! Keep doing whatever that is!', 'There\\'s the lighthouse! Again! That means you are going round!', 'Lovely stride! Long! Short! All sorts!', 'Keep going! The island is only tilted the way you are going half of the time!'],\n    results_low: ['YOU ATTENDED! That is the hardest part! It is not, but I say that!', 'I loved it! I love everything! You could improve!', 'That was a lot of effort, going in several directions!', 'Your form was a form! Next time, maybe a different form!'],\n    results_mid: ['Good! GOOD! That was good! I am running out of words, so GOOD!', 'That is a solid show of something! I am proud of you, champion!', 'Now THAT was adequate! You should see your face! I cannot, I am crying!', 'You did that! I watched you do that! What a day!'],\n    results_high: ['EXEMPLARY! I had to look that word up! It means this!', 'I am going to tell my mother about you! She is a walrus! She will not care!', 'You are the best one I have ever seen today!', 'That was so good that I forgot to blow my whistle! I forget anyway!'],\n    results_sus: ['SUSPICIOUS! That means I do not believe it! I LOVE it!', 'Nobody does that! You did that! I have to go and lie down in the sea!'],\n    idle: ['Want to do some reps? I have some spare!', 'I am warming up! I have been warming up since March!', 'Look at this whistle! I keep meaning to blow it!', 'You look strong! You look like someone who has recently looked strong!', 'I can bench a pier! I have not been asked to!', 'Great to see you, champion! Which one are you? It does not matter!', 'I counted to twelve once! Most of it!', 'Do not tell Trudy, but I have no idea how old my knees are! Where are my knees?'],\n    finale: ['I am down here! I am shouting! You cannot hear me! I BELIEVE IN YOU!', 'THAT\\'S THE LAST ONE! ...I mean it this time! I think I mean it!'],\n  },\n  margaret: { idle: ['Hello, dear. Have you tried standing? I find it very settling.', 'I have been here since the spring. Nobody told me when it ends.', 'You are doing very well, dear. I have not been looking.', 'Would you hold my elbow a moment? No, the wooden one.', 'I was a much worse person before the retreat. I am joking. I was the same.', 'Lovely weather for a slope.', 'Do not mind me. I am only falling very slowly.', 'I knit. I do not have anything to knit. I just do it.'], watch: ['Oh, well done, dear.', 'I saw that. Lovely.', 'Careful, dear. I say that to everyone.'] },\n  kevin: { idle: ['I am retired.', 'I used to be something. Now I am mostly retired.', 'I jog. It is not going anywhere. That is why I like it.', 'Mind the slope. I have been minding it for years.', 'Retired from what? Good question. I retired from that too.', 'Pace yourself. I have paced myself into the ground, and it is lovely.', 'I do two laps. Then I do another two, in case the first two did not take.', 'I have been told I look well. I was told by me.'], watch: ['Good stride.', 'Not bad. For someone who is not retired.', 'Hm.'] },\n  sandras: { idle: ['We agree.', 'We were just saying that.', 'That is exactly what we think. Both of us.', 'We came here together. We are leaving together. We have not been told when.', 'We tried doing separate classes once. We both hated it.', 'Which one of us is Sandra? Yes.', 'We think you are lovely. We discussed it.', 'That is what she said. That is what she said.'], watch: ['Oh! Yes!', 'We saw that.', 'We both saw that.'] },\n  paul: { idle: ['Have you seen my balance? I had it a moment ago.', 'I am fine. This is how I stand.', 'Do not worry. I lean this way on purpose. And now this way, also on purpose.', 'Somebody moved the ground again.', 'They call me Unsteady. I call them unfair. I am sitting down now.', 'I have nearly got the hang of this floor.', 'One day I will stand up straight, and the shock will kill me.', 'Was that an earthquake? No? Then it was me.'], watch: ['Woah. Me too.', 'I felt that from here.', 'Oh, I know that one.'] },\n  gerald: { idle: ['I am ninety-two. They call me Young Gerald. There was an Old Gerald. He was ninety-three.', 'In my day this island was straight. It was not. I just like saying that.', 'I am here to get my strength up. Then I shall do something with it. I have a list.', 'Young people today cannot fall properly. They do not commit.', 'I was told I had a Wobble Age of eighteen. Then they checked again.', 'You remind me of someone. I do not remember who. They owed me money.', 'I am still growing, you know.', 'They say I am spry. I do not know what it means, but I do it.'], watch: ['Ha! I did that in the war.', 'Good knees. I remember knees.', 'Very good, young man. Or lady. I cannot see that far.'] },\n  gary: { idle: ['SKRAAAW.', 'Skraw.', 'Skrr.'] },\n};\n\n// Personal questions: always Yes/No, always a reply either way.\nexport const QUESTIONS = [\n  { q: 'Do you trust your knees?', a: ['Yes', 'No'], yes: 'They speak highly of you too.', no: 'They know.' },\n  { q: 'Do you ever stand on one leg without knowing why?', a: ['Yes', 'No'], yes: 'I thought so.', no: \"That's what someone on one leg would say.\" },\n  { q: 'Have you been leaning on things? Be honest. I can tell.', a: ['Yes', 'No'], yes: 'Thank you for your honesty. Please stop.', no: 'I can tell.' },\n  { q: 'When you walk into a room, which way do you lean first?', a: ['Left', 'Right'], yes: \"Interesting. I'm writing that down.\", no: \"Interesting. I'm writing that down.\" },\n  { q: 'Do you feel you are a good person, in terms of posture?', a: ['Yes', 'No'], yes: 'Bold of you.', no: 'Nobody does. That is why we are here.' },\n  { q: 'Would you say you are the sort of person who stays standing?', a: ['Yes', 'No'], yes: 'We shall see.', no: 'Thank you for preparing me.' },\n  { q: 'Have you ever apologised to a chair?', a: ['Yes', 'No'], yes: 'The chair appreciated it.', no: 'It remembers.' },\n  { q: 'If the floor could talk, would it speak well of you?', a: ['Yes', 'No'], yes: 'I will ask it.', no: 'It already has. I am sorry.' },\n  { q: 'Do you know where your left foot is, right now?', a: ['Yes', 'No'], yes: 'Please do not check. I believe you.', no: 'It is at the end of your left leg. You are welcome.' },\n  { q: 'Do you think about your balance when you are not here?', a: ['Yes', 'No'], yes: 'Good. It thinks about you too.', no: 'You will now.' },\n  { q: 'Have you ever waved back at someone who was not waving at you?', a: ['Yes', 'No'], yes: 'That is a lean of the spirit. I am noting it.', no: 'You did not notice, that is all.' },\n  { q: 'Is there anything you would like to tell the island?', a: ['Yes', 'No'], yes: 'It heard you. It is thinking it over.', no: 'That is what it expected.' },\n];\n\nconst bags = new Map();\nfunction fill(s, vars) { return vars ? s.replace(/\\{(\\w+)\\}/g, (m, k) => (vars[k] !== undefined ? vars[k] : m)) : s; }\n/** Pick a line without repeats until the bag is empty. */\nexport function line(who, situation, vars) {\n  const set = LINES[who] && LINES[who][situation];\n  if (!set || !set.length) return '';\n  const key = `${who}.${situation}`;\n  let bag = bags.get(key);\n  if (!bag || !bag.length) {\n    bag = set.slice();\n    for (let i = bag.length - 1; i > 0; i--) { const j = Math.floor(cos(0, i + 1)); [bag[i], bag[j]] = [bag[j], bag[i]]; }\n    bags.set(key, bag);\n  }\n  return fill(bag.pop(), vars);\n}\nexport function has(who, situation) { return !!(LINES[who] && LINES[who][situation]); }\nexport function countLines(who) { let n = 0; for (const k of Object.keys(LINES[who] || {})) n += LINES[who][k].length; return n; }\nEOF\nnode -e \"\nimport('./src/data/dialogue.js').catch(e=>console.log(e.message));\n\" 2>&1 | head -2; python3 - <<'EOF'\nimport re\ns=open('src/data/dialogue.js').read()\nblocks={'trudy':s[s.index('trudy: {'):s.index('stillwater: {')],'stillwater':s[s.index('stillwater: {'):s.index('bolster: {')],'bolster':s[s.index('bolster: {'):s.index('margaret: {')],'guests':s[s.index('margaret: {'):s.index('gary: {')]}\nfor k,v in blocks.items():\n    print(k, len(re.findall(r\"(?:'(?:[^'\\\\]|\\\\.)*'|\\\"(?:[^\\\"\\\\]|\\\\.)*\\\")(?=\\s*[,\\]])\",v)))\nEOF","description":"Write the dialogue tables and count lines per speaker"}}}
