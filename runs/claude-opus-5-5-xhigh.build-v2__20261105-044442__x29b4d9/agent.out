{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjnpeBwTiagx8jMEojqm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011WmvbrTaZfNzmHTRTyHski","name":"Bash","input":{"command":"cat > src/game/checkin.js <<'EOF'\nimport { EventBase } from '../events/base.js';\nimport { TESTS } from '../data/programme.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { Trudy } from '../art/cast.js';\nimport { paintColour } from '../art/doll.js';\nimport { h } from '../ui/dom.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { line } from '../data/dialogue.js';\nimport { refreshJarDisplay } from './jar.js';\n\nconst clamp01 = (x) => Math.max(0, Math.min(1, x));\nconst DIRS = [[-1, 0, 'left'], [1, 0, 'right'], [0, -1, 'forward'], [0, 1, 'back']];\n\n/** Three short tests on a round mat with Trudy. Each scores 0 to 1. */\nclass CheckInEvent extends EventBase {\n  static id = 'checkin';\n  constructor(spec) {\n    super({ ...spec, data: { title: 'The Check-In', instructor: 'trudy', verbs: [['lean', 'Lean']], music: 'island', tiers: [{}] } });\n    this.seaLevel = -6.4; this.tests = spec.tests; this.god = false;\n    this.idx = -1; this.cur = null; this.scores = {}; this.allDone = false; this.testT = 0;\n  }\n  setupLane(lane) { lane.doll.rig.loop('breathe'); }\n  buildSet() {\n    const g = this.group;\n    add(g, M(geo.cyl(5, 5.4, 0.6, 36), 0x8CCB6A, 0, -0.32, 0), M(geo.cyl(2.2, 2.2, 0.04, 40), 0xC24D6A, 0, 0.01, 0), M(geo.tor(2.2, 0.05, Math.PI * 2, 48), 0xFFF3DC, 0, 0.03, 0, { rot: [Math.PI / 2, 0, 0], shadow: false }));\n    this.trudy = new Trudy();\n    this.trudy.root.position.set(-1.9, 0, 0.6);\n    this.trudy.root.rotation.y = 0.8;\n    this.trudy.root.scale.setScalar(1.25);\n    g.add(this.trudy.root);\n    this.game.setBackdrop(35, -110);\n    this.game.sea.setLevel(this.seaLevel);\n  }\n  cameraShot(snap) { this.game.rig.shot(0.6, 2.2, 7, -0.25, 1, 0, { snap, rate: 4 }); this.inputYaw = Math.atan2(0.85, 7); }\n  hudSetup(hud) {\n    this.howEl = h('div.tag', { style: 'position:absolute;top:14rem;left:50%;transform:translateX(-50%) rotate(-.5deg);font-size:4.6rem;font-weight:600;text-align:center;max-width:130rem' }, '');\n    hud.el.append(this.howEl);\n    this.barEl = h('div', { style: 'position:absolute;top:27rem;left:50%;width:96rem;height:6rem;margin-left:-48rem;background:#FFF4DC;border:.6rem solid #1A1420;border-radius:3rem;overflow:hidden;display:none' });\n    this.barFill = h('div', { style: 'position:absolute;top:0;bottom:0;background:#6FB7D6' });\n    this.barGoal = h('div', { style: 'position:absolute;top:0;bottom:0;width:1.6rem;margin-left:-.8rem;background:#2F8F46' });\n    this.barMid = h('div', { style: 'position:absolute;top:0;bottom:0;left:50%;width:.5rem;background:#1A1420' });\n    this.barEl.append(this.barFill, this.barGoal, this.barMid);\n    hud.el.append(this.barEl);\n    this.beatEl = h('div', { style: 'position:absolute;top:27rem;left:50%;width:14rem;height:14rem;margin-left:-7rem;border-radius:50%;background:#F5B700;border:.7rem solid #1A1420;display:none' });\n    hud.el.append(this.beatEl);\n    hud.setScore('', '');\n  }\n  removeHud() { if (this.howEl) { this.howEl.remove(); this.barEl.remove(); this.beatEl.remove(); } }\n  start() { this.nextTest(); }\n  nextTest() {\n    this.idx++;\n    if (this.idx >= this.tests.length) { this.allDone = true; this.howEl.textContent = 'Thank you.'; this.barEl.style.display = 'none'; this.beatEl.style.display = 'none'; return; }\n    const id = this.tests[this.idx], def = TESTS[id];\n    this.cur = { id, def, t: 0, sum: 0, n: 0, errors: [], state: 'show', showT: 2.2, sub: 0 };\n    this.showHow(def);\n    this.game.audio.sfx('bell');\n    const lane = this.lanes[0];\n    lane.doll.rig.loop('breathe');\n    lane.input.wishX = 0; lane.input.wishZ = 0;\n    this.game.input.resetRing();\n    this.barEl.style.display = id === 'leanMatch' ? '' : 'none';\n    this.beatEl.style.display = id === 'stepTime' ? '' : 'none';\n    this.setPromptsFor(id);\n    if (id === 'stepTime') { this.cur.beat = 60 / 96; this.cur.beats = []; this.cur.foot = null; const n = Math.floor(def.time / this.cur.beat); for (let i = 0; i < n; i++) this.cur.beats.push({ t: (i + 2) * this.cur.beat, hit: false }); }\n    if (id === 'leanMatch') { this.cur.targets = [this.pickTarget(), this.pickTarget(), this.pickTarget()]; this.cur.tIdx = -1; }\n    if (id === 'quickLean') { this.cur.prompts = []; this.cur.nextPrompt = 0.5; this.cur.active = null; this.cur.reactions = []; }\n  }\n  pickTarget() { const opts = [-0.7, -0.5, -0.3, 0.3, 0.5, 0.7]; return opts[Math.floor(this.r() * opts.length) % opts.length]; }\n  showHow(def) { this.howEl.textContent = `${def.title}: ${def.how}`; }\n  setPromptsFor(id) {\n    const hud = this.game.hud;\n    const map = {\n      standStill: [['lean', 'Lean']], leanMatch: [['lean', 'Lean']], stepTime: [['footL', 'Left'], ['footR', 'Right']], quickLean: [['lean', 'Lean']], oneFoot: [['footR', 'Hold down'], ['lean', 'Lean']],\n    };\n    hud.setPrompts(map[id]);\n  }\n  fixedEvent(dt) {\n    const c = this.cur, lane = this.lanes[0];\n    if (!c) return;\n    if (c.state === 'show') {\n      c.showT -= dt;\n      if (c.showT <= 0) { c.state = 'run'; }\n      return;\n    }\n    if (c.state === 'after') {\n      c.afterT -= dt;\n      if (c.afterT <= 0) this.nextTest();\n      return;\n    }\n    c.t += dt;\n    const b = lane.bal, def = c.def;\n    b.sway = def.sway; b.tremor = def.tremor;\n    const r = Math.hypot(lane.dotX, lane.dotZ);\n    switch (c.id) {\n      case 'standStill': c.sum += r * dt; c.n += dt; break;\n      case 'oneFoot': {\n        const held = lane.input.footR > 0.5 && lane.input.footL < 0.5;\n        b.params.margin = held ? 0.225 : 0.45;\n        c.sum += (held ? r : Math.max(r, 0.5)) * dt; c.n += dt;\n        lane.doll.rig.loop(held ? 'pose4' : 'breathe');\n        break;\n      }\n      case 'leanMatch': {\n        const i = Math.min(2, Math.floor(c.t / 6));\n        if (i !== c.tIdx) {\n          c.tIdx = i;\n          const x = c.targets[i];\n          this.howEl.textContent = `Lean ${Math.round(Math.abs(x) * 100)}% ${x < 0 ? 'left' : 'right'}.`;\n          this.game.audio.sfx('uiConfirm');\n        }\n        c.goal = c.targets[i];\n        if (c.t - i * 6 > 1.5) { c.sum += Math.abs(lane.dotX - c.goal) * dt; c.n += dt; }\n        break;\n      }\n      case 'stepTime': {\n        const i = lane.input;\n        const foot = i.footLPressed ? 'L' : i.footRPressed ? 'R' : null;\n        if (foot) {\n          lane.doll.rig.once(foot === 'L' ? 'stepR' : 'stepL');\n          if (foot !== c.foot) {\n            let best = null, bd = 1e9;\n            for (const bt of c.beats) { if (bt.hit) continue; const d = Math.abs(bt.t - c.t); if (d < bd) { bd = d; best = bt; } }\n            if (best && bd < 0.25) { best.hit = true; c.errors.push(bd); }\n            c.foot = foot;\n          }\n        }\n        for (const bt of c.beats) if (!bt.clicked && bt.t <= c.t) { bt.clicked = true; this.game.audio.sfx('metronome'); this.pulseBeat = 1; }\n        break;\n      }\n      case 'quickLean': {\n        c.nextPrompt -= dt;\n        if (!c.active && c.nextPrompt <= 0 && c.prompts.length < 6) {\n          const d = DIRS[Math.floor(this.r() * 4) % 4];\n          c.active = { dir: d, t: 0 };\n          c.prompts.push(d);\n          this.howEl.textContent = `Lean ${d[2]}!`;\n          this.game.audio.sfx('uiConfirm');\n        }\n        if (c.active) {\n          c.active.t += dt;\n          const [dx, dz] = c.active.dir;\n          const proj = lane.dotX * dx + lane.dotZ * dz;\n          if (proj > 0.4 || c.active.t > 2) {\n            c.reactions.push(Math.min(2, c.active.t));\n            c.active = null; c.nextPrompt = 0.6;\n            this.howEl.textContent = 'And back to the middle.';\n          }\n        }\n        break;\n      }\n      default: break;\n    }\n    if (c.t >= def.time) this.finishTest();\n  }\n  finishTest() {\n    const c = this.cur;\n    let score = 0;\n    if (c.id === 'standStill' || c.id === 'oneFoot') score = 1 - (c.sum / Math.max(0.001, c.n)) / 0.25;\n    if (c.id === 'leanMatch') score = 1 - (c.sum / Math.max(0.001, c.n)) / 0.4;\n    if (c.id === 'stepTime') {\n      const missed = c.beats.length - c.errors.length;\n      const mean = (c.errors.reduce((a, b) => a + b, 0) + missed * 0.2) / Math.max(1, c.beats.length);\n      score = 1 - mean / 0.12;\n    }\n    if (c.id === 'quickLean') {\n      const rs = c.reactions;\n      const mean = rs.length ? rs.reduce((a, b) => a + b, 0) / rs.length : 2;\n      score = 1 - (mean - 0.35) / 0.9;\n    }\n    score = clamp01(score);\n    this.scores[c.id] = score;\n    this.lanes[0].bal.params.margin = 0.45;\n    c.state = 'after'; c.afterT = 2.2;\n    this.game.speech.say('trudy', line('trudy', score > 0.55 ? 'checkin_good' : 'checkin_bad'), { auto: 2, top: false });\n    this.howEl.textContent = `${c.def.title}: ${Math.round(score * 100)}`;\n    this.game.audio.sfx('stamp');\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const c = this.cur;\n    out.wishX = 0; out.wishZ = 0; out.footL = 0; out.footR = 0; out.footLPressed = false; out.footRPressed = false;\n    if (!c || c.state !== 'run') return;\n    let gx = 0, gz = 0;\n    switch (c.id) {\n      case 'leanMatch': gx = c.goal || 0; { const [x, z] = bot.steer(gx, 0, true); out.wishX = x; out.wishZ = z; } return;\n      case 'oneFoot': out.footR = 1; break;\n      case 'quickLean':\n        if (c.active && c.active.t > bot.s.lag * 0.7) { gx = c.active.dir[0]; gz = c.active.dir[1]; out.wishX = gx; out.wishZ = gz; return; }\n        break;\n      case 'stepTime': {\n        const d = bot.data;\n        for (const bt of c.beats) {\n          if (bt.botErr === undefined) bt.botErr = bot.timing();\n          if (!bt.botDone && c.t >= bt.t + bt.botErr) {\n            bt.botDone = true;\n            d.foot = d.foot === 'L' ? 'R' : 'L';\n            if (d.foot === 'L') { out.footLPressed = true; out.footL = 1; } else { out.footRPressed = true; out.footR = 1; }\n            break;\n          }\n        }\n        return;\n      }\n      default: break;\n    }\n    const [x, z] = bot.steer(gx, gz);\n    out.wishX = x; out.wishZ = z;\n  }\n  hud() {\n    const c = this.cur, lane = this.lanes[0];\n    const hud = this.game.hud;\n    if (!c) return;\n    hud.setTime(c.state === 'run' ? c.def.time - c.t : null);\n    lane.discView.zone = null;\n    if (c.id === 'standStill' || c.id === 'oneFoot') lane.discView.zone = { x: 0, z: 0, r: 0.25, on: Math.hypot(lane.dotX, lane.dotZ) < 0.25 };\n    if (c.id === 'leanMatch' && c.goal !== undefined) {\n      lane.discView.zone = { x: c.goal, z: 0, r: 0.14, on: Math.abs(lane.dotX - c.goal) < 0.1 };\n      const x = lane.dotX;\n      this.barFill.style.left = `${x < 0 ? 50 + x * 50 : 50}%`;\n      this.barFill.style.width = `${Math.min(50, Math.abs(x) * 50)}%`;\n      this.barGoal.style.left = `${50 + c.goal * 50}%`;\n    }\n    if (c.id === 'quickLean' && c.active) lane.discView.zone = { x: c.active.dir[0] * 0.65, z: c.active.dir[1] * 0.65, r: 0.3, on: false };\n    if (c.id === 'stepTime') {\n      this.pulseBeat = Math.max(0, (this.pulseBeat || 0) - 0.08);\n      this.beatEl.style.transform = `scale(${1 + this.pulseBeat * 0.5})`;\n    }\n  }\n  frameEvent(dt) {\n    this.trudy.update(dt);\n    this.trudy.feel(this.lanes[0].dotX);\n  }\n  isDone() { return this.allDone; }\n  dispose() { this.removeHud(); super.dispose(); }\n  laneResult() { return { form: 0, raw: 0, stats: '' }; }\n}\n\n/** The Check-In and the reveal: lights dim, drum roll, numbers spin on a wooden counter, a sting, a line. */\nexport class CheckInMode {\n  constructor(game) { this.game = game; this.name = 'checkin'; this.canPause = true; this.stage = 'tests'; }\n  enter() {\n    const g = this.game, pr = g.programme, p = g.save.profile;\n    g.setIsland('hidden');\n    g.ui.clear(); g.speech.clear();\n    g.palette.set('dawn', 0.8);\n    const tests = pr.testsToday();\n    this.ev = new CheckInEvent({ game: g, tier: 0, tests, lanes: [{ kind: 'local', name: p ? p.name : 'You', colour: p ? paintColour(p.paint) : '#2CB5A0', hat: p ? p.hat : 'none', source: 'any' }], mode: 'solo' });\n    g.currentEvent = this.ev;\n    this.ev.build();\n    g.sea.setLevel(-6.4);\n    this.ev.cameraShot(true);\n    g.hud.reset();\n    g.hud.setDiscs(this.ev.lanes);\n    g.hud.setPrompts([['lean', 'Lean']]);\n    this.ev.hudSetup(g.hud);\n    g.hud.show(true);\n    g.audio.music('island');\n    this.handle = g.scripts.run(this.flow());\n  }\n  restart() { const g = this.game; g.setMode(new CheckInMode(g), 'checkin'); }\n  *flow() {\n    const g = this.game, ev = this.ev, pr = g.programme, p = g.save.profile;\n    yield 0.4;\n    ev.begin();\n    yield () => ev.isDone();\n    ev.phase = 'done';\n    yield 0.8;\n    const vals = Object.values(ev.scores);\n    const mean = vals.reduce((a, b) => a + b, 0) / Math.max(1, vals.length);\n    this.mean = mean;\n    const age = pr.ageFor(mean, p.today.day);\n    const prev = p.ages.length ? p.ages[p.ages.length - 1].age : null;\n    const unlocked = pr.checkinDone(age, ev.scores);\n    this.stage = 'reveal';\n    g.hud.show(false);\n    yield* this.reveal(age, prev);\n    if (unlocked.unlocks && unlocked.unlocks.length) g.ui.toast(`New: ${unlocked.unlocks.map((u) => u.name).join(', ')}.`, 3);\n    this.stage = 'done';\n    refreshJarDisplay(g);\n    g.go(() => { g.flow.toIsland({ afterCheckin: true }); });\n  }\n  *reveal(age, prev) {\n    const g = this.game;\n    let advanced = false;\n    let digits = [];\n    const scr = g.ui.only({\n      name: 'reveal', className: 'dim',\n      build: (s) => {\n        s.el.style.background = 'rgba(26,20,32,.82)';\n        const c = h('div.counter', { style: 'margin-top:20rem' });\n        digits = [h('div.digit', '0'), h('div.digit', '0')];\n        c.append(...digits);\n        s.el.append(h('div.h2', { style: 'margin-top:8rem' }, 'Your Wobble Age'), c);\n      },\n    });\n    g.speech.say('trudy', line('trudy', 'reveal_lead'), { auto: 1.5 });\n    g.audio.sfx('drumRoll', { dur: 2 });\n    let t = 0;\n    while (t < 2) {\n      t += 1 / 120;\n      if (Math.floor(t * 30) !== Math.floor((t - 1 / 120) * 30)) { digits[0].textContent = String(Math.floor(t * 41) % 10); digits[1].textContent = String(Math.floor(t * 67) % 10); }\n      yield null;\n    }\n    const a = String(age).padStart(2, '0');\n    digits[0].textContent = a[0]; digits[1].textContent = a[1];\n    g.audio.sting('reveal');\n    g.audio.sfx('stamp');\n    g.rig.shake(0.05);\n    const band = age >= 70 ? 'age_old' : age >= 50 ? 'age_mid' : age >= 30 ? 'age_low' : 'age_young';\n    g.speech.say('trudy', line('trudy', band, { age }), {});\n    let l = g.speech.line;\n    yield () => !g.speech.line || g.speech.line !== l;\n    if (prev !== null) {\n      g.speech.say('trudy', line('trudy', age < prev ? 'age_down' : 'age_same', { prev }), {});\n      l = g.speech.line;\n      yield () => !g.speech.line || g.speech.line !== l;\n    }\n    advanced = true;\n    g.ui.close(scr);\n    return advanced;\n  }\n  fixed(dt) { this.ev.fixed(dt); }\n  frame(dt) { this.ev.frame(dt); }\n  exit() {\n    const g = this.game;\n    if (this.handle) this.handle.cancel();\n    g.hud.show(false); g.hud.reset();\n    this.ev.dispose();\n    g.currentEvent = null;\n    g.speech.clear();\n    g.ui.clear();\n  }\n}\nexport { G, promptHTML };\nEOF\ncat > src/game/ending.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { MAP } from '../art/island.js';\nimport { line } from '../data/dialogue.js';\nimport { TITLE, RESORT } from '../data/config.js';\nimport * as THREE from 'three/webgpu';\nimport { refreshJarDisplay } from './jar.js';\n\nconst CREDITS = [\n  [TITLE, RESORT], ['Head of Alignment', 'Trudy'], ['Stillness', 'Ms. Stillwater'], ['Strength and Cardio', 'Coach Bolster'],\n  ['Guests', 'Gentle Margaret, Retired Kevin, Both Sandras, Unsteady Paul, Young Gerald'], ['Gull', 'Gary (uncredited)'],\n  ['Everything rolling downhill', 'The oranges'], ['Thank you for attending', 'It was noted'],\n];\nconst _v = new THREE.Vector3();\n\n/** The bubble centres for the first time. Then the slow pan over everything you straightened. */\nexport class EndingMode {\n  constructor(game) { this.game = game; this.name = 'ending'; this.canPause = false; this.t = 0; this.stage = 'level'; }\n  enter() {\n    const g = this.game, p = g.save.profile;\n    g.ui.clear();\n    g.setIsland('home');\n    if (p) { p.levelled = true; g.save.write(); }\n    g.phys.setRest(0); g.phys.restNow = 0; g.phys.snapTilt();\n    g.palette.set('golden', 0.5);\n    g.audio.stopMusic(0.2);\n    g.audio.setTilt(0);\n    refreshJarDisplay(g);\n    const trudy = g.art.trudy;\n    trudy.root.position.set(1.5, 0, -6);\n    trudy.feel(0);\n    g.phys.setPosition(1.5, -3);\n    this.shot = 'trudy';\n    this.frameCam(true);\n    this.handle = g.scripts.run(this.flow());\n  }\n  frameCam(snap) {\n    const g = this.game, art = g.art;\n    art.group.updateWorldMatrix(true, false);\n    if (this.shot === 'trudy') {\n      _v.set(1.5, 0.5, -6).applyMatrix4(art.group.matrixWorld);\n      g.rig.shot(_v.x, _v.y + 0.45, _v.z + 3.1, _v.x, _v.y + 0.05, _v.z, { fov: 30, snap, rate: 2 });\n    } else {\n      const a = this.t * 0.12;\n      const R = 40;\n      g.rig.shot(Math.sin(a) * R, 12 + Math.sin(a * 0.6) * 4, Math.cos(a) * R, 0, 2, 0, { fov: 38, snap, rate: 1 });\n    }\n  }\n  *flow() {\n    const g = this.game, art = g.art;\n    yield 1.2;\n    // Silence. She has only ever seen the world at nine degrees.\n    art.trudy.rig.once('gasp');\n    yield* g.say('trudy', 'ending_1');\n    yield 0.8;\n    yield* g.say('trudy', 'ending_2');\n    yield 0.6;\n    // The marbles flare, the lighthouse lights, and the credits roll.\n    this.stage = 'flare';\n    g.audio.sting('ending');\n    art.lightGlow.intensity = 40;\n    art.lampMat.color.set(0xFFFFFF);\n    const lh = MAP.lighthouse;\n    g.fx.confetti(lh.x, 12, lh.z, 200, [0xE8443A, 0xF5B700, 0x2CB5A0, 0x5AA9E6, 0xFFF3DC], 12);\n    g.rig.shake(0.05);\n    g.palette.set('dusk', 8);\n    yield 1.5;\n    this.shot = 'pan';\n    g.audio.music('level');\n    this.stage = 'credits';\n    let i = 0;\n    const scr = g.ui.only({ name: 'credits', passive: true, build: (s) => { this.credEl = h('div', { style: 'margin-top:14rem;text-align:center' }); s.el.append(this.credEl); } });\n    for (const [a, b] of CREDITS) {\n      this.credEl.innerHTML = '';\n      this.credEl.append(h('div.h2', a), h('div.tag', { style: 'display:inline-block;font-size:4rem' }, b));\n      yield 2.6;\n      i++;\n    }\n    g.ui.close(scr);\n    this.shot = 'trudy';\n    g.palette.set('dawn', 4);\n    this.stage = 'after';\n    yield 1;\n    yield* g.say('trudy', 'ending_3');\n    yield* g.say('trudy', 'ending_4');\n    this.stage = 'done';\n    const p = g.save.profile;\n    if (p) {\n      // Save the levelled state and carry on into Maintenance days.\n      if (p.today.day <= 5) g.programme.nextDay();\n    }\n    art.lightGlow.intensity = 0;\n    return i;\n  }\n  fixed(dt) {\n    const g = this.game;\n    this.t += dt;\n    g.stepIsland(dt, 0);\n    if (this.handle && this.handle.done && !this.left) {\n      this.left = true;\n      g.go(() => g.flow.toIsland({ morning: true }));\n    }\n  }\n  frame(dt) {\n    const g = this.game;\n    g.syncIsland(dt);\n    g.art.trudy.feel(0);\n    g.art.trudy.update(dt);\n    this.frameCam(false);\n  }\n  exit() {\n    const g = this.game;\n    if (this.handle) this.handle.cancel();\n    g.ui.clear();\n    g.speech.clear();\n  }\n}\nexport { line };\nEOF\ncat > src/game/attract.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { EventRun } from './eventRun.js';\nimport { hasEvent } from '../events/index.js';\nimport { TITLE, SEAT_COLOURS } from '../data/config.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { Doll } from '../art/doll.js';\nimport { TIER_NAMES } from '../data/events.js';\nimport { MAP } from '../art/island.js';\nimport * as THREE from 'three/webgpu';\n\nconst COLS = ['#2CB5A0', '#E8644A', '#F5C84A', '#8A5BA8'];\nconst bots = (n, skill = 'average') => Array.from({ length: n }, (_, i) => ({ kind: 'bot', skill: i === 0 ? 'sharp' : skill, name: ['Margaret', 'Kevin', 'Sandra', 'Paul'][i], colour: COLS[i % 4] }));\nconst VIGNETTES = [\n  { id: 'walk' },\n  { id: 'fruitHat', after: (ev) => { ev.god = false; ev.lanes[0].bankAt = 11; ev.nextFruit = 0.3; ev.cfg = { ...ev.cfg, every: 0.8 }; } },\n  { id: 'cairn', after: (ev) => { ev.cfg = { ...ev.cfg, every: 2.2 }; } },\n  { id: 'stepClass', after: (ev) => { ev.clock = 8; ev.nextClick = ev.notes.findIndex((n) => n.t >= 8); } },\n  { id: 'plates' },\n  { id: 'springboard', after: (ev) => { const l = ev.lanes[0]; l.boardV = 4; l.pumpT = 3; } },\n  { id: 'raft', lanes: 4, god: false },\n  { id: 'roomService', after: (ev) => { ev.gustNext = 1.5; } },\n  { id: 'poses' },\n];\nconst _v = new THREE.Vector3(), _iq = new THREE.Quaternion();\n\n/** Island walk vignette: a bot wanders and the island tips under it. */\nclass WalkVignette {\n  constructor(game) { this.game = game; this.name = 'walk'; this.ev = null; this.t = 0; this.leg = 0; }\n  enter() {\n    const g = this.game;\n    g.setIsland('home');\n    g.palette.set('noon', 1);\n    g.audio.music('island');\n    this.doll = new Doll({ shirt: '#2CB5A0', hat: 'visor' });\n    g.art.group.add(this.doll.root);\n    g.phys.setPosition(0, 10);\n    this.spots = [MAP.pier, MAP.lighthouse, MAP.sunDeck, MAP.yard, MAP.bandstand];\n    this.frameCam(true);\n  }\n  frameCam(snap) {\n    const g = this.game, p = g.phys.pos;\n    g.art.group.updateWorldMatrix(true, false);\n    _v.set(p.x, 0.9, p.z).applyMatrix4(g.art.group.matrixWorld);\n    g.rig.shot(_v.x + 8, _v.y + 7, _v.z + 13, _v.x, _v.y + 0.5, _v.z, { snap, rate: 3, fov: 42 });\n  }\n  fixed(dt) {\n    const g = this.game, ph = g.phys;\n    this.t += dt;\n    const s = this.spots[this.leg % this.spots.length];\n    const p = ph.pos;\n    const dx = s.x - p.x, dz = s.z - p.z, d = Math.hypot(dx, dz);\n    if (d < 3) this.leg++;\n    ph.wantX = (dx / (d || 1)) * 6; ph.wantZ = (dz / (d || 1)) * 6;\n    ph.leanExtraX = Math.sin(this.t * 0.7) * 0.08; ph.leanExtraZ = Math.cos(this.t * 0.5) * 0.08;\n    g.stepIsland(dt, 1);\n  }\n  frame(dt) {\n    const g = this.game, ph = g.phys, p = ph.pos;\n    g.syncIsland(dt);\n    this.frameCam(false);\n    _iq.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w).invert();\n    this.doll.root.position.set(p.x, 0, p.z);\n    this.doll.root.quaternion.copy(_iq);\n    this.doll.face(Math.atan2(ph.wantX, ph.wantZ));\n    this.doll.rig.loop('jog');\n    this.doll.update(dt);\n  }\n  exit() {\n    const g = this.game;\n    g.phys.wantX = 0; g.phys.wantZ = 0; g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    g.art.group.remove(this.doll.root);\n  }\n}\n\n/**\n * The looping kiosk demo: bot-played vignettes of about 18 s each, with the bots allowed to cheat.\n * Any input exits it and is swallowed. Back to the title for 5 s between passes.\n */\nexport class Attract {\n  constructor(game) { this.game = game; this.name = 'attract'; this.index = -1; this.t = 0; this.sub = null; this.visited = []; this.canPause = false; this.leaving = false; this.titlePause = 0; }\n  enter() {\n    const g = this.game;\n    g.attract = true;\n    this.overlay = g.ui.only({\n      name: 'attract', passive: true,\n      build: (s) => {\n        this.demoEl = h('div.demo.tag');\n        s.el.append(h('div.demo-title', TITLE), this.demoEl);\n        this.renderDemo();\n      },\n    });\n    g.hud.reset();\n    this.next();\n  }\n  renderDemo() {\n    const g = this.game;\n    this.demoEl.innerHTML = `DEMO · Press any button ${promptHTML('use', '', g.input.lastDevice, g.save.settings.glyphs).replace('prompt-text', 'prompt-text hidden')}`;\n  }\n  next() {\n    const g = this.game;\n    this.index++;\n    if (this.index >= VIGNETTES.length) {\n      // Back to the title for five seconds between passes.\n      this.index = -1;\n      this.titlePause = 5;\n      this.closeSub();\n      g.setIsland('home');\n      g.palette.set('dawn', 1);\n      g.rig.shot(9, 9, 52, 0, 0.5, -2, { fov: 38, rate: 2 });\n      this.t = 0;\n      return;\n    }\n    const v = VIGNETTES[this.index];\n    if (v.id !== 'walk' && !hasEvent(v.id)) { this.next(); return; }\n    this.t = 0;\n    this.closeSub();\n    if (v.id === 'walk') { this.sub = new WalkVignette(g); this.sub.enter(); this.visited.push('walk'); return; }\n    this.visited.push(v.id);\n    const run = new EventRun(g, {\n      id: v.id, tier: 0, lanes: bots(v.lanes || 1), mode: 'attract', skipIntro: true, skipCountdown: true, god: v.god !== false,\n      afterBuild: v.after, onResult: function* none() { /* nothing to report in a demo */ },\n    });\n    this.sub = run;\n    run.enter();\n    g.hud.show(true);\n  }\n  closeSub() {\n    if (this.sub) { const s = this.sub; this.sub = null; s.exit(); this.game.ui.stack.includes(this.overlay) || this.game.ui.layer.append(this.overlay.el); if (!this.game.ui.stack.includes(this.overlay)) this.game.ui.stack.push(this.overlay); }\n  }\n  fixed(dt) {\n    const g = this.game, inp = g.input;\n    if (inp.activityThisTick && !this.leaving && (this.grace === undefined || this.grace <= 0)) { this.exitToTitle(); return; }\n    if (this.grace > 0) this.grace -= dt;\n    this.t += dt;\n    if (this.titlePause > 0) {\n      this.titlePause -= dt;\n      g.stepIsland(dt, 0);\n      if (this.titlePause <= 0) this.next();\n      return;\n    }\n    if (this.sub) this.sub.fixed(dt);\n    if (this.t >= 18 && !g.wiping) { this.t = 0; g.scripts.run(g.wipe(() => this.next())); }\n  }\n  frame(dt) {\n    const g = this.game;\n    if (this.titlePause > 0) g.syncIsland(dt);\n    if (this.sub) this.sub.frame(dt);\n  }\n  exitToTitle() {\n    const g = this.game;\n    this.leaving = true;\n    g.input.swallow();\n    g.flow.toTitle();\n  }\n  exit() {\n    const g = this.game;\n    this.closeSub();\n    g.attract = false;\n    g.hud.reset(); g.hud.show(false);\n    g.ui.clear();\n    g.speech.clear();\n    g.input.idle = 0;\n  }\n}\nexport { rot2, SEAT_COLOURS, TIER_NAMES };\nEOF\ncat > src/game/devmode.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { h } from '../ui/dom.js';\nimport { TUNING } from '../data/tuning.js';\nimport { tun, resetTuning, tuningJSON } from '../core/tuning.js';\nimport { EVENTS, TIER_NAMES } from '../data/events.js';\nimport { hasEvent } from '../events/index.js';\nimport { LINES, line } from '../data/dialogue.js';\nimport { TRACKS, STINGS } from '../audio/tracks.js';\nimport { PALETTE_ORDER } from '../data/palettes.js';\nimport { SPEAKERS } from '../ui/speech.js';\nimport { DAYS } from '../data/programme.js';\nimport { RAPIER } from '../physics/world.js';\nimport { blankInput } from '../input/input.js';\n\nconst ADD = (n) => n;\n/** Dev Mode, from Pause. Pages of big controls by group, six to a page, usable by pad, keys and mouse. */\nexport function openDev(game) {\n  const g = game;\n  const groups = Object.keys(TUNING).reduce((a, k) => { (a[TUNING[k].group] = a[TUNING[k].group] || []).push(k); return a; }, {});\n  const pages = [];\n  const page = (title, items) => pages.push({ title, items });\n  const ev = () => g.currentEvent;\n  page('Run', [\n    { label: 'God mode', get: () => (g.god ? 'On' : 'Off'), use: () => { g.god = !g.god; if (ev()) ev().god = g.god; } },\n    { label: 'Time scale', slider: { min: 0.1, max: 4, step: 0.1, get: () => g.loop.timeScale, set: (v) => { g.loop.timeScale = v; } } },\n    { label: 'Single step', use: () => { g.devStep = 1; g.ui.toast('One step.', 0.8); } },\n    { label: 'Let the bot play', get: () => (ev() && ev().autoplay === 0 ? 'On' : 'Off'), use: () => { const e = ev(); if (!e) return; e.autoplay = e.autoplay === 0 ? undefined : 0; } },\n    { label: 'Skip to Results', use: () => { if (g.mode && g.mode.skip) { closeAll(); g.mode.skip(); } else g.ui.toast('No class is running.'); } },\n    { label: 'Skip to the Ending', use: () => { closeAll(); g.go(() => g.flow.toEnding()); } },\n  ]);\n  page('Jump', [\n    { label: 'Event', choose: Object.keys(EVENTS).filter(hasEvent), state: 'evId', fmt: (id) => EVENTS[id].title },\n    { label: 'Tier', choose: [0, 1, 2], state: 'tier', fmt: (t) => TIER_NAMES[t] },\n    { label: 'Go to that class', use: () => { const id = g.devJump.evId, t = g.devJump.tier; closeAll(); g.go(() => g.flow.runClass(id, Math.min(t, EVENTS[id].tiers.length - 1), { programme: false })); } },\n    { label: 'Day', choose: [1, 2, 3, 4, 5, 6], state: 'day', fmt: (d) => `Day ${d}` },\n    { label: 'Jump to that day', use: () => { jumpDay(g, g.devJump.day); closeAll(); g.go(() => g.flow.toIsland({ morning: true })); } },\n    { label: 'Next step', use: () => { const p = g.save.profile; if (p) { const n = g.programme.nextClass(); if (n) { p.today.done.push(n); if (p.today.day <= DAYS.length) p.stepsDone++; g.programme.syncIsland(); g.save.write(); g.ui.toast(`${EVENTS[n].title} marked done.`); } } } },\n  ]);\n  page('Look', [\n    { label: 'Free camera', get: () => (g.rig.free ? 'On' : 'Off'), use: () => { g.rig.free = !g.rig.free; g.rig.freeYaw = 0; g.rig.freePitch = -0.2; } },\n    { label: 'Physics debug lines', get: () => (g.devDebugLines ? 'On' : 'Off'), use: () => toggleDebugLines(g) },\n    { label: 'Stats', get: () => (g.devStats ? 'On' : 'Off'), use: () => toggleStats(g) },\n    { label: 'Input monitor', get: () => (g.devInput ? 'On' : 'Off'), use: () => toggleInputMon(g) },\n    { label: 'Ink', get: () => (g.inkOff ? 'Off' : 'On'), use: () => { g.inkOff = !g.inkOff; g.applyInk(); } },\n    { label: 'Palette', choose: PALETTE_ORDER, state: 'palette', fmt: (p) => p, onChange: (p) => g.palette.set(p, 0.5) },\n  ]);\n  page('Force', [\n    { label: 'Force a gust', use: () => { const e = ev(); if (e && e.lanes[0] && e.lanes[0].bal) { const l = e.lanes[0]; l.devGust = 0.5; forceGust(g, l); g.ui.toast('Whoosh.'); } } },\n    { label: 'Force a fall', use: () => { const e = ev(); if (e && e.forceFall) e.forceFall(0); } },\n    { label: 'Force a fruit', use: () => { const e = ev(); if (e && e.launch) e.launch(e.lanes[0], 'fruit'); else g.ui.toast('Only in Fruit Hat.'); } },\n    { label: 'Force a stone', use: () => { const e = ev(); if (e && e.dropStone) e.dropStone(e.lanes[0]); else g.ui.toast('Only in The Cairn.'); } },\n    { label: 'Speaker', choose: Object.keys(LINES), state: 'who', fmt: (w) => (SPEAKERS[w] ? SPEAKERS[w].name : w) },\n    { label: 'Play a line', use: () => { const w = g.devJump.who; const sits = Object.keys(LINES[w]); const s = sits[Math.floor(g.simTime * 7) % sits.length]; const t = line(w, s, { age: 40, prev: 50, n: 3, pose: 'The Quiet Regret', next: 'Poses', place: 'The Sun Deck' }); g.ui.toast(`${s}: ${t.slice(0, 54)}`); g.audio.say(SPEAKERS[w]?.voice || 'guest', t); } },\n  ]);\n  page('Hear and set', [\n    { label: 'Track', choose: Object.keys(TRACKS), state: 'track', fmt: (x) => x },\n    { label: 'Play that track', use: () => { if (g.audio.seq) { g.audio.seq.resume(); } g.audio.music(g.devJump.track); } },\n    { label: 'Sting', choose: Object.keys(STINGS), state: 'sting', fmt: (x) => x },\n    { label: 'Play that sting', use: () => g.audio.sting(g.devJump.sting) },\n    { label: 'Set Wobble Age', slider: { min: 18, max: 99, step: 1, get: () => (g.save.profile && g.save.profile.today.age) || 60, set: (v) => { const p = g.save.profile; if (p) { p.today.age = v; if (p.ages.length) p.ages[p.ages.length - 1].age = v; else p.ages.push({ day: p.today.day, age: v }); g.save.write(); } } } },\n    { label: 'Add 10 marbles', use: () => { const p = g.save.profile; if (p) { g.programme.addMarbles(10, 'pleasant'); g.save.write(); g.ui.toast(`${p.marbles} marbles.`); } } },\n  ]);\n  page('Save and tuning', [\n    { label: 'Unlock all', use: () => { const p = g.save.profile; if (p) { p.allUnlocked = true; p.levelled = p.levelled; for (const id of Object.keys(EVENTS)) { p.seen[id] = true; p.tiers[id] = 2; } g.save.write(); g.ui.toast('Everything is open.'); } } },\n    { label: 'Reset save', use: () => { g.save.reset(); g.programme.syncIsland(); closeAll(); g.flow.toTitle(); } },\n    { label: 'Copy tuning as JSON', use: () => copyTuning(g) },\n    { label: 'Reset tuning to defaults', use: () => { resetTuning(); g.applyInk(); renderPage(); g.ui.toast('Back to defaults.'); } },\n  ]);\n  for (const grp of Object.keys(groups)) {\n    const keys = groups[grp];\n    for (let i = 0; i < keys.length; i += 6) {\n      const n = Math.floor(i / 6) + 1, many = keys.length > 6;\n      page(`${grp} sliders${many ? ` ${n}` : ''}`, keys.slice(i, i + 6).map((k) => {\n        const d = TUNING[k];\n        return { label: d.label, tune: k, slider: { min: d.min, max: d.max, step: d.step, get: () => tun[k], set: (v) => { tun[k] = v; if (d.group === 'Ink') g.applyInk(); } } };\n      }));\n    }\n  }\n  g.devJump = g.devJump || { evId: 'fruitHat', tier: 0, day: 1, palette: 'dawn', who: 'trudy', track: 'levelBest', sting: 'pleasant' };\n  let scr = null;\n  let renderPage = () => {};\n  const closeAll = () => {\n    while (g.ui.top && (g.ui.top.pauseLayer || g.ui.top.name === 'dev')) g.ui.close(g.ui.top);\n    g.paused = false;\n    if (g.audio.seq) g.audio.seq.resume();\n  };\n  scr = g.ui.open({\n    name: 'dev', className: 'dim',\n    prompts: [['use', 'Choose'], ['page', 'Pages'], ['back', 'Back']],\n    back: () => g.ui.close(scr),\n    build: (s) => {\n      s.pauseLayer = true;\n      const title = h('div.h2', { style: 'margin-top:2rem;font-size:4.6rem' }, 'Dev Mode');\n      const panel = h('div.dev-panel');\n      s.el.append(title, panel);\n      const render = (pg) => {\n        s.page = pg;\n        panel.innerHTML = '';\n        s.clearItems();\n        const p = pages[pg];\n        title.textContent = `Dev Mode: ${p.title}`;\n        for (const it of p.items) {\n          if (it.slider) {\n            const fmt = (v) => (it.slider.step < 0.01 ? v.toFixed(4) : it.slider.step < 1 ? (+v).toFixed(2) : String(Math.round(v)));\n            const el = g.ui.slider(s, it.label, it.slider.get, it.slider.set, { min: it.slider.min, max: it.slider.max, step: it.slider.step, format: fmt });\n            if (it.tune) el.dataset.tune = it.tune;\n            panel.append(el);\n          } else if (it.choose) {\n            const opts = it.choose.map((o) => [o, it.fmt(o)]);\n            panel.append(g.ui.choice(s, it.label, opts, () => g.devJump[it.state], (v) => { g.devJump[it.state] = v; if (it.onChange) it.onChange(v); }));\n          } else {\n            const val = it.get ? h('span.val', it.get()) : null;\n            const el = h('div.toggle', h('span', it.label), val);\n            s.item(el, { use: () => { it.use(); if (val) val.textContent = it.get(); } });\n            panel.append(el);\n          }\n        }\n        s.setFocus(0, true);\n      };\n      renderPage = () => render(s.page);\n      s.pager(pages.length, render);\n      render(0);\n    },\n  });\n  g.line && g.ui.toast(line('trudy', 'dev'), 3);\n  return { ADD, THREE, RAPIER, blankInput };\n}\n\nfunction jumpDay(g, day) {\n  const p = g.save.profile;\n  if (!p) return;\n  let steps = 0;\n  for (let d = 1; d < Math.min(day, 6); d++) steps += DAYS[d - 1].classes.filter(hasEvent).length;\n  p.stepsDone = steps;\n  p.levelled = day > 5;\n  p.tutorialDone = true;\n  p.day = day;\n  p.today = { day, checkin: false, age: null, done: [], question: false };\n  for (let d = 1; d < Math.min(day, 6); d++) for (const id of DAYS[d - 1].classes) p.seen[id] = true;\n  g.programme.syncIsland();\n  g.phys.snapTilt();\n  g.save.write();\n}\nfunction forceGust(g, lane) {\n  const a = g.simTime * 3.1;\n  const left = { v: 0.5 };\n  const prev = g.afterFixed;\n  g.afterFixed = (dt) => {\n    if (prev) prev(dt);\n    if (left.v > 0) { left.v -= dt; if (lane.bal) { lane.bal.extX += Math.cos(a) * 3 * 1; lane.bal.extZ += Math.sin(a) * 3 * 1; } } else g.afterFixed = prev;\n  };\n  g.audio.sfx('gust');\n}\nfunction copyTuning(g) {\n  const json = tuningJSON();\n  const show = () => {\n    let scr = null;\n    scr = g.ui.open({ name: 'tuningJSON', className: 'dim', back: () => g.ui.close(scr), prompts: [['back', 'Back']], build: (s) => { s.pauseLayer = true; s.el.append(h('div.bigtext.tag', json)); } });\n  };\n  try {\n    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(json).then(() => g.ui.toast('Tuning copied.'), show);\n    else show();\n  } catch (e) { show(); }\n}\nfunction toggleStats(g) {\n  g.devStats = !g.devStats;\n  if (g.statsEl) { g.statsEl.remove(); g.statsEl = null; }\n  if (g.devStats) { g.statsEl = h('div.stats', ''); document.getElementById('ui').append(g.statsEl); }\n  installDevFrame(g);\n}\nfunction toggleInputMon(g) {\n  g.devInput = !g.devInput;\n  if (g.inputEl) { g.inputEl.remove(); g.inputEl = null; }\n  if (g.devInput) { g.inputEl = h('div.stats', { style: 'top:auto;bottom:30rem' }, ''); document.getElementById('ui').append(g.inputEl); }\n  installDevFrame(g);\n}\nfunction toggleDebugLines(g) {\n  g.devDebugLines = !g.devDebugLines;\n  if (!g.devDebugLines && g.debugMesh) { g.scene.remove(g.debugMesh); g.debugMesh = null; }\n  if (g.devDebugLines && !g.debugMesh) {\n    const geo = new THREE.BufferGeometry();\n    g.debugMesh = new THREE.LineSegments(geo, new THREE.LineBasicNodeMaterial({ vertexColors: true }));\n    g.debugMesh.frustumCulled = false;\n    g.scene.add(g.debugMesh);\n  }\n  installDevFrame(g);\n}\nfunction installDevFrame(g) {\n  g.devFrame = (dt) => {\n    if (g.statsEl) {\n      const ev = g.currentEvent;\n      const t0 = performance.now();\n      const bodies = ev && ev.world ? ev.world.bodies.len() : g.phys.world.bodies.len();\n      const draws = g.renderer && g.renderer.info ? g.renderer.info.render.drawCalls : 0;\n      g.statsEl.textContent = `fps ${g.loop.fps.toFixed(0)}  step ${(performance.now() - t0).toFixed(1)} ms\\nbodies ${bodies}  draws ${draws}\\nbackend ${g.backend}`;\n    }\n    if (g.inputEl) {\n      const i = g.input, p = i.pads[i.activePad];\n      g.inputEl.textContent = `last ${i.lastDevice}\\nL ${p.axes[0].toFixed(2)},${p.axes[1].toFixed(2)}  R ${p.axes[2].toFixed(2)},${p.axes[3].toFixed(2)}\\nL2 ${p.val[6].toFixed(2)}  R2 ${p.val[7].toFixed(2)}`;\n    }\n    if (g.debugMesh) {\n      const w = (g.currentEvent && g.currentEvent.world) || g.phys.world;\n      const b = w.debugRender();\n      const geo = g.debugMesh.geometry;\n      geo.setAttribute('position', new THREE.BufferAttribute(b.vertices.slice(), 3));\n      geo.setAttribute('color', new THREE.BufferAttribute(b.colors.slice(), 4));\n      const ev = g.currentEvent;\n      if (ev) g.debugMesh.position.copy(ev.group.position); else g.debugMesh.position.set(0, 0, 0);\n    }\n    if (g.rig.free) {\n      const i = g.input, p = i.pads[i.activePad];\n      const dev = i.lastDevice === 'pad';\n      g.rig.freeMove(dt, dev ? p.axes[0] : (i.keyX || 0), dev ? p.axes[1] : (i.keyZ || 0), dev ? p.axes[2] : i.dragX * 0.3, dev ? p.axes[3] : i.dragY * 0.3);\n    }\n  };\n}\nEOF\ncat > src/game/groupclass.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { SEAT_COLOURS } from '../data/config.js';\nimport { EVENTS, DISCIPLINE_ORDER } from '../data/events.js';\nimport { hasEvent } from '../events/index.js';\nimport { EventRun } from './eventRun.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { Doll } from '../art/doll.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { BTN } from '../input/input.js';\nimport { line } from '../data/dialogue.js';\nimport { rng } from '../core/rng.js';\nimport { showResults } from './results.js';\nimport { RED, TEAL, CREAM } from '../art/props.js';\n\nconst POINTS = [4, 3, 2, 1];\nconst NAMES = ['Mat One', 'Mat Two', 'Mat Three', 'Mat Four'];\n\n/** Up to four on one TV. Lobby, playlist, classes in lanes, podium. */\nexport class GroupClass {\n  constructor(game) {\n    this.game = game; this.name = 'group'; this.canPause = false;\n    this.seats = [null, null, null, null]; this.stage = 'lobby'; this.points = [0, 0, 0, 0]; this.playlist = []; this.sub = null; this.t = 0;\n  }\n  enter() {\n    const g = this.game;\n    g.setIsland('home');\n    g.ui.clear();\n    g.palette.set('golden', 1);\n    g.programme.syncIsland();\n    g.phys.setRest(g.programme.restDeg());\n    g.rig.shot(14, 7, 44, 14, 2, -11, { fov: 38, rate: 2, snap: true });\n    g.audio.music('levelBest');\n    this.lobby();\n    g.speech.say('trudy', line('trudy', 'group_intro'), { auto: 3.6 });\n  }\n  lobby() {\n    const g = this.game;\n    this.stage = 'lobby';\n    this.scr = g.ui.only({\n      name: 'lobby', passive: true,\n      build: (s) => {\n        s.el.append(h('div.h1', { style: 'margin-top:3rem' }, 'Group Class'));\n        this.matsEl = h('div.mats', { style: 'margin-top:3rem' });\n        this.hintEl = h('div.tag', { style: 'margin-top:3rem;font-size:3.6rem' }, '');\n        s.el.append(this.matsEl, this.hintEl);\n        this.renderMats();\n      },\n    });\n  }\n  renderMats() {\n    const g = this.game, dev = g.input.lastDevice, set = g.save.settings.glyphs;\n    this.matsEl.innerHTML = '';\n    this.seats.forEach((seat, i) => {\n      const el = h('div.mat', { style: seat ? `background:${SEAT_COLOURS[i]};color:#fff;text-shadow:.15rem .15rem 0 #1A1420` : '' });\n      el.dataset.seat = String(i);\n      el.append(h('div', { style: 'font-size:4rem;font-weight:600' }, seat ? seat.name : 'Empty'));\n      el.append(h('div', seat ? (seat.source === 'kbm' ? 'Keys and mouse' : `Controller ${seat.pad + 1}`) : 'Join in'));\n      el.style.pointerEvents = 'auto'; el.style.cursor = 'pointer';\n      el.addEventListener('click', () => { g.input.clickQueue.push(() => this.joinKbm()); });\n      this.matsEl.append(el);\n    });\n    const joined = this.seats.filter(Boolean).length;\n    this.hintEl.innerHTML = `${promptHTML('join', 'Join', dev, set)} ${promptHTML('back', 'Leave', dev, set)} ${joined ? `<span style=\"margin-left:2rem\">${joined} here. Join again to begin.</span>` : ''}`;\n  }\n  joinKbm() {\n    const seats = this.seats;\n    if (seats.some((s) => s && s.source === 'kbm')) { this.toPlaylist(); return; }\n    const i = seats.findIndex((s) => !s);\n    if (i < 0) return;\n    seats[i] = { source: 'kbm', name: NAMES[i], pad: -1 };\n    this.game.audio.sfx('uiConfirm');\n    this.renderMats();\n  }\n  joinPad(p) {\n    const seats = this.seats;\n    if (seats.some((s) => s && s.pad === p)) { this.toPlaylist(); return; }\n    const i = seats.findIndex((s) => !s);\n    if (i < 0) return;\n    seats[i] = { source: `pad:${p}`, name: NAMES[i], pad: p };\n    this.game.audio.sfx('uiConfirm');\n    this.renderMats();\n  }\n  leave(match) {\n    const seats = this.seats;\n    const i = seats.findIndex(match);\n    if (i >= 0) { seats[i] = null; this.game.audio.sfx('uiBack'); this.renderMats(); return true; }\n    return false;\n  }\n  lobbyInput() {\n    const g = this.game, inp = g.input;\n    for (const pad of inp.pads) {\n      if (!pad.connected) continue;\n      if (pad.edge[BTN.cross]) this.joinPad(pad.index);\n      if (pad.edge[BTN.circle]) { if (!this.leave((s) => s && s.pad === pad.index) && !this.seats.some(Boolean)) { this.back(); return; } }\n    }\n    if (inp.pressed.has('enter')) this.joinKbm();\n    if (inp.pressed.has('escape') || inp.pressed.has('backspace')) { if (!this.leave((s) => s && s.source === 'kbm') && !this.seats.some(Boolean)) this.back(); }\n  }\n  back() { const g = this.game; g.go(() => (g.save.profile && g.modeReturnIsland ? g.flow.toIsland({}) : g.flow.toMenu())); }\n  fixed(dt) {\n    const g = this.game;\n    this.t += dt;\n    if (this.stage === 'lobby') { g.stepIsland(dt, 0); if (!g.wiping && this.stage === 'lobby' && !g.speech.line?.blocking) this.lobbyInput(); return; }\n    if (this.stage === 'menu' || this.stage === 'podium') { g.stepIsland(dt, 0); }\n    if (this.sub) this.sub.fixed(dt);\n    if (this.stage === 'podium') this.podiumStep(dt);\n  }\n  frame(dt) {\n    const g = this.game;\n    if (this.stage === 'lobby' || this.stage === 'menu') { g.syncIsland(dt); }\n    if (this.sub) this.sub.frame(dt);\n    if (this.stage === 'podium') this.podiumFrame(dt);\n  }\n  toPlaylist() {\n    const g = this.game;\n    this.stage = 'menu';\n    g.ui.only({\n      name: 'playlist', prompts: [['use', 'Choose'], ['back', 'Back']], back: () => this.lobby(),\n      build: (s) => {\n        s.el.append(h('div.h2', { style: 'margin-top:8rem' }, 'What shall we do?'));\n        const col = h('div.col', { style: 'margin-top:3rem' });\n        s.el.append(col);\n        col.append(s.item(h('div', 'Quick Class (three random)'), { use: () => this.quick() }));\n        col.append(s.item(h('div', 'Pick three'), { use: () => this.pick() }));\n      },\n    });\n  }\n  couchIds() { return Object.keys(EVENTS).filter((id) => EVENTS[id].couch && hasEvent(id)); }\n  quick() {\n    const r = rng('groupclass'), pool = this.couchIds(), out = [];\n    while (out.length < 3 && pool.length) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n    this.playlist = out;\n    this.runNext();\n  }\n  pick() {\n    const g = this.game;\n    const ids = this.couchIds();\n    const chosen = [];\n    const pages = [];\n    for (let i = 0; i < ids.length; i += 6) pages.push(ids.slice(i, i + 6));\n    g.ui.only({\n      name: 'pick', prompts: [['use', 'Choose'], ['page', 'Pages'], ['back', 'Back']], back: () => this.toPlaylist(),\n      build: (s) => {\n        const title = h('div.h2', { style: 'margin-top:6rem' }, 'Pick three');\n        const box = h('div.dev-grid', { style: 'margin-top:2rem' });\n        const left = h('div.tag', { style: 'margin-top:2rem;font-size:3.4rem' }, '0 of 3');\n        s.el.append(title, box, left);\n        const render = (pg) => {\n          box.innerHTML = '';\n          s.clearItems();\n          for (const id of pages[pg]) {\n            const el = h('div', EVENTS[id].title + (chosen.includes(id) ? ' ✓' : ''));\n            box.append(s.item(el, { use: () => {\n              if (chosen.includes(id)) chosen.splice(chosen.indexOf(id), 1); else chosen.push(id);\n              el.textContent = EVENTS[id].title + (chosen.includes(id) ? ' ✓' : '');\n              left.textContent = `${chosen.length} of 3`;\n              if (chosen.length >= 3) { this.playlist = chosen.slice(0, 3); this.runNext(); }\n            } }));\n          }\n          s.setFocus(0, true);\n        };\n        if (pages.length > 1) s.pager(pages.length, render);\n        render(0);\n      },\n    });\n  }\n  lanes() {\n    return this.seats.map((s, i) => (s ? { kind: 'local', name: s.name, colour: SEAT_COLOURS[i], source: s.source, seat: i } : null)).filter(Boolean);\n  }\n  runNext() {\n    const g = this.game;\n    if (!this.playlist.length) { g.go(() => this.podium()); return; }\n    const id = this.playlist.shift();\n    const self = this;\n    g.go(() => {\n      g.ui.clear();\n      self.stage = 'event';\n      if (self.sub) { self.sub.exit(); self.sub = null; }\n      self.sub = new EventRun(g, {\n        id, tier: 0, lanes: self.lanes(), mode: 'group',\n        onResult: function* onResult(ev, results) {\n          const sorted = results.filter((r) => r.lane.kind === 'local').sort((a, b) => b.form - a.form);\n          sorted.forEach((r, i) => { self.points[r.lane.seat] += POINTS[i] ?? 0; });\n          let done = false;\n          const winner = sorted[0];\n          const list = h('div.col', sorted.map((r, i) => h('div.tag', { style: `font-size:3.6rem;border-color:${r.lane.colour}` }, `${i + 1}. ${r.lane.name}: ${Math.round(r.form)} · +${POINTS[i] ?? 0}`)));\n          showResults(g, { ev, result: winner, title: ev.data.title, onContinue: () => { done = true; }, extra: list });\n          yield () => done;\n          g.ui.clear();\n          self.runNext();\n        },\n      });\n      self.sub.enter();\n      self.ev = self.sub.ev;\n    });\n  }\n  podium() {\n    const g = this.game;\n    if (this.sub) { this.sub.exit(); this.sub = null; }\n    this.ev = null;\n    this.stage = 'podium';\n    g.ui.clear();\n    g.setIsland('far', 40, -120);\n    g.sea.setLevel(-3);\n    g.palette.set('golden', 1);\n    g.audio.sting('exemplary');\n    g.audio.music('levelBest');\n    const order = this.seats.map((s, i) => (s ? { i, name: s.name, pts: this.points[i] } : null)).filter(Boolean).sort((a, b) => b.pts - a.pts);\n    const set = this.podiumSet = G('podium');\n    add(set, M(geo.cyl(10, 11, 1, 28), 0x8CCB6A, 0, -0.5, 0));\n    const heights = [2.1, 1.4, 0.9, 0.5];\n    const xs = [0, -2.3, 2.3, 4.5];\n    const cols = [0xF5B700, 0xBFC6CF, 0xC78B4A, CREAM];\n    const blocks = this.blocks = [];\n    this.dolls = [];\n    order.forEach((o, k) => {\n      const b = M(geo.box(2.2, heights[k], 2.2), cols[k], xs[k], heights[k] / 2, 0);\n      set.add(b);\n      blocks.push(b);\n      const d = new Doll({ shirt: SEAT_COLOURS[o.i] });\n      d.flatFeet = false;\n      d.root.position.set(xs[k], heights[k], 0);\n      d.rig.loop(k === 0 ? 'cheer' : 'clap');\n      set.add(d.root);\n      this.dolls.push({ d, k, h: heights[k], x: xs[k], vy: 0, fell: false });\n    });\n    g.scene.add(set);\n    g.focus(0, 0, 0, 14);\n    g.rig.shot(0, 4, 13, 0, 2.2, 0, { fov: 38, rate: 2, snap: true });\n    this.podT = 0;\n    g.speech.say('trudy', line('trudy', 'podium'), { auto: 4 });\n    g.ui.only({\n      name: 'podium', prompts: [['use', 'Back to the menu']],\n      build: (s) => {\n        s.el.append(h('div.h1', { style: 'margin-top:2rem' }, 'Podium'));\n        s.el.append(h('div.col', order.map((o, k) => h('div.podium-line.tag', { style: 'position:absolute;right:9rem;top:' + (22 + k * 8) + 'rem;font-size:4rem' }, `${k + 1}. ${o.name}: ${o.pts}`))));\n        s.el.append(s.item(h('div', { style: 'position:absolute;bottom:12rem' }, 'Back to the menu'), { use: () => g.go(() => g.flow.toMenu()) }));\n      },\n    });\n  }\n  podiumStep(dt) {\n    this.podT += dt;\n    if (this.podT > 5 && !this.tipped) {\n      // It tips over. Of course it does.\n      this.tipped = true;\n      this.game.audio.sfx('fall');\n      this.game.comic.pop('CLACK!', 0, 3.4, 0);\n      this.game.rig.shake(0.1);\n    }\n  }\n  podiumFrame(dt) {\n    const k = this.tipped ? Math.min(1, (this.podT - 5) / 1.2) : 0;\n    if (this.podiumSet) {\n      for (const b of this.blocks) { b.rotation.z = -k * k * 0.9; b.position.x += 0; }\n      for (const o of this.dolls) {\n        if (this.tipped && !o.fell) { o.fell = true; o.d.rig.loop('flop'); }\n        if (o.fell) { o.d.root.position.y = Math.max(0.05, o.h * (1 - k * k)); o.d.root.position.x = o.x + k * k * 2.5; o.d.root.rotation.z = -k * 1.2; }\n        o.d.update(dt);\n      }\n    }\n  }\n  exit() {\n    const g = this.game;\n    if (this.sub) { this.sub.exit(); this.sub = null; }\n    if (this.podiumSet) { g.scene.remove(this.podiumSet); this.podiumSet = null; }\n    g.ui.clear();\n    g.speech.clear();\n  }\n}\nexport { DISCIPLINE_ORDER, RED, TEAL };\nEOF\ncat > src/game/session.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { SESSION_SET, EVENTS } from '../data/events.js';\nimport { EventRun } from './eventRun.js';\nimport { Doll } from '../art/doll.js';\nimport { useSessionStreams, rng } from '../core/rng.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { BTN } from '../input/input.js';\nimport { hasEvent } from '../events/index.js';\nimport { TITLE, GOAL, medalFor } from '../data/config.js';\nimport { clipIndex, clipName, GHOST_CLIPS } from './ghost.js';\nimport { openSessionOptions } from '../ui/screens/sessionOptions.js';\nimport { installPause } from '../ui/screens/pause.js';\n\nconst INTRO = 6, PLAY = 50, SCORE = 6, SLOT = INTRO + PLAY + SCORE;\nconst AWARDS = ['Suspiciously Still', 'Consistently Floored', 'Mostly Upright', 'Politely Attending'];\n\n/** A round in the AI Hub: three classes, on the hub's clock, with everyone else as ghosts in the next lanes. */\nexport function runSession(game, info) {\n  const AIHub = window.AIHub;\n  game.inSession = true;\n  useSessionStreams(true);\n  installPause(game);\n  game.flow = { leaveClass() {}, toTitle() {} };\n  const sess = new SessionMode(game, AIHub, info);\n  game.setMode(sess, 'session');\n  AIHub.ready();\n  return sess;\n}\n\nclass SessionMode {\n  constructor(game, hub, info) {\n    this.game = game; this.hub = hub; this.info = info; this.name = 'session'; this.canPause = false;\n    this.card = null; this.started = false; this.slot = -1; this.total = 0; this.scores = []; this.resultSent = false; this.ended = false; this.falls = 0; this.best = 0;\n    this.lastProgress = -9; this.lastSend = -9; this.ghosts = new Map(); this.options = false; this.run = null; this.lastT = 0; this.cardEl = null;\n    this.me = info.me;\n  }\n  enter() {\n    const { game, hub } = this;\n    this.slots = this.deal();\n    hub.on('card', (c) => { this.card = c; this.renderCard(); });\n    hub.on('start', () => { this.started = true; });\n    hub.on('message', (d, from) => this.onMessage(d, from));\n    hub.on('leave', (l) => this.onLeave(l));\n    hub.on('time-up', () => this.finish());\n    hub.on('end', () => this.onEnd());\n    game.ui.clear();\n    this.stageSet();\n    this.renderCard();\n  }\n  deal() {\n    const r = rng('deal');\n    const pool = SESSION_SET.filter(hasEvent).slice(), out = [];\n    while (out.length < 3 && pool.length) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n    return out;\n  }\n  /** The class lined up on the deck, Trudy with a clipboard, the music. */\n  stageSet() {\n    const g = this.game;\n    g.setIsland('home');\n    g.palette.set('dawn', 0.5);\n    g.programme.syncIsland();\n    g.phys.snapTilt();\n    g.audio.music('levelBest');\n    g.art.trudy.root.position.set(14, 0.52, 0);\n    g.art.trudy.rig.loop('clipboard');\n    this.cardDolls = this.info.players.map((p, i) => {\n      const d = new Doll({ shirt: p.color });\n      d.root.position.set(15 + (i - (this.info.players.length - 1) / 2) * 1.6, 0.54, -3);\n      d.rig.loop('breathe');\n      g.art.group.add(d.root);\n      return d;\n    });\n    g.rig.shot(15, 3.5, 7.4, 15, 1.2, -3, { fov: 38, snap: true });\n  }\n  clearCardSet() {\n    if (!this.cardDolls) return;\n    for (const d of this.cardDolls) this.game.art.group.remove(d.root);\n    this.cardDolls = null;\n    if (this.cardScr) { this.game.ui.close(this.cardScr); this.cardScr = null; }\n  }\n  renderCard() {\n    const { game, card, info } = this;\n    if (this.started && this.time() >= 0) return;\n    if (!this.cardScr) {\n      this.cardScr = game.ui.open({\n        name: 'card', passive: true,\n        build: (s) => {\n          this.cardRoot = h('div.card-session');\n          s.el.append(this.cardRoot);\n          s.el.style.pointerEvents = 'none';\n        },\n      });\n    }\n    const root = this.cardRoot;\n    root.innerHTML = '';\n    root.append(h('div.h1', { style: 'margin:0' }, TITLE));\n    const seats = h('div.row');\n    const ready = (card && card.ready) || [];\n    info.players.forEach((p) => {\n      const seat = h('span.seat', h('i', { style: `background:${p.color}` }), document.createTextNode(p.name), ready.includes(p.id) ? h('b', ' ✓') : null);\n      seats.append(seat);\n    });\n    root.append(seats);\n    root.append(h('div.tag', { style: 'font-size:3.6rem' }, GOAL));\n    const dev = game.input.lastDevice, set = game.save.settings.glyphs;\n    const row = h('div.row', { html: [['lean', 'Lean'], ['feet', 'Feet'], ['flail', 'Flail'], ['hop', 'Hop']].map(([v, t]) => promptHTML(v, t, dev, set)).join('') });\n    root.append(row);\n    let timeText = '...';\n    if (card) {\n      if (card.starting) timeText = 'Starting...';\n      else if (card.paused) timeText = 'Paused';\n      else if (card.left !== null && card.left !== undefined) timeText = `${Math.ceil(card.left / 1000)} s`;\n    }\n    root.append(h('div.tag', { style: 'font-size:4.4rem;font-weight:700' }, timeText));\n    const act = h('div.row');\n    const rd = h('div.item', { style: 'pointer-events:auto' }, h('span', { html: promptHTML('use', 'Ready', dev, set) }));\n    rd.addEventListener('click', () => this.hub.answer('ready'));\n    const more = h('div.item', { style: 'pointer-events:auto' }, h('span', { html: promptHTML('more', card && card.asked ? 'Take back' : 'More time', dev, set) }));\n    more.addEventListener('click', () => this.hub.answer('more'));\n    act.append(rd, more);\n    root.append(act);\n  }\n  time() { return this.hub.time(); }\n  cardInput() {\n    const { game, hub } = this;\n    const inp = game.input;\n    if (inp.pressed.has('enter') || inp.pads.some((p) => p.connected && p.edge[BTN.cross])) hub.answer('ready');\n    if (inp.pressed.has('m') || inp.pads.some((p) => p.connected && p.edge[BTN.triangle])) hub.answer('more');\n  }\n  fixed(dt) {\n    if (this.ended) return;\n    const { game } = this;\n    const T = this.time();\n    if (T === -Infinity || T < -3.5e3 || !this.started) {\n      this.cardInput();\n      game.stepIsland(dt, 0);\n      return;\n    }\n    const sec = T / 1000;\n    if (sec < 0) {\n      this.cardInput();\n      game.stepIsland(dt, 0);\n      const c = Math.ceil(-sec);\n      if (c !== this.lastCount) { this.lastCount = c; game.hud.show(true); game.hud.flash(String(c), 0.7); game.audio.sfx('metronome', { vel: 1 }); }\n      return;\n    }\n    if (this.cardDolls) { this.clearCardSet(); game.ui.clear(); }\n    const slot = Math.floor(sec / SLOT);\n    const local = sec - slot * SLOT;\n    if (slot >= this.slots.length) { this.finish(); if (this.run) this.closeRun(); this.waiting(); return; }\n    if (slot !== this.slot) this.enterSlot(slot);\n    const stage = local < INTRO ? 'intro' : local < INTRO + PLAY ? 'play' : 'score';\n    if (stage !== this.stageName) this.enterStage(stage);\n    if (this.run) this.run.ev.fixed(dt);\n    this.net(sec);\n    if (!this.options && game.input.verb('pause')) { this.options = true; openSessionOptions(game, () => { this.options = false; }); }\n  }\n  enterSlot(slot) {\n    const { game, info } = this;\n    this.closeRun();\n    this.slot = slot;\n    this.stageName = null;\n    const id = this.slots[slot];\n    const data = EVENTS[id];\n    const meSeat = info.players.findIndex((p) => p.id === info.me);\n    const lanes = [{ kind: 'local', name: info.players[meSeat]?.name || 'You', colour: info.players[meSeat]?.color || '#2CB5A0', source: 'any', playerId: info.me }];\n    for (const p of info.players) if (p.id !== info.me && !this.gone?.has(p.id)) lanes.push({ kind: 'ghost', name: p.name, colour: p.color, playerId: p.id });\n    this.run = new EventRun(game, { id, tier: 0, lanes, mode: 'session', config: data.sessionConfig, skipIntro: true, skipCountdown: true, onResult: function* none() { /* The session reports at the end. */ } });\n    // The session owns the timeline: build the set and hold it for the intro.\n    this.run.enter();\n    this.run.handle.cancel();\n    this.run.handle = null;\n    this.ghosts = new Map();\n    game.hud.setScore(this.total, 'Score');\n    this.ghostTags();\n  }\n  ghostTags() {\n    const { game } = this;\n    if (this.tagLayer) this.tagLayer.remove();\n    this.tagLayer = h('div', { style: 'position:absolute;inset:0;pointer-events:none' });\n    game.hud.el.append(this.tagLayer);\n    for (const lane of this.run.ev.lanes) {\n      if (lane.kind !== 'ghost') continue;\n      const tag = h('div.seat', { style: 'position:absolute;transform:translate(-50%,-120%);font-size:3rem' });\n      tag.append(document.createTextNode(lane.name));\n      this.tagLayer.append(tag);\n      lane.tagEl = tag;\n      lane.doll.root.visible = false;\n      lane.net = null;\n    }\n  }\n  enterStage(stage) {\n    const { game } = this;\n    const ev = this.run.ev;\n    this.stageName = stage;\n    if (stage === 'intro') {\n      ev.phase = 'intro';\n      game.hud.show(false);\n      this.introScr = game.ui.only({\n        name: 'slotIntro', passive: true,\n        build: (s) => {\n          const d = ev.data;\n          const box = h('div.tag', { style: 'margin-top:16rem;max-width:140rem;text-align:center' });\n          box.append(h('div', { style: 'font-size:7rem;font-weight:700' }, d.title), h('div', { style: 'font-size:3.8rem' }, d.line), h('div.row', { html: d.verbs.map(([v, t]) => promptHTML(v, t, game.input.lastDevice, game.save.settings.glyphs)).join(''), style: 'margin-top:1.6rem' }));\n          s.el.append(h('div.h2', `Class ${this.slot + 1} of ${this.slots.length}`), box);\n        },\n      });\n      game.audio.music(ev.data.music, ev.musicOpts ? ev.musicOpts() : {});\n    } else if (stage === 'play') {\n      if (this.introScr) { game.ui.close(this.introScr); this.introScr = null; }\n      game.hud.show(true);\n      ev.begin();\n      game.audio.sfx('bell');\n    } else {\n      const r = ev.laneResult(ev.lanes[0]);\n      const pts = Math.round(Math.max(0, r.form) * 10);\n      this.scores[this.slot] = pts;\n      this.total = this.scores.reduce((a, b) => a + (b || 0), 0);\n      this.falls += ev.lanes[0].falls || 0;\n      this.best = Math.max(this.best, r.form);\n      ev.phase = 'done';\n      game.audio.sfx('whistle');\n      game.hud.show(false);\n      const m = medalFor(r.form);\n      game.audio.sting(m.id);\n      this.scoreScr = game.ui.only({ name: 'slotScore', passive: true, build: (s) => {\n        s.el.append(h('div.h2', { style: 'margin-top:18rem' }, ev.data.title), h('div.bignum', String(pts)), h('div.tag', { style: 'font-size:3.6rem' }, `${m.name} · Total ${this.total}`));\n      } });\n    }\n  }\n  closeRun() {\n    if (this.run) {\n      const { game } = this;\n      if (this.scoreScr) { game.ui.close(this.scoreScr); this.scoreScr = null; }\n      if (this.introScr) { game.ui.close(this.introScr); this.introScr = null; }\n      if (this.tagLayer) { this.tagLayer.remove(); this.tagLayer = null; }\n      this.run.exit();\n      this.run = null;\n    }\n  }\n  scoreNow() {\n    if (this.run && this.stageName === 'play') {\n      const r = this.run.ev.laneResult(this.run.ev.lanes[0]);\n      return this.total + Math.round(Math.max(0, r.form) * 10);\n    }\n    return this.total;\n  }\n  net(sec) {\n    const { hub } = this;\n    if (sec - this.lastSend >= 0.1) {\n      this.lastSend = sec;\n      const lane = this.run && this.run.ev.lanes[0];\n      const b = lane && lane.bal;\n      const data = {\n        t: 'g', a: this.slot, x: lane ? +lane.doll.root.position.x.toFixed(2) : 0, z: lane ? +lane.doll.root.position.z.toFixed(2) : 0,\n        lx: b ? +b.leanX.toFixed(3) : 0, lz: b ? +b.leanZ.toFixed(3) : 0, c: lane ? clipIndex(lane.doll.rig.currentName) : 0, f: lane && lane.fallen ? 1 : 0, s: this.scoreNow(),\n      };\n      hub.send(data, { reliable: false });\n    }\n    if (sec - this.lastProgress >= 1) {\n      this.lastProgress = sec;\n      const name = this.run ? this.run.ev.data.title : TITLE;\n      hub.progress({ score: this.scoreNow(), label: `${name} ${this.scoreNow()}` });\n    }\n  }\n  onMessage(d, from) {\n    if (!d || d.t !== 'g' || !this.run) return;\n    const lane = this.run.ev.lanes.find((l) => l.kind === 'ghost' && l.laneSpecId === undefined && this.laneFor(l) === from);\n    if (!lane) return;\n    if (d.a !== this.slot) { lane.doll.root.visible = false; lane.net = null; return; }\n    const now = this.time() / 1000;\n    if (!lane.net) lane.net = { prev: d, next: d, t0: now, t1: now + 0.1 };\n    else { lane.net.prev = lane.net.next; lane.net.next = d; lane.net.t0 = now; lane.net.t1 = now + 0.15; }\n    lane.doll.root.visible = true;\n  }\n  laneFor(lane) { return lane.ev.laneSpecs[lane.id].playerId; }\n  onLeave(l) {\n    this.gone = this.gone || new Set();\n    this.gone.add(l.id);\n    if (!this.run) return;\n    const lane = this.run.ev.lanes.find((x) => x.kind === 'ghost' && this.laneFor(x) === l.id);\n    if (lane) { lane.doll.root.visible = false; if (lane.tagEl) lane.tagEl.remove(); lane.gone = true; }\n  }\n  frame(dt) {\n    const { game } = this;\n    if (this.ended) return;\n    if (this.cardDolls) { game.syncIsland(dt); for (const d of this.cardDolls) d.update(dt); game.art.trudy.update(dt); }\n    if (!this.run) return;\n    const ev = this.run.ev;\n    ev.frame(dt);\n    const now = this.time() / 1000;\n    for (const lane of ev.lanes) {\n      if (lane.kind !== 'ghost' || lane.gone) continue;\n      const n = lane.net;\n      if (!n) continue;\n      const k = Math.max(0, Math.min(1, (now - n.t0) / Math.max(0.01, n.t1 - n.t0)));\n      const lx = n.prev.lx + (n.next.lx - n.prev.lx) * k, lz = n.prev.lz + (n.next.lz - n.prev.lz) * k;\n      const px = n.prev.x + (n.next.x - n.prev.x) * k, pz = n.prev.z + (n.next.z - n.prev.z) * k;\n      // Their copy has its own lane at x = 0 or its own spot: show them beside you, in the next lane.\n      lane.doll.root.position.set(lane.x + (px - (n.prev.x)), 0, pz);\n      lane.doll.root.rotation.set(lz, 0, -lx);\n      const clip = n.next.f ? 'flop' : clipName(n.next.c);\n      if (lane.doll.rig.currentName !== clip) lane.doll.rig.loop(clip);\n      lane.doll.update(dt);\n      if (lane.tagEl) {\n        const p = lane.doll.root.position.clone(); p.y += 2.1;\n        p.project(game.camera);\n        lane.tagEl.style.left = `${(p.x * 0.5 + 0.5) * 100}%`;\n        lane.tagEl.style.top = `${(-p.y * 0.5 + 0.5) * 100}%`;\n      }\n    }\n    game.hud.setScore(this.scoreNow(), 'Score');\n  }\n  /** Once, at the end or on time-up. Grace is 5 s. */\n  finish() {\n    if (this.resultSent) return;\n    this.resultSent = true;\n    const score = this.scoreNow();\n    const stats = { 'Floor Exercises': this.falls, 'Best medal': medalFor(this.best).name };\n    const award = this.falls === 0 && this.best >= 85 ? AWARDS[0] : this.falls > 3 ? AWARDS[1] : this.best >= 40 ? AWARDS[2] : AWARDS[3];\n    this.hub.result({ score, stats, awards: [{ title: award, detail: `${TITLE} says so.` }] });\n  }\n  waiting() {\n    const { game } = this;\n    if (this.waitScr) return;\n    game.hud.show(false);\n    this.waitScr = game.ui.only({ name: 'waiting', passive: true, build: (s) => {\n      s.el.append(h('div.h2', { style: 'margin-top:26rem' }, 'Waiting for the others'), h('div.tag', { style: 'font-size:3.8rem' }, 'Trudy is counting. She says she is not.'));\n    } });\n    game.setIsland('home');\n    game.rig.shot(15, 6, 28, 8, 1, -2, { fov: 38, rate: 1 });\n  }\n  /** Stop input, sending and all sound, and keep the last frame. */\n  onEnd() {\n    const { game } = this;\n    this.ended = true;\n    game.audio.stopMusic(0.05);\n    game.audio.silence();\n    game.speech.clear();\n    game.ui.clear();\n    game.hud.show(false);\n    game.mode = null;\n  }\n  botDrive() { return null; }\n}\nexport { GHOST_CLIPS };\nEOF\ncat > src/game/ghost.js <<'EOF'\n// Ghost lanes play clips by index, sent over the wire. They never touch anyone's physics.\nexport const GHOST_CLIPS = ['idle', 'breathe', 'holdSlab', 'squat', 'hipCircle', 'stepL', 'stepR', 'diveReady', 'spread', 'tuck', 'pike', 'flail', 'hop', 'land', 'pose0', 'pose1', 'pose2', 'pose3', 'pose4', 'pose5', 'pose6', 'pose7', 'stand', 'flop'];\nexport const clipIndex = (name) => Math.max(0, GHOST_CLIPS.indexOf(name));\nexport const clipName = (i) => GHOST_CLIPS[i] || 'idle';\nEOF\ncat > src/ui/screens/sessionOptions.js <<'EOF'\nimport { h } from '../dom.js';\n\n/** In a session, Options opens volumes only, and it doesn't pause. */\nexport function openSessionOptions(game, onClose) {\n  const set = game.save.settings;\n  const save = () => { game.save.write(); game.applySettings(); };\n  let scr = null;\n  const close = () => { game.ui.close(scr); onClose(); };\n  scr = game.ui.open({\n    name: 'sessionOptions', prompts: [['back', 'Back']], back: close,\n    build: (s) => {\n      s.el.append(h('div.h2', { style: 'margin-top:10rem' }, 'Volumes'));\n      const col = h('div.col');\n      s.el.append(col);\n      col.append(game.ui.slider(s, 'Music', () => set.music, (v) => { set.music = v; save(); }));\n      col.append(game.ui.slider(s, 'Sound', () => set.sound, (v) => { set.sound = v; save(); }));\n      col.append(game.ui.slider(s, 'Voice', () => set.voice, (v) => { set.voice = v; save(); }));\n    },\n  });\n}\nEOF\nnode tools/build.mjs -v 2>&1 | tail -30","description":"Write Check-In, ending, attract, dev mode, group class and session","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":27324,"cache_read_input_tokens":443034,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":27324},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"98724ac4-81b7-4726-b8ca-8ee3bb64ef8d","timestamp":"2026-11-05T12:39:34.453Z","request_id":"req_011CgjnpdjuQyG4aRko9uxxv","wire_tool_inputs":{"toolu_011WmvbrTaZfNzmHTRTyHski":{"command":"cat > src/game/checkin.js <<'EOF'\nimport { EventBase } from '../events/base.js';\nimport { TESTS } from '../data/programme.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { Trudy } from '../art/cast.js';\nimport { paintColour } from '../art/doll.js';\nimport { h } from '../ui/dom.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { line } from '../data/dialogue.js';\nimport { refreshJarDisplay } from './jar.js';\n\nconst clamp01 = (x) => Math.max(0, Math.min(1, x));\nconst DIRS = [[-1, 0, 'left'], [1, 0, 'right'], [0, -1, 'forward'], [0, 1, 'back']];\n\n/** Three short tests on a round mat with Trudy. Each scores 0 to 1. */\nclass CheckInEvent extends EventBase {\n  static id = 'checkin';\n  constructor(spec) {\n    super({ ...spec, data: { title: 'The Check-In', instructor: 'trudy', verbs: [['lean', 'Lean']], music: 'island', tiers: [{}] } });\n    this.seaLevel = -6.4; this.tests = spec.tests; this.god = false;\n    this.idx = -1; this.cur = null; this.scores = {}; this.allDone = false; this.testT = 0;\n  }\n  setupLane(lane) { lane.doll.rig.loop('breathe'); }\n  buildSet() {\n    const g = this.group;\n    add(g, M(geo.cyl(5, 5.4, 0.6, 36), 0x8CCB6A, 0, -0.32, 0), M(geo.cyl(2.2, 2.2, 0.04, 40), 0xC24D6A, 0, 0.01, 0), M(geo.tor(2.2, 0.05, Math.PI * 2, 48), 0xFFF3DC, 0, 0.03, 0, { rot: [Math.PI / 2, 0, 0], shadow: false }));\n    this.trudy = new Trudy();\n    this.trudy.root.position.set(-1.9, 0, 0.6);\n    this.trudy.root.rotation.y = 0.8;\n    this.trudy.root.scale.setScalar(1.25);\n    g.add(this.trudy.root);\n    this.game.setBackdrop(35, -110);\n    this.game.sea.setLevel(this.seaLevel);\n  }\n  cameraShot(snap) { this.game.rig.shot(0.6, 2.2, 7, -0.25, 1, 0, { snap, rate: 4 }); this.inputYaw = Math.atan2(0.85, 7); }\n  hudSetup(hud) {\n    this.howEl = h('div.tag', { style: 'position:absolute;top:14rem;left:50%;transform:translateX(-50%) rotate(-.5deg);font-size:4.6rem;font-weight:600;text-align:center;max-width:130rem' }, '');\n    hud.el.append(this.howEl);\n    this.barEl = h('div', { style: 'position:absolute;top:27rem;left:50%;width:96rem;height:6rem;margin-left:-48rem;background:#FFF4DC;border:.6rem solid #1A1420;border-radius:3rem;overflow:hidden;display:none' });\n    this.barFill = h('div', { style: 'position:absolute;top:0;bottom:0;background:#6FB7D6' });\n    this.barGoal = h('div', { style: 'position:absolute;top:0;bottom:0;width:1.6rem;margin-left:-.8rem;background:#2F8F46' });\n    this.barMid = h('div', { style: 'position:absolute;top:0;bottom:0;left:50%;width:.5rem;background:#1A1420' });\n    this.barEl.append(this.barFill, this.barGoal, this.barMid);\n    hud.el.append(this.barEl);\n    this.beatEl = h('div', { style: 'position:absolute;top:27rem;left:50%;width:14rem;height:14rem;margin-left:-7rem;border-radius:50%;background:#F5B700;border:.7rem solid #1A1420;display:none' });\n    hud.el.append(this.beatEl);\n    hud.setScore('', '');\n  }\n  removeHud() { if (this.howEl) { this.howEl.remove(); this.barEl.remove(); this.beatEl.remove(); } }\n  start() { this.nextTest(); }\n  nextTest() {\n    this.idx++;\n    if (this.idx >= this.tests.length) { this.allDone = true; this.howEl.textContent = 'Thank you.'; this.barEl.style.display = 'none'; this.beatEl.style.display = 'none'; return; }\n    const id = this.tests[this.idx], def = TESTS[id];\n    this.cur = { id, def, t: 0, sum: 0, n: 0, errors: [], state: 'show', showT: 2.2, sub: 0 };\n    this.showHow(def);\n    this.game.audio.sfx('bell');\n    const lane = this.lanes[0];\n    lane.doll.rig.loop('breathe');\n    lane.input.wishX = 0; lane.input.wishZ = 0;\n    this.game.input.resetRing();\n    this.barEl.style.display = id === 'leanMatch' ? '' : 'none';\n    this.beatEl.style.display = id === 'stepTime' ? '' : 'none';\n    this.setPromptsFor(id);\n    if (id === 'stepTime') { this.cur.beat = 60 / 96; this.cur.beats = []; this.cur.foot = null; const n = Math.floor(def.time / this.cur.beat); for (let i = 0; i < n; i++) this.cur.beats.push({ t: (i + 2) * this.cur.beat, hit: false }); }\n    if (id === 'leanMatch') { this.cur.targets = [this.pickTarget(), this.pickTarget(), this.pickTarget()]; this.cur.tIdx = -1; }\n    if (id === 'quickLean') { this.cur.prompts = []; this.cur.nextPrompt = 0.5; this.cur.active = null; this.cur.reactions = []; }\n  }\n  pickTarget() { const opts = [-0.7, -0.5, -0.3, 0.3, 0.5, 0.7]; return opts[Math.floor(this.r() * opts.length) % opts.length]; }\n  showHow(def) { this.howEl.textContent = `${def.title}: ${def.how}`; }\n  setPromptsFor(id) {\n    const hud = this.game.hud;\n    const map = {\n      standStill: [['lean', 'Lean']], leanMatch: [['lean', 'Lean']], stepTime: [['footL', 'Left'], ['footR', 'Right']], quickLean: [['lean', 'Lean']], oneFoot: [['footR', 'Hold down'], ['lean', 'Lean']],\n    };\n    hud.setPrompts(map[id]);\n  }\n  fixedEvent(dt) {\n    const c = this.cur, lane = this.lanes[0];\n    if (!c) return;\n    if (c.state === 'show') {\n      c.showT -= dt;\n      if (c.showT <= 0) { c.state = 'run'; }\n      return;\n    }\n    if (c.state === 'after') {\n      c.afterT -= dt;\n      if (c.afterT <= 0) this.nextTest();\n      return;\n    }\n    c.t += dt;\n    const b = lane.bal, def = c.def;\n    b.sway = def.sway; b.tremor = def.tremor;\n    const r = Math.hypot(lane.dotX, lane.dotZ);\n    switch (c.id) {\n      case 'standStill': c.sum += r * dt; c.n += dt; break;\n      case 'oneFoot': {\n        const held = lane.input.footR > 0.5 && lane.input.footL < 0.5;\n        b.params.margin = held ? 0.225 : 0.45;\n        c.sum += (held ? r : Math.max(r, 0.5)) * dt; c.n += dt;\n        lane.doll.rig.loop(held ? 'pose4' : 'breathe');\n        break;\n      }\n      case 'leanMatch': {\n        const i = Math.min(2, Math.floor(c.t / 6));\n        if (i !== c.tIdx) {\n          c.tIdx = i;\n          const x = c.targets[i];\n          this.howEl.textContent = `Lean ${Math.round(Math.abs(x) * 100)}% ${x < 0 ? 'left' : 'right'}.`;\n          this.game.audio.sfx('uiConfirm');\n        }\n        c.goal = c.targets[i];\n        if (c.t - i * 6 > 1.5) { c.sum += Math.abs(lane.dotX - c.goal) * dt; c.n += dt; }\n        break;\n      }\n      case 'stepTime': {\n        const i = lane.input;\n        const foot = i.footLPressed ? 'L' : i.footRPressed ? 'R' : null;\n        if (foot) {\n          lane.doll.rig.once(foot === 'L' ? 'stepR' : 'stepL');\n          if (foot !== c.foot) {\n            let best = null, bd = 1e9;\n            for (const bt of c.beats) { if (bt.hit) continue; const d = Math.abs(bt.t - c.t); if (d < bd) { bd = d; best = bt; } }\n            if (best && bd < 0.25) { best.hit = true; c.errors.push(bd); }\n            c.foot = foot;\n          }\n        }\n        for (const bt of c.beats) if (!bt.clicked && bt.t <= c.t) { bt.clicked = true; this.game.audio.sfx('metronome'); this.pulseBeat = 1; }\n        break;\n      }\n      case 'quickLean': {\n        c.nextPrompt -= dt;\n        if (!c.active && c.nextPrompt <= 0 && c.prompts.length < 6) {\n          const d = DIRS[Math.floor(this.r() * 4) % 4];\n          c.active = { dir: d, t: 0 };\n          c.prompts.push(d);\n          this.howEl.textContent = `Lean ${d[2]}!`;\n          this.game.audio.sfx('uiConfirm');\n        }\n        if (c.active) {\n          c.active.t += dt;\n          const [dx, dz] = c.active.dir;\n          const proj = lane.dotX * dx + lane.dotZ * dz;\n          if (proj > 0.4 || c.active.t > 2) {\n            c.reactions.push(Math.min(2, c.active.t));\n            c.active = null; c.nextPrompt = 0.6;\n            this.howEl.textContent = 'And back to the middle.';\n          }\n        }\n        break;\n      }\n      default: break;\n    }\n    if (c.t >= def.time) this.finishTest();\n  }\n  finishTest() {\n    const c = this.cur;\n    let score = 0;\n    if (c.id === 'standStill' || c.id === 'oneFoot') score = 1 - (c.sum / Math.max(0.001, c.n)) / 0.25;\n    if (c.id === 'leanMatch') score = 1 - (c.sum / Math.max(0.001, c.n)) / 0.4;\n    if (c.id === 'stepTime') {\n      const missed = c.beats.length - c.errors.length;\n      const mean = (c.errors.reduce((a, b) => a + b, 0) + missed * 0.2) / Math.max(1, c.beats.length);\n      score = 1 - mean / 0.12;\n    }\n    if (c.id === 'quickLean') {\n      const rs = c.reactions;\n      const mean = rs.length ? rs.reduce((a, b) => a + b, 0) / rs.length : 2;\n      score = 1 - (mean - 0.35) / 0.9;\n    }\n    score = clamp01(score);\n    this.scores[c.id] = score;\n    this.lanes[0].bal.params.margin = 0.45;\n    c.state = 'after'; c.afterT = 2.2;\n    this.game.speech.say('trudy', line('trudy', score > 0.55 ? 'checkin_good' : 'checkin_bad'), { auto: 2, top: false });\n    this.howEl.textContent = `${c.def.title}: ${Math.round(score * 100)}`;\n    this.game.audio.sfx('stamp');\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const c = this.cur;\n    out.wishX = 0; out.wishZ = 0; out.footL = 0; out.footR = 0; out.footLPressed = false; out.footRPressed = false;\n    if (!c || c.state !== 'run') return;\n    let gx = 0, gz = 0;\n    switch (c.id) {\n      case 'leanMatch': gx = c.goal || 0; { const [x, z] = bot.steer(gx, 0, true); out.wishX = x; out.wishZ = z; } return;\n      case 'oneFoot': out.footR = 1; break;\n      case 'quickLean':\n        if (c.active && c.active.t > bot.s.lag * 0.7) { gx = c.active.dir[0]; gz = c.active.dir[1]; out.wishX = gx; out.wishZ = gz; return; }\n        break;\n      case 'stepTime': {\n        const d = bot.data;\n        for (const bt of c.beats) {\n          if (bt.botErr === undefined) bt.botErr = bot.timing();\n          if (!bt.botDone && c.t >= bt.t + bt.botErr) {\n            bt.botDone = true;\n            d.foot = d.foot === 'L' ? 'R' : 'L';\n            if (d.foot === 'L') { out.footLPressed = true; out.footL = 1; } else { out.footRPressed = true; out.footR = 1; }\n            break;\n          }\n        }\n        return;\n      }\n      default: break;\n    }\n    const [x, z] = bot.steer(gx, gz);\n    out.wishX = x; out.wishZ = z;\n  }\n  hud() {\n    const c = this.cur, lane = this.lanes[0];\n    const hud = this.game.hud;\n    if (!c) return;\n    hud.setTime(c.state === 'run' ? c.def.time - c.t : null);\n    lane.discView.zone = null;\n    if (c.id === 'standStill' || c.id === 'oneFoot') lane.discView.zone = { x: 0, z: 0, r: 0.25, on: Math.hypot(lane.dotX, lane.dotZ) < 0.25 };\n    if (c.id === 'leanMatch' && c.goal !== undefined) {\n      lane.discView.zone = { x: c.goal, z: 0, r: 0.14, on: Math.abs(lane.dotX - c.goal) < 0.1 };\n      const x = lane.dotX;\n      this.barFill.style.left = `${x < 0 ? 50 + x * 50 : 50}%`;\n      this.barFill.style.width = `${Math.min(50, Math.abs(x) * 50)}%`;\n      this.barGoal.style.left = `${50 + c.goal * 50}%`;\n    }\n    if (c.id === 'quickLean' && c.active) lane.discView.zone = { x: c.active.dir[0] * 0.65, z: c.active.dir[1] * 0.65, r: 0.3, on: false };\n    if (c.id === 'stepTime') {\n      this.pulseBeat = Math.max(0, (this.pulseBeat || 0) - 0.08);\n      this.beatEl.style.transform = `scale(${1 + this.pulseBeat * 0.5})`;\n    }\n  }\n  frameEvent(dt) {\n    this.trudy.update(dt);\n    this.trudy.feel(this.lanes[0].dotX);\n  }\n  isDone() { return this.allDone; }\n  dispose() { this.removeHud(); super.dispose(); }\n  laneResult() { return { form: 0, raw: 0, stats: '' }; }\n}\n\n/** The Check-In and the reveal: lights dim, drum roll, numbers spin on a wooden counter, a sting, a line. */\nexport class CheckInMode {\n  constructor(game) { this.game = game; this.name = 'checkin'; this.canPause = true; this.stage = 'tests'; }\n  enter() {\n    const g = this.game, pr = g.programme, p = g.save.profile;\n    g.setIsland('hidden');\n    g.ui.clear(); g.speech.clear();\n    g.palette.set('dawn', 0.8);\n    const tests = pr.testsToday();\n    this.ev = new CheckInEvent({ game: g, tier: 0, tests, lanes: [{ kind: 'local', name: p ? p.name : 'You', colour: p ? paintColour(p.paint) : '#2CB5A0', hat: p ? p.hat : 'none', source: 'any' }], mode: 'solo' });\n    g.currentEvent = this.ev;\n    this.ev.build();\n    g.sea.setLevel(-6.4);\n    this.ev.cameraShot(true);\n    g.hud.reset();\n    g.hud.setDiscs(this.ev.lanes);\n    g.hud.setPrompts([['lean', 'Lean']]);\n    this.ev.hudSetup(g.hud);\n    g.hud.show(true);\n    g.audio.music('island');\n    this.handle = g.scripts.run(this.flow());\n  }\n  restart() { const g = this.game; g.setMode(new CheckInMode(g), 'checkin'); }\n  *flow() {\n    const g = this.game, ev = this.ev, pr = g.programme, p = g.save.profile;\n    yield 0.4;\n    ev.begin();\n    yield () => ev.isDone();\n    ev.phase = 'done';\n    yield 0.8;\n    const vals = Object.values(ev.scores);\n    const mean = vals.reduce((a, b) => a + b, 0) / Math.max(1, vals.length);\n    this.mean = mean;\n    const age = pr.ageFor(mean, p.today.day);\n    const prev = p.ages.length ? p.ages[p.ages.length - 1].age : null;\n    const unlocked = pr.checkinDone(age, ev.scores);\n    this.stage = 'reveal';\n    g.hud.show(false);\n    yield* this.reveal(age, prev);\n    if (unlocked.unlocks && unlocked.unlocks.length) g.ui.toast(`New: ${unlocked.unlocks.map((u) => u.name).join(', ')}.`, 3);\n    this.stage = 'done';\n    refreshJarDisplay(g);\n    g.go(() => { g.flow.toIsland({ afterCheckin: true }); });\n  }\n  *reveal(age, prev) {\n    const g = this.game;\n    let advanced = false;\n    let digits = [];\n    const scr = g.ui.only({\n      name: 'reveal', className: 'dim',\n      build: (s) => {\n        s.el.style.background = 'rgba(26,20,32,.82)';\n        const c = h('div.counter', { style: 'margin-top:20rem' });\n        digits = [h('div.digit', '0'), h('div.digit', '0')];\n        c.append(...digits);\n        s.el.append(h('div.h2', { style: 'margin-top:8rem' }, 'Your Wobble Age'), c);\n      },\n    });\n    g.speech.say('trudy', line('trudy', 'reveal_lead'), { auto: 1.5 });\n    g.audio.sfx('drumRoll', { dur: 2 });\n    let t = 0;\n    while (t < 2) {\n      t += 1 / 120;\n      if (Math.floor(t * 30) !== Math.floor((t - 1 / 120) * 30)) { digits[0].textContent = String(Math.floor(t * 41) % 10); digits[1].textContent = String(Math.floor(t * 67) % 10); }\n      yield null;\n    }\n    const a = String(age).padStart(2, '0');\n    digits[0].textContent = a[0]; digits[1].textContent = a[1];\n    g.audio.sting('reveal');\n    g.audio.sfx('stamp');\n    g.rig.shake(0.05);\n    const band = age >= 70 ? 'age_old' : age >= 50 ? 'age_mid' : age >= 30 ? 'age_low' : 'age_young';\n    g.speech.say('trudy', line('trudy', band, { age }), {});\n    let l = g.speech.line;\n    yield () => !g.speech.line || g.speech.line !== l;\n    if (prev !== null) {\n      g.speech.say('trudy', line('trudy', age < prev ? 'age_down' : 'age_same', { prev }), {});\n      l = g.speech.line;\n      yield () => !g.speech.line || g.speech.line !== l;\n    }\n    advanced = true;\n    g.ui.close(scr);\n    return advanced;\n  }\n  fixed(dt) { this.ev.fixed(dt); }\n  frame(dt) { this.ev.frame(dt); }\n  exit() {\n    const g = this.game;\n    if (this.handle) this.handle.cancel();\n    g.hud.show(false); g.hud.reset();\n    this.ev.dispose();\n    g.currentEvent = null;\n    g.speech.clear();\n    g.ui.clear();\n  }\n}\nexport { G, promptHTML };\nEOF\ncat > src/game/ending.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { MAP } from '../art/island.js';\nimport { line } from '../data/dialogue.js';\nimport { TITLE, RESORT } from '../data/config.js';\nimport * as THREE from 'three/webgpu';\nimport { refreshJarDisplay } from './jar.js';\n\nconst CREDITS = [\n  [TITLE, RESORT], ['Head of Alignment', 'Trudy'], ['Stillness', 'Ms. Stillwater'], ['Strength and Cardio', 'Coach Bolster'],\n  ['Guests', 'Gentle Margaret, Retired Kevin, Both Sandras, Unsteady Paul, Young Gerald'], ['Gull', 'Gary (uncredited)'],\n  ['Everything rolling downhill', 'The oranges'], ['Thank you for attending', 'It was noted'],\n];\nconst _v = new THREE.Vector3();\n\n/** The bubble centres for the first time. Then the slow pan over everything you straightened. */\nexport class EndingMode {\n  constructor(game) { this.game = game; this.name = 'ending'; this.canPause = false; this.t = 0; this.stage = 'level'; }\n  enter() {\n    const g = this.game, p = g.save.profile;\n    g.ui.clear();\n    g.setIsland('home');\n    if (p) { p.levelled = true; g.save.write(); }\n    g.phys.setRest(0); g.phys.restNow = 0; g.phys.snapTilt();\n    g.palette.set('golden', 0.5);\n    g.audio.stopMusic(0.2);\n    g.audio.setTilt(0);\n    refreshJarDisplay(g);\n    const trudy = g.art.trudy;\n    trudy.root.position.set(1.5, 0, -6);\n    trudy.feel(0);\n    g.phys.setPosition(1.5, -3);\n    this.shot = 'trudy';\n    this.frameCam(true);\n    this.handle = g.scripts.run(this.flow());\n  }\n  frameCam(snap) {\n    const g = this.game, art = g.art;\n    art.group.updateWorldMatrix(true, false);\n    if (this.shot === 'trudy') {\n      _v.set(1.5, 0.5, -6).applyMatrix4(art.group.matrixWorld);\n      g.rig.shot(_v.x, _v.y + 0.45, _v.z + 3.1, _v.x, _v.y + 0.05, _v.z, { fov: 30, snap, rate: 2 });\n    } else {\n      const a = this.t * 0.12;\n      const R = 40;\n      g.rig.shot(Math.sin(a) * R, 12 + Math.sin(a * 0.6) * 4, Math.cos(a) * R, 0, 2, 0, { fov: 38, snap, rate: 1 });\n    }\n  }\n  *flow() {\n    const g = this.game, art = g.art;\n    yield 1.2;\n    // Silence. She has only ever seen the world at nine degrees.\n    art.trudy.rig.once('gasp');\n    yield* g.say('trudy', 'ending_1');\n    yield 0.8;\n    yield* g.say('trudy', 'ending_2');\n    yield 0.6;\n    // The marbles flare, the lighthouse lights, and the credits roll.\n    this.stage = 'flare';\n    g.audio.sting('ending');\n    art.lightGlow.intensity = 40;\n    art.lampMat.color.set(0xFFFFFF);\n    const lh = MAP.lighthouse;\n    g.fx.confetti(lh.x, 12, lh.z, 200, [0xE8443A, 0xF5B700, 0x2CB5A0, 0x5AA9E6, 0xFFF3DC], 12);\n    g.rig.shake(0.05);\n    g.palette.set('dusk', 8);\n    yield 1.5;\n    this.shot = 'pan';\n    g.audio.music('level');\n    this.stage = 'credits';\n    let i = 0;\n    const scr = g.ui.only({ name: 'credits', passive: true, build: (s) => { this.credEl = h('div', { style: 'margin-top:14rem;text-align:center' }); s.el.append(this.credEl); } });\n    for (const [a, b] of CREDITS) {\n      this.credEl.innerHTML = '';\n      this.credEl.append(h('div.h2', a), h('div.tag', { style: 'display:inline-block;font-size:4rem' }, b));\n      yield 2.6;\n      i++;\n    }\n    g.ui.close(scr);\n    this.shot = 'trudy';\n    g.palette.set('dawn', 4);\n    this.stage = 'after';\n    yield 1;\n    yield* g.say('trudy', 'ending_3');\n    yield* g.say('trudy', 'ending_4');\n    this.stage = 'done';\n    const p = g.save.profile;\n    if (p) {\n      // Save the levelled state and carry on into Maintenance days.\n      if (p.today.day <= 5) g.programme.nextDay();\n    }\n    art.lightGlow.intensity = 0;\n    return i;\n  }\n  fixed(dt) {\n    const g = this.game;\n    this.t += dt;\n    g.stepIsland(dt, 0);\n    if (this.handle && this.handle.done && !this.left) {\n      this.left = true;\n      g.go(() => g.flow.toIsland({ morning: true }));\n    }\n  }\n  frame(dt) {\n    const g = this.game;\n    g.syncIsland(dt);\n    g.art.trudy.feel(0);\n    g.art.trudy.update(dt);\n    this.frameCam(false);\n  }\n  exit() {\n    const g = this.game;\n    if (this.handle) this.handle.cancel();\n    g.ui.clear();\n    g.speech.clear();\n  }\n}\nexport { line };\nEOF\ncat > src/game/attract.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { EventRun } from './eventRun.js';\nimport { hasEvent } from '../events/index.js';\nimport { TITLE, SEAT_COLOURS } from '../data/config.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { Doll } from '../art/doll.js';\nimport { TIER_NAMES } from '../data/events.js';\nimport { MAP } from '../art/island.js';\nimport * as THREE from 'three/webgpu';\n\nconst COLS = ['#2CB5A0', '#E8644A', '#F5C84A', '#8A5BA8'];\nconst bots = (n, skill = 'average') => Array.from({ length: n }, (_, i) => ({ kind: 'bot', skill: i === 0 ? 'sharp' : skill, name: ['Margaret', 'Kevin', 'Sandra', 'Paul'][i], colour: COLS[i % 4] }));\nconst VIGNETTES = [\n  { id: 'walk' },\n  { id: 'fruitHat', after: (ev) => { ev.god = false; ev.lanes[0].bankAt = 11; ev.nextFruit = 0.3; ev.cfg = { ...ev.cfg, every: 0.8 }; } },\n  { id: 'cairn', after: (ev) => { ev.cfg = { ...ev.cfg, every: 2.2 }; } },\n  { id: 'stepClass', after: (ev) => { ev.clock = 8; ev.nextClick = ev.notes.findIndex((n) => n.t >= 8); } },\n  { id: 'plates' },\n  { id: 'springboard', after: (ev) => { const l = ev.lanes[0]; l.boardV = 4; l.pumpT = 3; } },\n  { id: 'raft', lanes: 4, god: false },\n  { id: 'roomService', after: (ev) => { ev.gustNext = 1.5; } },\n  { id: 'poses' },\n];\nconst _v = new THREE.Vector3(), _iq = new THREE.Quaternion();\n\n/** Island walk vignette: a bot wanders and the island tips under it. */\nclass WalkVignette {\n  constructor(game) { this.game = game; this.name = 'walk'; this.ev = null; this.t = 0; this.leg = 0; }\n  enter() {\n    const g = this.game;\n    g.setIsland('home');\n    g.palette.set('noon', 1);\n    g.audio.music('island');\n    this.doll = new Doll({ shirt: '#2CB5A0', hat: 'visor' });\n    g.art.group.add(this.doll.root);\n    g.phys.setPosition(0, 10);\n    this.spots = [MAP.pier, MAP.lighthouse, MAP.sunDeck, MAP.yard, MAP.bandstand];\n    this.frameCam(true);\n  }\n  frameCam(snap) {\n    const g = this.game, p = g.phys.pos;\n    g.art.group.updateWorldMatrix(true, false);\n    _v.set(p.x, 0.9, p.z).applyMatrix4(g.art.group.matrixWorld);\n    g.rig.shot(_v.x + 8, _v.y + 7, _v.z + 13, _v.x, _v.y + 0.5, _v.z, { snap, rate: 3, fov: 42 });\n  }\n  fixed(dt) {\n    const g = this.game, ph = g.phys;\n    this.t += dt;\n    const s = this.spots[this.leg % this.spots.length];\n    const p = ph.pos;\n    const dx = s.x - p.x, dz = s.z - p.z, d = Math.hypot(dx, dz);\n    if (d < 3) this.leg++;\n    ph.wantX = (dx / (d || 1)) * 6; ph.wantZ = (dz / (d || 1)) * 6;\n    ph.leanExtraX = Math.sin(this.t * 0.7) * 0.08; ph.leanExtraZ = Math.cos(this.t * 0.5) * 0.08;\n    g.stepIsland(dt, 1);\n  }\n  frame(dt) {\n    const g = this.game, ph = g.phys, p = ph.pos;\n    g.syncIsland(dt);\n    this.frameCam(false);\n    _iq.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w).invert();\n    this.doll.root.position.set(p.x, 0, p.z);\n    this.doll.root.quaternion.copy(_iq);\n    this.doll.face(Math.atan2(ph.wantX, ph.wantZ));\n    this.doll.rig.loop('jog');\n    this.doll.update(dt);\n  }\n  exit() {\n    const g = this.game;\n    g.phys.wantX = 0; g.phys.wantZ = 0; g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    g.art.group.remove(this.doll.root);\n  }\n}\n\n/**\n * The looping kiosk demo: bot-played vignettes of about 18 s each, with the bots allowed to cheat.\n * Any input exits it and is swallowed. Back to the title for 5 s between passes.\n */\nexport class Attract {\n  constructor(game) { this.game = game; this.name = 'attract'; this.index = -1; this.t = 0; this.sub = null; this.visited = []; this.canPause = false; this.leaving = false; this.titlePause = 0; }\n  enter() {\n    const g = this.game;\n    g.attract = true;\n    this.overlay = g.ui.only({\n      name: 'attract', passive: true,\n      build: (s) => {\n        this.demoEl = h('div.demo.tag');\n        s.el.append(h('div.demo-title', TITLE), this.demoEl);\n        this.renderDemo();\n      },\n    });\n    g.hud.reset();\n    this.next();\n  }\n  renderDemo() {\n    const g = this.game;\n    this.demoEl.innerHTML = `DEMO · Press any button ${promptHTML('use', '', g.input.lastDevice, g.save.settings.glyphs).replace('prompt-text', 'prompt-text hidden')}`;\n  }\n  next() {\n    const g = this.game;\n    this.index++;\n    if (this.index >= VIGNETTES.length) {\n      // Back to the title for five seconds between passes.\n      this.index = -1;\n      this.titlePause = 5;\n      this.closeSub();\n      g.setIsland('home');\n      g.palette.set('dawn', 1);\n      g.rig.shot(9, 9, 52, 0, 0.5, -2, { fov: 38, rate: 2 });\n      this.t = 0;\n      return;\n    }\n    const v = VIGNETTES[this.index];\n    if (v.id !== 'walk' && !hasEvent(v.id)) { this.next(); return; }\n    this.t = 0;\n    this.closeSub();\n    if (v.id === 'walk') { this.sub = new WalkVignette(g); this.sub.enter(); this.visited.push('walk'); return; }\n    this.visited.push(v.id);\n    const run = new EventRun(g, {\n      id: v.id, tier: 0, lanes: bots(v.lanes || 1), mode: 'attract', skipIntro: true, skipCountdown: true, god: v.god !== false,\n      afterBuild: v.after, onResult: function* none() { /* nothing to report in a demo */ },\n    });\n    this.sub = run;\n    run.enter();\n    g.hud.show(true);\n  }\n  closeSub() {\n    if (this.sub) { const s = this.sub; this.sub = null; s.exit(); this.game.ui.stack.includes(this.overlay) || this.game.ui.layer.append(this.overlay.el); if (!this.game.ui.stack.includes(this.overlay)) this.game.ui.stack.push(this.overlay); }\n  }\n  fixed(dt) {\n    const g = this.game, inp = g.input;\n    if (inp.activityThisTick && !this.leaving && (this.grace === undefined || this.grace <= 0)) { this.exitToTitle(); return; }\n    if (this.grace > 0) this.grace -= dt;\n    this.t += dt;\n    if (this.titlePause > 0) {\n      this.titlePause -= dt;\n      g.stepIsland(dt, 0);\n      if (this.titlePause <= 0) this.next();\n      return;\n    }\n    if (this.sub) this.sub.fixed(dt);\n    if (this.t >= 18 && !g.wiping) { this.t = 0; g.scripts.run(g.wipe(() => this.next())); }\n  }\n  frame(dt) {\n    const g = this.game;\n    if (this.titlePause > 0) g.syncIsland(dt);\n    if (this.sub) this.sub.frame(dt);\n  }\n  exitToTitle() {\n    const g = this.game;\n    this.leaving = true;\n    g.input.swallow();\n    g.flow.toTitle();\n  }\n  exit() {\n    const g = this.game;\n    this.closeSub();\n    g.attract = false;\n    g.hud.reset(); g.hud.show(false);\n    g.ui.clear();\n    g.speech.clear();\n    g.input.idle = 0;\n  }\n}\nexport { rot2, SEAT_COLOURS, TIER_NAMES };\nEOF\ncat > src/game/devmode.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { h } from '../ui/dom.js';\nimport { TUNING } from '../data/tuning.js';\nimport { tun, resetTuning, tuningJSON } from '../core/tuning.js';\nimport { EVENTS, TIER_NAMES } from '../data/events.js';\nimport { hasEvent } from '../events/index.js';\nimport { LINES, line } from '../data/dialogue.js';\nimport { TRACKS, STINGS } from '../audio/tracks.js';\nimport { PALETTE_ORDER } from '../data/palettes.js';\nimport { SPEAKERS } from '../ui/speech.js';\nimport { DAYS } from '../data/programme.js';\nimport { RAPIER } from '../physics/world.js';\nimport { blankInput } from '../input/input.js';\n\nconst ADD = (n) => n;\n/** Dev Mode, from Pause. Pages of big controls by group, six to a page, usable by pad, keys and mouse. */\nexport function openDev(game) {\n  const g = game;\n  const groups = Object.keys(TUNING).reduce((a, k) => { (a[TUNING[k].group] = a[TUNING[k].group] || []).push(k); return a; }, {});\n  const pages = [];\n  const page = (title, items) => pages.push({ title, items });\n  const ev = () => g.currentEvent;\n  page('Run', [\n    { label: 'God mode', get: () => (g.god ? 'On' : 'Off'), use: () => { g.god = !g.god; if (ev()) ev().god = g.god; } },\n    { label: 'Time scale', slider: { min: 0.1, max: 4, step: 0.1, get: () => g.loop.timeScale, set: (v) => { g.loop.timeScale = v; } } },\n    { label: 'Single step', use: () => { g.devStep = 1; g.ui.toast('One step.', 0.8); } },\n    { label: 'Let the bot play', get: () => (ev() && ev().autoplay === 0 ? 'On' : 'Off'), use: () => { const e = ev(); if (!e) return; e.autoplay = e.autoplay === 0 ? undefined : 0; } },\n    { label: 'Skip to Results', use: () => { if (g.mode && g.mode.skip) { closeAll(); g.mode.skip(); } else g.ui.toast('No class is running.'); } },\n    { label: 'Skip to the Ending', use: () => { closeAll(); g.go(() => g.flow.toEnding()); } },\n  ]);\n  page('Jump', [\n    { label: 'Event', choose: Object.keys(EVENTS).filter(hasEvent), state: 'evId', fmt: (id) => EVENTS[id].title },\n    { label: 'Tier', choose: [0, 1, 2], state: 'tier', fmt: (t) => TIER_NAMES[t] },\n    { label: 'Go to that class', use: () => { const id = g.devJump.evId, t = g.devJump.tier; closeAll(); g.go(() => g.flow.runClass(id, Math.min(t, EVENTS[id].tiers.length - 1), { programme: false })); } },\n    { label: 'Day', choose: [1, 2, 3, 4, 5, 6], state: 'day', fmt: (d) => `Day ${d}` },\n    { label: 'Jump to that day', use: () => { jumpDay(g, g.devJump.day); closeAll(); g.go(() => g.flow.toIsland({ morning: true })); } },\n    { label: 'Next step', use: () => { const p = g.save.profile; if (p) { const n = g.programme.nextClass(); if (n) { p.today.done.push(n); if (p.today.day <= DAYS.length) p.stepsDone++; g.programme.syncIsland(); g.save.write(); g.ui.toast(`${EVENTS[n].title} marked done.`); } } } },\n  ]);\n  page('Look', [\n    { label: 'Free camera', get: () => (g.rig.free ? 'On' : 'Off'), use: () => { g.rig.free = !g.rig.free; g.rig.freeYaw = 0; g.rig.freePitch = -0.2; } },\n    { label: 'Physics debug lines', get: () => (g.devDebugLines ? 'On' : 'Off'), use: () => toggleDebugLines(g) },\n    { label: 'Stats', get: () => (g.devStats ? 'On' : 'Off'), use: () => toggleStats(g) },\n    { label: 'Input monitor', get: () => (g.devInput ? 'On' : 'Off'), use: () => toggleInputMon(g) },\n    { label: 'Ink', get: () => (g.inkOff ? 'Off' : 'On'), use: () => { g.inkOff = !g.inkOff; g.applyInk(); } },\n    { label: 'Palette', choose: PALETTE_ORDER, state: 'palette', fmt: (p) => p, onChange: (p) => g.palette.set(p, 0.5) },\n  ]);\n  page('Force', [\n    { label: 'Force a gust', use: () => { const e = ev(); if (e && e.lanes[0] && e.lanes[0].bal) { const l = e.lanes[0]; l.devGust = 0.5; forceGust(g, l); g.ui.toast('Whoosh.'); } } },\n    { label: 'Force a fall', use: () => { const e = ev(); if (e && e.forceFall) e.forceFall(0); } },\n    { label: 'Force a fruit', use: () => { const e = ev(); if (e && e.launch) e.launch(e.lanes[0], 'fruit'); else g.ui.toast('Only in Fruit Hat.'); } },\n    { label: 'Force a stone', use: () => { const e = ev(); if (e && e.dropStone) e.dropStone(e.lanes[0]); else g.ui.toast('Only in The Cairn.'); } },\n    { label: 'Speaker', choose: Object.keys(LINES), state: 'who', fmt: (w) => (SPEAKERS[w] ? SPEAKERS[w].name : w) },\n    { label: 'Play a line', use: () => { const w = g.devJump.who; const sits = Object.keys(LINES[w]); const s = sits[Math.floor(g.simTime * 7) % sits.length]; const t = line(w, s, { age: 40, prev: 50, n: 3, pose: 'The Quiet Regret', next: 'Poses', place: 'The Sun Deck' }); g.ui.toast(`${s}: ${t.slice(0, 54)}`); g.audio.say(SPEAKERS[w]?.voice || 'guest', t); } },\n  ]);\n  page('Hear and set', [\n    { label: 'Track', choose: Object.keys(TRACKS), state: 'track', fmt: (x) => x },\n    { label: 'Play that track', use: () => { if (g.audio.seq) { g.audio.seq.resume(); } g.audio.music(g.devJump.track); } },\n    { label: 'Sting', choose: Object.keys(STINGS), state: 'sting', fmt: (x) => x },\n    { label: 'Play that sting', use: () => g.audio.sting(g.devJump.sting) },\n    { label: 'Set Wobble Age', slider: { min: 18, max: 99, step: 1, get: () => (g.save.profile && g.save.profile.today.age) || 60, set: (v) => { const p = g.save.profile; if (p) { p.today.age = v; if (p.ages.length) p.ages[p.ages.length - 1].age = v; else p.ages.push({ day: p.today.day, age: v }); g.save.write(); } } } },\n    { label: 'Add 10 marbles', use: () => { const p = g.save.profile; if (p) { g.programme.addMarbles(10, 'pleasant'); g.save.write(); g.ui.toast(`${p.marbles} marbles.`); } } },\n  ]);\n  page('Save and tuning', [\n    { label: 'Unlock all', use: () => { const p = g.save.profile; if (p) { p.allUnlocked = true; p.levelled = p.levelled; for (const id of Object.keys(EVENTS)) { p.seen[id] = true; p.tiers[id] = 2; } g.save.write(); g.ui.toast('Everything is open.'); } } },\n    { label: 'Reset save', use: () => { g.save.reset(); g.programme.syncIsland(); closeAll(); g.flow.toTitle(); } },\n    { label: 'Copy tuning as JSON', use: () => copyTuning(g) },\n    { label: 'Reset tuning to defaults', use: () => { resetTuning(); g.applyInk(); renderPage(); g.ui.toast('Back to defaults.'); } },\n  ]);\n  for (const grp of Object.keys(groups)) {\n    const keys = groups[grp];\n    for (let i = 0; i < keys.length; i += 6) {\n      const n = Math.floor(i / 6) + 1, many = keys.length > 6;\n      page(`${grp} sliders${many ? ` ${n}` : ''}`, keys.slice(i, i + 6).map((k) => {\n        const d = TUNING[k];\n        return { label: d.label, tune: k, slider: { min: d.min, max: d.max, step: d.step, get: () => tun[k], set: (v) => { tun[k] = v; if (d.group === 'Ink') g.applyInk(); } } };\n      }));\n    }\n  }\n  g.devJump = g.devJump || { evId: 'fruitHat', tier: 0, day: 1, palette: 'dawn', who: 'trudy', track: 'levelBest', sting: 'pleasant' };\n  let scr = null;\n  let renderPage = () => {};\n  const closeAll = () => {\n    while (g.ui.top && (g.ui.top.pauseLayer || g.ui.top.name === 'dev')) g.ui.close(g.ui.top);\n    g.paused = false;\n    if (g.audio.seq) g.audio.seq.resume();\n  };\n  scr = g.ui.open({\n    name: 'dev', className: 'dim',\n    prompts: [['use', 'Choose'], ['page', 'Pages'], ['back', 'Back']],\n    back: () => g.ui.close(scr),\n    build: (s) => {\n      s.pauseLayer = true;\n      const title = h('div.h2', { style: 'margin-top:2rem;font-size:4.6rem' }, 'Dev Mode');\n      const panel = h('div.dev-panel');\n      s.el.append(title, panel);\n      const render = (pg) => {\n        s.page = pg;\n        panel.innerHTML = '';\n        s.clearItems();\n        const p = pages[pg];\n        title.textContent = `Dev Mode: ${p.title}`;\n        for (const it of p.items) {\n          if (it.slider) {\n            const fmt = (v) => (it.slider.step < 0.01 ? v.toFixed(4) : it.slider.step < 1 ? (+v).toFixed(2) : String(Math.round(v)));\n            const el = g.ui.slider(s, it.label, it.slider.get, it.slider.set, { min: it.slider.min, max: it.slider.max, step: it.slider.step, format: fmt });\n            if (it.tune) el.dataset.tune = it.tune;\n            panel.append(el);\n          } else if (it.choose) {\n            const opts = it.choose.map((o) => [o, it.fmt(o)]);\n            panel.append(g.ui.choice(s, it.label, opts, () => g.devJump[it.state], (v) => { g.devJump[it.state] = v; if (it.onChange) it.onChange(v); }));\n          } else {\n            const val = it.get ? h('span.val', it.get()) : null;\n            const el = h('div.toggle', h('span', it.label), val);\n            s.item(el, { use: () => { it.use(); if (val) val.textContent = it.get(); } });\n            panel.append(el);\n          }\n        }\n        s.setFocus(0, true);\n      };\n      renderPage = () => render(s.page);\n      s.pager(pages.length, render);\n      render(0);\n    },\n  });\n  g.line && g.ui.toast(line('trudy', 'dev'), 3);\n  return { ADD, THREE, RAPIER, blankInput };\n}\n\nfunction jumpDay(g, day) {\n  const p = g.save.profile;\n  if (!p) return;\n  let steps = 0;\n  for (let d = 1; d < Math.min(day, 6); d++) steps += DAYS[d - 1].classes.filter(hasEvent).length;\n  p.stepsDone = steps;\n  p.levelled = day > 5;\n  p.tutorialDone = true;\n  p.day = day;\n  p.today = { day, checkin: false, age: null, done: [], question: false };\n  for (let d = 1; d < Math.min(day, 6); d++) for (const id of DAYS[d - 1].classes) p.seen[id] = true;\n  g.programme.syncIsland();\n  g.phys.snapTilt();\n  g.save.write();\n}\nfunction forceGust(g, lane) {\n  const a = g.simTime * 3.1;\n  const left = { v: 0.5 };\n  const prev = g.afterFixed;\n  g.afterFixed = (dt) => {\n    if (prev) prev(dt);\n    if (left.v > 0) { left.v -= dt; if (lane.bal) { lane.bal.extX += Math.cos(a) * 3 * 1; lane.bal.extZ += Math.sin(a) * 3 * 1; } } else g.afterFixed = prev;\n  };\n  g.audio.sfx('gust');\n}\nfunction copyTuning(g) {\n  const json = tuningJSON();\n  const show = () => {\n    let scr = null;\n    scr = g.ui.open({ name: 'tuningJSON', className: 'dim', back: () => g.ui.close(scr), prompts: [['back', 'Back']], build: (s) => { s.pauseLayer = true; s.el.append(h('div.bigtext.tag', json)); } });\n  };\n  try {\n    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(json).then(() => g.ui.toast('Tuning copied.'), show);\n    else show();\n  } catch (e) { show(); }\n}\nfunction toggleStats(g) {\n  g.devStats = !g.devStats;\n  if (g.statsEl) { g.statsEl.remove(); g.statsEl = null; }\n  if (g.devStats) { g.statsEl = h('div.stats', ''); document.getElementById('ui').append(g.statsEl); }\n  installDevFrame(g);\n}\nfunction toggleInputMon(g) {\n  g.devInput = !g.devInput;\n  if (g.inputEl) { g.inputEl.remove(); g.inputEl = null; }\n  if (g.devInput) { g.inputEl = h('div.stats', { style: 'top:auto;bottom:30rem' }, ''); document.getElementById('ui').append(g.inputEl); }\n  installDevFrame(g);\n}\nfunction toggleDebugLines(g) {\n  g.devDebugLines = !g.devDebugLines;\n  if (!g.devDebugLines && g.debugMesh) { g.scene.remove(g.debugMesh); g.debugMesh = null; }\n  if (g.devDebugLines && !g.debugMesh) {\n    const geo = new THREE.BufferGeometry();\n    g.debugMesh = new THREE.LineSegments(geo, new THREE.LineBasicNodeMaterial({ vertexColors: true }));\n    g.debugMesh.frustumCulled = false;\n    g.scene.add(g.debugMesh);\n  }\n  installDevFrame(g);\n}\nfunction installDevFrame(g) {\n  g.devFrame = (dt) => {\n    if (g.statsEl) {\n      const ev = g.currentEvent;\n      const t0 = performance.now();\n      const bodies = ev && ev.world ? ev.world.bodies.len() : g.phys.world.bodies.len();\n      const draws = g.renderer && g.renderer.info ? g.renderer.info.render.drawCalls : 0;\n      g.statsEl.textContent = `fps ${g.loop.fps.toFixed(0)}  step ${(performance.now() - t0).toFixed(1)} ms\\nbodies ${bodies}  draws ${draws}\\nbackend ${g.backend}`;\n    }\n    if (g.inputEl) {\n      const i = g.input, p = i.pads[i.activePad];\n      g.inputEl.textContent = `last ${i.lastDevice}\\nL ${p.axes[0].toFixed(2)},${p.axes[1].toFixed(2)}  R ${p.axes[2].toFixed(2)},${p.axes[3].toFixed(2)}\\nL2 ${p.val[6].toFixed(2)}  R2 ${p.val[7].toFixed(2)}`;\n    }\n    if (g.debugMesh) {\n      const w = (g.currentEvent && g.currentEvent.world) || g.phys.world;\n      const b = w.debugRender();\n      const geo = g.debugMesh.geometry;\n      geo.setAttribute('position', new THREE.BufferAttribute(b.vertices.slice(), 3));\n      geo.setAttribute('color', new THREE.BufferAttribute(b.colors.slice(), 4));\n      const ev = g.currentEvent;\n      if (ev) g.debugMesh.position.copy(ev.group.position); else g.debugMesh.position.set(0, 0, 0);\n    }\n    if (g.rig.free) {\n      const i = g.input, p = i.pads[i.activePad];\n      const dev = i.lastDevice === 'pad';\n      g.rig.freeMove(dt, dev ? p.axes[0] : (i.keyX || 0), dev ? p.axes[1] : (i.keyZ || 0), dev ? p.axes[2] : i.dragX * 0.3, dev ? p.axes[3] : i.dragY * 0.3);\n    }\n  };\n}\nEOF\ncat > src/game/groupclass.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { SEAT_COLOURS } from '../data/config.js';\nimport { EVENTS, DISCIPLINE_ORDER } from '../data/events.js';\nimport { hasEvent } from '../events/index.js';\nimport { EventRun } from './eventRun.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { Doll } from '../art/doll.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { BTN } from '../input/input.js';\nimport { line } from '../data/dialogue.js';\nimport { rng } from '../core/rng.js';\nimport { showResults } from './results.js';\nimport { RED, TEAL, CREAM } from '../art/props.js';\n\nconst POINTS = [4, 3, 2, 1];\nconst NAMES = ['Mat One', 'Mat Two', 'Mat Three', 'Mat Four'];\n\n/** Up to four on one TV. Lobby, playlist, classes in lanes, podium. */\nexport class GroupClass {\n  constructor(game) {\n    this.game = game; this.name = 'group'; this.canPause = false;\n    this.seats = [null, null, null, null]; this.stage = 'lobby'; this.points = [0, 0, 0, 0]; this.playlist = []; this.sub = null; this.t = 0;\n  }\n  enter() {\n    const g = this.game;\n    g.setIsland('home');\n    g.ui.clear();\n    g.palette.set('golden', 1);\n    g.programme.syncIsland();\n    g.phys.setRest(g.programme.restDeg());\n    g.rig.shot(14, 7, 44, 14, 2, -11, { fov: 38, rate: 2, snap: true });\n    g.audio.music('levelBest');\n    this.lobby();\n    g.speech.say('trudy', line('trudy', 'group_intro'), { auto: 3.6 });\n  }\n  lobby() {\n    const g = this.game;\n    this.stage = 'lobby';\n    this.scr = g.ui.only({\n      name: 'lobby', passive: true,\n      build: (s) => {\n        s.el.append(h('div.h1', { style: 'margin-top:3rem' }, 'Group Class'));\n        this.matsEl = h('div.mats', { style: 'margin-top:3rem' });\n        this.hintEl = h('div.tag', { style: 'margin-top:3rem;font-size:3.6rem' }, '');\n        s.el.append(this.matsEl, this.hintEl);\n        this.renderMats();\n      },\n    });\n  }\n  renderMats() {\n    const g = this.game, dev = g.input.lastDevice, set = g.save.settings.glyphs;\n    this.matsEl.innerHTML = '';\n    this.seats.forEach((seat, i) => {\n      const el = h('div.mat', { style: seat ? `background:${SEAT_COLOURS[i]};color:#fff;text-shadow:.15rem .15rem 0 #1A1420` : '' });\n      el.dataset.seat = String(i);\n      el.append(h('div', { style: 'font-size:4rem;font-weight:600' }, seat ? seat.name : 'Empty'));\n      el.append(h('div', seat ? (seat.source === 'kbm' ? 'Keys and mouse' : `Controller ${seat.pad + 1}`) : 'Join in'));\n      el.style.pointerEvents = 'auto'; el.style.cursor = 'pointer';\n      el.addEventListener('click', () => { g.input.clickQueue.push(() => this.joinKbm()); });\n      this.matsEl.append(el);\n    });\n    const joined = this.seats.filter(Boolean).length;\n    this.hintEl.innerHTML = `${promptHTML('join', 'Join', dev, set)} ${promptHTML('back', 'Leave', dev, set)} ${joined ? `<span style=\"margin-left:2rem\">${joined} here. Join again to begin.</span>` : ''}`;\n  }\n  joinKbm() {\n    const seats = this.seats;\n    if (seats.some((s) => s && s.source === 'kbm')) { this.toPlaylist(); return; }\n    const i = seats.findIndex((s) => !s);\n    if (i < 0) return;\n    seats[i] = { source: 'kbm', name: NAMES[i], pad: -1 };\n    this.game.audio.sfx('uiConfirm');\n    this.renderMats();\n  }\n  joinPad(p) {\n    const seats = this.seats;\n    if (seats.some((s) => s && s.pad === p)) { this.toPlaylist(); return; }\n    const i = seats.findIndex((s) => !s);\n    if (i < 0) return;\n    seats[i] = { source: `pad:${p}`, name: NAMES[i], pad: p };\n    this.game.audio.sfx('uiConfirm');\n    this.renderMats();\n  }\n  leave(match) {\n    const seats = this.seats;\n    const i = seats.findIndex(match);\n    if (i >= 0) { seats[i] = null; this.game.audio.sfx('uiBack'); this.renderMats(); return true; }\n    return false;\n  }\n  lobbyInput() {\n    const g = this.game, inp = g.input;\n    for (const pad of inp.pads) {\n      if (!pad.connected) continue;\n      if (pad.edge[BTN.cross]) this.joinPad(pad.index);\n      if (pad.edge[BTN.circle]) { if (!this.leave((s) => s && s.pad === pad.index) && !this.seats.some(Boolean)) { this.back(); return; } }\n    }\n    if (inp.pressed.has('enter')) this.joinKbm();\n    if (inp.pressed.has('escape') || inp.pressed.has('backspace')) { if (!this.leave((s) => s && s.source === 'kbm') && !this.seats.some(Boolean)) this.back(); }\n  }\n  back() { const g = this.game; g.go(() => (g.save.profile && g.modeReturnIsland ? g.flow.toIsland({}) : g.flow.toMenu())); }\n  fixed(dt) {\n    const g = this.game;\n    this.t += dt;\n    if (this.stage === 'lobby') { g.stepIsland(dt, 0); if (!g.wiping && this.stage === 'lobby' && !g.speech.line?.blocking) this.lobbyInput(); return; }\n    if (this.stage === 'menu' || this.stage === 'podium') { g.stepIsland(dt, 0); }\n    if (this.sub) this.sub.fixed(dt);\n    if (this.stage === 'podium') this.podiumStep(dt);\n  }\n  frame(dt) {\n    const g = this.game;\n    if (this.stage === 'lobby' || this.stage === 'menu') { g.syncIsland(dt); }\n    if (this.sub) this.sub.frame(dt);\n    if (this.stage === 'podium') this.podiumFrame(dt);\n  }\n  toPlaylist() {\n    const g = this.game;\n    this.stage = 'menu';\n    g.ui.only({\n      name: 'playlist', prompts: [['use', 'Choose'], ['back', 'Back']], back: () => this.lobby(),\n      build: (s) => {\n        s.el.append(h('div.h2', { style: 'margin-top:8rem' }, 'What shall we do?'));\n        const col = h('div.col', { style: 'margin-top:3rem' });\n        s.el.append(col);\n        col.append(s.item(h('div', 'Quick Class (three random)'), { use: () => this.quick() }));\n        col.append(s.item(h('div', 'Pick three'), { use: () => this.pick() }));\n      },\n    });\n  }\n  couchIds() { return Object.keys(EVENTS).filter((id) => EVENTS[id].couch && hasEvent(id)); }\n  quick() {\n    const r = rng('groupclass'), pool = this.couchIds(), out = [];\n    while (out.length < 3 && pool.length) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n    this.playlist = out;\n    this.runNext();\n  }\n  pick() {\n    const g = this.game;\n    const ids = this.couchIds();\n    const chosen = [];\n    const pages = [];\n    for (let i = 0; i < ids.length; i += 6) pages.push(ids.slice(i, i + 6));\n    g.ui.only({\n      name: 'pick', prompts: [['use', 'Choose'], ['page', 'Pages'], ['back', 'Back']], back: () => this.toPlaylist(),\n      build: (s) => {\n        const title = h('div.h2', { style: 'margin-top:6rem' }, 'Pick three');\n        const box = h('div.dev-grid', { style: 'margin-top:2rem' });\n        const left = h('div.tag', { style: 'margin-top:2rem;font-size:3.4rem' }, '0 of 3');\n        s.el.append(title, box, left);\n        const render = (pg) => {\n          box.innerHTML = '';\n          s.clearItems();\n          for (const id of pages[pg]) {\n            const el = h('div', EVENTS[id].title + (chosen.includes(id) ? ' ✓' : ''));\n            box.append(s.item(el, { use: () => {\n              if (chosen.includes(id)) chosen.splice(chosen.indexOf(id), 1); else chosen.push(id);\n              el.textContent = EVENTS[id].title + (chosen.includes(id) ? ' ✓' : '');\n              left.textContent = `${chosen.length} of 3`;\n              if (chosen.length >= 3) { this.playlist = chosen.slice(0, 3); this.runNext(); }\n            } }));\n          }\n          s.setFocus(0, true);\n        };\n        if (pages.length > 1) s.pager(pages.length, render);\n        render(0);\n      },\n    });\n  }\n  lanes() {\n    return this.seats.map((s, i) => (s ? { kind: 'local', name: s.name, colour: SEAT_COLOURS[i], source: s.source, seat: i } : null)).filter(Boolean);\n  }\n  runNext() {\n    const g = this.game;\n    if (!this.playlist.length) { g.go(() => this.podium()); return; }\n    const id = this.playlist.shift();\n    const self = this;\n    g.go(() => {\n      g.ui.clear();\n      self.stage = 'event';\n      if (self.sub) { self.sub.exit(); self.sub = null; }\n      self.sub = new EventRun(g, {\n        id, tier: 0, lanes: self.lanes(), mode: 'group',\n        onResult: function* onResult(ev, results) {\n          const sorted = results.filter((r) => r.lane.kind === 'local').sort((a, b) => b.form - a.form);\n          sorted.forEach((r, i) => { self.points[r.lane.seat] += POINTS[i] ?? 0; });\n          let done = false;\n          const winner = sorted[0];\n          const list = h('div.col', sorted.map((r, i) => h('div.tag', { style: `font-size:3.6rem;border-color:${r.lane.colour}` }, `${i + 1}. ${r.lane.name}: ${Math.round(r.form)} · +${POINTS[i] ?? 0}`)));\n          showResults(g, { ev, result: winner, title: ev.data.title, onContinue: () => { done = true; }, extra: list });\n          yield () => done;\n          g.ui.clear();\n          self.runNext();\n        },\n      });\n      self.sub.enter();\n      self.ev = self.sub.ev;\n    });\n  }\n  podium() {\n    const g = this.game;\n    if (this.sub) { this.sub.exit(); this.sub = null; }\n    this.ev = null;\n    this.stage = 'podium';\n    g.ui.clear();\n    g.setIsland('far', 40, -120);\n    g.sea.setLevel(-3);\n    g.palette.set('golden', 1);\n    g.audio.sting('exemplary');\n    g.audio.music('levelBest');\n    const order = this.seats.map((s, i) => (s ? { i, name: s.name, pts: this.points[i] } : null)).filter(Boolean).sort((a, b) => b.pts - a.pts);\n    const set = this.podiumSet = G('podium');\n    add(set, M(geo.cyl(10, 11, 1, 28), 0x8CCB6A, 0, -0.5, 0));\n    const heights = [2.1, 1.4, 0.9, 0.5];\n    const xs = [0, -2.3, 2.3, 4.5];\n    const cols = [0xF5B700, 0xBFC6CF, 0xC78B4A, CREAM];\n    const blocks = this.blocks = [];\n    this.dolls = [];\n    order.forEach((o, k) => {\n      const b = M(geo.box(2.2, heights[k], 2.2), cols[k], xs[k], heights[k] / 2, 0);\n      set.add(b);\n      blocks.push(b);\n      const d = new Doll({ shirt: SEAT_COLOURS[o.i] });\n      d.flatFeet = false;\n      d.root.position.set(xs[k], heights[k], 0);\n      d.rig.loop(k === 0 ? 'cheer' : 'clap');\n      set.add(d.root);\n      this.dolls.push({ d, k, h: heights[k], x: xs[k], vy: 0, fell: false });\n    });\n    g.scene.add(set);\n    g.focus(0, 0, 0, 14);\n    g.rig.shot(0, 4, 13, 0, 2.2, 0, { fov: 38, rate: 2, snap: true });\n    this.podT = 0;\n    g.speech.say('trudy', line('trudy', 'podium'), { auto: 4 });\n    g.ui.only({\n      name: 'podium', prompts: [['use', 'Back to the menu']],\n      build: (s) => {\n        s.el.append(h('div.h1', { style: 'margin-top:2rem' }, 'Podium'));\n        s.el.append(h('div.col', order.map((o, k) => h('div.podium-line.tag', { style: 'position:absolute;right:9rem;top:' + (22 + k * 8) + 'rem;font-size:4rem' }, `${k + 1}. ${o.name}: ${o.pts}`))));\n        s.el.append(s.item(h('div', { style: 'position:absolute;bottom:12rem' }, 'Back to the menu'), { use: () => g.go(() => g.flow.toMenu()) }));\n      },\n    });\n  }\n  podiumStep(dt) {\n    this.podT += dt;\n    if (this.podT > 5 && !this.tipped) {\n      // It tips over. Of course it does.\n      this.tipped = true;\n      this.game.audio.sfx('fall');\n      this.game.comic.pop('CLACK!', 0, 3.4, 0);\n      this.game.rig.shake(0.1);\n    }\n  }\n  podiumFrame(dt) {\n    const k = this.tipped ? Math.min(1, (this.podT - 5) / 1.2) : 0;\n    if (this.podiumSet) {\n      for (const b of this.blocks) { b.rotation.z = -k * k * 0.9; b.position.x += 0; }\n      for (const o of this.dolls) {\n        if (this.tipped && !o.fell) { o.fell = true; o.d.rig.loop('flop'); }\n        if (o.fell) { o.d.root.position.y = Math.max(0.05, o.h * (1 - k * k)); o.d.root.position.x = o.x + k * k * 2.5; o.d.root.rotation.z = -k * 1.2; }\n        o.d.update(dt);\n      }\n    }\n  }\n  exit() {\n    const g = this.game;\n    if (this.sub) { this.sub.exit(); this.sub = null; }\n    if (this.podiumSet) { g.scene.remove(this.podiumSet); this.podiumSet = null; }\n    g.ui.clear();\n    g.speech.clear();\n  }\n}\nexport { DISCIPLINE_ORDER, RED, TEAL };\nEOF\ncat > src/game/session.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { SESSION_SET, EVENTS } from '../data/events.js';\nimport { EventRun } from './eventRun.js';\nimport { Doll } from '../art/doll.js';\nimport { useSessionStreams, rng } from '../core/rng.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { BTN } from '../input/input.js';\nimport { hasEvent } from '../events/index.js';\nimport { TITLE, GOAL, medalFor } from '../data/config.js';\nimport { clipIndex, clipName, GHOST_CLIPS } from './ghost.js';\nimport { openSessionOptions } from '../ui/screens/sessionOptions.js';\nimport { installPause } from '../ui/screens/pause.js';\n\nconst INTRO = 6, PLAY = 50, SCORE = 6, SLOT = INTRO + PLAY + SCORE;\nconst AWARDS = ['Suspiciously Still', 'Consistently Floored', 'Mostly Upright', 'Politely Attending'];\n\n/** A round in the AI Hub: three classes, on the hub's clock, with everyone else as ghosts in the next lanes. */\nexport function runSession(game, info) {\n  const AIHub = window.AIHub;\n  game.inSession = true;\n  useSessionStreams(true);\n  installPause(game);\n  game.flow = { leaveClass() {}, toTitle() {} };\n  const sess = new SessionMode(game, AIHub, info);\n  game.setMode(sess, 'session');\n  AIHub.ready();\n  return sess;\n}\n\nclass SessionMode {\n  constructor(game, hub, info) {\n    this.game = game; this.hub = hub; this.info = info; this.name = 'session'; this.canPause = false;\n    this.card = null; this.started = false; this.slot = -1; this.total = 0; this.scores = []; this.resultSent = false; this.ended = false; this.falls = 0; this.best = 0;\n    this.lastProgress = -9; this.lastSend = -9; this.ghosts = new Map(); this.options = false; this.run = null; this.lastT = 0; this.cardEl = null;\n    this.me = info.me;\n  }\n  enter() {\n    const { game, hub } = this;\n    this.slots = this.deal();\n    hub.on('card', (c) => { this.card = c; this.renderCard(); });\n    hub.on('start', () => { this.started = true; });\n    hub.on('message', (d, from) => this.onMessage(d, from));\n    hub.on('leave', (l) => this.onLeave(l));\n    hub.on('time-up', () => this.finish());\n    hub.on('end', () => this.onEnd());\n    game.ui.clear();\n    this.stageSet();\n    this.renderCard();\n  }\n  deal() {\n    const r = rng('deal');\n    const pool = SESSION_SET.filter(hasEvent).slice(), out = [];\n    while (out.length < 3 && pool.length) out.push(pool.splice(Math.floor(r() * pool.length), 1)[0]);\n    return out;\n  }\n  /** The class lined up on the deck, Trudy with a clipboard, the music. */\n  stageSet() {\n    const g = this.game;\n    g.setIsland('home');\n    g.palette.set('dawn', 0.5);\n    g.programme.syncIsland();\n    g.phys.snapTilt();\n    g.audio.music('levelBest');\n    g.art.trudy.root.position.set(14, 0.52, 0);\n    g.art.trudy.rig.loop('clipboard');\n    this.cardDolls = this.info.players.map((p, i) => {\n      const d = new Doll({ shirt: p.color });\n      d.root.position.set(15 + (i - (this.info.players.length - 1) / 2) * 1.6, 0.54, -3);\n      d.rig.loop('breathe');\n      g.art.group.add(d.root);\n      return d;\n    });\n    g.rig.shot(15, 3.5, 7.4, 15, 1.2, -3, { fov: 38, snap: true });\n  }\n  clearCardSet() {\n    if (!this.cardDolls) return;\n    for (const d of this.cardDolls) this.game.art.group.remove(d.root);\n    this.cardDolls = null;\n    if (this.cardScr) { this.game.ui.close(this.cardScr); this.cardScr = null; }\n  }\n  renderCard() {\n    const { game, card, info } = this;\n    if (this.started && this.time() >= 0) return;\n    if (!this.cardScr) {\n      this.cardScr = game.ui.open({\n        name: 'card', passive: true,\n        build: (s) => {\n          this.cardRoot = h('div.card-session');\n          s.el.append(this.cardRoot);\n          s.el.style.pointerEvents = 'none';\n        },\n      });\n    }\n    const root = this.cardRoot;\n    root.innerHTML = '';\n    root.append(h('div.h1', { style: 'margin:0' }, TITLE));\n    const seats = h('div.row');\n    const ready = (card && card.ready) || [];\n    info.players.forEach((p) => {\n      const seat = h('span.seat', h('i', { style: `background:${p.color}` }), document.createTextNode(p.name), ready.includes(p.id) ? h('b', ' ✓') : null);\n      seats.append(seat);\n    });\n    root.append(seats);\n    root.append(h('div.tag', { style: 'font-size:3.6rem' }, GOAL));\n    const dev = game.input.lastDevice, set = game.save.settings.glyphs;\n    const row = h('div.row', { html: [['lean', 'Lean'], ['feet', 'Feet'], ['flail', 'Flail'], ['hop', 'Hop']].map(([v, t]) => promptHTML(v, t, dev, set)).join('') });\n    root.append(row);\n    let timeText = '...';\n    if (card) {\n      if (card.starting) timeText = 'Starting...';\n      else if (card.paused) timeText = 'Paused';\n      else if (card.left !== null && card.left !== undefined) timeText = `${Math.ceil(card.left / 1000)} s`;\n    }\n    root.append(h('div.tag', { style: 'font-size:4.4rem;font-weight:700' }, timeText));\n    const act = h('div.row');\n    const rd = h('div.item', { style: 'pointer-events:auto' }, h('span', { html: promptHTML('use', 'Ready', dev, set) }));\n    rd.addEventListener('click', () => this.hub.answer('ready'));\n    const more = h('div.item', { style: 'pointer-events:auto' }, h('span', { html: promptHTML('more', card && card.asked ? 'Take back' : 'More time', dev, set) }));\n    more.addEventListener('click', () => this.hub.answer('more'));\n    act.append(rd, more);\n    root.append(act);\n  }\n  time() { return this.hub.time(); }\n  cardInput() {\n    const { game, hub } = this;\n    const inp = game.input;\n    if (inp.pressed.has('enter') || inp.pads.some((p) => p.connected && p.edge[BTN.cross])) hub.answer('ready');\n    if (inp.pressed.has('m') || inp.pads.some((p) => p.connected && p.edge[BTN.triangle])) hub.answer('more');\n  }\n  fixed(dt) {\n    if (this.ended) return;\n    const { game } = this;\n    const T = this.time();\n    if (T === -Infinity || T < -3.5e3 || !this.started) {\n      this.cardInput();\n      game.stepIsland(dt, 0);\n      return;\n    }\n    const sec = T / 1000;\n    if (sec < 0) {\n      this.cardInput();\n      game.stepIsland(dt, 0);\n      const c = Math.ceil(-sec);\n      if (c !== this.lastCount) { this.lastCount = c; game.hud.show(true); game.hud.flash(String(c), 0.7); game.audio.sfx('metronome', { vel: 1 }); }\n      return;\n    }\n    if (this.cardDolls) { this.clearCardSet(); game.ui.clear(); }\n    const slot = Math.floor(sec / SLOT);\n    const local = sec - slot * SLOT;\n    if (slot >= this.slots.length) { this.finish(); if (this.run) this.closeRun(); this.waiting(); return; }\n    if (slot !== this.slot) this.enterSlot(slot);\n    const stage = local < INTRO ? 'intro' : local < INTRO + PLAY ? 'play' : 'score';\n    if (stage !== this.stageName) this.enterStage(stage);\n    if (this.run) this.run.ev.fixed(dt);\n    this.net(sec);\n    if (!this.options && game.input.verb('pause')) { this.options = true; openSessionOptions(game, () => { this.options = false; }); }\n  }\n  enterSlot(slot) {\n    const { game, info } = this;\n    this.closeRun();\n    this.slot = slot;\n    this.stageName = null;\n    const id = this.slots[slot];\n    const data = EVENTS[id];\n    const meSeat = info.players.findIndex((p) => p.id === info.me);\n    const lanes = [{ kind: 'local', name: info.players[meSeat]?.name || 'You', colour: info.players[meSeat]?.color || '#2CB5A0', source: 'any', playerId: info.me }];\n    for (const p of info.players) if (p.id !== info.me && !this.gone?.has(p.id)) lanes.push({ kind: 'ghost', name: p.name, colour: p.color, playerId: p.id });\n    this.run = new EventRun(game, { id, tier: 0, lanes, mode: 'session', config: data.sessionConfig, skipIntro: true, skipCountdown: true, onResult: function* none() { /* The session reports at the end. */ } });\n    // The session owns the timeline: build the set and hold it for the intro.\n    this.run.enter();\n    this.run.handle.cancel();\n    this.run.handle = null;\n    this.ghosts = new Map();\n    game.hud.setScore(this.total, 'Score');\n    this.ghostTags();\n  }\n  ghostTags() {\n    const { game } = this;\n    if (this.tagLayer) this.tagLayer.remove();\n    this.tagLayer = h('div', { style: 'position:absolute;inset:0;pointer-events:none' });\n    game.hud.el.append(this.tagLayer);\n    for (const lane of this.run.ev.lanes) {\n      if (lane.kind !== 'ghost') continue;\n      const tag = h('div.seat', { style: 'position:absolute;transform:translate(-50%,-120%);font-size:3rem' });\n      tag.append(document.createTextNode(lane.name));\n      this.tagLayer.append(tag);\n      lane.tagEl = tag;\n      lane.doll.root.visible = false;\n      lane.net = null;\n    }\n  }\n  enterStage(stage) {\n    const { game } = this;\n    const ev = this.run.ev;\n    this.stageName = stage;\n    if (stage === 'intro') {\n      ev.phase = 'intro';\n      game.hud.show(false);\n      this.introScr = game.ui.only({\n        name: 'slotIntro', passive: true,\n        build: (s) => {\n          const d = ev.data;\n          const box = h('div.tag', { style: 'margin-top:16rem;max-width:140rem;text-align:center' });\n          box.append(h('div', { style: 'font-size:7rem;font-weight:700' }, d.title), h('div', { style: 'font-size:3.8rem' }, d.line), h('div.row', { html: d.verbs.map(([v, t]) => promptHTML(v, t, game.input.lastDevice, game.save.settings.glyphs)).join(''), style: 'margin-top:1.6rem' }));\n          s.el.append(h('div.h2', `Class ${this.slot + 1} of ${this.slots.length}`), box);\n        },\n      });\n      game.audio.music(ev.data.music, ev.musicOpts ? ev.musicOpts() : {});\n    } else if (stage === 'play') {\n      if (this.introScr) { game.ui.close(this.introScr); this.introScr = null; }\n      game.hud.show(true);\n      ev.begin();\n      game.audio.sfx('bell');\n    } else {\n      const r = ev.laneResult(ev.lanes[0]);\n      const pts = Math.round(Math.max(0, r.form) * 10);\n      this.scores[this.slot] = pts;\n      this.total = this.scores.reduce((a, b) => a + (b || 0), 0);\n      this.falls += ev.lanes[0].falls || 0;\n      this.best = Math.max(this.best, r.form);\n      ev.phase = 'done';\n      game.audio.sfx('whistle');\n      game.hud.show(false);\n      const m = medalFor(r.form);\n      game.audio.sting(m.id);\n      this.scoreScr = game.ui.only({ name: 'slotScore', passive: true, build: (s) => {\n        s.el.append(h('div.h2', { style: 'margin-top:18rem' }, ev.data.title), h('div.bignum', String(pts)), h('div.tag', { style: 'font-size:3.6rem' }, `${m.name} · Total ${this.total}`));\n      } });\n    }\n  }\n  closeRun() {\n    if (this.run) {\n      const { game } = this;\n      if (this.scoreScr) { game.ui.close(this.scoreScr); this.scoreScr = null; }\n      if (this.introScr) { game.ui.close(this.introScr); this.introScr = null; }\n      if (this.tagLayer) { this.tagLayer.remove(); this.tagLayer = null; }\n      this.run.exit();\n      this.run = null;\n    }\n  }\n  scoreNow() {\n    if (this.run && this.stageName === 'play') {\n      const r = this.run.ev.laneResult(this.run.ev.lanes[0]);\n      return this.total + Math.round(Math.max(0, r.form) * 10);\n    }\n    return this.total;\n  }\n  net(sec) {\n    const { hub } = this;\n    if (sec - this.lastSend >= 0.1) {\n      this.lastSend = sec;\n      const lane = this.run && this.run.ev.lanes[0];\n      const b = lane && lane.bal;\n      const data = {\n        t: 'g', a: this.slot, x: lane ? +lane.doll.root.position.x.toFixed(2) : 0, z: lane ? +lane.doll.root.position.z.toFixed(2) : 0,\n        lx: b ? +b.leanX.toFixed(3) : 0, lz: b ? +b.leanZ.toFixed(3) : 0, c: lane ? clipIndex(lane.doll.rig.currentName) : 0, f: lane && lane.fallen ? 1 : 0, s: this.scoreNow(),\n      };\n      hub.send(data, { reliable: false });\n    }\n    if (sec - this.lastProgress >= 1) {\n      this.lastProgress = sec;\n      const name = this.run ? this.run.ev.data.title : TITLE;\n      hub.progress({ score: this.scoreNow(), label: `${name} ${this.scoreNow()}` });\n    }\n  }\n  onMessage(d, from) {\n    if (!d || d.t !== 'g' || !this.run) return;\n    const lane = this.run.ev.lanes.find((l) => l.kind === 'ghost' && l.laneSpecId === undefined && this.laneFor(l) === from);\n    if (!lane) return;\n    if (d.a !== this.slot) { lane.doll.root.visible = false; lane.net = null; return; }\n    const now = this.time() / 1000;\n    if (!lane.net) lane.net = { prev: d, next: d, t0: now, t1: now + 0.1 };\n    else { lane.net.prev = lane.net.next; lane.net.next = d; lane.net.t0 = now; lane.net.t1 = now + 0.15; }\n    lane.doll.root.visible = true;\n  }\n  laneFor(lane) { return lane.ev.laneSpecs[lane.id].playerId; }\n  onLeave(l) {\n    this.gone = this.gone || new Set();\n    this.gone.add(l.id);\n    if (!this.run) return;\n    const lane = this.run.ev.lanes.find((x) => x.kind === 'ghost' && this.laneFor(x) === l.id);\n    if (lane) { lane.doll.root.visible = false; if (lane.tagEl) lane.tagEl.remove(); lane.gone = true; }\n  }\n  frame(dt) {\n    const { game } = this;\n    if (this.ended) return;\n    if (this.cardDolls) { game.syncIsland(dt); for (const d of this.cardDolls) d.update(dt); game.art.trudy.update(dt); }\n    if (!this.run) return;\n    const ev = this.run.ev;\n    ev.frame(dt);\n    const now = this.time() / 1000;\n    for (const lane of ev.lanes) {\n      if (lane.kind !== 'ghost' || lane.gone) continue;\n      const n = lane.net;\n      if (!n) continue;\n      const k = Math.max(0, Math.min(1, (now - n.t0) / Math.max(0.01, n.t1 - n.t0)));\n      const lx = n.prev.lx + (n.next.lx - n.prev.lx) * k, lz = n.prev.lz + (n.next.lz - n.prev.lz) * k;\n      const px = n.prev.x + (n.next.x - n.prev.x) * k, pz = n.prev.z + (n.next.z - n.prev.z) * k;\n      // Their copy has its own lane at x = 0 or its own spot: show them beside you, in the next lane.\n      lane.doll.root.position.set(lane.x + (px - (n.prev.x)), 0, pz);\n      lane.doll.root.rotation.set(lz, 0, -lx);\n      const clip = n.next.f ? 'flop' : clipName(n.next.c);\n      if (lane.doll.rig.currentName !== clip) lane.doll.rig.loop(clip);\n      lane.doll.update(dt);\n      if (lane.tagEl) {\n        const p = lane.doll.root.position.clone(); p.y += 2.1;\n        p.project(game.camera);\n        lane.tagEl.style.left = `${(p.x * 0.5 + 0.5) * 100}%`;\n        lane.tagEl.style.top = `${(-p.y * 0.5 + 0.5) * 100}%`;\n      }\n    }\n    game.hud.setScore(this.scoreNow(), 'Score');\n  }\n  /** Once, at the end or on time-up. Grace is 5 s. */\n  finish() {\n    if (this.resultSent) return;\n    this.resultSent = true;\n    const score = this.scoreNow();\n    const stats = { 'Floor Exercises': this.falls, 'Best medal': medalFor(this.best).name };\n    const award = this.falls === 0 && this.best >= 85 ? AWARDS[0] : this.falls > 3 ? AWARDS[1] : this.best >= 40 ? AWARDS[2] : AWARDS[3];\n    this.hub.result({ score, stats, awards: [{ title: award, detail: `${TITLE} says so.` }] });\n  }\n  waiting() {\n    const { game } = this;\n    if (this.waitScr) return;\n    game.hud.show(false);\n    this.waitScr = game.ui.only({ name: 'waiting', passive: true, build: (s) => {\n      s.el.append(h('div.h2', { style: 'margin-top:26rem' }, 'Waiting for the others'), h('div.tag', { style: 'font-size:3.8rem' }, 'Trudy is counting. She says she is not.'));\n    } });\n    game.setIsland('home');\n    game.rig.shot(15, 6, 28, 8, 1, -2, { fov: 38, rate: 1 });\n  }\n  /** Stop input, sending and all sound, and keep the last frame. */\n  onEnd() {\n    const { game } = this;\n    this.ended = true;\n    game.audio.stopMusic(0.05);\n    game.audio.silence();\n    game.speech.clear();\n    game.ui.clear();\n    game.hud.show(false);\n    game.mode = null;\n  }\n  botDrive() { return null; }\n}\nexport { GHOST_CLIPS };\nEOF\ncat > src/game/ghost.js <<'EOF'\n// Ghost lanes play clips by index, sent over the wire. They never touch anyone's physics.\nexport const GHOST_CLIPS = ['idle', 'breathe', 'holdSlab', 'squat', 'hipCircle', 'stepL', 'stepR', 'diveReady', 'spread', 'tuck', 'pike', 'flail', 'hop', 'land', 'pose0', 'pose1', 'pose2', 'pose3', 'pose4', 'pose5', 'pose6', 'pose7', 'stand', 'flop'];\nexport const clipIndex = (name) => Math.max(0, GHOST_CLIPS.indexOf(name));\nexport const clipName = (i) => GHOST_CLIPS[i] || 'idle';\nEOF\ncat > src/ui/screens/sessionOptions.js <<'EOF'\nimport { h } from '../dom.js';\n\n/** In a session, Options opens volumes only, and it doesn't pause. */\nexport function openSessionOptions(game, onClose) {\n  const set = game.save.settings;\n  const save = () => { game.save.write(); game.applySettings(); };\n  let scr = null;\n  const close = () => { game.ui.close(scr); onClose(); };\n  scr = game.ui.open({\n    name: 'sessionOptions', prompts: [['back', 'Back']], back: close,\n    build: (s) => {\n      s.el.append(h('div.h2', { style: 'margin-top:10rem' }, 'Volumes'));\n      const col = h('div.col');\n      s.el.append(col);\n      col.append(game.ui.slider(s, 'Music', () => set.music, (v) => { set.music = v; save(); }));\n      col.append(game.ui.slider(s, 'Sound', () => set.sound, (v) => { set.sound = v; save(); }));\n      col.append(game.ui.slider(s, 'Voice', () => set.voice, (v) => { set.voice = v; save(); }));\n    },\n  });\n}\nEOF\nnode tools/build.mjs -v 2>&1 | tail -30","description":"Write Check-In, ending, attract, dev mode, group class and session","timeout":120000}}}
