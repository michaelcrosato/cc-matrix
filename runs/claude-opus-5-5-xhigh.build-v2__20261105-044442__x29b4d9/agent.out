is.callT < 0.12) ? 1 : 0;\n    out.footL = v; out.footR = v;\n    out.flail = !lane.fallen && lane.bal.lean > 0.52 && lane.bal.flailCool <= 0;\n    return dueIn;\"\"\",\"\"\"    // One timing error per call, early or late.\n    const d = bot.data;\n    if (d.call !== this.callN) { d.call = this.callN; d.lateBy = d.err ?? 0; d.err = bot.timing(); }\n    const since = this.callT === undefined ? 9 : this.t - this.callT;\n    const early = d.err < 0 && this.next <= -d.err;\n    const late = d.lateBy > 0 ? since >= d.lateBy && since < d.lateBy + 0.12 : since < 0.12;\n    const v = early || late ? 1 : 0;\n    out.footL = v; out.footR = v;\n    out.flail = !lane.fallen && lane.bal.lean > 0.42 + bot.s.lag * 0.3 && lane.bal.flailCool <= 0;\"\"\")\n# Quick Lean: reaction is the first .15 of lean, reached .35 s after a full push, which is what the score's .35 s stands for. The next prompt waits for the middle.\np='src/game/checkin.js'\nsub(p,\"c.prompts.length < 6 && r < 0.25) {\",\"c.prompts.length < 6 && r < 0.12) {\")\nsub(p,\"if (proj > 0.4 || c.active.t > 2) {\",\"if (proj > 0.15 || c.active.t > 2) {\")\nEOF\ngrep -n \"callN\" src/events/tug.js | cut -c1-120; grep -n \"timingOff\\|dueIn\" -r src tools | cut -c1-110; node tools/build.mjs >/dev/null 2>&1; echo build $?; cat > notes/scratch/noise.mjs <<'EOF'\nimport { launch, logicPage } from '../../tools/lib.mjs';\nconst b = await launch(); let p = await logicPage(b);\nconst mean = (a) => a.reduce((x, y) => x + y, 0) / a.length;\nconst run = (o) => p.evaluate((o) => {\n  const T = window.__TEST__, g = T.game;\n  g.save.settings.autoBreathe = false; T.setSeed(o.seed); T.startEvent(o.id, o.tier, {});\n  const ev = g.currentEvent, l = ev.lanes[0]; if (o.setup) Object.assign(l, o.setup);\n  T.bot(o.skill); T.advance(0.02); if (l.testBot) l.testBot.noiseF = o.f;\n  let t = 0; while (t < 200 && !ev.isDone()) { T.advance(0.5); t += 0.5; if (l.testBot) l.testBot.noiseF = o.f; }\n  T.bot(null); const r = ev.laneResult(l);\n  const x = { form: r.form, share: o.id === 'stillWater' ? 100 * ev.inT / Math.max(1, Math.min(ev.t, ev.cfg.time)) : r.form }; T.goto('menu'); return x;\n}, o);\nconst row = async (label, id, tier, plan, setup, f) => {\n  const c = [];\n  for (const skill of ['average', 'clumsy']) { const v = []; for (const seed of [1, 2, 3]) v.push((await run({ id, tier, skill, seed, setup, f })).share); c.push(mean(v).toFixed(0)); }\n  return `${label} ${c.join('/')} [${plan}]`;\n};\nfor (const f of [0.15, 0.3, 0.5, 1, 2.5]) {\n  const a = [];\n  for (const [t, plan] of [[0, '95/80'], [1, '71/48'], [2, '49/31']]) a.push(await row(`SW${t + 1}`, 'stillWater', t, plan, null, f));\n  for (const [t, plan] of [[0, '66/54'], [1, '58/46'], [2, '41/33']]) a.push(await row(`P${t + 1}`, 'poses', t, plan, { noBreath: true }, f));\n  console.log(`f ${String(f).padEnd(4)} | ${a.join(' | ')}`);\n  await p.context().close(); p = await logicPage(b);\n}\nawait b.close();\nEOF\ntimeout 560 node notes/scratch/noise.mjs 2>&1 | cut -c1-210","description":"Apply bot and Check-In fixes, sweep bot noise frequency","timeout":590000}},"wire_ingest_context":{"toolu_01DV6aBtiahv2QSv2LYvRwCT":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261105-044442__x29b4d9/work/WeFib-WiiFit-claude-opus-5-5-xhigh-20261105-044442"}}}
