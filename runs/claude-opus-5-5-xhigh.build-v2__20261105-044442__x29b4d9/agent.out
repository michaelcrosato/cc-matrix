game.audio.sfx('uiMove'); }\n    return el;\n  }\n  /** Cycle through named options with left, right or use. */\n  choice(s, label, options, get, set) {\n    const val = h('span.val');\n    const el = h('div.toggle', h('span', label), val);\n    const idx = () => Math.max(0, options.findIndex((o) => o[0] === get()));\n--- syncIsland callers\nsrc/game/jar.js:59:    g.programme.syncIsland();\nsrc/game/jar.js:175:    g.syncIsland(dt);\nsrc/ui/screens/settings.js:42:          col.append(s.item(h('div', 'Reset save'), { use: () => confirmDialog(game, 'Forg\nsrc/game/programme.js:64:  syncIsland() { if (this.game.phys) this.game.phys.setRest(this.restDeg()); }\nsrc/game/programme.js:105:    this.syncIsland();\nsrc/game/programme.js:151:    this.syncIsland();\nsrc/game/programme.js:153:  selectProfile(slot) { this.game.save.data.activeProfile = slot; this.game.save.write(); this\nsrc/game/director.js:94:    this.programme.syncIsland();\nsrc/game/director.js:161:  syncIsland(dt) {\nsrc/events/islandLoop.js:32:    g.programme.syncIsland();\nsrc/events/islandLoop.js:156:    g.syncIsland(dt);\nsrc/game/groupclass.js:31:    g.programme.syncIsland();\nsrc/game/groupclass.js:112:    if (this.stage === 'lobby' || this.stage === 'menu') { g.syncIsland(dt); }\nsrc/game/attract.js:60:    g.syncIsland(dt);\nsrc/game/attract.js:154:    if (this.titlePause > 0) g.syncIsland(dt);\nsrc/game/devmode.js:37:    { label: 'Next step', use: () => { const p = g.save.profile; if (p) { const n = g.programme.n\nsrc/game/devmode.js:65:    { label: 'Reset save', use: () => { g.save.reset(); g.programme.syncIsland(); closeAll(); g.f\nsrc/game/devmode.js:140:  g.programme.syncIsland();\nsrc/game/hub.js:42:    g.programme.syncIsland();\nsrc/game/hub.js:446:    g.syncIsland(dt);\nsrc/game/flow.js:31:    g.programme.syncIsland();\nsrc/game/flow.js:53:    g.syncIsland(dt);\nsrc/game/flow.js:232:  game.programme.syncIsland();\nsrc/game/ending.js:110:    g.syncIsland(dt);\nsrc/events/grandHold.js:270:    g.s