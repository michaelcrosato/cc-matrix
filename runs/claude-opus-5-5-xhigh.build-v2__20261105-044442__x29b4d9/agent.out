{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmxR8UgBRemRqXeMseL","type":"message","role":"assistant","content":[{"type":"text","text":"Next are the remaining events, built to the plan's measured numbers. Stillness comes first."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16914,"cache_read_input_tokens":366409,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16914},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"000b2066-f4e9-4970-be39-627fecc7ae08","timestamp":"2026-11-05T12:26:40.856Z","request_id":"req_011CgjmxQnQLF2nmXT927cSQ"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmxR8UgBRemRqXeMseL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GFMQDKUWJq2mnMg8JbaHWb","name":"Bash","input":{"command":"sed -i \"s/this.data = EVENTS\\[this.constructor.id\\];/this.data = EVENTS[this.constructor.id] || spec.data;/; s/this.cfg = spec.config || this.data.tiers\\[this.tier\\];/this.cfg = spec.config || (this.data.tiers ? this.data.tiers[this.tier] : {});/\" src/events/base.js\ncat > src/events/poses.js <<'EOF'\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { post, buoy, palm, TEAK, WOOD_D, CREAM, TEAL } from '../art/props.js';\nimport { Heron } from '../art/cast.js';\nimport { POSES } from '../data/poses.js';\nimport { tun } from '../core/tuning.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst GLIDE = 3;\n/** Follow the ring to a pose, then hold while the ring shrinks. Breath is how you get good at it. */\nexport class Poses extends EventBase {\n  static id = 'poses';\n  constructor(spec) {\n    super(spec);\n    this.balanceParams = { maxLean: 14, margin: 0.45 };\n    this.breathOn = true; this.seaLevel = -1.4;\n    const pool = POSES.slice();\n    this.seq = [];\n    for (let i = 0; i < this.cfg.poses; i++) this.seq.push(pool.splice(Math.floor(this.r() * pool.length), 1)[0]);\n    this.index = -1; this.stage = 'wait'; this.stageT = 0; this.prev = { x: 0, z: 0 };\n    this.ring = { x: 0, z: 0, r: this.cfg.ringStart, on: false };\n    this.total = this.seq.length * (GLIDE + this.cfg.hold);\n    this.maxEarn = 0;\n    this.outT = 0; this.stillT = 0; this.lastSay = -9;\n  }\n  setupLane(lane) { lane.earn = 0; lane.inRing = false; lane.doll.rig.loop('breathe'); }\n  buildSet() {\n    const g = this.group;\n    const n = this.lanes.length, r = Math.max(5, 1.6 + n * 1.6);\n    add(g, M(geo.cyl(r, r, 0.3, 40), TEAK, 0, -0.15, 0));\n    for (let i = 0; i < 10; i++) { const a = (i / 10) * 6.283; add(g, post(5, 0.16, WOOD_D, Math.cos(a) * (r - 0.5), -5.2, Math.sin(a) * (r - 0.5))); add(g, M(geo.sphere(0.13, 10, 8), CREAM, Math.cos(a) * (r - 0.2), 0.12, Math.sin(a) * (r - 0.2))); }\n    for (let i = 0; i < 5; i++) add(g, M(geo.box(r * 2 - 0.2, 0.012, 0.03), WOOD_D, 0, 0.004, -r + 1 + i * ((r * 2 - 2) / 4)));\n    for (const lane of this.lanes) add(g, M(geo.cyl(1.05, 1.05, 0.03, 30), 0xC24D6A, lane.x, 0.012, 0));\n    this.heron = new Heron();\n    this.heron.root.position.set(-(this.lanes.length * 1.6 + 1.3), 0, -1.1);\n    this.heron.root.rotation.y = 0.55;\n    g.add(this.heron.root);\n    const b = buoy(TEAL); b.position.set(7.5, this.seaLevel, -9); g.add(b);\n    const p = palm(3.4); p.position.set(r - 0.8, 0, -r + 0.9); g.add(p);\n    this.game.setBackdrop(40, -135);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(7.2, (n - 1) * 3.2);\n    const px = n > 1 ? 0 : 1.7;\n    this.game.rig.shot(px, 2.3, d, -0.3, 1.05, 0, { snap, rate: 4 });\n    this.inputYaw = Math.atan2(px + 0.3, d);\n  }\n  hudSetup(hud) {\n    this.poseTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, ''));\n    hud.setScore(0, 'Form');\n  }\n  start() {\n    this.stage = 'wait'; this.stageT = 0;\n    this.nextPose();\n    if (this.game.speech && this.mode === 'solo') this.game.speech.say('stillwater', line('stillwater', 'breath'), { auto: 3, top: true });\n  }\n  nextPose() {\n    this.index++;\n    if (this.index >= this.seq.length) { this.stage = 'finished'; return; }\n    const pose = this.seq[this.index];\n    this.stage = 'glide'; this.stageT = 0;\n    this.prev = { x: this.ring.x, z: this.ring.z };\n    this.ring.r = this.cfg.ringStart;\n    for (const lane of this.lanes) lane.doll.rig.loop(pose.clip, { fade: 0.6 });\n    this.heron.rig.loop(pose.demo, { fade: 0.8 });\n    if (this.poseTag) this.poseTag.textContent = pose.name;\n    if (this.mode === 'solo') this.game.speech.say('stillwater', line('stillwater', 'pose', { pose: pose.name }), { auto: 2.8, top: true });\n    this.game.audio.sfx('bell');\n  }\n  rampK() { return Math.min(1, this.t / this.total); }\n  ringEnd() { return this.cfg.ringEnd * tun.ringEnd; }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.stageT += dt;\n    const pose = this.seq[this.index];\n    if (this.stage === 'glide') {\n      const k = Math.min(1, this.stageT / GLIDE), e = k * k * (3 - 2 * k);\n      this.ring.x = this.prev.x + (pose.x - this.prev.x) * e; this.ring.z = this.prev.z + (pose.z - this.prev.z) * e;\n      if (this.stageT >= GLIDE) { this.stage = 'hold'; this.stageT = 0; }\n    } else if (this.stage === 'hold') {\n      const k = Math.min(1, this.stageT / c.hold);\n      this.ring.r = this.ramp(c.ringStart, this.ringEnd(), k);\n      const earn = 0.3 / this.ring.r;\n      this.maxEarn += earn * dt;\n      for (const lane of this.lanes) {\n        if (lane.kind === 'ghost') continue;\n        const inside = !lane.fallen && Math.hypot(lane.dotX - this.ring.x, lane.dotZ - this.ring.z) < this.ring.r;\n        lane.inRing = inside;\n        if (inside) lane.earn += earn * dt * (lane.breath.inSync ? 1.25 : 1);\n      }\n      if (this.stageT >= c.hold) this.nextPose();\n    }\n    const kk = this.rampK();\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      lane.bal.sway = this.ramp(c.sway[0], c.sway[1], kk);\n      lane.bal.tremor = this.ramp(c.tremor[0], c.tremor[1], kk);\n    }\n    const me = this.lanes[0];\n    if (me.kind === 'local' && this.stage === 'hold') {\n      this.outT = me.inRing ? 0 : this.outT + dt;\n      this.stillT = me.inRing ? this.stillT + dt : 0;\n      if (this.outT > 2.2) { this.bark('stillwater', 'leave', 2.6, 8); this.outT = 0; }\n      if (this.stillT > 4.5) { this.bark('stillwater', 'still', 2.6, 9); this.stillT = 0; }\n      if (me.bal && me.bal.lean > 0.34) this.bark('stillwater', 'shake', 2.6, 9);\n    }\n  }\n  flailed(lane) { lane.earn = Math.max(0, lane.earn - this.total * 0.012); if (lane.kind === 'local') this.bark('stillwater', 'flail', 2.2, 5); }\n  onFall(lane) { if (lane.kind === 'local') this.bark('stillwater', 'fall', 2.6, 3); }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const gx = this.ring.x, gz = this.ring.z;\n    if (lane.parkStick) { out.wishX = gx; out.wishZ = gz; } else {\n      const [x, z] = bot.steer(gx, gz);\n      out.wishX = x; out.wishZ = z;\n    }\n    out.breathe = lane.noBreath ? false : lane.breath.growing;\n    out.flail = !lane.fallen && lane.bal.lean > 0.55 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    hud.setTime(Math.max(0, this.total - this.t));\n    hud.setScore(Math.round(this.formOf(me)), 'Form');\n    for (const lane of this.lanes) lane.discView.zone = this.stage === 'finished' ? null : { x: this.ring.x, z: this.ring.z, r: this.ring.r, on: lane.inRing };\n  }\n  formOf(lane) { return this.maxEarn > 0 ? Math.min(100, (100 * lane.earn) / this.maxEarn) : 0; }\n  frameEvent(dt) { if (this.heron) this.heron.update(dt); }\n  isDone() { return this.stage === 'finished'; }\n  laneResult(lane) {\n    const form = this.formOf(lane);\n    return { form, raw: lane.earn, big: Math.round(form), stats: `${this.seq.length} poses · ${lane.falls} floor exercises` };\n  }\n}\nEOF\ncat > src/events/cairn.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add, toon } from '../art/materials.js';\nimport { bigRock, STONE, STONE_D, palm } from '../art/props.js';\nimport { Heron } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst SIZES = [[0.26, 0.09], [0.24, 0.085], [0.22, 0.08], [0.2, 0.078], [0.18, 0.074], [0.165, 0.07], [0.15, 0.066], [0.14, 0.062], [0.125, 0.058], [0.11, 0.054]];\nconst WIDE = [[0.28, 0.09], [0.27, 0.085], [0.26, 0.08], [0.25, 0.078], [0.24, 0.074], [0.23, 0.07], [0.22, 0.066], [0.21, 0.062], [0.2, 0.058], [0.19, 0.054]];\nconst SHADES = [0xCFC8B6, 0xBDB5A2, 0xD8D2C2, 0xA9A18F];\nconst _q = new THREE.Quaternion(), _v = new THREE.Vector3();\n\n/** Hold the slab level while Ms. Stillwater lowers stones onto it. */\nexport class Cairn extends EventBase {\n  static id = 'cairn';\n  constructor(spec) {\n    super(spec);\n    this.iterations = 10;\n    this.balanceParams = { margin: 0.8, ankleMax: 6 };\n    this.breathOn = true; this.seaLevel = -14;\n    this.sizes = this.cfg.wide ? WIDE : SIZES;\n    this.next = 1.5; this.dropped = 0; this.placed = 0; this.holdLeft = this.cfg.hold; this.done = false;\n    this.total = this.cfg.stones * this.cfg.every + this.cfg.hold + 1.5;\n  }\n  setupLane(lane) {\n    const b = lane.bal.body;\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.55, 0.03, 0.55).setTranslation(0, 0.95, 0).setMass(0.05).setFriction(1).setCollisionGroups(groups.doll(lane.id)), b);\n    lane.stones = []; lane.steady = 0; lane.steadyN = 0; lane.maxOn = 0;\n    const slab = G('slab', 0, 0.75 + 0.95, 0);\n    add(slab, M(geo.box(1.1, 0.06, 1.1), 0xD6CDB6));\n    lane.doll.root.add(slab);\n    lane.doll.rig.loop('holdSlab');\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length, w = Math.max(9, n * 3.2 + 6);\n    add(g, M(geo.box(w, 2.6, 7.5), STONE, 0, -1.3, 0), M(geo.box(w + 1.2, 12, 8.4), STONE_D, 0, -8, -0.3));\n    for (let i = 0; i < 7; i++) add(g, M(geo.box(w / 7 - 0.03, 0.02, 7.5), SHADES[i % 4], -w / 2 + (i + 0.5) * (w / 7), 0.002, 0));\n    for (const [x, z, s] of [[-w / 2 + 1, -2.6, 0.9], [w / 2 - 1.1, -2.8, 1.1], [w / 2 - 2.4, -3, 0.6], [-w / 2 + 2.3, -3, 0.5]]) { const r = bigRock(s, STONE_D); r.position.set(x, s * 0.5, z); g.add(r); }\n    // Old cairns at the back, for company.\n    for (const x of [-w / 2 + 2, w / 2 - 3.4]) {\n      let y = 0;\n      for (const [r, hh] of [[0.4, 0.14], [0.32, 0.12], [0.26, 0.1], [0.18, 0.08], [0.12, 0.06]]) { add(g, M(geo.sphere(r, 12, 8), SHADES[Math.floor(y * 9) % 4], x, y + hh, -2.2, { scale: [1, hh / r, 1] })); y += hh * 2; }\n    }\n    this.heron = new Heron();\n    this.heron.root.position.set(this.lanes[0].x - 1.25, 0, -0.4);\n    this.heron.root.rotation.y = 1.1;\n    g.add(this.heron.root);\n    const p = palm(3.2); p.position.set(w / 2 - 0.9, 0, 2.8); g.add(p);\n    this.game.setBackdrop(-70, -120);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(7.6, (n - 1) * 3.2);\n    const px = n > 1 ? 0 : 2.8;\n    this.game.rig.shot(px, 2.6, d, 0, 1.45, 0, { snap, rate: 4 });\n    this.inputYaw = Math.atan2(px, d);\n  }\n  hudSetup(hud) { hud.setScore(0, 'Stones'); }\n  start() { this.next = 1.5; if (this.mode === 'solo') this.game.speech.say('stillwater', line('stillwater', 'cairn_intro'), { auto: 3, top: true }); }\n  dropStone(lane) {\n    const i = lane.stones.length;\n    if (i >= this.cfg.stones) return;\n    const [r, hh] = this.sizes[i];\n    const top = lane.stones.filter((s) => s.on).pop();\n    const b = lane.bal.body, q = b.rotation(), t = b.translation();\n    _q.set(q.x, q.y, q.z, q.w);\n    const off = this.cfg.offset;\n    const ox = (this.r() * 2 - 1) * off, oz = (this.r() * 2 - 1) * off;\n    let pos, vel;\n    if (top && top.body) {\n      const tq = top.body.rotation(), tt = top.body.translation();\n      _q.set(tq.x, tq.y, tq.z, tq.w);\n      _v.set(ox, top.hh + hh + 0.012, oz).applyQuaternion(_q);\n      pos = { x: tt.x + _v.x, y: tt.y + _v.y, z: tt.z + _v.z };\n      vel = top.body.linvel();\n    } else {\n      _v.set(ox, 0.98 + hh + 0.012, oz).applyQuaternion(_q);\n      pos = { x: t.x + _v.x, y: t.y + _v.y, z: t.z + _v.z };\n      vel = b.linvel();\n    }\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(pos.x, pos.y, pos.z).setRotation(q)\n      .setLinvel(vel.x, vel.y, vel.z).setCanSleep(false).setLinearDamping(0.1).setAngularDamping(0.6));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(r * 0.8, hh, r * 0.8).setMass(0.02 * tun.stoneMass).setFriction(0.95).setRestitution(0).setCollisionGroups(groups.prop(lane.id)), body);\n    const mesh = G();\n    const shade = SHADES[i % 4];\n    mesh.add(M(geo.sphere(1, 12, 8), shade, 0, 0, 0, { scale: [r, hh * 1.05, r] }));\n    this.group.add(mesh);\n    const s = { body, mesh, r, hh, on: true, i };\n    lane.stones.push(s);\n    this.game.audio.sfx('thud', { pitch: 130 + i * 8 });\n    if (lane.kind === 'local' && this.mode === 'solo') this.bark('stillwater', 'stone', 2.4, 9);\n  }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.next -= dt;\n    const k = Math.min(1, this.t / this.total);\n    if (this.next <= 0 && this.placedAll !== true) {\n      for (const lane of this.lanes) if (lane.kind !== 'ghost') this.dropStone(lane);\n      this.next = c.every * tun.stoneInterval;\n      this.placed++;\n      this.heron.rig.once('lower');\n      if (this.placed >= c.stones) this.placedAll = true;\n    }\n    if (this.placedAll && this.next <= 0) this.holdLeft -= dt;\n    if (this.placedAll && this.next <= 0 && this.holdLeft <= 0) this.done = true;\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      lane.bal.sway = this.ramp(c.sway[0], c.sway[1], k);\n      lane.bal.tremor = this.ramp(c.tremor[0], c.tremor[1], k);\n      if (!lane.fallen) { lane.steady += Math.max(0, 1 - Math.hypot(lane.cobX, lane.cobZ) / 0.5) * dt; lane.steadyN += dt; }\n    }\n  }\n  afterStep() {\n    for (const lane of this.lanes) {\n      if (!lane.stones) continue;\n      const bt = lane.bal.body.translation(), q = lane.bal.body.rotation();\n      _q.set(q.x, q.y, q.z, q.w).invert();\n      let on = 0;\n      for (const s of lane.stones) {\n        const p = s.body.translation();\n        _v.set(p.x - bt.x, p.y - bt.y, p.z - bt.z).applyQuaternion(_q);\n        const isOn = !lane.fallen && _v.y > 0.9 && Math.hypot(_v.x, _v.z) < 0.75;\n        if (s.on && !isOn) {\n          s.on = false;\n          this.game.audio.sfx('thud', { pitch: 90 });\n          if (lane.kind === 'local') this.bark('stillwater', 'stone_drop', 2.2, 5);\n        }\n        if (isOn) on++;\n      }\n      lane.onSlab = on;\n      lane.maxOn = Math.max(lane.maxOn, on);\n    }\n  }\n  onFall(lane) { if (lane.kind === 'local') this.bark('stillwater', 'fall', 2.6, 3); }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const [x, z] = bot.steer(0, 0, true);\n    out.wishX = x; out.wishZ = z;\n    out.breathe = lane.noBreath ? false : lane.breath.growing;\n    out.flail = !lane.fallen && lane.bal.lean > 0.55 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    hud.setScore(`${me.onSlab || 0}/${this.cfg.stones}`, 'Stones');\n    hud.setTime(Math.max(0, this.total - this.t));\n    for (const lane of this.lanes) lane.discView.zone = { x: 0, z: 0, r: 0.3, on: Math.hypot(lane.dotX, lane.dotZ) < 0.3 };\n  }\n  frameEvent(dt) {\n    for (const lane of this.lanes) {\n      if (!lane.stones) continue;\n      for (const s of lane.stones) {\n        const p = s.body.translation(), q = s.body.rotation();\n        s.mesh.position.set(p.x, p.y, p.z); s.mesh.quaternion.set(q.x, q.y, q.z, q.w);\n      }\n    }\n    if (this.heron) this.heron.update(dt);\n  }\n  isDone() { return this.done; }\n  laneResult(lane) {\n    const on = lane.onSlab || 0;\n    let height = 0;\n    if (lane.stones) for (const s of lane.stones) if (s.on) height += s.hh * 2;\n    const steady = lane.steadyN > 0 ? lane.steady / lane.steadyN : 0;\n    const raw = 100 * on + height * 60 + steady * 60;\n    return { form: (100 * raw) / this.cfg.par, raw, big: Math.round(raw), stats: `${on} of ${this.cfg.stones} stones standing · ${lane.falls} floor exercises` };\n  }\n}\nEOF\ncat > src/events/stillWater.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { positionWorld, length, sin, time, mix, smoothstep, step, vec3, uniform, float, exp, clamp } from 'three/tsl';\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { STONE, LEAF, LEAF2, WOOD_D, tree } from '../art/props.js';\nimport { Heron, Gull } from '../art/cast.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst THRESH = [0.2, 0.4, 0.6, 0.8, 1];\n/** Sit on a lily pad. Stay in the small calm zone. Calm fills, and creatures arrive. */\nexport class StillWater extends EventBase {\n  static id = 'stillWater';\n  constructor(spec) {\n    super(spec);\n    this.breathOn = true; this.god = true; this.seaLevel = -1.5;\n    this.calm = 0; this.peak = 0; this.inT = 0; this.ripple = 0; this.customPose = true;\n    this.arrived = 0; this.sneezes = [];\n    const n = this.cfg.sneezes;\n    for (let i = 0; i < n; i++) this.sneezes.push({ at: ((i + 1) / (n + 1)) * this.cfg.time + (this.r() - 0.5) * 6, state: 'wait' });\n    this.push = 0; this.pushX = 0; this.pushZ = 0;\n    this.scattered = 0;\n  }\n  setupLane(lane) { lane.doll.rig.loop('sit'); lane.bal.moveFoot(lane.x, 0, 0); }\n  buildSet() {\n    const g = this.group;\n    // A beautiful little shader: ripples spread from the pad in proportion to how much you move.\n    const amp = this.rippleU = uniform(0);\n    const mat = new THREE.MeshBasicNodeMaterial();\n    const p = positionWorld.xz;\n    const d = length(p);\n    const wave = sin(d.mul(7).sub(time.mul(3.4))).mul(0.5).add(0.5);\n    const fall = exp(d.mul(-0.36));\n    const rings = step(0.82 - 0, wave.mul(amp.mul(1.4).add(0.08)).mul(fall).add(0.4));\n    const calmBand = sin(p.x.mul(0.6).add(p.y.mul(0.4)).add(time.mul(0.18))).mul(0.5).add(0.5);\n    const base = mix(vec3(0.27, 0.68, 0.72), vec3(0.34, 0.76, 0.76), step(0.6, calmBand));\n    mat.colorNode = mix(base, vec3(0.88, 0.97, 0.95), clamp(rings, 0, 1));\n    const water = new THREE.Mesh(geo.disc(16, 64), mat);\n    water.position.y = -0.12;\n    g.add(water);\n    add(g, M(geo.ring(15.6, 20, 64), 0x8CCB6A, 0, -0.05, 0, { shadow: false }));\n    for (let i = 0; i < 18; i++) {\n      const a = (i / 18) * 6.283;\n      add(g, M(geo.sphere(0.5, 8, 6), STONE, Math.cos(a) * 15.8, -0.05, Math.sin(a) * 15.8, { scale: [1, 0.5, 1] }));\n      if (i % 2) add(g, M(geo.cyl(0.025, 0.025, 1.3, 6), LEAF, Math.cos(a + 0.1) * 14.8, 0.45, Math.sin(a + 0.1) * 14.8), M(geo.cap(0.07, 0.2, 6), WOOD_D, Math.cos(a + 0.1) * 14.8, 1.14, Math.sin(a + 0.1) * 14.8));\n    }\n    for (let i = 0; i < 12; i++) {\n      const a = i * 2.4, r = 3 + (i % 5) * 2.2;\n      add(g, M(geo.cyl(0.55, 0.55, 0.03, 18), i % 2 ? LEAF : LEAF2, Math.cos(a) * r, -0.09, Math.sin(a) * r));\n      if (i % 3 === 0) add(g, M(geo.sphere(0.13, 8, 6), 0xF4B6C8, Math.cos(a) * r, -0.02, Math.sin(a) * r, { scale: [1, 0.7, 1] }));\n    }\n    for (const [x, z] of [[-11, -9], [9, -11], [13, -2], [-14, 2]]) { const t = tree(2.6, 1.4); t.position.set(x, 0, z); g.add(t); }\n    const lane = this.lanes[0];\n    add(g, M(geo.cyl(1.05, 1.1, 0.06, 28), LEAF2, lane.x, -0.04, 0));\n    this.heron = new Heron();\n    this.heron.root.position.set(-7, 0, -5.5);\n    this.heron.root.rotation.y = 0.8;\n    g.add(this.heron.root);\n    this.buildCreatures();\n  }\n  buildCreatures() {\n    const g = this.group;\n    const lane = this.lanes[0];\n    const dragon = this.dragon = G('', lane.x + 3, 2.2, 1.2);\n    add(dragon, M(geo.cap(0.02, 0.2, 6), 0x2CB5A0, 0, 0, 0, { rot: [Math.PI / 2, 0, 0] }), M(geo.sphere(0.13, 8, 6), 0xBFE9F0, 0.1, 0.01, 0.02, { scale: [1, 0.05, 0.3] }), M(geo.sphere(0.13, 8, 6), 0xBFE9F0, -0.1, 0.01, 0.02, { scale: [1, 0.05, 0.3] }));\n    const frog = this.frog = G('', lane.x + 4, -0.03, 2);\n    add(frog, M(geo.sphere(0.13, 12, 10), 0x6DBB4F, 0, 0.1, 0, { scale: [1, 0.75, 1.1] }), M(geo.sphere(0.05, 8, 6), 0xFFFFFF, 0.06, 0.2, 0.08), M(geo.sphere(0.05, 8, 6), 0xFFFFFF, -0.06, 0.2, 0.08), M(geo.sphere(0.024, 6, 6), 0x1A1420, 0.06, 0.21, 0.12), M(geo.sphere(0.024, 6, 6), 0x1A1420, -0.06, 0.21, 0.12));\n    this.koi = [];\n    for (let i = 0; i < 3; i++) {\n      const k = G();\n      add(k, M(geo.sphere(0.24, 10, 8), i === 1 ? 0xFFF3DC : 0xF08A3C, 0, 0, 0, { scale: [0.5, 0.3, 1.2] }), M(geo.cone(0.1, 0.2, 6), i === 1 ? 0xD9483B : 0xFFF3DC, 0, 0, -0.32, { rot: [-Math.PI / 2, 0, 0], scale: [1, 1, 0.3] }));\n      k.visible = false; k.position.y = -0.1;\n      g.add(k); this.koi.push(k);\n    }\n    const turtle = this.turtle = G('', lane.x + 6, -0.05, -3);\n    add(turtle, M(geo.sphere(0.3, 12, 8), 0x5F8F4F, 0, 0.06, 0, { scale: [1, 0.5, 1.2] }), M(geo.sphere(0.1, 8, 6), 0x8CCB6A, 0, 0.08, 0.38));\n    add(g, dragon, frog, turtle);\n    this.creaturePos = [dragon, frog, null, turtle];\n  }\n  cameraShot(snap) {\n    this.game.rig.shot(0.8, 5.2, 8.4, 0, 0.5, -0.2, { snap, rate: 3 });\n    this.inputYaw = Math.atan2(0.8, 8.6);\n  }\n  hudSetup(hud) {\n    this.calmBar = hud.addWidget(hud.meter('Calm', '#6FD6B8'));\n    hud.setScore(0, 'Time in zone');\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('stillwater', line('stillwater', 'pond_intro'), { auto: 3.4, top: true }); }\n  fixedEvent(dt) {\n    const c = this.cfg, lane = this.lanes[0], b = lane.bal;\n    const k = this.t / c.time;\n    b.sway = this.ramp(c.sway[0], c.sway[1], k); b.tremor = c.tremor;\n    const r = Math.hypot(lane.dotX, lane.dotZ), inZone = r < c.zone;\n    if (inZone) { this.inT += dt; this.calm = Math.min(1, this.calm + dt / 30); } else this.calm = Math.max(0, this.calm - dt / 8);\n    this.peak = Math.max(this.peak, this.calm);\n    // Ripples follow how much the dot moves.\n    const speed = b.body.angvel();\n    const move = Math.hypot(speed.x, speed.z);\n    this.ripple += (Math.min(1, move * 1.6 + (inZone ? 0 : r * 0.8)) - this.ripple) * (1 - Math.exp(-3 * dt));\n    if (this.rippleU) this.rippleU.value = this.ripple;\n    // Creatures arrive at thresholds; moving too much scatters them.\n    const target = THRESH.filter((x) => this.calm >= x).length;\n    if (target > this.arrived) {\n      this.arrived = target;\n      if (this.mode === 'solo') this.game.speech.say('stillwater', this.game.line('stillwater', 'creature'), { auto: 2.8, top: true });\n      this.game.audio.sfx('marble', { pitch: 1800 });\n      if (this.arrived >= 5) { this.heron.rig.loop('tiptoe'); }\n    } else if (target < this.arrived - 1) {\n      this.arrived = target;\n      this.scattered++;\n      if (lane.kind === 'local') this.bark('stillwater', 'scatter', 2.2, 8);\n      this.game.audio.sfx('splash', { big: 0.3 });\n    }\n    // Sneezes: telegraphed; Flail stifles, or you take a big shove.\n    for (const s of this.sneezes) {\n      if (s.state === 'wait' && this.t >= s.at) {\n        s.state = 'warn'; s.t = 1.2;\n        this.warned = s;\n        if (lane.kind === 'local') this.game.speech.say('stillwater', 'Ah... ah...', { auto: 1.1, top: true });\n        this.game.hud.setNote('Ah... ah...', 1.2);\n        this.game.input.rumble(0.1, 0.3, 300);\n      } else if (s.state === 'warn') {\n        s.t -= dt;\n        if (s.stifled) { s.state = 'done'; this.warned = null; this.game.hud.setNote('Stifled.', 1); } else if (s.t <= 0) {\n          s.state = 'done'; this.warned = null;\n          const a = this.r() * 6.283;\n          this.push = 0.3; this.pushX = Math.cos(a) * 2.2; this.pushZ = Math.sin(a) * 2.2;\n          this.game.audio.sfx('sneeze');\n          this.game.comic.pop('ACHOO!', lane.x, 1.9, 0);\n          this.game.rig.shake(0.04);\n        }\n      }\n    }\n    if (this.push > 0) { this.push -= dt; b.extX += this.pushX * this.diff.dist; b.extZ += this.pushZ * this.diff.dist; }\n  }\n  onFlail() { if (this.warned) this.warned.stifled = true; }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const [x, z] = bot.steer(0, 0);\n    out.wishX = x; out.wishZ = z;\n    out.breathe = lane.noBreath ? false : lane.breath.growing;\n    out.flail = !!(this.warned && this.warned.t < 1.2 - bot.s.lag);\n  }\n  hud() {\n    const hud = this.game.hud;\n    hud.setTime(this.cfg.time - this.t);\n    hud.setScore(`${Math.round((100 * this.inT) / Math.max(1, this.t))}%`, 'Time in zone');\n    if (this.calmBar) this.calmBar.set(this.calm);\n    const lane = this.lanes[0];\n    lane.discView.zone = { x: 0, z: 0, r: this.cfg.zone, on: Math.hypot(lane.dotX, lane.dotZ) < this.cfg.zone };\n  }\n  frameEvent(dt) {\n    const lane = this.lanes[0], d = lane.doll, b = lane.bal, g = this.game;\n    d.setLean(0, 0, 0, 1);\n    d.root.position.set(lane.x, 0, 0);\n    d.root.rotation.set(b.leanZ * 0.32, 0, -b.leanX * 0.32);\n    this.heron.update(dt);\n    const T = this.t;\n    const n = this.arrived;\n    const lerp = (o, x, y, z, k = 2) => { o.position.x += (x - o.position.x) * Math.min(1, k * dt); o.position.y += (y - o.position.y) * Math.min(1, k * dt); o.position.z += (z - o.position.z) * Math.min(1, k * dt); };\n    if (n >= 1) lerp(this.dragon, lane.x, 0.97 + Math.sin(T * 40) * 0.003, 0.25); else lerp(this.dragon, lane.x + 3 + Math.sin(T) * 0.7, 2.2 + Math.sin(T * 2.3) * 0.3, 1.2 + Math.cos(T * 1.2));\n    if (n >= 2) lerp(this.frog, lane.x, 1.03, 0); else lerp(this.frog, lane.x + 4, -0.03, 2);\n    for (let i = 0; i < 3; i++) {\n      this.koi[i].visible = n >= 3;\n      const a = T * 0.5 + (i * 6.28) / 3;\n      this.koi[i].position.set(Math.cos(a) * 2.4, -0.1, Math.sin(a) * 2.4);\n      this.koi[i].rotation.y = -a;\n    }\n    if (n >= 4) lerp(this.turtle, lane.x + 1.3, -0.04, -0.6, 0.5); else lerp(this.turtle, lane.x + 6, -0.05, -3, 0.5);\n    if (n >= 5) {\n      const hp = this.heron.root.position;\n      const nearly = Math.hypot(hp.x - (lane.x - 1.2), hp.z - (-0.3)) < 0.25;\n      if (!nearly) lerp(this.heron.root, lane.x - 1.2, 0, -0.3, 0.4);\n      else if (!this.patted) { this.patted = true; this.heron.rig.loop('stand'); this.heron.rig.once('pat'); g.speech.say('stillwater', line('stillwater', 'pat'), { auto: 2.2, top: true }); }\n    }\n  }\n  isDone() { return this.t >= this.cfg.time; }\n  laneResult(lane) {\n    const share = this.inT / Math.max(1, Math.min(this.t, this.cfg.time));\n    const form = ((share + this.calm) / 2) * 100;\n    return { form, raw: form, big: Math.round(form), stats: `${Math.round(share * 100)}% in the zone · peak calm ${Math.round(this.peak * 100)}% · ${this.scattered} scattered` };\n  }\n}\nexport { Gull, h, float, smoothstep };\nEOF\ncat > src/data/charts.js <<'EOF'\n// Step Class charts: bars of 8 cells. L R B feet, < > ^ v lean, . rest.\nexport const PATTERNS = ['L...R...', 'L.R.L.R.', 'L.R.B...', 'L.L.R.R.', '<...>...', 'L.R.<...', '^...v...', 'LRL.RLR.', 'B.B.LRB.', 'L.R.LRLR'];\nconst P = (...idx) => idx.map((i) => PATTERNS[i]);\nconst REST = '........';\nconst rest = (n) => Array(n).fill(REST);\n/** Form: intro 4 (empty), A 8, B 8, A′ 8, break 4 (lean only), B′ 8, outro 4. */\nexport const CHARTS = {\n  tier1: [\n    ...rest(4),\n    ...P(0, 0, 1, 2, 0, 1, 1, 2),\n    ...P(1, 2, 4, 2, 1, 2, 4, 2),\n    ...P(0, 1, 1, 2, 1, 1, 0, 2),\n    ...P(4, 4, 4, 4),\n    ...P(1, 2, 4, 2, 2, 1, 4, 2),\n    ...rest(4),\n  ],\n  tier2: [\n    ...rest(4),\n    ...P(1, 2, 3, 2, 1, 3, 5, 2),\n    ...P(3, 5, 2, 6, 3, 5, 2, 6),\n    ...P(1, 3, 2, 5, 3, 1, 5, 2),\n    ...P(4, 6, 4, 6),\n    ...P(5, 3, 6, 2, 5, 3, 4, 2),\n    ...rest(4),\n  ],\n  tier3: [\n    ...rest(4),\n    ...P(3, 7, 2, 9, 7, 3, 8, 2),\n    ...P(9, 5, 7, 6, 8, 9, 5, 4),\n    ...P(7, 9, 8, 3, 9, 7, 2, 5),\n    ...P(4, 6, 4, 6),\n    ...P(8, 7, 9, 5, 7, 8, 6, 2),\n    ...rest(4),\n  ],\n  session: [\n    ...rest(2),\n    ...P(1, 2, 3, 2, 1, 3, 5, 2),\n    ...P(3, 5, 2, 1),\n    ...P(4, 6, 4, 6),\n    ...P(5, 3, 2, 1),\n    ...rest(2),\n  ],\n};\nexport function chartNotes(name, bpm) {\n  const bars = CHARTS[name];\n  const beat = 60 / bpm;\n  const notes = [];\n  bars.forEach((bar, b) => {\n    for (let c = 0; c < 8; c++) {\n      const ch = bar[c];\n      if (ch === '.') continue;\n      notes.push({ t: (b * 4 + c * 0.5) * beat, type: ch, lean: '<>^v'.includes(ch), bar: b });\n    }\n  });\n  return { notes, length: bars.length * 4 * beat, beat };\n}\nEOF\n","description":"Write Poses, The Cairn, Still Water and step charts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16914,"cache_read_input_tokens":366409,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16914},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"166d957c-43d1-4cfb-bc60-9b2e77507344","timestamp":"2026-11-05T12:28:28.446Z","request_id":"req_011CgjmxQnQLF2nmXT927cSQ","wire_tool_inputs":{"toolu_01GFMQDKUWJq2mnMg8JbaHWb":{"command":"sed -i \"s/this.data = EVENTS\\[this.constructor.id\\];/this.data = EVENTS[this.constructor.id] || spec.data;/; s/this.cfg = spec.config || this.data.tiers\\[this.tier\\];/this.cfg = spec.config || (this.data.tiers ? this.data.tiers[this.tier] : {});/\" src/events/base.js\ncat > src/events/poses.js <<'EOF'\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { post, buoy, palm, TEAK, WOOD_D, CREAM, TEAL } from '../art/props.js';\nimport { Heron } from '../art/cast.js';\nimport { POSES } from '../data/poses.js';\nimport { tun } from '../core/tuning.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst GLIDE = 3;\n/** Follow the ring to a pose, then hold while the ring shrinks. Breath is how you get good at it. */\nexport class Poses extends EventBase {\n  static id = 'poses';\n  constructor(spec) {\n    super(spec);\n    this.balanceParams = { maxLean: 14, margin: 0.45 };\n    this.breathOn = true; this.seaLevel = -1.4;\n    const pool = POSES.slice();\n    this.seq = [];\n    for (let i = 0; i < this.cfg.poses; i++) this.seq.push(pool.splice(Math.floor(this.r() * pool.length), 1)[0]);\n    this.index = -1; this.stage = 'wait'; this.stageT = 0; this.prev = { x: 0, z: 0 };\n    this.ring = { x: 0, z: 0, r: this.cfg.ringStart, on: false };\n    this.total = this.seq.length * (GLIDE + this.cfg.hold);\n    this.maxEarn = 0;\n    this.outT = 0; this.stillT = 0; this.lastSay = -9;\n  }\n  setupLane(lane) { lane.earn = 0; lane.inRing = false; lane.doll.rig.loop('breathe'); }\n  buildSet() {\n    const g = this.group;\n    const n = this.lanes.length, r = Math.max(5, 1.6 + n * 1.6);\n    add(g, M(geo.cyl(r, r, 0.3, 40), TEAK, 0, -0.15, 0));\n    for (let i = 0; i < 10; i++) { const a = (i / 10) * 6.283; add(g, post(5, 0.16, WOOD_D, Math.cos(a) * (r - 0.5), -5.2, Math.sin(a) * (r - 0.5))); add(g, M(geo.sphere(0.13, 10, 8), CREAM, Math.cos(a) * (r - 0.2), 0.12, Math.sin(a) * (r - 0.2))); }\n    for (let i = 0; i < 5; i++) add(g, M(geo.box(r * 2 - 0.2, 0.012, 0.03), WOOD_D, 0, 0.004, -r + 1 + i * ((r * 2 - 2) / 4)));\n    for (const lane of this.lanes) add(g, M(geo.cyl(1.05, 1.05, 0.03, 30), 0xC24D6A, lane.x, 0.012, 0));\n    this.heron = new Heron();\n    this.heron.root.position.set(-(this.lanes.length * 1.6 + 1.3), 0, -1.1);\n    this.heron.root.rotation.y = 0.55;\n    g.add(this.heron.root);\n    const b = buoy(TEAL); b.position.set(7.5, this.seaLevel, -9); g.add(b);\n    const p = palm(3.4); p.position.set(r - 0.8, 0, -r + 0.9); g.add(p);\n    this.game.setBackdrop(40, -135);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(7.2, (n - 1) * 3.2);\n    const px = n > 1 ? 0 : 1.7;\n    this.game.rig.shot(px, 2.3, d, -0.3, 1.05, 0, { snap, rate: 4 });\n    this.inputYaw = Math.atan2(px + 0.3, d);\n  }\n  hudSetup(hud) {\n    this.poseTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, ''));\n    hud.setScore(0, 'Form');\n  }\n  start() {\n    this.stage = 'wait'; this.stageT = 0;\n    this.nextPose();\n    if (this.game.speech && this.mode === 'solo') this.game.speech.say('stillwater', line('stillwater', 'breath'), { auto: 3, top: true });\n  }\n  nextPose() {\n    this.index++;\n    if (this.index >= this.seq.length) { this.stage = 'finished'; return; }\n    const pose = this.seq[this.index];\n    this.stage = 'glide'; this.stageT = 0;\n    this.prev = { x: this.ring.x, z: this.ring.z };\n    this.ring.r = this.cfg.ringStart;\n    for (const lane of this.lanes) lane.doll.rig.loop(pose.clip, { fade: 0.6 });\n    this.heron.rig.loop(pose.demo, { fade: 0.8 });\n    if (this.poseTag) this.poseTag.textContent = pose.name;\n    if (this.mode === 'solo') this.game.speech.say('stillwater', line('stillwater', 'pose', { pose: pose.name }), { auto: 2.8, top: true });\n    this.game.audio.sfx('bell');\n  }\n  rampK() { return Math.min(1, this.t / this.total); }\n  ringEnd() { return this.cfg.ringEnd * tun.ringEnd; }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.stageT += dt;\n    const pose = this.seq[this.index];\n    if (this.stage === 'glide') {\n      const k = Math.min(1, this.stageT / GLIDE), e = k * k * (3 - 2 * k);\n      this.ring.x = this.prev.x + (pose.x - this.prev.x) * e; this.ring.z = this.prev.z + (pose.z - this.prev.z) * e;\n      if (this.stageT >= GLIDE) { this.stage = 'hold'; this.stageT = 0; }\n    } else if (this.stage === 'hold') {\n      const k = Math.min(1, this.stageT / c.hold);\n      this.ring.r = this.ramp(c.ringStart, this.ringEnd(), k);\n      const earn = 0.3 / this.ring.r;\n      this.maxEarn += earn * dt;\n      for (const lane of this.lanes) {\n        if (lane.kind === 'ghost') continue;\n        const inside = !lane.fallen && Math.hypot(lane.dotX - this.ring.x, lane.dotZ - this.ring.z) < this.ring.r;\n        lane.inRing = inside;\n        if (inside) lane.earn += earn * dt * (lane.breath.inSync ? 1.25 : 1);\n      }\n      if (this.stageT >= c.hold) this.nextPose();\n    }\n    const kk = this.rampK();\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      lane.bal.sway = this.ramp(c.sway[0], c.sway[1], kk);\n      lane.bal.tremor = this.ramp(c.tremor[0], c.tremor[1], kk);\n    }\n    const me = this.lanes[0];\n    if (me.kind === 'local' && this.stage === 'hold') {\n      this.outT = me.inRing ? 0 : this.outT + dt;\n      this.stillT = me.inRing ? this.stillT + dt : 0;\n      if (this.outT > 2.2) { this.bark('stillwater', 'leave', 2.6, 8); this.outT = 0; }\n      if (this.stillT > 4.5) { this.bark('stillwater', 'still', 2.6, 9); this.stillT = 0; }\n      if (me.bal && me.bal.lean > 0.34) this.bark('stillwater', 'shake', 2.6, 9);\n    }\n  }\n  flailed(lane) { lane.earn = Math.max(0, lane.earn - this.total * 0.012); if (lane.kind === 'local') this.bark('stillwater', 'flail', 2.2, 5); }\n  onFall(lane) { if (lane.kind === 'local') this.bark('stillwater', 'fall', 2.6, 3); }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const gx = this.ring.x, gz = this.ring.z;\n    if (lane.parkStick) { out.wishX = gx; out.wishZ = gz; } else {\n      const [x, z] = bot.steer(gx, gz);\n      out.wishX = x; out.wishZ = z;\n    }\n    out.breathe = lane.noBreath ? false : lane.breath.growing;\n    out.flail = !lane.fallen && lane.bal.lean > 0.55 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    hud.setTime(Math.max(0, this.total - this.t));\n    hud.setScore(Math.round(this.formOf(me)), 'Form');\n    for (const lane of this.lanes) lane.discView.zone = this.stage === 'finished' ? null : { x: this.ring.x, z: this.ring.z, r: this.ring.r, on: lane.inRing };\n  }\n  formOf(lane) { return this.maxEarn > 0 ? Math.min(100, (100 * lane.earn) / this.maxEarn) : 0; }\n  frameEvent(dt) { if (this.heron) this.heron.update(dt); }\n  isDone() { return this.stage === 'finished'; }\n  laneResult(lane) {\n    const form = this.formOf(lane);\n    return { form, raw: lane.earn, big: Math.round(form), stats: `${this.seq.length} poses · ${lane.falls} floor exercises` };\n  }\n}\nEOF\ncat > src/events/cairn.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add, toon } from '../art/materials.js';\nimport { bigRock, STONE, STONE_D, palm } from '../art/props.js';\nimport { Heron } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst SIZES = [[0.26, 0.09], [0.24, 0.085], [0.22, 0.08], [0.2, 0.078], [0.18, 0.074], [0.165, 0.07], [0.15, 0.066], [0.14, 0.062], [0.125, 0.058], [0.11, 0.054]];\nconst WIDE = [[0.28, 0.09], [0.27, 0.085], [0.26, 0.08], [0.25, 0.078], [0.24, 0.074], [0.23, 0.07], [0.22, 0.066], [0.21, 0.062], [0.2, 0.058], [0.19, 0.054]];\nconst SHADES = [0xCFC8B6, 0xBDB5A2, 0xD8D2C2, 0xA9A18F];\nconst _q = new THREE.Quaternion(), _v = new THREE.Vector3();\n\n/** Hold the slab level while Ms. Stillwater lowers stones onto it. */\nexport class Cairn extends EventBase {\n  static id = 'cairn';\n  constructor(spec) {\n    super(spec);\n    this.iterations = 10;\n    this.balanceParams = { margin: 0.8, ankleMax: 6 };\n    this.breathOn = true; this.seaLevel = -14;\n    this.sizes = this.cfg.wide ? WIDE : SIZES;\n    this.next = 1.5; this.dropped = 0; this.placed = 0; this.holdLeft = this.cfg.hold; this.done = false;\n    this.total = this.cfg.stones * this.cfg.every + this.cfg.hold + 1.5;\n  }\n  setupLane(lane) {\n    const b = lane.bal.body;\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.55, 0.03, 0.55).setTranslation(0, 0.95, 0).setMass(0.05).setFriction(1).setCollisionGroups(groups.doll(lane.id)), b);\n    lane.stones = []; lane.steady = 0; lane.steadyN = 0; lane.maxOn = 0;\n    const slab = G('slab', 0, 0.75 + 0.95, 0);\n    add(slab, M(geo.box(1.1, 0.06, 1.1), 0xD6CDB6));\n    lane.doll.root.add(slab);\n    lane.doll.rig.loop('holdSlab');\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length, w = Math.max(9, n * 3.2 + 6);\n    add(g, M(geo.box(w, 2.6, 7.5), STONE, 0, -1.3, 0), M(geo.box(w + 1.2, 12, 8.4), STONE_D, 0, -8, -0.3));\n    for (let i = 0; i < 7; i++) add(g, M(geo.box(w / 7 - 0.03, 0.02, 7.5), SHADES[i % 4], -w / 2 + (i + 0.5) * (w / 7), 0.002, 0));\n    for (const [x, z, s] of [[-w / 2 + 1, -2.6, 0.9], [w / 2 - 1.1, -2.8, 1.1], [w / 2 - 2.4, -3, 0.6], [-w / 2 + 2.3, -3, 0.5]]) { const r = bigRock(s, STONE_D); r.position.set(x, s * 0.5, z); g.add(r); }\n    // Old cairns at the back, for company.\n    for (const x of [-w / 2 + 2, w / 2 - 3.4]) {\n      let y = 0;\n      for (const [r, hh] of [[0.4, 0.14], [0.32, 0.12], [0.26, 0.1], [0.18, 0.08], [0.12, 0.06]]) { add(g, M(geo.sphere(r, 12, 8), SHADES[Math.floor(y * 9) % 4], x, y + hh, -2.2, { scale: [1, hh / r, 1] })); y += hh * 2; }\n    }\n    this.heron = new Heron();\n    this.heron.root.position.set(this.lanes[0].x - 1.25, 0, -0.4);\n    this.heron.root.rotation.y = 1.1;\n    g.add(this.heron.root);\n    const p = palm(3.2); p.position.set(w / 2 - 0.9, 0, 2.8); g.add(p);\n    this.game.setBackdrop(-70, -120);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(7.6, (n - 1) * 3.2);\n    const px = n > 1 ? 0 : 2.8;\n    this.game.rig.shot(px, 2.6, d, 0, 1.45, 0, { snap, rate: 4 });\n    this.inputYaw = Math.atan2(px, d);\n  }\n  hudSetup(hud) { hud.setScore(0, 'Stones'); }\n  start() { this.next = 1.5; if (this.mode === 'solo') this.game.speech.say('stillwater', line('stillwater', 'cairn_intro'), { auto: 3, top: true }); }\n  dropStone(lane) {\n    const i = lane.stones.length;\n    if (i >= this.cfg.stones) return;\n    const [r, hh] = this.sizes[i];\n    const top = lane.stones.filter((s) => s.on).pop();\n    const b = lane.bal.body, q = b.rotation(), t = b.translation();\n    _q.set(q.x, q.y, q.z, q.w);\n    const off = this.cfg.offset;\n    const ox = (this.r() * 2 - 1) * off, oz = (this.r() * 2 - 1) * off;\n    let pos, vel;\n    if (top && top.body) {\n      const tq = top.body.rotation(), tt = top.body.translation();\n      _q.set(tq.x, tq.y, tq.z, tq.w);\n      _v.set(ox, top.hh + hh + 0.012, oz).applyQuaternion(_q);\n      pos = { x: tt.x + _v.x, y: tt.y + _v.y, z: tt.z + _v.z };\n      vel = top.body.linvel();\n    } else {\n      _v.set(ox, 0.98 + hh + 0.012, oz).applyQuaternion(_q);\n      pos = { x: t.x + _v.x, y: t.y + _v.y, z: t.z + _v.z };\n      vel = b.linvel();\n    }\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(pos.x, pos.y, pos.z).setRotation(q)\n      .setLinvel(vel.x, vel.y, vel.z).setCanSleep(false).setLinearDamping(0.1).setAngularDamping(0.6));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(r * 0.8, hh, r * 0.8).setMass(0.02 * tun.stoneMass).setFriction(0.95).setRestitution(0).setCollisionGroups(groups.prop(lane.id)), body);\n    const mesh = G();\n    const shade = SHADES[i % 4];\n    mesh.add(M(geo.sphere(1, 12, 8), shade, 0, 0, 0, { scale: [r, hh * 1.05, r] }));\n    this.group.add(mesh);\n    const s = { body, mesh, r, hh, on: true, i };\n    lane.stones.push(s);\n    this.game.audio.sfx('thud', { pitch: 130 + i * 8 });\n    if (lane.kind === 'local' && this.mode === 'solo') this.bark('stillwater', 'stone', 2.4, 9);\n  }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.next -= dt;\n    const k = Math.min(1, this.t / this.total);\n    if (this.next <= 0 && this.placedAll !== true) {\n      for (const lane of this.lanes) if (lane.kind !== 'ghost') this.dropStone(lane);\n      this.next = c.every * tun.stoneInterval;\n      this.placed++;\n      this.heron.rig.once('lower');\n      if (this.placed >= c.stones) this.placedAll = true;\n    }\n    if (this.placedAll && this.next <= 0) this.holdLeft -= dt;\n    if (this.placedAll && this.next <= 0 && this.holdLeft <= 0) this.done = true;\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      lane.bal.sway = this.ramp(c.sway[0], c.sway[1], k);\n      lane.bal.tremor = this.ramp(c.tremor[0], c.tremor[1], k);\n      if (!lane.fallen) { lane.steady += Math.max(0, 1 - Math.hypot(lane.cobX, lane.cobZ) / 0.5) * dt; lane.steadyN += dt; }\n    }\n  }\n  afterStep() {\n    for (const lane of this.lanes) {\n      if (!lane.stones) continue;\n      const bt = lane.bal.body.translation(), q = lane.bal.body.rotation();\n      _q.set(q.x, q.y, q.z, q.w).invert();\n      let on = 0;\n      for (const s of lane.stones) {\n        const p = s.body.translation();\n        _v.set(p.x - bt.x, p.y - bt.y, p.z - bt.z).applyQuaternion(_q);\n        const isOn = !lane.fallen && _v.y > 0.9 && Math.hypot(_v.x, _v.z) < 0.75;\n        if (s.on && !isOn) {\n          s.on = false;\n          this.game.audio.sfx('thud', { pitch: 90 });\n          if (lane.kind === 'local') this.bark('stillwater', 'stone_drop', 2.2, 5);\n        }\n        if (isOn) on++;\n      }\n      lane.onSlab = on;\n      lane.maxOn = Math.max(lane.maxOn, on);\n    }\n  }\n  onFall(lane) { if (lane.kind === 'local') this.bark('stillwater', 'fall', 2.6, 3); }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const [x, z] = bot.steer(0, 0, true);\n    out.wishX = x; out.wishZ = z;\n    out.breathe = lane.noBreath ? false : lane.breath.growing;\n    out.flail = !lane.fallen && lane.bal.lean > 0.55 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    hud.setScore(`${me.onSlab || 0}/${this.cfg.stones}`, 'Stones');\n    hud.setTime(Math.max(0, this.total - this.t));\n    for (const lane of this.lanes) lane.discView.zone = { x: 0, z: 0, r: 0.3, on: Math.hypot(lane.dotX, lane.dotZ) < 0.3 };\n  }\n  frameEvent(dt) {\n    for (const lane of this.lanes) {\n      if (!lane.stones) continue;\n      for (const s of lane.stones) {\n        const p = s.body.translation(), q = s.body.rotation();\n        s.mesh.position.set(p.x, p.y, p.z); s.mesh.quaternion.set(q.x, q.y, q.z, q.w);\n      }\n    }\n    if (this.heron) this.heron.update(dt);\n  }\n  isDone() { return this.done; }\n  laneResult(lane) {\n    const on = lane.onSlab || 0;\n    let height = 0;\n    if (lane.stones) for (const s of lane.stones) if (s.on) height += s.hh * 2;\n    const steady = lane.steadyN > 0 ? lane.steady / lane.steadyN : 0;\n    const raw = 100 * on + height * 60 + steady * 60;\n    return { form: (100 * raw) / this.cfg.par, raw, big: Math.round(raw), stats: `${on} of ${this.cfg.stones} stones standing · ${lane.falls} floor exercises` };\n  }\n}\nEOF\ncat > src/events/stillWater.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { positionWorld, length, sin, time, mix, smoothstep, step, vec3, uniform, float, exp, clamp } from 'three/tsl';\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { STONE, LEAF, LEAF2, WOOD_D, tree } from '../art/props.js';\nimport { Heron, Gull } from '../art/cast.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst THRESH = [0.2, 0.4, 0.6, 0.8, 1];\n/** Sit on a lily pad. Stay in the small calm zone. Calm fills, and creatures arrive. */\nexport class StillWater extends EventBase {\n  static id = 'stillWater';\n  constructor(spec) {\n    super(spec);\n    this.breathOn = true; this.god = true; this.seaLevel = -1.5;\n    this.calm = 0; this.peak = 0; this.inT = 0; this.ripple = 0; this.customPose = true;\n    this.arrived = 0; this.sneezes = [];\n    const n = this.cfg.sneezes;\n    for (let i = 0; i < n; i++) this.sneezes.push({ at: ((i + 1) / (n + 1)) * this.cfg.time + (this.r() - 0.5) * 6, state: 'wait' });\n    this.push = 0; this.pushX = 0; this.pushZ = 0;\n    this.scattered = 0;\n  }\n  setupLane(lane) { lane.doll.rig.loop('sit'); lane.bal.moveFoot(lane.x, 0, 0); }\n  buildSet() {\n    const g = this.group;\n    // A beautiful little shader: ripples spread from the pad in proportion to how much you move.\n    const amp = this.rippleU = uniform(0);\n    const mat = new THREE.MeshBasicNodeMaterial();\n    const p = positionWorld.xz;\n    const d = length(p);\n    const wave = sin(d.mul(7).sub(time.mul(3.4))).mul(0.5).add(0.5);\n    const fall = exp(d.mul(-0.36));\n    const rings = step(0.82 - 0, wave.mul(amp.mul(1.4).add(0.08)).mul(fall).add(0.4));\n    const calmBand = sin(p.x.mul(0.6).add(p.y.mul(0.4)).add(time.mul(0.18))).mul(0.5).add(0.5);\n    const base = mix(vec3(0.27, 0.68, 0.72), vec3(0.34, 0.76, 0.76), step(0.6, calmBand));\n    mat.colorNode = mix(base, vec3(0.88, 0.97, 0.95), clamp(rings, 0, 1));\n    const water = new THREE.Mesh(geo.disc(16, 64), mat);\n    water.position.y = -0.12;\n    g.add(water);\n    add(g, M(geo.ring(15.6, 20, 64), 0x8CCB6A, 0, -0.05, 0, { shadow: false }));\n    for (let i = 0; i < 18; i++) {\n      const a = (i / 18) * 6.283;\n      add(g, M(geo.sphere(0.5, 8, 6), STONE, Math.cos(a) * 15.8, -0.05, Math.sin(a) * 15.8, { scale: [1, 0.5, 1] }));\n      if (i % 2) add(g, M(geo.cyl(0.025, 0.025, 1.3, 6), LEAF, Math.cos(a + 0.1) * 14.8, 0.45, Math.sin(a + 0.1) * 14.8), M(geo.cap(0.07, 0.2, 6), WOOD_D, Math.cos(a + 0.1) * 14.8, 1.14, Math.sin(a + 0.1) * 14.8));\n    }\n    for (let i = 0; i < 12; i++) {\n      const a = i * 2.4, r = 3 + (i % 5) * 2.2;\n      add(g, M(geo.cyl(0.55, 0.55, 0.03, 18), i % 2 ? LEAF : LEAF2, Math.cos(a) * r, -0.09, Math.sin(a) * r));\n      if (i % 3 === 0) add(g, M(geo.sphere(0.13, 8, 6), 0xF4B6C8, Math.cos(a) * r, -0.02, Math.sin(a) * r, { scale: [1, 0.7, 1] }));\n    }\n    for (const [x, z] of [[-11, -9], [9, -11], [13, -2], [-14, 2]]) { const t = tree(2.6, 1.4); t.position.set(x, 0, z); g.add(t); }\n    const lane = this.lanes[0];\n    add(g, M(geo.cyl(1.05, 1.1, 0.06, 28), LEAF2, lane.x, -0.04, 0));\n    this.heron = new Heron();\n    this.heron.root.position.set(-7, 0, -5.5);\n    this.heron.root.rotation.y = 0.8;\n    g.add(this.heron.root);\n    this.buildCreatures();\n  }\n  buildCreatures() {\n    const g = this.group;\n    const lane = this.lanes[0];\n    const dragon = this.dragon = G('', lane.x + 3, 2.2, 1.2);\n    add(dragon, M(geo.cap(0.02, 0.2, 6), 0x2CB5A0, 0, 0, 0, { rot: [Math.PI / 2, 0, 0] }), M(geo.sphere(0.13, 8, 6), 0xBFE9F0, 0.1, 0.01, 0.02, { scale: [1, 0.05, 0.3] }), M(geo.sphere(0.13, 8, 6), 0xBFE9F0, -0.1, 0.01, 0.02, { scale: [1, 0.05, 0.3] }));\n    const frog = this.frog = G('', lane.x + 4, -0.03, 2);\n    add(frog, M(geo.sphere(0.13, 12, 10), 0x6DBB4F, 0, 0.1, 0, { scale: [1, 0.75, 1.1] }), M(geo.sphere(0.05, 8, 6), 0xFFFFFF, 0.06, 0.2, 0.08), M(geo.sphere(0.05, 8, 6), 0xFFFFFF, -0.06, 0.2, 0.08), M(geo.sphere(0.024, 6, 6), 0x1A1420, 0.06, 0.21, 0.12), M(geo.sphere(0.024, 6, 6), 0x1A1420, -0.06, 0.21, 0.12));\n    this.koi = [];\n    for (let i = 0; i < 3; i++) {\n      const k = G();\n      add(k, M(geo.sphere(0.24, 10, 8), i === 1 ? 0xFFF3DC : 0xF08A3C, 0, 0, 0, { scale: [0.5, 0.3, 1.2] }), M(geo.cone(0.1, 0.2, 6), i === 1 ? 0xD9483B : 0xFFF3DC, 0, 0, -0.32, { rot: [-Math.PI / 2, 0, 0], scale: [1, 1, 0.3] }));\n      k.visible = false; k.position.y = -0.1;\n      g.add(k); this.koi.push(k);\n    }\n    const turtle = this.turtle = G('', lane.x + 6, -0.05, -3);\n    add(turtle, M(geo.sphere(0.3, 12, 8), 0x5F8F4F, 0, 0.06, 0, { scale: [1, 0.5, 1.2] }), M(geo.sphere(0.1, 8, 6), 0x8CCB6A, 0, 0.08, 0.38));\n    add(g, dragon, frog, turtle);\n    this.creaturePos = [dragon, frog, null, turtle];\n  }\n  cameraShot(snap) {\n    this.game.rig.shot(0.8, 5.2, 8.4, 0, 0.5, -0.2, { snap, rate: 3 });\n    this.inputYaw = Math.atan2(0.8, 8.6);\n  }\n  hudSetup(hud) {\n    this.calmBar = hud.addWidget(hud.meter('Calm', '#6FD6B8'));\n    hud.setScore(0, 'Time in zone');\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('stillwater', line('stillwater', 'pond_intro'), { auto: 3.4, top: true }); }\n  fixedEvent(dt) {\n    const c = this.cfg, lane = this.lanes[0], b = lane.bal;\n    const k = this.t / c.time;\n    b.sway = this.ramp(c.sway[0], c.sway[1], k); b.tremor = c.tremor;\n    const r = Math.hypot(lane.dotX, lane.dotZ), inZone = r < c.zone;\n    if (inZone) { this.inT += dt; this.calm = Math.min(1, this.calm + dt / 30); } else this.calm = Math.max(0, this.calm - dt / 8);\n    this.peak = Math.max(this.peak, this.calm);\n    // Ripples follow how much the dot moves.\n    const speed = b.body.angvel();\n    const move = Math.hypot(speed.x, speed.z);\n    this.ripple += (Math.min(1, move * 1.6 + (inZone ? 0 : r * 0.8)) - this.ripple) * (1 - Math.exp(-3 * dt));\n    if (this.rippleU) this.rippleU.value = this.ripple;\n    // Creatures arrive at thresholds; moving too much scatters them.\n    const target = THRESH.filter((x) => this.calm >= x).length;\n    if (target > this.arrived) {\n      this.arrived = target;\n      if (this.mode === 'solo') this.game.speech.say('stillwater', this.game.line('stillwater', 'creature'), { auto: 2.8, top: true });\n      this.game.audio.sfx('marble', { pitch: 1800 });\n      if (this.arrived >= 5) { this.heron.rig.loop('tiptoe'); }\n    } else if (target < this.arrived - 1) {\n      this.arrived = target;\n      this.scattered++;\n      if (lane.kind === 'local') this.bark('stillwater', 'scatter', 2.2, 8);\n      this.game.audio.sfx('splash', { big: 0.3 });\n    }\n    // Sneezes: telegraphed; Flail stifles, or you take a big shove.\n    for (const s of this.sneezes) {\n      if (s.state === 'wait' && this.t >= s.at) {\n        s.state = 'warn'; s.t = 1.2;\n        this.warned = s;\n        if (lane.kind === 'local') this.game.speech.say('stillwater', 'Ah... ah...', { auto: 1.1, top: true });\n        this.game.hud.setNote('Ah... ah...', 1.2);\n        this.game.input.rumble(0.1, 0.3, 300);\n      } else if (s.state === 'warn') {\n        s.t -= dt;\n        if (s.stifled) { s.state = 'done'; this.warned = null; this.game.hud.setNote('Stifled.', 1); } else if (s.t <= 0) {\n          s.state = 'done'; this.warned = null;\n          const a = this.r() * 6.283;\n          this.push = 0.3; this.pushX = Math.cos(a) * 2.2; this.pushZ = Math.sin(a) * 2.2;\n          this.game.audio.sfx('sneeze');\n          this.game.comic.pop('ACHOO!', lane.x, 1.9, 0);\n          this.game.rig.shake(0.04);\n        }\n      }\n    }\n    if (this.push > 0) { this.push -= dt; b.extX += this.pushX * this.diff.dist; b.extZ += this.pushZ * this.diff.dist; }\n  }\n  onFlail() { if (this.warned) this.warned.stifled = true; }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const [x, z] = bot.steer(0, 0);\n    out.wishX = x; out.wishZ = z;\n    out.breathe = lane.noBreath ? false : lane.breath.growing;\n    out.flail = !!(this.warned && this.warned.t < 1.2 - bot.s.lag);\n  }\n  hud() {\n    const hud = this.game.hud;\n    hud.setTime(this.cfg.time - this.t);\n    hud.setScore(`${Math.round((100 * this.inT) / Math.max(1, this.t))}%`, 'Time in zone');\n    if (this.calmBar) this.calmBar.set(this.calm);\n    const lane = this.lanes[0];\n    lane.discView.zone = { x: 0, z: 0, r: this.cfg.zone, on: Math.hypot(lane.dotX, lane.dotZ) < this.cfg.zone };\n  }\n  frameEvent(dt) {\n    const lane = this.lanes[0], d = lane.doll, b = lane.bal, g = this.game;\n    d.setLean(0, 0, 0, 1);\n    d.root.position.set(lane.x, 0, 0);\n    d.root.rotation.set(b.leanZ * 0.32, 0, -b.leanX * 0.32);\n    this.heron.update(dt);\n    const T = this.t;\n    const n = this.arrived;\n    const lerp = (o, x, y, z, k = 2) => { o.position.x += (x - o.position.x) * Math.min(1, k * dt); o.position.y += (y - o.position.y) * Math.min(1, k * dt); o.position.z += (z - o.position.z) * Math.min(1, k * dt); };\n    if (n >= 1) lerp(this.dragon, lane.x, 0.97 + Math.sin(T * 40) * 0.003, 0.25); else lerp(this.dragon, lane.x + 3 + Math.sin(T) * 0.7, 2.2 + Math.sin(T * 2.3) * 0.3, 1.2 + Math.cos(T * 1.2));\n    if (n >= 2) lerp(this.frog, lane.x, 1.03, 0); else lerp(this.frog, lane.x + 4, -0.03, 2);\n    for (let i = 0; i < 3; i++) {\n      this.koi[i].visible = n >= 3;\n      const a = T * 0.5 + (i * 6.28) / 3;\n      this.koi[i].position.set(Math.cos(a) * 2.4, -0.1, Math.sin(a) * 2.4);\n      this.koi[i].rotation.y = -a;\n    }\n    if (n >= 4) lerp(this.turtle, lane.x + 1.3, -0.04, -0.6, 0.5); else lerp(this.turtle, lane.x + 6, -0.05, -3, 0.5);\n    if (n >= 5) {\n      const hp = this.heron.root.position;\n      const nearly = Math.hypot(hp.x - (lane.x - 1.2), hp.z - (-0.3)) < 0.25;\n      if (!nearly) lerp(this.heron.root, lane.x - 1.2, 0, -0.3, 0.4);\n      else if (!this.patted) { this.patted = true; this.heron.rig.loop('stand'); this.heron.rig.once('pat'); g.speech.say('stillwater', line('stillwater', 'pat'), { auto: 2.2, top: true }); }\n    }\n  }\n  isDone() { return this.t >= this.cfg.time; }\n  laneResult(lane) {\n    const share = this.inT / Math.max(1, Math.min(this.t, this.cfg.time));\n    const form = ((share + this.calm) / 2) * 100;\n    return { form, raw: form, big: Math.round(form), stats: `${Math.round(share * 100)}% in the zone · peak calm ${Math.round(this.peak * 100)}% · ${this.scattered} scattered` };\n  }\n}\nexport { Gull, h, float, smoothstep };\nEOF\ncat > src/data/charts.js <<'EOF'\n// Step Class charts: bars of 8 cells. L R B feet, < > ^ v lean, . rest.\nexport const PATTERNS = ['L...R...', 'L.R.L.R.', 'L.R.B...', 'L.L.R.R.', '<...>...', 'L.R.<...', '^...v...', 'LRL.RLR.', 'B.B.LRB.', 'L.R.LRLR'];\nconst P = (...idx) => idx.map((i) => PATTERNS[i]);\nconst REST = '........';\nconst rest = (n) => Array(n).fill(REST);\n/** Form: intro 4 (empty), A 8, B 8, A′ 8, break 4 (lean only), B′ 8, outro 4. */\nexport const CHARTS = {\n  tier1: [\n    ...rest(4),\n    ...P(0, 0, 1, 2, 0, 1, 1, 2),\n    ...P(1, 2, 4, 2, 1, 2, 4, 2),\n    ...P(0, 1, 1, 2, 1, 1, 0, 2),\n    ...P(4, 4, 4, 4),\n    ...P(1, 2, 4, 2, 2, 1, 4, 2),\n    ...rest(4),\n  ],\n  tier2: [\n    ...rest(4),\n    ...P(1, 2, 3, 2, 1, 3, 5, 2),\n    ...P(3, 5, 2, 6, 3, 5, 2, 6),\n    ...P(1, 3, 2, 5, 3, 1, 5, 2),\n    ...P(4, 6, 4, 6),\n    ...P(5, 3, 6, 2, 5, 3, 4, 2),\n    ...rest(4),\n  ],\n  tier3: [\n    ...rest(4),\n    ...P(3, 7, 2, 9, 7, 3, 8, 2),\n    ...P(9, 5, 7, 6, 8, 9, 5, 4),\n    ...P(7, 9, 8, 3, 9, 7, 2, 5),\n    ...P(4, 6, 4, 6),\n    ...P(8, 7, 9, 5, 7, 8, 6, 2),\n    ...rest(4),\n  ],\n  session: [\n    ...rest(2),\n    ...P(1, 2, 3, 2, 1, 3, 5, 2),\n    ...P(3, 5, 2, 1),\n    ...P(4, 6, 4, 6),\n    ...P(5, 3, 2, 1),\n    ...rest(2),\n  ],\n};\nexport function chartNotes(name, bpm) {\n  const bars = CHARTS[name];\n  const beat = 60 / bpm;\n  const notes = [];\n  bars.forEach((bar, b) => {\n    for (let c = 0; c < 8; c++) {\n      const ch = bar[c];\n      if (ch === '.') continue;\n      notes.push({ t: (b * 4 + c * 0.5) * beat, type: ch, lean: '<>^v'.includes(ch), bar: b });\n    }\n  });\n  return { notes, length: bars.length * 4 * beat, beat };\n}\nEOF\n","description":"Write Poses, The Cairn, Still Water and step charts"}}}
