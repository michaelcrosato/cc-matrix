 0.02, 32), basic(0xBFE9F0)));\n    mirror.children[1].rotation.x = Math.PI / 2; mirror.children[1].scale.z = 1.5;\n    g.add(mirror);\n    this.spot('mirror', g);\n  }\n  gazebo() {\n    const g = G();\n    add(g, M(geo.cyl(3.1, 3.3, 0.3, 6), CREAM, 0, 0.15, 0));\n    for (let i = 0; i < 6; i++) { const a = (i / 6) * Math.PI * 2; add(g, post(2.7, 0.08, CREAM, Math.cos(a) * 2.8, 0.3, Math.sin(a) * 2.8)); }\n    const roof = pavilionRoof(3.5, RED, CREAM); roof.position.y = 3; g.add(roof);\n    add(g, M(geo.cyl(0.9, 0.9, 0.08, 16), TEAK, 0, 0.34, 0));\n    this.spot('gazebo', g);\n  }\n  buildDressing() {\n    const g = this.group;\n    const treeSpots = [[-7, 0], [-5, 7], [-11, -6], [6, -5], [7, 2], [11, 3], [11, -8], [-3, 12], [4, 12], [-2, -12], [5, -11], [-10, 12], [12, 8], [-4, 4], [-13, -9]];\n    for (const [x, z] of treeSpots) {\n      const t = tree(cos(1.6, 2.8), cos(0.9, 1.4), cosPick([LEAF, LEAF2, 0x4F9F5A]));\n      t.position.set(x, 0, z);\n      g.add(t);\n    }\n    for (const [x, z] of [[-19.5, 8], [10, 19], [-18, -11], [-14, 15], [0, -20], [20, -8]]) { const p = palm(cos(2.8, 3.8)); p.position.set(x, 0, z); p.rotation.y = cos(0, 6); g.add(p); }\n    for (let i = 0; i < 18; i++) {\n      const a = cos(0, 6.28), r = cos(16, 21);\n      g.add(M(geo.sphere(cos(0.2, 0.5), 8, 6), STONE_D, Math.cos(a) * r, 0.06, Math.sin(a) * r, { scale: [1, 0.5, 0.8] }));\n    }\n    g.add(bunting(-1, 4, 7, 7, 3.2, 7.6, 12));\n    g.add(bunting(1, 2.6, 9, -7, 2.4, 11, 12));\n    for (let i = 0; i < 18; i++) {\n      const a = (i / 18) * Math.PI * 2 + 0.1;\n      add(g, M(geo.cone(0.1, 0.5, 6), LEAF, Math.cos(a) * 15.3, 0.25, Math.sin(a) * 15.3));\n    }\n  }\n  buildCast() {\n    this.trudy = new Trudy();\n    this.group.add(this.trudy.root);\n    this.heron = new Heron();\n    this.heron.root.position.set(-16, 0.43, -5);\n    this.group.add(this.heron.root);\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(-5, 0, 11);\n    this.walrus.root.rotation.y = 0.5;\n    this.group.add(this.walrus.root);\n    this.gary = new Gull();\n    this.gary.root.position.set(1, 2.72, 9);\n    this.group.add(this.gary.root);\n    const G2 = [\n      { id: 'margaret', shirt: '#C9A0DC', hat: 'perm', height: 0.92, width: 1.02, shorts: 0x6B6B8F, home: [-2, 6] },\n      { id: 'kevin', shirt: '#6FB7D6', hat: 'visor', height: 1, width: 1, shorts: 0x38503A, home: [12, 15] },\n      { id: 'sandras', shirt: '#E78FB3', hat: 'bucket', height: 0.96, width: 1, shorts: 0x7A3F5A, home: [6, 4] },\n      { id: 'sandras', shirt: '#E78FB3', hat: 'bucket', height: 0.96, width: 1, shorts: 0x7A3F5A, home: [7, 5] },\n      { id: 'paul', shirt: '#F5C84A', hat: 'beret', height: 1.06, width: 0.94, shorts: 0x444455, home: [-8, -5] },\n      { id: 'gerald', shirt: '#7FA650', hat: 'none', height: 0.88, width: 0.96, shorts: 0x5A4A3A, home: [-10, 3] },\n    ];\n    this.guests = G2.map((d, i) => {\n      const doll = new Doll({ shirt: d.shirt, hat: d.hat, height: d.height, width: d.width, shorts: d.shorts });\n      doll.flatFeet = false;\n      doll.root.position.set(d.home[0], 0, d.home[1]);\n      this.group.add(doll.root);\n      return { doll, id: d.id, home: d.home, x: d.home[0], z: d.home[1], tx: d.home[0], tz: d.home[1], wait: cos(0, 5), follow: i === 3 ? 2 : -1 };\n    });\n    this.lastGuestT = 0;\n  }\n  /** Guests wander between spots, and need no physics. */\n  updateCast(dt, tiltQuatInverse) {\n    this.trudy.update(dt);\n    this.heron.update(dt);\n    this.walrus.update(dt);\n    this.gary.update(dt);\n    for (const g of this.guests) {\n      if (g.follow >= 0) {\n        const f = this.guests[g.follow];\n        g.tx = f.x + 1.1; g.tz = f.z + 0.5;\n      } else if (g.wait > 0) g.wait -= dt;\n      const dx = g.tx - g.x, dz = g.tz - g.z, d = Math.hypot(dx, dz);\n      if (d > 0.3 && g.wait <= 0) {\n        const sp = 1.2 * Math.min(1, d);\n        g.x += (dx / d) * sp * dt; g.z += (dz / d) * sp * dt;\n        g.doll.face(Math.atan2(dx, dz));\n        g.doll.rig.loop('walk');\n      } else {\n        g.doll.rig.loop('idle');\n        if (g.follow < 0 && g.wait <= 0) {\n          g.wait = cos(3, 9);\n          const a = cos(0, 6.28), r = cos(1, 5);\n          g.tx = Math.max(-14, Math.min(14, g.home[0] + Math.cos(a) * r)); g.tz = Math.max(-14, Math.min(14, g.home[1] + Math.sin(a) * r));\n        }\n      }\n      g.doll.root.position.set(g.x, 0, g.z);\n      if (tiltQuatInverse) g.doll.root.quaternion.copy(tiltQuatInverse);\n      g.doll.update(dt);\n    }\n  }\n  /** Marble display on the island: settled positions from the last pour. */\n  buildMarbles(n = 320) {\n    const mesh = new THREE.InstancedMesh(geo.sphere(0.14, 12, 10), toon(0xffffff), n);\n    mesh.count = 0; mesh.castShadow = true; mesh.frustumCulled = false;\n    this.jarGroup.add(mesh);\n    this.marbleMesh = mesh;\n    return mesh;\n  }\n  /** On hover: a thick outline around a landmark. Built on first use. */\n  outline(id, on) {\n    const s = MAP[id];\n    if (!s || !s.group) return;\n    if (on && !s.outline) s.outline = makeOutline(s.group, 0.07);\n    if (s.outline) s.outline.visible = on;\n  }\n}\nfunction buoyOn(x, y, z) { const b = buoy(); b.position.set(x, y, z); return b; }\nEOF\ncat > src/physics/island.js <<'EOF'\nimport { RAPIER, groups, createWorld } from './world.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\n\nconst RAD = Math.PI / 180;\n/** Do not move the island. Tilt gravity. Rapier sees a fixed flat disc. */\nexport class IslandPhysics {\n  constructor() {\n    this.world = createWorld({ iterations: 6 });\n    this.tx = 0; this.tz = 0; this.vx = 0; this.vz = 0; this.rest = 9; this.restNow = 9; this.restAngle = 0.4;\n    this.leanExtraX = 0; this.leanExtraZ = 0;\n    this.walkerEnabled = false;\n    const disc = RAPIER.ColliderDesc.cylinder(0.5, 22).setTranslation(0, -0.5, 0).setFriction(0.9).setCollisionGroups(groups.ground());\n    this.world.createCollider(disc);\n    const n = 40;\n    for (let i = 0; i < n; i++) {\n      const a = (i / n) * Math.PI * 2;\n      const q = yawQ(-a);\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.15, 1, 1.9).setTranslation(Math.cos(a) * 21.9, 1, Math.sin(a) * 21.9).setRotation(q).setFriction(0.5).setCollisionGroups(groups.ground()));\n    }\n    // Walker\n    const b = this.walker = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, 0.9, 10).lockRotations().setCanSleep(false));\n    this.walkerCol = this.world.createCollider(RAPIER.ColliderDesc.capsule(0.5, 0.3).setMass(1).setFriction(0).setFrictionCombineRule(RAPIER.CoefficientCombineRule.Min).setCollisionGroups(((0x0100 << 16) | 0x0011) >>> 0), b);\n    this.wantX = 0; this.wantZ = 0;\n    this.props = [];\n    this.addProps();\n    this.q = { x: 0, y: 0, z: 0, w: 1 };\n  }\n  addProps() {\n    for (let i = 0; i < 44; i++) {\n      const a = cos(0, 6.28), r = cos(2, 19);\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(Math.cos(a) * r, 0.4, Math.sin(a) * r).setCanSleep(false).setAngularDamping(0.4).setLinearDamping(0.08));\n      this.world.createCollider(RAPIER.ColliderDesc.ball(0.14).setMass(0.05).setFriction(0.8).setRestitution(0.3).setCollisionGroups(((0x0010 << 16) | 0x0111) >>> 0), body);\n      this.props.push({ body, kind: 'orange', r: 0.14 });\n    }\n    for (let i = 0; i < 6; i++) {\n      const a = cos(0, 6.28), r = cos(5, 18);\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(Math.cos(a) * r, 0.6, Math.sin(a) * r).setCanSleep(false).setAngularDamping(0.3).setLinearDamping(0.05));\n      this.world.createCollider(RAPIER.ColliderDesc.ball(0.32).setMass(0.08).setFriction(0.6).setRestitution(0.6).setCollisionGroups(((0x0010 << 16) | 0x0111) >>> 0), body);\n      this.props.push({ body, kind: 'ball', r: 0.32 });\n    }\n    for (let i = 0; i < 8; i++) {\n      const a = cos(0, 6.28), r = cos(4, 18);\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(Math.cos(a) * r, 0.4, Math.sin(a) * r).setCanSleep(false));\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.3, 0.25, 0.3).setMass(0.5).setFriction(0.32).setCollisionGroups(((0x0010 << 16) | 0x0111) >>> 0), body);\n      this.props.push({ body, kind: 'crate', r: 0.3 });\n    }\n  }\n  /** Rest tilt in degrees, in a fixed direction. Eases on its own. */\n  setRest(deg) { this.rest = deg; }\n  get restTiltDeg() { return this.restNow; }\n  get tiltDeg() { return Math.hypot(this.tx, this.tz) / RAD; }\n  setPosition(x, z) { this.walker.setTranslation({ x, y: 0.9, z }, true); this.walker.setLinvel({ x: 0, y: 0, z: 0 }, true); }\n  get pos() { return this.walker.translation(); }\n  snapTilt() {\n    this.restNow = this.rest;\n    this.tx = this.restNow * RAD * Math.cos(this.restAngle); this.tz = this.restNow * RAD * Math.sin(this.restAngle); this.vx = 0; this.vz = 0;\n  }\n  /** One step. wantX, wantZ: walker speed. weight 0 means nobody is on the island. */\n  step(dt, { weight = 1 } = {}) {\n    this.restNow += Math.sign(this.rest - this.restNow) * Math.min(Math.abs(this.rest - this.restNow), dt * 0.9);\n    const restRad = this.restNow * RAD, K = tun.islandSpring, C = 1.8 * Math.sqrt(K / 2.2);\n    const restX = restRad * Math.cos(this.restAngle), restZ = restRad * Math.sin(this.restAngle);\n    const W = (K * tun.islandWeight * RAD) / 22 * weight;\n    const p = this.walker.translation();\n    this.vx += (K * restX + W * p.x + this.leanExtraX * K - K * this.tx - C * this.vx) * dt; this.tx += this.vx * dt;\n    this.vz += (K * restZ + W * p.z + this.leanExtraZ * K - K * this.tz - C * this.vz) * dt; this.tz += this.vz * dt;\n    const g = tun.gravity;\n    this.world.gravity = { x: g * Math.sin(this.tx), y: -g * Math.cos(Math.hypot(this.tx, this.tz)), z: g * Math.sin(this.tz) };\n    const v = this.walker.linvel();\n    this.walker.setLinvel({ x: this.wantX + this.tx * 3, y: v.y, z: this.wantZ + this.tz * 3 }, true);\n    this.world.step();\n    const a = Math.hypot(this.tx, this.tz) || 1e-9, s = Math.sin(a / 2);\n    this.q.x = (this.tz / a) * s; this.q.y = 0; this.q.z = (-this.tx / a) * s; this.q.w = Math.cos(a / 2);\n  }\n}\nfunction yawQ(a) { return { x: 0, y: Math.sin(a / 2), z: 0, w: Math.cos(a / 2) }; }\nEOF\n","description":"Write set props, island art and island physics"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B8uwhysTWp8UvUXb3CUXsA","type":"tool_result","content":"(Bash completed with no output)","is_error":false}]},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"e0c873cc-d5c8-4af0-aa52-284834b15334","timestamp":"2026-11-05T12:12:48.395Z","tool_use_result":{"stdout":"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01B8uwhysTWp8UvUXb3CUXsA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjm5JTTpWfWCPC2Bvduh","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22775,"cache_read_input_tokens":269419,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22775},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"0676fd0e-5104-41dd-afec-ca0feb29b82a","timestamp":"2026-11-05T12:12:50.515Z","request_id":"req_011Cgjm5J88Btqz5ZRA493tg","thinking_duration_ms":752,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgjm5JTTpWfWCPC2Bvduh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GuHQoJ8QNuGxXSTCRCP5Ej","name":"Bash","input":{"command":"cat > src/events/fruitHat.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, toon, add, basic } from '../art/materials.js';\nimport { planks, post, crate, barge, buoy, palm, WOOD, WOOD_D, TEAL, CREAM, ORANGE, RED } from '../art/props.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\n\nconst FRUIT = [\n  { col: 0xF08A3C, name: 'orange' }, { col: 0xD9483B, name: 'apple' }, { col: 0xF5D547, name: 'lemon' }, { col: 0x86C24A, name: 'lime' },\n];\nconst _v = new THREE.Vector3(), _q = new THREE.Quaternion();\n\nexport class FruitHat extends EventBase {\n  static id = 'fruitHat';\n  constructor(spec) {\n    super(spec);\n    this.iterations = 10;\n    this.balanceParams = { margin: this.cfg.margin, ankleMax: this.cfg.ankleMax };\n    this.items = []; this.nextFruit = 1; this.tosses = [];\n    this.seaLevel = -1.6;\n    this.greedy = spec.greedy || null;\n  }\n  setupLane(lane) {\n    const b = lane.bal.body, w = this.world, g = groups.doll(lane.id);\n    w.createCollider(RAPIER.ColliderDesc.cylinder(0.02, 0.36).setTranslation(0, 0.75, 0).setMass(0.01).setFriction(0.9).setCollisionGroups(g), b);\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * Math.PI * 2;\n      const q = { x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) };\n      w.createCollider(RAPIER.ColliderDesc.cuboid(0.02, 0.1, 0.16).setTranslation(Math.cos(a) * 0.36, 0.85, Math.sin(a) * 0.36).setRotation(q).setMass(0.001).setFriction(0.9).setCollisionGroups(g), b);\n    }\n    lane.hat = []; lane.bankT = 0; lane.banked = 0; lane.bankCount = 0; lane.bigBank = 0; lane.pile = 0;\n    lane.crateX = lane.x + 0.85; lane.crateZ = 0.45;\n    // The basket hat: a woven look from layered rings, on the doll's root so it leans with her.\n    const basket = G('basket', 0, 1.5, 0);\n    add(basket, M(geo.cyl(0.36, 0.34, 0.045, 26), 0xC99A62, 0, 0, 0));\n    for (let i = 0; i < 3; i++) add(basket, M(geo.tor(0.365, 0.026, Math.PI * 2, 36), i % 2 ? 0xB98347 : 0xD9AD72, 0, 0.03 + i * 0.07, 0, { rot: [Math.PI / 2, 0, 0] }));\n    add(basket, M(geo.cyl(0.2, 0.2, 0.04, 16), 0xE8B88A, 0, -0.03, 0));\n    lane.doll.root.add(basket);\n    lane.doll.joints.shoulderL.rotation.z = 0.2;\n    lane.doll.rig.loop('holdSlab');\n    const c = crate(0.72);\n    c.position.set(lane.crateX, this.floorY, lane.crateZ);\n    this.group.add(c);\n    lane.pileGroup = G('pile', lane.crateX, 0.5, lane.crateZ);\n    this.group.add(lane.pileGroup);\n  }\n  buildSet() {\n    const n = this.lanes.length, w = Math.max(9, n * 3.2 + 5);\n    const deck = planks(w, 6, { top: 0, thick: 0.2 });\n    this.group.add(deck);\n    for (let i = 0; i <= 3; i++) {\n      add(this.group, post(4, 0.16, WOOD_D, -w / 2 + (i / 3) * w, -3.9, 2.8), post(4, 0.16, WOOD_D, -w / 2 + (i / 3) * w, -3.9, -2.8));\n      add(this.group, post(0.9, 0.09, CREAM, -w / 2 + (i / 3) * w, 0, 2.85));\n    }\n    this.barge = barge();\n    this.barge.position.set(-7, this.seaLevel + 0.2, -13);\n    this.barge.rotation.y = 0.3;\n    this.group.add(this.barge);\n    for (const [x, z] of [[-12, -4], [11, -6], [8, -18]]) { const b = buoy(x > 0 ? RED : TEAL); b.position.set(x, this.seaLevel, z); this.group.add(b); }\n    const p = palm(3.4); p.position.set(w / 2 - 0.9, 0, -2.2); this.group.add(p);\n    this.ringGeo = geo.ring(0.11, 0.17, 24);\n    this.ringMat = basic(0x1A1420, { transparent: true, opacity: 0.55 });\n    this.cameraShot(true);\n    this.game.setBackdrop(-55, -130);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length;\n    const d = this.game.rig.fitDistance(8.4, (n - 1) * 3.2);\n    this.game.rig.shot(0, 1.7, d, 0, 1.25, -0.3, { snap, rate: 4 });\n  }\n  hudSetup(hud) {\n    if (this.lanes.length === 1) {\n      this.hatTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, ''));\n    }\n    hud.setScore(0, 'Banked');\n  }\n  start() {\n    this.nextFruit = 0.8;\n    this.bark('trudy', 'fruit_start', 3.2, 0);\n  }\n  launch(lane, kind) {\n    const c = this.cfg;\n    const radius = c.radius * tun.landingRadius;\n    const a = this.r() * Math.PI * 2, r = Math.sqrt(this.r()) * radius;\n    const sx = lane.x + Math.cos(a) * r, sz = Math.sin(a) * r;\n    const ox = lane.x - 5, oy = 0.6, oz = -5;\n    const T = 1.5, g = tun.gravity;\n    const props = {\n      fruit: { mass: c.mass * tun.fruitMass, value: 1, rad: 0.075 },\n      boot: { mass: c.mass * 2.2 * tun.fruitMass, value: 1, rad: 0.085 },\n      pineapple: { mass: c.mass * 3.5 * tun.fruitMass, value: 5, rad: 0.1 },\n      urchin: { mass: c.mass, value: 0, rad: 0.08 },\n    }[kind];\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic()\n      .setTranslation(ox, oy, oz).setLinvel((sx - ox) / T, (1.75 - oy) / T + 0.5 * g * T, (sz - oz) / T)\n      .setCcdEnabled(true).setCanSleep(false).setAngularDamping(0.4).setLinearDamping(0.02));\n    this.world.createCollider(RAPIER.ColliderDesc.ball(props.rad).setMass(props.mass).setFriction(0.8).setRestitution(0.1).setCollisionGroups(groups.prop(lane.id)), body);\n    const mesh = this.makeFruitMesh(kind);\n    this.group.add(mesh);\n    const ring = new THREE.Mesh(this.ringGeo, this.ringMat);\n    ring.position.set(sx, 0.015, sz); ring.scale.setScalar(2.2);\n    this.group.add(ring);\n    const it = { body, mesh, ring, kind, value: props.value, state: 'fly', t: 0, T, sx, sz, lane, rad: props.rad };\n    this.items.push(it);\n    return it;\n  }\n  makeFruitMesh(kind) {\n    if (kind === 'urchin') {\n      const g = G();\n      g.add(M(geo.sphere(0.08, 10, 8), 0x3B2A4F));\n      for (let i = 0; i < 14; i++) {\n        const ph = Math.acos(1 - 2 * (i + 0.5) / 14), th = i * 2.4;\n        const s = M(geo.cone(0.018, 0.11, 5), 0x1A1420, Math.sin(ph) * Math.cos(th) * 0.09, Math.cos(ph) * 0.09, Math.sin(ph) * Math.sin(th) * 0.09, { shadow: false });\n        s.lookAt(s.position.clone().multiplyScalar(2)); s.rotateX(Math.PI / 2);\n        g.add(s);\n      }\n      return g;\n    }\n    if (kind === 'boot') {\n      const g = G();\n      add(g, M(geo.cap(0.05, 0.09, 8), 0x6B4A2E, 0, 0.02, 0), M(geo.sphere(0.065, 8, 6), 0x6B4A2E, 0.04, -0.05, 0, { scale: [1.5, 0.7, 1] }));\n      return g;\n    }\n    if (kind === 'pineapple') {\n      const g = G();\n      add(g, M(geo.sphere(0.1, 10, 8), 0xF5C518, 0, 0, 0, { scale: [1, 1.2, 1] }));\n      for (let i = 0; i < 5; i++) { const a = (i / 5) * 6.28; add(g, M(geo.cone(0.03, 0.12, 5), 0x4F9F5A, Math.cos(a) * 0.02, 0.15, Math.sin(a) * 0.02, { rot: [Math.sin(a) * 0.5, 0, -Math.cos(a) * 0.5] })); }\n      return g;\n    }\n    const f = FRUIT[Math.floor(cos(0, FRUIT.length))];\n    return M(geo.sphere(0.075, 12, 10), f.col);\n  }\n  pickKind() {\n    const roll = this.r();\n    if (this.t > 22 && roll < 0.06) return 'pineapple';\n    if (this.t > 12 && roll < 0.14) return 'urchin';\n    if (this.t > 8 && roll < 0.22) return 'boot';\n    return 'fruit';\n  }\n  removeItem(it) {\n    const i = this.items.indexOf(it);\n    if (i >= 0) this.items.splice(i, 1);\n    if (it.body) { this.world.removeRigidBody(it.body); it.body = null; }\n    this.group.remove(it.mesh);\n    if (it.ring) { this.group.remove(it.ring); it.ring = null; }\n    if (it.state === 'hat') { const k = it.lane.hat.indexOf(it); if (k >= 0) it.lane.hat.splice(k, 1); }\n  }\n  /** Hop: everything in the hat goes in the crate. Bigger banks pay more. */\n  bank(lane) {\n    const n = lane.hat.length;\n    if (!n || lane.bankT > 0) return;\n    let value = 0;\n    for (const it of lane.hat.slice()) {\n      value += it.value;\n      const t = it.body.translation();\n      const m = it.mesh;\n      const start = { x: t.x, y: t.y, z: t.z };\n      this.removeItem(it);\n      this.group.add(m);\n      m.position.set(start.x, start.y, start.z);\n      this.tosses.push({ m, a: start, t: 0, dur: 0.5 + cos(0, 0.3), lane });\n    }\n    const mult = 1 + 0.1 * (n - 1);\n    const gain = value * mult;\n    lane.raw += gain; lane.banked += n; lane.bankCount++;\n    lane.bigBank = Math.max(lane.bigBank, n);\n    lane.bankT = 1;\n    lane.doll.rig.once('hop');\n    this.game.audio.sfx('whoosh');\n    this.game.audio.sfx('catch');\n    if (lane.kind === 'local') this.game.hud.setNote(`Banked ${n} × ${mult.toFixed(1)}`, 1.4);\n    this.bark('trudy', 'fruit_bank', 1.8, 9);\n  }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.nextFruit -= dt;\n    if (this.nextFruit <= 0 && this.t < c.time - 1.5) {\n      this.nextFruit += c.every * tun.fruitInterval;\n      const kind = this.pickKind();\n      for (const lane of this.lanes) if (lane.kind !== 'ghost') this.launch(lane, kind);\n      this.game.audio.sfx('thud', { pitch: 110 });\n    }\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost') continue;\n      lane.bankT = Math.max(0, lane.bankT - dt);\n      if (lane.input.hopPressed && !lane.fallen) this.bank(lane);\n      if (lane.hit > 0) {\n        lane.hit -= dt;\n        lane.bal.extX += lane.hitX * this.diff.dist; lane.bal.extZ += lane.hitZ * this.diff.dist;\n      }\n    }\n  }\n  afterStep(dt) {\n    for (let i = this.items.length - 1; i >= 0; i--) {\n      const it = this.items[i];\n      if (!it.body) continue;\n      it.t += dt;\n      const lane = it.lane;\n      const p = it.body.translation();\n      if (it.ring && it.t >= it.T) { this.group.remove(it.ring); it.ring = null; }\n      else if (it.ring) { it.ring.scale.setScalar(1 + (1 - it.t / it.T) * 1.8); }\n      if (it.state === 'fly' || it.state === 'hat') {\n        const inside = !lane.fallen && this.inBasket(lane, p);\n        if (it.state === 'fly' && inside) this.catchItem(it, lane);\n        else if (it.state === 'hat' && !inside) {\n          it.state = 'spill';\n          const k = lane.hat.indexOf(it); if (k >= 0) lane.hat.splice(k, 1);\n        }\n      }\n      if (p.y < it.rad + 0.04 && it.state !== 'gone') {\n        if (it.state !== 'landed') { it.state = 'landed'; it.gone = it.t + 1.1; this.game.audio.sfx('thud', { pitch: 240 }); this.game.fx && this.game.fx.burst(p.x, 0.05, p.z, 4, { colour: 0xE8D3A0, size: 0.04, up: 1.4, speed: 1.2, life: 0.35 }); }\n      }\n      if (it.gone && it.t > it.gone) this.removeItem(it);\n      if (p.y < -6) this.removeItem(it);\n    }\n  }\n  inBasket(lane, p) {\n    const b = lane.bal.body;\n    const q = b.rotation(), t = b.translation();\n    _q.set(q.x, q.y, q.z, q.w).invert();\n    _v.set(p.x - t.x, p.y - t.y, p.z - t.z).applyQuaternion(_q);\n    return Math.hypot(_v.x, _v.z) < 0.4 && _v.y > 0.7 && _v.y < 1.25;\n  }\n  catchItem(it, lane) {\n    if (it.kind === 'urchin') {\n      // Urchins knock the basket and cost points.\n      lane.raw = Math.max(0, lane.raw - 2);\n      const a = this.r() * 6.28;\n      lane.hit = 0.25; lane.hitX = Math.cos(a) * 1.2; lane.hitZ = Math.sin(a) * 1.2;\n      this.game.audio.sfx('spike');\n      it.body.applyImpulse({ x: Math.cos(a) * 0.02, y: 0.025, z: Math.sin(a) * 0.02 }, true);\n      it.state = 'spill';\n      it.gone = it.t + 0.9;\n      if (lane.kind === 'local') { this.game.comic.pop('OW!', lane.x, 2.4, 0); this.bark('trudy', 'fruit_urchin', 1.8, 4); this.game.input.rumble(0.6, 0.6, 180); }\n      return;\n    }\n    it.state = 'hat';\n    lane.hat.push(it);\n    this.game.audio.sfx('catch');\n    if (lane.kind === 'local') {\n      this.game.input.rumble(0.05, 0.3, 60);\n      this.game.hitStop(0.012);\n      if (it.kind === 'boot') this.bark('trudy', 'fruit_boot', 1.8, 8);\n      if (it.kind === 'pineapple') this.bark('trudy', 'fruit_gold', 2.2, 2);\n      if (lane.hat.length >= 8) this.bark('trudy', 'fruit_greedy', 2, 8);\n    }\n  }\n  onFlail(lane) {\n    // Flail shakes off whatever is on top.\n    const top = lane.hat[lane.hat.length - 1];\n    if (top) {\n      const a = this.r() * 6.28;\n      top.body.applyImpulse({ x: Math.cos(a) * 0.012, y: 0.02, z: Math.sin(a) * 0.012 }, true);\n    }\n  }\n  onFall(lane) {\n    // A fall spills everything unbanked: the basket is gone and the fruit keeps falling.\n    if (lane.hat.length >= 3 && lane.kind === 'local') this.game.speech.say('trudy', this.lineSpill(), { auto: 2.6, top: true });\n    for (const it of lane.hat) it.state = 'spill';\n    lane.hat = [];\n  }\n  lineSpill() { return this._line('trudy', 'fruit_spill'); }\n  _line(w, s) { return this.game.line(w, s); }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const bankAt = lane.bankAt ?? { sharp: 7, average: 6, clumsy: 5 }[bot.skillName] ?? 6;\n    // Lean only for a fruit in its last 0.95 s of flight: chasing every fruit makes you whip and fall.\n    let best = null;\n    for (const it of this.items) {\n      if (it.lane !== lane || it.state !== 'fly' || it.kind === 'urchin') continue;\n      const left = it.T - it.t + bot.s.lag * 0.4;\n      if (left < 0.95 && left > -0.15 && (!best || left < best.left)) best = { it, left };\n    }\n    let gx = 0, gz = 0;\n    if (best) {\n      const ml = lane.bal.maxLean;\n      const reach = 1.5 * Math.sin(ml);\n      gx = (best.it.sx - lane.x) / reach; gz = best.it.sz / reach;\n      const m = Math.hypot(gx, gz);\n      if (m > 1) { gx /= m; gz /= m; }\n    }\n    const [x, z] = bot.steer(gx, gz, lane.hat.length > 3);\n    out.wishX = x; out.wishZ = z;\n    out.hopPressed = bankAt < 99 && lane.hat.length >= bankAt && lane.bankT <= 0 && lane.bal.lean < 0.3;\n    out.hop = out.hopPressed;\n    out.flail = !lane.fallen && lane.bal.lean > 0.5 && lane.bal.flailCool <= 0;\n    out.footL = 0; out.footR = 0; out.breathe = false;\n    return null;\n  }\n  hud(dt) {\n    const hud = this.game.hud;\n    hud.setTime(this.cfg.time - this.t);\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    hud.setScore(Math.round(me.raw), 'Banked');\n    if (this.hatTag) {\n      const n = me.hat.length;\n      const s = n ? `In hat: ${n}  ×${(1 + 0.1 * (n - 1)).toFixed(1)}` : 'Hat empty';\n      if (this.hatTag.textContent !== s) this.hatTag.textContent = s;\n    }\n  }\n  frameEvent(dt) {\n    for (const it of this.items) {\n      if (!it.body) continue;\n      const p = it.body.translation(), q = it.body.rotation();\n      it.mesh.position.set(p.x, p.y, p.z);\n      it.mesh.quaternion.set(q.x, q.y, q.z, q.w);\n    }\n    for (let i = this.tosses.length - 1; i >= 0; i--) {\n      const s = this.tosses[i];\n      s.t += dt;\n      const k = Math.min(1, s.t / s.dur);\n      const lane = s.lane;\n      s.m.position.set(s.a.x + (lane.crateX - s.a.x) * k, s.a.y + (0.55 - s.a.y) * k + Math.sin(k * Math.PI) * 1.1, s.a.z + (lane.crateZ - s.a.z) * k);\n      if (k >= 1) {\n        this.tosses.splice(i, 1);\n        this.group.remove(s.m);\n        lane.pile++;\n        if (lane.pile < 26) {\n          lane.pileGroup.add(s.m);\n          const a = lane.pile * 2.4, r = 0.28 * Math.sqrt(lane.pile / 14);\n          s.m.position.set(Math.cos(a) * r, 0.02 * lane.pile * 0.5, Math.sin(a) * r);\n        }\n        this.game.audio.sfx('thud', { pitch: 300 });\n      }\n    }\n    if (this.barge) this.barge.rotation.z = Math.sin(this.t * 0.8) * 0.018;\n  }\n  isDone() { return this.t >= this.cfg.time; }\n  laneResult(lane) {\n    let unbanked = 0;\n    for (const it of lane.hat) unbanked += it.value;\n    const raw = lane.raw + (unbanked * (1 + 0.1 * (lane.hat.length - 1))) * 0.5;\n    const form = (100 * raw) / this.cfg.par;\n    return { form, raw, big: Math.round(raw), stats: `${lane.banked} banked · best hat ${lane.bigBank} · ${lane.falls} floor exercises` };\n  }\n}\nEOF\ncat > src/events/index.js <<'EOF'\n// The registry: cut an event by removing its line, and the programme quietly skips it.\nimport { FruitHat } from './fruitHat.js';\nexport const EVENT_CLASSES = { fruitHat: FruitHat };\nexport const hasEvent = (id) => !!EVENT_CLASSES[id];\nEOF\ncat > src/game/results.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { medalFor } from '../data/config.js';\nimport { line } from '../data/dialogue.js';\n\n/** Inked stamp SVG for a medal. */\nexport function medalSVG(m) {\n  return `<svg viewBox=\"-110 -110 220 220\" width=\"100%\" height=\"100%\"><g transform=\"rotate(-9)\"><circle r=\"96\" fill=\"${m.colour}\" stroke=\"#1A1420\" stroke-width=\"9\"/><circle r=\"78\" fill=\"none\" stroke=\"#1A1420\" stroke-width=\"3\" stroke-dasharray=\"5 7\"/>\n  <text y=\"9\" text-anchor=\"middle\" font-family=\"Fredoka,sans-serif\" font-weight=\"700\" font-size=\"${m.name.length > 8 ? 30 : 36}\" fill=\"#1A1420\">${m.name.toUpperCase()}</text></g></svg>`;\n}\n\nexport function resultBand(form) {\n  if (form >= 97) return 'results_sus';\n  if (form >= 65 && form < 85) return 'results_mid';\n  if (form >= 85) return 'results_high';\n  if (form >= 40) return 'results_mid';\n  return 'results_low';\n}\n\n/** Results: ink-stamp medal, one big number, one line of stats, a line of dialogue, retry or continue. */\nexport function showResults(game, { ev, result, title, tierName, onContinue, onRetry, extra = null, speaker }) {\n  const form = result.form;\n  const m = medalFor(form);\n  const who = speaker || ev.data.instructor;\n  const say = line(who, resultBand(form));\n  game.audio.sting(m.id);\n  game.audio.sfx('stamp');\n  const s = game.ui.only({\n    name: 'results', className: 'dim',\n    prompts: onRetry ? [['use', 'Continue'], ['ask', 'Try again']] : [['use', 'Continue']],\n    alt: onRetry ? () => onRetry() : null,\n    build(scr) {\n      const box = h('div.results',\n        h('div.h2', `${title}${tierName ? ` · ${tierName}` : ''}`),\n        h('div.row', { style: 'gap:6rem' },\n          h('div.medal', { html: medalSVG(m), 'data-medal': m.id, style: 'animation:pop .25s ease-out' }),\n          h('div.col', h('div.bignum', String(result.big ?? Math.round(form))), h('div.tag', { style: 'font-size:3.4rem' }, result.stats || ''))),\n        h('div.tag', { style: 'font-size:3.8rem;max-width:130rem;text-align:center' }, say),\n        extra);\n      scr.el.append(box);\n      const cont = scr.item(h('div', 'Continue'), { use: onContinue });\n      box.append(cont);\n      if (onRetry) {\n        const again = scr.item(h('div', 'Try again'), { use: onRetry });\n        const row = h('div.row', cont, again);\n        box.append(row);\n      }\n    },\n  });\n  return s;\n}\nEOF\n","description":"Write Fruit Hat, the event registry and results screen"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":22775,"cache_read_input_tokens":269419,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":22775},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"1bb89d5a-eaef-473b-86c3-c917ecdc3f83","timestamp":"2026-11-05T12:13:57.981Z","request_id":"req_011Cgjm5J88Btqz5ZRA493tg","wire_tool_inputs":{"toolu_01GuHQoJ8QNuGxXSTCRCP5Ej":{"command":"cat > src/events/fruitHat.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, toon, add, basic } from '../art/materials.js';\nimport { planks, post, crate, barge, buoy, palm, WOOD, WOOD_D, TEAL, CREAM, ORANGE, RED } from '../art/props.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\n\nconst FRUIT = [\n  { col: 0xF08A3C, name: 'orange' }, { col: 0xD9483B, name: 'apple' }, { col: 0xF5D547, name: 'lemon' }, { col: 0x86C24A, name: 'lime' },\n];\nconst _v = new THREE.Vector3(), _q = new THREE.Quaternion();\n\nexport class FruitHat extends EventBase {\n  static id = 'fruitHat';\n  constructor(spec) {\n    super(spec);\n    this.iterations = 10;\n    this.balanceParams = { margin: this.cfg.margin, ankleMax: this.cfg.ankleMax };\n    this.items = []; this.nextFruit = 1; this.tosses = [];\n    this.seaLevel = -1.6;\n    this.greedy = spec.greedy || null;\n  }\n  setupLane(lane) {\n    const b = lane.bal.body, w = this.world, g = groups.doll(lane.id);\n    w.createCollider(RAPIER.ColliderDesc.cylinder(0.02, 0.36).setTranslation(0, 0.75, 0).setMass(0.01).setFriction(0.9).setCollisionGroups(g), b);\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * Math.PI * 2;\n      const q = { x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) };\n      w.createCollider(RAPIER.ColliderDesc.cuboid(0.02, 0.1, 0.16).setTranslation(Math.cos(a) * 0.36, 0.85, Math.sin(a) * 0.36).setRotation(q).setMass(0.001).setFriction(0.9).setCollisionGroups(g), b);\n    }\n    lane.hat = []; lane.bankT = 0; lane.banked = 0; lane.bankCount = 0; lane.bigBank = 0; lane.pile = 0;\n    lane.crateX = lane.x + 0.85; lane.crateZ = 0.45;\n    // The basket hat: a woven look from layered rings, on the doll's root so it leans with her.\n    const basket = G('basket', 0, 1.5, 0);\n    add(basket, M(geo.cyl(0.36, 0.34, 0.045, 26), 0xC99A62, 0, 0, 0));\n    for (let i = 0; i < 3; i++) add(basket, M(geo.tor(0.365, 0.026, Math.PI * 2, 36), i % 2 ? 0xB98347 : 0xD9AD72, 0, 0.03 + i * 0.07, 0, { rot: [Math.PI / 2, 0, 0] }));\n    add(basket, M(geo.cyl(0.2, 0.2, 0.04, 16), 0xE8B88A, 0, -0.03, 0));\n    lane.doll.root.add(basket);\n    lane.doll.joints.shoulderL.rotation.z = 0.2;\n    lane.doll.rig.loop('holdSlab');\n    const c = crate(0.72);\n    c.position.set(lane.crateX, this.floorY, lane.crateZ);\n    this.group.add(c);\n    lane.pileGroup = G('pile', lane.crateX, 0.5, lane.crateZ);\n    this.group.add(lane.pileGroup);\n  }\n  buildSet() {\n    const n = this.lanes.length, w = Math.max(9, n * 3.2 + 5);\n    const deck = planks(w, 6, { top: 0, thick: 0.2 });\n    this.group.add(deck);\n    for (let i = 0; i <= 3; i++) {\n      add(this.group, post(4, 0.16, WOOD_D, -w / 2 + (i / 3) * w, -3.9, 2.8), post(4, 0.16, WOOD_D, -w / 2 + (i / 3) * w, -3.9, -2.8));\n      add(this.group, post(0.9, 0.09, CREAM, -w / 2 + (i / 3) * w, 0, 2.85));\n    }\n    this.barge = barge();\n    this.barge.position.set(-7, this.seaLevel + 0.2, -13);\n    this.barge.rotation.y = 0.3;\n    this.group.add(this.barge);\n    for (const [x, z] of [[-12, -4], [11, -6], [8, -18]]) { const b = buoy(x > 0 ? RED : TEAL); b.position.set(x, this.seaLevel, z); this.group.add(b); }\n    const p = palm(3.4); p.position.set(w / 2 - 0.9, 0, -2.2); this.group.add(p);\n    this.ringGeo = geo.ring(0.11, 0.17, 24);\n    this.ringMat = basic(0x1A1420, { transparent: true, opacity: 0.55 });\n    this.cameraShot(true);\n    this.game.setBackdrop(-55, -130);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length;\n    const d = this.game.rig.fitDistance(8.4, (n - 1) * 3.2);\n    this.game.rig.shot(0, 1.7, d, 0, 1.25, -0.3, { snap, rate: 4 });\n  }\n  hudSetup(hud) {\n    if (this.lanes.length === 1) {\n      this.hatTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, ''));\n    }\n    hud.setScore(0, 'Banked');\n  }\n  start() {\n    this.nextFruit = 0.8;\n    this.bark('trudy', 'fruit_start', 3.2, 0);\n  }\n  launch(lane, kind) {\n    const c = this.cfg;\n    const radius = c.radius * tun.landingRadius;\n    const a = this.r() * Math.PI * 2, r = Math.sqrt(this.r()) * radius;\n    const sx = lane.x + Math.cos(a) * r, sz = Math.sin(a) * r;\n    const ox = lane.x - 5, oy = 0.6, oz = -5;\n    const T = 1.5, g = tun.gravity;\n    const props = {\n      fruit: { mass: c.mass * tun.fruitMass, value: 1, rad: 0.075 },\n      boot: { mass: c.mass * 2.2 * tun.fruitMass, value: 1, rad: 0.085 },\n      pineapple: { mass: c.mass * 3.5 * tun.fruitMass, value: 5, rad: 0.1 },\n      urchin: { mass: c.mass, value: 0, rad: 0.08 },\n    }[kind];\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic()\n      .setTranslation(ox, oy, oz).setLinvel((sx - ox) / T, (1.75 - oy) / T + 0.5 * g * T, (sz - oz) / T)\n      .setCcdEnabled(true).setCanSleep(false).setAngularDamping(0.4).setLinearDamping(0.02));\n    this.world.createCollider(RAPIER.ColliderDesc.ball(props.rad).setMass(props.mass).setFriction(0.8).setRestitution(0.1).setCollisionGroups(groups.prop(lane.id)), body);\n    const mesh = this.makeFruitMesh(kind);\n    this.group.add(mesh);\n    const ring = new THREE.Mesh(this.ringGeo, this.ringMat);\n    ring.position.set(sx, 0.015, sz); ring.scale.setScalar(2.2);\n    this.group.add(ring);\n    const it = { body, mesh, ring, kind, value: props.value, state: 'fly', t: 0, T, sx, sz, lane, rad: props.rad };\n    this.items.push(it);\n    return it;\n  }\n  makeFruitMesh(kind) {\n    if (kind === 'urchin') {\n      const g = G();\n      g.add(M(geo.sphere(0.08, 10, 8), 0x3B2A4F));\n      for (let i = 0; i < 14; i++) {\n        const ph = Math.acos(1 - 2 * (i + 0.5) / 14), th = i * 2.4;\n        const s = M(geo.cone(0.018, 0.11, 5), 0x1A1420, Math.sin(ph) * Math.cos(th) * 0.09, Math.cos(ph) * 0.09, Math.sin(ph) * Math.sin(th) * 0.09, { shadow: false });\n        s.lookAt(s.position.clone().multiplyScalar(2)); s.rotateX(Math.PI / 2);\n        g.add(s);\n      }\n      return g;\n    }\n    if (kind === 'boot') {\n      const g = G();\n      add(g, M(geo.cap(0.05, 0.09, 8), 0x6B4A2E, 0, 0.02, 0), M(geo.sphere(0.065, 8, 6), 0x6B4A2E, 0.04, -0.05, 0, { scale: [1.5, 0.7, 1] }));\n      return g;\n    }\n    if (kind === 'pineapple') {\n      const g = G();\n      add(g, M(geo.sphere(0.1, 10, 8), 0xF5C518, 0, 0, 0, { scale: [1, 1.2, 1] }));\n      for (let i = 0; i < 5; i++) { const a = (i / 5) * 6.28; add(g, M(geo.cone(0.03, 0.12, 5), 0x4F9F5A, Math.cos(a) * 0.02, 0.15, Math.sin(a) * 0.02, { rot: [Math.sin(a) * 0.5, 0, -Math.cos(a) * 0.5] })); }\n      return g;\n    }\n    const f = FRUIT[Math.floor(cos(0, FRUIT.length))];\n    return M(geo.sphere(0.075, 12, 10), f.col);\n  }\n  pickKind() {\n    const roll = this.r();\n    if (this.t > 22 && roll < 0.06) return 'pineapple';\n    if (this.t > 12 && roll < 0.14) return 'urchin';\n    if (this.t > 8 && roll < 0.22) return 'boot';\n    return 'fruit';\n  }\n  removeItem(it) {\n    const i = this.items.indexOf(it);\n    if (i >= 0) this.items.splice(i, 1);\n    if (it.body) { this.world.removeRigidBody(it.body); it.body = null; }\n    this.group.remove(it.mesh);\n    if (it.ring) { this.group.remove(it.ring); it.ring = null; }\n    if (it.state === 'hat') { const k = it.lane.hat.indexOf(it); if (k >= 0) it.lane.hat.splice(k, 1); }\n  }\n  /** Hop: everything in the hat goes in the crate. Bigger banks pay more. */\n  bank(lane) {\n    const n = lane.hat.length;\n    if (!n || lane.bankT > 0) return;\n    let value = 0;\n    for (const it of lane.hat.slice()) {\n      value += it.value;\n      const t = it.body.translation();\n      const m = it.mesh;\n      const start = { x: t.x, y: t.y, z: t.z };\n      this.removeItem(it);\n      this.group.add(m);\n      m.position.set(start.x, start.y, start.z);\n      this.tosses.push({ m, a: start, t: 0, dur: 0.5 + cos(0, 0.3), lane });\n    }\n    const mult = 1 + 0.1 * (n - 1);\n    const gain = value * mult;\n    lane.raw += gain; lane.banked += n; lane.bankCount++;\n    lane.bigBank = Math.max(lane.bigBank, n);\n    lane.bankT = 1;\n    lane.doll.rig.once('hop');\n    this.game.audio.sfx('whoosh');\n    this.game.audio.sfx('catch');\n    if (lane.kind === 'local') this.game.hud.setNote(`Banked ${n} × ${mult.toFixed(1)}`, 1.4);\n    this.bark('trudy', 'fruit_bank', 1.8, 9);\n  }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.nextFruit -= dt;\n    if (this.nextFruit <= 0 && this.t < c.time - 1.5) {\n      this.nextFruit += c.every * tun.fruitInterval;\n      const kind = this.pickKind();\n      for (const lane of this.lanes) if (lane.kind !== 'ghost') this.launch(lane, kind);\n      this.game.audio.sfx('thud', { pitch: 110 });\n    }\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost') continue;\n      lane.bankT = Math.max(0, lane.bankT - dt);\n      if (lane.input.hopPressed && !lane.fallen) this.bank(lane);\n      if (lane.hit > 0) {\n        lane.hit -= dt;\n        lane.bal.extX += lane.hitX * this.diff.dist; lane.bal.extZ += lane.hitZ * this.diff.dist;\n      }\n    }\n  }\n  afterStep(dt) {\n    for (let i = this.items.length - 1; i >= 0; i--) {\n      const it = this.items[i];\n      if (!it.body) continue;\n      it.t += dt;\n      const lane = it.lane;\n      const p = it.body.translation();\n      if (it.ring && it.t >= it.T) { this.group.remove(it.ring); it.ring = null; }\n      else if (it.ring) { it.ring.scale.setScalar(1 + (1 - it.t / it.T) * 1.8); }\n      if (it.state === 'fly' || it.state === 'hat') {\n        const inside = !lane.fallen && this.inBasket(lane, p);\n        if (it.state === 'fly' && inside) this.catchItem(it, lane);\n        else if (it.state === 'hat' && !inside) {\n          it.state = 'spill';\n          const k = lane.hat.indexOf(it); if (k >= 0) lane.hat.splice(k, 1);\n        }\n      }\n      if (p.y < it.rad + 0.04 && it.state !== 'gone') {\n        if (it.state !== 'landed') { it.state = 'landed'; it.gone = it.t + 1.1; this.game.audio.sfx('thud', { pitch: 240 }); this.game.fx && this.game.fx.burst(p.x, 0.05, p.z, 4, { colour: 0xE8D3A0, size: 0.04, up: 1.4, speed: 1.2, life: 0.35 }); }\n      }\n      if (it.gone && it.t > it.gone) this.removeItem(it);\n      if (p.y < -6) this.removeItem(it);\n    }\n  }\n  inBasket(lane, p) {\n    const b = lane.bal.body;\n    const q = b.rotation(), t = b.translation();\n    _q.set(q.x, q.y, q.z, q.w).invert();\n    _v.set(p.x - t.x, p.y - t.y, p.z - t.z).applyQuaternion(_q);\n    return Math.hypot(_v.x, _v.z) < 0.4 && _v.y > 0.7 && _v.y < 1.25;\n  }\n  catchItem(it, lane) {\n    if (it.kind === 'urchin') {\n      // Urchins knock the basket and cost points.\n      lane.raw = Math.max(0, lane.raw - 2);\n      const a = this.r() * 6.28;\n      lane.hit = 0.25; lane.hitX = Math.cos(a) * 1.2; lane.hitZ = Math.sin(a) * 1.2;\n      this.game.audio.sfx('spike');\n      it.body.applyImpulse({ x: Math.cos(a) * 0.02, y: 0.025, z: Math.sin(a) * 0.02 }, true);\n      it.state = 'spill';\n      it.gone = it.t + 0.9;\n      if (lane.kind === 'local') { this.game.comic.pop('OW!', lane.x, 2.4, 0); this.bark('trudy', 'fruit_urchin', 1.8, 4); this.game.input.rumble(0.6, 0.6, 180); }\n      return;\n    }\n    it.state = 'hat';\n    lane.hat.push(it);\n    this.game.audio.sfx('catch');\n    if (lane.kind === 'local') {\n      this.game.input.rumble(0.05, 0.3, 60);\n      this.game.hitStop(0.012);\n      if (it.kind === 'boot') this.bark('trudy', 'fruit_boot', 1.8, 8);\n      if (it.kind === 'pineapple') this.bark('trudy', 'fruit_gold', 2.2, 2);\n      if (lane.hat.length >= 8) this.bark('trudy', 'fruit_greedy', 2, 8);\n    }\n  }\n  onFlail(lane) {\n    // Flail shakes off whatever is on top.\n    const top = lane.hat[lane.hat.length - 1];\n    if (top) {\n      const a = this.r() * 6.28;\n      top.body.applyImpulse({ x: Math.cos(a) * 0.012, y: 0.02, z: Math.sin(a) * 0.012 }, true);\n    }\n  }\n  onFall(lane) {\n    // A fall spills everything unbanked: the basket is gone and the fruit keeps falling.\n    if (lane.hat.length >= 3 && lane.kind === 'local') this.game.speech.say('trudy', this.lineSpill(), { auto: 2.6, top: true });\n    for (const it of lane.hat) it.state = 'spill';\n    lane.hat = [];\n  }\n  lineSpill() { return this._line('trudy', 'fruit_spill'); }\n  _line(w, s) { return this.game.line(w, s); }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const bankAt = lane.bankAt ?? { sharp: 7, average: 6, clumsy: 5 }[bot.skillName] ?? 6;\n    // Lean only for a fruit in its last 0.95 s of flight: chasing every fruit makes you whip and fall.\n    let best = null;\n    for (const it of this.items) {\n      if (it.lane !== lane || it.state !== 'fly' || it.kind === 'urchin') continue;\n      const left = it.T - it.t + bot.s.lag * 0.4;\n      if (left < 0.95 && left > -0.15 && (!best || left < best.left)) best = { it, left };\n    }\n    let gx = 0, gz = 0;\n    if (best) {\n      const ml = lane.bal.maxLean;\n      const reach = 1.5 * Math.sin(ml);\n      gx = (best.it.sx - lane.x) / reach; gz = best.it.sz / reach;\n      const m = Math.hypot(gx, gz);\n      if (m > 1) { gx /= m; gz /= m; }\n    }\n    const [x, z] = bot.steer(gx, gz, lane.hat.length > 3);\n    out.wishX = x; out.wishZ = z;\n    out.hopPressed = bankAt < 99 && lane.hat.length >= bankAt && lane.bankT <= 0 && lane.bal.lean < 0.3;\n    out.hop = out.hopPressed;\n    out.flail = !lane.fallen && lane.bal.lean > 0.5 && lane.bal.flailCool <= 0;\n    out.footL = 0; out.footR = 0; out.breathe = false;\n    return null;\n  }\n  hud(dt) {\n    const hud = this.game.hud;\n    hud.setTime(this.cfg.time - this.t);\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    hud.setScore(Math.round(me.raw), 'Banked');\n    if (this.hatTag) {\n      const n = me.hat.length;\n      const s = n ? `In hat: ${n}  ×${(1 + 0.1 * (n - 1)).toFixed(1)}` : 'Hat empty';\n      if (this.hatTag.textContent !== s) this.hatTag.textContent = s;\n    }\n  }\n  frameEvent(dt) {\n    for (const it of this.items) {\n      if (!it.body) continue;\n      const p = it.body.translation(), q = it.body.rotation();\n      it.mesh.position.set(p.x, p.y, p.z);\n      it.mesh.quaternion.set(q.x, q.y, q.z, q.w);\n    }\n    for (let i = this.tosses.length - 1; i >= 0; i--) {\n      const s = this.tosses[i];\n      s.t += dt;\n      const k = Math.min(1, s.t / s.dur);\n      const lane = s.lane;\n      s.m.position.set(s.a.x + (lane.crateX - s.a.x) * k, s.a.y + (0.55 - s.a.y) * k + Math.sin(k * Math.PI) * 1.1, s.a.z + (lane.crateZ - s.a.z) * k);\n      if (k >= 1) {\n        this.tosses.splice(i, 1);\n        this.group.remove(s.m);\n        lane.pile++;\n        if (lane.pile < 26) {\n          lane.pileGroup.add(s.m);\n          const a = lane.pile * 2.4, r = 0.28 * Math.sqrt(lane.pile / 14);\n          s.m.position.set(Math.cos(a) * r, 0.02 * lane.pile * 0.5, Math.sin(a) * r);\n        }\n        this.game.audio.sfx('thud', { pitch: 300 });\n      }\n    }\n    if (this.barge) this.barge.rotation.z = Math.sin(this.t * 0.8) * 0.018;\n  }\n  isDone() { return this.t >= this.cfg.time; }\n  laneResult(lane) {\n    let unbanked = 0;\n    for (const it of lane.hat) unbanked += it.value;\n    const raw = lane.raw + (unbanked * (1 + 0.1 * (lane.hat.length - 1))) * 0.5;\n    const form = (100 * raw) / this.cfg.par;\n    return { form, raw, big: Math.round(raw), stats: `${lane.banked} banked · best hat ${lane.bigBank} · ${lane.falls} floor exercises` };\n  }\n}\nEOF\ncat > src/events/index.js <<'EOF'\n// The registry: cut an event by removing its line, and the programme quietly skips it.\nimport { FruitHat } from './fruitHat.js';\nexport const EVENT_CLASSES = { fruitHat: FruitHat };\nexport const hasEvent = (id) => !!EVENT_CLASSES[id];\nEOF\ncat > src/game/results.js <<'EOF'\nimport { h } from '../ui/dom.js';\nimport { medalFor } from '../data/config.js';\nimport { line } from '../data/dialogue.js';\n\n/** Inked stamp SVG for a medal. */\nexport function medalSVG(m) {\n  return `<svg viewBox=\"-110 -110 220 220\" width=\"100%\" height=\"100%\"><g transform=\"rotate(-9)\"><circle r=\"96\" fill=\"${m.colour}\" stroke=\"#1A1420\" stroke-width=\"9\"/><circle r=\"78\" fill=\"none\" stroke=\"#1A1420\" stroke-width=\"3\" stroke-dasharray=\"5 7\"/>\n  <text y=\"9\" text-anchor=\"middle\" font-family=\"Fredoka,sans-serif\" font-weight=\"700\" font-size=\"${m.name.length > 8 ? 30 : 36}\" fill=\"#1A1420\">${m.name.toUpperCase()}</text></g></svg>`;\n}\n\nexport function resultBand(form) {\n  if (form >= 97) return 'results_sus';\n  if (form >= 65 && form < 85) return 'results_mid';\n  if (form >= 85) return 'results_high';\n  if (form >= 40) return 'results_mid';\n  return 'results_low';\n}\n\n/** Results: ink-stamp medal, one big number, one line of stats, a line of dialogue, retry or continue. */\nexport function showResults(game, { ev, result, title, tierName, onContinue, onRetry, extra = null, speaker }) {\n  const form = result.form;\n  const m = medalFor(form);\n  const who = speaker || ev.data.instructor;\n  const say = line(who, resultBand(form));\n  game.audio.sting(m.id);\n  game.audio.sfx('stamp');\n  const s = game.ui.only({\n    name: 'results', className: 'dim',\n    prompts: onRetry ? [['use', 'Continue'], ['ask', 'Try again']] : [['use', 'Continue']],\n    alt: onRetry ? () => onRetry() : null,\n    build(scr) {\n      const box = h('div.results',\n        h('div.h2', `${title}${tierName ? ` · ${tierName}` : ''}`),\n        h('div.row', { style: 'gap:6rem' },\n          h('div.medal', { html: medalSVG(m), 'data-medal': m.id, style: 'animation:pop .25s ease-out' }),\n          h('div.col', h('div.bignum', String(result.big ?? Math.round(form))), h('div.tag', { style: 'font-size:3.4rem' }, result.stats || ''))),\n        h('div.tag', { style: 'font-size:3.8rem;max-width:130rem;text-align:center' }, say),\n        extra);\n      scr.el.append(box);\n      const cont = scr.item(h('div', 'Continue'), { use: onContinue });\n      box.append(cont);\n      if (onRetry) {\n        const again = scr.item(h('div', 'Try again'), { use: onRetry });\n        const row = h('div.row', cont, again);\n        box.append(row);\n      }\n    },\n  });\n  return s;\n}\nEOF\n","description":"Write Fruit Hat, the event registry and results screen"}}}
