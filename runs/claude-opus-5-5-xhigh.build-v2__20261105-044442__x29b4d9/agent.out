{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjnZy3an4R3ptS1rvQY4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FNR93VgZMms3TYWtUGyxKm","name":"Bash","input":{"command":"cat > src/events/roomService.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { planks, post, buoy, bunting, pavilionRoof, WOOD_D, CREAM, TEAL, RED, ORANGE, palm } from '../art/props.js';\nimport { Gull } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst STEP_LEN = 0.55, CADENCE = 0.42;\nconst _q = new THREE.Quaternion(), _v = new THREE.Vector3();\n\n/** Carry five tumblers along a boardwalk. Small early leans keep the glasses; sudden big ones throw them. */\nexport class RoomService extends EventBase {\n  static id = 'roomService';\n  constructor(spec) {\n    super(spec);\n    this.iterations = 10;\n    this.balanceParams = { margin: 0.8, ankleMax: 6, reflex: 5 };\n    this.seaLevel = -1.6; this.endDist = this.cfg.length;\n    this.gustNext = 4; this.gust = null; this.leaderDone = false; this.clock = null; this.wobblePhase = 0;\n    this.gary = null; this.garyT = 12;\n  }\n  setupLane(lane) {\n    const b = lane.bal.body;\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.3, 0.02, 0.3).setTranslation(0, 0.5, -0.3).setMass(0.04).setFriction(1).setCollisionGroups(groups.doll(lane.id)), b);\n    lane.dist = 0; lane.targetSpeed = 0; lane.speed = 0; lane.lastFoot = null; lane.lastStep = -9; lane.side = 0; lane.rock = 0; lane.done = false; lane.doneT = null; lane.buoy = 0; lane.stumbles = 0; lane.splashes = 0; lane.gone = false; lane.flying = 0;\n    lane.tumblers = [];\n    const tray = G('tray', 0, 1.25, -0.3);\n    add(tray, M(geo.box(0.6, 0.04, 0.6), 0xC99A62), M(geo.box(0.62, 0.05, 0.02), 0x9A6E3E, 0, 0.02, 0.3), M(geo.box(0.62, 0.05, 0.02), 0x9A6E3E, 0, 0.02, -0.3));\n    lane.doll.root.add(tray);\n    lane.doll.face(Math.PI);\n    lane.doll.rig.loop('carryTray');\n    this.addTumblers(lane);\n  }\n  addTumblers(lane) {\n    const spots = [[0, 0], [0.16, 0.14], [-0.16, 0.14], [0.16, -0.14], [-0.16, -0.14]];\n    const n = 5;\n    const b = lane.bal;\n    for (let i = 0; i < n; i++) {\n      const [x, z] = spots[i];\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(b.fx + x, b.fy + 0.75 + 0.5 + 0.02 + 0.06 + 0.002, b.fz - 0.3 + z).setCanSleep(false).setAngularDamping(0.5).setLinearDamping(0.1));\n      this.world.createCollider(RAPIER.ColliderDesc.cylinder(0.06, 0.05).setMass(0.012).setFriction(0.9).setRestitution(0).setCollisionGroups(groups.prop(lane.id)), body);\n      const mesh = G();\n      const glassCol = [0xBFE9F0, 0xFAD7A0, 0xF4B6C8, 0xC9F2C7, 0xFFF3DC][i];\n      add(mesh, M(geo.cyl(0.055, 0.045, 0.13, 12), glassCol), M(geo.cyl(0.03, 0.03, 0.02, 8), 0xE8443A, 0.02, 0.075, 0));\n      this.group.add(mesh);\n      lane.tumblers.push({ body, mesh, on: true });\n    }\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length;\n    const length = this.cfg.length + 16;\n    this.lanes.forEach((lane) => {\n      const walk = planks(1.62, length, { along: 'z', top: 0, board: 0.5, thick: 0.1 });\n      walk.position.set(lane.x, 0, -length / 2 + 6);\n      g.add(walk);\n      for (let z = 4; z > -this.cfg.length - 8; z -= 5) {\n        add(g, post(3.4, 0.07, WOOD_D, lane.x - 0.82, -3.3, z), post(3.4, 0.07, WOOD_D, lane.x + 0.82, -3.3, z));\n        if (z % 10 === 4 % 10) { const b = buoy(z % 20 === 4 % 20 ? RED : TEAL); b.position.set(lane.x + 1.3, -0.2, z); b.scale.setScalar(0.8); g.add(b); }\n      }\n      // Far table\n      const tz = -this.cfg.length;\n      add(g, M(geo.cyl(0.55, 0.55, 0.05, 16), CREAM, lane.x, 0.84, tz - 1.2), post(0.84, 0.05, WOOD_D, lane.x, 0, tz - 1.2));\n    });\n    // The cabana at the far end.\n    const tz = -this.cfg.length - 3.8;\n    const span = Math.max(6, n * 3.2 + 3);\n    add(g, M(geo.box(span + 3, 0.2, 6), 0xC99A62, 0, -0.1, tz));\n    for (const x of [-span / 2, span / 2]) for (const z of [-2.5, 2.5]) add(g, post(3, 0.09, CREAM, x, 0, tz + z));\n    const roof = pavilionRoof(span * 0.75, TEAL, ORANGE); roof.position.set(0, 3, tz); g.add(roof);\n    const p = palm(3.4); p.position.set(span / 2 + 1, 0, tz + 1); g.add(p);\n    g.add(bunting(-span / 2, 2.8, tz + 2.5, span / 2, 2.8, tz + 2.5, 14));\n    this.game.setBackdrop(70, 90);\n  }\n  cameraShot(snap) {\n    const lead = this.lanes.reduce((m, l) => Math.max(m, l.dist || 0), 0);\n    const n = this.lanes.length;\n    const d = this.game.rig.fitDistance(5.4, (n - 1) * 3.2);\n    this.game.rig.shot(0, 3.6, -lead + d, 0, 1.25, -lead - 1.4, { snap, rate: 5 });\n    this.game.focus(0, 0, -lead, 18);\n  }\n  hudSetup(hud) { this.glassTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, '')); hud.setScore(5, 'Glasses'); }\n  start() { if (this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'tray_start'), { auto: 3.2, top: true }); }\n  /** The wind blows a telegraph for a full second first. */\n  scheduleGust() {\n    const c = this.cfg;\n    const a = this.r() < 0.5 ? 0 : Math.PI;\n    const force = c.gust * tun.gustForce;\n    this.gust = { warn: 1, dur: 0.5, x: Math.cos(a) * force, z: 0, a };\n    this.game.audio.sfx('gust');\n    this.game.hud.setNote('Wind!', 1);\n    for (const lane of this.lanes) if (lane.kind === 'local') this.game.input.rumble(0.05, 0.2, 200);\n    if (this.mode === 'solo') this.bark('trudy', 'tray_gust', 1.8, 10);\n    this.streaks = 1;\n  }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.gustNext -= dt;\n    if (this.gustNext <= 0 && !this.gust) { this.scheduleGust(); this.gustNext = c.every * (0.85 + this.r() * 0.3); }\n    if (this.gust) {\n      const g = this.gust;\n      if (g.warn > 0) g.warn -= dt;\n      else {\n        g.dur -= dt;\n        for (const lane of this.lanes) if (lane.bal && !lane.done) { lane.bal.extX += g.x * this.diff.dist; lane.bal.extZ += g.z * this.diff.dist; }\n        if (g.dur <= 0) this.gust = null;\n      }\n    }\n    if (c.gary) this.garyStep(dt);\n    if (c.wobbly) this.wobblePhase += dt;\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      this.laneStep(lane, dt);\n    }\n    if (this.clock !== null) this.clock -= dt;\n  }\n  laneStep(lane, dt) {\n    const b = lane.bal, i = lane.input, c = this.cfg;\n    if (lane.done) { b.moveFoot(b.fx, b.fy, b.fz); return; }\n    let foot = null;\n    if (i.footLPressed) foot = 'L'; else if (i.footRPressed) foot = 'R';\n    if (foot && !lane.fallen) {\n      if (foot === lane.lastFoot) {\n        // Same foot twice is a stumble.\n        lane.stumbles++; lane.rock = 0.18; lane.rockAmt = 0.6 * (this.r() < 0.5 ? -1 : 1);\n        this.game.audio.sfx('clack');\n      } else {\n        lane.lastFoot = foot; lane.lastStep = this.t;\n        lane.targetSpeed = STEP_LEN / CADENCE;\n        lane.rock = 0.18; lane.rockAmt = foot === 'L' ? -0.2 : 0.2;\n        lane.side += b.leanX * 0.25 * STEP_LEN;\n        lane.doll.rig.once(foot === 'L' ? 'stepL' : 'stepR', { speed: 0.8 });\n        lane.doll.rig.loop('carryTray');\n        this.game.audio.sfx('thud', { pitch: 200 + (foot === 'L' ? 0 : 30) });\n      }\n    }\n    if (this.t - lane.lastStep > 1.6 * CADENCE) lane.targetSpeed = 0;\n    lane.speed += (lane.targetSpeed - lane.speed) * (1 - Math.exp(-dt / 0.5));\n    if (lane.rock > 0) { lane.rock -= dt; b.extX += lane.rockAmt; }\n    if (c.wobbly && Math.sin(lane.dist * 0.9) > 0.86) b.extX += Math.sin(this.wobblePhase * 9) * 0.22;\n    lane.dist += lane.speed * dt;\n    b.moveFoot(lane.x + lane.side, 0, -lane.dist);\n    if (Math.abs(lane.side) > 0.8 && !lane.fallen) this.offEdge(lane);\n    if (lane.dist >= this.endDist) {\n      lane.done = true; lane.doneT = this.t; lane.targetSpeed = 0; lane.speed = 0;\n      this.game.audio.sfx('bell');\n      if (lane.kind === 'local' && this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'tray_done'), { auto: 3, top: true });\n      if (this.lanes.length > 1 && this.clock === null) { this.clock = 15; this.game.hud.setNote('15 seconds!', 2); }\n    }\n    if (lane.kind === 'local' && !lane.fallen && b.lean > 0.34) this.bark('trudy', 'near', 2, 8);\n    if (this.dist !== undefined) return;\n    for (const lt of [0]) { void lt; }\n  }\n  /** Off the edge: splash, respawn at the last buoy with one fewer glass. */\n  offEdge(lane) {\n    const b = lane.bal;\n    lane.splashes++;\n    const p = b.body.translation();\n    this.game.fx.splash(p.x, -0.4, p.z, 1.3);\n    this.game.audio.sfx('splash', { big: 1.2 });\n    this.game.comic.pop('SPLOSH!', p.x, 1.2, p.z);\n    if (lane.kind === 'local') this.bark('trudy', 'tray_splash', 2.6, 2);\n    lane.dist = Math.max(0, Math.floor(lane.dist / 10) * 10);\n    lane.side = 0; lane.speed = 0; lane.targetSpeed = 0;\n    const on = lane.tumblers.filter((t) => t.on);\n    if (on.length) { const t = on[on.length - 1]; t.on = false; this.removeTumbler(lane, t); }\n    // Lift everyone back: the same offset for doll and glasses.\n    const fx = lane.x, fz = -lane.dist;\n    const dx = fx - b.fx, dz = fz - b.fz;\n    b.foot.setTranslation({ x: fx, y: 0, z: fz }, true);\n    b.moveFoot(fx, 0, fz);\n    b.recover();\n    let k = 0;\n    const spots = [[0, 0], [0.16, 0.14], [-0.16, 0.14], [0.16, -0.14], [-0.16, -0.14]];\n    for (const t of lane.tumblers) {\n      if (!t.on || !t.body) continue;\n      const [sx, sz] = spots[k++];\n      t.body.setTranslation({ x: fx + sx, y: 0.75 + 0.5 + 0.02 + 0.06 + 0.002, z: fz - 0.3 + sz }, true);\n      t.body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true);\n      t.body.setLinvel({ x: 0, y: 0, z: 0 }, true); t.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n    }\n    return { dx, dz };\n  }\n  removeTumbler(lane, t) {\n    if (t.body) { this.world.removeRigidBody(t.body); t.body = null; }\n    this.group.remove(t.mesh);\n  }\n  garyStep(dt) {\n    this.garyT -= dt;\n    if (!this.gary && this.garyT <= 0) {\n      const lane = this.lanes.find((l) => l.kind !== 'ghost' && !l.done);\n      if (lane) {\n        const gull = new Gull();\n        gull.rig.loop('fly');\n        this.group.add(gull.root);\n        this.gary = { gull, t: 0, lane, took: false };\n        this.game.audio.sfx('squawk');\n      }\n      this.garyT = 13;\n    }\n    if (this.gary) {\n      const g = this.gary;\n      g.t += dt;\n      const k = g.t / 2.4;\n      const b = g.lane.bal;\n      const fx = b.fx, fz = b.fz;\n      const x = fx - 8 + 16 * k, y = 1.45 + Math.abs(k - 0.5) * 6, z = fz - 0.3;\n      g.gull.root.position.set(x, y, z);\n      g.gull.root.rotation.y = Math.PI / 2;\n      if (!g.took && k > 0.48) {\n        g.took = true;\n        const on = g.lane.tumblers.filter((t) => t.on);\n        // Gary swoops for a glass unless you lean out of his way.\n        if (on.length && Math.abs(g.lane.dotX) < 0.45) { const t = on[0]; t.on = false; g.carried = t; }\n      }\n      if (g.carried) { g.carried.mesh.position.set(x, y - 0.25, z); }\n      if (k >= 1) {\n        if (g.carried) this.removeTumbler(g.lane, g.carried);\n        this.group.remove(g.gull.root); this.gary = null;\n      }\n    }\n  }\n  afterStep() {\n    for (const lane of this.lanes) {\n      if (!lane.tumblers) continue;\n      const b = lane.bal.body.translation(), q = lane.bal.body.rotation();\n      _q.set(q.x, q.y, q.z, q.w).invert();\n      for (const t of lane.tumblers) {\n        if (!t.on || !t.body) continue;\n        const p = t.body.translation();\n        _v.set(p.x - b.x, p.y - b.y, p.z - b.z).applyQuaternion(_q);\n        const fell = _v.y < 0.42 || Math.hypot(_v.x, _v.z + 0.3) > 0.42 || lane.fallen;\n        if (fell) {\n          t.on = false;\n          this.game.audio.sfx('plateCrash');\n          if (lane.kind === 'local') { this.bark('trudy', 'tray_spill', 2, 4); this.game.input.rumble(0.3, 0.5, 120); }\n        }\n      }\n      for (const t of lane.tumblers) {\n        if (t.body && !t.on && t.body.translation().y < -4) this.removeTumbler(lane, t);\n      }\n    }\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const d = bot.data;\n    d.next = (d.next ?? 0.2) - 1 / 120;\n    out.footLPressed = false; out.footRPressed = false; out.footL = 0; out.footR = 0;\n    if (d.next <= 0 && !lane.done && !lane.fallen) {\n      d.next = CADENCE * (1 + (bot.r() - 0.5) * bot.s.timing * 3);\n      d.foot = d.foot === 'L' ? 'R' : 'L';\n      if (d.foot === 'L') { out.footLPressed = true; out.footL = 1; } else { out.footRPressed = true; out.footR = 1; }\n    }\n    // Keep centred; brace at .2 × gust on the telegraph.\n    let gx = -lane.side * 0.5, gz = 0;\n    const brace = lane.braceK ?? 0.2;\n    if (this.gust && this.gust.warn < 1 - bot.s.lag * 0.5) gx += -Math.sign(this.gust.x) * brace * Math.abs(this.gust.x);\n    const [x, z] = bot.steer(gx, gz, true);\n    out.wishX = x; out.wishZ = z;\n    out.flail = !lane.fallen && lane.bal.lean > 0.6 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    const on = me.tumblers ? me.tumblers.filter((t) => t.on).length : 0;\n    hud.setScore(on, 'Glasses');\n    hud.setTime(this.clock !== null ? this.clock : null);\n    const s = `${Math.max(0, Math.round(this.endDist - (me.dist || 0)))} m to go`;\n    if (this.glassTag && this.glassTag.textContent !== s) this.glassTag.textContent = s;\n    for (const lane of this.lanes) {\n      const g = this.gust;\n      lane.discView.brace = g && g.warn > 0 ? { x: -Math.sign(g.x), z: 0 } : null;\n      lane.discView.zone = null;\n    }\n  }\n  frameEvent(dt) {\n    this.cameraShot(false);\n    for (const lane of this.lanes) {\n      if (!lane.tumblers) continue;\n      for (const t of lane.tumblers) {\n        if (!t.body) continue;\n        const p = t.body.translation(), q = t.body.rotation();\n        t.mesh.position.set(p.x, p.y, p.z); t.mesh.quaternion.set(q.x, q.y, q.z, q.w);\n      }\n      if (lane.speed > 0.3 && lane.doll.rig.onceLeft <= 0) lane.doll.rig.loop('carryTray');\n    }\n    if (this.gary) this.gary.gull.update(dt);\n    if (this.gust && this.gust.warn > 0) {\n      const lead = this.lanes.reduce((m, l) => Math.max(m, l.dist || 0), 0);\n      const dir = Math.sign(this.gust.x);\n      this.game.fx.spawn(cos(-5, 5) - dir * 7, cos(0.5, 3), -lead + cos(-4, 1), dir * 14, 0, 0, 0.05, 0x1A1420, 0.5, 0);\n    }\n  }\n  isDone() {\n    const active = this.lanes.filter((l) => l.kind !== 'ghost');\n    if (active.every((l) => l.done)) return true;\n    return this.clock !== null && this.clock <= 0;\n  }\n  laneResult(lane) {\n    const on = lane.tumblers ? lane.tumblers.filter((t) => t.on).length : 0;\n    const delivered = lane.done ? on : Math.floor(on / 2);\n    const par = (this.cfg.length / STEP_LEN) * CADENCE;\n    const bonus = lane.done ? Math.max(0, 40 * (1 - (lane.doneT - par) / (par * 0.5))) : 0;\n    const raw = 100 * delivered + bonus;\n    return { form: (100 * raw) / 520, raw, big: `${delivered}/5`, stats: `${lane.done ? 'Delivered' : 'Not delivered'} · ${lane.stumbles} stumbles · ${lane.splashes} splashes · ${lane.falls} floor exercises` };\n  }\n}\nEOF\ncat > src/events/springboard.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { CREAM, RED, TEAL, BLUE, buoy, palm } from '../art/props.js';\nimport { Gull } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst W = (2 * Math.PI) / 0.9, ZETA = 0.035, H = 0.75;\nconst BLOCKS = [RED, 0xF5B700, TEAL, CREAM, BLUE, RED, 0xF5B700, TEAL, CREAM];\nconst DEG = Math.PI / 180;\nconst norm = (a) => { a %= Math.PI * 2; if (a < 0) a += Math.PI * 2; return a; };\n\n/** Pump, launch, spin. A clean entry earns Grace; a perfect belly flop earns Splash. */\nexport class Springboard extends EventBase {\n  static id = 'springboard';\n  constructor(spec) {\n    super(spec);\n    this.seaLevel = 0; this.god = true; this.customPose = true;\n    this.towerH = this.cfg.tower;\n    this.maxDives = this.cfg.dives || 3;\n    this.gary = null; this.garyT = 2;\n    this.done = false;\n    this.endWord = 'Splash!';\n  }\n  laneX(i) { return (i - (this.laneSpecs.length - 1) / 2) * 5; }\n  addGround() { /* Water, not floor: nothing to stand on below the board. */ }\n  setupLane(lane) {\n    const b = lane.bal;\n    b.moveFoot(lane.x + 1.6, this.towerH, 0);\n    b.foot.setTranslation({ x: lane.x + 1.6, y: this.towerH, z: 0 }, true);\n    b.body.setTranslation({ x: lane.x + 1.6, y: this.towerH + H, z: 0 }, true);\n    lane.dives = []; lane.dive = 0; lane.boardY = 0; lane.boardV = 0.4; lane.phase2 = 'pump'; lane.pumpT = 0; lane.air = 0; lane.angle = 0; lane.spin = 0; lane.last = null; lane.startY = 0; lane.topY = 0; lane.rec = []; lane.replayT = 0; lane.bestSplash = 0;\n    lane.doll.face(Math.PI / 2);\n    lane.doll.rig.loop('diveReady');\n    lane.doll.flatFeet = false;\n  }\n  buildSet() {\n    const g = this.group;\n    const blocks = Math.ceil(this.towerH);\n    for (const lane of this.lanes) {\n      const t = G('', lane.x - 0.4, 0, 0);\n      for (let i = 0; i < blocks; i++) add(t, M(geo.box(1.8, 1, 1.8), BLOCKS[i % BLOCKS.length], 0, i + 0.5 + (this.towerH - blocks), 0));\n      for (let i = 0; i < blocks; i += 2) add(t, M(geo.box(0.05, 0.3, 0.3), CREAM, 0.91, i + 0.5 + (this.towerH - blocks), 0));\n      g.add(t);\n      lane.towerTop = this.towerH;\n      const board = lane.board = G('', lane.x + 0.5, this.towerH + 0.04, 0);\n      add(board, M(geo.box(1.8, 0.07, 0.6), CREAM, 0.9, 0, 0));\n      g.add(board);\n      add(g, M(geo.cyl(0.05, 0.05, 0.5, 8), 0x8A5A32, lane.x + 0.6, this.towerH - 0.22, 0));\n    }\n    const b = buoy(RED); b.position.set(9, 0, -7); g.add(b);\n    const b2 = buoy(TEAL); b2.position.set(-7, 0, -8); g.add(b2);\n    const p = palm(3.2); p.position.set(this.lanes[0].x - 1, this.towerH, -0.6); p.scale.setScalar(0.5); g.add(p);\n    this.gull = new Gull();\n    this.gull.rig.loop('fly');\n    this.gull.root.position.set(-9, this.towerH + 2, -2);\n    this.gull.root.rotation.y = Math.PI / 2;\n    g.add(this.gull.root);\n    this.game.setBackdrop(-70, -120);\n    this.game.sea.setLevel(0);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length;\n    const d = this.game.rig.fitDistance(Math.max(13, this.towerH * 2.2), (n - 1) * 5 + 4);\n    this.game.rig.shot(this.lanes.length > 1 ? 1 : 2.4, this.towerH * 0.55 + 1.2, d, this.lanes.length > 1 ? 1 : 2.4, this.towerH * 0.55, 0, { snap, rate: 3 });\n  }\n  hudSetup(hud) {\n    this.power = hud.addWidget(hud.meter('Bounce', '#F5B700'));\n    this.diveTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, 'Dive 1 of 3'));\n    hud.setScore(0, 'Best');\n    hud.setDiscs([]);\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'dive_start'), { auto: 3.4, top: true }); }\n  fixedEvent(dt) {\n    this.flyGull(dt);\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      if (lane.phase2 === 'pump') this.pump(lane, dt);\n      else if (lane.phase2 === 'air') this.air(lane, dt);\n      else if (lane.phase2 === 'water') this.water(lane, dt);\n      else if (lane.phase2 === 'finished') { /* watching */ }\n    }\n    if (this.lanes.every((l) => l.kind === 'ghost' || l.phase2 === 'finished')) this.done = true;\n  }\n  pump(lane, dt) {\n    const i = lane.input, b = lane.bal;\n    const pumping = (i.footL > 0.5 && i.footR > 0.5);\n    const a = -W * W * lane.boardY - 2 * ZETA * W * lane.boardV - (pumping ? 8 * tun.boardGain : 0);\n    lane.boardV += a * dt; lane.boardY += lane.boardV * dt;\n    lane.boardY = Math.max(-0.7, Math.min(0.7, lane.boardY));\n    lane.pumpT += dt;\n    b.moveFoot(lane.x + 1.6, this.towerH + lane.boardY, 0);\n    if (lane.board) lane.board.position.y = this.towerH + 0.04 + lane.boardY * 0.6;\n    if (lane.board) lane.board.rotation.z = lane.boardY * 0.25;\n    if (Math.floor(lane.pumpT / 0.45) !== Math.floor((lane.pumpT - dt) / 0.45)) this.game.audio.sfx('metronome', { vel: 0.4 });\n    const timeLimit = this.mode === 'session' ? 7 : 16;\n    if (i.hopPressed || lane.pumpT > timeLimit) this.launch(lane);\n  }\n  launch(lane) {\n    const b = lane.bal;\n    const v = Math.max(3, lane.boardV);\n    lane.launchV = v;\n    b.release();\n    b.body.setLinvel({ x: 2.2, y: v, z: 0 }, true);\n    b.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n    lane.phase2 = 'air'; lane.air = 0; lane.angle = 0; lane.spin = 0; lane.startY = this.towerH; lane.topY = this.towerH; lane.rec = [];\n    lane.doll.rig.loop('spread');\n    this.game.audio.sfx('boing');\n    if (lane.board) { lane.board.position.y = this.towerH + 0.04; lane.board.rotation.z = 0; }\n    b.diveFree = true;\n  }\n  air(lane, dt) {\n    const i = lane.input, b = lane.bal;\n    lane.air += dt;\n    const tuck = i.hop;\n    // The stick sets a target spin; tuck multiplies it.\n    const target = i.wishX * 3.4 * tun.airTorque * (tuck ? 1.8 : 1);\n    lane.spin += (target - lane.spin) * (1 - Math.exp(-9 * dt));\n    lane.angle += lane.spin * dt;\n    b.body.setAngvel({ x: 0, y: 0, z: -lane.spin }, true);\n    if (tuck) lane.doll.rig.loop('tuck', { fade: 0.08 }); else lane.doll.rig.loop(Math.abs(lane.spin) > 0.3 ? 'pike' : 'spread', { fade: 0.15 });\n    const p = b.body.translation();\n    lane.topY = Math.max(lane.topY, p.y - H);\n    lane.rec.push({ x: p.x, y: p.y, a: lane.angle });\n    if (lane.rec.length > 240) lane.rec.shift();\n    if (p.y < 0.5) this.enter(lane);\n  }\n  /** Where the body lands: head or feet down within 12°, or front flat within 20°. */\n  enter(lane) {\n    const a = norm(lane.angle);\n    const err = (t) => { const d = Math.abs(a - t); return Math.min(d, Math.PI * 2 - d) / DEG; };\n    const feet = err(0), head = err(Math.PI), flop = err(Math.PI / 2);\n    const clean = Math.min(feet, head);\n    const height = lane.topY;\n    const mult = 1 + (height - 5) / 10;\n    const grace = clean <= 12 ? 100 * (1 - clean / 12) * mult : 0;\n    const splash = flop <= 20 ? 100 * (1 - flop / 20) * mult : 0;\n    const score = Math.max(grace, splash);\n    const kind = grace >= splash && grace > 0 ? 'Grace' : splash > 0 ? 'Splash' : 'Technically a Dive';\n    lane.dives.push({ score: Math.max(score, 8), kind, height });\n    lane.last = kind;\n    lane.dive++;\n    lane.phase2 = 'water'; lane.waterT = 0;\n    const b = lane.bal, p = b.body.translation();\n    b.disable();\n    lane.doll.ragdolled = true;\n    lane.doll.rig.update(0);\n    lane.ragdoll = new Ragdoll(this.world, lane.doll, this.group, { x: 2, y: -6, z: 0 });\n    lane.fallen = true;\n    const fx = this.game.fx;\n    if (kind === 'Splash') {\n      fx.splash(p.x, 0, p.z, 3.2);\n      for (let i = 0; i < 40; i++) fx.spawn(p.x + cos(-0.3, 0.3), 0, p.z + cos(-0.3, 0.3), cos(-0.8, 0.8), cos(5, 12), cos(-0.8, 0.8), cos(0.09, 0.22), 0xEFFBFB, 1.3);\n      this.game.audio.sfx('splash', { big: 2.2 });\n      this.game.comic.pop('SPLOSH!', p.x, 3, p.z, { size: 3.4 });\n      this.game.rig.shake(0.16);\n      if (this.gull && !this.gullHit) { this.gullHit = 1.5; this.game.audio.sfx('squawk'); }\n    } else if (kind === 'Grace') {\n      fx.splash(p.x, 0, p.z, 0.25);\n      this.game.audio.sfx('splash', { big: 0.3 });\n      this.game.comic.pop('...', p.x, 1.6, p.z, { size: 1.6 });\n    } else {\n      fx.splash(p.x, 0, p.z, 1);\n      this.game.audio.sfx('splash', { big: 1 });\n    }\n    if (lane.kind === 'local') {\n      this.game.input.rumble(kind === 'Splash' ? 1 : 0.4, 0.6, 300);\n      this.game.hud.flash(kind, 1.2);\n      this.game.speech.say('trudy', line('trudy', kind === 'Grace' ? 'dive_grace' : kind === 'Splash' ? 'dive_splash' : 'dive_other'), { auto: 2.6, top: true });\n    }\n  }\n  water(lane, dt) {\n    lane.waterT += dt;\n    // A simple upward force below the surface.\n    if (lane.ragdoll) {\n      for (const k of Object.keys(lane.ragdoll.bodies)) {\n        const body = lane.ragdoll.bodies[k], t = body.translation();\n        body.resetForces(true);\n        if (t.y < 0) { body.addForce({ x: 0, y: -t.y * 9 * body.mass() + 1.5 * body.mass() * tun.gravity * 0.9, z: 0 }, true); }\n      }\n      lane.ragdoll.sync();\n    }\n    const wait = this.mode === 'session' ? 1.6 : 2.6;\n    if (lane.waterT > wait) this.resetLane(lane);\n  }\n  resetLane(lane) {\n    const b = lane.bal;\n    lane.ragdoll.end(); lane.ragdoll = null;\n    lane.doll.ragdolled = false; lane.fallen = false;\n    b.reattach();\n    b.fx = lane.x + 1.6; b.fy = this.towerH; b.fz = 0;\n    b.foot.setTranslation({ x: b.fx, y: b.fy, z: 0 }, true);\n    b.recover();\n    lane.boardY = 0; lane.boardV = 0.4; lane.pumpT = 0; lane.angle = 0;\n    lane.doll.rig.loop('diveReady');\n    if (lane.dive >= this.maxDives) lane.phase2 = 'finished'; else { lane.phase2 = 'pump'; this.game.audio.sfx('spring'); }\n    if (lane.bot) lane.bot.data = {};\n    if (lane.testBot) lane.testBot.data = {};\n  }\n  flyGull(dt) {\n    const g = this.gull;\n    if (this.gullHit > 0) {\n      this.gullHit -= dt;\n      g.root.position.y += (this.gullHit > 1.2 ? 8 : -6) * dt;\n      g.root.rotation.z += dt * 10;\n      if (this.gullHit <= 0) { g.root.position.set(-12, this.towerH + 3, -2); g.root.rotation.z = 0; }\n      return;\n    }\n    g.root.position.x += dt * 2.2;\n    if (g.root.position.x > 14) g.root.position.x = -14;\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    out.hopPressed = false; out.hop = false; out.footL = 0; out.footR = 0; out.wishX = 0; out.wishZ = 0;\n    const d = bot.data;\n    if (lane.phase2 === 'pump') {\n      // Pump in phase: squeeze as the board goes down, with a reaction lag.\n      d.wait = (d.wait ?? (4.5 + bot.r() * 2.5));\n      const going = lane.boardV < -bot.s.lag * 0.5;\n      const v = going ? 1 : 0;\n      out.footL = v; out.footR = v;\n      if (lane.pumpT > d.wait && lane.boardV > 0.5 && lane.boardV > (d.prevV ?? 0)) d.armed = true;\n      if (d.armed && lane.boardV < (d.prevV ?? 0)) { out.hopPressed = true; out.hop = true; d.armed = false; }\n      d.prevV = lane.boardV;\n    } else if (lane.phase2 === 'air') {\n      // Aim for a belly flop by default (a quarter turn) or a head first dive.\n      const goal = (d.goal ?? (d.goal = bot.r() < (lane.wantDive ? 1 : 0.15) ? Math.PI : Math.PI / 2));\n      const vel = 0.5;\n      const coast = 0.22;\n      const rel = goal - lane.angle - coast * vel + bot.timing() * 0.8;\n      out.wishX = rel > 0.04 ? vel : 0;\n    }\n    if (out.wishX) out.wishX = Math.max(-1, Math.min(1, out.wishX));\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    const best = me.dives && me.dives.length ? Math.max(...me.dives.map((x) => x.score)) : 0;\n    hud.setScore(Math.round(best), 'Best');\n    hud.setTime(null);\n    if (this.power) this.power.set(Math.max(0, Math.abs(me.boardV || 0)) / 8);\n    const s = `Dive ${Math.min(this.maxDives, (me.dive || 0) + 1)} of ${this.maxDives}`;\n    if (this.diveTag && this.diveTag.textContent !== s) this.diveTag.textContent = s;\n  }\n  frameEvent(dt) {\n    if (this.gull) this.gull.update(dt);\n    for (const lane of this.lanes) {\n      if (!lane.bal || lane.fallen) continue;\n      const b = lane.bal, p = b.body.translation(), q = b.body.rotation();\n      if (lane.phase2 === 'air') {\n        lane.doll.root.position.set(p.x, p.y - H, p.z);\n        lane.doll.root.quaternion.set(q.x, q.y, q.z, q.w);\n      } else {\n        lane.doll.root.position.set(b.fx, b.fy, b.fz);\n        lane.doll.root.quaternion.set(0, 0, 0, 1);\n      }\n    }\n  }\n  isDone() { return this.done; }\n  laneResult(lane) {\n    const scores = (lane.dives || []).map((d) => d.score).sort((a, b) => b - a);\n    const best2 = scores.slice(0, 2);\n    const raw = best2.length ? best2.reduce((a, b) => a + b, 0) / 2 : 0;\n    const kinds = (lane.dives || []).map((d) => d.kind).join(', ');\n    return { form: (100 * raw) / (this.cfg.par * 0.72), raw, big: Math.round(raw), stats: kinds || 'No dives' };\n  }\n}\nexport { RAPIER, THREE };\nEOF\ncat > src/events/raft.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { WOOD, WOOD_D, CREAM, RED, TEAL } from '../art/props.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { blankInput } from '../input/input.js';\n\nconst K = 6, C = 3.5, WALK = 3, SHOVE_R = 1.3, MAX = 26 * Math.PI / 180;\nconst W_PER = (K * (14 * Math.PI / 180)) / 6;\n/** Everyone on one raft, on the same seesaw. Last doll standing wins the round. */\nexport class Raft extends EventBase {\n  static id = 'raft';\n  constructor(spec) {\n    super(spec);\n    this.discs = false; this.customPose = true; this.seaLevel = -0.6; this.god = true;\n    if (this.laneSpecs.length < 2) {\n      const skills = ['average', 'sharp', 'clumsy'];\n      const names = ['Retired Kevin', 'Sandra', 'Other Sandra'];\n      const cols = ['#6FB7D6', '#E78FB3', '#F5C84A'];\n      this.laneSpecs = [...this.laneSpecs, ...[0, 1, 2].map((i) => ({ kind: 'bot', skill: skills[i], name: names[i], colour: cols[i] }))];\n    }\n    this.round = 1; this.wins = {}; this.tx = 0; this.tz = 0; this.vx = 0; this.vz = 0; this.radius = this.cfg.radius; this.roundT = 0; this.stage = 'play'; this.waitT = 0; this.nextSwell = this.cfg.swell; this.done = false; this.shrinkT = this.cfg.shrink;\n    this.warn = 0;\n    this.sections = [];\n  }\n  addGround() {}\n  buildLane(lane, i) {\n    lane.doll = new (this.dollClass())( { shirt: lane.colour, hat: lane.hat });\n    lane.doll.flatFeet = false;\n    lane.bal = null;\n    this.spawnLane(lane, i);\n  }\n  dollClass() { return RaftDoll.cls; }\n  spawnLane(lane, i) {\n    const n = this.laneSpecs.length;\n    const a = (i / n) * Math.PI * 2 + Math.PI / 4;\n    lane.px = Math.cos(a) * 2.5; lane.pz = Math.sin(a) * 2.5; lane.vx = 0; lane.vz = 0; lane.out = false; lane.cool = 0; lane.y = 0; lane.hopT = 0; lane.vy = 0; lane.sx = 0; lane.sz = 0; lane.sink = 0;\n    lane.doll.root.visible = true;\n  }\n  buildSet() {\n    const g = this.group;\n    this.raftG = G('raft');\n    g.add(this.raftG);\n    const rings = [[0, 2], [2, 3], [3, 4], [4, 5], [5, 6]];\n    for (const [a, b] of rings) {\n      const seg = b === 2 ? 1 : 8;\n      for (let i = 0; i < seg; i++) {\n        const th0 = (i / seg) * Math.PI * 2, thL = (Math.PI * 2) / seg;\n        const shape = b === 2 ? new THREE.CylinderGeometry(2, 2, 0.26, 28) : ringSeg(a, b, th0, thL);\n        const m = new THREE.Mesh(shape, M(geo.box(1, 1, 1), (i + b) % 2 ? WOOD : 0xB98347).material);\n        m.castShadow = true; m.receiveShadow = true;\n        m.position.y = -0.13;\n        this.raftG.add(m);\n        this.sections.push({ m, r: b, drift: 0, a: th0 + thL / 2 });\n      }\n    }\n    add(this.raftG, M(geo.cyl(0.08, 0.08, 1.8, 10), CREAM, 0, 0.9, 0), M(geo.cone(0.5, 0.5, 3), RED, 0.25, 1.65, 0, { rot: [0, 0, -Math.PI / 2], scale: [1, 1, 0.1] }));\n    for (const lane of this.lanes) this.raftG.add(lane.doll.root);\n    this.lapBuoys = [];\n    this.game.setBackdrop(90, -110);\n    this.game.sea.setLevel(this.seaLevel);\n  }\n  cameraShot(snap) { this.game.rig.shot(0, 15, 15, 0, 0, 0, { snap, rate: 3, fov: 38 }); this.inputYaw = 0; }\n  hudSetup(hud) {\n    this.scoreTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, 'Round 1 of 3'));\n    hud.setScore('', '');\n    hud.setTime(null);\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'raft_start'), { auto: 3, top: true }); }\n  alive() { return this.lanes.filter((l) => !l.out); }\n  fixedEvent(dt) {\n    if (this.stage === 'between') {\n      this.waitT -= dt;\n      if (this.waitT <= 0) this.nextRound();\n      return;\n    }\n    this.roundT += dt;\n    this.shrinkT -= dt;\n    if (this.shrinkT <= 0 && this.radius > 2) {\n      this.shrinkT = this.cfg.shrink;\n      this.radius = Math.max(2, this.radius - 1);\n      this.game.audio.sfx('creak', { dur: 0.7 });\n      for (const s of this.sections) if (s.r > this.radius) s.drift = s.drift || 0.0001;\n    }\n    this.nextSwell -= dt;\n    if (this.warn > 0) {\n      this.warn -= dt;\n      if (this.warn <= 0) {\n        this.vx += Math.cos(this.swellA) * 2.5; this.vz += Math.sin(this.swellA) * 2.5;\n        this.game.audio.sfx('splash', { big: 0.6 });\n        this.game.rig.shake(0.05);\n      }\n    } else if (this.nextSwell <= 0) {\n      this.nextSwell = this.cfg.swell * (0.8 + this.r() * 0.4);\n      this.swellA = this.r() * Math.PI * 2;\n      this.warn = 1;\n      this.game.hud.setNote('A swell is coming', 1);\n      this.game.audio.sfx('gust', { dur: 0.8 });\n    }\n    // Everyone on the same seesaw.\n    let wx = 0, wz = 0;\n    for (const l of this.lanes) if (!l.out && l.y <= 0) { wx += l.px * W_PER; wz += l.pz * W_PER; }\n    this.vx += (wx - K * this.tx - C * this.vx) * dt; this.vz += (wz - K * this.tz - C * this.vz) * dt;\n    this.tx += this.vx * dt; this.tz += this.vz * dt;\n    const m = Math.hypot(this.tx, this.tz);\n    if (m > MAX) { this.tx *= MAX / m; this.tz *= MAX / m; }\n    for (const l of this.lanes) this.stepLane(l, dt);\n    const alive = this.alive();\n    if (alive.length <= 1 && this.stage === 'play') this.endRound(alive[0]);\n    if (this.roundT > 85 && this.stage === 'play') {\n      // Nobody stays dry for ever: the middle starts going too.\n      this.radius = Math.max(1, this.radius - dt * 0.2);\n    }\n  }\n  stepLane(l, dt) {\n    if (l.out) {\n      l.sink += dt;\n      return;\n    }\n    const i = l.input;\n    l.cool = Math.max(0, l.cool - dt);\n    let mx = i.moveX || 0, mz = i.moveZ || 0;\n    if (i.device === 'kbm' && !i.keysActive && l.kind === 'local' && !this.game.input.pointerActive) { mx = 0; mz = 0; }\n    const mm = Math.hypot(mx, mz);\n    if (mm > 1) { mx /= mm; mz /= mm; }\n    l.vx += (this.tx * 10) * dt * (l.y > 0 ? 0 : 1); l.vz += (this.tz * 10) * dt * (l.y > 0 ? 0 : 1);\n    l.vx *= Math.exp(-3 * dt); l.vz *= Math.exp(-3 * dt);\n    l.px += (mx * WALK + l.vx) * dt; l.pz += (mz * WALK + l.vz) * dt;\n    // Hop.\n    if (i.hopPressed && l.y <= 0) { l.vy = 3.4; this.game.audio.sfx('boing'); l.doll.rig.once('hop'); }\n    if (l.y > 0 || l.vy > 0) { l.vy -= 9.81 * dt; l.y = Math.max(0, l.y + l.vy * dt); if (l.y <= 0) { l.vy = 0; l.doll.rig.once('land'); this.game.audio.sfx('thud', { pitch: 240 }); } }\n    // Flail shoves in a short cone.\n    if (i.flail && l.cool <= 0) {\n      l.cool = 2;\n      l.doll.rig.once('flail');\n      this.game.audio.sfx('whoosh');\n      for (const o of this.lanes) {\n        if (o === l || o.out) continue;\n        const dx = o.px - l.px, dz = o.pz - l.pz, d = Math.hypot(dx, dz);\n        if (d < SHOVE_R && o.y <= 0) {\n          o.vx += (dx / Math.max(d, 0.1)) * 6; o.vz += (dz / Math.max(d, 0.1)) * 6;\n          this.game.audio.sfx('clack');\n          this.game.comic.pop('SHOVE!', o.px, 2, o.pz, { size: 1.6 });\n          this.game.input.rumble(0.4, 0.3, 120, o.input.padIndex >= 0 ? o.input.padIndex : undefined);\n        }\n      }\n    }\n    const d = Math.hypot(l.px, l.pz);\n    if (d > this.radius + 0.15 && l.y <= 0.3) {\n      l.out = true;\n      l.doll.rig.loop('spread');\n      this.game.fx.splash(l.px, this.seaLevel, l.pz, 1.4);\n      this.game.audio.sfx('splash', { big: 1.2 });\n      this.game.comic.pop('SPLOSH!', l.px, 1, l.pz);\n      if (l.kind === 'local') { this.game.onFloorExercise(); this.bark('trudy', 'raft_out', 2.2, 1); this.game.input.rumble(0.8, 0.5, 240); }\n    }\n    if (mm > 0.15) { l.doll.face(Math.atan2(mx, mz)); if (l.doll.rig.onceLeft <= 0) l.doll.rig.loop('walk', { speed: 1.3 }); } else if (l.doll.rig.onceLeft <= 0) l.doll.rig.loop('idle');\n  }\n  endRound(winner) {\n    this.stage = 'between'; this.waitT = 3.4;\n    if (winner) {\n      this.wins[winner.id] = (this.wins[winner.id] || 0) + 1;\n      winner.doll.rig.loop('cheer');\n      this.game.hud.flash(`${winner.name}!`, 2);\n      this.game.fx.confetti(winner.px, 5, winner.pz, 60, [0xE8443A, 0xF5B700, 0x2CB5A0, 0xFFF3DC], 3);\n      this.game.audio.sting('pleasant');\n      if (this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'raft_win'), { auto: 3, top: true });\n    }\n    this.lastWinner = winner;\n    const most = Math.max(0, ...Object.values(this.wins));\n    if (most >= 2 || this.round >= 3) { this.finishing = true; }\n  }\n  nextRound() {\n    if (this.finishing) { this.done = true; return; }\n    this.round++;\n    this.stage = 'play'; this.roundT = 0; this.radius = this.cfg.radius; this.shrinkT = this.cfg.shrink; this.tx = 0; this.tz = 0; this.vx = 0; this.vz = 0; this.nextSwell = this.cfg.swell; this.warn = 0;\n    for (const s of this.sections) { s.drift = 0; s.m.position.set(0, -0.13, 0); s.m.rotation.set(0, 0, 0); s.m.visible = true; }\n    this.lanes.forEach((l, i) => this.spawnLane(l, i));\n    if (this.scoreTag) this.scoreTag.textContent = `Round ${this.round} of 3`;\n    this.game.audio.sfx('bell');\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    Object.assign(out, blankInput());\n    if (lane.out) return;\n    // Stay toward the centre and the high side; go at whoever is close; shove when in reach.\n    let gx = -lane.px * 0.5 - this.tx * 6, gz = -lane.pz * 0.5 - this.tz * 6;\n    let near = null, nd = 1e9;\n    for (const o of this.lanes) { if (o === lane || o.out) continue; const d = Math.hypot(o.px - lane.px, o.pz - lane.pz); if (d < nd) { nd = d; near = o; } }\n    const edge = Math.hypot(lane.px, lane.pz) / this.radius;\n    if (near && nd < 3.5 && edge < 0.8) { gx += (near.px - lane.px) * 0.7; gz += (near.pz - lane.pz) * 0.7; }\n    const m = Math.hypot(gx, gz) || 1;\n    const k = Math.min(1, m);\n    let mx = (gx / m) * k, mz = (gz / m) * k;\n    const noise = bot.s.noise * 8;\n    mx += Math.sin(bot.t * 2.1 + bot.ph) * noise; mz += Math.sin(bot.t * 1.7 + bot.ph2) * noise;\n    out.moveX = mx; out.moveZ = mz; out.wishX = mx; out.wishZ = mz; out.useMove = true;\n    bot.data.react = (bot.data.react || 0) - 1 / 120;\n    if (near && nd < SHOVE_R * 0.95 && lane.cool <= 0 && bot.data.react <= 0) { out.flail = true; bot.data.react = bot.s.lag; }\n    out.device = 'pad';\n  }\n  hud() {\n    const hud = this.game.hud;\n    const me = this.lanes.find((l) => l.kind === 'local');\n    if (me) hud.setScore(this.wins[me.id] || 0, 'Rounds');\n  }\n  readInput(lane, dt) {\n    super.readInput(lane, dt);\n    if (lane.kind === 'local' && this.inputYaw === 0 && !lane.input.moveX && !lane.input.moveZ) { /* resting */ }\n  }\n  frameEvent(dt) {\n    const a = Math.hypot(this.tx, this.tz) || 1e-9, s = Math.sin(a / 2);\n    this.raftG.quaternion.set((this.tz / a) * s, 0, (-this.tx / a) * s, Math.cos(a / 2));\n    this.raftG.position.y = Math.sin(this.t * 0.9) * 0.05;\n    for (const sec of this.sections) {\n      if (sec.drift) {\n        sec.drift += dt;\n        const r = sec.drift * 0.9;\n        sec.m.position.set(Math.cos(sec.a) * r, -0.13 - sec.drift * 0.08, Math.sin(sec.a) * r);\n        sec.m.rotation.y = sec.drift * 0.1;\n        if (sec.drift > 6) sec.m.visible = false;\n      }\n    }\n    for (const l of this.lanes) {\n      const d = l.doll;\n      if (l.out) {\n        d.root.position.set(l.px, Math.max(-1.4, -0.6 - l.sink * 0.3), l.pz);\n      } else d.root.position.set(l.px, l.y, l.pz);\n      d.update(dt);\n    }\n  }\n  isDone() { return this.done; }\n  laneResult(lane) {\n    const w = this.wins[lane.id] || 0;\n    const form = 40 + 30 * w;\n    return { form, raw: w, big: `${w} won`, stats: `${w} rounds won of ${this.round}` };\n  }\n}\nfunction ringSeg(a, b, start, len) {\n  const shape = new THREE.Shape();\n  shape.absarc(0, 0, b, start, start + len - 0.02, false);\n  shape.absarc(0, 0, a, start + len - 0.02, start, true);\n  const g = new THREE.ExtrudeGeometry(shape, { depth: 0.26, bevelEnabled: false, curveSegments: 5 });\n  g.rotateX(-Math.PI / 2);\n  g.translate(0, -0.13, 0);\n  return g;\n}\nexport const RaftDoll = { cls: null };\nexport { WOOD_D, TEAL, rot2 };\nEOF\ncat > src/events/grandHold.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { Gull } from '../art/cast.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { MAP } from '../art/island.js';\n\nconst STAGES = ['pose', 'stones', 'storm', 'step', 'last'];\nconst _v = new THREE.Vector3();\n\n/** Your balance is tied to the island. Four 20-second remixes, and then the last hold. */\nexport class GrandHold extends EventBase {\n  static id = 'grandHold';\n  constructor(spec) {\n    super(spec);\n    this.iterations = 10;\n    this.breathOn = true; this.seaLevel = -6.4;\n    this.balanceParams = { margin: 0.8, ankleMax: 6 };\n    this.stageI = 0; this.stageT = 0; this.done = false; this.score = 0; this.inRing = 0; this.lastT = 0; this.lastIn = 0; this.restarts = 0;\n    this.ring = { x: 0, z: 0, r: 0.3 };\n    this.stones = []; this.plate = null; this.gust = null; this.gustNext = 3; this.cueT = 0; this.cue = null; this.cueScore = 0; this.cues = 0;\n    this.camA = 0; this.removeStage = 0; this.restStart = 0;\n  }\n  get stage() { return STAGES[this.stageI]; }\n  addGround() { /* The gallery floor is a rule. Only the bedsheet is ever used. */ }\n  build() {\n    this.game.setIsland('home');\n    super.build();\n    this.game.setIsland('home');\n    this.game.sea.setLevel(-6.4);\n    this.restStart = this.game.programme.restDeg();\n    this.game.phys.setRest(this.restStart);\n    this.game.phys.snapTilt();\n    // The class below, looking up.\n    const art = this.game.art;\n    for (const g of art.guests) { g.doll.rig.loop('lookUp'); g.wait = 999; }\n    art.heron.root.position.set(4, 0, -5);\n    art.walrus.root.position.set(0.5, 0, -4.8);\n    art.walrus.rig.loop('bounce');\n    art.trudy.root.position.set(1.5, 0, -6);\n    this.gary = new Gull();\n    this.gary.rig.loop('fly');\n    this.gary.root.visible = false;\n    this.group.add(this.gary.root);\n    this.syncGallery();\n  }\n  buildSet() {\n    const g = this.group;\n    add(g, M(geo.cyl(1.3, 1.3, 0.1, 24), 0xD8C7A0, 0, -0.05, 0));\n    // The bedsheet is held by the class. It appears when you need it.\n    this.sheet = M(geo.cyl(1.9, 1.9, 0.04, 24), 0xFFF8EA, 0, -7, 0);\n    this.sheet.visible = false;\n    g.add(this.sheet);\n  }\n  syncGallery() {\n    const g = this.game, art = g.art;\n    art.group.updateWorldMatrix(true, false);\n    _v.set(MAP.lighthouse.x, art.lighthouseTop + 0.2, MAP.lighthouse.z).applyMatrix4(art.group.matrixWorld);\n    this.group.position.copy(_v);\n    this.gallery = _v.clone();\n  }\n  setupLane(lane) {\n    lane.doll.rig.loop('pose3');\n  }\n  cameraShot(snap) {\n    const c = this.gallery || new THREE.Vector3(2, 9, -9);\n    const R = 8.5;\n    const a = 0.5 + this.camA;\n    const px = c.x + Math.sin(a) * R, pz = c.z + Math.cos(a) * R, py = c.y + 2.4;\n    this.game.rig.shot(px, py, pz, c.x, c.y + 0.9, c.z, { snap, rate: 3, fov: 42 });\n    this.inputYaw = a;\n  }\n  hudSetup(hud) {\n    this.phaseTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, ''));\n    hud.setScore('', '');\n  }\n  start() {\n    this.game.palette.set('golden', 2);\n    this.startStage(0);\n    this.game.speech.say('trudy', line('trudy', 'finale_start'), { auto: 3.4, top: true });\n  }\n  startStage(i) {\n    this.stageI = i; this.stageT = 0;\n    const lane = this.lanes[0];\n    const names = { pose: 'A pose, with breath', stones: 'Stones on your head', storm: 'Storm, with Gary', step: 'Step, in the wind', last: 'The last hold' };\n    if (this.phaseTag) this.phaseTag.textContent = names[this.stage];\n    this.game.audio.sfx('bell');\n    if (this.stage === 'pose') { this.ring = { x: 0.3, z: 0.1, r: 0.3 }; lane.doll.rig.loop('pose3', { fade: 0.5 }); this.game.speech.say('trudy', line('trudy', 'finale_pose'), { auto: 3, top: true }); }\n    if (this.stage === 'stones') { this.addPlate(lane); this.stoneNext = 2; this.stoneN = 0; this.ring = { x: 0, z: 0, r: 0.3 }; lane.doll.rig.loop('holdSlab', { fade: 0.5 }); this.game.speech.say('trudy', line('trudy', 'finale_stones'), { auto: 3, top: true }); }\n    if (this.stage === 'storm') {\n      this.gustNext = 3; this.ring = { x: 0, z: 0, r: 0.4 }; lane.doll.rig.loop('spread', { fade: 0.5 });\n      this.gary.root.visible = true; this.gary.rig.loop('stand');\n      lane.doll.joints.head.add(this.gary.root);\n      this.gary.root.position.set(0, 0.2, 0); this.gary.root.rotation.set(0, 0, 0);\n      this.game.speech.say('trudy', line('trudy', 'finale_gust'), { auto: 3.4, top: true });\n    }\n    if (this.stage === 'step') { this.cueT = 1; this.cueIdx = 0; this.ring = null; lane.doll.rig.loop('breathe', { fade: 0.5 }); this.game.speech.say('trudy', line('trudy', 'finale_step'), { auto: 3, top: true }); for (const g of this.game.art.guests) g.doll.rig.loop('cheer'); }\n    if (this.stage === 'last') {\n      this.ring = { x: 0, z: 0, r: 0.3 };\n      lane.doll.rig.loop('pose1', { fade: 1 });\n      if (this.gary.root.parent !== this.group) { this.gary.root.removeFromParent(); this.group.add(this.gary.root); this.gary.root.visible = false; }\n      this.game.speech.say('trudy', line('trudy', 'finale_last'), { auto: 4, top: true });\n      this.game.audio.stopMusic(3);\n    }\n  }\n  addPlate(lane) {\n    const b = lane.bal.body;\n    this.plateCol = this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.4, 0.03, 0.4).setTranslation(0, 0.8, 0).setMass(0.04).setFriction(1).setCollisionGroups(groups.doll(lane.id)), b);\n    this.plateMesh = M(geo.box(0.8, 0.06, 0.8), 0xD6CDB6, 0, 1.55, 0);\n    lane.doll.root.add(this.plateMesh);\n  }\n  addStone(lane) {\n    const b = lane.bal.body, t = b.translation(), q = b.rotation();\n    const i = this.stones.length;\n    const hh = 0.08, r = 0.22 - i * 0.02;\n    const base = 0.83 + i * 0.17 + hh + 0.012;\n    _v.set(0, base, 0).applyQuaternion(new THREE.Quaternion(q.x, q.y, q.z, q.w));\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(t.x + _v.x, t.y + _v.y, t.z + _v.z).setRotation(q).setCanSleep(false).setLinearDamping(0.1).setAngularDamping(0.6));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(r * 0.8, hh, r * 0.8).setMass(0.02).setFriction(0.95).setRestitution(0).setCollisionGroups(groups.prop(lane.id)), body);\n    const mesh = M(geo.sphere(1, 12, 8), [0xCFC8B6, 0xBDB5A2, 0xD8D2C2, 0xA9A18F][i], 0, 0, 0, { scale: [r, hh, r] });\n    this.group.add(mesh);\n    this.stones.push({ body, mesh });\n    this.game.audio.sfx('thud', { pitch: 150 });\n  }\n  /** Safe: remove the stones, step once, then remove the plate. */\n  clearStones() {\n    for (const s of this.stones) { this.world.removeRigidBody(s.body); this.group.remove(s.mesh); }\n    this.stones = [];\n    this.removeStage = 1;\n  }\n  afterStep() {\n    if (this.removeStage === 1) { this.removeStage = 2; return; }\n    if (this.removeStage === 2) {\n      if (this.plateCol) { this.world.removeCollider(this.plateCol, true); this.plateCol = null; }\n      if (this.plateMesh) { this.plateMesh.removeFromParent(); this.plateMesh = null; }\n      this.removeStage = 0;\n    }\n  }\n  fixedEvent(dt) {\n    const lane = this.lanes[0], b = lane.bal;\n    this.stageT += dt;\n    this.camA += dt * 0.06;\n    this.game.stepIsland(dt, 0);\n    // Your lean tips everything below you.\n    const [wx, wz] = rot2(lane.dotX, lane.dotZ, this.inputYaw);\n    this.game.phys.leanExtraX = wx * 0.07; this.game.phys.leanExtraZ = wz * 0.07;\n    this.syncGallery();\n    const inside = this.ring && Math.hypot(lane.dotX - this.ring.x, lane.dotZ - this.ring.z) < this.ring.r;\n    this.nowIn = !!inside;\n    if (inside) this.inRing += dt;\n    b.tremor = 0.05;\n    switch (this.stage) {\n      case 'pose':\n        b.sway = 0.1;\n        if (this.stageT >= 20) this.startStage(1);\n        break;\n      case 'stones':\n        b.sway = 0.12;\n        this.stoneNext -= dt;\n        if (this.stoneNext <= 0 && this.stoneN < 4) { this.addStone(lane); this.stoneN++; this.stoneNext = 3.4; }\n        if (this.stageT >= 20) { this.clearStones(); this.startStage(2); }\n        break;\n      case 'storm':\n        b.sway = 0.1;\n        this.gustNext -= dt;\n        if (this.gustNext <= 0 && !this.gust) {\n          const a = this.r() * 6.283;\n          this.gust = { warn: 1.2, dur: 0.5, x: Math.cos(a) * 3, z: Math.sin(a) * 3 };\n          this.gustNext = 5.2;\n          this.game.audio.sfx('gust', { dur: 1.2 });\n          this.game.hud.setNote('Brace!', 1.1);\n          this.game.input.rumble(0.1, 0.3, 300);\n        }\n        if (this.gust) {\n          if (this.gust.warn > 0) this.gust.warn -= dt;\n          else { this.gust.dur -= dt; b.extX += this.gust.x * this.diff.dist; b.extZ += this.gust.z * this.diff.dist; if (this.gust.dur <= 0) this.gust = null; }\n        }\n        if (this.stageT >= 20) { this.gust = null; this.startStage(3); }\n        break;\n      case 'step': {\n        b.sway = 0.12;\n        this.cueT -= dt;\n        if (this.cueT <= 0) {\n          const dirs = [[-1, 0], [1, 0], [0, -1], [0, 1]];\n          this.cue = dirs[this.cueIdx++ % 4];\n          this.cueT = 2.4; this.cues++;\n          this.ring = { x: this.cue[0] * 0.6, z: this.cue[1] * 0.6, r: 0.35 };\n          this.game.audio.sfx('foot', { note: 84 });\n        }\n        if (this.stageT >= 20) { this.startStage(4); }\n        break;\n      }\n      case 'last': {\n        const k = Math.min(1, this.stageT / 15);\n        this.ring.r = this.ramp(0.3, 0.08, k);\n        // Sway fades as you succeed; the final notch comes up.\n        b.sway = this.ramp(0.2, 0.02, k);\n        this.lastT += dt;\n        if (inside) this.lastIn += dt;\n        const rest = this.restStart * (1 - k);\n        this.game.phys.setRest(rest);\n        this.game.phys.restNow = rest;\n        if (this.stageT >= 15) { this.done = true; this.game.phys.setRest(0); this.game.phys.restNow = 0; }\n        break;\n      }\n      default: break;\n    }\n    if (this.gust && this.gust.warn > 0) lane.discView.brace = { x: -this.gust.x / 3, z: -this.gust.z / 3 };\n    else lane.discView.brace = null;\n  }\n  onFall(lane) {\n    // It cannot be failed. The class catches you with a stretched bedsheet, and the phase restarts.\n    this.restarts++;\n    this.game.speech.say('trudy', line('trudy', 'finale_catch'), { auto: 3, top: true });\n    this.sheet.visible = true;\n    this.restartAt = this.stageI;\n    for (const s of this.stones) { this.world.removeRigidBody(s.body); this.group.remove(s.mesh); }\n    this.stones = [];\n    void lane;\n  }\n  onRecover() {\n    this.sheet.visible = false;\n    this.stageT = 0;\n    if (this.stage === 'stones') { this.stoneNext = 1.5; this.stoneN = 0; }\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    let gx = 0, gz = 0;\n    if (this.ring) { gx = this.ring.x; gz = this.ring.z; }\n    if (this.gust && this.gust.warn > 0 && this.gust.warn < 1) { const f = 0.2; gx += (-this.gust.x / 3) * f * 3; gz += (-this.gust.z / 3) * f * 3; }\n    const [x, z] = bot.steer(gx, gz, this.stage === 'stones');\n    out.wishX = x; out.wishZ = z;\n    out.breathe = lane.breath.growing;\n    out.flail = !lane.fallen && lane.bal.lean > 0.56 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const lane = this.lanes[0], hud = this.game.hud;\n    const totals = { pose: 20, stones: 20, storm: 20, step: 20, last: 15 };\n    hud.setTime(Math.max(0, totals[this.stage] - this.stageT));\n    lane.discView.zone = this.ring ? { x: this.ring.x, z: this.ring.z, r: this.ring.r, on: this.nowIn } : null;\n  }\n  frameEvent(dt) {\n    const g = this.game;\n    g.syncIsland(dt);\n    this.cameraShot(false);\n    for (const s of this.stones) { const p = s.body.translation(), q = s.body.rotation(); s.mesh.position.set(p.x, p.y, p.z); s.mesh.quaternion.set(q.x, q.y, q.z, q.w); }\n    this.gary.update(dt);\n  }\n  isDone() { return this.done; }\n  laneResult() {\n    const share = this.lastIn / Math.max(1, this.lastT);\n    const form = 60 + 40 * share;\n    return { form, raw: form, big: Math.round(form), stats: `${Math.round(share * 100)}% in the last ring · ${this.restarts} caught by the bedsheet` };\n  }\n  dispose() {\n    const g = this.game;\n    g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    for (const gu of g.art.guests) { gu.wait = 1; gu.doll.rig.loop('idle'); }\n    g.art.heron.root.position.set(-16, 0.43, -5);\n    g.art.walrus.root.position.set(-5, 0, 11);\n    g.art.walrus.rig.loop('stand');\n    g.programme.syncIsland();\n    super.dispose();\n  }\n}\nEOF\ncat > src/events/index.js <<'EOF'\n// The registry: cut an event by removing its line, and the programme quietly skips it.\nimport { FruitHat } from './fruitHat.js';\nimport { Poses } from './poses.js';\nimport { Cairn } from './cairn.js';\nimport { StillWater } from './stillWater.js';\nimport { LogReps } from './logReps.js';\nimport { Plank } from './plank.js';\nimport { Tug } from './tug.js';\nimport { StepClass } from './stepClass.js';\nimport { Plates } from './plates.js';\nimport { IslandLoop } from './islandLoop.js';\nimport { RoomService } from './roomService.js';\nimport { Springboard } from './springboard.js';\nimport { Raft, RaftDoll } from './raft.js';\nimport { GrandHold } from './grandHold.js';\nimport { Doll } from '../art/doll.js';\n\nRaftDoll.cls = Doll;\nexport const EVENT_CLASSES = { fruitHat: FruitHat, poses: Poses, cairn: Cairn, stillWater: StillWater, logReps: LogReps, plank: Plank, tug: Tug, stepClass: StepClass, plates: Plates, islandLoop: IslandLoop, roomService: RoomService, springboard: Springboard, raft: Raft, grandHold: GrandHold };\nexport const hasEvent = (id) => !!EVENT_CLASSES[id];\nEOF\ncat >> ../PROGRESS.md <<'EOF'\n- 2026-11-05: Written so far: core, data, physics, render, input, audio, ui, flow, hub, jar, and all 14 events (untested beyond Fruit Hat). Still to write: checkin.js, ending.js, attract.js, devmode.js, groupclass.js, session.js (real), tools/test.mjs, then test everything.\nEOF\n","description":"Write Room Service, Springboard, Tippy Raft, Grand Hold and the registry"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":31766,"cache_read_input_tokens":411268,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":31766},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"9a27c910-733a-4f35-8f57-ea37ebf8c08a","timestamp":"2026-11-05T12:35:43.295Z","request_id":"req_011CgjnZxjjRPGCw46X2e1Kh","wire_tool_inputs":{"toolu_01FNR93VgZMms3TYWtUGyxKm":{"command":"cat > src/events/roomService.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { planks, post, buoy, bunting, pavilionRoof, WOOD_D, CREAM, TEAL, RED, ORANGE, palm } from '../art/props.js';\nimport { Gull } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst STEP_LEN = 0.55, CADENCE = 0.42;\nconst _q = new THREE.Quaternion(), _v = new THREE.Vector3();\n\n/** Carry five tumblers along a boardwalk. Small early leans keep the glasses; sudden big ones throw them. */\nexport class RoomService extends EventBase {\n  static id = 'roomService';\n  constructor(spec) {\n    super(spec);\n    this.iterations = 10;\n    this.balanceParams = { margin: 0.8, ankleMax: 6, reflex: 5 };\n    this.seaLevel = -1.6; this.endDist = this.cfg.length;\n    this.gustNext = 4; this.gust = null; this.leaderDone = false; this.clock = null; this.wobblePhase = 0;\n    this.gary = null; this.garyT = 12;\n  }\n  setupLane(lane) {\n    const b = lane.bal.body;\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.3, 0.02, 0.3).setTranslation(0, 0.5, -0.3).setMass(0.04).setFriction(1).setCollisionGroups(groups.doll(lane.id)), b);\n    lane.dist = 0; lane.targetSpeed = 0; lane.speed = 0; lane.lastFoot = null; lane.lastStep = -9; lane.side = 0; lane.rock = 0; lane.done = false; lane.doneT = null; lane.buoy = 0; lane.stumbles = 0; lane.splashes = 0; lane.gone = false; lane.flying = 0;\n    lane.tumblers = [];\n    const tray = G('tray', 0, 1.25, -0.3);\n    add(tray, M(geo.box(0.6, 0.04, 0.6), 0xC99A62), M(geo.box(0.62, 0.05, 0.02), 0x9A6E3E, 0, 0.02, 0.3), M(geo.box(0.62, 0.05, 0.02), 0x9A6E3E, 0, 0.02, -0.3));\n    lane.doll.root.add(tray);\n    lane.doll.face(Math.PI);\n    lane.doll.rig.loop('carryTray');\n    this.addTumblers(lane);\n  }\n  addTumblers(lane) {\n    const spots = [[0, 0], [0.16, 0.14], [-0.16, 0.14], [0.16, -0.14], [-0.16, -0.14]];\n    const n = 5;\n    const b = lane.bal;\n    for (let i = 0; i < n; i++) {\n      const [x, z] = spots[i];\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(b.fx + x, b.fy + 0.75 + 0.5 + 0.02 + 0.06 + 0.002, b.fz - 0.3 + z).setCanSleep(false).setAngularDamping(0.5).setLinearDamping(0.1));\n      this.world.createCollider(RAPIER.ColliderDesc.cylinder(0.06, 0.05).setMass(0.012).setFriction(0.9).setRestitution(0).setCollisionGroups(groups.prop(lane.id)), body);\n      const mesh = G();\n      const glassCol = [0xBFE9F0, 0xFAD7A0, 0xF4B6C8, 0xC9F2C7, 0xFFF3DC][i];\n      add(mesh, M(geo.cyl(0.055, 0.045, 0.13, 12), glassCol), M(geo.cyl(0.03, 0.03, 0.02, 8), 0xE8443A, 0.02, 0.075, 0));\n      this.group.add(mesh);\n      lane.tumblers.push({ body, mesh, on: true });\n    }\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length;\n    const length = this.cfg.length + 16;\n    this.lanes.forEach((lane) => {\n      const walk = planks(1.62, length, { along: 'z', top: 0, board: 0.5, thick: 0.1 });\n      walk.position.set(lane.x, 0, -length / 2 + 6);\n      g.add(walk);\n      for (let z = 4; z > -this.cfg.length - 8; z -= 5) {\n        add(g, post(3.4, 0.07, WOOD_D, lane.x - 0.82, -3.3, z), post(3.4, 0.07, WOOD_D, lane.x + 0.82, -3.3, z));\n        if (z % 10 === 4 % 10) { const b = buoy(z % 20 === 4 % 20 ? RED : TEAL); b.position.set(lane.x + 1.3, -0.2, z); b.scale.setScalar(0.8); g.add(b); }\n      }\n      // Far table\n      const tz = -this.cfg.length;\n      add(g, M(geo.cyl(0.55, 0.55, 0.05, 16), CREAM, lane.x, 0.84, tz - 1.2), post(0.84, 0.05, WOOD_D, lane.x, 0, tz - 1.2));\n    });\n    // The cabana at the far end.\n    const tz = -this.cfg.length - 3.8;\n    const span = Math.max(6, n * 3.2 + 3);\n    add(g, M(geo.box(span + 3, 0.2, 6), 0xC99A62, 0, -0.1, tz));\n    for (const x of [-span / 2, span / 2]) for (const z of [-2.5, 2.5]) add(g, post(3, 0.09, CREAM, x, 0, tz + z));\n    const roof = pavilionRoof(span * 0.75, TEAL, ORANGE); roof.position.set(0, 3, tz); g.add(roof);\n    const p = palm(3.4); p.position.set(span / 2 + 1, 0, tz + 1); g.add(p);\n    g.add(bunting(-span / 2, 2.8, tz + 2.5, span / 2, 2.8, tz + 2.5, 14));\n    this.game.setBackdrop(70, 90);\n  }\n  cameraShot(snap) {\n    const lead = this.lanes.reduce((m, l) => Math.max(m, l.dist || 0), 0);\n    const n = this.lanes.length;\n    const d = this.game.rig.fitDistance(5.4, (n - 1) * 3.2);\n    this.game.rig.shot(0, 3.6, -lead + d, 0, 1.25, -lead - 1.4, { snap, rate: 5 });\n    this.game.focus(0, 0, -lead, 18);\n  }\n  hudSetup(hud) { this.glassTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, '')); hud.setScore(5, 'Glasses'); }\n  start() { if (this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'tray_start'), { auto: 3.2, top: true }); }\n  /** The wind blows a telegraph for a full second first. */\n  scheduleGust() {\n    const c = this.cfg;\n    const a = this.r() < 0.5 ? 0 : Math.PI;\n    const force = c.gust * tun.gustForce;\n    this.gust = { warn: 1, dur: 0.5, x: Math.cos(a) * force, z: 0, a };\n    this.game.audio.sfx('gust');\n    this.game.hud.setNote('Wind!', 1);\n    for (const lane of this.lanes) if (lane.kind === 'local') this.game.input.rumble(0.05, 0.2, 200);\n    if (this.mode === 'solo') this.bark('trudy', 'tray_gust', 1.8, 10);\n    this.streaks = 1;\n  }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.gustNext -= dt;\n    if (this.gustNext <= 0 && !this.gust) { this.scheduleGust(); this.gustNext = c.every * (0.85 + this.r() * 0.3); }\n    if (this.gust) {\n      const g = this.gust;\n      if (g.warn > 0) g.warn -= dt;\n      else {\n        g.dur -= dt;\n        for (const lane of this.lanes) if (lane.bal && !lane.done) { lane.bal.extX += g.x * this.diff.dist; lane.bal.extZ += g.z * this.diff.dist; }\n        if (g.dur <= 0) this.gust = null;\n      }\n    }\n    if (c.gary) this.garyStep(dt);\n    if (c.wobbly) this.wobblePhase += dt;\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      this.laneStep(lane, dt);\n    }\n    if (this.clock !== null) this.clock -= dt;\n  }\n  laneStep(lane, dt) {\n    const b = lane.bal, i = lane.input, c = this.cfg;\n    if (lane.done) { b.moveFoot(b.fx, b.fy, b.fz); return; }\n    let foot = null;\n    if (i.footLPressed) foot = 'L'; else if (i.footRPressed) foot = 'R';\n    if (foot && !lane.fallen) {\n      if (foot === lane.lastFoot) {\n        // Same foot twice is a stumble.\n        lane.stumbles++; lane.rock = 0.18; lane.rockAmt = 0.6 * (this.r() < 0.5 ? -1 : 1);\n        this.game.audio.sfx('clack');\n      } else {\n        lane.lastFoot = foot; lane.lastStep = this.t;\n        lane.targetSpeed = STEP_LEN / CADENCE;\n        lane.rock = 0.18; lane.rockAmt = foot === 'L' ? -0.2 : 0.2;\n        lane.side += b.leanX * 0.25 * STEP_LEN;\n        lane.doll.rig.once(foot === 'L' ? 'stepL' : 'stepR', { speed: 0.8 });\n        lane.doll.rig.loop('carryTray');\n        this.game.audio.sfx('thud', { pitch: 200 + (foot === 'L' ? 0 : 30) });\n      }\n    }\n    if (this.t - lane.lastStep > 1.6 * CADENCE) lane.targetSpeed = 0;\n    lane.speed += (lane.targetSpeed - lane.speed) * (1 - Math.exp(-dt / 0.5));\n    if (lane.rock > 0) { lane.rock -= dt; b.extX += lane.rockAmt; }\n    if (c.wobbly && Math.sin(lane.dist * 0.9) > 0.86) b.extX += Math.sin(this.wobblePhase * 9) * 0.22;\n    lane.dist += lane.speed * dt;\n    b.moveFoot(lane.x + lane.side, 0, -lane.dist);\n    if (Math.abs(lane.side) > 0.8 && !lane.fallen) this.offEdge(lane);\n    if (lane.dist >= this.endDist) {\n      lane.done = true; lane.doneT = this.t; lane.targetSpeed = 0; lane.speed = 0;\n      this.game.audio.sfx('bell');\n      if (lane.kind === 'local' && this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'tray_done'), { auto: 3, top: true });\n      if (this.lanes.length > 1 && this.clock === null) { this.clock = 15; this.game.hud.setNote('15 seconds!', 2); }\n    }\n    if (lane.kind === 'local' && !lane.fallen && b.lean > 0.34) this.bark('trudy', 'near', 2, 8);\n    if (this.dist !== undefined) return;\n    for (const lt of [0]) { void lt; }\n  }\n  /** Off the edge: splash, respawn at the last buoy with one fewer glass. */\n  offEdge(lane) {\n    const b = lane.bal;\n    lane.splashes++;\n    const p = b.body.translation();\n    this.game.fx.splash(p.x, -0.4, p.z, 1.3);\n    this.game.audio.sfx('splash', { big: 1.2 });\n    this.game.comic.pop('SPLOSH!', p.x, 1.2, p.z);\n    if (lane.kind === 'local') this.bark('trudy', 'tray_splash', 2.6, 2);\n    lane.dist = Math.max(0, Math.floor(lane.dist / 10) * 10);\n    lane.side = 0; lane.speed = 0; lane.targetSpeed = 0;\n    const on = lane.tumblers.filter((t) => t.on);\n    if (on.length) { const t = on[on.length - 1]; t.on = false; this.removeTumbler(lane, t); }\n    // Lift everyone back: the same offset for doll and glasses.\n    const fx = lane.x, fz = -lane.dist;\n    const dx = fx - b.fx, dz = fz - b.fz;\n    b.foot.setTranslation({ x: fx, y: 0, z: fz }, true);\n    b.moveFoot(fx, 0, fz);\n    b.recover();\n    let k = 0;\n    const spots = [[0, 0], [0.16, 0.14], [-0.16, 0.14], [0.16, -0.14], [-0.16, -0.14]];\n    for (const t of lane.tumblers) {\n      if (!t.on || !t.body) continue;\n      const [sx, sz] = spots[k++];\n      t.body.setTranslation({ x: fx + sx, y: 0.75 + 0.5 + 0.02 + 0.06 + 0.002, z: fz - 0.3 + sz }, true);\n      t.body.setRotation({ x: 0, y: 0, z: 0, w: 1 }, true);\n      t.body.setLinvel({ x: 0, y: 0, z: 0 }, true); t.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n    }\n    return { dx, dz };\n  }\n  removeTumbler(lane, t) {\n    if (t.body) { this.world.removeRigidBody(t.body); t.body = null; }\n    this.group.remove(t.mesh);\n  }\n  garyStep(dt) {\n    this.garyT -= dt;\n    if (!this.gary && this.garyT <= 0) {\n      const lane = this.lanes.find((l) => l.kind !== 'ghost' && !l.done);\n      if (lane) {\n        const gull = new Gull();\n        gull.rig.loop('fly');\n        this.group.add(gull.root);\n        this.gary = { gull, t: 0, lane, took: false };\n        this.game.audio.sfx('squawk');\n      }\n      this.garyT = 13;\n    }\n    if (this.gary) {\n      const g = this.gary;\n      g.t += dt;\n      const k = g.t / 2.4;\n      const b = g.lane.bal;\n      const fx = b.fx, fz = b.fz;\n      const x = fx - 8 + 16 * k, y = 1.45 + Math.abs(k - 0.5) * 6, z = fz - 0.3;\n      g.gull.root.position.set(x, y, z);\n      g.gull.root.rotation.y = Math.PI / 2;\n      if (!g.took && k > 0.48) {\n        g.took = true;\n        const on = g.lane.tumblers.filter((t) => t.on);\n        // Gary swoops for a glass unless you lean out of his way.\n        if (on.length && Math.abs(g.lane.dotX) < 0.45) { const t = on[0]; t.on = false; g.carried = t; }\n      }\n      if (g.carried) { g.carried.mesh.position.set(x, y - 0.25, z); }\n      if (k >= 1) {\n        if (g.carried) this.removeTumbler(g.lane, g.carried);\n        this.group.remove(g.gull.root); this.gary = null;\n      }\n    }\n  }\n  afterStep() {\n    for (const lane of this.lanes) {\n      if (!lane.tumblers) continue;\n      const b = lane.bal.body.translation(), q = lane.bal.body.rotation();\n      _q.set(q.x, q.y, q.z, q.w).invert();\n      for (const t of lane.tumblers) {\n        if (!t.on || !t.body) continue;\n        const p = t.body.translation();\n        _v.set(p.x - b.x, p.y - b.y, p.z - b.z).applyQuaternion(_q);\n        const fell = _v.y < 0.42 || Math.hypot(_v.x, _v.z + 0.3) > 0.42 || lane.fallen;\n        if (fell) {\n          t.on = false;\n          this.game.audio.sfx('plateCrash');\n          if (lane.kind === 'local') { this.bark('trudy', 'tray_spill', 2, 4); this.game.input.rumble(0.3, 0.5, 120); }\n        }\n      }\n      for (const t of lane.tumblers) {\n        if (t.body && !t.on && t.body.translation().y < -4) this.removeTumbler(lane, t);\n      }\n    }\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const d = bot.data;\n    d.next = (d.next ?? 0.2) - 1 / 120;\n    out.footLPressed = false; out.footRPressed = false; out.footL = 0; out.footR = 0;\n    if (d.next <= 0 && !lane.done && !lane.fallen) {\n      d.next = CADENCE * (1 + (bot.r() - 0.5) * bot.s.timing * 3);\n      d.foot = d.foot === 'L' ? 'R' : 'L';\n      if (d.foot === 'L') { out.footLPressed = true; out.footL = 1; } else { out.footRPressed = true; out.footR = 1; }\n    }\n    // Keep centred; brace at .2 × gust on the telegraph.\n    let gx = -lane.side * 0.5, gz = 0;\n    const brace = lane.braceK ?? 0.2;\n    if (this.gust && this.gust.warn < 1 - bot.s.lag * 0.5) gx += -Math.sign(this.gust.x) * brace * Math.abs(this.gust.x);\n    const [x, z] = bot.steer(gx, gz, true);\n    out.wishX = x; out.wishZ = z;\n    out.flail = !lane.fallen && lane.bal.lean > 0.6 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    const on = me.tumblers ? me.tumblers.filter((t) => t.on).length : 0;\n    hud.setScore(on, 'Glasses');\n    hud.setTime(this.clock !== null ? this.clock : null);\n    const s = `${Math.max(0, Math.round(this.endDist - (me.dist || 0)))} m to go`;\n    if (this.glassTag && this.glassTag.textContent !== s) this.glassTag.textContent = s;\n    for (const lane of this.lanes) {\n      const g = this.gust;\n      lane.discView.brace = g && g.warn > 0 ? { x: -Math.sign(g.x), z: 0 } : null;\n      lane.discView.zone = null;\n    }\n  }\n  frameEvent(dt) {\n    this.cameraShot(false);\n    for (const lane of this.lanes) {\n      if (!lane.tumblers) continue;\n      for (const t of lane.tumblers) {\n        if (!t.body) continue;\n        const p = t.body.translation(), q = t.body.rotation();\n        t.mesh.position.set(p.x, p.y, p.z); t.mesh.quaternion.set(q.x, q.y, q.z, q.w);\n      }\n      if (lane.speed > 0.3 && lane.doll.rig.onceLeft <= 0) lane.doll.rig.loop('carryTray');\n    }\n    if (this.gary) this.gary.gull.update(dt);\n    if (this.gust && this.gust.warn > 0) {\n      const lead = this.lanes.reduce((m, l) => Math.max(m, l.dist || 0), 0);\n      const dir = Math.sign(this.gust.x);\n      this.game.fx.spawn(cos(-5, 5) - dir * 7, cos(0.5, 3), -lead + cos(-4, 1), dir * 14, 0, 0, 0.05, 0x1A1420, 0.5, 0);\n    }\n  }\n  isDone() {\n    const active = this.lanes.filter((l) => l.kind !== 'ghost');\n    if (active.every((l) => l.done)) return true;\n    return this.clock !== null && this.clock <= 0;\n  }\n  laneResult(lane) {\n    const on = lane.tumblers ? lane.tumblers.filter((t) => t.on).length : 0;\n    const delivered = lane.done ? on : Math.floor(on / 2);\n    const par = (this.cfg.length / STEP_LEN) * CADENCE;\n    const bonus = lane.done ? Math.max(0, 40 * (1 - (lane.doneT - par) / (par * 0.5))) : 0;\n    const raw = 100 * delivered + bonus;\n    return { form: (100 * raw) / 520, raw, big: `${delivered}/5`, stats: `${lane.done ? 'Delivered' : 'Not delivered'} · ${lane.stumbles} stumbles · ${lane.splashes} splashes · ${lane.falls} floor exercises` };\n  }\n}\nEOF\ncat > src/events/springboard.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { CREAM, RED, TEAL, BLUE, buoy, palm } from '../art/props.js';\nimport { Gull } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst W = (2 * Math.PI) / 0.9, ZETA = 0.035, H = 0.75;\nconst BLOCKS = [RED, 0xF5B700, TEAL, CREAM, BLUE, RED, 0xF5B700, TEAL, CREAM];\nconst DEG = Math.PI / 180;\nconst norm = (a) => { a %= Math.PI * 2; if (a < 0) a += Math.PI * 2; return a; };\n\n/** Pump, launch, spin. A clean entry earns Grace; a perfect belly flop earns Splash. */\nexport class Springboard extends EventBase {\n  static id = 'springboard';\n  constructor(spec) {\n    super(spec);\n    this.seaLevel = 0; this.god = true; this.customPose = true;\n    this.towerH = this.cfg.tower;\n    this.maxDives = this.cfg.dives || 3;\n    this.gary = null; this.garyT = 2;\n    this.done = false;\n    this.endWord = 'Splash!';\n  }\n  laneX(i) { return (i - (this.laneSpecs.length - 1) / 2) * 5; }\n  addGround() { /* Water, not floor: nothing to stand on below the board. */ }\n  setupLane(lane) {\n    const b = lane.bal;\n    b.moveFoot(lane.x + 1.6, this.towerH, 0);\n    b.foot.setTranslation({ x: lane.x + 1.6, y: this.towerH, z: 0 }, true);\n    b.body.setTranslation({ x: lane.x + 1.6, y: this.towerH + H, z: 0 }, true);\n    lane.dives = []; lane.dive = 0; lane.boardY = 0; lane.boardV = 0.4; lane.phase2 = 'pump'; lane.pumpT = 0; lane.air = 0; lane.angle = 0; lane.spin = 0; lane.last = null; lane.startY = 0; lane.topY = 0; lane.rec = []; lane.replayT = 0; lane.bestSplash = 0;\n    lane.doll.face(Math.PI / 2);\n    lane.doll.rig.loop('diveReady');\n    lane.doll.flatFeet = false;\n  }\n  buildSet() {\n    const g = this.group;\n    const blocks = Math.ceil(this.towerH);\n    for (const lane of this.lanes) {\n      const t = G('', lane.x - 0.4, 0, 0);\n      for (let i = 0; i < blocks; i++) add(t, M(geo.box(1.8, 1, 1.8), BLOCKS[i % BLOCKS.length], 0, i + 0.5 + (this.towerH - blocks), 0));\n      for (let i = 0; i < blocks; i += 2) add(t, M(geo.box(0.05, 0.3, 0.3), CREAM, 0.91, i + 0.5 + (this.towerH - blocks), 0));\n      g.add(t);\n      lane.towerTop = this.towerH;\n      const board = lane.board = G('', lane.x + 0.5, this.towerH + 0.04, 0);\n      add(board, M(geo.box(1.8, 0.07, 0.6), CREAM, 0.9, 0, 0));\n      g.add(board);\n      add(g, M(geo.cyl(0.05, 0.05, 0.5, 8), 0x8A5A32, lane.x + 0.6, this.towerH - 0.22, 0));\n    }\n    const b = buoy(RED); b.position.set(9, 0, -7); g.add(b);\n    const b2 = buoy(TEAL); b2.position.set(-7, 0, -8); g.add(b2);\n    const p = palm(3.2); p.position.set(this.lanes[0].x - 1, this.towerH, -0.6); p.scale.setScalar(0.5); g.add(p);\n    this.gull = new Gull();\n    this.gull.rig.loop('fly');\n    this.gull.root.position.set(-9, this.towerH + 2, -2);\n    this.gull.root.rotation.y = Math.PI / 2;\n    g.add(this.gull.root);\n    this.game.setBackdrop(-70, -120);\n    this.game.sea.setLevel(0);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length;\n    const d = this.game.rig.fitDistance(Math.max(13, this.towerH * 2.2), (n - 1) * 5 + 4);\n    this.game.rig.shot(this.lanes.length > 1 ? 1 : 2.4, this.towerH * 0.55 + 1.2, d, this.lanes.length > 1 ? 1 : 2.4, this.towerH * 0.55, 0, { snap, rate: 3 });\n  }\n  hudSetup(hud) {\n    this.power = hud.addWidget(hud.meter('Bounce', '#F5B700'));\n    this.diveTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, 'Dive 1 of 3'));\n    hud.setScore(0, 'Best');\n    hud.setDiscs([]);\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'dive_start'), { auto: 3.4, top: true }); }\n  fixedEvent(dt) {\n    this.flyGull(dt);\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      if (lane.phase2 === 'pump') this.pump(lane, dt);\n      else if (lane.phase2 === 'air') this.air(lane, dt);\n      else if (lane.phase2 === 'water') this.water(lane, dt);\n      else if (lane.phase2 === 'finished') { /* watching */ }\n    }\n    if (this.lanes.every((l) => l.kind === 'ghost' || l.phase2 === 'finished')) this.done = true;\n  }\n  pump(lane, dt) {\n    const i = lane.input, b = lane.bal;\n    const pumping = (i.footL > 0.5 && i.footR > 0.5);\n    const a = -W * W * lane.boardY - 2 * ZETA * W * lane.boardV - (pumping ? 8 * tun.boardGain : 0);\n    lane.boardV += a * dt; lane.boardY += lane.boardV * dt;\n    lane.boardY = Math.max(-0.7, Math.min(0.7, lane.boardY));\n    lane.pumpT += dt;\n    b.moveFoot(lane.x + 1.6, this.towerH + lane.boardY, 0);\n    if (lane.board) lane.board.position.y = this.towerH + 0.04 + lane.boardY * 0.6;\n    if (lane.board) lane.board.rotation.z = lane.boardY * 0.25;\n    if (Math.floor(lane.pumpT / 0.45) !== Math.floor((lane.pumpT - dt) / 0.45)) this.game.audio.sfx('metronome', { vel: 0.4 });\n    const timeLimit = this.mode === 'session' ? 7 : 16;\n    if (i.hopPressed || lane.pumpT > timeLimit) this.launch(lane);\n  }\n  launch(lane) {\n    const b = lane.bal;\n    const v = Math.max(3, lane.boardV);\n    lane.launchV = v;\n    b.release();\n    b.body.setLinvel({ x: 2.2, y: v, z: 0 }, true);\n    b.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n    lane.phase2 = 'air'; lane.air = 0; lane.angle = 0; lane.spin = 0; lane.startY = this.towerH; lane.topY = this.towerH; lane.rec = [];\n    lane.doll.rig.loop('spread');\n    this.game.audio.sfx('boing');\n    if (lane.board) { lane.board.position.y = this.towerH + 0.04; lane.board.rotation.z = 0; }\n    b.diveFree = true;\n  }\n  air(lane, dt) {\n    const i = lane.input, b = lane.bal;\n    lane.air += dt;\n    const tuck = i.hop;\n    // The stick sets a target spin; tuck multiplies it.\n    const target = i.wishX * 3.4 * tun.airTorque * (tuck ? 1.8 : 1);\n    lane.spin += (target - lane.spin) * (1 - Math.exp(-9 * dt));\n    lane.angle += lane.spin * dt;\n    b.body.setAngvel({ x: 0, y: 0, z: -lane.spin }, true);\n    if (tuck) lane.doll.rig.loop('tuck', { fade: 0.08 }); else lane.doll.rig.loop(Math.abs(lane.spin) > 0.3 ? 'pike' : 'spread', { fade: 0.15 });\n    const p = b.body.translation();\n    lane.topY = Math.max(lane.topY, p.y - H);\n    lane.rec.push({ x: p.x, y: p.y, a: lane.angle });\n    if (lane.rec.length > 240) lane.rec.shift();\n    if (p.y < 0.5) this.enter(lane);\n  }\n  /** Where the body lands: head or feet down within 12°, or front flat within 20°. */\n  enter(lane) {\n    const a = norm(lane.angle);\n    const err = (t) => { const d = Math.abs(a - t); return Math.min(d, Math.PI * 2 - d) / DEG; };\n    const feet = err(0), head = err(Math.PI), flop = err(Math.PI / 2);\n    const clean = Math.min(feet, head);\n    const height = lane.topY;\n    const mult = 1 + (height - 5) / 10;\n    const grace = clean <= 12 ? 100 * (1 - clean / 12) * mult : 0;\n    const splash = flop <= 20 ? 100 * (1 - flop / 20) * mult : 0;\n    const score = Math.max(grace, splash);\n    const kind = grace >= splash && grace > 0 ? 'Grace' : splash > 0 ? 'Splash' : 'Technically a Dive';\n    lane.dives.push({ score: Math.max(score, 8), kind, height });\n    lane.last = kind;\n    lane.dive++;\n    lane.phase2 = 'water'; lane.waterT = 0;\n    const b = lane.bal, p = b.body.translation();\n    b.disable();\n    lane.doll.ragdolled = true;\n    lane.doll.rig.update(0);\n    lane.ragdoll = new Ragdoll(this.world, lane.doll, this.group, { x: 2, y: -6, z: 0 });\n    lane.fallen = true;\n    const fx = this.game.fx;\n    if (kind === 'Splash') {\n      fx.splash(p.x, 0, p.z, 3.2);\n      for (let i = 0; i < 40; i++) fx.spawn(p.x + cos(-0.3, 0.3), 0, p.z + cos(-0.3, 0.3), cos(-0.8, 0.8), cos(5, 12), cos(-0.8, 0.8), cos(0.09, 0.22), 0xEFFBFB, 1.3);\n      this.game.audio.sfx('splash', { big: 2.2 });\n      this.game.comic.pop('SPLOSH!', p.x, 3, p.z, { size: 3.4 });\n      this.game.rig.shake(0.16);\n      if (this.gull && !this.gullHit) { this.gullHit = 1.5; this.game.audio.sfx('squawk'); }\n    } else if (kind === 'Grace') {\n      fx.splash(p.x, 0, p.z, 0.25);\n      this.game.audio.sfx('splash', { big: 0.3 });\n      this.game.comic.pop('...', p.x, 1.6, p.z, { size: 1.6 });\n    } else {\n      fx.splash(p.x, 0, p.z, 1);\n      this.game.audio.sfx('splash', { big: 1 });\n    }\n    if (lane.kind === 'local') {\n      this.game.input.rumble(kind === 'Splash' ? 1 : 0.4, 0.6, 300);\n      this.game.hud.flash(kind, 1.2);\n      this.game.speech.say('trudy', line('trudy', kind === 'Grace' ? 'dive_grace' : kind === 'Splash' ? 'dive_splash' : 'dive_other'), { auto: 2.6, top: true });\n    }\n  }\n  water(lane, dt) {\n    lane.waterT += dt;\n    // A simple upward force below the surface.\n    if (lane.ragdoll) {\n      for (const k of Object.keys(lane.ragdoll.bodies)) {\n        const body = lane.ragdoll.bodies[k], t = body.translation();\n        body.resetForces(true);\n        if (t.y < 0) { body.addForce({ x: 0, y: -t.y * 9 * body.mass() + 1.5 * body.mass() * tun.gravity * 0.9, z: 0 }, true); }\n      }\n      lane.ragdoll.sync();\n    }\n    const wait = this.mode === 'session' ? 1.6 : 2.6;\n    if (lane.waterT > wait) this.resetLane(lane);\n  }\n  resetLane(lane) {\n    const b = lane.bal;\n    lane.ragdoll.end(); lane.ragdoll = null;\n    lane.doll.ragdolled = false; lane.fallen = false;\n    b.reattach();\n    b.fx = lane.x + 1.6; b.fy = this.towerH; b.fz = 0;\n    b.foot.setTranslation({ x: b.fx, y: b.fy, z: 0 }, true);\n    b.recover();\n    lane.boardY = 0; lane.boardV = 0.4; lane.pumpT = 0; lane.angle = 0;\n    lane.doll.rig.loop('diveReady');\n    if (lane.dive >= this.maxDives) lane.phase2 = 'finished'; else { lane.phase2 = 'pump'; this.game.audio.sfx('spring'); }\n    if (lane.bot) lane.bot.data = {};\n    if (lane.testBot) lane.testBot.data = {};\n  }\n  flyGull(dt) {\n    const g = this.gull;\n    if (this.gullHit > 0) {\n      this.gullHit -= dt;\n      g.root.position.y += (this.gullHit > 1.2 ? 8 : -6) * dt;\n      g.root.rotation.z += dt * 10;\n      if (this.gullHit <= 0) { g.root.position.set(-12, this.towerH + 3, -2); g.root.rotation.z = 0; }\n      return;\n    }\n    g.root.position.x += dt * 2.2;\n    if (g.root.position.x > 14) g.root.position.x = -14;\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    out.hopPressed = false; out.hop = false; out.footL = 0; out.footR = 0; out.wishX = 0; out.wishZ = 0;\n    const d = bot.data;\n    if (lane.phase2 === 'pump') {\n      // Pump in phase: squeeze as the board goes down, with a reaction lag.\n      d.wait = (d.wait ?? (4.5 + bot.r() * 2.5));\n      const going = lane.boardV < -bot.s.lag * 0.5;\n      const v = going ? 1 : 0;\n      out.footL = v; out.footR = v;\n      if (lane.pumpT > d.wait && lane.boardV > 0.5 && lane.boardV > (d.prevV ?? 0)) d.armed = true;\n      if (d.armed && lane.boardV < (d.prevV ?? 0)) { out.hopPressed = true; out.hop = true; d.armed = false; }\n      d.prevV = lane.boardV;\n    } else if (lane.phase2 === 'air') {\n      // Aim for a belly flop by default (a quarter turn) or a head first dive.\n      const goal = (d.goal ?? (d.goal = bot.r() < (lane.wantDive ? 1 : 0.15) ? Math.PI : Math.PI / 2));\n      const vel = 0.5;\n      const coast = 0.22;\n      const rel = goal - lane.angle - coast * vel + bot.timing() * 0.8;\n      out.wishX = rel > 0.04 ? vel : 0;\n    }\n    if (out.wishX) out.wishX = Math.max(-1, Math.min(1, out.wishX));\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    const best = me.dives && me.dives.length ? Math.max(...me.dives.map((x) => x.score)) : 0;\n    hud.setScore(Math.round(best), 'Best');\n    hud.setTime(null);\n    if (this.power) this.power.set(Math.max(0, Math.abs(me.boardV || 0)) / 8);\n    const s = `Dive ${Math.min(this.maxDives, (me.dive || 0) + 1)} of ${this.maxDives}`;\n    if (this.diveTag && this.diveTag.textContent !== s) this.diveTag.textContent = s;\n  }\n  frameEvent(dt) {\n    if (this.gull) this.gull.update(dt);\n    for (const lane of this.lanes) {\n      if (!lane.bal || lane.fallen) continue;\n      const b = lane.bal, p = b.body.translation(), q = b.body.rotation();\n      if (lane.phase2 === 'air') {\n        lane.doll.root.position.set(p.x, p.y - H, p.z);\n        lane.doll.root.quaternion.set(q.x, q.y, q.z, q.w);\n      } else {\n        lane.doll.root.position.set(b.fx, b.fy, b.fz);\n        lane.doll.root.quaternion.set(0, 0, 0, 1);\n      }\n    }\n  }\n  isDone() { return this.done; }\n  laneResult(lane) {\n    const scores = (lane.dives || []).map((d) => d.score).sort((a, b) => b - a);\n    const best2 = scores.slice(0, 2);\n    const raw = best2.length ? best2.reduce((a, b) => a + b, 0) / 2 : 0;\n    const kinds = (lane.dives || []).map((d) => d.kind).join(', ');\n    return { form: (100 * raw) / (this.cfg.par * 0.72), raw, big: Math.round(raw), stats: kinds || 'No dives' };\n  }\n}\nexport { RAPIER, THREE };\nEOF\ncat > src/events/raft.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { WOOD, WOOD_D, CREAM, RED, TEAL } from '../art/props.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { blankInput } from '../input/input.js';\n\nconst K = 6, C = 3.5, WALK = 3, SHOVE_R = 1.3, MAX = 26 * Math.PI / 180;\nconst W_PER = (K * (14 * Math.PI / 180)) / 6;\n/** Everyone on one raft, on the same seesaw. Last doll standing wins the round. */\nexport class Raft extends EventBase {\n  static id = 'raft';\n  constructor(spec) {\n    super(spec);\n    this.discs = false; this.customPose = true; this.seaLevel = -0.6; this.god = true;\n    if (this.laneSpecs.length < 2) {\n      const skills = ['average', 'sharp', 'clumsy'];\n      const names = ['Retired Kevin', 'Sandra', 'Other Sandra'];\n      const cols = ['#6FB7D6', '#E78FB3', '#F5C84A'];\n      this.laneSpecs = [...this.laneSpecs, ...[0, 1, 2].map((i) => ({ kind: 'bot', skill: skills[i], name: names[i], colour: cols[i] }))];\n    }\n    this.round = 1; this.wins = {}; this.tx = 0; this.tz = 0; this.vx = 0; this.vz = 0; this.radius = this.cfg.radius; this.roundT = 0; this.stage = 'play'; this.waitT = 0; this.nextSwell = this.cfg.swell; this.done = false; this.shrinkT = this.cfg.shrink;\n    this.warn = 0;\n    this.sections = [];\n  }\n  addGround() {}\n  buildLane(lane, i) {\n    lane.doll = new (this.dollClass())( { shirt: lane.colour, hat: lane.hat });\n    lane.doll.flatFeet = false;\n    lane.bal = null;\n    this.spawnLane(lane, i);\n  }\n  dollClass() { return RaftDoll.cls; }\n  spawnLane(lane, i) {\n    const n = this.laneSpecs.length;\n    const a = (i / n) * Math.PI * 2 + Math.PI / 4;\n    lane.px = Math.cos(a) * 2.5; lane.pz = Math.sin(a) * 2.5; lane.vx = 0; lane.vz = 0; lane.out = false; lane.cool = 0; lane.y = 0; lane.hopT = 0; lane.vy = 0; lane.sx = 0; lane.sz = 0; lane.sink = 0;\n    lane.doll.root.visible = true;\n  }\n  buildSet() {\n    const g = this.group;\n    this.raftG = G('raft');\n    g.add(this.raftG);\n    const rings = [[0, 2], [2, 3], [3, 4], [4, 5], [5, 6]];\n    for (const [a, b] of rings) {\n      const seg = b === 2 ? 1 : 8;\n      for (let i = 0; i < seg; i++) {\n        const th0 = (i / seg) * Math.PI * 2, thL = (Math.PI * 2) / seg;\n        const shape = b === 2 ? new THREE.CylinderGeometry(2, 2, 0.26, 28) : ringSeg(a, b, th0, thL);\n        const m = new THREE.Mesh(shape, M(geo.box(1, 1, 1), (i + b) % 2 ? WOOD : 0xB98347).material);\n        m.castShadow = true; m.receiveShadow = true;\n        m.position.y = -0.13;\n        this.raftG.add(m);\n        this.sections.push({ m, r: b, drift: 0, a: th0 + thL / 2 });\n      }\n    }\n    add(this.raftG, M(geo.cyl(0.08, 0.08, 1.8, 10), CREAM, 0, 0.9, 0), M(geo.cone(0.5, 0.5, 3), RED, 0.25, 1.65, 0, { rot: [0, 0, -Math.PI / 2], scale: [1, 1, 0.1] }));\n    for (const lane of this.lanes) this.raftG.add(lane.doll.root);\n    this.lapBuoys = [];\n    this.game.setBackdrop(90, -110);\n    this.game.sea.setLevel(this.seaLevel);\n  }\n  cameraShot(snap) { this.game.rig.shot(0, 15, 15, 0, 0, 0, { snap, rate: 3, fov: 38 }); this.inputYaw = 0; }\n  hudSetup(hud) {\n    this.scoreTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, 'Round 1 of 3'));\n    hud.setScore('', '');\n    hud.setTime(null);\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'raft_start'), { auto: 3, top: true }); }\n  alive() { return this.lanes.filter((l) => !l.out); }\n  fixedEvent(dt) {\n    if (this.stage === 'between') {\n      this.waitT -= dt;\n      if (this.waitT <= 0) this.nextRound();\n      return;\n    }\n    this.roundT += dt;\n    this.shrinkT -= dt;\n    if (this.shrinkT <= 0 && this.radius > 2) {\n      this.shrinkT = this.cfg.shrink;\n      this.radius = Math.max(2, this.radius - 1);\n      this.game.audio.sfx('creak', { dur: 0.7 });\n      for (const s of this.sections) if (s.r > this.radius) s.drift = s.drift || 0.0001;\n    }\n    this.nextSwell -= dt;\n    if (this.warn > 0) {\n      this.warn -= dt;\n      if (this.warn <= 0) {\n        this.vx += Math.cos(this.swellA) * 2.5; this.vz += Math.sin(this.swellA) * 2.5;\n        this.game.audio.sfx('splash', { big: 0.6 });\n        this.game.rig.shake(0.05);\n      }\n    } else if (this.nextSwell <= 0) {\n      this.nextSwell = this.cfg.swell * (0.8 + this.r() * 0.4);\n      this.swellA = this.r() * Math.PI * 2;\n      this.warn = 1;\n      this.game.hud.setNote('A swell is coming', 1);\n      this.game.audio.sfx('gust', { dur: 0.8 });\n    }\n    // Everyone on the same seesaw.\n    let wx = 0, wz = 0;\n    for (const l of this.lanes) if (!l.out && l.y <= 0) { wx += l.px * W_PER; wz += l.pz * W_PER; }\n    this.vx += (wx - K * this.tx - C * this.vx) * dt; this.vz += (wz - K * this.tz - C * this.vz) * dt;\n    this.tx += this.vx * dt; this.tz += this.vz * dt;\n    const m = Math.hypot(this.tx, this.tz);\n    if (m > MAX) { this.tx *= MAX / m; this.tz *= MAX / m; }\n    for (const l of this.lanes) this.stepLane(l, dt);\n    const alive = this.alive();\n    if (alive.length <= 1 && this.stage === 'play') this.endRound(alive[0]);\n    if (this.roundT > 85 && this.stage === 'play') {\n      // Nobody stays dry for ever: the middle starts going too.\n      this.radius = Math.max(1, this.radius - dt * 0.2);\n    }\n  }\n  stepLane(l, dt) {\n    if (l.out) {\n      l.sink += dt;\n      return;\n    }\n    const i = l.input;\n    l.cool = Math.max(0, l.cool - dt);\n    let mx = i.moveX || 0, mz = i.moveZ || 0;\n    if (i.device === 'kbm' && !i.keysActive && l.kind === 'local' && !this.game.input.pointerActive) { mx = 0; mz = 0; }\n    const mm = Math.hypot(mx, mz);\n    if (mm > 1) { mx /= mm; mz /= mm; }\n    l.vx += (this.tx * 10) * dt * (l.y > 0 ? 0 : 1); l.vz += (this.tz * 10) * dt * (l.y > 0 ? 0 : 1);\n    l.vx *= Math.exp(-3 * dt); l.vz *= Math.exp(-3 * dt);\n    l.px += (mx * WALK + l.vx) * dt; l.pz += (mz * WALK + l.vz) * dt;\n    // Hop.\n    if (i.hopPressed && l.y <= 0) { l.vy = 3.4; this.game.audio.sfx('boing'); l.doll.rig.once('hop'); }\n    if (l.y > 0 || l.vy > 0) { l.vy -= 9.81 * dt; l.y = Math.max(0, l.y + l.vy * dt); if (l.y <= 0) { l.vy = 0; l.doll.rig.once('land'); this.game.audio.sfx('thud', { pitch: 240 }); } }\n    // Flail shoves in a short cone.\n    if (i.flail && l.cool <= 0) {\n      l.cool = 2;\n      l.doll.rig.once('flail');\n      this.game.audio.sfx('whoosh');\n      for (const o of this.lanes) {\n        if (o === l || o.out) continue;\n        const dx = o.px - l.px, dz = o.pz - l.pz, d = Math.hypot(dx, dz);\n        if (d < SHOVE_R && o.y <= 0) {\n          o.vx += (dx / Math.max(d, 0.1)) * 6; o.vz += (dz / Math.max(d, 0.1)) * 6;\n          this.game.audio.sfx('clack');\n          this.game.comic.pop('SHOVE!', o.px, 2, o.pz, { size: 1.6 });\n          this.game.input.rumble(0.4, 0.3, 120, o.input.padIndex >= 0 ? o.input.padIndex : undefined);\n        }\n      }\n    }\n    const d = Math.hypot(l.px, l.pz);\n    if (d > this.radius + 0.15 && l.y <= 0.3) {\n      l.out = true;\n      l.doll.rig.loop('spread');\n      this.game.fx.splash(l.px, this.seaLevel, l.pz, 1.4);\n      this.game.audio.sfx('splash', { big: 1.2 });\n      this.game.comic.pop('SPLOSH!', l.px, 1, l.pz);\n      if (l.kind === 'local') { this.game.onFloorExercise(); this.bark('trudy', 'raft_out', 2.2, 1); this.game.input.rumble(0.8, 0.5, 240); }\n    }\n    if (mm > 0.15) { l.doll.face(Math.atan2(mx, mz)); if (l.doll.rig.onceLeft <= 0) l.doll.rig.loop('walk', { speed: 1.3 }); } else if (l.doll.rig.onceLeft <= 0) l.doll.rig.loop('idle');\n  }\n  endRound(winner) {\n    this.stage = 'between'; this.waitT = 3.4;\n    if (winner) {\n      this.wins[winner.id] = (this.wins[winner.id] || 0) + 1;\n      winner.doll.rig.loop('cheer');\n      this.game.hud.flash(`${winner.name}!`, 2);\n      this.game.fx.confetti(winner.px, 5, winner.pz, 60, [0xE8443A, 0xF5B700, 0x2CB5A0, 0xFFF3DC], 3);\n      this.game.audio.sting('pleasant');\n      if (this.mode === 'solo') this.game.speech.say('trudy', line('trudy', 'raft_win'), { auto: 3, top: true });\n    }\n    this.lastWinner = winner;\n    const most = Math.max(0, ...Object.values(this.wins));\n    if (most >= 2 || this.round >= 3) { this.finishing = true; }\n  }\n  nextRound() {\n    if (this.finishing) { this.done = true; return; }\n    this.round++;\n    this.stage = 'play'; this.roundT = 0; this.radius = this.cfg.radius; this.shrinkT = this.cfg.shrink; this.tx = 0; this.tz = 0; this.vx = 0; this.vz = 0; this.nextSwell = this.cfg.swell; this.warn = 0;\n    for (const s of this.sections) { s.drift = 0; s.m.position.set(0, -0.13, 0); s.m.rotation.set(0, 0, 0); s.m.visible = true; }\n    this.lanes.forEach((l, i) => this.spawnLane(l, i));\n    if (this.scoreTag) this.scoreTag.textContent = `Round ${this.round} of 3`;\n    this.game.audio.sfx('bell');\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    Object.assign(out, blankInput());\n    if (lane.out) return;\n    // Stay toward the centre and the high side; go at whoever is close; shove when in reach.\n    let gx = -lane.px * 0.5 - this.tx * 6, gz = -lane.pz * 0.5 - this.tz * 6;\n    let near = null, nd = 1e9;\n    for (const o of this.lanes) { if (o === lane || o.out) continue; const d = Math.hypot(o.px - lane.px, o.pz - lane.pz); if (d < nd) { nd = d; near = o; } }\n    const edge = Math.hypot(lane.px, lane.pz) / this.radius;\n    if (near && nd < 3.5 && edge < 0.8) { gx += (near.px - lane.px) * 0.7; gz += (near.pz - lane.pz) * 0.7; }\n    const m = Math.hypot(gx, gz) || 1;\n    const k = Math.min(1, m);\n    let mx = (gx / m) * k, mz = (gz / m) * k;\n    const noise = bot.s.noise * 8;\n    mx += Math.sin(bot.t * 2.1 + bot.ph) * noise; mz += Math.sin(bot.t * 1.7 + bot.ph2) * noise;\n    out.moveX = mx; out.moveZ = mz; out.wishX = mx; out.wishZ = mz; out.useMove = true;\n    bot.data.react = (bot.data.react || 0) - 1 / 120;\n    if (near && nd < SHOVE_R * 0.95 && lane.cool <= 0 && bot.data.react <= 0) { out.flail = true; bot.data.react = bot.s.lag; }\n    out.device = 'pad';\n  }\n  hud() {\n    const hud = this.game.hud;\n    const me = this.lanes.find((l) => l.kind === 'local');\n    if (me) hud.setScore(this.wins[me.id] || 0, 'Rounds');\n  }\n  readInput(lane, dt) {\n    super.readInput(lane, dt);\n    if (lane.kind === 'local' && this.inputYaw === 0 && !lane.input.moveX && !lane.input.moveZ) { /* resting */ }\n  }\n  frameEvent(dt) {\n    const a = Math.hypot(this.tx, this.tz) || 1e-9, s = Math.sin(a / 2);\n    this.raftG.quaternion.set((this.tz / a) * s, 0, (-this.tx / a) * s, Math.cos(a / 2));\n    this.raftG.position.y = Math.sin(this.t * 0.9) * 0.05;\n    for (const sec of this.sections) {\n      if (sec.drift) {\n        sec.drift += dt;\n        const r = sec.drift * 0.9;\n        sec.m.position.set(Math.cos(sec.a) * r, -0.13 - sec.drift * 0.08, Math.sin(sec.a) * r);\n        sec.m.rotation.y = sec.drift * 0.1;\n        if (sec.drift > 6) sec.m.visible = false;\n      }\n    }\n    for (const l of this.lanes) {\n      const d = l.doll;\n      if (l.out) {\n        d.root.position.set(l.px, Math.max(-1.4, -0.6 - l.sink * 0.3), l.pz);\n      } else d.root.position.set(l.px, l.y, l.pz);\n      d.update(dt);\n    }\n  }\n  isDone() { return this.done; }\n  laneResult(lane) {\n    const w = this.wins[lane.id] || 0;\n    const form = 40 + 30 * w;\n    return { form, raw: w, big: `${w} won`, stats: `${w} rounds won of ${this.round}` };\n  }\n}\nfunction ringSeg(a, b, start, len) {\n  const shape = new THREE.Shape();\n  shape.absarc(0, 0, b, start, start + len - 0.02, false);\n  shape.absarc(0, 0, a, start + len - 0.02, start, true);\n  const g = new THREE.ExtrudeGeometry(shape, { depth: 0.26, bevelEnabled: false, curveSegments: 5 });\n  g.rotateX(-Math.PI / 2);\n  g.translate(0, -0.13, 0);\n  return g;\n}\nexport const RaftDoll = { cls: null };\nexport { WOOD_D, TEAL, rot2 };\nEOF\ncat > src/events/grandHold.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { Gull } from '../art/cast.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { MAP } from '../art/island.js';\n\nconst STAGES = ['pose', 'stones', 'storm', 'step', 'last'];\nconst _v = new THREE.Vector3();\n\n/** Your balance is tied to the island. Four 20-second remixes, and then the last hold. */\nexport class GrandHold extends EventBase {\n  static id = 'grandHold';\n  constructor(spec) {\n    super(spec);\n    this.iterations = 10;\n    this.breathOn = true; this.seaLevel = -6.4;\n    this.balanceParams = { margin: 0.8, ankleMax: 6 };\n    this.stageI = 0; this.stageT = 0; this.done = false; this.score = 0; this.inRing = 0; this.lastT = 0; this.lastIn = 0; this.restarts = 0;\n    this.ring = { x: 0, z: 0, r: 0.3 };\n    this.stones = []; this.plate = null; this.gust = null; this.gustNext = 3; this.cueT = 0; this.cue = null; this.cueScore = 0; this.cues = 0;\n    this.camA = 0; this.removeStage = 0; this.restStart = 0;\n  }\n  get stage() { return STAGES[this.stageI]; }\n  addGround() { /* The gallery floor is a rule. Only the bedsheet is ever used. */ }\n  build() {\n    this.game.setIsland('home');\n    super.build();\n    this.game.setIsland('home');\n    this.game.sea.setLevel(-6.4);\n    this.restStart = this.game.programme.restDeg();\n    this.game.phys.setRest(this.restStart);\n    this.game.phys.snapTilt();\n    // The class below, looking up.\n    const art = this.game.art;\n    for (const g of art.guests) { g.doll.rig.loop('lookUp'); g.wait = 999; }\n    art.heron.root.position.set(4, 0, -5);\n    art.walrus.root.position.set(0.5, 0, -4.8);\n    art.walrus.rig.loop('bounce');\n    art.trudy.root.position.set(1.5, 0, -6);\n    this.gary = new Gull();\n    this.gary.rig.loop('fly');\n    this.gary.root.visible = false;\n    this.group.add(this.gary.root);\n    this.syncGallery();\n  }\n  buildSet() {\n    const g = this.group;\n    add(g, M(geo.cyl(1.3, 1.3, 0.1, 24), 0xD8C7A0, 0, -0.05, 0));\n    // The bedsheet is held by the class. It appears when you need it.\n    this.sheet = M(geo.cyl(1.9, 1.9, 0.04, 24), 0xFFF8EA, 0, -7, 0);\n    this.sheet.visible = false;\n    g.add(this.sheet);\n  }\n  syncGallery() {\n    const g = this.game, art = g.art;\n    art.group.updateWorldMatrix(true, false);\n    _v.set(MAP.lighthouse.x, art.lighthouseTop + 0.2, MAP.lighthouse.z).applyMatrix4(art.group.matrixWorld);\n    this.group.position.copy(_v);\n    this.gallery = _v.clone();\n  }\n  setupLane(lane) {\n    lane.doll.rig.loop('pose3');\n  }\n  cameraShot(snap) {\n    const c = this.gallery || new THREE.Vector3(2, 9, -9);\n    const R = 8.5;\n    const a = 0.5 + this.camA;\n    const px = c.x + Math.sin(a) * R, pz = c.z + Math.cos(a) * R, py = c.y + 2.4;\n    this.game.rig.shot(px, py, pz, c.x, c.y + 0.9, c.z, { snap, rate: 3, fov: 42 });\n    this.inputYaw = a;\n  }\n  hudSetup(hud) {\n    this.phaseTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, ''));\n    hud.setScore('', '');\n  }\n  start() {\n    this.game.palette.set('golden', 2);\n    this.startStage(0);\n    this.game.speech.say('trudy', line('trudy', 'finale_start'), { auto: 3.4, top: true });\n  }\n  startStage(i) {\n    this.stageI = i; this.stageT = 0;\n    const lane = this.lanes[0];\n    const names = { pose: 'A pose, with breath', stones: 'Stones on your head', storm: 'Storm, with Gary', step: 'Step, in the wind', last: 'The last hold' };\n    if (this.phaseTag) this.phaseTag.textContent = names[this.stage];\n    this.game.audio.sfx('bell');\n    if (this.stage === 'pose') { this.ring = { x: 0.3, z: 0.1, r: 0.3 }; lane.doll.rig.loop('pose3', { fade: 0.5 }); this.game.speech.say('trudy', line('trudy', 'finale_pose'), { auto: 3, top: true }); }\n    if (this.stage === 'stones') { this.addPlate(lane); this.stoneNext = 2; this.stoneN = 0; this.ring = { x: 0, z: 0, r: 0.3 }; lane.doll.rig.loop('holdSlab', { fade: 0.5 }); this.game.speech.say('trudy', line('trudy', 'finale_stones'), { auto: 3, top: true }); }\n    if (this.stage === 'storm') {\n      this.gustNext = 3; this.ring = { x: 0, z: 0, r: 0.4 }; lane.doll.rig.loop('spread', { fade: 0.5 });\n      this.gary.root.visible = true; this.gary.rig.loop('stand');\n      lane.doll.joints.head.add(this.gary.root);\n      this.gary.root.position.set(0, 0.2, 0); this.gary.root.rotation.set(0, 0, 0);\n      this.game.speech.say('trudy', line('trudy', 'finale_gust'), { auto: 3.4, top: true });\n    }\n    if (this.stage === 'step') { this.cueT = 1; this.cueIdx = 0; this.ring = null; lane.doll.rig.loop('breathe', { fade: 0.5 }); this.game.speech.say('trudy', line('trudy', 'finale_step'), { auto: 3, top: true }); for (const g of this.game.art.guests) g.doll.rig.loop('cheer'); }\n    if (this.stage === 'last') {\n      this.ring = { x: 0, z: 0, r: 0.3 };\n      lane.doll.rig.loop('pose1', { fade: 1 });\n      if (this.gary.root.parent !== this.group) { this.gary.root.removeFromParent(); this.group.add(this.gary.root); this.gary.root.visible = false; }\n      this.game.speech.say('trudy', line('trudy', 'finale_last'), { auto: 4, top: true });\n      this.game.audio.stopMusic(3);\n    }\n  }\n  addPlate(lane) {\n    const b = lane.bal.body;\n    this.plateCol = this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.4, 0.03, 0.4).setTranslation(0, 0.8, 0).setMass(0.04).setFriction(1).setCollisionGroups(groups.doll(lane.id)), b);\n    this.plateMesh = M(geo.box(0.8, 0.06, 0.8), 0xD6CDB6, 0, 1.55, 0);\n    lane.doll.root.add(this.plateMesh);\n  }\n  addStone(lane) {\n    const b = lane.bal.body, t = b.translation(), q = b.rotation();\n    const i = this.stones.length;\n    const hh = 0.08, r = 0.22 - i * 0.02;\n    const base = 0.83 + i * 0.17 + hh + 0.012;\n    _v.set(0, base, 0).applyQuaternion(new THREE.Quaternion(q.x, q.y, q.z, q.w));\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(t.x + _v.x, t.y + _v.y, t.z + _v.z).setRotation(q).setCanSleep(false).setLinearDamping(0.1).setAngularDamping(0.6));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(r * 0.8, hh, r * 0.8).setMass(0.02).setFriction(0.95).setRestitution(0).setCollisionGroups(groups.prop(lane.id)), body);\n    const mesh = M(geo.sphere(1, 12, 8), [0xCFC8B6, 0xBDB5A2, 0xD8D2C2, 0xA9A18F][i], 0, 0, 0, { scale: [r, hh, r] });\n    this.group.add(mesh);\n    this.stones.push({ body, mesh });\n    this.game.audio.sfx('thud', { pitch: 150 });\n  }\n  /** Safe: remove the stones, step once, then remove the plate. */\n  clearStones() {\n    for (const s of this.stones) { this.world.removeRigidBody(s.body); this.group.remove(s.mesh); }\n    this.stones = [];\n    this.removeStage = 1;\n  }\n  afterStep() {\n    if (this.removeStage === 1) { this.removeStage = 2; return; }\n    if (this.removeStage === 2) {\n      if (this.plateCol) { this.world.removeCollider(this.plateCol, true); this.plateCol = null; }\n      if (this.plateMesh) { this.plateMesh.removeFromParent(); this.plateMesh = null; }\n      this.removeStage = 0;\n    }\n  }\n  fixedEvent(dt) {\n    const lane = this.lanes[0], b = lane.bal;\n    this.stageT += dt;\n    this.camA += dt * 0.06;\n    this.game.stepIsland(dt, 0);\n    // Your lean tips everything below you.\n    const [wx, wz] = rot2(lane.dotX, lane.dotZ, this.inputYaw);\n    this.game.phys.leanExtraX = wx * 0.07; this.game.phys.leanExtraZ = wz * 0.07;\n    this.syncGallery();\n    const inside = this.ring && Math.hypot(lane.dotX - this.ring.x, lane.dotZ - this.ring.z) < this.ring.r;\n    this.nowIn = !!inside;\n    if (inside) this.inRing += dt;\n    b.tremor = 0.05;\n    switch (this.stage) {\n      case 'pose':\n        b.sway = 0.1;\n        if (this.stageT >= 20) this.startStage(1);\n        break;\n      case 'stones':\n        b.sway = 0.12;\n        this.stoneNext -= dt;\n        if (this.stoneNext <= 0 && this.stoneN < 4) { this.addStone(lane); this.stoneN++; this.stoneNext = 3.4; }\n        if (this.stageT >= 20) { this.clearStones(); this.startStage(2); }\n        break;\n      case 'storm':\n        b.sway = 0.1;\n        this.gustNext -= dt;\n        if (this.gustNext <= 0 && !this.gust) {\n          const a = this.r() * 6.283;\n          this.gust = { warn: 1.2, dur: 0.5, x: Math.cos(a) * 3, z: Math.sin(a) * 3 };\n          this.gustNext = 5.2;\n          this.game.audio.sfx('gust', { dur: 1.2 });\n          this.game.hud.setNote('Brace!', 1.1);\n          this.game.input.rumble(0.1, 0.3, 300);\n        }\n        if (this.gust) {\n          if (this.gust.warn > 0) this.gust.warn -= dt;\n          else { this.gust.dur -= dt; b.extX += this.gust.x * this.diff.dist; b.extZ += this.gust.z * this.diff.dist; if (this.gust.dur <= 0) this.gust = null; }\n        }\n        if (this.stageT >= 20) { this.gust = null; this.startStage(3); }\n        break;\n      case 'step': {\n        b.sway = 0.12;\n        this.cueT -= dt;\n        if (this.cueT <= 0) {\n          const dirs = [[-1, 0], [1, 0], [0, -1], [0, 1]];\n          this.cue = dirs[this.cueIdx++ % 4];\n          this.cueT = 2.4; this.cues++;\n          this.ring = { x: this.cue[0] * 0.6, z: this.cue[1] * 0.6, r: 0.35 };\n          this.game.audio.sfx('foot', { note: 84 });\n        }\n        if (this.stageT >= 20) { this.startStage(4); }\n        break;\n      }\n      case 'last': {\n        const k = Math.min(1, this.stageT / 15);\n        this.ring.r = this.ramp(0.3, 0.08, k);\n        // Sway fades as you succeed; the final notch comes up.\n        b.sway = this.ramp(0.2, 0.02, k);\n        this.lastT += dt;\n        if (inside) this.lastIn += dt;\n        const rest = this.restStart * (1 - k);\n        this.game.phys.setRest(rest);\n        this.game.phys.restNow = rest;\n        if (this.stageT >= 15) { this.done = true; this.game.phys.setRest(0); this.game.phys.restNow = 0; }\n        break;\n      }\n      default: break;\n    }\n    if (this.gust && this.gust.warn > 0) lane.discView.brace = { x: -this.gust.x / 3, z: -this.gust.z / 3 };\n    else lane.discView.brace = null;\n  }\n  onFall(lane) {\n    // It cannot be failed. The class catches you with a stretched bedsheet, and the phase restarts.\n    this.restarts++;\n    this.game.speech.say('trudy', line('trudy', 'finale_catch'), { auto: 3, top: true });\n    this.sheet.visible = true;\n    this.restartAt = this.stageI;\n    for (const s of this.stones) { this.world.removeRigidBody(s.body); this.group.remove(s.mesh); }\n    this.stones = [];\n    void lane;\n  }\n  onRecover() {\n    this.sheet.visible = false;\n    this.stageT = 0;\n    if (this.stage === 'stones') { this.stoneNext = 1.5; this.stoneN = 0; }\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    let gx = 0, gz = 0;\n    if (this.ring) { gx = this.ring.x; gz = this.ring.z; }\n    if (this.gust && this.gust.warn > 0 && this.gust.warn < 1) { const f = 0.2; gx += (-this.gust.x / 3) * f * 3; gz += (-this.gust.z / 3) * f * 3; }\n    const [x, z] = bot.steer(gx, gz, this.stage === 'stones');\n    out.wishX = x; out.wishZ = z;\n    out.breathe = lane.breath.growing;\n    out.flail = !lane.fallen && lane.bal.lean > 0.56 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const lane = this.lanes[0], hud = this.game.hud;\n    const totals = { pose: 20, stones: 20, storm: 20, step: 20, last: 15 };\n    hud.setTime(Math.max(0, totals[this.stage] - this.stageT));\n    lane.discView.zone = this.ring ? { x: this.ring.x, z: this.ring.z, r: this.ring.r, on: this.nowIn } : null;\n  }\n  frameEvent(dt) {\n    const g = this.game;\n    g.syncIsland(dt);\n    this.cameraShot(false);\n    for (const s of this.stones) { const p = s.body.translation(), q = s.body.rotation(); s.mesh.position.set(p.x, p.y, p.z); s.mesh.quaternion.set(q.x, q.y, q.z, q.w); }\n    this.gary.update(dt);\n  }\n  isDone() { return this.done; }\n  laneResult() {\n    const share = this.lastIn / Math.max(1, this.lastT);\n    const form = 60 + 40 * share;\n    return { form, raw: form, big: Math.round(form), stats: `${Math.round(share * 100)}% in the last ring · ${this.restarts} caught by the bedsheet` };\n  }\n  dispose() {\n    const g = this.game;\n    g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    for (const gu of g.art.guests) { gu.wait = 1; gu.doll.rig.loop('idle'); }\n    g.art.heron.root.position.set(-16, 0.43, -5);\n    g.art.walrus.root.position.set(-5, 0, 11);\n    g.art.walrus.rig.loop('stand');\n    g.programme.syncIsland();\n    super.dispose();\n  }\n}\nEOF\ncat > src/events/index.js <<'EOF'\n// The registry: cut an event by removing its line, and the programme quietly skips it.\nimport { FruitHat } from './fruitHat.js';\nimport { Poses } from './poses.js';\nimport { Cairn } from './cairn.js';\nimport { StillWater } from './stillWater.js';\nimport { LogReps } from './logReps.js';\nimport { Plank } from './plank.js';\nimport { Tug } from './tug.js';\nimport { StepClass } from './stepClass.js';\nimport { Plates } from './plates.js';\nimport { IslandLoop } from './islandLoop.js';\nimport { RoomService } from './roomService.js';\nimport { Springboard } from './springboard.js';\nimport { Raft, RaftDoll } from './raft.js';\nimport { GrandHold } from './grandHold.js';\nimport { Doll } from '../art/doll.js';\n\nRaftDoll.cls = Doll;\nexport const EVENT_CLASSES = { fruitHat: FruitHat, poses: Poses, cairn: Cairn, stillWater: StillWater, logReps: LogReps, plank: Plank, tug: Tug, stepClass: StepClass, plates: Plates, islandLoop: IslandLoop, roomService: RoomService, springboard: Springboard, raft: Raft, grandHold: GrandHold };\nexport const hasEvent = (id) => !!EVENT_CLASSES[id];\nEOF\ncat >> ../PROGRESS.md <<'EOF'\n- 2026-11-05: Written so far: core, data, physics, render, input, audio, ui, flow, hub, jar, and all 14 events (untested beyond Fruit Hat). Still to write: checkin.js, ending.js, attract.js, devmode.js, groupclass.js, session.js (real), tools/test.mjs, then test everything.\nEOF\n","description":"Write Room Service, Springboard, Tippy Raft, Grand Hold and the registry"}}}
