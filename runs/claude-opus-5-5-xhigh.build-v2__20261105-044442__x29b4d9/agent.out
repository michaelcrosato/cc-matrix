{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjkSzNXvB45tkCGRoDJB","type":"message","role":"assistant","content":[{"type":"text","text":"The foundation is written: physics, rendering, input, audio and UI. Next comes the event base, Fruit Hat and a playable skeleton, so I can start testing real gameplay."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18089,"cache_read_input_tokens":220921,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18089},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"decb5526-fc03-4fdc-b88a-5acf681cd625","timestamp":"2026-11-05T12:04:38.210Z","request_id":"req_011CgjkSz3SHAPDs6pUdWLEM"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjkSzNXvB45tkCGRoDJB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Mo3jnga8R3wX8cVrZGjfnM","name":"Bash","input":{"command":"cat > src/data/events.js <<'EOF'\n// Every event's words, tiers and scoring pars. Plain data: add a tier here and it exists.\nexport const EVENTS = {\n  poses: {\n    id: 'poses', title: 'Poses', discipline: 'Stillness', instructor: 'stillwater', place: 'The Sun Deck', landmark: 'sunDeck', music: 'stillness', couch: true, session: true,\n    line: 'Follow the ring to each pose, then hold it while the ring shrinks.', can: 'You can breathe with the ring. It helps more than you would think.', cant: \"You can't lose this one. You can only do it badly.\",\n    verbs: [['lean', 'Lean'], ['breathe', 'Breathe'], ['flail', 'Flail']], diagram: 'ring',\n    tiers: [\n      { poses: 3, hold: 8, ringStart: 0.3, ringEnd: 0.16, sway: [0.08, 0.22], tremor: [0.08, 0.2] },\n      { poses: 4, hold: 10, ringStart: 0.3, ringEnd: 0.13, sway: [0.12, 0.3], tremor: [0.1, 0.3] },\n      { poses: 5, hold: 12, ringStart: 0.3, ringEnd: 0.1, sway: [0.15, 0.38], tremor: [0.15, 0.4] },\n    ],\n    session: { poses: 4, hold: 9.4, ringStart: 0.3, ringEnd: 0.16, sway: [0.08, 0.22], tremor: [0.08, 0.2] },\n  },\n  cairn: {\n    id: 'cairn', title: 'The Cairn', discipline: 'Stillness', instructor: 'stillwater', place: 'The Quarry Terrace', landmark: 'quarry', music: 'stillness', couch: true, session: true,\n    line: 'Hold the slab level while Ms. Stillwater lowers stones onto it.', can: 'You can breathe with the ring. Tall stacks like calm people.', cant: \"You can't catch a stone once it has gone.\",\n    verbs: [['lean', 'Lean'], ['breathe', 'Breathe'], ['flail', 'Flail']], diagram: 'stack',\n    tiers: [\n      { stones: 6, every: 5.5, hold: 8, sway: [0.1, 0.3], tremor: [0.05, 0.15], offset: 0.015, par: 700 },\n      { stones: 8, every: 5, hold: 10, sway: [0.15, 0.4], tremor: [0.08, 0.2], offset: 0.02, par: 960 },\n      { stones: 10, every: 4.5, hold: 10, sway: [0.15, 0.4], tremor: [0.08, 0.2], offset: 0.02, wide: true, par: 1200 },\n    ],\n    session: { stones: 7, every: 5.5, hold: 11, sway: [0.1, 0.3], tremor: [0.05, 0.15], offset: 0.015, par: 820 },\n  },\n  stillWater: {\n    id: 'stillWater', title: 'Still Water', discipline: 'Stillness', instructor: 'stillwater', place: 'The Lily Pond', landmark: 'pond', music: 'stillness', couch: false, session: false,\n    line: 'Sit on a lily pad for one minute. Stay in the calm zone and things will come to you.', can: 'You can stifle a sneeze with Flail, if you are quick.', cant: \"You can't fall in. Ms. Stillwater has asked the pond not to allow it.\",\n    verbs: [['lean', 'Lean'], ['breathe', 'Breathe'], ['flail', 'Stifle sneeze']], diagram: 'calm',\n    tiers: [\n      { time: 60, zone: 0.15, sway: [0.07, 0.18], tremor: 0.05, sneezes: 2 },\n      { time: 60, zone: 0.12, sway: [0.1, 0.22], tremor: 0.05, sneezes: 3 },\n      { time: 60, zone: 0.1, sway: [0.12, 0.26], tremor: 0.05, sneezes: 4 },\n    ],\n  },\n  logReps: {\n    id: 'logReps', title: 'Log Reps', discipline: 'Strength', instructor: 'bolster', place: 'The Yard', landmark: 'yard', music: 'strength', couch: true, session: true,\n    line: 'Squeeze both feet to sink with the ribbon, let go to rise. Keep the dot in the zone.', can: 'You can drop the log. Coach will catch it. He likes that.', cant: \"You can't trust Coach's counting.\",\n    verbs: [['lean', 'Lean'], ['feet', 'Sink'], ['flail', 'Flail']], diagram: 'squat',\n    tiers: [\n      { reps: 6, band: [0.16, 0.1], zone: 0.3, sway: [0.08, 0.22], tremor: [0.04, 0.12] },\n      { reps: 9, band: [0.14, 0.08], zone: 0.3, sway: [0.12, 0.3], tremor: [0.06, 0.16] },\n      { reps: 12, band: [0.12, 0.06], zone: 0.3, sway: [0.15, 0.38], tremor: [0.08, 0.2] },\n    ],\n    session: { reps: 10, noBonus: true, band: [0.16, 0.1], zone: 0.3, sway: [0.08, 0.22], tremor: [0.04, 0.12] },\n  },\n  plank: {\n    id: 'plank', title: 'Plank & Perch', discipline: 'Strength', instructor: 'bolster', place: 'The Beam', landmark: 'pier', music: 'strength', couch: false, session: false,\n    line: 'Hold your plank. Gulls will land on you. Lean against the push and keep the dot in the zone.', can: 'You can flail them all off, but Coach will look at you.', cant: \"You can't ask the gulls to leave politely. It has been tried.\",\n    verbs: [['lean', 'Lean'], ['flail', 'Shake off gulls']], diagram: 'plank',\n    tiers: [\n      { time: 30, every: 5, push: [0.2, 0.4], zone: 0.28, sway: 0.1, par: 85 },\n      { time: 45, every: 4.5, push: [0.2, 0.4], zone: 0.28, sway: 0.1, par: 65 },\n      { time: 60, every: 4, push: [0.25, 0.45], zone: 0.28, sway: 0.1, par: 58 },\n    ],\n  },\n  tug: {\n    id: 'tug', title: 'Tug of Peace', discipline: 'Strength', instructor: 'bolster', place: 'The Beach', landmark: 'beach', music: 'strength', couch: true, session: false,\n    line: 'On every Heave, squeeze both feet and lean back. Best of three pulls.', can: 'You can lean back as far as you dare. That is the whole game.', cant: \"You can't lean back safely when the other side eases off.\",\n    verbs: [['lean', 'Lean back'], ['feet', 'Heave'], ['flail', 'Flail']], diagram: 'tug',\n    tiers: [\n      { power: 0.35, ease: 0 },\n      { power: 0.5, ease: 12 },\n      { power: 0.54, ease: 9 },\n    ],\n  },\n  stepClass: {\n    id: 'stepClass', title: 'Step Class', discipline: 'Cardio', instructor: 'bolster', place: 'The Bandstand', landmark: 'bandstand', music: 'cardio', palette: 'dusk', couch: true, session: true,\n    line: 'Press each foot as its footprint reaches you. Lean into the ribbons. The class follows you.', can: 'You can hear the beat in the foot clicks, even with the music low.', cant: \"You can't fall in this one. You can only make someone behind you trip.\",\n    verbs: [['footL', 'Left'], ['footR', 'Right'], ['hop', 'Both'], ['lean', 'Ribbons']], diagram: 'steps',\n    tiers: [\n      { bpm: 104, chart: 'tier1' },\n      { bpm: 116, chart: 'tier2' },\n      { bpm: 124, chart: 'tier3' },\n    ],\n    session: { bpm: 116, chart: 'session' },\n  },\n  plates: {\n    id: 'plates', title: 'Plate Spinners', discipline: 'Cardio', instructor: 'bolster', place: 'The Circus Green', landmark: 'green', music: 'cardio', couch: true, session: true,\n    line: 'Circle your weight to drive the hoop. Each plate needs its own speed. Keep them all spinning.', can: 'You can change speed. You will need to. On keys, tap A and D in turn.', cant: \"You can't fall in this one. Your plates can.\",\n    verbs: [['circle', 'Drive the hoop']], diagram: 'plates',\n    tiers: [\n      { time: 60, plates: 'LMS', decay: 0.11 },\n      { time: 60, plates: 'LMMS', decay: 0.13 },\n      { time: 60, plates: 'LLMMSS', decay: 0.16 },\n    ],\n    session: { time: 50, plates: 'LMS', decay: 0.11 },\n  },\n  islandLoop: {\n    id: 'islandLoop', title: 'Island Loop', discipline: 'Cardio', instructor: 'bolster', place: 'The Ring Road', landmark: 'ringRoad', music: 'cardio', couch: false, session: false,\n    line: 'Alternate your feet to jog two laps behind Retired Kevin. Not too fast, not too slow.', can: 'You can pick up shells. The island tilts as you go, so uphill is real.', cant: \"You can't overtake Kevin. He will not discuss it.\",\n    verbs: [['footL', 'Left'], ['footR', 'Right'], ['steer', 'Steer']], diagram: 'loop',\n    tiers: [\n      { laps: 2, band: 0.15, par: 100 },\n      { laps: 3, band: 0.12, par: 100 },\n      { laps: 4, band: 0.1, par: 100 },\n    ],\n  },\n  fruitHat: {\n    id: 'fruitHat', title: 'Fruit Hat', discipline: 'Balance Play', instructor: 'trudy', place: 'The Pier End', landmark: 'pier', music: 'balance', couch: true, session: true,\n    line: 'Catch fruit in your hat. Hop to toss it in the crate. Bigger banks pay more, and tip you over more.', can: 'You can get greedy. It is encouraged.', cant: \"You can't keep what you spill.\",\n    verbs: [['lean', 'Lean'], ['hop', 'Bank it'], ['flail', 'Flail']], diagram: 'hat',\n    tiers: [\n      { time: 60, radius: 0.45, every: 1.6, mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 52 },\n      { time: 60, radius: 0.55, every: 1.3, mass: 0.012, ankleMax: 5, margin: 0.6, par: 62 },\n      { time: 60, radius: 0.65, every: 1, mass: 0.012, ankleMax: 5, margin: 0.6, par: 75 },\n    ],\n    session: { time: 50, radius: 0.45, every: 1.6, mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 44 },\n  },\n  roomService: {\n    id: 'roomService', title: 'Room Service', discipline: 'Balance Play', instructor: 'trudy', place: 'The Boardwalk', landmark: 'boardwalk', music: 'balance', couch: true, session: false,\n    line: 'Alternate your feet to walk the tray to the far table. Lean into the green before each gust.', can: 'You can brace early. Small early leans keep the glasses.', cant: \"You can't hurry a sudden big lean past a tumbler.\",\n    verbs: [['footL', 'Left'], ['footR', 'Right'], ['lean', 'Lean'], ['flail', 'Flail']], diagram: 'tray',\n    tiers: [\n      { length: 30, gust: 1.2, every: 7, gary: false, wobbly: false },\n      { length: 45, gust: 2, every: 6, gary: true, wobbly: true },\n      { length: 60, gust: 2.3, every: 5, gary: true, wobbly: true },\n    ],\n  },\n  springboard: {\n    id: 'springboard', title: 'Springboard', discipline: 'Balance Play', instructor: 'trudy', place: 'The Tower', landmark: 'pier', music: 'balance', couch: true, session: true,\n    line: 'Squeeze both feet as the board goes down. Hop near the top. Then spin and hit the water well, or badly.', can: 'You can win with a clean dive or a perfect belly flop. Hold Hop to tuck and spin faster.', cant: \"You can't stop spinning at once. Let go early.\",\n    verbs: [['feet', 'Pump'], ['hop', 'Launch / Tuck'], ['lean', 'Spin']], diagram: 'dive',\n    tiers: [\n      { tower: 5, dives: 3, par: 100 },\n      { tower: 7, dives: 3, par: 125 },\n      { tower: 9, dives: 3, par: 150 },\n    ],\n    session: { tower: 5, dives: 3, par: 100, session: true },\n  },\n  raft: {\n    id: 'raft', title: 'Tippy Raft', discipline: 'Balance Play', instructor: 'trudy', place: 'The Raft', landmark: 'gazebo', music: 'balance', couch: true, session: false,\n    line: 'Everyone is on the same raft. Walk, hop and shove. Last doll standing wins the round. Best of three.', can: 'You can shove. It is not very wellness, but you can.', cant: \"You can't get back on once you are in the water.\",\n    verbs: [['move', 'Walk'], ['flail', 'Shove'], ['hop', 'Hop']], diagram: 'raft',\n    tiers: [\n      { radius: 6, shrink: 12, swell: 6 },\n      { radius: 6, shrink: 10, swell: 5 },\n      { radius: 5.5, shrink: 8, swell: 4 },\n    ],\n  },\n  grandHold: {\n    id: 'grandHold', title: 'The Grand Hold', discipline: 'Everything', instructor: 'trudy', place: 'The Lighthouse', landmark: 'lighthouse', music: 'level', palette: 'golden', couch: false, session: false,\n    line: 'Your balance is tied to the island now. Four short phases, then one last hold.', can: 'You can fall. The class has brought a bedsheet.', cant: \"You can't fail this. Everyone has seen to it.\",\n    verbs: [['lean', 'Lean'], ['breathe', 'Breathe'], ['flail', 'Flail']], diagram: 'hold',\n    tiers: [{ par: 100 }, { par: 100 }, { par: 100 }],\n  },\n};\nexport const DISCIPLINE_ORDER = ['Stillness', 'Strength', 'Cardio', 'Balance Play'];\nexport const TIER_NAMES = ['Gentle', 'Honest', 'Unreasonable'];\nexport const SESSION_SET = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard'];\nEOF\ncat > src/data/programme.js <<'EOF'\n// The five days and what follows. Events cut from the registry are skipped automatically.\nexport const DAYS = [\n  { day: 1, name: 'Arrival', tests: ['standStill', 'leanMatch', 'stepTime'], classes: ['poses', 'fruitHat'], teaches: 'Lean, flail, breath, the jar' },\n  { day: 2, name: 'The Second Day, Which Is Harder', tests: ['standStill', 'leanMatch', 'quickLean'], classes: ['logReps', 'stepClass', 'cairn'], teaches: 'Feet, rhythm, stacking' },\n  { day: 3, name: 'Service With a Wobble', tests: ['oneFoot', 'leanMatch', 'stepTime'], classes: ['roomService', 'plates', 'plank'], teaches: 'Stepping, stick circles. The Mirror opens', opens: 'mirror' },\n  { day: 4, name: 'A Little Damp', tests: ['quickLean', 'oneFoot', 'standStill'], classes: ['springboard', 'stillWater', 'islandLoop'], teaches: 'Air control. Group Class invitation', opens: 'group' },\n  { day: 5, name: 'Level Day', tests: 'best', classes: ['raft', 'tug', 'grandHold'], teaches: 'The ending' },\n];\nexport const MAINTENANCE = { name: 'Maintenance', tests: 'random', classes: 3 };\nexport const HANDICAP = [24, 16, 8, 3, 0];\nexport const AGE_MIN = 18, AGE_MAX = 99;\n/** Rest tilt in degrees from programme progress: 9° × (1 − completed / total). */\nexport function restTilt(stepsDone, total, full = 9) { return full * (1 - Math.min(stepsDone, total) / Math.max(1, total)); }\nexport function wobbleAge(mean, handicap) {\n  const age = Math.round(18 + 81 * (1 - Math.max(0, Math.min(1, mean))) ** 1.3 + handicap);\n  return Math.max(AGE_MIN, Math.min(AGE_MAX, age));\n}\nexport function marblesFor(activeMinutes, medalBonus, firstClear, perMinute = 2) {\n  return Math.max(2, Math.round(perMinute * activeMinutes)) + medalBonus + (firstClear ? 2 : 0);\n}\nexport const CHECKIN_MARBLES = 1;\nexport const TESTS = {\n  standStill: { title: 'Stand Still', how: 'Keep the dot in the middle.', time: 10, sway: 0.1, tremor: 0.06 },\n  leanMatch: { title: 'Lean Match', how: 'Lean exactly as far as Trudy asks.', time: 18, sway: 0.04, tremor: 0 },\n  stepTime: { title: 'Step Time', how: 'Alternate your feet with the clicks.', time: 16, sway: 0, tremor: 0 },\n  quickLean: { title: 'Quick Lean', how: 'Lean toward the lit side, quickly.', time: 15, sway: 0.03, tremor: 0 },\n  oneFoot: { title: 'One-Foot Hold', how: 'Keep your right foot down, your left foot up, and the dot in the middle.', time: 12, sway: 0.1, tremor: 0.06 },\n};\nEOF\ncat > src/data/poses.js <<'EOF'\n// Spot on the disc for each pose. All standing poses.\nexport const POSES = [\n  { id: 'heron', name: 'The Contented Heron', x: -0.35, z: 0, clip: 'pose0', demo: 'demoL' },\n  { id: 'pine', name: 'The Apologetic Pine', x: 0, z: 0.4, clip: 'pose1', demo: 'demoF' },\n  { id: 'chair', name: 'Half-Folded Deck Chair', x: 0, z: -0.35, clip: 'pose2', demo: 'demoB' },\n  { id: 'keeper', name: 'The Lighthouse Keeper', x: 0.4, z: 0, clip: 'pose3', demo: 'demoR' },\n  { id: 'flamingo', name: 'Startled Flamingo', x: 0.35, z: 0.2, clip: 'pose4', demo: 'demoR' },\n  { id: 'goodbye', name: 'The Long Goodbye', x: -0.2, z: 0.45, clip: 'pose5', demo: 'demoF' },\n  { id: 'umbrella', name: \"Someone Else's Umbrella\", x: 0.45, z: -0.1, clip: 'pose6', demo: 'demoR' },\n  { id: 'regret', name: 'The Quiet Regret', x: -0.4, z: -0.2, clip: 'pose7', demo: 'demoL' },\n];\nEOF\ncat > src/data/unlocks.js <<'EOF'\n// Marble thresholds. A full programme pays about 15, 37, 59, 81, 103; 61 with every Tier B event cut.\nexport const UNLOCKS = [\n  { at: 6, kind: 'hat', id: 'visor', name: 'The Visor' },\n  { at: 14, kind: 'paint', id: 'sky', name: 'Sky paint' },\n  { at: 24, kind: 'hat', id: 'beret', name: 'The Beret' },\n  { at: 36, kind: 'hat', id: 'bucket', name: 'The Bucket Hat' },\n  { at: 50, kind: 'hat', id: 'perm', name: 'The Perm' },\n  { at: 60, kind: 'hat', id: 'wizard', name: 'The Wizard Hat' },\n  { at: 60, kind: 'hat', id: 'crown', name: 'The Tiny Crown' },\n];\nexport const STARTER_PAINTS = ['teal', 'coral', 'butter', 'plum'];\nexport const LATE_PAINTS = [{ at: 14, id: 'sky' }, { at: 24, id: 'moss' }, { at: 36, id: 'rose' }, { at: 50, id: 'navy' }];\nexport const HATS = [\n  { id: 'none', name: 'No Hat', at: 0 }, { id: 'visor', name: 'The Visor', at: 6 }, { id: 'beret', name: 'The Beret', at: 24 },\n  { id: 'bucket', name: 'The Bucket Hat', at: 36 }, { id: 'perm', name: 'The Perm', at: 50 }, { id: 'wizard', name: 'The Wizard Hat', at: 60 }, { id: 'crown', name: 'The Tiny Crown', at: 60 },\n];\nEOF\ncat > src/data/names.js <<'EOF'\n// The name spinner. No text entry.\nexport const FIRST = ['Gentle', 'Retired', 'Unsteady', 'Young', 'Mostly', 'Quiet', 'Patient', 'Approximate', 'Reasonable', 'Hopeful', 'Honest', 'Lean', 'Careful', 'Tentative', 'Sincere', 'Upright', 'Former', 'Modest', 'Punctual', 'Sideways'];\nexport const LAST = ['Margaret', 'Kevin', 'Paul', 'Gerald', 'Sandra', 'Doreen', 'Barry', 'Yuki', 'Priya', 'Tomas', 'Ingrid', 'Dale', 'Bernard', 'Noor', 'Hiroshi', 'Winifred', 'Oscar', 'Lupe', 'Fergus', 'Ada'];\nEOF\ncat > src/events/base.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, createWorld, groundCollider } from '../physics/world.js';\nimport { Balancer } from '../physics/balancer.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nimport { Doll, paintColour } from '../art/doll.js';\nimport { EVENTS } from '../data/events.js';\nimport { LANE_SPACING, FIXED_DT, medalFor } from '../data/config.js';\nimport { blankInput } from '../input/input.js';\nimport { tun } from '../core/tuning.js';\nimport { rng, cos, cosPick } from '../core/rng.js';\nimport { makeBot } from '../input/bot.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { line } from '../data/dialogue.js';\n\nexport const DIFFICULTY = {\n  gentle: { ankle: 1.25, dist: 0.65, rhythm: 1.4 },\n  standard: { ankle: 1, dist: 1, rhythm: 1 },\n  honest: { ankle: 0.9, dist: 1.2, rhythm: 0.8 },\n};\n\n/** Breath ring: 4 s growing, 4 s shrinking. 70%+ in sync over the last full cycle earns the bonus. */\nexport class Breath {\n  constructor() { this.t = 0; this.samples = []; this.inSync = false; this.syncShare = 0; this.period = 8; }\n  get phase() { return (this.t % this.period) / this.period; }\n  get growing() { return this.phase < 0.5; }\n  get size() { const p = this.phase; return p < 0.5 ? p * 2 : 2 - p * 2; }\n  step(dt, held, auto) {\n    this.t += dt;\n    const ok = auto || held === this.growing;\n    this.samples.push(ok ? 1 : 0);\n    const max = Math.round(this.period / FIXED_DT);\n    if (this.samples.length > max) this.samples.shift();\n    if (this.samples.length >= max) {\n      if (((this.t / FIXED_DT) | 0) % 30 === 0) {\n        let s = 0;\n        for (let i = 0; i < this.samples.length; i++) s += this.samples[i];\n        this.syncShare = s / this.samples.length;\n        this.inSync = this.syncShare >= 0.7;\n      }\n    } else if (auto) this.inSync = true;\n  }\n}\n\n/** One player or bot or ghost: everything an event needs about them. */\nexport class Lane {\n  constructor(ev, spec, index) {\n    this.ev = ev; this.id = index; this.kind = spec.kind || 'local'; this.name = spec.name || `Player ${index + 1}`;\n    this.colour = spec.colour || '#2CB5A0'; this.source = spec.source || 'any'; this.seat = spec.seat ?? index;\n    this.hat = spec.hat || 'none'; this.skill = spec.skill || 'average';\n    this.input = blankInput();\n    this.x = ev.laneX(index);\n    this.doll = null; this.bal = null; this.props = [];\n    this.score = 0; this.form = 0; this.raw = 0; this.falls = 0; this.fallen = false; this.recoverT = 0; this.ragdoll = null; this.finished = false;\n    this.breath = new Breath();\n    this.bot = this.kind === 'bot' || spec.botBrain ? makeBot(spec.skill || 'average', index) : null;\n    this.discView = { dx: 0, dz: 0, ax: 0, az: 0, zone: null, brace: null, breath: null, showAsk: true, alarm: false, frame: 0 };\n    this.clipIndex = 0; this.stats = {};\n    this.lastInputDevice = 'pad';\n  }\n  get cobX() { return this.bal ? this.bal.cobX : 0; }\n  get cobZ() { return this.bal ? this.bal.cobZ : 0; }\n  /** The dot in stick space. */\n  get dotX() { const y = this.ev.inputYaw; if (!y) return this.cobX; return rot2(this.cobX, this.cobZ, -y)[0]; }\n  get dotZ() { const y = this.ev.inputYaw; if (!y) return this.cobZ; return rot2(this.cobX, this.cobZ, -y)[1]; }\n}\n\nexport class EventBase {\n  static id = 'base';\n  /** spec: { game, tier, lanes:[laneSpec], mode:'solo'|'group'|'session'|'attract', config, god } */\n  constructor(spec) {\n    this.game = spec.game; this.tier = spec.tier || 0; this.mode = spec.mode || 'solo'; this.god = !!spec.god;\n    this.data = EVENTS[this.constructor.id];\n    this.cfg = spec.config || this.data.tiers[this.tier];\n    this.laneSpecs = spec.lanes || [{ kind: 'local', name: 'You', colour: '#2CB5A0' }];\n    this.diff = DIFFICULTY[this.game.save.settings.difficulty] || DIFFICULTY.standard;\n    this.t = 0; this.phase = 'intro'; this.inputYaw = 0; this.over = false;\n    this.group = new THREE.Group();\n    this.r = rng(this.constructor.id);\n    this.world = null; this.lanes = [];\n    this.iterations = 8;\n    this.balanceParams = {};\n    this.discs = true; this.breathOn = false; this.floorY = 0; this.seaLevel = -0.8;\n    this.barks = 0; this.stepCount = 0; this.fallsForLine = 0;\n    this.dolls = [];\n    this.props = [];\n    this.tempBodies = [];\n  }\n  get activeLanes() { return this.lanes.filter((l) => l.kind !== 'ghost'); }\n  laneX(i) {\n    const n = this.laneSpecs.length;\n    return (i - (n - 1) / 2) * LANE_SPACING;\n  }\n  /** Build world, lanes, dolls, set. */\n  build() {\n    this.world = createWorld({ iterations: this.iterations });\n    this.addGround();\n    this.laneSpecs.forEach((spec, i) => {\n      const lane = new Lane(this, spec, i);\n      this.lanes.push(lane);\n      this.buildLane(lane, i);\n    });\n    this.buildSet();\n    this.game.scene.add(this.group);\n    this.syncDolls(0);\n  }\n  addGround() { groundCollider(this.world, 0, -0.5, 0, 200, 0.5, 200); }\n  buildLane(lane, i) {\n    const doll = new Doll({ shirt: lane.colour, hat: lane.hat });\n    lane.doll = doll;\n    doll.place(lane.x, this.floorY, this.laneZ(i));\n    this.group.add(doll.root);\n    if (lane.kind === 'ghost') return;\n    lane.bal = new Balancer(this.world, i, lane.x, this.floorY, this.laneZ(i), { ...this.balanceParams, ph: 1.3 * i + this.r() * 6, diff: this.diff });\n    this.setupLane(lane);\n  }\n  laneZ() { return 0; }\n  /** Event hooks. */\n  setupLane() {}\n  buildSet() {}\n  start() {}\n  fixedEvent() {}\n  frameEvent() {}\n  onFall() {}\n  onRecover() {}\n  onFlail() {}\n  laneResult(lane) { return { form: lane.form, raw: lane.raw, stats: {} }; }\n  botInput() { return blankInput(); }\n  hudSetup() {}\n  hud() {}\n  cameraShot(snap) {}\n  isDone() { return false; }\n  extraPrompts() { return null; }\n  /** Make the set appear in-world. */\n  begin() {\n    this.phase = 'play';\n    this.t = 0;\n    for (const l of this.lanes) { l.input = blankInput(); }\n    if (this.game.input) this.game.input.resetRing();\n    this.start();\n  }\n  /** One fixed step. */\n  fixed(dt) {\n    if (this.phase === 'intro') { this.stepIdle(dt); return; }\n    if (this.phase === 'done') { this.stepIdle(dt); return; }\n    this.t += dt;\n    for (const lane of this.lanes) this.readInput(lane, dt);\n    this.fixedEvent(dt);\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.bal) continue;\n      this.applyInput(lane, dt);\n      lane.bal.pre(dt);\n    }\n    this.world.step();\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.bal) continue;\n      lane.bal.post();\n      this.checkFall(lane, dt);\n    }\n    this.afterStep(dt);\n  }\n  /** Before and after play the world keeps going with nobody asking for anything. */\n  stepIdle(dt) {\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.bal) continue;\n      lane.input.wishX = 0; lane.input.wishZ = 0;\n      lane.bal.wishX = 0; lane.bal.wishZ = 0;\n      lane.bal.pre(dt);\n    }\n    this.world.step();\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.bal) continue;\n      lane.bal.post();\n      if (lane.ragdoll) this.checkFall(lane, dt);\n    }\n    this.idleStep(dt);\n  }\n  idleStep() {}\n  afterStep() {}\n  readInput(lane, dt) {\n    if (lane.kind === 'ghost') return;\n    if (lane.kind === 'bot' || this.autoplay === lane.id) {\n      this.botStep(lane, dt);\n      return;\n    }\n    this.game.input.sample(lane.source, lane.input, dt);\n    if (lane.input.device) lane.lastInputDevice = lane.input.device;\n  }\n  botStep(lane, dt) {\n    if (!lane.bot) lane.bot = makeBot(lane.skill, lane.id);\n    lane.bot.observe(lane, dt);\n    const out = this.botInput(lane, this.t, lane.bot, dt);\n    if (out) Object.assign(lane.input, out);\n  }\n  applyInput(lane, dt) {\n    const i = lane.input, b = lane.bal;\n    if (this.inputYaw) { const [wx, wz] = rot2(i.wishX, i.wishZ, this.inputYaw); b.wishX = wx; b.wishZ = wz; } else { b.wishX = i.wishX; b.wishZ = i.wishZ; }\n    if (this.breathOn) {\n      lane.breath.step(dt, !!i.breathe, this.game.save.settings.autoBreathe || lane.breathAuto);\n      b.breathScale = lane.breath.inSync ? 0.6 : 1;\n    } else b.breathScale = 1;\n    if (i.flail && !lane.fallen) {\n      if (b.flail()) {\n        lane.doll.rig.once('flail');\n        this.game.audio.sfx('boing');\n        this.flailed(lane);\n      }\n    }\n  }\n  flailed(lane) { this.onFlail(lane); }\n  checkFall(lane, dt) {\n    const b = lane.bal;\n    if (lane.fallen) {\n      lane.recoverT -= dt;\n      if (lane.ragdoll) lane.ragdoll.sync();\n      if (lane.recoverT <= 0) this.recoverLane(lane);\n      return;\n    }\n    if (!b.enabled) return;\n    const limit = tun.fallAngle * Math.PI / 180;\n    if (b.lean >= limit) {\n      if (this.god) {\n        // God mode: nobody falls. The core is quietly stood back up.\n        b.recover();\n        return;\n      }\n      this.fallLane(lane);\n    }\n  }\n  fallLane(lane) {\n    if (lane.fallen) return;\n    const b = lane.bal;\n    lane.fallen = true; lane.falls++; lane.recoverT = tun.recoverTime;\n    const v = b.body.linvel();\n    b.disable();\n    lane.doll.ragdolled = true;\n    const kick = { x: lane.bal.leanX * 0.04, y: 0.02, z: lane.bal.leanZ * 0.04 };\n    lane.ragdoll = new Ragdoll(this.world, lane.doll, this.group, { x: v.x, y: v.y, z: v.z }, kick);\n    this.game.audio.sfx('fall');\n    this.game.input.rumble(0.9, 0.7, 320, lane.input.padIndex >= 0 ? lane.input.padIndex : undefined);\n    const c = lane.ragdoll.centre();\n    this.game.comic && this.game.comic.pop('CLACK!', c.x, c.y + 1.2, c.z);\n    this.game.rig && this.game.rig.shake(0.08);\n    this.onFall(lane);\n    if (lane.kind === 'local') this.game.onFloorExercise && this.game.onFloorExercise();\n  }\n  recoverLane(lane) {\n    lane.fallen = false;\n    if (lane.ragdoll) { lane.ragdoll.end(); lane.ragdoll = null; }\n    lane.doll.ragdolled = false;\n    lane.bal.recover();\n    lane.doll.place(lane.bal.fx, lane.bal.fy, lane.bal.fz);\n    lane.doll.rig.once('land');\n    this.game.audio.sfx('spring');\n    this.onRecover(lane);\n  }\n  /** Force a fall (Dev Mode, tests). */\n  forceFall(i = 0) { const l = this.lanes[i]; if (l && l.bal && !l.fallen) { const g = this.god; this.god = false; this.fallLane(l); this.god = g; } }\n  syncDolls(dt) {\n    for (const lane of this.lanes) {\n      const d = lane.doll;\n      if (!d) continue;\n      if (lane.kind !== 'ghost' && lane.bal && !lane.fallen && !this.customPose) {\n        const q = lane.bal.body.rotation();\n        d.setLean(q.x, q.y, q.z, q.w);\n        d.place(lane.bal.fx, lane.bal.fy, lane.bal.fz);\n      }\n      d.update(dt);\n      const v = lane.discView;\n      v.dx = lane.dotX; v.dz = lane.dotZ;\n      v.ax = lane.input.wishX; v.az = lane.input.wishZ;\n      v.alarm = lane.bal ? lane.bal.lean > 0.5 : false;\n      v.breath = this.breathOn ? { size: lane.breath.size, growing: lane.breath.growing, inSync: lane.breath.inSync } : null;\n    }\n  }\n  frame(dt) {\n    this.syncDolls(dt);\n    this.frameEvent(dt);\n    if (this.phase === 'play') this.hud(dt);\n  }\n  /** Sets are built under this.group. */\n  dispose() {\n    for (const lane of this.lanes) {\n      if (lane.ragdoll) { lane.ragdoll = null; }\n    }\n    this.game.scene.remove(this.group);\n    if (this.world) { this.world.free(); this.world = null; }\n    this.group.clear();\n  }\n  bodies() { return this.world ? this.world.bodies.len() : 0; }\n  /** A short non-blocking remark from whoever is teaching. */\n  bark(who, situation, auto = 2.6, gap = 7) {\n    if (this.mode === 'session' || this.mode === 'attract') return;\n    if (this.t - (this.lastBark ?? -99) < gap) return;\n    this.lastBark = this.t;\n    const text = line(who, situation);\n    if (text) this.game.speech.say(who, text, { auto, top: true });\n  }\n  medal(lane) { return medalFor(lane.form); }\n  /** Standing props are lit, chunky, inked and at most slightly alive. */\n  ramp(a, b, k) { return a + (b - a) * Math.max(0, Math.min(1, k)); }\n}\nexport { RAPIER, cos, cosPick };\nEOF\ncat > src/input/bot.js <<'EOF'\nimport { mulberry32 } from '../core/rng.js';\n\n// The human model behind every skill number: a delayed correction with noise.\nexport const SKILLS = {\n  sharp: { delay: 0.16, gain: 1.4, gainLoad: 0.7, noise: 0, lag: 0.12, speedErr: 0.3, timing: 0.028 },\n  average: { delay: 0.26, gain: 1.0, gainLoad: 0.55, noise: 0.03, lag: 0.28, speedErr: 0.8, timing: 0.055 },\n  clumsy: { delay: 0.38, gain: 0.8, gainLoad: 0.45, noise: 0.07, lag: 0.5, speedErr: 1.4, timing: 0.095 },\n};\n\nexport function makeBot(skill, seedExtra = 0) { return new Bot(skill, seedExtra); }\n\nexport class Bot {\n  constructor(skill = 'average', seedExtra = 0) {\n    this.skillName = skill; this.s = SKILLS[skill] || SKILLS.average;\n    this.r = mulberry32(((skill.length * 7919) ^ (seedExtra * 104729) ^ 0xBEEF) >>> 0);\n    this.hist = []; this.t = 0; this.dotX = 0; this.dotZ = 0;\n    this.data = {};\n    this.ph = this.r() * 6.28; this.ph2 = this.r() * 6.28;\n  }\n  /** See the dot, a moment late. */\n  observe(lane, dt) {\n    this.t += dt;\n    this.hist.push(lane.dotX, lane.dotZ);\n    const n = Math.max(1, Math.round(this.s.delay / dt));\n    if (this.hist.length > n * 2) this.hist.splice(0, this.hist.length - n * 2);\n    this.dotX = this.hist[0]; this.dotZ = this.hist[1];\n  }\n  /** wish = goal + gain × (goal − dot) + noise × sin(...) */\n  steer(gx, gz, load = false) {\n    const g = load ? this.s.gainLoad : this.s.gain, n = this.s.noise;\n    let x = gx + g * (gx - this.dotX) + n * Math.sin(this.t * 2.3 + this.ph) * 3;\n    let z = gz + g * (gz - this.dotZ) + n * Math.sin(this.t * 1.9 + this.ph2) * 3;\n    const m = Math.hypot(x, z);\n    if (m > 1) { x /= m; z /= m; }\n    return [x, z];\n  }\n  /** A gaussian-ish timing error in seconds. */\n  timing() { return (this.r() + this.r() + this.r() - 1.5) * 1.15 * this.s.timing * 1.0; }\n  chance(p) { return this.r() < p; }\n}\nEOF\n","description":"Write event data, programme tables and the event base class"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18089,"cache_read_input_tokens":220921,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18089},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"524acceb-5bb9-4195-8747-b6ce477a7093","timestamp":"2026-11-05T12:06:25.711Z","request_id":"req_011CgjkSz3SHAPDs6pUdWLEM","wire_tool_inputs":{"toolu_01Mo3jnga8R3wX8cVrZGjfnM":{"command":"cat > src/data/events.js <<'EOF'\n// Every event's words, tiers and scoring pars. Plain data: add a tier here and it exists.\nexport const EVENTS = {\n  poses: {\n    id: 'poses', title: 'Poses', discipline: 'Stillness', instructor: 'stillwater', place: 'The Sun Deck', landmark: 'sunDeck', music: 'stillness', couch: true, session: true,\n    line: 'Follow the ring to each pose, then hold it while the ring shrinks.', can: 'You can breathe with the ring. It helps more than you would think.', cant: \"You can't lose this one. You can only do it badly.\",\n    verbs: [['lean', 'Lean'], ['breathe', 'Breathe'], ['flail', 'Flail']], diagram: 'ring',\n    tiers: [\n      { poses: 3, hold: 8, ringStart: 0.3, ringEnd: 0.16, sway: [0.08, 0.22], tremor: [0.08, 0.2] },\n      { poses: 4, hold: 10, ringStart: 0.3, ringEnd: 0.13, sway: [0.12, 0.3], tremor: [0.1, 0.3] },\n      { poses: 5, hold: 12, ringStart: 0.3, ringEnd: 0.1, sway: [0.15, 0.38], tremor: [0.15, 0.4] },\n    ],\n    session: { poses: 4, hold: 9.4, ringStart: 0.3, ringEnd: 0.16, sway: [0.08, 0.22], tremor: [0.08, 0.2] },\n  },\n  cairn: {\n    id: 'cairn', title: 'The Cairn', discipline: 'Stillness', instructor: 'stillwater', place: 'The Quarry Terrace', landmark: 'quarry', music: 'stillness', couch: true, session: true,\n    line: 'Hold the slab level while Ms. Stillwater lowers stones onto it.', can: 'You can breathe with the ring. Tall stacks like calm people.', cant: \"You can't catch a stone once it has gone.\",\n    verbs: [['lean', 'Lean'], ['breathe', 'Breathe'], ['flail', 'Flail']], diagram: 'stack',\n    tiers: [\n      { stones: 6, every: 5.5, hold: 8, sway: [0.1, 0.3], tremor: [0.05, 0.15], offset: 0.015, par: 700 },\n      { stones: 8, every: 5, hold: 10, sway: [0.15, 0.4], tremor: [0.08, 0.2], offset: 0.02, par: 960 },\n      { stones: 10, every: 4.5, hold: 10, sway: [0.15, 0.4], tremor: [0.08, 0.2], offset: 0.02, wide: true, par: 1200 },\n    ],\n    session: { stones: 7, every: 5.5, hold: 11, sway: [0.1, 0.3], tremor: [0.05, 0.15], offset: 0.015, par: 820 },\n  },\n  stillWater: {\n    id: 'stillWater', title: 'Still Water', discipline: 'Stillness', instructor: 'stillwater', place: 'The Lily Pond', landmark: 'pond', music: 'stillness', couch: false, session: false,\n    line: 'Sit on a lily pad for one minute. Stay in the calm zone and things will come to you.', can: 'You can stifle a sneeze with Flail, if you are quick.', cant: \"You can't fall in. Ms. Stillwater has asked the pond not to allow it.\",\n    verbs: [['lean', 'Lean'], ['breathe', 'Breathe'], ['flail', 'Stifle sneeze']], diagram: 'calm',\n    tiers: [\n      { time: 60, zone: 0.15, sway: [0.07, 0.18], tremor: 0.05, sneezes: 2 },\n      { time: 60, zone: 0.12, sway: [0.1, 0.22], tremor: 0.05, sneezes: 3 },\n      { time: 60, zone: 0.1, sway: [0.12, 0.26], tremor: 0.05, sneezes: 4 },\n    ],\n  },\n  logReps: {\n    id: 'logReps', title: 'Log Reps', discipline: 'Strength', instructor: 'bolster', place: 'The Yard', landmark: 'yard', music: 'strength', couch: true, session: true,\n    line: 'Squeeze both feet to sink with the ribbon, let go to rise. Keep the dot in the zone.', can: 'You can drop the log. Coach will catch it. He likes that.', cant: \"You can't trust Coach's counting.\",\n    verbs: [['lean', 'Lean'], ['feet', 'Sink'], ['flail', 'Flail']], diagram: 'squat',\n    tiers: [\n      { reps: 6, band: [0.16, 0.1], zone: 0.3, sway: [0.08, 0.22], tremor: [0.04, 0.12] },\n      { reps: 9, band: [0.14, 0.08], zone: 0.3, sway: [0.12, 0.3], tremor: [0.06, 0.16] },\n      { reps: 12, band: [0.12, 0.06], zone: 0.3, sway: [0.15, 0.38], tremor: [0.08, 0.2] },\n    ],\n    session: { reps: 10, noBonus: true, band: [0.16, 0.1], zone: 0.3, sway: [0.08, 0.22], tremor: [0.04, 0.12] },\n  },\n  plank: {\n    id: 'plank', title: 'Plank & Perch', discipline: 'Strength', instructor: 'bolster', place: 'The Beam', landmark: 'pier', music: 'strength', couch: false, session: false,\n    line: 'Hold your plank. Gulls will land on you. Lean against the push and keep the dot in the zone.', can: 'You can flail them all off, but Coach will look at you.', cant: \"You can't ask the gulls to leave politely. It has been tried.\",\n    verbs: [['lean', 'Lean'], ['flail', 'Shake off gulls']], diagram: 'plank',\n    tiers: [\n      { time: 30, every: 5, push: [0.2, 0.4], zone: 0.28, sway: 0.1, par: 85 },\n      { time: 45, every: 4.5, push: [0.2, 0.4], zone: 0.28, sway: 0.1, par: 65 },\n      { time: 60, every: 4, push: [0.25, 0.45], zone: 0.28, sway: 0.1, par: 58 },\n    ],\n  },\n  tug: {\n    id: 'tug', title: 'Tug of Peace', discipline: 'Strength', instructor: 'bolster', place: 'The Beach', landmark: 'beach', music: 'strength', couch: true, session: false,\n    line: 'On every Heave, squeeze both feet and lean back. Best of three pulls.', can: 'You can lean back as far as you dare. That is the whole game.', cant: \"You can't lean back safely when the other side eases off.\",\n    verbs: [['lean', 'Lean back'], ['feet', 'Heave'], ['flail', 'Flail']], diagram: 'tug',\n    tiers: [\n      { power: 0.35, ease: 0 },\n      { power: 0.5, ease: 12 },\n      { power: 0.54, ease: 9 },\n    ],\n  },\n  stepClass: {\n    id: 'stepClass', title: 'Step Class', discipline: 'Cardio', instructor: 'bolster', place: 'The Bandstand', landmark: 'bandstand', music: 'cardio', palette: 'dusk', couch: true, session: true,\n    line: 'Press each foot as its footprint reaches you. Lean into the ribbons. The class follows you.', can: 'You can hear the beat in the foot clicks, even with the music low.', cant: \"You can't fall in this one. You can only make someone behind you trip.\",\n    verbs: [['footL', 'Left'], ['footR', 'Right'], ['hop', 'Both'], ['lean', 'Ribbons']], diagram: 'steps',\n    tiers: [\n      { bpm: 104, chart: 'tier1' },\n      { bpm: 116, chart: 'tier2' },\n      { bpm: 124, chart: 'tier3' },\n    ],\n    session: { bpm: 116, chart: 'session' },\n  },\n  plates: {\n    id: 'plates', title: 'Plate Spinners', discipline: 'Cardio', instructor: 'bolster', place: 'The Circus Green', landmark: 'green', music: 'cardio', couch: true, session: true,\n    line: 'Circle your weight to drive the hoop. Each plate needs its own speed. Keep them all spinning.', can: 'You can change speed. You will need to. On keys, tap A and D in turn.', cant: \"You can't fall in this one. Your plates can.\",\n    verbs: [['circle', 'Drive the hoop']], diagram: 'plates',\n    tiers: [\n      { time: 60, plates: 'LMS', decay: 0.11 },\n      { time: 60, plates: 'LMMS', decay: 0.13 },\n      { time: 60, plates: 'LLMMSS', decay: 0.16 },\n    ],\n    session: { time: 50, plates: 'LMS', decay: 0.11 },\n  },\n  islandLoop: {\n    id: 'islandLoop', title: 'Island Loop', discipline: 'Cardio', instructor: 'bolster', place: 'The Ring Road', landmark: 'ringRoad', music: 'cardio', couch: false, session: false,\n    line: 'Alternate your feet to jog two laps behind Retired Kevin. Not too fast, not too slow.', can: 'You can pick up shells. The island tilts as you go, so uphill is real.', cant: \"You can't overtake Kevin. He will not discuss it.\",\n    verbs: [['footL', 'Left'], ['footR', 'Right'], ['steer', 'Steer']], diagram: 'loop',\n    tiers: [\n      { laps: 2, band: 0.15, par: 100 },\n      { laps: 3, band: 0.12, par: 100 },\n      { laps: 4, band: 0.1, par: 100 },\n    ],\n  },\n  fruitHat: {\n    id: 'fruitHat', title: 'Fruit Hat', discipline: 'Balance Play', instructor: 'trudy', place: 'The Pier End', landmark: 'pier', music: 'balance', couch: true, session: true,\n    line: 'Catch fruit in your hat. Hop to toss it in the crate. Bigger banks pay more, and tip you over more.', can: 'You can get greedy. It is encouraged.', cant: \"You can't keep what you spill.\",\n    verbs: [['lean', 'Lean'], ['hop', 'Bank it'], ['flail', 'Flail']], diagram: 'hat',\n    tiers: [\n      { time: 60, radius: 0.45, every: 1.6, mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 52 },\n      { time: 60, radius: 0.55, every: 1.3, mass: 0.012, ankleMax: 5, margin: 0.6, par: 62 },\n      { time: 60, radius: 0.65, every: 1, mass: 0.012, ankleMax: 5, margin: 0.6, par: 75 },\n    ],\n    session: { time: 50, radius: 0.45, every: 1.6, mass: 0.015, ankleMax: 4.6, margin: 0.45, par: 44 },\n  },\n  roomService: {\n    id: 'roomService', title: 'Room Service', discipline: 'Balance Play', instructor: 'trudy', place: 'The Boardwalk', landmark: 'boardwalk', music: 'balance', couch: true, session: false,\n    line: 'Alternate your feet to walk the tray to the far table. Lean into the green before each gust.', can: 'You can brace early. Small early leans keep the glasses.', cant: \"You can't hurry a sudden big lean past a tumbler.\",\n    verbs: [['footL', 'Left'], ['footR', 'Right'], ['lean', 'Lean'], ['flail', 'Flail']], diagram: 'tray',\n    tiers: [\n      { length: 30, gust: 1.2, every: 7, gary: false, wobbly: false },\n      { length: 45, gust: 2, every: 6, gary: true, wobbly: true },\n      { length: 60, gust: 2.3, every: 5, gary: true, wobbly: true },\n    ],\n  },\n  springboard: {\n    id: 'springboard', title: 'Springboard', discipline: 'Balance Play', instructor: 'trudy', place: 'The Tower', landmark: 'pier', music: 'balance', couch: true, session: true,\n    line: 'Squeeze both feet as the board goes down. Hop near the top. Then spin and hit the water well, or badly.', can: 'You can win with a clean dive or a perfect belly flop. Hold Hop to tuck and spin faster.', cant: \"You can't stop spinning at once. Let go early.\",\n    verbs: [['feet', 'Pump'], ['hop', 'Launch / Tuck'], ['lean', 'Spin']], diagram: 'dive',\n    tiers: [\n      { tower: 5, dives: 3, par: 100 },\n      { tower: 7, dives: 3, par: 125 },\n      { tower: 9, dives: 3, par: 150 },\n    ],\n    session: { tower: 5, dives: 3, par: 100, session: true },\n  },\n  raft: {\n    id: 'raft', title: 'Tippy Raft', discipline: 'Balance Play', instructor: 'trudy', place: 'The Raft', landmark: 'gazebo', music: 'balance', couch: true, session: false,\n    line: 'Everyone is on the same raft. Walk, hop and shove. Last doll standing wins the round. Best of three.', can: 'You can shove. It is not very wellness, but you can.', cant: \"You can't get back on once you are in the water.\",\n    verbs: [['move', 'Walk'], ['flail', 'Shove'], ['hop', 'Hop']], diagram: 'raft',\n    tiers: [\n      { radius: 6, shrink: 12, swell: 6 },\n      { radius: 6, shrink: 10, swell: 5 },\n      { radius: 5.5, shrink: 8, swell: 4 },\n    ],\n  },\n  grandHold: {\n    id: 'grandHold', title: 'The Grand Hold', discipline: 'Everything', instructor: 'trudy', place: 'The Lighthouse', landmark: 'lighthouse', music: 'level', palette: 'golden', couch: false, session: false,\n    line: 'Your balance is tied to the island now. Four short phases, then one last hold.', can: 'You can fall. The class has brought a bedsheet.', cant: \"You can't fail this. Everyone has seen to it.\",\n    verbs: [['lean', 'Lean'], ['breathe', 'Breathe'], ['flail', 'Flail']], diagram: 'hold',\n    tiers: [{ par: 100 }, { par: 100 }, { par: 100 }],\n  },\n};\nexport const DISCIPLINE_ORDER = ['Stillness', 'Strength', 'Cardio', 'Balance Play'];\nexport const TIER_NAMES = ['Gentle', 'Honest', 'Unreasonable'];\nexport const SESSION_SET = ['poses', 'cairn', 'logReps', 'stepClass', 'plates', 'fruitHat', 'springboard'];\nEOF\ncat > src/data/programme.js <<'EOF'\n// The five days and what follows. Events cut from the registry are skipped automatically.\nexport const DAYS = [\n  { day: 1, name: 'Arrival', tests: ['standStill', 'leanMatch', 'stepTime'], classes: ['poses', 'fruitHat'], teaches: 'Lean, flail, breath, the jar' },\n  { day: 2, name: 'The Second Day, Which Is Harder', tests: ['standStill', 'leanMatch', 'quickLean'], classes: ['logReps', 'stepClass', 'cairn'], teaches: 'Feet, rhythm, stacking' },\n  { day: 3, name: 'Service With a Wobble', tests: ['oneFoot', 'leanMatch', 'stepTime'], classes: ['roomService', 'plates', 'plank'], teaches: 'Stepping, stick circles. The Mirror opens', opens: 'mirror' },\n  { day: 4, name: 'A Little Damp', tests: ['quickLean', 'oneFoot', 'standStill'], classes: ['springboard', 'stillWater', 'islandLoop'], teaches: 'Air control. Group Class invitation', opens: 'group' },\n  { day: 5, name: 'Level Day', tests: 'best', classes: ['raft', 'tug', 'grandHold'], teaches: 'The ending' },\n];\nexport const MAINTENANCE = { name: 'Maintenance', tests: 'random', classes: 3 };\nexport const HANDICAP = [24, 16, 8, 3, 0];\nexport const AGE_MIN = 18, AGE_MAX = 99;\n/** Rest tilt in degrees from programme progress: 9° × (1 − completed / total). */\nexport function restTilt(stepsDone, total, full = 9) { return full * (1 - Math.min(stepsDone, total) / Math.max(1, total)); }\nexport function wobbleAge(mean, handicap) {\n  const age = Math.round(18 + 81 * (1 - Math.max(0, Math.min(1, mean))) ** 1.3 + handicap);\n  return Math.max(AGE_MIN, Math.min(AGE_MAX, age));\n}\nexport function marblesFor(activeMinutes, medalBonus, firstClear, perMinute = 2) {\n  return Math.max(2, Math.round(perMinute * activeMinutes)) + medalBonus + (firstClear ? 2 : 0);\n}\nexport const CHECKIN_MARBLES = 1;\nexport const TESTS = {\n  standStill: { title: 'Stand Still', how: 'Keep the dot in the middle.', time: 10, sway: 0.1, tremor: 0.06 },\n  leanMatch: { title: 'Lean Match', how: 'Lean exactly as far as Trudy asks.', time: 18, sway: 0.04, tremor: 0 },\n  stepTime: { title: 'Step Time', how: 'Alternate your feet with the clicks.', time: 16, sway: 0, tremor: 0 },\n  quickLean: { title: 'Quick Lean', how: 'Lean toward the lit side, quickly.', time: 15, sway: 0.03, tremor: 0 },\n  oneFoot: { title: 'One-Foot Hold', how: 'Keep your right foot down, your left foot up, and the dot in the middle.', time: 12, sway: 0.1, tremor: 0.06 },\n};\nEOF\ncat > src/data/poses.js <<'EOF'\n// Spot on the disc for each pose. All standing poses.\nexport const POSES = [\n  { id: 'heron', name: 'The Contented Heron', x: -0.35, z: 0, clip: 'pose0', demo: 'demoL' },\n  { id: 'pine', name: 'The Apologetic Pine', x: 0, z: 0.4, clip: 'pose1', demo: 'demoF' },\n  { id: 'chair', name: 'Half-Folded Deck Chair', x: 0, z: -0.35, clip: 'pose2', demo: 'demoB' },\n  { id: 'keeper', name: 'The Lighthouse Keeper', x: 0.4, z: 0, clip: 'pose3', demo: 'demoR' },\n  { id: 'flamingo', name: 'Startled Flamingo', x: 0.35, z: 0.2, clip: 'pose4', demo: 'demoR' },\n  { id: 'goodbye', name: 'The Long Goodbye', x: -0.2, z: 0.45, clip: 'pose5', demo: 'demoF' },\n  { id: 'umbrella', name: \"Someone Else's Umbrella\", x: 0.45, z: -0.1, clip: 'pose6', demo: 'demoR' },\n  { id: 'regret', name: 'The Quiet Regret', x: -0.4, z: -0.2, clip: 'pose7', demo: 'demoL' },\n];\nEOF\ncat > src/data/unlocks.js <<'EOF'\n// Marble thresholds. A full programme pays about 15, 37, 59, 81, 103; 61 with every Tier B event cut.\nexport const UNLOCKS = [\n  { at: 6, kind: 'hat', id: 'visor', name: 'The Visor' },\n  { at: 14, kind: 'paint', id: 'sky', name: 'Sky paint' },\n  { at: 24, kind: 'hat', id: 'beret', name: 'The Beret' },\n  { at: 36, kind: 'hat', id: 'bucket', name: 'The Bucket Hat' },\n  { at: 50, kind: 'hat', id: 'perm', name: 'The Perm' },\n  { at: 60, kind: 'hat', id: 'wizard', name: 'The Wizard Hat' },\n  { at: 60, kind: 'hat', id: 'crown', name: 'The Tiny Crown' },\n];\nexport const STARTER_PAINTS = ['teal', 'coral', 'butter', 'plum'];\nexport const LATE_PAINTS = [{ at: 14, id: 'sky' }, { at: 24, id: 'moss' }, { at: 36, id: 'rose' }, { at: 50, id: 'navy' }];\nexport const HATS = [\n  { id: 'none', name: 'No Hat', at: 0 }, { id: 'visor', name: 'The Visor', at: 6 }, { id: 'beret', name: 'The Beret', at: 24 },\n  { id: 'bucket', name: 'The Bucket Hat', at: 36 }, { id: 'perm', name: 'The Perm', at: 50 }, { id: 'wizard', name: 'The Wizard Hat', at: 60 }, { id: 'crown', name: 'The Tiny Crown', at: 60 },\n];\nEOF\ncat > src/data/names.js <<'EOF'\n// The name spinner. No text entry.\nexport const FIRST = ['Gentle', 'Retired', 'Unsteady', 'Young', 'Mostly', 'Quiet', 'Patient', 'Approximate', 'Reasonable', 'Hopeful', 'Honest', 'Lean', 'Careful', 'Tentative', 'Sincere', 'Upright', 'Former', 'Modest', 'Punctual', 'Sideways'];\nexport const LAST = ['Margaret', 'Kevin', 'Paul', 'Gerald', 'Sandra', 'Doreen', 'Barry', 'Yuki', 'Priya', 'Tomas', 'Ingrid', 'Dale', 'Bernard', 'Noor', 'Hiroshi', 'Winifred', 'Oscar', 'Lupe', 'Fergus', 'Ada'];\nEOF\ncat > src/events/base.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, createWorld, groundCollider } from '../physics/world.js';\nimport { Balancer } from '../physics/balancer.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nimport { Doll, paintColour } from '../art/doll.js';\nimport { EVENTS } from '../data/events.js';\nimport { LANE_SPACING, FIXED_DT, medalFor } from '../data/config.js';\nimport { blankInput } from '../input/input.js';\nimport { tun } from '../core/tuning.js';\nimport { rng, cos, cosPick } from '../core/rng.js';\nimport { makeBot } from '../input/bot.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { line } from '../data/dialogue.js';\n\nexport const DIFFICULTY = {\n  gentle: { ankle: 1.25, dist: 0.65, rhythm: 1.4 },\n  standard: { ankle: 1, dist: 1, rhythm: 1 },\n  honest: { ankle: 0.9, dist: 1.2, rhythm: 0.8 },\n};\n\n/** Breath ring: 4 s growing, 4 s shrinking. 70%+ in sync over the last full cycle earns the bonus. */\nexport class Breath {\n  constructor() { this.t = 0; this.samples = []; this.inSync = false; this.syncShare = 0; this.period = 8; }\n  get phase() { return (this.t % this.period) / this.period; }\n  get growing() { return this.phase < 0.5; }\n  get size() { const p = this.phase; return p < 0.5 ? p * 2 : 2 - p * 2; }\n  step(dt, held, auto) {\n    this.t += dt;\n    const ok = auto || held === this.growing;\n    this.samples.push(ok ? 1 : 0);\n    const max = Math.round(this.period / FIXED_DT);\n    if (this.samples.length > max) this.samples.shift();\n    if (this.samples.length >= max) {\n      if (((this.t / FIXED_DT) | 0) % 30 === 0) {\n        let s = 0;\n        for (let i = 0; i < this.samples.length; i++) s += this.samples[i];\n        this.syncShare = s / this.samples.length;\n        this.inSync = this.syncShare >= 0.7;\n      }\n    } else if (auto) this.inSync = true;\n  }\n}\n\n/** One player or bot or ghost: everything an event needs about them. */\nexport class Lane {\n  constructor(ev, spec, index) {\n    this.ev = ev; this.id = index; this.kind = spec.kind || 'local'; this.name = spec.name || `Player ${index + 1}`;\n    this.colour = spec.colour || '#2CB5A0'; this.source = spec.source || 'any'; this.seat = spec.seat ?? index;\n    this.hat = spec.hat || 'none'; this.skill = spec.skill || 'average';\n    this.input = blankInput();\n    this.x = ev.laneX(index);\n    this.doll = null; this.bal = null; this.props = [];\n    this.score = 0; this.form = 0; this.raw = 0; this.falls = 0; this.fallen = false; this.recoverT = 0; this.ragdoll = null; this.finished = false;\n    this.breath = new Breath();\n    this.bot = this.kind === 'bot' || spec.botBrain ? makeBot(spec.skill || 'average', index) : null;\n    this.discView = { dx: 0, dz: 0, ax: 0, az: 0, zone: null, brace: null, breath: null, showAsk: true, alarm: false, frame: 0 };\n    this.clipIndex = 0; this.stats = {};\n    this.lastInputDevice = 'pad';\n  }\n  get cobX() { return this.bal ? this.bal.cobX : 0; }\n  get cobZ() { return this.bal ? this.bal.cobZ : 0; }\n  /** The dot in stick space. */\n  get dotX() { const y = this.ev.inputYaw; if (!y) return this.cobX; return rot2(this.cobX, this.cobZ, -y)[0]; }\n  get dotZ() { const y = this.ev.inputYaw; if (!y) return this.cobZ; return rot2(this.cobX, this.cobZ, -y)[1]; }\n}\n\nexport class EventBase {\n  static id = 'base';\n  /** spec: { game, tier, lanes:[laneSpec], mode:'solo'|'group'|'session'|'attract', config, god } */\n  constructor(spec) {\n    this.game = spec.game; this.tier = spec.tier || 0; this.mode = spec.mode || 'solo'; this.god = !!spec.god;\n    this.data = EVENTS[this.constructor.id];\n    this.cfg = spec.config || this.data.tiers[this.tier];\n    this.laneSpecs = spec.lanes || [{ kind: 'local', name: 'You', colour: '#2CB5A0' }];\n    this.diff = DIFFICULTY[this.game.save.settings.difficulty] || DIFFICULTY.standard;\n    this.t = 0; this.phase = 'intro'; this.inputYaw = 0; this.over = false;\n    this.group = new THREE.Group();\n    this.r = rng(this.constructor.id);\n    this.world = null; this.lanes = [];\n    this.iterations = 8;\n    this.balanceParams = {};\n    this.discs = true; this.breathOn = false; this.floorY = 0; this.seaLevel = -0.8;\n    this.barks = 0; this.stepCount = 0; this.fallsForLine = 0;\n    this.dolls = [];\n    this.props = [];\n    this.tempBodies = [];\n  }\n  get activeLanes() { return this.lanes.filter((l) => l.kind !== 'ghost'); }\n  laneX(i) {\n    const n = this.laneSpecs.length;\n    return (i - (n - 1) / 2) * LANE_SPACING;\n  }\n  /** Build world, lanes, dolls, set. */\n  build() {\n    this.world = createWorld({ iterations: this.iterations });\n    this.addGround();\n    this.laneSpecs.forEach((spec, i) => {\n      const lane = new Lane(this, spec, i);\n      this.lanes.push(lane);\n      this.buildLane(lane, i);\n    });\n    this.buildSet();\n    this.game.scene.add(this.group);\n    this.syncDolls(0);\n  }\n  addGround() { groundCollider(this.world, 0, -0.5, 0, 200, 0.5, 200); }\n  buildLane(lane, i) {\n    const doll = new Doll({ shirt: lane.colour, hat: lane.hat });\n    lane.doll = doll;\n    doll.place(lane.x, this.floorY, this.laneZ(i));\n    this.group.add(doll.root);\n    if (lane.kind === 'ghost') return;\n    lane.bal = new Balancer(this.world, i, lane.x, this.floorY, this.laneZ(i), { ...this.balanceParams, ph: 1.3 * i + this.r() * 6, diff: this.diff });\n    this.setupLane(lane);\n  }\n  laneZ() { return 0; }\n  /** Event hooks. */\n  setupLane() {}\n  buildSet() {}\n  start() {}\n  fixedEvent() {}\n  frameEvent() {}\n  onFall() {}\n  onRecover() {}\n  onFlail() {}\n  laneResult(lane) { return { form: lane.form, raw: lane.raw, stats: {} }; }\n  botInput() { return blankInput(); }\n  hudSetup() {}\n  hud() {}\n  cameraShot(snap) {}\n  isDone() { return false; }\n  extraPrompts() { return null; }\n  /** Make the set appear in-world. */\n  begin() {\n    this.phase = 'play';\n    this.t = 0;\n    for (const l of this.lanes) { l.input = blankInput(); }\n    if (this.game.input) this.game.input.resetRing();\n    this.start();\n  }\n  /** One fixed step. */\n  fixed(dt) {\n    if (this.phase === 'intro') { this.stepIdle(dt); return; }\n    if (this.phase === 'done') { this.stepIdle(dt); return; }\n    this.t += dt;\n    for (const lane of this.lanes) this.readInput(lane, dt);\n    this.fixedEvent(dt);\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.bal) continue;\n      this.applyInput(lane, dt);\n      lane.bal.pre(dt);\n    }\n    this.world.step();\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.bal) continue;\n      lane.bal.post();\n      this.checkFall(lane, dt);\n    }\n    this.afterStep(dt);\n  }\n  /** Before and after play the world keeps going with nobody asking for anything. */\n  stepIdle(dt) {\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.bal) continue;\n      lane.input.wishX = 0; lane.input.wishZ = 0;\n      lane.bal.wishX = 0; lane.bal.wishZ = 0;\n      lane.bal.pre(dt);\n    }\n    this.world.step();\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.bal) continue;\n      lane.bal.post();\n      if (lane.ragdoll) this.checkFall(lane, dt);\n    }\n    this.idleStep(dt);\n  }\n  idleStep() {}\n  afterStep() {}\n  readInput(lane, dt) {\n    if (lane.kind === 'ghost') return;\n    if (lane.kind === 'bot' || this.autoplay === lane.id) {\n      this.botStep(lane, dt);\n      return;\n    }\n    this.game.input.sample(lane.source, lane.input, dt);\n    if (lane.input.device) lane.lastInputDevice = lane.input.device;\n  }\n  botStep(lane, dt) {\n    if (!lane.bot) lane.bot = makeBot(lane.skill, lane.id);\n    lane.bot.observe(lane, dt);\n    const out = this.botInput(lane, this.t, lane.bot, dt);\n    if (out) Object.assign(lane.input, out);\n  }\n  applyInput(lane, dt) {\n    const i = lane.input, b = lane.bal;\n    if (this.inputYaw) { const [wx, wz] = rot2(i.wishX, i.wishZ, this.inputYaw); b.wishX = wx; b.wishZ = wz; } else { b.wishX = i.wishX; b.wishZ = i.wishZ; }\n    if (this.breathOn) {\n      lane.breath.step(dt, !!i.breathe, this.game.save.settings.autoBreathe || lane.breathAuto);\n      b.breathScale = lane.breath.inSync ? 0.6 : 1;\n    } else b.breathScale = 1;\n    if (i.flail && !lane.fallen) {\n      if (b.flail()) {\n        lane.doll.rig.once('flail');\n        this.game.audio.sfx('boing');\n        this.flailed(lane);\n      }\n    }\n  }\n  flailed(lane) { this.onFlail(lane); }\n  checkFall(lane, dt) {\n    const b = lane.bal;\n    if (lane.fallen) {\n      lane.recoverT -= dt;\n      if (lane.ragdoll) lane.ragdoll.sync();\n      if (lane.recoverT <= 0) this.recoverLane(lane);\n      return;\n    }\n    if (!b.enabled) return;\n    const limit = tun.fallAngle * Math.PI / 180;\n    if (b.lean >= limit) {\n      if (this.god) {\n        // God mode: nobody falls. The core is quietly stood back up.\n        b.recover();\n        return;\n      }\n      this.fallLane(lane);\n    }\n  }\n  fallLane(lane) {\n    if (lane.fallen) return;\n    const b = lane.bal;\n    lane.fallen = true; lane.falls++; lane.recoverT = tun.recoverTime;\n    const v = b.body.linvel();\n    b.disable();\n    lane.doll.ragdolled = true;\n    const kick = { x: lane.bal.leanX * 0.04, y: 0.02, z: lane.bal.leanZ * 0.04 };\n    lane.ragdoll = new Ragdoll(this.world, lane.doll, this.group, { x: v.x, y: v.y, z: v.z }, kick);\n    this.game.audio.sfx('fall');\n    this.game.input.rumble(0.9, 0.7, 320, lane.input.padIndex >= 0 ? lane.input.padIndex : undefined);\n    const c = lane.ragdoll.centre();\n    this.game.comic && this.game.comic.pop('CLACK!', c.x, c.y + 1.2, c.z);\n    this.game.rig && this.game.rig.shake(0.08);\n    this.onFall(lane);\n    if (lane.kind === 'local') this.game.onFloorExercise && this.game.onFloorExercise();\n  }\n  recoverLane(lane) {\n    lane.fallen = false;\n    if (lane.ragdoll) { lane.ragdoll.end(); lane.ragdoll = null; }\n    lane.doll.ragdolled = false;\n    lane.bal.recover();\n    lane.doll.place(lane.bal.fx, lane.bal.fy, lane.bal.fz);\n    lane.doll.rig.once('land');\n    this.game.audio.sfx('spring');\n    this.onRecover(lane);\n  }\n  /** Force a fall (Dev Mode, tests). */\n  forceFall(i = 0) { const l = this.lanes[i]; if (l && l.bal && !l.fallen) { const g = this.god; this.god = false; this.fallLane(l); this.god = g; } }\n  syncDolls(dt) {\n    for (const lane of this.lanes) {\n      const d = lane.doll;\n      if (!d) continue;\n      if (lane.kind !== 'ghost' && lane.bal && !lane.fallen && !this.customPose) {\n        const q = lane.bal.body.rotation();\n        d.setLean(q.x, q.y, q.z, q.w);\n        d.place(lane.bal.fx, lane.bal.fy, lane.bal.fz);\n      }\n      d.update(dt);\n      const v = lane.discView;\n      v.dx = lane.dotX; v.dz = lane.dotZ;\n      v.ax = lane.input.wishX; v.az = lane.input.wishZ;\n      v.alarm = lane.bal ? lane.bal.lean > 0.5 : false;\n      v.breath = this.breathOn ? { size: lane.breath.size, growing: lane.breath.growing, inSync: lane.breath.inSync } : null;\n    }\n  }\n  frame(dt) {\n    this.syncDolls(dt);\n    this.frameEvent(dt);\n    if (this.phase === 'play') this.hud(dt);\n  }\n  /** Sets are built under this.group. */\n  dispose() {\n    for (const lane of this.lanes) {\n      if (lane.ragdoll) { lane.ragdoll = null; }\n    }\n    this.game.scene.remove(this.group);\n    if (this.world) { this.world.free(); this.world = null; }\n    this.group.clear();\n  }\n  bodies() { return this.world ? this.world.bodies.len() : 0; }\n  /** A short non-blocking remark from whoever is teaching. */\n  bark(who, situation, auto = 2.6, gap = 7) {\n    if (this.mode === 'session' || this.mode === 'attract') return;\n    if (this.t - (this.lastBark ?? -99) < gap) return;\n    this.lastBark = this.t;\n    const text = line(who, situation);\n    if (text) this.game.speech.say(who, text, { auto, top: true });\n  }\n  medal(lane) { return medalFor(lane.form); }\n  /** Standing props are lit, chunky, inked and at most slightly alive. */\n  ramp(a, b, k) { return a + (b - a) * Math.max(0, Math.min(1, k)); }\n}\nexport { RAPIER, cos, cosPick };\nEOF\ncat > src/input/bot.js <<'EOF'\nimport { mulberry32 } from '../core/rng.js';\n\n// The human model behind every skill number: a delayed correction with noise.\nexport const SKILLS = {\n  sharp: { delay: 0.16, gain: 1.4, gainLoad: 0.7, noise: 0, lag: 0.12, speedErr: 0.3, timing: 0.028 },\n  average: { delay: 0.26, gain: 1.0, gainLoad: 0.55, noise: 0.03, lag: 0.28, speedErr: 0.8, timing: 0.055 },\n  clumsy: { delay: 0.38, gain: 0.8, gainLoad: 0.45, noise: 0.07, lag: 0.5, speedErr: 1.4, timing: 0.095 },\n};\n\nexport function makeBot(skill, seedExtra = 0) { return new Bot(skill, seedExtra); }\n\nexport class Bot {\n  constructor(skill = 'average', seedExtra = 0) {\n    this.skillName = skill; this.s = SKILLS[skill] || SKILLS.average;\n    this.r = mulberry32(((skill.length * 7919) ^ (seedExtra * 104729) ^ 0xBEEF) >>> 0);\n    this.hist = []; this.t = 0; this.dotX = 0; this.dotZ = 0;\n    this.data = {};\n    this.ph = this.r() * 6.28; this.ph2 = this.r() * 6.28;\n  }\n  /** See the dot, a moment late. */\n  observe(lane, dt) {\n    this.t += dt;\n    this.hist.push(lane.dotX, lane.dotZ);\n    const n = Math.max(1, Math.round(this.s.delay / dt));\n    if (this.hist.length > n * 2) this.hist.splice(0, this.hist.length - n * 2);\n    this.dotX = this.hist[0]; this.dotZ = this.hist[1];\n  }\n  /** wish = goal + gain × (goal − dot) + noise × sin(...) */\n  steer(gx, gz, load = false) {\n    const g = load ? this.s.gainLoad : this.s.gain, n = this.s.noise;\n    let x = gx + g * (gx - this.dotX) + n * Math.sin(this.t * 2.3 + this.ph) * 3;\n    let z = gz + g * (gz - this.dotZ) + n * Math.sin(this.t * 1.9 + this.ph2) * 3;\n    const m = Math.hypot(x, z);\n    if (m > 1) { x /= m; z /= m; }\n    return [x, z];\n  }\n  /** A gaussian-ish timing error in seconds. */\n  timing() { return (this.r() + this.r() + this.r() - 1.5) * 1.15 * this.s.timing * 1.0; }\n  chance(p) { return this.r() < p; }\n}\nEOF\n","description":"Write event data, programme tables and the event base class"}}}
