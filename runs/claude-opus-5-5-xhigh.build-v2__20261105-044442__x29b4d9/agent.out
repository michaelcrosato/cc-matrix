;\n}\n\nfredoka-latin-400-normal.woff2\nfredoka-latin-500-normal.woff2\nfredoka-latin-600-normal.woff2\nfredoka-latin-700-normal.woff2\n  \"version\": \"5.3.0\",\n  \"version\": \"0.28.2\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01RCeqab9uvSPXuK1qffsQAm","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
