n showBootMessage(text, sub) {\n  let b = document.getElementById('boot');\n  if (!b) { b = document.createElement('div'); b.id = 'boot'; b.className = 'boot'; document.body.append(b); }\n  b.innerHTML = '';\n  const t = document.createElement('div'); t.textContent = text; b.append(t);\n  if (sub) { const s = document.createElement('div'); s.style.fontSize = '3.4rem'; s.textContent = sub; b.append(s); }\n}\nfunction hideBoot() { const b = document.getElementById('boot'); if (b) b.remove(); }\n\nfunction showBootFailure(e) {\n  const msg = (e && e.message) || String(e);\n  showBootMessage(`${TITLE} needs WebGPU or WebGL2.`, msg);\n  if (window.AIHub && window.AIHub.active) window.AIHub.fail(msg);\n}\n\nasync function main() {\n  setupPage();\n  showBootMessage('Stretching...');\n  const game = new Game(params);\n  if (params.test) installTestHooks(game, THREE);\n  window.addEventListener('error', (e) => game.noteError(e.error || e.message));\n  window.addEventListener('unhandledrejection', (e) => game.noteError(e.reason));\n  const AIHub = window.AIHub;\n  if (AIHub && AIHub.active) {\n    const pConnect = AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n    await game.bootEngine();\n    hideBoot();\n    const info = await pConnect;\n    if (info) runSession(game, info); else runStandalone(game);\n  } else {\n    await game.bootEngine();\n    hideBoot();\n    runStandalone(game);\n  }\n  if (!params.manual) game.loop.start();\n}\nmain().catch(showBootFailure);\nEOF\ncat > src/core/testHooks.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport { FIXED_DT } from '../data/config.js';\nimport { tun, resetTuning } from './tuning.js';\nimport { EVENTS } from '../data/events.js';\nimport { blankInput } from '../input/input.js';\nimport { flowGoto } from '../game/flow.js';\nimport { renderProbe } from '../audio/probe.js';\n\n/** window.__TEST__: state, advance, bots through the stubbed pad, goto. Only with ?test=1. */\nexport function installTestHooks(game, THREE) {\n  const pad = () => {\n    window.__pads = window.__pads || [];\n    if (!window.__pads[0]) window.__pads[0] = makePad();\n    return window.__pads[0];\n  };\n  function makePad() {\n    return { connected: true, mapping: 'standard', index: 0, id: 'stub', axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })), vibrationActuator: { playEffect() { window.__rumbles = (window.__rumbles || 0) + 1; return Promise.resolve(); } } };\n  }\n  let botSkill = null, botKeys = false;\n  const out = blankInput();\n  game.beforePoll = (dt) => {\n    if (!botSkill) return;\n    const run = game.mode && game.mode.botDrive ? game.mode : null;\n    const ev = game.currentEvent;\n    const p = pad();\n    const setB = (i, on, val) => { p.buttons[i].pressed = !!on; p.buttons[i].value = val !== undefined ? val : (on ? 1 : 0); };\n    let result = null;\n    if (ev && ev.phase === 'play' && !game.paused) {\n      const lane = ev.lanes.find((l) => l.kind === 'local');\n      if (lane) {\n        if (!lane.testBot) { lane.testBot = ev.makeTestBot ? ev.makeTestBot(botSkill, lane) : ev.constructor.makeBot ? null : null; }\n        const bot = lane.testBot || (lane.testBot = makeTestBot(botSkill, lane.id));\n        bot.observe(lane, dt);\n        const saved = lane.input;\n        Object.assign(out, blankInput());\n        lane.input = out;\n        const res = ev.botInput(lane, ev.t, bot, dt);\n        lane.input = saved;\n        result = res ? Object.assign(out, res) : out;\n      }\n    } else if (run) {\n      result = game.mode.botDrive(botSkill, dt, out);\n    }\n    if (result) {\n      p.axes[0] = result.wishX || 0; p.axes[1] = result.wishZ || 0;\n      if (result.moveX !== undefined && result.useMove) { p.axes[0] = result.moveX; p.axes[1] = result.moveZ; }\n      setB(6, (result.footL || 0) > 0.5 || result.footLPressed, Math.max(result.footL || 0, result.footLPressed ? 1 : 0));\n      setB(7, (result.footR || 0) > 0.5 || result.footRPressed, Math.max(result.footR || 0, result.footRPressed ? 1 : 0));\n      setB(0, result.hop || result.hopPressed);\n      setB(2, result.flail);\n      setB(5, result.breathe);\n    } else {\n      p.axes[0] = 0; p.axes[1] = 0;\n      for (const i of [0, 2, 5, 6, 7]) setB(i, false);\n    }\n  };\n  let makeTestBot = null;\n  import('../input/bot.js').then((m) => { makeTestBot = m.makeBot; });\n\n  const api = {\n    game, THREE, tun, resetTuning, RAPIER,\n    get settings() { return game.save.settings; },\n    get tuning() { return tun; },\n    REVISION: THREE.REVISION,\n    rapierVersion: () => RAPIER.version(),\n    advance(seconds) { game.loop.advance(seconds); return api.state(); },\n    bot(skill) {\n      botSkill = skill;\n      if (!skill) {\n        const p = pad();\n        p.axes.fill(0);\n        for (const b of p.buttons) { b.pressed = false; b.value = 0; }\n      }\n      return skill;\n    },\n    keysBot(on) { botKeys = on; },\n    goto(screen, args) { flowGoto(game, screen, args); return api.state(); },\n    press(i, on = true) { const p = pad(); p.buttons[i].pressed = on; p.buttons[i].value = on ? 1 : 0; },\n    /** Tap a pad button through the real path: down for two ticks, up for two. */\n    tap(i) { const p = pad(); p.buttons[i].pressed = true; p.buttons[i].value = 1; game.loop.advance(FIXED_DT * 3); p.buttons[i].pressed = false; p.buttons[i].value = 0; game.loop.advance(FIXED_DT * 3); return api.state(); },\n    stick(x, z) { const p = pad(); p.axes[0] = x; p.axes[1] = z; },\n    renderProbe,\n    state() {\n      const ev = game.currentEvent;\n      const pr = game.save.profile;\n      const top = game.ui && game.ui.top;\n      const a = game.audio;\n      return {\n        screen: top ? top.name : game.modeName,\n        mode: game.modeName,\n        stack: game.ui ? game.ui.stack.map((s) => s.name) : [],\n        focus: top ? top.focus : -1, items: top ? top.items.length : 0,\n        attract: game.attract,\n        paused: game.paused,\n        day: pr ? pr.today.day : 0,\n        step: pr ? pr.stepsDone : 0,\n        totalSteps: game.programme.totalSteps,\n        profile: pr ? pr.name : null,\n        marbles: pr ? pr.marbles : 0,\n        stamps: pr ? pr.stamps.length : 0,\n        levelled: pr ? pr.levelled : false,\n        checkin: pr ? pr.today.checkin : false,\n        done: pr ? pr.today.done.slice() : [],\n        tilt: game.phys ? game.phys.tiltDeg : 0,\n        rest: game.phys ? game.phys.restNow : 0,\n        wobbleAge: pr ? pr.today.age : null,\n        ages: pr ? pr.ages.map((x) => x.age) : [],\n        speech: game.speech && game.speech.line ? game.speech.line.text : null,\n        stage: game.mode && game.mode.stage,\n        event: ev ? {\n          id: ev.constructor.id, tier: ev.tier, phase: ev.phase, t: ev.t, bodies: ev.bodies(),\n          lanes: ev.lanes.map((l) => ({\n            kind: l.kind, name: l.name, leanX: l.bal ? l.bal.leanX : 0, leanZ: l.bal ? l.bal.leanZ : 0, cob: [l.cobX, l.cobZ], fallen: l.fallen, falls: l.falls,\n            form: ev.laneResult(l).form, raw: ev.laneResult(l).raw, props: l.props.length, device: l.input.device, wish: [l.input.wishX, l.input.wishZ], footL: l.input.footL, footR: l.input.footR,\n          })),\n        } : null,\n        results: game.mode && game.mode.results ? game.mode.results.map((r) => ({ name: r.lane.name, form: r.form, raw: r.raw, big: r.big })) : null,\n        input: { lastDevice: game.input.lastDevice, glyphSet: game.save.settings.glyphs, idle: game.input.idle, lastRumble: game.input.lastRumble },\n        audio: { state: a.state, music: a.mix ? a.mix.levels.music : 0, sfx: a.mix ? a.mix.levels.sfx : 0, voice: a.mix ? a.mix.levels.voice : 0, musicSetting: game.save.settings.music, track: a.musicId, detune: a.detuneNow(), tiltDeg: a.tiltDeg },\n        render: { backend: game.backend, frames: game.frames, lost: game.renderLost, mixer: game.currentEvent && game.currentEvent.lanes[0] && game.currentEvent.lanes[0].doll ? game.currentEvent.lanes[0].doll.rig.time : 0, clip: game.currentEvent && game.currentEvent.lanes[0] && game.currentEvent.lanes[0].doll ? game.currentEvent.lanes[0].doll.rig.currentName : null },\n        errors: game.errors.slice(),\n      };\n    },\n    startEvent(id, tier = 0, opts = {}) { flowGoto(game, 'event', { id, tier, ...opts }); return api.state(); },\n    EVENTS,\n  };\n  window.__TEST__ = api;\n}\nEOF\ncat > tools/build.mjs <<'EOF'\nimport { build } from 'esbuild';\nimport { readFileSync, writeFileSync, existsSync } from 'node:fs';\nimport { createHash } from 'node:crypto';\nimport { dirname, join, basename, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { aboutFromInterview } from './about.mjs';\n\nconst here = dirname(fileURLToPath(import.meta.url));\nconst dev = resolve(here, '..');\nprocess.chdir(dev);\nconst root = resolve(dev, '..');\nconst STEM = basename(dev);\nexport const OUT = join(root, `${STEM}.html`);\nconst INTERVIEW = join(root, 'exit-interview.json');\n\n// One source of truth for the About screen: the exit interview, when it exists.\nwriteFileSync('src/data/about.js', aboutFromInterview(existsSync(INTERVIEW) ? JSON.parse(readFileSync(INTERVIEW, 'utf8')) : null));\n\nconst session = readFileSync('vendor/session.js', 'utf8').replace(/\\r\\n/g, '\\n');\nconst END = \"})(typeof window !== 'undefined' ? window : globalThis);\";\nconst hash = createHash('sha256').update(session.slice(session.indexOf('/*! aihub-session '), session.indexOf(END) + END.length)).digest('hex');\nif (hash !== '529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a') throw new Error('not the released hub client');\nconst r = await build({ entryPoints: ['src/main.js'], bundle: true, format: 'iife', target: 'es2022', minify: true, write: false, legalComments: 'none', loader: { '.css': 'text' }, logLevel: 'warning' });\nconst js = r.outputFiles[0].text.replace(/<\\/script/gi, '<\\\\/script');\nconst font = (w) => readFileSync(`node_modules/@fontsource/fredoka/files/fredoka-latin-${w}-normal.woff2`).toString('base64');\nconst faces = [400, 500, 600, 700].map((w) => `@font-face{font-family:Fredoka;font-style:normal;font-weight:${w};font-display:block;src:url(data:font/woff2;base64,${font(w)}) format('woff2')}`).join('');\nconst cfg = readFileSync('src/data/config.js', 'utf8');\nconst TITLE = cfg.match(/TITLE = '([^']+)'/)[1];\nconst HOWTO = cfg.match(/HOWTO = '([^']+)'/)[1];\nconst GOAL = cfg.match(/GOAL = '([^']+)'/)[1];\nconst METAS = [\n  ['hub:session', '1'], ['hub:session-players', '1-4'], ['hub:session-mode', 'ghost'], ['hub:session-minutes', '3'],\n  ['hub:session-goal', GOAL], ['hub:session-howto', HOWTO], ['hub:type', 'Game'], ['hub:players', '1-4'], ['hub:source', 'Wii Fit'],\n].map(([n, c]) => `<meta name=\"${n}\" content=\"${c}\">`).join('');\nwriteFileSync(OUT, ['<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><script>', session, '</script>',\n  METAS, '<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">', `<title>${TITLE}</title><style>${faces}</style></head><body>`,\n  '<script>', js, '</script></body></html>'].join(''));\nif (process.argv.includes('-v')) console.log(`built ${OUT} ${(readFileSync(OUT).length / 1e6).toFixed(2)} MB`);\nEOF\ncat > tools/about.mjs <<'EOF'\n// Writes src/data/about.js from the exit interview, so the three places can't disagree.\nconst KEYS = {\n  date: 'Date', source: 'Source', plan: 'Plan', genre: 'Genre', perspective: 'Perspective', tech: 'Tech', artDirection: 'Art Direction', animation: 'Animation',\n  audio: 'Audio', online: 'Online', testing: 'Testing', research: 'Research', environment: 'Environment', model: 'Model', usage: 'Usage',\n};\nconst blank = {\n  sourceInformation: Object.fromEntries(Object.keys(KEYS).map((k) => [k, k === 'usage' ? 'added on import' : 'unknown'])),\n  testingFeedback: ['unknown', 'unknown', 'unknown', 'unknown'], engineFeedback: ['unknown', 'unknown', 'unknown', 'unknown', 'unknown', 'unknown'], promptFeedback: ['unknown', 'unknown', 'unknown', 'unknown'],\n};\nexport function aboutFromInterview(j) {\n  const d = j || blank;\n  return `// Generated by tools/build.mjs from the exit interview.\nexport const ABOUT = ${JSON.stringify({ sourceInformation: d.sourceInformation, testingFeedback: d.testingFeedback, engineFeedback: d.engineFeedback, promptFeedback: d.promptFeedback }, null, 1)};\nexport const SOURCE_LABELS = ${JSON.stringify(KEYS)};\n`;\n}\nEOF\ncat > src/audio/probe.js <<'EOF'\nimport { Mix } from './engine.js';\nimport { TRACKS, STINGS } from './tracks.js';\nimport { emitBar } from './sequencer.js';\nimport { INSTRUMENTS } from './instruments.js';\nimport { SFX } from './sfx.js';\nimport { speak, VOICES } from './voice.js';\nimport { mulberry32 } from '../core/rng.js';\n\n/** Render anything with an OfflineAudioContext and read the signal. Used by the audio tests. */\nexport async function renderProbe(kind, name, seconds = 3, levels = [100, 100, 100]) {\n  const rate = 22050;\n  const ctx = new OfflineAudioContext(2, Math.ceil(rate * seconds), rate);\n  const mix = new Mix(ctx);\n  mix.setLevels(...levels);\n  let blips = 0;\n  if (kind === 'track') {\n    const track = TRACKS[name], stepDur = 60 / track.bpm / 4;\n    let bar = 0, t0 = 0.02;\n    while (t0 < seconds) {\n      emitBar(track, bar, t0, stepDur, (t, inst, midi, len, vel) => { if (t < seconds) INSTRUMENTS[inst](ctx, mix.music, t, midi, len, vel, 0); });\n      t0 += stepDur * 16; bar++;\n    }\n  } else if (kind === 'sting') mix.sting(name, 0.02);\n  else if (kind === 'sfx') { SFX[name](mix, 0.02, {}); }\n  else if (kind === 'voice') {\n    const text = 'Please step on. Not on me. On the island! Do you trust your knees?';\n    blips = speak(mix, mix.voice, name, text, 0.02, mulberry32(11)).blips;\n  } else if (kind === 'instrument') INSTRUMENTS[name](ctx, mix.sfx, 0.02, 64, 0.5, 0.7, 0);\n  const b = await ctx.startRendering();\n  const d = b.getChannelData(0);\n  let peak = 0, sum = 0, finite = true;\n  for (let i = 0; i < d.length; i++) { const v = d[i]; if (!Number.isFinite(v)) finite = false; const a = Math.abs(v); if (a > peak) peak = a; sum += v * v; }\n  return { peak, rms: Math.sqrt(sum / d.length), finite, blips, seconds };\n}\nexport const AUDIO_LISTS = { tracks: Object.keys(TRACKS), stings: Object.keys(STINGS), sfx: Object.keys(SFX), voices: Object.keys(VOICES), instruments: Object.keys(INSTRUMENTS) };\nEOF\ncat > src/game/flow.js <<'EOF'\nimport { EventRun } from './eventRun.js';\nexport function runStandalone(game) { game.modeName = 'title'; }\nexport function flowGoto(game, screen, args = {}) {\n  if (screen === 'event') {\n    const lanes = args.lanes || [{ kind: 'local', name: 'You', colour: '#2CB5A0', source: 'any' }];\n    game.setMode(new EventRun(game, { id: args.id, tier: args.tier || 0, lanes, mode: args.mode || 'solo', skipIntro: args.skipIntro !== false, skipCountdown: args.skipCountdown !== false, config: args.config, god: args.god, onResult: args.onResult }), 'event');\n  }\n}\nEOF\ncat > src/game/session.js <<'EOF'\nimport { runStandalone } from './flow.js';\nexport function runSession(game, info) { runStandalone(game); return info; }\nEOF\nprintf \"export const ABOUT = {};\\nexport const SOURCE_LABELS = {};\\n\" > src/data/about.js\ncat > /tmp/x 2>/dev/null <<'EOF'\nEOF\nrm -f /tmp/x\nnode tools/build.mjs -v 2>&1 | tail -20","description":"Write main entry, test hooks, build tool and a first build","timeout":120000}}}
