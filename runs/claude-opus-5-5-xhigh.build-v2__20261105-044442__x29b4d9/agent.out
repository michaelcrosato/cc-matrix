akes you whip and fall.\n    let best = null;\n    for (const it of this.items) {\n      if (it.lane !== lane || it.state !== 'fly' || it.kind === 'urchin') continue;\n      const left = it.T - it.t + bot.s.lag * 0.4;\n      if (left < 1.05 && left > -0.12 && (!best || left < best.left)) best = { it, left };\n    }\n    let gx = 0, gz = 0;\n    // Lean away from an urchin about to land in the hat.\n    for (const it of this.items) {\n      if (it.lane === lane && it.state === 'fly' && it.kind === 'urchin' && it.T - it.t < 0.7 && it.T - it.t > 0) {\n        const ax = it.sx - lane.x, az = it.sz, m = Math.hypot(ax, az) || 1;\n        gx = -(ax / m) * 0.8; gz = -(az / m) * 0.8;\n      }\n    }\n    if (best) {\n      const ml = lane.bal.maxLean;\n      const reach = 1.5 * Math.sin(ml);\n      gx = (best.it.sx - lane.x) / reach; gz = best.it.sz / reach;\n      const m = Math.hypot(gx, gz);\n      if (m > 1) { gx /= m; gz /= m; }\n--- keys plates tests\ntools/test.mjs:129:const EVENT_IDS = ['poses', 'cairn', 'stillWater', 'logReps', 'plank', 'tug', 'stepClass', 'plates', 'islandLoop', 'fruitHat', 'roomService', 'springbo\ntools/test.mjs:130:const RUN_FOR = { poses: 70, cairn: 62, stillWater: 62, logReps: 80, plank: 62, tug: 150, stepClass: 110, plates: 62, islandLoop: 180, fruitHat: 62, ro\ntools/test.mjs:161:    if (!['raft', 'islandLoop', 'springboard', 'plank', 'stillWater', 'stepClass', 'plates'].includes(id)) {\ntools/test.mjs:216:    run('plate shards', 'plates', (ev, l) => { for (let i = 0; i < 12; i++) { l.plates[i % 3].energy = 0.001; T.advance(1); if (l.plates[i % 3].state !\ntools/test.mjs:476:    if (id === 'plates') out.share = r.raw;\ntools/test.mjs:544:  const pl = [await play('plates', 'sharp', 1), await play('plates', 'sharp', 2)];\ntools/test.mjs:545:  const ps = [await play('plates', 'clumsy', 1), await play('plates', 'clumsy', 2)];\ntools/test.mjs:550:    T.startEvent('plates', 0, {});\ntools/test.mjs:561:        const low = l.plates.filter((p) => p.s