ar = !prev;\n    if (!prev || prev.form < scaled) p.medals[key] = { form: Math.round(scaled), medal: m.id };\n    const out = { medal: m, firstClear, marbles: 0, notch: false, tierOpened: null, unlocks: [] };\n    p.seen[id] = true;\n    p.classes++;\n    p.minutes += activeSec / 60;\n    if (tier === 0 && scaled >= 65 && (p.tiers[id] ?? 0) < 1 && EVENTS[id].tiers.length > 1) { p.tiers[id] = 1; out.tierOpened = 1; }\n    if (tier === 1 && scaled >= 85 && (p.tiers[id] ?? 0) < 2 && EVENTS[id].tiers.length > 2) { p.tiers[id] = 2; out.tierOpened = 2; }\n    if (programme && !p.today.done.includes(id) && this.classesToday().includes(id)) {\n      p.today.done.push(id);\n      if (p.today.day <= DAYS.length) { p.stepsDone++; out.notch = true; }\n    }\n    out.marbles = marblesFor(activeSec / 60, m.bonus, firstClear, tun.marblesPerMinute);\n    this.addMarbles(out.marbles, m.id, out);\n    this.syncIsland();\n    this.game.save.write();\n--- src/game/devmode.js 134,144\n  p.stepsDone = steps;\n  p.levelled = day > 5;\n  p.tutorialDone = true;\n  p.day = day;\n  p.today = { day, checkin: false, age: null, done: [], question: false };\n  for (let d = 1; d < Math.min(day, 6); d++) for (const id of DAYS[d - 1].classes) p.seen[id] = true;\n  g.programme.syncIsland();\n  g.phys.snapTilt();\n  g.save.write();\n}\nfunction forceGust(g, lane) {\n--- src/events/fruitHat.js 82,106\n    this.bark('trudy', 'fruit_start', 3.2, 0);\n  }\n  launch(lane, kind) {\n    const c = this.cfg;\n    const radius = c.radius * tun.landingRadius;\n    const a = this.r() * Math.PI * 2, r = Math.sqrt(this.r()) * radius;\n    const sx = lane.x + Math.cos(a) * r, sz = Math.sin(a) * r;\n    const ox = lane.x - 5, oy = 0.6, oz = -5;\n    const T = 1.5, g = tun.gravity;\n    const props = {\n      fruit: { mass: c.mass * tun.fruitMass, value: 1, rad: 0.075 },\n      boot: { mass: c.mass * 1.7 * tun.fruitMass, value: 1, rad: 0.085 },\n      pineapple: { mass: c.mass * 2.6 * tun.fruitMass, value: 5, rad: 0.1