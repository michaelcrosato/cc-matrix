{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjnGbVKY7dmX7sZuJ8hj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019Q2SHevT7PfbCeoc15mAVW","name":"Bash","input":{"command":"cat > src/events/logReps.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { post, crate, WOOD_D, WOOD, RED, TEAL, CREAM, tree } from '../art/props.js';\nimport { Walrus } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst TEMPO = { down: 2, pause: 0.5, up: 2, rest: 0.5 };\nconst REP = TEMPO.down + TEMPO.pause + TEMPO.up + TEMPO.rest;\nconst DEG = Math.PI / 180;\n\n/** A log on your shoulders, a tempo ribbon, and a walrus who can't count. */\nexport class LogReps extends EventBase {\n  static id = 'logReps';\n  constructor(spec) {\n    super(spec);\n    this.balanceParams = { margin: 0.8, ankleMax: 6 };\n    this.seaLevel = -3;\n    this.rep = 0; this.repT = 0; this.repLen = REP;\n    this.totalReps = this.cfg.reps + (this.cfg.noBonus ? 0 : 2);\n    this.bonusFrom = this.cfg.noBonus ? 99 : this.cfg.reps;\n    this.total = this.totalReps * REP;\n    this.finished = false; this.saidLast = false;\n  }\n  setupLane(lane) {\n    lane.depth = 0; lane.bandT = 0; lane.zoneT = 0; lane.repN = 0; lane.score = 0; lane.maxScore = 0; lane.offset = 0; lane.logFall = 0; lane.logLost = false; lane.lastRepScore = 0;\n    lane.logBody = null;\n    const log = lane.logMesh = G('log', 0, 1.18, -0.08);\n    add(log, M(geo.cyl(0.11, 0.11, 2.3, 14), 0x9A6E3E, 0, 0, 0, { rot: [0, 0, Math.PI / 2] }), M(geo.cyl(0.115, 0.115, 0.02, 14), 0xE4C491, 1.15, 0, 0, { rot: [0, 0, Math.PI / 2], shadow: false }), M(geo.cyl(0.115, 0.115, 0.02, 14), 0xE4C491, -1.15, 0, 0, { rot: [0, 0, Math.PI / 2], shadow: false }));\n    lane.doll.root.add(log);\n    lane.doll.rig.scrub('squat', 0, { fade: 0 });\n    lane.bandHW = 0.16;\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length, w = Math.max(12, n * 3.2 + 8);\n    add(g, M(geo.box(w + 12, 1, 14), 0xE6CDA0, 0, -0.5, -1));\n    for (let i = 0; i < 8; i++) add(g, M(geo.box(w + 12, 0.01, 0.1), 0xD2B684, 0, 0.005, -7 + i * 2));\n    add(g, post(3, 0.16, WOOD_D, -w / 2 + 0.5, 0, -4), post(3, 0.16, WOOD_D, w / 2 - 0.5, 0, -4), M(geo.cyl(0.13, 0.13, w, 12), WOOD, 0, 2.9, -4, { rot: [0, 0, Math.PI / 2] }));\n    for (let i = 0; i < 4; i++) add(g, M(geo.cyl(0.22, 0.22, 2.6, 12), WOOD_D, -w / 2 + 1.8 + (i % 2) * 0.1, 0.22 + (i > 1 ? 0.38 : 0), -2.6 - (i % 2) * 0.45, { rot: [0, 0, Math.PI / 2] }));\n    const c = crate(1); c.position.set(w / 2 - 1.2, 0, -2); g.add(c);\n    for (const [x, z] of [[-w / 2 - 1.5, -5.5], [w / 2 + 1, -6], [2, -8]]) { const t = tree(2.6, 1.3); t.position.set(x, 0, z); g.add(t); }\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(this.lanes[0].x - 2.3, 0, -0.6);\n    this.walrus.root.rotation.y = 0.45;\n    g.add(this.walrus.root);\n    this.walrus.rig.loop('bounce');\n    this.game.setBackdrop(60, -130);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(7.6, (n - 1) * 3.2 + 3);\n    const px = n > 1 ? 0 : -1.5;\n    this.game.rig.shot(px, 2, d, n > 1 ? 0 : -0.7, 1.05, 0, { snap, rate: 4 });\n    this.inputYaw = n > 1 ? 0 : Math.atan2(px + 0.7, d);\n  }\n  hudSetup(hud) {\n    const wrap = h('div.tag', { style: 'position:relative;width:9rem;height:38rem;padding:0;overflow:hidden' });\n    this.bandEl = h('div', { style: 'position:absolute;left:0;right:0;background:#9BE08F;border-top:.4rem solid #2F8F46;border-bottom:.4rem solid #2F8F46' });\n    this.depthEl = h('div', { style: 'position:absolute;left:0;right:0;height:1rem;background:#1A1420' });\n    wrap.append(this.bandEl, this.depthEl);\n    this.ribbon = hud.addWidget(wrap, true);\n    hud.setScore(0, 'Rep');\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'intro'), { auto: 3, top: true }); }\n  tempoAt(t) {\n    // Where the ribbon is, 0 up to 1 down, at this time into a rep.\n    const k = tun.repTempo;\n    const down = TEMPO.down / k, pause = TEMPO.pause / k, up = TEMPO.up / k;\n    if (t < down) return t / down;\n    if (t < down + pause) return 1;\n    if (t < down + pause + up) return 1 - (t - down - pause) / up;\n    return 0;\n  }\n  get repLength() { return REP / tun.repTempo; }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.repT += dt;\n    const fat = Math.min(1, this.rep / Math.max(1, this.totalReps - 1));\n    const sway = this.ramp(c.sway[0], c.sway[1], fat), tremor = this.ramp(c.tremor[0], c.tremor[1], fat);\n    const target = this.tempoAt(this.repT);\n    const hw = this.ramp(c.band[0], c.band[1], fat);\n    this.target = target; this.bandHW = hw;\n    const shake = this.ramp(0.015, 0.07, fat) * Math.sin(this.t * 19);\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      const b = lane.bal, i = lane.input;\n      b.sway = sway; b.tremor = tremor;\n      if (i.device === 'kbm' && lane.kind === 'local') {\n        const both = i.footL > 0.5 && i.footR > 0.5;\n        lane.depth = Math.max(0, Math.min(1, lane.depth + (both ? 1 : -1) * (dt / (TEMPO.down / tun.repTempo))));\n      } else lane.depth = (i.footL + i.footR) / 2;\n      const measured = lane.depth + shake;\n      // The log is a rule, not a contact: a number that grows with sideways lean.\n      if (!lane.logLost && !lane.fallen) {\n        const deg = b.leanX / DEG;\n        if (Math.abs(deg) > 6) lane.offset += 0.05 * (Math.abs(deg) - 6) * Math.sign(deg) * dt;\n        else lane.offset += -Math.sign(lane.offset) * Math.min(Math.abs(lane.offset), 0.03 * dt);\n        b.extX += 0.06 * 9.81 * lane.offset;\n        if (Math.abs(lane.offset) >= 0.5) this.dropLog(lane);\n      }\n      if (!lane.fallen && !lane.logLost) {\n        if (Math.abs(measured - target) < hw) lane.bandT += dt;\n        if (Math.hypot(lane.dotX, lane.dotZ) < c.zone) lane.zoneT += dt;\n      }\n      if (lane.logMesh && !lane.logLost) lane.logMesh.position.x = lane.offset;\n      lane.lean = Math.abs(b.leanX);\n      if (lane.kind === 'local' && fat > 0.3 && this.t % 2 < dt) this.game.input.rumble(0.1 + fat * 0.3, 0.1 + fat * 0.2, 180);\n      if (lane.kind === 'local' && b.lean > 0.38) this.bark('bolster', 'near', 2, 5);\n    }\n    if (this.repT >= this.repLength) this.endRep();\n    for (const lane of this.lanes) if (lane.logBody) this.updateFallingLog(lane, dt);\n  }\n  endRep() {\n    const len = this.repLength;\n    const worth = this.rep >= this.bonusFrom ? 2 : 1;\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      const s = (lane.bandT / len) * (0.5 + 0.5 * (lane.zoneT / len));\n      lane.score += s * worth; lane.maxScore += worth;\n      lane.lastRepScore = s;\n      lane.bandT = 0; lane.zoneT = 0; lane.repN++;\n    }\n    this.rep++; this.repT = 0;\n    this.game.audio.sfx('thud', { pitch: 150 });\n    const solo = this.mode === 'solo';\n    if (this.rep === this.bonusFrom - 1 && solo) this.game.speech.say('bolster', \"That's the last one!\", { auto: 2.2, top: true });\n    else if (this.rep === this.bonusFrom && solo) { this.game.speech.say('bolster', \"...THIS one's the last one. I've lied to you and I'd do it again.\", { auto: 3, top: true }); this.game.hud.setNote('Two bonus reps. Worth double.', 2.6); this.walrus.rig.once('salute'); }\n    else if (solo && this.rep < this.bonusFrom - 1) this.game.speech.say('bolster', line('bolster', 'rep', { n: this.rep }), { auto: 2.2, top: true });\n    if (this.rep >= this.totalReps) this.finished = true;\n    this.walrus.rig.once(this.rep % 2 ? 'clap' : 'bounce');\n  }\n  dropLog(lane) {\n    lane.logLost = true;\n    lane.logMesh.visible = false;\n    const b = lane.bal.body.translation();\n    const off = lane.offset;\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(b.x + off, b.y + 0.5, b.z).setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(1.15, 0.11, 0.11).setMass(0.1).setFriction(0.7).setCollisionGroups(groups.prop(lane.id)), body);\n    lane.logBody = body;\n    const m = G();\n    add(m, M(geo.cyl(0.11, 0.11, 2.3, 14), 0x9A6E3E, 0, 0, 0, { rot: [0, 0, Math.PI / 2] }));\n    this.group.add(m);\n    lane.logFree = m;\n    lane.logFall = 1.6;\n    lane.offset = 0;\n    this.game.audio.sfx('clack');\n    this.walrus.rig.once('catch');\n    if (lane.kind === 'local') this.bark('bolster', 'log_drop', 2.4, 2);\n  }\n  updateFallingLog(lane, dt) {\n    lane.logFall -= dt;\n    if (lane.logFall <= 0) {\n      this.world.removeRigidBody(lane.logBody);\n      lane.logBody = null;\n      this.group.remove(lane.logFree);\n      lane.logFree = null;\n      lane.logLost = false;\n      lane.logMesh.visible = true;\n      lane.logMesh.position.x = 0;\n    }\n  }\n  onFall(lane) { if (lane.kind === 'local') this.bark('bolster', 'fall', 2.6, 3); lane.bandT = 0; lane.zoneT = 0; }\n  flailed(lane) { if (lane.kind === 'local') this.bark('bolster', 'flail', 2, 6); }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const [x, z] = bot.steer(0, 0, true);\n    out.wishX = x; out.wishZ = z;\n    // Follow the ribbon, a moment late, with a tracking error.\n    const err = { sharp: 0.05, average: 0.12, clumsy: 0.2 }[bot.skillName] ?? 0.12;\n    const tt = Math.max(0, this.repT - bot.s.delay);\n    const v = Math.max(0, Math.min(1, this.tempoAt(tt) + err * Math.sin(bot.t * 3.1 + bot.ph) * 1.2));\n    out.footL = v; out.footR = v;\n    out.flail = !lane.fallen && lane.bal.lean > 0.6 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    const shown = this.rep < this.bonusFrom ? `${Math.min(this.rep + 1, this.cfg.reps)}/${this.cfg.reps}` : `${this.cfg.reps}+${this.rep - this.bonusFrom + 1}`;\n    hud.setScore(shown, 'Rep');\n    hud.setTime(null);\n    if (this.bandEl) {\n      const tg = this.target ?? 0, hw = this.bandHW ?? 0.16;\n      this.bandEl.style.top = `${Math.max(0, (tg - hw) * 100)}%`;\n      this.bandEl.style.height = `${hw * 200}%`;\n      this.depthEl.style.top = `calc(${(me.depth || 0) * 100}% - .5rem)`;\n    }\n    for (const lane of this.lanes) lane.discView.zone = { x: 0, z: 0, r: this.cfg.zone, on: Math.hypot(lane.dotX, lane.dotZ) < this.cfg.zone };\n  }\n  frameEvent(dt) {\n    for (const lane of this.lanes) {\n      if (lane.doll && !lane.fallen) {\n        lane.doll.rig.scrub('squat', lane.depth || 0);\n        if (lane.logMesh) lane.logMesh.position.y = 1.18 - (lane.depth || 0) * 0.27;\n      }\n      if (lane.logBody && lane.logFree) { const p = lane.logBody.translation(), q = lane.logBody.rotation(); lane.logFree.position.set(p.x, p.y, p.z); lane.logFree.quaternion.set(q.x, q.y, q.z, q.w); }\n    }\n    if (this.walrus) this.walrus.update(dt);\n  }\n  isDone() { return this.finished; }\n  laneResult(lane) {\n    const form = lane.maxScore ? (100 * lane.score) / lane.maxScore : 0;\n    return { form, raw: lane.score, big: Math.round(form), stats: `${lane.repN} reps · ${lane.falls} floor exercises` };\n  }\n}\nexport { THREE, TEAL, CREAM, RED };\nEOF\ncat > src/events/plank.js <<'EOF'\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { post, planks, palm, umbrella, buoy, WOOD, WOOD_D, CREAM, SAND, RED, TEAL } from '../art/props.js';\nimport { Gull, Walrus } from '../art/cast.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\nimport { cos } from '../core/rng.js';\n\nconst SPOTS = [[0.55, 1.22, 0.05], [0.28, 1.12, 0.06], [0, 1.1, 0.05], [-0.28, 1.08, 0.06], [-0.5, 1.03, 0.05], [0.8, 1.18, 0.02], [-0.72, 0.98, 0.02], [0.14, 1.16, -0.05], [-0.14, 1.12, -0.05], [0.42, 1.2, -0.05], [-0.38, 1.08, -0.05], [0.65, 1.2, -0.04]];\n\n/** Hold a plank pose. Gulls land on you and push. Being covered in gulls is a win condition. */\nexport class Plank extends EventBase {\n  static id = 'plank';\n  constructor(spec) {\n    super(spec);\n    this.god = true; this.seaLevel = -1.2; this.customPose = true;\n    this.next = 2.5; this.side = this.r() < 0.5 ? -1 : 1; this.gulls = []; this.inT = 0; this.outT = 0; this.flops = 0; this.flopT = 0; this.flails = 0;\n    this.spotI = 0;\n  }\n  setupLane(lane) { lane.doll.rig.loop('plank'); lane.bal.moveFoot(lane.x, 0, 0); }\n  buildSet() {\n    const g = this.group;\n    add(g, M(geo.box(70, 1, 22), SAND, 0, -0.5, -3));\n    const beam = G('', 0, 0.42, 0);\n    add(beam, M(geo.box(2.6, 0.16, 0.5), WOOD), post(0.36, 0.06, WOOD_D, -1.1, -0.42, 0), post(0.36, 0.06, WOOD_D, 1.1, -0.42, 0));\n    g.add(beam);\n    const pier = planks(40, 4, { top: 0.8, thick: 0.2 });\n    pier.position.set(0, 2, -7);\n    g.add(pier);\n    for (let i = 0; i < 8; i++) add(g, post(3, 0.14, WOOD_D, -18 + i * 5, -0.2, -5.4), post(3, 0.14, WOOD_D, -18 + i * 5, -0.2, -8.6));\n    const u = umbrella(RED); u.position.set(-6, 0, -3); g.add(u);\n    const u2 = umbrella(TEAL); u2.position.set(6.5, 0, -2); g.add(u2);\n    const p = palm(3.6); p.position.set(-9, 0, -5); g.add(p);\n    const b = buoy(); b.position.set(9, 0.4, -5); g.add(b);\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(3.6, 0, -1);\n    this.walrus.root.rotation.y = -0.5;\n    this.walrus.rig.loop('stand');\n    g.add(this.walrus.root);\n    // The doll lies along x, head to screen right.\n    const lane = this.lanes[0];\n    lane.doll.root.position.set(0, 0.55, 0);\n    this.game.setBackdrop(-45, -120);\n  }\n  cameraShot(snap) { this.game.rig.shot(0, 1.7, 6.4, 0, 1, 0, { snap, rate: 4 }); }\n  hudSetup(hud) { hud.setScore(0, 'Gulls'); }\n  start() { this.next = 2.5; if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'plank_intro'), { auto: 3, top: true }); }\n  addGull() {\n    const c = this.cfg;\n    const push = c.push[0] + this.r() * (c.push[1] - c.push[0]);\n    if (this.r() > 0.7) this.side = -this.side;\n    const gull = new Gull();\n    const i = this.spotI++ % SPOTS.length;\n    const s = SPOTS[i];\n    const dir = this.side;\n    const spot = [Math.abs(s[0]) * dir, s[1], s[2]];\n    const from = [dir * 9 + cos(-1, 1), 5 + cos(0, 2), -3 + cos(-1, 1)];\n    gull.root.position.set(...from);\n    gull.root.rotation.y = -dir * 1.2;\n    gull.rig.loop('fly');\n    this.group.add(gull.root);\n    this.gulls.push({ gull, push: push * dir, t: 0, dur: 1.2, from, spot, landed: false, leave: false });\n    this.game.audio.sfx('squawk');\n    this.bark('bolster', 'gull', 2.2, 8);\n  }\n  netPush() { let n = 0; for (const g of this.gulls) if (g.landed && !g.leave) n += g.push; return n; }\n  scatter() {\n    for (const g of this.gulls) if (!g.leave) { g.leave = true; g.t = 0; g.from = [g.gull.root.position.x, g.gull.root.position.y, g.gull.root.position.z]; g.spot = [Math.sign(g.push) * 12, 7, -6]; g.dur = 1.3; g.landed = false; g.gull.rig.loop('fly'); }\n  }\n  fixedEvent(dt) {\n    const c = this.cfg, lane = this.lanes[0], b = lane.bal;\n    b.sway = c.sway; b.tremor = 0.05;\n    this.next -= dt;\n    if (this.next <= 0 && this.t < c.time - 2 && this.flopT <= 0) { this.next = c.every; this.addGull(); }\n    for (let i = this.gulls.length - 1; i >= 0; i--) {\n      const g = this.gulls[i];\n      g.t += dt;\n      const k = Math.min(1, g.t / g.dur), e = k * k * (3 - 2 * k), r = g.gull.root;\n      if (!g.landed) {\n        r.position.set(g.from[0] + (g.spot[0] - g.from[0]) * e, g.from[1] + (g.spot[1] - g.from[1]) * e + (g.leave ? 0 : Math.sin(k * 3.14) * 0.5), g.from[2] + (g.spot[2] - g.from[2]) * e);\n        if (k >= 1) {\n          if (g.leave) { this.group.remove(r); this.gulls.splice(i, 1); continue; }\n          g.landed = true; g.gull.rig.loop('stand'); g.gull.rig.once('land');\n          this.game.audio.sfx('gullLand');\n          this.game.input.rumble(0.05, 0.25, 90);\n        }\n      }\n    }\n    b.extX += this.netPush() * this.diff.dist;\n    const r = Math.hypot(lane.dotX, lane.dotZ), inZone = r < c.zone;\n    if (this.flopT > 0) {\n      this.flopT -= dt;\n      if (this.flopT <= 0) { lane.bal.recover(); this.game.audio.sfx('spring'); }\n    } else if (inZone) { this.inT += dt; this.outT = 0; } else {\n      this.outT += dt;\n      if (this.outT > 2) {\n        this.flopT = 1.6; this.outT = 0; this.flops++;\n        lane.falls++;\n        this.scatter();\n        this.game.audio.sfx('fall'); this.game.comic.pop('FLOMP!', 0, 1.5, 0); this.game.rig.shake(0.07);\n        this.game.onFloorExercise();\n        this.game.input.rumble(0.8, 0.6, 280);\n        if (lane.kind === 'local') this.bark('bolster', 'flop', 2.6, 1);\n      }\n    }\n  }\n  flailed(lane) {\n    if (this.gulls.some((g) => !g.leave)) {\n      this.flails++;\n      this.scatter();\n      this.game.audio.sfx('squawk');\n      this.walrus.rig.once('salute');\n      if (lane.kind === 'local') this.bark('bolster', 'shake_off', 2.6, 2);\n    }\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    // Counter the net push. It takes K − G of stiffness to hold it still.\n    const gx = -this.netPush() / 3.3;\n    const [x, z] = bot.steer(Math.max(-0.9, Math.min(0.9, gx)), 0);\n    out.wishX = x; out.wishZ = z;\n    bot.data.out = Math.hypot(lane.dotX, lane.dotZ) > this.cfg.zone ? (bot.data.out || 0) + 1 / 120 : 0;\n    out.flail = bot.data.out > 1.2 && lane.bal.lean > 0.2 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const hud = this.game.hud;\n    hud.setTime(this.cfg.time - this.t);\n    hud.setScore(this.gulls.filter((g) => g.landed && !g.leave).length, 'Gulls');\n    const lane = this.lanes[0];\n    lane.discView.zone = { x: 0, z: 0, r: this.cfg.zone, on: Math.hypot(lane.dotX, lane.dotZ) < this.cfg.zone };\n  }\n  frameEvent(dt) {\n    const lane = this.lanes[0], d = lane.doll, b = lane.bal;\n    // Lying flat along x. The doll rocks with the core.\n    d.root.position.set(0, this.flopT > 0 ? 0.3 : 0.6, 0);\n    d.root.rotation.set(b.leanZ * 0.3, 0, Math.PI / 2 * 0 - b.leanX * 0.3);\n    d.facing.rotation.set(0, 0, 0);\n    d.facing.rotation.y = Math.PI / 2;\n    d.facing.rotation.z = 0;\n    d.facing.rotation.x = 0;\n    d.joints.hips.rotation.x = Math.PI / 2 * 1;\n    for (const g of this.gulls) {\n      g.gull.update(dt);\n      if (g.landed && !g.leave) { g.gull.root.position.y = g.spot[1] - 0.1 + (this.flopT > 0 ? -0.3 : 0) - b.leanX * 0.3 * g.spot[0]; }\n    }\n    if (this.walrus) this.walrus.update(dt);\n  }\n  isDone() { return this.t >= this.cfg.time; }\n  laneResult() {\n    const share = (100 * this.inT) / this.cfg.time;\n    const on = this.gulls.filter((g) => g.landed && !g.leave).length;\n    const raw = share + on * 2 - this.flails * 3;\n    return { form: (100 * raw) / this.cfg.par, raw, big: Math.round(raw), stats: `${Math.round(share)}% in the zone · ${on} gulls still on you · ${this.flops} flops` };\n  }\n}\nexport { h, CREAM };\nEOF\ncat > src/events/tug.js <<'EOF'\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { SAND, CREAM, rope, umbrella, palm, RED, TEAL } from '../art/props.js';\nimport { Doll } from '../art/doll.js';\nimport { Walrus } from '../art/cast.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst CALL = 1.2, DEG = Math.PI / 180;\n/** The rope is one number. Heave on the call. How far you dare lean is the game. */\nexport class Tug extends EventBase {\n  static id = 'tug';\n  constructor(spec) {\n    super(spec);\n    this.god = false; this.seaLevel = -2; this.customPose = true;\n    this.rope = 0; this.pull = 1; this.wins = [0, 0]; this.next = 1.2; this.callN = 0; this.ease = 0; this.easeT = this.cfg.ease || 0; this.done = false; this.pause = 0;\n    this.teams = null;\n  }\n  laneX(i) { return 0; }\n  setupLane(lane) {\n    lane.team = lane.id % 2;\n    lane.pressT = -9; lane.power = 0; lane.sat = 0; lane.lastPress = -9; lane.wasBoth = false;\n    lane.doll.rig.loop('tug');\n  }\n  get solo() { return this.lanes.length === 1; }\n  buildSet() {\n    const g = this.group;\n    add(g, M(geo.box(120, 1, 40), SAND, 0, -0.5, -8));\n    for (let i = -6; i <= 6; i++) add(g, M(geo.box(0.08, 0.01, 1.6), i === 0 ? RED : CREAM, i * 1, 0.006, 0, { shadow: false }));\n    add(g, M(geo.box(0.16, 0.012, 2), RED, -6.2, 0.006, 0, { shadow: false }), M(geo.box(0.16, 0.012, 2), RED, 6.2, 0.006, 0, { shadow: false }));\n    const u = umbrella(RED); u.position.set(-9, 0, -4); g.add(u);\n    const u2 = umbrella(TEAL); u2.position.set(8, 0, -5); g.add(u2);\n    const p = palm(3.8); p.position.set(0, 0, -7); g.add(p);\n    this.ropeG = G('');\n    this.ropeM = rope(-5, 1.05, 0, 5, 1.05, 0, 0.1, 0.05);\n    this.ropeG.add(this.ropeM);\n    add(this.ropeG, M(geo.sphere(0.12, 10, 8), RED, 0, 1, 0, { scale: [1, 1.2, 1] }));\n    g.add(this.ropeG);\n    // Solo: you and Retired Kevin against Both Sandras.\n    this.extra = [];\n    if (this.solo) {\n      const kevin = new Doll({ shirt: '#6FB7D6', hat: 'visor', shorts: 0x38503A });\n      const s1 = new Doll({ shirt: '#E78FB3', hat: 'bucket', height: 0.96, shorts: 0x7A3F5A }), s2 = new Doll({ shirt: '#E78FB3', hat: 'bucket', height: 0.96, shorts: 0x7A3F5A });\n      this.kevin = kevin; this.sandras = [s1, s2];\n      for (const d of [kevin, s1, s2]) { g.add(d.root); d.rig.loop('tug'); d.flatFeet = false; this.extra.push(d); }\n    }\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(0.2, 0, -3.2);\n    this.walrus.rig.loop('bounce');\n    g.add(this.walrus.root);\n    this.game.setBackdrop(30, -125);\n  }\n  cameraShot(snap) { this.game.rig.shot(0, 2.3, 11, 0, 1.1, 0, { snap, rate: 4, fov: 38 }); }\n  hudSetup(hud) { this.scoreTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, '')); this.ropeBar = hud.addWidget(hud.meter('Rope', '#E8644A')); hud.setScore('0-0', 'Pulls'); }\n  start() { this.next = 1.4; if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'tug_intro'), { auto: 3, top: true }); }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    if (this.pause > 0) { this.pause -= dt; for (const l of this.lanes) if (l.bal) { l.bal.sway = 0.05; } return; }\n    this.next -= dt;\n    if (this.next <= 0) {\n      this.callT = this.t; this.next = CALL; this.callN++;\n      this.game.hud.flash('HEAVE!', 0.45);\n      this.game.audio.sfx('metronome', { vel: 1 });\n      this.walrus.rig.once('clap');\n      this.judgeT = this.t + 0.3;\n      this.judged = false;\n      for (const l of this.lanes) { l.timing = 0; l.share = 0; }\n    }\n    // Their pull forward. Your lean back is plus z.\n    const theirPower = this.solo ? c.power * (1 + (this.ropeNoise || 0)) : 0.3;\n    if (c.ease) {\n      this.easeT -= dt;\n      if (this.easeT <= 0) { this.ease = 0.8; this.easeT = c.ease * (0.8 + this.r() * 0.4); this.easeHit = false; if (this.mode === 'solo') this.bark('bolster', 'tug_ease', 2, 4); this.game.hud.setNote('They eased off!', 0.8); }\n    }\n    const easing = this.ease > 0;\n    if (easing) this.ease -= dt;\n    for (const lane of this.lanes) {\n      const b = lane.bal, i = lane.input;\n      if (!b) continue;\n      b.sway = 0.06;\n      if (!easing) b.extZ += -(0.1 + 0.3 * theirPower) * this.diff.dist;\n      const share = Math.max(0, b.leanZ / b.maxLean);\n      lane.shareNow = share;\n      if (easing && !this.easeHit && share > 0.72 && !lane.fallen) { lane.sat = 0.5; }\n      if (lane.sat > 0) {\n        lane.sat -= dt;\n        b.extZ += 3.2;\n      }\n      const both = (i.footL > 0.5 && i.footR > 0.5) || i.hop;\n      if (both && !lane.wasBoth) lane.lastPress = this.t;\n      lane.wasBoth = both;\n      if (this.callT !== undefined && Math.abs(lane.lastPress - this.callT) <= 0.3 && !lane.fallen) {\n        const tim = Math.max(0, 1 - Math.abs(lane.lastPress - this.callT) / 0.3);\n        if (tim > (lane.timing || 0)) lane.timing = tim;\n        lane.share = Math.max(lane.share || 0, share);\n      }\n    }\n    if (this.judgeT !== undefined && !this.judged && this.t >= this.judgeT) {\n      this.judged = true;\n      this.judge();\n    }\n    this.rope = Math.max(-1, Math.min(1, this.rope));\n    if (Math.abs(this.rope) >= 1) this.endPull(this.rope > 0 ? 0 : 1);\n  }\n  judge() {\n    const c = this.cfg;\n    const power = (l) => (l.fallen ? 0 : (l.timing || 0) * (l.share || 0));\n    let a = 0, b = 0, na = 0, nb = 0;\n    for (const l of this.lanes) { if (!l.bal) continue; const p = power(l); l.power = p; if (l.team === 0) { a += p; na++; } else { b += p; nb++; } }\n    const ours = na ? a / na : 0;\n    let theirs;\n    if (nb) theirs = b / nb;\n    else theirs = c.power * (0.8 + this.r() * 0.4);\n    this.rope += (ours - theirs) * 0.33;\n    this.ropeNoise = (this.r() - 0.5) * 0.4;\n    this.game.audio.sfx('thud', { pitch: 130 });\n  }\n  endPull(winner) {\n    this.wins[winner]++;\n    const me = this.lanes[0];\n    this.game.audio.sfx('bell');\n    if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', winner === 0 ? 'tug_win' : 'tug_lose'), { auto: 2.8, top: true });\n    this.game.hud.flash(winner === 0 ? 'Pull won!' : 'Pull lost', 1.5);\n    if (winner === 0 && me.kind === 'local') this.game.fx.confetti(0, 5, 0, 60, [0xE8443A, 0xF5B700, 0x2CB5A0, 0xFFF3DC], 5);\n    this.rope = 0; this.pause = 2.4; this.next = 1.4; this.pull++;\n    this.ease = 0; this.callT = undefined;\n    if (this.wins[0] >= 2 || this.wins[1] >= 2 || this.pull > 3) this.done = true;\n  }\n  onFall(lane) {\n    // Lean back too far when the other side eases off and you sit down hard.\n    this.rope += lane.team === 0 ? -0.3 : 0.3;\n    if (lane.kind === 'local') this.bark('bolster', 'tug_sit', 2.6, 2);\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const stick = lane.tugStick ?? 0.9;\n    const [x, z] = bot.steer(0, stick, true);\n    out.wishX = x * 0.3; out.wishZ = Math.max(z, stick);\n    const dueIn = this.next + bot.timingOff;\n    bot.timingOff = bot.timingOff ?? bot.timing();\n    const press = this.next <= Math.max(0, 0.04 + (bot.data.err ?? 0));\n    if (this.next > 1) bot.data.err = bot.timing();\n    const v = press || (this.callT !== undefined && this.t - this.callT < 0.12) ? 1 : 0;\n    out.footL = v; out.footR = v;\n    out.flail = !lane.fallen && lane.bal.lean > 0.52 && lane.bal.flailCool <= 0;\n    return dueIn;\n  }\n  hud() {\n    const hud = this.game.hud;\n    hud.setScore(`${this.wins[0]}-${this.wins[1]}`, 'Pulls');\n    hud.setTime(null);\n    if (this.ropeBar) this.ropeBar.set((this.rope + 1) / 2);\n    if (this.scoreTag) { const s = `Pull ${Math.min(3, this.pull)} of 3`; if (this.scoreTag.textContent !== s) this.scoreTag.textContent = s; }\n  }\n  placeDoll(d, x, faceRight, leanBack, y = 0) {\n    d.root.position.set(x, y, 0);\n    d.face(faceRight ? Math.PI / 2 : -Math.PI / 2);\n    d.root.rotation.set(0, 0, (faceRight ? 1 : -1) * leanBack);\n    d.setLean && 0;\n  }\n  frameEvent(dt) {\n    const r = this.rope * 1.4;\n    this.ropeG.position.x = -r;\n    const positions = this.solo ? [] : [[-3.4, true], [3.4, false], [-5, true], [5, false]];\n    this.lanes.forEach((l, i) => {\n      if (l.fallen) return;\n      const left = this.solo ? true : l.team === 0;\n      const x = this.solo ? -3.4 : positions[i][0];\n      const lean = Math.max(0, l.bal ? l.bal.leanZ * 0.8 : 0);\n      this.placeDoll(l.doll, x - r, left, lean);\n      l.bal.moveFoot(x - r, 0, 0);\n    });\n    if (this.solo) {\n      this.placeDoll(this.kevin, -5 - r, true, 0.28 + Math.sin(this.t * 3) * 0.04);\n      this.placeDoll(this.sandras[0], 3.4 - r, false, 0.3 + Math.sin(this.t * 3.1) * 0.04);\n      this.placeDoll(this.sandras[1], 5 - r, false, 0.3 + Math.sin(this.t * 3.1) * 0.04);\n      for (const d of this.extra) d.update(dt);\n    }\n    if (this.walrus) this.walrus.update(dt);\n  }\n  isDone() { return this.done; }\n  laneResult(lane) {\n    const won = lane.team === 0 ? this.wins[0] : this.wins[1];\n    const form = Math.max(0, 40 + 30 * won - 5 * lane.falls);\n    return { form, raw: won, big: `${won} won`, stats: `Pulls ${this.wins[0]}-${this.wins[1]} · ${lane.falls} sat down` };\n  }\n}\nexport { DEG };\nEOF\ncat > src/events/stepClass.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { M, G, geo, toon, add, basic } from '../art/materials.js';\nimport { post, pavilionRoof, bunting, TEAK, CREAM, TEAL, ORANGE } from '../art/props.js';\nimport { Doll } from '../art/doll.js';\nimport { Walrus } from '../art/cast.js';\nimport { chartNotes } from '../data/charts.js';\nimport { tun } from '../core/tuning.js';\nimport { cos, cosPick } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst CLASS_COLOURS = ['#C9A0DC', '#6FB7D6', '#E78FB3', '#F5C84A', '#7FA650', '#E8644A', '#5AA9E6', '#F2A65A'];\nconst LEAD = 2.4; // seconds a footprint is on the deck before it arrives\nconst DIRS = { '<': [-1, 0], '>': [1, 0], '^': [0, -1], v: [0, 1] };\nconst NOTE_COL = { L: 0x7FB4E8, R: 0xE8707A, B: 0xF5B700 };\n\n/** Footprints slide toward your feet. The class copies you. Miss one and somebody trips. */\nexport class StepClass extends EventBase {\n  static id = 'stepClass';\n  constructor(spec) {\n    super(spec);\n    this.seaLevel = -5; this.god = true;\n    const ch = chartNotes(this.cfg.chart, this.cfg.bpm);\n    this.notes = ch.notes; this.length = ch.length; this.beat = ch.beat;\n    this.clock = -0.0; this.ownsMusic = true;\n    this.max = this.notes.length;\n    this.pulse = 0; this.lastBeat = -1;\n    this.nextClick = 0;\n  }\n  setupLane(lane) {\n    lane.judge = this.notes.map(() => ({ done: false, score: 0 }));\n    lane.sum = 0; lane.combo = 0; lane.best = 0; lane.perfect = 0; lane.miss = 0; lane.lastWord = '';\n    lane.doll.rig.loop('stand');\n    lane.fx = 0;\n    lane.wasBoth = false;\n    lane.leanScored = 0;\n    lane.prints = [];\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length, w = Math.max(12, n * 3.2 + 7);\n    add(g, M(geo.cyl(w * 0.72, w * 0.76, 1, 8), CREAM, 0, -0.5, -2), M(geo.cyl(w * 0.7, w * 0.7, 0.04, 8), TEAK, 0, -0.01, -2));\n    add(g, M(geo.box(w * 2.4, 1, 50), 0x8CCB6A, 0, -1.2, -8));\n    // Footprint tracks.\n    for (const lane of this.lanes) {\n      add(g, M(geo.box(0.62, 0.012, LEAD * 3.4), 0xE9D7A8, lane.x - 0.42, 0.012, -LEAD * 1.7 + 0.5, { shadow: false }), M(geo.box(0.62, 0.012, LEAD * 3.4), 0xE9D7A8, lane.x + 0.42, 0.012, -LEAD * 1.7 + 0.5, { shadow: false }));\n      lane.markL = M(geo.sphere(0.2, 12, 8), 0x7FB4E8, lane.x - 0.42, 0.016, 0.5, { scale: [1, 0.05, 1.4], shadow: false });\n      lane.markR = M(geo.sphere(0.2, 12, 8), 0xE8707A, lane.x + 0.42, 0.016, 0.5, { scale: [1, 0.05, 1.4], shadow: false });\n      add(g, lane.markL, lane.markR);\n    }\n    const roof = pavilionRoof(w * 0.85, TEAL, ORANGE);\n    roof.position.set(0, 7.6, -2);\n    g.add(roof);\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * 6.283 + 0.39;\n      add(g, post(7.6, 0.13, CREAM, Math.cos(a) * w * 0.68, 0, -2 + Math.sin(a) * w * 0.68));\n    }\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * 6.283 + 0.39, b = ((i + 1) / 8) * 6.283 + 0.39;\n      g.add(bunting(Math.cos(a) * w * 0.68, 6.4, -2 + Math.sin(a) * w * 0.68, Math.cos(b) * w * 0.68, 6.4, -2 + Math.sin(b) * w * 0.68, 7));\n    }\n    // A class of eight behind you, getting more in sync as your combo grows.\n    this.klass = [];\n    for (let i = 0; i < 8; i++) {\n      const d = new Doll({ shirt: CLASS_COLOURS[i], hat: cosPick(['none', 'visor', 'bucket', 'beret', 'perm', 'none']), height: cos(0.9, 1.06), width: cos(0.95, 1.05) });\n      d.flatFeet = false;\n      const row = i < 4 ? 0 : 1;\n      d.root.position.set((i % 4 - 1.5) * 2.2 + row * 0.8, 0, -4 - row * 2);\n      d.rig.loop('stand');\n      g.add(d.root);\n      this.klass.push({ d, lag: 0, tripT: 0 });\n    }\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(-w * 0.42, 0, -1.4);\n    this.walrus.root.rotation.y = 0.7;\n    this.walrus.rig.loop('bounce', { speed: this.cfg.bpm / 75 });\n    g.add(this.walrus.root);\n    // Spotlights that swing at a combo of 16.\n    this.spots = [];\n    for (const x of [-w * 0.32, w * 0.32]) {\n      const s = new THREE.SpotLight(0xFFE9A8, 0, 26, 0.42, 0.5, 1.2);\n      s.position.set(x, 7.2, -1);\n      s.target.position.set(0, 0, 0);\n      add(g, s, s.target);\n      this.spots.push(s);\n    }\n    this.printPool = [];\n    this.printGeo = geo.sphere(0.2, 12, 8);\n    this.ribbonGeo = geo.box(1, 0.02, 0.5);\n    this.prints = this.notes.map(() => null);\n    this.game.setIsland('hidden');\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(8.5, (n - 1) * 3.2 + 2);\n    this.game.rig.shot(0, 2.9, d, 0, 1.15, -1, { snap, rate: 4 });\n  }\n  hudSetup(hud) { this.comboTag = hud.addWidget(h('div.tag', { style: 'font-size:3.8rem' }, 'Combo 0')); hud.setScore(0, 'Form'); }\n  musicOpts() { return { bpm: this.cfg.bpm }; }\n  start() {\n    const a = this.game.audio;\n    this.useAudio = !this.game.params.manual && a.state === 'running';\n    a.music('cardio', { bpm: this.cfg.bpm, at: a.ctx ? a.ctx.currentTime + 0.05 : undefined, fade: 0.2 });\n    this.clock = 0;\n    if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'step_intro'), { auto: 3, top: true });\n  }\n  /** Step timing comes from the audio clock, minus output latency, when audio runs; otherwise the sim clock. */\n  syncClock() {\n    if (!this.useAudio) return;\n    const a = this.game.audio, seq = a.seq;\n    if (!seq || seq.id !== 'cardio' || seq.paused) return;\n    const lat = a.ctx.outputLatency || 0;\n    const want = seq.position() - lat;\n    const d = want - this.clock;\n    if (Math.abs(d) > 0.25) this.clock = want; else this.clock += d * 0.1;\n  }\n  windows() {\n    const k = tun.rhythmWindow * this.diff.rhythm;\n    return { perfect: 0.045 * k, good: 0.09 * k, ok: 0.135 * k };\n  }\n  fixedEvent(dt) {\n    this.clock += dt;\n    const offset = this.game.save.settings.rhythmOffset / 1000;\n    const now = this.clock - offset;\n    // Click every note on the sound bus: music is only 10%, so the beat must read without it.\n    const a = this.game.audio;\n    while (this.nextClick < this.notes.length && this.notes[this.nextClick].t <= now + 0.1) {\n      const nt = this.notes[this.nextClick];\n      if (a.mix && a.state === 'running') a.mix.playSfx('foot', a.ctx.currentTime + Math.max(0, nt.t - now), { note: nt.lean ? 76 : nt.type === 'L' ? 84 : nt.type === 'R' ? 88 : 93, vel: 0.9 });\n      this.nextClick++;\n    }\n    const beatN = Math.floor(now / this.beat);\n    if (beatN !== this.lastBeat) { this.lastBeat = beatN; this.pulse = 1; }\n    const win = this.windows();\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost') continue;\n      const i = lane.input;\n      const both = i.hopPressed || (i.footL > 0.5 && i.footR > 0.5 && !lane.wasBoth);\n      lane.wasBoth = i.footL > 0.5 && i.footR > 0.5;\n      if (both) this.press(lane, 'B', now, win);\n      else {\n        if (i.footLPressed) this.press(lane, 'L', now, win);\n        if (i.footRPressed) this.press(lane, 'R', now, win);\n      }\n      // Lean notes score when the dot passes .25 in that direction: full within 1.5 beats, half within 2.\n      this.notes.forEach((n, k) => {\n        const j = lane.judge[k];\n        if (j.done) return;\n        if (n.lean) {\n          if (now < n.t - 0.75 * this.beat) return;\n          const [dx, dz] = DIRS[n.type];\n          const proj = lane.dotX * dx + lane.dotZ * dz;\n          const dtN = now - n.t;\n          if (proj > 0.25) {\n            const s = dtN <= 1.5 * this.beat ? 1 : 0.5;\n            this.score(lane, k, s, s === 1 ? 'Lean!' : 'Late');\n          } else if (dtN > 2 * this.beat) this.miss(lane, k);\n        } else if (now - n.t > win.ok) this.miss(lane, k);\n      });\n    }\n  }\n  press(lane, type, now, win) {\n    // Nearest unjudged foot note of a matching type; both-foot notes accept a hop, single notes a press.\n    let best = -1, bd = 1e9;\n    for (let k = 0; k < this.notes.length; k++) {\n      const n = this.notes[k];\n      if (n.lean || lane.judge[k].done) continue;\n      if (n.t - now > win.ok) break;\n      if (type === 'B' ? n.type !== 'B' : n.type !== type && n.type !== 'B') continue;\n      const d = Math.abs(now - n.t);\n      if (d < bd) { bd = d; best = k; }\n    }\n    this.stepPose(lane, type);\n    if (best < 0 || bd > win.ok) return;\n    const n = this.notes[best];\n    if (n.type === 'B' && type !== 'B') {\n      // A both-foot note wants both feet: one foot gets half marks only if the other comes too.\n      const other = type === 'L' ? lane.input.footR : lane.input.footL;\n      if (other < 0.5) return;\n    }\n    const s = bd <= win.perfect ? 1 : bd <= win.good ? 0.7 : 0.4;\n    if (s === 1) lane.perfect++;\n    this.score(lane, best, s, s === 1 ? 'Perfect' : s > 0.5 ? 'Good' : 'OK');\n  }\n  stepPose(lane, type) {\n    // Mirrored on purpose: your left is the doll's right as it faces you.\n    if (type === 'L') lane.doll.rig.once('stepR');\n    else if (type === 'R') lane.doll.rig.once('stepL');\n    else lane.doll.rig.once('hop', { speed: 1.6 });\n    this.game.audio.sfx('thud', { pitch: 200 });\n  }\n  score(lane, k, s, word) {\n    lane.judge[k].done = true; lane.judge[k].score = s;\n    lane.sum += s;\n    lane.combo++;\n    lane.best = Math.max(lane.best, lane.combo);\n    lane.lastWord = word;\n    if (lane.kind === 'local') {\n      this.game.hud.setNote(word, 0.5);\n      if (lane.combo === 16) {\n        this.game.fx.confetti(0, 7, -1, 120, [0xE8443A, 0xF5B700, 0x2CB5A0, 0x5AA9E6, 0xFFF3DC], 7);\n        this.bark('bolster', 'step_combo', 2.4, 3);\n        for (const sp of this.spots) sp.intensity = 90;\n      }\n    }\n    this.flashPrint(k);\n  }\n  miss(lane, k) {\n    lane.judge[k].done = true;\n    lane.combo = 0; lane.miss++;\n    lane.lastWord = 'Miss';\n    for (const sp of this.spots) sp.intensity = 0;\n    // A miss makes someone in the class trip.\n    const c = this.klass[Math.floor(cos(0, this.klass.length))];\n    if (c && c.tripT <= 0) { c.tripT = 1.1; c.d.rig.once('flop', { speed: 1.2, hold: 0.5 }); this.game.audio.sfx('clack'); }\n    if (lane.kind === 'local') { this.game.hud.setNote('Miss', 0.5); this.bark('bolster', 'step_miss', 2.2, 7); }\n  }\n  flashPrint(k) { const p = this.prints[k]; if (p) { this.group.remove(p); this.prints[k] = null; } }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const now = this.clock - this.game.save.settings.rhythmOffset / 1000;\n    out.footLPressed = false; out.footRPressed = false; out.hopPressed = false; out.hop = false;\n    out.footL = 0; out.footR = 0;\n    let lean = null;\n    bot.data.err = bot.data.err || {};\n    for (let k = 0; k < this.notes.length; k++) {\n      const n = this.notes[k];\n      if (lane.judge[k].done) continue;\n      if (n.t > now + 1) break;\n      if (n.lean) { if (!lean && n.t - now < 0.45) lean = n; continue; }\n      if (bot.data.err[k] === undefined) bot.data.err[k] = bot.chance(0.03 + (bot.s.timing > 0.06 ? 0.04 : 0)) ? 9 : bot.timing();\n      const due = n.t + bot.data.err[k];\n      if (now >= due && now < due + 0.1) {\n        if (n.type === 'L') { out.footLPressed = true; out.footL = 1; } else if (n.type === 'R') { out.footRPressed = true; out.footR = 1; } else { out.hopPressed = true; out.hop = true; }\n      }\n    }\n    let gx = 0, gz = 0;\n    if (lean) { [gx, gz] = DIRS[lean.type]; gx *= 0.7; gz *= 0.7; }\n    const [x, z] = bot.steer(gx, gz);\n    out.wishX = lean ? gx * 1.3 : x; out.wishZ = lean ? gz * 1.3 : z;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    hud.setTime(Math.max(0, this.length - this.clock));\n    hud.setScore(Math.round((100 * me.sum) / this.max), 'Form');\n    if (this.comboTag) { const s = `Combo ${me.combo}`; if (this.comboTag.textContent !== s) this.comboTag.textContent = s; }\n  }\n  frameEvent(dt) {\n    const now = this.clock;\n    this.pulse = Math.max(0, this.pulse - dt * 6);\n    const lane0 = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    // Footprints for the notes coming up.\n    this.notes.forEach((n, k) => {\n      const until = n.t - now;\n      if (lane0.judge && lane0.judge[k] && lane0.judge[k].done) { this.flashPrint(k); return; }\n      if (until < LEAD && until > -0.4) {\n        let p = this.prints[k];\n        if (!p) {\n          p = this.makePrint(n);\n          this.prints[k] = p;\n          this.group.add(p);\n        }\n        const z = 0.5 - (until / LEAD) * LEAD * 2.6;\n        p.position.z = z;\n        p.scale.setScalar(1 + (until < 0.15 ? this.pulse * 0.4 : 0));\n      } else if (until <= -0.4) this.flashPrint(k);\n    });\n    for (const lane of this.lanes) {\n      if (lane.markL) { const s = 1 + this.pulse * 0.25; lane.markL.scale.set(s, 0.05, 1.4 * s); lane.markR.scale.set(s, 0.05, 1.4 * s); }\n      if (lane.doll && lane.kind !== 'ghost' && this.lastBeat >= 0 && lane.doll.rig.onceLeft <= 0) lane.doll.rig.loop('stand');\n    }\n    // The class gets more in sync as your combo grows.\n    const combo = lane0.combo || 0;\n    const sync = Math.min(1, combo / 16);\n    const beat = this.lastBeat;\n    this.klass.forEach((c, i) => {\n      c.tripT = Math.max(0, c.tripT - dt);\n      c.d.update(dt);\n      if (c.tripT > 0) return;\n      const phase = (now / this.beat + (1 - sync) * i * 0.37) % 2;\n      if (Math.floor(phase) !== c.lastF) {\n        c.lastF = Math.floor(phase);\n        c.d.rig.once(c.lastF ? 'stepL' : 'stepR');\n      }\n    });\n    if (combo >= 16) {\n      const s = Math.sin(now * 1.6) * 3;\n      this.spots[0].target.position.set(s, 0, 0); this.spots[1].target.position.set(-s, 0, 0);\n    }\n    if (this.walrus) this.walrus.update(dt);\n    return beat;\n  }\n  makePrint(n) {\n    const lane = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const g = G();\n    const m = (x, c) => M(this.printGeo, c, lane.x + x, 0.03, 0, { scale: [1, 0.12, 1.4], shadow: false });\n    if (n.lean) {\n      const [dx, dz] = DIRS[n.type];\n      const bar = M(geo.box(1.5, 0.02, 0.32), 0x9BE08F, lane.x, 0.03, 0, { shadow: false });\n      const arrow = M(geo.cone(0.24, 0.42, 4), 0x2F8F46, lane.x + dx * 0.6, 0.06, dz * 0.25, { rot: [Math.PI / 2, 0, Math.atan2(-dx, -dz)], scale: [1, 1, 0.2], shadow: false });\n      add(g, bar, arrow);\n    } else {\n      if (n.type === 'L' || n.type === 'B') g.add(m(-0.42, NOTE_COL[n.type]));\n      if (n.type === 'R' || n.type === 'B') g.add(m(0.42, NOTE_COL[n.type]));\n    }\n    return g;\n  }\n  onResume() { this.syncClock(); }\n  afterStep() { if (this.useAudio && (this.stepCount++ % 12 === 0)) this.syncClock(); }\n  isDone() { return this.clock >= this.length; }\n  laneResult(lane) {\n    const form = (100 * (lane.sum || 0)) / Math.max(1, this.max);\n    return { form, raw: lane.sum, big: Math.round(form), stats: `Best combo ${lane.best} · ${lane.perfect} perfect · ${lane.miss} missed` };\n  }\n}\nexport { toon, basic };\nEOF\ncat > src/events/plates.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add, toon } from '../art/materials.js';\nimport { post, CREAM, RED, TEAL, ORANGE, bunting, tree } from '../art/props.js';\nimport { Walrus } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst BANDS = { L: { lo: 3.5, hi: 5, r: 0.46, colour: 0x2CB5A0, name: 'Large' }, M: { lo: 6.5, hi: 8, r: 0.36, colour: 0xF08A3C, name: 'Medium' }, S: { lo: 9.5, hi: 11, r: 0.27, colour: 0xE8443A, name: 'Small' } };\nconst arcs = [];\nfunction arcGeo(k) {\n  const i = Math.round(k * 20);\n  if (!arcs[i]) { arcs[i] = new THREE.RingGeometry(0.5, 0.62, 28, 1, Math.PI / 2, Math.max(0.001, (i / 20) * Math.PI * 2)); }\n  return arcs[i];\n}\n/** Circle your weight to drive the hoop. Each plate needs its own speed. Everything else is decaying. */\nexport class Plates extends EventBase {\n  static id = 'plates';\n  constructor(spec) {\n    super(spec);\n    this.god = true; this.seaLevel = -5;\n    this.shards = [];\n    this.spec = this.cfg.plates.split('');\n  }\n  setupLane(lane) {\n    lane.hoop = 0; lane.omega = 0; lane.omegaSm = 0; lane.prevAng = null; lane.phase = 0; lane.alive = 0; lane.aliveMax = 0; lane.crashes = 0; lane.keyTime = 0; lane.lastTap = -9; lane.lastKey = null; lane.keyRate = 0;\n    lane.plates = this.spec.map((size, i) => {\n      const a = (i / this.spec.length) * Math.PI * 2 + Math.PI * 0.5, R = 1.25;\n      const px = lane.x + Math.cos(a) * R, pz = Math.sin(a) * R;\n      const b = BANDS[size];\n      const g = G('', px, 0, pz);\n      add(g, post(1.75, 0.025, CREAM, 0, 0, 0));\n      const disc = G('', 0, 1.8, 0);\n      add(disc, M(geo.cyl(b.r, b.r * 0.72, 0.045, 24), b.colour), M(geo.tor(b.r * 0.66, 0.012), CREAM, 0, 0.03, 0, { rot: [Math.PI / 2, 0, 0], shadow: false }));\n      g.add(disc);\n      const gauge = new THREE.Mesh(arcGeo(1), toon(b.colour));\n      gauge.scale.setScalar(b.r * 1.5);\n      gauge.position.y = 2.4;\n      g.add(gauge);\n      this.group.add(g);\n      return { size, band: b, energy: 0.7, state: 'on', back: 0, group: g, disc, gauge, spin: 0, wobble: 0, was: 0.7 };\n    });\n    const hoop = lane.hoopMesh = M(geo.tor(0.62, 0.03), RED, 0, 0.72, 0, { rot: [Math.PI / 2, 0, 0] });\n    lane.doll.root.add(hoop);\n    const ringCol = lane.bandRing = M(geo.ring(0.8, 0.98, 36), 0xFFFFFF, lane.x, 0.03, 0, { shadow: false });\n    this.group.add(ringCol);\n    lane.doll.rig.scrub('hipCircle', 0, { fade: 0 });\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length, w = Math.max(14, n * 3.8 + 8);\n    add(g, M(geo.cyl(w * 0.62, w * 0.65, 1, 40), 0xF2E3B5, 0, -0.5, -1), M(geo.ring(w * 0.58, w * 0.62, 40), RED, 0, 0.012, -1, { shadow: false }), M(geo.box(w * 4, 1, 80), 0x8CCB6A, 0, -1, -10));\n    for (const [x, z] of [[-w * 0.6, -7], [w * 0.55, -8], [0, -12], [w * 0.8, -3], [-w * 0.8, -2]]) { const t = tree(2.6, 1.4); t.position.set(x, -0.5, z); g.add(t); }\n    add(g, post(5, 0.1, CREAM, -w * 0.5, 0, -5), post(5, 0.1, CREAM, w * 0.5, 0, -5));\n    g.add(bunting(-w * 0.5, 4.9, -5, w * 0.5, 4.9, -5, 18));\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(-w * 0.34 - 0.5, 0, -2.4);\n    this.walrus.root.rotation.y = 0.6;\n    this.walrus.rig.loop('bounce');\n    g.add(this.walrus.root);\n    this.game.setBackdrop(45, -130);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(8.6, (n - 1) * 3.8 + 2);\n    this.game.rig.shot(0, 5.4, d, 0, 1.1, -0.2, { snap, rate: 4 });\n  }\n  hudSetup(hud) {\n    hud.setScore(0, 'Plates up');\n    this.bandTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, 'Hoop: still'));\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'plates_intro'), { auto: 3, top: true }); }\n  bandOf(w) { for (const k of Object.keys(BANDS)) { const b = BANDS[k]; if (w >= b.lo && w <= b.hi) return k; } return null; }\n  fixedEvent(dt) {\n    const decay = this.cfg.decay * tun.plateDecay, gain = 0.45 * tun.plateGain;\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost') continue;\n      this.drive(lane, dt);\n      const w = lane.hoop;\n      lane.phase += w * dt;\n      for (const p of lane.plates) {\n        lane.aliveMax += dt;\n        if (p.state === 'on') {\n          lane.alive += dt;\n          const inBand = w >= p.band.lo && w <= p.band.hi;\n          p.energy += (inBand ? gain - decay : -decay) * dt;\n          p.energy = Math.min(1, p.energy);\n          if (p.energy <= 0) this.crash(lane, p);\n          else if (p.was < 0.25 && p.energy >= 0.35 && lane.kind === 'local') { this.bark('bolster', 'plate_save', 2, 8); p.was = p.energy; }\n          if (p.energy < p.was || p.energy > p.was + 0.1) p.was = p.energy;\n          p.spin += (2 + p.energy * 14) * dt;\n          p.wobble = Math.max(0, 0.45 - p.energy) * 1.8;\n        } else {\n          p.back -= dt;\n          if (p.back <= 0) { p.state = 'on'; p.energy = 0.5; p.disc.visible = true; p.gauge.visible = true; p.was = 0.5; this.game.audio.sfx('boing'); }\n        }\n      }\n    }\n    for (let i = this.shards.length - 1; i >= 0; i--) {\n      const s = this.shards[i];\n      s.t += dt;\n      if (s.t > 2.6) { this.world.removeRigidBody(s.body); this.group.remove(s.mesh); this.shards.splice(i, 1); }\n    }\n  }\n  drive(lane, dt) {\n    const i = lane.input;\n    let target = 0;\n    if (i.device === 'kbm' && (i.keysActive || lane.keyTime > 0) && lane.kind === 'local' && !this.game.input.pointerActive) {\n      // Keys: alternate A and D. Each press is half a turn, so your tapping speed sets the hoop.\n      const tap = i.tapA ? 'a' : i.tapD ? 'd' : null;\n      if (tap && tap !== lane.lastKey) {\n        const gap = this.t - lane.lastTap;\n        if (gap < 1.2) lane.keyRate = lane.keyRate ? lane.keyRate * 0.5 + (1 / gap) * 0.5 : 1 / gap;\n        lane.lastTap = this.t; lane.lastKey = tap; lane.keyTime = 1;\n      }\n      if (this.t - lane.lastTap > 0.9) { lane.keyRate *= Math.exp(-3 * dt); lane.keyTime = 0; }\n      target = lane.keyRate * Math.PI;\n      lane.prevAng = null;\n    } else {\n      // Stick or mouse: angular velocity of the weight vector when it is out past .5.\n      const m = Math.hypot(i.wishX, i.wishZ);\n      if (m > 0.5) {\n        const a = Math.atan2(i.wishZ, i.wishX);\n        if (lane.prevAng !== null) {\n          let d = a - lane.prevAng;\n          while (d > Math.PI) d -= Math.PI * 2;\n          while (d < -Math.PI) d += Math.PI * 2;\n          const inst = Math.abs(d) / dt;\n          lane.omegaSm += (inst - lane.omegaSm) * (1 - Math.exp(-dt / 0.12));\n        }\n        lane.prevAng = a;\n      } else { lane.prevAng = null; lane.omegaSm *= Math.exp(-3 * dt); }\n      target = lane.omegaSm;\n    }\n    // The hoop has inertia, so changing speed takes time.\n    lane.hoop += (target - lane.hoop) * (1 - Math.exp(-dt / 0.5));\n  }\n  crash(lane, p) {\n    p.state = 'off'; p.back = 6; p.disc.visible = false; p.gauge.visible = false;\n    lane.crashes++;\n    const pos = p.group.position;\n    this.game.audio.sfx('plateCrash');\n    for (let k = 0; k < 6; k++) {\n      const a = (k / 6) * 6.283;\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(pos.x + Math.cos(a) * 0.12, 1.75, pos.z + Math.sin(a) * 0.12).setLinvel(Math.cos(a) * 1.5, 1, Math.sin(a) * 1.5).setAngvel({ x: cos(-6, 6), y: cos(-6, 6), z: cos(-6, 6) }).setCanSleep(false));\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.09, 0.02, 0.09).setMass(0.01).setFriction(0.6).setRestitution(0.3).setCollisionGroups(groups.prop(lane.id)), body);\n      const mesh = M(geo.box(0.18, 0.04, 0.18), p.band.colour);\n      this.group.add(mesh);\n      this.shards.push({ body, mesh, t: 0 });\n    }\n    this.game.comic.pop('SMASH!', pos.x, 2.6, pos.z, { size: 1.8 });\n    if (lane.kind === 'local') { this.bark('bolster', 'plate_fall', 2, 5); this.game.input.rumble(0.5, 0.4, 150); }\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    // Pick the band of the lowest plate; rotate at the band's middle, with reaction time and speed error.\n    let low = null;\n    for (const p of lane.plates) if (p.state === 'on' && (!low || p.energy < low.energy)) low = p;\n    const d = bot.data;\n    d.react = (d.react || 0) - 1 / 120;\n    if (d.react <= 0) {\n      d.react = bot.s.lag + 0.4;\n      const b = low ? low.band : BANDS.M;\n      d.want = (b.lo + b.hi) / 2 + (bot.r() - 0.5) * 2 * bot.s.speedErr * 0.7;\n    }\n    d.ang = (d.ang || 0) + (d.want || 0) * (1 + Math.sin(bot.t * 1.3) * 0.04) * (1 / 120);\n    const rad = 0.9;\n    out.wishX = Math.cos(d.ang) * rad; out.wishZ = Math.sin(d.ang) * rad;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    hud.setTime(this.cfg.time - this.t);\n    hud.setScore(me.plates.filter((p) => p.state === 'on').length, 'Plates up');\n    const k = this.bandOf(me.hoop);\n    const s = k ? `Hoop: ${BANDS[k].name}` : me.hoop < 1 ? 'Hoop: still' : 'Hoop: between';\n    if (this.bandTag && this.bandTag.textContent !== s) this.bandTag.textContent = s;\n  }\n  frameEvent(dt) {\n    for (const lane of this.lanes) {\n      if (!lane.plates) continue;\n      for (const p of lane.plates) {\n        if (p.state !== 'on') continue;\n        p.disc.rotation.y = p.spin;\n        const w = p.wobble;\n        p.disc.rotation.x = Math.sin(p.spin * 0.6) * w; p.disc.rotation.z = Math.cos(p.spin * 0.6) * w;\n        p.gauge.geometry = arcGeo(Math.max(0, Math.min(1, p.energy)));\n        p.gauge.rotation.y = 0;\n        p.gauge.lookAt(this.game.camera.position);\n        p.disc.position.x = Math.sin(p.spin * 0.6) * w * 0.15;\n      }\n      const k = this.bandOf(lane.hoop);\n      lane.bandRing.material = toon(k ? BANDS[k].colour : 0xE9D7A8);\n      lane.doll.rig.scrub('hipCircle', ((lane.phase / (Math.PI * 2)) % 1 + 1) % 1, { fade: 0.1 });\n      lane.hoopMesh.position.x = Math.cos(lane.phase) * 0.14; lane.hoopMesh.position.z = Math.sin(lane.phase) * 0.14;\n    }\n    for (const s of this.shards) { const p = s.body.translation(), q = s.body.rotation(); s.mesh.position.set(p.x, p.y, p.z); s.mesh.quaternion.set(q.x, q.y, q.z, q.w); }\n    if (this.walrus) this.walrus.update(dt);\n  }\n  isDone() { return this.t >= this.cfg.time; }\n  laneResult(lane) {\n    const share = lane.aliveMax ? lane.alive / lane.aliveMax : 0;\n    const form = Math.max(0, 200 * share - 100);\n    return { form, raw: share, big: Math.round(form), stats: `${Math.round(share * 100)}% of plate-time up · ${lane.crashes} smashed` };\n  }\n}\nexport { TEAL, ORANGE };\nEOF\ncat > src/events/islandLoop.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { Doll, paintColour } from '../art/doll.js';\nimport { Trudy } from '../art/cast.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\nimport { tun } from '../core/tuning.js';\n\nconst R = 19, STEP = 1.4, TARGET = 2.5;\nconst _v = new THREE.Vector3(), _iq = new THREE.Quaternion();\n\n/** Jog the ring road behind Retired Kevin. Alternate your feet. The island tilts as you go. */\nexport class IslandLoop extends EventBase {\n  static id = 'islandLoop';\n  constructor(spec) {\n    super(spec);\n    this.discs = false; this.customPose = true; this.seaLevel = -6.4;\n    this.ang = Math.PI * 0.5; this.travel = 0; this.dist = (this.cfg.laps * 2 * Math.PI * R);\n    this.rate = 0; this.lastStep = -9; this.lastFoot = null; this.speed = 0; this.inBand = 0; this.time = 0; this.shells = 0; this.stumbles = 0; this.steps = 0;\n    this.done = false; this.shellList = [];\n    this.stepIntervals = [];\n  }\n  build() {\n    const g = this.game;\n    g.setIsland('home');\n    super.build();\n    this.game.setIsland('home');\n    this.game.sea.setLevel(-6.4);\n    g.phys.setPosition(Math.cos(this.ang) * R, Math.sin(this.ang) * R);\n    g.programme.syncIsland();\n    const lane = this.lanes[0];\n    this.group.remove(lane.doll.root);\n    g.art.group.add(lane.doll.root);\n    lane.doll.rig.loop('jog');\n    lane.doll.flatFeet = false;\n    const kevin = this.kevin = new Doll({ shirt: '#6FB7D6', hat: 'visor', shorts: 0x38503A });\n    kevin.flatFeet = false;\n    kevin.rig.loop('jog');\n    g.art.group.add(kevin.root);\n    this.kevinAng = this.ang + 0.42;\n    this.trudySmall = new Trudy();\n    this.trudySmall.root.scale.setScalar(0.42);\n    lane.doll.joints.spine.add(this.trudySmall.root);\n    this.trudySmall.root.position.set(0.34, 0.5, 0);\n    // Shells on the path.\n    for (let i = 0; i < 16 * this.cfg.laps; i++) {\n      const a = this.ang + 0.3 + (i / (16 * this.cfg.laps)) * this.cfg.laps * Math.PI * 2 * 0.97;\n      const r = R + Math.sin(i * 2.1) * 0.5;\n      const s = M(geo.sphere(0.2, 10, 8), i % 2 ? 0xF4B6C8 : 0xFFF3DC, Math.cos(a) * r, 0.14, Math.sin(a) * r, { scale: [1, 0.5, 1.2] });\n      g.art.group.add(s);\n      this.shellList.push({ s, a, x: Math.cos(a) * r, z: Math.sin(a) * r, taken: false });\n    }\n    this.cameraShot(true);\n  }\n  buildLane(lane) {\n    const p = this.game.save.profile;\n    lane.doll = new Doll({ shirt: lane.colour || (p ? paintColour(p.paint) : '#2CB5A0'), hat: lane.hat });\n    this.group.add(lane.doll.root);\n    lane.bal = null;\n    lane.doll.rig.loop('jog');\n  }\n  get tangent() { return [-Math.sin(this.ang), Math.cos(this.ang)]; }\n  cameraShot(snap) {\n    const g = this.game, p = g.phys.pos;\n    const [tx, tz] = this.tangent;\n    g.art.group.updateWorldMatrix(true, false);\n    _v.set(p.x, 0.9, p.z).applyMatrix4(g.art.group.matrixWorld);\n    g.rig.shot(_v.x - tx * 7.5, _v.y + 3.6, _v.z - tz * 7.5, _v.x + tx * 2.5, _v.y + 0.8, _v.z + tz * 2.5, { snap, rate: 5, fov: 44 });\n  }\n  hudSetup(hud) {\n    this.pace = hud.addWidget(hud.meter('Pace', '#6FD6B8'));\n    this.lapTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, 'Lap 1'));\n    hud.setScore(0, 'Shells');\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'loop_intro'), { auto: 3, top: true }); }\n  fixedEvent(dt) {\n    const g = this.game, ph = g.phys;\n    const lane = this.lanes[0], i = lane.input;\n    this.time += dt;\n    if (!this.done) {\n      let foot = null;\n      if (i.footLPressed) foot = 'L'; else if (i.footRPressed) foot = 'R';\n      if (foot) {\n        if (foot === this.lastFoot) { this.stumbles++; this.stumble = 0.3; g.audio.sfx('clack'); } else {\n          const gap = this.t - this.lastStep;\n          if (gap < 1.5) { this.stepIntervals.push(gap); if (this.stepIntervals.length > 5) this.stepIntervals.shift(); }\n          this.lastStep = this.t; this.lastFoot = foot; this.steps++;\n          g.audio.sfx('thud', { pitch: 220 });\n        }\n      }\n      const silent = this.t - this.lastStep;\n      const mean = this.stepIntervals.length ? this.stepIntervals.reduce((a, b) => a + b, 0) / this.stepIntervals.length : 0;\n      this.rate = mean > 0 && silent < 1 ? 1 / mean : Math.max(0, this.rate - dt * 2);\n      const want = this.rate * STEP;\n      this.speed += (want - this.speed) * (1 - Math.exp(-dt / 0.3));\n      if (this.stumble > 0) { this.stumble -= dt; this.speed *= 0.99; }\n      const band = this.cfg.band;\n      const inBand = this.rate >= TARGET * (1 - band) && this.rate <= TARGET * (1 + band);\n      if (inBand) this.inBand += dt;\n      if (this.t % 7 < dt) {\n        if (this.rate > TARGET * (1 + band)) this.bark('trudy', 'loop_fast', 2.2, 6);\n        else if (this.rate > 0.1 && this.rate < TARGET * (1 - band)) this.bark('trudy', 'loop_slow', 2.2, 6);\n        else this.bark('trudy', 'loop_ride', 3, 6);\n      }\n      // Steering is screen-relative: sideways on the stick moves you across the road.\n      const p = ph.pos;\n      const a = Math.atan2(p.z, p.x);\n      this.ang = a;\n      const [tx, tz] = this.tangent;\n      const nx = Math.cos(a), nz = Math.sin(a);\n      const steerX = i.moveX || 0;\n      // Screen right when running along the tangent is the inner or outer side of the ring.\n      const side = -steerX;\n      ph.wantX = tx * this.speed + nx * side * 3;\n      ph.wantZ = tz * this.speed + nz * side * 3;\n      this.travel += this.speed * dt;\n      if (this.travel >= this.dist) { this.done = true; g.audio.sfx('bell'); }\n      for (const s of this.shellList) {\n        if (!s.taken && Math.hypot(s.x - p.x, s.z - p.z) < 1) { s.taken = true; s.s.visible = false; this.shells++; g.audio.sfx('marble'); }\n      }\n      this.kevinAng += ((3.5 / R) * (1 + Math.max(0, Math.min(0.1, (this.ang - this.kevinAng + 0.42) * 0.1)))) * dt;\n    } else { ph.wantX = 0; ph.wantZ = 0; }\n    g.stepIsland(dt, 1);\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    out.footLPressed = false; out.footRPressed = false; out.moveX = 0; out.moveZ = 0;\n    const d = bot.data;\n    const err = { sharp: 0.03, average: 0.08, clumsy: 0.16 }[bot.skillName] ?? 0.08;\n    d.next = d.next ?? 0.3;\n    d.next -= 1 / 120;\n    if (d.next <= 0) {\n      d.next = (1 / TARGET) * (1 + (bot.r() - 0.5) * 2 * err);\n      d.foot = d.foot === 'L' ? 'R' : 'L';\n      if (d.foot === 'L') { out.footLPressed = true; out.footL = 1; } else { out.footRPressed = true; out.footR = 1; }\n    } else { out.footL = 0; out.footR = 0; }\n    const p = this.game.phys.pos, r = Math.hypot(p.x, p.z);\n    // Steer the racing line.\n    out.moveX = Math.max(-1, Math.min(1, (r - R) * 1.2));\n    out.useMove = true;\n    out.wishX = out.moveX; out.wishZ = 0;\n  }\n  hud() {\n    const hud = this.game.hud;\n    hud.setScore(this.shells, 'Shells');\n    hud.setTime(null);\n    if (this.pace) this.pace.set(this.rate / (TARGET * 1.4));\n    const lap = Math.min(this.cfg.laps, 1 + Math.floor(this.travel / (2 * Math.PI * R)));\n    const s = `Lap ${lap} of ${this.cfg.laps}`;\n    if (this.lapTag && this.lapTag.textContent !== s) this.lapTag.textContent = s;\n  }\n  frameEvent(dt) {\n    const g = this.game, ph = g.phys, lane = this.lanes[0], d = lane.doll, p = ph.pos;\n    g.syncIsland(dt);\n    this.cameraShot(false);\n    _iq.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w).invert();\n    d.root.position.set(p.x, 0, p.z);\n    d.root.quaternion.copy(_iq);\n    const [tx, tz] = this.tangent;\n    d.face(Math.atan2(tx, tz));\n    d.rig.loop('jog', { speed: Math.max(0.5, this.rate / 1.9) });\n    d.update(dt);\n    this.trudySmall.update(dt);\n    this.trudySmall.feel(Math.sin(this.t * 1.1));\n    const k = this.kevin, ka = this.kevinAng;\n    k.root.position.set(Math.cos(ka) * R, 0, Math.sin(ka) * R);\n    k.root.quaternion.copy(_iq);\n    k.face(Math.atan2(-Math.sin(ka), Math.cos(ka)));\n    k.update(dt);\n  }\n  isDone() { return this.done; }\n  laneResult() {\n    const share = this.inBand / Math.max(1, this.time);\n    const raw = share * 100 + this.shells * 0.25;\n    return { form: (100 * raw) / this.cfg.par, raw, big: Math.round(raw), stats: `${Math.round(share * 100)}% at a good pace · ${this.shells} shells · ${this.stumbles} stumbles` };\n  }\n  dispose() {\n    const g = this.game, lane = this.lanes[0];\n    g.art.group.remove(lane.doll.root); g.art.group.remove(this.kevin.root);\n    for (const s of this.shellList) g.art.group.remove(s.s);\n    g.phys.wantX = 0; g.phys.wantZ = 0;\n    super.dispose();\n  }\n}\nexport { G, add, rot2, tun };\nEOF\n","description":"Write Log Reps, Plank, Tug, Step Class, Plates and Island Loop"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":27945,"cache_read_input_tokens":383323,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":27945},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"fb18f6ee-a379-4a17-8478-4f26ae9327f1","timestamp":"2026-11-05T12:32:24.210Z","request_id":"req_011CgjnGagTDSDqyJmZYXZX4","wire_tool_inputs":{"toolu_019Q2SHevT7PfbCeoc15mAVW":{"command":"cat > src/events/logReps.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { post, crate, WOOD_D, WOOD, RED, TEAL, CREAM, tree } from '../art/props.js';\nimport { Walrus } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst TEMPO = { down: 2, pause: 0.5, up: 2, rest: 0.5 };\nconst REP = TEMPO.down + TEMPO.pause + TEMPO.up + TEMPO.rest;\nconst DEG = Math.PI / 180;\n\n/** A log on your shoulders, a tempo ribbon, and a walrus who can't count. */\nexport class LogReps extends EventBase {\n  static id = 'logReps';\n  constructor(spec) {\n    super(spec);\n    this.balanceParams = { margin: 0.8, ankleMax: 6 };\n    this.seaLevel = -3;\n    this.rep = 0; this.repT = 0; this.repLen = REP;\n    this.totalReps = this.cfg.reps + (this.cfg.noBonus ? 0 : 2);\n    this.bonusFrom = this.cfg.noBonus ? 99 : this.cfg.reps;\n    this.total = this.totalReps * REP;\n    this.finished = false; this.saidLast = false;\n  }\n  setupLane(lane) {\n    lane.depth = 0; lane.bandT = 0; lane.zoneT = 0; lane.repN = 0; lane.score = 0; lane.maxScore = 0; lane.offset = 0; lane.logFall = 0; lane.logLost = false; lane.lastRepScore = 0;\n    lane.logBody = null;\n    const log = lane.logMesh = G('log', 0, 1.18, -0.08);\n    add(log, M(geo.cyl(0.11, 0.11, 2.3, 14), 0x9A6E3E, 0, 0, 0, { rot: [0, 0, Math.PI / 2] }), M(geo.cyl(0.115, 0.115, 0.02, 14), 0xE4C491, 1.15, 0, 0, { rot: [0, 0, Math.PI / 2], shadow: false }), M(geo.cyl(0.115, 0.115, 0.02, 14), 0xE4C491, -1.15, 0, 0, { rot: [0, 0, Math.PI / 2], shadow: false }));\n    lane.doll.root.add(log);\n    lane.doll.rig.scrub('squat', 0, { fade: 0 });\n    lane.bandHW = 0.16;\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length, w = Math.max(12, n * 3.2 + 8);\n    add(g, M(geo.box(w + 12, 1, 14), 0xE6CDA0, 0, -0.5, -1));\n    for (let i = 0; i < 8; i++) add(g, M(geo.box(w + 12, 0.01, 0.1), 0xD2B684, 0, 0.005, -7 + i * 2));\n    add(g, post(3, 0.16, WOOD_D, -w / 2 + 0.5, 0, -4), post(3, 0.16, WOOD_D, w / 2 - 0.5, 0, -4), M(geo.cyl(0.13, 0.13, w, 12), WOOD, 0, 2.9, -4, { rot: [0, 0, Math.PI / 2] }));\n    for (let i = 0; i < 4; i++) add(g, M(geo.cyl(0.22, 0.22, 2.6, 12), WOOD_D, -w / 2 + 1.8 + (i % 2) * 0.1, 0.22 + (i > 1 ? 0.38 : 0), -2.6 - (i % 2) * 0.45, { rot: [0, 0, Math.PI / 2] }));\n    const c = crate(1); c.position.set(w / 2 - 1.2, 0, -2); g.add(c);\n    for (const [x, z] of [[-w / 2 - 1.5, -5.5], [w / 2 + 1, -6], [2, -8]]) { const t = tree(2.6, 1.3); t.position.set(x, 0, z); g.add(t); }\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(this.lanes[0].x - 2.3, 0, -0.6);\n    this.walrus.root.rotation.y = 0.45;\n    g.add(this.walrus.root);\n    this.walrus.rig.loop('bounce');\n    this.game.setBackdrop(60, -130);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(7.6, (n - 1) * 3.2 + 3);\n    const px = n > 1 ? 0 : -1.5;\n    this.game.rig.shot(px, 2, d, n > 1 ? 0 : -0.7, 1.05, 0, { snap, rate: 4 });\n    this.inputYaw = n > 1 ? 0 : Math.atan2(px + 0.7, d);\n  }\n  hudSetup(hud) {\n    const wrap = h('div.tag', { style: 'position:relative;width:9rem;height:38rem;padding:0;overflow:hidden' });\n    this.bandEl = h('div', { style: 'position:absolute;left:0;right:0;background:#9BE08F;border-top:.4rem solid #2F8F46;border-bottom:.4rem solid #2F8F46' });\n    this.depthEl = h('div', { style: 'position:absolute;left:0;right:0;height:1rem;background:#1A1420' });\n    wrap.append(this.bandEl, this.depthEl);\n    this.ribbon = hud.addWidget(wrap, true);\n    hud.setScore(0, 'Rep');\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'intro'), { auto: 3, top: true }); }\n  tempoAt(t) {\n    // Where the ribbon is, 0 up to 1 down, at this time into a rep.\n    const k = tun.repTempo;\n    const down = TEMPO.down / k, pause = TEMPO.pause / k, up = TEMPO.up / k;\n    if (t < down) return t / down;\n    if (t < down + pause) return 1;\n    if (t < down + pause + up) return 1 - (t - down - pause) / up;\n    return 0;\n  }\n  get repLength() { return REP / tun.repTempo; }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    this.repT += dt;\n    const fat = Math.min(1, this.rep / Math.max(1, this.totalReps - 1));\n    const sway = this.ramp(c.sway[0], c.sway[1], fat), tremor = this.ramp(c.tremor[0], c.tremor[1], fat);\n    const target = this.tempoAt(this.repT);\n    const hw = this.ramp(c.band[0], c.band[1], fat);\n    this.target = target; this.bandHW = hw;\n    const shake = this.ramp(0.015, 0.07, fat) * Math.sin(this.t * 19);\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      const b = lane.bal, i = lane.input;\n      b.sway = sway; b.tremor = tremor;\n      if (i.device === 'kbm' && lane.kind === 'local') {\n        const both = i.footL > 0.5 && i.footR > 0.5;\n        lane.depth = Math.max(0, Math.min(1, lane.depth + (both ? 1 : -1) * (dt / (TEMPO.down / tun.repTempo))));\n      } else lane.depth = (i.footL + i.footR) / 2;\n      const measured = lane.depth + shake;\n      // The log is a rule, not a contact: a number that grows with sideways lean.\n      if (!lane.logLost && !lane.fallen) {\n        const deg = b.leanX / DEG;\n        if (Math.abs(deg) > 6) lane.offset += 0.05 * (Math.abs(deg) - 6) * Math.sign(deg) * dt;\n        else lane.offset += -Math.sign(lane.offset) * Math.min(Math.abs(lane.offset), 0.03 * dt);\n        b.extX += 0.06 * 9.81 * lane.offset;\n        if (Math.abs(lane.offset) >= 0.5) this.dropLog(lane);\n      }\n      if (!lane.fallen && !lane.logLost) {\n        if (Math.abs(measured - target) < hw) lane.bandT += dt;\n        if (Math.hypot(lane.dotX, lane.dotZ) < c.zone) lane.zoneT += dt;\n      }\n      if (lane.logMesh && !lane.logLost) lane.logMesh.position.x = lane.offset;\n      lane.lean = Math.abs(b.leanX);\n      if (lane.kind === 'local' && fat > 0.3 && this.t % 2 < dt) this.game.input.rumble(0.1 + fat * 0.3, 0.1 + fat * 0.2, 180);\n      if (lane.kind === 'local' && b.lean > 0.38) this.bark('bolster', 'near', 2, 5);\n    }\n    if (this.repT >= this.repLength) this.endRep();\n    for (const lane of this.lanes) if (lane.logBody) this.updateFallingLog(lane, dt);\n  }\n  endRep() {\n    const len = this.repLength;\n    const worth = this.rep >= this.bonusFrom ? 2 : 1;\n    for (const lane of this.lanes) {\n      if (!lane.bal) continue;\n      const s = (lane.bandT / len) * (0.5 + 0.5 * (lane.zoneT / len));\n      lane.score += s * worth; lane.maxScore += worth;\n      lane.lastRepScore = s;\n      lane.bandT = 0; lane.zoneT = 0; lane.repN++;\n    }\n    this.rep++; this.repT = 0;\n    this.game.audio.sfx('thud', { pitch: 150 });\n    const solo = this.mode === 'solo';\n    if (this.rep === this.bonusFrom - 1 && solo) this.game.speech.say('bolster', \"That's the last one!\", { auto: 2.2, top: true });\n    else if (this.rep === this.bonusFrom && solo) { this.game.speech.say('bolster', \"...THIS one's the last one. I've lied to you and I'd do it again.\", { auto: 3, top: true }); this.game.hud.setNote('Two bonus reps. Worth double.', 2.6); this.walrus.rig.once('salute'); }\n    else if (solo && this.rep < this.bonusFrom - 1) this.game.speech.say('bolster', line('bolster', 'rep', { n: this.rep }), { auto: 2.2, top: true });\n    if (this.rep >= this.totalReps) this.finished = true;\n    this.walrus.rig.once(this.rep % 2 ? 'clap' : 'bounce');\n  }\n  dropLog(lane) {\n    lane.logLost = true;\n    lane.logMesh.visible = false;\n    const b = lane.bal.body.translation();\n    const off = lane.offset;\n    const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(b.x + off, b.y + 0.5, b.z).setCanSleep(false));\n    this.world.createCollider(RAPIER.ColliderDesc.cuboid(1.15, 0.11, 0.11).setMass(0.1).setFriction(0.7).setCollisionGroups(groups.prop(lane.id)), body);\n    lane.logBody = body;\n    const m = G();\n    add(m, M(geo.cyl(0.11, 0.11, 2.3, 14), 0x9A6E3E, 0, 0, 0, { rot: [0, 0, Math.PI / 2] }));\n    this.group.add(m);\n    lane.logFree = m;\n    lane.logFall = 1.6;\n    lane.offset = 0;\n    this.game.audio.sfx('clack');\n    this.walrus.rig.once('catch');\n    if (lane.kind === 'local') this.bark('bolster', 'log_drop', 2.4, 2);\n  }\n  updateFallingLog(lane, dt) {\n    lane.logFall -= dt;\n    if (lane.logFall <= 0) {\n      this.world.removeRigidBody(lane.logBody);\n      lane.logBody = null;\n      this.group.remove(lane.logFree);\n      lane.logFree = null;\n      lane.logLost = false;\n      lane.logMesh.visible = true;\n      lane.logMesh.position.x = 0;\n    }\n  }\n  onFall(lane) { if (lane.kind === 'local') this.bark('bolster', 'fall', 2.6, 3); lane.bandT = 0; lane.zoneT = 0; }\n  flailed(lane) { if (lane.kind === 'local') this.bark('bolster', 'flail', 2, 6); }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const [x, z] = bot.steer(0, 0, true);\n    out.wishX = x; out.wishZ = z;\n    // Follow the ribbon, a moment late, with a tracking error.\n    const err = { sharp: 0.05, average: 0.12, clumsy: 0.2 }[bot.skillName] ?? 0.12;\n    const tt = Math.max(0, this.repT - bot.s.delay);\n    const v = Math.max(0, Math.min(1, this.tempoAt(tt) + err * Math.sin(bot.t * 3.1 + bot.ph) * 1.2));\n    out.footL = v; out.footR = v;\n    out.flail = !lane.fallen && lane.bal.lean > 0.6 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    const shown = this.rep < this.bonusFrom ? `${Math.min(this.rep + 1, this.cfg.reps)}/${this.cfg.reps}` : `${this.cfg.reps}+${this.rep - this.bonusFrom + 1}`;\n    hud.setScore(shown, 'Rep');\n    hud.setTime(null);\n    if (this.bandEl) {\n      const tg = this.target ?? 0, hw = this.bandHW ?? 0.16;\n      this.bandEl.style.top = `${Math.max(0, (tg - hw) * 100)}%`;\n      this.bandEl.style.height = `${hw * 200}%`;\n      this.depthEl.style.top = `calc(${(me.depth || 0) * 100}% - .5rem)`;\n    }\n    for (const lane of this.lanes) lane.discView.zone = { x: 0, z: 0, r: this.cfg.zone, on: Math.hypot(lane.dotX, lane.dotZ) < this.cfg.zone };\n  }\n  frameEvent(dt) {\n    for (const lane of this.lanes) {\n      if (lane.doll && !lane.fallen) {\n        lane.doll.rig.scrub('squat', lane.depth || 0);\n        if (lane.logMesh) lane.logMesh.position.y = 1.18 - (lane.depth || 0) * 0.27;\n      }\n      if (lane.logBody && lane.logFree) { const p = lane.logBody.translation(), q = lane.logBody.rotation(); lane.logFree.position.set(p.x, p.y, p.z); lane.logFree.quaternion.set(q.x, q.y, q.z, q.w); }\n    }\n    if (this.walrus) this.walrus.update(dt);\n  }\n  isDone() { return this.finished; }\n  laneResult(lane) {\n    const form = lane.maxScore ? (100 * lane.score) / lane.maxScore : 0;\n    return { form, raw: lane.score, big: Math.round(form), stats: `${lane.repN} reps · ${lane.falls} floor exercises` };\n  }\n}\nexport { THREE, TEAL, CREAM, RED };\nEOF\ncat > src/events/plank.js <<'EOF'\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { post, planks, palm, umbrella, buoy, WOOD, WOOD_D, CREAM, SAND, RED, TEAL } from '../art/props.js';\nimport { Gull, Walrus } from '../art/cast.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\nimport { cos } from '../core/rng.js';\n\nconst SPOTS = [[0.55, 1.22, 0.05], [0.28, 1.12, 0.06], [0, 1.1, 0.05], [-0.28, 1.08, 0.06], [-0.5, 1.03, 0.05], [0.8, 1.18, 0.02], [-0.72, 0.98, 0.02], [0.14, 1.16, -0.05], [-0.14, 1.12, -0.05], [0.42, 1.2, -0.05], [-0.38, 1.08, -0.05], [0.65, 1.2, -0.04]];\n\n/** Hold a plank pose. Gulls land on you and push. Being covered in gulls is a win condition. */\nexport class Plank extends EventBase {\n  static id = 'plank';\n  constructor(spec) {\n    super(spec);\n    this.god = true; this.seaLevel = -1.2; this.customPose = true;\n    this.next = 2.5; this.side = this.r() < 0.5 ? -1 : 1; this.gulls = []; this.inT = 0; this.outT = 0; this.flops = 0; this.flopT = 0; this.flails = 0;\n    this.spotI = 0;\n  }\n  setupLane(lane) { lane.doll.rig.loop('plank'); lane.bal.moveFoot(lane.x, 0, 0); }\n  buildSet() {\n    const g = this.group;\n    add(g, M(geo.box(70, 1, 22), SAND, 0, -0.5, -3));\n    const beam = G('', 0, 0.42, 0);\n    add(beam, M(geo.box(2.6, 0.16, 0.5), WOOD), post(0.36, 0.06, WOOD_D, -1.1, -0.42, 0), post(0.36, 0.06, WOOD_D, 1.1, -0.42, 0));\n    g.add(beam);\n    const pier = planks(40, 4, { top: 0.8, thick: 0.2 });\n    pier.position.set(0, 2, -7);\n    g.add(pier);\n    for (let i = 0; i < 8; i++) add(g, post(3, 0.14, WOOD_D, -18 + i * 5, -0.2, -5.4), post(3, 0.14, WOOD_D, -18 + i * 5, -0.2, -8.6));\n    const u = umbrella(RED); u.position.set(-6, 0, -3); g.add(u);\n    const u2 = umbrella(TEAL); u2.position.set(6.5, 0, -2); g.add(u2);\n    const p = palm(3.6); p.position.set(-9, 0, -5); g.add(p);\n    const b = buoy(); b.position.set(9, 0.4, -5); g.add(b);\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(3.6, 0, -1);\n    this.walrus.root.rotation.y = -0.5;\n    this.walrus.rig.loop('stand');\n    g.add(this.walrus.root);\n    // The doll lies along x, head to screen right.\n    const lane = this.lanes[0];\n    lane.doll.root.position.set(0, 0.55, 0);\n    this.game.setBackdrop(-45, -120);\n  }\n  cameraShot(snap) { this.game.rig.shot(0, 1.7, 6.4, 0, 1, 0, { snap, rate: 4 }); }\n  hudSetup(hud) { hud.setScore(0, 'Gulls'); }\n  start() { this.next = 2.5; if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'plank_intro'), { auto: 3, top: true }); }\n  addGull() {\n    const c = this.cfg;\n    const push = c.push[0] + this.r() * (c.push[1] - c.push[0]);\n    if (this.r() > 0.7) this.side = -this.side;\n    const gull = new Gull();\n    const i = this.spotI++ % SPOTS.length;\n    const s = SPOTS[i];\n    const dir = this.side;\n    const spot = [Math.abs(s[0]) * dir, s[1], s[2]];\n    const from = [dir * 9 + cos(-1, 1), 5 + cos(0, 2), -3 + cos(-1, 1)];\n    gull.root.position.set(...from);\n    gull.root.rotation.y = -dir * 1.2;\n    gull.rig.loop('fly');\n    this.group.add(gull.root);\n    this.gulls.push({ gull, push: push * dir, t: 0, dur: 1.2, from, spot, landed: false, leave: false });\n    this.game.audio.sfx('squawk');\n    this.bark('bolster', 'gull', 2.2, 8);\n  }\n  netPush() { let n = 0; for (const g of this.gulls) if (g.landed && !g.leave) n += g.push; return n; }\n  scatter() {\n    for (const g of this.gulls) if (!g.leave) { g.leave = true; g.t = 0; g.from = [g.gull.root.position.x, g.gull.root.position.y, g.gull.root.position.z]; g.spot = [Math.sign(g.push) * 12, 7, -6]; g.dur = 1.3; g.landed = false; g.gull.rig.loop('fly'); }\n  }\n  fixedEvent(dt) {\n    const c = this.cfg, lane = this.lanes[0], b = lane.bal;\n    b.sway = c.sway; b.tremor = 0.05;\n    this.next -= dt;\n    if (this.next <= 0 && this.t < c.time - 2 && this.flopT <= 0) { this.next = c.every; this.addGull(); }\n    for (let i = this.gulls.length - 1; i >= 0; i--) {\n      const g = this.gulls[i];\n      g.t += dt;\n      const k = Math.min(1, g.t / g.dur), e = k * k * (3 - 2 * k), r = g.gull.root;\n      if (!g.landed) {\n        r.position.set(g.from[0] + (g.spot[0] - g.from[0]) * e, g.from[1] + (g.spot[1] - g.from[1]) * e + (g.leave ? 0 : Math.sin(k * 3.14) * 0.5), g.from[2] + (g.spot[2] - g.from[2]) * e);\n        if (k >= 1) {\n          if (g.leave) { this.group.remove(r); this.gulls.splice(i, 1); continue; }\n          g.landed = true; g.gull.rig.loop('stand'); g.gull.rig.once('land');\n          this.game.audio.sfx('gullLand');\n          this.game.input.rumble(0.05, 0.25, 90);\n        }\n      }\n    }\n    b.extX += this.netPush() * this.diff.dist;\n    const r = Math.hypot(lane.dotX, lane.dotZ), inZone = r < c.zone;\n    if (this.flopT > 0) {\n      this.flopT -= dt;\n      if (this.flopT <= 0) { lane.bal.recover(); this.game.audio.sfx('spring'); }\n    } else if (inZone) { this.inT += dt; this.outT = 0; } else {\n      this.outT += dt;\n      if (this.outT > 2) {\n        this.flopT = 1.6; this.outT = 0; this.flops++;\n        lane.falls++;\n        this.scatter();\n        this.game.audio.sfx('fall'); this.game.comic.pop('FLOMP!', 0, 1.5, 0); this.game.rig.shake(0.07);\n        this.game.onFloorExercise();\n        this.game.input.rumble(0.8, 0.6, 280);\n        if (lane.kind === 'local') this.bark('bolster', 'flop', 2.6, 1);\n      }\n    }\n  }\n  flailed(lane) {\n    if (this.gulls.some((g) => !g.leave)) {\n      this.flails++;\n      this.scatter();\n      this.game.audio.sfx('squawk');\n      this.walrus.rig.once('salute');\n      if (lane.kind === 'local') this.bark('bolster', 'shake_off', 2.6, 2);\n    }\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    // Counter the net push. It takes K − G of stiffness to hold it still.\n    const gx = -this.netPush() / 3.3;\n    const [x, z] = bot.steer(Math.max(-0.9, Math.min(0.9, gx)), 0);\n    out.wishX = x; out.wishZ = z;\n    bot.data.out = Math.hypot(lane.dotX, lane.dotZ) > this.cfg.zone ? (bot.data.out || 0) + 1 / 120 : 0;\n    out.flail = bot.data.out > 1.2 && lane.bal.lean > 0.2 && lane.bal.flailCool <= 0;\n  }\n  hud() {\n    const hud = this.game.hud;\n    hud.setTime(this.cfg.time - this.t);\n    hud.setScore(this.gulls.filter((g) => g.landed && !g.leave).length, 'Gulls');\n    const lane = this.lanes[0];\n    lane.discView.zone = { x: 0, z: 0, r: this.cfg.zone, on: Math.hypot(lane.dotX, lane.dotZ) < this.cfg.zone };\n  }\n  frameEvent(dt) {\n    const lane = this.lanes[0], d = lane.doll, b = lane.bal;\n    // Lying flat along x. The doll rocks with the core.\n    d.root.position.set(0, this.flopT > 0 ? 0.3 : 0.6, 0);\n    d.root.rotation.set(b.leanZ * 0.3, 0, Math.PI / 2 * 0 - b.leanX * 0.3);\n    d.facing.rotation.set(0, 0, 0);\n    d.facing.rotation.y = Math.PI / 2;\n    d.facing.rotation.z = 0;\n    d.facing.rotation.x = 0;\n    d.joints.hips.rotation.x = Math.PI / 2 * 1;\n    for (const g of this.gulls) {\n      g.gull.update(dt);\n      if (g.landed && !g.leave) { g.gull.root.position.y = g.spot[1] - 0.1 + (this.flopT > 0 ? -0.3 : 0) - b.leanX * 0.3 * g.spot[0]; }\n    }\n    if (this.walrus) this.walrus.update(dt);\n  }\n  isDone() { return this.t >= this.cfg.time; }\n  laneResult() {\n    const share = (100 * this.inT) / this.cfg.time;\n    const on = this.gulls.filter((g) => g.landed && !g.leave).length;\n    const raw = share + on * 2 - this.flails * 3;\n    return { form: (100 * raw) / this.cfg.par, raw, big: Math.round(raw), stats: `${Math.round(share)}% in the zone · ${on} gulls still on you · ${this.flops} flops` };\n  }\n}\nexport { h, CREAM };\nEOF\ncat > src/events/tug.js <<'EOF'\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { SAND, CREAM, rope, umbrella, palm, RED, TEAL } from '../art/props.js';\nimport { Doll } from '../art/doll.js';\nimport { Walrus } from '../art/cast.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst CALL = 1.2, DEG = Math.PI / 180;\n/** The rope is one number. Heave on the call. How far you dare lean is the game. */\nexport class Tug extends EventBase {\n  static id = 'tug';\n  constructor(spec) {\n    super(spec);\n    this.god = false; this.seaLevel = -2; this.customPose = true;\n    this.rope = 0; this.pull = 1; this.wins = [0, 0]; this.next = 1.2; this.callN = 0; this.ease = 0; this.easeT = this.cfg.ease || 0; this.done = false; this.pause = 0;\n    this.teams = null;\n  }\n  laneX(i) { return 0; }\n  setupLane(lane) {\n    lane.team = lane.id % 2;\n    lane.pressT = -9; lane.power = 0; lane.sat = 0; lane.lastPress = -9; lane.wasBoth = false;\n    lane.doll.rig.loop('tug');\n  }\n  get solo() { return this.lanes.length === 1; }\n  buildSet() {\n    const g = this.group;\n    add(g, M(geo.box(120, 1, 40), SAND, 0, -0.5, -8));\n    for (let i = -6; i <= 6; i++) add(g, M(geo.box(0.08, 0.01, 1.6), i === 0 ? RED : CREAM, i * 1, 0.006, 0, { shadow: false }));\n    add(g, M(geo.box(0.16, 0.012, 2), RED, -6.2, 0.006, 0, { shadow: false }), M(geo.box(0.16, 0.012, 2), RED, 6.2, 0.006, 0, { shadow: false }));\n    const u = umbrella(RED); u.position.set(-9, 0, -4); g.add(u);\n    const u2 = umbrella(TEAL); u2.position.set(8, 0, -5); g.add(u2);\n    const p = palm(3.8); p.position.set(0, 0, -7); g.add(p);\n    this.ropeG = G('');\n    this.ropeM = rope(-5, 1.05, 0, 5, 1.05, 0, 0.1, 0.05);\n    this.ropeG.add(this.ropeM);\n    add(this.ropeG, M(geo.sphere(0.12, 10, 8), RED, 0, 1, 0, { scale: [1, 1.2, 1] }));\n    g.add(this.ropeG);\n    // Solo: you and Retired Kevin against Both Sandras.\n    this.extra = [];\n    if (this.solo) {\n      const kevin = new Doll({ shirt: '#6FB7D6', hat: 'visor', shorts: 0x38503A });\n      const s1 = new Doll({ shirt: '#E78FB3', hat: 'bucket', height: 0.96, shorts: 0x7A3F5A }), s2 = new Doll({ shirt: '#E78FB3', hat: 'bucket', height: 0.96, shorts: 0x7A3F5A });\n      this.kevin = kevin; this.sandras = [s1, s2];\n      for (const d of [kevin, s1, s2]) { g.add(d.root); d.rig.loop('tug'); d.flatFeet = false; this.extra.push(d); }\n    }\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(0.2, 0, -3.2);\n    this.walrus.rig.loop('bounce');\n    g.add(this.walrus.root);\n    this.game.setBackdrop(30, -125);\n  }\n  cameraShot(snap) { this.game.rig.shot(0, 2.3, 11, 0, 1.1, 0, { snap, rate: 4, fov: 38 }); }\n  hudSetup(hud) { this.scoreTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, '')); this.ropeBar = hud.addWidget(hud.meter('Rope', '#E8644A')); hud.setScore('0-0', 'Pulls'); }\n  start() { this.next = 1.4; if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'tug_intro'), { auto: 3, top: true }); }\n  fixedEvent(dt) {\n    const c = this.cfg;\n    if (this.pause > 0) { this.pause -= dt; for (const l of this.lanes) if (l.bal) { l.bal.sway = 0.05; } return; }\n    this.next -= dt;\n    if (this.next <= 0) {\n      this.callT = this.t; this.next = CALL; this.callN++;\n      this.game.hud.flash('HEAVE!', 0.45);\n      this.game.audio.sfx('metronome', { vel: 1 });\n      this.walrus.rig.once('clap');\n      this.judgeT = this.t + 0.3;\n      this.judged = false;\n      for (const l of this.lanes) { l.timing = 0; l.share = 0; }\n    }\n    // Their pull forward. Your lean back is plus z.\n    const theirPower = this.solo ? c.power * (1 + (this.ropeNoise || 0)) : 0.3;\n    if (c.ease) {\n      this.easeT -= dt;\n      if (this.easeT <= 0) { this.ease = 0.8; this.easeT = c.ease * (0.8 + this.r() * 0.4); this.easeHit = false; if (this.mode === 'solo') this.bark('bolster', 'tug_ease', 2, 4); this.game.hud.setNote('They eased off!', 0.8); }\n    }\n    const easing = this.ease > 0;\n    if (easing) this.ease -= dt;\n    for (const lane of this.lanes) {\n      const b = lane.bal, i = lane.input;\n      if (!b) continue;\n      b.sway = 0.06;\n      if (!easing) b.extZ += -(0.1 + 0.3 * theirPower) * this.diff.dist;\n      const share = Math.max(0, b.leanZ / b.maxLean);\n      lane.shareNow = share;\n      if (easing && !this.easeHit && share > 0.72 && !lane.fallen) { lane.sat = 0.5; }\n      if (lane.sat > 0) {\n        lane.sat -= dt;\n        b.extZ += 3.2;\n      }\n      const both = (i.footL > 0.5 && i.footR > 0.5) || i.hop;\n      if (both && !lane.wasBoth) lane.lastPress = this.t;\n      lane.wasBoth = both;\n      if (this.callT !== undefined && Math.abs(lane.lastPress - this.callT) <= 0.3 && !lane.fallen) {\n        const tim = Math.max(0, 1 - Math.abs(lane.lastPress - this.callT) / 0.3);\n        if (tim > (lane.timing || 0)) lane.timing = tim;\n        lane.share = Math.max(lane.share || 0, share);\n      }\n    }\n    if (this.judgeT !== undefined && !this.judged && this.t >= this.judgeT) {\n      this.judged = true;\n      this.judge();\n    }\n    this.rope = Math.max(-1, Math.min(1, this.rope));\n    if (Math.abs(this.rope) >= 1) this.endPull(this.rope > 0 ? 0 : 1);\n  }\n  judge() {\n    const c = this.cfg;\n    const power = (l) => (l.fallen ? 0 : (l.timing || 0) * (l.share || 0));\n    let a = 0, b = 0, na = 0, nb = 0;\n    for (const l of this.lanes) { if (!l.bal) continue; const p = power(l); l.power = p; if (l.team === 0) { a += p; na++; } else { b += p; nb++; } }\n    const ours = na ? a / na : 0;\n    let theirs;\n    if (nb) theirs = b / nb;\n    else theirs = c.power * (0.8 + this.r() * 0.4);\n    this.rope += (ours - theirs) * 0.33;\n    this.ropeNoise = (this.r() - 0.5) * 0.4;\n    this.game.audio.sfx('thud', { pitch: 130 });\n  }\n  endPull(winner) {\n    this.wins[winner]++;\n    const me = this.lanes[0];\n    this.game.audio.sfx('bell');\n    if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', winner === 0 ? 'tug_win' : 'tug_lose'), { auto: 2.8, top: true });\n    this.game.hud.flash(winner === 0 ? 'Pull won!' : 'Pull lost', 1.5);\n    if (winner === 0 && me.kind === 'local') this.game.fx.confetti(0, 5, 0, 60, [0xE8443A, 0xF5B700, 0x2CB5A0, 0xFFF3DC], 5);\n    this.rope = 0; this.pause = 2.4; this.next = 1.4; this.pull++;\n    this.ease = 0; this.callT = undefined;\n    if (this.wins[0] >= 2 || this.wins[1] >= 2 || this.pull > 3) this.done = true;\n  }\n  onFall(lane) {\n    // Lean back too far when the other side eases off and you sit down hard.\n    this.rope += lane.team === 0 ? -0.3 : 0.3;\n    if (lane.kind === 'local') this.bark('bolster', 'tug_sit', 2.6, 2);\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const stick = lane.tugStick ?? 0.9;\n    const [x, z] = bot.steer(0, stick, true);\n    out.wishX = x * 0.3; out.wishZ = Math.max(z, stick);\n    const dueIn = this.next + bot.timingOff;\n    bot.timingOff = bot.timingOff ?? bot.timing();\n    const press = this.next <= Math.max(0, 0.04 + (bot.data.err ?? 0));\n    if (this.next > 1) bot.data.err = bot.timing();\n    const v = press || (this.callT !== undefined && this.t - this.callT < 0.12) ? 1 : 0;\n    out.footL = v; out.footR = v;\n    out.flail = !lane.fallen && lane.bal.lean > 0.52 && lane.bal.flailCool <= 0;\n    return dueIn;\n  }\n  hud() {\n    const hud = this.game.hud;\n    hud.setScore(`${this.wins[0]}-${this.wins[1]}`, 'Pulls');\n    hud.setTime(null);\n    if (this.ropeBar) this.ropeBar.set((this.rope + 1) / 2);\n    if (this.scoreTag) { const s = `Pull ${Math.min(3, this.pull)} of 3`; if (this.scoreTag.textContent !== s) this.scoreTag.textContent = s; }\n  }\n  placeDoll(d, x, faceRight, leanBack, y = 0) {\n    d.root.position.set(x, y, 0);\n    d.face(faceRight ? Math.PI / 2 : -Math.PI / 2);\n    d.root.rotation.set(0, 0, (faceRight ? 1 : -1) * leanBack);\n    d.setLean && 0;\n  }\n  frameEvent(dt) {\n    const r = this.rope * 1.4;\n    this.ropeG.position.x = -r;\n    const positions = this.solo ? [] : [[-3.4, true], [3.4, false], [-5, true], [5, false]];\n    this.lanes.forEach((l, i) => {\n      if (l.fallen) return;\n      const left = this.solo ? true : l.team === 0;\n      const x = this.solo ? -3.4 : positions[i][0];\n      const lean = Math.max(0, l.bal ? l.bal.leanZ * 0.8 : 0);\n      this.placeDoll(l.doll, x - r, left, lean);\n      l.bal.moveFoot(x - r, 0, 0);\n    });\n    if (this.solo) {\n      this.placeDoll(this.kevin, -5 - r, true, 0.28 + Math.sin(this.t * 3) * 0.04);\n      this.placeDoll(this.sandras[0], 3.4 - r, false, 0.3 + Math.sin(this.t * 3.1) * 0.04);\n      this.placeDoll(this.sandras[1], 5 - r, false, 0.3 + Math.sin(this.t * 3.1) * 0.04);\n      for (const d of this.extra) d.update(dt);\n    }\n    if (this.walrus) this.walrus.update(dt);\n  }\n  isDone() { return this.done; }\n  laneResult(lane) {\n    const won = lane.team === 0 ? this.wins[0] : this.wins[1];\n    const form = Math.max(0, 40 + 30 * won - 5 * lane.falls);\n    return { form, raw: won, big: `${won} won`, stats: `Pulls ${this.wins[0]}-${this.wins[1]} · ${lane.falls} sat down` };\n  }\n}\nexport { DEG };\nEOF\ncat > src/events/stepClass.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { M, G, geo, toon, add, basic } from '../art/materials.js';\nimport { post, pavilionRoof, bunting, TEAK, CREAM, TEAL, ORANGE } from '../art/props.js';\nimport { Doll } from '../art/doll.js';\nimport { Walrus } from '../art/cast.js';\nimport { chartNotes } from '../data/charts.js';\nimport { tun } from '../core/tuning.js';\nimport { cos, cosPick } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst CLASS_COLOURS = ['#C9A0DC', '#6FB7D6', '#E78FB3', '#F5C84A', '#7FA650', '#E8644A', '#5AA9E6', '#F2A65A'];\nconst LEAD = 2.4; // seconds a footprint is on the deck before it arrives\nconst DIRS = { '<': [-1, 0], '>': [1, 0], '^': [0, -1], v: [0, 1] };\nconst NOTE_COL = { L: 0x7FB4E8, R: 0xE8707A, B: 0xF5B700 };\n\n/** Footprints slide toward your feet. The class copies you. Miss one and somebody trips. */\nexport class StepClass extends EventBase {\n  static id = 'stepClass';\n  constructor(spec) {\n    super(spec);\n    this.seaLevel = -5; this.god = true;\n    const ch = chartNotes(this.cfg.chart, this.cfg.bpm);\n    this.notes = ch.notes; this.length = ch.length; this.beat = ch.beat;\n    this.clock = -0.0; this.ownsMusic = true;\n    this.max = this.notes.length;\n    this.pulse = 0; this.lastBeat = -1;\n    this.nextClick = 0;\n  }\n  setupLane(lane) {\n    lane.judge = this.notes.map(() => ({ done: false, score: 0 }));\n    lane.sum = 0; lane.combo = 0; lane.best = 0; lane.perfect = 0; lane.miss = 0; lane.lastWord = '';\n    lane.doll.rig.loop('stand');\n    lane.fx = 0;\n    lane.wasBoth = false;\n    lane.leanScored = 0;\n    lane.prints = [];\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length, w = Math.max(12, n * 3.2 + 7);\n    add(g, M(geo.cyl(w * 0.72, w * 0.76, 1, 8), CREAM, 0, -0.5, -2), M(geo.cyl(w * 0.7, w * 0.7, 0.04, 8), TEAK, 0, -0.01, -2));\n    add(g, M(geo.box(w * 2.4, 1, 50), 0x8CCB6A, 0, -1.2, -8));\n    // Footprint tracks.\n    for (const lane of this.lanes) {\n      add(g, M(geo.box(0.62, 0.012, LEAD * 3.4), 0xE9D7A8, lane.x - 0.42, 0.012, -LEAD * 1.7 + 0.5, { shadow: false }), M(geo.box(0.62, 0.012, LEAD * 3.4), 0xE9D7A8, lane.x + 0.42, 0.012, -LEAD * 1.7 + 0.5, { shadow: false }));\n      lane.markL = M(geo.sphere(0.2, 12, 8), 0x7FB4E8, lane.x - 0.42, 0.016, 0.5, { scale: [1, 0.05, 1.4], shadow: false });\n      lane.markR = M(geo.sphere(0.2, 12, 8), 0xE8707A, lane.x + 0.42, 0.016, 0.5, { scale: [1, 0.05, 1.4], shadow: false });\n      add(g, lane.markL, lane.markR);\n    }\n    const roof = pavilionRoof(w * 0.85, TEAL, ORANGE);\n    roof.position.set(0, 7.6, -2);\n    g.add(roof);\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * 6.283 + 0.39;\n      add(g, post(7.6, 0.13, CREAM, Math.cos(a) * w * 0.68, 0, -2 + Math.sin(a) * w * 0.68));\n    }\n    for (let i = 0; i < 8; i++) {\n      const a = (i / 8) * 6.283 + 0.39, b = ((i + 1) / 8) * 6.283 + 0.39;\n      g.add(bunting(Math.cos(a) * w * 0.68, 6.4, -2 + Math.sin(a) * w * 0.68, Math.cos(b) * w * 0.68, 6.4, -2 + Math.sin(b) * w * 0.68, 7));\n    }\n    // A class of eight behind you, getting more in sync as your combo grows.\n    this.klass = [];\n    for (let i = 0; i < 8; i++) {\n      const d = new Doll({ shirt: CLASS_COLOURS[i], hat: cosPick(['none', 'visor', 'bucket', 'beret', 'perm', 'none']), height: cos(0.9, 1.06), width: cos(0.95, 1.05) });\n      d.flatFeet = false;\n      const row = i < 4 ? 0 : 1;\n      d.root.position.set((i % 4 - 1.5) * 2.2 + row * 0.8, 0, -4 - row * 2);\n      d.rig.loop('stand');\n      g.add(d.root);\n      this.klass.push({ d, lag: 0, tripT: 0 });\n    }\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(-w * 0.42, 0, -1.4);\n    this.walrus.root.rotation.y = 0.7;\n    this.walrus.rig.loop('bounce', { speed: this.cfg.bpm / 75 });\n    g.add(this.walrus.root);\n    // Spotlights that swing at a combo of 16.\n    this.spots = [];\n    for (const x of [-w * 0.32, w * 0.32]) {\n      const s = new THREE.SpotLight(0xFFE9A8, 0, 26, 0.42, 0.5, 1.2);\n      s.position.set(x, 7.2, -1);\n      s.target.position.set(0, 0, 0);\n      add(g, s, s.target);\n      this.spots.push(s);\n    }\n    this.printPool = [];\n    this.printGeo = geo.sphere(0.2, 12, 8);\n    this.ribbonGeo = geo.box(1, 0.02, 0.5);\n    this.prints = this.notes.map(() => null);\n    this.game.setIsland('hidden');\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(8.5, (n - 1) * 3.2 + 2);\n    this.game.rig.shot(0, 2.9, d, 0, 1.15, -1, { snap, rate: 4 });\n  }\n  hudSetup(hud) { this.comboTag = hud.addWidget(h('div.tag', { style: 'font-size:3.8rem' }, 'Combo 0')); hud.setScore(0, 'Form'); }\n  musicOpts() { return { bpm: this.cfg.bpm }; }\n  start() {\n    const a = this.game.audio;\n    this.useAudio = !this.game.params.manual && a.state === 'running';\n    a.music('cardio', { bpm: this.cfg.bpm, at: a.ctx ? a.ctx.currentTime + 0.05 : undefined, fade: 0.2 });\n    this.clock = 0;\n    if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'step_intro'), { auto: 3, top: true });\n  }\n  /** Step timing comes from the audio clock, minus output latency, when audio runs; otherwise the sim clock. */\n  syncClock() {\n    if (!this.useAudio) return;\n    const a = this.game.audio, seq = a.seq;\n    if (!seq || seq.id !== 'cardio' || seq.paused) return;\n    const lat = a.ctx.outputLatency || 0;\n    const want = seq.position() - lat;\n    const d = want - this.clock;\n    if (Math.abs(d) > 0.25) this.clock = want; else this.clock += d * 0.1;\n  }\n  windows() {\n    const k = tun.rhythmWindow * this.diff.rhythm;\n    return { perfect: 0.045 * k, good: 0.09 * k, ok: 0.135 * k };\n  }\n  fixedEvent(dt) {\n    this.clock += dt;\n    const offset = this.game.save.settings.rhythmOffset / 1000;\n    const now = this.clock - offset;\n    // Click every note on the sound bus: music is only 10%, so the beat must read without it.\n    const a = this.game.audio;\n    while (this.nextClick < this.notes.length && this.notes[this.nextClick].t <= now + 0.1) {\n      const nt = this.notes[this.nextClick];\n      if (a.mix && a.state === 'running') a.mix.playSfx('foot', a.ctx.currentTime + Math.max(0, nt.t - now), { note: nt.lean ? 76 : nt.type === 'L' ? 84 : nt.type === 'R' ? 88 : 93, vel: 0.9 });\n      this.nextClick++;\n    }\n    const beatN = Math.floor(now / this.beat);\n    if (beatN !== this.lastBeat) { this.lastBeat = beatN; this.pulse = 1; }\n    const win = this.windows();\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost') continue;\n      const i = lane.input;\n      const both = i.hopPressed || (i.footL > 0.5 && i.footR > 0.5 && !lane.wasBoth);\n      lane.wasBoth = i.footL > 0.5 && i.footR > 0.5;\n      if (both) this.press(lane, 'B', now, win);\n      else {\n        if (i.footLPressed) this.press(lane, 'L', now, win);\n        if (i.footRPressed) this.press(lane, 'R', now, win);\n      }\n      // Lean notes score when the dot passes .25 in that direction: full within 1.5 beats, half within 2.\n      this.notes.forEach((n, k) => {\n        const j = lane.judge[k];\n        if (j.done) return;\n        if (n.lean) {\n          if (now < n.t - 0.75 * this.beat) return;\n          const [dx, dz] = DIRS[n.type];\n          const proj = lane.dotX * dx + lane.dotZ * dz;\n          const dtN = now - n.t;\n          if (proj > 0.25) {\n            const s = dtN <= 1.5 * this.beat ? 1 : 0.5;\n            this.score(lane, k, s, s === 1 ? 'Lean!' : 'Late');\n          } else if (dtN > 2 * this.beat) this.miss(lane, k);\n        } else if (now - n.t > win.ok) this.miss(lane, k);\n      });\n    }\n  }\n  press(lane, type, now, win) {\n    // Nearest unjudged foot note of a matching type; both-foot notes accept a hop, single notes a press.\n    let best = -1, bd = 1e9;\n    for (let k = 0; k < this.notes.length; k++) {\n      const n = this.notes[k];\n      if (n.lean || lane.judge[k].done) continue;\n      if (n.t - now > win.ok) break;\n      if (type === 'B' ? n.type !== 'B' : n.type !== type && n.type !== 'B') continue;\n      const d = Math.abs(now - n.t);\n      if (d < bd) { bd = d; best = k; }\n    }\n    this.stepPose(lane, type);\n    if (best < 0 || bd > win.ok) return;\n    const n = this.notes[best];\n    if (n.type === 'B' && type !== 'B') {\n      // A both-foot note wants both feet: one foot gets half marks only if the other comes too.\n      const other = type === 'L' ? lane.input.footR : lane.input.footL;\n      if (other < 0.5) return;\n    }\n    const s = bd <= win.perfect ? 1 : bd <= win.good ? 0.7 : 0.4;\n    if (s === 1) lane.perfect++;\n    this.score(lane, best, s, s === 1 ? 'Perfect' : s > 0.5 ? 'Good' : 'OK');\n  }\n  stepPose(lane, type) {\n    // Mirrored on purpose: your left is the doll's right as it faces you.\n    if (type === 'L') lane.doll.rig.once('stepR');\n    else if (type === 'R') lane.doll.rig.once('stepL');\n    else lane.doll.rig.once('hop', { speed: 1.6 });\n    this.game.audio.sfx('thud', { pitch: 200 });\n  }\n  score(lane, k, s, word) {\n    lane.judge[k].done = true; lane.judge[k].score = s;\n    lane.sum += s;\n    lane.combo++;\n    lane.best = Math.max(lane.best, lane.combo);\n    lane.lastWord = word;\n    if (lane.kind === 'local') {\n      this.game.hud.setNote(word, 0.5);\n      if (lane.combo === 16) {\n        this.game.fx.confetti(0, 7, -1, 120, [0xE8443A, 0xF5B700, 0x2CB5A0, 0x5AA9E6, 0xFFF3DC], 7);\n        this.bark('bolster', 'step_combo', 2.4, 3);\n        for (const sp of this.spots) sp.intensity = 90;\n      }\n    }\n    this.flashPrint(k);\n  }\n  miss(lane, k) {\n    lane.judge[k].done = true;\n    lane.combo = 0; lane.miss++;\n    lane.lastWord = 'Miss';\n    for (const sp of this.spots) sp.intensity = 0;\n    // A miss makes someone in the class trip.\n    const c = this.klass[Math.floor(cos(0, this.klass.length))];\n    if (c && c.tripT <= 0) { c.tripT = 1.1; c.d.rig.once('flop', { speed: 1.2, hold: 0.5 }); this.game.audio.sfx('clack'); }\n    if (lane.kind === 'local') { this.game.hud.setNote('Miss', 0.5); this.bark('bolster', 'step_miss', 2.2, 7); }\n  }\n  flashPrint(k) { const p = this.prints[k]; if (p) { this.group.remove(p); this.prints[k] = null; } }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    const now = this.clock - this.game.save.settings.rhythmOffset / 1000;\n    out.footLPressed = false; out.footRPressed = false; out.hopPressed = false; out.hop = false;\n    out.footL = 0; out.footR = 0;\n    let lean = null;\n    bot.data.err = bot.data.err || {};\n    for (let k = 0; k < this.notes.length; k++) {\n      const n = this.notes[k];\n      if (lane.judge[k].done) continue;\n      if (n.t > now + 1) break;\n      if (n.lean) { if (!lean && n.t - now < 0.45) lean = n; continue; }\n      if (bot.data.err[k] === undefined) bot.data.err[k] = bot.chance(0.03 + (bot.s.timing > 0.06 ? 0.04 : 0)) ? 9 : bot.timing();\n      const due = n.t + bot.data.err[k];\n      if (now >= due && now < due + 0.1) {\n        if (n.type === 'L') { out.footLPressed = true; out.footL = 1; } else if (n.type === 'R') { out.footRPressed = true; out.footR = 1; } else { out.hopPressed = true; out.hop = true; }\n      }\n    }\n    let gx = 0, gz = 0;\n    if (lean) { [gx, gz] = DIRS[lean.type]; gx *= 0.7; gz *= 0.7; }\n    const [x, z] = bot.steer(gx, gz);\n    out.wishX = lean ? gx * 1.3 : x; out.wishZ = lean ? gz * 1.3 : z;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    hud.setTime(Math.max(0, this.length - this.clock));\n    hud.setScore(Math.round((100 * me.sum) / this.max), 'Form');\n    if (this.comboTag) { const s = `Combo ${me.combo}`; if (this.comboTag.textContent !== s) this.comboTag.textContent = s; }\n  }\n  frameEvent(dt) {\n    const now = this.clock;\n    this.pulse = Math.max(0, this.pulse - dt * 6);\n    const lane0 = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    // Footprints for the notes coming up.\n    this.notes.forEach((n, k) => {\n      const until = n.t - now;\n      if (lane0.judge && lane0.judge[k] && lane0.judge[k].done) { this.flashPrint(k); return; }\n      if (until < LEAD && until > -0.4) {\n        let p = this.prints[k];\n        if (!p) {\n          p = this.makePrint(n);\n          this.prints[k] = p;\n          this.group.add(p);\n        }\n        const z = 0.5 - (until / LEAD) * LEAD * 2.6;\n        p.position.z = z;\n        p.scale.setScalar(1 + (until < 0.15 ? this.pulse * 0.4 : 0));\n      } else if (until <= -0.4) this.flashPrint(k);\n    });\n    for (const lane of this.lanes) {\n      if (lane.markL) { const s = 1 + this.pulse * 0.25; lane.markL.scale.set(s, 0.05, 1.4 * s); lane.markR.scale.set(s, 0.05, 1.4 * s); }\n      if (lane.doll && lane.kind !== 'ghost' && this.lastBeat >= 0 && lane.doll.rig.onceLeft <= 0) lane.doll.rig.loop('stand');\n    }\n    // The class gets more in sync as your combo grows.\n    const combo = lane0.combo || 0;\n    const sync = Math.min(1, combo / 16);\n    const beat = this.lastBeat;\n    this.klass.forEach((c, i) => {\n      c.tripT = Math.max(0, c.tripT - dt);\n      c.d.update(dt);\n      if (c.tripT > 0) return;\n      const phase = (now / this.beat + (1 - sync) * i * 0.37) % 2;\n      if (Math.floor(phase) !== c.lastF) {\n        c.lastF = Math.floor(phase);\n        c.d.rig.once(c.lastF ? 'stepL' : 'stepR');\n      }\n    });\n    if (combo >= 16) {\n      const s = Math.sin(now * 1.6) * 3;\n      this.spots[0].target.position.set(s, 0, 0); this.spots[1].target.position.set(-s, 0, 0);\n    }\n    if (this.walrus) this.walrus.update(dt);\n    return beat;\n  }\n  makePrint(n) {\n    const lane = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const g = G();\n    const m = (x, c) => M(this.printGeo, c, lane.x + x, 0.03, 0, { scale: [1, 0.12, 1.4], shadow: false });\n    if (n.lean) {\n      const [dx, dz] = DIRS[n.type];\n      const bar = M(geo.box(1.5, 0.02, 0.32), 0x9BE08F, lane.x, 0.03, 0, { shadow: false });\n      const arrow = M(geo.cone(0.24, 0.42, 4), 0x2F8F46, lane.x + dx * 0.6, 0.06, dz * 0.25, { rot: [Math.PI / 2, 0, Math.atan2(-dx, -dz)], scale: [1, 1, 0.2], shadow: false });\n      add(g, bar, arrow);\n    } else {\n      if (n.type === 'L' || n.type === 'B') g.add(m(-0.42, NOTE_COL[n.type]));\n      if (n.type === 'R' || n.type === 'B') g.add(m(0.42, NOTE_COL[n.type]));\n    }\n    return g;\n  }\n  onResume() { this.syncClock(); }\n  afterStep() { if (this.useAudio && (this.stepCount++ % 12 === 0)) this.syncClock(); }\n  isDone() { return this.clock >= this.length; }\n  laneResult(lane) {\n    const form = (100 * (lane.sum || 0)) / Math.max(1, this.max);\n    return { form, raw: lane.sum, big: Math.round(form), stats: `Best combo ${lane.best} · ${lane.perfect} perfect · ${lane.miss} missed` };\n  }\n}\nexport { toon, basic };\nEOF\ncat > src/events/plates.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase, RAPIER } from './base.js';\nimport { groups } from '../physics/world.js';\nimport { M, G, geo, add, toon } from '../art/materials.js';\nimport { post, CREAM, RED, TEAL, ORANGE, bunting, tree } from '../art/props.js';\nimport { Walrus } from '../art/cast.js';\nimport { tun } from '../core/tuning.js';\nimport { cos } from '../core/rng.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\n\nconst BANDS = { L: { lo: 3.5, hi: 5, r: 0.46, colour: 0x2CB5A0, name: 'Large' }, M: { lo: 6.5, hi: 8, r: 0.36, colour: 0xF08A3C, name: 'Medium' }, S: { lo: 9.5, hi: 11, r: 0.27, colour: 0xE8443A, name: 'Small' } };\nconst arcs = [];\nfunction arcGeo(k) {\n  const i = Math.round(k * 20);\n  if (!arcs[i]) { arcs[i] = new THREE.RingGeometry(0.5, 0.62, 28, 1, Math.PI / 2, Math.max(0.001, (i / 20) * Math.PI * 2)); }\n  return arcs[i];\n}\n/** Circle your weight to drive the hoop. Each plate needs its own speed. Everything else is decaying. */\nexport class Plates extends EventBase {\n  static id = 'plates';\n  constructor(spec) {\n    super(spec);\n    this.god = true; this.seaLevel = -5;\n    this.shards = [];\n    this.spec = this.cfg.plates.split('');\n  }\n  setupLane(lane) {\n    lane.hoop = 0; lane.omega = 0; lane.omegaSm = 0; lane.prevAng = null; lane.phase = 0; lane.alive = 0; lane.aliveMax = 0; lane.crashes = 0; lane.keyTime = 0; lane.lastTap = -9; lane.lastKey = null; lane.keyRate = 0;\n    lane.plates = this.spec.map((size, i) => {\n      const a = (i / this.spec.length) * Math.PI * 2 + Math.PI * 0.5, R = 1.25;\n      const px = lane.x + Math.cos(a) * R, pz = Math.sin(a) * R;\n      const b = BANDS[size];\n      const g = G('', px, 0, pz);\n      add(g, post(1.75, 0.025, CREAM, 0, 0, 0));\n      const disc = G('', 0, 1.8, 0);\n      add(disc, M(geo.cyl(b.r, b.r * 0.72, 0.045, 24), b.colour), M(geo.tor(b.r * 0.66, 0.012), CREAM, 0, 0.03, 0, { rot: [Math.PI / 2, 0, 0], shadow: false }));\n      g.add(disc);\n      const gauge = new THREE.Mesh(arcGeo(1), toon(b.colour));\n      gauge.scale.setScalar(b.r * 1.5);\n      gauge.position.y = 2.4;\n      g.add(gauge);\n      this.group.add(g);\n      return { size, band: b, energy: 0.7, state: 'on', back: 0, group: g, disc, gauge, spin: 0, wobble: 0, was: 0.7 };\n    });\n    const hoop = lane.hoopMesh = M(geo.tor(0.62, 0.03), RED, 0, 0.72, 0, { rot: [Math.PI / 2, 0, 0] });\n    lane.doll.root.add(hoop);\n    const ringCol = lane.bandRing = M(geo.ring(0.8, 0.98, 36), 0xFFFFFF, lane.x, 0.03, 0, { shadow: false });\n    this.group.add(ringCol);\n    lane.doll.rig.scrub('hipCircle', 0, { fade: 0 });\n  }\n  buildSet() {\n    const g = this.group, n = this.lanes.length, w = Math.max(14, n * 3.8 + 8);\n    add(g, M(geo.cyl(w * 0.62, w * 0.65, 1, 40), 0xF2E3B5, 0, -0.5, -1), M(geo.ring(w * 0.58, w * 0.62, 40), RED, 0, 0.012, -1, { shadow: false }), M(geo.box(w * 4, 1, 80), 0x8CCB6A, 0, -1, -10));\n    for (const [x, z] of [[-w * 0.6, -7], [w * 0.55, -8], [0, -12], [w * 0.8, -3], [-w * 0.8, -2]]) { const t = tree(2.6, 1.4); t.position.set(x, -0.5, z); g.add(t); }\n    add(g, post(5, 0.1, CREAM, -w * 0.5, 0, -5), post(5, 0.1, CREAM, w * 0.5, 0, -5));\n    g.add(bunting(-w * 0.5, 4.9, -5, w * 0.5, 4.9, -5, 18));\n    this.walrus = new Walrus();\n    this.walrus.root.position.set(-w * 0.34 - 0.5, 0, -2.4);\n    this.walrus.root.rotation.y = 0.6;\n    this.walrus.rig.loop('bounce');\n    g.add(this.walrus.root);\n    this.game.setBackdrop(45, -130);\n  }\n  cameraShot(snap) {\n    const n = this.lanes.length, d = this.game.rig.fitDistance(8.6, (n - 1) * 3.8 + 2);\n    this.game.rig.shot(0, 5.4, d, 0, 1.1, -0.2, { snap, rate: 4 });\n  }\n  hudSetup(hud) {\n    hud.setScore(0, 'Plates up');\n    this.bandTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, 'Hoop: still'));\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'plates_intro'), { auto: 3, top: true }); }\n  bandOf(w) { for (const k of Object.keys(BANDS)) { const b = BANDS[k]; if (w >= b.lo && w <= b.hi) return k; } return null; }\n  fixedEvent(dt) {\n    const decay = this.cfg.decay * tun.plateDecay, gain = 0.45 * tun.plateGain;\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost') continue;\n      this.drive(lane, dt);\n      const w = lane.hoop;\n      lane.phase += w * dt;\n      for (const p of lane.plates) {\n        lane.aliveMax += dt;\n        if (p.state === 'on') {\n          lane.alive += dt;\n          const inBand = w >= p.band.lo && w <= p.band.hi;\n          p.energy += (inBand ? gain - decay : -decay) * dt;\n          p.energy = Math.min(1, p.energy);\n          if (p.energy <= 0) this.crash(lane, p);\n          else if (p.was < 0.25 && p.energy >= 0.35 && lane.kind === 'local') { this.bark('bolster', 'plate_save', 2, 8); p.was = p.energy; }\n          if (p.energy < p.was || p.energy > p.was + 0.1) p.was = p.energy;\n          p.spin += (2 + p.energy * 14) * dt;\n          p.wobble = Math.max(0, 0.45 - p.energy) * 1.8;\n        } else {\n          p.back -= dt;\n          if (p.back <= 0) { p.state = 'on'; p.energy = 0.5; p.disc.visible = true; p.gauge.visible = true; p.was = 0.5; this.game.audio.sfx('boing'); }\n        }\n      }\n    }\n    for (let i = this.shards.length - 1; i >= 0; i--) {\n      const s = this.shards[i];\n      s.t += dt;\n      if (s.t > 2.6) { this.world.removeRigidBody(s.body); this.group.remove(s.mesh); this.shards.splice(i, 1); }\n    }\n  }\n  drive(lane, dt) {\n    const i = lane.input;\n    let target = 0;\n    if (i.device === 'kbm' && (i.keysActive || lane.keyTime > 0) && lane.kind === 'local' && !this.game.input.pointerActive) {\n      // Keys: alternate A and D. Each press is half a turn, so your tapping speed sets the hoop.\n      const tap = i.tapA ? 'a' : i.tapD ? 'd' : null;\n      if (tap && tap !== lane.lastKey) {\n        const gap = this.t - lane.lastTap;\n        if (gap < 1.2) lane.keyRate = lane.keyRate ? lane.keyRate * 0.5 + (1 / gap) * 0.5 : 1 / gap;\n        lane.lastTap = this.t; lane.lastKey = tap; lane.keyTime = 1;\n      }\n      if (this.t - lane.lastTap > 0.9) { lane.keyRate *= Math.exp(-3 * dt); lane.keyTime = 0; }\n      target = lane.keyRate * Math.PI;\n      lane.prevAng = null;\n    } else {\n      // Stick or mouse: angular velocity of the weight vector when it is out past .5.\n      const m = Math.hypot(i.wishX, i.wishZ);\n      if (m > 0.5) {\n        const a = Math.atan2(i.wishZ, i.wishX);\n        if (lane.prevAng !== null) {\n          let d = a - lane.prevAng;\n          while (d > Math.PI) d -= Math.PI * 2;\n          while (d < -Math.PI) d += Math.PI * 2;\n          const inst = Math.abs(d) / dt;\n          lane.omegaSm += (inst - lane.omegaSm) * (1 - Math.exp(-dt / 0.12));\n        }\n        lane.prevAng = a;\n      } else { lane.prevAng = null; lane.omegaSm *= Math.exp(-3 * dt); }\n      target = lane.omegaSm;\n    }\n    // The hoop has inertia, so changing speed takes time.\n    lane.hoop += (target - lane.hoop) * (1 - Math.exp(-dt / 0.5));\n  }\n  crash(lane, p) {\n    p.state = 'off'; p.back = 6; p.disc.visible = false; p.gauge.visible = false;\n    lane.crashes++;\n    const pos = p.group.position;\n    this.game.audio.sfx('plateCrash');\n    for (let k = 0; k < 6; k++) {\n      const a = (k / 6) * 6.283;\n      const body = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(pos.x + Math.cos(a) * 0.12, 1.75, pos.z + Math.sin(a) * 0.12).setLinvel(Math.cos(a) * 1.5, 1, Math.sin(a) * 1.5).setAngvel({ x: cos(-6, 6), y: cos(-6, 6), z: cos(-6, 6) }).setCanSleep(false));\n      this.world.createCollider(RAPIER.ColliderDesc.cuboid(0.09, 0.02, 0.09).setMass(0.01).setFriction(0.6).setRestitution(0.3).setCollisionGroups(groups.prop(lane.id)), body);\n      const mesh = M(geo.box(0.18, 0.04, 0.18), p.band.colour);\n      this.group.add(mesh);\n      this.shards.push({ body, mesh, t: 0 });\n    }\n    this.game.comic.pop('SMASH!', pos.x, 2.6, pos.z, { size: 1.8 });\n    if (lane.kind === 'local') { this.bark('bolster', 'plate_fall', 2, 5); this.game.input.rumble(0.5, 0.4, 150); }\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    // Pick the band of the lowest plate; rotate at the band's middle, with reaction time and speed error.\n    let low = null;\n    for (const p of lane.plates) if (p.state === 'on' && (!low || p.energy < low.energy)) low = p;\n    const d = bot.data;\n    d.react = (d.react || 0) - 1 / 120;\n    if (d.react <= 0) {\n      d.react = bot.s.lag + 0.4;\n      const b = low ? low.band : BANDS.M;\n      d.want = (b.lo + b.hi) / 2 + (bot.r() - 0.5) * 2 * bot.s.speedErr * 0.7;\n    }\n    d.ang = (d.ang || 0) + (d.want || 0) * (1 + Math.sin(bot.t * 1.3) * 0.04) * (1 / 120);\n    const rad = 0.9;\n    out.wishX = Math.cos(d.ang) * rad; out.wishZ = Math.sin(d.ang) * rad;\n  }\n  hud() {\n    const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const hud = this.game.hud;\n    hud.setTime(this.cfg.time - this.t);\n    hud.setScore(me.plates.filter((p) => p.state === 'on').length, 'Plates up');\n    const k = this.bandOf(me.hoop);\n    const s = k ? `Hoop: ${BANDS[k].name}` : me.hoop < 1 ? 'Hoop: still' : 'Hoop: between';\n    if (this.bandTag && this.bandTag.textContent !== s) this.bandTag.textContent = s;\n  }\n  frameEvent(dt) {\n    for (const lane of this.lanes) {\n      if (!lane.plates) continue;\n      for (const p of lane.plates) {\n        if (p.state !== 'on') continue;\n        p.disc.rotation.y = p.spin;\n        const w = p.wobble;\n        p.disc.rotation.x = Math.sin(p.spin * 0.6) * w; p.disc.rotation.z = Math.cos(p.spin * 0.6) * w;\n        p.gauge.geometry = arcGeo(Math.max(0, Math.min(1, p.energy)));\n        p.gauge.rotation.y = 0;\n        p.gauge.lookAt(this.game.camera.position);\n        p.disc.position.x = Math.sin(p.spin * 0.6) * w * 0.15;\n      }\n      const k = this.bandOf(lane.hoop);\n      lane.bandRing.material = toon(k ? BANDS[k].colour : 0xE9D7A8);\n      lane.doll.rig.scrub('hipCircle', ((lane.phase / (Math.PI * 2)) % 1 + 1) % 1, { fade: 0.1 });\n      lane.hoopMesh.position.x = Math.cos(lane.phase) * 0.14; lane.hoopMesh.position.z = Math.sin(lane.phase) * 0.14;\n    }\n    for (const s of this.shards) { const p = s.body.translation(), q = s.body.rotation(); s.mesh.position.set(p.x, p.y, p.z); s.mesh.quaternion.set(q.x, q.y, q.z, q.w); }\n    if (this.walrus) this.walrus.update(dt);\n  }\n  isDone() { return this.t >= this.cfg.time; }\n  laneResult(lane) {\n    const share = lane.aliveMax ? lane.alive / lane.aliveMax : 0;\n    const form = Math.max(0, 200 * share - 100);\n    return { form, raw: share, big: Math.round(form), stats: `${Math.round(share * 100)}% of plate-time up · ${lane.crashes} smashed` };\n  }\n}\nexport { TEAL, ORANGE };\nEOF\ncat > src/events/islandLoop.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { EventBase } from './base.js';\nimport { M, G, geo, add } from '../art/materials.js';\nimport { Doll, paintColour } from '../art/doll.js';\nimport { Trudy } from '../art/cast.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { h } from '../ui/dom.js';\nimport { line } from '../data/dialogue.js';\nimport { tun } from '../core/tuning.js';\n\nconst R = 19, STEP = 1.4, TARGET = 2.5;\nconst _v = new THREE.Vector3(), _iq = new THREE.Quaternion();\n\n/** Jog the ring road behind Retired Kevin. Alternate your feet. The island tilts as you go. */\nexport class IslandLoop extends EventBase {\n  static id = 'islandLoop';\n  constructor(spec) {\n    super(spec);\n    this.discs = false; this.customPose = true; this.seaLevel = -6.4;\n    this.ang = Math.PI * 0.5; this.travel = 0; this.dist = (this.cfg.laps * 2 * Math.PI * R);\n    this.rate = 0; this.lastStep = -9; this.lastFoot = null; this.speed = 0; this.inBand = 0; this.time = 0; this.shells = 0; this.stumbles = 0; this.steps = 0;\n    this.done = false; this.shellList = [];\n    this.stepIntervals = [];\n  }\n  build() {\n    const g = this.game;\n    g.setIsland('home');\n    super.build();\n    this.game.setIsland('home');\n    this.game.sea.setLevel(-6.4);\n    g.phys.setPosition(Math.cos(this.ang) * R, Math.sin(this.ang) * R);\n    g.programme.syncIsland();\n    const lane = this.lanes[0];\n    this.group.remove(lane.doll.root);\n    g.art.group.add(lane.doll.root);\n    lane.doll.rig.loop('jog');\n    lane.doll.flatFeet = false;\n    const kevin = this.kevin = new Doll({ shirt: '#6FB7D6', hat: 'visor', shorts: 0x38503A });\n    kevin.flatFeet = false;\n    kevin.rig.loop('jog');\n    g.art.group.add(kevin.root);\n    this.kevinAng = this.ang + 0.42;\n    this.trudySmall = new Trudy();\n    this.trudySmall.root.scale.setScalar(0.42);\n    lane.doll.joints.spine.add(this.trudySmall.root);\n    this.trudySmall.root.position.set(0.34, 0.5, 0);\n    // Shells on the path.\n    for (let i = 0; i < 16 * this.cfg.laps; i++) {\n      const a = this.ang + 0.3 + (i / (16 * this.cfg.laps)) * this.cfg.laps * Math.PI * 2 * 0.97;\n      const r = R + Math.sin(i * 2.1) * 0.5;\n      const s = M(geo.sphere(0.2, 10, 8), i % 2 ? 0xF4B6C8 : 0xFFF3DC, Math.cos(a) * r, 0.14, Math.sin(a) * r, { scale: [1, 0.5, 1.2] });\n      g.art.group.add(s);\n      this.shellList.push({ s, a, x: Math.cos(a) * r, z: Math.sin(a) * r, taken: false });\n    }\n    this.cameraShot(true);\n  }\n  buildLane(lane) {\n    const p = this.game.save.profile;\n    lane.doll = new Doll({ shirt: lane.colour || (p ? paintColour(p.paint) : '#2CB5A0'), hat: lane.hat });\n    this.group.add(lane.doll.root);\n    lane.bal = null;\n    lane.doll.rig.loop('jog');\n  }\n  get tangent() { return [-Math.sin(this.ang), Math.cos(this.ang)]; }\n  cameraShot(snap) {\n    const g = this.game, p = g.phys.pos;\n    const [tx, tz] = this.tangent;\n    g.art.group.updateWorldMatrix(true, false);\n    _v.set(p.x, 0.9, p.z).applyMatrix4(g.art.group.matrixWorld);\n    g.rig.shot(_v.x - tx * 7.5, _v.y + 3.6, _v.z - tz * 7.5, _v.x + tx * 2.5, _v.y + 0.8, _v.z + tz * 2.5, { snap, rate: 5, fov: 44 });\n  }\n  hudSetup(hud) {\n    this.pace = hud.addWidget(hud.meter('Pace', '#6FD6B8'));\n    this.lapTag = hud.addWidget(h('div.tag', { style: 'font-size:3.6rem' }, 'Lap 1'));\n    hud.setScore(0, 'Shells');\n  }\n  start() { if (this.mode === 'solo') this.game.speech.say('bolster', line('bolster', 'loop_intro'), { auto: 3, top: true }); }\n  fixedEvent(dt) {\n    const g = this.game, ph = g.phys;\n    const lane = this.lanes[0], i = lane.input;\n    this.time += dt;\n    if (!this.done) {\n      let foot = null;\n      if (i.footLPressed) foot = 'L'; else if (i.footRPressed) foot = 'R';\n      if (foot) {\n        if (foot === this.lastFoot) { this.stumbles++; this.stumble = 0.3; g.audio.sfx('clack'); } else {\n          const gap = this.t - this.lastStep;\n          if (gap < 1.5) { this.stepIntervals.push(gap); if (this.stepIntervals.length > 5) this.stepIntervals.shift(); }\n          this.lastStep = this.t; this.lastFoot = foot; this.steps++;\n          g.audio.sfx('thud', { pitch: 220 });\n        }\n      }\n      const silent = this.t - this.lastStep;\n      const mean = this.stepIntervals.length ? this.stepIntervals.reduce((a, b) => a + b, 0) / this.stepIntervals.length : 0;\n      this.rate = mean > 0 && silent < 1 ? 1 / mean : Math.max(0, this.rate - dt * 2);\n      const want = this.rate * STEP;\n      this.speed += (want - this.speed) * (1 - Math.exp(-dt / 0.3));\n      if (this.stumble > 0) { this.stumble -= dt; this.speed *= 0.99; }\n      const band = this.cfg.band;\n      const inBand = this.rate >= TARGET * (1 - band) && this.rate <= TARGET * (1 + band);\n      if (inBand) this.inBand += dt;\n      if (this.t % 7 < dt) {\n        if (this.rate > TARGET * (1 + band)) this.bark('trudy', 'loop_fast', 2.2, 6);\n        else if (this.rate > 0.1 && this.rate < TARGET * (1 - band)) this.bark('trudy', 'loop_slow', 2.2, 6);\n        else this.bark('trudy', 'loop_ride', 3, 6);\n      }\n      // Steering is screen-relative: sideways on the stick moves you across the road.\n      const p = ph.pos;\n      const a = Math.atan2(p.z, p.x);\n      this.ang = a;\n      const [tx, tz] = this.tangent;\n      const nx = Math.cos(a), nz = Math.sin(a);\n      const steerX = i.moveX || 0;\n      // Screen right when running along the tangent is the inner or outer side of the ring.\n      const side = -steerX;\n      ph.wantX = tx * this.speed + nx * side * 3;\n      ph.wantZ = tz * this.speed + nz * side * 3;\n      this.travel += this.speed * dt;\n      if (this.travel >= this.dist) { this.done = true; g.audio.sfx('bell'); }\n      for (const s of this.shellList) {\n        if (!s.taken && Math.hypot(s.x - p.x, s.z - p.z) < 1) { s.taken = true; s.s.visible = false; this.shells++; g.audio.sfx('marble'); }\n      }\n      this.kevinAng += ((3.5 / R) * (1 + Math.max(0, Math.min(0.1, (this.ang - this.kevinAng + 0.42) * 0.1)))) * dt;\n    } else { ph.wantX = 0; ph.wantZ = 0; }\n    g.stepIsland(dt, 1);\n  }\n  botInput(lane, t, bot) {\n    const out = lane.input;\n    out.footLPressed = false; out.footRPressed = false; out.moveX = 0; out.moveZ = 0;\n    const d = bot.data;\n    const err = { sharp: 0.03, average: 0.08, clumsy: 0.16 }[bot.skillName] ?? 0.08;\n    d.next = d.next ?? 0.3;\n    d.next -= 1 / 120;\n    if (d.next <= 0) {\n      d.next = (1 / TARGET) * (1 + (bot.r() - 0.5) * 2 * err);\n      d.foot = d.foot === 'L' ? 'R' : 'L';\n      if (d.foot === 'L') { out.footLPressed = true; out.footL = 1; } else { out.footRPressed = true; out.footR = 1; }\n    } else { out.footL = 0; out.footR = 0; }\n    const p = this.game.phys.pos, r = Math.hypot(p.x, p.z);\n    // Steer the racing line.\n    out.moveX = Math.max(-1, Math.min(1, (r - R) * 1.2));\n    out.useMove = true;\n    out.wishX = out.moveX; out.wishZ = 0;\n  }\n  hud() {\n    const hud = this.game.hud;\n    hud.setScore(this.shells, 'Shells');\n    hud.setTime(null);\n    if (this.pace) this.pace.set(this.rate / (TARGET * 1.4));\n    const lap = Math.min(this.cfg.laps, 1 + Math.floor(this.travel / (2 * Math.PI * R)));\n    const s = `Lap ${lap} of ${this.cfg.laps}`;\n    if (this.lapTag && this.lapTag.textContent !== s) this.lapTag.textContent = s;\n  }\n  frameEvent(dt) {\n    const g = this.game, ph = g.phys, lane = this.lanes[0], d = lane.doll, p = ph.pos;\n    g.syncIsland(dt);\n    this.cameraShot(false);\n    _iq.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w).invert();\n    d.root.position.set(p.x, 0, p.z);\n    d.root.quaternion.copy(_iq);\n    const [tx, tz] = this.tangent;\n    d.face(Math.atan2(tx, tz));\n    d.rig.loop('jog', { speed: Math.max(0.5, this.rate / 1.9) });\n    d.update(dt);\n    this.trudySmall.update(dt);\n    this.trudySmall.feel(Math.sin(this.t * 1.1));\n    const k = this.kevin, ka = this.kevinAng;\n    k.root.position.set(Math.cos(ka) * R, 0, Math.sin(ka) * R);\n    k.root.quaternion.copy(_iq);\n    k.face(Math.atan2(-Math.sin(ka), Math.cos(ka)));\n    k.update(dt);\n  }\n  isDone() { return this.done; }\n  laneResult() {\n    const share = this.inBand / Math.max(1, this.time);\n    const raw = share * 100 + this.shells * 0.25;\n    return { form: (100 * raw) / this.cfg.par, raw, big: Math.round(raw), stats: `${Math.round(share * 100)}% at a good pace · ${this.shells} shells · ${this.stumbles} stumbles` };\n  }\n  dispose() {\n    const g = this.game, lane = this.lanes[0];\n    g.art.group.remove(lane.doll.root); g.art.group.remove(this.kevin.root);\n    for (const s of this.shellList) g.art.group.remove(s.s);\n    g.phys.wantX = 0; g.phys.wantZ = 0;\n    super.dispose();\n  }\n}\nexport { G, add, rot2, tun };\nEOF\n","description":"Write Log Reps, Plank, Tug, Step Class, Plates and Island Loop"}}}
