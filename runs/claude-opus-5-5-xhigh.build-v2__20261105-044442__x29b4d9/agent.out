e.results.map((r) => ({ name\n124:        input: { lastDevice: game.input.lastDevice, glyphSet: game.save.settings.glyph\n125:        audio: { state: a.state, music: a.mix ? a.mix.levels.music : 0, sfx: a.mix ? a\n126:        render: { backend: game.backend, frames: game.frames, lost: game.renderLost, m\n127:        errors: game.errors.slice(),\n130:    startEvent(id, tier = 0, opts = {}) { flowGoto(game, 'event', { id, tier, ...opts","is_error":false}]},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"8ee83bb4-5446-4b57-8b92-64df50268da1","timestamp":"2026-11-05T15:23:17.481Z","tool_use_result":{"stdout":"--- plan 786-800\n**Input stubs.** Replace `navigator.getGamepads` with `add_init_script`/`addInitScript`, returning `{ connected: true, mapping: 'standard', axes: [...], buttons: [{ pressed, value }, ...], vibrationActuator: { playEffect() {} } }` from `window.__pads`. Use `page.keyboard` and `page.mouse` for the re\n\n**The bots ✔ (the human model every skill number in this plan came from).** A delayed correction: the bot sees the dot `delay` seconds ago and sets `wish = goal + gain × (goal − dot) + noise × sin(...)`. Do not raise gain under heavy load: it oscillates and tips, which is a bot failure and not a gam\n\n| Skill | delay | gain | gain under load (stacks, log, tray, Lean Match) | noise | reaction lag | speed error (rad/s) | timing error sd |\n|---|---|---|---|---|---|---|---|\n| sharp | .16 s | 1.4 | .7 | 0 | .12 s | .3 | 28 ms |\n| average | .26 s | 1.0 | .55 | .03 | .28 s | .8 | 55 ms |\n| clumsy | .38 s | .8 | .45 | .07 | .5 s | 1.4 | 95 ms |\n\n**Keep a tally.** TASK.md asks how many issues testing caught and how many were critical. Append one line to `notes/issues.md` each time a test catches a real issue, as you go. Counting afterwards doesn't work.\n*balance:* run bots over 3 seeds per event at Tier 1 and assert: sharp reaches Exemplary (≥85) on average, average reaches Pleasant or Adequate, clumsy reaches at least Adequate (≥40), and a bot that parks the stick exactly on the goal and never corrects stays below Exemplary in Poses (measured ✔ 75-81 on Tier 1). Fruit Hat Tier 1: sharp banking at 7 has no falls and never banking has at least one. Use this test to set each `par`. This is how \"balance is key\" gets checked without a human. **Also guard against the failures I hit,** each of which looks fine until you measure it: Plate Spinners Tier 1 must separate the bots (sharp above clumsy by at least 15 points of share, stick and keys alik\n--- issue 46\n47:46. Plan audit: the balance test's three seeds were one seed for any event without random draws, because the bots ignored the seed, so skill separation in Springboard rested on one sample. Fixed.\n--- springboard botInput\n257:   botInput(lane, t, bot) {\n258:     const out = lane.input;\n259:     out.hopPressed = false; out.hop = false; out.launch = false; out.footL = 0; out.footR = 0; out.wishX = 0; out.wishZ = 0;\n260:     const d = bot.data;\n261:     if (lane.phase2 === 'pump') {\n262:       // Pump in phase: squeeze as the board goes down, with a reaction lag.\n263:       d.wait = (d.wait ?? (4.5 + bot.r() * 2.5));\n264:       const going = lane.boardV < -bot.s.lag * 0.5;\n265:       const v = going ? 1 : 0;\n266:       out.footL = v; out.footR = v;\n267:       if (lane.pumpT > d.wait && lane.boardV > 0.5 && lane.boardV > (d.prevV ?? 0)) d.armed = true;\n268:       if (d.armed && lane.boardV < (d.prevV ?? 0)) { out.hopPressed = true; out.hop = true; out.launch = true; d.armed = false; }\n269:       d.prevV = lane.boardV;\n270:     } else if (lane.phase2 === 'air') {\n271:       // Aim for a belly flop by default (a quarter turn) or a head first dive.\n272:       const goal = (d.goal ?? (d.goal = bot.r() < (lane.wantDive ? 1 : 0.15) ? Math.PI : Math.PI / 2));\n273:       const vel = 0.5;\n274:       const coast = 0.22;\n275:       if (d.aimErr === undefined) d.aimErr = (bot.r() + bot.r() + bot.r() - 1.5) * 1.15 * ({ sharp: 0.08, average: 0.15, clumsy: 0.25 }[bot.skillName] ?? 0.15) * vel\n276:       const rel = goal - lane.angle - coast * vel + d.aimErr;\n277:       out.wishX = rel > 0.04 ? vel : 0;\n278:     }\n279:     if (out.wishX) out.wishX = Math.max(-1, Math.min(1, out.wishX));\n280:   }\n281:   hud() {\n282:     const me = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n283:     const hud = this.game.hud;\n284:     const best = me.dives && me.dives.length ? Math.max(...me.dives.map((x) => x.score)) : 0;\n285:     hud.setScore(Math.round(best), 'Best');\n286:     hud.setTime(null);\n287:     if (this.power) this.power.set(Math.max(0, Math.abs(me.boardV || 0)) / 8);\n288:     const s = `Dive ${Math.min(this.maxDives, (me.dive || 0) + 1)} of ${this.maxDives}`;\n289:     if (this.diveTag && this.diveTag.textContent !== s) this.diveTag.textContent = s;\n290:   }\n291:   frameEvent(dt) {\n292:     if (this.gull) this.gull.update(dt);\n293:     if (this.replaying && this.replaying.replay && this.replaying.replay.on) {\n294:       const rp = this.replaying.replay;\n295:       const i = Math.min(rp.rec.length - 1, Math.floor(rp.t)), r = rp.rec[i];\n296:       rp.doll.root.position.set(r.x, r.y - H, 0);\n297:       rp.doll.root.rotation.set(0, 0, -r.a);\n298:       rp.doll.update(dt);\n299:       this.game.rig.shot(r.x + 0.5, r.y + 0.3, 6.5, r.x, r.y, 0, { rate: 5 });\n--- bot.js seed handling\n1:import { mulberry32 } from '../core/rng.js';\n3:// The human model behind every skill number: a delayed correction with noise.\n5:  sharp: { delay: 0.16, gain: 1.4, gainLoad: 0.7, noise: 0, lag: 0.12, speedErr: 0.3, timing: 0.028 },\n6:  average: { delay: 0.26, gain: 1.0, gainLoad: 0.55, noise: 0.03, lag: 0.28, speedErr: 0.8, timing: 0.055 },\n7:  clumsy: { delay: 0.38, gain: 0.8, gainLoad: 0.45, noise: 0.07, lag: 0.5, speedErr: 1.4, timing: 0.095 },\n10:export function makeBot(skill, seedExtra = 0) { return new Bot(skill, seedExtra); }\n12:export class Bot {\n13:  cons