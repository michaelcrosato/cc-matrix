ane, k);\n  }\n  miss(lane, k) {\"\"\")\nsub('src/events/stepClass.js',\"\"\"  flashPrint(k) { const p = this.prints[k]; if (p) { this.group.remove(p); this.prints[k] = null; } }\"\"\",\"\"\"  flashPrint(lane, k) { const p = lane.printsK && lane.printsK[k]; if (p) { this.group.remove(p); lane.printsK[k] = null; } }\"\"\")\nsub('src/events/stepClass.js',\"\"\"    // Footprints for the notes coming up.\n    this.notes.forEach((n, k) => {\n      const until = n.t - now;\n      if (lane0.judge && lane0.judge[k] && lane0.judge[k].done) { this.flashPrint(k); return; }\n      if (until < LEAD && until > -0.4) {\n        let p = this.prints[k];\n        if (!p) {\n          p = this.makePrint(n);\n          this.prints[k] = p;\n          this.group.add(p);\n        }\n        const z = 0.5 - (until / LEAD) * LEAD * 2.6;\n        p.position.z = z;\n        p.scale.setScalar(1 + (until < 0.15 ? this.pulse * 0.4 : 0));\n      } else if (until <= -0.4) this.flashPrint(k);\n    });\"\"\",\"\"\"    // Footprints for the notes coming up, on every lane that has a body here.\n    for (const lane of this.lanes) {\n      if (lane.kind === 'ghost' || !lane.printsK) continue;\n      this.notes.forEach((n, k) => {\n        const until = n.t - now;\n        if (lane.judge[k].done) { this.flashPrint(lane, k); return; }\n        if (until < LEAD && until > -0.4) {\n          let p = lane.printsK[k];\n          if (!p) {\n            p = this.makePrint(n, lane);\n            lane.printsK[k] = p;\n            this.group.add(p);\n          }\n          p.position.z = 0.5 + (until / LEAD) * TRACK;\n          p.position.y = until < 0.15 ? this.pulse * 0.02 : 0;\n        } else if (until <= -0.4) this.flashPrint(lane, k);\n      });\n    }\"\"\")\nsub('src/events/stepClass.js',\"\"\"  makePrint(n) {\n    const lane = this.lanes.find((l) => l.kind === 'local') || this.lanes[0];\n    const g = G();\"\"\",\"\"\"  makePrint(n, lane) {\n    const g = G();\"\"\")\nsub('src/events/stepClass.js',\"\"\"co