{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjmoHEy2gBUpsddM3YpC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LuGT1vZuHZnnmta4WMc5Lr","name":"Bash","input":{"command":"cat > src/game/hub.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { h } from '../ui/dom.js';\nimport { Doll, paintColour } from '../art/doll.js';\nimport { MAP } from '../art/island.js';\nimport { EVENTS, TIER_NAMES } from '../data/events.js';\nimport { hasEvent } from '../events/index.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { blankInput } from '../input/input.js';\nimport { tun } from '../core/tuning.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { QUESTIONS, line } from '../data/dialogue.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nimport { openPlan } from '../ui/screens/plan.js';\nimport { openMirror } from '../ui/screens/mirror.js';\nimport { openJournal } from '../ui/screens/journal.js';\nimport { cos, cosPick } from '../core/rng.js';\nimport { diagram } from '../ui/diagrams.js';\nimport { DAYS } from '../data/programme.js';\n\nconst _v = new THREE.Vector3(), _q = new THREE.Quaternion(), _iq = new THREE.Quaternion();\n\n// What each place does. Events listed here are offered when you use it.\nconst SPOT_EVENTS = {\n  sunDeck: ['poses'], pond: ['stillWater'], quarry: ['cairn'], yard: ['logReps'], bandstand: ['stepClass'], boardwalk: ['roomService'],\n  pier: ['fruitHat', 'plank', 'springboard'], green: ['plates'], beach: ['tug'], lighthouse: ['grandHold'], ringRoad: ['islandLoop'], gazebo: ['raft'],\n};\nMAP.ringRoad = { x: -19, z: 0, label: 'The Ring Road', y: 2.2 };\n\n/** The hub: walk the crooked island, talk to everyone, go to class, go to bed. */\nexport class Hub {\n  constructor(game, opts = {}) {\n    this.game = game; this.opts = opts; this.name = 'island'; this.canPause = true;\n    this.input = blankInput(); this.focus = null; this.walkTo = null; this.orbit = 0; this.pitch = 0.42; this.dist = 11;\n    this.cutscene = false; this.t = 0; this.askT = 0; this.nearT = 0; this.idleT = 8;\n    this.spots = [];\n    this.label = null; this.leanTut = false; this.ragdoll = null; this.lastFocusId = null;\n  }\n  enter() {\n    const g = this.game;\n    g.setIsland('home');\n    g.ui.clear();\n    g.programme.syncIsland();\n    g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    const p = g.save.profile;\n    g.palette.set(g.programmePalette(), 1.2);\n    g.audio.music('island');\n    if (!this.doll) {\n      this.doll = new Doll({ shirt: p ? paintColour(p.paint) : '#2CB5A0', hat: p ? p.hat : 'none' });\n      g.art.group.add(this.doll.root);\n    }\n    const spawn = this.opts.at ? MAP[this.opts.at] : null;\n    if (spawn) g.phys.setPosition(spawn.x + 2, spawn.z + 3);\n    else if (g.hubPos) g.phys.setPosition(g.hubPos.x, g.hubPos.z);\n    else g.phys.setPosition(0, 10);\n    const t = g.phys.pos;\n    const trudy = g.art.trudy;\n    this.tx = t.x + 2; this.tz = t.z + 1.6;\n    trudy.root.position.set(this.tx, 0, this.tz);\n    this.promptsEl = h('div.hud-prompts');\n    this.hudLayer = g.ui.open({ name: 'hub', passive: true, build: (s) => {\n      this.topTag = h('div.hud-note.tag', { style: 'top:4.2rem;display:none' }, '');\n      this.dayTag = h('div.tag', { style: 'position:absolute;top:4.2rem;left:5.4rem;font-size:3.2rem;transform:rotate(-1deg)' }, '');\n      this.marbleTag = h('div.tag', { style: 'position:absolute;top:4.2rem;right:5.4rem;font-size:3.2rem;transform:rotate(1deg)' }, '');\n      this.label = h('div.hotlabel.tag'); this.label.style.display = 'none';\n      s.el.append(this.promptsEl, this.dayTag, this.marbleTag, this.topTag, this.label);\n    } });\n    this.lastDev = null;\n    this.refreshTags();\n    this.buildSpots();\n    this.chase(true);\n    if (this.opts.arrival) this.handle = g.scripts.run(this.arrival());\n    else if (this.opts.morning) this.handle = g.scripts.run(this.morning());\n    else if (this.opts.afterJar) this.handle = g.scripts.run(this.afterJar());\n    else this.greet();\n  }\n  exit() {\n    const g = this.game;\n    if (this.handle) this.handle.cancel();\n    g.hubPos = { x: g.phys.pos.x, z: g.phys.pos.z };\n    if (this.ragdoll) { this.ragdoll.end(); this.ragdoll = null; }\n    if (this.doll) { g.art.group.remove(this.doll.root); this.doll = null; }\n    g.phys.wantX = 0; g.phys.wantZ = 0; g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    if (this.lastFocusId) g.art.outline(this.lastFocusId, false);\n    if (this.hudLayer) g.ui.close(this.hudLayer);\n    g.speech.clear();\n    g.ui.clear();\n  }\n  refreshTags() {\n    const g = this.game;\n    const p = g.save.profile;\n    if (!p) { this.dayTag.style.display = 'none'; this.marbleTag.style.display = 'none'; return; }\n    const d = g.programme.dayDef(p.today.day);\n    this.dayTag.textContent = `Day ${p.today.day}: ${d.name}`;\n    this.marbleTag.textContent = `${p.marbles} marbles`;\n  }\n  buildSpots() {\n    const g = this.game, art = g.art;\n    this.spots = Object.keys(MAP).map((id) => ({ id, label: MAP[id].label, x: MAP[id].x, z: MAP[id].z, y: MAP[id].y, r: id === 'ringRoad' ? 2.5 : 4.4 }));\n    for (const gu of art.guests) this.spots.push({ id: `guest:${gu.id}`, label: gu.doll && nameOf(gu.id), guest: gu, y: 1.9, r: 2 });\n    this.spots.push({ id: 'heron', label: 'Ms. Stillwater', x: art.heron.root.position.x, z: art.heron.root.position.z, y: 2.7, r: 2.6, who: 'stillwater' });\n    this.spots.push({ id: 'walrus', label: 'Coach Bolster', x: art.walrus.root.position.x, z: art.walrus.root.position.z, y: 3, r: 3, who: 'bolster' });\n  }\n  greet() {\n    const g = this.game;\n    this.handle = g.scripts.run((function* s(self) {\n      yield 0.6;\n      const pr = g.programme;\n      if (!g.save.profile) return;\n      if (!pr.planLeft().length && g.save.profile.today.checkin) g.bark('trudy', 'all_done', null, 4);\n    })(this));\n  }\n  // ---- Scripts ----\n  *arrival() {\n    const g = this.game;\n    this.cutscene = true;\n    g.palette.set('dawn', 0.2);\n    const trudy = g.art.trudy;\n    // You drop onto the island from above, clatter, spring up.\n    yield 0.5;\n    g.audio.sfx('whoosh');\n    const t = g.phys.pos;\n    this.doll.root.position.set(t.x, 0, t.z);\n    this.doll.ragdolled = true;\n    this.doll.update(0);\n    this.doll.root.position.set(t.x, 6.5, t.z);\n    g.art.group.updateWorldMatrix(true, true);\n    this.ragdoll = new Ragdoll(g.phys.world, this.doll, g.art.group, { x: 0, y: -3, z: 0 }, { x: 0.02, y: 0, z: 0.01 });\n    let clacks = 0;\n    const until = g.simTime + 1.5;\n    yield () => {\n      if (this.ragdoll) this.ragdoll.sync();\n      const y = this.ragdoll ? this.ragdoll.centre().y : 9;\n      if (y < 0.6 && clacks < 2) { clacks++; g.audio.sfx('fall'); g.comic.pop('CLACK!', t.x, 1.8, t.z); g.rig.shake(0.1); }\n      return g.simTime > until;\n    };\n    this.ragdoll.end(); this.ragdoll = null;\n    this.doll.ragdolled = false;\n    this.doll.root.position.set(t.x, 0, t.z);\n    this.doll.rig.once('land');\n    g.audio.sfx('spring');\n    yield 0.5;\n    this.trudyHopTo(t.x + 2, t.z + 1.6);\n    yield 0.6;\n    trudy.rig.once('gasp');\n    trudy.feel(0.8);\n    yield* g.say('trudy', 'drop_in');\n    // Lean left: the whole island tips under you, and every orange rolls.\n    this.leanTut = true;\n    for (const [sit, dx, dz, bonus] of [['lean_left', -1, 0, 'Lean left'], ['lean_right', 1, 0, 'Lean right'], ['lean_forward', 0, -1, 'Lean forward']]) {\n      const l = g.speech.say('trudy', line('trudy', sit), { auto: 0 });\n      this.setPrompts([['lean', bonus]]);\n      let held = 0;\n      this.leanGoal = [dx, dz];\n      yield () => {\n        const i = this.input;\n        const d = i.wishX * dx + i.wishZ * dz;\n        if (d > 0.5) held += 1 / 120;\n        if (l.finished && !l.autoClear) { l.autoClear = true; }\n        return held > 0.9;\n      };\n      if (g.speech.line === l) g.speech.clear();\n      g.audio.sfx('creak', { dur: 0.8 });\n      trudy.rig.once('hop');\n      yield 0.5;\n    }\n    this.leanTut = false; this.leanGoal = null;\n    g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    yield* g.say('trudy', 'lean_done');\n    g.save.profile.tutorialDone = true;\n    g.save.write();\n    this.cutscene = false;\n    yield* g.say('trudy', 'first_checkin');\n    g.go(() => g.flow.toCheckIn());\n  }\n  *morning() {\n    const g = this.game;\n    const p = g.save.profile;\n    this.cutscene = true;\n    g.palette.set('dawn', 0.2);\n    yield 0.5;\n    const away = p.lastSeen ? (Date.now() - p.lastSeen) / 3600000 : 0;\n    if (away > 12) yield* g.say('trudy', 'returned');\n    else if (p.levelled) yield* g.say('trudy', 'maintenance');\n    else if (p.today.day === DAYS.length) yield* g.say('trudy', 'level_day');\n    else yield* g.say('trudy', 'morning');\n    const def = g.programme.dayDef(p.today.day);\n    if (def.opens === 'mirror') yield* g.say('trudy', 'mirror_open');\n    if (def.opens === 'group') yield* g.say('trudy', 'group_open');\n    if (!p.today.question) {\n      yield* g.say('trudy', 'question_intro');\n      const q = QUESTIONS[(p.today.day - 1 + (p.answersSeed || 0)) % QUESTIONS.length];\n      const ans = yield* this.ask(q);\n      yield* g.sayText('trudy', ans);\n      p.today.question = true;\n    }\n    this.cutscene = false;\n    yield* g.say('trudy', 'checkin_start');\n    g.go(() => g.flow.toCheckIn());\n  }\n  /** Always Yes/No, always a reply either way. */\n  *ask(q) {\n    const g = this.game;\n    let reply = null;\n    g.speech.say('trudy', q.q, {});\n    g.ui.open({\n      name: 'question',\n      build: (s) => {\n        const row = h('div.choices');\n        s.el.append(row);\n        row.append(s.item(h('div', q.a[0]), { use: () => { reply = q.yes; } }));\n        row.append(s.item(h('div', q.a[1]), { use: () => { reply = q.no; } }));\n      },\n      prompts: [['use', 'Answer']],\n    });\n    yield () => reply;\n    g.ui.close(g.ui.top);\n    g.speech.clear();\n    return reply;\n  }\n  *afterJar() {\n    const g = this.game;\n    yield 0.5;\n    const pr = g.programme;\n    if (g.save.profile && !pr.planLeft().length && g.save.profile.today.checkin) yield* g.say('trudy', 'all_done');\n  }\n  *bedtime() {\n    const g = this.game;\n    this.cutscene = true;\n    yield* g.say('trudy', 'bed');\n    yield* g.wipe(() => {\n      g.programme.nextDay();\n      g.audio.sfx('stamp');\n    });\n    g.go(() => g.flow.toIsland({ morning: true, at: 'bedHut' }));\n    this.cutscene = false;\n  }\n  setPrompts(list) { this.promptOverride = list; this.lastDev = null; }\n  trudyHopTo(x, z) { this.tx = x; this.tz = z; }\n  // ---- Use ----\n  useSpot(spot) {\n    const g = this.game, pr = g.programme, p = g.save.profile;\n    if (!spot) return;\n    this.walkTo = null;\n    if (spot.who) { g.bark(spot.who, 'idle', null, 3.4); return; }\n    if (spot.guest) { const w = spot.guest.id; g.bark(w, 'idle', null, 3.4); spot.guest.doll.rig.once('wave'); return; }\n    if (spot.id === 'board') { openPlan(g, this); return; }\n    if (spot.id === 'jar') { g.speech.say('trudy', p ? `${p.marbles} marbles. ${line('trudy', 'jar')}` : line('trudy', 'jar'), { auto: 3.4 }); return; }\n    if (spot.id === 'bedHut') {\n      if (!p) return;\n      if (pr.planLeft().length) { g.bark('trudy', 'not_done', null, 3); return; }\n      this.handle = g.scripts.run(this.bedtime());\n      return;\n    }\n    if (spot.id === 'mirror') {\n      if (p && (p.today.day >= 3 || p.levelled)) openMirror(g, this);\n      else g.speech.say('trudy', 'The Mirror opens on Day 3. You are not ready to see yourself. I say this kindly.', { auto: 3.4 });\n      return;\n    }\n    if (spot.id === 'gazebo') { this.chooseGazebo(); return; }\n    const list = (SPOT_EVENTS[spot.id] || []).filter(hasEvent);\n    if (!list.length) return;\n    this.startFromList(list, spot.label);\n  }\n  chooseGazebo() {\n    const g = this.game, p = g.save.profile;\n    if (p && (p.today.day < 4 && !p.levelled)) { g.speech.say('trudy', 'The Gazebo opens on Day 4. I am still dusting it. It does not need dusting.', { auto: 3.4 }); return; }\n    const choices = [{ label: 'Group Class', use: () => g.go(() => g.flow.toGroup()) }];\n    if (hasEvent('raft')) choices.unshift({ label: 'Tippy Raft', use: () => this.startFromList(['raft'], 'The Raft') });\n    this.chooser('The Gazebo', choices);\n  }\n  /** At a place with classes: the one due today, otherwise whatever is open. */\n  startFromList(list, label) {\n    const g = this.game, pr = g.programme, p = g.save.profile;\n    const due = list.filter((id) => pr.classesToday().includes(id) && !p.today.done.includes(id));\n    if (due.length === 1 && list.length === 1) { this.goClass(due[0], true); return; }\n    const open = list.filter((id) => due.includes(id) || pr.seen(id));\n    if (!open.length) {\n      g.speech.say('trudy', \"That class is not on today's plan. It will come to you. Things do.\", { auto: 3.2 });\n      return;\n    }\n    if (open.length === 1 && !due.length) { this.chooseTier(open[0]); return; }\n    this.chooser(label, open.map((id) => ({ label: `${EVENTS[id].title}${due.includes(id) ? ' (today)' : ''}`, use: () => (due.includes(id) ? this.goClass(id, true) : this.chooseTier(id)) })));\n  }\n  chooseTier(id) {\n    const g = this.game, pr = g.programme;\n    const tiers = EVENTS[id].tiers.map((_, t) => t).filter((t) => pr.tierOpen(id, t));\n    if (tiers.length === 1) { this.goClass(id, false, 0); return; }\n    this.chooser(EVENTS[id].title, tiers.map((t) => ({ label: TIER_NAMES[t], use: () => this.goClass(id, false, t) })));\n  }\n  chooser(title, choices) {\n    const g = this.game;\n    let scr = null;\n    const close = () => g.ui.close(scr);\n    scr = g.ui.open({\n      name: 'chooser', className: 'dim', prompts: [['use', 'Choose'], ['back', 'Back']], back: close,\n      build: (s) => {\n        s.el.append(h('div.h2', { style: 'margin-top:12rem' }, title));\n        const col = h('div.col');\n        s.el.append(col);\n        for (const c of choices.slice(0, 6)) col.append(s.item(h('div', c.label), { use: () => { close(); c.use(); } }));\n      },\n    });\n  }\n  goClass(id, programme, tier) {\n    const g = this.game, pr = g.programme;\n    const t = tier ?? pr.programmeTier(id);\n    g.go(() => g.flow.runClass(id, t, { programme }));\n  }\n  // ---- Sim ----\n  fixed(dt) {\n    const g = this.game, inp = g.input, ph = g.phys;\n    this.t += dt;\n    const modal = g.ui.top && !g.ui.top.passive;\n    if (!modal) {\n      inp.sample('any', this.input, dt);\n    } else { Object.assign(this.input, blankInput()); }\n    const i = this.input;\n    const yaw = g.rig.yaw;\n    if (this.leanTut) {\n      // Lean tutorial: your weight goes straight into the island.\n      const [wx, wz] = rot2(i.device === 'pad' ? i.wishX : (inp.keyX || inp.pointerActive ? i.wishX : i.wishX), i.wishZ, yaw);\n      ph.leanExtraX = wx * 0.13; ph.leanExtraZ = wz * 0.13;\n      ph.wantX = 0; ph.wantZ = 0;\n    } else if (!this.cutscene && !modal) {\n      let mx = 0, mz = 0;\n      if (i.device === 'pad') { mx = i.moveX; mz = i.moveZ; } else if (i.keysActive) { mx = i.moveX; mz = i.moveZ; }\n      if (mx || mz) this.walkTo = null;\n      let [wx, wz] = rot2(mx, mz, yaw);\n      if (this.walkTo) {\n        const t = this.spotPos(this.walkTo), p = ph.pos;\n        const dx = t.x - p.x, dz = t.z - p.z, d = Math.hypot(dx, dz);\n        if (d < (this.walkTo.r || 3) * 0.8) { const s = this.walkTo; this.walkTo = null; this.useSpot(s); wx = 0; wz = 0; } else { wx = dx / d; wz = dz / d; }\n      }\n      const s = tun.walkSpeed;\n      ph.wantX = wx * s; ph.wantZ = wz * s;\n      if ((i.use || i.hopPressed) && !g.speech.active) {\n        if (this.focus && (i.use || i.device === 'pad')) this.useSpot(this.focus);\n        else if (i.hopPressed) this.hop();\n      }\n      if (i.ask) this.askTrudy();\n      if (inp.btnEdge & 1 && this.hover && !g.speech.active) this.walkTo = this.hover;\n      // Bot/test convenience: Triangle or T opens today's plan when nothing is focused and speech is quiet.\n      this.orbit -= i.lookX * 1.8 * dt; this.pitch = Math.max(0.12, Math.min(1.1, this.pitch + i.lookY * 0.9 * dt));\n      if (inp.dragX || inp.dragY) { this.orbit -= inp.dragX * 0.005; this.pitch = Math.max(0.12, Math.min(1.1, this.pitch + inp.dragY * 0.003)); }\n      if (inp.wheel) this.dist = Math.max(5, Math.min(26, this.dist + inp.wheel * 1.2));\n      this.idleT -= dt;\n      if (this.idleT <= 0) { this.idleT = cos(14, 28); if (!g.speech.active) g.bark('trudy', 'idle', null, 3.2); }\n    } else { ph.wantX = 0; ph.wantZ = 0; }\n    g.stepIsland(dt, 1);\n    this.updateFocus();\n    this.trudyStep(dt);\n    if (this.hopT > 0) this.hopT -= dt;\n  }\n  hop() {\n    if ((this.hopT || 0) > 0) return;\n    this.hopT = 0.5;\n    this.doll.rig.once('hop');\n    this.game.audio.sfx('boing');\n  }\n  /** Ask Trudy: today's plan, and a word about what is next. */\n  askTrudy() {\n    const g = this.game, pr = g.programme;\n    if (!g.save.profile) return;\n    openPlan(g, this);\n    const next = pr.nextClass();\n    if (next) g.bark('trudy', 'ask_plan', { next: EVENTS[next].title, place: EVENTS[next].place }, 3.2);\n    else g.bark('trudy', 'ask_done', null, 3.2);\n  }\n  spotPos(s) { return s.guest ? { x: s.guest.x, z: s.guest.z } : { x: s.x, z: s.z }; }\n  updateFocus() {\n    const g = this.game, ph = g.phys, p = ph.pos, inp = g.input;\n    let best = null, bd = 1e9;\n    for (const s of this.spots) {\n      const q = this.spotPos(s);\n      const d = Math.hypot(q.x - p.x, q.z - p.z);\n      if (d < s.r && d / s.r < bd) { bd = d / s.r; best = s; }\n    }\n    // A hovered thing gets the same treatment: project anchors to screen and take the nearest.\n    this.hover = null;\n    if (inp.lastDevice === 'kbm' && inp.pointerActive && !this.cutscene) {\n      let hb = 1e9;\n      g.art.group.updateWorldMatrix(true, false);\n      for (const s of this.spots) {\n        const q = this.spotPos(s);\n        _v.set(q.x, s.y * 0.7, q.z).applyMatrix4(g.art.group.matrixWorld).project(g.camera);\n        if (_v.z > 1) continue;\n        const sx = (_v.x * 0.5 + 0.5) * inp.w, sy = (-_v.y * 0.5 + 0.5) * inp.h;\n        const d = Math.hypot(sx - inp.mx, sy - inp.my);\n        if (d < inp.h * 0.09 && d < hb) { hb = d; this.hover = s; }\n      }\n    }\n    this.focus = this.hover || best;\n  }\n  trudyStep(dt) {\n    const g = this.game, trudy = g.art.trudy, p = g.phys.pos;\n    if (!this.leanTut && !this.cutscene) { this.tx = p.x + 2; this.tz = p.z + 1.6; }\n    const pos = trudy.root.position;\n    const dx = this.tx - pos.x, dz = this.tz - pos.z, d = Math.hypot(dx, dz);\n    if (d > 0.6) {\n      const sp = Math.min(6.5, 1.6 + d);\n      pos.x += (dx / d) * sp * dt; pos.z += (dz / d) * sp * dt;\n      this.trudyHop = (this.trudyHop || 0) + dt;\n      if (this.trudyHop > 0.42) { this.trudyHop = 0; trudy.rig.once('hop'); trudy.squash = 0.8; if (d < 7) g.audio.sfx('thud', { pitch: 340 }); }\n    }\n    const fx = p.x - pos.x, fz = p.z - pos.z;\n    trudy.yaw = Math.atan2(fx, fz);\n    // Her bubble slides to the high side of the world.\n    const c = Math.cos(trudy.yaw), s = Math.sin(trudy.yaw);\n    trudy.feel((-g.phys.tx * c + g.phys.tz * s) * 6);\n  }\n  chase(snap) {\n    const g = this.game, p = g.phys.pos;\n    g.art.group.updateWorldMatrix(true, false);\n    _v.set(p.x, 0.9, p.z).applyMatrix4(g.art.group.matrixWorld);\n    const d = this.dist, a = this.orbit;\n    const cx = _v.x + Math.sin(a) * d * Math.cos(this.pitch), cy = _v.y + Math.sin(this.pitch) * d + 0.8, cz = _v.z + Math.cos(a) * d * Math.cos(this.pitch);\n    g.rig.shot(cx, cy, cz, _v.x, _v.y + 0.7, _v.z, { snap, rate: 6, fov: 42 });\n  }\n  frame(dt) {\n    const g = this.game, ph = g.phys, doll = this.doll;\n    g.syncIsland(dt);\n    this.chase(false);\n    const p = ph.pos;\n    _iq.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w).invert();\n    const trudy = g.art.trudy;\n    trudy.root.quaternion.copy(_iq).multiply(_q.setFromAxisAngle(_v.set(0, 1, 0), trudy.yaw));\n    if (doll) {\n      if (this.ragdoll) this.ragdoll.sync();\n      else {\n        doll.root.position.set(p.x, 0, p.z);\n        // Most of the tilt is cancelled so the doll stands up against the crooked ground.\n        doll.root.quaternion.copy(_iq);\n        const sp = Math.hypot(ph.wantX, ph.wantZ);\n        if (sp > 0.4) { doll.face(Math.atan2(ph.wantX, ph.wantZ)); doll.rig.loop('walk', { speed: Math.max(0.7, sp / 3.2) }); } else if (this.leanTut) {\n          const i = this.input; doll.face(0);\n          doll.root.quaternion.multiply(_q.setFromEuler(new THREE.Euler(i.wishZ * 0.25, 0, -i.wishX * 0.25)));\n          doll.rig.loop('spread');\n        } else doll.rig.loop('idle');\n      }\n      doll.update(dt);\n    }\n    this.frameUI();\n  }\n  frameUI() {\n    const g = this.game;\n    const dev = g.input.lastDevice;\n    if (dev !== this.lastDev) {\n      this.lastDev = dev;\n      const list = this.promptOverride && (this.leanTut) ? this.promptOverride : [['move', 'Walk'], ['interact', 'Use'], ['ask', \"Today's plan\"], ['look', 'Look'], ['hop', 'Hop']];\n      this.promptsEl.innerHTML = list.map(([v, t]) => promptHTML(v, t, dev, g.save.settings.glyphs)).join('');\n    }\n    if (this.leanTut !== this.wasLean) { this.wasLean = this.leanTut; this.lastDev = null; }\n    const f = g.ui.top && !g.ui.top.passive ? null : this.focus;\n    const id = f ? f.id : null;\n    if (id !== this.lastFocusId) {\n      if (this.lastFocusId && MAP[this.lastFocusId]) g.art.outline(this.lastFocusId, false);\n      this.lastFocusId = id;\n      if (id && MAP[id]) g.art.outline(id, true);\n      if (f) { this.label.style.display = ''; this.label.innerHTML = `${escapeHTML(f.label)} ${promptHTML('interact', '', dev, g.save.settings.glyphs)}`; } else this.label.style.display = 'none';\n    }\n    if (f) {\n      const q = this.spotPos(f);\n      g.art.group.updateWorldMatrix(true, false);\n      _v.set(q.x, f.y, q.z).applyMatrix4(g.art.group.matrixWorld).project(g.camera);\n      this.label.style.left = `${((_v.x * 0.5 + 0.5) * 100).toFixed(2)}%`;\n      this.label.style.top = `${Math.max(8, (-_v.y * 0.5 + 0.5) * 100).toFixed(2)}%`;\n    }\n  }\n  /** Test hook: walk the bot to a spot. */\n  botDrive() { return null; }\n}\nfunction nameOf(id) { return { margaret: 'Gentle Margaret', kevin: 'Retired Kevin', sandras: 'Both Sandras', paul: 'Unsteady Paul', gerald: 'Young Gerald' }[id] || id; }\nconst escapeHTML = (s) => String(s).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nexport { diagram, openJournal, cosPick };\nEOF\ncat > src/ui/screens/plan.js <<'EOF'\nimport { h } from '../dom.js';\nimport { EVENTS, TIER_NAMES } from '../../data/events.js';\nimport { diagram } from '../diagrams.js';\nimport { openJournal } from './journal.js';\n\n/** Today's Plan: up to four big cards, done ones stamped. */\nexport function openPlan(game, hub) {\n  const pr = game.programme, p = game.save.profile;\n  const today = pr.classesToday();\n  let scr = null;\n  const close = () => game.ui.close(scr);\n  scr = game.ui.open({\n    name: 'plan', className: 'dim',\n    prompts: [['use', 'Go there'], ['ask', 'Journal'], ['back', 'Back']],\n    back: close,\n    alt: () => openJournal(game),\n    build: (s) => {\n      const def = pr.dayDef(p.today.day);\n      s.el.append(h('div.h2', { style: 'margin-top:3rem' }, \"Today's Plan\"));\n      s.el.append(h('div.sign', { style: 'margin-bottom:2.4rem;font-size:3.4rem' }, `Day ${p.today.day}: ${def.name}`));\n      const cards = h('div.cards');\n      s.el.append(cards);\n      for (const id of today) {\n        const d = EVENTS[id];\n        const done = p.today.done.includes(id);\n        const m = pr.medalOf(id, pr.programmeTier(id));\n        const el = h(`div.card${done ? '.done' : ''}`,\n          h('div.art', { html: diagram(d.diagram) }),\n          h('div.name', d.title),\n          h('div', d.place),\n          done ? h('div.stamp', { 'data-stamp': id }, m ? m.medal.toUpperCase() : 'DONE') : null);\n        cards.append(s.item(el, { use: () => {\n          close();\n          if (hub) hub.goClass(id, !done);\n        } }));\n      }\n      if (!pr.planLeft().length) s.el.append(h('div.tag', { style: 'margin-top:2.4rem' }, 'All done. The Bed Hut is open.'));\n    },\n  });\n  return scr;\n}\nEOF\ncat > src/ui/screens/mirror.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { h } from '../dom.js';\nimport { PAINTS, paintColour, Doll } from '../../art/doll.js';\nimport { HATS, LATE_PAINTS } from '../../data/unlocks.js';\nimport { rot2 } from '../../render/cameraRig.js';\n\n/** The Mirror: paint and hat picker, on a doll that spins. Locked things show a marble count. */\nexport function openMirror(game, hub) {\n  const p = game.save.profile, pr = game.programme;\n  const doll = new Doll({ shirt: paintColour(p.paint), hat: p.hat });\n  const art = game.art;\n  const m = art.spots.mirror;\n  doll.root.position.set(0, 0, 2.4);\n  m.add(doll.root);\n  doll.rig.loop('breathe');\n  let yaw = 0;\n  let paintI = PAINTS.findIndex((x) => x.id === p.paint), hatI = HATS.findIndex((x) => x.id === p.hat);\n  let scr = null;\n  const close = () => {\n    m.remove(doll.root);\n    game.ui.close(scr);\n    game.save.write();\n    if (hub && hub.doll) { hub.doll.setShirt(paintColour(p.paint)); hub.doll.setHat(p.hat); }\n    hub.mirrorShot = false;\n  };\n  const camBack = game.rig.tPos.clone();\n  scr = game.ui.open({\n    name: 'mirror', prompts: [['use', 'Choose'], ['back', 'Back']], back: close,\n    update: (dt) => {\n      yaw += dt * 0.7;\n      doll.root.rotation.y = yaw;\n      doll.update(dt);\n    },\n    build: (s) => {\n      s.el.append(h('div.h2', { style: 'margin-top:3rem' }, 'The Mirror'));\n      const col = h('div.col', { style: 'position:absolute;right:9rem;top:30rem;align-items:stretch' });\n      s.el.append(col);\n      const paintEl = h('span'), hatEl = h('span');\n      const renderP = () => {\n        const x = PAINTS[paintI];\n        const lock = LATE_PAINTS.find((l) => l.id === x.id);\n        const locked = !pr.paintsOpen().includes(x.id);\n        paintEl.textContent = locked ? `${x.name} (${lock ? lock.at : 0} marbles)` : x.name;\n        if (!locked) { p.paint = x.id; }\n        doll.setShirt(x.shirt);\n      };\n      const renderH = () => {\n        const x = HATS[hatI];\n        const locked = !pr.hatsOpen().some((o) => o.id === x.id);\n        hatEl.textContent = locked ? `${x.name} (${x.at} marbles)` : x.name;\n        if (!locked) p.hat = x.id;\n        doll.setHat(x.id);\n      };\n      const shiftP = (d) => { paintI = (paintI + d + PAINTS.length) % PAINTS.length; renderP(); game.audio.sfx('uiMove'); };\n      const shiftH = (d) => { hatI = (hatI + d + HATS.length) % HATS.length; renderH(); game.audio.sfx('uiMove'); };\n      col.append(s.item(h('div', 'Paint: ', paintEl), { left: () => shiftP(-1), right: () => shiftP(1), use: () => shiftP(1), silent: true }));\n      col.append(s.item(h('div', 'Hat: ', hatEl), { left: () => shiftH(-1), right: () => shiftH(1), use: () => shiftH(1), silent: true }));\n      col.append(s.item(h('div', 'That will do'), { use: close }));\n      renderP(); renderH();\n      const line = game.line('trudy', 'mirror');\n      game.speech.say('trudy', line, { auto: 4 });\n    },\n  });\n  // Frame the doll and the mirror.\n  hub.mirrorShot = true;\n  return { camBack, THREE, rot2 };\n}\nEOF\ncat > src/game/jar.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, groups, createWorld } from '../physics/world.js';\nimport { MAP } from '../art/island.js';\nimport { MEDALS } from '../data/config.js';\nimport { h } from '../ui/dom.js';\nimport { cos } from '../core/rng.js';\nimport { line } from '../data/dialogue.js';\n\nconst _m = new THREE.Matrix4(), _p = new THREE.Vector3(), _q = new THREE.Quaternion(), _s = new THREE.Vector3(1, 1, 1), _c = new THREE.Color();\nconst CAP = 320;\nexport const medalColour = (id) => (MEDALS.find((m) => m.id === id) || MEDALS[0]).colour;\nconst JAR_R = 1.08 - 0.03, H = 1.86;\n\n/** Settled positions for the marbles already in the jar, packed deterministically. */\nexport function packedPositions(n) {\n  const out = [];\n  let y = 0.17, layer = 0;\n  while (out.length < n) {\n    const rings = [[0, 1]];\n    for (let r = 0.29; r < JAR_R - 0.15; r += 0.28) rings.push([r, Math.floor((2 * Math.PI * r) / 0.29)]);\n    for (const [r, c] of rings) {\n      for (let i = 0; i < c && out.length < n; i++) {\n        const a = (i / c) * Math.PI * 2 + layer * 0.5;\n        out.push([Math.cos(a) * r, y, Math.sin(a) * r]);\n      }\n    }\n    y += 0.25; layer++;\n    if (y > 2.3) y = 2.3;\n  }\n  return out;\n}\n\n/** Show the marbles in the jar on the island without any physics. */\nexport function refreshJarDisplay(game) {\n  const art = game.art, p = game.save.profile;\n  const mesh = art.marbleMesh;\n  const log = p ? (p.marbleLog || []).slice(-CAP) : [];\n  const pos = game.jarPositions && game.jarPositions.length === log.length ? game.jarPositions : packedPositions(log.length);\n  mesh.count = log.length;\n  for (let i = 0; i < log.length; i++) {\n    _p.set(pos[i][0], pos[i][1], pos[i][2]); _q.set(0, 0, 0, 1);\n    _m.compose(_p, _q, _s); mesh.setMatrixAt(i, _m);\n    mesh.setColorAt(i, _c.set(medalColour(log[i])));\n  }\n  mesh.instanceMatrix.needsUpdate = true;\n  if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;\n}\n\n/** Marbles pour into the jar on the island, as real balls. The count ticks up. Then the island creaks. */\nexport class JarMode {\n  constructor(game, opts = {}) {\n    this.game = game; this.opts = opts; this.name = 'jar'; this.canPause = false;\n    this.bodies = []; this.shown = 0; this.spawned = 0; this.t = 0; this.stage = 'pour';\n  }\n  enter() {\n    const g = this.game, o = this.opts;\n    g.setIsland('home');\n    g.ui.clear();\n    g.programme.syncIsland();\n    g.palette.set(g.programmePalette(), 1);\n    g.audio.music('island');\n    const p = g.save.profile;\n    const world = this.world = createWorld({ iterations: 4 });\n    world.createCollider(RAPIER.ColliderDesc.cylinder(0.1, 1.2).setTranslation(0, -0.08, 0).setFriction(0.5).setCollisionGroups(groups.anyProp()));\n    for (let i = 0; i < 16; i++) {\n      const a = (i / 16) * Math.PI * 2;\n      world.createCollider(RAPIER.ColliderDesc.cuboid(0.06, 2, 0.24).setTranslation(Math.cos(a) * (JAR_R + 0.06), 2, Math.sin(a) * (JAR_R + 0.06))\n        .setRotation({ x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) }).setFriction(0.2).setCollisionGroups(groups.anyProp()));\n    }\n    const log = p ? (p.marbleLog || []).slice(-CAP) : [];\n    const newCount = Math.min(o.marbles ?? 0, log.length);\n    this.total = log.length; this.fresh = newCount; this.log = log;\n    const oldPos = packedPositions(log.length - newCount);\n    for (let i = 0; i < log.length - newCount; i++) this.addBall(oldPos[i][0], oldPos[i][1], oldPos[i][2]);\n    this.mesh = g.art.marbleMesh;\n    this.mesh.count = log.length - newCount;\n    this.scr = g.ui.open({\n      name: 'jar', prompts: [],\n      build: (s) => {\n        s.el.append(h('div.h2', { style: 'margin-top:3rem' }, 'The Jar'));\n        this.countEl = h('div.bignum', '0');\n        s.el.append(h('div', { style: 'position:absolute;right:12rem;top:24rem' }, this.countEl));\n      },\n    });\n    const m = MAP.jar;\n    const ph = g.phys;\n    ph.setPosition(m.x + 2, m.z + 3);\n    this.base = (p ? p.marbles : 0) - newCount;\n    this.handle = g.scripts.run(this.flow());\n    this.camera(true);\n    this.syncMarbles();\n  }\n  addBall(x, y, z, vy = 0) {\n    const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, y, z).setLinvel(cos(-0.4, 0.4), vy, cos(-0.4, 0.4)).setCanSleep(true));\n    this.world.createCollider(RAPIER.ColliderDesc.ball(0.14).setMass(0.02).setFriction(0.3).setRestitution(0.35).setCollisionGroups(groups.anyProp()), b);\n    this.bodies.push(b);\n    return b;\n  }\n  *flow() {\n    const g = this.game, o = this.opts;\n    yield 0.5;\n    const n = this.fresh;\n    const gap = Math.max(0.03, Math.min(0.12, 2.2 / Math.max(1, n)));\n    let hits = 0;\n    for (let i = 0; i < n; i++) {\n      this.addBall(cos(-0.2, 0.2), 3.2, cos(-0.2, 0.2), -2);\n      this.mesh.count = this.bodies.length;\n      const c = medalColour(this.log[this.bodies.length - 1]);\n      this.mesh.setColorAt(this.bodies.length - 1, _c.set(c));\n      if (this.mesh.instanceColor) this.mesh.instanceColor.needsUpdate = true;\n      this.spawned++;\n      g.audio.sfx('marble', { pitch: 1400 + cos(0, 2500) });\n      hits++;\n      if (hits % 3 === 0) g.audio.sfx('marbleRoll');\n      this.count = this.base + this.spawned;\n      this.countEl.textContent = String(this.count);\n      yield gap;\n    }\n    this.count = this.base + n;\n    this.countEl.textContent = String(this.count);\n    if (o.unlocks && o.unlocks.length) {\n      g.audio.sting('unlock');\n      g.ui.toast(`New: ${o.unlocks.map((u) => u.name).join(', ')}. See the Mirror.`, 3.4);\n    }\n    yield 1.1;\n    this.stage = 'notch';\n    if (o.notch) {\n      // The island creaks and comes up one notch. Everything shuffles.\n      g.audio.sfx('creak', { dur: 2.6 });\n      g.rig.shake(0.05);\n      g.phys.setRest(g.programme.restDeg());\n      const trudy = g.art.trudy;\n      trudy.rig.once('gasp');\n      g.speech.say('trudy', line('trudy', 'notch'), { auto: 0 });\n      const l = g.speech.line;\n      yield () => !g.speech.line || g.speech.line !== l;\n    } else {\n      g.speech.say('trudy', line('trudy', 'jar'), { auto: 0 });\n      const l = g.speech.line;\n      yield () => !g.speech.line || g.speech.line !== l;\n    }\n    this.stage = 'done';\n    this.keep();\n    g.go(() => { if (o.then) o.then(); else g.flow.toIsland({ afterJar: true, at: 'jar' }); });\n  }\n  keep() {\n    const g = this.game;\n    g.jarPositions = this.bodies.map((b) => { const t = b.translation(); return [t.x, Math.max(0.14, t.y), t.z]; });\n  }\n  camera(snap) {\n    const g = this.game, m = MAP.jar;\n    g.art.group.updateWorldMatrix(true, false);\n    _p.set(m.x, 1.6, m.z).applyMatrix4(g.art.group.matrixWorld);\n    g.rig.shot(_p.x - 1.2, _p.y + 1.6, _p.z + 8.6, _p.x, _p.y + 0.3, _p.z, { fov: 38, snap, rate: 3 });\n  }\n  fixed(dt) {\n    const g = this.game;\n    this.t += dt;\n    g.stepIsland(dt, 0.2);\n    this.world.step();\n  }\n  syncMarbles() {\n    const mesh = this.mesh;\n    for (let i = 0; i < this.bodies.length; i++) {\n      const t = this.bodies[i].translation();\n      _p.set(t.x, t.y, t.z); _q.set(0, 0, 0, 1);\n      _m.compose(_p, _q, _s); mesh.setMatrixAt(i, _m);\n      if (i < this.total - this.fresh) mesh.setColorAt(i, _c.set(medalColour(this.log[i])));\n    }\n    mesh.instanceMatrix.needsUpdate = true;\n    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;\n  }\n  frame(dt) {\n    const g = this.game;\n    g.syncIsland(dt);\n    this.camera(false);\n    this.syncMarbles();\n  }\n  exit() {\n    const g = this.game;\n    if (this.handle) this.handle.cancel();\n    this.keep();\n    if (this.world) { this.world.free(); this.world = null; }\n    g.speech.clear();\n    if (this.scr) g.ui.close(this.scr);\n    g.ui.clear();\n    refreshJarDisplay(g);\n  }\n}\nEOF\n","description":"Write hub, plan, mirror and jar modes"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15556,"cache_read_input_tokens":350853,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15556},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"d0d391ed-37b9-48af-b922-ec485e1f2bd4","timestamp":"2026-11-05T12:24:21.926Z","request_id":"req_011CgjmoGt9CGQ6J7WdU4P7Y","wire_tool_inputs":{"toolu_01LuGT1vZuHZnnmta4WMc5Lr":{"command":"cat > src/game/hub.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { h } from '../ui/dom.js';\nimport { Doll, paintColour } from '../art/doll.js';\nimport { MAP } from '../art/island.js';\nimport { EVENTS, TIER_NAMES } from '../data/events.js';\nimport { hasEvent } from '../events/index.js';\nimport { promptHTML } from '../input/glyphs.js';\nimport { blankInput } from '../input/input.js';\nimport { tun } from '../core/tuning.js';\nimport { rot2 } from '../render/cameraRig.js';\nimport { QUESTIONS, line } from '../data/dialogue.js';\nimport { Ragdoll } from '../physics/ragdoll.js';\nimport { openPlan } from '../ui/screens/plan.js';\nimport { openMirror } from '../ui/screens/mirror.js';\nimport { openJournal } from '../ui/screens/journal.js';\nimport { cos, cosPick } from '../core/rng.js';\nimport { diagram } from '../ui/diagrams.js';\nimport { DAYS } from '../data/programme.js';\n\nconst _v = new THREE.Vector3(), _q = new THREE.Quaternion(), _iq = new THREE.Quaternion();\n\n// What each place does. Events listed here are offered when you use it.\nconst SPOT_EVENTS = {\n  sunDeck: ['poses'], pond: ['stillWater'], quarry: ['cairn'], yard: ['logReps'], bandstand: ['stepClass'], boardwalk: ['roomService'],\n  pier: ['fruitHat', 'plank', 'springboard'], green: ['plates'], beach: ['tug'], lighthouse: ['grandHold'], ringRoad: ['islandLoop'], gazebo: ['raft'],\n};\nMAP.ringRoad = { x: -19, z: 0, label: 'The Ring Road', y: 2.2 };\n\n/** The hub: walk the crooked island, talk to everyone, go to class, go to bed. */\nexport class Hub {\n  constructor(game, opts = {}) {\n    this.game = game; this.opts = opts; this.name = 'island'; this.canPause = true;\n    this.input = blankInput(); this.focus = null; this.walkTo = null; this.orbit = 0; this.pitch = 0.42; this.dist = 11;\n    this.cutscene = false; this.t = 0; this.askT = 0; this.nearT = 0; this.idleT = 8;\n    this.spots = [];\n    this.label = null; this.leanTut = false; this.ragdoll = null; this.lastFocusId = null;\n  }\n  enter() {\n    const g = this.game;\n    g.setIsland('home');\n    g.ui.clear();\n    g.programme.syncIsland();\n    g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    const p = g.save.profile;\n    g.palette.set(g.programmePalette(), 1.2);\n    g.audio.music('island');\n    if (!this.doll) {\n      this.doll = new Doll({ shirt: p ? paintColour(p.paint) : '#2CB5A0', hat: p ? p.hat : 'none' });\n      g.art.group.add(this.doll.root);\n    }\n    const spawn = this.opts.at ? MAP[this.opts.at] : null;\n    if (spawn) g.phys.setPosition(spawn.x + 2, spawn.z + 3);\n    else if (g.hubPos) g.phys.setPosition(g.hubPos.x, g.hubPos.z);\n    else g.phys.setPosition(0, 10);\n    const t = g.phys.pos;\n    const trudy = g.art.trudy;\n    this.tx = t.x + 2; this.tz = t.z + 1.6;\n    trudy.root.position.set(this.tx, 0, this.tz);\n    this.promptsEl = h('div.hud-prompts');\n    this.hudLayer = g.ui.open({ name: 'hub', passive: true, build: (s) => {\n      this.topTag = h('div.hud-note.tag', { style: 'top:4.2rem;display:none' }, '');\n      this.dayTag = h('div.tag', { style: 'position:absolute;top:4.2rem;left:5.4rem;font-size:3.2rem;transform:rotate(-1deg)' }, '');\n      this.marbleTag = h('div.tag', { style: 'position:absolute;top:4.2rem;right:5.4rem;font-size:3.2rem;transform:rotate(1deg)' }, '');\n      this.label = h('div.hotlabel.tag'); this.label.style.display = 'none';\n      s.el.append(this.promptsEl, this.dayTag, this.marbleTag, this.topTag, this.label);\n    } });\n    this.lastDev = null;\n    this.refreshTags();\n    this.buildSpots();\n    this.chase(true);\n    if (this.opts.arrival) this.handle = g.scripts.run(this.arrival());\n    else if (this.opts.morning) this.handle = g.scripts.run(this.morning());\n    else if (this.opts.afterJar) this.handle = g.scripts.run(this.afterJar());\n    else this.greet();\n  }\n  exit() {\n    const g = this.game;\n    if (this.handle) this.handle.cancel();\n    g.hubPos = { x: g.phys.pos.x, z: g.phys.pos.z };\n    if (this.ragdoll) { this.ragdoll.end(); this.ragdoll = null; }\n    if (this.doll) { g.art.group.remove(this.doll.root); this.doll = null; }\n    g.phys.wantX = 0; g.phys.wantZ = 0; g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    if (this.lastFocusId) g.art.outline(this.lastFocusId, false);\n    if (this.hudLayer) g.ui.close(this.hudLayer);\n    g.speech.clear();\n    g.ui.clear();\n  }\n  refreshTags() {\n    const g = this.game;\n    const p = g.save.profile;\n    if (!p) { this.dayTag.style.display = 'none'; this.marbleTag.style.display = 'none'; return; }\n    const d = g.programme.dayDef(p.today.day);\n    this.dayTag.textContent = `Day ${p.today.day}: ${d.name}`;\n    this.marbleTag.textContent = `${p.marbles} marbles`;\n  }\n  buildSpots() {\n    const g = this.game, art = g.art;\n    this.spots = Object.keys(MAP).map((id) => ({ id, label: MAP[id].label, x: MAP[id].x, z: MAP[id].z, y: MAP[id].y, r: id === 'ringRoad' ? 2.5 : 4.4 }));\n    for (const gu of art.guests) this.spots.push({ id: `guest:${gu.id}`, label: gu.doll && nameOf(gu.id), guest: gu, y: 1.9, r: 2 });\n    this.spots.push({ id: 'heron', label: 'Ms. Stillwater', x: art.heron.root.position.x, z: art.heron.root.position.z, y: 2.7, r: 2.6, who: 'stillwater' });\n    this.spots.push({ id: 'walrus', label: 'Coach Bolster', x: art.walrus.root.position.x, z: art.walrus.root.position.z, y: 3, r: 3, who: 'bolster' });\n  }\n  greet() {\n    const g = this.game;\n    this.handle = g.scripts.run((function* s(self) {\n      yield 0.6;\n      const pr = g.programme;\n      if (!g.save.profile) return;\n      if (!pr.planLeft().length && g.save.profile.today.checkin) g.bark('trudy', 'all_done', null, 4);\n    })(this));\n  }\n  // ---- Scripts ----\n  *arrival() {\n    const g = this.game;\n    this.cutscene = true;\n    g.palette.set('dawn', 0.2);\n    const trudy = g.art.trudy;\n    // You drop onto the island from above, clatter, spring up.\n    yield 0.5;\n    g.audio.sfx('whoosh');\n    const t = g.phys.pos;\n    this.doll.root.position.set(t.x, 0, t.z);\n    this.doll.ragdolled = true;\n    this.doll.update(0);\n    this.doll.root.position.set(t.x, 6.5, t.z);\n    g.art.group.updateWorldMatrix(true, true);\n    this.ragdoll = new Ragdoll(g.phys.world, this.doll, g.art.group, { x: 0, y: -3, z: 0 }, { x: 0.02, y: 0, z: 0.01 });\n    let clacks = 0;\n    const until = g.simTime + 1.5;\n    yield () => {\n      if (this.ragdoll) this.ragdoll.sync();\n      const y = this.ragdoll ? this.ragdoll.centre().y : 9;\n      if (y < 0.6 && clacks < 2) { clacks++; g.audio.sfx('fall'); g.comic.pop('CLACK!', t.x, 1.8, t.z); g.rig.shake(0.1); }\n      return g.simTime > until;\n    };\n    this.ragdoll.end(); this.ragdoll = null;\n    this.doll.ragdolled = false;\n    this.doll.root.position.set(t.x, 0, t.z);\n    this.doll.rig.once('land');\n    g.audio.sfx('spring');\n    yield 0.5;\n    this.trudyHopTo(t.x + 2, t.z + 1.6);\n    yield 0.6;\n    trudy.rig.once('gasp');\n    trudy.feel(0.8);\n    yield* g.say('trudy', 'drop_in');\n    // Lean left: the whole island tips under you, and every orange rolls.\n    this.leanTut = true;\n    for (const [sit, dx, dz, bonus] of [['lean_left', -1, 0, 'Lean left'], ['lean_right', 1, 0, 'Lean right'], ['lean_forward', 0, -1, 'Lean forward']]) {\n      const l = g.speech.say('trudy', line('trudy', sit), { auto: 0 });\n      this.setPrompts([['lean', bonus]]);\n      let held = 0;\n      this.leanGoal = [dx, dz];\n      yield () => {\n        const i = this.input;\n        const d = i.wishX * dx + i.wishZ * dz;\n        if (d > 0.5) held += 1 / 120;\n        if (l.finished && !l.autoClear) { l.autoClear = true; }\n        return held > 0.9;\n      };\n      if (g.speech.line === l) g.speech.clear();\n      g.audio.sfx('creak', { dur: 0.8 });\n      trudy.rig.once('hop');\n      yield 0.5;\n    }\n    this.leanTut = false; this.leanGoal = null;\n    g.phys.leanExtraX = 0; g.phys.leanExtraZ = 0;\n    yield* g.say('trudy', 'lean_done');\n    g.save.profile.tutorialDone = true;\n    g.save.write();\n    this.cutscene = false;\n    yield* g.say('trudy', 'first_checkin');\n    g.go(() => g.flow.toCheckIn());\n  }\n  *morning() {\n    const g = this.game;\n    const p = g.save.profile;\n    this.cutscene = true;\n    g.palette.set('dawn', 0.2);\n    yield 0.5;\n    const away = p.lastSeen ? (Date.now() - p.lastSeen) / 3600000 : 0;\n    if (away > 12) yield* g.say('trudy', 'returned');\n    else if (p.levelled) yield* g.say('trudy', 'maintenance');\n    else if (p.today.day === DAYS.length) yield* g.say('trudy', 'level_day');\n    else yield* g.say('trudy', 'morning');\n    const def = g.programme.dayDef(p.today.day);\n    if (def.opens === 'mirror') yield* g.say('trudy', 'mirror_open');\n    if (def.opens === 'group') yield* g.say('trudy', 'group_open');\n    if (!p.today.question) {\n      yield* g.say('trudy', 'question_intro');\n      const q = QUESTIONS[(p.today.day - 1 + (p.answersSeed || 0)) % QUESTIONS.length];\n      const ans = yield* this.ask(q);\n      yield* g.sayText('trudy', ans);\n      p.today.question = true;\n    }\n    this.cutscene = false;\n    yield* g.say('trudy', 'checkin_start');\n    g.go(() => g.flow.toCheckIn());\n  }\n  /** Always Yes/No, always a reply either way. */\n  *ask(q) {\n    const g = this.game;\n    let reply = null;\n    g.speech.say('trudy', q.q, {});\n    g.ui.open({\n      name: 'question',\n      build: (s) => {\n        const row = h('div.choices');\n        s.el.append(row);\n        row.append(s.item(h('div', q.a[0]), { use: () => { reply = q.yes; } }));\n        row.append(s.item(h('div', q.a[1]), { use: () => { reply = q.no; } }));\n      },\n      prompts: [['use', 'Answer']],\n    });\n    yield () => reply;\n    g.ui.close(g.ui.top);\n    g.speech.clear();\n    return reply;\n  }\n  *afterJar() {\n    const g = this.game;\n    yield 0.5;\n    const pr = g.programme;\n    if (g.save.profile && !pr.planLeft().length && g.save.profile.today.checkin) yield* g.say('trudy', 'all_done');\n  }\n  *bedtime() {\n    const g = this.game;\n    this.cutscene = true;\n    yield* g.say('trudy', 'bed');\n    yield* g.wipe(() => {\n      g.programme.nextDay();\n      g.audio.sfx('stamp');\n    });\n    g.go(() => g.flow.toIsland({ morning: true, at: 'bedHut' }));\n    this.cutscene = false;\n  }\n  setPrompts(list) { this.promptOverride = list; this.lastDev = null; }\n  trudyHopTo(x, z) { this.tx = x; this.tz = z; }\n  // ---- Use ----\n  useSpot(spot) {\n    const g = this.game, pr = g.programme, p = g.save.profile;\n    if (!spot) return;\n    this.walkTo = null;\n    if (spot.who) { g.bark(spot.who, 'idle', null, 3.4); return; }\n    if (spot.guest) { const w = spot.guest.id; g.bark(w, 'idle', null, 3.4); spot.guest.doll.rig.once('wave'); return; }\n    if (spot.id === 'board') { openPlan(g, this); return; }\n    if (spot.id === 'jar') { g.speech.say('trudy', p ? `${p.marbles} marbles. ${line('trudy', 'jar')}` : line('trudy', 'jar'), { auto: 3.4 }); return; }\n    if (spot.id === 'bedHut') {\n      if (!p) return;\n      if (pr.planLeft().length) { g.bark('trudy', 'not_done', null, 3); return; }\n      this.handle = g.scripts.run(this.bedtime());\n      return;\n    }\n    if (spot.id === 'mirror') {\n      if (p && (p.today.day >= 3 || p.levelled)) openMirror(g, this);\n      else g.speech.say('trudy', 'The Mirror opens on Day 3. You are not ready to see yourself. I say this kindly.', { auto: 3.4 });\n      return;\n    }\n    if (spot.id === 'gazebo') { this.chooseGazebo(); return; }\n    const list = (SPOT_EVENTS[spot.id] || []).filter(hasEvent);\n    if (!list.length) return;\n    this.startFromList(list, spot.label);\n  }\n  chooseGazebo() {\n    const g = this.game, p = g.save.profile;\n    if (p && (p.today.day < 4 && !p.levelled)) { g.speech.say('trudy', 'The Gazebo opens on Day 4. I am still dusting it. It does not need dusting.', { auto: 3.4 }); return; }\n    const choices = [{ label: 'Group Class', use: () => g.go(() => g.flow.toGroup()) }];\n    if (hasEvent('raft')) choices.unshift({ label: 'Tippy Raft', use: () => this.startFromList(['raft'], 'The Raft') });\n    this.chooser('The Gazebo', choices);\n  }\n  /** At a place with classes: the one due today, otherwise whatever is open. */\n  startFromList(list, label) {\n    const g = this.game, pr = g.programme, p = g.save.profile;\n    const due = list.filter((id) => pr.classesToday().includes(id) && !p.today.done.includes(id));\n    if (due.length === 1 && list.length === 1) { this.goClass(due[0], true); return; }\n    const open = list.filter((id) => due.includes(id) || pr.seen(id));\n    if (!open.length) {\n      g.speech.say('trudy', \"That class is not on today's plan. It will come to you. Things do.\", { auto: 3.2 });\n      return;\n    }\n    if (open.length === 1 && !due.length) { this.chooseTier(open[0]); return; }\n    this.chooser(label, open.map((id) => ({ label: `${EVENTS[id].title}${due.includes(id) ? ' (today)' : ''}`, use: () => (due.includes(id) ? this.goClass(id, true) : this.chooseTier(id)) })));\n  }\n  chooseTier(id) {\n    const g = this.game, pr = g.programme;\n    const tiers = EVENTS[id].tiers.map((_, t) => t).filter((t) => pr.tierOpen(id, t));\n    if (tiers.length === 1) { this.goClass(id, false, 0); return; }\n    this.chooser(EVENTS[id].title, tiers.map((t) => ({ label: TIER_NAMES[t], use: () => this.goClass(id, false, t) })));\n  }\n  chooser(title, choices) {\n    const g = this.game;\n    let scr = null;\n    const close = () => g.ui.close(scr);\n    scr = g.ui.open({\n      name: 'chooser', className: 'dim', prompts: [['use', 'Choose'], ['back', 'Back']], back: close,\n      build: (s) => {\n        s.el.append(h('div.h2', { style: 'margin-top:12rem' }, title));\n        const col = h('div.col');\n        s.el.append(col);\n        for (const c of choices.slice(0, 6)) col.append(s.item(h('div', c.label), { use: () => { close(); c.use(); } }));\n      },\n    });\n  }\n  goClass(id, programme, tier) {\n    const g = this.game, pr = g.programme;\n    const t = tier ?? pr.programmeTier(id);\n    g.go(() => g.flow.runClass(id, t, { programme }));\n  }\n  // ---- Sim ----\n  fixed(dt) {\n    const g = this.game, inp = g.input, ph = g.phys;\n    this.t += dt;\n    const modal = g.ui.top && !g.ui.top.passive;\n    if (!modal) {\n      inp.sample('any', this.input, dt);\n    } else { Object.assign(this.input, blankInput()); }\n    const i = this.input;\n    const yaw = g.rig.yaw;\n    if (this.leanTut) {\n      // Lean tutorial: your weight goes straight into the island.\n      const [wx, wz] = rot2(i.device === 'pad' ? i.wishX : (inp.keyX || inp.pointerActive ? i.wishX : i.wishX), i.wishZ, yaw);\n      ph.leanExtraX = wx * 0.13; ph.leanExtraZ = wz * 0.13;\n      ph.wantX = 0; ph.wantZ = 0;\n    } else if (!this.cutscene && !modal) {\n      let mx = 0, mz = 0;\n      if (i.device === 'pad') { mx = i.moveX; mz = i.moveZ; } else if (i.keysActive) { mx = i.moveX; mz = i.moveZ; }\n      if (mx || mz) this.walkTo = null;\n      let [wx, wz] = rot2(mx, mz, yaw);\n      if (this.walkTo) {\n        const t = this.spotPos(this.walkTo), p = ph.pos;\n        const dx = t.x - p.x, dz = t.z - p.z, d = Math.hypot(dx, dz);\n        if (d < (this.walkTo.r || 3) * 0.8) { const s = this.walkTo; this.walkTo = null; this.useSpot(s); wx = 0; wz = 0; } else { wx = dx / d; wz = dz / d; }\n      }\n      const s = tun.walkSpeed;\n      ph.wantX = wx * s; ph.wantZ = wz * s;\n      if ((i.use || i.hopPressed) && !g.speech.active) {\n        if (this.focus && (i.use || i.device === 'pad')) this.useSpot(this.focus);\n        else if (i.hopPressed) this.hop();\n      }\n      if (i.ask) this.askTrudy();\n      if (inp.btnEdge & 1 && this.hover && !g.speech.active) this.walkTo = this.hover;\n      // Bot/test convenience: Triangle or T opens today's plan when nothing is focused and speech is quiet.\n      this.orbit -= i.lookX * 1.8 * dt; this.pitch = Math.max(0.12, Math.min(1.1, this.pitch + i.lookY * 0.9 * dt));\n      if (inp.dragX || inp.dragY) { this.orbit -= inp.dragX * 0.005; this.pitch = Math.max(0.12, Math.min(1.1, this.pitch + inp.dragY * 0.003)); }\n      if (inp.wheel) this.dist = Math.max(5, Math.min(26, this.dist + inp.wheel * 1.2));\n      this.idleT -= dt;\n      if (this.idleT <= 0) { this.idleT = cos(14, 28); if (!g.speech.active) g.bark('trudy', 'idle', null, 3.2); }\n    } else { ph.wantX = 0; ph.wantZ = 0; }\n    g.stepIsland(dt, 1);\n    this.updateFocus();\n    this.trudyStep(dt);\n    if (this.hopT > 0) this.hopT -= dt;\n  }\n  hop() {\n    if ((this.hopT || 0) > 0) return;\n    this.hopT = 0.5;\n    this.doll.rig.once('hop');\n    this.game.audio.sfx('boing');\n  }\n  /** Ask Trudy: today's plan, and a word about what is next. */\n  askTrudy() {\n    const g = this.game, pr = g.programme;\n    if (!g.save.profile) return;\n    openPlan(g, this);\n    const next = pr.nextClass();\n    if (next) g.bark('trudy', 'ask_plan', { next: EVENTS[next].title, place: EVENTS[next].place }, 3.2);\n    else g.bark('trudy', 'ask_done', null, 3.2);\n  }\n  spotPos(s) { return s.guest ? { x: s.guest.x, z: s.guest.z } : { x: s.x, z: s.z }; }\n  updateFocus() {\n    const g = this.game, ph = g.phys, p = ph.pos, inp = g.input;\n    let best = null, bd = 1e9;\n    for (const s of this.spots) {\n      const q = this.spotPos(s);\n      const d = Math.hypot(q.x - p.x, q.z - p.z);\n      if (d < s.r && d / s.r < bd) { bd = d / s.r; best = s; }\n    }\n    // A hovered thing gets the same treatment: project anchors to screen and take the nearest.\n    this.hover = null;\n    if (inp.lastDevice === 'kbm' && inp.pointerActive && !this.cutscene) {\n      let hb = 1e9;\n      g.art.group.updateWorldMatrix(true, false);\n      for (const s of this.spots) {\n        const q = this.spotPos(s);\n        _v.set(q.x, s.y * 0.7, q.z).applyMatrix4(g.art.group.matrixWorld).project(g.camera);\n        if (_v.z > 1) continue;\n        const sx = (_v.x * 0.5 + 0.5) * inp.w, sy = (-_v.y * 0.5 + 0.5) * inp.h;\n        const d = Math.hypot(sx - inp.mx, sy - inp.my);\n        if (d < inp.h * 0.09 && d < hb) { hb = d; this.hover = s; }\n      }\n    }\n    this.focus = this.hover || best;\n  }\n  trudyStep(dt) {\n    const g = this.game, trudy = g.art.trudy, p = g.phys.pos;\n    if (!this.leanTut && !this.cutscene) { this.tx = p.x + 2; this.tz = p.z + 1.6; }\n    const pos = trudy.root.position;\n    const dx = this.tx - pos.x, dz = this.tz - pos.z, d = Math.hypot(dx, dz);\n    if (d > 0.6) {\n      const sp = Math.min(6.5, 1.6 + d);\n      pos.x += (dx / d) * sp * dt; pos.z += (dz / d) * sp * dt;\n      this.trudyHop = (this.trudyHop || 0) + dt;\n      if (this.trudyHop > 0.42) { this.trudyHop = 0; trudy.rig.once('hop'); trudy.squash = 0.8; if (d < 7) g.audio.sfx('thud', { pitch: 340 }); }\n    }\n    const fx = p.x - pos.x, fz = p.z - pos.z;\n    trudy.yaw = Math.atan2(fx, fz);\n    // Her bubble slides to the high side of the world.\n    const c = Math.cos(trudy.yaw), s = Math.sin(trudy.yaw);\n    trudy.feel((-g.phys.tx * c + g.phys.tz * s) * 6);\n  }\n  chase(snap) {\n    const g = this.game, p = g.phys.pos;\n    g.art.group.updateWorldMatrix(true, false);\n    _v.set(p.x, 0.9, p.z).applyMatrix4(g.art.group.matrixWorld);\n    const d = this.dist, a = this.orbit;\n    const cx = _v.x + Math.sin(a) * d * Math.cos(this.pitch), cy = _v.y + Math.sin(this.pitch) * d + 0.8, cz = _v.z + Math.cos(a) * d * Math.cos(this.pitch);\n    g.rig.shot(cx, cy, cz, _v.x, _v.y + 0.7, _v.z, { snap, rate: 6, fov: 42 });\n  }\n  frame(dt) {\n    const g = this.game, ph = g.phys, doll = this.doll;\n    g.syncIsland(dt);\n    this.chase(false);\n    const p = ph.pos;\n    _iq.set(ph.q.x, ph.q.y, ph.q.z, ph.q.w).invert();\n    const trudy = g.art.trudy;\n    trudy.root.quaternion.copy(_iq).multiply(_q.setFromAxisAngle(_v.set(0, 1, 0), trudy.yaw));\n    if (doll) {\n      if (this.ragdoll) this.ragdoll.sync();\n      else {\n        doll.root.position.set(p.x, 0, p.z);\n        // Most of the tilt is cancelled so the doll stands up against the crooked ground.\n        doll.root.quaternion.copy(_iq);\n        const sp = Math.hypot(ph.wantX, ph.wantZ);\n        if (sp > 0.4) { doll.face(Math.atan2(ph.wantX, ph.wantZ)); doll.rig.loop('walk', { speed: Math.max(0.7, sp / 3.2) }); } else if (this.leanTut) {\n          const i = this.input; doll.face(0);\n          doll.root.quaternion.multiply(_q.setFromEuler(new THREE.Euler(i.wishZ * 0.25, 0, -i.wishX * 0.25)));\n          doll.rig.loop('spread');\n        } else doll.rig.loop('idle');\n      }\n      doll.update(dt);\n    }\n    this.frameUI();\n  }\n  frameUI() {\n    const g = this.game;\n    const dev = g.input.lastDevice;\n    if (dev !== this.lastDev) {\n      this.lastDev = dev;\n      const list = this.promptOverride && (this.leanTut) ? this.promptOverride : [['move', 'Walk'], ['interact', 'Use'], ['ask', \"Today's plan\"], ['look', 'Look'], ['hop', 'Hop']];\n      this.promptsEl.innerHTML = list.map(([v, t]) => promptHTML(v, t, dev, g.save.settings.glyphs)).join('');\n    }\n    if (this.leanTut !== this.wasLean) { this.wasLean = this.leanTut; this.lastDev = null; }\n    const f = g.ui.top && !g.ui.top.passive ? null : this.focus;\n    const id = f ? f.id : null;\n    if (id !== this.lastFocusId) {\n      if (this.lastFocusId && MAP[this.lastFocusId]) g.art.outline(this.lastFocusId, false);\n      this.lastFocusId = id;\n      if (id && MAP[id]) g.art.outline(id, true);\n      if (f) { this.label.style.display = ''; this.label.innerHTML = `${escapeHTML(f.label)} ${promptHTML('interact', '', dev, g.save.settings.glyphs)}`; } else this.label.style.display = 'none';\n    }\n    if (f) {\n      const q = this.spotPos(f);\n      g.art.group.updateWorldMatrix(true, false);\n      _v.set(q.x, f.y, q.z).applyMatrix4(g.art.group.matrixWorld).project(g.camera);\n      this.label.style.left = `${((_v.x * 0.5 + 0.5) * 100).toFixed(2)}%`;\n      this.label.style.top = `${Math.max(8, (-_v.y * 0.5 + 0.5) * 100).toFixed(2)}%`;\n    }\n  }\n  /** Test hook: walk the bot to a spot. */\n  botDrive() { return null; }\n}\nfunction nameOf(id) { return { margaret: 'Gentle Margaret', kevin: 'Retired Kevin', sandras: 'Both Sandras', paul: 'Unsteady Paul', gerald: 'Young Gerald' }[id] || id; }\nconst escapeHTML = (s) => String(s).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nexport { diagram, openJournal, cosPick };\nEOF\ncat > src/ui/screens/plan.js <<'EOF'\nimport { h } from '../dom.js';\nimport { EVENTS, TIER_NAMES } from '../../data/events.js';\nimport { diagram } from '../diagrams.js';\nimport { openJournal } from './journal.js';\n\n/** Today's Plan: up to four big cards, done ones stamped. */\nexport function openPlan(game, hub) {\n  const pr = game.programme, p = game.save.profile;\n  const today = pr.classesToday();\n  let scr = null;\n  const close = () => game.ui.close(scr);\n  scr = game.ui.open({\n    name: 'plan', className: 'dim',\n    prompts: [['use', 'Go there'], ['ask', 'Journal'], ['back', 'Back']],\n    back: close,\n    alt: () => openJournal(game),\n    build: (s) => {\n      const def = pr.dayDef(p.today.day);\n      s.el.append(h('div.h2', { style: 'margin-top:3rem' }, \"Today's Plan\"));\n      s.el.append(h('div.sign', { style: 'margin-bottom:2.4rem;font-size:3.4rem' }, `Day ${p.today.day}: ${def.name}`));\n      const cards = h('div.cards');\n      s.el.append(cards);\n      for (const id of today) {\n        const d = EVENTS[id];\n        const done = p.today.done.includes(id);\n        const m = pr.medalOf(id, pr.programmeTier(id));\n        const el = h(`div.card${done ? '.done' : ''}`,\n          h('div.art', { html: diagram(d.diagram) }),\n          h('div.name', d.title),\n          h('div', d.place),\n          done ? h('div.stamp', { 'data-stamp': id }, m ? m.medal.toUpperCase() : 'DONE') : null);\n        cards.append(s.item(el, { use: () => {\n          close();\n          if (hub) hub.goClass(id, !done);\n        } }));\n      }\n      if (!pr.planLeft().length) s.el.append(h('div.tag', { style: 'margin-top:2.4rem' }, 'All done. The Bed Hut is open.'));\n    },\n  });\n  return scr;\n}\nEOF\ncat > src/ui/screens/mirror.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { h } from '../dom.js';\nimport { PAINTS, paintColour, Doll } from '../../art/doll.js';\nimport { HATS, LATE_PAINTS } from '../../data/unlocks.js';\nimport { rot2 } from '../../render/cameraRig.js';\n\n/** The Mirror: paint and hat picker, on a doll that spins. Locked things show a marble count. */\nexport function openMirror(game, hub) {\n  const p = game.save.profile, pr = game.programme;\n  const doll = new Doll({ shirt: paintColour(p.paint), hat: p.hat });\n  const art = game.art;\n  const m = art.spots.mirror;\n  doll.root.position.set(0, 0, 2.4);\n  m.add(doll.root);\n  doll.rig.loop('breathe');\n  let yaw = 0;\n  let paintI = PAINTS.findIndex((x) => x.id === p.paint), hatI = HATS.findIndex((x) => x.id === p.hat);\n  let scr = null;\n  const close = () => {\n    m.remove(doll.root);\n    game.ui.close(scr);\n    game.save.write();\n    if (hub && hub.doll) { hub.doll.setShirt(paintColour(p.paint)); hub.doll.setHat(p.hat); }\n    hub.mirrorShot = false;\n  };\n  const camBack = game.rig.tPos.clone();\n  scr = game.ui.open({\n    name: 'mirror', prompts: [['use', 'Choose'], ['back', 'Back']], back: close,\n    update: (dt) => {\n      yaw += dt * 0.7;\n      doll.root.rotation.y = yaw;\n      doll.update(dt);\n    },\n    build: (s) => {\n      s.el.append(h('div.h2', { style: 'margin-top:3rem' }, 'The Mirror'));\n      const col = h('div.col', { style: 'position:absolute;right:9rem;top:30rem;align-items:stretch' });\n      s.el.append(col);\n      const paintEl = h('span'), hatEl = h('span');\n      const renderP = () => {\n        const x = PAINTS[paintI];\n        const lock = LATE_PAINTS.find((l) => l.id === x.id);\n        const locked = !pr.paintsOpen().includes(x.id);\n        paintEl.textContent = locked ? `${x.name} (${lock ? lock.at : 0} marbles)` : x.name;\n        if (!locked) { p.paint = x.id; }\n        doll.setShirt(x.shirt);\n      };\n      const renderH = () => {\n        const x = HATS[hatI];\n        const locked = !pr.hatsOpen().some((o) => o.id === x.id);\n        hatEl.textContent = locked ? `${x.name} (${x.at} marbles)` : x.name;\n        if (!locked) p.hat = x.id;\n        doll.setHat(x.id);\n      };\n      const shiftP = (d) => { paintI = (paintI + d + PAINTS.length) % PAINTS.length; renderP(); game.audio.sfx('uiMove'); };\n      const shiftH = (d) => { hatI = (hatI + d + HATS.length) % HATS.length; renderH(); game.audio.sfx('uiMove'); };\n      col.append(s.item(h('div', 'Paint: ', paintEl), { left: () => shiftP(-1), right: () => shiftP(1), use: () => shiftP(1), silent: true }));\n      col.append(s.item(h('div', 'Hat: ', hatEl), { left: () => shiftH(-1), right: () => shiftH(1), use: () => shiftH(1), silent: true }));\n      col.append(s.item(h('div', 'That will do'), { use: close }));\n      renderP(); renderH();\n      const line = game.line('trudy', 'mirror');\n      game.speech.say('trudy', line, { auto: 4 });\n    },\n  });\n  // Frame the doll and the mirror.\n  hub.mirrorShot = true;\n  return { camBack, THREE, rot2 };\n}\nEOF\ncat > src/game/jar.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { RAPIER, groups, createWorld } from '../physics/world.js';\nimport { MAP } from '../art/island.js';\nimport { MEDALS } from '../data/config.js';\nimport { h } from '../ui/dom.js';\nimport { cos } from '../core/rng.js';\nimport { line } from '../data/dialogue.js';\n\nconst _m = new THREE.Matrix4(), _p = new THREE.Vector3(), _q = new THREE.Quaternion(), _s = new THREE.Vector3(1, 1, 1), _c = new THREE.Color();\nconst CAP = 320;\nexport const medalColour = (id) => (MEDALS.find((m) => m.id === id) || MEDALS[0]).colour;\nconst JAR_R = 1.08 - 0.03, H = 1.86;\n\n/** Settled positions for the marbles already in the jar, packed deterministically. */\nexport function packedPositions(n) {\n  const out = [];\n  let y = 0.17, layer = 0;\n  while (out.length < n) {\n    const rings = [[0, 1]];\n    for (let r = 0.29; r < JAR_R - 0.15; r += 0.28) rings.push([r, Math.floor((2 * Math.PI * r) / 0.29)]);\n    for (const [r, c] of rings) {\n      for (let i = 0; i < c && out.length < n; i++) {\n        const a = (i / c) * Math.PI * 2 + layer * 0.5;\n        out.push([Math.cos(a) * r, y, Math.sin(a) * r]);\n      }\n    }\n    y += 0.25; layer++;\n    if (y > 2.3) y = 2.3;\n  }\n  return out;\n}\n\n/** Show the marbles in the jar on the island without any physics. */\nexport function refreshJarDisplay(game) {\n  const art = game.art, p = game.save.profile;\n  const mesh = art.marbleMesh;\n  const log = p ? (p.marbleLog || []).slice(-CAP) : [];\n  const pos = game.jarPositions && game.jarPositions.length === log.length ? game.jarPositions : packedPositions(log.length);\n  mesh.count = log.length;\n  for (let i = 0; i < log.length; i++) {\n    _p.set(pos[i][0], pos[i][1], pos[i][2]); _q.set(0, 0, 0, 1);\n    _m.compose(_p, _q, _s); mesh.setMatrixAt(i, _m);\n    mesh.setColorAt(i, _c.set(medalColour(log[i])));\n  }\n  mesh.instanceMatrix.needsUpdate = true;\n  if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;\n}\n\n/** Marbles pour into the jar on the island, as real balls. The count ticks up. Then the island creaks. */\nexport class JarMode {\n  constructor(game, opts = {}) {\n    this.game = game; this.opts = opts; this.name = 'jar'; this.canPause = false;\n    this.bodies = []; this.shown = 0; this.spawned = 0; this.t = 0; this.stage = 'pour';\n  }\n  enter() {\n    const g = this.game, o = this.opts;\n    g.setIsland('home');\n    g.ui.clear();\n    g.programme.syncIsland();\n    g.palette.set(g.programmePalette(), 1);\n    g.audio.music('island');\n    const p = g.save.profile;\n    const world = this.world = createWorld({ iterations: 4 });\n    world.createCollider(RAPIER.ColliderDesc.cylinder(0.1, 1.2).setTranslation(0, -0.08, 0).setFriction(0.5).setCollisionGroups(groups.anyProp()));\n    for (let i = 0; i < 16; i++) {\n      const a = (i / 16) * Math.PI * 2;\n      world.createCollider(RAPIER.ColliderDesc.cuboid(0.06, 2, 0.24).setTranslation(Math.cos(a) * (JAR_R + 0.06), 2, Math.sin(a) * (JAR_R + 0.06))\n        .setRotation({ x: 0, y: Math.sin(-a / 2), z: 0, w: Math.cos(-a / 2) }).setFriction(0.2).setCollisionGroups(groups.anyProp()));\n    }\n    const log = p ? (p.marbleLog || []).slice(-CAP) : [];\n    const newCount = Math.min(o.marbles ?? 0, log.length);\n    this.total = log.length; this.fresh = newCount; this.log = log;\n    const oldPos = packedPositions(log.length - newCount);\n    for (let i = 0; i < log.length - newCount; i++) this.addBall(oldPos[i][0], oldPos[i][1], oldPos[i][2]);\n    this.mesh = g.art.marbleMesh;\n    this.mesh.count = log.length - newCount;\n    this.scr = g.ui.open({\n      name: 'jar', prompts: [],\n      build: (s) => {\n        s.el.append(h('div.h2', { style: 'margin-top:3rem' }, 'The Jar'));\n        this.countEl = h('div.bignum', '0');\n        s.el.append(h('div', { style: 'position:absolute;right:12rem;top:24rem' }, this.countEl));\n      },\n    });\n    const m = MAP.jar;\n    const ph = g.phys;\n    ph.setPosition(m.x + 2, m.z + 3);\n    this.base = (p ? p.marbles : 0) - newCount;\n    this.handle = g.scripts.run(this.flow());\n    this.camera(true);\n    this.syncMarbles();\n  }\n  addBall(x, y, z, vy = 0) {\n    const b = this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x, y, z).setLinvel(cos(-0.4, 0.4), vy, cos(-0.4, 0.4)).setCanSleep(true));\n    this.world.createCollider(RAPIER.ColliderDesc.ball(0.14).setMass(0.02).setFriction(0.3).setRestitution(0.35).setCollisionGroups(groups.anyProp()), b);\n    this.bodies.push(b);\n    return b;\n  }\n  *flow() {\n    const g = this.game, o = this.opts;\n    yield 0.5;\n    const n = this.fresh;\n    const gap = Math.max(0.03, Math.min(0.12, 2.2 / Math.max(1, n)));\n    let hits = 0;\n    for (let i = 0; i < n; i++) {\n      this.addBall(cos(-0.2, 0.2), 3.2, cos(-0.2, 0.2), -2);\n      this.mesh.count = this.bodies.length;\n      const c = medalColour(this.log[this.bodies.length - 1]);\n      this.mesh.setColorAt(this.bodies.length - 1, _c.set(c));\n      if (this.mesh.instanceColor) this.mesh.instanceColor.needsUpdate = true;\n      this.spawned++;\n      g.audio.sfx('marble', { pitch: 1400 + cos(0, 2500) });\n      hits++;\n      if (hits % 3 === 0) g.audio.sfx('marbleRoll');\n      this.count = this.base + this.spawned;\n      this.countEl.textContent = String(this.count);\n      yield gap;\n    }\n    this.count = this.base + n;\n    this.countEl.textContent = String(this.count);\n    if (o.unlocks && o.unlocks.length) {\n      g.audio.sting('unlock');\n      g.ui.toast(`New: ${o.unlocks.map((u) => u.name).join(', ')}. See the Mirror.`, 3.4);\n    }\n    yield 1.1;\n    this.stage = 'notch';\n    if (o.notch) {\n      // The island creaks and comes up one notch. Everything shuffles.\n      g.audio.sfx('creak', { dur: 2.6 });\n      g.rig.shake(0.05);\n      g.phys.setRest(g.programme.restDeg());\n      const trudy = g.art.trudy;\n      trudy.rig.once('gasp');\n      g.speech.say('trudy', line('trudy', 'notch'), { auto: 0 });\n      const l = g.speech.line;\n      yield () => !g.speech.line || g.speech.line !== l;\n    } else {\n      g.speech.say('trudy', line('trudy', 'jar'), { auto: 0 });\n      const l = g.speech.line;\n      yield () => !g.speech.line || g.speech.line !== l;\n    }\n    this.stage = 'done';\n    this.keep();\n    g.go(() => { if (o.then) o.then(); else g.flow.toIsland({ afterJar: true, at: 'jar' }); });\n  }\n  keep() {\n    const g = this.game;\n    g.jarPositions = this.bodies.map((b) => { const t = b.translation(); return [t.x, Math.max(0.14, t.y), t.z]; });\n  }\n  camera(snap) {\n    const g = this.game, m = MAP.jar;\n    g.art.group.updateWorldMatrix(true, false);\n    _p.set(m.x, 1.6, m.z).applyMatrix4(g.art.group.matrixWorld);\n    g.rig.shot(_p.x - 1.2, _p.y + 1.6, _p.z + 8.6, _p.x, _p.y + 0.3, _p.z, { fov: 38, snap, rate: 3 });\n  }\n  fixed(dt) {\n    const g = this.game;\n    this.t += dt;\n    g.stepIsland(dt, 0.2);\n    this.world.step();\n  }\n  syncMarbles() {\n    const mesh = this.mesh;\n    for (let i = 0; i < this.bodies.length; i++) {\n      const t = this.bodies[i].translation();\n      _p.set(t.x, t.y, t.z); _q.set(0, 0, 0, 1);\n      _m.compose(_p, _q, _s); mesh.setMatrixAt(i, _m);\n      if (i < this.total - this.fresh) mesh.setColorAt(i, _c.set(medalColour(this.log[i])));\n    }\n    mesh.instanceMatrix.needsUpdate = true;\n    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;\n  }\n  frame(dt) {\n    const g = this.game;\n    g.syncIsland(dt);\n    this.camera(false);\n    this.syncMarbles();\n  }\n  exit() {\n    const g = this.game;\n    if (this.handle) this.handle.cancel();\n    this.keep();\n    if (this.world) { this.world.free(); this.world = null; }\n    g.speech.clear();\n    if (this.scr) g.ui.close(this.scr);\n    g.ui.clear();\n    refreshJarDisplay(g);\n  }\n}\nEOF\n","description":"Write hub, plan, mirror and jar modes"}}}
