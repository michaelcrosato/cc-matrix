{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019mxwQ3tGkc8YL7xmXaccRx","type":"tool_result","content":"--- play helper\n  const play = (id, skill, seed, setup, tier = 0, cap = 200) => page.evaluate(({ id, skill, seed, setup, tier, cap }) => {\n    const T = window.__TEST__;\n    T.game.save.settings.autoBreathe = false;\n    const rngMod = window.__TEST__.setSeed;\n    if (rngMod) rngMod(seed);\n    T.startEvent(id, tier, {});\n    const ev = T.game.currentEvent;\n    const l = ev.lanes[0];\n    if (setup) Object.assign(l, setup);\n    T.bot(skill);\n    let t = 0;\n    while (t < cap && !ev.isDone()) { T.advance(1); t++; }\n    T.bot(null);\n    const r = ev.laneResult(l);\n    const out = { form: r.form, raw: r.raw, falls: l.falls, t, stats: r.stats };\n    if (id === 'plates') out.share = r.raw;\n    if (id === 'tug') out.wins = ev.wins;\n    if (id === 'cairn') out.stones = l.onSlab;\n    if (id === 'roomService') out.glasses = l.tumblers.filter((x) => x.on).length;\n    T.goto('menu');\n    return out;\n  }, { id, skill, seed, setup: setup || null, tier, cap });\n--- T.bot and hook\n    bot(skill) {\n      botSkill = skill;\n      if (!skill) {\n        const p = pad();\n        p.axes.fill(0);\n        for (const b of p.buttons) { b.pressed = false; b.value = 0; }\n      }\n      return skill;\n    },\n    keysBot(on) { botKeys = on; },\n--- bot data in springboard\n37:    lane.dives = []; lane.dive = 0; lane.boardY = 0; lane.boardV = 0.4; lane.phase2 = 'pump'; lane.pumpT = 0; lane.air = 0; lane.angle = 0; lane.spin = 0; la\n148:    lane.dive++;\n241:    if (lane.dive >= this.maxDives) lane.phase2 = 'finished'; else { lane.phase2 = 'pump'; this.game.audio.sfx('spring'); }\n242:    if (lane.bot) lane.bot.data = {};\n243:    if (lane.testBot) lane.testBot.data = {};\n260:    const d = bot.data;\n272:      const goal = (d.goal ?? (d.goal = bot.r() < (lane.wantDive ? 1 : 0.15) ? Math.PI : Math.PI / 2));\n--- how base drives the bot\n11: