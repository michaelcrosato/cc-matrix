b484272',\n  '1.2.0': '2d6e9bd677210500e7683deaa88dace3f70b28295f85b0525a1811b2bc9bd088',\n  '1.3.0': '32ed0ff62e4e0880bc78db850a0cff8dd7c9277d34ef76cafc60d535d41761db',\n  '1.4.0': '529eac78c54cfff0e60d375a9c63f66d1a594327ddcc262a2bdf9b1f2fb6582a',\n});\n\nconst BANNER = '/*! aihub-session ';\nexport const CLIENT_END = \"})(typeof window !== 'undefined' ? window : globalThis);\";\n\nconst sha256 = (text) => createHash('sha256').update(text).digest('hex');\nconst lf = (text) => text.replace(/\\r\\n/g, '\\n');\n\n/** Compare dotted versions: negative when a is older than b. */\nexport function compareVersions(a, b) {\n  const pa = String(a).split('.').map(Number);\n  const pb = String(b).split('.').map(Number);\n  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {\n    const d = (pa[i] || 0) - (pb[i] || 0);\n    if (d) return d;\n  }\n  return 0;\n}\n\nfredoka-latin-400-normal.woff2\nfredoka-latin-500-normal.woff2\nfredoka-latin-600-normal.woff2\nfredoka-latin-700-normal.woff2\n  \"version\": \"5.3.0\",\n  \"version\": \"0.28.2\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"388d2660-b6fe-47c4-b79f-7e26f7553b07","timestamp":"2026-11-05T11:46:53.975Z","tool_use_result":{"stdout":"npm warn install-scripts   esbuild@0.28.2 (postinstall: node install.js)\nnpm warn install-scripts\nnpm warn install-scripts Run `npm install-scripts ls` to review, or `npm install-scripts approve <pkg>` to allow.\nnotes:\ntotal 28\ndrwxr-xr-x 2 micha micha  4096 Nov  5 04:46 .\ndrwxr-xr-x 8 micha micha  4096 Nov  5 04:46 ..\n-rw-r--r-- 1 micha micha 17587 Nov  5 04:46 hub-README.md\n\ntools/hub:\ntotal 72\ndrwxr-xr-x 2 micha micha  4096 Nov  5 04:46 .\ndrwxr-xr-x 3 micha micha  4096 Nov  5 04:46 ..\n-rw-r--r-- 1 micha micha 13624 Nov  5 04:46 bridge.js\n-rw-r--r-- 1 micha micha 27469 Nov  5 04:46 harness.html\n-rw-r--r-- 1 micha micha 20248 Nov  5 04:46 round.js\n\nvendor:\ntotal 28\ndrwxr-xr-x 2 micha micha  4096 Nov  5 0