{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjjTptvyzrZA7QyC97GY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q1GSW5BZ19T4kvRrnntMye","name":"Bash","input":{"command":"cat > src/render/ink.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport {\n  mrt, output, normalView, toonOutlinePass, color, float, vec2, vec4, uv, screenSize, Fn, abs, max, sin,\n  smoothstep, mix, uniform, perspectiveDepthToViewZ, time, length, hash, floor, oneMinus, step,\n} from 'three/tsl';\nimport { INK } from '../data/config.js';\n\n/** Toon hull plus a screen-space ink pass, with boil, grain, vignette and the ink-blot wipe. */\nexport function makeInk(renderer, scene, camera) {\n  const inkCol = new THREE.Color(INK);\n  const u = {\n    hull: uniform(0.0028), width: uniform(1.4), boil: uniform(0.5), fadeNear: uniform(30), fadeFar: uniform(90),\n    grain: uniform(0.02), near: uniform(camera.near), far: uniform(camera.far), ink: uniform(inkCol),\n    wipe: uniform(0), strength: uniform(1),\n  };\n  const scenePass = toonOutlinePass(scene, camera, color(inkCol), u.hull, float(1));\n  scenePass.setMRT(mrt({ output, normal: normalView }));\n  const colorTex = scenePass.getTextureNode('output'), normalTex = scenePass.getTextureNode('normal'),\n    depthTex = scenePass.getTextureNode('depth');\n  const post = new THREE.PostProcessing(renderer);\n  post.outputNode = Fn(() => {\n    const cell = floor(uv().mul(vec2(40, 23)));\n    const wob = hash(floor(time.mul(8)).add(cell.x).add(cell.y.mul(17))).sub(0.5).mul(u.boil);\n    const px = u.width.add(wob).div(screenSize);\n    const viewZ = (o) => perspectiveDepthToViewZ(depthTex.sample(uv().add(o)).r, u.near, u.far);\n    const n = (o) => normalTex.sample(uv().add(o)).xyz;\n    const dx = vec2(px.x, 0), dy = vec2(0, px.y);\n    const z0 = viewZ(vec2(0, 0)).abs();\n    const dz = max(abs(viewZ(dx).sub(viewZ(dx.negate()))), abs(viewZ(dy).sub(viewZ(dy.negate())))).div(z0.max(0.5));\n    const dn = max(length(n(dx).sub(n(dx.negate()))), length(n(dy).sub(n(dy.negate()))));\n    const e = max(smoothstep(0.05, 0.12, dz), smoothstep(0.7, 1.1, dn)).mul(oneMinus(smoothstep(u.fadeNear, u.fadeFar, z0))).mul(u.strength);\n    const c = mix(colorTex.rgb, u.ink, e);\n    const p = floor(uv().mul(screenSize));\n    const g = hash(p.x.add(p.y.mul(1571))).sub(0.5).mul(u.grain);\n    const graded = c.add(g).mul(oneMinus(length(uv().sub(0.5)).mul(0.62).pow(2.2)));\n    // The ink-blot wipe: a soft-edged blot grows out of the middle of the frame.\n    const q = uv().sub(0.5).mul(vec2(screenSize.x.div(screenSize.y), 1));\n    const a = q.y.mul(9).add(sin(q.x.mul(13).add(1.3))).add(sin(q.x.mul(29).add(q.y.mul(11))).mul(0.4));\n    const b = q.x.mul(8).add(sin(q.y.mul(17).add(2.1))).add(sin(q.y.mul(31).sub(q.x.mul(7))).mul(0.4));\n    const blot = length(q).mul(1.05).add(sin(a).mul(0.05)).add(sin(b).mul(0.05));\n    const covered = step(blot, u.wipe.mul(1.2));\n    return vec4(mix(graded, u.ink, covered), 1);\n  })();\n  return { post, u };\n}\nEOF\ncat > src/data/palettes.js <<'EOF'\n// Four times of day. Hex numbers so a designer can paste them straight in.\nexport const PALETTES = {\n  dawn: { skyTop: 0x8FB4E0, skyMid: 0xF6CFD8, skyLow: 0xFFE3B5, sea: 0x3E8FB5, seaHi: 0xA9E3E4, sun: 0xFFE6D8, sunI: 2.6, hemiSky: 0xFCE8F0, hemiGround: 0x7C8BB5, hemiI: 1.35 },\n  noon: { skyTop: 0x6FC3E8, skyMid: 0xBFE9F0, skyLow: 0xFFF2D0, sea: 0x16A8B0, seaHi: 0x8CF0DD, sun: 0xFFFBE8, sunI: 3.2, hemiSky: 0xFFFFFF, hemiGround: 0xA09080, hemiI: 1.35 },\n  golden: { skyTop: 0x7FB7C9, skyMid: 0xF7D9A6, skyLow: 0xF59E6C, sea: 0x1F9EA3, seaHi: 0x71DCCB, sun: 0xFFF0D0, sunI: 3.1, hemiSky: 0xFFF4E0, hemiGround: 0x8A7FA0, hemiI: 1.25 },\n  dusk: { skyTop: 0x2B2F6B, skyMid: 0xA8558F, skyLow: 0xF58A5C, sea: 0x24406F, seaHi: 0xC26A8C, sun: 0xFFB98A, sunI: 2.4, hemiSky: 0xB48AD0, hemiGround: 0x2B2F5F, hemiI: 1.1 },\n};\nexport const PALETTE_ORDER = ['dawn', 'noon', 'golden', 'dusk'];\nEOF\ncat > src/render/palette.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { uniform } from 'three/tsl';\nimport { PALETTES, PALETTE_ORDER } from '../data/palettes.js';\n\n/** Palette uniforms and light colours, lerped over 3 s between steps. */\nexport class Palette {\n  constructor(sun, hemi) {\n    this.sun = sun; this.hemi = hemi;\n    this.name = 'dawn';\n    const p = PALETTES.dawn;\n    this.u = {};\n    for (const k of ['skyTop', 'skyMid', 'skyLow', 'sea', 'seaHi']) this.u[k] = uniform(new THREE.Color(p[k]));\n    this.cur = { ...p };\n    this.colors = {};\n    for (const k of ['skyTop', 'skyMid', 'skyLow', 'sea', 'seaHi', 'sun', 'hemiSky', 'hemiGround']) this.colors[k] = new THREE.Color(p[k]);\n    this.to = p; this.t = 1; this.dur = 3;\n    this.from = null;\n    this.apply();\n  }\n  set(name, dur = 3) {\n    const p = PALETTES[name];\n    if (!p) return;\n    this.name = name;\n    this.from = {};\n    for (const k of Object.keys(this.colors)) this.from[k] = this.colors[k].clone();\n    this.fromI = { sunI: this.cur.sunI, hemiI: this.cur.hemiI };\n    this.to = p; this.t = 0; this.dur = Math.max(dur, 0.0001);\n    if (dur <= 0) this.frame(1);\n  }\n  /** Palette for a step through the day: dawn at the start, dusk at the end. */\n  forStep(i, total) {\n    const n = PALETTE_ORDER.length;\n    return PALETTE_ORDER[Math.min(n - 1, Math.floor((i / Math.max(1, total)) * n))];\n  }\n  frame(dt) {\n    if (this.t >= 1) return;\n    this.t = Math.min(1, this.t + dt / this.dur);\n    const s = this.t;\n    const c = new THREE.Color();\n    for (const k of Object.keys(this.colors)) { c.set(this.to[k]); this.colors[k].copy(this.from[k]).lerp(c, s); }\n    this.cur.sunI = this.fromI.sunI + (this.to.sunI - this.fromI.sunI) * s;\n    this.cur.hemiI = this.fromI.hemiI + (this.to.hemiI - this.fromI.hemiI) * s;\n    this.apply();\n  }\n  apply() {\n    for (const k of ['skyTop', 'skyMid', 'skyLow', 'sea', 'seaHi']) this.u[k].value.copy(this.colors[k]);\n    if (this.sun) { this.sun.color.copy(this.colors.sun); this.sun.intensity = this.cur.sunI; }\n    if (this.hemi) { this.hemi.color.copy(this.colors.hemiSky); this.hemi.groundColor.copy(this.colors.hemiGround); this.hemi.intensity = this.cur.hemiI; }\n  }\n}\nEOF\ncat > src/render/sky.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { positionWorld, cameraPosition, normalize, smoothstep, mix, vec3 } from 'three/tsl';\nimport { toon, geo } from '../art/materials.js';\nimport { cos } from '../core/rng.js';\n\nexport function makeSky(palette) {\n  const group = new THREE.Group();\n  const mat = new THREE.MeshBasicNodeMaterial({ side: THREE.BackSide, depthWrite: false, fog: false });\n  const dir = normalize(positionWorld.sub(cameraPosition));\n  const low = mix(palette.u.skyLow, palette.u.skyMid, smoothstep(0, 0.14, dir.y));\n  mat.colorNode = vec3(mix(low, palette.u.skyTop, smoothstep(0.1, 0.5, dir.y)));\n  const dome = new THREE.Mesh(new THREE.SphereGeometry(600, 48, 24), mat);\n  dome.frustumCulled = false;\n  dome.renderOrder = -10;\n  group.add(dome);\n  // Inked toon clouds: flattened spheres that drift.\n  const clouds = [];\n  const cloudMat = toon(0xFFF8F0);\n  for (let i = 0; i < 14; i++) {\n    const c = new THREE.Group();\n    const n = 3 + Math.floor(cos(0, 4));\n    for (let j = 0; j < n; j++) {\n      const m = new THREE.Mesh(geo.sphere(1), cloudMat);\n      m.position.set((j - n / 2) * 7 + cos(-2, 2), cos(-1, 1.5), cos(-2, 2));\n      m.scale.set(cos(6, 10), cos(2.4, 4), cos(4, 6));\n      m.castShadow = false; m.receiveShadow = false;\n      c.add(m);\n    }\n    const a = cos(0, Math.PI * 2), r = cos(150, 380);\n    c.position.set(Math.cos(a) * r, cos(55, 130), Math.sin(a) * r);\n    c.userData.speed = cos(0.4, 1.2);\n    group.add(c);\n    clouds.push(c);\n  }\n  return {\n    group,\n    frame(dt) {\n      for (const c of clouds) {\n        c.position.x += c.userData.speed * dt;\n        if (c.position.x > 420) c.position.x = -420;\n      }\n    },\n  };\n}\nEOF\ncat > src/render/sea.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport {\n  positionWorld, cameraPosition, length, sin, time, step, mix, smoothstep, vec3, vec2, uniform, float, max, cos as tcos, abs,\n} from 'three/tsl';\n\n/** Hard-banded toon sea on a huge disc, melting into the horizon colour. */\nexport function makeSea(palette) {\n  const mat = new THREE.MeshBasicNodeMaterial();\n  const centre = uniform(new THREE.Vector2(0, 0));\n  const foamR = uniform(26), tiltX = uniform(0), tiltZ = uniform(0);\n  const p = positionWorld.xz;\n  const d = length(p.sub(centre));\n  const warp = sin(p.x.mul(0.07).add(time.mul(0.25))).mul(2.2).add(sin(p.y.mul(0.09).sub(time.mul(0.2))).mul(2.2));\n  const wave = sin(d.add(warp).mul(0.62).sub(time.mul(0.8))).mul(0.5).add(0.5);\n  const bands = step(0.86, wave);\n  let col = mix(palette.u.sea, palette.u.seaHi, bands);\n  // Foam rings hug the island and lean with it.\n  const q = p.sub(centre);\n  const leaned = d.add(q.x.mul(tiltX).add(q.y.mul(tiltZ)).mul(6));\n  const ring = sin(leaned.mul(1.1).sub(time.mul(1.4))).mul(0.5).add(0.5);\n  const foam = step(0.72, ring).mul(float(1).sub(smoothstep(foamR, foamR.add(9), d)));\n  col = mix(col, vec3(0.97, 0.98, 0.96), foam.mul(0.85));\n  const camD = length(p.sub(cameraPosition.xz));\n  mat.colorNode = mix(col, palette.u.skyLow, smoothstep(60, 260, camD));\n  const geo = new THREE.CircleGeometry(590, 96);\n  geo.rotateX(-Math.PI / 2);\n  const mesh = new THREE.Mesh(geo, mat);\n  mesh.frustumCulled = false;\n  mesh.receiveShadow = false;\n  return {\n    mesh,\n    setLevel(y) { mesh.position.y = y; },\n    setFoam(x, z, r) { centre.value.set(x, z); foamR.value = r; },\n    setTilt(tx, tz) { tiltX.value = tx; tiltZ.value = tz; },\n  };\n}\nEOF\ncat > src/render/cameraRig.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { cos } from '../core/rng.js';\n\nconst _f = new THREE.Vector3();\n\n/** One camera with damped targets, shake and a free-fly mode for Dev Mode. */\nexport class CameraRig {\n  constructor(camera) {\n    this.camera = camera;\n    this.pos = new THREE.Vector3(0, 8, 30); this.look = new THREE.Vector3();\n    this.tPos = this.pos.clone(); this.tLook = this.look.clone();\n    this.rate = 6; this.shakeAmt = 0; this.reduce = false;\n    this.yaw = 0; this.fov = 38; this.tFov = 38;\n    this.free = false; this.freeYaw = 0; this.freePitch = -0.2;\n  }\n  /** Frame a shot. snap skips the easing. */\n  shot(px, py, pz, lx, ly, lz, { fov = 38, rate = 3, snap = false } = {}) {\n    this.tPos.set(px, py, pz); this.tLook.set(lx, ly, lz); this.tFov = fov; this.rate = rate;\n    if (snap) { this.pos.copy(this.tPos); this.look.copy(this.tLook); this.fov = fov; }\n  }\n  /** Lens distance that fits a lane spread: d = max(base, (spread/2 + 2.5) / tan(hfov/2)). */\n  fitDistance(base, spread) {\n    const aspect = this.camera.aspect || 16 / 9;\n    const hfov = 2 * Math.atan(Math.tan((this.tFov * Math.PI) / 360) * aspect);\n    return Math.max(base, (spread / 2 + 2.5) / Math.tan(hfov / 2));\n  }\n  shake(a) { if (!this.reduce) this.shakeAmt = Math.max(this.shakeAmt, a); }\n  frame(dt) {\n    const k = 1 - Math.exp(-this.rate * dt);\n    this.pos.lerp(this.tPos, k); this.look.lerp(this.tLook, k);\n    this.fov += (this.tFov - this.fov) * k;\n    const c = this.camera;\n    if (Math.abs(c.fov - this.fov) > 0.01) { c.fov = this.fov; c.updateProjectionMatrix(); }\n    if (!this.free) {\n      c.position.copy(this.pos);\n      if (this.shakeAmt > 0.001) {\n        c.position.x += cos(-1, 1) * this.shakeAmt; c.position.y += cos(-1, 1) * this.shakeAmt;\n        this.shakeAmt *= Math.exp(-7 * dt);\n      }\n      c.lookAt(this.look);\n    } else {\n      c.rotation.order = 'YXZ'; c.rotation.set(this.freePitch, this.freeYaw, 0);\n    }\n    c.getWorldDirection(_f);\n    this.yaw = Math.atan2(-_f.x, -_f.z);\n  }\n  freeMove(dt, mx, mz, lx, ly) {\n    const c = this.camera, sp = 14 * dt;\n    this.freeYaw -= lx * 1.6 * dt; this.freePitch = Math.max(-1.5, Math.min(1.5, this.freePitch - ly * 1.2 * dt));\n    const s = Math.sin(this.freeYaw), o = Math.cos(this.freeYaw);\n    c.position.x += (mx * o + mz * s) * sp; c.position.z += (-mx * s + mz * o) * sp;\n  }\n}\n/** Stick space to world: right is screen right, up is away from the camera. */\nexport function rot2(x, z, yaw) {\n  const c = Math.cos(yaw), s = Math.sin(yaw);\n  return [x * c + z * s, -x * s + z * c];\n}\nEOF\ncat > src/art/materials.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';\nimport { INK } from '../data/config.js';\n\n// Cel shading: a three-step ramp on toon node materials.\nlet ramp = null;\nfunction gradient() {\n  if (ramp) return ramp;\n  ramp = new THREE.DataTexture(new Uint8Array([96, 178, 255]), 3, 1, THREE.RedFormat);\n  ramp.minFilter = THREE.NearestFilter; ramp.magFilter = THREE.NearestFilter;\n  ramp.colorSpace = THREE.NoColorSpace;\n  ramp.needsUpdate = true;\n  return ramp;\n}\nconst cache = new Map();\nexport function toon(color) {\n  const key = typeof color === 'string' ? new THREE.Color(color).getHex() : color;\n  let m = cache.get(key);\n  if (!m) { m = new THREE.MeshToonNodeMaterial({ color: key, gradientMap: gradient() }); cache.set(key, m); }\n  return m;\n}\nexport const freshToon = (color, opts = {}) => new THREE.MeshToonNodeMaterial({ color, gradientMap: gradient(), ...opts });\nexport const basic = (color, opts = {}) => new THREE.MeshBasicNodeMaterial({ color, ...opts });\nexport const inkMat = () => toon(INK);\n/** Glass: never toon, or the hull draws solid ink behind it. */\nexport const glass = (opacity = 0.16) => new THREE.MeshBasicNodeMaterial({ color: 0xe8fbff, transparent: true, opacity, side: THREE.DoubleSide, depthWrite: false });\n\n// Shared geometry, keyed by size.\nconst gc = new Map();\nconst memo = (k, f) => { let g = gc.get(k); if (!g) { g = f(); gc.set(k, g); } return g; };\nexport const geo = {\n  sphere: (r = 1, w = 20, h = 14) => memo(`s${r},${w}`, () => new THREE.SphereGeometry(r, w, h)),\n  box: (x, y, z) => memo(`b${x},${y},${z}`, () => new THREE.BoxGeometry(x, y, z)),\n  rbox: (x, y, z, r = 0.05) => memo(`r${x},${y},${z},${r}`, () => new RoundedBoxGeometry(x, y, z, 3, r)),\n  cyl: (rt, rb, h, s = 20) => memo(`c${rt},${rb},${h},${s}`, () => new THREE.CylinderGeometry(rt, rb, h, s)),\n  cone: (r, h, s = 16) => memo(`n${r},${h},${s}`, () => new THREE.ConeGeometry(r, h, s)),\n  cap: (r, l, s = 14) => memo(`p${r},${l},${s}`, () => new THREE.CapsuleGeometry(r, l, 6, s)),\n  tor: (r, t, a = Math.PI * 2, s = 40) => memo(`t${r},${t},${a},${s}`, () => new THREE.TorusGeometry(r, t, 10, s, a)),\n  disc: (r, s = 40) => memo(`d${r},${s}`, () => { const g = new THREE.CircleGeometry(r, s); g.rotateX(-Math.PI / 2); return g; }),\n  ring: (a, b, s = 40) => memo(`g${a},${b},${s}`, () => { const g = new THREE.RingGeometry(a, b, s); g.rotateX(-Math.PI / 2); return g; }),\n};\n\n/** A shadowed mesh at a spot. opts: rot [x,y,z], scale number or [x,y,z], shadow. */\nexport function M(g, m, x = 0, y = 0, z = 0, opts = {}) {\n  const mesh = new THREE.Mesh(g, typeof m === 'number' || typeof m === 'string' ? toon(m) : m);\n  mesh.position.set(x, y, z);\n  if (opts.rot) mesh.rotation.set(...opts.rot);\n  if (opts.scale !== undefined) { if (Array.isArray(opts.scale)) mesh.scale.set(...opts.scale); else mesh.scale.setScalar(opts.scale); }\n  mesh.castShadow = opts.shadow !== false; mesh.receiveShadow = opts.receive !== false;\n  if (opts.parent) opts.parent.add(mesh);\n  return mesh;\n}\nexport const add = (parent, ...kids) => { for (const k of kids) parent.add(k); return parent; };\nexport const G = (name, x = 0, y = 0, z = 0) => { const g = new THREE.Group(); if (name) g.name = name; g.position.set(x, y, z); return g; };\n\n/** A thick-outline copy of a group's meshes, hidden until hovered. */\nexport function makeOutline(group, thickness = 0.06) {\n  const mat = new THREE.MeshBasicNodeMaterial({ color: new THREE.Color(INK), side: THREE.BackSide });\n  mat.positionNode = outlinePosition(thickness);\n  const holder = new THREE.Group();\n  const meshes = [];\n  group.updateWorldMatrix(true, true);\n  group.traverse((o) => { if (o.isMesh && !o.material.transparent) meshes.push(o); });\n  const inv = new THREE.Matrix4().copy(group.matrixWorld).invert();\n  for (const o of meshes) {\n    const c = new THREE.Mesh(o.geometry, mat);\n    c.matrixAutoUpdate = false;\n    c.matrix.multiplyMatrices(inv, o.matrixWorld);\n    c.castShadow = false; c.receiveShadow = false;\n    holder.add(c);\n  }\n  holder.visible = false;\n  group.add(holder);\n  return holder;\n}\nimport { positionLocal, normalLocal, float } from 'three/tsl';\nfunction outlinePosition(t) { return positionLocal.add(normalLocal.mul(float(t))); }\nEOF\ncat > src/render/particles.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { toon, geo } from '../art/materials.js';\nimport { cos } from '../core/rng.js';\n\nconst _m = new THREE.Matrix4(), _q = new THREE.Quaternion(), _s = new THREE.Vector3(), _p = new THREE.Vector3(), _c = new THREE.Color(), _e = new THREE.Euler();\n\n/** CPU-driven instanced blobs: splashes, confetti, dust. No compute: it must run on WebGL2 too. */\nexport class Particles {\n  constructor(max = 900) {\n    this.max = max; this.items = []; this.free = [];\n    this.mesh = new THREE.InstancedMesh(geo.sphere(1, 10, 8), toon(0xffffff), max);\n    this.mesh.castShadow = false; this.mesh.receiveShadow = false;\n    this.mesh.frustumCulled = false;\n    this.mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n    this.cube = new THREE.InstancedMesh(geo.box(1, 1, 0.12), toon(0xffffff), 400);\n    this.cube.castShadow = false; this.cube.receiveShadow = false; this.cube.frustumCulled = false;\n    this.cube.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n    this.flakes = [];\n    for (let i = 0; i < max; i++) { this.mesh.setColorAt(i, _c.set(0xffffff)); this.free.push(i); }\n    for (let i = 0; i < 400; i++) this.cube.setColorAt(i, _c.set(0xffffff));\n    this.mesh.count = max; this.cube.count = 400;\n    _m.makeScale(0, 0, 0);\n    for (let i = 0; i < max; i++) this.mesh.setMatrixAt(i, _m);\n    for (let i = 0; i < 400; i++) this.cube.setMatrixAt(i, _m);\n    this.cubeNext = 0;\n  }\n  addTo(scene) { scene.add(this.mesh); scene.add(this.cube); }\n  spawn(x, y, z, vx, vy, vz, size, colour, life = 0.8, g = 9.8) {\n    const i = this.free.pop();\n    if (i === undefined) return;\n    this.items.push({ i, x, y, z, vx, vy, vz, size, life, t: 0, g, floor: -1e9 });\n    this.mesh.setColorAt(i, _c.set(colour));\n    if (this.mesh.instanceColor) this.mesh.instanceColor.needsUpdate = true;\n  }\n  burst(x, y, z, n, opts = {}) {\n    const { speed = 3, up = 3, size = 0.08, colour = 0xffffff, life = 0.7, spread = 1, colours = null } = opts;\n    for (let k = 0; k < n; k++) {\n      const a = cos(0, Math.PI * 2), r = cos(0.2, 1) * speed * spread;\n      this.spawn(x, y, z, Math.cos(a) * r, cos(0.4, 1.3) * up, Math.sin(a) * r, size * cos(0.6, 1.3), colours ? colours[k % colours.length] : colour, life * cos(0.7, 1.2));\n    }\n  }\n  splash(x, y, z, big = 1, colour = 0xEFFBFB) {\n    this.burst(x, y, z, Math.round(26 * big), { speed: 2.2 * big, up: 6.5 * Math.sqrt(big), size: 0.11 * Math.sqrt(big), colour, life: 1 });\n  }\n  /** Confetti flakes tumble and flutter. */\n  confetti(x, y, z, n, colours, spread = 6) {\n    for (let k = 0; k < n; k++) {\n      const i = this.cubeNext = (this.cubeNext + 1) % 400;\n      const old = this.flakes.findIndex((f) => f.i === i);\n      if (old >= 0) this.flakes.splice(old, 1);\n      this.flakes.push({ i, x: x + cos(-spread, spread), y: y + cos(0, 3), z: z + cos(-spread, spread), s: cos(0.05, 0.11), ph: cos(0, 6), sp: cos(1, 4), life: cos(2.5, 5), t: 0 });\n      this.cube.setColorAt(i, _c.set(colours[k % colours.length]));\n    }\n    if (this.cube.instanceColor) this.cube.instanceColor.needsUpdate = true;\n  }\n  frame(dt) {\n    const items = this.items;\n    for (let n = items.length - 1; n >= 0; n--) {\n      const p = items[n];\n      p.t += dt;\n      if (p.t >= p.life) {\n        _m.makeScale(0, 0, 0); this.mesh.setMatrixAt(p.i, _m);\n        this.free.push(p.i); items[n] = items[items.length - 1]; items.pop();\n        continue;\n      }\n      p.vy -= p.g * dt;\n      p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt;\n      const s = p.size * (1 - (p.t / p.life) ** 3);\n      _m.makeScale(s, s, s); _m.setPosition(p.x, p.y, p.z);\n      this.mesh.setMatrixAt(p.i, _m);\n    }\n    if (items.length || this._dirty) { this.mesh.instanceMatrix.needsUpdate = true; this._dirty = items.length > 0; }\n    const fl = this.flakes;\n    for (let n = fl.length - 1; n >= 0; n--) {\n      const f = fl[n];\n      f.t += dt;\n      if (f.t >= f.life) {\n        _m.makeScale(0, 0, 0); this.cube.setMatrixAt(f.i, _m);\n        fl[n] = fl[fl.length - 1]; fl.pop();\n        continue;\n      }\n      f.y -= 1.2 * dt; f.x += Math.sin(f.t * f.sp + f.ph) * 0.8 * dt;\n      _e.set(f.t * f.sp, f.ph + f.t * 2, f.t * 1.3); _q.setFromEuler(_e);\n      _s.setScalar(f.s); _p.set(f.x, f.y, f.z);\n      _m.compose(_p, _q, _s); this.cube.setMatrixAt(f.i, _m);\n    }\n    if (fl.length || this._dirtyC) { this.cube.instanceMatrix.needsUpdate = true; this._dirtyC = fl.length > 0; }\n  }\n  clear() {\n    for (const p of this.items) { _m.makeScale(0, 0, 0); this.mesh.setMatrixAt(p.i, _m); this.free.push(p.i); }\n    this.items.length = 0;\n    for (const f of this.flakes) { _m.makeScale(0, 0, 0); this.cube.setMatrixAt(f.i, _m); }\n    this.flakes.length = 0;\n    this.mesh.instanceMatrix.needsUpdate = true; this.cube.instanceMatrix.needsUpdate = true;\n  }\n}\nEOF\ncat > src/render/comicText.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { INK } from '../data/config.js';\n\n// Inked world-space words: canvas-texture sprites that pop and fade.\nconst cache = new Map();\nfunction wordTexture(word, colour) {\n  const key = word + colour;\n  if (cache.has(key)) return cache.get(key);\n  const c = document.createElement('canvas');\n  c.width = 512; c.height = 192;\n  const g = c.getContext('2d');\n  if (g) {\n    g.font = '700 120px Fredoka, Arial Rounded MT Bold, sans-serif';\n    g.textAlign = 'center'; g.textBaseline = 'middle';\n    g.lineJoin = 'round';\n    g.lineWidth = 26; g.strokeStyle = INK; g.strokeText(word, 256, 100);\n    g.fillStyle = colour; g.fillText(word, 256, 100);\n  }\n  const t = new THREE.CanvasTexture(c);\n  t.colorSpace = THREE.SRGBColorSpace;\n  cache.set(key, t);\n  return t;\n}\n\nexport class ComicText {\n  constructor(scene) { this.scene = scene; this.items = []; }\n  pop(word, x, y, z, { colour = '#FFF4DC', size = 2.4, life = 1.1 } = {}) {\n    const mat = new THREE.SpriteNodeMaterial({ map: wordTexture(word, colour), transparent: true, depthTest: false, depthWrite: false });\n    const s = new THREE.Sprite(mat);\n    s.position.set(x, y, z);\n    s.renderOrder = 50;\n    s.userData = { t: 0, life, size, vy: 0.7, tilt: (word.length % 2 ? 1 : -1) * 0.12 };\n    mat.rotation = s.userData.tilt;\n    this.scene.add(s);\n    this.items.push(s);\n    return s;\n  }\n  frame(dt) {\n    for (let i = this.items.length - 1; i >= 0; i--) {\n      const s = this.items[i], u = s.userData;\n      u.t += dt;\n      const k = u.t / u.life;\n      const pop = Math.min(1, u.t / 0.1);\n      const sc = u.size * (pop < 1 ? pop * 1.25 : 1 + 0.25 * Math.max(0, 1 - (u.t - 0.1) / 0.12));\n      s.scale.set(sc, sc * 0.375, 1);\n      s.position.y += u.vy * dt;\n      s.material.opacity = k > 0.7 ? 1 - (k - 0.7) / 0.3 : 1;\n      if (k >= 1) { this.scene.remove(s); s.material.dispose(); this.items.splice(i, 1); }\n    }\n  }\n  clear() { for (const s of this.items) { this.scene.remove(s); s.material.dispose(); } this.items = []; }\n}\nEOF\n","description":"Write rendering modules and materials"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":30595,"cache_read_input_tokens":106800,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":30595},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6048a4b4-78b7-4200-a8b0-b745f5bb937e","uuid":"449e22bf-364b-4771-a902-9c458dd5cdab","timestamp":"2026-11-05T11:53:15.845Z","request_id":"req_011CgjjTpd4jpyg5FVZC6vBW","wire_tool_inputs":{"toolu_01Q1GSW5BZ19T4kvRrnntMye":{"command":"cat > src/render/ink.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport {\n  mrt, output, normalView, toonOutlinePass, color, float, vec2, vec4, uv, screenSize, Fn, abs, max, sin,\n  smoothstep, mix, uniform, perspectiveDepthToViewZ, time, length, hash, floor, oneMinus, step,\n} from 'three/tsl';\nimport { INK } from '../data/config.js';\n\n/** Toon hull plus a screen-space ink pass, with boil, grain, vignette and the ink-blot wipe. */\nexport function makeInk(renderer, scene, camera) {\n  const inkCol = new THREE.Color(INK);\n  const u = {\n    hull: uniform(0.0028), width: uniform(1.4), boil: uniform(0.5), fadeNear: uniform(30), fadeFar: uniform(90),\n    grain: uniform(0.02), near: uniform(camera.near), far: uniform(camera.far), ink: uniform(inkCol),\n    wipe: uniform(0), strength: uniform(1),\n  };\n  const scenePass = toonOutlinePass(scene, camera, color(inkCol), u.hull, float(1));\n  scenePass.setMRT(mrt({ output, normal: normalView }));\n  const colorTex = scenePass.getTextureNode('output'), normalTex = scenePass.getTextureNode('normal'),\n    depthTex = scenePass.getTextureNode('depth');\n  const post = new THREE.PostProcessing(renderer);\n  post.outputNode = Fn(() => {\n    const cell = floor(uv().mul(vec2(40, 23)));\n    const wob = hash(floor(time.mul(8)).add(cell.x).add(cell.y.mul(17))).sub(0.5).mul(u.boil);\n    const px = u.width.add(wob).div(screenSize);\n    const viewZ = (o) => perspectiveDepthToViewZ(depthTex.sample(uv().add(o)).r, u.near, u.far);\n    const n = (o) => normalTex.sample(uv().add(o)).xyz;\n    const dx = vec2(px.x, 0), dy = vec2(0, px.y);\n    const z0 = viewZ(vec2(0, 0)).abs();\n    const dz = max(abs(viewZ(dx).sub(viewZ(dx.negate()))), abs(viewZ(dy).sub(viewZ(dy.negate())))).div(z0.max(0.5));\n    const dn = max(length(n(dx).sub(n(dx.negate()))), length(n(dy).sub(n(dy.negate()))));\n    const e = max(smoothstep(0.05, 0.12, dz), smoothstep(0.7, 1.1, dn)).mul(oneMinus(smoothstep(u.fadeNear, u.fadeFar, z0))).mul(u.strength);\n    const c = mix(colorTex.rgb, u.ink, e);\n    const p = floor(uv().mul(screenSize));\n    const g = hash(p.x.add(p.y.mul(1571))).sub(0.5).mul(u.grain);\n    const graded = c.add(g).mul(oneMinus(length(uv().sub(0.5)).mul(0.62).pow(2.2)));\n    // The ink-blot wipe: a soft-edged blot grows out of the middle of the frame.\n    const q = uv().sub(0.5).mul(vec2(screenSize.x.div(screenSize.y), 1));\n    const a = q.y.mul(9).add(sin(q.x.mul(13).add(1.3))).add(sin(q.x.mul(29).add(q.y.mul(11))).mul(0.4));\n    const b = q.x.mul(8).add(sin(q.y.mul(17).add(2.1))).add(sin(q.y.mul(31).sub(q.x.mul(7))).mul(0.4));\n    const blot = length(q).mul(1.05).add(sin(a).mul(0.05)).add(sin(b).mul(0.05));\n    const covered = step(blot, u.wipe.mul(1.2));\n    return vec4(mix(graded, u.ink, covered), 1);\n  })();\n  return { post, u };\n}\nEOF\ncat > src/data/palettes.js <<'EOF'\n// Four times of day. Hex numbers so a designer can paste them straight in.\nexport const PALETTES = {\n  dawn: { skyTop: 0x8FB4E0, skyMid: 0xF6CFD8, skyLow: 0xFFE3B5, sea: 0x3E8FB5, seaHi: 0xA9E3E4, sun: 0xFFE6D8, sunI: 2.6, hemiSky: 0xFCE8F0, hemiGround: 0x7C8BB5, hemiI: 1.35 },\n  noon: { skyTop: 0x6FC3E8, skyMid: 0xBFE9F0, skyLow: 0xFFF2D0, sea: 0x16A8B0, seaHi: 0x8CF0DD, sun: 0xFFFBE8, sunI: 3.2, hemiSky: 0xFFFFFF, hemiGround: 0xA09080, hemiI: 1.35 },\n  golden: { skyTop: 0x7FB7C9, skyMid: 0xF7D9A6, skyLow: 0xF59E6C, sea: 0x1F9EA3, seaHi: 0x71DCCB, sun: 0xFFF0D0, sunI: 3.1, hemiSky: 0xFFF4E0, hemiGround: 0x8A7FA0, hemiI: 1.25 },\n  dusk: { skyTop: 0x2B2F6B, skyMid: 0xA8558F, skyLow: 0xF58A5C, sea: 0x24406F, seaHi: 0xC26A8C, sun: 0xFFB98A, sunI: 2.4, hemiSky: 0xB48AD0, hemiGround: 0x2B2F5F, hemiI: 1.1 },\n};\nexport const PALETTE_ORDER = ['dawn', 'noon', 'golden', 'dusk'];\nEOF\ncat > src/render/palette.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { uniform } from 'three/tsl';\nimport { PALETTES, PALETTE_ORDER } from '../data/palettes.js';\n\n/** Palette uniforms and light colours, lerped over 3 s between steps. */\nexport class Palette {\n  constructor(sun, hemi) {\n    this.sun = sun; this.hemi = hemi;\n    this.name = 'dawn';\n    const p = PALETTES.dawn;\n    this.u = {};\n    for (const k of ['skyTop', 'skyMid', 'skyLow', 'sea', 'seaHi']) this.u[k] = uniform(new THREE.Color(p[k]));\n    this.cur = { ...p };\n    this.colors = {};\n    for (const k of ['skyTop', 'skyMid', 'skyLow', 'sea', 'seaHi', 'sun', 'hemiSky', 'hemiGround']) this.colors[k] = new THREE.Color(p[k]);\n    this.to = p; this.t = 1; this.dur = 3;\n    this.from = null;\n    this.apply();\n  }\n  set(name, dur = 3) {\n    const p = PALETTES[name];\n    if (!p) return;\n    this.name = name;\n    this.from = {};\n    for (const k of Object.keys(this.colors)) this.from[k] = this.colors[k].clone();\n    this.fromI = { sunI: this.cur.sunI, hemiI: this.cur.hemiI };\n    this.to = p; this.t = 0; this.dur = Math.max(dur, 0.0001);\n    if (dur <= 0) this.frame(1);\n  }\n  /** Palette for a step through the day: dawn at the start, dusk at the end. */\n  forStep(i, total) {\n    const n = PALETTE_ORDER.length;\n    return PALETTE_ORDER[Math.min(n - 1, Math.floor((i / Math.max(1, total)) * n))];\n  }\n  frame(dt) {\n    if (this.t >= 1) return;\n    this.t = Math.min(1, this.t + dt / this.dur);\n    const s = this.t;\n    const c = new THREE.Color();\n    for (const k of Object.keys(this.colors)) { c.set(this.to[k]); this.colors[k].copy(this.from[k]).lerp(c, s); }\n    this.cur.sunI = this.fromI.sunI + (this.to.sunI - this.fromI.sunI) * s;\n    this.cur.hemiI = this.fromI.hemiI + (this.to.hemiI - this.fromI.hemiI) * s;\n    this.apply();\n  }\n  apply() {\n    for (const k of ['skyTop', 'skyMid', 'skyLow', 'sea', 'seaHi']) this.u[k].value.copy(this.colors[k]);\n    if (this.sun) { this.sun.color.copy(this.colors.sun); this.sun.intensity = this.cur.sunI; }\n    if (this.hemi) { this.hemi.color.copy(this.colors.hemiSky); this.hemi.groundColor.copy(this.colors.hemiGround); this.hemi.intensity = this.cur.hemiI; }\n  }\n}\nEOF\ncat > src/render/sky.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { positionWorld, cameraPosition, normalize, smoothstep, mix, vec3 } from 'three/tsl';\nimport { toon, geo } from '../art/materials.js';\nimport { cos } from '../core/rng.js';\n\nexport function makeSky(palette) {\n  const group = new THREE.Group();\n  const mat = new THREE.MeshBasicNodeMaterial({ side: THREE.BackSide, depthWrite: false, fog: false });\n  const dir = normalize(positionWorld.sub(cameraPosition));\n  const low = mix(palette.u.skyLow, palette.u.skyMid, smoothstep(0, 0.14, dir.y));\n  mat.colorNode = vec3(mix(low, palette.u.skyTop, smoothstep(0.1, 0.5, dir.y)));\n  const dome = new THREE.Mesh(new THREE.SphereGeometry(600, 48, 24), mat);\n  dome.frustumCulled = false;\n  dome.renderOrder = -10;\n  group.add(dome);\n  // Inked toon clouds: flattened spheres that drift.\n  const clouds = [];\n  const cloudMat = toon(0xFFF8F0);\n  for (let i = 0; i < 14; i++) {\n    const c = new THREE.Group();\n    const n = 3 + Math.floor(cos(0, 4));\n    for (let j = 0; j < n; j++) {\n      const m = new THREE.Mesh(geo.sphere(1), cloudMat);\n      m.position.set((j - n / 2) * 7 + cos(-2, 2), cos(-1, 1.5), cos(-2, 2));\n      m.scale.set(cos(6, 10), cos(2.4, 4), cos(4, 6));\n      m.castShadow = false; m.receiveShadow = false;\n      c.add(m);\n    }\n    const a = cos(0, Math.PI * 2), r = cos(150, 380);\n    c.position.set(Math.cos(a) * r, cos(55, 130), Math.sin(a) * r);\n    c.userData.speed = cos(0.4, 1.2);\n    group.add(c);\n    clouds.push(c);\n  }\n  return {\n    group,\n    frame(dt) {\n      for (const c of clouds) {\n        c.position.x += c.userData.speed * dt;\n        if (c.position.x > 420) c.position.x = -420;\n      }\n    },\n  };\n}\nEOF\ncat > src/render/sea.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport {\n  positionWorld, cameraPosition, length, sin, time, step, mix, smoothstep, vec3, vec2, uniform, float, max, cos as tcos, abs,\n} from 'three/tsl';\n\n/** Hard-banded toon sea on a huge disc, melting into the horizon colour. */\nexport function makeSea(palette) {\n  const mat = new THREE.MeshBasicNodeMaterial();\n  const centre = uniform(new THREE.Vector2(0, 0));\n  const foamR = uniform(26), tiltX = uniform(0), tiltZ = uniform(0);\n  const p = positionWorld.xz;\n  const d = length(p.sub(centre));\n  const warp = sin(p.x.mul(0.07).add(time.mul(0.25))).mul(2.2).add(sin(p.y.mul(0.09).sub(time.mul(0.2))).mul(2.2));\n  const wave = sin(d.add(warp).mul(0.62).sub(time.mul(0.8))).mul(0.5).add(0.5);\n  const bands = step(0.86, wave);\n  let col = mix(palette.u.sea, palette.u.seaHi, bands);\n  // Foam rings hug the island and lean with it.\n  const q = p.sub(centre);\n  const leaned = d.add(q.x.mul(tiltX).add(q.y.mul(tiltZ)).mul(6));\n  const ring = sin(leaned.mul(1.1).sub(time.mul(1.4))).mul(0.5).add(0.5);\n  const foam = step(0.72, ring).mul(float(1).sub(smoothstep(foamR, foamR.add(9), d)));\n  col = mix(col, vec3(0.97, 0.98, 0.96), foam.mul(0.85));\n  const camD = length(p.sub(cameraPosition.xz));\n  mat.colorNode = mix(col, palette.u.skyLow, smoothstep(60, 260, camD));\n  const geo = new THREE.CircleGeometry(590, 96);\n  geo.rotateX(-Math.PI / 2);\n  const mesh = new THREE.Mesh(geo, mat);\n  mesh.frustumCulled = false;\n  mesh.receiveShadow = false;\n  return {\n    mesh,\n    setLevel(y) { mesh.position.y = y; },\n    setFoam(x, z, r) { centre.value.set(x, z); foamR.value = r; },\n    setTilt(tx, tz) { tiltX.value = tx; tiltZ.value = tz; },\n  };\n}\nEOF\ncat > src/render/cameraRig.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { cos } from '../core/rng.js';\n\nconst _f = new THREE.Vector3();\n\n/** One camera with damped targets, shake and a free-fly mode for Dev Mode. */\nexport class CameraRig {\n  constructor(camera) {\n    this.camera = camera;\n    this.pos = new THREE.Vector3(0, 8, 30); this.look = new THREE.Vector3();\n    this.tPos = this.pos.clone(); this.tLook = this.look.clone();\n    this.rate = 6; this.shakeAmt = 0; this.reduce = false;\n    this.yaw = 0; this.fov = 38; this.tFov = 38;\n    this.free = false; this.freeYaw = 0; this.freePitch = -0.2;\n  }\n  /** Frame a shot. snap skips the easing. */\n  shot(px, py, pz, lx, ly, lz, { fov = 38, rate = 3, snap = false } = {}) {\n    this.tPos.set(px, py, pz); this.tLook.set(lx, ly, lz); this.tFov = fov; this.rate = rate;\n    if (snap) { this.pos.copy(this.tPos); this.look.copy(this.tLook); this.fov = fov; }\n  }\n  /** Lens distance that fits a lane spread: d = max(base, (spread/2 + 2.5) / tan(hfov/2)). */\n  fitDistance(base, spread) {\n    const aspect = this.camera.aspect || 16 / 9;\n    const hfov = 2 * Math.atan(Math.tan((this.tFov * Math.PI) / 360) * aspect);\n    return Math.max(base, (spread / 2 + 2.5) / Math.tan(hfov / 2));\n  }\n  shake(a) { if (!this.reduce) this.shakeAmt = Math.max(this.shakeAmt, a); }\n  frame(dt) {\n    const k = 1 - Math.exp(-this.rate * dt);\n    this.pos.lerp(this.tPos, k); this.look.lerp(this.tLook, k);\n    this.fov += (this.tFov - this.fov) * k;\n    const c = this.camera;\n    if (Math.abs(c.fov - this.fov) > 0.01) { c.fov = this.fov; c.updateProjectionMatrix(); }\n    if (!this.free) {\n      c.position.copy(this.pos);\n      if (this.shakeAmt > 0.001) {\n        c.position.x += cos(-1, 1) * this.shakeAmt; c.position.y += cos(-1, 1) * this.shakeAmt;\n        this.shakeAmt *= Math.exp(-7 * dt);\n      }\n      c.lookAt(this.look);\n    } else {\n      c.rotation.order = 'YXZ'; c.rotation.set(this.freePitch, this.freeYaw, 0);\n    }\n    c.getWorldDirection(_f);\n    this.yaw = Math.atan2(-_f.x, -_f.z);\n  }\n  freeMove(dt, mx, mz, lx, ly) {\n    const c = this.camera, sp = 14 * dt;\n    this.freeYaw -= lx * 1.6 * dt; this.freePitch = Math.max(-1.5, Math.min(1.5, this.freePitch - ly * 1.2 * dt));\n    const s = Math.sin(this.freeYaw), o = Math.cos(this.freeYaw);\n    c.position.x += (mx * o + mz * s) * sp; c.position.z += (-mx * s + mz * o) * sp;\n  }\n}\n/** Stick space to world: right is screen right, up is away from the camera. */\nexport function rot2(x, z, yaw) {\n  const c = Math.cos(yaw), s = Math.sin(yaw);\n  return [x * c + z * s, -x * s + z * c];\n}\nEOF\ncat > src/art/materials.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';\nimport { INK } from '../data/config.js';\n\n// Cel shading: a three-step ramp on toon node materials.\nlet ramp = null;\nfunction gradient() {\n  if (ramp) return ramp;\n  ramp = new THREE.DataTexture(new Uint8Array([96, 178, 255]), 3, 1, THREE.RedFormat);\n  ramp.minFilter = THREE.NearestFilter; ramp.magFilter = THREE.NearestFilter;\n  ramp.colorSpace = THREE.NoColorSpace;\n  ramp.needsUpdate = true;\n  return ramp;\n}\nconst cache = new Map();\nexport function toon(color) {\n  const key = typeof color === 'string' ? new THREE.Color(color).getHex() : color;\n  let m = cache.get(key);\n  if (!m) { m = new THREE.MeshToonNodeMaterial({ color: key, gradientMap: gradient() }); cache.set(key, m); }\n  return m;\n}\nexport const freshToon = (color, opts = {}) => new THREE.MeshToonNodeMaterial({ color, gradientMap: gradient(), ...opts });\nexport const basic = (color, opts = {}) => new THREE.MeshBasicNodeMaterial({ color, ...opts });\nexport const inkMat = () => toon(INK);\n/** Glass: never toon, or the hull draws solid ink behind it. */\nexport const glass = (opacity = 0.16) => new THREE.MeshBasicNodeMaterial({ color: 0xe8fbff, transparent: true, opacity, side: THREE.DoubleSide, depthWrite: false });\n\n// Shared geometry, keyed by size.\nconst gc = new Map();\nconst memo = (k, f) => { let g = gc.get(k); if (!g) { g = f(); gc.set(k, g); } return g; };\nexport const geo = {\n  sphere: (r = 1, w = 20, h = 14) => memo(`s${r},${w}`, () => new THREE.SphereGeometry(r, w, h)),\n  box: (x, y, z) => memo(`b${x},${y},${z}`, () => new THREE.BoxGeometry(x, y, z)),\n  rbox: (x, y, z, r = 0.05) => memo(`r${x},${y},${z},${r}`, () => new RoundedBoxGeometry(x, y, z, 3, r)),\n  cyl: (rt, rb, h, s = 20) => memo(`c${rt},${rb},${h},${s}`, () => new THREE.CylinderGeometry(rt, rb, h, s)),\n  cone: (r, h, s = 16) => memo(`n${r},${h},${s}`, () => new THREE.ConeGeometry(r, h, s)),\n  cap: (r, l, s = 14) => memo(`p${r},${l},${s}`, () => new THREE.CapsuleGeometry(r, l, 6, s)),\n  tor: (r, t, a = Math.PI * 2, s = 40) => memo(`t${r},${t},${a},${s}`, () => new THREE.TorusGeometry(r, t, 10, s, a)),\n  disc: (r, s = 40) => memo(`d${r},${s}`, () => { const g = new THREE.CircleGeometry(r, s); g.rotateX(-Math.PI / 2); return g; }),\n  ring: (a, b, s = 40) => memo(`g${a},${b},${s}`, () => { const g = new THREE.RingGeometry(a, b, s); g.rotateX(-Math.PI / 2); return g; }),\n};\n\n/** A shadowed mesh at a spot. opts: rot [x,y,z], scale number or [x,y,z], shadow. */\nexport function M(g, m, x = 0, y = 0, z = 0, opts = {}) {\n  const mesh = new THREE.Mesh(g, typeof m === 'number' || typeof m === 'string' ? toon(m) : m);\n  mesh.position.set(x, y, z);\n  if (opts.rot) mesh.rotation.set(...opts.rot);\n  if (opts.scale !== undefined) { if (Array.isArray(opts.scale)) mesh.scale.set(...opts.scale); else mesh.scale.setScalar(opts.scale); }\n  mesh.castShadow = opts.shadow !== false; mesh.receiveShadow = opts.receive !== false;\n  if (opts.parent) opts.parent.add(mesh);\n  return mesh;\n}\nexport const add = (parent, ...kids) => { for (const k of kids) parent.add(k); return parent; };\nexport const G = (name, x = 0, y = 0, z = 0) => { const g = new THREE.Group(); if (name) g.name = name; g.position.set(x, y, z); return g; };\n\n/** A thick-outline copy of a group's meshes, hidden until hovered. */\nexport function makeOutline(group, thickness = 0.06) {\n  const mat = new THREE.MeshBasicNodeMaterial({ color: new THREE.Color(INK), side: THREE.BackSide });\n  mat.positionNode = outlinePosition(thickness);\n  const holder = new THREE.Group();\n  const meshes = [];\n  group.updateWorldMatrix(true, true);\n  group.traverse((o) => { if (o.isMesh && !o.material.transparent) meshes.push(o); });\n  const inv = new THREE.Matrix4().copy(group.matrixWorld).invert();\n  for (const o of meshes) {\n    const c = new THREE.Mesh(o.geometry, mat);\n    c.matrixAutoUpdate = false;\n    c.matrix.multiplyMatrices(inv, o.matrixWorld);\n    c.castShadow = false; c.receiveShadow = false;\n    holder.add(c);\n  }\n  holder.visible = false;\n  group.add(holder);\n  return holder;\n}\nimport { positionLocal, normalLocal, float } from 'three/tsl';\nfunction outlinePosition(t) { return positionLocal.add(normalLocal.mul(float(t))); }\nEOF\ncat > src/render/particles.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { toon, geo } from '../art/materials.js';\nimport { cos } from '../core/rng.js';\n\nconst _m = new THREE.Matrix4(), _q = new THREE.Quaternion(), _s = new THREE.Vector3(), _p = new THREE.Vector3(), _c = new THREE.Color(), _e = new THREE.Euler();\n\n/** CPU-driven instanced blobs: splashes, confetti, dust. No compute: it must run on WebGL2 too. */\nexport class Particles {\n  constructor(max = 900) {\n    this.max = max; this.items = []; this.free = [];\n    this.mesh = new THREE.InstancedMesh(geo.sphere(1, 10, 8), toon(0xffffff), max);\n    this.mesh.castShadow = false; this.mesh.receiveShadow = false;\n    this.mesh.frustumCulled = false;\n    this.mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n    this.cube = new THREE.InstancedMesh(geo.box(1, 1, 0.12), toon(0xffffff), 400);\n    this.cube.castShadow = false; this.cube.receiveShadow = false; this.cube.frustumCulled = false;\n    this.cube.instanceMatrix.setUsage(THREE.DynamicDrawUsage);\n    this.flakes = [];\n    for (let i = 0; i < max; i++) { this.mesh.setColorAt(i, _c.set(0xffffff)); this.free.push(i); }\n    for (let i = 0; i < 400; i++) this.cube.setColorAt(i, _c.set(0xffffff));\n    this.mesh.count = max; this.cube.count = 400;\n    _m.makeScale(0, 0, 0);\n    for (let i = 0; i < max; i++) this.mesh.setMatrixAt(i, _m);\n    for (let i = 0; i < 400; i++) this.cube.setMatrixAt(i, _m);\n    this.cubeNext = 0;\n  }\n  addTo(scene) { scene.add(this.mesh); scene.add(this.cube); }\n  spawn(x, y, z, vx, vy, vz, size, colour, life = 0.8, g = 9.8) {\n    const i = this.free.pop();\n    if (i === undefined) return;\n    this.items.push({ i, x, y, z, vx, vy, vz, size, life, t: 0, g, floor: -1e9 });\n    this.mesh.setColorAt(i, _c.set(colour));\n    if (this.mesh.instanceColor) this.mesh.instanceColor.needsUpdate = true;\n  }\n  burst(x, y, z, n, opts = {}) {\n    const { speed = 3, up = 3, size = 0.08, colour = 0xffffff, life = 0.7, spread = 1, colours = null } = opts;\n    for (let k = 0; k < n; k++) {\n      const a = cos(0, Math.PI * 2), r = cos(0.2, 1) * speed * spread;\n      this.spawn(x, y, z, Math.cos(a) * r, cos(0.4, 1.3) * up, Math.sin(a) * r, size * cos(0.6, 1.3), colours ? colours[k % colours.length] : colour, life * cos(0.7, 1.2));\n    }\n  }\n  splash(x, y, z, big = 1, colour = 0xEFFBFB) {\n    this.burst(x, y, z, Math.round(26 * big), { speed: 2.2 * big, up: 6.5 * Math.sqrt(big), size: 0.11 * Math.sqrt(big), colour, life: 1 });\n  }\n  /** Confetti flakes tumble and flutter. */\n  confetti(x, y, z, n, colours, spread = 6) {\n    for (let k = 0; k < n; k++) {\n      const i = this.cubeNext = (this.cubeNext + 1) % 400;\n      const old = this.flakes.findIndex((f) => f.i === i);\n      if (old >= 0) this.flakes.splice(old, 1);\n      this.flakes.push({ i, x: x + cos(-spread, spread), y: y + cos(0, 3), z: z + cos(-spread, spread), s: cos(0.05, 0.11), ph: cos(0, 6), sp: cos(1, 4), life: cos(2.5, 5), t: 0 });\n      this.cube.setColorAt(i, _c.set(colours[k % colours.length]));\n    }\n    if (this.cube.instanceColor) this.cube.instanceColor.needsUpdate = true;\n  }\n  frame(dt) {\n    const items = this.items;\n    for (let n = items.length - 1; n >= 0; n--) {\n      const p = items[n];\n      p.t += dt;\n      if (p.t >= p.life) {\n        _m.makeScale(0, 0, 0); this.mesh.setMatrixAt(p.i, _m);\n        this.free.push(p.i); items[n] = items[items.length - 1]; items.pop();\n        continue;\n      }\n      p.vy -= p.g * dt;\n      p.x += p.vx * dt; p.y += p.vy * dt; p.z += p.vz * dt;\n      const s = p.size * (1 - (p.t / p.life) ** 3);\n      _m.makeScale(s, s, s); _m.setPosition(p.x, p.y, p.z);\n      this.mesh.setMatrixAt(p.i, _m);\n    }\n    if (items.length || this._dirty) { this.mesh.instanceMatrix.needsUpdate = true; this._dirty = items.length > 0; }\n    const fl = this.flakes;\n    for (let n = fl.length - 1; n >= 0; n--) {\n      const f = fl[n];\n      f.t += dt;\n      if (f.t >= f.life) {\n        _m.makeScale(0, 0, 0); this.cube.setMatrixAt(f.i, _m);\n        fl[n] = fl[fl.length - 1]; fl.pop();\n        continue;\n      }\n      f.y -= 1.2 * dt; f.x += Math.sin(f.t * f.sp + f.ph) * 0.8 * dt;\n      _e.set(f.t * f.sp, f.ph + f.t * 2, f.t * 1.3); _q.setFromEuler(_e);\n      _s.setScalar(f.s); _p.set(f.x, f.y, f.z);\n      _m.compose(_p, _q, _s); this.cube.setMatrixAt(f.i, _m);\n    }\n    if (fl.length || this._dirtyC) { this.cube.instanceMatrix.needsUpdate = true; this._dirtyC = fl.length > 0; }\n  }\n  clear() {\n    for (const p of this.items) { _m.makeScale(0, 0, 0); this.mesh.setMatrixAt(p.i, _m); this.free.push(p.i); }\n    this.items.length = 0;\n    for (const f of this.flakes) { _m.makeScale(0, 0, 0); this.cube.setMatrixAt(f.i, _m); }\n    this.flakes.length = 0;\n    this.mesh.instanceMatrix.needsUpdate = true; this.cube.instanceMatrix.needsUpdate = true;\n  }\n}\nEOF\ncat > src/render/comicText.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport { INK } from '../data/config.js';\n\n// Inked world-space words: canvas-texture sprites that pop and fade.\nconst cache = new Map();\nfunction wordTexture(word, colour) {\n  const key = word + colour;\n  if (cache.has(key)) return cache.get(key);\n  const c = document.createElement('canvas');\n  c.width = 512; c.height = 192;\n  const g = c.getContext('2d');\n  if (g) {\n    g.font = '700 120px Fredoka, Arial Rounded MT Bold, sans-serif';\n    g.textAlign = 'center'; g.textBaseline = 'middle';\n    g.lineJoin = 'round';\n    g.lineWidth = 26; g.strokeStyle = INK; g.strokeText(word, 256, 100);\n    g.fillStyle = colour; g.fillText(word, 256, 100);\n  }\n  const t = new THREE.CanvasTexture(c);\n  t.colorSpace = THREE.SRGBColorSpace;\n  cache.set(key, t);\n  return t;\n}\n\nexport class ComicText {\n  constructor(scene) { this.scene = scene; this.items = []; }\n  pop(word, x, y, z, { colour = '#FFF4DC', size = 2.4, life = 1.1 } = {}) {\n    const mat = new THREE.SpriteNodeMaterial({ map: wordTexture(word, colour), transparent: true, depthTest: false, depthWrite: false });\n    const s = new THREE.Sprite(mat);\n    s.position.set(x, y, z);\n    s.renderOrder = 50;\n    s.userData = { t: 0, life, size, vy: 0.7, tilt: (word.length % 2 ? 1 : -1) * 0.12 };\n    mat.rotation = s.userData.tilt;\n    this.scene.add(s);\n    this.items.push(s);\n    return s;\n  }\n  frame(dt) {\n    for (let i = this.items.length - 1; i >= 0; i--) {\n      const s = this.items[i], u = s.userData;\n      u.t += dt;\n      const k = u.t / u.life;\n      const pop = Math.min(1, u.t / 0.1);\n      const sc = u.size * (pop < 1 ? pop * 1.25 : 1 + 0.25 * Math.max(0, 1 - (u.t - 0.1) / 0.12));\n      s.scale.set(sc, sc * 0.375, 1);\n      s.position.y += u.vy * dt;\n      s.material.opacity = k > 0.7 ? 1 - (k - 0.7) / 0.3 : 1;\n      if (k >= 1) { this.scene.remove(s); s.material.dispose(); this.items.splice(i, 1); }\n    }\n  }\n  clear() { for (const s of this.items) { this.scene.remove(s); s.material.dispose(); } this.items = []; }\n}\nEOF\n","description":"Write rendering modules and materials"}}}
