"\"\",\"\"\"      const py = n.prev.y + (n.next.y - n.prev.y) * k, pz = n.prev.z + (n.next.z - n.prev.z) * k;\n      // Their copy plays in its own lane: here they appear beside you, in the next one.\n      lane.doll.root.position.set(lane.x, py, pz);\"\"\")\n# ---- Hide cursor while the mouse is playing; per-disc device glyphs in Group Class\nsub('src/game/director.js',\"\"\"    this.palette.frame(dt);\"\"\",\"\"\"    const hideCursor = !!(this.mode && this.mode.ev && this.mode.stage === 'play' && !this.paused && this.input.lastDevice === 'kbm');\n    if (hideCursor !== this.cursorHidden) { this.cursorHidden = hideCursor; document.body.classList.toggle('hide-cursor', hideCursor); }\n    this.palette.frame(dt);\"\"\")\nsub('src/ui/hud.js',\"\"\"      disc.addBreathWord();\n      this.discs.push({ lane, disc });\"\"\",\"\"\"      if (!group) disc.addBreathWord();\n      else {\n        // Each player's disc shows that player's own device.\n        const dev = lane.source === 'kbm' || lane.source === 'any' ? 'kbm' : 'pad';\n        disc.root.append(h('div.disc-dev', { html: glyphHTML('lean', dev, this.game.save.settings.glyphs) }));\n      }\n      this.discs.push({ lane, disc });\"\"\")\nsub('src/ui/hud.js',\"import { promptHTML } from '../input/glyphs.js';\",\"import { promptHTML, glyphHTML } from '../input/glyphs.js';\")\nsub('src/ui/ui.css',\".meter { position: relative;\",\".disc-dev { position: absolute; right: -2.6rem; bottom: -0.6rem; display: flex; gap: 0.2rem; }\\n.disc-dev .glyph { height: 3.6rem; }\\n.meter { position: relative;\")\n# ---- Breath sounds, near-tip word, squash\nsub('src/events/base.js',\"\"\"      lane.breath.step(dt, !!i.breathe, this.game.save.settings.autoBreathe || lane.breathAuto);\"\"\",\"\"\"      const wasGrowing = lane.breath.growing;\n      lane.breath.step(dt, !!i.breathe, this.game.save.settings.autoBreathe || lane.breathAuto);\n      if (lane.kind === 'local' && wasGrowing !== lane.breath.growing) this.game.audio.sfx(lane.breat