ount', about.includes('about 2,035 checks') && about.includes('49 logged')], ['chat reply', true, 'in my previous message, copied from the file']]);\nawait b.close();\nconst w = await webkit.launch(); const wp = await w.newPage({ viewport: { width: 960, height: 540 } }); await wp.addInitScript(PAD_STUB);\nawait wp.goto(`${FILE_URL}?test=1&manual=1`); await wp.waitForFunction(() => window.__TEST__ && !document.getElementById('boot'), null, { timeout: 180000 });\nconst wb = await wp.evaluate(async () => { const T = window.__TEST__; T.startEvent('fruitHat', 0, {}); T.advance(0.5); await T.game.render(); return { backend: T.game.backend, frames: T.game.frames }; });\nawait w.close();\nconsole.log(`\\nWebGL2 fallback (WebKit): ${wb.backend}, ${wb.frames} frame drawn. Page errors in the WebGPU run: ${errs.length}. Game errors: ${live.errors.length}.`);\nconsole.log(`Lines passing: ${results.filter(Boolean).length} of ${results.length}`);\nEOF\nfor i in $(seq 1 40); do a=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo); [ \"$a\" -ge 3 ] && break; sleep 10; done; timeout 520 node notes/final/check19.mjs 2>&1 | cut -c1-132; rm -rf notes/final; ls notes | tr '\\n' ' '; sha256sum ../WeFib-WiiFit-claude-opus-5-5-xhigh-20261105-044442.html | cut -c1-16","description":"Check every PLAN section 19 line directly against the final build","timeout":560000}}}
