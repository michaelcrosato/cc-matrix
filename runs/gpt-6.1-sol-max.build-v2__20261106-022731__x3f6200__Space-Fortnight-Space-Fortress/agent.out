(ox + cx * T * k), Math.floor(oy + cy * T * k), Math.ceil(T * k), Math.ceil(T * k)); }\n    if (s.camera) {   // the screen's corners on the ground: what the camera shows\n      const G = this._game, v = G.view, c = G.cam, S = G.screen, q = [[0, 0], [S.W, 0], [S.W, S.H], [0, S.H]].map(([a, b]) => v.toGround(c.x + a, c.y + b));\n      if (q.every(Boolean)) { g.strokeStyle = '#f8efd0'; g.lineWidth = 1; g.beginPath(); q.forEach(([a, b], i) => i ? g.lineTo(...P(a, b)) : g.moveTo(...P(a, b))); g.closePath(); g.stroke(); }\n    }\n    if (s.at) {\n      const [x, y] = P(s.at.x, s.at.y), a = s.at.facing || 0, r = large ? 9 : 5; g.fillStyle = '#f8efd0'; g.strokeStyle = '#10181a'; g.lineWidth = 1.5; g.beginPath();\n      g.moveTo(x + Math.cos(a) * r, y + Math.sin(a) * r); g.lineTo(x + Math.cos(a + 2.45) * r * .8, y + Math.sin(a + 2.45) * r * .8); g.lineTo(x + Math.cos(a - 2.45) * r * .8, y + Math.sin(a - 2.45) * r * .8); g.closePath(); g.fill(); g.stroke();\n    }\n    g.fillStyle = '#b6c5b5'; g.textAlign = 'right'; g.fillText('N', W - (large ? 12 : 5), large ? 18 : 10);\n  }\n  /** each step (the game calls it after reading input): follow game.paused, time out the toast and the card, and while a\n   *  screen is open, move the focus with the game's input and hold the rest of it back from the game */\n  _step() {\n    const g = this._game, I = g.input, now = g.real, sc = g.scene, play = !!sc && (!!sc.pausable || g.sceneName === 'main');\n    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n    if (pause && g.paused && !this._stack.length) this.show('pause');\n    if (!g.paused && this._stack.length && (this._ownPause || (pause && this._stack.some(t => t.name === 'pause')))) { this._stack.length = 0; this._ownPause = false; this._capEnd(); this._render(); }   // resumed from code\n    if (this.root) {\n      if (this._toastEnd && now > this._toastEnd) { this._els.toast.classList.remove('on'); this._toastEnd = 0; }\n      if (this._tutEnd && now > this._tutEnd) this.tutorial(null);\n      this.root.classList.toggle('esh-still', !!g.reduceMotion);\n    }\n    if (!this._stack.length) return;\n    const keep = this._held; this._held = new Set();\n    const has = a => !!I.map[a], confirm = has('confirm') && I.pressed('confirm'), cancel = has('cancel') && I.pressed('cancel'), closeAll = has('pause') && I.pressed('pause'), mv = I.move();\n    const hit = ['up', 'down', 'left', 'right'].find(a => has(a) && I.pressed(a)), dir = Math.abs(mv[1]) > .5 ? (mv[1] < 0 ? 'up' : 'down') : Math.abs(mv[0]) > .5 ? (mv[0] < 0 ? 'left' : 'right') : null;\n    for (const a in I.map) if (!keep.has(a)) I.suppress(a);   // the game doesn't see what the menu used\n    if (this._cap) { this._capPad(); return; }   // binding: the next button is the answer, not a move in the menu\n    if (!this.root) { if (cancel) this.back(); else if (closeAll) this.hide(); return; }\n    if (hit) { this._dir = hit; this._dirT = now + .35; this._nav(hit); }   // a press (however short), then the held direction repeats\n    else if (dir !== this._dir) { this._dir = dir; this._dirT = now + .35; if (dir) this._nav(dir); }\n    else if (dir && now > this._dirT) { this._dirT = now + .09; this._nav(dir); }\n    const f = document.activeElement, mine = f && this._els.scr.contains(f);\n    if (confirm && mine && f.tagName === 'BUTTON') f.click();\n    else if (cancel) this.back();\n    else if (closeAll) this.hide();   // Start (or P) closes the whole menu; Escape and B go back one screen\n  }\n  /** binding a controller button: the first one pressed since binding began (Start cancels) */\n  _capPad() {\n    const c = this._cap, I = this._ctlI(); if (!c || c.device !== 'pad') return;\n    const i = I.padPrev.findIndex((on, k) => on && !c.prev[k]); c.prev = I.padPrev.slice();\n    const ra = RSTICK.find(k => I.held.has(k) && !c.prevR.includes(k)); c.prevR = RSTICK.filter(k => I.held.has(k));   // (the right stick pushed: its direction)\n    if (i === 9) this._capEnd('Not changed.'); else if (i >= 0) this._capBind('Pad' + i); else if (ra) this._capBind(ra);\n  }\n  /** move the focus (or turn a focused slider or choice), keeping it in view */\n  _nav(dir) {\n    const all = this._focusables(); if (!all.length) return;\n    const f = document.activeElement, i = all.indexOf(f), side = dir === 'left' || dir === 'right', d = dir === 'up' || dir === 'left' ? -1 : 1;\n    if (f && side && f.type === 'range') { if (d < 0) f.stepDown(); else f.stepUp(); f.dispatchEvent(new Event('input')); return; }\n    if (f && side && f._cycle) { f._cycle(d); return; }\n    const n = all[((i < 0 ? 0 : i + d) + all.length) % all.length]; n.focus({ preventScroll: true }); if (n.scrollIntoView) n.scrollIntoView({ block: 'nearest' });\n  }\n}\nE.Shell = Shell;\n\n/* =============================================================================\n * 22. GPU LIGHTING (WebGPU)  optional. game.enableGPU({ map }) turns it on.\n *    The Canvas renderer still draws every color. Alongside it, it writes an\n *    \"info\" image (height, surface type, glow per pixel). The GPU then lights each\n *    pixel: colored point lights, soft shadows marched through a heightmap of the\n *    level, light wrapping around characters (normals from their silhouettes),\n *    glow spilling onto nearby surfaces, dithered light bands, and heat shimmer.\n *    If WebGPU is missing or fails, the game keeps the Canvas lighting.\n\n- `new E.Input(screen, map, signal) → input`: signal: an AbortSignal that removes every listener this adds (game.dispose()). A screen without a canvas (headless) gets no DOM listeners: input comes from press(code), release(code), tap(action) and hold(action, on)\n- `E.Input.DEFAULT { attack, dash, skill, jump }`: top-down / isometric action (Zelda, Diablo): Space dashes, J or click attacks\n- `E.Input.PLATFORMER { jump, attack, dash, skill }`: side-scrollers (Mario, Mega Man): Space / Z / K jump, X / J attack or shoot, Shift / C dash\n- `E.Input.SHMUP { fire, bomb }`: shoot-'em-ups (1942, Gradius): Space / Z / J fire (hold for autofire), X / K bomb\n- `E.Input.THIRDPERSON { sprint, jump, crouch, interact, attack, block, dodge, use, map }` †: third-person action and stealth (Assassin's Creed, Metal Gear): WASD / stick move, Shift sprint, Space jump and parkour, C crouch (a toggle), E interact, J attack, K block, L dodge, Q use, M map. Pad: A jump, B crouch, X attack, Y interact, LB block, RB dodge, LT use, RT or L3 sprint, Back map\n- `E.Input.halfKeys(preset, side)` †: a preset for half a keyboard ('left' or 'right'): its moves and menu keys, the preset's other actions on its buttons in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /). A preset's own halves come first: preset.halves = { left: { pass: ['KeyR'] }, right: { pass: ['KeyL'] } } (an action a menu reads beside confirm would take confirm's F otherwise)\n- `input.anyPressed()`: any action pressed this step (title screens: \"press any button\")\n- `input.bindButtons(root)` †: wire every element with data-act=\"<action>\" inside root to the action\n- `input.bindings` †: the player's bindings over the preset: { action: { keys: [codes], pad: [codes] } } (game.settings.bindings keeps them)\n- `input.box()` †: the pointer's gestures, read each step in screen pixels (the HUD's space), from a mouse or one finger: box() -> { x0, y0, x1, y1, from, to, done } while a box is drawn (a mouse's left button dragged; on a touch screen a long press, then a drag), done the step it is let go; else null\n- `input.buffered(a, win = .15)`: was it pressed within the last `win` seconds and not yet consumed? (input buffering)\n- `input.clear()`: Release all devices and discard buffered input on focus loss or a modal transition.\n- `input.clicked()` †: where a click or tap on the canvas landed, in screen pixels [x, y] (the HUD's space: r.W, r.H), during the step after it lifted (a press that drags away, like the touch stick's, is none); else null. Menus and dialogs answer to it; a HUD button of your own can: if (hit(input.clicked())) ...\n- `input.codeLabel(code)`: a code as a person reads it: 'W' (or the keyboard's own letter there), 'Space', '↑', 'Left click', and a gamepad button by its symbol on the controller in use ('A', '✕', 'B'...; glyphs picks the family)\n- `input.consume(a)`: mark a buffered press of action a as used, so buffered(a) is false until the next press\n- `input.consumeAll()`: forget every pending press (after closing a menu or dialog, so the same press does not also attack)\n- `input.doubleTap()` †: [x, y] the step a second tap or click lands within .35 s and 8 pixels of the first (a double tap), else null\n- `input.down(a)`: is the action held right now?\n- `input.drag()` †: how far the touch stick's finger moved since the last step, in screen pixels [dx, dy] (the HUD's space), or null while no finger holds it: to steer one to one (a shooter's ship follows the thumb) instead of by the stick's direction\n- `input.feed(type, x, y, o = {})` †: a pointer event in screen pixels, as the browser's would give: feed('down' | 'move' | 'up', x, y, { touch: false, button: 0, id: 0 (which finger, for zones) }) (a test's or a bot's mouse and fingers: clicks, boxes, long presses, double taps and pans follow; a finger in one of the zones holds its act), or feed('zoom', x, y, { k: 1.1 }): a wheel's notch or a pinch about that point\n- `input.history` †: the last second of input, oldest first: [{ t (input.clock), dir (numpad 1-9 for a fighter facing right: 5 neutral), pressed: the actions pressed then, directions aside }], one entry each time the direction changes or a button is pressed: an input display draws it; sequence() and motion() read it (section 10h: a kit without it has none)\n- `input.hold(a, on = true)`: hold an action down (on) or let it go (false), as its key would\n- `input.label(a, device = this.lastDevice)`: the key or button to show in a prompt for action a, on the device the player used last (or the one named: 'keyboard' | 'mouse' | 'gamepad' | 'touch'), with their bindings: input.label('jump') -> 'Space', 'A' or '✕'\n- `input.longPress()` †: [x, y] the step a press held still has been held .45 s (a long press), else null\n- `input.motion(digits, button, o = {})` †: a fighter's move in numpad notation, mirrored by facing: input.motion('236', 'attack', { facing: hero.facing, window }) is a quarter circle forward and punch (down, down-forward, forward, attack: a fireball); '623' a dragon punch, '41236' a half circle. facing: 1 (right, the default) or -1. button: an action, 'attack+kick', or none (the motion alone)\n- `input.mouseScreen()`: mouse position in projected screen pixels, or null\n- `input.move()`: movement intent in screen directions: x right, y down, length <= 1\n- `input.padStyle()`: the controller family whose symbols label() shows: glyphs, or with glyphs 'auto' the one its name says\n- `input.pan()` †: [dx, dy] how far a drag moved this step: one finger on open ground (not a box), or a mouse's middle or right button; else null. A free camera pans by it (game.cam.free)\n- `input.pointer()` †: the mouse pointer in screen pixels [x, y] (the HUD's space), or null before it has moved over the canvas\n- `input.press(code)`: press a key or button code ('KeyJ', 'Mouse0', 'Pad0', 'Act:attack') as if the person did: scripted input, tests, bots\n- `input.pressed(a)`: true only during the first update step after the press (menus, jumps, one-shot actions)\n- `input.rebind(a, device, code)` †: bind action a to one code for a device ('keys' = keyboard and mouse, 'pad' = gamepad), in place of that device's codes: input.rebind('attack', 'keys', 'KeyF'). Returns null when done, the action that already uses the code (nothing changes: free it first), or 'reserved' for the codes the menus keep (Escape, Enter, F keys, Start, the d-pad). The arrow keys and the d-pad always move as well\n- `input.rebindable(a, map = this.preset)` †: can the player rebind action a? Every action but the menu's (start, pause, confirm, cancel: they are how a player gets back to the menu), and those the game hides with new E.Game({ menu: { controls: { a: false } } })\n- `input.release(code)`: let go of a code pressed with press()\n- `input.released(a)`: true only during the first update step after the action was let go\n- `input.repeat(a, delay = .3, rate = .08)`: pressed, then repeats while held (after `delay` s, every `rate` s): menu cursors, puzzle pieces\n- `input.resetBindings()` †: forget the player's bindings: every action back to its preset's codes\n- `input.rumble(strength = .5, seconds = .15)` †: shake the gamepad: strength 0..1 for seconds (scaled by rumbleScale; nothing where the controller can't). Returns true when it rumbled\n- `input.screenPoint(cx, cy)` †: browser client coords -> screen pixels [x, y] (the HUD's space, with no camera), or null without a canvas\n- `input.sequence(steps, o = {})` †: true on the step a sequence of inputs ends, each one after the last within window seconds (.5) of the first: input.sequence(['down', 'down+right', 'right', 'attack']). A step names actions joined by +: its directions are held exactly as it says (up, down, left, right; 'neutral' for none) as they change to that, its buttons pressed. A cheat code: input.sequence(['up', 'up', 'down', 'down', 'left', 'right', 'left', 'right', 'kick', 'attack'], { window: 3 })\n- `input.stopRumble()` †: stop a rumble now (pause, focus lost, unplugged)\n- `input.suppress(a)` †: Suppress a held action until the next tick (a HUD widget owns the pointer this step).\n- `input.suppressCode(code)` †: A widget owns this button; other devices bound to the same action still work.\n- `input.tap(a)`: press an action for one update step, as a quick tap of its key (scripted input, tests, an AI): pressed() and down() are true in the next step, released() in the one after\n- `input.tick(dt)`: advance input by one step: read the gamepad and turn presses since the last step into this step's pressed() and released() (the engine calls it every step)\n- `input.touchArea()` †: where the touch buttons cover the screen, in screen pixels { x0, y0, x1, y1 } (the same space as r.W and r.H), or null while none show: keep a prompt or a box clear of it (a bottom E.Dialog does by itself)\n- `input.touchButtons(actions, o = {})` †: On-screen buttons for phones and tablets (shown on touch screens; the player's settings can show them always or hide them, put them on the left, and size them): input.touchButtons(['jump', 'attack'], { labels: { jump: 'A', attack: 'B' }, force }). The other half of the screen is a move stick (past halfway it presses up, down, left and right too, as a d-pad does: menus and ladders). START is the corner's menu button, top right: it opens the menu, or pauses a pausable scene into it (without the corner a START button there starts a title and pauses, as a gamepad's Start)\n- `input.touchSet(a, label = null, show = true)` †: one touch button as the moment changes: its label (TALK beside someone, NEXT in a dialog; null: its own) and whether it shows (false: nothing for it to do here). Cheap to call every step: input.touchSet('confirm', near ? 'TALK' : null, near || talking)\n- `input.unbind(a, device)` †: take away action a's codes for one device ('keys' or 'pad'); the arrow keys and d-pad stay on the moves\n- `input.use(map)`: switch key layout at runtime: input.use(E.Input.PLATFORMER) or input.use('SHMUP'). The player's own bindings (bindings, set by rebind() and the Controls screen) are laid over it. Every preset (E.Input.DEFAULT, PLATFORMER, THIRDPERSON, SHMUP) has the moves (up, down, left, right) and the menu's actions (start, pause, confirm, cancel). The keys held stay held (down() in the new layout, not pressed() again), and a press no step has seen counts in it\n- `input.value(a)` †: how far action a is pressed, 0 to 1: a gamepad button by its travel (the triggers, even short of a press), a stick's direction (PadAxisUp ..., or up / down / left / right on the touch stick) by its push, any other code held 1\n- `input.zoom()` †: the camera zoom the player asked for since the last step, as a factor (1.1: 10% closer, .9: farther; 1: none): the wheel, - and = and a pinch, where the scene lets them zoom. The game applies it (game.zoomBy)\n- `input.zoomPoint()` †: [x, y] where the last zoom was asked for: the mouse pointer for the wheel, between the fingers for a pinch; null when the keys zoomed (about the screen's middle)\n- `input.aimSource = 'move'` †: what aims right now: 'move' | 'mouse' | 'pad'\n- `input.clock = 0`: seconds of input time (the steps' dt added up)\n- `input.deadzone = .18`: how far a gamepad stick moves before it counts (0..0.8)\n- `input.glyphs = 'auto'`: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' | 'nintendo' | 'generic' (positions)\n- `input.held`: the key and button codes down right now ('KeyD', 'Mouse0', 'Pad0', 'Act:jump')\n- `input.invertMoveX`, `input.invertMoveY = false` †: the move stick turned round (the Controller settings)\n- `input.keysTo = null` †: the other players' inputs the keyboard's codes go to as well (players sharing it, each with half its keys: game.players)\n- `input.lastDevice = 'keyboard'`: 'keyboard' | 'mouse' | 'gamepad' | 'touch', the last one used (show the right button prompts)\n- `input.map`: each action's codes ({ jump: ['Space', 'Pad0', 'Act:jump'] }); every action also answers to 'Act:<name>' (DOM buttons with data-act, tap, hold)\n- `input.mouse`: { cx, cy } its page position, active once it has moved over the canvas, t the input clock when it last moved\n- `input.names = null` †: the actions' names on the Controls screen ({ attack: 'Sword' }; false hides one from rebinding: the game's menu.controls); onBindings(b): called with the player's new bindings (the game saves and applies them)\n- `input.pad = 'any'` †: the gamepad this input reads: 'any' (the first connected one another player hasn't: player 1's), an index (a joined player's own), or null (none)\n- `input.padAim = null` †: its right stick, or null when centered\n- `input.padAxes = []` †: the gamepad's raw axes\n- `input.padId = ''`, `input.padIndex = null`: the gamepad in use (null and '' without one)\n- `input.padLost = false`: true for the step after the gamepad in use was unplugged (a pausable scene pauses)\n- `input.padMove = [0, 0]`: the gamepad's left stick after the dead zone\n- `input.padPrev = []`: which gamepad buttons were down at the last step\n- `input.padValues = []` †: each gamepad button's travel, 0 to 1 (the triggers; input.value reads them)\n- `input.preset` †: the layout last given to use() (E.Input.DEFAULT, PLATFORMER, SHMUP or your own)\n- `input.rumbleScale = .6` †: vibration strength 0..1 (0 = off; game.settings.rumble sets it)\n     *  or refreshes missed: its GPU behind): every other refresh is drawn, evenly, instead of random ones missed (the\n     *  updates still run every refresh). The player's Frame rate setting (game.settings.frameRate: 'auto', '60', 'full')\n     *  can fix it at 2 or 1; gpu: the WebGPU lighting after enableGPU(), or null */\n    this.fps = 60; this.hz = 60; this.drawEvery = 1; this._viewListeners = []; this.gpu = null;\n    /** paused: true while paused (a pausable scene toggles it on 'pause'; steps still run, scenes don't update);\n     *  pauseOverlay: false hides the engine's PAUSED overlay (a game drawing its own pause screen); errors: the\n     *  errors caught in update and draw, each { where, scene, message, stack }, once per kind; live: true (o.live): a pause\n     *  opens the menus over a world that keeps stepping (an online or shared world can't stop for one player): paused\n     *  is true and the scene's update goes on, the menu holding the player's own input back */\n    this.paused = false; this.pauseOverlay = true; this._timers = []; this.errors = []; this._errKeys = new Set(); this.live = !!o.live; this._goOn = false;\n    /** the E.Shell over this game (an HTML interface: screens and HUD), or null */\n    this.shell = null;\n    /** seconds for the dithered fade between scenes (0 = instant cuts) */\n    this.fadeTime = .22; this._fade = null;\n    /** scenes: the scenes given to start(), by name; scene: the scene running; sceneName: its name ('main' for a\n     *  game started with one scene) */\n    this.scenes = null; this.scene = null; this.sceneName = null; this._next = null; this._hooks = null;\n    /** chip-sound synthesizer: game.audio.sfx('jump'), game.audio.music(song) */\n    this.audio = new ChipAudio(this, signal);\n    if (this.headless) this.audio.failed = 'a headless game has no sound';\n    /** a game's own handle for tools and tests: game.debug = { snapshot() { return {...} }, teleport(x, y, z) {...} }.\n     *  tools/check.mjs prints snapshot() and tools/replay.mjs logs it at the end */\n    this.debug = null;\n    /** per-frame timings (ms) and counts, for profiling overlays. frameMs: the real time since the last frame;\n     *  updateMs, renderMs: milliseconds the last frame spent updating and drawing; steps: the updates it ran; items:\n     *  what it queued for drawing; actors: actors drawn; culled: actors skipped off screen */\n    this.stats = { updateMs: 0, renderMs: 0, frameMs: 16.7, steps: 0, items: 0, actors: 0, culled: 0 };\n    /** the fraction of a fixed step (0..1) of real time not yet run: interpolate drawing with it if motion must be smooth\n     *  at any refresh rate. The accumulator starts half a step in, so frame times that wobble keep a steady step count */\n    this.alpha = .5; this._acc = this.o.step / 2;\n    if ((this.input._never = this.o.touch === 'never')) this.input.touchEnabled = false;   // (a game that never shows touch controls)\n    /** the player's choices (game.settings.volume, game.settings.set('volume', .5), your own from menu.settings), saved\n     *  and applied (section 10b) */\n    this.settings = new Settings(this, (this.o.menu && this.o.menu.settings) || []);\n    /** full screen: game.fullscreen.toggle(), .on, .supported */\n    this.fullscreen = new FullScreen(this);\n    /** why the game paused: 'player' | 'focus' (the page was hidden) | 'controller' (unplugged) | 'menu', or null */\n    this.pauseReason = null;\n    /** a promise of the game once its boot (start's boot option, section 10c) has run and it has started: await it in a\n     *  test whose boot steps return promises */\n    this.booted = Promise.resolve(this);\n    /** the error a boot step failed with (the game did not start), or null */\n    this.bootError = null;\n    if (!this.headless) this._standard(signal);\n    E.current = this;   // handy for tools and tests: My3D2dge.current is the latest game\n  }\n  static _makeCanvas() {\n    const c = document.createElement('canvas'); c.id = 'screen';\n    c.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;display:block;image-rendering:pixelated;background:#000;touch-action:none';   // fixed + inset 0 follows a phone's browser bars (100vh does not)\n    document.body.style.margin = '0'; document.body.appendChild(c); return c;\n  }\n  /** internal buffer size in pixels (HUD layout) */\n  get W() { return this.screen.W; }\n  /** the screen's height in game pixels (W is its width) */\n  get H() { return this.screen.H; }\n  /** turn on WebGPU lighting: where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with its own\n   *  ambient (game.lights.ambient) and the same lights. opts: { map, bands, ambient, fallback, ... } */\n  enableGPU(o = {}) { if (this.headless) return null; this.gpu = new GPULighting(this, o); return this.gpu; }\n  _view(v) {\n    if (v instanceof View) return v;\n    const w = E.VIEWS[v];\n    if (!w) warn('view:' + v, 'unknown view \"' + v + '\". Use one of: ' + Object.keys(E.VIEWS).join(', ') + ', or a new E.View(...)');\n    return w || null;\n  }\n  /** switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn */\n  setView(v) {\n    const w = this._view(v); if (!w) return;\n    this.baseView = w; this._applyView();\n  }\n  /**\n   * camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom\n   * (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are\n   * drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\n   */\n  setZoom(z) { this._zoomBase = clamp(+z || 1, .5, 3); this._zoomApply(true); }\n  /** turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn */\n  rotateView(deg) { this.yaw = (((this.yaw || 0) + deg) % 360 + 360) % 360; this._applyView(); }\n  /** undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1\n   *  without), no turn. The player's zoom stays (settings.zoom) */\n  resetCamera() { this.yaw = 0; this._zoomBase = this._zoomStart(); this._zoomApply(true); }\n  /**\n   * the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom\n   * button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of\n   * the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does\n   * nothing where the scene doesn't let the player zoom. Returns the zoom\n   */\n  zoomBy(k) {\n    const R = this.zoomRange(), b = this._zoomBase; if (!R || !(k > 0) || !this._zoomStd()) return this.zoom;\n    const lo = Math.max(ZOOM_PLAYER[0], R[0] / b), hi = Math.min(ZOOM_PLAYER[1], R[1] / b); if (lo > hi) return this.zoom;\n    const f = clamp(clamp(+this.settings.zoom || 1, lo, hi) * k, lo, hi); this.settings.set('zoom', f);   // (one carried from a scene with more room starts at this one's end: every step moves it)\n    const z = this._zoomTo || this.zoom; this.note('ZOOM ' + z + 'x' + (f <= lo + 1e-9 && k < 1 ? ' MIN' : f >= hi - 1e-9 && k > 1 ? ' MAX' : ''), 1);\n    return z;\n  }\n  /** the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of\n   *  the game gives one per screen shape or level), or null where they can't (camera.zoom false or none) */\n  zoomRange() {\n","exit_code":0,"status":"completed"}}
