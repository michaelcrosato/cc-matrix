[lane.index];if(c.hp>0){const a=aimAt(c,{x:lane.x,y:490});for(let k=-1;k<=1;k++)this.shot(c.x,c.y,a+k*.055,102,true,0,{r:5,lane:true});}}\n          boss.lanes=[];\n        }\n''' + s[b:]\ns=s.replace(\\\"boss.phaseAge=0;boss.shot=2;s.bossPhases\\\", \\\"boss.phaseAge=0;boss.shot=2;boss.wind=0;boss.lanes=[];s.bossPhases\\\").replace('if(boss.parts[4].hp<=0&&boss.phaseAge>=18)boss.dead=true;','if(boss.parts[4].hp<=0)boss.dead=true;')\np.write_text(s)\np=Path('src/render/scene.js');s=p.read_text().replace(\\\"        if(boss.phase===1&&cycle>1.5\\\", \\\"        if(boss.phase===0&&boss.wind>0)for(const lane of boss.lanes||[]){const c=boss.parts[lane.index];line(g,c.x,c.y,lane.x,483,'#d8a98f',2);ring(g,lane.x,457,28,'#edc49b');txt(g,'IMPACT LANE',lane.x,423,C.cream,1,'center');}\\\\n        if(boss.phase===1&&cycle>1.5\\\")\np.write_text(s)\nPY\nnode --input-type=module - <<'JS'\nimport {loadSim} from './tools/sim-loader.mjs';const S=loadSim();\nfor(const n of [1,2,4]){const w=new S.World({players:Array.from({length:n},(_,id)=>({id,name:'BOT '+id})),seed:198113});for(let i=0;i<110000&&\"'!w.s.result;i++){for(const p of w.s.players){w.setIntent(p.id,S.botIntent(w,p.id,i));if(w.s.phase==='\"'upgrade')w.upgrade(p.id,p.id%3);}w.step();}console.log(JSON.stringify({n,result:w.s.result,hp:w.s.players.map(p=>p.hp),seen:w.s.seen,phases:w.s.bossPhases}));}\nJS\"","aggregated_output":"{\"n\":1,\"result\":{\"won\":true,\"reason\":\"SIEGE BROKEN\",\"score\":106900,\"rank\":\"STAR MARSHAL\",\"time\":610,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"SIEGE SHIP DESTROYED\",\"score\":6000}],\"modified\":false},\"hp\":[7],\"seen\":[\"hunter\",\"bomber\",\"scout\",\"anchor\",\"relay\",\"rammer\",\"tractor\",\"dive\"],\"phases\":[0,1,2]}\n{\"n\":2,\"result\":{\"won\":true,\"reason\":\"SIEGE BROKEN\",\"score\":102935,\"rank\":\"STAR MARSHAL\",\"time\":610,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"SIEGE SHIP DESTROYED\",\"score\":6000}],\"modified\":false},\"hp\":[4,6],\"seen\":[\"hunter\",\"bomber\",\"scout\",\"anchor\",\"relay\",\"rammer\",\"tractor\",\"dive\"],\"phases\":[0,1,2]}\n{\"n\":4,\"result\":{\"won\":true,\"reason\":\"SIEGE BROKEN\",\"score\":185205,\"rank\":\"STAR MARSHAL\",\"time\":607,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"SIEGE SHIP DESTROYED\",\"score\":6000}],\"modified\":false},\"hp\":[6,6,6,6],\"seen\":[\"hunter\",\"bomber\",\"scout\",\"anchor\",\"relay\",\"rammer\",\"tractor\",\"dive\"],\"phases\":[0,1,2]}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"sed -n '379,535p' vendor/hub/lib/hub/harness.html && sed -n '1,80p' vendor/hub/lib/hub/round.js && sed -n '780,865p' vendor/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"sed -n '379,535p' vendor/hub/lib/hub/harness.html && sed -n '1,80p' vendor/hub/lib/hub/round.js && sed -n '780,865p' vendor/engine/my-3d2dge.js\"","aggregated_output":" * page's origin). Results land in window.__hubCheck, and body[data-complete]\n * turns \"true\".\n * ------------------------------------------------------------------------- */\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nasync function until(test, ms) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    if (test()) return true;\n    await sleep(50);\n  }\n  return test();\n}\n\nfunction poke(cell, key) {\n  const doc = cell.frame.contentDocument;\n  const win = cell.frame.contentWindow;\n  if (!doc || !win) return false;\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n/**\n * round.js — one round of an AI Hub session, run by the hub that coordinates\n * it (the harness page, or the session host's tab).\n *\n * It never touches the network or a frame itself: every message for a game\n * goes out through `deliver(key, msg)`, and everything the games report comes\n * in through `receive(key, msg)` and `leave(key, reason)`. The clock is\n * injected, so `scripts/hub.test.mjs` can walk a round through every timeout\n * without waiting for one.\n *\n * Players are known by `key` (whatever the session calls them); games see\n * contiguous ids 0..N-1 in slot order.\n */\n\nexport const TIMINGS = Object.freeze({\n  helloMs: 10_000,\n  readyMs: 45_000,\n  /** Gated rounds: a game still loading when the hub releases the round gets this long more. */\n  loadGraceMs: 20_000,\n  countdownMs: 3_000,\n  graceMs: 5_000,\n  hiddenMs: 20_000,\n  maxRoundMs: 15 * 60_000,\n});\n\n/** P1 red, P2 blue, P3 green, P4 yellow: the colour follows the seat. */\nexport const SLOT_COLORS = Object.freeze(['#e8443a', '#3b82f6', '#22c55e', '#f5b700']);\n\nexport const MODES = Object.freeze(['parallel', 'ghost', 'shared-world']);\n\n/** Each mode's name on screen. */\nexport const MODE_NAMES = Object.freeze({ parallel: 'Parallel', ghost: 'Ghost', 'shared-world': 'Shared world' });\n\n/** Older tags, still played: race as ghost, co-op and versus as a shared world. */\nconst MODE_ALIASES = Object.freeze({ race: 'ghost', 'co-op': 'shared-world', versus: 'shared-world' });\n\n/** The mode a tag or a hello names, older tags included; null for anything else. */\nexport function modeOf(word) {\n  const w = String(word ?? '').trim().toLowerCase();\n  return MODES.includes(w) ? w : (MODE_ALIASES[w] ?? null);\n}\n\n/** Modes where every copy runs its own world: each reports its own result, and nothing depends on a host. */\nexport const SELF_REPORTED = Object.freeze(['parallel', 'ghost']);\n\n/**\n * Whether a game's round carries the seed in its address, so the client seeds\n * Math.random and every copy starts the same: read from the game's own tag,\n * parallel or ghost. A game still tagged race was built for an unseeded start\n * (ids it makes from Math.random must differ between its copies), so it keeps one.\n */\nexport const seedsRandom = (tag) => ['parallel', 'ghost'].includes(String(tag ?? '').trim().toLowerCase());\n\nconst REAL_CLOCK = {\n  now: () => Date.now(),\n  setTimeout: (fn, ms) => setTimeout(fn, ms),\n  clearTimeout: (handle) => clearTimeout(handle),\n};\n\n/** A round's hard cap: half again its declared length, never past 15 minutes; the longest when it declares none. */\nexport function limitFor(minutes, { maxRoundMs = TIMINGS.maxRoundMs } = {}) {\n  const typical = Number(minutes);\n  if (!(typical > 0)) return maxRoundMs;\n  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\n}\n\n/**\n * Parallel and ghost order: finishers by time, then the rest by score,\n * then anyone who reported nothing, tied last. Equal times or scores share a\n * place.\n */\nexport function rankResults(results, ids) {\n  const timed = [];\n  const scored = [];\n  const silent = [];\n  for (const id of ids) {\n    const r = results.get(id);\n    if (r && Number.isFinite(r.time)) timed.push([id, r.time]);\n    else if (r && Number.isFinite(r.score)) scored.push([id, r.score]);\n    else silent.push(id);\n    this.deadzone = .18; this.padIndex = null; this.padId = ''; this.lastDevice = 'keyboard';\n    /** pad: the gamepad this input reads: 'any' (the first connected one another player hasn't: player 1's), an index (a\n     *  joined player's own), or null (none); keysTo: the other players' inputs the keyboard's codes go to as well (players\n     *  sharing it, each with half its keys: game.players) */\n    this.pad = 'any'; this.keysTo = null; this._claimed = null;\n    /** touchEnabled: false turns the touch stick off; stickSide: 'left' or 'right', the half of the screen the stick\n     *  lives on; stickRadius: how far (CSS pixels) a finger drags for full tilt; stickDeadzone: the part of that radius a\n     *  thumb moves before the stick counts (0..0.5); steer: 'stick' (a stick drawn under the thumb) or 'drag' (a finger\n     *  anywhere on the screen but the buttons steers by drag(), with no stick drawn: a shooter's ship that follows the\n     *  thumb); padAxes: the gamepad's raw axes */\n    this.touchEnabled = true; this.stickSide = 'left'; this.steer = 'stick'; this.stickRadius = 44; this.stickDeadzone = .12; this.padAxes = []; this._taps = new Set(); this._tapsDue = new Set(); this._holds = new Set();\n    /** zones: areas of the screen a finger holds an action down in, [{ x0, y0, x1, y1, act }] (fractions of the canvas,\n     *  0..1; the first that holds the finger wins), or null: a pinball's two halves, a rhythm game's lanes. A finger\n     *  landing in one presses act until it lifts (several fingers, several zones), and starts no stick */\n    this.zones = null; this._zoneOf = new Map();\n    /** pinching: two fingers on the canvas are pinching the camera's zoom (they moved apart or together: not the stick,\n     *  not a tap). The game lets the player zoom only where its scene does (camera.zoom): then the wheel, - and = (keys no\n     *  action uses) and a pinch ask for it, read by zoom() */\n    this._pinching = false; this._zoomAcc = 1; this._zoomNow = 1; this._zoomOn = false; this._wheelOn = false; this._fingers = new Map();\n    // the pointer's gestures (box, longPress, doubleTap, pan): the press followed (_g), what this step reads, what the next will\n    this._g = null; this._gBox = null; this._gLong = null; this._gTap2 = null; this._gPan = null; this._lastTap = null; this._zoomPt = null; this._fedAt = null;\n    this._boxAt = null; this._longAt = null; this._tap2At = null; this._panAt = null;\n    /** glyphs: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' |\n     *  'nintendo' | 'generic' (positions); rumbleScale: vibration strength 0..1 (0 = off; game.settings.rumble sets it);\n     *  padLost: true for the step after the gamepad in use was unplugged (a pausable scene pauses) */\n    this.glyphs = 'auto'; this.rumbleScale = .6; this.padLost = false;\n    /** names: the actions' names on the Controls screen ({ attack: 'Sword' }; false hides one from rebinding: the\n     *  game's menu.controls); onBindings(b): called with the player's new bindings (the game saves and applies them) */\n    this.names = null; this._onBindings = null;\n    const el = screen.canvas;\n    if (!el) return;\n    // the keyboard's own letters for labels (an AZERTY Z where the code says KeyW), where the browser tells them\n    try { if (navigator.keyboard && navigator.keyboard.getLayoutMap) navigator.keyboard.getLayoutMap().then(m => { this._layout = m; }).catch(() => {}); } catch (e) { /* no layout map */ }\n    if (screen.listeners) screen.listeners.push(() => { if (this.stickOn) this._stickEnd({ pointerId: this.stickId }); });   // a resize or a turn of the phone moves the stick's origin: lift it (a screen of a page's own may have no listeners)\n    const on = (t, type, fn) => t.addEventListener(type, fn, { signal });\n    const typing = e => {\n      const t = e.target; if (!t || !t.tagName) return false;\n      if (t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable) return true;\n      return t.tagName === 'INPUT' && !['range', 'checkbox', 'radio', 'button', 'submit', 'color'].includes(t.type);\n    };\n    on(window, 'keydown', e => {\n      if (typing(e)) return;\n      const share = this.keysTo && this.keysTo.filter(q => q._codes[e.code]);   // (players sharing the keyboard: each answers to its half)\n      if (this._codes[e.code] || (share && share.length)) { e.preventDefault(); if (!e.repeat) { if (this._codes[e.code]) this.press(e.code); if (share) for (const q of share) q.press(e.code); } }\n      else if (this._zoomOn && ZOOM_KEYS[e.code] && !e.ctrlKey && !e.metaKey && !e.altKey) { e.preventDefault(); if (!e.repeat) this._zoomAcc *= ZOOM_KEYS[e.code]; }   // - and =, where no action uses them\n    });\n    // the wheel zooms where the game lets it (a mouse's notch 10%; a trackpad's pinch comes as the wheel with ctrlKey);\n    // not over a menu, which scrolls\n    el.addEventListener('wheel', e => {\n      const wc = e.deltaY < 0 ? 'WheelUp' : e.deltaY > 0 ? 'WheelDown' : null;\n      if (wc && this._codes[wc]) { e.preventDefault(); this._tapCode(wc); this.lastDevice = 'mouse'; return; }   // (a wheel bound to an action: a notch taps it, no zoom)\n      if (!this._wheelOn) return; e.preventDefault();\n      const d = e.deltaY * (e.deltaMode === 1 ? 33 : e.deltaMode === 2 ? 100 : 1);\n      this._zoomAcc *= clamp(Math.exp(-d * (e.ctrlKey ? .01 : .001)), .8, 1.25); this._zoomPt = this.screenPoint(e.clientX, e.clientY);\n    }, { signal, passive: false });\n    const all = f => { f(this); if (this.keysTo) for (const q of this.keysTo) f(q); };\n    on(window, 'keyup', e => all(q => q.release(e.code)));\n    on(window, 'blur', () => all(q => q.clear()));\n    on(document, 'visibilitychange', () => { if (document.hidden) all(q => q.clear()); });\n    on(el, 'contextmenu', e => e.preventDefault());\n    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { if (this.lastDevice !== 'mouse' && this.lastDevice !== 'keyboard' && Math.hypot(e.clientX - this.mouse.cx, e.clientY - this.mouse.cy) > 3) this.lastDevice = 'mouse'; this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });\n    on(el, 'pointerdown', e => {\n      if (e.pointerType !== 'mouse') this.lastDevice = 'touch';   // any touch, on the stick's half or not: prompts follow it\n      if (e.pointerType !== 'mouse' || e.button === 0) this._down = { id: e.pointerId, x: e.clientX, y: e.clientY };   // a click or tap once it lifts near here (pointerup)\n      if (e.pointerType === 'mouse') { this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.aimSource = 'mouse'; this.press('Mouse' + e.button); }\n      else {\n        if (e.pointerType === 'touch' && !this._touched) { this._touched = true; if (this._touchArgs && !this._touchEl) this._touchSync(); }\n        this._fingers.set(e.pointerId, { x: e.clientX, y: e.clientY }); this._pinchArm();\n        const rc = this.zones && el.getBoundingClientRect(), z = rc && this._zone((e.clientX - rc.left) / rc.width, (e.clientY - rc.top) / rc.height);\n        if (z) this._zoneDown(e.pointerId, z); else if (!this.touchFilter || this.touchFilter(e)) this._stickStart(e);\n      }\n      if (e.pointerType === 'mouse' || this._fingers.size === 1) this._gesture('down', ...this.screenPoint(e.clientX, e.clientY), { touch: e.pointerType !== 'mouse', button: e.button, id: e.pointerId }); else this._g = this._gBox = null;   // (a second finger: a pinch, no gesture)\n    });\n    on(window, 'pointerup', e => {\n      const d = this._down; this._down = null;   // a click or tap: lifted within a few pixels of where it landed (a drag, the stick's, is none): clicked() for a step,\n      // in screen pixels now: where it touched what was drawn, before a phone's first tap goes full screen and moves the canvas\n      if (d && d.id === e.pointerId && Math.hypot(e.clientX - d.x, e.clientY - d.y) < 12) this._click = this.screenPoint(e.clientX, e.clientY);\n      if (this._g && this._g.id === e.pointerId) this._gesture('up', ...this.screenPoint(e.clientX, e.clientY));\n      if (e.pointerType === 'mouse') this.release('Mouse' + e.button); else { this._fingerUp(e); this._stickEnd(e); this._zoneUp(e.pointerId); }\n    });\n    on(window, 'pointercancel', e => { this._down = null; this._g = this._gBox = null; this._fingerUp(e); this._stickEnd(e); this._zoneUp(e.pointerId); });\n    on(el, 'lostpointercapture', e => this._stickEnd(e));\n  }\n  /** switch key layout at runtime: input.use(E.Input.PLATFORMER) or input.use('SHMUP'). The player's own bindings\n   *  (bindings, set by rebind() and the Controls screen) are laid over it. Every preset (E.Input.DEFAULT, PLATFORMER,\n   *  THIRDPERSON, SHMUP) has the moves (up, down, left, right) and the menu's actions (start, pause, confirm, cancel).\n","exit_code":0,"status":"completed"}}
