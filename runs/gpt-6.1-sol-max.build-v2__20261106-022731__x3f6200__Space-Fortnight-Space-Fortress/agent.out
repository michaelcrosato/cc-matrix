{"type":"item.started","item":{"id":"item_116","type":"command_execution","command":"/bin/bash -lc \"cat > tools/capture_motion.py <<'EOF'\n\\\"\\\"\\\"Purposeful native animation filmstrips, driven by the real fixed-step game clock.\\\"\\\"\\\"\nfrom pathlib import Path\nimport subprocess\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent.parent\nARTIFACT = ROOT.parent / (ROOT.name + '.html')\nwith sync_playwright() as p:\n    browser = p.chromium.launch(headless=True)\n    page = browser.new_page(viewport={'width':1920,'height':1080})\n    page.goto(ARTIFACT.as_uri())\n    page.wait_for_function('window.__fortnight')\n    page.locator('.esh-ttl button').first.click()\n    page.wait_for_function('__fortnight.world')\n    page.evaluate('__game.stop();__game.audio.mute(true);__game.debug.advance(4,{draw:false});__game.input.hold(\\\"right\\\");__game.input.tap(\\\"boost\\\");__game.input.tap(\\\"pulse\\\");__game.input.hold(\\\"fire\\\")')\n    cases = [\n        ('pulse-boost',[.01,.06,.08,.1,.12,.14],{'x':430,'y':480,'width':900,'height':480}),\n        ('boss-shutters',[.01,.5,.5,.5,.5,.5],{'x':450,'y':130,'width':1400,'height':620}),\n        ('docking',[.01,.5,.5,.5,.5,.5],{'x':350,'y':430,'width':1250,'height':600}),\n        ('victory',[.01,.35,.35,.35,.35,.65],{'x':0,'y':0,'width':1920,'height':1080}),\n    ]\n    for name,steps,clip in cases:\n        if name=='boss-shutters':\n            page.evaluate('__game.input.clear();__game.debug.jump(2,2,1)')\n        if name=='docking':\n            page.evaluate('__fortnight.world.enterAct(2);__fortnight.ui.lastPhase=\\\"\\\"')\n        if name=='victory':\n            page.evaluate('__fortnight.startSolo();__game.debug.advance(750,{bot:true,draw:false})')\n        frames=[]\n        for i,dt in enumerate(steps):\n            page.evaluate('(dt)=>__game.advance(dt,{draw:true})',dt)\n            path=ROOT/'evidence'/f'{name}-{i:02}.png'\n            page.screenshot(path=str(path),clip=clip)\n            frames.append(str(path))\n        subprocess.run(['magick','montage',*frames,'-tile','3x2','-geometry','600x338+4+4',str(ROOT/'evidence'/f'{name}-filmstrip.png')],check=True,capture_output=True)\n    errors=page.evaluate('__game.errors')\n    browser.close()\n    if errors:\n        raise RuntimeError(str(errors))\nEOF\nruff check tools/capture_motion.py\nruff format tools/capture_motion.py\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tools/capture_motion.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
