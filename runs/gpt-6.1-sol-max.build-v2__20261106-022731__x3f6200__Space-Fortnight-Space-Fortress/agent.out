* k, oy + y * k];\n    cv._xf = { k, ox, oy };\n    if (!m._shellBase || m._shellBase.v !== m.version || m._shellBase.w !== W) {   // the cells, cached until the map changes\n      const b = mkCanvas(W, H), bg = ctx2d(b); bg.fillStyle = '#121b1d'; bg.fillRect(0, 0, W, H);\n      let top = 1; for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) top = Math.max(top, m.height(cx, cy));\n      for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) {\n        const c = m.cell(cx, cy), tag = m.floorAt((cx + .5) * T, (cy + .5) * T);\n        bg.fillStyle = c > 0 ? mix('#4a5650', '#d2c296', m.height(cx, cy) / top) : tag === 'water' || tag === 'lava' ? (tag === 'water' ? '#1d3e56' : '#6a2a1a') : tag === 'grass' ? '#29452f' : '#1f2b2c';\n  constructor(game, signal) {\n    /** game: the game it plays for; ctx: the Web Audio context, made at the first sound (null before, or where there\n     *  is none); volume: master volume 0..1; sfxVolume, musicVolume, voiceVolume: 0..1 for effects, music and the voice\n     *  bus (bus('voice')); muted: true while mute() is on */\n    this._game = game; this._signal = signal; this.ctx = null; this.volume = .7; this.sfxVolume = 1; this.musicVolume = .5; this.voiceVolume = 1; this.muted = false;\n    /** presets: the named sound effects, sfx(name) plays one and define(name, voice) adds one; song: the music\n     *  playing (null for none); failed: why there is no sound (a message), or null; ducked: true while duck(true)\n     *  holds the music down */\n    this.presets = Object.assign({}, SFX); this._last = {}; this.song = null; this.failed = null; this._ducked = false; this.ducked = false; this._waves = {};\n    /** offset: seconds the music sounds early, for speakers and headphones that lag (settings.audioOffset); drift: what\n     *  is heard against the game's clock at the last frame (seconds: the sound follows the clock, so it stays near 0);\n     *  anchors: how many times the sound was moved to meet the clock */\n    this.offset = 0; this.drift = 0; this.anchors = 0; this._ats = []; this._beats = []; this._fading = []; this._stings = []; this._fr = null; this._timer = null;\n    // sound draws its own random numbers (noise, pitch variation): whether sound is on, muted or not yet unlocked by a tap\n    // never shifts the game's Math.random, so the same seed and inputs play the same game with or without it\n    this._rnd = rng(0x51A7E);\n  }\n  _init() {\n    if (this.ctx || this.failed) return this.ctx;\n    try {\n      const AC = window.AudioContext || window.webkitAudioContext; if (!AC) throw new Error('Web Audio is not available');\n      const c = this.ctx = new AC();\n      this._master = c.createGain(); this._master.connect(c.destination);\n      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n      this._musBus = c.createGain(); this._musBus.connect(this._master);\n      this._voiceBus = c.createGain(); this._voiceBus.connect(this._master);   // (bus('voice'): a game's babble or speech)\n      this.applyVolume();\n      const nb = c.createBuffer(1, c.sampleRate, c.sampleRate), d = nb.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = this._rnd() * 2 - 1;\n      this._noise = nb;\n      const resume = () => { if (c.state !== 'running') c.resume().catch(() => {}); };\n      for (const ev of ['pointerdown', 'keydown', 'touchstart']) addEventListener(ev, resume, { capture: true, signal: this._signal });\n      resume();\n    } catch (e) { this.failed = e.message || String(e); warn('audio', 'sound is off: ' + this.failed); }\n    return this.ctx;\n  }\n  /** true once the browser lets the game make sound */\n  get ready() { return !!this.ctx && this.ctx.state === 'running'; }\n  /** apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it) */\n  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); this._voiceBus.gain.value = this.voiceVolume; }\n  /** a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument)\n   *  to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is\n   *  voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio) */\n  bus(name = 'sfx') {\n    if (!['sfx', 'music', 'voice', 'master'].includes(name)) warn('bus:' + name, 'audio.bus(\"' + name + '\"): no such bus (sfx, music, voice, master): the sfx bus');\n    if (this._game.headless || !this._init()) return null;\n    return name === 'master' ? this._master : name === 'music' ? this._musBus : name === 'voice' ? this._voiceBus : this._sfxBus;\n  }\n  /** set the master volume, 0..1 */\n  setVolume(v) { this.volume = clamp(v, 0, 1); this.applyVolume(); }\n  /** toggle (or set) mute; returns the new state */\n  mute(on = !this.muted) { this.muted = on; this.applyVolume(); return on; }\n  /** the page is hidden (sleep true) or back: the sound sleeps with it unless the player keeps it on (settings.background) */\n  _background(sleep) { const c = this.ctx; if (!c) return; try { if (sleep && c.state === 'running') { this._slept = true; c.suspend().catch(() => {}); } else if (!sleep && this._slept) { this._slept = false; c.resume().catch(() => {}); } } catch (e) { /* closed */ } }\n  /** quiet the music (to 35%) while on: under a game's own pause, map or dialog screen. The engine also ducks it while game.paused */\n  duck(on = true) { on = !!on; if (this.ducked === on) return; this.ducked = on; this.applyVolume(); }\n  _duck(on) { if (this._ducked === on) return; this._ducked = on; this.applyVolume(); }   // (the engine's own: game.paused)\n  _pulse(duty) {\n    if (this._waves[duty]) return this._waves[duty];\n    const N = 40, re = new Float32Array(N), im = new Float32Array(N);\n    for (let n = 1; n < N; n++) { const a = 2 / (n * Math.PI) * Math.sin(n * Math.PI * duty); re[n] = a * Math.cos(n * Math.PI * duty); im[n] = a * Math.sin(n * Math.PI * duty); }\n    return (this._waves[duty] = this.ctx.createPeriodicWave(re, im));\n  }\n  // one voice at t0 into bus: its sources (a looped one sounds on, at its volume, until they are stopped)\n  _voice(p, bus, t0, mul = 1, loop = false) {\n    const c = this.ctx, wave = p.wave || 'square', dur = Math.max(.012, p.dur || .15), vol = p.vol === undefined ? .3 : p.vol, att = p.attack === undefined ? .004 : p.attack;\n    const t = t0 + (p.delay || 0), end = t + dur, f0 = Math.max(20, noteFreq(p.freq || 440) * mul), to = p.to ? Math.max(20, noteFreq(p.to) * mul) : 0;\n    const ins = this._ins && this._ins[wave]; if (ins) { ins(c, bus, t, f0, dur, vol); return []; }   // (an instrument of the game's own)\n    const g = c.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + att);\n    if (loop) g.gain.setValueAtTime(vol, t + att);   // (held at its volume until stopped)\n    else if (p.hold) { g.gain.setValueAtTime(vol, Math.max(t + att, end - .03)); g.gain.linearRampToValueAtTime(0, end); }\n    else g.gain.exponentialRampToValueAtTime(.0005, end);\n    let lfo = null;\n    let src;\n    if (wave === 'noise') {\n      src = c.createBufferSource(); src.buffer = this._noise; src.loop = true;\n      const f = c.createBiquadFilter(); f.type = p.filter || 'bandpass'; f.Q.value = p.q || 1.1; f.frequency.setValueAtTime(f0, t); if (to) f.frequency.exponentialRampToValueAtTime(to, end);\n      src.connect(f); f.connect(g); src.start(t, this._rnd() * .5);\n    } else {\n      src = c.createOscillator();\n      if (wave === 'pulse' || wave === 'pulse12') src.setPeriodicWave(this._pulse(wave === 'pulse' ? .25 : .125));\n      else src.type = wave === 'saw' ? 'sawtooth' : ['square', 'triangle', 'sine', 'sawtooth'].includes(wave) ? wave : 'square';\n      src.frequency.setValueAtTime(f0, t);\n      if (to) src.frequency.exponentialRampToValueAtTime(to, end);\n      if (p.arp) { const st = p.step || .06; for (let k = 0, tt = t; tt < end; tt += st, k++) src.frequency.setValueAtTime(f0 * Math.pow(2, p.arp[p.loop ? k % p.arp.length : Math.min(k, p.arp.length - 1)] / 12), tt); }\n      if (p.vib) { lfo = c.createOscillator(); const lg = c.createGain(); lfo.frequency.value = p.vib[0]; lg.gain.value = f0 * p.vib[1]; lfo.connect(lg); lg.connect(src.frequency); lfo.start(t); if (!loop) lfo.stop(end + .05); }\n      src.connect(g); src.start(t);\n    }\n    g.connect(bus); if (!loop) src.stop(end + .05);\n    return lfo ? [src, lfo] : [src];\n  }\n  /**\n32:game.advance(0.25);   // 30 fixed steps of 1/120 s, at once\n34:game.dispose();\n91:- 1243 Module arcade: the coin-op's frame: scores, high-score tables and initials, lives, credits, turns, cards, the attract mode (engine/modules/arcade.js); E.Arcade: arcade\n271:- `new E.Input(screen, map, signal) → input`: signal: an AbortSignal that removes every listener this adds (game.dispose()). A screen without a canvas (headless) gets no DOM listeners: input comes fro [... omitted end of long line]\n289:- `input.drag()` †: how far the touch stick's finger moved since the last step, in screen pixels [dx, dy] (the HUD's space), or null while no finger holds it: to steer one to one (a shooter's ship fol [... omitted end of long line]\n325:- `input.aimSource = 'move'` †: what aims right now: 'move' | 'mouse' | 'pad'\n347:- `input.steer = 'stick'` †: 'stick' (a stick drawn under the thumb) or 'drag' (a finger anywhere on the screen but the buttons steers by drag(), with no stick drawn: a shooter's ship that follows the [... omitted end of long line]\n353:- `input.stickSide = 'left'` †: 'left' or 'right', the half of the screen the stick lives on\n404:- `game.particles.list = []`: the live particles\n414:- `r.actor({ ghost })`: ghost.owner (any {x, y, z}, usually the actor itself) keeps its afterimages sorted behind the live body\n459:- `new E.Game(o = {}) → game`: new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu, fullscreen: 'tap', corner: true, backGesture: true, autoPause [... omitted end of long line]\n463:- `new E.Game({ headless })`: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default): scenes update and draw is skipped; drive it with advance() and inpu [... omitted end of long line]\n465:- `new E.Game({ loop })`: false makes a game in a page that runs only by advance()\n469:- `new E.Game({ autoPause })`: a pausable scene pauses when the page is hidden or loses focus\n470:- `new E.Game({ live })`: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it, the scene's update goes on (game.paused says a menu is up) and the m [... omitted end of long line]\n477:- `game.advance(seconds = this.o.step, o = {})`: run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and headless runs (advance(1) is 120 [... omitted end of long line]\n478:- `game.after(seconds, fn, o = {})`: run fn once after `seconds` of game time. Cleared on scene change, unless { keep: true } (a site's clock, a watcher of the whole game: it outlives scenes, as a kep [... omitted end of long line]\n482:- `game.dispose()`: end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window, the document, the canvas and the buttons, the touch controls,  [... omitted end of long line]\n493:- `game.menu(name, o)`: open the menu (the corner's menu button and the touch START do it): a pausable scene (or a game started without scenes) pauses on its pause screen; any other scene, a title, wa [... omitted end of long line]\n511:- `game.start(hooks)`: Start the loop. Either one scene: game.start({ update(dt), draw(r) }) or several: game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' }) A scene is { enter(data), [... omitted end of long line]\n517:- `game.tween(target, to, seconds, o)` †: ease target's numbers to new values over seconds of game time: game.tween(door, { y: 40 }, .5, { ease: 'outBack', delay, repeat (more plays; -1 forever), yoyo [... omitted end of long line]\n529:- `game.disposed = true`: true after dispose()\n541:- `game.live` †: true (o.live): a pause opens the menus over a world that keeps stepping (an online or shared world can't stop for one player): paused is true and the scene's update goes on, the menu  [... omitted end of long line]\n564:- `game.timeScale = 1`: game speed, 1 normal, .25 slow motion, 0 stopped (it outlives a scene change: a game's speed setting; restore a slow motion with a kept timer)\n599:- `script.keep` †: it outlives the scene\n604:- `tween.keep` †: it outlives the scene\n685:- `rig.drawPortrait(g, x, y, size = 40, o = {})` †: a close-up bust for dialog boxes and menus, drawn live from the rig (blinks, hair and hats included): rig.drawPortrait(g, x, y, 40, { zoom: 3, turn: [... omitted end of long line]\n1043:- `shots.list = []`: the live bullets\n1048:- `E.pattern.aim(a, b, speed)`: aim from a to b on the ground plane (x, y); aimSide uses x, z\n1058:- `grid.build(list, xk = 'x', yk = 'y')`: clear, then add every live thing in list (skips o.dead); do it once a step\n1130:- `talk.say(text, o = {})`: open with one string or a list of strings (each starts a new page). opts: { name, onDone, choices, onChoice, portrait: rig (a live close-up of that Humanoid beside the text [... omitted end of long line]\n1193:- `shell.dispose()` †: take its elements away and let go of the game (game.dispose() does it)\n1243:## Module arcade: the coin-op's frame: scores, high-score tables and initials, lives, credits, turns, cards, the attract mode (engine/modules/arcade.js)\n1245:- `new E.Arcade(game, o = {}) → arcade`: new E.Arcade(game, { id, lives: 3, extra: [] (the scores that give a life) or every (a life each that many points), credits: null (free play) or the coins a ga [... omitted end of long line]\n1252:- `arcade.continue(seconds = 10, done)`: a continue: CONTINUE? counts down seconds; start, confirm or a tap continues (with the credits it takes): every player's lives back, the scores kept, done(true [... omitted end of long line]\n1254:- `arcade.die()`: a life lost: 'again' (lives left), 'next' (the other player's turn) or 'over' (none left for anyone)\n1255:- `arcade.draw(r, box)`: the frame over the game, after its drawing: the HUD (o.hud: 1UP, HI, 2UP in a row) along the top of box [x, y, w, h] (the playfield; the screen when none), the lives along its [... omitted end of long line]\n1275:- `arcade.players = []`: [{ n, score, lives, save (the game's own: a stage kept while the other plays), next (the score of the next extra life) }]\n1329:- `car.update(dt, map, c = {})`: one step: steering, engine, grip, drift, the surface, then E.Body's walls and hop. c: an input or an intent\n","exit_code":0,"status":"completed"}}
