{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"sed -n '1158,1198p' vendor/engine/my-3d2dge.js && sed -n '216,231p' tests/browser_checks.py && sed -n '1,50p' evidence/hub-4-standard.json\"","aggregated_output":"  }\n  /** browser client coords -> screen pixels [x, y] (the HUD's space, with no camera), or null without a canvas */\n  screenPoint(cx, cy) {\n    const S = this.screen; if (!S.canvas) return null;\n    const rc = S.canvas.getBoundingClientRect(); return [((cx - rc.left) * S.dpr - S.OX) / S.S, ((cy - rc.top) * S.dpr - S.OY) / S.S];\n  }\n  /** advance input by one step: read the gamepad and turn presses since the last step into this step's pressed() and\n   *  released() (the engine calls it every step) */\n  tick(dt) {\n    this._suppressed.clear();\n    this.clock += dt;\n    let pads = [];\n    try { pads = navigator.getGamepads ? navigator.getGamepads() : []; } catch (e) { /* gamepads blocked */ }\n    const C = this._claimed, ok = p => p && p.connected !== false && (this.pad === 'any' ? !(C && C.has(p.index)) : p.index === this.pad);   // (its own pad, or any another player hasn't)\n    const p = this.pad === null ? null : Array.from(pads || []).find(p => ok(p) && p.index === this.padIndex) || Array.from(pads || []).find(ok);\n    this.padLost = false;\n    if (!p || p.index !== this.padIndex || p.id !== this.padId) {\n      if (!p && this.padIndex !== null) { this.padLost = this.lastDevice === 'gamepad'; this.stopRumble(); }   // unplugged while in use\n      if (this.padIndex !== null) { this.padPrev.forEach((on, i) => { if (on) this.release('Pad' + i); }); for (const c of ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight', 'PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight']) this.release(c); }   // (a pad gone or changed lets go once; with none, a script's pad codes stay held)\n      this.padPrev = []; this.padMove = [0, 0]; this.padAim = null; this.padAxes = []; this.padValues = [];\n      this.padIndex = p ? p.index : null; this.padId = p ? p.id : '';\n      if (this.aimSource === 'pad') this.aimSource = 'move';\n    }\n    if (p) {\n      const dz = (x, y) => { const l = Math.hypot(x, y), d = clamp(this.deadzone, 0, .8); return l <= d ? [0, 0] : [x / l * Math.min(1, (l - d) / (1 - d)), y / l * Math.min(1, (l - d) / (1 - d))]; };\n      this.padAxes = Array.from(p.axes);\n      this.padMove = dz(p.axes[0] || 0, p.axes[1] || 0); if (this.invertMoveX) this.padMove[0] *= -1; if (this.invertMoveY) this.padMove[1] *= -1;   // (the Controller settings: a stick worn the wrong way)\n      const aim = dz(p.axes[2] || 0, p.axes[3] || 0);\n      this.padAim = Math.hypot(...aim) > 0 ? [aim[0], aim[1] * (this.invertAimY ? -1 : 1)] : null;\n      this.padValues = p.buttons.map(b => b.value || (b.pressed ? 1 : 0));\n      const ra = this.padAim || [0, 0], rd = [ra[1] < -.5, ra[1] > .5, ra[0] < -.5, ra[0] > .5];\n      ['PadRAxisUp', 'PadRAxisDown', 'PadRAxisLeft', 'PadRAxisRight'].forEach((c, i) => rd[i] ? this.press(c) : this.release(c));   // (the right stick past halfway: codes to bind)\n      if (this.padAim || Math.hypot(...this.padMove) > 0) { this.aimSource = 'pad'; this.lastDevice = 'gamepad'; }\n      p.buttons.forEach((b, i) => { const on = b.pressed; if (on && !this.padPrev[i]) this.press('Pad' + i); if (!on && this.padPrev[i]) this.release('Pad' + i); this.padPrev[i] = on; });\n      const dirs = [this.padMove[1] < -.5, this.padMove[1] > .5, this.padMove[0] < -.5, this.padMove[0] > .5];\n      ['PadAxisUp', 'PadAxisDown', 'PadAxisLeft', 'PadAxisRight'].forEach((c, i) => dirs[i] ? this.press(c) : this.release(c));\n    }\n    // a tap is held for the one step after it (its release comes the step after that)\n    for (const c of this._tapsDue) if (!this._holds.has(c)) this.release(c);\n    const due = this._tapsDue; due.clear(); this._tapsDue = this._taps; this._taps = due;\n    // presses since the last step become this step's pressed()/released()\n    context.close()\n\n    # Native controller navigation with a standard mapping, injected before loading.\n    ctx=browser.new_context(viewport={'width':1920,'height':1080});ctx.add_init_script(PAD_SCRIPT)\n    padpage=ctx.new_page();padpage.set_default_timeout(4500);boot(padpage)\n    def controller():\n        press_pad(padpage,13);press_pad(padpage,0)\n        need(padpage.evaluate('__fortnight.ui.shell.screen')=='join','Pad did not open join screen')\n        padpage.evaluate('''()=>{for(let i=1;i<4;i++)testPads.push({id:'Standard wing '+i,index:i,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))});}''')\n        for i in [1,2,3]:press_pad(padpage,9,i)\n        need(padpage.evaluate('__game.players.length')==4,'Four pad join failed')\n        focus_pad(padpage,'Launch wing');press_pad(padpage,0)\n        padpage.wait_for_function('__fortnight.world && __fortnight.world.s.players.length===4')\n        padpage.evaluate('__game.debug.advance(4,{draw:false});testPads[0].axes[0]=.8;testPads[1].axes[0]=-.8')\n        before=padpage.evaluate('__fortnight.world.s.players.map(p=>p.x)');padpage.wait_for_timeout(220)\n        after=padpage.evaluate('__fortnight.world.s.players.map(p=>p.x)')\n{\n  \"done\": true,\n  \"pass\": true,\n  \"game\": \"/game.html\",\n  \"players\": 4,\n  \"scenario\": \"standard\",\n  \"checks\": [\n    {\n      \"name\": \"head metas\",\n      \"pass\": true,\n      \"detail\": \"hub:session=1 mode=shared-world\"\n    },\n    {\n      \"name\": \"hub:session-players is a range within 1\\u20134\",\n      \"pass\": true,\n      \"detail\": \"hub:session-players=1-4\"\n    },\n    {\n      \"name\": \"hub:session-minutes, when given, is a number\",\n      \"pass\": true,\n      \"detail\": \"hub:session-minutes=12\"\n    },\n    {\n      \"name\": \"every copy says hello\",\n      \"pass\": true,\n      \"detail\": \"\"\n    },\n    {\n      \"name\": \"hello names protocol 1 and the mode\",\n      \"pass\": true,\n      \"detail\": \"{\\\"v\\\":1,\\\"client\\\":\\\"1.4.0\\\",\\\"mode\\\":\\\"shared-world\\\",\\\"seats\\\":[1,4],\\\"card\\\":false}\"\n    },\n    {\n      \"name\": \"hello seats cover this player count\",\n      \"pass\": true,\n      \"detail\": \"[1,4]\"\n    },\n    {\n      \"name\": \"ready without a key press (the card asks the players)\",\n      \"pass\": true,\n      \"detail\": \"\"\n    },\n    {\n      \"name\": \"the round starts when the card ends\",\n      \"pass\": true,\n      \"detail\": \"countdown\"\n    },\n    {\n      \"name\": \"game traffic flows both ways\",\n      \"pass\": true,\n","exit_code":0,"status":"completed"}}
