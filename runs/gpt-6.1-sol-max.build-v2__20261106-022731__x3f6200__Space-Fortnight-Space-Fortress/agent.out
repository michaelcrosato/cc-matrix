{"type":"item.started","item":{"id":"item_107","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/input.js');s=p.read_text();needle='\\\\t\\\\t\\\\t// Shell menus deliberately stay native.'\ns=s.replace(needle, '''            document.addEventListener(\\\"click\\\", event => {\n                if(performance.now() < (this.app.blockInputUntil || 0)) {event.preventDefault();event.stopImmediatePropagation();}\n            },{capture:true,signal});\n''' +needle);p.write_text(s)\np=Path('src/sim/world.js');s=p.read_text().replace('const scale =\\\\n\\\\t\\\\t\\\\t\\\\t1 + Math.max', '''if(kind === \\\"anchor\\\" && s.act === 1 && Math.hypot(x-480,y-277) < 112) {\n                const angle=Math.atan2(y-277,x-480);x=480+Math.cos(angle)*112;y=277+Math.sin(angle)*112;\n            }\n            const scale =\n\\\\t\\\\t\\\\t\\\\t1 + Math.max''',1)\na=s.index('\\\\t\\\\t\\\\t\\\\tconst nearby = s.players.find(');b=s.index('\\\\n\\\\t\\\\t\\\\t\\\\tthis.spawn(g.kind,',a)\ns=s[:a]+'''                const pilots=s.players.filter(p=>p.hp>0&&\"'!p.gone);\n                const safe=(xx,yy)=>pilots.every(p=>Math.hypot(p.x-xx,p.y-yy)>=110);\n                if(!safe(x,y)) {\n                    const candidates=[];\n                    for(let j=0;j<=24;j++) {\n                        const q=j/24;\n                        candidates.push(g.side === \"left\" ? [48,100+q*350] : g.side === \"right\" ? [912,100+q*350] : [48+q*864,y]);\n                    }\n                    candidates.push([48,105],[912,105],[48,448],[912,448]);\n                    const spot=candidates.filter(p=>safe(...p)).sort((a,b)=>(a[0]-x)**2+(a[1]-y)**2-((b[0]-x)**2+(b[1]-y)**2))[0];\n                    if(spot)[x,y]=spot;\n                }\n'\"''' +s[b:];p.write_text(s)\np=Path('tests/simulation.mjs');s=p.read_text();needle='export const simulationResults = results;'\nnew='''check(\\\"entry telegraphs stay clear of every co-op pilot and ancho