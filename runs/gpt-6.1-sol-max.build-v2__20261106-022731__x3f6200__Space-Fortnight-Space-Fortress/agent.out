{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/input.js');s=p.read_text().replace(\\\"if(x<0||x>S.W||y<0||y>S.H)return;\\\", \\\"if(x<0||x>S.W)return;\\\")\ns=s.replace(\\\"else {aim=[touch.x-p.x,touch.y-p.y];out.fire=true;}\\\", \\\"else {if(Math.hypot(touch.x-touch.sx,touch.y-touch.sy)>5)aim=[touch.x-touch.sx,touch.y-touch.sy];out.fire=true;}\\\")\ns=s.replace(\\\"out.fire=out.fire||I.down('fire')\\\", \\\"out.fire=out.fire||I.down('fire')||I.pressed('fire')\\\")\ns=s.replace(\\\"out.boost=I.down('boost');out.pulse=I.down('pulse');\\\", \\\"out.boost=I.down('boost')||I.pressed('boost');out.pulse=I.down('pulse')||I.pressed('pulse');\\\")\np.write_text(s)\np=Path('src/style.css');s=p.read_text().replace('padding:0 0 52px 57px','padding:0 0 40px 57px').replace('.esh .esh-ttl>div{width:440px}', '.esh .esh-ttl>div{width:440px;padding-left:0}')\ns=s.replace('padding:11px 14px;text-transform:uppercase','padding:8px 14px;text-transform:uppercase').replace('font-size:13px;text-align:left;min-height:44px','font-size:13px;text-align:left;min-height:38px')\ns=s.replace('padding:13px 17px;font-size:17px;min-height:51px','padding:10px 17px;font-size:17px;min-height:45px').replace(\\\"margin-right:16px;font-size:21px\\\", \\\"margin-right:16px;font-size:17px\\\")\np.write_text(s)\np=Path('src/render/scene.js');s=p.read_text().replace(\\\"        txt(g,'01  INTERCEPT    02  DEFEND    03  HOLD',57,305,C.muted,1);\\\",'')\np.write_text(s)\np=Path('tests/browser_checks.py');s=p.read_text().replace('milliseconds=65','milliseconds=110').replace(\\\"get_by_role('button',name='Back',exact=True).click()\\\", \\\"locator('.esh-btns').get_by_role('button',name='Back',exact=True).click()\\\")\ns=s.replace(\\\"    def credits_and_hover():\\\\n\\\", \\\"    def credits_and_hover():\\\\n        page.evaluate('__fortnight.title()');page.wait_for_timeout(60)\\\\n\\\")\np.write_text(s)\nPY