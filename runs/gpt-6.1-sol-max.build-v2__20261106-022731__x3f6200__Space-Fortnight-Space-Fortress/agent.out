f (live && o.min && now() - t0 < o.min * 1000) { requestAnimationFrame(next); return; }\n      if (live) BOOT._step(n + 1, n + 1, 'Warming up');\n      this._booting = false; const bg = this._bootGo; this._bootGo = null;\n      if (bg && h.scenes && h.scenes[bg.name]) Object.assign(h, { scene: bg.name, data: bg.data }); else if (bg) warn('go:' + bg.name, 'game.go(\"' + bg.name + '\") in a boot step: no such scene. Scenes: ' + Object.keys(h.scenes || {}).join(', '));\n      this.start(h); res(this);\n    };\n    next();\n    return this;\n  }\n  /** stop the loop; the game keeps its state, and start() resumes it */\n  stop() { this._running = false; if (this._raf != null && typeof cancelAnimationFrame === 'function') cancelAnimationFrame(this._raf); this._raf = null; return this; }\n  /**\n   * end the game for good: stop the loop and remove everything the engine added to the page (its listeners on the window,\n   * the document, the canvas and the buttons, the touch controls, the GPU lighting's canvas) and close the sound. Tests and\n   * tools that make many games call it; the canvas stays\n   */\n  dispose() {\n    /** disposed: true after dispose() */\n    this.stop(); this.disposed = true;\n    if (this._abort) this._abort.abort();\n    if (this.shell) this.shell.dispose();\n    const A = this.audio; try { A.stopMusic(); if (A.ctx && A.ctx.close) A.ctx.close(); } catch (e) { /* already closed */ } A.ctx = null; A.failed = 'the game was disposed';\n    const I = this.input; I.stopRumble(); for (const el of [I._touchEl, I._stickEl, I._knobEl, this._corner]) if (el && el.remove) el.remove();\n    this._corner = null;\n    const G = this.gpu; if (G) { try { if (G._cv) G._cv.remove(); if (G._dev && G._dev.destroy) G._dev.destroy(); } catch (e) { /* gone */ } G.enabled = G.ready = false; this.gpu = null; }\n    if (E.current === this) E.current = null;\n  }\n  /**\n   * run the game for `seconds` of real time in exact fixed steps, at once, without requestAnimationFrame: tests, tools and\n   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n   * with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test\n  [c.x, c.vx] = smoothDamp(c.x, tx, c.vx, c.smooth, dt); [c.y, c.vy] = smoothDamp(c.y, ty, c.vy, c.smooth, dt);\n}\n// each step: the other players' inputs, a pause by any of them, a lost controller, and joining\nHOOKS.input.push((game, dt) => {\n  const P = game._players; if (!P || (P.length < 2 && !game._join)) return;\n  for (const q of P.slice(1)) {\n    if (q.padLost) { game._autoPause('controller'); game.note(q.name + ': CONTROLLER DISCONNECTED', 2.5); }\n    if (game.scene && game.scene.pausable && q.pressed('pause')) { game.paused = !game.paused; game.pauseReason = game.paused ? 'player' : null; game.pausedBy = q.player; game.audio.sfx('pause'); q.consumeAll(); }\n  }\n  const I = P[0], was = game._p1 || [I.lastDevice, I.padIndex, I.aimSource]; game._p1 = [I.lastDevice, I.padIndex, I.aimSource];\n  if (I.pressed('pause')) game.pausedBy = 1;\n  const J = game._join; if (!J || P.length >= J.max || game.paused) return;\n  if (game._lobby) { game._lobby.tick(dt); if (game._lobby.pressed('join') && !P.some(q => q.half === 'right') && I.lastDevice !== 'gamepad') game.addPlayer({ keys: 'right' }); }\n  let pads = []; try { pads = navigator.getGamepads ? Array.from(navigator.getGamepads() || []) : []; } catch (e) { /* gamepads blocked */ }\n  for (const p of pads) {   // Start on a pad no one holds: player 1's own once it plays on it (the press that just woke it joins)\n    if (!p || p.connected === false || P.some(q => q.pad === p.index) || (was[0] === 'gamepad' && was[1] === p.index)) continue;\n    const on = !!(p.buttons[9] && p.buttons[9].pressed), prev = (game._joinPrev || (game._joinPrev = {}))[p.index]; game._joinPrev[p.index] = on;\n    if (!on || prev || P.length >= J.max || (p.buttons[8] && p.buttons[8].pressed)) continue;   // (Create + Options is the host's)\n    if (I.padIndex === p.index) { I.consumeAll(); [I.lastDevice, , I.aimSource] = was; game._p1 = was; }   // (that Start was the joiner's: player 1 neither pauses nor turns to the pad)\n    game.addPlayer({ pad: p.index });\n  }\n});\nHOOKS.enter.push(game => {   // a scene's start: the others take its keys too (a half each where they share the keyboard); a split ends\n  game._split = null; const P = game._players; if (!P || P.length < 2) return;\n  const I = P[0]; if (I.half && game.scene && game.scene.input) { I._full = I.preset; I.use(Input.halfKeys(I._full, 'left')); }\n  for (const q of P.slice(1)) q.use(_pPreset(game, q));\n});\nHOOKS.step.push((game, dt) => { if (game._split) for (const v of game._split.vps) _vpCam(game, v, dt); });\n// a split screen's frame: the scene drawn in each viewport (its own camera, lights and overlays, clipped to it), then\n// the dividers, the scene's hud(r) over the whole screen and the frame's own overlays (notes, pause, fades)\nHOOKS.frame = (game, shx, shy) => {\n  const r = game.r, sc = game.scene, S = game._split; _vpLayout(game);\n  for (const v of S.vps) {\n    if (v.cam.x === undefined) _vpCam(game, v, 0);\n    game.lights._clear(); r._begin(v.cam.x + shx - v.x, v.cam.y + shy - v.y, v); r.viewport = v;\n    if (sc && sc.draw) sc.draw(r);\n    r._finish();\n  }\n  r.viewport = null; r._items.length = 0; r._decals.length = 0; r._overlays.length = 0; r._only = true;\n9387:.esh-sh{position:absolute;inset:0;display:grid;place-items:center;background:#04060acc;pointer-events:auto;padding:calc(var(--pt) + 46px) var(--pr) var(--pb) var(--pl);animation:esh-in .25s;touch-acti [... omitted end of long line]\n9392:.esh-ttl{place-items:center start;background:linear-gradient(90deg,#04060aee,#04060a99 50%,#04060a00 85%)}.esh-ttl>div{max-width:min(520px,92vw);padding-left:4vw}\n9393:.esh-ttl h1{font-size:clamp(44px,10vw,92px);letter-spacing:.07em}.esh-sub{font:italic 