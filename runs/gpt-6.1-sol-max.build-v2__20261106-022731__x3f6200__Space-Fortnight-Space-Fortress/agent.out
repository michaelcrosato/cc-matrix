{"type":"item.completed","item":{"id":"item_37","type":"agent_message","text":"The engine provides the rendering, animation, input, menu, and audio systems this needs. I’m building the combat as a deterministic simulation beneath them so browser play, attract mode, tests, and the Hub host all use the same rules.\n"}}
{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > src/data/balance.js <<'EOF'\n(function (S) {\n  'use strict';\n  const W = 960, H = 540, DT = 1 / 120;\n  const BOUNDS = { x0: 30, x1: 930, y0: 88, y1: 467 };\n  const BALANCE_SPEC = [\n    ['thrust', 'Thrust', 620, 200, 1100, 20, ' u/s²'],\n    ['drag', 'Flight drag', 3.7, .4, 7, .1, ' /s'],\n    ['laserDamage', 'Laser damage', 10, 2, 24, 1, ' HP'],\n    ['laserCadence', 'Laser interval', .17, .08, .5, .01, ' s'],\n    ['boostRecharge', 'Boost recovery', 13, 2, 40, 1, ' /s'],\n    ['pulseCooldown', 'Pulse recharge', 6, 1, 15, .5, ' s'],\n    ['aggression', 'Enemy pressure', 1, .25, 3, .05, ' ×'],\n    ['gravity', 'Gravity pull', 160, 20, 420, 10, ' u/s²'],\n    ['heatHit', 'Heat per impact', 9, 2, 24, 1, '%'],\n    ['cooling', 'Radiator cooling', 2.3, .3, 6, .1, '%/s'],\n    ['baseDamage', 'Ground impact', 6, 1, 18, 1, ' HP'],\n  ];\n  const DEFAULTS = Object.fromEntries(BALANCE_SPEC.map(([key, , value]) => [key, value]));\n  const ENEMIES = {\n    hunter: { label: 'Needle hunter', hp: 20, r: 13, score: 120, speed: 33, color: '#f89c83' },\n    bomber: { label: 'Coffin bomber', hp: 50, r: 23, score: 260, speed: 22, color: '#e9ac56' },\n    scout: { label: 'Anchor scout', hp: 30, r: 15, score: 180, speed: 30, color: '#c49aff' },\n    anchor: { label: 'Gravity anchor', hp: 34, r: 15, score: 300, speed: 0, color: '#bd9cff' },\n    rammer: { label: 'Anvil rammer', hp: 30, r: 15, score: 190, speed: 38, color: '#f87967' },\n    tractor: { label: 'Fork tractor', hp: 52, r: 22, score: 330, speed: 25, color: '#b5a1ef' },\n    dive: { label: 'Kite diver', hp: 20, r: 13, score: 140, speed: 48, color: '#f7c078' },\n    relay: { label: 'Siege relay', hp: 95, r: 21, score: 600, speed: 0, color: '#ef8b9c' },\n  };\n  const UPGRADES = [\n    { id: 'laser', title: 'LANCE ARRAY', stat: '+30% laser damage', text: 'A tighter beam. A shorter argument.', icon: '01' },\n    { id: 'boost', title: 'DEEP RESERVE', stat: '+50 boost capacity', text: 'More room to outrun a bad decision.', icon: '02' },\n    { id: 'pulse', title: 'QUICK DISCHARGE', stat: '25% faster pulse', text: 'Clear the lane. Catch your breath.', icon: '03' },\n  ];\n  const RANKS = [[70000, 'STAR MARSHAL'], [46000, 'COMMODORE'], [28000, 'WING COMMANDER'], [14000, 'CAPTAIN'], [6000, 'LIEUTENANT'], [0, 'CADET']];\n  Object.assign(S, { W, H, DT, BOUNDS, BALANCE_SPEC, DEFAULTS, ENEMIES, UPGRADES, RANKS });\n})(globalThis.Fortnight = globalThis.Fortnight || {});\nEOF\ncat > src/data/encounters.js <<'EOF'\n(function (S) {\n  'use strict';\n  // Every group has an authored entrance, recovery gap and explicit completion goal.\n  const group = (at, kind, count, side = 'top', pattern = 'fan') => ({ at, kind, count, side, pattern });\n  const WAVES = [\n    { act: 0, title: 'OPEN THE CORRIDOR', min: 60, deadline: 74, goal: 9,\n      radio: 'Viper wing, this is Fortress 13. Make them regret the journey.',\n      lesson: 'Thrust to move. Aim and hold fire. Your engines drift; your laser does not.',\n      groups: [group(3,'hunter',2),group(17,'hunter',3,'left'),group(33,'hunter',3,'right'),group(47,'hunter',3)] },\n    { act: 0, title: 'CUT THE BOMB RUN', min: 62, deadline: 77, goal: 10,\n      radio: 'Bomb bays opening. Read the amber lanes. Do not be in them.',\n      lesson: 'Wide ships mark bomb lanes. Intercept them before release. Boost crosses danger.',\n      groups: [group(2,'bomber',1),group(15,'hunter',3,'left'),group(28,'bomber',2),group(44,'scout',1,'right'),group(51,'hunter',3)] },\n    { act: 0, title: 'BREAK THE ESCORT', min: 65, deadline: 80, goal: 11,\n      radio: 'Gravity anchors\"'! Break their hearts and take the charge.'\"',\n      lesson: 'Purple rings pull inward. Destroy anchors for charge. Pulse breaks nearby fire.',\n      groups: [group(2,'scout',2),group(16,'hunter',4,'right'),group(30,'bomber',2),group(44,'relay',2),group(53,'hunter',3,'left')] },\n    { act: 1, title: 'KEEP THE RADIATORS CLEAR', min: 67, deadline: 80, goal: 12,\n      radio: 'Fortress at combat range. Those wedges mean to ram us. Cut them down.',\n      lesson: 'HEAT rises when the fortress is hit. Clear attackers; radiators cool after 3 quiet seconds.',\n      groups: [group(3,'rammer',2),group(16,'rammer',3,'left'),group(31,'hunter',3,'right'),group(44,'bomber',2),group(54,'rammer',4,'bottom')] },\n    { act: 1, title: 'BREAK THE LOCK', min: 67, deadline: 81, goal: 12,\n      radio: 'Tractor forks acquiring. Shoot the emitter. Let the fortress breathe.',\n      lesson: 'A solid purple tether locks a radiator. Kill its tractor. Pulse breaks your own lock.',\n      groups: [group(2,'tractor',1),group(16,'rammer',3,'left'),group(29,'tractor',2,'right'),group(41,'scout',1),group(48,'bomber',2),group(56,'hunter',3,'left')] },\n    { act: 1, title: 'HOLD FOR EVACUATION', min: 69, deadline: 84, goal: 13,\n      radio: 'Transports away. Cut the two shield relays, then fall back to the surface.',\n      lesson: 'Destroy the red relay cores. Protect the fortress until the evacuation is complete.',\n      groups: [group(2,'relay',2),group(12,'rammer',4,'left'),group(25,'tractor',1,'right'),group(36,'bomber',2),group(48,'scout',2),group(58,'rammer',3,'bottom')] },\n    { act: 2, title: 'DOCK. LOCK. HOLD.', min: 45, deadline: 58, goal: 11,\n      radio: 'Vipers docked. You are the last guns on the ground. Make every shot count.',\n      lesson: 'SIDE VIEW. Move left and right on the rail. Aim upward. Stop the dives before touchdown.',\n      groups: [group(3,'dive',4),group(16,'dive',5,'top','vee'),group(30,'hunter',2),group(38,'dive',4)] },\n    { act: 2, title: 'NO GROUND TO GIVE', min: 48, deadline: 60, goal: 13,\n      radio: 'Same sky. Fewer places to hide. Clear a gap and hold it.',\n      lesson: 'Bomb lanes and gravity return. Your pulse clears a local pocket; it cannot save the whole base.',\n      groups: [group(2,'bomber',2),group(12,'dive',5,'top','vee'),group(23,'scout',2),group(35,'dive',5),group(42,'tractor',1)] },\n    { act: 2, title: 'THE LONG SHADOW', min: 45, deadline: 59, goal: 12,\n      radio: 'The siege ship is descending. Strip the screen. Then aim for its guns.',\n      lesson: 'One last screen before the siege ship. The ground base must survive.',\n      groups: [group(2,'dive',5),group(12,'bomber',2),group(24,'scout',1),group(34,'dive',5,'top','vee'),group(40,'hunter',2)] },\n  ];\n  const ACTS = [\n    { name: 'OUTER PERIMETER', code: 'I', objective: 'BREAK THE ESCORT SCREEN', color: '#8ae5dc' },\n    { name: 'FORTRESS ORBIT', code: 'II', objective: 'HOLD THE EVACUATION LINE', color: '#eec580' },\n    { name: 'THE GROUND LINE', code: 'III', objective: 'DEFEND THE LAST BASE', color: '#f69a86' },\n  ];\n  function validateWaves(waves = WAVES) {\n    const errors = [];\n    waves.forEach((w,i) => {\n      if (\"'!Number.isInteger(w.act) || w.act < 0 || w.act > 2) errors.push(`Wave ${i}: act`);\n      if (!(w.min > 0 && w.deadline > w.min && w.goal > 0)) errors.push(`Wave ${i}: progression`);\n      let at = -1;\n      for (const g of w.groups) {\n        if (!S.ENEMIES[g.kind]) errors.push(`Wave ${i}: unknown ${g.kind}`);\n        if (g.at < at || g.at >= w.min || g.count < 1 || g.count > 8) errors.push(`Wave ${i}: group timing/count`);\n        if (!['\"'top','bottom','left','right'].includes(g.side)) errors.push(\"'`Wave ${i}: entry`);\n        at = g.at;\n      }\n    });\n    return errors;\n  }\n  Object.assign(S, { WAVES, ACTS, validateWaves });\n})(globalThis.Fortnight);\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > src/data/balance.js <<'EOF'\n(function (S) {\n  'use strict';\n  const W = 960, H = 540, DT = 1 / 120;\n  const BOUNDS = { x0: 30, x1: 930, y0: 88, y1: 467 };\n  const BALANCE_SPEC = [\n    ['thrust', 'Thrust', 620, 200, 1100, 20, ' u/s²'],\n    ['drag', 'Flight drag', 3.7, .4, 7, .1, ' /s'],\n    ['laserDamage', 'Laser damage', 10, 2, 24, 1, ' HP'],\n    ['laserCadence', 'Laser interval', .17, .08, .5, .01, ' s'],\n    ['boostRecharge', 'Boost recovery', 13, 2, 40, 1, ' /s'],\n    ['pulseCooldown', 'Pulse recharge', 6, 1, 15, .5, ' s'],\n    ['aggression', 'Enemy pressure', 1, .25, 3, .05, ' ×'],\n    ['gravity', 'Gravity pull', 160, 20, 420, 10, ' u/s²'],\n    ['heatHit', 'Heat per impact', 9, 2, 24, 1, '%'],\n    ['cooling', 'Radiator cooling', 2.3, .3, 6, .1, '%/s'],\n    ['baseDamage', 'Ground impact', 6, 1, 18, 1, ' HP'],\n  ];\n  const DEFAULTS = Object.fromEntries(BALANCE_SPEC.map(([key, , value]) => [key, value]));\n  const ENEMIES = {\n    hunter: { label: 'Needle hunter', hp: 20, r: 13, score: 120, speed: 33, color: '#f89c83' },\n    bomber: { label: 'Coffin bomber', hp: 50, r: 23, score: 260, speed: 22, color: '#e9ac56' },\n    scout: { label: 'Anchor scout', hp: 30, r: 15, score: 180, speed: 30, color: '#c49aff' },\n    anchor: { label: 'Gravity anchor', hp: 34, r: 15, score: 300, speed: 0, color: '#bd9cff' },\n    rammer: { label: 'Anvil rammer', hp: 30, r: 15, score: 190, speed: 38, color: '#f87967' },\n    tractor: { label: 'Fork tractor', hp: 52, r: 22, score: 330, speed: 25, color: '#b5a1ef' },\n    dive: { label: 'Kite diver', hp: 20, r: 13, score: 140, speed: 48, color: '#f7c078' },\n    relay: { label: 'Siege relay', hp: 95, r: 21, score: 600, speed: 0, color: '#ef8b9c' },\n  };\n  const UPGRADES = [\n    { id: 'laser', title: 'LANCE ARRAY', stat: '+30% laser damage', text: 'A tighter beam. A shorter argument.', icon: '01' },\n    { id: 'boost', title: 'DEEP RESERVE', stat: '+50 boost capacity', text: 'More room to outrun a bad decision.', icon: '02' },\n    { id: 'pulse', title: 'QUICK DISCHARGE', stat: '25% faster pulse', text: 'Clear the lane. Catch your breath.', icon: '03' },\n  ];\n  const RANKS = [[70000, 'STAR MARSHAL'], [46000, 'COMMODORE'], [28000, 'WING COMMANDER'], [14000, 'CAPTAIN'], [6000, 'LIEUTENANT'], [0, 'CADET']];\n  Object.assign(S, { W, H, DT, BOUNDS, BALANCE_SPEC, DEFAULTS, ENEMIES, UPGRADES, RANKS });\n})(globalThis.Fortnight = globalThis.Fortnight || {});\nEOF\ncat > src/data/encounters.js <<'EOF'\n(function (S) {\n  'use strict';\n  // Every group has an authored entrance, recovery gap and explicit completion goal.\n  const group = (at, kind, count, side = 'top', pattern = 'fan') => ({ at, kind, count, side, pattern });\n  const WAVES = [\n    { act: 0, title: 'OPEN THE CORRIDOR', min: 60, deadline: 74, goal: 9,\n      radio: 'Viper wing, this is Fortress 13. Make them regret the journey.',\n      lesson: 'Thrust to move. Aim and hold fire. Your engines drift; your laser does not.',\n      groups: [group(3,'hunter',2),group(17,'hunter',3,'left'),group(33,'hunter',3,'right'),group(47,'hunter',3)] },\n    { act: 0, title: 'CUT THE BOMB RUN', min: 62, deadline: 77, goal: 10,\n      radio: 'Bomb bays opening. Read the amber lanes. Do not be in them.',\n      lesson: 'Wide ships mark bomb lanes. Intercept them before release. Boost crosses danger.',\n      groups: [group(2,'bomber',1),group(15,'hunter',3,'left'),group(28,'bomber',2),group(44,'scout',1,'right'),group(51,'hunter',3)] },\n    { act: 0, title: 'BREAK THE ESCORT', min: 65, deadline: 80, goal: 11,\n      radio: 'Gravity anchors\"'! Break their hearts and take the charge.'\"',\n      lesson: 'Purple rings pull inward. Destroy anchors for charge. Pulse breaks nearby fire.',\n      groups: [group(2,'scout',2),group(16,'hunter',4,'right'),group(30,'bomber',2),group(44,'relay',2),group(53,'hunter',3,'left')] },\n    { act: 1, title: 'KEEP THE RADIATORS CLEAR', min: 67, deadline: 80, goal: 12,\n      radio: 'Fortress at combat range. Those wedges mean to ram us. Cut them down.',\n      lesson: 'HEAT rises when the fortress is hit. Clear attackers; radiators cool after 3 quiet seconds.',\n      groups: [group(3,'rammer',2),group(16,'rammer',3,'left'),group(31,'hunter',3,'right'),group(44,'bomber',2),group(54,'rammer',4,'bottom')] },\n    { act: 1, title: 'BREAK THE LOCK', min: 67, deadline: 81, goal: 12,\n      radio: 'Tractor forks acquiring. Shoot the emitter. Let the fortress breathe.',\n      lesson: 'A solid purple tether locks a radiator. Kill its tractor. Pulse breaks your own lock.',\n      groups: [group(2,'tractor',1),group(16,'rammer',3,'left'),group(29,'tractor',2,'right'),group(41,'scout',1),group(48,'bomber',2),group(56,'hunter',3,'left')] },\n    { act: 1, title: 'HOLD FOR EVACUATION', min: 69, deadline: 84, goal: 13,\n      radio: 'Transports away. Cut the two shield relays, then fall back to the surface.',\n      lesson: 'Destroy the red relay cores. Protect the fortress until the evacuation is complete.',\n      groups: [group(2,'relay',2),group(12,'rammer',4,'left'),group(25,'tractor',1,'right'),group(36,'bomber',2),group(48,'scout',2),group(58,'rammer',3,'bottom')] },\n    { act: 2, title: 'DOCK. LOCK. HOLD.', min: 45, deadline: 58, goal: 11,\n      radio: 'Vipers docked. You are the last guns on the ground. Make every shot count.',\n      lesson: 'SIDE VIEW. Move left and right on the rail. Aim upward. Stop the dives before touchdown.',\n      groups: [group(3,'dive',4),group(16,'dive',5,'top','vee'),group(30,'hunter',2),group(38,'dive',4)] },\n    { act: 2, title: 'NO GROUND TO GIVE', min: 48, deadline: 60, goal: 13,\n      radio: 'Same sky. Fewer places to hide. Clear a gap and hold it.',\n      lesson: 'Bomb lanes and gravity return. Your pulse clears a local pocket; it cannot save the whole base.',\n      groups: [group(2,'bomber',2),group(12,'dive',5,'top','vee'),group(23,'scout',2),group(35,'dive',5),group(42,'tractor',1)] },\n    { act: 2, title: 'THE LONG SHADOW', min: 45, deadline: 59, goal: 12,\n      radio: 'The siege ship is descending. Strip the screen. Then aim for its guns.',\n      lesson: 'One last screen before the siege ship. The ground base must survive.',\n      groups: [group(2,'dive',5),group(12,'bomber',2),group(24,'scout',1),group(34,'dive',5,'top','vee'),group(40,'hunter',2)] },\n  ];\n  const ACTS = [\n    { name: 'OUTER PERIMETER', code: 'I', objective: 'BREAK THE ESCORT SCREEN', color: '#8ae5dc' },\n    { name: 'FORTRESS ORBIT', code: 'II', objective: 'HOLD THE EVACUATION LINE', color: '#eec580' },\n    { name: 'THE GROUND LINE', code: 'III', objective: 'DEFEND THE LAST BASE', color: '#f69a86' },\n  ];\n  function validateWaves(waves = WAVES) {\n    const errors = [];\n    waves.forEach((w,i) => {\n      if (\"'!Number.isInteger(w.act) || w.act < 0 || w.act > 2) errors.push(`Wave ${i}: act`);\n      if (!(w.min > 0 && w.deadline > w.min && w.goal > 0)) errors.push(`Wave ${i}: progression`);\n      let at = -1;\n      for (const g of w.groups) {\n        if (!S.ENEMIES[g.kind]) errors.push(`Wave ${i}: unknown ${g.kind}`);\n        if (g.at < at || g.at >= w.min || g.count < 1 || g.count > 8) errors.push(`Wave ${i}: group timing/count`);\n        if (!['\"'top','bottom','left','right'].includes(g.side)) errors.push(\"'`Wave ${i}: entry`);\n        at = g.at;\n      }\n    });\n    return errors;\n  }\n  Object.assign(S, { WAVES, ACTS, validateWaves });\n})(globalThis.Fortnight);\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim/world.js <<'EOF'\n(function (S) {\n  'use strict';\n  const { W, H, DT, BOUNDS: B, DEFAULTS, ENEMIES, WAVES, RANKS } = S;\n  const clamp = (n, a, b) => Math.max(a, Math.min(b, n));\n  const dist = (a,b) => Math.hypot(a.x-b.x,a.y-b.y);\n  const norm = (x,y) => { const d = Math.hypot(x,y); return d > 1 ? [x/d,y/d] : [x,y]; };\n  const aimAt = (a,b) => Math.atan2(b.y-a.y,b.x-a.x);\n  const groundAim = a => clamp(a > 0 ? a - Math.PI * 2 : a, -Math.PI + .15, -.15);\n  function segmentCircle(x0,y0,x1,y1,c,r) {\n    const dx=x1-x0, dy=y1-y0, den=dx*dx+dy*dy;\n    const t=den ? clamp(((c.x-x0)*dx+(c.y-y0)*dy)/den,0,1) : 0;\n    return (x0+dx*t-c.x)**2+(y0+dy*t-c.y)**2 <= r*r ? t : Infinity;\n  }\n  const neutral = seq => ({ seq, mx:0,my:0,ax:0,ay:-1,fire:false,boost:false,pulse:false });\n  class World {\n    constructor(opts={}) {\n      const seed=Number(opts.seed ?? 198113)>>>0;\n      this.s = {\n        version:1, epoch:opts.epoch || 1, seed, rng:seed || 1, tick:0, t:0, activeTime:0,\n        phase:'briefing', phaseTime:3.5, act:0, wave:0, waveTime:0, group:0, waveKills:0,\n        score:0, chain:0, multiplier:1, lastKill:-20, nextId:1, eventSeq:0,\n        heat:0, base:100, lastObjectiveHit:-10, locks:[false,false,false,false],\n        outcomes:[], waveOutcomes:[], upgrades:0, players:[], enemies:[], shots:[], drops:[], effects:[],\n        boss:null, seen:[], bossPhases:[], result:null, modified:false, demo:\"'!!opts.demo,\n        balance:{...DEFAULTS,...opts.balance}, options:{god:!!opts.demo, overlays:false},\n        radio:'\"'Viper wing, this is Fortress 13. Make them regret the journey.', radioUntil:8,\n        limit: Number.isFinite(opts.limit) ? opts.limit : 780, events:[],\n      };\n      this.intents = new Map();\n      for (const [i,seat] of (opts.players || [{id:0,name:'VIPER 01',color:'#8ae5dc'}]).entries()) {\n        this.s.players.push({id:seat.id,name:String(seat.name).slice(0,32),color:seat.color || ['#8ae5dc','#efbc6e','#ec9fbd','#b7d98c'][i],\n          x:360+i*72,y:385,vx:0,vy:0,a:-Math.PI/2,hp:0,maxHp:0,energy:100,maxEnergy:100,\n          pulse:0,boost:0,boostCool:0,cool:0,inv:3,dead:0,gone:false,seq:-1,kills:0,damage:0,\n          upgrades:{laser:0,boost:0,pulse:0},choice:null,thrust:0,recoil:0,pulseFx:0,hit:0});\n      }\n      const n=this.s.players.length;\n      for (const p of this.s.players) p.hp=p.maxHp=n===1 ? 9 : 6;\n      this.emit('briefing',0,480,270);\n    }\n    random() { let a=this.s.rng=(this.s.rng+0x6d2b79f5)>>>0; a=Math.imul(a\"'^(a>>>15),a|1); a''^=a+Math.imul(a''^(a>>>7),a|61); return ((a''^(a>>>14))>>>0)/4294967296; }\n    emit(type,owner=0,x=480,y=270,value=0) {\n      const s=this.s, e={id:++s.eventSeq,type,owner,x,y,value,tick:s.tick};\n      s.events.push(e); if (s.events.length>96) s.events.shift(); return e;\n    }\n    say(text,seconds=6) { this.s.radio=text; this.s.radioUntil=this.s.t+seconds; this.emit('\"'radio'); }\n    setIntent(id,input) {\n      const s=this.s,p=s.players.find(p=>p.id===id&&\"'!p.gone);\n      if (!p || !input || !Number.isSafeInteger(input.seq) || input.seq<=p.seq) return false;\n      for (const k of ['\"'mx','my','ax','ay']) if (\"'!Number.isFinite(input[k]) || Math.abs(input[k])>1.001) return false;\n      if (Math.hypot(input.mx,input.my)>1.015 || Math.hypot(input.ax,input.ay)>1.015) return false;\n      const [mx,my]=norm(input.mx,input.my),[ax,ay]=norm(input.ax,input.ay);\n      p.seq=input.seq;\n      this.intents.set(id,{seq:input.seq,mx,my,ax,ay,fire:input.fire===true,boost:input.boost===true,pulse:input.pulse===true,tick:s.tick});\n      return true;\n    }\n    clearInput() { this.intents.clear(); }\n    leave(id) { const p=this.s.players.find(p=>p.id===id); if (p) {p.gone=true;p.hp=0;} this.intents.delete(id); }\n    balance(key,value) {\n      const spec=S.BALANCE_SPEC.find(v=>v[0]===key); if (!spec || !Number.isFinite(value)) return false;\n      this.s.balance[key]=clamp(value,spec[3],spec[4]); this.s.modified=true; return true;\n    }\n    resetBalance() { this.s.balance={...DEFAULTS}; this.s.modified=true; }\n    upgrade(id,choice) {\n      const s=this.s,p=s.players.find(p=>p.id===id&&!p.gone);\n      if (s.phase!=='\"'upgrade' || \"'!p || p.choice!==null || ![0,1,2].includes(choice)) return false;\n      p.choice=choice; const key=S.UPGRADES[choice].id; p.upgrades[key]++;\n      p.maxEnergy=100+50*p.upgrades.boost; p.energy=p.maxEnergy;\n      this.emit('\"'upgrade',id,p.x,p.y,choice); return true;\n    }\n    freshField() { const s=this.s; s.enemies=[];s.shots=[];s.drops=[];s.effects=[];s.locks=[false,false,false,false];this.clearInput(); }\n    waveStart(wave) {\n      const s=this.s; s.wave=wave;s.waveTime=0;s.group=0;s.waveKills=0;\n      const w=WAVES[wave]; if (\"'!w) return this.startBoss();\n      s.act=w.act;this.say(w.radio,8);this.emit('\"'wave',0,480,270,wave);\n    }\n    retreat(success,reason) {\n      const s=this.s;if (s.phase\"'!=='\"'play') return;\n      s.outcomes[s.act]={held:success,reason,score:success?1800:350};\n      this.addScore(success?1800:350);if (\"'!success) {s.multiplier=1;s.chain=0;s.score=Math.max(0,s.score-500);}\n      this.freshField();s.phase='\"'retreat';s.phaseTime=4.5;\n      this.say(success ? 'Line secured. Vipers, fall back by order. The fortress still stands.' : 'Emergency extraction\"'! Leave the line. We have one more place to stand.'\"',5);\n      this.emit('retreat',0,480,270,success?1:0);\n    }\n    enterAct(act) {\n      const s=this.s;s.act=act;s.phase='briefing';s.phaseTime=3.2;s.heat=act===1 ? (s.outcomes[0]?.held?4:20) : s.heat;\n      if (act===2) s.base=s.outcomes[1]?.held ? 100 : 76;\n      this.freshField();\n      for (const [i,p] of s.players.entries()) if (\"'!p.gone) {\n        p.x=360+i*72;p.y=act===2?457:395;p.vx=p.vy=0;p.a=-Math.PI/2;p.hp=p.maxHp;p.dead=0;p.inv=3;\n        p.energy=p.maxEnergy;p.pulse=0;p.boost=0;\n      }\n      s.wave=act*3;this.say(WAVES[s.wave].radio,7);this.emit('\"'dock',0,480,440,act);\n    }\n    addScore(amount) { this.s.score=Math.max(0,Math.floor(this.s.score+amount)); }\n    kill(e,owner=0) {\n      const s=this.s;if(e.hp<=0 || e.dead) return;\n      e.hp=0;e.dead=true;s.waveKills++;s.chain++;s.multiplier=Math.min(5,1+Math.floor(s.chain/5));s.lastKill=s.t;\n      this.addScore((ENEMIES[e.kind]?.score || 100)*s.multiplier);\n      const p=s.players.find(p=>p.id===owner);if(p)p.kills++;\n      s.effects.push({id:s.nextId++,kind:'blast',x:e.x,y:e.y,t:0,life:.75,size:e.r*1.8});\n      this.emit('kill',owner,e.x,e.y,e.kind==='anchor'?2:1);\n      if (e.kind==='anchor' || s.chain%4===0) s.drops.push({id:s.nextId++,x:e.x,y:e.y,t:0,life:12,charge:e.kind==='anchor',r:10});\n    }\n    damageEnemy(e,amount,owner) {\n      if(e.dead||e.hp<=0)return;\n      e.hit=.1;this.emit('hit',owner,e.x,e.y);\n      if (e.hp<=amount) this.kill(e,owner); else e.hp-=amount;\n    }\n    damagePlayer(p,amount=1) {\n      const s=this.s;if(p.hp<=0||p.inv>0||s.phase\"'!=='\"'play'||s.options.god)return false;\n      p.hp=Math.max(0,p.hp-amount);p.damage+=amount;p.inv=1.15;p.hit=.24;s.chain=0;s.multiplier=1;\n      this.addScore(-80);this.emit('hurt',p.id,p.x,p.y,p.hp);\n      if(p.hp<=0) {p.dead=3;this.emit('death',p.id,p.x,p.y);s.effects.push({id:s.nextId++,kind:'blast',x:p.x,y:p.y,t:0,life:1,size:35});}\n      return true;\n    }\n    objectiveHit(mult=1,x=480,y=277) {\n      const s=this.s;if(s.phase\"'!=='\"'play'||s.act===0)return;\n      if(s.act===1)s.heat=clamp(s.heat+s.balance.heatHit*mult,0,100);\n      else s.base=Math.max(0,s.base-s.balance.baseDamage*mult);\n      s.lastObjectiveHit=s.t;this.emit('objective',0,x,y,mult);\n    }\n    spawn(kind,x,y,opts={}) {\n      const s=this.s,d=ENEMIES[kind];if(\"'!d)throw Error(`Unknown enemy: ${kind}`);\n      const scale=1+Math.max(0,s.players.filter(p=>!p.gone).length-1)*.3;\n      const e={id:s.nextId++,kind,x,y,homeX:x,homeY:y,vx:0,vy:0,hp:d.hp*scale,maxHp:d.hp*scale,r:d.r,\n        age:0,tele:opts.tele ?? 1.35,cycle:0,wind:0,cool:1.8+this.random(),a:Math.PI/2,target:-1,lock:-1,\n        hit:0,dead:false,lane:x,launched:false,seed:this.random()*6.28,...opts};\n      if(kind==='\"'anchor') {e.charge=2.7;e.cool=3;e.tele=.55;}\n      if(kind==='relay'){e.y=e.homeY=140;e.tele=2;}\n      s.enemies.push(e);if(\"'!s.seen.includes(kind))s.seen.push(kind);this.emit('\"'spawn',0,x,y);\n      return e;\n    }\n    spawnGroup(g) {\n      const s=this.s,n=s.players.filter(p=>\"'!p.gone).length;\n      const count=Math.min(10,g.count+Math.floor((n-1)*g.count*.22));\n      for(let i=0;i<count;i++) {\n        const frac=(i+1)/(count+1);let x=110+frac*740+(this.random()-.5)*28,y=105;\n        if(g.side==='\"'left'){x=48;y=115+frac*300;}\n        if(g.side==='right'){x=912;y=115+frac*300;}\n        if(g.side==='bottom'){x=120+frac*720;y=448;}\n        if(s.act===2){y=105+(g.pattern==='vee'?Math.abs(i-(count-1)/2)*16:0);}\n        const nearby=s.players.find(p=>p.hp>0&&Math.hypot(p.x-x,p.y-y)<110);\n        if(nearby){x=nearby.x<480?Math.max(nearby.x+140,x):Math.min(nearby.x-140,x);x=clamp(x,48,912);}\n        this.spawn(g.kind,x,y,{seed:i*.5+this.random(),tele:1.35+i*.13});\n      }\n    }\n    shot(x,y,a,speed,foe,owner=0,opts={}) {\n      const s=this.s;\n      s.shots.push({id:s.nextId++,x,y,px:x,py:y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,\n        life:foe?5:1.5,r:foe?4:2,foe,owner,dmg:foe?1:s.balance.laserDamage,...opts});\n    }\n    firePlayer(p) {\n      const s=this.s;\n      this.shot(p.x+Math.cos(p.a)*21,p.y+Math.sin(p.a)*21,p.a,730,false,p.id,{dmg:s.balance.laserDamage*(1+.3*p.upgrades.laser)});\n      p.cool=s.balance.laserCadence;p.recoil=.08;this.emit('shot',p.id,p.x,p.y);\n    }\n    pulsePlayer(p) {\n      const s=this.s;p.pulse=s.balance.pulseCooldown*Math.pow(.75,p.upgrades.pulse);p.pulseFx=.55;\n      s.shots=s.shots.filter(b=>\"'!b.foe||dist(b,p)>130);\n      for(const e of s.enemies)if(dist(e,p)<145){\n        if(e.kind==='\"'tractor'){e.wind=0;e.cool=3.5;e.target=-1;e.lock=-1;}\n        const a=aimAt(p,e);e.x=clamp(e.x+Math.cos(a)*28,25,935);e.y=clamp(e.y+Math.sin(a)*28,90,466);\n      }\n      p.inv=Math.max(p.inv,.4);s.effects.push({id:s.nextId++,kind:'pulse',x:p.x,y:p.y,t:0,life:.55,size:130});\n      this.emit('pulse',p.id,p.x,p.y);\n    }\n    stepPlayers(dt) {\n      const s=this.s,b=s.balance;\n      for(const p of s.players) {\n        if(p.gone)continue;\n        p.inv=Math.max(0,p.inv-dt);p.cool-=dt;p.pulse=Math.max(0,p.pulse-dt);p.boostCool-=dt;\n        p.recoil=Math.max(0,p.recoil-dt);p.pulseFx=Math.max(0,p.pulseFx-dt);p.hit=Math.max(0,p.hit-dt);\n        if(p.hp<=0){\n          if((p.dead-=dt)<=0&&s.players.some(q=>\"'!q.gone&&q.hp>0)) {\n            p.hp=p.maxHp;p.x=480;p.y=s.act===2?457:405;p.vx=p.vy=0;p.inv=3;p.energy=p.maxEnergy;\n            this.addScore(-300);s.chain=0;s.multiplier=1;this.emit('\"'redeploy',p.id,p.x,p.y);\n          }\n          continue;\n        }\n        const it=this.intents.get(p.id),I=it&&s.tick-it.tick<60?it:neutral(p.seq);\n        let [mx,my]=[I.mx,s.act===2?0:I.my];p.thrust=Math.hypot(mx,my);\n        if(Math.hypot(I.ax,I.ay)>.2){p.a=Math.atan2(I.ay,I.ax);if(s.act===2)p.a=groundAim(p.a);}\n        if(I.boost&&p.energy>=28&&p.boostCool<=0){\n          const a=Math.hypot(mx,my)>.1?Math.atan2(my,mx):p.a;\n          p.vx=Math.cos(a)*440;p.vy=s.act===2?0:Math.sin(a)*440;p.energy-=28;p.boost=.24;p.boostCool=.9;p.inv=Math.max(p.inv,.28);\n          this.emit('boost',p.id,p.x,p.y);\n        }\n        p.energy=Math.min(p.maxEnergy,p.energy+b.boostRecharge*dt);\n        p.boost=Math.max(0,p.boost-dt);\n        if(p.boost<=0){p.vx+=mx*b.thrust*dt;p.vy+=my*b.thrust*dt;const drag=Math.exp(-b.drag*dt);p.vx*=drag;p.vy*=drag;}\n        const cap=p.boost>0?460:210,sp=Math.hypot(p.vx,p.vy);if(sp>cap){p.vx*=cap/sp;p.vy*=cap/sp;}\n        p.x=clamp(p.x+p.vx*dt,B.x0,B.x1);p.y=s.act===2?457:clamp(p.y+p.vy*dt,B.y0,B.y1);\n        if(s.act===1){const dx=p.x-480,dy=p.y-277,d=Math.hypot(dx,dy);if(d<76){p.x=480+dx/(d||1)*76;p.y=277+dy/(d||1)*76;p.vx*=.7;p.vy*=.7;}}\n        if(I.fire&&p.cool<=0)this.firePlayer(p);\n        if(I.pulse&&p.pulse<=0)this.pulsePlayer(p);\n      }\n    }\n    closestPlayer(e) {\n      let best=null,d=Infinity;for(const p of this.s.players)if(\"'!p.gone&&p.hp>0){const v=dist(e,p);if(v<d){d=v;best=p;}}return best;\n    }\n    stepEnemies(dt) {\n      const s=this.s,b=s.balance,add=[];s.locks=[false,false,false,false];\n      for(const e of s.enemies){\n        if(e.hp<=0||e.dead)continue;\n        e.age+=dt;e.hit=Math.max(0,e.hit-dt);\n        if(e.tele>0){e.tele-=dt;continue;}\n        const p=this.closestPlayer(e);if(!p)continue;\n        e.cool-=dt;const ag=b.aggression;const a=aimAt(e,p);e.a=a;\n        if(e.kind==='\"'hunter'){\n          e.x=clamp(e.homeX+Math.sin(e.age*.64+e.seed)*55,35,925);\n          e.y=clamp(e.homeY+Math.sin(e.age*.47+e.seed)*26+(s.act===2?24:0),99,436);\n          if(e.cool<=0){e.wind=.7;e.cool=3.6/ag; e.lane=p.x;e.target=p.id;this.emit('aim',0,e.x,e.y);}\n          if(e.wind>0&&(e.wind-=dt)<=0){const target=s.players.find(q=>q.id===e.target)||p;\n            const ang=aimAt(e,target);for(let k=-1;k<=1;k++)this.shot(e.x,e.y,ang+k*.12,112+8*ag,true,0,{r:3.5});}\n        }else if(e.kind==='bomber'){\n          e.x=clamp(e.homeX+Math.sin(e.age*.28+e.seed)*65,45,915);\n          e.y=e.homeY+Math.sin(e.age*.9)*8;\n          if(e.cool<=0){e.wind=1.65;e.cool=6.8/ag;e.lane=s.act===1?480:p.x;this.emit('warning',0,e.lane,440);}\n          if(e.wind>0&&(e.wind-=dt)<=0){\n            const target={x:e.lane,y:s.act===1?277:510};\n            this.shot(e.x,e.y,aimAt(e,target),85,true,0,{r:8,bomb:true,obj:true,dmg:2});\n          }\n        }else if(e.kind==='scout'){\n          e.x=clamp(e.homeX+Math.sin(e.age*.48+e.seed)*90,45,915);e.y=e.homeY+Math.cos(e.age*.7)*14;\n          if(e.cool<=0){e.cool=11;const x=s.act===2?clamp(p.x+(this.random()-.5)*120,80,880):clamp(p.x+(this.random()-.5)*160,75,885);\n            add.push({kind:'anchor',x,y:s.act===2?310:clamp(p.y-45,160,385)});this.emit('gravity',0,x,p.y);}\n        }else if(e.kind==='anchor'){\n          e.charge=Math.max(0,e.charge-dt);\n          if(e.charge<=0){for(const q of s.players)if(q.hp>0&&\"'!q.gone){const d=dist(e,q);if(d<180&&d>8){\n            const force=b.gravity*(1-d/230);q.vx+=(e.x-q.x)/d*force*dt;if(s.act!==2)q.vy+=(e.y-q.y)/d*force*dt;\n            if(d<27)this.damagePlayer(q);\n          }}\n          if(e.cool<=0){e.cool=3.4;for(let k=0;k<8;k++)this.shot(e.x,e.y,k*Math.PI/4+e.age*.1,65,true,0,{r:3});}}\n        }else if(e.kind==='\"'rammer'){\n          if(\"'!e.launched){e.wind+=dt;if(e.wind>1.1){e.launched=true;const target=s.act===1?{x:480,y:277}:p;\n            const aa=aimAt(e,target);e.vx=Math.cos(aa)*68*ag;e.vy=Math.sin(aa)*68*ag;}}\n          else {e.x+=e.vx*dt;e.y+=e.vy*dt;\n            if(s.act===1&&dist(e,{x:480,y:277})<63){this.objectiveHit(1.25);e.dead=true;}}\n        }else if(e.kind==='\"'tractor'){\n          e.x=clamp(e.homeX+Math.sin(e.age*.45)*32,50,910);e.y=e.homeY+Math.cos(e.age*.6)*12;\n          if(e.cool<=0){e.wind=4.2;e.cool=8/ag;e.target=p.id;e.lock=s.act===1?Math.floor((e.x/960)*4): -1;this.emit('lock',p.id,e.x,e.y);}\n          if(e.wind>0){e.wind-=dt;if(e.wind<3.1){\n            if(e.lock>=0){s.locks[e.lock]=true;if(Math.floor((e.age-dt)*2)\"'!==Math.floor(e.age*2))this.objectiveHit(.1);}\n            const target=s.players.find(q=>q.id===e.target);if(target&&target.hp>0&&dist(e,target)<270){const d=dist(e,target)||1;\n              target.vx+=(e.x-target.x)/d*105*dt;if(s.act!==2)target.vy+=(e.y-target.y)/d*105*dt;\n            }else e.target=-1;\n          }}\n        }else if(e.kind==='\"'dive'){\n          if(\"'!e.launched){e.x=e.homeX+Math.sin(e.age*1.1+e.seed)*33;e.y=e.homeY+Math.sin(e.age*.6)*12;\n            if(e.age>4.5+e.seed*.3){e.wind=.9;e.launched=true;e.vx=(p.x-e.x)*.22;e.vy=0;}}\n          else if(e.wind>0)e.wind-=dt;\n          else{e.vy=Math.min(105*ag,e.vy+42*dt);e.x+=e.vx*dt+Math.sin(e.age*3)*15*dt;e.y+=e.vy*dt;}\n        }else if(e.kind==='\"'relay'){\n          e.x=e.homeX+Math.sin(e.age*.5+e.seed)*20;\n          if(e.cool<=0){e.cool=4.5;for(let k=0;k<7;k++)this.shot(e.x,e.y,Math.PI*.15+k*Math.PI*.12,90,true,0,{r:3});}\n        }\n        if(e.kind\"'!=='\"'anchor'&&dist(e,p)<e.r+9)this.damagePlayer(p);\n        if(s.act===2&&e.y>478){this.objectiveHit(e.kind==='bomber'?1.5:1,e.x,480);e.dead=true;}\n        if(e.x< -40||e.x>1000||e.y<30||e.y>550||e.age>34)e.dead=true;\n      }\n      s.enemies=s.enemies.filter(e=>\"'!e.dead&&e.hp>0);\n      for(const e of add)this.spawn(e.kind,e.x,e.y);\n    }\n    stepShots(dt){\n      const s=this.s;\n      for(const b of s.shots){\n        if(b.life<=0)continue;b.px=b.x;b.py=b.y;b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;\n        if(!b.foe){\n          let target=null,hit=Infinity;\n          for(const e of s.enemies)if(e.tele<=0&&e.hp>0&&!e.dead){const v=segmentCircle(b.px,b.py,b.x,b.y,e,e.r+b.r);if(v<hit){hit=v;target=e;}}\n          if(s.boss)for(const c of s.boss.parts)if(c.hp>0&&c.open){const v=segmentCircle(b.px,b.py,b.x,b.y,c,c.r+b.r);if(v<hit){hit=v;target=c;}}\n          if(target){b.life=0;if(target.component)this.hitBoss(target,b.dmg,b.owner);else this.damageEnemy(target,b.dmg,b.owner);}\n        }else{\n          for(const p of s.players)if(p.hp>0&&!p.gone&&segmentCircle(b.px,b.py,b.x,b.y,p,p.inv>0?0:10+b.r)<Infinity){\n            if(p.inv<=0){this.damagePlayer(p,b.dmg||1);b.life=0;}break;}\n          if(b.life>0&&s.act===1&&segmentCircle(b.px,b.py,b.x,b.y,{x:480,y:277},62+b.r)<Infinity){this.objectiveHit(b.bomb?1.2:.45);b.life=0;}\n          if(b.life>0&&s.act===2&&b.y>=485){this.objectiveHit(b.bomb?1.25:.24,b.x,485);b.life=0;}\n        }\n        if(b.x< -30||b.x>990||b.y<65||b.y>560)b.life=0;\n      }\n      s.shots=s.shots.filter(b=>b.life>0);\n    }\n    stepDrops(dt){\n      const s=this.s;\n      for(const d of s.drops){d.t+=dt;d.life-=dt;\n        const p=this.closestPlayer(d);if(!p)continue;const ds=dist(d,p);\n        if(ds<110){const sp=100+180*(1-ds/110);d.x+=(p.x-d.x)/(ds||1)*sp*dt;d.y+=(p.y-d.y)/(ds||1)*sp*dt;}\n        if(ds<24){d.life=0;for(const q of s.players)if(q.hp>0&&!q.gone){q.energy=Math.min(q.maxEnergy,q.energy+(d.charge?55:25));q.hp=Math.min(q.maxHp,q.hp+1);q.pulse=Math.max(0,q.pulse-1);}\n          this.addScore(60);this.emit('\"'pickup',p.id,d.x,d.y,d.charge?2:1);}\n      }\n      s.drops=s.drops.filter(d=>d.life>0);\n    }\n    startBoss(){\n      const s=this.s;s.wave=9;s.waveTime=0;s.group=0;s.waveKills=0;\n      const scale=1+Math.max(0,s.players.filter(p=>\"'!p.gone).length-1)*.62;\n      s.boss={phase:0,age:0,phaseAge:0,cycle:0,shot:0,dead:false,parts:[]};\n      const data=[[-132,'\"'battery',210], [132,'battery',210],[-74,'emitter',220],[74,'emitter',220],[0,'core',500]];\n      for(const [i,[dx,kind,hp]]of data.entries())s.boss.parts.push({id:s.nextId++,component:true,index:i,kind,dx,x:480+dx,y:169,hp:hp*scale,maxHp:hp*scale,r:kind==='core'?32:22,open:false,hit:0});\n      s.bossPhases.push(0);this.say('There it is. The Night Admiral. Break the side guns, then the tractor forks. Finish the core.',9);this.emit('boss');\n    }\n    hitBoss(c,damage,owner){\n      if(c.hp<=0||\"'!c.open)return;c.hp=Math.max(0,c.hp-damage);c.hit=.12;this.emit('\"'hit',owner,c.x,c.y);\n      if(c.hp<=0){this.addScore(1200*this.s.multiplier);this.emit('component',owner,c.x,c.y);this.s.effects.push({id:this.s.nextId++,kind:'blast',x:c.x,y:c.y,t:0,life:1,size:48});}\n    }\n    stepBoss(dt){\n      const s=this.s,boss=s.boss;if(\"'!boss)return;\n      boss.age+=dt;boss.phaseAge+=dt;boss.shot-=dt;\n      const cx=480+Math.sin(boss.age*.28)*180,cy=155+Math.sin(boss.age*.6)*10;\n      const cycle=boss.phaseAge%8;\n      for(const c of boss.parts){c.x=cx+c.dx;c.y=cy+(c.kind==='\"'core'?15:6);c.hit=Math.max(0,c.hit-dt);\n        const phase=c.index<2?0:c.index<4?1:2;c.open=phase===boss.phase&&c.hp>0&&cycle>1.5&&cycle<7.5;\n      }\n      if(boss.phase===0){\n        if(boss.shot<=0){boss.shot=2.8;for(const c of boss.parts.slice(0,2))if(c.hp>0){const p=this.closestPlayer(c);if(\"'!p)continue;\n          const lane=Math.round(p.x/110)*110;const a=aimAt(c,{x:lane,y:490});for(let k=-1;k<=1;k++)this.shot(c.x,c.y,a+k*.055,102,true,0,{r:5,lane:true});\n          this.emit('\"'warning',0,lane,445);}}\n      }else if(boss.phase===1){\n        for(const c of boss.parts.slice(2,4))if(c.hp>0&&cycle>1.5&&cycle<5.5){\n          const p=this.closestPlayer(c);if(\"'!p)continue;const d=dist(c,p)||1;p.vx+=(c.x-p.x)/d*120*dt;\n          if(boss.shot<=0){this.shot(c.x,c.y,aimAt(c,p),113,true,0,{r:6});}}\n        if(boss.shot<=0)boss.shot=1.25;\n      }else{\n        if(cycle>1.5&&cycle<5.6&&boss.shot<=0){boss.shot=.9;for(let k=0;k<11;k++)this.shot(cx,cy+26,Math.PI*.15+k*Math.PI*.07,92,true,0,{r:4});}\n        if(cycle<1.5&&boss.shot<=0){boss.shot=1;this.emit('\"'coreWind',0,cx,cy);}\n      }\n      if(boss.phase<2&&boss.parts.filter(c=>(boss.phase===0?c.index<2:c.index===2||c.index===3)).every(c=>c.hp<=0)){\n        boss.phase++;boss.phaseAge=0;boss.shot=2;s.bossPhases.push(boss.phase);s.shots=s.shots.filter(b=>\"'!b.foe);\n        this.say(boss.phase===1?'\"'Batteries broken. The forks are opening. Pulse out of their pull.':'Core exposed\"'! Read the volleys. Take the cooling window.'\"',7);this.emit('bossPhase',0,cx,cy,boss.phase);\n      }\n      if(boss.parts[4].hp<=0)boss.dead=true;\n    }\n    resolve(){\n      const s=this.s;\n      // One outcome per tick: base loss / complete wipe takes priority over a simultaneous final kill.\n      if(s.act===2&&s.base<=0)return this.finish(false,'GROUND BASE LOST');\n      const live=s.players.filter(p=>\"'!p.gone);\n      if(!live.length||!live.some(p=>p.hp>0)){\n        if(s.act<2)this.retreat(false,'\"'WING OVERWHELMED');else this.finish(false,'ALL VIPERS LOST');return;\n      }\n      if(s.act===1&&s.heat>=100)return this.retreat(false,'HEAT OVERFLOW');\n      if(s.boss?.dead){this.addScore(6000+Math.round(s.base)*25);s.outcomes[2]={held:true,reason:'SIEGE SHIP DESTROYED',score:6000};return this.finish(true,'SIEGE BROKEN');}\n      const w=WAVES[s.wave];if(\"'!w)return;\n      const allSpawned=s.group>=w.groups.length, clear=s.enemies.every(e=>e.kind==='\"'anchor');\n      if((s.waveTime>=w.min&&allSpawned&&(clear||s.waveKills>=w.goal))||s.waveTime>=w.deadline){\n        const held=s.waveKills>=Math.ceil(w.goal*.6);s.waveOutcomes.push({wave:s.wave,held,kills:s.waveKills});this.addScore(held?500:100);\n        if(s.wave===2||s.wave===5)this.retreat(held,held?'CORRIDOR SECURED':'EVACUATION UNDER FIRE');\n        else{this.freshField();this.waveStart(s.wave+1);}\n      }\n    }\n    finish(won,reason){\n      const s=this.s;if(s.result)return;s.result={won:\"'!!won,reason,score:Math.floor(s.score),rank:RANKS.find(r=>s.score>=r[0])[1],time:Math.round(s.activeTime),outcomes:s.outcomes.map(x=>({...x})),modified:s.modified};\n      s.phase='\"'result';s.phaseTime=0;s.shots=[];s.enemies=[];this.clearInput();this.emit(won?'victory':'defeat');\n      this.say(won?'Fortress Command to Viper wing. The sky is ours. Come home.':'Fortress Command signing off. Remember the line.',12);\n    }\n    jump(act,wave=0,phase){\n      const s=this.s;s.modified=true;s.boss=null;s.result=null;this.enterAct(clamp(act|0,0,2));s.phase='play';s.phaseTime=0;this.waveStart(s.act*3+clamp(wave|0,0,2));\n      if(phase\"'!==undefined){this.startBoss();s.boss.phase=clamp(phase|0,0,2);s.bossPhases=[0,1,2].slice(0,s.boss.phase+1);for(const c of s.boss.parts)if(c.index<s.boss.phase*2)c.hp=0;}\n    }\n    step(dt=DT){\n      const s=this.s;if(s.phase==='\"'result'||s.phase==='ended')return;\n      s.tick++;s.t+=dt;\n      for(const e of s.effects)e.t+=dt;s.effects=s.effects.filter(e=>e.t<e.life);\n      if(s.phase==='briefing'){\n        if((s.phaseTime-=dt)<=0){s.phase='play';this.waveStart(s.wave);}return;\n      }\n      if(s.phase==='retreat'){\n        if((s.phaseTime-=dt)<=0){s.phase='upgrade';s.phaseTime=s.demo?1:9;s.upgrades++;for(const p of s.players)p.choice=null;this.emit('intermission');}return;\n      }\n      if(s.phase==='upgrade'){\n        s.phaseTime-=dt;const players=s.players.filter(p=>\"'!p.gone);\n        if(s.phaseTime<=0||players.every(p=>p.choice!==null)){\n          for(const p of players)if(p.choice===null)this.upgrade(p.id,0);\n          this.enterAct(s.act+1);\n        }return;\n      }\n      if(s.phase!=='\"'play')return;\n      s.activeTime+=dt;s.waveTime+=dt;\n      if(s.t-s.lastKill>7){s.chain=0;s.multiplier=1;}\n      if(s.act===1&&s.t-s.lastObjectiveHit>3)s.heat=Math.max(0,s.heat-s.balance.cooling*(s.locks.filter(v=>\"'!v).length/4)*dt);\n      const w=WAVES[s.wave];if(w){while(s.group<w.groups.length&&s.waveTime>=w.groups[s.group].at)this.spawnGroup(w.groups[s.group++]);}\n      this.stepPlayers(dt);this.stepEnemies(dt);this.stepBoss(dt);this.stepShots(dt);this.stepDrops(dt);this.resolve();\n      if(s.activeTime>=s.limit&&s.phase==='\"'play')this.finish(false,'EVACUATION WINDOW CLOSED');\n    }\n    snapshot(){return JSON.parse(JSON.stringify(this.s));}\n    restore(snapshot){\n      if(\"'!snapshot||snapshot.version!==1||!Number.isInteger(snapshot.tick)||!Array.isArray(snapshot.players))throw Error('\"'Invalid snapshot');\n      this.s=JSON.parse(JSON.stringify(snapshot));this.clearInput();\n    }\n  }\n  Object.assign(S,{World,clamp,dist,norm,aimAt,groundAim,segmentCircle,neutral});\n})(globalThis.Fortnight);\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim/world.js <<'EOF'\n(function (S) {\n  'use strict';\n  const { W, H, DT, BOUNDS: B, DEFAULTS, ENEMIES, WAVES, RANKS } = S;\n  const clamp = (n, a, b) => Math.max(a, Math.min(b, n));\n  const dist = (a,b) => Math.hypot(a.x-b.x,a.y-b.y);\n  const norm = (x,y) => { const d = Math.hypot(x,y); return d > 1 ? [x/d,y/d] : [x,y]; };\n  const aimAt = (a,b) => Math.atan2(b.y-a.y,b.x-a.x);\n  const groundAim = a => clamp(a > 0 ? a - Math.PI * 2 : a, -Math.PI + .15, -.15);\n  function segmentCircle(x0,y0,x1,y1,c,r) {\n    const dx=x1-x0, dy=y1-y0, den=dx*dx+dy*dy;\n    const t=den ? clamp(((c.x-x0)*dx+(c.y-y0)*dy)/den,0,1) : 0;\n    return (x0+dx*t-c.x)**2+(y0+dy*t-c.y)**2 <= r*r ? t : Infinity;\n  }\n  const neutral = seq => ({ seq, mx:0,my:0,ax:0,ay:-1,fire:false,boost:false,pulse:false });\n  class World {\n    constructor(opts={}) {\n      const seed=Number(opts.seed ?? 198113)>>>0;\n      this.s = {\n        version:1, epoch:opts.epoch || 1, seed, rng:seed || 1, tick:0, t:0, activeTime:0,\n        phase:'briefing', phaseTime:3.5, act:0, wave:0, waveTime:0, group:0, waveKills:0,\n        score:0, chain:0, multiplier:1, lastKill:-20, nextId:1, eventSeq:0,\n        heat:0, base:100, lastObjectiveHit:-10, locks:[false,false,false,false],\n        outcomes:[], waveOutcomes:[], upgrades:0, players:[], enemies:[], shots:[], drops:[], effects:[],\n        boss:null, seen:[], bossPhases:[], result:null, modified:false, demo:\"'!!opts.demo,\n        balance:{...DEFAULTS,...opts.balance}, options:{god:!!opts.demo, overlays:false},\n        radio:'\"'Viper wing, this is Fortress 13. Make them regret the journey.', radioUntil:8,\n        limit: Number.isFinite(opts.limit) ? opts.limit : 780, events:[],\n      };\n      this.intents = new Map();\n      for (const [i,seat] of (opts.players || [{id:0,name:'VIPER 01',color:'#8ae5dc'}]).entries()) {\n        this.s.players.push({id:seat.id,name:String(seat.name).slice(0,32),color:seat.color || ['#8ae5dc','#efbc6e','#ec9fbd','#b7d98c'][i],\n          x:360+i*72,y:385,vx:0,vy:0,a:-Math.PI/2,hp:0,maxHp:0,energy:100,maxEnergy:100,\n          pulse:0,boost:0,boostCool:0,cool:0,inv:3,dead:0,gone:false,seq:-1,kills:0,damage:0,\n          upgrades:{laser:0,boost:0,pulse:0},choice:null,thrust:0,recoil:0,pulseFx:0,hit:0});\n      }\n      const n=this.s.players.length;\n      for (const p of this.s.players) p.hp=p.maxHp=n===1 ? 9 : 6;\n      this.emit('briefing',0,480,270);\n    }\n    random() { let a=this.s.rng=(this.s.rng+0x6d2b79f5)>>>0; a=Math.imul(a\"'^(a>>>15),a|1); a''^=a+Math.imul(a''^(a>>>7),a|61); return ((a''^(a>>>14))>>>0)/4294967296; }\n    emit(type,owner=0,x=480,y=270,value=0) {\n      const s=this.s, e={id:++s.eventSeq,type,owner,x,y,value,tick:s.tick};\n      s.events.push(e); if (s.events.length>96) s.events.shift(); return e;\n    }\n    say(text,seconds=6) { this.s.radio=text; this.s.radioUntil=this.s.t+seconds; this.emit('\"'radio'); }\n    setIntent(id,input) {\n      const s=this.s,p=s.players.find(p=>p.id===id&&\"'!p.gone);\n      if (!p || !input || !Number.isSafeInteger(input.seq) || input.seq<=p.seq) return false;\n      for (const k of ['\"'mx','my','ax','ay']) if (\"'!Number.isFinite(input[k]) || Math.abs(input[k])>1.001) return false;\n      if (Math.hypot(input.mx,input.my)>1.015 || Math.hypot(input.ax,input.ay)>1.015) return false;\n      const [mx,my]=norm(input.mx,input.my),[ax,ay]=norm(input.ax,input.ay);\n      p.seq=input.seq;\n      this.intents.set(id,{seq:input.seq,mx,my,ax,ay,fire:input.fire===true,boost:input.boost===true,pulse:input.pulse===true,tick:s.tick});\n      return true;\n    }\n    clearInput() { this.intents.clear(); }\n    leave(id) { const p=this.s.players.find(p=>p.id===id); if (p) {p.gone=true;p.hp=0;} this.intents.delete(id); }\n    balance(key,value) {\n      const spec=S.BALANCE_SPEC.find(v=>v[0]===key); if (!spec || !Number.isFinite(value)) return false;\n      this.s.balance[key]=clamp(value,spec[3],spec[4]); this.s.modified=true; return true;\n    }\n    resetBalance() { this.s.balance={...DEFAULTS}; this.s.modified=true; }\n    upgrade(id,choice) {\n      const s=this.s,p=s.players.find(p=>p.id===id&&!p.gone);\n      if (s.phase!=='\"'upgrade' || \"'!p || p.choice!==null || ![0,1,2].includes(choice)) return false;\n      p.choice=choice; const key=S.UPGRADES[choice].id; p.upgrades[key]++;\n      p.maxEnergy=100+50*p.upgrades.boost; p.energy=p.maxEnergy;\n      this.emit('\"'upgrade',id,p.x,p.y,choice); return true;\n    }\n    freshField() { const s=this.s; s.enemies=[];s.shots=[];s.drops=[];s.effects=[];s.locks=[false,false,false,false];this.clearInput(); }\n    waveStart(wave) {\n      const s=this.s; s.wave=wave;s.waveTime=0;s.group=0;s.waveKills=0;\n      const w=WAVES[wave]; if (\"'!w) return this.startBoss();\n      s.act=w.act;this.say(w.radio,8);this.emit('\"'wave',0,480,270,wave);\n    }\n    retreat(success,reason) {\n      const s=this.s;if (s.phase\"'!=='\"'play') return;\n      s.outcomes[s.act]={held:success,reason,score:success?1800:350};\n      this.addScore(success?1800:350);if (\"'!success) {s.multiplier=1;s.chain=0;s.score=Math.max(0,s.score-500);}\n      this.freshField();s.phase='\"'retreat';s.phaseTime=4.5;\n      this.say(success ? 'Line secured. Vipers, fall back by order. The fortress still stands.' : 'Emergency extraction\"'! Leave the line. We have one more place to stand.'\"',5);\n      this.emit('retreat',0,480,270,success?1:0);\n    }\n    enterAct(act) {\n      const s=this.s;s.act=act;s.phase='briefing';s.phaseTime=3.2;s.heat=act===1 ? (s.outcomes[0]?.held?4:20) : s.heat;\n      if (act===2) s.base=s.outcomes[1]?.held ? 100 : 76;\n      this.freshField();\n      for (const [i,p] of s.players.entries()) if (\"'!p.gone) {\n        p.x=360+i*72;p.y=act===2?457:395;p.vx=p.vy=0;p.a=-Math.PI/2;p.hp=p.maxHp;p.dead=0;p.inv=3;\n        p.energy=p.maxEnergy;p.pulse=0;p.boost=0;\n      }\n      s.wave=act*3;this.say(WAVES[s.wave].radio,7);this.emit('\"'dock',0,480,440,act);\n    }\n    addScore(amount) { this.s.score=Math.max(0,Math.floor(this.s.score+amount)); }\n    kill(e,owner=0) {\n      const s=this.s;if(e.hp<=0 || e.dead) return;\n      e.hp=0;e.dead=true;s.waveKills++;s.chain++;s.multiplier=Math.min(5,1+Math.floor(s.chain/5));s.lastKill=s.t;\n      this.addScore((ENEMIES[e.kind]?.score || 100)*s.multiplier);\n      const p=s.players.find(p=>p.id===owner);if(p)p.kills++;\n      s.effects.push({id:s.nextId++,kind:'blast',x:e.x,y:e.y,t:0,life:.75,size:e.r*1.8});\n      this.emit('kill',owner,e.x,e.y,e.kind==='anchor'?2:1);\n      if (e.kind==='anchor' || s.chain%4===0) s.drops.push({id:s.nextId++,x:e.x,y:e.y,t:0,life:12,charge:e.kind==='anchor',r:10});\n    }\n    damageEnemy(e,amount,owner) {\n      if(e.dead||e.hp<=0)return;\n      e.hit=.1;this.emit('hit',owner,e.x,e.y);\n      if (e.hp<=amount) this.kill(e,owner); else e.hp-=amount;\n    }\n    damagePlayer(p,amount=1) {\n      const s=this.s;if(p.hp<=0||p.inv>0||s.phase\"'!=='\"'play'||s.options.god)return false;\n      p.hp=Math.max(0,p.hp-amount);p.damage+=amount;p.inv=1.15;p.hit=.24;s.chain=0;s.multiplier=1;\n      this.addScore(-80);this.emit('hurt',p.id,p.x,p.y,p.hp);\n      if(p.hp<=0) {p.dead=3;this.emit('death',p.id,p.x,p.y);s.effects.push({id:s.nextId++,kind:'blast',x:p.x,y:p.y,t:0,life:1,size:35});}\n      return true;\n    }\n    objectiveHit(mult=1,x=480,y=277) {\n      const s=this.s;if(s.phase\"'!=='\"'play'||s.act===0)return;\n      if(s.act===1)s.heat=clamp(s.heat+s.balance.heatHit*mult,0,100);\n      else s.base=Math.max(0,s.base-s.balance.baseDamage*mult);\n      s.lastObjectiveHit=s.t;this.emit('objective',0,x,y,mult);\n    }\n    spawn(kind,x,y,opts={}) {\n      const s=this.s,d=ENEMIES[kind];if(\"'!d)throw Error(`Unknown enemy: ${kind}`);\n      const scale=1+Math.max(0,s.players.filter(p=>!p.gone).length-1)*.3;\n      const e={id:s.nextId++,kind,x,y,homeX:x,homeY:y,vx:0,vy:0,hp:d.hp*scale,maxHp:d.hp*scale,r:d.r,\n        age:0,tele:opts.tele ?? 1.35,cycle:0,wind:0,cool:1.8+this.random(),a:Math.PI/2,target:-1,lock:-1,\n        hit:0,dead:false,lane:x,launched:false,seed:this.random()*6.28,...opts};\n      if(kind==='\"'anchor') {e.charge=2.7;e.cool=3;e.tele=.55;}\n      if(kind==='relay'){e.y=e.homeY=140;e.tele=2;}\n      s.enemies.push(e);if(\"'!s.seen.includes(kind))s.seen.push(kind);this.emit('\"'spawn',0,x,y);\n      return e;\n    }\n    spawnGroup(g) {\n      const s=this.s,n=s.players.filter(p=>\"'!p.gone).length;\n      const count=Math.min(10,g.count+Math.floor((n-1)*g.count*.22));\n      for(let i=0;i<count;i++) {\n        const frac=(i+1)/(count+1);let x=110+frac*740+(this.random()-.5)*28,y=105;\n        if(g.side==='\"'left'){x=48;y=115+frac*300;}\n        if(g.side==='right'){x=912;y=115+frac*300;}\n        if(g.side==='bottom'){x=120+frac*720;y=448;}\n        if(s.act===2){y=105+(g.pattern==='vee'?Math.abs(i-(count-1)/2)*16:0);}\n        const nearby=s.players.find(p=>p.hp>0&&Math.hypot(p.x-x,p.y-y)<110);\n        if(nearby){x=nearby.x<480?Math.max(nearby.x+140,x):Math.min(nearby.x-140,x);x=clamp(x,48,912);}\n        this.spawn(g.kind,x,y,{seed:i*.5+this.random(),tele:1.35+i*.13});\n      }\n    }\n    shot(x,y,a,speed,foe,owner=0,opts={}) {\n      const s=this.s;\n      s.shots.push({id:s.nextId++,x,y,px:x,py:y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,\n        life:foe?5:1.5,r:foe?4:2,foe,owner,dmg:foe?1:s.balance.laserDamage,...opts});\n    }\n    firePlayer(p) {\n      const s=this.s;\n      this.shot(p.x+Math.cos(p.a)*21,p.y+Math.sin(p.a)*21,p.a,730,false,p.id,{dmg:s.balance.laserDamage*(1+.3*p.upgrades.laser)});\n      p.cool=s.balance.laserCadence;p.recoil=.08;this.emit('shot',p.id,p.x,p.y);\n    }\n    pulsePlayer(p) {\n      const s=this.s;p.pulse=s.balance.pulseCooldown*Math.pow(.75,p.upgrades.pulse);p.pulseFx=.55;\n      s.shots=s.shots.filter(b=>\"'!b.foe||dist(b,p)>130);\n      for(const e of s.enemies)if(dist(e,p)<145){\n        if(e.kind==='\"'tractor'){e.wind=0;e.cool=3.5;e.target=-1;e.lock=-1;}\n        const a=aimAt(p,e);e.x=clamp(e.x+Math.cos(a)*28,25,935);e.y=clamp(e.y+Math.sin(a)*28,90,466);\n      }\n      p.inv=Math.max(p.inv,.4);s.effects.push({id:s.nextId++,kind:'pulse',x:p.x,y:p.y,t:0,life:.55,size:130});\n      this.emit('pulse',p.id,p.x,p.y);\n    }\n    stepPlayers(dt) {\n      const s=this.s,b=s.balance;\n      for(const p of s.players) {\n        if(p.gone)continue;\n        p.inv=Math.max(0,p.inv-dt);p.cool-=dt;p.pulse=Math.max(0,p.pulse-dt);p.boostCool-=dt;\n        p.recoil=Math.max(0,p.recoil-dt);p.pulseFx=Math.max(0,p.pulseFx-dt);p.hit=Math.max(0,p.hit-dt);\n        if(p.hp<=0){\n          if((p.dead-=dt)<=0&&s.players.some(q=>\"'!q.gone&&q.hp>0)) {\n            p.hp=p.maxHp;p.x=480;p.y=s.act===2?457:405;p.vx=p.vy=0;p.inv=3;p.energy=p.maxEnergy;\n            this.addScore(-300);s.chain=0;s.multiplier=1;this.emit('\"'redeploy',p.id,p.x,p.y);\n          }\n          continue;\n        }\n        const it=this.intents.get(p.id),I=it&&s.tick-it.tick<60?it:neutral(p.seq);\n        let [mx,my]=[I.mx,s.act===2?0:I.my];p.thrust=Math.hypot(mx,my);\n        if(Math.hypot(I.ax,I.ay)>.2){p.a=Math.atan2(I.ay,I.ax);if(s.act===2)p.a=groundAim(p.a);}\n        if(I.boost&&p.energy>=28&&p.boostCool<=0){\n          const a=Math.hypot(mx,my)>.1?Math.atan2(my,mx):p.a;\n          p.vx=Math.cos(a)*440;p.vy=s.act===2?0:Math.sin(a)*440;p.energy-=28;p.boost=.24;p.boostCool=.9;p.inv=Math.max(p.inv,.28);\n          this.emit('boost',p.id,p.x,p.y);\n        }\n        p.energy=Math.min(p.maxEnergy,p.energy+b.boostRecharge*dt);\n        p.boost=Math.max(0,p.boost-dt);\n        if(p.boost<=0){p.vx+=mx*b.thrust*dt;p.vy+=my*b.thrust*dt;const drag=Math.exp(-b.drag*dt);p.vx*=drag;p.vy*=drag;}\n        const cap=p.boost>0?460:210,sp=Math.hypot(p.vx,p.vy);if(sp>cap){p.vx*=cap/sp;p.vy*=cap/sp;}\n        p.x=clamp(p.x+p.vx*dt,B.x0,B.x1);p.y=s.act===2?457:clamp(p.y+p.vy*dt,B.y0,B.y1);\n        if(s.act===1){const dx=p.x-480,dy=p.y-277,d=Math.hypot(dx,dy);if(d<76){p.x=480+dx/(d||1)*76;p.y=277+dy/(d||1)*76;p.vx*=.7;p.vy*=.7;}}\n        if(I.fire&&p.cool<=0)this.firePlayer(p);\n        if(I.pulse&&p.pulse<=0)this.pulsePlayer(p);\n      }\n    }\n    closestPlayer(e) {\n      let best=null,d=Infinity;for(const p of this.s.players)if(\"'!p.gone&&p.hp>0){const v=dist(e,p);if(v<d){d=v;best=p;}}return best;\n    }\n    stepEnemies(dt) {\n      const s=this.s,b=s.balance,add=[];s.locks=[false,false,false,false];\n      for(const e of s.enemies){\n        if(e.hp<=0||e.dead)continue;\n        e.age+=dt;e.hit=Math.max(0,e.hit-dt);\n        if(e.tele>0){e.tele-=dt;continue;}\n        const p=this.closestPlayer(e);if(!p)continue;\n        e.cool-=dt;const ag=b.aggression;const a=aimAt(e,p);e.a=a;\n        if(e.kind==='\"'hunter'){\n          e.x=clamp(e.homeX+Math.sin(e.age*.64+e.seed)*55,35,925);\n          e.y=clamp(e.homeY+Math.sin(e.age*.47+e.seed)*26+(s.act===2?24:0),99,436);\n          if(e.cool<=0){e.wind=.7;e.cool=3.6/ag; e.lane=p.x;e.target=p.id;this.emit('aim',0,e.x,e.y);}\n          if(e.wind>0&&(e.wind-=dt)<=0){const target=s.players.find(q=>q.id===e.target)||p;\n            const ang=aimAt(e,target);for(let k=-1;k<=1;k++)this.shot(e.x,e.y,ang+k*.12,112+8*ag,true,0,{r:3.5});}\n        }else if(e.kind==='bomber'){\n          e.x=clamp(e.homeX+Math.sin(e.age*.28+e.seed)*65,45,915);\n          e.y=e.homeY+Math.sin(e.age*.9)*8;\n          if(e.cool<=0){e.wind=1.65;e.cool=6.8/ag;e.lane=s.act===1?480:p.x;this.emit('warning',0,e.lane,440);}\n          if(e.wind>0&&(e.wind-=dt)<=0){\n            const target={x:e.lane,y:s.act===1?277:510};\n            this.shot(e.x,e.y,aimAt(e,target),85,true,0,{r:8,bomb:true,obj:true,dmg:2});\n          }\n        }else if(e.kind==='scout'){\n          e.x=clamp(e.homeX+Math.sin(e.age*.48+e.seed)*90,45,915);e.y=e.homeY+Math.cos(e.age*.7)*14;\n          if(e.cool<=0){e.cool=11;const x=s.act===2?clamp(p.x+(this.random()-.5)*120,80,880):clamp(p.x+(this.random()-.5)*160,75,885);\n            add.push({kind:'anchor',x,y:s.act===2?310:clamp(p.y-45,160,385)});this.emit('gravity',0,x,p.y);}\n        }else if(e.kind==='anchor'){\n          e.charge=Math.max(0,e.charge-dt);\n          if(e.charge<=0){for(const q of s.players)if(q.hp>0&&\"'!q.gone){const d=dist(e,q);if(d<180&&d>8){\n            const force=b.gravity*(1-d/230);q.vx+=(e.x-q.x)/d*force*dt;if(s.act!==2)q.vy+=(e.y-q.y)/d*force*dt;\n            if(d<27)this.damagePlayer(q);\n          }}\n          if(e.cool<=0){e.cool=3.4;for(let k=0;k<8;k++)this.shot(e.x,e.y,k*Math.PI/4+e.age*.1,65,true,0,{r:3});}}\n        }else if(e.kind==='\"'rammer'){\n          if(\"'!e.launched){e.wind+=dt;if(e.wind>1.1){e.launched=true;const target=s.act===1?{x:480,y:277}:p;\n            const aa=aimAt(e,target);e.vx=Math.cos(aa)*68*ag;e.vy=Math.sin(aa)*68*ag;}}\n          else {e.x+=e.vx*dt;e.y+=e.vy*dt;\n            if(s.act===1&&dist(e,{x:480,y:277})<63){this.objectiveHit(1.25);e.dead=true;}}\n        }else if(e.kind==='\"'tractor'){\n          e.x=clamp(e.homeX+Math.sin(e.age*.45)*32,50,910);e.y=e.homeY+Math.cos(e.age*.6)*12;\n          if(e.cool<=0){e.wind=4.2;e.cool=8/ag;e.target=p.id;e.lock=s.act===1?Math.floor((e.x/960)*4): -1;this.emit('lock',p.id,e.x,e.y);}\n          if(e.wind>0){e.wind-=dt;if(e.wind<3.1){\n            if(e.lock>=0){s.locks[e.lock]=true;if(Math.floor((e.age-dt)*2)\"'!==Math.floor(e.age*2))this.objectiveHit(.1);}\n            const target=s.players.find(q=>q.id===e.target);if(target&&target.hp>0&&dist(e,target)<270){const d=dist(e,target)||1;\n              target.vx+=(e.x-target.x)/d*105*dt;if(s.act!==2)target.vy+=(e.y-target.y)/d*105*dt;\n            }else e.target=-1;\n          }}\n        }else if(e.kind==='\"'dive'){\n          if(\"'!e.launched){e.x=e.homeX+Math.sin(e.age*1.1+e.seed)*33;e.y=e.homeY+Math.sin(e.age*.6)*12;\n            if(e.age>4.5+e.seed*.3){e.wind=.9;e.launched=true;e.vx=(p.x-e.x)*.22;e.vy=0;}}\n          else if(e.wind>0)e.wind-=dt;\n          else{e.vy=Math.min(105*ag,e.vy+42*dt);e.x+=e.vx*dt+Math.sin(e.age*3)*15*dt;e.y+=e.vy*dt;}\n        }else if(e.kind==='\"'relay'){\n          e.x=e.homeX+Math.sin(e.age*.5+e.seed)*20;\n          if(e.cool<=0){e.cool=4.5;for(let k=0;k<7;k++)this.shot(e.x,e.y,Math.PI*.15+k*Math.PI*.12,90,true,0,{r:3});}\n        }\n        if(e.kind\"'!=='\"'anchor'&&dist(e,p)<e.r+9)this.damagePlayer(p);\n        if(s.act===2&&e.y>478){this.objectiveHit(e.kind==='bomber'?1.5:1,e.x,480);e.dead=true;}\n        if(e.x< -40||e.x>1000||e.y<30||e.y>550||e.age>34)e.dead=true;\n      }\n      s.enemies=s.enemies.filter(e=>\"'!e.dead&&e.hp>0);\n      for(const e of add)this.spawn(e.kind,e.x,e.y);\n    }\n    stepShots(dt){\n      const s=this.s;\n      for(const b of s.shots){\n        if(b.life<=0)continue;b.px=b.x;b.py=b.y;b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;\n        if(!b.foe){\n          let target=null,hit=Infinity;\n          for(const e of s.enemies)if(e.tele<=0&&e.hp>0&&!e.dead){const v=segmentCircle(b.px,b.py,b.x,b.y,e,e.r+b.r);if(v<hit){hit=v;target=e;}}\n          if(s.boss)for(const c of s.boss.parts)if(c.hp>0&&c.open){const v=segmentCircle(b.px,b.py,b.x,b.y,c,c.r+b.r);if(v<hit){hit=v;target=c;}}\n          if(target){b.life=0;if(target.component)this.hitBoss(target,b.dmg,b.owner);else this.damageEnemy(target,b.dmg,b.owner);}\n        }else{\n          for(const p of s.players)if(p.hp>0&&!p.gone&&segmentCircle(b.px,b.py,b.x,b.y,p,p.inv>0?0:10+b.r)<Infinity){\n            if(p.inv<=0){this.damagePlayer(p,b.dmg||1);b.life=0;}break;}\n          if(b.life>0&&s.act===1&&segmentCircle(b.px,b.py,b.x,b.y,{x:480,y:277},62+b.r)<Infinity){this.objectiveHit(b.bomb?1.2:.45);b.life=0;}\n          if(b.life>0&&s.act===2&&b.y>=485){this.objectiveHit(b.bomb?1.25:.24,b.x,485);b.life=0;}\n        }\n        if(b.x< -30||b.x>990||b.y<65||b.y>560)b.life=0;\n      }\n      s.shots=s.shots.filter(b=>b.life>0);\n    }\n    stepDrops(dt){\n      const s=this.s;\n      for(const d of s.drops){d.t+=dt;d.life-=dt;\n        const p=this.closestPlayer(d);if(!p)continue;const ds=dist(d,p);\n        if(ds<110){const sp=100+180*(1-ds/110);d.x+=(p.x-d.x)/(ds||1)*sp*dt;d.y+=(p.y-d.y)/(ds||1)*sp*dt;}\n        if(ds<24){d.life=0;for(const q of s.players)if(q.hp>0&&!q.gone){q.energy=Math.min(q.maxEnergy,q.energy+(d.charge?55:25));q.hp=Math.min(q.maxHp,q.hp+1);q.pulse=Math.max(0,q.pulse-1);}\n          this.addScore(60);this.emit('\"'pickup',p.id,d.x,d.y,d.charge?2:1);}\n      }\n      s.drops=s.drops.filter(d=>d.life>0);\n    }\n    startBoss(){\n      const s=this.s;s.wave=9;s.waveTime=0;s.group=0;s.waveKills=0;\n      const scale=1+Math.max(0,s.players.filter(p=>\"'!p.gone).length-1)*.62;\n      s.boss={phase:0,age:0,phaseAge:0,cycle:0,shot:0,dead:false,parts:[]};\n      const data=[[-132,'\"'battery',210], [132,'battery',210],[-74,'emitter',220],[74,'emitter',220],[0,'core',500]];\n      for(const [i,[dx,kind,hp]]of data.entries())s.boss.parts.push({id:s.nextId++,component:true,index:i,kind,dx,x:480+dx,y:169,hp:hp*scale,maxHp:hp*scale,r:kind==='core'?32:22,open:false,hit:0});\n      s.bossPhases.push(0);this.say('There it is. The Night Admiral. Break the side guns, then the tractor forks. Finish the core.',9);this.emit('boss');\n    }\n    hitBoss(c,damage,owner){\n      if(c.hp<=0||\"'!c.open)return;c.hp=Math.max(0,c.hp-damage);c.hit=.12;this.emit('\"'hit',owner,c.x,c.y);\n      if(c.hp<=0){this.addScore(1200*this.s.multiplier);this.emit('component',owner,c.x,c.y);this.s.effects.push({id:this.s.nextId++,kind:'blast',x:c.x,y:c.y,t:0,life:1,size:48});}\n    }\n    stepBoss(dt){\n      const s=this.s,boss=s.boss;if(\"'!boss)return;\n      boss.age+=dt;boss.phaseAge+=dt;boss.shot-=dt;\n      const cx=480+Math.sin(boss.age*.28)*180,cy=155+Math.sin(boss.age*.6)*10;\n      const cycle=boss.phaseAge%8;\n      for(const c of boss.parts){c.x=cx+c.dx;c.y=cy+(c.kind==='\"'core'?15:6);c.hit=Math.max(0,c.hit-dt);\n        const phase=c.index<2?0:c.index<4?1:2;c.open=phase===boss.phase&&c.hp>0&&cycle>1.5&&cycle<7.5;\n      }\n      if(boss.phase===0){\n        if(boss.shot<=0){boss.shot=2.8;for(const c of boss.parts.slice(0,2))if(c.hp>0){const p=this.closestPlayer(c);if(\"'!p)continue;\n          const lane=Math.round(p.x/110)*110;const a=aimAt(c,{x:lane,y:490});for(let k=-1;k<=1;k++)this.shot(c.x,c.y,a+k*.055,102,true,0,{r:5,lane:true});\n          this.emit('\"'warning',0,lane,445);}}\n      }else if(boss.phase===1){\n        for(const c of boss.parts.slice(2,4))if(c.hp>0&&cycle>1.5&&cycle<5.5){\n          const p=this.closestPlayer(c);if(\"'!p)continue;const d=dist(c,p)||1;p.vx+=(c.x-p.x)/d*120*dt;\n          if(boss.shot<=0){this.shot(c.x,c.y,aimAt(c,p),113,true,0,{r:6});}}\n        if(boss.shot<=0)boss.shot=1.25;\n      }else{\n        if(cycle>1.5&&cycle<5.6&&boss.shot<=0){boss.shot=.9;for(let k=0;k<11;k++)this.shot(cx,cy+26,Math.PI*.15+k*Math.PI*.07,92,true,0,{r:4});}\n        if(cycle<1.5&&boss.shot<=0){boss.shot=1;this.emit('\"'coreWind',0,cx,cy);}\n      }\n      if(boss.phase<2&&boss.parts.filter(c=>(boss.phase===0?c.index<2:c.index===2||c.index===3)).every(c=>c.hp<=0)){\n        boss.phase++;boss.phaseAge=0;boss.shot=2;s.bossPhases.push(boss.phase);s.shots=s.shots.filter(b=>\"'!b.foe);\n        this.say(boss.phase===1?'\"'Batteries broken. The forks are opening. Pulse out of their pull.':'Core exposed\"'! Read the volleys. Take the cooling window.'\"',7);this.emit('bossPhase',0,cx,cy,boss.phase);\n      }\n      if(boss.parts[4].hp<=0)boss.dead=true;\n    }\n    resolve(){\n      const s=this.s;\n      // One outcome per tick: base loss / complete wipe takes priority over a simultaneous final kill.\n      if(s.act===2&&s.base<=0)return this.finish(false,'GROUND BASE LOST');\n      const live=s.players.filter(p=>\"'!p.gone);\n      if(!live.length||!live.some(p=>p.hp>0)){\n        if(s.act<2)this.retreat(false,'\"'WING OVERWHELMED');else this.finish(false,'ALL VIPERS LOST');return;\n      }\n      if(s.act===1&&s.heat>=100)return this.retreat(false,'HEAT OVERFLOW');\n      if(s.boss?.dead){this.addScore(6000+Math.round(s.base)*25);s.outcomes[2]={held:true,reason:'SIEGE SHIP DESTROYED',score:6000};return this.finish(true,'SIEGE BROKEN');}\n      const w=WAVES[s.wave];if(\"'!w)return;\n      const allSpawned=s.group>=w.groups.length, clear=s.enemies.every(e=>e.kind==='\"'anchor');\n      if((s.waveTime>=w.min&&allSpawned&&(clear||s.waveKills>=w.goal))||s.waveTime>=w.deadline){\n        const held=s.waveKills>=Math.ceil(w.goal*.6);s.waveOutcomes.push({wave:s.wave,held,kills:s.waveKills});this.addScore(held?500:100);\n        if(s.wave===2||s.wave===5)this.retreat(held,held?'CORRIDOR SECURED':'EVACUATION UNDER FIRE');\n        else{this.freshField();this.waveStart(s.wave+1);}\n      }\n    }\n    finish(won,reason){\n      const s=this.s;if(s.result)return;s.result={won:\"'!!won,reason,score:Math.floor(s.score),rank:RANKS.find(r=>s.score>=r[0])[1],time:Math.round(s.activeTime),outcomes:s.outcomes.map(x=>({...x})),modified:s.modified};\n      s.phase='\"'result';s.phaseTime=0;s.shots=[];s.enemies=[];this.clearInput();this.emit(won?'victory':'defeat');\n      this.say(won?'Fortress Command to Viper wing. The sky is ours. Come home.':'Fortress Command signing off. Remember the line.',12);\n    }\n    jump(act,wave=0,phase){\n      const s=this.s;s.modified=true;s.boss=null;s.result=null;this.enterAct(clamp(act|0,0,2));s.phase='play';s.phaseTime=0;this.waveStart(s.act*3+clamp(wave|0,0,2));\n      if(phase\"'!==undefined){this.startBoss();s.boss.phase=clamp(phase|0,0,2);s.bossPhases=[0,1,2].slice(0,s.boss.phase+1);for(const c of s.boss.parts)if(c.index<s.boss.phase*2)c.hp=0;}\n    }\n    step(dt=DT){\n      const s=this.s;if(s.phase==='\"'result'||s.phase==='ended')return;\n      s.tick++;s.t+=dt;\n      for(const e of s.effects)e.t+=dt;s.effects=s.effects.filter(e=>e.t<e.life);\n      if(s.phase==='briefing'){\n        if((s.phaseTime-=dt)<=0){s.phase='play';this.waveStart(s.wave);}return;\n      }\n      if(s.phase==='retreat'){\n        if((s.phaseTime-=dt)<=0){s.phase='upgrade';s.phaseTime=s.demo?1:9;s.upgrades++;for(const p of s.players)p.choice=null;this.emit('intermission');}return;\n      }\n      if(s.phase==='upgrade'){\n        s.phaseTime-=dt;const players=s.players.filter(p=>\"'!p.gone);\n        if(s.phaseTime<=0||players.every(p=>p.choice!==null)){\n          for(const p of players)if(p.choice===null)this.upgrade(p.id,0);\n          this.enterAct(s.act+1);\n        }return;\n      }\n      if(s.phase!=='\"'play')return;\n      s.activeTime+=dt;s.waveTime+=dt;\n      if(s.t-s.lastKill>7){s.chain=0;s.multiplier=1;}\n      if(s.act===1&&s.t-s.lastObjectiveHit>3)s.heat=Math.max(0,s.heat-s.balance.cooling*(s.locks.filter(v=>\"'!v).length/4)*dt);\n      const w=WAVES[s.wave];if(w){while(s.group<w.groups.length&&s.waveTime>=w.groups[s.group].at)this.spawnGroup(w.groups[s.group++]);}\n      this.stepPlayers(dt);this.stepEnemies(dt);this.stepBoss(dt);this.stepShots(dt);this.stepDrops(dt);this.resolve();\n      if(s.activeTime>=s.limit&&s.phase==='\"'play')this.finish(false,'EVACUATION WINDOW CLOSED');\n    }\n    snapshot(){return JSON.parse(JSON.stringify(this.s));}\n    restore(snapshot){\n      if(\"'!snapshot||snapshot.version!==1||!Number.isInteger(snapshot.tick)||!Array.isArray(snapshot.players))throw Error('\"'Invalid snapshot');\n      this.s=JSON.parse(JSON.stringify(snapshot));this.clearInput();\n    }\n  }\n  Object.assign(S,{World,clamp,dist,norm,aimAt,groundAim,segmentCircle,neutral});\n})(globalThis.Fortnight);\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_40","type":"agent_message","text":"The simulation now covers all three acts, forced retreats, cooling and radiator locks, upgrades, redeploys, scoring, and the boss phases. I’ve also defined the outcome priority: if the base or whole team is lost on the same tick as a boss kill, the run ends in defeat.\n"}}
{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim/bot.js <<'EOF'\n(function(S){\n  'use strict';\n  function botIntent(world,id,seq){\n    const s=world.s,p=s.players.find(p=>p.id===id),out=S.neutral(seq);\n    if(\"'!p||p.hp<=0)return out;\n    const targets=s.enemies.filter(e=>e.hp>0&&e.tele<=0);\n    if(s.boss)targets.push(...s.boss.parts.filter(c=>c.hp>0&&c.open));\n    let target=null,score=Infinity;\n    for(const e of targets){\n      const urgency=e.kind==='\"'rammer'?-.55:e.kind==='anchor'?-.35:e.kind==='tractor'?-.3:e.component?-.9:e.kind==='dive'&&e.y>300?-.8:0;\n      const val=S.dist(p,e)*(1+urgency)+(e.kind==='relay'?-80:0);\n      if(val<score){score=val;target=e;}\n    }\n    let mx=0,my=0;\n    if(target){\n      const travel=S.dist(p,target)/730;\n      const tx=target.x+(target.vx||0)*travel,ty=target.y+(target.vy||0)*travel;\n      const a=Math.atan2(ty-p.y,tx-p.x);out.ax=Math.cos(a);out.ay=Math.sin(a);out.fire=true;\n      if(s.act===2)mx=S.clamp((target.x-p.x)/100,-1,1)*.65;\n      else {\n        const desired=target.kind==='anchor'?245:240;\n        const d=S.dist(p,target);mx=(target.x-p.x)/(d||1)*S.clamp((d-desired)/130,-.5,.8);\n        my=(target.y-p.y)/(d||1)*S.clamp((d-desired)/130,-.5,.8);\n        mx+=(480-p.x)/850;my+=(345-p.y)/750;\n      }\n    }\n    let danger=0,closest=Infinity;\n    for(const b of s.shots)if(b.foe){\n      const dx=p.x-b.x,dy=p.y-b.y,den=b.vx*b.vx+b.vy*b.vy;\n      const t=den?S.clamp((dx*b.vx+dy*b.vy)/den,0,.85):0;\n      const fx=b.x+b.vx*t,fy=b.y+b.vy*t,d=Math.hypot(p.x-fx,p.y-fy);\n      const now=S.dist(p,b);closest=Math.min(closest,now);\n      if(d<52&&now<220){\n        danger++;const force=(1-d/65)*1.6;const sign=p.x>fx?1:-1;\n        mx+=sign*force;my+=s.act===2?0:(p.y>fy?1:-1)*force*.6;\n      }\n    }\n    for(const e of s.enemies)if(e.tele<=0){\n      const d=S.dist(p,e);if(d<110){const force=(110-d)/80;mx+=(p.x-e.x)/(d||1)*force;my+=(p.y-e.y)/(d||1)*force;}\n    }\n    const drop=s.drops.filter(d=>S.dist(d,p)<230).sort((a,b)=>S.dist(a,p)-S.dist(b,p))[0];\n    if(drop&&(p.hp<p.maxHp||p.energy<35)&&danger<2){mx+=(drop.x-p.x)/100;my+=(drop.y-p.y)/100;}\n    if(s.act===1){const d=Math.hypot(p.x-480,p.y-277);if(d<130){mx+=(p.x-480)/(d||1);my+=(p.y-277)/(d||1);}}\n    if(p.x<75)mx+=1.3;if(p.x>885)mx-=1.3;\n    if(p.y<125)my+=1;if(p.y>435&&s.act\"'!==2)my-=1;\n    [out.mx,out.my]=S.norm(mx,my);if(s.act===2)out.my=0;\n    out.pulse=p.pulse<=0&&(closest<100||danger>1);\n    out.boost=p.energy>=28&&closest<36&&p.pulse>0;\n    return out;\n  }\n  Object.assign(S,{botIntent});\n})(globalThis.Fortnight);\nEOF\ncat > tools/sim-loader.mjs <<'\"'EOF'\nimport {readFileSync} from 'node:fs';\nimport vm from 'node:vm';\nexport function loadSim(){\n for(const file of ['src/data/balance.js','src/data/encounters.js','src/sim/world.js','src/sim/bot.js'])vm.runInThisContext(readFileSync(new URL('../'+file,import.meta.url),'utf8'),{filename:file});\n return globalThis.Fortnight;\n}\nEOF\nnode --input-type=module - <<'JS'\nimport {loadSim} from './tools/sim-loader.mjs';\nconst S=loadSim();\nfor (const n of [1,2,4]){\n const w=new S.World({seed:198113,players:Array.from({length:n},(_,id)=>({id,name:'BOT '+id}))});\n for(let i=0;i<110000&&\"'!w.s.result;i++){\n  for(const p of w.s.players){w.setIntent(p.id,S.botIntent(w,p.id,i));if(w.s.phase==='\"'upgrade')w.upgrade(p.id,p.id%3);}\n  w.step();\n }\n console.log(JSON.stringify({n,result:w.s.result,t:w.s.t,seen:w.s.seen,phases:w.s.bossPhases,hp:w.s.players.map(p=>p.hp),heat:w.s.heat,base:w.s.base,enemy:w.s.enemies.length}));\n}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"cat > src/sim/bot.js <<'EOF'\n(function(S){\n  'use strict';\n  function botIntent(world,id,seq){\n    const s=world.s,p=s.players.find(p=>p.id===id),out=S.neutral(seq);\n    if(\"'!p||p.hp<=0)return out;\n    const targets=s.enemies.filter(e=>e.hp>0&&e.tele<=0);\n    if(s.boss)targets.push(...s.boss.parts.filter(c=>c.hp>0&&c.open));\n    let target=null,score=Infinity;\n    for(const e of targets){\n      const urgency=e.kind==='\"'rammer'?-.55:e.kind==='anchor'?-.35:e.kind==='tractor'?-.3:e.component?-.9:e.kind==='dive'&&e.y>300?-.8:0;\n      const val=S.dist(p,e)*(1+urgency)+(e.kind==='relay'?-80:0);\n      if(val<score){score=val;target=e;}\n    }\n    let mx=0,my=0;\n    if(target){\n      const travel=S.dist(p,target)/730;\n      const tx=target.x+(target.vx||0)*travel,ty=target.y+(target.vy||0)*travel;\n      const a=Math.atan2(ty-p.y,tx-p.x);out.ax=Math.cos(a);out.ay=Math.sin(a);out.fire=true;\n      if(s.act===2)mx=S.clamp((target.x-p.x)/100,-1,1)*.65;\n      else {\n        const desired=target.kind==='anchor'?245:240;\n        const d=S.dist(p,target);mx=(target.x-p.x)/(d||1)*S.clamp((d-desired)/130,-.5,.8);\n        my=(target.y-p.y)/(d||1)*S.clamp((d-desired)/130,-.5,.8);\n        mx+=(480-p.x)/850;my+=(345-p.y)/750;\n      }\n    }\n    let danger=0,closest=Infinity;\n    for(const b of s.shots)if(b.foe){\n      const dx=p.x-b.x,dy=p.y-b.y,den=b.vx*b.vx+b.vy*b.vy;\n      const t=den?S.clamp((dx*b.vx+dy*b.vy)/den,0,.85):0;\n      const fx=b.x+b.vx*t,fy=b.y+b.vy*t,d=Math.hypot(p.x-fx,p.y-fy);\n      const now=S.dist(p,b);closest=Math.min(closest,now);\n      if(d<52&&now<220){\n        danger++;const force=(1-d/65)*1.6;const sign=p.x>fx?1:-1;\n        mx+=sign*force;my+=s.act===2?0:(p.y>fy?1:-1)*force*.6;\n      }\n    }\n    for(const e of s.enemies)if(e.tele<=0){\n      const d=S.dist(p,e);if(d<110){const force=(110-d)/80;mx+=(p.x-e.x)/(d||1)*force;my+=(p.y-e.y)/(d||1)*force;}\n    }\n    const drop=s.drops.filter(d=>S.dist(d,p)<230).sort((a,b)=>S.dist(a,p)-S.dist(b,p))[0];\n    if(drop&&(p.hp<p.maxHp||p.energy<35)&&danger<2){mx+=(drop.x-p.x)/100;my+=(drop.y-p.y)/100;}\n    if(s.act===1){const d=Math.hypot(p.x-480,p.y-277);if(d<130){mx+=(p.x-480)/(d||1);my+=(p.y-277)/(d||1);}}\n    if(p.x<75)mx+=1.3;if(p.x>885)mx-=1.3;\n    if(p.y<125)my+=1;if(p.y>435&&s.act\"'!==2)my-=1;\n    [out.mx,out.my]=S.norm(mx,my);if(s.act===2)out.my=0;\n    out.pulse=p.pulse<=0&&(closest<100||danger>1);\n    out.boost=p.energy>=28&&closest<36&&p.pulse>0;\n    return out;\n  }\n  Object.assign(S,{botIntent});\n})(globalThis.Fortnight);\nEOF\ncat > tools/sim-loader.mjs <<'\"'EOF'\nimport {readFileSync} from 'node:fs';\nimport vm from 'node:vm';\nexport function loadSim(){\n for(const file of ['src/data/balance.js','src/data/encounters.js','src/sim/world.js','src/sim/bot.js'])vm.runInThisContext(readFileSync(new URL('../'+file,import.meta.url),'utf8'),{filename:file});\n return globalThis.Fortnight;\n}\nEOF\nnode --input-type=module - <<'JS'\nimport {loadSim} from './tools/sim-loader.mjs';\nconst S=loadSim();\nfor (const n of [1,2,4]){\n const w=new S.World({seed:198113,players:Array.from({length:n},(_,id)=>({id,name:'BOT '+id}))});\n for(let i=0;i<110000&&\"'!w.s.result;i++){\n  for(const p of w.s.players){w.setIntent(p.id,S.botIntent(w,p.id,i));if(w.s.phase==='\"'upgrade')w.upgrade(p.id,p.id%3);}\n  w.step();\n }\n console.log(JSON.stringify({n,result:w.s.result,t:w.s.t,seen:w.s.seen,phases:w.s.bossPhases,hp:w.s.players.map(p=>p.hp),heat:w.s.heat,base:w.s.base,enemy:w.s.enemies.length}));\n}\nJS\"","aggregated_output":"{\"n\":1,\"result\":{\"won\":true,\"reason\":\"SIEGE BROKEN\",\"score\":47130,\"rank\":\"COMMODORE\",\"time\":549,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"SIEGE SHIP DESTROYED\",\"score\":6000}],\"modified\":false},\"t\":568.083333332981,\"seen\":[\"hunter\",\"bomber\",\"scout\",\"relay\",\"rammer\",\"tractor\",\"dive\"],\"phases\":[0,1,2],\"hp\":[8],\"heat\":0,\"base\":64.00000000000006,\"enemy\":0}\n{\"n\":2,\"result\":{\"won\":true,\"reason\":\"SIEGE BROKEN\",\"score\":47510,\"rank\":\"COMMODORE\",\"time\":549,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"SIEGE SHIP DESTROYED\",\"score\":6000}],\"modified\":false},\"t\":568.0249999996478,\"seen\":[\"hunter\",\"bomber\",\"scout\",\"relay\",\"rammer\",\"tractor\",\"dive\"],\"phases\":[0,1,2],\"hp\":[5,5],\"heat\":0,\"base\":68.32000000000005,\"enemy\":0}\n{\"n\":4,\"result\":{\"won\":true,\"reason\":\"SIEGE BROKEN\",\"score\":63590,\"rank\":\"COMMODORE\",\"time\":547,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"SIEGE SHIP DESTROYED\",\"score\":6000}],\"modified\":false},\"t\":566.341666666316,\"seen\":[\"hunter\",\"bomber\",\"scout\",\"relay\",\"rammer\",\"tractor\",\"dive\",\"anchor\"],\"phases\":[0,1,2],\"hp\":[6,6,6,6],\"heat\":0,\"base\":74.08000000000004,\"enemy\":0}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/data/encounters.js');s=p.read_text().replace(\\\"group(2,'scout',2),group(16\\\", \\\"group(2,'scout',2),group(5,'anchor',1),group(16\\\")\ns=s.replace('  const ACTS = [','  for (const wave of WAVES) { wave.min += 3; wave.deadline += 3; }\\\\n  const ACTS = [');p.write_text(s)\np=Path('src/sim/world.js');s=p.read_text().replace(\\\"if(kind==='anchor') {e.charge\\\", \\\"if(kind==='anchor') {e.charge\\\")\ns=s.replace(\\\"if(kind==='anchor') {e.charge=2.7\\\", \\\"if(kind==='anchor') {e.charge=2.7\\\")\ns=s.replace(\\\"if(g.side==='left')\\\", \\\"if(g.kind==='anchor')y=230;\\\\n        if(g.side==='left')\\\")\ns=s.replace(\\\"[-132,'battery',210], [132,'battery',210],[-74,'emitter',220],[74,'emitter',220],[0,'core',500]\\\", \\\"[-132,'battery',420], [132,'battery',420],[-74,'emitter',440],[74,'emitter',440],[0,'core',1200]\\\")\ns=s.replace(\\\"if(boss.phase<2&&boss.parts\\\", \\\"if(boss.phase<2&&boss.phaseAge>=18&&boss.parts\\\")\ns=s.replace(\\\"if(boss.parts[4].hp<=0)boss.dead=true;\\\", \\\"if(boss.parts[4].hp<=0&&boss.phaseAge>=18)boss.dead=true;\\\")\ns=s.replace(\\\"const groundAim = a => clamp(a > 0 ? a - Math.PI * 2 : a, -Math.PI + .15, -.15);\\\", \\\"const groundAim = a => a > 0 ? (Math.cos(a)>=0 ? -.15 : -Math.PI+.15) : clamp(a,-Math.PI+.15,-.15);\\\")\np.write_text(s)\nPY\nffmpeg -loglevel error -i docs/source-footage.mp4 -vf 'fps=1/70,scale=384:216,tile=3x2' -frames:v 1 docs/source-filmstrip.jpg\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
