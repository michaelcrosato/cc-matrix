layers.map(p=>p.x)')\n        keys_page.keyboard.down('a');keys_page.keyboard.down('ArrowRight');keys_page.keyboard.down('f');keys_page.keyboard.down('.')\n        keys_page.wait_for_timeout(220);keys_page.keyboard.up('a');keys_page.keyboard.up('ArrowRight');keys_page.keyboard.up('f');keys_page.keyboard.up('.')\n        state=keys_page.evaluate('({x:__fortnight.world.s.players.map(p=>p.x),shots:__fortnight.world.s.events.filter(e=>e.type===\\\\\\\"shot\\\\\\\").map(e=>e.owner)})')\n        need(state['x'][0]<before[0] and state['x'][1]>before[1],'Keyboard halves shared movement')\n        need(0 in state['shots'] and 1 in state['shots'],'Both keyboard fire controls did not work')\n    check('two native keyboard halves join and move/fire independently',keyboard_couch)\n    ctx.close()\n    ctx=browser.new_context(**pw.devices['iPad Pro 11']);tablet=ctx.new_page()\n    def tablet_touch():\n        boot(tablet);tablet.locator('.esh-ttl button').first.tap();tablet.wait_for_function('__fortnight.world');tablet.evaluate('__game.debug.advance(4,{draw:false})')\n        before=tablet.evaluate('__fortnight.world.s.players[0].x');session=ctx.new_cdp_session(tablet)\n        session.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'id':1,'x':160,'y':900},{'id':2,'x':670,'y':900}]})\n        session.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'id':1,'x':240,'y':900},{'id':2,'x':670,'y':840}]})\n        tablet.wait_for_timeout(180);need(tablet.evaluate('__fortnight.world.s.players[0].x')>before,'Tablet left thumb did not move')\n        need(tablet.evaluate('__fortnight.input.touch.size')==2,'Tablet multi-touch lost a contact')\n        session.send('Input.dispatchTouchEvent',{'type':'touchCancel','touchPoints':[]})\n        tablet.set_viewport_size({'width':1194,'height':834});tablet.wait_for_timeout(80)\n        need(tablet.evaluate('__game.W===960&&__game.H===540'),'Tablet rotation altered arena')\n        tablet.screenshot(path=str(ROOT/'evidence/touch-tablet.png'))\n    check('tablet multi-touch and rotation keep the fixed arena visible',tablet_touch)\n    ctx.close()\n'''\ns=s.replace(marker,new+marker)\n# A real loss through simulation, before the existing art scenarios.\nmarker=\\\"    def art_states():\\\"\nnew='''    def defeat_retry():\n        solo(page);page.evaluate('__game.debug.advance(800,{draw:false})')\n        page.wait_for_function('__fortnight.ui.shell.screen===\\\\\\\"results\\\\\\\"')\n        need(page.evaluate('__fortnight.world.s.result.won') is False,'Idle run did not lose')\n        page.screenshot(path=str(ROOT/'evidence/defeat.png'))\n        page.get_by_role('button',name='Fly again',exact=True).click();page.wait_for_function('__fortnight.world.s.phase===\\\\\\\"briefing\\\\\\\"')\n        need(page.evaluate('__fortnight.world.s.act===0&&__fortnight.world.s.score===0'),'Defeat retry was dirty')\n    check('packaged defeat and retry after both forced retreats',defeat_retry)\n\n'''\ns=s.replace(marker,new+marker)\n# A 2D-only browser is a useful independent engine smoke.\nmarker='    wk.close();webkit.close()'\ns=s.replace(marker,marker+'''\n    fox=pw.firefox.launch(headless=True);fc=fox.new_context(viewport={'width':1280,'height':720});fp=fc.new_page()\n    def firefox_smoke():\n        boot(fp);fp.locator('.esh-ttl button').first.click();fp.wait_for_function('__fortnight.world');fp.evaluate('__game.debug.advance(8,{bot:true})')\n        need(not fp.evaluate('__game.errors'),'Firefox Canvas 2D errors')\n        need(fp.evaluate('__fortnight.world.s.tick')>900,'Firefox world did not tick')\n    check('Firefox Canvas 2D standalone combat without WebGL',firefox_smoke)\n    fc.close();fox.close()\n''')\np.write_text(s)\nPY\nbiome check --write --linter-enabled=false --assist-enabled=false src tools/*.mjs tests/simulation.mjs package.json\nruff check --fix tests/browser_checks.py tools/*.py\nruff format tests/browser_checks.py tools/*.py\nnpm run build\nnode tools/verif