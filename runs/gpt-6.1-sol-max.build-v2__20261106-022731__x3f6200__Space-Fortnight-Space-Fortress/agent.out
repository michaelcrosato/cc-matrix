{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"cat > tools/input_diagnostics.py <<'EOF'\nfrom pathlib import Path\nimport json\nfrom playwright.sync_api import sync_playwright\nROOT=Path(__file__).resolve().parent.parent\nPAD=\\\"window.testPads=[{id:'DualSense',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))}];navigator.getGamepads=()=>testPads\\\"\nwith sync_playwright() as p:\n b=p.chromium.launch()\n c=b.new_context(viewport={'width':1920,'height':1080});c.add_init_script(PAD);pg=c.new_page();pg.goto((ROOT/'game.html').as_uri());pg.wait_for_function('window.__fortnight');pg.wait_for_timeout(300)\n pg.screenshot(path=str(ROOT/'evidence/title.png'))\n print('titlebox',pg.locator('.esh-ttl .esh-btns').bounding_box(),pg.evaluate('getComputedStyle(document.querySelector(\\\".esh-ttl\\\")).cssText'))\n def press(i,pad=0):\n  pg.evaluate('([b,p])=>testPads[p].buttons[b]={pressed:true,value:1}',[i,pad]);pg.wait_for_timeout(90);pg.evaluate('([b,p])=>testPads[p].buttons[b]={pressed:false,value:0}',[i,pad]);pg.wait_for_timeout(70)\n press(13);press(0)\n print('join',pg.evaluate('({mode:__fortnight.mode,join:__game._join,paused:__game.paused,screen:__fortnight.ui.shell.screen,pad:__game.input.padIndex,players:__game.players.map(p=>({player:p.player,pad:p.pad}))})'))\n pg.evaluate(\\\"for(let i=1;i<4;i++)testPads.push({id:'wing'+i,index:i,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))})\\\")\n for i in [1,2,3]:\n  press(9,i);print('seat',i,pg.evaluate('({mode:__fortnight.mode,join:__game._join,paused:__game.paused,screen:__fortnight.ui.shell.screen,players:__game.players.map(p=>({player:p.player,pad:p.pad})),err:__game.errors})'))\n c.close()\n c=b.new_context(**p.devices['iPhone 13']);pg=c.new_page();pg.goto((ROOT/'game.html').as_uri());pg.wait_for_function('window.__fortnight');pg.locator