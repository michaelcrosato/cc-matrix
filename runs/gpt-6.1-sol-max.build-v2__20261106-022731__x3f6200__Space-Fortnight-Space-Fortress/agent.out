{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat > src/render/assets.js <<'EOF'\n(function(S){\n  'use strict';\n  const E=My3D2dge;\n  // Rasterise bespoke mechanical panels to native string sprites. Every panel has a five-tone ramp.\n  function pixelAsset(w,h,paint){\n    const rows=Array.from({length:h},()=>Array(w).fill('.')),palette={};let index=33;\n    function key(color){let k=Object.keys(palette).find(k=>palette[k]===color);if(\"'!k){while(index===46||index===60||index===92)index++;k=String.fromCharCode(index++);palette[k]=color;}return k;}\n    const dot=(x,y,c)=>{x=Math.round(x);y=Math.round(y);if(rows[y]&&x>=0&&x<w)rows[y][x]=key(c);};\n    const rect=(x,y,ww,hh,c)=>{for(let yy=y;yy<y+hh;yy++)for(let xx=x;xx<x+ww;xx++)dot(xx,yy,c);};\n    function poly(pts,color){\n      const tones=E.tones(color),x0=Math.max(0,Math.floor(Math.min(...pts.map(p=>p[0])))),x1=Math.min(w-1,Math.ceil(Math.max(...pts.map(p=>p[0]))));\n      const y0=Math.max(0,Math.floor(Math.min(...pts.map(p=>p[1])))),y1=Math.min(h-1,Math.ceil(Math.max(...pts.map(p=>p[1]))));\n      for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++){\n        let inside=false;for(let i=0,j=pts.length-1;i<pts.length;j=i++){const a=pts[i],b=pts[j];if((a[1]>y)!==(b[1]>y)&&x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0])inside=!inside;}\n        if(inside){const v=(x-x0)/(x1-x0||1)*.36+(y-y0)/(y1-y0||1)*.64;\n          dot(x,y,v<.22?tones.lt:v>.72?tones.sh:tones.base);}\n      }\n      for(let i=0;i<pts.length;i++){const a=pts[i],b=pts[(i+1)%pts.length],n=Math.max(Math.abs(b[0]-a[0]),Math.abs(b[1]-a[1]));\n        for(let k=0;k<=n;k++)dot(a[0]+(b[0]-a[0])*k/(n||1),a[1]+(b[1]-a[1])*k/(n||1),i<2?tones.hi:tones.deep);}\n    }\n    paint({dot,rect,poly});return E.sprite(rows.map(r=>r.join('\"'')),palette);\n  }\n  function playerAsset(color,flame=0,seat=0){return pixelAsset(41,49,({rect,poly})=>{\n    if(flame){poly([[14,33],[12,41+flame*2],[20,37],[28,43+flame],[26,33]],'#eaa167');rect(17,35,7,6+flame,'#f8e9ad');}\n    poly([[20,1],[25,16],[36,32],[37,38],[27,34],[24,40],[16,40],[13,34],[3,38],[4,31],[15,16]],'#5b7188');\n    poly([[20,4],[23,21],[25,33],[20,38],[15,32],[17,20]],'#c5d4d6');\n    poly([[5,32],[14,24],[14,33],[6,35]],color);poly([[27,24],[35,32],[34,35],[27,33]],color);\n    poly([[20,13],[23,23],[22,28],[18,28],[17,23]],'#17384b');rect(19,17,2,7,'#a3edee');\n    rect(12,33,4,4,'#101d2d');rect(25,33,4,4,'#101d2d');rect(13,33,2,3,color);rect(26,33,2,3,color);\n    for(let i=0;i<=seat;i++)rect(6+i*2,32,1,3,'#f6e9c9');rect(19,5,2,5,'#f4d6a5');\n  });}\n  const playerColors=['#8ae5dc','#efbc6e','#ed9fbd','#b7d98c'];\n  const player=playerColors.map((c,i)=>({idle:playerAsset(c,0,i),thrust:E.anim([playerAsset(c,1,i),playerAsset(c,3,i),playerAsset(c,2,i)],14)}));\n  const enemy={\n    hunter:pixelAsset(31,37,({poly,rect})=>{\n      poly([[15,0],[23,15],[28,30],[21,27],[15,34],[9,27],[2,30],[7,15]],'#975d67');\n      poly([[15,4],[20,19],[15,28],[10,19]],'#d8a084');rect(13,12,5,7,'#fff0bd');rect(6,27,5,2,'#462c47');rect(20,27,5,2,'#462c47');}),\n    bomber:pixelAsset(61,41,({poly,rect})=>{\n      poly([[30,2],[43,10],[57,17],[58,32],[47,36],[37,30],[22,30],[12,36],[2,32],[3,17],[16,10]],'#8f7659');\n      poly([[30,5],[39,15],[37,29],[23,29],[21,15]],'#c5b68c');rect(26,12,9,6,'#131e2c');rect(28,12,5,2,'#e9c68a');\n      for(const x of [6,45]){rect(x,19,10,10,'#302c3d');rect(x+2,20,7,2,'#efb969');rect(x+3,25,5,3,'#aa624b');}\n      rect(24,28,13,7,'#242b3c');rect(28,30,5,4,'#ee9b68');}),\n    scout:pixelAsset(39,39,({poly,rect})=>{\n      poly([[19,1],[30,9],[35,22],[28,34],[10,34],[3,22],[8,9]],'#81759e');\n      poly([[19,7],[26,16],[24,26],[14,26],[12,16]],'#b9a9cf');rect(15,15,9,7,'#201e36');rect(17,16,5,4,'#e7d7ff');\n      rect(2,19,7,7,'#554664');rect(30,19,7,7,'#554664');rect(18,29,3,6,'#bf9ce9');}),\n    anchor:pixelAsset(39,39,({poly,rect})=>{\n      poly([[19,0],[24,12],[37,18],[26,24],[23,37],[15,37],[12,24],[1,18],[14,12]],'#6e618b');\n      poly([[19,10],[28,19],[19,28],[10,19]],'#cfb2ed');rect(15,15,9,9,'#211c3a');rect(17,17,5,5,'#f6e8ff');}),\n    rammer:pixelAsset(39,39,({poly,rect})=>{\n      poly([[19,1],[36,31],[30,37],[19,28],[8,37],[2,31]],'#b0756c');\n      poly([[19,7],[29,27],[19,22],[9,27]],'#e7af92');poly([[19,14],[24,24],[19,21],[14,24]],'#f6e4bc');\n      rect(6,29,6,3,'#421f36');rect(27,29,6,3,'#421f36');}),\n    tractor:pixelAsset(57,43,({poly,rect})=>{\n      poly([[5,2],[17,10],[20,21],[36,21],[39,9],[51,2],[54,30],[43,39],[13,39],[2,30]],'#796b90');\n      poly([[7,7],[14,12],[14,28],[7,30]],'#b6a5c5');poly([[49,7],[42,12],[42,28],[49,30]],'#b6a5c5');\n      rect(20,25,17,8,'#2b253a');rect(23,26,11,3,'#ddc4fa');rect(5,5,6,4,'#f7daee');rect(46,5,6,4,'#f7daee');}),\n    dive:pixelAsset(35,33,({poly,rect})=>{\n      poly([[17,2],[31,9],[29,23],[23,19],[17,30],[11,19],[5,23],[3,9]],'#a97d62');\n      poly([[17,4],[23,13],[17,22],[11,13]],'#e4bd84');rect(14,11,7,4,'#fff5c8');}),\n    relay:pixelAsset(55,55,({poly,rect})=>{\n      poly([[16,3],[39,3],[50,16],[50,39],[39,50],[16,50],[3,39],[3,16]],'#655869');\n      poly([[18,10],[36,10],[43,18],[43,36],[35,43],[18,43],[10,35],[10,18]],'#ad8294');\n      poly([[27,13],[40,27],[27,41],[14,27]],'#f0b7bd');poly([[27,19],[34,27],[27,35],[20,27]],'#893e61');rect(25,23,5,9,'#ffdfc8');\n      for(const x of [5,44])for(const y of [15,32])rect(x,y,4,5,'#e6b28e');}),\n  };\n  const drop=E.anim([0,1,2,1].map(i=>pixelAsset(23,23,({poly,rect})=>{\n    poly([[11,1],[20,11],[11,21],[2,11]],'#6d9694');poly([[11,4],[17,11],[11,18],[5,11]],'#bbefe0');rect(10,7+i,3,8-i*2,'#fff2bf');\n  })),8);\n  Object.assign(S,{ASSETS:{player,enemy,drop,playerColors},pixelAsset});\n})(globalThis.Fortnight);\nEOF\ncat > src/render/scene.js <<'EOF'\n(function(S){\n  'use strict';\n  const E=My3D2dge,{px}=E,C={navy:'#07141f',ink:'#0b1d2d',line:'#294354',cream:'#f0dfb4',cyan:'#8ae5dc',red:'#ec8b79',muted:'#7d98a9'};\n  const txt=(g,s,x,y,color=C.muted,scale=1,align='left')=>E.font.text(g,s,x,y,color,{scale,align,outline:false,shadow:'#050e18'});\n  function line(g,x0,y0,x1,y1,c,w=1){px.line(g,Math.round(x0),Math.round(y0),Math.round(x1),Math.round(y1),c,w);}\n  function ring(g,x,y,r,c,w=1,start=0,end=Math.PI*2){\n    const n=Math.ceil(r*.5),steps=Math.max(12,n);for(let i=0;i<steps;i++){\n      const a=start+(end-start)*i/steps,b=start+(end-start)*(i+1)/steps;line(g,x+Math.cos(a)*r,y+Math.sin(a)*r,x+Math.cos(b)*r,y+Math.sin(b)*r,c,w);}\n  }\n  function panel(g,x,y,w,h,color='#516c7c'){\n    const t=E.tones(color);px.rect(g,x,y,w,h,t.deep);px.rect(g,x+1,y+1,w-2,h-3,t.base);px.rect(g,x+1,y+1,w-2,2,t.lt);px.rect(g,x+w-3,y+2,2,h-5,t.sh);\n    if(w>14&&h>12)for(const dx of [3,w-5])for(const dy of [4,h-6])px.rect(g,x+dx,y+dy,2,2,t.deep);\n  }\n  function fortress(g,x,y,k,t,{heat=0,locks=[false,false,false,false],damaged=false}={}){\n    const P=(a,b)=>[x+a*k,y+b*k],R=(a,b,w,h,c)=>px.rect(g,...P(a,b),w*k,h*k,c),L=(a,b,c,d,col,w=1)=>line(g,...P(a,b),...P(c,d),col,w*k);\n    const round=(a,b,r,c,w=1)=>ring(g,...P(a,b),r*k,c,w*k);\n    // Four radiators are individually lit, locked and animated, attached to a continuous armored ring.\n    round(0,5,70,'#0c1b29',8);round(0,1,67,'#8b9a9b',2);round(0,2,61,'#273f50',7);\n    for(let i=0;i<4;i++){\n      const a=i*Math.PI/2+Math.PI/4,rx=Math.cos(a)*64,ry=Math.sin(a)*64;\n      const locked=locks[i],col=locked?'#c09bce':heat>65?'#d77d65':'#67a49e';\n      panel(g,x+(rx-16)*k,y+(ry-12)*k,32*k,24*k,col);\n      for(let j=0;j<5;j++)R(rx-11+j*5,ry-8,2,16,locked?'#493951':heat>65?'#f5b98b':Math.sin(t*2+j)>.1?'#b6e6c8':'#578d8d');\n      if(locked)L(rx-11,ry-8,rx+11,ry+8,'#f0d6ff',2);\n      else if(heat>2)for(let n=0;n<3;n++){\n        const d=(t*8+n*8)%23;px.blend(g,(1-d/24)*.25,'add',()=>R(rx+(i===0||i===3?1:-1)*d-8,ry+(i<2?1:-1)*d-5,15,9,'#93dcc6'));}\n    }\n    px.poly(g,[P(-43,-40),P(-22,-60),P(22,-60),P(43,-40),P(43,34),P(24,52),P(-24,52),P(-43,34)],'#263e50');\n    px.poly(g,[P(-40,-40),P(-21,-55),P(21,-55),P(39,-39),P(39,31),P(22,47),P(-21,47),P(-40,31)],'#5b7280');\n    R(-36,-34,72,4,'#a8b6ad');R(-34,25,68,9,'#1a2c3c');\n    for(const sign of [-1,1]){\n      panel(g,x+(sign*26-11)*k,y-31*k,22*k,55*k,'#708792');\n      for(let i=0;i<6;i++)R(sign*26-7,-24+i*7,13,2,i===Math.floor(t*2)%6?'#d5e8cd':'#304b5e');\n    }\n    R(-11,-45,22,79,'#21354a');R(-7,-42,14,64,'#9caeae');R(-4,-39,3,49,'#dce0bf');\n    round(0,0,25,'#253749',6);round(0,-2,22,'#b2b69a',2);round(0,-2,18,'#273f4c',5);\n    px.disc(g,x,y-2*k,13*k,'#315d64');px.disc(g,x-3*k,y-5*k,8*k,heat>70?'#e9a17b':'#a3d5c1');\n    R(-3,-10,6,16,'#def0cf');R(-8,-5,16,5,'#def0cf');\n    // Antenna masts, docking clamps, windows and the thirteen stencil.\n    L(-18,-49,-18,-86,'#8c9fa4',1);L(-18,-81,-10,-81,'#b5c5b6');\n    R(-20,-89,4,3,Math.sin(t*3)>0?'#ebac7c':'#5d5960');\n    L(22,-43,22,-73,'#8c9fa4');round(22,-76,8,'#98afa8');L(16,-80,28,-71,'#d9dbc0');\n    R(-12,38,24,7,'#1c3445');txt(g,'13',x,y+37*k,C.cream,Math.max(1,Math.round(k)), 'center');\n    for(const dx of [-38,34])R(dx,38,5,8,'#c4ba92');\n    if(damaged){R(12,-36,12,13,'#1a2835');L(13,-35,24,-23,'#c78164',2);R(-36,15,10,7,'#1a2835');}\n  }\n  function siege(g,x,y,k,t,boss){\n    const P=(a,b)=>[x+a*k,y+b*k],R=(a,b,w,h,c)=>px.rect(g,...P(a,b),w*k,h*k,c);\n    px.poly(g,[P(-173,-18),P(-125,-38),P(-88,-27),P(-44,-54),P(44,-54),P(88,-27),P(125,-38),P(173,-18),P(157,26),P(103,31),P(61,47),P(-61,47),P(-103,31),P(-157,26)],'#172635');\n    px.poly(g,[P(-169,-18),P(-124,-34),P(-87,-22),P(-43,-48),P(43,-48),P(87,-22),P(124,-34),P(169,-18),P(153,21),P(100,24),P(59,40),P(-59,40),P(-100,24),P(-153,21)],'#59606e');\n    for(const sign of [-1,1]){\n      panel(g,x+(sign*115-35)*k,y-21*k,70*k,40*k,'#615b69');\n      R(sign*115-29,-17,58,3,'#a99b9c');\n      for(let j=0;j<6;j++)R(sign*115-25+j*9,-8,5,14,'#252738');\n      R(sign*80-12,-20,24,53,'#303447');R(sign*80-8,-16,4,37,'#b096a4');\n    }\n    panel(g,x-49*k,y-42*k,98*k,71*k,'#6b6972');\n    px.poly(g,[P(0,-36),P(32,-8),P(24,27),P(0,41),P(-24,27),P(-32,-8)],'#2b3444');\n    ring(g,x,y+6*k,22*k,'#8e758b',4*k);ring(g,x,y+6*k,15*k,'#bd8e9d',2*k);\n    R(-13,-21,26,7,'#1c2939');for(let j=0;j<5;j++)R(-11+j*5,-20,3,3,'#f6a17f');\n    for(let j=0;j<11;j++)R(-80+j*16,32,7,3,j===Math.floor(t*3)%11?'#f1c79a':'#9d7174');\n    if(\"'!boss){R(-6,1,12,14,'\"'#ecb0a2');return;}\n    for(const c of boss.parts){\n      const cx=c.x,cy=c.y,alive=c.hp>0,col=\"'!alive?'\"'#17232f':c.hit>0?'#f7edcb':c.open?'#f5b791':'#6e6c79';\n      panel(g,cx-(c.kind==='core'?21:14),cy-12,c.kind==='core'?42:28,26,alive?'#746579':'#283442');\n      if(alive){px.poly(g,[[cx,cy-10],[cx+9,cy],[cx,cy+13],[cx-9,cy]],col);\n        if(c.open){ring(g,cx,cy,23+Math.sin(t*5)*2,'#ecc5a0');txt(g,'FIRE',cx,cy+30,C.cream,1,'center');}\n      }else{line(g,cx-10,cy-8,cx+11,cy+8,'#956a67',2);px.rect(g,cx-5,cy-2,10,7,'#111c29');}\n    }\n  }\n  class Painter{\n    constructor(game){this.game=game;this.lastEvent=0;this.shake=0;\n      this.bg=new E.Backdrop({sky:['#040e18','#0b2033','#152e42'],stars:170,moon:{x:.83,y:.28,r:62,color:'#466a7a'},\n        layers:[{kind:'clouds',color:'#1c4553',y:.35,height:.44,parallax:.015,drift:1,nebula:true,seed:23},{kind:'clouds',color:'#30304b',y:.68,height:.3,parallax:.01,drift:.5,nebula:true,seed:7}]});\n    }\n    background(r,t,act=0){\n      this.bg.draw(r);r.starfield({count:90,speed:act===2?1:4,dir:'down'});\n      r.overlay(g=>{\n        // Survey grid, navigation scars and debris make a single place across the retreat.\n        for(let x=0;x<960;x+=80)for(let y=90;y<480;y+=64){px.dot(g,x,y,'#244052');}\n        for(let i=0;i<16;i++){const x=(i*173+31)%960,y=100+(i*97)%365;\n          if(i%3===0)line(g,x,y,x+7,y-4,'#34505d');else px.rect(g,x,y,2+i%3,2,'#254053');}\n        ring(g,480,277,210,'#17394a');ring(g,480,277,278,'#173444');\n        if(act===2){\n          // Same planet, now a damaged industrial horizon and a mechanically detailed gun rail.\n          for(let i=0;i<23;i++){const x=i*45,h=12+(i*19)%52;\n            px.rect(g,x,462-h,38,h,'#203747');px.rect(g,x+3,464-h,25,3,'#3c5360');\n            for(let j=0;j<4;j++)px.rect(g,x+7+j*7,470-h,3,5,'#6e897e');}\n          px.rect(g,0,482,960,58,'#102332');px.rect(g,0,481,960,4,'#97a8a5');\n          for(let i=0;i<32;i++){panel(g,i*32,494,30,24,'#344d5d');px.rect(g,i*32+8,487,12,2,'#d1bc83');}\n          for(let j=0;j<3;j++)line(g,0,505+j*9,960,505+j*9,'#193444');\n        }\n      });\n    }\n    title(r,t){\n      this.background(r,t,0);\n      r.overlay(g=>{\n        // A technical poster made from the actual installation and fleet, all in motion.\n        ring(g,700,290,175,'#3c5b65',1);ring(g,700,290,194,'#2e4b58');\n        for(let i=0;i<48;i++){const a=i*Math.PI/24;line(g,700+Math.cos(a)*184,290+Math.sin(a)*184,700+Math.cos(a)*(i%4===0?195:190),290+Math.sin(a)*(i%4===0?195:190),'#527279');}\n        siege(g,774,77,.72,t);fortress(g,700,292,1.65,t,{heat:20});\n        line(g,727,174,863,151,C.muted);txt(g,'FORTRESS 13',814,135,C.cream,1);\n        txt(g,'RADIATOR ARRAY / ONLINE',590,452,C.cyan,1);\n        line(g,569,447,615,411,'#517570');line(g,863,325,911,349,'#517570');txt(g,'CORE',865,354,C.muted);\n        // Left gradient is native stepped alpha, with no painting outside the engine.\n        for(let i=0;i<15;i++)px.blend(g,.42-i*.025,'normal',()=>px.rect(g,i*35,0,35,540,'#07131f'));\n        txt(g,'FORTRESS COMMAND // SECTOR 13',57,63,C.cyan,1);\n        E.font.title(g,'SPACE',56,108,{scale:7,colors:['#fff1cf','#e8cf9c','#b89869'],outline:'#0a1a28',depth:3,depthColor:'#495362'});\n        E.font.title(g,'FORTNIGHT',56,176,{scale:7,colors:['#fff1cf','#e8cf9c','#b89869'],outline:'#0a1a28',depth:3,depthColor:'#495362'});\n        px.rect(g,57,249,48,3,C.cyan);txt(g,'THREE LINES. ONE LAST STAND.',119,245,C.cream,1);\n        txt(g,'A SIEGE IN THREE MOVEMENTS',57,284,C.muted,1);\n        txt(g,'01  INTERCEPT    02  DEFEND    03  HOLD',57,305,C.muted,1);\n        txt(g,'CENTURY / 1981 REIMAGINED',57,503,'#648392',1);\n        txt(g,'VIPER WING - STANDING BY',905,504,C.cyan,1,'right');\n      });\n      for(let i=0;i<3;i++){\n        const a=t*.18+i*2.2,x=700+Math.cos(a)*230,y=292+Math.sin(a)*122;\n        r.sprite(x,y,0,S.ASSETS.player[i].thrust,{t,rot:a+Math.PI,anchor:'center',scale:.8});\n      }\n    }\n    events(s){\n      for(const e of s.events)if(e.id>this.lastEvent){\n        if(['hurt','objective','component'].includes(e.type))this.shake=Math.max(this.shake,e.type==='component'?5:2);\n      }\n      this.lastEvent=s.eventSeq;\n    }\n    draw(r,s,t,opts={}){\n      this.events(s);this.background(r,t,s.act);\n      if(s.act===0)r.overlay(g=>{fortress(g,805,330,.42,t,{damaged:false});siege(g,610,104,.48,t);txt(g,'FORTRESS 13 / 18 km',784,375,'#637f8b',1,'center');});\n      if(s.act===1){r.actor(480,277,0,(g,ox,oy)=>fortress(g,ox,oy,1,t,{heat:s.heat,locks:s.locks,damaged:\"'!s.outcomes[0]?.held}));}\n      if(s.act===2&&!s.boss)r.overlay(g=>{siege(g,480+Math.sin(t*.1)*100,124,.65,t);txt(g,'\"'THE NIGHT ADMIRAL',480,177,'#aa858a',1,'center');});\n      if(s.boss){const boss=s.boss,cx=boss.parts[4].x,cy=boss.parts[4].y-15;r.overlay(g=>{\n        siege(g,cx,cy,1,t,boss);\n        const cycle=boss.phaseAge%8;\n        if(cycle<1.5){\n          for(const c of boss.parts.filter(c=>c.hp>0&&(boss.phase===0?c.index<2:boss.phase===1?c.index===2||c.index===3:c.index===4))){\n            const p=s.players.find(p=>p.hp>0&&\"'!p.gone);if(p){line(g,c.x,c.y,p.x,480,'\"'#715d68');ring(g,p.x,457,20,'#e4ae8f');}}\n          txt(g,boss.phase===0?'BATTERIES ACQUIRING':boss.phase===1?'TRACTOR EMITTERS OPENING':'CORE VOLLEY CHARGING',cx,cy+81,C.red,1,'center');\n        }\n        if(boss.phase===1&&cycle>1.5&&cycle<5.5)for(const c of boss.parts.slice(2,4))if(c.hp>0){const p=s.players.find(p=>p.hp>0&&\"'!p.gone);if(p){line(g,c.x,c.y,p.x,p.y,'\"'#ac93bf',2);ring(g,p.x,p.y,27,'#a48dbd');}}\n      });}\n      r.overlay(g=>{\n        for(const e of s.enemies){\n          if(e.tele>0){ring(g,e.x,e.y,e.r+8+e.tele*8,'#bfa98a');line(g,e.x-6,e.y,e.x+6,e.y,C.cream);line(g,e.x,e.y-6,e.x,e.y+6,C.cream);txt(g,'INBOUND',e.x,e.y+e.r+20,C.muted,1,'center');continue;}\n          if(e.kind==='anchor'){\n            for(let i=0;i<4;i++){const rad=25+(1-(t*.55+i/4)%1)*145;ring(g,e.x,e.y,rad,e.charge>0?'#615379':'#9c8ab7',e.charge>0?1:2);}\n            ring(g,e.x,e.y,24,'#dbc7f2');txt(g,e.charge>0?'GRAVITY CHARGING':'GRAVITY ACTIVE',e.x,e.y-40,'#dfcef3',1,'center');\n          }\n          if(e.wind>0&&e.kind==='hunter'){const p=s.players.find(p=>p.id===e.target);if(p)line(g,e.x,e.y,p.x,p.y,'#b17c72');}\n          if(e.wind>0&&e.kind==='bomber'){\n            px.blend(g,.15,'normal',()=>px.rect(g,e.lane-20,100,40,380,'#e6ac70'));\n            for(let j=0;j<9;j++){const yy=110+j*40+(t*25)%40;line(g,e.lane-16,yy,e.lane,yy+12,'#e2b47e');line(g,e.lane,yy+12,e.lane+16,yy,'#e2b47e');}\n            txt(g,'BOMB LANE',e.lane,441,'#f0cc91',1,'center');\n          }\n          if(e.kind==='rammer'&&\"'!e.launched){const target=s.act===1?{x:480,y:277}:s.players.find(p=>p.hp>0);if(target)line(g,e.x,e.y,target.x,target.y,'\"'#a27170');}\n          if(e.kind==='tractor'&&e.wind>0){const p=s.players.find(p=>p.id===e.target),target=e.lock>=0?{x:480+[-48,48,48,-48][e.lock],y:277+[48,48,-48,-48][e.lock]}:p;\n            if(target){line(g,e.x,e.y,target.x,target.y,e.wind<3.1?'#ceb6e0':'#74677f',e.wind<3.1?2:1);txt(g,e.wind<3.1?'LOCK':'ACQUIRING',e.x,e.y-32,'#dfc7eb',1,'center');}}\n          if(e.kind==='dive'&&e.launched&&e.wind>0)line(g,e.x,e.y,e.x+e.vx*3,480,'#bb9b71');\n        }\n      });\n      for(const d of s.drops)r.sprite(d.x,d.y,0,S.ASSETS.drop,{t,anchor:'center',glow:.4});\n      for(const e of s.enemies){if(e.tele>0)continue;const rot=e.kind==='anchor'||e.kind==='relay'?0:e.kind==='rammer'&&e.launched?Math.atan2(e.vy,e.vx)+Math.PI/2:e.kind==='dive'?0:e.a+Math.PI/2;\n        r.sprite(e.x,e.y,0,S.ASSETS.enemy[e.kind],{anchor:'center',rot,flash:e.hit>0?'#fff0d3':null,scale:1});\n        if(e.hp<e.maxHp)r.overlay(g=>{px.rect(g,e.x-16,e.y-e.r-10,32,3,'#243646');px.rect(g,e.x-16,e.y-e.r-10,32*e.hp/e.maxHp,3,'#d7a27e');});\n      }\n      for(const [i,p] of s.players.entries()){\n        if(p.gone||p.hp<=0)continue;const transition=s.phase==='retreat',off=transition?(4.5-s.phaseTime)*100:0;\n        const ship=S.ASSETS.player[i%4],spr=p.thrust>.1||p.boost>0||transition?ship.thrust:ship.idle;\n        if(s.act===2)r.overlay(g=>{panel(g,p.x-28,p.y+10,56,13,'#607986');for(const dx of [-25,17]){px.rect(g,p.x+dx,p.y+22,9,5,'#0b1926');px.rect(g,p.x+dx+1,p.y+23,7,2,'#8b9d9c');}});\n        const xx=p.x,yy=p.y+off;\n        if(p.boost>0)for(let j=1;j<4;j++)r.sprite(xx-p.vx*.025*j,yy-p.vy*.025*j,0,ship.idle,{rot:p.a+Math.PI/2,anchor:'center',alpha:.2*(1-j/4)});\n        r.sprite(xx-Math.cos(p.a)*p.recoil*20,yy-Math.sin(p.a)*p.recoil*20,0,spr,{t,rot:p.a+Math.PI/2,anchor:'center',flash:p.hit>0?'#fff6d8':null});\n        r.overlay(g=>{\n          if(p.inv>0&&(\"'!this.game.settings.reducedFlashes||Math.floor(t*10)%2===0))ring(g,xx,yy,27,'\"'#9edcd6',1);\n          txt(g,String(i+1).padStart(2,'0'),xx+27,yy-15,p.color,1);\n          px.rect(g,xx-14,yy+28,28,3,'#1b3343');px.rect(g,xx-14,yy+28,28*p.energy/p.maxEnergy,3,p.color);\n          if(p.pulse<=0){px.rect(g,xx-3,yy+33,6,2,'#dce8bd');}else px.rect(g,xx-3,yy+33,6*(1-p.pulse/(s.balance.pulseCooldown*Math.pow(.75,p.upgrades.pulse))),2,'#69898f');\n        });\n      }\n      r.overlay(g=>{\n        for(const b of s.shots){const col=b.foe?b.bomb?'#f7bf7a':'#f1a490':'#b5f6e5';\n          if(b.bomb){px.disc(g,b.x,b.y,8,'#5c4b4b');ring(g,b.x,b.y,7,'#efba7c',2);px.rect(g,b.x-2,b.y-2,4,4,'#ffecd0');}\n          else{line(g,b.px-b.vx*.012,b.py-b.vy*.012,b.x,b.y,col,b.foe?3:3);line(g,b.px,b.py,b.x,b.y,'#fff4d3',1);}\n        }\n        for(const f of s.effects){const u=f.t/f.life;if(f.kind==='pulse'){ring(g,f.x,f.y,8+f.size*u,'#a6eee3',3*(1-u)+1);ring(g,f.x,f.y,8+f.size*u*.8,'#638e94');}\n          else{const rad=f.size*(.1+u*.9);if(u<.3)px.disc(g,f.x,f.y,rad*(1-u),u<.15?'#fff0ca':'#eabc84');\n            ring(g,f.x,f.y,rad,u<.35?'#f5cc94':'#826c6f');\n            for(let i=0;i<10;i++){const a=i*2.399+f.id;const rr=rad*(.7+(i%3)*.15);px.rect(g,f.x+Math.cos(a)*rr,f.y+Math.sin(a)*rr,Math.max(1,4-u*3),2,u<.6?'#e1b083':'#6f656b');}}\n        }\n        if(s.options.overlays){\n          for(const e of s.enemies)ring(g,e.x,e.y,e.r,'#f3d77f');for(const p of s.players)if(p.hp>0)ring(g,p.x,p.y,10,'#80f1da');\n          txt(g,\"'`SEED ${s.seed}   TICK ${s.tick}   ENTITIES ${s.enemies.length}   SHOTS ${s.shots.length}`,35,463,C.cream);\n        }\n        if(s.phase==='\"'briefing'||s.phase==='retreat'){\n          px.blend(g,.68,'normal',()=>px.rect(g,110,192,740,126,'#0a1b29'));\n          const label=s.phase==='briefing'?S.ACTS[s.act].name:s.outcomes[s.act]?.held?'LINE SECURED / FALL BACK':'EMERGENCY EXTRACTION';\n          txt(g,s.phase==='briefing'?\"'`DEFENSIVE LINE ${S.ACTS[s.act].code}`:'\"'FORTRESS COMMAND',480,207,C.cyan,1,'center');\n          E.font.title(g,label,480,232,{align:'center',scale:3,colors:['#fff0cb','#c5ac85'],depth:1});\n          txt(g,s.phase==='briefing'?S.ACTS[s.act].objective:'KEEP YOUR WING TOGETHER',480,278,C.cream,1,'center');\n        }\n        if(opts.demo){px.rect(g,390,84,180,24,'#102a3a');txt(g,'DEMO / AUTOPILOT',480,91,C.cream,1,'center');txt(g,'ANY INPUT RETURNS TO COMMAND',480,508,C.cream,1,'center');}\n      });\n      if(\"'!opts.hideHUD)this.hud(r,s,t);\n    }\n    hud(r,s,t){r.overlay(g=>{\n      px.rect(g,0,0,960,76,'\"'#0a1926');line(g,30,76,930,76,'#48606a');\n      txt(g,\"'`LINE ${S.ACTS[s.act].code} / ${S.ACTS[s.act].name}`,31,17,C.cyan,1);\n      txt(g,s.boss?'\"'THE NIGHT ADMIRAL':S.WAVES[s.wave]?.title||'SIEGE BROKEN',31,39,C.cream,2);\n      txt(g,'TEAM SCORE',929,15,C.muted,1,'right');txt(g,String(s.score).padStart(7,'0'),929,34,C.cream,3,'right');\n      txt(g,\"'`CHAIN x${s.multiplier}`,742,54,s.multiplier>1?C.cyan:C.muted,1,'\"'right');\n      const label=s.act===0?'ESCORT LINE':s.act===1?'FORTRESS HEAT':'BASE INTEGRITY';\n      const value=s.act===0?Math.min(1,(s.wave*3+s.waveTime/(S.WAVES[s.wave]?.min||60)*3)/9):s.act===1?s.heat/100:s.base/100;\n      txt(g,label,539,15,s.act===1&&s.heat>65?C.red:C.muted,1);\n      px.rect(g,539,31,180,9,'#1a3040');px.rect(g,540,32,178*value,7,s.act===1?value>.65?C.red:'#e6bf79':C.cyan);\n      txt(g,s.act===1?\"'`${Math.round(s.heat)}% / ${s.locks.filter(v=>!v).length} RADIATORS`:s.act===2?`${Math.ceil(s.base)}% / HOLD THE RAIL`:`BEAT ${s.wave+1} / 3`,539,50,C.muted,1);\n      if(s.boss){const boss=s.boss,total=boss.parts.reduce((v,c)=>v+c.maxHp,0),hp=boss.parts.reduce((v,c)=>v+c.hp,0);\n        px.rect(g,260,85,440,14,'\"'#1a2a39');px.rect(g,261,86,438*hp/total,12,'#b5777e');\n        txt(g,['I / SIDE BATTERIES','II / TRACTOR EMITTERS','III / EXPOSED CORE'][boss.phase],480,107,C.cream,1,'center');}\n      if(s.act\"'!==2){px.rect(g,0,488,960,52,'\"'#091b29');line(g,30,488,930,488,'#48606a');}\n      const players=s.players.filter(p=>\"'!p.gone),width=Math.min(220,850/players.length);\n      for(const [i,p]of players.entries()){\n        const x=31+i*width;txt(g,`${String(i+1).padStart(2,'\"'0')} \"'${p.name}`,x,498,p.color,1);\n        if(p.hp<=0)txt(g,`REDEPLOY ${Math.ceil(p.dead)}s`,x,516,C.red,1);\n        else{for(let j=0;j<p.maxHp;j++)px.rect(g,x+j*8,516,6,7,j<p.hp?p.color:'\"'#28404d');\n          txt(g,p.pulse<=0?'PULSE READY':\"'`PULSE ${Math.ceil(p.pulse)}s`,x+85,516,p.pulse<=0?C.cream:C.muted,1);}\n      }\n      if(s.modified)txt(g,'\"'MODIFIED RUN',929,518,'#b6a0c6',1,'right');\n    });}\n  }\n  Object.assign(S,{Painter,fortress,siege,ring,panel,txt,C});\n})(globalThis.Fortnight);\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat > src/render/assets.js <<'EOF'\n(function(S){\n  'use strict';\n  const E=My3D2dge;\n  // Rasterise bespoke mechanical panels to native string sprites. Every panel has a five-tone ramp.\n  function pixelAsset(w,h,paint){\n    const rows=Array.from({length:h},()=>Array(w).fill('.')),palette={};let index=33;\n    function key(color){let k=Object.keys(palette).find(k=>palette[k]===color);if(\"'!k){while(index===46||index===60||index===92)index++;k=String.fromCharCode(index++);palette[k]=color;}return k;}\n    const dot=(x,y,c)=>{x=Math.round(x);y=Math.round(y);if(rows[y]&&x>=0&&x<w)rows[y][x]=key(c);};\n    const rect=(x,y,ww,hh,c)=>{for(let yy=y;yy<y+hh;yy++)for(let xx=x;xx<x+ww;xx++)dot(xx,yy,c);};\n    function poly(pts,color){\n      const tones=E.tones(color),x0=Math.max(0,Math.floor(Math.min(...pts.map(p=>p[0])))),x1=Math.min(w-1,Math.ceil(Math.max(...pts.map(p=>p[0]))));\n      const y0=Math.max(0,Math.floor(Math.min(...pts.map(p=>p[1])))),y1=Math.min(h-1,Math.ceil(Math.max(...pts.map(p=>p[1]))));\n      for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++){\n        let inside=false;for(let i=0,j=pts.length-1;i<pts.length;j=i++){const a=pts[i],b=pts[j];if((a[1]>y)!==(b[1]>y)&&x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0])inside=!inside;}\n        if(inside){const v=(x-x0)/(x1-x0||1)*.36+(y-y0)/(y1-y0||1)*.64;\n          dot(x,y,v<.22?tones.lt:v>.72?tones.sh:tones.base);}\n      }\n      for(let i=0;i<pts.length;i++){const a=pts[i],b=pts[(i+1)%pts.length],n=Math.max(Math.abs(b[0]-a[0]),Math.abs(b[1]-a[1]));\n        for(let k=0;k<=n;k++)dot(a[0]+(b[0]-a[0])*k/(n||1),a[1]+(b[1]-a[1])*k/(n||1),i<2?tones.hi:tones.deep);}\n    }\n    paint({dot,rect,poly});return E.sprite(rows.map(r=>r.join('\"'')),palette);\n  }\n  function playerAsset(color,flame=0,seat=0){return pixelAsset(41,49,({rect,poly})=>{\n    if(flame){poly([[14,33],[12,41+flame*2],[20,37],[28,43+flame],[26,33]],'#eaa167');rect(17,35,7,6+flame,'#f8e9ad');}\n    poly([[20,1],[25,16],[36,32],[37,38],[27,34],[24,40],[16,40],[13,34],[3,38],[4,31],[15,16]],'#5b7188');\n    poly([[20,4],[23,21],[25,33],[20,38],[15,32],[17,20]],'#c5d4d6');\n    poly([[5,32],[14,24],[14,33],[6,35]],color);poly([[27,24],[35,32],[34,35],[27,33]],color);\n    poly([[20,13],[23,23],[22,28],[18,28],[17,23]],'#17384b');rect(19,17,2,7,'#a3edee');\n    rect(12,33,4,4,'#101d2d');rect(25,33,4,4,'#101d2d');rect(13,33,2,3,color);rect(26,33,2,3,color);\n    for(let i=0;i<=seat;i++)rect(6+i*2,32,1,3,'#f6e9c9');rect(19,5,2,5,'#f4d6a5');\n  });}\n  const playerColors=['#8ae5dc','#efbc6e','#ed9fbd','#b7d98c'];\n  const player=playerColors.map((c,i)=>({idle:playerAsset(c,0,i),thrust:E.anim([playerAsset(c,1,i),playerAsset(c,3,i),playerAsset(c,2,i)],14)}));\n  const enemy={\n    hunter:pixelAsset(31,37,({poly,rect})=>{\n      poly([[15,0],[23,15],[28,30],[21,27],[15,34],[9,27],[2,30],[7,15]],'#975d67');\n      poly([[15,4],[20,19],[15,28],[10,19]],'#d8a084');rect(13,12,5,7,'#fff0bd');rect(6,27,5,2,'#462c47');rect(20,27,5,2,'#462c47');}),\n    bomber:pixelAsset(61,41,({poly,rect})=>{\n      poly([[30,2],[43,10],[57,17],[58,32],[47,36],[37,30],[22,30],[12,36],[2,32],[3,17],[16,10]],'#8f7659');\n      poly([[30,5],[39,15],[37,29],[23,29],[21,15]],'#c5b68c');rect(26,12,9,6,'#131e2c');rect(28,12,5,2,'#e9c68a');\n      for(const x of [6,45]){rect(x,19,10,10,'#302c3d');rect(x+2,20,7,2,'#efb969');rect(x+3,25,5,3,'#aa624b');}\n      rect(24,28,13,7,'#242b3c');rect(28,30,5,4,'#ee9b68');}),\n    scout:pixelAsset(39,39,({poly,rect})=>{\n      poly([[19,1],[30,9],[35,22],[28,34],[10,34],[3,22],[8,9]],'#81759e');\n      poly([[19,7],[26,16],[24,26],[14,26],[12,16]],'#b9a9cf');rect(15,15,9,7,'#201e36');rect(17,16,5,4,'#e7d7ff');\n      rect(2,19,7,7,'#554664');rect(30,19,7,7,'#554664');rect(18,29,3,6,'#bf9ce9');}),\n    anchor:pixelAsset(39,39,({poly,rect})=>{\n      poly([[19,0],[24,12],[37,18],[26,24],[23,37],[15,37],[12,24],[1,18],[14,12]],'#6e618b');\n      poly([[19,10],[28,19],[19,28],[10,19]],'#cfb2ed');rect(15,15,9,9,'#211c3a');rect(17,17,5,5,'#f6e8ff');}),\n    rammer:pixelAsset(39,39,({poly,rect})=>{\n      poly([[19,1],[36,31],[30,37],[19,28],[8,37],[2,31]],'#b0756c');\n      poly([[19,7],[29,27],[19,22],[9,27]],'#e7af92');poly([[19,14],[24,24],[19,21],[14,24]],'#f6e4bc');\n      rect(6,29,6,3,'#421f36');rect(27,29,6,3,'#421f36');}),\n    tractor:pixelAsset(57,43,({poly,rect})=>{\n      poly([[5,2],[17,10],[20,21],[36,21],[39,9],[51,2],[54,30],[43,39],[13,39],[2,30]],'#796b90');\n      poly([[7,7],[14,12],[14,28],[7,30]],'#b6a5c5');poly([[49,7],[42,12],[42,28],[49,30]],'#b6a5c5');\n      rect(20,25,17,8,'#2b253a');rect(23,26,11,3,'#ddc4fa');rect(5,5,6,4,'#f7daee');rect(46,5,6,4,'#f7daee');}),\n    dive:pixelAsset(35,33,({poly,rect})=>{\n      poly([[17,2],[31,9],[29,23],[23,19],[17,30],[11,19],[5,23],[3,9]],'#a97d62');\n      poly([[17,4],[23,13],[17,22],[11,13]],'#e4bd84');rect(14,11,7,4,'#fff5c8');}),\n    relay:pixelAsset(55,55,({poly,rect})=>{\n      poly([[16,3],[39,3],[50,16],[50,39],[39,50],[16,50],[3,39],[3,16]],'#655869');\n      poly([[18,10],[36,10],[43,18],[43,36],[35,43],[18,43],[10,35],[10,18]],'#ad8294');\n      poly([[27,13],[40,27],[27,41],[14,27]],'#f0b7bd');poly([[27,19],[34,27],[27,35],[20,27]],'#893e61');rect(25,23,5,9,'#ffdfc8');\n      for(const x of [5,44])for(const y of [15,32])rect(x,y,4,5,'#e6b28e');}),\n  };\n  const drop=E.anim([0,1,2,1].map(i=>pixelAsset(23,23,({poly,rect})=>{\n    poly([[11,1],[20,11],[11,21],[2,11]],'#6d9694');poly([[11,4],[17,11],[11,18],[5,11]],'#bbefe0');rect(10,7+i,3,8-i*2,'#fff2bf');\n  })),8);\n  Object.assign(S,{ASSETS:{player,enemy,drop,playerColors},pixelAsset});\n})(globalThis.Fortnight);\nEOF\ncat > src/render/scene.js <<'EOF'\n(function(S){\n  'use strict';\n  const E=My3D2dge,{px}=E,C={navy:'#07141f',ink:'#0b1d2d',line:'#294354',cream:'#f0dfb4',cyan:'#8ae5dc',red:'#ec8b79',muted:'#7d98a9'};\n  const txt=(g,s,x,y,color=C.muted,scale=1,align='left')=>E.font.text(g,s,x,y,color,{scale,align,outline:false,shadow:'#050e18'});\n  function line(g,x0,y0,x1,y1,c,w=1){px.line(g,Math.round(x0),Math.round(y0),Math.round(x1),Math.round(y1),c,w);}\n  function ring(g,x,y,r,c,w=1,start=0,end=Math.PI*2){\n    const n=Math.ceil(r*.5),steps=Math.max(12,n);for(let i=0;i<steps;i++){\n      const a=start+(end-start)*i/steps,b=start+(end-start)*(i+1)/steps;line(g,x+Math.cos(a)*r,y+Math.sin(a)*r,x+Math.cos(b)*r,y+Math.sin(b)*r,c,w);}\n  }\n  function panel(g,x,y,w,h,color='#516c7c'){\n    const t=E.tones(color);px.rect(g,x,y,w,h,t.deep);px.rect(g,x+1,y+1,w-2,h-3,t.base);px.rect(g,x+1,y+1,w-2,2,t.lt);px.rect(g,x+w-3,y+2,2,h-5,t.sh);\n    if(w>14&&h>12)for(const dx of [3,w-5])for(const dy of [4,h-6])px.rect(g,x+dx,y+dy,2,2,t.deep);\n  }\n  function fortress(g,x,y,k,t,{heat=0,locks=[false,false,false,false],damaged=false}={}){\n    const P=(a,b)=>[x+a*k,y+b*k],R=(a,b,w,h,c)=>px.rect(g,...P(a,b),w*k,h*k,c),L=(a,b,c,d,col,w=1)=>line(g,...P(a,b),...P(c,d),col,w*k);\n    const round=(a,b,r,c,w=1)=>ring(g,...P(a,b),r*k,c,w*k);\n    // Four radiators are individually lit, locked and animated, attached to a continuous armored ring.\n    round(0,5,70,'#0c1b29',8);round(0,1,67,'#8b9a9b',2);round(0,2,61,'#273f50',7);\n    for(let i=0;i<4;i++){\n      const a=i*Math.PI/2+Math.PI/4,rx=Math.cos(a)*64,ry=Math.sin(a)*64;\n      const locked=locks[i],col=locked?'#c09bce':heat>65?'#d77d65':'#67a49e';\n      panel(g,x+(rx-16)*k,y+(ry-12)*k,32*k,24*k,col);\n      for(let j=0;j<5;j++)R(rx-11+j*5,ry-8,2,16,locked?'#493951':heat>65?'#f5b98b':Math.sin(t*2+j)>.1?'#b6e6c8':'#578d8d');\n      if(locked)L(rx-11,ry-8,rx+11,ry+8,'#f0d6ff',2);\n      else if(heat>2)for(let n=0;n<3;n++){\n        const d=(t*8+n*8)%23;px.blend(g,(1-d/24)*.25,'add',()=>R(rx+(i===0||i===3?1:-1)*d-8,ry+(i<2?1:-1)*d-5,15,9,'#93dcc6'));}\n    }\n    px.poly(g,[P(-43,-40),P(-22,-60),P(22,-60),P(43,-40),P(43,34),P(24,52),P(-24,52),P(-43,34)],'#263e50');\n    px.poly(g,[P(-40,-40),P(-21,-55),P(21,-55),P(39,-39),P(39,31),P(22,47),P(-21,47),P(-40,31)],'#5b7280');\n    R(-36,-34,72,4,'#a8b6ad');R(-34,25,68,9,'#1a2c3c');\n    for(const sign of [-1,1]){\n      panel(g,x+(sign*26-11)*k,y-31*k,22*k,55*k,'#708792');\n      for(let i=0;i<6;i++)R(sign*26-7,-24+i*7,13,2,i===Math.floor(t*2)%6?'#d5e8cd':'#304b5e');\n    }\n    R(-11,-45,22,79,'#21354a');R(-7,-42,14,64,'#9caeae');R(-4,-39,3,49,'#dce0bf');\n    round(0,0,25,'#253749',6);round(0,-2,22,'#b2b69a',2);round(0,-2,18,'#273f4c',5);\n    px.disc(g,x,y-2*k,13*k,'#315d64');px.disc(g,x-3*k,y-5*k,8*k,heat>70?'#e9a17b':'#a3d5c1');\n    R(-3,-10,6,16,'#def0cf');R(-8,-5,16,5,'#def0cf');\n    // Antenna masts, docking clamps, windows and the thirteen stencil.\n    L(-18,-49,-18,-86,'#8c9fa4',1);L(-18,-81,-10,-81,'#b5c5b6');\n    R(-20,-89,4,3,Math.sin(t*3)>0?'#ebac7c':'#5d5960');\n    L(22,-43,22,-73,'#8c9fa4');round(22,-76,8,'#98afa8');L(16,-80,28,-71,'#d9dbc0');\n    R(-12,38,24,7,'#1c3445');txt(g,'13',x,y+37*k,C.cream,Math.max(1,Math.round(k)), 'center');\n    for(const dx of [-38,34])R(dx,38,5,8,'#c4ba92');\n    if(damaged){R(12,-36,12,13,'#1a2835');L(13,-35,24,-23,'#c78164',2);R(-36,15,10,7,'#1a2835');}\n  }\n  function siege(g,x,y,k,t,boss){\n    const P=(a,b)=>[x+a*k,y+b*k],R=(a,b,w,h,c)=>px.rect(g,...P(a,b),w*k,h*k,c);\n    px.poly(g,[P(-173,-18),P(-125,-38),P(-88,-27),P(-44,-54),P(44,-54),P(88,-27),P(125,-38),P(173,-18),P(157,26),P(103,31),P(61,47),P(-61,47),P(-103,31),P(-157,26)],'#172635');\n    px.poly(g,[P(-169,-18),P(-124,-34),P(-87,-22),P(-43,-48),P(43,-48),P(87,-22),P(124,-34),P(169,-18),P(153,21),P(100,24),P(59,40),P(-59,40),P(-100,24),P(-153,21)],'#59606e');\n    for(const sign of [-1,1]){\n      panel(g,x+(sign*115-35)*k,y-21*k,70*k,40*k,'#615b69');\n      R(sign*115-29,-17,58,3,'#a99b9c');\n      for(let j=0;j<6;j++)R(sign*115-25+j*9,-8,5,14,'#252738');\n      R(sign*80-12,-20,24,53,'#303447');R(sign*80-8,-16,4,37,'#b096a4');\n    }\n    panel(g,x-49*k,y-42*k,98*k,71*k,'#6b6972');\n    px.poly(g,[P(0,-36),P(32,-8),P(24,27),P(0,41),P(-24,27),P(-32,-8)],'#2b3444');\n    ring(g,x,y+6*k,22*k,'#8e758b',4*k);ring(g,x,y+6*k,15*k,'#bd8e9d',2*k);\n    R(-13,-21,26,7,'#1c2939');for(let j=0;j<5;j++)R(-11+j*5,-20,3,3,'#f6a17f');\n    for(let j=0;j<11;j++)R(-80+j*16,32,7,3,j===Math.floor(t*3)%11?'#f1c79a':'#9d7174');\n    if(\"'!boss){R(-6,1,12,14,'\"'#ecb0a2');return;}\n    for(const c of boss.parts){\n      const cx=c.x,cy=c.y,alive=c.hp>0,col=\"'!alive?'\"'#17232f':c.hit>0?'#f7edcb':c.open?'#f5b791':'#6e6c79';\n      panel(g,cx-(c.kind==='core'?21:14),cy-12,c.kind==='core'?42:28,26,alive?'#746579':'#283442');\n      if(alive){px.poly(g,[[cx,cy-10],[cx+9,cy],[cx,cy+13],[cx-9,cy]],col);\n        if(c.open){ring(g,cx,cy,23+Math.sin(t*5)*2,'#ecc5a0');txt(g,'FIRE',cx,cy+30,C.cream,1,'center');}\n      }else{line(g,cx-10,cy-8,cx+11,cy+8,'#956a67',2);px.rect(g,cx-5,cy-2,10,7,'#111c29');}\n    }\n  }\n  class Painter{\n    constructor(game){this.game=game;this.lastEvent=0;this.shake=0;\n      this.bg=new E.Backdrop({sky:['#040e18','#0b2033','#152e42'],stars:170,moon:{x:.83,y:.28,r:62,color:'#466a7a'},\n        layers:[{kind:'clouds',color:'#1c4553',y:.35,height:.44,parallax:.015,drift:1,nebula:true,seed:23},{kind:'clouds',color:'#30304b',y:.68,height:.3,parallax:.01,drift:.5,nebula:true,seed:7}]});\n    }\n    background(r,t,act=0){\n      this.bg.draw(r);r.starfield({count:90,speed:act===2?1:4,dir:'down'});\n      r.overlay(g=>{\n        // Survey grid, navigation scars and debris make a single place across the retreat.\n        for(let x=0;x<960;x+=80)for(let y=90;y<480;y+=64){px.dot(g,x,y,'#244052');}\n        for(let i=0;i<16;i++){const x=(i*173+31)%960,y=100+(i*97)%365;\n          if(i%3===0)line(g,x,y,x+7,y-4,'#34505d');else px.rect(g,x,y,2+i%3,2,'#254053');}\n        ring(g,480,277,210,'#17394a');ring(g,480,277,278,'#173444');\n        if(act===2){\n          // Same planet, now a damaged industrial horizon and a mechanically detailed gun rail.\n          for(let i=0;i<23;i++){const x=i*45,h=12+(i*19)%52;\n            px.rect(g,x,462-h,38,h,'#203747');px.rect(g,x+3,464-h,25,3,'#3c5360');\n            for(let j=0;j<4;j++)px.rect(g,x+7+j*7,470-h,3,5,'#6e897e');}\n          px.rect(g,0,482,960,58,'#102332');px.rect(g,0,481,960,4,'#97a8a5');\n          for(let i=0;i<32;i++){panel(g,i*32,494,30,24,'#344d5d');px.rect(g,i*32+8,487,12,2,'#d1bc83');}\n          for(let j=0;j<3;j++)line(g,0,505+j*9,960,505+j*9,'#193444');\n        }\n      });\n    }\n    title(r,t){\n      this.background(r,t,0);\n      r.overlay(g=>{\n        // A technical poster made from the actual installation and fleet, all in motion.\n        ring(g,700,290,175,'#3c5b65',1);ring(g,700,290,194,'#2e4b58');\n        for(let i=0;i<48;i++){const a=i*Math.PI/24;line(g,700+Math.cos(a)*184,290+Math.sin(a)*184,700+Math.cos(a)*(i%4===0?195:190),290+Math.sin(a)*(i%4===0?195:190),'#527279');}\n        siege(g,774,77,.72,t);fortress(g,700,292,1.65,t,{heat:20});\n        line(g,727,174,863,151,C.muted);txt(g,'FORTRESS 13',814,135,C.cream,1);\n        txt(g,'RADIATOR ARRAY / ONLINE',590,452,C.cyan,1);\n        line(g,569,447,615,411,'#517570');line(g,863,325,911,349,'#517570');txt(g,'CORE',865,354,C.muted);\n        // Left gradient is native stepped alpha, with no painting outside the engine.\n        for(let i=0;i<15;i++)px.blend(g,.42-i*.025,'normal',()=>px.rect(g,i*35,0,35,540,'#07131f'));\n        txt(g,'FORTRESS COMMAND // SECTOR 13',57,63,C.cyan,1);\n        E.font.title(g,'SPACE',56,108,{scale:7,colors:['#fff1cf','#e8cf9c','#b89869'],outline:'#0a1a28',depth:3,depthColor:'#495362'});\n        E.font.title(g,'FORTNIGHT',56,176,{scale:7,colors:['#fff1cf','#e8cf9c','#b89869'],outline:'#0a1a28',depth:3,depthColor:'#495362'});\n        px.rect(g,57,249,48,3,C.cyan);txt(g,'THREE LINES. ONE LAST STAND.',119,245,C.cream,1);\n        txt(g,'A SIEGE IN THREE MOVEMENTS',57,284,C.muted,1);\n        txt(g,'01  INTERCEPT    02  DEFEND    03  HOLD',57,305,C.muted,1);\n        txt(g,'CENTURY / 1981 REIMAGINED',57,503,'#648392',1);\n        txt(g,'VIPER WING - STANDING BY',905,504,C.cyan,1,'right');\n      });\n      for(let i=0;i<3;i++){\n        const a=t*.18+i*2.2,x=700+Math.cos(a)*230,y=292+Math.sin(a)*122;\n        r.sprite(x,y,0,S.ASSETS.player[i].thrust,{t,rot:a+Math.PI,anchor:'center',scale:.8});\n      }\n    }\n    events(s){\n      for(const e of s.events)if(e.id>this.lastEvent){\n        if(['hurt','objective','component'].includes(e.type))this.shake=Math.max(this.shake,e.type==='component'?5:2);\n      }\n      this.lastEvent=s.eventSeq;\n    }\n    draw(r,s,t,opts={}){\n      this.events(s);this.background(r,t,s.act);\n      if(s.act===0)r.overlay(g=>{fortress(g,805,330,.42,t,{damaged:false});siege(g,610,104,.48,t);txt(g,'FORTRESS 13 / 18 km',784,375,'#637f8b',1,'center');});\n      if(s.act===1){r.actor(480,277,0,(g,ox,oy)=>fortress(g,ox,oy,1,t,{heat:s.heat,locks:s.locks,damaged:\"'!s.outcomes[0]?.held}));}\n      if(s.act===2&&!s.boss)r.overlay(g=>{siege(g,480+Math.sin(t*.1)*100,124,.65,t);txt(g,'\"'THE NIGHT ADMIRAL',480,177,'#aa858a',1,'center');});\n      if(s.boss){const boss=s.boss,cx=boss.parts[4].x,cy=boss.parts[4].y-15;r.overlay(g=>{\n        siege(g,cx,cy,1,t,boss);\n        const cycle=boss.phaseAge%8;\n        if(cycle<1.5){\n          for(const c of boss.parts.filter(c=>c.hp>0&&(boss.phase===0?c.index<2:boss.phase===1?c.index===2||c.index===3:c.index===4))){\n            const p=s.players.find(p=>p.hp>0&&\"'!p.gone);if(p){line(g,c.x,c.y,p.x,480,'\"'#715d68');ring(g,p.x,457,20,'#e4ae8f');}}\n          txt(g,boss.phase===0?'BATTERIES ACQUIRING':boss.phase===1?'TRACTOR EMITTERS OPENING':'CORE VOLLEY CHARGING',cx,cy+81,C.red,1,'center');\n        }\n        if(boss.phase===1&&cycle>1.5&&cycle<5.5)for(const c of boss.parts.slice(2,4))if(c.hp>0){const p=s.players.find(p=>p.hp>0&&\"'!p.gone);if(p){line(g,c.x,c.y,p.x,p.y,'\"'#ac93bf',2);ring(g,p.x,p.y,27,'#a48dbd');}}\n      });}\n      r.overlay(g=>{\n        for(const e of s.enemies){\n          if(e.tele>0){ring(g,e.x,e.y,e.r+8+e.tele*8,'#bfa98a');line(g,e.x-6,e.y,e.x+6,e.y,C.cream);line(g,e.x,e.y-6,e.x,e.y+6,C.cream);txt(g,'INBOUND',e.x,e.y+e.r+20,C.muted,1,'center');continue;}\n          if(e.kind==='anchor'){\n            for(let i=0;i<4;i++){const rad=25+(1-(t*.55+i/4)%1)*145;ring(g,e.x,e.y,rad,e.charge>0?'#615379':'#9c8ab7',e.charge>0?1:2);}\n            ring(g,e.x,e.y,24,'#dbc7f2');txt(g,e.charge>0?'GRAVITY CHARGING':'GRAVITY ACTIVE',e.x,e.y-40,'#dfcef3',1,'center');\n          }\n          if(e.wind>0&&e.kind==='hunter'){const p=s.players.find(p=>p.id===e.target);if(p)line(g,e.x,e.y,p.x,p.y,'#b17c72');}\n          if(e.wind>0&&e.kind==='bomber'){\n            px.blend(g,.15,'normal',()=>px.rect(g,e.lane-20,100,40,380,'#e6ac70'));\n            for(let j=0;j<9;j++){const yy=110+j*40+(t*25)%40;line(g,e.lane-16,yy,e.lane,yy+12,'#e2b47e');line(g,e.lane,yy+12,e.lane+16,yy,'#e2b47e');}\n            txt(g,'BOMB LANE',e.lane,441,'#f0cc91',1,'center');\n          }\n          if(e.kind==='rammer'&&\"'!e.launched){const target=s.act===1?{x:480,y:277}:s.players.find(p=>p.hp>0);if(target)line(g,e.x,e.y,target.x,target.y,'\"'#a27170');}\n          if(e.kind==='tractor'&&e.wind>0){const p=s.players.find(p=>p.id===e.target),target=e.lock>=0?{x:480+[-48,48,48,-48][e.lock],y:277+[48,48,-48,-48][e.lock]}:p;\n            if(target){line(g,e.x,e.y,target.x,target.y,e.wind<3.1?'#ceb6e0':'#74677f',e.wind<3.1?2:1);txt(g,e.wind<3.1?'LOCK':'ACQUIRING',e.x,e.y-32,'#dfc7eb',1,'center');}}\n          if(e.kind==='dive'&&e.launched&&e.wind>0)line(g,e.x,e.y,e.x+e.vx*3,480,'#bb9b71');\n        }\n      });\n      for(const d of s.drops)r.sprite(d.x,d.y,0,S.ASSETS.drop,{t,anchor:'center',glow:.4});\n      for(const e of s.enemies){if(e.tele>0)continue;const rot=e.kind==='anchor'||e.kind==='relay'?0:e.kind==='rammer'&&e.launched?Math.atan2(e.vy,e.vx)+Math.PI/2:e.kind==='dive'?0:e.a+Math.PI/2;\n        r.sprite(e.x,e.y,0,S.ASSETS.enemy[e.kind],{anchor:'center',rot,flash:e.hit>0?'#fff0d3':null,scale:1});\n        if(e.hp<e.maxHp)r.overlay(g=>{px.rect(g,e.x-16,e.y-e.r-10,32,3,'#243646');px.rect(g,e.x-16,e.y-e.r-10,32*e.hp/e.maxHp,3,'#d7a27e');});\n      }\n      for(const [i,p] of s.players.entries()){\n        if(p.gone||p.hp<=0)continue;const transition=s.phase==='retreat',off=transition?(4.5-s.phaseTime)*100:0;\n        const ship=S.ASSETS.player[i%4],spr=p.thrust>.1||p.boost>0||transition?ship.thrust:ship.idle;\n        if(s.act===2)r.overlay(g=>{panel(g,p.x-28,p.y+10,56,13,'#607986');for(const dx of [-25,17]){px.rect(g,p.x+dx,p.y+22,9,5,'#0b1926');px.rect(g,p.x+dx+1,p.y+23,7,2,'#8b9d9c');}});\n        const xx=p.x,yy=p.y+off;\n        if(p.boost>0)for(let j=1;j<4;j++)r.sprite(xx-p.vx*.025*j,yy-p.vy*.025*j,0,ship.idle,{rot:p.a+Math.PI/2,anchor:'center',alpha:.2*(1-j/4)});\n        r.sprite(xx-Math.cos(p.a)*p.recoil*20,yy-Math.sin(p.a)*p.recoil*20,0,spr,{t,rot:p.a+Math.PI/2,anchor:'center',flash:p.hit>0?'#fff6d8':null});\n        r.overlay(g=>{\n          if(p.inv>0&&(\"'!this.game.settings.reducedFlashes||Math.floor(t*10)%2===0))ring(g,xx,yy,27,'\"'#9edcd6',1);\n          txt(g,String(i+1).padStart(2,'0'),xx+27,yy-15,p.color,1);\n          px.rect(g,xx-14,yy+28,28,3,'#1b3343');px.rect(g,xx-14,yy+28,28*p.energy/p.maxEnergy,3,p.color);\n          if(p.pulse<=0){px.rect(g,xx-3,yy+33,6,2,'#dce8bd');}else px.rect(g,xx-3,yy+33,6*(1-p.pulse/(s.balance.pulseCooldown*Math.pow(.75,p.upgrades.pulse))),2,'#69898f');\n        });\n      }\n      r.overlay(g=>{\n        for(const b of s.shots){const col=b.foe?b.bomb?'#f7bf7a':'#f1a490':'#b5f6e5';\n          if(b.bomb){px.disc(g,b.x,b.y,8,'#5c4b4b');ring(g,b.x,b.y,7,'#efba7c',2);px.rect(g,b.x-2,b.y-2,4,4,'#ffecd0');}\n          else{line(g,b.px-b.vx*.012,b.py-b.vy*.012,b.x,b.y,col,b.foe?3:3);line(g,b.px,b.py,b.x,b.y,'#fff4d3',1);}\n        }\n        for(const f of s.effects){const u=f.t/f.life;if(f.kind==='pulse'){ring(g,f.x,f.y,8+f.size*u,'#a6eee3',3*(1-u)+1);ring(g,f.x,f.y,8+f.size*u*.8,'#638e94');}\n          else{const rad=f.size*(.1+u*.9);if(u<.3)px.disc(g,f.x,f.y,rad*(1-u),u<.15?'#fff0ca':'#eabc84');\n            ring(g,f.x,f.y,rad,u<.35?'#f5cc94':'#826c6f');\n            for(let i=0;i<10;i++){const a=i*2.399+f.id;const rr=rad*(.7+(i%3)*.15);px.rect(g,f.x+Math.cos(a)*rr,f.y+Math.sin(a)*rr,Math.max(1,4-u*3),2,u<.6?'#e1b083':'#6f656b');}}\n        }\n        if(s.options.overlays){\n          for(const e of s.enemies)ring(g,e.x,e.y,e.r,'#f3d77f');for(const p of s.players)if(p.hp>0)ring(g,p.x,p.y,10,'#80f1da');\n          txt(g,\"'`SEED ${s.seed}   TICK ${s.tick}   ENTITIES ${s.enemies.length}   SHOTS ${s.shots.length}`,35,463,C.cream);\n        }\n        if(s.phase==='\"'briefing'||s.phase==='retreat'){\n          px.blend(g,.68,'normal',()=>px.rect(g,110,192,740,126,'#0a1b29'));\n          const label=s.phase==='briefing'?S.ACTS[s.act].name:s.outcomes[s.act]?.held?'LINE SECURED / FALL BACK':'EMERGENCY EXTRACTION';\n          txt(g,s.phase==='briefing'?\"'`DEFENSIVE LINE ${S.ACTS[s.act].code}`:'\"'FORTRESS COMMAND',480,207,C.cyan,1,'center');\n          E.font.title(g,label,480,232,{align:'center',scale:3,colors:['#fff0cb','#c5ac85'],depth:1});\n          txt(g,s.phase==='briefing'?S.ACTS[s.act].objective:'KEEP YOUR WING TOGETHER',480,278,C.cream,1,'center');\n        }\n        if(opts.demo){px.rect(g,390,84,180,24,'#102a3a');txt(g,'DEMO / AUTOPILOT',480,91,C.cream,1,'center');txt(g,'ANY INPUT RETURNS TO COMMAND',480,508,C.cream,1,'center');}\n      });\n      if(\"'!opts.hideHUD)this.hud(r,s,t);\n    }\n    hud(r,s,t){r.overlay(g=>{\n      px.rect(g,0,0,960,76,'\"'#0a1926');line(g,30,76,930,76,'#48606a');\n      txt(g,\"'`LINE ${S.ACTS[s.act].code} / ${S.ACTS[s.act].name}`,31,17,C.cyan,1);\n      txt(g,s.boss?'\"'THE NIGHT ADMIRAL':S.WAVES[s.wave]?.title||'SIEGE BROKEN',31,39,C.cream,2);\n      txt(g,'TEAM SCORE',929,15,C.muted,1,'right');txt(g,String(s.score).padStart(7,'0'),929,34,C.cream,3,'right');\n      txt(g,\"'`CHAIN x${s.multiplier}`,742,54,s.multiplier>1?C.cyan:C.muted,1,'\"'right');\n      const label=s.act===0?'ESCORT LINE':s.act===1?'FORTRESS HEAT':'BASE INTEGRITY';\n      const value=s.act===0?Math.min(1,(s.wave*3+s.waveTime/(S.WAVES[s.wave]?.min||60)*3)/9):s.act===1?s.heat/100:s.base/100;\n      txt(g,label,539,15,s.act===1&&s.heat>65?C.red:C.muted,1);\n      px.rect(g,539,31,180,9,'#1a3040');px.rect(g,540,32,178*value,7,s.act===1?value>.65?C.red:'#e6bf79':C.cyan);\n      txt(g,s.act===1?\"'`${Math.round(s.heat)}% / ${s.locks.filter(v=>!v).length} RADIATORS`:s.act===2?`${Math.ceil(s.base)}% / HOLD THE RAIL`:`BEAT ${s.wave+1} / 3`,539,50,C.muted,1);\n      if(s.boss){const boss=s.boss,total=boss.parts.reduce((v,c)=>v+c.maxHp,0),hp=boss.parts.reduce((v,c)=>v+c.hp,0);\n        px.rect(g,260,85,440,14,'\"'#1a2a39');px.rect(g,261,86,438*hp/total,12,'#b5777e');\n        txt(g,['I / SIDE BATTERIES','II / TRACTOR EMITTERS','III / EXPOSED CORE'][boss.phase],480,107,C.cream,1,'center');}\n      if(s.act\"'!==2){px.rect(g,0,488,960,52,'\"'#091b29');line(g,30,488,930,488,'#48606a');}\n      const players=s.players.filter(p=>\"'!p.gone),width=Math.min(220,850/players.length);\n      for(const [i,p]of players.entries()){\n        const x=31+i*width;txt(g,`${String(i+1).padStart(2,'\"'0')} \"'${p.name}`,x,498,p.color,1);\n        if(p.hp<=0)txt(g,`REDEPLOY ${Math.ceil(p.dead)}s`,x,516,C.red,1);\n        else{for(let j=0;j<p.maxHp;j++)px.rect(g,x+j*8,516,6,7,j<p.hp?p.color:'\"'#28404d');\n          txt(g,p.pulse<=0?'PULSE READY':\"'`PULSE ${Math.ceil(p.pulse)}s`,x+85,516,p.pulse<=0?C.cream:C.muted,1);}\n      }\n      if(s.modified)txt(g,'\"'MODIFIED RUN',929,518,'#b6a0c6',1,'right');\n    });}\n  }\n  Object.assign(S,{Painter,fortress,siege,ring,panel,txt,C});\n})(globalThis.Fortnight);\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_44","type":"agent_message","text":"The first simulation runs can win with one, two, and four pilots using ordinary movement and combat inputs. I also reviewed frames from Century gameplay showing the free-flight, central-fortress, and ground-line layouts. I’m now adding the custom ship art, animated installation, HUD, and coded synth score.\n"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat > src/audio.js <<'EOF'\n(function(S){\n  'use strict';\n  const MELODY='D4 . A4 . D5 - C5 . | A4 . F4 . E4 - - . | F4 . A4 . C5 - A4 . | E4 . G4 . A4 - - .';\n  const BASS='D2 . D3 . D2 . A2 . | Bb1 . Bb2 . Bb1 . F2 . | F2 . F3 . F2 . C3 . | C2 . C3 . A1 . A2 .';\n  const SONGS={};\n  for(const [key,bpm,lead,vol,drum]of [['title',88,'triangle',.15,'k . . . . . h .'],['act0',108,'pulse',.11,'k . h . s . h .'],['act1',118,'pulse',.12,'k . h h s . h .'],['act2',128,'square',.09,'k h h . s . h h'],['boss',142,'saw',.09,'k h k h s h h h']]){\n    SONGS[key]={bpm,steps:4,tracks:[{name:'command',wave:lead,vol,notes:MELODY},{name:'keel',wave:'triangle',vol:.22,notes:BASS},{name:'march',wave:'drums',vol:.12,notes:drum}]};\n  }\n  SONGS.victory={bpm:112,steps:4,loop:false,tracks:[{wave:'triangle',vol:.22,notes:'D4 F4 A4 D5 - - C5 A4 | F4 A4 C5 F5 - - E5 C5 | D5 - - - A4 - D5 -'},{wave:'triangle',vol:.2,notes:'D2 - A2 - D3 - - - | Bb2 - F3 - Bb3 - - - | D3 - - - - - - -'}]};\n  SONGS.defeat={bpm:72,steps:4,loop:false,tracks:[{wave:'triangle',vol:.2,notes:'A4 - F4 - D4 - C4 - | D4 - - - . . . .'},{wave:'triangle',vol:.18,notes:'D2 - - - Bb1 - - - | D2 - - - . . . .'}]};\n  const FX={\n    laser:{wave:'triangle',freq:950,to:330,dur:.09,vol:.15},\n    hit:{wave:'noise',freq:2800,to:600,dur:.06,vol:.12},\n    hurt:{wave:'saw',freq:180,to:55,dur:.22,vol:.19},\n    pickup:{wave:'triangle',freq:660,arp:[0,4,7,12],step:.04,dur:.2,vol:.23},\n    pulse:{wave:'noise',freq:3500,to:160,dur:.38,vol:.26},\n    gravity:{wave:'sine',freq:180,to:48,dur:.6,vol:.24,vib:[12,.09]},\n    lock:{wave:'triangle',freq:320,arp:[0,1,0,1,7],step:.1,dur:.5,vol:.19},\n    warning:{wave:'square',freq:520,arp:[0,7,0],step:.11,dur:.25,vol:.15},\n    blast:{wave:'noise',freq:900,to:65,dur:.32,vol:.22},\n    boost:{wave:'noise',freq:170,to:1600,dur:.18,vol:.16},\n  };\n  function gibberish(ctx,bus,start,seed=0){\n    const nodes=[];\n    for(let i=0;i<8;i++){\n      const t=start+i*.083,f=155+((seed+i*47)%110),o=ctx.createOscillator(),gain=ctx.createGain(),filter=ctx.createBiquadFilter();\n      o.type='sawtooth';o.frequency.setValueAtTime(f,t);o.frequency.linearRampToValueAtTime(f*(i%2?1.25:.75),t+.065);\n      filter.type='bandpass';filter.frequency.setValueAtTime([750,1100,1650,900][i%4],t);filter.Q.value=4;\n      gain.gain.setValueAtTime(0,t);gain.gain.linearRampToValueAtTime(.13,t+.008);gain.gain.linearRampToValueAtTime(0,t+.068);\n      o.connect(filter).connect(gain).connect(bus);o.start(t);o.stop(t+.075);nodes.push(o);\n    }\n    return nodes;\n  }\n  class Sound{\n    constructor(game){this.game=game;this.a=game.audio;this.unlocked=false;this.ended=false;this.lastEvent=0;this.key=null;this.nodes=[];this.handles=[];this.radioAt=-10;this.fxAt={};\n      for(const [key,spec]of Object.entries(FX))this.a.define('sf-'+key,spec);\n    }\n    unlock(){\n      if(this.ended)return;\n      this.unlocked=true;const bus=this.a.bus('sfx');if(bus)this.a.ctx.resume().catch(()=>{});this.sync();\n    }\n    play(name,event){\n      if(\"'!this.unlocked||this.ended||this.silent)return;\n      const now=this.a.ctx?.currentTime||0;\n      const gap=name==='\"'laser'?.055:name==='hit'?.06:name==='warning'?.8:0;\n      if(now-(this.fxAt[name]??-10)<gap)return;this.fxAt[name]=now;\n      const h=this.a.sfx('sf-'+name,{pitch:1+((event?.id||0)%5-2)*.035,pan:event?S.clamp((event.x-480)/600,-.8,.8):0});\n      if(h)this.handles.push(h);if(this.handles.length>64)this.handles.shift();\n    }\n    voice(seed){if(\"'!this.unlocked||this.ended||this.silent)return;const ctx=this.a.ctx,bus=this.a.bus('\"'voice');if(\"'!ctx||!bus||ctx.currentTime-this.radioAt<1)return;\n      this.stopVoice();this.radioAt=ctx.currentTime;this.nodes=gibberish(ctx,bus,ctx.currentTime,seed);}\n    stopVoice(){for(const node of this.nodes){try{node.stop();node.disconnect();}catch{}}this.nodes=[];}\n    mode(key,silent=false){this.wanted=key;this.silent=silent;this.sync();}\n    sync(){\n      const key=this.silent||this.ended?null:this.wanted;\n      if(key===this.key)return;this.key=key;\n      if(this.unlocked){this.a.music(key?SONGS[key]:null,{sync:true});if(!key)this.stopVoice();}\n      else this.key=undefined;\n    }\n    events(s){\n      for(const e of s.events)if(e.id>this.lastEvent){\n        const map={shot:'\"'laser',hit:'hit',hurt:'hurt',death:'blast',kill:'blast',component:'blast',pickup:'pickup',pulse:'pulse',boost:'boost',gravity:'gravity',lock:'lock',warning:'warning',objective:'warning',coreWind:'warning'};\n        if(map[e.type])this.play(map[e.type],e);\n        if(['radio','briefing','bossPhase','retreat','dock'].includes(e.type))this.voice(e.id*19);\n      }\n      this.lastEvent=s.eventSeq;\n    }\n    reset(){this.stopVoice();this.lastEvent=0;this.fxAt={};for(const h of this.handles)h.stop?.();this.handles=[];this.key=undefined;}\n    stop(){this.ended=true;this.reset();this.a.music(null);this.wanted=null;this.key=null;}\n  }\n  Object.assign(S,{Sound,SONGS,FX,gibberish});\n})(globalThis.Fortnight);\nEOF\ncat > src/input.js <<'EOF'\n(function(S){\n  'use strict';\n  const MAP={...My3D2dge.Input.DEFAULT,fire:['Mouse0','KeyJ','Pad7'],boost:['Space','ShiftLeft','Pad6'],pulse:['Mouse2','KeyE','Pad2']};\n  delete MAP.attack;delete MAP.dash;delete MAP.skill;delete MAP.jump;\n  MAP.halves={left:{fire:['KeyF','Mouse0','Pad7'],boost:['KeyG','Pad6'],pulse:['KeyH','Pad2']},right:{fire:['Period','Numpad1','Pad7'],boost:['Slash','Numpad2','Pad6'],pulse:['Comma','Numpad3','Pad2']}};\n  class IntentInput{\n    constructor(app){this.app=app;this.game=app.game;this.touch=new Map();this.seq=0;this.lastActivity=performance.now();this.pointerLast=null;this.consumed=false;\n      const canvas=this.game.screen.canvas,signal=this.game._abort?.signal;\n      const activity=(event)=>{\n        if(event?.type==='pointermove'&&event.pointerType==='mouse'){\n          if(this.pointerLast&&Math.hypot(this.pointerLast[0]-event.clientX,this.pointerLast[1]-event.clientY)<4)return;\n          this.pointerLast=[event.clientX,event.clientY];\n        }\n        this.mark();\n      };\n      addEventListener('keydown',activity,{capture:true,signal});\n      addEventListener('pointerdown',activity,{capture:true,signal});\n      addEventListener('pointermove',activity,{capture:true,signal});\n      addEventListener('wheel',activity,{passive:true,signal});\n      // Native pointer transforms, native rebinding and last-device tracking remain the source of prompts.\n      this.game.input.touchFilter=()=>false;\n      this.game.input.touchButtons([]);\n      this.game.input.touchEnabled=false;\n      canvas.addEventListener('pointerdown',e=>this.startTouch(e),{signal});\n      canvas.addEventListener('pointermove',e=>this.moveTouch(e),{signal});\n      for(const ev of ['pointerup','pointercancel','lostpointercapture'])canvas.addEventListener(ev,e=>this.endTouch(e),{signal});\n      addEventListener('blur',()=>this.clear(),{signal});\n      document.addEventListener('visibilitychange',()=>{if(document.hidden)this.clear();},{signal});\n      // Shell menus deliberately stay native. Hover visibly transfers the controller focus.\n      document.addEventListener('pointerover',e=>{\n        const b=e.target.closest?.('.esh button,.esh input');if(b&&e.pointerType==='mouse'&&document.activeElement\"'!==b)b.focus({preventScroll:true});\n      },{signal});\n    }\n    mark(){this.lastActivity=performance.now();this.app.sound?.unlock();\n      if(this.app.attract){this.consumed=true;this.app.title();this.clear();}\n    }\n    clear(){this.touch.clear();for(const I of this.game.players)I.clear();this.app.world?.clearInput();this.seq++;}\n    screenPoint(e){const rect=this.game.screen.canvas.getBoundingClientRect();const scale=Math.min(rect.width/S.W,rect.height/S.H);return[(e.clientX-rect.left-(rect.width-S.W*scale)/2)/scale,(e.clientY-rect.top-(rect.height-S.H*scale)/2)/scale];}\n    startTouch(e){if(e.pointerType==='\"'mouse'||this.game.shell?.screen||this.app.attract||\"'!this.app.world)return;\n      const [x,y]=this.screenPoint(e);if(x<0||x>S.W||y<0||y>S.H)return;\n      e.preventDefault();this.game.screen.canvas.setPointerCapture(e.pointerId);this.game.input.lastDevice='\"'touch';\n      this.touch.set(e.pointerId,{x,y,sx:x,sy:y,side:x<S.W*.5?'move':'aim'});\n    }\n    moveTouch(e){const t=this.touch.get(e.pointerId);if(\"'!t)return;const [x,y]=this.screenPoint(e);t.x=x;t.y=y;this.game.input.lastDevice='\"'touch';}\n    endTouch(e){this.touch.delete(e.pointerId);}\n    pollActivity(){\n      const pads=navigator.getGamepads?.()||[];\n      for(const pad of pads)if(pad&&pad.connected&&(pad.axes.some(a=>Math.abs(a)>.25)||pad.buttons.some(b=>b.pressed))){\n        const signature=JSON.stringify([pad.axes.map(a=>Math.abs(a)>.25?Math.round(a*8):0),pad.buttons.map(b=>b.pressed)]);\n        if(signature\"'!==this.padSignature){this.padSignature=signature;this.mark();}\n      }\n      if(![...pads].some(p=>p&&p.connected))this.padSignature='\"'';\n    }\n    intent(p,index=0){\n      const I=this.game.players[index]||this.game.input,out=S.neutral(++this.seq);\n      if(this.consumed){this.consumed=false;return out;}\n      if(this.game.shell?.screen||this.app.online?.ended)return out;\n      [out.mx,out.my]=I.move();let aim=null;\n      if(I.padAim&&Math.hypot(...I.padAim)>.22)aim=I.padAim;\n      else if(I.lastDevice==='mouse'&&I.pointer()&&index===0){const q=I.pointer();aim=[q[0]-p.x,q[1]-p.y];}\n      const isTouch=I.lastDevice==='touch'&&index===0;\n      if(isTouch){\n        out.mx=out.my=0;\n        for(const touch of this.touch.values()){\n          if(touch.side==='move'){[out.mx,out.my]=S.norm((touch.x-touch.sx)/58,(touch.y-touch.sy)/58);}\n          else {aim=[touch.x-p.x,touch.y-p.y];out.fire=true;}\n        }\n      }\n      if(\"'!aim&&((isTouch&&this.game.settings.assistAim)||this.game.settings.assistAim&&I.lastDevice==='\"'keyboard')){\n        const target=this.target(p);if(target)aim=[target.x-p.x,target.y-p.y];\n      }\n      if(aim&&Math.hypot(...aim)>.1){const len=Math.hypot(...aim);out.ax=aim[0]/len;out.ay=aim[1]/len;}\n      else{out.ax=Math.cos(p.a);out.ay=Math.sin(p.a);}\n      out.fire=out.fire||I.down('fire')||(isTouch&&this.game.settings.assistAim&&\"'!!this.target(p));\n      out.boost=I.down('\"'boost');out.pulse=I.down('pulse');\n      if(isTouch){out.pulse=out.pulse||this.app.touchPulse;out.boost=out.boost||this.app.touchBoost;this.app.touchPulse=false;this.app.touchBoost=false;}\n      if(this.game.settings.assistMove){out.mx*=.87;out.my*=.87;}\n      return out;\n    }\n    target(p){\n      const s=this.app.world?.s;if(\"'!s)return null;\n      const targets=s.enemies.filter(e=>e.hp>0&&e.tele<=0&&(s.act!==2||e.y<p.y-15));\n      if(s.boss)targets.push(...s.boss.parts.filter(c=>c.open&&c.hp>0));\n      return targets.sort((a,b)=>S.dist(p,a)-S.dist(p,b))[0];\n    }\n    labels(){const I=this.game.input;\n      return I.lastDevice==='\"'touch'?[['LEFT THUMB','Thrust'],['RIGHT DRAG','Aim & fire'],['AUTO','Aim assistance']]:\n        [[I.lastDevice==='gamepad'?'L':'WASD / ARROWS','Thrust'],[I.lastDevice==='gamepad'?'R':'MOUSE','Aim'],[I.label('fire'),'Fire'],[I.label('boost'),'Boost'],[I.label('pulse'),'Pulse']];\n    }\n  }\n  Object.assign(S,{MAP,IntentInput});\n})(globalThis.Fortnight);\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
