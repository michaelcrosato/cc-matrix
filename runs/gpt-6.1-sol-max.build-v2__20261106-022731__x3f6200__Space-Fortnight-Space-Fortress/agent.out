{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/render/assets.js');s=p.read_text().replace(\\\"Object.assign(S,{ASSETS:{player,enemy,drop,playerColors},pixelAsset});\\\", \\\"Object.assign(S,{ASSETS:{player,enemy,drop,playerColors},pixelAsset,playerSkin:(color,i)=>({idle:playerAsset(color,0,i),thrust:E.anim([playerAsset(color,1,i),playerAsset(color,3,i),playerAsset(color,2,i)],14)})});\\\")\np.write_text(s)\np=Path('src/render/scene.js');s=p.read_text().replace(\\\"constructor(game){this.game=game;this.lastEvent=0;this.shake=0;\\\", \\\"constructor(game){this.game=game;this.lastEvent=0;this.shake=0;this.skins=new Map();\\\")\ns=s.replace(\\\"const ship=S.ASSETS.player[i%4],spr=\\\", \\\"const skinKey=p.color+'-'+i;if(\"'!this.skins.has(skinKey))this.skins.set(skinKey,S.playerSkin(p.color,i));const ship=this.skins.get(skinKey),spr=\")\np.write_text(s)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
