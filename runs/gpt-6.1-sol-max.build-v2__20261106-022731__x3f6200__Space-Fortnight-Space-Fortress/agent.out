oes there)\n  }\n  /** the name of the open screen ('pause', 'settings', 'controls', ...), or null while the game plays */\n  get screen() { const t = this._stack[this._stack.length - 1]; return t ? t.name : null; }\n  /** the player's settings: game.settings (the standard ones and the game's own, by key) */\n  get settings() { return this._game.settings; }\n  /** the pause screen's spec ({} for the standard one), or null without one */\n  _pauseSpec() { const sc = this._o.screens; return sc && 'pause' in sc ? sc.pause || null : this._std ? {} : null; }\n  /** does this shell give the standard menu (the corner's menu button and game.menu() open it)? */\n  _menu() { return this._std; }\n  /** open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over\n   *  o.screens[name]. A spec: { kicker, title, text (strings or functions), actions: [[label, fn] or { label, fn, act,\n   *  primary, disabled }], back (fn for cancel), rows: ['glyphs', 'invertY', '#A heading'] (settings' rows, changed as on\n   *  the settings screen) }. From another screen it stacks (back() returns); shown again, it updates\n   *  (the new spec over the old). 'settings' takes its items\n   *  - 'title': { name, subtitle, meta: [...], footer }\n   *  - 'help': { keys: [[key, what]], sections: [[heading, text]] }\n   *  - 'results': { emblem, stats: [[value, label]], medals: [[label, earned]] }\n   *  - 'map': { map, at, markers (a list or a function), labels: [[text, x, y]], onPick(x, y) } */\n  show(name, spec = {}) {\n    const top = this._stack[this._stack.length - 1], again = top && top.name === name, s = Object.assign({}, this._o.screens && this._o.screens[name], again ? top.s : null, spec);\n    if (again) this._stack.pop();   // the same screen again: updated in place\n    else { if (top) top.focus = this._focusAt(); this._status = ''; }   // (the focus comes back here when the new screen closes)\n    this._stack.push({ name, s, focus: again ? top.focus : undefined }); this._capEnd(); this._render(); return this;\n  }\n  /** what cancel does: the screen's own back(), or close it (back to the screen under it; closing the pause screen resumes) */\n  back() {\n    const top = this._stack[this._stack.length - 1]; if (!top) return this;\n    if (top.s.back) { top.s.back(); return this; }\n    this._stack.pop(); this._capEnd(); if (top.name === 'pause') this._game.resume();\n    this._closed(); this._render(); return this;\n  }\n  /** close every screen (and resume, when the menu paused the game) */\n  hide() { const p = this._stack.some(t => t.name === 'pause'); this._stack.length = 0; this._capEnd(); if (p) this._game.resume(); this._closed(); this._render(); return this; }\n  /** the last screen closed: a game the menu paused (a title under its settings) goes on */\n  _closed() { if (!this._stack.length && this._ownPause) { this._ownPause = false; this._game.resume(); } }\n  /** which focusable element of the open screen has the focus (its index), or -1 */\n  _focusAt() { if (!this.root) return -1; const all = this._focusables(); return all.indexOf(document.activeElement); }\n  _focusables() { return [...this._els.scr.querySelectorAll('.esh-sh button:not(:disabled), .esh-sh input:not(:disabled)')]; }\n  /** close the menu: every screen over the title (a game's own title screen stays), resuming a game the menu paused */\n  _close() { const i = this._stack.findIndex(t => t.name === 'title'); if (i < 0) return this.hide(); this._stack.length = i + 1; this._capEnd(); this._render(); return this; }\n  /** a close or back button over the screen (an icon, 44 px; the keys have Escape and Start, so it takes no focus) */\n  _navBtn(cls, label, d, fn) {\n    const b = this._el('button', 'esh-nav ' + cls); b.type = 'button'; b.tabIndex = -1; b.setAttribute('aria-label', label); b.title = label; b.innerHTML = cornerIcon(d);\n    b.onclick = e => { e.stopPropagation(); fn(); }; return b;\n  }\n  /** a sideways swipe on a screen goes back: the panel follows the finger and goes back past 70 px (a slider keeps its own) */\n  _swipe(sh, box, title) {\n    if (title) return; let s0 = null, swiped = false;\n    const end = e => { if (!s0 || e.pointerId !== s0.id) return; const dx = e.clientX - s0.x, go = s0.on && Math.abs(dx) > 70 && e.type === 'pointerup'; swiped = s0.on; s0 = null;\n      box.classList.add('esh-sw'); box.style.transform = go ? 'translateX(' + Math.sign(dx) * 110 + '%)' : ''; box.style.opacity = go ? '0' : '';\n      if (go) setTimeout(() => this.back(), 120); };\n    sh.addEventListener('pointerdown', e => { swiped = false; if (e.pointerType === 'mouse' || s0 || (e.target.closest && e.target.closest('input'))) return; s0 = { id: e.pointerId, x: e.clientX, y: e.clientY, on: false }; box.classList.remove('esh-sw'); });\n    sh.addEventListener('click', e => { if (swiped) { e.stopPropagation(); e.preventDefault(); swiped = false; } }, true);   // (the button a swipe began on isn't pressed)\n    sh.addEventListener('pointermove', e => {\n      if (!s0 || e.pointerId !== s0.id) return; const dx = e.clientX - s0.x, dy = e.clientY - s0.y;\n      if (!s0.on && Math.abs(dx) > 14 && Math.abs(dx) > Math.abs(dy) * 1.3) s0.on = true;\n      if (s0.on) { box.style.transform = 'translateX(' + dx + 'px)'; box.style.opacity = String(clamp(1 - Math.abs(dx) / 300, .3, 1)); }\n    });\n    for (const t of ['pointerup', 'pointercancel']) sh.addEventListener(t, end);\n  }\n  /** a message that slides in at the top for a few seconds */\n  toast(title, text = '', seconds = 4) {\n    if (!this.root) return this;\n    const e = this._els.toast; e.replaceChildren(this._el('b', '', title)); if (text) e.appendChild(this._el('p', 'esh-m', text));\n    e.classList.add('on'); this._toastEnd = this._game.real + seconds; return this;\n  }\n  /** a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away */\n  tutorial(title, text = '', seconds = 15) {\n    if (!this.root) return this;\n    const e = this._els.tut; e.hidden = !title; this._tutEnd = title ? this._game.real + seconds : 0; if (!title) return this;\n    const x = this._el('button', 'esh-x', '×'); x.setAttribute('aria-label', 'Dismiss'); x.onclick = () => this.tutorial(null);\n    e.replaceChildren(this._el('div', 'esh-k', 'Tutorial'), this._el('b', '', title), this._el('p', 'esh-m', text), x); return this;\n  }\n  /**\n   * the HUD, from this step's state (call it every step; a piece left out is hidden, and only what changed is redrawn)\n   * - objective: { step: '01 / 04', title, text, at: { x, y, z }, from: hero } (the distance in meters, and above or below)\n   * - status, place, tip: status: 'UNSEEN' or { text, color }; place: 'The Old Harbour'; tip: 'text' or { title, text }\n   * - bars, counts: bars: [{ label, value, max, kind: 'bar' | 'pips', color }] (health, stamina, a meter); counts: [[label,\n   *   value]]\n   * - prompt: { key: 'E' (or act: 'interact': its key on the player's device), label, hint, progress: 0..1 }\n   * - keys, buttons: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right:\n   *   pause and map where there is no Escape key)\n   * - minimap: { map, at (with facing), markers: [{ x, y, kind: 'dot' | 'diamond' | 'ring' | 'cross', color }], onClick(x, y)\n   *   (the world point clicked), fog (an E.Fog: unseen cells black, seen ones dim), camera: true (the ground the screen shows) }\n   */\n  hud(st = {}) {\n    if (!this.root) return this;\n    const s = st || {}, E3 = this._els, play = !this.screen;\n    this._piece('obj', play && s.objective, o => {\n      const d = o.at && o.from ? Math.round(Math.hypot(o.at.x - o.from.x, o.at.y - o.from.y) * (this._o.meters || .125)) : null, dz = o.at && o.from ? (o.at.z || 0) - (o.from.z || 0) : 0;\n      return [o.step && this._el('div', 'esh-k', o.step), this._el('b', '', o.title), o.text && this._el('p', 'esh-m', o.text),\n        d !== null && this._el('div', 'esh-dist', d + ' m' + (dz > 12 ? '  ·  ABOVE YOU' : dz < -12 ? '  ·  BELOW YOU' : ''))];\n    });\n    this._piece('vit', play && (s.status || s.bars || s.counts) && [s.status, s.bars, s.counts], ([sta, bars, cnt]) => {\n      const out = [];\n      if (sta) { const t = typeof sta === 'string' ? { text: sta } : sta, e = this._el('div', 'esh-st'); e.style.setProperty('--c', t.color || 'var(--accent)'); e.append(this._el('i'), t.text); out.push(e); }\n      for (const b of bars || []) {\n        const e = this._el('div', b.kind === 'pips' ? 'esh-pips' : 'esh-bar'); if (b.color) e.style.setProperty('--c', b.color);\n        if (b.label) out.push(this._el('div', 'esh-m', b.label));\n        if (b.kind === 'pips') for (let i = 0; i < (b.max || 0); i++) e.appendChild(this._el('i', i < b.value ? '' : 'off'));\n        else { const f = this._el('i'); f.style.width = clamp(b.value / (b.max || 1), 0, 1) * 100 + '%'; e.appendChild(f); }\n        e.setAttribute('aria-label', (b.label || '') + ' ' + b.value + ' of ' + (b.max || 1)); out.push(e);\n      }\n      for (const [k, v] of cnt || []) { const e = this._el('div', 'esh-cnt', k); e.appendChild(this._el('b', '', v)); out.push(e); }\n      return out;\n    });\n    const pr = s.prompt && Object.assign({}, s.prompt, { key: s.prompt.key || (s.prompt.act ? this._game.input.label(s.prompt.act) : 'E') });   // (the key follows the device in use)\n    this._piece('pr', play && pr, p => {\n      const box = this._el('div'), bar = this._el('div', 'esh-bar'), f = this._el('i'); f.style.width = clamp(p.progress || 0, 0, 1) * 100 + '%'; bar.appendChild(f);\n      box.append(this._el('div', 'esh-k', p.hint || (p.progress !== undefined ? 'Hold to interact' : 'Interact')), this._el('b', '', p.label || ''));\n      if (p.progress !== undefined) box.appendChild(bar);\n      return [this._el('kbd', '', p.key), box];\n    });\n    this._btns = s.buttons || [];   // (clicks call this step's: the functions may be new every step)\n    this._piece('hb', play && s.buttons && s.buttons.map(b => b[0]), labels => labels.map((l, i) => { const b = this._el('button', '', l); b.onclick = () => { const f = this._btns[i] && this._btns[i][1]; if (typeof f === 'function') f(); else if (f) { this._game.input.tap(f); this._held.add(f); } }; return b; }));\n    this._piece('tip', play && s.tip, t => typeof t === 'string' ? [this._el('b', '', t)] : [this._el('b', '', t.title), t.text && this._el('p', 'esh-m', t.text)]);\n    this._piece('place', play && s.place, p => [p]);\n    this._piece('keys', play && s.keys, ks => ks.map(([k, w]) => { const e = this._el('span'); e.append(this._el('kbd', '', k), w); return e; }));\n    const m = play && s.minimap; E3.mini.hidden = !m; if (m) this._miniLast = m;\n    if (m && (this._game.real - (this._miniT || -1) > .1)) { this._miniT = this._game.real; this._map(E3.mini, m, false); }\n    return this;\n  }\n  /** take its elements away and let go of the game (game.dispose() does it) */\n  dispose() { if (this.root) this.root.remove(); this.root = null; if (this._game.shell === this) this._game.shell = null; }\n  /** the settings items the game gave (a name is a standard setting: 'sound', 'volume', 'motion', ...) */\n  _items() { const it = this._o.settings && this._o.settings.items || []; return it.map(i => typeof i === 'string' ? Object.assign({ key: i }, STANDARD_SETTINGS[i]) : i).filter(i => i && i.key); }\n  /** an element with a class and text (text is never parsed as HTML) */\n  _el(tag, cls = '', text) { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined && text !== null && text !== false) e.textContent = String(text); return e; }\n  /** redraw one HUD piece when its state changed: build(state) -> its children */\n  _piece(k, state, build) {\n    const e = this._els[k], key = state ? JSON.stringify(state, (n, v) => n === 'from' || n === 'at' ? (v ? [Math.round(v.x), Math.round(v.y), Math.round(v.z || 0)] : v) : v) : '';\n    if (key === this._last[k]) return; this._last[k] = key; e.hidden = !state;\n    if (state) e.replaceChildren(...build(state).filter(Boolean).map(c => typeof c === 'string' ? document.createTextNode(c) : c));\n  }\n  /** a settings value changed: game.settings checks, saves and applies it, and tells the game */\n  _set(key, v) { return this._game.settings.set(key, v); }\n  /** one settings row: its label (and help), and a control for its type: a switch, a slider with its value, a choice\n   *  that turns with left and right, full screen (with why not, where it can't) */\n  _row(key) {\n    const S = this._game.settings, sp = S.spec(key); if (!sp) return null;\n    const row = this._el('div', 'esh-row'), lab = this._el('span', '', sp.label || actionName(key)), fs = this._game.fullscreen;\n    row.appendChild(lab);\n    const help = t => { if (t) lab.appendChild(this._el('small', '', t)); };\n    if (sp.type === 'fullscreen') {\n      const can = fs.supported && !fs.standalone, b = this._el('button', '', !can ? (fs.standalone ? 'App' : 'Not here') : fs.on ? 'On' : 'Off');\n      b.disabled = !can; b.setAttribute('role', 'switch'); b.setAttribute('aria-checked', String(fs.on)); b.onclick = () => { fs.toggle(); };\n      help(fs.standalone ? 'Opened from the home screen: no browser bars.' : !fs.supported ? (/iP(hone|od)/.test(navigator.userAgent) ? 'On an iPhone: Share, then Add to Home Screen, plays without the browser\\'s bars.' : 'This browser or page doesn\\'t allow it.') : '');\n      row.appendChild(b); return row;\n    }\n    help(sp.help);\n    if (sp.type === 'slider') {\n      const box = this._el('span', 'esh-ctl'), r = this._el('input'), out = this._el('output'), lo = sp.min === undefined ? 0 : sp.min, hi = sp.max === undefined ? 1 : sp.max;\n      const fmt = v => hi <= 1 && lo >= 0 ? Math.round(v * 100) + '%' : Math.round(v * 100) / 100 + (sp.unit || '');\n      Object.assign(r, { type: 'range', min: lo, max: hi, step: sp.step || (hi - lo) / 20, value: S[key] }); r.setAttribute('aria-label', sp.label || key); out.textContent = fmt(S[key]);\n      r.oninput = () => { out.textContent = fmt(this._set(key, +r.value)); };\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '529,574p' vendor/engine/kits/arcade.js && sed -n '200,245p' vendor/engine/API.md && rg -n 'class Sound|class Audio|class Settings|function instrument|unlock|voiceVolume|_master|stopAll' vendor/engine/my-3d2dge.js | tail -45\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '529,574p' vendor/engine/kits/arcade.js && sed -n '200,245p' vendor/engine/API.md && rg -n 'class Sound|class Audio|class Settings|function instrument|unlock|voiceVolume|_master|stopAll' vendor/engine/my-3d2dge.js | tail -45\"","aggregated_output":"  /* =================================== 3. ROCKS =================================== */\n  const ROCKS = (() => {\n    let RW = 320, RH = 240;   // the field: the whole screen (at least 320 x 240), its edges meeting\n    let cab, demo, ship, rocks, shots, saucer, over, wave, deadT, readyT, sparks, X0 = 0, Y0 = 0;\n    // a rock: a ring of lumpy points; size 3 big, 2, 1 small; the smaller, the faster\n    const rock = (x, y, size) => { const n = 8 + size * 2, R = [0, 5, 10, 18][size], a = Math.random() * TAU, sp = (52 - size * 11) * (.6 + Math.random() * .6); return { x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, size, R, rot: 0, spin: (Math.random() - .5) * 2, pts: Array.from({ length: n }, (_, i) => { const t = i / n * TAU, k = .75 + Math.random() * .35; return [Math.cos(t) * R * k, Math.sin(t) * R * k]; }) }; };\n    function newWave() { wave++; rocks = []; for (let i = 0; i < 3 + wave; i++) { const edge = Math.random() < .5; rocks.push(rock(edge ? 0 : Math.random() * RW, edge ? Math.random() * RH : 0, 3)); } if (wave > 1) cab.card('WAVE ' + wave, 1.4); }\n    const home = () => Object.assign(ship, { x: RW / 2, y: RH / 2, vx: 0, vy: 0, a: -Math.PI / 2 });\n    function begin(c, isDemo) { cab = c; demo = !!isDemo; wave = 0; over = false; shots = []; saucer = null; sparks = []; deadT = 0; readyT = 1.2; ship = { cool: 0, thrust: false }; layout(); home(); newWave(); }\n    const wd = (a, b, s) => E.wrapDiff(a, b, s), far = (a, b) => Math.hypot(wd(a.x, b.x, RW), wd(a.y, b.y, RH));\n    const burst = (x, y, n, sp, life, c) => { for (let i = 0; i < n; i++) { const a = Math.random() * TAU, v = sp * (.4 + Math.random() * .6); sparks.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, t: life * (.5 + Math.random() * .5), c }); } };\n    function kill() { deadT = 1.8; A.sfx('boom'); burst(ship.x, ship.y, 24, 80, .9, '#ffe0a0'); game.shake(3); }\n    function step(dt, I) {\n      layout(); if (readyT > 0 && (readyT > .3 || !rocks.some(k => far(k, { x: RW / 2, y: RH / 2 }) < k.R + 40))) readyT -= dt;   // (it comes back once the middle is clear)\n      if (deadT > 0 && (deadT -= dt) <= 0) { const was = cab.p, r = cab.die(); if (r === 'over') { over = true; return; } if (r === 'next') { was.save = { wave, rocks }; const s = cab.p.save; if (s) ({ wave, rocks } = s); else { wave = 0; newWave(); } } home(); readyT = 1.4; shots = shots.filter(s => !s.foe); }\n      const live = deadT <= 0 && readyT <= 0;\n      if (live) {   // turn, thrust (and drift: a little drag), fire, hyperspace (a one-in-ten chance it goes wrong)\n        const turn = demo ? botTurn() : I.move()[0], thr = demo ? botThrust() : I.down('up') || I.down('thrust') || I.move()[1] < -.6;\n        ship.a += turn * 4.4 * dt; ship.thrust = thr;\n        if (thr) { ship.vx += Math.cos(ship.a) * 170 * dt; ship.vy += Math.sin(ship.a) * 170 * dt; if (Math.random() < .6) sparks.push({ x: ship.x - Math.cos(ship.a) * 6, y: ship.y - Math.sin(ship.a) * 6, vx: -Math.cos(ship.a) * 50 + (Math.random() - .5) * 24, vy: -Math.sin(ship.a) * 50 + (Math.random() - .5) * 24, t: .3, c: '#ffb84a' }); }\n        const sp = Math.hypot(ship.vx, ship.vy); if (sp > 220) { ship.vx *= 220 / sp; ship.vy *= 220 / sp; }\n        ship.vx *= Math.exp(-.4 * dt); ship.vy *= Math.exp(-.4 * dt); ship.cool -= dt;\n        if ((demo ? botFire() : I.pressed('fire')) && ship.cool <= 0 && shots.filter(s => !s.foe).length < 5) { shots.push({ x: ship.x + Math.cos(ship.a) * 7, y: ship.y + Math.sin(ship.a) * 7, vx: Math.cos(ship.a) * 290 + ship.vx, vy: Math.sin(ship.a) * 290 + ship.vy, t: .85 }); ship.cool = .12; A.sfx('laser', { vol: .3 }); }\n        if (demo ? botWarp() : I.pressed('warp')) { burst(ship.x, ship.y, 10, 40, .4, '#8ab8ff'); ship.x = Math.random() * RW; ship.y = Math.random() * RH; ship.vx = ship.vy = 0; A.sfx('warp'); if (Math.random() < .1) kill(); }\n      }\n      if (deadT <= 0) { ship.x = E.wrap(ship.x + ship.vx * dt, 0, RW); ship.y = E.wrap(ship.y + ship.vy * dt, 0, RH); }\n      for (const s of shots) { s.x = E.wrap(s.x + s.vx * dt, 0, RW); s.y = E.wrap(s.y + s.vy * dt, 0, RH); s.t -= dt; }\n      for (const k of rocks) { k.x = E.wrap(k.x + k.vx * dt, 0, RW); k.y = E.wrap(k.y + k.vy * dt, 0, RH); k.rot += k.spin * dt; }\n      for (const p of sparks) { p.x += p.vx * dt; p.y += p.vy * dt; p.t -= dt; } sparks = sparks.filter(p => p.t > 0);\n      // the saucer: now and then, across the screen, shooting at you (across the edges: the nearer way)\n      if (!saucer && live && Math.random() < dt * .05 * wave) saucer = { x: 0, y: 30 + Math.random() * (RH - 60), vx: Math.random() < .5 ? 60 : -60, vy: 0, t: 0, cool: 1.2 };\n      if (saucer) {\n        saucer.x = E.wrap(saucer.x + saucer.vx * dt, 0, RW); saucer.t += dt; saucer.vy = Math.sin(saucer.t * 2) * 22; saucer.y = E.wrap(saucer.y + saucer.vy * dt, 0, RH); saucer.cool -= dt;\n        if (saucer.cool <= 0 && live) { const a = Math.atan2(wd(saucer.y, ship.y, RH), wd(saucer.x, ship.x, RW)) + (Math.random() - .5) * .5; shots.push({ x: saucer.x, y: saucer.y, vx: Math.cos(a) * 150, vy: Math.sin(a) * 150, t: 1.4, foe: true }); saucer.cool = 1.4; A.sfx('shoot', { vol: .2, pitch: .6 }); }\n        if (saucer.t > RW / 60) saucer = null;\n      }\n      // hits: your shots split rocks (big 20, middle 50, small 100) and down the saucer (500); rocks, its shots and it on you\n      for (const s of shots) {\n        if (s.t <= 0 || s.foe) continue;\n        for (const k of rocks) if (!k.dead && far(s, k) < k.R) { k.dead = true; s.t = 0; cab.add([0, 100, 50, 20][k.size], { x: X0 + k.x, y: Y0 + k.y }); A.sfx(k.size > 2 ? 'boom' : 'explode', { vol: .4 }); burst(k.x, k.y, 6 + k.size * 3, 60, .6, '#c8d8ff'); if (k.size > 1) for (let i = 0; i < 2; i++) rocks.push(rock(k.x, k.y, k.size - 1)); break; }\n        if (s.t > 0 && saucer && far(s, saucer) < 8) { cab.add(500, { x: X0 + saucer.x, y: Y0 + saucer.y }); s.t = 0; burst(saucer.x, saucer.y, 16, 70, .7, '#ff8aa8'); saucer = null; A.sfx('boom'); }\n      }\n      rocks = rocks.filter(k => !k.dead); shots = shots.filter(s => s.t > 0);\n      if (live && (rocks.some(k => far(ship, k) < k.R + 4) || shots.some(s => s.foe && far(s, ship) < 5) || (saucer && far(saucer, ship) < 10))) kill();\n      if (!rocks.length) newWave();\n    }\n**Bullets**: `const shots = new E.Bullets(game, { plane: 'ground' | 'side' })`; `shots.fire({ x, y, z, vx, vy, vz, r: 2, team: 'player', color, life, dmg, pierce, sprite })`; `shots.burst(base, E.pattern.spread(angle, n, arc, speed))`; `shots.update(dt, map)`; `shots.hit(targets, (b, t) => {...}, 'player')`; `shots.draw(r)`; `shots.clear(team)`. Patterns: `E.pattern.dir(angle, speed)`, `aim(a, b, speed)`, `aimSide(a, b, speed)`, `spread(angle, n, arc, speed)`, `ring(n, speed, offset)`. In side view the second number of a pattern velocity is vz.\n\n**Helpers**: `E.dist(a, b)`, `E.angleTo(a, b)`, `E.arc(a, b, gravity, { apex | time | speed })` → `{ vx, vy, vz, t }` (a throw that lands at b: a lob, a grenade), `E.overlap(a, b)` (circles x, y, r), `E.overlapBox(a, b)` (side boxes x center, z feet, w, h), `E.inArc(a, facing, b, range, halfAngle, dz)` (melee cone; `dz` limits the height difference), `E.rand(a, b)`, `E.randInt(a, b)`, `E.pick(list)`, `E.chance(p)`, `E.prune(list, fn)`, `E.store.get(key, fallback)` / `set(key, value)` (save data; slots: `game.saves`), `new E.SpatialHash(32)` (`build(list)`, `near(x, y, r, fn)`), `new E.FlowField(map)` (`update(tx, ty)` or `update([[x, y], ...])`: the nearest; `dir(x, y, tx, ty)` walks around walls and `map.solid` shapes), math `clamp lerp approach ease.* angDiff approachAng smoothDamp rng(seed) noise2 hex shade mix`; `E.version` (the release) and `E.versionLabel()` ('v0.7.0 · a1b2c3d 2026-10-07': show it on a title or a debug screen).\n\n## Characters\n**Humanoid** (knights, heroes, soldiers, zombies): `new E.Humanoid({ size: 1.3, build: 'chibi' (default) | 'heroic' (tall) | 'bulky' (brawlers, bosses) | 'skeleton' (tint with colors.bone), weapon: 'sword' (the default) | 'gun' | 'staff' | null (fists) | a game's own (`E.Humanoid.weapon(id, { length, rest, draw(w) })`; `.hat(id, draw)`, `.pose(id, (J, w) => ...)`; `draw: { under, over }`; state `tilt`, `roll`), outfit: 'shirt' | 'tunic' | 'robe' | 'coat', hair: 'short' | 'spiky' | 'long' | 'ponytail' | 'bald', hat: 'cap' | 'pointed' | 'helmet' | 'band' | 'crown' (or { style, color }), sleeves: 'short' | 'long' | 'none', armor, hood (in colors.hair), cape: { len: 6, width: 5, seg: 2.5 }, eyeGlow, hunch, lean, style: 'hd' (default) | 'classic' (stick figures for huge crowds), colors: { skin, hair, cloth, coat, pants, boot, belt, trim, glove, cape, capeIn, metal, plate, hilt, eye, iris } })` (`metal` colors the weapon, `plate` the armor, defaulting to `metal`).\n- `rig.update(dt, { x, y, z, vx, vy, facing, dash, hurt, air, point, aim, attack })`. `facing` is an angle (side view: 0 = right, `Math.PI` = left). `air: true` tucks the legs for jumps; `point: true` holds a gun forward; `aim` tilts it (radians, + = up: `aim: .8` shoots diagonally up, `Math.PI / 2` straight up).\n- **Moves** (`E.MOVES`, use them instead of hand-made specs; every one has anticipation, a committed strike with lunge / step / lean / twist, follow-through and a clean return to the stance, on every build and in every view):\n  - blades and clubs: `slash backslash overhead rising thrust spin plunge twohand`;\n  - fists: `jab` (left hand) `cross hook uppercut haymaker elbow`;\n  - kicks: `kick roundhouse sweep flyingkick knee axekick`;\n  - other: `cast` (both hands) `throw bash claw`.\n  Give each character its own set (a knight: `overhead`, `thrust`, `spin`; a mage: `cast`; a monk: `jab`, `cross`, `roundhouse`; a boss: `haymaker`, `sweep`). `E.move('uppercut', .5)` is the attack state of any move at any moment (previews, cutscenes).\n- `attack: { spec, phase: 'wind' | 'active' | 'recover', u: 0..1 }`, spec `{ a0, a1, z0, z1, reach, r0, r1, hand, rel, blade, spin, kick, plane, lunge, hop, crouch, lean, twist, hold }`. Angles are relative to facing (+ = right hand side). `rel: true`: heights relative to the shoulder and reach scaled by arm length (kick heights as a share of hip height). `r0`/`r1`: reach that extends (thrusts, jabs). `hand: 'L' | 'both'`. In side views horizontal swings turn into the screen plane (a Castlevania chop) by themselves; `plane: 'side' | 'ground'` (or the rig option `swingPlane`) chooses. `lunge` steps into the strike (body motion in local units, clamped to -4..5; to move the character itself, add speed to your body), `hop` lifts the body, `crouch` dips in the wind-up, `hold` is how long the end pose holds (share of recover). You time the phases.\n- In steep ground views (threequarter) rigs and Blobs are drawn from a lower, sprite-like angle so faces show, like SNES RPG sprites (`charView: false` turns it off for one rig, `E.style.charPitch = false` for all).\n- Faces (eyes with catch-lights, brows, mouth), a cheated 3/4 turn toward the camera in side views (`cheat: .5`, 0 turns it off) and hair layers are automatic. `face: { eyes: 'big' (anime / Mana style), bangs: 0..1 }`.\n- Poses: `rig.update(dt, { ..., pose: 'cheer' | 'cast' | 'guard' | 'kneel' | 'crouch' | 'wave' | 'hips' | 'down' })` (they blend in and out), `'block'` (weapon upright across the body), `'die'` (a stagger, then the body topples), `expr: 'smile' | 'shout' | 'angry' | 'wince'` (faces and portraits), `run: 0..1` (run in place), or `down: 0..1` to lie a defeated body flat. `stance: 'guard'` keeps fists up while walking (brawlers; the free hand guards the chin during punches), `stance: 'ready'` holds the weapon forward. `climb: true` with `vz` climbs a ladder hand over hand (`Platformer.rigState()` passes both). Traversal: `crouch` (a sneaking gait), `sprint` (a lean), `hang` with `hangZ` (hands on an edge that high above the feet), `flip: 0..1` (a roll), `land: k` (a heavy landing); `mover.rigState()` sets them. Every wind-up starts from the rig's current pose, so chained hits and hand changes never snap. Idle rigs breathe and shift their weight by themselves.\n- `rig.draw(g, ox, oy, view)` inside `r.actor`, `rig.drawSmear(r)` (a glowing trail along the real blade, fist or foot path, in every view), `rig.debug(r)` (skeleton), `rig.kick(v)` (squash and stretch), `rig.hand()` and `rig.tip()` (world points to spawn bullets from), `rig.worldOffset(p)` (where a point in the rig's own frame, such as a joint in `rig.J`, sits from its feet: to draw or spawn at any joint), `rig.lastView` (the view it last drew with), `rig.solvePose()` (sets `rig.J` from its state each step: wrap it on one rig to move joints).\n**Blob** (slimes, rabbites, bats, imps, round monsters): `new E.Blob({ R: 6, colors: { dk, base, lt, spec, eye, pupil }, ears: 'rabbit' | 'cat', horns: true, wings: true, feet: true, tail: true, mouth: true | 'fangs', face: 'front' })`, `update(dt, { squash: -0.4..0.4, look: [dx, dy], squint, walk: 0..1, flap: 0..1 (wing speed; 0 folds them), hang: true (roost upside down) })`, `kick(v)`, `draw(g, ox, oy, view)`. Mix the parts for a bestiary: `wings` + `mouth: 'fangs'` is a bat, `ears: 'rabbit'` + `feet` a Mana rabbite, `horns` + `tail` an imp.\n\n## Effects and lighting\n- Particles: `game.particles.explosion(x, y, z, size)` (fireball, smoke, sparks, debris, ring, shake, sound), `fire(x, y, z, n, { size })`, `smoke(x, y, z, n, { size, color })`, `glints(x, y, z, n, color)`, `dust(x, y, z, n)`, `sparks(x, y, z, n, angle)`, `bits(x, y, z, n, colors)`, `ring(x, y, r0, r1, color, dur)`, `text(x, y, z, '12', color, { scale: 2, bounce: true })` (bouncing damage numbers), `add({ kind: 'dust' | 'spark' | 'bit' | 'ember' | 'fire' | 'smoke' | 'glint', ... })`. `explosion(x, y, z, size, { debris, freeze: false, shake: 0 })` for chains of small blasts. Side-scrollers: `particles.ground = (x, y, z) => level.groundBelow(x, z)` so sparks and debris bounce on platforms. Screen flash: `game.flash('#ffffff', .12, strength 0..1)`.\n- Lighting (step 9; every view, side-scrollers included, no WebGPU needed): `game.lights.add(x, y, z, radius, intensity, { color: '#ffa050' })` every draw. Dark areas get a smooth cool tint, lights add their own color, and emissive items (flames, sparks, bullets, `emissive: true`) stay bright. `lights.darkness` (0..1) and `lights.tint` tune it; after setting `lights.dark = [r, g, b]`, `levels` or `glow`, call `lights.refresh()`. Props with flames can light the scene: `r.prop('torch', x, y, z, { light: true })`. Lamps, street lamps, lanterns and crystals glow on their own (`haloR`, `haloColor`, `halo: false`); `cone: true` adds a light cone under a street lamp.\n- Hits: `game.hitFx(x, y, z, { power: 1, angle, damage: 12, textScale: 2, textZ: 22 })` does hit-stop, shake, an impact star, sparks, a bouncing damage number (`bounce: false` floats it) and a sound in one call; `particles.impact(x, y, z, size, color)` for the star alone.\n- GPU lighting (optional, ground views with a TileMap): `const gpu = game.enableGPU({ map })`; mark glowing things with `px.glow(g, 1)`; add `lights.caster(x, y, r, top)` and `lights.heat(x, y, z, w)`. Where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with `game.lights.ambient` (`gpu.fallback = false`: unlit).\n\n## Genre playbook (NES, SNES, Genesis, N64, PS1)\n| Genre (examples) | View | Build it with | Copy slice |\n|---|---|---|---|\n| Platformer (Mario, Mega Man, Sonic, Castlevania) | `side` (+ `brawler` for 2.5D) | PlatformMap, Platformer, Humanoid, sprites, Bullets `'side'` | PLATFORMER |\n| Metroidvania (Metroid, Symphony of the Night) | `side` | an `E.World` of PlatformMaps (the rooms module: doors at open edges, a slide, the explored map, gates opened by abilities, saves), a Platformer given `airJumps` and `dash` as they are found, its further moves, an arm cannon aimed eight ways (`point`, `aim`, `rig.tip()`, Bullets) | METROIDVANIA |\n| Action adventure (Zelda, Secret of Mana) | `threequarter` or `topdown` | TileMap rows, `cam.room`, Body, Humanoid + `E.Attack` sword, Dialog, `E.ui.hearts` | ADVENTURE |\n| Point-and-click adventure (Monkey Island, Day of the Tentacle, Broken Sword) | none: rooms painted in screen pixels (`r.overlay`) | `E.Click` (the click module): rooms with walk areas and holes (`E.Walkbox`), depth scale, hotspots, the nine verbs, Sierra's icons or a verb coin, an inventory, puzzles as rules; talk through `E.Story` | POINT-AND-CLICK |\n| Visual novel (Phoenix Wright, Snatcher, Clannad) | none | `E.Story` nodes and choices over a painted backdrop, `rig.drawPortrait` at size, `story.log` (the backlog), `story.auto`, `story.skip`; `game.saves` | POINT-AND-CLICK |\n| Action RPG / dungeon (Diablo, Landstalker) | `iso` | TileMap, FlowField, Body (jump onto blocks), GPU lighting | ADVENTURE |\n| Beat-'em-up (Final Fight, Streets of Rage, TMNT) | `brawler` | TileMap street strip, Body, Humanoid (`weapon: null`) + `E.Combo` punches and `kick: true` kicks, `E.knockback`, waves that lock the screen; a second player drops in (`game.allowJoin`, `cam.frame` on both) | BRAWLER |\n| Fighting (Street Fighter II, Darkstalkers) | `side` | two `E.Fighter`s in an `E.Match` (the fight module): moves with frame data, guards, throws, specials by motion (`'236'`) or charge, a meter, projectiles; `E.FightAI`, `E.FightSelect`, training | FIGHTING |\n| Shoot-'em-up (1942, Gradius, R-Type) | `overhead` (vertical, and horizontal: world x scrolls) | sprites, Bullets, `E.pattern`, a timeline of waves; horizontal: rock edges as functions of x, a power bar, options on the ship's past path, `E.Path` loops; `E.Arcade` for the continue and the table | SHOOTER (both stages) |\n| Pinball (Pinball Fantasies, Space Cadet, Devil's Crush) | a steep table view of its own (`new E.View('pinball', 'Table', 0, 62, 1, 1)`) | `E.Physics`: chains for the walls, `flipper`, `bumper`, `slingshot`, `kicker`, a ramp on a layer of its own, the ball a `bullet`; `input.zones` flip on a phone; `E.Arcade` for the score and table. Breakout and Asteroids with real collisions are its recipes | PINBALL |\n| Artillery (Worms, Scorched Earth) | `side` at a whole scale (`new E.View(id, label, 0, 0, 1, 1)`) | `E.Terrain` (`carve` the blasts, `walk` the soldiers, `ray` the shots), grenades as `E.Physics` bodies on `land.collider()`, `E.Turns`; a drag aims (`steer = 'drag'`, `drag()`, `stickOn`); a CPU tries its shots in simulation | ARTILLERY |\n| Golden-age arcade (Pac-Man, Galaga, Asteroids) | `overhead` (one fixed screen, cabinet art on the sides) | `E.Arcade` (score, lives, extra lives, turns, initials, tables, attract mode); a maze of `E.GridMover`s; moths on `E.Path`s turned by `rot`; `E.wrap` and `wrap: [w, h]` | ARCADE |\n| Twin-stick / run-and-gun (Smash TV, Contra) | `topdown` / `side` | Body or Platformer, Bullets, `weapon: 'gun'`, `point: true` | SHOOTER + ADVENTURE |\n| JRPG (Dragon Quest, Final Fantasy, EarthBound) | `threequarter` town, `brawler` battles | TileMap towns and a big world map, the story and rpg modules, Dialog with markup, `game.saves` slots | RPG |\n| Puzzle (Tetris, Dr. Mario, Puyo, Columns) | `side` (a field in screen pixels) | a cell array, a bag from `E.rng`, `input.repeat` (auto-shift), `grid.groups` (chains), `input.drag()` and `clicked()` for touch; versus: two fields, rows sent across (`game.players`) | PUZZLE |\n| Roguelike (Rogue, Mystery Dungeon, Shiren) | `threequarter` / `iso` | `E.gen` floors, a TileMap of its rows, `E.Grid.from(map)` paths and `fov`, `E.Fog`, `E.Turns` by speed, `game.tween` steps | ROGUELIKE |\n| Tactics (Final Fantasy Tactics, Tactics Ogre, Fire Emblem) | `iso`, turned a quarter | TileMap of block heights, `map.pick` under the cursor, `E.Grid.from(map, { tops: true })` reach over heights, `grid.shape`, `grid.side`, `grid.threat`, `E.Turns` charge time, `E.Story` | TACTICS |\n3087:class Settings {\n7742:     *  is none); volume: master volume 0..1; sfxVolume, musicVolume, voiceVolume: 0..1 for effects, music and the voice\n7744:    this._game = game; this._signal = signal; this.ctx = null; this.volume = .7; this.sfxVolume = 1; this.musicVolume = .5; this.voiceVolume = 1; this.muted = false;\n7753:    // sound draws its own random numbers (noise, pitch variation): whether sound is on, muted or not yet unlocked by a tap\n7762:      this._master = c.createGain(); this._master.connect(c.destination);\n7763:      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n7764:      this._musBus = c.createGain(); this._musBus.connect(this._master);\n7765:      this._voiceBus = c.createGain(); this._voiceBus.connect(this._master);   // (bus('voice'): a game's babble or speech)\n7778:  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || [... omitted end of long line]\n7781:   *  voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio) */\n7785:    return name === 'master' ? this._master : name === 'music' ? this._musBus : name === 'voice' ? this._voiceBus : this._sfxBus;\n","exit_code":0,"status":"completed"}}
