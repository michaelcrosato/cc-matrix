{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\n(function(S){\n  'use strict';\n  const E=My3D2dge;\n  class App{\n    constructor(info){\n      this.online=null;this.mode=info?'hub':'title';this.attract=false;this.simRate=1;this.acc=0;this.epoch=0;this.best=Number(E.store.get('space-fortnight-best',0))||0;\n      this.best=Number.isFinite(this.best)?Math.max(0,this.best):0;\n      const server=\"'!!info?.server;\n      this.game=new E.Game({id:'\"'space-fortnight-v1',canvas:'screen',res:[S.W,S.H],expand:false,view:'overhead',views:['overhead'],input:S.MAP,\n        headless:server,draw:false,loop:\"'!info,live:!!info,autoPause:!info,corner:false,fullscreen:'\"'button',backGesture:false,bg:'#07141f',\n        menu:{quit:false,controls:{fire:'Laser',boost:'Boost',pulse:'Defensive pulse'},settings:[{key:'music',value:.1},{key:'glyphs',value:'playstation',options:[['playstation','PlayStation'],['xbox','Xbox']]}]}});\n      const game=this.game;game.fadeTime=0;game.cam.smooth=0;game.cam.bounds=null;game.focus(480,270,0);\n      game.lights.enabled=true;game.lights.ambient=.84;\n      this.sound=new S.Sound(game);\n      if(\"'!server){\n        this.painter=new S.Painter(game);this.input=new S.IntentInput(this);this.ui=new S.Interface(this);\n        game.settings.set('\"'scale','fill');\n        const style=document.createElement('style');style.textContent=S.CSS;document.head.append(style);\n        game.hook('input',()=>{\n          this.input.pollActivity();\n          if(performance.now()<(this.blockInputUntil||0))for(const I of game.players)for(const a in I.map)I.suppress(a);\n          this.ui.tick();\n          this.checkIdle();\n          if(game.paused&&\"'!this.online)this.sound.mode(null,true);\n        });\n      }\n      const scenes={\n        title:{pausable:false,view:'\"'overhead',res:[S.W,S.H],expand:false,camera:{zoom:false},\n          enter:()=>{game.focus(480,270,0);},update:()=>{this.sound.mode('title');},draw:r=>this.painter?.title(r,game.time)},\n        play:{pausable:true,view:'overhead',res:[S.W,S.H],expand:false,camera:{zoom:false},\n          update:dt=>this.update(dt),draw:r=>this.draw(r)},\n      };\n      game.start({scenes,scene:info?'play':'title'});\n      if(info){\n        this.online=new S.Online(this,info);\n        if(\"'!server)this.ui.shell.hide();\n        let last=performance.now();\n        this.timer=setInterval(()=>{\n          const now=performance.now(),elapsed=(now-last)/1000;last=now;\n          if(this.online.ended)return;\n          try{game.advance(elapsed,{draw:false});}catch(e){game.fail('\"'session clock',e);}\n        },16);\n        if(\"'!server){const render=()=>{if(game.disposed)return;try{game.advance(0,{draw:true});}catch(e){game.fail('\"'session draw',e);}this.raf=requestAnimationFrame(render);};this.raf=requestAnimationFrame(render);}\n      }else this.title();\n      this.installDebug();globalThis.__game=game;globalThis.__fortnight=this;\n      document.documentElement.dataset.game='space-fortnight';\n    }\n    enableJoin(on){this.game.allowJoin(on?{max:4,onJoin:I=>{I.use(S.MAP);this.ui?.refreshJoin();}}:false);}\n    title(){\n      if(this.online)return;\n      this.attract=false;this.mode='title';this.world=null;this.simRate=1;this.acc=0;this.sound.reset();this.input?.clear();\n      this.game.paused=false;this.game.timeScale=1;this.enableJoin(false);\n      while(this.game.players.length>1)this.game.removePlayer(this.game.players.length);\n      this.game.input.use(S.MAP);this.game.go('title',null,{fade:0});this.input.lastActivity=performance.now();this.ui?.title();this.sound.mode('title');\n    }\n    startSolo(){if(this.online)return;this.enableJoin(false);while(this.game.players.length>1)this.game.removePlayer(this.game.players.length);this.game.input.use(S.MAP);this.start([{id:0,name:'VIPER 01',color:S.ASSETS.playerColors[0]}]);}\n    startCouch(){if(this.online)return;this.enableJoin(false);this.start(this.game.players.map((I,i)=>({id:i,name:\"'`VIPER 0${i+1}`,color:S.ASSETS.playerColors[i]})));}\n    start(players,attract=false){\n      this.sound.reset();this.ui.shell.hide();this.game.paused=false;this.simRate=1;this.acc=0;this.attract=attract;this.attractAge=0;this.attractStage=0;\n      this.world=new S.World({players,seed:198113,epoch:++this.epoch,demo:attract});this.mode='\"'play';this.lastResult=null;this.input.clear();\n      this.ui.lastPhase='';this.ui.lastRadio='';this.game.go('play',null,{fade:0});this.game.lights.enabled=true;\n      this.painter.lastEvent=0;this.painter.shake=0;document.body.dataset.screen=attract?'attract':'play';\n    }\n    retry(){const players=this.world.s.players.filter(p=>\"'!p.gone).map(({id,name,color})=>({id,name,color}));this.start(players);}\n    checkIdle(){\n      if(this.online||this.attract||!['\"'title','join'].includes(this.mode))return;\n      if(performance.now()-this.input.lastActivity>=10000)this.start([{id:0,name:'DEMO VIPER',color:S.ASSETS.playerColors[0]}],true);\n    }\n    update(dt){\n      if(this.online){this.online.update();}\n      else if(this.world){\n        const w=this.world;\n        if(this.attract){\n          this.attractAge+=dt;\n          const marks=[18,35,54,73,96,119,146];\n          if(this.attractAge>=marks[this.attractStage]){\n            const stage=this.attractStage++;\n            if(stage===0)w.jump(0,2);if(stage===1)w.jump(1,1);if(stage===2)w.jump(2,1);\n            if(stage===3)w.jump(2,2,0);if(stage===4)w.jump(2,2,1);if(stage===5)w.jump(2,2,2);\n            if(stage===6){this.start([{id:0,name:'DEMO VIPER',color:S.ASSETS.playerColors[0]}],true);return;}\n            w.s.options.god=true;\n          }\n        }\n        this.acc+=dt*this.simRate;\n        while(this.acc>=S.DT-1e-9){this.acc-=S.DT;\n          for(const [i,p]of w.s.players.entries()){\n            const intent=this.attract||this.testBot?S.botIntent(w,p.id,++this.input.seq):this.input.intent(p,i);w.setIntent(p.id,intent);\n            if(this.attract&&w.s.phase==='upgrade')w.upgrade(p.id,0);\n          }\n          w.step();\n        }\n      }\n      const s=this.world?.s;if(\"'!s)return;\n      const song=s.result?s.result.won?'\"'victory':'defeat':s.boss?'boss':'act'+s.act;\n      this.sound.mode(song,this.game.paused&&\"'!this.online||this.online?.ended);this.sound.events(s);\n      if(s.result&&!this.lastResult){\n        this.lastResult=s.result;\n        if(!this.attract&&!this.online&&!s.modified){this.best=Math.max(this.best,s.score);E.store.set('\"'space-fortnight-best',this.best);}\n      }\n      this.ui?.tick();\n    }\n    draw(r){\n      if(\"'!this.painter||!this.world)return;\n      const s=this.online?this.online.renderState():this.world.s;\n      this.painter.draw(r,s,this.game.time,{demo:this.attract});\n      const q=this.game.settings.shake;if(q>0&&!this.game.settings.motion){\n        this.painter.shake*=.88;if(this.painter.shake>.2)this.game.shake(this.painter.shake*q*.35);}\n      if(s.act===1)this.game.lights.add(480,277,0,190,.5,{color:'\"'#a7e4cc'});\n      for(const p of s.players)if(p.hp>0)this.game.lights.add(p.x,p.y,0,44,.3,{color:p.color});\n    }\n    showCountdown(time){\n      const e=document.getElementById('hub-state');if(\"'!e||this.online?.info.server)return;\n      if(time===null){if(!this.online.ended)e.hidden=true;return;}\n      e.hidden=false;e.textContent=Number.isFinite(time)?String(Math.ceil(-time/1000)):'\"'VIPER WING / STANDING BY';\n      const small=document.createElement('small');small.textContent='Protect Fortress 13. Break the siege ship.';e.append(small);\n    }\n    afterJump(){this.input?.clear();this.painter.lastEvent=this.world.s.eventSeq;this.sound.reset();this.ui.lastPhase='';this.ui.shell.hide();this.game.resume();document.body.dataset.screen='play';}\n    installDebug(){\n      const app=this;this.game.debug={snapshot:()=>this.world?.snapshot()||{phase:'title'},\n        advance(second