{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/data/encounters.js');s=p.read_text().replace('  for (const wave of WAVES)', '''  const REINFORCEMENTS = [\n    [[9,'hunter',2,'right'],[24,'hunter',2,'top'],[40,'hunter',3,'left'],[55,'hunter',3,'top']],\n    [[8,'hunter',2,'left'],[21,'hunter',2,'right'],[36,'hunter',2,'top'],[57,'hunter',3,'left']],\n    [[10,'hunter',2,'left'],[23,'hunter',3,'top'],[37,'hunter',2,'right'],[59,'hunter',3,'left']],\n    [[9,'hunter',2,'right'],[23,'rammer',2,'right'],[38,'hunter',3,'left'],[61,'rammer',2,'top']],\n    [[9,'hunter',2,'left'],[22,'rammer',2,'top'],[36,'hunter',3,'left'],[62,'rammer',2,'right']],\n    [[7,'hunter',2,'right'],[19,'hunter',3,'left'],[31,'rammer',2,'right'],[42,'hunter',2,'top'],[64,'rammer',2,'left']],\n    [[9,'dive',3,'top'],[24,'dive',3,'top'],[43,'dive',3,'top']],\n    [[7,'hunter',2,'top'],[18,'dive',3,'top'],[29,'dive',3,'top'],[46,'dive',3,'top']],\n    [[7,'hunter',2,'top'],[19,'dive',3,'top'],[29,'dive',3,'top'],[44,'dive',3,'top']],\n  ];\n  WAVES.forEach((wave,i)=>{ wave.groups.push(...REINFORCEMENTS[i].map(g=>group(...g))); wave.groups.sort((a,b)=>a.at-b.at); });\n  for (const wave of WAVES)''')\np.write_text(s)\np=Path('src/sim/world.js');s=p.read_text().replace('cycle:0,shot:0,dead:false,parts:[]','cycle:0,shot:1.5,wind:0,lanes:[],dead:false,parts:[]')\na=s.index(\\\"        if(boss.shot<=0){boss.shot=2.8;\\\");b=s.index(\\\"      }else if(boss.phase===1)\\\",a)\ns=s[:a]+'''        if(boss.shot<=0&&cycle>1.5){\n          boss.shot=4.4;boss.wind=1.35;boss.lanes=[];\n          for(const c of boss.parts.slice(0,2))if(c.hp>0){const p=this.closestPlayer(c);if(p)boss.lanes.push({index:c.index,x:clamp(Math.round(p.x/110)*110,70,890)});}\n          this.emit('warning',0,cx,cy);\n        }\n        if(boss.wind>0&&(boss.wind-=dt)<=0){\n          for(const lane of boss.lanes){const c=boss.parts[lane.index];if(c.hp>0){const a=aimAt(c,{x:lane.x,y:490});for(let k=-1;k<=1;k++)this.shot(c.x,c.y,a+k*.055,102,true,0,{r:5,lane:true});}}\n          boss.lanes=[];\n        }\n''' + s[b:]\ns=s.replace(\\\"boss.phaseAge=0;boss.shot=2;s.bossPhases\\\", \\\"boss.phaseAge=0;boss.shot=2;boss.wind=0;boss.lanes=[];s.bossPhases\\\").replace('if(boss.parts[4].hp<=0&&boss.phaseAge>=18)boss.dead=true;','if(boss.parts[4].hp<=0)boss.dead=true;')\np.write_text(s)\np=Path('src/render/scene.js');s=p.read_text().replace(\\\"        if(boss.phase===1&&cycle>1.5\\\", \\\"        if(boss.phase===0&&boss.wind>0)for(const lane of boss.lanes||[]){const c=boss.parts[lane.index];line(g,c.x,c.y,lane.x,483,'#d8a98f',2);ring(g,lane.x,457,28,'#edc49b');txt(g,'IMPACT LANE',lane.x,423,C.cream,1,'center');}\\\\n        if(boss.phase===1&&cycle>1.5\\\")\np.write_text(s)\nPY\nnode --input-type=module - <<'JS'\nimport {loadSim} from './tools/sim-loader.mjs';const S=loadSim();\nfor(const n of [1,2,4]){const w=new S.World({players:Array.from({length:n},(_,id)=>({id,name:'BOT '+id})),seed:198113});for(let i=0;i<110000&&\"'!w.s.result;i++){for(const p of w.s.players){w.setIntent(p.id,S.botIntent(w,p.id,i));if(w.s.phase==='\"'upgrade')w.upgrade(p.id,p.id%3);}w.step();}console.log(JSON.stringify({n,result:w.s.result,hp:w.s.players.map(p=>p.hp),seen:w.s.seen,phases:w.s.bossPhases}));}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
