{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"rg -n 'window\\\\.|globalThis|__hub' tests/hub/harness.html | tail -25 && sed -n '198,272p' tests/hub/harness.html && sed -n '1,40p' tests/hub/harness.html\"","aggregated_output":"379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n412:  window.__hubCheck = report;\n517:        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n      render(state);\n    },\n  });\n  hubEnd.onMessage((from, env) => {\n    if (env.k !== 'c' || env.r !== round) return;\n    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\n    state.coordinator.receive(from, env.m);\n  });\n\n  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n    const frame = document.createElement('iframe');\n    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n    frame.title = p.name;\n    const label = document.createElement('div');\n    label.className = 'cell__bar';\n    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n    label.querySelector('b').textContent = `${p.name} (${p.key})`;\n    const el = document.createElement('div');\n    el.className = 'cell';\n    el.style.borderColor = color;\n    el.append(label, frame);\n    grid.append(el);\n\n    const endpoint = net.endpoint(p.key);\n    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n    });\n    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n    frame.addEventListener('load', () => instrument(cell), { once: true });\n    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n    state.cells.push(cell);\n  }\n  renderWho(state);\n  render(state);\n  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n  // the conformance run releases it itself.\n  const ticker = setInterval(() => {\n    if (state !== current || state.coordinator.released) return clearInterval(ticker);\n    if (!auto && performance.now() >= state.splashUntil) return releaseRound(state);\n    tickCard(state);\n  }, 250);\n  return state;\n}\n\nfunction releaseRound(state = current) {\n  if (!state || state !== current || state.coordinator.released) return;\n  state.splashUntil = null;\n  tickCard(state);\n  log('splash over: the round starts once every game has loaded');\n  state.coordinator.release();\n}\n\n/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI Hub Session Harness</title>\n<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n<style>\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n  body { display: grid; grid-template-rows: auto 1fr; }\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n  input[type=number] { width: 70px; }\n  input.game { width: 300px; }\n  button { cursor: pointer; }\n  button:hover { border-color: var(--dim); }\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n  #checks li { list-style: none; }\n  #checks ul { margin: 0; padding: 0; }\n  .ok::before { content: '✓ '; color: var(--ok); }\n  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser_checks.py <<'EOF'\n\\\"\\\"\\\"Real packaged-artifact checks; stdout is a JSON test report consumed by verify.mjs.\\\"\\\"\\\"\nfrom pathlib import Path\nimport functools\nimport http.server\nimport json\nimport sys\nimport threading\nimport traceback\nimport urllib.parse\nimport urllib.request\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent.parent\nARTIFACT = ROOT.parent / (ROOT.name + '.html')\nRESULTS = []\nPAD_SCRIPT = \\\"\\\"\\\"window.testPads=[{id:'DualSense standard test pad',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),timestamp:0}];navigator.getGamepads=()=>window.testPads;\\\"\\\"\\\"\n\ndef check(name, fn):\n    try:\n        detail = fn()\n        RESULTS.append({'name': name, 'pass': True, 'detail': detail or ''})\n    except Exception:\n        RESULTS.append({'name': name, 'pass': False, 'error': traceback.format_exc()})\n\ndef need(value, message):\n    if not value:\n        raise AssertionError(message)\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_):\n        pass\n\ndef boot(page):\n    page.goto(ARTIFACT.as_uri())\n    page.wait_for_function('window.__fortnight && window.__game && __fortnight.ui.shell.screen === \\\"title\\\"')\n\ndef solo(page):\n    page.evaluate('__fortnight.title()')\n    page.wait_for_timeout(40)\n    page.locator('.esh-ttl button').first.click()\n    page.wait_for_function('__fortnight.world && __game.sceneName === \\\"play\\\"')\n    page.evaluate('__game.debug.advance(4,{draw:false})')\n\ndef press_pad(page, index, pad=0, milliseconds=65):\n    page.evaluate('([p,b])=>{testPads[p].buttons[b]={pressed:true,touched:true,value:1};}', [pad,index])\n    page.wait_for_timeout(milliseconds)\n    page.evaluate('([p,b])=>{testPads[p].buttons[b]={pressed:false,touched:false,value:0};}', [pad,index])\n    page.wait_for_timeout(50)\n\ndef focus_pad(page, label):\n    for _ in range(45):\n        current = page.evaluate('document.activeElement?.getAttribute(\\\"aria-label\\\") || document.activeElement?.textContent || \\\"\\\"')\n        if label.lower() in current.lower():\n            return\n        press_pad(page,13)\n    raise AssertionError('Pad could not reach ' + label)\n\ndef browser_suite(pw):\n    browser = pw.chromium.launch(headless=True)\n    context = browser.new_context(viewport={'width':1920,'height':1080})\n    page = context.new_page()\n    page.set_default_timeout(4500)\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    boot(page)\n\n    def packaging():\n        html = ARTIFACT.read_text()\n        client = (ROOT/'vendor/hub/lib/hub/session.js').read_text()\n        need('<meta charset=\\\"utf-8\\\">\\\\n<script>'+client+'</script>' in html,'Client is not exact and first after charset')\n        need('<script src=' not in html and 'type=\\\"module\\\"' not in html,'Local/external script dependency')\n        info=json.loads((ROOT.parent/'exit-interview.json').read_text())\n        need(info==page.evaluate('Fortnight.ABOUT'),'Credits and exit interview differ')\n        need(page.evaluate('My3D2dge.version')=='0.89.1','Wrong engine version')\n        need(page.evaluate('AIHub.active') is False,'Standalone entered Hub')\n        need(page.evaluate('__game.W===960 && __game.H===540 && __game.o.expand===false'),'Expanding arena')\n        need(not errors and not page.evaluate('__game.errors'),'Boot errors')\n        box=page.locator('.esh-ttl .esh-btns').bounding_box()\n        need(box['x']<300 and box['y']>560 and box['y']+box['height']<1040,'Title focus/menu is outside intended safe area')\n        page.screenshot(path=str(ROOT/'evidence/title.png'))\n    check('single HTML, exact released Hub client, native engine, metadata and title framing',packaging)\n\n    def keyboard_mouse():\n        solo(page)\n        before=page.evaluate('__fortnight.world.s.players[0].y')\n        page.keyboard.down('w');page.wait_for_timeout(170);page.keyboard.up('w')\n        need(page.evaluate('__fortnight.world.s.players[0].y')<before-2,'W did not thrust')\n        page.mouse.move(1660,440);page.keyboard.down('d');page.mouse.down();page.wait_for_timeout(220)\n        state=page.evaluate('({p:__fortnight.world.s.players[0],shots:__fortnight.world.s.events.filter(e=>e.type===\\\"shot\\\").length})')\n        page.mouse.up();page.keyboard.up('d')\n        need(state['shots']>0 and abs(state['p']['a'])<1.2,'Mouse did not aim and fire while keys moved')\n        page.mouse.click(900,600,button='right');page.wait_for_timeout(70)\n        need(page.evaluate('__fortnight.world.s.players[0].pulse')>0,'Right click did not pulse')\n        page.set_viewport_size({'width':1280,'height':720});page.mouse.move(960,330);page.wait_for_timeout(60)\n        need(page.evaluate('__game.W===960&&__game.H===540'),'Resize changed gameplay bounds')\n        page.set_viewport_size({'width':1920,'height':1080})\n    check('real keyboard thrust, simultaneous mouse aim/fire, pulse and resize mapping',keyboard_mouse)\n\n    def pause_dev():\n        page.keyboard.press('Escape');page.wait_for_function('__fortnight.ui.shell.screen===\\\"pause\\\"')\n        tick=page.evaluate('__fortnight.world.s.tick');page.wait_for_timeout(120)\n        need(tick==page.evaluate('__fortnight.world.s.tick'),'Standalone pause did not freeze')\n        page.get_by_role('button',name='Dev mode',exact=True).click()\n        page.get_by_role('button',name='Tune Viper systems',exact=True).click()\n        slider=page.get_by_role('slider',name='Thrust',exact=True)\n        slider.fill('800');slider.dispatch_event('input')\n        need(page.evaluate('__fortnight.world.s.balance.thrust')==800,'Live slider did not apply')\n        page.get_by_role('button',name='Reset to defaults',exact=True).click()\n        need(page.evaluate('__fortnight.world.s.balance.thrust')==620,'Tuning reset failed')\n        page.screenshot(path=str(ROOT/'evidence/dev.png'))\n        page.get_by_role('button',name='Back',exact=True).click()\n        page.get_by_role('button',name='Single simulation step',exact=True).click()\n        need(page.evaluate('__fortnight.world.s.tick')==tick+1,'Single step advanced wrong number of ticks')\n        page.get_by_role('button',name='Encounter preview',exact=True).click()\n        page.get_by_role('button',name='Jump to boss phase',exact=True).click()\n        need(page.evaluate('__fortnight.world.s.act===2&&__fortnight.world.s.boss.phase===0&&\"'!__game.paused'\"'),'Boss preview failed')\n        need(page.evaluate('__fortnight.world.s.modified'),'Dev run not marked modified')\n    check('pause freeze, live tuning/reset, single step and encounter preview',pause_dev)\n\n    def settings_rebind():\n        solo(page);page.keyboard.press('Escape');page.wait_for_function('__fortnight.ui.shell.screen===\\\"pause\\\"')\n        page.get_by_role('button',name='Settings',exact=True).click()\n        need(page.evaluate('__game.settings.music')==.1,'New music default is not 10%')\n        slider=page.get_by_role('slider',name='Radio voice',exact=True);slider.fill('0.4');slider.dispatch_event('input')\n        page.get_by_role('button',name='Back',exact=True).click()\n        page.get_by_role('button',name='Controls',exact=True).click()\n        bind=page.locator('button[aria-label\"'^=\"Laser, keyboard:\"]'\"');need(bind.count()==1,'Native Laser rebinding row missing')\n        bind.click();page.keyboard.press('r');page.wait_for_timeout(60)\n        need(page.evaluate('__game.input.map.fire.includes(\\\"KeyR\\\")'),'Rebinding did not update action')\n        need(page.evaluate('__game.input.label(\\\"fire\\\",\\\"keyboard\\\")')=='R','Rebinding label stale')\n        page.reload();page.wait_for_function('window.__fortnight')\n        need(page.evaluate('__game.settings.voice')==.4,'Settings did not persist')\n        need(page.evaluate('__game.input.map.fire.includes(\\\"KeyR\\\")'),'Bindings did not persist')\n        page.evaluate('__game.input.resetBindings()')\n    check('default audio, separate voice setting, native rebinding and local persistence',settings_rebind)\n\n    def credits_and_hover():\n        page.get_by_role('button',name='About / Credits',exact=True).hover()\n        need('About' in page.locator(':focus').text_content(),'Hover did not transfer focus')\n        page.keyboard.press('Enter');page.wait_for_function('__fortnight.ui.shell.screen===\\\"about\\\"')\n        for label in ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback']:\n            page.get_by_role('button',name=label,exact=True).click()\n            need(page.locator('.esh-mod h2').inner_text()==label,'Credits section title wrong')\n            need(len(page.locator('.esh-mod').inner_text())>90,'Credits section empty')\n            if label=='Source Information':page.screenshot(path=str(ROOT/'evidence/credits.png'))\n            page.get_by_role('button',name='Credits index',exact=True).click()\n        page.keyboard.press('Escape')\n        need(page.evaluate('__fortnight.ui.shell.screen')=='title','Credits cannot return')\n    check('hover focus, keyboard activation and all factual credits pages',credits_and_hover)\n\n    def results_retry():\n        solo(page)\n        page.evaluate('__game.debug.advance(750,{bot:true,draw:false})')\n        page.wait_for_function('__fortnight.world.s.result && __fortnight.ui.shell.screen===\\\"results\\\"')\n        need(page.evaluate('__fortnight.world.s.result.won'),'Packaged no-cheat run did not win')\n        need(page.evaluate('__fortnight.world.s.seen.length')==8,'Packaged run missed a threat')\n        page.screenshot(path=str(ROOT/'evidence/victory.png'))\n        old=page.evaluate('__fortnight.world.s.epoch')\n        page.get_by_role('button',name='Fly again',exact=True).click()\n        need(page.evaluate('__fortnight.world.s.epoch')>old,'Retry epoch did not change')\n        need(page.evaluate('__fortnight.world.s.score===0&&__fortnight.world.s.enemies.length===0&&__fortnight.world.s.shots.length===0'),'Retry leaked old gameplay')\n        page.evaluate('__fortnight.title()')\n    check('packaged no-cheat full win, rank, clean retry and title return',results_retry)\n\n    def attract():\n        page.evaluate('__fortnight.input.lastActivity=performance.now()-9990;__fortnight.checkIdle()')\n        need(page.evaluate('__fortnight.attract') is False,'Attract started early')\n        page.evaluate('__fortnight.input.lastActivity=performance.now()-10000;__fortnight.checkIdle()')\n        need(page.evaluate('__fortnight.attract'),'Attract did not start at threshold')\n        best=page.evaluate('__fortnight.best')\n        states=page.evaluate('''()=>{const seen=[];for(const dt of [20,20,20,20,25,25,30]){__fortnight.update(dt);seen.push([__fortnight.world.s.act,__fortnight.world.s.boss?.phase??-1,__fortnight.attractAge]);}return seen;}''')\n        need({s[0] for s in states}=={0,1,2},'Attract did not tour all acts')\n        need(any(s[1]==2 for s in states),'Attract did not show exposed core')\n        need(states[-1][2]<5,'Attract did not loop cleanly')\n        page.keyboard.press('Enter');page.wait_for_timeout(100)\n        need(page.evaluate('__fortnight.mode===\\\"title\\\"&&\"'!__fortnight.world&&!__fortnight.attract'\"'),'Attract exit leaked Enter into start')\n        need(page.evaluate('__fortnight.best')==best,'Attract polluted best score')\n    check('10-second attract threshold, all-act tour, loop, exit consumption and score isolation',attract)\n\n    def art_states():\n        solo(page)\n        for name,act,wave,phase in [('gravity',0,2,None),('fortress',1,1,None),('ground',2,1,None),('boss',2,2,1)]:\n            page.evaluate('([a,w,p])=>__game.debug.jump(a,w,p===null?undefined:p)',[act,wave,phase])\n            page.evaluate('__game.debug.advance(7,{bot:false})')\n            page.screenshot(path=str(ROOT/f'evidence/{name}.png'))\n            need(not page.evaluate('__game.errors'),'Native art draw error')\n    check('native custom art draws each act, gravity threat and boss without engine errors',art_states)\n\n    def audio_signals():\n        report=page.evaluate('''async()=>{\n          const channels={};\n          for(const kind of ['music','effects','voice']){\n            const off=new OfflineAudioContext(1,48000,48000),a=new __game.audio.constructor({headless:false,real:0,time:0},new AbortController().signal);\n            a.ctx=off;a._master=off.createGain();a._master.gain.value=.7;a._master.connect(off.destination);\n            a._sfxBus=off.createGain();a._musBus=off.createGain();a._voiceBus=off.createGain();for(const b of [a._sfxBus,a._musBus,a._voiceBus])b.connect(a._master);\n            a._noise=off.createBuffer(1,48000,48000);const noise=a._noise.getChannelData(0);for(let i=0;i<noise.length;i++)noise[i]=Math.sin(i*12.12)*.8;\n            a.musicVolume=.1;a.applyVolume();\n            if(kind==='music'){let i=0;for(const note of Fortnight.SONGS.title.tracks[0].notes.split(/\\\\\\\\s+/).filter(n=>/\"'^[A-G]/.test(n)).slice(0,8)){a._voice({wave:'\"'triangle',freq:note,dur:.11,vol:.2},a._musBus,i++*.11);}}\n            if(kind==='effects')a._voice(Fortnight.FX.laser,a._sfxBus,.1);\n            if(kind==='voice')Fortnight.gibberish(off,a._voiceBus,.1,73);\n            const rendered=await off.startRendering(),data=rendered.getChannelData(0);let sum=0,max=0,bad=0;for(const value of data){sum+=value*value;max=Math.max(max,Math.abs(value));if(\"'!Number.isFinite(value))bad++;}\n            channels[kind]={rms:Math.sqrt(sum/data.length),max,bad};\n          }\n          return channels;\n        }'\"''')\n        for name,v in report.items():\n            need(v['rms']>0.00001 and 0<v['max']<.9 and v['bad']==0,name+' is silent, unbounded or non-finite')\n        page.keyboard.press('Escape');page.wait_for_timeout(120)\n        need(page.evaluate('__game.audio.song===null'),'Pause left music scheduling')\n        need(page.evaluate('__fortnight.sound.nodes.length===0'),'Pause left voice nodes')\n        (ROOT/'evidence/audio-signals.json').write_text(json.dumps(report,indent=2))\n        return report\n    check('offline music/SFX/gibberish signals are finite, bounded and non-silent; pause cleanup',audio_signals)\n    check('no uncaught browser or native engine errors',lambda:need(not errors and not page.evaluate('__game.errors'),str(errors)+str(page.evaluate('__game.errors'))))\n    context.close()\n\n    # Native controller navigation with a standard mapping, injected before loading.\n    ctx=browser.new_context(viewport={'width':1920,'height':1080});ctx.add_init_script(PAD_SCRIPT)\n    padpage=ctx.new_page();padpage.set_default_timeout(4500);boot(padpage)\n    def controller():\n        press_pad(padpage,13);press_pad(padpage,0)\n        need(padpage.evaluate('__fortnight.ui.shell.screen')=='join','Pad did not open join screen')\n        padpage.evaluate('''()=>{for(let i=1;i<4;i++)testPads.push({id:'Standard wing '+i,index:i,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))});}''')\n        for i in [1,2,3]:press_pad(padpage,9,i)\n        need(padpage.evaluate('__game.players.length')==4,'Four pad join failed')\n        focus_pad(padpage,'Launch wing');press_pad(padpage,0)\n        padpage.wait_for_function('__fortnight.world && __fortnight.world.s.players.length===4')\n        padpage.evaluate('__game.debug.advance(4,{draw:false});testPads[0].axes[0]=.8;testPads[1].axes[0]=-.8')\n        before=padpage.evaluate('__fortnight.world.s.players.map(p=>p.x)');padpage.wait_for_timeout(220)\n        after=padpage.evaluate('__fortnight.world.s.players.map(p=>p.x)')\n        need(after[0]>before[0] and after[1]<before[1],'Independent pad pilots did not move')\n        padpage.evaluate('testPads[0].axes=[0,0,0,0];testPads[1].axes=[0,0,0,0]')\n        press_pad(padpage,9);padpage.wait_for_function('__fortnight.ui.shell.screen===\\\"pause\\\"')\n        focus_pad(padpage,'Dev mode');press_pad(padpage,0)\n        focus_pad(padpage,'Tune Viper');press_pad(padpage,0)\n        focus_pad(padpage,'Thrust');press_pad(padpage,15)\n        need(padpage.evaluate('__fortnight.world.s.balance.thrust')>620,'Pad could not adjust live slider')\n        focus_pad(padpage,'Reset to defaults');press_pad(padpage,0)\n        need(padpage.evaluate('__fortnight.world.s.balance.thrust')==620,'Pad reset failed')\n        padpage.screenshot(path=str(ROOT/'evidence/controller-tuning.png'))\n        press_pad(padpage,1);press_pad(padpage,1)\n        focus_pad(padpage,'Settings');press_pad(padpage,0)\n        focus_pad(padpage,'Button symbols');press_pad(padpage,15)\n        need(padpage.evaluate('__game.settings.glyphs')=='xbox','Pad glyph choice failed')\n        need(padpage.evaluate('__game.input.label(\\\"pulse\\\",\\\"gamepad\\\")')=='X','Xbox label did not update')\n        press_pad(padpage,1);focus_pad(padpage,'Resume');press_pad(padpage,0)\n        padpage.evaluate('testPads[0].buttons[8]={pressed:true,value:1};testPads[0].buttons[9]={pressed:true,value:1}')\n        padpage.wait_for_timeout(100)\n        need(padpage.evaluate('__game.paused') is False,'Reserved Create+Options chord paused game')\n        padpage.evaluate('testPads[0].buttons[8]={pressed:false,value:0};testPads[0].buttons[9]={pressed:false,value:0};testPads[0].axes=[.1,.1,.1,.1]')\n        padpage.wait_for_timeout(70);need(padpage.evaluate('__game.input.move().every(v=>v===0)'),'Deadzone did not suppress stick drift')\n        padpage.evaluate('testPads=[]');padpage.wait_for_timeout(100)\n        need(padpage.evaluate('__game.paused'),'Controller unplug did not pause standalone')\n    check('four-pad join, independent pilots, pad-only pause/dev/sliders/reset/glyphs, reserved chord, drift and unplug',controller)\n    ctx.close()\n\n    ctx=browser.new_context(**pw.devices['iPhone 13']);phone=ctx.new_page();phone.set_default_timeout(4500);boot(phone)\n    def touch():\n        phone.locator('.esh-ttl button').first.tap();phone.wait_for_function('__fortnight.world')\n        phone.evaluate('__game.debug.advance(4,{draw:false})')\n        need(phone.evaluate('__game.W===960&&__game.H===540'),'Portrait arena changed')\n        before=phone.evaluate('__fortnight.world.s.players[0].x')\n        cdp=ctx.new_cdp_session(phone)\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'id':1,'x':80,'y':470},{'id':2,'x':310,'y':410}]})\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'id':1,'x':120,'y':470},{'id':2,'x':310,'y':390}]})\n        phone.wait_for_timeout(180)\n        need(phone.evaluate('__fortnight.input.touch.size')==2,'Two contacts were not retained')\n        need(phone.evaluate('__fortnight.world.s.players[0].x')>before,'Invisible left thumb did not thrust')\n        need(phone.evaluate('__fortnight.world.s.events.some(e=>e.type===\\\"shot\\\")'),'Right drag / assisted fire did not shoot')\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchCancel','touchPoints':[]});phone.wait_for_timeout(70)\n        need(phone.evaluate('__fortnight.input.touch.size')==0,'Touch cancel leaked contact')\n        phone.evaluate('''()=>{const w=__fortnight.world,p=w.s.players[0];p.pulse=0;w.shot(p.x+40,p.y,0,0,true);w.spawn('anchor',p.x+60,p.y,{tele:0,charge:0});__fortnight.ui.tick();}''')\n        need(phone.locator('#touch-pulse').is_visible(),'Useful ready pulse was hidden')\n        phone.locator('#touch-pulse').tap();phone.wait_for_timeout(70)\n        need(phone.evaluate('__fortnight.world.s.players[0].pulse')>0,'Touch pulse did not activate')\n        phone.screenshot(path=str(ROOT/'evidence/touch-portrait.png'))\n        phone.locator('#menu-toggle').tap();phone.wait_for_function('__fortnight.ui.shell.screen===\\\"pause\\\"')\n        need(phone.evaluate('__game.paused'),'Touch menu did not pause')\n        phone.set_viewport_size({'width':844,'height':390});phone.wait_for_timeout(70)\n        need(phone.evaluate('__game.W===960&&__game.H===540'),'Landscape arena changed')\n    check('phone portrait/landscape fixed arena, two-finger invisible controls, cancellation and contextual pulse/menu',touch)\n    ctx.close()\n    # Storage denial must leave a playable standalone game.\n    ctx=browser.new_context();ctx.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new Error('denied')}})\\\")\n    fallback=ctx.new_page()\n    def storage():\n        boot(fallback);solo(fallback);need(fallback.evaluate('__fortnight.world.s.phase')=='play','Blocked storage prevented play')\n    check('denied local storage has a playable safe fallback',storage)\n    ctx.close();browser.close()\n    # WebKit desktop/mobile emulation: explicitly not a claim of physical iOS testing.\n    webkit=pw.webkit.launch(headless=True);wk=webkit.new_context(**pw.devices['iPhone 13']);wp=wk.new_page()\n    def webkit_smoke():\n        boot(wp);wp.locator('.esh-ttl button').first.tap();wp.wait_for_function('__fortnight.world');wp.evaluate('__game.debug.advance(8,{bot:true})')\n        need(not wp.evaluate('__game.errors'),'WebKit native draw errors')\n        need(wp.evaluate('__fortnight.world.s.tick')>900,'WebKit world did not tick')\n    check('WebKit with iPhone profile boots and runs native combat',webkit_smoke)\n    wk.close();webkit.close()\n\n\ndef hub_suite(pw):\n    handler=functools.partial(QuietHandler,directory=str(ROOT))\n    server=http.server.ThreadingHTTPServer(('127.0.0.1',0),handler)\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\n    base='http://127.0.0.1:'+str(server.server_address[1])\n    need('Space Fortnight' in urllib.request.urlopen(base+'/game.html').read().decode(),'Wrong isolated server')\n    browser=pw.chromium.launch(headless=True)\n    try:\n        for count,scenario in [(1,'standard'),(2,'standard'),(3,'standard'),(4,'standard'),(2,'server'),(3,'host-leave')]:\n            ctx=browser.new_context(viewport={'width':1400,'height':960})\n            page=ctx.new_page();page.set_default_timeout(6000)\n            name=f'official Hub harness {count} players / {scenario} / 150 ms ±50 ms / 5% loss'\n            def run_harness():\n                url=base+'/tests/hub/harness.html?'+urllib.parse.urlencode({'game':'/game.html','players':count,'scenario':scenario,'latency':150,'jitter':50,'loss':5,'auto':1,'play':10000})\n                page.goto(url)\n                page.wait_for_function('document.querySelectorAll(\\\"iframe\\\").length>0')\n                page.wait_for_function('[...document.querySelectorAll(\\\"iframe\\\")].every(f=>f.contentWindow.__fortnight?.online)')\n                frames=[f for f in page.frames if f\"'!=page.main_frame]\n                for frame in frames:\n                    need(frame.evaluate('\"'__fortnight.mode')=='hub','Hub showed standalone menu')\n                    need(frame.evaluate('__fortnight.world.s.tick')==0,'Countdown changed authoritative state')\n                if count>=2 and scenario=='standard':\n                    remote=frames[1]\n                    remote.evaluate('__game.input.hold(\\\"right\\\");__game.input.hold(\\\"fire\\\")')\n                page.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=60000)\n                report=page.evaluate('window.__hubCheck')\n                (ROOT/f'evidence/hub-{count}-{scenario}.json').write_text(json.dumps(report,indent=2))\n                need(report['pass'],'; '.join(c['name']+': '+c.get('detail','') for c in report['checks'] if not c['pass']))\n                stats=[]\n                for frame in frames:\n                    value=frame.evaluate('({network:__fortnight.online.stats(),errors:__game.errors,phase:__fortnight.world.s.phase,score:__fortnight.world.s.score,players:__fortnight.world.s.players.map(p=>({id:p.id,x:p.x,seq:p.seq})),audio:__game.audio.song,voices:__fortnight.sound.nodes.length})')\n                    need(not value['errors'],'Hub engine error: '+str(value['errors']))\n                    need(value['network']['maxBytes']<=16384 and value['network']['maxRoutineBytes']<=1200,'Packet limit exceeded')\n                    need(value['audio'] is None and value['voices']==0,'Hub end left audio running')\n                    stats.append(value)\n                if scenario=='standard' and count>=2:\n                    host=stats[0]\n                    need(any(p['id']==1 and p['seq']>0 for p in host['players']),'Host never accepted remote intent')\n                    need(abs(host['players'][1]['x']-432)>30,'Remote controls did not move host pilot')\n                before=[v['network']['sent'] for v in stats];page.wait_for_timeout(250)\n                after=[f.evaluate('__fortnight.online.sent') for f in frames]\n                need(before==after,'Input or snapshots continued after Hub end')\n                return stats\n            check(name,run_harness)\n            ctx.close()\n    finally:\n        browser.close();server.shutdown();server.server_close();thread.join(timeout=2)\n\ntry:\n    with sync_playwright() as pw:\n        if len(sys.argv)>1 and sys.argv[1]=='hub':hub_suite(pw)\n        else:browser_suite(pw)\nexcept Exception:\n    RESULTS.append({'name':'suite setup','pass':False,'error':traceback.format_exc()})\nprint(json.dumps(RESULTS))\nsys.exit(1 if any(not t['pass'] for t in RESULTS) else 0)\nEOF\nnpm run build\nnode tools/verify.mjs browser\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"cat > tests/browser_checks.py <<'EOF'\n\\\"\\\"\\\"Real packaged-artifact checks; stdout is a JSON test report consumed by verify.mjs.\\\"\\\"\\\"\nfrom pathlib import Path\nimport functools\nimport http.server\nimport json\nimport sys\nimport threading\nimport traceback\nimport urllib.parse\nimport urllib.request\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent.parent\nARTIFACT = ROOT.parent / (ROOT.name + '.html')\nRESULTS = []\nPAD_SCRIPT = \\\"\\\"\\\"window.testPads=[{id:'DualSense standard test pad',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0})),timestamp:0}];navigator.getGamepads=()=>window.testPads;\\\"\\\"\\\"\n\ndef check(name, fn):\n    try:\n        detail = fn()\n        RESULTS.append({'name': name, 'pass': True, 'detail': detail or ''})\n    except Exception:\n        RESULTS.append({'name': name, 'pass': False, 'error': traceback.format_exc()})\n\ndef need(value, message):\n    if not value:\n        raise AssertionError(message)\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_):\n        pass\n\ndef boot(page):\n    page.goto(ARTIFACT.as_uri())\n    page.wait_for_function('window.__fortnight && window.__game && __fortnight.ui.shell.screen === \\\"title\\\"')\n\ndef solo(page):\n    page.evaluate('__fortnight.title()')\n    page.wait_for_timeout(40)\n    page.locator('.esh-ttl button').first.click()\n    page.wait_for_function('__fortnight.world && __game.sceneName === \\\"play\\\"')\n    page.evaluate('__game.debug.advance(4,{draw:false})')\n\ndef press_pad(page, index, pad=0, milliseconds=65):\n    page.evaluate('([p,b])=>{testPads[p].buttons[b]={pressed:true,touched:true,value:1};}', [pad,index])\n    page.wait_for_timeout(milliseconds)\n    page.evaluate('([p,b])=>{testPads[p].buttons[b]={pressed:false,touched:false,value:0};}', [pad,index])\n    page.wait_for_timeout(50)\n\ndef focus_pad(page, label):\n    for _ in range(45):\n        current = page.evaluate('document.activeElement?.getAttribute(\\\"aria-label\\\") || document.activeElement?.textContent || \\\"\\\"')\n        if label.lower() in current.lower():\n            return\n        press_pad(page,13)\n    raise AssertionError('Pad could not reach ' + label)\n\ndef browser_suite(pw):\n    browser = pw.chromium.launch(headless=True)\n    context = browser.new_context(viewport={'width':1920,'height':1080})\n    page = context.new_page()\n    page.set_default_timeout(4500)\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    boot(page)\n\n    def packaging():\n        html = ARTIFACT.read_text()\n        client = (ROOT/'vendor/hub/lib/hub/session.js').read_text()\n        need('<meta charset=\\\"utf-8\\\">\\\\n<script>'+client+'</script>' in html,'Client is not exact and first after charset')\n        need('<script src=' not in html and 'type=\\\"module\\\"' not in html,'Local/external script dependency')\n        info=json.loads((ROOT.parent/'exit-interview.json').read_text())\n        need(info==page.evaluate('Fortnight.ABOUT'),'Credits and exit interview differ')\n        need(page.evaluate('My3D2dge.version')=='0.89.1','Wrong engine version')\n        need(page.evaluate('AIHub.active') is False,'Standalone entered Hub')\n        need(page.evaluate('__game.W===960 && __game.H===540 && __game.o.expand===false'),'Expanding arena')\n        need(not errors and not page.evaluate('__game.errors'),'Boot errors')\n        box=page.locator('.esh-ttl .esh-btns').bounding_box()\n        need(box['x']<300 and box['y']>560 and box['y']+box['height']<1040,'Title focus/menu is outside intended safe area')\n        page.screenshot(path=str(ROOT/'evidence/title.png'))\n    check('single HTML, exact released Hub client, native engine, metadata and title framing',packaging)\n\n    def keyboard_mouse():\n        solo(page)\n        before=page.evaluate('__fortnight.world.s.players[0].y')\n        page.keyboard.down('w');page.wait_for_timeout(170);page.keyboard.up('w')\n        need(page.evaluate('__fortnight.world.s.players[0].y')<before-2,'W did not thrust')\n        page.mouse.move(1660,440);page.keyboard.down('d');page.mouse.down();page.wait_for_timeout(220)\n        state=page.evaluate('({p:__fortnight.world.s.players[0],shots:__fortnight.world.s.events.filter(e=>e.type===\\\"shot\\\").length})')\n        page.mouse.up();page.keyboard.up('d')\n        need(state['shots']>0 and abs(state['p']['a'])<1.2,'Mouse did not aim and fire while keys moved')\n        page.mouse.click(900,600,button='right');page.wait_for_timeout(70)\n        need(page.evaluate('__fortnight.world.s.players[0].pulse')>0,'Right click did not pulse')\n        page.set_viewport_size({'width':1280,'height':720});page.mouse.move(960,330);page.wait_for_timeout(60)\n        need(page.evaluate('__game.W===960&&__game.H===540'),'Resize changed gameplay bounds')\n        page.set_viewport_size({'width':1920,'height':1080})\n    check('real keyboard thrust, simultaneous mouse aim/fire, pulse and resize mapping',keyboard_mouse)\n\n    def pause_dev():\n        page.keyboard.press('Escape');page.wait_for_function('__fortnight.ui.shell.screen===\\\"pause\\\"')\n        tick=page.evaluate('__fortnight.world.s.tick');page.wait_for_timeout(120)\n        need(tick==page.evaluate('__fortnight.world.s.tick'),'Standalone pause did not freeze')\n        page.get_by_role('button',name='Dev mode',exact=True).click()\n        page.get_by_role('button',name='Tune Viper systems',exact=True).click()\n        slider=page.get_by_role('slider',name='Thrust',exact=True)\n        slider.fill('800');slider.dispatch_event('input')\n        need(page.evaluate('__fortnight.world.s.balance.thrust')==800,'Live slider did not apply')\n        page.get_by_role('button',name='Reset to defaults',exact=True).click()\n        need(page.evaluate('__fortnight.world.s.balance.thrust')==620,'Tuning reset failed')\n        page.screenshot(path=str(ROOT/'evidence/dev.png'))\n        page.get_by_role('button',name='Back',exact=True).click()\n        page.get_by_role('button',name='Single simulation step',exact=True).click()\n        need(page.evaluate('__fortnight.world.s.tick')==tick+1,'Single step advanced wrong number of ticks')\n        page.get_by_role('button',name='Encounter preview',exact=True).click()\n        page.get_by_role('button',name='Jump to boss phase',exact=True).click()\n        need(page.evaluate('__fortnight.world.s.act===2&&__fortnight.world.s.boss.phase===0&&\"'!__game.paused'\"'),'Boss preview failed')\n        need(page.evaluate('__fortnight.world.s.modified'),'Dev run not marked modified')\n    check('pause freeze, live tuning/reset, single step and encounter preview',pause_dev)\n\n    def settings_rebind():\n        solo(page);page.keyboard.press('Escape');page.wait_for_function('__fortnight.ui.shell.screen===\\\"pause\\\"')\n        page.get_by_role('button',name='Settings',exact=True).click()\n        need(page.evaluate('__game.settings.music')==.1,'New music default is not 10%')\n        slider=page.get_by_role('slider',name='Radio voice',exact=True);slider.fill('0.4');slider.dispatch_event('input')\n        page.get_by_role('button',name='Back',exact=True).click()\n        page.get_by_role('button',name='Controls',exact=True).click()\n        bind=page.locator('button[aria-label\"'^=\"Laser, keyboard:\"]'\"');need(bind.count()==1,'Native Laser rebinding row missing')\n        bind.click();page.keyboard.press('r');page.wait_for_timeout(60)\n        need(page.evaluate('__game.input.map.fire.includes(\\\"KeyR\\\")'),'Rebinding did not update action')\n        need(page.evaluate('__game.input.label(\\\"fire\\\",\\\"keyboard\\\")')=='R','Rebinding label stale')\n        page.reload();page.wait_for_function('window.__fortnight')\n        need(page.evaluate('__game.settings.voice')==.4,'Settings did not persist')\n        need(page.evaluate('__game.input.map.fire.includes(\\\"KeyR\\\")'),'Bindings did not persist')\n        page.evaluate('__game.input.resetBindings()')\n    check('default audio, separate voice setting, native rebinding and local persistence',settings_rebind)\n\n    def credits_and_hover():\n        page.get_by_role('button',name='About / Credits',exact=True).hover()\n        need('About' in page.locator(':focus').text_content(),'Hover did not transfer focus')\n        page.keyboard.press('Enter');page.wait_for_function('__fortnight.ui.shell.screen===\\\"about\\\"')\n        for label in ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback']:\n            page.get_by_role('button',name=label,exact=True).click()\n            need(page.locator('.esh-mod h2').inner_text()==label,'Credits section title wrong')\n            need(len(page.locator('.esh-mod').inner_text())>90,'Credits section empty')\n            if label=='Source Information':page.screenshot(path=str(ROOT/'evidence/credits.png'))\n            page.get_by_role('button',name='Credits index',exact=True).click()\n        page.keyboard.press('Escape')\n        need(page.evaluate('__fortnight.ui.shell.screen')=='title','Credits cannot return')\n    check('hover focus, keyboard activation and all factual credits pages',credits_and_hover)\n\n    def results_retry():\n        solo(page)\n        page.evaluate('__game.debug.advance(750,{bot:true,draw:false})')\n        page.wait_for_function('__fortnight.world.s.result && __fortnight.ui.shell.screen===\\\"results\\\"')\n        need(page.evaluate('__fortnight.world.s.result.won'),'Packaged no-cheat run did not win')\n        need(page.evaluate('__fortnight.world.s.seen.length')==8,'Packaged run missed a threat')\n        page.screenshot(path=str(ROOT/'evidence/victory.png'))\n        old=page.evaluate('__fortnight.world.s.epoch')\n        page.get_by_role('button',name='Fly again',exact=True).click()\n        need(page.evaluate('__fortnight.world.s.epoch')>old,'Retry epoch did not change')\n        need(page.evaluate('__fortnight.world.s.score===0&&__fortnight.world.s.enemies.length===0&&__fortnight.world.s.shots.length===0'),'Retry leaked old gameplay')\n        page.evaluate('__fortnight.title()')\n    check('packaged no-cheat full win, rank, clean retry and title return',results_retry)\n\n    def attract():\n        page.evaluate('__fortnight.input.lastActivity=performance.now()-9990;__fortnight.checkIdle()')\n        need(page.evaluate('__fortnight.attract') is False,'Attract started early')\n        page.evaluate('__fortnight.input.lastActivity=performance.now()-10000;__fortnight.checkIdle()')\n        need(page.evaluate('__fortnight.attract'),'Attract did not start at threshold')\n        best=page.evaluate('__fortnight.best')\n        states=page.evaluate('''()=>{const seen=[];for(const dt of [20,20,20,20,25,25,30]){__fortnight.update(dt);seen.push([__fortnight.world.s.act,__fortnight.world.s.boss?.phase??-1,__fortnight.attractAge]);}return seen;}''')\n        need({s[0] for s in states}=={0,1,2},'Attract did not tour all acts')\n        need(any(s[1]==2 for s in states),'Attract did not show exposed core')\n        need(states[-1][2]<5,'Attract did not loop cleanly')\n        page.keyboard.press('Enter');page.wait_for_timeout(100)\n        need(page.evaluate('__fortnight.mode===\\\"title\\\"&&\"'!__fortnight.world&&!__fortnight.attract'\"'),'Attract exit leaked Enter into start')\n        need(page.evaluate('__fortnight.best')==best,'Attract polluted best score')\n    check('10-second attract threshold, all-act tour, loop, exit consumption and score isolation',attract)\n\n    def art_states():\n        solo(page)\n        for name,act,wave,phase in [('gravity',0,2,None),('fortress',1,1,None),('ground',2,1,None),('boss',2,2,1)]:\n            page.evaluate('([a,w,p])=>__game.debug.jump(a,w,p===null?undefined:p)',[act,wave,phase])\n            page.evaluate('__game.debug.advance(7,{bot:false})')\n            page.screenshot(path=str(ROOT/f'evidence/{name}.png'))\n            need(not page.evaluate('__game.errors'),'Native art draw error')\n    check('native custom art draws each act, gravity threat and boss without engine errors',art_states)\n\n    def audio_signals():\n        report=page.evaluate('''async()=>{\n          const channels={};\n          for(const kind of ['music','effects','voice']){\n            const off=new OfflineAudioContext(1,48000,48000),a=new __game.audio.constructor({headless:false,real:0,time:0},new AbortController().signal);\n            a.ctx=off;a._master=off.createGain();a._master.gain.value=.7;a._master.connect(off.destination);\n            a._sfxBus=off.createGain();a._musBus=off.createGain();a._voiceBus=off.createGain();for(const b of [a._sfxBus,a._musBus,a._voiceBus])b.connect(a._master);\n            a._noise=off.createBuffer(1,48000,48000);const noise=a._noise.getChannelData(0);for(let i=0;i<noise.length;i++)noise[i]=Math.sin(i*12.12)*.8;\n            a.musicVolume=.1;a.applyVolume();\n            if(kind==='music'){let i=0;for(const note of Fortnight.SONGS.title.tracks[0].notes.split(/\\\\\\\\s+/).filter(n=>/\"'^[A-G]/.test(n)).slice(0,8)){a._voice({wave:'\"'triangle',freq:note,dur:.11,vol:.2},a._musBus,i++*.11);}}\n            if(kind==='effects')a._voice(Fortnight.FX.laser,a._sfxBus,.1);\n            if(kind==='voice')Fortnight.gibberish(off,a._voiceBus,.1,73);\n            const rendered=await off.startRendering(),data=rendered.getChannelData(0);let sum=0,max=0,bad=0;for(const value of data){sum+=value*value;max=Math.max(max,Math.abs(value));if(\"'!Number.isFinite(value))bad++;}\n            channels[kind]={rms:Math.sqrt(sum/data.length),max,bad};\n          }\n          return channels;\n        }'\"''')\n        for name,v in report.items():\n            need(v['rms']>0.00001 and 0<v['max']<.9 and v['bad']==0,name+' is silent, unbounded or non-finite')\n        page.keyboard.press('Escape');page.wait_for_timeout(120)\n        need(page.evaluate('__game.audio.song===null'),'Pause left music scheduling')\n        need(page.evaluate('__fortnight.sound.nodes.length===0'),'Pause left voice nodes')\n        (ROOT/'evidence/audio-signals.json').write_text(json.dumps(report,indent=2))\n        return report\n    check('offline music/SFX/gibberish signals are finite, bounded and non-silent; pause cleanup',audio_signals)\n    check('no uncaught browser or native engine errors',lambda:need(not errors and not page.evaluate('__game.errors'),str(errors)+str(page.evaluate('__game.errors'))))\n    context.close()\n\n    # Native controller navigation with a standard mapping, injected before loading.\n    ctx=browser.new_context(viewport={'width':1920,'height':1080});ctx.add_init_script(PAD_SCRIPT)\n    padpage=ctx.new_page();padpage.set_default_timeout(4500);boot(padpage)\n    def controller():\n        press_pad(padpage,13);press_pad(padpage,0)\n        need(padpage.evaluate('__fortnight.ui.shell.screen')=='join','Pad did not open join screen')\n        padpage.evaluate('''()=>{for(let i=1;i<4;i++)testPads.push({id:'Standard wing '+i,index:i,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))});}''')\n        for i in [1,2,3]:press_pad(padpage,9,i)\n        need(padpage.evaluate('__game.players.length')==4,'Four pad join failed')\n        focus_pad(padpage,'Launch wing');press_pad(padpage,0)\n        padpage.wait_for_function('__fortnight.world && __fortnight.world.s.players.length===4')\n        padpage.evaluate('__game.debug.advance(4,{draw:false});testPads[0].axes[0]=.8;testPads[1].axes[0]=-.8')\n        before=padpage.evaluate('__fortnight.world.s.players.map(p=>p.x)');padpage.wait_for_timeout(220)\n        after=padpage.evaluate('__fortnight.world.s.players.map(p=>p.x)')\n        need(after[0]>before[0] and after[1]<before[1],'Independent pad pilots did not move')\n        padpage.evaluate('testPads[0].axes=[0,0,0,0];testPads[1].axes=[0,0,0,0]')\n        press_pad(padpage,9);padpage.wait_for_function('__fortnight.ui.shell.screen===\\\"pause\\\"')\n        focus_pad(padpage,'Dev mode');press_pad(padpage,0)\n        focus_pad(padpage,'Tune Viper');press_pad(padpage,0)\n        focus_pad(padpage,'Thrust');press_pad(padpage,15)\n        need(padpage.evaluate('__fortnight.world.s.balance.thrust')>620,'Pad could not adjust live slider')\n        focus_pad(padpage,'Reset to defaults');press_pad(padpage,0)\n        need(padpage.evaluate('__fortnight.world.s.balance.thrust')==620,'Pad reset failed')\n        padpage.screenshot(path=str(ROOT/'evidence/controller-tuning.png'))\n        press_pad(padpage,1);press_pad(padpage,1)\n        focus_pad(padpage,'Settings');press_pad(padpage,0)\n        focus_pad(padpage,'Button symbols');press_pad(padpage,15)\n        need(padpage.evaluate('__game.settings.glyphs')=='xbox','Pad glyph choice failed')\n        need(padpage.evaluate('__game.input.label(\\\"pulse\\\",\\\"gamepad\\\")')=='X','Xbox label did not update')\n        press_pad(padpage,1);focus_pad(padpage,'Resume');press_pad(padpage,0)\n        padpage.evaluate('testPads[0].buttons[8]={pressed:true,value:1};testPads[0].buttons[9]={pressed:true,value:1}')\n        padpage.wait_for_timeout(100)\n        need(padpage.evaluate('__game.paused') is False,'Reserved Create+Options chord paused game')\n        padpage.evaluate('testPads[0].buttons[8]={pressed:false,value:0};testPads[0].buttons[9]={pressed:false,value:0};testPads[0].axes=[.1,.1,.1,.1]')\n        padpage.wait_for_timeout(70);need(padpage.evaluate('__game.input.move().every(v=>v===0)'),'Deadzone did not suppress stick drift')\n        padpage.evaluate('testPads=[]');padpage.wait_for_timeout(100)\n        need(padpage.evaluate('__game.paused'),'Controller unplug did not pause standalone')\n    check('four-pad join, independent pilots, pad-only pause/dev/sliders/reset/glyphs, reserved chord, drift and unplug',controller)\n    ctx.close()\n\n    ctx=browser.new_context(**pw.devices['iPhone 13']);phone=ctx.new_page();phone.set_default_timeout(4500);boot(phone)\n    def touch():\n        phone.locator('.esh-ttl button').first.tap();phone.wait_for_function('__fortnight.world')\n        phone.evaluate('__game.debug.advance(4,{draw:false})')\n        need(phone.evaluate('__game.W===960&&__game.H===540'),'Portrait arena changed')\n        before=phone.evaluate('__fortnight.world.s.players[0].x')\n        cdp=ctx.new_cdp_session(phone)\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'id':1,'x':80,'y':470},{'id':2,'x':310,'y':410}]})\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'id':1,'x':120,'y':470},{'id':2,'x':310,'y':390}]})\n        phone.wait_for_timeout(180)\n        need(phone.evaluate('__fortnight.input.touch.size')==2,'Two contacts were not retained')\n        need(phone.evaluate('__fortnight.world.s.players[0].x')>before,'Invisible left thumb did not thrust')\n        need(phone.evaluate('__fortnight.world.s.events.some(e=>e.type===\\\"shot\\\")'),'Right drag / assisted fire did not shoot')\n        cdp.send('Input.dispatchTouchEvent',{'type':'touchCancel','touchPoints':[]});phone.wait_for_timeout(70)\n        need(phone.evaluate('__fortnight.input.touch.size')==0,'Touch cancel leaked contact')\n        phone.evaluate('''()=>{const w=__fortnight.world,p=w.s.players[0];p.pulse=0;w.shot(p.x+40,p.y,0,0,true);w.spawn('anchor',p.x+60,p.y,{tele:0,charge:0});__fortnight.ui.tick();}''')\n        need(phone.locator('#touch-pulse').is_visible(),'Useful ready pulse was hidden')\n        phone.locator('#touch-pulse').tap();phone.wait_for_timeout(70)\n        need(phone.evaluate('__fortnight.world.s.players[0].pulse')>0,'Touch pulse did not activate')\n        phone.screenshot(path=str(ROOT/'evidence/touch-portrait.png'))\n        phone.locator('#menu-toggle').tap();phone.wait_for_function('__fortnight.ui.shell.screen===\\\"pause\\\"')\n        need(phone.evaluate('__game.paused'),'Touch menu did not pause')\n        phone.set_viewport_size({'width':844,'height':390});phone.wait_for_timeout(70)\n        need(phone.evaluate('__game.W===960&&__game.H===540'),'Landscape arena changed')\n    check('phone portrait/landscape fixed arena, two-finger invisible controls, cancellation and contextual pulse/menu',touch)\n    ctx.close()\n    # Storage denial must leave a playable standalone game.\n    ctx=browser.new_context();ctx.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new Error('denied')}})\\\")\n    fallback=ctx.new_page()\n    def storage():\n        boot(fallback);solo(fallback);need(fallback.evaluate('__fortnight.world.s.phase')=='play','Blocked storage prevented play')\n    check('denied local storage has a playable safe fallback',storage)\n    ctx.close();browser.close()\n    # WebKit desktop/mobile emulation: explicitly not a claim of physical iOS testing.\n    webkit=pw.webkit.launch(headless=True);wk=webkit.new_context(**pw.devices['iPhone 13']);wp=wk.new_page()\n    def webkit_smoke():\n        boot(wp);wp.locator('.esh-ttl button').first.tap();wp.wait_for_function('__fortnight.world');wp.evaluate('__game.debug.advance(8,{bot:true})')\n        need(not wp.evaluate('__game.errors'),'WebKit native draw errors')\n        need(wp.evaluate('__fortnight.world.s.tick')>900,'WebKit world did not tick')\n    check('WebKit with iPhone profile boots and runs native combat',webkit_smoke)\n    wk.close();webkit.close()\n\n\ndef hub_suite(pw):\n    handler=functools.partial(QuietHandler,directory=str(ROOT))\n    server=http.server.ThreadingHTTPServer(('127.0.0.1',0),handler)\n    thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()\n    base='http://127.0.0.1:'+str(server.server_address[1])\n    need('Space Fortnight' in urllib.request.urlopen(base+'/game.html').read().decode(),'Wrong isolated server')\n    browser=pw.chromium.launch(headless=True)\n    try:\n        for count,scenario in [(1,'standard'),(2,'standard'),(3,'standard'),(4,'standard'),(2,'server'),(3,'host-leave')]:\n            ctx=browser.new_context(viewport={'width':1400,'height':960})\n            page=ctx.new_page();page.set_default_timeout(6000)\n            name=f'official Hub harness {count} players / {scenario} / 150 ms ±50 ms / 5% loss'\n            def run_harness():\n                url=base+'/tests/hub/harness.html?'+urllib.parse.urlencode({'game':'/game.html','players':count,'scenario':scenario,'latency':150,'jitter':50,'loss':5,'auto':1,'play':10000})\n                page.goto(url)\n                page.wait_for_function('document.querySelectorAll(\\\"iframe\\\").length>0')\n                page.wait_for_function('[...document.querySelectorAll(\\\"iframe\\\")].every(f=>f.contentWindow.__fortnight?.online)')\n                frames=[f for f in page.frames if f\"'!=page.main_frame]\n                for frame in frames:\n                    need(frame.evaluate('\"'__fortnight.mode')=='hub','Hub showed standalone menu')\n                    need(frame.evaluate('__fortnight.world.s.tick')==0,'Countdown changed authoritative state')\n                if count>=2 and scenario=='standard':\n                    remote=frames[1]\n                    remote.evaluate('__game.input.hold(\\\"right\\\");__game.input.hold(\\\"fire\\\")')\n                page.wait_for_function('document.body.dataset.complete===\\\"true\\\"',timeout=60000)\n                report=page.evaluate('window.__hubCheck')\n                (ROOT/f'evidence/hub-{count}-{scenario}.json').write_text(json.dumps(report,indent=2))\n                need(report['pass'],'; '.join(c['name']+': '+c.get('detail','') for c in report['checks'] if not c['pass']))\n                stats=[]\n                for frame in frames:\n                    value=frame.evaluate('({network:__fortnight.online.stats(),errors:__game.errors,phase:__fortnight.world.s.phase,score:__fortnight.world.s.score,players:__fortnight.world.s.players.map(p=>({id:p.id,x:p.x,seq:p.seq})),audio:__game.audio.song,voices:__fortnight.sound.nodes.length})')\n                    need(not value['errors'],'Hub engine error: '+str(value['errors']))\n                    need(value['network']['maxBytes']<=16384 and value['network']['maxRoutineBytes']<=1200,'Packet limit exceeded')\n                    need(value['audio'] is None and value['voices']==0,'Hub end left audio running')\n                    stats.append(value)\n                if scenario=='standard' and count>=2:\n                    host=stats[0]\n                    need(any(p['id']==1 and p['seq']>0 for p in host['players']),'Host never accepted remote intent')\n                    need(abs(host['players'][1]['x']-432)>30,'Remote controls did not move host pilot')\n                before=[v['network']['sent'] for v in stats];page.wait_for_timeout(250)\n                after=[f.evaluate('__fortnight.online.sent') for f in frames]\n                need(before==after,'Input or snapshots continued after Hub end')\n                return stats\n            check(name,run_harness)\n            ctx.close()\n    finally:\n        browser.close();server.shutdown();server.server_close();thread.join(timeout=2)\n\ntry:\n    with sync_playwright() as pw:\n        if len(sys.argv)>1 and sys.argv[1]=='hub':hub_suite(pw)\n        else:browser_suite(pw)\nexcept Exception:\n    RESULTS.append({'name':'suite setup','pass':False,'error':traceback.format_exc()})\nprint(json.dumps(RESULTS))\nsys.exit(1 if any(not t['pass'] for t in RESULTS) else 0)\nEOF\nnpm run build\nnode tools/verify.mjs browser\"","aggregated_output":"npm notice run space-fortnight@1.0.0 build\nnpm notice run node tools/build.mjs --quiet\nFAIL browser: single HTML, exact released Hub client, native engine, metadata and title framing\nTraceback (most recent call last):\n  File \"/home/micha/dev/cc-matrix/run