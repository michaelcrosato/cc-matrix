gine/src/assets/sets/shooter.js\nvendor/engine/src/assets/sets/emberdeep.js\nvendor/engine/src/assets/sets/kenney-food.js\nvendor/engine/src/assets/sets/animlab.js\nvendor/engine/src/assets/sets/kenney-survival.js\nvendor/engine/kits/rpg.html\nvendor/engine/kits/adventure.js\nvendor/engine/kits/rhythm.html\nvendor/engine/kits/README.md\nvendor/engine/kits/rts.js\nvendor/engine/kits/sports.html\nvendor/engine/kits/brawler.html\nvendor/engine/kits/road.html\nvendor/engine/kits/arcade.js\nvendor/engine/kits/test.mjs\nvendor/engine/kits/sim.html\nvendor/engine/kits/sports.js\nvendor/engine/kits/rhythm.js\nvendor/engine/kits/arcade.html\nvendor/engine/kits/tactics.html\nvendor/engine/kits/pinball.html\nvendor/engine/kits/roguelike.js\nvendor/engine/kits/animlab.html\nvendor/engine/kits/rts.html\nvendor/engine/kits/puzzle.html\nvendor/engine/kits/tactics.js\nvendor/engine/kits/platformer.html\nvendor/engine/kits/kart.js\nvendor/hub/lib/hub/README.md\nvendor/hub/lib/hub/session.js\nvendor/hub/lib/hub/harness.html\nvendor/hub/lib/hub/round.js\nvendor/hub/lib/hub/retrofit.md\nvendor/hub/lib/hub/bridge.js\nvendor/hub/lib/hub/examples/ghost.html\nvendor/hub/lib/hub/examples/parallel.html\nvendor/hub/lib/hub/examples/arena.html\n#!/usr/bin/env node\n/**\n * hub-check.mjs — does a game keep the AI Hub Session Protocol?\n *\n * Runs lib/hub/harness.html?auto=1 against each game, at the player counts its\n * hub:session-players allows: hello, ready under the hub's card with no key\n * press, the start, traffic, a player leaving, time-up and a valid result. Then\n * once more with the host leaving. Then the game on its own, outside a session:\n * it opens, Enter and Space are pressed, and it must draw its screen with no\n * errors, the session client inactive and Math.random left alone. Before any\n * game script runs, every frame in session mode gets alert, confirm, prompt,\n * window.open and socket constructors wrapped, so calling them is caught.\n * Needs Playwright, which is not a dependency (see shots.mjs).\n *\n * Parallel is played at 1 and 2 players: nothing is shared, so more copies\n * prove nothing more. Its checks expect Math.random seeded the same on every\n * copy, progress from every copy, and no game traffic.\n *\n * Ghost and shared world are played at 2, 3 and 4 players on a poor network\n * (150 ± 50 ms, 5% loss). Ghost is checked like parallel, except that every\n * copy sends its player. A shared world wants traffic both ways, and is\n * played once more at 2 players with its world hosted by one more copy that\n * has no player of its own, as a dedicated server would host it (README,\n * \"Shared world\"). That run is reported like any; --record does not hold it\n * against a game, since no server runs yet.\n *\n * --retrofit is for an existing game upgraded to parallel: it is played once,\n * at 2 players with one of them leaving. With --original <path>, errors the\n * original page already had are forgiven when it is opened on its own.\n * --draws-only does only that last part, for any page: the retrofit runs it on\n * a game before spending a model on it, since a page this browser cannot run\n * cannot be checked here. A WebGPU-only game without WebGPU is caught even\n * when its title screen shows: it asked for an adapter, got none, and drew\n * nothing with WebGL or a 2D canvas instead. --browser-args passes flags to\n * Chromium; on a machine without a GPU, SwiftShader gives such games a\n * software adapter:\n *   --browser-args \"--enable-unsafe-webgpu --enable-features=Vulkan --use-vulkan=swiftshader --use-webgpu-adapter=swiftshader --use-angle=swiftshader\"\n *\n * Every game's pasted client is also read from disk and must be exactly a\n * released one (scripts/lib/hub-client.mjs).\n *\n * --record writes the outcome into data/overrides.json, which is how the hub\n * keeps a failing game out of sessions: a game that fails gets \"session\": \"0\"\n * (it overrides the game's own hub:session meta, so Random Mode never deals\n * it) and a sessionNote naming what failed; a game that passes loses both.\n *\n * Usage:  node scripts/hub-check.mjs [game paths…] [--players 2,3,4] [--base URL] [--json] [--no-solo]\n *                                    [--retrofit [--original <path>]] [--draws-only] [--record] [--browser-args \"<flags>\"]\n *         (games default to the three examples in lib/hub/examples/)\n */\n\nimport { createServer } from 'node:http';\nimport { createRequire } from 'node:module';\nimport { mkdir, readdir, readFile, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { staticHandler } from './lib/serve.mjs';\nimport { modeOf, SELF_REPORTED } from '../lib/hub/round.js';\nimport { findClients } from './lib/hub-client.mjs';\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst EXAMPLES = ['/lib/hub/examples/arena.html', '/lib/hub/examples/ghost.html', '/lib/hub/examples/parallel.html'];\nconst PAGE_MS = 300_000;\n\nconst args = process.argv.slice(2);\nconst option = (name, fallback) => {\n  const at = args.indexOf(`--${name}`);\n  if (at === -1) return fallback;\n  const [value] = args.splice(at, 2).slice(1);\n  return value;\n};\nconst asked = option('players', null);\nlet base = option('base', null);\nconst original = option('original', null);\nconst asJson = args.includes('--json');\nconst solo = !args.includes('--no-solo');\nconst retrofit = args.includes('--retrofit');\nconst drawsOnly = args.includes('--draws-only');\nconst record = args.includes('--record');\n/** Extra flags for the browser, e.g. the ones that give it WebGPU where the machine can (lib/kit/README.md). */\nconst browserArgs = (option('browser-args', '') || '').split(/\\s+/).filter(Boolean);\nconst asPath = (g) => (g.startsWith('/') || /^https?:/.test(g) ? g : `/${g}`);\nconst games = args.filter((a) => !a.startsWith('--')).map(asPath);\nif (!games.length) games.push(...EXAMPLES);\n\n/**\n * The player counts to try: as asked, or by the game's mode, within the seats\n * the game takes. Parallel shares nothing, so 1 and 2 say it all.\n */\nfunction countsFor(mode, [least, most]) {\n  const list = asked ?? (mode === 'parallel' ? '1,2' : '2,3,4');\n  return list.split(',').map(Number).filter((n) => n >= 1 && n <= 4 && (asked || (n >= least && n <= most)));\n}\n\n/** The game's session mode (older tags read as today's) and its seats, from its head. */\nasync function headOf(game) {\n  try {\n    const html = await (await fetch(/^https?:/.test(game) ? game : `${base}${game}`)).text();\n    const meta = (name) => html.match(new RegExp(`<meta\\\\s+name=[\"']${name}[\"']\\\\s+content=[\"']([^\"']+)[\"']`, 'i'))?.[1] ?? null;\n    const [least = 1, most = least] = (meta('hub:session-players')?.match(/\\d+/g) ?? []).map(Number);\n    return { mode: modeOf(meta('hub:session-mode')), seats: [least, most] };\n  } catch {\n    return { mode: null, seats: [1, 4] };\n  }\n}\n\nlet chromium;\ntry {\n  ({ chromium } = createRequire(import.meta.url)('playwright'));\n} catch {\n  console.error('hub-check needs Playwright: pnpm add -D playwright && pnpm exec playwright install chromium');\n  process.exit(2);\n}\n\n/**\n * Runs in every frame before its own scripts: it notes what the page asks of\n * the graphics stack, and session-mode pages are watched for dialogs and sockets.\n */\nfunction watch() {\n  // What the page asked of the graphics stack: a WebGPU adapter it never got, and\n  // no WebGL drawing instead, means this browser cannot run it (a title screen may still show).\n  const gfx = (window.__gfx = { askedForWebGPU: false, gotAdapter: false, webgl: false, twoD: false });\n  if (navigator.gpu?.requestAdapter) {\n    const ask = navigator.gpu.requestAdapter.bind(navigator.gpu);\n    Object.defineProperty(navigator.gpu, 'requestAdapter', {\n      configurable: true,\n      writable: true,\n      value: async (...a) => {\n        gfx.askedForWebGPU = true;\n        const adapter = await ask(...a);\n        if (adapter) gfx.gotAdapter = true;\n        return adapter;\n      },\n    });\n  }\n  for (const Canvas of [window.HTMLCanvasElement, window.OffscreenCanvas].filter(Boolean)) {\n    const getContext = Canvas.prototype.getContext;\n    Canvas.prototype.getContext = function (type, ...rest) {\n      const context = getContext.call(this, type, ...rest);\n      if (context && /^(webgl2?|experimental-webgl)$/.test(type)) gfx.webgl = true;\n      if (context && type === '2d') gfx.twoD = true;\n      return context;\n    };\n  }\n\n  if (!/[?&]aihub=/.test(location.search)) return;\n  const seen = (window.__hubViolations = []);\n  for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n    window[name] = () => {\n      seen.push(`${name}() called`);\n      return name === 'confirm' ? false : null;\n    };\n  }\n  for (const name of ['WebSocket', 'RTCPeerConnection', 'EventSource']) {\n    const Original = window[name];\n    if (!Original) continue;\n    window[name] = function (...a) {\n      seen.push(`${name} opened in a session (${String(a[0]).slice(0, 80)})`);\n      return new Original(...a);\n    };\n  }\n  addEventListener('error', (e) => seen.push(`error: ${e.message}`));\n  addEventListener('unhandledrejection', (e) => seen.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n}\n\nlet server = null;\nif (!base) {\n  server = createServer(staticHandler(ROOT));\n  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));\n  base = `http://127.0.0.1:${server.address().port}`;\n}\n\nconst browser = await chromium.launch({ headless: true, executablePath: process.env.CHROMIUM_PATH, args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required', ...browserArgs] });\nconst runs = [];\ntry {\n  for (const game of games) {\n    if (drawsOnly) {\n      const report = await stillWorks(game, null, { bare: true });\n      runs.push({ game, players: 1, scenario: 'draws', pass: report.pass, checks: report.checks });\n      if (!asJson) console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  draws on its own`);\n      continue;\n    }\n    const client = await clientCheck(game);\n    if (client) {\n      runs.push({ game, players: 0, scenario: 'static', pass: client.pass, checks: [client] });\n      if (!asJson && !client.pass) console.log(`FAIL  ${game}  ✗ ${client.name} — ${client.detail}`);\n    }\n    const { mode, seats } = await headOf(game);\n    const counts = countsFor(mode, seats);\n    // A retrofit is played once, at 2 players with one leaving: nothing is shared, so that says it all.\n    const plan = retrofit && !asked ? [] : counts.map((n) => ({ n, scenario: 'standard' }));\n    const leaving = retrofit && !asked ? 2 : Math.max(2, Math.min(3, Math.max(...counts, 0)));\n    if (asked || leaving <= seats[1]) plan.push({ n: leaving, scenario: 'host-leave' });\n    // A shared world must also run on a copy with no player of its own, as a server would run it.\n    if (!retrofit && mode && !SELF_REPORTED.includes(mode) && (asked || (seats[0] <= 2 && seats[1] >= 2))) plan.push({ n: 2, scenario: 'server' });\n    for (const { n, scenario } of plan) {\n      const context = await browser.newContext({ viewport: { width: 1280, height: 860 } });\n      await context.addInitScript(watch);\n      const page = await context.newPage();\n      const pageErrors = [];\n      const warnings = [];\n      page.on('pageerror', (e) => pageErrors.push(e.message));\n      page.on('console', (m) => m.text().startsWith('[AIHub]') && warnings.push(m.text()));\n      const query = { game, players: n, latency: 150, jitter: 50, loss: 5, auto: 1, scenario, play: 8000 };\n      const url = `${base}/lib/hub/harness.html?${new URLSearchParams(query)}`;\n      await page.goto(url);\n      // The harness times every step itself; this only catches a page that stopped answering.\n      // Four copies of a 3D game on software WebGL can take minutes.\n      const finished = await page.waitForSelector('body[data-complete=\"true\"]', { timeout: PAGE_MS }).then(() => true, () => false);\n      const report = (await page.evaluate(() => window.__hubCheck).catch(() => null)) || { pass: false, checks: [] };\n      if (!finished) {\n        report.pass = false;\n        report.checks.push({ name: `the harness finished within ${PAGE_MS / 1000} s`, pass: false, detail: `stopped after: ${report.checks.at(-1)?.name ?? 'nothing'}` });\n      }\n      const extra = [\n        { name: 'no client warnings (oversized or too many sends, misuse)', pass: !warnings.length, detail: [...new Set(warnings)].slice(0, 4).join('; ') },\n        { name: 'harness page has no errors', pass: !pageErrors.length, detail: pageErrors.join('; ') },\n      ];\n      report.checks.push(...extra);\n      report.pass = report.pass && extra.every((c) => c.pass);\n      runs.push({ game, players: n, scenario, pass: report.pass, checks: report.checks });\n      if (!asJson) {\n        console.log(`${report.pass ? 'PASS' : 'FAIL'}  ${game}  ${n} players  ${scenario}`);\n        for (const c of report.checks) if (!c.pass) console.log(`        ✗ ${c.name}${c.detail ? ` — ${c.detail}` : ''}`);\n      }\n      await context.close();\n    }\n    if (solo) {\n      const report = await stillWorks(game, original && asPath(original));\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"wc -l vendor/engine/API.md vendor/hub/lib/hub/README.md vendor/engine/docs/ASSETS.md && sed -n '120,230p' vendor/engine/API.md && sed -n '1,200p' vendor/engine/kits/arcade.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"wc -l vendor/engine/API.md vendor/hub/lib/hub/README.md vendor/engine/docs/ASSETS.md && sed -n '120,230p' vendor/engine/API.md && sed -n '1,200p' vendor/engine/kits/arcade.js\"","aggregated_output":"  297 vendor/engine/API.md\n  412 vendor/hub/lib/hub/README.md\n  160 vendor/engine/docs/ASSETS.md\n  869 total\n```js full-script\ngame.script(function* () {\n  yield 1;                                   // seconds of game time\n  yield E.until(() => door.open);            // a condition\n  yield game.tween(boss, { y: 80 }, 1.5);    // a tween (or another script, or a generator) finishing\n  for (let w = 0; w < 3; w++) { spawnWave(w); yield E.any([8, () => enemies.length === 0]); }\n});\n```\n  `E.all([...])` waits for all; a bare `yield` waits one step. It runs at once to its first `yield`, the same at any refresh rate; `{ keep: true }` outlives the scene; `.cancel()`, `.done`, `.value`.\n- Paths: `const p = new E.Path([[x, y, z], ...], { closed, smooth: 'catmull' })`: `p.length`, `p.at(d)` (`{ x, y, z, angle }` by distance along: moving platforms, dives, rails), `p.nearest(x, y)` (a racer's progress), `p.draw(r)` to see it.\n- Weather: `game.weather = { kind: 'rain' | 'snow' | 'ash' | 'leaves' | 'sand', amount: .8, wind: .3, lightning: .2 }` (null: clear) falls through the world in every view, settles or splashes, flashes and thunders; cosmetic only (its own random stream), and it ends with the scene: set it in `enter`.\n- Wrap-around (Asteroids): `x = E.wrap(x, 0, W)`, `E.wrapDiff(a, b, W)` (the short way across the seam), and `wrap: [W, H]` on `r.sprite` or `r.actor` draws a copy across each edge.\n\n## Standard features (every game has them: don't build your own)\nWith no code: a **pause menu** on pausable scenes (Resume, Settings, Controls, Full screen, Quit to title; keys, mouse, gamepad and touch), **settings** saved per game (`game.settings`: volume, music, effects, mute, reduce motion, shake and flashes, pixel scaling, a screen filter, the frame rate and its readout), **controls** the player rebinds (conflicts said first; dead zone, invert aim and move, button symbols, vibration; touch button side, size, opacity), **full screen** (a phone's first tap, a top-right button, the menu; turning it off is remembered), a **menu button** at the top right (on a touch screen it stays in play: it is the touch START), a **way out** of every menu screen, the **back gesture** stepping back in the game (`game.back()`) before it leaves the page, **pausing** when the page is hidden or the controller unplugs, and a page set up for phones (safe areas, no scrolling, zooming or pull to refresh on the canvas).\n- Adjust: `new E.Game({ menu: { items: [['Restart', fn]], settings: [{ key: 'hints', label: 'Hints', value: true }, { key: 'difficulty', options: ['Easy', 'Normal', 'Hard'], value: 'Normal' }], controls: { attack: 'Sword', skill: false }, quit: 'title' } })`, then read `game.settings.hints`. Leave parts out: `menu: false` (your own pause), `fullscreen: 'button' | false`, `corner: false`, `backGesture: false`, `autoPause: false`, `touch: 'never'` (a phone is told a controller or keyboard is needed). `game.cornerArea()`: where the corner's buttons cover the screen (or null): keep a HUD clear of it.\n- Save slots (`game.saves`): three slots and an autosave, each with its place, level and time played. `game.saves.write = () => ({ data, place, level })` and `read = save => {...}`; then `save(slot)` (0, 1, 2 or `'auto'`), `load(slot)`, `copy(a, b)`, `erase(slot)`, `autosave()`, `list()`, `latest()` (a title's Continue). `menu: { saves: true }` (or `{ slots, version, migrate(data, from) }`) puts Save (while `saves.canSave`: a save point) and Load in the pause menu, and `saves.show('save' | 'load')` opens the screen from your own menu. Blocked storage keeps them for the visit.\n- Prompts: `game.input.label('jump')` is that action's key or button on the player's device, after rebinding ('Space', 'A', '✕'). PlayStation symbols by default: `settings: [{ key: 'glyphs', value: 'playstation' }]` (a standard key without a label sets its default). A canvas title's OPTIONS: `game.menu('settings')`. From code: `game.settings.set(key, v)`, `game.fullscreen.toggle()` (from a key, click or tap), `game.pause(reason)`, `game.resume()`. `live: true` (or `game.menu(name, { pause: false })`): menus over a world that keeps stepping (online play).\n- **Boot**: heavy setup in steps behind a boot screen, and a report for any error before play: `game.start({ scenes, scene, boot: { title, steps: [['Building the city', () => { map = build(); }]] } })` (`AI_GUIDE.md`, Boot).\n\n## Input: `game.input`\n- Actions in every preset: `up down left right` (WASD, arrows, d-pad), `start` (Enter, Start), `pause` (Escape, P, Start), `confirm` (Enter, Space, J, Z, pad A), `cancel` (Escape, Backspace, X, K, pad B).\n- DEFAULT adds `attack` (J, X, click), `dash` (Space, Shift, K), `skill` (L, E, right click), `jump` (Z). PLATFORMER: `jump` (Space, Z, K, pad A), `attack` (X, J, click), `dash` (Shift, C, L), `skill`. SHMUP: `fire` (Space, Z, J, click), `bomb` (X, K). THIRDPERSON: `sprint` (Shift), `jump` (Space), `crouch` (C, Ctrl), `interact` (E, F), `attack` (J), `block` (K), `dodge` (L), `use` (Q), `map` (M, Tab).\n- `down(a)`, `pressed(a)`, `released(a)`, `repeat(a, delay, rate)` (menus), `buffered(a, win)` + `consume(a)`, `consumeAll()`, `anyPressed()`, `move()` (screen direction `[x, y]`, length up to 1), `use(preset)`, `touchButtons(['jump', 'attack'])`, `touchSet('confirm', 'TALK', near)` (a context button: relabel it, or hide it while it has nothing to do).\n- Moves: `input.motion('236', 'attack', { facing })` is true on the step a quarter circle forward and punch ends (numpad notation, mirrored when `facing` is -1: `'623'`, `'41236'`); `input.sequence(['up', 'up', 'down', 'down+right', 'attack'], { window: .5 })` any run of inputs (a cheat code); `input.history` the last second of them (`{ t, dir, pressed }`, for an input display).\n- Players (two to four on one machine): `game.players` is `[game.input, ...]`, each an input with this API, its `player` number, `name` (`'P2'`), `color` (`E.PLAYER_COLORS`) and device. `game.allowJoin({ max: 2, onJoin: (input, n) => {} })` lets them in: Start on a free gamepad, or 2 on the keyboard (player 2 takes its right half: arrows, `.` `/` `,` and the numpad; player 1 keeps WASD with F G H; a preset's `halves: { left: { pass: ['KeyR'] }, right: {...} }` its own); `game.addPlayer({ pad: 0 })` or `({ keys: 'right' })`, `game.removePlayer(p)`. Prompts, the pause (P2 PAUSED), a lost controller and the Controls screen are per player. One screen: `cam.frame(heroes)`. Split: `game.splitScreen(2, { follow: [h1, h2], layout: 'auto' })` (`'columns'`, `'rows'`, `'grid'`; up to 4) draws the scene once per viewport (`r.viewport` is `{ i, x, y, w, h }`), then `scene.hud(r)` once over the whole screen; `game.viewports[i].follow(t)` or `.focus(x, y)`.\n- `clear()` releases held inputs, pending presses, virtual sticks and touch buttons; focus loss does this automatically. `suppress(a)` blocks an action for the current tick; `suppressCode('Mouse0')` lets a HUD widget consume that mouse button while other devices bound to the action still work.\n- Controller settings: `deadzone` (default `.18`, radial and rescaled), `invertAimY`, `lastDevice` (the index has the rest). The left stick and the touch stick, pushed past halfway, press `up` / `down` / `left` / `right` as the d-pad does (menus, dialog choices, ladders); bind `PadAxisUp/Down/Left/Right` to your own menu actions for the same; the right stick is `PadRAxisUp/Down/Left/Right`, the wheel `WheelUp`/`WheelDown`; `value(a)`: 0 to 1 (a trigger's travel, a stick's push). Options while Create is held is no press (the AI Hub's chord).\n- Touch settings: `touchEnabled`, `stickSide` (`'left'` or `'right'`), `stickRadius` (CSS pixels), `touchFilter(event)` (return false to reserve a canvas tap for UI). `touchArea()`: where the touch buttons cover the screen (`{ x0, y0, x1, y1 }`, or null): keep a prompt clear of it. `clicked()`: where a click or tap on the canvas landed (`[x, y]` in screen pixels) the step after it, else null; `pointer()`: the mouse in screen pixels; `drag()`: how far the stick's finger moved this step (`[dx, dy]`, or null), to steer one to one; `steer = 'drag'`: a finger anywhere steers, no stick drawn (`stickOn`: a finger is on it). `zones = [{ x0, y0, x1, y1, act }]` (fractions of the canvas): a finger in one holds its act until it lifts (a pinball's halves). Gestures (a mouse or one finger, screen pixels): `box()` → `{ x0, y0, x1, y1, done }` (a left drag; on touch a long press, then a drag), `longPress()`, `doubleTap()`, `pan()` → `[dx, dy]` (a finger's drag on open ground, a middle or right drag), `zoomPoint()`; `feed('down' | 'move' | 'up', x, y, { touch, button, id })` plays a pointer in a test. `bindButtons(root)` wires `[data-act]` elements.\n\n## Drawing: `r` in `draw(r)`\n- Background: `r.sky(['#top', '#mid', '#bottom'])`, `r.starfield({ count, speed, dir: 'down' | 'left' })`.\n- Depth sorted: `r.actor(x, y, z, (g, ox, oy) => rig.draw(g, ox, oy, r.view), { flash: '#ffffff', flashMix: .75, alpha, xray, outline, ghost, emissive, every, key })` (the flash tints over the sprite so shading shows: `flashMix` .5 by default, 1 solid; `every: 2, key: npc` redraws a background character every other frame; actors up to about 250 px tall), `r.sprite(x, y, z, sprite, { flip, anchor: 'bottom' | 'center', glow, flash })`, `r.queue(x, y, z, g => {...}, { bias })` (sorted by that one point: a long wall by `r.queueSpan(a, b, z, h, fn)`), `r.actorNow(...)` (as `r.actor`, drawn at once over what is drawn so far), `r.box(g, x0, y0, z0, x1, y1, z1, top, side)` (inside a queue function). `{ pick: unit }` on any of them (and `r.shape`), then `r.pick(sx, sy)` → what the last frame drew under a screen point, front to back.\n- Floor marks: `r.shadow(x, y, radius, alpha, color, surfaceZ)`, `r.decal(g => r.groundArc(...))`, `r.groundDisc`, `r.groundRing`, `r.groundPts(x, y, rad, n, z)`.\n- On top, unlit, screen pixels: `r.text(str, x, y, color, { align, scale, outline })`, `r.textAt(x, y, z, str, color)`, `r.overlay(g => {...})`.\n- `r.w(x, y, z)` = buffer pixel of a world point. `r.W`, `r.H`, `r.ix`, `r.iy` (pass to dither functions), `r.view`, `r.visible(x, y, z)`.\n- X-ray: `r.actor(..., { xray: true })` shows the actor's hidden part, a translucent tint with a 1-px outline (a checker in `E.style.trans = 'dither'`), wherever a wall, a prop or shape at least chest high (22; `hides: true | false` says otherwise) or anything queued with `{ hides: true }` is drawn in front of it; not by one rising less than 8 above its feet (the roof it stands on, a cut-down wall). `xray: { color, outline (false: none), actors: true }`: with `actors` other bodies in front hide it too (a hero stays findable in a crowd). Afterimages: `ghost: { color, life, alpha, owner }`; `owner` (the actor's `{x, y, z}`) keeps a trail left nearer the camera sorted behind the live body.\n- Glowing things you draw yourself: `r.queue(x, y, z, fn, { emissive: true })` is drawn again after lighting so darkness never dims it (flames, lasers, magic, neon). It still hides behind whatever stands in front of it: walls and `r.actor` bodies do this on their own, and any other queued draw can join them with `{ solid: true }`. (Canvas lighting builds a depth-ordered mask for this; `game.r.glowMask = false` skips it on slow machines.)\n\n## Pixels, sprites, text, UI\n- `px.rect(g, x, y, w, h, c)`, `dot`, `line(g, x0, y0, x1, y1, c, width)`, `disc(g, x, y, r, c)`, `ell`, `poly(g, pts, c)`, `polyDither(g, pts, c, 0..1, r.ix, r.iy)`, `ddisc`, `sprite(g, spr, x, y, flip)` (or `{ flip, rot, scale }`), `glow(g, 0..1)` (GPU glow for what follows).\n- Sprites from strings (for coins, bullets, ships, icons, NES-style enemies): `const COIN = E.sprite(['.yy.', 'yYYy', '.yy.'], { y: '#f0b020', Y: '#fff0a0' }, scale)`. `.` and space are transparent. Frames: `const walk = E.anim([f1, f2, f3], 8, { pingpong })` (or one sheet: `E.anim(sheet, 8, { frames: 4 })`), drawn with `r.sprite(x, y, z, walk, { t })`. `r.sprite(..., { rot: angle, scale })` turns and scales in whole pixels (cached in 16 steps a turn; `steps: 32`); `E.recolor(spr, { '#3a8a4a': '#8a3a4a' })` swaps a palette.\n- Font (5x7 proportional with lower case: ASCII, the face buttons, arrows, ★ ♥ ♪ ✓ … ° € £, the accented Latin letters; any other is `?`; `font: 'tiny'` for 3x5): `E.font.text(g, str, x, y, color, { outline, shadow, gradient, scale, align, wrap, font })`, `E.font.title(g, str, x, y, { scale, colors, outline, depth, depthColor, align })`, `E.font.width(str, opts)`, `E.font.lineHeight(opts)`, `E.font.wrap(str, maxW, opts)`. Glyphs: ASCII plus `♥ ★ ← → ↑ ↓ • × ♪ ▸ ©`.\n- UI (inside `r.overlay(g => ...)`): `E.ui.box(g, x, y, w, h, { bg, border, gradient, alpha })` (a gradient window like Final Fantasy; `bg` can be `[top, bottom]`, `gradient: false` for flat, `alpha: .6` for a see-through HUD panel), `E.ui.bar(g, x, y, w, h, 0..1, color)`, `E.ui.hearts(g, x, y, hp, max)` (half hearts allowed), `rig.drawPortrait(g, x, y, size, { zoom: 3, turn: .6, bg, frame, cape: false, weapon: false, tint: '#808080' })` (character close-up; it stays upright while the rig kneels or lies down; `tint` greys out a KO'd hero).\n- Dialog: `const talk = new E.Dialog(game)`; `talk.say(['Line one.', 'Page two.'], { name: 'ELDER', portrait: elderRig, onDone, choices: ['YES', 'NO'], onChoice(i) })` (choices show on the last page: the keys, or a tap or click on one, pick); in update `if (talk.update(dt)) return;` (true while a modal box is open: play waits); in draw `talk.draw(r)`. `portrait` takes a Humanoid (live close-up; `portraitSize: 40`, `portraitOpts: { zoom, turn }`) or a function `(g, x, y, size) => {...}`. Radio chatter during play: `talk.say('Enemy fighters ahead!', { name, portrait, auto: 2.5, modal: false })` turns its pages and closes by itself while the game keeps running. Per line: `place: 'top' | 'middle' | 'bottom'`, `y` (pixels) and `alpha` (see-through box). `new E.Dialog(game, { speed, lines, color, nameColor, voice, width, bg, border, vars })` (`voice`: a sound, or `(ch, i, talk) => {}` per letter); `talk.close()`, `talk.open`. Markup in the text: `{c=#ffd36a}gold{/c}` a color, `{w=.5}` a pause, `{s=12}slowly{/s}` letters a second, `{shake}..{/shake}`, `{wave}..{/wave}`, `{$name}` a value from `say(text, { vars })` or `talk.vars`.\n- Menu: `const menu = new E.Menu(game, ['START', { label: 'LOAD', disabled: true }], { x: 'center', y: 100, title, onPick(i, item), onCancel, scale: 2, rows: 6 })` (rows: it scrolls); `menu.update(dt)`; `menu.draw(r)`. Keys, d-pad and sticks move it; a click or tap on an entry picks it (so a phone can leave a title), and the mouse over one moves the cursor. A tap on a dialog box turns its page as confirm does.\n- HTML screens and HUD: `const ui = new E.Shell(game, { theme: { scale: 2 } (a TV; or `tv: true`), settings, screens: { pause, help, dev: { rows: ['glyphs'] } } })`; `ui.show('title' | 'results' | 'map' | ..., spec)`; each step `ui.hud({ objective, status, bars, prompt, minimap })` (`minimap: { map, fog, camera: true, markers, onClick(x, y) }`); `ui.toast(title, text)`.\n\n## Sound: `game.audio` (chip synth, no files, starts after the first key press)\n- `sfx(name, { vol, pitch, pan, loop })` → `{ stop(), set({ pan, vol }) }` (a loop sounds on: an engine, rain). Presets: `jump jump2 land step coin pickup key powerup oneup heal hit hurt stomp bump swing whoosh punch kick shoot laser charge explode boom door secret warp die select confirm cancel pause text blip`.\n- Custom: `sfx({ wave: 'square' | 'pulse' | 'pulse12' | 'triangle' | 'saw' | 'sine' | 'noise', freq: 440 or 'A4', to: 880, dur: .2, vol: .3, arp: [0, 4, 7], step: .05, vib: [8, .03] })`, or `audio.define('zap', voice)`; `audio.instrument('pluck', (ctx, bus, time, freq, dur, vol) => ...)` is a `wave` too.\n- Music: `music('title' | 'adventure' | 'dungeon' | 'boss' | 'victory')` (built in; any other name warns and plays nothing), or your own `{ bpm: 120, steps: 4, tracks: [{ wave: 'square', vol: .15, notes: 'C5 - E5 - G5 . . . | ...' }, { wave: 'triangle', notes: '...' }, { wave: 'drums', notes: 'k . h . s . h .' }] }`. Tokens: a note (`C4`, `F#3`, `Bb2`), `-` holds, `.` rests, `|` is ignored; drums `k s h o c t`. `music(null)` stops. `mute()`, `setVolume(0..1)` (or set `audio.musicVolume`, `sfxVolume`, then `audio.applyVolume()`), `duck(on)` (quieter music under your own pause or map screen). Your own Web Audio connects to `audio.bus('sfx' | 'music' | 'voice')`, under the volume and mute.\n- The music clock (the full engine): a song's place is game time, headless too, and the sound follows it. `music(song, { sync: true })` pauses with the game (else it plays on); `audio.pos` → `{ t, step, beat, bar, at, loop, bpm, layers, playing }`; `at(step, fn)`, `onBeat(fn)` (on the update step); `tempo(bpm)`; `layer(name or index, vol, fade)` (a track's `name`, `on: false` starts it silent: the chase's drums in by layers); `music(song, { fade: 1 })` crossfades; `sting(song, { at: 'bar' })` over the music; `sfx(voice, { step })` on a step of the music. `settings.audioOffset` (ms, Settings, Sound: Calibrate) sets `audio.offset`; `audio.calibrate()` → `{ tap(), result, done, stop() }`.\n\n## Levels\n**TileMap** (top-down, isometric, brawler): walls stand on the ground plane.\n- `new E.TileMap({ rows, legend, types, floorTex, block: ['water', 'lava'], ao: 5, outside })` (`ao` = width of the contact shadow along wall bases, 0 = none; `outside`: the ground past the map, a color, or `false` for none). `types[id] = { h, top, side, line, course, cut: true, cutH, face, roof, beam }` (`cut` lowers walls that block the camera, those `map.isFront(cx, cy, view)` says; a map may replace it; `face`: `'brick'` (default) `'stone' 'rock' 'plank' 'timber' 'plaster' 'hedge' 'none'`; `roof`: `'speckle'` (default) `'plain' 'tiles' 'slab' 'leaves' 'grass'`; `beam` = timber color). `floorTex(x, y, floorTag, view)` returns `[r, g, b]` (or `[r, g, b, glow]`); ready-made: `E.tex.flagstone`, `grass`, `dirt`, `water`, `planks`, `checker`, `plain`. A map of more than 128 x 128 cells bakes its floor in squares as the camera comes to them and lets the far ones go (`chunks: true | false` to choose; `map.floorBytes()` what it holds), so a 256 x 256 world map costs what the screen shows.\n- Legend values: a number = wall type, a string = spawn tag, `{ tile, floor, spawn, block }` for both. `block: true` (or the map's `block` list of floor tags) makes deep water, lava or pits stop walkers (jumping bodies pass over); `walkable(cx, cy)`, `block(cx, cy, on)` (a bridge appears). FlowField paths go around blocked cells and follow `block` and `set` at their next `update`.\n- `find(tag)` / `findAll(tag)` give `{ x, y, z, cx, cy }`. Also `cell(cx, cy)`, `set(cx, cy, id)` (open doors), `toCell(x, y)`, `center(cx, cy)`, `heightAt(x, y)`, `floorAt(x, y)`, `groundAt(x, y, r, z)`, `collide(body)`, `los(x0, y0, x1, y1)` (ground only), `bounds(view)` (`{ x0, y0, x1, y1 }`, buffer pixels), `drawFloor(r)`, `queueWalls(r)`.\n\n**Heights** (collision, standing, sight, reach and navigation share one rule): a body's `z` is its feet; a cell's top is `map.height(cx, cy)` (0 = floor); a body stands on the highest top within `z + 2`. Eyes at `z + E.HEIGHTS.eye` (30) see a target at `z + E.HEIGHTS.chest` (22); a body's own `eye` / `chest` override them (crouching). Same level: `|dz| <= 8`. On a TileMap (`dir` = an angle or `[dx, dy]`): `ray(a, b, { eye, target })` → `{ clear, t, x, y, z }`, `sight(a, b)`, `standable(x, y, z, r)`, `ledge(from, dir)` → `{ x, y, z, rise, facing, edge }` (climb), `landing(from, dir)` → `{ x, y, z, d }` (a jump across a gap), `drop(from, dir)` → `{ x, y, z, fall }`, `arcClear(a, b, apex, r)`, `pick(sx, sy)` → `{ cx, cy, z, face }` (the cell under a screen point: `input.clicked()`, any view and turn). Helpers: `E.sameLevel(a, b)`, `E.targets(from, list, { range, arc, dz, sight: map })` → `[{ target, d, dz, angle }]` nearest first, `E.inArc(..., dz)`. `new E.FlowField(map, { climb, drop, jump })` paths over roofs, between levels and across gaps.\n\n**PlatformMap** (side-scrollers; 2.5D in tilted views): tiles on the x/z plane, top row first.\n- `new E.PlatformMap({ rows, legend, types })`. `types[id] = { kind, style, side, top, line, mat }` (`mat`: any material for a solid tile's face). Example: `rows: ['      ?    ', '   ===     ', '@  g   ^^  ', '###########']`, `legend: { '#': 1, '=': 2, '?': 3, '^': 4, '@': 'hero', 'g': 'walker' }`, `types: { 1: { style: 'ground', side: '#8a5a32' }, 2: { kind: 'oneway' }, 3: { style: 'bonus', side: '#e8a830' }, 4: { kind: 'hazard' } }`. Kinds: `'solid'` (default), `'oneway'` (jump up through), `'ladder'`, `'slope'` (`dir: 1` rises to the right, `-1` to the left; `from` / `to` heights 0..1 for gentle slopes), `'hazard'` (spikes, lava), `'deco'`, `'back'` (background wall). Styles: `'stone'` (`moss`) `'brick' 'wood' 'metal' 'ground'` (`flower`) `'block' 'pipe' 'bonus' 'plank' 'spikes' 'ladder' 'liquid' 'plain'`.\n- Spawns: `find(tag)` gives `{ x, z }` with z = the bottom of that cell (feet). Standing on the ground means z = the top of the floor tiles (`level.groundBelow(x, z)`, which returns `null` over a pit), not z = 0. `cell(cx, cz)` / `set(cx, cz, id)` count cz from the bottom row. `slopeZ(cx, cz, x)`, `touching(body, 'hazard')`, `cellsTouching(body, kind)`, `groundBelow(x, z)`, `solidAt(x, z)`, `move(body, dt, solids)`, `bounds(view)`, `draw(r)` (call first, after `r.sky`), `width`, `height`.\n\n## Movement and physics\n**Platformer** (side-scroller character): `const hero = new E.Platformer({ x, z, w: 8, h: 22, run: 95, jump: 285, gravity: 800, airJumps: 0, wallJump: false, dash: 0 })`.\n- Each update: `hero.update(dt, level, game.input, movingPlatforms)`. For enemies pass `{ x: -1..1, jump, jumpPressed, up, down, dash }` instead of the input.\n- Read: `onGround`, `jumped`, `landed`, `facing` (1 or -1), `air`, `climbing`, `hitWall`, `hitCeiling`, `bumped` (`{ cx, cz, id }` of a block hit from below). Methods: `knock(dir)`, `rigState(extra)` (feed it to `rig.update`).\n- Built in: coyote time, jump buffering, variable jump height (let go early for a short hop), slopes and small steps (sticks to the ground going down), ladders (up / down), drop through one-way tiles (down + jump), optional double jump, wall jump and dash.\n- Further moves, each on request: `crouch` (down: half as tall, it crawls), `ledge` (catches a ledge falling past it; up climbs), `wallCling`, `momentum` (slopes, a roll, a charged dash); tile kinds `'water'` (it swims), `'rope'` (up grabs it), `'bars'` (it hangs and travels), grip `friction` (ice .15), `carry` (a conveyor), `bounce` (a spring), `crumble` and `respawn` (`level.update(dt)` each step); `hero.swingFrom(x, z)` (a grapple: a pendulum, jump lets go); draw `level.drawWater(r)` after the actors. State: `crouching`, `hanging`, `clinging`, `swimming`, `onRope`, `onBars`, `swinging`, `rolling`; `rigState()` poses them.\n- Moving platforms: `{ x, z, w, h, vx, vz }` boxes you move yourself and pass as `solids`; riders are carried.\n\n**Body** (top-down / isometric / brawler): `new E.Body({ x, y, r: 5, friction: 0, bounce: 0, gravity: 700 })`. Set `vx`, `vy`, then `body.update(dt, map)`. Also `push(ix, iy, iz)` (knockback), `jump(v)`, and `onGround`, `z`, `groundZ`, `hitWall`, `landed`, `bounced` (hit the ground and bounced: dust, a thud). Walls lower than your feet are walkable, so bodies can jump onto blocks.\n\n**Mover** (third person): `const mover = new E.Mover({ x, y })`; `mover.update(dt, map, game.input)` (input `'THIRDPERSON'`) or an AI's `{ move: [dx, dy], sprint, crouch, jumpPressed }`: it sprints, sneaks, climbs, vaults, leaps gaps, hops down and rolls; `climbAny: true` climbs any wall (jump at it; up the screen is up the wall; jump leaps up, crouch lets go; `mover.wall`, `map.wall(from, dir)`), `glide: true` glides (jump again in the air; `lift`: an updraft), `staminaMax: 100` (climbing, gliding and sprinting spend `mover.stamina`); `rig.update(dt, mover.rigState())`; `mover.play('takedown', { other })`, your own `E.ACTIONS`. Stealth: `E.sees(guard, hero, { map })` → `{ seen, exposure }`, `E.hears`, `new E.Suspicion()` (`update(dt, seen, hero)` → `'calm' | 'notice' | 'search' | 'alert'`), `r.sightCone(guard, { map })`, `r.marker(x, y, z, { label })`.\n\n**Attack** (melee timing for swords, punches, kicks): `const slash = new E.Attack('slash')` (a move from `E.MOVES`, optionally with overrides: `new E.Attack('thrust', { reach: 10 })`) or a spec `{ a0, a1, z0, z1, reach, wind, active, recover }`. `if (input.buffered('attack') && slash.start()) input.consume('attack')`; `slash.update(dt)` (returns the phase that just began); `slash.hits(enemies, e => E.inArc(hero, facing, e, 22, 1.4), e => {...})` hits each target once per swing during `'active'` (moves wait until `hitAt: .35` of the swing, so hit-stop freezes the strike, not the wind-up); `rig.update(dt, { ..., attack: slash.state })`. Also `busy`, `active`, `cancel()`. **Combo**: `const combo = new E.Combo(['jab', 'cross', 'hook', 'uppercut'], { window: .3 })` (names, specs or Attacks); `combo.press()` starts or chains the next hit; `update`, `hits`, `state`, `step` work the same. **Knockback**: `E.knockback(attacker, target, 160, up)` pushes a Body (or anything with vx / vy) away.\n\n**Bullets**: `const shots = new E.Bullets(game, { plane: 'ground' | 'side' })`; `shots.fire({ x, y, z, vx, vy, vz, r: 2, team: 'player', color, life, dmg, pierce, sprite })`; `shots.burst(base, E.pattern.spread(angle, n, arc, speed))`; `shots.update(dt, map)`; `shots.hit(targets, (b, t) => {...}, 'player')`; `shots.draw(r)`; `shots.clear(team)`. Patterns: `E.pattern.dir(angle, speed)`, `aim(a, b, speed)`, `aimSide(a, b, speed)`, `spread(angle, n, arc, speed)`, `ring(n, speed, offset)`. In side view the second number of a pattern velocity is vz.\n\n**Helpers**: `E.dist(a, b)`, `E.angleTo(a, b)`, `E.arc(a, b, gravity, { apex | time | speed })` → `{ vx, vy, vz, t }` (a throw that lands at b: a lob, a grenade), `E.overlap(a, b)` (circles x, y, r), `E.overlapBox(a, b)` (side boxes x center, z feet, w, h), `E.inArc(a, facing, b, range, halfAngle, dz)` (melee cone; `dz` limits the height difference), `E.rand(a, b)`, `E.randInt(a, b)`, `E.pick(list)`, `E.chance(p)`, `E.prune(list, fn)`, `E.store.get(key, fallback)` / `set(key, value)` (save data; slots: `game.saves`), `new E.SpatialHash(32)` (`build(list)`, `near(x, y, r, fn)`), `new E.FlowField(map)` (`update(tx, ty)` or `update([[x, y], ...])`: the nearest; `dir(x, y, tx, ty)` walks around walls and `map.solid` shapes), math `clamp lerp approach ease.* angDiff approachAng smoothDamp rng(seed) noise2 hex shade mix`; `E.version` (the release) and `E.versionLabel()` ('v0.7.0 · a1b2c3d 2026-10-07': show it on a title or a debug screen).\n\n## Characters\n**Humanoid** (knights, heroes, soldiers, zombies): `new E.Humanoid({ size: 1.3, build: 'chibi' (default) | 'heroic' (tall) | 'bulky' (brawlers, bosses) | 'skeleton' (tint with colors.bone), weapon: 'sword' (the default) | 'gun' | 'staff' | null (fists) | a game's own (`E.Humanoid.weapon(id, { length, rest, draw(w) })`; `.hat(id, draw)`, `.pose(id, (J, w) => ...)`; `draw: { under, over }`; state `tilt`, `roll`), outfit: 'shirt' | 'tunic' | 'robe' | 'coat', hair: 'short' | 'spiky' | 'long' | 'ponytail' | 'bald', hat: 'cap' | 'pointed' | 'helmet' | 'band' | 'crown' (or { style, color }), sleeves: 'short' | 'long' | 'none', armor, hood (in colors.hair), cape: { len: 6, width: 5, seg: 2.5 }, eyeGlow, hunch, lean, style: 'hd' (default) | 'classic' (stick figures for huge crowds), colors: { skin, hair, cloth, coat, pants, boot, belt, trim, glove, cape, capeIn, metal, plate, hilt, eye, iris } })` (`metal` colors the weapon, `plate` the armor, defaulting to `metal`).\n- `rig.update(dt, { x, y, z, vx, vy, facing, dash, hurt, air, point, aim, attack })`. `facing` is an angle (side view: 0 = right, `Math.PI` = left). `air: true` tucks the legs for jumps; `point: true` holds a gun forward; `aim` tilts it (radians, + = up: `aim: .8` shoots diagonally up, `Math.PI / 2` straight up).\n- **Moves** (`E.MOVES`, use them instead of hand-made specs; every one has anticipation, a committed strike with lunge / step / lean / twist, follow-through and a clean return to the stance, on every build and in every view):\n  - blades and clubs: `slash backslash overhead rising thrust spin plunge twohand`;\n  - fists: `jab` (left hand) `cross hook uppercut haymaker elbow`;\n  - kicks: `kick roundhouse sweep flyingkick knee axekick`;\n  - other: `cast` (both hands) `throw bash claw`.\n  Give each character its own set (a knight: `overhead`, `thrust`, `spin`; a mage: `cast`; a monk: `jab`, `cross`, `roundhouse`; a boss: `haymaker`, `sweep`). `E.move('uppercut', .5)` is the attack state of any move at any moment (previews, cutscenes).\n- `attack: { spec, phase: 'wind' | 'active' | 'recover', u: 0..1 }`, spec `{ a0, a1, z0, z1, reach, r0, r1, hand, rel, blade, spin, kick, plane, lunge, hop, crouch, lean, twist, hold }`. Angles are relative to facing (+ = right hand side). `rel: true`: heights relative to the shoulder and reach scaled by arm length (kick heights as a share of hip height). `r0`/`r1`: reach that extends (thrusts, jabs). `hand: 'L' | 'both'`. In side views horizontal swings turn into the screen plane (a Castlevania chop) by themselves; `plane: 'side' | 'ground'` (or the rig option `swingPlane`) chooses. `lunge` steps into the strike (body motion in local units, clamped to -4..5; to move the character itself, add speed to your body), `hop` lifts the body, `crouch` dips in the wind-up, `hold` is how long the end pose holds (share of recover). You time the phases.\n- In steep ground views (threequarter) rigs and Blobs are drawn from a lower, sprite-like angle so faces show, like SNES RPG sprites (`charView: false` turns it off for one rig, `E.style.charPitch = false` for all).\n- Faces (eyes with catch-lights, brows, mouth), a cheated 3/4 turn toward the camera in side views (`cheat: .5`, 0 turns it off) and hair layers are automatic. `face: { eyes: 'big' (anime / Mana style), bangs: 0..1 }`.\n- Poses: `rig.update(dt, { ..., pose: 'cheer' | 'cast' | 'guard' | 'kneel' | 'crouch' | 'wave' | 'hips' | 'down' })` (they blend in and out), `'block'` (weapon upright across the body), `'die'` (a stagger, then the body topples), `expr: 'smile' | 'shout' | 'angry' | 'wince'` (faces and portraits), `run: 0..1` (run in place), or `down: 0..1` to lie a defeated body flat. `stance: 'guard'` keeps fists up while walking (brawlers; the free hand guards the chin during punches), `stance: 'ready'` holds the weapon forward. `climb: true` with `vz` climbs a ladder hand over hand (`Platformer.rigState()` passes both). Traversal: `crouch` (a sneaking gait), `sprint` (a lean), `hang` with `hangZ` (hands on an edge that high above the feet), `flip: 0..1` (a roll), `land: k` (a heavy landing); `mover.rigState()` sets them. Every wind-up starts from the rig's current pose, so chained hits and hand changes never snap. Idle rigs breathe and shift their weight by themselves.\n- `rig.draw(g, ox, oy, view)` inside `r.actor`, `rig.drawSmear(r)` (a glowing trail along the real blade, fist or foot path, in every view), `rig.debug(r)` (skeleton), `rig.kick(v)` (squash and stretch), `rig.hand()` and `rig.tip()` (world points to spawn bullets from), `rig.worldOffset(p)` (where a point in the rig's own frame, such as a joint in `rig.J`, sits from its feet: to draw or spawn at any joint), `rig.lastView` (the view it last drew with), `rig.solvePose()` (sets `rig.J` from its state each step: wrap it on one rig to move joints).\n**Blob** (slimes, rabbites, bats, imps, round monsters): `new E.Blob({ R: 6, colors: { dk, base, lt, spec, eye, pupil }, ears: 'rabbit' | 'cat', horns: true, wings: true, feet: true, tail: true, mouth: true | 'fangs', face: 'front' })`, `update(dt, { squash: -0.4..0.4, look: [dx, dy], squint, walk: 0..1, flap: 0..1 (wing speed; 0 folds them), hang: true (roost upside down) })`, `kick(v)`, `draw(g, ox, oy, view)`. Mix the parts for a bestiary: `wings` + `mouth: 'fangs'` is a bat, `ears: 'rabbit'` + `feet` a Mana rabbite, `horns` + `tail` an imp.\n\n## Effects and lighting\n- Particles: `game.particles.explosion(x, y, z, size)` (fireball, smoke, sparks, debris, ring, shake, sound), `fire(x, y, z, n, { size })`, `smoke(x, y, z, n, { size, color })`, `glints(x, y, z, n, color)`, `dust(x, y, z, n)`, `sparks(x, y, z, n, angle)`, `bits(x, y, z, n, colors)`, `ring(x, y, r0, r1, color, dur)`, `text(x, y, z, '12', color, { scale: 2, bounce: true })` (bouncing damage numbers), `add({ kind: 'dust' | 'spark' | 'bit' | 'ember' | 'fire' | 'smoke' | 'glint', ... })`. `explosion(x, y, z, size, { debris, freeze: false, shake: 0 })` for chains of small blasts. Side-scrollers: `particles.ground = (x, y, z) => level.groundBelow(x, z)` so sparks and debris bounce on platforms. Screen flash: `game.flash('#ffffff', .12, strength 0..1)`.\n- Lighting (step 9; every view, side-scrollers included, no WebGPU needed): `game.lights.add(x, y, z, radius, intensity, { color: '#ffa050' })` every draw. Dark areas get a smooth cool tint, lights add their own color, and emissive items (flames, sparks, bullets, `emissive: true`) stay bright. `lights.darkness` (0..1) and `lights.tint` tune it; after setting `lights.dark = [r, g, b]`, `levels` or `glow`, call `lights.refresh()`. Props with flames can light the scene: `r.prop('torch', x, y, z, { light: true })`. Lamps, street lamps, lanterns and crystals glow on their own (`haloR`, `haloColor`, `halo: false`); `cone: true` adds a light cone under a street lamp.\n- Hits: `game.hitFx(x, y, z, { power: 1, angle, damage: 12, textScale: 2, textZ: 22 })` does hit-stop, shake, an impact star, sparks, a bouncing damage number (`bounce: false` floats it) and a sound in one call; `particles.impact(x, y, z, size, color)` for the star alone.\n- GPU lighting (optional, ground views with a TileMap): `const gpu = game.enableGPU({ map })`; mark glowing things with `px.glow(g, 1)`; add `lights.caster(x, y, r, top)` and `lights.heat(x, y, z, w)`. Where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with `game.lights.ambient` (`gpu.fallback = false`: unlit).\n\n## Genre playbook (NES, SNES, Genesis, N64, PS1)\n| Genre (examples) | View | Build it with | Copy slice |\n|---|---|---|---|\n| Platformer (Mario, Mega Man, Sonic, Castlevania) | `side` (+ `brawler` for 2.5D) | PlatformMap, Platformer, Humanoid, sprites, Bullets `'side'` | PLATFORMER |\n| Metroidvania (Metroid, Symphony of the Night) | `side` | an `E.World` of PlatformMaps (the rooms module: doors at open edges, a slide, the explored map, gates opened by abilities, saves), a Platformer given `airJumps` and `dash` as they are found, its further moves, an arm cannon aimed eight ways (`point`, `aim`, `rig.tip()`, Bullets) | METROIDVANIA |\n// The ARCADE kit's game (a cabinet of three: maze, formation, rocks), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/32-arcade.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. arcade.html plays it; node kits/test.mjs arcade runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 10  ARCADE  (a cabinet of three golden-age classics: Pac-Man, Galaga, Asteroids). @modules arcade grid gen\n * Three short games, each a remaster (lit, with HD rigs, glowing lines and particles) with the classic look one key away\n * (C, a pad's Y, or Settings: Arcade, Look), each with its own high-score table, initials on a letter wheel, a continue,\n * two players taking turns, and a demo in the attract mode.\n *   MAZE (#arcade/maze): eat every glow-seed in a hedge maze while four wisps hunt you, each its own way (one chases, one\n *     heads you off, one flanks with the first, one is shy up close), in waves of scatter and chase; a lantern seed turns\n *     them blue and edible for a while; the side tunnel wraps round. Each maze is new (E.gen's braided maze, mirrored);\n *     an intermission after the first.\n *   FORMATION (#arcade/formation): moths fly in on curved paths (E.Path), form up and sway, then dive at you along paths\n *     of their own, turning as they fly (r.sprite's rot); two shots on screen at a time; a stage card between waves.\n *   ROCKS (#arcade/rocks): turn, thrust and drift through a field of rocks that split when shot; the screen's edges meet\n *     (E.wrap); a saucer hunts you; hyperspace when cornered. Glowing vector lines.\n * The cabinet (#arcade) is the title: left and right pick a game, up and down one or two players. Left alone it plays a\n * demo of each game in turn (its own bot), then shows that game's table. The sides of a wide screen show cabinet art\n * drawn by code. Keys: arrows / WASD, Space / Z / J fire (rocks: up thrusts, X / K hyperspace), Enter start, C classic.\n * TOUCH: the stick, FIRE (rocks: THRUST and WARP too); a tap picks a cabinet, and the letter wheel takes taps.\n * HOW IT WORKS: E.Arcade (the arcade module) keeps the scores, lives, turns, tables, initials, cards, the continue and the\n * attract mode; the maze is an E.Grid with E.GridMovers (a turn asked early is kept), each game a { begin, step, draw }.\n * ===================================================================================== */\nconst ARCADE = (() => {\n  const KEYS = Object.assign({}, E.Input.SHMUP, { thrust: ['Pad2', 'Pad5'], warp: ['KeyX', 'KeyK', 'ShiftLeft', 'Mouse2', 'Pad1', 'Pad6'], classic: ['KeyC', 'Pad3'] });\n  delete KEYS.bomb;\n  game.settings.define({ key: 'arcadeLook', group: 'Arcade', label: 'Look', options: [['remaster', 'Remaster'], ['classic', 'Classic']], value: 'remaster', help: 'Remaster: lit, with HD rigs and glowing lines. Classic: as the cabinets first looked. C switches it in play' });\n  const classic = () => game.settings.arcadeLook === 'classic';\n  // the cabinet's own tune (the step sequencer's format): A minor, a bouncing bass\n  const SONG = { bpm: 132, steps: 4, tracks: [\n    { wave: 'square', vol: .12, notes: 'A4 . C5 . E5 . A5 - G5 . E5 . C5 . D5 . | E5 - - . D5 . C5 . B4 . G4 . A4 - - . | F4 . A4 . C5 . F5 - E5 . C5 . A4 . B4 . | C5 . B4 . A4 . G#4 . A4 - - - - . . .' },\n    { wave: 'triangle', vol: .3, notes: 'A2 . A3 . A2 . A3 . A2 . A3 . A2 . A3 . | C3 . C4 . C3 . C4 . G2 . G3 . G2 . G3 . | F2 . F3 . F2 . F3 . F2 . F3 . F2 . F3 . | E2 . E3 . E2 . E3 . A2 . A3 . A2 . A3 .' },\n    { wave: 'drums', vol: .12, notes: 'k . h . s . h . k k h . s . h h' }] };\n  // the remaster's deep space (the classic look keeps plain black): a planet, nebulae drifting, many stars\n  const SPACE = [['#020208', '#0a0a24', '#1a0c30', '#2a1038'], ['#02040a', '#06142a', '#0c1c3a', '#1a1a3a']].map((sky, i) => new E.Backdrop({ sky, moon: { x: i ? .16 : .82, y: i ? .7 : .22, r: i ? 22 : 15, color: i ? '#8ab0d8' : '#b89ae8' }, stars: 140,\n    layers: [{ kind: 'clouds', color: i ? '#1a4a6a' : '#6a3aa8', y: .3, height: .45, parallax: .03, drift: 1, nebula: true, seed: 2 + i }, { kind: 'clouds', color: i ? '#3a2a5a' : '#2a5ab0', y: .72, height: .4, parallax: .05, drift: 2, nebula: true, seed: 5 + i }] }));\n  // cabinet art round a playfield of one fixed screen: on a wide screen's sides (left of x0, right of x1) a lit bezel edge,\n  // a marquee stripe and drifting sparks; on a tall one (above y0, below y1) the marquee with the game's name and the\n  // control panel\n  function cabinet(r, x0, x1, hue, y0 = 0, y1 = r.H, label = '') {\n    r.overlay(g => {\n      const H = r.H, t = game.time;\n      if (y0 > 40) {\n        px.rect(g, 0, 0, r.W, y0 - 4, '#0a0614'); px.rect(g, 8, y0 - 46, r.W - 16, 34, hue[0]); px.blend(g, .25, 'add', () => px.rect(g, 8, y0 - 46, r.W - 16, 12, '#ffffff'));\n        E.font.title(g, label, r.W / 2, y0 - 42, { align: 'center', scale: 2, colors: ['#ffffff', '#1a1030'], depth: 1 });\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' vendor/hub/lib/hub/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,140p' vendor/hub/lib/hub/README.md\"","aggregated_output":"# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card, longer if one asks for more time: what\n   the game is, how to win, the controls. The card is the hub's, from the\n   game's tags, or the game's own (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n  `fullscreenchange` follow the hub's page.\n\nThe hub replaces an unmodified copy of the client with each new version. An\nedited copy is not replaced.\n\n### Joining\n\n- `AIHub.active` is `true` from the first line when the hub opened the page.\n- In a session, the game opens straight into the round: no title screen,\n  menus or prompts before it, other than its own card (*The card*).\n- `AIHub.connect({ mode, seats: [min, max] })` returns a promise of the\n  round's `info`, or of `null` when there is no hub after all; with `null`\n  the game runs as it does on its own.\n- `AIHub.ready()` is called once, when the game has loaded and the round can\n  start, with no key press: the players answer the card.\n- The round starts when the card's countdown ends or every player pressed\n  Ready, and every game has called `ready()`. A game still loading then gets\n  20 more seconds; after that its player sits the round out.\n\n`info` (also on `AIHub` after `connect()`):\n\n| Field | |\n|---|---|\n| `me` | this copy's player id |\n| `players` | `[{ id, name, color }]`, ids `0..N-1` in seat order |\n| `host`, `isHost` | the id of the copy that runs a shared world, and whether it is this one |\n| `server` | `true` only on a copy that hosts a shared world with no player of its own |\n| `mode`, `round`, `limitMs` | the mode, the round number, and the round's hard limit after the start |\n| `seed` | a number, the same on every copy, behind `AIHub.rng(label)` |\n\nNames come from the hub and are never inserted into the page as HTML. Colours\nfollow the seat: `#e8443a`, `#3b82f6`, `#22c55e`, `#f5b700`.\n\n### The card\n\nBefore every round the players get 10 to 30 seconds to learn what comes\nnext and say when they are ready. A player can ask for more time, which adds\nten seconds; while more than half of them are asking, the countdown holds.\nBy default the hub shows its own card over the game. A game can make the\ncard its own, as part of the game:\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"agent_message","text":"The title draw selected **Space Fortnight**. I’ve inspected the original Century flyer and pinned the engine and Hub sources. The game will carry the flyer’s gravity bombs and fortress cooling through three connected defenses, ending with a winnable last stand.\n"}}
