{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"sed -n '933,957p' vendor/engine/my-3d2dge.js && sed -n '78,100p' vendor/hub/lib/hub/harness.html\"","aggregated_output":"  label(a, device = this.lastDevice) {\n    const m = this.map[a]; if (!m) { this._check(a); return ''; }\n    if (device === 'touch') return (this._touchLabels && this._touchLabels[a]) || a.toUpperCase();\n    const real = m.filter(c => !c.startsWith('Act:') && !c.startsWith('PadAxis')), pads = real.filter(padCode), keys = real.filter(c => !padCode(c));\n    const c = device === 'gamepad' ? pads[0] || keys[0] : device === 'mouse' ? keys.find(c => c.startsWith('Mouse')) || keys[0] || pads[0] : keys.find(c => !c.startsWith('Mouse')) || keys[0] || pads[0];\n    return c ? this.codeLabel(c) : '';\n  }\n  /** shake the gamepad: strength 0..1 for seconds (scaled by rumbleScale; nothing where the controller can't). Returns\n   *  true when it rumbled */\n  rumble(strength = .5, seconds = .15) {\n    const k = clamp(strength, 0, 1) * clamp(this.rumbleScale, 0, 1); if (!(k > 0) || this.padIndex === null || !this.screen.canvas) return false;\n    let a = null; try { const p = navigator.getGamepads()[this.padIndex]; a = p && p.vibrationActuator; } catch (e) { /* gamepads blocked */ }\n    if (!a || !a.playEffect) return false;\n    try { const r = a.playEffect('dual-rumble', { duration: Math.round(seconds * 1000), strongMagnitude: k, weakMagnitude: Math.min(1, k * 1.25) }); if (r && r.catch) r.catch(() => {}); } catch (e) { return false; }\n    this._rumbling = a; return true;\n  }\n  /** stop a rumble now (pause, focus lost, unplugged) */\n  stopRumble() { const a = this._rumbling; this._rumbling = null; try { if (a && a.reset) { const r = a.reset(); if (r && r.catch) r.catch(() => {}); } } catch (e) { /* gone */ } }\n  /**\n   * On-screen buttons for phones and tablets (shown on touch screens; the player's settings can show them always or hide\n   * them, put them on the left, and size them): input.touchButtons(['jump', 'attack'], { labels: { jump: 'A', attack:\n   * 'B' }, force }). The other half of the screen is a move stick (past halfway it presses up, down, left and right too,\n   * as a d-pad does: menus and ladders). START is the corner's menu button, top right: it opens the menu, or pauses a\n   * pausable scene into it (without the corner a START button there starts a title and pauses, as a gamepad's Start)\n   */\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n  $('log').textContent = logLines.join('\\n');\n  $('log').scrollTop = $('log').scrollHeight;\n}\n\n/** The game's head metas, when the page can be fetched from here. */\nasync function metasOf(url) {\n  try {\n    const html = await (await fetch(url)).text();\n    const doc = new DOMParser().parseFromString(html, 'text/html');\n    const meta = (name) => doc.querySelector(`meta[name=\"${name}\"]`)?.getAttribute('content')?.trim() ?? null;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/input.js');s=p.read_text().replace(\\\"else if(I.lastDevice==='mouse'&&I.pointer()&&index===0)\\\",\\\"else if(I.aimSource==='mouse'&&I.mouse.active&&I.pointer()&&index===0)\\\")\np.write_text(s)\np=Path('src/main.js');s=p.read_text().replace(\\\"onJoin:I=>{I.use(S.MAP);\\\", \\\"onJoin:I=>{I.use(I.half?E.Input.halfKeys(S.MAP,'right'):S.MAP);\\\")\np.write_text(s)\nPY\nnpm run build\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tools/visual_inspection.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/input.js');s=p.read_text().replace(\\\"else if(I.lastDevice==='mouse'&&I.pointer()&&index===0)\\\",\\\"else if(I.aimSource==='mouse'&&I.mouse.active&&I.pointer()&&index===0)\\\")\np.write_text(s)\np=Path('src/main.js');s=p.read_text().replace(\\\"onJoin:I=>{I.use(S.MAP);\\\", \\\"onJoin:I=>{I.use(I.half?E.Input.halfKeys(S.MAP,'right'):S.MAP);\\\")\np.write_text(s)\nPY\nnpm run build\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tools/visual_inspection.py\"","aggregated_output":"npm notice run space-fortnight@1.0.0 build\nnpm notice run node tools/build.mjs --quiet\n{\"title\": \"Space Fortnight \\u2014 Three lines. One last stand.\", \"errors\": [], \"engineErrors\": [], \"screen\": \"title\", \"focus\": \"Play solo\"}\n{\"errors\": [], \"engineErrors\": [], \"state\": {\"phase\": \"briefing\", \"tick\": 84}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"cat > tests/simulation.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport vm from 'node:vm';\nimport {loadSim} from '../tools/sim-loader.mjs';\nconst S=loadSim();\nconst results=[];\nfunction check(name,fn){try{fn();results.push({name,pass:true});}catch(e){results.push({name,pass:false,error:e.stack});}}\nfunction step(w,n,bot=false,choice=0){for(let i=0;i<n&&\"'!w.s.result;i++){\n  if(bot)for(const p of w.s.players){w.setIntent(p.id,S.botIntent(w,p.id,p.seq+1));if(w.s.phase==='\"'upgrade')w.upgrade(p.id,choice);}\n  w.step();\n}}\nfunction playing(options={}){const w=new S.World(options);w.s.phase='play';return w;}\nfunction fullRun(n,choice,seed=198113){const w=new S.World({seed,players:Array.from({length:n},(_,id)=>({id,name:'BOT '+id}))});step(w,100000,true,choice);return w;}\ncheck('authored data validates and missing definitions are rejected',()=>{\n  assert.deepEqual(S.validateWaves(),[]);const bad=structuredClone(S.WAVES);bad[0].groups[0].kind='absent';assert(S.validateWaves(bad).length>0);\n  const extra=structuredClone(S.WAVES[0]);extra.title='ADDED DATA BEAT';extra.groups[0].at=4;assert.deepEqual(S.validateWaves([extra]),[]);\n});\nfor(const [n,choice]of [[1,0],[1,1],[1,2],[2,1],[4,2]])check(\"'`${n}-pilot no-cheat complete victory with upgrade branch ${choice}`,()=>{\n  const w=fullRun(n,choice);assert(w.s.result?.won,JSON.stringify(w.s.result));\n  assert.equal(w.s.modified,false);assert.equal(w.s.options.god,false);assert.equal(w.s.upgrades,2);\n  assert.deepEqual(new Set(w.s.seen),new Set(Object.keys(S.ENEMIES)));assert.deepEqual(w.s.bossPhases,[0,1,2]);\n  assert(w.s.activeTime>=590&&w.s.activeTime<760,`Active time ${w.s.activeTime}`);\n  assert(w.s.base>0);assert.equal(w.s.outcomes.length,3);assert(w.s.score>14000);\n  for(const p of w.s.players)assert.equal(p.upgrades[S.UPGRADES[choice].id],2);\n});\ncheck('\"'an unattended wing retreats twice and reaches real defeat',()=>{\n  const w=new S.World({seed:23});step(w,110000);assert.equal(w.s.result?.won,false);assert.equal(w.s.act,2);\n  assert(w.s.outcomes.length>=2);assert(w.s.base<=0||w.s.players.every(p=>p.hp<=0));\n});\ncheck('same seed and intent stream produce identical state',()=>{\n  const a=new S.World({seed:616}),b=new S.World({seed:616});step(a,11000,true);step(b,11000,true);assert.deepEqual(a.snapshot(),b.snapshot());\n});\ncheck('complete snapshot restores deterministic continuation and clears old inputs',()=>{\n  const a=new S.World({seed:71});step(a,4500,true);const b=new S.World();b.restore(a.snapshot());assert.equal(b.intents.size,0);\n  step(a,4000,true);step(b,4000,true);assert.deepEqual(a.snapshot(),b.snapshot());\n});\ncheck('empty boost leaves thrust and laser functional',()=>{\n  const w=playing();const p=w.s.players[0];p.energy=0;p.inv=0;\n  w.setIntent(0,{seq:1,mx:1,my:0,ax:0,ay:-1,fire:true,boost:true,pulse:false});step(w,25);\n  assert(p.x>360);assert(w.s.shots.some(b=>\"'!b.foe));assert.equal(p.boost,0);assert(p.energy>=0);\n});\ncheck('\"'pulse clears only local hostile projectiles and breaks a tractor',()=>{\n  const w=playing(),p=w.s.players[0];w.shot(p.x+40,p.y,0,0,true);w.shot(p.x+210,p.y,0,0,true);w.shot(p.x+30,p.y,0,0,false);\n  const e=w.spawn('tractor',p.x+90,p.y,{tele:0,wind:2,target:0,lock:1});w.pulsePlayer(p);\n  assert.equal(w.s.shots.filter(b=>b.foe).length,1);assert.equal(w.s.shots.filter(b=>\"'!b.foe).length,1);\n  assert.equal(e.target,-1);assert.equal(e.lock,-1);assert(e.cool>=3);\n});\ncheck('\"'radiators require a quiet interval and unlocked sections cool proportionally',()=>{\n  const w=playing();w.s.act=1;w.s.heat=50;w.s.lastObjectiveHit=w.s.t;\n  step(w,240);assert.equal(w.s.heat,50);w.s.lastObjectiveHit=-10;w.s.locks=[true,true,true,true];w.step();assert.equal(w.s.heat,50);\n  w.s.locks=[false,false,false,false];w.step();assert(w.s.heat<50);w.objectiveHit();assert(w.s.heat>50);\n});\ncheck('solo wipe consumes first two layers and loses on the ground',()=>{\n  const w=playing();w.s.players[0].hp=0;w.step();assert.equal(w.s.phase,'retreat');assert.equal(w.s.outcomes[0].held,false);\n  step(w,2000);assert.equal(w.s.act,1);assert(w.s.players[0].hp>0);\n  w.s.phase='play';w.s.heat=100;w.step();assert.equal(w.s.phase,'retreat');assert.equal(w.s.outcomes[1].reason,'HEAT OVERFLOW');\n  step(w,2000);assert.equal(w.s.act,2);assert.equal(w.s.base,76);w.s.phase='play';w.s.players[0].hp=0;w.step();assert.equal(w.s.result.won,false);\n});\ncheck('co-op redeploy has invulnerability and a complete wipe ignores pending respawns',()=>{\n  const w=playing({players:[{id:0,name:'a'},{id:1,name:'b'}]}),p=w.s.players[0];p.inv=0;p.hp=1;w.damagePlayer(p);assert.equal(p.hp,0);\n  step(w,361);assert(p.hp>0);assert(p.inv>2.9);const hp=p.hp;w.damagePlayer(p);assert.equal(p.hp,hp);\n  for(const q of w.s.players)q.hp=0;w.step();assert.equal(w.s.phase,'retreat');\n});\ncheck('simultaneous final kill and base loss resolves only defeat',()=>{\n  const w=playing();w.jump(2,2,2);w.s.base=0;w.s.boss.dead=true;w.resolve();assert.equal(w.s.result.won,false);\n  assert.equal(w.s.events.filter(e=>e.type==='victory').length,0);const score=w.s.score;w.finish(true,'late');assert.equal(w.s.result.won,false);assert.equal(w.s.score,score);\n});\ncheck('damage is blocked exactly while invulnerability is positive',()=>{\n  const w=playing(),p=w.s.players[0];p.inv=S.DT;const hp=p.hp;assert.equal(w.damagePlayer(p),false);w.step();assert.equal(p.inv,0);assert(w.damagePlayer(p));assert.equal(p.hp,hp-1);\n});\ncheck('swept laser collision cannot tunnel and a near miss stays a miss',()=>{\n  const w=playing(),e=w.spawn('anchor',500,250,{tele:0,charge:10});\n  w.shot(100,250,0,100000,false,0,{dmg:100});w.stepShots(S.DT);assert.equal(e.hp,0);const score=w.s.score;w.kill(e);assert.equal(w.s.score,score);\n  const other=w.spawn('anchor',500,350,{tele:0,charge:10});w.shot(100,320,0,100000,false,0,{dmg:100});w.stepShots(S.DT);assert.equal(other.hp,other.maxHp);\n});\ncheck('shared pickups apply once and benefit every living pilot',()=>{\n  const w=playing({players:[{id:0,name:'a'},{id:1,name:'b'}]});for(const p of w.s.players){p.hp=2;p.energy=0;}\n  const p=w.s.players[0];w.s.drops.push({id:45,x:p.x,y:p.y,t:0,life:12,charge:true});w.stepDrops(S.DT);const score=w.s.score;\n  assert(w.s.players.every(p=>p.hp===3&&p.energy===55));w.stepDrops(S.DT);assert.equal(w.s.score,score);\n});\ncheck('charged anchor pull is bounded and boost can escape',()=>{\n  const w=playing(),p=w.s.players[0];p.x=440;p.y=300;w.spawn('anchor',500,300,{tele:0,charge:0,cool:30});p.inv=0;\n  const before=p.x;step(w,30);assert(p.x>before);const distance=S.dist(p,{x:500,y:300});\n  for(let i=0;i<90;i++){w.setIntent(0,{seq:i+1,mx:-1,my:0,ax:-1,ay:0,fire:false,boost:true,pulse:false});w.step();}\n  assert(S.dist(p,{x:500,y:300})>distance+80);\n});\ncheck('bad or stale intents are rejected; old held fire expires',()=>{\n  const w=playing();assert(\"'!w.setIntent(9,S.neutral(1)));assert(!w.setIntent(0,{...S.neutral(1),mx:NaN}));assert(!w.setIntent(0,{...S.neutral(1),mx:1,my:1}));\n  assert(w.setIntent(0,{...S.neutral(5),fire:true}));assert(!w.setIntent(0,S.neutral(5)));step(w,61);const fired=w.s.events.filter(e=>e.type==='\"'shot').length;step(w,80);assert.equal(w.s.events.filter(e=>e.type==='shot').length,fired);\n});\ncheck('transition cleanup, finite tuning and restart produce clean state',()=>{\n  const w=playing();w.spawn('hunter',400,120);w.shot(1,1,0,10,true);w.retreat(false,'test');assert.equal(w.s.enemies.length,0);assert.equal(w.s.shots.length,0);assert.equal(w.intents.size,0);\n  assert(\"'!w.balance('\"'gravity',Infinity));w.balance('gravity',90000);assert.equal(w.s.balance.gravity,420);assert(w.s.modified);w.resetBalance();assert.deepEqual(w.s.balance,S.DEFAULTS);\n  const fresh=new S.World();assert(\"'!fresh.s.modified);assert.equal(fresh.s.tick,0);assert.equal(fresh.s.enemies.length,0);\n});\ncheck('\"'ground aim stays in the legal upper arc',()=>{\n  for(const a of [-Math.PI,-1.5,-.01,0,.2,1.5,3]){const q=S.groundAim(a);assert(q<=-.15&&q>=-Math.PI+.15);}\n});\ncheck('native renderer and alternate draw rates cannot change gameplay',()=>{\n  vm.runInThisContext(readFileSync(new URL('../vendor/engine/my-3d2dge.js',import.meta.url),'utf8'),{filename:'engine'});\n  for(const file of ['render/assets','render/scene'])vm.runInThisContext(readFileSync(new URL('../src/'+file+'.js',import.meta.url),'utf8'),{filename:file});\n  const E=globalThis.My3D2dge,a=new S.World({seed:4}),b=new S.World({seed:4});\n  const game=new E.Game({headless:true,draw:true,res:[960,540],expand:false,view:'overhead',loop:false,menu:false});const paint=new S.Painter(game);\n  game.cam.smooth=0;game.focus(480,270,0);game.start({update(){for(const p of a.s.players)a.setIntent(p.id,S.botIntent(a,p.id,p.seq+1));a.step();},draw(r){paint.draw(r,a.s,game.time);}});\n  for(let i=0;i<1200;i++){game.advance(S.DT,{draw:i%4===0});for(const p of b.s.players)b.setIntent(p.id,S.botIntent(b,p.id,p.seq+1));b.step();}\n  assert.deepEqual(game.errors,[]);assert.deepEqual(a.snapshot(),b.snapshot());game.dispose();\n});\nexport const simulationResults=results;\nif(process.argv[1]?.endsWith('simulation.mjs'))console.log(JSON.stringify(results));\nEOF\ncat > tools/verify.mjs <<'EOF'\nimport {spawnSync} from 'node:child_process';\nimport {fileURLToPath} from 'node:url';\nimport path from 'node:path';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nconst selected=process.argv.slice(2),suites=selected.length?selected:['simulation','browser','hub'];\nlet passed=0,failed=0;\nfor(const suite of suites){\n const args=suite==='simulation'?['tests/simulation.mjs']:['tests/browser_checks.py',suite];\n const cmd=suite==='simulation'?process.execPath:'/home/micha/.local/share/pipx/venvs/playwright/bin/python';\n const result=spawnSync(cmd,args,{cwd:root,encoding:'utf8',maxBuffer:10*1024*1024});\n try{const tests=JSON.parse(result.stdout.trim());for(const t of tests){if(t.pass)passed++;else{failed++;console.error(\"'`FAIL ${suite}: ${t.name}'\"\\\\n\"'${t.error||t.detail}`);}}if(result.status&&tests.every(t=>t.pass)){failed++;console.error(`FAIL ${suite}: ${result.stderr}`);}}\n catch{failed++;console.error(`FAIL ${suite}: ${result.stdout}'\"\\\\n\"'${result.stderr}`);}\n}\nconsole.log(`${passed} checks passed; ${failed} failed.`);process.exitCode=failed?1:0;\nEOF\nnode tools/verify.mjs simulation'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"cat > tests/simulation.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport vm from 'node:vm';\nimport {loadSim} from '../tools/sim-loader.mjs';\nconst S=loadSim();\nconst results=[];\nfunction check(name,fn){try{fn();results.push({name,pass:true});}catch(e){results.push({name,pass:false,error:e.stack});}}\nfunction step(w,n,bot=false,choice=0){for(let i=0;i<n&&\"'!w.s.result;i++){\n  if(bot)for(const p of w.s.players){w.setIntent(p.id,S.botIntent(w,p.id,p.seq+1));if(w.s.phase==='\"'upgrade')w.upgrade(p.id,choice);}\n  w.step();\n}}\nfunction playing(options={}){const w=new S.World(options);w.s.phase='play';return w;}\nfunction fullRun(n,choice,seed=198113){const w=new S.World({seed,players:Array.from({length:n},(_,id)=>({id,name:'BOT '+id}))});step(w,100000,true,choice);return w;}\ncheck('authored data validates and missing definitions are rejected',()=>{\n  assert.deepEqual(S.validateWaves(),[]);const bad=structuredClone(S.WAVES);bad[0].groups[0].kind='absent';assert(S.validateWaves(bad).length>0);\n  const extra=structuredClone(S.WAVES[0]);extra.title='ADDED DATA BEAT';extra.groups[0].at=4;assert.deepEqual(S.validateWaves([extra]),[]);\n});\nfor(const [n,choice]of [[1,0],[1,1],[1,2],[2,1],[4,2]])check(\"'`${n}-pilot no-cheat complete victory with upgrade branch ${choice}`,()=>{\n  const w=fullRun(n,choice);assert(w.s.result?.won,JSON.stringify(w.s.result));\n  assert.equal(w.s.modified,false);assert.equal(w.s.options.god,false);assert.equal(w.s.upgrades,2);\n  assert.deepEqual(new Set(w.s.seen),new Set(Object.keys(S.ENEMIES)));assert.deepEqual(w.s.bossPhases,[0,1,2]);\n  assert(w.s.activeTime>=590&&w.s.activeTime<760,`Active time ${w.s.activeTime}`);\n  assert(w.s.base>0);assert.equal(w.s.outcomes.length,3);assert(w.s.score>14000);\n  for(const p of w.s.players)assert.equal(p.upgrades[S.UPGRADES[choice].id],2);\n});\ncheck('\"'an unattended wing retreats twice and reaches real defeat',()=>{\n  const w=new S.World({seed:23});step(w,110000);assert.equal(w.s.result?.won,false);assert.equal(w.s.act,2);\n  assert(w.s.outcomes.length>=2);assert(w.s.base<=0||w.s.players.every(p=>p.hp<=0));\n});\ncheck('same seed and intent stream produce identical state',()=>{\n  const a=new S.World({seed:616}),b=new S.World({seed:616});step(a,11000,true);step(b,11000,true);assert.deepEqual(a.snapshot(),b.snapshot());\n});\ncheck('complete snapshot restores deterministic continuation and clears old inputs',()=>{\n  const a=new S.World({seed:71});step(a,4500,true);const b=new S.World();b.restore(a.snapshot());assert.equal(b.intents.size,0);\n  step(a,4000,true);step(b,4000,true);assert.deepEqual(a.snapshot(),b.snapshot());\n});\ncheck('empty boost leaves thrust and laser functional',()=>{\n  const w=playing();const p=w.s.players[0];p.energy=0;p.inv=0;\n  w.setIntent(0,{seq:1,mx:1,my:0,ax:0,ay:-1,fire:true,boost:true,pulse:false});step(w,25);\n  assert(p.x>360);assert(w.s.shots.some(b=>\"'!b.foe));assert.equal(p.boost,0);assert(p.energy>=0);\n});\ncheck('\"'pulse clears only local hostile projectiles and breaks a tractor',()=>{\n  const w=playing(),p=w.s.players[0];w.shot(p.x+40,p.y,0,0,true);w.shot(p.x+210,p.y,0,0,true);w.shot(p.x+30,p.y,0,0,false);\n  const e=w.spawn('tractor',p.x+90,p.y,{tele:0,wind:2,target:0,lock:1});w.pulsePlayer(p);\n  assert.equal(w.s.shots.filter(b=>b.foe).length,1);assert.equal(w.s.shots.filter(b=>\"'!b.foe).length,1);\n  assert.equal(e.target,-1);assert.equal(e.lock,-1);assert(e.cool>=3);\n});\ncheck('\"'radiators require a quiet interval and unlocked sections cool proportionally',()=>{\n  const w=playing();w.s.act=1;w.s.heat=50;w.s.lastObjectiveHit=w.s.t;\n  step(w,240);assert.equal(w.s.heat,50);w.s.lastObjectiveHit=-10;w.s.locks=[true,true,true,true];w.step();assert.equal(w.s.heat,50);\n  w.s.locks=[false,false,false,false];w.step();assert(w.s.heat<50);w.objectiveHit();assert(w.s.heat>50);\n});\ncheck('solo wipe consumes first two layers and loses on the ground',()=>{\n  const w=playing();w.s.players[0].hp=0;w.step();assert.equal(w.s.phase,'retreat');assert.equal(w.s.outcomes[0].held,false);\n  step(w,2000);assert.equal(w.s.act,1);assert(w.s.players[0].hp>0);\n  w.s.phase='play';w.s.heat=100;w.step();assert.equal(w.s.phase,'retreat');assert.equal(w.s.outcomes[1].reason,'HEAT OVERFLOW');\n  step(w,2000);assert.equal(w.s.act,2);assert.equal(w.s.base,76);w.s.phase='play';w.s.players[0].hp=0;w.step();assert.equal(w.s.result.won,false);\n});\ncheck('co-op redeploy has invulnerability and a complete wipe ignores pending respawns',()=>{\n  const w=playing({players:[{id:0,name:'a'},{id:1,name:'b'}]}),p=w.s.players[0];p.inv=0;p.hp=1;w.damagePlayer(p);assert.equal(p.hp,0);\n  step(w,361);assert(p.hp>0);assert(p.inv>2.9);const hp=p.hp;w.damagePlayer(p);assert.equal(p.hp,hp);\n  for(const q of w.s.players)q.hp=0;w.step();assert.equal(w.s.phase,'retreat');\n});\ncheck('simultaneous final kill and base loss resolves only defeat',()=>{\n  const w=playing();w.jump(2,2,2);w.s.base=0;w.s.boss.dead=true;w.resolve();assert.equal(w.s.result.won,false);\n  assert.equal(w.s.events.filter(e=>e.type==='victory').length,0);const score=w.s.score;w.finish(true,'late');assert.equal(w.s.result.won,false);assert.equal(w.s.score,score);\n});\ncheck('damage is blocked exactly while invulnerability is positive',()=>{\n  const w=playing(),p=w.s.players[0];p.inv=S.DT;const hp=p.hp;assert.equal(w.damagePlayer(p),false);w.step();assert.equal(p.inv,0);assert(w.damagePlayer(p));assert.equal(p.hp,hp-1);\n});\ncheck('swept laser collision cannot tunnel and a near miss stays a miss',()=>{\n  const w=playing(),e=w.spawn('anchor',500,250,{tele:0,charge:10});\n  w.shot(100,250,0,100000,false,0,{dmg:100});w.stepShots(S.DT);assert.equal(e.hp,0);const score=w.s.score;w.kill(e);assert.equal(w.s.score,score);\n  const other=w.spawn('anchor',500,350,{tele:0,charge:10});w.shot(100,320,0,100000,false,0,{dmg:100});w.stepShots(S.DT);assert.equal(other.hp,other.maxHp);\n});\ncheck('shared pickups apply once and benefit every living pilot',()=>{\n  const w=playing({players:[{id:0,name:'a'},{id:1,name:'b'}]});for(const p of w.s.players){p.hp=2;p.energy=0;}\n  const p=w.s.players[0];w.s.drops.push({id:45,x:p.x,y:p.y,t:0,life:12,charge:true});w.stepDrops(S.DT);const score=w.s.score;\n  assert(w.s.players.every(p=>p.hp===3&&p.energy===55));w.stepDrops(S.DT);assert.equal(w.s.score,score);\n});\ncheck('charged anchor pull is bounded and boost can escape',()=>{\n  const w=playing(),p=w.s.players[0];p.x=440;p.y=300;w.spawn('anchor',500,300,{tele:0,charge:0,cool:30});p.inv=0;\n  const before=p.x;step(w,30);assert(p.x>before);const distance=S.dist(p,{x:500,y:300});\n  for(let i=0;i<90;i++){w.setIntent(0,{seq:i+1,mx:-1,my:0,ax:-1,ay:0,fire:false,boost:true,pulse:false});w.step();}\n  assert(S.dist(p,{x:500,y:300})>distance+80);\n});\ncheck('bad or stale intents are rejected; old held fire expires',()=>{\n  const w=playing();assert(\"'!w.setIntent(9,S.neutral(1)));assert(!w.setIntent(0,{...S.neutral(1),mx:NaN}));assert(!w.setIntent(0,{...S.neutral(1),mx:1,my:1}));\n  assert(w.setIntent(0,{...S.neutral(5),fire:true}));assert(!w.setIntent(0,S.neutral(5)));step(w,61);const fired=w.s.events.filter(e=>e.type==='\"'shot').length;step(w,80);assert.equal(w.s.events.filter(e=>e.type==='shot').length,fired);\n});\ncheck('transition cleanup, finite tuning and restart produce clean state',()=>{\n  const w=playing();w.spawn('hunter',400,120);w.shot(1,1,0,10,true);w.retreat(false,'test');assert.equal(w.s.enemies.length,0);assert.equal(w.s.shots.length,0);assert.equal(w.intents.size,0);\n  assert(\"'!w.balance('\"'gravity',Infinity));w.balance('gravity',90000);assert.equal(w.s.balance.gravity,420);assert(w.s.modified);w.resetBalance();assert.deepEqual(w.s.balance,S.DEFAULTS);\n  const fresh=new S.World();assert(\"'!fresh.s.modified);assert.equal(fresh.s.tick,0);assert.equal(fresh.s.enemies.length,0);\n});\ncheck('\"'ground aim stays in the legal upper arc',()=>{\n  for(const a of [-Math.PI,-1.5,-.01,0,.2,1.5,3]){const q=S.groundAim(a);assert(q<=-.15&&q>=-Math.PI+.15);}\n});\ncheck('native renderer and alternate draw rates cannot change gameplay',()=>{\n  vm.runInThisContext(readFileSync(new URL('../vendor/engine/my-3d2dge.js',import.meta.url),'utf8'),{filename:'engine'});\n  for(const file of ['render/assets','render/scene'])vm.runInThisContext(readFileSync(new URL('../src/'+file+'.js',import.meta.url),'utf8'),{filename:file});\n  const E=globalThis.My3D2dge,a=new S.World({seed:4}),b=new S.World({seed:4});\n  const game=new E.Game({headless:true,draw:true,res:[960,540],expand:false,view:'overhead',loop:false,menu:false});const paint=new S.Painter(game);\n  game.cam.smooth=0;game.focus(480,270,0);game.start({update(){for(const p of a.s.players)a.setIntent(p.id,S.botIntent(a,p.id,p.seq+1));a.step();},draw(r){paint.draw(r,a.s,game.time);}});\n  for(let i=0;i<1200;i++){game.advance(S.DT,{draw:i%4===0});for(const p of b.s.players)b.setIntent(p.id,S.botIntent(b,p.id,p.seq+1));b.step();}\n  assert.deepEqual(game.errors,[]);assert.deepEqual(a.snapshot(),b.snapshot());game.dispose();\n});\nexport const simulationResults=results;\nif(process.argv[1]?.endsWith('simulation.mjs'))console.log(JSON.stringify(results));\nEOF\ncat > tools/verify.mjs <<'EOF'\nimport {spawnSync} from 'node:child_process';\nimport {fileURLToPath} from 'node:url';\nimport path from 'node:path';\nconst root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');\nconst selected=process.argv.slice(2),suites=selected.length?selected:['simulation','browser','hub'];\nlet passed=0,failed=0;\nfor(const suite of suites){\n const args=suite==='simulation'?['tests/simulation.mjs']:['tests/browser_checks.py',suite];\n const cmd=suite==='simulation'?process.execPath:'/home/micha/.local/share/pipx/venvs/playwright/bin/python';\n const result=spawnSync(cmd,args,{cwd:root,encoding:'utf8',maxBuffer:10*1024*1024});\n try{const tests=JSON.parse(result.stdout.trim());for(const t of tests){if(t.pass)passed++;else{failed++;console.error(\"'`FAIL ${suite}: ${t.name}'\"\\\\n\"'${t.error||t.detail}`);}}if(result.status&&tests.every(t=>t.pass)){failed++;console.error(`FAIL ${suite}: ${result.stderr}`);}}\n catch{failed++;console.error(`FAIL ${suite}: ${result.stdout}'\"\\\\n\"'${result.stderr}`);}\n}\nconsole.log(`${passed} checks passed; ${failed} failed.`);process.exitCode=failed?1:0;\nEOF\nnode tools/verify.mjs simulation'","aggregated_output":"FAIL simulation: 1-pilot no-cheat complete victory with upgrade branch 1\nAssertionError [ERR_ASSERTION]: {\"won\":false,\"reason\":\"GROUND BASE LOST\",\"score\":97860,\"rank\":\"STAR MARSHAL\",\"time\":615,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800}],\"modified\":false}\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:19:29\n    at check (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:7:29)\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:18:56\n    at ModuleJob.run (node:internal/modules/esm/module_job:561:25)\n    at async node:internal/modules/esm/loader:647:26\n    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:101:5)\nFAIL simulation: 1-pilot no-cheat complete victory with upgrade branch 2\nAssertionError [ERR_ASSERTION]: {\"won\":false,\"reason\":\"GROUND BASE LOST\",\"score\":97780,\"rank\":\"STAR MARSHAL\",\"time\":621,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800}],\"modified\":false}\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:19:29\n    at check (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:7:29)\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:18:56\n    at ModuleJob.run (node:internal/modules/esm/module_job:561:25)\n    at async node:internal/modules/esm/loader:647:26\n    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:101:5)\nFAIL simulation: 2-pilot no-cheat complete victory with upgrade branch 1\nAssertionError [ERR_ASSERTION]: {\"won\":false,\"reason\":\"GROUND BASE LOST\",\"score\":99560,\"rank\":\"STAR MARSHAL\",\"time\":614,\"outcomes\":[{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800},{\"held\":true,\"reason\":\"CORRIDOR SECURED\",\"score\":1800}],\"modified\":false}\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:19:29\n    at check (file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:7:29)\n    at file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-max.build-v2__20261106-022731__x3f6200/work/Space-Fortnight-Space-Fortress-gpt-6.1-sol-max-20261106-022731/tests/simulation.mjs:18:56\n    at ModuleJob.run (node:internal/modules/esm/module_job:561:25)\n    at async node:internal/modules/esm/loader:647:26\n    at async asyncRunEntryPointWithES