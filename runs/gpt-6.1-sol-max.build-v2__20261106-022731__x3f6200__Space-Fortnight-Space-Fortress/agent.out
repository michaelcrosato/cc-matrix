{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"rg -n 'ROCKS|const rocks|function rocks|thrust' vendor/engine/kits/arcade.js | tail -35 && rg -n '\"'^class Shell|''^class Menu|class Audio|class Game|class Input|bus'\"\\\\(|lastDevice' vendor/engine/my-3d2dge.js | head -40 && rg -n 'shell\\\\.|Shell\\\\(|screens:|rows:' vendor/engine/API-INDEX.md | tail -35\"","aggregated_output":"170: *   ROCKS (#arcade/rocks): turn, thrust and drift through a field of rocks that split when shot; the screen's edges meet\n174: * drawn by code. Keys: arrows / WASD, Space / Z / J fire (rocks: up thrusts, X / K hyperspace), Enter start, C classic.\n180:  const KEYS = Object.assign({}, E.Input.SHMUP, { thrust: ['Pad2', 'Pad5'], warp: ['KeyX', 'KeyK', 'ShiftLeft', 'Mouse2', 'Pad1', 'Pad6'], classic: ['KeyC', 'Pad3'] });\n529:  /* =================================== 3. ROCKS =================================== */\n530:  const ROCKS = (() => {\n537:    function begin(c, isDemo) { cab = c; demo = !!isDemo; wave = 0; over = false; shots = []; saucer = null; sparks = []; deadT = 0; readyT = 1.2; ship = { cool: 0, thrust: false }; layout(); home();  [... omitted end of long line]\n545:      if (live) {   // turn, thrust (and drift: a little drag), fire, hyperspace (a one-in-ten chance it goes wrong)\n546:        const turn = demo ? botTurn() : I.move()[0], thr = demo ? botThrust() : I.down('up') || I.down('thrust') || I.move()[1] < -.6;\n547:        ship.a += turn * 4.4 * dt; ship.thrust = thr;\n576:    // threat: turn across its way and thrust out of it (hyperspace when it is a quarter second off); else brake when\n615:        if (deadT <= 0 && (readyT <= 0 || Math.floor(readyT * 8) % 2)) { vec([[8, 0], [-6, -5], [-3, 0], [-6, 5]], ship.x, ship.y, ship.a, '#ffffff'); if (ship.thrust && Math.floor(game.time * 30) % 2 [... omitted end of long line]\n623:      id: 'rocks', label: 'ROCKS', res: [320, 240], about: 'TURN, THRUST, SPLIT THE ROCKS'