ance(name, value);\n\t\t\t}\n\t\t}\n\t\ttitle() {\n\t\t\tthis.lastPhase = \"\";\n\t\t\tthis.shell.hide();\n\t\t\tthis.shell.show(\"title\", {\n\t\t\t\tname: \"Space Fortnight\",\n\t\t\t\tsubtitle: \"Three lines. One last stand.\",\n\t\t\t\tactions: [\n\t\t\t\t\t[\"Play solo\", () => this.app.startSolo()],\n\t\t\t\t\t[\"Couch co-op\", () => this.join()],\n\t\t\t\t\t[\"Settings\", () => this.shell.show(\"settings\")],\n\t\t\t\t\t[\"About / Credits\", () => this.about()],\n\t\t\t\t],\n\t\t\t\tfooter: () =>\n\t\t\t\t\t`BEST ${String(this.app.best).padStart(7, \"0\")}  /  1–4 PILOTS`,\n\t\t\t});\n\t\t\tdocument.body.dataset.screen = \"title\";\n\t\t\tthis.radio.hidden = true;\n\t\t\tthis.prompt.hidden = true;\n\t\t}\n\t\tjoin() {\n\t\t\tthis.app.mode = \"join\";\n\t\t\tthis.app.enableJoin(true);\n\t\t\tthis.shell.show(\"join\", {\n\t\t\t\tkicker: \"SHARED SCREEN / 2–4 PILOTS\",\n254:\t\t\t\t\tthis.shell.backToTitle?.() || this.app.title();\n281:\t\t\t\ttext: \"An original siege inspired by Space Fortress (Century Electronics / CVS, 1981). Standalone co-op shares one screen; online co-op runs through AI Hub.\",\n\t\t\t\t\t\t\tp.hit > 0 && !this.game.settings.reducedFlashes\n\t\t\t\t\t\t\t\t? \"#fff6d8\"\n\t\t\t\t\t\t\t\t: null,\n\t\t\t\t\t},\n\t\t\t\t);\n\t\t\t\tr.overlay((g) => {\n\t\t\t\t\tif (\n\t\t\t\t\t\tp.inv > 0 &&\n\t\t\t\t\t\t(this.game.settings.reducedFlashes || Math.floor(t * 10) % 2 === 0)\n\t\t\t\t\t)\n\t\t\t\t\t\tring(g, xx, yy, 27, \"#9edcd6\", 1);\n\t\t\t\t\ttxt(g, String(i + 1).padStart(2, \"0\"), xx + 27, yy - 15, p.color, 1);\n\t\t\t\t\tpx.rect(g, xx - 14, yy + 28, 28, 3, \"#1b3343\");\n\t\t\t\t\tpx.rect(\n\t\t\t\t\t\tg,\n\t\t\t\t\t\txx - 14,\n\t\t\t\t\t\tyy + 28,\n\t\t\t\t\t\t(28 * p.energy) / p.maxEnergy,\n\t\t\t\t\t\t3,\n\t\t\t\t\t\tp.color,\n\t\t\t\t\t);\n\t\t\t\t\tif (p.pulse <= 0) {\n\t\t\t\t\t\tpx.rect(g, xx - 3, yy + 33, 6, 2, \"#dce8bd\");\n\t\t\t\t\t} else\n\t\t\t\t\t\tpx.rect(\n\t\t\t\t\t\t\tg,\n\t\t\t\t\t\t\txx - 3,\n\t\t\t\t\t\t\tyy + 33,\n\t\t\t\t\t\t\t6 *\n\t\t\t\t\t\t\t\t(1 -\n\t\t\t\t\t\t\t\t\tp.pulse /\n\t\t\t\t\t\t\t\t\t\t(s.balance.pulseCooldown *\n\t\t\t\t\t\t\t\t\t\t\tMath.pow(0.75, p.upgrades.pulse))),\n\t\t\t\t\t\t\t2,\n\t\t\t\t\t\t\t\"#69898f\",\n\t\t\t\t\t\t\t1,\n\t\t\t\t\t\t);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tif (s.modified) txt(g, \"MODIFIED RUN\", 929, 518, \"#b6a0c6\", 1, \"right\");\n\t\t\t});\n\t\t}\n\t}\n\tObject.assign(S, { Painter, fortress, siege, ring, panel, txt, C });\n})(globalThis.Fortnight);\n","exit_code":0,"status":"completed"}}
