{"type":"item.started","item":{"id":"item_128","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,80p' tests/simulation.mjs && sed -n '100,128p' tests/simulation.mjs && rg -n '4-pilot|fullRun|upgrades\\\\[' tests/simulation.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_128","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,80p' tests/simulation.mjs && sed -n '100,128p' tests/simulation.mjs && rg -n '4-pilot|fullRun|upgrades\\\\[' tests/simulation.mjs\"","aggregated_output":"import assert from \"node:assert/strict\";\nimport { readFileSync } from \"node:fs\";\nimport vm from \"node:vm\";\nimport { loadSim } from \"../tools/sim-loader.mjs\";\nconst S = loadSim();\nconst results = [];\nfunction check(name, fn) {\n\ttry {\n\t\tfn();\n\t\tresults.push({ name, pass: true });\n\t} catch (e) {\n\t\tresults.push({ name, pass: false, error: e.stack });\n\t}\n}\nfunction step(w, n, bot = false, choice = 0) {\n\tfor (let i = 0; i < n && !w.s.result; i++) {\n\t\tif (bot)\n\t\t\tfor (const p of w.s.players) {\n\t\t\t\tw.setIntent(p.id, S.botIntent(w, p.id, p.seq + 1));\n\t\t\t\tif (w.s.phase === \"upgrade\") w.upgrade(p.id, choice);\n\t\t\t}\n\t\tw.step();\n\t}\n}\nfunction playing(options = {}) {\n\tconst w = new S.World(options);\n\tw.s.phase = \"play\";\n\treturn w;\n}\nfunction fullRun(n, choice, seed = 198113) {\n\tconst w = new S.World({\n\t\tseed,\n\t\tplayers: Array.from({ length: n }, (_, id) => ({ id, name: \"BOT \" + id })),\n\t});\n\tstep(w, 100000, true, choice);\n\treturn w;\n}\ncheck(\"authored data validates and missing definitions are rejected\", () => {\n\tassert.deepEqual(S.validateWaves(), []);\n\tconst bad = structuredClone(S.WAVES);\n\tbad[0].groups[0].kind = \"absent\";\n\tassert(S.validateWaves(bad).length > 0);\n\tconst extra = structuredClone(S.WAVES[0]);\n\textra.title = \"ADDED DATA BEAT\";\n\textra.groups[0].at = 4;\n\tassert.deepEqual(S.validateWaves([extra]), []);\n});\nfor (const [n, choice] of [\n\t[1, 0],\n\t[1, 1],\n\t[1, 2],\n\t[2, 1],\n\t[4, 2],\n])\n\tcheck(\n\t\t`${n}-pilot no-cheat complete victory with upgrade branch ${choice}`,\n\t\t() => {\n\t\t\tconst w = fullRun(n, choice);\n\t\t\tassert(w.s.result?.won, JSON.stringify(w.s.result));\n\t\t\tassert.equal(w.s.modified, false);\n\t\t\tassert.equal(w.s.options.god, false);\n\t\t\tassert.equal(w.s.upgrades, 2);\n\t\t\tassert.deepEqual(new Set(w.s.seen), new Set(Object.keys(S.ENEMIES)));\n\t\t\tassert.deepEqual(w.s.bossPhases, [0, 1, 2]);\n\t\t\tassert(\n\t\t\t\tw.s.activeTime >= 590 && w.s.activeTime < 760,\n\t\t\t\t`Active time ${w.s.activeTime}`,\n\t\t\t);\n\t\t\tassert(w.s.base > 0);\n\t\t\tassert.equal(w.s.outcomes.length, 3);\n\t\t\tassert(w.s.score > 14000);\n\t\t\tfor (const p of w.s.players)\n\t\t\t\tassert.equal(p.upgrades[S.UPGRADES[choice].id], 2);\n\t\t},\n\t);\ncheck(\"an unattended wing retreats twice and reaches real defeat\", () => {\n\tconst w = new S.World({ seed: 23 });\n\tstep(w, 110000);\n\tassert.equal(w.s.result?.won, false);\n\tassert.equal(w.s.act, 2);\n\t\tstep(b, 4000, true);\n\t\tassert.deepEqual(a.snapshot(), b.snapshot());\n\t},\n);\ncheck(\"empty boost leaves thrust and laser functional\", () => {\n\tconst w = playing();\n\tconst p = w.s.players[0];\n\tp.energy = 0;\n\tp.inv = 0;\n\tw.setIntent(0, {\n\t\tseq: 1,\n\t\tmx: 1,\n\t\tmy: 0,\n\t\tax: 0,\n\t\tay: -1,\n\t\tfire: true,\n\t\tboost: true,\n\t\tpulse: false,\n\t});\n\tstep(w, 25);\n\tassert(p.x > 360);\n\tassert(w.s.shots.some((b) => !b.foe));\n\tassert.equal(p.boost, 0);\n\tassert(p.energy >= 0);\n});\ncheck(\n\t\"pulse clears only local hostile projectiles and breaks a tractor\",\n\t() => {\n\t\tconst w = playing(),\n30:function fullRun(n, choice, seed = 198113) {\n58:\t\t\tconst w = fullRun(n, choice);\n73:\t\t\t\tassert.equal(p.upgrades[S.UPGRADES[choice].id], 2);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_129","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/browser_checks.py');s=p.read_text().replace('__fortnight.blockInputUntil=0;__fortnight.startSolo()', '__fortnight.blockInputUntil=0;__fortnight.startSolo();__game.advance(.01);__game.debug.advance(4,{draw:false})')\np.write_text(s)\np=Path('tests/simulation.mjs');s=p.read_text().replace('import { readFileSync } from \\\"node:fs\\\";','import { readFileSync, writeFileSync } from \\\"node:fs\\\";')\ns=s.replace('const S = loadSim();','const S = loadSim();\\\\nvm.runInThisContext(readFileSync(new URL(\\\"../src/online.js\\\",import.meta.url),\\\"utf8\\\"),{filename:\\\"online-packet-contract\\\"});')\ns=s.replace('function step(w, n, bot = false, choice = 0) {','function step(w, n, bot = false, choice = 0, inspect) {').replace('\\\\t\\\\tw.step();\\\\n\\\\t}\\\\n}', '\\\\t\\\\tw.step();if(inspect && i%12===0)inspect(w);\\\\n\\\\t}\\\\n}',1)\nneedle='\\\\tstep(w, 100000, true, choice);\\\\n\\\\treturn w;'\nnew='''    let inspect;\n    if(n===4){\n        const wire=Object.create(S.Online.prototype);Object.assign(wire,{app:{world:w},lastShot:0,maxRoutineBytes:0,lastFull:0});\n        w.packetStats={routineMax:0,completeMax:0,reliableMax:0,chunksMax:0};\n        inspect=world=>{\n            wire.routine();w.packetStats.routineMax=wire.maxRoutineBytes;\n            const text=S.encodeWorld(world.s),chunks=Math.ceil(text.length/4000);w.packetStats.completeMax=Math.max(w.packetStats.completeMax,new TextEncoder().encode(text).length);w.packetStats.chunksMax=Math.max(w.packetStats.chunksMax,chunks);\n            for(let i=0;i<chunks;i++)w.packetStats.reliableMax=Math.max(w.packetStats.reliableMax,new TextEncoder().encode(JSON.stringify({t:\\\"k\\\",e:1,id:1,n:chunks,i,v:text.slice(i*4000,(i+1)*4000)})).length);\n        };\n    }\n    step(w,100000,true,choice,inspect);\n    return w;'''\nif needle not in s:raise Exception('full run test marker')\ns=s.replace(needle,new)\nneedle='''\t\t\tassert(w.s.score > 14000);'''\ns=s.replace(needle,needle+'''\n            if(n===4){assert(w.packetStats.routineMax<=1200);assert(w.packetStats.reliableMax<16384);assert(w.packetStats.chunksMax<=12);writeFileSync(new URL(\\\"../evidence/packet-budget.json\\\",import.meta.url),JSON.stringify(w.packetStats,null,2)+\\\"\\\\\\\\n\\\");}''')\np.write_text(s)\np=Path('docs/testing.md');s=p.read_text().replace('Every routine packet is asserted', 'The four-pilot full-campaign packet maxima are recorded separately in evidence/packet-budget.json. Every routine packet is asserted');p.write_text(s)\nPY\nbiome check --write --linter-enabled=false --assist-enabled=false src tools/*.mjs tests/simulation.mjs package.json\nruff check tests/browser_checks.py tools/*.py\nruff format tests/browser_checks.py\nnpm run build\nnpm run verify\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
