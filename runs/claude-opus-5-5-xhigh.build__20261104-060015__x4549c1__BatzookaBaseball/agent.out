label: 'DERBY', id: 'derby' },\n      { label: 'TRAINING', id: 'training' }, { label: 'OPTIONS', id: 'options' }, { label: 'ABOUT', id: 'about' }\n    ], { start: hasSave ? 0 : 1, cols: 2 });\"\"\"\nassert s.count(old)==1; s=s.replace(old,new)\nold=\"\"\"      const ly = Math.max(8, r.H * .07);\n      BZ.title(g, r, ly, r.W > 380 ? 4 : 3);\n      // a rocket trail sweeping under the logo\n      const k = (t * .5) % 1.4; if (k < 1) px.blend(g, .8, 'add', () => { for (let i = 0; i < 14; i++) { const x = r.W * (k - i * .012), y = ly + 70 - i * .5; px.disc(g, x, y, 3 - i * .18, i < 4 ? '#fff6c0' : '#ff7a1a'); } });\n      if (BZ.touchOnly) { this.touchCard(g, r); return; }\n      const top = ly + 78;\n      if (this.sub) this.sub.draw(g, r, r.W / 2, top + 20, { w: 170, h: 22 });\n      else if (BZ.playbook.on) BZ.playbook.draw(g, r);\n      else this.menu.draw(g, r, r.W / 2, top, { w: 170, h: Math.min(20, (r.H - top - 40) / 7 - 4), gap: 4 });\"\"\"\nnew=\"\"\"      const ly = Math.max(8, r.H * .05), big = r.H > 300 && r.W > 480;\n      BZ.title(g, r, ly, big ? 4 : 3);\n      // a rocket trail sweeping under the logo\n      const k = (t * .5) % 1.4, ty = ly + (big ? 70 : 54); if (k < 1) px.blend(g, .8, 'add', () => { for (let i = 0; i < 14; i++) { const x = r.W * (k - i * .012), y = ty - i * .5; px.disc(g, x, y, 3 - i * .18, i < 4 ? '#fff6c0' : '#ff7a1a'); } });\n      if (BZ.touchOnly) { this.touchCard(g, r); return; }\n      const top = ty + 8;\n      if (this.sub) this.sub.draw(g, r, r.W / 2, top + 10, { w: 170, h: 22 });\n      else if (BZ.playbook.on) BZ.playbook.draw(g, r);\n      else this.menu.draw(g, r, r.W / 2, top, { w: Math.min(140, (r.W - 30) / 2), h: 20, gap: 4 });\"\"\"\nassert s.count(old)==1; s=s.replace(old,new)\nopen(p,'w',encoding='utf-8').write(s)\nEOF\ngrep -n \"'…'\\|…\" src/*.js | head; sed -i \"s/Joining the round…/Joining the round.../; s/'Starting…'/'Starting...'/; s/'Waiting for more time…'/'Waiting for more time...'/\" src/90-start.js src/40-