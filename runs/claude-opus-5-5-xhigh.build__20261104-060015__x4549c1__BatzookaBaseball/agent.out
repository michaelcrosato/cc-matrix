tring":"BZ.layer = (name, vol, fade = .8) => {\n  const A = BZ.game && BZ.game.audio, S = BZ.SONGS[BZ.musicName]; if (!A || !A.song || !S || !S.tracks.some(t => t.name === name)) return;\n  try { A.layer(name, vol, fade); } catch (e) { /* the song may not have it */ }\n};"}}}
