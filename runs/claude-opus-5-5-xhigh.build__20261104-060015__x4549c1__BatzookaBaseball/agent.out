: M.inning, half: M.half, prev });\n  },\n  /** stats line for the box: AVG etc. */\n  avg(s) { return s.AB ? (s.H / s.AB).toFixed(3).replace(/^0/, '') : '.000'; }\n};\n","structuredPatch":[{"oldStart":73,"oldLines":8,"newStart":73,"newLines":6,"lines":["     const O = BZ.offense(M); O.runs++; M.play.runs.push({ id: runner.id, t: M.clock });","     BZ.statFor(M, runner).R++; if (rbiTo) BZ.statFor(M, rbiTo).RBI++;","     const inn = M.inning - 1; O.line[inn] = (O.line[inn] || 0) + 1;","-    const before = M.teams[0].runs - (M.half === 'top' ? 1 : 0), after = M.teams[0].runs;","-    void before; void after;","     BZ.bus.emit('run', { runner, team: O.id, score: [M.teams[0].runs, M.teams[1].runs] });","     this.checkLead(M);","     if (this.walkoffNow(M)) { M.walkoff = true; BZ.bus.emit('walkoff', { team: O.id, runner }); }"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01N47LNXXfXpDJuhLiJRPYJU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
