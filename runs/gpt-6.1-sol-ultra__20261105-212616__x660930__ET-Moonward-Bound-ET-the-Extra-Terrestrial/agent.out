a=>{if(Math.hypot(a.x-friend.position.x,a.z-friend.position.z)<10)a.stunned=6});audio.sfx('pulse')}if(i.interact){i.interact=false;const old=body.translation();body.setTranslation({x:friend.position.x,y:1.25,z:friend.position.z},true);interact();body.setTranslation(old,true)}}\nworld.update(clockTime,dt);updateEffects(dt);updateTrail();}\nfunction updateEffects(dt){for(let i=effects.length-1;i>=0;i--){const e=effects[i];e.t+=dt;const f=e.t/e.duration;if(e.v){e.mesh.position.addScaledVector(e.v,dt);e.v.y-=dt*3;e.mesh.rotation.x+=dt*3}else e.mesh.scale.setScalar(lerp(.1,e.size,f));e.mesh.material.opacity=1-f;if(f>=1){scene.remove(e.mesh);e.mesh.geometry.dispose();e.mesh.material.dispose();effects.splice(i,1)}}}\nfunction updateTrail(){const p=body.translation();const target=phase==='scavenge'?world.targets.find(t=>\"'!inventory.includes(t.id)):phase==='\"'signal'?{x:0,z:-35}:null;trail.forEach((m,i)=>{m.visible=\"'!!target;if(target){const a=(i+1)/(trail.length+2);m.position.set(lerp(p.x,target.x,a),.2+Math.sin(clockTime*2+i)*.08,lerp(p.z,target.z,a));m.scale.setScalar(.7+Math.sin(clockTime*3+i*.5)*.2)}})}\nfunction snapshot(){return{mode,phase,bond,inventory,flowersHealed,stars,pulses,elapsed,alert,flightDistance,players:players.map(p=>({x:p.position.x,y:p.position.y,z:p.position.z,r:p.rotation.y,visible:p.visible})),alien:{x:alien.position.x,y:alien.position.y,z:alien.position.z},flowers:world.flowers.map(f=>f.healed),candies:world.candies.map(c=>c.collected),hoops:world.hoops.map(h=>h.collected)}}\nfunction applySnapshot(s){if(!ready||authority())return;phase=s.phase;bond=s.bond;inventory=s.inventory;flowersHealed=s.flowersHealed;stars=s.stars;pulses=s.pulses;elapsed=s.elapsed;alert=s.alert;flightDistance=s.flightDistance;if(mode==='\"'title'&&s.mode==='play'){mode='play';showScreen(null);\"'$('\"'hud').classList.remove('hidden')}if(s.mode==='win'&&mode\"'!=='\"'win')winGame();s.players?.forEach((p,i)=>{if(players[i]){players[i].position.set(p.x,p.y,p.z);players[i].rotation.y=p.r;players[i].visible=p.visible;if(i===0)body.setTranslation({x:p.x,y:p.y+.9,z:p.z},true)}});if(s.alien)alien.position.set(s.alien.x,s.alien.y,s.alien.z);world.targets.forEach(t=>t.mesh.visible=\"'!inventory.includes(t.id));s.flowers?.forEach((v,i)=>world.flowers[i].healed=v);s.candies?.forEach((v,i)=>{world.candies[i].collected=v;world.candies[i].mesh.visible=!v});s.hoops?.forEach((v,i)=>{world.hoops[i].collected=v;world.hoops[i].mesh.visible=!v});updateHUD()}\nfunction updateCamera(dt){if(!body)return;const hero=!authority()&&players[1].visible?players[1]:players[0],p=hero.position;let target,look;if(mode==='\"'title'){target=new THREE.Vector3(21,15,32);look=new THREE.Vector3(-1,1,-4)}else if(phase==='flight'){target=new THREE.Vector3(p.x*.6+1,p.y+8,p.z+19);look=new THREE.Vector3(p.x,p.y+1,p.z-13)}else if(mode==='win'){target=new THREE.Vector3(13,11,-210);look=new THREE.Vector3(0,4,-235)}else{target=new THREE.Vector3(p.x+Math.sin(cameraAngle)*22,p.y+19,p.z+Math.cos(cameraAngle)*22);look=new THREE.Vector3(p.x,1.2,p.z-4)}camera.position.lerp(target,Math.min(1,dt*3));camera.lookAt(look)}\nfunction frame(now){if(\"'!ready)return;const dt=Math.min((now-lastFrame)/1000||.016,.06);lastFrame=now;const controls=readInput(dt);input.sneak=controls.sneak;if(mode==='\"'title'&&\"'!network.hubActive){titleIdle+=dt;world.update(clockTime+=dt,dt);alien.userData.mixer.update(dt*.2);if(titleIdle>=10)startGame({demo:true})}if(mode==='\"'play'&&(\"'!network.hubActive||network.running)){if(authority()){const c=attract?autoInput(dt):controls;accumulator+=dt;let count=0;while(accumulator>=1/60&&count++<4){simulate(1/60,c);accumulator-=1/60}network.broadcast(snapshot())}else{network.sendInput({...controls,interact:false,pulse:false});world.update(clockTime+=dt,dt);players.forEach(p=>p.userData.mixer.update(dt));}}else if(mode==='\"'signal'){updateSignal(dt);if(attract&&signalReady){attractTimer+=dt;if(attractTimer>.5){submitNote(pattern[signalIndex]);attractTimer=0}}}else if(mode==='win'){winTimer+=dt;world.update(clockTime+=dt,dt);if(attract&&winTimer>5)startGame({demo:true})}if(dialogueTimer>0){dialogueTimer-=dt;if(dialogueTimer<=0)\"'$('\"'dialogue').classList.add('hidden')}if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)\"'$('\"'toast').classList.add('hidden')}audio.update(dt);updateCamera(dt);if(mode==='play')updateHUD();renderer.render(scene,camera);requestAnimationFrame(frame)}let lastFrame=performance.now();\nasync function init(){try{await RAPIER.init();physics=new RAPIER.World({x:0,y:-18,z:0});scene=new THREE.Scene();scene.background=new THREE.Color(0x15283d);scene.fog=new THREE.Fog(0x15283d,65,155);camera=new THREE.PerspectiveCamera(48,innerWidth/innerHeight,.1,400);camera.position.set(21,15,32);renderer=new THREE.WebGPURenderer({canvas:\"'$('\"'world'),antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.2;await renderer.init();const data=new Uint8Array([65,135,205,255]);gradient=new THREE.DataTexture(data,4,1,THREE.RedFormat);gradient.needsUpdate=true;gradient.minFilter=gradient.magFilter=THREE.NearestFilter;world=buildWorld(THREE,scene,physics,{RAPIER,gradient});const ground=physics.createRigidBody(RAPIER.RigidBodyDesc.fixed());physics.createCollider(RAPIER.ColliderDesc.cuboid(75,.2,180).setTranslation(0,-.2,-100),ground);body=physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,1.25,18).lockRotations().setLinearDamping(6).setCcdEnabled(true));physics.createCollider(RAPIER.ColliderDesc.capsule(.4,.46).setFriction(0).setRestitution(0),body);players=[makeCharacter(),makeCharacter(false,0x79a9a2)];players.forEach(p=>scene.add(p));players[1].visible=false;players[1].position.set(-2,.1,19);alien=makeCharacter(true);scene.add(alien);for(let i=0;i<12;i++){const m=new THREE.Mesh(new THREE.OctahedronGeometry(.075),new THREE.MeshBasicMaterial({color:0xffd789}));scene.add(m);trail.push(m)}teleport(0,18);renderCredits(\"'$('\"'credits-content'));for(const [id,value] of Object.entries({music:settings.music??10,sfx:settings.sfx??75,camera:Math.round((settings.cameraSensitivity??1)*100)})){\"'$(id).value=value;$(id).dispatchEvent(new Event('\"'input'))}glyphs=settings.glyphs||'ps';captions=settings.captions??true;\"'$('\"'glyph-toggle').textContent=glyphs==='ps'?'PlayStation':'Xbox';\"'$('\"'captions-toggle').textContent=captions?'On':'Off';try{if(localStorage.getItem('moonward-save'))\"'$('\"'continue-button').classList.remove('hidden')}catch{}ready=true;await network.connect();network.ready();\"'$('\"'loading').classList.add('hidden');if(\"'!network.hubActive){showScreen('\"'title');}else{mode='waiting';showScreen(null)}updatePrompts();requestAnimationFrame(frame);window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});}catch(error){console.error(error);\"'$('\"'loading-message').textContent='This little world could not start: '+error.message;const b=document.createElement('button');b.className='pill';b.textContent='Try again';b.onclick=()=>location.reload();\"'$('\"'loading').append(b);}}\nwindow.__game={getState:()=>({ready,mode,phase,attract,lastInput,inputMode:lastInput,player:body?body.translation():null,inventory:[...inventory],bond,alert,stars,flowersHealed,pulses,pulseCooldown,signalReady,signalIndex,pattern:[...pattern],flightDistance,elapsed,balance:{...balance},god,targets:world?.targets.map(({id,name,x,z})=>({id,name,x,z})),flowers:world?.flowers.map(({x,z,healed})=>({x,z,healed})),hoops:world?.hoops.map(({x,y,z,collected})=>({x,y,z,collected})),network:network.info}),start:startGame,advance(seconds){for(let t=0;t<seconds;t+=1/60){if(mode==='play')simulate(1/60,{x:0,z:0,sneak:false,lift:phase==='flight'});else if(mode==='signal')updateSignal(1/60);else if(mode==='title'){titleIdle+=1/60;if(titleIdle>=10)startGame({demo:true})}}updateHUD()},teleport,interact,pulse,dev:devAction,submitNote,beginSignal,beginFlight,pause,resume,toTitle,renderInfo:()=>({backend:renderer?.backend?.isWebGPUBackend?'WebGPU':'WebGL2',three:THREE.REVISION,rapier:RAPIER.version(),animationMixers:players.length+1,drawCalls:renderer?.info?.render?.calls}),audioDebug:()=>audio.debug(),audio,network,snapshot};\ninit();\nEOF\nnode --check main.js\"","aggregated_output":"(node:571017) Warning: Failed to load the ES module: /home/micha/dev/cc-matrix/runs/gpt-6.1-sol-ultra__20261105-212616__x660930/work/ET-Moonward-Bound-ET-the-Extra-Terrestrial-gpt-6.1-sol-ultra-20261105-212616/main.js. Make sure to set \"type\": \"module\" in the nearest package.json file or use the .mjs extension.\n(Use `node --trace-warnings ...` to show where the warning was created)\n/home/micha/dev/cc-matrix/runs/gpt-6.1-sol-ultra__20261105-212616__x660930/work/ET-Moonward-Bound-ET-the-Extra-Terrestrial-gpt-6.1-sol-ultra-20261105-212616/main.js:1\nimport * as THREE from 'three/webgpu';\n^^^^^^\n\nSyntaxError: Cannot use import statement outside a module\n    at wrapSafe (node:internal/modules/cjs/loader:1861:18)\n    at checkSyntax (node:internal/main/check_syntax:88:3)\n\nNode.js v24.21.0\n","exit_code":1,"status":"failed"}}
