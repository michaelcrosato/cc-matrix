   const u=i/5,ry=4.85+u*2.8,rx=(1-u)*4.6;\n      line([[-rx,ry,-4.13],[-rx,ry,4.13]],0x293342,h);line([[rx,ry,-4.13],[rx,ry,4.13]],0x293342,h);\n    }\n46:  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n66:import { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\n79:for (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n102:      session: meta('hub:session'),\n103:      players: meta('hub:session-players'),\n104:      mode: meta('hub:session-mode'),\n105:      minutes: meta('hub:session-minutes'),\n125:  url.searchParams.set('aihub', '1');\n126:  if (seedsRandom(tag)) url.searchParams.set('aihub-seed', String(seed >>> 0));\n138:/** Wrap what a game must not call in hub mode, where the page can reach it. */\n167:  const n = Math.max(1, Math.min(4, Number($('players').value) || 2));\n173:  const players = Array.from({ length: n }, (_, slot) => ({ key: `p${slot}`, slot, name: NAMES[slot] }));\n174:  const hubEnd = net.endpoint('hub');\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n187:    players,\n","exit_code":0,"status":"completed"}}
