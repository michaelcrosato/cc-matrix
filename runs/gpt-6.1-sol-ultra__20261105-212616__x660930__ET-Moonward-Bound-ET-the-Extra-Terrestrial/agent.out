preventDefault();audio.unlock();if(rememberInput('keyboard'))return;keys.add(e.code);if(e.repeat)return;if(e.code==='Escape'){if(mode==='play'||mode==='signal')pause();else if(mode==='pause')resume();else if(mode\"'!=='\"'title')back();return}if(mode==='signal'){if(['Digit1','Digit2','Digit3'].includes(e.code))submitNote(+e.code.slice(-1)-1);return}if(mode==='play'){if(e.code==='KeyE')interact();if(e.code==='Space')pulse();}else if(['ArrowDown','ArrowUp'].includes(e.code))menuMove(e.code==='ArrowDown'?1:-1);else if(e.code==='Enter'){const active=document.activeElement;if(active?.tagName==='BUTTON')active.click();else if(mode==='title')startGame()}});\nwindow.addEventListener('keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();if(mode==='play'&&\"'!attract&&!network.hubActive)pause()});\nfunction menuMove(dir){const screen=document.querySelector('\"'.screen:not(.hidden)');if(\"'!screen)return;const buttons=[...screen.querySelectorAll('\"'button:not(:disabled), input[type=range]')].filter(e=>\"'!e.classList.contains('\"'hidden'));if(\"'!buttons.length)return;let i=buttons.indexOf(document.activeElement);setFocus(buttons[(i+dir+buttons.length)%buttons.length]);}\n$('\"'world').addEventListener('pointerdown',e=>{audio.unlock();if(rememberInput(e.pointerType==='touch'?'touch':'keyboard'))return;if(mode\"'!=='\"'play')return;if(e.pointerType==='touch'){if(e.clientX<innerWidth*.5){leftTouch={id:e.pointerId,x:e.clientX,y:e.clientY}}else rightTouch={id:e.pointerId,x:e.clientX,y:e.clientY};e.target.setPointerCapture(e.pointerId)}else pointerDown={x:e.clientX,y:e.clientY,lastX:e.clientX,moved:false};});\n\"'$('\"'world').addEventListener('pointermove',e=>{if(leftTouch?.id===e.pointerId){touchVector={x:clamp((e.clientX-leftTouch.x)/65,-1,1),z:clamp((e.clientY-leftTouch.y)/65,-1,1)}}else if(rightTouch?.id===e.pointerId){cameraAngle-=(e.clientX-rightTouch.x)*.007*cameraSensitivity;rightTouch.x=e.clientX}else if(pointerDown){const delta=e.clientX-point