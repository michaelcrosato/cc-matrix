 tube=(a,b)=>{const d=new THREE.Vector3(...b).sub(new THREE.Vector3(...a));const m=mesh(new THREE.CylinderGeometry(.045,.045,d.length(),7),frame,bike);m.position.copy(new THREE.Vector3(...a).add(new THREE.Vector3(...b)).multiplyScalar(.5));m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),d.normalize())};tube([0,.5,-.65],[0,1.2,-.2]);tube([0,1.2,-.2],[0,.55,.2]);tube([0,.55,.2],[0,.5,-.65]);tube([0,.55,.2],[0,1.1,.58]);tube([0,1.1,.58],[0,1.2,-.2]);tube([0,.48,.65],[0,1.4,.5]);mesh(new THREE.BoxGeometry(.65,.06,.07),metal,bike,[0,1.45,.5]);mesh(new THREE.BoxGeometry(.33,.08,.25),mats.dark,bike,[0,1.25,-.22]);const basket=mesh(new THREE.BoxGeometry(.65,.4,.52),toon(0xb8a27b),bike,[0,1.26,.94]);for(let k=0;k<4;k++)mesh(new THREE.BoxGeometry(.68,.025,.55),metal,bike,[0,1.14+k*.09,.94]);root.userData.basket=basket;}return root;}\nfunction spawnRing(x,y,z,color=0xffd28b,size=6){const ring=new THREE.Mesh(new THREE.RingGeometry(.85,1,48),new THREE.MeshBasicMaterial({color,transparent:true,opacity:.9,side:THREE.DoubleSide,depthWrite:false}));ring.rotation.x=-Math.PI/2;ring.position.set(x,y,z);scene.add(ring);effects.push({mesh:ring,t:0,duration:1,size});}\nfunction particleBurst(x,y,z,color=0xffd599,n=18){for(let i=0;i<n;i++){const m=new THREE.Mesh(new THREE.OctahedronGeometry(.07+Math.random()*.06),new THREE.MeshBasicMaterial({color,transparent:true}));m.position.set(x,y,z);scene.add(m);effects.push({mesh:m,t:0,duration:1.2,v:new THREE.Vector3((Math.random()-.5)*4,Math.random()*3+1,(Math.random()-.5)*4)})}}\nfunction teleport(x,z,y=1.25){body.setTranslation({x,y,z},true);body.setLinvel({x:0,y:0,z:0},true);players[0].position.set(x,y-.9,z);alien.position.set(x+.9,.1,z+1.5);clickTarget=null;}\nfunction saveCheckpoint(){if(attract)return;try{localStorage.setItem('\"'moonward-save',JSON.stringify({phase,inventory,bond,flowersHealed,stars}));\"'$('\"'continue-button').classList.remove('hidden')}catch{}}\nfunction startGame({resume=false,demo=false}={}){attract=demo;phase='scavenge';mode='play';bond=100;inventory=[];flowersHealed=0;stars=0;pulses=0;catchCount=0;alert=0;elapsed=0;pulseCooldown=0;flightDistance=0;attractStep=0;attractTimer=0;signalIndex=0;signalReady=false;showScreen(null);\"'$('\"'hud').classList.remove('hidden');\"'$('\"'attract-label').classList.toggle('hidden',\"'!demo);$('\"'dialogue').classList.add('hidden');body.setGravityScale(1,true);world.reset();world.targets.forEach(t=>t.mesh.visible=true);world.flowers.forEach(f=>{f.healed=false});world.candies.forEach(c=>{c.collected=false;c.mesh.visible=true});world.hoops.forEach(h=>{h.collected=false;h.mesh.visible=true});teleport(0,18);if(resume){try{const saved=JSON.parse(localStorage.getItem('moonward-save'));if(saved){inventory=saved.inventory||[];bond=Math.max(60,saved.bond||100);flowersHealed=saved.flowersHealed||0;world.targets.forEach(t=>t.mesh.visible=\"'!inventory.includes(t.id));phase=inventory.length===3?'\"'signal':'scavenge';if(saved.phase==='flight')beginFlight();else if(phase==='signal')teleport(0,-30)}}catch{}}audio.setMood('explore');audio.unlock();say('He’s a long way from home. We have until dawn.','THE KID',6);updatePrompts();updateHUD();}\nfunction toTitle(){if(network.hubActive)return;mode='title';attract=false;titleIdle=0;showScreen('title');\"'$('\"'hud').classList.add('hidden');\"'$('\"'dialogue').classList.add('hidden');\"'$('\"'attract-label').classList.add('hidden');teleport(0,18);cameraAngle=.42;audio.setMood('explore')}\nfunction endAttract(){attract=false;toTitle()}\nfunction nearestInteraction(){if(\"'!body||phase==='\"'flight')return null;const p=body.translation();const near=(t,d=3)=>Math.hypot(t.x-p.x,t.z-p.z)<d;if(phase==='scavenge'){const target=world.targets.find(t=>\"'!inventory.includes(t.id)&&near(t));if(target)return{kind:'\"'part',target,text:'Borrow '+target.name}}const flower=world.flowers.find(f=>\"'!f.healed&&near(f,2.8));if(flower)return{kind:'\"'flower',target:flower,text:'Make a little life glow'};if(inventory.length===3&&near({x:0,z:-35},4.5))return{kind:'signal',text:'Call the stars'};return null}\nfunction interact(){if(mode\"'!=='\"'play'||attract&&\"'!authority())return;audio.unlock();if(!authority()){network.sendInput({...readInput(0),interact:true,pulse:false});return}const nearby=nearestInteraction();if(!nearby)return;if(nearby.kind==='\"'part'){const t=nearby.target;inventory.push(t.id);t.mesh.visible=false;bond=clamp(bond+12,0,100);audio.sfx('pickup');particleBurst(t.x,1.8,t.z);toast(t.name+' borrowed · '+inventory.length+' / 3');const lines={radio:'“Borrowing,” you whisper. “We’ll bring it back. Mostly.”',battery:'A toy battery. A little power. A very big possibility.',dish:'A salad strainer. Don’t laugh. Space is full of surprises.'};say(lines[t.id]||'Every small thing can become something wonderful.','THE KID');if(inventory.length===3){phase='signal';say('All the pieces. Now we need somewhere the sky can hear us.','THE KID',7)}saveCheckpoint()}else if(nearby.kind==='flower'){nearby.target.healed=true;flowersHealed++;bond=clamp(bond+22,0,100);spawnRing(nearby.target.x,.2,nearby.target.z,0x9ee6bd,4);particleBurst(nearby.target.x,1,nearby.target.z,0x9fe3a6);audio.sfx('bond');say('A little kindness goes a long, long way.','THE KID',4);toast('A flower remembers how to bloom · +22 friendship')}else beginSignal();updateHUD()}\nfunction pulse(){if(mode\"'!=='\"'play')return;if(\"'!authority()){network.sendInput({...readInput(0),pulse:true,interact:false});return}if(phase==='\"'flight'){audio.sfx('jump');return}if(pulseCooldown>0){toast('Let the little light catch its breath.');return}if(bond<balance.pulseCost&&\"'!god){toast('\"'Stay close. Friendship will find its way back.');return}if(\"'!god&&!attract)bond-=balance.pulseCost;pulses++;pulseCooldown=3;const p=body.translation();spawnRing(p.x,.18,p.z,0x9eeacc,8);particleBurst(p.x,1.2,p.z,0xaaf1cd,25);audio.sfx('\"'pulse');world.agents.forEach(a=>{if(Math.hypot(a.x-p.x,a.z-p.z)<10)a.stunned=6});alert=Math.max(0,alert-45);updateHUD()}\nfunction beginSignal(){if(inventory.length\"'!==3)return;mode='\"'signal';showScreen('signal');signalIndex=0;signalTimer=0;signalShow=-1;signalReady=false;\"'$('\"'signal-seq').innerHTML=pattern.map(()=>'<span class=\\\"signal-dot\\\">·</span>').join('');\"'$('\"'signal-instruction').textContent='Listen to the little lights. Then send their song back.';audio.setMood('sneak');}\nfunction updateSignal(dt){signalTimer+=dt;if(\"'!signalReady){const i=Math.floor((signalTimer-.8)/.85);if(i>=0&&i<pattern.length&&i!==signalShow){signalShow=i;signalSound(pattern[i]);[...$('\"'signal-seq').children].forEach((e,j)=>{e.classList.toggle('lit',j===i);e.textContent=j===i?['◒','✦','☾'][pattern[i]]:'·'})}if(i>=pattern.length){signalReady=true;\"'$('\"'signal-instruction').textContent='Your turn. Send the lights back, one by one.';[...\"'$('\"'signal-seq').children].forEach((e,i)=>{e.classList.remove('lit');e.textContent=['◒','✦','☾'][pattern[i]]})}}document.querySelectorAll('[data-note]').forEach(b=>b.disabled=\"'!signalReady)}\nfunction submitNote(n){if(mode!=='\"'signal'||\"'!signalReady)return;signalSound(n);if(n===pattern[signalIndex]){$('\"'signal-seq').children[signalIndex].classList.add('lit');signalIndex++;if(signalIndex===pattern.length){toast('Someone out there was listening.');audio.sfx('launch');beginFlight();}}else{signalIndex=0;[...\"'$('\"'signal-seq').children].forEach(e=>e.classList.remove('lit'));\"'$('\"'signal-instruction').textContent='Almost. Try the four little symbols again. No hurry.';audio.voice('curious')}}\nfunction beginFlight(){phase='flight';mode='play';showScreen(null);\"'$('\"'hud').classList.remove('hidden');if(inventory.length<3){inventory=world.targets.map(t=>t.id);world.targets.forEach(t=>t.mesh.visible=false)}flightDistance=0;flightY=3;body.setGravityScale(0,true);teleport(0,-44,3);cameraAngle=0;audio.setMood('flight');say('Hold on. I think he has one more trick.','THE KID',6);spawnRing(0,.2,-44,0xffdb9e,12);saveCheckpoint();updatePrompts();}\nfunction winGame(){if(mode==='win')return;phase='complete';mode='win';winTimer=0;showScreen('win');\"'$('\"'hud').classList.add('hidden');\"'$('\"'dialogue').classList.add('hidden');audio.setMood('win');audio.sfx('win');\"'$('\"'win-stats').textContent=\"'`${stars} / ${world.hoops.length} starlight rings · ${flowersHealed} flowers awakened · One friend, safely home.`;if(!attract){try{localStorage.removeItem('\"'moonward-save');\"'$('\"'continue-button').classList.add('hidden')}catch{}}if(network.hubActive)network.finish(true,100+stars*10+flowersHealed*20);}\nfunction finishHub(){network.finish(phase==='complete',inventory.length*100+stars*10+flowersHealed*20)}\nfunction updateHUD(){if(\"'!world)return;const objective=phase==='\"'scavenge'?'A few things from around the block':phase==='signal'?'Find a place the sky can hear us':phase==='flight'?'The sky is ours tonight':'A little less far away';\"'$('\"'chapter').textContent=phase==='scavenge'?'01 / SPARE PARTS & SMALL MIRACLES':phase==='signal'?'02 / A QUESTION FOR THE STARS':'03 / OVER THE MOON';\"'$('\"'objective').textContent=objective;const next=world.targets.find(t=>\"'!inventory.includes(t.id));$('\"'subobjective').textContent=phase==='scavenge'?(next?next.name+' · follow the golden lights':''):phase==='signal'?'Ride north to the old forest clearing':\"'`Follow the rings · ${Math.round(flightDistance)} / 184 m · Hold ${prompt('\"'pulse')} to rise\"'`;$('\"'part-counter').textContent=phase==='flight'?stars+' ✦':inventory.length+' / 3';\"'$('\"'bond-fill').style.width=bond+'%';\"'$('\"'alert-banner').textContent=alert>15?'SEARCHLIGHTS NEARBY · '+(input.sneak?'KEEP QUIET':'SNEAK OR GLOW TO SLIP AWAY'):'';const near=mode==='play'?nearestInteraction():null;\"'$('\"'interaction').classList.toggle('hidden',\"'!near||attract);if(near)$('\"'interaction').innerHTML=\"'`<b class=\"key\">${prompt('\"'interact')}</b>\"'${near.text}`;$('\"'touch-action').style.display=lastInput==='touch'&&mode==='play'?'block':'none';\"'$('\"'touch-action').textContent=near?'HELP':phase==='flight'?'LIFT':'GLOW';drawMap();}\nfunction drawMap(){const c=mapCtx,w=220,p=body.translation();c.clearRect(0,0,w,w);c.fillStyle='#132e3b';c.fillRect(0,0,w,w);c.save();c.translate(110,110);const scale=phase==='flight'?1.8:2.25;c.scale(scale,scale);c.translate(-p.x,-p.z);c.strokeStyle='#3f5b60';c.lineWidth=4;c.beginPath();c.moveTo(0,35);c.lineTo(0,-250);c.moveTo(-35,3);c.lineTo(35,3);c.stroke();c.lineWidth=.3;world.agents.forEach(a=>{c.fillStyle=a.stunned>0?'#8cd8bb':'#eea377';c.beginPath();c.arc(a.x,a.z,1.3,0,7);c.fill()});world.targets.forEach(t=>{if(\"'!inventory.includes(t.id)){c.fillStyle='\"'#ffdb93';c.beginPath();c.arc(t.x,t.z,1.7,0,7);c.fill()}});if(inventory.length===3){c.strokeStyle='#a6e1cc';c.beginPath();c.arc(0,-35,2,0,7);c.stroke()}if(phase==='flight'){world.hoops.forEach(h=>{if(\"'!h.collected){c.fillStyle='\"'#ffdb93';c.fillRect(h.x-1,h.z-1,2,2)}})}c.fillStyle='#ffebc3';c.beginPath();c.arc(p.x,p.z,1.6,0,7);c.fill();c.restore();c.fillStyle='#9db8b9';c.font='11px sans-serif';c.textAlign='center';c.fillText('N',110,20);}\nfunction autoInput(dt){attractTimer+=dt;const p=body.translation();if(phase==='scavenge'){const target=world.targets.find(t=>\"'!inventory.includes(t.id));if(target){const dx=target.x-p.x,dz=target.z-p.z,d=Math.hypot(dx,dz);if(d<2.4){interact();return{x:0,z:0,sneak:false,lift:false}}if(attractTimer>8){teleport(target.x,target.z+1);attractTimer=0}if(pulseCooldown===0&&alert>10)pulse();return{x:dx/Math.max(.1,d),z:dz/Math.max(.1,d),sneak:false,lift:false}}}if(phase==='\"'signal'){const dx=-p.x,dz=-35-p.z,d=Math.hypot(dx,dz);if(d<3){beginSignal();attractTimer=0}else if(attractTimer>8){teleport(0,-33);attractTimer=0}return{x:dx/Math.max(.1,d),z:dz/Math.max(.1,d),sneak:false,lift:false}}if(phase==='flight'){const h=world.hoops.find(h=>\"'!h.collected&&h.z<p.z);return{x:h?clamp((h.x-p.x)*.5,-1,1):0,z:0,sneak:false,lift:h?p.y<h.y:true}}return{x:0,z:0,sneak:false,lift:false};}\nfunction simulate(dt,controls){clockTime+=dt;pulseCooldown=Math.max(0,pulseCooldown-dt);elapsed+=dt;if(god||attract)bond=100;const p=body.translation();moving=Math.hypot(controls.x,controls.z)>.1;\nif(phase==='\"'flight'){const targetY=controls.lift?8.5:2.2;const yVel=clamp((targetY-p.y)*1.8,-3,4);body.setLinvel({x:controls.x*7.8,y:yVel,z:-balance.flightSpeed*(controls.sneak?1.35:1)},true);flightDistance=Math.max(0,-p.z-44);if(lastInput==='touch'){const next=world.hoops.find(h=>\"'!h.collected&&h.z<p.z);if(next)body.setLinvel({x:clamp((next.x-p.x)*1.3,-6,6),y:clamp((next.y-p.y)*2,-3,4),z:-balance.flightSpeed},true)}for(const h of world.hoops){if(!h.collected&&Math.abs(p.z-h.z)<2.5&&Math.hypot(p.x-h.x,p.y-h.y)<3.2){h.collected=true;h.mesh.visible=false;stars++;bond=clamp(bond+5,0,100);audio.sfx('\"'pickup');particleBurst(h.x,h.y,h.z)}}if(p.z< -228)winGame();players[0].rotation.y=lerp(players[0].rotation.y,Math.PI+controls.x*.22,dt*5);players[0].rotation.z=lerp(players[0].rotation.z,-controls.x*.2,dt*3);\n}else{const speed=controls.sneak?balance.sneakSpeed:balance.rideSpeed;const vel=body.linvel();body.setLinvel({x:controls.x*speed,y:vel.y,z:controls.z*speed},true);if(moving){let target=Math.atan2(controls.x,controls.z);let d=THREE.MathUtils.euclideanModulo(target-players[0].rotation.y+Math.PI,Math.PI*2)-Math.PI;players[0].rotation.y+=d*Math.min(1,dt*9)}players[0].rotation.z=0;bond=clamp(bond+balance.bondRegen*dt,0,100);let detected=false;world.agents.forEach(a=>{a.stunned=Math.max(0,a.stunned-dt);a.mesh.position.set(a.x,0,a.z);if(a.stunned>0)return;const dx=p.x-a.x,dz=p.z-a.z,dist=Math.hypot(dx,dz);const dirX=Math.sin(a.mesh.rotation.y),dirZ=Math.cos(a.mesh.rotation.y);const cone=(dx*dirX+dz*dirZ)/Math.max(.1,dist)>.65;if(dist<(controls.sneak?3:7.8)&&cone){detected=true;bond-=dt*balance.alertRate*(controls.sneak?.2:1);if(alert<8)audio.sfx('alert');alert=clamp(alert+dt*40,0,100)}});if(\"'!detected)alert=Math.max(0,alert-dt*28);if((god||attract)&&bond<100)bond=100;if(bond<=0){catchCount++;bond=75;alert=0;teleport(0,18);say('\"'We lost them. Let’s take the quiet way this time.','THE KID',6);toast('Safe in the garden · borrowed parts kept')}for(const candy of world.candies){if(\"'!candy.collected&&Math.hypot(candy.x-p.x,candy.z-p.z)<1.5){candy.collected=true;candy.mesh.visible=false;bond=clamp(bond+10,0,100);audio.sfx('\"'pickup');particleBurst(candy.x,.8,candy.z,0xeebd90,8)}}}\nphysics.timestep=dt;physics.step();const np=body.translation();if(phase\"'!=='\"'flight'){if(Math.abs(np.x)>34||np.z>34||np.z< -42)body.setTranslation({x:clamp(np.x,-34,34),y:np.y,z:clamp(np.z,-42,34)},true)}else if(Math.abs(np.x)>16)body.setTranslation({x:clamp(np.x,-16,16),y:np.y,z:np.z},true);players[0].position.set(np.x,np.y-.9,np.z);players[0].userData.mixer.timeScale=phase==='flight'?1.5:moving?1:.15;players[0].userData.mixer.update(dt);\nconst follow=phase==='flight'?new THREE.Vector3(0,1.6,.95).applyAxisAngle(new THREE.Vector3(0,1,0),players[0].rotation.y).add(players[0].position):new THREE.Vector3(np.x+1.3,.1,np.z+1.5);alien.position.lerp(follow,Math.min(1,dt*(phase==='flight'?15:3)));alien.scale.setScalar(phase==='flight'?.65:1);alien.rotation.y=phase==='flight'?Math.PI:players[0].rotation.y;alien.userData.mixer.timeScale=phase==='flight'?.2:moving?1:.2;alien.userData.mixer.update(dt);world.flowers.forEach(f=>{if(f.healed){f.mesh.scale.lerp(new THREE.Vector3(1.4,1.4,1.4),dt*2)}});\nfor(const [seat,i] of remoteInputs){if(seat===currentSeat())continue;const friend=players[1];friend.visible=true;if(phase==='flight'){friend.position.lerp(new THREE.Vector3(np.x-2.5,np.y-.7,np.z+2),dt*3)}else{friend.position.x=clamp(friend.position.x+(i.x||0)*balance.rideSpeed*dt,-34,34);friend.position.z=clamp(friend.position.z+(i.z||0)*balance.rideSpeed*dt,-39,34);friend.position.y=.1;}if(i.x||i.z)friend.rotation.y=Math.atan2(i.x,i.z);friend.userData.mixer.update(dt);if(i.pulse){i.pulse=false;spawnRing(friend.position.x,.2,friend.position.z,0x9eeacc,8);world.agents.forEach(a=>{if(Math.hypot(a.x-friend.position.x,a.z-friend.position.z)<10)a.stunned=6});audio.sfx('pulse')}if(i.interact){i.interact=false;const old=body.translation();body.setTranslation({x:friend.position.x,y:1.25,z:friend.position.z},true);interact();body.setTranslation(old,true)}}\nworld.update(clockTime,dt);updateEffects(dt);updateTrail();}\nfunction updateEffects(dt){for(let i=effects.length-1;i>=0;i--){const e=effects[i];e.t+=dt;const f=e.t/e.duration;if(e.v){e.mesh.position.addScaledVector(e.v,dt);e.v.y-=dt*3;e.mesh.rotation.x+=dt*3}else e.mesh.scale.setScalar(lerp(.1,e.size,f));e.mesh.material.opacity=1-f;if(f>=1){scene.remove(e.mesh);e.mesh.geometry.dispose();e.mesh.material.dispose();effects.splice(i,1)}}}\nfunction updateTrail(){const p=body.translation();const target=phase==='scavenge'?world.targets.find(t=>\"'!inventory.includes(t.id)):phase==='\"'signal'?{x:0,z:-35}:null;trail.forEach((m,i)=>{m.visible=\"'!!target;if(target){const a=(i+1)/(trail.length+2);m.position.set(lerp(p.x,target.x,a),.2+Math.sin(clockTime*2+i)*.08,lerp(p.z,target.z,a));m.scale.setScalar(.7+Math.sin(clockTime*3+i*.5)*.2)}})}\nfunction snapshot(){return{mode,phase,bond,inventory,flowersHealed,stars,pulses,elapsed,alert,flightDistance,players:players.map(p=>({x:p.position.x,y:p.position.y,z:p.position.z,r:p.rotation.y,visible:p.visible})),alien:{x:alien.position.x,y:alien.position.y,z:alien.position.z},flowers:world.flowers.map(f=>f.healed),candies:world.candies.map(c=>c.collected),hoops:world.hoops.map(h=>h.collected)}}\nfunction applySnapshot(s){if(!ready||authority())return;phase=s.phase;bond=s.bond;inventory=s.inventory;flowersHealed=s.flowersHealed;stars=s.stars;pulses=s.pulses;elapsed=s.elapsed;alert=s.alert;flightDistance=s.flightDistance;if(mode==='\"'title'&&s.mode==='play'){mode='play';showScreen(null);\"'$('\"'hud').classList.remove('hidden')}if(s.mode==='win'&&mode\"'!=='\"'win')winGame();s.players?.forEach((p,i)=>{if(players[i]){players[i].position.set(p.x,p.y,p.z);players[i].rotation.y=p.r;players[i].visible=p.visible;if(i===0)body.setTranslation({x:p.x,y:p.y+.9,z:p.z},true)}});if(s.alien)alien.position.set(s.alien.x,s.alien.y,s.alien.z);world.targets.forEach(t=>t.mesh.visible=\"'!inventory.includes(t.id));s.flowers?.forEach((v,i)=>world.flowers[i].healed=v);s.candies?.forEach((v,i)=>{world.candies[i].collected=v;world.candies[i].mesh.visible=!v});s.hoops?.forEach((v,i)=>{world.hoops[i].collected=v;world.hoops[i].mesh.visible=!v});updateHUD()}\nfunction updateCamera(dt){if(!body)return;const hero=!authority()&&players[1].visible?players[1]:players[0],p=hero.position;let target,look;if(mode==='\"'title'){target=new THREE.Vector3(21,15,32);look=new THREE.Vector3(-1,1,-4)}else if(phase==='flight'){target=new THREE.Vector3(p.x*.6+1,p.y+8,p.z+19);look=new THREE.Vector3(p.x,p.y+1,p.z-13)}else if(mode==='win'){target=new THREE.Vector3(13,11,-210);look=new THREE.Vector3(0,4,-235)}else{target=new THREE.Vector3(p.x+Math.sin(cameraAngle)*22,p.y+19,p.z+Math.cos(cameraAngle)*22);look=new THREE.Vector3(p.x,1.2,p.z-4)}camera.position.lerp(target,Math.min(1,dt*3));camera.lookAt(look)}\nfunction frame(now){if(\"'!ready)return;const dt=Math.min((now-lastFrame)/1000||.016,.06);lastFrame=now;const controls=readInput(dt);input.sneak=controls.sneak;if(mode==='\"'title'&&\"'!network.hubActive){titleIdle+=dt;world.update(clockTime+=dt,dt);alien.userData.mixer.update(dt*.2);if(titleIdle>=10)startGame({demo:true})}if(mode==='\"'play'&&(\"'!network.hubActive||network.running)){if(authority()){const c=attract?autoInput(dt):controls;accumulator+=dt;let count=0;while(accumulator>=1/60&&count++<4){simulate(1/60,c);accumulator-=1/60}network.broadcast(snapshot())}else{network.sendInput({...controls,interact:false,pulse:false});world.update(clockTime+=dt,dt);players.forEach(p=>p.userData.mixer.update(dt));}}else if(mode==='\"'signal'){updateSignal(dt);if(attract&&signalReady){attractTimer+=dt;if(attractTimer>.5){submitNote(pattern[signalIndex]);attractTimer=0}}}else if(mode==='win'){winTimer+=dt;world.update(clockTime+=dt,dt);if(attract&&winTimer>5)startGame({demo:true})}if(dialogueTimer>0){dialogueTimer-=dt;if(dialogueTimer<=0)\"'$('\"'dialogue').classList.add('hidden')}if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)\"'$('\"'toast').classList.add('hidden')}audio.update(dt);updateCamera(dt);if(mode==='play')updateHUD();renderer.render(scene,camera);requestAnimationFrame(frame)}let lastFrame=performance.now();\nasync function init(){try{await RAPIER.init();physics=new RAPIER.World({x:0,y:-18,z:0});scene=new THREE.Scene();scene.background=new THREE.Color(0x15283d);scene.fog=new THREE.Fog(0x15283d,65,155);camera=new THREE.PerspectiveCamera(48,innerWidth/innerHeight,.1,400);camera.position.set(21,15,32);renderer=new THREE.WebGPURenderer({canvas:\"'$('\"'world'),antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.2;await renderer.init();const data=new Uint8Array([65,135,205,255]);gradient=new THREE.DataTexture(data,4,1,THREE.RedFormat);gradient.needsUpdate=true;gradient.minFilter=gradient.magFilter=THREE.NearestFilter;world=buildWorld(THREE,scene,physics,{RAPIER,gradient});const ground=physics.createRigidBody(RAPIER.RigidBodyDesc.fixed());physics.createCollider(RAPIER.ColliderDesc.cuboid(75,.2,180).setTranslation(0,-.2,-100),ground);body=physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,1.25,18).lockRotations().setLinearDamping(6).setCcdEnabled(true));physics.createCollider(RAPIER.ColliderDesc.capsule(.4,.46).setFriction(0).setRestitution(0),body);players=[makeCharacter(),makeCharacter(false,0x79a9a2)];players.forEach(p=>scene.add(p));players[1].visible=false;players[1].position.set(-2,.1,19);alien=makeCharacter(true);scene.add(alien);for(let i=0;i<12;i++){const m=new THREE.Mesh(new THREE.OctahedronGeometry(.075),new THREE.MeshBasicMaterial({color:0xffd789}));scene.add(m);trail.push(m)}teleport(0,18);renderCredits(\"'$('\"'credits-content'));for(const [id,value] of Object.entries({music:settings.music??10,sfx:settings.sfx??75,camera:Math.round((settings.cameraSensitivity??1)*100)})){\"'$(id).value=value;$(id).dispatchEvent(new Event('\"'input'))}glyphs=settings.glyphs||'ps';captions=settings.captions??true;\"'$('\"'glyph-toggle').textContent=glyphs==='ps'?'PlayStation':'Xbox';\"'$('\"'captions-toggle').textContent=captions?'On':'Off';try{if(localStorage.getItem('moonward-save'))\"'$('\"'continue-button').classList.remove('hidden')}catch{}ready=true;await network.connect();network.ready();\"'$('\"'loading').classList.add('hidden');if(\"'!network.hubActive){showScreen('\"'title');}else{mode='waiting';showScreen(null)}updatePrompts();requestAnimationFrame(frame);window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});}catch(error){console.error(error);\"'$('\"'loading-message').textContent='This little world could not start: '+error.message;const b=document.createElement('button');b.className='pill';b.textContent='Try again';b.onclick=()=>location.reload();\"'$('\"'loading').append(b);}}\nwindow.__game={getState:()=>({ready,mode,phase,attract,lastInput,inputMode:lastInput,player:body?body.translation():null,inventory:[...inventory],bond,alert,stars,flowersHealed,pulses,pulseCooldown,signalReady,signalIndex,pattern:[...pattern],flightDistance,elapsed,balance:{...balance},god,targets:world?.targets.map(({id,name,x,z})=>({id,name,x,z})),flowers:world?.flowers.map(({x,z,healed})=>({x,z,healed})),hoops:world?.hoops.map(({x,y,z,collected})=>({x,y,z,collected})),network:network.info}),start:startGame,advance(seconds){for(let t=0;t<seconds;t+=1/60){if(mode==='play')simulate(1/60,{x:0,z:0,sneak:false,lift:phase==='flight'});else if(mode==='signal')updateSignal(1/60);else if(mode==='title'){titleIdle+=1/60;if(titleIdle>=10)startGame({demo:true})}}updateHUD()},teleport,interact,pulse,dev:devAction,submitNote,beginSignal,beginFlight,pause,resume,toTitle,renderInfo:()=>({backend:renderer?.backend?.isWebGPUBackend?'WebGPU':'WebGL2',three:THREE.REVISION,rapier:RAPIER.version(),animationMixers:players.length+1,drawCalls:renderer?.info?.render?.calls}),audioDebug:()=>audio.debug(),audio,network,snapshot};\ninit();\nEOF\nnode --check main.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from 'rapier';\nimport {createAudio} from './audio.js';\nimport {createNetwork} from './network.js';\nimport {buildWorld} from './world.js';\nimport {renderCredits} from './credits.js';\nconst \"'$=id=>document.getElementById(id), clamp=THREE.MathUtils.clamp, lerp=THREE.MathUtils.lerp;\nconst audio=createAudio();\nconst defaults={rideSpeed:6.3,sneakSpeed:3.1,alertRate:22,bondRegen:2.8,pulseCost:17,flightSpeed:10.5};\nconst balance={...defaults};\nlet god=false,ready=false,renderer,scene,camera,physics,world,body,players=[],alien,clockTime=0,accumulator=0;\nlet mode='\"'title',phase='scavenge',attract=false,pausedFrom='play',returnScreen='title',titleIdle=0,elapsed=0;\nlet bond=100,inventory=[],flowersHealed=0,stars=0,pulses=0,catchCount=0,alert=0,pulseCooldown=0,dialogueTimer=0,toastTimer=0;\nlet lastInput='keyboard',glyphs='ps',captions=true,cameraSensitivity=1,cameraAngle=.42,clickTarget=null;\nlet flightY=2.6,flightDistance=0,winTimer=0,lastBroadcast=0,attractStep=0,attractTimer=0,signalIndex=0,signalTimer=0,signalShow=-1,signalReady=false;\nconst pattern=[0,2,1,0],input={x:0,z:0,sneak:false,lift:false,interact:false,pulse:false},remoteInputs=new Map(),pressed=new Set(),effects=[],trail=[];\nconst keys=new Set(),mapCtx=\"'$('\"'map').getContext('2d');\nlet moving=false,padPrevious=[],pointerDown=null,rightTouch=null,leftTouch=null,touchVector={x:0,z:0};\nconst settings=(()=>{try{return JSON.parse(localStorage.getItem('moonward-settings'))||{}}catch{return {}}})();\nconst network=createNetwork({onStatus:(s)=>{\"'$('\"'network-status').textContent=s},onInput:(seat,value)=>{remoteInputs.set(seat,value)},onState:state=>applySnapshot(state),onStart:()=>{startGame();},onTimeUp:()=>finishHub(),onEnd:()=>{mode='ended';showScreen(null);\"'$('\"'hud').classList.add('hidden');audio.setMusic(0);audio.setSfx(0)},onPeerJoin:()=>toast('A friend has found your little world.'),onConnect:()=>{if(ready&&network.hubActive&&mode==='title')\"'$('\"'title').classList.add('hidden')}});\nfunction currentSeat(){return network.me??0}\nfunction authority(){return network.isHost||\"'!network.info?.connected}\nfunction signalSound(n){audio.sfx(['\"'bond','signal','pickup'][n]);}\nfunction rememberInput(type){if(lastInput\"'!==type){lastInput=type;document.body.classList.toggle('\"'touch',type==='touch');updatePrompts()}titleIdle=0;if(attract){endAttract();return true}return false}\nfunction prompt(name){const ps={interact:'✕',pulse:'□',sneak:'L2',pause:'☰',move:'L'},xb={interact:'A',pulse:'X',sneak:'LT',pause:'☰',move:'L'},kb={interact:'E',pulse:'Space',sneak:'Shift',pause:'Esc',move:'WASD'};return lastInput==='pad'?(glyphs==='ps'?ps:xb)[name]:kb[name]}\nfunction updatePrompts(){if(\"'!$('\"'controls'))return;\"'$('\"'controls').innerHTML=\"'`<span><b class=\"key\">${prompt('\"'move')}</b>Ride</span><span><b class=\\\"key\\\">\"'${prompt('\"'interact')}</b>Interact</span><span><b class=\\\"key\\\">\"'${prompt('\"'pulse')}</b>\"'${phase==='\"'flight'?'Lift':'Glow'}</span><span><b class=\\\"key\\\">\"'${prompt('\"'sneak')}</b>\"'${phase==='\"'flight'?'Boost':'Sneak'}</span><span><b class=\\\"key\\\">\"'${prompt('\"'pause')}</b>Pause</span>\"'`;$('\"'title-input').textContent=lastInput==='pad'?\"'`${glyphs==='\"'ps'?'✕':'A'} TO BEGIN · LEFT STICK TO RIDE\"'`:'\"'WASD TO RIDE · E TO INTERACT';['0','1','2'].forEach((s,i)=>{\"'$('\"'note'+s).textContent=(lastInput==='pad'?(glyphs==='ps'?['□','✕','○']:['X','A','B']):['1','2','3'])[i]+' · '+['LOW','MIDDLE','HIGH'][i]})}\nfunction say(text,who='YOUR NEW FRIEND',time=5){if(captions){\"'$('\"'dialogue').innerHTML=\"'`<em>${who}</em>${text}`;$('\"'dialogue').classList.remove('hidden');dialogueTimer=time}audio.voice(who==='YOUR NEW FRIEND'?'curious':'happy')}\nfunction toast(text){\"'$('\"'toast').textContent=text;\"'$('\"'toast').classList.remove('hidden');toastTimer=3.2}\nfunction showScreen(id){document.querySelectorAll('.screen').forEach(el=>el.classList.add('hidden'));if(id){\"'$(id).classList.remove('\"'hidden');setFocus(\"'$(id).querySelector('\"'button:not(.hidden)'))}}\nfunction setFocus(button){document.querySelectorAll('.focused').forEach(e=>e.classList.remove('focused'));if(button){button.classList.add('focused');button.focus({preventScroll:true})}}\nfunction goScreen(id){if(id==='settings'||id==='about'||id==='coop'){returnScreen=['title','pause','win'].includes(mode)?mode:'pause';}if(id==='pause'){pausedFrom=mode;mode='pause';}else mode=id;showScreen(id);\"'$('\"'hud').classList.toggle('hidden',\"'!['\"'play','signal'].includes(mode));if(id==='dev')\"'$('\"'dev-stats').textContent=\"'`${renderer.backend?.isWebGPUBackend?'\"'WebGPU':'WebGL2 compatibility'} · Rapier 0.19.3 · \"'${world?.agents.length||0} patrols · ${pulses} glow pulses`;}\nfunction back(){if(mode==='\"'dev'){mode='pause';showScreen('pause')}else{mode=returnScreen;showScreen(mode);\"'$('\"'hud').classList.toggle('hidden',mode\"'!=='\"'play')}}\nfunction action(name){audio.unlock();audio.sfx('click');if(attract){endAttract();return}switch(name){case 'start':startGame();break;case 'continue':startGame({resume:true});break;case 'resume':resume();break;case 'settings':case 'about':case 'coop':case 'dev':goScreen(name);break;case 'back':back();break;case 'title':toTitle();break;case 'close-signal':mode='play';showScreen(null);break}}\ndocument.querySelectorAll('[data-action]').forEach(b=>b.addEventListener('click',()=>action(b.dataset.action)));\ndocument.querySelectorAll('button').forEach(b=>b.addEventListener('pointerenter',()=>{if(\"'!b.disabled)setFocus(b)}));\n$('\"'interaction').onclick=()=>interact();\"'$('\"'pause-fab').onclick=()=>mode==='play'?pause():resume();\nfunction pause(){if(attract)return endAttract();if(mode==='play'||mode==='signal')goScreen('pause')}\nfunction resume(){mode=pausedFrom==='signal'?'signal':'play';showScreen(mode==='signal'?'signal':null);\"'$('\"'hud').classList.remove('hidden')}\nfunction saveSettings(){try{localStorage.setItem('moonward-settings',JSON.stringify({music:+\"'$('\"'music').value,sfx:+\"'$('\"'sfx').value,glyphs,cameraSensitivity,captions}))}catch{}}\nfor(const id of ['music','sfx','camera']){\"'$(id).oninput=()=>{const n=+$(id).value;$(id).nextElementSibling.textContent=n+'\"'%';if(id==='music')audio.setMusic(n/100);if(id==='sfx')audio.setSfx(n/100);if(id==='camera')cameraSensitivity=n/100;saveSettings()}}\n\"'$('\"'glyph-toggle').onclick=()=>{glyphs=glyphs==='ps'?'xbox':'ps';\"'$('\"'glyph-toggle').textContent=glyphs==='ps'?'PlayStation':'Xbox';updatePrompts();saveSettings()};\"'$('\"'captions-toggle').onclick=()=>{captions=\"'!captions;$('\"'captions-toggle').textContent=captions?'On':'Off';saveSettings()};\nconst devNames={rideSpeed:['Ride speed',3,12,.1],sneakSpeed:['Sneak speed',1,6,.1],alertRate:['Searchlight danger',0,60,1],bondRegen:['Friendship recovery',0,10,.1],pulseCost:['Glow cost',0,40,1],flightSpeed:['Flight speed',5,20,.1]};\nfor(const [key,[label,min,max,step]] of Object.entries(devNames)){const row=document.createElement('div');row.className='row';row.innerHTML=\"'`<label for=\"dev-${key}\">${label}</label><input id=\"dev-${key}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${balance[key]}\"><output>${balance[key]}</output>`;row.querySelector('\"'input').oninput=e=>{balance[key]=+e.target.value;e.target.nextElementSibling.textContent=e.target.value};\"'$('\"'dev-sliders').append(row)}\n\"'$('\"'god-toggle').onclick=()=>{god=\"'!god;$('\"'god-toggle').textContent=god?'On':'Off'};\ndocument.querySelectorAll('[data-dev]').forEach(b=>b.onclick=()=>devAction(b.dataset.dev));\nfunction devAction(a,value){if(a in balance){balance[a]=value;\"'$('\"'dev-'+a).value=value;\"'$('\"'dev-'+a).nextElementSibling.textContent=value;return}if(a==='refill')bond=100;if(a==='parts'){inventory=world.targets.map(t=>t.i