{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '167,194p' world.js; head -45 main.js\"","aggregated_output":"  box(46,.45,205,0x204c49,0,-.35,-142,root,false);\n  box(5,.03,194,0x6b7f6b,0,-.08,-139,root,false);\n  const ringX=[0,-6,5,-7,7,0,-5,6,-4,5,0,0],ringY=[3.4,4.5,6,5,7,8,6,4.5,6.5,7.5,5,4];\n  for(let i=0;i<12;i++){\n    const x=ringX[i],y=ringY[i],z=-60-i*14,g=new THREE.Group();g.position.set(x,y,z);root.add(g);\n    mesh(new THREE.TorusGeometry(2.5,.09,8,48),glow(0x9af6d5),0,0,0,g);\n    mesh(new THREE.TorusGeometry(2.72,.025,5,48),glow(0xffd99b),0,0,0,g,false);\n    for(let j=0;j<8;j++){const a=j*Math.PI/4;ball(.09,gold,Math.cos(a)*2.5,Math.sin(a)*2.5,0,g);}\n    hoops.push({x,y,z,mesh:g,collected:false,passed:false,index:i,radius:2.5});\n    // Painted light chevrons show the route even between rings.\n    for(let j=0;j<2;j++){const zz=z+5+j*4;const glowDot=ball(.055,teal,x,y,zz);decorations.push({kind:'route',mesh:glowDot});}\n  }\n  for(let i=0;i<110;i++){const z=-43-random()*202,x=(i%2?-1:1)*(12+random()*13);pine(x,z,.9+random()*1.3,false);}\n  // Fallen logs border the path and make the takeoff feel like an escape into wilderness.\n  for(let i=0;i<12;i++){const z=-44-i*15,x=(i%2?-1:1)*(9+random()*3);const log=cylinder(.5,.6,4,0x6e6455,x,.5,z);log.rotation.z=Math.PI/2;ball(.45,0xafa17c,x+2,.5,z,root,.1,1,1);}\n  // Parked search vans are low obstacles: a little lift carries the bicycle safely over.\n  for(const [i,x] of [-2,3,-4,3,-2].entries()){\n    const z=-81-i*28,g=new THREE.Group();g.position.set(x,1.7,z);root.add(g);\n    box(2.9,2.2,5,0x60777b,0,-.25,0,g);box(2.8,.8,2.2,0x50676f,0,.9,.8,g);\n    box(2.35,.6,.08,glow(0x97b7b8),0,.9,1.95,g,false);box(2.2,.5,.08,0x344d5a,0,-.15,2.56,g);\n    box(3.05,.2,.3,0xb8b7a1,0,-1.1,2.55,g);\n    for(const side of [-1,1]){\n      ball(.2,windows,side*.95,-.4,2.57,g,1,.7,.3);\n      for(const zz of [-1.5,1.5]){const wheel=cylinder(.48,.48,.3,0x243948,side*1.5,-1.1,zz,g,12);wheel.rotation.z=Math.PI/2;}\n      box(.05,.8,1.25,0x344d5a,side*1.48,.2,-.9,g);\n    }\n    const beacon=ball(.18,glow(0xecaa72),0,1.5,0,g,1,.7,1);\n    hazards.push({x,y:1.7,z,mesh:g,radius:1.9,beacon,hit:false});\nimport * as THREE from 'three/webgpu';\nimport RAPIER from 'rapier';\nimport {createAudio} from './audio.js';\nimport {createNetwork} from './network.js';\nimport {buildWorld} from './world.js';\nimport {renderCredits} from './credits.js';\nconst $=id=>document.getElementById(id), clamp=THREE.MathUtils.clamp, lerp=THREE.MathUtils.lerp;\nconst audio=createAudio();\nconst defaults={rideSpeed:6.3,sneakSpeed:3.1,alertRate:22,bondRegen:2.8,pulseCost:17,flightSpeed:10.5};\nconst balance={...defaults};\nlet god=false,ready=false,renderer,scene,camera,physics,world,body,players=[],alien,clockTime=0,accumulator=0;\nlet mode='title',phase='scavenge',attract=false,pausedFrom='play',returnScreen='title',titleIdle=0,elapsed=0;\nlet bond=100,inventory=[],flowersHealed=0,stars=0,pulses=0,catchCount=0,alert=0,pulseCooldown=0,dialogueTimer=0,toastTimer=0;\nlet lastInput='keyboard',glyphs='ps',captions=true,cameraSensitivity=1,cameraAngle=.42,clickTarget=null;\nlet flightY=2.6,flightDistance=0,winTimer=0,lastBroadcast=0,attractStep=0,attractTimer=0,signalIndex=0,signalTimer=0,signalShow=-1,signalReady=false;\nconst pattern=[0,2,1,0],input={x:0,z:0,sneak:false,lift:false,interact:false,pulse:false},remoteInputs=new Map(),pressed=new Set(),effects=[],trail=[];\nconst keys=new Set(),mapCtx=$('map').getContext('2d');\nlet moving=false,padPrevious=[],pointerDown=null,rightTouch=null,leftTouch=null,touchVector={x:0,z:0};\nconst settings=(()=>{try{return JSON.parse(localStorage.getItem('moonward-settings'))||{}}catch{return {}}})();\nlet friendBody=null,menuAxisTimer=0,sliderAxisTimer=0,lastRemoteMode=null;\nconst remoteActions=[];\nconst neutralControls=()=>({x:0,z:0,sneak:false,lift:false});\nconst network=createNetwork({\n onStatus:s=>{$('network-status').textContent=s},\n onInput:(seat,value)=>{if(!value||typeof value!=='object')return;remoteInputs.set(seat,{x:clamp(Number(value.x)||0,-1,1),z:clamp(Number(value.z)||0,-1,1),sneak:!!value.sneak,lift:!!value.lift,at:performance.now()});if(value.interact||value.pulse||Number.isInteger(value.note))remoteActions.push({seat,action:{interact:!!value.interact,pulse:!!value.pulse,note:value.note}})},\n onAction:(seat,action)=>remoteActions.push({seat,action}),\n onState:state=>applySnapshot(state),onStart:()=>startGame(),onTimeUp:()=>finishHub(),\n onEnd:()=>{mode='ended';remoteInputs.clear();remoteActions.length=0;showScreen(null);$('hud').classList.add('hidden');audio.setMusic(0);audio.setSfx(0)},\n onPeerJoin:()=>{syncFriend();toast('A friend has found your little world.')},\n onPeerLeave:seat=>{remoteInputs.delete(seat);for(let i=remoteActions.length-1;i>=0;i--)if(remoteActions[i].seat===seat)remoteActions.splice(i,1);syncFriend();if(!authority()){mode='waiting';showScreen(null);$('hud').classList.add('hidden');toast('Your friend disconnected. Open the menu to return home.')}},\n onConnect:()=>{syncFriend();if(ready&&network.hubActive&&mode==='title')$('title').classList.add('hidden')}\n});\nfunction currentSeat(){return network.me??0}\nfunction authority(){return network.isHost}\nfunction seatSlot(seat){const index=network.players.findIndex(p=>p.id===seat);return index<0?-1:index}\nfunction currentSlot(){return Math.max(0,seatSlot(currentSeat()))}\nfunction localPosition(){const hero=players[currentSlot()];return currentSlot()===0&&body?body.translation():hero?{x:hero.position.x,y:hero.position.y+.9,z:hero.position.z}:{x:0,y:1.25,z:18}}\nfunction seatControls(slot,local){const seat=network.players[slot]?.id;if(seat===currentSeat()&&!network.isServer&&local)return local;const value=remoteInputs.get(seat);return value&&performance.now()-value.at<700?value:neutralControls()}\nfunction syncFriend(){if(!ready||!players[1]||!physics)return;const enabled=network.players.length>1;if(!friendBody){friendBody=physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(-2,1.25,19).lockRotations().setLinearDamping(6).setCcdEnabled(true));physics.createCollider(RAPIER.ColliderDesc.capsule(.4,.46).setFriction(0).setRestitution(0),friendBody)}const fresh=enabled&&!players[1].visible;players[1].visible=enabled;friendBody.setEnabled(enabled&&authority());if(fresh&&authority()){const p=body.translation();friendBody.setTranslation({x:p.x-2,y:p.y,z:p.z+1},true);friendBody.setLinvel({x:0,y:0,z:0},true);players[1].position.set(p.x-2,p.y-.9,p.z+1)}}\nfunction processRemoteActions(){if(!authority())return;while(remoteActions.length){const {seat,action}=remoteActions.shift(),slot=seatSlot(seat);if(slot<0||!action||typeof action!=='object')continue;const position=slot===0?body.translation():{x:players[slot].position.x,y:players[slot].position.y+.9,z:players[slot].position.z};if(action.pause&&(mode==='play'||mode==='signal'))pause(true);if(action.resume&&['pause','settings','about','coop','dev'].includes(mode))resume(true);if(action.cancelSignal&&mode==='signal'){mode='play';showScreen(null)}if(Number.isInteger(action.note)&&action.note>=0&&action.note<3)submitNote(action.note,true);if(action.interact)interact(position);if(action.pulse)pulse(position)}}\nfunction closeSignal(){if(!authority()){network.sendAction({cancelSignal:true});return}mode='play';showScreen(null)}\nfunction prepareFriend(dt,controls){if(!friendBody?.isEnabled())return;const p=friendBody.translation();friendBody.setGravityScale(phase==='flight'?0:1,true);if(phase==='flight'){friendBody.setLinvel({x:controls.x*7.8,y:clamp(((controls.lift?8.5:2.2)-p.y)*1.8,-3,4),z:-balance.flightSpeed*(controls.sneak?1.35:1)},true)}else{friendBody.setLinvel({x:controls.x*(controls.sneak?balance.sneakSpeed:balance.rideSpeed),y:friendBody.linvel().y,z:controls.z*(controls.sneak?balance.sneakSpeed:balance.rideSpeed)},true)}}\nfunction updateFriend(dt,controls){if(!friendBody?.isEnabled())return;const friend=players[1],p=friendBody.translation();if(phase==='flight'){friendBody.setTranslation({x:clamp(p.x,-16,16),y:p.y,z:p.z},true);friend.rotation.y=Math.PI+controls.x*.22;friend.rotation.z=-controls.x*.2;for(const h of world.hoops)if(!h.collected&&Math.abs(p.z-h.z)<2.5&&Math.hypot(p.x-h.x,p.y-h.y)<3.2){h.collected=true;h.mesh.visible=false;stars++;audio.sfx('pickup');particleBurst(h.x,h.y,h.z)}}else{friendBody.setTranslation({x:clamp(p.x,-34,34),y:p.y,z:clamp(p.z,-42,34)},true);if(Math.hypot(controls.x,controls.z)>.1)friend.rotation.y=Math.atan2(controls.x,controls.z);friend.rotation.z=0;for(const a of world.agents){const dx=p.x-a.x,dz=p.z-a.z,d=Math.hypot(dx,dz);if(a.stunned<=0&&d<(controls.sneak?3:7.8)&&(dx*Math.sin(a.mesh.rotation.y)+dz*Math.cos(a.mesh.rotation.y))/Math.max(.1,d)>.65){bond-=dt*balance.alertRate*(controls.sneak?.2:1);alert=clamp(alert+dt*40,0,100)}}for(const candy of world.candies)if(!candy.collected&&Math.hypot(candy.x-p.x,candy.z-p.z)<1.5){candy.collected=true;candy.mesh.visible=false;bond=clamp(bond+10,0,100);audio.sfx('pickup')}}const np=friendBody.translation();friend.position.set(np.x,np.y-.9,np.z);friend.userData.mixer.timeScale=phase==='flight'?1.5:Math.hypot(controls.x,controls.z)>.1?1:.15;friend.userData.mixer.update(dt)}\nfunction signalSound(n){audio.sfx(['bond','signal','pickup'][n]);}\nfunction rememberInput(type){if(lastInput!==type){lastInput=type;document.body.classList.toggle('touch',type==='touch');updatePrompts()}titleIdle=0;if(attract){endAttract();return true}return false}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text()\ns=s.replace('flightSpeed:10.5','flightSpeed:8.2')\ns=s.replace(\\\"function simulate(dt,controls)\\\",\\\"function checkFlightHazards(p){for(const h of world.hazards||[]){if(\"'!h.hit&&Math.abs(p.z-h.z)<3&&Math.hypot(p.x-h.x,p.y-h.y)<h.radius+0.4){h.hit=true;if(!god&&!attract)bond=Math.max(15,bond-28);audio.sfx('\"'alert');spawnRing(h.x,.2,h.z,0xffa47e,5);particleBurst(p.x,p.y,p.z,0xffb284,12);toast('A close call\"'! Hold '\"'+prompt('pulse')+' to clear the vans.')}}}\\\\nfunction updateEnding(dt){winTimer+=dt;world.update(clockTime+=dt,dt);players.forEach(p=>{p.position.y=lerp(p.position.y,.08,Math.min(1,dt*1.5));p.rotation.z=lerp(p.rotation.z,0,dt*3)});alien.position.lerp(new THREE.Vector3(0,3.8,-235),Math.min(1,dt*.8));alien.scale.setScalar(lerp(alien.scale.x,.9,dt));if(winTimer>3.6&&alien.visible){particleBurst(0,4,-235,0x9ee9c8,35);alien.visible=false;}updateEffects(dt);if(attract&&winTimer>6)startGame({demo:true});}\\\\nfunction simulate(dt,controls)\\\")\ns=s.replace(\\\"if(phase==='flight'){const targetY=controls.lift?8.5:2.2;\\\", \\\"if(phase==='flight'){checkFlightHazards(p);const targetY=controls.lift?8.5:2.2;\\\")\ns=s.replace(\\\"if(phase==='flight'){friendBody.setTranslation\\\", \\\"if(phase==='flight'){checkFlightHazards(p);friendBody.setTranslation\\\")\ns=s.replace(\\\"world.reset();world.targets\\\", \\\"world.reset();alien.visible=true;world.targets\\\")\ns=s.replace(\\\"hoops:world.hoops.map(h=>h.collected)\\\",\\\"hazards:(world.hazards||[]).map(h=>h.hit),hoops:world.hoops.map(h=>h.collected)\\\")\ns=s.replace(\\\"s.hoops?.forEach\\\", \\\"s.hazards?.forEach((v,i)=>{if(world.hazards?.[i])world.hazards[i].hit=v});s.hoops?.forEach\\\")\ns=s.replace(\\\"else if(mode==='win'){winTimer+=dt;world.update(clockTime+=dt,dt);if(attract&&winTimer>5)startGame({demo:true})}\\\",\\\"else if(mode==='win'){updateEnding(dt)}\\\")\ns=s.replace(\\\"ready=true;await network.connect();\\\", \\\"camera.lookAt(-1,1,-4);await renderer.compileAsync(scene,camera);ready=true;await network.connect();\\\")\nold=\\\"advance(seconds){for(let t=0;t<seconds;t+=1/60){if(mode==='play')simulate(1/60,{x:0,z:0,sneak:false,lift:phase==='flight'});else if(mode==='signal')updateSignal(1/60);else if(mode==='title'){titleIdle+=1/60;if(titleIdle>=10)startGame({demo:true})}}updateHUD()}\\\"\nnew=\\\"advance(seconds){for(let t=0;t<seconds;t+=1/60){const dt=1/60;if(mode==='play')simulate(dt,attract?autoInput(dt):{x:0,z:0,sneak:false,lift:phase==='flight'});else if(mode==='signal'){updateSignal(dt);if(attract&&signalReady){attractTimer+=dt;if(attractTimer>.5){submitNote(pattern[signalIndex]);attractTimer=0}}}else if(mode==='win')updateEnding(dt);else if(mode==='title'){titleIdle+=dt;if(titleIdle>=10)startGame({demo:true})}}updateHUD()}\\\"\nassert old in s;s=s.replace(old,new)\ns=s.replace(\\\"network:network.info}),start:startGame\\\", \\\"hazards:world?.hazards?.map(({x,y,z,radius,hit})=>({x,y,z,radius,hit})),network:network.info}),start:startGame\\\")\np.write_text(s)\nPY\ncat > biome.json <<'EOF'\n{\\\"\"'$schema\":\"https://biomejs.dev/schemas/2.4.8/schema.json\",\"formatter\":{\"indentStyle\":\"space\",\"indentWidth\":2,\"lineWidth\":100},\"linter\":{\"enabled\":false},\"assist\":{\"enabled\":false},\"files\":{\"includes\":[\"main.js\",\"audio.js\",\"world.js\",\"network.js\",\"credits.js\",\"build.mjs\"]}}\nEOF\nbiome check --write main.js audio.js world.js network.js credits.js build.mjs\nnode --check main.js\nnode build.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
