eCheckpoint()}else if(nearby.kind==='flower'){nearby.target.healed=true;flowersHealed++;bond=clamp(bond+22,0,100);spawnRing(nearby.target.x,.2,nearby.target.z,0x9ee6bd,4);particleBurst(nearby.target.x,1,nearby.target.z,0x9fe3a6);audio.sfx('bond');say('A little kindness goes a long, long way.','THE KID',4);toast('A flower remembers how to bloom · +22 friendship')}else beginSignal();updateHUD()}\nfunction pulse(position=localPosition()){if(mode!=='play')return;if(!authority()){network.sendAction({pulse:true});return}if(phase==='flight'){audio.sfx('jump');return}if(pulseCooldown>0){toast('Let the little light catch its breath.');return}if(bond<balance.pulseCost&&!god){toast('Stay close. Friendship will find its way back.');return}if(!god&&!attract)bond-=balance.pulseCost;pulses++;pulseCooldown=3;const p=position;spawnRing(p.x,.18,p.z,0x9eeacc,8);particleBurst(p.x,1.2,p.z,0xaaf1cd,25);audio.sfx('pulse');world.agents.forEach(a=>{if(Math.hypot(a.x-p.x,a.z-p.z)<10)a.stunned=6});alert=Math.max(0,alert-45);updateHUD()}\nfunction beginSignal(){if(inventory.length!==3)return;mode='signal';showScreen('signal');signalIndex=0;signalTimer=0;signalShow=-1;signalReady=false;$('signal-seq').innerHTML=pattern.map(()=>'<span class=\"signal-dot\">·</span>').join('');$('signal-instruction').textContent='Listen to the little lights. Then send their song back.';audio.setMood('sneak');}\nfunction updateSignal(dt){signalTimer+=dt;if(!signalReady){const i=Math.floor((signalTimer-.8)/.85);if(i>=0&&i<pattern.length&&i!==signalShow){signalShow=i;signalSound(pattern[i]);[...$('signal-seq').children].forEach((e,j)=>{e.classList.toggle('lit',j===i);e.textContent=j===i?['◒','✦','☾'][pattern[i]]:'·'})}if(i>=pattern.length){signalReady=true;$('signal-instruction').textContent='Your turn. Send the lights back, one by one.';[...$('signal-seq').children].forEach((e,i)=>{e.classList.remove('lit');e.textContent=['◒','✦','☾'][pattern[i]]})}}document.querySelectorAll('[data-note]').forEach(b=>b.disabled=!signalReady)}\nfunction submitNote(n,fromNetwork=false){if(mode!=='signal'||!signalReady||!Number.isInteger(n)||n<0||n>2)return;if(!authority()&&!fromNetwork){network.sendAction({note:n});return}signalSound(n);if(n===pattern[signalIndex]){$('signal-seq').children[signalIndex].classList.add('lit');signalIndex++;if(signalIndex===pattern.length){toast('Someone out there was listening.');audio.sfx('launch');beginFlight();}}else{signalIndex=0;[...$('signal-seq').children].forEach(e=>e.classList.remove('lit'));$('signal-instruction').textContent='Almost. Try the four little symbols again. No hurry.';audio.voice('curious')}}\nfunction beginFlight(){phase='flight';mode='play';showScreen(null);$('hud').classList.remove('hidden');if(inventory.length<3){inventory=world.targets.map(t=>t.id);world.targets.forEach(t=>t.mesh.visible=false)}flightDistance=0;flightY=3;body.setGravityScale(0,true);teleport(0,-44,3);if(friendBody?.isEnabled()){friendBody.setGravityScale(0,true);friendBody.setTranslation({x:-2.5,y:3,z:-42},true);friendBody.setLinvel({x:0,y:0,z:0},true);players[1].position.set(-2.5,2.1,-42)}cameraAngle=0;audio.setMood('flight');say('Hold on. I think he has one more trick.','THE KID',6);spawnRing(0,.2,-44,0xffdb9e,12);saveCheckpoint();updatePrompts();}\nfunction winGame(){if(mode==='win')return;phase='complete';mode='win';winTimer=0;showScreen('win');$('hud').classList.add('hidden');$('dialogue').classList.add('hidden');audio.setMood('win');audio.sfx('win');$('win-stats').textContent=`${stars} / ${world.hoops.length} starlight rings · ${flowersHealed} flowers awakened · One friend, safely home.`;if(!attract){try{localStorage.removeItem('moonward-save');$('continue-button').classList.add('hidden')}catch{}}if(network.hubActive)network.finish(true,100+stars*10+flowersHealed*20);}\nfunction finishHub(){network.finish(phase==='complete',inventory.length*100+stars*10+flowersHealed*20)}\nfunction updateHUD(){if(!world)return;const objective=phase==='scavenge'?'A few things from around the block':phase==='signal'?'Find a place the sky can hear us':phase==='flight'?'The sky is ours tonight':'A little less far away';$('chapter').textContent=phase==='scavenge'?'01 / SPARE PARTS & SMALL MIRACLES':phase==='signal'?'02 / A QUESTION FOR THE STARS':'03 / OVER THE MOON';$('objective').textContent=objective;const next=world.targets.find(t=>!inventory.includes(t.id));$('subobjective').textContent=phase==='scavenge'?(next?next.name+' · follow the golden lights':''):phase==='signal'?'Ride north to the old forest clearing':`Follow the rings · ${Math.round(flightDistance)} / 184 m · Hold ${prompt('pulse')} to rise`;$('part-counter').textContent=phase==='flight'?stars+' ✦':inventory.length+' / 3';$('bond-fill').style.width=bond+'%';$('alert-banner').textContent=alert>15?'SEARCHLIGHTS NEARBY · '+(input.sneak?'KEEP QUIET':'SNEAK OR GLOW TO SLIP AWAY'):'';const near=mode==='play'?nearestInteraction():null;$('interaction').classList.toggle('hidden',!near||attract);if(near)$('interaction').innerHTML=`<b class=\"key\">${prompt('interact')}</b>${near.text}`;$('touch-action').style.display=lastInput==='touch'&&mode==='play'?'block':'none';$('touch-action').textContent=near?'HELP':phase==='flight'?'LIFT':'GLOW';drawMap();}\nfunction drawMap(){const c=mapCtx,w=220,p=localPosition();c.clearRect(0,0,w,w);c.fillStyle='#132e3b';c.fillRect(0,0,w,w);c.save();c.translate(110,110);const scale=phase==='flight'?1.8:2.25;c.scale(scale,scale);c.translate(-p.x,-p.z);c.strokeStyle='#3f5b60';c.lineWidth=4;c.beginPath();c.moveTo(0,35);c.lineTo(0,-250);c.moveTo(-35,3);c.lineTo(35,3);c.stroke();c.lineWidth=.3;world.agents.forEach(a=>{c.fillStyle=a.stunned>0?'#8cd8bb':'#eea377';c.beginPath();c.arc(a.x,a.z,1.3,0,7);c.fill()});world.targets.forEach(t=>{if(!inventory.includes(t.id)){c.fillStyle='#ffdb93';c.beginPath();c.arc(t.x,t.z,1.7,0,7);c.fill()}});if(inventory.length===3){c.strokeStyle='#a6e1cc';c.beginPath();c.arc(0,-35,2,0,7);c.stroke()}if(phase==='flight'){world.hoops.forEach(h=>{if(!h.collected){c.fillStyle='#ffdb93';c.fillRect(h.x-1,h.z-1,2,2)}})}c.fillStyle='#ffebc3';c.beginPath();c.arc(p.x,p.z,1.6,0,7);c.fill();c.restore();c.fillStyle='#9db8b9';c.font='11px sans-serif';c.textAlign='center';c.fillText('N',110,20);}\nfunction autoInput(dt){attractTimer+=dt;const p=body.translation();if(phase==='scavenge'){const target=world.targets.find(t=>!inventory.includes(t.id));if(target){const dx=target.x-p.x,dz=target.z-p.z,d=Math.hypot(dx,dz);if(d<2.4){interact();return{x:0,z:0,sneak:false,lift:false}}if(attractTimer>8){teleport(target.x,target.z+1);attractTimer=0}if(pulseCooldown===0&&alert>10)pulse();return{x:dx/Math.max(.1,d),z:dz/Math.max(.1,d),sneak:false,lift:false}}}if(phase==='signal'){const dx=-p.x,dz=-35-p.z,d=Math.hypot(dx,dz);if(d<3){beginSignal();attractTimer=0}else if(attractTimer>8){teleport(0,-33);attractTimer=0}return{x:dx/Math.max(.1,d),z:dz/Math.max(.1,d),sneak:false,lift:false}}if(phase==='flight'){const h=world.hoops.find(h=>!h.collected&&h.z<p.z);return{x:h?clamp((h.x-p.x)*.5,-1,1):0,z:0,sneak:false,lift:h?p.y<h.y:true}}return{x:0,z:0,sneak:false,lift:false};}\nfunction simulate(dt,controls){clockTime+=dt;pulseCooldown=Math.max(0,pulseCooldown-dt);elapsed+=dt;if(god||attract)bond=100;const p=body.translation();moving=Math.hypot(controls.x,controls.z)>.1;\nif(phase==='flight'){const targetY=controls.lift?8.5:2.2;const yVel=clamp((targetY-p.y)*1.8,-3,4);body.setLinvel({x:controls.x*7.8,y:yVel,z:-balance.flightSpeed*(controls.sneak?1.35:1)},true);flightDistance=Math.max(0,-p.z-44);if(lastInput==='touch'){const next=world.hoops.find(h=>!h.collected&&h.z<p.z);if(next)body.setLinvel({x:clamp((next.x-p.x)*1.3,-6,6),y:clamp((next.y-p.y)*2,-3,4),z:-balance.flightSpeed},true)}for(const h of world.hoops){if(!h.collected&&Math.abs(p.z-h.z)<2.5&&Math.hypot(p.x-h.x,p.y-h.y)<3.2){h.collected=true;h.mesh.visible=false;stars++;bond=clamp(bond+5,0,100);audio.sfx('pickup');particleBurst(h.x,h.y,h.z)}}if(p.z< -228)winGame();players[0].rotation.y=lerp(players[0].rotation.y,Math.PI+controls.x*.22,dt*5);players[0].rotation.z=lerp(players[0].rotation.z,-controls.x*.2,dt*3);\n}else{const speed=controls.sneak?balance.sneakSpeed:balance.rideSpeed;const vel=body.linvel();body.setLinvel({x:controls.x*speed,y:vel.y,z:controls.z*speed},true);if(moving){let target=Math.atan2(controls.x,controls.z);let d=THREE.MathUtils.euclideanModulo(target-players[0].rotation.y+Math.PI,Math.PI*2)-Math.PI;players[0].rotation.y+=d*Math.min(1,dt*9)}players[0].rotation.z=0;bond=clamp(bond+balance.bondRegen*dt,0,100);let detected=false;world.agents.forEach(a=>{a.stunned=Math.max(0,a.stunned-dt);a.mesh.position.set(a.x,0,a.z);if(a.stunned>0)return;const dx=p.x-a.x,dz=p.z-a.z,dist=Math.hypot(dx,dz);const dirX=Math.sin(a.mesh.rotation.y),dirZ=Math.cos(a.mesh.rotation.y);const cone=(dx*dirX+dz*dirZ)/Math.max(.1,dist)>.65;if(dist<(controls.sneak?3:7.8)&&cone){detected=true;bond-=dt*balance.alertRate*(controls.sneak?.2:1);if(alert<8)audio.sfx('alert');alert=clamp(alert+dt*40,0,100)}});if(!detected)alert=Math.max(0,alert-dt*28);if((god||attract)&&bond<100)bond=100;if(bond<=0){catchCount++;bond=75;alert=0;teleport(0,18);say('We lost them. Let’s take the quiet way this time.','THE KID',6);toast('Safe in the garden · borrowed parts kept')}for(const candy of world.candies){if(!candy.collected&&Math.hypot(candy.x-p.x,candy.z-p.z)<1.5){candy.collected=true;candy.mesh.visible=false;bond=clamp(bond+10,0,100);audio.sfx('pickup');particleBurst(candy.x,.8,candy.z,0xeebd90,8)}}}\nconst friendControls=seatControls(1);prepareFriend(dt,friendControls);physics.timestep=dt;physics.step();const np=body.translation();if(phase!=='flight'){if(Math.abs(np.x)>34||np.z>34||np.z< -42)body.setTranslation({x:clamp(np.x,-34,34),y:np.y,z:clamp(np.z,-42,34)},true)}else if(Math.abs(np.x)>16)body.setTranslation({x:clamp(np.x,-16,16),y:np.y,z:np.z},true);players[0].position.set(np.x,np.y-.9,np.z);players[0].userData.mixer.timeScale=phase==='flight'?1.5:moving?1:.15;players[0].userData.mixer.update(dt);\nconst follow=phase==='flight'?new THREE.Vector3(0,1.6,.95).applyAxisAngle(new THREE.Vector3(0,1,0),players[0].rotation.y).add(players[0].position):new THREE.Vector3(np.x+1.3,.1,np.z+1.5);alien.position.lerp(follow,Math.min(1,dt*(phase==='flight'?15:3)));alien.scale.setScalar(phase==='flight'?.65:1);alien.rotation.y=phase==='flight'?Math.PI:players[0].rotation.y;alien.userData.mixer.timeScale=phase==='flight'?.2:moving?1:.2;alien.userData.mixer.update(dt);world.flowers.forEach(f=>{if(f.healed){f.mesh.scale.lerp(new THREE.Vector3(1.4,1.4,1.4),dt*2)}});\nupdateFriend(dt,friendControls);\nworld.update(clockTime,dt);updateEffects(dt);updateTrail();}\nfunction updateEffects(dt){for(let i=effects.length-1;i>=0;i--){const e=effects[i];e.t+=dt;const f=e.t/e.duration;if(e.v){e.mesh.position.addScaledVector(e.v,dt);e.v.y-=dt*3;e.mesh.rotation.x+=dt*3}else e.mesh.scale.setScalar(lerp(.1,e.size,f));e.mesh.material.opacity=1-f;if(f>=1){scene.remove(e.mesh);e.mesh.geometry.dispose();e.mesh.material.dispose();effects.splice(i,1)}}}\nfunction updateTrail(){const p=localPosition();const target=phase==='scavenge'?world.targets.find(t=>!inventory.includes(t.id)):phase==='signal'?{x:0,z:-35}:null;trail.forEach((m,i)=>{m.visible=!!target;if(target){const a=(i+1)/(trail.length+2);m.position.set(lerp(p.x,target.x,a),.2+Math.sin(clockTime*2+i)*.08,lerp(p.z,target.z,a));m.scale.setScalar(.7+Math.sin(clockTime*3+i*.5)*.2)}})}\nfunction snapshot(){return{mode:['pause','settings','about','coop','dev'].includes(mode)?'pause':mode,pausedFrom,phase,bond,inventory,flowersHealed,stars,pulses,elapsed,alert,flightDistance,clockTime,signalIndex,signalTimer,signalShow,signalReady,players:players.map(p=>({x:p.position.x,y:p.position.y,z:p.position.z,r:p.rotation.y,roll:p.rotation.z,visible:p.visible})),alien:{x:alien.position.x,y:alien.position.y,z:alien.position.z,r:alien.rotation.y,scale:alien.scale.x},agents:world.agents.map(a=>({x:a.x,z:a.z,r:a.mesh.rotation.y,stunned:a.stunned})),flowers:world.flowers.map(f=>f.healed),candies:world.candies.map(c=>c.collected),hoops:world.hoops.map(h=>h.collected)}}\nfunction applySnapshot(s){if(!ready||authority()||!s||network.info.ended)return;const previousPhase=phase,previousInventory=inventory.length,previousPulses=pulses,previousShow=signalShow;phase=s.phase;bond=s.bond;inventory=s.inventory||[];flowersHealed=s.flowersHealed;stars=s.stars;pulses=s.pulses;elapsed=s.elapsed;alert=s.alert;flightDistance=s.flightDistance;clockTime=s.clockTime??clockTime;pausedFrom=s.pausedFrom||'play';if(s.mode==='win'){if(mode!=='win')winGame()}else if(s.mode==='signal'){if(mode!=='signal'){mode='signal';showScreen('signal');$('signal-seq').innerHTML=pattern.map(()=>'<span class=\"signal-dot\">·</span>').join('')}signalIndex=s.signalIndex??0;signalTimer=s.signalTimer??0;signalShow=s.signalShow??-1;signalReady=!!s.signalReady;[...$('signal-seq').children].forEach((e,i)=>{e.classList.toggle('lit',signalReady?i<signalIndex:i===signalShow);e.textContent=signalReady||i===signalShow?['◒','✦','☾'][pattern[i]]:'·'});$('signal-instruction').textContent=signalReady?'Your turn. Send the lights back, one by one.':'Listen to the little lights. Then send their song back.';document.querySelectorAll('[data-note]').forEach(b=>b.disabled=!signalReady);if(!signalReady&&signalShow>=0&&signalShow!==previousShow)signalSound(pattern[signalShow]);$('hud').classList.remove('hidden')}else if(s.mode==='pause'){if(!['pause','settings','about','coop','dev'].includes(mode)){mode='pause';showScreen('pause')}$('hud').classList.add('hidden')}else if(s.mode==='play'){if(mode!=='play'){mode='play';showScreen(null);$('hud').classList.remove('hidden')}}else if(s.mode==='title'||s.mode==='waiting'){if(mode!=='waiting'){mode='waiting';showScreen(null);$('hud').classList.add('hidden');toast('Your friend is choosing the next adventure.')}}s.players?.forEach((p,i)=>{if(players[i]){players[i].position.set(p.x,p.y,p.z);players[i].rotation.set(0,p.r,p.roll||0);players[i].visible=p.visible;if(i===0)body.setTranslation({x:p.x,y:p.y+.9,z:p.z},true)}});if(s.alien){alien.position.set(s.alien.x,s.alien.y,s.alien.z);alien.rotation.y=s.alien.r||0;alien.scale.setScalar(s.alien.scale||1)}s.agents?.forEach((a,i)=>{const target=world.agents[i];if(target){target.x=a.x;target.z=a.z;target.stunned=a.stunned;target.mesh.position.set(a.x,0,a.z);target.mesh.rotation.y=a.r}});world.targets.forEach(t=>t.mesh.visible=!inventory.includes(t.id));s.flowers?.forEach((v,i)=>{if(world.flowers[i])world.flowers[i].healed=v});s.candies?.forEach((v,i)=>{if(world.candies[i]){world.candies[i].collected=v;world.candies[i].mesh.visible=!v}});s.hoops?.forEach((v,i)=>{if(world.hoops[i]){world.hoops[i].collected=v;world.hoops[i].mesh.visible=!v}});if(inventory.length>previousInventory)audio.sfx('pickup');if(pulses>previousPulses){const p=localPosition();spawnRing(p.x,.2,p.z,0x9eeacc,8);audio.sfx('pulse')}if(phase!==previousPhase){updatePrompts();audio.setMood(phase==='flight'?'flight':'explore');if(phase==='flight')cameraAngle=0}lastRemoteMode=s.mode;updateHUD()}\nfunction updateCamera(dt){if(!body)return;const hero=players[currentSlot()]?.visible?players[currentSlot()]:players[0],p=hero.position;let target,look;if(mode==='title'){target=new THREE.Vector3(21,15,32);look=new THREE.Vector3(-1,1,-4)}else if(phase==='flight'){target=new THREE.Vector3(p.x*.6+1,p.y+8,p.z+19);look=new THREE.Vector3(p.x,p.y+1,p.z-13)}else if(mode==='win'){target=new THREE.Vector3(13,11,-210);look=new THREE.Vector3(0,4,-235)}else{target=new THREE.Vector3(p.x+Math.sin(cameraAngle)*22,p.y+19,p.z+Math.cos(cameraAngle)*22);look=new THREE.Vector3(p.x,1.2,p.z-4)}camera.position.lerp(target,Math.min(1,dt*3));camera.lookAt(look)}\nfunction frame(now){if(!ready)return;const dt=Math.min((now-lastFrame)/1000||.016,.06);lastFrame=now;const controls=readInput(dt)||neutralControls();input.sneak=controls.sneak;if(network.active&&network.running&&!network.isServer)network.sendInput(mode==='play'?controls:neutralControls());if(authority()&&network.running)processRemoteActions();if(mode==='title'&&!network.hubActive&&authority()){titleIdle+=dt;world.update(clockTime+=dt,dt);alien.userData.mixer.update(dt*.2);if(titleIdle>=10)startGame({demo:true})}if(mode==='play'&&network.running){if(authority()){const c=attract?autoInput(dt):seatControls(0,controls);accumulator+=dt;let count=0;while(accumulator>=1/60&&count++<4){simulate(1/60,c);accumulator-=1/60}}else{world.update(clockTime,dt);players.forEach(p=>p.userData.mixer.update(dt));alien.userData.mixer.update(dt);updateEffects(dt);updateTrail()}}else if(mode==='signal'&&authority()&&network.running){updateSignal(dt);if(attract&&signalReady){attractTimer+=dt;if(attractTimer>.5){submitNote(pattern[signalIndex]);attractTimer=0}}}else if(mode==='win'){winTimer+=dt;world.update(clockTime+=dt,dt);if(attract&&winTimer>5)startGame({demo:true})}if(authority()&&network.active&&network.running)network.broadcast(snapshot());if(dialogueTimer>0){dialogueTimer-=dt;if(dialogueTimer<=0)$('dialogue').classList.add('hidden')}if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)$('toast').classList.add('hidden')}if(mode!=='ended')audio.update(dt);if(!network.isServer)updateCamera(dt);if(mode==='play')updateHUD();renderer.render(scene,camera);requestAnimationFrame(frame)}let lastFrame=performance.now();\nasync function init(){try{await RAPIER.init();physics=new RAPIER.World({x:0,y:-18,z:0});scene=new THREE.Scene();scene.background=new THREE.Color(0x15283d);scene.fog=new THREE.Fog(0x15283d,65,155);camera=new THREE.PerspectiveCamera(48,innerWidth/innerHeight,.1,400);camera.position.set(21,15,32);renderer=new THREE.WebGPURenderer({canvas:$('world'),antialias:true,alpha:false,forceWebGL:new URLSearchParams(location.search).has('webgl')});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.2;await renderer.init();const data=new Uint8Array([65,135,205,255]);gradient=new THREE.DataTexture(data,4,1,THREE.RedFormat);gradient.needsUpdate=true;gradient.minFilter=gradient.magFilter=THREE.NearestFilter;world=buildWorld(THREE,scene,physics,{RAPIER,gradient});const ground=physics.createRigidBody(RAPIER.RigidBodyDesc.fixed());physics.createCollider(RAPIER.ColliderDesc.cuboid(75,.2,180).setTranslation(0,-.2,-100),ground);body=physics.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,1.25,18).lockRotations().setLinearDamping(6).setCcdEnabled(true));physics.createCollider(RAPIER.ColliderDesc.capsule(.4,.46).setFriction(0).setRestitution(0),body);players=[makeCharacter(),makeCharacter(false,0x79a9a2)];players.forEach(p=>scene.add(p));players[1].visible=false;players[1].position.set(-2,.1,19);alien=makeCharacter(true);scene.add(alien);for(let i=0;i<12;i++){const m=new THREE.Mesh(new THREE.OctahedronGeometry(.075),new THREE.MeshBasicMaterial({color:0xffd789}));scene.add(m);trail.push(m)}teleport(0,18);renderCredits($('credits-content'));for(const [id,value] of Object.entries({music:settings.music??10,sfx:settings.sfx??75,camera:Math.round((settings.cameraSensitivity??1)*100)})){$(id).value=value;$(id).dispatchEvent(new Event('input'))}glyphs=settings.glyphs||'ps';captions=settings.captions??true;$('glyph-toggle').textContent=glyphs==='ps'?'PlayStation':'Xbox';$('captions-toggle').textContent=captions?'On':'Off';try{if(localStorage.getItem('moonward-save'))$('continue-button').classList.remove('hidden')}catch{}ready=true;await network.connect();network.ready();$('loading').classList.add('hidden');if(!network.hubActive){showScreen('title');}else{mode='waiting';showScreen(null)}updatePrompts();requestAnimationFrame(frame);window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});}catch(error){console.error(error);$('loading-message').textContent='This little world could not start: '+error.message;const b=document.createElement('button');b.className='pill';b.textContent='Try again';b.onclick=()=>location.reload();$('loading').append(b);}}\nwindow.__game={getState:()=>({ready,mode,phase,players:players.map(p=>({x:p.position.x,y:p.position.y,z:p.position.z,visible:p.visible})),localPlayer:localPosition(),attract,lastInput,inputMode:lastInput,player:body?body.translation():null,inventory:[...inventory],bond,alert,stars,flowersHealed,pulses,pulseCooldown,signalReady,signalIndex,pattern:[...pattern],flightDistance,elapsed,balance:{...balance},god,targets:world?.targets.map(({id,name,x,z})=>({id,name,x,z})),flowers:world?.flowers.map(({x,z,healed})=>({x,z,healed})),hoops:world?.hoops.map(({x,y,z,collected})=>({x,y,z,collected})),network:network.info}),start:startGame,advance(seconds){for(let t=0;t<seconds;t+=1/60){if(mode==='play')simulate(1/60,{x:0,z:0,sneak:false,lift:phase==='flight'});else if(mode==='signal')updateSignal(1/60);else if(mode==='title'){titleIdle+=1/60;if(titleIdle>=10)startGame({demo:true})}}updateHUD()},teleport,interact,pulse,dev:devAction,submitNote,beginSignal,beginFlight,pause,resume,toTitle,renderInfo:()=>({backend:renderer?.backend?.isWebGPUBackend?'WebGPU':'WebGL2',three:THREE.REVISION,rapier:RAPIER.version(),animationMixers:players.length+1,drawCalls:renderer?.info?.render?.calls}),audioDebug:()=>audio.debug(),audio,network,snapshot};\ninit();\n","exit_code":0,"status":"completed"}}
