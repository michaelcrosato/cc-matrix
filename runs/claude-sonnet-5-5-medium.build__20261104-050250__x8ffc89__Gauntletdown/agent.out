ar(g, x + w - 34, y + 4, 30, 3, h.amuletT / 20, AMULET_COLn(h.amulet)); E.font.text(g, AMULET_NAMES[h.amulet], x + w - 34, y + 9, AMULET_COL[h.amulet], { font: 'tiny' }); }\n    let px0 = x + 33; for (const k in h.specials) { px.rect(g, px0, y + 31, 4, 2, SPECIAL_COL[k]); px0 += 6; }\"\"\")\ns=s.replace(\"AMULET_COLn(h.amulet)\",\"AMULET_COL[h.amulet]\")\ns=s.replace(\"E.font.text(g, String(h.score), x + 33, y + 26, '#c8c0e0', { font: 'tiny' });\",\"E.font.text(g, String(h.score), x + 33, y + 25, '#c8c0e0', { font: 'tiny' });\")\ns=s.replace(\"E.font.text(g, h.name2 || h.C.name, sx, sy - 9, col, { align: 'center', outline: '#000', font: 'tiny' });\",\"E.font.text(g, 'P' + (h.slot + 1), sx, sy - 9, col, { align: 'center', outline: '#000', font: 'tiny' });\")\nopen(p,'w').write(s)\np='game/src/50-play.js'\ns=open(p).read()\ns=s.replace(\"camera: { zoom: [.75, 1.5], start: 1, tall: 1.25 }\",\"camera: { zoom: [.55, 1.5], start: .8, tall: 1.25 }\")\ns=s.replace(\"zoom: [.8, 1] });\\n  game.setZoom && game.setZoom(1);\",\"zoom: [.6, .8] });\\n  game.setZoom && game.setZoom(.8);\")\ns=s.replace(\"else game.cam.frame(list, { margin: 64, zoom: [.8, 1] });\",\"else game.cam.frame(list, { margin: 64, zoom: [.5, .8] });\")\nopen(p,'w').write(s)\np='game/src/40-front.js'\ns=open(p).read()\ns=s.replace(\"E.font.title(g, 'GAUNTLET', cx, 40, { scale: 4,\",\"E.font.title(g, 'GAUNTLET', cx, 22, { scale: 3,\").replace(\"E.font.title(g, 'DOWN', cx, 84, { scale: 4,\",\"E.font.title(g, 'DOWN', cx, 56, { scale: 3,\").replace(\"cx, 124, '#c8b8e0'\",\"cx, 92, '#c8b8e0'\").replace(\"'PRESS ' + glyph('confirm').toUpperCase(), cx, 150,\",\"'PRESS ' + glyph('confirm').toUpperCase(), cx, 108,\").replace(\"cx, 150, '#ffd860', { align: 'center', scale: 2, shadow: '#000' }\",\"cx, 108, '#ffd860', { align: 'center', scale: 2, shadow: '#000' }\")\nopen(p,'w').write(s)\nEOF\nnode build.mjs && node tests/shot.mjs play2 \"__gd.game.debug.startRun([0,1,2,3]); 0\" 14000"},"caller":{"type":"direct"}}],"con