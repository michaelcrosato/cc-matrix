{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,pathlib\np=pathlib.Path('.');project=json.loads((p/'project.json').read_text());html=(p.parent/(project['stem']+'.html')).read_text();interview=json.loads((p.parent/'exit-interview.json').read_text());feedback=json.loads((p/'feedback.json').read_text())\nassert set(interview)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'}\nassert len(interview['testingFeedback'])==4 and len(interview['engineFeedback'])==6 and len(interview['promptFeedback'])==4\nassert interview['sourceInformation']['usage']=='added on import'\nassert all(interview[k]==feedback[k] for k in feedback)\nassert html.split('<script>',1)[1].split('</script>',1)[0].strip()==(p/'hub/session.js').read_text().strip()\nassert all(f'name=\\\"hub:{k}\\\"' in html for k in ['session','session-players','session-mode','session-goal','session-howto'])\nassert 'testing in progress' not in html\nassert html.count('<canvas')==2\nassert (p/'project.json').exists() and (p/'package-lock.json').exists()\nassert len(interview['aiHub']['tags'])==6\nassert interview['aiHub']['name']==project['title']\nprint('Packaged HTML, exact Hub client, complete credits, and exit interview validated.')\nprint(f'HTML size: {len(html.encode()):,} bytes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
