{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > template.html <<'EOF'\n<\"'!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">\n<!--HUB_SESSION-->\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"ai-hub\" content=\"players=1-2;mode=shared-world;genre=Flight;webgpu=required\">\n<meta name=\"ai-hub-goal\" content=\"Defend the shield, trip the walkers, and escort two transports through the blockade.\">\n<meta name=\"ai-hub-howto\" content=\"Left stick move, right stick aim, R2 fire, L2 boost, Cross tow/rescue, Circle roll. WASD, mouse, Shift, E, Space.\">\n<meta name=\"ai-hub-minutes\" content=\"6\">\n<title>The Empire Strikes a Detour</title>\n<style>\n:root{--ink:#112d39;--paper:#eef3ec;--ice:#b6d7df;--orange:#f66936;--dim:#718c93;--yellow:#f6cd7b}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#b5d2dc;color:var(--ink);font-family:Arial,Helvetica,sans-serif;user-select:none}button,input,select{font:inherit}button{cursor:pointer}#view{position:absolute;inset:0;width:100%;height:100%;display:block}#grain{position:absolute;inset:0;pointer-events:none;opacity:.11;background:repeating-linear-gradient(0deg,transparent 0 3px,#12303b18 3px 4px);mix-blend-mode:multiply}#vignette{position:absolute;inset:0;pointer-events:none;box-shadow:inset 0 0 160px #153d5740}#ui{position:absolute;inset:0;pointer-events:none}button,input,select,a{pointer-events:auto}button{border:2px solid var(--ink);border-radius:2px;background:var(--paper);color:var(--ink);padding:15px 25px;font-size:20px;font-weight:800;letter-spacing:.06em;transition:background .12s,transform .12s,box-shadow .12s;box-shadow:4px 4px 0 #112d3925;text-transform:uppercase}button:hover,button:focus-visible,button.focused{outline:0;background:var(--yellow);transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}button.primary{background:var(--orange);color:#fff8eb}button:disabled{opacity:.45;pointer-events:none}.eyebrow{font-size:14px;letter-spacing:.24em;font-weight:800;text-transform:uppercase}.muted{color:#5c777f}.orange{color:var(--orange)}.screen{pointer-events:auto;position:absolute;inset:0;display:none}.screen.show{display:flex}.title-screen{padding:6vh 6vw;background:linear-gradient(90deg,#dce9e5f5 0%,#dce9e5ee 28%,#dce9e580 47%,transparent 64%);flex-direction:column;justify-content:center;align-items:flex-start}.brand-mark{display:flex;align-items:center;gap:12px;margin-bottom:22px}.brand-icon{width:36px;height:36px;background:var(--orange);clip-path:polygon(50% 0,100% 90%,60% 65%,50% 100%,40% 65%,0 90%)}h1{font-family:Impact,'\"'Arial Black',sans-serif;font-weight:900;font-size:clamp(46px,6.6vw,112px);line-height:.88;letter-spacing:-.02em;margin:0 0 24px;max-width:640px;text-shadow:2px 3px 0 #eff6e6}h1 span{display:block}h1 .detour{color:var(--orange);font-size:1.22em;letter-spacing:.01em}.title-sub{font-size:20px;line-height:1.5;max-width:440px;margin:0 0 25px}.title-nav{display:flex;flex-direction:column;gap:10px;width:320px}.title-nav button{text-align:left;display:flex;justify-content:space-between}.title-nav .minor{background:#eef3ecd9;font-size:16px;padding:11px 22px}.title-footer{position:absolute;bottom:3vh;left:6vw;font-size:12px;letter-spacing:.15em}.sector-stamp{position:absolute;right:4vw;top:5vh;text-align:right;border-top:3px solid var(--ink);padding-top:12px;font-weight:800;line-height:1.7;letter-spacing:.15em;font-size:13px}.sector-stamp b{display:block;font-size:32px;letter-spacing:.04em}.boot{position:absolute;inset:0;background:var(--ink);color:var(--paper);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;z-index:100}.boot-mark{width:80px;height:4px;background:var(--orange);animation:load 1.5s infinite}@keyframes load{50%{width:240px}}#bootError{max-width:650px;text-align:center;padding:24px;font-size:20px;line-height:1.5}.hud{position:absolute;inset:0;display:none}.hud.show{display:block}.hud-top{display:flex;justify-content:space-between;align-items:flex-start;padding:30px 34px;gap:24px}.pilot-card{min-width:230px}.pilot-name{font-size:12px;font-weight:900;letter-spacing:.2em}.health-line{display:flex;gap:10px;align-items:center;margin-top:8px}.health-track{width:175px;height:12px;transform:skew(-16deg);background:#17334128;border:2px solid var(--ink)}.health-track i{display:block;height:100%;background:var(--orange);width:100%}.hp-value{font-weight:900;font-size:20px}.heat-track{height:4px;width:172px;background:#17334125;margin-top:8px}.heat-track i{display:block;background:var(--ink);height:100%;width:0}.objective{background:#eff4ebe8;border:2px solid var(--ink);padding:14px 24px;text-align:center;box-shadow:5px 5px 0 #17334120;min-width:340px;max-width:510px}.objective .eyebrow{font-size:11px;color:var(--orange)}.objective strong{display:block;font-size:23px;margin:6px 0}.objective small{font-size:14px;font-weight:700}.score-card{text-align:right;min-width:180px}.score-card strong{display:block;font-size:34px;font-family:Impact,'Arial Black',sans-serif;letter-spacing:.06em}.score-card .eyebrow{font-size:10px}#pauseBtn{position:absolute;top:120px;right:34px;padding:8px 12px;font-size:17px;background:#eef3ecbc}.shield-panel{position:absolute;left:34px;top:130px;font-size:12px;letter-spacing:.12em;font-weight:800}.shield-dots{display:flex;gap:3px;margin-top:7px}.shield-dots i{width:14px;height:6px;background:var(--ink)}.shield-dots i.off{opacity:.15}#radio{position:absolute;bottom:100px;left:34px;max-width:480px;transition:opacity .4s}.radio-label{background:var(--orange);color:#fff7e9;font-weight:900;padding:6px 10px;font-size:11px;letter-spacing:.2em;display:inline-block}.radio-text{background:#eef3eceb;border-left:3px solid var(--orange);padding:13px 18px;font-size:19px;line-height:1.45;box-shadow:4px 4px 0 #112d3915}.control-strip{position:absolute;left:34px;bottom:30px;display:flex;gap:20px;flex-wrap