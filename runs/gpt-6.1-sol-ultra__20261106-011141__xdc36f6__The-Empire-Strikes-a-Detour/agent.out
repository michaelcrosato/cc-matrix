red: 0xff5149,\n};\nconst cache = new Map();\nfunction mat(hex, glow = false) {\n  const key = `${hex}-${glow}`;\n  if (cache.has(key)) return cache.get(key);\n  let m;\n  if (glow) m = new THREE.MeshBasicNodeMaterial({ color: hex });\n  else {\n    m = new THREE.MeshStandardNodeMaterial({ color: hex, roughness: 0.9, metalness: 0.03, flatShading: true });\n    const band = normalWorld.dot(vec3(-0.45, 0.85, 0.3)).mul(0.5).add(0.5).mul(4).floor().div(4).mul(0.42).add(0.58);\n    m.colorNode = color(hex).mul(band);\n  }\n  cache.set(key, m);\n  return m;\n}\nconst ink = new THREE.MeshBasicNodeMaterial({ color: palette.ink, side: THREE.BackSide });\nconst boxGeo = new THREE.BoxGeometry(1, 1, 1);\nconst sphereGeo = new THREE.IcosahedronGeometry(1, 1);\nfunction mesh(geo, material, parent, p = [0,0,0], s = [1,1,1], outline = true) {\n  const o = new THREE.Mesh(geo, typeof material === 'number' ? mat(material) : material);\n  o.position.set(...p); o.scale.set(...s); o.castShadow = true; o.receiveShadow = true;\n  if (outline) {\n    const hull = new THREE.Mesh(geo, ink); hull.scale.setScalar(1.035); hull.castShadow = false; o.add(hull);\n  }\n  if (parent) parent.add(o);\n  return o;\n}\nfunction box(parent,p,s,c,outline=true) { return mesh(boxGeo,c,parent,p,s,outline); }\nfunction cyl(parent,p,r1,r2,h,c,n=12,outline=true) {\n  return mesh(new THREE.CylinderGeometry(r1,r2,h,n,1),c,parent,p,[1,1,1],outline);\n}\nfunction ball(parent,p,s,c,outline=true) {return mesh(sphereGeo,c,parent,p,s,outline);}\nfunction mark(parent,p,s,c) {return box(parent,p,s,mat(c,true),false);}\nfunction stripe(parent,x,y,z,w,d,c) { return mark(parent,[x,y,z],[w,.045,d],c); }\nfunction triangleWing(parent, x, z, side, c) {\n  const shape = new THREE.Shape();\n  shape.moveTo(0,-5.8); shape.lineTo(side * 7.1,1.8); shape.lineTo(side * 6.3,3.7); shape.lineTo(0,2.1); shape.closePath();\n  const geo = new THREE.ExtrudeGeometry(shape,{depth:.68,bevelEnabled:false});\n  geo.rotateX(-Math.PI/2);\n  return mesh(geo,c,parent,[x,0,z]);\n}\nfunction exhaust(parent,x,y,z,size=1) {\n  const root = new THREE.Group(); root.position.set(x,y,z); parent.add(root);\n  const a=mesh(new THREE.ConeGeometry(.68*size,4*size,10),mat(palette.cyan,true),root,[0,0,1.7*size],[1,1,1],false);a.rotation.x=Math.PI/2;\n  const b=mesh(new THREE.ConeGeometry(.36*size,5*size,8),mat(0xf4fff7,true),root,[0,0,2*size],[1,1,1],false);b.rotation.x=Math.PI/2;\n  root.userData.flame=true; return root;\n}\nexport function createSpeeder(accent = palette.orange) {\n  const g = new THREE.Group(); g.name='Snow speeder';\n  triangleWing(g,0,0,1,palette.snow); triangleWing(g,0,0,-1,palette.snow);\n  const body=box(g,[0,.5,-.5],[3.4,1.5,7.6],palette.snow); body.rotation.x=-.05;\n  box(g,[0,1.45,-.3],[2.15,1.35,3.8],palette.dark);\n  box(g,[0,2.12,-1.5],[1.9,.09,1.2],0xa8dfdf);\n  box(g,[0,1.45,1.45],[2.5,.9,1],accent);\n  box(g,[0,2.2,.05],[.12,.13,3.6],palette.snow);\n  for(const s of [-1,1]) {\n    box(g,[s*5.7,.32,-.15],[1.18,1.45,8.4],palette.armor);\n    box(g,[s*5.7,.5,-5.15],[.43,.43,4.6],palette.dark);\n    cyl(g,[s*5.7,.3,3.4],.75,.75,1.5,palette.dark,10).rotation.x=Math.PI/2;\n    box(g,[s*3.55,.49,-.15],[1.2,.14,3.8],accent);\n    box(g,[s*3.55,.56,1.2],[1.25,.1,.2],palette.ink,false);\n    box(g,[s*3.55,.56,1.65],[1.25,.1,.2],palette.ink,false);\n    exhaust(g,s*5.7,.3,4,0.7);\n  }\n  box(g,[0,.7,3.8],[.5,.4,2],palette.dark);\n  g.userData.flames=[];g.traverse(o=>{if(o.userData.flame)g.userData.flames.push(o);});\n  return g;\n}\n\nexport function createWalker() {\n  const root=new THREE.Group();root.name='Imperial siege walker';\n  const body=new THREE.Group();body.name='WalkerBody';root.add(body);\n  box(body,[0,20.2,0],[10.8,8.1,15.8],palette.armor);\n  box(body,[0,23.9,-1.2],[11.7,1.7,11],palette.armor);\n  box(body,[0,16.1,0],[7.7,1.1,12.3],palette.dark);\n  for(const s of [-1,1]) {\n    box(body,[s*5.6,20.7,.4],[.5,4.4,13],0x94a9a5);\n    for(let j=0;j<5;j++)box(body,[s*5.91,21.7,-4+j*2.1],[.12,1.7,1.13],palette.steel,false);\n    for(let j=0;j<4;j++)box(body,[s*5.94,18.8,-3.5+j*2.7],[.15,.22,1.9],palette.dark,false);\n    box(body,[s*4.7,24.95,1],[.18,.15,10],palette.dark,false);\n  }\n  box(body,[0,21.4,8.2],[7,4.4,1.2],palette.dark);\n  for(let i=-2;i<=2;i++)box(body,[i*1.2,21.6,8.87],[.5,2.7,.2],palette.ink,false);\n  const neck=box(body,[0,21.1,-9.5],[3.9,3.1,4.4],palette.dark);\n  for(let i=0;i<5;i++)box(body,[0,21.1,-8-i*.65],[4.2,3.35,.18],palette.steel,false);\n  const head=new THREE.Group();head.name='WalkerHead';head.position.set(0,20.5,-13);body.add(head);\n  box(head,[0,.1,0],[7.4,4.9,6.7],palette.armor);\n  box(head,[0,1.65,-3.5],[6.8,.56,.2],mat(palette.red,true),false);\n  box(head,[0,-2.8,-1.9],[5.8,.9,4.4],palette.dark);\n  for(const s of [-1,1]) {\n    const cannon=cyl(head,[s*1.7,-2.7,-4.9],.4,.5,5.4,palette.ink,8);cannon.rotation.x=Math.PI/2;\n    const cheek=cyl(head,[s*4.1,-.5,-1.7],.52,.8,4,palette.dark,10);cheek.rotation.x=Math.PI/2;\n  }\n  const legs=[];\n  for(let i=0;i<4;i++) {\n    const side=i%2?1:-1,z=i<2?-5:5;\n    const leg=new THREE.Group();leg.name='WalkerLeg'+i;leg.position.set(side*4.6,17.6,z);root.add(leg);\n    cyl(leg,[side*.4,0,0],1.55,1.55,2.3,palette.dark,12).rotation.z=Math.PI/2;\n    box(leg,[side*.5,-4,0],[1.9,7.3,2.1],palette.armor);\n    const joint=cyl(leg,[side*.5,-7.5,.2],1.75,1.75,2.15,palette.steel,12);joint.rotation.z=Math.PI/2;\n    box(leg,[side*.5,-11.2,.5],[1.6,6.6,1.7],palette.armor);\n    box(leg,[side*.5,-11.2,-.41],[.8,5.7,.2],palette.dark,false);\n    cyl(leg,[side*.5,-14.8,.5],1.05,1.45,1.6,palette.dark,10);\n    box(leg,[side*.5,-16,.2],[4.25,1.75,5.5],palette.armor);\n    box(leg,[side*.5,-15.14,-.2],[3.9,.22,3.6],palette.snow,false);\n    legs.push(leg);\n  }\n  const tracks=[]; const times=[0,.7,1.4,2.1,2.8];\n  for(let i=0;i<4;i++) {\n    const a=i===0||i===3?1:-1;\n    tracks.push(new THREE.NumberKeyframeTrack('WalkerLeg'+i+'.rotation[x]',times,[.13*a,-.13*a,.13*a,-.13*a,.13*a]));\n  }\n  tracks.push(new THREE.NumberKeyframeTrack('WalkerBody.position[y]',times,[0,.22,0,.22,0]));\n  tracks.push(new THREE.NumberKeyframeTrack('WalkerHead.rotation[y]',[0,2,4,6],[-.07,.08,.04,-.07]));\n  const mixer=new THREE.AnimationMixer(root);mixer.clipAction(new THREE.AnimationClip('Heavy marching',2.8,tracks.slice(0,5))).play();\n  mixer.clipAction(new THREE.AnimationClip('Scanner sweep',6,tracks.slice(5))).play();\n  root.userData.mixer=mixer;root.userData.legs=legs;root.userData.body=body;root.userData.head=head;\n  return root;\n}\n\nexport function createProbe() {\n  const g=new THREE.Group();g.name='Patrol probe';\n  const rotor=new THREE.Group();rotor.name='ProbeRotor';g.add(rotor);\n  ball(rotor,[0,0,0],[2.4,1.8,2.4],palette.dark);\n  cyl(rotor,[0,1.35,0],1.75,2.5,.9,palette.armor,10);\n  cyl(rotor,[0,2,0],.6,.6,.55,palette.dark,10);\n  for(let i=0;i<5;i++) {\n    const a=i/5*Math.PI*2;\n    const arm=new THREE.Group();arm.rotation.y=a;rotor.add(arm);\n    box(arm,[1.5,-2,0],[.33,3.7,.35],palette.dark);\n    const foot=box(arm,[2,-3.4,0],[1.7,.3,.4],palette.steel);foot.rotation.z=-.5;\n  }\n  for(let i=0;i<3;i++)ball(rotor,[-.9+i*.9,.2,-1.9],[.34,.34,.2],mat(i===1?palette.red:0xffbd65,true));\n  const mix=new THREE.AnimationMixer(g);\n  mix.clipAction(new THREE.AnimationClip('Hover scanner',3,[\n    new THREE.NumberKeyframeTrack('ProbeRotor.rotation[y]',[0,3],[0,Math.PI*2]),\n    new THREE.NumberKeyframeTrack('ProbeRotor.position[y]',[0,1.5,3],[0,.7,0])\n  ])).play();g.userData.mixer=mix;\n  return g;\n}\n\nexport function createTransport() {\n// All sounds are synthesized. No recordings, speech samples, or audio downloads.\nconst midi = n => 440 * 2 ** ((n - 69) / 12);\nconst clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, Number(v) || 0));\nconst noiseCache = new WeakMap();\nfunction noiseBuffer(ctx) {\n  if (noiseCache.has(ctx)) return noiseCache.get(ctx);\n  const b = ctx.createBuffer(1, Math.ceil(ctx.sampleRate * 2), ctx.sampleRate);\n  const d = b.getChannelData(0);\n  let seed = 17691;\n  for (let i = 0; i < d.length; i++) {\n    seed = (seed * 16807) % 2147483647;\n    d[i] = seed / 1073741823.5 - 1;\n  }\n  noiseCache.set(ctx, b);\n  return b;\n}\nfunction envelope(ctx, dest, time, duration, volume, attack = 0.008) {\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(0.0001, time);\n  g.gain.exponentialRampToValueAtTime(Math.max(0.0002, volume), time + attack);\n  g.gain.exponentialRampToValueAtTime(0.0001, time + duration);\n  g.connect(dest);\n  return g;\n}\nfunction tone(ctx, dest, hz, time, duration, volume, type = 'triangle', endHz = hz) {\n  const o = ctx.createOscillator();\n  o.type = type;\n  o.frequency.setValueAtTime(Math.max(15, hz), time);\n  o.frequency.exponentialRampToValueAtTime(Math.max(15, endHz), time + duration);\n  const g = envelope(ctx, dest, time, duration, volume);\n  o.connect(g);\n  o.start(time);\n  o.stop(time + duration + 0.025);\n  o.onended = () => { o.disconnect(); g.disconnect(); };\n  return o;\n}\nfunction noise(ctx, dest, time, duration, volume, frequency, q = 0.7) {\n  const s = ctx.createBufferSource(), f = ctx.createBiquadFilter();\n  s.buffer = noiseBuffer(ctx);\n  f.type = 'bandpass'; f.frequency.setValueAtTime(frequency, time); f.Q.value = q;\n  const g = envelope(ctx, dest, time, duration, volume, 0.006);\n  s.connect(f); f.connect(g); s.start(time); s.stop(time + duration + 0.03);\n  s.onended = () => { s.disconnect(); f.disconnect(); g.disconnect(); };\n}\nfunction sound(ctx, dest, name, time) {\n  switch (name) {\n    case 'laser':\n      tone(ctx, dest, 1250, time, 0.115, 0.13, 'sawtooth', 165);\n      tone(ctx, dest, 190, time, 0.06, 0.1, 'sine', 65);\n      break;\n    case 'hit':\n      noise(ctx, dest, time, 0.16, 0.36, 1500, 1);\n      tone(ctx, dest, 155, time, 0.17, 0.16, 'triangle', 43);\n      break;\n    case 'explosion':\n      noise(ctx, dest, time, 0.8, 0.7, 360);\n      noise(ctx, dest, time + 0.05, 0.4, 0.3, 1500);\n      tone(ctx, dest, 90, time, 0.7, 0.55, 'sine', 22);\n      tone(ctx, dest, 175, time, 0.2, 0.18, 'triangle', 45);\n      break;\n    case 'tow':\n      tone(ctx, dest, 220, time, 0.44, 0.22, 'sawtooth', 840);\n      for (let i = 0; i < 5; i++) tone(ctx, dest, 1400 + i * 140, time + i * 0.075, 0.045, 0.07, 'square', 400);\n      break;\n    case 'pickup':\n      [74, 77, 81, 86].forEach((n, i) => tone(ctx, dest, midi(n), time + i * 0.09, 0.32, 0.22, 'sine'));\n      break;\n    case 'boost':\n      noise(ctx, dest, time, 0.75, 0.38, 670);\n      tone(ctx, dest, 80, time, 0.65, 0.18, 'sawtooth', 220);\n      break;\n    case 'ui':\n      tone(ctx, dest, midi(79), time, 0.06, 0.12, 'sine');\n      tone(ctx, dest, midi(86), time + 0.035, 0.08, 0.065, 'sine');\n      break;\n    case 'win':\n      [62, 69, 74, 77, 81, 86].forEach((n, i) => {\n        tone(ctx, dest, midi(n), time + i * 0.14, 0.85, 0.2, 'triangle');\n        tone(ctx, dest, midi(n - 12), time + i * 0.14, 0.85, 0.07, 'sine');\n      });\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {createWorld,createSpeeder,createWalker,createProbe,createTransport,createAce} from './art.js';\nimport {AudioDirector,renderAudioTest} from './audio.js';\nimport {CoopLink} from './network.js';\nimport feedback from './feedback.json';\n\nconst \"'$=id=>document.getElementById(id), clamp=(x,a,b)=>Math.max(a,Math.min(b,x)), TAU=Math.PI*2;\nconst dist=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z), norm=(x,z)=>{let n=Math.hypot(x,z);return n>.001?{x:x/n,z:z/n}:{x:0,z:-1};};\nconst angleDiff=(a,b)=>Math.atan2(Math.sin(a-b),Math.cos(a-b));\nconst defaults={speed:48,damage:18,enemyDamage:10,walkerSpeed:1.25,cableSpeed:1,enemyRate:1,shieldDrain:1};\nlet tuning={...defaults};\nconst settings={music:.1,sfx:.6,glyphs:'\"'ps',assist:true,shake:.65,zoom:1};\ntry{Object.assign(settings,JSON.parse(localStorage.getItem('detour-settings')||'{}'));}catch{}\nconst audio=new AudioDirector();audio.setMusic(settings.music);audio.setSfx(settings.sfx);\nconst link=new CoopLink();\nlet renderer,world,land,scene,camera,clock,raycaster=new THREE.Raycaster(),groundPlane=new THREE.Plane(new THREE.Vector3(0,1,0),-7),pointerPoint=new THREE.Vector3();\nlet mode='title',modalPage='',previousMode='title',phase=0,elapsed=0,phaseTime=0,score=0,baseHP=100,rescued=0,kills=0,evacuated=0,missionSeed=0;\nlet players=[],enemies=[],transports=[],shots=[],effects=[],pods=[],debris=[],physicsTime=0,attractTime=0,idleTime=0,visualTime=0,radioTime=0,bannerTime=0,shake=0;\nlet nextID=1,invincible=false,freezeEnemies=false,testInput=null,inputKind=matchMedia('(pointer: coarse)').matches?'touch':'keyboard',cursorActive=false;\nlet started=false,guest=false,networkMode=false,lastHud=-1,lastShotAudio=-1,crashed=false,lastSnapshot=-1;\nconst keys=new Set(),pointer={x:0,y:0,down:false,active:false},touches=new Map(),touchMove={x:0,z:0},touchAim={x:0,z:0},padState={buttons:[],menuDir:0,lastNav:0},seq={action:0,roll:0};\nlet onlineText='Fly together. One pilot hosts; a wingmate joins with the flight code.',menuFocus=0,lastController=false,remoteInputs=new Map();\nconst dynamicRoot=new THREE.Group(),remoteRoot=new THREE.Group(),remoteModels=new Map();\nlet cableLine,cablePositions=new Float32Array(150*3),reticle,aimMarker;\nconst materials={};\n\nfunction saveSettings(){try{localStorage.setItem('detour-settings',JSON.stringify(settings));}catch{}}\nfunction setInputKind(k){inputKind=k;document.body.classList.toggle('touch',k==='touch');updatePrompts();}\nfunction updatePrompts(){\n const pad=inputKind==='gamepad', xbox=settings.glyphs==='xbox';\n const entries=pad?[[ 'L','FLY'],['R','AIM'],['RT','FIRE'],['LT','BOOST'],[xbox?'A':'✕','TOW / RESCUE'],[xbox?'B':'○','ROLL']]:[['WASD','FLY'],['MOUSE','AIM / FIRE'],['SHIFT','BOOST'],['E','TOW / RESCUE'],['SPACE','ROLL']];\n \"'$('\"'controlStrip').innerHTML=entries.map(([k,v])=>\"'`<span><b class=\"key\">${k}</b>${v}</span>`).join('\"'');\n}\nfunction say(text,name='ECHO CONTROL',mood='radio'){\"'$('\"'radioText').textContent=text;\"'$('\"'radioName').textContent=name;radioTime=7;audio.voice(mood);}\nfunction banner(title,small){\"'$('\"'bannerTitle').textContent=title;\"'$('\"'bannerSmall').textContent=small;bannerTime=3.3;}\nfunction colorMat(c){if(\"'!materials[c])materials[c]=new THREE.MeshBasicNodeMaterial({color:c});return materials[c];}\nfunction addMesh(geo,c,parent=dynamicRoot){const m=new THREE.Mesh(geo,colorMat(c));parent.add(m);return m;}\nfunction makeCircle(radius,c){const m=addMesh(new THREE.RingGeometry(radius-.3,radius,64),c);m.rotation.x=-Math.PI/2;m.position.y=.35;return m;}\nfunction freshPhysics(){world?.free();world=new RAPIER.World({x:0,y:-20,z:0});world.timestep=1/60;world.createCollider(RAPIER.ColliderDesc.cuboid(350,.5,300).setTranslation(0,-.5,0));for(const [x,z,hx,hz] of [[-166,0,3,132],[166,0,3,132],[0,-126,166,3],[0,126,166,3]])world.createCollider(RAPIER.ColliderDesc.cuboid(hx,20,hz).setTranslation(x,20,z));}\nfunction clearGame(){for(const p of players)p.mixer?.stopAllAction();for(const e of enemies)e.mesh.userData.mixer?.stopAllAction();dynamicRoot.clear();remoteRoot.clear();remoteModels.clear();players=[];enemies=[];transports=[];shots=[];effects=[];pods=[];debris=[];nextID=1;freshPhysics();setupEffects();}\nfunction setupEffects(){\n cableLine=new THREE.Line(new THREE.BufferGeometry().setAttribute('\"'position',new THREE.BufferAttribute(cablePositions,3)),new THREE.LineBasicNodeMaterial({color:0x172c39}));cableLine.visible=false;dynamicRoot.add(cableLine);\n reticle=makeCircle(5,0xf66936);reticle.visible=false;\n aimMarker=new THREE.Group();dynamicRoot.add(aimMarker);\n for(let i=0;i<4;i++){const m=addMesh(new THREE.BoxGeometry(2,.16,.45),0xf66936,aimMarker);m.position.set(Math.cos(i*TAU/4)*4,0,Math.sin(i*TAU/4)*4);m.rotation.y=-i*TAU/4;}\n aimMarker.position.y=.5;\n}\nfunction makePlayer(id,x=-15,z=55){\n const mesh=new THREE.Group(),craft=createSpeeder(id===0?0xf66936:0x35bbc4);mesh.add(craft);dynamicRoot.add(mesh);mesh.position.set(x,7,z);\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,7,z).setGravityScale(0).setLinearDamping(4).lockRotations().enabledTranslations(true,false,true));\n body.userData={type:'player',id};world.createCollider(RAPIER.ColliderDesc.ball(3).setRestitution(.15).setFriction(0),body);\n const mixer=new THREE.AnimationMixer(craft),roll=mixer.clipAction(new THREE.AnimationClip('Evasive roll',.65,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,.13,.32,.5,.65],[0,1.2,3.14,5.1,TAU])]));roll.setLoop(THREE.LoopOnce,1);roll.clampWhenFinished=false;\n const p={id,x,z,hp:100,heat:0,overheat:false,heading:0,vx:0,vz:0,fireCD:0,rollCD:0,invuln:2,towId:null,towProgress:0,towAngle:0,towTravel:0,carrying:null,actionSeq:0,rollSeq:0,mesh,craft,body,mixer,roll,boost:false};players.push(p);return p;\n}\nfunction spawnEnemy(type,x,z,extra={}){\n const mesh=type==='walker'?createWalker():type==='ace'?createAce():createProbe();dynamicRoot.add(mesh);\n const y=type==='walker'?0:type==='ace'?11:8;mesh.position.set(x,y,z);if(type==='walker')mesh.rotation.y=Math.PI;\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x,type==='walker'?12:y,z));\n const id=nextID++,hp=type==='walker'?260:type==='ace'?420:42;\n const collider=world.createCollider(type==='walker'?RAPIER.ColliderDesc.cuboid(6,12,9):RAPIER.ColliderDesc.ball(type==='ace'?7:3.2),body);\n body.userData={type:'enemy',id};const e={id,type,x,z,y,hp,maxHP:hp,mesh,body,collider,dead:false,fire:2+Math.random()*3,age:Math.random()*TAU,originX:x,originZ:z,fall:0,tow:0,...extra};enemies.push(e);return e;\n}\nfunction spawnPod(x,z){const mesh=new THREE.Group();dynamicRoot.add(mesh);const shell=addMesh(new THREE.CapsuleGeometry(1.5,2.5,4,8),0xe9eee1,mesh);shell.rotation.z=Math.PI/2;const stripe=addMesh(new THREE.BoxGeometry(.8,2.8,3.1),0xf66936,mesh);const beacon=addMesh(new THREE.ConeGeometry(1,3,8),0xf5cf73,mesh);beacon.position.y=5;mesh.position.set(x,2.2,z);const ring=makeCircle(6,0xf5cf73);ring.position.set(x,.25,z);pods.push({id:nextID++,x,z,mesh,ring,carried:false,saved:false});}\nfunction startGame(demo=false){\n if(guest&&\"'!demo)return;clearGame();phase=0;elapsed=0;phaseTime=0;score=0;baseHP=100;rescued=0;kills=0;evacuated=0;missionSeed++;lastHud=-1;started=true;invincible=demo;attractTime=0;\n const ids=networkMode?link.players.filter(x=>x.connected!==false).map(x=>x.id):[0];if(!ids.length)ids.push(0);ids.forEach((id,i)=>makePlayer(id,-12+i*24,55));\n for(const [x,z] of [[-75,-45],[-30,-76],[45,-64],[90,-15]])spawnEnemy('\"'probe',x,z);\n for(const [x,z] of [[-95,15],[65,37],[12,-38]])spawnPod(x,z);\n mode=demo?'attract':'playing';closeModal();setScreens();audio.setPaused(false);if(\"'!demo){audio.unlock();say('\"'The shield is holding. Those probes are calling in company. Cut the conversation short.');banner('ON THIN ICE','01 / THE APPROACH');}\n}\nfunction beginPhase(n){phase=n;phaseTime=0;\n if(n===1){for(const [x,z] of [[-58,-58],[55,-72]])spawnEnemy('walker',x,z);say('Armor is too thick for blasters. Get close, deploy a cable, and keep circling.','ROGUE TWO');banner('MIND THE LEGS','02 / THE LONG WALK');}\n if(n===2){spawnEnemy('ace',0,-73);for(const x of [-28,28]){const mesh=createTransport();mesh.position.set(x,4,90);mesh.rotation.y=0;dynamicRoot.add(mesh);transports.push({id:nextID++,x,z:90,y:4,hp:160,maxHP:160,mesh,escaped:false});}for(const [x,z] of [[-98,-40],[95,-70],[-60,-90],[75,10]])spawnEnemy('probe',x,z);say('Transports are away. Keep that interceptor busy until both ships clear the valley.','ECHO CONTROL','urgent');banner('LAST FLIGHT OUT','03 / THE EVACUATION');}\n}\nfunction setScreens(){const onTitle=mode==='title';\"'$('\"'titleScreen').classList.toggle('show',onTitle);\"'$('\"'hud').classList.toggle('show',['playing','attract','guest','paused'].includes(mode));\"'$('\"'attract').style.display=mode==='attract'?'block':'none';\"'$('\"'touchMenu').style.visibility=onTitle?'hidden':'visible';\"'$('\"'touchHint').style.visibility=['playing','guest'].includes(mode)?'visible':'hidden';\"'$('\"'cursor').style.display=cursorActive&&inputKind==='keyboard'&&mode==='playing'?'block':'none';}\nfunction exitAttract(){if(mode\"'!=='\"'attract')return false;mode='title';idleTime=0;invincible=false;setScreens();return true;}\nfunction inputActivity(){idleTime=0;if(mode==='attract'){exitAttract();return true;}return false;}\nfunction getLocalPlayer(){return players.find(p=>p.id===(networkMode?link.me:0))||players[0];}\nfunction action(){seq.action++;}\nfunction roll(){seq.roll++;}\nfunction menuButtons(){return [...\"'$('\"'panel').querySelectorAll('button,input,select')].filter(x=>\"'!x.disabled&&x.offsetParent!==null);}\nfunction focusMenu(delta=0){const els=modalPage?menuButtons():[...$('\"'titleScreen').querySelectorAll('button')];if(\"'!els.length)return;menuFocus=(menuFocus+delta+els.length)%els.length;els.forEach((x,i)=>x.classList.toggle('\"'focused',i===menuFocus));els[menuFocus].focus({preventScroll:true});els[menuFocus].scrollIntoView({block:'nearest'});}\nfunction pause(){if(mode==='attract'){exitAttract();return;}if(modalPage){if(modalPage==='pause')resume();else openModal('pause');return;}if(mode==='playing'||mode==='guest'){previousMode=mode;if(\"'!networkMode)mode='\"'paused';audio.setPaused(\"'!networkMode);openModal('\"'pause');}}\nfunction resume(){if(mode==='paused')mode=previousMode==='guest'?'guest':'playing';closeModal();audio.setPaused(false);setScreens();}\nfunction closeModal(){modalPage='';\"'$('\"'modal').classList.remove('show');}\nfunction backTitle(){link.leave();networkMode=false;guest=false;mode='title';idleTime=0;closeModal();audio.setPaused(false);clearGame();makePlayer(0,-25,18);spawnEnemy('walker',38,-5);spawnEnemy('walker',95,-65);spawnEnemy('probe',-55,-25);setScreens();}\nfunction row(label,key,min,max,step,object=tuning,format=null){const val=object[key];return \"'`<label class=\"setting-row\">${label}<input class=\"focusable\" type=\"range\" data-object=\"${object===settings?'\"'settings':'tuning'}\\\" data-key=\\\"\"'${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${val}\"><output>${format?format(val):val}</output></label>`;}\nfunction openModal(page){\n if(!modalPage)previousMode=mode;modalPage=page;menuFocus=0;let content='\"'';const close=\"'`<button class=\"close\" data-action=\"close\" aria-label=\"Back\">×</button>`;\n if(page==='\"'pause')content=\"'`<div class=\"eyebrow orange\">FLIGHT HOLD</div><h2>Catch your breath.</h2><div class=\"menu-stack\"><button class=\"primary\" data-action=\"resume\">Resume sortie</button><button data-action=\"settings\">Settings</button><button data-action=\"help\">Flight school</button><button data-action=\"dev\">Developer flight deck</button><button data-action=\"about\">About & credits</button><button data-action=\"title\">Return to title</button></div><div class=\"panel-foot\">${networkMode?'\"'ONLINE SORTIES CONTINUE WHILE MENUS ARE OPEN':'THE VALLEY CAN WAIT A MOMENT'}</div>\"'`;\n if(page==='\"'settings')content=close+\"'`<div class=\"eyebrow orange\">YOUR COCKPIT</div><h2>Flight settings</h2>${row('\"'Music','music',0,1,.01,settings,v=>Math.round(v*100)+'%')}\"'${row('\"'Effects & radio','sfx',0,1,.01,settings,v=>Math.round(v*100)+'%')}\"'${row('\"'Camera shake','shake',0,1,.05,settings,v=>Math.round(v*100)+'%')}\"'${row('\"'Tactical zoom','zoom',.8,1.3,.05,settings,v=>v.toFixed(2)+'×')}<label class=\\\"setting-row\\\">Controller glyphs<select class=\\\"focusable\\\" id=\\\"glyphSelect\\\"><option value=\\\"ps\\\" \"'${settings.glyphs==='\"'ps'?'selected':''}>PlayStation · ✕ ○ □ △</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></label><label class=\\\"setting-row\\\">Aim assistance<select id=\\\"assistSelect\\\" class=\\\"focusable\\\"><option value=\\\"true\\\" \"'${settings.assist?'\"'selected':''}>On · gentle target lock</option><option value=\\\"false\\\" \"'${!settings.assist?'\"'selected':''}>Off · manual aim</option></select></label><p class=\\\"settings-note\\\">Music starts at 10%. Touch flight includes automatic targeting, firing and cable assistance.</p>\"'`;\n if(page==='\"'help')content=close+\"'`<div class=\"eyebrow orange\">ROGUE SQUADRON / FIELD MANUAL</div><h2>Small ship. Big ideas.</h2><div class=\"help-grid\"><div class=\"help-card\"><b>01 · FLY & FIGHT</b><p><em>WASD / left stick</em> steers. Aim with <em>mouse / right stick</em>. Hold <em>left click / R2</em> to fire.</p><p>Hold <em>Shift / L2</em> to boost. <em>Space / ○</em> rolls through danger. Watch blaster heat.</p></div><div class=\"help-card\"><b>02 · TIE THE KNOT</b><p>Approach a walker within 46m. Press <em>E / ✕</em> to latch the cable. Your co-pilot flies the circle.</p><p><em>Keep firing</em> while winding. Two loops bring it down. Press again to release.</p></div><div class=\"help-card\"><b>03 · BRING THEM HOME</b><p>At a survivor beacon, press <em>E / ✕</em> to collect. Fly within 23m of Echo Base to deliver.</p><p>Each rescue repairs your hull and the shield. Recovery is automatic if your ship is downed.</p></div><div class=\"help-card\"><b>04 · COVER THE EXIT</b><p>Stop the walkers before they reach the shield. Then escort <em>both transports</em> north and defeat the interceptor.</p><p>On touch: drag left to fly, right to aim. Blasters assist. Tap the context button for tow / rescue.</p></div></div><div class=\"panel-foot\">SOLO OR 2-PILOT ONLINE CO-OP · NO FRIENDLY FIRE · SHARED VICTORY</div>`;\n if(page==='\"'dev')content=close+\"'`<div class=\"eyebrow orange\">DEVELOPER FLIGHT DECK</div><h2>Make your own odds.</h2>${row('\"'Flight speed','speed',20,100,1)}\"'${row('\"'Blaster damage','damage',4,60,1)}\"'${row('\"'Incoming damage','enemyDamage',0,30,1)}\"'${row('\"'Walker march speed','walkerSpeed',.2,4,.1)}\"'${row('\"'Cable winding speed','cableSpeed',.25,3,.05)}\"'${row('\"'Enemy fire rate','enemyRate',.1,3,.1)}\"'${row('\"'Shield pressure','shieldDrain',0,3,.1)}<div class=\\\"menu-stack\\\" style=\\\"margin-top:18px\\\"><button data-action=\\\"god\\\">Invulnerability: \"'${invincible?'\"'ON':'OFF'}</button><button data-action=\\\"freeze\\\">Freeze enemies: \"'${freezeEnemies?'\"'ON':'OFF'}</button><button data-action=\\\"heal\\\">Repair ship & shield</button><button data-action=\\\"phase\\\">Advance mission chapter</button><button data-action=\\\"resetTuning\\\">Reset balance to defaults</button></div><p class=\\\"settings-note\\\">Values apply live. In online co-op, the host controls simulation. Chapter advance keeps the mission playable.</p>\"'`;\n if(page==='\"'online')content=close+\"'`<div class=\"eyebrow orange\">TWO PILOTS / ONE REBELLION</div><h2>Bring a wingmate.</h2><p>Share a flight code. Your wingmate can join from this game on another device. The host flies as Rogue Leader.</p><div class=\"menu-stack\"><button class=\"primary\" data-action=\"host\">Host co-op sortie</button></div><div class=\"room-row\"><input id=\"roomInput\" maxlength=\"32\" placeholder=\"Flight code\" aria-label=\"Flight code\"><button data-action=\"join\">Join</button></div><p class=\"online-status\" id=\"onlineStatus\">${onlineText}</p><p class=\"room-code\" id=\"roomCode\">${link.room||'\"''}</p><p class=\\\"settings-note\\\">Same-browser flights connect locally. Remote flights use encrypted WebRTC with public signaling. In AI Hub, the lobby supplies your crew automatically.</p>\"'`;\n if(page==='\"'about')content=close+\"'`<div class=\"eyebrow orange\">THE EMPIRE STRIKES A DETOUR</div><h2>Behind the flight.</h2><p>An unofficial, original tribute to the snowbound rebellion and the arcade spirit of 1982. All models, animation, music, effects and radio voices are generated in code.</p><div class=\"about-copy\"><h3>Source Information</h3><dl>${Object.entries(feedback.sourceInformation).map(([k,v])=>`<dt>${k[0].toUpperCase()+k.slice(1)}</dt><dd>${v}</dd>`).join('\"'')}</dl>\"'${[['\"'Testing Feedback',feedback.testingFeedback],['Engine Feedback',feedback.engineFeedback],['Prompt Feedback',feedback.promptFeedback]].map(([title,arr])=>\"'`<h3>${title}</h3>${arr.map(x=>`<p>${x}</p>`).join('\"'')}\"'`).join('\"'')}<h3>Credits</h3><p>Design, code and procedural assets: OpenAI gpt-6.1-sol. Three.js · Rapier · AI Hub Session Kit · PeerJS. Star Wars and The Empire Strikes Back belong to their respective owners. This fan tribute is unaffiliated.</p></div>\"'`;\n $('\"'panel').innerHTML=content;\"'$('\"'modal').classList.add('show');setScreens();if(inputKind==='gamepad')focusMenu();\n}\nfunction showResult(won){if(['won','lost'].includes(mode))return;mode=won?'won':'lost';for(const p of players)p.body.setLinvel({x:0,y:0,z:0},true);closeModal();audio.sfx(won?'win':'lose');link.finish(won,score,{rescued,kills,evacuated,seconds:Math.round(elapsed)});modalPage='result';\"'$('\"'panel').innerHTML=\"'`<div class=\"eyebrow orange\">${won?'\"'ECHO VALLEY / ALL CLEAR':'ECHO VALLEY / SIGNAL LOST'}</div><h2>\"'${won?'\"'The rebellion flies on.':'A cold day for the Empire.'}</h2><p>\"'${won?'\"'The last transports vanish into the clouds. Behind you, two very expensive walkers lie tangled in the snow.':'Your sortie is over. The next pilot will know where to aim.'}</p><div class=\\\"result-stats\\\"><div><strong>\"'${score.toLocaleString()}</strong><small>SORTIE SCORE</small></div><div><strong>${rescued} / 3</strong><small>SURVIVORS SAVED</small></div><div><strong>${evacuated} / 2</strong><small>TRANSPORTS AWAY</small></div></div><div class=\"menu-stack\"><button class=\"primary\" data-action=\"retry\">Fly another sortie</button><button data-action=\"title\">Return to title</button><button data-action=\"about\">Credits & flight report</button></div><div class=\"panel-foot\">${won?(baseHP>65?'\"'GOLD FLIGHT · THE SHIELD STILL STANDS':'SILVER FLIGHT · AGAINST THE ODDS'):'TIP: TOW CABLES DO THE HEAVY LIFTING. RESCUES REPAIR THE SHIELD.'}</div>\"'`;$('\"'modal').classList.add('show');setScreens();if(inputKind==='gamepad')focusMenu();}\n\nfunction handleAction(a){audio.unlock();audio.sfx('ui');inputActivity();switch(a){case'launch':startGame();break;case'pause':pause();break;case'resume':resume();break;case'close':if(previousMode==='title'||mode==='title')closeModal();else openModal('pause');break;case'title':backTitle();break;case'retry':if(guest){onlineText='The host starts the next sortie.';openModal('online');}else startGame();break;case'god':invincible=\"'!invincible;openModal('\"'dev');break;case'freeze':freezeEnemies=\"'!freezeEnemies;openModal('\"'dev');break;case'heal':players.forEach(p=>p.hp=100);baseHP=100;say('Fresh power. Try to keep the paint on this time.','ROGUE TWO');break;case'phase':for(const e of enemies)if(\"'!e.dead)killEnemy(e,false);if(phase<2)beginPhase(phase+1);else{transports.forEach(t=>{t.z=-116;t.escaped=true;});evacuated=2;}openModal('\"'dev');break;case'resetTuning':tuning={...defaults};invincible=false;freezeEnemies=false;openModal('dev');break;case'host':onlineText='Opening flight channel…';openModal('online');link.host().catch(e=>{onlineText=e.message;openModal('online');});break;case'join':{const code=\"'$('\"'roomInput')?.value.trim();if(code){onlineText='Calling '+code+'…';link.join(code).catch(e=>{onlineText=e.message;openModal('online');});}}break;default:openModal(a);}}\n\ndocument.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b)handleAction(b.dataset.action);});\ndocument.addEventListener('pointerover',e=>{const b=e.target.closest('button');if(b){document.querySelectorAll('button.focused').forEach(x=>x.classList.remove('focused'));b.classList.add('focused');}});\ndocument.addEventListener('input',e=>{if(e.target.dataset.key){const obj=e.target.dataset.object==='settings'?settings:tuning,k=e.target.dataset.key;obj[k]=Number(e.target.value);e.target.nextElementSibling.textContent=obj===settings&&['music','sfx','shake'].includes(k)?Math.round(obj[k]*100)+'%':obj[k];audio.setMusic(settings.music);audio.setSfx(settings.sfx);saveSettings();}});\ndocument.addEventListener('change',e=>{if(e.target.id==='glyphSelect')settings.glyphs=e.target.value;if(e.target.id==='assistSelect')settings.assist=e.target.value==='true';saveSettings();updatePrompts();});\nwindow.addEventListener('keydown',e=>{if(e.target.matches('input:not([type=range]),select'))return;const wasDemo=inputActivity();setInputKind('keyboard');audio.unlock();if(wasDemo)return;if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))e.preventDefault();if(e.repeat)return;keys.add(e.code);if(e.code==='Escape'){if(modalPage){if(mode==='title')closeModal();else if(modalPage==='pause')resume();else openModal('pause');}else pause();}else if(e.code==='KeyE')action();else if(e.code==='Space'&&\"'!modalPage&&mode!=='\"'title')roll();else if(e.code==='Enter'&&mode==='title'&&\"'!modalPage)startGame();});\nwindow.addEventListener('\"'keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();pointer.down=false;if(mode==='playing'&&\"'!networkMode)pause();});\n$('\"'view').addEventListener('contextmenu',e=>e.preventDefault());\nwindow.addEventListener('pointermove',e=>{if(e.pointerType==='touch')return;inputActivity();if(\"'!modalPage){setInputKind('\"'keyboard');cursorActive=true;pointer.x=e.clientX;pointer.y=e.clientY;pointer.active=true;\"'$('\"'cursor').style.left=e.clientX+'px';\"'$('\"'cursor').style.top=e.clientY+'px';}setScreens();});\n\"'$('\"'view').addEventListener('pointerdown',e=>{if(e.pointerType==='touch')return;const demo=inputActivity();setInputKind('keyboard');audio.unlock();if(\"'!demo)pointer.down=e.button===0;});window.addEventListener('\"'pointerup',e=>{if(e.pointerType\"'!=='\"'touch')pointer.down=false;});\n\"'$('\"'view').addEventListener('touchstart',e=>{e.preventDefault();if(inputActivity())return;setInputKind('touch');audio.unlock();for(const t of e.changedTouches)touches.set(t.identifier,{x:t.clientX,y:t.clientY,side:t.clientX<innerWidth/2?'move':'aim'});},{passive:false});\n\"'$('\"'view').addEventListener('touchmove',e=>{e.preventDefault();for(const t of e.changedTouches){const start=touches.get(t.identifier);if(\"'!start)continue;let x=clamp((t.clientX-start.x)/65,-1,1),z=clamp((t.clientY-start.y)/65,-1,1);if(start.side==='\"'move')touchMove={x,z};else touchAim={x,z};}},{passive:false});\nfunction endTouch(e){for(const t of e.changedTouches){const s=touches.get(t.identifier);if(s?.side==='move')touchMove={x:0,z:0};if(s?.side==='aim')touchAim={x:0,z:0};touches.delete(t.identifier);}}window.addEventListener('touchend',endTouch);window.addEventListener('touchcancel',endTouch);\"'$('\"'touchAction').addEventListener('click',()=>{setInputKind('touch');action();});\n\nfunction pollPad(now){const pads=navigator.getGamepads?.()||[],pad=[...pads].find(p=>p?.connected);if(\"'!pad)return null;const b=i=>!!pad.buttons[i]?.pressed,edge=i=>b(i)&&!padState.buttons[i],axis=i=>Math.abs(pad.axes[i]||0)>.16?pad.axes[i]:0;const activity=pad.buttons.some(v=>v.pressed)||pad.axes.some(v=>Math.abs(v)>.2);if(activity){const demo=inputActivity();setInputKind('\"'gamepad');audio.unlock();if(demo){padState.buttons=pad.buttons.map(v=>v.pressed);return null;}}\n if(edge(9))pause();\n if(mode==='title'||modalPage){let dy=(b(13)||axis(1)>.6?1:0)-(b(12)||axis(1)<-.6?1:0),dx=(b(15)||axis(0)>.6?1:0)-(b(14)||axis(0)<-.6?1:0);if(activity&&dy&&(now-padState.lastNav>.22)){focusMenu(dy);padState.lastNav=now;}if(dx&&now-padState.lastNav>.15){const el=document.activeElement;if(el?.type==='range'){el.value=clamp(Number(el.value)+dx*Number(el.step),Number(el.min),Number(el.max));el.dispatchEvent(new Event('input',{bubbles:true}));}else if(el?.tagName==='SELECT'){el.selectedIndex=clamp(el.selectedIndex+dx,0,el.options.length-1);el.dispatchEvent(new Event('change',{bubbles:true}));}padState.lastNav=now;}if(edge(0)){if(\"'!document.activeElement?.matches('\"'button'))focusMenu(0);document.activeElement?.click();}if(edge(1)&&modalPage){if(mode==='title')closeModal();else if(modalPage==='pause')resume();else openModal('pause');}}\n else{if(edge(0))action();if(edge(1))roll();}\n padState.buttons=pad.buttons.map(v=>v.pressed);return{mx:axis(0),mz:axis(1),rx:axis(2),rz:axis(3),fire:b(7)||b(2),boost:b(6)};\n}\nfunction readControls(p,pad){if(testInput)return{mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:seq.action,rollSeq:seq.roll,...testInput};const c={mx:0,mz:0,ax:Math.sin(p?.heading||0),az:-Math.cos(p?.heading||0),fire:false,boost:false,actionSeq:seq.action,rollSeq:seq.roll};if(modalPage)return c;\n if(inputKind==='gamepad'&&pad){c.mx=pad.mx;c.mz=pad.mz;c.fire=pad.fire;c.boost=pad.boost;if(Math.hypot(pad.rx,pad.rz)>.2){const n=norm(pad.rx,pad.rz);c.ax=n.x;c.az=n.z;}else if(Math.hypot(c.mx,c.mz)>.2){const n=norm(c.mx,c.mz);c.ax=n.x;c.az=n.z;}}\n else if(inputKind==='touch'){c.mx=touchMove.x;c.mz=touchMove.z;c.boost=Math.hypot(c.mx,c.mz)>.95;c.fire=true;if(Math.hypot(touchAim.x,touchAim.z)>.1){const n=norm(touchAim.x,touchAim.z);c.ax=n.x;c.az=n.z;}else{const e=nearestEnemy(p);if(e){const n=norm(e.x-p.x,e.z-p.z);c.ax=n.x;c.az=n.z;}}}\n else{c.mx=(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0);c.mz=(keys.has('KeyS')||keys.has('ArrowDown')?1:0)-(keys.has('KeyW')||keys.has('ArrowUp')?1:0);c.fire=pointer.down||keys.has('KeyJ');c.boost=keys.has('ShiftLeft')||keys.has('ShiftRight');if(pointer.active&&p){raycaster.setFromCamera(new THREE.Vector2(pointer.x/innerWidth*2-1,-pointer.y/innerHeight*2+1),camera);raycaster.ray.intersectPlane(groundPlane,pointerPoint);const n=norm(pointerPoint.x-p.x,pointerPoint.z-p.z);c.ax=n.x;c.az=n.z;}else if(Math.hypot(c.mx,c.mz)>.1){const n=norm(c.mx,c.mz);c.ax=n.x;c.az=n.z;}}\n return c;\n}\nfunction nearestEnemy(p,filter=()=>true){return enemies.filter(e=>\"'!e.dead&&filter(e)).sort((a,b)=>dist(a,p)-dist(b,p))[0];}\nfunction demoControls(p){\n const c={mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:p.actionSeq,rollSeq:p.rollSeq};\n if(p.towId!==null)return c;let target=nearestEnemy(p,e=>e.type!=='\"'walker');if(phase===1){target=nearestEnemy(p,e=>e.type==='walker');if(target&&dist(p,target)<43){c.actionSeq=p.actionSeq+1;return c;}}\n if(target){let d=dist(p,target),n=norm(target.x-p.x,target.z-p.z);c.ax=n.x;c.az=n.z;if(d>42){c.mx=n.x;c.mz=n.z;c.boost=d>85;}else{c.mx=-n.z*.4;c.mz=n.x*.4;}}\n return c;\n}\nfunction playerAction(p){if(p.towId\"'!==null){releaseTow(p);say('\"'Cable released. Pick your next angle.','ROGUE TWO');return;}const pod=pods.find(x=>\"'!x.saved&&!x.carried&&dist(p,x)<15);if(pod&&!p.carrying){pod.carried=true;pod.mesh.visible=false;pod.ring.visible=false;p.carrying=pod.id;audio.sfx('\"'pickup');say('Got them. Bring that survivor back to Echo Base.','ROGUE TWO');return;}const e=nearestEnemy(p,e=>e.type==='walker'&&\"'!players.some(q=>q.towId===e.id));if(e&&dist(p,e)<46){p.towId=e.id;p.towAngle=Math.atan2(p.z-e.z,p.x-e.x);p.towProgress=0;p.towTravel=0;audio.sfx('\"'tow');say('Cable locked. I have the circle. You keep their heads down.','ROGUE TWO');}}\nfunction releaseTow(p){p.towId=null;p.towProgress=0;}\nfunction updatePlayer(p,c,dt){\n p.fireCD-=dt;p.rollCD=Math.max(0,p.rollCD-dt);p.invuln=Math.max(0,p.invuln-dt);p.heat=Math.max(0,p.heat-dt*25);if(p.heat<25)p.overheat=false;\n if(c.actionSeq\"'!==p.actionSeq){p.actionSeq=c.actionSeq;playerAction(p);}if(c.rollSeq!==p.rollSeq){p.rollSeq=c.rollSeq;if(p.rollCD<=0){p.rollCD=4.5;p.invuln=1;p.roll.reset().play();audio.sfx('\"'boost');}}\n let nx=c.mx,nz=c.mz,n=Math.hypot(nx,nz);if(n>1){nx/=n;nz/=n;}\n let speed=tuning.speed*(c.boost?1.8:1)*(p.carrying?.85:1);p.boost=\"'!!c.boost;\n if(p.towId!==null){const e=enemies.find(e=>e.id===p.towId&&!e.dead);if(!e)releaseTow(p);else{const radius=30;p.towAngle+=dt*1.4*tuning.cableSpeed;p.towTravel+=dt*1.4*tuning.cableSpeed;p.towProgress=p.towTravel/(TAU*1.65);const tx=e.x+Math.cos(p.towAngle)*radius,tz=e.z+Math.sin(p.towAngle)*radius;p.body.setTranslation({x:tx,y:7,z:tz},true);p.body.setLinvel({x:0,y:0,z:0},true);p.x=tx;p.z=tz;c.ax=-Math.sin(p.towAngle);c.az=Math.cos(p.towAngle);e.tow=p.towProgress;if(p.towProgress>=1){killEnemy(e,true);releaseTow(p);score+=1200;say('\"'That is one way to shorten a walker.','ROGUE TWO','happy');}}}\n if(p.towId===null){const v=p.body.linvel();p.body.setLinvel({x:THREE.MathUtils.lerp(v.x,nx*speed,1-Math.exp(-dt*7)),y:0,z:THREE.MathUtils.lerp(v.z,nz*speed,1-Math.exp(-dt*7))},true);}\n let aim=norm(c.ax,c.az);if((settings.assist||mode==='attract')&&c.fire){const target=enemies.filter(e=>\"'!e.dead&&e.type!=='\"'walker'&&dist(e,p)<160).sort((a,b)=>dist(a,p)-dist(b,p)).find(e=>{const v=norm(e.x-p.x,e.z-p.z);return v.x*aim.x+v.z*aim.z>.88;});if(target)aim=norm(target.x-p.x,target.z-p.z);}\n p.heading=Math.atan2(aim.x,-aim.z);p.mesh.rotation.y=p.heading;\n if(c.fire&&p.fireCD<=0&&\"'!p.overheat){p.fireCD=.14;p.heat+=9;if(p.heat>=100)p.overheat=true;spawnShot(p.x+aim.x*8,7,p.z+aim.z*8,aim.x,aim.z,'\"'player',p.id);if(visualTime-lastShotAudio>.1){audio.sfx('laser');lastShotAudio=visualTime;}}\n if(p.carrying&&Math.hypot(p.x,p.z-92)<23){const pod=pods.find(x=>x.id===p.carrying);if(pod)pod.saved=true;p.carrying=null;rescued++;score+=650;baseHP=Math.min(100,baseHP+18);p.hp=Math.min(100,p.hp+35);audio.sfx('pickup');say('One more seat filled. The shield crew sends its thanks.','ECHO CONTROL','happy');}\n p.mixer.update(dt);if(\"'!p.roll.isRunning())p.craft.rotation.z=THREE.MathUtils.lerp(p.craft.rotation.z,-(p.body.linvel().x*Math.cos(p.heading)+p.body.linvel().z*Math.sin(p.heading))*.007,.1);\n p.craft.visible=p.invuln<.01||Math.floor(visualTime*15)%2===0;p.craft.userData.flames?.forEach(f=>f.scale.set(1,1,c.boost?2:.8+Math.sin(visualTime*30)*.12));\n}\nfunction spawnShot(x,y,z,dx,dz,owner,ownerId){const n=norm(dx,dz),mesh=addMesh(new THREE.BoxGeometry(owner==='\"'player'?.65:1,.6,owner==='player'?7:5),owner==='player'?0xffce79:0xe94e46);mesh.position.set(x,y,z);mesh.rotation.y=Math.atan2(-n.x,-n.z);shots.push({id:nextID++,x,y,z,dx:n.x,dz:n.z,life:1.8,owner,ownerId,mesh});}\nfunction hurtPlayer(p,damage){if(p.invuln>0||invincible||mode==='attract')return;p.hp-=damage;p.invuln=.5;shake=.5;audio.sfx('hit');\"'$('\"'damageFlash').style.opacity=1;setTimeout(()=>\"'$('\"'damageFlash').style.opacity=0,180);if(p.hp<=0){if(p.carrying){const pod=pods.find(x=>x.id===p.carrying);if(pod){pod.carried=false;pod.x=p.x;pod.z=p.z;pod.mesh.position.set(p.x,2,p.z);pod.ring.position.set(p.x,.2,p.z);pod.mesh.visible=pod.ring.visible=true;}p.carrying=null;}releaseTow(p);explode(p.x,7,p.z,0xf66936,24);if(networkMode&&baseHP>20){baseHP-=20;p.hp=70;p.invuln=4;p.body.setTranslation({x:0,y:7,z:65},true);say('A spare speeder. Do not make this a habit.','ECHO CONTROL');}else showResult(false);}}\nfunction killEnemy(e,cable=false){if(e.dead)return;e.dead=true;kills++;score+=e.type==='probe'?150:e.type==='ace'?2200:600;world.removeRigidBody(e.body);if(e.type==='walker'){e.fall=.001;e.mesh.userData.mixer?.stopAllAction();shake=1;explode(e.x,13,e.z,0xf7a452,40);const mixer=new THREE.AnimationMixer(e.mesh);const a=mixer.clipAction(new THREE.AnimationClip('Cable takedown',2.1,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,.4,1.1,1.65,2.1],[0,.07,-.25,-1.45,-1.52]),new THREE.NumberKeyframeTrack('.position[y]',[0,1.1,2.1],[0,-1,-4])]));a.setLoop(THREE.LoopOnce,1);a.clampWhenFinished=true;a.play();e.fallMixer=mixer;}else{explode(e.x,e.y,e.z,e.type==='ace'?0xf66936:0xffcf80,e.type==='ace'?32:16);e.mesh.visible=false;}audio.sfx('explosion');if(e.type==='ace')say('Their ace just folded. Stay with the transports.','ROGUE TWO','happy');}\nfunction explode(x,y,z,c,count=16){for(let i=0;i<count;i++){const mesh=addMesh(new THREE.IcosahedronGeometry(.5+Math.random()*1.4,0),i%3?c:0x314b58),body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x+(Math.random()-.5)*4,y,z+(Math.random()-.5)*4).setLinvel((Math.random()-.5)*30,Math.random()*20+5,(Math.random()-.5)*30).setAngvel({x:Math.random()*5,y:4,z:2}));world.createCollider(RAPIER.ColliderDesc.ball(.55).setRestitution(.25),body);debris.push({mesh,body,life:3+Math.random()*2});}const ring=makeCircle(2,c);ring.position.set(x,.5,z);effects.push({mesh:ring,life:.6,max:.6});}\nfunction enemyUpdate(e,dt){if(e.dead){e.fallMixer?.update(dt);return;}e.age+=dt;e.fire-=dt*tuning.enemyRate;if(freezeEnemies)return;\n if(e.type==='walker'){e.z+=dt*tuning.walkerSpeed*(e.tow>0?.4:1);e.mesh.position.z=e.z;e.mesh.rotation.y=Math.PI;if(e.z>60){baseHP-=dt*3.5*tuning.shieldDrain;if(phaseTime%6<dt)say('That walker is inside the perimeter. Cable it now.','ECHO CONTROL','urgent');}if(e.fire<=0){e.fire=4+Math.random()*3;const p=players[Math.floor(Math.random()*players.length)];if(p){const n=norm(p.x-e.x,p.z-e.z);spawnShot(e.x,7,e.z+15,n.x,n.z,'enemy',e.id);}}}\n else if(e.type==='ace'){e.x=Math.sin(e.age*.36)*105;e.z=-42+Math.cos(e.age*.5)*42;e.y=11+Math.sin(e.age)*2;e.mesh.position.set(e.x,e.y,e.z);e.mesh.rotation.y=Math.atan2(-Math.cos(e.age*.36)*38,Math.sin(e.age*.5)*21);if(e.fire<=0){e.fire=1.25;const p=players[0];if(p){const n=norm(p.x-e.x,p.z-e.z);for(let i=-1;i<=1;i++){const a=Math.atan2(n.z,n.x)+i*.13;spawnShot(e.x,7,e.z,Math.cos(a),Math.sin(a),'enemy',e.id);}}}if(phase===2)for(const t of transports)if(\"'!t.escaped&&dist(e,t)<45)t.hp-=dt*1.5*tuning.enemyDamage/10;}\n else{e.x=e.originX+Math.sin(e.age*.55)*14;e.z=e.originZ+Math.cos(e.age*.4)*11;e.mesh.position.set(e.x,e.y,e.z);if(e.fire<=0){e.fire=3.5+Math.random()*2;const p=players[Math.floor(Math.random()*players.length)];if(p){const n=norm(p.x-e.x,p.z-e.z);spawnShot(e.x,7,e.z,n.x,n.z,'\"'enemy',e.id);}}}\n e.body.setNextKinematicTranslation({x:e.x,y:e.type==='walker'?12:e.y,z:e.z});e.mesh.userData.mixer?.update(dt);\n}\nfunction updateShots(dt){for(let i=shots.length-1;i>=0;i--){const s=shots[i];s.life-=dt;const speed=s.owner==='player'?215:64,length=speed*dt;let hit=false;\n if(s.owner==='player'){const ray=new RAPIER.Ray({x:s.x,y:s.y,z:s.z},{x:s.dx,y:0,z:s.dz});const result=world.castRay(ray,length+3,true,undefined,undefined,undefined,undefined,c=>c.parent()?.userData?.type==='enemy');if(result){const id=result.collider.parent().userData.id,e=enemies.find(e=>e.id===id&&\"'!e.dead);if(e){hit=true;if(e.type==='\"'walker'){if(visualTime-lastShotAudio>.2)audio.sfx('hit');score+=1;}else{e.hp-=tuning.damage;if(e.hp<=0)killEnemy(e);else if(Math.random()<.3)audio.sfx('hit');}}}}\n else{for(const p of players){const px=p.x-s.x,pz=p.z-s.z,t=clamp(px*s.dx+pz*s.dz,0,length);if(Math.hypot(px-s.dx*t,pz-s.dz*t)<4.2){hurtPlayer(p,tuning.enemyDamage);hit=true;break;}}if(\"'!hit&&phase===2)for(const t of transports){if(!t.escaped&&Math.hypot(t.x-s.x,t.z-s.z)<10){t.hp-=tuning.enemyDamage*.6;hit=true;break;}}}\n s.x+=s.dx*length;s.z+=s.dz*length;s.mesh.position.set(s.x,s.y,s.z);if(hit||s.life<=0||Math.abs(s.x)>170||Math.abs(s.z)>130){dynamicRoot.remove(s.mesh);shots.splice(i,1);}}\n}\nfunction fixedUpdate(dt,controls=null){\n if(!['\"'playing','attract'].includes(mode)||guest)return;elapsed+=dt;phaseTime+=dt;if(mode==='attract')attractTime+=dt;\n for(const p of players){let c=mode==='attract'?demoControls(p):(controls&&p.id===(networkMode?link.me:0)?controls:remoteInputs.get(p.id));if(\"'!c)c={mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:p.actionSeq,rollSeq:p.rollSeq};updatePlayer(p,c,dt);}\n for(const e of enemies)enemyUpdate(e,dt);world.step();physicsTime+=dt;\n for(const p of players){const t=p.body.translation();const v=p.body.linvel();p.x=t.x;p.z=t.z;p.vx=v.x;p.vz=v.z;p.mesh.position.set(p.x,7,p.z);if(Math.abs(p.x)>157||Math.abs(p.z)>117){p.body.setTranslation({x:clamp(p.x,-156,156),y:7,z:clamp(p.z,-116,116)},true);}for(const e of enemies)if(!e.dead&&e.type==='\"'walker'&&Math.abs(p.x-e.x)<10&&Math.abs(p.z-e.z)<15)hurtPlayer(p,tuning.enemyDamage*.5);}\n updateShots(dt);\n for(let i=debris.length-1;i>=0;i--){const d=debris[i];d.life-=dt;const t=d.body.translation(),q=d.body.rotation();d.mesh.position.set(t.x,t.y,t.z);d.mesh.quaternion.set(q.x,q.y,q.z,q.w);if(d.life<1)d.mesh.scale.setScalar(Math.max(.01,d.life));if(d.life<=0){dynamicRoot.remove(d.mesh);world.removeRigidBody(d.body);debris.splice(i,1);}}\n for(let i=effects.length-1;i>=0;i--){const e=effects[i];e.life-=dt;e.mesh.scale.setScalar(1+(1-e.life/e.max)*25);if(e.life<=0){dynamicRoot.remove(e.mesh);effects.splice(i,1);}}\n for(const pod of pods)if(\"'!pod.saved&&!pod.carried){pod.mesh.position.y=2.4+Math.sin(elapsed*2+pod.id)*.5;pod.ring.rotation.z+=dt;}\n if(phase===0&&enemies.filter(e=>e.type==='\"'probe').every(e=>e.dead))beginPhase(1);\n if(phase===1&&enemies.filter(e=>e.type==='walker').every(e=>e.dead)&&phaseTime>2)beginPhase(2);\n if(phase===2){for(const t of transports){if(t.escaped)continue;t.z-=dt*3.1;t.y=4+Math.min(17,(90-t.z)*.08);t.mesh.position.set(t.x,t.y,t.z);t.mesh.userData.mixer?.update(dt);if(t.z<-112){t.escaped=true;evacuated++;score+=1800;say(evacuated===1?'First transport is clear. One more to go.':'Both transports clear. Finish the interceptor.','ECHO CONTROL','happy');}if(t.hp<=0&&mode\"'!=='\"'attract'){showResult(false);return;}}if(evacuated===2&&enemies.some(e=>e.type==='ace'&&e.dead)){if(mode==='attract'){if(attractTime>25)startGame(true);}else showResult(true);}}\n if(baseHP<=0&&mode\"'!=='\"'attract')showResult(false);if(mode==='attract'){baseHP=100;players.forEach(p=>p.hp=100);transports.forEach(t=>t.hp=160);if(attractTime>150)startGame(true);}\n}\nfunction updateCable(){cableLine.visible=false;const p=getLocalPlayer()||players.find(p=>p.towId\"'!==null);if(!p||p.towId===null)return;const e=enemies.find(x=>x.id===p.towId);if(!e)return;cableLine.visible=true;let count=0;const coils=Math.min(p.towProgress*1.65,1.65);for(let i=0;i<140;i++){const t=i/139,a=p.towAngle-coils*TAU*(1-t),r=i<132?9:THREE.MathUtils.lerp(9,30,(i-132)/7);cablePositions[count++]=e.x+Math.cos(a)*r;cablePositions[count++]=5+t*2;cablePositions[count++]=e.z+Math.sin(a)*r;}cableLine.geometry.setDrawRange(0,140);cableLine.geometry.attributes.position.needsUpdate=true;}\nfunction updateHUD(dt){\n const p=getLocalPlayer();$('\"'healthBar').style.width=(p?.hp||0)+'%';\"'$('\"'hp').textContent=Math.max(0,Math.ceil(p?.hp||0));\"'$('\"'heatBar').style.width=(p?.heat||0)+'%';\"'$('\"'heatBar').style.background=p?.overheat?'#f66936':'#173341';\"'$('\"'score').textContent=String(score).padStart(6,'0');\"'$('\"'missionTime').textContent=String(Math.floor(elapsed/60)).padStart(2,'0')+':'+String(Math.floor(elapsed%60)).padStart(2,'0');\"'$('\"'baseHealth').textContent=Math.max(0,Math.ceil(baseHP))+'%';\"'$('\"'shieldDots').innerHTML=Array.from({length:10},(_,i)=>\"'`<i class=\"${i*10>=baseHP?'\"'off':''}\\\"></i>\"'`).join('\"'');\"'$('\"'rescueStatus').textContent=\"'`SURVIVORS ${rescued} / 3${p?.carrying?'\"' · ABOARD':''}\"'`;\n const titles=['\"'Silence the scout probes','Trip the siege walkers','Cover the evacuation'],labels=['01 / THE APPROACH','02 / THE LONG WALK','03 / THE EVACUATION'];\"'$('\"'phaseLabel').textContent=labels[phase];\"'$('\"'objectiveTitle').textContent=titles[phase];\"'$('\"'objectiveDetail').textContent=phase===0?\"'`${enemies.filter(e=>e.type==='\"'probe'&&e.dead).length} / 4 probes neutralized\"'`:phase===1?`${enemies.filter(e=>e.type==='\"'walker'&&e.dead).length} / 2 walkers grounded · use tow cables\"'`:`${evacuated} / 2 transports clear · interceptor ${enemies.find(e=>e.type==='\"'ace')?.dead?'destroyed':Math.ceil((enemies.find(e=>e.type==='ace')?.hp||0)/4.2)+'%'}\"'`;\n radioTime-=dt;$('\"'radio').style.opacity=radioTime>0?1:0;bannerTime-=dt;\"'$('\"'phaseBanner').style.display=bannerTime>0?'block':'none';\n let context='';if(p&&['playing','guest'].includes(mode)&&\"'!modalPage){const k=inputKind==='\"'gamepad'?(settings.glyphs==='xbox'?'A':'✕'):'E';if(p.towId\"'!==null)context=`${k} · RELEASE CABLE`;else if(p.carrying)context='\"'RETURN SURVIVOR TO ECHO BASE ↓';else if(pods.some(x=>\"'!x.saved&&!x.carried&&dist(p,x)<15))context=`${k} · RESCUE SURVIVOR`;else if(nearestEnemy(p,e=>e.type==='\"'walker')&&dist(p,nearestEnemy(p,e=>e.type==='walker'))<46)context=\"'`${k} · DEPLOY TOW CABLE`;}\n $('\"'contextPrompt').style.display=context?'block':'none';\"'$('\"'contextPrompt').textContent=context;\"'$('\"'touchAction').style.display=inputKind==='touch'&&context&&\"'!p?.carrying?'\"'block':'none';\"'$('\"'touchAction').textContent=p?.towId\"'!==null?'\"'RELEASE':context.includes('RESCUE')?'RESCUE':'TOW';\"'$('\"'towMeter').style.display=p?.towId\"'!==null&&p?'\"'block':'none';\"'$('\"'towPercent').textContent=Math.floor((p?.towProgress||0)*100)+'%';\"'$('\"'towBar').style.width=((p?.towProgress||0)*100)+'%';\n if(p&&pointer.active&&\"'!modalPage){aimMarker.visible=inputKind==='\"'keyboard';aimMarker.position.set(pointerPoint.x,.5,pointerPoint.z);}else aimMarker.visible=false;\n const target=p&&nearestEnemy(p);reticle.visible=\"'!!target;if(target)reticle.position.set(target.x,.4,target.z);\n drawRadar();\n}\nfunction drawRadar(){const ctx=$('\"'radar').getContext('2d'),W=312,H=260;ctx.clearRect(0,0,W,H);ctx.strokeStyle='#17334118';ctx.lineWidth=1;for(let i=0;i<6;i++){ctx.beginPath();ctx.moveTo(i*W/5,0);ctx.lineTo(i*W/5,H);ctx.stroke();ctx.beginPath();ctx.moveTo(0,i*H/5);ctx.lineTo(W,i*H/5);ctx.stroke();}const point=(x,z,c,r=4)=>{ctx.fillStyle=c;ctx.beginPath();ctx.arc(W/2+x/170*W/2,H/2+z/130*H/2,r,0,TAU);ctx.fill();};point(0,95,'#173341',8);for(const e of enemies)if(\"'!e.dead)point(e.x,e.z,e.type==='\"'walker'?'#de542e':'#c54b3d',e.type==='walker'?7:4);for(const p of pods)if(\"'!p.saved&&!p.carried)point(p.x,p.z,'\"'#d5992d',4);for(const t of transports)if(\"'!t.escaped)point(t.x,t.z,'\"'#2a9d99',6);players.forEach((p,i)=>point(p.x,p.z,i?'#32aeb9':'#f66936',6));}\nfunction updateCamera(dt){const aspect=innerWidth/innerHeight;let size=(mode==='title'?105:112)/settings.zoom;if(inputKind==='touch'&&aspect<1)size=180;camera.left=-size*aspect;camera.right=size*aspect;camera.top=size;camera.bottom=-size;camera.updateProjectionMatrix();let tx=0,tz=0;if(mode==='playing'||mode==='guest'||mode==='attract'){const p=getLocalPlayer();if(p){tx=p.x*.23;tz=p.z*.18;}}else if(mode==='title'){tx=22;tz=-3;}\n const jitter=shake*settings.shake;camera.position.set(tx+(Math.random()-.5)*jitter,235+(Math.random()-.5)*jitter,tz+208);camera.lookAt(tx,0,tz-5);shake=Math.max(0,shake-dt*1.5);\n}\nfunction snapshot(){return{v:1,tick:Math.floor(physicsTime*60),mode,phase,elapsed,phaseTime,score,baseHP,rescued,kills,evacuated,players:players.map(({id,x,z,hp,heat,heading,towId,towProgress,towAngle,carrying,boost})=>({id,x,z,hp,heat,heading,towId,towProgress,towAngle,carrying,boost})),enemies:enemies.map(({id,type,x,z,y,hp,maxHP,dead,tow})=>({id,type,x,z,y,hp,maxHP,dead,tow})),transports:transports.map(({id,x,z,y,hp,escaped})=>({id,x,z,y,hp,escaped})),pods:pods.map(({id,x,z,saved,carried})=>({id,x,z,saved,carried})),shots:shots.slice(-40).map(({id,x,y,z,dx,dz,owner})=>({id,x,y,z,dx,dz,owner}))};}\nfunction applySnapshot(s){if(\"'!s||s.v!==1)return;lastSnapshot=s.tick;phase=s.phase;elapsed=s.elapsed;phaseTime=s.phaseTime;score=s.score;baseHP=s.baseHP;rescued=s.rescued;kills=s.kills;evacuated=s.evacuated;const seen=new Set();\n function model(key,type){seen.add(key);let m=remoteModels.get(key);if(!m){m=type==='\"'player'?createSpeeder(key.includes(String(link.me))?0xf66936:0x35bbc4):type==='walker'?createWalker():type==='ace'?createAce():type==='probe'?createProbe():type==='transport'?createTransport():type==='shot'?new THREE.Mesh(new THREE.BoxGeometry(.7,.7,6),colorMat(0xffb95d)):new THREE.Mesh(new THREE.CapsuleGeometry(1.6,2.5,4,8),colorMat(0xf5cf73));remoteModels.set(key,m);remoteRoot.add(m);}m.visible=true;return m;}\n players=s.players.map(p=>{const mesh=model('p'+p.id,'player');mesh.position.set(p.x,7,p.z);mesh.rotation.y=p.heading;return{...p,mesh};});enemies=s.enemies.map(e=>{const mesh=model('e'+e.id,e.type);mesh.position.set(e.x,e.y,e.z);mesh.rotation.y=e.type==='walker'?Math.PI:0;mesh.visible=\"'!e.dead;return{...e,mesh};});transports=s.transports.map(t=>{const mesh=model('\"'t'+t.id,'transport');mesh.position.set(t.x,t.y,t.z);mesh.visible=\"'!t.escaped;return{...t,mesh};});pods=s.pods.map(p=>{const mesh=model('\"'r'+p.id,'pod');mesh.position.set(p.x,2,p.z);mesh.visible=\"'!p.saved&&!p.carried;return{...p,mesh};});for(const shot of s.shots||[]){const mesh=model('\"'s'+shot.id,'shot');mesh.position.set(shot.x,shot.y,shot.z);mesh.rotation.y=Math.atan2(-shot.dx,-shot.dz);}for(const[k,m]of remoteModels)if(\"'!seen.has(k)){remoteRoot.remove(m);remoteModels.delete(k);}if(mode!=='\"'guest'&&\"'!['\"'won','lost'].includes(mode)){mode='guest';closeModal();setScreens();}if(['won','lost'].includes(s.mode)&&\"'!['\"'won','lost'].includes(mode))showResult(s.mode==='won');}\nlink.on('status',s=>{onlineText=s.text;\"'$('\"'onlineStatus')&&(\"'$('\"'onlineStatus').textContent=s.text);\"'$('\"'roomCode')&&(\"'$('\"'roomCode').textContent=link.room||'');\"'$('\"'networkBadge').textContent=link.active?\"'`${link.isHost?'\"'HOST':'WINGMATE'} · \"'${s.text}`:'\"'';});\nlink.on('input',({id,input})=>remoteInputs.set(id,input));link.on('snapshot',s=>{if(guest)applySnapshot(s);});\nlink.on('start',info=>{networkMode=true;guest=\"'!link.isHost;audio.unlock();if(guest){clearGame();mode='\"'guest';closeModal();setScreens();}else startGame();});\nlink.on('players',list=>{if(\"'!networkMode||guest||!started)return;for(const item of list)if(item.connected!==false&&!players.some(p=>p.id===item.id))makePlayer(item.id,20,60);for(const p of [...players])if(!list.some(i=>i.id===p.id)){dynamicRoot.remove(p.mesh);world.removeRigidBody(p.body);players=players.filter(q=>q!==p);}});\nlink.on('\"'end',info=>{if(mode==='playing'||mode==='guest')showResult(info?.won||false);});link.on('timeup',()=>showResult(evacuated===2));\n\nasync function init(){\n await RAPIER.init();scene=new THREE.Scene();scene.background=new THREE.Color(0xb7d6dc);scene.fog=new THREE.Fog(0xb7d6dc,300,650);camera=new THREE.OrthographicCamera(-180,180,112,-112,.1,1200);\n const webgl=new URLSearchParams(location.search).has('webgl');renderer=new THREE.WebGPURenderer({canvas:\"'$('\"'view'),antialias:true,forceWebGL:webgl});await renderer.init();renderer.setPixelRatio(Math.min(devicePixelRatio,1.75));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.18;\n land=createWorld(scene);scene.add(dynamicRoot,remoteRoot);clearGame();makePlayer(0,-25,18);spawnEnemy('walker',38,-5);spawnEnemy('walker',95,-65);spawnEnemy('probe',-55,-25);setInputKind(inputKind);window.addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);updateCamera(0);});\n await link.initHub();link.ready();if(link.mode==='hub'){networkMode=true;guest=\"'!link.isHost;mode='\"'waiting';\"'$('\"'titleScreen').classList.remove('show');}\n updateCamera(0);await renderer.renderAsync(scene,camera);\"'$('\"'boot').style.display='none';clock=new THREE.Clock();\n window.__game={getState:()=>({...snapshot(),mode,modalPage,renderer:renderer.backend.isWebGPUBackend?'WebGPU':'WebGL2',physics:'Rapier 0.19.3',inputKind,settings:{...settings},tuning:{...tuning},audio:audio.getSnapshot(),network:{mode:link.mode,isHost:link.isHost,me:link.me,players:link.players,active:link.active},bodyCount:world.bodies.len(),lastSnapshot}),step:(seconds,c=null)=>{for(let i=0;i<Math.ceil(seconds*60);i++)fixedUpdate(1/60,c||readControls(getLocalPlayer(),null));updateHUD(0);return snapshot();},input:c=>testInput=c,action:()=>action(),roll:()=>roll(),teleport:(x,z,id=0)=>{const p=players.find(p=>p.id===id)||players[0];if(p?.body){p.x=x;p.z=z;p.body.setTranslation({x,y:7,z},true);p.body.setLinvel({x:0,y:0,z:0},true);}},idle:seconds=>{idleTime+=seconds;},dev:op=>handleAction(op),project:(x,y,z)=>{const p=new THREE.Vector3(x,y,z).project(camera);return{x:(p.x+1)/2*innerWidth,y:(1-p.y)/2*innerHeight};},audioTest:async()=>{const ctx=new OfflineAudioContext(2,48000*10,48000);return await renderAudioTest(ctx);},unlock:()=>audio.unlock(),getLink:()=>link};\n renderer.setAnimationLoop(frame);\n}\nfunction frame(){\n if(crashed)return;try{const dt=Math.min(clock.getDelta(),.05);visualTime+=dt;const pad=pollPad(visualTime);\n if(mode==='title'&&\"'!modalPage&&!networkMode){idleTime+=dt;if(idleTime>=10)startGame(true);}\n let controls=readControls(getLocalPlayer(),pad);if(networkMode){if(guest)link.sendInput(controls);else if(!link.server)remoteInputs.set(link.me,controls);}\n if(!guest){let remaining=dt;while(remaining>0){const step=Math.min(1/60,remaining);fixedUpdate(step,controls);remaining-=step;}if(networkMode&&link.isHost)link.sendSnapshot(snapshot());}\n else for(const model of remoteModels.values())model.userData.mixer?.update(dt);\n land.update(dt,visualTime);if(land.shieldMaterial)land.shieldMaterial.opacity=.06+baseHP/100*.09;updateCable();updateCamera(dt);updateHUD(dt);\n const p=getLocalPlayer();audio.update(dt,{speed:p?Math.hypot(p.vx||0,p.vz||0):0,boost:p?.boost||false,phase,active:['\"'playing','guest','attract'].includes(mode)});renderer.render(scene,camera);\n }catch(e){crashed=true;console.error(e);\"'$('\"'boot').style.display='flex';\"'$('\"'bootError').textContent='Flight system error: '+e.message;}}\ninit().catch(e=>{console.error(e);\"'$('\"'bootError').textContent='Flight systems could not start: '+e.message;});\nEOF\ncat > feedback.json <<'EOF'\n{\\\"sourceInformation\\\":{\\\"date\\\":\\\"2026-11-06 01:11:41\\\",\\\"source\\\":\\\"Star Wars: The Empire Strikes Back (1982 video game)\\\",\\\"plan\\\":\\\"none\\\",\\\"genre\\\":\\\"Arcade flight shooter with cooperative defense and escort\\\",\\\"perspective\\\":\\\"Third-person oblique tactical camera\\\",\\\"tech\\\":\\\"Three.js r180 WebGPURenderer / WebGPU with WebGL2 fallback; Rapier 0.19.3; Web Audio; Gamepad API; AI Hub Session Kit 1.4.0; PeerJS 1.5.5\\\",\\\"artDirection\\\":\\\"Procedural cel-shaded / ink 3D, faceted ice, bold silhouettes and orange field markings\\\",\\\"animation\\\":\\\"Three.js AnimationMixer and AnimationClip; procedural secondary motion\\\",\\\"audio\\\":\\\"Original code-synthesized music at 10% default volume, synthesized effects and Animalese-style radio voices; no audio files\\\",\\\"online\\\":\\\"1–2 cooperative pilots; authoritative AI Hub shared-world integration; standalone BroadcastChannel and WebRTC\\\",\\\"testing\\\":\\\"Headless state-driven playthrough, controller and touch emulation, audio render, two-page multiplayer and visual inspection; no physical controller or real mobile device\\\",\\\"research\\\":\\\"none; native model knowledge. Only the supplied AI Hub integration source was retrieved.\\\",\\\"environment\\\":\\\"Codex CLI (headless); Linux\\\",\\\"model\\\":\\\"OpenAI, gpt-6.1-sol, reasoning effort ultra\\\",\\\"usage\\\":\\\"added on import\\\"},\\\"testingFeedback\\\":[\\\"Issue count: unknown; testing in progress.\\\",\\\"Critical issue count: unknown; testing in progress.\\\",\\\"Most helpful test: unknown; testing in progress.\\\",\\\"Least helpful test: unknown; testing in progress.\\\"],\\\"engineFeedback\\\":[\\\"The native scene graph, node materials and AnimationMixer make procedural art and animation fit together cleanly.\\\",\\\"unknown; implementation is being validated.\\\",\\\"The campaign simulation, tow-cable assistance, controller navigation and cooperative state synchronization were built for this game.\\\",\\\"Keeping one simulation consistent across rendering, physics and network ownership was the hardest integration.\\\",\\\"none\\\",\\\"A concise standard pattern for WebGPU-safe cel shading and deterministic headless testing would help.\\\"],\\\"promptFeedback\\\":[\\\"The source, single-file packaging and controller-first requirements give the demo a clear identity.\\\",\\\"The 1982 source may mean the Atari game or the film era; this demo draws on the game's Hoth defense and the film's evacuation.\\\",\\\"Making a complete three-chapter sortie, co-op, touch controls and procedural audiovisual assets work in one portable file.\\\",\\\"Specify whether the source is the original game or the film, and provide the expected AI Hub library version inline.\\\"]}\nEOF\nnode --check main.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {createWorld,createSpeeder,createWalker,createProbe,createTransport,createAce} from './art.js';\nimport {AudioDirector,renderAudioTest} from './audio.js';\nimport {CoopLink} from './network.js';\nimport feedback from './feedback.json';\n\nconst \"'$=id=>document.getElementById(id), clamp=(x,a,b)=>Math.max(a,Math.min(b,x)), TAU=Math.PI*2;\nconst dist=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z), norm=(x,z)=>{let n=Math.hypot(x,z);return n>.001?{x:x/n,z:z/n}:{x:0,z:-1};};\nconst angleDiff=(a,b)=>Math.atan2(Math.sin(a-b),Math.cos(a-b));\nconst defaults={speed:48,damage:18,enemyDamage:10,walkerSpeed:1.25,cableSpeed:1,enemyRate:1,shieldDrain:1};\nlet tuning={...defaults};\nconst settings={music:.1,sfx:.6,glyphs:'\"'ps',assist:true,shake:.65,zoom:1};\ntry{Object.assign(settings,JSON.parse(localStorage.getItem('detour-settings')||'{}'));}catch{}\nconst audio=new AudioDirector();audio.setMusic(settings.music);audio.setSfx(settings.sfx);\nconst link=new CoopLink();\nlet renderer,world,land,scene,camera,clock,raycaster=new THREE.Raycaster(),groundPlane=new THREE.Plane(new THREE.Vector3(0,1,0),-7),pointerPoint=new THREE.Vector3();\nlet mode='title',modalPage='',previousMode='title',phase=0,elapsed=0,phaseTime=0,score=0,baseHP=100,rescued=0,kills=0,evacuated=0,missionSeed=0;\nlet players=[],enemies=[],transports=[],shots=[],effects=[],pods=[],debris=[],physicsTime=0,attractTime=0,idleTime=0,visualTime=0,radioTime=0,bannerTime=0,shake=0;\nlet nextID=1,invincible=false,freezeEnemies=false,testInput=null,inputKind=matchMedia('(pointer: coarse)').matches?'touch':'keyboard',cursorActive=false;\nlet started=false,guest=false,networkMode=false,lastHud=-1,lastShotAudio=-1,crashed=false,lastSnapshot=-1;\nconst keys=new Set(),pointer={x:0,y:0,down:false,active:false},touches=new Map(),touchMove={x:0,z:0},touchAim={x:0,z:0},padState={buttons:[],menuDir:0,lastNav:0},seq={action:0,roll:0};\nlet onlineText='Fly together. One pilot hosts; a wingmate joins with the flight code.',menuFocus=0,lastController=false,remoteInputs=new Map();\nconst dynamicRoot=new THREE.Group(),remoteRoot=new THREE.Group(),remoteModels=new Map();\nlet cableLine,cablePositions=new Float32Array(150*3),reticle,aimMarker;\nconst materials={};\n\nfunction saveSettings(){try{localStorage.setItem('detour-settings',JSON.stringify(settings));}catch{}}\nfunction setInputKind(k){inputKind=k;document.body.classList.toggle('touch',k==='touch');updatePrompts();}\nfunction updatePrompts(){\n const pad=inputKind==='gamepad', xbox=settings.glyphs==='xbox';\n const entries=pad?[[ 'L','FLY'],['R','AIM'],['RT','FIRE'],['LT','BOOST'],[xbox?'A':'✕','TOW / RESCUE'],[xbox?'B':'○','ROLL']]:[['WASD','FLY'],['MOUSE','AIM / FIRE'],['SHIFT','BOOST'],['E','TOW / RESCUE'],['SPACE','ROLL']];\n \"'$('\"'controlStrip').innerHTML=entries.map(([k,v])=>\"'`<span><b class=\"key\">${k}</b>${v}</span>`).join('\"'');\n}\nfunction say(text,name='ECHO CONTROL',mood='radio'){\"'$('\"'radioText').textContent=text;\"'$('\"'radioName').textContent=name;radioTime=7;audio.voice(mood);}\nfunction banner(title,small){\"'$('\"'bannerTitle').textContent=title;\"'$('\"'bannerSmall').textContent=small;bannerTime=3.3;}\nfunction colorMat(c){if(\"'!materials[c])materials[c]=new THREE.MeshBasicNodeMaterial({color:c});return materials[c];}\nfunction addMesh(geo,c,parent=dynamicRoot){const m=new THREE.Mesh(geo,colorMat(c));parent.add(m);return m;}\nfunction makeCircle(radius,c){const m=addMesh(new THREE.RingGeometry(radius-.3,radius,64),c);m.rotation.x=-Math.PI/2;m.position.y=.35;return m;}\nfunction freshPhysics(){world?.free();world=new RAPIER.World({x:0,y:-20,z:0});world.timestep=1/60;world.createCollider(RAPIER.ColliderDesc.cuboid(350,.5,300).setTranslation(0,-.5,0));for(const [x,z,hx,hz] of [[-166,0,3,132],[166,0,3,132],[0,-126,166,3],[0,126,166,3]])world.createCollider(RAPIER.ColliderDesc.cuboid(hx,20,hz).setTranslation(x,20,z));}\nfunction clearGame(){for(const p of players)p.mixer?.stopAllAction();for(const e of enemies)e.mesh.userData.mixer?.stopAllAction();dynamicRoot.clear();remoteRoot.clear();remoteModels.clear();players=[];enemies=[];transports=[];shots=[];effects=[];pods=[];debris=[];nextID=1;freshPhysics();setupEffects();}\nfunction setupEffects(){\n cableLine=new THREE.Line(new THREE.BufferGeometry().setAttribute('\"'position',new THREE.BufferAttribute(cablePositions,3)),new THREE.LineBasicNodeMaterial({color:0x172c39}));cableLine.visible=false;dynamicRoot.add(cableLine);\n reticle=makeCircle(5,0xf66936);reticle.visible=false;\n aimMarker=new THREE.Group();dynamicRoot.add(aimMarker);\n for(let i=0;i<4;i++){const m=addMesh(new THREE.BoxGeometry(2,.16,.45),0xf66936,aimMarker);m.position.set(Math.cos(i*TAU/4)*4,0,Math.sin(i*TAU/4)*4);m.rotation.y=-i*TAU/4;}\n aimMarker.position.y=.5;\n}\nfunction makePlayer(id,x=-15,z=55){\n const mesh=new THREE.Group(),craft=createSpeeder(id===0?0xf66936:0x35bbc4);mesh.add(craft);dynamicRoot.add(mesh);mesh.position.set(x,7,z);\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x,7,z).setGravityScale(0).setLinearDamping(4).lockRotations().enabledTranslations(true,false,true));\n body.userData={type:'player',id};world.createCollider(RAPIER.ColliderDesc.ball(3).setRestitution(.15).setFriction(0),body);\n const mixer=new THREE.AnimationMixer(craft),roll=mixer.clipAction(new THREE.AnimationClip('Evasive roll',.65,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,.13,.32,.5,.65],[0,1.2,3.14,5.1,TAU])]));roll.setLoop(THREE.LoopOnce,1);roll.clampWhenFinished=false;\n const p={id,x,z,hp:100,heat:0,overheat:false,heading:0,vx:0,vz:0,fireCD:0,rollCD:0,invuln:2,towId:null,towProgress:0,towAngle:0,towTravel:0,carrying:null,actionSeq:0,rollSeq:0,mesh,craft,body,mixer,roll,boost:false};players.push(p);return p;\n}\nfunction spawnEnemy(type,x,z,extra={}){\n const mesh=type==='walker'?createWalker():type==='ace'?createAce():createProbe();dynamicRoot.add(mesh);\n const y=type==='walker'?0:type==='ace'?11:8;mesh.position.set(x,y,z);if(type==='walker')mesh.rotation.y=Math.PI;\n const body=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(x,type==='walker'?12:y,z));\n const id=nextID++,hp=type==='walker'?260:type==='ace'?420:42;\n const collider=world.createCollider(type==='walker'?RAPIER.ColliderDesc.cuboid(6,12,9):RAPIER.ColliderDesc.ball(type==='ace'?7:3.2),body);\n body.userData={type:'enemy',id};const e={id,type,x,z,y,hp,maxHP:hp,mesh,body,collider,dead:false,fire:2+Math.random()*3,age:Math.random()*TAU,originX:x,originZ:z,fall:0,tow:0,...extra};enemies.push(e);return e;\n}\nfunction spawnPod(x,z){const mesh=new THREE.Group();dynamicRoot.add(mesh);const shell=addMesh(new THREE.CapsuleGeometry(1.5,2.5,4,8),0xe9eee1,mesh);shell.rotation.z=Math.PI/2;const stripe=addMesh(new THREE.BoxGeometry(.8,2.8,3.1),0xf66936,mesh);const beacon=addMesh(new THREE.ConeGeometry(1,3,8),0xf5cf73,mesh);beacon.position.y=5;mesh.position.set(x,2.2,z);const ring=makeCircle(6,0xf5cf73);ring.position.set(x,.25,z);pods.push({id:nextID++,x,z,mesh,ring,carried:false,saved:false});}\nfunction startGame(demo=false){\n if(guest&&\"'!demo)return;clearGame();phase=0;elapsed=0;phaseTime=0;score=0;baseHP=100;rescued=0;kills=0;evacuated=0;missionSeed++;lastHud=-1;started=true;invincible=demo;attractTime=0;\n const ids=networkMode?link.players.filter(x=>x.connected!==false).map(x=>x.id):[0];if(!ids.length)ids.push(0);ids.forEach((id,i)=>makePlayer(id,-12+i*24,55));\n for(const [x,z] of [[-75,-45],[-30,-76],[45,-64],[90,-15]])spawnEnemy('\"'probe',x,z);\n for(const [x,z] of [[-95,15],[65,37],[12,-38]])spawnPod(x,z);\n mode=demo?'attract':'playing';closeModal();setScreens();audio.setPaused(false);if(\"'!demo){audio.unlock();say('\"'The shield is holding. Those probes are calling in company. Cut the conversation short.');banner('ON THIN ICE','01 / THE APPROACH');}\n}\nfunction beginPhase(n){phase=n;phaseTime=0;\n if(n===1){for(const [x,z] of [[-58,-58],[55,-72]])spawnEnemy('walker',x,z);say('Armor is too thick for blasters. Get close, deploy a cable, and keep circling.','ROGUE TWO');banner('MIND THE LEGS','02 / THE LONG WALK');}\n if(n===2){spawnEnemy('ace',0,-73);for(const x of [-28,28]){const mesh=createTransport();mesh.position.set(x,4,90);mesh.rotation.y=0;dynamicRoot.add(mesh);transports.push({id:nextID++,x,z:90,y:4,hp:160,maxHP:160,mesh,escaped:false});}for(const [x,z] of [[-98,-40],[95,-70],[-60,-90],[75,10]])spawnEnemy('probe',x,z);say('Transports are away. Keep that interceptor busy until both ships clear the valley.','ECHO CONTROL','urgent');banner('LAST FLIGHT OUT','03 / THE EVACUATION');}\n}\nfunction setScreens(){const onTitle=mode==='title';\"'$('\"'titleScreen').classList.toggle('show',onTitle);\"'$('\"'hud').classList.toggle('show',['playing','attract','guest','paused'].includes(mode));\"'$('\"'attract').style.display=mode==='attract'?'block':'none';\"'$('\"'touchMenu').style.visibility=onTitle?'hidden':'visible';\"'$('\"'touchHint').style.visibility=['playing','guest'].includes(mode)?'visible':'hidden';\"'$('\"'cursor').style.display=cursorActive&&inputKind==='keyboard'&&mode==='playing'?'block':'none';}\nfunction exitAttract(){if(mode\"'!=='\"'attract')return false;mode='title';idleTime=0;invincible=false;setScreens();return true;}\nfunction inputActivity(){idleTime=0;if(mode==='attract'){exitAttract();return true;}return false;}\nfunction getLocalPlayer(){return players.find(p=>p.id===(networkMode?link.me:0))||players[0];}\nfunction action(){seq.action++;}\nfunction roll(){seq.roll++;}\nfunction menuButtons(){return [...\"'$('\"'panel').querySelectorAll('button,input,select')].filter(x=>\"'!x.disabled&&x.offsetParent!==null);}\nfunction focusMenu(delta=0){const els=modalPage?menuButtons():[...$('\"'titleScreen').querySelectorAll('button')];if(\"'!els.length)return;menuFocus=(menuFocus+delta+els.length)%els.length;els.forEach((x,i)=>x.classList.toggle('\"'focused',i===menuFocus));els[menuFocus].focus({preventScroll:true});els[menuFocus].scrollIntoView({block:'nearest'});}\nfunction pause(){if(mode==='attract'){exitAttract();return;}if(modalPage){if(modalPage==='pause')resume();else openModal('pause');return;}if(mode==='playing'||mode==='guest'){previousMode=mode;if(\"'!networkMode)mode='\"'paused';audio.setPaused(\"'!networkMode);openModal('\"'pause');}}\nfunction resume(){if(mode==='paused')mode=previousMode==='guest'?'guest':'playing';closeModal();audio.setPaused(false);setScreens();}\nfunction closeModal(){modalPage='';\"'$('\"'modal').classList.remove('show');}\nfunction backTitle(){link.leave();networkMode=false;guest=false;mode='title';idleTime=0;closeModal();audio.setPaused(false);clearGame();makePlayer(0,-25,18);spawnEnemy('walker',38,-5);spawnEnemy('walker',95,-65);spawnEnemy('probe',-55,-25);setScreens();}\nfunction row(label,key,min,max,step,object=tuning,format=null){const val=object[key];return \"'`<label class=\"setting-row\">${label}<input class=\"focusable\" type=\"range\" data-object=\"${object===settings?'\"'settings':'tuning'}\\\" data-key=\\\"\"'${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${val}\"><output>${format?format(val):val}</output></label>`;}\nfunction openModal(page){\n if(!modalPage)previousMode=mode;modalPage=page;menuFocus=0;let content='\"'';const close=\"'`<button class=\"close\" data-action=\"close\" aria-label=\"Back\">×</button>`;\n if(page==='\"'pause')content=\"'`<div class=\"eyebrow orange\">FLIGHT HOLD</div><h2>Catch your breath.</h2><div class=\"menu-stack\"><button class=\"primary\" data-action=\"resume\">Resume sortie</button><button data-action=\"settings\">Settings</button><button data-action=\"help\">Flight school</button><button data-action=\"dev\">Developer flight deck</button><button data-action=\"about\">About & credits</button><button data-action=\"title\">Return to title</button></div><div class=\"panel-foot\">${networkMode?'\"'ONLINE SORTIES CONTINUE WHILE MENUS ARE OPEN':'THE VALLEY CAN WAIT A MOMENT'}</div>\"'`;\n if(page==='\"'settings')content=close+\"'`<div class=\"eyebrow orange\">YOUR COCKPIT</div><h2>Flight settings</h2>${row('\"'Music','music',0,1,.01,settings,v=>Math.round(v*100)+'%')}\"'${row('\"'Effects & radio','sfx',0,1,.01,settings,v=>Math.round(v*100)+'%')}\"'${row('\"'Camera shake','shake',0,1,.05,settings,v=>Math.round(v*100)+'%')}\"'${row('\"'Tactical zoom','zoom',.8,1.3,.05,settings,v=>v.toFixed(2)+'×')}<label class=\\\"setting-row\\\">Controller glyphs<select class=\\\"focusable\\\" id=\\\"glyphSelect\\\"><option value=\\\"ps\\\" \"'${settings.glyphs==='\"'ps'?'selected':''}>PlayStation · ✕ ○ □ △</option><option value=\\\"xbox\\\" \"'${settings.glyphs==='\"'xbox'?'selected':''}>Xbox · A B X Y</option></select></label><label class=\\\"setting-row\\\">Aim assistance<select id=\\\"assistSelect\\\" class=\\\"focusable\\\"><option value=\\\"true\\\" \"'${settings.assist?'\"'selected':''}>On · gentle target lock</option><option value=\\\"false\\\" \"'${!settings.assist?'\"'selected':''}>Off · manual aim</option></select></label><p class=\\\"settings-note\\\">Music starts at 10%. Touch flight includes automatic targeting, firing and cable assistance.</p>\"'`;\n if(page==='\"'help')content=close+\"'`<div class=\"eyebrow orange\">ROGUE SQUADRON / FIELD MANUAL</div><h2>Small ship. Big ideas.</h2><div class=\"help-grid\"><div class=\"help-card\"><b>01 · FLY & FIGHT</b><p><em>WASD / left stick</em> steers. Aim with <em>mouse / right stick</em>. Hold <em>left click / R2</em> to fire.</p><p>Hold <em>Shift / L2</em> to boost. <em>Space / ○</em> rolls through danger. Watch blaster heat.</p></div><div class=\"help-card\"><b>02 · TIE THE KNOT</b><p>Approach a walker within 46m. Press <em>E / ✕</em> to latch the cable. Your co-pilot flies the circle.</p><p><em>Keep firing</em> while winding. Two loops bring it down. Press again to release.</p></div><div class=\"help-card\"><b>03 · BRING THEM HOME</b><p>At a survivor beacon, press <em>E / ✕</em> to collect. Fly within 23m of Echo Base to deliver.</p><p>Each rescue repairs your hull and the shield. Recovery is automatic if your ship is downed.</p></div><div class=\"help-card\"><b>04 · COVER THE EXIT</b><p>Stop the walkers before they reach the shield. Then escort <em>both transports</em> north and defeat the interceptor.</p><p>On touch: drag left to fly, right to aim. Blasters assist. Tap the context button for tow / rescue.</p></div></div><div class=\"panel-foot\">SOLO OR 2-PILOT ONLINE CO-OP · NO FRIENDLY FIRE · SHARED VICTORY</div>`;\n if(page==='\"'dev')content=close+\"'`<div class=\"eyebrow orange\">DEVELOPER FLIGHT DECK</div><h2>Make your own odds.</h2>${row('\"'Flight speed','speed',20,100,1)}\"'${row('\"'Blaster damage','damage',4,60,1)}\"'${row('\"'Incoming damage','enemyDamage',0,30,1)}\"'${row('\"'Walker march speed','walkerSpeed',.2,4,.1)}\"'${row('\"'Cable winding speed','cableSpeed',.25,3,.05)}\"'${row('\"'Enemy fire rate','enemyRate',.1,3,.1)}\"'${row('\"'Shield pressure','shieldDrain',0,3,.1)}<div class=\\\"menu-stack\\\" style=\\\"margin-top:18px\\\"><button data-action=\\\"god\\\">Invulnerability: \"'${invincible?'\"'ON':'OFF'}</button><button data-action=\\\"freeze\\\">Freeze enemies: \"'${freezeEnemies?'\"'ON':'OFF'}</button><button data-action=\\\"heal\\\">Repair ship & shield</button><button data-action=\\\"phase\\\">Advance mission chapter</button><button data-action=\\\"resetTuning\\\">Reset balance to defaults</button></div><p class=\\\"settings-note\\\">Values apply live. In online co-op, the host controls simulation. Chapter advance keeps the mission playable.</p>\"'`;\n if(page==='\"'online')content=close+\"'`<div class=\"eyebrow orange\">TWO PILOTS / ONE REBELLION</div><h2>Bring a wingmate.</h2><p>Share a flight code. Your wingmate can join from this game on another device. The host flies as Rogue Leader.</p><div class=\"menu-stack\"><button class=\"primary\" data-action=\"host\">Host co-op sortie</button></div><div class=\"room-row\"><input id=\"roomInput\" maxlength=\"32\" placeholder=\"Flight code\" aria-label=\"Flight code\"><button data-action=\"join\">Join</button></div><p class=\"online-status\" id=\"onlineStatus\">${onlineText}</p><p class=\"room-code\" id=\"roomCode\">${link.room||'\"''}</p><p class=\\\"settings-note\\\">Same-browser flights connect locally. Remote flights use encrypted WebRTC with public signaling. In AI Hub, the lobby supplies your crew automatically.</p>\"'`;\n if(page==='\"'about')content=close+\"'`<div class=\"eyebrow orange\">THE EMPIRE STRIKES A DETOUR</div><h2>Behind the flight.</h2><p>An unofficial, original tribute to the snowbound rebellion and the arcade spirit of 1982. All models, animation, music, effects and radio voices are generated in code.</p><div class=\"about-copy\"><h3>Source Information</h3><dl>${Object.entries(feedback.sourceInformation).map(([k,v])=>`<dt>${k[0].toUpperCase()+k.slice(1)}</dt><dd>${v}</dd>`).join('\"'')}</dl>\"'${[['\"'Testing Feedback',feedback.testingFeedback],['Engine Feedback',feedback.engineFeedback],['Prompt Feedback',feedback.promptFeedback]].map(([title,arr])=>\"'`<h3>${title}</h3>${arr.map(x=>`<p>${x}</p>`).join('\"'')}\"'`).join('\"'')}<h3>Credits</h3><p>Design, code and procedural assets: OpenAI gpt-6.1-sol. Three.js · Rapier · AI Hub Session Kit · PeerJS. Star Wars and The Empire Strikes Back belong to their respective owners. This fan tribute is unaffiliated.</p></div>\"'`;\n $('\"'panel').innerHTML=content;\"'$('\"'modal').classList.add('show');setScreens();if(inputKind==='gamepad')focusMenu();\n}\nfunction showResult(won){if(['won','lost'].includes(mode))return;mode=won?'won':'lost';for(const p of players)p.body.setLinvel({x:0,y:0,z:0},true);closeModal();audio.sfx(won?'win':'lose');link.finish(won,score,{rescued,kills,evacuated,seconds:Math.round(elapsed)});modalPage='result';\"'$('\"'panel').innerHTML=\"'`<div class=\"eyebrow orange\">${won?'\"'ECHO VALLEY / ALL CLEAR':'ECHO VALLEY / SIGNAL LOST'}</div><h2>\"'${won?'\"'The rebellion flies on.':'A cold day for the Empire.'}</h2><p>\"'${won?'\"'The last transports vanish into the clouds. Behind you, two very expensive walkers lie tangled in the snow.':'Your sortie is over. The next pilot will know where to aim.'}</p><div class=\\\"result-stats\\\"><div><strong>\"'${score.toLocaleString()}</strong><small>SORTIE SCORE</small></div><div><strong>${rescued} / 3</strong><small>SURVIVORS SAVED</small></div><div><strong>${evacuated} / 2</strong><small>TRANSPORTS AWAY</small></div></div><div class=\"menu-stack\"><button class=\"primary\" data-action=\"retry\">Fly another sortie</button><button data-action=\"title\">Return to title</button><button data-action=\"about\">Credits & flight report</button></div><div class=\"panel-foot\">${won?(baseHP>65?'\"'GOLD FLIGHT · THE SHIELD STILL STANDS':'SILVER FLIGHT · AGAINST THE ODDS'):'TIP: TOW CABLES DO THE HEAVY LIFTING. RESCUES REPAIR THE SHIELD.'}</div>\"'`;$('\"'modal').classList.add('show');setScreens();if(inputKind==='gamepad')focusMenu();}\n\nfunction handleAction(a){audio.unlock();audio.sfx('ui');inputActivity();switch(a){case'launch':startGame();break;case'pause':pause();break;case'resume':resume();break;case'close':if(previousMode==='title'||mode==='title')closeModal();else openModal('pause');break;case'title':backTitle();break;case'retry':if(guest){onlineText='The host starts the next sortie.';openModal('online');}else startGame();break;case'god':invincible=\"'!invincible;openModal('\"'dev');break;case'freeze':freezeEnemies=\"'!freezeEnemies;openModal('\"'dev');break;case'heal':players.forEach(p=>p.hp=100);baseHP=100;say('Fresh power. Try to keep the paint on this time.','ROGUE TWO');break;case'phase':for(const e of enemies)if(\"'!e.dead)killEnemy(e,false);if(phase<2)beginPhase(phase+1);else{transports.forEach(t=>{t.z=-116;t.escaped=true;});evacuated=2;}openModal('\"'dev');break;case'resetTuning':tuning={...defaults};invincible=false;freezeEnemies=false;openModal('dev');break;case'host':onlineText='Opening flight channel…';openModal('online');link.host().catch(e=>{onlineText=e.message;openModal('online');});break;case'join':{const code=\"'$('\"'roomInput')?.value.trim();if(code){onlineText='Calling '+code+'…';link.join(code).catch(e=>{onlineText=e.message;openModal('online');});}}break;default:openModal(a);}}\n\ndocument.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b)handleAction(b.dataset.action);});\ndocument.addEventListener('pointerover',e=>{const b=e.target.closest('button');if(b){document.querySelectorAll('button.focused').forEach(x=>x.classList.remove('focused'));b.classList.add('focused');}});\ndocument.addEventListener('input',e=>{if(e.target.dataset.key){const obj=e.target.dataset.object==='settings'?settings:tuning,k=e.target.dataset.key;obj[k]=Number(e.target.value);e.target.nextElementSibling.textContent=obj===settings&&['music','sfx','shake'].includes(k)?Math.round(obj[k]*100)+'%':obj[k];audio.setMusic(settings.music);audio.setSfx(settings.sfx);saveSettings();}});\ndocument.addEventListener('change',e=>{if(e.target.id==='glyphSelect')settings.glyphs=e.target.value;if(e.target.id==='assistSelect')settings.assist=e.target.value==='true';saveSettings();updatePrompts();});\nwindow.addEventListener('keydown',e=>{if(e.target.matches('input:not([type=range]),select'))return;const wasDemo=inputActivity();setInputKind('keyboard');audio.unlock();if(wasDemo)return;if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code))e.preventDefault();if(e.repeat)return;keys.add(e.code);if(e.code==='Escape'){if(modalPage){if(mode==='title')closeModal();else if(modalPage==='pause')resume();else openModal('pause');}else pause();}else if(e.code==='KeyE')action();else if(e.code==='Space'&&\"'!modalPage&&mode!=='\"'title')roll();else if(e.code==='Enter'&&mode==='title'&&\"'!modalPage)startGame();});\nwindow.addEventListener('\"'keyup',e=>keys.delete(e.code));window.addEventListener('blur',()=>{keys.clear();pointer.down=false;if(mode==='playing'&&\"'!networkMode)pause();});\n$('\"'view').addEventListener('contextmenu',e=>e.preventDefault());\nwindow.addEventListener('pointermove',e=>{if(e.pointerType==='touch')return;inputActivity();if(\"'!modalPage){setInputKind('\"'keyboard');cursorActive=true;pointer.x=e.clientX;pointer.y=e.clientY;pointer.active=true;\"'$('\"'cursor').style.left=e.clientX+'px';\"'$('\"'cursor').style.top=e.clientY+'px';}setScreens();});\n\"'$('\"'view').addEventListener('pointerdown',e=>{if(e.pointerType==='touch')return;const demo=inputActivity();setInputKind('keyboard');audio.unlock();if(\"'!demo)pointer.down=e.button===0;});window.addEventListener('\"'pointerup',e=>{if(e.pointerType\"'!=='\"'touch')pointer.down=false;});\n\"'$('\"'view').addEventListener('touchstart',e=>{e.preventDefault();if(inputActivity())return;setInputKind('touch');audio.unlock();for(const t of e.changedTouches)touches.set(t.identifier,{x:t.clientX,y:t.clientY,side:t.clientX<innerWidth/2?'move':'aim'});},{passive:false});\n\"'$('\"'view').addEventListener('touchmove',e=>{e.preventDefault();for(const t of e.changedTouches){const start=touches.get(t.identifier);if(\"'!start)continue;let x=clamp((t.clientX-start.x)/65,-1,1),z=clamp((t.clientY-start.y)/65,-1,1);if(start.side==='\"'move')touchMove={x,z};else touchAim={x,z};}},{passive:false});\nfunction endTouch(e){for(const t of e.changedTouches){const s=touches.get(t.identifier);if(s?.side==='move')touchMove={x:0,z:0};if(s?.side==='aim')touchAim={x:0,z:0};touches.delete(t.identifier);}}window.addEventListener('touchend',endTouch);window.addEventListener('touchcancel',endTouch);\"'$('\"'touchAction').addEventListener('click',()=>{setInputKind('touch');action();});\n\nfunction pollPad(now){const pads=navigator.getGamepads?.()||[],pad=[...pads].find(p=>p?.connected);if(\"'!pad)return null;const b=i=>!!pad.buttons[i]?.pressed,edge=i=>b(i)&&!padState.buttons[i],axis=i=>Math.abs(pad.axes[i]||0)>.16?pad.axes[i]:0;const activity=pad.buttons.some(v=>v.pressed)||pad.axes.some(v=>Math.abs(v)>.2);if(activity){const demo=inputActivity();setInputKind('\"'gamepad');audio.unlock();if(demo){padState.buttons=pad.buttons.map(v=>v.pressed);return null;}}\n if(edge(9))pause();\n if(mode==='title'||modalPage){let dy=(b(13)||axis(1)>.6?1:0)-(b(12)||axis(1)<-.6?1:0),dx=(b(15)||axis(0)>.6?1:0)-(b(14)||axis(0)<-.6?1:0);if(activity&&dy&&(now-padState.lastNav>.22)){focusMenu(dy);padState.lastNav=now;}if(dx&&now-padState.lastNav>.15){const el=document.activeElement;if(el?.type==='range'){el.value=clamp(Number(el.value)+dx*Number(el.step),Number(el.min),Number(el.max));el.dispatchEvent(new Event('input',{bubbles:true}));}else if(el?.tagName==='SELECT'){el.selectedIndex=clamp(el.selectedIndex+dx,0,el.options.length-1);el.dispatchEvent(new Event('change',{bubbles:true}));}padState.lastNav=now;}if(edge(0)){if(\"'!document.activeElement?.matches('\"'button'))focusMenu(0);document.activeElement?.click();}if(edge(1)&&modalPage){if(mode==='title')closeModal();else if(modalPage==='pause')resume();else openModal('pause');}}\n else{if(edge(0))action();if(edge(1))roll();}\n padState.buttons=pad.buttons.map(v=>v.pressed);return{mx:axis(0),mz:axis(1),rx:axis(2),rz:axis(3),fire:b(7)||b(2),boost:b(6)};\n}\nfunction readControls(p,pad){if(testInput)return{mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:seq.action,rollSeq:seq.roll,...testInput};const c={mx:0,mz:0,ax:Math.sin(p?.heading||0),az:-Math.cos(p?.heading||0),fire:false,boost:false,actionSeq:seq.action,rollSeq:seq.roll};if(modalPage)return c;\n if(inputKind==='gamepad'&&pad){c.mx=pad.mx;c.mz=pad.mz;c.fire=pad.fire;c.boost=pad.boost;if(Math.hypot(pad.rx,pad.rz)>.2){const n=norm(pad.rx,pad.rz);c.ax=n.x;c.az=n.z;}else if(Math.hypot(c.mx,c.mz)>.2){const n=norm(c.mx,c.mz);c.ax=n.x;c.az=n.z;}}\n else if(inputKind==='touch'){c.mx=touchMove.x;c.mz=touchMove.z;c.boost=Math.hypot(c.mx,c.mz)>.95;c.fire=true;if(Math.hypot(touchAim.x,touchAim.z)>.1){const n=norm(touchAim.x,touchAim.z);c.ax=n.x;c.az=n.z;}else{const e=nearestEnemy(p);if(e){const n=norm(e.x-p.x,e.z-p.z);c.ax=n.x;c.az=n.z;}}}\n else{c.mx=(keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0);c.mz=(keys.has('KeyS')||keys.has('ArrowDown')?1:0)-(keys.has('KeyW')||keys.has('ArrowUp')?1:0);c.fire=pointer.down||keys.has('KeyJ');c.boost=keys.has('ShiftLeft')||keys.has('ShiftRight');if(pointer.active&&p){raycaster.setFromCamera(new THREE.Vector2(pointer.x/innerWidth*2-1,-pointer.y/innerHeight*2+1),camera);raycaster.ray.intersectPlane(groundPlane,pointerPoint);const n=norm(pointerPoint.x-p.x,pointerPoint.z-p.z);c.ax=n.x;c.az=n.z;}else if(Math.hypot(c.mx,c.mz)>.1){const n=norm(c.mx,c.mz);c.ax=n.x;c.az=n.z;}}\n return c;\n}\nfunction nearestEnemy(p,filter=()=>true){return enemies.filter(e=>\"'!e.dead&&filter(e)).sort((a,b)=>dist(a,p)-dist(b,p))[0];}\nfunction demoControls(p){\n const c={mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:p.actionSeq,rollSeq:p.rollSeq};\n if(p.towId!==null)return c;let target=nearestEnemy(p,e=>e.type!=='\"'walker');if(phase===1){target=nearestEnemy(p,e=>e.type==='walker');if(target&&dist(p,target)<43){c.actionSeq=p.actionSeq+1;return c;}}\n if(target){let d=dist(p,target),n=norm(target.x-p.x,target.z-p.z);c.ax=n.x;c.az=n.z;if(d>42){c.mx=n.x;c.mz=n.z;c.boost=d>85;}else{c.mx=-n.z*.4;c.mz=n.x*.4;}}\n return c;\n}\nfunction playerAction(p){if(p.towId\"'!==null){releaseTow(p);say('\"'Cable released. Pick your next angle.','ROGUE TWO');return;}const pod=pods.find(x=>\"'!x.saved&&!x.carried&&dist(p,x)<15);if(pod&&!p.carrying){pod.carried=true;pod.mesh.visible=false;pod.ring.visible=false;p.carrying=pod.id;audio.sfx('\"'pickup');say('Got them. Bring that survivor back to Echo Base.','ROGUE TWO');return;}const e=nearestEnemy(p,e=>e.type==='walker'&&\"'!players.some(q=>q.towId===e.id));if(e&&dist(p,e)<46){p.towId=e.id;p.towAngle=Math.atan2(p.z-e.z,p.x-e.x);p.towProgress=0;p.towTravel=0;audio.sfx('\"'tow');say('Cable locked. I have the circle. You keep their heads down.','ROGUE TWO');}}\nfunction releaseTow(p){p.towId=null;p.towProgress=0;}\nfunction updatePlayer(p,c,dt){\n p.fireCD-=dt;p.rollCD=Math.max(0,p.rollCD-dt);p.invuln=Math.max(0,p.invuln-dt);p.heat=Math.max(0,p.heat-dt*25);if(p.heat<25)p.overheat=false;\n if(c.actionSeq\"'!==p.actionSeq){p.actionSeq=c.actionSeq;playerAction(p);}if(c.rollSeq!==p.rollSeq){p.rollSeq=c.rollSeq;if(p.rollCD<=0){p.rollCD=4.5;p.invuln=1;p.roll.reset().play();audio.sfx('\"'boost');}}\n let nx=c.mx,nz=c.mz,n=Math.hypot(nx,nz);if(n>1){nx/=n;nz/=n;}\n let speed=tuning.speed*(c.boost?1.8:1)*(p.carrying?.85:1);p.boost=\"'!!c.boost;\n if(p.towId!==null){const e=enemies.find(e=>e.id===p.towId&&!e.dead);if(!e)releaseTow(p);else{const radius=30;p.towAngle+=dt*1.4*tuning.cableSpeed;p.towTravel+=dt*1.4*tuning.cableSpeed;p.towProgress=p.towTravel/(TAU*1.65);const tx=e.x+Math.cos(p.towAngle)*radius,tz=e.z+Math.sin(p.towAngle)*radius;p.body.setTranslation({x:tx,y:7,z:tz},true);p.body.setLinvel({x:0,y:0,z:0},true);p.x=tx;p.z=tz;c.ax=-Math.sin(p.towAngle);c.az=Math.cos(p.towAngle);e.tow=p.towProgress;if(p.towProgress>=1){killEnemy(e,true);releaseTow(p);score+=1200;say('\"'That is one way to shorten a walker.','ROGUE TWO','happy');}}}\n if(p.towId===null){const v=p.body.linvel();p.body.setLinvel({x:THREE.MathUtils.lerp(v.x,nx*speed,1-Math.exp(-dt*7)),y:0,z:THREE.MathUtils.lerp(v.z,nz*speed,1-Math.exp(-dt*7))},true);}\n let aim=norm(c.ax,c.az);if((settings.assist||mode==='attract')&&c.fire){const target=enemies.filter(e=>\"'!e.dead&&e.type!=='\"'walker'&&dist(e,p)<160).sort((a,b)=>dist(a,p)-dist(b,p)).find(e=>{const v=norm(e.x-p.x,e.z-p.z);return v.x*aim.x+v.z*aim.z>.88;});if(target)aim=norm(target.x-p.x,target.z-p.z);}\n p.heading=Math.atan2(aim.x,-aim.z);p.mesh.rotation.y=p.heading;\n if(c.fire&&p.fireCD<=0&&\"'!p.overheat){p.fireCD=.14;p.heat+=9;if(p.heat>=100)p.overheat=true;spawnShot(p.x+aim.x*8,7,p.z+aim.z*8,aim.x,aim.z,'\"'player',p.id);if(visualTime-lastShotAudio>.1){audio.sfx('laser');lastShotAudio=visualTime;}}\n if(p.carrying&&Math.hypot(p.x,p.z-92)<23){const pod=pods.find(x=>x.id===p.carrying);if(pod)pod.saved=true;p.carrying=null;rescued++;score+=650;baseHP=Math.min(100,baseHP+18);p.hp=Math.min(100,p.hp+35);audio.sfx('pickup');say('One more seat filled. The shield crew sends its thanks.','ECHO CONTROL','happy');}\n p.mixer.update(dt);if(\"'!p.roll.isRunning())p.craft.rotation.z=THREE.MathUtils.lerp(p.craft.rotation.z,-(p.body.linvel().x*Math.cos(p.heading)+p.body.linvel().z*Math.sin(p.heading))*.007,.1);\n p.craft.visible=p.invuln<.01||Math.floor(visualTime*15)%2===0;p.craft.userData.flames?.forEach(f=>f.scale.set(1,1,c.boost?2:.8+Math.sin(visualTime*30)*.12));\n}\nfunction spawnShot(x,y,z,dx,dz,owner,ownerId){const n=norm(dx,dz),mesh=addMesh(new THREE.BoxGeometry(owner==='\"'player'?.65:1,.6,owner==='player'?7:5),owner==='player'?0xffce79:0xe94e46);mesh.position.set(x,y,z);mesh.rotation.y=Math.atan2(-n.x,-n.z);shots.push({id:nextID++,x,y,z,dx:n.x,dz:n.z,life:1.8,owner,ownerId,mesh});}\nfunction hurtPlayer(p,damage){if(p.invuln>0||invincible||mode==='attract')return;p.hp-=damage;p.invuln=.5;shake=.5;audio.sfx('hit');\"'$('\"'damageFlash').style.opacity=1;setTimeout(()=>\"'$('\"'damageFlash').style.opacity=0,180);if(p.hp<=0){if(p.carrying){const pod=pods.find(x=>x.id===p.carrying);if(pod){pod.carried=false;pod.x=p.x;pod.z=p.z;pod.mesh.position.set(p.x,2,p.z);pod.ring.position.set(p.x,.2,p.z);pod.mesh.visible=pod.ring.visible=true;}p.carrying=null;}releaseTow(p);explode(p.x,7,p.z,0xf66936,24);if(networkMode&&baseHP>20){baseHP-=20;p.hp=70;p.invuln=4;p.body.setTranslation({x:0,y:7,z:65},true);say('A spare speeder. Do not make this a habit.','ECHO CONTROL');}else showResult(false);}}\nfunction killEnemy(e,cable=false){if(e.dead)return;e.dead=true;kills++;score+=e.type==='probe'?150:e.type==='ace'?2200:600;world.removeRigidBody(e.body);if(e.type==='walker'){e.fall=.001;e.mesh.userData.mixer?.stopAllAction();shake=1;explode(e.x,13,e.z,0xf7a452,40);const mixer=new THREE.AnimationMixer(e.mesh);const a=mixer.clipAction(new THREE.AnimationClip('Cable takedown',2.1,[new THREE.NumberKeyframeTrack('.rotation[z]',[0,.4,1.1,1.65,2.1],[0,.07,-.25,-1.45,-1.52]),new THREE.NumberKeyframeTrack('.position[y]',[0,1.1,2.1],[0,-1,-4])]));a.setLoop(THREE.LoopOnce,1);a.clampWhenFinished=true;a.play();e.fallMixer=mixer;}else{explode(e.x,e.y,e.z,e.type==='ace'?0xf66936:0xffcf80,e.type==='ace'?32:16);e.mesh.visible=false;}audio.sfx('explosion');if(e.type==='ace')say('Their ace just folded. Stay with the transports.','ROGUE TWO','happy');}\nfunction explode(x,y,z,c,count=16){for(let i=0;i<count;i++){const mesh=addMesh(new THREE.IcosahedronGeometry(.5+Math.random()*1.4,0),i%3?c:0x314b58),body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(x+(Math.random()-.5)*4,y,z+(Math.random()-.5)*4).setLinvel((Math.random()-.5)*30,Math.random()*20+5,(Math.random()-.5)*30).setAngvel({x:Math.random()*5,y:4,z:2}));world.createCollider(RAPIER.ColliderDesc.ball(.55).setRestitution(.25),body);debris.push({mesh,body,life:3+Math.random()*2});}const ring=makeCircle(2,c);ring.position.set(x,.5,z);effects.push({mesh:ring,life:.6,max:.6});}\nfunction enemyUpdate(e,dt){if(e.dead){e.fallMixer?.update(dt);return;}e.age+=dt;e.fire-=dt*tuning.enemyRate;if(freezeEnemies)return;\n if(e.type==='walker'){e.z+=dt*tuning.walkerSpeed*(e.tow>0?.4:1);e.mesh.position.z=e.z;e.mesh.rotation.y=Math.PI;if(e.z>60){baseHP-=dt*3.5*tuning.shieldDrain;if(phaseTime%6<dt)say('That walker is inside the perimeter. Cable it now.','ECHO CONTROL','urgent');}if(e.fire<=0){e.fire=4+Math.random()*3;const p=players[Math.floor(Math.random()*players.length)];if(p){const n=norm(p.x-e.x,p.z-e.z);spawnShot(e.x,7,e.z+15,n.x,n.z,'enemy',e.id);}}}\n else if(e.type==='ace'){e.x=Math.sin(e.age*.36)*105;e.z=-42+Math.cos(e.age*.5)*42;e.y=11+Math.sin(e.age)*2;e.mesh.position.set(e.x,e.y,e.z);e.mesh.rotation.y=Math.atan2(-Math.cos(e.age*.36)*38,Math.sin(e.age*.5)*21);if(e.fire<=0){e.fire=1.25;const p=players[0];if(p){const n=norm(p.x-e.x,p.z-e.z);for(let i=-1;i<=1;i++){const a=Math.atan2(n.z,n.x)+i*.13;spawnShot(e.x,7,e.z,Math.cos(a),Math.sin(a),'enemy',e.id);}}}if(phase===2)for(const t of transports)if(\"'!t.escaped&&dist(e,t)<45)t.hp-=dt*1.5*tuning.enemyDamage/10;}\n else{e.x=e.originX+Math.sin(e.age*.55)*14;e.z=e.originZ+Math.cos(e.age*.4)*11;e.mesh.position.set(e.x,e.y,e.z);if(e.fire<=0){e.fire=3.5+Math.random()*2;const p=players[Math.floor(Math.random()*players.length)];if(p){const n=norm(p.x-e.x,p.z-e.z);spawnShot(e.x,7,e.z,n.x,n.z,'\"'enemy',e.id);}}}\n e.body.setNextKinematicTranslation({x:e.x,y:e.type==='walker'?12:e.y,z:e.z});e.mesh.userData.mixer?.update(dt);\n}\nfunction updateShots(dt){for(let i=shots.length-1;i>=0;i--){const s=shots[i];s.life-=dt;const speed=s.owner==='player'?215:64,length=speed*dt;let hit=false;\n if(s.owner==='player'){const ray=new RAPIER.Ray({x:s.x,y:s.y,z:s.z},{x:s.dx,y:0,z:s.dz});const result=world.castRay(ray,length+3,true,undefined,undefined,undefined,undefined,c=>c.parent()?.userData?.type==='enemy');if(result){const id=result.collider.parent().userData.id,e=enemies.find(e=>e.id===id&&\"'!e.dead);if(e){hit=true;if(e.type==='\"'walker'){if(visualTime-lastShotAudio>.2)audio.sfx('hit');score+=1;}else{e.hp-=tuning.damage;if(e.hp<=0)killEnemy(e);else if(Math.random()<.3)audio.sfx('hit');}}}}\n else{for(const p of players){const px=p.x-s.x,pz=p.z-s.z,t=clamp(px*s.dx+pz*s.dz,0,length);if(Math.hypot(px-s.dx*t,pz-s.dz*t)<4.2){hurtPlayer(p,tuning.enemyDamage);hit=true;break;}}if(\"'!hit&&phase===2)for(const t of transports){if(!t.escaped&&Math.hypot(t.x-s.x,t.z-s.z)<10){t.hp-=tuning.enemyDamage*.6;hit=true;break;}}}\n s.x+=s.dx*length;s.z+=s.dz*length;s.mesh.position.set(s.x,s.y,s.z);if(hit||s.life<=0||Math.abs(s.x)>170||Math.abs(s.z)>130){dynamicRoot.remove(s.mesh);shots.splice(i,1);}}\n}\nfunction fixedUpdate(dt,controls=null){\n if(!['\"'playing','attract'].includes(mode)||guest)return;elapsed+=dt;phaseTime+=dt;if(mode==='attract')attractTime+=dt;\n for(const p of players){let c=mode==='attract'?demoControls(p):(controls&&p.id===(networkMode?link.me:0)?controls:remoteInputs.get(p.id));if(\"'!c)c={mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:p.actionSeq,rollSeq:p.rollSeq};updatePlayer(p,c,dt);}\n for(const e of enemies)enemyUpdate(e,dt);world.step();physicsTime+=dt;\n for(const p of players){const t=p.body.translation();const v=p.body.linvel();p.x=t.x;p.z=t.z;p.vx=v.x;p.vz=v.z;p.mesh.position.set(p.x,7,p.z);if(Math.abs(p.x)>157||Math.abs(p.z)>117){p.body.setTranslation({x:clamp(p.x,-156,156),y:7,z:clamp(p.z,-116,116)},true);}for(const e of enemies)if(!e.dead&&e.type==='\"'walker'&&Math.abs(p.x-e.x)<10&&Math.abs(p.z-e.z)<15)hurtPlayer(p,tuning.enemyDamage*.5);}\n updateShots(dt);\n for(let i=debris.length-1;i>=0;i--){const d=debris[i];d.life-=dt;const t=d.body.translation(),q=d.body.rotation();d.mesh.position.set(t.x,t.y,t.z);d.mesh.quaternion.set(q.x,q.y,q.z,q.w);if(d.life<1)d.mesh.scale.setScalar(Math.max(.01,d.life));if(d.life<=0){dynamicRoot.remove(d.mesh);world.removeRigidBody(d.body);debris.splice(i,1);}}\n for(let i=effects.length-1;i>=0;i--){const e=effects[i];e.life-=dt;e.mesh.scale.setScalar(1+(1-e.life/e.max)*25);if(e.life<=0){dynamicRoot.remove(e.mesh);effects.splice(i,1);}}\n for(const pod of pods)if(\"'!pod.saved&&!pod.carried){pod.mesh.position.y=2.4+Math.sin(elapsed*2+pod.id)*.5;pod.ring.rotation.z+=dt;}\n if(phase===0&&enemies.filter(e=>e.type==='\"'probe').every(e=>e.dead))beginPhase(1);\n if(phase===1&&enemies.filter(e=>e.type==='walker').every(e=>e.dead)&&phaseTime>2)beginPhase(2);\n if(phase===2){for(const t of transports){if(t.escaped)continue;t.z-=dt*3.1;t.y=4+Math.min(17,(90-t.z)*.08);t.mesh.position.set(t.x,t.y,t.z);t.mesh.userData.mixer?.update(dt);if(t.z<-112){t.escaped=true;evacuated++;score+=1800;say(evacuated===1?'First transport is clear. One more to go.':'Both transports clear. Finish the interceptor.','ECHO CONTROL','happy');}if(t.hp<=0&&mode\"'!=='\"'attract'){showResult(false);return;}}if(evacuated===2&&enemies.some(e=>e.type==='ace'&&e.dead)){if(mode==='attract'){if(attractTime>25)startGame(true);}else showResult(true);}}\n if(baseHP<=0&&mode\"'!=='\"'attract')showResult(false);if(mode==='attract'){baseHP=100;players.forEach(p=>p.hp=100);transports.forEach(t=>t.hp=160);if(attractTime>150)startGame(true);}\n}\nfunction updateCable(){cableLine.visible=false;const p=getLocalPlayer()||players.find(p=>p.towId\"'!==null);if(!p||p.towId===null)return;const e=enemies.find(x=>x.id===p.towId);if(!e)return;cableLine.visible=true;let count=0;const coils=Math.min(p.towProgress*1.65,1.65);for(let i=0;i<140;i++){const t=i/139,a=p.towAngle-coils*TAU*(1-t),r=i<132?9:THREE.MathUtils.lerp(9,30,(i-132)/7);cablePositions[count++]=e.x+Math.cos(a)*r;cablePositions[count++]=5+t*2;cablePositions[count++]=e.z+Math.sin(a)*r;}cableLine.geometry.setDrawRange(0,140);cableLine.geometry.attributes.position.needsUpdate=true;}\nfunction updateHUD(dt){\n const p=getLocalPlayer();$('\"'healthBar').style.width=(p?.hp||0)+'%';\"'$('\"'hp').textContent=Math.max(0,Math.ceil(p?.hp||0));\"'$('\"'heatBar').style.width=(p?.heat||0)+'%';\"'$('\"'heatBar').style.background=p?.overheat?'#f66936':'#173341';\"'$('\"'score').textContent=String(score).padStart(6,'0');\"'$('\"'missionTime').textContent=String(Math.floor(elapsed/60)).padStart(2,'0')+':'+String(Math.floor(elapsed%60)).padStart(2,'0');\"'$('\"'baseHealth').textContent=Math.max(0,Math.ceil(baseHP))+'%';\"'$('\"'shieldDots').innerHTML=Array.from({length:10},(_,i)=>\"'`<i class=\"${i*10>=baseHP?'\"'off':''}\\\"></i>\"'`).join('\"'');\"'$('\"'rescueStatus').textContent=\"'`SURVIVORS ${rescued} / 3${p?.carrying?'\"' · ABOARD':''}\"'`;\n const titles=['\"'Silence the scout probes','Trip the siege walkers','Cover the evacuation'],labels=['01 / THE APPROACH','02 / THE LONG WALK','03 / THE EVACUATION'];\"'$('\"'phaseLabel').textContent=labels[phase];\"'$('\"'objectiveTitle').textContent=titles[phase];\"'$('\"'objectiveDetail').textContent=phase===0?\"'`${enemies.filter(e=>e.type==='\"'probe'&&e.dead).length} / 4 probes neutralized\"'`:phase===1?`${enemies.filter(e=>e.type==='\"'walker'&&e.dead).length} / 2 walkers grounded · use tow cables\"'`:`${evacuated} / 2 transports clear · interceptor ${enemies.find(e=>e.type==='\"'ace')?.dead?'destroyed':Math.ceil((enemies.find(e=>e.type==='ace')?.hp||0)/4.2)+'%'}\"'`;\n radioTime-=dt;$('\"'radio').style.opacity=radioTime>0?1:0;bannerTime-=dt;\"'$('\"'phaseBanner').style.display=bannerTime>0?'block':'none';\n let context='';if(p&&['playing','guest'].includes(mode)&&\"'!modalPage){const k=inputKind==='\"'gamepad'?(settings.glyphs==='xbox'?'A':'✕'):'E';if(p.towId\"'!==null)context=`${k} · RELEASE CABLE`;else if(p.carrying)context='\"'RETURN SURVIVOR TO ECHO BASE ↓';else if(pods.some(x=>\"'!x.saved&&!x.carried&&dist(p,x)<15))context=`${k} · RESCUE SURVIVOR`;else if(nearestEnemy(p,e=>e.type==='\"'walker')&&dist(p,nearestEnemy(p,e=>e.type==='walker'))<46)context=\"'`${k} · DEPLOY TOW CABLE`;}\n $('\"'contextPrompt').style.display=context?'block':'none';\"'$('\"'contextPrompt').textContent=context;\"'$('\"'touchAction').style.display=inputKind==='touch'&&context&&\"'!p?.carrying?'\"'block':'none';\"'$('\"'touchAction').textContent=p?.towId\"'!==null?'\"'RELEASE':context.includes('RESCUE')?'RESCUE':'TOW';\"'$('\"'towMeter').style.display=p?.towId\"'!==null&&p?'\"'block':'none';\"'$('\"'towPercent').textContent=Math.floor((p?.towProgress||0)*100)+'%';\"'$('\"'towBar').style.width=((p?.towProgress||0)*100)+'%';\n if(p&&pointer.active&&\"'!modalPage){aimMarker.visible=inputKind==='\"'keyboard';aimMarker.position.set(pointerPoint.x,.5,pointerPoint.z);}else aimMarker.visible=false;\n const target=p&&nearestEnemy(p);reticle.visible=\"'!!target;if(target)reticle.position.set(target.x,.4,target.z);\n drawRadar();\n}\nfunction drawRadar(){const ctx=$('\"'radar').getContext('2d'),W=312,H=260;ctx.clearRect(0,0,W,H);ctx.strokeStyle='#17334118';ctx.lineWidth=1;for(let i=0;i<6;i++){ctx.beginPath();ctx.moveTo(i*W/5,0);ctx.lineTo(i*W/5,H);ctx.stroke();ctx.beginPath();ctx.moveTo(0,i*H/5);ctx.lineTo(W,i*H/5);ctx.stroke();}const point=(x,z,c,r=4)=>{ctx.fillStyle=c;ctx.beginPath();ctx.arc(W/2+x/170*W/2,H/2+z/130*H/2,r,0,TAU);ctx.fill();};point(0,95,'#173341',8);for(const e of enemies)if(\"'!e.dead)point(e.x,e.z,e.type==='\"'walker'?'#de542e':'#c54b3d',e.type==='walker'?7:4);for(const p of pods)if(\"'!p.saved&&!p.carried)point(p.x,p.z,'\"'#d5992d',4);for(const t of transports)if(\"'!t.escaped)point(t.x,t.z,'\"'#2a9d99',6);players.forEach((p,i)=>point(p.x,p.z,i?'#32aeb9':'#f66936',6));}\nfunction updateCamera(dt){const aspect=innerWidth/innerHeight;let size=(mode==='title'?105:112)/settings.zoom;if(inputKind==='touch'&&aspect<1)size=180;camera.left=-size*aspect;camera.right=size*aspect;camera.top=size;camera.bottom=-size;camera.updateProjectionMatrix();let tx=0,tz=0;if(mode==='playing'||mode==='guest'||mode==='attract'){const p=getLocalPlayer();if(p){tx=p.x*.23;tz=p.z*.18;}}else if(mode==='title'){tx=22;tz=-3;}\n const jitter=shake*settings.shake;camera.position.set(tx+(Math.random()-.5)*jitter,235+(Math.random()-.5)*jitter,tz+208);camera.lookAt(tx,0,tz-5);shake=Math.max(0,shake-dt*1.5);\n}\nfunction snapshot(){return{v:1,tick:Math.floor(physicsTime*60),mode,phase,elapsed,phaseTime,score,baseHP,rescued,kills,evacuated,players:players.map(({id,x,z,hp,heat,heading,towId,towProgress,towAngle,carrying,boost})=>({id,x,z,hp,heat,heading,towId,towProgress,towAngle,carrying,boost})),enemies:enemies.map(({id,type,x,z,y,hp,maxHP,dead,tow})=>({id,type,x,z,y,hp,maxHP,dead,tow})),transports:transports.map(({id,x,z,y,hp,escaped})=>({id,x,z,y,hp,escaped})),pods:pods.map(({id,x,z,saved,carried})=>({id,x,z,saved,carried})),shots:shots.slice(-