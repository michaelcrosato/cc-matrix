{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > test-game.py <<'EOF'\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport pathlib\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom playwright.sync_api import sync_playwright\n\nHERE = pathlib.Path(__file__).resolve().parent\nPROJECT = json.loads((HERE / 'project.json').read_text())\nFAILURES = []\nCOUNT = 0\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\ndef check(label, condition):\n    global COUNT\n    COUNT += 1\n    if not condition:\n        FAILURES.append(label)\n\ndef run():\n    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), functools.partial(QuietHandler, directory=str(HERE.parent)))\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    base = f'http://127.0.0.1:{server.server_port}/'\n    url = base + PROJECT['stem'] + '.html'\n    try:\n        with sync_playwright() as pw:\n            browser = pw.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--no-sandbox'])\n            page = browser.new_page(viewport={'width': 1600, 'height': 1000}, device_scale_factor=1)\n            errors = []\n            page.on('pageerror', lambda e: errors.append(str(e)))\n            page.goto(url, wait_until='load')\n            try:\n                page.wait_for_function('\"'!!window.__game'\"', timeout=90000)\n            except Exception:\n                check('Game initializes: ' + page.locator('#bootError').inner_text() + ' / ' + str(errors), False)\n                browser.close()\n                return\n            page.evaluate('__game.hold(true)')\n            state=page.evaluate('__game.getState()')\n            check('Native WebGPU renderer starts', state['renderer']=='WebGPU')\n            check('Rapier 0.19.3 active', state['physics']=='Rapier 0.19.3' and state['bodyCount']>0)\n            check('Music defaults to ten percent', state['settings']['music']==.1)\n            check('Title shown', page.locator('#titleScreen').is_visible())\n            page.get_by_role('button', name='Launch sortie').click()\n            check('Launch enters game', page.evaluate('__game.getState().mode')=='playing')\n            page.evaluate('__game.input({mx:1,mz:0,ax:0,az:-1,fire:false,boost:false});__game.step(1)')\n            moved=page.evaluate('__game.getState().players[0].x')\n            check('Physics flight movement', moved>5)\n            page.evaluate('__game.input({mx:1,mz:0,ax:0,az:-1,fire:false,boost:true});__game.step(1)')\n            boosted=page.evaluate('__game.getState().players[0].x')\n            check('Boost increases movement', boosted-moved>48)\n            page.evaluate('__game.input(null)')\n            page.keyboard.press('Escape')\n            check('Pause stops solo flight', page.evaluate('__game.getState().mode')=='paused')\n            page.get_by_role('button',name='Developer flight deck').click()\n            slider=page.locator('input[data-key=\\\"damage\\\"]')\n            slider.fill('30')\n            check('Live balance slider works', page.evaluate('__game.getState().tuning.damage')==30)\n            page.get_by_role('button',name='Reset balance to defaults').click()\n            check('Reset balance restores defaults', page.evaluate('__game.getState().tuning.damage')==18)\n            page.keyboard.press('Escape')\n            page.get_by_role('button',name='Settings',exact=True).click()\n            page.locator('#glyphSelect').select_option('xbox')\n            check('Controller glyph setting persists', page.evaluate('__game.getState().settings.glyphs')=='xbox')\n            page.locator('#glyphSelect').select_option('ps')\n            page.keyboard.press('Escape')\n            page.get_by_role('button',name='Resume sortie').click()\n            page.evaluate('__game.dev(\\\"god\\\")')\n            page.keyboard.press('Escape')\n            page.get_by_role('button',name='Resume sortie').click()\n            # A deterministic pilot uses only flight, blasters, cable, and rescue mechanics.\n            result=page.evaluate('''() => {\n                __game.teleport(-95,15);__game.action();__game.step(.05,{mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:1,rollSeq:0});\n                const carried=__game.getState().players[0].carrying\"'!==null;\n                __game.teleport(0,85);__game.step(.1,{mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:1,rollSeq:0});\n                const rescued=__game.getState().rescued;\n                let steps=0;\n                while(__game.getState().phase===0 && steps++<100){\n                    const s=__game.getState(), e=s.enemies.find(e=>!e.dead);\n                    __game.teleport(e.x,e.z+38);\n                    __game.step(.5,{mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:1,rollSeq:0});\n                }\n                return {carried,rescued,steps,state:__game.getState()};\n            }'\"''')\n            check('Survivor collection', result['carried'])\n            check('Survivor delivered and scored', result['rescued']==1)\n            check('Chapter one completed with blasters', result['state']['phase']==1)\n            result=page.evaluate('''() => {\n                let action=1;\n                for(let i=0;i<2;i++){\n                    const e=__game.getState().enemies.find(e=>e.type==='walker'&&\"'!e.dead);\n                    if(!e)break;\n                    __game.teleport(e.x+30,e.z);\n                    action++;\n                    __game.step(.05,{mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:action,rollSeq:0});\n                    __game.step(8.5,{mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:action,rollSeq:0});\n                }\n                return __game.getState();\n            }'\"''')\n            check('Tow cable destroys both armored walkers', len([e for e in result['enemies'] if e['type']=='walker' and e['dead']])==2)\n            check('Evacuation chapter begins', result['phase']==2 and len(result['transports'])==2)\n            result=page.evaluate('''() => {\n                let i=0;\n                while(\"'!__game.getState().enemies.find(e=>e.type==='\"'ace')?.dead && i++<180){\n                    const s=__game.getState(),e=s.enemies.find(e=>e.type==='ace');\n                    if(\"'!e)break;\n                    __game.teleport(e.x,e.z+30);\n                    __game.step(.25,{mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:3,rollSeq:0});\n                }\n                let j=0;\n                while(__game.getState().mode==='\"'playing' && j++<90)__game.step(1,{mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:3,rollSeq:0});\n                return __game.getState();\n            }''')\n            check('Interceptor defeated by blasters', any(e['type']=='ace' and e['dead'] for e in result['enemies']))\n            check('Both transports escape', result['evacuated']==2)\n            check('Entire campaign reaches victory', result['mode']=='won')\n            check('Score includes objectives', result['score']>=8500)\n            audio=page.evaluate('__game.audioTest()')\n            check('Procedural audio is finite and audible', bool(audio.get('finite')) and audio.get('rms',0)>.001)\n            page.get_by_role('button',name='Return to title').click()\n            page.evaluate('__game.idle(11)')\n            page.wait_for_function('__game.getState().mode===\\\"attract\\\"')\n            check('Attract begins after ten seconds', True)\n            page.keyboard.press('KeyW')\n            check('Any input exits attract to title', page.evaluate('__game.getState().mode')=='title')\n            page.get_by_role('button',name='About & credits').click()\n            about=page.locator('#panel').inner_text()\n            check('Credits include all feedback and source fields', all(s in about for s in ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback','added on import']))\n            check('No runtime JavaScript errors', not errors)\n            page.close()\n            # Standard mapped virtual DualSense.\n            pad_page=browser.new_page(viewport={'width':1280,'height':800})\n            pad_page.add_init_script('''window.pad={connected:true,index:0,id:'Virtual DualSense',mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};navigator.getGamepads=()=>[window.pad];''')\n            pad_page.goto(url)\n            pad_page.wait_for_function('\"'!!window.__game'\"',timeout=90000)\n            pad_page.evaluate('window.pad.buttons[0]={pressed:true,value:1}')\n            pad_page.wait_for_function('__game.getState().mode===\\\"playing\\\"')\n            check('Controller starts sortie from title', True)\n            pad_page.evaluate('window.pad.buttons[0]={pressed:false,value:0};window.pad.axes[0]=1')\n            pad_page.wait_for_timeout(650)\n            check('Controller axis flies ship', pad_page.evaluate('__game.getState().players[0].x')>-10)\n            check('Prompts switch to PlayStation', '✕' in pad_page.locator('#controlStrip').inner_text())\n            pad_page.close()\n            # Visual inspection only uses WebGL fallback: WebGPU headless captures can be blank.\n            visual=browser.new_page(viewport={'width':1600,'height':1000})\n            visual.goto(url+'?webgl=1')\n            visual.wait_for_function('\"'!!window.__game'\"',timeout=90000)\n            visual.evaluate('__game.hold(true)')\n            visual.screenshot(path=str(HERE/'title-screen.png'))\n            visual.get_by_role('button',name='Launch sortie').click()\n            visual.evaluate('__game.hold(true);__game.dev(\\\"phase\\\");__game.dev(\\\"resume\\\")')\n            visual.wait_for_timeout(1000)\n            visual.screenshot(path=str(HERE/'gameplay-screen.png'))\n            check('Fallback renderer works',visual.evaluate('__game.getState().renderer')=='WebGL2')\n            visual.close()\n            browser.close()\n    finally:\n        server.shutdown()\n        server.server_close()\n\nif __name__=='__main__':\n    try:\n        run()\n    except Exception as e:\n        check(f'Unexpected test error: {type(e).__name__}: {e}',False)\n    for failure in FAILURES:\n        print('FAIL: '+failure)\n    print(f'{COUNT-len(FAILURES)}/{COUNT} checks passed; {len(FAILURES)} failures')\n    sys.exit(bool(FAILURES))\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python test-game.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '290,440p' network.js && rg -n 'getSnapshot|finite|rms|renderAudioTest' audio.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '290,440p' network.js && rg -n 'getSnapshot|finite|rms|renderAudioTest' audio.js\"","aggregated_output":"    this._emit('players', this.players);\n    this._emit('leave', {id: 1, reason});\n    this._status(`Wingmate left · flight ${this.room} remains open`);\n  }\n\n  _receive(data, from, transport) {\n    if (this.ended || !data || data.v !== NET_VERSION) return;\n    this._lastReceive = now();\n    this.stats.received++;\n    if (this.mode === 'hub' && !this.players.some(p => p.id === from) && from !== this.hostId) return;\n    if (data.type === 'input' && this.isHost && from !== this.hostId) {\n      if (!data.input || typeof data.input !== 'object' || !Number.isFinite(data.seq)) return;\n      const old = this._lastInputSeq.get(from) ?? -1;\n      if (data.seq <= old) return;\n      this._lastInputSeq.set(from, data.seq);\n      this._emit('input', {id: from, input: data.input});\n    } else if (data.type === 'snapshot' && !this.isHost && from === this.hostId) {\n      if (!Number.isFinite(data.seq) || data.seq <= this._lastSnapshotSeq) return;\n      this._lastSnapshotSeq = data.seq;\n      this._emit('snapshot', data.state);\n    } else if (data.type === 'bye') {\n      if (this.isHost) this._removeGuest('left');\n      else {\n        this.started = false;\n        this._status('The host closed this flight', {error: true});\n        this._emit('disconnect', {id: 0});\n      }\n    } else if (data.type === 'result' && !this.isHost && from === this.hostId) {\n      this._emit('result', data.result);\n    }\n  }\n\n  sendInput(input) {\n    if (!input || this.ended) return;\n    this._input = input;\n  }\n\n  sendSnapshot(state) {\n    if (this.isHost && !this.ended) this._snapshot = state;\n  }\n\n  _send(data, to) {\n    if (this.ended || this.mode === 'solo') return false;\n    try {\n      const text = JSON.stringify(data);\n      if (text.length > MAX_STATE_BYTES) {\n        this.stats.dropped++;\n        if (!this._warnedSize) {\n          this._warnedSize = true;\n          console.warn('Co-op snapshot exceeds 15.5 KB. Reduce replicated entities.');\n        }\n        return false;\n      }\n      if (this.mode === 'hub') {\n        const ok = globalThis.AIHub.send(data, {to, reliable: false});\n        if (ok) this.stats.sent++;\n        return ok;\n      }\n      if (this.isHost) {\n        for (const connection of this._connections.values()) {\n          if (connection.kind === 'broadcast') this._broadcast(data, connection.uid);\n          else if (connection.conn.open) connection.conn.send(data);\n        }\n      } else if (this.stats.transport === 'broadcast') this._broadcast(data, this._hostUid);\n      else if (this._guestConn?.open) this._guestConn.send(data);\n      else return false;\n      this.stats.sent++;\n      return true;\n    } catch (e) {\n      this.stats.dropped++;\n      return false;\n    }\n  }\n\n  _tick() {\n    if (!this.active || !this.canPlay) return;\n    if (this.isHost) {\n      if (this._snapshot) this._send({v: NET_VERSION, type: 'snapshot', seq: this._seq++, state: this._snapshot});\n    } else this._send({v: NET_VERSION, type: 'input', seq: this._seq++, input: this._input}, this.hostId);\n    if (this.mode !== 'hub' && this.started && now() - this._lastReceive > 15000) {\n      if (this.isHost && this._connections.size) this._removeGuest('timed out');\n      else if (!this.isHost) {\n        this.started = false;\n        this._status('Wing link timed out. Rejoin with the flight code.', {error: true});\n        this._emit('disconnect', {id: this.hostId});\n      }\n    }\n  }\n\n  resetRound() {\n    if (this.mode === 'hub') return false;\n    this._reported = false;\n    this.ended = false;\n    return true;\n  }\n\n  finish(won, score = 0, stats = {}) {\n    if (!this.isHost || this._reported || this.ended) return;\n    this._reported = true;\n    const ids = this.players.map(p => p.id);\n    const result = {standings: [ids], won: !!won, scores: Object.fromEntries(ids.map(id => [id, Number(score) || 0])), stats: Object.fromEntries(ids.map(id => [id, stats]))};\n    if (this.mode === 'hub') globalThis.AIHub.finish(result);\n    else this._send({v: NET_VERSION, type: 'result', result});\n    return result;\n  }\n\n  // In a Hub round, the Hub alone owns leave, retry and return-to-title.\n  close(emit = true) {\n    if (this.mode === 'hub' && globalThis.AIHub?.active) return;\n    if (this.active && !this.ended) this._send({v: NET_VERSION, type: 'bye'});\n    this._generation++;\n    clearTimeout(this._peerDelay);\n    clearTimeout(this._joinTimer);\n    clearTimeout(this._startTimer);\n    this._channel?.close();\n    this._channel = null;\n    this._peer?.destroy();\n    this._peer = null;\n    this._guestConn = null;\n    this._connections.clear();\n    this._guestUid = null;\n    this._hostUid = null;\n    this._lastInputSeq.clear();\n    this._lastSnapshotSeq = -1;\n    this._seq = 0;\n    this._snapshot = null;\n    this._reported = false;\n    this._lastReceive = now();\n    this.mode = 'solo';\n    this.me = this.hostId = 0;\n    this.isHost = true;\n    this.server = false;\n    this.active = false;\n    this.started = false;\n    this.ended = false;\n    this.players = [{id: 0, name: 'Rogue One', color: '#ffb04a'}];\n    this.room = '';\n    this.stats.transport = 'none';\n    if (emit) {this._status('Solo flight'); this._emit('players', this.players);}\n  }\n\n  destroy() {\n    this.close(false);\n    clearInterval(this._timer);\n    for (const off of this._hubOff) off();\n    this.handlers.clear();\n  }\n}\n229:  getSnapshot() { return { ...this.stats, contextState: this.ctx?.state || 'locked' }; }\n234:export async function renderAudioTest(ctx) {\n242:  let peak = 0, sum = 0, finite = true;\n243:  for (const x of values) { if (!Number.isFinite(x)) finite = false; peak = Math.max(peak, Math.abs(x)); sum += x * x; }\n244:  return { peak, rms: Math.sqrt(sum / values.length), finite, seconds: rendered.duration, effects: names.length, voices: 1 };\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > test-game.py <<'EOF'\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport pathlib\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom playwright.sync_api import sync_playwright\n\nHERE = pathlib.Path(__file__).resolve().parent\nPROJECT = json.loads((HERE / 'project.json').read_text())\nFAILURES = []\nCOUNT = 0\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\ndef check(label, condition):\n    global COUNT\n    COUNT += 1\n    if not condition:\n        FAILURES.append(label)\n\ndef run():\n    server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), functools.partial(QuietHandler, directory=str(HERE.parent)))\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    base = f'http://127.0.0.1:{server.server_port}/'\n    url = base + PROJECT['stem'] + '.html'\n    try:\n        with sync_playwright() as pw:\n            browser = pw.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader', '--no-sandbox'])\n            page = browser.new_page(viewport={'width': 1600, 'height': 1000}, device_scale_factor=1)\n            errors = []\n            page.on('pageerror', lambda e: errors.append(str(e)))\n            page.goto(url, wait_until='load')\n            try:\n                page.wait_for_function('\"'!!window.__game'\"', timeout=90000)\n            except Exception:\n                check('Game initializes: ' + page.locator('#bootError').inner_text() + ' / ' + str(errors), False)\n                browser.close()\n                return\n            page.evaluate('__game.hold(true)')\n            state=page.evaluate('__game.getState()')\n            check('Native WebGPU renderer starts', state['renderer']=='WebGPU')\n            check('Rapier 0.19.3 active', state['physics']=='Rapier 0.19.3' and state['bodyCount']>0)\n            check('Music defaults to ten percent', state['settings']['music']==.1)\n            check('Title shown', page.locator('#titleScreen').is_visible())\n            page.get_by_role('button', name='Launch sortie').click()\n            check('Launch enters game', page.evaluate('__game.getState().mode')=='playing')\n            page.evaluate('__game.input({mx:1,mz:0,ax:0,az:-1,fire:false,boost:false});__game.step(1)')\n            moved=page.evaluate('__game.getState().players[0].x')\n            check('Physics flight movement', moved>5)\n            page.evaluate('__game.input({mx:1,mz:0,ax:0,az:-1,fire:false,boost:true});__game.step(1)')\n            boosted=page.evaluate('__game.getState().players[0].x')\n            check('Boost increases movement', boosted-moved>48)\n            page.evaluate('__game.input(null)')\n            page.keyboard.press('Escape')\n            check('Pause stops solo flight', page.evaluate('__game.getState().mode')=='paused')\n            page.get_by_role('button',name='Developer flight deck').click()\n            slider=page.locator('input[data-key=\\\"damage\\\"]')\n            slider.fill('30')\n            check('Live balance slider works', page.evaluate('__game.getState().tuning.damage')==30)\n            page.get_by_role('button',name='Reset balance to defaults').click()\n            check('Reset balance restores defaults', page.evaluate('__game.getState().tuning.damage')==18)\n            page.keyboard.press('Escape')\n            page.get_by_role('button',name='Settings',exact=True).click()\n            page.locator('#glyphSelect').select_option('xbox')\n            check('Controller glyph setting persists', page.evaluate('__game.getState().settings.glyphs')=='xbox')\n            page.locator('#glyphSelect').select_option('ps')\n            page.keyboard.press('Escape')\n            page.get_by_role('button',name='Resume sortie').click()\n            page.evaluate('__game.dev(\\\"god\\\")')\n            page.keyboard.press('Escape')\n            page.get_by_role('button',name='Resume sortie').click()\n            # A deterministic pilot uses only flight, blasters, cable, and rescue mechanics.\n            result=page.evaluate('''() => {\n                __game.teleport(-95,15);__game.action();__game.step(.05,{mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:1,rollSeq:0});\n                const carried=__game.getState().players[0].carrying\"'!==null;\n                __game.teleport(0,85);__game.step(.1,{mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:1,rollSeq:0});\n                const rescued=__game.getState().rescued;\n                let steps=0;\n                while(__game.getState().phase===0 && steps++<100){\n                    const s=__game.getState(), e=s.enemies.find(e=>!e.dead);\n                    __game.teleport(e.x,e.z+38);\n                    __game.step(.5,{mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:1,rollSeq:0});\n                }\n                return {carried,rescued,steps,state:__game.getState()};\n            }'\"''')\n            check('Survivor collection', result['carried'])\n            check('Survivor delivered and scored', result['rescued']==1)\n            check('Chapter one completed with blasters', result['state']['phase']==1)\n            result=page.evaluate('''() => {\n                let action=1;\n                for(let i=0;i<2;i++){\n                    const e=__game.getState().enemies.find(e=>e.type==='walker'&&\"'!e.dead);\n                    if(!e)break;\n                    __game.teleport(e.x+30,e.z);\n                    action++;\n                    __game.step(.05,{mx:0,mz:0,ax:0,az:-1,fire:false,boost:false,actionSeq:action,rollSeq:0});\n                    __game.step(8.5,{mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:action,rollSeq:0});\n                }\n                return __game.getState();\n            }'\"''')\n            check('Tow cable destroys both armored walkers', len([e for e in result['enemies'] if e['type']=='walker' and e['dead']])==2)\n            check('Evacuation chapter begins', result['phase']==2 and len(result['transports'])==2)\n            result=page.evaluate('''() => {\n                let i=0;\n                while(\"'!__game.getState().enemies.find(e=>e.type==='\"'ace')?.dead && i++<180){\n                    const s=__game.getState(),e=s.enemies.find(e=>e.type==='ace');\n                    if(\"'!e)break;\n                    __game.teleport(e.x,e.z+30);\n                    __game.step(.25,{mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:3,rollSeq:0});\n                }\n                let j=0;\n                while(__game.getState().mode==='\"'playing' && j++<90)__game.step(1,{mx:0,mz:0,ax:0,az:-1,fire:true,boost:false,actionSeq:3,rollSeq:0});\n                return __game.getState();\n            }''')\n            check('Interceptor defeated by blasters', any(e['type']=='ace' and e['dead'] for e in result['enemies']))\n            check('Both transports escape', result['evacuated']==2)\n            check('Entire campaign reaches victory', result['mode']=='won')\n            check('Score includes objectives', result['score']>=8500)\n            audio=page.evaluate('__game.audioTest()')\n            check('Procedural audio is finite and audible', bool(audio.get('finite')) and audio.get('rms',0)>.001)\n            page.get_by_role('button',name='Return to title').click()\n            page.evaluate('__game.idle(11)')\n            page.wait_for_function('__game.getState().mode===\\\"attract\\\"')\n            check('Attract begins after ten seconds', True)\n            page.keyboard.press('KeyW')\n            check('Any input exits attract to title', page.evaluate('__game.getState().mode')=='title')\n            page.get_by_role('button',name='About & credits').click()\n            about=page.locator('#panel').inner_text()\n            check('Credits include all feedback and source fields', all(s in about for s in ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback','added on import']))\n            check('No runtime JavaScript errors', not errors)\n            page.close()\n            # Standard mapped virtual DualSense.\n            pad_page=browser.new_page(viewport={'width':1280,'height':800})\n            pad_page.add_init_script('''window.pad={connected:true,index:0,id:'Virtual DualSense',mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};navigator.getGamepads=()=>[window.pad];''')\n            pad_page.goto(url)\n            pad_page.wait_for_function('\"'!!window.__game'\"',timeout=90000)\n            pad_page.evaluate('window.pad.buttons[0]={pressed:true,value:1}')\n            pad_page.wait_for_function('__game.getState().mode===\\\"playing\\\"')\n            check('Controller starts sortie from title', True)\n            pad_page.evaluate('window.pad.buttons[0]={pressed:false,value:0};window.pad.axes[0]=1')\n            pad_page.wait_for_timeout(650)\n            check('Controller axis flies ship', pad_page.evaluate('__game.getState().players[0].x')>-10)\n            check('Prompts switch to PlayStation', '✕' in pad_page.locator('#controlStrip').inner_text())\n            pad_page.close()\n            # Visual inspection only uses WebGL fallback: WebGPU headless captures can be blank.\n            visual=browser.new_page(viewport={'width':1600,'height':1000})\n            visual.goto(url+'?webgl=1')\n            visual.wait_for_function('\"'!!window.__game'\"',timeout=90000)\n            visual.evaluate('__game.hold(true)')\n            visual.screenshot(path=str(HERE/'title-screen.png'))\n            visual.get_by_role('button',name='Launch sortie').click()\n            visual.evaluate('__game.hold(true);__game.dev(\\\"phase\\\");__game.dev(\\\"resume\\\")')\n            visual.wait_for_timeout(1000)\n            visual.screenshot(path=str(HERE/'gameplay-screen.png'))\n            check('Fallback renderer works',visual.evaluate('__game.getState().renderer')=='WebGL2')\n            visual.close()\n            browser.close()\n    finally:\n        server.shutdown()\n        server.server_close()\n\nif __name__=='__main__':\n    try:\n        run()\n    except Exception as e:\n        check(f'Unexpected test error: {type(e).__name__}: {e}',False)\n    for failure in FAILURES:\n        print('FAIL: '+failure)\n    print(f'{COUNT-len(FAILURES)}/{COUNT} checks passed; {len(FAILURES)} failures')\n    sys.exit(bool(FAILURES))\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python test-game.py\"","aggregated_output":"29/29 checks passed; 0 failures\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text().replace('p.body.setLinvel({x:0,y:0,z:0},true);closeModal();','p.body?.setLinvel({x:0,y:0,z:0},true);closeModal();')\ns=s.replace(\\\"function handleAction(a){audio.unlock();\\\",\\\"function handleAction(a){if(link.mode==='hub'&&['title','retry','launch','host','join'].includes(a))return;if(link.ended)return;audio.unlock();\\\")\ns=s.replace('if(edge(9))pause();',\\\"if(edge(9)&&\"'!(globalThis.AIHub?.active&&b(8)))pause();\")\ns=s.replace(\"link.on('\"'end',info=>{if(mode==='playing'||mode==='guest')showResult(info?.won||false);});link.on('timeup',()=>showResult(evacuated===2));\\\",\\\"link.on('end',info=>{if(mode==='playing'||mode==='guest')showResult(info?.won||false);keys.clear();pointer.down=false;testInput=null;audio.stop();});link.on('timeup',()=>{if(link.isHost)showResult(evacuated===2);audio.stop();});link.on('result',r=>{if(guest)showResult(r.won);});link.on('disconnect',()=>{if(guest){onlineText=link.status;mode='title';openModal('online');setScreens();}});\\\")\n# Hub session controls its own title and replay.\ns=s.replace(\\\"\"'$('\"'panel').innerHTML=content;\"'$('\"'modal')\\\", \\\"\"'$('\"'panel').innerHTML=content;if(link.mode==='hub')\"'$('\"'panel').querySelectorAll('[data-action=title],[data-action=retry],[data-action=online]').forEach(b=>b.remove());\"'$('\"'modal')\\\")\ns=s.replace(\\\"\"'$('\"'modal').classList.add('show');setScreens();if(inputKind==='gamepad')focusMenu();}\\\\n\\\\nfunction handleAction\\\", \\\"if(link.mode==='hub')\"'$('\"'panel').querySelectorAll('[data-action=title],[data-action=retry]').forEach(b=>b.remove());\"'$('\"'modal').classList.add('show');setScreens();if(inputKind==='gamepad')focusMenu();}\\\\n\\\\nfunction handleAction\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
