{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('test-game.py');s=p.read_text();needle=\\\"            # Visual inspection only uses WebGL fallback: WebGPU headless captures can be blank.\\\"\ninsert='''            # Real two-page standalone co-op, with the normal authoritative host loop.\n            host=browser.new_page(viewport={'width':1280,'height':800})\n            wing=browser.new_page(viewport={'width':1280,'height':800})\n            host.goto(url)\n            wing.goto(url)\n            host.wait_for_function('\"'!!window.__game'\"',timeout=90000)\n            wing.wait_for_function('\"'!!window.__game'\"',timeout=90000)\n            host.evaluate('__game.getLink().host(\\\"TEST48\\\")')\n            wing.evaluate('__game.getLink().join(\\\"TEST48\\\")')\n            host.wait_for_function('__game.getState().players.length===2',timeout=15000)\n            wing.wait_for_function('__game.getState().mode===\\\"guest\\\" && __game.getState().players.length===2',timeout=15000)\n            check('Standalone co-op links two pilots',True)\n            wing.evaluate('__game.input({mx:1,mz:0,ax:0,az:-1,fire:true,boost:false})')\n            wing.wait_for_timeout(1000)\n            hs=host.evaluate('__game.getState()')\n            ws=wing.evaluate('__game.getState()')\n            hp=next(p for p in hs['players'] if p['id']==1)\n            wp=next(p for p in ws['players'] if p['id']==1)\n            check('Guest input moves authoritative player',hp['x']>35)\n            check('Guest receives authoritative position',abs(hp['x']-wp['x'])<16)\n            host.evaluate('__game.getLink().finish(true,1234,{test:true})')\n            wing.wait_for_function('__game.getState().mode===\\\"won\\\"',timeout=5000)\n            check('Guest displays victory without physics-body errors',True)\n            wing.evaluate('__game.dev(\\\"title\\\")')\n            host.wait_for_function('__game.getState().players.length===1',timeout=5000)\n            check('Wingmate departure removes their ship',True)\n            host.close()\n            wing.close()\n            # Touch emulation drives both invisible thumb zones simultaneously.\n            touch_context=browser.new_context(viewport={'width':844,'height':390},has_touch=True,is_mobile=True,device_scale_factor=1)\n            touch=touch_context.new_page()\n            touch.goto(url)\n            touch.wait_for_function('\"'!!window.__game'\"',timeout=90000)\n            touch.get_by_role('button',name='Launch sortie').tap()\n            check('Touch launches on a landscape phone',touch.evaluate('__game.getState().mode')=='playing')\n            session=touch_context.new_cdp_session(touch)\n            session.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'id':1,'x':150,'y':270},{'id':2,'x':650,'y':270}]})\n            session.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'id':1,'x':210,'y':230},{'id':2,'x':650,'y':200}]})\n            touch.wait_for_timeout(750)\n            ts=touch.evaluate('__game.getState()')\n            check('Multitouch flies and aims together',ts['inputKind']=='touch' and ts['players'][0]['x']>0)\n            session.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n            touch.locator('#touchMenu').tap()\n            check('Touch pause menu works',touch.evaluate('__game.getState().modalPage')=='pause')\n            touch.screenshot(path=str(HERE/'touch-menu.png'))\n            touch_context.close()\n            # The deliverable also starts directly from a local file without dependencies.\n            local=browser.new_page()\n            local.goto((HERE.parent/(PROJECT['stem']+'.html')).as_uri())\n            local.wait_for_function('\"'!!window.__game'\"',timeout=90000)\n            check('Single HTML starts over file protocol',local.evaluate('__game.getState().renderer')=='WebGPU')\n            local.close()\n'''\ns=s.replace(needle,insert+needle)\n# Aggregate transport unit and official harness checks into the same one-command suite.\ns=s.replace(\\\"    for failure in FAILURES:\\\\n\\\",'''    try:\n        result=subprocess.run(['node','network-check.mjs'],cwd=HERE,text=True,capture_output=True,timeout=30)\n        import re\n        summary=re.search(r'(\\\\\\\\d+)/(\\\\\\\\d+)',result.stdout)\n        if summary:\n            COUNT+=int(summary.group(2))\n        if result.returncode:\n            FAILURES.extend(line for line in result.stdout.splitlines() if line.startswith('FAIL'))\n            if not result.stdout:\n                check('Network checks: '+result.stderr,False)\n        import importlib.util\n        spec=importlib.util.spec_from_file_location('hub_integration',HERE/'integration-test.py')\n        module=importlib.util.module_from_spec(spec)\n        spec.loader.exec_module(module)\n        n,failures=module.run_checks()\n        COUNT+=n\n        FAILURES.extend(failures)\n    except Exception as exc:\n        check('Integration test error: '+str(exc),False)\n    for failure in FAILURES:\n''')\np.write_text(s)\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python test-game.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
