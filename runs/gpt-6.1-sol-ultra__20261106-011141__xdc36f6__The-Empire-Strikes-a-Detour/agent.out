{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'cat integration-test.py'","aggregated_output":"\"\"\"Run official AI Hub browser checks; print only failures and one count.\"\"\"\nimport argparse\nimport contextlib\nimport functools\nimport http.server\nimport json\nimport pathlib\nimport threading\nfrom urllib.parse import quote\n\nfrom playwright.sync_api import sync_playwright\n\nHERE = pathlib.Path(__file__).resolve().parent\nROOT = HERE.parent\nGAME = HERE.name + \".html\"\n\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self, *_):\n        pass\n\n\ndef run_checks(scenarios=None):\n    scenarios = scenarios or [\"standard\", \"server\", \"host-leave\", \"latency\"]\n    failures, results = [], []\n    handler = functools.partial(QuietHandler, directory=str(ROOT))\n    server = http.server.ThreadingHTTPServer((\"127.0.0.1\", 0), handler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    base = f\"http://127.0.0.1:{server.server_port}\"\n    count = 0\n    try:\n        with sync_playwright() as p:\n            browser = p.chromium.launch(headless=True, args=[\n                \"--enable-unsafe-webgpu\", \"--enable-features=Vulkan\",\n                \"--use-webgpu-adapter=swiftshader\", \"--disable-dev-shm-usage\",\n            ])\n            try:\n                for scenario in scenarios:\n                    context = browser.new_context(ignore_https_errors=True, viewport={\"width\": 1280, \"height\": 800})\n                    page = context.new_page()\n                    errors = []\n                    page.on(\"pageerror\", lambda e: errors.append(str(e)))\n                    qs = \"game=\" + quote(\"../../\" + GAME) + \"&players=2&auto=1&play=1800\"\n                    if scenario == \"latency\":\n                        qs += \"&latency=150&jitter=50&loss=5\"\n                    elif scenario != \"standard\":\n                        qs += \"&scenario=\" + scenario\n                    page.goto(base + \"/\" + HERE.name + \"/hub/harness.html?\" + qs, wait_until=\"domcontentloaded\")\n                    try:\n                        page.wait_for_function(\"document.body.dataset.complete === 'true'\", timeout=120000)\n                        report = page.evaluate(\"window.__hubCheck\")\n                        rows = report.get(\"checks\", [])\n                        count += len(rows)\n                        for check in rows:\n                            if not check[\"pass\"]:\n                                failures.append(f\"{scenario}: {check['name']}: {check.get('detail', '')}\")\n                        states = []\n                        for frame in page.frames[1:]:\n                            with contextlib.suppress(Exception):\n                                states.append(frame.evaluate(\"window.__game?.getState()\"))\n                        results.append({\"scenario\": scenario, \"pass\": report.get(\"pass\"), \"checks\": rows, \"states\": states, \"errors\": errors})\n                    except Exception as exc:\n                        count += 1\n                        failures.append(f\"{scenario}: harness did not finish: {exc}\")\n                        results.append({\"scenario\": scenario, \"pass\": False, \"report\": page.evaluate(\"window.__hubCheck || null\"), \"errors\": errors})\n                    context.close()\n            finally:\n                browser.close()\n    finally:\n        server.shutdown()\n        server.server_close()\n    (HERE / \"integration-results.json\").write_text(json.dumps(results, indent=2))\n    return count, failures\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--scenario\", action=\"append\", dest=\"scenarios\")\n    args = parser.parse_args()\n    count, failures = run_checks(args.scenarios)\n    for failure in failures:\n        print(\"FAIL hub: \" + failure)\n    print(f\"{count - len(failures)}/{count} Hub integration checks passed\")\n    raise SystemExit(bool(failures))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"agent_message","text":"The scripted flight completed all three chapters, including a rescue, both walker takedowns, and the final escort. Testing caught a guest victory-screen crash and a Hub audio shutdown issue; both are fixed. I’m now checking touch input, multiplayer end states, and the final visual layout.\n"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text().replace('let testHold=false,started=false,','let simAccumulator=0,testHold=false,started=false,').replace(\\\"clearGame();freezeEnemies=false;phase=0;\\\",\\\"clearGame();simAccumulator=0;freezeEnemies=false;phase=0;\\\")\ns=s.replace(\\\"if(\"'!guest&&!testHold){let remaining=dt;while(remaining>0){const step=Math.min(1/60,remaining);fixedUpdate(step,controls);remaining-=step;}\",\"if(!guest&&!testHold){simAccumulator+=dt;while(simAccumulator>=1/60){fixedUpdate(1/60,controls);simAccumulator-=1/60;}\")\ns=s.replace('\"'audio.stop();','audio.stop(true);')\ns=s.replace('id,x,z,hp,heat,heading,towId,towProgress,towAngle,carrying,boost','id,x,z,hp,heat,overheat,heading,towId,towProgress,towAngle,carrying,boost,vx,vz,rollCD,invuln')\ns=s.replace(\\\"v:1,tick:Math.floor(physicsTime*60),mode,phase,elapsed,phaseTime,score,baseHP,rescued,kills,evacuated,players:\\\",\\\"v:1,tick:Math.floor(physicsTime*60),mode,phase,elapsed,phaseTime,score,baseHP,rescued,kills,evacuated,radio:{text:\"'$('\"'radioText').textContent,name:\"'$('\"'radioName').textContent,time:radioTime},banner:{title:\"'$('\"'bannerTitle').textContent,small:\"'$('\"'bannerSmall').textContent,time:bannerTime},players:\\\")\ns=s.replace(\\\"lastSnapshot=s.tick;phase=s.phase;\\\",\\\"lastSnapshot=s.tick;if(s.radio){\"'$('\"'radioText').textContent=s.radio.text;\"'$('\"'radioName').textContent=s.radio.name;radioTime=s.radio.time;}if(s.banner){\"'$('\"'bannerTitle').textContent=s.banner.title;\"'$('\"'bannerSmall').textContent=s.banner.small;bannerTime=s.banner.time;}phase=s.phase;\\\")\ns=s.replace(\\\"function showResult(won){if(['won','lost'].includes(mode))return;\\\",\\\"function showResult(won){if(['won','lost'].includes(mode))return;\\\")\n# Better moment-to-moment feedback: target labels and ship recovery/roll state.\ns=s.replace(\\\"function updateHUD(dt){\\\",\\\"function updateHUD(dt){\\\")\ns=s.replace(\\\"drawRadar();\\\\n}\\\",\\\"updateMarkers();drawRadar();\\\\n}\\\")\npos=s.index('function drawRadar()')\ns=s[:pos]+'''function updateMarkers(){\n const layer=\"'$('\"'worldMarkers');if(\"'!layer)return;if(!['\"'playing','guest','attract'].includes(mode)||modalPage){layer.innerHTML='';return;}\n let html='';for(const e of enemies){if(e.dead)continue;const pt=new THREE.Vector3(e.x,e.type==='walker'?30:e.y+7,e.z).project(camera);if(pt.z>1||Math.abs(pt.x)>1.05||Math.abs(pt.y)>1.05)continue;const label=e.type==='walker'?'SIEGE WALKER':e.type==='ace'?'BLACK SQUADRON':'PROBE';html+=\"'`<div class=\"target-tag\" style=\"left:${(pt.x+1)*50}%;top:${(1-pt.y)*50}%\"><span>${label}</span><div><i style=\"width:${Math.max(0,e.hp/e.maxHP*100)}%\"></i></div></div>`;}\n for(const t of transports){if(t.escaped)continue;const pt=new THREE.Vector3(t.x,t.y+10,t.z).project(camera);html+=`<div class=\"target-tag friendly\" style=\"left:${(pt.x+1)*50}%;top:${(1-pt.y)*50}%\"><span>TRANSPORT</span><div><i style=\"width:${t.hp/160*100}%\"></i></div></div>`;}\n layer.innerHTML=html;\n}\n'\"'''+s[pos:]\ns=s.replace(\\\"if(e.code==='Escape'){\\\",\\\"if(e.code==='Escape'){\\\")\ns=s.replace(\\\"window.addEventListener('keydown',e=>{if(e.target\\\", \\\"window.addEventListener('keydown',e=>{if(link.mode==='hub'&&link.ended)return;if(e.target\\\")\ns=s.replace(\\\"\"'$('\"'pilotLabel')\\\", \\\"\"'$('\"'pilotLabel')\\\")\ns=s.replace(\\\"const p=getLocalPlayer();\"'$('\"'healthBar')\\\", \\\"const p=getLocalPlayer();\"'$('\"'pilotLabel').textContent=networkMode&&p?.id\"'!==link.hostId?'\"'TWO':'LEADER';\"'$('\"'healthBar')\\\")\ns=s.replace(\\\"'FLY'],['RT','FIRE'],['LT','BOOST']\\\", \\\"'FLY'],['RT','FIRE'],['LT','BOOST']\\\")\ns=s.replace(\\\"[ 'L','FLY'],['R','AIM'],['RT','FIRE'],['LT','BOOST']\\\",\\\"[ 'L','FLY'],['R','AIM'],[xbox?'RT':'R2','FIRE'],[xbox?'LT':'L2','BOOST']\\\")\np.write_text(s)\np=Path('template.html');s=p.read_text().replace('<div id=\\\"cursor\\\"></div>','<div id=\\\"worldMarkers\\\"></div><div id=\\\"cursor\\\"></div>');s=s.replace('</style>','''\n#worldMarkers{position:absolute;inset:0;pointer-events:none}.target-tag{position:absolute;transform:translate(-50%,-100%);text-align:center;min-width:60px;filter:drop-shadow(0 1px 1px #f5f5de)}.target-tag span{font-size:10px;letter-spacing:.12em;font-weight:900;color:#b83d28;white-space:nowrap}.target-tag>div{height:4px;background:#17334125;margin:4px 8px 0;min-width:43px}.target-tag i{display:block;background:#dd5e3e;height:100%}.target-tag.friendly span{color:#276f72}.target-tag.friendly i{background:#36a5a4}.network-badge{font-size:13px;background:#eef3ecb0;padding:3px 6px}\nbody.touch .target-tag span{font-size:8px}body.touch .target-tag>div{height:3px}\n@media(max-height:650px){.title-screen{padding:20px 5vw}.title-screen h1{font-size:clamp(31px,9vh,55px);margin-bottom:12px}.brand-mark{margin-bottom:12px}.brand-mark .eyebrow{font-size:10px}.brand-icon{width:25px;height:25px}.title-sub{font-size:14px;margin-bottom:12px}.title-nav{width:250px;gap:6px}.title-nav button,.title-nav .minor{padding:7px 14px;font-size:12px}.title-footer{font-size:8px;bottom:10px}.sector-stamp{font-size:10px}.sector-stamp b{font-size:23px}.panel{max-height:94vh}.panel h2{font-size:30px}.panel p{font-size:15px}.hud-top{padding:15px}.objective strong{font-size:16px}#radio{bottom:65px;max-width:340px}.radio-text{font-size:14px}.control-strip{bottom:15px}.radar-wrap{bottom:15px}#radar{width:110px;height:90px}.shield-panel{top:105px;left:15px}.score-card strong{font-size:25px}#phaseBanner strong{font-size:30px}}\n</style>''');p.write_text(s)\nPY\nnode build.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
