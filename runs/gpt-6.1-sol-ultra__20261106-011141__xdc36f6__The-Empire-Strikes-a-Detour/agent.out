{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' network.js && cat NETWORK.md\"","aggregated_output":"// AI Hub Session Protocol v1 + standalone, two-seat cooperative transport.\n// The official session.js is embedded unmodified before this module is evaluated.\nconst NET_VERSION = 1;\nconst CHANNEL_PREFIX = 'empire-detour-coop-v1-';\nconst RATE_MS = 100;\nconst MAX_STATE_BYTES = 15500;\nconst now = () => performance.now();\nconst cloneJSON = (value) => JSON.parse(JSON.stringify(value));\nconst roomCode = () => [...crypto.getRandomValues(new Uint8Array(6))].map(n => 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[n % 32]).join('');\nconst cleanRoom = (s) => String(s || '').trim().toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 12);\n\nexport class CoopLink {\n  constructor() {\n    this.mode = 'solo';\n    this.me = 0;\n    this.hostId = 0;\n    this.isHost = true;\n    this.server = false;\n    this.players = [{id: 0, name: 'Rogue One', color: '#ffb04a'}];\n    this.active = false;\n    this.ended = false;\n    this.started = false;\n    this.room = '';\n    this.status = 'Solo flight';\n    this.stats = { sent: 0, received: 0, dropped: 0, transport: 'none' };\n    this.handlers = new Map();\n    this._generation = 0;\n    this._uid = crypto.randomUUID ? crypto.randomUUID() : String(Math.random());\n    this._input = {x: 0, z: 0, fire: false};\n    this._snapshot = null;\n    this._seq = 0;\n    this._lastInputSeq = new Map();\n    this._lastSnapshotSeq = -1;\n    this._lastSend = -Infinity;\n    this._lastReceive = now();\n    this._reported = false;\n    this._connections = new Map();\n    this._hubOff = [];\n    this._timer = setInterval(() => this._tick(), RATE_MS);\n  }\n\n  get canPlay() {\n    if (this.ended) return false;\n    if (this.mode === 'hub') return this.started && globalThis.AIHub.time() >= 0;\n    return this.mode === 'solo' || this.started;\n  }\n\n  on(event, callback) {\n    const set = this.handlers.get(event) || new Set();\n    set.add(callback);\n    this.handlers.set(event, set);\n    return () => set.delete(callback);\n  }\n\n  _emit(event, detail) {\n    for (const fn of this.handlers.get(event) || []) fn(detail);\n  }\n\n  _status(text, extra = {}) {\n    this.status = text;\n    this._emit('status', {text, room: this.room, mode: this.mode, ...extra});\n  }\n\n  async initHub() {\n    const hub = globalThis.AIHub;\n    if (!hub?.active) return null;\n    this.mode = 'hub';\n    this.active = true;\n    this.started = false;\n    this._hubOff.push(hub.on('start', () => {\n      const wait = () => {\n        if (this.ended) return;\n        if (hub.time() < 0) this._startTimer = setTimeout(wait, Math.min(100, Math.max(5, -hub.time())));\n        else {\n          this.started = true;\n          this._status('Squadron linked through AI Hub');\n          this._emit('start', this.info());\n        }\n      };\n      wait();\n    }));\n    this._hubOff.push(hub.on('message', (data, from) => this._receive(data, from, 'hub')));\n    this._hubOff.push(hub.on('leave', ({id, reason}) => {\n      this.players = hub.players.map(p => ({...p}));\n      this._emit('players', this.players);\n      this._emit('leave', {id, reason});\n    }));\n    this._hubOff.push(hub.on('time-up', (data) => this._emit('timeup', data)));\n    this._hubOff.push(hub.on('end', (data) => {\n      this.ended = true;\n      this.started = false;\n      clearTimeout(this._startTimer);\n      this._status('AI Hub round ended');\n      this._emit('end', data);\n    }));\n    const info = await hub.connect({mode: 'shared-world', seats: [1, 2]});\n    if (!info) {\n      this.active = false;\n      this.mode = 'solo';\n      return null;\n    }\n    this.me = info.me;\n    this.hostId = info.host;\n    this.isHost = info.isHost;\n    this.server = info.server === true;\n    this.players = info.players.map(p => ({...p}));\n    this.stats.transport = 'hub';\n    this._emit('players', this.players);\n    this._status('AI Hub ready for launch');\n    return info;\n  }\n\n  ready() {\n    if (this.mode === 'hub') globalThis.AIHub.ready();\n  }\n\n  info() {\n    return {mode: this.mode, me: this.me, host: this.hostId, isHost: this.isHost,\n      server: this.server, players: this.players.map(p => ({...p})), room: this.room};\n  }\n\n  async host(requestedRoom = '') {\n    if (globalThis.AIHub?.active) return this.room;\n    this.close(false);\n    const generation = this._generation;\n    this.mode = 'host';\n    this.active = true;\n    this.isHost = true;\n    this.me = this.hostId = 0;\n    this.room = cleanRoom(requestedRoom) || roomCode();\n    this.started = true;\n    this._openChannel();\n    this._status(`Flight open · code ${this.room}`);\n    this._emit('players', this.players);\n    this._emit('start', this.info());\n    this._openPeer(true, generation).catch(e => {\n      if (generation === this._generation && !this._connections.size) {\n        this._status(`Local flight open · ${this.room}. Internet relay unavailable: ${e.message}`, {warning: true});\n      }\n    });\n    return this.room;\n  }\n\n  async join(requestedRoom) {\n    if (globalThis.AIHub?.active) return false;\n    const room = cleanRoom(requestedRoom);\n    if (!room) {\n      this._status('Enter the six-character flight code', {error: true});\n      return false;\n    }\n    this.close(false);\n    const generation = this._generation;\n    this.mode = 'guest';\n    this.active = true;\n    this.isHost = false;\n    this.me = 1;\n    this.room = room;\n    this.started = false;\n    this._openChannel();\n    this._status(`Finding flight ${room}…`);\n    this._broadcast({v: NET_VERSION, type: 'hello'});\n    // Same-browser communication avoids an external broker altogether. A remote\n    // browser uses the very same protocol over a PeerJS WebRTC data channel.\n    this._peerDelay = setTimeout(() => {\n      if (this.started || generation !== this._generation) return;\n      this._openPeer(false, generation).catch(e => {\n        if (generation === this._generation && !this.started) this._status(`Cannot reach flight ${room}: ${e.message}`, {error: true});\n      });\n    }, 800);\n    this._joinTimer = setTimeout(() => {\n      if (generation === this._generation && !this.started) this._status(`Flight ${room} did not answer. Check the code and try again.`, {error: true});\n    }, 20000);\n    return true;\n  }\n\n  _openChannel() {\n    if (!globalThis.BroadcastChannel) return;\n    try {\n      this._channel = new BroadcastChannel(CHANNEL_PREFIX + this.room);\n      this._channel.onmessage = ({data}) => {\n        if (data?.sender === this._uid || (data?.to && data.to !== this._uid)) return;\n        if (this.isHost) {\n          if (data.type === 'hello') return this._acceptLocal(data.sender);\n          if (data.sender !== this._guestUid) return;\n          this._receive(data, 1, 'broadcast');\n        } else {\n          if (data.type === 'welcome') return this._welcome(data, 'broadcast', data.sender);\n          if (data.type === 'rejected') return this._status(data.reason, {error: true});\n          if (this._hostUid && data.sender === this._hostUid) this._receive(data, 0, 'broadcast');\n        }\n      };\n    } catch (e) {\n      this._channel = null;\n    }\n  }\n\n  _broadcast(data, to) {\n    this._channel?.postMessage({...data, sender: this._uid, to});\n  }\n\n  _acceptLocal(uid) {\n    if (this._guestUid && uid !== this._guestUid) {\n      this._broadcast({v: NET_VERSION, type: 'rejected', reason: 'This flight already has two pilots.'}, uid);\n      return;\n    }\n    this._guestUid = uid;\n    this.stats.transport = 'broadcast';\n    this._connections.set(1, {kind: 'broadcast', uid});\n    this._addGuest();\n    this._broadcast({v: NET_VERSION, type: 'welcome', id: 1, players: this.players}, uid);\n  }\n\n  _addGuest() {\n    if (!this.players.some(p => p.id === 1)) {\n      this.players.push({id: 1, name: 'Rogue Two', color: '#5ee7f1'});\n      this._emit('players', this.players);\n    }\n    this._lastReceive = now();\n    this._status(`Two pilots linked · ${this.room}`);\n  }\n\n  _welcome(data, kind, hostUid = '') {\n    if (this.isHost || this.started || data.v !== NET_VERSION) return;\n    clearTimeout(this._peerDelay);\n    clearTimeout(this._joinTimer);\n    this.me = data.id;\n    this.players = data.players.map(p => ({...p}));\n    this._hostUid = hostUid;\n    this.started = true;\n    this.stats.transport = kind;\n    this._lastReceive = now();\n    this._emit('players', this.players);\n    this._status(`Wingmate linked · ${this.room}`);\n    this._emit('start', this.info());\n  }\n\n  async _openPeer(hosting, generation) {\n    const {default: Peer} = await import('https://cdn.jsdelivr.net/npm/peerjs@1.5.5/+esm');\n    if (generation !== this._generation || globalThis.AIHub?.active) return;\n    const id = hosting ? 'empire-detour-v1-' + this.room.toLowerCase() : undefined;\n# Cooperative transport\n\n`network.js` implements one authoritative host and one guest. Seat IDs are stable: standalone host is 0, guest is 1; AI Hub IDs are assigned by the session. A Hub server copy can be the authority without occupying any player seat.\n\nThe official AI Hub client in `hub/session.js` is unmodified, version 1.4.0. The final HTML must paste it as its first script, immediately after the charset tag. Its metadata declares shared-world mode, seats 1–2, round length, goal and controls. The game calls `initHub()`, builds the world, calls `ready()` without a gesture and waits for `start`. That event is delayed until `AIHub.time() >= 0`. Sound and input stop at `end`. `timeup` requires the host to call `finish` with the current score. No standalone network implementation is opened during a Hub session.\n\nStandalone hosts open a six-character flight code. Two same-origin pages use BroadcastChannel; remote browsers lazily load PeerJS 1.5.5 from jsDelivr and use its public signaling service to negotiate WebRTC. No chat, microphone or player-entered names are transmitted. The guest sends controls and the host sends state at 10 Hz. A lost link can be rejoined with the same flight code. Internet traversal depends on the public signaling service and browser/network WebRTC support; it is not guaranteed on restrictive networks.\n\n## Public interface\n\n- `on(event, fn)` subscribes and returns an unsubscribe function.\n- Events: `status` ({text,room,mode,error?,warning?}), `players` (roster), `start` (info), `input` ({id,input}), `snapshot` (host state), `leave` ({id,reason}), `disconnect`, `result` (team result), `timeup`, `end`.\n- `await initHub()` returns Hub info or null; `ready()` announces loading complete.\n- `await host(code?)` starts the host and returns its room; `await join(code)` finds its host.\n- `sendInput(input)` and `sendSnapshot(state)` update cached replication payloads; send them every frame.\n- `finish(won, score, stats)` reports once; `resetRound()` permits another standalone round.\n- `close()` returns to solo; it does nothing in an active Hub round, where the Hub owns leaving.\n- Properties: `mode`, `me`, `hostId`, `isHost`, `server`, `players`, `active`, `ended`, `started`, `canPlay`, `room`, `status`, `stats`.\n- A snapshot must serialize to less than 15.5 KB. Out-of-order input/state packets are rejected by sequence number. The Hub uses unreliable packets so obsolete state does not block newer state.\n\n## Checks\n\n`node network-check.mjs` exercises two standalone links through the real BroadcastChannel API and an injected Hub transport, including no-seat server hosting, start gates, bidirectional traffic, results, departures and end shutdown. It prints failures plus one result line. The root test command can import `checkNetwork()` instead to aggregate its 16 checks.\n\nThe complete game's integration can be checked with the official harness, served over the same loopback origin:\n\n`hub/harness.html?game=../../GAME.html&players=2&auto=1`\n\nRun the same URL with `&latency=150&jitter=50&loss=5`, `&scenario=host-leave`, and `&scenario=server`. The game path above is relative to `hub/` when the finished HTML is in the workspace root. Wait for `document.body.dataset.complete === 'true'`, then inspect `window.__hubCheck.pass` and failed entries of `window.__hubCheck.checks`.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat hub/README.md | head -100; rg -n 'meta|players|mode|howto|webgpu' hub/session.js | head -50\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat hub/README.md | head -100; rg -n 'meta|players|mode|howto|webgpu' hub/session.js | head -50\"","aggregated_output":"# AI Hub Session Protocol v1\n\nAn **AI Hub session** is up to four players, each on their own device,\nplaying rounds of games one after another. The hub runs everything around a\nround: the invite, the lobby, the seats and names, the network, the clock, the\nscoreboard and the results. This page defines how a game takes part in a\nround, and how the copies of a game send data to each other.\n\n**https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md**\n\nThe hub tests every game when it joins the library, with the same test\ndescribed in *Test it*, and keeps a game that fails it out of sessions.\n\n- Client: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js\n- Harness: https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/harness.html\n\nTo ask an agent for it, add this to the game's prompt:\n\n> This game must support AI Hub sessions. Follow\n> https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md\n> (AI Hub Session Protocol v1) and pass the harness's automatic check.\n\n---\n\n## Modes\n\nA game declares one mode.\n\n| Mode | What each copy runs | What the copies send each other |\n|---|---|---|\n| `parallel` | its own copy of the round | nothing |\n| `ghost` | its own copy of the round | each copy's own player: where it is and what it is doing |\n| `shared-world` | one world for all players, run by the host's copy | what each player does, to the host; the world, from the host |\n\n- **Parallel**: every player plays their own copy of the round, from the same\n  start. Each copy reports its score to the hub.\n- **Ghost**: as parallel, and each copy also shows the other players'\n  characters where they are, when they are in the same area of the game.\n  Those characters do not affect anything in the copy that shows them.\n- **Shared world**: all players play in one world. The host's copy runs that\n  world; the other copies send it what their own player does, and show the\n  world the host sends them.\n\nGames tagged with the older modes keep working: `race` is played as ghost,\n`co-op` and `versus` as shared world.\n\n---\n\n## A round\n\n1. The hub loads the game on every player's device, and the players get 10\n   to 30 seconds with the game's card, longer if one asks for more time: what\n   the game is, how to win, the controls. The card is the hub's, from the\n   game's tags, or the game's own (*The card*).\n2. The game connects and calls `ready()`.\n3. The round starts on the hub's clock, on every device at once.\n4. The game reports how it goes.\n5. The round ends when every player has a result, when the host of a shared\n   world finishes it, or when the hub calls time. The hub shows the results\n   over the game, then removes it.\n\n### Tags\n\nIn the game's `<head>`:\n\n```html\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"MIN-MAX\">\n<meta name=\"hub:session-mode\" content=\"MODE\">\n<meta name=\"hub:session-goal\" content=\"GOAL\">\n<meta name=\"hub:session-howto\" content=\"CONTROLS\">\n```\n\n- `hub:session-players`: the smallest and largest number of players the game\n  takes in a session. The hub deals the game only when the number of players\n  is in that range.\n- `hub:session-mode`: `parallel`, `ghost` or `shared-world`.\n- `hub:session-goal` and `hub:session-howto`: how to win and the game's\n  controls, shown on the hub's card.\n\nOptional:\n\n- `hub:session-minutes`: how many minutes a round of the game takes. The hub\n  shows it and uses it to decide when to call time.\n- `hub:webgpu` with `required`: the game cannot run without WebGPU. The hub\n  then deals it only when every player's browser has WebGPU.\n\n### The client\n\n[session.js](https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/session.js)\nis pasted into the game unmodified, as the first script in `<head>`, right\nafter `<meta charset>`. In a session it:\n\n- seeds `Math.random`, in parallel and ghost, before any of the game's own\n  scripts run, so it gives the same numbers on every copy;\n- gives the game an empty `localStorage` and `sessionStorage` of its own, so\n  nothing stored on the device carries into the round, and nothing the round\n  stores reaches the device's own storage;\n- hands `requestFullscreen()` and `exitFullscreen()` to the hub, which takes\n  its whole page fullscreen; `document.fullscreenElement` and\n31:    players: [],\n32:    mode: null,\n240:      hub.players = (m.players || []).slice();\n265:      hub.players = hub.players.filter(function (p) {\n286:    out.players = hub.players.slice();\n313:      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n","exit_code":0,"status":"completed"}}
