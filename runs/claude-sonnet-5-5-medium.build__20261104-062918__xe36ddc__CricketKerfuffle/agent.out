bz: screen y = bx * x + by * y + bz * z (the second row; bz < 0 lifts things up the screen) */\n564-    this.bx = scale * sp * sw; this.by = scale * sp * cw; this.bz = -scale * cp * zBoost;\n565-    /** dx, dy, dz: the direction toward the camera, for true depth (view.depth); bigger is nearer */\n566-    this.dx = sw * cp; this.dy = cw * cp; this.dz = sp;   // true camera depth (bigger = nearer)\n567-    /** fx, fy: the ground direction that points at the camera (the front of a wall faces it) */\n568-    this.fx = sw; this.fy = cw;                           // ground direction that points at the camera\n569-    /** isTop: looking straight down (pitch 89 or more); isSide: a side view (pitch 1 or less: x right, z up, y is\n570-     *  depth) */\n571-    this.isTop = pitch >= 89; this.isSide = pitch <= 1;\n572-    const det = this.ax * this.by - this.ay * this.bx;\n573-    /** inv: the inverse of the ground projection (screen -> ground at z 0), null in side views */","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01UKMsvLE12vPijYtqwGHjnK","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
