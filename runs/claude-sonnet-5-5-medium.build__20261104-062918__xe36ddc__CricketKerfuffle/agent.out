bndRX = () => RX * T('boundaryScale');\nconst bndRY = () => RY * T('boundaryScale');\nconst rho = (x, y) => hyp((x - CX) / bndRX(), (y - MY) / bndRY());   // < 1 inside the boundary\nconst ord = n => n + (['th', 'st', 'nd', 'rd'][(n % 100 > 10 && n % 100 < 14) ? 0 : n % 10 < 4 ? n % 10 : 0]);\nconst store = {\n  get(k, d) { try { return E.store.get('kerfuffle:' + k, d); } catch (e) { return d; } },\n  set(k, v) { try { E.store.set('kerfuffle:' + k, v); } catch (e) { /* storage blocked */ } },\n};\n"}}}
