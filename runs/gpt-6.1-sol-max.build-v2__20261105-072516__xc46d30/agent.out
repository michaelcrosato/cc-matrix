eck } from './ui/audio-check';\\\", \\\"import { audioCheck } from './ui/audio-check';\\\\nimport {aimInput} from './ui/aim';\\\")\na=s.index('function cameraInput(): CameraInput | undefined {');b=s.index('\\\\nconst gameAPI',a)\ns=s[:a]+\\\"const cameraInput=():CameraInput|undefined=>aimInput(ctx,director.view);\\\\n\\\"+s[b:]\ns=s.replace(\\\"  const feverAmount = s?.fever ? Number(store.get('feverIntensity', 0.7)) : 0.0001;\\\", \\\"  const feverAmount = s?.fever ? Math.round(Math.min(1,(f.world.tick-s.fever)/120)*Number(store.get('feverIntensity',0.7))*20)/20 : 0.0001;\\\")\np.write_text(s)\np=Path('labs/game/ui/settings.ts');s=p.read_text().replace(\\\"store.set('glyphs', v);\\\", \\\"store.set('glyphs', v);refreshGlyphs(ctx);\\\");p.write_text(s)\nPY\nnpm run format > out/format.log 2>&1\nNODE_OPTIONS=--max-old-space-size=1800 npm run check > out/check.log 2>&1\"","aggregated_output":"","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_189","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"screen: info ? 'play' : 'title',\\\", \\\"screen: info||['story','contract'].includes(new URLSearchParams(location.search).get('game.mode')??'')||new URLSearchParams(location.search).has('replay') ? 'play' : 'title',\\\").replace(\\\"seed: info?.seed ?? 1947,\\\", \\\"seed: info?.seed ?? Number(new URLSearchParams(location.search).get('seed')??1947),\\\")\np.write_text(s)\np=Path('labs/game/boot.ts');s=p.read_text().replace(\\\"import { world } from './scenes/world';\\\", \\\"import { world } from './scenes/world';\\\\nimport openingReplay from './replays/bot.replay.json?raw';\\\")\ns=s.replace(\\\"search.set('cam3', info ? 'first' : 'fixed,548,18,730,156,-7');\\\", \\\"search.set('cam3', ctx.screen==='play' ? 'first' : 'fixed,548,18,730,156,-7');\\\")\ns=s.replace(\\\"      scenes: [world.id],\\\", \\\"      scenes: [world.id],\\\\n      replays:{bot:async()=>openingReplay},\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace('  addRagdolls,','  addRagdolls,\\\\n  handOff,removeActor,')\ninsert=\\\"\\\"\\\"  if(c.flags.endChoice&&\"'!c.flags.auctionAftermath){\n    const a=[...w.query('\"'usable','actor','health')].find(e=>e.usable.data.key==='Auctioneer');\n    if(a&&c.flags.endChoice===1){a.health.hp=0;handOff(w,a.id,{dead:true,push:[0,0,-1]});w.emit('gunshot',{id:players(w)[0]?.id??-1,weapon:'weapon:pistol-new-0',from:[a.actor.x+2,a.actor.y+1.5,a.actor.z],to:[a.actor.x,a.actor.y+1.4,a.actor.z],normal:null,body:a.actor.body,target:a.id,hit:true});}\n    if(a&&c.flags.endChoice===2)removeActor(w,a.id);c.flags.auctionAftermath=1;\n  }\n\\\"\\\"\\\"\ns=s.replace(\\\"  const b = c.buddies.find\\\",insert+\\\"  const b = c.buddies.find\\\")\np.write_text(s)\np=Path('labs/game/scenes/save.ts');s=p.read_text().replace(\\\"  delete c.flags.gameover;\\\", \\\"  delete c.flags.gameover;c.flags.auctionAftermath=0;\\\")\np.write_text(s)\nPY\ncat >> ../PROGRESS.md <<'EOF'\n\n## Campaign and polish checkpoint\n- A full later-contract run completed to the Serve ending at step 8602. It used actual crate carry/drop, fire weapons/spread, tank explosions, boat physics, a gunfight, buddy consequence and tape playback.\n- Bot fixes: explicitly choose a primary weapon for the salt-pan fight; steer the boat west instead of teleporting a still-seated player; approach NPCs within real use range; route through town streets. Full physical prologue/Receipts probe is running with these fixes.\n- Added actual hand-held syrette, pill bottle, surgery tool/lighter and wrench props; real-time medical/body cameras; a low downed camera; rain particles; native fever look; pad-only aim assistance; contextual held-use pad mapping for repairs/revives; a locator that clicks faster with proximity; persistent burnt scenery on load; irreversible broken guns.\n- Added browser acceptance driver (\"'`tests/game/page.mjs`), audio DSP/offline check, responsive screenshots, phone notice and WebKit checks. Driver not yet run.\n- `npm run check` most recently passed types, formatting, asset rules and pinned-engine check; one unused glyph-refresh import remained and is now wired correctly. Check rerun pending.\n- Exit interview writer and JSON exist; update feedback counts/results once final tests pass, then rebuild so About stays identical.\nEOF\nnpm run format > out/format.log 2>&1\nNODE_OPTIONS=--max-old-space-size=1800 npm run check > out/check.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
