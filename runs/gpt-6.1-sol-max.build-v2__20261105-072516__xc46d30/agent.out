                ? -0.86\n                : Math.max(-1.2, Math.min(1.2, s.pitch + (input.look?.[1] ?? 0) + (input.turn?.[1] ?? 0) * 2 * dt));\n            return { x: follow[0], y: follow[1], z: follow[2], yaw, pitch };\n          },\n          pose: (s) =>\n            makePose({\n              position: [\n                s.x + Math.sin(s.yaw) * 0.18,\n                s.y + (name === 'fieldDown' ? 0.45 : 1.52),\n                s.z + Math.cos(s.yaw) * 0.18,\n              ],\n              yaw: s.yaw,\n              pitch: s.pitch,\n              fov: 76,\n              near: 0.04,\n              far: 2400,\n            }),\n          spec: () => ({ type: 'first' as const }),\n          code: () => `cam3=${name}`,\n          describe: () => name,\n        },\n      );\n    },\n  });\nlabs/game/ui/controls.ts:2:import { defineActionMap, getActionMap } from '../../../engine';\nlabs/game/main.ts:302:              ? 'cam3=chase'\nlabs/game/main.ts:376:function viewAction(action: string): void {\nlabs/game/main.ts:392:  onView: viewAction,\n109:export interface ChaseOptions extends Omit<ChaseSpec, 'type'> {\n110-  readonly fov?: number;\n111-  /** The camera before this one: a chase without a yaw keeps its heading. */\n112-  readonly from?: CameraPose;\n113-}\n114-\n115-/** A checked chase state for `options`. Throws `GFX_BAD_CAMERA`. */\n116-export function chaseState(options: ChaseOptions = {}): ChaseState {\n117-  const distance = options.distance ?? CHASE_DEFAULTS.distance;\n118-  const state: ChaseState = {\n119-    yaw: options.yaw ?? options.from?.yaw ?? 0,\n120-    pitch: options.pitch ?? CHASE_DEFAULTS.pitch,\n121-    distance,\n122-    fov: options.fov ?? CHASE_DEFAULTS.fov,\n123-    pivot: null,\n124-    arm: distance,\n125-  };\n","exit_code":0,"status":"completed"}}
