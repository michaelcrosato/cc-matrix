{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,150p' .cache/engine-src/labs/playground/cast/dog.ts\nsed -n '30,120p' .cache/engine-src/labs/playground/bodies/dog.ts\nsed -n '1,90p' engine/gfx/cameras/define.ts\nsed -n '205,250p' engine/gfx/cameras/chase.ts\"","aggregated_output":" * DOG.near; // 2.2: farther, it follows\n * @see labs/playground/cast/dog.test.ts\n */\nimport { ASIDE, createCharacter, defineComponent, physicsOf, placeActor, Quadruped, siteFloorBelow, spawnActor, spawnProp, stepAside, stepCrowdBody, Vector3, type CrowdBody, type QuadrupedState, type World } from '../../../engine/sim-api'; // prettier-ignore\nimport { SITE } from '../levels/site';\nimport { plainWays, replanWays, waysOf, wayTo } from './ways';\n\n/** How the dog goes about (see the file comment): speeds, distances (m) and times (s). */\nexport const DOG = {\n  speed: 6, // its run, m/s\n  trot: 0.5, // the share of its run it trots at\n  near: 2.2,\n  far: 7,\n  sitAfter: 1,\n  stand: 0.3, // m/s: slower, the player stands\n  // where it stands at first, m to the player's left and ahead (else his right, farther off, behind): the first where\n  // it and its ball before its paws lie flat, clear of a kerb or a step (the street's sidewalk, 2 m wide, has no room)\n  beside: [[1.2, 0.6], [-1.2, 0.6], [1.8, 0.5], [-1.8, 0.5], [1.2, -0.6], [-1.2, -0.6]], // prettier-ignore\n  ball: [0.45, 0.3], // m before its middle where its ball lies at first, toward him\n  reach: 0.3,\n  low: 0.3,\n  flies: 2, // m/s: a ball let go faster than this was thrown\n  arrive: 0.45, // how near the ball its body slows to a stop (its mouth over it), and over how far it slows\n  slowing: 1.2,\n  drop: 1.4,\n  stall: 3,\n  gain: 0.3,\n  backOff: 0.8, // s it backs out the freest way, held the first time\n  wait: 4,\n  chase: 12,\n  straight: 3,\n  pull: 12, // m/s: the fastest it pulls the ball to its mouth (a player's carry's)\n  wag: { follow: 0.35, near: 0.7, sit: 1, chase: 0.9, carry: 0.6, wait: 0.2 },\n} as const;\n\n/** What the dog does (see the file comment). */\nexport const DOG_MODES = ['follow', 'sit', 'chase', 'carry', 'wait'] as const;\n\n/** The dog's own state (the component `dog`). */\nconst DOG_FIELDS = {\n  mode: { type: 'string', enum: DOG_MODES, default: 'follow', description: 'What it does now.' },\n  ball: { type: 'integer', default: -1, minimum: -1, description: 'Its ball, an entity; −1: none.' },\n  since: { type: 'number', default: 0, unit: 's', description: 'When it began what it does.' },\n  still: { type: 'number', default: -1, unit: 's', description: 'Since when the player has stood near it (−1: not).' }, // prettier-ignore\n  held: { type: 'boolean', default: false, description: 'Whether the player held its ball the step before.' },\n  sx: { type: 'number', default: 0, unit: 'm', description: 'Where it stood when it last moved on, east.' },\n  sz: { type: 'number', default: 0, unit: 'm', description: 'Where it stood when it last moved on, south.' },\n  moved: { type: 'number', default: 0, unit: 's', description: 'When it last moved on `DOG.gain` m, going.' },\n  stalls: { type: 'integer', default: 0, minimum: 0, description: 'How often it has been held since it moved on.' },\n  aside: { type: 'number', default: -1, unit: 's', description: 'Until when it steps aside (−1: it does not).' },\n  ax: { type: 'number', default: 0, description: 'The way it steps aside, east.' },\n  az: { type: 'number', default: 0, description: 'The way it steps aside, south.' },\n} as const;\ndefineComponent('dog', { description: 'The dog: what it does, and its ball (WP 13.21).', fields: DOG_FIELDS });\n\n/** The dog's capsule: a small body, its run `DOG.speed`, speeding up gently enough for its paws to keep up. */\nconst CHARACTER = { capsule: { radius: 0.2, height: 0.1 }, speed: DOG.speed, acceleration: 20, deceleration: 20, skid: 40 }; // prettier-ignore\n\ntype Mode = (typeof DOG_MODES)[number];\ntype Place = { x: number; y: number; z: number };\ntype DogState = { mode: Mode; ball: number; since: number; still: number; held: boolean; sx: number; sz: number; moved: number; stalls: number; aside: number; ax: number; az: number }; // prettier-ignore\ntype Dog = { id: number; dog: DogState; actor: Place & { yaw: number; vx: number; vz: number; grounded: boolean; body: number; intents: Record<string, unknown> }; crowdBody: CrowdBody }; // prettier-ignore\ntype Player = { id: number; actor: Place & { yaw: number; vx: number; vz: number; player: boolean }; interactor?: { holding: number } }; // prettier-ignore\ntype Ball = Place & { body: number };\n\nconst RIG = new Quadruped();\nconst [mouth, seen, way, spot] = [new Vector3(), new Vector3(), new Vector3(), new Vector3()];\n\n/** The player, if the world has one. */\nconst playerOf = (w: World) => (w.query('actor') as unknown as Player[]).find((e) => e.actor.player);\n/** The dog's ball, if it is still a prop. */\nconst ballOf = (w: World, dog: DogState) => (w.get(dog.ball)?.sceneProp as unknown as Ball | undefined) ?? undefined;\n\n/** Dog `d` begins `mode` now, emitting `what` (the mode by default). */\nfunction begin(w: World, d: Dog, mode: Mode, what: string = mode): void {\n  const me = d.dog;\n  [me.mode, me.since, me.still, me.moved, me.sx, me.sz, me.stalls] = [\n    mode,\n    w.time,\n    -1,\n    w.time,\n    d.actor.x,\n    d.actor.z,\n    0,\n  ];\n  w.emit('dog', { id: d.id, what });\n}\n\n/** Where dog `d`'s mouth is now (its rig as the last step left it), into `mouth`. */\nfunction mouthOf(d: Dog): Vector3 {\n  RIG.state = d.crowdBody.state as unknown as QuadrupedState;\n  RIG.position.set(d.crowdBody.x, d.crowdBody.y, d.crowdBody.z);\n  return mouth.copy(RIG.pose().mouth);\n}\n\n/** The move (a share of its run) that takes dog `d` toward `goal` at `share`, or none when it has to wait. */\nfunction toward(w: World, d: Dog, goal: Place, share: number, p: Player['actor']): [number, number] | undefined {\n  const { actor: a, dog: me } = d;\n  if (Math.hypot(a.x - me.sx, a.z - me.sz) > DOG.gain) [me.sx, me.sz, me.moved, me.stalls] = [a.x, a.z, w.time, 0];\n  else if (w.time - me.moved > DOG.stall && me.stalls > 0) {\n    setDown(w, d); // held fast (a door's leaf swung into it): set down clear of it, then it waits\n    return void begin(w, d, 'wait');\n  } else if (w.time - me.moved > DOG.stall) {\n    replanWays(w); // held by what its way does not know: the ways round the props as they stand, and out\n    const [x, z] = freest(w, a);\n    [me.aside, me.ax, me.az, me.moved, me.stalls] = [w.time + DOG.backOff, x, z, w.time, 1];\n  }\n  if (w.time < me.aside) return [me.ax * share, me.az * share];\n  const off = Math.hypot(goal.x - a.x, goal.z - a.z);\n  if (off < 1e-6) return undefined;\n  way.set((goal.x - a.x) / off, 0, (goal.z - a.z) / off);\n  if (off > DOG.straight) {\n    const { nav, field } = wayTo(w, `dog:${d.id}:${me.mode}`, [goal.x, goal.y, goal.z]);\n    const down = nav.direction(field, a.x, a.y, a.z);\n    if (down) way.set(down.x, 0, down.z).normalize();\n  }\nsed: can't read .cache/engine-src/labs/playground/bodies/dog.ts: No such file or directory\n/**\n * @file A game's own cameras (PLAN.md WP 13.8; doctrine: Common ground: a camera is a function of input and time): the\n * registry kind `camera`. `defineCamera(name, { create })` adds a camera mode without editing the engine: its code is\n * `cam3=<name>[,…]`, which `readCameraCode` and `createCamera` (engine/gfx/cameras/place.ts) hand to `create` with the\n * camera before it, so `__engine.camera.set`, the page's switches, blends and effects (engine/gfx/cameras/rig.ts) and\n * the feel kit's camera metrics all take it. `create` returns a camera: the engine's factories make one, and\n * `followCamera(type, state, steps, { effects, fade })` (engine/gfx/cameras/chase.ts) wraps a game's own pure steps; one\n * that returns anything else is refused when the camera is made (`madeCamera`: `GFX_BAD_GAME_CAMERA`).\n *\n * Invariants: a name is a word that no engine camera or view has (`CAMERA_NAMES`); entries are frozen; cameras are view\n * state, never the sim's.\n *\n * @example\n * import { createRegistry } from '../../core/registry';\n * const registry = createRegistry();\n * defineCamera('low', { description: 'The shooter, lower.', create: (_code, { from }) => createShoulderCamera({ pitch: 0.2, from }) }, registry); // prettier-ignore\n * cameraEntry('low', registry)?.description; // 'The shooter, lower.'\n * @see engine/gfx/cameras/define.test.ts\n */\nimport { codeError, defineCodes } from '../../core/log';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport { defineSchema } from '../../core/schema';\nimport { CAMERA_3D, FOLLOW_CAMERAS, VIEW_NAMES } from './codes';\nimport type { Camera, CameraPose } from './pose';\n\n/** The codes this module raises, with their fixes. */\nexport const GAME_CAMERA_CODES = defineCodes('gfx', {\n  GFX_BAD_GAME_CAMERA: {\n    template: \"the camera {name}'s create returned {value}, not a camera\",\n    fix: \"return a camera from create: one of the engine's factories (createShoulderCamera, createFollowCamera, createViewCamera, …) or followCamera(type, state, steps) over your own pure steps (engine/gfx/cameras/define.ts)\",\n    doc: \"Raised by `createCamera` (engine/gfx/cameras/place.ts) when a game camera's `create` (`defineCamera`) returns something without a camera's `update`, `pose`, `yaw`, `spec`, `code` and `describe`.\",\n  },\n});\n\n/** Every name the engine's cameras and views take: a game's camera takes another. */\nexport const CAMERA_NAMES: readonly string[] = Object.freeze([...VIEW_NAMES, ...CAMERA_3D, ...FOLLOW_CAMERAS]);\n\n/** A game camera's fields. */\nexport const CAMERA_FIELDS = defineSchema({\n  description: { type: 'string', default: '', description: 'What it shows, in words.' },\n  create: {\n    type: 'function',\n    required: true,\n    description: '(code, { from }) => a camera: made from its code (cam3=<name>[,…]) and the camera before it (`from`, its pose).', // prettier-ignore\n  },\n});\n\n/** What `defineCamera` takes: `create` makes the camera from its code and the camera before it. */\nexport interface CameraKindSpec {\n  readonly description?: string;\n  readonly create: (code: string, options: { readonly from?: CameraPose }) => unknown;\n}\n\n/** Declares the kind `camera` on `registry` unless it has it. */\nfunction cameraKind(registry: Registry): void {\n  if (registry.kinds().includes('camera')) return;\n  registry.defineKind('camera', {\n    description: \"A game's own camera mode: its code cam3=<name>[,…] and the function that makes it (engine/gfx/cameras/define.ts).\", // prettier-ignore\n    fields: CAMERA_FIELDS,\n    defineWith: \"defineCamera('<name>', { description, create })\",\n    check: (entry) => {\n      const id = String(entry.id);\n      if (!/^[a-z][a-zA-Z0-9]*$/.test(id)) return [`its name ${id} is not a word (letters and digits, a small letter first)`]; // prettier-ignore\n      return CAMERA_NAMES.includes(id) ? [`${id} is an engine camera's name: choose another`] : [];\n    },\n  });\n}\n\n/** Adds a game's camera mode on `registry` (the shared one by default). Throws `CORE_BAD_SPEC` naming each problem. */\nexport function defineCamera(name: string, spec: CameraKindSpec, registry: Registry = sharedRegistry): Entry {\n  cameraKind(registry);\n  return registry.def('camera', name, spec as unknown as Record<string, unknown>);\n}\n\n/** What a game camera's `create` returned, checked: a camera, else `GFX_BAD_GAME_CAMERA` naming the camera. */\nexport function madeCamera(name: string, made: unknown): Camera {\n  const camera = made as Partial<Record<keyof Camera, unknown>> | null;\n  const methods = ['update', 'pose', 'yaw', 'spec', 'code', 'describe'] as const;\n  if (camera && typeof camera === 'object' && methods.every((key) => typeof camera[key] === 'function')) return made as Camera; // prettier-ignore\n  const value = made === null || typeof made !== 'object' ? String(made) : `an object with ${Object.keys(made).join(', ') || 'nothing'}`; // prettier-ignore\n  throw codeError('GFX_BAD_GAME_CAMERA', { name, value });\n}\n\n/** The game camera named `name` on `registry`, or undefined. */\nexport function cameraEntry(name: string, registry: Registry = sharedRegistry): (Entry & CameraKindSpec) | undefined {\n  if (!registry.kinds().includes('camera') || !registry.has('camera', name)) return undefined;\n  return registry.get('camera', name) as Entry & CameraKindSpec;\n}\n  const [head, ...words] = (keyed ? keyed[2] : text).split(',').map((word) => word.trim());\n  if (head !== name) {\n    const values = { name: JSON.stringify(head), suggestion: didYouMean(head, [name]), names: name };\n    throw codeError('GFX_UNKNOWN_CAMERA', values);\n  }\n  const problems: string[] = [];\n  if (keyed?.[1] === 'cam') problems.push(`${name} is a 3D camera: write cam3=${name}`);\n  if (words.some((word) => word === '')) problems.push('it has an empty part (two commas, or nothing after one)');\n  else if (!counts.includes(words.length)) {\n    const form = `${name}[, ${parts.map(([part]) => part).join(', ')}]`;\n    const allowed = counts.length > 1 ? `${counts.slice(0, -1).join(', ')} or ${counts.at(-1)}` : `${counts[0]}`;\n    problems.push(`cam3=${form} takes ${allowed} numbers, not ${words.length}`);\n  }\n  const values = words.map((word, i) => {\n    const [part, min, max] = parts[i] ?? [`part ${i + 2}`, -Infinity, Infinity];\n    if (!NUMBER.test(word)) problems.push(`part ${i + 2} (${word}) is not a number`);\n    else if (!(Number(word) >= min && Number(word) <= max))\n      problems.push(`${part} is ${word}; it must be from ${min} to ${max}`);\n    return Number(word);\n  });\n  if (problems.length) throw codeError('GFX_BAD_CAMERA_CODE', { code: text, problems: problems.join('; ') });\n  return values;\n}\n\n/** Reads a chase camera's code: `cam3=chase[,<yaw>,<pitch>,<distance>]`. Throws `GFX_BAD_CAMERA_CODE`. */\nexport function parseChaseCode(code: string): ChaseSpec {\n  const parts: CodePart[] = [\n    ['yaw', -1e6, 1e6],\n    ['pitch', CHASE_LIMITS.pitch[0] / DEG, CHASE_LIMITS.pitch[1] / DEG],\n    ['distance', ...CHASE_LIMITS.distance],\n  ];\n  const [yaw, pitch, distance] = readCode(code, 'chase', parts, [0, 3]);\n  return yaw === undefined ? { type: 'chase' } : { type: 'chase', yaw: yaw * DEG, pitch: pitch * DEG, distance };\n}\n\n/** The canonical code of a chase camera's data (numbers rounded: 0.01°, 0.001 m). */\nexport function formatChaseCode(spec: ChaseSpec): string {\n  if (spec.yaw === undefined) return 'cam3=chase';\n  const pitch = spec.pitch ?? CHASE_DEFAULTS.pitch;\n  const distance = spec.distance ?? CHASE_DEFAULTS.distance;\n  return `cam3=chase,${codeDegrees(spec.yaw, true)},${codeDegrees(pitch)},${codeNumber(distance, 3)}`;\n}\n\n/** A chase camera in words. */\nexport function describeChase(spec: ChaseSpec, pose: CameraPose): string {\n  const lens = `Chase camera (perspective, ${codeNumber(pose.fov, 0)}° field of view)`;\n","exit_code":0,"status":"completed"}}
