{"type":"item.started","item":{"id":"item_280","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/bot.ts');s=p.read_text().replace(\\\"export const inspectorOf\\\", \\\"let observer:((phase:string,data:unknown)=>void)|null=null;\\\\nexport function observeBot(fn:((phase:string,data:unknown)=>void)|null):void{observer=fn;}\\\\nexport const inspectorOf\\\")\ns=s.replace(\\\"  let last: [number, number]\\\", \\\"  observer?.('travel',{at,radius});\\\\n  let last: [number, number]\\\")\ns=s.replace(\\\"    const p = mercOf(e);\\\\n    if (Math.hypot\\\", \\\"    const p = mercOf(e);\\\\n    if(n%600===0)observer?.('travel-progress',{at,n,x:p.actor.x,z:p.actor.z,distance:Math.hypot(p.actor.x-at[0],p.actor.z-at[1])});\\\\n    if (Math.hypot\\\")\ns=s.replace(\\\"export function useKey(e: Headless, key: string, jump = true): void {\\\", \\\"export function useKey(e: Headless, key: string, jump = true): void {\\\\n  observer?.('use',{key,jump});\\\")\ns=s.replace(\\\"    const c = roundOf(e);\\\\n    const token\\\", \\\"    const c = roundOf(e);\\\\n    observer?.('story',{contract:c.contract,step:c.step,goal:c.goal});\\\\n    const token\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.test.ts');s=p.read_text().replace('readFileSync','readFileSync,writeFileSync',1).replace('useKey, playBot','useKey, playBot,observeBot')\ns=s.replace(\\\"    for (const seed of [1, 2, 3]) {\\\\n      const e = await make(seed, { 'game.mode': 'story' });\\\", \\\"    observeBot((phase,data)=>writeFileSync('out/test/bot-progress.json',JSON.stringify({phase,data})));\\\\n    for (const seed of [1, 2, 3]) {\\\\n      const e = await make(seed, { 'game.mode': 'story' });\\\")\np.write_text(s)\nPY\npython3 - <<'PY'\nimport os,pathlib,signal\nroot=os.getcwd();targets=[];children={}\nfor d in pathlib.Path('/proc').iterdir():\n if not d.name.isdecimal():continue\n try:\n  ppid=int(next(l for l in (d/'status').read_text().splitlines() if l.startswith('PPid:')).split()[1]);children.setdefault(ppid,[]).append(int(d.name))\n  if os.readlink(d/'cwd')==root and (d/'cmdline').read_bytes().split(b'\\\\0')[:3]==[b'node',b'tests/game/verify.mjs',b'sim']:targets.append(int(d.name))\n except (OSError,ValueError,StopIteration):pass\ndef stop(pid):\n for child in children.get(pid,[]):stop(child)\n try:os.kill(pid,signal.SIGTERM)\n except ProcessLookupError:pass\nfor pid in targets:print('Restarting playthrough with direct progress',pid);stop(pid)\nPY\nVERIFY_FILTER='plays the full campaign' NODE_OPTIONS=--max-old-space-size=1800 node tests/game/verify.mjs sim\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
