{"type":"item.completed","item":{"id":"item_326","type":"command_execution","command":"/bin/bash -lc \"node - <<'JS'\nconst r=JSON.parse(require('fs').readFileSync('out/hub/0.json'));console.log(Object.keys(r));console.log(JSON.stringify(r,null,2).slice(0,20000));\nJS\nrg -n 'ready without|own card|__hubCheck' .cache/hub/harness.html | head -12\nsed -n '1,76p' labs/game/net/session.ts\nsed -n '104,137p' labs/game/boot.ts\"","aggregated_output":"[\n  'done',     'pass',\n  'game',     'players',\n  'scenario', 'checks',\n  'log'\n]\n{\n  \"done\": true,\n  \"pass\": false,\n  \"game\": \"game.html\",\n  \"players\": 2,\n  \"scenario\": \"standard\",\n  \"checks\": [\n    {\n      \"name\": \"head metas\",\n      \"pass\": true,\n      \"detail\": \"hub:session=1 mode=shared-world\"\n    },\n    {\n      \"name\": \"hub:session-players is a range within 1–4\",\n      \"pass\": true,\n      \"detail\": \"hub:session-players=1-4\"\n    },\n    {\n      \"name\": \"hub:session-minutes, when given, is a number\",\n      \"pass\": true,\n      \"detail\": \"hub:session-minutes=6\"\n    },\n    {\n      \"name\": \"every copy says hello\",\n      \"pass\": true,\n      \"detail\": \"\"\n    },\n    {\n      \"name\": \"hello names protocol 1 and the mode\",\n      \"pass\": true,\n      \"detail\": \"{\\\"v\\\":1,\\\"client\\\":\\\"1.4.0\\\",\\\"mode\\\":\\\"shared-world\\\",\\\"seats\\\":[1,4],\\\"card\\\":true}\"\n    },\n    {\n      \"name\": \"hello seats cover this player count\",\n      \"pass\": true,\n      \"detail\": \"[1,4]\"\n    },\n    {\n      \"name\": \"ready without a key press (the card asks the players)\",\n      \"pass\": false,\n      \"detail\": \"p0, p1\"\n    },\n    {\n      \"name\": \"its own card: Enter answers Ready\",\n      \"pass\": false,\n      \"detail\": \"\"\n    },\n    {\n      \"name\": \"the round starts when the card ends\",\n      \"pass\": false,\n      \"detail\": \"p0, p1\"\n    }\n  ],\n  \"log\": [\n    \"   0.25  round 1: 2 players, seed 2892424777, limit 540 s, mode shared-world\",\n    \"   0.77  p1 → hub: hello\",\n    \"   0.79  p0 → hub: hello\",\n    \"   0.82  hub → p1: welcome\",\n    \"   0.89  hub → p0: welcome\",\n    \"  22.94  p0 answers ready on the game's card\",\n    \"  22.95  p1 answers ready on the game's card\",\n    \"  22.99  splash over: the round starts once every game has loaded\",\n    \"  38.02  conformance: FAIL\"\n  ]\n}\n272:/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\n286:/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n412:  window.__hubCheck = report;\n442:    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n443:    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n449:      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n/** @file AI Hub v1 connection, made before the renderer starts. Standalone transports never run in a hub session. */\nexport interface Player {\n  id: number;\n  name: string;\n  color: string;\n}\nexport interface Net {\n  me: number;\n  host: number;\n  isHost: boolean;\n  players: Player[];\n  time(): number;\n  send(data: unknown, options?: { to?: number; reliable?: boolean }): boolean;\n  on(event: string, fn: (data: unknown, from?: number) => void): unknown;\n}\nexport interface Hub extends Net {\n  active: boolean;\n  server: boolean;\n  seed: number;\n  connect(options: object): Promise<Info | null>;\n  ready(): void;\n  answer(key: string): void;\n  finish(data: object): void;\n  fail(message: string): void;\n}\nexport interface Info {\n  me: number;\n  host: number;\n  isHost: boolean;\n  server: boolean;\n  seed: number;\n  players: Player[];\n  limitMs: number;\n}\nexport const hub = (globalThis as unknown as { AIHub?: Hub }).AIHub;\nexport const info = hub?.active ? await hub.connect({ mode: 'shared-world', seats: [1, 4], card: true }) : null;\nexport const COLORS = ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'];\n\nexport function ownCard(): HTMLElement | null {\n  if (!hub || !info) return null;\n  const root = document.createElement('div');\n  root.className = 'session-card';\n  root.dataset.screen = 'card';\n  root.innerHTML =\n    '<p class=\"eyebrow\">COOPERATIVE CONTRACT / 01</p><h1>Bar Cry</h1><h2>Burn the depot.<br>Get out alive together.</h2><div class=\"crew\"></div><p>WASD / left stick moves · Click / R2 fires<br>E / □ uses · F / D-pad right draws a flare</p><button class=\"primary\">Enter / ✕ · Ready</button><button>△ · More time</button><p class=\"card-count\">Waiting for the crew</p>';\n  for (const p of info.players) {\n    const line = document.createElement('p');\n    line.textContent = p.name;\n    line.style.color = p.color;\n    root.querySelector('.crew')!.append(line);\n  }\n  const answer = () => hub.answer('ready');\n  root.querySelectorAll('button')[0].onclick = answer;\n  root.querySelectorAll('button')[1].onclick = () => hub.answer('more');\n  const key = (e: KeyboardEvent) => {\n    if (e.code === 'Enter') answer();\n    if (e.code === 'KeyY') hub.answer('more');\n  };\n  addEventListener('keydown', key);\n  let previous = false;\n  const pad = setInterval(() => {\n    const p = [...navigator.getGamepads()].find(Boolean),\n      down = !!p?.buttons[0]?.pressed;\n    if (down && !previous) answer();\n    if (p?.buttons[3]?.pressed) hub.answer('more');\n    previous = down;\n  }, 100);\n  hub.on('card', (raw) => {\n    const d = raw as { left: number; ready: number[] };\n    root.querySelector('.card-count')!.textContent = `${Math.max(0, Math.ceil(d.left / 1000))} · Crew assembling`;\n  });\n  hub.on('start', () => {\n    root.remove();\n    clearInterval(pad);\n    removeEventListener('keydown', key);\n  });\n      sentReady = true;\n      e.pause();\n      netStop = startLockstep(hub, e, {\n        sample: options.sample,\n        onEnd: () => {\n          audio.mute(true);\n          ended = true;\n        },\n        onMismatch: () => {\n          document.getElementById('msg')!.textContent = 'Connection out of sync.';\n        },\n        finish: (won) => {\n          if (hub!.isHost && !ended) {\n            ended = true;\n            hub!.finish(result(e, info!, won));\n          }\n        },\n      });\n      hub.on('time-up', () => {\n        if (hub!.isHost && !ended) {\n          ended = true;\n          hub!.finish(result(e, info!, false));\n        }\n      });\n      hub.on('end', () => {\n        netStop?.();\n        audio.mute(true);\n      });\n      hub.ready();\n    }, 20);\n    ctx.engine = await createEngine({\n      canvas: document.querySelector('#view')!,\n      scenes: [world.id],\n      replays: { bot: async () => openingReplay },\n","exit_code":0,"status":"completed"}}
