{"type":"item.completed","item":{"id":"item_103","type":"command_execution","command":"/bin/bash -lc \"cat > out/boot.mjs <<'EOF'\nimport {chromium} from '@playwright/test';\nimport {globSync} from 'node:fs';\nimport {resolve} from 'node:path';\nconst executablePath=globSync('/home/micha/.cache/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell')[0];\nconst browser=await chromium.launch({executablePath,args:['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-vulkan=swiftshader','--use-angle=swiftshader']});\nconst page=await browser.newPage({viewport:{width:1920,height:1080}});\npage.on('pageerror',e=>console.log('ERROR',String(e)));\npage.on('console',m=>{if(m.type()==='error')console.log('CONSOLE',m.text().slice(0,600));});\nawait page.goto('file://'+resolve('../Bar-Cry-Far-Cry-2-gpt-6.1-sol-max-20261105-072516.html')+'?game.attract=off');\nawait page.waitForFunction(()=>window.__engine?.ready===true,undefined,{timeout:120000}).catch(e=>console.log('WAIT',String(e).slice(0,200)));\nconsole.log(JSON.stringify(await page.evaluate(()=>({ready:window.__engine?.ready,errors:window.__engine?.errors,screen:window.__game?.screen(),text:document.body.innerText.slice(0,1500),info:window.__engine?.info?.()}))));\nawait page.screenshot({path:'out/title.png'});\nawait browser.close();\nEOF\nnode out/boot.mjs\"","aggregated_output":"WAIT TimeoutError: page.waitForFunction: Timeout 120000ms exceeded.\nERROR EngineError: [SIM_SHARED_DATA] entity 1's seat.data.previous is the same object as entity 1's seat.data.wants.b: give each place its own data: copy it ({ ...values }, [...list]) or hold the other entity by its id and read it through w.get(id); a capture copies each place separately, so a shared object would come back as two\n{\"ready\":false,\"errors\":[],\"screen\":\"attract\",\"text\":\"Uncaught EngineError: [SIM_SHARED_DATA] entity 1's seat.data.previous is the same object as entity 1's seat.data.wants.b: give each place its own data: copy it ({ ...values }, [...list]) or hold the other entity by its id and read it through w.get(id); a capture copies each place separately, so a shared object would come back as two\\nBAR CRY\\n\\nOpening the field office…\\nCheck the wind before you strike a match.\\n\\nA ROAD WITH NO PROMISES\\nBAR CRY · PRESS ANY BUTTON\",\"info\":{\"version\":\"0.0.0\",\"runtime\":\"browser\",\"headless\":false,\"adapter\":{\"vendor\":\"google\",\"architecture\":\"swiftshader\",\"device\":\"\",\"description\":\"\",\"fallback\":true,\"backend\":\"WebGPU\",\"three\":\"182\"},\"features\":[\"feature:air\",\"feature:ao\",\"feature:cascadedShadows\",\"feature:float32Filtering\",\"feature:gi\",\"feature:gpuCrowds\",\"feature:gpuParticles\",\"feature:largeBuffers\",\"feature:shells\",\"feature:ssr\",\"feature:tiledLighting\",\"feature:timestamps\",\"feature:traa\"],\"downgrades\":[],\"deps\":{\"@dimforge/rapier3d-simd-compat\":\"0.21.0\",\"@stdlib/math-base-special-cos\":\"0.3.1\",\"@stdlib/math-base-special-pow\":\"0.3.1\",\"@stdlib/math-base-special-sin\":\"0.3.1\",\"three\":\"0.182.0\"},\"scene\":\"game:world\",\"seed\":1948,\"tick\":54,\"hz\":60}}\n","exit_code":0,"status":"completed"}}
