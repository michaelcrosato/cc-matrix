)\np=Path('labs/game/scenes/save.ts');s=p.read_text().replace(\\\"actionProp: -1,\\\", \\\"actionProp: -1,meleeNext:0,meleeUntil:0,\\\")\ns=s.replace('p.seat.data.fever', 'p.seat\"'!.data.fever'\"')\np.write_text(s)\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"        : s.action\\\\n\\\", \\\"        : s.meleeUntil>f.world.tick?'cam3=first':s.action\\\\n\\\")\np.write_text(s)\np=Path('labs/game/scenes/ai.ts');s=p.read_text().replace(\\\"< 120 * value(w, 'ai.hearing')\\\", \\\"< (c.flags.noiseRadius??120) * value(w, 'ai.hearing')\\\")\np.write_text(s)\np=Path('labs/game/sounds/page.ts');s=p.read_text().replace(\\\"  melee: 'melee',\\\", \\\"  melee: 'melee','melee-hit':'rack',\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
