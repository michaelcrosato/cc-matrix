{"type":"item.completed","item":{"id":"item_157","type":"command_execution","command":"/bin/bash -lc \"command -v viewport-matrix\nsed -n '1,75p' labs/game/main.ts\nsed -n '350,503p' labs/game/main.ts\"","aggregated_output":"/home/micha/.local/bin/viewport-matrix\n/** @file Bar Cry's page: boot, presentation, saved accounts, real-time menus and the network pump. */\nimport { hub, info, ownCard } from './net/session';\nimport { createEngine, createHeadless, createStore, type EngineFrame, type CameraInput } from '../../engine';\nimport { world } from './scenes/world';\nimport { campaign, players, type GW, type Campaign, type Person } from './scenes/state';\nimport { makeSave } from './scenes/save';\nimport { TITLE } from './title';\nimport { audio, soundFrame } from './sounds/page';\nimport { renderScreen } from './ui/screens';\nimport { navigation, refreshGlyphs } from './ui/controls';\nimport { inspector, type Context, type GameInspector } from './ui/context';\nimport { createHud } from './ui/hud';\nimport { makeMap } from './ui/map';\nimport { startLockstep, inspectorDigest, result, type Wire } from './net/lockstep';\nimport { Attract } from './attract';\nimport './art/world';\nimport './art/guns';\nimport './art/bodies';\nimport './art/cameras';\nimport './ui/style.css';\n\nconst search = new URLSearchParams(location.search),\n  store = createStore({ prefix: 'bar-cry:', mode: info ? 'demo' : 'play' });\nlet cameraCode = '',\n  chase = false,\n  saveVersion = -1,\n  seenWorld: object | null = null,\n  dialogueSeen = 0,\n  endingSeen = '',\n  netStop: (() => void) | null = null,\n  ended = false;\nconst root = document.getElementById('front')!;\nconst ctx: Context = {\n  engine: null,\n  frame: null,\n  c: null,\n  p: undefined,\n  screen: info ? 'play' : 'title',\n  parent: 'title',\n  inHub: !!info,\n  device: 'keyboard',\n  glyphs: store.get('glyphs', 'PlayStation'),\n  store,\n  root,\n  me: info?.me ?? 0,\n  seed: info?.seed ?? 1947,\n  net: null,\n  inspector: () => inspector(ctx),\n  open(name) {\n    const e = ctx.inspector(),\n      previous = ctx.screen;\n    if (name === 'map') {\n      if (e) e.step(1, { p: ['map'] });\n      name = 'play';\n    }\n    if (info && ['title', 'dev', 'lobby'].includes(name)) return;\n    if (['title', 'pause', 'ending'].includes(ctx.screen)) ctx.parent = ctx.screen;\n    else if (['dialogue', 'shop', 'sleep'].includes(name)) ctx.parent = 'play';\n    ctx.screen = name;\n    if (name === 'pause' && !ctx.inHub) e?.pause();\n    if (name === 'play' && !ctx.inHub && !director?.active) e?.resume();\n    if (name === 'play' && ['dialogue', 'shop', 'sleep'].includes(previous)) ctx.send({ kind: 'dismiss' });\n    if (name !== 'play') {\n      document.exitPointerLock?.();\n      ctx.engine?.input?.clear();\n    }\n    renderScreen(ctx);\n    refreshGlyphs(ctx);\n  },\n  back() {\n    if (ctx.screen === 'play') {\n      if (ctx.p?.seat?.data.map) {\n        ctx.inspector()?.step(1, { p: ['map'] });\n        return;\n      }\n        Math.sin(Math.atan2(t.actor.x - p.actor.x, t.actor.z - p.actor.z) - yaw),\n        Math.cos(Math.atan2(t.actor.x - p.actor.x, t.actor.z - p.actor.z) - yaw),\n      ),\n    }))\n    .sort((a, b) => Math.abs(a.d) - Math.abs(b.d))[0];\n  if (!nearest || Math.abs(nearest.d) > 0.1) return undefined;\n  return { look: [-nearest.d * 0.035, 0] };\n}\nconst gameAPI = {\n  title: TITLE,\n  audio,\n  screen: () => (ctx.p?.seat?.data.map && ctx.screen === 'play' ? 'map' : ctx.screen),\n  open: (name: string) => ctx.open(name),\n  start: (mode = 'story', merc = 0) => ctx.start(mode, merc),\n  digest: () => (ctx.inspector() ? inspectorDigest(ctx.inspector()!) : ''),\n  context: ctx,\n  attract: director,\n};\n(window as unknown as { __game: typeof gameAPI }).__game = gameAPI;\nif (info && hub) ownCard();\nif (info?.server && hub) {\n  const e = await createHeadless({\n    scene: world,\n    seed: info.seed,\n    settings: { 'game.mode': 'contract', 'game.seats': info.players.length, 'game.me': -1, 'game.detail': 0.08 },\n  });\n  Object.assign(window, { __engine: Object.assign(e, { ready: true }) });\n  const stop = startLockstep(hub, e, {\n    sample: () => ({ m: [0, 0], l: [0, 0], b: [] }),\n    finish: (won) => {\n      if (!ended) {\n        ended = true;\n        hub!.finish(result(e, info!, won));\n      }\n    },\n  });\n  hub.on('time-up', () => {\n    if (!ended) {\n      ended = true;\n      hub!.finish(result(e, info!, false));\n    }\n  });\n  hub.on('end', () => {\n    stop();\n    audio.mute(true);\n  });\n  hub.ready();\n} else if (navigator.gpu) {\n  search.set('touch', 'off');\n  search.set('gfx.warmUp', 'asked');\n  search.set('post.look', 'look:dry-season');\n  search.set('cam.fov', String(store.get('cam.fov', 76)));\n  search.set('game.mode', info ? 'contract' : (search.get('game.mode') ?? 'title'));\n  search.set('game.seats', String(info?.players.length ?? 1));\n  search.set('game.me', String(ctx.me));\n  search.set('seed', String(ctx.seed));\n  search.set('cam3', info ? 'first' : 'fixed,548,18,730,156,-7');\n  if (!search.has('game.detail')) {\n    let fallback = true;\n    try {\n      const adapter = await navigator.gpu.requestAdapter();\n      fallback = adapter?.info?.isFallbackAdapter ?? true;\n    } catch {}\n    search.set('game.detail', info ? '0.08' : fallback ? '0.16' : '1');\n    if (!search.has('quality')) search.set('quality', store.get('quality', fallback ? 'low' : 'high'));\n  }\n  for (const key of [\n    'input.sensitivity',\n    'input.stickSensitivity',\n    'input.invert',\n    'input.stickInvert',\n    'input.crouch',\n  ]) {\n    const v = store.get(key, null);\n    if (v !== null) search.set(key, String(v));\n  }\n  let sentReady = false;\n  const early = setInterval(() => {\n    const e = ctx.inspector();\n    if (!e || !info || !hub || sentReady) return;\n    sentReady = true;\n    e.pause();\n    netStop = startLockstep(hub, e, {\n      sample: sampleWire,\n      onEnd: () => {\n        audio.mute(true);\n        ended = true;\n      },\n      onMismatch: () => {\n        document.getElementById('msg')!.textContent = 'Connection out of sync.';\n      },\n      finish: (won) => {\n        if (hub!.isHost && !ended) {\n          ended = true;\n          hub!.finish(result(e, info!, won));\n        }\n      },\n    });\n    hub.on('time-up', () => {\n      if (hub!.isHost && !ended) {\n        ended = true;\n        hub!.finish(result(e, info!, false));\n      }\n    });\n    hub.on('end', () => {\n      netStop?.();\n      audio.mute(true);\n    });\n    hub.ready();\n  }, 20);\n  ctx.engine = await createEngine({\n    canvas: document.querySelector('#view')!,\n    scenes: [world.id],\n    search: `?${search}`,\n    store,\n    modal: () => !['play', 'attract'].includes(ctx.screen),\n    actionMap: () => ((ctx.p?.seat?.data.vehicle ?? -1) >= 0 ? 'actionMap:field-drive' : 'actionMap:field'),\n    onView: (action) => {\n      if (action === 'ledger') ctx.open('ledger');\n      if (action === 'viewCamera') {\n        if ((ctx.p?.seat?.data.vehicle ?? -1) >= 0) chase = !chase;\n        else {\n          store.set(\n            'camera',\n            store.get('camera', 'First person') === 'First person' ? 'Over shoulder' : 'First person',\n          );\n          cameraCode = '';\n        }\n      }\n    },\n    onFrame: frame,\n    cameraInput,\n  });\n  clearInterval(early);\n  director.last = performance.now();\n  document.getElementById('loading')!.hidden = true;\n  if (info && ctx.inspector() && !sentReady) hub!.ready();\n} else {\n  document.getElementById('loading')!.hidden = true;\n  const message = document.createElement('div');\n  message.className = 'gpu-notice';\n  message.textContent = 'WebGPU is required for the 3D world. Use a WebGPU-enabled Chrome or Edge.';\n  document.body.append(message);\n  if (info) hub?.fail('WebGPU is required');\n  else {\n    const e = await createHeadless({\n      scene: world,\n      seed: 1947,\n      settings: { 'game.mode': 'title', 'game.detail': 0.05 },\n    });\n    Object.assign(window, { __engine: Object.assign(e, { ready: false }) });\n    setInterval(() => e.step(4), 67);\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_158","type":"command_execution","command":"/bin/bash -lc \"cat > out/split-page.py <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text()\nmarker='if (info && hub) ownCard();'\nhead,tail=s.split(marker,1)\nview_start=tail.index('    onView: (action) => {')\nview_end=tail.index('    onFrame: frame,',view_start)\nview=tail[view_start:view_end]\nview_func=view.replace('    onView: (action) => {','function viewAction(action:string):void {',1)\nview_func=view_func.rsplit('    },',1)[0]+'}\\\\n'\ntail=tail[:view_start]+'    onView: options.onView,\\\\n'+tail[view_end:]\ntail=tail.replace('onFrame: frame','onFrame: options.frame').replace('    cameraInput,','    cameraInput:options.cameraInput,')\ntail=tail.replace('sample: sampleWire','sample: options.sample').replace('  director.last = performance.now();','  options.ready();')\nboot='''/** @file Renderer and AI Hub startup. Simulation readiness is reported before GPU warm-up completes. */\nimport {createEngine,createHeadless,type EngineFrame,type CameraInput} from '../../engine';\nimport {hub,info,ownCard} from './net/session';\nimport {world} from './scenes/world';\nimport {audio} from './sounds/page';\nimport {startLockstep,result,type Wire} from './net/lockstep';\nimport type {Context} from './ui/context';\nexport async function boot(ctx:Context,options:{frame:(f:EngineFrame)=>void;sample:()=>Wire;cameraInput:()=>CameraInput|undefined;onView:(action:string)=>void;ready:()=>void}):Promise<void>{\nconst search=new URLSearchParams(location.search),store=ctx.store;\nlet ended=false,netStop:(()=>void)|null=null;\nif(info&&hub)ownCard();\n'''+tail+'\\\\n}\\\\n'\nPath('labs/game/boot.ts').write_text(boot)\nhead=head.replace(\\\"import { hub, info, ownCard } from './net/session';\\\",\\\"import { info } from './net/session';\\\\nimport {boot} from './boot';\\\")\nhead=head.replace('createEngine, createHeadless, createStore,','createStore,')\nhead=head.replace(\\\"const search = new URLSearchParams(location.search),\\\\n  store = createStore\\\",'const store = createStore')\nhead+=view_func+'\\\\nawait boot(ctx,{frame,sample:sampleWire,cameraInput,onView:viewAction,ready:()=>{director.last=performance.now();}});\\\\n'\np.write_text(head)\ncss=Path('labs/game/ui/style.css').read_text();parts=[];depth=0;start=0\nfor i,c in enumerate(css):\n if c=='{':depth+=1\n elif c=='}':\n  depth-=1\n  if depth==0:parts.append(css[start:i+1]);start=i+1\nparts.append(css[start:])\nchunks=[];current=''\nfor block in parts:\n if current.count('\\\\n')+block.count('\\\\n')>290 and current:chunks.append(current);current=''\n current+=block\nif current.strip():chunks.append(current)\nfor i,chunk in enumerate(chunks):Path(f'labs/game/ui/style-{i}.css').write_text(f'/** @file Bar Cry presentation, stylesheet part {i+1}. */\\\\n'+chunk.strip()+'\\\\n')\nPath('labs/game/ui/style.css').write_text('/** @file The complete TV-readable game skin. */\\\\n'+''.join(f'@import \\\"./style-{i}.css\\\";\\\\n' for i in range(len(chunks))))\nprint(len(chunks),'CSS modules')\nPY\npython3 out/split-page.py\nNODE_OPTIONS=--max-old-space-size=1800 npm run check > out/check.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
