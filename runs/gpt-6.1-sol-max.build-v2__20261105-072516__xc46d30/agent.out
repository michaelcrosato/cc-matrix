{"type":"item.started","item":{"id":"item_171","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/story.ts');s=p.read_text().replace(\\\"b.fallen = w.tick + 3600;\\\\n      placeActor\\\", \\\"b.fallen = w.tick + 3600;\\\\n      const body=w.get(b.entity);if(body?.health)body.health.hp=15;\\\\n      placeActor\\\");p.write_text(s)\np=Path('labs/game/scenes/arms.ts');s=p.read_text().replace(\\\"if (struck?.health && struck.health.hp > 0 && (\"'!struck.seat || !cheat(w, '\"'god'))) {\\\", \\\"if (struck?.health && struck.health.hp > 0 && (\"'!struck.seat || !cheat(w, '\"'god'))&&\"'!(p.soldier&&campaign(w).buddies.some(b=>b.entity===target&&b.fallen>0))) {\")\np.write_text(s)\np=Path('\"'labs/game/scenes/health.ts');s=p.read_text().replace(\\\"standUp(w, b.entity);\\\", \\\"standUp(w, b.entity);const body=w.get(b.entity);if(body?.health)body.health.hp=60;\\\");p.write_text(s)\np=Path('labs/game/scenes/fire.ts');s=p.read_text().replace(\\\"    if (p.health.hp <= 0) continue;\\\", \\\"    if (p.health.hp <= 0||c.buddies.some(b=>b.entity===p.id&&b.fallen>0)) continue;\\\");p.write_text(s)\nPY\ncat > out/physical.mts <<'EOF'\nimport {createHeadless} from '../engine/index.ts';\nimport world from '../labs/game/scenes/world.ts';\nimport {playPrologue,playReceipts,roundOf} from '../labs/game/bot.ts';\nconst e=await createHeadless({scene:world,seed:1,settings:{'game.mode':'story','game.detail':0.05}});\nplayPrologue(e);console.log('Prologue complete',roundOf(e).contract);playReceipts(e);console.log('Receipts complete',roundOf(e).contract);\nEOF\nnode --import tsx out/physical.mts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
