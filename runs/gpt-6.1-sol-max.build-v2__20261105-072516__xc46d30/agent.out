{"type":"item.completed","item":{"id":"item_167","type":"command_execution","command":"/bin/bash -lc \"sed -n '38,100p' labs/game/attract.ts\nsed -n '42,80p' labs/game/scenes/save.ts\"","aggregated_output":"    this.startAt = performance.now();\n    this.vignette = -1;\n    this.ctx.start('attract');\n    e.pause();\n    this.ctx.screen = 'attract';\n    this.ctx.root.hidden = true;\n    this.banner.hidden = false;\n  }\n  stop(): void {\n    if (!this.active) return;\n    this.active = false;\n    this.view = null;\n    this.banner.hidden = true;\n    this.ctx.quit();\n    this.last = performance.now();\n  }\n  update(): void {\n    if (this.ctx.inHub) return;\n    const now = performance.now(),\n      mode = this.ctx.frame?.setting('game.attract') ?? new URLSearchParams(location.search).get('game.attract');\n    if (!this.ctx.engine?.ready) return;\n    if (!this.active) {\n      if (\n        mode !== 'off' &&\n        ['title', 'settings', 'about', 'controls', 'merc', 'lobby'].includes(this.ctx.screen) &&\n        (mode === 'on' || now - this.last >= 10000)\n      )\n        this.start();\n      return;\n    }\n    const n = Math.floor((now - this.startAt) / 15000) % SCENES.length,\n      [label, where, kind] = SCENES[n],\n      e = this.ctx.inspector();\n    if (!e) return;\n    if (n !== this.vignette) {\n      this.vignette = n;\n      e.actions.run('place', { place: where });\n      e.actions.run('give', { pills: 8, syr: 5, condition: kind === 2 ? 0.13 : 0.9, jam: kind === 2 });\n      this.banner.innerHTML = `<strong>${label}</strong>Bar Cry · Press any button`;\n      if (kind === 1 || kind === 6) {\n        const p = this.ctx.p;\n        if (p) e.actions.run('ignite', { x: p.actor.x + 20, z: p.actor.z - 25, radius: 2 });\n      }\n      if (kind === 3) e.actions.run('fever', {});\n      e.camera.set(kind === 0 ? 'cam3=chase,180,-16,7' : kind === 5 ? 'cam3=fieldWalk' : 'cam3=first', { blend: true });\n    }\n    const phase = ((now - this.startAt) % 15000) / 15000,\n      yaw = Math.PI + Math.sin(phase * 2) * 0.7;\n    this.view = [yaw, -0.03];\n    const buttons =\n      kind === 2\n        ? ['reload']\n        : kind === 3 && phase > 0.5\n          ? ['pill']\n          : kind === 5\n            ? ['map']\n            : kind === 1\n              ? ['fire', 'quickfire']\n              : phase < 0.6\n                ? ['fire']\n                : [];\n    e.step(9, {\n      move: kind === 0 ? [Math.sin(yaw) * 0.8, Math.cos(yaw) * 0.8] : [0, 0],\n          rescue: -1,\n        },\n        guns: p.gunState.data.guns,\n        x: p.actor.x,\n        z: p.actor.z,\n        hp: Math.max(40, p.health.hp),\n        mags: p.weapons.mags,\n      })),\n      burns: rle.join(','),\n    }),\n  ) as Save;\n}\nexport function loadSave(w: GW, raw: unknown): void {\n  const data = raw as Save;\n  if (data.version !== 1 || !data.seat?.length || !data.campaign) return;\n  const c = campaign(w),\n    buddies = c.buddies;\n  Object.assign(c, data.campaign);\n  c.mode = 'story';\n  delete c.flags.gameover;\n  for (const b of c.buddies) b.entity = buddies.find((x) => x.key === b.key)?.entity ?? -1;\n  let i = 0;\n  for (const token of data.burns.split(',')) {\n    const [v, n] = token.split(':').map(Number);\n    for (let k = 0; k < n && i < c.fire.length; k++, i++) {\n      if (v === 2) {\n        const x = ((i % 192) + 0.5) * 8,\n          z = (Math.floor(i / 192) + 0.5) * 8;\n        ignite(w, x, z);\n      } else c.fire[i] = v;\n    }\n  }\n  for (const saved of data.seat) {\n    const p = players(w).find((x) => x.seat!.data.n === saved.data.n);\n    if (!p) continue;\n    p.seat!.data = { ...saved.data, wants: {}, previous: [], feverNext: w.tick + 39600 };\n    p.gunState.data.guns = saved.guns;\n    p.health.hp = saved.hp;\n    p.weapons.mags = saved.mags;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_168","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport os,pathlib,signal\nroot=os.getcwd()\nfor d in pathlib.Path('/proc').iterdir():\n if not d.name.isdecimal():continue\n try:\n  if os.readlink(d/'cwd')==root and (d/'cmdline').read_bytes().split(b'\\\\0')[:4]==[b'node',b'--import',b'tsx',b'out/later.mts']:\n   print('Stopping prior diagnostic PID',d.name);os.kill(int(d.name),signal.SIGTERM)\n except OSError:pass\nPY\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('out/later.mts');s=p.read_text().replace(\\\"const original=e.step;let last='';\\\", \\\"const original=e.step;let last='',observed=0;\\\").replace(\\\"const t=original(n,I),c=roundOf(e),p=mercOf(e),key=\\\", \\\"const t=original(n,I);observed+=n;if(n<100&&observed%120>n)return t;const c=roundOf(e),p=mercOf(e),key=\\\");p.write_text(s)\nPY\nnode --import tsx out/later.mts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
