{"type":"item.completed","item":{"id":"item_144","type":"command_execution","command":"/bin/bash -lc \"sed -n '55,88p' engine/sim/ragdolls.ts\nrg -n 'rise:' -A4 engine/sim/ragdolls.ts | head -20\nrg -n 'function standUp' -A8 engine/sim/ragdolls.ts\"","aggregated_output":"  /** Seconds its trunk lies still before it gets up. */\n  settle: 0.5,\n  /** Seconds after which it gets up however it lies. */\n  longest: 5,\n  /** Seconds it stays as it gets up, while the view fades it out (engine/anim/ragdoll.ts `RAGDOLL_FADE`). */\n  rise: RAGDOLL_FADE.out,\n  /** The spin a push gives by default: rad/s about the push's level side for each m/s of it, tipping it over. */\n  tip: 0.8,\n} as const;\n\n/** The component `ragdoll`'s fields. */\nexport const RAGDOLL_FIELDS = defineSchema({\n  bodies: { type: 'array', items: { type: 'number' }, default: [], description: 'Its parts’ bodies, in engine/anim/ragdoll.ts `RAGDOLL_PARTS` order (none once it got up).' }, // prettier-ignore\n  joints: { type: 'array', items: { type: 'number' }, default: [], description: 'The joints between its parts.' },\n  poses: { type: 'array', items: { type: 'number' }, default: [], description: 'Its parts’ poses as the last step left them, 7 numbers a part: position, then rotation (x, y, z, w).' }, // prettier-ignore\n  since: { type: 'number', default: 0, description: 'The step it was handed off on.' },\n  still: { type: 'number', default: 0, description: 'Steps its trunk (the pelvis and the chest) has lain still.' },\n  rise: { type: 'number', default: -1, description: 'The step it got up on; −1 while it falls or lies dead.' },\n  dead: { type: 'boolean', default: false, description: 'Dead: it lies until it is removed.' },\n  lying: { type: 'string', enum: ['up', 'down'], default: 'up', description: 'How it lay as it got up: on its back (up) or its face (down).' }, // prettier-ignore\n});\n\n/** The component `ragdoll`: an actor's body in physics' hands (see the file comment). */\nexport interface RagdollState {\n  bodies: number[];\n  joints: number[];\n  poses: number[];\n  since: number;\n  still: number;\n  rise: number;\n  dead: boolean;\n  lying: 'up' | 'down';\n}\n\n60:  rise: RAGDOLL_FADE.out,\n61-  /** The spin a push gives by default: rad/s about the push's level side for each m/s of it, tipping it over. */\n62-  tip: 0.8,\n63-} as const;\n64-\n--\n72:  rise: { type: 'number', default: -1, description: 'The step it got up on; −1 while it falls or lies dead.' },\n73-  dead: { type: 'boolean', default: false, description: 'Dead: it lies until it is removed.' },\n74-  lying: { type: 'string', enum: ['up', 'down'], default: 'up', description: 'How it lay as it got up: on its back (up) or its face (down).' }, // prettier-ignore\n75-});\n76-\n--\n84:  rise: number;\n85-  dead: boolean;\n86-  lying: 'up' | 'down';\n87-}\n88-\n--\n154:  Object.assign(ragdoll, { bodies: [...made.bodies], joints: [...made.joints], poses: readRagdoll(physics, made), since: w.tick, still: 0, rise: -1, dead: hit.dead ?? false }); // prettier-ignore\n155-  reactTo(w, id, (r) => (hit.dead ? r.die(push, yaw) : r.knockDown(push, yaw, Infinity)));\n161:export function standUp<C extends object>(world: World<C>, id: number): boolean {\n162-  const w = world as unknown as World;\n163-  const e = w.get(id) as Partial<Body> | undefined;\n164-  if (!e?.ragdoll || e.ragdoll.rise >= 0 || !e.actor || !e.animator) return false;\n165-  e.ragdoll.dead = false;\n166-  getUp(w, e as Body, e.ragdoll);\n167-  return true;\n168-}\n169-\n","exit_code":0,"status":"completed"}}
