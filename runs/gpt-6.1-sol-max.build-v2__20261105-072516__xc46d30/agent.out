{"type":"item.completed","item":{"id":"item_98","type":"agent_message","text":"The frontend now includes the paper map, sparse HUD, controller navigation, settings, developer sliders, dealer, ledger, and credits screens. I’m connecting those screens to the simulation and co-op transports, then I’ll test the campaign and browser interactions end to end.\n"}}
{"type":"item.started","item":{"id":"item_99","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/main.ts <<'EOF'\n/** @file Bar Cry's page: boot, presentation, saved accounts, real-time menus and the network pump. */\nimport { hub, info, ownCard } from './net/session';\nimport { createEngine, createHeadless, createStore, type EngineFrame, type CameraInput } from '../../engine';\nimport { world } from './scenes/world';\nimport { campaign, players, type GW, type Campaign, type Person } from './scenes/state';\nimport { makeSave } from './scenes/save';\nimport { TITLE } from './title';\nimport { audio, soundFrame } from './sounds/page';\nimport { renderScreen } from './ui/screens';\nimport { navigation, refreshGlyphs } from './ui/controls';\nimport { inspector, type Context, type GameInspector } from './ui/context';\nimport { createHud } from './ui/hud';\nimport { makeMap } from './ui/map';\nimport { startLockstep, inspectorDigest, result, type Wire } from './net/lockstep';\nimport { Attract } from './attract';\nimport './art/world';\nimport './art/bodies';\nimport './art/cameras';\nimport './ui/style.css';\n\nconst search=new URLSearchParams(location.search),store=createStore({prefix:'bar-cry:',mode:info?'demo':'play'});\nlet cameraCode='',chase=false,saveVersion=-1,seenWorld:object|null=null,dialogueSeen=0,endingSeen='',netStop:(()=>void)|null=null,ended=false;\nconst root=document.getElementById('front')\"'!;\nconst ctx:Context={engine:null,frame:null,c:null,p:undefined,screen:info?'\"'play':'title',parent:'title',inHub:\"'!!info,device:'\"'keyboard',glyphs:store.get('glyphs','PlayStation'),store,root,me:info?.me??0,seed:info?.seed??1947,net:null,\n  inspector:()=>inspector(ctx),\n  open(name){\n    const e=ctx.inspector();\n    if(name==='map'){if(e)e.step(1,{p:['map']});name='play';}\n    if(info&&['title','dev','lobby'].includes(name))return;\n    if(['title','pause','ending'].includes(ctx.screen))ctx.parent=ctx.screen;else if(['dialogue','shop','sleep'].includes(name))ctx.parent='play';\n    ctx.screen=name;\n    if(name==='pause'&&\"'!ctx.inHub)e?.pause();\n    if(name==='\"'play'&&\"'!ctx.inHub&&!director?.active)e?.resume();\n    if(name!=='\"'play'){document.exitPointerLock?.();ctx.engine?.input?.clear();}\n    renderScreen(ctx);refreshGlyphs(ctx);\n  },\n  back(){\n    if(ctx.screen==='play'){if(ctx.p?.seat?.data.map){ctx.inspector()?.step(1,{p:['map']});return;}ctx.open(ctx.inHub?'settings':'pause');}\n    else if(ctx.screen==='pause')ctx.open('play');\n    else if(ctx.screen==='title')return;\n    else {const target=ctx.parent==='pause'?'pause':ctx.parent==='ending'?'ending':ctx.c?.mode==='story'||ctx.c?.mode==='contract'?'play':'title';ctx.open(target);}\n  },\n  start(mode,merc=0,load=false){\n    const e=ctx.inspector();if(\"'!e){if(!navigator.gpu)document.getElementById('\"'msg')\"'!.textContent='\"'WebGPU is required. Open this file in a WebGPU-enabled Chrome or Edge.';return;}\n    if(info)return;\n    if(mode\"'!=='\"'attract')netStop?.();\n    for(const [key,v] of Object.entries({'game.mode':mode,'game.merc':merc,'game.me':0,'game.seats':1}))e.set(key,v);\n    if(mode==='story'&&\"'!load){for(const [path,,v] of TUNING)e.set(`game.${path}`,v);for(const key of ['\"'god','ammo','noWear','noFever','invisible','oneShot','noclip'])e.set(\"'`game.${key}`,false);}\n    ctx.me=0;ctx.seed++;e.seed(ctx.seed);if(load){const data=store.get('\"'save',null);if(data)e.actions.run('load',data);}\n    ctx.screen=mode==='title'?'title':'play';ctx.parent=mode==='title'?'title':'pause';seenWorld=null;endingSeen='';dialogueSeen=0;e.resume();ctx.engine?.input?.clear();cameraCode='';\n    if(mode==='title')e.camera.set('cam3=fixed,548,18,730,156,-7');else e.camera.set(store.get('camera','First person')==='First person'?'cam3=first,180,0':'cam3=shoulder,180,-10,3',{blend:true});\n    renderScreen(ctx);\n  },\n  quit(){if(info)return;netStop?.();netStop=null;ctx.net?.close();ctx.net=null;ctx.inHub=false;ctx.start('title');},\n  send(cmd){ctx.inspector()?.step(1,{'game:command':{...cmd,seat:ctx.me} as never});},\n  startNet(){\n    const net=ctx.net,e=ctx.inspector();if(\"'!net||!e)return;\n    ctx.inHub=true;ctx.me=net.me;\n    for(const [key,v] of Object.entries({'\"'game.mode':'contract','game.seats':net.players.length,'game.me':net.me,'game.detail':0.08}))e.set(key,v);\n    e.seed(net.seed);e.pause();ctx.screen='play';cameraCode='';renderScreen(ctx);\n    netStop=startLockstep(net,e,{sample:sampleWire,onMismatch:()=>{document.getElementById('msg')\"'!.textContent='\"'Connection out of sync.';},onEnd:()=>ctx.open('ending'),finish:won=>{if(\"'!ended){ended=true;net.finish(result(e,net,won));}}});\n  }\n};\nimport { TUNING } from '\"'./scenes/settings';\nconst director=new Attract(ctx),hud=createHud(ctx),map=makeMap(ctx);\nnavigation(ctx,()=>director.activity());renderScreen(ctx);\nfor(const bus of ['master','music','effects','ui','ambience'] as const)audio.volume(bus,store.get(\"'`audio.${bus}`,audio.volume(bus)));\ndocument.getElementById('\"'touch-settings')\"'!.onclick=()=>{document.getElementById('\"'touch-notice')\"'!.classList.add('\"'dismissed');ctx.open('settings');};\nlet lastWire:Wire={m:[0,0],l:[Math.PI,0],b:[]},latched=new Set<string>();\nfunction sampleWire():Wire {\n  const input=ctx.engine?.input,pose=ctx.frame?.camera;if(\"'!input||!pose||ctx.screen!=='\"'play')return {m:[0,0],l:[pose?.yaw??Math.PI,pose?.pitch??0],b:[]};\n  const forward=input.strength('forward')-input.strength('back'),right=input.strength('right')-input.strength('left'),yaw=pose.yaw;\n  const m:[number,number]=[Math.sin(yaw)*forward-Math.cos(yaw)*right,Math.cos(yaw)*forward+Math.sin(yaw)*right];\n  const names=['fire','aim','jump','sprint','crouch','interact','reload','weapon1','weapon2','weapon3','swap','holster','melee','throw','heal','pill','map','locator','quickfire','throttle','brake','driveLeft','driveRight','handbrake','seat'];\n  const b=names.filter(key=>input.held(key)||latched.has(key));latched.clear();\n  return {m,l:[pose.yaw,pose.pitch],a:[pose.position[0]+Math.sin(yaw)*Math.cos(pose.pitch)*150,pose.position[1]+Math.sin(pose.pitch)*150,pose.position[2]+Math.cos(yaw)*Math.cos(pose.pitch)*150],b};\n}\nfunction frame(f:EngineFrame):void {\n  ctx.frame=f;const w=f.world as unknown as GW;ctx.c=campaign(w);ctx.p=players(w).find(p=>p.seat\"'!.data.n===ctx.me);\n  const c=ctx.c,p=ctx.p,s=p?.seat?.data,e=ctx.inspector();\n  if(seenWorld!==f.world){seenWorld=f.world;saveVersion=c.save;}\n  if(!ctx.inHub&&c.mode==='\"'story'&&saveVersion\"'!==c.save){saveVersion=c.save;store.set('\"'save',makeSave(w));}\n  if(ctx.engine?.input)for(const key of ['jump','interact','reload','weapon1','weapon2','weapon3','heal','pill','map','locator','quickfire','throw','seat'])if(ctx.engine.input.pressed(key))latched.add(key);\n  if(ctx.screen==='play'&&s&&e){\n    const desired=s.action||s.down>0?'cam3=fieldBody':s.vehicle>=0?(chase?'cam3=chase':'cam3=fieldDrive'):p\"'!.weapons.slot<0?'\"'cam3=fieldWalk':store.get('camera','First person')==='First person'?'cam3=first':'cam3=shoulder';\n    if(cameraCode\"'!==desired){cameraCode=desired;e.camera.set(desired,{blend:true});}\n    if(c.flags.gameover)ctx.open('\"'gameover');\n    else if(c.ending&&endingSeen\"'!==c.ending){endingSeen=c.ending;ctx.open('\"'ending');}\n    else if(c.flags.sleep){ctx.open('sleep');ctx.send({kind:'dismiss'});e.actions.run('command',{kind:'clearPanel',key:'sleep'});}\n    else if(c.flags.dialogue&&c.flags.dialogue\"'!==dialogueSeen){dialogueSeen=c.flags.dialogue;ctx.open(c.flags.shop?'\"'shop':'dialogue');}\n  }\n  if(ctx.screen\"'!=='\"'play'&&c.flags.dialogue===0)dialogueSeen=0;\n  hud.update();map.update();soundFrame(f,c,p);\n  const clusters=Object.keys(c.flames).map(Number).sort((a,b)=>{const ax=(a%192)*8,az=Math.floor(a/192)*8,bx=(b%192)*8,bz=Math.floor(b/192)*8;return Math.hypot(ax-(p?.actor.x??550),az-(p?.actor.z??700))-Math.hypot(bx-(p?.actor.x??550),bz-(p?.actor.z??700));}).slice(0,24);\n  for(const i of clusters){const x=(i%192+0.5)*8,z=(Math.floor(i/192)+0.5)*8;f.emit(\"'`emitter:smoke-${((Math.round(c.wind/(Math.PI/4))%8)+8)%8}`,[x,ground(x,z)+1,z],`fire-${i}`);}\n}\nimport { ground } from '\"'./scenes/map';\nfunction cameraInput():CameraInput|undefined {\n  if(director.view)return {view:director.view} as CameraInput;\n  if(ctx.screen\"'!=='\"'play'||ctx.device\"'!=='\"'gamepad'||\"'!store.get('\"'assist',true)||\"'!ctx.frame||!ctx.p)return undefined;\n  const pad=[...navigator.getGamepads()].find(Boolean);if(!pad||Math.abs(pad.axes[2]??0)<0.1&&Math.abs(pad.axes[3]??0)<0.1)return undefined;\n  const yaw=ctx.frame.camera.yaw,p=ctx.p,targets=[...ctx.frame.world.query('\"'actor','soldier','health')] as unknown as Person[];\n  const nearest=targets.filter(t=>t.health.hp>0).map(t=>({t,d:Math.atan2(Math.sin(Math.atan2(t.actor.x-p.actor.x,t.actor.z-p.actor.z)-yaw),Math.cos(Math.atan2(t.actor.x-p.actor.x,t.actor.z-p.actor.z)-yaw))})).sort((a,b)=>Math.abs(a.d)-Math.abs(b.d))[0];\n  if(\"'!nearest||Math.abs(nearest.d)>0.1)return undefined;return {look:[-nearest.d*0.035,0]};\n}\nconst gameAPI={title:TITLE,audio,screen:()=>ctx.p?.seat?.data.map&&ctx.screen==='\"'play'?'map':ctx.screen,open:(name:string)=>ctx.open(name),start:(mode='story',merc=0)=>ctx.start(mode,merc),digest:()=>ctx.inspector()?inspectorDigest(ctx.inspector()\"'!):'\"'',context:ctx,attract:director};\n(window as unknown as {__game:typeof gameAPI}).__game=gameAPI;\nif(info&&hub)ownCard();\nif(info?.server&&hub){\n  const e=await createHeadless({scene:world,seed:info.seed,settings:{'game.mode':'contract','game.seats':info.players.length,'game.me':-1,'game.detail':0.08}});\n  Object.assign(window,{__engine:Object.assign(e,{ready:true})});\n  const stop=startLockstep(hub,e,{sample:()=>({m:[0,0],l:[0,0],b:[]}),finish:won=>{if(\"'!ended){ended=true;hub.finish(result(e,info,won));}}});\n  hub.on('\"'time-up',()=>{if(\"'!ended){ended=true;hub.finish(result(e,info,false));}});hub.on('\"'end',()=>{stop();audio.mute(true);});hub.ready();\n}else if(navigator.gpu){\n  search.set('touch','off');search.set('gfx.warmUp','asked');search.set('post.look','look:dry-season');search.set('cam.fov',String(store.get('cam.fov',76)));\n  search.set('game.mode',info?'contract':search.get('game.mode')??'title');\n  search.set('game.seats',String(info?.players.length??1));search.set('game.me',String(ctx.me));search.set('seed',String(ctx.seed));\n  search.set('cam3',info?'first':'fixed,548,18,730,156,-7');\n  if(\"'!search.has('\"'game.detail')){\n    let fallback=true;try{const adapter=await navigator.gpu.requestAdapter();fallback=adapter?.info?.isFallbackAdapter??true;}catch{}\n    search.set('game.detail',info?'0.08':fallback?'0.16':'1');\n  }\n  for(const key of ['input.sensitivity','input.stickSensitivity','input.invert','input.stickInvert','input.crouch']){const v=store.get(key,null);if(v\"'!==null)search.set(key,String(v));}\n  let sentReady=false;\n  const early=setInterval(()=>{\n    const e=ctx.inspector();if(!e||!info||!hub||sentReady)return;sentReady=true;e.pause();\n    netStop=startLockstep(hub,e,{sample:sampleWire,onEnd:()=>{audio.mute(true);ended=true;},onMismatch:()=>{document.getElementById('\"'msg')\"'!.textContent='\"'Connection out of sync.';},finish:won=>{if(hub.isHost&&\"'!ended){ended=true;hub.finish(result(e,info,won));}}});\n    hub.on('\"'time-up',()=>{if(hub.isHost&&\"'!ended){ended=true;hub.finish(result(e,info,false));}});hub.on('\"'end',()=>{netStop?.();audio.mute(true);});hub.ready();\n  },20);\n  ctx.engine=await createEngine({canvas:document.querySelector('#view')\"'!,scenes:[world.id],search:`?${search}`,store,modal:()=>!['\"'play','attract'].includes(ctx.screen),\n    actionMap:()=>ctx.p?.seat?.data.vehicle>=0?'actionMap:field-drive':'actionMap:field',\n    onView:action=>{if(action==='ledger')ctx.open('ledger');if(action==='viewCamera'){if(ctx.p?.seat?.data.vehicle>=0)chase=\"'!chase;else{store.set('\"'camera',store.get('camera','First person')==='First person'?'Over shoulder':'First person');cameraCode='';}}},onFrame:frame,cameraInput});\n  clearInterval(early);document.getElementById('loading')\"'!.hidden=true;\n  if(info&&ctx.inspector()&&!sentReady)hub!.ready();\n}else{\n  document.getElementById('\"'loading')\"'!.hidden=true;\n  const message=document.createElement('\"'div');message.className='gpu-notice';message.textContent='WebGPU is required for the 3D world. Use a WebGPU-enabled Chrome or Edge.';document.body.append(message);\n  if(info)hub?.fail('WebGPU is required');\n  else {const e=await createHeadless({scene:world,seed:1947,settings:{'game.mode':'title','game.detail':0.05}});Object.assign(window,{__engine:Object.assign(e,{ready:false})});setInterval(()=>e.step(4),67);}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
