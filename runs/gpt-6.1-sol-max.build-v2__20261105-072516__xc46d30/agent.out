{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"rg -n 'material|roof' engine/world/level/glyph.ts | head -16\nsed -n '45,70p' engine/world/level/parse.ts\nsed -n '1,100p' engine/gfx/cameras/registry.ts\nrg -n 'type Store|interface Store|\\\\.set\\\\(' engine/ui/store.ts engine/core/store.ts 2>/dev/null\nsed -n '45,95p' engine/sim/scene.ts\"","aggregated_output":"162:      \"Format 2: its box rises from its storey's floor to the floor of the storey above (or to the roof over it), whatever its top: a wall, a pillar. A format-1 level reads its top.\",\nexport interface LevelHeader {\n  /** What the level is, in plain sentences ('' when not given). */\n  description: string;\n  /** Metres per map character: one tile is tile × tile metres. */\n  tile: number;\n}\n\n/** A storey's keys as its block writes them, absent when not given (engine/world/level/storeys.ts reads them). */\nexport interface StoreyKeys {\n  /** Its floor's height (m). */\n  base?: number;\n  /** Its clear height, floor to ceiling (m). */\n  height?: number;\n  /** The roof over it: `'gable'`, `'hip'` or `'flat'` (the top storey's only). */\n  roof?: 'gable' | 'hip' | 'flat';\n  /** A pitched roof's slope (°). */\n  pitch?: number;\n  /** The axis a gable's ridge runs along: `'x'` (east to west) or `'z'` (north to south). */\n  ridge?: 'x' | 'z';\n  /** How far the roof reaches past the storey's walls (m). */\n  eaves?: number;\n  /** The roof's surface tag (footsteps, particles). */\n  roofSurface?: string;\n}\n\n/**\nsed: can't read engine/gfx/cameras/registry.ts: No such file or directory\n\n/** The codes this module raises, with their fixes. */\nexport const SCENE_CODES = defineCodes('sim', {\n  SIM_BAD_SEED: {\n    template: '{where} got the seed {value}, which a replay cannot hold',\n    fix: 'pass a whole number, 0 or more (x sim --seed 3, __engine.seed(3)): record() writes the seed into the replay',\n  },\n});\n\n/** Returns `seed` (1 when absent; -0 as 0); throws `SIM_BAD_SEED` naming `where` unless it is a whole number from 0. */\nexport function checkSeed(seed: unknown, where: string): number {\n  if (seed === undefined) return 1;\n  if (Number.isInteger(seed) && (seed as number) >= 0) return (seed as number) + 0; // -0 + 0 is 0\n  throw codeError('SIM_BAD_SEED', { where, value: show(seed) });\n}\n\n/** A dev action of a scene: runs between steps inside `w.run`, with plain-data `args`; recorded in replays. */\nexport type SceneAction<W> = (w: W, args: unknown) => void;\n\n/** A sound a sim event plays: an `sfx` entry, its gain (1 by default) and its variant (the effect's next by default). */\nexport interface SceneSound {\n  readonly sfx: string;\n  readonly vol?: number;\n  readonly variant?: number;\n}\n\n/** The sound a traced event names in its payload, `{ sfx, vol?, variant? }`, or null: a scene's default `sounds`. */\nexport function payloadSound(record: TraceRecord): SceneSound | null {\n  const payload = record.payload;\n  if (!isPlainObject(payload) || payload.sfx === undefined) return null;\n  return { sfx: payload.sfx, vol: payload.vol, variant: payload.variant } as SceneSound;\n}\n\n/** How a scene is written: `defineScene(id, spec)`. */\nexport interface SceneSpec<C extends object = AnyComponents, E extends EventMap = EventMap> {\n  /** What the scene shows or tests, in plain sentences. */\n  description?: string;\n  /** The level it loads (`level:<name>`), when it has one (WP 2.2). */\n  level?: string;\n  /** Its terrain (`terrain:<name>`), when it has one (WP 10.5). */\n  terrain?: string;\n  /** Its site (`site:<name>`: levels on a terrain), when it has one (WP 13.15). */\n  site?: string;\n  /** Whether it has a physics world (WP 3.1): `physicsOf(w)` reaches it, the system `physics` steps it. */\n  physics?: boolean;\n  /** Setting values for its lifetime, path → value (schema-checked). */\n  settings?: Readonly<Record<string, unknown>>;\n  /** Runs once when it starts: spawns, systems, listeners. */\n  setup: (w: World<C, E>) => void;\n  /** Runs every step, first in the phase `intents`: reads the step's intents and components, writes components. */\n  step?: (w: World<C, E>, intents: Intents) => void;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"sed -n '28,110p' engine/world/level/level.ts\nrg -l 'interface CameraKindSpec|function followCamera' engine\nrg -l 'export interface Store' engine\nsed -n '1039,1083p' ../PLAN.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"sed -n '28,110p' engine/world/level/level.ts\nrg -l 'interface CameraKindSpec|function followCamera' engine\nrg -l 'export interface Store' engine\nsed -n '1039,1083p' ../PLAN.md\"","aggregated_output":"import { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport type { Schema, SpecOf } from '../../core/schema';\nimport { compileLevel } from './compile';\nimport type { CompiledLevel } from './types';\nimport { checkLevel } from './validate';\n\n/** The fields of a `level` entry. */\nexport const LEVEL_FIELDS = {\n  text: {\n    type: 'string',\n    required: true,\n    description:\n      \"The level's text: optional front matter, then the map (engine/world/level/parse.ts gives the format).\",\n  },\n  file: {\n    type: 'string',\n    default: '',\n    description: 'The file the text came from (labs/box/levels/room.txt), for messages; the id stands in when empty.',\n  },\n  materials: {\n    type: 'object',\n    default: {},\n    description:\n      \"Material swaps for drawing it, presentation only: a material id its meshes' recipes name → the game's material drawn instead ({ 'material:flagstone': 'material:hallFloor' }).\",\n  },\n  rooms: {\n    type: 'object',\n    default: {},\n    description:\n      \"A level written as storeys: each room's floor material for drawing it, presentation only, by room name ({ kitchen: 'material:tiles' }).\",\n  },\n  recipes: {\n    type: 'object',\n    default: {},\n    description:\n      \"Mesh recipes for drawing it, presentation only: a recipe its glyphs name that the engine lacks, or one of the engine's drawn otherwise in this level, as engine/gfx/level/recipes.ts writes them ({ roof: { shape: 'roof', materials: ['material:shingles', 'material:wood'], castShadow: true, receiveShadow: true } }).\",\n  },\n  doors: {\n    type: 'string',\n    default: '',\n    description:\n      \"A level written as storeys: the prop its scene hangs in the door openings it fits (engine/sim/doors.ts addLevelDoors hangs 'prop:door'), which their frames are drawn to meet, presentation only; '' for none, plain frames (engine/world/level/doorways.ts).\",\n  },\n} as const satisfies Schema;\n\n/** The problems with a level entry's `recipes`: each a recipe as engine/gfx/level/recipes.ts writes one. */\nfunction recipeProblems(recipes: Record<string, unknown>): string[] {\n  return Object.entries(recipes).flatMap(([name, value]) => {\n    const recipe = (value ?? {}) as Record<string, unknown>;\n    const materials = recipe.materials as unknown[] | undefined;\n    const ok =\n      typeof recipe.shape === 'string' &&\n      Array.isArray(materials) &&\n      materials.length > 0 &&\n      materials.every((id) => typeof id === 'string') &&\n      typeof recipe.castShadow === 'boolean' &&\n      typeof recipe.receiveShadow === 'boolean';\n    return ok ? [] : [`recipes[\"${name}\"] must be { shape, materials: [material ids], castShadow, receiveShadow }`];\n  });\n}\n\n/** A `level` entry: a level's text and where it came from. */\nexport type LevelEntry = Entry<typeof LEVEL_FIELDS>;\n\n/** Declares the kind `level` on `registry` unless it has it. */\nfunction levelKind(registry: Registry): void {\n  if (registry.kinds().includes('level')) return;\n  registry.defineKind('level', {\n    description:\n      'Levels: a level text (front matter and a map in legend characters) that compileLevel turns into data.',\n    fields: LEVEL_FIELDS,\n    defineWith: \"defineLevel('<id>', { text, file, materials, rooms, recipes, doors })\",\n    check: (entry) => {\n      const level = entry as LevelEntry;\n      const { problems } = checkLevel(level.text, { file: level.file || level.id, registry });\n      const swaps = Object.entries(level.materials as Record<string, unknown>)\n        .filter(([, to]) => typeof to !== 'string')\n        .map(([from]) => `materials[\"${from}\"] must be a material id (a string)`);\n      const rooms = Object.entries(level.rooms as Record<string, unknown>)\n        .filter(([, to]) => typeof to !== 'string')\n        .map(([room]) => `rooms[\"${room}\"] must be a material id (a string)`);\n      const recipes = recipeProblems(level.recipes as Record<string, unknown>);\n      return [...problems.map((problem) => problem.message), ...swaps, ...rooms, ...recipes];\nengine/gfx/cameras/chase.ts\nengine/gfx/cameras/define.ts\nengine/world/level/walk.ts\nengine/world/level/types.ts\nengine/world/level/parse.ts\nengine/gfx/storeyCut.ts\nengine/app/store.ts\n/** @file tests/game/hub.mjs: plays the hub's harness over the deliverable in the four configurations the hub's own test uses, on a port the OS picks. */\nimport { copyFileSync, existsSync, readFileSync } from 'node:fs';\nimport { createServer } from 'node:http';\nimport { basename, extname, join } from 'node:path';\nimport { chromium } from '@playwright/test';\n\nconst RUNS = ['players=2', 'players=4&latency=150&jitter=50&loss=5', 'players=4&latency=150&jitter=50&loss=5&scenario=host-leave', 'players=2&scenario=server'];\nconst ARGS = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-angle=swiftshader', '--use-webgpu-adapter=swiftshader'];\ncopyFileSync(`../${basename(process.cwd())}.html`, '.cache/hub/game.html');\nconst types = { '.html': 'text/html', '.js': 'text/javascript' };\nconst server = createServer((request, response) => {\n  const file = join('.cache/hub', new URL(request.url, 'http://x').pathname);\n  if (!existsSync(file)) return response.writeHead(404).end();\n  response.writeHead(200, { 'content-type': types[extname(file)] ?? 'text/plain' }).end(readFileSync(file));\n});\nawait new Promise((listening) => server.listen(0, '127.0.0.1', listening));\nconst origin = `http://127.0.0.1:${server.address().port}`;\nlet [passed, failed] = [0, 0];\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH, args: ARGS });\nconst mine = await (await fetch(`${origin}/game.html`)).text();\nif (!mine.includes('name=\"hub:session\"')) throw new Error('the page served is not this game');\nfor (const run of RUNS) {\n  const page = await browser.newPage({ viewport: { width: 1600, height: 900 } });\n  await page.goto(`${origin}/harness.html?game=game.html&${run}&auto=1`);\n  await page.waitForFunction(() => document.body.dataset.complete === 'true', undefined, { timeout: 170000 }).catch(() => {});\n  const report = await page.evaluate(() => window.__hubCheck ?? { checks: [] });\n  for (const check of report.checks) {\n    if (check.pass) passed += 1;\n    else {\n      failed += 1;\n      console.log(`FAIL ${run}: ${check.name}: ${String(check.detail).slice(0, 200)}`);\n    }\n  }\n  if (!report.pass && !report.checks.some((check) => !check.pass)) {\n    failed += 1;\n    console.log(`FAIL ${run}: the harness never finished`);\n  }\n  await page.close();\n}\nawait browser.close();\nserver.close();\nconsole.log(`COUNT ${passed} ${failed}`);\n```\n\n```js\n","exit_code":0,"status":"completed"}}
