{"type":"item.completed","item":{"id":"item_172","type":"command_execution","command":"/bin/bash -lc \"sed -n '65,100p' engine/input/bindings.ts\nrg -n 'primary|bus' engine/audio/runtime/sound.ts | head -15\nrg -n 'data-screen|data-glyph' labs/game/ui/screens.ts | head -12\"","aggregated_output":"  | { ok: true; codes: readonly string[] }\n  | { ok: false; reason: 'unknown-action' | 'bad-code' | 'reserved' | 'conflict'; action?: string; message: string };\n\n/** How bindings are made. */\nexport interface BindingsOptions {\n  /** Where they are saved and loaded (the page's `localStorage`); none keeps them in memory. */\n  storage?: BindingsStorage;\n  /** The storage key (`my3dge:bindings:<map id>`). */\n  key?: string;\n  /** Where the map is registered (the shared registry). */\n  registry?: Registry;\n  /** Where advice goes (the shared log). */\n  log?: Log;\n}\n\n/** An action map with the player's changes. */\nexport interface Bindings {\n  /** The action map underneath. */\n  readonly map: ActionMap;\n  /** Counts the changes since creation. */\n  readonly version: number;\n  /** The map's actions, in its order. */\n  actions(): string[];\n  /** The codes bound to `action` now. */\n  codes(action: string): readonly string[];\n  /** Puts `code` on `action`, replacing the action's codes of that device family, or only `replace`. */\n  rebind(action: string, code: string, options?: { replace?: string }): RebindResult;\n  /** Takes `code` off `action`, or every code of `device`'s family. */\n  unbind(action: string, which: string): void;\n  /** Gives `action` (or every action) the map's codes again. */\n  reset(action?: string): void;\n  /** What a prompt shows for `action` on `device`: its first code of that device, labelled; `—` when unbound. */\n  label(action: string, device: DeviceKind, options?: LabelOptions): string;\n  /** The changes as a bindings file. */\n  toJSON(): BindingsFile;\n}\n3: * has a position, a lowpass for occlusion and a `PannerNode` (engine/audio/runtime/spatial.ts), into a mixer bus.\n19: * const voice = createVoice(context, { id: 'sfx:hit', bus: 'effects', buffer, input, when: 0, options });\n48:  /** The bus; the entry's by default. */\n49:  bus?: AudioBus;\n63:  readonly bus: AudioBus;\n115:  bus: AudioBus;\n117:  /** Where it connects: the bus's input. */\n128:  const { id, bus, buffer, input, when, options } = spec;\n144:    bus,\n14:  ctx.root.innerHTML = `<div class=\"title-screen\"><div class=\"title-top\"><span>BASIN AUCTION HOUSE</span><span>EST. 1968 &nbsp; / &nbsp; LOT No. 001</span></div><div class=\"title-copy\"><p class=\"eyebrow\">A WARRANT. A RIFLE. A DEBT.</p><h1>BAR<br><span>CRY</span></h1><p class=\"title-tag\">Everything here has a price.<br>Even getting out.</p><nav class=\"title-menu\"></nav></div><div class=\"auction-slip\"><span class=\"lot-number\">01</span><p class=\"eyebrow\">CONDITION OF SALE</p><h2>ONE<br>MERCENARY.</h2><p>Imported.<br>Sound in limb.<br>Uncertain in conscience.</p><div class=\"stamp\">RESERVE<br>NOT MET</div><small>THE FEVER IS INCLUDED.</small></div><div class=\"title-bottom\"><span>THE DRY SEASON &nbsp; / &nbsp; AN OPEN-WORLD MERCENARY STORY</span><span data-glyph=\"select\">Enter</span></div></div>`;\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_173","type":"agent_message","text":"The later-contract bot has reached an ending after carrying medicine, burning the depot and estate, escaping by boat, fighting at Salt Works, and visiting the rail car. I’m checking the full route from the prologue next, along with repair controls, medical props, saves, and idle-demo behavior.\n"}}
