 up, + left. */\nengine/gfx/cameras/effects.ts:129:   * The burst's climb, rad (+ up, + left): the player's `recoil`, the sim's kick as it is (no easing: the next shot\nengine/gfx/cameras/effects.ts:136:  /** Metres to add to the screen shake. */\nengine/gfx/cameras/effects.ts:137:  readonly shake: number;\nengine/gfx/cameras/effects.ts:163:  const weapons = entity.weapons as { kick?: readonly number[]; shots?: number } | undefined;\nengine/gfx/cameras/effects.ts:165:  const [up, right] = weapons?.kick ?? [0, 0];\nengine/gfx/cameras/effects.ts:180:  /** Reads the player after a sim step: its landings, jumps and grabs kick the view. */\nengine/gfx/cameras/effects.ts:185:  kick(pitch: number, yaw?: number): void;\nengine/gfx/cameras/effects.ts:198:  let [sprint, boost, drop, roll, slideRoll, aim, phase, share, shake] = [0, 0, 0, 0, 0, 0, 0, 0, 0];\nengine/gfx/cameras/effects.ts:201:  /** A kick whose spring peaks about `peak` rad. */\nengine/gfx/cameras/effects.ts:202:  const kick = (up: number, left = 0) => {\nengine/gfx/cameras/effects.ts:213:        kick(-Math.min(punch.max, punch.land * Math.max(0, speed - punch.from)));\nengine/gfx/cameras/effects.ts:214:        shake += EFFECTS.shake.per * Math.max(0, speed - EFFECTS.shake.from);\n82:    inspectorOf(e).set('game.god', true);\n145:    inspectorOf(e).set('game.god', true);\n215:  it('plays the later contracts through all three endings', async () => {\n223:  it('plays Lot Zero and Receipts with physical travel', async () => {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_181","type":"command_execution","command":"/bin/bash -lc \"sed -n '34,76p' engine/gfx/cameras/rig.ts\nsed -n '55,90p' engine/gfx/cameras/effects.ts\nsed -n '309,356p' labs/game/main.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_181","type":"command_execution","command":"/bin/bash -lc \"sed -n '34,76p' engine/gfx/cameras/rig.ts\nsed -n '55,90p' engine/gfx/cameras/effects.ts\nsed -n '309,356p' labs/game/main.ts\"","aggregated_output":"import type { CameraInput, CameraPose, Vec3 } from './pose';\n\n/** The view settings the rig reads (see the file comment), as fields; never in the hash. */\nexport const CAMERA_SETTING_FIELDS = {\n  'cam.fov': {\n    type: 'number',\n    default: 90,\n    minimum: 70,\n    maximum: 110,\n    view: true,\n    description: \"The field of view as Apex Legends' slider gives it: horizontal degrees at 4:3 (Apex starts at 70). First person's and the shooter camera's lens. A view setting: never in the hash.\", // prettier-ignore\n  },\n  'cam.blend': {\n    type: 'number',\n    default: BLEND_TIME,\n    minimum: 0,\n    maximum: 2,\n    view: true,\n    description: \"Seconds a live camera switch (the page's key or menu) or a view's turn blends over; 0 cuts. A view setting: never in the hash.\", // prettier-ignore\n  },\n  'cam.effects': {\n    type: 'boolean',\n    default: true,\n    view: true,\n    description: 'The view effects driven by the player (the sprint, the slide, the punch, the bob, the sights): engine/gfx/cameras/effects.ts. A view setting: never in the hash.', // prettier-ignore\n  },\n  'cam.wholeZoom': {\n    type: 'boolean',\n    default: false,\n    view: true,\n    description: \"The classic views zoom in whole steps only (1, 2, 3, 4), so a pixel look's pixels stay square. A view setting: never in the hash.\", // prettier-ignore\n  },\n} as const;\n\n/** The view settings the rig reads, declared on the shared registry. */\nexport const CAMERA_SETTINGS = defineSettings(CAMERA_SETTING_FIELDS);\n\n/** The rig's options (see the file comment). */\nexport interface RigOptions {\n  /** Seconds a live switch blends over (`cam.blend`). */\n  readonly blend?: number;\n  /** The view effects on (`cam.effects`). */\n  readonly effects?: boolean;\n  ease: 0.12,\n  /** The spring (Hz, damping ratio); the kicks' peaks (rad): a landing's per m/s over `from`, at most `max`. */\n  punch: Object.freeze({ frequency: 2.5, damping: 0.6, land: 0.4 * DEG, from: 3, max: 5 * DEG, jump: 1 * DEG, grab: 1.5 * DEG, hit: 1.5 * DEG }), // prettier-ignore\n  /** A dip each `period` s at `run` m/s or faster: `height` down, `side` across. */\n  bob: Object.freeze({ period: 0.4, height: 0.012, side: 0.006, run: 5 }),\n  /** The sights' lens (`fov` degrees at a lens of `at`) and the time to raise them. */\n  ads: Object.freeze({ fov: 55, at: 70, time: 0.25 }),\n  /** Metres of screen shake per m/s of a landing over `from`, and a melee hit's (ours). */\n  shake: Object.freeze({ from: 10, per: 0.004, hit: 0.02 }),\n});\n\n/** The eye's height over the feet on the shooter model, m: Apex's, standing and crouched. */\nexport const CAMERA_EYE = Object.freeze({ stand: 1.524, crouch: 0.8128 });\n\n/** What the effects and the follow cameras read of the player after a sim step: plain data. */\nexport interface CameraPlayer {\n  /** M/s. */\n  readonly velocity: Vec3;\n  readonly grounded: boolean;\n  /** Its eye over its feet, m, on the shooter model (`CAMERA_EYE`, by its duck); absent without the model. */\n  readonly eye?: number;\n  /** The shooter model's mode (`ground`, `air`, `mantle`, `climb`, `zipline`, `ladder`, `skydive`); else by `grounded`. */\n  readonly mode: string;\n  readonly sprinting: boolean;\n  readonly sliding: boolean;\n  /** Its slide's boost is not yet taken back. */\n  readonly boosted: boolean;\n  /** It aims down sights (with weapons, only while one is out). */\n  readonly aiming: boolean;\n  /** The step its last melee hit landed (`melee.hitAt`; −1 or absent: none). */\n  readonly struck?: number;\n  /** With a weapon out (WP 13.20): its burst's kick so far (rad: + up, + left) and its sights' lens (deg at a 70° lens). */ // prettier-ignore\n  readonly recoil?: readonly [number, number];\n  readonly zoom?: number;\n  /** With weapons: the shots it has fired, all told. */\n  readonly shots?: number;\n  soundFrame(f, c, p);\n  const clusters = Object.keys(c.flames)\n    .map(Number)\n    .sort((a, b) => {\n      const ax = (a % 192) * 8,\n        az = Math.floor(a / 192) * 8,\n        bx = (b % 192) * 8,\n        bz = Math.floor(b / 192) * 8;\n      return (\n        Math.hypot(ax - (p?.actor.x ?? 550), az - (p?.actor.z ?? 700)) -\n        Math.hypot(bx - (p?.actor.x ?? 550), bz - (p?.actor.z ?? 700))\n      );\n    })\n    .slice(0, 24);\n  if(c.rain&&p)f.emit('emitter:field-rain',[p.actor.x,p.actor.y+12,p.actor.z],'rain');\n  for (const i of clusters) {\n    const x = ((i % 192) + 0.5) * 8,\n      z = (Math.floor(i / 192) + 0.5) * 8;\n    f.emit(\n      `emitter:smoke-${((Math.round(c.wind / (Math.PI / 4)) % 8) + 8) % 8}`,\n      [x, ground(x, z) + 1, z],\n      `fire-${i}`,\n    );\n  }\n}\nimport { ground } from './scenes/map';\nfunction cameraInput(): CameraInput | undefined {\n  if (director.view) return { view: director.view } as CameraInput;\n  if (ctx.screen !== 'play' || ctx.device !== 'gamepad' || !store.get('assist', true) || !ctx.frame || !ctx.p)\n    return undefined;\n  const pad = [...navigator.getGamepads()].find(Boolean);\n  if (!pad || (Math.abs(pad.axes[2] ?? 0) < 0.1 && Math.abs(pad.axes[3] ?? 0) < 0.1)) return undefined;\n  const yaw = ctx.frame.camera.yaw,\n    p = ctx.p,\n    targets = [...ctx.frame.world.query('actor', 'soldier', 'health')] as unknown as Person[];\n  const nearest = targets\n    .filter((t) => t.health.hp > 0)\n    .map((t) => ({\n      t,\n      d: Math.atan2(\n        Math.sin(Math.atan2(t.actor.x - p.actor.x, t.actor.z - p.actor.z) - yaw),\n        Math.cos(Math.atan2(t.actor.x - p.actor.x, t.actor.z - p.actor.z) - yaw),\n      ),\n    }))\n    .sort((a, b) => Math.abs(a.d) - Math.abs(b.d))[0];\n  if (!nearest || Math.abs(nearest.d) > 0.1) return undefined;\n  return { look: [-nearest.d * 0.035, 0] };\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_182","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/audio-check.ts <<'EOF'\n/** @file Numeric audio verification for the developer: original songs, effects and a real offline Web Audio voice. */\nimport {createAudio,renderSong,renderSfx} from '../../../engine';\nfunction levels(samples:Float32Array):{peak:number;rms:number}{let peak=0,power=0;for(const x of samples){peak=Math.max(peak,Math.abs(x));power+=x*x;}return {peak,rms:Math.sqrt(power/samples.length)};}\nexport async function audioCheck():Promise<object>{\n  const songs=Array.from({length:4},(_,i)=>({id:\"'`song:field-${i}`,...levels(renderSong(`song:field-${i}`,{rate:24000}))}));\n  const effects=['\"'shot','explosion','reload','voice-a','wind'].map(key=>({id:key,...levels(renderSfx(\"'`sfx:field-${key}`,{rate:24000}))}));\n  const context=new OfflineAudioContext(1,12000,24000),audio=createAudio({context});audio.volume('\"'music',0.1);audio.play('sfx:field-voice-a',{bus:'ui',vol:0.7});\n  const rendered=await context.startRendering(),offline=levels(rendered.getChannelData(0));await audio.close();return {songs,effects,offline};\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import { Attract } from './attract';\\\", \\\"import { Attract } from './attract';\\\\nimport {audioCheck} from './ui/audio-check';\\\")\ns=s.replace('  title: TITLE,','  title: TITLE,\\\\n  audioCheck,')\ns=s.replace(\\\"  let cameraCode = ''\\\", \\\"  let cameraCode = ''\\\")\ns=s.replace(\\\"  endingSeen = '',\\\", \\\"  endingSeen = '',\\\\n  feverLook=-1,\\\")\ns=s.replace(\\\"  hud.update();\\\", \\\"  const feverAmount=s?.fever?Number(store.get('feverIntensity',0.7)):0.0001;if(feverLook\"'!==feverAmount&&e){feverLook=feverAmount;e.set('\"'post.combine',[{look:'look:fever',amount:Math.max(0.0001,feverAmount)}]);}\\\\n  hud.update();\\\")\np.write_text(s)\np=Path('labs/game/boot.ts');s=p.read_text().replace(\\\"search.set('post.look', 'look:dry-season');\\\", \\\"search.set('post.look', 'look:dry-season');\\\\n    search.set('post.combine',JSON.stringify([{look:'look:fever',amount:0.0001}]));\\\")\np.write_text(s)\np=Path('labs/game/ui/settings.ts');s=p.read_text().replace(\\\"store.get('cam.fov', 76), 55, 105, 1\\\", \\\"store.get('cam.fov', 76), 70, 110, 1\\\").replace(\\\"v => store.set('shake', v)\\\",\\\"v => {store.set('shake',v);ctx.inspector()?.set('cam.effects',v>0);}\\\")\ns=s.replace(\\\"v) => store.set('shake', v)\\\",\\\"v) => {store.set('shake',v);ctx.inspector()?.set('cam.effects',v>0);}\\\")\np.write_text(s)\nPY\nrg -n 'FOV|Field of view|Screen shake|cam.fov|shake' labs/game/ui/settings.ts\nnode scripts/bundle.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_182","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/audio-check.ts <<'EOF'\n/** @file Numeric audio verification for the developer: original songs, effects and a real offline Web Audio voice. */\nimport {createAudio,renderSong,renderSfx} from '../../../engine';\nfunction levels(samples:Float32Array):{peak:number;rms:number}{let peak=0,power=0;for(const x of samples){peak=Math.max(peak,Math.abs(x));power+=x*x;}return {peak,rms:Math.sqrt(power/samples.length)};}\nexport async function audioCheck():Promise<object>{\n  const songs=Array.from({length:4},(_,i)=>({id:\"'`song:field-${i}`,...levels(renderSong(`song:field-${i}`,{rate:24000}))}));\n  const effects=['\"'shot','explosion','reload','voice-a','wind'].map(key=>({id:key,...levels(renderSfx(\"'`sfx:field-${key}`,{rate:24000}))}));\n  const context=new OfflineAudioContext(1,12000,24000),audio=createAudio({context});audio.volume('\"'music',0.1);audio.play('sfx:field-voice-a',{bus:'ui',vol:0.7});\n  const rendered=await context.startRendering(),offline=levels(rendered.getChannelData(0));await audio.close();return {songs,effects,offline};\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import { Attract } from './attract';\\\", \\\"import { Attract } from './attract';\\\\nimport {audioCheck} from './ui/audio-check';\\\")\ns=s.replace('  title: TITLE,','  title: TITLE,\\\\n  audioCheck,')\ns=s.replace(\\\"  let cameraCode = ''\\\", \\\"  let cameraCode = ''\\\")\ns=s.replace(\\\"  endingSeen = '',\\\", \\\"  endingSeen = '',\\\\n  feverLook=-1,\\\")\ns=s.replace(\\\"  hud.update();\\\", \\\"  const feverAmount=s?.fever?Number(store.get('feverIntensity',0.7)):0.0001;if(feverLook\"'!==feverAmount&&e){feverLook=feverAmount;e.set('\"'post.combine',[{look:'look:fever',amount:Math.max(0.0001,feverAmount)}]);}\\\\n  hud.update();\\\")\np.write_text(s)\np=Path('labs/game/boot.ts');s=p.read_text().replace(\\\"search.set('post.look', 'look:dry-season');\\\", \\\"search.set('post.look', 'look:dry-season');\\\\n    search.set('post.combine',JSON.stringify([{look:'look:fever',amount:0.0001}]));\\\")\np.write_text(s)\np=Path('labs/game/ui/settings.ts');s=p.read_text().replace(\\\"store.get('cam.fov', 76), 55, 105, 1\\\", \\\"store.get('cam.fov', 76), 70, 110, 1\\\").replace(\\\"v => store.set('shake', v)\\\",\\\"v => {store.set('shake',v);ctx.inspector()?.set('cam.effects',v>0);}\\\")\ns=s.replace(\\\"v) => store.set('shake', v)\\\",\\\"v) => {store.set('shake',v);ctx.inspector()?.set('cam.effects',v>0);}\\\")\np.write_text(s)\nPY\nrg -n 'FOV|Field of view|Screen shake|cam.fov|shake' labs/game/ui/settings.ts\nnode scripts/bundle.mjs\"","aggregated_output":"122:    slider(root, 'Field of view', store.get('cam.fov', 76), 70, 110, 1, (v) => live('cam.fov', v));\n124:    slider(root, 'Screen shake', store.get('shake', 0.6), 0, 1, 0.1, (v) => {store.set('shake',v);ctx.inspector()?.set('cam.effects',v>0);});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_183","type":"command_execution","command":"/bin/bash -lc \"cat > tests/game/page.mjs <<'EOF'\n/** @file Browser acceptance: native controls, medical UI, live tools, audio, idle demo and responsive/touch layouts. */\nimport {readFileSync,mkdirSync,writeFileSync} from 'node:fs';\nimport {chromium,webkit,devices} from '@playwright/test';\nimport {args,executablePath,ready,url,virtualPad,pad} from './browser.mjs';\nlet passed=0,failed=0;\nconst check=(name,ok,why='')=>{if(ok)passed++;else{failed++;console.log(\"'`FAIL ${name}${why?'\"': '+String(why).slice(0,300):''}\"'`);}};\nconst run=async(name,fn)=>{try{await fn();}catch(e){check(name,false,e.message);}};\nmkdirSync('\"'out/page',{recursive:true});\nconst browser=await chromium.launch({executablePath,args});\nconst context=await browser.newContext({viewport:{width:1920,height:1080}});await context.addInitScript(virtualPad);\nconst page=await context.newPage(),errors=[];page.on('pageerror',e=>errors.push(String(e)));\nawait run('packaged boot',async()=>{\n await ready(page);check('ready from file',await page.evaluate(()=>window.__engine.ready));check('title name',await page.title()==='Bar Cry');\n check('music initially 10%',await page.evaluate(()=>window.__game.audio.volume('music')===0.1));\n await page.screenshot({path:'out/page/title-desktop.png'});\n});\nawait run('mouse and keyboard route',async()=>{\n await page.getByRole('button',{name:'Co-op',exact:true}).hover();check('hover moves focus',await page.getByRole('button',{name:'Co-op',exact:true}).evaluate(e=>e===document.activeElement));\n await page.getByRole('button',{name:'New game',exact:true}).click();check('merc choice',await page.evaluate(()=>window.__game.screen()==='merc'));\n await page.screenshot({path:'out/page/merc.png'});await page.getByRole('button',{name:'Take the warrant'}).click();\n await page.waitForFunction(()=>window.__game.context.c?.mode==='story',undefined,{timeout:60000});\n check('first-person play',await page.evaluate(()=>window.__game.screen()==='play'));\n const before=await page.evaluate(()=>window.__game.context.p.actor.z);await page.keyboard.down('KeyW');await page.waitForTimeout(700);await page.keyboard.up('KeyW');\n await page.waitForFunction(z=>window.__game.context.p.actor.z\"'!==z,before,{timeout:20000});check('\"'keyboard actually moves',true);\n await page.keyboard.press('Escape');check('keyboard pause',await page.evaluate(()=>window.__game.screen()==='pause'));\n const tick=await page.evaluate(()=>window.__engine.info().tick);await page.waitForTimeout(350);check('pause stops simulation',await page.evaluate(t=>window.__engine.info().tick===t,tick));\n await page.screenshot({path:'out/page/pause.png'});\n});\nawait run('live developer tools',async()=>{\n await page.getByRole('button',{name:'Dev Mode',exact:true}).click();check('dev reachable from pause',await page.evaluate(()=>window.__game.screen()==='dev'));\n const range=page.getByRole('slider',{name:'Wear per shot'});await range.evaluate(el=>{el.value='0.02';el.dispatchEvent(new Event('input',{bubbles:true}));});\n check('live wear slider',await page.evaluate(()=>window.__engine.state('campaign').settings['game.wear.perShot']===0.02));\n await page.getByRole('button',{name:'Reset to defaults',exact:true}).click();check('balance reset',await page.evaluate(()=>window.__engine.state('campaign').settings['game.wear.perShot']===0.0012));\n await page.screenshot({path:'out/page/dev.png'});\n});\nawait run('map remains live and medicine acts in the world',async()=>{\n await page.evaluate(()=>{window.__game.open('play');window.__engine.actions.run('place',{place:'mission'});window.__game.open('map');});\n await page.waitForFunction(()=>window.__game.screen()==='map');const tick=await page.evaluate(()=>window.__engine.info().tick);await page.waitForTimeout(700);\n check('map does not pause',await page.evaluate(t=>window.__engine.info().tick>t,tick));await page.screenshot({path:'out/page/map.png'});\n await page.evaluate(()=>{window.__game.open('map');window.__engine.actions.run('hurt',{hp:12});window.__engine.step(1,{p:['heal']});});\n await page.waitForFunction(()=>window.__game.context.p.seat.data.action.startsWith('surgery'),undefined,{timeout:20000});check('critical press becomes surgery',true);\n await page.screenshot({path:'out/page/medical.png'});\n await page.evaluate(()=>{window.__engine.step(180);window.__game.open('pause');});\n});\nawait run('credits mirror the interview',async()=>{\n const interview=JSON.parse(readFileSync('../exit-interview.json','utf8'));await page.evaluate(()=>window.__game.open('about'));\n const text=await page.locator('[data-screen=\\\"about\\\"]').textContent();for(const value of Object.values(interview.sourceInformation))check('About source value',text.includes(value),value);\n for(const name of ['testingFeedback','engineFeedback','promptFeedback'])for(const value of interview[name])check(\"'`About ${name}`,text.includes(value),value);\n await page.screenshot({path:'\"'out/page/about.png'});\n});\nawait run('synthesized audio',async()=>{\n const report=await page.evaluate(()=>window.__game.audioCheck());writeFileSync('out/page/audio.json',JSON.stringify(report,null,2));\n for(const item of [...report.songs,...report.effects])check('non-silent unclipped '+item.id,item.peak>0.00001&&item.peak<=1.01&&item.rms>0);\n check('offline formant voice',report.offline.peak>0.00001&&report.offline.peak<=1.01);\n});\nawait run('standard-pad menus and glyphs',async()=>{\n await page.evaluate(()=>window.__game.quit?.());await page.evaluate(()=>window.__game.context.quit());\n await pad(page,0);check('pad selects New Game',await page.evaluate(()=>window.__game.screen()==='merc'));\n await pad(page,13);await pad(page,13);await pad(page,0);\n await page.waitForFunction(()=>window.__game.context.c?.mode==='story',undefined,{timeout:60000});\n await pad(page,9);check('pad opens pause',await page.evaluate(()=>window.__game.screen()==='pause'));\n check('PlayStation is default',await page.locator('[data-glyph=\\\"back\\\"]').last().textContent()==='○');\n await page.evaluate(()=>window.__game.open('settings'));await page.locator('[data-next]').click();await page.getByLabel('Button glyphs').selectOption('Xbox');\n await pad(page,12);check('Xbox option',await page.locator('[data-glyph=\\\"back\\\"]').last().textContent()==='B');\n await page.keyboard.press('ArrowDown');check('keyboard glyph returns',await page.locator('[data-glyph=\\\"back\\\"]').last().textContent()==='Esc');\n});\nawait run('volume persists',async()=>{\n await page.evaluate(()=>{window.__game.audio.volume('music',0.22);window.__game.context.store.set('audio.music',0.22);});await ready(page);\n check('stored music volume',await page.evaluate(()=>window.__game.audio.volume('music')===0.22));\n});\nawait run('ten-second idle demo and exits',async()=>{\n await page.evaluate(()=>{window.__engine.set('game.attract','auto');window.__game.attract.last=performance.now();});const begin=Date.now();\n await page.waitForFunction(()=>window.__game.attract.active,undefined,{timeout:22000});check('real ten-second idle',Date.now()-begin>=9500);\n await page.keyboard.press('Space');check('key exits demo',await page.evaluate(()=>\"'!window.__game.attract.active&&window.__game.screen()==='\"'title'));\n await page.evaluate(()=>window.__game.attract.start());await page.mouse.move(800,160);check('pointer exits demo',await page.evaluate(()=>\"'!window.__game.attract.active));\n await page.evaluate(()=>window.__game.attract.start());await pad(page,0);check('\"'pad exits to title',await page.evaluate(()=>\"'!window.__game.attract.active&&window.__game.screen()==='\"'title'));\n await page.evaluate(()=>window.__engine.set('game.attract','off'));\n});\nawait run('tablet and wide-screen visual layout',async()=>{\n for(const [name,width,height] of [['tablet',768,1024],['wide',2560,1080],['small-desktop',1280,720]]){\n  await page.setViewportSize({width,height});await page.waitForTimeout(300);check('no horizontal overflow '+name,await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await page.screenshot({path:\"'`out/page/${name}.png`});\n }\n});\ncheck('\"'no page errors',errors.length===0,errors.join('; '));await context.close();\nawait run('phone notice over a running Chromium world',async()=>{\n const phone=await browser.newContext({...devices['Pixel 7']});const p=await phone.newPage();try{\n  await ready(p,'?game.attract=on');check('exact phone notice',await p.getByRole('heading',{name:'Controller or keyboard required',exact:true}).isVisible());\n  check('phone settings',await p.getByRole('button',{name:'Settings',exact:true}).last().isVisible());\n  await p.waitForFunction(()=>window.__game.attract.active,undefined,{timeout:20000});check('touch attract runs',true);\n  check('no phone overflow',await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await p.screenshot({path:'out/page/phone-chromium.png'});\n  await p.locator('#touch-settings').tap();check('touch can adjust Settings',await p.locator('[data-screen=\\\"settings\\\"]').isVisible());\n }finally{await phone.close();}\n});\nawait browser.close();\nawait run('WebKit small-phone and tablet notice',async()=>{\n const safari=await webkit.launch();try{for(const [name,size] of [['small-phone',{width:375,height:667}],['tablet',{width:768,height:1024}]]){\n  const c=await safari.newContext({viewport:size,isMobile:true,hasTouch:true});const p=await c.newPage();await p.goto(url,{waitUntil:'domcontentloaded'});\n  check('WebKit notice '+name,await p.getByRole('heading',{name:'Controller or keyboard required',exact:true}).isVisible());\n  check('WebKit settings '+name,await p.locator('#touch-settings').isVisible());check('WebKit no overflow '+name,await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));\n  await p.screenshot({path:\"'`out/page/webkit-${name}.png`});await p.locator('\"'#touch-settings').tap();await p.waitForSelector('[data-screen=\\\"settings\\\"]');check('WebKit settings usable '+name,true);await c.close();\n }}finally{await safari.close();}\n});\nconsole.log(\"'`COUNT ${passed} ${failed}`);\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_183","type":"command_execution","command":"/bin/bash -lc \"cat > tests/game/page.mjs <<'EOF'\n/** @file Browser acceptance: native controls, medical UI, live tools, audio, idle demo and responsive/touch layouts. */\nimport {readFileSync,mkdirSync,writeFileSync} from 'node:fs';\nimport {chromium,webkit,devices} from '@playwright/test';\nimport {args,executablePath,ready,url,virtualPad,pad} from './browser.mjs';\nlet passed=0,failed=0;\nconst check=(name,ok,why='')=>{if(ok)passed++;else{failed++;console.log(\"'`FAIL ${name}${why?'\"': '+String(why).slice(0,300):''}\"'`);}};\nconst run=async(name,fn)=>{try{await fn();}catch(e){check(name,false,e.message);}};\nmkdirSync('\"'out/page',{recursive:true});\nconst browser=await chromium.launch({executablePath,args});\nconst context=await browser.newContext({viewport:{width:1920,height:1080}});await context.addInitScript(virtualPad);\nconst page=await context.newPage(),errors=[];page.on('pageerror',e=>errors.push(String(e)));\nawait run('packaged boot',async()=>{\n await ready(page);check('ready from file',await page.evaluate(()=>window.__engine.ready));check('title name',await page.title()==='Bar Cry');\n check('music initially 10%',await page.evaluate(()=>window.__game.audio.volume('music')===0.1));\n await page.screenshot({path:'out/page/title-desktop.png'});\n});\nawait run('mouse and keyboard route',async()=>{\n await page.getByRole('button',{name:'Co-op',exact:true}).hover();check('hover moves focus',await page.getByRole('button',{name:'Co-op',exact:true}).evaluate(e=>e===document.activeElement));\n await page.getByRole('button',{name:'New game',exact:true}).click();check('merc choice',await page.evaluate(()=>window.__game.screen()==='merc'));\n await page.screenshot({path:'out/page/merc.png'});await page.getByRole('button',{name:'Take the warrant'}).click();\n await page.waitForFunction(()=>window.__game.context.c?.mode==='story',undefined,{timeout:60000});\n check('first-person play',await page.evaluate(()=>window.__game.screen()==='play'));\n const before=await page.evaluate(()=>window.__game.context.p.actor.z);await page.keyboard.down('KeyW');await page.waitForTimeout(700);await page.keyboard.up('KeyW');\n await page.waitForFunction(z=>window.__game.context.p.actor.z\"'!==z,before,{timeout:20000});check('\"'keyboard actually moves',true);\n await page.keyboard.press('Escape');check('keyboard pause',await page.evaluate(()=>window.__game.screen()==='pause'));\n const tick=await page.evaluate(()=>window.__engine.info().tick);await page.waitForTimeout(350);check('pause stops simulation',await page.evaluate(t=>window.__engine.info().tick===t,tick));\n await page.screenshot({path:'out/page/pause.png'});\n});\nawait run('live developer tools',async()=>{\n await page.getByRole('button',{name:'Dev Mode',exact:true}).click();check('dev reachable from pause',await page.evaluate(()=>window.__game.screen()==='dev'));\n const range=page.getByRole('slider',{name:'Wear per shot'});await range.evaluate(el=>{el.value='0.02';el.dispatchEvent(new Event('input',{bubbles:true}));});\n check('live wear slider',await page.evaluate(()=>window.__engine.state('campaign').settings['game.wear.perShot']===0.02));\n await page.getByRole('button',{name:'Reset to defaults',exact:true}).click();check('balance reset',await page.evaluate(()=>window.__engine.state('campaign').settings['game.wear.perShot']===0.0012));\n await page.screenshot({path:'out/page/dev.png'});\n});\nawait run('map remains live and medicine acts in the world',async()=>{\n await page.evaluate(()=>{window.__game.open('play');window.__engine.actions.run('place',{place:'mission'});window.__game.open('map');});\n await page.waitForFunction(()=>window.__game.screen()==='map');const tick=await page.evaluate(()=>window.__engine.info().tick);await page.waitForTimeout(700);\n check('map does not pause',await page.evaluate(t=>window.__engine.info().tick>t,tick));await page.screenshot({path:'out/page/map.png'});\n await page.evaluate(()=>{window.__game.open('map');window.__engine.actions.run('hurt',{hp:12});window.__engine.step(1,{p:['heal']});});\n await page.waitForFunction(()=>window.__game.context.p.seat.data.action.startsWith('surgery'),undefined,{timeout:20000});check('critical press becomes surgery',true);\n await page.screenshot({path:'out/page/medical.png'});\n await page.evaluate(()=>{window.__engine.step(180);window.__game.open('pause');});\n});\nawait run('credits mirror the interview',async()=>{\n const interview=JSON.parse(readFileSync('../exit-interview.json','utf8'));await page.evaluate(()=>window.__game.open('about'));\n const text=await page.locator('[data-screen=\\\"about\\\"]').textContent();for(const value of Object.values(interview.sourceInformation))check('About source value',text.includes(value),value);\n for(const name of ['testingFeedback','engineFeedback','promptFeedback'])for(const value of interview[name])check(\"'`About ${name}`,text.includes(value),value);\n await page.screenshot({path:'\"'out/page/about.png'});\n});\nawait run('synthesized audio',async()=>{\n const report=await page.evaluate(()=>window.__game.audioCheck());writeFileSync('out/page/audio.json',JSON.stringify(report,null,2));\n for(const item of [...report.songs,...report.effects])check('non-silent unclipped '+item.id,item.peak>0.00001&&item.peak<=1.01&&item.rms>0);\n check('offline formant voice',report.offline.peak>0.00001&&report.offline.peak<=1.01);\n});\nawait run('standard-pad menus and glyphs',async()=>{\n await page.evaluate(()=>window.__game.quit?.());await page.evaluate(()=>window.__game.context.quit());\n await pad(page,0);check('pad selects New Game',await page.evaluate(()=>window.__game.screen()==='merc'));\n await pad(page,13);await pad(page,13);await pad(page,0);\n await page.waitForFunction(()=>window.__game.context.c?.mode==='story',undefined,{timeout:60000});\n await pad(page,9);check('pad opens pause',await page.evaluate(()=>window.__game.screen()==='pause'));\n check('PlayStation is default',await page.locator('[data-glyph=\\\"back\\\"]').last().textContent()==='○');\n await page.evaluate(()=>window.__game.open('settings'));await page.locator('[data-next]').click();await page.getByLabel('Button glyphs').selectOption('Xbox');\n await pad(page,12);check('Xbox option',await page.locator('[data-glyph=\\\"back\\\"]').last().textContent()==='B');\n await page.keyboard.press('ArrowDown');check('keyboard glyph returns',await page.locator('[data-glyph=\\\"back\\\"]').last().textContent()==='Esc');\n});\nawait run('volume persists',async()=>{\n await page.evaluate(()=>{window.__game.audio.volume('music',0.22);window.__game.context.store.set('audio.music',0.22);});await ready(page);\n check('stored music volume',await page.evaluate(()=>window.__game.audio.volume('music')===0.22));\n});\nawait run('ten-second idle demo and exits',async()=>{\n await page.evaluate(()=>{window.__engine.set('game.attract','auto');window.__game.attract.last=performance.now();});const begin=Date.now();\n await page.waitForFunction(()=>window.__game.attract.active,undefined,{timeout:22000});check('real ten-second idle',Date.now()-begin>=9500);\n await page.keyboard.press('Space');check('key exits demo',await page.evaluate(()=>\"'!window.__game.attract.active&&window.__game.screen()==='\"'title'));\n await page.evaluate(()=>window.__game.attract.start());await page.mouse.move(800,160);check('pointer exits demo',await page.evaluate(()=>\"'!window.__game.attract.active));\n await page.evaluate(()=>window.__game.attract.start());await pad(page,0);check('\"'pad exits to title',await page.evaluate(()=>\"'!window.__game.attract.active&&window.__game.screen()==='\"'title'));\n await page.evaluate(()=>window.__engine.set('game.attract','off'));\n});\nawait run('tablet and wide-screen visual layout',async()=>{\n for(const [name,width,height] of [['tablet',768,1024],['wide',2560,1080],['small-desktop',1280,720]]){\n  await page.setViewportSize({width,height});await page.waitForTimeout(300);check('no horizontal overflow '+name,await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await page.screenshot({path:\"'`out/page/${name}.png`});\n }\n});\ncheck('\"'no page errors',errors.length===0,errors.join('; '));await context.close();\nawait run('phone notice over a running Chromium world',async()=>{\n const phone=await browser.newContext({...devices['Pixel 7']});const p=await phone.newPage();try{\n  await ready(p,'?game.attract=on');check('exact phone notice',await p.getByRole('heading',{name:'Controller or keyboard required',exact:true}).isVisible());\n  check('phone settings',await p.getByRole('button',{name:'Settings',exact:true}).last().isVisible());\n  await p.waitForFunction(()=>window.__game.attract.active,undefined,{timeout:20000});check('touch attract runs',true);\n  check('no phone overflow',await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));await p.screenshot({path:'out/page/phone-chromium.png'});\n  await p.locator('#touch-settings').tap();check('touch can adjust Settings',await p.locator('[data-screen=\\\"settings\\\"]').isVisible());\n }finally{await phone.close();}\n});\nawait browser.close();\nawait run('WebKit small-phone and tablet notice',async()=>{\n const safari=await webkit.launch();try{for(const [name,size] of [['small-phone',{width:375,height:667}],['tablet',{width:768,height:1024}]]){\n  const c=await safari.newContext({viewport:size,isMobile:true,hasTouch:true});const p=await c.newPage();await p.goto(url,{waitUntil:'domcontentloaded'});\n  check('WebKit notice '+name,await p.getByRole('heading',{name:'Controller or keyboard required',exact:true}).isVisible());\n  check('WebKit settings '+name,await p.locator('#touch-settings').isVisible());check('WebKit no overflow '+name,await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));\n  await p.screenshot({path:\"'`out/page/webkit-${name}.png`});await p.locator('\"'#touch-settings').tap();await p.waitForSelector('[data-screen=\\\"settings\\\"]');check('WebKit settings usable '+name,true);await c.close();\n }}finally{await safari.close();}\n});\nconsole.log(\"'`COUNT ${passed} ${failed}`);\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
