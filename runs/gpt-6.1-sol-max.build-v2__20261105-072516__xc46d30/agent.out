{"type":"item.started","item":{"id":"item_271","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,105p' tests/game/hub.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_271","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,105p' tests/game/hub.mjs\"","aggregated_output":"/** @file tests/game/hub.mjs: plays the hub's harness over the deliverable in the four configurations the hub's own test uses, on a port the OS picks. */\nimport { copyFileSync, existsSync, readFileSync } from 'node:fs';\nimport { createServer } from 'node:http';\nimport { basename, extname, join } from 'node:path';\nimport { chromium } from '@playwright/test';\n\nconst RUNS = [\n  'players=2',\n  'players=4&latency=150&jitter=50&loss=5',\n  'players=4&latency=150&jitter=50&loss=5&scenario=host-leave',\n  'players=2&scenario=server',\n];\nconst ARGS = [\n  '--enable-unsafe-webgpu',\n  '--enable-features=Vulkan',\n  '--use-vulkan=swiftshader',\n  '--use-angle=swiftshader',\n  '--use-webgpu-adapter=swiftshader',\n];\ncopyFileSync(`../${basename(process.cwd())}.html`, '.cache/hub/game.html');\nconst types = { '.html': 'text/html', '.js': 'text/javascript' };\nconst server = createServer((request, response) => {\n  const file = join('.cache/hub', new URL(request.url, 'http://x').pathname);\n  if (!existsSync(file)) return response.writeHead(404).end();\n  response.writeHead(200, { 'content-type': types[extname(file)] ?? 'text/plain' }).end(readFileSync(file));\n});\nawait new Promise((listening) => server.listen(0, '127.0.0.1', listening));\nconst origin = `http://127.0.0.1:${server.address().port}`;\nlet [passed, failed] = [0, 0];\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH, args: ARGS });\nconst mine = await (await fetch(`${origin}/game.html`)).text();\nif (!mine.includes('name=\"hub:session\"')) throw new Error('the page served is not this game');\nfor (const run of RUNS) {\n  const page = await browser.newPage({ viewport: { width: 1600, height: 900 } });\n  await page.goto(`${origin}/harness.html?game=game.html&${run}&auto=1`);\n  await page\n    .waitForFunction(() => document.body.dataset.complete === 'true', undefined, { timeout: 170000 })\n    .catch(() => {});\n  const report = await page.evaluate(() => window.__hubCheck ?? { checks: [] });\n  for (const check of report.checks) {\n    if (check.pass) passed += 1;\n    else {\n      failed += 1;\n      console.log(`FAIL ${run}: ${check.name}: ${String(check.detail).slice(0, 200)}`);\n    }\n  }\n  if (!report.pass && !report.checks.some((check) => !check.pass)) {\n    failed += 1;\n    console.log(`FAIL ${run}: the harness never finished`);\n  }\n  await page.close();\n}\nawait browser.close();\nserver.close();\nconsole.log(`COUNT ${passed} ${failed}`);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_272","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/game/hub.mjs');s=p.read_text().replace('copyFileSync, existsSync, readFileSync','copyFileSync, existsSync, readFileSync,mkdirSync,writeFileSync')\ns=s.replace(\\\"for (const run of RUNS) {\\\", \\\"mkdirSync('out/hub',{recursive:true});\\\\ntry {for (const run of RUNS.filter(run=>\"'!process.env.HUB_RUN||run===process.env.HUB_RUN)) {'\"\\\\n  writeFileSync('out/hub/current.json',JSON.stringify({run,phase:'running'}));\\\")\ns=s.replace(\\\"  await page.goto(\"'`${origin}/harness.html?game=game.html&${run}&auto=1`);\", \"  try {await page.goto(`${origin}/harness.html?game=game.html&${run}&auto=1`,{waitUntil:'\"'domcontentloaded'});\\\")\ns=s.replace(\\\"  for (const check of report.checks)\\\", \\\"  writeFileSync(\"'`out/hub/${RUNS.indexOf(run)}.json`,JSON.stringify(report,null,2));'\"\\\\n  for (const check of report.checks)\\\")\ns=s.replace(\\\"  await page.close();\\\\n}\\\\nawait browser.close();\\\\nserver.close();\\\", \\\"  }catch(error){failed++;console.log(\"'`FAIL ${run}: ${error.message.slice(0,200)}`);}'\"\\\\n  await page.close().catch(()=>{});\\\\n}}finally{await browser.close();server.close();}\\\")\np.write_text(s)\nPY\nnpm run format > out/format.log 2>&1\nNODE_OPTIONS=--max-old-space-size=1800 npm run check > out/check.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
