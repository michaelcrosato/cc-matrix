{"type":"item.completed","item":{"id":"item_334","type":"command_execution","command":"/bin/bash -lc \"rg -n 'registry|Registry|createRegistry' engine/index.ts engine/sim-api.ts\nsed -n '1,57p' engine/core/registry.ts\nrg -n 'export interface Kind|export function defineKind|export function def' -A16 engine/core/registry.ts\"","aggregated_output":"engine/sim-api.ts:50:export { defineKind } from './core/registry';\nengine/sim-api.ts:51:export { def } from './core/registry';\nengine/sim-api.ts:52:export type { Entry } from './core/registry';\nengine/sim-api.ts:53:export type { Kind } from './core/registry';\nengine/sim-api.ts:54:export type { KindSpec } from './core/registry';\nengine/sim-api.ts:247:// Props as data (WP 4.5): the registry kind `prop` (meshes by geometry and material id, a body, a light spot, where a\nengine/index.ts:59:// Geometry kit and level meshes (WP 2.4): shapes standing on the ground with UVs in metres, the geometry registry\n/**\n * @file Data-first registries (PLAN.md §6.6, WP 1.2): `defineKind` declares a kind of content with its schema,\n * `def` validates and stores one entry, `get`, `has` and `list` read them, and `describe` lists kinds, fields and\n * ids for `x describe` and `__engine.describe()`. Materials, props, levels, moves, settings, scenes and inspector\n * members are all kinds.\n *\n * Ask the entry, never the id: shared code reads an entry's fields and hooks, each with a default on the kind's\n * schema, and never compares ids (ESLint's `local/ask-the-entry`), so new content works without editing the code that\n * uses it. Ids are strings namespaced by convention (`move:slash`, `prop:crate`; PLAN.md §6.3).\n *\n * Invariants: an entry is the parsed spec (defaults filled, schema.ts) plus `id` and `kind`, a copy frozen all the way\n * down, so neither the spec, the schema's defaults nor a reader can change it. An id is defined once per kind, and\n * stored only once the kind's check passes. A missing id is an error unless the kind names a `fallback` entry: then\n * `get` warns once per id (`CORE_UNKNOWN_ID`, naming the closest ids) and returns the fallback. Both messages name\n * the kind's `defineWith` (`def('<kind>', id, { … })` by default). `list` and `describe` sort by id, so\n * order never depends on import order. A kind's optional `check` adds whole-entry rules beyond its fields.\n * `registry` is the engine's one shared registry (what `x describe` lists); tests make their own with\n * `createRegistry`.\n *\n * Carried from `my-3d2dge:src/emberdeep/00-core.js:76-87` (`REG`, `def`, `reg`), with schemas, fallbacks and codes.\n *\n * @example\n * const reg = createRegistry();\n * const props = reg.defineKind('prop', {\n *   description: 'A movable object in a level.',\n *   fields: { mass: { type: 'number', default: 10, minimum: 0, unit: 'kg', description: 'Its mass.' } },\n *   fallback: 'prop:crate',\n * });\n * props.def('prop:crate', {});\n * reg.def('prop', 'prop:barrel', { mass: 40 });\n * reg.get('prop', 'prop:barrel').mass; // 40\n * props.list().map((prop) => prop.id); // ['prop:barrel', 'prop:crate']\n * reg.describe('prop').ids; // ['prop:barrel', 'prop:crate']\n * @see engine/core/registry.test.ts\n */\nimport { codeError, defineCodes, didYouMean, log as sharedLog, type Log } from './log';\nimport {\n  defineSchema,\n  describeSchema,\n  freezeValue,\n  isPlainObject,\n  listProblems,\n  parse,\n  show,\n  type EntryOf,\n  type FieldRow,\n  type Schema,\n  type SpecOf,\n} from './schema';\n\n/** The codes this module raises, with their fixes. */\nexport const REGISTRY_CODES = defineCodes('core', {\n  CORE_BAD_KIND: {\n    template: 'kind {kind}: {problem}',\n    fix: \"declare each kind once, as defineKind('<kind>', { description, fields, fallback?, check?, defineWith? }), the name a lower-case word (camelCase allowed)\",\n    doc: 'Raised by `defineKind` (engine/core/registry.ts) for a malformed name, a kind declared twice, a missing description, or a key the declaration does not take. Problems inside `fields` raise `CORE_BAD_SCHEMA`.',\n  },\n83:export interface KindSpec<S extends Schema = Schema> {\n84-  /** What the kind is for, in plain sentences. */\n85-  description: string;\n86-  /** Its fields (schema.ts). `id` and `kind` are added to every entry and cannot be fields. */\n87-  fields: S;\n88-  /** The id of the entry `get` returns, after a warning, for a missing id; without it a missing id throws. */\n89-  fallback?: string;\n90-  /** Whole-entry rules beyond the fields: the problems of a parsed entry, as plain sentences ([] when fine). */\n91-  check?: (entry: Entry<S>) => string[];\n92-  /** How a new entry is written, for the missing-id messages: `def('<kind>', '<id>', { … })` when absent. */\n93-  defineWith?: string;\n94-}\n95-\n96-/** A declared kind, bound: the same as the registry's functions with the kind filled in, typed by its schema. */\n97:export interface Kind<S extends Schema = Schema> {\n98-  readonly name: string;\n99-  def(id: string, spec: SpecOf<S>): Entry<S>;\n100-  get(id: string): Entry<S>;\n101-  has(id: string): boolean;\n102-  list(): Entry<S>[];\n103-}\n104-\n105-/** What `describe()` returns: every kind, with its entry count. */\n106:export interface KindsDescription {\n107-  kinds: { kind: string; description: string; count: number; fallback?: string }[];\n108-}\n109-\n110-/** What `describe(kind)` returns: the kind's fields and ids. */\n111:export interface KindDescription {\n112-  kind: string;\n113-  description: string;\n114-  fallback?: string;\n115-  fields: FieldRow[];\n116-  ids: string[];\n117-}\n118-\n119-/** What `describe(kind, id)` returns: each field's value, marked where it differs from the default. */\n120-export interface EntryDescription {\n121-  kind: string;\n122-  id: string;\n123-  fields: { key: string; value: unknown; differs: boolean }[];\n124-}\n125-\n126-/** A set of kinds and their entries. */\n127-export interface Registry {\n--\n314:export function defineKind<const S extends Schema>(kind: string, spec: KindSpec<S>): Kind<S> {\n315-  return registry.defineKind(kind, spec);\n316-}\n317-\n318-/** Defines an entry on the shared registry (`Registry.def`). */\n319:export function def(kind: string, id: string, spec: Record<string, unknown>): Entry {\n320-  return registry.def(kind, id, spec);\n321-}\n322-\n323-/** Reads an entry from the shared registry (`Registry.get`). */\n324-export function get(kind: string, id: string): Entry {\n325-  return registry.get(kind, id);\n326-}\n327-\n328-/** Whether the shared registry's kind has the id (`Registry.has`). */\n329-export function has(kind: string, id: string): boolean {\n330-  return registry.has(kind, id);\n331-}\n332-\n333-/** The shared registry's entries of a kind, sorted by id (`Registry.list`). */\n334-export function list(kind: string): Entry[] {\n335-  return registry.list(kind);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_335","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,28p' labs/game/weapons/guns.ts\nsed -n '173,241p' labs/game/weapons/guns.ts\nsed -n '167,179p' labs/game/scenes/world.ts\nhead -12 labs/game/scenes/world.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_335","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,28p' labs/game/weapons/guns.ts\nsed -n '173,241p' labs/game/weapons/guns.ts\nsed -n '167,179p' labs/game/scenes/world.ts\nhead -12 labs/game/scenes/world.ts\"","aggregated_output":"/** @file Original firearms, with condition tiers and three visible reload poses for the engine's first-person rig. */\nimport { defineWeapon, defineProp, type PropPart } from '../../../engine/sim-api';\nimport { box, cone } from '../props/kit';\n\nexport const GUNS = [\n  {\n    key: 'pistol',\n    name: 'Mle. 50',\n    slot: 0,\n    damage: 18,\n    rate: 5,\n    mag: 8,\n    wear: 1,\n    jam: 1,\n    price: 5,\n    auto: false,\n    kind: 'bullet',\n  },\n  {\n    key: 'revolver',\n    name: 'Veteran .38',\n    slot: 0,\n    damage: 34,\n    rate: 2,\n    mag: 6,\n    wear: 0.5,\n    jam: 0,\n    price: 8,\n  ])\n    for (let pose = 0; pose < 4; pose++) {\n      const long = g.slot > 0,\n        length = long ? 0.72 : 0.22;\n      let parts = [\n        box('grip', [0.038, 0.12, 0.05], [0, -0.09, 0], '#302c22', [0.2, 0, 0]),\n        box('receiver', [0.06, 0.075, length * 0.45], [0, 0.015, length * 0.2], tint),\n        cone('barrel', g.kind === 'rocket' ? 0.065 : 0.014, length * 0.52, [0, 0.055, length * 0.4], tint, undefined, [\n          Math.PI / 2,\n          0,\n          0,\n        ]),\n        box('rear-sight', [0.028, 0.016, 0.024], [0, 0.09, 0.005], '#171b1b'),\n        box('front-sight', [0.008, 0.033, 0.012], [0, 0.065, length * 0.82], '#1b2221'),\n      ];\n      if (long)\n        parts.push(\n          box('stock', [0.045, 0.09, 0.23], [0, -0.015, -0.18], '#685037'),\n          box('handguard', [0.065, 0.065, 0.22], [0, 0.01, 0.28], '#71533a'),\n        );\n      if (pose !== 2) parts.push(box('magazine', [0.036, 0.15, 0.07], [0, -0.13, 0.12], tint, [-0.2, 0, 0]));\n      if (g.key === 'revolver')\n        parts.push(cone('cylinder', 0.035, 0.06, [0, 0.025, 0.055], tint, undefined, [Math.PI / 2, 0, 0]));\n      if (g.key === 'hunter')\n        parts.push(cone('scope', 0.032, 0.22, [0, 0.13, 0.03], '#252a27', undefined, [Math.PI / 2, 0, 0]));\n      if (g.key === 'sprayer') parts.push(cone('fuel-can', 0.085, 0.18, [0, -0.16, 0.25], '#aa7839'));\n      if (g.key === 'coach')\n        parts.push(cone('second-barrel', 0.02, 0.21, [0.032, 0.055, 0.08], tint, undefined, [Math.PI / 2, 0, 0]));\n      if (g.key === 'whisper')\n        parts.push(cone('suppressor', 0.028, 0.25, [0, 0.055, 0.57], '#292e2a', undefined, [Math.PI / 2, 0, 0]));\n      if (pose)\n        parts = parts.map((p) => ({\n          ...p,\n          position: [\n            p.position![0] + (pose === 2 ? 0.07 : 0),\n            p.position![1] - 0.07 * pose,\n            p.position![2] - 0.055 * pose,\n          ],\n          rotation: [(p.rotation?.[0] ?? 0) - 0.22 * pose, ...(p.rotation ?? [0, 0, 0]).slice(1)],\n        }));\n      const id = `${g.key}-${tier}-${pose}`;\n      const geometry = `geometry:field-gun-${g.key}-${pose}`;\n      if (!GUN_MESHES[geometry]) GUN_MESHES[geometry] = parts;\n      defineProp(`prop:gun-${id}`, {\n        description: `${g.name}, ${tier}, hand pose ${pose}.`,\n        parts: [{ name: 'assembled', geometry, material: 'material:field-gun', tint }],\n        body: { type: 'none' },\n      });\n      defineWeapon(`weapon:${id}`, {\n        rate: g.rate,\n        auto: g.auto,\n        damage: g.damage,\n        range: g.key === 'hunter' ? 240 : 140,\n        magazine: g.mag,\n        spread: { hip: g.kind === 'shotgun' ? 3 : 1.5, move: 1.6, ads: g.key === 'hunter' ? 0.01 : 0.15 },\n        recoil: [[g.slot ? 0.45 : 1, 0.08]],\n        reload: { tactical: long ? 2.2 : 1.4, empty: long ? 2.8 : 1.8 },\n        zoom: g.key === 'hunter' ? 25 : 58,\n        sights: 0.18,\n        draw: 0.28,\n        muzzle: [0, 0.055, length * 0.92],\n        prop: `prop:gun-${id}`,\n        sound: 'sfx:field-shot',\n      });\n    }\n    ending: '',\n    save: 0,\n    survival: 0,\n    run: 0,\n    started: 0,\n    extracted: [],\n  };\n}\nfunction setup(w: GW): void {\n  addSiteBodies(physicsOf(w), SITE);\n  const c = fresh(w),\n    start = c.mode === 'contract' ? [1010, 475] : c.mode === 'title' ? [535, 708] : [300, 882];\n  for (let n = 0; n < w.settings.get<number>('game.seats'); n++) spawnMerc(w, n, start[0] + n * 2.5, start[1]);\n/** @file The complete basin. Scene modes share one simulation so story, attract and co-op use the same mechanics. */\nimport {\n  defineScene,\n  addSiteBodies,\n  physicsOf,\n  entityOfBody,\n  Vector3,\n  addRagdolls,\n  handOff,\n  actOn,\n  standUp,\n  removeProp,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_336","type":"agent_message","text":"The hub test found that its `aihub` URL flag was reaching the engine’s strict settings parser. That’s fixed. Two simultaneous renderers then hit memory pressure, so I’m limiting Contract Run’s asset registration to its used loadouts while keeping the full story catalogue.\n"}}
