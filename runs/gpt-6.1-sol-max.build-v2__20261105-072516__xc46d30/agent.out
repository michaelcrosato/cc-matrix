{"type":"item.completed","item":{"id":"item_212","type":"command_execution","command":"/bin/bash -lc \"sed -n '22,82p' labs/game/ui/map.ts\nsed -n '105,149p' labs/game/ui/controls.ts\nsed -n '330,368p' labs/game/main.ts\"","aggregated_output":"  '<svg class=\"hand\" viewBox=\"0 0 100 200\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M8 200L8 110Q0 85 12 65L30 22Q34 9 43 17L39 59L50 7Q57-3 64 10L60 59L70 14Q79 9 82 22L76 70L85 39Q96 34 95 50L88 105Q92 123 85 139L79 200Z\"/><path stroke=\"#443821\" opacity=\".5\" fill=\"none\" d=\"M21 94Q50 80 74 96M27 111Q47 100 73 112\"/></svg>';\nexport function makeMap(ctx: Context): { update: () => void; root: HTMLElement } {\n  const root = document.createElement('div');\n  root.className = 'map-in-hands';\n  root.dataset.screen = 'map';\n  root.hidden = true;\n  root.innerHTML = `<div class=\"paper\"><div class=\"map-heading\"><span>REPUBLIC OF THE BASIN</span><b>SURVEY No. 06</b></div><svg class=\"map-svg\" viewBox=\"0 0 1536 1536\"><rect width=\"1536\" height=\"1536\" fill=\"#d7c89f\"/><g class=\"contours\">${contour}</g><path d=\"M0 900C300 885 450 928 700 902S1200 900 1536 906\" stroke=\"#809c9a\" stroke-width=\"44\" fill=\"none\"/><g class=\"map-roads\">${roads}</g><g class=\"map-burns\"></g><g class=\"map-places\"></g><g class=\"map-goal\"></g><g class=\"map-player\"><path d=\"M0 -17L10 13L0 7L-10 13Z\" fill=\"#a3432f\"/></g><g class=\"map-waypoint\"></g><text x=\"92\" y=\"100\" font-size=\"50\" fill=\"#625b40\">N ↑</text></svg><div class=\"map-caption\">4 m survey · Pencil marks are your responsibility.</div>${hand}${hand}<div class=\"tick-box\"><small>LOCATOR</small><i></i><span>◴</span></div></div>`;\n  document.body.append(root);\n  let waypoint: [number, number] | null = null,\n    lastTick = -999,\n    label: Label | null = null;\n  root.querySelector('svg.map-svg')!.addEventListener('click', (event) => {\n    const e = event as MouseEvent,\n      rect = (e.currentTarget as Element).getBoundingClientRect();\n    waypoint = [((e.clientX - rect.left) / rect.width) * 1536, ((e.clientY - rect.top) / rect.height) * 1536];\n    root.querySelector('.map-waypoint')!.innerHTML =\n      `<path d=\"M${waypoint[0] - 10} ${waypoint[1]}h20m-10 -10v20\" stroke=\"#a3432f\" stroke-width=\"4\"/>`;\n  });\n  return {\n    root,\n    update() {\n      const c = ctx.c,\n        p = ctx.p,\n        s = p?.seat?.data;\n      root.hidden = !s?.map || ctx.screen !== 'play';\n      if (!c || !p || !s) return;\n      root.classList.toggle('driving', s.vehicle >= 0);\n      if (root.hidden) return;\n      (root.querySelector('.map-player') as SVGElement).setAttribute(\n        'transform',\n        `translate(${p.actor.x} ${p.actor.z}) rotate(${(-p.actor.yaw * 180) / Math.PI + 180})`,\n      );\n      if (waypoint && ctx.engine?.ui) {\n        if (!label) label = ctx.engine.ui.label('', { id: 'waypoint', at: [0, 0, 0] });\n        label.text = `Waypoint · ${Math.round(Math.hypot(p.actor.x - waypoint[0], p.actor.z - waypoint[1]))} m`;\n        label.at = [waypoint[0], ground(...waypoint) + 2, waypoint[1]];\n      }\n      if (ctx.frame!.world.tick - lastTick < 30) return;\n      lastTick = ctx.frame!.world.tick;\n      root.querySelector('.map-places')!.innerHTML = PLACES.filter((site) => c.discovered.includes(site.id))\n        .map(\n          (site) =>\n            `<circle cx=\"${site.x}\" cy=\"${site.z}\" r=\"10\" fill=\"#514c37\"/><text x=\"${site.x + 16}\" y=\"${site.z + 7}\" font-size=\"23\" fill=\"#3e493c\">${escape(site.name)}</text>`,\n        )\n        .join('');\n      const step = CONTRACTS[c.contract]?.steps[c.step],\n        at = step?.at;\n      root.querySelector('.map-goal')!.innerHTML = at\n        ? `<circle cx=\"${at[0]}\" cy=\"${at[1]}\" r=\"24\" stroke=\"#a3432f\" stroke-width=\"5\" fill=\"none\"/>`\n        : '';\n      root.querySelector('.map-burns')!.innerHTML = c.fire\n        .map((f, i) =>\n          f >= 2\n            ? `<rect x=\"${(i % 192) * 8}\" y=\"${Math.floor(i / 192) * 8}\" width=\"8\" height=\"8\" fill=\"${f === 2 ? '#b5582f' : '#554a37'}\" opacity=\".65\"/>`\n            : '',\n        )\n        .join('');\n      root.querySelector('.tick-box i')!.classList.toggle('lit', s.locator);\n    },\n  };\n}\n    document.activeElement?.scrollIntoView({ block: 'nearest' });\n  };\n  const key = (e: KeyboardEvent) => {\n    const wasAttract = ctx.screen === 'attract';\n    onActivity();\n    if (wasAttract) {\n      e.preventDefault();\n      return;\n    }\n    ctx.device = 'keyboard';\n    refreshGlyphs(ctx);\n    if ((e.target as HTMLElement)?.matches('input,textarea,select') && e.code !== 'Escape') return;\n    if (e.code === 'Escape') {\n      e.preventDefault();\n      ctx.back();\n      return;\n    }\n    if (ctx.screen === 'play' || ctx.screen === 'attract') return;\n    if (['ArrowDown', 'ArrowUp'].includes(e.code)) {\n      e.preventDefault();\n      move(e.code === 'ArrowDown' ? 1 : -1);\n    }\n    if (e.code === 'Enter' && document.activeElement === document.body) items()[0]?.click();\n  };\n  addEventListener('keydown', key);\n  const pointer = (e: PointerEvent) => {\n    if (e.pointerType !== 'touch') {\n      ctx.device = 'keyboard';\n      onActivity();\n      refreshGlyphs(ctx);\n    }\n  };\n  addEventListener('pointermove', pointer);\n  addEventListener('pointerdown', pointer);\n  const timer = setInterval(() => {\n    const p = [...navigator.getGamepads()].find(Boolean);\n    if (!p) return;\n    const b = p.buttons.map((x) => x.pressed),\n      axis = p.axes[1] ?? 0,\n      active = b.some(Boolean) || p.axes.some((a) => Math.abs(a) > 0.25);\n    const wasAttract = ctx.screen === 'attract';\n    if (active) {\n      ctx.device = 'gamepad';\n      onActivity();\n      document.getElementById('touch-notice')?.classList.add('dismissed');\n    e.set('post.combine', [{ look: 'look:fever', amount: Math.max(0.0001, feverAmount) }]);\n  }\n  hud.update();\n  map.update();\n  soundFrame(f, c, p);\n  const clusters = Object.keys(c.flames)\n    .map(Number)\n    .sort((a, b) => {\n      const ax = (a % 192) * 8,\n        az = Math.floor(a / 192) * 8,\n        bx = (b % 192) * 8,\n        bz = Math.floor(b / 192) * 8;\n      return (\n        Math.hypot(ax - (p?.actor.x ?? 550), az - (p?.actor.z ?? 700)) -\n        Math.hypot(bx - (p?.actor.x ?? 550), bz - (p?.actor.z ?? 700))\n      );\n    })\n    .slice(0, 24);\n  if (c.rain && p) f.emit('emitter:field-rain', [p.actor.x, p.actor.y + 12, p.actor.z], 'rain');\n  for (const i of clusters) {\n    const x = ((i % 192) + 0.5) * 8,\n      z = (Math.floor(i / 192) + 0.5) * 8;\n    f.emit(\n      `emitter:smoke-${((Math.round(c.wind / (Math.PI / 4)) % 8) + 8) % 8}`,\n      [x, ground(x, z) + 1, z],\n      `fire-${i}`,\n    );\n  }\n}\nimport { ground } from './scenes/map';\nconst cameraInput = (): CameraInput | undefined => aimInput(ctx, director.view);\n\nconst gameAPI = {\n  title: TITLE,\n  audioCheck,\n  audio,\n  screen: () => (ctx.p?.seat?.data.map && ctx.screen === 'play' ? 'map' : ctx.screen),\n  open: (name: string) => ctx.open(name),\n  start: (mode = 'story', merc = 0) => ctx.start(mode, merc),\n","exit_code":0,"status":"completed"}}
