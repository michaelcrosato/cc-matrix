{"type":"item.completed","item":{"id":"item_139","type":"command_execution","command":"/bin/bash -lc \"rg -l 'list.*weapon|entries\\\\(.*weapon|\\\\.list\\\\(.*weapon|weaponKinds|buildPropPart' engine/gfx/first* engine/gfx/weapons* engine/gfx/puppets/*.ts\nrg -n 'getWeapon|registry|for \\\\(' engine/gfx/firstPerson*.ts engine/gfx/weapons*.ts | head -40\nsed -n '1,105p' engine/gfx/puppets/bodies/quadruped.ts\"","aggregated_output":"rg: engine/gfx/first*: No such file or directory (os error 2)\nengine/gfx/weapons.ts\nrg: engine/gfx/firstPerson*.ts: No such file or directory (os error 2)\nengine/gfx/weapons.ts:50:import { registry as sharedRegistry, type Registry } from '../core/registry';\nengine/gfx/weapons.ts:53:import { getWeapon, type WeaponKind } from '../world/weapons';\nengine/gfx/weapons.ts:73:/** The weapon `entity`'s component `weapons` has out (its kind, of `registry`), or null: holstered, or no weapons. */\nengine/gfx/weapons.ts:74:export function weaponOut(entity: EntityData, registry: Registry = sharedRegistry): WeaponKind | null {\nengine/gfx/weapons.ts:78:  return typeof id === 'string' ? getWeapon(id, registry) : null;\nengine/gfx/weapons.ts:120:export function gunGeometry(kind: WeaponKind, registry: Registry = sharedRegistry): BufferGeometry | null {\nengine/gfx/weapons.ts:122:  const parts = getProp(kind.prop, registry).parts.map((part) => {\nengine/gfx/weapons.ts:123:    const geometry = buildPropPart(part, registry).applyMatrix4(partMatrix(part));\nengine/gfx/weapons.ts:124:    for (const name of Object.keys(geometry.attributes)) if (name !== 'position' && name !== 'normal') geometry.deleteAttribute(name); // prettier-ignore\nengine/gfx/weapons.ts:126:    const [tint, base] = [toLinear(part.tint), toLinear(getMaterial(part.material, registry).color)];\nengine/gfx/weapons.ts:128:    for (let i = 0; i < color.length; i++) color[i] = tint[i % 3] * base[i % 3];\nengine/gfx/weapons.ts:132:  for (const part of parts) part.dispose();\nengine/gfx/weapons.ts:201:      for (const record of trace) {\nengine/gfx/weapons.ts:213:      for (let i = live.length - 1; i >= 0; i--) {\nengine/gfx/weapons.ts:218:      for (const t of live) {\nengine/gfx/weapons.ts:226:      for (const hole of kept) holes.add(hole.elements, holeTint);\n/**\n * @file The quadruped body (PLAN.md WP 13.21; docs/PLAYGROUND.md §7.4): what a quadruped rig (engine/anim/quadruped.ts)\n * wears, as data, in the rig-body form `createCrowd` draws (engine/gfx/puppets/crowd.ts, `RigBody`): the dog. Every\n * part is a ball, an ellipsoid or a cone on one of the rig's joints:\n * - **The torso** on `torso`: a deep chest and the hips, a barrel between them (a tucked waist), a pale belly under\n *   it and a pale patch on its chest.\n * - **The neck** along its bone, **the head** on `head`: its skull, the snout in two (wide at its base, narrow at its\n *   nose) and the dark nose, two dark eyes, and the ears on `earL` and `earR`, flat cones.\n * - **The legs** along their bones, thick at the top and thinner to the paw (the hind thigh thickest); a ball on each\n *   paw; **the tail** along its three links, the last pale.\n * A blob shadow under its torso. The colours are Biscuit's (the town dog's coat, skin and pale patches), its eyes\n * and nose the quadruped preset's.\n *\n * Invariants: data, built once; every slot a part names is in `slots`; sizes in metres (the bones' `stretch` parts in\n * their bone's units: a bone's matrix is scaled by its length along +Y, so 0.5 reaches each end).\n *\n * Carried from shardfall@fa2dab6 `crates/pav_core/src/rig.rs:560-571` (the legs: thick at the top, a paw) and\n * `:651-677` (the chest, the waist, the belly, the neck, the head, the snout, the nose, the ears, the eyes), with\n * the colours of `crates/pav_core/src/arpg/scene.rs:974-981` (Biscuit) and `puppet.rs:318-333`; the capsules there\n * are ellipsoids and balls here.\n *\n * @example\n * QUADRUPED_BODY.parts.filter((part) => part.on === 'head').length; // 6: the s