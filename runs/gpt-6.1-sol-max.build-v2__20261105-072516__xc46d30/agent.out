 [0, 1] }],\n    [121, { \"move\": [0.38, 0.92] }],\n    [123, { \"move\": [0, 1] }],\n    [124, { \"move\": [0.38, 0.92] }],\n    [125, { \"move\": [0, 1] }],\n    [126, { \"move\": [0.38, 0.92] }],\n    [127, { \"move\": [0, 1] }],\n    [128, { \"move\": [0.38, 0.92] }],\n    [129, { \"move\": [0, 1] }],\n    [130, { \"move\": [0.38, 0.92] }],\n\n> bar-cry@0.0.0 typecheck\n> tsc -b tsconfig.check.json\n\n9: * the advice trap first (tests/setup/adviceTrap.ts), and `vitest --changed` reruns everything on the files that\n18: * `vitest/config`, which adds `test` to Vite's config type, is kept in the declaration tsc -b emits (`preserve`), so\n23:/// <reference types=\"vitest/config\" preserve=\"true\" />\n28:import { vitestRerunTriggers } from './tools/lib/tiers';\n98:    maxWorkers: availableParallelism(),\n99:    forceRerunTriggers: vitestRerunTriggers(),\n","exit_code":0,"status":"completed"}}
