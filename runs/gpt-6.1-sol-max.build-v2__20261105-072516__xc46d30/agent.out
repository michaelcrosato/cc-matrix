{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"sed -n '35,145p' engine/gfx/fx/emitters.ts\nrg -n 'SCENE_PROP_FIELDS|q:' -A32 engine/sim/props.ts | head -45\nrg -n 'texture:' engine/gfx/materials/material.ts\nsed -n '164,190p' engine/physics/movement/model.ts\"","aggregated_output":"import { toLinear } from '../../core/color';\nimport { galleryField } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport type { Schema } from '../../core/schema';\nimport { BUILT_IN_EMITTERS } from './presets';\n\n/** A vector field, three numbers. */\nconst vec3 = (description: string, unit: string, value: readonly number[] = [0, 0, 0]) =>\n  ({ type: 'array', items: { type: 'number' }, default: value, unit, description }) as const;\n\n/** A pair of numbers. */\nconst pair = (value: readonly number[], description: string, unit?: string, minimum = 0) =>\n  ({\n    type: 'array',\n    items: { type: 'number', minimum },\n    default: value,\n    ...(unit ? { unit } : {}),\n    description,\n  }) as const;\n\n/** A number at least 0. */\nconst amount = (value: number, unit: string, description: string, maximum?: number) =>\n  ({\n    type: 'number',\n    default: value,\n    minimum: 0,\n    ...(maximum === undefined ? {} : { maximum }),\n    ...(unit ? { unit } : {}),\n    description,\n  }) as const;\n\n/** The defaults of an object field's properties. */\nconst defaultsOf = (properties: Schema): Record<string, unknown> =>\n  Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\n\n/** How particles start, move and look: an emitter's own fields, and what a layer may change (`set`). */\nexport const PARTICLE_FIELDS = {\n  area: vec3('Half extents of the box particles start in, around where it bursts.', 'm'),\n  velocity: vec3(\"Every particle's starting velocity.\", 'm/s'),\n  spread: amount(1, 'm/s', 'Random extra speed in any direction, up to this.'),\n  gravity: { type: 'number', default: 0, unit: 'm/s²', description: 'Pulls particles down; below 0 they rise.' },\n  drag: amount(0, '1/s', 'Slows them: the share of their speed lost per second.'),\n  turbulence: amount(0, 'm/s²', 'Swirls them (smoke, fireflies).'),\n  life: pair([1, 1.5], 'The shortest and longest a particle lives.', 's'),\n  size: pair([0.1, 0], 'Its radius at birth and at death.', 'm'),\n  color: {\n    type: 'array',\n    items: { type: 'string' },\n    default: ['#ffffff', '#ffffff'],\n    description: 'Its colour at birth and at death, hex.',\n  },\n  brightness: pair([1, 1], 'What each colour is multiplied by, linear: above 1 it glows (with bloom, WP 7.4).'),\n  alpha: pair([1, 0], 'Its opacity at birth and at death, 0 to 1.'),\n  additive: { type: 'boolean', default: true, description: 'Adds light (fire, sparks, magic) instead of covering.' },\n  stretch: { type: 'boolean', default: false, description: 'Streaks along its velocity (sparks, rain).' },\n  lands: { type: 'boolean', default: false, description: 'Lands on the floor and bounces: see floor.' },\n  floor: {\n    type: 'number',\n    default: 0,\n    unit: 'm',\n    description: \"The floor's height above the ground the burst names (else where it bursts), when it lands.\",\n  },\n  bounce: amount(0.3, '', 'How much of its fall speed a landing keeps, 0 to 1.', 1),\n  prewarm: amount(0, 's', 'Born as if emitted over the last this many seconds, so a new emitter starts in full swing.'),\n} as const satisfies Schema;\n\n/** One layer: another emitter bursting with this one. */\nconst LAYER_FIELDS = {\n  emitter: { type: 'string', default: 'emitter:sparks', description: \"The other emitter's id.\" },\n  count: { type: 'integer', default: 0, minimum: 0, description: 'Its particles per burst.' },\n  offset: vec3('Where it bursts, from where this one does.', 'm'),\n  set: { type: 'object', default: {}, description: 'Particle fields it changes for this layer (spread, life…).' },\n} as const satisfies Schema;\n\n/** A floor ring that grows and fades with a burst (a shockwave). */\nconst RING_FIELDS = {\n  radius: pair([0, 0], 'Its radius as it starts and as it ends; 0 and 0 for none.', 'm'),\n  width: amount(0.1, 'm', 'How wide its band is.'),\n  color: { type: 'string', default: '#ffe0a0', description: 'Its colour, hex.' },\n  alpha: amount(1, '', 'Its opacity as it starts; it fades to nothing.', 1),\n  life: amount(0.35, 's', 'How long it lasts.'),\n} as const satisfies Schema;\n\n/** The light a running emitter gives, flickering and pulsing. */\nconst LIGHT_FIELDS = {\n  color: { type: 'string', default: '#ffffff', description: 'Its colour, hex.' },\n  intensity: amount(0, '', \"Its intensity, three.js's; 0 for none.\"),\n  distance: amount(0, 'm', 'Where it fades out; 0 for no limit.'),\n  offset: vec3('Where it shines from, from the emitter.', 'm'),\n  flicker: amount(0, '', 'How much it flickers, 0 to 1 (a flame about 0.6).', 1),\n  pulse: amount(0, 'Hz', 'How fast it swells and fades; 0 for steady.'),\n} as const satisfies Schema;\n\n/** The fields of an `emitter` entry. */\nexport const EMITTER_FIELDS = {\n  description: { type: 'string', default: '', description: 'What it is, in plain sentences.' },\n  ...PARTICLE_FIELDS,\n  count: { type: 'integer', default: 0, minimum: 0, description: 'Its own particles per burst.' },\n  rate: amount(0, '1/s', 'Particles per second while it runs (effects.emit).'),\n  offset: vec3('Where it bursts or runs, from the point given.', 'm'),\n  layers: {\n    type: 'array',\n    items: { type: 'object', properties: LAYER_FIELDS },\n    default: [],\n    description: 'Other emitters bursting with it: { emitter, count, offset, set }.',\n  },\n  events: {\n    type: 'array',\n    items: { type: 'string' },\n    default: [],\n    description: \"The event types it bursts at (effects.event): 'hit', 'explosion'…\",\n37: * // after a step: w.get(id).sceneProp is { prop: 'prop:crate', body, x: 2, y: 0.375, z: 3, q: [0, 0.198…, 0, 0.980…] }\n38- * // hitProp(w, id, [1, 0, 3], { spin: w.rng('knock').range(-0.5, 0.5) }); // knocked east\n39- * @see engine/sim/props.test.ts\n40- */\n41-import type { EventMap } from '../core/events';\n42-import { codeError } from '../core/log';\n43-import { registry as sharedRegistry, type Registry } from '../core/registry';\n44-import { knock } from '../physics/bodies';\n45-import { physicsOf } from '../physics/binding';\n46-import { propBody, propPose, type PropPlacement } from '../world/props/place';\n47-import { getProp, type PropKnock } from '../world/props/prop';\n48-import { defineComponent } from './state';\n49-import type { World } from './world';\n50-\n51-/** The component `sceneProp`'s fields. */\n52:export const SCENE_PROP_FIELDS = {\n53-  prop: { type: 'string', default: 'prop:crate', description: 'The prop it is, by id (engine/world/props).' },\n54-  body: { type: 'integer', default: -1, minimum: -1, description: 'Its body in the physics world; −1: none.' },\n55-  x: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, east: its body’s origin.' },\n56-  y: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, up.' },\n57-  z: { type: 'number', default: 0, unit: 'm', description: 'Where its centre is, south.' },\n58:  q: {\n59-    type: 'array',\n60-    items: { type: 'number' },\n61-    default: [0, 0, 0, 1],\n62-    description: 'Its turn, a unit quaternion [x, y, z, w].',\n63-  },\n64-} as const;\n65-\n66-/** The component `sceneProp`: a prop standing in a scene. */\n67-export interface ScenePropComponent {\n68-  prop: string;\n69-  body: number;\n70-  x: number;\n71-  y: number;\n72-  z: number;\n73:  q: [number, number, number, number];\n74-}\n75-\n76-/** The component `propHealth` (WP 13.16): the hit points a breakable prop has left, spawned only on one with health. */\n77-export interface PropHealthComponent {\n78-  hp: number;\n79-}\n80-\n81-/** The component `propLight` (WP 13.16): a switchable prop's state, spawned only on one given a group or off. */\n10: * `map` names a texture generator (engine/gfx/textures/texture.ts): an id (`'texture:brick'`) or\n26: * defineMaterial('material:mossyBrick', { color: '#c8d8b0', map: { texture: 'texture:brick', seed: 4 } }, reg);\n28: * textureRefOf(reg.get('material', 'material:mossyBrick').map); // { texture: 'texture:brick', seed: 4, … }\n52:      \"The texture generator that fills the maps: a texture id ('texture:brick'), or { texture, seed, params, size, look, repeat }; null for none. Its height becomes the normal map, its roughness the roughness map, its emissive the emissive map.\",\n122:  texture: string;\n139:  const given = (typeof map === 'string' ? { texture: map } : map) as Partial<MapRef>;\n141:    throw new TypeError(\"a map is a texture id ('texture:brick') or { texture, seed, params, size, look, repeat }\");\n144:    texture: given.texture,\n155:  return { texture: ref.texture, seed: ref.seed, params: ref.params, ...(ref.size ? { size: ref.size } : {}) };\n218:    defineWith: \"defineMaterial('<id>', { color: '#…', map: 'texture:…', … })\",\n  mantle: group('The mantle (the Apex Movement Wiki’s measures, and er-apex’s ledge test): a grab, then a pull.', {\n    reach: num(2.4892, 0, 20, 'The highest ledge it mantles from the air, its lip above the feet: the highest a climb reaches less its cutoff and end boost (273 − 147 − 28), 98 u.', 'm'), // prettier-ignore\n    auto: num(2.032, 0, 20, 'Holding jump on the ground, the highest ledge it mantles without leaving the ground: 80 u.', 'm'), // prettier-ignore\n    probe: num(0.6096, 0, 10, 'How far ahead of its hull it finds the wall: 24 u.', 'm'),\n    angle: num(50 * DEG, 0, Math.PI, 'Its move and its view within this of the wall, facing it.', 'rad'),\n    low: num(1.0668, 0, 20, 'A ledge this low over the feet or lower is pulled over with no grab: 42 u.', 'm'),\n    grab: num(0.45, 0, 5, 'The grab: up to the lip, hands on it (out of a climb, measured).', 's'),\n    pull: num(0.3, 0, 5, 'The pull over the lip onto the top (contested: 0.45 s).', 's'),\n    hang: num(1.524, 0, 20, 'Letting go of forward in the grab hangs if the lip stands this high over the ground below: 60 u.', 'm'), // prettier-ignore\n    cooldown: num(0.25, 0, 5, 'No mantle within this of the last one’s end.', 's'),\n    window: num(0.15, 0, 5, 'The pull’s last part, when a superglide or a mantle boost takes.', 's'),\n    glide: num(1.8, 0, 10, 'A superglide’s speed, times the speed it mantled at: +80% over the holstered sprint.'),\n    glideJump: num(1.27, 0, 100, 'Ours: a superglide’s rise, the slide-jump’s.', 'm'),\n    boost: { type: 'boolean', default: false, description: 'The mantle boost: a crouch press in the window glides too, rising a full jump, with no cooldown of its own (it starts the slide boost’s).' }, // prettier-ignore\n  }),\n  climb: group('The wall-climb (the Apex Movement Wiki’s climb fundamentals): up a steep wall, in the air.', {\n    angle: num(Math.acos(0.7), 0, Math.PI / 2, 'Walls steeper than this (a normal under 0.7 up), the view within this of facing one: 45.57°.', 'rad'), // prettier-ignore\n    attach: num(2.54, 0, 100, 'It climbs until its feet are this far above where it caught: 100 u.', 'm'),\n    cutoff: num(3.7338, 0, 100, 'Or this far above the climb space’s foot, the last ground’s: 147 u.', 'm'),\n    end: num(0.7112, 0, 100, 'Then the end boost throws it this much higher: 28 u.', 'm'),\n    up: num(5.715, 0, 100, 'Its speed up the wall: 225 u/s.', 'm/s'),\n    across: num(6.5532, 0, 100, 'Across the wall, not climbing up: 258 u/s.', 'm/s'),\n    acrossUp: num(2.921, 0, 100, 'Across the wall while climbing up: 115 u/s.', 'm/s'),\n    accel: num(30, 0, 1e4, 'Ours: how fast it reaches those speeds.', 'm/s²'),\n    rising: num(0.254, 0, 100, 'Rising this fast or faster it climbs on with no timer: 10 u/s.', 'm/s'),\n    timer: num(1, 0, 60, 'Rising slower, it lets go this long after it caught.', 's'),\n    mini: num(0.4826, 0, 100, 'A jump off below this over the climb space’s foot is a mini-bounce: 19 u.', 'm'),\n","exit_code":0,"status":"completed"}}
