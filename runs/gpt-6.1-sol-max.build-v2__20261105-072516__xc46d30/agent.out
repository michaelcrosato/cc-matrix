{"type":"item.started","item":{"id":"item_215","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/content.ts');s=p.read_text();anchor='for (const { id, ...spec } of CONTRACTS)'\ns=s.replace(anchor,\\\"\\\"\\\"export const ALTS:Record<number,{goal:string;kind:string;key?:string;at:[number,number];count?:number;buddy:string}>={\n  1:{goal:'Burn the Km-40 radio hut before returning the ledger.',kind:'burn',key:'km40',at:[620,520],count:3,buddy:'yaw'},\n  2:{goal:'Bring the fourth quinine crate to the clinic as well.',kind:'delivery',at:[565,1098],count:4,buddy:'ilse'},\n  3:{goal:'Get the engineer south to the pipeline marker before the burn.',kind:'escort',key:'Engineer',at:[970,430],buddy:'tomas'},\n  4:{goal:'Secure the boat fuel from the river landing.',kind:'use',key:'boat-fuel',at:[1140,930],buddy:'mirela'},\n};\n\\\"\\\"\\\"+anchor)\ns=s.replace('All three back intact. I will remember who came for the medicine.', 'All four crates. The last one is for the people we have not met yet.')\ns=s.replace('Bring all three back intact. I will remember who came for the medicine.', 'Bring the fourth crate as well. I will remember who came for the medicine.')\ns=s.replace('I will watch the river. Leave yourself a boat.', 'Get the spare fuel from the landing. I will cover the river.')\np.write_text(s)\np=Path('labs/game/scenes/scenery.ts');s=p.read_text().replace(\\\"  addUsable(w, 'telephone'\\\", \\\"  addUsable(w,'quinine-3','crate','Lift spare quinine crate',565,1098,'crate');\\\\n  addUsable(w,'boat-fuel','objective','Secure the boat fuel',1140,930,'crate');\\\\n  spawnResident(w,'Engineer',1010,341);\\\\n  addUsable(w, 'telephone'\\\")\np.write_text(s)\np=Path('labs/game/scenes/use.ts');s=p.read_text().replace(\\\"    c.flags[\"'`talk:${u.key}`] = 1;\", \"    c.flags[`talk:${u.key}`] = 1;'\"\\\\n    if(u.key==='Perpetua'&&s.pills<4){s.pills=4;mark(w,'clinic supplies');c.save++;}\\\\n    if(u.key==='Engineer')c.flags.engineerFollowing=1;\\\")\ns=s.replace(\\\"      Perpetua:\\\", \\\"      Engineer:'South along the pipe. I would like to finish the walk.',\\\\n      Perpetua:\\\")\np.write_text(s)\np=Path('labs/game/scenes/story.ts');s=p.read_text().replace(\\\"import { CONTRACTS, STOCK }\\\", \\\"import { CONTRACTS, STOCK,ALTS }\\\")\ns=s.replace(\\\"    c.flags[\"'`alt-${c.contract}`] = 1;\", \"    if(c.flags[`alt-${c.contract}`])return;'\"\\\\n    c.flags[\"'`alt-${c.contract}`] = 1;\")\ns=s.replace(\"  c.step++;'\"\\\\n  c.save++;\\\", \\\"  if(c.step===0&&contract.steps[0].kind==='talk')say(w,contract.giver,contract.brief);\\\\n  c.step++;\\\\n  c.save++;\\\")\ns=s.replace(\\\"    if (c.flags[\"'`alt-${c.contract}`]) {\", \"    if (c.flags[`alt-${c.contract}`]&&c.flags[`altDone-${c.contract}`]) {\")\ns=s.replace(\"  c.goal = step.goal;\", \"\"\"  c.goal = step.goal;\n  const alt=ALTS[c.contract];if(alt&&c.flags[`alt-${c.contract}`]&&!c.flags[`altDone-${c.contract}`]){\n    if(alt.kind==='\"'burn'&&((c.flags[\"'`burned:${alt.key}`]??0)>=(alt.count??3)||burning(w,alt.at,40)>=(alt.count??3)))c.flags[`altDone-${c.contract}`]=1;\n    if(alt.kind==='\"'delivery'&&(c.flags.deliveries??0)>=(alt.count??4))c.flags[\"'`altDone-${c.contract}`]=1;\n    if(alt.kind==='\"'use'&&c.flags[\"'`use:${alt.key}`])c.flags[`altDone-${c.contract}`]=1;\n  }\n\"\"\")\ns=s.replace(\"  if (done && c.flags[`alt-${c.contract}`] && c.contract === 1) done = burning(w, [620, 520], 40) > 2;\", \"  if(done&&c.flags[`alt-${c.contract}`]&&c.step===contract.steps.length-1&&!c.flags[`altDone-${c.contract}`]&&!c.flags[`altFailed-${c.contract}`]){done=false;c.goal=alt?.goal??step.goal;}\")\np.write_text(s)\np=Path('\"'labs/game/scenes/fire.ts');s=p.read_text().replace(\\\"      mark(w, 'scorch');\\\", \\\"      for(const site of PLACES)if(Math.hypot(x-site.x,z-site.z)<site.radius)c.flags[\"'`burned:${site.id}`]=(c.flags[`burned:${site.id}`]??0)+1;'\"\\\\n      mark(w, 'scorch');\\\")\np.write_text(s)\np=Path('labs/game/scenes/health.ts');s=p.read_text();s += '''\n/** An engineer who has agreed to walk out follows the player and can be lost to the fire. */\nexport function escortStep(w:GW):void {\n  const c=campaign(w);if(\"'!c.flags.engineerFollowing||c.flags['\"'altDone-3']||c.flags['altFailed-3'])return;\n  const engineer=[...w.query('actor','usable','health')].find(p=>p.usable.data.key==='Engineer'),player=players(w)[0];if(\"'!engineer||!player)return;\n  if(engineer.health.hp<=0){c.flags['\"'altFailed-3']=1;c.flags.engineerFollowing=0;handOff(w,engineer.id,{dead:true});say(w,'Tomás','That invoice will remain open.');return;}\n  if(Math.hypot(engineer.actor.x-970,engineer.actor.z-430)<15){c.flags['altDone-3']=1;c.flags.engineerFollowing=0;engineer.actor.intents={};say(w,'Engineer','I will remember the direction.');return;}\n  const dx=player.actor.x-engineer.actor.x,dz=player.actor.z-engineer.actor.z,d=Math.hypot(dx,dz);engineer.actor.character={...engineer.actor.character,speed:3.8};engineer.actor.intents={move:d>4?[dx/d,dz/d]:[0,0]};\n}\n'''\np.write_text(s)\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace('feverStep, buddyStep','feverStep, buddyStep,escortStep').replace(\\\"  w.systems.add('game.buddies'\\\", \\\"  w.systems.add('game.escort',escortStep,{phase:'ai'});\\\\n  w.systems.add('game.buddies'\\\")\np.write_text(s)\np=Path('labs/game/ui/screens.ts');s=p.read_text().replace('CONTRACTS, STOCK','CONTRACTS, STOCK,ALTS').replace(\\\"    if (b && alt) {\\\", \\\"    if (b && alt&&ALTS[c?.contract??0]?.buddy===b.key) {\\\")\np.write_text(s)\np=Path('labs/game/ui/map.ts');s=p.read_text().replace('import { CONTRACTS }','import { CONTRACTS,ALTS }').replace(\\\"root.hidden = \"'!s?.map || ctx.screen !== '\"'play';\\\", \\\"root.hidden = \"'!s?.map || !['\"'play','attract'].includes(ctx.screen);\\\")\ns=s.replace(\\\"        at = step?.at;\\\", \\\"        at = c.flags[\"'`alt-${c.contract}`]&&!c.flags[`altDone-${c.contract}`]?ALTS[c.contract]?.at:step?.at;\")\np.write_text(s)\nPY\nrg -n '\"'ALTS|altDone|done && c.flags' labs/game/scenes/story.ts labs/game/ui/screens.ts\nnpm run format > out/format.log 2>&1\nNODE_OPTIONS=--max-old-space-size=1800 npm run check > out/check.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_215","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/content.ts');s=p.read_text();anchor='for (const { id, ...spec } of CONTRACTS)'\ns=s.replace(anchor,\\\"\\\"\\\"export const ALTS:Record<number,{goal:string;kind:string;key?:string;at:[number,number];count?:number;buddy:string}>={\n  1:{goal:'Burn the Km-40 radio hut before returning the ledger.',kind:'burn',key:'km40',at:[620,520],count:3,buddy:'yaw'},\n  2:{goal:'Bring the fourth quinine crate to the clinic as well.',kind:'delivery',at:[565,1098],count:4,buddy:'ilse'},\n  3:{goal:'Get the engineer south to the pipeline marker before the burn.',kind:'escort',key:'Engineer',at:[970,430],buddy:'tomas'},\n  4:{goal:'Secure the boat fuel from the river landing.',kind:'use',key:'boat-fuel',at:[1140,930],buddy:'mirela'},\n};\n\\\"\\\"\\\"+anchor)\ns=s.replace('All three back intact. I will remember who came for the medicine.', 'All four crates. The last one is for the people we have not met yet.')\ns=s.replace('Bring all three back intact. I will remember who came for the medicine.', 'Bring the fourth crate as well. I will remember who came for the medicine.')\ns=s.replace('I will watch the river. Leave yourself a boat.', 'Get the spare fuel from the landing. I will cover the river.')\np.write_text(s)\np=Path('labs/game/scenes/scenery.ts');s=p.read_text().replace(\\\"  addUsable(w, 'telephone'\\\", \\\"  addUsable(w,'quinine-3','crate','Lift spare quinine crate',565,1098,'crate');\\\\n  addUsable(w,'boat-fuel','objective','Secure the boat fuel',1140,930,'crate');\\\\n  spawnResident(w,'Engineer',1010,341);\\\\n  addUsable(w, 'telephone'\\\")\np.write_text(s)\np=Path('labs/game/scenes/use.ts');s=p.read_text().replace(\\\"    c.flags[\"'`talk:${u.key}`] = 1;\", \"    c.flags[`talk:${u.key}`] = 1;'\"\\\\n    if(u.key==='Perpetua'&&s.pills<4){s.pills=4;mark(w,'clinic supplies');c.save++;}\\\\n    if(u.key==