{"type":"item.completed","item":{"id":"item_124","type":"command_execution","command":"/bin/bash -lc \"sed -n '325,410p' engine/app/engine.ts\nsed -n '150,235p' engine/app/drawing.ts\nsed -n '235,320p' engine/gfx/renderer.ts\nrg -n 'warmup|ready:' engine/gfx/renderer.ts | head -25\"","aggregated_output":"    if (input.bindings.map.lock && !started.clock.paused && !input.mouse?.locked) input.mouse?.lock();\n  });\n  parts.layer = createTouchLayer(document, layout);\n  attachSwipes(document);\n  connectVirtualDevice(started.host, input.virtual);\n  try {\n    parts.gfx = await createRenderer(options.canvas, { settings: currentSettings(() => started), registry, log });\n  } catch (error) {\n    fail(error);\n    return engine;\n  }\n  const gfx = parts.gfx;\n  parts.numbers = createDamageNumbers((parts.ui = createUi({ canvas: options.canvas })));\n  try {\n    gfx.renderer.shadowMap.enabled = true;\n    const styles = createStyleSet({ library: materials!, registry });\n    const post = (parts.post = createPost(gfx, { settings: currentSettings(() => started), registry, log, styles }));\n    const budget = () => parts.governor!.budget(settingsNow.get<QualitySetting>('quality'), input.touch?.active ?? false); // prettier-ignore\n    parts.look = createPageLook({ post, styles, warmup: gfx.warmup, resolution: gfx.resolution, library: materials!, quality: budget, asked: () => warmsAsked(settingsNow) }); // prettier-ignore\n    post.attach(gfx.warmup);\n    viewNow().stage.register(gfx.warmup, gfx.features);\n    await warmCameras();\n    await settle(1, 0);\n  } catch (error) {\n    fail(error);\n    return engine;\n  }\n  const step = (intents: Record<string, unknown>) => {\n    if (playback && !playback.done) {\n      playback.step(started.session);\n      started.stepped(); // its hit-stops reach the clock as in live play\n    } else {\n      playback = null;\n      started.stepOnce(intents);\n    }\n  };\n  loop = createLoop({\n    clock: () => started.clock,\n    sample,\n    step,\n    draw: ({ alpha, dt }) => {\n      // frozen in a reproducible run: a replay playing, or the governor turned off (engine/dev/governor.ts)\n      parts.governor!.freeze((playback !== null && !playback.done) || !settingsNow.get<boolean>('gfx.governor'));\n      if (warming) return;\n      const report = frame(alpha, dt);\n      if (!report.drawn && report.warming) warming = warmCameras().finally(() => (warming = null));\n    },\n    hold: () => started.playing,\n    cap: () => input.touch?.active ?? false,\n    onError: (error) => fail(error, 'APP_FRAME'),\n  });\n  parts.ready = true;\n  overlay.hide();\n  loop.start();\n  const replay = asked?.playback;\n  if (asked && !replay) fail(asked.error);\n  else if (replay) {\n    try {\n      started.begin(replay.replay);\n      playback = replay;\n    } catch (error) {\n      fail(error);\n    }\n  }\n  return engine;\n}\n    parts.post ? parts.post.view(parts.look!.sync(viewNow().stage, view)) : view;\n  /** The view's cameras the page has drawn with; from the start, the one its camera stands at (`warmedCameras`). */\n  const drawn = new Set<FrameView['camera']>();\n  /** The shader key each camera was last warmed up under. */\n  const warmedAt = new WeakMap<FrameView['camera'], string>();\n  const cameras = () => {\n    const view = viewNow();\n    if (drawn.size === 0) drawn.add(view.cameras[view.camera.pose().projection === 'orthographic' ? 1 : 0]);\n    return warmedCameras<FrameView['camera']>(view.cameras, drawn, warmsAsked(settings));\n  };\n  /** Warms each camera that is not warm under the key now, a running warm-up's camera counted as its report says. */\n  const warmCameras = async () => {\n    const view = viewNow();\n    const { scene } = view.stage;\n    const particles = view.stage.fx.gpuParticles; // the GPU's, so the warm frame builds what draws them (WP 11.3)\n    for (let left = view.cameras.length + 1; left > 0; left--) {\n      const camera = cameras().find((one) => warmedAt.get(one) !== parts.gfx!.warmup.key(scene));\n      if (!camera) return;\n      const report = await parts.gfx!.warmup.run(through({ scene, camera, ...(particles ? { particles } : {}) }));\n      warmedAt.set(report.camera, report.key);\n    }\n  };\n  const frame = (alpha: number, dt: number): FrameReport =>\n    parts.run!.meter.time('render', () => {\n      const gfx = parts.gfx!;\n      parts.governor?.frame(dt * 1000);\n      touchFrame();\n      gfx.resolution.update();\n      const cameraInput = { ...parts.input?.camera(), ...parts.cameraInput?.() };\n      const view = viewNow().frame({ alpha, dt, aspect: aspect(), input: cameraInput });\n      keepWidth(view.camera, aspect());\n      const { shake } = viewNow().stage.fx.effects;\n      shake.apply(view.camera);\n      // asked, a camera never warmed waits for its warm-up (the caller runs it, as for a new key): nothing drawn cold\n      const cold = warmsAsked(settings) && !warmedAt.has(view.camera);\n      if (cold) drawn.add(view.camera);\n      const report = cold ? { drawn: false, warming: true, alpha, built: 0 } : gfx.frame(through(view));\n      shake.restore(view.camera);\n      parts.numbers?.frame(parts.run!.session.world);\n      parts.ui?.update(view.camera, dt);\n      if (options.onFrame) {\n        const { world, scene } = parts.run!.session;\n        const queries = scene.physics ? queryViewOf(world) : null;\n        const emit = (id: string, at: readonly [number, number, number], key: string, scale?: number) =>\n          viewNow().stage.fx.effects.emit(id, at, key, scale);\n        const setting = (key: string) => parts.run!.session.settings.get(key);\n        options.onFrame({ world, scene, camera: viewNow().camera.pose(), queries, dt, emit, setting });\n      }\n      return report;\n    });\n  const settle = async (alpha: number, dt: number): Promise<FrameReport> => {\n    for (let tries = 0; tries < DRAWING.tries; tries++) {\n      const report = frame(alpha, dt);\n      if (report.drawn) {\n        await parts.gfx!.device.queue.onSubmittedWorkDone();\n        return report;\n      }\n      await warmCameras().catch(() => undefined);\n    }\n    throw codeError('APP_NO_FRAME', { tries: DRAWING.tries });\n  };\n  const drawing: Drawing = {\n    active: () => parts.gfx !== null,\n    get adapter() {\n      const gfx = parts.gfx;\n      return gfx ? { ...gfx.info.adapter, backend: gfx.info.backend, three: gfx.info.three } : null;\n    },\n    get features() {\n      return parts.gfx?.info.enabled ?? [];\n    },\n    get downgrades() {\n      return parts.gfx?.info.downgrades ?? [];\n    },\n    ready: () => parts.ready,\n    async render(frames) {\n      let report: FrameReport | null = null;\n      for (let k = 0; k < frames; k++) report = await settle(1, 1 / 60);\n      return report!;\n    },\n    async shot(shotOptions) {\n      const view = viewNow().frame({ alpha: 1, dt: 0, aspect: aspect() });\n      keepWidth(view.camera, aspect());\n      if (warmsAsked(settings) && !warmedAt.has(view.camera)) {\n        drawn.add(view.camera);\n        await warmCameras();\n      }\n    // Handled: recorded with its code, so the browser does not print it again as an uncoded warning.\n    event.preventDefault();\n    log.error('GFX_GPU_ERROR', { kind: error.constructor.name, message: error.message });\n  });\n  const lost = renderer.onDeviceLost;\n  renderer.onDeviceLost = (info) => {\n    log.error('GFX_DEVICE_LOST', { reason: info.reason ?? 'unknown', message: info.message });\n    lost.call(renderer, info);\n  };\n}\n\n/**\n * Starts three.js's `WebGPURenderer` on `canvas`, on WebGPU only: the adapter check, a device with every feature and\n * limit the adapter offers, `await renderer.init()`, the backend assertion, then the report, the feature registry and\n * the error routes. Rejects with `GfxError` `GFX_NO_WEBGPU` at the first step that fails. Draw with `frame(view)`.\n */\nexport async function createRenderer(canvas: HTMLCanvasElement, options: GfxOptions = {}): Promise<Gfx> {\n  const log = options.log ?? sharedLog;\n  const settings = options.settings ?? createSettings({ registry: options.registry });\n  const adapter = await requestWebGPU();\n  let device: GPUDevice;\n  try {\n    device = await requestDevice(adapter, { log });\n  } catch (error) {\n    throw new GfxError('GFX_NO_WEBGPU', { reason: `the adapter gave no device (${String(error)})` });\n  }\n  const pipelines = countPipelines(device, { log });\n  const caps = readCaps(adapter, device);\n  const features = resolveFeatures(caps, { registry: options.registry, settings, log });\n  const trackTimestamp = features.on.includes('feature:timestamps');\n  const renderer = new WebGPURenderer({ canvas, device, antialias: options.antialias ?? false, trackTimestamp });\n  lightingFor(renderer, features); // tiled lighting, when its feature is on (WP 11.5)\n  await renderer.init();\n  if ((renderer.backend as { isWebGPUBackend?: boolean }).isWebGPUBackend !== true) {\n    renderer.dispose();\n    throw new GfxError('GFX_NO_WEBGPU', { reason: 'three.js started another backend than WebGPU' });\n  }\n  routeErrors(renderer, device, log);\n  // One frame may render several times (a post pass): `frame()` resets the counts once per frame.\n  renderer.info.autoReset = false;\n  const timing = gpuTimingFor(renderer, features);\n  const info: GfxInfo = {\n    backend: 'WebGPU',\n    adapter: caps.adapter,\n    features: caps.features,\n    limits: caps.limits,\n    three: REVISION,\n    enabled: features.on,\n    downgrades: features.downgrades,\n  };\n  const resolution = createResolution({ renderer, canvas, settings });\n  const warmup = createWarmup({ renderer, counter: pipelines });\n  let frames = 0;\n  let alpha = 1;\n  let failed: string | null = null;\n\n  const frame = (view: FrameView): FrameReport => {\n    const next = view.alpha ?? 1;\n    if (!(next >= 0 && next <= 1)) throw codeError('GFX_BAD_ALPHA', { alpha: String(view.alpha) });\n    resolution.update();\n    const { css } = resolution.current!;\n    const camera = view.camera as PerspectiveCamera;\n    const aspect = css.width > 0 && css.height > 0 ? css.width / css.height : 1;\n    if (camera.isPerspectiveCamera && camera.aspect !== aspect) {\n      camera.aspect = aspect;\n      camera.updateProjectionMatrix();\n    }\n    const idle = { drawn: false, warming: true, alpha: next, built: 0 };\n    if (warmup.running) return (void timing.taint(), idle); // its passes are not a frame's\n    const key = warmup.key(view.scene);\n    if (key !== warmup.last?.key && key !== failed) {\n      warmup.run(view).catch((error: unknown) => {\n        failed = key;\n        log.error('GFX_WARMUP_FAILED', { message: String(error) }, error);\n      });\n      return idle;\n    }\n    if (!advanceFrame(renderer)) {\n      log.warnOnce('GFX_PIPELINES_UNPINNED', { revision: REVISION, problems: checkPinned(renderer).join('; ') });\n    }\n    renderer.info.reset();\n    const before = pipelines.count().built;\n    (view.draw ?? (() => renderer.render(view.scene, view.camera)))();\n    const built = pipelines.count().built - before;\n    frames++;\n    timing.afterFrame();\n14: * (engine/gfx/warmup.ts; the frames until it is done are skipped, never drawn half-built), resets `renderer.info`,\n44:import { createWarmup, type Warmup, type WarmupView } from './warmup';\n68:    fix: 'register what the frame drew for the first time with gfx.warmup.register(id, { objects }), or add what changed to the shader key with gfx.warmup.keyPart(name, part), so the warm-up builds it first',\n190:  warmup: Warmup;\n286:  const warmup = createWarmup({ renderer, counter: pipelines });\n303:    if (warmup.running) return (void timing.taint(), idle); // its passes are not a frame's\n304:    const key = warmup.key(view.scene);\n305:    if (key !== warmup.last?.key && key !== failed) {\n306:      warmup.run(view).catch((error: unknown) => {\n322:    if (built > 0 && warmup.last) log.warnOnce('GFX_COLD_PIPELINE', { count: built, frame: frames });\n347:      warmUps: warmup.last?.count ?? 0,\n348:      pipelinesAfterWarmUp: warmup.start === null ? null : counted.built - warmup.start - warmup.built,\n353:  return { renderer, device, info, features, resolution, warmup, pipelines, timing, frame, stats };\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_125","type":"command_execution","command":"/bin/bash -lc \"rg -n \\\"'quality'|quality:|enum:.*low\\\" engine/gfx/settings.ts engine/core/settings*.ts engine/dev/governor*.ts | head -20\nrg -n 'enum:.*low|shadow.size|shadow' engine/gfx/quality.ts | head -30\nsed -n '1,105p' engine/gfx/warmup.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_125","type":"command_execution","command":"/bin/bash -lc \"rg -n \\\"'quality'|quality:|enum:.*low\\\" engine/gfx/settings.ts engine/core/settings*.ts engine/dev/governor*.ts | head -20\nrg -n 'enum:.*low|shadow.size|shadow' engine/gfx/quality.ts | head -30\nsed -n '1,105p' engine/gfx/warmup.ts\"","aggregated_output":"rg: engine/gfx/settings.ts: No such file or directory (os error 2)\nengine/core/settings.ts:150:  enum: { type: 'array', description: 'The only values allowed.' },\n7: * - `medium`: at most 1 megapixel, one shadow caster, GI and god rays off.\n8: * - `low`: at most 0.5 megapixel, no shadow casters, and bloom and halos off as well.\n10: * engine/gfx/resolution.ts applies the pixel caps (`resolution.cap(budget)`), engine/gfx/shadows.ts the shadow\n22: * // qualityBudget('auto', true); // { tier: 'medium', maxPixels: 1e6, shadowCasters: 1, gi: false, … }\n44:      \"How much the picture costs: 'high' draws everything, 'medium' at most 1 megapixel with one shadow caster and no GI or god rays, 'low' at most 0.5 megapixel with no shadows, bloom or halos; 'auto' is medium on touch screens, high elsewhere.\",\n56:  /** The most lights that cast shadows. */\n57:  shadowCasters: number | null;\n78:    return { tier, maxPixels: 0.5e6, maxPixelRatio: null, shadowCasters: 0, gi: false, godRays: false, bloom: false, halos: false }; // prettier-ignore\n81:    return { tier, maxPixels: 1e6, maxPixelRatio: null, shadowCasters: 1, ...all, gi: false, godRays: false };\n83:  return { tier, maxPixels: null, maxPixelRatio: touch ? 2 : null, shadowCasters: null, ...all };\n/**\n * @file The warm-up registry (PLAN.md §8.7, I-18): every GPU pipeline is built before play needs it, so no frame\n * stalls on one. Pools and batches register the objects they will show (`register(id, { objects })`); `run(view)`\n * makes each drawable without showing it, compiles the scene with three.js's `compileAsync` one step per entry with\n * progress, then draws one warm frame through the view's own `draw`, which builds what `compileAsync` cannot reach\n * (the shadow, post and output passes). `key(scene)` is the scene's shader key: fog, environment, background, shadow\n * map, tone mapping, output colour space, the lights as r182's `LightsNode` keys them (id and `castShadow`), the\n * registered ids, and the parts other modules add (`keyPart`, the post filters of WP 7.4). The frame re-runs the\n * warm-up whenever the key changes (engine/gfx/renderer.ts), so toggling fog, shadows, a filter or a light rebuilds\n * at a moment of the engine's choosing, never in the middle of a frame.\n *\n * Measured on r182 (WP 2.1): `compileAsync` compiles for the render target set on the renderer, and `render()` draws\n * a scene into an internal half-float target whenever it converts colours for the screen, so a plain `compileAsync`\n * built 4 pipelines `render()` never used and missed 4 it did. The warm-up therefore compiles for each target the\n * frame really draws the scene into, its passes (`view.passes`): a post pass's `renderTarget`, set up by the pass's\n * `enter` (its MRT on), or, by default, what `render()` draws into: a 1 × 1 stand-in with the internal target's\n * attachments, which shares its render context. The warm frame catches the rest.\n *\n * Compile, never draw, what `compileAsync` reaches. Measured on SwiftShader (gate G6's review): a pipeline the warm\n * frame builds is built on its own, one after another, about 45 ms each, while `compileAsync` builds its pipelines\n * side by side, about 7 ms each; the Stress Box hall's warm-up through a post chain whose plain frames were left to\n * the warm frame built 155 of its pipelines there, and its warm frame took 6 to 7 s a camera.\n *\n * Drawable without showing: each registered object, and each hidden ancestor of it, is made visible, and the\n * topmost one made visible is scaled to nothing; an `InstancedMesh` with no instances gets one, at zero scale; every\n * object in the scene is drawn without frustum culling, so what is behind the camera is built too. All of it is put\n * back afterwards, in reverse order. Carried from `my-3d2dge:src/stress-world/50-frame.js:29-47` (`warmUp()`) as the\n * idea for a registry. What a page's warm-ups compile is the view setting `gfx.warmUp` (`WARMUP_SETTINGS`).\n *\n * Invariants: one warm-up runs at a time (a second `run` returns the first's promise); entries and key parts are kept\n * in id order; the report counts the pipelines this warm-up built (counted at the device, engine/gfx/pipelines.ts).\n *\n * @example\n * // const warmup = createWarmup({ renderer, counter: countPipelines(device) });\n * // warmup.register('pool:sparks', { objects: () => [sparks.mesh] });\n * // const report = await warmup.run({ scene, camera }, { onProgress: ({ done, total }) => bar(done / total) });\n * @see tests/e2e/renderer.spec.ts\n * @see engine/gfx/warmup.test.ts\n */\nimport {\n  ColorManagement,\n  Matrix4,\n  RenderTarget,\n  type Camera,\n  type ColorSpace,\n  type InstancedMesh,\n  type Object3D,\n  type Scene,\n  type WebGPURenderer,\n} from 'three/webgpu';\nimport { codeError, defineCodes } from '../core/log';\nimport type { Field } from '../core/schema';\nimport { defineSettings } from '../core/settings';\nimport { advanceFrame, type PipelineCounter } from './pipelines';\n\n/** The codes this module raises, with their fixes. */\nexport const WARMUP_CODES = defineCodes('gfx', {\n  GFX_DUPLICATE_WARMUP: {\n    template: 'the warm-up already has an entry {id}',\n    fix: 'dispose the first registration (register returns { dispose }), or register the second under another id',\n  },\n});\n\n/**\n * Its view setting `gfx.warmUp` (ADR-0008 amendment 11): what a page's warm-ups compile. r182 builds a shader for each\n * render object whose cache key differs, and the key holds the camera's id, the render target and an instanced mesh's\n * uuid, so a warm-up builds the same shader many times over (the playground's gym: 3,310 builds for 102 pipelines,\n * most of its start). `all` compiles both cameras, the plain frame's pass and the style set's own style, so no later\n * switch warms up; `asked` only what the page has drawn: the page's drawing, the post chain and the page's look\n * (engine/app/drawing.ts, engine/gfx/post/chain.ts, engine/app/look.ts) warm up a camera, the plain frame or a style\n * the first time a frame needs it, before that frame, never in it.\n */\nexport const WARMUP_SETTINGS = {\n  'gfx.warmUp': {\n    type: 'string',\n    enum: ['all', 'asked'],\n    default: 'all',\n    view: true,\n    description:\n      \"What a page's warm-ups compile: all (both cameras, the plain frame and the style set's own style, so no later switch warms up) or asked (only the cameras, the frame and the styles the page has drawn: a first frame of another warms up first, once; a faster start).\",\n  },\n} as const satisfies Record<string, Field>;\ndefineSettings(WARMUP_SETTINGS);\n\n/** Whether `settings` ask a page's warm-ups to compile only what it has drawn (`gfx.warmUp: asked`). */\nexport const warmsAsked = (settings: { get(path: string): unknown }): boolean => settings.get('gfx.warmUp') === 'asked';\n\n/** What a pool or batch registers: the objects it may show, each made drawable for the warm-up. */\nexport interface WarmupEntry {\n  objects(): readonly Object3D[];\n}\n\n/** One way a frame draws the scene: into a render target, with the renderer set up for it. */\nexport interface WarmupPass {\n  /** The render target (a post pass's `renderTarget`); what `render()` draws into when left out. */\n  target?: RenderTarget | null;\n  /** Sets the renderer up as the frame does for this target (a post pass turns its MRT on), once it is set. */\n  enter?(): void;\n  /** Puts back what `enter` set, after compiling for this target. */\n  leave?(): void;\n}\n\n/** What a warm-up draws: the scene, its camera, how the frame draws it, and every way it draws the scene. */\nexport interface WarmupView {\n  scene: Scene;\n","exit_code":0,"status":"completed"}}
