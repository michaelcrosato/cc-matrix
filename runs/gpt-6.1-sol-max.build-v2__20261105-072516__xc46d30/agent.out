{"type":"item.completed","item":{"id":"item_206","type":"command_execution","command":"/bin/bash -lc \"sed -n '45,120p' engine/sim/actorInput.ts\nsed -n '130,183p' labs/game/main.ts\nsed -n '74,100p' tests/game/page.mjs\"","aggregated_output":"  used = false,\n  swinging = false,\n  aiming = false,\n): CharacterInput {\n  const [aimX, , aimZ] = wants.aim ?? [];\n  const aimed = aimX !== undefined && Math.hypot(aimX - actor.x, aimZ! - actor.z) > 0.05;\n  const face = aimed ? Math.atan2(aimX - actor.x, aimZ! - actor.z) : wants.look?.[0];\n  const frame = wants.cam ?? wants.look?.[0];\n  const toggle = actor.player && controls.toggleCrouch;\n  return {\n    sprint: held(wants, 'sprint'),\n    sprintPressed: pressed(wants, 'sprint'),\n    ...(actor.player && controls.holdSprint ? { sprintHold: true } : {}),\n    walk: held(wants, 'walk') || aiming,\n    crouch: !toggle && held(wants, 'crouch'),\n    crouchToggle: pressed(wants, 'crouchToggle') || (toggle && pressed(wants, 'crouch')),\n    usePressed: pressed(wants, 'interact') && !used, // a use took the press (engine/sim/interact.ts): no ride\n    ...(wants.look ? { view: wants.look[0], pitch: wants.look[1] } : {}),\n    ...(frame !== undefined ? { frame } : {}),\n    ...(face !== undefined ? { face } : {}),\n    ...(swinging ? { swinging } : {}),\n  };\n}\n    if (mode === 'title') e.camera.set('cam3=fixed,548,18,730,156,-7');\n    else\n      e.camera.set(\n        store.get('camera', 'First person') === 'First person' ? 'cam3=first,180,0' : 'cam3=shoulder,180,-10,3',\n        { blend: true },\n      );\n    renderScreen(ctx);\n  },\n  quit() {\n    if (info) return;\n    netStop?.();\n    netStop = null;\n    ctx.net?.close();\n    ctx.net = null;\n    ctx.inHub = false;\n    ctx.start('title');\n  },\n  send(cmd) {\n    ctx.inspector()?.step(1, { 'game:command': { ...cmd, seat: ctx.me } as never });\n  },\n  startNet() {\n    const net = ctx.net,\n      e = ctx.inspector();\n    if (!net || !e) return;\n    ctx.inHub = true;\n    ctx.me = net.me;\n    for (const [key, v] of Object.entries({\n      'game.mode': 'contract',\n      'game.seats': net.players.length,\n      'game.me': net.me,\n      'game.detail': 0.08,\n    }))\n      e.set(key, v);\n    e.seed(net.seed);\n    e.pause();\n    ctx.screen = 'play';\n    cameraCode = '';\n    renderScreen(ctx);\n    netStop = startLockstep(net, e, {\n      sample: sampleWire,\n      onMismatch: () => {\n        document.getElementById('msg')!.textContent = 'Connection out of sync.';\n      },\n      onEnd: () => ctx.open('ending'),\n      finish: (won) => {\n        if (!ended) {\n          ended = true;\n          net.finish(result(e, net, won));\n        }\n      },\n    });\n  },\n};\nimport { TUNING } from './scenes/settings';\n    'balance reset',\n    await page.evaluate(\n      () => Math.abs(window.__engine.state('campaign').settings['game.wear.perShot'] - 0.0012) < 1e-10,\n    ),\n  );\n  await page.screenshot({ path: 'out/page/dev.png' });\n});\nawait run('map remains live and medicine acts in the world', async () => {\n  await page.evaluate(() => {\n    window.__game.open('play');\n    window.__engine.actions.run('place', { place: 'mission' });\n    window.__game.open('map');\n  });\n  await page.waitForFunction(() => window.__game.screen() === 'map');\n  const tick = await page.evaluate(() => window.__engine.info().tick);\n  await page.waitForTimeout(700);\n  check('map does not pause', await page.evaluate((t) => window.__engine.info().tick > t, tick));\n  await page.screenshot({ path: 'out/page/map.png' });\n  await page.evaluate(() => {\n    window.__game.open('map');\n    window.__engine.actions.run('hurt', { hp: 12 });\n    window.__engine.step(1, { p: ['heal'] });\n  });\n  await page.waitForFunction(() => window.__game.context.p.seat.data.action.startsWith('surgery'), undefined, {\n    timeout: 20000,\n  });\n  check('critical press becomes surgery', true);\n","exit_code":0,"status":"completed"}}
