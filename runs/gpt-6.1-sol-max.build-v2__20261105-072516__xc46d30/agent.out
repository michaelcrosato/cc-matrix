{"type":"item.started","item":{"id":"item_134","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/ai.ts');s=p.read_text().replace(\\\"aim:combat?[target.actor.x,target.actor.y+1.15,target.actor.z]:undefined,b\\\", \\\"...(combat?{aim:[target.actor.x,target.actor.y+1.15,target.actor.z] as [number,number,number]}:{}),b\\\");p.write_text(s)\np=Path('labs/game/scenes/vehicles.ts');s=p.read_text().replace(\\\"s.vehicle=-1;s.mounted=false;\\\",\\\"s.vehicle=-1;s.mounted=false;s.useHeld=-1;\\\").replace(\\\"if(\"'!p.seat?.data.vehicle&&\", \"if((p.seat?.data.vehicle??-1)<0&&\");p.write_text(s)\np=Path('\"'labs/game/scenes/use.ts');s=p.read_text().replace(\\\"const s=p.seat\"'!.data;if(s.vehicle>=0)continue;\",\"const s=p.seat!.data;if(s.vehicle>=0)continue;if(s.useHeld<0){s.useHeld=0;continue;}\")\np.write_text(s)\nPY\ncat > out/prologue.mts <<'\"'EOF'\nimport {createHeadless} from '../engine/index.ts';\nimport world from '../labs/game/scenes/world.ts';\nimport {roundOf,mercOf,walkTo} from '../labs/game/bot.ts';\nconst e=await createHeadless({scene:world,seed:1,settings:{'game.mode':'story','game.detail':0.05}});\nfunction log(tag){const c=roundOf(e),p=mercOf(e);console.log(tag,JSON.stringify({step:c.step,contract:c.contract,hp:p.health.hp,pos:[p.actor.x,p.actor.z],syr:p.seat.data.syr,down:p.seat.data.down,rescue:p.seat.data.rescue,action:p.seat.data.action,gun:p.gunState.data.guns[1],message:c.message,coverage:c.coverage}));}\nlog('start');console.log('walk',walkTo(e,[330,858],15,5000));log('ashore');e.step(240,{b:['reload']});log('clear');e.step(1,{p:['heal']});e.step(70);log('heal');\nfor(let n=0;n<2400;n+=300){e.step(300);log('wait '+n);}\nEOF\nnode --import tsx out/prologue.mts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
