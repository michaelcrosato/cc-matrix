{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"sed -n '96,130p' engine/world/props/prop.ts\ncat engine/world/props/place.ts | head -75\nrg -n 'export function handOff' engine/sim\nrg -n 'export function defineCamera|interface CameraSpec|interface CameraMode' engine/camera/*.ts engine/cameras/*.ts 2>/dev/null\nsed -n '1,70p' engine/physics/movement/profiles.ts\"","aggregated_output":"    description:\n      'Drawn only while its prop is on: a lamp’s bulb, which its switch turns off with its light (WP 13.16).',\n  },\n  flame: {\n    type: 'object',\n    default: defaultsOf(FLAME_FIELDS),\n    description:\n      'Drawn as flame tongues dancing round its origin (its geometry a cone 1 m high), or still (tongues 0).',\n    properties: FLAME_FIELDS,\n  },\n} as const satisfies Schema;\n\n/** The physics shapes a prop's body may have, sized as three.js sizes its geometries. */\nexport const PROP_SHAPES = ['box', 'cylinder', 'ball', 'capsule'] as const;\n\n/** The fields of a prop's body: its type, its shape and its material (engine/physics/bodies.ts's PROP_MATERIAL). */\nconst BODY_FIELDS = {\n  type: {\n    type: 'string',\n    enum: ['none', 'fixed', 'dynamic', 'kinematic'],\n    default: 'none',\n    description:\n      \"'dynamic' falls, slides and is knocked; 'fixed' stands where it is placed and blocks; 'kinematic' moves only as the sim drives it (a door on its hinge, WP 13.16); 'none' has none.\",\n  },\n  shape: { type: 'string', enum: PROP_SHAPES, default: 'box', description: 'Its shape.' },\n  size: vec3([1, 1, 1], \"A box's width, height and depth.\"),\n  radius: metres(0.5, \"A cylinder's, ball's or capsule's radius.\"),\n  height: metres(1, \"A cylinder's height, or a capsule's straight middle.\"),\n  density: {\n    type: 'number',\n    default: 57,\n    minimum: 0,\n    unit: 'kg/m³',\n    description: \"A hollow crate's: 24 kg at 0.75 m.\",\n  },\n/**\n * @file Placing props (PLAN.md WP 4.5): where a level puts them, the bodies they stand in the physics world with, and\n * where those without a body are drawn, as plain data, so a scene spawns props from level glyphs or from its own\n * data the same way. A placement is `{ prop, at, yaw }`: the prop by id, its base (m) and its turn about +Y (rad).\n *\n * - `levelProps(level)` lists the placements a compiled level makes: on each spawn point whose name a prop's\n *   `place.spawn` gives (on its floor), then under each light spot whose tag a prop's `place.light` gives (on the top\n *   of the spot's tile: the brazier's fire on its stand). A scene adds its own placements beside these.\n * - `propBody(placement)` is the body `physics.addBody` takes for it (engine/physics/world.ts): the prop's body type,\n *   its shape standing on the base (its origin `propCentre` up), turned by `yaw`, with the prop's material; `null`\n *   for a prop without a body.\n * - `propPose(placement)` is where it is drawn while no body moves it: its centre and its turn, as a body's pose\n *   reads (engine/gfx/props.ts draws props at either).\n *\n * Invariants: pure in the level and the registry; placements in the level's order (spawn points, then light spots,\n * each in reading order), the props each one places in id order; ids are asked of the entries' fields, never compared.\n *\n * @example\n * import { compileLevel } from '../level/compile';\n * const level = compileLevel('#####\\n#.t.#\\n#####\\n', { file: 'nook.txt' });\n * levelProps(level); // [{ prop: 'prop:brazier', at: [2.5, 0.75, 1.5], yaw: 0 }]: on the brazier stand's top\n * propBody({ prop: 'prop:crate', at: [1, 0, 2], yaw: 0 })?.position; // [1, 0.375, 2]: the crate's centre\n * propBody({ prop: 'prop:brazier', at: [1, 0, 2], yaw: 0 }); // null: the fire has no body\n * @see engine/world/props/place.test.ts\n */\nimport { registry as sharedRegistry, type Registry } from '../../core/registry';\nimport type { CompiledLevel, Point3 } from '../level/types';\nimport { getProp, propCentre, propKind, type Prop } from './prop';\n\n/**\n * A prop placed: `{ prop: 'prop:<id>', at: [x, y, z], yaw }`, its base at `at` (m) and its turn `yaw` about +Y\n * (rad), as `spawnProp` takes it and `levelProps` gives it.\n */\nexport interface PropPlacement {\n  /** The prop, by id (`prop:crate`). */\n  prop: string;\n  /** Where its base stands (m). */\n  at: Point3;\n  /** Its turn about +Y (rad). */\n  yaw: number;\n}\n\n/** A prop's collider, as `physics.addBody` takes it. */\nexport type PropCollider = {\n  shape:\n    | { type: 'box'; size: [number, number, number] }\n    | { type: 'cylinder' | 'capsule'; radius: number; height: number }\n    | { type: 'ball'; radius: number };\n  density: number;\n  friction: number;\n  restitution: number;\n};\n\n/** A prop's body, as `physics.addBody` takes it (engine/physics/world.ts's `BodySpec`). */\nexport interface PropBody {\n  type: 'dynamic' | 'fixed' | 'kinematic';\n  /** Its centre (m). */\n  position: [number, number, number];\n  /** `[x, y, z, w]`. */\n  rotation: [number, number, number, number];\n  linearDamping: number;\n  angularDamping: number;\n  colliders: [PropCollider];\n}\n\n/** Where a prop is drawn: its centre (m) and its turn, `[x, y, z, w]`. */\nexport interface PropPose {\n  position: [number, number, number];\n  rotation: [number, number, number, number];\n}\n\n/** The placements `level` makes for the props of `registry` (the shared one by default); see the file comment. */\nexport function levelProps(\n  level: Pick<CompiledLevel, 'spawns' | 'lights' | 'top' | 'cols'>,\n  registry: Registry = sharedRegistry,\nengine/sim/ragdolls.ts:126:export function handOff<C extends object>(world: World<C>, id: number, hit: RagdollHit = {}): RagdollState {\n/**\n * @file The movement profiles every game gets (PLAN.md WP 13.3, docs/PLAYGROUND.md §3.2), registered on the shared\n * registry when this module loads (engine/physics/character.ts loads it):\n * - `movement:apex`, Apex Legends' movement: its medium legends' hull, steps and slopes, gravity, jump and grace period,\n *   and the shooter model at its defaults, which are Apex's numbers (engine/physics/movement/model.ts). Its sources are\n *   er-apex's settings (`umiiii/er-apex`, `deps/er-apex-move/src/params.rs`: Fuse's, a medium legend) and an Apex\n *   console-variable dump (`240hz/ApexConfigs`), converted at 1 u = 0.0254 m.\n * - `movement:platformer`, the Stress Box hero's feel (a dash, a wall jump, a variable jump): the character controller's\n *   own defaults, so a character on it is the one `createCharacter()` makes, down to its hash.\n *\n * Invariants: data only; `movement:platformer` sets nothing.\n *\n * @example\n * import { getMovement } from './profile';\n * getMovement('movement:apex').character; // { capsule: { radius: 0.4064, height: 1.016 }, … }\n * @see engine/physics/movement/profile.test.ts\n */\nimport { registry as sharedRegistry } from '../../core/registry';\nimport { defineMovement, movementKind, type MovementSpec } from './profile';\n\n/** Apex's gravity: 750 u/s². */\nconst GRAVITY = 19.05;\n\n/** The profiles, by id. */\nexport const MOVEMENT_PROFILES: Readonly<Record<string, MovementSpec>> = {\n  'movement:apex': {\n    description:\n      'Apex Legends: run 4.41 m/s, sprint 6.60 (×1.15 holstered), Quake air strafing, a 1.42 m jump with fatigue, the lurch, the bunny-hop cost and the fall stun, on a medium legend’s 1.83 m hull.',\n    character: {\n      capsule: { radius: 0.4064, height: 1.8288 - 2 * 0.4064 }, // 16 u wide, 72 u tall\n      autostep: { height: 0.5588 }, // 22 u\n      stepFrom: 'contact', // a slide or a sprint steps up a stair, never stopping dead at it\n      stayOnGround: true, // over a ramp's crest it keeps to the ground, as Source's StayOnGround snaps it\n      maxSlope: 0.7953988301841436, // acos(0.7): walkable while the floor's normal is at least 0.7 up (45.57°)\n      slideSlope: 0.7953988301841436,\n      characterGravity: GRAVITY,\n      maxFall: 88.9, // 3,500 u/s, Source's sv_maxvelocity: a 20 m fall lands at 28 m/s, so the full stun is reachable\n      speed: 4.4069, // the run, for what reads the platformer fields (the feel meter's top speed)\n      jumpSpeed: Math.sqrt(2 * GRAVITY * 1.4224), // a 56 u jump: 7.36 m/s\n      feel: { coyote: 0.2, variableJump: 1, airControl: 0, dash: { speed: 0 } }, // jump_graceperiod; no cut, no dash\n    },\n    model: {},\n  },\n  'movement:platformer': {\n    description:\n      'The Stress Box hero: run 6 m/s with momentum and a skid, a 1.35 m variable jump with coyote time and a buffer, a dash, under 32 m/s² (the character controller’s defaults).',\n  },\n};\n\nmovementKind(sharedRegistry);\nfor (const [id, spec] of Object.entries(MOVEMENT_PROFILES)) {\n  if (!sharedRegistry.has('movement', id)) defineMovement(id, spec);\n}\n","exit_code":0,"status":"completed"}}
