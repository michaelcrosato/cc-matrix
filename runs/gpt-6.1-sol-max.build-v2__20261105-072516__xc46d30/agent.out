{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"rg -n 'interface DoorComponent' -A40 engine/sim/doors.ts\nrg -n 'actions.run|actions:' engine/dev/inspector.ts engine/app/headless.ts | head -20\nsed -n '50,95p' engine/gfx/cameras/define.ts\nsed -n '1,90p' engine/gfx/cameras/chase.ts\nsed -n '40,90p' engine/app/store.ts\"","aggregated_output":"67:export interface DoorComponent {\n68-  hinge: [number, number, number];\n69-  yaw: number;\n70-  /** Where it is (rad on a hinge; 0 to 1 of its slide) and where it is going. */\n71-  angle: number;\n72-  target: number;\n73-  speed: number;\n74-  locked: boolean;\n75-  /** Strikes taken; broken at the second. */\n76-  struck: number;\n77-  broken: boolean;\n78-  slide: [number, number, number];\n79-  tilt: boolean;\n80-}\n81-\n82-type DoorEntity = ScenePropComponents & { id: number; door: DoorComponent };\n83-\n84-const vec = (description: string, value: readonly number[] = [0, 0, 0]) => ({ type: 'array', items: { type: 'number' }, default: [...value], unit: 'm', description }) as const; // prettier-ignore\n85-defineComponent('door', {\n86-  description: 'A door on its hinge or its slide (WP 13.16): where it is, where it is going, locked, struck, broken.',\n87-  fields: {\n88-    hinge: vec('The leaf’s foot at its hinged edge (m).'),\n89-    yaw: { type: 'number', default: 0, description: 'The closed leaf’s turn about +Y (rad).' },\n90-    angle: { type: 'number', default: 0, description: 'Where it is: rad on its hinge, or 0 to 1 of its slide.' },\n91-    target: { type: 'number', default: 0, description: 'Where it is going.' },\n92-    speed: { type: 'number', default: 2.6, minimum: 0, description: 'How fast (rad/s, or of its slide per second).' },\n93-    locked: { type: 'boolean', default: false, description: 'Whether using it opens it.' },\n94-    struck: { type: 'integer', default: 0, minimum: 0, description: 'Strikes taken: the second breaks it.' },\n95-    broken: { type: 'boolean', default: false, description: 'Off its hinges, a falling body.' },\n96-    slide: vec('A sliding door’s way open (m); none for a hinge.'),\n97-    tilt: { type: 'boolean', default: false, description: 'An up-and-over door: it turns about its top edge.' },\n98-  },\n99-});\n100-\n101-/** Whether `door` slides rather than swings. */\n102-const slides = (door: DoorComponent) => door.slide.some((v) => v !== 0);\n103-\n104-/** Whether `door` is worked by its switch (it slides or tilts), never used or struck. */\n105-const switched = (door: DoorComponent) => slides(door) || door.tilt;\n106-\n107-/** The leaf's centre and turn at `angle` (see the file comment). */\n  readonly description?: string;\n  readonly create: (code: string, options: { readonly from?: CameraPose }) => unknown;\n}\n\n/** Declares the kind `camera` on `registry` unless it has it. */\nfunction cameraKind(registry: Registry): void {\n  if (registry.kinds().includes('camera')) return;\n  registry.defineKind('camera', {\n    description: \"A game's own camera mode: its code cam3=<name>[,…] and the function that makes it (engine/gfx/cameras/define.ts).\", // prettier-ignore\n    fields: CAMERA_FIELDS,\n    defineWith: \"defineCamera('<name>', { description, create })\",\n    check: (entry) => {\n      const id = String(entry.id);\n      if (!/^[a-z][a-zA-Z0-9]*$/.test(id)) return [`its name ${id} is not a word (letters and digits, a small letter first)`]; // prettier-ignore\n      return CAMERA_NAMES.includes(id) ? [`${id} is an engine camera's name: choose another`] : [];\n    },\n  });\n}\n\n/** Adds a game's camera mode on `registry` (the shared one by default). Throws `CORE_BAD_SPEC` naming each problem. */\nexport function defineCamera(name: string, spec: CameraKindSpec, registry: Registry = sharedRegistry): Entry {\n  cameraKind(registry);\n  return registry.def('camera', name, spec as unknown as Record<string, unknown>);\n}\n\n/** What a game camera's `create` returned, checked: a camera, else `GFX_BAD_GAME_CAMERA` naming the camera. */\nexport function madeCamera(name: string, made: unknown): Camera {\n  const camera = made as Partial<Record<keyof Camera, unknown>> | null;\n  const methods = ['update', 'pose', 'yaw', 'spec', 'code', 'describe'] as const;\n  if (camera && typeof camera === 'object' && methods.every((key) => typeof camera[key] === 'function')) return made as Camera; // prettier-ignore\n  const value = made === null || typeof made !== 'object' ? String(made) : `an object with ${Object.keys(made).join(', ') || 'nothing'}`; // prettier-ignore\n  throw codeError('GFX_BAD_GAME_CAMERA', { name, value });\n}\n\n/** The game camera named `name` on `registry`, or undefined. */\nexport function cameraEntry(name: string, registry: Registry = sharedRegistry): (Entry & CameraKindSpec) | undefined {\n  if (!registry.kinds().includes('camera') || !registry.has('camera', name)) return undefined;\n  return registry.get('camera', name) as Entry & CameraKindSpec;\n}\n/**\n * @file The chase camera (PLAN.md WP 3.9, §6.1; doctrine: Common ground, Quality under the hood): a perspective camera\n * on a spring arm behind and above the hero, turned by the devices, that slides in front of a wall rather than through\n * it, as Unreal's spring arm and Cinemachine's third-person follow do. `stepChase` and `chasePose` are the pure steps;\n * `createChaseCamera` wraps them in a camera.\n *\n * The arm hangs from a pivot `CHASE_HEIGHT` above `input.follow` (the hero's feet), which follows with a time constant\n * of `CHASE_LAG` real seconds, and runs back against the view direction (`yaw`, `pitch`) for `distance`. `input.look`\n * and `input.turn` turn the view right and up; `input.zoom` steps the arm in by `ORBIT_ZOOM_STEP`.\n *\n * Walls (engine/gfx/cameras/collide.ts): through the sim's read-only `QueryView` (`input.queries`), a ball of\n * `CHASE_RADIUS` is swept from the hero's head (the pivot before its lag) to the pivot, then cast along the arm, and\n * stops short of the first surface of `input.groups` (`world` by default; `input.exclude` skips his own body). The arm\n * snaps in at once and eases back out with a time constant of `CHASE_RETURN`, never past what the casts left clear.\n * Without `queries` nothing shortens it.\n *\n * Invariants: with `queries`, and the hero's head at least `CHASE_RADIUS` from every wall (a character's capsule is\n * wider), the camera's ball, so its near plane, never ends inside a wall, and the line from the head to the camera is\n * clear (chase.test.ts walks fixtures/scenes/chase-walls/ to prove it). The pitch stays within `CHASE_LIMITS.pitch`,\n * the arm within `CHASE_LIMITS.distance`. Pure: each step returns a new state.\n *\n * Codes: `cam3=chase[,<yaw>,<pitch>,<distance>]` (degrees, metres; a bare one keeps the last camera's heading). Until\n * codes.ts reads WP 3.9's cameras, this file holds what they share: `readCode`, `codeNumber`, `followCamera`.\n *\n * Carried from `my-3d2dge:src/stress-world/40-cameras.js:84-94` (`chasePose`: the arm, its pitch, lens and lag, the\n * pull in front of a wall) and `:37` (its numbers), in metres and +Y up, the height-map march replaced by ball casts.\n *\n * @example\n * import { startScene } from '../../sim/scene';\n * import { queryViewOf } from '../../sim/queryView';\n * import chaseWalls from '../../../fixtures/scenes/chase-walls';\n * const chase = createChaseCamera();\n * const pose = chase.update({ follow: [2, 0, 3] }, 1 / 60); // the first follow snaps to the hero\n * pose.position; // [2, 3.44…, -2.15…]: 5.5 m back from 1.5 m above his feet, looking along +Z and 20.6° down\n * chase.code(); // 'cam3=chase,0,-20.63,5.5'\n * const { world } = startScene(chaseWalls);\n * world.step({}); // queries see the level from the first step\n * createChaseCamera().update({ follow: [1.5, 0, 1.5], queries: queryViewOf(world) }).distance; // 0.299…: a wall behind\n * @see engine/gfx/cameras/chase.test.ts\n */\nimport { codeError, didYouMean } from '../../core/log';\nimport { MathUtils } from '../../core/math';\nimport { COLLIDE_RADIUS, COLLIDE_RETURN, COLLIDE_SKIN, easeArm, reach, sweep, type Walls } from './collide';\nimport type { EffectWeights } from './effects';\nimport { ORBIT_ZOOM_STEP } from './orbit';\nimport {\n  approach,\n  makePose,\n  poseForward,\n  rangeProblems,\n  refuse,\n  wrapAngle,\n  type Camera,\n  type CameraInput,\n  type CameraPose,\n  type Vec3,\n} from './pose';\n\nconst DEG = MathUtils.DEG2RAD;\n\n/** The arm's starting pitch (rad, + up), length (m) and the lens (degrees, `PerspectiveCamera.fov`). */\nexport const CHASE_DEFAULTS = Object.freeze({ pitch: -0.36, distance: 5.5, fov: 60 });\n/** The range of the pitch (rad) and the arm's length (m). */\nexport const CHASE_LIMITS = Object.freeze({ pitch: [-1.4, 1] as const, distance: [0.5, 20] as const });\n/** The pivot's height above the followed point, m: the hero's head. */\nexport const CHASE_HEIGHT = 1.5;\n/** The time constant of the pivot's follow, real seconds. */\nexport const CHASE_LAG = 1 / 12;\n/** The time constant of the arm easing back out after a wall, real seconds: collide.ts's `COLLIDE_RETURN`. */\nexport const CHASE_RETURN = COLLIDE_RETURN;\n/** The radius of the ball cast along the arm, m: collide.ts's `COLLIDE_RADIUS`. */\nexport const CHASE_RADIUS = COLLIDE_RADIUS;\n/** How far short of a surface the ball stops, m: collide.ts's `COLLIDE_SKIN`. */\nexport const CHASE_SKIN = COLLIDE_SKIN;\n/** Turn rates at full `input.turn`, rad/s: `[right, up]` (the prototype's [ ] keys turn 2.2). */\nexport const CHASE_TURN_SPEED = Object.freeze([2.2, 1.2] as const);\n/** The chase camera's near plane, m. */\nconst NEAR = 0.05;\n\n/** A chase camera's input: the devices' and the hero's, and the walls it keeps out of (collide.ts). */\nexport interface ChaseInput extends CameraInput, Walls {}\n\n/** A chase camera's code as data: without the numbers it keeps the heading of the camera before it. */\nexport interface ChaseSpec {\n  readonly type: 'chase';\n  /** The heading, rad (the intents' `cam`). */\n  readonly yaw?: number;\n  /** Rad, + up. */\n  readonly pitch?: number;\n  /** The arm's length when nothing is in the way, m. */\n    fix: 'give createStore a migrate(data, version) that turns the old value into the current one, or let the reader fall back to its default (the old value stays until set replaces it)',\n    doc: 'Advice from the store (engine/app/store.ts), once per key: a kept value written in another format or version is not handed back as it is.',\n  },\n  APP_STORE_BLOCKED: {\n    template:\n      'the page refused its storage ({reason}), so the store {prefix} keeps its values in memory for this page only',\n    fix: \"allow the site's storage (a private window or a blocked cookie setting refuses it); the game still runs, and forgets on reload\",\n    doc: 'Advice from the store (engine/app/store.ts), once: `localStorage` threw when touched, so nothing is kept across sessions.',\n  },\n  APP_BAD_STORE: {\n    template: '{where}: {problem}',\n    fix: 'give a prefix and keys as non-empty strings, a version as a whole number from 1, a mode of play, demo, sandbox or gallery, and values that are plain data (JSON)',\n    doc: 'Raised by the store (engine/app/store.ts) for a bad option, key or value; storage itself never makes it throw.',\n  },\n});\n\n/** The envelope's format tag. */\nexport const STORE_FORMAT = 'my3dge-store/1';\n\n/** Whose play a store keeps: `play` the player's; the others keep nothing past the page (see the file comment). */\nexport const STORE_MODES = ['play', 'demo', 'sandbox', 'gallery'] as const;\n\n/** One of `STORE_MODES`: whose play a store keeps. */\nexport type StoreMode = (typeof STORE_MODES)[number];\n\n/** Where a store writes: the Web Storage calls it uses (`localStorage` is one). */\nexport interface StoreBackend {\n  getItem(key: string): string | null;\n  setItem(key: string, value: string): void;\n  removeItem(key: string): void;\n  readonly length: number;\n  key(index: number): string | null;\n}\n\n/** How a store is made (see the file comment). */\nexport interface StoreOptions {\n  /** Put before every key (`my3dge:`): the game's own keeps games on one origin apart. */\n  prefix?: string;\n  /** The values' version (1); a value of another is migrated or falls back. */\n  version?: number;\n  /** Whose play it keeps (`play`). */\n  mode?: StoreMode;\n  /** Where it writes: the page's `localStorage` by default (memory without one). */\n  backend?: StoreBackend;\n  /** Turns a value kept at `version` into the current one. */\n  migrate?(data: unknown, version: number): unknown;\n  /** Where the advice goes (the shared log). */\n  log?: Log;\n}\n\n/** A store (see the file comment). */\n","exit_code":0,"status":"completed"}}
