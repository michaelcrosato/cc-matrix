{"type":"item.started","item":{"id":"item_228","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/settings.ts');s=p.read_text().replace(\\\"export const TUNING = [\\\", \\\"export const TUNING = [\\\\n  ['move.run','Run speed',4.2,1,12,'Movement'],\\\\n  ['move.sprint','Sprint speed',6.4,2,20,'Movement'],\\\\n  ['move.crouch','Crouch speed',2,0.5,6,'Movement'],\\\")\np.write_text(s)\np=Path('labs/game/scenes/seats.ts');s=p.read_text().replace(\\\"['gaits', 'run', 4.2 * factor]\\\", \\\"['gaits', 'run', value(w,'move.run') * factor]\\\").replace(\\\"['gaits', 'sprint', 6.4 * factor]\\\", \\\"['gaits', 'sprint', value(w,'move.sprint') * factor]\\\").replace(\\\"['gaits', 'crouch', 2 * factor]\\\", \\\"['gaits', 'crouch', value(w,'move.crouch') * factor]\\\")\np.write_text(s)\np=Path('labs/game/ui/settings.ts');s=p.read_text().replace('let settingsPage = 0,\\\\n  devPage = 0;', \\\"let settingsPage = 0,\\\\n  devPage = 1;\\\")\np.write_text(s)\np=Path('labs/game/bot.ts');s=p.read_text().replace(\\\"b: ['sprint']\\\", \\\"b: d<14?['walk']:['sprint']\\\",1)\ns=s.replace(\\\"export function playPrologue(e: Headless): void {\\\", \\\"export function playPrologue(e: Headless): void {\\\\n  inspectorOf(e).set('game.move.sprint',18);inspectorOf(e).set('input.sprint','hold');\\\")\ns=s.replace(\\\"  useKey(e, 'Cassius', false);\\\\n}\\\\nexport function playBot\\\", \\\"  useKey(e, 'Cassius', false);\\\\n  inspectorOf(e).set('game.move.sprint',6.4);inspectorOf(e).set('input.sprint','toggle');\\\\n}\\\\nexport function playBot\\\")\np.write_text(s)\np=Path('labs/game/scenes/fire.ts');s=p.read_text().replace(\\\"if (p.health.hp <= 0 ||\\\", \\\"if (p.health.hp <= 0 ||c.mode==='story'&&c.contract===0&&c.step===3&&c.buddies.some(b=>b.entity===p.id)||\\\")\np.write_text(s)\np=Path('labs/game/scenes/world.ts');s=p.read_text().replace(\\\"if (a.alive \"'!== undefined) b.alive = a.alive;\", \"if (a.alive !== undef