<= 0) return;\n  const s = p.seat!.data;\n  if (r.driver >= 0) {\n    s.vehicle = id;\n    s.mounted = true;\n    mark(w, 'mounted gun');\n  } else {\n    r.driver = p.id;\n    s.vehicle = id;\n    s.mounted = false;\n    mark(w, r.kind === 'boat' ? 'boat' : 'drive');\n  }\n  p.weapons.slot = -1;\n  if (r.blocker >= 0) {\n    physicsOf(w).removeBody(r.blocker);\n      },\n      {\n        name: 'work',\n        seconds: seconds * 0.5,\n        effectors: { handL: left, handR: [right[0] - 0.08, right[1] + 0.04, right[2] - 0.07] },\n      },\n      { name: 'release', seconds: seconds * 0.2 },\n    ],\n  });\n93:    if (p && p.seat && p.seat.data.vehicle >= 0)\n94:      audio.play('sfx:field-engine', { bus: 'ambience', pitch: 0.7 + Math.hypot(p.actor.vx, p.actor.vz) / 30 });\n159:const tires = [-1, 1].flatMap((x) =>\n172:    ...tires,\n","exit_code":0,"status":"completed"}}
