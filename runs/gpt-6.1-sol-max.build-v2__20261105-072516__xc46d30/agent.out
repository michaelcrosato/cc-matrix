{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"rg --files engine | rg 'props|physics/(world|api|types)|grammar|actions.ts|terrain' | head -35; rg -n 'applyImpulse|setBody|body\\\\(' engine/physics/api.ts; sed -n '25,90p' .cache/engine-src/labs/playground/levels/yard.ts; cat engine/input/intents.ts | head -100\"","aggregated_output":"engine/gfx/props.ts\nengine/sim/reactions.ts\nengine/sim/props.ts\nengine/physics/world.ts\nengine/gfx/terrainSplat.ts\nengine/dev/actions.ts\nengine/gfx/terrain.ts\nengine/world/terrainNav.ts\nengine/world/props/fittings.ts\nengine/world/props/catalog.ts\nengine/world/props/prop.ts\nengine/world/props/place.ts\nengine/world/props/library.ts\nengine/world/terrain.ts\nengine/gfx/puppets/grammar.ts\nengine/anim/actions.ts\nengine/anim/reactions.ts\nrg: engine/physics/api.ts: IO error for operation on engine/physics/api.ts: No such file or directory (os error 2)\nimport './house'; // the counter's glyph, which the shelter's counter is\nimport { levelText, Plan } from './plan';\n\n/** The yard's tile (m). */\nexport const YARD_TILE = 0.5;\n\n/** How high each deck stands over the ground it is on (m). */\nexport const DECK_HEIGHT = { treehouse: 4, lookout: 3 } as const;\n\n/** A post: one tile, solid, up to the storey above, drawn as the engine's pillar. */\nconst POST = '(';\n/** A ring post: a block 2.2 m high at a corner of the canvas. */\nconst RING_POST = ']';\n/** A ladder whose foot stands on the ground: the engine's ladder (`|`), drawing no floor, the ground being its floor. */\nconst FOOT_LADDER = '*';\n\ndefineGlyph('glyph:playground-post', { char: POST, description: 'A post, half a metre square, up to the storey above: what holds a deck or a roof.', top: 3, solid: true, collider: 'box', mesh: 'pillar', full: true, nav: { walkable: false } }); // prettier-ignore\ndefineGlyph('glyph:playground-footLadder', { char: FOOT_LADDER, description: \"A ladder whose foot stands on the ground: the engine's ladder (|) with no floor drawn, the terrain under it being its floor (a floor in the ground's plane z-fought the grass).\", mesh: 'none', ladder: true }); // prettier-ignore\ndefineGlyph('glyph:playground-ringPost', { char: RING_POST, description: \"A corner post of the ring, 2.2 m from the ground: 1.2 m over its canvas.\", top: 2.2, solid: true, collider: 'box', mesh: 'pillar', nav: { walkable: false } }); // prettier-ignore\n\n/** A one-storey building's text: its map under a flat roof, `height` m clear. */\nconst flatRoofed = (description: string, plan: Plan, height: number) =>\n  levelText({ description, tile: YARD_TILE }, [{ keys: { storey: 'ground', base: 0, height, roof: 'flat' }, plan }]);\n\n/** The shed (see the file comment). */\nexport const SHED_TEXT = flatRoofed(\n  \"The backyard's shed on 0.5 m tiles, 3 × 4 m and 2.5 m high under a flat roof bodies stand on, a door and a window.\",\n  new Plan(3, 4, YARD_TILE).box([0, 0, 3, 4], '#', '.').line([1, 3.5, 2, 4], '+').line([2.5, 1, 3, 2], ':'),\n  2.5,\n);\n\n/** A deck `height` m up on four posts, 4 × 4 m, railed but at its ladder, which comes up its north edge. */\nfunction deckText(description: string, height: number): string {\n  const posts = new Plan(5, 4.5, YARD_TILE); // the ground: void but the posts and the ladder\n  for (const [x, z] of [[0.5, 0.5], [4, 0.5], [0.5, 4], [4, 4], [2, 0.5]] as const) posts.fill([x, z, x + YARD_TILE, z + YARD_TILE], POST); // prettier-ignore\n  posts.fill([2, 0, 2.5, 0.5], FOOT_LADDER); // against the middle post of the north edge, up to the deck\n  const deck = new Plan(5, 4.5, YARD_TILE).box([0.5, 0.5, 4.5, 4.5], '!', '.').fill([2, 0.5, 2.5, 1], '.');\n  return levelText({ description, tile: YARD_TILE }, [\n    { keys: { storey: 'posts', base: 0, height: height - 0.3 }, plan: posts },\n    { keys: { storey: 'deck', base: height, height: 2.5 }, plan: deck },\n  ]);\n}\n\n/** The tree house's level text (see the file comment). */\nexport const TREEHOUSE_TEXT = deckText(\"The backyard's tree house: a 4 × 4 m deck 4 m up on four posts, railed, its ladder up its north edge.\", DECK_HEIGHT.treehouse); // prettier-ignore\n/** The lookout's level text: the tree house's deck, lower, on the hilltop. */\nexport const LOOKOUT_TEXT = deckText(\"The hill's lookout: a 4 × 4 m deck 3 m up on four posts, railed, its ladder up its north edge.\", DECK_HEIGHT.lookout); // prettier-ignore\n\n/** The range's shelter (see the file comment). */\nexport const SHELTER_TEXT = flatRoofed(\n  \"The range's covered bench on 0.5 m tiles: 4 × 10 m and 2.5 m high on four posts under a flat roof, its counter facing the lanes, east.\", // prettier-ignore\n  new Plan(4, 10, YARD_TILE)\n    .fill([0, 0, 4, 10], '.')\n    .fill([3.5, 1, 4, 9], '[') // the counter (the house's glyph, 0.9 m) along its east edge, facing the lanes\n    .fill([0, 0, 0.5, 0.5], POST)\n    .fill([3.5, 0, 4, 0.5], POST)\n    .fill([0, 9.5, 0.5, 10], POST)\n    .fill([3.5, 9.5, 4, 10], POST),\n  2.5,\n);\n\n/** The ring (see the file comment): format 1, its heights the engine's gallery (1 m) and stairs. */\nexport const RING_TEXT = `---\ndescription: The ring on 0.5 m tiles, on a pad 8 × 9 m: a canvas 6 × 6 m and 1 m up, steps up its south side, a post 2.2 m high at each corner.\ntile: ${YARD_TILE}\n---\n/**\n * @file The intents vocabulary (PLAN.md §6.4, §6.5 item 3, §8.4, WP 1.5; doctrine: Reproducible): everything the sim\n * reads from outside arrives once per step as plain data, recorded by replays. `move` is a world-space direction\n * `[x, z]` (`fromCamera` turns a stick or keys into one, so W walks away from the camera), `cam` the camera heading,\n * `aim` a world-space aim point, `look` a view direction, `b` the buttons held and `p` the buttons pressed this step,\n * and game code adds its own keys, namespaced (`'game:charge'`). Devices (WP 3.3) make intents; the sim only reads them.\n *\n * Invariants: `normalizeIntents` checks every key and value (an unknown key names the closest; numbers are finite;\n * custom values are plain data) and returns a frozen object with keys in a fixed order, buttons sorted and unique, and\n * absent or empty entries left out. `p` is the union of the presses given and the edges of `b` (held now, not held the\n * step before), so a press is never lost and a hold presses once; when one frame runs several steps, the frame loop\n * passes its taps to the first step only (§6.4). `diffIntents` and `applyIntents` are the replay encoding (§8.4): held\n * state repeats until a change-point changes it (`null` clears a key), `p` belongs to its step and is written only for\n * presses the edges of `b` do not explain, so `applyIntents(prev, diffIntents(prev, next))` is `next` again. `-0` is\n * kept (`Object.is`), since replays must give the sim the very bits live play gave it.\n *\n * `cam` is the yaw of the camera's horizontal view direction, forward(ψ) = (sin ψ, 0, cos ψ) (§6.3), not three.js's\n * `camera.rotation.y`, which is ψ − π since a camera looks down its −Z.\n *\n * Edges, buffering and `consume` in sim time (WP 3.3): an `InputBuffer` is what a body remembers of its buttons across\n * steps, plain data in a component field, so the world hashes, captures and restores it. `updateInputBuffer(buffer,\n * intents, w.tick)` runs once per step (a system in the phase `intents`); then `released` says a button went up this\n * step (a tap shorter than a step is pressed and released on the same one), `buffered` that it was pressed within the\n * last `BUFFER_STEPS` steps and not yet used up by `consume` (a jump pressed just before landing still jumps), and\n * `repeated` that a held button repeats, as a menu cursor does. Carried from `my-3d2dge:engine/my-3d2dge.js:564-583`\n * (`released`, `repeat`, `buffered`, `consume`, `consumeAll`), counted in steps instead of seconds.\n *\n * @example\n * const step1 = normalizeIntents({ move: fromCamera(Math.PI / 2, [0, 1]), b: ['jump'] }); // move ≈ [1, 0]: +X\n * pressed(step1, 'jump'); // true: an edge of b\n * const step2 = normalizeIntents({ move: step1.move, b: ['jump'] }, step1);\n * [held(step2, 'jump'), pressed(step2, 'jump')]; // [true, false]\n * diffIntents(step1, normalizeIntents({}, step1)); // { b: null, move: null }\n * const buffer = updateInputBuffer(createInputBuffer(), step1, 1);\n * buffered(buffer, 'jump'); // true for 9 steps, or until consume(buffer, 'jump')\n * @see engine/input/intents.test.ts\n * @see engine/input/buffer.test.ts\n */\nimport { codeError, defineCodes, didYouMean } from '../core/log';\nimport { isPlainObject, show } from '../core/schema';\n\n/** The codes this module raises, with their fixes. */\nexport const INTENT_CODES = defineCodes('input', {\n  INPUT_BAD_INTENTS: {\n    template: '{where}: {problems}',\n    fix: 'give intents as { move: [x, z], cam, aim: [x, y, z], look: [yaw, pitch], b: [held buttons], p: [pressed buttons] } with finite numbers, plus custom keys namespaced \"game:key\" holding plain data (engine/input/intents.ts); null or a missing key means not given',\n    doc: 'Raised by `normalizeIntents`, `applyIntents` and the replay checks (engine/input/intents.ts, engine/sim/replay.ts) for an unknown key (named with the closest), a non-finite or misshapen number, a button that is not a non-empty string, or a custom value that is not plain data. Every problem is listed at once.',\n  },\n});\n\n/** A custom intent's value: plain data, as a replay file holds it. */\nexport type IntentValue = number | string | boolean | readonly IntentValue[] | { readonly [key: string]: IntentValue };\n\n/** A namespaced key for game code's own intents: `'game:charge'`. */\nexport type CustomIntentKey = `${string}:${string}`;\n\n/** One step's intents, as the sim reads them (systems get them as their second argument). */\nexport type Intents = {\n  /** The direction to move in, world space `[x, z]`, length 1 at most from `fromCamera`. */\n  readonly move?: readonly [number, number];\n  /** The camera heading: the yaw of its horizontal view direction, rad (see the file comment). */\n  readonly cam?: number;\n  /** The point aimed at, world space `[x, y, z]`, m. */\n  readonly aim?: readonly [number, number, number];\n  /** The view direction `[yaw, pitch]`, rad (first-person look). */\n  readonly look?: readonly [number, number];\n  /** The buttons held this step, sorted. */\n  readonly b?: readonly string[];\n  /** The buttons pressed this step (edges of `b` plus taps released within the step), sorted. */\n  readonly p?: readonly string[];\n} & { readonly [key: CustomIntentKey]: IntentValue | undefined };\n\n/** A replay change-point's intent part: the keys that changed, `null` for a key cleared, `p` for unexplained presses. */\nexport type IntentChanges = { -readonly [K in keyof Intents]?: Intents[K] | null };\n\n/** The built-in keys, in the order a normalized object holds them, each with what it means. */\nexport const INTENT_KEYS = {\n  move: 'the direction to move in, world space [x, z]',\n  cam: 'the camera heading (yaw of its view direction), rad',\n  aim: 'the point aimed at, world space [x, y, z], m',\n  look: 'the view direction [yaw, pitch], rad',\n  b: 'the buttons held, sorted',\n  p: 'the buttons pressed this step, sorted',\n} as const;\n\n/** A built-in key. */\nexport type IntentKey = keyof typeof INTENT_KEYS;\n\n/** No intents: what a step gets when nothing is given. */\nexport const NO_INTENTS: Intents = Object.freeze({});\n\n/** A namespaced key: a lower-case word, a colon, a name. */\nconst CUSTOM = /^[a-z][A-Za-z0-9]*:[A-Za-z0-9_.-]+$/;\n\n/** The namespaced key a bad one most likely means: `'Game:x'` → `'game:x'`, `'charge'` → `'game:charge'`. */\nfunction customKey(key: string): string {\n  const at = key.indexOf(':');\n  const space = (at < 0 ? '' : key.slice(0, at)).replace(/[^A-Za-z0-9]/g, '').replace(/^[^A-Za-z]+/, '');\n  const name = (at < 0 ? key : key.slice(at + 1)).replace(/[^A-Za-z0-9_.-]/g, '');\n  return `${space ? space[0].toLowerCase() + space.slice(1) : 'game'}:${name || 'key'}`;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"rg -n 'export interface Health|export const HEALTH_FIELDS' engine/sim/damage.ts; sed -n '35,100p' engine/sim/damage.ts; rg -n 'export interface Physics|applyImpulse|setBody|body\\\\(' engine/physics/world.ts | head -35; sed -n '35,95p' engine/world/props/prop.ts; sed -n '20,70p' .cache/engine-src/labs/playground/levels/plan.ts; sed -n '1,60p' engine/world/movement.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"rg -n 'export interface Health|export const HEALTH_FIELDS' engine/sim/damage.ts; sed -n '35,100p' engine/sim/damage.ts; rg -n 'export interface Physics|applyImpulse|setBody|body\\\\(' engine/physics/world.ts | head -35; sed -n '35,95p' engine/world/props/prop.ts; sed -n '20,70p' .cache/engine-src/labs/playground/levels/plan.ts; sed -n '1,60p' engine/world/movement.ts\"","aggregated_output":"50:export const HEALTH_FIELDS = defineSchema({\n62:export interface Health {\n * const health = { ...HEALTH, hp: 3 };\n * damage(w, { id: 4, health }, { amount: 5, from: [0, 0, 0], stop: 0.06 }); // { killed: true, hp: -2, … }; an agent's body is also knocked\n * takeHitStop(w); // 0.06: the host hands it to its frame clock (clock.hitStop), once\n * takeHitStop(w); // 0: taken\n * @see engine/sim/damage.test.ts\n */\nimport type { EventMap } from '../core/events';\nimport { codeError } from '../core/log';\nimport { copyValue, defineSchema, freezeValue, isPlainObject, show } from '../core/schema';\nimport { killAgent, knockback, launch, type CrowdAgent } from '../physics/crowd';\nimport type { Vec3Like } from '../physics/queries';\nimport { physicsOf } from '../physics/binding';\nimport type { World } from './world';\n\n/** A target's health, for a scene's component: `defineComponent('health', { description, fields: HEALTH_FIELDS })`. */\nexport const HEALTH_FIELDS = defineSchema({\n  hp: { type: 'number', default: 1, description: 'Hit points left: at 0 or below, it is dead.' },\n  hitAt: {\n    type: 'integer',\n    default: -1,\n    minimum: -1,\n    description: 'The step it was last hit (w.tick; −1: never): flinches, stuns and flashes count from it.',\n  },\n  hitBy: { type: 'integer', default: -1, minimum: -1, description: 'Who hit it last (an entity id; −1: unknown).' },\n});\n\n/** A target's health (`HEALTH_FIELDS` says what each field means). */\nexport interface Health {\n  hp: number;\n  hitAt: number;\n  hitBy: number;\n}\n\n/** Health with every field at its default: 1 hit point, never hit. */\nexport const HEALTH: Readonly<Health> = freezeValue(\n  Object.fromEntries(\n    Object.entries(HEALTH_FIELDS).map(([key, field]) => [key, copyValue(field.default)]),\n  ) as unknown as Health,\n);\n\n/** What a hit lands on: the entity (named in the events), its health and its crowd body, either optional. */\nexport interface DamageTarget {\n  readonly id: number;\n  readonly health?: Health | null;\n  readonly agent?: CrowdAgent | null;\n}\n\n/** A hit as the rules decided it. Speeds are what the body gains, the same for every mass (m/s). */\nexport interface HitSpec {\n  /** Hit points it takes (0). */\n  readonly amount?: number;\n  /** Where the blow comes from (m): the attacker's feet, a projectile's centre. The push points away from it. */\n  readonly from: Vec3Like;\n  /** The push's direction instead (a projectile's flight): only its part along the ground counts. */\n  readonly direction?: Vec3Like;\n  /** Where it struck, for the event (m): the middle of the crowd body by default, else `from`. */\n  readonly at?: Vec3Like;\n  /** Who hit (an entity id; −1). */\n  readonly source?: number;\n  /** The push across the ground (m/s; 0). */\n  readonly knockback?: number;\n  /** The throw: its upward speed becomes at least this (m/s; 0). */\n  readonly launch?: number;\n  /** When it kills: the kill launch's upward speed (m/s; 0) and how much its speed across the ground grows (×; 1). */\n  readonly kill?: { readonly launch?: number; readonly carry?: number };\n  /** The hit-stop it asks for (s; 0): the frame clock's budget decides how much it gets. */\n13: * math classes, and `setBody`, `applyImpulse` and `removeBody` change it. Shapes and vectors are those of\n151:/** The changes `setBody` makes; each wakes the body. */\n160:export interface PhysicsStepper {\n166:export interface Physics {\n180:  setBody(id: number, change: BodyChange): void;\n182:  applyImpulse(id: number, impulse: Vec3Like, point?: Vec3Like): void;\n310:    removeBody: (id) => world.removeRigidBody(body(id)),\n314:      const b = body(id);\n327:    setBody(id, change) {\n328:      const b = body(id);\n331:        'setBody(id, change)',\n337:        position: position && vec(position, 'setBody({ position })'),\n338:        rotation: rotation && quat(rotation, 'setBody({ rotation })'),\n339:        velocity: velocity && vec(velocity, 'setBody({ velocity })'),\n340:        angularVelocity: angularVelocity && vec(angularVelocity, 'setBody({ angularVelocity })'),\n347:    applyImpulse(id, impulse, point) {\n348:      const b = body(id);\n349:      const push = vec(impulse, 'applyImpulse(impulse)');\n350:      if (point === undefined) b.applyImpulse(push, true);\n351:      else b.applyImpulseAtPoint(push, vec(point, 'applyImpulse(point)'), true);\n * @see engine/world/props/prop.test.ts\n */\nimport { galleryField } from '../../core/gallery';\nimport { registry as sharedRegistry, type Entry, type Registry } from '../../core/registry';\nimport type { EntryOf, Schema } from '../../core/schema';\nimport type { Point3 } from '../level/types';\nimport { BUILT_IN_PROPS } from './catalog';\nimport { FITTING_PROPS } from './fittings';\nimport { LIBRARY_PROPS } from './library';\n\n/** A vector field in metres (or `unit`), three numbers. */\nconst vec3 = (value: readonly number[], description: string, unit = 'm') =>\n  ({ type: 'array', items: { type: 'number' }, default: value, unit, description }) as const;\n\n/** A length in metres, at least 0. */\nconst metres = (value: number, description: string) =>\n  ({ type: 'number', default: value, minimum: 0, unit: 'm', description }) as const;\n\n/** The object of `properties`' defaults: a nested field's default, so a spec leaving it out gets every key. */\nconst defaultsOf = (properties: Schema): Record<string, unknown> =>\n  Object.fromEntries(Object.entries(properties).map(([key, field]) => [key, field.default]));\n\n/** The fields of a part's flame. */\nconst FLAME_FIELDS = {\n  tongues: { type: 'integer', default: 0, minimum: 0, maximum: 8, description: 'How many tongues; 0: still.' },\n  ring: metres(0.1, 'How far from its origin the tongues stand.'),\n  height: metres(0.4375, \"A tongue's mean height; it dances about half of it either way.\"),\n  sway: metres(0.0875, 'How far a tongue sways sideways, leaning 3 rad per metre of sway.'),\n  core: { type: 'string', default: '#ffd36a', description: 'The colour of the core inside each tongue, hex.' },\n} as const satisfies Schema;\n\n/** The fields of one part: a mesh of the prop. */\nexport const PROP_PART_FIELDS = {\n  name: {\n    type: 'string',\n    default: 'mesh',\n    description: 'Its name, unique in the prop: the ID pass names its batch `<prop>/<name>` (prop:crate/mesh).',\n  },\n  geometry: {\n    type: 'string',\n    default: 'geometry:box',\n    description: 'Its geometry by id (engine/gfx/geometry), standing on the ground, in metres.',\n  },\n  params: { type: 'object', default: {}, description: \"The geometry's parameters; the rest keep their defaults.\" },\n  material: {\n    type: 'string',\n    default: 'material:default',\n    description: 'Its material by id (engine/gfx/materials): on every face, or on its sides when top names another.',\n  },\n  top: {\n    type: 'string',\n    default: '',\n    description: \"A material for its tops and bottoms (faces within 45° of up or down: a barrel's lids); '' for none.\",\n  },\n  tint: { type: 'string', default: '#ffffff', description: 'A colour multiplying the material, hex, per instance.' },\n  position: vec3([0, 0, 0], \"Where its origin stands in the prop's frame (the base at 0, +Y up).\"),\n  rotation: vec3([0, 0, 0], 'Its turn in the prop’s frame, Euler angles about X, Y then Z.', 'rad'),\n  shadow: { type: 'boolean', default: true, description: 'Whether it casts shadows (every part receives them).' },\n  lit: {\n    type: 'boolean',\n    default: false,\n/** A rectangle of a plan, [x0, z0, x1, z1] (m). */\nexport type Rect = readonly [x0: number, z0: number, x1: number, z1: number];\n\n/** One storey's block: its keys (`storey`, `base`, `height`, a roof's) and its plan. */\nexport interface StoreyBlock {\n  readonly keys: Readonly<Record<string, string | number>>;\n  readonly plan: Plan;\n}\n\n/** One storey's map, painted in rectangles (see the file comment). */\nexport class Plan {\n  /** The map's width, west to east, and depth, north to south, and its tile (m). */\n  readonly width: number;\n  readonly depth: number;\n  readonly tile: number;\n  readonly #rows: string[][];\n\n  constructor(width: number, depth: number, tile: number, fill = '~') {\n    [this.width, this.depth, this.tile] = [width, depth, tile];\n    const [cols, rows] = [this.#tiles(width, 'width'), this.#tiles(depth, 'depth')];\n    this.#rows = Array.from({ length: rows }, () => Array<string>(cols).fill(fill));\n  }\n\n  /** Paints every tile of `rect` with `char`. */\n  fill(rect: Rect, char: string): this {\n    const [c0, r0, c1, r1] = this.#cells(rect);\n    for (let r = r0; r < r1; r++) for (let c = c0; c < c1; c++) this.#rows[r][c] = char;\n    return this;\n  }\n\n  /** Paints `rect`'s edge one tile thick with `edge`, and its inside with `inside` when given. */\n  box(rect: Rect, edge: string, inside?: string): this {\n    const [x0, z0, x1, z1] = rect;\n    const t = this.tile;\n    if (inside !== undefined && x1 - x0 > 2 * t && z1 - z0 > 2 * t) this.fill([x0 + t, z0 + t, x1 - t, z1 - t], inside);\n    this.fill([x0, z0, x1, z0 + t], edge).fill([x0, z1 - t, x1, z1], edge);\n    return this.fill([x0, z0, x0 + t, z1], edge).fill([x1 - t, z0, x1, z1], edge);\n  }\n\n  /** Paints a run along a wall: `rect` one tile thick across it (a door's 1 m, a window's, a railing). */\n  line(rect: Rect, char: string): this {\n    return this.fill(rect, char);\n  }\n\n  /** The character at (x, z) (m). */\n  at(x: number, z: number): string {\n    return this.#rows[Math.floor(z / this.tile)][Math.floor(x / this.tile)];\n  }\n\n  /** The map, a row a line. */\n  get map(): string {\nsed: can't read engine/world/movement.ts: No such file or directory\n","exit_code":2,"status":"failed"}}
