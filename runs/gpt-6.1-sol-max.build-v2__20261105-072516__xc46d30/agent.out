{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"rg --files .cache/engine-src/labs/playground/sounds\nrg -n 'defineSong' engine/audio/data/*.ts | head -10\ncat engine/audio/data/songs.ts | head -110\nsed -n '110,190p' engine/app/engine.ts\nrg -n 'followCamera' -A52 engine/gfx/cameras/chase.ts | tail -60\"","aggregated_output":".cache/engine-src/labs/playground/sounds/effects.ts\n.cache/engine-src/labs/playground/sounds/page.test.ts\n.cache/engine-src/labs/playground/sounds/events.ts\n.cache/engine-src/labs/playground/sounds/page.ts\n.cache/engine-src/labs/playground/sounds/events.test.ts\n.cache/engine-src/labs/playground/sounds/ground.test.ts\n.cache/engine-src/labs/playground/sounds/ground.ts\nengine/audio/data/song.ts:4: * engine's five songs (songs.ts) are its entries; a game adds its own with `defineSong`, and `x new song` scaffolds one.\nengine/audio/data/song.ts:28: * const riff = defineSong('song:riff', { beats: 2, tracks: [{ notes: 'C4 - E4 - G4 - E4 -', wave: 'pluck' }] }, registry);\nengine/audio/data/song.ts:68:/** What `defineSong` takes: the tracks, and every other field optional. */\nengine/audio/data/song.ts:240:    defineWith: \"defineSong('<id>', { bpm: …, tracks: [{ wave: …, notes: 'C4 - E4 - …' }] })\",\nengine/audio/data/song.ts:252:export function defineSong(id: string, spec: SongSpec, registry: Registry = sharedRegistry): Song {\n/**\n * @file The engine's five songs as data (PLAN.md WP 9.2, I-23): original chiptune loops for a title screen, an\n * adventure, a dungeon, a boss fight and a victory jingle, each a `song` entry (engine/audio/data/song.ts) under the id\n * `song:<name>`.\n *\n * Invariants: the tracks are the source's, note for note, in its tracker notation (one token per step: a note such as\n * `C5`, `-` holding the previous note, `.` a rest, `|` a bar line). Each song is in 4/4 at four steps per beat, so a\n * bar is 16 steps, and every track fills whole bars or divides one (song.ts checks it). `song:victory` plays once.\n *\n * Carried from `my-3d2dge:engine/my-3d2dge.js:3838-3856` (`E.songs`).\n *\n * @example\n * SONGS['song:dungeon'].bpm; // 96\n * Object.keys(SONGS); // ['song:title', 'song:adventure', 'song:dungeon', 'song:boss', 'song:victory']\n * @see engine/audio/data/sounds.test.ts\n */\nimport type { SongSpec } from './song';\n\n/** The engine's songs by id. */\nexport const SONGS: Readonly<Record<string, SongSpec>> = {\n  'song:title': {\n    bpm: 112,\n    steps: 4,\n    tracks: [\n      {\n        wave: 'square',\n        vol: 0.16,\n        notes:\n          'C5 - - - G4 - C5 - E5 - - - D5 - C5 - | D5 - - - G4 - B4 - D5 - - - F5 - E5 - | E5 - - - C5 - E5 - G5 - - - A5 - G5 - | F5 - E5 - D5 - B4 - C5 - - - - - . .',\n      },\n      {\n        wave: 'triangle',\n        vol: 0.3,\n        notes:\n          'C3 - . C3 G2 - . G2 C3 - . C3 G2 - . G2 | G2 - . G2 D3 - . D3 G2 - . G2 D3 - . D3 | A2 - . A2 E3 - . E3 A2 - . A2 E3 - . E3 | F2 - . F2 G2 - . G2 C3 - . C3 G2 - . .',\n      },\n      { wave: 'drums', vol: 0.14, notes: 'k . h . s . h . k . h k s . h .' },\n    ],\n  },\n  'song:adventure': {\n    bpm: 138,\n    steps: 4,\n    tracks: [\n      {\n        wave: 'pulse',\n        vol: 0.15,\n        notes:\n          'E5 - G5 - A5 - - C6 B5 - A5 - G5 - E5 - | D5 - E5 - G5 - - A5 G5 - E5 - D5 - . . | E5 - G5 - A5 - - C6 D6 - C6 - A5 - G5 - | A5 - G5 - E5 - D5 - C5 - - - - - . .',\n      },\n      {\n        wave: 'square',\n        vol: 0.07,\n        notes:\n          'C5 . E5 . G5 . E5 . C5 . E5 . G5 . E5 . | B4 . D5 . G5 . D5 . B4 . D5 . G5 . D5 . | A4 . C5 . E5 . C5 . A4 . C5 . E5 . C5 . | F4 . A4 . C5 . A4 . G4 . B4 . D5 . B4 .',\n      },\n      {\n        wave: 'triangle',\n        vol: 0.32,\n        notes:\n          'C3 . C4 . C3 . C4 . C3 . C4 . C3 . C4 . | G2 . G3 . G2 . G3 . G2 . G3 . G2 . G3 . | A2 . A3 . A2 . A3 . A2 . A3 . A2 . A3 . | F2 . F3 . F2 . F3 . G2 . G3 . G2 . G3 .',\n      },\n      { wave: 'drums', vol: 0.15, notes: 'k . h . s . h h k . h . s . h o' },\n    ],\n  },\n  'song:dungeon': {\n    bpm: 96,\n    steps: 4,\n    tracks: [\n      {\n        wave: 'pulse12',\n        vol: 0.13,\n        notes:\n          'A4 - - - C5 - B4 - A4 - - - E4 - - - | F4 - - - A4 - G4 - E4 - - - - - . . | A4 - - - C5 - D5 - E5 - - - D5 - C5 - | B4 - - - G#4 - - - A4 - - - - - . .',\n      },\n      {\n        wave: 'triangle',\n        vol: 0.32,\n        notes:\n          'A2 - . . A2 . . . E2 - . . A2 . . . | F2 - . . F2 . . . E2 - . . E2 . . . | A2 - . . A2 . . . G2 - . . G2 . . . | E2 - . . E2 . . . A2 - . . A2 . . .',\n      },\n      { wave: 'drums', vol: 0.1, notes: 'k . . . h . . . k . k . h . . .' },\n    ],\n  },\n  'song:boss': {\n    bpm: 164,\n    steps: 4,\n    tracks: [\n      {\n        wave: 'saw',\n        vol: 0.09,\n        notes:\n          'D5 D5 . D5 F5 - D5 . D5 D5 . D5 A5 - F5 . | C5 C5 . C5 E5 - C5 . C5 C5 . C5 G5 - E5 . | Bb4 Bb4 . Bb4 D5 - F5 - Bb4 Bb4 . Bb4 F5 - D5 - | A4 - C#5 - E5 - A5 - G5 - E5 - C#5 - A4 -',\n      },\n      {\n        wave: 'square',\n        vol: 0.09,\n        notes:\n          'D4 . D4 . D4 . D4 . D4 . D4 . D4 . D4 . | C4 . C4 . C4 . C4 . C4 . C4 . C4 . C4 . | Bb3 . Bb3 . Bb3 . Bb3 . Bb3 . Bb3 . Bb3 . Bb3 . | A3 . A3 . A3 . A3 . A3 . A3 . C#4 . C#4 .',\n      },\n      {\n        wave: 'triangle',\n        vol: 0.32,\n        notes:\n          'D2 D3 D2 D3 D2 D3 D2 D3 D2 D3 D2 D3 D2 D3 D2 D3 | C2 C3 C2 C3 C2 C3 C2 C3 C2 C3 C2 C3 C2 C3 C2 C3 | Bb1 Bb2 Bb1 Bb2 Bb1 Bb2 Bb1 Bb2 Bb1 Bb2 Bb1 Bb2 Bb1 Bb2 Bb1 Bb2 | A1 A2 A1 A2 A1 A2 A1 A2 A1 A2 A1 A2 C#2 C#3 C#2 C#3',\n      },\n      { wave: 'drums', vol: 0.16, notes: 'k h s h k k s h k h s h k s s s' },\n    ],\n  },\n  'song:victory': {\n    bpm: 150,\n  scenes: readonly string[];\n  /**\n   * The levels the page's scenes load, by id: their text (Vite's `?raw` import), file and material swaps (the level\n   * entry's `materials`); registered unless already.\n   */\n  levels?: Readonly<Record<string, { text: string; file?: string; materials?: Readonly<Record<string, string>> }>>;\n  /** Replays the page offers by name (`?replay=<name>`): name → its text, loaded when asked for. */\n  replays?: Readonly<Record<string, () => Promise<string>>>;\n  /** The query to read (`location.search`). */\n  search?: string;\n  /** The hash to read (`location.hash`): a gallery deep link, `#gallery/<kind>/<id>` (engine/app/routes.ts). */\n  hash?: string;\n  /** Where scenes, levels, components, settings and materials are declared (the shared registry). */\n  registry?: Registry;\n  /** Where errors and advice go (the shared log). */\n  log?: Log;\n  /** The page's touch buttons, a `touchlayout` id (engine/ui/touch.ts); without it, only the touch stick shows. */\n  touchLayout?: string;\n  /**\n   * The action map the devices read (`actionMap:thirdPerson` by default): its actions are the intents' buttons. A\n   * function gives the map for the camera now (its code, `cam3=first,…`), so each camera mode has its own (WP 13.9).\n   */\n  actionMap?: string | ((camera: string) => string);\n  /** A view action of the map pressed (its `view`: a camera switch, a view's turn), as it happens (WP 13.9). */\n  onView?: (action: string) => void;\n  /** Opens the page's menu, called after the touch menu button has paused the game. */\n  onMenu?: () => void;\n  /** The page's own presentation (its sound): called once per drawn frame, after the draw, with the run to read. */\n  onFrame?: (frame: EngineFrame) => void;\n  /** Where the bindings are kept across sessions (`createStore`, engine/app/store.ts); in memory without it. */\n  store?: Store;\n  /** True while the page's front end holds the devices (a menu, a photo mode): no intent reaches the run. */\n  modal?: () => boolean;\n  /** Camera input laid over the devices' each drawn frame, field by field (a photo mode's fly keys and drag look). */\n  cameraInput?: () => CameraInput | undefined;\n}\n\n/** A started engine. */\nexport interface Engine {\n  /** The inspector, also `window.__engine`; null when the scene could not start. */\n  readonly inspector: Inspector | null;\n  /** True once the first frame is drawn; never after a startup error. */\n  readonly ready: boolean;\n  /** What the query asked for; null when it could not be read. */\n  readonly routes: Routes | null;\n  /** The game's HTML/CSS overlay over the canvas (engine/ui/overlay.ts); null until the renderer started. */\n  readonly ui: Overlay | null;\n  /** The devices (engine/input/input.ts): prompts, rebinding, the map in use; null when the scene could not start. */\n  readonly input: Input | null;\n  /** Stops the frame loop. */\n  stop(): void;\n}\n\n/** What `?replay=<name>` asked for: the replay, ready to play, or why there is none (raised once the page is up). */\ninterface Asked {\n  playback?: Playback;\n  error?: unknown;\n}\n\n/** Reads the replay `name` of `replays` before the run starts, so its scene can start (see the file comment). */\nasync function readReplay(name: string, replays: EngineOptions['replays']): Promise<Asked> {\n  const load = replays?.[name];\n  if (!load) {\n    const names = Object.keys(replays ?? {}).sort();\n    return { error: codeError('APP_NO_REPLAY', { name, names: names.join(', ') || 'none' }) };\n  }\n  try {\n    return { playback: createPlayback(JSON.parse(await load())) };\n  } catch (error) {\n    return { error };\n  }\n}\n\n/** A store that reads and writes whichever run's settings are current, for the renderer made once. */\nfunction currentSettings(run: () => AppRun): Settings {\n  return new Proxy({} as Settings, {\n    get(_, key: keyof Settings) {\n      const store = run().session.settings;\n      const value = store[key];\n      return typeof value === 'function' ? (value as (...args: unknown[]) => unknown).bind(store) : value;\n    },\n66-export const CHASE_HEIGHT = 1.5;\n67-/** The time constant of the pivot's follow, real seconds. */\n68-export const CHASE_LAG = 1 / 12;\n69-/** The time constant of the arm easing back out after a wall, real seconds: collide.ts's `COLLIDE_RETURN`. */\n70-export const CHASE_RETURN = COLLIDE_RETURN;\n71-/** The radius of the ball cast along the arm, m: collide.ts's `COLLIDE_RADIUS`. */\n72-export const CHASE_RADIUS = COLLIDE_RADIUS;\n73-/** How far short of a surface the ball stops, m: collide.ts's `COLLIDE_SKIN`. */\n74-export const CHASE_SKIN = COLLIDE_SKIN;\n75-/** Turn rates at full `input.turn`, rad/s: `[right, up]` (the prototype's [ ] keys turn 2.2). */\n--\n271:/** What a WP 3.9 camera gives `followCamera`: its pure steps, as `CameraSteps`, and its code and words. */\n272-export interface FollowSteps<St, S, I> {\n273-  step(state: St, input: I, dt: number): St;\n274-  pose(state: St): CameraPose;\n275-  spec(state: St): S;\n276-  code(spec: S): string;\n277-  describe(spec: S, pose: CameraPose): string;\n278-}\n279-\n280-/**\n281- * Wraps a camera's pure steps and first state in a camera, as `cameraFrom` does for the cameras codes.ts lists; it\n282- * takes the view `effects` (engine/gfx/cameras/effects.ts) and `fade` (see `FollowCamera`) when given. A game's own\n283- * camera is made this way.\n284- */\n285:export function followCamera<T extends string, St, S, I extends CameraInput>(\n286-  type: T,\n287-  first: St,\n288-  steps: FollowSteps<St, S, I>,\n289-  extras: { readonly effects?: EffectWeights; readonly fade?: boolean } = {},\n290-): FollowCamera<T, S, I> {\n291-  let state = first;\n292-  let pose = steps.pose(state);\n293-  return {\n294-    type,\n295-    ...extras,\n296-    update(input = {} as I, dt = 0) {\n297-      refuse(`${type} camera update`, rangeProblems({ dt: [dt, 0, 3600] }));\n298-      state = steps.step(state, input, dt);\n299-      pose = steps.pose(state);\n300-      return pose;\n301-    },\n302-    pose: () => pose,\n303-    yaw: () => wrapAngle(pose.yaw),\n304-    spec: () => steps.spec(state),\n305-    code: () => steps.code(steps.spec(state)),\n306-    describe: () => steps.describe(steps.spec(state), pose),\n307-  };\n308-}\n309-\n310-/** A chase camera: behind the hero on its arm, following `input.follow`, in front of the walls `input.queries` sees. */\n311-export function createChaseCamera(options: ChaseOptions = {}): FollowCamera<'chase', ChaseSpec, ChaseInput> {\n312:  return followCamera('chase', chaseState(options), {\n313-    step: stepChase,\n314-    pose: chasePose,\n315-    spec: chaseSpec,\n316-    code: formatChaseCode,\n317-    describe: describeChase,\n318-  });\n319-}\n","exit_code":0,"status":"completed"}}
