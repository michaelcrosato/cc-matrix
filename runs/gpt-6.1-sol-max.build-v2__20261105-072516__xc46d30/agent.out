.ts-106-/** What `createPageDrawing` draws with besides the parts. */\nengine/app/drawing.ts-107-export interface PageDrawingOptions {\nengine/app/drawing.ts-108-  /** The page's chrome: its touch class and top panel. */\nengine/app/drawing.ts-109-  chrome: Chrome;\nengine/app/drawing.ts-110-  /** The current run's settings (`quality`). */\nengine/app/drawing.ts-111-  settings: Settings;\nengine/app/drawing.ts-112-  /** The page's own presentation, after each drawn frame. */\nengine/app/drawing.ts-113-  onFrame?: (frame: EngineFrame) => void;\nengine/app/drawing.ts-114-}\nengine/app/drawing.ts-115-\nengine/app/drawing.ts-116-/** The page's drawing (see the file comment). */\nengine/app/drawing.ts-117-export interface PageDrawing {\nengine/app/drawing.ts-118-  /** The rendering members' drawing. */\nengine/app/drawing.ts-119-  readonly drawing: Drawing;\nengine/app/drawing.ts-120-  /** Draws the view at `alpha`, `dt` real seconds after the last frame. */\nengine/app/drawing.ts-121-  frame(alpha: number, dt: number): FrameReport;\nengine/app/drawing.ts-122-  /** Draws until a frame is drawn and done on the GPU; throws `APP_NO_FRAME` after `DRAWING.tries`. */\nengine/app/drawing.ts-123-  settle(alpha: number, dt: number): Promise<FrameReport>;\nengine/app/drawing.ts-124-  /** Warms up through each camera `warmedCameras` names that is not warm under the shader key now. */\nengine/app/drawing.ts-125-  warmCameras(): Promise<void>;\nengine/app/drawing.ts-126-}\nengine/app/drawing.ts-127-\nengine/app/drawing.ts-128-/** The page's drawing over `parts` (see the file comment). */\nengine/app/drawing.ts-129-export function createPageDrawing(parts: PageParts, options: PageDrawingOptions): PageDrawing {\nengine/app/drawing.ts-130-  const { chrome, settings } = options;\nengine/app/drawing.ts-131-  let draws = 0;\nengine/app/drawing.ts-132-  const viewNow = () => parts.run!.view!;\nengine/app/drawing.ts-133-  const aspect = () => {\nengine/app/drawing.ts-134-    const css = parts.gfx?.resolution.current?.css;\nengine/app/drawing.ts-135-    return css && css.width > 0 && css.height > 0 ? css.width / css.height : HEADLESS_ASPECT;\nengine/app/drawing.ts-136-  };\nengine/app/drawing.ts-137-  /** Touch mode this frame: the page's class and layer, and the quality tier's pixel caps. */\nengine/app/drawing.ts-138-  const touchFrame = () => {\nengine/app/drawing.ts-139-    const touch = parts.input?.touch;\nengine/app/drawing.ts-140-    const on = touch?.active ?? false;\nengine/app/drawing.ts-141-    chrome.setTouch(on);\nengine/app/drawing.ts-142-    const covered = on && chrome.topPanel() !== null;\nengine/app/drawing.ts-143-    const { innerWidth: width, innerHeight: height } = window;\nengine/app/drawing.ts-144-    parts.layer?.update({ on, stick: touch?.stickView() ?? null, down: touch?.down() ?? [], covered, width, height });\nengine/app/drawing.ts-145-    const quality = settings.get<QualitySetting>('quality');\n  params?: Record<string, unknown>;\n}\n\n/** What `defineGeometry` takes: the entry's fields (`params` and `budget` have defaults), `create` typed by `params`. */\nexport interface GeometrySpec<S extends Schema = Schema> {\n  /** What it is, in plain sentences. */\n  description: string;\n  /** Its parameters, as schema fields (engine/core/schema.ts), each with its default. */\n  params?: S;\n  /** The most vertices it may have at its defaults; 4096 by default. */\n  budget?: number;\n  /** The builder: every parameter filled, as `params` declares them. */\n  create: (params: EntryOf<S>) => BufferGeometry;\n}\n\n/** The problems of a geometry beyond its fields: its parameter schema. */\nfunction geometryProblems(entry: GeometryEntry): string[] {\n  if (!isPlainObject(entry.params)) return ['params must be an object of schema fields'];\n  const problems: string[] = [];\n  for (const [key, field] of Object.entries(entry.params)) {\n    problems.push(...checkField(field, `params.${key}`).map((problem) => problem.message));\n    if (isPlainObject(field) && field.default === undefined) {\n      problems.push(`params.${key} needs a default: a prop may leave any parameter out`);\n    }\n  }\n  return problems;\n}\n\n/** Declares the kind `geometry` on `registry`, with the kit's built-in shapes, unless it has it. */\nexport function geometryKind(registry: Registry): void {\n  if (registry.kinds().includes('geometry')) return;\n  registry.defineKind('geometry', {\n    description:\n      'Shapes props, levels and bodies name by id: a builder of a three.js BufferGeometry with its parameters and a vertex budget.',\n    fields: GEOMETRY_FIELDS,\n    fallback: 'geometry:box',\n    defineWith: \"defineGeometry('<id>', { description: '…', params: { … }, create: (params) => boxGeometry({ … }) })\",\n    check: (entry) => geometryProblems(entry as unknown as GeometryEntry),\n  });\n  for (const [id, spec] of Object.entries(BUILT_IN_GEOMETRY)) {\n    registry.def('geometry', id, spec as unknown as Record<string, unknown>);\n","exit_code":0,"status":"completed"}}
