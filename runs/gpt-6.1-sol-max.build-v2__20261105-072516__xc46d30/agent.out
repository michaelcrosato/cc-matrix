{"type":"item.started","item":{"id":"item_217","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/ui/settings.ts');s=p.read_text().replace(\\\"picker(root, 'Crouch', ['Hold', 'Toggle']\\\", \\\"picker(root, 'Crouch', ctx.inHub?['Hold']:['Hold', 'Toggle']\\\")\np.write_text(s)\np=Path('labs/game/ui/map.ts');s=p.read_text().replace(\\\"let at = c.flags[\"'`alt-${c.contract}`] && !c.flags[`altDone-${c.contract}`] ? ALTS[c.contract]?.at : step?.at;\", \"let at = step?.at;\").replace(\"if (c.goal === ALTS[c.contract]?.goal) at = ALTS[c.contract].at;\", \"if (c.goal === ALTS[c.contract]?.goal) at = ALTS[c.contract].kind==='\"'delivery'&&s.carrying?[330,1147]:ALTS[c.contract].at;\\\")\np.write_text(s)\np=Path('labs/game/ui/controls.ts');s=p.read_text().replace(\\\"  throw: ['KeyG', 'PadRightShoulder'],\\\", \\\"  throw: ['KeyG', 'PadRightShoulder'],\\\\n  frag:['KeyJ','Hold:PadRightShoulder'],\\\").replace(\\\"    ['Throw molotov', 'G / R1'],\\\", \\\"    ['Throw molotov', 'G / R1'],\\\\n    ['Frag grenade','J / hold R1'],\\\")\np.write_text(s)\np=Path('labs/game/scenes/arms.ts');s=p.read_text().replace(\\\"prop: 'prop:field-projectile',\\\", \\\"prop: kind==='frag'?'prop:field-frag':'prop:field-projectile',\\\")\ns=s.replace(\\\"    if (\"'!hit && b.y > ground(b.x, b.z) + 0.08 && w.tick < b.until) continue;\", \"    if (!hit && b.y > ground(b.x, b.z) + 0.08 && w.tick < b.until) continue;'\"\\\\n    if(b.kind==='frag'&&w.tick<b.until){if(hit){const dot=b.vx*hit.normal.x+b.vy*hit.normal.y+b.vz*hit.normal.z;b.vx-=1.4*dot*hit.normal.x;b.vy-=1.4*dot*hit.normal.y;b.vz-=1.4*dot*hit.normal.z;b.x=hit.point.x+hit.normal.x*0.1;b.y=hit.point.y+hit.normal.y*0.1;b.z=hit.point.z+hit.normal.z*0.1;}else{b.y=ground(b.x,b.z)+0.09;b.vy=Math.abs(b.vy)*0.35;}b.vx*=0.65;b.vz*=0.65;continue;}\\\")\ns=s.replace(\\\"      s.molotovs--;\\\", \\\"      s.molotovs--;w.emit('throw',{id:p.id});\\\")\ns=s.replace(\\\"    if (pressed.includ