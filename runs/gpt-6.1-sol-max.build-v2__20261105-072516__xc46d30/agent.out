>Connect a controller or keyboard to enter the basin.<br>The field demonstration continues in the meantime.</p><button id=\\\"touch-settings\\\">Settings</button></div>\n    <script>\n      if(matchMedia('(hover: none) and (pointer: coarse)').matches){document.getElementById('touch-notice').classList.add('active');if(\"'!navigator.gpu)document.getElementById('\"'touch-notice').classList.add('no-gpu');}\n      addEventListener('keydown',function(){document.getElementById('touch-notice').classList.add('dismissed');},{once:true});\n    </script>\n    <script type=\\\"module\\\" src=\\\"./main.ts\\\"></script>\n  </body>\n</html>\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
