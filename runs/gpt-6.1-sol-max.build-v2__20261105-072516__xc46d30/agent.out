{"type":"item.started","item":{"id":"item_231","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/melee.ts <<'EOF'\n/** @file The always-carried machete: a short forward strike, a visible blade and a real attack window. */\nimport {defineComponent,spawnProp,removeProp,physicsOf,entityOfBody,strikeEntity,damage,Vector3,Quaternion,Euler,actOn} from '../../../engine/sim-api';\nimport {people,mark,cheat,type GW,type Person} from './state';\ndefineComponent('blade',{description:'A short-lived machete action.',fields:{data:{type:'object',default:{},description:'Owner, blade prop and attack window.'}}});\ninterface Blade {owner:number;prop:number;born:number;until:number;struck:boolean;}\nexport function beginMelee(w:GW,p:Person):void{\n  const s=p.seat?.data;if(\"'!s||s.down||w.tick<s.meleeNext)return;s.meleeNext=w.tick+42;s.meleeUntil=w.tick+36;s.map=false;\n  if(p.weapons.slot>=0)p.weapons.last=p.weapons.slot;p.weapons.slot=-1;p.animator.weapon='\"'none';\n  const prop=spawnProp(w,{prop:'prop:field-machete',at:[p.actor.x,p.actor.y+1,p.actor.z],yaw:p.actor.yaw});\n  w.spawn({blade:{data:{owner:p.id,prop,born:w.tick,until:w.tick+36,struck:false}}} as never);\n  actOn(w,p.id,a=>a.play('action:field-machete-chop'));mark(w,'melee');w.emit('melee',{id:p.id});\n}\nfunction strike(w:GW,p:Person):void{\n  const yaw=p.seat?.data.wants.look?.[0]??p.actor.yaw,from:[number,number,number]=[p.actor.x,p.actor.y+(p.motion?.stance==='crouch'?0.75:1.3),p.actor.z];\n  const candidates=people(w).filter(t=>{const dx=t.actor.x-p.actor.x,dz=t.actor.z-p.actor.z,d=Math.hypot(dx,dz);return t.id\"'!==p.id&&t.health.hp>0&&d<2.6&&(d<0.1||(dx*Math.sin(yaw)+dz*Math.cos(yaw))/d>0.5);}).sort((a,b)=>Math.hypot(a.actor.x-p.actor.x,a.actor.z-p.actor.z)-Math.hypot(b.actor.x-p.actor.x,b.actor.z-p.actor.z));\n  const t=candidates[0],dir=t?new Vector3(t.actor.x-from[0],t.actor.y+1.1-from[1],t.actor.z-from[2]).normalize():new Vector3(Math.sin(yaw),0,Math.cos(yaw));\n  const hit=physicsOf(w).raycast(from,dir,{maxDistance:2.6,groups:['\"'world','prop','actor','crowd','corpse'],exclude:p.actor.body});\n  if(hit&&entityOfBody(w,hit.body)\"'!==t?.id){const id=entityOfBody(w,hit.body);if(id>=0)strikeEntity(w,id,from,true,'\"'melee');if(id>=0||\"'!t)return;}\n  if(t){damage(w,t,{amount:cheat(w,'\"'oneShot')?999:60,from,source:p.id});mark(w,'melee hit');w.emit('melee-hit',{at:[t.actor.x,t.actor.y+1,t.actor.z]});}\n}\nexport function meleeStep(w:GW):void{\n  for(const e of w.query('blade' as never) as unknown as {id:number;blade:{data:Blade}}[]){\n    const b=e.blade.data,p=people(w).find(p=>p.id===b.owner);\n    if(\"'!p||p.health.hp<=0||w.tick>=b.until||p.seat?.data.action){removeProp(w,b.prop);w.despawn(e.id);continue;}\n    const phase=(w.tick-b.born)/36,yaw=p.seat!.data.wants.look?.[0]??p.actor.yaw,pitch=p.seat!.data.wants.look?.[1]??0,swing=Math.sin(phase*Math.PI),forward=0.48+swing*0.1,right=0.26-swing*0.46,eye=p.motion?.stance==='\"'crouch'?0.81:1.52;\n    const f=new Vector3(Math.sin(yaw)*Math.cos(pitch),Math.sin(pitch),Math.cos(yaw)*Math.cos(pitch)),r=new Vector3(-Math.cos(yaw),0,Math.sin(yaw)),up=new Vector3(-Math.sin(yaw)*Math.sin(pitch),Math.cos(pitch),-Math.cos(yaw)*Math.sin(pitch));\n    const at=new Vector3(p.actor.x,p.actor.y+eye,p.actor.z).add(f.multiplyScalar(forward)).add(r.multiplyScalar(right)).add(up.multiplyScalar(-0.32));const q=new Quaternion().setFromEuler(new Euler(-pitch,yaw,-swing*0.9,'YXZ')),prop=w.get(b.prop)?.sceneProp;\n    if(prop)Object.assign(prop,{x:at.x,y:at.y,z:at.z,q:[q.x,q.y,q.z,q.w]});\n    if(\"'!b.struck&&phase>=0.4){b.struck=true;strike(w,p);}\n  }\n}\nEOF\ncat >> labs/game/props/world.ts <<'\"'EOF'\n\nprop('machete',[box('grip',[0.034,0.11,0.024],[0,0,0],'#443b2b'),box('guard',[0.085,0.012,0.03],[0,0.105,0],'#777f70'),box('blade',[0.055,0.43,0.007],[0,0.117,0],'#a9b2a3'),cone('tip',0.03,0.07,[0,0.547,0],'#b8c0b0',0)]);\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/scenes/state.ts');s=p.r