{"type":"item.started","item":{"id":"item_187","type":"command_execution","command":"/bin/bash -lc \"sed -n '72,94p' labs/game/ui/settings.ts\nsed -n '1,40p' labs/game/scenes/health.ts\nsed -n '55,74p' labs/game/ui/controls.ts\nwc -l labs/game/main.ts labs/game/ui/style-3.css labs/game/net/lockstep.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_187","type":"command_execution","command":"/bin/bash -lc \"sed -n '72,94p' labs/game/ui/settings.ts\nsed -n '1,40p' labs/game/scenes/health.ts\nsed -n '55,74p' labs/game/ui/controls.ts\nwc -l labs/game/main.ts labs/game/ui/style-3.css labs/game/net/lockstep.ts\"","aggregated_output":"  const root = shell(ctx, 'Settings', 'FIELD ADJUSTMENTS'),\n    store = ctx.store;\n  pager(root, settingsPage, ['Sound', 'Controls', 'Picture'], (n) => {\n    settingsPage = n;\n    settings(ctx);\n  });\n  const live = (key: string, v: unknown) => {\n    ctx.inspector()?.set(key, v);\n    store.set(key, v);\n  };\n  if (settingsPage === 0) {\n    for (const [bus, label] of [\n      ['master', 'Master'],\n      ['music', 'Music'],\n      ['effects', 'Effects'],\n      ['ui', 'Voices'],\n      ['ambience', 'Ambience'],\n    ] as const)\n      slider(root, label, audio.volume(bus), 0, 1, 0.01, (v) => {\n        audio.volume(bus, v);\n        if (bus === 'ui') setVoiceVolume(v);\n        store.set(`audio.${bus}`, v);\n      });\n/** @file Segmented wounds, interruptible medicine, field surgery, downed players and a buddy's rescue debt. */\nimport { actOn, placeActor, removeActor, standUp, handOff, spawnProp, removeProp } from '../../../engine/sim-api';\nimport { campaign, players, value, cheat, mark, say, distance, type GW, type Person } from './state';\nimport { ground } from './map';\nimport { spawnResident } from '../cast/mercs';\n\nexport function beginAction(w: GW, p: Person, key: string, seconds: number): boolean {\n  const s = p.seat?.data;\n  if (!s || s.action || s.down) return false;\n  s.action = key;\n  if (p.weapons.slot >= 0) p.weapons.last = p.weapons.slot;\n  p.weapons.slot = -1;\n  if (p.animator) p.animator.weapon = 'none';\n  const item =\n    key === 'pill'\n      ? 'pill-bottle'\n      : key === 'repair'\n        ? 'wrench'\n        : key === 'surgery-burn'\n          ? 'lighter'\n          : key.startsWith('surgery')\n            ? 'surgery-tool'\n            : 'syrette';\n  s.actionProp = spawnProp(w, {\n    prop: `prop:field-${item}`,\n    at: [p.actor.x, p.actor.y + 1.1, p.actor.z],\n    yaw: p.actor.yaw,\n  });\n  s.until = w.tick + Math.round(seconds * 60);\n  actOn(w, p.id, (a) => a.play(`action:field-${key}`));\n  w.emit('body-action', { id: p.id, key });\n  return true;\n}\nfunction revive(w: GW, p: Person, buddy: number): void {\n  const c = campaign(w),\n    s = p.seat!.data,\n    b = c.buddies[buddy];\n  s.down = 0;\n  p.health.hp = 40;\n  s.rescue = -1;\n    driveRight: ['KeyD', 'PadLeftStickRight'],\n    handbrake: ['Space', 'PadSouth'],\n    seat: ['KeyQ', 'PadNorth'],\n  },\n  view: ['ledger', 'viewCamera'],\n  look: true,\n  aimWith: 'centre',\n  lock: true,\n});\nexport const PROMPTS: Record<string, [string, string, string]> = {\n  interact: ['E', '□', 'X'],\n  reload: ['Hold R', 'Hold □', 'Hold X'],\n  heal: ['H', 'L1', 'LB'],\n  pill: ['P', '◀', '◀'],\n  map: ['M', '▲', '▲'],\n  locator: ['B', '▼', '▼'],\n  fire: ['LMB', 'R2', 'RT'],\n  back: ['Esc', '○', 'B'],\n  select: ['Enter', '✕', 'A'],\n};\n  399 labs/game/main.ts\n  314 labs/game/ui/style-3.css\n  189 labs/game/net/lockstep.ts\n  902 total\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_188","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/ui/aim.ts <<'EOF'\n/** @file View-only pad assistance and fever sway. The resulting camera aim is sent through the normal input wire. */\nimport type {CameraInput} from '../../../engine';\nimport type {Person} from '../scenes/state';\nimport type {Context} from './context';\nlet previousAim=false;\nexport function aimInput(ctx:Context,bot:[number,number]|null):CameraInput|undefined{\n  if(bot)return {view:bot} as CameraInput;\n  if(ctx.screen\"'!=='\"'play'||\"'!ctx.frame||!ctx.p)return undefined;\n  const p=ctx.p,fever=!!p.seat?.data.fever,phase=ctx.frame.world.tick/80;\n  const base:CameraInput=fever?(ctx.device==='\"'gamepad'?{look:[Math.sin(phase)*0.0008,Math.cos(phase*0.7)*0.0005]}:{turn:[Math.sin(phase)*0.024,Math.cos(phase*0.7)*0.018]}):{};\n  if(ctx.device\"'!=='\"'gamepad'||\"'!ctx.store.get('\"'assist',true))return fever?base:undefined;\n  const pad=[...navigator.getGamepads()].find(Boolean);if(\"'!pad)return fever?base:undefined;\n  const aiming=!!pad.buttons[6]?.pressed,snap=aiming&&!previousAim;previousAim=aiming;\n  if(Math.abs(pad.axes[2]??0)<0.1&&Math.abs(pad.axes[3]??0)<0.1&&!snap)return fever?base:undefined;\n  const yaw=ctx.frame.camera.yaw,targets=[...ctx.frame.world.query('\"'actor','soldier','health')] as unknown as Person[];\n  const nearest=targets.filter(t=>t.health.hp>0).map(t=>({t,d:Math.atan2(Math.sin(Math.atan2(t.actor.x-p.actor.x,t.actor.z-p.actor.z)-yaw),Math.cos(Math.atan2(t.actor.x-p.actor.x,t.actor.z-p.actor.z)-yaw))})).sort((a,b)=>Math.abs(a.d)-Math.abs(b.d))[0];\n  if(\"'!nearest||Math.abs(nearest.d)>0.1)return fever?base:undefined;\n  return {...base,look:[(base.look?.[0]??0)-nearest.d*0.035+(pad.axes[2]??0)*0.006+(snap?-Math.max(-0.035,Math.min(0.035,nearest.d)):0),base.look?.[1]??0]};\n}\nEOF\npython3 - <<'\"'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import { audioCheck } from './ui/audio-check';\\\", \\\"import { audioCheck } from './ui/audio-check';\\\\nimport {aimInput} from './ui/aim';\\\")\na=s.index('function cameraInput(): CameraInput | undefined {');b=s.index('\\\\nconst gameAPI',a)\ns=s[:a]+\\\"const cameraInput=():CameraInput|undefined=>aimInput(ctx,director.view);\\\\n\\\"+s[b:]\ns=s.replace(\\\"  const feverAmount = s?.fever ? Number(store.get('feverIntensity', 0.7)) : 0.0001;\\\", \\\"  const feverAmount = s?.fever ? Math.round(Math.min(1,(f.world.tick-s.fever)/120)*Number(store.get('feverIntensity',0.7))*20)/20 : 0.0001;\\\")\np.write_text(s)\np=Path('labs/game/ui/settings.ts');s=p.read_text().replace(\\\"store.set('glyphs', v);\\\", \\\"store.set('glyphs', v);refreshGlyphs(ctx);\\\");p.write_text(s)\nPY\nnpm run format > out/format.log 2>&1\nNODE_OPTIONS=--max-old-space-size=1800 npm run check > out/check.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
