turn g;\n  });\n  const merged=mergeGeometries(pieces);for(const p of pieces)p.dispose();return merged;\n}});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('labs/game/main.ts');s=p.read_text().replace(\\\"import './art/world';\\\",\\\"import './art/world';\\\\nimport './art/guns';\\\");p.write_text(s)\nPY\nnode scripts/bundle.mjs\"","aggregated_output":"","exit_code":0,"status":"completed"}}
