{"type":"item.completed","item":{"id":"item_118","type":"command_execution","command":"/bin/bash -lc 'node out/boot.mjs'","aggregated_output":"Browser launched\nPage parsed\nWAIT TimeoutError: page.waitForFunction: Timeout 120000ms exceeded.\n{\"ready\":false,\"errors\":[],\"screen\":\"title\",\"text\":\"BASIN AUCTION HOUSE\\nEST. 1968   /   LOT No. 001\\n\\nA WARRANT. A RIFLE. A DEBT.\\n\\nBAR\\nCRY\\n\\nEverything here has a price.\\nEven getting out.\\n\\nNew game\\nCo-op\\nSettings\\nControls\\nAbout / Credits\\n01\\n\\nCONDITION OF SALE\\n\\nONE\\nMERCENARY.\\n\\nImported.\\nSound in limb.\\nUncertain in conscience.\\n\\nRESERVE\\nNOT MET\\nTHE FEVER IS INCLUDED.\\nTHE DRY SEASON   /   AN OPEN-WORLD MERCENARY STORY\\nEnter\\nLoading…\\nBAR CRY\\n\\nOpening the field office…\\nCheck the wind before you strike a match.\",\"info\":{\"version\":\"0.0.0\",\"runtime\":\"browser\",\"headless\":false,\"adapter\":{\"vendor\":\"google\",\"architecture\":\"swiftshader\",\"device\":\"\",\"description\":\"\",\"fallback\":true,\"backend\":\"WebGPU\",\"three\":\"182\"},\"features\":[\"feature:air\",\"feature:ao\",\"feature:cascadedShadows\",\"feature:float32Filtering\",\"feature:gi\",\"feature:gpuCrowds\",\"feature:gpuParticles\",\"feature:largeBuffers\",\"feature:shells\",\"feature:ssr\",\"feature:tiledLighting\",\"feature:timestamps\",\"feature:traa\"],\"downgrades\":[],\"deps\":{\"@dimforge/rapier3d-simd-compat\":\"0.21.0\",\"@stdlib/math-base-special-cos\":\"0.3.1\",\"@stdlib/math-base-special-pow\":\"0.3.1\",\"@stdlib/math-base-special-sin\":\"0.3.1\",\"three\":\"0.182.0\"},\"scene\":\"game:world\",\"seed\":1947,\"tick\":0,\"hz\":60}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_120","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/bot.ts <<'EOF'\n/** @file Scripted field operative used by the playthrough tests. Travel is physical through Receipts; later jumps shorten test time. */\nimport type { Headless, Intents } from '../../engine';\nimport type { Campaign, Person, Usable } from './scenes/state';\nimport { CONTRACTS } from './scenes/content';\nimport type { GameInspector } from './ui/context';\nexport const inspectorOf=(e:Headless)=>e as unknown as GameInspector;\nexport const roundOf=(e:Headless):Campaign=>(e.get(e.entities('campaign')[0].id)\"'!.campaign as {data:Campaign}).data;\nexport const mercOf=(e:Headless):Person=>e.get(e.entities('\"'seat')[0].id) as unknown as Person;\nexport const viewOf=(e:Headless)=>({campaign:roundOf(e),merc:mercOf(e)});\nexport function botIntents(e:Headless,at:[number,number]):Intents {\n  const p=mercOf(e),dx=at[0]-p.actor.x,dz=at[1]-p.actor.z,d=Math.hypot(dx,dz);\n  return {move:d>1?[dx/d,dz/d]:[0,0],look:[Math.atan2(dx,dz),0],b:['sprint']};\n}\nexport function walkTo(e:Headless,at:[number,number],radius=2.1,maxSteps=24000):boolean {\n  let last:[number,number]=[0,0],stuck=0;\n  for(let n=0;n<maxSteps;n+=12){\n    const p=mercOf(e);if(Math.hypot(p.actor.x-at[0],p.actor.z-at[1])<radius)return true;\n    const I=botIntents(e,at);e.step(12,I);\n    if(n%180===0){if(Math.hypot(p.actor.x-last[0],p.actor.z-last[1])<0.5)stuck++;else stuck=0;last=[p.actor.x,p.actor.z];\n      if(stuck){const yaw=(I.look?.[0]??0)+(stuck%2?1.57:-1.57);e.step(90,{move:[Math.sin(yaw),Math.cos(yaw)],b:['jump','sprint'],look:[yaw,0]});}}\n  }return false;\n}\nexport function useKey(e:Headless,key:string,jump=true):void {\n  const target=e.entities('usable').map(x=>e.get(x.id) as unknown as {id:number;usable:{data:Usable};actor?:{x:number;z:number}}).find(x=>x.usable.data.key===key);\n  if(\"'!target)throw new Error(`No usable: ${key}`);const u=target.usable.data,x=target.actor?.x??u.x,z=target.actor?.z??u.z;\n  if(jump)inspectorOf(e).actions.run('\"'place',{x:x+1.8,z});else if(\"'!walkTo(e,[x+1.7,z],2.3))throw new Error(`Travel failed: ${key}`);\n  const p=mercOf(e),yaw=Math.atan2(x-p.actor.x,z-p.actor.z);e.step(1,{look:[yaw,0],p:['\"'interact']});e.step(2);\n}\nexport function fight(e:Headless,where?:string,limit=6000):number {\n  for(let n=0;n<limit;n+=6){\n    const p=mercOf(e),enemies=e.entities('soldier').map(x=>e.get(x.id) as unknown as Person).filter(x=>x.health.hp>0&&(\"'!where||x.soldier!.data.place===where));\n    const enemy=enemies.sort((a,b)=>Math.hypot(a.actor.x-p.actor.x,a.actor.z-p.actor.z)-Math.hypot(b.actor.x-p.actor.x,b.actor.z-p.actor.z))[0];\n    if(!enemy)return n;const g=p.gunState.data.guns[Math.max(0,p.weapons.slot)],dx=enemy.actor.x-p.actor.x,dz=enemy.actor.z-p.actor.z;\n    e.step(6,{look:[Math.atan2(dx,dz),0],aim:[enemy.actor.x,enemy.actor.y+1.5,enemy.actor.z],b:g?.jam?['\"'reload']:['fire','aim'],p:p.weapons.slot<0?['weapon2']:[]});\n    if(p.health.hp<=0&&\"'!p.seat!.data.down)return -1;\n  }return -1;\n}\nexport function playPrologue(e:Headless):void {\n  inspectorOf(e).set('\"'game.god',false);\n  if(\"'!walkTo(e,[330,858],15,5000))throw new Error('\"'Could not leave the barge.');\n  e.step(240,{b:['reload']});e.step(1,{p:['heal']});e.step(70);\n  for(let n=0;n<2400&&roundOf(e).step<4;n+=30)e.step(30);\n  if(roundOf(e).step<4)throw new Error('Buddy did not rescue the player.');\n  useKey(e,'Perpetua',false);e.step(1,{p:['pill']});e.step(80);\n  inspectorOf(e).set('game.god',true);\n  for(const at of [[390,1155],[560,970],[600,930],[610,865],[700,855],[760,835]] as [number,number][])\n    if(\"'!walkTo(e,at,8,16000))throw new Error(`Could not reach town: ${at}`);\n  useKey(e,'\"'Lazare',false);\n}\nexport function playReceipts(e:Headless):void {\n  useKey(e,'Cassius',false);\n  for(const at of [[805,850],[850,720],[700,680],[620,580],[620,555]] as [number,number][])\n    if(\"'!walkTo(e,at,7,16000))throw new Error(`Could not reach Km-40: ${at}`);\n  fight(e,'\"'km40');useKey(e,'ledger-km40',false);\n  for(const at of [[665,570],[720,700],[820,760],[820,835]] as [number,number][])\n    if(\"'!walkTo(e,at,8,16000))throw new Error('\"'Could not return the receipts.');\n  useKey(e,'Cassius',false);\n}\nexport function playBot(e:Headless,choice='serve',physical=true):{state:string;contract:number;coverage:string[]} {\n  const d=inspectorOf(e);if(physical){playPrologue(e);playReceipts(e);}else{d.actions.run('story',{contract:2});d.set('game.god',true);}\n  for(let n=0;n<100;n++){\n    const c=roundOf(e);if(c.ending)return {state:'won',contract:c.contract,coverage:Object.keys(c.coverage)};\n    const step=CONTRACTS[c.contract]?.steps[c.step];if(\"'!step)break;\n    if(step.kind==='\"'talk')useKey(e,step.key\"'!);\n    else if(step.kind==='\"'at'){d.actions.run('place',{x:step.at\"'![0],z:step.at![1]+5});e.step(120);}\n    else if(step.kind==='\"'use')useKey(e,step.key\"'!);\n    else if(step.kind==='\"'delivery'){\n      for(let k=0;k<3;k++){useKey(e,\"'`quinine-${k}`);d.actions.run('\"'place',{x:330,z:1147});e.step(1,{p:['interact']});e.step(2);}\n    }else if(step.kind==='burn'){\n      const at=step.at\"'!;d.actions.run('\"'place',{x:at[0]-35,z:at[1]+20});\n      for(let k=-1;k<=1;k++){\n        e.step(1,{p:['quickfire']});e.step(30);const p=mercOf(e),x=at[0]+k*13,z=at[1]-15,yaw=Math.atan2(x-p.actor.x,z-p.actor.z),pitch=Math.atan2(3-p.actor.y-1.52,Math.hypot(x-p.actor.x,z-p.actor.z));\n        e.step(1,{look:[yaw,pitch],aim:[x,3,z],p:['fire']});e.step(240);\n      }e.step(1800);\n    }else if(step.kind==='vehicle'){\n      const boat=e.entities('ride').map(x=>e.get(x.id) as unknown as {id:number;ride:{data:{kind:string}};sceneProp:{x:number;z:number}}).find(x=>x.ride.data.kind==='boat')\"'!;\n      d.actions.run('\"'place',{x:boat.sceneProp.x+1.5,z:boat.sceneProp.z});e.step(1,{look:[-1.57,0],p:['interact']});e.step(10);\n      if(mercOf(e).seat\"'!.data.vehicle<0)throw new Error('\"'Could not board boat.');\n    }else if(step.kind==='clear'){d.actions.run('place',{place:step.key});e.step(120);fight(e,step.key);e.step(3);}\n    else if(step.kind==='flag'&&step.key==='invoiceResolved'){\n      const b=roundOf(e).buddies.find(x=>x.fallen>0);if(b)e.step(1,{'game:command':{kind:'saveBuddy',key:b.key}});else e.step(60);\n    }else if(step.kind==='choice'){\n      d.actions.run('give',{stones:100});e.step(1,{'game:command':{kind:'ending',key:choice}});\n    }else e.step(120);\n  }\n  const c=roundOf(e);return {state:c.ending?'won':'stalled',contract:c.contract,coverage:Object.keys(c.coverage)};\n}\nEOF\nrm labs/game/scenes/play.ts labs/game/scenes/play.test.ts labs/game/best.ts labs/game/best.test.ts labs/game/cast/player.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_120","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/bot.ts <<'EOF'\n/** @file Scripted field operative used by the playthrough tests. Travel is physical through Receipts; later jumps shorten test time. */\nimport type { Headless, Intents } from '../../engine';\nimport type { Campaign, Person, Usable } from './scenes/state';\nimport { CONTRACTS } from './scenes/content';\nimport type { GameInspector } from './ui/context';\nexport const inspectorOf=(e:Headless)=>e as unknown as GameInspector;\nexport const roundOf=(e:Headless):Campaign=>(e.get(e.entities('campaign')[0].id)\"'!.campaign as {data:Campaign}).data;\nexport const mercOf=(e:Headless):Person=>e.get(e.entities('\"'seat')[0].id) as unknown as Person;\nexport const viewOf=(e:Headless)=>({campaign:roundOf(e),merc:mercOf(e)});\nexport function botIntents(e:Headless,at:[number,number]):Intents {\n  const p=mercOf(e),dx=at[0]-p.actor.x,dz=at[1]-p.actor.z,d=Math.hypot(dx,dz);\n  return {move:d>1?[dx/d,dz/d]:[0,0],look:[Math.atan2(dx,dz),0],b:['sprint']};\n}\nexport function walkTo(e:Headless,at:[number,number],radius=2.1,maxSteps=24000):boolean {\n  let last:[number,number]=[0,0],stuck=0;\n  for(let n=0;n<maxSteps;n+=12){\n    const p=mercOf(e);if(Math.hypot(p.actor.x-at[0],p.actor.z-at[1])<radius)return true;\n    const I=botIntents(e,at);e.step(12,I);\n    if(n%180===0){if(Math.hypot(p.actor.x-last[0],p.actor.z-last[1])<0.5)stuck++;else stuck=0;last=[p.actor.x,p.actor.z];\n      if(stuck){const yaw=(I.look?.[0]??0)+(stuck%2?1.57:-1.57);e.step(90,{move:[Math.sin(yaw),Math.cos(yaw)],b:['jump','sprint'],look:[yaw,0]});}}\n  }return false;\n}\nexport function useKey(e:Headless,key:string,jump=true):void {\n  const target=e.entities('usable').map(x=>e.get(x.id) as unknown as {id:number;usable:{data:Usable};actor?:{x:number;z:number}}).find(x=>x.usable.data.key===key);\n  if(\"'!target)throw new Error(`No usable: ${key}`);const u=target.usable.data,x=target.actor?.x??u.x,z=target.actor?.z??u.z;\n  if(jump)inspectorOf(e).actions.run('\"'place',{x:x+1.8,z});else if(\"'!walkTo(e,[x+1.7,z],2.3))throw new Error(`Travel failed: ${key}`);\n  const p=mercOf(e),yaw=Math.atan2(x-p.actor.x,z-p.actor.z);e.step(1,{look:[yaw,0],p:['\"'interact']});e.step(2);\n}\nexport function fight(e:Headless,where?:string,limit=6000):number {\n  for(let n=0;n<limit;n+=6){\n    const p=mercOf(e),enemies=e.entities('soldier').map(x=>e.get(x.id) as unknown as Person).filter(x=>x.health.hp>0&&(\"'!where||x.soldier!.data.place===where));\n    const enemy=enemies.sort((a,b)=>Math.hypot(a.actor.x-p.actor.x,a.actor.z-p.actor.z)-Math.hypot(b.actor.x-p.actor.x,b.actor.z-p.actor.z))[0];\n    if(!enemy)return n;const g=p.gunState.data.guns[Math.max(0,p.weapons.slot)],dx=enemy.actor.x-p.actor.x,dz=enemy.actor.z-p.actor.z;\n    e.step(6,{look:[Math.atan2(dx,dz),0],aim:[enemy.actor.x,enemy.actor.y+1.5,enemy.actor.z],b:g?.jam?['\"'reload']:['fire','aim'],p:p.weapons.slot<0?['weapon2']:[]});\n    if(p.health.hp<=0&&\"'!p.seat!.data.down)return -1;\n  }return -1;\n}\nexport function playPrologue(e:Headless):void {\n  inspectorOf(e).set('\"'game.god',false);\n  if(\"'!walkTo(e,[330,858],15,5000))throw new Error('\"'Could not leave the barge.');\n  e.step(240,{b:['reload']});e.step(1,{p:['heal']});e.step(70);\n  for(let n=0;n<2400&&roundOf(e).step<4;n+=30)e.step(30);\n  if(roundOf(e).step<4)throw new Error('Buddy did not rescue the player.');\n  useKey(e,'Perpetua',false);e.step(1,{p:['pill']});e.step(80);\n  inspectorOf(e).set('game.god',true);\n  for(const at of [[390,1155],[560,970],[600,930],[610,865],[700,855],[760,835]] as [number,number][])\n    if(\"'!walkTo(e,at,8,16000))throw new Error(`Could not reach town: ${at}`);\n  useKey(e,'\"'Lazare',false);\n}\nexport function playReceipts(e:Headless):void {\n  useKey(e,'Cassius',false);\n  for(const at of [[805,850],[850,720],[700,680],[620,580],[620,555]] as [number,number][])\n    if(\"'!walkTo(e,at,7,16000))throw new Error(`Could not reach Km-40: ${at}`);\n  fight(e,'\"'km40');useKey(e,'ledger-km40',false);\n  for(const at of [[665,570],[720,700],[820,760],[820,835]] as [number,number][])\n    if(\"'!walkTo(e,at,8,16000))throw new Error('\"'Could not return the receipts.');\n  useKey(e,'Cassius',false);\n}\nexport function playBot(e:Headless,choice='serve',physical=true):{state:string;contract:number;coverage:string[]} {\n  const d=inspectorOf(e);if(physical){playPrologue(e);playReceipts(e);}else{d.actions.run('story',{contract:2});d.set('game.god',true);}\n  for(let n=0;n<100;n++){\n    const c=roundOf(e);if(c.ending)return {state:'won',contract:c.contract,coverage:Object.keys(c.coverage)};\n    const step=CONTRACTS[c.contract]?.steps[c.step];if(\"'!step)break;\n    if(step.kind==='\"'talk')useKey(e,step.key\"'!);\n    else if(step.kind==='\"'at'){d.actions.run('place',{x:step.at\"'![0],z:step.at![1]+5});e.step(120);}\n    else if(step.kind==='\"'use')useKey(e,step.key\"'!);\n    else if(step.kind==='\"'delivery'){\n      for(let k=0;k<3;k++){useKey(e,\"'`quinine-${k}`);d.actions.run('\"'place',{x:330,z:1147});e.step(1,{p:['interact']});e.step(2);}\n    }else if(step.kind==='burn'){\n      const at=step.at\"'!;d.actions.run('\"'place',{x:at[0]-35,z:at[1]+20});\n      for(let k=-1;k<=1;k++){\n        e.step(1,{p:['quickfire']});e.step(30);const p=mercOf(e),x=at[0]+k*13,z=at[1]-15,yaw=Math.atan2(x-p.actor.x,z-p.actor.z),pitch=Math.atan2(3-p.actor.y-1.52,Math.hypot(x-p.actor.x,z-p.actor.z));\n        e.step(1,{look:[yaw,pitch],aim:[x,3,z],p:['fire']});e.step(240);\n      }e.step(1800);\n    }else if(step.kind==='vehicle'){\n      const boat=e.entities('ride').map(x=>e.get(x.id) as unknown as {id:number;ride:{data:{kind:string}};sceneProp:{x:number;z:number}}).find(x=>x.ride.data.kind==='boat')\"'!;\n      d.actions.run('\"'place',{x:boat.sceneProp.x+1.5,z:boat.sceneProp.z});e.step(1,{look:[-1.57,0],p:['interact']});e.step(10);\n      if(mercOf(e).seat\"'!.data.vehicle<0)throw new Error('\"'Could not board boat.');\n    }else if(step.kind==='clear'){d.actions.run('place',{place:step.key});e.step(120);fight(e,step.key);e.step(3);}\n    else if(step.kind==='flag'&&step.key==='invoiceResolved'){\n      const b=roundOf(e).buddies.find(x=>x.fallen>0);if(b)e.step(1,{'game:command':{kind:'saveBuddy',key:b.key}});else e.step(60);\n    }else if(step.kind==='choice'){\n      d.actions.run('give',{stones:100});e.step(1,{'game:command':{kind:'ending',key:choice}});\n    }else e.step(120);\n  }\n  const c=roundOf(e);return {state:c.ending?'won':'stalled',contract:c.contract,coverage:Object.keys(c.coverage)};\n}\nEOF\nrm labs/game/scenes/play.ts labs/game/scenes/play.test.ts labs/game/best.ts labs/game/best.test.ts labs/game/cast/player.ts\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_121","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/world.test.ts <<'EOF'\n/** @file End-to-end simulation checks: campaign, fire, survival, vehicles, economy, capture and lockstep. */\nimport { readFileSync } from 'node:fs';\nimport { describe,it,expect } from 'vitest';\nimport { createHeadless, type Headless } from '../../../engine';\nimport { def } from '../../../engine/sim-api';\nimport world from './world';\nimport { CONTRACTS, STOCK } from './content';\nimport { inspectorOf, roundOf, mercOf, useKey, fight, playBot, playPrologue, playReceipts } from '../bot';\nimport { inspectorDigest } from '../net/lockstep';\nimport { type Person, type Campaign } from './state';\nconst make=(seed=1,settings:Record<string,unknown>={})=>createHeadless({scene:world,seed,settings:{'game.mode':'contract','game.detail':0.05,...settings}});\nconst action=(e:Headless,key:string,args:unknown={})=>inspectorOf(e).actions.run(key,args);\nconst tick=(e:Headless,n=1)=>e.step(n);\n\nfunction car(e:Headless,kind='pickup'){\n  return e.entities('ride').map(x=>e.get(x.id) as unknown as {id:number;ride:{data:{kind:string;hp:number;speed:number;driver:number;body:number}};sceneProp:{x:number;y:number;z:number}}).find(x=>x.ride.data.kind===kind)\"'!;\n}\nfunction enter(e:Headless,kind='\"'pickup'){\n  const r=car(e,kind);action(e,'place',{x:r.sceneProp.x+2.2,z:r.sceneProp.z});e.step(1,{look:[-Math.PI/2,0],p:['interact']});e.step(2);return r.id;\n}\n\ndescribe('the basin',()=>{\n  it('replays its recorded opening to the golden hashes',async()=>{\n    const replay=JSON.parse(readFileSync(new URL('../replays/bot.replay.json',import.meta.url),'utf8'));\n    const a=await make(7);for(let i=0;i<120;i++)a.step(1,{move:[0,-0.5],look:[Math.PI,0]});\n    expect(a.hash()).toBe(replay.hashes['linux-x64']['120']);\n  });\n  it('captures and restores a moving seat without shared state',async()=>{\n    const e=await make();e.step(90,{move:[0.4,0.6],look:[0.3,0],b:['map']});const capture=e.capture();\n    e.step(90,{move:[-0.2,0.7],look:[0.4,0],b:['fire']});const hash=e.hash();e.restore(capture);\n    e.step(90,{move:[-0.2,0.7],look:[0.4,0],b:['fire']});expect(e.hash()).toBe(hash);\n  });\n  it('clears a seized chamber and wears a rifle into the next tier',async()=>{\n    const e=await make();action(e,'give',{condition:0.67,jam:true});e.step(240,{b:['reload']});\n    expect(mercOf(e).gunState.data.guns[1].jam).toBe(false);inspectorOf(e).set('game.wear.perShot',0.02);\n    e.step(60,{b:['fire']});expect(mercOf(e).gunState.data.guns[1].condition).toBeLessThan(0.66);\n    expect(mercOf(e).weapons.slots[1]).toContain('worn');\n  });\n  it('distinguishes syrettes from free critical field surgery and segment regeneration',async()=>{\n    const e=await make();tick(e);action(e,'hurt',{hp:35});e.step(1,{p:['heal']});tick(e,60);\n    expect(mercOf(e).health.hp).toBe(100);expect(mercOf(e).seat\"'!.data.syr).toBe(2);\n    action(e,'\"'hurt',{hp:12});e.step(1,{p:['heal']});tick(e,160);expect(mercOf(e).health.hp).toBeGreaterThanOrEqual(60);expect(mercOf(e).seat\"'!.data.syr).toBe(2);\n    action(e,'\"'hurt',{hp:41});tick(e,500);expect(mercOf(e).health.hp).toBeCloseTo(60);\n  });\n  it('takes quinine, clears fever, and produces a late-attack mirage',async()=>{\n    const e=await make();inspectorOf(e).set('game.god',true);tick(e);action(e,'fever');tick(e,1805);\n    expect(roundOf(e).coverage.mirage).toBeGreaterThan(0);e.step(1,{p:['pill']});tick(e,80);expect(mercOf(e).seat\"'!.data.fever).toBe(0);expect(mercOf(e).seat!.data.pills).toBe(3);\n  });\n  it('\"'honours a buddy rescue and stops an overdrawn account',async()=>{\n    const e=await make(3,{'game.mode':'story'});tick(e);action(e,'place',{x:400,z:1150});action(e,'story',{contract:1});action(e,'hurt',{hp:0});tick(e,1400);\n    expect(roundOf(e).coverage.rescue).toBeGreaterThan(0);expect(roundOf(e).buddies.some(b=>b.debt===1)).toBe(true);\n    for(const b of roundOf(e).buddies)action(e,'debt',{key:b.key,debt:3});action(e,'hurt',{hp:0});tick(e);expect(mercOf(e).seat\"'!.data.rescue).toBe(-1);\n  });\n  it('\"'drives with real suspension, exits and repairs the bonnet',async()=>{\n    const e=await make();tick(e,10);const id=enter(e);expect(mercOf(e).seat\"'!.data.vehicle).toBe(id);\n    const before=car(e).sceneProp;e.step(300,{b:['\"'throttle']});const after=car(e).sceneProp;\n    expect(Math.hypot(after.x-before.x,after.z-before.z)).toBeGreaterThan(10);expect(car(e).ride.data.speed).toBeGreaterThan(1);\n    e.step(1,{p:['interact']});expect(mercOf(e).seat\"'!.data.vehicle).toBe(-1);\n  });\n  it('\"'boards a buoyant boat and fires its mounted gun',async()=>{\n    const e=await make();tick(e,10);const id=enter(e,'boat');expect(mercOf(e).seat\"'!.data.vehicle).toBe(id);\n    e.step(1,{p:['\"'seat']});e.step(120,{b:['fire'],look:[1.57,0]});expect(roundOf(e).coverage['mounted gun']).toBeGreaterThan(0);\n    e.step(300,{b:['throttle']});expect(car(e,'boat').ride.data.speed).toBeGreaterThan(1);\n  });\n  it('finds stones, buys reliability and reissues an owned weapon',async()=>{\n    const e=await make();tick(e);useKey(e,'cache-0');expect(roundOf(e).caches).toContain('cache-0');\n    action(e,'place',{place:'airstrip'});action(e,'give',{stones:100});e.step(1,{'game:command':{kind:'buy',index:12}});expect(mercOf(e).seat\"'!.data.reliability).toBe(1);\n    action(e,'\"'give',{condition:0.2});e.step(1,{'game:command':{kind:'reissue'}});expect(mercOf(e).gunState.data.guns[1].condition).toBe(1);\n  });\n  it('has anisotropic fire, persistent scars and regrowth',async()=>{\n    const e=await make(9);inspectorOf(e).set('game.god',true);tick(e);action(e,'ignite',{x:850,z:550,radius:1});tick(e,1800);\n    const c=roundOf(e);let east=0,west=0;\n    c.fire.forEach((f,i)=>{if(f<2)return;const x=(i%192+0.5)*8,z=(Math.floor(i/192)+0.5)*8;if(Math.abs(z-550)>120)return;east=Math.max(east,x-850);west=Math.max(west,850-x);});\n    expect(east).toBeGreaterThan(40);expect(east).toBeGreaterThan(west);expect(c.coverage.scorch).toBeGreaterThan(0);expect(c.coverage.regrowth).toBeGreaterThan(0);\n  });\n  it('rain prevents fresh spread and salt is a firebreak',async()=>{\n    const e=await make();tick(e);action(e,'weather',{rain:true});action(e,'ignite',{x:850,z:550,radius:1});const before=roundOf(e).coverage.ignite;tick(e,500);\n    expect(roundOf(e).coverage.ignite).toBe(before);action(e,'ignite',{x:1240,z:260});expect(roundOf(e).fire[Math.floor(260/8)*192+Math.floor(1240/8)]).toBe(0);\n  });\n  it('keeps seats identical in 2- and 4-player lockstep with different local cameras',async()=>{\n    for(const n of [2,4]){\n      const a=await make(12,{'game.seats':n,'game.me':0}),b=await make(12,{'game.seats':n,'game.me':n-1});\n      for(let k=0;k<600;k++){\n        const wires=Array.from({length:n},(_,i)=>({move:[Math.sin(i)*0.3,-0.3] as [number,number],look:[Math.PI,0] as [number,number],b:k%120<30?['fire']:['reload']}));\n        const all=Object.fromEntries(wires.map((I,i)=>[i,I]));a.step(1,{...wires[0],'game:seats':all as never});b.step(1,{...wires[n-1],'game:seats':all as never});\n      }expect(inspectorDigest(a)).toBe(inspectorDigest(b));\n    }\n  });\n  it('adds a contract and dealer item entirely as validated data',async()=>{\n    const added={name:'A clean receipt',giver:'Ferreira',faction:'neutral',pay:9,brief:'Bring back a signature.',steps:[{kind:'talk',key:'Ferreira',goal:'Talk to Ferreira.'}],alt:''};\n    def('contract','contract:designer',added);CONTRACTS.push({id:'designer',...added});\n    def('stock','stock:designer',{name:'Field repair kit',price:1,op:'kit',key:'1'});STOCK.push({name:'Field repair kit',price:1,kind:'kit',key:'1'});\n    const e=await make(1,{'game.mode':'story'});tick(e);action(e,'story',{contract:CONTRACTS.length-1});useKey(e,'Ferreira');expect(roundOf(e).finished).toContain(CONTRACTS.length-1);\n    CONTRACTS.pop();STOCK.pop();\n  });\n  it('plays the later contracts through all three endings',async()=>{\n    for(const choice of ['serve','buy','burn'])for(const seed of [1,2,3]){\n      const e=await make(seed,{'game.mode':'story'});const r=playBot(e,choice,false);expect({choice,seed,...r}).toMatchObject({state:'won',contract:6});\n    }\n  },300000);\n  it('plays Lot Zero and Receipts with physical travel',async()=>{\n    const e=await make(1,{'game.mode':'story'});playPrologue(e);expect(roundOf(e).contract).toBe(1);playReceipts(e);expect(roundOf(e).contract).toBe(2);\n  },300000);\n});\nEOF\ncat > out/golden.mts <<'EOF'\nimport {writeFileSync} from 'node:fs';\nimport {createHeadless} from '../engine/index.ts';\nimport world from '../labs/game/scenes/world.ts';\nconst e=await createHeadless({scene:world,seed:7,settings:{'game.mode':'contract','game.detail':0.05}});\ne.step(120,{move:[0,-0.5],look:[Math.PI,0]});\nwriteFileSync('labs/game/replays/bot.replay.json',JSON.stringify({format:1,scene:'game:world',seed:7,settings:{'game.mode':'contract','game.detail':0.05},steps:120,intents:[{at:0,move:[0,-0.5],look:[Math.PI,0]}],hashes:{'linux-x64':{'120':e.hash()}}},null,2));\nconsole.log(e.hash());\nEOF\nnode --import tsx out/golden.mts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_121","type":"command_execution","command":"/bin/bash -lc \"cat > labs/game/scenes/world.test.ts <<'EOF'\n/** @file End-to-end simulation checks: campaign, fire, survival, vehicles, economy, capture and lockstep. */\nimport { readFileSync } from 'node:fs';\nimport { describe,it,expect } from 'vitest';\nimport { createHeadless, type Headless } from '../../../engine';\nimport { def } from '../../../engine/sim-api';\nimport world from './world';\nimport { CONTRACTS, STOCK } from './content';\nimport { inspectorOf, roundOf, mercOf, useKey, fight, playBot, playPrologue, playReceipts } from '../bot';\nimport { inspectorDigest } from '../net/lockstep';\nimport { type Person, type Campaign } from './state';\nconst make=(seed=1,settings:Record<string,unknown>={})=>createHeadless({scene:world,seed,settings:{'game.mode':'contract','game.detail':0.05,...settings}});\nconst action=(e:Headless,key:string,args:unknown={})=>inspectorOf(e).actions.run(key,args);\nconst tick=(e:Headless,n=1)=>e.step(n);\n\nfunction car(e:Headless,kind='pickup'){\n  return e.entities('ride').map(x=>e.get(x.id) as unknown as {id:number;ride:{data:{kind:string;hp:number;speed:number;driver:number;body:number}};sceneProp:{x:number;y:number;z:number}}).find(x=>x.ride.data.kind===kind)\"'!;\n}\nfunction enter(e:Headless,kind='\"'pickup'){\n  const r=car(e,kind);action(e,'place',{x:r.sceneProp.x+2.2,z:r.sceneProp.z});e.step(1,{look:[-Math.PI/2,0],p:['interact']});e.step(2);return r.id;\n}\n\ndescribe('the basin',()=>{\n  it('replays its recorded opening to the golden hashes',async()=>{\n    const replay=JSON.parse(readFileSync(new URL('../replays/bot.replay.json',import.meta.url),'utf8'));\n    const a=await make(7);for(let i=0;i<120;i++)a.step(1,{move:[0,-0.5],look:[Math.PI,0]});\n    expect(a.hash()).toBe(replay.hashes['linux-x64']['120']);\n  });\n  it('captures and restores a moving seat without shared state',async()=>{\n    const e=await make();e.step(90,{move:[0.4,0.6],look:[0.3,0],b:['map']});const capture=e.capture();\n    e.step(90,{move:[-0.2,0.7],look:[0.4,0],b:['fire']});const hash=e.hash();e.restore(capture);\n    e.step(90,{move:[-0.2,0.7],look:[0.4,0],b:['fire']});expect(e.hash()).toBe(hash);\n  });\n  it('clears a seized chamber and wears a rifle into the next tier',async()=>{\n    const e=await make();action(e,'give',{condition:0.67,jam:true});e.step(240,{b:['reload']});\n    expect(mercOf(e).gunState.data.guns[1].jam).toBe(false);inspectorOf(e).set('game.wear.perShot',0.02);\n    e.step(60,{b:['fire']});expect(mercOf(e).gunState.data.guns[1].condition).toBeLessThan(0.66);\n    expect(mercOf(e).weapons.slots[1]).toContain('worn');\n  });\n  it('distinguishes syrettes from free critical field surgery and segment regeneration',async()=>{\n    const e=await make();tick(e);action(e,'hurt',{hp:35});e.step(1,{p:['heal']});tick(e,60);\n    expect(mercOf(e).health.hp).toBe(100);expect(mercOf(e).seat\"'!.data.syr).toBe(2);\n    action(e,'\"'hurt',{hp:12});e.step(1,{p:['heal']});tick(e,160);expect(mercOf(e).health.hp).toBeGreaterThanOrEqual(60);expect(mercOf(e).seat\"'!.data.syr).toBe(2);\n    action(e,'\"'hurt',{hp:41});tick(e,500);expect(mercOf(e).health.hp).toBeCloseTo(60);\n  });\n  it('takes quinine, clears fever, and produces a late-attack mirage',async()=>{\n    const e=await make();inspectorOf(e).set('game.god',true);tick(e);action(e,'fever');tick(e,1805);\n    expect(roundOf(e).coverage.mirage).toBeGreaterThan(0);e.step(1,{p:['pill']});tick(e,80);expect(mercOf(e).seat\"'!.data.fever).toBe(0);expect(mercOf(e).seat!.data.pills).toBe(3);\n  });\n  it('\"'honours a buddy rescue and stops an overdrawn account',async()=>{\n    const e=await make(3,{'game.mode':'story'});tick(e);action(e,'place',{x:400,z:1150});action(e,'story',{contract:1});action(e,'hurt',{hp:0});tick(e,1400);\n    expect(roundOf(e).coverage.rescue).toBeGreaterThan(0);expect(roundOf(e).buddies.some(b=>b.debt===1)).toBe(true);\n    for(const b of roundOf(e).buddies)action(e,'debt',{key:b.key,debt:3});action(e,'hurt',{hp:0});tick(e);expect(mercOf(e).seat\"'!.data.rescue).toBe(-1);\n  });\n  it('\"'drives with real suspension, exits and repairs the bonnet',async()=>{\n    const e=await make();tick(e,10);const id=enter(e);expect(mercOf(e).seat\"'!.data.vehicle).toBe(id);\n    const before=car(e).sceneProp;e.step(300,{b:['\"'throttle']});const after=car(e).sceneProp;\n    expect(Math.hypot(after.x-before.x,after.z-before.z)).toBeGreaterThan(10);expect(car(e).ride.data.speed).toBeGreaterThan(1);\n    e.step(1,{p:['interact']});expect(mercOf(e).seat\"'!.data.vehicle).toBe(-1);\n  });\n  it('\"'boards a buoyant boat and fires its mounted gun',async()=>{\n    const e=await make();tick(e,10);const id=enter(e,'boat');expect(mercOf(e).seat\"'!.data.vehicle).toBe(id);\n    e.step(1,{p:['\"'seat']});e.step(120,{b:['fire'],look:[1.57,0]});expect(roundOf(e).coverage['mounted gun']).toBeGreaterThan(0);\n    e.step(300,{b:['throttle']});expect(car(e,'boat').ride.data.speed).toBeGreaterThan(1);\n  });\n  it('finds stones, buys reliability and reissues an owned weapon',async()=>{\n    const e=await make();tick(e);useKey(e,'cache-0');expect(roundOf(e).caches).toContain('cache-0');\n    action(e,'place',{place:'airstrip'});action(e,'give',{stones:100});e.step(1,{'game:command':{kind:'buy',index:12}});expect(mercOf(e).seat\"'!.data.reliability).toBe(1);\n    action(e,'\"'give',{condition:0.2});e.step(1,{'game:command':{kind:'reissue'}});expect(mercOf(e).gunState.data.guns[1].condition).toBe(1);\n  });\n  it('has anisotropic fire, persistent scars and regrowth',async()=>{\n    const e=await make(9);inspectorOf(e).set('game.god',true);tick(e);action(e,'ignite',{x:850,z:550,radius:1});tick(e,1800);\n    const c=roundOf(e);let east=0,west=0;\n    c.fire.forEach((f,i)=>{if(f<2)return;const x=(i%192+0.5)*8,z=(Math.floor(i/192)+0.5)*8;if(Math.abs(z-550)>120)return;east=Math.max(east,x-850);west=Math.max(west,850-x);});\n    expect(east).toBeGreaterThan(40);expect(east).toBeGreaterThan(west);expect(c.coverage.scorch).toBeGreaterThan(0);expect(c.coverage.regrowth).toBeGreaterThan(0);\n  });\n  it('rain prevents fresh spread and salt is a firebreak',async()=>{\n    const e=await make();tick(e);action(e,'weather',{rain:true});action(e,'ignite',{x:850,z:550,radius:1});const before=roundOf(e).coverage.ignite;tick(e,500);\n    expect(roundOf(e).coverage.ignite).toBe(before);action(e,'ignite',{x:1240,z:260});expect(roundOf(e).fire[Math.floor(260/8)*192+Math.floor(1240/8)]).toBe(0);\n  });\n  it('keeps seats identical in 2- and 4-player lockstep with different local cameras',async()=>{\n    for(const n of [2,4]){\n      const a=await make(12,{'game.seats':n,'game.me':0}),b=await make(12,{'game.seats':n,'game.me':n-1});\n      for(let k=0;k<600;k++){\n        const wires=Array.from({length:n},(_,i)=>({move:[Math.sin(i)*0.3,-0.3] as [number,number],look:[Math.PI,0] as [number,number],b:k%120<30?['fire']:['reload']}));\n        const all=Object.fromEntries(wires.map((I,i)=>[i,I]));a.step(1,{...wires[0],'game:seats':all as never});b.step(1,{...wires[n-1],'game:seats':all as never});\n      }expect(inspectorDigest(a)).toBe(inspectorDigest(b));\n    }\n  });\n  it('adds a contract and dealer item entirely as validated data',async()=>{\n    const added={name:'A clean receipt',giver:'Ferreira',faction:'neutral',pay:9,brief:'Bring back a signature.',steps:[{kind:'talk',key:'Ferreira',goal:'Talk to Ferreira.'}],alt:''};\n    def('contract','contract:designer',added);CONTRACTS.push({id:'designer',...added});\n    def('stock','stock:designer',{name:'Field repair kit',price:1,op:'kit',key:'1'});STOCK.push({name:'Field repair kit',price:1,kind:'kit',key:'1'});\n    const e=await make(1,{'game.mode':'story'});tick(e);action(e,'story',{contract:CONTRACTS.length-1});useKey(e,'Ferreira');expect(roundOf(e).finished).toContain(CONTRACTS.length-1);\n    CONTRACTS.pop();STOCK.pop();\n  });\n  it('plays the later contracts through all three endings',async()=>{\n    for(const choice of ['serve','buy','burn'])for(const seed of [1,2,3]){\n      const e=await make(seed,{'game.mode':'story'});const r=playBot(e,choice,false);expect({choice,seed,...r}).toMatchObject({state:'won',contract:6});\n    }\n  },300000);\n  it('plays Lot Zero and Receipts with physical travel',async()=>{\n    const e=await make(1,{'game.mode':'story'});playPrologue(e);expect(roundOf(e).contract).toBe(1);playReceipts(e);expect(roundOf(e).contract).toBe(2);\n  },300000);\n});\nEOF\ncat > out/golden.mts <<'EOF'\nimport {writeFileSync} from 'node:fs';\nimport {createHeadless} from '../engine/index.ts';\nimport world from '../labs/game/scenes/world.ts';\nconst e=await createHeadless({scene:world,seed:7,settings:{'game.mode':'contract','game.detail':0.05}});\ne.step(120,{move:[0,-0.5],look:[Math.PI,0]});\nwriteFileSync('labs/game/replays/bot.replay.json',JSON.stringify({format:1,scene:'game:world',seed:7,settings:{'game.mode':'contract','game.detail':0.05},steps:120,intents:[{at:0,move:[0,-0.5],look:[Math.PI,0]}],hashes:{'linux-x64':{'120':e.hash()}}},null,2));\nconsole.log(e.hash());\nEOF\nnode --import tsx out/golden.mts\"","aggregated_output":"dbf853ea02be1616\n","exit_code":0,"status":"completed"}}
