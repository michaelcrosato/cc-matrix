{"type":"item.completed","item":{"id":"item_138","type":"command_execution","command":"/bin/bash -lc \"rg -n 'export interface RagdollHit' -A24 engine/sim/ragdolls.ts\nrg -n 'export const QUADRUPED_BODY' -l engine\nsed -n '115,137p' engine/sim/crowdBodies.ts\nsed -n '45,62p' engine/ui/labels.ts\"","aggregated_output":"90:export interface RagdollHit {\n91-  push?: Vec3Like;\n92-  spin?: Vec3Like;\n93-  dead?: boolean;\n94-}\n95-\n96-/** What the hand-off reads of an actor. */\n97-type Body = {\n98-  id: number;\n99-  actor: { body: number; character: Character; x: number; y: number; z: number; yaw: number; vx: number; vy: number; vz: number }; // prettier-ignore\n100-  animator: AnimatorData;\n101-  ragdoll?: RagdollState;\n102-};\n103-\n104-/** Declares the component `ragdoll` on `registry` (the shared one by default), once. */\n105-export function defineRagdollKinds(registry: Registry = sharedRegistry): void {\n106-  if (registry.kinds().includes('component') && registry.has('component', 'ragdoll')) return;\n107-  const description = 'An actor’s body in physics’ hands (engine/sim/ragdolls.ts): its parts, their poses, and when it gets up.'; // prettier-ignore\n108-  defineComponent('ragdoll', { description, fields: RAGDOLL_FIELDS }, registry);\n109-}\n110-defineRagdollKinds();\n111-\n112-/** The hand-off's animators, a pool per world, loaded from the components at every use (they keep nothing). */\n113-const pools = new WeakMap<World, AnimatorPool>();\n114-const [UP, push3, spin3, feet] = [new Vector3(0, 1, 0), new Vector3(), new Vector3(), new Vector3()];\nengine/gfx/puppets/bodies/quadruped.ts\n/** What a crowd body's rig is told each step (see the file comment). */\nexport interface CrowdBodyInput {\n  /** Where it stands now (m): a humanoid's or a blob's feet, a floater's core. */\n  at: Vec3Like;\n  /** Its velocity (m/s): a humanoid walks at it, a blob looks along it (unless told), a floater turns and banks by it. */\n  velocity?: Vec3Like;\n  /** Where a humanoid faces (rad; the last when absent); a floater turns to it (else to its travel). */\n  yaw?: number;\n  /** A humanoid off its feet. */\n  air?: boolean;\n  /** A humanoid's other body states (engine/anim/states.ts: run, hurt, pose, stance…). */\n  states?: AnimatorInput;\n  /** A blob's input (engine/anim/blob.ts: squash, look, squint, flap, hang, a move) and a jolt to its squash (per s). */\n  blob?: Omit<BlobInput, 'position'> & { kick?: number };\n  /** A floater's swell, 0 to 1. */\n  swell?: number;\n  /** A quadruped's: sitting, a world point it looks at, how hard it wags (0 to 1); `air` tucks its feet. */\n  quadruped?: { sit?: boolean; look?: Vec3Like | null; wag?: number };\n}\n\n/** A world's rigs: loaded from the components at every step, so they keep no state of their own. */\ninterface Rigs {\n  animators: AnimatorPool;\n    template: '{what} is {got}, not a point in the world',\n    fix: 'pass [x, y, z] in metres, a Vector3 or { x, y, z }, or a function returning one',\n  },\n});\n\n/** A point in the world, m: three.js's `Vector3`, `{ x, y, z }` or `[x, y, z]` (physics' `Vec3Like`). */\nexport type WorldPoint = Readonly<{ x: number; y: number; z: number }> | readonly [number, number, number];\n\n/** Where a label is: a point read every frame (a `Vector3` the caller moves follows), or a function giving one. */\nexport type Anchor = WorldPoint | (() => WorldPoint);\n\n/** What the overlay reads of a camera: any three.js camera (without `near` and `far`, it culls only behind it). */\nexport interface OverlayCamera {\n  readonly matrixWorldInverse: Matrix4;\n  readonly projectionMatrix: Matrix4;\n  readonly near?: number;\n  readonly far?: number;\n  readonly parent?: unknown;\n","exit_code":0,"status":"completed"}}
